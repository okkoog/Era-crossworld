# @file 麦吉罗的呼唤 - 迷雾探索事件
# @author イーウィヤ
# @author 99

# 好事件
g_water:
  title: "Родниковая вода"
  lines:
    - if: d.first === 1
      lines:
        - "%YOU% и %CHARA% находят место, похожее на прогулочную площадь: по ней неспешно расхаживают голуби, а несколько уселись на невысокую тумбу."
        # 谨慎行动
        - if: d.action === 0
          content: "%YOU% и %CHARA% осторожно выходят из-за здания; голуби, захлопав крыльями, отлетают чуть подальше, и тумба, которую они облепили, оказывается питьевым фонтанчиком."
        # 普通行动
        - if: d.action === 1
          content: "%YOU% и %CHARA% подходят быстрым шагом; голуби, захлопав крыльями, отлетают чуть подальше, и тумба, которую они облепили, оказывается питьевым фонтанчиком."
        # 急切行动
        - if: d.action === 2
          content: "%YOU% и %CHARA% подбегают второпях; голуби, захлопав крыльями, отлетают чуть подальше, и тумба, которую они облепили, оказывается питьевым фонтанчиком."
        - "С голубями ничего странного не происходит, и потому, чуть подумав, вы зачерпываете полную пригоршню воды и не спеша выпиваете."
    - if: d.first === 0
      lines:
        - "%YOU% и %CHARA% находят знакомый на вид питьевой фонтанчик и зачерпывают немного воды."
    - "Прохладная вода касается пересохшего горла, и настроение сразу поднимается. (силы +)"

g_lost_and_found:
  title: "Бюро находок"
  lines:
    - if: d.first === 1
      lines:
        - "Вы находите бюро находок."
        - "Милый брелок, зачитанный томик карманного формата, зонт с вывернутыми спицами… Всё то, чему в бюро находок самое место и от чего никакого проку."
        - "Вот только почему на обороте одной бонусной карты, там, где расписывается владелец, стоит имя — %YOU%?"
        - "Поразмыслив так и эдак, %YOU% забирает эту карту из груды никому не нужного добра: в конце концов, может, она и вправду принадлежит %YOU%? («Благосклонность» +%REWARD%)"
    - if: d.first === 0
      lines:
        - "%YOU% находит в бюро находок бонусную карту с именем %YOU% на обороте. («Благосклонность» +%REWARD%)"

g_clothe:
  title: "Привести себя в порядок"
  lines:
    - if: d.first === 1
      lines:
        - "%YOU% и %CHARA% проходят мимо на вид довольно чистого общественного туалета и решают заодно перевести дух."
        - "Разобравшись с телесными нуждами, %YOU% открывает кран над раковиной и разом плещет ледяную воду в лицо."
        - "Прохлада проходит по затылку, и %YOU% чувствует, что в голове заметно прояснилось."
        - "Помогает вышедшей навстречу %CHARA% стереть с лица оставшиеся капли — и вы снова в пути. (влечение −)"
    - if: d.first === 0
      lines:
        - "Вы наскоро привели себя в порядок в общественном туалете. (влечение −)"

g_chair:
  title: "Скамейка в тени деревьев"
  lines:
    - if: d.first === 1
      lines:
        - "Отойдя немного от шумной улицы с высотками, вы садитесь на скамейку в тени деревьев в ближнем парке."
        - "Погода как раз хороша, в роще свежий воздух, и %YOU% с %CHARA% наслаждаются этой тишиной."
        - "Сидя на скамейке, подопечная с улыбкой смотрит на %YOU%, и %YOU% решает…"
        - acc: 1
          content: "Немного расслабиться"
          lines:
            - "Посидев немного, %CHARA% встаёт: хочет сама сходить за напитками."
            - "И пока %CHARA% не вернулась, %YOU% откидывается на спинку и на минуту закрывает глаза. (влечение %YOU% −−)"
        - acc: 1
          content: "Дать %CHARA% побыть одной"
          lines:
            - "%YOU% сам вызывается сходить за напитками, а когда возвращается, %CHARA% ещё за несколько метров радостно вскакивает навстречу %YOU%."
            - "Передохнув, вы бросаете пустые бутылки в урну и с приподнятым настроением снова отправляетесь в путь. (влечение %CHARA% −−)"
        - acc: 2
          content: "Поболтать"
          lines:
            - "%YOU% с улыбкой заговаривает с той, что рядом, — %SEX% ведь тут же, — и %CHARA% так же с улыбкой отвечает %YOU%."
            - "За разговорами и смехом вы незаметно для себя снова трогаетесь в путь. (влечение −)"
    - if: d.first === 0
      lines:
        - "Вы садитесь на скамейку в тени деревьев."
        - acc: 1
          content: "Немного расслабиться"
          lines:
            - "Пока %CHARA% отходила по своим делам, %YOU% на минуту закрыл глаза и отдохнул. (влечение %YOU% −−)"
        - acc: 2
          content: "Дать %CHARA% побыть одной"
          lines:
            - "%YOU% прошёлся по парку, дав %CHARA% немного побыть одной. (влечение %CHARA% −−)"
        - acc: 3
          content: "Поболтать"
          lines:
            - "Вы немного поболтали. (влечение −)"

g_bus:
  title: "Городской транспорт"
  lines:
    - if: d.first === 1
      lines:
        - "%YOU% и %CHARA% садятся в только что подошедший трамвай."
        - "На редкость удачно: в вагоне почти нет пассажиров, и вы садитесь наугад у окна."
        - "Трамвай медленно катит вперёд, %YOU% и %CHARA% сидят рядом у окна, взявшись за руки, и смотрят, как убегает назад городской вид."
        - "Хорошо бы этот покой и тишина продлились подольше. Глядя на улыбающийся профиль подопечной рядом, %YOU% невольно думает именно так."
        - "…Жаль только, что трамвай проехал совсем немного и уже пришёл на конечную. (дополнительный ход вперёд)"
    - if: d.first === 0
      lines:
        - "%YOU% и %CHARA% садятся в подошедший трамвай и вскоре выходят на конечной. (дополнительный ход вперёд)"

g_lucky:
  title: "Счастливый выигрыш"
  lines:
    - if: d.first === 1
      lines:
        - "%YOU% и %CHARA% решают немного постоять у круглосуточного магазинчика."
        - "А потом %CHARA%, ведомая любопытством, заходит внутрь и возвращается с пакетиком неведомых снеков."
        - acc: 1
          content: "Заглянуть в пакетик"
          lines:
            - "%YOU% благодарит подопечную и осторожно надрывает пакет — а оттуда выпадает выигрышный купон."
            - "Неожиданный выигрыш. Пусть и самый обычный, маленький, но настроение у обоих и правда поправилось. («Благосклонность» +%REWARD%)"
        - acc: 2
          content: "Осмотреть упаковку"
          lines:
            - "На упаковке написано «пробный вкус», а резкий запах разом взбадривает %YOU%. (силы %YOU% +)"
    - if: d.first === 0
      lines:
        - "Вы ненадолго передохнули у круглосуточного магазина, а зашедшая внутрь подопечная принесла пакетик неведомых снеков."
        - acc: 1
          content: "Заглянуть в пакетик"
          lines:
            - "Из пакета выпадает выигрышный купон… («Благосклонность» +%REWARD%)"
        - acc: 2
          content: "Осмотреть упаковку"
          lines:
            - "Резкий запах разом взбадривает %YOU%… (силы %YOU% +)"

# 普通事件
n_walk_through:
  title: "Пройти как обычно"
  lines:
    - if: d.first === 1
      lines:
        - "Прежде чем идти через этот узкий переулок, %YOU% немного робеет."
        - "Однако и вправду ничего не случается: ни ливня с ясного неба, ни вздыбившейся плитки, поднимающей странный ветер, — и вы спокойно проходите этот довольно длинный проулок."
        - "Вот только %YOU% машинально взял %CHARA% за руку и, выйдя из переулка, так и не вспомнил, что её надо бы отпустить."
    - if: d.first === 0
      lines:
        - "Взявшись за руки, вы проходите узким переулком."

n_walk:
  title: "Прогулка по улице"
  lines:
    - if: d.first === 1
      lines:
        - "Вы вместе идёте вдоль светлой, опрятной улицы; вокруг по двое, по трое проходят прохожие и приезжие."
        - "%YOU% и %CHARA% наслаждаются этой прогулочной праздностью, оставляя позади и понемногу меняющееся настроение вокруг."
        - "Идти дальше по этой дороге или свернуть на другую? Незаметно для себя вы прибавляете шаг."
    - if: d.first === 0
      lines:
        - "Вы вместе прогуливаетесь вдоль светлой, опрятной улицы."

n_shortcut:
  title: "Тропинка через рощу"
  lines:
    - "У рощи, мимо которой вы проходите, обнаруживается тропинка — похоже, ведёт прямо к следующему месту."
    - "Правда, дорожка и впрямь глухая…"
    - acc: 1
      content: "Два шага пробежать — и там (силы −, дополнительный ход вперёд)"
      lines:
        - "Вы по возможности трусцой добираетесь до следующего места."
    - acc: 2
      content: "Лучше пойдём не спеша"
      lines:
        - "Вы решаете и дальше идти по большой дороге."

n_street_food:
  title: "Уличная еда"
  lines:
    - "На прогулке вы проходите мимо лотка с уличной едой, и в воздухе плывёт лёгкий аромат."
    - "Под любопытным взглядом подопечной %YOU% решает…"
    - acc: 1
      content: "Взять попробовать («Благосклонность» −, силы +)"
      lines:
        - "Отведав тёплой и вкусной уличной снеди, вы продолжаете своё странствие."
    - acc: 2
      content: "Лучше в другой раз"

n_arcade:
  title: "Лотерейный автомат"
  lines:
    - if: d.first === 1
      lines:
        - "Проходя одним из переулков, вы находите лавку, где идёт лотерея для парочек."
        - "Вокруг тяжёлого на вид автомата с рукоятью толпятся пары."
        - "И тут подопечная будто намекая тянет вас за край одежды…"
        - acc: 1
          content: "Попробовать («Благосклонность» +, силы −)"
          lines:
            - "Взявшись за руки, вы вдвоём с силой проворачиваете рукоять, и вниз со стуком выкатывается шарик с надписью о выигрыше."
            - "Запястья ноют, зато не впустую — и вы уходите отсюда с лёгкой радостью. («Благосклонность» +%REWARD%)"
        - acc: 2
          content: "Пожалуй, не будем"
          lines:
            - "Мелькает тень огорчения, но %CHARA% всё же соглашается с мнением %YOU%."
            - "Вы вместе уходите отсюда."
    - if: d.first === 0
      lines:
        - "Проходя одним из переулков, вы находите лавку, где идёт розыгрыш для парочек…"
        - acc: 1
          content: "Давай вместе («Благосклонность» +, силы −)"
          lines:
            - "Запястья ноют, зато не впустую — и вы радостно уходите отсюда. («Благосклонность» +%REWARD%)"
        - acc: 2
          content: "Пожалуй, не будем"

n_promotion:
  title: "Зазывала у магазина"
  lines:
    - if: d.first === 1
      lines:
        - "На повороте улицы ваше внимание притягивает неприметный магазин одежды."
        - "Продавщица горячо зазывает %CHARA% примерить наряд за плату — вот только наряд этот, прямо скажем, откровенный."
        - "Вы переглядываетесь…"
        - acc: 1
          content: "А может, попробуем? («Благосклонность» +, влечение %YOU% +, влечение %CHARA% +)"
          lines:
            - "Надев этот наряд, %CHARA% смущённо показывает себя %YOU%, и дыхание у %YOU% тоже становится частым."
            - "А потом магазин отдаёт вам на память один снимок с примерки… («Благосклонность» +%REWARD%)"
        - acc: 2
          content: "Пожалуй, обойдёмся"
          lines:
            - "Поразмыслив, вы всё-таки отступаете."
            - "Вы уходите из магазина одежды."
    - if: d.first === 0
      lines:
        - "На повороте улицы ваше внимание притягивает магазин одежды, где предлагают платную примерку…"
        - acc: 1
          content: "А может, попробуем? («Благосклонность» +, влечение %YOU% +, влечение %CHARA% +)"
          lines:
            - "Наряд и правда откровенный, и дыхание у обоих становится частым… («Благосклонность» +%REWARD%)"
        - acc: 2
          content: "Пожалуй, обойдёмся"

# 坏事件
b_pet_anal:
  title: "Шлепок по попе"
  lines:
    # [正常]-[不安]
    - "Вы проходите мимо безлюдного лотка."
    - "И пока %YOU% пытается высмотреть в товаре что-нибудь полезное, кто-то вдруг хватает %YOU% за попу."
    - "%YOU% оборачивается — а %CHARA% как ни в чём не бывало разглядывает что-то сбоку от лотка."
    - acc: 1
      content: "Отплатить тем же"
      lines:
        - "%YOU% решает отплатить тем же: раз %SEX% так, то и он хватает её за попу."
        - "Смеясь и толкаясь, вы уходите от лотка. (влечение %YOU% ++, влечение %CHARA% +)"
    - acc: 2
      content: "Ничего не было"
      lines:
        - "%YOU% в итоге решает считать, что ничего не было."
        - "%YOU% и посмеивающаяся себе под нос %CHARA% один за другим уходят от лотка. (влечение %CHARA% ++)"

b_hug:
  title: "Нечаянные объятия"
  lines:
    # [正常]-[不安]
    - "Прежде чем идти этим узким тёмным переулком, %YOU% немного тревожится: вдруг подстерегает какая-нибудь неожиданность."
    - "Но выходит наоборот: внезапно вздыбившаяся плитка сбивает %CHARA% с шага, и та по инерции падает в сторону %YOU%."
    - "Приходишь в себя: в объятиях — %TEEN%, мягкая и сладко пахнущая, и смущённое лицо совсем близко…"
    - acc: 1
      content: "Погладить по телу"
      lines:
        - "Пальцы %YOU% сами собой скользят по тонкой спине подопечной, и %TEEN% в объятиях тихо, смущённо вскрикивает."
        - "Вы долго не размыкаете рук, и всё же %YOU% кажется, что этого мало… (влечение %YOU% ++, влечение %CHARA% +)"
    - acc: 2
      content: "Скорее подняться"
      lines:
        - "%YOU% тут же помогает %CHARA% встать, а %CHARA% только смущённо улыбается и кивает, будто хочет что-то сказать и не решается."
        - "После этой безобидной заминки вы, взявшись за руки, выходите из переулка. (влечение %CHARA% ++)"

b_pet_leg:
  title: "Погладить по бедру"
  lines:
    # [正常]-[不安]
    - "%YOU% и %CHARA% сидят бок о бок на уличной скамейке, и упругие ноги прижаты к самому боку %YOU%."
    - "А эти красивые ноги неспешно покачиваются над землёй…"
    - acc: 1
      content: "Протянуть руку"
      lines:
        - "%YOU% тянется к этим ногам, которые от привычности только соблазнительнее, а %CHARA% лишь застенчиво толкает %YOU% плечом."
        - "И только когда %YOU% насытился, %CHARA% с румянцем на лице тянет любимого дальше в путь. (влечение %YOU% +, влечение %CHARA% ++)"
    - acc: 2
      content: "Сдержаться изо всех сил"
      lines:
        - "%YOU% удерживается от того, чтобы протянуть руку, и %CHARA% смотрит на вас с недоумением и лёгким разочарованием."
        - "Посидев ещё немного, вы снова отправляетесь в путь. (влечение %CHARA% ++)"

b_movie:
  title: "Кино на улице"
  lines:
    # [正常]-[不安]
    - "Вы проходите мимо экрана во всю стену: на нём по кругу крутят классическую сцену из какого-то фильма о любви."
    - "И тут %CHARA% обхватывает руку %YOU% и, подражая героине с экрана, медленно тянется к щеке того, кто рядом…"
    - acc: 1
      content: "Пусть %SEX% поцелует"
      lines:
        - "Лёгкий поцелуй мягко ложится на щёку, и сердце %YOU% под улыбку %CHARA% понемногу разгоняется. (влечение %YOU% ++, влечение %CHARA% +)"
    - acc: 2
      content: "Пока уклониться"
      lines:
        - "%YOU% слегка уходит от движения %CHARA%, и дальше вы просто смотрите отрывок фильма. (влечение %CHARA% ++)"

b_cafe:
  title: "Кофейня"
  lines:
    # [不安]
    - "Вы проходите мимо кофейни под открытым небом: за столиками целуются пары, чьих лиц не разглядеть, и им нет дела до окружающих."
    - "%CHARA% легонько тянет %YOU% за руку, и %YOU% понимает намёк."
    - acc: 1
      content: "Поцеловать"
      lines:
        - "%YOU% и %CHARA% какое-то время целуются. (влечение %YOU% ++, влечение %CHARA% +)"
    - acc: 2
      content: "Сделать вид, что не понял"
      lines:
        - "%CHARA% разочарованно идёт следом за %YOU% прочь от кофейни. (влечение %CHARA% ++)"

b_lucky_sukebe:
  title: "Счастливчик-извращенец?"
  lines:
    # [不安]
    - "То ли плитка вдруг встала дыбом, то ли в тихую погоду откуда ни возьмись налетел недобрый ветер?"
    - "Так или иначе, идущий по улице %YOU% вдруг поскальзывается и валится в сторону %CHARA%…"
    - acc: 1
      content: "Зажмуриться"
      lines:
        - "%YOU% под общий вскрик утыкается во что-то мягкое, а открыв глаза, видит грудь, в которую зарылся, и смущённое лицо %CHARA%."
        - "И потому %CHARA%, напустив на себя недовольный вид, ещё долго с удовольствием пихается с %YOU%, прежде чем вы идёте дальше. (влечение %YOU% ++, влечение %CHARA% +)"
    - acc: 2
      content: "Окликнуть %CHARA%"
      lines:
        - "%YOU% вовремя подаёт голос, и, хоть без прикосновения к чувствительным местам не обошлось, %CHARA% всё же крепко ловит %YOU%."
        - "А потом %CHARA% с чуть покрасневшими щеками силой ведёт %YOU% под руку добрую часть дороги. (влечение %CHARA% ++)"

b_rain:
  title: "Внезапный дождь"
  lines:
    # [不安]
    - "Хлынувший ниоткуда ливень запирает %YOU% и %CHARA% в переулке у улицы и вымачивает одежду обоих насквозь."
    - "Приходишь в себя: в ладони — мягкая, влажная грудь %CHARA%, а раскрасневшееся лицо любимой, у которой одежда просвечивает кожу, совсем рядом…"
    - acc: 1
      content: "Обнять: %SEX% не против"
      lines:
        - "%YOU% протягивает руку и дразнит любимую в своих объятиях, а %CHARA% отвечает и сливается с %YOU% в поцелуе."
        - "«Дождь» снаружи давно кончился, а те двое в переулке всё никак не разомкнутся… (влечение %YOU% ++, влечение %CHARA% +)"
    - acc: 2
      content: "Отстраниться"
      lines:
        - "Хоть и очень хочется приласкать — %SEX% ведь так и манит, — %YOU% всё же сдерживается."
        - "Подозрительный «дождь» длится недолго, и потом вы быстро уходите из переулка. (влечение %CHARA% ++)"

b_ero_item:
  title: "Вибрирующая игрушка"
  lines:
    # [不安]
    - if: d.first === 1
      lines:
        - "На уличном мероприятии вам достаётся сомнительный подарок: теперь в руках %YOU% пара миниатюрных виброяиц с пультом."
        - "И пока %YOU% не знает, что с этим делать, он замечает, что %CHARA% нарочно смотрит в сторону, а рука, вцепившаяся в отворот одежды, чуть-чуть заворачивает подол вверх."
    - if: d.first === 0
      lines:
        - "%YOU% косится на телефон и обнаруживает, что «мини-виброяйца» неведомо когда успели зарядиться до полного…"
    - acc: 1
      content: "Уступить %CHARA%"
      lines:
        - "С молчаливого позволения %CHARA% %YOU% заводит игрушку под лифчик — %SEX% не мешает — и нажимает кнопку на телефоне."
        - "А потом та опасная, запретная игра-прогулка тянется под тихое дыхание %CHARA% ровно до тех пор, пока у игрушки не садится заряд… (влечение %YOU% ++, влечение %CHARA% +)"
    - acc: 2
      content: "Немного подразнить"
      lines:
        - "%YOU% с досадой уводит %CHARA% в закуток у улицы и игрушкой через одежду унимает «пыл» — а %SEX% только жмётся ближе."
        - "У маленькой игрушки заряд садится быстро, но %CHARA%, похоже, так и не насытилась… (влечение %CHARA% ++)"

b_advance:
  title: "Дразнить без повода"
  lines:
    # [不安]-[混乱]
    - "%YOU% с подопечной как раз проходят один из поворотов улицы."
    - "И пока %YOU% осторожно шагает вперёд, он вдруг чувствует, как чья-то рука забирается под одежду снизу и понемногу тянется вперёд, между ног."
    - "Можно и не смотреть, какое лицо сейчас у той, что рядом, — а рядом разгорячённая %TEEN%, — и какое лицо у него самого, с оборвавшимся рассудком…"
    - acc: 1
      content: "Пусть %SEX% «запомнит урок»"
      lines:
        - "%YOU% убирает беспорядочно шарящую руку %CHARA% и без всякой пощады стягивает с %CHARA% и без того сползшую одежду."
        - "Кожа трётся о кожу, и %CHARA% издаёт похабные звуки, будто вымаливая пощаду… (влечение %YOU% ++, влечение %CHARA% +)"
    - acc: 2
      content: "Оттолкнуть: пусть %SEX% остынет"
      lines:
        - "Изо всех сил сдерживая порыв излить желание на %CHARA%, %YOU% с силой отталкивает — и %SEX% отлетает в сторону."
        - "%YOU% идёт дальше, и %SEX% следом… (влечение %CHARA% ++)"

b_blow_job:
  title: "Минет под открытым небом"
  lines:
    # [不安]-[混乱]
    - "Вы проходите мимо площадки с открытым экраном: на нём по кругу крутят сцену, где пара совокупляется по-звериному."
    - "И тут %CHARA%, подражая героине с экрана, приседает и с поплывшим взглядом медленно тянет вниз одежду %YOU%…"
    - acc: 1
      content: "Пусть %CHARA% обслужит"
      lines:
        - "Вы садитесь у экрана, а %CHARA% послушно склоняется и мягко гладит пальцами %YOU% между ног."
        - "%CHARA% ласкает себя и одновременно старательно работает рукой над %YOU% — пока обоим не станет довольно… (влечение %YOU% ++, влечение %CHARA% +)"
    - acc: 2
      content: "Пока уклониться"
      lines:
        - "%YOU% всеми правдами и неправдами поднимает %CHARA% на ноги и, когда %SEX% немного остыла, уходит с площадки. (влечение %CHARA% ++)"

b_anal_item:
  title: "Игрушка для попки"
  lines:
    # [不安]-[混乱]
    - if: d.first === 1
      lines:
        - "На уличном мероприятии вам достаётся сомнительный подарок: теперь в руках %YOU% анальная пробка с металлическим отливом."
        - "И пока %YOU% не знает, что с этим делать, он видит, что %CHARA% с красным лицом смотрит в сторону, а руки неловко теребят подол."
    - if: d.first === 0
      lines:
        - "%YOU% косится на %CHARA% и замечает: %SEX% снова украдкой тянет руку в сумку, а там лежит та самая анальная игрушка — %SEX% же её и хранит."
    - acc: 1
      content: "Уступить %CHARA%"
      lines:
        - "%YOU% под молчаливое согласие %CHARA% стягивает бельё — %SEX% лишь приподнимает бёдра, — и, пока стонет %TEEN%, вводит холодный предмет в попку, которую %SEX% послушно подставляет."
        - "А потом, в тревоге и остроте от пустоты под одеждой и чужого предмета внутри, игра-прогулка тянется до тех пор, пока %CHARA% уже не в силах сдержать ни поток, ни дыхание… (влечение %YOU% ++, влечение %CHARA% +)"
    - acc: 2
      content: "Немного подразнить"
      lines:
        - "%YOU% с досадой уводит %CHARA% в переулок и игрушкой возвращает ей «рассудок»: %SEX% ласкает себя сзади, пока не отпустит."
        - "Спустя время %YOU% выводит из переулка тяжело дышащую %CHARA%, но %SEX%, похоже, не насытилась пресным пиком… (влечение %CHARA% ++)"

b_foot_job:
  title: "Тайная игра"
  lines:
    # [不安]-[混乱]
    - "Вы решаете немного передохнуть, а поблизости как раз оказывается ресторан с площадкой под открытым небом."
    - "Вы находите свободный столик среди множества парочек и садитесь, но незаметно между ног %YOU% появляется ощущение, будто их теребит что-то мягкое."
    - "%YOU% опускает глаза и обнаруживает, что %CHARA% скинула туфли и красивыми ступнями под столом дразнит его чувствительное место, а во взгляде, устремлённом на него, — сплошное вожделение."
    - acc: 1
      content: "Уступить %CHARA%"
      lines:
        - "%YOU% украдкой распускает пояс, отдавая себя пальцам ног %CHARA%, а %CHARA%, заходя всё дальше, заодно тянет руку и к себе самой."
        - "Парочки вокруг с головой ушли в свои нежности и никого не замечают, а вы в этой тайной игре вместе доходите до пика… (влечение %YOU% ++, влечение %CHARA% +)"
    - acc: 2
      content: "Не обращать внимания"
      lines:
        - "%YOU%, удержав рассудок, лишь ловит эти красивые ноги и недолго их гладит, но желание в глазах %CHARA% от этого только густеет… (влечение %CHARA% ++)"