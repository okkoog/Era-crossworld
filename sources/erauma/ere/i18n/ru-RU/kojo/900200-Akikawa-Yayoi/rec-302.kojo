recruit:
  - color: %COLOR%
    content:
      - fontWeight: bold
        content: %CHARA%
      - "「Шок!」"
  - color: %COLOR%
    content:
      - fontWeight: bold
        content: %CHARA%
      - "「Растерянность! Ч-ч-что делать!」"
  - "「Шах и мат! Деваться некуда — иди со мной!」"
  - color: %COLOR%
    content:
      - fontWeight: bold
        content: %CHARA%
      - "「Аба-аба-аба-аба……」"
