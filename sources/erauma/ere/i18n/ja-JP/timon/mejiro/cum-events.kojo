# @file メジロの呼び声 - 霧の探索イベント
# @author イーウィヤ
# @author 99

# 好事件
g_water:
  title: 甘い泉水
  lines:
    - if: d.first === 1
      lines:
        - %YOU%と %CHARA% は散歩広場のような場所を見つけた。広場では鳩がのんびり歩き、何羽かは小さな台に止まっている。
        # 谨慎行动
        - if: d.action === 0
          content: %YOU%と %CHARA% は建物の裏から慎重に出てきた。鳩たちは羽ばたいて少し飛び、鳥に囲まれていた小さな台は噴水式の直飲水だった。
        # 普通行动
        - if: d.action === 1
          content: %YOU%と %CHARA% は足早に近づいた。鳩たちは羽ばたいて少し飛び、鳥に囲まれていた小さな台は噴水式の直飲水だった。
        # 急切行动
        - if: d.action === 2
          content: %YOU%と %CHARA% は慌てて駆け寄った。鳩たちは羽ばたいて少し飛び、鳥に囲まれていた小さな台は噴水式の直飲水だった。
        - 鳩に異常はなさそうだったので、少し考えてから、水を掬ってゆっくり飲んだ。
    - if: d.first === 0
      lines:
        - %YOU%と %CHARA% は見覚えのある直飲水を見つけ、掬って飲んだ。
    - 涼やかな水が渇いた喉を撫で、気力がふっと戻った。（体力+）

g_lost_and_found:
  title: 遺失物
  lines:
    - if: d.first === 1
      lines:
        - ふたりは遺失物預かりを見つけた。
        - かわいい小さな飾り、読み古された文庫、骨の曲がった折りたたみ傘……預かり所にあっても自然な、だが使い道のない品々。
        - だが、なぜ一枚のポイントカードの裏、名義人の署名欄に%YOU%の名があるのだろう。
        - 考えた末、%YOU%は無用の山のなかからこのカードを持ち帰った——もしかすると、もともと%YOU%のものだったのかもしれない。（「恩寵」+%REWARD%）
    - if: d.first === 0
      lines:
        - %YOU%は遺失物預かりで、%YOU%の名が書かれたポイントカードを見つけた。（「恩寵」+%REWARD%）

g_clothe:
  title: 身だしなみ
  lines:
    - if: d.first === 1
      lines:
        - %YOU%と%CHARA%は、まだきれいな公衆トイレのそばを通り、一息つくことにした。
        - 用を足したあと、%YOU% は洗面台の蛇口を開き、冷たい水を顔へ浴びせた。
        - 涼気が後頭部を通り、%YOU%は頭がかなりはっきりしたのを感じた。
        - 出てきた %CHARA% の顔に残る水滴も拭い、ふたりは再び歩き出した。（性欲-）
    - if: d.first === 0
      lines:
        - ふたりは公衆トイレで簡単に身を整えた。 （性欲-）

g_chair:
  title: 木陰のベンチ
  lines:
    - if: d.first === 1
      lines:
        - 高層の並ぶ賑やかな本通りから少し離れ、近くの公園の木陰のベンチに座った。
        - 空はよく、林の空気は新しく、%YOU%と %CHARA% はその静けさを味わった。
        - ベンチに座ると、隣の担当が微笑んで%YOU%を見ている。%YOU%は……
        - acc: 1
          content: 少し休む
          lines:
            - しばらく整えたあと、隣の %CHARA% は立ち上がり、自分から飲み物を買いに行こうとした。
            - %CHARA% が戻るまで、%YOU%は背もたれに寄り、目を閉じて休んだ。（%YOU%性欲--）
        - acc: 1
          content: %CHARA% をひとりにする
          lines:
            - %YOU%は立ち上がって自分から飲み物を買いに行き、戻ると、数メートル先から%CHARA%が嬉しそうに迎えてきた。
            - 少し休んだあと、空の瓶をゴミ箱へ入れ、ふたりは上機嫌に再び歩き出した。（%CHARA%性欲--）
        - acc: 2
          content: 話す
          lines:
            - %YOU%は隣の%SEX%に笑いながら声をかけ、%CHARA% も笑顔で%YOU%を迎えた。
            - 笑い声のなか、気づかないうちにふたりはまた歩き出していた。（性欲-）
    - if: d.first === 0
      lines:
        - ふたりは木陰のベンチに座った。
        - acc: 1
          content: 少し休む
          lines:
            - %CHARA% がひとりで動いているあいだ、%YOU%は目を閉じて休んだ。（%YOU%性欲--）
        - acc: 2
          content: %CHARA% をひとりにする
          lines:
            - %YOU% は公園を少し歩き、%CHARA%をひとりにした。（%CHARA%性欲--）
        - acc: 3
          content: 話す
          lines:
            - ふたりはしばらく話した。（性欲-）

g_bus:
  title: 公共交通
  lines:
    - if: d.first === 1
      lines:
        - %YOU%と %CHARA% は、いま着いた電車に乗った。
        - 幸い、この車両にはほとんど客がいなかった。窓際の席を適当に選んで座った。
        - 電車はゆっくり進み、%YOU%と %CHARA% は手を繋いで窓際に並び、外の景色が後ろへ流れていくのを見た。
        - この穏やかさがもう少し続けばいいのに。隣の担当の微笑む横顔を見て、%YOU%はふと思った。
        - ……残念ながら、電車はほんの一区間で終点に着いた。（追加で一度前進）
    - if: d.first === 0
      lines:
        - %YOU%と %CHARA% は着いた電車に乗り、すぐに終点で降りた。（追加で一度前進）

g_lucky:
  title: 幸運の報酬
  lines:
    - if: d.first === 1
      lines:
        - %YOU% と %CHARA% はコンビニのそばでしばらく留まることにした。
        - そのあと、%CHARA% は好奇心に駆られて店へ入り、見慣れない小さな菓子を一袋持ち帰った。
        - acc: 1
          content: 袋の中を見る
          lines:
            - %YOU%は担当に礼を言い、慎重に袋を破ると、当たりカードが一枚落ちた。
            - 思いがけず当たった。小さな賞だが、ふたりの気分は確かに整った。（「恩寵」+%REWARD%）
        - acc: 2
          content: 包装を見る
          lines:
            - 包装には試作味とあり、刺激的な香りで%YOU%の気力が戻った。（%YOU%体力+）
    - if: d.first === 0
      lines:
        - ふたりはコンビニのそばで短く休み、店へ入った担当が見慣れない小さな菓子を一袋持ち帰った。
        - acc: 1
          content: 袋の中を見る
          lines:
            - 当たりカードが袋から落ちた……（「恩寵」+%REWARD%）
        - acc: 2
          content: 包装を見る
          lines:
            - 刺激的な香りで%YOU%の気力が戻った……（%YOU%体力+）

# 普通事件
n_walk_through:
  title: ただの通り抜け
  lines:
    - if: d.first === 1
      lines:
        - この狭い路地を抜ける前、%YOU%は少し気がかりだった。
        - だが何も起きなかった。突然の驟雨もなく、怪風を起こす敷石もなく、長い路地を無事に抜けた。
        - ただし、%YOU%は無意識に %CHARA% の手を握り、出口を出ても離すことを思い出さなかった。
    - if: d.first === 0
      lines:
        - ふたりは手を繋いで狭い路地を抜けた。

n_walk:
  title: 街歩き
  lines:
    - if: d.first === 1
      lines:
        - ふたりは明るく整った通りを並んで歩き、まわりの通行人と旅人が三三五五と通り過ぎる。
        - %YOU%と%CHARA%はこの外出ののんびりを味わい、少しずつ変わる空気も後ろへ置いた。
        - このまま行くか、別の道を見るか。気づかないうちに歩幅が速くなっていた。
    - if: d.first === 0
      lines:
        - ふたりは明るく整った通りを並んで歩いた。

n_shortcut:
  title: 林の近道
  lines:
    - 通りかかった林のそばに小径があり、次の場所へ真っ直ぐ通じていそうだ。
    - ただし、この道はかなり僻地だ……
    - acc: 1
      content: 少し走れば着く（体力-、追加で一度前進）
      lines:
        - ふたりはできるだけ小走りで次の場所へ向かった。
    - acc: 2
      content: ゆっくり歩こう
      lines:
        - ふたりは大通りから進むことにした。

n_street_food:
  title: 屋台
  lines:
    - 歩いていると屋台の前を通り、空気に淡い香りが漂っていた。
    - 担当の好奇心に満ちた目を見て、%YOU%は……
    - acc: 1
      content: 少し買ってみる（「恩寵」-、体力+）
      lines:
        - 温かく美味しい屋台の味を味わったあと、ふたりは旅を続けた。
    - acc: 2
      content: また今度にしよう

n_arcade:
  title: 抽選ゲーム
  lines:
    - if: d.first === 1
      lines:
        - 路地を通ると、恋人向けの抽選チャレンジをしている店を見つけた。
        - 重そうな抽選機の前には、対になった男女が群がっている。
        - そのとき、担当が衣の裾をそっと引いた……
        - acc: 1
          content: やってみよう（「恩寵」+、体力-）
          lines:
            - ふたりは手を繋いでグリップを力強く下ろし、当たり情報が書かれた小球が落ちた。
            - 手首は痛いが収穫はあった。少し嬉しそうにその場を離れた。（「恩寵」+%REWARD%）
        - acc: 2
          content: やめておこう
          lines:
            - 少し落胆は見せたが、%CHARA%は%YOU%の意見を受け入れた。
            - ふたりはその場を離れた。
    - if: d.first === 0
      lines:
        - 路地を通ると、恋人向けの抽選をしている店を見つけた……
        - acc: 1
          content: 一緒にやろう（「恩寵」+、体力-）
          lines:
            - 手首は痛いが収穫はあった。嬉しそうにその場を離れた。（「恩寵」+%REWARD%）
        - acc: 2
          content: やめておこう

n_promotion:
  title: 店の宣伝
  lines:
    - if: d.first === 1
      lines:
        - 街角を通ると、目立たない衣料店に目を引かれた。
        - 店員は熱心に%CHARA%へ有償の試着を勧めたが、その服はどう見ても煽情的だった。
        - ふたりは顔を見合わせ……
        - acc: 1
          content: やってみる？（「恩寵」+、%YOU%性欲+、%CHARA%性欲+）
          lines:
            - その服を着た%CHARA%は羞恥げに%YOU%へ体を見せ、%YOU%の息も少し荒くなった。
            - あとで店は試着の写真を一枚、記念にふたりへ渡した……（「恩寵」+%REWARD%）
        - acc: 2
          content: やめておこう
          lines:
            - 考えた末、ふたりは退いた。
            - 衣料店を離れた。
    - if: d.first === 0
      lines:
        - 街角を通ると、有償試着をしている衣料店に目を引かれた……
        - acc: 1
          content: やってみる？（「恩寵」+、%YOU%性欲+、%CHARA%性欲+）
          lines:
            - 服があまりに煽情的で、ふたりの息も荒くなった……（「恩寵」+%REWARD%）
        - acc: 2
          content: やめておこう

# 坏事件
b_pet_anal:
  title: 尻を掴む
  lines:
    # [正常]-[不安]
    - ふたりは無人の小さな屋台の前を通った。
    - %YOU%が屋台のなかから何か役立つものを探していると、突然尻を掴まれた。
    - %YOU%が振り返ると、%CHARA% は何事もないように屋台の脇の何かを見ていた。
    - acc: 1
      content: 仕返しする
      lines:
        - %YOU%は仕返しに、%SEX%の尻を掴み返した。
        - ふたりは笑い合いながら屋台を離れた。（%YOU%性欲++、%CHARA%性欲+）
    - acc: 2
      content: なかったことにする
      lines:
        - %YOU%は結局、なかったことにした。
        - %YOU%と、忍び笑いする %CHARA% は、順に屋台を離れた。（%CHARA%性欲++）

b_hug:
  title: 不意の抱擁
  lines:
    # [正常]-[不安]
    - この狭く暗い路地を抜ける前、%YOU%は少し心配していた。予想外の危険がないかと。
    - だが思いどおりにはいかず、突然跳ねた敷石が%CHARA%の足を捉え、%YOU%のほうへ倒れ込んできた。
    - 気づくと、腕のなかの%TEEN%は柔らかく甘い。羞恥に染まった顔がすぐそこにある……
    - acc: 1
      content: 体を撫でる
      lines:
        - %YOU%の指は自然に担当の細い背を滑り、腕のなかの%TEEN%は羞恥の小さな声を漏らした。
        - ふたりは長く抱き合ってから離れたが、%YOU%はまだ足りない気がした……（%YOU%性欲++、%CHARA%性欲+）
    - acc: 2
      content: すぐ起き上がる
      lines:
        - %YOU%はすぐ%CHARA%を起こし、%CHARA%は羞恥の笑みを浮かべ、言いかけて頷いただけだった。
        - この無害な挿話のあと、ふたりは手を繋いで路地を出た。（%CHARA%性欲++）

b_pet_leg:
  title: 太ももを撫でる
  lines:
    # [正常]-[不安]
    - %YOU%と%CHARA%は通りのベンチに並んで座り、引き締まった両脚が%YOU%の脇に密着している。
    - その美しい脚が、ベンチの上でゆるゆると揺れている……
    - acc: 1
      content: 手を伸ばす
      lines:
        - %YOU%はその、慣れがいっそう誘う両脚へ手を伸ばし、%CHARA%は恥ずかしそうに%YOU%の肩へ軽くぶつかっただけだった。
        - %YOU%が満足するまで、%CHARA%は頬を赤らめて恋人の手を引き、再び歩き出した。（%YOU%性欲+、%CHARA%性欲++）
    - acc: 2
      content: こらえる
      lines:
        - %YOU%は触りたい欲をこらえ、%CHARA%は少し困惑し、少し失望した目でこちらを見た。
        - しばらく座ったあと、ふたりは再び歩き出した。（%CHARA%性欲++）

b_movie:
  title: 街頭上映
  lines:
    # [正常]-[不安]
    - 幕壁の画面の前を通ると、恋愛映画の名場面が循環していた。
    - そのとき、%CHARA%は%YOU%の腕を抱え、作中のヒロインのように、隣の人の頬へゆっくり近づいた……
    - acc: 1
      content: %SEX%に吻させる
      lines:
        - 軽い口づけが優しく頬に落ち、%YOU%の心拍は%CHARA%の笑みのなかでゆっくり速まった。（%YOU%性欲++、%CHARA%性欲+）
    - acc: 2
      content: いったん避ける
      lines:
        - %YOU% は%CHARA%の動きをわずかに避け、そのあと普通に映画の断片を少し見た。（%CHARA%性欲++）

b_cafe:
  title: カフェ
  lines:
    # [不安]
    - 露店のカフェの前を通ると、顔の見えない恋人たちが席で人目を気にせず口づけしていた。
    - %CHARA% は%YOU%の手を軽く引き、%YOU%はその暗示を読んだ。
    - acc: 1
      content: 口づける
      lines:
        - %YOU%と %CHARA% はしばらく口づけした。（%YOU%性欲++、%CHARA%性欲+）
    - acc: 2
      content: 気づかないふり
      lines:
        - %CHARA% は失望して%YOU%についてカフェから離れた。（%CHARA%性欲++）

b_lucky_sukebe:
  title: 幸運な痴漢？
  lines:
    # [不安]
    - 突然跳ねた敷石か、穏やかな天気に突然吹いた邪風か。
    - とにかく、大通りを歩いていた%YOU%は足を滑らせ、隣の%CHARA%のほうへ倒れた……
    - acc: 1
      content: 目を閉じる
      lines:
        - %YOU%は悲鳴のなかで柔らかい何かへ倒れ、目を開けると、埋まった胸と%CHARA%の羞恥の顔があった。
        - そこで、わざと拗ねた %CHARA% は勢いで %YOU% といちゃついて押し合い、しばらくしてから歩き出した。（%YOU%性欲++、%CHARA%性欲+）
    - acc: 2
      content: %CHARA%に知らせる
      lines:
        - %YOU%は間に合って声をかけた。敏感なところに触れずには済まなかったが、%CHARA%はしっかりと%YOU%を受け止めた。
        - だがそのあと、頬を赤らめた%CHARA%は無理に%YOU%を支えて、かなり長い道を歩いた。（%CHARA%性欲++）

b_rain:
  title: 突然の雨
  lines:
    # [不安]
    - 突然の大雨が%YOU%と %CHARA%を通りの路地に閉じ込め、ふたりの服を透けるまで濡らした。
    - 気づくと、手には%CHARA%の胸の柔らかく湿った感触があり、服から肌が透ける恋人の紅い顔がすぐそこにある……
    - acc: 1
      content: %SEX%を抱く
      lines:
        - %YOU%は腕のなかの恋人を挑発し、%CHARA%も勢いで%YOU%と唇を重ねた。
        - 外の「雨」はとっくに止んでいたが、路地のなかのふたりは長く離れなかった……（%YOU%性欲++、%CHARA%性欲+）
    - acc: 2
      content: 距離を取る
      lines:
        - 誘う%SEX%といちゃつきたい気持ちはあったが、%YOU%は行為をこらえた。
        - 怪しい「雨」は長く続かず、そのあとふたりは急いで路地を離れた。（%CHARA%性欲++）

b_ero_item:
  title: 振動する玩具
  lines:
    # [不安]
    - if: d.first === 1
      lines:
        - 通りの催しで怪しい景品をもらい、いまは小さな遠隔ローターが一対、%YOU%の手にある。
        - %YOU%がどうしていいか分からないでいると、%CHARA%はよそを見るふりをしながら、襟を掴んだ手で裾をわずかに捲っていた。
    - if: d.first === 0
      lines:
        - %YOU%は携帯を覗くと、「ミニローター」の充電がいつの間にか満タンになっているのに気づいた……
    - acc: 1
      content: %CHARA%に従う
      lines:
        - %CHARA%の黙認のなか、%YOU%は玩具を%SEX%のブラへ入れ、携帯のリモコンを押した。
        - そのあとの危うく禁忌な歩行ゲームは、%CHARA%の低い喘ぎのなか、電池が尽きるまで続いた……（%YOU%性欲++、%CHARA%性欲+）
    - acc: 2
      content: 少し挑発する
      lines:
        - %YOU%は仕方なく%CHARA%と通りの隅へ縮こまり、服の上から玩具で%SEX%の「興」を鎮めた。
        - 小さな電動玩具はすぐに電池が尽きたが、%CHARA%は満たされなかったようだ……（%CHARA%性欲++）

b_advance:
  title: 理由のない挑発
  lines:
    # [不安]-[混乱]
    - %YOU%と担当は街角を通りかかっていた。
    - %YOU%が慎重に進んでいると、突然下着のなかへ手が入り、前の両脚のあいだへ伸びてきた。
    - 見なくても分かる。隣の発情した%TEEN%がどんな顔をしているか、理性の切れた自分がどんな顔をしているか……
    - acc: 1
      content: %SEX%に「覚えさせる」
      lines:
        - %YOU%は%CHARA%の乱れた手を払い、容赦なく%CHARA%の緩んだ下着を引き剥がした。
        - 肌が擦れるなか、%CHARA%は下品な許しを乞う声を上げた……（%YOU%性欲++、%CHARA%性欲+）
    - acc: 2
      content: %SEX%を押しのける
      lines:
        - %CHARA%へ欲を晴らしたい衝動をこらえ、%YOU%は%SEX%を力強く押しのけた。
        - %YOU%は%SEX%を連れて前へ進んだ……（%CHARA%性欲++）

b_blow_job:
  title: 露天の口奉仕
  lines:
    # [不安]-[混乱]
    - 露天の上映場を通ると、恋人の対が獣のように交わる断片が循環していた。
    - そのとき、%CHARA%は作中のヒロインのように蹲り、恍惚とした顔で%YOU%の下着をゆっくり下ろした……
    - acc: 1
      content: %CHARA%に奉仕させる
      lines:
        - ふたりは上映場に座り、%CHARA%は素直に身を傾け、指で優しく%YOU%の股間を撫でた。
        - %CHARA% は自慰をしながら手で %YOU% に奉仕し、満たされるまで続けた……（%YOU%性欲++、%CHARA%性欲+）
    - acc: 2
      content: いったん避ける
      lines:
        - %YOU% はなんとか %CHARA% を立たせ、%SEX%が少し落ち着いてからその場を離れた。（%CHARA%性欲++）

b_anal_item:
  title: 後穴の玩具
  lines:
    # [不安]-[混乱]
    - if: d.first === 1
      lines:
        - 通りの催しで怪しい景品をもらい、いまは金属光沢のアナルプラグが %YOU% の手にある。
        - %YOU%がどうしていいか分からないでいると、%CHARA% は頬を赤らめてよそを見ていたが、両手は落ち着かなげに裾を掴んでいた。
    - if: d.first === 0
      lines:
        - %YOU% は隣の %CHARA% を見ると、%SEX%がまた袋へ手を伸ばしているのに気づいた。そこには%SEX%に預けた後穴の玩具が入っている。
    - acc: 1
      content: %CHARA%に従う
      lines:
        - %YOU% は %CHARA% の黙認する空気のなかで%SEX%の下着を下ろし、%TEEN%の喘ぎのなかで冷たい異物を%SEX%の後穴へ押し込んだ。
        - そのあと、下着なしで異物を入れた不安と刺激のなか、散歩ゲームは %CHARA% が潮と喘ぎを抑えきれなくなるまで続いた……（%YOU%性欲++、%CHARA%性欲+）
    - acc: 2
      content: 少し挑発する
      lines:
        - %YOU%は仕方なく%CHARA%を隣の路地へ連れていき、玩具で%SEX%の後穴を慰め、「理性を戻す」形にした。
        - しばらくして、%YOU% は息の荒い %CHARA% を連れて路地を出たが、%SEX%は平凡な絶頂では満たされなかったようだ……（%CHARA%性欲++）

b_foot_job:
  title: 隠れた遊び
  lines:
    # [不安]-[混乱]
    - ふたりは少し休むことにした。近くにはちょうどレストランのテラスがあった。
    - 勢いで、対になった恋人たちのあいだに空いた卓を見つけたが、気づかないうちに、%YOU% の両脚のあいだへ柔らかい何かが戯れる感触がきた。
    - 下を見ると、%CHARA% は靴を脱ぎ、きれいな両足で卓の下から %YOU% の急所を弄び、見る目は愛欲に満ちていた。
    - acc: 1
      content: %CHARA%に従う
      lines:
        - %YOU% はこっそり下の帯を解き、%CHARA% の趾が両脚のあいだで遊ぶに任せ、%CHARA%も深く入りながら自分の局部へ手を伸ばした。
        - まわりの恋人たちは人目を気にせずいちゃついており、ふたりも隠れた遊びのなかで一緒に絶頂を迎えた……（%YOU%性欲++、%CHARA%性欲+）
    - acc: 2
      content: 相手にしない
      lines:
        - 理性を保った %YOU% は、その美しい両脚を掴んで軽く愛撫しただけだったが、%CHARA% の目の欲はいっそう濃くなった……（%CHARA%性欲++）
