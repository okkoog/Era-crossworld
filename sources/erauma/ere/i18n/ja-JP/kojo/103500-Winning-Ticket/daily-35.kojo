# @file ウイニングチケット - 日常
# @author 幽白書
# @author Claude (翻訳)

# @author 幽白書
good_morning_after_basement:
  sync: true
  lines:
    - color: %COLOR%
      content:
        - fontWeight: bold
          content: %CHARA%
        - 「え？%CALLNAME%、どうして私の顔を見て、そんなに驚いてるの？」
    - color: %COLOR%
      content:
        - fontWeight: bold
          content: %CHARA%
        - 「もしかして……もう会いたくない？ 私のそばから、ずっと逃げたいの？」
    - color: %COLOR%
      content:
        - fontWeight: bold
          content: %CHARA%
        - 「え……えへへ、うん、やっぱり違うよね。%CALLNAME% は、ずっと私と一緒にいてくれる。そうでしょ？」

# @author 幽白書
select_after_basement:
  sync: true
  lines:
    - color: %COLOR%
      content:
        - fontWeight: bold
          content: %CHARA%
        - 「うわあああああああ、%CALLNAME% が相手してくれないと、つらいよ……」
    - color: %COLOR%
      content:
        - fontWeight: bold
          content: %CHARA%
        - 「もう少しで、%CALLNAME% をまた私たちの愛の巣に連れていくところだった……」
    - color: %COLOR%
      content:
        - fontWeight: bold
          content: %CHARA%
        - 「よかった、%CALLNAME% が会いに来てくれた！だって私たちは本当に愛し合ってるんだから、そうでしょ！」
