# @file メジロラモーヌ - 日常
# @author イーウィヤ
# @author Claude (翻訳)

# @author イーウィヤ
select_after_basement:
  sync: true
  lines:
    - color: %COLOR%
      content:
        - fontWeight: bold
          content: %CHARA%
        - 「……驚きました？ 怖くなりました？ あなたへの『愛』が、怖いのですか？」
    - color: %COLOR%
      content:
        - fontWeight: bold
          content: %CHARA%
        - 「ふふ、そうですわね。あなたと私の愛は、これしきで変わるはずがない。そう信じていますわ。」
    - color: %COLOR%
      content:
        - fontWeight: bold
          content: %CHARA%
        - 「……これからも、あなたのすべての指示に、すべての『愛』に、従いますわ。」
