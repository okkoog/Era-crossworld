;--------------------------------------------------
@CONVERT_DEVIL_CHILDREN, ARG
#LOCALSSIZE 22
#DIM 検索候補
#DIM 検索結果
IF LOCALS:0 == ""
	LOCALS:0  = {[[キャラ:アリアンフロッド]]}　→　{[[キャラ:スクルド]]}
	LOCALS:1  = {[[キャラ:サラスヴァティ]]}　　→　{[[キャラ:ヴェルザンディ]]}
	LOCALS:2  = {[[キャラ:ハトホル]]}　　　　　→　{[[キャラ:タヌキのナマモノ]]}
	LOCALS:3  = {[[キャラ:スカアハ]]}　　　　　→　{[[キャラ:クロト]]}
	LOCALS:4  = {[[キャラ:トラソルテオトル]]}　→　{[[キャラ:アトロポス]]}
	LOCALS:5  = {[[キャラ:サティ]]}　　　　　　→　{[[キャラ:ラケシス]]}
	LOCALS:6  = {[[キャラ:アルテミス]]}　　　　→　{[[キャラ:ウルズ]]}
	LOCALS:7  = {[[キャラ:エンジェル]]}　　　　→　{[[キャラ:キューピッド]]}
	LOCALS:8  = {[[キャラ:エロス]]}　　　　　　→　{[[キャラ:ネコのナマモノ]]}
