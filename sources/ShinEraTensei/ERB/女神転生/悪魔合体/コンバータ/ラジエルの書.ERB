	LOCALS:21 = {[[キャラ:グレンデル]]}　　　　→　{[[キャラ:タロス]]}
ENDIF
FOR LOCAL,0,VARSIZE("LOCALS")
	検索候補 = TOINT(AUTO_SPLIT(LOCALS:LOCAL,"　",0))
	検索結果 = TOINT(AUTO_SPLIT(LOCALS:LOCAL,"　→　",1))
	SIF ARG != 検索候補
		CONTINUE
	RETURN 検索結果
NEXT
RETURN ARG
