	LOCALS:10 = {[[キャラ:スキュラ]]}　　　　　→　{[[キャラ:ダッキ]]}
	LOCALS:11 = {[[キャラ:バステト]]}　　　　　→　{[[キャラ:ダッキ]]}
	LOCALS:12 = {[[キャラ:キマイラ]]}　　　　　→　{[[キャラ:ヘルグリフォン]]}
	LOCALS:13 = {[[キャラ:オルトロス]]}　　　　→　{[[キャラ:デスケルベロス]]}
	LOCALS:14 = {[[キャラ:カーシー]]}　　　　　→　{[[キャラ:クール]]}
	LOCALS:15 = {[[キャラ:カブソ]]}　　　　　　→　{[[キャラ:クール]]}
	LOCALS:16 = {[[キャラ:ラタトスク]]}　　　　→　{[[キャラ:ベール]]}
	LOCALS:17 = {[[キャラ:ケルベロス]]}　　　　→　{[[キャラ:ヘルケルベロス]]}
