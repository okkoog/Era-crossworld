				PRICE:6 = 3000
				GIFT:7 = 含光の剣
				PRICE:7 = 1000
				GIFT:8 = 宝玉輪
				PRICE:8 = 1000
				GIFT:9 = コアシールド
				PRICE:9 = 500
				GIFT:10 = チャクラドロップ
				PRICE:10 = 500
				GIFT:11 = ディスガイズグッズ
				PRICE:11 = 200
				GIFT:12 = メタルカード
				PRICE:12 = 20
		ENDSELECT
		CALL DUNGEON_SHOP, 3, GIFT:1, PRICE:1, GIFT:2, PRICE:2 , GIFT:3, PRICE:3, GIFT:4, PRICE:4, GIFT:5, PRICE:5, GIFT:6, PRICE:6, GIFT:7, PRICE:7, GIFT:8, PRICE:8, GIFT:9, PRICE:9, GIFT:10, PRICE:10, GIFT:11, PRICE:11, GIFT:12, PRICE:12, GIFT:13, PRICE:13, GIFT:14, PRICE:14, GIFT:15, PRICE:15, GIFT:16, PRICE:16, GIFT:17, PRICE:17, GIFT:18, PRICE:18, GIFT:19, PRICE:19
	CASE 9
		SELECTCASE ARG
			CASE 1
				PRINTL 店長:
				PRINTW 「まぁ、いろいろあるだろうけど、また遊びに来てよ」
				PRINTW 「それなりに歓迎はするし」
				DRAWLINE
			CASE 2
				PRINTL 魔界人:
				PRINTW 「又のお越しをお待ちしております」
			CASE 3
				PRINTL 悪魔:
				PRINTW 「また、来るんだな。へっへっへ」
			CASEELSE
				PRINTL ＞どうする？
		ENDSELECT
		RETURN 1
ENDSELECT
GOTO START
