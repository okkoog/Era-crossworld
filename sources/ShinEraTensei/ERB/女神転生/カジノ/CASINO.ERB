						GIFT:3 = スキルカード【メギド】
						GIFT:4 = ALLマイナスカード
						PRICE:3 = 2500
						PRICE:4 = 1000
					CASE 4
						GIFT:3 = スキルカード【ムド】
						GIFT:4 = スキルカード【ザン】
						GIFT:5 = スキルカード【グライ】
						GIFT:6 = スキルカード【マリンカリン】
						GIFT:7 = バイタリティソース
						GIFT:8 = LUCインセンスカード
						GIFT:9 = INTマイナスカード
					CASE 5
						GIFT:3 = スキルカード【フレイ】
						GIFT:4 = スキルカード【アクア】
						GIFT:5 = スキルカード【ヤマオロシ】
						GIFT:6 = スキルカード【一分の活泉】
						GIFT:7 = アジリティソース
						GIFT:8 = STRインセンスカード
						GIFT:9 = MAGマイナスカード
