@CASINO, ARG
#LOCALSIZE 10
#LOCALSSIZE 10
#DIMS GIFT,20
#DIM PRICE,20
VARSET GIFT
VARSET PRICE
LOCAL = 0
;ARGでとりあえず店を識別できるようにしておく
;1:ムー大陸　2:ビエンの街 3:新宿
SELECTCASE ARG
	CASE 1
		PRINTL 店長:
		PRINTW 「いらっしゃいませ。ムー大陸へようこそ」
		PRINTL 「コインチェンジと景品の交換は、
		PRINTL 　こちらで承ります。なんなりと言えや」
	CASE 2
		PRINTL 魔界人:
		PRINTL 「幸運のカジノへようこそ」
		PRINTW 「中のキャッシャーで魔貨をコインに変えてお楽しみください」
	CASE 3
		PRINTL 悪魔:
		PRINTL 「幸運のカジノようこそ」
		PRINTW 「中のキャッシャーで魔貨をコインに変えられるから、せいぜいたのしむことだな」
	CASEELSE
		PRINTL ＞どうする？
ENDSELECT
$START
PRINTL 
DRAWLINE
PRINTL ＞どうする？
CALL INPUT_SELECT(1, "ゲームをする",2, "コインを買う", 3, "コインを景品と交換する", 9, "カジノを出る")
SELECTCASE RESULT
	CASE 1
		CALL INPUT_SELECT(1, "ＳＬＯＴ ＳＵＰＥＲ２７", 2, "ＰＯＫＥＲ Ｈ＆Ｌ" ,3, "ＫＥＮＯ" ,4, "ＣＯＤＥ　ＢＲＥＡＫＥＲ",9, "前に戻る")
		SELECTCASE RESULT
			CASE 1
				CALL SUPER_27
			CASE 2
				CALL POKER
			CASE 3
				CALL KENO
			CASE 4
				CALL NANDI, ARG
		ENDSELECT
	CASE 2
		IF ARG == 1
			PRINTL ＞コイン1枚につき、120円です
			PRINTL ＞何枚買いますか？
			PRINTFORML 所持金 {MONEY}円　所持コイン {MONEY:3}枚
			CALL INPUT_MANY(0, MONEY/120)
			IF RESULT == 0
				PRINTW ＞コインを買いませんでした
			ELSE
				MONEY:3 += RESULT
				MONEY -= RESULT*120
				PRINTFORML ＞{RESULT}枚購入しました
				PRINTFORMW ＞これで%CALLNAME:MASTER%の所持するコインは{MONEY:3}枚です
			ENDIF
		ELSE
			PRINTL ＞コイン1枚につき、2魔貨です
			PRINTL ＞何枚買いますか？
			PRINTFORML 所持金 {MONEY:1}魔貨　所持コイン {MONEY:3}枚
			CALL INPUT_MANY(0, MONEY:1/2)
			IF RESULT == 0
				PRINTW ＞コインを買いませんでした
			ELSE
				MONEY:3 += RESULT
				MONEY:1 -= RESULT*2
				PRINTFORML ＞{RESULT}枚購入しました
				PRINTFORMW ＞これで%CALLNAME:MASTER%の所持するコインは{MONEY:3}枚です
			ENDIF
		ENDIF
	CASE 3
		SELECTCASE ARG
			;ムー大陸 とりあえず暫定
