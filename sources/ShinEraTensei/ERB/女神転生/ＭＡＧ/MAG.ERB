@MAG_ENHANCE_DEFTYPE,ARG
DRAWLINE
PRINTFORML □耐性強化　　(現在ＭＡＧ：{BASE:ARG:ＭＡＧ})
SIF TALENT:ARG:デビルシフター
	PRINTL 　※デビルシフターは初期変身悪魔の耐性を強化させることが出来ます
DRAWLINE
PRINTFORML %CALLNAME:ARG,20,LEFT%
IF CFLAG:ARG:変更相性1 > 0
	PRINTFORM 現在強化している相性：%GET_TYPE(CFLAG:ARG:変更相性1-1) %
		PRINTFORM \@ (CFLAG:ARG:変更相性値1 < 0) ? 吸 # 　\@
		PRINTFORM \@ ((CFLAG:ARG:変更相性値1 != 999)) ? {ABS(CFLAG:ARG:変更相性値1),4}％ # %" " *2%反射 \@
	PRINTL

;	IF CFLAG:ARG:変更相性値1 == 999
;		PRINTFORML 反射
;	ELSEIF CFLAG:ARG:変更相性値1 == 0
;		PRINTFORML 無効
;	ELSE
;		PRINTFORML {CFLAG:ARG:変更相性値1}％
;.	ENDIF
ENDIF
DRAWLINE
PRINTL どの相性を変更しますか？
FOR LOCAL,0,FLAG:相性数-1
	PRINTFORM [{LOCAL,2}]%GET_TYPE(LOCAL) %
		PRINTFORM \@ (MAXBASE:ARG:(GET_TYPE(LOCAL)) < 0) ? 吸 # 　\@
		PRINTFORM \@ ((MAXBASE:ARG:(GET_TYPE(LOCAL)) != 999)) ? {ABS(MAXBASE:ARG:(GET_TYPE(LOCAL))),4}％ # %" " *2%反射 \@　
	SIF LOCAL % 6 == 5
		PRINTL
NEXT
PRINTL
PRINTL [100]戻る
$INPUT_LOOP
INPUT
IF RESULT == 100
	RETURN 0
ELSEIF RESULT < 0 || RESULT >= FLAG:相性数-1
	GOTO INPUT_LOOP
ENDIF
LOCAL:1 = RESULT
DRAWLINE

PRINTFORML %GET_TYPE(LOCAL:1)%の防御相性をどうしますか？
	PRINTFORM 現在：\@(MAXBASE:ARG:(GET_TYPE(LOCAL:1)) < 0) ? 吸 # 　\@
	PRINTFORM \@ ((MAXBASE:ARG:(GET_TYPE(LOCAL:1)) != 999)) ? {ABS(MAXBASE:ARG:(GET_TYPE(LOCAL:1))),4}％ # %" " *2%反射 \@

;PRINTFORM 現在：
;IF MAXBASE:ARG:GET_TYPE(LOCAL:1) == 999
;	PRINTFORML 反射
;ELSEIF MAXBASE:ARG:GET_TYPE(LOCAL:1) == 0
;	PRINTFORML 無効
;ELSE
;	PRINTFORML {MAXBASE:ARG:GET_TYPE(LOCAL:1)}％
;ENDIF

PRINTL
SIF MAXBASE:ARG:GET_TYPE(LOCAL:1) > 100 && MAXBASE:ARG:GET_TYPE(LOCAL:1) != 999
	PRINTFORML [1]通常 必要ＭＡＧ：{50*(BASE:ARG:CP)}
SIF MAXBASE:ARG:GET_TYPE(LOCAL:1) > 50 && MAXBASE:ARG:GET_TYPE(LOCAL:1) != 999
	PRINTFORML [2]半減 必要ＭＡＧ：{500*(BASE:ARG:CP)}
SIF MAXBASE:ARG:GET_TYPE(LOCAL:1) != 0
	PRINTFORML [3]無効 必要ＭＡＧ：{2500*(BASE:ARG:CP)}
SIF MAXBASE:ARG:GET_TYPE(LOCAL:1) >= 0
	PRINTFORML [4]吸収 必要ＭＡＧ：{5000*(BASE:ARG:CP)}
SIF MAXBASE:ARG:GET_TYPE(LOCAL:1) != 999
	PRINTFORML [5]反射 必要ＭＡＧ：{5000*(BASE:ARG:CP)}
DRAWLINE
PRINTL [0] 戻る
$INPUT_LOOP_2
INPUT

IF RESULT == 0
	RESTART
ELSEIF RESULT == 1 && MAXBASE:ARG:GET_TYPE(LOCAL:1) > 100 && MAXBASE:ARG:GET_TYPE(LOCAL:1) != 999 && BASE:ARG:ＭＡＧ >= 50*(BASE:ARG:CP)
	CFLAG:ARG:変更相性1 = LOCAL:1+1
	CFLAG:ARG:変更相性値1 = 100
	BASE:ARG:ＭＡＧ -= 50*(BASE:ARG:CP)
ELSEIF RESULT == 2 && MAXBASE:ARG:GET_TYPE(LOCAL:1) > 50 && MAXBASE:ARG:GET_TYPE(LOCAL:1) != 999 && BASE:ARG:ＭＡＧ >= 500*(BASE:ARG:CP)
	CFLAG:ARG:変更相性1 = LOCAL:1+1
	CFLAG:ARG:変更相性値1 = 50
	BASE:ARG:ＭＡＧ -= 500*(BASE:ARG:CP)
ELSEIF RESULT == 3 && MAXBASE:ARG:GET_TYPE(LOCAL:1) != 0 && BASE:ARG:ＭＡＧ >= 2500*(BASE:ARG:CP)
	CFLAG:ARG:変更相性1 = LOCAL:1+1
	CFLAG:ARG:変更相性値1 = 0
	BASE:ARG:ＭＡＧ -= 2500*(BASE:ARG:CP)
ELSEIF RESULT == 4 && MAXBASE:ARG:GET_TYPE(LOCAL:1) >= 0 && BASE:ARG:ＭＡＧ >= 5000*(BASE:ARG:CP)
	CFLAG:ARG:変更相性1 = LOCAL:1+1
	CFLAG:ARG:変更相性値1 = -50
	BASE:ARG:ＭＡＧ -= 5000*(BASE:ARG:CP)
ELSEIF RESULT == 5 && MAXBASE:ARG:GET_TYPE(LOCAL:1) != 999 && BASE:ARG:ＭＡＧ >= 5000*(BASE:ARG:CP)
	CFLAG:ARG:変更相性1 = LOCAL:1+1
	CFLAG:ARG:変更相性値1 = 999
	BASE:ARG:ＭＡＧ -= 5000*(BASE:ARG:CP)
ELSE
	GOTO INPUT_LOOP_2
ENDIF
CALL SYNC_STATUS,ARG


@MAG_GROWTH,ARG
DRAWLINE
PRINTL □体力・気力強化
DRAWLINE
PRINTL どちらを強化しますか？
PRINTFORML %NAME:ARG,20,LEFT%(現在ＭＡＧ：{BASE:ARG:ＭＡＧ})
