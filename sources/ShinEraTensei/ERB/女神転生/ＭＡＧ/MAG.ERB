@SHOPCOMABLE_122
RESULTS = 仲魔強化
LOCAL:1 = 0
FOR LOCAL,0,CHARANUM
	SIF ABL:LOCAL:種族 > 0 && ABL:LOCAL:種族 < 46
		LOCAL:1 += 1
NEXT
IF LOCAL:1 > 0
	RETURN 1
ENDIF
RETURN 0

@SHOP_COM_122
P = 0
;表示させるキャラを抽出（Q:*に表示するキャラの登録番号、LOCAL:2に人数）
VARSET Q, -1
A = 0
REPEAT CHARANUM
	;SIF COUNT == MASTER
	;	CONTINUE
	SIF CFLAG:COUNT:労役フラグ == 3
		CONTINUE
	SIF CFLAG:COUNT:この場に居ないフラグ == 1
		CONTINUE
	SIF CFLAG:COUNT:フィルタリングフラグ
		CONTINUE

	Q:A = COUNT
	A += 1
REND
LOCAL:2 = A




$PRINT_LIST
DRAWLINE
PRINTFORML ＭＡＧを使って強化するキャラを選んでください　＜page.{P}＞
DRAWLINE
CALL SHOW_CHARA_LIST
DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 16% # [1007]前のページ\@
PRINTLC [1000]戻る
PRINTFORMLC \@(P >= (LOCAL:2 - 1) / 20) ? %" " * 16% # [1009]次のページ\@

$INPUT_LOOP_1
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1007
	IF P > 0
		P -= 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT == 1009
	LOCAL = (LOCAL:2 - 1) / 20
	IF P < LOCAL
		P += 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF MATCH(Q,RESULT,0) < 1
	GOTO INPUT_LOOP_1
ENDIF

CALL ENHANCE,RESULT

GOTO PRINT_LIST

@ENHANCE,ARG
DRAWLINE
PRINTFORML %NAME:ARG%をどうしますか？　　(現在ＭＡＧ：{BASE:ARG:ＭＡＧ})
PRINTL

;能力ＵＰに必要な値を計算
IF ARG != MASTER
	LOCAL:1 = CFLAG:ARG:能力強化回数/3 + 1
	SELECTCASE FLAG:戦闘難易度
		CASE 1 TO 3
			LOCAL:10 = 250
		CASE 4,5,6
			LOCAL:10 = 100
	ENDSELECT
	PRINTFORML [1]基本能力強化(必要ＭＡＧ：{LOCAL:10*LOCAL:1*(LOCAL:1+1)})
ENDIF
;SIF ARG != MASTER
;	PRINTL [3]スキル変異
IF TALENT:ARG:喰奴
	IF GETBIT(FLAG:マントラ開放度, 1)
		PRINTL [2]スキルセット
		PRINTL [3]ステータスセット
	ENDIF
	;シナリオ進行による制限が実装されるまでの仮措置
	SETBIT FLAG:マントラ開放度, 0
	SIF FLAG:マントラ開放度
		PRINTL [4]マントラ取得
ELSE
	SIF (ARG != MASTER || TALENT:ARG:異能者) && !TALENT:ARG:達人
		PRINTL [2]スキルランクアップ
	SIF (ARG != MASTER && !TALENT:ARG:達人) || TALENT:ARG:異能者
		PRINTL [3]スキル消去
	SIF (ARG != MASTER && ABL:ARG:種族 != 45 && !TALENT:ARG:達人) || TALENT:ARG:異能者
		PRINTFORML [4]スキル習得
ENDIF
SIF (ABL:ARG:種族 != 0 && ABL:ARG:種族 != 36) || TALENT:ARG:デビルシフター == 1 || TALENT:ARG:喰奴 == 1
	PRINTL [5]攻撃性能強化
SIF ABL:ARG:種族 != 0 && ABL:ARG:種族 != 45 || TALENT:ARG:デビルシフター == 1
	PRINTL [6]耐性強化
PRINTL [7]体力・気力強化
		
;造魔LVUPに必要な経験値を計算
IF ABL:ARG:種族 == 45
	LOCAL:11 = MAX(1,2*(BASE:ARG:LV-1)*(BASE:ARG:LV)*(BASE:ARG:LV+1))
	IF BASE:ARG:LV > BASE:MASTER:LV
		FOR LOCAL,0, BASE:ARG:LV - BASE:MASTER:LV
			TIMES LOCAL:11 , 1.20
		NEXT
	ENDIF
	PRINTFORML [8]造魔レベルアップ(必要ＭＡＧ：{LOCAL:11})
ENDIF

;SIF TALENT:ARG:非戦闘員
;	PRINTFORML [9]レベルアップ(必要ＭＡＧ：{10*(BASE:ARG:LV)*(BASE:ARG:LV+1)/2})
DRAWLINE
PRINTL [0]戻る

$INPUT_LOOP
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT == 1 && ARG != MASTER
	IF BASE:ARG:ＭＡＧ < LOCAL:10*LOCAL:1*(LOCAL:1+1)
		PRINTFORMW ＭＡＧが足りません。
		GOTO INPUT_LOOP
	ENDIF
	CALL ENHANCE_BASE,ARG
ELSEIF RESULT == 2
	IF TALENT:ARG:喰奴
		CALL SET_MANTRA_SKILL, ARG
	ELSEIF ARG != MASTER || TALENT:ARG:異能者
		IF TALENT:ARG:ペルソナ使い
			PRINTFORMW ペルソナ使いはスキルランクアップを出来ません
			GOTO INPUT_LOOP
		ENDIF
		CALL MAG_SKILL_RANKUP,ARG
	ENDIF
;ELSEIF RESULT == 3 && ARG != MASTER
;	IF TALENT:ARG:ペルソナ使い
;		PRINTFORMW ペルソナ使いはスキル変異を出来ません
;		GOTO INPUT_LOOP
;	ENDIF
;	CALL MAG_SKILL_MUTATION,ARG
ELSEIF RESULT == 3 && !TALENT:ARG:達人
	IF TALENT:ARG:喰奴
		CALL MANTRA_BASESTATUS, ARG
	ELSEIF ARG != MASTER || TALENT:ARG:異能者
		IF TALENT:ARG:ペルソナ使い
			PRINTFORMW ペルソナ使いはスキル消去を実行出来ません
			GOTO INPUT_LOOP
		ENDIF
		CALL MAG_SKILL_DELETE,ARG
	ENDIF
ELSEIF RESULT == 4 && !TALENT:ARG:達人
	IF TALENT:ARG:喰奴
		CALL DOWNLOAD_MANTRA, 7, 7, ARG
	ELSEIF (ARG != MASTER && ABL:ARG:種族 != 45) || TALENT:ARG:異能者
		IF TALENT:ARG:ペルソナ使い
			PRINTFORMW ペルソナ使いはスキル習得を実行出来ません
			GOTO INPUT_LOOP
		ENDIF
		FOR LOCAL,1,FLAG:スキル数+1
			IF TALENT:ARG:デビルシフター == 0
				LOCALS = スキル{LOCAL}
			ELSE
				LOCALS = 初期変身悪魔スキル{LOCAL}
			ENDIF
			SIF ABL:ARG:LOCALS == 0
				GOTO OK_5
		NEXT
		PRINTW 空いているスキル枠がありません
		GOTO INPUT_LOOP
		$OK_5
		;スキル習得用関数呼び出し、引数は対象キャラ、空きスキル枠
		CALL MAG_LEARN_SKILL,ARG,LOCALS
	ENDIF
ELSEIF RESULT == 5 && ((ABL:ARG:種族 != 0 && NO:ARG != 3501 && NO:ARG != 3502) || (TALENT:ARG:デビルシフター == 1 || TALENT:ARG:喰奴 == 1 ))
	CALL MAG_ENHANCE_ATTACK,ARG
ELSEIF RESULT == 6 && ((ABL:ARG:種族 != 0 && ABL:ARG:種族 != 45 ) || TALENT:ARG:デビルシフター == 1)
	CALL MAG_ENHANCE_DEFTYPE,ARG
ELSEIF RESULT == 7
	CALL MAG_GROWTH,ARG
ELSEIF RESULT == 8 && ABL:ARG:種族 == 45
	IF LOCAL:11 > BASE:ARG:ＭＡＧ
		PRINTW ＭＡＧが足りません
		CLEARLINE 2
		GOTO INPUT_LOOP
	ENDIF
	PRINTFORMW %NAME:ARG%のレベルが1上がりました
	BASE:ARG:ＭＡＧ -= LOCAL:11
	BASE:ARG:LV += 1
	CALLFORM EVENT_LEVELUP,ARG,1
	TRYCALLFORM EVENT_LEVELUP_{NO:ARG},1
	CALL SYNC_STATUS,ARG
	
;ELSEIF RESULT == 9 && TALENT:ARG:非戦闘員
;	IF 10*(BASE:ARG:LV)*(BASE:ARG:LV+1)/2 > BASE:ARG:ＭＡＧ
;		PRINTW ＭＡＧが足りません
;		CLEARLINE 2
;		GOTO INPUT_LOOP
;	ENDIF
;	PRINTFORMW %NAME:ARG%のレベルが1上がりました
;	BASE:ARG:ＭＡＧ -= 10*(BASE:ARG:LV)*(BASE:ARG:LV+1)/2
;	BASE:ARG:LV += 1
;	CALLFORM EVENT_LEVELUP,ARG,1
;	TRYCALLFORM EVENT_LEVELUP_{NO:ARG},1
;	CALL SYNC_STATUS,ARG
;	
ELSE
	GOTO INPUT_LOOP
ENDIF
RESTART




;===================================================
;基本能力強化
;===================================================
@ENHANCE_BASE,ARG
PRINTL □基本能力強化


;能力ＵＰに必要な値を計算
LOCAL:1 = CFLAG:ARG:能力強化回数
;/3 + 1
SELECTCASE FLAG:戦闘難易度
	CASE 1 TO 6
		LOCAL:10 = 250
	CASE 4,5,6
		LOCAL:10 = 100
ENDSELECT
LOCAL:2 = 0
FOR LOCAL, 0 ,10
	LOCAL:2 += (LOCAL:1/3+1) * (LOCAL:1/3+2)
	SIF LOCAL == 0
		LOCAL:3 = LOCAL:2*LOCAL:10
	SIF LOCAL == 4
		LOCAL:4 = LOCAL:2*LOCAL:10
	SIF LOCAL == 9
		LOCAL:5 = LOCAL:2*LOCAL:10
	LOCAL:1++
NEXT

IF BASE:ARG:ＭＡＧ < LOCAL:3
	PRINTW ＭＡＧが足りません
	RETURN 0
ENDIF
PRINTFORML どの能力を強化しますか？　　(現在ＭＡＧ：{BASE:ARG:ＭＡＧ})
PRINTFORML (必要ＭＡＧ １:{LOCAL:3,6}　５:{LOCAL:4,6}　１０:{LOCAL:5,6}
PRINTL  +1   +5  +10
FOR LOCAL,1,7
	PRINTFORML [{LOCAL}] [{LOCAL+10}] [{LOCAL+20}]%GET_BASESTATUS(LOCAL),4% {MAXBASE:ARG:(GET_BASESTATUS(LOCAL))-CFLAG:ARG:(GET_BASESTATUS(LOCAL) + "強化回数"),3} + {CFLAG:ARG:(GET_BASESTATUS(LOCAL) + "強化回数"),3}
NEXT
DRAWLINE
PRINTL [0]戻る

$INPUT_LOOP
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT < 7 && RESULT > 0
	PRINTFORMW %NAME:ARG%の%GET_BASESTATUS(RESULT)%が1上がった
	CFLAG:ARG:能力強化回数 += 1
	CFLAG:ARG:(GET_BASESTATUS(RESULT) + "強化回数") += 1
	CALL CONTROL_MAG,ARG,-LOCAL:3
	CFLAG:ARG:強化使用ＭＡＧ += LOCAL:3
ELSEIF RESULT < 17 && RESULT > 10
	IF BASE:ARG:ＭＡＧ < LOCAL:4
		PRINTFORMW MAGが足りない！
		RESTART
	ENDIF
	PRINTFORMW %NAME:ARG%の%GET_BASESTATUS(RESULT-10)%が5上がった
	CFLAG:ARG:能力強化回数 += 5
	CFLAG:ARG:(GET_BASESTATUS(RESULT-10) + "強化回数") += 5
	CALL CONTROL_MAG,ARG,-LOCAL:4
	CFLAG:ARG:強化使用ＭＡＧ += LOCAL:4
ELSEIF RESULT < 27 && RESULT > 20
	IF BASE:ARG:ＭＡＧ < LOCAL:5
		PRINTFORMW MAGが足りない！
		RESTART
	ENDIF
	PRINTFORMW %NAME:ARG%の%GET_BASESTATUS(RESULT-20)%が10上がった
	CFLAG:ARG:能力強化回数 += 10
	CFLAG:ARG:(GET_BASESTATUS(RESULT-20) + "強化回数") += 10
	CALL CONTROL_MAG,ARG,-LOCAL:5
	CFLAG:ARG:強化使用ＭＡＧ += LOCAL:5
ELSE
	GOTO INPUT_LOOP
ENDIF
CALL SYNC_STATUS,ARG
LOCAL:1 = CFLAG:ARG:能力強化回数/3 + 1
IF BASE:ARG:ＭＡＧ < LOCAL:10*LOCAL:1*(LOCAL:1+1)
	PRINTW ＭＡＧが足りなくなったので終了します。
	RETURN 0
ENDIF
RESTART


;===================================================
;スキルランクアップ
;===================================================
@MAG_SKILL_RANKUP,ARG
#DIM 素質ないよ , 1
PRINTFORML □スキルランクアップ　　(現在ＭＡＧ：{BASE:ARG:ＭＡＧ})
DRAWLINE
PRINTL どのスキルをランクアップしますか？
SIF TALENT:ARG:デビルシフター
	PRINTL ※デビルシフターは初期変身悪魔のスキルをランクアップさせることが出来ます


FOR LOCAL,0,FLAG:スキル数
	IF TALENT:ARG:デビルシフター == 0 && TALENT:ARG:喰奴 == 0
		LOCALS = スキル{LOCAL+1}
	ELSE
		LOCALS = 初期変身悪魔スキル{LOCAL+1}
	ENDIF
	IF ABL:ARG:LOCALS > 0
		RESULT = 0
		TRYCALLFORM SKILL_RANKUP_{ABL:ARG:LOCALS}
		SIF RESULT == 0
			SETCOLOR 0x404040
		CALLFORM SKILL_NAME_{ABL:ARG:LOCALS},ARG
		PRINTFORM 　[{LOCAL+1}]%RESULTS,20,LEFT%
		RESETCOLOR
	ENDIF
	SIF LOCAL % 4 == 3
		PRINTL
NEXT

DRAWLINE
PRINTL [0]戻る


$INPUT_LOOP
INPUT

IF RESULT == 0
	RETURN 0
ELSEIF RESULT < 1 || RESULT > FLAG:スキル数
	GOTO INPUT_LOOP
ELSE
	IF TALENT:ARG:デビルシフター == 0 && TALENT:ARG:喰奴 == 0
		LOCALS = スキル{RESULT}
	ELSE
		LOCALS = 初期変身悪魔スキル{RESULT}
	ENDIF
	RESULT = 0
	VARSET D,-1
	LOCAL:1 = 0
	TRYCALLFORM SKILL_RANKUP_{ABL:ARG:LOCALS}
	IF RESULT == 0
		REUSELASTLINE ランクアップできないスキルです。
		GOTO INPUT_LOOP
	ENDIF
	LOCAL:1 = RESULT
	CALLFORM SKILL_RANK_{ABL:ARG:LOCALS}
	LOCAL:2 = RESULT
	$PRINT_LIST
	FOR LOCAL,1,LOCAL:1+1
		CALLFORM SKILL_NAME_{D:LOCAL}
		CALLFORM SKILL_SUCCESSION_TYPE_{D:LOCAL}
		IF TALENT:ARG:GET_SUCCESSION(RESULT) == 0
			素質ないよ = 1
		ELSE
			素質ないよ = 0
		ENDIF
		CALLFORM SKILL_RANK_{D:LOCAL}
		PRINTFORML [{LOCAL}] %RESULTS,20,LEFT% {(POWER(RESULT,3)-POWER(LOCAL:2,3))*200*(1+素質ないよ)}MAG
	NEXT
	DRAWLINE
	PRINTL [0]戻る
	$INPUT_LOOP1
	INPUT
	IF RESULT == 0
		RESTART
	ELSEIF D:RESULT > 0
		LOCAL = D:RESULT
		IF CHECK_SKILL(ARG,LOCAL) > 0
			REUSELASTLINE 既に習得しているスキルです。
			GOTO INPUT_LOOP1
		ENDIF
		CALLFORM SKILL_SUCCESSION_TYPE_{LOCAL}
		IF TALENT:ARG:GET_SUCCESSION(RESULT) == 0
			素質ないよ = 1
		ELSE
			素質ないよ = 0
		ENDIF
		
		CALLFORM SKILL_RANK_{LOCAL}
		IF BASE:ARG:ＭＡＧ < (POWER(RESULT,3)-POWER(LOCAL:2,3))*200 * (1+素質ないよ)
			REUSELASTLINE ＭＡＧが足りません
			GOTO INPUT_LOOP1
		ENDIF
		CALLFORM SKILL_EXPLAIN_{LOCAL}
		DRAWLINE
		PRINTL よろしいですか？
		CALL INPUT_YN,"Yes","No",2

		SELECTCASE RESULT
			CASE 0
				CALLFORM SKILL_RANK_{LOCAL}
				CALL CONTROL_MAG,ARG,-(POWER(RESULT,3)-POWER(LOCAL:2,3))*200 * (1+素質ないよ)
				CALLFORM SKILL_NAME_{ABL:ARG:LOCALS}
				PRINTFORM %NAME:ARG%は一瞬のひらめきで%RESULTS%を

				;D:(RAND:(LOCAL:1))に登録された番号のスキルを習得
				ABL:ARG:LOCALS = LOCAL
				CALLFORM SKILL_NAME_{ABL:ARG:LOCALS}
				PRINTFORMW %RESULTS%へとランクアップさせた！
			CASE 1
				GOTO PRINT_LIST
		ENDSELECT
		
	ELSE
		GOTO INPUT_LOOP1
	ENDIF
	
ENDIF
RESTART


;===================================================
;スキル変異
;===================================================
@MAG_SKILL_MUTATION,ARG
PRINTFORML □スキル変異　　(現在ＭＡＧ：{BASE:ARG:ＭＡＧ})
DRAWLINE
PRINTL どのスキルを変異しますか？



FOR LOCAL,0,FLAG:スキル数
	IF TALENT:ARG:デビルシフター == 0 && TALENT:ARG:喰奴 == 0
		LOCALS = スキル{LOCAL+1}
	ELSE
		LOCALS = 初期変身悪魔スキル{LOCAL+1}
	ENDIF
	IF ABL:ARG:LOCALS > 0
		CALLFORM SKILL_NAME_{ABL:ARG:LOCALS},ARG
		PRINTFORM 　[{LOCAL+1}]%RESULTS,20,LEFT%
		CALLFORM SKILL_RANK_{ABL:ARG:LOCALS}
		LOCALS = ({POWER(RESULT,3)*500}MAG)
		PRINTFORM %LOCALS,11%
	ENDIF
	SIF LOCAL % 3 == 2 || LOCAL+1 == FLAG:スキル数
		PRINTL 
NEXT
DRAWLINE
PRINTL [0]戻る

$INPUT_LOOP
INPUT

IF RESULT == 0
	RETURN 0
ELSEIF RESULT < 1 || RESULT > FLAG:スキル数
	GOTO INPUT_LOOP
ELSE
	LOCALS = スキル{RESULT}
	SIF ABL:ARG:LOCALS < 1
		GOTO INPUT_LOOP
	CALLFORM SKILL_RANK_{ABL:ARG:LOCALS}
	LOCAL:2 = RESULT
	IF BASE:ARG:ＭＡＧ < POWER(LOCAL:2,3)*500
		REUSELASTLINE ＭＡＧが足りません
		GOTO INPUT_LOOP
	ENDIF
	
	;変異候補リスト作成
	VARSET D,-1
	LOCAL:1 = 0
	FOR LOCAL,1,3000
		RESULT = 0
		TRYCALLFORM SKILL_RANK_{LOCAL}
		;ランク±1まで、0は変異不可
		SIF RESULT == 0 || RESULT < LOCAL:2-1 || RESULT > LOCAL:2+1
			CONTINUE
		;継承不能スキルは変異候補に入らないようにする
		CALLFORM SKILL_SUCCESSION_TYPE_{LOCAL}
		SIF RESULT == 23
			CONTINUE
		SIF CHECK_SKILL(ARG,LOCAL) == 1
			CONTINUE
		D:(LOCAL:1) = LOCAL
		LOCAL:1 += 1
	NEXT
	IF LOCAL:1 == 0
		PRINTFORMW ………失敗した
		RESTART
	ENDIF
	CALL CONTROL_MAG,ARG,-POWER(LOCAL:2,3)*500
	CALLFORM SKILL_NAME_{ABL:ARG:LOCALS}
	PRINTFORM %NAME:ARG%は%RESULTS%を忘れ、
	
	;D:(RAND:(LOCAL:1))に登録された番号のスキルを習得
	ABL:ARG:LOCALS = D:(RAND:(LOCAL:1))
	CALLFORM SKILL_NAME_{ABL:ARG:LOCALS}
	PRINTFORMW %RESULTS%を習得した！
ENDIF
CALL SYNC_STATUS,ARG
CALL HEALTH_CHARA,ARG

;===================================================
;スキル習得
;===================================================
@MAG_LEARN_SKILL,ARG,ARGS
PRINTL □スキル習得
SIF TALENT:ARG:デビルシフター
	PRINTL 　※デビルシフターは初期変身悪魔のスキルを習得させることが出来ます

DRAWLINE
CALL SHOW_LEARN_SKILL,ARG


IF RESULT == 0
	RETURN 0
ELSE
	DRAWLINE
	LOCAL = RESULT
	;コストを計算
	CALLFORM SKILL_RANK_{LOCAL}
	LOCAL:1 = RESULT
	LOCAL:2 = POWER(RESULT,3)*150
	TRYCCALLFORM 継承不能_{LOCAL}
		SIF RESULT
			LOCAL:2 *= 3
	CATCH
	ENDCATCH
	CALLFORM SKILL_SUCCESSION_TYPE_{LOCAL}
	SIF TALENT:ARG:GET_SUCCESSION(RESULT) == 0
		LOCAL:2 *= 2
	CALLFORM SKILL_NAME_{LOCAL}
	PRINTFORML □%RESULTS%
	CALLFORM SKILL_EXPLAIN_{LOCAL}
	PRINTFORML スキルランク:{LOCAL:1,2}　　必要ＭＡＧ:{LOCAL:2,8}
	DRAWLINE
	PRINTFORML %CALLNAME:ARG,20,LEFT%(現在ＭＡＧ：{BASE:ARG:ＭＡＧ})
	IF LOCAL:2 > BASE:ARG:ＭＡＧ
		PRINTFORMW ＭＡＧが足りません
		RESTART
	ENDIF
	PRINTL 習得しますか？
	CALL INPUT_YN,"Yes","No",2

	SELECTCASE RESULT
		CASE 0
			ABL:ARG:ARGS = LOCAL
			CALL CONTROL_MAG , ARG , -LOCAL:2
			CALLFORM SKILL_NAME_{LOCAL}
			PRINTFORMW %CALLNAME:ARG%は%RESULTS%を習得した
			ITEM:(10000+LOCAL) -= 1
		CASE 1
			RESTART
	ENDSELECT
ENDIF
RETURN 0

