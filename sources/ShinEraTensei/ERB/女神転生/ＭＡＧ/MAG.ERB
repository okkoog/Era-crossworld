	PRINTFORML [1]体力 (現在の最大値:{MAXBASE:ARG:体力}) (+100 / {POWER(MAXBASE:ARG:体力/100,2)*2*(5+MAXBASE:ARG:体力/500+MAXBASE:ARG:体力/3000*5)}MAG)
	RESETCOLOR

