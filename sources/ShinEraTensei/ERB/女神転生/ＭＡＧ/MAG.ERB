CALL HEALTH_CHARA,ARG





;===================================================
;通常攻撃カスタマイズ
;===================================================
@MAG_ENHANCE_ATTACK,ARG
#LOCALSIZE 5

DRAWLINE
PRINTFORML □通常攻撃性能変更　　(現在ＭＡＧ：{BASE:ARG:ＭＡＧ})
DRAWLINE
PRINTL 何を変更しますか？
SIF TALENT:ARG:デビルシフター
	PRINTL 　※デビルシフターは初期変身悪魔の通常攻撃性能を変更させることが出来ます

SELECTCASE (TALENT:ARG:デビルシフター || TALENT:ARG:喰奴 ? ABL:ARG:初期リンク悪魔射程 # ABL:ARG:射程)
	CASE 1
		LOCALS = Ｓ
	CASE 2
		LOCALS = Ｍ
	CASE 3
		LOCALS = Ｌ
ENDSELECT
PRINTFORML [1]射程　　 （%LOCALS%）
SELECTCASE (TALENT:ARG:デビルシフター || TALENT:ARG:喰奴 ? ABL:ARG:初期リンク悪魔攻撃範囲 # ABL:ARG:攻撃範囲)
	CASE 1
		LOCALS = 単体
	CASE 2
		LOCALS = １列
	CASE 3
		LOCALS = 全体
ENDSELECT
PRINTFORML [2]攻撃範囲 （%LOCALS%）
IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
	PRINTFORML [3]相性　　 （%GET_TYPE(ABL:ARG:初期リンク悪魔攻撃相性)%）
ELSE
	PRINTFORML [3]相性　　 （%GET_TYPE(ABL:ARG:攻撃相性)%）
ENDIF
PRINTL [4]初期化
DRAWLINE
PRINTL [0]戻る

CALL INPUTINT,0,1,2,3,4
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 1
		$PRINT_RANGE
		VARSET LOCAL
		IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
			SIF ABL:ARG:初期リンク悪魔射程 != 1 && ABL:ARG:初期リンク悪魔攻撃範囲 != 3
				LOCAL:1 = 1
			SIF ABL:ARG:初期リンク悪魔射程 != 2 && ABL:ARG:初期リンク悪魔攻撃範囲 != 3
				LOCAL:2 = 1
			SIF ABL:ARG:初期リンク悪魔射程 != 3
				LOCAL:3 = 1
		
		ELSE
			SIF ABL:ARG:射程 != 1 && ABL:ARG:攻撃範囲 != 3
				LOCAL:1 = 1
			SIF ABL:ARG:射程 != 2 && ABL:ARG:攻撃範囲 != 3
				LOCAL:2 = 1
			SIF ABL:ARG:射程 != 3
				LOCAL:3 = 1
		
		ENDIF
		
		;射程
		DRAWLINE
		SIF LOCAL:1
			PRINTFORML [1]Ｓ （後列から攻撃不可能）　　　　　　　　{50*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2),8}ＭＡＧ
		SIF LOCAL:2
			PRINTFORML [2]Ｍ （後列から攻撃可能）　　　　　　　　　{250*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2),8}ＭＡＧ
		SIF LOCAL:3
			PRINTFORML [3]Ｌ （後列から攻撃可能、敵後列に攻撃可能）{500*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2),8}ＭＡＧ
		PRINTFORML ※射程が長いほど命中率が低下します
		DRAWLINE
		PRINTL [0]戻る
		$INPUT_LOOP_RANGE
		INPUT
		IF RESULT == 0
			RESTART
		ELSEIF RESULT == 1 && BASE:ARG:ＭＡＧ >= 50*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2) && LOCAL:1
			IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
				ABL:ARG:初期リンク悪魔射程 = 1
			ELSE
				ABL:ARG:射程 = 1
			ENDIF
			BASE:ARG:ＭＡＧ -= 50*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)
			RESTART
		ELSEIF RESULT == 2 && BASE:ARG:ＭＡＧ >= 250*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2) && LOCAL:2
			IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
				ABL:ARG:初期リンク悪魔射程 = 2
			ELSE
				ABL:ARG:射程 = 2
			ENDIF
			BASE:ARG:ＭＡＧ -= 250*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)
			RESTART
		ELSEIF RESULT == 3 && BASE:ARG:ＭＡＧ >= 500*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2) && LOCAL:3
			IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
				ABL:ARG:初期リンク悪魔射程 = 3
			ELSE
				ABL:ARG:射程 = 3
			ENDIF
			BASE:ARG:ＭＡＧ -= 500*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)
			RESTART
		ELSE
			GOTO INPUT_LOOP_RANGE
		ENDIF
	CASE 2
		$PRINT_SPHERE
		VARSET LOCAL
		IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
			SIF ABL:ARG:初期リンク悪魔攻撃範囲 != 1
				LOCAL:1 = 1
			SIF ABL:ARG:初期リンク悪魔攻撃範囲 != 2
				LOCAL:2 = 1
			SIF ABL:ARG:初期リンク悪魔攻撃範囲 != 3 && ABL:ARG:初期リンク悪魔射程 == 3
				LOCAL:3 = 1
		ELSE
			SIF ABL:ARG:攻撃範囲 != 1
				LOCAL:1 = 1
			SIF ABL:ARG:攻撃範囲 != 2
				LOCAL:2 = 1
			SIF ABL:ARG:攻撃範囲 != 3 && ABL:ARG:射程 == 3
				LOCAL:3 = 1
		ENDIF
		;攻撃範囲
		DRAWLINE
		SIF LOCAL:1
			PRINTFORML [1]単体　　{10*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2),10}ＭＡＧ
		SIF LOCAL:2
			PRINTFORML [2]１列　　{500*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2),10}ＭＡＧ
		SIF LOCAL:3
			PRINTFORML [3]全体　　{2500*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2),10}ＭＡＧ
		PRINTFORML ※攻撃範囲が広いほど威力が低下します
		PRINTFORML ※範囲を全体にするためには射程がＬである必要があります
		DRAWLINE
		PRINTL [0]戻る
		$INPUT_LOOP_SPHERE
		INPUT
		IF RESULT == 0
			RESTART
		ELSEIF RESULT == 1 && BASE:ARG:ＭＡＧ >= 10*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2) && LOCAL:1
			IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
				ABL:ARG:初期リンク悪魔攻撃範囲 = 1
			ELSE
				ABL:ARG:攻撃範囲 = 1
			ENDIF
			BASE:ARG:ＭＡＧ -= 10*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)
			RESTART
		ELSEIF RESULT == 2 && BASE:ARG:ＭＡＧ >= 500*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2) && LOCAL:2
			IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
				ABL:ARG:初期リンク悪魔攻撃範囲 = 2
			ELSE
				ABL:ARG:攻撃範囲 = 2
			ENDIF
			BASE:ARG:ＭＡＧ -= 500*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)
			RESTART
		ELSEIF RESULT == 3 && BASE:ARG:ＭＡＧ >= 2500*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2) && LOCAL:3
			IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
				ABL:ARG:初期リンク悪魔攻撃範囲 = 3
			ELSE
				ABL:ARG:攻撃範囲 = 3
			ENDIF
			BASE:ARG:ＭＡＧ -= 2500*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)
			RESTART
		ELSE
			GOTO INPUT_LOOP_SPHERE
		ENDIF
	CASE 3
		;相性
		$PRINT_TYPE
		VARSET LOCAL
		IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
			SIF ABL:ARG:初期リンク悪魔攻撃相性 != 0
				LOCAL:1 = 1
			SIF ABL:ARG:初期リンク悪魔攻撃相性 != 1
				LOCAL:2 = 1
			SIF ABL:ARG:初期リンク悪魔攻撃相性 != 2
				LOCAL:3 = 1
			SIF ABL:ARG:初期リンク悪魔攻撃相性 != 3
				LOCAL:4 = 1
		ELSE
			SIF ABL:ARG:攻撃相性 != 0
				LOCAL:1 = 1
			SIF ABL:ARG:攻撃相性 != 1
				LOCAL:2 = 1
			SIF ABL:ARG:攻撃相性 != 2
				LOCAL:3 = 1
			SIF ABL:ARG:攻撃相性 != 3
				LOCAL:4 = 1
		ENDIF
		DRAWLINE
		SIF LOCAL:1
			PRINTFORML [1]剣撃　　{100*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)*(1+(TALENT:ARG:武器)),10}ＭＡＧ
		SIF LOCAL:2
			PRINTFORML [2]飛具　　{100*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)*(1+(TALENT:ARG:射撃武器)),10}ＭＡＧ
		SIF LOCAL:3
			PRINTFORML [3]打撃　　{100*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)*(1+(TALENT:ARG:鉤爪 || TALENT:ARG:羽 || TALENT:ARG:鉤足 || TALENT:ARG:尾)),10}ＭＡＧ
		SIF LOCAL:4
			PRINTFORML [4]戦技　　{100*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)*(1+(TALENT:ARG:腕 || TALENT:ARG:足)),10}ＭＡＧ
		DRAWLINE
		PRINTL [0]戻る
		$INPUT_LOOP_TYPE
		INPUT
		IF RESULT == 0
			RESTART
		ELSEIF RESULT == 1 && BASE:ARG:ＭＡＧ >= 100*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)*(1+(TALENT:ARG:武器)) && LOCAL:1
			IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
				ABL:ARG:初期リンク悪魔攻撃相性 = 0
			ELSE
				ABL:ARG:攻撃相性 = 0
			ENDIF
			BASE:ARG:ＭＡＧ -= 100*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)*(1+(TALENT:ARG:武器))
			RESTART
		ELSEIF RESULT == 2 && BASE:ARG:ＭＡＧ >= 100*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)*(1+(TALENT:ARG:射撃武器)) && LOCAL:2
			IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
				ABL:ARG:初期リンク悪魔攻撃相性 = 1
			ELSE
				ABL:ARG:攻撃相性 = 1
			ENDIF
			BASE:ARG:ＭＡＧ -= 100*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)*(1+(TALENT:ARG:射撃武器))
			RESTART
		ELSEIF RESULT == 3 && BASE:ARG:ＭＡＧ >= 100*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)*(1+(TALENT:ARG:鉤爪 || TALENT:ARG:羽 || TALENT:ARG:鉤足 || TALENT:ARG:尾)) && LOCAL:3
			IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
				ABL:ARG:初期リンク悪魔攻撃相性 = 2
			ELSE
				ABL:ARG:攻撃相性 = 2
			ENDIF
			BASE:ARG:ＭＡＧ -= 100*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)*(1+(TALENT:ARG:鉤爪 || TALENT:ARG:羽 || TALENT:ARG:鉤足 || TALENT:ARG:尾))
			RESTART
		ELSEIF RESULT == 4 && BASE:ARG:ＭＡＧ >= 100*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)*(1+(TALENT:ARG:腕 || TALENT:ARG:足)) && LOCAL:4
			IF TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
				ABL:ARG:初期リンク悪魔攻撃相性 = 3
			ELSE
				ABL:ARG:攻撃相性 = 3
			ENDIF
			BASE:ARG:ＭＡＧ -= 100*POWER(CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0),2)*(1+(TALENT:ARG:腕 || TALENT:ARG:足))
			RESTART
		ELSE
			GOTO INPUT_LOOP_TYPE
		ENDIF
ENDSELECT


