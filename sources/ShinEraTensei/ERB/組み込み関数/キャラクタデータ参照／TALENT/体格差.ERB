
;体格の差を返す
;標準を0とした場合、
;小人:-10 小柄:-1 大柄:+1 巨体:+10
@体格差(ARG = -1, ARG:1 = -1)
#FUNCTION

SIF ARG == -1
	ARG = TARGET
SIF ARG:1 == -1
	ARG:1 = MASTER

IF TALENT:(ARG):小人体型
	LOCAL = -10
ELSEIF TALENT:(ARG):小柄体型
	LOCAL = -1
ELSEIF TALENT:(ARG):大柄
	LOCAL = 1
ELSEIF TALENT:(ARG):巨体
	LOCAL = 10
ELSE
	LOCAL = 0
ENDIF
IF TALENT:(ARG:1):小人体型
	LOCAL:1 = -10
ELSEIF TALENT:(ARG:1):小柄体型
	LOCAL:1 = -1
ELSEIF TALENT:(ARG:1):大柄
	LOCAL:1 = 1
ELSEIF TALENT:(ARG:1):巨体
	LOCAL:1 = 10
ELSE
	LOCAL:1 = 0
ENDIF

RETURNF LOCAL:1 - LOCAL