;-------------------------------------------------
;@GET_DEVIL
;ARGのキャラが悪魔かどうかを返す
;ARG:1で指定していた場合はNOを見る
;-------------------------------------------------
@GET_DEVIL, ARG, ARG:1 = -1
#FUNCTION
ARG:2 = ARG:1 >= 0 ? CSVABL(ARG:1, GETNUM(ABL, "種族"), 0) # ABL:ARG:種族
;人間はのぞく
SIF ARG:2 == 0
	RETURNF 0
;半魔人はのぞく
SIF ARG:2 == 36
	RETURNF 0
;造魔はのぞく
SIF ARG:2 == 45
	RETURNF 0
RETURNF 1