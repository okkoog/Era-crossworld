;==========================================================
;特定のスキルを習得しているかどうか
;ARG 対象のキャラ
;ARG:1 対象のスキル
;==========================================================
@CHECK_SKILL(ARG,ARG:1)
#FUNCTION
;ARGがスキルARG:1を持っているかを参照する
FOR LOCAL,1,FLAG:スキル数+1
	LOCALS = スキル{LOCAL}
	SIF ABL:ARG:LOCALS == ARG:1
		RETURNF 1
NEXT
RETURNF 0
