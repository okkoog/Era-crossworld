@GREET_PUB305,ARG
SELECTCASE CFLAG:ARG:友好度
	CASE IS > 25
		PRINTFORML 「%CSTR:ARG:11%と話がしたいの？」
		PRINTFORMW 「ふふ、いいわよ。%CSTR:ARG:11%を楽しませてちょうだい」
	CASE IS > -25
		PRINTFORML
		PRINTFORML 「%CSTR:ARG:11%と話をしたいの？」
		PRINTFORMW 「いいわよ、何かしら」
		PRINTFORML
	CASEELSE
		PRINTFORML 「%CSTR:ARG:一人称%と話がしたいの？」
		PRINTFORMW 「ふぅん……まぁ一応付き合ってあげるわ」
ENDSELECT

SELECTCASE RAND:6
	CASE 0
		PRINTFORMW 「質問していいかしら……人間が何をしにこんな所へ来たの？」
		PRINTFORML
		PRINTFORML [1]悪魔退治　　　　　[2]散歩
		PRINTFORML [3]仲魔を探しに来た　[4]奴隷を探しに来た
		$INPUT_LOOP0
		INPUT
		PRINTFORML
		IF RESULT == 1
			;悪魔退治
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
			SIF TALENT:ARG:臆病
				LOCAL += RAND:15
			SIF TALENT:ARG:大人しい
				LOCAL += RAND:15
			SIF TALENT:ARG:獰猛
				LOCAL += RAND:15
			SIF TALENT:ARG:反抗的
				LOCAL -= RAND:20
			SIF TALENT:ARG:プライド高い
				LOCAL -= RAND:30
			SIF TALENT:ARG:高慢
				LOCAL -= RAND:30
				
			IF LOCAL < 30
				CFLAG:ARG:友好度 -= RAND:50
				;失敗
				IF TALENT:ARG:プライド高い
					PRINTFORML 「たかがニンゲン風情が！！」
					PRINTFORMW 「悪魔に喧嘩売ってタダで済むと思わないことね！」
					RETURN 3
				ELSE
					PRINTFORMW 「%CSTR:ARG:11%、こう見えても悪魔なのよ？」
					PRINTFORMW 「悪魔に向かって悪魔退治に来ただなんて」
					PRINTFORMW 「死んでくださる？」
					RETURN 6
				ENDIF
			ELSE
				CFLAG:ARG:友好度 += RAND:30
				;成功
				IF TALENT:ARG:プライド高い
					CFLAG:ARG:友好度 += RAND:10
					PRINTFORML 「大した度胸ね、悪魔の%CSTR:ARG:11%に向かってそんな事を言うなんて」
					PRINTFORMW 「けれど、無謀と勇気を履き違えてはいけないわよ」
					RETURN 0
				ELSE
					PRINTFORMW 「アハハ、悪魔に向かって悪魔退治ですって」
					PRINTFORMW 「面白い冗談ね、気に入ったわ」
					RETURN 0
				ENDIF
			ENDIF
		ELSEIF RESULT == 2
			;散歩
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
			SIF TALENT:ARG:臆病
				LOCAL += RAND:15
			SIF TALENT:ARG:大人しい
				LOCAL += RAND:15
			SIF TALENT:ARG:友愛
				LOCAL += RAND:30
			SIF TALENT:ARG:獰猛
				LOCAL -= RAND:10
			SIF TALENT:ARG:狡猾
				LOCAL -= RAND:20
			SIF TALENT:ARG:残虐
				LOCAL -= RAND:30
			IF LOCAL < 30
				CFLAG:ARG:友好度 -= RAND:50
				;失敗
				IF TALENT:ARG:獰猛
					PRINTFORML 「こんな所で散歩？」
					PRINTFORMW 「悪魔なんて怖くないってわけ？　舐められたモノね」
					RETURN 3
				ELSEIF TALENT:ARG:友愛
					PRINTFORML 「散歩感覚で悪魔を殺しに来たというわけね」
					PRINTFORMW 「身の程を知りなさい」
					RETURN 3
				ELSEIF TALENT:ARG:残虐
					PRINTFORML 「そう……」
					PRINTFORMW 「残念ね、散歩はここでオシマイよ」
					PRINTFORMW 「貴方の命と一緒にね！！」
					RETURN 3
				ELSE
					PRINTFORML 「アハハハハ」
					PRINTFORMW 「%CSTR:ARG:11%を馬鹿にしたわね」
					RETURN 6
				ENDIF
			ELSE
				CFLAG:ARG:友好度 += RAND:30
				;成功
				IF TALENT:ARG:友愛
					CFLAG:ARG:友好度 += RAND:10
					PRINTFORML 「%CSTR:ARG:11%は別に貴方がどうなっても知らないけれどね……」
					PRINTFORMW 「ここは危険よ、人間がうろうろする場所じゃないわ」
					PRINTFORMW 「はやくお家に帰りなさい」
					RETURN 0
				ELSE
					PRINTFORMW 「こんな所に散歩だなんて、物好きな人間ね」
					PRINTFORMW 「イケナイ悪魔に食べられちゃうわよ？　気をつけなさい」
					RETURN 0
				ENDIF
			ENDIF
		ELSEIF RESULT == 3
			;仲魔
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
			
			SIF TALENT:ARG:好奇心
				LOCAL += RAND:20
			SIF TALENT:ARG:献身的
				LOCAL += RAND:20
			SIF TALENT:ARG:愚鈍
				LOCAL += RAND:10
