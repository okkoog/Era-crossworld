;=====================================================================
;口調タイプ：○○の汎用口上＋会話用ファイルです
;%CSTR:11%の名は執事とお呼びください
;=====================================================================

;=====================================================================
;戦闘時会話および合体時会話の口上テンプレートです。

;個別の悪魔に対応させたい場合はX1をキャラ番号に
;会話タイプ別に対応させたい場合はKX1をPUB(会話タイプの番号)に
;置き換えてください。

;例）ピクシーの口上を作りたいならX1⇒501に置き換え
;　　会話タイプ：女、淑女ならKX1⇒PUB304に置き換え

;知ってると便利そうな表記
;　%CSTR:ARG:X%　X = 11:一人称 12:二人称 20:種族
;　\@ CSTR:ARG:種族名 != "" ? %CSTR:ARG:種族名% # %STR:(ABL:ARG:種族)%
;　┗CSTRに種族名が記載されていればそれを、されていなければABLから種族名を割り出して表示する
;====================================================================

@KOJO_TALK_PUB318,ARG,ARG:1
SELECTCASE ARG:1
	CASE 1
		;1:レディ・キラーズ
		PRINTFORMW 「……！？」
		PRINTFORMW 「何と言う可憐な人間だ…ああ、見ているだけで%CSTR:ARG:一人称%の胸が締めつけられるようだ」
		PRINTFORMW 「人の子よ…この%CSTR:ARG:一人称%がお力になってさしあげましょう」
		
	CASE 2
		; 2:おねだり前の逡巡時(あいさつor問答で目的が決まっている場合)
		PRINTFORML 「何にしましょうかね」
	CASE 3
		; 3:交渉の目的を尋ねる
		SELECTCASE CFLAG:ARG:友好度
			CASE IS < 25
				;友好度低い
				PRINTFORMW 「それで、%CSTR:ARG:11%に何の用ですか？」
			CASE IS < 50
				;友好度普通
				PRINTFORMW 「%CSTR:ARG:11%に何の御用でしょうか？」
				PRINTFORMW 「用件をお伺いしましょう」
			CASEELSE
				;友好度高い
				PRINTFORML 「お困りですか？」
				PRINTFORMW 「%CSTR:ARG:一人称%でよければ%CSTR:ARG:二人称%の力になりましょう」
		ENDSELECT
	CASE 84
		PRINT 「そうですね…まずは」
	CASE 4
		; 4-6:交渉目的：やらせてくれと言った時の反応
		; 4:取り付く島もなし
			PRINTFORMW 激しく拒否された
	CASE 5
		; 5:交渉次第
		PRINTFORMW 条件次第でヤらせてくれるようだ
	CASE 6
		; 6:一発おｋ
		PRINTFORML 「%CSTR:ARG:11%に抱かれたいのですか？」
		PRINTFORMW 「いいでしょう｣
	CASE 7
		; 7-9:交渉目的：やらせてくれと言った時の反応
		; 7:取り付く島もなし
			PRINTFORMW 激しく拒否された
	CASE 8
		; 8:交渉次第
		PRINTFORMW 条件次第で犯してくれるようだ
	CASE 9
		; 9:一発おｋ
		CALL MESSAGE_TALK
		IF TFLAG:メッセージパターン == 1
			;スカートたくし上げ
			;ノーパン
			IF TEQUIP:PLAYER:陰唇露出 == -1
				IF STAIN:PLAYER:3 & 4
					;既に精液が…
					PRINTFORMW 「ふむ、他の者の種が残っていますね」
					SIF TALENT:PLAYER:恋慕 || TALENT:PLAYER:親愛 
						PRINTFORMW 「恋人がいるというのに・・ずいぶんと股がゆるいようですね」
					PRINTFORMW 「%CSTR:ARG:11%のモノで掻き出してしまいますか」
					PRINTFORMW 「その後で%CSTR:ARG:11%の種で満たして差し上げましょう」
					IF TALENT:ARG:天使
						PRINTFORMW 「神の意に従う善い子を孕むのですよ」
					ELSE
						PRINTFORMW 「%CSTR:ARG:11%の種で孕むことを光栄に思うのですよ」
					ENDIF
				ELSE
					PRINTFORMW 「準備は宜しいようですね。よい心がけです」
					IF TALENT:ARG:天使
						PRINTFORMW 「では、神聖なる交わりを始めましょう」
					ELSE
						PRINTFORMW 「では、二度と忘れる事のできない悦楽をその身に刻み込んで差し上げましょう」
					ENDIF
				ENDIF
			;パンツか何かはいてる
			ELSE
				IF TALENT:ARG:天使
					PRINTFORMW 「ふむ、天の御使いである%CSTR:ARG:11%を誘惑しますか」
				ELSE
					PRINTFORMW 「なかなか扇情的な光景ですね」
				ENDIF
				IF HAVE_PENIS(ARG)
					PRINTFORMW %CALLNAME:ARG%は自分の一物を曝け出すと、スカートをたくし上げたままの%CALLNAME:PLAYER%の股座に擦り付けた。
				ELSE
					PRINTFORMW %CALLNAME:ARG%はスカートをたくし上げたままの%CALLNAME:PLAYER%の股座を上下するように擦り始めた。
				ENDIF
				IF TALENT:ARG:天使
					PRINTFORMW 「その罪は正しき仔を孕むことで許すとしましょう｣
				ELSE
					PRINTFORMW 「ふふ、心配せずとも%CSTR:ARG:11%以外では満足できない体にして差し上げますよ」
				ENDIF				
			ENDIF
		ELSEIF TFLAG:メッセージパターン == 2
			;Ｍ字開脚
			IF RAND:2 == 0
				IF TALENT:ARG:天使
					PRINTFORMW 「なんとも淫らな格好を・・恥ずかしくないのですか？」
					PRINTFORMW 「%CSTR:ARG:11%が正して差し上げましょう」
				ELSEIF TALENT:PLAYER:恋慕 || TALENT:PLAYER:親愛 
					PRINTFORMW 「随分と欲求不満のようですね」
					PRINTFORMW 「\@TALENT:MASTER:オトコ == 0 ? 彼女 # 彼\@では満足できないのですか？」
					PRINTFORMW 「フフフ、では%CSTR:ARG:11%から離れられない様にして差し上げますよ」
				ELSE
					PRINTFORMW 「くく、いい気分ですね」
					PRINTFORMW 「その期待に応えてしっかりと犯して差し上げましょう」
				ENDIF
					PRINTFORMW %CALLNAME:ARG%は%CALLNAME:PLAYER%に覆いかぶさった
			ELSE
				IF TALENT:ARG:天使
					PRINTFORMW 「フッ、浅ましい姿ですね」
					PRINTFORMW 「仕方ありません、%CSTR:ARG:11%が矯正して差し上げましょう」
				ELSEIF TALENT:PLAYER:恋慕 || TALENT:PLAYER:親愛 
					PRINTFORMW 「おやおや、\@TALENT:MASTER:オトコ == 0 ? 彼女 # 彼\@の前だというのに、フフフフ」
					PRINTFORMW 「そんなにコレが欲しいのですか？」
					PRINTFORMW 「宜しい、たっぷりと犯して差し上げますよ・・そして」
					PRINTFORMW 「\@TALENT:MASTER:オトコ == 0 ? 彼女 # 彼\@に%CSTR:ARG:11%に犯されてよがる様をたっぷりと見せて差し上げなさい」
				ELSE
					PRINTFORMW 「誰の前でもそうして股を開くのですか？」
					PRINTFORMW 「くく、盛りのついた獣のようですね」
					PRINTFORMW 「これは調教の必要がありますね。じっくりと、たっぷりと」
				ENDIF
					PRINTFORMW %CALLNAME:ARG%は%CALLNAME:PLAYER%に覆いかぶさった
			ENDIF
		ELSEIF TFLAG:メッセージパターン == 2
			;おっぱい
			;男の人ってみんなおっぱい好きなんですよね？
			IF RAND:2 == 0
				IF TALENT:ARG:天使
					PRINTFORMW 「ふふ、眼福ですね」
