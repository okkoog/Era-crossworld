						RETURN 0
					ELSE
						PRINTFORML 「なるほど」
						PRINTFORMW 「それが一番いいかもしれませんね」」
						RETURN 0
					ENDIF
				ENDIF
			ELSEIF RESULT == 2
				;2.嫉妬/衣装
				LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
