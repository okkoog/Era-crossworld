						PRINTFORML 「おやおや」
						PRINTFORML 「身体が硬くなっていますよ」
						PRINTFORMW 「それほど恐れなくてもとって食ったりはしません」
						RETURN 0
					ENDIF
				ENDIF
			ELSE
				GOTO INPUT_LOOP_A0
			ENDIF
		;それ以外
		ELSE
;0.会話継続 1.直接仲魔になる 2.何かくれる 3.奇襲される 4.敵対する 5.逃げる 6.気まずくなる
			IF TALENT:ARG:天使
				PRINTFORML 「人間の中では調教師という人や悪魔を売買する愚かな者がいると聞きました」
				PRINTFORMW 「人の子よ、そういう人間をどう思いますか？」
				PRINTFORML
				PRINTFORML [1]恥ずかしいと思う　[2]誇りに思う
				IF TALENT:PLAYER:140 == 1 || TALENT:PLAYER:157 == 0
					PRINTFORML [3]どうでもいい
				ELSE
					PRINTFORML [3]泣き出す　　　　　
				ENDIF
			ELSE
				PRINTFORMW 「人間の間では調教が流行っていると聞きましたが？」
				PRINTFORML
				PRINTFORML [1]流行っている　　　[2]知らない
				PRINTFORML [3]調教してください　
			ENDIF
			$INPUT_LOOP_B0
			INPUT
			PRINTFORML
			IF RESULT == 1
				;１．流行っている/恥ずかしい
				LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
				SIF TALENT:ARG:臆病
					LOCAL -= RAND:15
				SIF TALENT:ARG:大人しい
					LOCAL -= RAND:15
				SIF TALENT:ARG:残虐
					LOCAL += RAND:15
				IF TALENT:ARG:反抗的
					IF TALENT:ARG:天使
						LOCAL += RAND:50
					ELSE
						LOCAL -= RAND:30
					ENDIF
				ENDIF
				SIF TALENT:ARG:天使
						LOCAL += RAND:50
				IF LOCAL < 50
					CFLAG:ARG:友好度 -= RAND:50
					;失敗
					IF TALENT:ARG:天使
						CFLAG:ARG:友好度 += RAND:50
						PRINTFORML 「恥じる気持ちがあるのならば…｣
						PRINTFORML 「まずは自分の行いから見直しなさい」
						PRINTFORMW 「神は何時でも見ているのですよ」
						RETURN 5
					ELSEIF TALENT:ARG:残虐
						PRINTFORML 「奇遇ですね」
						PRINTFORMW 「%CSTR:ARG:11%も人間の調教が趣味なのです」
						RETURN 3
					ELSE
						PRINTFORML 「知っていますよ、流行っていない事ぐらい」
						PRINTFORMW 「%CSTR:ARG:11%を騙そうという腹つもりが気に入りません」
						RETURN 6
					ENDIF
				ELSE
					CFLAG:ARG:友好度 += RAND:30
					;成功
					IF TALENT:ARG:天使
						CFLAG:ARG:友好度 += RAND:70
						PRINTFORML 「人の子よ、貴方の罪を許しましょう」
						PRINTFORMW 「神は等しく人間を愛しているのです」
						RETURN 0
					ELSEIF TALENT:ARG:残虐
						CFLAG:ARG:友好度 += RAND:10
						PRINTFORML 「最近の人間は中々趣味がいいですね」
						PRINTFORMW 「調教はとてもいいものです」
						RETURN 0
					ELSE
						PRINTFORML 「ほぅ…」
						PRINTFORMW 「物知りですね、勉強になりました」
						RETURN 0
					ENDIF
				ENDIF
			ELSEIF RESULT == 2
				;２．知らない/誇り
				LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
				SIF TALENT:ARG:臆病
					LOCAL += RAND:15
				SIF TALENT:ARG:大人しい
					LOCAL += RAND:15
				SIF TALENT:ARG:友愛
					LOCAL += RAND:30
				SIF TALENT:ARG:獰猛
					LOCAL -= RAND:10
				SIF TALENT:ARG:狡猾
					LOCAL -= RAND:20
				SIF TALENT:ARG:残虐
					LOCAL -= RAND:30
				SIF TALENT:ARG:天使
					LOCAL -= RAND:100
				IF LOCAL < 80
					CFLAG:ARG:友好度 -= RAND:50
					;失敗
					IF TALENT:ARG:天使
						PRINTFORML 「愚かな…」
						PRINTFORMW 「この場で%CSTR:ARG:11%が貴方の誇りを砕いてさしあげましょう」
						RETURN 3
					ELSEIF TALENT:ARG:残虐 || TALENT:ARG:獰猛
						PRINTFORML 「知らないなら教えてあげましょう」
						PRINTFORMW 「%CSTR:ARG:12%自身の身体でね」
						RETURN 3
					ELSE
						PRINTFORML 「本当に知らないのですか？」
						PRINTFORML 「貴方のその目は嘘をついている」
						PRINTFORMW 「悪魔ですからそのぐらいは解りますよ」
						RETURN 6
					ENDIF
				ELSE
					IF TALENT:ARG:天使
						PRINTFORML 「悔い改めなさい」
						PRINTFORMW 「貴方には少し考える時間が必要のようです」
						RETURN 6
					ELSE
						CFLAG:ARG:友好度 += RAND:10
						PRINTFORMW 「知らないのですか…」
						PRINTFORMW 「それならばその方が幸せかもしれませんね」
						RETURN 0
					ENDIF
				ENDIF
			ELSEIF RESULT == 3
				;３．調教してください/どうでもいい/泣き出す
				LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
				SIF TALENT:ARG:好奇心
					LOCAL += RAND:20
				SIF TALENT:ARG:愚鈍
					LOCAL += RAND:10
				SIF TALENT:ARG:プライド高い
					LOCAL += RAND:20
				SIF TALENT:ARG:反抗的
					LOCAL -= RAND:30
				IF TALENT:ARG:天使
					IF TALENT:PLAYER:140 == 1 || TALENT:PLAYER:157 == 0
						LOCAL -= 100
					ELSE
						LOCAL += 30
					ENDIF
				ENDIF
				IF LOCAL < 30
					CFLAG:ARG:友好度 -= RAND:50
					;失敗
					IF TALENT:ARG:天使
						PRINTFORML 「罪から目を反らし生きていくというのですか」
						PRINTFORMW 「目を覚ましなさい」
					ELSE
						PRINTFORML 「面白い申し出ですが」
						PRINTFORMW 「何処まで本気ですか？」
					ENDIF
					RETURN 6
				ELSE
					CFLAG:ARG:友好度 += RAND:30
					IF TALENT:ARG:天使
						IF TALENT:PLAYER:140 == 1 || TALENT:PLAYER:157 == 0
							PRINTFORML 「無関心は罪ですよ」
							PRINTFORMW 「人の子よ、考え直しなさい」
							RETURN 6
						ELSE
							CFLAG:ARG:友好度 += RAND:50
							PRINTFORML 「泣き止むのです、人の子よ」
							PRINTFORMW 「神は貴方を責めているのではありませんよ」
							RETURN 0
						ENDIF
					ELSE
						IF TALENT:PLAYER:140 == 1 || TALENT:PLAYER:157 == 0
							PRINTFORML 「%CSTR:ARG:11%の下僕になりたいのですか？」
							PRINTFORMW 「ふむ…考えてみましょう」
							RETURN 0
						ELSE
							CFLAG:ARG:友好度 += RAND:50
							PRINTFORML 「ほぅ…」
							PRINTFORML 「%CSTR:ARG:11%の下僕になるのを望むのですか」
							PRINTFORMW 「悪い話ではありませんね」
							RETURN 0
						ENDIF
					ENDIF
				ENDIF
			ELSE
				GOTO INPUT_LOOP_B0
			ENDIF
		ENDIF
ENDSELECT

