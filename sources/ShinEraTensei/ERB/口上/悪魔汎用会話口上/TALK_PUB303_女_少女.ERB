				CFLAG:ARG:友好度 += RAND:30
				;成功
					PRINTFORMW 「そういうのって、人間の言葉でロリコンって言うんだよね？」
					PRINTFORMW 「実物にあったのは初めてだよ♪」
					RETURN 0
			ENDIF
		ELSEIF RESULT == 4
			;どちらとも言えない
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2) - RAND:20

			
			IF LOCAL < 30
				CFLAG:ARG:友好度 -= RAND:50
				;失敗
					PRINTFORML 「も～！　子供だと思ってテキトー言ってるでしょ！」
					PRINTFORMW 「バカー！」
					RETURN 3
			ELSE
				CFLAG:ARG:友好度 += RAND:30
				;成功
					PRINTFORMW 「得することもあるの？」
					PRINTFORMW 「へ～それは知らなかったなぁ」
					RETURN 0
			ENDIF
		ELSE
			GOTO INPUT_LOOP0
		ENDIF
