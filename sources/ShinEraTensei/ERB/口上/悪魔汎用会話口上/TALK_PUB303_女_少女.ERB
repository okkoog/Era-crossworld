@GREET_PUB303,ARG
SELECTCASE CFLAG:ARG:友好度
	CASE IS > 25
		PRINTFORML 「え……%CSTR:ARG:11%と話がしたいの？」
		PRINTFORMW 「きゃーどうしよう！？　すっごく嬉しい♪」
	CASE IS > -25
		IF TALENT:ARG:臆病
			PRINTFORML 「うわ、人間から話しかけられちゃった！　ど、どうしよう……」
			PRINTFORML 「えっと、ちょっとだけならいいかな……とか」
		ELSE
			PRINTFORML 「え……%CSTR:ARG:11%と話がしたいの？」
			PRINTFORMW 「うん、いいよ♪」
		ENDIF
	CASEELSE
		PRINTFORML 「%CSTR:ARG:一人称%と話がしたいの？」
		PRINTFORMW 「……変なことしないならいいよ」
ENDSELECT
PRINTFORML

;質問を増やした場合、RAND:XのXを増やす
;RETURNの値により回答後の雰囲気が変わる。
;0.会話継続 1.直接仲魔になる 2.何かくれる 3.奇襲される 4.敵対する 5.逃げる 6.気まずくなる

SELECTCASE RAND:3
	CASE 0
		PRINTFORMW 「ねえねえ、教えて教えて～♪」
		PRINTFORMW 「しゃべりが子供っぽい悪魔って、損してる？」
		PRINTFORML
		PRINTFORML [1]損してる　　　　　　　[2]そんなことはない
		PRINTFORML [3]子供っぽい方が好みだ　[4]どちらとも言えない
		$INPUT_LOOP0
