			PRINTFORML
			PRINTFORML [1]冒険　[2]迷子
			PRINTFORML [3]仕事　[4]君、可愛いね
		ENDIF
		$INPUT_LOOP3
		INPUT
		PRINTFORML
		IF RESULT == 1
			;恥ずかしい
			IF EQUIP:PLAYER:13 == 3501
				LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
