		PRINTFORML
		IF RESULT == 1
			;損してる
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
			IF LOCAL < 30
				CFLAG:ARG:友好度 -= RAND:50
				;失敗
					PRINTFORMW 「ウソツキ！」
					PRINTFORMW 「心にもない事言って！」
					RETURN 6
			ELSE
				CFLAG:ARG:友好度 += RAND:30
				;成功
					PRINTFORMW 「やっぱり、そうよね！」
					PRINTFORMW 「わあっ、初めて同じ意見の子に会えた～。」
					RETURN 0
			ENDIF
		ELSEIF RESULT == 2
			;そんな事はない
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
			IF LOCAL < 30
				CFLAG:ARG:友好度 -= RAND:50
				;失敗
					PRINTFORMW 「ウソだ！」
					PRINTFORMW 「心にもない事言って！」
					RETURN 4
			ELSE
				CFLAG:ARG:友好度 += RAND:30
				;成功
					PRINTFORMW 「そーなんだー」
					PRINTFORMW 「私が考えすぎてるだけなのかなぁ？」
					RETURN 0
			ENDIF
		ELSEIF RESULT == 3
			;子供っぽいほうが好みだ
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
