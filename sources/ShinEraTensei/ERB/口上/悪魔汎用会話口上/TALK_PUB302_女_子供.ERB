@GREET_PUB302,ARG
SELECTCASE CFLAG:ARG:友好度
	CASE IS > 25
		PRINTFORML 「え……おはなし？」
		PRINTFORMW 「いいですよぉ。%CSTR:ARG:一人称%もお話ししたいと思っていたところですぅ」
	CASE IS > -25
		PRINTFORML 「え……おはなし？」
		PRINTFORMW 「いいよ。せっかく会えたんだから聞いてあげるですぅ」
	CASEELSE
		PRINTFORML 「え……おはなし？　それってめんどうですぅ」
		PRINTFORMW 「……まぁどうしてもっていうなら聞いてあげないこともないですよぉ」
ENDSELECT
PRINTFORML

;質問を増やした場合、RAND:XのXを増やす
;RETURNの値により回答後の雰囲気が変わる。
;0.会話継続 1.直接仲魔になる 2.何かくれる 3.奇襲される 4.敵対する 5.逃げる 6.気まずくなる

;基本確率設定
LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
SELECTCASE RAND:2
	CASE 0
		PRINTFORMW 「それで、どんなコトが聞きたいんですかぁ？」
		PRINTFORML
		PRINTFORML [1]つき合ってる男の子は？　[2]興味のある事は？
		PRINTFORML [3]今、何時？　　　　　　　[4]好きなプレイは？
		CALL INPUTINT(1, 2, 3, 4)
		PRINTFORML 
		;つき合ってる男の子は？
		IF RESULT == 1
			;大失敗率
			LOCAL:1 = 15 + TALENT:ARG:高慢 * 100
			;失敗率
			LOCAL:2 = 15 + LOCAL:1 + TALENT:ARG:大人しい * 30 + TALENT:ARG:保守的 * 30
			;成功率
			LOCAL:3 = 60 + LOCAL:2 + TALENT:ARG:冷静 * 30 + TALENT:ARG:狡猾 * 30
			;大成功率
			LOCAL:4 = 10 + LOCAL:3 + TALENT:ARG:素直 * 30 + TALENT:ARG:好奇心 * 30
			LOCAL = LOCAL * LOCAL:4 / 100
			IF LOCAL < LOCAL:1
				CFLAG:ARG:友好度 -= RAND:50
				;大失敗
				PRINTFORMW 「なんで、そんなこと、%CSTR:ARG:二人称%に教えなきゃいけないですか！」
				IF RAND:3
					RETURN 4
				ELSE
					PRINTFORMW 「つき合ってる男の子がいないのってそんなに悪いことですか！」
					RETURN 3
				ENDIF
			ELSEIF LOCAL < LOCAL:2
				;失敗
				CFLAG:ARG:友好度 += RAND:10 - 20
				PRINTFORMW 「そ、そんなコトぉ……」
				PRINTFORMW 「こたえられないですぅ……」
				RETURN 0
			ELSEIF LOCAL < LOCAL:3
				CFLAG:ARG:友好度 += RAND:20
				;大成功
				PRINTFORMW 「それは、ひみつですぅ！」
				PRINTFORMW 「キャハハッ！」
				RETURN 0
			ELSE
				CFLAG:ARG:友好度 += RAND:50
				;大成功
				PRINTFORMW 「つき合ってはいないけど、気になる子はいるですぅ」
				PRINTFORMW 「あ、誰にもいッちゃダメですよぉ！」
				RETURN 0
			ENDIF
		ELSEIF RESULT == 2
			;興味のあることは？
			;大失敗率
			LOCAL:1 = 0
			;失敗率
			LOCAL:2 = 30 + LOCAL:1 + TALENT:ARG:賢い * 50
			;成功率
			LOCAL:3 = 70 + LOCAL:2 + TALENT:ARG:友愛 * 50
			;大成功率
			LOCAL:4 = 0
			LOCAL = LOCAL * LOCAL:4 / 100
			IF LOCAL < LOCAL:2
				CFLAG:ARG:友好度 -= RAND:50
				;失敗
				PRINTFORMW 「そんなしつもん、つまらないですぅ！」
				PRINTFORMW 「きたいはずれですぅ！」
				RETURN 6
			ELSE
				CFLAG:ARG:友好度 += RAND:30
				;成功
				PRINTFORMW 「%CSTR:ARG:一人称%、%CSTR:ARG:二人称%にきょうみしんしんですぅ！」
				RETURN 0
			ENDIF
		ELSEIF RESULT == 3
			;今、何時？
			;大失敗率
			LOCAL:1 = 30 + TALENT:ARG:高慢 * 50 
			;失敗率
			LOCAL:2 = 30 + LOCAL:1
			;成功率
			LOCAL:3 = 20 + LOCAL:2 + TALENT:ARG:賢い * 50
			;大成功率
			LOCAL:4 = 20 + TALENT:ARG:友愛 * 50
			LOCAL = LOCAL * LOCAL:4 / 100
			;大失敗
			IF LOCAL < LOCAL:1
				CFLAG:ARG:友好度 -= RAND:50
				PRINTFORMW 「%CSTR:ARG:二人称%、ひどいですぅ！」
				;1/3で敵対コース
				IF RAND:3
					RETURN 6
				ELSE
					PRINTFORMW 「%CSTR:ARG:一人称%、もうプンプンなんですぅ！」
					RETURN 4
				ENDIF
			;失敗
			ELSEIF LOCAL < LOCAL:2
				CFLAG:ARG:友好度 -= RAND:10
				PRINTFORMW 「そ、そんなぁ……」
				PRINTFORMW 「ひょっとして、%CSTR:ARG:一人称%にきょうみないんですかぁ？」
				RETURN 0
			;成功
			ELSEIF LOCAL < LOCAL:3
				CFLAG:ARG:友好度 += RAND:30
				PRINTFORMW 「%CSTR:ARG:二人称%、大人なのに時計も持ってないんですかぁ？」
				PRINTFORMW 「ふふ、それってとっても、恥ずかしいですぅ」
				RETURN 0
			;成功
			ELSE
				CFLAG:ARG:友好度 += RAND:10
				PRINTFORMW 「えーと、ごめんなさいですぅ」
				PRINTFORMW 「%CSTR:ARG:一人称%、時計もってないんですぅ」
				RETURN 0
			ENDIF
		ELSE
			;好きなプレイは？
			;失敗率
			LOCAL:1 = 30 + TALENT:ARG:愚鈍 * 50
			SIF TALENT:ARG:賢い
