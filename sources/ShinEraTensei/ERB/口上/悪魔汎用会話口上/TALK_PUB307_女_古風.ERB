;===========================================================================
;会話時挨拶
;===========================================================================
@GREET_PUB307,ARG
;最初の挨拶
PRINTFORML
SELECTCASE CFLAG:ARG:友好度
	CASE IS > 25
		PRINTFORMW 「%CSTR:ARG:一人称%に話とな？」
		PRINTFORML 「ふむ、嬉しいことを言ってくれるのぅ」
	CASE IS > -25
		PRINTFORMW 「%CSTR:ARG:一人称%に話とな？」
		PRINTFORML 「どれ、退屈しのぎに聞かせてもらおうかのぅ」
	CASEELSE
		PRINTFORMW 「%CSTR:ARG:一人称%に話とな？」
		PRINTFORML 「あんまり期待できないがまぁ退屈しのぎくらいにはなるかのぅ」
ENDSELECT
PRINTFORML

;質問を増やした場合、RAND:XのXを増やす
;RETURNの値により回答後の雰囲気が変わる。
;0.会話継続 1.直接仲魔になる 2.何かくれる 3.奇襲される 4.敵対する 5.逃げる 6.気まずくなる
SELECTCASE RAND:5
	CASE 0
		PRINTFORMW 「そうじゃのぅ……まず、汝は何者かえ？」
		PRINTFORML
		PRINTFORML [1]悪魔召喚師　[2]デビルバスター
		PRINTFORML [3]調教師　　　[4]名乗る
		$INPUT_LOOP0
		INPUT
		PRINTFORML
		IF RESULT == 1
			;１．
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
;			素質によって判定値がランダムに上下することもある
;			SIF TALENT:ARG:反抗的
;				LOCAL -= RAND:20
			IF LOCAL < 30
				CFLAG:ARG:友好度 -= RAND:50
				;失敗
					PRINTFORML 「その妙な機械で我が同族を意のままに操っておる者のことじゃな」
					PRINTFORMW 「ならば汝を殺し、仲魔を返してくれようぞ！」
					RETURN 3
			ELSE
				CFLAG:ARG:友好度 += RAND:30
				;成功
					PRINTFORMW 「ほう、%CSTR:ARG:一人称%を求めてこの地に参ったというのかぇ？」
					PRINTFORMW 「ならば汝に力を貸してやるのも一興じゃな」
					RETURN 0
			ENDIF
		ELSEIF RESULT == 2
			;２．
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
			SIF TALENT:ARG:プライド高い
				LOCAL -= RAND:20
			SIF TALENT:ARG:高慢
