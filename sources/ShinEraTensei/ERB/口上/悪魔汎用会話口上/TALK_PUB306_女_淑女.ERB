@GREET_PUB306,ARG
SELECTCASE CFLAG:ARG:友好度
	CASE IS > 25
		PRINTFORML 「あら、こんな素敵な人に声をかけられるなんて」
		PRINTFORMW 「今日はいい日ですわね」
	CASE IS > -25
		PRINTFORML
		PRINTFORML 「あら、人間に声をかけられるなんて」
		PRINTFORMW 「珍しい事もあるものですわね」
		PRINTFORML
	CASEELSE
		PRINTFORML 「%CSTR:ARG:一人称%に声をかけてくるなんて」
		PRINTFORMW 「その勇気に免じてとりあえず話を聞いてあげますわ」
ENDSELECT

SELECTCASE RAND:4
	CASE 0
		PRINTFORMW 「ねえ、いったい何の用ですの？」
		PRINTFORML
		PRINTFORML [1]お茶でもどう？　[2]カラオケに行こう
		PRINTFORML [3]何か欲しいな　　[4]黙ってついてこい
		$INPUT_LOOP0
		INPUT
		PRINTFORML
		IF RESULT == 1
			;お茶でもどう？
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
			SIF TALENT:ARG:臆病
				CFLAG:ARG:友好度 += RAND:15
			SIF TALENT:ARG:大人しい
				CFLAG:ARG:友好度 += RAND:15
			SIF TALENT:ARG:獰猛
				CFLAG:ARG:友好度 += RAND:10
			SIF TALENT:ARG:反抗的
				CFLAG:ARG:友好度 += RAND:5
			SIF TALENT:ARG:プライド高い
				CFLAG:ARG:友好度 += RAND:10
			SIF TALENT:ARG:高慢
				CFLAG:ARG:友好度 += RAND:10
				
			IF LOCAL < 30
				CFLAG:ARG:友好度 -= RAND:50
				;失敗
				IF TALENT:ARG:プライド高い
					PRINTFORML 「あら、あなた、ご自分の身分を弁えてらっしゃらないの？」
					PRINTFORMW 「鏡を見て、出直してらして」
					RETURN 6
				ELSE
					PRINTFORMW 「申し訳ありませんけど、ご遠慮いたしますわ」
					RETURN 6
				ENDIF
			ELSE
				CFLAG:ARG:友好度 += RAND:30
				;成功
				IF RAND:2 == 0 && TALENT:ARG:プライド高い
					CFLAG:ARG:友好度 += RAND:10
					PRINTFORML 「それもいいかもしれませんわね」
					PRINTFORMW 「ふふ、考えておきますわ」
					RETURN 0
				ELSE
					PRINTFORML 「お誘いくださる気持ちはとても嬉しいのですが」
					PRINTFORMW 「もう少しだけ考えてもよろしいかしら？」
					RETURN 0
				ENDIF
			ENDIF
		ELSEIF RESULT == 2
			;カラオケに行こう
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
			SIF TALENT:ARG:素直
				CFLAG:ARG:友好度 += RAND:10
			SIF TALENT:ARG:楽観的
				CFLAG:ARG:友好度 += RAND:10
			SIF TALENT:ARG:解放
				CFLAG:ARG:友好度 += RAND:10
			SIF TALENT:ARG:獰猛
				CFLAG:ARG:友好度 -= RAND:10
			SIF TALENT:ARG:残虐
				CFLAG:ARG:友好度 -= RAND:10

			IF LOCAL < 30
				CFLAG:ARG:友好度 -= RAND:30
				;失敗
				IF RAND:3 == 0 && TALENT:ARG:獰猛
					PRINTFORML 「歌よりももっと良いものが有りますわよ」
					PRINTFORMW 「聞かせてくださいな、あなたの断末魔を」
					RETURN 3
				ELSEIF RAND:2 == 0 && TALENT:ARG:残虐
					PRINTFORML 「わざわざ足を運ばなくとも、歌ならここに在りますわよ？」
					PRINTFORMW 「腕？　それとも足？　……あなたはどこを切り取ればどう歌ってくださるの？」
