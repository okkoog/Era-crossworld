@GREET_PUB304,ARG
SELECTCASE CFLAG:ARG:友好度
	CASE IS > 25
		PRINTFORML 「え……%CSTR:ARG:11%と話がしたいの？」
		PRINTFORML 「ちょうどよかった」
		PRINTFORMW 「%CSTR:ARG:11%も話しかけてみようかと思ってたところよ」
	CASE IS > -25
		PRINTFORML 「え……%CSTR:ARG:11%と話がしたいの？」
		PRINTFORMW 「うん、構わないけど」
	CASEELSE
		PRINTFORML 「え……%CSTR:ARG:一人称%と話がしたいの？」
		PRINTFORMW 「いいけど、つまらない話だったら許さないからね」
ENDSELECT
PRINTFORML

SELECTCASE RAND:7
	CASE 0
		PRINTFORMW 「それじゃあえっと……人間がこんな所で何してるの？」
		PRINTFORML
		PRINTFORML [1]悪魔退治　　　　　[2]散歩
		PRINTFORML [3]仲魔を探しに来た　[4]奴隷を探しに来た
		$INPUT_LOOP0
		INPUT
		PRINTFORML
		IF RESULT == 1
			;悪魔退治
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
			SIF TALENT:ARG:臆病
				LOCAL += RAND:15
			SIF TALENT:ARG:大人しい
				LOCAL += RAND:15
			SIF TALENT:ARG:獰猛
				LOCAL += RAND:15
			SIF TALENT:ARG:反抗的
				LOCAL -= RAND:20
			SIF TALENT:ARG:プライド高い
				LOCAL -= RAND:30
			SIF TALENT:ARG:高慢
				LOCAL -= RAND:30
				
			IF LOCAL < 30
				CFLAG:ARG:友好度 -= RAND:50
				;失敗
				IF TALENT:ARG:プライド高い
					PRINTFORML 「ニンゲンの癖に生意気ね！」
					PRINTFORMW 「悪魔に喧嘩売ってタダで済むと思わないでよ！」
					RETURN 3
				ELSE
					PRINTFORMW 「悪魔に向かって悪魔退治だの言うなんて」
					PRINTFORMW 「絵に描いたようなバカね！」
					RETURN 6
				ENDIF
			ELSE
				CFLAG:ARG:友好度 += RAND:30
				;成功
				IF TALENT:ARG:プライド高い
					CFLAG:ARG:友好度 += RAND:10
					PRINTFORML 「悪魔の%CSTR:ARG:11%に向かってそんな事言うなんて、勇気あるじゃん」
					PRINTFORMW 「ま、せいぜい頑張ってみれば？」
					RETURN 0
				ELSE
					PRINTFORMW 「悪魔に向かって悪魔退治だの言うなんて」
					PRINTFORMW 「アンタ、意外と大物？」
					RETURN 0
				ENDIF
			ENDIF
		ELSEIF RESULT == 2
			;散歩
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:知恵+MAXBASE:PLAYER:運/2)
			SIF TALENT:ARG:臆病
				LOCAL += RAND:15
			SIF TALENT:ARG:大人しい
				LOCAL += RAND:15
			SIF TALENT:ARG:友愛
				LOCAL += RAND:30
			SIF TALENT:ARG:獰猛
				LOCAL -= RAND:10
			SIF TALENT:ARG:狡猾
				LOCAL -= RAND:20
			SIF TALENT:ARG:残虐
				LOCAL -= RAND:30
			IF LOCAL < 30
				CFLAG:ARG:友好度 -= RAND:50
				;失敗
				IF TALENT:ARG:獰猛
					PRINTFORML 「こんなところで散歩する人間がいるわけないでしょ？」
					PRINTFORMW 「悪魔ナメんのも大概にしなよ！」
					RETURN 3
				ELSEIF TALENT:ARG:友愛
					PRINTFORML 「散歩感覚で悪魔を殺しに来たってワケ？」
					PRINTFORMW 「ふざけないでよっ！」
					RETURN 3
				ELSEIF TALENT:ARG:残虐
					PRINTFORML 「それじゃあ、お気の毒様」
					PRINTFORMW 「悪魔の住処に足を踏み入れて、まさか無事で済むなんて思ってないよね？」
					PRINTFORMW 「そ、散歩はここでオシマイ。アンタの命と一緒にね」
					RETURN 3
				ELSE
					PRINTFORML 「こんなところで散歩する人間がいるわけないでしょ？」
					PRINTFORMW 「悪魔ナメんのも大概にしなよ」
					RETURN 6
				ENDIF
			ELSE
				CFLAG:ARG:友好度 += RAND:30
