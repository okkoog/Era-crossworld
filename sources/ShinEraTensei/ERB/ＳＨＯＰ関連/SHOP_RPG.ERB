	SIF LOCAL:1 % 2 == 1
		PRINTL 
	LOCAL:1 += 1
NEXT
SIF LOCAL:1 % 2 == 1
	PRINTL 
;PRINTL
DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 13% # [7]前のページ\@
PRINTLC [0]戻る
PRINTFORMLC \@(P >= (ARG-1) / 20) ? %" " * 13% # [9]次のページ\@

