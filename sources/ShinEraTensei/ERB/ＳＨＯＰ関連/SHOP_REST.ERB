@SHOPCOMABLE_105
IF FLAG:休憩確認フラグ == 2
	RESULTS = 朝まで休憩
ELSE
	RESULTS = 休憩
ENDIF
RETURN 1

@SHOP_COM_105
IF !FLAG:休憩確認フラグ
	PRINTL 休憩しますか? 

	PRINT [0] 休憩する
	PRINT [1] 朝まで休憩する
	SIF TIME < 2
		PRINT [2] 夜まで休憩する
	PRINTL [3] 休憩しない

	CALL INPUTINT(0, 1, 2 * (TIME < 2), 3)
	;CALL INPUT_YN,"Yes","No",2

	SELECTCASE RESULT
		CASE 0
			PRINTW 休憩しました
			;休憩フラグを立てる（ここは特別）
			FLAG:0 = 2
			BEGIN TURNEND
			RETURN 1
		CASE 1
			PRINTW 朝まで休憩します
			FLAG:0 = 3
			BEGIN TURNEND
			RETURN 1
		CASE 2
			PRINTW 夜まで休憩します
			TIME = 2
			FLAG:0 = 2
			BEGIN TURNEND
			RETURN 1
		CASE 3
			RETURN 0
	ENDSELECT
ELSE
	PRINTL 休憩しました
	;休憩フラグを立てる（ここは特別）
	IF FLAG:休憩確認フラグ == 2
		;朝まで休憩
		FLAG:0 = 3
	ELSE
		FLAG:0 = 2
	ENDIF
	BEGIN TURNEND
	RETURN 1
ENDIF
