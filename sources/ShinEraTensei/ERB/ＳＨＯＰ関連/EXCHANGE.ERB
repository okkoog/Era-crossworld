@SHOPCOMABLE_114
;---- EDIT 002 ADD START -------------------------
;初回訪問フラグ:初期化
;M:1 = 0
;---- EDIT 002 ADD END ---------------------------
RESULTS = 魔貨交換
;SIF MONEY:1 == 0
;	RETURN 0
RETURN 1

@SHOP_COM_114
DRAWLINE
PRINTFORML 現在{MONEY:1}魔貨あります。どうしますか？
DRAWLINE

;---- EDIT 002 ADD START -------------------------
;画面モード:初回訪問時
;CALL RPG_SHOP_SCREENMODE_DEFAULT

;画面モード:表示
CALL RPG_SHOP_SCREENMODE_PRINT
PRINTL ("アイテムと交換"画面に適用されます)
PRINTL 
;---- EDIT 002 ADD END ---------------------------

PRINTL [1] ￥と交換
PRINTL [2] アイテムと交換
PRINTL [3] インストールソフトと交換
PRINTFORML [4] ＣＯＭＰの容量を拡張 (必要魔貨：{POWER(FLAG:ＣＯＭＰ容量 - 7,2)*100})
PRINTL [5] 衣装と交換
PRINTL [6] ドリー・カドモンと交換（必要魔貨：500）
;PRINTL [7] 後生の土鈴と交換（必要魔貨：1000）
DRAWLINE
PRINTL [0] 戻る

$INPUT_LOOP
INPUT

;---- EDIT 002 ADD START -------------------------
;初回訪問フラグ:訪問済み
;M:1 = 1
;---- EDIT 002 ADD END ---------------------------

IF RESULT == 0
	RETURN 0
;---- EDIT 002 ADD START -------------------------
ELSEIF RESULT == 800
	;画面モード:変更
	CALL RPG_SHOP_SCREENMODE_CHANGE
	RESTART
;---- EDIT 002 ADD END ---------------------------
ELSEIF RESULT == 1
	CALL EXCHANGE_MONEY
	RESTART
ELSEIF RESULT == 2
;---- EDIT 002 MOD START -------------------------
;	CALL EXCHANGE_ITEM

	IF FLAG:ショップ画面モード設定 == 0
		CALL EXCHANGE_ITEM
	ELSE
		;アイテム購入:通常 (1:魔貨交換)
		CALL RPG_SHOP_NOMAL,FLAG:ショップ画面モード設定,1
	ENDIF
;---- EDIT 002 MOD END ---------------------------
	RESTART
ELSEIF RESULT == 3
	CALL EXCHANGE_SOFT
	RESTART
ELSEIF RESULT == 4
	IF POWER(FLAG:ＣＯＭＰ容量 - 7,2)*100 > MONEY:1
		REUSELASTLINE 魔貨が足りません
		GOTO INPUT_LOOP
	ENDIF
	MONEY:1 -= POWER(FLAG:ＣＯＭＰ容量 - 7,2)*100
	FLAG:ＣＯＭＰ容量 += 1
	PRINTFORMW お使いのＣＯＭＰの容量が{FLAG:ＣＯＭＰ容量}になりました。
	RESTART
ELSEIF RESULT == 5
	CALL EXCHANGE_CLOTHES
	RESTART
ELSEIF RESULT == 6
	IF MONEY:1 < 500
		PRINTW 魔貨が足りません
		CLEARLINE 1
		GOTO INPUT_LOOP
	ENDIF
	MONEY:1 -= 500
	ITEM:ドリー・カドモン += 1
	PRINTFORMW 造魔の雛形、『ドリー・カドモン』を手に入れた
;ELSEIF RESULT == 7
;	IF MONEY:1 < 1000
;		PRINTW 魔貨が足りません
;		CLEARLINE 1
;		GOTO INPUT_LOOP
;	ENDIF
;	MONEY:1 -= 1000
;	ITEM:後生の土鈴 += 1
;	PRINTFORMW 『後生の土鈴』を手に入れた
ELSE
	GOTO INPUT_LOOP
ENDIF
RESTART

@EXCHANGE_MONEY
PRINTL 何魔貨を￥と交換しますか？(1魔貨＝￥50)
CALL INPUT_MANY(0,MONEY:1)
IF RESULT == 0
	RETURN 0
ELSE
	PRINTFORMW {RESULT}魔貨を￥{RESULT*50}と交換した。
	MONEY += RESULT*50
	MONEY:1 -= RESULT
ENDIF

@EXCHANGE_SOFT

DRAWLINE
PRINTFORML 現在{MONEY:1}魔貨あります。
DRAWLINE
LOCAL:1 = 0

FOR LOCAL,500,600
	SIF !SOFT_SELLABLE(LOCAL)
		CONTINUE
	IF ITEMPRICE:LOCAL > 0 && ITEM:LOCAL == 0
		PRINTFORM [{LOCAL}] %ITEMNAME:LOCAL,20,LEFT% {ITEMPRICE:LOCAL,7}魔貨　　
		ITEMSALES:LOCAL = 1
		LOCAL:1 += 1
	ELSE
		ITEMSALES:LOCAL = 0
	ENDIF
	IF LOCAL:1 == 2
		PRINTL
		LOCAL:1 = 0
	ENDIF
NEXT
PRINTL
DRAWLINE
PRINTL [100] 戻る
$INPUT_LOOP
INPUT

IF RESULT == 100
	RETURN 0
ELSEIF RESULT > -1 && RESULT < VARSIZE("ITEMSALES") && ITEMSALES:RESULT == 1 
	LOCAL = RESULT
	DRAWLINE
	PRINTFORML %ITEMNAME:LOCAL%
	TRYCALLFORM SOFT_EXPLAIN_{LOCAL}
	DRAWLINE
	IF ITEMPRICE:LOCAL > MONEY:1
		PRINTW 魔貨が足りません。
		RESTART
	ENDIF
	PRINTL 購入しますか? 

	CALL INPUT_YN,"Yes","No",2

	SELECTCASE RESULT
		CASE 0
			PRINTFORMW %ITEMNAME:LOCAL%を購入した
			MONEY:1 -= ITEMPRICE:LOCAL
			ITEM:LOCAL = 1
			ITEMSALES:LOCAL = 0
		CASE 1
			RESTART
	ENDSELECT

ELSE
	GOTO INPUT_LOOP
ENDIF
RESTART



@EXCHANGE_ITEM
DRAWLINE
PRINTFORML 現在{MONEY:1}魔貨あります。
PRINTL 何と交換しますか？
DRAWLINE

FOR LOCAL,0,8
	PRINTFORML [{LOCAL}] %GET_EQUIP(LOCAL)%
NEXT
PRINTL [8] アイテム
DRAWLINE
PRINTL [100] やめる


$INPUT_LOOP
INPUT

IF RESULT == 100
	RETURN 0
ELSEIF RESULT >= 0 && RESULT < 9
	LOCAL = RESULT
	CALL MAKE_EXCHANGEITEMLIST,RESULT
	LOCAL:1 = RESULT
ELSE
	GOTO INPUT_LOOP
ENDIF
P = 0
$PRINT_LIST
DRAWLINE
CALL PRINT_EXCHANGEITEMLIST,LOCAL:1
$INPUT_LOOP2
INPUT
LOCAL:2 = RESULT
IF RESULT == 0
	RESTART
ELSEIF RESULT == 7 && P > 0
	P -= 1
	GOTO PRINT_LIST
ELSEIF RESULT == 9 && P < LOCAL:1/20
	P += 1
	GOTO PRINT_LIST
ELSEIF MATCH(アイテムリスト,RESULT,0)> 0
	DRAWLINE
	IF LOCAL < 7
		CALL 装備説明,LOCAL:2
		LOCAL:3 = 999
		IF ITEM:(LOCAL:2) >= 999
			PRINTW これ以上持てません
			GOTO PRINT_LIST
		ENDIF
	ELSEIF LOCAL == 7
		CALLFORM 装備解説_{LOCAL:2}
		PRINTL
		LOCAL:3 = 999
		IF ITEM:(LOCAL:2) >= 999
			PRINTW これ以上持てません
			GOTO PRINT_LIST
		ENDIF
	ELSE
		CALLFORM 最大所持数_{LOCAL:2+2000}
		LOCAL:3 = RESULT
		PRINTFORML %ITEMNAME:(LOCAL:2),20,LEFT%   所持数：{ITEM:(LOCAL:2)}/{LOCAL:3}
		TRYCALLFORM SKILL_EXPLAIN_{LOCAL:2+2000}
		DRAWLINE
		IF ITEM:(LOCAL:2) >= LOCAL:3
			PRINTW これ以上持てません
			GOTO PRINT_LIST
		ENDIF
	ENDIF

	IF MONEY:1 < ITEMPRICE:(LOCAL:2)
		PRINTW 魔貨が足りません
		GOTO PRINT_LIST
	ELSE
		PRINTFORML いくつ購入しますか？ (現在 {ITEM:(LOCAL:2)}個所持)
		CALL INPUT_MANY(0,MIN(MONEY:1/ITEMPRICE:(LOCAL:2),LOCAL:3 - ITEM:(LOCAL:2)))
		IF RESULT == 0
			GOTO PRINT_LIST
		ELSE
			MONEY:1 -= (RESULT * ITEMPRICE:(LOCAL:2))
			IF RESULT == 1
				PRINTFORMW ＜%ITEMNAME:(LOCAL:2)%を購入しました＞
			ELSE
				PRINTFORMW ＜%ITEMNAME:(LOCAL:2)%を{RESULT}個購入しました＞
			ENDIF
			CALL GET_ITEM,LOCAL:2,RESULT
			GOTO PRINT_LIST
		ENDIF
	ENDIF
ELSE
	GOTO INPUT_LOOP2
ENDIF
GOTO PRINT_LIST





@MAKE_EXCHANGEITEMLIST,ARG
VARSET アイテムリスト,-1
LOCAL:1 = 0
IF ARG < 8
	FOR LOCAL,2000,VARSIZE("ITEM")
		SIF ITEMPRICE:LOCAL == 0
			CONTINUE
		RESULT = 12
		TRYCCALLFORM 装備箇所_{LOCAL}
			IF RESULT == ARG
				RESULT = 0
				TRYCALLFORM EQUIP_EXCHANGE_{LOCAL}
				SIF RESULT == 0
					CONTINUE
				アイテムリスト:(LOCAL:1) = LOCAL
				LOCAL:1 += 1
			ENDIF
		CATCH
		ENDCATCH
	NEXT
ELSE
	FOR LOCAL,1001,2000
		SIF ITEMPRICE:LOCAL == 0
			CONTINUE
		RESULT = 0
		TRYCALLFORM ITEM_EXCHANGE_{LOCAL+2000}
		SIF RESULT == 0
			CONTINUE
		アイテムリスト:(LOCAL:1) = LOCAL
		LOCAL:1 += 1
	NEXT
ENDIF
RETURN LOCAL:1

@PRINT_EXCHANGEITEMLIST,ARG
PRINTFORML 交換するアイテムを選んでください　＜page.{P}＞
PRINTFORML {MONEY:1}魔貨所持中
DRAWLINE
FOR LOCAL,P*20,MIN(P*20+20,ARG)
	PRINTFORM [{アイテムリスト:LOCAL}] %ITEMNAME:(アイテムリスト:LOCAL),20,LEFT% {ITEMPRICE:(アイテムリスト:LOCAL),7} 魔貨　　
	SIF LOCAL % 2 == 1
		PRINTL
NEXT
PRINTL
DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 13% # [7]前のページ\@
PRINTLC [0]戻る
PRINTFORMLC \@(P >= ARG / 20) ? %" " * 13% # [9]次のページ\@



@EXCHANGE_CLOTHES
CUSTOMDRAWLINE =
PRINTL マヌカン：
PRINTL 「ようこそ。当店にあるのは、美しい服ばかり。今なら特別に、キスマーク付きで売ってあげるわ」
DRAWLINE
PRINTL
PRINTL
DRAWLINE
REPEAT 12
	PRINTL
REND
DRAWLINE
PRINTL
TWAIT 2000,0
CLEARLINE 19
$START
PRINTL 「どう？美しい服ばかりでしょ？どれも凡人が着るにはもったりない品々よ？」
DRAWLINE
PRINTFORML 現在{MONEY:1}魔貨あります。
PRINTL 何と交換しますか？
DRAWLINE

FOR LOCAL,0,12
	PRINTFORML [{LOCAL}] %GET_CLOTHESNAME(LOCAL)%
NEXT
DRAWLINE
PRINTL [100] やめる


$INPUT_LOOP
INPUT
IF RESULT == 100
	CUSTOMDRAWLINE =
	PRINTL マヌカン：
	PRINTL 「あなたはもう少しセンスを身につけなきゃ駄目ね。今度ゆっくりとレクチャーしてあげるわ。じゃあね」
	DRAWLINE
	PRINTL
	PRINTL
	DRAWLINE
	REPEAT 12
		PRINTL
	REND
	DRAWLINE
	PRINTL
	TWAIT 2000,0
	RETURN 0
ELSEIF RESULT >= 0 && RESULT < 12
	LOCAL = RESULT
	CALL MAKE_CLOTHESLIST,RESULT
	LOCAL:1 = RESULT
ELSE
	GOTO INPUT_LOOP
ENDIF
P = 0
$PRINT_LIST
DRAWLINE
CALL PRINT_EXCHANGEITEMLIST,LOCAL:1
$INPUT_LOOP2
INPUT
LOCAL:2 = RESULT
IF RESULT == 0
	CUSTOMDRAWLINE =
	PRINTL マヌカン：
	GOTO START
ELSEIF RESULT == 7 && P > 0
	P -= 1
	GOTO PRINT_LIST
ELSEIF RESULT == 9 && P < LOCAL:1/20
	P += 1
	GOTO PRINT_LIST
ELSEIF MATCH(アイテムリスト,RESULT,0)> 0
	DRAWLINE
	IF MONEY:1 < ITEMPRICE:(LOCAL:2)
		PRINTW 魔貨が足りません
		GOTO PRINT_LIST
	ELSE
		PRINTFORMW %ITEMNAME:(LOCAL:2)%を購入しました
		MONEY:1 -= (ITEMPRICE:(LOCAL:2))
		ITEM:(LOCAL:2) += 1
		CALL MAKE_CLOTHESLIST,LOCAL
		LOCAL:1 = RESULT
		GOTO PRINT_LIST
	ENDIF
ELSE
	GOTO INPUT_LOOP2
ENDIF
GOTO PRINT_LIST


@MAKE_CLOTHESLIST,ARG
VARSET アイテムリスト,-1
LOCAL:1 = 0
	FOR LOCAL,6001,VARSIZE("ITEM")
		SIF ITEMPRICE:LOCAL == 0
			CONTINUE
		SIF ITEM:LOCAL > 0
			CONTINUE
		RESULT = 12
		TRYCCALLFORM CLOTHES_PART_{LOCAL-6000}
			IF RESULT == ARG
				アイテムリスト:(LOCAL:1) = LOCAL
				LOCAL:1 += 1
			ENDIF
		CATCH
		ENDCATCH
	NEXT
RETURN LOCAL:1