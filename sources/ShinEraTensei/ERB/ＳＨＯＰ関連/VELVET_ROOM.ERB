	PRINTFORML [{LOCAL,2}] %CSVNAME(DITEMTYPE:(LOCAL):ペルソナ("NO"),0),20,LEFT%　LV:{DITEMTYPE:LOCAL:ペルソナ("LV"),3}　EXP:{DITEMTYPE:LOCAL:ペルソナ("EXP"),4}　所持者:\@DITEMTYPE:(LOCAL):ペルソナ("ペルソナ所持者") >= 0 ? %CALLNAME:FINDCHARA_ID(DITEMTYPE:(LOCAL):ペルソナ("ペルソナ所持者"))% # %"なし",20,LEFT%\@
	Q:LOCAL = LOCAL
NEXT
LOCAL:1 = 11
FOR LOCAL, 0, CHARANUM
	SIF ABL:LOCAL:初期ペルソナ == 0
		CONTINUE
	SIF CFLAG:LOCAL:フィルタリングフラグ
