			CALLFORM SKILL_NAME_{DITEMTYPE:ARG:ペルソナ(LOCALS)},ARG
			PRINTFORML [{LOCAL}] %RESULTS%
		ENDIF
	NEXT
	DRAWLINE
	PRINTFORML [0] %LOCALS:1%を習得しない
