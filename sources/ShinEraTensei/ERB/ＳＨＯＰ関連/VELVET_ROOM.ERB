		CALLFORM SKILL_NAME_{DITEMTYPE:ARG:ペルソナ(LOCALS)}, ARG
		PRINTFORML %RESULTS%
		CALLFORM SKILL_EXPLAIN_{DITEMTYPE:ARG:ペルソナ(LOCALS)}
		DRAWLINE
		PRINTFORML 本当に%RESULTS%を忘れて、%LOCALS:1%を習得してもよろしいですか？
		CALL INPUT_YN
		SIF RESULT == 1
			GOTO CHOICE
		PRINTFORMW %CSVCALLNAME(DITEMTYPE:ARG:ペルソナ("NO"),0)%は%LOCALS:1%を習得した。
		DITEMTYPE:ARG:ペルソナ(LOCALS) = ARG:1
	ELSE
		GOTO INPUT_LOOP
	ENDIF
