	SIF DITEMTYPE:PERSONA:ペルソナ("LV") >= BASE:PMASTER:LV
		LOCAL = 0
ELSE
	LOCAL = LIMIT((200 - MAX(BASE:MASTER:LV - DITEMTYPE:PERSONA:ペルソナ("LV") - 10, 0) * 10) * MAX(100 - DITEMTYPE:PERSONA:ペルソナ("陥落") *10, 75) / 100, 50, 200)
	SIF DITEMTYPE:PERSONA:ペルソナ("LV") >= BASE:MASTER:LV
		LOCAL = 0
ENDIF
LINE:2 = LINECOUNT
