			GOTO EXPCARD
		ENDIF
		ITEM:(LOCAL) -= 1
		DITEMTYPE:PERSONA:ペルソナ("EXP") += ITEMPRICE:LOCAL
		SIF DITEMTYPE:PERSONA:ペルソナ("EXP") > 1000
