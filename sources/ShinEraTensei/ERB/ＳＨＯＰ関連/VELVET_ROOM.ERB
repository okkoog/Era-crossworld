	ELSE
		LOCAL:2 = CSVBASE(DITEMTYPE:PERSONA:ペルソナ("NO"), GETNUM(BASE, LOCALS), 0)
	ENDIF
	CALL SET_AISYOU_COLOR, LOCAL:2
	PRINTFORM %LOCALS%\@LOCAL:2 < 0 ? 吸 # 　\@
	PRINTFORM \@ LOCAL:2 != 999 ? {ABS(LOCAL:2),4}％ # %" " *2%反射 \@　
