;VARSET ダンジョンフラグ:0:0,0
;ダンジョン・イベント・依頼・闘技場フラグ初期化
FOR LOCAL, 0, 100
	FOR LOCAL:1, 0, 100
		ダンジョンフラグ:LOCAL:(LOCAL:1) = 0
		IF LOCAL:1 < 20
			イベントフラグ:LOCAL:(LOCAL:1) = 0
			闘技場フラグ:LOCAL:(LOCAL:1) = 0
