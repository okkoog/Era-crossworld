@SHOPCOMABLE_777
RESULTS = ニューゲーム
IF FLAG:5 == 9 || DAY > 50
	RETURN 1
ENDIF
RETURN 0

@SHOP_COM_777
PRINTFORML ごく一部のデータを引き継いで、新たにゲームを始めますか？
PRINTL [0]始める [1]やめておく
$INPUT_LOOP
INPUT
IF RESULT == 1
	RETURN 0
ELSEIF RESULT == 0
	CALL START_NEWGAME
	RETURN 1
ELSE
	GOTO INPUT_LOOP
ENDIF


;=================================================================
;引継ぎ処理
;=================================================================
@START_NEWGAME
;周回回数を+1
SIF FLAG:5 == 9
	FLAG:周回回数 += 1
FLAG:経験ED数 = 0
FOR LOCAL,0,64
	SIF GETBIT(FLAG:発見ED , LOCAL)
		FLAG:経験ED数 ++
NEXT
;-----------------------------------------------------------------
;引き継がないものを初期化
;主人以外のキャラを削除
;-----------------------------------------------------------------
;先に、削除しないキャラを選択することも出来る。

CALL SELECT_YOME

FOR LOCAL,CHARANUM-1,0,-1
	SIF CFLAG:LOCAL:引継ぎフラグ == 0
		CALL キャラ削除(LOCAL)
NEXT
CALL REFRESH_POS

;引き継いだキャラのレベルを１・能力をALL3に。習得スキルをＣＳＶから再読み込み。引継ぎフラグに応じて素質や能力変更
FOR LOCAL,1,CHARANUM
	SIF FLAG:5 == 9
		CFLAG:LOCAL:引継ぎ回数 += 1
	IF ABL:LOCAL:種族 == 0 || NO:LOCAL == 4509
		BASE:LOCAL:LV = CSVBASE(NO:LOCAL,GETNUM(BASE,"LV"),0)
		BASE:LOCAL:ＥＸＰ = 5*(BASE:LOCAL:LV-1)*(BASE:LOCAL:LV+1)*(BASE:LOCAL:LV)/3
		BASE:LOCAL:ＭＡＧ = 0
		CFLAG:LOCAL:初期LV = 1
		FOR LOCAL:1,1,7
			BASE:LOCAL:GET_BASESTATUS(LOCAL:1) = CSVBASE(NO:LOCAL,GETNUM(BASE,GET_BASESTATUS(LOCAL:1)),0)
			CFLAG:LOCAL:(GET_BASESTATUS(LOCAL:1) + "強化回数") = 0
		NEXT
		;このあとで処理する
		;CFLAG:LOCAL:この場に居ないフラグ = 1
		SIF CPOS(LOCAL) > 0
			CALL REMOVE_POSITION,CPOS(LOCAL)
		;敵専用スキルを削除
		FOR LOCAL:3,1,FLAG:スキル数+1
			LOCALS = スキル{LOCAL:3}
			TRYCCALLFORM 敵専用_{ABL:LOCAL:LOCALS}
				SIF RESULT == 1
					ABL:LOCAL:LOCALS = 0
			CATCH
			ENDCATCH
		NEXT
	ELSE
		BASE:LOCAL:LV = 1
		CFLAG:LOCAL:初期LV = 1
		BASE:LOCAL:ＥＸＰ = 0
		BASE:LOCAL:ＭＡＧ = 0
		FOR LOCAL:1,1,7
			BASE:LOCAL:GET_BASESTATUS(LOCAL:1) = 3
			CFLAG:LOCAL:(GET_BASESTATUS(LOCAL:1) + "強化回数") = 0
		NEXT
	ENDIF
	CFLAG:LOCAL:能力強化回数 = 0
	CFLAG:LOCAL:強化使用ＭＡＧ = 0
	
	;装備初期化
	;初期装備が強力な場合があるので、主人の初期装備と同等の物を与える
	;PRINTFORMW %NAME:LOCAL%,{LOCAL}
	CALL 全装備解除 , LOCAL
	IF ABL:LOCAL:種族 == 0 || ABL:LOCAL:種族 == 36
		FOR LOCAL:1,0,VARSIZE("EQUIP")
			EQUIP:LOCAL:(LOCAL:1) = CSVEQUIP(NO:MASTER,LOCAL:1,0)
		NEXT
	ENDIF
	;引継ぎ回数*2だけ、ランダムに能力値増加
	;FOR LOCAL:1,0,CFLAG:LOCAL:引継ぎ回数*2 + CFLAG:LOCAL:妊娠回数
	;CFLAG:LOCAL:妊娠回数 = (CFLAG:LOCAL:妊娠回数 + 1 ) / 2
	;FOR LOCAL:1,0,CFLAG:LOCAL:妊娠回数
	;	LOCAL:2 = RAND:6
		;PRINTFORMW {LOCAL:1}:%GET_BASESTATUS(LOCAL:2+1)%
	;	CFLAG:LOCAL:(GET_BASESTATUS(LOCAL:2 + 1) + "強化回数") += 1
	;NEXT
	FOR LOCAL:1,1,21
		ABL:LOCAL:("習得スキル" + TOSTR(LOCAL:1)) = CSVABL(NO:LOCAL,(GETNUM(ABL,"習得スキル" + TOSTR(LOCAL:1))),0)
		ABL:LOCAL:("習得LV" + TOSTR(LOCAL:1)) = CSVABL(NO:LOCAL,(GETNUM(ABL,"習得LV" + TOSTR(LOCAL:1))),0)
		ABL:LOCAL:("初期変身悪魔習得スキル" + TOSTR(LOCAL:1)) = CSVABL(NO:LOCAL,(GETNUM(ABL,"初期変身悪魔習得スキル" + TOSTR(LOCAL:1))),0)
		ABL:LOCAL:("初期変身悪魔習得LV" + TOSTR(LOCAL:1)) = CSVABL(NO:LOCAL,(GETNUM(ABL,"初期変身悪魔習得LV" + TOSTR(LOCAL:1))),0)
	NEXT
	;人気は引き継がない
	CFLAG:LOCAL:便器人気 = 0
	CFLAG:LOCAL:売春人気 = 0
	CFLAG:LOCAL:料理人気 = 0
	CFLAG:LOCAL:劇場人気 = 0
	CFLAG:LOCAL:アイドル人気 = 0
	
	;FOR LOCAL:1,1020,1025
	;	CFLAG:LOCAL:(LOCAL:1) = 0
	;NEXT
	FOR LOCAL:1,76,80
		EXP:LOCAL:(LOCAL:1) = 0
	NEXT
	IF CFLAG:LOCAL:引継ぎフラグ > 1
		TALENT:LOCAL:妻 = 0
		TALENT:LOCAL:夫 = 0
		TALENT:LOCAL:淫魔 = 0
		TALENT:LOCAL:玩具 = 0
		TALENT:LOCAL:恋慕 = 0
		TALENT:LOCAL:親愛 = 0
		TALENT:LOCAL:淫乱 = 0
		TALENT:LOCAL:娼婦 = 0
		TALENT:LOCAL:服従 = 0
		TALENT:LOCAL:隷属 = 0
		CFLAG:LOCAL:依存度 = 0
		TALENT:LOCAL:ＮＴＲ = 0
		TALENT:LOCAL:即落ち = 0
		CFLAG:LOCAL:ＮＴＲ夜這い = 0
		CFLAG:LOCAL:NTRフラグ = 0
		CFLAG:LOCAL:愛ＮＴＲ進行度 = 0
		CFLAG:LOCAL:淫ＮＴＲ進行度 = 0
		CFLAG:LOCAL:隷ＮＴＲ進行度 = 0
		CFLAG:LOCAL:淫乱度 = 0
		CFLAG:LOCAL:構ったフラグ = 0
		CFLAG:LOCAL:現ＮＴＲ進行度 = 0
		CFLAG:LOCAL:放置日数 = 0
		CFLAG:LOCAL:AVアイドル = 0
		CFLAG:LOCAL:訪問販売フラグ = 0

		;好感度・陥落初期化
		FOR LOCAL:1,-99,200
			CFLAG:LOCAL:(2100+LOCAL:1) = 0
			CFLAG:LOCAL:(2400+LOCAL:1) = 0
		NEXT
		CFLAG:LOCAL:陥落キャラ = 0
		CFLAG:LOCAL:第何子まで産んだか = 0
		CFLAG:LOCAL:仕送り時してくれる人数親 = 0 
		MAXBASE:LOCAL:忠誠度 = MAX(0,BASE:LOCAL:忠誠度 - 5000)
		;口上用のフラグを初期化
		FOR LOCAL:1,200,501
			CFLAG:LOCAL:(LOCAL:1) = 0
		NEXT
;		CFLAG:LOCAL:キャラ固有の番号 = FLAG:今までのキャラ数
;		FLAG:今までのキャラ数 += 1
		IF CFLAG:LOCAL:引継ぎフラグ > 2
			TALENT:LOCAL:処女 = CSVTALENT(NO:LOCAL,0,0)
			FOR LOCAL:1,0,80
				EXP:LOCAL:(LOCAL:1) = CSVEXP(NO:LOCAL,LOCAL:1,0)
				CFLAG:LOCAL:異常経験記録 = 0
			NEXT
			CFLAG:LOCAL:被調教回数 = 0
			CFLAG:LOCAL:ビデオ売却数 = 0
			CFLAG:LOCAL:ビデオ売却合計金額 = 0
			IF CFLAG:LOCAL:引継ぎフラグ == 4
				FOR LOCAL:1,0,30
					ABL:LOCAL:(LOCAL:1) = CSVABL(NO:LOCAL,LOCAL:1,0)
				NEXT
				FOR LOCAL:1,0,5
					MARK:LOCAL:(LOCAL:1) = CSVMARK(NO:LOCAL,LOCAL:1,0)
				NEXT
				FOR LOCAL:1,0,101
					JUEL:LOCAL:(LOCAL:1) = 0
				NEXT
			ENDIF
		ENDIF
	ENDIF
	CFLAG:LOCAL:リンク悪魔 = -1
	SIF CFLAG:LOCAL:悪魔変身
		CALL ACTION_2310 , LOCAL , 0
	;CFLAG:LOCAL:悪魔変身 = 0
	CFLAG:LOCAL:被リンクフラグ = -1
	CFLAG:LOCAL:被変身フラグ = 0
	IF TALENT:LOCAL:喰奴
		FOR LOCAL:1, 1, 116
			;マントラの解析度は失う
			CDFLAG:LOCAL:マントラ:(LOCAL:1) = MIN(CDFLAG:LOCAL:マントラ:(LOCAL:1), 1)
			;初期マントラ獲得
			FOR LOCAL:2, 1, 9
				SIF CSVABL(NO:LOCAL, GETNUM(ABL, @"スキル{LOCAL:2}"), 0)
					CDFLAG:LOCAL:マントラ:CSVABL(NO:LOCAL, GETNUM(ABL, @"スキル{LOCAL:2}"), 0) = 10000
			NEXT
		NEXT
		;マントラ補正リセット
		FOR LOCAL:1, 1, 7
			CFLAG:LOCAL:(GET_BASESTATUS(LOCAL:1)+"マントラ補正") = 0
		NEXT
		;現在のスキルは残り、常に自由に付け替えられる
		FOR LOCAL:1, 1, 9
			SIF ABL:LOCAL:@"初期変身悪魔スキル{LOCAL:1}" <= 0
				CONTINUE
			LOCAL:2 = 1
			;空いてる習得スキル枠に詰めてく
			WHILE LOCAL:2 < 20
				IF !ABL:LOCAL:@"初期変身悪魔習得スキル{LOCAL:2}"
					ABL:LOCAL:@"初期変身悪魔習得スキル{LOCAL:2}" = ABL:LOCAL:@"初期変身悪魔スキル{LOCAL:1}"
					ABL:LOCAL:@"初期変身悪魔習得LV{LOCAL:2}" = -1
					BREAK
				ENDIF
				LOCAL:2++
			WEND
		NEXT
	ENDIF
	CALL SYNC_STATUS,LOCAL
	CALL HEALTH_CHARA,LOCAL
	CFLAG:LOCAL:この場に居ないフラグ = 0
	CFLAG:LOCAL:引継ぎフラグ = 0
	CFLAG:LOCAL:労役フラグ = 0
	CFLAG:LOCAL:劇場出演順番 = 0
	CFLAG:LOCAL:労役店舗 = 0
	C = LOCAL
	CALL CLEAR_FLAG
	SIF TALENT:LOCAL:153
		CALL REVERSE_B_SIZE

	TALENT:LOCAL:153 = 0
	CFLAG:LOCAL:発情妊娠 = 0
	CFLAG:LOCAL:父親失踪 = 0
	TALENT:LOCAL:154 = 0
	
	TALENT:LOCAL:妻拉致 = 0
	TALENT:LOCAL:悪徳スカウト = 0
NEXT


