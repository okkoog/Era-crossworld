@SHOPCOMABLE_667
RESULTS = キャラフィルタ
;一応、マスターしかいないときは除外
SIF CHARANUM < 2
	RETURN 0
RETURN 1

@SHOP_COM_667
P = 0
;表示させるキャラを抽出（Q:*に表示するキャラの登録番号、LOCAL:2に人数）
VARSET Q, -1
A = 0
REPEAT CHARANUM
	;主人公は除外
	SIF COUNT == 0
		CONTINUE
	;仕事中のキャラも面倒なことになりそうだし、基本的にフィルターかけるとは思えないので除外
	SIF CFLAG:COUNT:労役フラグ
		CONTINUE
	;いないキャラも除外
	SIF CFLAG:COUNT:この場に居ないフラグ == 1
		CONTINUE
	Q:A = COUNT
	A += 1
REND
LOCAL:2 = A

$PRINT_LIST
DRAWLINE
PRINTFORML フィルタリング設定を変更したいキャラを選んでください　＜page.{P}＞
DRAWLINE
CALL SHOW_CHARA_LIST
DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 16% # [1007]前のページ\@
PRINTLC [1000]戻る
PRINTFORMLC \@(P >= (LOCAL:2 - 1) / 20) ? %" " * 16% # [1009]次のページ\@

$INPUT_LOOP_1
INPUT
IF RESULT == 1000
	;FOR LOCAL, 0, CHARANUM - 1
	;	IF CFLAG:LOCAL:フィルタリングフラグ
	;		FOR LOCAL:1, LOCAL, CHARANUM
	;			SIF CFLAG:(LOCAL:1):フィルタリングフラグ
	;				CONTINUE
	;			SIF TARGET == LOCAL:1
	;				TARGET = LOCAL
	;			SWAPCHARA LOCAL, LOCAL:1
	;			BREAK
	;		NEXT
	;	ENDIF
	;NEXT
	;ポジションに齟齬が発生するので、FLAG側を初期化＋CFLAG側から読み込み
	CALL REFRESH_POS
	RETURN 0
ELSEIF RESULT == 1007
	IF P > 0
		P -= 1
		REUSELASTLINE 
		GOTO PRINT_LIST
	ELSE
		REUSELASTLINE 
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT == 1009
	LOCAL = (LOCAL:2 - 1) / 20
	IF P < LOCAL
		P += 1
		REUSELASTLINE 
		GOTO PRINT_LIST
	ELSE
		REUSELASTLINE 
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT < 0 || RESULT >= CHARANUM || MATCH(Q,RESULT) == 0
	REUSELASTLINE 
	GOTO INPUT_LOOP_1
ENDIF
INVERTBIT CFLAG:RESULT:フィルタリングフラグ,0
IF CFLAG:RESULT:フィルタリングフラグ
	;ターゲットから外す
	FOR LOCAL, 0, 4
		IF LOCAL == 0
			SIF TARGET == RESULT
				TARGET = -1
			SIF ASSI == RESULT
				ASSI = -1
		ENDIF
		SIF TARGET:LOCAL == CFLAG:RESULT:キャラ固有の番号
			TARGET:LOCAL = -1
		SIF ASSI:LOCAL == CFLAG:RESULT:キャラ固有の番号 && LOCAL < 3
			ASSI:LOCAL -= 1
	NEXT
ENDIF
REUSELASTLINE 
GOTO PRINT_LIST
