TFLAG:500 = 1
TFLAG:501 = 1
TFLAG:502 = 1
TFLAG:503 = 1
TFLAG:504 = 1
SKIPDISP FLAG:控え格納
FOR LOCAL:1, 0, 3
	FOR LOCAL, LOCAL:1*3+1, LOCAL:1*3+4
		CHARA = FINDCHARA_ID(TARGET:LOCAL)
		;マスターと失踪者とIDがないキャラはここで外す
		IF CHARA < 0 || CFLAG:CHARA:この場に居ないフラグ || CHARA == MASTER
			TARGET:LOCAL = -1
			SETCOLOR COLOR("light-gray")
			PRINTFORM %@"控え{LOCAL}:ＥＭＰＴＹ",34,LEFT%
			RESETCOLOR
		ELSE
			PRINTFORM %@"控え{LOCAL}:"+NAME:CHARA,24,LEFT%
			SELECTCASE 危険日(CHARA)
				CASE 1
					SETCOLOR 0xCC33FF
					CALL HEARTB
					PRINTFORM 危険日
					CALL HEARTB
					RESETCOLOR
				CASE 2
					SETCOLOR 0xCC33FF
					CALL HEARTB
					PRINTFORM 発情中
					CALL HEARTB
					RESETCOLOR
				CASE 3,-2
					SETCOLOR 0xCC33FF
					CALL HEARTB
					PRINTFORM 発情中
					CALL HEARTB
					RESETCOLOR
				CASEELSE
					PRINTFORM 　　　　　
			ENDSELECT
		ENDIF
		SIF LOCAL % 3 > 0
			PRINT │
	NEXT
	PRINTL 
	FOR LOCAL, LOCAL:1*3+1, LOCAL:1*3+4
		CHARA = FINDCHARA_ID(TARGET:LOCAL)
		IF CHARA >= 0
			PRINT 体力 
			CALL PRINT_COLORBAR, BASE:CHARA:体力, MAXBASE:CHARA:体力, 14, UNICODE(0x2584), UNICODE(0x2584), BARCOLORSET("赤"), RESULT:1
			PRINTFORM  ({BASE:CHARA:体力,5}/{MAXBASE:CHARA:体力,5}) 
		ELSE
			SETCOLOR COLOR("light-gray")
			PRINT 体力 
			CALL PRINT_COLORBAR, 0, 1, 14, UNICODE(0x2584), UNICODE(0x2584), BARCOLORSET("赤"), RESULT:1
			PRINTFORM  (    0/    0) 
			RESETCOLOR
		ENDIF
		SIF LOCAL % 3 > 0
			PRINT │
	NEXT
	PRINTL 
	FOR LOCAL, LOCAL:1*3+1, LOCAL:1*3+4
		CHARA = FINDCHARA_ID(TARGET:LOCAL)
		IF CHARA < 0 || TARGET == CHARA || !PARTNER_ABLE(CHARA)
			SETCOLOR COLOR("light-gray")
		ELSE
			TFLAG:(510+LOCAL) = 1
		ENDIF
		PRINTBUTTON @" [{510+LOCAL}] 調教 ", 510+LOCAL
		RESETCOLOR
		IF CHARA <= 0 || ASSI == CHARA || !ASSI_ABLE(CHARA)
			SETCOLOR COLOR("light-gray")
		ELSE
			TFLAG:(520+LOCAL) = 1
		ENDIF
		PRINTBUTTON @"[{520+LOCAL}] 助手 ", 520+LOCAL
		RESETCOLOR
		PRINTBUTTON @"[{530+LOCAL}] 変更 ", 530+LOCAL
		TFLAG:(530+LOCAL) = 1
		SIF LOCAL % 3 > 0
			PRINT │
	NEXT
	PRINTL 
	IF LOCAL:1 == 2
		DRAWLINE
	ELSE
		DRAWLINE
		;PRINTFORML %"─"*17 + "┼" + "─"*17 +"┼" + "─"*17%
	ENDIF
	SIF LOCAL:1 == FLAG:控え表示人数
		BREAK
NEXT
