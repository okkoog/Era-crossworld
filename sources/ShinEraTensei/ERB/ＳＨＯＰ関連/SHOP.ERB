	RESULTS = 
	TRYCCALLFORM SHOPCOMABLE_{LOCAL}
		IF RESULT > 0
			TFLAG:LOCAL = 1
			IF RESULTS != ""
					PRINTFORMLC [{LOCAL}] - %RESULTS%
			ENDIF
		ELSEIF RESULT == -1
;			LOCAL:1 -= 1
		ELSE
			SETCOLOR 0x404040
			IF LOCAL == 777 && FLAG:周回回数 == 0
				PRINTFORMLC [???] - ？？？？？
			ELSEIF LOCAL == 555 && FLAG:5 == 9
				PRINTFORMLC [---] - ＥＭＰＴＹ
			ELSE
				PRINTFORMLC [{LOCAL}] - %RESULTS%
			ENDIF
			RESETCOLOR
		ENDIF
		IF RESULT >= 0
			LOCAL:1 += 1
			SIF LOCAL:1 % SHOPPRINTCPL() == 0
				PRINTL 
		ENDIF
	CATCH
		
	ENDCATCH
	IF LOCAL == 199 || LOCAL == 400
		IF LOCAL:1 % SHOPPRINTCPL() > 0
			LOCAL:1 = 0
			PRINTL
		ENDIF
	ENDIF
NEXT
IF FLAG:控え表示位置 == 2 && FLAG:控え利用設定 < 2
	SIF !LINEISEMPTY()
		PRINTL
	DRAWLINE
	CALL SHOW_SUB_TARGET
ENDIF
