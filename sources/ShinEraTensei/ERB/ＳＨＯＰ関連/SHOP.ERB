	IF FLAG:DEBUG == 0
		PRINTFORML デバッグモードをONにしました
		FLAG:DEBUG = 1
	ELSEIF FLAG:998 == 1
		PRINTFORML デバッグモードをOFFにしました
		FLAG:DEBUG = 0
	ENDIF
