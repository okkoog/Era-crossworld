	;---- EDIT 003 ADD END   -------------------------
	FLAG:ショップコマンド = 0
	FLAG:ソーマギフト = 0
	FLAG:宝玉輪ギフト = 0
	FOR LOCAL,0,CHARANUM
		SIF CFLAG:LOCAL:悪魔変身 == 1
			CALL ACTION_2310 , LOCAL , 0
	NEXT
	BEGIN TURNEND
ENDIF

FOR LOCAL,0,CHARANUM
