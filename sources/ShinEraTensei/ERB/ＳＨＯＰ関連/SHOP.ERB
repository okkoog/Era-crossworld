PRINTFORM 所持金:￥{MONEY}　　{MONEY:1}魔貨　　仲魔：{NUM_NAKAMA()}体　　
SELECTCASE 危険日(MASTER)
	CASE 1
		SETCOLOR 0xCC33FF
		CALL HEARTB
		PRINTFORM 危険日
		CALL HEARTB
		RESETCOLOR
	CASE 2
		SETCOLOR 0xCC33FF
