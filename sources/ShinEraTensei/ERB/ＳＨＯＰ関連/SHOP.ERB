LOCAL:1 = NUM_NAKAMA()
LOCAL:2 = ソフト容量()
IF LOCAL > 50
	LOCAL:1 = LOCAL:1 * 50 / LOCAL
	LOCAL:2 = LOCAL:2 * 50 / LOCAL
	LOCAL = 50
ENDIF
SIF LOCAL:1+ LOCAL:2
	CALL PRINT_COLORBAR, LOCAL:1, LOCAL:1 + LOCAL:2, LOCAL:1+LOCAL:2, UNICODE(0x258B), UNICODE(0x258B), 0x202050, 0x404078
