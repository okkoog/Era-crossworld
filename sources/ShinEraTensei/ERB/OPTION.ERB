@TYPE_COLOR_SETTING
#LOCALSIZE 21
FOR LOCAL, 0, 6
	LOCAL:20 = FLAG:(GETNUM(FLAG, "通常カラー")+LOCAL)
	CALL GETCOLOR_9(LOCAL:20)
	LOCAL:(1 + LOCAL*3) = RESULT
	LOCAL:(2 + LOCAL*3) = RESULT:1
	LOCAL:(3 + LOCAL*3) = RESULT:2
NEXT
$START
FOR LOCAL, 0, 6
