ELSE
	PRINTFORML [利用しない]
ENDIF
PRINTFORML %"[22] - コマンドを並べる数の設定", 50, LEFT%
PRINTFORML %"[23] - オープニングデモ", 50, LEFT%[\@ GLOBAL:4 ? 見ない # 見る \@]
