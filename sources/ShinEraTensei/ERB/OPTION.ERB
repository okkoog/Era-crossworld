	CASE 2
		PRINTL [確認しない + 朝まで休憩]
ENDSELECT
PRINTFORM %"[20] - PALAM表示設定", 50, LEFT%
SELECTCASE FLAG:PALAM表示設定
	CASE 0
		PRINTL [Ａタイプ]
