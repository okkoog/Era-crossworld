;素質解説メインページ
;--------------------------------------------------
@DICTIONARY_TALENT_MAIN
P = 0
$PRINT_LIST
DRAWLINE
PRINTFORML 「素質」に関する大まかな説明です。 ＜page.{P+1}/3＞
DRAWLINE
;各ページを表示
FOR LOCAL:1, 0, 60
	LOCAL = LOCAL:1 + P*60
	STRLENS TALENTNAME:LOCAL
	SIF RESULT > 0
		PRINTFORMLC [{LOCAL, 3}]%TALENTNAME:LOCAL%
NEXT
PRINTL 
DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 16% # [1001]前のページ\@
PRINTLC [1000]戻る
PRINTFORMLC \@(P >= 2) ? %" " * 16% # [1009]次のページ\@

$INPUT_LOOP
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1001 && P > 0
	P -= 1
	GOTO PRINT_LIST
ELSEIF RESULT == 1009 && P < 2
	P += 1
	GOTO PRINT_LIST
ELSE
	Q = RESULT
	STRLENS TALENTNAME:Q
	IF RESULT > 0
		PRINTFORML 【%TALENTNAME:Q%】
		TRYCALLFORM DICTIONARY_TALENT_{Q}
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP
	ENDIF
ENDIF

