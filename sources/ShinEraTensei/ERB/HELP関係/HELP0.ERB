PRINTFORML 《》で括られたものはその技能を上げるのにその珠しか手段がないことを示します。
DRAWLINE
;各表示
FOR LOCAL, 0, 199
	Q:LOCAL = 0
	STRLENS PALAMNAME:LOCAL
	IF RESULT > 0
		IF LOCAL >= 100
			PRINTFORMLC [{LOCAL}]%PALAMNAME:LOCAL%の珠
		ELSE
			PRINTFORMLC [{LOCAL, 2}] %PALAMNAME:LOCAL%の珠
		ENDIF
		Q:LOCAL = 1
	ENDIF
NEXT
PRINTL 
DRAWLINE
PRINTLC [200]戻る

$INPUT_LOOP
INPUT
IF RESULT == 200
	RETURN 0
ELSEIF RESULT < 0 || RESULT > 200
	GOTO INPUT_LOOP
ELSE
	SIF Q:RESULT == 0
		GOTO INPUT_LOOP
	PRINTFORML 【%PALAMNAME:RESULT%】
	TRYCALLFORM DICTIONARY_JUEL_{RESULT}
	GOTO PRINT_LIST
ENDIF

