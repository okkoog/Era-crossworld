DRAWLINE
PRINTL [100]- 戻る
$INPUT_LOOP
INPUT
IF RESULT == 100
	RETURN 0
ELSEIF RESULT == 0
	CALL CHARA_SELL_SELECT
ELSEIF RESULT == 1
	CALL RESTRANT
ELSEIF RESULT == 2
	CALL PROSTITUTION
ELSEIF RESULT == 3 && TIME == 0
	CALL RENTAL_SLAVE
ELSEIF RESULT == 4 && イベントフラグ:32:0 == 0 && TIME == 3
	CALL CONCERT
