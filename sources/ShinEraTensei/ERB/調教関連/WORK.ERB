@CANCEL_WORK

P = 0

$COLLECT_LIST

;表示させるキャラを抽出（Q:*に表示するキャラの登録番号、LOCAL:2に人数）
VARSET Q, -1
A = 0
REPEAT CHARANUM
	SIF CFLAG:COUNT:労役フラグ == 0
		CONTINUE
	SIF CFLAG:COUNT:労役フラグ == 3 && TIME > 0
		CONTINUE
	SIF CFLAG:COUNT:この場に居ないフラグ == 1
		CONTINUE
	Q:A = COUNT
	A += 1
REND
LOCAL:2 = A

;現在のページ番号が表示範囲外の場合1ページ戻す
SIF P > 0 && P > ((LOCAL:2 - 1) / 20)
	P -= 1

$PRINT_LIST
DRAWLINE
PRINTFORML 労役をやめる奴隷を選択してください　＜page.{P}＞
IF LOCAL:2 >= 2
	DRAWLINE
	PRINTL [999] 労役しているキャラ全員の労役をやめる
ENDIF
DRAWLINE
CALL SHOW_CHARA_LIST
DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 16% # [1007]前のページ\@
PRINTLC [1000]戻る
PRINTFORMLC \@(P >= (LOCAL:2 - 1) / 20) ? %" " * 16% # [1009]次のページ\@

$INPUT_LOOP_1
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1007
	IF P > 0
		P -= 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT == 1009
	LOCAL = (LOCAL:2 - 1) / 20
	IF P < LOCAL
		P += 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF (RESULT < 0 || RESULT >= CHARANUM || CFLAG:RESULT:この場に居ないフラグ == 1 || MATCH(Q,RESULT,0) == 0) && RESULT != 999
	GOTO INPUT_LOOP_1
ENDIF

;対象が二人未満の場合、999(全員の労役解除)は無効
SIF LOCAL:2 < 2 && RESULT == 999
	GOTO INPUT_LOOP_1

IF RESULT != 999
	VARSET Q, -1
	Q:0 = RESULT
	LOCAL:2 = 1
ELSE
	;間違い対策として念押し確認
	PRINTL 現在労役している全てのキャラの労役をやめさせます。
	PRINTL 本当によろしいですか？
	CALL INPUT_YN
	SIF RESULT == 1
		;キャラ一覧に戻る。
		GOTO PRINT_LIST
ENDIF

FOR COUNT, 0, LOCAL:2
	PRINTFORMW %CALLNAME:(Q:COUNT)%の労役を解除しました
	CFLAG:(Q:COUNT):労役フラグ = 0
	IF CFLAG:(Q:COUNT):劇場出演順番 != 0
		DE:(49+(CFLAG:(Q:COUNT):劇場出演順番)):(CFLAG:(Q:COUNT):労役店舗-1) = -1
		DE:(59+(CFLAG:(Q:COUNT):劇場出演順番)):(CFLAG:(Q:COUNT):労役店舗-1) = -1
		CFLAG:(Q:COUNT):労役フラグ = 0
		CFLAG:(Q:COUNT):劇場出演順番 = 0
		CFLAG:(Q:COUNT):労役店舗 = 0
	ENDIF
NEXT

GOTO COLLECT_LIST

@EXTEND_WORK
DRAWLINE

SIF ITEM:屋台 == 0
	PRINTL [1]  - 屋台を購入する(￥50000)
SIF ITEM:食堂 == 0 && FLAG:料理人気 >= 150
	PRINTL [1]  - 食堂の権利書を買う(￥300000)
SIF ITEM:安宿 == 0
	PRINTL [2]  - 宿屋を購入する(￥50000)
SIF ITEM:娼館 == 0 && FLAG:売春人気 >= 150
	PRINTL [2]  - 宿屋を娼館に改装する(￥500000)

DRAWLINE
PRINTL [100]  - 戻る
$INPUT_LOOP
INPUT
IF RESULT == 100
	RETURN 0
ELSEIF RESULT == 1 && ITEM:食堂 == 0
	IF ITEM:屋台 == 0 && MONEY < 50000
		PRINTW 屋台を運営するには資本金が足りない。
		CLEARLINE 2
		GOTO INPUT_LOOP
	ELSEIF ITEM:屋台 == 0
		PRINTW 屋台を購入しました
		MONEY -= 50000
		FLAG:料理人気 = 1
		ITEM:屋台 = 1
		RESTART
	ELSEIF ITEM:食堂 == 0 && FLAG:料理人気 >= 150 && MONEY < 300000
		PRINTW 食堂の権利書を買うには資本金が足りない
		CLEARLINE 2
		GOTO INPUT_LOOP
	ELSEIF  ITEM:食堂 == 0 && FLAG:料理人気 >= 150
		PRINTFORMW %NAME:MASTER%の経営する食堂が開店しました。
		MONEY -= 300000
		ITEM:食堂 = 1
		RESTART
	ELSE
		CLEARLINE 1
		GOTO INPUT_LOOP
	ENDIF
ELSEIF RESULT == 2 && ITEM:娼館 == 0
	IF ITEM:安宿 == 0 && MONEY < 50000
		PRINTW 宿を経営するには資本金が足りない
		CLEARLINE 2
		GOTO INPUT_LOOP
	ELSEIF ITEM:安宿 == 0
		PRINTW 宿屋の権利書を購入しました
		MONEY -= 50000
		FLAG:売春人気 = 1
		ITEM:安宿 = 1
		RESTART
	ELSEIF ITEM:娼館 == 0 && FLAG:売春人気 >= 150 && MONEY < 500000
		PRINTW 宿を改装するには資本金が足りない
		CLEARLINE 2
		GOTO INPUT_LOOP
	ELSEIF  ITEM:娼館 == 0 && FLAG:売春人気 >= 150
		PRINTW 所有する宿を売春専用施設として改装しました。
		MONEY -= 500000
		ITEM:娼館 = 1
		RESTART
	ELSE
		CLEARLINE 1
		GOTO INPUT_LOOP
	ENDIF
ELSE
	CLEARLINE 1
	GOTO INPUT_LOOP
ENDIF
