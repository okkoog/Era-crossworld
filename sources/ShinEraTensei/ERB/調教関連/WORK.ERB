	TIMES TFLAG:主人母乳買値 , 0.20
;HARD
ELSEIF FLAG:4 == 3
	TIMES TFLAG:主人母乳買値 , 0.16
ENDIF
O += TFLAG:主人母乳買値

IF ASSI >= 0
TFLAG:助手母乳買値 = TFLAG:助手が搾乳中 * 100
IF EXP:ASSI:54 <= EXPLV:0
	TFLAG:助手母乳買値 *= 1
ELSEIF EXP:ASSI:54 <= EXPLV:1
	TFLAG:助手母乳買値 *= 2
ELSEIF EXP:ASSI:54 <= EXPLV:2
	TFLAG:助手母乳買値 *= 3
ELSEIF EXP:ASSI:54 <= EXPLV:3
	TFLAG:助手母乳買値 *= 4
ELSEIF EXP:ASSI:54 <= EXPLV:4
	TFLAG:助手母乳買値 *= 5
ELSE
	TFLAG:助手母乳買値 *= 6
ENDIF
;難易度処理
;EASY
IF FLAG:4 == 1
	TIMES TFLAG:助手母乳買値 , 0.24
;NORMAL
ELSEIF FLAG:4 == 2
	TIMES TFLAG:助手母乳買値 , 0.20
;HARD
ELSEIF FLAG:4 == 3
	TIMES TFLAG:助手母乳買値 , 0.16
ENDIF
O += TFLAG:助手母乳買値
ENDIF
IF O > 0
	IF TFLAG:主人母乳買値 > 0
		PRINTFORML 搾乳器を使って%CALLNAME:MASTER%から母乳を搾り出した
		PRINTFORML %CALLNAME:MASTER%の母乳には{TFLAG:主人母乳買値}の買値が付いた
	ENDIF
	IF TFLAG:助手母乳買値 > 0
		PRINTFORML 搾乳器を使って%CALLNAME:ASSI%から母乳を搾り出した
		PRINTFORML %CALLNAME:ASSI%の母乳には{TFLAG:助手母乳買値}の買値が付いた
	ENDIF
	IF TFLAG:奴隷母乳買値 > 0
		PRINTFORML 搾乳器を使って%CALLNAME:TARGET%から母乳を搾り出した
		PRINTFORML %CALLNAME:TARGET%の母乳には{TFLAG:奴隷母乳買値}の買値が付いた
	ENDIF
	MONEY += O
	TFLAG:主人母乳買値 = 0
	TFLAG:助手母乳買値 = 0
	TFLAG:奴隷母乳買値 = 0
	PRINTFORML 所持金 {O}増加
	WAIT
ENDIF
