@SIFT_WORK
VARSET LOCAL
P = 0
;表示させるキャラを抽出（Q:*に表示するキャラの登録番号、LOCAL:2に人数）
VARSET Q, -1
A = 0
REPEAT CHARANUM
	SIF CFLAG:COUNT:労役フラグ == 0
		CONTINUE
	SIF CFLAG:COUNT:労役フラグ == 3 && TIME > 0
		CONTINUE
	SIF CFLAG:COUNT:この場に居ないフラグ == 1
		CONTINUE
	Q:A = COUNT
	A += 1
REND
LOCAL:2 = A

$PRINT_LIST
DRAWLINE
PRINTFORML シフトを変更する奴隷を選択してください　＜page.{P}＞
;---- EDIT 003 ADD START ---------------
;設定可能なキャラが二人以上いる場合
;まとめて設定できる選択肢を表示
IF LOCAL:2 >= 2
	DRAWLINE
	PRINTL [999] 全員のシフト設定を変更する。
ENDIF
;---- EDIT 003 ADD END -----------------
DRAWLINE
PRINTFORML %" "*55%DAY　 1 2 3 4 5 6 7
REPEAT 20
	LOCAL = Q:(COUNT + P * 20)
	SIF LOCAL < 0
		CONTINUE
	SIF CFLAG:LOCAL:この場に居ないフラグ == 1
		CONTINUE
	CALL ARRANGE_CHARALIST, LOCAL
	PRINTFORM 体力({BASE:LOCAL:0, 5}/{MAXBASE:LOCAL:0, 5}) ストレス:{CFLAG:LOCAL:ストレス値, 3}　
	;労役
	IF CFLAG:LOCAL:労役フラグ == 1
		PRINT 食堂 
	ELSEIF CFLAG:LOCAL:労役フラグ == 2
		PRINT 娼館 
	ELSEIF CFLAG:LOCAL:労役フラグ == 3
		PRINT 貸出 
	ELSEIF CFLAG:LOCAL:労役フラグ >= 10
		SELECTCASE [[店舗:種類]]:(CFLAG:LOCAL:労役フラグ-10)
			CASE 1
				PRINT 喫茶
			CASE 2
				PRINT FAMI
			CASE 3
				PRINT 食堂
			CASE 4
				PRINT REST
			CASE 5
				PRINT 居酒
			CASE 6
				PRINT バー
			CASE 7
				PRINT キャ
			CASE 8
				PRINT 風俗
			CASE 9
				PRINT デリ
			CASE 10
				PRINT 便器
			CASEELSE
				PRINT ????
		ENDSELECT
	ELSE
		PRINT ―― 
	ENDIF
	PRINT  
	FOR COUNT:1, 0, 7
		PRINTFORM \@GETBIT(CFLAG:LOCAL:シフト設定, COUNT:1)? × # ○\@
	NEXT
	PRINTL 
REND
DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 16% # [1007]前のページ\@
PRINTLC [1000]戻る
PRINTFORMLC \@(P >= (LOCAL:2 - 1) / 20) ? %" " * 16% # [1009]次のページ\@

$INPUT_LOOP_1
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1007
	IF P > 0
		P -= 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT == 1009
	LOCAL:4 = (LOCAL:2 - 1) / 20
	IF P < LOCAL:4
		P += 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
;---- EDIT 003 MOD START ---------------
ELSEIF (RESULT < 0 || RESULT >= CHARANUM || CFLAG:RESULT:この場に居ないフラグ == 1 || MATCH(Q,RESULT,0) == 0) && RESULT != 999
;---- EDIT 003 MOD END -----------------
	GOTO INPUT_LOOP_1
ENDIF

;シフト設定可能なキャラが二人未満の場合、999(全員を対象)は無効に
SIF LOCAL:2 < 2 && RESULT == 999
	GOTO INPUT_LOOP_1

LOCAL:3 = RESULT
;---- EDIT 003 MOD START ---------------
;全員の設定を行う場合、各人のシフト設定が違うかもしれないので
;一旦全員のシフト設定を初期化(毎日勤務)にする。
IF LOCAL:3 == 999
	;間違い選択対策として一応確認処理追加
	PRINTL 全員のシフト設定を行います。
	PRINTL 本当によろしいですか？
	CALL INPUT_YN
	SIF RESULT == 1
		;キャラ一覧に戻る。
		GOTO PRINT_LIST
	DRAWLINE
	PRINTL 一旦全員のシフト設定を初期化します。
	FOR COUNT, 0, LOCAL:2
		FOR COUNT:1, 0, 7
			CLEARBIT CFLAG:(Q:COUNT):シフト設定, COUNT:1
		NEXT
	NEXT
ENDIF
$SIFT_START
DRAWLINE
;---- EDIT 003 MOD START ---------------
IF LOCAL:3 == 999
	;全員のシフト設定なのでとりあえず代表として対象者で一番若い番号のキャラのシフト設定を表示
	PRINTFORML 全員のシフト(今日は第{DAY%7+1}日目)
	FOR COUNT, 0, 7
		PRINTFORML [{COUNT}] 第{COUNT+1}日目 \@GETBIT(CFLAG:(Q:0):シフト設定, COUNT)? ＯＦＦ # ＯＮ\@
	NEXT
ELSE
	;個人の現在のシフトを表示
	PRINTFORML %CALLNAME:(LOCAL:3)%のシフト(今日は第{DAY%7+1}日目)
	FOR COUNT, 0, 7
		PRINTFORML [{COUNT}] 第{COUNT+1}日目 \@GETBIT(CFLAG:(LOCAL:3):シフト設定, COUNT)? ＯＦＦ # ＯＮ\@
	NEXT
ENDIF
;---- EDIT 003 MOD END -----------------
PRINTL [8] 他の奴隷のシフトを変更する
PRINTL [9] 戻る
CALL INPUTINT(0, 1, 2, 3, 4, 5, 6, 8, 9)
SIF RESULT == 9
	RETURN 0
SIF RESULT == 8
	RESTART
;---- EDIT 003 MOD START ---------------
IF LOCAL:3 == 999
	;全員のシフト設定を変更
	FOR COUNT, 0, LOCAL:2
		INVERTBIT CFLAG:(Q:COUNT):シフト設定, RESULT
	NEXT
ELSE
	;個人のシフト設定を変更
	INVERTBIT CFLAG:(LOCAL:3):シフト設定, RESULT
ENDIF
;---- EDIT 003 MOD END -----------------
GOTO SIFT_START
