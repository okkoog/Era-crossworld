@CHARA_SELL_SELECT
CALL INPUT_CHARA_LIST("誰を売りますか？", "CHARASELLABLE")
SIF RESULT == 1000
	RETURN 0
CALL CHARA_SELL, RESULT

;ARGは売るキャラ・ARG:1は価格試算で表示なし
@CHARA_SELL, ARG, ARG:1
#DIM PRICE
#DIM PRICE_T
#DIM PRICE_A
#DIM SUMPRICE_T
#DIM SUMPRICE_A
#DIM PRICE_EX
#LOCALSIZE 6
#LOCALSSIZE 1
IF ARG:1
	SKIPDISP 1
ENDIF
;-------------------------------------------------------------------
;基本価格の決定
;LOCALSは表示名
;-------------------------------------------------------------------
;娘・息子
IF NO:ARG == 3501 || NO:ARG == 3502
	PRICE = BASE:ARG:LV * (3+BASE:ARG:LV/10) * 1
	LOCALS = 子供
;悪魔
ELSEIF ABL:ARG:種族 > 0 && ABL:ARG:種族 < 45
	PRICE = (CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0) < 10 ? 90 # 0 ) + CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0) * (5+MAX(5,CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0)/2)) * 5
	LOCALS = 悪魔
;造魔
ELSEIF ABL:ARG:種族 == 45
	PRICE = 450 + BASE:ARG:LV * (3+BASE:ARG:LV/4) * 3
	LOCALS = 造魔
;非戦闘員でない人間(霊媒体質は非戦闘員でも戦闘員とみなす)
ELSEIF (TALENT:ARG:非戦闘員 == 0 || TALENT:ARG:霊媒体質)
	PRICE = BASE:ARG:LV * (5+BASE:ARG:LV/2) * 8
	LOCALS = 能力者
ELSE
	PRICE = BASE:ARG:LV * (3+BASE:ARG:LV/2) * 8 / 4
	LOCALS = 人間
ENDIF

;-------------------------------------------------------------------
;引継ぎキャラの基本価格
;-------------------------------------------------------------------
IF CFLAG:ARG:引継ぎ回数 > 0 && FLAG:ゲームモード < 9 && DAY < 51
	PRICE = CFLAG:ARG:初期LV * (5+CFLAG:ARG:初期LV/2) * 5 * DAY / 100
	LOCALS = 引継ぎキャラ
ENDIF

PRICE /= 2
CUSTOMDRAWLINE =
PRINTFORML %種族名(ARG)% %CALLNAME:ARG%
CUSTOMDRAWLINE =
FONTBOLD
PRINTFORML <基本売却金額計算>
FONTREGULAR
PRINTFORML %"種別",12, LEFT%%LOCALS%
IF LOCALS == "人間" || LOCALS == "能力者"
	PRINTFORML %"レベル",12, LEFT%{BASE:ARG:LV}
ELSE
	PRINTFORML %"初期レベル",12, LEFT%{CSVBASE(NO:ARG,GETNUM(BASE,"LV"),0)}
ENDIF
PRINTFORML %"結果",12, LEFT%{PRICE}魔貨
CUSTOMDRAWLINE =
FONTBOLD
PRINTFORML <倍率計算>
FONTREGULAR
PRINTFORML ┌% "─"* 9%┬%"─"* 3%┐┌% "─"* 9%┬%"─"* 3%┐┌% "─"* 9%┬%"─"* 3%┐
PRINTFORML │%"ABL",18,LEFT%│%"補正",6,LEFT%││%"TALENT",18,LEFT%│%"補正",6,LEFT%││%"EXTRA",18,LEFT%│%"補正",6,LEFT%│
PRINTFORML ├% "─"* 9%┼%"─"* 3%┤├% "─"* 9%┼%"─"* 3%┤├% "─"* 9%┼%"─"* 3%┤
PRINTFORML │%"基本値",18,LEFT%│+ 100\%││%"基本値",18,LEFT%│+ 100\%││%@"調教難易度<%AUTO_SPLIT("Easy/Normal/Hard","/",FLAG:調教難易度-1)%>",18,LEFT%│* {140 - FLAG:調教難易度 * 20}\%│
SUMPRICE_A = 100
SUMPRICE_T = 100
LOCAL = -1
LOCAL:1 = -1
LOCAL:2 = -1
WHILE LOCAL < 100 || LOCAL:1 < 200
	PRICE_A = 0
	WHILE LOCAL < 100
		LOCAL++
		PRICE_A = GET_SELLPRICE_ABL(LOCAL, ARG)
		SIF !PRICE_A
			CONTINUE
		SUMPRICE_A += PRICE_A
		BREAK
	WEND
	PRICE_T = 0
	WHILE LOCAL:1 < 200
		LOCAL:1++
		PRICE_T = GET_SELLPRICE_TALENT(LOCAL:1, ARG)
		SIF !PRICE_T
			CONTINUE
		SUMPRICE_T += PRICE_T
		BREAK
	WEND
	IF PRICE_A
		PRINTFORM │%ABLNAME:LOCAL,14,LEFT%Lv{ABL:ARG:LOCAL,2}│+ {PRICE_A,3}\%│
	ELSE
		SIF PRICE_T
			PRINTFORM │%"",18%│%"",6%│
	ENDIF
	IF PRICE_T
		PRINTFORM │%TALENTNAME:(LOCAL:1),18,LEFT%│%\@PRICE_T > 0 ? + # - \@% {ABS(PRICE_T),3}\%│
	ELSE
		SIF PRICE_A
			PRINTFORM │%"",18%│%"",6%│
	ENDIF
	PRICE_EX = 0
	WHILE LOCAL:2 < 10
		LOCAL:2++
		SELECTCASE LOCAL:2
			CASE 0
				;崩壊,狂気,妊娠は売却額をかなり低くする（従順によって、80％まで回復）
				IF TALENT:ARG:崩壊 || TALENT:ARG:狂気 || TALENT:ARG:妊娠
					PRICE_EX = ABL:ARG:従順 * 8
					IF TALENT:ARG:崩壊
						LOCALS = 崩壊
					ELSEIF TALENT:ARG:狂気
						LOCALS = 狂気
					ELSEIF TALENT:ARG:妊娠
						LOCALS = 妊娠
					ENDIF
					PRINTFORM │%LOCALS,18,LEFT%│*{ABL:ARG:従順*8,4}\%│
				ENDIF
			CASE 1
				;需要による売却価格低下
				IF FLAG:(30000+NO:ARG)
					PRICE_EX = 100/(1+FLAG:(30000+NO:ARG))
					PRINTFORM │%"需要",18,LEFT%│*{PRICE_EX,4}\%│
				ENDIF
			CASE 10
				PRINTFORM └% "─"* 9%┴%"─"* 3%┘
		ENDSELECT
		SIF !PRICE_EX
			CONTINUE
		BREAK
	WEND
	SIF PRICE_A || PRICE_T
		PRINTL 
WEND
PRINTFORML ├% "─"* 9%┼%"─"* 3%┤├% "─"* 9%┼%"─"* 3%┤
PRINTFORML │%"合計値",18,LEFT%│*{SUMPRICE_A,4}\%││%"合計値",18,LEFT%│*{MAX(SUMPRICE_T,0),4}\%│
PRINTFORML └% "─"* 9%┴%"─"* 3%┘└% "─"* 9%┴%"─"* 3%┘
DRAWLINE
;表示が確定しているABL/TALENT/難度
PRINTFORM {SUMPRICE_A}\% * {SUMPRICE_T}\% * {140 - FLAG:調教難易度 * 20}\%
LOCAL:1 = SUMPRICE_A * SUMPRICE_T * (140 - FLAG:調教難易度 * 20)
LOCAL:2 = 2

IF TALENT:ARG:崩壊 || TALENT:ARG:狂気 || TALENT:ARG:妊娠
	LOCAL:1 *= ABL:ARG:従順 * 8
	LOCAL:2++
	PRINTFORM  * {ABL:ARG:従順 * 8}\%
ENDIF
IF FLAG:(30000+NO:ARG)
	LOCAL:1 *= 100/(1+FLAG:(30000+NO:ARG))
	PRINTFORM  * {100/(1+FLAG:(30000+NO:ARG))}\%
	LOCAL:2++
ENDIF
FOR LOCAL, 0, LOCAL:2
	LOCAL:1 /= 100
NEXT
PRINTFORML  = {LOCAL:1}\%
DRAWLINE
CUSTOMDRAWLINE =
LOCAL:2 = PRICE
;補正値の適用
PRICE *= LOCAL:1
PRICE /= 100

PRICE = MAX(1, PRICE)
FONTBOLD
PRINTFORML <価格>
FONTREGULAR
PRINTFORML {LOCAL:2}魔貨 * {LOCAL:1}\% = {PRICE}魔貨
CUSTOMDRAWLINE =
IF ARG:1
	SKIPDISP 0
	RETURN PRICE
ENDIF
;売却確認
PRINTL 売却しますか？
CALL INPUT_YN

SELECTCASE RESULT
	CASE 0
		;売却時のイベント口上
		TFLAG:13 = 18
		SWAP ARG, TARGET
		CALL KOJO_MESSAGE_EVENT
		SWAP ARG, TARGET
		;売却額
		IF PRICE > 0
			PRINTFORMW 結果、%NAME:ARG%は{PRICE}魔貨で魔界の好事家に売れました
		ELSEIF PRICE == 0
			PRINTFORMW 結果、%NAME:ARG%は業者に引き取られました
		ENDIF
		CALL CHARASELL_AFTER, ARG, PRICE
	CASE 1
		ARG = LOCAL:1
		RETURN 0
ENDSELECT
@CHARASELLABLE
RETURN GET_CHARASELLABLE(COUNT)

;----------------------------------------
;ARG 　売却するキャラ
;ARG:1 価格
;----------------------------------------
@CHARASELL_AFTER, ARG, ARG:1 = -1
;価格が送られて無い場合は取る
IF ARG == -1
	CALL CHARA_SELL, ARG, 1
	ARG:1 = RESULT
ENDIF
IF ARG:1 > 0
	MONEY:1 += ARG:1
	FLAG:調教師名声 += ARG:1/100
ENDIF

;売却履歴をつける
FLAG:(30000+NO:ARG) += 1

;キャラクタ－削除
CALL キャラ削除, ARG

FLAG:奴隷売却総数 += 1
FLAG:奴隷売却数 += 1

;主人の属性値変動
CALL INCREASE_LD,-10
CALL SYNC_STATUS,MASTER



@DEAL_CHARA

P = 0
;表示させるキャラを抽出（Q:*に表示するキャラの登録番号、LOCAL:2に人数）
VARSET Q, -1
A = 0
REPEAT CHARANUM
	SIF COUNT == MASTER
		CONTINUE
	SIF CFLAG:COUNT:ボスフラグ
		CONTINUE
	SIF CFLAG:COUNT:この場に居ないフラグ == 1
		CONTINUE
	;育児部屋に移動しているキャラは除外
	SIF CHECK_CHILD_CARE(COUNT) && FLAG:出産機能ONOFF == 1
		CONTINUE
	SIF CFLAG:COUNT:労役フラグ == 3
		CONTINUE
	SIF ABL:COUNT:種族 != 0 && NO:COUNT != [[キャラ:メアリ]]
		CONTINUE
	Q:A = COUNT
	A += 1
REND
LOCAL:2 = A

$PRINT_LIST
DRAWLINE
PRINTL どのキャラクターを削除しますか？
PRINTL 

CALL SHOW_CHARA_LIST
DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 16% # [1007]前のページ\@
PRINTLC [1000]戻る
PRINTFORMLC \@(P >= (LOCAL:2 - 1) / 20) ? %" " * 16% # [1009]次のページ\@


$INPUT_LOOP
INPUT

IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1007
	IF P > 0
		P -= 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP
	ENDIF
ELSEIF RESULT == 1009
	LOCAL = (LOCAL:2 - 1) / 20
	IF P < LOCAL
		P += 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP
	ENDIF
ELSEIF RESULT <= 0 || RESULT >= CHARANUM
	GOTO INPUT_LOOP
ELSE
	SIF MATCH(Q,RESULT) == 0
		GOTO INPUT_LOOP
ENDIF

PRINTFORMW %CALLNAME:RESULT%を削除しました
FLAG:(30000+NO:RESULT) += 1
CALL キャラ削除, RESULT

RETURN 0


