@SHOPCOMABLE_111
RESULTS = 能力の上昇
RETURN 1

@SHOP_COM_111
CALL ABL_MANUAL_MENU
RETURN 1

;=============================================================================
;手動能力アップ
;=============================================================================
;-------------------------------------------------
;能力上昇キャラ選択処理
;-------------------------------------------------
@CASTING_ABL_MANUAL
MARK:COUNT:98 = 0
SIF CFLAG:COUNT:この場に居ないフラグ >= 1
	RETURN 0
SIF CFLAG:COUNT:労役フラグ == 3
	RETURN 0
SIF CFLAG:COUNT:フィルタリングフラグ
	RETURN 0
SIF ((TALENT:COUNT:妊娠 && CFLAG:COUNT:出産予定日 - 2 <= DAY) || TALENT:COUNT:育児中) && FLAG:出産機能ONOFF == 1
	RETURN 0
RETURN 1

@ABL_MANUAL_MENU
VARSET LOCAL
;ターゲット退避(TFLAG:75)
LOCAL:3 = TARGET

$INPUT_LIST
;キャラリストを表示・選択
CALL INPUT_CHARA_LIST("誰の能力を上昇させますか？", "CASTING_ABL_MANUAL")
IF RESULT == 1000
	SWAP LOCAL:3 , TARGET
	RETURN 0
ENDIF
TARGET = RESULT
CALL ABL_MANUAL_MAIN, A
GOTO INPUT_LIST

;-------------------------------------------------
;上昇させる能力選択の処理
;-------------------------------------------------
@ABL_MANUAL_MAIN,ARG
#LOCALSIZE 1
;リストの何人目かをLOCALに保存
LOCAL = FINDELEMENT(Q, TARGET)
CALL DENIAL_CHECK
$ABLUP_LOOP1
DRAWLINE
PRINTFORML %CALLNAME:TARGET%のどの能力を上昇させますか？
CALL SHOW_JUEL

CALL SHOW_ABLUP_SELECT

IF FLAG:ショップコマンド == [[ショップ:能力の上昇]]
	PRINTFORMLC \@(LOCAL > 0) ? [1001]前のキャラ # %" " * 16%\@
	PRINTFORMLC   %" " * 18%
	PRINTFORMLC \@(LOCAL < ARG - 1) ? [1003]次のキャラ # %" " * 16%\@
ENDIF
I = 0
Z = 0
$INPUT_LOOP1
INPUT
IF 0 <= RESULT && RESULT < 100
	TRYCALLFORM ABLUP{RESULT}
	GOTO ABLUP_LOOP1
ELSEIF RESULT == 1001 && FLAG:ショップコマンド == [[ショップ:能力の上昇]] && LOCAL > 0
	LOCAL -= 1
	TARGET = Q:LOCAL
	RESTART
ELSEIF RESULT == 1003 && FLAG:ショップコマンド == [[ショップ:能力の上昇]] && LOCAL < ARG - 1
	LOCAL += 1
	TARGET = Q:LOCAL
	RESTART
ELSEIF RESULT == 100
	CALL JUJUN_UP_CHECK
	CALL YOKUBO_UP_CHECK
ELSE
	GOTO INPUT_LOOP1
ENDIF

;-------------------------------------------------
;珠の表示
;-------------------------------------------------

@SHOW_JUEL
DRAWLINE
T = TARGET
CALL SHOW_INFO_EXP
A = 0
X = 0

REPEAT 13
	IF COUNT == 12
		X = 100
	ELSE
		X = COUNT
	ENDIF

	PRINTFORM %PALAMNAME:X%の珠：

	;表示位置そろえる
	IF JUEL:X < 10
		PRINT       
	ELSEIF JUEL:X < 100
		PRINT      
	ELSEIF JUEL:X < 1000
		PRINT     
	ELSEIF JUEL:X < 10000
		PRINT    
	ELSEIF JUEL:X < 100000
		PRINT   
	ELSEIF JUEL:X < 1000000
		PRINT  
	ENDIF
	PRINTV JUEL:X

	;改行or表示位置あけ
	IF A%4 == 3
		PRINTL 
	ELSE
		PRINT 　
	ENDIF
	A = A + 1
REND
PRINTL 　
DRAWLINE

@SHOW_ABLUP_SELECT
;売却・助手条件
CALL SPOILER_PRINT_SELL
;陥落条件
CALL SPOILER_PRINT_FALLTALENT

REPEAT 23
	IF COUNT == 0
		X = 0
		CALL ISABLUP0
	ELSEIF COUNT == 1
		X = 1
		CALL ISABLUP1
	ELSEIF COUNT == 2
		X = 2
		CALL ISABLUP2
	ELSEIF COUNT == 3
		X = 3
		CALL ISABLUP3
	ELSEIF COUNT == 4
		X = 4
		CALL ISABLUP4
	ELSEIF COUNT == 5
		X = 5
		CALL ISABLUP5
	ELSEIF COUNT == 6
		X = 6
		CALL ISABLUP6
	ELSEIF COUNT == 7
		X = 7
		CALL ISABLUP7
	ELSEIF COUNT == 8
		X = 8
		CALL ISABLUP8
	ELSEIF COUNT == 9
		X = 9
		CALL ISABLUP9
	ELSEIF COUNT == 10
		X = 10
		CALL ISABLUP10
	ELSEIF COUNT == 11
		X = 11
		CALL ISABLUP11
	ELSEIF COUNT == 12
		X = 12
		CALL ISABLUP12
	ELSEIF COUNT == 13
		X = 13
		CALL ISABLUP13
	ELSEIF COUNT == 14
		X = 14
		CALL ISABLUP14
	ELSEIF COUNT == 15
		X = 15
		CALL ISABLUP15
	ELSEIF COUNT == 16
		X = 16
		CALL ISABLUP16
	ELSEIF COUNT == 17
		X = 17
		CALL ISABLUP17
	ELSEIF COUNT == 18
		X = 18
		CALL ISABLUP18
	ELSEIF COUNT == 19
		X = 19
		CALL ISABLUP19
	ELSEIF COUNT == 20
		X = 20
		CALL ISABLUP20
	ELSEIF COUNT == 21
		X = 21
		CALL ISABLUP21
	ELSEIF COUNT == 22
		X = 22
		CALL ISABLUP22
	ENDIF
	
	SIF (X == 11 || X == 17) && IS_MALE(TARGET)
		CONTINUE
	SIF (X == 20 || X == 21) && !IS_MALE(TARGET)
		CONTINUE

	IF COUNT==0 || COUNT==1 || COUNT==2
		IF RESULT == 1
			PRINTFORM [{COUNT}]%ABLNAME:X%----------LV{ABL:X} *
		ELSE
			SETCOLOR 0x555555
			PRINTFORM [{COUNT}]%ABLNAME:X%----------LV{ABL:X}  
			RESETCOLOR
		ENDIF
	ELSEIF COUNT==3 || COUNT==4 || COUNT==5 || COUNT==6 || COUNT==8
		IF RESULT == 1
			PRINTFORM [{COUNT}]%ABLNAME:X%--------LV{ABL:X} *
		ELSE
			SETCOLOR 0x555555
			PRINTFORM [{COUNT}]%ABLNAME:X%--------LV{ABL:X}  
			RESETCOLOR
		ENDIF
	ELSEIF COUNT==7 || COUNT==9
		IF RESULT == 1
			PRINTFORM [{COUNT}]%ABLNAME:X%------LV{ABL:X} *
		ELSE
			SETCOLOR 0x555555
			PRINTFORM [{COUNT}]%ABLNAME:X%------LV{ABL:X}  
			RESETCOLOR
		ENDIF
	ELSEIF COUNT==10 || COUNT==11 || COUNT==12 || COUNT==13 || COUNT==14 || COUNT==15 || COUNT==16 || COUNT==17 || COUNT==19 || COUNT==20 || COUNT==21 || COUNT==22
		IF RESULT == 1
			PRINTFORM [{COUNT}]%ABLNAME:X%-----LV{ABL:X} *
		ELSE
			SETCOLOR 0x555555
			PRINTFORM [{COUNT}]%ABLNAME:X%-----LV{ABL:X}  
			RESETCOLOR
		ENDIF
	ELSE
		IF RESULT == 1
			PRINTFORM [{COUNT}]%ABLNAME:X%-LV{ABL:X} *
		ELSE
			SETCOLOR 0x555555
			PRINTFORM [{COUNT}]%ABLNAME:X%-LV{ABL:X}  
			RESETCOLOR
		ENDIF
	ENDIF

	IF COUNT==2 ||COUNT==6 ||COUNT==10 || COUNT==14 || COUNT==18 || COUNT==22
		PRINTL 
	ELSEIF ABL:X > 9
		PRINT  
	ELSE
		PRINT 　
	ENDIF

REND

CALL ISABLUP99
IF RESULT == 1
	PRINTFORM [99]%MARKNAME:3%-----LV{MARK:3} *
ELSE
	SETCOLOR 0x555555
	PRINTFORM [99]%MARKNAME:3%-----LV{MARK:3}
	RESETCOLOR

ENDIF

PRINTL 
PRINTL 

PRINTL [100] 能力値アップの終了

@USERABLUP

IF RESULT == 100
	CALL JUJUN_UP_CHECK
	CALL YOKUBO_UP_CHECK
	BEGIN TURNEND
	RETURN 1
ENDIF

RETURN 0
