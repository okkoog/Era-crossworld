@SHOPCOMABLE_113
RESULTS = 調教アイテム購入
RETURN 1


@SHOP_COM_113
#DIM LINE, 2
LINE = LINECOUNT
REDRAW 0
DRAWLINE
PRINTL 購入するアイテムを選んでください
PRINTFORML 所持金:￥{MONEY}
LOCAL:1 = 0
DRAWLINE
FOR LOCAL, 0, 100
	IF GROUPMATCH(LOCAL, 40, 60, 70)
		SIF LOCAL:1 % 2
			PRINTL 
		DRAWLINE
		LOCAL:1 = 0
	ENDIF
	SELECTCASE LOCAL
		CASE 0
			PRINTFORM 【調教道具】　　　
			PRINTBUTTON "[100]表示切替", 100
			PRINTL 
		CASE 40
			PRINTFORM 【消耗品】　　　　
			PRINTBUTTON "[101]表示切替", 101
			PRINTL 
		CASE 60
			PRINTFORM 【素質アイテム】　
			PRINTBUTTON "[102]表示切替", 102
			PRINTL 
		CASE 70
			PRINTFORM 【薬品類】　　　　
			PRINTBUTTON "[103]表示切替", 103
			PRINTL 
	ENDSELECT
	SIF LOCAL < 40 && !GETBIT(FLAG:調教道具購入画面設定,0)
		CONTINUE
	SIF LOCAL >= 40 && LOCAL < 60 && !GETBIT(FLAG:調教道具購入画面設定,1)
		CONTINUE
	SIF LOCAL >= 60 && LOCAL < 70 && !GETBIT(FLAG:調教道具購入画面設定,2)
		CONTINUE
	SIF LOCAL >= 70 && !GETBIT(FLAG:調教道具購入画面設定,3)
		CONTINUE
	SELECTCASE TRAINITEM_SALEABLE(LOCAL)
		CASE -1
			CONTINUE
		CASE 0
			SETCOLOR COLOR("gray")
			SELECTCASE LOCAL
				CASE IS < 40
					PRINTFORM [{LOCAL,2}] %ITEMNAME:LOCAL,24,LEFT%%"(購入済み)",10,RIGHT%　
				CASE IS < 60
					PRINTFORM [{LOCAL,2}] %ITEMNAME:LOCAL+"(所持:"+@"{ITEM:LOCAL}"+")",24,LEFT%%"(所持限界)",10, RIGHT%　
				CASE IS < 70
					PRINTFORM [{LOCAL,2}] %ITEMNAME:LOCAL,24,LEFT%%"(習得済み)",10,RIGHT%　
				CASEELSE
					PRINTFORM [{LOCAL,2}] %ITEMNAME:LOCAL,24,LEFT%%"(対象不在)",10,RIGHT%　
			ENDSELECT
		CASE 1
			SIF MONEY < ITEMPRICE:LOCAL
				SETCOLOR COLOR("gray")
			IF LOCAL >= 40 && LOCAL < 60
				PRINTFORM [{LOCAL,2}] %ITEMNAME:LOCAL+"(所持:"+@"{ITEM:LOCAL}"+")",24,LEFT%%"￥"+@"{ITEMPRICE:LOCAL}",10, RIGHT%　
			ELSE
				PRINTFORM [{LOCAL,2}] %ITEMNAME:LOCAL,24,LEFT%%"￥"+@"{ITEMPRICE:LOCAL}",10, RIGHT%　
			ENDIF
	ENDSELECT
	RESETCOLOR
	SIF LOCAL:1 % 2 == 1
		PRINTL 
	LOCAL:1++
NEXT
SIF LOCAL:1 % 2
	PRINTL 
DRAWLINE
PRINTL [999] 戻る
$INPUT_LOOP
INPUT
LOCAL = RESULT
SELECTCASE LOCAL
	CASE 999
		REDRAW 1
		RETURN 0
	CASE 100, 101, 102, 103
		INVERTBIT FLAG:調教道具購入画面設定, LOCAL - 100
	CASE IS < 0, IS > 100
		CLEARLINE 1
		GOTO INPUT_LOOP
	CASEELSE
		IF TRAINITEM_SALEABLE(LOCAL) < 1
		ELSEIF MONEY < ITEMPRICE:LOCAL
			PRINTW お金が足りません
			CLEARLINE 2
			GOTO INPUT_LOOP
		ELSE
			SIF LOCAL < 70
				DRAWLINE
			SELECTCASE LOCAL
				;通常アイテム
				CASE IS < 40
					PRINTFORML 本当に%ITEMNAME:LOCAL%を購入しますか？
					CALL INPUT_YN,"購入する","やめる"
					IF RESULT == 0
						PRINTFORMW ＜%ITEMNAME:LOCAL%を購入しました＞
						ITEM:LOCAL += 1
						MONEY -= ITEMPRICE:LOCAL
					ELSE
						PRINTW ＜購入を取りやめました＞
					ENDIF
				;消耗品
				CASE IS < 60
					PRINTFORML %ITEMNAME:LOCAL%をいくつ買いますか？ (現在 {ITEM:LOCAL}個所持)
					CALL INPUT_MANY(0,MIN(MONEY/ITEMPRICE:LOCAL,999 - ITEM:LOCAL))
					IF RESULT == 0
						PRINTW ＜購入を取りやめました＞
					ELSEIF RESULT == 1
						PRINTFORMW ＜%ITEMNAME:LOCAL%を購入しました＞
					ELSE
						PRINTFORMW ＜%ITEMNAME:LOCAL%を{RESULT}個購入しました＞
					ENDIF
					ITEM:LOCAL += RESULT
					MONEY -= ITEMPRICE:LOCAL*RESULT
				CASE IS < 70
					PRINTFORML 本当に%ITEMNAME:LOCAL%を身につけますか？
					CALL INPUT_YN,"身につける","やめる"
					IF RESULT == 0
						PRINTFORMW ＜%ITEMNAME:LOCAL%を身につけました＞
						SELECTCASE LOCAL
							CASE 60
								TALENT:MASTER:汚れ無視 = 1
							CASE 61
								TALENT:MASTER:調合知識 = 1
							CASE 62
								TALENT:MASTER:禁断の知識 = 1
							CASE 63
								TALENT:MASTER:覚 = 1
							CASE 64
								TALENT:MASTER:触手使役術 = 1
						ENDSELECT
						MONEY -= ITEMPRICE:LOCAL
					ENDIF
				CASEELSE
					LINE:1 = LINECOUNT
					$USE_DRUG
					CLEARLINE LINECOUNT - LINE:1
					SELECTCASE ITEMNAME:LOCAL
						CASE "薬の材料(双)"
							LOCALS =  %ITEMNAME:LOCAL%:ふたなりになります
						CASE "薬の材料(消)"
							LOCALS =  %ITEMNAME:LOCAL%:ふたなりを消去します
						CASE "青いキャンディ"
							LOCALS =  %ITEMNAME:LOCAL%:母乳体質になります
						CASE "赤いキャンディ"
							LOCALS =  %ITEMNAME:LOCAL%:処女膜が再生します
						CASE "豊胸剤"
							LOCALS =  %ITEMNAME:LOCAL%:胸を大きくします
						CASE "縮胸剤"
							LOCALS =  %ITEMNAME:LOCAL%:胸を小さくします
						CASE "抑プロラクチン薬"
							LOCALS =  %ITEMNAME:LOCAL%:母乳が出なくなります
						CASE "３環系抗鬱薬"
							LOCALS =  %ITEMNAME:LOCAL%:お漏らし癖が治ります
						CASE "黄色のキャンディ"
							LOCALS =  %ITEMNAME:LOCAL%:強制的に卵を産ませます。悪魔によっては、卵からアイテムを入手できます。
						CASE "転生の秘薬"
							LOCALS =  %ITEMNAME:LOCAL%:人型でない悪魔を人の姿へと生まれ変わらせます
						CASE "虹色のキャンディ"
							LOCALS =  %ITEMNAME:LOCAL%:性別を逆転させます
						CASE "男の娘キャンディ"
							LOCALS =  %ITEMNAME:LOCAL%:たくましいあの人が男の娘に！かわいらしいあの子が男らしく！
						CASE "体型変化薬(ﾛﾘ)"
							LOCALS =  %ITEMNAME:LOCAL%:体型が小さくなります
						CASE "体型変化薬(ｱﾀﾞﾙﾄ)"
							LOCALS =  %ITEMNAME:LOCAL%:体型が大きくなります
						CASE "記憶消去薬"
							LOCALS =  %ITEMNAME:LOCAL%:調教の記憶を消去します
						CASE "排卵誘発剤"
							LOCALS =  %ITEMNAME:LOCAL%:一日だけ妊娠確率を上昇させます
						CASE "子宮内避妊結界"
							LOCALS = %ITEMNAME:LOCAL%:一日だけ膣射経験の増加を防ぎます
						CASE "野生のキャンディ"
							LOCALS = %ITEMNAME:LOCAL%:危険日に発情するようになります
						CASE "月のキャンディ"
							LOCALS = %ITEMNAME:LOCAL%:危険日が前後します
						CASE "浮気草の露"
							LOCALS = %ITEMNAME:LOCAL%:中出し時に自分以外への好感度を大幅に下げます
						CASE "元気になる薬"
							LOCALS = %ITEMNAME:LOCAL%:ストレスが増加しますが体力を回復することができます
					ENDSELECT
					;リストに使えるのがグローバルな変数だけなのでZを送る
					Z = LOCAL
					CALL INPUT_CHARA_LIST, @"%LOCALS%　価格:{ITEMPRICE:LOCAL}　所持金:￥{MONEY}", "USE_DRUG_LIST"
					IF RESULT == 1000
						CLEARLINE LINECOUNT - LINE
						RESTART
					ENDIF
					SELECTCASE ITEMNAME:LOCAL
						CASE "元気になる薬"
							;RESULT退避
							LOCAL:1 = RESULT
							PRINTL 使う個数を選んでください
							PRINTFORML %NAME:(LOCAL:1)%
							PRINTFORML 体力:{BASE:(LOCAL:1):体力}／{MAXBASE:(LOCAL:1):体力}
							PRINTFORML 単価:￥{ITEMPRICE:LOCAL}(現在の￥{MONEY})
							CALL INPUT_MANY(0, MIN((MAXBASE:(LOCAL:1):体力-BASE:(LOCAL:1):体力)/100+1, MONEY/ITEMPRICE:LOCAL))
							IF RESULT == 0
								PRINTFORMW %ITEMNAME:LOCAL%を使うのをやめた
							ELSE
								PRINTFORML ＜%NAME:(LOCAL:1)%の体力が回復した＞
								PRINTFORMW ＜%NAME:(LOCAL:1)%のストレスが増加した＞
								BASE:(LOCAL:1):体力 = MIN(MAXBASE:(LOCAL:1):体力, BASE:(LOCAL:1):体力 + 100 * RESULT)
								;BASE:LOCAL:気力 += MIN(MAXBASE:LOCAL:気力, BASE:LOCAL:気力+300 * RESULT)
								MONEY -= ITEMPRICE:LOCAL * RESULT
								CFLAG:(LOCAL:1):ストレス値 += 5 + RESULT / 5
							ENDIF
							;RESULTを戻しておく
							RESULT = LOCAL:1
						CASE "薬の材料(双)"
							PRINTFORMW ＜%CALLNAME:RESULT%はふたなりになった＞
							TALENT:RESULT:不思議な根 = 0
							TALENT:RESULT:具現 = 0
							TALENT:RESULT:ふたなり = 1
							CFLAG:RESULT:ストレス値 += 2
						CASE "薬の材料(消)"
							PRINTFORMW ＜%CALLNAME:RESULT%はふたなりではなくなった＞
							TALENT:RESULT:ふたなり = 0
							CFLAG:RESULT:ストレス値 += 2
						CASE "青いキャンディ"
							PRINTFORMW ＜%CALLNAME:RESULT%は母乳が出るようになった＞
							TALENT:RESULT:149 = 1
							CFLAG:RESULT:10 += 2
						CASE "赤いキャンディ"
							PRINTFORMW ＜%CALLNAME:RESULT%の処女膜が再生された＞
							TALENT:RESULT:再生処女 = 1
							CFLAG:RESULT:ストレス値 += 2
						CASE "豊胸剤"
							;絶壁→貧乳
							IF TALENT:RESULT:絶壁
								PRINTFORMW ＜%CALLNAME:RESULT%の胸がほんの少しだけ膨らんだ＞
								TALENT:RESULT:絶壁 = 0
								TALENT:RESULT:貧乳 = 1
							;貧乳→普乳
							ELSEIF TALENT:RESULT:貧乳
								PRINTFORMW ＜%CALLNAME:RESULT%の胸が人並みに大きくなった＞
								TALENT:RESULT:貧乳 = 0
							;普乳→巨乳
							ELSEIF TALENT:RESULT:巨乳 == 0
								PRINTFORMW ＜%CALLNAME:RESULT%の胸が豊満になった＞
								TALENT:RESULT:巨乳 = 1
							;巨乳→爆乳
							ELSE
								;小柄体型、小人体型
								IF TALENT:RESULT:小柄体型 || TALENT:RESULT:小人体型
									PRINTFORMW ＜%CALLNAME:RESULT%の胸が体に不釣合いなまでに大きくなった＞
								;それ以外
								ELSE
									PRINTFORMW ＜%CALLNAME:RESULT%の胸が溢れんばかりの大きさになった＞
								ENDIF
								TALENT:RESULT:巨乳 = 0
								TALENT:RESULT:爆乳 = 1
							ENDIF
							CFLAG:RESULT:ストレス値 += 2
						CASE "縮胸剤"
							;爆乳→爆乳
							IF TALENT:RESULT:爆乳 && MARK:RESULT:5 == 1
								PRINTFORMW ＜%CALLNAME:RESULT%の豊かすぎる胸が一回り小さくならなかった＞
							;爆乳→巨乳
							ELSEIF TALENT:RESULT:爆乳
								PRINTFORMW ＜%CALLNAME:RESULT%の豊かすぎる胸が一回り小さくなった＞
								TALENT:RESULT:爆乳 = 0
								TALENT:RESULT:巨乳 = 1
							;巨乳→普乳
							ELSEIF TALENT:RESULT:巨乳
								PRINTFORMW ＜%CALLNAME:RESULT%の胸が人並みに小さくなった＞
								TALENT:RESULT:巨乳 = 0
							;普乳→貧乳
							ELSEIF TALENT:RESULT:貧乳 == 0
								PRINTFORMW ＜%CALLNAME:RESULT%の胸が小さくなった＞
								TALENT:RESULT:貧乳 = 1
							;貧乳→絶壁
							ELSE
								PRINTFORMW ＜%CALLNAME:RESULT%の胸が極端に薄くなった＞
								TALENT:RESULT:貧乳 = 0
								TALENT:RESULT:絶壁 = 1
								IF TALENT:RESULT:母乳体質
									PRINTFORMW ＜%CALLNAME:RESULT%の母乳が出なくなった＞
									TALENT:RESULT:母乳体質 = 0
									CFLAG:RESULT:ストレス値 += 1
								ENDIF
							ENDIF
							MARK:RESULT:5 = 0
							CFLAG:RESULT:ストレス値 += 2
						CASE "抑プロラクチン薬"
							PRINTFORMW ＜%CALLNAME:RESULT%は母乳が出なくなった＞
							TALENT:RESULT:母乳体質 = 0
							CFLAG:RESULT:ストレス値 += 2
						CASE "３環系抗鬱薬"
							PRINTFORMW ＜%CALLNAME:RESULT%のお漏らし癖が治った＞
							TALENT:RESULT:おもらし癖 = 0
							EXP:RESULT:31 = 0
							CFLAG:RESULT:ストレス値 += 2
						CASE "黄色のキャンディ"
							CALL LAY_EGG, RESULT
						CASE "転生の秘薬"
							CFLAG:RESULT:ストレス値 += 2
							CALL USE_DRUG_80,RESULT
						CASE "虹色のキャンディ"
							CFLAG:RESULT:ストレス値 += 2
							CALL USE_DRUG_81,RESULT
						CASE "男の娘キャンディ"
							IF TALENT:RESULT:男の娘 == 0
								PRINTFORMW ＜%CALLNAME:RESULT%は可愛らしい男の娘になりました＞
								TALENT:RESULT:男の娘 = 1
							ELSE
								PRINTFORMW ＜%CALLNAME:RESULT%の顔と体は逞しくなりました＞
								TALENT:RESULT:男の娘 = 0
							ENDIF
						CASE "体型変化薬(ﾛﾘ)"
							;巨体→大柄
							IF TALENT:RESULT:巨体
								PRINTFORMW ＜%CALLNAME:RESULT%の体型が一回り小さくなった＞
								TALENT:RESULT:巨体 = 0
								TALENT:RESULT:大柄 = 1
							;大柄→普通
							ELSEIF TALENT:RESULT:大柄
								PRINTFORMW ＜%CALLNAME:RESULT%の体型が一般的な大きさになった＞
								TALENT:RESULT:大柄 = 0
							;普通→小柄
							ELSEIF TALENT:RESULT:小柄体型 == 0
								PRINTFORMW ＜%CALLNAME:RESULT%の体型が子供のような体型になった＞
								TALENT:RESULT:小柄体型 = 1
							ENDIF
							CFLAG:RESULT:ストレス値 += 2
						CASE "体型変化薬(ｱﾀﾞﾙﾄ)"
							;小柄→普通
							IF TALENT:RESULT:小柄体型
								PRINTFORMW ＜%CALLNAME:RESULT%の体型が人並みの大きさになった＞
								TALENT:RESULT:小柄体型 = 0
							;普通→大柄
							ELSEIF TALENT:RESULT:大柄 == 0
								PRINTFORMW ＜%CALLNAME:RESULT%の体型が一回り大きくなった＞
								TALENT:RESULT:大柄 = 1
							;大柄→巨体
							ELSEIF TALENT:RESULT:巨体 
								PRINTFORMW ＜%CALLNAME:RESULT%の体型が巨人のような体型になった＞
								TALENT:RESULT:巨体 = 0
								TALENT:RESULT:巨体 = 1
							ENDIF
							CFLAG:RESULT:ストレス値 += 2
						CASE "記憶消去薬"
							;処理及び効果に難点が色々あるので封印措置
							;	ADDCHARA NO:RESULT
							;	TARGET = CHARANUM-1
							;	SIF TALENT:RESULT:0
							;		TALENT:TARGET:0 = 1
							;	SIF TALENT:RESULT:1
							;		TALENT:TARGET:1 = 1
							;	SIF TALENT:RESULT:139
							;		TALENT:TARGET:139 = 1
							;	SIF TALENT:RESULT:149
							;		TALENT:TARGET:149 = 1
							;	EXP:TARGET:0 = EXP:RESULT:0
							;	EXP:TARGET:1 = EXP:RESULT:1
							;	EXP:TARGET:2 = EXP:RESULT:2
							;	EXP:TARGET:3 = EXP:RESULT:3
							;	EXP:TARGET:4 = EXP:RESULT:4
							;	EXP:TARGET:5 = EXP:RESULT:5
							;	EXP:TARGET:10 = EXP:RESULT:10
							;	EXP:TARGET:11 = EXP:RESULT:11
							;	EXP:TARGET:20 = EXP:RESULT:20
							;	EXP:TARGET:21 = EXP:RESULT:21
							;	EXP:TARGET:22 = EXP:RESULT:22
							;	EXP:TARGET:23 = EXP:RESULT:23
							;	EXP:TARGET:30 = EXP:RESULT:30
							;	EXP:TARGET:31 = EXP:RESULT:31
							;	EXP:TARGET:32 = EXP:RESULT:32
							;	EXP:TARGET:40 = EXP:RESULT:40
							;	EXP:TARGET:50 = EXP:RESULT:50
							;	EXP:TARGET:51 = EXP:RESULT:51
							;	EXP:TARGET:52 = EXP:RESULT:52
							;	EXP:TARGET:53 = EXP:RESULT:53
							;	EXP:TARGET:54 = EXP:RESULT:54
							;	EXP:TARGET:55 = EXP:RESULT:55
							;	EXP:TARGET:56 = EXP:RESULT:56
							;	EXP:TARGET:60 = EXP:RESULT:60
							;	EXP:TARGET:61 = EXP:RESULT:61
							;	EXP:TARGET:62 = EXP:RESULT:62
							;	EXP:TARGET:63 = EXP:RESULT:63
							;	EXP:TARGET:64 = EXP:RESULT:64
							;	EXP:TARGET:70 = EXP:RESULT:70
							;	ABL:TARGET:3 = ABL:RESULT:3
							;	ABL:TARGET:4 = ABL:RESULT:4
							;	ABL:TARGET:5 = ABL:RESULT:5
							;	ABL:TARGET:6 = ABL:RESULT:6
							;	PRINTFORMW ＜%CALLNAME:RESULT%は調教の記憶を失った＞
							;	DELCHARA RESULT
							;	TARGET = CHARANUM-1
							;	CALL CLOTHES_INITIALIZE
						CASE "排卵誘発剤"
							PRINTFORMW ＜%CALLNAME:RESULT%に排卵誘発剤を使った＞
							CFLAG:RESULT:排卵誘発剤 = 1
						CASE "子宮内避妊結界"
							PRINTFORMW ＜%CALLNAME:RESULT%に子宮内避妊結界を使った＞
							CFLAG:RESULT:子宮内避妊結界 = 1
						CASE "野生のキャンディ"
							PRINTFORMW ＜%CALLNAME:RESULT%は発情するようになった＞
							TALENT:RESULT:発情可 = 1
						CASE "月のキャンディ"
							PRINTFORMW ＜%CALLNAME:RESULT%の月経周期が１日ずれた＞
							IF FLAG:月齢ベクトル == 1
								CFLAG:RESULT:危険日 --
								SIF CFLAG:RESULT:危険日 < 0
									CFLAG:RESULT:危険日 = 15
							ELSE
								CFLAG:RESULT:危険日 ++
								SIF CFLAG:RESULT:危険日 > 15
									CFLAG:RESULT:危険日 = 0
							ENDIF
						CASE "浮気草の露"
							PRINTFORMW ＜%CALLNAME:RESULT%に浮気草の露を使った＞
							CFLAG:RESULT:浮気草の露 = 1
					ENDSELECT
					;忠誠度による崩壊防止措置を追加
					;崩壊防止措置
					IF CFLAG:RESULT:ストレス値 >= 100 && TALENT:RESULT:崩壊 == 0 && RESULT != MASTER
						IF 陥落(RESULT)
							IF (CFLAG:RESULT:ストレス値 -99) * 100 <= BASE:RESULT:忠誠度
								PRINTFORMW %CALLNAME:RESULT%は強くストレスを感じているようだ……
								PRINTFORMW %CALLNAME:RESULT%の忠誠度が{(CFLAG:RESULT:ストレス値 -99) * 100}減少した
								BASE:RESULT:忠誠度 -= (CFLAG:RESULT:ストレス値 -99) * 100
								CFLAG:RESULT:ストレス値 = 99
							ENDIF
						ELSE
							IF (CFLAG:RESULT:ストレス値 -99) * 500 <= BASE:RESULT:忠誠度
								PRINTFORMW %CALLNAME:RESULT%は強くストレスを感じているようだ……
								PRINTFORMW %CALLNAME:RESULT%の忠誠度が{(CFLAG:RESULT:ストレス値 -99) * 500}減少した
								BASE:RESULT:忠誠度 -= (CFLAG:RESULT:ストレス値 -99) * 500
								CFLAG:RESULT:ストレス値 = 99
							ENDIF
						ENDIF
					ENDIF
					SIF CFLAG:RESULT:10 >= 100 && TALENT:RESULT:9 == 0 && RESULT != MASTER
						CALL COLLAPSE_MIND_ITEM, RESULT
					MONEY -= ITEMPRICE:LOCAL
					SIF MONEY >= ITEMPRICE:LOCAL
						GOTO USE_DRUG
					PRINTW ＜金が足りなくなりました＞
				ENDSELECT
		ENDIF
ENDSELECT
CLEARLINE LINECOUNT - LINE
RESTART
@USE_DRUG_LIST
SIF USE_DRUGABLE(Z, COUNT)
	RETURN 1
RETURN 0
@TRAINITEM_SALEABLE, ARG
#FUNCTION
;販売条件のチェック
;戻り値は1が販売、0が購入済みなどの理由で購入不能、-1が販売リストにのらない
