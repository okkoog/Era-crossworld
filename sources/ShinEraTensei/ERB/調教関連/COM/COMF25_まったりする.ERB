;-------------------------------------------------
;まったりする
;コミュニケーション系コマンド、レベル3
;-------------------------------------------------
@ACT_COM25

PRINTL まったりする
TSTR:0 = まったりする
;CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
;消費体力、気力
DOWNBASE:TARGET:体力 += 15
DOWNBASE:TARGET:気力 += 15

SOURCE:TARGET:情愛 = 700


;-------------------------------------------------
;愛情経験追加
;-------------------------------------------------
;愛情経験
IF (TALENT:3 == 1 || TALENT:6 == 1) && ASSIPLAY == 0
;	PRINTS EXPNAME:23
;	PRINTL +1
	CALL ADDS_EXP("愛情経験", 1, TARGET)
;	PRINTFORML 愛情経験(主人)＋１
	CALL ADDS_EXP("愛情経験", 1, MASTER)
ENDIF

;依存度ベクトル
TFLAG:33 = 4

;依存度補正値(恋慕で1、親愛で2）
IF TALENT:3 && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF TALENT:6 && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF


RETURN 1

