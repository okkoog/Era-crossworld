;==========================================================
;@処女喪失
; 処女/再生処女を喪失する。
;<引数>
;	ARG  - 処女/再生処女を失うキャラのキャラ登録番号
;<戻り値>
;	なし
;==========================================================
@処女喪失, ARG = -1
;ARGがキャラ登録番号の範囲の場合何もせず戻る
SIF ARG < 0 && ARG >= CHARANUM
	RETURN

;処女喪失フラグ
IF TALENT:ARG:処女 == 1
	TALENT:ARG:処女 = 0
	CFLAG:ARG:処女喪失フラグ = 1
ENDIF
;再生処女喪失フラグ
IF TALENT:ARG:再生処女 == 1
	TALENT:ARG:再生処女 = 0
	CFLAG:ARG:再生処女喪失フラグ = 1
ENDIF

;==========================================================
;@処女喪失イベント
; 処女/再生処女を喪失する。
;<引数>
;	ARG  - 処女/再生処女を失ったキャラのキャラ登録番号
;	ARGS - 処女喪失の状況
;<戻り値>
;	なし
;==========================================================
@処女喪失イベント, ARG = -1, ARGS = ""
;ARGがキャラ登録番号の範囲の場合何もせず戻る
SIF ARG < 0 && ARG >= CHARANUM
	RETURN

IF CFLAG:ARG:処女喪失フラグ
	CFLAG:ARG:処女喪失フラグ = 0
	PRINTL 処女喪失
	SETCOLOR COLOR("red")
	IF ARGS == ""
		PRINTL 異常経験　処女喪失 + 2
	ELSE
		PRINTFORML 異常経験　処女喪失(%ARGS%) + 2
	ENDIF
	RESETCOLOR	
	EXP:ARG:異常経験 += 2
ELSEIF CFLAG:ARG:再生処女喪失フラグ
	CFLAG:ARG:再生処女喪失フラグ = 0
	PRINTL 再生処女喪失
ENDIF

