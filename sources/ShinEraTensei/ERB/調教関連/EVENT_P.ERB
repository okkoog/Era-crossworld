	;恋慕もしくは親愛
	SIF TALENT:ARG:3 || TALENT:ARG:6
		TIMES B ,0.90
	;淫乱もしくは娼婦
	SIF TALENT:ARG:4 || TALENT:ARG:7
		TIMES B , 0.40
	;服従もしくは隷属
