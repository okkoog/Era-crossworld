	PRINTS TALENTNAME:112
	PRINT ]
	PRINTFORMW ぐらいに大きくなった
	TALENT:ARG:111 = 0
	TALENT:ARG:112 = 1
ELSEIF TALENT:ARG:112 == 1
	MARK:ARG:5 = 1
ENDIF

;母乳出るようになる
