	IF 陥落(ARG)
		IF RESULTS == "恋慕"
			IF FAVORITE_1(ARG) == FINDCHARA_ID(CFLAG:ARG:父親の固有番号親)
				TIMES B , 0.01
			ELSE
				TIMES B , 0.60
			ENDIF
		ELSEIF RESULTS == "淫乱"
			TIMES B , 0.40
		ELSEIF RESULTS == "服従"
			IF FAVORITE_1(ARG) == FINDCHARA_ID(CFLAG:ARG:父親の固有番号親)
				TIMES B , 0.10
			ELSE
				TIMES B , 0.60
			ENDIF
		ENDIF
