@SHOPCOMABLE_171
LOCAL:1 = 0
FOR LOCAL,0,CHARANUM
	SIF (TALENT:LOCAL:妊娠 && CFLAG:LOCAL:出産予定日 - 2 <= DAY && LOCAL != MASTER) || TALENT:LOCAL:育児中 && LOCAL != MASTER
		LOCAL:1 += 1
NEXT
IF LOCAL:1 > 0 && FLAG:出産機能ONOFF == 1
	RESULTS = 育児室
	RETURN 1
ELSE
	RESULTS = ？？？？？
	RETURN 0
ENDIF

