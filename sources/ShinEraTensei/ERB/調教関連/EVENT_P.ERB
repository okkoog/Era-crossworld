;==========================================================
;@PREGNANCY_ABLE(ARG)
;ARGのキャラが妊娠可能な状態かどうかを返す
;<引数>
;	ARG = 妊娠可否チェック対象キャラの登録番号
;<戻り値>
;	0 = 妊娠不可能
;	1 = 妊娠可能
;==========================================================
@PREGNANCY_ABLE,ARG = -1
#FUNCTION
;以下の場合は妊娠しない
;・妊娠機能がOFF
;・対象が誰か分からない(ARGがキャラ登録番号の範囲外)
;・既に妊娠している
;・育児中
;・子宮内避妊結界使用中
;・出産予定日が設定されている
SIF FLAG:妊娠機能 == 0 || ARG < 0 || ARG >= CHARANUM || TALENT:ARG:妊娠 || TALENT:ARG:育児中 || CFLAG:ARG:子宮内避妊結界 || CFLAG:ARG:出産予定日
	RETURNF 0

IF FLAG:妊娠機能 == 1
	;女性、男の娘ともに妊娠可能
	SIF TALENT:ARG:オトコ == 0 || TALENT:ARG:男の娘
		RETURNF 1
ELSEIF FLAG:妊娠機能 == 2
	;女性のみ妊娠可能、男の娘は不可
	SIF TALENT:ARG:オトコ == 0
		RETURNF 1
ENDIF
RETURNF 0

;==========================================================
;@PREGNANCY_CHECK(ARG)
;ARGのキャラが妊娠したかを調べる
;<引数>
;	ARG   = 妊娠チェック対象キャラの登録番号
;	ARG:1 = イベント妊娠での父親の種類
;<戻り値>
;	0 = 妊娠していない
;	1 = 主人の中田氏で妊娠
;	2 = 助手の中田氏で妊娠
;	3 = 奴隷の中田氏で妊娠
;	4 = 顧客(NPC)の中田氏で妊娠
;	5 = 触手の中田氏で妊娠
;==========================================================
@PREGNANCY_CHECK,ARG, ARG:1 = 0
#LOCALSIZE 3
;LOCAL 妊娠判定用CFLAG変数の配列番号
;LOCAL:1 父親判定用の値

;一応妊娠可能か確認
IF !PREGNANCY_ABLE(ARG)
	;妊娠できない状態でARGがキャラ登録番号の範囲内の場合
	;妊娠判定の値をクリアして終了
	SIF 0 <= ARG && ARG < CHARANUM
		CALL CLEAR_PREGNANCY_DATERMINATION,ARG
	RETURN 0
ENDIF

FOR LOCAL:1, 1, 6
	;イベント妊娠チェック
	;イベントで確実に妊娠する場合は判定処理を飛ばす
	SIF ARG:1 == LOCAL:1
		GOTO PREGNANCY_PROCESS

	;チェックするフラグ設定
	SELECTCASE LOCAL:1
		CASE 1
			LOCAL = GETNUM(CFLAG, "主人の中出氏による妊娠判定")
		CASE 2
			SIF ASSI < 0
				CONTINUE
			LOCAL = GETNUM(CFLAG, "助手の中出氏による妊娠判定")
		CASE 3
			SIF TARGET < 0
				CONTINUE
			LOCAL = GETNUM(CFLAG, "奴隷の中出氏による妊娠判定")
		CASE 4
			LOCAL = GETNUM(CFLAG, "顧客の中出氏による妊娠判定")
		CASE 5
			LOCAL = GETNUM(CFLAG, "触手の中出氏による妊娠判定")
	ENDSELECT

	;確率処理(ここを抜けることで妊娠確定)
	;排卵剤の有無による定数設定
	LOCAL:2 = 1 + (CFLAG:ARG:排卵誘発剤 > 0)
	IF CFLAG:ARG:排卵誘発剤 == 0 && (危険日(ARG) == 0) 
		SIF RAND:100 >= MIN(50, CFLAG:ARG:LOCAL)
			CONTINUE
	ELSE
		SIF RAND:100 >= CFLAG:ARG:LOCAL*LOCAL:2 * ((危険日(ARG) > 0) + 1)
			CONTINUE
	ENDIF

$PREGNANCY_PROCESS
	;妊娠確定後の処理
	SIF 危険日(ARG) > 1
		CFLAG:ARG:発情妊娠 = 1
	CFLAG:ARG:出産予定日 = DAY + 6
	CFLAG:ARG:妊娠時の父親の判定 = LOCAL:1
	;妊娠確定したのでループを抜ける
		BREAK
NEXT
;フラグ初期化
CALL CLEAR_PREGNANCY_DATERMINATION, ARG

RETURN CFLAG:ARG:妊娠時の父親の判定

;==========================================================
;@CLEAR_PREGNANCY_FLAG
;妊娠判定用のフラグをクリアする。
;<引数>
;	ARG = -1(省略時):全員
;	      -2		:男の娘
