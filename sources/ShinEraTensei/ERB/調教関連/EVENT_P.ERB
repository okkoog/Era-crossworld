	PRINTFORMW %CALLNAME:ARG%は母乳が出るようになった
	PRINTFORMW 　
	TALENT:ARG:149 = 1
ENDIF


;ストレス値の処理
B = 95

;その他素質による補正
;気丈
SIF TALENT:ARG:12
	B -= 10
;無関心
SIF TALENT:ARG:21
	B -= 5
;感情乏しい
SIF TALENT:ARG:22
	B -= 10
;楽観的
SIF TALENT:ARG:25
	B -= 5
;悲観的
SIF TALENT:ARG:26
	B += 5
;貞操観念
SIF TALENT:ARG:30
	B += 10
;貞操無頓着
SIF TALENT:ARG:31
	B -= 10

;天使は基本的に妊娠バッチコイ
SIF STR:(ABL:ARG:種族) == "天使" && TALENT:ARG:オトコ == 0
	B -= 30
;でもソドミーな結果妊娠とか受け入れがたい
;堕ちてたら無効
SIF STR:(ABL:ARG:種族) == "天使" && TALENT:ARG:オトコ && TALENT:ARG:堕天使 == 0
	B += 50

;妊娠した回数だけ減少
SIF CFLAG:ARG:妊娠回数 > 0
	B -= MIN(30,CFLAG:ARG:妊娠回数)
SIF B < 0
	B = 0


;反発刻印の2乗×10%増加
B = B * (100+POWER(MARK:ARG:反発刻印,2)*10) / 100
