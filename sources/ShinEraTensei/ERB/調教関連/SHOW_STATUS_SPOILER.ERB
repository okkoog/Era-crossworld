;============================================================================
;ネタバレっぽい要素をステータス画面に表示する
;============================================================================

;============================================================================
;表示用の汎用関数
;条件に合致している場合とそうでない場合で色を変える
;そもそも表示するかどうかのチェックも含めて統合
;ARGS:0 表示文字列, ARG:0 達成条件, ARG:1 0=通常 1=経験等一度超えると取り返しが付かない物
;
;返り値 達成条件を満たしていれば1, それ以外の場合は0
;表示の時に
;============================================================================
@SPOILER_PRINT_FLAG( ARGS:0, ARG:0, ARG:1=0)
#FUNCTION
#LOCALSIZE 10

LOCAL:0 = GETCOLOR()
LOCAL:1 = 0xFFFFFF
LOCAL:2 = 0x444444
LOCAL:3 = 0xFFFF00
LOCAL:4 = 0x440000
	
;達成条件によって色を変える
IF ARG:0
	;達成
	SETCOLOR LOCAL:(ARG:1 * 2 + 1)
	LOCAL:9 = 1
ELSE
	;未達成
	SETCOLOR LOCAL:(ARG:1 * 2 + 2)
	LOCAL:9 = 0
ENDIF
PRINTFORM %ARGS:0% 
SETCOLOR LOCAL:0
RETURNF LOCAL:9

;============================================================================
;売却条件の達成状況表示
;TALENTに対象キャラクターが設定されている前提
;============================================================================
@SPOILER_PRINT_SELL
#LOCALSIZE 5

IF CFLAG:売却可能 < 2
	;売却条件の表示
	IF CFLAG:売却可能 == 0
		;基礎条件
		PRINT 売却条件： 
		LOCAL:0 = SPOILER_PRINT_FLAG("従順+欲望6 ", (ABL:従順+ABL:欲望)>=6, 0)
		LOCAL:1 = 1
		IF ((TALENT:11 && TALENT:5 == 0 && TALENT:8 == 0) || TALENT:12)
			LOCAL:0 = SPOILER_PRINT_FLAG("従順4 ", (ABL:従順>=4), 0) && LOCAL:0
			LOCAL:1 += 1
		ENDIF
		IF (TALENT:20 || TALENT:32 || TALENT:34)
			LOCAL:0 = SPOILER_PRINT_FLAG("欲望4 ", (ABL:欲望>=4), 0) && LOCAL:0
			LOCAL:1 += 1
		ENDIF
		
		;IF LOCAL:0
		;	CALLF SPOILER_PRINT_FLAG("(OK)",1)
		;ELSE
		;	CALLF SPOILER_PRINT_FLAG(@"({LOCAL:0}/{LOCAL:1})",0)
		;ENDIF
		
		PRINTL
		;追加条件
		PRINT 追加条件： 
		LOCAL:2 =0
		LOCAL:2 += SPOILER_PRINT_FLAG("感覚合計8 ",  ABL:3+ABL:4+ABL:5+ABL:6 >= 8)
		LOCAL:2 += SPOILER_PRINT_FLAG("感覚合計13 ",  ABL:3+ABL:4+ABL:5+ABL:6 >= 13)
		LOCAL:2 += SPOILER_PRINT_FLAG("従順4 ",  ABL:従順 >= 4)
		LOCAL:2 += SPOILER_PRINT_FLAG("欲望4 ",  ABL:欲望 >= 4)
		LOCAL:2 += SPOILER_PRINT_FLAG("技巧2+奉仕精神2 ", ABL:技巧 >= 2 && ABL:奉仕精神 >= 2)
		LOCAL:2 += SPOILER_PRINT_FLAG("技巧4+奉仕精神4 ", ABL:技巧 >= 4 && ABL:奉仕精神 >= 4)
		LOCAL:2 += SPOILER_PRINT_FLAG("露出3+自慰中毒 ",  ABL:露出癖 >= 3 && ABL:自慰中毒)
		PRINTL
		PRINT 　　　　　 
		LOCAL:2 += SPOILER_PRINT_FLAG("マゾっ気3 ",  ABL:マゾっ気 >= 3)
		LOCAL:2 += SPOILER_PRINT_FLAG("精液中毒 ",  ABL:精液中毒)
		LOCAL:2 += SPOILER_PRINT_FLAG("獣姦中毒 ",  ABL:獣姦中毒)
		;実際の判定はＢＬっ気3+レズ中毒でもいいけど、それは珍しい状況なので表記としてはこうする
		IF IS_MALE(TARGET)
			LOCAL:2 += SPOILER_PRINT_FLAG("ＢＬっ気3+中毒",  (ABL:レズっ気 >= 3 && ABL:レズ中毒) || (ABL:ＢＬっ気 >= 3 && ABL:ＢＬ中毒))
		ELSE
			LOCAL:2 += SPOILER_PRINT_FLAG("レズっ気3+中毒",  (ABL:レズっ気 >= 3 && ABL:レズ中毒) || (ABL:ＢＬっ気 >= 3 && ABL:ＢＬ中毒))
		ENDIF
		LOCAL:2 += SPOILER_PRINT_FLAG("料理2+歌唱2 ",  ABL:料理技能 >= 2 || ABL:歌唱技能 >= 2)
		LOCAL:2 += SPOILER_PRINT_FLAG("屈服3+快楽3 ",  MARK:屈服刻印 >= 3 && MARK:快楽刻印 >= 3)
		LOCAL:2 += SPOILER_PRINT_FLAG("屈服3+苦痛3 ",  MARK:屈服刻印 >= 3 && MARK:苦痛刻印 >= 3)
		
		LOCAL:3 = MIN(6,CSVBASE(NO:TARGET,GETNUM(BASE,"LV"),0)/10 + (ABL:種族 == 0))
		IF LOCAL:2 > LOCAL:3
			CALLF SPOILER_PRINT_FLAG("(OK)",1)
		ELSE
			CALLF SPOILER_PRINT_FLAG(@"({LOCAL:2}/{LOCAL:3+1})",0)
		ENDIF
		PRINTL
	ENDIF

	;助手条件の表示
	;実判定は素質オトコを見ているけど、後々のためIS_MALEを使う
	PRINT 助手条件： 
	LOCAL:3 = SPOILER_PRINT_FLAG(@"売却可能 ", CFLAG:売却可能==1)
	
	LOCAL:3  = ABL:0+ABL:1+ABL:2+(IS_MALE(TARGET) ? ABL:ＢＬっ気 # ABL:レズっ気)
	LOCALS = (OK)
	SIF LOCAL:3<12
		LOCALS = ({LOCAL:3}/12)
	
	;リアル
	IF IS_MALE(TARGET)
		CALLF SPOILER_PRINT_FLAG(@"従順+欲望+技巧+ＢＬっ気 %LOCALS%", LOCAL:3>=12)
	ELSE
		CALLF SPOILER_PRINT_FLAG(@"従順+欲望+技巧+レズっ気 %LOCALS%", LOCAL:3>=12)
	ENDIF
	
	PRINTL
	DRAWLINE
ELSE
ENDIF	
RETURN

;============================================================================
;陥落条件の達成状況表示
;TALENTに対象キャラクターが設定されている前提
;依存度の達成状況だけはサードアイが無いとわからないようにした
;（条件表を見る代わりというつもりなので、攻略を有利になってしまうと良くないので）
;異常経験を少なく保つなど、一度超えると元に戻せない高難度条件は色を変えて表示。赤字があると達成不可
;陥落はさせられるけど上位に行けない場合も色変えた方がいいかも
;============================================================================
@SPOILER_PRINT_FALLTALENT
#LOCALSIZE 1

	;同性愛の経験処理は現在の性別と関係してないけど、表記としてはわかりやすいようにこうしておく
	IF IS_MALE(TARGET)
		LOCALS = ＢＬ
	ELSE
		LOCALS = レズ
	ENDIF

IF TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0 && TALENT:9 == 0
	;陥落素質がない状態（３通りの取得条件を表示）
	;恋慕
	PRINT 恋慕条件： 
	CALLF SPOILER_PRINT_FLAG("従順3 ", ABL:従順 >= 3)
	CALLF SPOILER_PRINT_FLAG("奉仕精神3 ", ABL:奉仕精神 >= 3)
	CALLF SPOILER_PRINT_FLAG("屈服刻印3 ", MARK:屈服刻印 == 3)
	CALLF SPOILER_PRINT_FLAG("反発刻印0 ", MARK:反発刻印 == 0)
	CALLF SPOILER_PRINT_FLAG("奉仕快楽経験200 ", EXP:奉仕快楽経験 >= 200)
	CALLF SPOILER_PRINT_FLAG("獲得した異常経験2未満", EXP:異常経験 - CFLAG:初期異常経験 < 2, 1)
	IF (TALENT:MASTER:覚)
		LOCAL:0 = SPOILER_PRINT_FLAG("依存度1000以上", CFLAG:依存度 >= 1000)
	ELSE
		PRINT 依存度1000以上?
	ENDIF
	PRINTL
	;淫乱
	;@EVENTCHECK_Tのコメントには同性愛経験2000というのがあるけど実装されていない
	PRINT 淫乱条件： 
	CALLF SPOILER_PRINT_FLAG("欲望3 ", ABL:欲望 >= 3)
	CALLF SPOILER_PRINT_FLAG("快楽刻印3 ", MARK:快楽刻印 == 3)
	CALLF SPOILER_PRINT_FLAG("屈服刻印3 ", MARK:屈服刻印 == 3)
	CALLF SPOILER_PRINT_FLAG("反発刻印0 ", MARK:反発刻印 == 0)
	CALLF SPOILER_PRINT_FLAG("感覚合計10以上 ", ABL:3+ABL:4+ABL:5+ABL:6 >= 10)
	CALLF SPOILER_PRINT_FLAG("絶頂経験50 ", EXP:絶頂経験 >= 50)
	PRINTL
	PRINT 　　　　　 
	CALLF SPOILER_PRINT_FLAG(@"(異常経験3以上 もしくは 異常経験1以上+%LOCALS%経験1000)", (EXP:異常経験 >= 3)||(EXP:異常経験 >= 1 && (EXP:40 >= 1000 || EXP:41 >= 1000)))
	PRINTL
	;服従
	PRINT 服従条件： 
	CALLF SPOILER_PRINT_FLAG("従順3 ", ABL:従順 >= 3)
	CALLF SPOILER_PRINT_FLAG("マゾっ気3 ", ABL:マゾっ気 >= 3)
	CALLF SPOILER_PRINT_FLAG("屈服刻印3 ", MARK:屈服刻印 == 3)
	CALLF SPOILER_PRINT_FLAG("反発刻印0 ", MARK:反発刻印 == 0)
	CALLF SPOILER_PRINT_FLAG("感覚合計10未満 ", ABL:3+ABL:4+ABL:5+ABL:6 < 10, 1)
	CALLF SPOILER_PRINT_FLAG("苦痛快楽経験+緊縛経験200以上 ", EXP:苦痛快楽経験+EXP:緊縛経験 >= 200)
	PRINTL
	PRINT 　　　　　 
	CALLF SPOILER_PRINT_FLAG("異常経験2以上", EXP:異常経験 >= 2)	
	IF (TALENT:MASTER:覚)
		CALLF SPOILER_PRINT_FLAG("依存度-1000以下", -CFLAG:依存度 >= 1000)
	ELSE
		PRINT 依存度1000以下?
	ENDIF
	PRINTL
	DRAWLINE
ELSEIF TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0 && TALENT:9 == 0
	;上位陥落素質への条件表示
	IF TALENT:恋慕
		PRINT 親愛条件： 
		CALLF SPOILER_PRINT_FLAG("従順5 ", ABL:従順 >= 5)
		CALLF SPOILER_PRINT_FLAG("奉仕精神5 ", ABL:奉仕精神 >= 5)
		CALLF SPOILER_PRINT_FLAG("反発刻印0 ", MARK:反発刻印 == 0)
		CALLF SPOILER_PRINT_FLAG("愛情経験200 ", EXP:愛情経験 >= 200)
		CALLF SPOILER_PRINT_FLAG("奉仕快楽経験400 ", EXP:奉仕快楽経験 >= 400)
		CALLF SPOILER_PRINT_FLAG("獲得した異常経験5未満", EXP:異常経験- CFLAG:初期異常経験 < 5, 1)
		IF (TALENT:MASTER:覚)
			CALLF SPOILER_PRINT_FLAG("依存度3000以上", CFLAG:依存度 >= 3000)
		ELSE
			PRINT 依存度3000以上?
		ENDIF
		PRINTL
		DRAWLINE
	ELSEIF TALENT:淫乱
		PRINT 娼婦条件： 
		CALLF SPOILER_PRINT_FLAG("欲望5 ", ABL:欲望 >= 5)
		CALLF SPOILER_PRINT_FLAG("感覚合計20以上 ", ABL:3+ABL:4+ABL:5+ABL:6 >= 20)
		CALLF SPOILER_PRINT_FLAG("反発刻印0 ", MARK:反発刻印 == 0)
		CALLF SPOILER_PRINT_FLAG("絶頂経験200 ", EXP:絶頂経験 >= 200)
		PRINTL
		PRINT 　　　　　 
		CALLF SPOILER_PRINT_FLAG(@"(異常経験6以上、異常経験4以上+%LOCALS%2000、異常経験3以上+%LOCALS%経験3000　のどれか)", (EXP:異常経験 >= 6)||(EXP:異常経験 >= 4 && (EXP:40 >= 2000 || EXP:41 >= 2000))||(EXP:異常経験 >= 3 && (EXP:40 >= 3000 || EXP:41 >= 3000)) )
		PRINTL
		DRAWLINE
	ELSEIF TALENT:服従
		;@EVENTCHECK_Tのコメントにはレズ経験もしくはＢＬ経験1500未満というのあるけど実装されていない
		PRINT 隷属条件： 
		CALLF SPOILER_PRINT_FLAG("従順5 ", ABL:従順 >= 5)
		CALLF SPOILER_PRINT_FLAG("マゾっ気5 ", ABL:マゾっ気 >= 5)
		CALLF SPOILER_PRINT_FLAG("感覚合計15未満 ", ABL:3+ABL:4+ABL:5+ABL:6 < 15, 1)
		CALLF SPOILER_PRINT_FLAG("反発刻印0 ", MARK:反発刻印 == 0)
		CALLF SPOILER_PRINT_FLAG("苦痛快楽経験+緊縛経験500以上 ", EXP:苦痛快楽経験+EXP:緊縛経験 >= 500)
		PRINTL
		PRINT 　　　　　 
		CALLF SPOILER_PRINT_FLAG("異常経験5以上", EXP:異常経験 >= 5)	
		IF (TALENT:MASTER:覚)
			CALLF SPOILER_PRINT_FLAG("依存度-3000以下", -CFLAG:依存度 >= 3000)
		ELSE
			PRINT 依存度3000以下?
		ENDIF
		PRINTL
		DRAWLINE
	ENDIF
ENDIF
RETURN
