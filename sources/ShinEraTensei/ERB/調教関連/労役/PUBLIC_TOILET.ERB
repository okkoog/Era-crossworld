;	Edit	Date			Author					Reason
;	001		20xx/xx/xx		----					新規作成
;	002		2010/1/12		P						ペルソナの経験値取得処理の修正
;	003		2011/09/08		黒天					本番行為での処女(再生処女)喪失処理を関数を呼ぶように修正
;													ＮＴＲイベントで一部の処理の対象がACTORではなくLOCALになっていたのを修正
;	004		2012/09/22		ネトリス				報告の設定変更を追加、ＮＴＲを整理整頓、便器を設置するときに毎回選択ページの最初に戻らないように
;													地の分に加筆
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;公衆便所に必要な処理置き場
@MANAGEMENT_PUBLIC_TOILET,ARG
	VARSET LOCAL , 0
	;客入りを計算
	;LOCAL:2 = 客入り
	;店舗の人気10につき一人訪れるかどうかの判定を行う
	LOCAL:1 = MAX(1,店舗("人気",ARG)/10)
	LOCAL:2 = 0
	;店の規模が小さいフラグ
	LOCAL:3 = 0
	;設置している便器数
	LOCAL:4 = 0
	
	;総売上
	LOCAL:6 = 0
	;平均成功度
	LOCAL:7 = 0
	;合計人数判定用
	LOCAL:8 = 0
	;働いた人数判定
	LOCAL:10 = 0
	;寝取り趣味の客フラグ
	LOCAL:14 = 0
	;便器誘惑度別枠
	LOCAL:15 = 0
	;マネジメント数
	LOCAL:16 = 0
	
	FOR LOCAL,0,MAX(1,(店舗("人気",ARG) + 店舗("宣伝効果",ARG))/10)
		SIF RAND:2 == 0
			LOCAL:2 += 1
	NEXT
	SIF RAND:10 < 店舗("人気",ARG) + 店舗("宣伝効果",ARG)%10
		LOCAL:2 += 1
	;PRINTFORML 個人以外の来客数は{LOCAL:2}人
	IF LOCAL:2 > 店舗("規模",ARG)
		LOCAL:2 = 店舗("規模",ARG)
		LOCAL:3 = 1
	ENDIF
	;PRINTFORML 個人以外の来客数は{LOCAL:2}人になった
	
	VARSET C , -1
	FOR LOCAL,0,CHARANUM
		IF CFLAG:LOCAL:労役フラグ == 10+ARG
			;未調教陥落フラグを折る
			CFLAG:LOCAL:被調教回数  += 1
			CFLAG:LOCAL:便器使用予定人数 = CFLAG:LOCAL:便器人気/25
			SIF RAND:25 < CFLAG:LOCAL:便器人気%25
				CFLAG:LOCAL:便器使用予定人数 += 1
			;PRINTFORML %CALLNAME:LOCAL%を個人的に使いに来たのは{CFLAG:LOCAL:便器使用予定人数}ニンです
			IF CFLAG:LOCAL:便器使用予定人数 > 店舗("規模",ARG) - LOCAL:8 - LOCAL:2
				CFLAG:LOCAL:便器使用予定人数 = 店舗("規模",ARG) - LOCAL:8 - LOCAL:2
				LOCAL:3 = 1
			ENDIF
			;PRINTFORML %CALLNAME:LOCAL%を個人的に使いに来たのは{CFLAG:LOCAL:便器使用予定人数}人になりました
			
			LOCAL:8 += CFLAG:LOCAL:便器使用予定人数
			C:(LOCAL:4) = LOCAL
			LOCAL:4 += 1
		ENDIF
	NEXT
	IF LOCAL:4 == 0
		PRINTW 肉便器を一人も設置していないため、利用者は誰も来なかった
		GOTO TOILET_END
	ENDIF
	C:(LOCAL:4) = 看板便器(ARG)
	;PRINTFORML 看板便器は%CALLNAME:(C:(LOCAL:4))%です
	;PRINTFORML 合計{LOCAL:2}+{LOCAL:8}人を割り振ります
	FOR LOCAL,0,LOCAL:2
		COUNT = (C:(RAND:(LOCAL:4+1)))
		;PRINTFORML %CALLNAME:COUNT%
		;CFLAG:(C:(RAND:(LOCAL:4+1))):便器使用予定人数 ++
		CFLAG:COUNT:便器使用予定人数 += 1
	NEXT
	
	;キャラ一人一人について結果を計算
	FOR LOCAL,0,CHARANUM
		SIF CFLAG:LOCAL:労役フラグ != 10+ARG
			CONTINUE
		;PRINTFORML %CALLNAME:LOCAL%を{CFLAG:LOCAL:便器使用予定人数}人使います
		PALAM:LOCAL:潤滑 = 1000
		LOCAL:9 = 0
		LOCAL:14 = 0
		LOCAL:16 = 0
		FOR LOCAL:1,0,CFLAG:LOCAL:便器使用予定人数
			LOCAL:11 = 0

			IF CFLAG:LOCAL:個別性的サービス& 8
				LOCAL:13 = 1+((便器誘惑度(LOCAL,LOCAL:14) + RAND:(便器誘惑度(LOCAL,LOCAL:14)))/20)
				LOCAL:15 = 便器誘惑度(LOCAL,LOCAL:14)
				FOR LOCAL:5,0,LOCAL:13					
					IF CFLAG:LOCAL:フェラ価格 * (40 + LOCAL:11*60) <= LOCAL:15/2 + RAND:(LOCAL:15)
						;とりあえず回数増える
						CFLAG:LOCAL:フェラ回数 += 1
						LOCAL:11 += 1
					ELSE
						BREAK
					ENDIF
				NEXT
				;フェラのソースをまとめて追加
				SOURCE:LOCAL:4 = 100 * LOCAL:11
				SOURCE:LOCAL:5 = 300 * LOCAL:11
				SOURCE:LOCAL:6 = 150 * LOCAL:11
				SOURCE:LOCAL:14 = 700 * LOCAL:11
				SOURCE:LOCAL:17 = 200 * LOCAL:11
				SOURCE:LOCAL:18 = 200 * LOCAL:11
				CALL SOURCE_MANAGEMENT_CHECK,LOCAL
				CALL CUP_MANAGEMENT_T,LOCAL
				IF LOCAL:11
					LOCAL:16 += 1
					CALL フェラ_便器_MANAGEMENT,LOCAL
					LOCAL:9 += RESULT
				ENDIF
			ENDIF
			LOCAL:11 = 0
			LOCAL:12 = 0
			IF TALENT:LOCAL:オトコ == 0 && CFLAG:LOCAL:個別性的サービス & 16
				LOCAL:13 = 1+((便器誘惑度(LOCAL,LOCAL:14) + RAND:(便器誘惑度(LOCAL,LOCAL:14)))/20)
				LOCAL:15 = 便器誘惑度(LOCAL,LOCAL:14)
				CALL 本番_便器_MANAGEMENT_SOURCE,LOCAL
				FOR LOCAL:5,0,LOCAL:13
					IF CFLAG:LOCAL:本番価格 * (20 + LOCAL:11*30) + CFLAG:LOCAL:処女価格 * TALENT:LOCAL:再生処女 * 2  + CFLAG:LOCAL:処女価格 * TALENT:LOCAL:処女 * 1 <= LOCAL:15/2 + RAND:(LOCAL:15) + TALENT:LOCAL:処女 * 25  + TALENT:LOCAL:再生処女 * 5
						CALL 本番_便器_MANAGEMENT_FOR,LOCAL
						LOCAL:11 += 1
						IF CFLAG:LOCAL:個別性的サービス& 64
							IF CFLAG:LOCAL:中出し価格 * (1 + LOCAL:12*6) <= LOCAL:15/2 + RAND:(LOCAL:15)
								;とりあえず回数増える
								CFLAG:LOCAL:中出し回数 += 1
								SIF TALENT:LOCAL:妊娠 == 0
									CALL SAMEN_SHOOT_SOURCE_MANAGEMENT,LOCAL
								LOCAL:12 += 1
							ENDIF
						ENDIF
					ELSE
						BREAK
					ENDIF
				NEXT
				;本番のソースの残りを追加
				SOURCE:LOCAL:4 += 150 * LOCAL:11
				SOURCE:LOCAL:9 += 150 * LOCAL:11
				SOURCE:LOCAL:13 += 70 * LOCAL:11
				SOURCE:LOCAL:18 += 300 * LOCAL:11
				;セックス中毒を見る
				IF ABL:LOCAL:18 == 1
					TIMES SOURCE:LOCAL:9 , 0.00
				ELSEIF ABL:LOCAL:18 == 2
					TIMES SOURCE:LOCAL:9 , 0.30
				ELSEIF ABL:LOCAL:18 == 3
					TIMES SOURCE:LOCAL:9 , 0.60
				ELSEIF ABL:LOCAL:18 == 4
					TIMES SOURCE:LOCAL:9 , 0.90
				ELSEIF ABL:LOCAL:18 == 5
					TIMES SOURCE:LOCAL:9 , 1.20
				ELSEIF ABL:LOCAL:18 == 6
					TIMES SOURCE:LOCAL:9 , 1.50
				ELSEIF ABL:LOCAL:18 == 7
					TIMES SOURCE:LOCAL:9 , 1.80
				ELSEIF ABL:LOCAL:18 == 8
					TIMES SOURCE:LOCAL:9 , 2.30
				ELSEIF ABL:LOCAL:18 == 9
					TIMES SOURCE:LOCAL:9 , 3.00
				ELSEIF ABL:LOCAL:18 >= 10
					TIMES SOURCE:LOCAL:9 , 5.00
				ENDIF
				CALL SOURCE_MANAGEMENT_CHECK,LOCAL
				CALL CUP_MANAGEMENT_T,LOCAL
			    IF LOCAL:11
					LOCAL:16 += 1
					CALL 本番_便器_MANAGEMENT,LOCAL
					LOCAL:9 += RESULT
				ENDIF

				IF LOCAL:12
					LOCAL:16 += 1
					CALL 中出し_便器_MANAGEMENT,LOCAL
					LOCAL:9 += RESULT
				ENDIF
			ENDIF
			LOCAL:11 = 0
			IF CFLAG:LOCAL:個別性的サービス & 32
				LOCAL:13 = 1+((便器誘惑度(LOCAL,LOCAL:14) + RAND:(便器誘惑度(LOCAL,LOCAL:14)))/20)
				LOCAL:15 = 便器誘惑度(LOCAL,LOCAL:14)
				CALL アナル_便器_MANAGEMENT_SOURCE,LOCAL
				FOR LOCAL:5,0,LOCAL:13
					IF CFLAG:LOCAL:アナル価格 * (20 + LOCAL:11*30) <= LOCAL:15/2 + RAND:(LOCAL:15)
						CALL アナル_便器_MANAGEMENT_FOR,LOCAL
						LOCAL:11 += 1
					ELSE
						BREAK
					ENDIF
				NEXT
				;アナルのソースの残りを追加
				SOURCE:LOCAL:4 = 100 * LOCAL:11
				SOURCE:LOCAL:9 = 200 * LOCAL:11
				SOURCE:LOCAL:13 = 60 * LOCAL:11
				SOURCE:LOCAL:17 = 200 * LOCAL:11
				SOURCE:LOCAL:18 = 500 * LOCAL:11
				;セックス中毒を見る
				IF ABL:LOCAL:18 == 1
					TIMES SOURCE:LOCAL:9 , 0.00
				ELSEIF ABL:LOCAL:18 == 2
					TIMES SOURCE:LOCAL:9 , 0.30
				ELSEIF ABL:LOCAL:18 == 3
					TIMES SOURCE:LOCAL:9 , 0.60
				ELSEIF ABL:LOCAL:18 == 4
					TIMES SOURCE:LOCAL:9 , 0.90
				ELSEIF ABL:LOCAL:18 == 5
					TIMES SOURCE:LOCAL:9 , 1.20
				ELSEIF ABL:LOCAL:18 == 6
					TIMES SOURCE:LOCAL:9 , 1.50
				ELSEIF ABL:LOCAL:18 == 7
					TIMES SOURCE:LOCAL:9 , 1.80
				ELSEIF ABL:LOCAL:18 == 8
					TIMES SOURCE:LOCAL:9 , 2.30
				ELSEIF ABL:LOCAL:18 == 9
					TIMES SOURCE:LOCAL:9 , 3.00
				ELSEIF ABL:LOCAL:18 >= 10
					TIMES SOURCE:LOCAL:9 , 5.00
				ENDIF
				CALL SOURCE_MANAGEMENT_CHECK,LOCAL
				CALL CUP_MANAGEMENT_T,LOCAL
				IF LOCAL:11
					LOCAL:16 += 1
					CALL アナル_便器_MANAGEMENT,LOCAL
					LOCAL:9 += RESULT
				ENDIF
			ENDIF
			SIF BASE:LOCAL:体力 <= (CFLAG:LOCAL:フェラ回数*10 + CFLAG:LOCAL:本番回数*15 + CFLAG:LOCAL:アナル回数*25 + CFLAG:LOCAL:中出し回数*5)
				BREAK
			
		NEXT
		;成功度(使われなかったら-1)
		IF CFLAG:LOCAL:中出し回数 + CFLAG:LOCAL:フェラ回数 + CFLAG:LOCAL:本番回数 + CFLAG:LOCAL:アナル回数
			CFLAG:LOCAL:労役成功度 = LOCAL:9 / LOCAL:16
			LOCAL:10 += 1
			LOCAL:7 += CFLAG:LOCAL:労役成功度
		ELSE
			CFLAG:LOCAL:労役成功度 = -1
		ENDIF
		
		;妊娠用
		IF CFLAG:LOCAL:108 == 0
			SIF TALENT:LOCAL:オトコ == 0
				CFLAG:LOCAL:105 += CFLAG:LOCAL:中出し回数
			SIF TALENT:LOCAL:オトコ && TALENT:LOCAL:男の娘
				CFLAG:LOCAL:105 += CFLAG:LOCAL:アナル回数
		ENDIF
		
		;ストレス増加
		LOCAL:9 = CFLAG:LOCAL:フェラ回数 + CFLAG:LOCAL:本番回数*2 + CFLAG:LOCAL:アナル回数*2 + CFLAG:LOCAL:中出し回数*5
		LOCAL:9 *= MAX(0,3-陥落(LOCAL) *2)
		LOCAL:9 /= 1+ABL:LOCAL:従順+ABL:LOCAL:欲望+ABL:LOCAL:奉仕精神+ABL:LOCAL:マゾっ気
		CFLAG:LOCAL:ストレス増加値 = LOCAL:9
		
		SIF CFLAG:LOCAL:労役成功度 == -1
			CONTINUE
		;メッセージ表示
		SIF FLAG:公衆便所報告設定 < 2
			CALL WORK_MESSAGE_TOILET,LOCAL
		PRINTFORML %CALLNAME:LOCAL%の労役結果
		
		SIF CFLAG:LOCAL:便器使用予定人数
			PRINTFORML 使ってもらった人数：{CFLAG:LOCAL:便器使用予定人数}人　　成功度　{CFLAG:LOCAL:労役成功度}％
		;回数の表示
		CFLAG:LOCAL:個別売り上げ += CFLAG:LOCAL:フェラ回数 * CFLAG:LOCAL:フェラ価格
		CFLAG:LOCAL:個別売り上げ += CFLAG:LOCAL:本番回数 * CFLAG:LOCAL:本番価格
		CFLAG:LOCAL:個別売り上げ += CFLAG:LOCAL:アナル回数 * CFLAG:LOCAL:アナル価格
		CFLAG:LOCAL:個別売り上げ += CFLAG:LOCAL:中出し回数 * CFLAG:LOCAL:中出し価格
		IF FLAG:公衆便所報告設定 < 2
			PRINTL
			SIF CFLAG:LOCAL:フェラ回数
				PRINTFORM フェラ　{CFLAG:LOCAL:フェラ回数}回　　
			SIF CFLAG:LOCAL:本番回数
				PRINTFORM 本番　　{CFLAG:LOCAL:本番回数}回　　
			SIF CFLAG:LOCAL:アナル回数
				PRINTFORM アナル　{CFLAG:LOCAL:アナル回数}回　　
			SIF CFLAG:LOCAL:中出し回数
				PRINTFORM 中出し　{CFLAG:LOCAL:中出し回数}回　　
			PRINTL
		ENDIF
		;経験の増加
		EXP:LOCAL:便器経験 += CFLAG:LOCAL:便器使用予定人数
		EXP:LOCAL:フェラ経験 += CFLAG:LOCAL:フェラ回数
		EXP:LOCAL:Ｖ経験 += CFLAG:LOCAL:本番回数
		EXP:LOCAL:Ａ経験 += CFLAG:LOCAL:アナル回数
		IF FLAG:公衆便所報告設定 < 2
			SIF CFLAG:LOCAL:便器使用予定人数
				PRINTFORM 便器経験 + {CFLAG:LOCAL:便器使用予定人数}　　
			SIF CFLAG:LOCAL:フェラ回数
				PRINTFORM フェラ経験 + {CFLAG:LOCAL:フェラ回数}　　
			SIF CFLAG:LOCAL:本番回数
				PRINTFORM Ｖ経験 + {CFLAG:LOCAL:本番回数}　　
			SIF CFLAG:LOCAL:アナル回数
				PRINTFORM Ａ経験 + {CFLAG:LOCAL:アナル回数}　　
			PRINTL
		ENDIF
		IF CFLAG:LOCAL:108 == 0 && FLAG:公衆便所報告設定 < 2
			SIF CFLAG:LOCAL:中出し回数
				PRINTFORM 膣射経験 + {CFLAG:LOCAL:中出し回数}　　
			EXP:LOCAL:膣射経験 += CFLAG:LOCAL:中出し回数
		ELSE
			SIF CFLAG:LOCAL:中出し回数 && FLAG:公衆便所報告設定 < 2
			PRINTFORM <避妊結界>
		ENDIF
		EXP:LOCAL:性交経験 += CFLAG:LOCAL:アナル回数 + CFLAG:LOCAL:本番回数
		EXP:LOCAL:精液経験 += CFLAG:LOCAL:中出し回数 + CFLAG:LOCAL:フェラ回数 + CFLAG:LOCAL:本番回数 + CFLAG:LOCAL:アナル回数
		EXP:LOCAL:絶頂経験 += EX:LOCAL:0 + EX:LOCAL:1 + EX:LOCAL:2 + EX:LOCAL:3
		IF FLAG:公衆便所報告設定 < 2
			SIF CFLAG:LOCAL:アナル回数 + CFLAG:LOCAL:本番回数
				PRINTFORM 性交経験 + {CFLAG:LOCAL:アナル回数 + CFLAG:LOCAL:本番回数}　　
			SIF CFLAG:LOCAL:中出し回数 + CFLAG:LOCAL:フェラ回数 + CFLAG:LOCAL:本番回数 + CFLAG:LOCAL:アナル回数
				PRINTFORM 精液経験 + {CFLAG:LOCAL:中出し回数 + CFLAG:LOCAL:フェラ回数 + CFLAG:LOCAL:本番回数 + CFLAG:LOCAL:アナル回数}　　
			SIF EX:LOCAL:0 + EX:LOCAL:1 + EX:LOCAL:2 + EX:LOCAL:3
				PRINTFORM 絶頂経験 + {EX:LOCAL:0 + EX:LOCAL:1 + EX:LOCAL:2 + EX:LOCAL:3}
			PRINTL
		ENDIF
		;珠の増加
		CALL JUEL_CHECK_TOILET,LOCAL

		;処女/再生処女を喪失した場合、処女価格を個別売り上げに加算
		SIF CFLAG:LOCAL:処女喪失フラグ || CFLAG:LOCAL:再生処女喪失フラグ
			CFLAG:LOCAL:個別売り上げ += CFLAG:LOCAL:処女価格
		;処女/再生処女喪失時のメッセージ表示および異常経験加算
		CALL 処女喪失イベント, LOCAL

		;MAG増加処理
		PRINTFORML ＭＡＧ + {(CFLAG:LOCAL:フェラ回数*2 + CFLAG:LOCAL:本番回数/2 + CFLAG:LOCAL:アナル回数*4 + CFLAG:LOCAL:中出し回数*6)*(MAXBASE:LOCAL:LV/5+1)*(1+(LOCAL == MASTER)+MAX(TALENT:LOCAL:霊媒体質*9 - !TALENT:LOCAL:非戦闘員 * 4, 0))}
		CALL CONTROL_MAG,LOCAL,(CFLAG:LOCAL:フェラ回数*2 + CFLAG:LOCAL:本番回数/2 + CFLAG:LOCAL:アナル回数*4 + CFLAG:LOCAL:中出し回数*6)*(MAXBASE:LOCAL:LV/5+1)*(1+(LOCAL == MASTER)+MAX(TALENT:LOCAL:霊媒体質*9 - !TALENT:LOCAL:非戦闘員 * 4, 0))
		;体力の消費
		PRINTFORML 体力 - {(CFLAG:LOCAL:フェラ回数*10 + CFLAG:LOCAL:本番回数*15 + CFLAG:LOCAL:アナル回数*25 + CFLAG:LOCAL:中出し回数*5)}
		BASE:LOCAL:体力 -= (CFLAG:LOCAL:フェラ回数*10 + CFLAG:LOCAL:本番回数*15 + CFLAG:LOCAL:アナル回数*25 + CFLAG:LOCAL:中出し回数*5)

		;ストレス増加
		IF LOCAL != MASTER
			PRINTFORML ストレス + {CFLAG:LOCAL:ストレス増加値}
			CFLAG:LOCAL:ストレス値 += CFLAG:LOCAL:ストレス増加値
		ENDIF
		;非戦闘員は経験値獲得
		IF TALENT:LOCAL:非戦闘員
			PRINTFORML EXP： +{CFLAG:LOCAL:個別売り上げ*(1+BASE:LOCAL:LV/5)}
			BASE:LOCAL:ＥＸＰ += CFLAG:LOCAL:個別売り上げ*(1+BASE:LOCAL:LV/5)
			;レベルアップ判定
			CALL CHECK_LEVEL_UP,LOCAL
			;IF TALENT:LOCAL:非戦闘員 && BASE:LOCAL:ＥＸＰ >= MAXBASE:LOCAL:ＥＸＰ
			;	PRINTFORML LEVEL UP!
			;	BASE:LOCAL:LV += 1
			;	CALL SYNC_STATUS,LOCAL
			;ENDIF
		ENDIF
		;---- EDIT 002 ADD START -------------------------
		;ARGで指定してしまっていたのをLOCALに修正
		;ペルソナ使いは装着中のペルソナの経験値獲得
		IF TALENT:LOCAL:ペルソナ使い
			CALL INCREASE_PERSONA_EXP, LOCAL, CFLAG:LOCAL:個別売り上げ / 10, -1 ,1
			SIF RESULT > 0
				PRINTFORML ペルソナ【\@EQUIP:LOCAL:装備ペルソナ ? %CSVNAME(DITEMTYPE:(EQUIP:LOCAL:装備ペルソナ):ペルソナ("NO"), 0)% # %CSVNAME(ABL:LOCAL:初期ペルソナ, 0)%\@】　EXP：+{RESULT}
		ENDIF
		;---- EDIT 002 ADD END -------------------------
		;人気増減
		IF CFLAG:LOCAL:労役成功度 < 30
			PRINTFORML 人気 {CFLAG:LOCAL:便器人気} - {6-CFLAG:LOCAL:労役成功度/5}
		ELSE
			PRINTFORML 人気 {CFLAG:LOCAL:便器人気} + {CFLAG:LOCAL:労役成功度/5 - 6}
		ENDIF
		CFLAG:LOCAL:便器人気 += CFLAG:LOCAL:労役成功度/5 - 6
		IF CFLAG:LOCAL:引継ぎフラグ && FLAG:5 < 9 && DAY < 51
			PRINTFORML 引継ぎキャラ：売り上げ × 0.01
			CFLAG:LOCAL:個別売り上げ = MAX(CFLAG:LOCAL:個別売り上げ/100,1)
		ENDIF
		PRINTFORML 売り上げ：{CFLAG:LOCAL:個別売り上げ}
		LOCAL:6 += CFLAG:LOCAL:個別売り上げ
		SIF LOCAL == MASTER
			CALL EVENTCHECK_M
			
		CALL 公衆便所ＮＴＲ, LOCAL

		;主人の属性値変動
		CALL INCREASE_LD,-3
		CALL SYNC_STATUS,MASTER	
		IF BASE:LOCAL:体力 <= 0
			PRINTL
			PRINTFORMW %CALLNAME:LOCAL%は酷く消耗し、気絶してしまった。
			;従順ダウン
			IF ABL:LOCAL:0 > 0
				ABL:LOCAL:0 -= 1
				PRINTFORML %CALLNAME:LOCAL%の従順が１下がった
			ENDIF
			;体力回復停止フラグ
			CFLAG:LOCAL:6 += 1
			SIF TALENT:LOCAL:147
				CFLAG:LOCAL:6 -= 1
			CFLAG:LOCAL:10 += 10
			BASE:LOCAL:0 = 1
		ENDIF
		PRINTW
		DRAWLINE
	NEXT
	;平均の人気 LOCAL:8
	LOCAL:7 /= MAX(1,LOCAL:10)
	$TOILET_END
	PRINTFORML %SAVESTR:(20+ARG)%
	IF LOCAL:7 > 0
		PRINTFORML 利用者満足度 {LOCAL:7}％
		IF LOCAL:7 > 29
			PRINTFORML 評判 {店舗("人気",ARG)} + {LOCAL:7/5-6}
		ELSE
			PRINTFORML 評判 {店舗("人気",ARG)} - {-LOCAL:7/5+6}
		ENDIF
		CALL 店舗演算("人気",ARG,LOCAL:7/5-6,"+")
		IF LOCAL:3 == 1
			PRINTFORML 来訪者が便所の規模を越えて現れ、便器を利用できなかった客から苦情が届いた…
			PRINTFORML 評判 - {店舗("人気",ARG)/10}
			CALL 店舗演算("人気",ARG,店舗("人気",ARG)/10,"-")
		ENDIF
		;IF LOCAL:8 + LOCAL:2 > 接客人数(ARG) * 20
