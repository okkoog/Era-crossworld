	PALAM:ARG:LOCAL += CUP:ARG:LOCAL - CDOWN:ARG:LOCAL
	CUP:ARG:LOCAL = 0
	CDOWN:ARG:LOCAL = 0
NEXT
;ソース初期化
FOR LOCAL,0,100
	SOURCE:ARG:LOCAL = 0
NEXT



