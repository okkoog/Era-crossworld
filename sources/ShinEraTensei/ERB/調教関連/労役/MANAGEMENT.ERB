;=============================================================
;規模を拡張するために必要な金額を計算する。
;<引数>
; ARG    = 現在の規模
; ARG:1  = 拡張規模
; ARG:2  = 拡張する内容(0:雇用人数／1:利用可能客数)
;<戻り値>
; LOCAL  = ARG:1の人数拡張するために必要なトータル金額
;=============================================================
@規模拡張金額(ARG,ARG:1,ARG:2)
#FUNCTION

;拡張に必要な金額
LOCAL = 0

FOR COUNT, ARG, ARG+ARG:1
	IF ARG:2 == 0
		;雇用人数拡張
		SELECTCASE COUNT
			CASE IS < 4
				LOCAL += 10000
			CASE IS < 6
				LOCAL += 25000
			CASE IS < 8
				LOCAL += 50000
			CASE IS < 10
				LOCAL += 80000
			CASEELSE
				LOCAL += 150000
		ENDSELECT
	ELSEIF ARG:2 == 1
		;利用可能客数拡張
		SELECTCASE COUNT
			CASE IS < 5
				LOCAL += 1000
			CASE IS < 10
				LOCAL += 3000
			CASE IS < 15
				LOCAL += 7500
			CASE IS < 20
				LOCAL += 10000
			CASE IS < 30
				LOCAL += 15000
			CASEELSE
				LOCAL += 25000
		ENDSELECT
	ENDIF
NEXT

RETURNF LOCAL


