;=============================================
;店舗経営システム
;=============================================
;========================================================
;店舗経営
;========================================================
@MANAGEMENT
CUSTOMDRAWLINE =
FOR LOCAL,0,10
	PRINTFORM [{LOCAL}] - 
	IF 店舗("種類",LOCAL) > 0
		PRINTFORML  %SAVESTR:(20+LOCAL)%
	ELSE
		SETCOLOR 0x909090
		PRINTFORML 店舗設営
		RESETCOLOR
	ENDIF
NEXT
DRAWLINE
PRINTL [10] 戻る
$INPUT_LOOP
INPUT
IF RESULT == 10
	RETURN 0
ELSEIF RESULT < 0 || RESULT > 9
	GOTO INPUT_LOOP
ENDIF
LOCAL = RESULT
IF 店舗("種類",LOCAL) > 0
	CALL MANAGEMENT_MAIN,LOCAL
ELSE
	CALL MANAGEMENT_MAKE,LOCAL
ENDIF

RESTART

;========================================================
;店舗設営
;========================================================
@MANAGEMENT_MAKE,ARG
CUSTOMDRAWLINE ･
PRINTFORML 何の店舗を建設しますか？　（所持金：￥{MONEY}）
DRAWLINE
PRINTL [10] - 公衆便所 (￥50000)
PRINTL [11] - ストリップ劇場 (￥25000)
DRAWLINE
PRINTL [0]  - やめる
$INPUT_LOOP
INPUT
LOCAL = RESULT
SELECTCASE LOCAL
	CASE 0
		RETURN 0
	CASE 10
		LOCAL:1 = 50000
	CASE 11
		LOCAL:1 = 25000
	CASEELSE
		GOTO INPUT_LOOP
ENDSELECT
SIF MONEY < LOCAL:1
	GOTO INPUT_LOOP
PRINTFORML 建設には￥{LOCAL:1}が必要です。本当に建設しますか？
CALL INPUT_YN,"YES","NO"
IF RESULT == 1
	RESTART
ENDIF

CALL 店舗演算("種類",ARG,LOCAL,"=")
;建設作業
SELECTCASE LOCAL
	CASE 10
		CALL 店舗演算("規模",ARG,10,"=")
		CALL 店舗演算("接客雇用",ARG,2,"=")
		CALL 店舗演算("フェラ価格",ARG,1,"=")
		CALL 店舗演算("本番価格",ARG,2,"=")
		CALL 店舗演算("アナル価格",ARG,2,"=")
		CALL 店舗演算("中出し価格",ARG,4,"=")
		CALL 店舗演算("処女価格",ARG,10,"=")
		CALL 店舗演算("性的サービス",ARG,120,"=")
		LOCALS = 公衆便所
	CASE 11
		CALL 店舗演算("規模",ARG,1,"=")
		LOCALS = ストリップ劇場
ENDSELECT
MONEY -= LOCAL:1

PRINTL
$CHANGE_NAME
PRINTFORML 店舗の名前は「%LOCALS%」でいいですか？
CALL INPUT_YN,"このまま","変更する"
IF RESULT == 1
	PRINTL 店舗の名称を入力してください
	INPUTS
	LOCALS = %RESULTS%
	GOTO CHANGE_NAME
ENDIF
SAVESTR:(20+ARG) = %LOCALS%
PRINTFORML おめでとうございます。%SAVESTR:(20+ARG)%が開店しました。
RETURN 0

;========================================================
;店舗経営メイン画面
;========================================================
@MANAGEMENT_MAIN,ARG
CUSTOMDRAWLINE =
;ステータス表示
CALL SHOW_STATUS_MANAGEMENT,ARG

CALL PRINT_COMMAND_MANAGEMENT,ARG

$INPUT_LOOP
INPUT
IF RESULT == 100
	RETURN 0
ELSEIF RESULT < 0 || RESULT > 100
	GOTO INPUT_LOOP
ELSEIF C:RESULT == -1
	GOTO INPUT_LOOP
ENDIF
IF 店舗("種類",ARG) <= 10
	SELECTCASE RESULT
		CASE 0
			;配置
			CALL ARRANGE_MANAGEMENT,ARG
		CASE 1
			;人数拡張
			CALL EXTEND_MEMBER_MANAGEMENT,ARG
		CASE 2
			;規模拡張
			CALL EXTEND_MANAGEMENT,ARG
		CASE 3
			;価格設定
			CALL ARRANGE_PRICE_MANAGEMENT,ARG
		CASE 4
			;商品設定
			CALL ARRANGE_COMMODITY_MANAGEMENT,ARG
		CASE 5
			;広告
			CALL ADVERTISEMENT_MANAGEMENT,ARG
		CASE 6
			;報告方法の選択
			SELECTCASE FLAG:公衆便所報告設定
				CASE 0
					FLAG:公衆便所報告設定 = 1
				CASE 1
					FLAG:公衆便所報告設定 = 2
				CASE 2
					FLAG:公衆便所報告設定 = 0
			ENDSELECT
		CASE 10
			;料金個別設定（便所、娼館）
			CALL ARRANGE_CHARA_PRICE_MANAGEMENT,ARG
		CASE 11
			;利用方法個別設定（便所、娼館）
			CALL ARRANGE_CHARA_COMMODITY_MANAGEMENT,ARG
		CASE 99
			CALL 店舗売却,ARG
			IF RESULT == 1
				CLEARBIT FLAG:公衆便所報告設定, ARG
				RETURN 0
			ENDIF
	ENDSELECT
ELSEIF 店舗("種類",ARG) == 11
	SELECTCASE RESULT
		CASE 0
			;出演者変更
			CALL ARRANGE_MANAGEMENT_STRIP_THEATER,ARG
		CASE 1
			;規模拡張
			CALL EXTEND_MANAGEMENT_STRIP_THEATER,ARG
		CASE 2
			;広告
			CALL ADVERTISEMENT_MANAGEMENT,ARG
		CASE 3
			INVERTBIT FLAG:ストリップ劇場報告設定, ARG
		CASE 99
			CALL 店舗売却,ARG
			IF RESULT == 1
				CLEARBIT FLAG:ストリップ劇場報告設定, ARG
				RETURN 0
			ENDIF
	ENDSELECT
ENDIF

RESTART

;========================================================
;配置
;========================================================
@ARRANGE_MANAGEMENT,ARG,ARG:1
P = 0
CUSTOMDRAWLINE = 
$INPUT_LOOP_2
;表示させるキャラを抽出（Q:*に表示するキャラの登録番号、LOCAL:2に人数）
VARSET Q, -1
A = 0
REPEAT CHARANUM
	SIF WORKABLE(ARG,COUNT) == 0
		CONTINUE
	;SIF CFLAG:COUNT:労役フラグ != 0 && CFLAG:COUNT:労役フラグ != 10+ARG
	SIF CFLAG:COUNT:労役フラグ != 0 && CFLAG:COUNT:労役フラグ != 10+ARG
		CONTINUE
	SIF CFLAG:COUNT:この場に居ないフラグ == 1
		CONTINUE
	SIF CFLAG:COUNT:フィルタリングフラグ
		CONTINUE

	Q:A = COUNT
	A += 1
REND
LOCAL:2 = A

$PRINT_LIST
DRAWLINE
PRINTFORML この店舗で労役させたい/外したいキャラを選んでください　現在{接客人数(ARG)}/{店舗("接客雇用",ARG)}人＜page.{P}＞
DRAWLINE
CALL MANAGEMENT_CHARALIST,ARG,0
DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 16% # [1007]前のページ\@
PRINTLC [1000]戻る
PRINTFORMLC \@(P >= (LOCAL:2 - 1) / 20) ? %" " * 16% # [1009]次のページ\@

$INPUT_LOOP_1
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1007
	IF P > 0
		P -= 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT == 1009
	LOCAL = (LOCAL:2 - 1) / 20
	IF P < LOCAL
		P += 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT < 0 || RESULT >= CHARANUM || MATCH(Q,RESULT) == 0
	GOTO INPUT_LOOP_1
ENDIF

;労役切り替え
IF CFLAG:RESULT:労役フラグ == 10+ARG
	CFLAG:RESULT:労役フラグ = 0
ELSEIF 接客人数(ARG) < 店舗("接客雇用",ARG)
	CFLAG:RESULT:労役フラグ = 10+ARG
	CFLAG:RESULT:フェラ価格= 店舗("フェラ価格",ARG)
	CFLAG:RESULT:本番価格= 店舗("本番価格",ARG)
	CFLAG:RESULT:中出し価格= 店舗("中出し価格",ARG)
	CFLAG:RESULT:アナル価格= 店舗("アナル価格",ARG)
	CFLAG:RESULT:処女価格= 店舗("処女価格",ARG)
	CFLAG:RESULT:従事内容 = 1
	CFLAG:RESULT:個別性的サービス = 店舗("性的サービス",ARG)
ELSE
	GOTO INPUT_LOOP_1
ENDIF
GOTO INPUT_LOOP_2

;========================================================
;雇用可能人数拡張
;========================================================
@EXTEND_MEMBER_MANAGEMENT,ARG
IF 店舗("種類",ARG) == 10
	PRINTFORML 現在、このトイレに設置できる便器の数は{店舗("接客雇用",ARG)}人です。
ELSE
	PRINTFORML 現在、この店舗に配置できる接客係は{店舗("接客雇用",ARG)}人です。
ENDIF

;---- EDIT 002 MOD START ---------
;雇用人数の拡張を一気に行えるようにしてみる。
;現在の雇用人数を取得
LOCAL:1 = 店舗("接客雇用",ARG)

PRINTL
IF 店舗("種類",ARG) == 10
	PRINT 便器の数を
ELSE
	PRINT 人数を
ENDIF
PRINTL どれだけ増やすか選択してください。
PRINTL 直接入力することでも増やす数を指定することができます。
PRINTL 0を入力すると拡張を中止します。
PRINTL
PRINTFORML [1]  - 1人増やす  (￥{規模拡張金額(LOCAL:1,1,0)})
PRINTFORML [5]  - 5人増やす  (￥{規模拡張金額(LOCAL:1,5,0)})
PRINTFORML [10] - 10人増やす (￥{規模拡張金額(LOCAL:1,10,0)})
PRINTL [0]  - 拡張しない

INPUT

LOCAL:2 = RESULT

PRINTL

IF LOCAL:2 == 0
	PRINTL 拡張を中止します。
	RETURN 0
ELSE
	LOCAL = 規模拡張金額(LOCAL:1,LOCAL:2,0)
	PRINTFORM {LOCAL:2}人増やすためには￥{LOCAL}必要です
	IF MONEY < LOCAL
		PRINTL が資金が足りません。
		RETURN 0
	ENDIF
	PRINTL 。
ENDIF

PRINTL 拡張しますか？
CALL INPUT_YN,"YES","NO"
SIF RESULT == 1
	RETURN 0
CALL 店舗演算("接客雇用",ARG,LOCAL:2,"+")
;---- EDIT 002 MOD END -----------
MONEY -= LOCAL

;========================================================
;規模拡張
;========================================================
@EXTEND_MANAGEMENT,ARG
PRINTFORML 現在、この店舗は一日に{店舗("規模",ARG)}人が利用できます。

;---- EDIT 002 MOD START ---------
;規模の拡張を一気に行えるようにしてみる。
;現在の規模を取得
LOCAL:1 = 店舗("規模",ARG)

PRINTL
PRINTL 店舗の利用可能人数をどれだけ拡張するか選択してください。
PRINTL 直接入力することでも拡張規模を指定することができます。
PRINTL 0を入力すると拡張を中止します。
PRINTL
PRINTFORML [1]  -  1人増やす (￥{規模拡張金額(LOCAL:1,1,1)})
PRINTFORML [5]  -  5人増やす (￥{規模拡張金額(LOCAL:1,5,1)})
PRINTFORML [10] - 10人増やす (￥{規模拡張金額(LOCAL:1,10,1)})
PRINTL [0]  - 拡張しない

INPUT

LOCAL:2 = RESULT

PRINTL

IF LOCAL:2 == 0
	PRINTL 拡張を中止します。
	RETURN 0
ELSE
	LOCAL = 規模拡張金額(LOCAL:1,LOCAL:2,1)
	PRINTFORM {LOCAL:2}人増やすためには￥{LOCAL}必要です
	IF MONEY < LOCAL
		PRINTL が資金が足りません。
		RETURN 0
	ENDIF
	PRINTL 。
ENDIF

PRINTL 拡張しますか？
CALL INPUT_YN,"YES","NO"
SIF RESULT == 1
	RETURN 0
CALL 店舗演算("規模",ARG,LOCAL:2,"+")
;---- EDIT 002 MOD END -----------
MONEY -= LOCAL

;========================================================
;価格設定
;========================================================
@ARRANGE_PRICE_MANAGEMENT,ARG
SELECTCASE [[店舗:種類]]:ARG
	CASE 10
		PRINTFORML 現在、商品の基本価格は以下の通りです。変更したい商品を選んでください
		PRINTFORML [1] フェラチオ：{店舗("フェラ価格",ARG)}魔貨
		LOCALS:1 = フェラチオ
		PRINTFORML [2] 本番      ：{店舗("本番価格",ARG)}魔貨
		LOCALS:2 = 本番
		PRINTFORML [3] アナル    ：{店舗("アナル価格",ARG)}魔貨
		LOCALS:3 = アナル
		PRINTFORML [4] 中出し    ：{店舗("中出し価格",ARG)}魔貨
		LOCALS:4 = 中出し
		PRINTFORML [5] 処女    ：{店舗("処女価格",ARG)}魔貨
		LOCALS:5 = 処女
		DRAWLINE
		PRINTL [0] 戻る [9]価格を全員に反映
		CALL INPUTINT,0,1,2,3,4,5,9
		IF RESULT == 0
			RETURN 0
		ELSEIF RESULT == 9
			FOR LOCAL , 0 ,CHARANUM
				IF CFLAG:LOCAL:労役フラグ % 10 == ARG
					CFLAG:LOCAL:フェラ価格= 店舗("フェラ価格",ARG)
					CFLAG:LOCAL:本番価格= 店舗("本番価格",ARG)
					CFLAG:LOCAL:中出し価格= 店舗("中出し価格",ARG)
					CFLAG:LOCAL:アナル価格= 店舗("アナル価格",ARG)
					CFLAG:LOCAL:処女価格= 店舗("処女価格",ARG)
				ENDIF
			NEXT
			RESTART
		ENDIF
		LOCAL = RESULT
		PRINTFORML %LOCALS:LOCAL%の値段を決めてください
		CALL INPUT_MANY,0,999999999
		IF LOCAL == 1
			CALL 店舗演算("フェラ価格",ARG,RESULT,"=")
		ELSEIF LOCAL == 2
			CALL 店舗演算("本番価格",ARG,RESULT,"=")
		ELSEIF LOCAL == 3
			CALL 店舗演算("アナル価格",ARG,RESULT,"=")
		ELSEIF LOCAL == 4
			CALL 店舗演算("中出し価格",ARG,RESULT,"=")
		ELSE
			CALL 店舗演算("処女価格",ARG,RESULT,"=")
		ENDIF
		RESTART
	CASEELSE
		RETURN 0
ENDSELECT

;========================================================
;利用方法設定
;========================================================
@ARRANGE_COMMODITY_MANAGEMENT,ARG
SELECTCASE 店舗("種類",ARG)
	CASE 10
		PRINTFORML 現在、商品の基本利用方法は以下の通りです。変更したい商品を選んでください
		PRINTFORML [1] フェラチオ：\@ 店舗("性的サービス",ARG) & 8 ? 有り # 無し \@
		LOCALS:1 = フェラチオ
		PRINTFORML [2] 本番      ：\@ 店舗("性的サービス",ARG) & 16 ? 有り # 無し \@
		LOCALS:2 = 本番
		PRINTFORML [3] アナル    ：\@ 店舗("性的サービス",ARG) & 32 ? 有り # 無し \@
		LOCALS:3 = アナル
		PRINTFORML [4] 中出し    ：\@ 店舗("性的サービス",ARG) & 64 ? 有り # 無し \@
		LOCALS:4 = 中出し
		DRAWLINE
		PRINTL [0] 戻る [9]利用方法を全員に反映
		CALL INPUTINT,0,1,2,3,4,9
		IF RESULT == 0
			RETURN 0
		ELSEIF RESULT == 9
			FOR LOCAL , 0 ,CHARANUM
				IF CFLAG:LOCAL:労役フラグ % 10 == ARG
					CFLAG:LOCAL:個別性的サービス = 店舗("性的サービス",ARG)
				ENDIF
			NEXT
			RESTART
		ENDIF
		LOCAL = RESULT
		IF LOCAL == 1
			IF 店舗("性的サービス",ARG) & 8
				CALL 店舗演算("性的サービス",ARG,8,"-")
			ELSE
				CALL 店舗演算("性的サービス",ARG,8,"+")
			ENDIF
		ELSEIF LOCAL == 2
			IF 店舗("性的サービス",ARG) & 16
				CALL 店舗演算("性的サービス",ARG,16,"-")
			ELSE
				CALL 店舗演算("性的サービス",ARG,16,"+")
			ENDIF
		ELSEIF LOCAL == 3
			IF 店舗("性的サービス",ARG) & 32
				CALL 店舗演算("性的サービス",ARG,32,"-")
			ELSE
				CALL 店舗演算("性的サービス",ARG,32,"+")
			ENDIF
		ELSE
			IF 店舗("性的サービス",ARG) & 64
				CALL 店舗演算("性的サービス",ARG,64,"-")
			ELSE
				CALL 店舗演算("性的サービス",ARG,64,"+")
			ENDIF
		ENDIF
		RESTART
	CASEELSE
		RETURN 0

ENDSELECT

;========================================================
;広告
;========================================================
@ADVERTISEMENT_MANAGEMENT,ARG
IF 店舗("宣伝フラグ",ARG)
	PRINTL 広告は１店舗につき１日１回しか出せません
	RETURN 0
ENDIF
CUSTOMDRAWLINE =
PRINTFORML どの広告を出しますか？(現在の宣伝効果:{店舗("宣伝効果",ARG)})
PRINTL 　　　　　　　　　　費用　　　　　　効果
PRINTL [1] ビラ配り　　　　5000　　　　　　  50
PRINTL [2] ラジオ広告　　 20000　　　　　　 100
PRINTL [3] パラダイムＸ　100000　　　　　　 300
PRINTL [4] 飛行船で宣伝　500000　　　　　　 800
DRAWLINE
PRINTL [0] やめる
$LOOP
CALL INPUTINT,0,1,2,3,4
SELECTCASE RESULT
	CASE 1
		SIF MONEY < 5000
			GOTO LOOP
		MONEY -= 5000
		PRINTW 店舗の近辺でのビラ配りを依頼しました
		CALL 店舗演算("宣伝効果",ARG,50,"+")
		CALL 店舗演算("宣伝フラグ",ARG,1,"=")
	CASE 2
		SIF MONEY < 20000
			GOTO LOOP
		MONEY -= 20000
		PRINTW ラジオに広告を出しました
		CALL 店舗演算("宣伝効果",ARG,100,"+")
		CALL 店舗演算("宣伝フラグ",ARG,1,"=")
	CASE 3
		SIF MONEY < 100000
			GOTO LOOP
		MONEY -= 100000
		PRINTW パラダイムＸに広告を出しました
		CALL 店舗演算("宣伝効果",ARG,300,"+")
		CALL 店舗演算("宣伝フラグ",ARG,1,"=")
	CASE 4
		SIF MONEY < 500000
			GOTO LOOP
		MONEY -= 500000
		PRINTW 飛行船で宣伝を行いました。
		CALL 店舗演算("宣伝効果",ARG,800,"+")
		CALL 店舗演算("宣伝フラグ",ARG,1,"=")
ENDSELECT

;========================================================
;個別料金設定
;========================================================
@ARRANGE_CHARA_PRICE_MANAGEMENT,ARG

P = 0
;表示させるキャラを抽出（Q:*に表示するキャラの登録番号、LOCAL:2に人数）
VARSET Q, -1
A = 0
REPEAT CHARANUM
	SIF CFLAG:COUNT:労役フラグ != 10+ARG
		CONTINUE
	Q:A = COUNT
	A += 1
REND
LOCAL:2 = A

$PRINT_LIST
DRAWLINE
PRINTFORML 利用料金を変更したい便器を選んでください　＜page.{P}＞
DRAWLINE
CALL SHOW_CHARA_LIST
DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 16% # [1007]前のページ\@
PRINTLC [1000]戻る
PRINTFORMLC \@(P >= (LOCAL:2 - 1) / 20) ? %" " * 16% # [1009]次のページ\@

$INPUT_LOOP_1
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1007
	IF P > 0
		P -= 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT == 1009
	LOCAL = (LOCAL:2 - 1) / 20
	IF P < LOCAL
		P += 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT < 0 || RESULT >= CHARANUM || MATCH(Q,RESULT) == 0
	GOTO INPUT_LOOP_1
ENDIF

LOCAL:1 = RESULT


$CHANGE_PRICE
		PRINTFORML 現在、この便器の利用価格は以下の通りです。変更したい利用方法を選んでください
		PRINTFORML [1] フェラチオ：{CFLAG:(LOCAL:1):フェラ価格}魔貨
		LOCALS:1 = フェラチオ
		PRINTFORML [2] 本番      ：{CFLAG:(LOCAL:1):本番価格}魔貨
		LOCALS:2 = 本番
		PRINTFORML [3] アナル    ：{CFLAG:(LOCAL:1):アナル価格}魔貨
		LOCALS:3 = アナル
		PRINTFORML [4] 中出し    ：{CFLAG:(LOCAL:1):中出し価格}魔貨
		LOCALS:4 = 中出し
		PRINTFORML [5] 処女    ：{CFLAG:(LOCAL:1):処女価格}魔貨
		LOCALS:5 = 処女
		DRAWLINE
		PRINTL [0] 戻る
		CALL INPUTINT,0,1,2,3,4,5
		IF RESULT == 0
			RESTART
		ENDIF
		LOCAL = RESULT
		PRINTFORML %LOCALS:LOCAL%の値段を決めてください
		CALL INPUT_MANY,0,999999999
		IF LOCAL == 1
			CFLAG:(LOCAL:1):フェラ価格 = RESULT
		ELSEIF LOCAL == 2
			CFLAG:(LOCAL:1):本番価格 = RESULT
