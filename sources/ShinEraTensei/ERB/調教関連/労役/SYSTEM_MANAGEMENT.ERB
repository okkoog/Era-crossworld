@SHOW_STATUS_MANAGEMENT,ARG
;１行目に名前
PRINTFORM %SAVESTR:(20+ARG),20,LEFT%
SELECTCASE 店舗("種類", ARG)
	CASE 10
		PRINTFORML 　店舗の種類:公衆便所
		;3行目には規模と雇用人数
		PRINTFORML 最大利用者数/日:{店舗("規模",ARG),4}人　便器設置数：{接客人数(ARG),2}/{店舗("接客雇用",ARG),2}個
		;4行目には人気と宣伝効果
		PRINTFORML 人気　　　　　 :{店舗("人気",ARG),5} 　　宣伝効果：{店舗("宣伝効果",ARG),5}　　\@ 看板便器(ARG) > -1 ? 看板便器:%CALLNAME:看板便器(ARG)% # \@
		;5行目には維持費
		PRINTL
		PRINTFORML 一日の維持費:￥{ 500 + 店舗("規模",ARG) * 50 + 接客人数(ARG) * 200}
		PRINTL
		;6行目には基本の価格
		PRINTL 【商品基本価格】
		PRINTFORML フェラチオ:{店舗("フェラ価格",ARG),3}魔貨　　　本番:{店舗("本番価格",ARG),3}魔貨　　　アナル:{店舗("アナル価格",ARG),3}魔貨　　　中出し:{店舗("中出し価格",ARG),3}魔貨
	CASE 11
		PRINTFORML 　店舗の種類:ストリップ劇場
		PRINTFORML 最大集客数/日:{店舗("規模",ARG) * 100,4}人　最大役者数：{店舗("規模",ARG),2}人
		PRINTFORML 宣伝効果：{店舗("宣伝効果",ARG),5}　一日の維持費:￥{店舗("規模",ARG) * 500}
ENDSELECT
CUSTOMDRAWLINE ･

