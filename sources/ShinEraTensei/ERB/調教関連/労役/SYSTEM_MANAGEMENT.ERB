;========================================================
;コマンド表示
;========================================================
@PRINT_COMMAND_MANAGEMENT,ARG
VARSET C , -1
SELECTCASE [[店舗:種類]]:ARG
	CASE 10
		;規模拡張、設置数増加、
		C:0 = 1
		PRINTL [0]  - 便器設置
		C:1 = 1
		PRINTL [1]  - 便器設置可能数拡張
		C:2 = 1
		PRINTL [2]  - 店舗規模拡張
		C:3 = 1
		PRINTL [3]  - 基本利用料設定
		C:4 = 1
		PRINTL [4]  - 基本利用方法設定
		C:5 = 1
		PRINTL [5]  - 広告を出す
		C:6 = 1
		PRINT [6]  - 現在の収支報告方法　-　
		SELECTCASE FLAG:公衆便所報告設定
			CASE 0
				PRINTL 詳細報告
			CASE 1
				PRINTL 簡易報告
			CASE 2
				PRINTL 収支のみ報告
		ENDSELECT

		C:10 = 1
		PRINTL [10] - 利用料個別設定
		C:11 = 1
		PRINTL [11] - 利用方法個別設定
		C:99 = 1
		PRINTL [99] - 店舗売却
	CASE 11
		C:0 = 1
		PRINTL [0]  - 出演者変更
		C:1 = 1
		PRINTL [1]  - 劇場拡張
		C:2 = 1
		PRINTL [2]  - 広告を出す
		C:3 = 1
		PRINTFORML [3]  - \@GETBIT(FLAG:ストリップ劇場報告設定,ARG) ? 詳細報告に変更 # 簡易報告に変更\@
		C:99 = 1
		PRINTL [99] - 店舗売却
ENDSELECT
DRAWLINE
PRINTL [100] - 戻る

;========================================================
;配置キャラリスト
;========================================================
@MANAGEMENT_CHARALIST,ARG,ARG:1
REPEAT 20
	LOCAL = Q:(COUNT + P * 20)
	SIF LOCAL < 0
		CONTINUE
	SIF CFLAG:LOCAL:この場に居ないフラグ == 1
		CONTINUE
	SIF ARG:1 == 0 && 接客人数(ARG) >= [[店舗:接客雇用]]:ARG
		SETCOLOR 0x404040
	;色セット
	SIF CFLAG:LOCAL:労役フラグ == 10+ARG
		SETCOLOR 0x33ffcc
	CALL ARRANGE_CHARALIST, LOCAL
	CALL ARRANGE_CHARALIFE, LOCAL
	SIF ARG:1 == 0 && 接客人数(ARG) >= [[店舗:接客雇用]]:ARG
		PRINT 　○
	PRINTL
	RESETCOLOR
REND
PRINTL ○:この店舗で労役中のキャラ を表しています

RESETCOLOR


;========================================================
;店舗に出る条件
;========================================================
@WORKABLE(ARG,ARG:1)
#FUNCTION
SELECTCASE [[店舗:種類]]:ARG
	CASE 0
		RETURNF 1

	CASE 10
		;縛り上げるだけなので、条件は無い
		RETURNF 1
	CASE 11
		;主人は無理をする
		SIF ARG:1 == MASTER
			RETURNF 1
		;露出癖がないと無理
		SIF ABL:(ARG:1):露出癖 <= 0
			RETURNF 0
		;売却可能じゃないと無理
		SIF CFLAG:(ARG:1):売却可能 == 0
			RETURNF 0
		RETURNF 1
ENDSELECT
RETURNF 0



;===========================================================
;変数関係
;=========================================================
@店舗(ARGS,ARG)
#FUNCTION
LOCAL = 店舗項目(ARGS)
IF LOCAL < 0
	PRINTFORML エラー出たので0返します。%ARGS%なんて項目はないです
	RETURNF 0
ENDIF
RETURNF DE:LOCAL:ARG

@店舗演算(ARGS,ARG,ARG:1,ARGS:1)
LOCAL = 店舗項目(ARGS)
IF LOCAL < 0
	PRINTFORML エラー出たので0返します。%ARGS%なんて項目はないので演算できないです。
	RETURN 0
ENDIF
SELECTCASE ARGS:1
	CASE "="
		DE:LOCAL:ARG = ARG:1
	CASE "+"
		DE:LOCAL:ARG += ARG:1
	CASE "-"
		DE:LOCAL:ARG -= ARG:1
	CASE "*"
		DE:LOCAL:ARG *= ARG:1
	CASE "/"
		DE:LOCAL:ARG /= ARG:1
	CASE "%"
		DE:LOCAL:ARG %= ARG:1
ENDSELECT

@店舗項目(ARGS)
#FUNCTION
SIF LOCALS == ""
	SPLIT "種類_制服_商品_人気_宣伝効果_料理完成度_料理人気_規模_接客雇用_キッチン雇用_性的サービス_おさわり価格_愛撫価格_フェラ価格_本番価格_アナル価格_中出し価格_処女価格_料理価格_酒価格_飲み物価格_維持費_名称_料理期待度_酒期待度_飲み物期待度_性的期待度_制服スカート_制服下着_制服おっぱい_制服淫具_乱交フラグ_宣伝フラグ_役者１_役者２_役者３_役者４_役者５_役者６_役者７_役者８_役者９_役者１０_演目１_演目２_演目３_演目４_演目５_演目６_演目７_演目８_演目９_演目１０" , "_" , LOCALS
RETURNF FINDELEMENT(LOCALS , ARGS)

