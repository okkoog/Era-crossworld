@ARRANGE_CHARANAME
;名前の表示の後の文字を揃えるための空白調整、Str.csvにて処理している
C = NO:COUNT + 200
PRINTS STR:C

;==========================================================
;<関数名>
; SHOW_INFO_PALAM
;<関数の説明>
; 対象の現在のパラメータ状況を表示する。
;<引数>
; [ARG] 表示する対象の番号(初期値:-1)
;       -1    : 被調教者(TARGET)
;       -1以外: 調教者(あなた or 助手)
;<戻り値>: なし
;==========================================================
@SHOW_INFO_PALAM, ARG=-1
#DIM PLV, 1
#LOCALSIZE 5
;LOCAL 調教者/被調教者判別用
SIF ARG < 0
	ARG = TARGET
LOCAL:4 = 0
FOR LOCAL, 0, 15
	LOCALS = %AUTO_SPLIT("快Ｃ/快Ｖ/快Ａ/快Ｂ/潤滑/恭順/欲情/屈服/習得/恥情/苦痛/恐怖/反感/不快/抑鬱", "/", LOCAL)%
	SIF ARG == PLAYER && !GROUPMATCH(LOCALS, "快Ｃ", "快Ｖ", "快Ａ", "快Ｂ", "潤滑", "欲情")
		CONTINUE
	PRINTFORM %LOCALS%
	PLV = GETPALAMLV(PALAM:ARG:LOCALS, 17)
	SELECTCASE PLV
		CASE IS < 10
			PRINTFORM Lv{PLV}
		CASE 10
			PRINT LvA
		CASE 11
			PRINT LvB
		CASE 12
			PRINT LvC
		CASE 13
			PRINT LvD
		CASE 14
			PRINT LvE
		CASE 15
			PRINT LvF
		CASE 16
			PRINT LvG
		CASE 17
			PRINT ???
	ENDSELECT
	PRINT  
	SELECTCASE FLAG:PALAM表示設定
		CASE 0
			LOCAL:1 = PALAM:ARG:LOCALS
			LOCAL:2 = PALAM:ARG:LOCALS-PALAMLV:PLV
			LOCAL:3 = PALAMLV:(PLV+1)-PALAMLV:PLV
		CASE 1
			LOCAL:1 = PALAM:ARG:LOCALS
			LOCAL:2 = PALAM:ARG:LOCALS
			LOCAL:3 = PALAMLV:(PLV+1)
		CASE 2
			LOCAL:1 = PALAM:ARG:LOCALS - PALAMLV:PLV
			LOCAL:2 = PALAM:ARG:LOCALS - PALAMLV:PLV
			LOCAL:3 = PALAMLV:(PLV+1)-PALAMLV:PLV
	ENDSELECT
	IF PLV == 17 || (LOCALS == "潤滑" && PLV >= 5)
		CALL PRINT_COLORBAR, 0, 1, 8, UNICODE(0x2584), UNICODE(0x2584), BARCOLORSET("青"), RESULT:1
		PRINT  ( MAX!!) 
	ELSE
		CALL PRINT_COLORBAR, LOCAL:2, LOCAL:3, 8, UNICODE(0x2584), UNICODE(0x2584), BARCOLORSET("青"), RESULT:1
		PRINT  (
		;桁数を取得
		LOCAL:2 = 1
		WHILE 1
			SIF PALAM:ARG:LOCALS / POWER(10, LOCAL:2) == 0
				BREAK
			LOCAL:2++
		WEND
		SELECTCASE LOCAL:2
			CASE IS < 7
				PRINTFORM {LOCAL:1, 6}
			CASE IS < 11
				PRINTFORM {LOCAL:1 / POWER(10, 3),5}K
			CASE IS < 14
				PRINTFORM {LOCAL:1 / POWER(10, 3),5}M
			CASE IS < 17
				PRINTFORM {LOCAL:1 / POWER(10, 3),5}G
			CASE IS < 20
				PRINTFORM {LOCAL:1 / POWER(10, 3),5}P
		ENDSELECT
		PRINT ) 
	ENDIF
	SIF ++(LOCAL:4) % FLAG:調教パラメータを並べる数 == 0
		PRINTL 
NEXT
SIF LOCAL:4 % 3 > 0
	PRINTL 
RETURN 0
@SHOW_INFO_ABL
S = 0
REPEAT 20
	;表示概要
	;　　　　 0,従順 　　　　 1,欲望 　　　　 2,技巧 　　　 3,Ｃ感覚
	;　　　 4,Ｖ感覚 　　　 5,Ａ感覚 　　　 6,Ｂ感覚 　　 7,奉仕精神
	;　　　 8,露出癖 　　 9,マゾっ気 　　10,サドっ気 　　11,レズっ気
	;　　12,料理技能 　　13,撮影技能 　　14,歌唱技能 　　15,自慰中毒
	;　　16,精液中毒 　　17,レズ中毒 18,セックス中毒 　　19,噴乳中毒
	;　　20,ＢＬっ気 　　21,ＢＬ中毒
	
	IF ABL:T:COUNT > 0
		;表示位置あわせ
		IF COUNT == 7 || COUNT == 9 || COUNT == 10 || COUNT == 11 || COUNT == 12 || COUNT == 13 || COUNT == 14 || COUNT == 15 || COUNT == 16 || COUNT == 17 || COUNT == 19 || COUNT == 20 || COUNT == 21
			PRINT 　　
		ELSEIF COUNT == 3 || COUNT == 4 || COUNT == 5 || COUNT == 6 || COUNT == 8
			PRINT 　　　
		ELSEIF COUNT == 0 || COUNT == 1 || COUNT == 2
			PRINT 　　　　
		ENDIF
		
		;表示
		PRINTFORM %ABLNAME:COUNT%:LV
		;数字の表示位置をそろえる
		SIF ABL:T:COUNT < 10
			PRINT  
		PRINTFORM {ABL:T:COUNT}
		S += 1
		;改行するのか？ 続けて出力するのか？
		IF S == 4
			PRINTL 
			S = 0
		ELSE
			PRINT 　
		ENDIF
	ENDIF
REND
PRINTL 

;=============================================================================
;PRINT_TALENT （素質）との入れ替え
@SHOW_INFO_TALENT
U = 0
;リピート回数-1 の番号までの素質が表示される
;リピート回数をあらかじめ大きめに設定（最大1000）しておくと、
;素質の最大番号が増えたときに書き換える手間が減るが、
;増やしすぎると処理速度に影響するので要注意
REPEAT 200
	IF TALENT:T:COUNT
		PRINTFORM [%TALENTNAME:COUNT%] 
		
		;改行するのか？ 続けて出力するのか？
		U += 1
		SIF U%6 == 0
			PRINTL 
	ENDIF
REND
;最後のループで改行してなかったら、ここで改行しておく
SIF U%6 != 0
	PRINTL 


;=============================================================================
;PRINT_MARK （刻印）との入れ替え
@SHOW_INFO_MARK
REPEAT 4
	PRINTFORM %MARKNAME:COUNT%:LV{MARK:T:COUNT} 
	BAR MARK:T:COUNT, 3, 3
	
	;最後のループ以外では間隔をあける
	SIF COUNT < 3
		PRINT 　
REND
PRINTL 

