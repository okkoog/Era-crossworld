	ENDIF
REND

;仕送りイベント
CALL REMITTANCE

;出産･育児室関連
IF FLAG:出産機能ONOFF
	FOR LOCAL:6, 0, CHARANUM
		IF TALENT:(LOCAL:6):153
			;出産2日前からは臨月突入で調教不可に
			IF (CFLAG:(LOCAL:6):110 - 2) == DAY
				DRAWLINE
				C = LOCAL:6
				CALL REACH_FULL_TERM
			;出産予定日なら出産
			ELSEIF CFLAG:(LOCAL:6):110 <= DAY
				DRAWLINE
				C = LOCAL:6
				CALL CHILD_BIRTH
			ENDIF
		ELSEIF TALENT:(LOCAL:6):154
			;出産後翌日には育児室への訪問を問うイベント発生
			;親離れで調教可能に
			IF (CFLAG:(LOCAL:6):110 + 1) <= DAY && TFLAG:701 != DAY
				DRAWLINE
				PRINTFORML %CALLNAME:(LOCAL:6)%の出産から一日経ちました
				C = LOCAL:6
				CALL DEPEARENT
			ENDIF
		ENDIF
		
	NEXT
ENDIF

REPEAT CHARANUM
	;娘成長イベント
	SIF MARK:COUNT:6 >= 1 && DAY >= (CFLAG:COUNT:娘の誕生日 + 5) && CFLAG:COUNT:娘の誕生日 != 0
		CALL CHILD_GROWTH
REND
