@EVENT_NEXTDAY
$INPUT_LOOP
;不思議の根持ちで精液経験が300以上で生える
IF TARGET >= 0 
	IF TALENT:TARGET:138 == 1 && EXP:TARGET:20 >= 300 && TALENT:139 == 0 && !IS_MALE(TARGET)
		DRAWLINE
		PRINTFORML ……どうやら[不思議な根]の効果が現れそうだ
		PRINTFORMW %CALLNAME:TARGET%を[ふたなり]にしますか？
		PRINTL [0] - する
		PRINTL [1] - しない
		INPUT
		IF RESULT == 0
			PRINTFORML %NAME:TARGET%の[不思議な根]は[ふたなり]となった
			TALENT:139 = 1
		ELSEIF RESULT == 1
			PRINTFORML %NAME:TARGET%は[不思議な根]を失った
		ELSE
			GOTO INPUT_LOOP
		ENDIF
		DRAWLINE
		WAIT
		TALENT:TARGET:138 = 0
	ENDIF
ENDIF

$INPUT_LOOP_2
;具現持ちでレズ経験2500以上で生える
IF TARGET >= 0 
	IF TALENT:TARGET:146 == 1 && EXP:TARGET:40 >= 2500 && TALENT:139 == 0 && !IS_MALE(TARGET)
		DRAWLINE
		PRINTFORML ……どうやら[具現]の効果が現れそうだ
		PRINTFORML %CALLNAME:TARGET%を[ふたなり]にしますか？
		PRINTL [0] - する
		PRINTL [1] - しない
		INPUT
		IF RESULT == 0
			PRINTFORML %NAME:TARGET%は[具現]によって[ふたなり]となった
			TALENT:139 = 1
		ELSEIF RESULT == 1
			PRINTFORML %NAME:TARGET%は[具現]を失った
		ELSE
			GOTO INPUT_LOOP_2
		ENDIF
		DRAWLINE
		WAIT
		TALENT:TARGET:146 = 0
	ENDIF
ENDIF

;放尿経験３０以上でおもらし癖がつく
IF TARGET >= 0 
	IF TALENT:57 == 0
		IF (TALENT:TARGET:151 && EXP:TARGET:31 >= 10) || (TALENT:TARGET:151 == 0 && EXP:TARGET:31 >= 30)
			PRINTFORMW （む･･･なんだこれ？）
			PRINTFORM %CALLNAME:TARGET%は
			SIF TALENT:TARGET:151 && EXP:TARGET:31 >= 10
			PRINTFORM おねしょを
			SIF TALENT:TARGET:151 == 0 && EXP:TARGET:31 >= 30 
			PRINTFORM 粗相を
			PRINTFORMW してしまったようだ……
			PRINTFORMW %CALLNAME:TARGET%は[おもらし癖]がついた
			TALENT:TARGET:57 = 1
		ENDIF
	ENDIF
ENDIF

IF TARGET >= 0 
	;反発刻印３があり、かつ幼稚である時に
	IF TALENT:TARGET:151 && MARK:3 == 3
		;欲望が5かつ従順が5かつマゾっ気が5かつ異常経験が７以上になる
		SIF ABL:TARGET:1 >= 5 && ABL:TARGET:0 >= 5 && ABL:TARGET:9 >= 5 && EXP:TARGET:50 >= 7
			CALL EVENT_YOUJI
	;反発刻印３があり、かつ幼稚がない時
	ELSEIF TALENT:TARGET:151 == 0 && MARK:3 == 3
		;欲望が5かつ従順が5かつマゾっ気が5かつ異常経験が９以上に加え露出５とおもらし癖がある
		SIF ABL:TARGET:1 >= 5 && ABL:TARGET:0 >= 5 && ABL:TARGET:9 >= 5 && ABL:TARGET:8 >= 5 && EXP:TARGET:50 >= 9 && TALENT:57 == 1
			CALL EVENT_YOUJI
	ENDIF
ENDIF

