		SIF LOCALS == "" || !GETBIT(CFLAG:調教メニュー表示設定, LOCAL+5)
			CONTINUE
		PRINTFORMC %LOCALS%[{986+LOCAL}]
		CALL CHECK_NEWLINE
	NEXT
	;IF FLAG:550 > 0
	;	PRINTC 調教メニュー表示[991]
	;	CALL CHECK_NEWLINE
	;	PRINTC 調教メニュー実行[992]
	;	CALL CHECK_NEWLINE
	;ENDIF

