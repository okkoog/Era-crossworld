FOR LOCAL,0,16
	SELECTCASE LOCAL
		CASE 13,14
			CONTINUE
		CASEELSE
			IF CFLAG:TARGET:(CFLAGNAME:(170+LOCAL)) == 0
				SETCOLOR COLOR("aqua")
			ELSE
				SETCOLOR COLOR("light-gray")
			ENDIF
