IF ARG:1 == 0
	IF ARG == 11
		IF ARG:2 == PLAYER
			PRINTW 外した
		ELSE
			PRINTW 外させた
		ENDIF
	ELSE
		IF ARG:2 == PLAYER
			PRINTW 脱いだ
		ELSE
			PRINTW 脱がした
		ENDIF
	ENDIF
ELSE
	SELECTCASE ARG
		CASE 0,4,5,11
			PRINTW つけた
		CASE 1,3,7,10
			IF ARG:2 == PLAYER
				PRINTW 着た
			ELSE
				PRINTW 着せた
			ENDIF
		CASE 2,6,8,9
			IF ARG:2 == PLAYER
				PRINTW 穿いた
			ELSE
				PRINTW 穿かせた
			ENDIF
	ENDSELECT
ENDIF

