@EQUIP_CLOTHES
;着衣状態によるソースを付加（手以外の１箇所ごとに露出+5、未陥落時反感+5）
;EQUIPによる制御に変更するまで封印
;予定・胸とヴァギナが露出するような組み合わせだとさらに＋5


;脚露出
IF TEQUIP:脚露出 == -1
	SOURCE:13 += 3
	;陥落時は反感を加算しない
	SIF (TALENT:恋慕 || TALENT:淫乱 || TALENT:服従 || TALENT:親愛 || TALENT:娼婦 || TALENT:隷属) == 0
		SOURCE:18 += 3
ENDIF

;臍露出
IF TEQUIP:臍露出 == -1
	SOURCE:13 += 3
	;陥落時は反感を加算しない
	SIF (TALENT:恋慕 || TALENT:淫乱 || TALENT:服従 || TALENT:親愛 || TALENT:娼婦 || TALENT:隷属) == 0
		SOURCE:18 += 3
ENDIF

;乳房露出
IF TEQUIP:乳房露出 == -1
	SOURCE:13 += 3
	;陥落時は反感を加算しない
	SIF (TALENT:恋慕 || TALENT:淫乱 || TALENT:服従 || TALENT:親愛 || TALENT:娼婦 || TALENT:隷属) == 0
		SOURCE:18 += 3
ENDIF

;乳首露出
IF TEQUIP:乳首露出 == -1
	SOURCE:13 += 10
	;陥落時は反感を加算しない
	SIF (TALENT:恋慕 || TALENT:淫乱 || TALENT:服従 || TALENT:親愛 || TALENT:娼婦 || TALENT:隷属) == 0
		SOURCE:18 += 10
	;乳房は隠れているのに乳首が出てたら+6
	IF TEQUIP:乳房露出 != -1
		SOURCE:13 += 6
		;陥落時は反感を加算しない
		SIF (TALENT:恋慕 || TALENT:淫乱 || TALENT:服従 || TALENT:親愛 || TALENT:娼婦 || TALENT:隷属) == 0
			SOURCE:18 += 6
	ENDIF
ENDIF

;陰唇露出
IF TEQUIP:陰唇露出 == -1
	SOURCE:13 += 10
	;陥落時は反感を加算しない
	SIF (TALENT:恋慕 || TALENT:淫乱 || TALENT:服従 || TALENT:親愛 || TALENT:娼婦 || TALENT:隷属) == 0
		SOURCE:18 += 10
	;脚は隠れているのに陰唇が出てたら+3
	IF TEQUIP:脚露出 != -1
		SOURCE:13 += 3
		;陥落時は反感を加算しない
		SIF (TALENT:恋慕 || TALENT:淫乱 || TALENT:服従 || TALENT:親愛 || TALENT:娼婦 || TALENT:隷属) == 0
			SOURCE:18 += 3
	ENDIF
	;臍は隠れているのに陰唇が出てたら+3
	IF TEQUIP:臍露出 != -1
		SOURCE:13 += 3
		;陥落時は反感を加算しない
		SIF (TALENT:恋慕 || TALENT:淫乱 || TALENT:服従 || TALENT:親愛 || TALENT:娼婦 || TALENT:隷属) == 0
			SOURCE:18 += 3
	ENDIF
ENDIF

;臀部露出
