;-------------------------------------------------
;子供誕生判定処理
;他に呼び出すこともないようだし、この場合、飛ばすより一本道でやったほうが流れを把握しやすいと思うので
;-------------------------------------------------
@DAUGHTER_CHECK, ARG
;急成長するか、それは娘か息子かなどを判定します。
;ARGは育ての親の登録番号
TFLAG:600 = 0
SIF MONEY <= 50000
	CFLAG:ARG:娘教育 = 0
ARG:1 = FINDCHARA_ID(CFLAG:ARG:娘の産みの親の固有番号親)
ARG:2 = FINDCHARA_ID(CFLAG:ARG:父親の固有番号親)

;産んだ子供の数をサーチした産みの親に追加
SIF ARG:1 != -1
	CFLAG:(ARG:1):第何子まで産んだか += 1
SIF ARG:2 >= 0
	CFLAG:(ARG:2):第何子まで産んだか += 1

;-------------------------------------------------
;子供の性別を判定
;男×女　男の娘×男→男:女：男の娘 = 4:5:1
;男の娘×女 = 男の娘:女 = 5:5
;女×女 = 女
;男の娘 × 男の娘 = 男の娘
;-------------------------------------------------
FLAG:娘性別判定処理 = 0
IF ARG:1 >= 0
	IF ARG:2 >= 0
		LOCAL:3 = TALENT:(ARG:2):オトコ + TALENT:(ARG:1):男の娘
	ELSEIF CFLAG:ARG:父親の固有番号親 == -1 && CFLAG:ARG:妊娠確定後の父親の判定 > -1
		LOCAL:3 = CSVTALENT(CFLAG:ARG:妊娠確定後の父親の判定, GETNUM(TALENT, "オトコ"),0) + CSVTALENT(CFLAG:ARG:妊娠確定後の父親の判定, GETNUM(TALENT, "男の娘"),0)
	ELSE
		LOCAL:3 = 1
	ENDIF
	IF TALENT:(ARG:1):男の娘
		;男の娘
		SELECTCASE LOCAL:3
			;女
			CASE 0
				FLAG:娘性別判定処理 = 1 + RAND:2 * 2
			;男
			CASE 1
				FLAG:娘性別判定処理 = 1 + RAND:2
				SIF !RAND:10 && FLAG:娘性別判定処理 == 2
					FLAG:娘性別判定処理 = 3
			;男の娘
			CASE 2
				FLAG:娘性別判定処理 = 3
		ENDSELECT
	ELSE
		;女
		SELECTCASE LOCAL:3
			;女
			CASE 0
				FLAG:娘性別判定処理 = 2
			;男
			CASE 1
				FLAG:娘性別判定処理 = 1 + RAND:2
				SIF !RAND:10 && FLAG:娘性別判定処理 == 2
					FLAG:娘性別判定処理 = 3
			;男の娘
			CASE 2
				FLAG:娘性別判定処理 = 1 + RAND:2 * 2
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;子供の種族を判定
	;-------------------------------------------------
	IF ARG:2 >= 0
		;父親健在の場合はそのまま使う
		LOCAL:3 = ABL:(ARG:2):種族
	ELSE
		;父親不在だが、キャラ番号は持っている
		IF CFLAG:ARG:父親の固有番号親 == -1 && CFLAG:ARG:妊娠確定後の父親の判定 >= 0
			LOCAL:3 = CSVABL(CFLAG:ARG:妊娠確定後の父親の判定, GETNUM(ABL, "種族"),0)
		;親が触手の場合は、母親と同一種族として扱う
		ELSEIF CFLAG:ARG:父親の固有番号親 == -2
			LOCAL:3 = ABL:(ARG:1):種族
		;その他は人間として扱う
		ELSE
			LOCAL:3 = 0
		ENDIF
	ENDIF
	SELECTCASE ABL:(ARG:1):種族
		;人間
		CASE 0
			SELECTCASE LOCAL:3
				;人間
				CASE 0
					FLAG:娘種族判定処理 = 0
				;造魔
				CASE 45
					FLAG:娘種族判定処理 = 0
				;悪魔
				CASEELSE
					;半魔人
					FLAG:娘種族判定処理 = 36
			ENDSELECT
		;造魔
		CASE 45
			SELECTCASE LOCAL:3
				;人間
				CASE 0
					FLAG:娘種族判定処理 = 0
				;造魔
				CASE 45
					;怪異
					FLAG:娘種族判定処理 = 32
				;悪魔
				CASEELSE
					FLAG:娘種族判定処理 = LOCAL:3
			ENDSELECT
		;悪魔
		CASEELSE
			SELECTCASE LOCAL:3
				;人間
				CASE 0
					;半魔人
					FLAG:娘種族判定処理 = 36
				;造魔
				CASE 45
					FLAG:娘種族判定処理 = LOCAL:3
				;悪魔
				CASEELSE
					FLAG:娘種族判定処理 = RAND:2 ? ABL:(ARG:1):種族 # LOCAL:3
			ENDSELECT
	ENDSELECT
ENDIF
IF CFLAG:ARG:娘の産みの親のキャラ番号親 != -1 && TALENT:MASTER:禁断の知識 && CHARANUM < 200
	IF FLAG:娘性別判定処理 == 2
		PRINTFORML %CALLNAME:ARG%の育てていた娘が急激に成長し、調教できる程度になりました。
	ELSE
		PRINTFORML %CALLNAME:ARG%の育てていた息子が急激に成長し、調教できる程度になりました。
	ENDIF
	PRINTFORMW 調教しますか？
	PRINTL [0]Yes [1]No
	$INPUT_DAUGHTER
	INPUT
	IF RESULT == 0
		LOCAL:2 = -1
		;父親がいない場合
		IF ARG:2 == -1
			;父親のNOを保持していればそのキャラを生成する
			IF CFLAG:ARG:妊娠確定後の父親の判定 >= 0
				ADDCHARA CFLAG:ARG:妊娠確定後の父親の判定
				LOCAL:2 = CHARANUM - 1
				ARG:2 = LOCAL:2
				;顧客異能者
				IF CFLAG:ARG:父親の固有番号親 == -3
					LOCAL:4 = 1
					FOR LOCAL:3, 1 , 20
						IF ABL:(LOCAL:2):("習得スキル"+TOSTR(LOCAL:3))
							ABL:(LOCAL:2):("スキル"+TOSTR(LOCAL:4)) = ABL:(LOCAL:2):("習得スキル"+TOSTR(LOCAL:3))
							LOCAL:4++
						ENDIF
						SIF LOCAL:4 == 9
							BREAK
					NEXT
				ENDIF
			;いない場合は自分自身と判定させる
			ELSE
				ARG:2 = ARG:1
			ENDIF
		ENDIF
		CALL DAUGHTER_BIRTH, ARG, ARG:1, ARG:2
		;キャラ作成していたときはDEL
		IF LOCAL:2 > -1
			ARG:2 = -1
			DELCHARA LOCAL:2
		ENDIF
	ELSEIF RESULT == 1
		CALL SON_BIRTH, ARG, ARG:1
	ELSE
		GOTO INPUT_DAUGHTER
	ENDIF
ELSEIF CFLAG:ARG:娘の産みの親のキャラ番号親 != -1
;条件を満たさなくても産んだ子供の数は増える
	PRINTFORML %CALLNAME:ARG%の育てていた子供が急激に成長し、大人になりました。
	CALL SON_BIRTH, ARG, ARG:1
ENDIF
;育ての親のフラグリセット
CFLAG:ARG:出産日 = 0
CFLAG:ARG:父親の固有番号親 = 0
CFLAG:ARG:娘の産みの親のキャラ番号親 = 0
CFLAG:ARG:娘の産みの親の固有番号親 = 0
SIF CFLAG:ARG:娘教育 == 1
	MONEY -= 50000
CFLAG:ARG:娘教育 = 0

;-------------------------------------------------
;男の子誕生処理
;-------------------------------------------------
@SON_BIRTH, ARG, ARG:1
;産んだ子供の数+1
IF ARG:1 == -1
	PRINTFORMW %CALLNAME:ARG%の育てていた子供は親を追いかけ出て行きました。
	RETURN 0
ELSE
	PRINTFORMW 子供は自分を育ててくれたことに感謝し、一人暮らしを始めた・・・
	;仕送り人数増加
	CFLAG:(ARG:1):仕送り時してくれる人数親 += 1
ENDIF

;-------------------------------------------------
;女の子誕生処理
;-------------------------------------------------
@DAUGHTER_BIRTH, ARG, ARG:1, ARG:2
;もう産みの親がいない場合、娘を加えることはできない
IF ARG:1 == -1
	PRINTFORMW しかし%CALLNAME:ARG%の育てていた子供は親を追いかけ出て行きました。
	RETURN 1
ENDIF
LOCAL:10 = TARGET

$DAUGHTER_BIRTH_TW
IF ARG:1 == CFLAG:MASTER:キャラ固有の番号 || ARG:2 == CFLAG:MASTER:キャラ固有の番号
	CALL ADD_NEW_COMPANION,3501,500
ELSE
	CALL ADD_NEW_COMPANION,3502,500
ENDIF
TARGET = RESULT:1

CALL DAUGHTER_TALENT_SET2, ARG, ARG:1, ARG:2

;フラグ立て
CFLAG:娘の誕生日 = CFLAG:ARG:出産日
CFLAG:娘の産みの親のキャラ番号娘 = NO:(ARG:1)
CFLAG:娘の育ての親のキャラ番号娘 = NO:ARG
CFLAG:娘が母の第何子か娘 = CFLAG:(ARG:1):第何子まで産んだか
CFLAG:娘の父親のキャラ番号娘 = CFLAG:ARG:111
SIF ARG:2 >= 0
	CFLAG:娘が父の第何子か = CFLAG:(ARG:2):第何子まで産んだか
CFLAG:娘の産みの親の固有番号娘 = CFLAG:(ARG:1):キャラ固有の番号
CFLAG:娘の育ての親の固有番号娘 = CFLAG:ARG:キャラ固有の番号
CFLAG:娘の父親の固有番号娘 = CFLAG:(ARG:1):父親の固有番号親
CFLAG:娘の世代娘 = CFLAG:(ARG:1):娘の世代娘+ 1
;相性設定
CALL SET_RELATION, TARGET

PRINTFORMW %CALLNAME:ARG%の育てていた子供が調教可能になりました。
PRINTFORML %CALLNAME:ARG%に名前を付けてもらいますか？
PRINTL [0] 任せます
PRINTL [1] 自分で付けます
$INPUT_LOOP_A
INPUT
;嫁に任せる
IF RESULT ==0
	CALL DAUGHTER_NAME, ARG, ARG:1, ARG:2
	PRINTFORM %CALLNAME:ARG%はこの娘
	PRINTFORM に%CALLNAME%
	PRINTL という名前を付けました
ELSEIF RESULT == 1
	PRINTL 名前を入力してください
	INPUTS
	NAME:TARGET = %RESULTS%
	CALLNAME:TARGET = %RESULTS%
	PRINTW 名前を登録しました
ELSE
	PRINTL 正しい値を入力してください
	GOTO INPUT_LOOP_A
ENDIF

PRINTL ニックネームを付けますか？
PRINTL [0] はい
PRINTL [1] いいえ
$INPUT_LOOP_B
INPUT
IF RESULT == 0
	PRINTL ニックネームを入力してください
	INPUTS
	CALLNAME:TARGET = %RESULTS%
	PRINTW ニックネームを登録しました
ELSEIF RESULT != 1
	PRINTL 正しい値を入力してください
	GOTO INPUT_LOOP_B
ENDIF
IF CFLAG:ARG:父親の固有番号親 == -2
	CSTR:解説1 = 急激に成長した%CALLNAME:(ARG:1)%と触手の子。
ELSEIF CFLAG:ARG:父親の固有番号親 >= 0 && CFLAG:ARG:妊娠確定後の父親の判定 >= 0
	CSTR:解説1 = 急激に成長した%CALLNAME:(ARG:1)%と%CALLNAME:(ARG:2)%の子。
ELSE
	CSTR:解説1 = 急激に成長した%CALLNAME:(ARG:1)%の子。
ENDIF

IF ABL:種族 == 32
	CSTR:解説2 = 何らかの悪魔の一種のようだ
ELSEIF ABL:種族 == 36
	CSTR:解説2 = 人と悪魔の混血で未知の力を秘めているようだ
ELSEIF ABL:種族 == 0
	CSTR:解説2 = 異能を持つ人間のようだ
ELSE
	CSTR:解説2 = 親と同じ種族のようだ
ENDIF
CSTR:母 = %CALLNAME:(ARG:1)%(第{CFLAG:(ARG:1):第何子まで産んだか}子)
;IDを持つ親ならここで取る
IF CFLAG:ARG:父親の固有番号親 >= 0
	CSTR:父 = %CALLNAME:(ARG:2)%(第{CFLAG:(ARG:2):第何子まで産んだか}子)
;名称を保持している場合はそこからとる
ELSEIF STRLENS(CSTR:ARG:父親名称)
	CSTR:父 = %CSTR:ARG:父親名称%
;保持していない場合はCSVからとる
ELSEIF CFLAG:ARG:妊娠確定後の父親の判定 >= 0
	CSTR:父 = %CSVCALLNAME(CFLAG:ARG:妊娠確定後の父親の判定, 0)%
ELSEIF CFLAG:ARG:父親の固有番号親 == -2
	CSTR:父 = 触手
ELSE
	CSTR:父 = 不明
ENDIF
;次回のために消しておく
CSTR:ARG:父親名称 = 
IF TALENT:(ARG:1):子供
	CSTR:母祖父 = %CSTR:(ARG:1):父%
	CSTR:母祖母 = %CSTR:(ARG:1):母%
ELSE
	CSTR:母祖父 = 不明
	CSTR:母祖母 = 不明
ENDIF
IF CFLAG:ARG:父親の固有番号親 >= 0
	IF TALENT:(ARG:2):子供
		CSTR:父祖父 = %CSTR:(ARG:2):父%
		CSTR:父祖母 = %CSTR:(ARG:2):母%
	ELSE
		CSTR:父祖父 = 不明
		CSTR:父祖母 = 不明
	ENDIF
ELSE
	CSTR:父祖父 = 不明
	CSTR:父祖母 = 不明
ENDIF
CSTR:一人称 = %CSTR:(ARG:1):一人称%
TARGET = LOCAL:10
;-------------------------------------------------
;仕送り
;-------------------------------------------------
@REMITTANCE
#LOCALSIZE 3
;仕送り人数総数をカウント
LOCAL = 0
LOCAL:1 = 0
FOR LOCAL:2, 0, CHARANUM
	SIF CFLAG:(LOCAL:2):仕送り時してくれる人数親 == 0
		CONTINUE
	IF CFLAG:(LOCAL:2):引継ぎ回数 && FLAG:5 < 9
		LOCAL:1 += CFLAG:(LOCAL:2):仕送り時してくれる人数親
	ELSE
		LOCAL += CFLAG:(LOCAL:2):仕送り時してくれる人数親
	ENDIF
NEXT
;0人なら帰れ
SIF LOCAL+LOCAL:1 <= 0
	RETURN 0
DRAWLINE
PRINTFORM %CALLNAME:MASTER%の子供
SIF LOCAL+LOCAL:1 > 1
	PRINT 達
;人数×￥500
LOCAL *= 500
LOCAL:1 *= 10
;75%~125%でランダムをかける
;ランダムの種として主人の経験値とDAYを用いる
LOCAL:2 = MAX(1, (LOCAL + MIN(1000,LOCAL:1)) * ((BASE:MASTER:ＥＸＰ / (DAY+1)) % 50 + 75) / 100)
MONEY += LOCAL:2
PRINTFORMW から仕送り￥{LOCAL:2}が届きました

