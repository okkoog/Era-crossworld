	;貧乳
	SIF TALENT:(LOCAL:2):貧乳
		LOCAL:3 -= 2
	;巨乳
	SIF TALENT:(LOCAL:2):巨乳
		LOCAL:3 += 2
	;爆乳
	SIF TALENT:(LOCAL:2):爆乳
