			IF LOCAL:3 >= 0
				LOCAL:2 = ABL:(LOCAL:3):(LOCAL:4)
			ELSE
				LOCAL:2 = LOCAL:4 > 190 ? CSVABL(CFLAG:初期リンク悪魔, LOCAL:4+4, 0) # CSVABL(CFLAG:初期リンク悪魔, LOCAL:4-100, 0)
			ENDIF
			ABL:(LOCAL:4) = LOCAL:2
		NEXT
		;悪魔形質を引き継ぐ場合はスキルをリンク悪魔側に移す
		IF LOCAL:3 == -1
			FOR LOCAL:2, 1, FLAG:スキル数+1
				LOCALS = スキル{LOCAL:2}
				LOCALS:1 = 初期変身悪魔スキル{LOCAL:2}
