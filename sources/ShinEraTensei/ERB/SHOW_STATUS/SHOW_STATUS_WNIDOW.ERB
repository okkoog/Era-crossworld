;=======================================
;スキルウィンドウ
;=======================================
@STATUS_WINDOW_SKILL , ARG , ARG:1 , ARG:2
#DIM 横幅
#DIM 基準位置 , 2
横幅 = 46

CALL SET_PICTURE , @"┏SKILL %"━" * (横幅 / 2 -3)%┓" , ARG:1 , , ARG:2
CALL SET_PICTURE , @"┃%" " * 横幅%┃" , ARG:1+1 , , ARG:2
CALL SET_PICTURE , @"┃%" " * 横幅%┃" , ARG:1+2 , , ARG:2
CALL SET_PICTURE , @"┃%" " * 横幅%┃" , ARG:1+3 , , ARG:2
CALL SET_PICTURE , @"┃%" " * 横幅%┃" , ARG:1+4 , , ARG:2
CALL SET_PICTURE , @"┃%" " * 横幅%┃" , ARG:1+5 , , ARG:2
CALL SET_PICTURE , @"_┗%"━" * (横幅 / 2)%┛_" , ARG:1+6 , , ARG:2

;スキル表示
IF ABL:ARG:種族 != 0 || TALENT:ARG:異能者 || TALENT:ARG:達人 || TALENT:ARG:ペルソナ使い || TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
	基準位置:0 = ARG:1 + 1
	基準位置:1 = ARG:2 + 2
	FOR LOCAL , 1 , FLAG:スキル数 + 1
		SIF ABL:ARG:@"スキル{LOCAL}"
			CALL SET_PICTURE , @"_[{LOCAL}]%SKILL_NAME_F(ABL:ARG:@"スキル{LOCAL}"),20,LEFT%,,,{LOCAL}_" , 基準位置:0 + (LOCAL-1) / 2 , , 基準位置:1 + (LOCAL-1) % 2 * 23
	NEXT
	IF CFLAG:ARG:PTフラグ > 0
		;LOCAL:1 = 表示する習得予定スキル
		LOCAL:1 = 0
		FOR LOCAL,1, 21
			LOCALS:1 = 習得LV{LOCAL}
			IF ABL:ARG:(LOCALS:1) > 0
				IF LOCAL:1 == 0
					LOCAL:1 = LOCAL
				ELSE
					SIF ABL:ARG:("習得LV" + TOSTR(LOCAL:1)) > ABL:ARG:(LOCALS:1)
						LOCAL:1 = LOCAL
				ENDIF
			ENDIF
		NEXT
		IF LOCAL:1 > 0
			LOCALS:1 = 習得LV{LOCAL:1}
			LOCALS = 習得スキル{LOCAL:1}
			LOCALS:2 = \@ ABL:ARG:(LOCALS:1) > (BASE:ARG:LV)+5 ? 　　？？？？？？　　 # %SKILL_NAME_F(ABL:ARG:LOCALS)% \@ 
			CALL SET_PICTURE , @"　　NEXT[%LOCALS:2,20,LEFT%]　習得LV {ABL:ARG:(LOCALS:1)},0x666666" , 基準位置:0 + FLAG:スキル数/2 , , 基準位置:1
		ENDIF
	ENDIF
ENDIF
;装備スキル表示
IF ABL:ARG:種族 == 0
	IF TALENT:ARG:異能者 || TALENT:ARG:達人 || TALENT:ARG:ペルソナ使い || TALENT:ARG:デビルシフター || TALENT:ARG:喰奴
		基準位置:0 = 基準位置:0 + FLAG:スキル数/2 + 3
		基準位置:1 = ARG:2 + 2
		
		;FLAG:DEBUG = 10000
		CALL SET_PICTURE , @"┣%"━" * (横幅 / 2)%┫" , ARG:1+6 , , ARG:2
		;FLAG:DEBUG = 0
		;PRINTL はう
;CALL SET_PICTURE ,  , 0 , "WAIT" , 35
		FOR LOCAL , 0 , 5
			CALL SET_PICTURE , @"┃%" " * 横幅%┃" , ARG:1+7 + LOCAL , , ARG:2
		NEXT
		CALL SET_PICTURE , @"┗%"━" * (横幅 / 2)%┛" , ARG:1+12 , , ARG:2
		
	ELSE
		基準位置:0 = ARG:1 + 2
		基準位置:1 = ARG:2 + 2
	ENDIF
	CALL SET_PICTURE , @"◇装備スキル" , 基準位置:0 -1 , , 基準位置:1
	
	FOR LOCAL , 1 , 9
		SIF ABL:ARG:@"装備スキル{LOCAL}"
			CALL SET_PICTURE , @"_[{LOCAL+20}]%SKILL_NAME_F(ABL:ARG:@"装備スキル{LOCAL}"),20,LEFT%,,,{LOCAL+20}_" , 基準位置:0 + (LOCAL-1) / 2 , , 基準位置:1 + (LOCAL-1) % 2
	NEXT
ENDIF

