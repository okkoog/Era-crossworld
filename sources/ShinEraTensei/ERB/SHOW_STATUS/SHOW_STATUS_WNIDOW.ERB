ENDIF

;4*5にしておこう
IF GROUPMATCH(ABL:ARG:種族 , 0 , 36)
	CALL SET_PICTURE , @"EQUIP " , ARG:1 , , ARG:2 + 2
	FOR LOCAL , 1 , 9
		CALL SET_PICTURE , @"┃%" " * 横幅%┃" , ARG:1+LOCAL , , ARG:2
	NEXT
	CALL SET_PICTURE , @"┗%"━" * (横幅 / 2)%┛" , ARG:1+9 , , ARG:2
	FOR LOCAL , 0 , 7
		IF ARG:3 && 変更装備箇所 == LOCAL
			LOCALS = [{50+LOCAL}]%"[" + GET_EQUIP(LOCAL) + "]",14,LEFT%,{COLOR("パ緑")},,{50+LOCAL}_
		ELSE
			LOCALS = [{50+LOCAL}]%"[" + GET_EQUIP(LOCAL) + "]",14,LEFT%,,,{50+LOCAL}_
		ENDIF
		
		IF ARG:3 && 変更予定装備:LOCAL > -1
			IF 魔晶装備(変更予定装備:LOCAL)
				LOCALS += EQ_GETNAME_魔晶装備_ITEM(変更予定装備:LOCAL)+ @",{COLOR("パ緑")}"
			ELSEIF 変更予定装備:LOCAL == 0
				LOCALS += @"ＥＭＰＴＹ,{COLOR("パ緑")}"
			ELSE
				LOCALS += ITEMNAME:(変更予定装備:LOCAL)+ @",{COLOR("パ緑")}"
			ENDIF
		ELSEIF EQUIP:ARG:GET_EQUIP(LOCAL) == 0
			LOCALS += "ＥＭＰＴＹ,0x404040"
		ELSEIF 魔晶装備(EQUIP:ARG:GET_EQUIP(LOCAL))
			LOCALS += EQ_GETNAME_魔晶装備_CHARA(ARG, LOCAL)+ ","
		ELSE
			LOCALS += ITEMNAME:(EQUIP:ARG:GET_EQUIP(LOCAL))+ ","
		ENDIF
			
		CALL SET_PICTURE , @"%LOCALS%,,{50+LOCAL}_" , ARG:1 + 1 + LOCAL , , ARG:2+2
	NEXT
	IF TALENT:ARG:ガンスリンガー && EQUIP:ARG:銃
		CALL SET_PICTURE , @"[57][特殊弾変更],,,57_" , ARG:1 + 1 + LOCAL , , ARG:2+2
	ELSE
		CALL SET_PICTURE , @"[--][----------]" , ARG:1 + 1 + LOCAL , , ARG:2+2
	ENDIF
	
ELSE
	CALL SET_PICTURE , @"PLUGIN" , ARG:1 , , ARG:2 + 2
	CALL SET_PICTURE , @"┃%" " * 横幅%┃" , ARG:1+1 , , ARG:2
	CALL SET_PICTURE , @"┗%"━" * (横幅 / 2)%┛" , ARG:1+2 , , ARG:2
	
	IF ARG:3 && 変更予定装備:6 > -1
		CALL SET_PICTURE , @"_[50][%PLUGINNAME(変更予定装備:6)%],{COLOR("パ緑")},,50_" , ARG:1+1 , , ARG:2 + 2
	ELSEIF EQUIP:ARG:アクセサリ
		CALL SET_PICTURE , @"_[50][%PLUGINNAME(EQUIP:ARG:アクセサリ)%],,,50_" , ARG:1+1 , , ARG:2 + 2
	ELSE
		CALL SET_PICTURE , @"_[50][----------],,,50" , ARG:1+1 , , ARG:2 + 2
		
	ENDIF
	
ENDIF

;=======================================
;装備品データウィンドウ
;ARG:3が装備品の番号
;=======================================
@STATUS_WINDOW_EQUIP_DATA , ARG , ARG:1 , ARG:2 , ARG:3 , ARGS
#DIM 横幅
#DIM 表示情報
#DIM 攻撃回数 , 2
#DIMS 攻撃範囲 , 2
IF ARGS == "表示切替+"
	表示情報++
	SIF 表示情報 > 2
		表示情報 = 0
	RETURN 0
ELSEIF ARGS == "表示切替-"
	表示情報--
	SIF 表示情報 < 0
		表示情報 = 2
	RETURN 0
ENDIF
横幅 = 42
CALL SET_PICTURE , @"┏%"━" * (横幅 / 2)%┓" , ARG:1 , , ARG:2
CALL SET_PICTURE , @"┃%" " * 横幅%┃" , ARG:1+1 , , ARG:2
IF ARG:3 == 0
	CALL SET_PICTURE , @"ＥＭＰＴＹ,{COLOR("gray")}" , ARG:1+1 , , ARG:2 + 2
ELSE
	CALL SET_PICTURE , @"%ITEMNAME:(ARG:3)%" , ARG:1+1 , , ARG:2 + 2
ENDIF
CALL SET_PICTURE , @"┣%"━" * (横幅 / 2)%┫" , ARG:1+2 , , ARG:2

FOR LOCAL , 3 , 9
	CALL SET_PICTURE , @"┃%" " * 横幅%┃" , ARG:1+LOCAL , , ARG:2
NEXT
CALL SET_PICTURE , @"┗%"━" * (横幅 / 2)%┛" , ARG:1+9 , , ARG:2
IF 表示情報 == 0
	;基本性能
	FOR LOCAL , 0 , 6
		CALLFORM EQUIP_PROPERTY , ARG:3 , "戦闘能力修正" , LOCAL , ARG
		;SIF RESULT
		CALL SET_PICTURE , @"%GET_BATTLESTATUS(LOCAL),8%_ {RESULT,3},{COLOR(AUTO_SPLIT("RED_GRAY_DEF" , "_" , (RESULT > 0) + (RESULT >= 0)))}" , ARG:1+3+(LOCAL%2) , , ARG:2 + 2 + (LOCAL/2) *13
	NEXT
	;能力値ボーナス
	FOR LOCAL , 0 , 6
		CALLFORM EQUIP_PROPERTY , ARG:3 , "基本能力修正" , LOCAL + 1 , ARG
		;IF RESULT > 0
		CALL SET_PICTURE , @"%GET_BASESTATUS(LOCAL + 1),8%_ {RESULT,3},{COLOR(AUTO_SPLIT("RED_GRAY_DEF" , "_" , (RESULT > 0) + (RESULT >= 0)))}" , ARG:1+5+(LOCAL/3) , , ARG:2 + 2 + (LOCAL%3) *13
		
	NEXT
	
	;剣か銃なら攻撃回数・相性・射程・攻撃範囲表示
	IF RANGE(ARG:3 , 2000 , 2999)
		IF RANGE(ARG:3 , 2500 , 2999)
			CALLFORM EQUIP_PROPERTY , ARG:3 , "銃攻撃" , , ARG
			CALL SET_PICTURE , @"攻撃:{RESULT,3}" , ARG:1+7 , , ARG:2 + 6
			CALLFORM EQUIP_PROPERTY , ARG:3 , "銃命中" , , ARG
			CALL SET_PICTURE , @"命中:{RESULT,3}" , ARG:1+8 , , ARG:2 + 6
		ENDIF
		CALLFORM EQUIP_PROPERTY , ARG:3 , "最低攻撃回数" , , ARG
		攻撃回数 = RESULT
		CALLFORM EQUIP_PROPERTY , ARG:3 , "最大攻撃回数" , , ARG
		攻撃回数:1 = RESULT
		CALL SET_PICTURE , @"攻撃回数：{攻撃回数}-{攻撃回数:1}" , ARG:1+7 , , ARG:2 + 16
		IF RANGE(ARG:3 , 2000 , 2499)
			;剣なら攻撃相性を表示
			CALLFORM EQUIP_PROPERTY , ARG:3 , "攻撃相性" , , ARG
			CALL SET_PICTURE , @" 相性：%GET_TYPE(RESULT),4,LEFT%" , ARG:1+7 , , ARG:2 + 30
		ELSEIF RANGE(ARG:3 , 2500 , 2999)
			;銃なら特殊弾倉を表示
			CALLFORM EQUIP_PROPERTY , ARG:3 , "特殊弾倉" , , ARG
			CALL SET_PICTURE , @" 特殊弾倉：{RESULT}" , ARG:1+7 , , ARG:2 + 30
		ENDIF
		CALLFORM EQUIP_PROPERTY , ARG:3 , "射程" , , ARG
		攻撃範囲 = %GET_RANGE(RESULT) , 4 , LEFT%
		CALLFORM EQUIP_PROPERTY , ARG:3 , "攻撃範囲" , , ARG
		攻撃範囲:1 = %GET_SPHERE(RESULT),4,LEFT%
		CALL SET_PICTURE , @"射程：%攻撃範囲% 　　対象：%攻撃範囲:1%" , ARG:1+8 , , ARG:2 + 16
	ENDIF
ELSEIF 表示情報 == 1
	;CALL SET_PICTURE , @"防御相性" , ARG:1 + 3 , , ARG:2 + 2
	FOR LOCAL,0,FLAG:相性数
		CALLFORM EQUIP_PROPERTY , ARG:3 , "防御相性" , LOCAL , ARG
		CALL SET_AISYOU_COLOR, RESULT
		IF RESULT == 999
			LOCALS = 　反射　
		ELSE
			LOCALS = %\@(RESULT < 0) ? 吸 # 　\@%{ABS(RESULT),3}％ 
		ENDIF
		SIF RESULT == 100
			LOCALS =
		CALL SET_PICTURE , @" %GET_TYPE(LOCAL),4,LEFT%,{GETDEFCOLOR()}_ _%LOCALS%,{GETCOLOR()}" , ARG:1 + 3 + (LOCAL/3) , , ARG:2 + 2 + (LOCAL%3) * 14
		RESETCOLOR
	NEXT
ELSEIF 表示情報 == 2
	;武器の追加効果
	CALLFORM EQUIP_PROPERTY , ARG:3 , "追加効果" , , ARG
	IF RESULT > 0
		CALL SET_PICTURE , @"追加効果：%GET_STATE(RESULT),6,LEFT%" , ARG:1 + 3 , , ARG:2 + 2
		CALLFORM EQUIP_PROPERTY , ARG:3 , "追加効果相性" , , ARG
		CALL SET_PICTURE , @"追加効果相性：%GET_TYPE(RESULT),6,LEFT%" , ARG:1 + 3 , , ARG:2 + 20
		ARG:1 ++
	ENDIF
	LOCAL:1 = 0
	CALL SET_PICTURE , @"◇状態異常耐性" , ARG:1 + 3 , , ARG:2 + 2
	FOR LOCAL , 0 , FLAG:ステート数
		CALLFORM EQUIP_PROPERTY , ARG:3 , "バステ耐性" , LOCAL , ARG
		IF RESULT
			CALL SET_PICTURE , @"%GET_STATE(LOCAL),8,LEFT% {100+RESULT,3}％" , ARG:1 + 4 + LOCAL:1 / 3 , , ARG:2 + 2 + (LOCAL:1 % 3) * 14
			LOCAL:1 ++
		ENDIF
	NEXT
ENDIF

