@SHOPCOMABLE_197
[IF_DEBUG]
	RESULTS = アイテムソート
	RETURN 1
[ENDIF]
IF FLAG:DEBUG
	RESULTS = アイテムソート
	RETURN 1
ENDIF
RETURN -1

@SHOP_COM_197
PRINTL
CLEARLINE 5000
PRINTFORML ;-------------------------------
PRINTFORML ;%GAMEBASE_TITLE% {GAMEBASE_VERSION/1000},{GAMEBASE_VERSION % 1000}
GETTIME
PRINTFORML ;%RESULTS%
PRINTFORML ;-------------------------------
PRINTFORML ;-------------------------------
PRINTFORML ;この資料は資料フォルダ内にある
PRINTFORML ;SORT_ITEM_LIST.ERBを利用して作成されています
PRINTFORML ;何か追加する際はコピペするのではなく、
PRINTFORML ;SORT_ITEM_LIST.ERBを利用して出力してください
PRINTFORML ;-------------------------------
FOR LOCAL, 1000 ,5500
	SIF ITEMNAME:LOCAL == ""
		CONTINUE
	PRINTFORM [{LOCAL}] %ITEMNAME:LOCAL%
	IF LOCAL < 2000
		PRINTFORML (使用アイテム)
	ELSEIF LOCAL < 2500
		PRINTFORML (剣)
	ELSEIF LOCAL < 3000
		PRINTFORML (銃)
	ELSEIF LOCAL < 3500
		PRINTFORML (頭防具)
	ELSEIF LOCAL < 4000
		PRINTFORML (胴防具)
	ELSEIF LOCAL < 4500
		PRINTFORML (腕防具)
	ELSEIF LOCAL < 5000
		PRINTFORML (足防具)
	ELSEIF LOCAL < 5500
		PRINTFORML (アクセサリ)
	ELSEIF LOCAL < 6000
		PRINTFORML (特殊弾)
	ENDIF
	IF LOCAL < 2000
		TRYCALLFORM SKILL_HITRATE_{LOCAL+2000}
		PRINTFORM 命中:{RESULT,4}　
		RESULT = 0
		TRYCALLFORM SKILL_POWER_{LOCAL+2000}
		PRINTFORM 威力:{RESULT,4}　
		RESULT = 0
		TRYCALLFORM SKILL_COSTTYPE_{LOCAL+2000}
		LOCAL:1 = RESULT
		RESULT = 0
		TRYCALLFORM SKILL_COST_{LOCAL+2000}
		PRINTFORML \@ LOCAL:1 == 2 ? 消費HP:{RESULT,3}％ # 消費MP:{RESULT,3} \@

		SELECTCASE LOCAL
			;罪味方の専用魔法シリーズはターゲットいねーと落ちるので
			CASE 1520, 1620, 1720 ,1923, 2025
				PRINTFORM 相性:特殊　
			CASEELSE
				RESULT = -1
				TRYCALLFORM SKILL_TYPE_{LOCAL+2000}
				IF RESULT == -1
					PRINTFORM 相性:特殊　
				ELSE
					PRINTFORM 相性:%GET_TYPE(RESULT), 6%　
				ENDIF
		ENDSELECT
		TRYCALLFORM SKILL_DECIDE_TYPE_{LOCAL+2000}
		PRINTFORM \@RESULT == 1 ? EX # MA\@　
		RESULT = 0
		TRYCALLFORM SKILL_SPHERE_{LOCAL+2000}
		PRINT 範囲:
		SELECTCASE RESULT
			CASE 1
				PRINTFORM 単体　　
			CASE 2
				PRINTFORM 列　　　
			CASE 3
				PRINTFORM 全体　　
			CASE 4
				PRINTFORM 敵味方　
			CASEELSE
				PRINT なし　　
		ENDSELECT
		TRYCALLFORM SKILL_EFECT_{LOCAL+2000}
		PRINT 種別:
		SELECTCASE RESULT
			CASE 1
				PRINTFORML 攻撃　　　　
			CASE 2
				PRINTFORML 回復　　　　
			CASE 3
				PRINTFORML 状態変化　　
			CASE 4
				PRINTFORML 特殊　　　　
			CASE 5
				PRINTFORML 状態回復　　
			CASEELSE
				PRINTFORML その他　　　
		ENDSELECT
		TRYCALLFORM SKILL_EXPLAIN_{LOCAL+2000}
		PRINTL 
	ELSEIF LOCAL < 2500
		PRINTFORM [{LOCAL}]　
		PRINTFORMLC %ITEMNAME:LOCAL%
		TRYCALLFORM 戦闘能力修正_{LOCAL}, 0
		PRINTFORM 攻撃 {RESULT,3}　
		TRYCALLFORM 戦闘能力修正_{LOCAL}, 1
		PRINTFORM 命中 {RESULT,3}　
		TRYCALLFORM 攻撃相性_{LOCAL} 
		PRINTFORM 相性 [%GET_TYPE(RESULT),4%]　
		TRYCALLFORM 最大攻撃回数_{LOCAL}
		PRINTFORM 最大攻撃回数[{RESULT}]　
		TRYCALLFORM 射程_{LOCAL}
		PRINTFORM 射程[{RESULT}]　
		TRYCALLFORM 攻撃範囲_{LOCAL},
		PRINTFORML 攻撃範囲[{RESULT}]
		TRYCALLFORM 装備条件説明_{LOCAL}
		TRYCALLFORM 装備解説_{LOCAL}
	ELSEIF LOCAL < 3000
		TRYCALLFORM 銃攻撃_{LOCAL}
		PRINTFORM 銃攻撃 {RESULT,3}　
		TRYCALLFORM 銃命中_{LOCAL}
		PRINTFORM 銃命中 {RESULT,3}　
		TRYCALLFORM 特殊弾倉_{LOCAL}
		PRINTFORM 特殊弾倉 [{RESULT}]　
		
		TRYCALLFORM 銃タイプ_{LOCAL}
		SELECTCASE RESULT
			CASE 1
				PRINT ハンドガン
			CASE 2
				PRINT ショットガン
			CASE 3
				PRINT Aライフル・マシンガン
			CASE 4
				PRINT 狙撃ライフル
			CASE 5
				PRINT その他
		ENDSELECT
		TRYCALLFORM 装備条件説明_{LOCAL}
		TRYCALLFORM 装備解説_{LOCAL}
	ELSEIF LOCAL < 5500
		TRYCALLFORM 戦闘能力修正_{LOCAL}, 2
		PRINTFORM 防御 {RESULT,3}　
		TRYCALLFORM 戦闘能力修正_{LOCAL}, 3
		PRINTFORM 回避 {RESULT,3}　
		LOCAL:2 = 0
		FOR LOCAL:1, 0, 19
			TRYCALLFORM 防御相性_{LOCAL}, LOCAL:1
			IF RESULT != 100
				LOCAL:2 += 1
				IF LOCAL:2 % 7 == 1
					PRINTL 
					PRINT 　　　　
				ENDIF
				IF RESULT < 100 || RESULT == 999
					SETCOLOR 51, 255, 255
				ELSE
					SETCOLOR 204, 0, 0
				ENDIF
				IF RESULT == 999
					PRINTFORM [%GET_TYPE(LOCAL:1),4%:反射]　
				ELSEIF RESULT == 50
					PRINTFORM [%GET_TYPE(LOCAL:1),4%:半減]　
				ELSEIF RESULT == 0
					PRINTFORM [%GET_TYPE(LOCAL:1),4%:無効]　
				ELSE
					PRINTFORM [%GET_TYPE(LOCAL:1),4%:{RESULT,4}]　
				ENDIF
			ENDIF
			RESETCOLOR
		NEXT
		PRINTL 
		TRYCALLFORM 装備条件説明_{LOCAL}
		TRYCALLFORM 装備解説_{LOCAL}
		PRINTL 
	ENDIF
NEXT
WAIT
