;====================================
;登録済みの悪魔をリスト化するための関数です
;レベル順リストは基本的に特殊種族と人間を表示しません。
;雑魚悪魔等を選択したりする用です。
;====================================



@SHOPCOMABLE_198
[IF_DEBUG]
	RESULTS = スキル一覧
	RETURN 1
[ENDIF]
IF FLAG:DEBUG
	RESULTS = スキル一覧
	RETURN 1
ENDIF
RETURN -1

@SHOP_COM_198
PRINTL
CLEARLINE 5000
PRINTFORML ;-------------------------------
PRINTFORML ;%GAMEBASE_TITLE% {GAMEBASE_VERSION/1000},{GAMEBASE_VERSION % 1000}
GETTIME
PRINTFORML ;%RESULTS%
PRINTFORML ;-------------------------------
PRINTFORML ;-------------------------------
PRINTFORML ;この資料は資料フォルダ内にある
PRINTFORML ;SORT_SKILL_LIST.ERBを利用して作成されています
PRINTFORML ;何か追加する際はコピペするのではなく、
PRINTFORML ;SORT_SKILL_LIST.ERBを利用して出力してください
PRINTFORML ;-------------------------------
FOR LOCAL, 0 ,3000
	SIF LOCAL == 2303
		GOTO SUMMON
	TRYCCALLFORM SKILL_NAME_{LOCAL}
		$SUMMON
		IF LOCAL == 2303
			PRINTFORML [{LOCAL,4}] 仲魔召喚
		ELSE
			PRINTFORML [{LOCAL,4}] %RESULTS%
		ENDIF
		TRYCALLFORM SKILL_RANK_{LOCAL}		
		PRINTFORM ランク:{RESULT,2}　
		RESULT = 0
		TRYCALLFORM SKILL_HITRATE_{LOCAL}
		PRINTFORM 命中:{RESULT,4}　
		RESULT = 0
		TRYCALLFORM SKILL_POWER_{LOCAL}
		PRINTFORM 威力:{RESULT,4}　
		RESULT = 0
		TRYCALLFORM SKILL_COSTTYPE_{LOCAL}
		LOCAL:1 = RESULT
		RESULT = 0
		TRYCALLFORM SKILL_COST_{LOCAL}
		PRINTFORML \@ LOCAL:1 == 2 ? 消費HP:{RESULT,3}％ # 消費MP:{RESULT,3} \@

		SELECTCASE LOCAL
			;罪味方の専用魔法シリーズはターゲットいねーと落ちるので
			CASE 1520, 1620, 1720 ,1923, 2025
				PRINTFORM 相性:特殊　
			CASEELSE
				RESULT = -1
				TRYCALLFORM SKILL_TYPE_{LOCAL}
				IF RESULT == -1
					PRINTFORM 相性:特殊　
				ELSE
					PRINTFORM 相性:%GET_TYPE(RESULT), 6%　
				ENDIF
		ENDSELECT
		TRYCALLFORM SKILL_DECIDE_TYPE_{LOCAL}
		PRINTFORM \@RESULT == 1 ? EX # MA\@　
		RESULT = 0
		TRYCALLFORM SKILL_SPHERE_{LOCAL}
		PRINT 範囲:
		SELECTCASE RESULT
			CASE 1
				PRINTFORM 単体　　
			CASE 2
				PRINTFORM 列　　　
			CASE 3
				PRINTFORM 全体　　
			CASE 4
				PRINTFORM 敵味方　
			CASEELSE
				PRINT なし　　
		ENDSELECT
		TRYCALLFORM SKILL_EFECT_{LOCAL}
		PRINT 種別:
		SELECTCASE RESULT
			CASE 1
				PRINTFORML 攻撃　　　　
			CASE 2
				PRINTFORML 回復　　　　
			CASE 3
				PRINTFORML 状態変化　　
			CASE 4
				PRINTFORML 特殊　　　　
			CASE 5
				PRINTFORML 状態回復　　
			CASEELSE
				PRINTFORML その他　　　
		ENDSELECT
		TRYCALLFORM SKILL_EXPLAIN_{LOCAL}
		PRINTL 
	CATCH
	ENDCATCH
NEXT
WAIT
