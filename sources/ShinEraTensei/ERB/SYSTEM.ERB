BEGIN SHOP


;========================================================================
;ロード時の処理
;========================================================================
@EVENTLOAD
LOADGLOBAL
IF FLAG:一時セーブ管理
	DELDATA LASTLOAD_NO
	;一時セーブをコピーしてた場合の措置
	IF FLAG:一時セーブ管理 != GLOBAL
		PRINTL 不正なデータです
		BEGIN TITLE
	ENDIF
	FLAG:一時セーブ管理 = 0
	DO
		LOCAL = RAND:10000 + 1
	LOOP GLOBAL == LOCAL
	GLOBAL = LOCAL
	SAVEGLOBAL
ENDIF
GETMILLISECOND
FLAG:プレイ開始時間 = RESULT
;古いバージョンとのセーブデータ互換処理
SIF LASTLOAD_VERSION < GAMEBASE_VERSION
	CALL VERUP
CALL VERUP_TEMP
;ダンジョン内でセーブしていた場合、ダンジョンアタックを再度呼び出す
IF FLAG:ショップコマンド == 101
	BEGIN SHOP
ENDIF

@TITLE_LOADGAME
#LOCALSIZE 2
LOADGLOBAL
$START
SIF GLOBAL:1 < 0
	GLOBAL:1 = 0
SIF GLOBAL:1 > 30
	GLOBAL:1 = 29
IF GLOBAL:1 / 10 == 2
	FOR LOCAL, 220 , 240
		LOCAL:1 = GLOBAL:2 + LOCAL > 239 ? GLOBAL:2 + LOCAL - 20 # GLOBAL:2 + LOCAL
		SIF LOCAL:1 == LASTLOAD_NO
			SETCOLOR COLOR("aqua")
		CHKDATA  LOCAL:1
		PRINTFORML [{LOCAL ,3}] \@ !RESULT ? %RESULTS% # ---- \@
		RESETCOLOR
	NEXT
ELSE
	LOCAL:1 = GLOBAL:1 < 10 ? GLOBAL:1 * 20  # 200
	FOR LOCAL, LOCAL:1 , LOCAL:1 + 20
		;IF LOCAL == 99
		;	SIF GLOBAL:1 != 4
		;		PRINTL 
		;		CONTINUE
		;ELSEIF LOCAL == 98
		;	PRINTL 
		;	CONTINUE
		;ENDIF
		CHKDATA LOCAL
		SIF LOCAL == LASTLOAD_NO
			SETCOLOR COLOR("aqua")
		IF !RESULT
			PRINTFORML [{LOCAL,3}] %RESULTS%
		ELSE
			PRINTFORML [{LOCAL,3}] ----
		ENDIF
		RESETCOLOR
	NEXT
ENDIF
DRAWLINE
LOCAL =  RANGE(GLOBAL:1, 10 ,19) ? 400 # 300
CHKDATA LOCAL
SIF LOCAL == LASTLOAD_NO
	SETCOLOR COLOR("aqua")
IF !RESULT
	PRINTFORML [{LOCAL}] %RESULTS%
ELSE
	PRINTFORML [{LOCAL}] ----
ENDIF
RESETCOLOR
DRAWLINE
PRINTFORMLC \@ GLOBAL:1 <= 0 || GLOBAL:1 >= 10 ? %" " * 16% # [1000] 前のページ\@ 
PRINTFORMLC [1001] 戻る
PRINTFORMLC \@ GLOBAL:1 >= 9 ? %" " * 16% # [1002] 次のページ\@ 
PRINTL 
SIF GLOBAL:1 < 10 
	SETCOLOR COLOR("aqua")
PRINTFORM [1003] %"通常領域",19,LEFT%
RESETCOLOR
SIF RANGE(GLOBAL:1, 10, 19)
	SETCOLOR COLOR("aqua")
PRINTFORM [1004] %"ダンジョン内領域",19,LEFT%
RESETCOLOR
SIF RANGE(GLOBAL:1, 20, 29)
	SETCOLOR COLOR("aqua")
PRINTFORM [1005] %"自動セーブ領域",19,LEFT%
RESETCOLOR
$INPUT_LOOP
INPUT
IF RESULT == 1001
	RETURN 0
ELSEIF RESULT == 1000 && GLOBAL:1 > 0 && GLOBAL:1 < 10
	GLOBAL:1 -= 1
	GOTO START
ELSEIF RESULT == 1002 && GLOBAL:1 < 10
	GLOBAL:1 += 1
	GOTO START
ELSEIF RESULT == 1003
	GLOBAL:1 %= 10
	GOTO START
ELSEIF RESULT == 1004
	GLOBAL:1 = GLOBAL:1 % 10 + 10
	GOTO START
ELSEIF RESULT == 1005
	GLOBAL:1 = GLOBAL:1 % 10 + 20
	GOTO START
ENDIF
IF RANGE(RESULT, 220, 239)
	LOCAL = RESULT + GLOBAL:2
	SIF LOCAL >= 240
		LOCAL -= 20
ELSE
	LOCAL = RESULT
ENDIF
CHKDATA LOCAL
IF RESULT
	CLEARLINE 1
	REUSELASTLINE 無効な値です
	GOTO INPUT_LOOP
ENDIF
SAVEGLOBAL
LOADDATA LOCAL

@TITLE_SAVEGAME
#LOCALSIZE 2
#DIM PAGE, 1
PAGE = GLOBAL:1 % 10
LOADGLOBAL
$START
LOCAL:1 = FLAG:ショップコマンド != [[ショップ:探索]] ? PAGE * 20 # 200
FOR LOCAL, LOCAL:1 , LOCAL:1 + 20
	;IF LOCAL == 99 || LOCAL == 98
	;	PRINTL 
	;	CONTINUE
	;ENDIF
	SIF LOCAL == LASTLOAD_NO
		SETCOLOR COLOR("aqua")
	CHKDATA LOCAL
	IF !RESULT
		PRINTFORML [{LOCAL,3}] %RESULTS%
	ELSE
		PRINTFORML [{LOCAL,3}] ----
	ENDIF
	RESETCOLOR
NEXT
PRINTFORMLC \@ PAGE <= 0 || FLAG:ショップコマンド == [[ショップ:探索]] ? %" " * 16% # [1000] 前のページ\@ 
PRINTFORMLC [1001] 戻る
PRINTFORMLC \@ PAGE >= 9 || FLAG:ショップコマンド == [[ショップ:探索]]? %" " * 16% # [1002] 次のページ\@
PRINTL 
PRINTFORML [1003]セーブデータメモ\@STRLENS(SAVESTR:99)? 変更 (%SAVESTR:99%) # 作成\@
$INPUT_LOOP
INPUT
IF RESULT == 1001
	RETURN 0
ELSEIF RESULT == 1000 && PAGE > 0 && FLAG:ショップコマンド != [[ショップ:探索]]
	PAGE -= 1
	GOTO START
ELSEIF RESULT == 1002 && PAGE < 10 && FLAG:ショップコマンド != [[ショップ:探索]]
	PAGE += 1
	GOTO START
ELSEIF RESULT == 1003
	PRINTL セーブデータの内容につけるメモを入力してください
	INPUTS
	SAVESTR:99 = %RESULTS%
	PRINTFORML 次からセーブをつけるときは %SAVESTR:99% がセーブデータに付与されます
	PRINTFORML 別のメモをつけたいときは再設定してください
	GOTO START
ENDIF
IF FLAG:ショップコマンド == [[ショップ:探索]]
	IF !RANGE(RESULT, 200, 219)
		CLEARLINE 1
		REUSELASTLINE 無効な値です
		GOTO INPUT_LOOP
	ENDIF
ELSE
	IF !RANGE(RESULT, 0, 199)
		CLEARLINE 1
		REUSELASTLINE 無効な値です
		GOTO INPUT_LOOP
	ENDIF
ENDIF
LOCAL = RESULT
CHKDATA LOCAL
IF !RESULT
	PRINTL 既にデータが存在しています。上書きしますか？
	CALL INPUT_YN
	SIF RESULT == 1
		RETURN 0
ENDIF
GLOBAL:1 = PAGE + (FLAG:ショップコマンド == [[ショップ:探索]]) * 10
SAVEGLOBAL
SAVEDATA LOCAL, SAVETEXT()

@SYSTEM_AUTOSAVE
SAVEDATA 300, SAVETEXT()
IF TIME == 0
	SAVEDATA 220 + GLOBAL:2, SAVETEXT()
	IF GLOBAL:3 != DAY
		GLOBAL:3 = DAY
		SIF ++GLOBAL:2 == 20
			GLOBAL:2 = 0
	ENDIF
	SAVEGLOBAL
ENDIF

