	IF FLAG:一時セーブ管理
		LOCALS  += "  中断セーブ"
	ELSE
		LOCALS  += "  ダンジョン探索中"
	ENDIF
ENDIF
LOCALS  += @"  Ver{GAMEBASE_VERSION/1000}.{GAMEBASE_VERSION%1000}"
GETMILLISECOND
FLAG:プレイ時間 += RESULT - FLAG:プレイ開始時間
FLAG:プレイ開始時間 = RESULT
LOCALS  += @" 【{MIN(FLAG:プレイ時間 / 1000 / 60 / 60, 999)}:"
