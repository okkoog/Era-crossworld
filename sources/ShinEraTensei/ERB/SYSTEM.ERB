	LOCALS  += "59】"
ELSEIF (FLAG:プレイ時間 / 1000 / 60) % 60 < 10
	LOCALS  += @"0{(FLAG:プレイ時間 / 1000 / 60) % 60}】"
ELSE
	LOCALS  += @"{(FLAG:プレイ時間 / 1000 / 60) % 60}】"
ENDIF
SIF STRLENS(SAVESTR:99)
	LOCALS  += @"  (%SAVESTR:99%)"

