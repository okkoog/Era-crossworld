			IF !CFLAG:(ARG:1):(2098 - A) == 0
				SIF CFLAG:(ARG:1):(2098 - A) < 0
					CFLAG:(ARG:1):(2098 - A) += (CFLAG:(ARG:1):(2098 - A) * (-1)) / 10
				SIF CFLAG:(ARG:1):(2098 - A) > 0
					CFLAG:(ARG:1):(2098 - A) -= CFLAG:(ARG:1):(2098 - A) / 10
			ENDIF
