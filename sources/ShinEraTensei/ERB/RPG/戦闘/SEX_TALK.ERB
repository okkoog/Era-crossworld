;対象がペニス付きならフェラ・Ｖ・Ａ増加
IF HAVE_PENIS(ARG)
	IF HAVE_VAGINA(ARG:1)
		CFLAG:ARG:挿入回数 += 1+(3+ABL:(ARG:1):Ｖ感覚)/2
