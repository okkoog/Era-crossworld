@SEXIAL_ヤらせてもらう,ARG,ARG:1
VARSET NOWEX:ARG:0,0
VARSET NOWEX:(ARG:1):0,0

;ストレス増加値
LOCAL:4 = 0
;悪魔満足度
LOCAL:7 = 0
;技巧用入れ物
LOCAL:6 = 0
CALL ADD_SEXTALK_PLAY,ARG,ARG:1,1

LOCAL:4 = 1+(CFLAG:(ARG:1):本番回数+CFLAG:(ARG:1):アナル回数+CFLAG:(ARG:1):フェラ回数+CFLAG:(ARG:1):クリ責め回数+CFLAG:(ARG:1):胸責め回数)*2/5


	PRINTL
	PRINTFORML %CALLNAME:(ARG:1)%の交渉
	IF TCVAR:(ARG:1):獲得Ｖ経験
		IF TALENT:(ARG:1):処女
			PRINTFORML 処女喪失
			TALENT:(ARG:1):処女 = 0
		ELSEIF TALENT:(ARG:1):再生処女
			PRINTFORML 再生処女喪失
			TALENT:(ARG:1):再生処女 = 0
		ENDIF
	ENDIF
	;妊娠判定用
	IF PREGNANCY_ABLE(ARG:1)
		IF TALENT:(ARG:1):オトコ == 0 
			CFLAG:(ARG:1):顧客の中出氏による妊娠判定 = TCVAR:(ARG:1):獲得膣射経験*2
			CALL PREGNANCY_CHECK, ARG:1
			;妊娠確定
			SIF RESULT
				CALL SET_FATHERINFO, ARG:1, NO:ARG, -1, NAME:ARG
		ELSEIF TALENT:(ARG:1):男の娘 == 1
			CFLAG:(ARG:1):顧客の中出氏による妊娠判定 = TCVAR:(ARG:1):獲得Ａ経験*2
			;妊娠確定
			SIF RESULT
				CALL SET_FATHERINFO, ARG:1, NO:ARG, -1, NAME:ARG
		ENDIF
	ENDIF
	;周囲のキャラに欲情を加算
	FOR LOCAL,1,7
		SIF POS(LOCAL) > -1 && POS(LOCAL) != ARG:1
			PALAM:POS(LOCAL):欲情 += 5 + 5*ABL:POS(LOCAL):欲望
	NEXT
	CALL SOURCE_CHECK_DUNGEON , ARG:1,ARG
	CALL SHOW_ADD_EXP, ARG:1

	CFLAG:(ARG:1):NTRフラグ += 1
	;ストレス判定用
	SIF TALENT:(ARG:1):淫乱 || TALENT:(ARG:1):娼婦 || TALENT:(ARG:1):服従 || TALENT:(ARG:1):隷属
		LOCAL:4 /= 15
	SIF TALENT:(ARG:1):恋慕 || TALENT:(ARG:1):親愛
		LOCAL:4 *= 2
	IF ARG:1 != MASTER
		GOTJUEL:(ARG:1):否定 += LOCAL:4*100*(1+MARK:(ARG:1):3)*(1+MARK:(ARG:1):3)/MAX(1,ABL:(ARG:1):従順)
		CFLAG:(ARG:1):ストレス値 += LOCAL:4
	ENDIF
	CALL SHOW_JUEL_CHECK,ARG:1
	
	;汚れ付着
	SIF CFLAG:(ARG:1):本番回数
		SETBIT STAIN:(ARG:1):3 , 4
	SIF CFLAG:(ARG:1):アナル回数
		SETBIT STAIN:(ARG:1):4 , 4
		
	;ＮＴＲ可能な場合、淫乱度が増加
	SIF FLAG:ＮＴＲ機能
		CFLAG:(ARG:1):淫乱度 += CFLAG:(ARG:1):本番回数 + CFLAG:(ARG:1):アナル回数 + SUMARRAY(NOWEX:(ARG:1):0, 0, 4)*4
	
	;ＭＡＧを吸収
	PRINTFORML ＭＡＧ +{(CFLAG:(ARG:1):本番回数*4+CFLAG:(ARG:1):アナル回数*4+CFLAG:(ARG:1):フェラ回数*2)*MAXBASE:(ARG:1):LV}
	CALL CONTROL_MAG,ARG:1,(CFLAG:(ARG:1):本番回数*4+CFLAG:(ARG:1):アナル回数*4+CFLAG:(ARG:1):フェラ回数*2)*MAXBASE:(ARG:1):LV
	;ＨＰ・ＭＰを消費
	LOCAL = (CFLAG:(ARG:1):本番回数 * 2 + CFLAG:(ARG:1):アナル回数 * 2 + CFLAG:(ARG:1):フェラ回数 * 1 + NOWEX:(ARG:1):0 + NOWEX:(ARG:1):1 + NOWEX:(ARG:1):2 + NOWEX:(ARG:1):3)/2
	IF BASE:(ARG:1):ＭＰ > 0
		PRINTFORML ＨＰ -{MAX(1,MAXBASE:(ARG:1):ＨＰ * LOCAL/100) * (11 - ABL:(ARG:1):セックス中毒)/10}
		PRINTFORML ＭＰ -{MAX(1,MAXBASE:(ARG:1):ＭＰ * LOCAL/200) * (11 - ABL:(ARG:1):セックス中毒)/10}
		CALL VAR_MP,ARG:1,-MAX(1,MAXBASE:(ARG:1):ＭＰ * LOCAL/200) * (11 - ABL:(ARG:1):セックス中毒)/10
		CALL VAR_HP,ARG:1,-MAX(1,MAXBASE:(ARG:1):ＨＰ * LOCAL/100) * (11 - ABL:(ARG:1):セックス中毒)/10
	ELSE
		PRINTFORML ＨＰ -{MAX(1,MAXBASE:(ARG:1):ＨＰ * LOCAL*2/100) * (11 - ABL:(ARG:1):セックス中毒)/10}
		CALL VAR_HP,ARG:1,-MAX(1,MAXBASE:(ARG:1):ＨＰ * LOCAL*2/100) * (11 - ABL:(ARG:1):セックス中毒)/10
	ENDIF
	;体力・気力消費
	;気力が0になってしまう場合は、体力から差分の半分の値を引く
	IF (BASE:(ARG:1):気力 - LIMIT(LOCAL*10,100,MAXBASE:(ARG:1):気力)) <= 0
		PRINTFORML 体力 -{LIMIT(((LIMIT(LOCAL*10,100,MAXBASE:(ARG:1):気力 - BASE:(ARG:1):気力)) / 2),1,BASE:(ARG:1):体力) + LIMIT(LOCAL*10,50,BASE:(ARG:1):体力)}
		PRINTFORML 気力 -{BASE:(ARG:1):気力}
		BASE:(ARG:1):体力 -= LIMIT(((LIMIT(LOCAL*10,100,MAXBASE:(ARG:1):気力 - BASE:(ARG:1):気力)) / 2),1,BASE:(ARG:1):体力) + LIMIT(LOCAL*10,50,BASE:(ARG:1):体力)
		BASE:(ARG:1):気力 = 0
	ELSE
		PRINTFORML 体力 -{LIMIT(LOCAL*10,50,BASE:(ARG:1):体力)}
		PRINTFORML 気力 -{LIMIT(LOCAL*10,100,BASE:(ARG:1):気力)}
		BASE:(ARG:1):体力 -= LIMIT(LOCAL*10,50,BASE:(ARG:1):体力)
		BASE:(ARG:1):気力 -= LIMIT(LOCAL*10,100,BASE:(ARG:1):気力)
	ENDIF
	
	;相手側悪魔に適応
	FOR LOCAL,0,100
		EXP:ARG:LOCAL = TCVAR:ARG:LOCAL
		TCVAR:ARG:LOCAL = 0
	NEXT
	
	;成功度判定
	;満足度判定
	;ランダムで40を追加します。売春経験に応じて期待値は上昇します。
	IF EXP:(ARG:1):売春経験 > 30000
		LOCAL:7 = 60
	ELSEIF EXP:(ARG:1):売春経験 > 10000
		LOCAL:7 = RAND:31 + 30
	ELSEIF EXP:(ARG:1):売春経験 > 5000
		LOCAL:7 = RAND:36 + 25
	ELSEIF EXP:(ARG:1):売春経験 > 3000
		LOCAL:7 = RAND:41 + 20
	ELSEIF EXP:(ARG:1):売春経験 > 1000
		LOCAL:7 = RAND:46 + 15
	ELSEIF EXP:(ARG:1):売春経験 > 500
		LOCAL:7 = RAND:51 + 10
	ELSEIF EXP:(ARG:1):売春経験 > 100
		LOCAL:7 = RAND:56 + 5
	ELSE
		LOCAL:7 = RAND:61
	ENDIF

	;欲望をチェックする。欲望が相手の欲望を上回るかどうか。成功なら欲望レベルの２倍、失敗なら１倍入ります。
	;CBVA売春では、相手の欲望の最大値が4です。
	IF ABL:ARG:欲望 <= ABL:(ARG:1):欲望
		LOCAL:7 += ABL:(ARG:1):欲望
		LOCAL:7 += ABL:(ARG:1):欲望
	ELSE
		LOCAL:7 += ABL:(ARG:1):欲望
	ENDIF
	
	;相手からの行動が発生します。相手の技巧がこちらの欲望以下の場合、不満そうな表情が出る可能性があります。
	;相手の技巧＋こちらの従順の２倍＞こちらの欲望＋２なら、問題なく行為を露出癖と奉仕精神を加える事が出来ます。
	;足りない場合は加えられません。
	LOCAL:6 = ABL:ARG:技巧 + ABL:(ARG:1):従順 + ABL:(ARG:1):従順 - 2
	
	IF LOCAL:6 >= ABL:(ARG:1):欲望
		LOCAL:7 += ABL:(ARG:1):奉仕精神
		LOCAL:7 += ABL:(ARG:1):露出癖
	ENDIF
	;ここまでで最大120％
	SIF LOCAL:7 > 120
		LOCAL:7 = 120
	;従順が3LVないと、著しく微妙になります
	IF ABL:(ARG:1):従順 < 3 && ARG:1 != MASTER
		LOCAL:7 /= 2
	ENDIF
	PRINTFORML 満足度:{LOCAL:7}％
	FLAG:悪魔満足度 = LOCAL:7
	
	;倒れてしまうとMAGを大量に奪われる
	IF CFLAG:(ARG:1):ステート == GET_STATE_NUM("DYING")
		PRINTFORML ＭＡＧを奪われた！
		CALL CONTROL_MAG,ARG:1,-1000*MAXBASE:ARG:LV
	ENDIF
CALL FIGHT_IT_OUT
RETURN LOCAL:7


