		ELSEIF PALAM:ARG:欲情 < PALAMLV:3
			TIMES LOCAL , 1.40
		ELSEIF PALAM:ARG:欲情 < PALAMLV:4
			TIMES LOCAL , 1.70
		ELSEIF PALAM:ARG:欲情 >= PALAMLV:4
			TIMES LOCAL , 2.00
		ENDIF

		LOCAL:1 = SOURCE:ARG:("快" + LOCALS)
		;ABL:欲望をみる
		SELECTCASE ABL:ARG:欲望
			CASE 0
				TIMES LOCAL:1 , 0.75
			CASE 1
				TIMES LOCAL:1 , 0.80
			CASE 2
				TIMES LOCAL:1 , 0.85
			CASE 3
				TIMES LOCAL:1 , 0.90
			CASE 4
				TIMES LOCAL:1 , 0.95
			CASE 5
				TIMES LOCAL:1 , 1.00
			CASE 6
				TIMES LOCAL:1 , 1.05
			CASE 7
				TIMES LOCAL:1 , 1.10
			CASE 8
				TIMES LOCAL:1 , 1.15
			CASE 9
				TIMES LOCAL:1 , 1.20
			CASEELSE
				TIMES LOCAL:1 , 1.40
		ENDSELECT
		;小人体型
		IF TALENT:ARG:小人体型 && (LOCAL:2 == 1 || LOCAL:2 == 2)
			TIMES LOCAL , 0.50
			TIMES LOCAL:1 , 1.50
		ENDIF
		CUP:ARG:("快" + LOCALS) += LOCAL
		CUP:ARG:欲情 += LOCAL:1 / 10

	NEXT
	;-------------------------------------------------
	;快感の否定は、快ソースの数値に応じて、抑鬱増加（淫乱、娼婦で無効）
	;-------------------------------------------------
	SIF TALENT:ARG:71 && (TALENT:ARG:4 == 0 && TALENT:ARG:7 == 0)
		SOURCE:ARG:鬱屈 += (CUP:ARG:快Ｃ+UP:1+CUP:ARG:快Ａ+CUP:ARG:快Ｂ)/10


	;-------------------------------------------------
	;陥落素質
	;-------------------------------------------------
	;淫乱
	IF TALENT:ARG:淫乱
		TIMES CUP:ARG:快Ｃ , 1.20
		TIMES CUP:ARG:快Ｖ , 1.20
		TIMES CUP:ARG:快Ａ , 1.20
		TIMES CUP:ARG:快Ｂ , 1.20
	ENDIF

	;娼婦
	IF TALENT:ARG:娼婦
		TIMES CUP:ARG:快Ｃ , 1.50
		TIMES CUP:ARG:快Ｖ , 1.50
		TIMES CUP:ARG:快Ａ , 1.50
		TIMES CUP:ARG:快Ｂ , 1.50
	ENDIF

	;-------------------------------------------------
	;素質
	;-------------------------------------------------
	;自制心
	IF TALENT:ARG:20
		TIMES CUP:ARG:快Ｃ , 0.70
		TIMES CUP:ARG:快Ｖ , 0.90
		TIMES CUP:ARG:快Ａ , 1.00
		TIMES CUP:ARG:快Ｂ , 0.70
	ENDIF

	;即落ち
	IF TALENT:ARG:73
		TIMES CUP:ARG:快Ｃ , 2.00
		TIMES CUP:ARG:快Ｖ , 2.00
		TIMES CUP:ARG:快Ａ , 2.00
		TIMES CUP:ARG:快Ｂ , 2.00
	ENDIF
	;自慰狂い
	SIF TALENT:ARG:74
		TIMES CUP:ARG:快Ｃ , 1.20
	;セックス狂い
	SIF TALENT:ARG:75
		TIMES CUP:ARG:快Ｖ , 1.20
	;尻穴狂い
	SIF TALENT:ARG:76
		TIMES CUP:ARG:快Ａ , 1.20
	;淫乳
	SIF TALENT:ARG:77
		TIMES CUP:ARG:快Ｂ , 1.20

	;オトコ
	IF IS_MALE(ARG)
		TIMES CUP:ARG:快Ａ , 1.30
	ENDIF

	;-------------------------------------------------
	;愛液処理
	;-------------------------------------------------
	LOCAL = CUP:ARG:快Ｃ + CUP:ARG:快Ｖ + CUP:ARG:快Ａ + CUP:ARG:快Ｂ
	;快Ｃ＋快Ｖ＋快Ａ＋快Ｂが合わせて100以上上昇ならその20%の液体のソースが加わる（オトコはダメ）
	IF LOCAL > 100
		;濡れやすいと濡れにくいはここで処理
		SIF TALENT:ARG:42
			TIMES LOCAL , 3.00
		SIF TALENT:ARG:43
			TIMES LOCAL , 0.40
		CUP:ARG:潤滑 += LOCAL / 5
	ENDIF
	;-------------------------------------------------
	;液体のソース
	;-------------------------------------------------
	LOCAL = SOURCE:ARG:液体

	CUP:ARG:潤滑 += SOURCE:ARG:液体

	;-------------------------------------------------
	;欲情のソース
	;-------------------------------------------------

	;忠誠度による修正
	;LOCAL = (BASE:ARG:忠誠度 >= 500 ? LIMIT(BASE:忠誠度*3/4,500,750) # LIMIT(BASE:忠誠度/2,1,500))

	;SOURCE:ARG:欲情 *= LOCAL
	;SOURCE:ARG:欲情 /= 500

	LOCAL = SOURCE:ARG:欲情

	;欲望を見る
	SELECTCASE ABL:ARG:欲望
		CASE 0
			TIMES LOCAL , 0.10
		CASE 1
			TIMES LOCAL , 0.40
		CASE 2
			TIMES LOCAL , 0.80
		CASE 3
			TIMES LOCAL , 1.20
		CASE 4
			TIMES LOCAL , 1.60
		CASE 5
			TIMES LOCAL , 2.00
		CASE 6
			TIMES LOCAL , 2.40
		CASE 7
			TIMES LOCAL , 2.80
		CASE 8
			TIMES LOCAL , 3.20
		CASE 9
			TIMES LOCAL , 3.60
		CASEELSE
			TIMES LOCAL , 5.00
	ENDSELECT
		
	CUP:ARG:欲情 += LOCAL
IF 危険日(ARG) >= 2
	CUP:ARG:快Ｃ *= 2
	CUP:ARG:快Ｖ *= 2
	CUP:ARG:快Ａ *= 2
	CUP:ARG:快Ｂ *= 2
	CUP:ARG:欲情 *= 2
	CUP:ARG:潤滑 *= 2
ENDIF

FOR LOCAL , 0 , 20
	PALAM:ARG:LOCAL += CUP:ARG:LOCAL
	CUP:ARG:LOCAL = 0
NEXT
VARSET SOURCE:ARG:0 , 0

CALL EX_CHECK_DUNGEON,ARG

