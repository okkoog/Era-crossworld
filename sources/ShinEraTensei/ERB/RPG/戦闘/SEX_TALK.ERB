		CFLAG:(ARG:1):アナル回数 += CFLAG:ARG:挿入回数
	ENDIF
	CFLAG:ARG:挿入回数 += 1+(3+ABL:(ARG:1):Ａ感覚)/2
	CFLAG:(ARG:1):アナル回数 += CFLAG:ARG:挿入回数 - CFLAG:(ARG:1):本番回数
	CFLAG:(ARG:1):フェラ回数 += 1+(5+ABL:(ARG:1):奉仕精神)/2
ELSE
	CFLAG:(ARG):クリ責め回数 += (6+ ABL:ARG:技巧)/2
ENDIF
