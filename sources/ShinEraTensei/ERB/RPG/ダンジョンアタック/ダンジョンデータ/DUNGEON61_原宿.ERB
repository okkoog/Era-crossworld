			SIF FLAG:現X == 17 && FLAG:現Y == 1
				CALL DUNGEON_WORP,1,11,2
			;南階段
			SIF FLAG:現X == 2 && FLAG:現Y == 8
				CALL DUNGEON_WORP,1,4,8
