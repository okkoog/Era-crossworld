	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 3
	RETURN 0
ELSE
	PRINTW 何も無いようだ
	RETURN 0
ENDIF
 
