			SIF FLAG:現X == 14 && FLAG:現Y == 14
				CALL DUNGEON_WORP,2,1,8
		;公園
		CASE 2
			;大通り口
			SIF FLAG:現X == 0 && FLAG:現Y == 8
				CALL DUNGEON_WORP,1,13,14
			;神社口
			SIF FLAG:現X == 8 && FLAG:現Y == 0
				CALL DUNGEON_WORP,3,7,18
