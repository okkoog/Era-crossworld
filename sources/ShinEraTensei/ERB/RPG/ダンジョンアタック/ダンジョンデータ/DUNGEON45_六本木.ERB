;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_45

;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========

ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 3
	SELECTCASE FLAG:現M
		CASE 1
			;反魂香
			SIF FLAG:現X == 3 && FLAG:現Y == 13
				CALL GET_TREASURE,1009,1,FLAG:現ダンジョン,20
		CASE 2
			;ディスポイズン
			IF FLAG:現X == 8 && FLAG:現Y == 1
				CALL GET_TREASURE,1017,2,FLAG:現ダンジョン,27
			;チャクラポット
			ELSEIF FLAG:現X == 10 && FLAG:現Y == 1
				CALL GET_TREASURE,1026,1,FLAG:現ダンジョン,28
			ELSEIF FLAG:現X == 12 && FLAG:現Y == 1
				CALL GET_HP100,10,FLAG:現ダンジョン,29
			ENDIF
		CASE 4
			;速さの香
			SIF FLAG:現X == 9 && FLAG:現Y == 13
				CALL GET_TREASURE,1014,1,FLAG:現ダンジョン,21
		CASE 5
			;力の香
			IF FLAG:現X == 7 && FLAG:現Y == 3
				CALL GET_TREASURE,1010,1,FLAG:現ダンジョン,22
			;トラップ
			ELSEIF FLAG:現X == 7 && FLAG:現Y == 5
				CALL GET_HP100,10,FLAG:現ダンジョン,23
			ENDIF
			;金
			IF FLAG:現X == 3 && FLAG:現Y == 11
				IF ダンジョンフラグ:45:1 == 1
					CALL GET_TREASURE_MONEY,0,10000,FLAG:現ダンジョン,24
				ELSE
					CALL GET_HP100,10,FLAG:現ダンジョン,24
				ENDIF
			ENDIF
		CASE 6
			;トラップ
			IF FLAG:現X == 16 && FLAG:現Y == 1
				CALL GET_HP100,10,FLAG:現ダンジョン,25
			;トラップ
			ELSEIF FLAG:現X == 7 && FLAG:現Y == 3
				CALL GET_HP100,10,FLAG:現ダンジョン,26
			ENDIF
	ENDSELECT
	RETURN 1

;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 6
	SELECTCASE FLAG:現M
		;地下一階昇り階段
		CASE 0
			SIF FLAG:現X == 1 && FLAG:現Y == 5
				CALL DUNGEON_UPSTAIRS,2,14,7
		;二階昇り階段
		CASE 2
			;ニ階　MAP6の座標を指定
			SIF FLAG:現X == 6 && FLAG:現Y == 13
				CALL DUNGEON_UPSTAIRS,4,16,13
		;三階昇り階段
		CASE 4
			SIF FLAG:現X == 16 && FLAG:現Y == 3
				CALL DUNGEON_UPSTAIRS,5,16,3
		;地下一階昇り階段
		CASE 6
			SIF FLAG:現X == 1 && FLAG:現Y == 13
				CALL DUNGEON_UPSTAIRS,1,6,12

	ENDSELECT
	RETURN 1
	
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 7
	SELECTCASE FLAG:現M
		;一階西下り階段
		CASE 1
			;一階西　MAP7の座標を指定
			SIF FLAG:現X == 6 && FLAG:現Y == 12
				CALL DUNGEON_DOWNSTAIRS,6,1,13
		;一階東下り階段
		CASE 2
			;一階東　MAP7の座標を指定
			SIF FLAG:現X == 14 && FLAG:現Y == 7
				;地下一階　MAP6の座標を指定
				CALL DUNGEON_DOWNSTAIRS,0,1,5
		CASE 4
			;二階　MAP7の座標を指定
			SIF FLAG:現X == 16 && FLAG:現Y == 13
				CALL DUNGEON_DOWNSTAIRS,2,6,14
		CASE 5
			;三階　MAP7の座標を指定
			SIF FLAG:現X == 16 && FLAG:現Y == 3
				CALL DUNGEON_DOWNSTAIRS,4,16,3
	ENDSELECT
	RETURN 1
	
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 9
	SELECTCASE FLAG:現M
		
		CASE 1
			;一階西エレベーター
			SIF FLAG:現X == 10 && FLAG:現Y == 1
				CALL E_ROPPONGI
			SIF FLAG:現X == 19 && FLAG:現Y == 1
				CALL DUNGEON_WORP,2,1,1
			SIF FLAG:現X == 19 && FLAG:現Y == 12
				CALL DUNGEON_WORP,2,1,13
			SIF FLAG:現X == 19 && FLAG:現Y == 15
				CALL DUNGEON_WORP,2,1,16

			SIF FLAG:現X == 17 && FLAG:現Y == 10
				CALL DUNGEON_WORP,3,5,5

		CASE 2
			SIF FLAG:現X == 0 && FLAG:現Y == 1
				CALL DUNGEON_WORP,1,18,1
			SIF FLAG:現X == 0 && FLAG:現Y == 13
				CALL DUNGEON_WORP,1,18,12
			SIF FLAG:現X == 0 && FLAG:現Y == 16
				CALL DUNGEON_WORP,1,18,15
			SIF FLAG:現X == 10 && FLAG:現Y == 13
				CALL DUNGEON_TERMINAL

		CASE 3
			SIF FLAG:現X == 5 && FLAG:現Y == 7
				CALL DUNGEON_WORP,1,17,12

		CASE 4
			;二階エレベーター
			SIF FLAG:現X == 3 && FLAG:現Y == 1
				CALL E_ROPPONGI
		CASE 5
			;三階エレベーター
			SIF FLAG:現X == 3 && FLAG:現Y == 1
				CALL E_ROPPONGI
		CASE 6
			SIF FLAG:現X == 3 && FLAG:現Y == 1
				CALL E_ROPPONGI
		CASEELSE
	ENDSELECT
	RETURN 1


ELSE
	PRINTW 何も無いようだ
	RETURN 0
ENDIF

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_45,ARG
;ARG = 進入時の向き　0の場合ワープなど
;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 3
	SELECTCASE FLAG:現M
		CASE 1
			;反魂香
			SIF FLAG:現X == 3 && FLAG:現Y == 13
				CALL GET_TREASURE,1009,1,FLAG:現ダンジョン,20
		CASE 2
			;ディスポイズン
			IF FLAG:現X == 8 && FLAG:現Y == 1
