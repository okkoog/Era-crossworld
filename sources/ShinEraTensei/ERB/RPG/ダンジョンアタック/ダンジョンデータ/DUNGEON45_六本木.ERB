
;=======================================================================
;六本木
;ボス・黒おじさん
;ダンジョンナンバー45　ＭＡＰ0~6
;=======================================================================
;ダンジョンフラグ:45:0 = 1.ネビロス初回撃破　2.撃破後に六本木に来た　3.赤おじさん、黒おじさんの居た場所へ
;ダンジョンフラグ:45:1 = 1.OP表示
;ダンジョンフラグ:45:2 = 1.アリス出現　2.アリス消滅
;ダンジョンフラグ:45:10 = 1.アリスに会った　2.赤＆黒おじさんと話した　3.アリスと奴隷ごっこorチャクラPOTあげた　4.赤おじさん初戦壷がない　 5.赤おじさん壷入り　6.ネビロス初回撃破　7.黒おじさんが仲間になった
;ダンジョンフラグ:45:11 = 1.女の子を成仏させた
;ダンジョンフラグ:45:12 = 1.よしこの霊魂を成仏させた
;ダンジョンフラグ:45:13 = 1.アリスに会い、赤おじさんと話した
;ダンジョンフラグ:45:14 = 1.アリスに会い、黒おじさんと話した
;ダンジョンフラグ:45:15 = 1.壷を入手
;ダンジョンフラグ:45:16 = 1.よしこを導いた何か
;ダンジョンフラグ:45:17 = 1.肉便器一号
;ダンジョンフラグ:45:18 = 1.肉便器二号
;ダンジョンフラグ:45:19 = 1.死体置き場
;ダンジョンフラグ:45:20-29 = 1.宝箱、トラップ
;ダンジョンフラグ:45:30 = 1.アリスと奴隷ごっこした
;ダンジョンフラグ:45:31 = 1~街の噂追加式
;ダンジョンフラグ:45:40 = 1.赤おじさんに見初められた　2.赤おじさんとフュージョンした
;ダンジョンフラグ:45:41 = 1.赤おじさんとフュージョンして妊娠したよ　2.赤おじさんが仲魔になった

;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_45
[IF_DEBUG]
	RETURN 1
[ENDIF]
IF ダンジョンフラグ:18:22 == 1
	RETURN 1
ELSE
	RETURN 0
ENDIF
;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_45
RESULTS = 六本木


;=======================================================================
;フロア名表示
;=======================================================================
@FLOORNAME_45
PRINT 六本木
SELECTCASE FLAG:現M
	CASE 0
		PRINTL 連絡通路
	CASE 1
		PRINTL １Ｆ西
	CASE 2
		PRINTL １Ｆ東
	CASE 3
		PRINTL ＢＡＲ
	CASE 4
		PRINTL ２Ｆ
	CASE 5
		PRINTL ３Ｆ
	CASE 6
		PRINTL Ｂ１Ｆ
	CASEELSE
ENDSELECT


;=======================================================================
;特殊タイル表示
;=======================================================================
;エレベーター表示
@TILE_MARK_45_1_10_1
RESULTS = Ｅ
@TILE_MARK_45_4_3_1
RESULTS = Ｅ
@TILE_MARK_45_5_3_1
RESULTS = Ｅ
@TILE_MARK_45_6_3_1
RESULTS = Ｅ

@TILE_MARK_45_2_10_13
RESULTS = Ｔ

@TILE_MARK_45_1_19_1
RESULTS = →
@TILE_MARK_45_1_19_12
RESULTS = →
@TILE_MARK_45_1_19_15
RESULTS = →
@TILE_MARK_45_1_17_10
RESULTS = ↑

@TILE_MARK_45_2_0_1
RESULTS = ←
@TILE_MARK_45_2_0_12
RESULTS = ←
@TILE_MARK_45_2_0_15
RESULTS = ←

@TILE_MARK_45_3_5_7
RESULTS = ↓

@TILE_MARK_45_4_3_9
IF ダンジョンフラグ:45:2 == 1
	RESULTS = ！
ELSE
	RESULTS = □
ENDIF

@TILE_MARK_45_5_14_11
IF ダンジョンフラグ:45:2 == 1
	RESULTS = ！
ELSE
	RESULTS = □
ENDIF
;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_45,ARG
;階数
FLAG:現M = 0
FLAG:現X = 5
FLAG:現Y = 5
;CALL AUTOMAP

;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_45
IF ダンジョンフラグ:45:1 == 0 
	PRINTFORML 六本木
	PRINTFORML メシア教、ガイア教どちらにも属さぬ結界に包まれた謎の中立地帯
	PRINTFORML ファントム・ソサエティの上層部の指令により
	PRINTFORMW %CALLNAME:MASTER%は潜入捜査を命じられ、かの地を訪れた
	ダンジョンフラグ:45:1 = 1
ENDIF

IF ダンジョンフラグ:45:2 == 2
	ダンジョンフラグ:45:2 = 1
ENDIF

IF ダンジョンフラグ:45:0 == 1
	ダンジョンフラグ:45:0 = 2
ENDIF
;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_45,ARG,ARG:1
IF FLAG:現M == 4 && ARG == 7 && ARG:1 == 9
	IF ダンジョンフラグ:45:0 == 0
		PRINTW 扉は閉ざされている
		RETURN 0
	ELSEIF ダンジョンフラグ:45:0 >= 1 
		RETURN 1
	ENDIF
ENDIF

IF FLAG:現M == 6 && ARG == 5 && ARG:1 == 11
	IF ダンジョンフラグ:45:10 == 0
		PRINTW 扉は閉ざされている
		RETURN 0
	ELSE
		RETURN 1
	ENDIF
ENDIF

CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT
