			PRINTFORMW マテリアルカード【アヴァターラ】を手に入れた
			ITEM:アヴァターラ = 1
		ENDIF
		MONEY += 50000
;迷いの森侵入禁止
		ダンジョンフラグ:12:0 = 10
;地下鉄侵入禁止
		ダンジョンフラグ:11:7 = 1


		PRINTW ―――女神異聞録ペルソナ アナザーエンド条件達成―――
		PRINTW ………………
