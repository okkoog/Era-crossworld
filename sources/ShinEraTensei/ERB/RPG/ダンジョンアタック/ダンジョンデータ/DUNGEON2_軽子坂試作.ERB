			ELSEIF FLAG:現X == 8 && FLAG:現Y == 5
				;力の香り
				CALL GET_TREASURE,1010,1,FLAG:現ダンジョン,10
			ENDIF
	ENDSELECT
	RETURN 1
;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 6
SELECTCASE FLAG:現M
