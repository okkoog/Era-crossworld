		FLAG:脱出 = 1
	ELSE
		CALL MESSAGE_WINDOW_D, "", "＞軽子坂高校に作られた魔界へと足を踏み入れた‥‥/＞だが、すぐに誰かが後ろから呼び止めてきた。/＞振り返ると、そこに立っているのは、/＞眼鏡を掛け軽子坂の制服に身を包んだ女生徒だ。"
		CALL MESSAGE_WINDOW_D, "女生徒", "あなたは誰ですか？/うちの学生には見えませんが‥‥"
		CALL MESSAGE_WINDOW_D, "", "＞少し、話をして見た所、彼女の名前は赤根沢 玲子と言い、/＞この事態を何とかしようとしている生徒の一人らしい。/＞‥‥ただ、この少女。　何かこの件について心当たりでもある様だ。/＞だが、この点について問い詰めると沈黙してしまう‥‥"
		CALL INPUT_YN_D("関わるのは止めておこう", "身柄を押さえて秘密を聞き出す。")
		IF RESULT == 0
			CALL MESSAGE_WINDOW_D, "", @"＞%CALLNAME:MASTER%は一々関わっていてもキリがないと考え、/＞放っておいて先に進むことにした"
			DA:(FLAG:現X):(FLAG:現Y) = 1
			ダンジョンフラグ:2:12 = 2
		ELSE
			CALL MESSAGE_WINDOW_D, "玲子", "……な、何をする気ですか！？/い、いやぁ！！"
			CALL MESSAGE_WINDOW_D, "", "＞赤根沢 玲子を手に入れた"
			CALL ADD_NEW_COMPANION,4508,500,1
			DA:(FLAG:現X):(FLAG:現Y) = 1
			ダンジョンフラグ:2:12 = 1
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 0

