SIF DA:(FLAG:現X):(FLAG:現Y) > 10 && ARG
	CALL SHOW_PICTURE, "D"
SELECTCASE DA:(FLAG:現X):(FLAG:現Y) / 10
	CASE 0
		IF STRFLAG_NUM_D("シュバルツバース進行度") > 2
			CALL MESSAGE_WINDOW_D, "男", "すまない、アプリの回収は難航している/開発も、フォルマがあればできるんだがな…"
		ELSEIF STRFLAG_NUM_D("シュバルツバース進行度") == 2
			CALL MESSAGE_WINDOW_D, "男", "ほぅ、デモニカスーツの残骸か…/いいものを見つけてきたな、何かアプリを作れるかもしれない、少し待っていろ"
			CALL MESSAGE_WINDOW_D, "", "………………/…………/……/"
			CALL MESSAGE_WINDOW_D, "男", "よし、出来たぞ/とりあえずはスペーススキャナだけだがな/他のアプリは少し時間がかかりそうだ、探索を続けてきてくれ"
			CALL MESSAGE_WINDOW_D, "", "＞スペーススキャナを手に入れました。/管制ポイントより、隠された空間へ移動できます。"
			CALLF STRFLAG_NUM_D("シュバルツバース進行度", "+=", , 1)
		ELSEIF STRFLAG_NUM_D("シュバルツバース進行度") < 2
			CALL MESSAGE_WINDOW_D, "男", "ここはラボだ/だが、今は資源が足りないから何も作れないんだ"
		ENDIF
	CASE 1
		LOCAL = STRFLAG_NUM_D("調査船位置")
		LOCALS = 
		SIF LOCAL == 0
			CALL MESSAGE_WINDOW_D, "男", "今はまだ地上にいるぞ/どこかに移動するか？"
		SIF LOCAL == 1
			CALL MESSAGE_WINDOW_D, "男", "今はセクター・アントリアにいるぞ/どこかに移動するか？"
		SIF LOCAL == 2
			CALL MESSAGE_WINDOW_D, "男", "今はセクター・ボーティーズにいるぞ/どこかに移動するか？"
		SIF LOCAL == 3
			CALL MESSAGE_WINDOW_D, "男", "今はセクター・カリーナにいるぞ/どこかに移動するか？"
		SIF LOCAL == 4
			CALL MESSAGE_WINDOW_D, "男", "今はセクター・デルファイナスにいるぞ/どこかに移動するか？"
		SIF LOCAL == 5
			CALL MESSAGE_WINDOW_D, "男", "今はセクター・エリダヌスにいるぞ/どこかに移動するか？"
		LOCALS += "[0] 動かさない/"
		SIF STRFLAG_D("アントリア可能") && LOCAL != 1
			LOCALS += "[1] セクター・アントリアへ/"
		SIF STRFLAG_D("ボーティーズ可能") && LOCAL != 2
			LOCALS += "[2] セクター・ボーティーズへ/"
		SIF  LOCAL != 3
			LOCALS += "[3] セクター・カリーナへ/"
		SIF STRFLAG_D("デルファイナス可能") && LOCAL != 4
			LOCALS += "[4] セクター・デルファイナスへ/"
		SIF STRFLAG_D("エリダヌス可能") && LOCAL != 5
			LOCALS += "[5] セクター・エリダヌスへ/"
		CALL INPUT_SELECT_D, LOCALS
		IF RESULT == 0
			CALL MESSAGE_WINDOW_D, "男", "わかった、今のセクターのままでいいんだな。"
			RETURN 0
		ELSEIF RESULT == 1
			CALL MESSAGE_WINDOW_D, "男", "わかった、セクター･アントリアだな/"
			CALL MESSAGE_WINDOW_D, "", "………………/…………/……/"
			CALL MESSAGE_WINDOW_D, "", "無事移動できたぞ"
			CALLF STRFLAG_NUM_D("調査船位置", "=", , 1)
		ELSEIF RESULT == 2
			CALL MESSAGE_WINDOW_D, "男", "わかった、セクター･ボーティーズだな/"
			CALL MESSAGE_WINDOW_D, "", "………………/…………/……/"
			CALL MESSAGE_WINDOW_D, "", "無事移動できたぞ"
			CALLF STRFLAG_NUM_D("調査船位置", "=", , 2)
		ELSEIF RESULT == 3
			CALL MESSAGE_WINDOW_D, "男", "わかった、セクター･カリーナだな/"
			CALL MESSAGE_WINDOW_D, "", "………………/…………/……/"
			CALL MESSAGE_WINDOW_D, "", "無事移動できたぞ"
			CALLF STRFLAG_NUM_D("調査船位置", "=", , 3)
		ELSEIF RESULT == 4
			CALL MESSAGE_WINDOW_D, "男", "わかった、セクター･デルファイナスだな/"
			CALL MESSAGE_WINDOW_D, "", "………………/…………/……/"
			CALL MESSAGE_WINDOW_D, "", "無事移動できたぞ"
			CALLF STRFLAG_NUM_D("調査船位置", "=", , 4)
		ELSEIF RESULT == 5
			CALL MESSAGE_WINDOW_D, "男", "わかった、セクター･エリダヌスだな/"
			CALL MESSAGE_WINDOW_D, "", "………………/…………/……/"
			CALL MESSAGE_WINDOW_D, "", "無事移動できたぞ"
			CALLF STRFLAG_NUM_D("調査船位置", "=", , 5)
		ENDIF
	CASE 2
		CALL MESSAGE_WINDOW_D, "運転手", "シュバルツバースから脱出するか？"
		CALL INPUT_YN
		IF RESULT == 0
			CALL MESSAGE_WINDOW_D, "運転手", "わかった、じゃあ脱出するぞ"
			FLAG:脱出スキル禁止 = 0
			FLAG:脱出 = 1
		ELSEIF RESULT == 1
			CALL MESSAGE_WINDOW_D, "運転手", "そうか/脱出したくなった時はいつでも言ってくれ"
		ENDIF
	CASE 3
		SELECTCASE STRFLAG_NUM_D("シュバルツバース進行度")
			CASE IS < 5
				CALL MESSAGE_WINDOW_D, "隊長", "今の任務を確認しよう。/セクター・カリーナの量子トンネルまでの道の確保だ/気をつけていけよ"
			CASE 5
				CALL MESSAGE_WINDOW_D, "隊長", "量子トンネルまでの道程を確保できたようだな/ごくろうだった/ロゼッタ多様体も回収できたようだな"
				CALL MESSAGE_WINDOW_D, "", "量子場自体が若干変化しているようで、/ロゼッタ多様体がなければ侵入できないところだった"
				CALL MESSAGE_WINDOW_D, "", "さぁ、ひとまず地上に帰ろう/後日また連絡しよう"
				CALLF STRFLAG_NUM_D("シュバルツバース進行度", "+=", , 1)
				FLAG:脱出スキル禁止 = 0
				FLAG:脱出 = 1
			ENDSELECT
	CASE 4
		CALL MESSAGE_WINDOW_D, "看護師", "ここは治療室よ/でも、今はやってないの/作者がサボってるわけじゃないからね"
		
		

	CASE 1200
		IF !STRFLAG_D("フロスト初回")
			CALL MESSAGE_WINDOW_D, "", "＞べストのようなものを着た、ジャックフロストらしき悪魔がいる…/どうやら向こうもこっちに気づいたようだ…"
			CALL MESSAGE_WINDOW_D, "悪魔", "ホ？/ニンゲンだホ、久しぶりに見るホ"
			CALL MESSAGE_WINDOW_D, "", "オイラはカオスなセカイのダークヒーロー、フロストエースだホ/覚えておくホ"
			CALLF STRFLAG_D("フロスト初回", 1)
		ENDIF
		CALL MESSAGE_WINDOW_D, "フロストエース", "オイラに何か用かホ？"
		CALL MESSAGE_WINDOW_D, "", @"＞%CALLNAME:MASTER%は何も用がない事を伝えた…。"
		CALL MESSAGE_WINDOW_D, "フロストエース", "そうかホ、もし何か用があったらオイラに依頼するホ"
	CASE 1201
		CALL MESSAGE_WINDOW_D, "調査隊員", "この先は暗闇になっている/視界がかなり悪いから気をつけろ"
		IF EQUIP:MASTER:ダークスキャナー && NUM_SUMMONER()
			CALL MESSAGE_WINDOW_D, "", "まぁ、ダークスキャナーを持っているから大丈夫だろうがな。"
		ELSE
			CALL MESSAGE_WINDOW_D, "", "ダークスキャナーがあれば見えるんだがな…。"
		ENDIF

ENDSELECT




