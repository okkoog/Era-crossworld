;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_65
SELECTCASE DA:(FLAG:現X):(FLAG:現Y)% 10
	;イベントタイル
	CASE 1
		CALL TILE_65
		RETURN RESULT
	;========
	;宝の処理
	;========
	CASE 3
		CALL TREASURE_65
		RETURN 1
	;========================
	;イベント
	;========================
	CASE 4
		CALL EVENT_65
		RETURN 1
	;=======
	;罠
	;=======
	CASE 5
		CALL TRAP_65
		RETURN 1
	;=======
	;昇り階段
	;=======
	CASE 6
		CALL UPSTAIRS_65
		RETURN 1
	;=======
	;下り階段
	;=======
	CASE 7
		CALL DOWNSTAIRS_65
		RETURN 1
	;=======
	;メッセンジャー
	;=======
	CASE 8
		CALL MESSAGE_65, 0
		RETURN 1
	;=======
	;特殊タイル
	;=======
	CASE 9
		CALL SPECIAL_65
		RETURN 1
	;=======
	;ダークゾーン
	;=======
	CASE -1
		IF DA:(FLAG:現X):(FLAG:現Y) < -10
			CALL DARK_65
			RETURN RESULT
		ENDIF
	CASEELSE
		CALL MESSAGE_WINDOW_D, "", "＞何も無いようだ"
	RETURN 0
ENDSELECT

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_65,ARG
;ARG = 進入時の向き　0の場合ワープなど
SELECTCASE DA:(FLAG:現X):(FLAG:現Y) % 10
	;イベントタイル
	CASE 1
		CALL TILE_65, 1
		RETURN RESULT
	;==========
	;扉の処理
	;==========
	CASE 2
		SIF GROUPMATCH(DA:(FLAG:現X):(FLAG:現Y),902,922,942,962)
			DA:(FLAG:現X):(FLAG:現Y) += 10
		CALL DUNGEON_DOOR,ARG
		RETURN 1
;========
;宝の処理
;========
	CASE 3
		CALL TREASURE_65
		RETURN 1
;========================
;イベント
;========================
	CASE 4
		CALL EVENT_65, 1
		RETURN 1
;=======
;罠
;=======
CASE 5
	CALL TRAP_65
	RETURN 1
;=======
;昇り階段
;=======
CASE 6
	CALL UPSTAIRS_65
	RETURN 1
;=======
;下り階段
;=======
CASE 7
	CALL DOWNSTAIRS_65
	RETURN 1
;=======
;メッセンジャー
;=======
	CASE 8
		CALL MESSAGE_65, 1
		RETURN 1
;=======
;特殊タイル
;=======
	CASE 9
		CALL SPECIAL_65
		RETURN 1
;=======
;ダークゾーン
;=======
	CASE -1
		CALL DARK_65, 1
		RETURN RESULT
ENDSELECT


;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_65
CALLF STRFLAG_NUM_D("調査船位置", "=", , 0)
IF STRFLAG_NUM_D("シュバルツバース進行度") == 0
	CALL MESSAGE_WINDOW_D, "", "………………/…………/……/"
	CALL MESSAGE_WINDOW_D, "", "＞シュバルツバースに突入できたようだ。/＞どうやらミーティングが始まるようだ…。"
	CALL MESSAGE_WINDOW_D, "調査隊隊長", "諸君、私がシュバルツバース調査隊の隊長だ。/我々の任務は、セクター・カリーナの量子トンネルまでの道の確保だ。/気をつけていけよ。"
	CALLF STRFLAG_NUM_D("シュバルツバース進行度", "+=", , 1)
ENDIF



;=======================================
;床
;=======================================
@TILE_MARK_COMMON_65_1, ARG, ARG:1, ARG:2
SELECTCASE ARG / 10
	CASE 100
		IF STRFLAG_NUM_D("調査船位置") == 0
			RESULTS = ■
		ELSE
			RESULTS = 外
		ENDIF
	CASE 2300
		RESULTS = 艦
	CASE 1500, 1501, 1502, 1503, 1900, 1902, 1905, 1906, 2001, 2003, 2004, 2007, 2101, 2103, 2104, 2107, 2201, 2203, 2204, 2207
		RESULTS = →
	CASE 1504, 1907
		RESULTS = ↑
	CASE 1600, 1601, 1602, 1603, 1700, 1701, 1702, 1703, 1800, 1801, 1802, 1803, 1901, 1903, 1904, 1908, 2000, 2002, 2005, 2006, 2100, 2102, 2105, 2106, 2200, 2202, 2205, 2206
		RESULTS = ←
	CASE 1604, 1704, 1804, 2008, 2108, 2209
		RESULTS = ↓
	
	
	CASEELSE
		RESULTS = □
ENDSELECT

@TILE_65, ARG
#LOCALSIZE 10
SELECTCASE DA:(FLAG:現X):(FLAG:現Y) / 10

	CASE 100
		IF EQUIP:MASTER:デモニカ != 1
			CALL MESSAGE_WINDOW_D, "男", "おい、お前！/自殺でもするつもりか？/悪い事は言わん、ターミナルでデモニカを起動してこい"
			FLAG:現X -= 1
		ELSEIF STRFLAG_NUM_D("調査船位置") != 0
			PRINTW 探索に行きますか？
			CALL INPUT_YN
			IF RESULT == 0
				CALL MESSAGE_WINDOW_D, "男", "気をつけて行ってこいよ/"
				IF STRFLAG_NUM_D("調査船位置") == 1
					CALL DUNGEON_WORP,1,19,34
				ELSEIF STRFLAG_NUM_D("調査船位置") == 2
					CALL DUNGEON_WORP,4,4,23
				ELSEIF STRFLAG_NUM_D("調査船位置") == 3
					CALL DUNGEON_WORP,22,3,11
				ELSEIF STRFLAG_NUM_D("調査船位置") == 4
					CALL DUNGEON_WORP,23,14,23
				ELSEIF STRFLAG_NUM_D("調査船位置") == 5
					CALL DUNGEON_WORP,32,18,17
				ENDIF
			ELSEIF RESULT == 1
				FLAG:現X -= 1
			ENDIF
		ENDIF
	
	CASE 2300
		CALL MESSAGE_WINDOW_D, "", "船に戻りますか？"
		CALL INPUT_YN
		IF RESULT == 0
			CALL DUNGEON_WORP,0,37,7
			RETURN 1
		ELSEIF RESULT == 1
			FLAG:現X += 1
		ENDIF
	CASE 2301
		IF STRFLAG_NUM_D("シュバルツバース進行度") == 1
			CALL MESSAGE_WINDOW_D, "", "＞セクター・カリーナ…。/シュバルツバース調査隊が３番目に調査したエリアだったはずだ。/報告によれば、このエリアはショッピングモールのような光景だったそうだが…。"
			CALL MESSAGE_WINDOW_D, "", "………………/…………/……/"
			CALL MESSAGE_WINDOW_D, "", "なるほど、確かに報告にあったとおりだ。/だが、このシュバルツバースは魔界のはずである。/このショッピングモールのような、人間界にあるものが/魔界で見られるとは一体どういうことであろうか…。"
			CALL MESSAGE_WINDOW_D, "", "……"
			CALL MESSAGE_WINDOW_D, "", @"考えてもどうしようもないことである。/そう考えた%CALLNAME:MASTER%はシュバルツバースに足を踏み入れた…。"
			CALLF STRFLAG_NUM_D("シュバルツバース進行度", "+=", , 1)
		ENDIF
	CASEELSE
		CALL WORP_65

ENDSELECT
SIF !ARG
	CALL MESSAGE_WINDOW_D, "", "＞何も無いようだ"
RETURN 0

;=======================================
;扉
;=======================================
@TILE_MARK_COMMON_65_2, ARG, ARG:1, ARG:2
SELECTCASE ARG / 10

	;一方通行
	CASE 90, 92, 94, 96
		RESULTS = 扉
	CASE 91, 93, 95, 97,
		RESULTS = ■
	CASEELSE
		RESULTS = 扉
ENDSELECT

@DOOR_65, ARG
SELECTCASE ARG
	CASE 1400, 1402
		IF STRFLAG_NUM_D("プラズマウォール") == 0
			CALL MESSAGE_WINDOW_D, "調査隊員", "おい、なんでシュバルツバースの壁に/プラズマウォールが展開されているんだ…？/これじゃ先に進めないぜ…"
			RETURN 0
		ELSEIF STRFLAG_NUM_D("プラズマウォール") == 1
			CALL MESSAGE_WINDOW_D, "調査隊員", "プラズマウォール発生装置を停止してきただと？/ここの扉には何も変化はないぞ。/あっちの方にも扉はあるらしいから見てきてくれ。"
			CALL MESSAGE_WINDOW_D, "調査隊員", "その先にまた別の発生装置があるかもしれん。/それも停止してきてくれ。"
			RETURN 0
		ELSEIF STRFLAG_NUM_D("プラズマウォール") == 3
			CALL MESSAGE_WINDOW_D, "調査隊員", "プラズマウォール発生装置を停止してきてくれたようだな。/先に進めるようになったぞ。/"
			CALLF STRFLAG_NUM_D("プラズマウォール", "+=", , 1)
		ENDIF
	CASE 1401, 1403
		IF STRFLAG_NUM_D("プラズマウォール") == 4
			CALL MESSAGE_WINDOW_D, "調査隊員", "クソッ、またプラズマウォールかよ！/また探すのかよっ！もう目と鼻の先なのにっ！"
			RETURN 0
		ELSEIF STRFLAG_NUM_D("プラズマウォール") == 5
			CALL MESSAGE_WINDOW_D, "調査隊員", "ようやくこれで先に進めるな。/量子トンネルは目の前だ、行こうぜっ！"
			CALLF STRFLAG_NUM_D("プラズマウォール", "+=", , 1)
		ENDIF
	CASE 1404
		IF STRFLAG_NUM_D("プラズマウォール") == 0
			CALL MESSAGE_WINDOW_D, "調査隊員", "おい、なんでシュバルツバースの壁に/プラズマウォールが展開されているんだ…？/これじゃ先に進めないぜ…"
			RETURN 0
		ELSEIF STRFLAG_NUM_D("プラズマウォール") == 1
			CALL MESSAGE_WINDOW_D, "調査隊員", "どうやらここのプラズマウォールは解除されたみたいだな…"
			CALL MESSAGE_WINDOW_D, "", "向こうのプラズマウォールはまだ解除されてない、か…。/この先にまた装置があるのか？"
			CALLF STRFLAG_NUM_D("プラズマウォール", "+=", , 1)
		ENDIF
ENDSELECT
RETURN 1

;=======================================
;宝箱
;=======================================
@TREASURE_65
#LOCALSIZE 3
#LOCALSSIZE 3
LOCAL:2 = (DA:(FLAG:現X):(FLAG:現Y) / 10) % 100
;個数,-1のとき、魔貨・0の時、\となる
LOCAL = 1
;IDは現M*100＋X個目の宝箱の法則でふられている
SELECTCASE DA:(FLAG:現X):(FLAG:現Y) / 10

	;
	CASE 1200
		LOCALS = 宝玉
		LOCAL = 2
	CASE 1300
		LOCALS = ヤマタノドリンク
		LOCAL = 1
	CASE 1301
		LOCALS = 速さの香
		LOCAL = 1
	CASE 1302
		LOCALS = 道返玉
		LOCAL = 2
	CASE 1303
		LOCALS = 魔貨
		LOCAL = 150
	CASE 1400
		LOCALS = 反魂香
		LOCAL = 1
	CASE 2200
		LOCALS = 運の香
		LOCAL = 1
	

ENDSELECT
IF LOCALS == "￥"
	CALL GET_TREASURE_MONEY, 0, LOCAL, FLAG:現ダンジョン, FLAG:現M + 25, (DA:(FLAG:現X):(FLAG:現Y) / 10) % 100
ELSEIF LOCALS == "魔貨"
	CALL GET_TREASURE_MONEY, 1, LOCAL, FLAG:現ダンジョン, FLAG:現M + 25, (DA:(FLAG:現X):(FLAG:現Y) / 10) % 100
ELSEIF LOCALS == "MAG" || LOCALS == "ＭＡＧ"
	CALL GET_TREASURE_MAG, 0, LOCAL, FLAG:現ダンジョン, FLAG:現M + 25, (DA:(FLAG:現X):(FLAG:現Y) / 10) % 100
ELSEIF LOCALS == "罠"
	;LOCALS:1 種類 LOCAL ダメージ量or確率 LOCALS:2 相性
	CALL GET_TREASURE_TRAP, LOCALS:1, LOCAL, GET_TYPE_NUM(LOCALS:2), FLAG:現ダンジョン, FLAG:現M + 25, (DA:(FLAG:現X):(FLAG:現Y) / 10) % 100
ELSE
	IF GETNUM(ITEM, LOCALS) == -1
		PRINTL ＞アイテム名の指定が間違ってます
		PRINTW ＞アイテムの取得処理を中断します
	ELSE
		CALL GET_TREASURE, GETNUM(ITEM, LOCALS), LOCAL , FLAG:現ダンジョン, FLAG:現M + 25, (DA:(FLAG:現X):(FLAG:現Y) / 10) % 100
	ENDIF
ENDIF



;=======================================
;イベント
