@PREREQUISITE_DUNGEON_19
;迷いの森クリアかつ麻希が存在してること
IF ダンジョンフラグ:12:1 == 1 && ダンジョンフラグ:19:1 == 0 && GETCHARA([[キャラ:麻希]]) >= 0
	RETURN 1
ELSE
	RETURN 0
ENDIF

