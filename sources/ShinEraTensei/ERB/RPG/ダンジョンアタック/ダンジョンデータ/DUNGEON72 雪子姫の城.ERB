	IF ダンジョンフラグ:72:0 == 0
		PRINTFORML ＞クマに教えられた道を進み、%CALLNAME:MASTER%は洋風の城のような場所にたどり着いた。
			PRINTW 
			PRINTL 　この城の奥に雪子と呼ばれる少女がいるらしい
			PRINTL 　そしてその雪子という子を助けにここに飛び込んで行った千枝という子も…
			PRINTW 
			ダンジョンフラグ:72:0 = 1
	ENDIF
;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_72,ARG,ARG:1
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT
