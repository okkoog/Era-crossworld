;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_72

;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
;% 10は10で割ったあまり、つまり下一桁がでてきます
;そして、下一桁はタイルの種類を表す
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 3
	CALL TREASURE_72
	RETURN RESULT
;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 6
	CALL UPSTAIRS_72
	RETURN RESULT

ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 7
	CALL DOWNSTAIRS_72
	RETURN RESULT
ELSEIF DA:(FLAG:現X):(FLAG:現Y) %10 == 9
	SELECTCASE DA:(FLAG:現X):(FLAG:現Y) /10
	CASE 0
		CALL DUNGEON_TERMINAL
		RETURN 1
	CASE 1
		PRINTL 妖精 シルキー：
		PRINTL 「ふふっ、レベルの低い私がここにいて不思議そうな顔をしてますね。」
		PRINTL 「補助魔法があればレベルの高い相手に遅れをとることはないんですよ。」
		PRINTW 
		PRINTL 「ラク・カジャ、スク・カジャ、カジャ系なんて言い方もするわ。」
		PRINTW 「補助魔法があれば、強敵にばったり会っても平気よ。」
		PRINTW 「あなたにも補助魔法をかけてくれる素敵な相手が出来るといいわね。」
	CASE 2
		PRINTL 妖魔 リリム：
		PRINTL 「ラク・ンダ！タル・ンダ！」
		PRINTL 「んふふふふっ。早過ぎてお話にならないわぁ♪」
		PRINTW 
		PRINTL 「ちょっと弱化魔法をかけてあげるだけですぐイッちゃうんだから世話ないわね」
		PRINTL 「まぁ、強そうな子には入念に重ねがけしてあげるんだけどね」
		PRINTW 
		PRINTL 「ところでウチのサマナー見なかった？」
		PRINTW 「探索しろって言われたからバラバラで動いてるんだけど、何処に行ったか知らない？」
	CASE 3
		PRINTL 天然サマナー：
		PRINTL 「シルキーちゃんのラク・カジャをカードにして…次は…」
		PRINTL 「あ、こんにちは～」
		PRINTW 
		PRINTL 「スキルカードって便利ですよね～好きなスキルをつけたり消したり」
		PRINTL 「あんまり可愛くない子でもいいスキルがあると」
		PRINTW 「ついつい忠誠度を1000まで育てちゃうんですよね～」
		PRINTL 「よし！じゃあリリムちゃん！そこの邪教の館でカード作ってもらお…あれ？」
		PRINTW 
		PRINTW 「私さっきまで町に居て…えっと………」
		PRINTL 「すっ、すみません！」
 		PRINTL 「ここって…どこですか！！！」
 		PRINTW 
	CASEELSE
		CALL DUNGEON_TERMINAL
		RETURN 1
	ENDSELECT
ELSE
	PRINTW 何も無いようだ
	RETURN 0
ENDIF






;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_72,ARG
;ARG = 進入時の向き　0の場合ワープなど
;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) % 10 == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 3
	CALL TREASURE_72
	RETURN RESULT
;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 6
	CALL UPSTAIRS_72
	RETURN RESULT

ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 7
	CALL DOWNSTAIRS_72
	RETURN RESULT

;==========
;扉の処理
;==========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 2
	CALL DUNGEON_DOOR,ARG
	RETURN 1
;========================
;イベント
;========================
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 4
	SELECTCASE DA:(FLAG:現X):(FLAG:現Y) /10
		CASE 1
			CUSTOMDRAWLINE =
			PRINTL 「雪子ってば美人で、色白で、女らしくて…男子なんかいっつもチヤホヤしている。」
			PRINTW 「その雪子が、時々あたしを卑屈な目で見てくる…それが、たまんなく嬉しかった。」
			PRINTL 「そうよ、雪子なんて本当はあたしが居なきゃ何にも出来ない…」
			PRINTL 「あたしの方が…あたしの方が…あたしの方が！ずっと上じゃない！！」
			PRINTW 
			PRINTW 「違う！あ、あたし、そんなこと！」
			PRINTL 
			PRINTL ＞あなたが部屋に入ると同じ顔をした女の子が二人いた。
			PRINTW 　目をギラギラと輝かせている方が一方的に詰っているように見える
			PRINTL 
			PRINTL 「…え？なんで他の人が？や…やだ！こないで！見ないで！」
			PRINTL 「違う…違う、こんなのあたしじゃない！」
			PRINTW
			PRINTL 「ふふ…そうだよねぇ。一人じゃ何にも出来ないのは、本当はあたし…」
			PRINTW 「人としても、女としても、本当は勝ててない、どうしようもない、あたし…」
			PRINTL 「でもあたしは、あの雪子に頼られてるの…」
			PRINTL 「ふふ、だから雪子はトモダチ…手放せない…雪子が大事…」
			PRINTW 
			PRINTL 「黙れ！！アンタなんか…アンタなんか、あたしじゃない！！」
			PRINTW
			PRINTL ＞責められていた側の女の子が否定する発言をしたその時
			PRINTL 　目を怪しく光らせていた女の子から黒い影が溢れみるみるその姿が変わっていく…
			PRINTW 
			PRINTL 「ふふふ、ふふ、ふ、きゃーはっはっは！！！」
			PRINTW 
				FLAG:逃走不可フラグ = 1
				FLAG:会話不能フラグ = 1
				FLAG:先制不意打ちキャンセル = 1
				CUSTOMDRAWLINE =
				WAIT
				CALL SET_ENEMY,9,3270,15,0,1
				CFLAG:(CHARANUM-1):行動回数 = 2
				MAXBASE:(CHARANUM-1):破魔 = 0
				MAXBASE:(CHARANUM-1):呪殺 = 0
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				CALL BATTLE_START
				FLAG:逃走不可フラグ = 0
				FLAG:会話不能フラグ = 0
				FLAG:先制不意打ちキャンセル = 0
				WAIT
			PRINTL 
			PRINTL ＞千枝の影を倒した。
			PRINTW 
			PRINTL 「アンタは…あたしの中にいたもう一人のあたし…って事ね…」
			PRINTL 「でも、あたしはアンタで、アンタはあたし、なんだよね…」
			PRINTW 
			PRINTL ＞影は千枝の言葉を聞くと姿を変え、人型の悪魔のような姿に変わり消えていった。
			PRINTW 
			;どちらかと言えば雪子っぽかったかな？
			PRINTL 「あ、えっと…その…助けてくれてありがとうございます。」
			PRINTL 「そのっ、雪子って子がこの奥で捕まってて…」
			PRINTW 「手伝ってもらえると…助かるんだけど…」
			PRINTL 
			PRINTFORML どうする？
			PRINTL [0]調教する
			PRINTL [1]無理やり犯す
			PRINTL [2]協力を約束する
			$INPUT_LOOP
			INPUT
			IF RESULT == 0
				PRINTW 
				PRINTL 「え！？やだ！ちょっと！やめてよっ」
				PRINTW 
				DA:(FLAG:現X):(FLAG:現Y) = 1
				ダンジョンフラグ:72:1 = 2
				CALL ADD_NEW_COMPANION,4560,100
				TARGET = GETCHARA(4560)
				FLAG:ダンジョン内調教 = 1
			ELSEIF RESULT == 1
				PRINTL 
				PRINTL 「え！？やだ！ちょっと！やめてよっ」
				PRINTW 
				CALL ADD_NEW_COMPANION,4560,100
				LOCAL = RESULT:1
				TALENT:LOCAL:処女 = 0
				ABL:LOCAL:Ｃ感覚 = 1
				ABL:LOCAL:Ｖ感覚 = 2
				ABL:LOCAL:Ａ感覚 = 1
				ABL:LOCAL:Ｂ感覚 = 1
				ABL:LOCAL:露出癖 = 1
				ABL:LOCAL:マゾっ気 = 1
				MARK:LOCAL:反発刻印 = 2
				EXP:LOCAL:Ｖ経験 = 5
				EXP:LOCAL:Ａ経験 = 5
				EXP:LOCAL:絶頂経験 = 1
				EXP:LOCAL:性交経験 = 5
				EXP:LOCAL:フェラ経験 = 2
				EXP:LOCAL:苦痛快楽経験 = 5
				EXP:LOCAL:緊縛経験 = 5
				EXP:LOCAL:異常経験 = 2
				IF TALENT:MASTER:140 == 1 || TALENT:MASTER:139 == 1
					EXP:LOCAL:精液経験 = 10
					EXP:LOCAL:膣射経験 = 5
				ENDIF
				PRINTW ………
				PRINTW ……
				PRINTW …
				PRINTW ＞既に抵抗をやめ、人形のようになった千枝を適当な場所に隠し先に進むことにした。
				ダンジョンフラグ:72:1 = 2
				DA:(FLAG:現X):(FLAG:現Y) = 1
				RETURN 1
			ELSE
				PRINTL ＞あなたは快く応じることにした。
				PRINTW 
				PRINTL 「ほんと！?ありがとう。アタシは里中千枝。よろしくね。」
				PRINTL ＞そういって差し出された手を握った瞬間、千枝はその場にへたりこんでしまった。
				PRINTL 
				PRINTL 「やだ、雪子がまだこの中にいるのに！早く助けないと雪子が！」
				PRINTW 
				PRINTL ＞あなたは焦る千枝を諭し、一度事務所に戻ることを提案した。
				PRINTW 
				PRINTL 「そう…だよね。アタシが無事じゃないと雪子が悲しむもんね…」
				PRINTW 「でも、雪子を助けられるのはアタシだけだから…抜け駆けとかしないでよね！」 
				CALL ADD_NEW_COMPANION,4560,200
				;戦闘参加可能で加入するが、調教で戦闘参加不可能になる
				SIF RESULT
					CFLAG:(RESULT:1):戦闘参加不可能 = -1
				DA:(FLAG:現X):(FLAG:現Y) = 1
				ダンジョンフラグ:72:1 = 1
				PRINTL 
				PRINTL ＞あなたは疲労している千枝に付添い、ダンジョンを脱出した。
				PRINTW
				FLAG:脱出 = 1
				RETURN 1
			ENDIF
		CASE 2
			PRINTW 「あら？あらららららぁ～」
			PRINTL 「やだ！ホントに来ちゃった私の王子様！」
			PRINTL 「つーかぁ、雪子ねぇ、どっか、行っちゃいたいんだぁ。」
			PRINTL 「どっか、誰も知らない遠くぅ。王子様なら、連れてってくれるでしょぉ？」
			PRINTL 「ねぇ、早くぅ。」
			PRINTW 
			PRINTL ＞城の最上階、王座の前にいるピンク色をしたドレスを着た女の子が熱烈なアプローチをしてくる。
			PRINTL 　その下で、まるで家来がそうするかのように同じ顔の女の子が力なくうなだれている
			PRINTL 　おそらくこちらが天城 雪子本人なのだろう。
			IF ダンジョンフラグ:72:1 == 1
				IF FINDCHARA_B(4560)== 2 
					PRINTL 
					PRINTL 「雪子！」
					PRINTL ＞やっとの思いで見つけた探し人の様子を案じ、千枝が一歩前に出た。
					PRINTW
					PRINTL 「千枝…貴女もアタシの王子様…」
					PRINTL 「いつだってアタシをリードしてくれる…千枝は強い、王子様…"だった"」
					PRINTL 「結局、千枝じゃダメなのよ！千枝じゃアタシを、ここから連れ出せない！救ってくれない！」
					PRINTW 
					PRINTL 「や、やめて…」
					PRINTW 
					PRINTL 「…どっか、遠くへ行きたいの…ここじゃない、どこか…」
