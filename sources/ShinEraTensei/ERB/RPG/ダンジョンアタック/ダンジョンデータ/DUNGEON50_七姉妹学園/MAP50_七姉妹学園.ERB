
;=======================================================================
;森本病院
;=======================================================================
;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_50
SIF !STRFLAG_REQ("七姉妹学園調査依頼クリア", 0, [[依頼:ペルソナ２]])
	RETURN 0
SIF STRFLAG_D("七姉妹学園クリア", 0, [[ダンジョン:ペルソナ２]])
	RETURN 0
RETURN 1



;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_50
RESULTS = 七姉妹学園

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_50, ARG, ARG:1
IF FLAG:現M == 2 && ARG == 24 && ARG:1 == 8
	IF ITEM:時計台の鍵
		RETURN 1
	ELSEIF STRFLAG_D("時計台")
		IF STRFLAG_EV("罪ルート", 0, [[イベント:ペルソナ２]])
			PRINTFORMW ＞達哉は首を振ると、廊下のほうを指さした
		ELSE
			PRINTFORMW ＞舞耶は首を振ると、廊下のほうを指さした
		ENDIF
	ELSEIF STRFLAG_D("校長室")
		IF STRFLAG_EV("罪ルート", 0, [[イベント:ペルソナ２]])
			PRINTL リサ:
			PRINTFORMW 「なにこの感じ…ペルソナが…ペルソナがおびえてる…この感じ…まさか」
			PRINTL 栄吉:
			PRINTFORMW 「わかる…この中に敵がいるぜ…」
			PRINTL リサ:
			PRINTFORMW 「うん…間違いない…」
			PRINTL 
			PRINTFORMW ＞%CALLNAME:MASTER%は３人に目配せをすると扉をあけようとした
			PRINTFORMW ＞しかし、扉にはしっかりと鍵がかかっていた…
			PRINTL 
			PRINTL 栄吉:
			PRINTFORMW 「鍵かかってんのかよ……調子狂うぜ……」
			PRINTL リサ:
			PRINTFORMW 「たぶん、鍵は職員室にあるから、とりにいこ」
			PRINTFORMW 「場所はわかる？　２階の西の突き当たり、つまりここの真下だけど」
		ELSEIF STRFLAG_EV("罰ルート", 0, [[イベント:ペルソナ２]])
			PRINTL うらら:
			PRINTFORMW 「う…なにこの感じ…ペルソナが怯えてる…？」
			PRINTL 克哉:
			PRINTFORMW 「あぁ、おそらくこの中に犯人がいるぞ…」
			PRINTL うらら:
			PRINTFORMW 「うん…共鳴っていうのかな。間違いないよ」
			PRINTL 
			PRINTFORMW ＞%CALLNAME:MASTER%は３人に目配せをすると扉をあけようとした
			PRINTFORMW ＞しかし、扉にはしっかりと鍵がかかっていた…
			PRINTL 
			PRINTL うらら:
			PRINTFORMW 「ありゃ、鍵なんかかかってんの？　こうなったらぶっ壊すしか…」
			PRINTL 
			PRINTFORMW ＞うららは拳を振り上げた
			PRINTL 
			PRINTL 克哉:
			PRINTFORMW 「いや、それは不味いだろう。鍵はおそらく職員室にあるだろうから借りてこよう」
			PRINTFORMW 「職員室は２階の西の突き当たり、つまりここの真下だ」
		ELSE
			PRINTW ＞扉には鍵がかかっている
		ENDIF
		CALLF STRFLAG_D("時計台", 1)
	ELSE
		PRINTW ＞扉には鍵がかかっている
	ENDIF
RETURN 0
;トリッシュの泉
ELSEIF FLAG:現M == 2 && (ARG == 13 || ARG == 17) && ARG:1 == 10 && !STRFLAG_D("ボス撃破")
	CALL FOUNTAIN_OF_TRISH
	RETURN 0
ELSE
	CALL CAN_ENTER, ARG, ARG:1
		RETURN RESULT
ENDIF

;=======================================================================
;フロア名表示
;=======================================================================
@FLOORNAME_50
SELECTCASE FLAG:現M
	CASE 0
		PRINTL １Ｆ
	CASE 1
		PRINTL ２Ｆ
	CASE 2
		PRINTL ３Ｆ
	CASE 3
		PRINTL 時計台
ENDSELECT

