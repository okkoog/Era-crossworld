;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_11
;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 3
	CALL TREASURE_11
	RETURN 1
;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 6
	CALL UPSTAIRS_11
	RETURN RESULT
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 7
	CALL DOWNSTAIRS_11
	RETURN RESULT
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 9
	CALL DUNGEON_TERMINAL
	RETURN 1
;========
;イベントの処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 4
	IF FLAG:現M == 4 && FLAG:現X == 17 && FLAG:現Y == 5
		CALL MESSAGE_WINDOW_D, "", "＞スイッチがある"
		CALL INPUT_YN_D, "押す", "押さない"
		IF RESULT == 0
			CALL MESSAGE_WINDOW_D, "", "＞スイッチを押し込んだ"
			ダンジョンフラグ:(FLAG:現ダンジョン):5 = 1
		ENDIF
	ELSEIF FLAG:現M == 4 && FLAG:現X == 6 && FLAG:現Y == 8
		CALL MESSAGE_WINDOW_D, "", "＞スイッチがある"
		CALL INPUT_YN_D, "押す", "押さない"
		IF RESULT == 0
			CALL MESSAGE_WINDOW_D, "", "＞スイッチを押し込んだ"
			ダンジョンフラグ:(FLAG:現ダンジョン):6 = 1
		ENDIF
	ENDIF
	CALL MAKE_FLOOR, FLAG:現ダンジョン
	CALL AUTOMAP
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞何も無いようだ"
	RETURN 0
ENDIF
;=======================================================================
;エレベーター定義
;=======================================================================
@DUNGEON_ELEVATOR_11, ARG
VARSET RESULT, -1
VARSET RESULTS
RESULT:1 = 0
RESULT:2 = 1
RESULT:3 = 2
RESULTS:1 = 1F
RESULTS:2 = 2F
RESULTS:3 = 3F
RETURN -1
;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_11,ARG
;ARG = 進入時の向き　0の場合ワープなど
;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 3
	CALL TREASURE_11
	RETURN RESULT

;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 6
	CALL UPSTAIRS_11
	RETURN RESULT

ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 7
	CALL DOWNSTAIRS_11
	RETURN RESULT


ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 9
	CALL DUNGEON_TERMINAL
	RETURN 1
;========
;イベントの処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 4
	IF FLAG:現M == 4 && FLAG:現X == 17 && FLAG:現Y == 5
		CALL MESSAGE_WINDOW_D, "", "＞スイッチがある"
		CALL INPUT_YN_D, "押す", "押さない"
		IF RESULT == 0
			CALL MESSAGE_WINDOW_D, "", "＞スイッチを押し込んだ"
			ダンジョンフラグ:(FLAG:現ダンジョン):5 = 1
			CALL MAKE_FLOOR, FLAG:現ダンジョン
		ENDIF
	ELSEIF FLAG:現M == 4 && FLAG:現X == 6 && FLAG:現Y == 8
		CALL MESSAGE_WINDOW_D, "", "＞スイッチがある"
		CALL INPUT_YN_D, "押す", "押さない"
		IF RESULT == 0
			CALL MESSAGE_WINDOW_D, "", "＞スイッチを押し込んだ"
			ダンジョンフラグ:(FLAG:現ダンジョン):6 = 1
			CALL MAKE_FLOOR, FLAG:現ダンジョン
		ENDIF
	ELSEIF FLAG:現M == 4 && FLAG:現X == 9 && FLAG:現Y == 10
		CALL MESSAGE_WINDOW_D, "", "＞落とし穴だ！"
		CALL DUNGEON_WORP, 3, FLAG:現X, FLAG:現Y
	ELSEIF FLAG:現M == 5 && FLAG:現X == 3 && FLAG:現Y == 9
		CALL SHOW_PICTURE, "D"
		CALL MESSAGE_WINDOW_D, "", "＞そこには、SEBEC社社長神取 鷹久が酒を飲みながら胡坐をかいていた/＞ちびちびと手酌で酒を啜る姿はどこか虚ろな物を感じさせる"
		CALL MESSAGE_WINDOW_D, "神取", "……私を止めに来たのかね？/……安心したまえ/これ以上はせんよ、なにも、な……"
		CALL MESSAGE_WINDOW_D, "", @"＞神取は虚ろな微笑みさえ浮かべながら、人類への嫌悪と虚無感を口にする/＞その話の大半は、%CALLNAME:MASTER%には関心の持てない物であったが/＞ファントムのサマナーとして、己の力のみが問われる生き方をしている%CALLNAME:MASTER%には共感し得ない想いだったのかも知れない"
		CALL MESSAGE_WINDOW_D, "神取", "……ふむ、下郎と話すなど無意味な事であったか……/よかろう、ならば私は神として、裁きを下すまでだ"
		CALL MESSAGE_WINDOW_D, "", "＞超人 神取 鷹久が１体出た！"
		FLAG:逃走不可フラグ = 1
		FLAG:会話不能フラグ = 1
		FLAG:先制不意打ちキャンセル = 1
		CALL SET_ENEMY,9,4204,45,0,1
		CALL SYNC_STATUS,(CHARANUM-1)
		CALL HEALTH_CHARA,(CHARANUM-1)
