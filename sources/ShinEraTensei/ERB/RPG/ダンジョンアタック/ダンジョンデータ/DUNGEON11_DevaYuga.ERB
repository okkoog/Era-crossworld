;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_11
RESULTS = デヴァ・ユガ


;=======================================================================
;フロア名表示
;=======================================================================
@FLOORNAME_11
PRINT デヴァ・ユガ
SELECTCASE FLAG:現M
	CASE 0
		PRINTL   １Ｆ
	CASE 1
		PRINTL   ２Ｆ
	CASE 2
		PRINTL   ３Ｆ
	CASE 3
		PRINTL   ４Ｆ
	CASE 4
		PRINTL   ５Ｆ
	CASE 5
		PRINTL   ６Ｆ
	CASEELSE
		PRINTL
ENDSELECT


