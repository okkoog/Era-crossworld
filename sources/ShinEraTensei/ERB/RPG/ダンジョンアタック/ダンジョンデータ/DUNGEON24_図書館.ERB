			SIF RESULT == 0
				GOTO DECIDE_ACTION
			CFLAG:ARG:入力行動 = 401
			CALL RANDOM_TARGET,ARG,401
			RETURN 1
		;20％で夢見針
		CASE IS < 25
			CALL CHECK_ACTIONABLE,ARG,105
			SIF RESULT == 0
				GOTO DECIDE_ACTION
			CFLAG:ARG:入力行動 = 702
			CALL RANDOM_TARGET,ARG,702
			RETURN 1
		;30％でマハ･ラギ
		CASE IS < 55
			CALL CHECK_ACTIONABLE,ARG,704
			SIF RESULT == 0
				GOTO DECIDE_ACTION
			CFLAG:ARG:入力行動 = 704
			CALL RANDOM_TARGET,ARG,704
			RETURN 1
		CASE IS < 75
			;20％で子守唄
			CALL CHECK_ACTIONABLE,ARG,1223
			SIF RESULT == 0
				GOTO DECIDE_ACTION
			CFLAG:ARG:入力行動 = 1223
			CALL RANDOM_TARGET,ARG,1223
			RETURN 1
		CASE IS < 85
			;10％でマハラギ・オン
			IF ダンジョンフラグ:24:19 == 1
				CALL CHECK_ACTIONABLE,ARG,705
				SIF RESULT == 0
					GOTO DECIDE_ACTION
				CFLAG:ARG:入力行動 = 705
				CALL RANDOM_TARGET,ARG,705
				RETURN 1
			ELSE
				;ファイアブレス
				CALL CHECK_ACTIONABLE,ARG,708
				SIF RESULT == 0
					GOTO DECIDE_ACTION
				CFLAG:ARG:入力行動 = 708
				CALL RANDOM_TARGET,ARG,708
				RETURN 1
			ENDIF
		;15％で通常攻撃
		CASE IS < 100
			CALL CHECK_ACTIONABLE,ARG,0
			SIF RESULT == 0
				GOTO DECIDE_ACTION
			CFLAG:ARG:入力行動 = 0
			CALL RANDOM_TARGET,ARG,0
			RETURN 1
	ENDSELECT
ELSE
	$DECIDE_ACTION
	CALL SEARCH_ACT,ARG
	IF RESULT == 0
		CFLAG:ARG:入力行動 = -1
		CFLAG:ARG:防御フラグ = 1
		RETURN 0
	ENDIF
	LOCAL = RAND:RESULT
	;スキル番号決定
	LOCAL:1 = S:(10+LOCAL)
	$TARGET_LOOP
	
	CALL RANDOM_TARGET,ARG,LOCAL:1
	CALLFORM SKILL_TARGET_{LOCAL:1}
	;ここでスキル番号を行動内容に代入
	SIF CFLAG:ARG:ターゲット == -1
		GOTO DECIDE_ACTION
	CFLAG:ARG:入力行動 = LOCAL:1
ENDIF


