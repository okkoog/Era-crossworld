
;=======================================================================
;図書館
;
;ダンジョンフラグ:24:0 = 1.ボス
;ダンジョンフラグ:24:1 = 1.初回
;ダンジョンフラグ:24:2 = 1.メッセージ
;ダンジョンフラグ:24:3-11 = 1.本
;ダンジョンフラグ:24:12 = 本を読んだ回数
;ダンジョンフラグ:24:13 = 1.白伏見
;ダンジョンフラグ:24:14 = 1.どうでもいい
;ダンジョンフラグ:24:15 = 1.ヤス
;ダンジョンフラグ:24:16 = 1.白鐘
;ダンジョンフラグ:24:17 = 1.異界へ
;ダンジョンフラグ:24:18 = 1.ガキ
;ダンジョンフラグ:24:19 = 1.BOSS強さ
;ダンジョンフラグ:24:30-31 = 1.アイテム

;ダンジョンナンバー24
;=======================================================================

;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_24
;初台シェルタークリア & ボス撃破前
SIF ダンジョンフラグ:34:8 == 1 && !ダンジョンフラグ:24:0
	RETURN 1
RETURN 0

;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_24
RESULTS = 図書館


;=======================================================================
;フロア名表示
;=======================================================================
@FLOORNAME_24
PRINT 図書館
SELECTCASE FLAG:現M
	CASE 0
		PRINTL   Ｂ１Ｆ
	CASE 1, 6
		PRINTL   １Ｆ
	CASE 2
		PRINTL   ２Ｆ
	CASE 3
		PRINTL   ３Ｆ
	CASE 4
		PRINTL   ４Ｆ
	CASEELSE
		PRINTL
ENDSELECT


;=======================================================================
;特殊タイル表示
;=======================================================================
;@TILE_MARK_24_4_4_6
;IF ダンジョンフラグ:24:17 == 1
;	RESULTS = 記
;ELSE
;	RESULTS = ！
;ENDIF
;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_24,ARG
;IF ダンジョンフラグ:24:0 == 0 || ダンジョンフラグ:24:17 == 1
	FLAG:現M = 1
	FLAG:現X = 3
	FLAG:現Y = 6
;ELSEIF ダンジョンフラグ:24:0 == 1 && ダンジョンフラグ:24:17 == 0
;	FLAG:現M = 6
;	FLAG:現X = 1
;	FLAG:現Y = 4
;ENDIF
;CALL AUTOMAP

;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_24
IF ダンジョンフラグ:24:1 == 0
	CALL SHOW_PICTURE, "NONFLOORD"
	CALL MESSAGE_WINDOW_D, "", @"＞異界化した図書館の調査依頼を%CALLNAME:MASTER%は受けた/＞原因を早急に究明し元の図書館に戻さねばなるまい%\@BASE:MASTER:LV < 10?/＞マヨーネは簡単な依頼だと言っていたが油断は出来ない#\@%"
	ダンジョンフラグ:24:1 = 1
ENDIF

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_24,ARG,ARG:1
IF DA:ARG:(ARG:1) == 12
	IF ダンジョンフラグ:24:12 >= 9
		CALL MESSAGE_WINDOW_D, "", "＞扉の向こうから邪気を感じる/＞扉を開けるか？"
		CALL INPUT_YN_D
		SIF RESULT == 1
			RETURN 0
	ELSE
		CALL MESSAGE_WINDOW_D, "", "＞扉は謎の力で閉ざされている"
		RETURN 0
	ENDIF
ELSEIF DA:ARG:(ARG:1) == 22 && ダンジョンフラグ:24:12 >= 9
	CALL MESSAGE_WINDOW_D, "", "＞扉は謎の力で閉ざされている"
	RETURN 0
ENDIF
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

