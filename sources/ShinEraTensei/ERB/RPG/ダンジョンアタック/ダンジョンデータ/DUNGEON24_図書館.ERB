		CALL MAKE_FLOOR_LINE, 2," 1  2  "
		CALL MAKE_FLOOR_LINE, 3," 1 A1A "
		CALL MAKE_FLOOR_LINE, 4," 1 A1A"
		CALL MAKE_FLOOR_LINE, 5," 1  G  "
