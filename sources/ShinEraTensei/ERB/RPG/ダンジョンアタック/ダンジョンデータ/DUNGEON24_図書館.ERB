		CALL MESSAGE_WINDOW_D, "", @"＞牛車に実体の薄い緑色の上体が繋がっている女悪魔は/＞%CALLNAME:MASTER%の方に振り向いた"
		IF IS_LOOKSLIKE_MALE(MASTER)
			CALL MESSAGE_WINDOW_D, "鬼女 フグルマ", "ほう……/おぬしはよく見れば中々の美丈夫/ホホホホホホホホ/おぬしが息絶えるまでわらわが生体マグネタイトを搾りとってやろうぞ"
		ELSE
			CALL MESSAGE_WINDOW_D, "鬼女 フグルマ", "ホホホホホホホホ/おぬしも、わらわを退治しようなど、/考えるだけ無駄なことぞえ"
		ENDIF
