		CALL MAKE_FLOOR_LINE, 5," 1 1111  1 "
		CALL MAKE_FLOOR_LINE, 6," 1    1  1 "
		CALL MAKE_FLOOR_LINE, 7," 2    1  1 "
		CALL MAKE_FLOOR_LINE, 8," E    1  1 "
		CALL MAKE_FLOOR_LINE, 9,"      1111 "
		CALL MAKE_FLOOR_LINE,10,"           "
							    ;01234567890
