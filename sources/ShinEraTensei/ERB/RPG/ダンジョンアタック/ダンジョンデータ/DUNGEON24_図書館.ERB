			CALL MESSAGE_WINDOW_D, "", "＞妖鬼 オニが２体現われた！/＞鬼女 フグルマが１体現れた！"
		ELSE
			CALL MESSAGE_WINDOW_D, "", "＞鬼女 フグルマが１体現れた！"
		ENDIF
		FLAG:逃走不可フラグ = 1
		FLAG:会話不能フラグ = 1
		FLAG:先制不意打ちキャンセル = 1
		IF FLAG:戦闘難易度 >= 3 && FLAG:周回回数 >= 1 && BASE:MASTER:LV >= 21
			ダンジョンフラグ:24:19 = 1
			;オニ
			CALL SET_ENEMY,8,[[キャラ:オニ]],20,0,1
