;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_24
;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 3
	CALL TRESURING_CALLING_24
	RETURN 1
;==========
;イベントの処理
;==========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 4
	CALL EVENTING_CALLING_24
	RETURN 1
;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 6
	CALL DUNGEON_UPSTAIRS_ID, FLAG:現M+1, 7
	RETURN 1

ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 7
	CALL DUNGEON_UPSTAIRS_ID, FLAG:現M-1, 6
	RETURN 1
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 9
	CALL MESSAGE_WINDOW_D, "", "＞何も無いようだ"
	RETURN 0
ENDIF

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_24,ARG
;ARG = 進入時の向き　0の場合ワープなど
IF DA:(FLAG:現X):(FLAG:現Y) == 11
	CALL MESSAGE_WINDOW_D, "", "＞突然、何処からともなく声が響いた"
	CALL MESSAGE_WINDOW_D, "声", "ホホホホホホホホホホ/異界となった、わらわの館へようこそ"
	ダンジョンフラグ:24:2 = 1
	CALL CLEAR_TILE
;==========
;出口の処理
;==========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 3
	CALL TRESURING_CALLING_24
	RETURN 1
;==========
;イベントの処理
;==========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 4
	CALL EVENTING_CALLING_24
	RETURN 1
;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 6
	CALL DUNGEON_UPSTAIRS_ID, FLAG:現M+1, 7
	RETURN 1
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 7
	CALL DUNGEON_UPSTAIRS_ID, FLAG:現M-1, 6
	RETURN 1
;==========
;扉の処理
;==========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 2
	CALL DUNGEON_DOOR,ARG
	RETURN 1

ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 9
	RETURN 0
ENDIF
RETURN 0


;=======================================================================
;エンカウント率
;=======================================================================
@ENCOUNT_RATE_24
IF FLAG:現M < 4
	FLAG:エンカウント率 =( FLAG:未遭遇歩数 - 5) * 5
ELSEIF FLAG:現M == 4
	FLAG:エンカウント率 = (FLAG:未遭遇歩数 * 7 - 5) + 10
ELSE
	FLAG:エンカウント率 = 0
ENDIF

;=======================================================================
;必要レベル目安
;推奨LV 雑魚最低LV 雑魚最高LV ボスLV 
;=======================================================================
@GET_DUNGEON_LV_24
RETURN 7, 4, 14, 22

;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_24
IF RAND:100 < FLAG:エンカウント率
	CALL ENEMY_TABLE
	RETURN 1
ELSE
	FLAG:未遭遇歩数 += 1
	RETURN 0
ENDIF
