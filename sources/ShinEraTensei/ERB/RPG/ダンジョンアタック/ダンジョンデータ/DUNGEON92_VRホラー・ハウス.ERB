;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_92

;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
;% 10は10で割ったあまり、つまり下一桁がでてきます
;そして、下一桁はタイルの種類を表す
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 3
	CALL TREASURE_1
	RETURN RESULT
;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 6
	CALL UPSTAIRS_1
	RETURN RESULT

ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 7
	CALL DOWNSTAIRS_1
	RETURN RESULT

ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 9
	SELECTCASE DA:(FLAG:現X):(FLAG:現Y) / 10
		CASE 1
			PRINTW ＞石版状の墓がある……　どうしますか？
			PRINTL [0]話しかける
			PRINTL [1]けってみる
			PRINTL [2]何もしない
			
			$INPUT_LOOP1
			INPUT

			IF RESULT == 0
				PRINTW 墓が語りかけてきた。
				PRINTL 『おへやにライトは２つあるある。１つはあっちで、１つはそっち。
				PRINTW 　くわしいはなしは、じゅうじかで……』
			ELSEIF RESULT == 1
				PRINTW 墓から巨大な石の脚が生えて蹴り返された！
				CALL DUNGEON_TRAP_HP,20
			ELSEIF RESULT == 2
				PRINTFORMW %CALLNAME:MASTER%はそっとその場から離れた。
			ELSE
				GOTO INPUT_LOOP1
			ENDIF

		CASE 2
			PRINTW ＞十字架がある……　どうしますか？
			PRINTL [0]話しかける
			PRINTL [1]石を投げる
			PRINTL [2]何もしない
			
			$INPUT_LOOP2
			INPUT

			IF RESULT == 0
				PRINTW 十字架が語りかけてきた。
				PRINTL 『「記憶の部屋」の天井にはライトが２つある。
				PRINTL 　１つは魂の眠る所……
				PRINTW 　そしてもう１つは、そこへ誘う所……』
			ELSEIF RESULT == 1
				PRINTW 十字架の後ろから石つぶてが雨あられと飛んできた！
				CALL DUNGEON_TRAP_HP,20
			ELSEIF RESULT == 2
