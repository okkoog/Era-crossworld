							IF RESULT
								CFLAG:(RESULT:1):戦闘参加不可能 = 1
							ENDIF
							CALL ADD_NEW_COMPANION, 1012, 0, 1
							IF RESULT
								CFLAG:(RESULT:1):戦闘参加不可能 = 1
							ENDIF
						ELSE
							GOTO INPUT_LOOP12
						ENDIF
					ELSE
						PRINTW エリカが倒れると同時にシンゴを覆っていた氷が砕け散った。
						PRINTL エリカ
						PRINTL 「ゴメン………でも……にまも……からぁ……
						PRINTW 　……なたた…わた…さない……！！」
						PRINTW だがエリカがそうつぶやいた瞬間シンゴの姿は忽然と消えた。
						PRINTW おそらくエリカが最後の力を振り絞ってパラダイムＸから元の場所に戻したのだろう。
						PRINTW 守ろうとして力を使い果たしたのか、エリカは消滅しかけている……
						PRINTL [0]ほおって置く
						PRINTL [1]エリカを捕まえる
						
						$INPUT_LOOP13
						INPUT

						IF RESULT == 0
							PRINTW 止めをさす必要は無いしこれで依頼は完了したと見て良さそうだ。
							PRINTFORMW 最後まで弟のことを思った悪魔の消滅を、%CALLNAME:MASTER%は見届けた。
						ELSEIF RESULT == 1
							PRINTW 端正な顔立ちをしているし、実力のほうも先ほどの戦いで折り紙つきだ。
							PRINTL 言うことを聞かせるまでが苦労するだろうがその分の価値はあるだろう。
							CALL ADD_NEW_COMPANION, 1012, 0, 1
							IF RESULT
								CFLAG:(RESULT:1):戦闘参加不可能 = 1
							ENDIF
						ELSE
							GOTO INPUT_LOOP13
						ENDIF
					ENDIF
					PRINTW 報酬として口座に￥50000が支払われた
					CUSTOMDRAWLINE =
					MONEY += 50000
					ダンジョンフラグ:92:0 = 2
					DA:(FLAG:現X):(FLAG:現Y) = 1
					FLAG:脱出 = 1
					RETURN 1
				ELSE
					FLAG:現Y = 3
				ENDIF
			ELSE
				PRINTW 鍵がかかっていて開かない。
				FLAG:現Y = 3
			ENDIF
	CASEELSE
		CALL DUNGEON_TERMINAL
	RETURN 1
	ENDSELECT
ELSEIF DA:(FLAG:現X):(FLAG:現Y) %10 == 9
	SELECTCASE DA:(FLAG:現X):(FLAG:現Y) /10
		CASE 0
			CALL DUNGEON_TERMINAL
			RETURN 1
	ENDSELECT
ENDIF
RETURN 0





