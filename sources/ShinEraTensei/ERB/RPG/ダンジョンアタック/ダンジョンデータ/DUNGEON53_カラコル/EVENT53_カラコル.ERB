;=======================================================================
;ダンジョン突入時のイベント
;=======================================================================
@START_DUNGEON_53, ARG
IF !STRFLAG_D("初回", 1)
	PRINTW ＞銃声が聞こえる
	PRINTL ＞本当にラスト・バタリオンの兵士が来ており、
	PRINTW ＞なにものかと交戦しているようだ
	PRINTW ＞カラコルの入り口を探そう
ENDIF
FLAG:現M = 0
FLAG:現X = 2
FLAG:現Y = 10
;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_53
SELECTCASE DA:(FLAG:現X):(FLAG:現Y)% 10
	;========
	;宝の処理
	;========
	CASE 3
		CALL TREASURE_53
		RETURN 1
	;========================
	;イベント
	;========================
	CASE 4
		CALL EVENT_53
		RETURN 1
	;=======
	;ワープゾーン
	;=======
	CASE 6,7
		CALL WORP_53
		RETURN 1
	;=======
	;メッセンジャー
	;=======
	CASE 8
		CALL MESSAGE_53, 0
		RETURN 1
	;=======
	;特殊タイル
	;=======
	CASE 9
		CALL SPECIAL_53
		RETURN 1
	;=======
	;ダークゾーン
	;=======
	CASE -1
		IF DA:(FLAG:現X):(FLAG:現Y) < -10
			CALL DARK_53
			RETURN 1
		ENDIF
	CASEELSE
	PRINTW 何も無いようだ
	RETURN 0
ENDSELECT
;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_53,ARG
;ARG = 進入時の向き　0の場合ワープなど
SELECTCASE DA:(FLAG:現X):(FLAG:現Y) % 10
	;==========
	;扉の処理
	;==========
	CASE 2
		CALL DUNGEON_DOOR,ARG
		RETURN 1
;========
;宝の処理
;========
	CASE 3
		CALL TREASURE_53
		RETURN 1
;========================
;イベント
;========================
	CASE 4
		CALL EVENT_53, 1
		RETURN 0
;=======
;ワープゾーン
;=======
	CASE 6,7
		CALL WORP_53
		RETURN 1
;=======
;メッセンジャー
;=======
	CASE 8
		CALL MESSAGE_53, 1
		RETURN 1
;=======
;特殊タイル
;=======
	CASE 9
		CALL SPECIAL_53
		RETURN 1
;=======
;ダークゾーン
;=======
	CASE -1
		CALL DARK_53, 1
		RETURN 1
ENDSELECT
;=======
;主に扉
;=======
;扉のタイル表示
@TILE_MARK_COMMON_53_2, ARG, ARG:1, ARG:2
SELECTCASE ARG / 10
	CASEELSE
		RESULTS = 扉
ENDSELECT
@CAN_ENTER_53, ARG, ARG:1
SELECTCASE DA:ARG:(ARG:1)
	CASE 9012
		IF !STRFLAG_D("ジョーカー撃破")
			PRINTW ＞中から激しい物音がする
			PRINTW ＞部屋の中にはいりますか？
			CALL INPUT_YN
			SIF RESULT == 1
				RETURN 0
		ENDIF
	CASE 12012
		IF !STRFLAG_D("M12ドアオープン")
			IF ARG:1 > FLAG:現Y
				PRINTW ＞扉は開かない。
				PRINTW ＞反対側から鍵が掛かっているようだ。
				RETURN 0
			ELSE
				PRINTW ＞扉の鍵を開けた。
				CALLF STRFLAG_D("M12ドアオープン", 1)
			ENDIF
		ENDIF
	CASE 12022
		IF !STRFLAG_D("聖槍騎士団撃破")
			PRINTW ＞中に誰かいるようだ
			PRINTW ＞部屋の中にはいりますか？
			CALL INPUT_YN
			SIF RESULT == 1
				RETURN 0
		ENDIF
	CASE 15012
		IF !STRFLAG_D("M15ドアオープン")
			IF ARG:1 > FLAG:現Y
				PRINTW ＞扉は開かない。
				PRINTW ＞反対側から鍵が掛かっているようだ。
				RETURN 0
			ELSE
				PRINTW ＞扉の鍵を開けた。
				CALLF STRFLAG_D("M15ドアオープン", 1)
			ENDIF
		ENDIF
	CASE 18012
		IF !STRFLAG_D("カラコルクリア")
			PRINTW ＞ここが最深部のようだ
			PRINTW ＞部屋の中にはいりますか？
			CALL INPUT_YN
			SIF RESULT == 1
				RETURN 0
		ENDIF
ENDSELECT
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

@TILE_MARK_COMMON_53_9, ARG, ARG:1, ARG:2
SELECTCASE ARG / 10
	CASE 98
		RESULTS = Ｃ
	CASE 99
		RESULTS = 出
ENDSELECT

@SPECIAL_53
SELECTCASE DA:(FLAG:現X):(FLAG:現Y) / 10
	;ケーブルカー
	CASE 98
		PRINTW ＞ケーブルカーがある
		IF FLAG:現M == 8 && !STRFLAG_D("ケーブルカー起動", 1)
			PRINTW ＞あたりを探すと電源があったので起動させた
			PRINTW ＞これで以降はケーブルカーを使える
		ENDIF
		IF !STRFLAG_D("ケーブルカー起動")
			PRINTW ＞しかし、電源が供給されておらず、動かない
		ELSE
			PRINTL ＞ケーブルカーに乗りますか？
			CALL INPUT_YN
			SIF RESULT == 0
				CALL DUNGEON_WORP_ID, ABS(FLAG:現M - 8), 989, 1
		ENDIF
	;出口
	CASE 99
		CALL DUNGEON_EXIT
ENDSELECT
;=======
;ELEVATOR定義
;=======
@DUNGEON_ELEVATOR_53, ARG
RETURN 9, 12, 15
@EVENT_53, ARG
SELECTCASE DA:(FLAG:現X):(FLAG:現Y) / 10
	CASE 0
		PRINTW ＞ラスト・バタリオンの兵士たちがいる。
		PRINTW ＞そして、彼らの足元に仮面党員達が倒れている…
