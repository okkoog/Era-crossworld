@EVENT_CHECK_DUNGEON_12
;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;イベントの処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 4
	SELECTCASE FLAG:現M
		CASE 2
			IF FLAG:現X == 3 && FLAG:現Y == 1
			;マイの部屋
				CALL MESSAGE_WINDOW_D, "", "＞お菓子の家がある……"
			ELSEIF FLAG:現X == 7 && FLAG:現Y == 4
			;マキの引きこもってる部屋
			ENDIF
	ENDSELECT
	RETURN 1
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞何も無いようだ"
	RETURN 1
ENDIF

