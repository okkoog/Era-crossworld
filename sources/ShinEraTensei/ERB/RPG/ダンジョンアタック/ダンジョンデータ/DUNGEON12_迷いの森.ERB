					CALL MESSAGE_WINDOW_D, "", "＞そういって嘲笑う少女の姿がゆっくりと異形のものへと変わってゆく……/＞業魔　アラガンスが一体出た！"
					FLAG:逃走不可フラグ = 1
					FLAG:会話不能フラグ = 1
					FLAG:先制不意打ちキャンセル = 1
					CALL SET_ENEMY,9,1025,55,0,0
					CALL BATTLE_START
					CALL SHOW_PICTURE, "D"
					CALL MESSAGE_WINDOW_D, "業魔 アラガンス", "くく……うふふ……ふ……"
					CALL MESSAGE_WINDOW_D, "", "＞最後まで嘲笑を消さないまま、異形の魔物は力尽きた"
					FLAG:逃走不可フラグ = 0
					FLAG:会話不能フラグ = 0
					FLAG:先制不意打ちキャンセル = 0
					CALL MESSAGE_WINDOW_D, "", "＞それをぼうっと見ていたエリーは、小さな声で呟いた"
					CALL MESSAGE_WINDOW_D, "エリー", "そう、その通りかも……/＞期待されてそれに応える、それはいやな事ではなかったし……/……もし、ありのままに振舞ったら、貴方はどう思うのかしら"
					CALL MESSAGE_WINDOW_D, "エリー", "(そして、この人が隠している物を見たら、私は？)"
					;依存度が忠誠度基準で上昇
					CFLAG:LOCAL:依存度 = MAX(CFLAG:LOCAL:依存度, BASE:LOCAL:忠誠度 / 4)
					ダンジョンフラグ:12:2 = 1
				ENDIF
			ELSEIF FLAG:現X == 6 && FLAG:現Y == 1
				IF ダンジョンフラグ:10:10 == 1 && FINDCHARA_B(4515,0) == 2 &&  CFLAG:(RESULT:1):201 == 0
					LOCAL = RESULT:1
					;アヤセ和解ルートで仲間入りさせ、かつパーティに入っていて、しかもまだ調教した事が無い
					CALL MESSAGE_WINDOW_D, "", "＞アヤセと全く同じ姿をした少女が立っている……"
					CALL MESSAGE_WINDOW_D, "アヤセ", "アレ……あたし？/＞……に、偽物ぉ！？"
					CALL MESSAGE_WINDOW_D, "アヤセ？", "……なんで、アヤセこんなとこに居んの～/別に良いじゃん、ほっとけば/アヤセに関係ないよね"
					CALL MESSAGE_WINDOW_D, "アヤセ？", "痛いのもしんどいのも嫌いだしぃ～/今だけ良ければ良いよね？/……そんなんじゃダメだって言われてもぉ/難しい事分からない！ 考えたくない！！"
					FLAG:逃走不可フラグ = 1
					FLAG:会話不能フラグ = 1
					FLAG:先制不意打ちキャンセル = 1
					CALL MESSAGE_WINDOW_D, "", "＞そういって嘲笑う少女の姿がゆっくりと異形のものへと変わってゆく……/＞業魔　オブスィーンが一体出た！"
					CALL SET_ENEMY,9,1020,45,0,0
					CALL BATTLE_START
					CALL SHOW_PICTURE, "D"
					CALL MESSAGE_WINDOW_D, "業魔 オブスィーン", "くく……ふふ……はは……"
					CALL MESSAGE_WINDOW_D, "", "＞最後まで嘲笑を消さないまま、異形の魔物は力尽きた"
					FLAG:逃走不可フラグ = 0
					FLAG:会話不能フラグ = 0
					FLAG:先制不意打ちキャンセル = 0
					CALL MESSAGE_WINDOW_D, "", "＞その様子をぼうっと見ていたアヤセは、小声で呟いた"
					CALL MESSAGE_WINDOW_D, "アヤセ", "……アヤセだって先の事くらい考えてるよ/そりゃ、こんな調子じゃ上手く行くかどうか分かんないけど……"
					IF TALENT:MASTER:140 == 1
						CALL MESSAGE_WINDOW_D, "アヤセ", "手近に候補が居なくもないよね……"
						CALL MESSAGE_WINDOW_D, "", "＞アヤセは何故かちらっとこちらを見た"
						PRINTFORMW 。
					ENDIF
					CFLAG:LOCAL:依存度 = MAX(CFLAG:LOCAL:依存度, BASE:LOCAL:忠誠度 / 4)
				ENDIF
			ENDIF
	ENDSELECT
	
	CALL MAKE_FLOOR, FLAG:現ダンジョン
	CALL AUTOMAP
	
	RETURN 1
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 9
	SELECTCASE FLAG:現M
		CASE 0
			IF FLAG:現X == 18
				FLAG:現M = 1
				FLAG:現X = 0
			ELSE
				FLAG:現M = 2
				FLAG:現Y = 0
			ENDIF
		CASE 1
			IF FLAG:現X == 0
				FLAG:現M = 0
				FLAG:現X = 18
			ENDIF
		CASE 2
			IF FLAG:現Y == 0
				FLAG:現M = 0
				FLAG:現Y = 18
			ELSE
				FLAG:現M = 1
				FLAG:現Y = 15
			ENDIF
		CASE 3
			IF FLAG:現X == 0
				FLAG:現M = 2
				FLAG:現X = 15
			ELSE
				FLAG:現M = 0
				FLAG:現Y = 15
			ENDIF
	ENDSELECT
		
	CALL MAKE_FLOOR, FLAG:現ダンジョン
	CALL AUTOMAP
	
	

;==========
;扉の処理
;==========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 2
	CALL DUNGEON_DOOR,ARG
	RETURN 1
ENDIF
RETURN 0


