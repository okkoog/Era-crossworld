;=======================================================================
;エンカウント率
;=======================================================================
@ENCOUNT_RATE_41
SELECTCASE FLAG:現M
	CASE 0
		FLAG:エンカウント率 = FLAG:未遭遇歩数*5
	CASE 1
		FLAG:エンカウント率 = 10 + FLAG:未遭遇歩数*5
	CASE 2
		FLAG:エンカウント率 = 20 + FLAG:未遭遇歩数*5
	CASEELSE
		FLAG:エンカウント率 = FLAG:未遭遇歩数*5
ENDSELECT

;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_41
IF RAND:100 < FLAG:エンカウント率
	CALL ENEMY_TABLE
	RETURN 1
ELSE
	FLAG:未遭遇歩数 += 1
	RETURN 0
ENDIF
