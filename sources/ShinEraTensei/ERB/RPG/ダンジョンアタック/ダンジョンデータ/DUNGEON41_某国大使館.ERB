
;=======================================================================
;某国大使館
;ボス・マヨーネ様
;ボス・天使パワー
;ダンジョンナンバー41　ＭＡＰ0~2
;突貫工事の為エラー出たらごめんなさい
;=======================================================================




;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_41
;マヨーネ様の依頼を受けている
IF (イベントフラグ:8:0 & 2)
	RETURN 1
;暫定処理
ELSEIF イベントフラグ:1:0 == 3
	RETURN 1
ELSE
	RETURN 0
ENDIF



;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_41
RESULTS = アメリカ大使館


;=======================================================================
;フロア名表示
;=======================================================================
@FLOORNAME_41
PRINT アメリカ大使館
SELECTCASE FLAG:現M
	CASE 0
		PRINTL 四ツ谷地下道
	CASE 1
		PRINTL １Ｆ
	CASE 2
		PRINTL ２Ｆ
		
	CASEELSE
		PRINTL
ENDSELECT


;=======================================================================
;特殊タイル表示
;=======================================================================
@TILE_MARK_2_1_1
RESULTS = Ｔ


;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_41,ARG
FLAG:現M = 0
FLAG:現X = 11
FLAG:現Y = 3
;CALL AUTOMAP


;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_41,ARG,ARG:1
;警備兵
;IF FLAG:現M == 0 && ARG == 4（現X） && ARG:1 == 2 （現Y） && ダンジョンフラグ:41:2 == 0（イベント見てない）
IF FLAG:現M == 0 && ARG == 4 && ARG:1 == 1 && ダンジョンフラグ:41:2 == 0
	;主人公のLv20以上なら通れる
	IF BASE:MASTER:LV >= 20
		;マヨーネＧＥＴ済み
		IF イベントフラグ:1:0 == 3
			PRINTFORML 「トマレ、トマレナサーイ!!」
			PRINTFORMW 「トールマン大使ハ不在デース」
			;マヨーネ陥落済みでＰＴにいる
			IF FINDCHARA_B(4516,0) == 2
				PRINTFORML 「大使のご不在は知っていますわ」
				PRINTFORML 「ところでお伺いしますけど、ココに悪魔召喚プログラムのサーバーがありませんこと？」
				PRINTFORMW 不意にマヨーネが警備兵に問いかけた。
				;信用されてないあなた可哀そす
				PRINTFORMW %CALLNAME:MASTER%は大使館内偵依頼の真の目的を知った…
				PRINTL 「貴様等…ただの民間人ではないな、生かして帰さぬ！！」
				PRINTW 天使 アークエンジェルが1体出た！
				CUSTOMDRAWLINE =
				WAIT
				FLAG:逃走不可フラグ = 1
				FLAG:会話不能フラグ = 1
				FLAG:先制不意打ちキャンセル = 1
				;アークエンジェル
				CALL SET_ENEMY,9,[[キャラ:アークエンジェル]],24,0,0
				CFLAG:(CHARANUM-1):ＨＰ補正 += 300
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				CALL BATTLE_START
				FLAG:逃走不可フラグ = 0
				FLAG:会話不能フラグ = 0
				FLAG:先制不意打ちキャンセル = 0
				CUSTOMDRAWLINE =

				PRINTL
				PRINTFORMW 「あらあら…答える前に死んでしまいましたね」
				PRINTFORMW 「まあ、こんな下っ端が知るはずもないですわね」
				PRINTFORMW 「急ぎましょうか、ご主人様」
				ダンジョンフラグ:41:2 = 1
				RETURN 1
			ELSE
				PRINTFORML 「オーＩＤカードヲ持ッテイマスネー」
				PRINTFORMW 「通ッテヨカデスヨー」
				PRINTFORMW この大使館は天使達の巣窟であるとマヨーネから助言を得ている。
				PRINTFORMW 目的はこの大使館にあると目される召喚サーバーの有無の確認。
				PRINTFORMW ひとまずは無駄な争いを避けれた事を喜ばねばなるまい。
				RETURN 1
				ダンジョンフラグ:41:2 = 1
			ENDIF
		;マヨーネ未入手
		ELSE
			PRINTFORMW 血まみれになった天使が床に伏せている…
			PRINTFORMW 「神を恐れぬ愚かな人間め…天罰を受けるがいい」
			PRINTFORMW 天使は憎々しげにあなたを睨み、あなたの目の前で消滅した。
			ダンジョンフラグ:41:2 = 1
			RETURN 1
		ENDIF
	ELSE
		PRINTFORMW 「トマレ、トマレナサーイ!!」
		PRINTFORMW 「トールマン大使ハ不在デース」
		PRINTFORMW 「大使ニ会イタイナラ池袋ニ行キヤガルヨロシイ」
		RETURN 0
	ENDIF
ENDIF
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT
;=======================================================================
;フロアデータ
;=======================================================================
@MAKE_FLOOR_41
SELECTCASE FLAG:現M
	CASE 0
	;四ツ谷地下道
		FLAG:最大X = 15 
		FLAG:最大Y = 5 
;								 012345678901234
		CALL MAKE_FLOOR_LINE, 0,"               "
		CALL MAKE_FLOOR_LINE, 1," 11111   11111 "
		CALL MAKE_FLOOR_LINE, 2," 1   11111   1 "
		CALL MAKE_FLOOR_LINE, 3," 126       821 "
		CALL MAKE_FLOOR_LINE, 4,"               "
		
		;CALL SET_TILE,4,1,ダンジョンフラグ:41:2,0,4

	CASE 1
	;１階
		FLAG:最大X = 15 
		FLAG:最大Y = 9 
;								 012345678901234
		CALL MAKE_FLOOR_LINE, 0,"               "
		CALL MAKE_FLOOR_LINE, 1," 1211 1 1121 1 "
		CALL MAKE_FLOOR_LINE, 2,"    2 1 2    1 "
		CALL MAKE_FLOOR_LINE, 3," 1111111111111 "
		CALL MAKE_FLOOR_LINE, 4," 2    1    2 1 "
		CALL MAKE_FLOOR_LINE, 5," 1121 1 1211 1 "
		CALL MAKE_FLOOR_LINE, 6,"      1      1 "
		CALL MAKE_FLOOR_LINE, 7," 11111126 7211 "
		CALL MAKE_FLOOR_LINE, 8,"               "

		;宝箱の設置
		;X8,Y5，DB40:10 == 0の時宝箱が取れる
		CALL SET_TILE,8,5,ダンジョンフラグ:40:10,0,3
		;X1,Y1，DB40:11 == 0の時宝箱が取れる
		CALL SET_TILE,1,1,ダンジョンフラグ:40:11,0,3

		CALL SET_TILE,6,3,ダンジョンフラグ:41:3,0,4

	CASE 2
	;２階
		FLAG:最大X = 9 
		FLAG:最大Y = 9 
;								 012345678
		CALL MAKE_FLOOR_LINE, 0,"         "
		CALL MAKE_FLOOR_LINE, 1," 1211111 "
		CALL MAKE_FLOOR_LINE, 2,"       1 "
		CALL MAKE_FLOOR_LINE, 3," 11111 1 "
		CALL MAKE_FLOOR_LINE, 4," 2 1 2 1 "
		CALL MAKE_FLOOR_LINE, 5," 1 1 1 1 "
		CALL MAKE_FLOOR_LINE, 6,"   1   1 "
		CALL MAKE_FLOOR_LINE, 7," 7211111 "
		CALL MAKE_FLOOR_LINE, 8,"         "

		CALL SET_TILE,1,1,ダンジョンフラグ:41:1,0,4
		CALL SET_TILE,1,1,ダンジョンフラグ:41:1,1,-9

	CASEELSE
ENDSELECT


;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_41

;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 3
	SELECTCASE FLAG:現M
		;地下一階
		CASE 0
		;一階
		CASE 1
			;X8 && Y5座標の宝箱
			IF FLAG:現X == 8 && FLAG:現Y == 5
				;ボスを倒していない
				IF ダンジョンフラグ:41:1 == 0
					;1005,メディカルパウダー,15,味方全員のHPを50回復する薬品
					CALL GET_TREASURE,1005,1,FLAG:現ダンジョン,10
				;ボスを倒している
				ELSE
					;79,黄色のキャンディ,20000,;妊娠中に使うと産卵し、妊娠を失う。妊娠キャンセルが可能だが、ハイリスク,
					CALL GET_TREASURE,79,1,FLAG:現ダンジョン,12
				ENDIF
			;X1 && Y1座標の宝箱
			ELSEIF FLAG:現X == 1 && FLAG:現Y == 1
				;ボスを倒していない
				IF ダンジョンフラグ:41:1 == 0
					;1001,傷薬,50,;HPを30回復する薬品
					CALL GET_TREASURE,1001,2,FLAG:現ダンジョン,11
				;ボスを倒している
				ELSE
					;1008,道返玉,3000,リカーム
					CALL GET_TREASURE,1008,2,FLAG:現ダンジョン,13
				ENDIF
			ENDIF
		;二階
		CASE 2
	ENDSELECT
	RETURN 1

;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 6
	SELECTCASE FLAG:現M
		;地下一階の6を調べた
		CASE 0
			;地下一階　6の座標を指定　X3/Y3
			SIF FLAG:現X == 3 && FLAG:現Y == 3
				;一階　7の座標に移動　X10/Y7
				CALL DUNGEON_UPSTAIRS,1,10,7
		;一階の6を調べた
		CASE 1
			;一階　6の座標を指定
			SIF FLAG:現X == 8 && FLAG:現Y == 7
				;ニ階　7の座標に移動
				CALL DUNGEON_UPSTAIRS,2,1,7
	ENDSELECT
	RETURN 1
	
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 7
	SELECTCASE FLAG:現M
		;上記昇り階段の数値を入れ替える
		;一階の7を調べた
		CASE 1
			;一階　MAP7の座標を指定
			SIF FLAG:現X == 10 && FLAG:現Y == 7
				;地下一階　6の座標に移動
				CALL DUNGEON_DOWNSTAIRS,0,3,3
		;二階の7を調べた
		CASE 2
			;ニ階　MAP7の座標を指定
			SIF FLAG:現X == 1 && FLAG:現Y == 7
				;一階　MAP6の座標に移動
				CALL DUNGEON_DOWNSTAIRS,1,8,7
	ENDSELECT
	RETURN 1

ELSE
	PRINTW 何も無いようだ
	RETURN 0
ENDIF


;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_41,ARG
;ARG = 進入時の向き　0の場合ワープなど
;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) % 10 == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 3
	SELECTCASE FLAG:現M
		;地下一階
		CASE 0
		;一階
		CASE 1
			;X8 && Y5座標の宝箱
			IF FLAG:現X == 8 && FLAG:現Y == 5
				;ボスを倒していない
				IF ダンジョンフラグ:41:1 == 0
					;1005,メディカルパウダー,15,味方全員のHPを50回復する薬品
					CALL GET_TREASURE,1005,1,FLAG:現ダンジョン,10
				;ボスを倒している
				ELSE
					;79,黄色のキャンディ,20000,;妊娠中に使うと産卵し、妊娠を失う。妊娠キャンセルが可能だが、ハイリスク,
					CALL GET_TREASURE,79,1,FLAG:現ダンジョン,10
				ENDIF
			;X1 && Y1座標の宝箱
			ELSEIF FLAG:現X == 1 && FLAG:現Y == 1
				;ボスを倒していない
				IF ダンジョンフラグ:41:1 == 0
					;1001,傷薬,50,;HPを30回復する薬品
					CALL GET_TREASURE,1001,2,FLAG:現ダンジョン,11
				;ボスを倒している
				ELSE
					;1008,道返玉,3000,リカーム
					CALL GET_TREASURE,1008,2,FLAG:現ダンジョン,11
				ENDIF
			ENDIF
		;二階
		CASE 2
	ENDSELECT
	RETURN 1

;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 6
	SELECTCASE FLAG:現M
		;地下一階の6へ入った
		CASE 0
			;地下一階　6の座標を指定　X3/Y3
			SIF FLAG:現X == 3 && FLAG:現Y == 3
				;一階　7の座標に移動　X10/Y7
				CALL DUNGEON_UPSTAIRS,1,10,7
		;一階の6へ入った
		CASE 1
			;一階　6の座標を指定
			SIF FLAG:現X == 8 && FLAG:現Y == 7
				;ニ階　7の座標に移動
				CALL DUNGEON_UPSTAIRS,2,1,7
	ENDSELECT
	RETURN 1
	
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 7
	SELECTCASE FLAG:現M
		;上記昇り階段の数値を入れ替える
		;一階の7へ入った
		CASE 1
			;一階　MAP7の座標を指定
			SIF FLAG:現X == 10 && FLAG:現Y == 7
				;地下一階　6の座標に移動
				CALL DUNGEON_DOWNSTAIRS,0,3,3
		;二階の7へ入った
		CASE 2
			;ニ階　MAP7の座標を指定
			SIF FLAG:現X == 1 && FLAG:現Y == 7
				;一階　MAP6の座標に移動
				CALL DUNGEON_DOWNSTAIRS,1,8,7
	ENDSELECT
	RETURN 1

;==========
;扉の処理
;==========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 2
	CALL DUNGEON_DOOR,ARG
	RETURN 1


;========================
;イベント
;========================
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 4
	IF FLAG:現M == 1 && FLAG:現X == 6 && FLAG:現Y == 3 && ダンジョンフラグ:41:3 == 0
		CUSTOMDRAWLINE =
		PRINTL 廊下を進むと、頭上から天使が舞い降りてきた。
		PRINTW 「神に逆らう愚かな人間よ」
		PRINTW 「我が同胞を殺めた汝等を生かして帰すわけにはいかん!!」
		PRINTL 天使 アークエンジェルが3体出た！
		CUSTOMDRAWLINE =
		WAIT
		FLAG:逃走不可フラグ = 1
		FLAG:会話不能フラグ = 1
		FLAG:先制不意打ちキャンセル = 1
		;アークエンジェルＡ
		;マヨーネ陥落済みでＰＴにいる
		IF FINDCHARA_B(4516,0) == 2
			;アークエンジェルLv24
			CALL SET_ENEMY,8,[[キャラ:アークエンジェル]],39,0,0
			CFLAG:(CHARANUM-1):ＨＰ補正 += 300
		ELSE
			CALL SET_ENEMY,8,[[キャラ:アークエンジェル]],30,0,0
			CFLAG:(CHARANUM-1):ＨＰ補正 += 100
		ENDIF
		CALL SYNC_STATUS,(CHARANUM-1)
		CALL HEALTH_CHARA,(CHARANUM-1)

		;アークエンジェルＢ
		;マヨーネ陥落済みでＰＴにいる
		IF FINDCHARA_B(4516,0) == 2
			;アークエンジェルLv24
			CALL SET_ENEMY,9,[[キャラ:アークエンジェル]],39,0,0
			CFLAG:(CHARANUM-1):ＨＰ補正 += 300
		ELSE
			CALL SET_ENEMY,9,[[キャラ:アークエンジェル]],30,0,0
			CFLAG:(CHARANUM-1):ＨＰ補正 += 100
		ENDIF
		CALL SYNC_STATUS,(CHARANUM-1)
		CALL HEALTH_CHARA,(CHARANUM-1)

		;マヨーネ陥落済みでＰＴにいる
		IF FINDCHARA_B(4516,0) == 2
			;アークエンジェルLv24
			CALL SET_ENEMY,10,[[キャラ:アークエンジェル]],39,0,0
			CFLAG:(CHARANUM-1):ＨＰ補正 += 300
		ELSE
			;アークエンジェルLv24
			CALL SET_ENEMY,10,[[キャラ:アークエンジェル]],30,0,0
			CFLAG:(CHARANUM-1):ＨＰ補正 += 100
		ENDIF
		CALL SYNC_STATUS,(CHARANUM-1)
		CALL HEALTH_CHARA,(CHARANUM-1)

		CALL BATTLE_START
		FLAG:逃走不可フラグ = 0
		FLAG:会話不能フラグ = 0
		FLAG:先制不意打ちキャンセル = 0
		PRINTFORMW 「神よ…」
		PRINTFORMW 天使の群れを倒した。
		;マヨーネＧＥＴ済み
		IF イベントフラグ:1:0 == 3
			;マヨーネ陥落済みでＰＴにいる
			IF FINDCHARA_B(4516,0) == 2
				PRINTFORMW 「もっと上位の天使じゃないと何も知らないようね…」
				ダンジョンフラグ:41:3 = 1
			ELSE
				PRINTFORMW 既に侵入はばれているようだ…
				PRINTFORMW こうなれば天使どもの首魁に直接召喚サーバーの在り処を吐かせる他、手立てはあるまい。
				ダンジョンフラグ:41:3 = 1
			ENDIF
		ELSE
			PRINTFORML やけに警備が厳しい。
			PRINTFORMW 警備の天使がやられていた事も気にかかる。
			PRINTFORMW 自分達以外の何者かが侵入しているのだろうか…
			ダンジョンフラグ:41:3 = 1
		ENDIF
	ENDIF

	IF FLAG:現M == 2 && FLAG:現X == 1 && FLAG:現Y == 1 && ダンジョンフラグ:41:4 == 0
		;マヨーネＧＥＴ済み
		IF イベントフラグ:1:0 == 3
			CUSTOMDRAWLINE =
			PRINTL 赤い絨毯の引かれた執務室の中央に天使がいた。
			PRINTL 「ガイア教徒ではないな？」
			PRINTW 「何が目的だ、人間」
			;マヨーネ陥落済みでＰＴにいる
			IF FINDCHARA_B(4516,0) == 2
				PRINTFORMW 「召喚サーバーの在り処を教えていただきましょうか？」
			ELSE
				PRINTFORMW 召喚サーバーの在り処を問いただした%CALLNAME:MASTER%に天使は答えた。
			ENDIF
			PRINTFORMW 「残念だが、そんな物はココには無い」
			PRINTFORMW 「同胞の仇を討たせてもらうぞっ！！」
			PRINTL 天使 パワーが１体出た！
			CUSTOMDRAWLINE =
			WAIT
			FLAG:逃走不可フラグ = 1
			FLAG:会話不能フラグ = 1
			FLAG:先制不意打ちキャンセル = 1
			;パワーLv34
			CALL SET_ENEMY,9,[[キャラ:パワー]],40,0,1
			CFLAG:(CHARANUM-1):行動回数 = 2
			CFLAG:(CHARANUM-1):ＨＰ補正 += 500
			CALL SYNC_STATUS,(CHARANUM-1)
			CALL HEALTH_CHARA,(CHARANUM-1)
		
			CALL BATTLE_START
			FLAG:逃走不可フラグ = 0
			FLAG:会話不能フラグ = 0
			FLAG:先制不意打ちキャンセル = 0
			
			;デビサバルートに続く
			PRINTL 目的は果たしたが…悪魔召喚サーバーとは一体何なのだろうか
			
		ELSE
			CUSTOMDRAWLINE =
			PRINTL 執務室の赤い絨毯を天使の身体から流れ出る赤い血が真紅に染めていた。
			PRINTW 「遅かったですわね」
			PRINTL 「フフ…貴方のおかげで楽に侵入出来ましたわ」
			PRINTW パラソルをクルクルと回し、マヨーネが不敵に微笑む。
			PRINTL 「貴方の任務はそれで終わり」
			PRINTL 「けど、この天使さん…私の知りたい肝心な所を答えてくださらなかったの」
			PRINTL 「ああっ、イライラするわ…ちょっと死んでくださらない？」
			PRINTFORMW ＞マヨーネは手にしたパラソル型ＣＯＭＰを%CALLNAME:MASTER%へと向ける
			PRINTL
			PRINTL デビルサマナー マヨーネ１体が出た！
			PRINTW 仲魔が５体出た！
			PRINTL
			CUSTOMDRAWLINE =
			WAIT
			FLAG:逃走不可フラグ = 1
			FLAG:会話不能フラグ = 1
			FLAG:先制不意打ちキャンセル = 1
			CALL SET_ENEMY,14,[[キャラ:マヨーネ]],30,0,1
			;シングル
			ABL:(CHARANUM-1):スキル1 = 111
			;連続
			ABL:(CHARANUM-1):スキル2 = 112
			;ジオンガ
			ABL:(CHARANUM-1):スキル3 = 902
			;マハ・ジオ
			ABL:(CHARANUM-1):スキル4 = 904
			;ムド
			ABL:(CHARANUM-1):スキル5 = 1401
			;一分の魔脈
			ABL:(CHARANUM-1):スキル6 = 2403
			;メディカルパウダー
			ABL:(CHARANUM-1):スキル7 = 3005
			;ＧＵＮ
			ABL:(CHARANUM-1):スキル7 = 2101
			EQUIP:(CHARANUM-1):剣 = [[アイテム:アセイミナイフ]]
			EQUIP:(CHARANUM-1):銃 = [[アイテム:デザートイーグル]]
			EQUIP:(CHARANUM-1):頭 = [[アイテム:羽飾り]]
			EQUIP:(CHARANUM-1):胴 = [[アイテム:アゲハドレス]]
			EQUIP:(CHARANUM-1):腕 = [[アイテム:レザーグラブ]]
			EQUIP:(CHARANUM-1):足 = [[アイテム:ダンシングヒール]]
			CFLAG:(CHARANUM-1):行動回数 = 2
			CFLAG:(CHARANUM-1):ＨＰ補正 += 500
			CALL SYNC_STATUS,(CHARANUM-1)
			CALL HEALTH_CHARA,(CHARANUM-1)
			
			;ファントムウィッチ　Lv12（27）
			CALL SET_ENEMY,13,[[キャラ:Fウィッチ]],27,0,0

			;教条の塔　Lv27（30）
			CALL SET_ENEMY,15,[[キャラ:教条の塔]],30,0,0
			ABL:(CHARANUM-1):スキル1 = 902
			ABL:(CHARANUM-1):スキル2 = 904
			ABL:(CHARANUM-1):スキル3 = 1101
			ABL:(CHARANUM-1):スキル4 = 0
			CALL SYNC_STATUS,(CHARANUM-1)
			CALL HEALTH_CHARA,(CHARANUM-1)
			
			;マンイーター　Lv27（30）
			CALL SET_ENEMY,8,[[キャラ:マンイーター]],30,0,0
			CFLAG:(CHARANUM-1):ＨＰ補正 += 200
			CALL SYNC_STATUS,(CHARANUM-1)
			CALL HEALTH_CHARA,(CHARANUM-1)
			
			;ゴルゴンLv29
			CALL SET_ENEMY,9,[[キャラ:ゴルゴン]],29,0,0
			CFLAG:(CHARANUM-1):ＨＰ補正 += 500
			CALL SYNC_STATUS,(CHARANUM-1)
			CALL HEALTH_CHARA,(CHARANUM-1)

			;アルケニー　Lv28
			CALL SET_ENEMY,10,[[キャラ:アルケニー]],28,0,0
			CFLAG:(CHARANUM-1):ＨＰ補正 += 200
			CALL SYNC_STATUS,(CHARANUM-1)
			CALL HEALTH_CHARA,(CHARANUM-1)
			
			
			CALL BATTLE_START
			FLAG:逃走不可フラグ = 0
			FLAG:会話不能フラグ = 0
			FLAG:先制不意打ちキャンセル = 0
			PRINTL
			PRINTL  ｢フフ…どうやら遊んでいる間に天使達が集まって来てしまったわね」
			PRINTW 「今日の所はこの辺で許してさしあげますわ」
			PRINTFORMW そう言ってマヨーネはくらましの玉を地面に叩きつけると姿を眩ました…
		ENDIF
		ダンジョンフラグ:41:1 = 1
		PRINTW 大使館調査の報酬として￥25000が支払われた
		MONEY += 25000
		PRINTW 執務室のターミナルが使用できるようになった！
		;現在地をターミナルに
		DA:(FLAG:現X):(FLAG:現Y) = -9
		RETURN 1
	ENDIF

ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 9
	CALL DUNGEON_TERMINAL
	RETURN 1
ENDIF
RETURN 0


