			CALL GET_TREASURE_MONEY,0,RAND:((ダンジョンフラグ:70:50-100)*(ダンジョンフラグ:70:50-100))-(ダンジョンフラグ:70:50*10),70,99
		ENDIF
	ELSEIF RESULTS == "刈り取る者"
