	PRINTFORML ダンジョン構築中..

	C:1 = RAND:4
	C:2 = RAND:4
	C:3 = RAND:4
	C:4 = RAND:4
	C:5 = RAND:4
	C:6 = RAND:4

	;0U 1L 2D 3R

