;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_70,ARG
FLAG:現M = 0
FLAG:現X = 8
FLAG:現Y = 10
;CALL AUTOMAP

;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_70
#LOCALSIZE 2
IF ダンジョンフラグ:70:96 == 1
	ダンジョンフラグ:70:96 = 2
	PRINTFORMW ………タルタロスの地下奥深くで、誰かが%CALLNAME:MASTER%を待っている……
ENDIF
IF FLAG:DEBUG == 1
	SETCOLOR 0x00ffff
	PRINTFORMW デバッグ中につきショートカット階段が発生します
	RESETCOLOR
ENDIF
;階層リセット
ダンジョンフラグ:70:(50)=0
;探索できるメンバー計算
IF ダンジョンフラグ:70:(88) == 0 && ダンジョンフラグ:70:0 > 0
	CALL TARTAR_MEMBERNUM
ELSE
	ダンジョンフラグ:70:(95) = 99
ENDIF
IF ダンジョンフラグ:70:0 == 0
	ダンジョンフラグ:70:(10) = 1
	ダンジョンフラグ:70:(11) = 1
	ダンジョンフラグ:70:(12) = 1
	ダンジョンフラグ:70:(13) = 1
	ダンジョンフラグ:70:(14) = 1
	ダンジョンフラグ:70:(15) = 1
	ダンジョンフラグ:70:(16) = 0
	ダンジョンフラグ:70:(17) = 0
	ダンジョンフラグ:70:(18) = 0
	ダンジョンフラグ:70:(19) = 0
	ダンジョンフラグ:70:(20) = 0
	ダンジョンフラグ:70:(22) = 0
	ダンジョンフラグ:70:(23) = 0
	;鬼太郎貰ってたらいない
	SIF ダンジョンフラグ:70:(94) != 2
		ダンジョンフラグ:70:(10) = (-1)
	;ハム子貰ってたらいない
	SIF ダンジョンフラグ:70:(94) != 1
		ダンジョンフラグ:70:(11) = (-1)
	PRINTL 
	PRINTL 
	PRINTL 影時間。
	PRINTL それは一日と一日の狭間に存在する、謎の時間。
	PRINTL そして現れる巨大な塔、その名はタルタロス。
	PRINTFORML %CALLNAME:MASTER%は、そこへ足を踏み入れた。
	PRINTFORMW ………
	PRINTFORMW ……
	PRINTFORMW …
	PRINTFORMW エントランスに入ると、%CALLNAME:MASTER%の目に数人の少年少女たちが目に入った。
	PRINTW こちらに気づいたのか、彼らの中でも一際魅力的な女性がこちらに会釈してきた。
	PRINTFORMW 「%CALLNAME:MASTER%さんですね？」
	PRINTW 「幾月理事長から話は聞いています」
	PRINTW 「桐条美鶴と申します」
	PRINTW 「私たちは月光館学園の特別課外活動部」
	PRINTW 「人に害をなすシャドウの殲滅、および、ここ、タルタロスの探索を目的としています」
	PRINTW 「我々はつい先日、ようやく十分な人数が揃ったところであり」
	PRINTW 「このタルタロスを攻略するにはまだ人員も実力も未熟です」
	PRINTW 「その為、今回貴方がたが手を貸していただけることはこの上なく助かります」
	PRINTW 「同じ目的を持つ者として、これからよろしくお願いします」
	ダンジョンフラグ:70:0 = 1
	;=======================================================================
	;１階を自動マッピング
	;=======================================================================
	;SAVESTR:GET_FLOOR_ANALYZE_NUM(FLAG:現ダンジョン, 0) = %"2"* 13 * 17%
	FOR LOCAL:1, 0, FLAG:最大Y
		FOR LOCAL, 0, FLAG:最大X
			CALLF DPOINT("SET" , 2 , LOCAL , LOCAL:1 , 0 , @"ダンジョン%TOSTR(FLAG:現ダンジョン , "00")%" )
		NEXT
	NEXT
	ダンジョンフラグ:(FLAG:現ダンジョン):100 = ダンジョンフラグ:(FLAG:現ダンジョン):100 % 10000 * 10000 + 1317
	;CALL TARTAR_MAPDEL
	;C:0 = COUNT
	;REPEAT FLAG:最大X
	;	C:1 = COUNT
	;	FOR A,0,FLAG:最大Y,1
	;		TA:(FLAG:現ダンジョン):(C:1):COUNT = 0
	;	NEXT
	;	COUNT = C:1
	;REND
	;COUNT = C:0
	;=======================================================================
ELSEIF ダンジョンフラグ:70:(95) < 3 && ダンジョンフラグ:70:(88) == 0
	PRINTFORMW タルタロスに来た%CALLNAME:MASTER%のところへ、ちょうどよく幾月が現れる。
	PRINTFORMW 「やあ、%CALLNAME:MASTER%くん。久しぶり、だっけ？」
	PRINTW 「まあ今日会った理由は君も会ったことがあると思う、特別課外活動部についてだ」
	PRINTW ……そういえば、いつもはいる彼らが、今日は見当たらない。
	PRINTW 「いや、僕の方でも彼らに探索を任せてたんだけどね」
	PRINTW 「その、探索中に事故が起きたのか、探索できそうなメンバーが足りなくなってしまったんだ」
	PRINTW 「悪いけど、僕の方は探索を打ち切らせてもらう」
	PRINTW 「でも、まあ君に頼んだ依頼はまだ続いてるから頑張ってほしい」
	PRINTW 幾月はそれだけを伝え、去っていった……
	PRINTW ………
	PRINTW ……
	PRINTW …
	PRINTL 
	ダンジョンフラグ:70:(88) = 1
ELSEIF ダンジョンフラグ:70:(1) >= 2 && ダンジョンフラグ:70:(89) == 2 && ダンジョンフラグ:70:(22) == 0
	ダンジョンフラグ:70:(22) = 1
	PRINTFORMW どうやら、特別課外活動部にメンバーが増えたようだ
ELSEIF ダンジョンフラグ:70:(1) >= 4 && ダンジョンフラグ:70:(17) == 0
	ダンジョンフラグ:70:(17) = 1
	SIF ダンジョンフラグ:70:(70) == 1
		ダンジョンフラグ:70:(16) = 1
	PRINTFORMW どうやら、特別課外活動部にメンバーが増えたようだ
ELSEIF ダンジョンフラグ:70:(1) >= 5 && ダンジョンフラグ:70:(18) == 0
	ダンジョンフラグ:70:(18) = 1
	ダンジョンフラグ:70:(19) = 1
	PRINTFORMW どうやら、特別課外活動部にメンバーが増えたようだ
	ダンジョンフラグ:70:(20) = 1
ELSEIF ダンジョンフラグ:70:(1) >= 7 && ダンジョンフラグ:70:(19) >= 1 && ダンジョンフラグ:70:(20) >= 1
	ダンジョンフラグ:70:(19) = (-1)
	ダンジョンフラグ:70:(20) = (-1)
	PRINTFORMW ……どうやら、特別課外活動部のメンバーが減ったようだ
ENDIF


;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_70,ARG,ARG:1
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

