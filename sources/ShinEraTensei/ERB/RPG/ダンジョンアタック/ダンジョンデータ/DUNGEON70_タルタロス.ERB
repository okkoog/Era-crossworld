;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_70

;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 3
	CALL TARTAROS_70_TREASUREBOXS
	RETURN 1
;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 6
	CALL TARTAR_UPSTAIRS
	RETURN 1
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 7
	CALL TARTAR_DOWNSTAIRS
	RETURN 1
ELSE
	PRINTW 何も無いようだ
	RETURN 0
ENDIF


