;----------------------------------------------------
;近道
;一歩前でのイベント
@DUNGEON_82_BOSS_1F_1
;１～３日目でボス倒してない
IF ダンジョンフラグ:82:1 >= 1 && ダンジョンフラグ:82:1 < 10 && ダンジョンフラグ:82:10 == 0
	PRINTFORMW ここで戦闘、というよりは一方的な虐殺でも行われたのか、壁は血で汚れ、床には武具の残骸や肉片が転がっている。
	PRINTFORMW 少し先から漂ってくる威圧感はこの戦いの勝者のものだろうか？
	PRINTFORMW 他の道を探したほうが安全かもしれない……
;ショウジのところへ移動したかボス倒した後
ELSEIF ダンジョンフラグ:82:1 >= 20 || ダンジョンフラグ:82:10 == 1
	PRINTFORMW 壁が乾いた血で汚れ床には武具の残骸が転がっている……
	PRINTFORMW しばらく前にここで戦闘が行われたようだ……
ENDIF

;近道、エレベーター側から
;一歩前でのイベント
@DUNGEON_82_BOSS_1F_2
;１～３日目でボス倒してない
IF ダンジョンフラグ:82:1 >= 1 && ダンジョンフラグ:82:1 < 10 && ダンジョンフラグ:82:10 == 0
	PRINTFORMW 少し先からこの場には似合わないほどの威圧感が漂ってくる。
	PRINTFORMW 他の道を探したほうが安全かもしれない……
;ショウジのところへ移動したかボス倒した後
ELSEIF ダンジョンフラグ:82:1 >= 20 || ダンジョンフラグ:82:10 == 1
	PRINTFORMW なんの気配も感じられない……
ENDIF

;マス侵入
@DUNGEON_82_BOSS_1F_3
;１～３日目でボス倒してない
IF ダンジョンフラグ:82:1 >= 1 && ダンジョンフラグ:82:1 < 10 && ダンジョンフラグ:82:10 == 0
	PRINTFORMW 「ああ？　なんだテメェは？」
	;あなたが女か男の娘
	IF TALENT:MASTER:オトコ == 0 || TALENT:MASTER:男の娘
		PRINTFORMW 「テメェが入り込んだって女か？」
		PRINTFORMW 「そっちからきてくれるとは運がいいぜ。　たっぷりと可愛がってやる！」
	;あなたが男
	ELSE
		PRINTFORMW 「俺の縄張りに入ってくるとはいい度胸じゃねぇか。」
		PRINTFORMW 「ちょっと暇つぶしの相手になれよ！」
	ENDIF
	;戦闘
	CALL DUNGEON_82_BOSS_01
;ショウジのところへ移動したかボス倒した後
ELSEIF ダンジョンフラグ:82:1 >= 20 || ダンジョンフラグ:82:10 == 1
	PRINTFORMW だれもいない……
ENDIF
;----------------------------------------------------
;ボスの部屋

@DUNGEON_82_BOSS_ROOM
PRINTFORMW 他の部屋より内装が整えられた部屋だ……
;ボス倒した
IF ダンジョンフラグ:82:10 == 1
	PRINTFORMW だれもいない……
;ボス倒してない
ELSEIF ダンジョンフラグ:82:10 == 0
	;ショウジ救出済み
	IF ダンジョンフラグ:82:1 == -1
		IF RAND:2 == 0
			PRINTFORMW 「ぐぉぉぉぉ、ぐぉぉぉぉ……。」
			PRINTFORMW 部屋の隅にあるベッドでオニが高いびきで寝ている……
		ELSE
			PRINTFORMW 「ぷはぁっ！　なんか面白いことでもねぇかなぁ……。　ぐびっ、ぐびっ……。」
			PRINTFORMW 部屋の中には酒を飲みながら呟いているオニがいる……
		ENDIF
		;戦闘可能
		PRINTFORML 　
		PRINTFORMW 今なら不意打ちできるかもしれない。
		PRINTFORMW さて、どうしようか？
		CALL INPUT_SELECT,1,"戦う",2,"帰る"
		SELECTCASE RESULT
			CASE 1
				PRINTFORMW 「う、うぉっ！？　な、なんだテメェは！？」
				;戦闘
				CALL DUNGEON_82_BOSS_03
				
			CASE 2
				PRINTFORMW オニに気づかれないようにその場を後にした……
		ENDSELECT
	;ショウジ捕獲前
	;１階にいるからいない
	ELSEIF ダンジョンフラグ:82:1 >= 1 && ダンジョンフラグ:82:1 < 10
		PRINTFORMW だれもいない……
	;ショウジ捕獲～輪姦
	;ショウジの所に行ってるからいない
	ELSEIF ダンジョンフラグ:82:1 >= 10 && ダンジョンフラグ:82:1 < 30
		PRINTFORMW だれもいない……
	;ショウジ輪姦～便器
	;飽きて戻ってきている
	ELSEIF ダンジョンフラグ:82:1 >= 30
		IF RAND:3 == 0 && ダンジョンフラグ:82:1 == -1
			PRINTFORMW 「壊れた女でも盗まれるのはムカつくぜ……。　ぐびっ、ぐびっ……。」
			PRINTFORMW 部屋の中には酒を飲みながら呟いているオニがいる……
		ELSEIF RAND:2 == 0
			PRINTFORMW 「ぐぉぉぉぉ、ぐぉぉぉぉ……。」
			PRINTFORMW 部屋の隅にあるベッドでオニが高いびきで寝ている……
		ELSE
			PRINTFORMW 「ぷはぁっ！　また女でもはいりこまねぇかなぁ……。　ぐびっ、ぐびっ……。」
			PRINTFORMW 部屋の中には酒を飲みながら呟いているオニがいる……
		ENDIF
		;戦闘可能
		PRINTFORML 　
		PRINTFORMW 今なら不意打ちできるかもしれない。
		PRINTFORMW さて、どうしようか？
		CALL INPUT_SELECT,1,"",2,""
		SELECTCASE RESULT
			CASE 1
				PRINTFORMW 「う、うぉっ！？　な、なんだテメェは！？」
				;戦闘
				CALL DUNGEON_82_BOSS_03
				
			CASE 2
				PRINTFORMW オニに気づかれないようにその場を後にした……
		ENDSELECT
	ENDIF
ENDIF
