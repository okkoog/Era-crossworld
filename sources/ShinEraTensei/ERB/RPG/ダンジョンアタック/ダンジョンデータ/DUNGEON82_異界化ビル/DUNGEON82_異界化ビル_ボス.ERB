CALL SET_ENEMY,9,[[キャラ:オニ]],30,0,1
CFLAG:(CHARANUM-1):行動回数 = 2
CFLAG:(CHARANUM-1):ＨＰ補正 += 1500
ABL:(CHARANUM-1):スキル1 = [[スキル:暴れまくり]]
ABL:(CHARANUM-1):スキル2 = [[スキル:唐竹割り]]
ABL:(CHARANUM-1):スキル3 = [[スキル:食いしばり]]
ABL:(CHARANUM-1):スキル4 = [[スキル:タル・カジャ]]

