;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_10,ARG
IF イベントフラグ:20:0 >= 3
	FLAG:現M = 0
	FLAG:現X = 6
	FLAG:現Y = 1
ELSE
	FLAG:現M = 0
	FLAG:現X = 0
	FLAG:現Y = 13
ENDIF
FLAG:MAG消費率 = 75

;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_10
IF ダンジョンフラグ:(FLAG:現ダンジョン):0 == 0
	CALL SHOW_PICTURE, "D"
	CALL MESSAGE_WINDOW_D, "", "＞御影町における異界化事件/＞どうも元凶は佐伯Erergy&Biological&Electronics・Corporation社…/＞通称SEBECにあるらしい"
	CALL MESSAGE_WINDOW_D, "", "＞御影町には神取鷹久という男が率いる支社があるのだが/＞そこが妙な動きをしていたらしい/＞……と、なるとスポンサーは本社の方かも知れない"
	CALL MESSAGE_WINDOW_D, "", "＞これ以上厄介なことになる前に支社を切ったか？/＞まぁ、そこら辺の事情は忖度しても始まらないのだが"
	CALL MESSAGE_WINDOW_D, "", "………………/…………/……"
	IF イベントフラグ:20:0 >= 3
		CALL MESSAGE_WINDOW_D, "", @"＞以前黒ずくめから奪ったIDカードと、女生徒の話/＞合わせて考えれば、廃工場には何かがあると言う事になる/＞%CALLNAME:MASTER%は廃工場を調べて、隠し通路を発見し、/＞そこからSEBECビルに侵入した"
		ダンジョンフラグ:(FLAG:現ダンジョン):0 = 1
	ELSE
		CALL MESSAGE_WINDOW_D, "黒スーツの男", "止まれ、ここからは部外者立ち入り禁止だ"
		CALL MESSAGE_WINDOW_D, "", "＞支社ビルに近付いた時点で、黒スーツの男たちに止められた/＞それは良いのだが、いきなり銃を向けてくる辺り/＞この事件は我々がやりましたと言わんばかりではある/＞で、あればこちらも問答無用で良いだろう"
		CALL MESSAGE_WINDOW_D, "", "＞超人ブラックマンが出た"
		FLAG:逃走不可フラグ = 1
		FLAG:会話不能フラグ = 1
		FLAG:先制不意打ちキャンセル = 1
		CALL SET_ENEMY,8,4212,15,0,0
		CALL SET_ENEMY,9,4212,15,0,0
		CALL SET_ENEMY,10,4212,15,0,0
		CALL SET_ENEMY,14,4212,25,0,1
		CALL BATTLE_START
		CALL SHOW_PICTURE, "D"
		FLAG:逃走不可フラグ = 0
		FLAG:会話不能フラグ = 0
		FLAG:先制不意打ちキャンセル = 0
		ダンジョンフラグ:(FLAG:現ダンジョン):0 = 1
		CALL MESSAGE_WINDOW_D, "", "＞……黒スーツの男達を倒して、SEBECビルに侵入した"
	ENDIF
ENDIF

