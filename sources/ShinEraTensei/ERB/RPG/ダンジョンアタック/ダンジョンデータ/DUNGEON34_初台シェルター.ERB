			FLAG:脱出 = 1
		ELSE
			CALL MESSAGE_WINDOW_D, "ゴウト", "ならば、探索を続けるぞ"
			CALL MESSAGE_WINDOW_D, "", "＞ゴウトが促す様にダンジョンの先を示す"
			FLAG:脱出 = 0
		ENDIF
	ELSE
		FLAG:脱出 = 1
