;=======================================================================
;特殊タイル表示
;=======================================================================
@TILE_MARK_COMMON_93_1, ARG , ARG:1 , ARG:2
SELECTCASE ARG / 10
	CASE 1
		RESULTS = ↑
	CASE 2
		RESULTS = ↓
	CASEELSE
		RETURN 1
ENDSELECT

@TILE_MARK_COMMON_93_2, ARG , ARG:1 , ARG:2
SELECTCASE ARG / 10
	CASE 1
		RESULTS = ↑
	CASE 2
		RESULTS = ↓
	CASEELSE
		RETURN 1
ENDSELECT

@TILE_MARK_COMMON_93_4, ARG , ARG:1 , ARG:2
SELECTCASE ARG / 10
	CASE  2 , 3 
		RESULTS = ↑
	CASE  1 , 4
		RESULTS = ↓
	CASE  5
	IF ダンジョンフラグ:(FLAG:現ダンジョン):1 == 1 || ダンジョンフラグ:(FLAG:現ダンジョン):1 == 2
		SETCOLOR 0x00ff00
		RESULTS = ｍ
		ELSE
		RESULTS = □
		ENDIF
	CASEELSE
		RETURN 1
ENDSELECT

@TILE_MARK_COMMON_93_9, ARG , ARG:1 , ARG:2
SELECTCASE ARG / 10
	CASE 2 , 3 , 4
		RESULTS = Ｅ
	CASEELSE
		RETURN 1
ENDSELECT

;=======================================================================
;タイル定義
;=======================================================================
@DEFINE_TILES_93, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "["
		RETURN 11
	CASE "]"
		RETURN 21
	CASE "("
		RETURN 12
	CASE ")"
		RETURN 22
	CASE "#"
		RETURN 32
	CASE "$"
		RETURN 42
	CASE "%"
		RETURN 52
	CASE "A"
		RETURN 14
	CASE "B"
		RETURN 24
	CASE "C"
		RETURN 34
	CASE "D"
		RETURN 44
	CASE "m"
		RETURN 54
	CASE "y"
		RETURN 64
	CASE "i"
		RETURN 74
	CASE "s"
		RETURN 84
	CASE "X"
		RETURN 6004
	CASE "Y"
		RETURN 6104
	CASE "Z"
		RETURN 6204
	CASE "U"
		RETURN 6304
	CASE "a"
		RETURN 29
	CASE "b"
		RETURN 39
	CASE "c"
		RETURN 49
ENDSELECT


;=======================================================================
;タイル調整
;=======================================================================
@MAKE_FLOOR_LINE_COMMON_93, ARG, ARG:1, ARG:2
#LOCALSIZE 30
;LOCAL:3 宝箱 ダンジョンフラグ:70~99
;LOCAL:4 イベント
;(0/0)でLOCALを消去
SIF ARG:1 == 0 && ARG:2 == 0
	VARSET LOCAL
SELECTCASE ARG
	CASE 3
		IF GETBIT(ダンジョンフラグ:(FLAG:現ダンジョン):(FLAG:現M+70), LOCAL:3)
			DA:(ARG:1):(ARG:2) = 1
		ELSE
			DA:(ARG:1):(ARG:2) = FLAG:現M *1000 + LOCAL:3 * 10 + 3
		ENDIF
		LOCAL:3++
	CASE 4
		DA:(ARG:1):(ARG:2) = FLAG:現M *1000 + LOCAL:4 * 10 + 4
		LOCAL:4++
	CASE 5
		;DA:(ARG:1):(ARG:2) = FLAG:現M *1000 + LOCAL:5 * 10 + 5
		;LOCAL:5++
	CASE 6
		DA:(ARG:1):(ARG:2) = FLAG:現M *1000 + LOCAL:6 * 10 + 6
		LOCAL:6++
	CASE 7
		DA:(ARG:1):(ARG:2) = FLAG:現M *1000 + LOCAL:7 * 10 + 7
		LOCAL:7++
	CASE 8
		DA:(ARG:1):(ARG:2) = FLAG:現M *1000 + LOCAL:8 * 10 + 8
		LOCAL:8++
	CASE 9
		DA:(ARG:1):(ARG:2) = FLAG:現M *1000 + LOCAL:9 * 10 + 9
		LOCAL:9++

ENDSELECT
;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_93
CALL EVENT_DUNGEON_93
RETURN RESULT

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_93, ARG
;ARG = 進入時の向き　0の場合ワープなど
CALL EVENT_DUNGEON_93, ARG , 0
RETURN RESULT

@EVENT_DUNGEON_93, ARG, ARG:1
#DIM 交渉可能キャラ , 7
SELECTCASE DA:(FLAG:現X):(FLAG:現Y) % 10
;==========
;出口の処理
;==========
	CASE 8
		IF ダンジョンフラグ:(FLAG:現ダンジョン):1 == 4 || ダンジョンフラグ:(FLAG:現ダンジョン):1 == 5
		CALL DUNGEON_EXIT
		ELSE
		CALL MESSAGE_WINDOW_D, "", "＞任務中は帰還できません"
		FLAG:現Y = 19
		ENDIF
	RETURN 1
;==========
;扉の処理
;==========
	CASE 2
		CALL DUNGEON_DOOR,ARG
		RETURN 1
		
;========
;宝の処理
;========
	CASE 3
		CALL TREASURE_93
		RETURN 1
;==========
;イベント
;==========
	CASE 4
		SELECTCASE DA:(FLAG:現X):(FLAG:現Y) / 10
	CASE  2 , 3 
				CALL SHOW_FORCEMOVE, "UUUUUU", "D", , ,  ""
	CASE  1 , 4
				CALL SHOW_FORCEMOVE, "DDDDDD", "D", , ,  ""
	CASE 5
	IF ダンジョンフラグ:(FLAG:現ダンジョン):1 == 1 || ダンジョンフラグ:(FLAG:現ダンジョン):1 == 2
		IF ダンジョンフラグ:(FLAG:現ダンジョン):5 == 0
				CALL MESSAGE_WINDOW_D, "サマナー", "すいません！/管理室の悪魔にシステムを乗っ取られました！"
				CALL MESSAGE_WINDOW_D, "サマナー", "中央の手続きカウンターでロックを外していってください"
				CALL MESSAGE_WINDOW_D, "サマナー", "真っ正面のエレベーターは２階で、３階のロックは地下で外せるんで、その順番で外していってください"
		ダンジョンフラグ:(FLAG:現ダンジョン):5 = 1
		ELSEIF ダンジョンフラグ:(FLAG:現ダンジョン):5 == 1
				CALL MESSAGE_WINDOW_D, "サマナー", "中央の手続きカウンターでロックを外して左右のエレベーターで２階に向かってください"
		ENDIF
	ENDIF
	CASE 6
	IF ダンジョンフラグ:(FLAG:現ダンジョン):1 == 4
		IF ダンジョンフラグ:(FLAG:現ダンジョン):8 == 0
				CALL MESSAGE_WINDOW_D, "男の声", "…お前は… あの時の…"
				CALL MESSAGE_WINDOW_D, "男の声", "……私の使っていたものが/地下の、廃棄物処理場に…/捨てられているのだ…"
				CALL MESSAGE_WINDOW_D, "男の声", "どうか、役立ててくれ…/そして、何が正しいのか、/教えてくれ……"
		ダンジョンフラグ:(FLAG:現ダンジョン):8 = 1
		ENDIF
	ENDIF
	CASE 7
	IF ダンジョンフラグ:(FLAG:現ダンジョン):1 == 4 && ダンジョンフラグ:(FLAG:現ダンジョン):8 == 1
				CALL MESSAGE_WINDOW_D, "", "＞廃棄物処理場"
				CALL MESSAGE_WINDOW_D, "男の声", "よく来た…"
				CALL MESSAGE_WINDOW_D, "男の声", "ここに静かに…眠っている…………かつて我が……使いし……/…ＣＯＭＰ……"
				CALL MESSAGE_WINDOW_D, "男の声", "……もはや…屍として…奏でる…こと…/叶わぬが…中に…仲魔がいたら/…起こしてやってくれ…"
				CALL MESSAGE_WINDOW_D, "男の声", "ここ……の奥だ……"
				CALL MESSAGE_WINDOW_D, "", "＞ゴミの中からサックスの形をしたＣＯＭＰの残がいを見つけた"
				CALL MESSAGE_WINDOW_D, "", "＞ＣＯＭＰに入っていた「パワー・メモリ」から悪魔を手に入れた"
				CALL ADD_NEW_COMPANION,[[キャラ:インキュバス]],500
				CALL ADD_NEW_COMPANION,[[キャラ:バンシー]],500
				CALL ADD_NEW_COMPANION,[[キャラ:モムノフ]],500
				CALL ADD_NEW_COMPANION,[[キャラ:ケライノー]],500
				CALL MESSAGE_WINDOW_D, "男の声", "……これで……この世に……/残せし…ものは…何も…無く…/……もはや……消る…のみ………"
				CALL MESSAGE_WINDOW_D, "男の声", "……なれど……/いかに…生きるべき…だったのか……/それだ……け…が…………"
				CALL MESSAGE_WINDOW_D, "", "…………"
				CALL MESSAGE_WINDOW_D, "", "＞声の気配は消えた……"
		ダンジョンフラグ:(FLAG:現ダンジョン):8 = 2
		ELSE
				CALL MESSAGE_WINDOW_D, "", "＞廃棄物処理場"
	ENDIF
	CASE 8
				CALL MESSAGE_WINDOW_D, "", "＞シャトル乗り"
				CALL MESSAGE_WINDOW_D, "", "シャトルは動いていない"
	CASE 600
		IF ダンジョンフラグ:(FLAG:現ダンジョン):1 == 0
				CALL MESSAGE_WINDOW_D, "", "＞手続きカウンター"
		ELSEIF ダンジョンフラグ:(FLAG:現ダンジョン):1 == 1
				CALL MESSAGE_WINDOW_D, "", "＞手続きカウンター"
				CALL MESSAGE_WINDOW_D, "システム", "………/１F東西ゲートのロックを解除します"
			ダンジョンフラグ:(FLAG:現ダンジョン):1 = 2
			ダンジョンフラグ:(FLAG:現ダンジョン):2 = 1
		ELSE
				CALL MESSAGE_WINDOW_D, "", "＞手続きカウンター"
				CALL MESSAGE_WINDOW_D, "システム", "現在ドアロックは解除されています"
		ENDIF
	CASE 610
		IF ダンジョンフラグ:(FLAG:現ダンジョン):1 == 2
				CALL MESSAGE_WINDOW_D, "", "＞手続きカウンター"
				CALL MESSAGE_WINDOW_D, "", "＞男と女が戦っている"
				CALL MESSAGE_WINDOW_D, "", "＞男の方は先に来ていたユダだ"
				CALL MESSAGE_WINDOW_D, "", "＞白いスーツの女の方は誰かわからない"
				CALL MESSAGE_WINDOW_D, "", "＞ユダを助けに入りますか？"
			CALL INPUT_YN_D
			IF RESULT == 0
			ダンジョンフラグ:(FLAG:現ダンジョン):6 = 1
				CALL MESSAGE_WINDOW_D, "女", "あっ、と。/増援！？"
				CALL MESSAGE_WINDOW_D, "", "/＞人間 レイ･レイホゥが１体出た！/"
			FLAG:逃走不可フラグ = 1
			FLAG:会話不能フラグ = 1
			FLAG:先制不意打ちキャンセル = 1
				CALL SET_ENEMY,9, [[キャラ:レイ]], 39, 0, 1
				CFLAG:(CHARANUM-1):ＨＰ補正 = +1000
				CFLAG:(CHARANUM-1):ＭＰ補正 = +1000
				CFLAG:(CHARANUM-1):行動回数 = 2
				ABL:(CHARANUM-1):スキル1 = [[スキル:マハンマオン]]
				ABL:(CHARANUM-1):スキル2 = [[スキル:不屈の闘志]]
				ABL:(CHARANUM-1):スキル3 = [[スキル:メギド]]
				ABL:(CHARANUM-1):スキル4 = [[スキル:マハ・ラギオン]]
				ABL:(CHARANUM-1):スキル5 = 0
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				CALL BATTLE_START
			FLAG:逃走不可フラグ = 0
			FLAG:会話不能フラグ = 0
			FLAG:先制不意打ちキャンセル = 0
