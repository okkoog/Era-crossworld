@DUNGEON_ELEVATOR_93, ARG
VARSET RESULT, -1
VARSET RESULTS
SELECTCASE ARG
	CASE 29
		RESULT:1 = 0
		RESULT:2 = 1
		RESULT:3 = 3
		RESULT:4 = 2
		RETURN -1
	CASE 39
		RESULT:1 = 0
		RESULT:2 = 1
		RESULT:3 = 2
		RETURN -1
	CASE 49
		RESULT:1 = 0
		RESULT:2 = 1
		RESULT:3 = 2
		RETURN -1
ENDSELECT

