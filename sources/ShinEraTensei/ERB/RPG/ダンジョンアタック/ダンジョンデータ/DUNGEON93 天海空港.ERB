;=======================================================================
;宝箱の中身
;=======================================================================
@TREASURE_93
#LOCALSIZE 3
LOCAL = FLAG:現M + 70
LOCAL:1 = (DA:(FLAG:現X):(FLAG:現Y) / 10) % 100
SELECTCASE DA:(FLAG:現X):(FLAG:現Y) / 10
	;マップ番号*100+そのマップで何番目の宝箱かを示す数値でどの宝箱かを判別します。
	;例えば0の場合、0版のマップの0番目の宝箱であることを表しています。
	CASE 0
		CALL GET_TREASURE_MONEY, 0 , 1000 , FLAG:現ダンジョン, LOCAL , LOCAL:1
	CASE 1
		CALL GET_TREASURE, [[アイテム:宝玉]] , 1 , FLAG:現ダンジョン, LOCAL , LOCAL:1
	CASE 100
		CALL GET_TREASURE, [[アイテム:牛黄丹]] , 2 , FLAG:現ダンジョン, LOCAL , LOCAL:1
	CASE 101
		CALL GET_TREASURE_MAG, , 400 , FLAG:現ダンジョン, LOCAL , LOCAL:1
	CASE 200
		CALL GET_TREASURE_MONEY, 0 , 1000 , FLAG:現ダンジョン, LOCAL , LOCAL:1		
	CASE 201
		CALL GET_TREASURE, [[アイテム:反魂香]] , 1 , FLAG:現ダンジョン, LOCAL , LOCAL:1
ENDSELECT
RETURN 1
