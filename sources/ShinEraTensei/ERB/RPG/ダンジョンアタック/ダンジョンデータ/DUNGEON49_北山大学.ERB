;扉の処理
;==========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 2
	IF FLAG:現M == 7 && FLAG:現X == 18 && FLAG:現Y == 11 && ダンジョンフラグ:49:0 == 0
		PRINTW 扉の向こうから邪気を感じる
		PRINTL 扉を開けるか？
		PRINTL 
		CALL INPUT_YN
		IF RESULT == 0
			CALL DUNGEON_DOOR,ARG
		ELSEIF RESULT == 1
			FLAG:現Y = 10
		ENDIF
	ELSEIF FLAG:現M == 6 && FLAG:現X == 10 && FLAG:現Y == 8 && ダンジョンフラグ:49:4 == 1
		PRINTW 鍵を外した。
		ダンジョンフラグ:49:4 = 2
		CALL DUNGEON_DOOR,ARG
	ELSE
		CALL DUNGEON_DOOR,ARG
	ENDIF
	RETURN 1

;==========
;ターミナル　タイル侵入
;==========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 9
	SELECTCASE FLAG:現M
		CASE 0
			;☆デバック用
			;SIF FLAG:現X == 10 && FLAG:現Y == 2
			;	CALL DUNGEON_WORP,2,4,1
			SIF FLAG:現X == 19 && FLAG:現Y == 4
				CALL DUNGEON_WORP,1,1,4
			SIF FLAG:現X == 19 && FLAG:現Y == 6
				CALL DUNGEON_WORP,1,1,6
			SIF FLAG:現X == 19 && FLAG:現Y == 17
				CALL DUNGEON_WORP,1,1,17
		CASE 1
			SIF FLAG:現X == 0 && FLAG:現Y == 4
				CALL DUNGEON_WORP,0,18,4
			SIF FLAG:現X == 0 && FLAG:現Y == 6
				CALL DUNGEON_WORP,0,18,6
			SIF FLAG:現X == 0 && FLAG:現Y == 17
				CALL DUNGEON_WORP,0,18,17
			;本館
			SIF FLAG:現X == 4 && FLAG:現Y == 13
				CALL DUNGEON_WORP,2,14,4
		;校内一階　西
		CASE 2
			;☆デバック用
			;SIF FLAG:現X == 3 && FLAG:現Y == 1
			;	CALL DUNGEON_WORP,7,18,10
			;校外
			SIF FLAG:現X == 14 && FLAG:現Y == 2
				CALL DUNGEON_WORP,1,4,11
			SIF FLAG:現X == 19 && FLAG:現Y == 7
				CALL DUNGEON_WORP,3,1,7
			;ターミナル
			SIF FLAG:現X == 14 && FLAG:現Y == 7
				CALL DUNGEON_TERMINAL
		;校内一階　東
		CASE 3
			SIF FLAG:現X == 0 && FLAG:現Y == 7
				CALL DUNGEON_WORP,2,18,7
		;校内ニ階　西
		CASE 4
			SIF FLAG:現X == 19 && FLAG:現Y == 3
				CALL DUNGEON_WORP,5,1,3
			SIF FLAG:現X == 19 && FLAG:現Y == 7
				CALL DUNGEON_WORP,5,1,7
		;校内ニ階　東
		CASE 5
			SIF FLAG:現X == 0 && FLAG:現Y == 3
				CALL DUNGEON_WORP,4,18,3
			SIF FLAG:現X == 0 && FLAG:現Y == 7
				CALL DUNGEON_WORP,4,18,7
		;校内四階　東
		CASE 7
			SIF FLAG:現X == 0 && FLAG:現Y == 6
				CALL DUNGEON_WORP,8,6,6
			;ターミナル
			SIF FLAG:現X == 16 && FLAG:現Y == 7
				CALL DUNGEON_TERMINAL
		;校内四階　西
		CASE 8
			SIF FLAG:現X == 7 && FLAG:現Y == 6
				CALL DUNGEON_WORP,7,1,6
		CASEELSE
	ENDSELECT
	RETURN 1
ENDIF
RETURN 0


