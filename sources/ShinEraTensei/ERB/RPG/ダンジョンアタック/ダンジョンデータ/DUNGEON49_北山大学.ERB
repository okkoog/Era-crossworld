;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_49,ARG
IF ダンジョンフラグ:49:0 == 0
	FLAG:現M = 0
	FLAG:現X = 10
	FLAG:現Y = 0
ELSEIF ダンジョンフラグ:49:0 == 1
	FLAG:現M = 11
	FLAG:現X = 7
	FLAG:現Y = 0
ENDIF
;CALL AUTOMAP

;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_49
IF ダンジョンフラグ:49:1 == 0
	CUSTOMDRAWLINE =
	PRINTFORMW 北山大学の異界化調査依頼を持ってきたマヨーネは%CALLNAME:MASTER%にこう告げた
	PRINTFORMW 「図書館、北山大学、一連の異界化にはうちの組織の人物が関わっていますわ」
	PRINTFORMW 「貴方の任務は火急的速やかに彼に接触し、本件へのヤタガラスの介入により組織は手を引くと伝える事」
	PRINTFORMW 「彼の名はシド・デイビス……黒人の神父と出会ったら戦おうなどと考えない事ね」
	ダンジョンフラグ:49:1 = 1
ENDIF

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_49,ARG,ARG:1
IF FLAG:現M == 6 && ARG == 9 && ARG:1 == 8 && ダンジョンフラグ:49:4 >= 0 && ダンジョンフラグ:49:4 < 2 
	ダンジョンフラグ:49:4 = 1
ELSEIF FLAG:現M == 6 && ARG == 10 && ARG:1 == 8 && ダンジョンフラグ:49:4 == 0
	PRINTW 反対側から鍵がかけられているようだ
	CLEARLINE 1
	RETURN 0
ELSEIF FLAG:現M == 7 && ARG == 10 && ARG:1 == 7
	IF ダンジョンフラグ:49:3 == 1 || FLAG:DEBUG
		RETURN 1
	ELSE
		PRINTW 扉は不思議な力で閉ざされている
		RETURN 0
	ENDIF
ENDIF

CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT
