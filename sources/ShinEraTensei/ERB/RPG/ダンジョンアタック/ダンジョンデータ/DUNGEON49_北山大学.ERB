;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_49

;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 3
	CALL TRESURING_CALLING_49
	RETURN 1
;==========
;イベントの処理
;==========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 4
	CALL EVENTING_CALLING_49
	RETURN 1
;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 6
	SELECTCASE FLAG:現M
		;一階西
		CASE 2
			SIF FLAG:現X == 3 && FLAG:現Y == 3
				CALL DUNGEON_UPSTAIRS,10,3,3
		;一階東
		CASE 3
			SIF FLAG:現X == 9 && FLAG:現Y == 5
				CALL DUNGEON_UPSTAIRS,5,9,5
		;二階西
		CASE 4
			SIF FLAG:現X == 6 && FLAG:現Y == 5
				CALL DUNGEON_UPSTAIRS,6,5,7
		;二階東
		CASE 5
			SIF FLAG:現X == 9 && FLAG:現Y == 3
				CALL DUNGEON_UPSTAIRS,6,16,8
		;三階
		CASE 6
			SIF FLAG:現X == 3 && FLAG:現Y == 7
				CALL DUNGEON_UPSTAIRS,7,7,7
		;別館三階
		CASE 9
			SIF FLAG:現X == 5 && FLAG:現Y == 3
				CALL DUNGEON_UPSTAIRS,8,2,5
		;別館ニ階
		CASE 10
			SIF FLAG:現X == 5 && FLAG:現Y == 3
				CALL DUNGEON_UPSTAIRS,9,3,3
		CASEELSE
	ENDSELECT
	RETURN 1

ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 7
	SELECTCASE FLAG:現M
		;二階東
		CASE 5
			SIF FLAG:現X == 9 && FLAG:現Y == 5
				CALL DUNGEON_DOWNSTAIRS,3,9,5
		;三階
		CASE 6
			;三階東
			SIF FLAG:現X == 16 && FLAG:現Y == 8
				CALL DUNGEON_DOWNSTAIRS,5,9,3
			;三階西
			SIF FLAG:現X == 5 && FLAG:現Y == 7
				CALL DUNGEON_DOWNSTAIRS,4,6,5
		;本館四階　東
		CASE 7
			SIF FLAG:現X == 7 && FLAG:現Y == 7
				CALL DUNGEON_DOWNSTAIRS,6,3,7
		;本館四階　西
		CASE 8
			SIF FLAG:現X == 2 && FLAG:現Y == 5
				CALL DUNGEON_DOWNSTAIRS,9,5,3
		;別館三階
		CASE 9
			SIF FLAG:現X == 3 && FLAG:現Y == 3
				CALL DUNGEON_DOWNSTAIRS,10,5,3
		;別館ニ階
		CASE 10
			SIF FLAG:現X == 3 && FLAG:現Y == 3
				CALL DUNGEON_DOWNSTAIRS,2,3,3
		CASEELSE
	ENDSELECT
	RETURN 1


;==========
;ターミナル　調べる
;==========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 9
	SELECTCASE FLAG:現M
		;校内一階　西
		CASE 2
			;ターミナル
			SIF FLAG:現X == 14 && FLAG:現Y == 7
				CALL DUNGEON_TERMINAL
				RETURN 1
		CASEELSE
	ENDSELECT
	RETURN 1
ELSE
	PRINTW 何も無いようだ
	RETURN 0
ENDIF

