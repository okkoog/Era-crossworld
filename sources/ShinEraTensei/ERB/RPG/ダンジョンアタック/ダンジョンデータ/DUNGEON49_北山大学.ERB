;ダンジョンフラグ:49:5 = 1.ジャンク

;ダンジョンナンバー49
;=======================================================================

;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_49
;教授宅襲撃クリア
SIF (依頼フラグ:5:0 == 1 || FLAG:DEBUG) && ダンジョンフラグ:49:0 == 0 && BASE:MASTER:LV >= 21
	RETURN 1
RETURN 0

;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_49
RESULTS = 北山大学


;=======================================================================
;フロア名表示
;=======================================================================
@FLOORNAME_49
PRINT 北山大学
SELECTCASE FLAG:現M
	CASE 0
		PRINTL   校外西
	CASE 1
		PRINTL   校外東
	CASE 2
		PRINTL   本館１Ｆ西
	CASE 3
		PRINTL   本館１Ｆ東
	CASE 4
		PRINTL   本館２Ｆ西
	CASE 5
		PRINTL   本館２Ｆ東
	CASE 6
		PRINTL   本館３Ｆ
	CASE 7
		PRINTL   本館４Ｆ
	CASE 8
		PRINTL   別館４Ｆ
	CASE 9
		PRINTL   別館３Ｆ
	CASE 10
		PRINTL   別館２Ｆ
	CASE 11
		PRINTL   本館１Ｆ
	CASE 12
		PRINTL   本館２Ｆ
	CASEELSE
		PRINTL
ENDSELECT


