;シキオウジの思考パターン
@SET_ACTION_661,ARG
;1more
IF CFLAG:ARG:１moreフラグ == 2
	IF RAND:2 == 0
		;暴れまくり
		CALL CHECK_ACTIONABLE,ARG,203
		SIF RESULT == 0
			GOTO DECIDE_ACTION
		CFLAG:ARG:入力行動 = 203
		CALL RANDOM_TARGET,ARG,203
		RETURN 1
	ELSE
		;アラクノワイヤー
		CALL CHECK_ACTIONABLE,ARG,1124
		SIF RESULT == 0
			GOTO DECIDE_ACTION
		CFLAG:ARG:入力行動 = 1124
		CALL RANDOM_TARGET,ARG,1124
		RETURN 1
	ENDIF
ELSEIF CFLAG:ARG:行動した回数 == 0
	IF RAND:2 == 0
		CALL CHECK_ACTIONABLE,ARG,1124
		SIF RESULT == 0
			GOTO DECIDE_ACTION
		CFLAG:ARG:入力行動 = 1124
		CALL RANDOM_TARGET,ARG,1124
		RETURN 1
	ELSE
		CALL CHECK_ACTIONABLE,ARG,602
		SIF RESULT == 0
			GOTO DECIDE_ACTION
		CFLAG:ARG:入力行動 = 602
		CALL RANDOM_TARGET,ARG,602
		RETURN 1
	ENDIF
ELSEIF CFLAG:ARG:行動した回数 == 1
	SELECTCASE RAND:100
		;50％でアラクノワイヤー
		CASE IS < 50
			CALL CHECK_ACTIONABLE,ARG,1124
			SIF RESULT == 0
				GOTO DECIDE_ACTION
			CFLAG:ARG:入力行動 = 1124
			CALL RANDOM_TARGET,ARG,1124
			RETURN 1
		;30％で暴れまくり
		CASE IS < 80
			CALL CHECK_ACTIONABLE,ARG,203
			SIF RESULT == 0
				GOTO DECIDE_ACTION
			CFLAG:ARG:入力行動 = 203
			CALL RANDOM_TARGET,ARG,203
			RETURN 1
		;20％で通常攻撃
		CASE IS < 100
			CALL CHECK_ACTIONABLE,ARG,0
			SIF RESULT == 0
				GOTO DECIDE_ACTION
			CFLAG:ARG:入力行動 = 0
			CALL RANDOM_TARGET,ARG,0
			RETURN 1
	ENDSELECT
ELSE
	$DECIDE_ACTION
	CALL SEARCH_ACT,ARG
	IF RESULT == 0
		CFLAG:ARG:入力行動 = -1
		CFLAG:ARG:防御フラグ = 1
		RETURN 0
	ENDIF
;	PRINTFORML [{CFLAG:ARG:5}]のスキル数 {RESULT}
	LOCAL = RAND:RESULT
	;スキル番号決定
	LOCAL:1 = S:(10+LOCAL)
;	PRINTFORML [{CFLAG:ARG:5}]のスキル {LOCAL:1}
	$TARGET_LOOP
	
	CALL RANDOM_TARGET,ARG,LOCAL:1
	CALLFORM SKILL_TARGET_{LOCAL:1}
	;ここでスキル番号を行動内容に代入
	SIF CFLAG:ARG:ターゲット == -1
		GOTO DECIDE_ACTION
	CFLAG:ARG:入力行動 = LOCAL:1
ENDIF

