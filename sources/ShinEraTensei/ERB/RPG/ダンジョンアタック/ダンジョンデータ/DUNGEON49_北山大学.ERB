;==========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 4
	CALL EVENTING_CALLING_49
	RETURN 1

;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) == 6
	SELECTCASE FLAG:現M
		;一階西
		CASE 2
			SIF FLAG:現X == 3 && FLAG:現Y == 3
				CALL DUNGEON_UPSTAIRS,10,3,3
		;一階東
		CASE 3
			SIF FLAG:現X == 9 && FLAG:現Y == 5
				CALL DUNGEON_UPSTAIRS,5,9,5
		;二階西
