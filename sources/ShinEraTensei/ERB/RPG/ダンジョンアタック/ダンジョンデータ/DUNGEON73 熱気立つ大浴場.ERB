RETURN 0


;=======================================================================
;エンカウント率
;=======================================================================
@ENCOUNT_RATE_73
SELECTCASE FLAG:現M
	CASE 0
		FLAG:エンカウント率 = FLAG:未遭遇歩数*5
	CASE 1
		FLAG:エンカウント率 = FLAG:未遭遇歩数*5
	CASE 2
		FLAG:エンカウント率 = FLAG:未遭遇歩数*5
	CASE 3
		FLAG:エンカウント率 = FLAG:未遭遇歩数*5
	CASE 4
		FLAG:エンカウント率 = FLAG:未遭遇歩数*5
	CASE 5
		FLAG:エンカウント率 = 10 + FLAG:未遭遇歩数*5
	CASE 6
		FLAG:エンカウント率 = 10 + FLAG:未遭遇歩数*5
	CASEELSE
		FLAG:エンカウント率 = FLAG:未遭遇歩数*5
ENDSELECT

