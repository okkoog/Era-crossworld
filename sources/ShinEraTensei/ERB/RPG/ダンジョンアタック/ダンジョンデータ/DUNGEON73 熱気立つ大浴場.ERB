;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_73

;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
;% 10は10で割ったあまり、つまり下一桁がでてきます
;そして、下一桁はタイルの種類を表す
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 3
	CALL TREASURE_73
	RETURN RESULT
;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 6
	CALL UPSTAIRS_73
	RETURN RESULT

ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 7
	CALL DOWNSTAIRS_73
	RETURN RESULT
ELSEIF DA:(FLAG:現X):(FLAG:現Y) %10 == 9
	SELECTCASE DA:(FLAG:現X):(FLAG:現Y) /10
	CASE 0
		CALL DUNGEON_TERMINAL
		RETURN 1
	ENDSELECT
ELSE
	PRINTW 何も無いようだ
	RETURN 0
ENDIF






;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_73,ARG
;ARG = 進入時の向き　0の場合ワープなど
;==========
;出口の処理
;==========
IF DA:(FLAG:現X):(FLAG:現Y) % 10 == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 3
	CALL TREASURE_73
	RETURN RESULT
;=======
;階段
;=======
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 6
	CALL UPSTAIRS_73
	RETURN RESULT

ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 7
	CALL DOWNSTAIRS_73
	RETURN RESULT

;==========
;扉の処理
;==========
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 2
	CALL DUNGEON_DOOR,ARG
	RETURN 1
;========================
;イベント
;========================
ELSEIF DA:(FLAG:現X):(FLAG:現Y) % 10 == 4
	SELECTCASE DA:(FLAG:現X):(FLAG:現Y) /10
		CASE 1
			CUSTOMDRAWLINE =
			PRINTL ふんどし姿でガニ股の男が目を血走らせて立っている
			PRINTW 
			PRINTW 「ようこそ、男の世界へ！」
			IF TALENT:MASTER:140 == 0 || TALENT:MASTER:157 == 1
				PRINTL 「突然のバッドガールの参入で会場は大ブーイング！」
				PRINTW 「およびじゃないガールを追い出すため、今宵は特別なステージを用意しました！」
			ELSE
				PRINTL 「突然のナイスボーイの参入で会場もヒートアップ！」
				PRINTW 「ナイスカミングなボーイとの出会いを祝い、今宵は特別なステージを用意しました！」
			ENDIF
			PRINTW
			PRINTL 「時間無制限一本勝負！果たして最後に立ってるのはどちらだ？」
			PRINTW 「さあ、熱い血潮をぶちまけておくれ！」
				FLAG:逃走不可フラグ = 1
				FLAG:会話不能フラグ = 1
				FLAG:先制不意打ちキャンセル = 1
				CUSTOMDRAWLINE =
				WAIT
				CALL SET_ENEMY,9,3269,30,0,1
				CFLAG:(CHARANUM-1):行動回数 = 2
				CFLAG:(CHARANUM-1):ＨＰ補正 = 500
				MAXBASE:(CHARANUM-1):破魔 = 0
				MAXBASE:(CHARANUM-1):呪殺 = 0
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				CALL BATTLE_START
				FLAG:逃走不可フラグ = 0
				FLAG:会話不能フラグ = 0
				FLAG:先制不意打ちキャンセル = 0
				WAIT
			PRINTL
			PRINTL ＞不気味なシャドウを倒した
			PRINTW 
			ダンジョンフラグ:73:7 = 1
			DA:(FLAG:現X):(FLAG:現Y) = 1
			RETURN 1
		CASE 2
			CUSTOMDRAWLINE =
			PRINTW 部屋の中央で同じ顔をした二人の男が立っている。
			PRINTL 「女は嫌いだ！」
			PRINTL 「偉そうで、我がままで、怒れば泣く、陰口は言う、チクる、試す、化ける…」
			PRINTL 「気持ち悪いモノみたいにボクを見て、変人、変人ってさ…」
			PRINTL 「で、笑いながらこう言うんだ。」
			PRINTW 
			PRINTL 「裁縫好きなんて、気持ち悪い、絵を描くなんて、似合わない」
			PRINTW 「男のくせに…男のくせに…男のくせに…！」
			PRINTL 「女は怖いよなぁ…」
			PRINTW 
			PRINTL 「違う…違う、違う！」
			PRINTW 「テメェみてぇのが…オレなもんかよ！！」
			PRINTL 
			PRINTW  ＞目を怪しく光らせている男の様子がおかしい。
			PRINTW 「ふふ…ふふふふふ…ボクはキミ、キミさァァ！！」
			PRINTW 
				FLAG:逃走不可フラグ = 1
				FLAG:会話不能フラグ = 1
				FLAG:先制不意打ちキャンセル = 1
				CUSTOMDRAWLINE =
				WAIT
				CALL SET_ENEMY,9,3266,35,0,1
				CFLAG:(CHARANUM-1):行動回数 = 2
				CFLAG:(CHARANUM-1):ＨＰ補正 = 1000
				MAXBASE:(CHARANUM-1):破魔 = 0
				MAXBASE:(CHARANUM-1):呪殺 = 0
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				
				CALL SET_ENEMY,8,3267,35,0,1
				MAXBASE:(CHARANUM-1):破魔 = 0
				MAXBASE:(CHARANUM-1):呪殺 = 0
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				
				CALL SET_ENEMY,10,3268,35,0,1
				MAXBASE:(CHARANUM-1):破魔 = 0
				MAXBASE:(CHARANUM-1):呪殺 = 0
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				CALL BATTLE_START
				FLAG:逃走不可フラグ = 0
				FLAG:会話不能フラグ = 0
				FLAG:先制不意打ちキャンセル = 0
				WAIT
			PRINTL 「イクぅぅぅぅぅぅ～…」
			PRINTL 
			PRINTW 完二のシャドウを倒した。
			PRINTL 化け物が居た場所に男子生徒が倒れている。
			PRINTW 連れて帰りますか？
			CALL INPUT_YN
			IF RESULT == 1
			;NO
				PRINTL 男子生徒を放置することにした。
			ELSE
				PRINTL 男子生徒を連れて帰ることにした。
				PRINTW 巽 完二を奴隷にした
				CALL ADD_NEW_COMPANION,4565,200
			ENDIF
			ダンジョンフラグ:73:8 = 1
			FLAG:脱出 = 1
			RETURN 1
		CASE 3
			PRINTW ＞怪しい儀式が行われている……
			PRINTL 
			PRINTL 「くそくそくそくそ！」
			PRINTL 「みんなボクたちに処女じゃないからってバカにして！」
			PRINTL 「こうなったら『ごりっぱな悪魔』を召喚して、処女膜なんかケチョンケチョンだ！」
			PRINTW 
			PRINTL 「……そうです、その通りです！」
			PRINTL 「トットと、あの『ごりっぱな悪魔』を召喚してください！」
			PRINTL 「ごりっぱなマーラ様を召喚してください！……ありがたやー。」
			PRINTW 
			PRINTL ＞シャドウたちは収まりがつかないようだ。
			PRINTL 　どうやら自分たちが気に入られないのは処女膜が無いせいだと思っているらしい。
			PRINTL 　そんな中、中央にいるバフォメットが口を開いた。
			PRINTW 
			PRINTL 「……フッフッフッ、先ほどから申し上げている通り、まだ召喚のときではなーいのです。」
			PRINTL 「『マーラ様』はごりっぱな悪魔…」
			PRINTL 「万全を期して召喚に臨まねば、恐ろしい事態を引き起こーすでしょう。」
			PRINTW 
			PRINTL 「なに言ってるんだ、はやくしろ！」
			PRINTL 「処女膜がある奴らなんて、一秒でも生かしておけないよ！」
			PRINTW 
			PRINTL 勝手なことを言っていたシャドウたちはあなたに気がついたようだ。
				IF TALENT:MASTER:140 == 0 || TALENT:MASTER:157 == 1
					PRINTL 「ひょえぇぇぇぇぇ！し、し、し、処女だぁぁぁぁぁぁ！！」
					PRINTW 「早く『マーラ様』を召喚してメッタメタにぃぃぃぃぃい」
				ELSE
					PRINTL 「そこのサマナーのオニイサン、アンタからも言ってやれ。」
					PRINTW 「早く『マーラ様』を召喚して、ボクたちを楽にしろと！」
				ENDIF
			PRINTW 
			PRINTL 「どうなっても、知りませーんよ？」
			PRINTL そう言うとバフォメットは怪しげな呪文を唱え始めた
			PRINTW 
			PRINTL 「……慌てたあまり、スライムに近い不完全な状態のマーラ様を召喚してしまーった。」
			PRINTL 「ひえぇぇぇぇぇぇぇ！し、し、し、失敗だぁぁぁぁぁ！！」
			PRINTL 
			PRINTL …ググ…ギ……………オマ…エラ……
			PRINTL …ギ……グギ………ガ…ヨク…モ……
			PRINTW 
				FLAG:逃走不可フラグ = 1
				FLAG:会話不能フラグ = 1
				FLAG:先制不意打ちキャンセル = 1
				CALL SET_ENEMY,9,259,50,0,1
				CFLAG:(CHARANUM-1):ＨＰ補正 = 2000
				CFLAG:(CHARANUM-1):行動回数 = 2
				MAXBASE:(CHARANUM-1):破魔 = 0
				MAXBASE:(CHARANUM-1):呪殺 = 0
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				CALL BATTLE_START
				FLAG:逃走不可フラグ = 0
				FLAG:会話不能フラグ = 0
				FLAG:先制不意打ちキャンセル = 0
				WAIT
