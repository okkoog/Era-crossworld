	SELECTCASE ARGS
		CASE "装備箇所" , "購入条件" , "装備条件説明" , "必要レベル"
			TRYCALLFORM %ARGS%_{ARG}
		CASE "基本能力修正" , "戦闘能力修正" , "防御相性" , "バステ耐性"
