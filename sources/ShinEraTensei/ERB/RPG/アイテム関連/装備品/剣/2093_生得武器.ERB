@基本能力修正_2093,ARG,ARG:1 = -1
SELECTCASE ARG
ENDSELECT
RETURN 0


@戦闘能力修正_2093,ARG,ARG:1 = -1
IF ARG:1 == -1
	SELECTCASE ARG
		CASE 0
			RETURN 24
		CASE 1
			RETURN 31
		CASE 4
			RETURN 20
		CASE 5
			RETURN 8
	ENDSELECT
ELSE
	SELECTCASE ARG
		CASE 0
			RETURN (MAXBASE:(ARG:1):LV)*3/2 + MAXBASE:(ARG:1):力 * 3/ 2 + MAXBASE:(ARG:1):耐力 / 2
		CASE 1
			RETURN (MAXBASE:(ARG:1):LV) + MAXBASE:(ARG:1):速さ * 3/ 2 + MAXBASE:(ARG:1):運 / 2
		CASE 4
			RETURN (MAXBASE:(ARG:1):LV)*3/2 + MAXBASE:(ARG:1):魔力 * 3/ 2 + MAXBASE:(ARG:1):知恵 / 2
		CASE 5
			RETURN ((MAXBASE:(ARG:1):LV) + MAXBASE:(ARG:1):知恵 + MAXBASE:(ARG:1):魔力 / 2 + MAXBASE:(ARG:1):運 / 2)/2
	ENDSELECT
ENDIF
RETURN 0

