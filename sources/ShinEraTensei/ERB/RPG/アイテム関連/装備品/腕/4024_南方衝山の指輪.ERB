@基本能力修正_4024,ARG,ARG:1 = -1
;1.力　2.知恵　3.魔力　4.耐力　5.速さ　6.運
SELECTCASE ARG
	CASE 1
		IF ARG:1 > -1
			IF EQUIP:(ARG:1):頭 == 3031 && EQUIP:(ARG:1):胴 == 3542 && EQUIP:(ARG:1):腕 == 4024 && EQUIP:(ARG:1):足 == 4527
				;力+4
				RETURN 4
			ELSE
				RETURN 0
			ENDIF
		ELSE
			RETURN 0
		ENDIF
	CASE 6
		IF ARG:1 > -1
			IF EQUIP:(ARG:1):頭 == 3031 && EQUIP:(ARG:1):胴 == 3542 && EQUIP:(ARG:1):腕 == 4024 && EQUIP:(ARG:1):足 == 4527
				;運+2
				RETURN 2
			ELSE
				RETURN 0
			ENDIF
		ELSE
			RETURN 0
		ENDIF
ENDSELECT
RETURN 0

