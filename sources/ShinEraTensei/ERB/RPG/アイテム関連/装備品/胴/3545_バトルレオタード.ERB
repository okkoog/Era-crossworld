@戦闘能力修正_3545,ARG,ARG:1 = -1

SELECTCASE ARG
	;防御25
	CASE 2
		RETURN 22
	;回避20
	CASE 3
		IF ARG:1 > -1
			SELECTCASE ABL:(ARG:1):露出癖
				CASE 0
					RETURN -5
				CASE 1
					RETURN 0
				CASE IS < 4
					IF EQUIP:(ARG:1):頭 == 3004 && EQUIP:(ARG:1):足 == 4528
						RETURN 16
					ELSE
						RETURN 11
					ENDIF
				CASEELSE
					IF EQUIP:(ARG:1):頭 == 3004 && EQUIP:(ARG:1):足 == 4528
						RETURN 21
					ELSE
						RETURN 16
					ENDIF
			ENDSELECT
		ELSE
			RETURN 11
		ENDIF
	CASE 5
		RETURN 3
ENDSELECT
RETURN 0
