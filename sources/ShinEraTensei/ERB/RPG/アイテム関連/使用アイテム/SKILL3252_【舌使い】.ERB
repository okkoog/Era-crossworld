
;スキル名
@SKILL_NAME_3252,ARG
RESULTS = 【舌使い】


;　命中
@SKILL_HITRATE_3252, ARG
RETURN 100

;　威力
@SKILL_POWER_3252, ARG
RETURN 0

;　最低攻撃回数
@SKILL_MINATTACKNUMBER_3252,ARG
RETURN 1

;　最大攻撃回数
@SKILL_MAXATTACKNUMBER_3252,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3252, ARG
RETURN 1
;消費なし＝1

;　コストの量
@SKILL_COST_3252,ARG
RETURN 0

;　相性
@SKILL_TYPE_3252,ARG
RETURN 0

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3252
RETURN 0
;魔法

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3252
RETURN 2


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3252
RETURN 4

;　射程
@SKILL_RANGE_3252,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3252,ARG
RETURN 4

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_3252
RETURN 2

;　 特殊処理の有無、及び処理内容
@SKILL_SPECIALEFECT_3252,ARG
;ARG = 1だった場合は処理の有無を返します
SIF ARG == 1
	RETURN 0
;以下に特殊な処理を記述します

;継承タイプ
@SKILL_SUCCESSION_TYPE_3252
RETURN 0
;継承不可

;速度補正
@SKILL_SPEED_3252, ARG = -1
RETURN 0

;　口上の表示とそのタイプ
@SKILL_MESSAGE_3252,ARG

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3252
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_3252
RETURN 0
;変化不可

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3252,ARG,ARG:1
ITEM:1252 -= 1
PRINTFORMW %CALLNAME:MASTER%は【舌使い】を得た
TALENT:MASTER:舌使い = 1
IF RAND:6 == 0
BASE:MASTER:力 -= 1
PRINTFORMW %CALLNAME:MASTER%の力が１下がった
ELSEIF RAND:5 == 0
BASE:MASTER:知恵 -= 1
PRINTFORMW %CALLNAME:MASTER%の知恵が１下がった
ELSEIF RAND:4 == 0
BASE:MASTER:魔力 -= 1
PRINTFORMW %CALLNAME:MASTER%の魔力が１下がった
ELSEIF RAND:3 == 0
BASE:MASTER:耐力 -= 1
PRINTFORMW %CALLNAME:MASTER%の耐力が１下がった
ELSEIF RAND:2 == 0
BASE:MASTER:速さ -= 1
PRINTFORMW %CALLNAME:MASTER%の速さが１下がった
ELSE
BASE:MASTER:運 -= 1
PRINTFORMW %CALLNAME:MASTER%の運が１下がった
ENDIF


;====================================================
;実行内容ここまで
;====================================================


;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_3252,ARG,ARG:1
ITEM:1252 -= 1
LOCAL = MAXBASE:MASTER:ＨＰ
PRINTFORML %ITEMNAME:1252%を使った。
PRINTFORMW %CALLNAME:MASTER%は【舌使い】を得た
TALENT:MASTER:舌使い = 1
IF RAND:6 == 0
BASE:MASTER:力 -= 1
PRINTFORMW %CALLNAME:MASTER%の力が１下がった
ELSEIF RAND:5 == 0
BASE:MASTER:知恵 -= 1
PRINTFORMW %CALLNAME:MASTER%の知恵が１下がった
ELSEIF RAND:4 == 0
BASE:MASTER:魔力 -= 1
PRINTFORMW %CALLNAME:MASTER%の魔力が１下がった
ELSEIF RAND:3 == 0
BASE:MASTER:耐力 -= 1
PRINTFORMW %CALLNAME:MASTER%の耐力が１下がった
ELSEIF RAND:2 == 0
BASE:MASTER:速さ -= 1
PRINTFORMW %CALLNAME:MASTER%の速さが１下がった
ELSE
BASE:MASTER:運 -= 1
PRINTFORMW %CALLNAME:MASTER%の運が１下がった
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3252
PRINTL 主人が【舌使い】を取得する薬。
PRINTL 副作用で能力のどれかが１下がる。

@最大所持数_3252
RETURN 1

@道具購入条件_3252
RETURN 0

;使用条件
@SKILL_SPECIAL_ACTIONABLE_3252,ARG
SIF CFLAG:ARG:PTフラグ > 0 && (ITEM:1252 < 1 || CFLAG:ARG:アイテム使用能力 < 1)
	RETURN 0
SIF BASE:MASTER:力 == 1 || BASE:MASTER:知恵 == 1 || BASE:MASTER:魔力 == 1 || BASE:MASTER:耐力 == 1 || BASE:MASTER:速さ == 1 || BASE:MASTER:運 == 1
	RETURN 0
RETURN 1
;アイテムの個数チェック



;魔貨交換可能か
@ITEM_EXCHANGE_3252
SIF FLAG:奴隷売却総数 < 100 || TALENT:MASTER:舌使い == 1
	RETURN 0
RETURN 1

