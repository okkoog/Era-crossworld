;　口上の表示とそのタイプ
@SKILL_MESSAGE_3016,ARG

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3016
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_3016
RETURN 0
;変化不可

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3016,ARG,ARG:1
SIF CFLAG:ARG:PTフラグ > 0
ITEM:1016 -= 1

FOR LOCAL:9,0,CHARANUM
	SIF CFLAG:ARG:PTフラグ == 0 && CFLAG:(LOCAL:9):PTフラグ > 0
		CONTINUE
	SIF CFLAG:ARG:PTフラグ == 2 && CFLAG:(LOCAL:9):PTフラグ == 0
		CONTINUE
	PRINTFORM 　　TARGET:[{CPOS(LOCAL:9),2}] %CALLNAME:(LOCAL:9),20,LEFT%　>>>>>>　
	;回復量
	LOCAL = MAXBASE:(LOCAL:9):ＨＰ
	PRINTFORMW {LOCAL}回復
	CALL VAR_HP,LOCAL:9,LOCAL,3
	CFLAG:(LOCAL:9):ステート = 0
NEXT
	CALL DEAD_CHARA,ARG


;====================================================
;実行内容ここまで
;====================================================


;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_3016,ARG,ARG:1
ITEM:1016 -= 1
PRINTFORML %ITEMNAME:1016%を使った。

FOR LOCAL:9,0,CHARANUM
	
	SIF LOCAL:9 == 0
		CONTINUE
	PRINTFORM 　　TARGET:[{CPOS(LOCAL:9),2}] %CALLNAME:(LOCAL:9),20,LEFT%　>>>>>>　
	;回復量
	LOCAL = MAXBASE:(LOCAL:9):ＨＰ
	PRINTFORMW {LOCAL}回復
	CALL VAR_HP,LOCAL:9,LOCAL,3
	CFLAG:(LOCAL:9):ステート = 0
NEXT
	CALL DEAD_CHARA,ARG

;====================================================
;実行内容ここまで
;====================================================

