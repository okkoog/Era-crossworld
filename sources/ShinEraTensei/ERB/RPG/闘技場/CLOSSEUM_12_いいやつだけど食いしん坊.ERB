CUSTOMDRAWLINE =
WAIT
FLAG:逃走不可フラグ = 0
FLAG:会話不能フラグ = 0
FLAG:先制不意打ちキャンセル = 0
PRINTW ￥250000を賞金として受け取った
MONEY += 250000
PRINTFORMW %CALLNAME:MASTER%は420の名声を得た
FLAG:名声 += 420
闘技場フラグ:12:0 = 1


FOR LOCAL,0,CHARANUM
	CALL HEALTH_CHARA,LOCAL
NEXT


@SET_ACTION_モーラ, ARG
IF FLAG:経過ターン数 % 10 == 9
	IF CFLAG:ARG:行動した回数 == 0
		CFLAG:(CHARANUM-1):速度補正 = 24
		CALL CHECK_ACTIONABLE,ARG,403
		SIF RESULT == 0
			GOTO DECIDE_ACTION
		CFLAG:ARG:入力行動 = 403
		CALL RANDOM_TARGET,ARG,403
		RETURN 1
	ELSEIF CFLAG:ARG:行動した回数 == 1
		CFLAG:(CHARANUM-1):速度補正 = 0
		CALL CHECK_ACTIONABLE,ARG,326
			SIF RESULT == 0
				GOTO DECIDE_ACTION
		CFLAG:ARG:入力行動 = 326
		CALL RANDOM_TARGET,ARG,326
		RETURN 1
	ENDIF
ELSEIF CFLAG:ARG:気合フラグ
	IF RAND:2 == 0
		CALL CHECK_ACTIONABLE,ARG,326
			SIF RESULT == 0
				GOTO DECIDE_ACTION
		CFLAG:ARG:入力行動 = 326
		CALL RANDOM_TARGET,ARG,326
		RETURN 1
	ELSE
		CALL CHECK_ACTIONABLE,ARG,0
		SIF RESULT == 0
			GOTO DECIDE_ACTION
		CFLAG:ARG:入力行動 = 0
		CALL RANDOM_TARGET,ARG,0
		RETURN 1
	ENDIF
ELSEIF CFLAG:ARG:魔法反射フラグ
	IF RAND:2 == 0
		CALL CHECK_ACTIONABLE,ARG,1603
			SIF RESULT == 0
				GOTO DECIDE_ACTION
		CFLAG:ARG:入力行動 = 1603
		CALL RANDOM_TARGET,ARG,1603
		RETURN 1
	ELSE
		CALL CHECK_ACTIONABLE,ARG,1606
		SIF RESULT == 0
			GOTO DECIDE_ACTION
		CFLAG:ARG:入力行動 = 1606
		CALL RANDOM_TARGET,ARG,1606
		RETURN 1
	ENDIF
ELSEIF CFLAG:ARG:攻撃強化 < 0 || CFLAG:ARG:防御強化 < 0 || CFLAG:ARG:命中強化 < 0
	IF RAND:2 == 0
		CALL CHECK_ACTIONABLE,ARG,505
			SIF RESULT == 0
				GOTO DECIDE_ACTION
		CFLAG:ARG:入力行動 = 505
		CALL RANDOM_TARGET,ARG,505
		RETURN 1
	ELSE
		GOTO DECIDE_ACTION
		RETURN 1
	ENDIF
ELSEIF CFLAG:MASTER:攻撃強化 > 3 || CFLAG:MASTER:防御強化 > 3 || CFLAG:MASTER:命中強化 > 3
	IF RAND:2 == 0
		CALL CHECK_ACTIONABLE,ARG,509
			SIF RESULT == 0
				GOTO DECIDE_ACTION
		CFLAG:ARG:入力行動 = 509
		CALL RANDOM_TARGET,ARG,509
		RETURN 1
	ELSE
		GOTO DECIDE_ACTION
		RETURN 1
	ENDIF
ELSEIF CFLAG:MASTER:攻撃強化 > -9
	IF RAND:3 == 0
		CALL CHECK_ACTIONABLE,ARG,514
			SIF RESULT == 0
				GOTO DECIDE_ACTION
		CFLAG:ARG:入力行動 = 514
		CALL RANDOM_TARGET,ARG,505
		RETURN 1
	ELSE
		GOTO DECIDE_ACTION
		RETURN 1
	ENDIF
ELSE
	$DECIDE_ACTION
	CALL SEARCH_ACT,ARG
	IF RESULT == 0
		CFLAG:ARG:入力行動 = -1
		CFLAG:ARG:防御フラグ = 1
		RETURN 0
	ENDIF
	LOCAL = RAND:RESULT
	;スキル番号決定
	LOCAL:1 = S:(10+LOCAL)
	$TARGET_LOOP
	
	CALL RANDOM_TARGET,ARG,LOCAL:1
	CALLFORM SKILL_TARGET_{LOCAL:1}
	;ここでスキル番号を行動内容に代入
	SIF CFLAG:ARG:ターゲット == -1
		GOTO DECIDE_ACTION
	CFLAG:ARG:入力行動 = LOCAL:1
ENDIF


