@PLAYABLE_COLOSSEUM_12
IF  闘技場フラグ:12:0 == 0 && FLAG:百合の花ルート >= 2
	RESULTS = いいやつだけど食いしん坊
	RETURN 1
ENDIF
RETURN 0


;====================
;内容
;====================
@COLOSSEUM_12
FLAG:逃走不可フラグ = 1
FLAG:会話不能フラグ = 1
FLAG:先制不意打ちキャンセル = 1
CUSTOMDRAWLINE =
