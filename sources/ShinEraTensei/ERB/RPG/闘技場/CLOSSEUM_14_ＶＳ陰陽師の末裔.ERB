@SET_ACTION_757,ARG
;後衛に居るなら前衛に出る
IF CPOS(ARG) > 11
	CFLAG:ARG:入力行動 = 2301
	CFLAG:ARG:入力行動 = CPOS(ARG)-5
ENDIF

@SET_ACTION_872,ARG
;後衛に居るなら前衛に出る
IF CPOS(ARG) > 11
	CFLAG:ARG:入力行動 = 2301
	CFLAG:ARG:入力行動 = CPOS(ARG)-5
ENDIF

@SET_ACTION_873,ARG
;後衛に居るなら前衛に出る
IF CPOS(ARG) > 11
	CFLAG:ARG:入力行動 = 2301
	CFLAG:ARG:入力行動 = CPOS(ARG)-5
ENDIF


@SET_ACTION_4543,ARG
;前衛に居るならスウェイバック
IF CPOS(ARG) == 9 && CFLAG:POS(14):ステート < GET_STATE_NUM("DYING") 
	CFLAG:ARG:入力行動 = 2301
	CFLAG:ARG:ターゲット = 14
	RETURN 1
ENDIF


;スザクの思考パターン
@SET_ACTION_957,ARG
;ポジション8.9.10.が死んでたらリカーム
;それ以外に死んでるキャラが居たらリカーム
IF CFLAG:POS(8):ステート == GET_STATE_NUM("DYING")
	CALL CHECK_ACTIONABLE,ARG,418
	SIF RESULT == 0
		GOTO DECIDE_ACTION
	CFLAG:ARG:入力行動 = 418
	CFLAG:ARG:ターゲット = POS(8)
	RETURN 1
ELSEIF CFLAG:POS(9):ステート == GET_STATE_NUM("DYING")
	CALL CHECK_ACTIONABLE,ARG,418
	SIF RESULT == 0
		GOTO DECIDE_ACTION
	CFLAG:ARG:入力行動 = 418
	CFLAG:ARG:ターゲット = POS(9)
	RETURN 1
ELSEIF CFLAG:POS(10):ステート == GET_STATE_NUM("DYING")
	CALL CHECK_ACTIONABLE,ARG,418
	SIF RESULT == 0
		GOTO DECIDE_ACTION
	CFLAG:ARG:入力行動 = 418
	CFLAG:ARG:ターゲット = POS(10)
	RETURN 1
;前衛に居るならスウェイバック
ELSEIF CPOS(ARG) == 8
	CFLAG:ARG:入力行動 = 2301
	CFLAG:ARG:ターゲット = 14
	RETURN 1
ELSE
	$DECIDE_ACTION
	CALL SEARCH_ACT,ARG
	IF RESULT == 0
		CFLAG:ARG:入力行動 = -1
		CFLAG:ARG:防御フラグ = 1
		RETURN 0
	ENDIF
	PRINTFORML [{CFLAG:ARG:5}]のスキル数 {RESULT}
	LOCAL = RAND:RESULT
	;スキル番号決定
	LOCAL:1 = S:(10+LOCAL)
	PRINTFORML [{CFLAG:ARG:5}]のスキル {LOCAL:1}
	$TARGET_LOOP
	
	CALL RANDOM_TARGET,ARG,LOCAL:1
	CALLFORM SKILL_TARGET_{LOCAL:1}
	;ここでスキル番号を行動内容に代入
	SIF CFLAG:ARG:ターゲット == -1
		GOTO DECIDE_ACTION
	CFLAG:ARG:入力行動 = LOCAL:1
ENDIF


