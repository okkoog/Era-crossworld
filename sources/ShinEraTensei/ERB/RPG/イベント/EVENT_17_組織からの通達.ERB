;--------------------------------------------------------
;組織からの通達
;--------------------------------------------------------
;[T.D.L./品川/警視庁(未実装)/東京タワー(未実装)]の
;出現を制御するイベント
;
;上記4つはカテドラルの前提MAPで
;依頼をこなすことでカテドラル通過を可能にしてくれる
;ボスの強さは画一で60レベルダンジョン相当
;雑魚は出現順で強化される
;
;早くから(銀座出現あたりから)依頼を受けるだけならできるという仕様に
;ただそれだけだと、ダンジョンのレベルがこの4つだけで急激にあがりすぎる感あるので
;納金で速度に制限をかける
;
;早くから依頼を受けれるのは中盤時点で(ルートは確定しないけど)各勢力にある程度協力できるようにするために
;====================
;条件
;====================
@PLAYABLE_EVENT_17
SELECTCASE イベントフラグ:17:0
	CASE 0
		;20レベル装備陳列
		IF FLAG:組織貢献度 + FLAG:名声 * 100 > 210000
			RESULTS = 組織からの通達
			RETURN 1
		ENDIF
	CASE 1
		;30レベル装備陳列
		IF FLAG:組織貢献度 + FLAG:名声 * 100 > 460000 && (DAY  > STRFLAG_NUM_EV("最新通達日" , , , , 17) + 1)
			RESULTS = 組織からの通達
			RETURN 1
		ENDIF
	CASE 2
		;40レベル装備陳列
		IF FLAG:組織貢献度 + FLAG:名声 * 100 > 1460000 && (DAY  > STRFLAG_NUM_EV("最新通達日" , , , , 17) + 1)
			RESULTS = 組織からの通達
			;警視庁・タワーがないので一回スキップさせる
			イベントフラグ:17:0 = 3
			RETURN 0
		ENDIF
	CASE 3
		;50レベル装備陳列
		IF FLAG:組織貢献度 + FLAG:名声 * 100 > 3110000 && (DAY  > STRFLAG_NUM_EV("最新通達日" , , , , 17) + 1)
			RESULTS = 組織からの通達
			RETURN 1
		ENDIF
	CASE 4
	;	;60レベル装備陳列
	;	IF FLAG:組織貢献度 + FLAG:名声 * 100 > 5000000 && (DAY  > STRFLAG_NUM_EV("最新通達日" , , , , 17) + 1)
	;		RESULTS = 組織からの通達
	;		RETURN 1
	;	ENDIF
ENDSELECT
RETURN 0


;====================
;内容
;====================
@SHOPCOM_EVENT_17
#LOCALSIZE 1
#LOCALSSIZE 1
CLEARBIT FLAG:イベント出現1, 17
;同日に通達が来るのを防ぐためにとっておく
CALLF STRFLAG_NUM_EV("最新通達日" , "=" , , DAY)
CALL MESSAGE_WINDOW, "", "＞ファントムソサエティからメールが届いている", , , , , 4
SELECTCASE イベントフラグ:17:0
	;一通目は予告
	CASE 0
		CALL MESSAGE_WINDOW, "メール", "＞ファントムソサエティのもとに集う/＞栄光あるサマナー諸君へ/", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞諸君らの活躍により我らがプロジェクトも順調に進行している/＞しかしまだ油断することはできない/＞来るべき契約の時に向け/＞ソウル回収を急がねばならない", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞ファントムソサエティは/＞新たに４つの地区のターミナルとの連絡を得ることに成功した/＞それらの地域はそれぞれ/＞強力な悪魔によって支配されているが諸君らの戦力の強化に役立てられるだろう", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞しかしながら、各地域の連絡は弱く/＞迂闊な行動を取れば連絡を断たれることになりかねない/＞そこでファントムソサエティは/＞優秀なサマナーに順次ターミナルを提供していくことを決定した", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞手続きの準備が出来次第/＞対象のサマナーにメールが配布される/＞各人はそれまで腕を磨き組織に貢献することで/＞ファントムソサエティに、その優秀さを示されたし", , , , , 4
		イベントフラグ:17:0 = 1
		RETURN 1
	CASE 1
		CALL MESSAGE_WINDOW, "メール", "＞ファントムソサエティのもとに集う/＞栄光あるサマナーへ", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞貴君の貢献を評価し/＞貴君にトウキョウの重要拠点のターミナルの転送データの/＞１つを提供することが決定された", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞添付したファイルを参照し/＞貴君が提供を望むターミナルを選び/＞返信されたし", , , , , 4
	CASEELSE
		CALL MESSAGE_WINDOW, "メール", "＞ファントムソサエティのもとに集う/＞栄光あるサマナーへ", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞貴君の貢献を評価し/＞さらに貴君にトウキョウの重要拠点のターミナルの転送データを/＞提供することが決定された", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞添付したファイルを参照し/＞貴君が提供を望むターミナルを選び/＞返信されたし", , , , , 4
ENDSELECT
LOCALS = 
IF !ダンジョンフラグ:[[ダンジョン:T.D.L.]]:0
	SIF LOCALS != ""
		LOCALS += "/"
	LOCALS += "[0] 東京デスティニーランド"
ENDIF
IF !ダンジョンフラグ:[[ダンジョン:品川]]:0
	SIF LOCALS != ""
		LOCALS += "/"
	LOCALS += "[1] 品川大聖堂"
ENDIF
;IF !ダンジョンフラグ:[[ダンジョン:警視庁]]:0
;	SIF LOCALS != ""
;		LOCALS += "/"
;	LOCALS += [2] 警視庁
;ENDIF
;IF !ダンジョンフラグ:[[ダンジョン:東京タワー]]:0
;	SIF LOCALS != ""
;		LOCALS += "/"
;	LOCALS += [3] 東京タワー
;ENDIF
$INPUT_LOOP
CALL INPUT_SELECT_M, LOCALS, , "ログを残さない/ボタンを利用する", ,4
LOCAL = RESULT
SELECTCASE RESULT
	CASE 0
		CALL MESSAGE_WINDOW, "メール", "＞東京デスティニーランド/＞江東区有明にある/＞人の運命を決めるというテーマパーク", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞ガイア教の幹部の一人エキドナによって/＞支配されており、メシア教との戦いの前線基地として利用されている", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞エキドナとうまく交渉することができれば/＞サマナー個人にとっても組織にとっても大きな利益があがるだろう", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞あるいはエキドナ及びガイア教徒を打倒することにより/＞他の勢力との交渉材料として活かせる見込みも高い/＞ファントムソサエティは貴君の判断に一任するので/＞最良と思われる行動をとられたし", , , , , 4
	CASE 1
		CALL MESSAGE_WINDOW, "メール", "＞品川大聖堂/＞その名の通り品川にあるメシア教の教会である", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞メシア教徒の中心的な拠点のひとつであり/＞現在は大天使 ハニエルの手により統治されている", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞メシア教は現在の東京でも最大の勢力のひとつである/＞どう対応するにしても/＞プロジェクトの進行に大きな影響がでるのは間違いない", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "＞この地に赴くサマナーは/＞慎重に行動すること", , , , , 4
	CASE 2
		CALL MESSAGE_WINDOW, "メール", "", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "", , , , , 4
	CASE 3
		CALL MESSAGE_WINDOW, "メール", "", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "", , , , , 4
		CALL MESSAGE_WINDOW, "メール", "", , , , , 4
ENDSELECT
CALL MESSAGE_WINDOW, "", @"＞%AUTO_SPLIT("東京ディスティニーランド/品川大教会/警視庁/東京タワー", "/", LOCAL)%を選択しますか？", , , , , 4
CALL INPUT_YN_M( , , , , , 4)
SIF RESULT
	GOTO INPUT_LOOP
CALL MESSAGE_WINDOW, "", "＞メールに返信を出した……", , , , , 4
;進行度と同数の数値を各ダンジョンのフラグに入れる
SELECTCASE LOCAL
	CASE 0
		ダンジョンフラグ:[[ダンジョン:T.D.L.]]:0 = イベントフラグ:17:0
	CASE 1
		ダンジョンフラグ:[[ダンジョン:品川]]:0 = イベントフラグ:17:0
	CASE 2
		;ダンジョンフラグ:[[ダンジョン:警視庁]]:0 = イベントフラグ:10:0
	CASE 3
		;ダンジョンフラグ:[[ダンジョン:東京タワー]]:0 = イベントフラグ:10:0
ENDSELECT
