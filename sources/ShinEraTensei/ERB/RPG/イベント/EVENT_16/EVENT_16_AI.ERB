; EVENT_16_AI.ERB
; 全能のバランサーとマーガレットの戦闘AIを記述しています

; 全能のバランサーの思考パターン
; コンセントレイトと6種の単体属性魔法、メギドラオンを繰り返す。1moreはコンセントレイト固定
; 魔力が高いためHP3桁程度では弱点でなくても即死するくらいには痛い。運が低いのでよく外れるが……
; 基本的に単体魔法で弱点狙い。魔法反射がかかっている場合、33%でメギドラオン、HPが30%を切ると確実にメギドラオン
; HPが30%を切ると魔法反射がかかっていなくてもメギドラオンが混ざる
; クリティカルの出方次第で1ターンでも倒せるが下手に削って生き残ってしまうとコンセメギドがとんでくる
; ところでバランサーの攻撃時のぶるるるるって声なんか異様にかわいくないですかね？
@SET_ACTION_全能バランサ, ARG
; 初期化
VARSET LOCAL, 0
; 1moreかコンセントレイト未実行ならコンセントレイト
IF CFLAG:ARG:１moreフラグ == 2 || CFLAG:ARG:集中フラグ == 0
	CALL EVENT_16_SET_ACTION, ARG, [[スキル:コンセントレイト]]
	RETURN 0
; それ以外
ELSE
	; HPが5割を切ってるなら1/7でメギドラオンセット
	IF 現HP割合(ARG) < 50 && RAND:7 == 0
		CALL EVENT_16_SET_ACTION, ARG, [[スキル:メギドラオン]]
		RETURN 0
	ENDIF
	; キャラ走査
	FOR LOCAL:3, 1, 7
		LOCAL = POS(LOCAL:3)
		; 空ポジションかDYINGなら次
		SIF LOCAL < 0 || GET_STATE(CFLAG:LOCAL:ステート) == "DYING"
			CONTINUE
		; 魔法反射状態なら一定確率でメギドラオンセットしてキャラ走査終了
		; 気づいてしまったけど反射の持続1ターンだしもしかしてこれ意味がな……
		IF CFLAG:LOCAL:魔法反射フラグ > 0 && (現HP割合(ARG) < 30 || (現HP割合(ARG) < 70 && RAND:3 == 0))
			CALL EVENT_16_SET_ACTION, ARG, [[スキル:メギドラオン]]
			BREAK
		ENDIF
		; 既に行動が入力されている場合は1/3でキャラ走査終了
		SIF CFLAG:ARG:入力行動 >= 0 && RAND:3 == 0
			BREAK
		; 耐性走査
		FOR LOCAL:4, 40, 59
			SELECTCASE LOCAL:4
				; 火炎
				CASE 44
					; 弱点でなければ次
					SIF CHECK_WEAKNESS(MAXBASE:LOCAL:(LOCAL:4)) < 0
						CONTINUE
					; 既に行動が入力されている場合は1/3で耐性走査終了
					SIF CFLAG:ARG:入力行動 > 0 && RAND:3 == 0
						BREAK
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:アギダイン]], LOCAL:3
				; 氷結
				CASE 45
					; 弱点でなければ次
					SIF CHECK_WEAKNESS(MAXBASE:LOCAL:(LOCAL:4)) < 0
						CONTINUE
					; 既に行動が入力されている場合は1/3で耐性走査終了
					SIF CFLAG:ARG:入力行動 > 0 && RAND:3 == 0
						BREAK
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:ブフダイン]], LOCAL:3
				; 電撃
				CASE 46
					; 弱点でなければ次
					SIF CHECK_WEAKNESS(MAXBASE:LOCAL:(LOCAL:4)) < 0
						CONTINUE
					; 既に行動が入力されている場合は1/3で耐性走査終了
					SIF CFLAG:ARG:入力行動 > 0 && RAND:3 == 0
						BREAK
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:ジオダイン]], LOCAL:3
				; 地変
				CASE 52
					; 弱点でなければ次
					SIF CHECK_WEAKNESS(MAXBASE:LOCAL:(LOCAL:4)) < 0
						CONTINUE
					; 既に行動が入力されている場合は1/3で耐性走査終了
					SIF CFLAG:ARG:入力行動 > 0 && RAND:3 == 0
						BREAK
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:マグダイン]], LOCAL:3
				; 水撃
				CASE 53
					; 弱点でなければ次
					SIF CHECK_WEAKNESS(MAXBASE:LOCAL:(LOCAL:4)) < 0
						CONTINUE
					; 既に行動が入力されている場合は1/3で耐性走査終了
					SIF CFLAG:ARG:入力行動 > 0 && RAND:3 == 0
						BREAK
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:アクアダイン]], LOCAL:3
				; 疾風
				CASE 54
					; 弱点でなければ次
					SIF CHECK_WEAKNESS(MAXBASE:LOCAL:(LOCAL:4)) < 0
						CONTINUE
					; 既に行動が入力されている場合は1/3で耐性走査終了
					SIF CFLAG:ARG:入力行動 > 0 && RAND:3 == 0
						BREAK
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:ガルダイン]], LOCAL:3
			ENDSELECT
		NEXT
	NEXT
	; ここまで来て属性魔法がセットされていない場合はランダム対象で属性魔法を使う
	SIF CFLAG:ARG:入力行動 > 0
		RETURN 0
	SELECTCASE RAND:6
		CASE 0
			CALL EVENT_16_SET_ACTION, ARG, [[スキル:アギダイン]]
		CASE 1
			CALL EVENT_16_SET_ACTION, ARG, [[スキル:ブフダイン]]
		CASE 2
			CALL EVENT_16_SET_ACTION, ARG, [[スキル:ジオダイン]]
		CASE 3
			CALL EVENT_16_SET_ACTION, ARG, [[スキル:マグダイン]]
		CASE 4
			CALL EVENT_16_SET_ACTION, ARG, [[スキル:アクアダイン]]
		CASE 5
			CALL EVENT_16_SET_ACTION, ARG, [[スキル:ガルダイン]]
	ENDSELECT
ENDIF

; マーガレットの思考パターン
; ・第一段階 HP75%まで
;   ペルソナをつけずにアタックのみ
; ・第二段階 HP50%まで
;   ターン数に応じたペルソナにつけかえて攻撃
; ・第三段階 初めてHP50%未満
;   始めのターンでペルソナをルシフェルにしてメギドラオン、
;   次のターンでペルソナをアルダーにしてディアラハン
; ・第四段階 第三段階以降HP75%まで
;   ペルソナをアルダーにしてアタックのみ
; ・第五段階 第三段階以降HP50%まで
;   ターン数に応じたペルソナにつけかえて攻撃
; ・第六段階 第三段階以降HP50%未満
;   ターン数に応じたペルソナにつけかえて攻撃
; ・特殊行動 50ターン毎
;   全ての段階の行動より優先してオベロンで即死威力のメギドラオンを放つ
;
; P4仕様を基にしたAIなんでパターン完全固定、無効も反射も吸収もバステも知ったこっちゃない火力ごり押しキャラ
; (仕込みを終えた)ペルソナ使いが圧倒的に有利。メギドラオンで落ちなければ完全にパターンで撃破できる
; 異能者は微妙だが純サマナーはほぼ必須
; 召喚コストを気にしないのであれば育て上げた悪魔が一番手っ取り早い
; 全員恋慕か服従でないと生き残ってもがめおべあな可能性有り
;
; 開幕Lランダマイザを推奨。時間経過で効果終わらないって素晴らしいね
; できないならタルンダ,ラクカジャ重ね掛けは必須。余裕があればスクカジャ,スクンダも
; 1moreを取ると基本的に強化弱体、もしくはその消去を行うのでクリティカルは仕方ないとしても弱点は必ず防ぐ事
;
; 基本が全体特大ダメージなので攻撃属性が弱点なら必ずガード
; ロキ(氷結)はほぼ凍らされるため、マーガレットより遅くて耐性以下ならガードが無難
; オオクニヌシ(電撃)はDYING付き列攻撃で最悪の場合は一列総崩れなので即死対策してないならこれもガードが無難
; 他の攻撃は耐えられるキャラなら攻めていく
; 難易度ノーマルである限りHP4桁あれば弱点でない限り基本的に耐えられる
; いや、威力150以上のスキル(デッドリーバーンなど)だと堕ちるかもしれないが……
;
; HPが15000以上と非常にタフだが原作と違って弱点があるのでそれを突くことで削るのは容易
; 逆に一部以外はコーチングを持っているためクリティカルでCOOP取る方が難しい
; 疾風弱点が他の属性弱点より多いので用意しておくといいだろう
; 耐性以上の相性が多いがジオ系ブフ系でSHOCK,FREEZEで行動自体を潰すことを狙うのも有り(要マーガレットより早い行動)
;
; ぶっちゃけ強くしたいなら無効反射吸収を見つけ次第即死メギドラオンするだけでいいのよね……
; 高レベル悪魔がほとんど使い物にならなくなっちゃうけど
; もしくはP3Pに似せたAIを実装するか
; このまま強くするなら現状乱数で決めている行動を属性相性見て決めるようにするとか
@SET_ACTION_マーガレット, ARG
IF FLAG:経過ターン数 == 0
	CALL EVENT_16_PCHANGE, ARG, 0, 1
	SETCOLOR 0xff0033
	PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
	PRINTL ┃戦いの熱と緊張感が、体を満たしていく……　　┃
	PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　┃
	PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　┃
	PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━┛
	PRINTL 
	PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
	PRINTL ┃さあ、始めましょう。　　　　　　　　　　　　┃
	PRINTL ┃私を失望させないでちょうだい！　　　　　　　┃
	PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　┃
	PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━┛
	RESETCOLOR
	PRINTL 
	CUSTOMDRAWLINE =
	PRINTL 
	CALL EVENT_16_SET_ACTION, ARG, [[スキル:ＡＴＴＡＣＫ]]
ELSEIF (FLAG:経過ターン数 % 50) == 0
	CALL EVENT_16_MESSAGE_G
	CALL EVENT_16_PCHANGE, ARG, 5, ((イベントフラグ:16:0 % 10) == 5)
	CALL EVENT_16_SET_ACTION, ARG, [[スキル:メギドラオン]]
ELSEIF 現HP割合(ARG) >= 75
	IF (イベントフラグ:16:0 / 10) < 3
		CALL EVENT_16_PCHANGE, ARG, 0, ((イベントフラグ:16:0 % 10) == 0)
	ELSE
		CALL EVENT_16_PCHANGE, ARG, 6, ((イベントフラグ:16:0 % 10) == 6)
	ENDIF
	IF CFLAG:ARG:１moreフラグ == 0 || (イベントフラグ:16:0 / 10) < 3
		CALL EVENT_16_SET_ACTION, ARG, [[スキル:ＡＴＴＡＣＫ]]
	ELSE
		CALL EVENT_16_SET_ACTION, ARG, [[スキル:ランダマイザ]]
	ENDIF
ELSEIF 現HP割合(ARG) >= 50
	IF (イベントフラグ:16:0 / 10) == 0
		SETCOLOR 0xff0033
		PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
		PRINTL ┃今のうちに言っておくわ。　　　　　　　　　　┃
		PRINTL ┃私を気遣う心は捨てなさい。　　　　　　　　　┃
		PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━┛
		PRINTL 
		PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
		PRINTL ┃殺す気で挑むことこそ敬意。　　　　　　　　　┃
		PRINTL ┃手加減は侮辱よ。　　　　　　　　　　　　　　┃
		PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━┛
		RESETCOLOR
		PRINTL 
		CUSTOMDRAWLINE =
		PRINTL 
		LOCAL = イベントフラグ:16:0 % 10
		イベントフラグ:16:0 = 10 + LOCAL
	ENDIF
	SELECTCASE FLAG:経過ターン数 % 6
		CASE 0
			CALL EVENT_16_MESSAGE_G
			CALL EVENT_16_PCHANGE, ARG, 1, ((イベントフラグ:16:0 % 10) == 1)
			IF CFLAG:ARG:１moreフラグ == 0
				IF RAND:2 == 0 && (イベントフラグ:16:0 / 10) == 3
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:デッドリーバーン]]
				ELSE
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:フレイダイン]]
				ENDIF
			ELSE
				CALL EVENT_16_SET_ACTION, ARG, [[スキル:ヒートライザ]]
			ENDIF
		CASE 1
			CALL EVENT_16_MESSAGE_G
			CALL EVENT_16_PCHANGE, ARG, 2, ((イベントフラグ:16:0 % 10) == 2)
			IF CFLAG:ARG:１moreフラグ == 0
				IF RAND:2 == 0 && (イベントフラグ:16:0 / 10) == 3
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:アクアリータイド]]
				ELSE
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:ニブルヘイム]]
				ENDIF
			ELSE
				CALL EVENT_16_SET_ACTION, ARG, [[スキル:ランダマイザ]]
			ENDIF
		CASE 2
			CALL EVENT_16_MESSAGE_G
			CALL EVENT_16_PCHANGE, ARG, 3, ((イベントフラグ:16:0 % 10) == 3)
			IF CFLAG:ARG:１moreフラグ == 0
				IF RAND:2 == 0 && (イベントフラグ:16:0 / 10) == 3
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:雷震王母の蹴り]]
				ELSE
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:破戒の稲妻]]
				ENDIF
			ELSE
				IF CFLAG:ARG:攻撃強化 < 0 || CFLAG:ARG:魔法威力強化 < 0 || CFLAG:ARG:命中強化 < 0 || CFLAG:ARG:回避強化 < 0 || CFLAG:ARG:防御強化 < 0
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:デ・クンダ]]
				ELSE
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:デ・カジャ]]
				ENDIF
			ENDIF
		CASE 3
			CALL EVENT_16_MESSAGE_G
			CALL EVENT_16_PCHANGE, ARG, 4, ((イベントフラグ:16:0 % 10) == 4)
			IF CFLAG:ARG:１moreフラグ == 0
				IF RAND:3 == 0 && (イベントフラグ:16:0 / 10) == 3
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:デスバウンド]]
				ELSE
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:旋風陣]]
				ENDIF
			ELSE
				CALL EVENT_16_SET_ACTION, ARG, [[スキル:レボリューション]]
			ENDIF
		CASE 4
			CALL EVENT_16_MESSAGE_G
			CALL EVENT_16_PCHANGE, ARG, 5, ((イベントフラグ:16:0 % 10) == 5)
			CALL EVENT_16_SET_ACTION, ARG, [[スキル:コンセントレイト]]
		CASE 5
			CALL EVENT_16_MESSAGE_G
			CALL EVENT_16_PCHANGE, ARG, 6, ((イベントフラグ:16:0 % 10) == 6)
			IF CFLAG:ARG:１moreフラグ == 0
				CALL EVENT_16_SET_ACTION, ARG, [[スキル:メギドラオン]]
			ELSE
				CALL EVENT_16_SET_ACTION, ARG, [[スキル:ヒートライザ]]
			ENDIF
	ENDSELECT
ELSEIF (イベントフラグ:16:0 / 10) < 3
	CFLAG:ARG:行動回数 = 1
	LOCAL = イベントフラグ:16:0 / 10
	LOCAL:1 = イベントフラグ:16:0 % 10
	IF LOCAL <= 1
		SETCOLOR 0xff0033
		PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
		PRINTL ┃フゥ……この高揚感……　　　　　　　　　　　┃
		PRINTL ┃いつ以来かしら。　　　　　　　　　　　　　　┃
		PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━┛
		PRINTL 
		PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
		PRINTL ┃悪く思わないで……　　　　　　　　　　　　　┃
		PRINTL ┃ますます貴方を倒したくなってきたわ！　　　　┃
		PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━┛
		RESETCOLOR
		PRINTL 
		CUSTOMDRAWLINE =
		PRINTL 
		IF LOCAL < 1
			イベントフラグ:16:0 = 10 + LOCAL:1
			LOCAL = 1
		ENDIF
	ENDIF
	IF LOCAL >= 2
		CALL EVENT_16_PCHANGE, ARG, 6, (LOCAL:1 == 6)
		CALL EVENT_16_SET_ACTION, ARG, [[スキル:ディアラハン]]
	ELSE
		CALL EVENT_16_PCHANGE, ARG, 7, (LOCAL:1 == 7)
		CALL EVENT_16_SET_ACTION, ARG, [[スキル:メギドラオン]]
	ENDIF
	イベントフラグ:16:0 = (LOCAL + 1) * 10 + LOCAL:1
ELSE
	IF (イベントフラグ:16:0 / 10) == 3
		SETCOLOR 0xff0033
		PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
		PRINTL ┃ハァ。ハァ……最高よ。エリザベスでも　　　　┃
		PRINTL ┃ここまで私を追い詰めたことはないわ。　　　　┃
		PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━┛
		PRINTL 
		PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
		PRINTL ┃さあ、今こそ見せてちょうだい……　　　　　　┃
		PRINTL ┃戦いの、その先にあるものを……！　　　　　　┃
		PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━┛
		RESETCOLOR
		PRINTL 
		CUSTOMDRAWLINE =
		PRINTL 
		LOCAL = イベントフラグ:16:0 % 10
		イベントフラグ:16:0 = 40 + LOCAL
	ENDIF
	SELECTCASE FLAG:経過ターン数 % 6
		CASE 0
			CFLAG:ARG:行動回数 = 1
			CALL EVENT_16_MESSAGE_G
			CALL EVENT_16_PCHANGE, ARG, 1, ((イベントフラグ:16:0 % 10) == 1)
			IF CFLAG:ARG:１moreフラグ == 0
				IF RAND:2 == 0
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:デッドリーバーン]]
				ELSE
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:フレイダイン]]
				ENDIF
			ELSE
				; 自己強化が一定以下ならヒートライザ。それ以外なら攻撃
				IF CFLAG:ARG:攻撃強化 < 8 || CFLAG:ARG:魔法威力強化 < 8 || CFLAG:ARG:命中強化 < 8 || CFLAG:ARG:回避強化 < 8 || CFLAG:ARG:防御強化 < 8
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:ヒートライザ]]
				ELSE
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:アカシャアーツ]]
				ENDIF
			ENDIF
		CASE 1
			CFLAG:ARG:行動回数 = 1
			CALL EVENT_16_MESSAGE_G
			CALL EVENT_16_PCHANGE, ARG, 2, ((イベントフラグ:16:0 % 10) == 2)
			IF CFLAG:ARG:１moreフラグ == 0
				IF RAND:2 == 0
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:アクアリータイド]]
				ELSE
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:ニブルヘイム]]
				ENDIF
			ELSE
				CALL EVENT_16_SET_ACTION, ARG, [[スキル:ランダマイザ]]
			ENDIF
		CASE 2
			CFLAG:ARG:行動回数 = 2
			CALL EVENT_16_MESSAGE_G
			CALL EVENT_16_PCHANGE, ARG, 3, ((イベントフラグ:16:0 % 10) == 3)
			IF CFLAG:ARG:１moreフラグ == 0
				IF RAND:2 == 0
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:雷震王母の蹴り]]
				ELSE
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:破戒の稲妻]]
				ENDIF
			ELSE
				IF RAND:4 == 0
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:利剣乱舞]]
				ELSE
					IF CFLAG:ARG:攻撃強化 < 0 || CFLAG:ARG:魔法威力強化 < 0 || CFLAG:ARG:命中強化 < 0 || CFLAG:ARG:回避強化 < 0 || CFLAG:ARG:防御強化 < 0
						CALL EVENT_16_SET_ACTION, ARG, [[スキル:デ・クンダ]]
					ELSE
						CALL EVENT_16_SET_ACTION, ARG, [[スキル:デ・カジャ]]
					ENDIF
				ENDIF
			ENDIF
		CASE 3
			CFLAG:ARG:行動回数 = 2
			CALL EVENT_16_MESSAGE_G
			CALL EVENT_16_PCHANGE, ARG, 4, ((イベントフラグ:16:0 % 10) == 4)
			IF CFLAG:ARG:１moreフラグ == 0
				IF RAND:3 == 0
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:デスバウンド]]
				ELSE
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:旋風陣]]
				ENDIF
			ELSE
				CALL EVENT_16_SET_ACTION, ARG, [[スキル:レボリューション]]
			ENDIF
		CASE 4
			CFLAG:ARG:行動回数 = 1
			CALL EVENT_16_MESSAGE_G
			CALL EVENT_16_PCHANGE, ARG, 5, ((イベントフラグ:16:0 % 10) == 5)
			CALL EVENT_16_SET_ACTION, ARG, [[スキル:気合]]
		CASE 5
			; 行動回数は戦闘難易度に依存。高難易度では容赦なく前衛を潰しに来る
			; うっかり反射したりするとみじめになるほど吸収して回復
			CFLAG:ARG:行動回数 = 3 + (FLAG:戦闘難易度 - 4 > 0 ? FLAG:戦闘難易度 - 4 # 0)
			CALL EVENT_16_MESSAGE_G
			CALL EVENT_16_PCHANGE, ARG, 8, ((イベントフラグ:16:0 % 10) == 8)
			IF CFLAG:ARG:気合フラグ == 0
				CALL EVENT_16_SET_ACTION, ARG, [[スキル:気合]]
			ELSEIF CFLAG:ARG:１moreフラグ == 0
				CALL EVENT_16_SET_ACTION, ARG, [[スキル:ヨシツネ見参]]
			ELSE
				; 自己強化が一定以下ならヒートライザ。それ以外ならランダマイザ
				IF CFLAG:ARG:攻撃強化 < 8 || CFLAG:ARG:魔法威力強化 < 8 || CFLAG:ARG:命中強化 < 8 || CFLAG:ARG:回避強化 < 8 || CFLAG:ARG:防御強化 < 8
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:ヒートライザ]]
				ELSE
					CALL EVENT_16_SET_ACTION, ARG, [[スキル:ランダマイザ]]
				ENDIF
			ENDIF
	ENDSELECT
ENDIF

