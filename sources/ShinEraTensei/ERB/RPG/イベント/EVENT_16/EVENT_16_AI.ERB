; 難易度を求めている人には難易度を
; 最高難易度で64,48,64,48,32,32。ヨシツネだと力104で気合つき見参
@EVENT_16_SET_BASE_ST, ARG
LOCAL:1 = FLAG:戦闘難易度 - 3 > 0 ? 120 + (FLAG:戦闘難易度 - 3) * 20 # 100
BASE:ARG:力 = 40 * LOCAL:1 / 100
BASE:ARG:知恵 = 30 * LOCAL:1 / 100
BASE:ARG:魔力 = 40 * LOCAL:1 / 100
BASE:ARG:耐力 = 30 * LOCAL:1 / 100
BASE:ARG:速さ = 20 * LOCAL:1 / 100
BASE:ARG:運 = 20 * LOCAL:1 / 100
RETURN 0

; 全スキルを消去
@EVENT_16_CLEAR_SKILL, ARG
FOR LOCAL, 0, 8
	ABL:ARG:(60+LOCAL) = -1
NEXT
RETURN 0

