				CALL ADD_NEW_COMPANION,4516,1000
				IF CFLAG:GETCHARA(4516):引継ぎ回数
					TARGET = GETCHARA(4516)
				ELSE
					LOCAL = GETCHARA(4516)
					ABL:LOCAL:従順 = 1
					TARGET = LOCAL
					CFLAG:戦闘参加不可能 = 0
				ENDIF
				イベントフラグ:1:0 = 3
				BEGIN TRAIN
				GOTO END_EVENT
		ELSE
			PRINTW 「それでは失礼させていただくわ」
			PRINTW 「次に会う時は……私を靡かせるくらい強くなっていて頂戴ね？」
			イベントフラグ:1:0 = 2
		ENDIF
		
	ENDIF
ELSE

	PRINTW 事務所にマヨーネを呼び出した。
	PRINTFORMW 部下である%CALLNAME:MASTER%に呼び出された彼女はしばし無言で%CALLNAME:MASTER%の体を眺め、或いは軽く触れていた。
	PRINTW しばらくしてマヨーネは口を開いた。
	PRINTW 「強くなられましたのね。ええ、逞しく」
	PRINTW マヨーネはそういうとスルリと衣服を脱ぎ始めた。
	PRINTFORMW 雪のように白い肌と共に、乳房や秘所が%CALLNAME:MASTER%の目の前で曝け出される。
	PRINTW 「強くなったご褒美を差し上げましょう」
	PRINTW 「ご褒美は私自身。私は、私よりも強い貴方に従います」
	PRINTW 「さあ、私めのカラダを好きな時に好きなだけお使い下さい、ご主人様」
	CALL ADD_NEW_COMPANION,4516,1000
	IF CFLAG:GETCHARA(4516):引継ぎ回数
		TARGET = GETCHARA(4516)
	ELSE
		LOCAL = GETCHARA(4516)
		ABL:LOCAL:従順 = 1
		TARGET = LOCAL
		CFLAG:戦闘参加不可能 = 0
	ENDIF
	イベントフラグ:1:0 = 3
	BEGIN TRAIN
	
	$END_EVENT
	FOR LOCAL,0,CHARANUM
		CALL HEALTH_CHARA,LOCAL
	NEXT

ENDIF


