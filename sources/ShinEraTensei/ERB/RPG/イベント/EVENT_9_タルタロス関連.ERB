;====================
;条件
;====================
@PLAYABLE_EVENT_9
;エコービルor初台シェルターのどちらかをクリア、または主人公のレベルが10に到達していると
;タルタロス踏破指令がもらえる
IF イベントフラグ:9:0 == 0 && (ダンジョンフラグ:1:1 != 0 || ダンジョンフラグ:34:8 != 0 || BASE:0:LV >= 10)
	RESULTS = タルタロス踏破指令
	RETURN 1
;２０階到達でアイギスの依頼
ELSEIF イベントフラグ:9:0 == 1 && ダンジョンフラグ:70:(97) >= 3
	RESULTS = 追加依頼
	RETURN 1
;３５階のボス(運命剛毅)撃破で刑死者のはなし
ELSEIF イベントフラグ:9:0 == 2 && ダンジョンフラグ:70:(1) >= 7
	RESULTS = タルタロスについて
	RETURN 1
ENDIF
RETURN 0

;====================
;内容
;====================
@SHOPCOM_EVENT_9
IF イベントフラグ:9:0 == 0
	IF (ダンジョンフラグ:1:1 != 0 || ダンジョンフラグ:34:8 != 0)
		PRINTFORML 特に問題もなく、順調に任務をこなしつつあると考えている%CALLNAME:MASTER%の事務所に
		PRINTW 突然、ファント・ソサエティから紹介を受けたという、カーキ色のジャケットの男がやってきた
	ELSE
		PRINTFORML サマナーとして着実に腕を伸ばしつつある%CALLNAME:MASTER%の事務所に
		PRINTW 突然、ファント・ソサエティから紹介を受けたという、カーキ色のジャケットの男がやってきた
	ENDIF
	PRINTL 
	PRINTW 「ええと、君の名前はなんだっけ？」
	PRINTW 「ふむ、いい名前だね」
	PRINTW 「奴隷商人というだけあってどれいだけいい名前なのかっておもってたけど、期待通りだ」
	PRINTW 「しかも、サマナーだっていうのが様になってるね」
	PRINTW 「おっと、僕の自己紹介もしないとね」
	PRINTW 「僕は幾月修司、月光館学園の理事長で、ペルソナ研究者で…」
	PRINTW 「そして、桐条グループとファントム・ソサエティのパイプ役でもある」
	PRINTW 「と，言ってもいまの桐条グループとファントム・ソサエティの連絡はほとんど切れちゃってるんだけどね」
	PRINTW 「おかげで僕の立場が危険で、まさにパイプカットされかかってると言っても過言じゃないピンチっぷりだったり」
	PRINTW 「でまぁ、僕の失敗を挽回するためには、ペルソナの有意義な研究データを提出したうえで」
	PRINTW 「さらにタルタロスを攻略しないといけないということになっちゃったんだ」
	PRINTW 「あ、ペルソナっていうのは、人の可能性のひとつというか、心の力というか」
	PRINTW 「んー、なんていうか悪魔の力を人に宿らせるみたいな？」
	PRINTW 「まぁそのへんはあとで実物をみてもらうのがはやいかな」
	PRINTW 「で、タルタロスっていうのはうちの学校が夜にだけ、塔に姿を変えるんだよ」
	PRINTW 「学校がとうとつに、塔になるなんて、まっとうじゃないんだけど」
	PRINTW 「中にはシャドウって化物がうようよしていて、ほんとうにやばくて、とうばつしなきゃなんだよ」
	PRINTW 「いまはまぁ、桐条君達に頑張ってもらってるんだけど」
	PRINTW 「あ、桐条君っていうのはいまの桐条グループの会長でね」
	PRINTW 「ペルソナ使いでもあって、同じくペルソナ使いの友人と一緒にタルタロスにアタックしてるんだよ」
	PRINTW 「で、色々あって僕が彼女達の指揮をとってるんだけど」
	PRINTW 「僕らはみんな素人だからね。どうもうまくいかないんだ」
	PRINTW 「そういうわけで、プロである君の協力を仰ぎたいというわけだ」
	PRINTW 「もちろん、僕も僕で頑張ってこのままアタックを続けるから」
	PRINTW 「君は君で、自由にアタックしてくれればいい」
	PRINTW 「ああでも、出来ればついでにペルソナの実戦データ収集に協力してくれると嬉しいんで」
	PRINTW 「ペルソナ使いを使ってくれると嬉しいかな」
	PRINTW 「実はそのために今日は一人用意してたり、用意がいいと仕事が容易になるからね」
	PRINTW 「まぁ、これはあくまで君への報酬であって、使わなくてもいいし、どうしようと自由なんだけどね」
	PRINTW 「あ、マヨーネさんに、君は奴隷商人だから、報酬も奴隷を渡すのが一番だって聞いたから」
	PRINTW 「これはあくまで手付金で、攻略が順調に行けば、月光館学園の生徒ならよりどれいみどりってかんじでいこうかと」
	PRINTW 「問題はあるまいよね」
	PRINTW 「あっと、忘れてた。ちゃんと意見も聞かないといけんと思ってたんだった」
	PRINTL 「奴隷は男と女、どっちのほうが好み？」
	CALL INPUT_YN("男", "女")
	IF RESULT == 0
		IF TALENT:MASTER:オトコ
			PRINTW 「うーん…そういう趣味があるのか…」
			PRINTW 「いやぁ、ちゃんとマヨーネさんに話を聞いて、両方用意することにしておいてよかった」
		ELSE
			PRINTW 「そうか。そうか。君みたいなきれいな人にかわいがってもらえるんなら」
			PRINTW 「彼もきっと喜ぶよ」
		ENDIF
		ダンジョンフラグ:70:(94)=1
		CALL ADD_NEW_COMPANION, [[キャラ:P3男主人公]],500
			LOCAL = GETCHARA([[キャラ:P3男主人公]])
	ELSE
		IF TALENT:MASTER:オトコ
			PRINTW 「まぁやっぱりそうだよね」
			PRINTW 「いや別に同性愛を否定するわけじゃないけど」
		ELSE
			PRINTW 「いわゆるレズってやつだね」
			PRINTW 「いやぁひとしれず、そう言うのが流行ってるとは聞いたけど実物をみれるなんて！」
		ENDIF
		ダンジョンフラグ:70:(94)=2
		CALL ADD_NEW_COMPANION, [[キャラ:P3女主人公]],500
		LOCAL = GETCHARA([[キャラ:P3女主人公]])
	ENDIF
	PRINTW 「うん、それじゃああとでここに連れてこさせるよ」
	PRINTW 「で、名前だけど…」
	PRINTL 奴隷の名前と愛称を決めます
	$INPUT_LOOP
	PRINTL 奴隷の名前を入力してください
	INPUTS
	NAME:LOCAL = %RESULTS%
	PRINTL 奴隷の愛称を入力してください
	INPUTS
	CALLNAME:LOCAL = %RESULTS%
	VARSET LOCALS
	IF NAME:LOCAL == LOCALS && CALLNAME:LOCAL == LOCALS
		IF ダンジョンフラグ:70:(94) == 1
			IF RAND:2
				NAME:LOCAL = 有里 湊
				CALLNAME:LOCAL = 湊
			ELSE
				NAME:LOCAL = 墓場 鬼太郎
				CALLNAME:LOCAL = キタロー
			ENDIF
		ELSE
			NAME:LOCAL = 主人 公子
			CALLNAME:LOCAL = ハム子
		ENDIF
	ENDIF
	PRINTFORML 名前　%NAME:LOCAL%
	PRINTFORML 愛称　%CALLNAME:LOCAL%
	PRINTL これでよろしいですか？
	CALL INPUT_YN
	SIF RESULT == 1
		GOTO INPUT_LOOP

	PRINTW ………
	PRINTW ……
	PRINTW …
	PRINTW 幾月はタルタロスとそこに巣食うシャドウについて、寒いダジャレまじりに説明すると帰っていった…
	PRINTFORMW %CALLNAME:MASTER%はタルタロス踏破指令を受け、%NAME:LOCAL%を手に入れた

	イベントフラグ:9:0 = 1

	ダンジョンフラグ:70:(10) = 1
	ダンジョンフラグ:70:(11) = 1
	ダンジョンフラグ:70:(12) = 1
	ダンジョンフラグ:70:(13) = 1
	ダンジョンフラグ:70:(14) = 1
	ダンジョンフラグ:70:(15) = 1
	ダンジョンフラグ:70:(16) = 0
	ダンジョンフラグ:70:(17) = 0
	ダンジョンフラグ:70:(18) = 0
	ダンジョンフラグ:70:(19) = 0
	ダンジョンフラグ:70:(20) = 0
	ダンジョンフラグ:70:(22) = 0
	ダンジョンフラグ:70:(23) = 0
	;鬼太郎貰ってたらいない
	SIF ダンジョンフラグ:70:(94) != 2
		ダンジョンフラグ:70:(10) = (-1)
	;ハム子貰ってたらいない
	SIF ダンジョンフラグ:70:(94) != 1
		ダンジョンフラグ:70:(11) = (-1)

ELSEIF イベントフラグ:9:0 == 1
	PRINTFORMW タルタロスの奥まで潜りつつ%CALLNAME:MASTER%の元に、
	PRINTW 突然用があると言い、幾月が訪れた。
	PRINTL 
	PRINTW 「突然済まないね」
	PRINTW 「君がタルタロスを制覇しつつあることは知ってるよ」
	PRINTW 「ただ僕の方で問題が起きてね」
	PRINTW 「桐条くんにアイギスって戦闘用ロボットを預け、一緒にタルタロスに潜らせてたんだけど」
	PRINTW 「タルタロスを潜ってる最中に行方不明になったんだ」
	PRINTW 「僕としては彼女を放って先に進むのもありだと思うんだけど」
	PRINTW 「どうも桐条君たちが彼女を見捨てられないらしくてね」
	PRINTW 「だから君の方で彼女を確保して欲しいんだ」
	PRINTW 「もちろん報酬は用意する」
	PRINTW 「それと、彼女の身柄はこちらに返しても、そのまま奴隷にしてくれても構わない」
	PRINTW 「なに、こっちにはまだ十分な人員がいるんだ。彼女ひとりくらいならいなくてもなんとかなるさ」
	PRINTW 「あと、もしかするとタルタロスの怪異現象に当てられて変なことになってるかもしれない」
	PRINTW 「その時は無理矢理にでも言い聞かせてくれ」
	PRINTW 「んじゃ、そういうわけでよろしく頼むよ」
	PRINTW ………
	PRINTW ……
	PRINTW …
	PRINTFORMW %CALLNAME:MASTER%は追加依頼を受けた。
	PRINTW タルタロスの新たな階への道が開けた気がする。
	イベントフラグ:9:0 = 2
ELSEIF イベントフラグ:9:0 == 2
	PRINTFORMW タルタロスのだいぶ奥まで潜った%CALLNAME:MASTER%に、
	PRINTW また話があると言うことで幾月の元を訪ねた。
	PRINTL 
	PRINTW 「うん、またなんだ。済まないね」
	PRINTW 「それはそうとタルタロスについて分かったことがあって」
	PRINTW 「あの塔には、１２の大型シャドウ……つまるところ、ボスがいるようなんだ」
	PRINTW 「そのシャドウはどうもタロットカードのⅠからⅩⅡまでのアルカナに対応してるらしい」
	PRINTW 「君の報告によれば、それらしき大型シャドウを１０体も倒したそうじゃないか」
	PRINTW 「となれば残りはあと２体ということになる」
	PRINTW 「でもね、実は以前　タルタロスの外でうちの桐条君たちが事前に１体倒していたらしくてね」
	PRINTW 「だから残りはあと１体、１２番目のアルカナ」
	PRINTW 「”刑死者”のシャドウと戦うことになると思う」
	PRINTW 「そいつを倒せば、きっと塔の頂上が見えるはずだ」
	PRINTW 「そこに何があるか、君の目で確かめて来てほしい」
	PRINTW ………
	PRINTW ……
	PRINTW …
	PRINTFORMW %CALLNAME:MASTER%は最後の依頼を受けた。
	PRINTW タルタロスの更なる階への道が開けた気がする。
	イベントフラグ:9:0 = 3
ELSEIF イベントフラグ:9:0 == 3

;原作同様 敵にしようとした、その名残

	PRINTFORMW タルタロスを登り詰め、幾月の依頼を達成した%CALLNAME:MASTER%。
	PRINTW ……だが、ある日ファントムソサエティからメールが来る。
	PRINTW 読みますか？
	CALL INPUT_YN("はい", "いいえ")
	IF RESULT == 0
		PRINTL 
		PRINTL 　内容はこうだ。
		PRINTL 
		PRINTW 『タルタロスに何らかの悪魔による強大な力場が発生している。
		PRINTW 　原因を調査し、可能ならその根源を排除しろ。』
		PRINTL 
		PRINTW 幾月は、もう大丈夫だと言っていたが、どういうことなのだろうか？
		PRINTL 
		PRINTW ………
		PRINTW ……
		PRINTW …
		PRINTFORMW %CALLNAME:MASTER%は調査任務を受けた。
		PRINTW タルタロスの頂上を今一度目指そう。
		イベントフラグ:9:0 = 4
	ENDIF
ENDIF
