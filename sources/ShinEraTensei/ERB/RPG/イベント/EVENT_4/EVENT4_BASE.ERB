;====================
;条件
;====================
@PLAYABLE_EVENT_4
#LOCALSIZE 4
LOCAL = STRFLAG_NUM_EV("罪ルート進行", , , , [[イベント:ペルソナ２]])
LOCAL:1 = STRFLAG_NUM_EV("罰ルート進行", , , , [[イベント:ペルソナ２]])
LOCAL:2 = STRFLAG_NUM_EV("ニャル進行", , , , [[イベント:ペルソナ２]])
LOCAL:3 = STRFLAG_NUM_EV("フィレモン進行", , , , [[イベント:ペルソナ２]])
;罪ルート2(七姉妹学園クリア後)
IF LOCAL == 2
	RESULTS = 仮面党討伐指令(1)
	RETURN 1
ENDIF
;罪ルート4(ゾディアッククリア後)
IF LOCAL == 4
	RESULTS = 仮面党討伐指令(2)
	RETURN 1
ENDIF
;罪ルート6(コンサートクリア後)
IF LOCAL == 6
	RESULTS = 仮面党討伐指令(3)
	RETURN 1
ENDIF
;罪ルート8(空の博物館クリア後かつニャルルート入ってない)
IF LOCAL == 8 && LOCAL:2 < 3
	RESULTS = ラストバタリオン撃退指令
	RETURN 1
ENDIF
IF LOCAL == 9 && LOCAL:2 < 3
	RESULTS = マイアの託宣
	RETURN 1
ENDIF
IF LOCAL == 11 && LOCAL:2 < 3
	RESULTS = 幻影のシバルバー
	RETURN 1
ENDIF
IF LOCAL:1 == 2
	RESULTS = 裏社会の噂屋
	RETURN 1
ENDIF
IF LOCAL:1 == 4
	RESULTS = ＪＯＫＥＲ呪い
	RETURN 1
ENDIF
IF LOCAL:1 == 5 && LOCAL:3 == 3
	RESULTS = イン・ラケチ
	RETURN 1
ENDIF
IF LOCAL:1 == 6
	RESULTS = 新世塾の暗躍
	RETURN 1
ENDIF
;#;RESULTS = ペルソナ２イベント
;#;RETURN 1
RETURN 0

