
; 依頼フラグ:13:0
; 1 依頼を受けれるようになった
; 2 依頼を受けた
; 3 姫宮を救出した
; 4 

;STRFLAG

;====================
;条件
;====================
@PLAYABLE_REQUEST_13
IF 依頼フラグ:13:0 == 0 && FLAG:名声 >= 150
	依頼フラグ:13:0 = 1
ENDIF
IF GROUPMATCH(依頼フラグ:13:0 , 1 , 2 , 3 , 4)
	RESULTS = 姫巫女救出依頼
	RETURN 1
ELSEIF GROUPMATCH(依頼フラグ:13:0 , 5)
	RESULTS = 大和神族解放
	RETURN 1
ENDIF
RETURN 0

;====================
;説明
;====================
@EXPLAIN_REQUEST_13
SELECTCASE 依頼フラグ:13:0
	CASE 1
		PRINTL
		PRINTL 明治神宮を拠点とする退魔組織"神宮の森"が先日とある敵対組織の襲撃を受け、明治神宮が制圧されてしまった。
		PRINTL 現在、メシア教の拠点にて"神宮の森"の長である姫巫女、「姫宮 菊枝」が監禁されているという。
		PRINTL 彼女を救出し、依頼人の元へと連れて来てほしい
		PRINTL 依頼人：ヒルコと名乗る人物
		PRINTL
	CASE 2
		PRINTL
		PRINTL ファクトリーエリアへと赴き、姫巫女「姫宮 菊枝」を救出しよう。
		PRINTL 協力者とはファクトリー・タウンの酒場で落ち合えるらしい。
		PRINTL その後の指示は救出後に伝えてくれるようだ。
		PRINTL
		RETURN 1
	CASE 3
		PRINTL
		PRINTL 依頼された通り、「姫宮 菊枝」を救出した。
		PRINTL 今後の指示を依頼人に仰ごう。
		PRINTL
	CASE 4
		PRINTL
		PRINTL ヒルコと名乗る依頼人は、赤坂の地下に潜伏しているらしい。
		PRINTL 依頼された通り、姫宮菊枝を彼の下へ送り届けよう。
		PRINTL
		RETURN 1
	CASE 5
		PRINTL
		PRINTL 今後国津神・天津神の解放に関するイベントはこの項目で実行します
		PRINTL 現在ここから先は未実装です
		PRINTL
		RETURN 1
ENDSELECT

;====================
;内容
;====================
@REQUEST_13
SELECTCASE 依頼フラグ:13:0
	CASE 1
		CALL MESSAGE_WINDOW, "", "＞指定された場所にやってきた/＞ボロボロの布きれで体全体を覆い隠した男がいる…"
		CALL MESSAGE_WINDOW, "しわがれた声の男", "………"
		CALL MESSAGE_WINDOW, "", "＞男が写真を見せてきた/＞気品の良さそうな、若く美しい女性が写っている"
		CALL MESSAGE_WINDOW, "しわがれた声の男", "ついこの間、メシア教と米軍とに明治神宮が襲撃を受けた"
		CALL MESSAGE_WINDOW, "しわがれた声の男", "……その結果として明治神宮は制圧され、/長である彼女は「ファクトリー」へと連れ去られてしまった"
		CALL MESSAGE_WINDOW, "しわがれた声の男", "「神宮の森」の者達も今や散り散りとなって、/残党による救出や奪還はおそらく不可能だそうだ"
		CALL MESSAGE_WINDOW, "しわがれた声の男", "あんたの腕と名は聞いている/どうか、彼女をあそこから救い出してはくれないか？"
		CALL INPUT_YN_M , "Yes" , "No"
		IF RESULT == 1
			CALL MESSAGE_WINDOW, "しわがれた声の男", "そうか……/……気にしないでくれ、/無茶な事を頼んでいるのはこちらも分かっている/……この話は聞かなかったことにしてくれ"
			CALL MESSAGE_WINDOW, "" , "＞みすぼらしい男は去って行った"
			依頼フラグ:13:0 = -1
		ELSE
			CALL MESSAGE_WINDOW, "しわがれた声の男", "そうか、ありがとう……"
			CALL MESSAGE_WINDOW, "しわがれた声の男", "さっき言った通り、/彼女はファクトリーの強制収容所に囚われているらしい/おそらく、メシア教徒が……/あるいはヘブライに与する悪魔も見張りについているかもしれない"
			CALL MESSAGE_WINDOW, "しわがれた声の男", "ファクトリー自体はトウキョウの地下のどこかにある事しか分からん/幸い、ファクトリーターミナルへの転送に必要なデータは入手できた/これがあれば侵入することはできるはずだ"
			CALL MESSAGE_WINDOW, "しわがれた声の男", "それから、協力者が情報を集めてくれている/酒場に行けば落ち合える事になっている/彼から情報を受け取って役立ててくれ"
			CALL MESSAGE_WINDOW, "しわがれた声の男", "彼女がどんな扱いを受けているかは分からないが/できるだけ早く助けてやってほしい"
			CALL MESSAGE_WINDOW, "しわがれた声の男", "報酬は出来るだけ多くを払うと約束する。/……すまないが、前金はこれだけしか払えない"
			CALL MESSAGE_WINDOW, "" , "古ぼけた小銭と擦り切れた紙幣、合わせて￥10000分を受け取った"
			CALL MESSAGE_WINDOW, "しわがれた声の男", "もしも無事に助けることが出来たなら、その時に我々の拠点を教えよう/では、頼んだぞ"
			CALL MESSAGE_WINDOW, "" , "＞みすぼらしい男は去って行った"
			MONEY += 10000
			依頼フラグ:13:0 = 2
			ダンジョンフラグ:[[ダンジョン:ファクトリー]]:0 = 1
			CALLF STRFLAG_NUM_REQ("依頼を受けた日" , "=" , , DAY)
		ENDIF
	CASE 3
		CALL MESSAGE_WINDOW, "", @"＞…%CALLNAME:MASTER%に宛てたらしい手紙が届いている"
		CALL MESSAGE_WINDOW, "手紙", "無事に姫宮様を救出なされた事にお礼を言わせて頂きます/現在、我々は赤坂の地下にて隠れ住んでおります/つきましては、我々の元へ姫宮様を護衛し、送り届けていただきますよう願います/報酬もそこでお支払いいたします"
		CALL MESSAGE_WINDOW, "", @"＞どうやら赤坂へ行く必要があるようだ"
		依頼フラグ:13:0 = 4
		ダンジョンフラグ:[[ダンジョン:赤坂]]:0 = 1
		
ENDSELECT



