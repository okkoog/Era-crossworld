;====================
;関連フラグリスト
;====================
;FLAG:ナイト・テイル進行度
;	(；´∀｀)途中から変数の仕様が変わってます。見づらくてｽﾏﾝﾇ
;====================
;条件
;・基本的に古代ちゃん必須。出撃可能な状態＝あなたと優良な関係で残存していないと、依頼自体が消滅する。
;・依頼：幻想の王国１は摩耶の残存も条件（売っちゃったり削除してるとT.D.Lでユーリアを倒すしかなくなる
;・依頼：幻想の王国２は摩耶・宮下・香鈴・結城の残存も条件（売っちゃったり削除しているとT.D.Lでユーリアを倒すしかなくなる
;・依頼：幻想の王国１、２はT.D.Lでユーリアと出会っていると強制的にスキップされる
;====================
@PLAYABLE_REQUEST_50
IF イベントフラグ:30:0 == 1 && FLAG:ナイト・テイル進行度 < 1 && FINDCHARA_B(4559) > 0
	RESULTS = 依頼：ヤコブの梯子　“MEN IN BLACK”
	RETURN 1
ELSEIF FLAG:ナイト・テイル進行度 < 2 && FINDCHARA_B(4559) > 0
	RESULTS = 依頼：モーリアン強襲　“Einstein's　 posthumous works”
	RETURN 1
ELSEIF FLAG:ナイト・テイル進行度 < 3 && FINDCHARA_B(4559) > 0
	RESULTS = 依頼：堕天使たちの宴　“Blood　Diamond”
	RETURN 1
ELSEIF FLAG:ナイト・テイル進行度 < 4 && FINDCHARA_B(4559) > 0
	RESULTS = 依頼：龍神より愛を込めて　“Caribbean　Blue”
	RETURN 1
;ここは摩耶ちゃんも必須＆T.D.Lでユーリアと出会っていない。
ELSEIF FLAG:ナイト・テイル進行度 < 5 && FINDCHARA_B(4559) > 0 && FINDCHARA_B(4628) > 0 && ダンジョンフラグ:35:8 < 1
	RESULTS = 依頼：幻想の王国　“Reverse　Land”
	RETURN 1
;摩耶・結城・宮下・香鈴必須＆T.D.Lでユーリアと出会っていない。
ELSEIF FLAG:ナイト・テイル進行度 < 6 && FINDCHARA_B(4559) > 0 && FINDCHARA_B(4632) > 0 && FINDCHARA_B(4628) > 0 && FINDCHARA_B(4630) > 0 && FINDCHARA_B(4631) > 0 && ダンジョンフラグ:35:8 < 1
	RESULTS = 依頼：幻想の王国(2)　“Never　Never　Land　Story”
	RETURN 1


;FLAG:ナイト・テイル進行度 == 6　に相当する部分はEVENT_50


;ユーリアと出会ってしまっている場合、幻想の王国がスキップされる
ELSEIF FLAG:ナイト・テイル進行度 == 700000 && FINDCHARA_B(4559) > 0
;	RESULTS = 依頼：伝説の帰還　“Return　of　『J』”
;	RETURN 1
ELSEIF FLAG:ナイト・テイル進行度 == 700 && FINDCHARA_B(4559) > 0 || ((FLAG:ナイト・テイル進行度 == 5 || FLAG:ナイト・テイル進行度 == 4) && ダンジョンフラグ:35:8 > 0)
;	RESULTS = 依頼：伝説の帰還　“Return　of　『J』”
;	RETURN 1
	
	
;幻想の王国(2)を通っていない場合or通っていてもファントムの力で突破した場合、上のルート
ELSEIF FLAG:ナイト・テイル進行度 == 800 && FINDCHARA_B(4559) > 0
;	RESULTS = 終焉：神々の黄昏　“bay-bay　JUPITER”
;	RETURN 1
ELSEIF FLAG:ナイト・テイル進行度 == 800000 && FINDCHARA_B(4559) > 0
;	RESULTS = 未来：ボクはそういう神になる。　“La Maternite.”
;	RETURN 1
ENDIF
RETURN 0

