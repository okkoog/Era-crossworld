
;====================
;条件
;====================
@PLAYABLE_REQUEST_2
IF 依頼フラグ:2:0 == 0
	RESULTS = 軽子坂高校体育館(1)
	RETURN 1
ENDIF
RETURN 0
;====================
;説明
;====================
@EXPLAIN_REQUEST_2
IF 依頼フラグ:3:0
	PRINTL
	PRINTFORML 前回悪魔を倒した軽子坂高校体育館に再び悪魔が巣食ってしまったらしい。
	PRINTFORML また、付近では魔神皇に協力する人間の姿も発見されている。
	PRINTFORML 再び体育館に赴き、妨げるものがあればこれを排除せよ。
	PRINTL
ELSE
	PRINTL
	PRINTFORML 軽子坂高校という学校が魔神皇と名乗る者の手によって魔界へと落ちてしまった。
	PRINTFORML 生徒達は散り散りとなって校内に幽閉されており、中には勇敢にも悪魔達と戦う者すら居るそうだ。
	PRINTFORML そうした生徒達の救助と学校の魔界からの開放を依頼したいとのことだ。
	PRINTFORML まずは体育館に救う悪魔を倒し、安全な進入経路を確保せよ。
	PRINTL
ENDIF

;====================
;内容
;====================
@REQUEST_2
FLAG:逃走不可フラグ = 1
FLAG:会話不能フラグ = 1
FLAG:先制不意打ちキャンセル = 1
CUSTOMDRAWLINE =
PRINTL ―軽子坂高校体育館―
PRINTW 体育館の床には謎の魔法陣が描かれている。
PRINTW そこで、学生が一体の魔獣と闘っているが、あっさりと倒されてしまった。
PRINTL 魔獣　メリジェーヌが一体出た！

CUSTOMDRAWLINE =
WAIT
CALL SET_ENEMY,9,802,9,0,1
ABL:(CHARANUM-1):スキル3 = [[スキル:マリンカリン]]
CALL BATTLE_START
CUSTOMDRAWLINE =
PRINTL メリジェーヌは力尽きた
CUSTOMDRAWLINE =
WAIT
PRINTW 魔獣と闘っていた学生のうち、不良風の女生徒を確保した。
CALL ADD_NEW_COMPANION,4502,500,0
SIF RESULT == 1
	CFLAG:(RESULT:1):戦闘参加不可能 = -1

依頼フラグ:2:0 = 1

IF 依頼フラグ:3:0 == 1
	PRINTFORMW 学校から立ち去ろうとした%CALLNAME:MASTER%の前に白衣の男が立ちはだかった。
	PRINTW 「出入り出来ない筈の学校で好き勝手をしているのはお前だな。　学生でもない癖に、ここで何をしている！？」
	PRINTW 「……まぁいい、いずれにせよお前には死あるのみ！」
	PRINTW 「お前がここから無事に出ていける科学的根拠は無いのだ！」
	PRINTL 教師　オオツキが一体出た！
	CUSTOMDRAWLINE =
	WAIT
	SIF FLAG:24210 == 0
		FLAG:24210 = 1
	CALL SET_ENEMY,9,4210,15,0,1
	CALL BATTLE_START
	CUSTOMDRAWLINE =
	PRINTL ＞オオツキは力尽きた。
	PRINTW 「ば、バカな……科学的根拠を……示せ……」
	PRINTFORML ＞%CALLNAME:MASTER%は45の名声を得た
	CUSTOMDRAWLINE =
	WAIT
	FLAG:名声 += 45
ENDIF

FLAG:逃走不可フラグ = 0
FLAG:会話不能フラグ = 0
FLAG:先制不意打ちキャンセル = 0

FOR LOCAL,0,CHARANUM
	CALL HEALTH_CHARA,LOCAL
NEXT


