@PLAYABLE_OUKOKUYA_REQ_10
RESULTS = 夢幻の逢瀬
RETURN !GETBIT(依頼フラグ:40:0, 10)

@EXPLAIN_OUKOKUYA_REQ_10
RESULTS = 
RESULTS += "/夢幻の逢瀬(依頼者:アンソニー)/"
RESULTS += "難度:☆/"
RESULTS += "報酬:1000魔貨及び耐力の香/"
RESULTS += "/条件/"
RESULTS += "妖魔 リリム/"
RESULTS += "能力[Ｃ感覚]がLv3以上 能力[Ｂ感覚が]Lv3以上 能力[Ｖ感覚]がLv2以上/"
RESULTS += "/備考/"
RESULTS += "女悪魔にホレちまったんだ。あー、いや待て…ちょっと違うかも/"
RESULTS += "つまりだ…夢に出てきたんだよ。その女悪魔が/"
RESULTS += "コレが飛び切りの可愛いコでさぁ…。しかも色々いいコトまでしてくれる/"
RESULTS += "いやー、オレはすっかりメロメロだ/"
RESULTS += "だがやっぱり会うんだったら、起きてる時に会いたいモンさ /"
RESULTS += "彼女の名前はリリムっていうらしい/"
RESULTS += "あー、それと俺の方も彼女を満足させたいから準備も頼むぜ！/"
RESULTS += "まず感覚をあげてそれで従順や欲望をあげるのが、調教の定石って話だし、問題ないよな！"

@CHARASELLABLE_OUKOKUYA_REQ_10
SIF NO:COUNT != [[キャラ:リリム]]
	RETURN 0
SIF ABL:COUNT:Ｃ感覚 < 3
	RETURN 0
SIF ABL:COUNT:Ｂ感覚 < 3
	RETURN 0
SIF ABL:COUNT:Ｖ感覚 < 2
	RETURN 0
RETURN 1

;--------------------------------------------------------
;報酬処理
;ただし、売却人数・属性変動などは共通で処理済み
;調教師名声の処理はされてないので適宜処理してください
;
;ARGはキャラクター
;--------------------------------------------------------
@TAKE_REWARD_OUKOKUYA_REQ_10, ARG
CALL MESSAGE_WINDOW, "", @"＞依頼を達成し/＞1000魔貨と耐力の香を手に入れました", , , , , 4
CALL GET_ITEMS, "耐力の香", 1
MONEY:1 += 1000
FLAG:調教師名声 += 20
