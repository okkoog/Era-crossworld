@CHARASELLABLE_OUKOKUYA_REQ_22
SIF !(IS_MALE(COUNT) || (ABL:COUNT:レズっ気 >= 3 && ABL:COUNT:レズ中毒 >= 1))
	RETURN 0
SIF !TALENT:COUNT:治療
	RETURN 0
SIF ABL:COUNT:サドっ気 < 5
	RETURN 0
RETURN 1

;--------------------------------------------------------
;報酬処理
;ただし、売却人数・属性変動などは共通で処理済み
;調教師名声の処理はされてないので適宜処理してください
;
;ARGはキャラクター
;--------------------------------------------------------
@TAKE_REWARD_OUKOKUYA_REQ_22, ARG
#LOCALSIZE 1
CALL CHARA_SELL, ARG, 1
LOCAL = RESULT
LOCAL = LOCAL * 125 / 100
CALL MESSAGE_WINDOW, "", @"＞依頼を達成し/＞{LOCAL}魔貨\@!ITEM:コペルニクス ?とコペルニクス#\@を手に入れました", , , , , 4
SIF !ITEM:コペルニクス
	CALL GET_ITEMS, "コペルニクス", 1
MONEY:1 += LOCAL
FLAG:調教師名声 += LOCAL / 100
