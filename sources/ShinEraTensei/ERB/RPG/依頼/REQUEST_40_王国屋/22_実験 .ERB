@PLAYABLE_OUKOKUYA_REQ_22
RESULTS = 実験
SIF GETBIT(依頼フラグ:40:0, 22)
	RETURN 0
;ある程度調教師名声が必要
SIF FLAG:調教師名声 < 400
	RETURN 0
RETURN 1
