;--------------------------------------------------------
;報酬処理
;ただし、売却人数・属性変動などは共通で処理済み
;調教師名声の処理はされてないので適宜処理してください
;
;ARGはキャラクター
;--------------------------------------------------------
@TAKE_REWARD_OUKOKUYA_REQ_20, ARG
#LOCALSIZE 1
CALL CHARA_SELL, ARG, 1
LOCAL = RESULT
LOCAL = LOCAL * 125 / 100
CALL MESSAGE_WINDOW, "", @"＞依頼を達成し/＞{LOCAL}魔貨\@!ITEM:エネミーホイホイ ?とエネミーホイホイ#\@を手に入れました", , , , , 4
SIF !ITEM:エネミーホイホイ
	CALL GET_ITEMS, "エネミーホイホイ", 1
MONEY:1 += LOCAL
FLAG:調教師名声 += LOCAL / 100
