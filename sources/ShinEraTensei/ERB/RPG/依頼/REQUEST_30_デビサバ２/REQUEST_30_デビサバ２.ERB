;-------------------------------------------------------------------------------
; 【当ファイルについて】
; 当ファイルはデビルサバイバー２のイベントをCALLするだけの、メインファイルである。
; 詳細な処理は各サブファイルに記載する。
; （サブファイルは日付ごとに１ファイル用意する）
;
;
; 【フラグについて】
; デビルサバイバー２のイベントでは、"FLAG:デビサバ２進行度"を使用している。
; ３桁の数値が以下の仕様で設定される。
;
; ・３桁目…日付区分。０～７
; ・２桁目…イベント区分。０～９
; ・１桁目…イベント詳細区分。０～９
;
; ◆例
; 例えば一日目の場合は、000～099を使用出来る。
; この内イベントごとに、0～9の詳細区分を使用可能。
; その為、例えば[ドゥベ戦]と[イオ加入]の二つのイベントを一日目に入れたい場合、
;
;	・[ドゥベ戦] … 000～009
;	・[イオ加入] … 010～019
;
; といった形でフラグを使用出来る。
; 具体的なフラグの割り振り方は、
; 各日付ごとのサブファイルを参照すれば詳細が確認出来る。
;
;-------------------------------------------------------------------------------

;===============================================================================
;  ◇記載関数一覧(記載順)
;
;		Module Name						Explanation
;
;	・ PLAYABLE_REQUEST_xxx				依頼:条件
;	・ EXPLAIN_REQUEST_xxx				依頼:説明
;	・ REQUEST_xxx						依頼:メイン処理
;	・ EVENT_BATTLE_TURNEND_REQUESTxxx	依頼:戦闘中処理(ターン終了時)
;
; *- 独自関数
;
;	・ REQUEST_30_FLAG_RESET			依頼:フラグリセット
;	・ REQUEST_30_DAY_TITLE				依頼:一日のタイトル
;	・ REQUEST_30_DAY_END				依頼:一日の終了
;	・ REQUEST_30_TURN_END				依頼:ターンの終了
;	・ REQUEST_30_BASE_LV				依頼:基礎レベル
;
;===============================================================================


;====================
;条件
;====================
@PLAYABLE_REQUEST_30
#DIM DYNAMIC L_FLAG_REQ
#DIM DYNAMIC L_FLAG_EVENT_DIGIT

;-----------------------------
;- 共通チェック
;-----------------------------

;- デバッグ
IF FLAG:DEBUG
	;OK

;- 主人レベル30以上
ELSEIF BASE:MASTER:LV >= 30
	;OK

ELSE
	;NG
	RETURN 0
ENDIF

;-----------------------------
;- 処理開始
;-----------------------------

;- フラグをセット
L_FLAG_REQ = FLAG:デビサバ２進行度

;- フラグをセット(イベントフラグ:２桁目)
L_FLAG_EVENT_DIGIT = L_FLAG_REQ % 100


SELECTCASE L_FLAG_REQ
	;-----------------------------
	;- [1ST DAY]
	;-----------------------------
	CASE 000 TO 099

		;- CHK:イベントフラグ
		SELECTCASE L_FLAG_EVENT_DIGIT
			; [00-09] 戦闘:ドゥベ
			CASE 00 TO 09
				RESULTS = 日本政府組織からの極秘任務
				RETURN 1
			; [10-19] イオ加入
			CASE 10 TO 19
				RESULTS = ジプスへ人材回収（1ST DAY）
				RETURN 1
		ENDSELECT

	;-----------------------------
	;- [2ND DAY]
	;-----------------------------
	CASE 100 TO 199
		;- CHK:イベントフラグ
		SELECTCASE L_FLAG_EVENT_DIGIT
			; [00-09] 戦闘:ハッカー
			CASE 00 TO 09
				RESULTS = ジプスからの依頼（2ND DAY）
				RETURN 1
			; [10-19] 戦闘:メラク
			CASE 10 TO 19
				RESULTS = ジプスからの依頼（2ND DAY - 大阪）
				RETURN 1
		ENDSELECT


	;-----------------------------
	;- [3RD DAY]
	;-----------------------------
	CASE 200 TO 299
		;- CHK:イベントフラグ
		SELECTCASE L_FLAG_EVENT_DIGIT
			; [00-09] 戦闘:ボティス
			CASE 00 TO 09
				RESULTS = ジプスからの依頼（3RD DAY）
				RETURN 1
			; [10-19] 戦闘:名古屋支局
			CASE 10 TO 19
				RESULTS = ジプスからの依頼（3RD DAY - 名古屋）
				RETURN 1
		ENDSELECT

	;-----------------------------
	;- [4TH DAY]
	;-----------------------------
	CASE 300 TO 399
		;- CHK:イベントフラグ
		SELECTCASE L_FLAG_EVENT_DIGIT
			; [00-09] メグレズ
			CASE 00 TO 09
				RESULTS = ジプスからの依頼（4TH DAY）
				RETURN 1
			; [10-19] メグレズ対策会議
			CASE 10 TO 19
				RESULTS = ジプスからの依頼（4TH DAY - メグレズ対策会議）
				RETURN 1
			; [20-29] ニカイアの主
			CASE 20 TO 29
				RESULTS = ジプスからの依頼（4TH DAY - 東京）
				RETURN 1
			; [30-39] デルタ浮上戦
			CASE 30 TO 39
				RESULTS = ジプスからの依頼（4TH DAY - デルタ浮上戦）
				RETURN 1
		ENDSELECT

	;-----------------------------
	;- 終了
	;-----------------------------
	CASE 1000
		RETURN 0

	;- 作成中
	CASEELSE
		RESULTS = ジプスからの連絡(待機命令)
		RETURN 1

ENDSELECT

;念の為
RETURN 0

