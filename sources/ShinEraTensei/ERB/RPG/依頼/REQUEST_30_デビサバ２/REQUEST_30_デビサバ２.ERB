;====================
;内容
;====================
@REQUEST_30

;-----------------------------
;- 処理開始
;-----------------------------

PRINTL

SELECTCASE FLAG:デビサバ２進行度
	;-----------------------------
	;- 1ST DAY
	;-----------------------------
	CASE 000 TO 099
		;- 依頼:メイン処理(1ST DAY)
		CALL REQUEST_30_1

	;-----------------------------
	;- 2ND DAY
	;-----------------------------
	CASE 100 TO 199
		;- 依頼:メイン処理(2ND DAY)
		CALL REQUEST_30_2

	;-----------------------------
	;- 3RD DAY
	;-----------------------------
	CASE 200 TO 299
		;- 依頼:メイン処理(3RD DAY)
		CALL REQUEST_30_3

	;-----------------------------
	;- 4TH DAY
	;-----------------------------
	CASE 300 TO 399
		;- 依頼:メイン処理(4TH DAY)
		CALL REQUEST_30_4

	;-----------------------------
	;- 作成中
	;-----------------------------
	CASEELSE

			PRINTFORMW ＞自宅の一室。
;-------------------------------------------------
;			PRINTFORMW ＞依頼を確認したが、どうやらまだこの続きのイベントが作成されていない様だ。
;			PRINTFORMW ＞デビサバ２関連のイベントは、ひとまず現在で全て完了したらしい。
;			PRINTFORMW ＞イベントが作成されれば、依頼のタイトルも変わるだろう。
;-------------------------------------------------
			PRINTFORMW ＞依頼を確認したが、どうやらまだ続きが出来ていない様だ。
			PRINTFORMW ＞続きが作成されれば、依頼のタイトルも変わるだろう。
			PRINTFORMW ＞…気長に待つ事にしよう。
			PRINTFORMW ＞………
			PRINTFORMW ＞……
			PRINTFORMW ＞…

ENDSELECT



;=================================================
;   sub EVENT_BATTLE_TURNEND_REQUESTxxx
;=================================================
;   依頼:戦闘中処理(ターン終了時)
;-------------------------------------------------
;   CALL先でフラグを設定
;-------------------------------------------------
@EVENT_BATTLE_TURNEND_REQUEST30
#DIM DYNAMIC L_FLAG_DAYS_DIGIT

;- フラグをセット(３桁目)
L_FLAG_DAYS_DIGIT = 1 + FLAG:デビサバ２進行度 / 100

;-----------------------------
;- 処理開始
;-----------------------------

;- 存在する場合だけ呼び出し
TRYCALLFORM EVENT_BATTLE_TURNEND_REQUEST30_{L_FLAG_DAYS_DIGIT}


