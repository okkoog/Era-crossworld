;=================================================
;   sub REQUEST_30_FLAG_RESET
;=================================================
;   依頼:フラグリセット
;-------------------------------------------------
;   MENU画面で「依頼出現」が出る様、
;   依頼登録フラグをリセットする
;-------------------------------------------------
@REQUEST_30_FLAG_RESET
#DIM DYNAMIC L_REQUEST_NO

L_REQUEST_NO = 30

;- フラグがONの場合、クリアしてOFFに変更
SIF GETBIT(FLAG:依頼出現1,L_REQUEST_NO)
	CLEARBIT  FLAG:依頼出現1,L_REQUEST_NO


