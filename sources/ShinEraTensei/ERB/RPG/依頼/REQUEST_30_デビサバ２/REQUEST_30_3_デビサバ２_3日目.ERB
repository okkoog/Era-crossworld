;=================================================
;   sub EVENT_BATTLE_TURNEND_REQUESTxxx_yyy
;=================================================
;   依頼:戦闘中処理(ターン終了時)
;-------------------------------------------------
;   FLAG:勝利フラグに1をセットすると、戦闘を強制終了出来る
;   FLAG:敗北フラグに1をセットすると、ゲームオーバーに出来る
;-------------------------------------------------
@EVENT_BATTLE_TURNEND_REQUEST30_3
#DIM L_FLAG_EVENT_DIGIT
#DIM L_TMP
#DIM L_CNT
#DIM L_I

;- フラグをセット(イベントフラグ:２桁)
L_FLAG_EVENT_DIGIT = FLAG:デビサバ２進行度 % 100

;-----------------------------
;- 処理開始
;-----------------------------

SELECTCASE L_FLAG_EVENT_DIGIT
	;-----------------------------
	;- 16:戦闘中(フェクダ)
	;-----------------------------
	CASE 16
		;-------------------------------------------------
		;- 5ターン毎に分裂→合体→分裂→合体...を繰り返す
		;-------------------------------------------------

		;初回は処理無し
		IF FLAG:経過ターン数 == 0

		;5ターン毎
		ELSEIF (FLAG:経過ターン数 % 5) == 0

			;- 残存キャラ数を取得
			L_TMP=0
			L_CNT=0
			L_I = -1
			WHILE 1
				SIF CHARANUM == (L_I + 1)
					BREAK
				L_I = FINDCHARA(NO, [[キャラ:フェクダ]], L_I + 1)
				SIF L_I < 0
					BREAK
				L_CNT ++
				L_TMP = MAX(L_TMP,BASE:L_I:ＨＰ)
				;先に切り離しておく
				CALL REMOVE_POSITION,CFLAG:L_I:ポジション
			WEND

			;- 残存キャラを除外
			L_I = -1
			WHILE 1
				SIF CHARANUM == (L_I + 1)
					BREAK
				L_I = FINDCHARA(NO, [[キャラ:フェクダ]], L_I + 1)
				SIF L_I < 0
					BREAK
				DELCHARA L_I
				;減算
				L_I --
			WEND

			;-----------------------------
			;- 一体しか居ない場合は、分裂処理
			;-----------------------------
			IF L_CNT == 1

				CUSTOMDRAWLINE =
				PRINTFORML
				;- 赤
				SETCOLOR 0xFF0000
				PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━┓
				PRINTFORML ┃　　　　　　　　　　　　　　　　　　　　　　　┃
				PRINTFORML ┃フェクダは分裂を行った…！　　　　　　　　　　┃
				PRINTFORML ┃　　　　　　　　　　　　　　　　　　　　　　　┃
				PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━┛
				PRINTFORML 
				RESETCOLOR

				;- SET:フェクダα（物理弱点）
				CALL SET_ENEMY,8,[[キャラ:フェクダ]],REQUEST_30_BASE_LV(3),1,1
				CALLNAME:(CHARANUM-1) = フェクダα
				CFLAG:(CHARANUM-1):ＨＰ補正 = 1000
				CFLAG:(CHARANUM-1):ＭＰ補正 = 1000
				CFLAG:(CHARANUM-1):速度補正 = 15
				CFLAG:(CHARANUM-1):行動回数 = 2
				;スキル
				ABL:(CHARANUM-1):スキル1 = [[スキル:マハ・ジオンガ]]
				ABL:(CHARANUM-1):スキル2 = [[スキル:マハ・ブフーラ]]
				ABL:(CHARANUM-1):スキル3 = [[スキル:マハ・ザンマ]]
				ABL:(CHARANUM-1):スキル4 = [[スキル:暗黒の雷光]]
				ABL:(CHARANUM-1):スキル5 = 0
				ABL:(CHARANUM-1):スキル6 = 0
				ABL:(CHARANUM-1):スキル7 = 0
				ABL:(CHARANUM-1):スキル8 = 0
				;耐性(物理弱点)
				MAXBASE:(CHARANUM-1):剣撃 = 150
				MAXBASE:(CHARANUM-1):打撃 = 150
				MAXBASE:(CHARANUM-1):戦技 = 150
				BASE:(CHARANUM-1):剣撃 = MAXBASE:(CHARANUM-1):剣撃
				BASE:(CHARANUM-1):打撃 = MAXBASE:(CHARANUM-1):打撃
				BASE:(CHARANUM-1):戦技 = MAXBASE:(CHARANUM-1):戦技
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				BASE:(CHARANUM-1):ＨＰ = L_TMP

				;- SET:フェクダβ（4属性弱点）
				CALL SET_ENEMY,10,[[キャラ:フェクダ]],REQUEST_30_BASE_LV(3),1,1
				CALLNAME:(CHARANUM-1) = フェクダβ
				CFLAG:(CHARANUM-1):ＨＰ補正 = 1000
				CFLAG:(CHARANUM-1):ＭＰ補正 = 1000
				CFLAG:(CHARANUM-1):速度補正 = 15
				CFLAG:(CHARANUM-1):行動回数 = 2
				;スキル
				ABL:(CHARANUM-1):スキル1 = [[スキル:絶妙打]]
				ABL:(CHARANUM-1):スキル2 = [[スキル:百烈突き]]
				ABL:(CHARANUM-1):スキル3 = 0
				ABL:(CHARANUM-1):スキル4 = 0
				ABL:(CHARANUM-1):スキル5 = 0
				ABL:(CHARANUM-1):スキル6 = 0
				ABL:(CHARANUM-1):スキル7 = 0
				ABL:(CHARANUM-1):スキル8 = 0
				;耐性(4属性弱点)
				MAXBASE:(CHARANUM-1):火炎 = 150
				MAXBASE:(CHARANUM-1):氷結 = 150
				MAXBASE:(CHARANUM-1):電撃 = 150
				MAXBASE:(CHARANUM-1):衝撃 = 150
				BASE:(CHARANUM-1):火炎 = MAXBASE:(CHARANUM-1):火炎
				BASE:(CHARANUM-1):氷結 = MAXBASE:(CHARANUM-1):氷結
				BASE:(CHARANUM-1):電撃 = MAXBASE:(CHARANUM-1):電撃
				BASE:(CHARANUM-1):衝撃 = MAXBASE:(CHARANUM-1):衝撃
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				BASE:(CHARANUM-1):ＨＰ = L_TMP

			;-----------------------------
			;- 二体居る場合は、合体処理
			;-----------------------------
			ELSE
				CUSTOMDRAWLINE =
				PRINTFORML
				;- 赤
				SETCOLOR 0xFF0000
				PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━┓
				PRINTFORML ┃　　　　　　　　　　　　　　　　　　　　　　　┃
				PRINTFORML ┃フェクダは合体を行った…！　　　　　　　　　　┃
				PRINTFORML ┃　　　　　　　　　　　　　　　　　　　　　　　┃
				PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━┛
				PRINTFORML 
				RESETCOLOR

				;- SET:フェクダ
				CALL SET_ENEMY,9,[[キャラ:フェクダ]],REQUEST_30_BASE_LV(3),1,1
				CFLAG:(CHARANUM-1):ＨＰ補正 = 1000
				CFLAG:(CHARANUM-1):ＭＰ補正 = 1000
				CFLAG:(CHARANUM-1):速度補正 = 15
				CFLAG:(CHARANUM-1):行動回数 = 2
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				BASE:(CHARANUM-1):ＨＰ = L_TMP

			ENDIF
			RETURN
		ENDIF

ENDSELECT
