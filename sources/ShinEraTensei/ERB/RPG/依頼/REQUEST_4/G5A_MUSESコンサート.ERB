;-----------------------------------------------------------
;プリンストーラス思考パターン
;なんか銃持ってるよねこれ、ということで銃キャラにする予定
;予定としては属性特殊弾全部を持つ、つまり破魔呪殺暗黒火炎氷結電撃飛具＋マグナ系の8属性もち
;まぁそのまま8属性使うとかやられても困るので、最後の行動で、フロスト弾を装填した、なんかのMESSAGEをだして
;次回の攻撃を予告する感じに、銃ダメは単発30か50くらいかなぁ。まぁ、銃攻撃を直接指定して調整します
;武器はショットガンで列攻撃だけど、後列にも届かないと話にならないんで、ボス専用銃を作ります
;で、COOPダメは300くらいにして、銃ダメはそこまででもないけど、COOPとられると即死亡な感じにしたい
;
;暗黒マハマグナ飛具まで含めて常に5属性を撃ってくる可能性がある
;ってのはちょっとえぐいなぁ、と思ったので暗黒マハマグナを原作通り混乱付与にして呪殺カットで1属性減らす
;さらに特殊弾は1回目はランダム、2回目の特殊弾は前列を、3回目の特殊弾は後列を狙う
;特殊弾は1回目は0~20%で、2回目は20%~60%、3回目は20%固定なんで、後列はかなり安全度高い
;つまり、気づけばだけど、後列はわりと安全
;っていっても、そうそう気づかないし、たちっぱはあぶない選択肢なんで、やっぱ弱点なしが強いですね
;うーん、ペルソナ悪魔優遇できるかとおもったけど、弱点なしの強さを思い知らされるわ
;次のレオさまーも、アタックチェンジタイプとして、単体狙いな代わりに耐性なしで受けると即死クラスにしようかなぁ
;
;4色髑髏を翳す→次のターンに単体に一撃600~700の4色属性の防御無視ダメージをだしてくる（GUARDした場合は150~200程度に減衰）
;ただ、これCOMP係があたると勝負にならないので、噂で仮面党の力をまったくうけつけない凄腕のサマナーがいる…の噂を流していると、主人公にのみ0ダメ固定
;これなら、耐性＆弱点もちのほうが、耐性なしより有利になるし、問題は仲魔のうち水撃・火炎・地変・疾風のうち1属性はともかく2属性以上に耐性を持つのは厳しいよなぁ…wってことか
;ニャルルートだと、そんな感じの強化版がでて、他ルートだと通常版が出ることにしようかしらん。ニャルルートはペルソナ好きなんだから、ペルソナ使い有利な敵でいいよね…
;ペルソナ２キャラの加入が少ないルートだけど
;
;これだとガードに弱すぎ（なるべく入替えをして欲しい）なんで、ガード崩し弾を実装して
;ガード崩し弾→弱点弾で同一ターンに2回あたってしまうと、COOPとられる仕様にする感じに
;
;対策はPチェンジ・悪魔入れ替えもありますが、仕様的に弱点取れない相手にたいして火力不足になるだろうから
;人間のばあい、弱点さえ作って置かなければ大丈夫かなぁ
;-----------------------------------------------------------
@SET_ACTION_トーラス, ARG
;確率生成、及びHP減少による確率補正を作成
LOCAL = RAND:100
LOCAL:1 = (100 - 現HP割合(ARG)) / 5
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:入力行動 = -1
CFLAG:ARG:ターゲット = -1
;使用弾丸指定
LOCALS = 特殊弾{RAND:2+1}
;1more時の行動
LOCAL:3 = FLAG:戦闘難易度 - 3 > 0 ? 10 + (FLAG:戦闘難易度 - 3) * 2 # 10
;1more時は至高の魔弾を撃ちこんでくる
IF CFLAG:ARG:１moreフラグ == 2
	CALL SET_BATTLE_STATUS(ARG, 10 * LOCAL:3, "銃攻撃")
	CFLAG:ARG:ターゲット = 17 + RAND:2
	CFLAG:ARG:入力行動 = [[スキル:至高の魔弾]]
	RETURN 0
ELSE
	CALL SET_BATTLE_STATUS(ARG, 8 * LOCAL:3, "銃攻撃")
ENDIF
;1ターン目　ノイズショットはここでしか使わない
;また、暗黒マハマグナもここでは来ない。コンボ考えなければ一番攻撃が甘い箇所
IF CFLAG:ARG:行動した回数 == 0
	;ノイズショットコンボフラグ
	LOCAL:2 = 0
	SELECTCASE LOCAL
		;ニャルルートでは30%~50%でノイズショットコンボを狙う
		;ガードしている味方がいるかどうかを見て、ガードしている味方がいる場合、そいつがいる列にノイズショットを打ち込んでくる
		;ガードしている相手がいない場合汎用に流れるけど、それで特殊弾撃ってくる率が減るということもないので注意
		CASE 0 TO 29 + LOCAL:1
			IF STRFLAG_NUM_EV("ニャル進行", , , , [[イベント:ペルソナ２]])
				IF RAND:3
					FOR LOCAL:3, 6, 0, -1
						IF POS(LOCAL:3) >= 0 && GET_STATE(CFLAG:(POS(LOCAL:3)):ステート) != "DYING" && CFLAG:POS(LOCAL:3):防御フラグ
							CFLAG:ARG:ターゲット = 17 + (LOCAL:3 > 3)
							CFLAG:ARG:入力行動 = EQUIP:ARG:特殊弾3
							EQUIP:ARG:特殊弾3 = [[スキル:ＧＵＮ]]
							LOCAL:2 = 1
							BREAK
						ENDIF
					NEXT
				ELSE
					FOR LOCAL:3, 1, 7
						IF POS(LOCAL:3) >= 0 && GET_STATE(CFLAG:(POS(LOCAL:3)):ステート) != "DYING" && CFLAG:POS(LOCAL:3):防御フラグ
							CFLAG:ARG:ターゲット = 17 + (LOCAL:3 > 3)
							CFLAG:ARG:入力行動 = EQUIP:ARG:特殊弾3
							EQUIP:ARG:特殊弾3 = [[スキル:ＧＵＮ]]
							LOCAL:2 = 1
							BREAK
						ENDIF
					NEXT
				ENDIF
			ENDIF
		;0%～20%で特殊弾を撃ちこんでくる
		CASE 30 + LOCAL:1 TO LOCAL:1 * 2
			CFLAG:ARG:入力行動 = EQUIP:ARG:LOCALS
			EQUIP:ARG:LOCALS = [[スキル:ＧＵＮ]]
	ENDSELECT
ELSEIF CFLAG:ARG:行動した回数 == 1
	;2回目の銃攻撃は前列狙い
	;ノイズショットコンボ,一回目でノイズショットを撃ってた場合、二回目は前列に特殊弾を打ち込む
	IF LOCAL:2
		CFLAG:ARG:ターゲット = 17
		CFLAG:ARG:入力行動 = EQUIP:ARG:LOCALS
		EQUIP:ARG:LOCALS = [[スキル:ＧＵＮ]]
	ELSE
		SELECTCASE LOCAL
			;40%~60%で特殊弾
			CASE 0 TO 39 + LOCAL:1
				CFLAG:ARG:入力行動 = EQUIP:ARG:LOCALS
				EQUIP:ARG:LOCALS = [[スキル:ＧＵＮ]]
				CFLAG:ARG:ターゲット = 17
			;10%~30%で暗黒マハ・マグナ
			CASE 40 + LOCAL:1 TO 30 + LOCAL:1 * 2
				CFLAG:ARG:入力行動 = [[スキル:暗黒マハ・マグナ]]
		ENDSELECT
	ENDIF
ELSE
	;ノイズショットコンボ、残ってるほうの弾を後列に撃ちこんでくる
	IF LOCAL:2
		CFLAG:ARG:入力行動 = MAX(EQUIP:ARG:特殊弾1, EQUIP:ARG:特殊弾2)
		EQUIP:ARG:特殊弾1 = [[スキル:ＧＵＮ]]
		EQUIP:ARG:特殊弾2 = [[スキル:ＧＵＮ]]
		CFLAG:ARG:ターゲット = 17
		SIF POS(4) >= 0 || POS(5) >= 0 || POS(6) >= 0
			CFLAG:ARG:ターゲット = 18
	ELSE
		;2回目の銃攻撃は後列を狙う
		SELECTCASE LOCAL
			;30%で特殊弾
			CASE 0 TO 29
				CFLAG:ARG:入力行動 = EQUIP:ARG:LOCALS
				EQUIP:ARG:LOCALS = [[スキル:ＧＵＮ]]
				CFLAG:ARG:ターゲット = 17 + RAND:2
			;30%~50%で暗黒マハマグナ
			CASE 30 TO 59 + LOCAL:1
				CFLAG:ARG:入力行動 = [[スキル:暗黒マハ・マグナ]]
		ENDSELECT
	ENDIF
ENDIF
;確率再生成
LOCAL = RAND:100
;ここまで入力行動が決まってなかったら、汎用3種に行く
;GUNは特殊弾でも撃って来やすいので減らしとく
IF CFLAG:ARG:入力行動 == -1
	SELECTCASE LOCAL
		CASE 0 TO 29
			CFLAG:ARG:入力行動 = [[スキル:マリンカリン]]
		CASE 30 TO 79
			CFLAG:ARG:入力行動 = [[スキル:マグナス]]
		CASEELSE
			CFLAG:ARG:入力行動 = [[スキル:ＧＵＮ]]
	ENDSELECT
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:入力行動
ENDIF
;後列をうつ場合、ちゃんとターゲットがいるか確認する
IF CFLAG:ARG:ターゲット == 18
	LOCAL = 0
	FOR LOCAL:3, 4, 7
		SIF POS(LOCAL:3) >= 0 && GET_STATE(CFLAG:(POS(LOCAL:3)):ステート) != "DYING"
			LOCAL = 1
	NEXT
	CFLAG:ARG:ターゲット = LOCAL ? 18 # 17
ENDIF
;アクション実行不能なら自動的に銃射撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:入力行動
IF RESULT == 0
	CFLAG:ARG:入力行動 = [[スキル:ＧＵＮ]]
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:入力行動
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:ターゲット == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:入力行動
RETURN 1

