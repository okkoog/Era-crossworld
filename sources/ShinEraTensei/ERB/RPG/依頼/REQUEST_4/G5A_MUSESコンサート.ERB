;リンダ思考パターン
;はじめはハッピー系を中心＋バリアントダンス
;HPが減ってくると、セクシーダンスとハッピー系
;さらに減るとファイナルヌード
;しかし、文章が過激すぎるおかげで元アイドル悲惨すぎる感じだ
;まぁ、実際にはこんなアイドルいないけど、原作的に
;
;攻撃力はほぼなしで、バステ成功率は異様、というか、ステが異様
;狙うは挑発と魅了のコンボ
;解法は精神耐性持ちを前に立たせて、残りのメンバーはGUARDし続けること
;でも嫌がらせでGUARD数増えるとマモリクズシうってきます
;あんまりたまると奥義来ます
;神経耐性を揃えつつ、如何に速攻で潰すかが勝負の鍵
;トーラス、ひいてはそのあと達哉までにこれで削れるかどうかですね
@SET_ACTION_リンダ, ARG
;ガードポイント加算、ポイントによってガード崩しを狙ってくる
IF CFLAG:ARG:行動した回数 == 0
	FOR LOCAL, 1, 7
		SIF POS(LOCAL) >= 0 && GET_STATE(CFLAG:POS(LOCAL):ステート) != "DYING" && CFLAG:POS(LOCAL):防御フラグ
			LOCAL:1 += 1
	NEXT
	SIF LOCAL:1 > 10 && RAND:100 > LOCAL:1
		CFLAG:ARG:入力行動 = [[スキル:マモリクズシ]]
	SIF LOCAL:1 >= 50
		CFLAG:ARG:入力行動 = [[スキル:奥義マモリヤブリ]]
	GOTO RINDA_END
ENDIF

;確率生成
LOCAL = RAND:100
IF 現HP割合(ARG) < 33
	IF LOCAL:1 >= 50
		CFLAG:ARG:入力行動 = [[スキル:ファイナルヌード]]
	;33%以下突入で再び挑発
	ELSEIF  CFLAG:ARG:200 < 3
		CFLAG:ARG:200 = 3
		CFLAG:ARG:入力行動 = [[スキル:挑発]]
	ELSE
		SELECTCASE LOCAL
			CASE 0 TO 29
				CFLAG:ARG:入力行動 = [[スキル:セクシーダンス]]
			CASE 30 TO 59
				CFLAG:ARG:入力行動 = [[スキル:ファイナルヌード]]
		ENDSELECT
	ENDIF
ELSEIF 現HP割合(ARG) < 66
	IF LOCAL:1 >= 50
		CFLAG:ARG:入力行動 = [[スキル:セクシーダンス]]
	;66%以下突入で挑発
	ELSEIF  CFLAG:ARG:200 <  1
		CFLAG:ARG:200 = 1
		CFLAG:ARG:入力行動 = [[スキル:挑発]]
	ELSE
		SELECTCASE LOCAL
			CASE 0 TO 19
				CFLAG:ARG:入力行動 = [[スキル:キャンディボイス]]
			CASE 20 TO 39
				CFLAG:ARG:入力行動 = [[スキル:セクシーダンス]]
			CASE 30 TO 59
				CFLAG:ARG:入力行動 = [[スキル:バリアントダンス]]
		ENDSELECT
	ENDIF
ELSE
	IF LOCAL:1 >= 50
		CFLAG:ARG:入力行動 = [[スキル:バリアントダンス]]
	ELSE
		SELECTCASE LOCAL
			CASE 0 TO 19
				CFLAG:ARG:入力行動 = [[スキル:キャンディボイス]]
			CASE 20 TO 39
				CFLAG:ARG:入力行動 = [[スキル:ハッピーステップ]]
			CASE 40 TO 59
				CFLAG:ARG:入力行動 = [[スキル:バリアントダンス]]
		ENDSELECT
	ENDIF
ENDIF
SIF LOCAL:1 >= 50
	LOCAL:1 -= 50
$RINDA_END
SIF CFLAG:ARG:入力行動 == -1
	CFLAG:ARG:入力行動 = 0
;アクション実行不能なら自動的に銃射撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:入力行動
SIF RESULT == 0
	CFLAG:ARG:入力行動 = 0
;ターゲット決定
CALL RANDOM_TARGET, ARG, CFLAG:ARG:入力行動
RETURN 1
