	PRINTFORML あなたの知らない所で苦しむ人達を、あなたが救うことが出来ます。
	PRINTFORML ご協力をお願いします。
	PRINTL

;====================
;内容
;====================
@REQUEST_10
PRINTFORML 募金は一口￥5000です

IF MONEY >= 5000
	PRINTFORML 何口募金しますか？(0でキャンセル)
	PRINTFORML [0] [1] \@ MONEY >= 25000 ? [5]#\@ \@ MONEY >= 50000 ? [10] #\@ [{MONEY/5000}]
	$INPUT_LOOP
	INPUT
	IF RESULT == 0
		RETURN 0
	ELSEIF RESULT < 0 || MONEY < RESULT * 5000
		GOTO INPUT_LOOP
	ENDIF
	PRINTFORML {RESULT}口、計￥{RESULT * 5000}を送金しました
	MONEY -= RESULT * 5000
	依頼フラグ:10:0 += RESULT
	CALL INCREASE_LD,RESULT
ELSE
	PRINTFORML 募金するだけの資金を持っていません
	RETURN 0
ENDIF
;10万送金する
IF 依頼フラグ:10:0 >= 20 && ITEM:ハッピーバースデー == 0
	WAIT
	PRINTL 手紙が届いていた
	PRINTW ……あけてみると、子供達からの感謝の手紙だった
	PRINTW 文章は拙いが、真剣な気持ちが伝わってくる
	PRINTW 読み終わって、手紙を置くと、少し汚れたディスクがテーブルの上に置いてあるのに気づいた
	PRINTW インストールソフト「ハッピーバースデー」を手に入れた
	ITEM:ハッピーバースデー = 1
ENDIF
;50万送金する＆属性がLight/Lawだとガブリエル解禁
IF 依頼フラグ:10:0 >= 100 && ABL:MASTER:属性LD != 3 && FLAG:10303 == 0
	WAIT
	PRINTL 事務所に白百合の花飾りが届いていた
	PRINTL ……誰が送ってきたのだろう？
	FLAG:10303 = 1
ENDIF

RETURN 0
