;====================
;条件
;====================
@PLAYABLE_REQUEST_6
;---- EDIT 002 ADD START -------------------------
;百合の花ルートはDかCになってるとでない。直哉ルートはLになってるとでない
;とりあえず、一時差し止めで属性が変動した場合は出てくる
;ついでに両方の条件を分離してわかりやすくする
;百合の花の場合は上野クリア以前のみ
IF (FLAG:百合の花ルート == 2  && ダンジョンフラグ:18:22 == 0 && ABL:MASTER:属性LD < 3 && ABL:MASTER:属性LC < 3)
	RESULTS = 不死の者
	RETURN 1
ENDIF
IF FLAG:直哉ルート == 2
	RESULTS = 不死の者
	RETURN 1
ENDIF
;---- EDIT 002 ADD END -------------------------
RETURN 0
;====================
;説明
;====================
@EXPLAIN_REQUEST_6
IF FLAG:直哉ルート
	PRINTL
	PRINTFORML ナオヤからメールが届いている。
	PRINTL
ELSE
	PRINTL
	PRINTFORML 百合の花共同募金からメッセージが届いている。
	PRINTL
ENDIF

;====================
;内容
;====================
@REQUEST_6
CUSTOMDRAWLINE =
