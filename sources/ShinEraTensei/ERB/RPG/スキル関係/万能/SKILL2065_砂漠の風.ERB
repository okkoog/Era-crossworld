;セト専用
;悪魔をＣＯＭＰに戻しつつ攻撃する
;ＣＯＭＰに戻らないキャラに当てた場合は追加行動を得る

;スキル名
@SKILL_NAME_2065,ARG
RESULTS = 砂漠の風

;　命中
@SKILL_HITRATE_2065, ARG
RETURN 80

;　威力
@SKILL_POWER_2065, ARG
RETURN 250

;　最低攻撃回数
@SKILL_MINATTACKNUMBER_2065,ARG
RETURN 1

;　最大攻撃回数
@SKILL_MAXATTACKNUMBER_2065,ARG
RETURN 1

@SKILL_CRITICAL_RATE_2065
RETURN 0

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2065, ARG
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_2065,ARG
RETURN 0

;　相性
@SKILL_TYPE_2065,ARG
RETURN 17
;万能

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2065
RETURN 1
;EX

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2065
RETURN 1


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2065
RETURN 1

;　射程
@SKILL_RANGE_2065,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2065,ARG
RETURN 1

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_2065
RETURN 1

;　 特殊処理の有無、及び処理内容
@SKILL_SPECIALEFECT_2065,ARG
;ARG = 1だった場合は処理の有無を返します
SIF ARG == 1
	RETURN 0
;以下に特殊な処理を記述します

;継承タイプ 継承不能
@SKILL_SUCCESSION_TYPE_2065
RETURN 20

;速度補正
@SKILL_SPEED_2065, ARG = -1
RETURN 0

;　口上の表示とそのタイプ
@SKILL_MESSAGE_2065,ARG

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2065
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2065
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2065,ARG
RETURN 0


;追加効果相性
@SKILL_ADDTIONAL_TYPE_2065,ARG
RETURN 0

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2065,ARG
RETURN 0

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2065,ARG
RETURN 0

@敵専用_2065
RETURN 1
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2065,ARG,ARG:1
#LOCALSIZE 1
LOCAL = BASE:POS(ARG:1):ＨＰ
CALL ATTACK_SINGLE, ARG, POS(ARG:1), 2065
;ＨＩＴした（=HPが減っている）
IF LOCAL > BASE:POS(ARG:1):ＨＰ
	IF POS(ARG:1) > 0 && !CFLAG:POS(ARG:1):防御フラグ && ABL:POS(ARG:1):種族 > 0 && CFLAG:POS(ARG:1):所属ＣＯＭＰ != -1
		PRINTFORMW 　　%CALLNAME:POS(ARG:1)%は吹き飛ばされた！
		CALL REMOVE_POSITION, ARG:1
	ELSE
		SIF !CFLAG:POS(ARG:1):防御フラグ
			CFLAG:ARG:１moreフラグ = 1
	ENDIF
ENDIF
;====================================================
;実行内容ここまで
;====================================================
;説明文の表示
@SKILL_EXPLAIN_2065
PRINTL 敵１体に万能相性のダメージを与え、悪魔をＣＯＭＰに戻す
PRINTL ＣＯＭＰに戻らないキャラクターに攻撃した場合は追加行動を得る

;継承に必要な部位
@継承部位_2065,ARG
RETURN 1

;使用条件
@SKILL_SPECIAL_ACTIONABLE_2065,ARG
RETURN 1
;とくにない

