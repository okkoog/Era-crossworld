;万能相性でランダム状態異常付与
;アバチュボス勢に大人気スキル……まぁ味方ではまじつかわないんですがこれ
;スキル名
@SKILL_NAME_2066,ARG
RESULTS = 色即是空

;　命中
@SKILL_HITRATE_2066, ARG
RETURN 100

;　威力
@SKILL_POWER_2066, ARG
RETURN 0

;　最低攻撃回数
@SKILL_MINATTACKNUMBER_2066,ARG
RETURN 1

;　最大攻撃回数
@SKILL_MAXATTACKNUMBER_2066,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2066, ARG
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_2066,ARG
RETURN 35

;　相性
@SKILL_TYPE_2066,ARG
RETURN 17
;万能

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2066
RETURN 1
;どちらでもない

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2066
RETURN 2


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2066
RETURN 1

;　射程
@SKILL_RANGE_2066,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2066,ARG
RETURN 3

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_2066
RETURN 1

;　 特殊処理の有無、及び処理内容
@SKILL_SPECIALEFECT_2066,ARG
;ARG = 1だった場合は処理の有無を返します
SIF ARG == 1
	RETURN 0
;以下に特殊な処理を記述します

;継承タイプ
@SKILL_SUCCESSION_TYPE_2066
RETURN 20
;疾風

;速度補正
@SKILL_SPEED_2066, ARG = -1
RETURN 0

;　口上の表示とそのタイプ
@SKILL_MESSAGE_2066,ARG


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2066
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2066
RETURN 15

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2066,ARG
RETURN RAND:10 + 1

;追加効果相性
@SKILL_ADDTIONAL_TYPE_2066,ARG
RETURN GET_TYPE_NUM("万能")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2066,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2066,ARG
RETURN 50

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2066,ARG,ARG:1
#LOCALSIZE 1
FOR LOCAL, CFLAG:ARG:PTフラグ ? 7 # 1, CFLAG:ARG:PTフラグ ? 17 # 7
	SIF POS(LOCAL) < 0
		CONTINUE
	CALL SINGLE_BADSTATE, ARG, POS(LOCAL), 2066
NEXT





;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2066
PRINTL 敵全体に万能相性でランダムに状態異常

;継承に必要な部位
@継承部位_2066,ARG
RETURN 1


;使用条件
@SKILL_SPECIAL_ACTIONABLE_2066,ARG
RETURN 1
;とくにない

