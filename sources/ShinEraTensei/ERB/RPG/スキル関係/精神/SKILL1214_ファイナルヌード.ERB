@SKILL_SUCCESSION_TYPE_1214
RETURN 12
;精神

;速度補正
@SKILL_SPEED_1214, ARG = -1
RETURN 0

;　口上の表示とそのタイプ
@SKILL_MESSAGE_1214,ARG


