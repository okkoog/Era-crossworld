@SKILL_DAMAGETYPE_1214
RETURN 2


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1214
RETURN 1

;　射程
@SKILL_RANGE_1214,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1214,ARG
RETURN 3

