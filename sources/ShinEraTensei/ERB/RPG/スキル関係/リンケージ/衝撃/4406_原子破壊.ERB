;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_4406
RETURN 1

;　射程
@SKILL_RANGE_4406,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_4406,ARG
RETURN 1

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_4406
RETURN 3

;　 特殊処理の有無、及び処理内容
@SKILL_SPECIALEFECT_4406,ARG
;ARG = 1だった場合は処理の有無を返します
SIF ARG == 1
	RETURN 0
;以下に特殊な処理を記述します

;継承タイプ
@SKILL_SUCCESSION_TYPE_4406
RETURN 23
;火炎

;速度補正
@SKILL_SPEED_4406, ARG = -1
RETURN 0

