@SKILL_MESSAGE_4406,ARG

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_4406
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_4406
RETURN 0

@SKILL_RANKUP_4406
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_4406,ARG
RETURN GET_STATE_NUM("DYING")

;追加効果相性
@SKILL_ADDTIONAL_TYPE_4406,ARG
RETURN GET_TYPE_NUM("衝撃")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_4406,ARG
RETURN 75

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_4406,ARG
RETURN 95
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4406,ARG,ARG:1
CALL SINGLE_BADSTATE,ARG,POS(ARG:1),4406






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_4406
PRINTL 敵単体を高確率で即死させる。衝撃相性。

;継承に必要な部位
@継承部位_4406,ARG
RETURN 0

;使用条件
@SKILL_SPECIAL_ACTIONABLE_4406,ARG
CALL CHECK_COST,ARG,4406
SIF RESULT == 0
	RETURN 0
RETURN 1
;とくにない


;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4406
RETURN 1

@参加人数_4406
RETURN 2

@参加条件表示_4406,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 火炎系魔法
	CASE 2
		PRINTFORM 水撃系魔法
	CASE 3
		PRINTFORM 衝撃系魔法
ENDSELECT

@発動者条件_4406 , ARG
;火炎相性の攻撃魔法スキルを使用可能なこと
FOR LOCAL,1 , FLAG:スキル数+1
	SIF ABL:ARG:("スキル" + TOSTR(LOCAL)) == 0
		CONTINUE
	
	CALLFORM SKILL_DECIDE_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
	SIF RESULT != 2
		CONTINUE
	CALLFORM SKILL_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))} , ARG
	SIF RESULT != GET_TYPE_NUM("衝撃")
		CONTINUE
	CALLFORM SKILL_EFECT_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
	SIF RESULT != 1
		CONTINUE
	CALL CHECK_ACTIONABLE , ARG , ABL:ARG:("スキル" + TOSTR(LOCAL))
	SIF RESULT == 0
		CONTINUE
	RETURN 1
NEXT
RETURN 0


@参加者条件_4406, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4406, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;火炎相性の攻撃魔法スキルを使用可能なこと
		FOR LOCAL,1 , FLAG:スキル数+1
			SIF ABL:ARG:("スキル" + TOSTR(LOCAL)) == 0
				CONTINUE
			CALLFORM SKILL_DECIDE_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
			SIF RESULT != 2
				CONTINUE
			CALLFORM SKILL_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))} , ARG
			SIF RESULT != GET_TYPE_NUM("火炎")
				CONTINUE
			CALLFORM SKILL_EFECT_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
			SIF RESULT != 1
				CONTINUE
			CALL CHECK_ACTIONABLE , ARG , ABL:ARG:("スキル" + TOSTR(LOCAL))
			SIF RESULT == 0
				CONTINUE
			CALL SKILL_SPECIAL_ACTIONABLE_4406,ARG
			SIF RESULT == 0
				CONTINUE
			
			RETURN 1
		NEXT
		RETURN 0
	CASE 2
		;水撃相性の攻撃魔法スキルを使用可能なこと
		FOR LOCAL,1 , FLAG:スキル数+1
			SIF ABL:ARG:("スキル" + TOSTR(LOCAL)) == 0
				CONTINUE
			CALLFORM SKILL_DECIDE_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
			SIF RESULT != 2
				CONTINUE
			CALLFORM SKILL_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))} , ARG
			SIF RESULT != GET_TYPE_NUM("水撃")
				CONTINUE
			CALLFORM SKILL_EFECT_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
			SIF RESULT != 1
				CONTINUE
			CALL CHECK_ACTIONABLE , ARG , ABL:ARG:("スキル" + TOSTR(LOCAL))
			SIF RESULT == 0
				CONTINUE
			CALL SKILL_SPECIAL_ACTIONABLE_4406,ARG
			SIF RESULT == 0
				CONTINUE
			
			RETURN 1
		NEXT
		RETURN 0
ENDSELECT

@リンケージコストタイプ_4406, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
	CASE 2
		RETURN 3
ENDSELECT
@リンケージコスト_4406, ARG
