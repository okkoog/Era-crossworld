

;スキル名
@SKILL_NAME_4724,ARG
RESULTS = グラビティクラッシュ
;　命中
@SKILL_HITRATE_4724, ARG
RETURN 100

;　威力
@SKILL_POWER_4724, ARG
SIF ARG == -1 || CFLAG:ARG:単独リンケージ
	RETURN 340
;発動者と参加者の魔法威力の比率により、威力に補正がかかる
RETURN 340 * (MAXBASE:ARG:魔法威力 * 2 + MAXBASE:(CFLAG:ARG:リンケージ参加者1):魔法威力 + MAXBASE:(CFLAG:ARG:リンケージ参加者2):魔法威力) / (MAXBASE:ARG:魔法威力 * 4)
;　最低攻撃回数
@SKILL_MINATTACKNUMBER_4724,ARG
RETURN 1

;　最大攻撃回数
@SKILL_MAXATTACKNUMBER_4724,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_4724, ARG, ARG:1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_4724, ARG
RETURN 10

;　相性
@SKILL_TYPE_4724,ARG
RETURN GET_TYPE_NUM("重力")
;　1EXTRAか2MAGICか

@SKILL_DECIDE_TYPE_4724
RETURN 1

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_4724
RETURN 2


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_4724
RETURN 1

;　射程
@SKILL_RANGE_4724,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_4724,ARG
RETURN 3

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_4724
RETURN 1

;　 特殊処理の有無、及び処理内容
@SKILL_SPECIALEFECT_4724,ARG
;ARG = 1だった場合は処理の有無を返します
SIF ARG == 1
	RETURN 0
;以下に特殊な処理を記述します

;継承タイプ
@SKILL_SUCCESSION_TYPE_4724
RETURN 23
;重力

;速度補正
@SKILL_SPEED_4724, ARG = -1
RETURN 0

;　口上の表示とそのタイプ
@SKILL_MESSAGE_4724,ARG

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_4724
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_4724
RETURN 0

@SKILL_RANKUP_4724
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_4724,ARG
RETURN 0

;追加効果相性
@SKILL_ADDTIONAL_TYPE_4724,ARG
RETURN 0

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_4724,ARG
RETURN 0

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_4724,ARG
RETURN 0
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4724,ARG,ARG:1
CALL ATTACK_FIELD, ARG, ARG:1, 4724






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_4724
PRINTL 重力波で敵を押し潰して、大ダメージを与える

;継承に必要な部位
@継承部位_4724,ARG
RETURN 0

;使用条件
@SKILL_SPECIAL_ACTIONABLE_4724,ARG
CALL CHECK_COST,ARG,4724
SIF RESULT == 0
	RETURN 0
RETURN 1
;とくにない


;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4724
RETURN 1

@参加人数_4724
RETURN 2

@参加条件表示_4724,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 重力系魔法
	CASE 2
		PRINTFORM 核熱系魔法
	CASE 3
		PRINTFORM マハ・グライバ
ENDSELECT

@発動者条件_4724 , ARG
;マハ・ラギを使えること
SIF CHECK_SKILL(ARG, [[スキル:マハ・グライバ]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[スキル:マハ・グライバ]]
SIF RESULT
	RETURN 1	
RETURN 0


@参加者条件_4724, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4724, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;重力相性の攻撃魔法スキルを使用可能なこと
		FOR LOCAL,1 , FLAG:スキル数+1
			SIF ABL:ARG:("スキル" + TOSTR(LOCAL)) == 0
				CONTINUE
			CALLFORM SKILL_DECIDE_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
			SIF RESULT != 2
				CONTINUE
			CALLFORM SKILL_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))} , ARG
			SIF RESULT != GET_TYPE_NUM("重力")
				CONTINUE
			CALLFORM SKILL_EFECT_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
			SIF RESULT != 1
				CONTINUE
			CALL CHECK_ACTIONABLE , ARG , ABL:ARG:("スキル" + TOSTR(LOCAL))
			SIF RESULT == 0
				CONTINUE
			CALL SKILL_SPECIAL_ACTIONABLE_4724,ARG
			SIF RESULT == 0
				CONTINUE
			RETURN 1
		NEXT
		RETURN 0
	CASE 2
		;核熱相性の攻撃魔法スキルを使用可能なこと
		FOR LOCAL,1 , FLAG:スキル数+1
			SIF ABL:ARG:("スキル" + TOSTR(LOCAL)) == 0
				CONTINUE
			CALLFORM SKILL_DECIDE_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
			SIF RESULT != 2
				CONTINUE
			CALLFORM SKILL_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))} , ARG
			SIF RESULT != GET_TYPE_NUM("核熱")
				CONTINUE
			CALLFORM SKILL_EFECT_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
			SIF RESULT != 1
				CONTINUE
			CALL CHECK_ACTIONABLE , ARG , ABL:ARG:("スキル" + TOSTR(LOCAL))
			SIF RESULT == 0
				CONTINUE
			CALL SKILL_SPECIAL_ACTIONABLE_4724,ARG
			SIF RESULT == 0
				CONTINUE
			
			RETURN 1
		NEXT
		RETURN 0
ENDSELECT

@リンケージコストタイプ_4724, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
	CASE 2
		RETURN 3
ENDSELECT
@リンケージコスト_4724, ARG
SELECTCASE ARG
	CASE 1
		RETURN 7
	CASE 2
		RETURN 7
ENDSELECT
