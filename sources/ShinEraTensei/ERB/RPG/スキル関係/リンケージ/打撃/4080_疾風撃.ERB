;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4080,ARG,ARG:1
CALL ATTACK_SINGLE,ARG,POS(ARG:1),4080






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_4080
PRINTL 敵一体に打撃相性＋疾風相性のダメージ

;継承に必要な部位
@継承部位_4080, ARG
RETURN 0

;使用条件
@SKILL_SPECIAL_ACTIONABLE_4080,ARG
CALL CHECK_COST,ARG,4080
SIF RESULT == 0
	RETURN 0
RETURN 1
;とくにない


;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4080
RETURN 1

@参加人数_4080
RETURN 1

@参加条件表示_4080,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 疾風系魔法
	CASE 2
		PRINTFORM 打撃系単体物理
ENDSELECT

@発動者条件_4080 , ARG
;打撃相性の単体スキルを使用可能なこと
FOR LOCAL,1 , FLAG:スキル数+1
	SIF ABL:ARG:("スキル" + TOSTR(LOCAL)) == 0
		CONTINUE
	CALLFORM SKILL_DECIDE_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
	SIF RESULT != 1
		CONTINUE
	CALLFORM SKILL_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))} , ARG
	SIF RESULT != GET_TYPE_NUM("打撃")
		CONTINUE
	CALLFORM SKILL_SPHERE_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
	SIF RESULT != 1
		CONTINUE
	CALLFORM SKILL_EFECT_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
	SIF RESULT != 1
		CONTINUE
	CALL CHECK_ACTIONABLE , ARG , ABL:ARG:("スキル" + TOSTR(LOCAL))
	SIF RESULT == 0
		CONTINUE
	RETURN 1
NEXT
RETURN 0


@参加者条件_4080, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4080, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;疾風相性の攻撃魔法スキルを使用可能なこと
		FOR LOCAL,1 , FLAG:スキル数+1
			SIF ABL:ARG:("スキル" + TOSTR(LOCAL)) == 0
				CONTINUE
			CALLFORM SKILL_DECIDE_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
			SIF RESULT != 2
				CONTINUE
			CALLFORM SKILL_TYPE_{ABL:ARG:("スキル" + TOSTR(LOCAL))} , ARG
			SIF RESULT != GET_TYPE_NUM("疾風")
				CONTINUE
			CALLFORM SKILL_EFECT_{ABL:ARG:("スキル" + TOSTR(LOCAL))}
			SIF RESULT != 1
				CONTINUE
			CALL CHECK_ACTIONABLE , ARG , ABL:ARG:("スキル" + TOSTR(LOCAL))
			SIF RESULT == 0
				CONTINUE
			CALL SKILL_SPECIAL_ACTIONABLE_4080, ARG
			SIF RESULT == 0
				CONTINUE
			
			RETURN 1
		NEXT
		RETURN 0
ENDSELECT
@リンケージ能力参照者_4080, ARG
	SIF FLAG:攻撃回数 == 1
		RETURN 1
	RETURN 0

@リンケージコストタイプ_4080, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
ENDSELECT
@リンケージコスト_4080, ARG
