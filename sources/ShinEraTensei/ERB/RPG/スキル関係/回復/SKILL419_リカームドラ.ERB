;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_419,ARG
RESULTS = リカームドラ


;　命中
@SKILL_HITRATE_419, ARG
RETURN 100

;　威力
@SKILL_POWER_419, ARG
RETURN 50

;　最低攻撃回数
@SKILL_MINATTACKNUMBER_419,ARG
RETURN 1

;　最大攻撃回数
@SKILL_MAXATTACKNUMBER_419,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_419, ARG
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_419,ARG
RETURN 30

;　相性
@SKILL_TYPE_419,ARG
RETURN 0

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_419
RETURN 2
;魔法

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_419
RETURN 2


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_419
RETURN 2

;　射程
@SKILL_RANGE_419,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_419,ARG
RETURN 3

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_419
RETURN 5

;　 特殊処理の有無、及び処理内容
@SKILL_SPECIALEFECT_419,ARG
;ARG = 1だった場合は処理の有無を返します
SIF ARG == 1
	RETURN 0
;以下に特殊な処理を記述します

;継承タイプ
@SKILL_SUCCESSION_TYPE_419
RETURN 4
;回復

;速度補正
@SKILL_SPEED_419, ARG = -1
RETURN 0

;　口上の表示とそのタイプ
@SKILL_MESSAGE_419,ARG

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_419
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_419
RETURN 11


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_419,ARG
RETURN 0

;追加効果相性
@SKILL_ADDTIONAL_TYPE_419,ARG
RETURN 0

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_419,ARG
RETURN 0

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_419,ARG
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_419,ARG,ARG:1
;コストを支払う
;CALL PAY_COST,ARG,419

FOR LOCAL:9,0,CHARANUM
	SIF CFLAG:ARG:PTフラグ == 0 && CFLAG:(LOCAL:9):PTフラグ > 0
		CONTINUE
	SIF CFLAG:ARG:PTフラグ == 2 && CFLAG:(LOCAL:9):PTフラグ == 0
		CONTINUE
	SIF CFLAG:(LOCAL:9):PTフラグ == 1 && ABL:(LOCAL:9):種族 == 0
		CONTINUE
	SIF CFLAG:(LOCAL:9):この場に居ないフラグ || TALENT:(LOCAL:9):非戦闘員
		CONTINUE
	PRINTFORM 　　TARGET:[{CPOS(LOCAL:9),2}] %CALLNAME:(LOCAL:9),20,LEFT%　>>>>>>　
	;回復量
	LOCAL = MAXBASE:(LOCAL:9):ＨＰ
	PRINTFORMW {LOCAL}回復
	CALL VAR_HP,LOCAL:9,LOCAL,3
	CFLAG:(LOCAL:9):ステート = 0
NEXT
	CALL DEAD_CHARA,ARG


;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_419,ARG,ARG:1
;コストを支払う
;CALL PAY_COST,ARG,419

FOR LOCAL:9,0,CHARANUM
	SIF CFLAG:(LOCAL:9):PTフラグ == 0
		CONTINUE
	PRINTFORM 　　TARGET:[{CPOS(LOCAL:9),2}] %CALLNAME:(LOCAL:9),20,LEFT%　>>>>>>　
	;回復量
	LOCAL = MAXBASE:(LOCAL:9):ＨＰ
	PRINTFORML {LOCAL}回復
	CALL VAR_HP,LOCAL:9,LOCAL,3
	CFLAG:(LOCAL:9):ステート = 0
NEXT
	CALL DEAD_CHARA,ARG


;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_419
PRINTL 使用者を犠牲に、味方全体のＨＰと全てのバッドステータスを全回復する。

;継承に必要な部位
@継承部位_419,ARG
RETURN 1

;使用条件
@SKILL_SPECIAL_ACTIONABLE_419,ARG
RETURN 1
;とくにない

;ターゲット条件
@SKILL_SPECIAL_TARGET_419,ARG
CALLFORM SKILL_CURE_STATE_419,(CFLAG:ARG:ステート)
RETURN RESULT

;控えに使えるか
@SKILL_T_RESERVE_419
RETURN 0

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_419,ARG
SELECTCASE GET_STATE(ARG)
	CASE " "
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

