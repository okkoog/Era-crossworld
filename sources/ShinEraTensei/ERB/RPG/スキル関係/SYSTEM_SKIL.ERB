;==========================================================
;スキル基本性能説明
;==========================================================
@SKILL_EXPLAIN_PERFORMANCE,ARG
;最初に種別
TRYCCALLFORM SKILL_EFECT_{ARG}
	PRINT 種別：
	SELECTCASE RESULT
		CASE 1
			PRINT 攻撃
		CASE 2
			PRINT 回復
		CASE 3
			PRINT 状態変化
		CASE 4
			PRINT 特殊
		CASE 5
			PRINT 状態回復
		CASE 6
			PRINT 自動効果
	ENDSELECT
	LOCAL = RESULT
	;相性表示
	IF LOCAL == 1 || LOCAL == 3
		CALLFORM SKILL_TYPE_{ARG},-1
		PRINTFORM 　相性：%GET_TYPE(RESULT)%
	ENDIF
	;威力表示
	IF LOCAL == 1 || LOCAL == 2 || LOCAL == 3
		CALLFORM SKILL_POWER_{ARG},-1
		PRINTFORM 　威力：{RESULT}
	ENDIF
	IF LOCAL != 6
		;消費表示
		CALLFORM SKILL_COSTTYPE_{ARG},-1
		IF RESULT == 2
			CALLFORM SKILL_COST_{ARG},-1
			PRINTFORM 　消費：ＨＰ{RESULT}％
			
		ELSEIF RESULT == 3
			CALLFORM SKILL_COST_{ARG},-1
			PRINTFORM 　消費：{RESULT}ＭＰ
		ENDIF
	;	;範囲取得しておく
	;	CALLFORM SKILL_SPHERE_{ARG},-1
	;	LOCAL:1 = RESULT
	ENDIF
	PRINTL
CATCH
	;ひょっとしたらSKILL_EFECTが無いスキルがあるかもしれない
	[IF_DEBUG]
		PRINTFORMW 例外：{ARG}番のスキルの基本性能説明を行おうとしました。
		PRINTFORMW 関数@SKILL_EFECT_{ARG}が見つかりません。
		PRINTFORMW 未実装のスキルを習得している可能性があります。
	[ENDIF]
ENDCATCH

;==========================================================
;スキルカードシステム
;スキルカード一覧表示
;==========================================================
@SHOW_SKILL_CARD
#DIM 選択スキル
#DIM 選択スキル系統
#DIM ページ
#DIM ライン
#LOCALSIZE 2

REDRAW 0
選択スキル系統 = -1
選択スキル = -1
ページ = 0
ライン = LINECOUNT
CALL スキルカード在庫確認()
FOR LOCAL, 0, 24
	X:LOCAL = Z:LOCAL
NEXT


$START
CLEARLINE LINECOUNT - ライン
CUSTOMDRAWLINE =
IF 選択スキル > -1
	PRINTFORML 【%SKILL_NAME_F(選択スキル)%】
	TRYCALLFORM SKILL_EXPLAIN_{選択スキル}
ELSE
	PRINTFORML \@ 選択スキル系統 == -1 ? どの系統のスキルカードを確認しますか？ # どのスキルの説明を見ますか？ \@
	PRINTL
ENDIF
DRAWLINE
IF 選択スキル系統 > -1
	FOR LOCAL, ページ*20 , (ページ+1)*20
		IF S:LOCAL > 0
			CALLFORM SKILL_NAME_{S:LOCAL}
			PRINTFORM [{S:LOCAL,4}] %RESULTS,20,LEFT% × {ITEM:(10000+S:LOCAL),3}\@ABLE_MAKESKILLCARD(S:LOCAL)?　複製可　#　　　　　\@
			RESETCOLOR
		ENDIF
		SIF LOCAL % 2 == 1
			PRINTL
	NEXT
ELSE
	PRINTFORM %"\n" * 10%
ENDIF
DRAWLINE
FOR LOCAL,0,24
	;使えるカードが無い系統は暗く表示
	SIF LOCAL == 21
		CONTINUE
	IF LOCAL == 選択スキル系統
		SETCOLOR COLOR("水色")
	ELSEIF X:LOCAL == 0
		SETCOLOR 0x606060
	ENDIF
	;IF LOCAL == 22
	;	PRINTFORM [4022] 自動効果
	;ELSEIF LOCAL == 23
	;	PRINTFORML [4023] レア
	;ELSE
	PRINTFORM [{4000+LOCAL}] %GET_SUCCESSION(LOCAL)%　　
	;ENDIF
	RESETCOLOR
	SIF LOCAL % 6 == 5 || LOCAL == 20
		PRINTL
NEXT
DRAWLINE
PRINTFORMLC \@(ページ <= 0) ? %" " * 16% # [3007]前のページ\@
PRINTLC [0]戻る
PRINTFORMLC \@(ページ >= (LOCAL:1 - 1) / 20) ? %" " * 16% # [3009]次のページ\@
PRINTL 
PRINTFORMLC [3004]前の系統
PRINTFORMLC 現在の系統【\@ 選択スキル系統 == -1 ? ---- #%GET_SUCCESSION(RESULT:10)%\@】
PRINTFORMLC [3006]次の系統

$INPUT_LOOP_1
INPUT
IF RESULT == 0
	REDRAW 1
	RETURN 0
;系統選択
ELSEIF RESULT >= 4000 && RESULT <= 4023
	ページ = 0
	選択スキル系統 = RESULT - 4000
	CALL スキルカード在庫確認(選択スキル系統, , 1)
	LOCAL:1 = RESULT
	GOTO START
;系統送り
ELSEIF RESULT == 3004 || RESULT == 3006
	ページ = 0
	選択スキル系統 += (RESULT == 3004 ? -1 # 1)
	SIF 選択スキル系統 == 21
		選択スキル系統 += (RESULT == 3004 ? -1 # 1)
	CALL スキルカード在庫確認(選択スキル系統, , 1)
	LOCAL:1 = RESULT
	GOTO START
;ページ操作
ELSEIF (RESULT == 3007 && ページ> 0) || (RESULT == 3009 && ページ < (LOCAL:1 -1) / 20)
	ページ += (RESULT == 3007 ? -1 # 1)
	GOTO START
ELSEIF !RANGE(RESULT , 0 , VARSIZE("ITEM") - 10001) || MATCH(S,RESULT) == -1 || ITEM:(10000+RESULT) < 1
	CLEARLINE 1
	GOTO INPUT_LOOP_1
ENDIF
選択スキル = RESULT
GOTO START


;==============================================================
;スキル習得用・リスト表示
;==============================================================
@SHOW_LEARN_SKILL,ARG
PRINTL どの系統のスキルを習得しますか？
CALL スキルカード在庫確認(,ARG)
FOR LOCAL,0,21
	SIF FLAG:ショップコマンド == [[ショップ:仲魔強化]] && TALENT:ARG:GET_SUCCESSION(LOCAL) == 0
		SETCOLOR 0xDDDDDD
	IF FLAG:ショップコマンド == [[ショップ:ベルベットルーム]] && TALENT:ARG:GET_SUCCESSION(LOCAL) == 0
		IF !STRFLAG_EV("初期ペルソナスキル習得", 0, [[イベント:ペルソナ]])
			SETCOLOR 0x404040
		ELSE
			SETCOLOR 0xDDDDDD
		ENDIF
	ENDIF
	;使えるカードが無い系統は暗く表示
	SIF Z:LOCAL == 0
		SETCOLOR 0x606060
	IF FLAG:ショップコマンド == [[ショップ:仲魔強化]]
		PRINTFORM [{LOCAL,2}] %GET_SUCCESSION(LOCAL)%　\@ TALENT:ARG:GET_SUCCESSION(LOCAL) ? ○ # △ \@　
	ELSEIF FLAG:ショップコマンド == [[ショップ:ベルベットルーム]]
		IF !STRFLAG_EV("初期ペルソナスキル習得", 0, [[イベント:ペルソナ]])
			PRINTFORM [{LOCAL,2}] %GET_SUCCESSION(LOCAL)%　\@ TALENT:ARG:GET_SUCCESSION(LOCAL) ? ○ # × \@　
		ELSE
			PRINTFORM [{LOCAL,2}] %GET_SUCCESSION(LOCAL)%　\@ TALENT:ARG:GET_SUCCESSION(LOCAL) ? ○ # △ \@　
		ENDIF
	ELSE
		PRINTFORM [{LOCAL,2}] %GET_SUCCESSION(LOCAL)%　　
	ENDIF
	SIF LOCAL % 6 == 5
		PRINTL
	RESETCOLOR
NEXT
SIF Z:22 == 0
	SETCOLOR 0x606060
PRINTFORM [22] 自動効果
RESETCOLOR
IF FLAG:ショップコマンド == [[ショップ:仲魔強化]]
	SIF Z:23 == 0
		SETCOLOR 0x606060
	PRINTFORM 　[23] レア
ENDIF
RESETCOLOR
PRINTL 
PRINTL [100]戻る
$INPUT_LOOP
INPUT
IF RESULT == 100
	RETURN 0
ELSEIF RESULT < 0 || RESULT > 23 || RESULT == 21 || (FLAG:ショップコマンド == [[ショップ:ベルベットルーム]] && RESULT == 23)
	GOTO INPUT_LOOP
ELSEIF FLAG:ショップコマンド == [[ショップ:ベルベットルーム]] && TALENT:ARG:GET_SUCCESSION(RESULT) == 0
	SIF !STRFLAG_EV("初期ペルソナスキル習得", 0, [[イベント:ペルソナ]])
		GOTO INPUT_LOOP
ENDIF

RESULT:10 = RESULT

CALL スキルカード在庫確認(RESULT:10,ARG)
LOCAL:1 = RESULT
IF LOCAL:1 == 0
	PRINTFORMW カードを所持していません
	CLEARLINE 2
	GOTO INPUT_LOOP
ENDIF

;Sの中身を表示
P = 0
$PRINT_LIST
DRAWLINE
FOR LOCAL,P*20,(P+1)*20
	IF S:LOCAL > 0 && ITEM:(10000+S:LOCAL)
		CALLFORM SKILL_NAME_{S:LOCAL}
		PRINTFORM [{S:LOCAL,4}] %RESULTS,20,LEFT% × {ITEM:(10000+S:LOCAL),3}　　
		
	ENDIF
	SIF LOCAL % 2 == 1
		PRINTL
NEXT
DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 16% # [3007]前のページ\@
PRINTLC [0]戻る
PRINTFORMLC \@(P >= (LOCAL:1 - 1) / 20) ? %" " * 16% # [3009]次のページ\@
PRINTL

$INPUT_LOOP_1
INPUT
IF RESULT == 0
	RESTART
ELSEIF RESULT == 3007
	IF P > 0
		P -= 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT == 3009
	IF P < (LOCAL:1 - 1) / 20
		P += 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT < 0 || MATCH(S,RESULT) == -1 || ITEM:(10000+RESULT) < 1
	GOTO INPUT_LOOP_1
ENDIF

RETURN RESULT



