;最初に奴隷を受け取る処理
;男でも女でも追加できるように独立

;LOCAL 受け取った奴隷の番号
;LOCAL:1 が 0:受け取った奴隷が男 1:受け取った奴隷が女


@PRESENT_SLAVE, ARG
#LOCALSIZE 2
LOCAL = 0
LOCAL:1 = 0
;マヨーネ様の詳細な説明が入るほう
IF ARG == 1
	PRINTL [0] 素直で明るい１５歳ネットアイドル
	PRINTL [1] 包容力のある２３歳養護教諭(巨乳)
	PRINTL [2] マヨーネが欲しい
	PRINTL [3] いらない
	CALL INPUTINT,0,1,2,3
	SELECTCASE RESULT
		CASE 0
			CALL ADD_NEW_COMPANION,4505,500
			FLAG:初期パートナー = 4505
			LOCAL = GETCHARA(4505)
			LOCAL:1 = 2
			PRINTFORMW 「年端もいかない小娘がお好み？」
			PRINTFORMW 「フフフ、せいぜい壊してしまわないようにね」
			PRINTFORMW 小牧 翠 を手に入れた
		CASE 1
			CALL ADD_NEW_COMPANION,4506,500
			FLAG:初期パートナー = 4506
			LOCAL = GETCHARA(4506)
			LOCAL:1 = 2
			PRINTFORMW 「包容力と言いながら、結局胸が大きい方がお好みなのではなくて？」
			PRINTFORMW 「フフフ、せいぜい壊してしまわないようにね」
			PRINTFORMW 望月 麻里 を手に入れた
		CASE 2
			IF TALENT:MASTER:服従
				PRINTFORMW 「卑しい肉便器の分際で私が欲しいというのかしら？」
				PRINTFORMW 「……フフ、フフフフ、ハハハハハ！」
				PRINTFORMW ＞マヨーネはひとしきり笑った後、いきなり鈍器で%CALLNAME:MASTER%を打ち据えた。
				PRINTFORMW ＞額から血を流して転倒した%CALLNAME:MASTER%の背を踏みしめつつ、マヨーネは平然と話を再開する。
				PRINTFORMW 「媚薬中毒で都合の良い幻覚でも見ていたようね」
				PRINTFORMW 「それとも、股を開いて命乞いすればいつでも助けてもらえると思っているのかしら？」
				PRINTFORMW 「どちらにしても、寝言も寝る前に、睦言は睦んだ後に言いなさいな」
				PRINTFORMW 「甘えた声で愛撫をねだる暇があったら銃を手に取りなさい。任務を果たすのよ」
				PRINTFORMW ＞マヨーネは血の付着した鈍器を床に投げ捨てた。
				PRINTFORMW ＞その鈍器は材質不明の人形だった。不気味に歪んだ口元が%CALLNAME:MASTER%の血で汚れている。
				PRINTFORMW 「……失礼、意味もなく殴ってしまいましたわ。私は呪殺も心得ていたというのに」
				PRINTFORMW 「お詫びというわけではありませんが、そこの人形、差し上げますわ」
				PRINTFORMW 「肉便器が玩具に使うのでは勿体ないですけれど、戦う意志がまだあるなら良い武器になるでしょう」
			ELSE
				PRINTFORMW 「アラ、私が欲しいのかしら？」
				PRINTFORMW 「求められるのは嬉しいですけれど……フフフ、貴方に私は飼いならせないわ」
				PRINTFORMW 「もし私やフィネガンよりも強いサマナーになれたら考えてあげましょう」
				PRINTFORMW 「それまで、私の代わりにこの子へ情欲をぶつけなさいな」
			ENDIF
			PRINTFORMW ＞ 造魔の素体、ドリー・カドモンを受け取った
			ITEM:ドリー・カドモン += 1
			イベントフラグ:1:0 = 1
		CASE 3
			PRINTFORMW 「アラ、そう？残念ですわ」
			PRINTFORMW 「貴方の練習相手にはピッタリかと思ったのだけれど」
			PRINTFORMW 「仕方ないわね。代わりにこれを差し上げましょう」
			PRINTFORMW 150魔貨を受け取った
			MONEY:1 += 150
	ENDSELECT
	PRINTFORMW 「では私はこれで」
	PRINTFORMW 「貴方が生き残れる事を祈ってあげますわ、ウフフ」
	PRINTFORMW ＞ マヨーネは去っていった
	PRINTL 
	IF LOCAL > 0 && FLAG:戦闘難易度 < 3
	;戦闘難易度がNOMAL以下の場合、戦力として加入させることが出来る
		PRINTFORML さて、彼\@ LOCAL:1 == 0 ?  # 女 \@をどうしようか……
		CALL INPUT_YN("奴隷として扱う","戦力として扱う")
		IF RESULT == 0
			PRINTFORML %CALLNAME:MASTER%は、受け取った奴隷を奴隷部屋へ放りこむように配下に命じた
		ELSE
			PRINTFORML マヨーネが立ち去った後、%CALLNAME:MASTER%は訳ありでファントムに従っており
			PRINTW おとなしく自分の仕事を手伝えば、今すぐとは言えないが帰してやれないこともない、と話した
			PRINTFORML いかにも信憑性と説得力に欠ける話ではあったが、彼\@ LOCAL:1 == 0 ?  # 女 \@も\@ LOCAL:1 == 0 ? 処断される # 慰み者にされる \@よりは…と不承不承納得したようだ
			CFLAG:LOCAL:戦闘参加不可能 = -1
		ENDIF
	ENDIF
;入らないほう
ELSE
	PRINTL
	PRINTW 最初に手に入れる奴隷を選択してください。
	PRINTL [0] 素直で明るい１５歳ネットアイドル
	PRINTL [1] 包容力のある２３歳養護教諭(巨乳)
	PRINTL [2] ミステリアスな雰囲気の上司
	PRINTL [3] いらない
	CALL INPUTINT,0,1,2,3
	SELECTCASE RESULT
		CASE 0
			CALL ADD_NEW_COMPANION,4505,500
			FLAG:初期パートナー = 4505
			LOCAL = GETCHARA(4505)
			LOCAL:1 = 2
			PRINTFORMW 小牧 翠 を手に入れた
		CASE 1
			CALL ADD_NEW_COMPANION,4506,500
			FLAG:初期パートナー = 4506
			LOCAL = GETCHARA(4506)
			LOCAL:1 = 2
			PRINTFORMW 望月 麻里 を手に入れた
		CASE 2
			PRINTFORMW 上司の代わりに造魔の素体・ドリー・カドモンを受け取った
			ITEM:ドリー・カドモン += 1
			イベントフラグ:1:0 = 1
		CASE 3
			PRINTFORMW 準備資金として追加で150魔貨を受け取った。
			MONEY:1 += 150
	ENDSELECT
	IF LOCAL > 0 && FLAG:戦闘難易度 < 3
	;戦闘難易度がNOMAL以下の場合、戦力として加入させることが出来る
		PRINTFORML 受け取った奴隷を戦力にしますか？
		CALL INPUT_YN("はい","いいえ")
		IF RESULT == 0
			PRINTFORML 彼\@ LOCAL:1 == 0 ?  # 女 \@は\@ LOCAL:1 == 0 ? 処断される # 慰み者にされる \@よりは…と不承不承承諾した
			CFLAG:LOCAL:戦闘参加不可能 = -1
		ELSE
			PRINTFORML 受け取った奴隷を奴隷部屋へ放りこみました
		ENDIF
	ENDIF
ENDIF

