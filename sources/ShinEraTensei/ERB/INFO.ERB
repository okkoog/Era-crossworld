	SETCOLOR 0x990000
SIF (CFLAG:ARG:PTフラグ == 0 && CPOS(ARG) < 1) || CFLAG:ARG:被召喚フラグ
	SETCOLOR 0x404040
IF FLAG:ショップコマンド == 667 && CFLAG:ARG:フィルタリングフラグ
	SETCOLOR 0x404040
ELSEIF FLAG:ショップコマンド == 667
	RESETCOLOR
ENDIF
