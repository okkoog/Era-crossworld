RESETCOLOR
CLEARLINE LINECOUNT

DRAWLINE
PRINTL
ALIGNMENT CENTER


DRAWLINE
PRINTFORML %GAMEBASE_TITLE%
PRINTFORML Ver{GAMEBASE_VERSION / 1000}.{GAMEBASE_VERSION % 1000}
PRINTFORML %GAMEBASE_AUTHOR%
PRINTFORML (%GAMEBASE_YEAR%)
PRINTFORML
PRINTFORML %GAMEBASE_INFO%
DRAWLINE
PRINTL [0]  ＮＥＷ  ＧＡＭＥ
PRINTL [1] ＬＯＡＤ ＧＡＭＥ
PRINTL
PRINTL
PRINTL
PRINTL
ALIGNMENT LEFT
REDRAW 1

$INPUT_LOOP
INPUT
IF RESULT == 0
	DRAWLINE
	RESETDATA
	ADDCHARA 0
	BEGIN FIRST
ELSEIF RESULT == 1
	DRAWLINE
	CALL TITLE_LOADGAME
	GOTO PRINT_TITLE
ELSE
	GOTO INPUT_LOOP
ENDIF

