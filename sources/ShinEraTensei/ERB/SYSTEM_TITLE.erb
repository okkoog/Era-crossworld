@SYSTEM_TITLE


LOADGLOBAL
;PRINTFORMW {LINECOUNT}
;[IF_DEBUG]
;	PRINTW エラーチェック平気？
;[ENDIF]
SIF LINECOUNT > 1
	WAIT
SIF GLOBAL:4
	GOTO PRINT_TITLE

VARSET LOCAL
VARSET LOCALS

B = GETMILLISECOND()

REDRAW 0
ALIGNMENT CENTER
FOR LOCAL , 0 , 50
	CLEARLINE LINECOUNT
	SETCOLOR 255 * MIN(LOCAL , 30) / 30 , 255 * MIN(LOCAL , 30) / 30 , 255 * MIN(LOCAL , 30) / 30
	REPEAT 23
		PRINTBUTTON " " * 80 , "0"
		PRINTL
	REND
	PRINTBUTTON " " * 23 + "　このゲームは　フィクションであり" + " " * 23 , "0"
	PRINTL
	PRINTBUTTON " " * 23 +  "登場する人物や集団は　実在の個人 " + " " * 23 , "0"
	PRINTL
	PRINTBUTTON " " * 23 + "および団体とは　一切関係ありません" + " " * 23 , "0"
	PRINTL
	REPEAT 22
		PRINTBUTTON " " * 80 , 0
		PRINTL
	REND
	;[クリックorEnter待ち]表示
	A = (GETMILLISECOND()) % 3000
	A =  255 * ( A > 1500 ? (3000 - A) # (A) ) / 1500
	SETCOLOR A , A , 0
	PRINTBUTTON " " * 27 +  "[Click or Hit Return key]" + " " * 27 , "1"
	PRINTL
	;ALIGNMENT LEFT
	RESETCOLOR
	TINPUTS 100, "-1" , 0
	SIF RESULTS != "-1"
		GOTO PRINT_TITLE
NEXT
CLEARLINE LINECOUNT
ALIGNMENT LEFT


