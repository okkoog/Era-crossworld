LOCAL = 0
;リピート回数-1 の番号までの素質が表示される
;リピート回数をあらかじめ大きめに設定（最大1000）しておくと、
;素質の最大番号が増えたときに書き換える手間が減るが、
;増やしすぎると処理速度に影響するので要注意
REPEAT 250
	SIF COUNT > 212 && COUNT < 219
		CONTINUE
	IF TALENT:U:COUNT
		IF COUNT == GETNUM(TALENT, "サマナー") || COUNT == GETNUM(TALENT, "道具知識")
			PRINTFORM [%TALENTNAME:COUNT%{TALENT:U:COUNT}Lv] 
		ELSEIF COUNT == GETNUM(TALENT, "ＮＴＲ")
			SELECTCASE TALENT:U:COUNT
				CASE 1
					PRINTFORM [愛ＮＴＲ] 
				CASE 2
					PRINTFORM [淫ＮＴＲ] 
				CASE 3
					PRINTFORM [隷ＮＴＲ] 
			ENDSELECT
		ELSEIF COUNT == GETNUM(TALENT, "幼児／幼児退行")
			IF MARK:U:6 >= 1
				PRINTFORM [幼児] 
			ELSE
				PRINTFORM [幼児退行] 
			ENDIF
		ELSE
			SIF FLAG:二身合体表示 && U == CHARANUM - 1 && !CSVTALENT(NO:U, COUNT, 0)
				SETCOLOR COLOR("aqua")
			PRINTFORM [%TALENTNAME:COUNT%] 
			RESETCOLOR
		ENDIF
	ELSE
		IF FLAG:二身合体表示 && U == CHARANUM - 1 && CSVTALENT(NO:U, COUNT, 0)
			SETCOLOR COLOR("gray")
		ELSE
			CONTINUE
		ENDIF
		PRINTFORM [%TALENTNAME:COUNT%] 
		RESETCOLOR
	ENDIF
	;改行するのか？ 続けて出力するのか？
	LOCAL += 1
	SIF LOCAL%6 == 0
		PRINTL 
REND
