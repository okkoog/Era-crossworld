@MODECHANGE_SHOP_COM_110 , ARG
SELECTCASE ARG
	CASE -1
		PRINTL 
		PRINTFORMLC [1010]全員
		PRINTFORMLC [1011]陥落
		PRINTFORMLC [1012]労役中
		PRINTFORMLC [1013]売却不可
	CASE 1010 TO 1013
		Z = ARG - 1010
		RETURN ARG , -1
		
ENDSELECT
RETURN ARG , 1


;-------------------------------------------------
;ステータス表示(各キャラごと)
;-------------------------------------------------
@SHOW_CHARADATA_PAGE, ARG, ARG:1
#LOCALSIZE 6
#DIM ループ

;ページ判別はLOCALで
LOCAL = ARG
U = RESULT
;リストの何人目かをLOCAL:1に保存
LOCAL:1 = FINDELEMENT(Q, RESULT)
;リストは何人分あるかをLOCAL:2に保存
LOCAL:2 = ARG:1

;現在の行数をLOCAL:5に保存、$PRINT_PAGEに戻るときにCLEARLINE LINECOUNT - LOCAL:5
LOCAL:5 = LINECOUNT

$PRINT_PAGE
CLEARLINE LINECOUNT - LOCAL:5
;味方でない場合、赤表示
SIF CFLAG:U:PTフラグ == 0
	SETCOLOR 0x66EEEE
CUSTOMDRAWLINE =
;IF U != MASTER && FLAG:12 & 4
;	CALL PRINT_SLAVE_STATUS
;ELSEIF U == MASTER && FLAG:12 & 4
;	CALL PRINT_MASTER_STATUS
;ENDIF
CALL SHOW_INFO_NAME
CALLFORM SHOW_INFO_PAGE_{LOCAL}
IF LINECOUNT - LOCAL:5 < 38
	FOR ループ , 0 , 38 - (LINECOUNT - LOCAL:5)
		PRINTL
	NEXT
ENDIF

RESETCOLOR
PRINTFORMLC \@(LOCAL == 1) ? %" " * 16% # [1007]前のページ\@
PRINTLC   [1000]リストに戻る
PRINTFORMLC \@ LOCAL == 4 ? %" " * 16% # [1009]次のページ\@
PRINTL 
PRINTFORMLC \@(LOCAL:1 == 0) ? %" " * 16% # [1001]前のキャラ\@
PRINTFORMLC   %" " * 18%
PRINTFORMLC \@(LOCAL:1 == LOCAL:2-1) ? %" " * 16% # [1003]次のキャラ\@
PRINTFORMLC \@ABL:U:スキル1 && LOCAL == 2 && !TALENT:U:デビルシフター ? [1020]スキル並び替え # %" " * 16%\@
$INPUT_LOOP_2
INPUTS
IF RESULTS == "1000"
	RETURN 0
ELSEIF RESULTS == "1007" && LOCAL > 1
	LOCAL -= 1
	GOTO PRINT_PAGE
ELSEIF RESULTS == "1009" && LOCAL < 4
	LOCAL += 1
	GOTO PRINT_PAGE
ELSEIF RESULTS == "1001" && LOCAL:1 > 0
	LOCAL:1 -= 1
	U = Q:(LOCAL:1)
	GOTO PRINT_PAGE
ELSEIF RESULTS == "1003" && LOCAL:1 < LOCAL:2-1
	LOCAL:1 += 1
	U = Q:(LOCAL:1)
	GOTO PRINT_PAGE
ELSEIF LOCAL == 2 && RESULTS == "1020"
	$INPUT_LOOP_SKILLCHANGE
	PRINTL ひとつ目のスキルを選んで下さい
	FOR LOCAL:3, 0, FLAG:スキル数
		LOCALS:2 = スキル{LOCAL:3+1}
		IF ABL:U:(LOCALS:2)
			CALLFORM SKILL_NAME_{ABL:U:(LOCALS:2)}, U
			PRINTFORM 　[{LOCAL:3+1}]%RESULTS,20,LEFT%
		ENDIF
		SIF LOCAL:3 % 4 == 3
			PRINTL
	NEXT
	PRINTL 　[9] キャンセル
	INPUT
	SIF RESULT == 9
		GOTO PRINT_PAGE
	SIF RESULT < 0 || RESULT > 9
		GOTO INPUT_LOOP_SKILLCHANGE
	LOCALS = スキル{RESULT}
	SIF ABL:U:LOCALS <= 0
		GOTO INPUT_LOOP_SKILLCHANGE
	PRINTFORML ふたつ目のスキルを選んでください
	FOR LOCAL:3, 0, FLAG:スキル数
		LOCALS:2 = スキル{LOCAL:3+1}
		SIF ABL:U:LOCALS == ABL:U:(LOCALS:2)
			SETCOLOR 102, 255, 255
		IF ABL:U:(LOCALS:2)
			CALLFORM SKILL_NAME_{ABL:U:(LOCALS:2)}, U
			PRINTFORM 　[{LOCAL:3+1}]%RESULTS,20,LEFT%
		ENDIF
		RESETCOLOR
		SIF LOCAL:3 % 4 == 3
			PRINTL
	NEXT
	PRINTL 　[9] キャンセル
	INPUT
	SIF RESULT == 9
		GOTO PRINT_PAGE
	SIF RESULT < 0 || RESULT > 9
		GOTO INPUT_LOOP_SKILLCHANGE
	LOCALS:1 = スキル{RESULT}
	SIF ABL:U:(LOCALS:1) <= 0
		GOTO INPUT_LOOP_SKILLCHANGE
	SIF TALENT:U:ペルソナ使い
		SWAP DITEMTYPE:(EQUIP:U:装備ペルソナ):ペルソナ(LOCALS), DITEMTYPE:(EQUIP:U:装備ペルソナ):ペルソナ(LOCALS:1)
	SWAP ABL:U:LOCALS, ABL:U:(LOCALS:1)
	GOTO PRINT_PAGE
ELSEIF LOCAL == 2 && RESULTS == "2000"
	CALL PRINT_LINKAGE
	GOTO PRINT_PAGE
ELSEIF LOCAL == 2 && TOINT(RESULTS) > 0 && TOINT(RESULTS) <= FLAG:スキル数
	LOCALS = スキル%RESULTS%
	IF ABL:U:LOCALS > 0
		SIF FLAG:スキル属性表示設定 == 1
			CALLFORM SKILL_EXPLAIN_PERFORMANCE, ABL:U:LOCALS
		CALLFORM SKILL_EXPLAIN_{ABL:U:LOCALS}
		WAIT
		GOTO PRINT_PAGE
	ELSE
		GOTO INPUT_LOOP_2
	ENDIF
;ELSEIF LOCAL == 2 && TOINT(RESULTS) >= 40 && TOINT(RESULTS) <= 43 && TALENT:U:ペルソナ使い
;	RESULT = TOINT(RESULTS) - 40
;	LOCALS = 所持ペルソナ{RESULT}
;	IF RESULT == 0 && CFLAG:U:初期ペルソナナンバー
;		CALL PERSONA_STATUS(CFLAG:U:初期ペルソナナンバー)
;		WAIT
;		GOTO PRINT_PAGE
;	ELSEIF EQUIP:U:LOCALS
;		CALL PERSONA_STATUS(EQUIP:U:LOCALS)
;		WAIT
;		GOTO PRINT_PAGE
;	ELSE
;		GOTO INPUT_LOOP_2
;	ENDIF
ELSEIF LOCAL == 2 && RESULTS == "50" && GET_DEVIL(U) && GROUPMATCH(FLAG:ショップコマンド , [[ショップ:セットアップ]] , [[ショップ:能力確認]])
	CALL CHANGE_PLUGIN_SOFT, U
	;CALL EQUIPMENT, U , 6
	GOTO PRINT_PAGE
ELSEIF LOCAL == 2 && RANGE(TOINT(RESULTS), 50, 56) && !TFLAG:戦闘中 && (ABL:U:種族 == 0 || ABL:U:種族 == 36)
	;CALL EQUIP_CHANGE, TOINT(RESULTS) - 50, U, 1
	CALL EQUIPMENT, U , TOINT(RESULTS) - 50
	
	;ステータス参照用リスト作り直し
	VARSET Q , -1
	REPEAT CHARANUM
		CALL CASTING_SHOW_STATUS
		SIF RESULT
			Q:FINDELEMENT(Q, -1) = COUNT
	REND
	
	GOTO PRINT_PAGE
	
ELSEIF LOCAL == 2 && RESULTS == "悪魔変更" && (TALENT:U:ペルソナ使い || TALENT:U:デビルシフター)
	IF TALENT:U:ペルソナ使い
		CALL CHANGE_PERSONA(U)
	ELSE
		CALL ACTION_2311, U
	ENDIF
ELSEIF LOCAL == 2 && RESULTS == "57" && !TFLAG:戦闘中 && TALENT:U:ガンスリンガー > 0 && EQUIP:U:銃 > 0
	CALL EQUIP_SPECIAL_BULLET, U
	GOTO PRINT_PAGE
ELSEIF LOCAL == 2 && RANGE(TOINT(RESULTS), 4000, 4999)
	LOCAL:3 = TOINT(RESULTS)
	CALLFORM 発動者条件_{LOCAL:3}, U
	IF RESULT && GETBIT(FLAG:(1202+LOCAL:3 / 63), LOCAL:3 % 63)
		CALLFORM SKILL_NAME_{LOCAL:3}
		PRINTFORML %RESULTS%
		
		PRINT 発動者 　
		CALLFORM SKILL_COSTTYPE_{LOCAL:3}, ARG
		IF RESULT == 2
			CALLFORM SKILL_COST_{LOCAL:3}, ARG
			PRINTFORM ＨＰ{RESULT,3}％　
		ELSE
			CALLFORM SKILL_COST_{LOCAL:3}, ARG
			PRINTFORM ＭＰ{RESULT,3}　　
		ENDIF
		CALLFORM 参加人数_{LOCAL:3}
		FOR LOCAL:4, 1, RESULT + 1
			PRINTFORM 参加者{LOCAL:4}　
			CALLFORM リンケージコストタイプ_{LOCAL:3}, LOCAL:4
			IF RESULT == 2
				CALLFORM リンケージコスト_{LOCAL:3}, LOCAL:4
				PRINTFORM ＨＰ{RESULT,3}％　
			ELSE
				CALLFORM リンケージコスト_{LOCAL:3}, LOCAL:4
				PRINTFORM ＭＰ{RESULT,3}　　
			ENDIF
		NEXT
		PRINTL 
		
		CALLFORM SKILL_EXPLAIN_{LOCAL:3}
		WAIT
		GOTO PRINT_PAGE
	ELSE
		GOTO INPUT_LOOP_2
	ENDIF
ELSE
	GOTO INPUT_LOOP_2
ENDIF

