;============================================================================
;属性の表示
; <引数>
;	ARG   = 表示対象キャラ
;	ARG:1 = 省略表示有無 (0[省略時]:全文字表示／0以外:頭文字のみ表示)
;	ARG:2 = 表示対象属性 (0[省略時]:LD軸LC軸両方／1:LD軸／2:LC軸)
; <戻り値>
;	なし
;============================================================================
@PRINT_ALIGNMENT, ARG, ARG:1=0, ARG:2=0
#LOCALSIZE 1
;対象キャラのLD・LC属性を表示する。
LOCAL = GETCOLOR()
IF ARG:2 != 2
	;現在の色を退避しておく
	SELECTCASE ABL:ARG:属性LD
		CASE 1
			SETCOLOR COLOR("AQUA")
		CASE 2
			SETCOLOR COLOR("WHITE")
		CASE 3
			SETCOLOR COLOR("RED")
	ENDSELECT
	IF ARG:1
		PRINTFORM %SUBSTRING(GET_ALI1(ABL:ARG:属性LD), 0, 1)%
	ELSE
		PRINTFORM %GET_ALI1(ABL:ARG:属性LD),7%
	ENDIF
	SETCOLOR LOCAL
ENDIF
SIF ARG:2 == 0
	PRINT /

IF ARG:2 != 1
	SELECTCASE ABL:ARG:属性LC
		CASE 1
			SETCOLOR COLOR("AQUA")
		CASE 2
			SETCOLOR COLOR("WHITE")
		CASE 3
			SETCOLOR COLOR("RED")
	ENDSELECT
	IF ARG:1
		PRINTFORM %SUBSTRING(GET_ALI2(ABL:ARG:属性LC), 0, 1)%
	ELSE
		PRINTFORM %GET_ALI2(ABL:ARG:属性LC),7%
	ENDIF
	SETCOLOR LOCAL
ENDIF

