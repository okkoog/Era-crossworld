;=====================================================================
;特定のマップの特定の座標へ移動
;=====================================================================
@DUNGEON_WORP,ARG,ARG:1,ARG:2
;---- D3D 054 START (ADD) ------------------------------
SIF FLAG:현M == ARG
	D3D_WORP = 1
;---- D3D 054 END   (ADD) ------------------------------
FLAG:현M = ARG
FLAG:현X = ARG:1
FLAG:현Y = ARG:2
;現在のフロアデータを読み込み
CALL MAKE_FLOOR, FLAG:현던전
CALL AUTOMAP
;ランランダンジョン用のRUN中断フラグ立て
SIF IS_ENABLE_RUNRUN() == 1
	SETBIT FLAG:RUN중단,0
;移動後のダンジョンイベント呼び出し
CALLFORM EVENT_ENTER_DUNGEON_{FLAG:현던전},0

;=====================================================================
;特定のマップの特定の座標へ移動_ID
;=====================================================================
@DUNGEON_WORP_ID,ARG,ARG:1,ARG:2 = 0
;---- D3D 054 START (ADD) ------------------------------
SIF FLAG:현M == ARG
	D3D_WORP = 1
;---- D3D 054 END   (ADD) ------------------------------
FLAG:현M = ARG
;ランランダンジョン用のRUN中断フラグ立て
SIF IS_ENABLE_RUNRUN() == 1
	SETBIT FLAG:RUN중단,0
;現在のフロアデータを読み込み
CALL MAKE_FLOOR, FLAG:현던전
;座標移動
FLAG:현X = SEARCH_ID(ARG:1) / 100
FLAG:현Y = SEARCH_ID(ARG:1) % 100
SIF FLAG:현X < 0 || FLAG:현Y < 0
	THROW ワープ先に指定したIDが存在しません。
CALL AUTOMAP
;ARG:2 == 1 でなければ移動後のダンジョンイベント呼び出し
SIF ARG:2 == 0
	CALLFORM EVENT_ENTER_DUNGEON_{FLAG:현던전},0
RETURN 1

;=====================================================================
;@DUNGEON_TERMINAL
;ダンジョン内ターミナル処理
;　LOCAL:0 = 繰り返し用変数
;　LOCAL:1 = 実行可否真偽値　[3]自室に戻る 
;　LOCAL:2 = 実行可否真偽値　[4]仲間入れ替え
;　LOCAL:3 = 実行可否真偽値　[5]벨벳룸
;　LOCAL:4 = 実行可否真偽値　[6]マントラ取得
;=====================================================================
@DUNGEON_TERMINAL
#DIM DYNAMIC LCOUNT, 2
#DIMS DYNAMIC L_CHOICE, 100
#DIM DYNAMIC L_INPUTABLE, 100
#DIM CONST L_CHOICELENS = 36
#DIM DYNAMIC TERMINAL_LIST, 100
#DIMS DYNAMIC TERMINAL_NAME, 100
#DIM DYNAMIC L_LINE
#DIM DYNAMIC IS_EXIST_TERMINAL_LIST
;ターミナルの到達記録
SETBIT REACHED_TERMINAL:(FLAG:현던전):(FLAG:현M), -(DA:(FLAG:현X):(FLAG:현Y) / 100)

;---- EDIT 079 ADD START -------------------------
;ターミナルの突入時のイベント
TRYCALLFORM DUNGEON_ENTER_TERMINAL_{FLAG:현던전}
;---- EDIT 079 ADD END ---------------------------
CALL MESSAGE_WINDOW_D, "", @"여기는 %GET_DUNGEON_NAME_KR()% 터미널입니다/용건을 말씀해 주십시오"
CLEARLINE LINECOUNT - FLAG:커맨드표시행수
$START_2
CALL SET_VAR_TERMINAL_MAP, TERMINAL_LIST, TERMINAL_NAME
IS_EXIST_TERMINAL_LIST = RESULT
L_LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - L_LINE
VARSET L_CHOICE
VARSET L_INPUTABLE
L_CHOICE:0 '= "아무것도안한다"
L_INPUTABLE:0 = 1
L_CHOICE:1 '= "세이브"
L_INPUTABLE:1 = 1
L_CHOICE:2 '= "インストールソフト変更"
L_INPUTABLE:2 = 1
L_CHOICE:3 '= "仲間入れ替え"
L_INPUTABLE:3 = 1

IF TERMINAL_LIST:0 >= 0 && IS_EXIST_TERMINAL_LIST
	L_CHOICE:4 '= "ターミナル間移動"
	L_INPUTABLE:4 = 1
ENDIF

L_CHOICE:5 '= "青い蝶"
IF イベントフラグ:[[이벤트:페르소나]]:2
	FOR LCOUNT, 1 , 7
		SIF POS(LCOUNT) < 0
			CONTINUE
		SIF CSTR:POS(LCOUNT):롤 != "페르소나구사자"
			CONTINUE
		L_INPUTABLE:5 = 1
		BREAK
	NEXT
ENDIF

L_CHOICE:6 '= "カルマ端末"
IF FLAG:만트라개방도
	FOR LCOUNT, 1 , 7
		SIF POS(LCOUNT) < 0
			CONTINUE
		SIF !GET_ROLE_PROP("ROLE_CAN_USE_MANTRA", POS(LCOUNT))
			CONTINUE
		L_INPUTABLE:6 = 1
		BREAK
	NEXT
ENDIF

L_CHOICE:9 '= "自室に戻る"
SIF !FLAG:탈출스킬금지
	L_INPUTABLE:9 = 1

VARS SHOW_LINE, 4
VARSET SHOW_LINE
VARI LINE_CNT = 0
VARI L_NUM
FOR LCOUNT:1, 0, 2
	LINE_CNT = 0
	FOR LCOUNT, 0, 4
		L_NUM = LCOUNT:1 * 4 + LCOUNT + 1
		SIF !L_INPUTABLE:L_NUM
			CONTINUE
		SHOW_LINE:LINE_CNT += SET_BUTTON_TAG(TOALIGNMENT(@"[{L_NUM}] " + L_CHOICE:L_NUM, L_CHOICELENS, "LEFT"), TOSTR(L_NUM))
		LINE_CNT++
	NEXT
	FOR LCOUNT, LINE_CNT, 4
		SHOW_LINE:LCOUNT += " " * L_CHOICELENS
	NEXT
NEXT

FOR LCOUNT, 0, 4
	HTML_PRINT SHOW_LINE:LCOUNT
NEXT
DRAWLINE
PRINTFORM %"[0] 아무것도안한다", L_CHOICELENS, LEFT%
CALL PRINT_COLOR, "[9] 自室に戻る", FLAG:탈출스킬금지 ? COLOR("gray") # COLOR("DEF"), "L"
CALL INPUT_ARRAY, L_INPUTABLE

SELECTCASE RESULT
	CASE 0
		RETURN 1
	CASE 1
		CALL TITLE_SAVEGAME
	CASE 2
		CALL SETUP_SOFT
	CASE 3
		CALL RECONSTRUCTION
	CASE 4
		CALL TRANSFER_TERMINAL, TERMINAL_LIST, TERMINAL_NAME
		SIF RESULT
			GOTO START_2
	CASE 5
		CALL VELVET_ROOM
;---- EDIT 050 MOD START   -----------------------
	CASE 6
		CALL KARMA_TERMINAL
;---- EDIT 050 MOD END   -------------------------	
	CASE 9
		CALL MESSAGE_WINDOW_D, "", @"전송을 개시합니다"
		CALL MESSAGE_WINDOW_D, "", @"＞%CALLNAME:MASTER% 일행은 자실로 귀환했다"
		FLAG:탈출 = 1
		RETURN 1
ENDSELECT
GOTO START

;=====================================================================
;@SET_VAR_TERMINAL_MAP
;ダンジョン内のターミナル間ワープの指定リストをとるための関数
;=====================================================================
@SET_VAR_TERMINAL_MAP, TERMINAL_LIST, TERMINAL_NAME, IS_START
#DIM REF TERMINAL_LIST
#DIMS REF TERMINAL_NAME
#DIM DYNAMIC IS_START
#DIM DYNAMIC L_NUM
#DIM DYNAMIC LCOUNT, 2
L_NUM = 0
VARSET RESULT, 0, 0, 100
VARSET RESULTS, "", 0, 100
TRYCCALLFORM TERMINAL_MAP_{FLAG:현던전}, IS_START
	VARSET TERMINAL_LIST, -1
	;リストを詰めつつ、到達判定
	FOR LCOUNT, 0, 100
		SIF !RESULT:LCOUNT
			CONTINUE
		FOR LCOUNT:1, 0, RESULT:LCOUNT
			SIF !GETBIT(REACHED_TERMINAL:(FLAG:현던전):LCOUNT, LCOUNT:1)
				CONTINUE
			SIF FLAG:현M == LCOUNT && DA:(FLAG:현X):(FLAG:현Y) / 100 * -1 == LCOUNT:1
				CONTINUE
			TERMINAL_LIST:L_NUM = LCOUNT + LCOUNT:1 * 100
			IF LCOUNT:1
				TERMINAL_NAME:L_NUM '= RESULTS:(LCOUNT + (LCOUNT:1 + 1) * 100)
			ELSE
				TERMINAL_NAME:L_NUM '= RESULTS:LCOUNT
			ENDIF
			L_NUM++
		NEXT
	NEXT
	RETURN TERMINAL_LIST:0 >= 0
CATCH
	RETURN 0
ENDCATCH

;=====================================================================
;@SELECT_START_TERMINAL
;ダンジョン突入時にターミナルのリストある場合に選択させる関数
;=====================================================================
@SELECT_START_TERMINAL, TERMINAL_LIST, TERMINAL_NAME
#DIM REF TERMINAL_LIST
#DIMS REF TERMINAL_NAME
#DIM DYNAMIC IS_START
#DIM DYNAMIC L_NUM
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_INPUTABLE, 100
PRINTFORMW 시작 지점을 선택해 주십시오
DRAWLINE
IF RESULTS:100 == ""
	PRINTFORML [ 0] 入口
ELSE
	PRINTFORML [ 0] %RESULTS:100%
ENDIF
L_INPUTABLE:0 = 1
FOR LCOUNT, 0, 99
	SIF TERMINAL_LIST:LCOUNT < 0
		BREAK
	PRINTFORML [{LCOUNT + 1, 2}] %TERMINAL_NAME:LCOUNT%
	L_INPUTABLE:(LCOUNT + 1) = 1
NEXT
CALL INPUT_ARRAY, L_INPUTABLE
IF RESULT == 0
	RETURN 0
ELSE
	IF TERMINAL_LIST:(RESULT - 1) >= 100
		CALL DUNGEON_WORP_ID, TERMINAL_LIST:(RESULT - 1) % 100, -(TERMINAL_LIST:(RESULT - 1) / 100 * 100 + 9), 1
	ELSE
		CALL DUNGEON_WORP_ID, TERMINAL_LIST:(RESULT - 1), -9, 1
	ENDIF
ENDIF

;=====================================================================
;@TRANSFER_TERMINAL
;ダンジョン内でターミナル間の転送を行う関数
;=====================================================================
@TRANSFER_TERMINAL, TERMINAL_LIST, TERMINAL_NAME
#DIM REF TERMINAL_LIST
#DIMS REF TERMINAL_NAME
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_NUM
#DIM DYNAMIC L_LINE
#DIMS DYNAMIC SHOW_LINE
#DIM DYNAMIC L_INPUTABLE, 50
CLEARLINE LINECOUNT - FLAG:커맨드표시행수
L_LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - L_LINE
FOR LCOUNT:1, 0, 4
	VARSET SHOW_LINE
	FOR LCOUNT, 0, 5
		L_NUM = LCOUNT:1 + LCOUNT * 4
		IF TERMINAL_LIST:L_NUM >= 0
			SHOW_LINE += SET_BUTTON_TAG(TOALIGNMENT(@"[{L_NUM + 1, 2}] " + TERMINAL_NAME:L_NUM, 30, "LEFT"), TOSTR(L_NUM + 1))
			L_INPUTABLE:(L_NUM + 1) = 1
		ELSE
			SHOW_LINE += " " * 30
		ENDIF
	NEXT
	HTML_PRINT SHOW_LINE
NEXT
DRAWLINE
PRINTL [ 0] 돌아간다
L_INPUTABLE:0 = 1
CALL INPUT_ARRAY, L_INPUTABLE
IF RESULT == 0
	RETURN 0
ELSE
	IF TERMINAL_LIST:(RESULT - 1) >= 100
		CALL DUNGEON_WORP_ID, TERMINAL_LIST:(RESULT - 1) % 100, -(TERMINAL_LIST:(RESULT - 1) / 100 * 100 + 9), 1
	ELSE
		CALL DUNGEON_WORP_ID, TERMINAL_LIST:(RESULT - 1), -9, 1
	ENDIF
	CALL MESSAGE_WINDOW_D, "", @"전송을 개시합니다"
	CLEARLINE LINECOUNT - FLAG:커맨드표시행수
	RETURN 1
ENDIF
;=====================================================================
;エレベーター
;=====================================================================
@DUNGEON_ELEVATOR, ARG = -29
CUSTOMDRAWLINE =
PRINTL ＞엘리베이터가 있다。
VARSET RESULT, -1
VARSET RESULTS
LOCAL:1 = FLAG:현M
CALLFORM DUNGEON_ELEVATOR_{FLAG:현던전}, ARG
LOCAL:2 = RESULT
FOR LOCAL, 0, 25
	IF RESULT:LOCAL >= 0 && RESULT:LOCAL != LOCAL:1
		PRINTFORM [{LOCAL}] 
		IF !STRLENS(RESULTS:LOCAL)
			FLAG:현M = RESULT:LOCAL
			CALLFORM FLOORNAME_{FLAG:현던전}
			RESULT = LOCAL:2
		ELSE
			PRINTFORML %RESULTS:LOCAL%
		ENDIF
	ENDIF
NEXT
FLAG:현M = LOCAL:1
ARRAYSHIFT RESULT, 1, 0
PRINTL [100] 타지 않는다
$INPUT_LOOP
INPUT
IF RESULT == 100
	RETURN 1
ELSEIF RESULT < 0 || RESULT >= VARSIZE("RESULT")
	GOTO INPUT_LOOP
ELSEIF RESULT:(RESULT+1) >= 0 && RESULT:LOCAL != LOCAL:1
	CALL DUNGEON_WORP_ID, RESULT:(RESULT+1), ARG, 1
ELSE
	GOTO INPUT_LOOP
ENDIF

;=====================================================================
;トリッシュの泉
;メインはアガスティアの木サービスのほう
;セーブポイント欲しいって意見があったけど、デザイン上、基本的にはD内セーブもできないほうがいいよなぁとおもうので
;折衷案として有料セーブポイントをつくることに
;価格はARGが初回で、セーブした回数だけARG:1が加算されていく
;1回目だけは安くつかえるけど、次からすげーぼったくられるとかそういうのをできるように
;
;新版
;価格は主人のレベルと同じレベルのフラットステータスの悪魔を基準とし
;その悪魔の最大ＨＰ分回復で,売却基本額の1/12,最大ＭＰ分回復で、1/2,ステータスはそれに＋α
;セーブは基本金額の1/2
;これに調教補正をかけていく
;ただし、両方共、一回のダンジョンアタック内で複数回利用する場合、価格が上昇していく
;
;回復の泉サービスはどーかなーとおもったけど、ぼったくっとけばいいかなぁと
;記憶の泉の妖精にしてもよかったんだけど、うーん
;価格はHP5、MP1につき1魔貨、状態異常は死亡が20、毒なんかが5
;それにレベル補正が主人のレベル/4+1だけかかる
;また、状態異常はさらに対象自身のレベル/8+1の補正がかかる
;主人のレベル5で、MP100回復なら、200魔貨
;主人のレベル20で、MP300回復なら、1800魔貨
;主人のレベル40で、MP600回復なら、6600魔貨
;ダンジョン内収入減ってるし、これ使って黒字でメリットってのは考えにくいというか、普通利用したくない金額にはなってるとは思う
;ただ、長いダンジョン突貫とか、ボス戦強行突破する際においてあると金で色々解決できる的なそういう手段にしたい感じ
;
;性的なサービスはトリッシュを金で買う
;不在フラグたてて、ダンジョン内でトリッシュ調教
;陥落度に応じて、値引きが発生する…みたいなのを考えてるけど
;トリッシュに払う礼金と、割引率で悩む。あと、奴隷として獲得できちゃうかどうか
;てか、トリッシュの衣装ってそういうお店って感じだよねあれ
;=====================================================================
@FOUNTAIN_OF_TRISH
#DIM 基本価格, 1
#DIM 価格補正, 1
#DIM トリッシュ, 1
#LOCALSIZE 10
;基本価格は悪魔の基礎売却額と同じ
基本価格 = BASE:MASTER:LV * (5 + BASE:MASTER:LV / 2) * 5 / 4
;利用回数に応じて増加
FOR LOCAL, 1, FLAG:트리슈의샘이용횟수
	基本価格 = 基本価格 * 150 / 100
NEXT
CUSTOMDRAWLINE = 
IF FLAG:트리슈조교 == -1
	PRINTW ＞회복의 샘이다
	PRINTW ＞샘에는 아무도 없고、간판이 세워져 있다
	PRINTW ＞「일신상의 사정에 의해、휴업 중」
	PRINTW ＞「후임이 올 때까지 wait!」
	RETURN 0
ELSEIF FLAG:트리슈조교 == -2
	PRINTW ＞회복의 샘이다
	PRINTL 
	PRINTL 회복엘프:
	PRINTW 「여기는、회복의 샘입니~다」
ELSEIF FLAG:트리슈의샘이용횟수
	PRINTW ＞회복의 샘이다
	PRINTL 
	PRINTL 트리슈:
	PRINTW 「문 밖은 Dangerous! 주의 일초 부상 일생!」
	PRINTW 「그러니까、내가 여기에 있는 거야」
	PRINTW 「인색하게 굴지 말고、팍팍 Recover and Save!」
ELSE
	PRINTW ＞샘이 있고、그곳에 요정 같은 것이 있다…
	PRINTL 
	PRINTL 요정:
	PRINTW 「살아가는 세상은 Give and take!」
	PRINTW 「랄까 Oh! 혹시 처음 온 사람?」
	PRINTW 「그렇다면、자기소개. 나는 트리슈」
	PRINTW 「이 회복의 샘을 지키는 요정」
	PRINTW 「너희들의 상처 입은 몸을 치료해 줄게」
	PRINTW 「아、이 아가스티아 나무로 부업도 시작했거든」
	PRINTW 「너희들의 소중한 Memory의 Save도 해줄게」
	PRINTW 「물론 공짜는 아니야. 살아가는 세상은 Give and take!」
	PRINTW 「돈에 따라서 뭐든지 Recover and Save!」
	FLAG:트리슈의샘이용횟수 = 1
ENDIF
IF FLAG:트리슈조교 == -2
	PRINTL 「뭘 하시겠습니까~?」
ELSE
	PRINTL 「그래서、무슨 용무야?」
ENDIF
$START
PRINTL [0] 회복한다
PRINTL [1] 세이브한다
PRINTL [2] 성적인 서비스
トリッシュ = GETCHARA([[キャラ:트리슈_샘]])
SIF トリッシュ > -1 && 陥落(トリッシュ) >= 2
	PRINTL [3] 트리슈를 테이크아웃한다
PRINTL [9] 딱히 없다
IF FLAG:트리슈조교 != -2
	;---- EDIT 003 ADD START -------------------------
	;価格を大幅改訂
	;トリッシュの状態による補正
	価格補正 = 10000
	IF トリッシュ >= 0
		価格補正 -= 陥落(トリッシュ) * 1000
		価格補正 -= MARK:トリッシュ:굴복각인 * 500
		価格補正 -= MARK:トリッシュ:고통각인 * 250
		価格補正 -= MARK:トリッシュ:쾌락각인 * 250
		価格補正 -= MIN(2000, TALENT:MASTER:수수께끼의매력 * 500 + ABL:トリッシュ:순종 * 30, ABL:トリッシュ:욕망 * 30, ABL:トリッシュ:봉사정신 * 50, ABL:トリッシュ:노출증 * 30, ABL:トリッシュ:마조끼 * 50, ABL:トリッシュ:정액중독 * 50, ABL:トリッシュ:섹스중독 * 50)
		LOCAL:4 = (EXP:トリッシュ:절정경험 + EXP:トリッシュ:고통쾌락경험 * 5 + EXP:トリッシュ:가학쾌락경험 * 5 + EXP:トリッシュ:애정경험 * 10 + EXP:トリッシュ:봉사쾌락경험 * 5 + EXP:トリッシュ:정액경험 * 3) / 500
		WHILE LOCAL:4 > 0
			TIMES 価格補正,0.99
			LOCAL:4--
		WEND
		価格補正 = MAX(2500, 価格補正) * MAX(MARK:トリッシュ:반발각인 * 3, 1)
	ELSE
		CALL ADD_NEW_COMPANION, [[キャラ:트리슈_샘]], 200
		トリッシュ = GETCHARA([[キャラ:트리슈_샘]])
		SIF BASE:トリッシュ:LV < 15
			BASE:トリッシュ:LV = 15
		CFLAG:トリッシュ:이자리에없는플래그 = 1
	ENDIF
	;---- EDIT 003 ADD END   -------------------------
ELSE
	価格補正 = 5000
ENDIF
CALL INPUTINT(0, 1, 2, (トリッシュ > -1 && 陥落(トリッシュ) >= 2) * 3, 9)
IF RESULT == 0
	;ＨＰ/ＭＰの価格決定 
	;ＭＰの価格決定 
	VARSET LOCAL
	FOR LOCAL, 0, CHARANUM
		;HPの合計量を記録
		LOCAL:1 += MAXBASE:LOCAL:ＨＰ - BASE:LOCAL:ＨＰ
		;MPの合計量を記録
		LOCAL:2 += MAXBASE:LOCAL:ＭＰ - BASE:LOCAL:ＭＰ
		SIF GET_STATE(CFLAG:LOCAL:상태이상) == "DYING"
			LOCAL:3 += 50 * BASE:LOCAL:LV / 8 + 1
		SIF GET_STATE(CFLAG:LOCAL:상태이상) == "STONE"
			LOCAL:3 += 25 * BASE:LOCAL:LV / 8 + 1
		SIF GET_STATE(CFLAG:LOCAL:상태이상) == "FLY"
			LOCAL:3 += 15 * BASE:LOCAL:LV / 8 + 1
		SIF GET_STATE(CFLAG:LOCAL:상태이상) == "CURSE"
			LOCAL:3 += 15 * BASE:LOCAL:LV / 8 + 1
		SIF GET_STATE(CFLAG:LOCAL:상태이상) == "CHARM"
			LOCAL:3 += 10 * BASE:LOCAL:LV / 8 + 1
		SIF GET_STATE(CFLAG:LOCAL:상태이상) == "POISON"
			LOCAL:3 += 10 * BASE:LOCAL:LV / 8 + 1
		SIF GET_STATE(CFLAG:LOCAL:상태이상) == "PALYZE"
			LOCAL:3 += 10 * BASE:LOCAL:LV / 8 + 1
		SIF GET_STATE(CFLAG:LOCAL:상태이상) == "SLEEP"
			LOCAL:3 += 5 * BASE:LOCAL:LV / 8 + 1
		SIF GET_STATE(CFLAG:LOCAL:상태이상) == "PANIC"
			LOCAL:3 += 5 * BASE:LOCAL:LV / 8 + 1
		SIF GET_STATE(CFLAG:LOCAL:상태이상) == "HAPPY"
			LOCAL:3 += 5 * BASE:LOCAL:LV / 8 + 1
	NEXT
	LOCAL:4 = 0
	;フラットの場合のステ
	LOCAL:5 = (18 + BASE:MASTER:LV * 3 / 2) / 6
	;HPはフラットステ悪魔全快で基準値の1/12
	LOCAL:4 += LOCAL:1 * 100 / ((BASE:MASTER:LV + LOCAL:5*9 + 5) * (100+BASE:MASTER:LV*3) / 100) / 12
	;MPはフラットステ悪魔全快で基準値の1/2
	LOCAL:4 += LOCAL:2 * 100 / (((BASE:MASTER:LV+LOCAL:5/2+LOCAL:5*3/2)*2 + 5) * (100+BASE:MASTER:LV) /100) / 2
	;状態異常は100%で基準値の1倍
	LOCAL:4 += LOCAL:3
	LOCAL:5 = 基本価格 * LOCAL:4 * 価格補正 / 10000 / 100
	IF LOCAL:1 + LOCAL:2 + LOCAL:3 == 0
		IF FLAG:트리슈조교 == -2
			PRINTL 회복엘프
			PRINTW 「모두 건강합니~다」
		ELSE
			PRINTL 트리슈:
			PRINTW 「좋~아、그럼 아픈 거 아픈 거ォ~♪」
			PRINTW 「…랄까、모두 건강하잖아!」
			PRINTW 「이래선、회복할 수 없잖아ァ~!!」
		ENDIF
	ELSE
		IF FLAG:트리슈조교 == -2
			PRINTL 회복엘프:
			PRINTW 「지금 회복 시세라면… 어~ 그러니까…」
			PRINTFORML 「{LOCAL:5} 마카가 드는데、들어가시겠습니까~?」
		ELSE
			PRINTL 트리슈:
			PRINTW 「OK! 그럼、지금 회복 시세라면… 흠흠…」
			PRINTFORML 「{LOCAL:5} 마카 드는데 회복할래?」
		ENDIF
		CALL INPUT_YN
		IF RESULT == 0
			IF MONEY:1 >= LOCAL:5
				IF FLAG:트리슈조교 == -2
					PRINTL 회복엘프:
					PRINTW 「네~에、그럼 편히 쉬세요~」
				ELSE
					PRINTL 트리슈:
					PRINTW 「그럼、간다ァ~♪」
					PRINTW 「아픈 거 아픈 거 날아가라ァ~!」
					PRINTW 「피로로로~♪」
				ENDIF
				PRINTL 
				PRINTFORMW %CALLNAME:MASTER% 일행은 회복되었다
				MONEY:1 -= LOCAL:5
				FOR LOCAL, 0, CHARANUM
					CALL HEALTH_CHARA, LOCAL
				NEXT
				FLAG:트리슈의샘이용횟수 += 1
			ELSE
				IF FLAG:트리슈조교 == -2
					PRINTL 회복엘프:
					PRINTW 「어머~. 돈이 부족한 것 같네요~」
				ELSE
					PRINTL 트리슈:
					PRINTW 「좋~아、그럼 아픈 거 아픈 거ォ~♪」
					PRINTW 「…랄까、돈이 부족하잖아!」
					PRINTW 「다시 벌어 와!!」
				ENDIF
			ENDIF
		ELSE
			IF FLAG:트리슈조교 == -2
				PRINTL 회복엘프:
				PRINTW 「그~런가요~」
				PRINTW 「들어가고 싶어지면 언제든지 오세요~」	
			ELSE
				PRINTL 트리슈:
				PRINTW 「쳇、괜히 오기나 부리고. 죽어버려도 난 몰라」
				PRINTW 「그보다、죽어버려라 구두쇠!」
			ENDIF
		ENDIF
	ENDIF
ELSEIF RESULT == 1
	;---- EDIT 003 ADD START -------------------------
	;式変更
	LOCAL:1 = MAX(基本価格 * 価格補正 / 10000 / 2, 100)
	IF FLAG:트리슈조교 == -2
		PRINTL 회복엘프:
		PRINTW 「지금 세이브 시세라면… 어~ 그러니까…」
		PRINTFORML 「{LOCAL:1} 마카가 드는데、세이브하시겠습니까~?」
	ELSE
		PRINTL 트리슈:
		PRINTW 「OK! 그럼、지금 세이브 시세라면… 흠흠…」
		PRINTFORML 「{LOCAL:1} 마카 드는데 세이브할래?」
	ENDIF
	;---- EDIT 003 ADD END   -------------------------
	CALL INPUT_YN
	IF RESULT == 0
		IF MONEY:1 >= LOCAL:1
			IF FLAG:트리슈조교 == -2
				PRINTL 회복엘프:
				PRINTW 「그럼、이 나무에 말을 걸어주세요~」
				PRINTW 「괜찮아요. 아무도 안 보고 있고、부끄러울 것도 없으니까요~」
			ELSE
				PRINTL 트리슈:
				PRINTW 「OK、그럼、이 아가스티아 나무에 말을 거는 거야」
				PRINTW 「그리고 Memory를 Save!」
			ENDIF
			MONEY:1 -= LOCAL:1
			FLAG:트리슈의샘이용횟수 += 1
			CALL TITLE_SAVEGAME
		ELSE
			IF FLAG:트리슈조교 == -2
				PRINTL 회복엘프:
				PRINTW 「어머~. 돈이 부족한 것 같네요~」
			ELSE
				PRINTL 트리슈:
				PRINTW 「좋~아、그럼 이 아가스티아 나무에에~」
				PRINTW 「…랄까、돈이 부족하잖아!」
				PRINTW 「다시 벌어 와!!」
			ENDIF
		ENDIF
	ELSE
		IF FLAG:트리슈조교 == -2
			PRINTL 회복엘프:
			PRINTW 「그~런가요~」
			PRINTW 「이용하고 싶어지면 언제든지 오세요~」	
		ELSE
			PRINTL 트리슈:
			PRINTW 「쳇、괜히 오기나 부리고. 죽어버려도 난 몰라」
			PRINTW 「그보다、죽어버려라 구두쇠!」
		ENDIF
	ENDIF
ELSEIF RESULT == 2
	IF FLAG:트리슈조교 == -2
		PRINTL 회복엘프:
		PRINTW 「어 그러니까、저희는 그런 거 안 하는데요~」
		PRINTW 「그보다、이거 성희롱 아닌가요~?」
		PRINTW 「고소해 버릴 거예요~?」	
		GOTO START
	ENDIF
	IF FLAG:트리슈조교
		PRINTL 트리슈:
		PRINTW 「Powerful하네」
		PRINTW 「하지만、나는 Tired!」
		PRINTW 「다음에、또、서비스해 줄게」
		PRINTL 「그래서、다른 용무는 있어?」
		GOTO START
	ENDIF
	PRINTL 트리슈:
