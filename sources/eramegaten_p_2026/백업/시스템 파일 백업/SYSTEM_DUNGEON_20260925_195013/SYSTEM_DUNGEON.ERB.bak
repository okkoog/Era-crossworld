;=====================================================================
;ショップ
;書式はARGが1の時は魔貨払い、0の時は\払いで
;以降はアイテム名・価格の順番で書いていく
;CALL DUNGEON_SHOP(1, "마석", 500)
;これなら、魔石を500魔貨で売ってる店になります
;価格が0の時はITEM.CSVの値段にします
;=====================================================================
@DUNGEON_SHOP(ARG, ARGS:1 = "", ARG:1 = 0, ARGS:2 = "", ARG:2 = 0, ARGS:3 = "", ARG:3 = 0, ARGS:4 = "", ARG:4 = 0, ARGS:5 = "", ARG:5 = 0, ARGS:6 = "", ARG:6 = 0, ARGS:7 = "", ARG:7 = 0, ARGS:8 = "", ARG:8 = 0, ARGS:9 = "", ARG:9 = 0, ARGS:10 = "", ARG:10 = 0, ARGS:11 = "", ARG:11 = 0, ARGS:12 = "", ARG:12 = 0, ARGS:13 = "", ARG:13 = 0, ARGS:14 = "", ARG:14 = 0, ARGS:15 = "", ARG:15 = 0, ARGS:16 = "", ARG:16 = 0, ARGS:17 = "", ARG:17 = 0, ARGS:18 = "", ARG:18 = 0, ARGS:19 = "", ARG:19 = 0)
#DIM PRICE, 20
#DIMS BUYITEM, 1
#DIMS BUYITEMNAME, 1
#LOCALSIZE 2
#LOCALSSIZE 5
IF ARG == 3
	LOCALS = コイン
ELSEIF ARG == 1
	LOCALS = 魔貨
ELSE
	LOCALS = ￥
ENDIF
DRAWLINE
PRINTFORML 무엇을 구입하시겠습니까？		所持%LOCALS% {MONEY:ARG}
DRAWLINE
;---- EDIT 052 ADD START 存在しないアイテム名はリストに出ないように-------------------------
LOCAL = 0
LOCAL:1 = 0
WHILE 1
	PRICE:(LOCAL+1) = ARG:(LOCAL+1) ? ARG:(LOCAL+1) # ITEMPRICE:(GETNUM(ITEM, ARGS:(LOCAL+1)))
	LOCALS:1 = {PRICE:(LOCAL+1),5}%LOCALS%
	IF GETNUM(ITEM, ARGS:(LOCAL+1)) >= 10000 && GETNUM(ITEM, ARGS:(LOCAL+1)) <= 15000
		CALL GET_SKILL_PROP, "SKILL_NAME", GETNUM(ITEM, ARGS:(LOCAL+1)) - 10000
		BUYITEMNAME = 【%RESULTS%】
	ELSE
		BUYITEMNAME = %ARGS:(LOCAL+1)%
	ENDIF
	IF GETNUM(ITEM, ARGS:(LOCAL+1)) >= 0
		PRINTFORM [{LOCAL,2}] %BUYITEMNAME, 24, LEFT% %@"{PRICE:(LOCAL+1),5}%LOCALS%", 9%　　
		LOCAL:1++
	ELSE
		PRICE:(LOCAL+1) = 0
	ENDIF
	LOCAL += 1
	SIF !(LOCAL:1 & 1)
		PRINTL 
	SIF STRLENS(ARGS:(LOCAL+1)) == 0
		BREAK
WEND
SIF LOCAL:1 & 1
	PRINTL 
;---- EDIT 052 ADD END   -------------------------
$INPUT_LOOP
DRAWLINE
PRINTFORML [100] 돌아간다
INPUT
IF RESULT == 100
	RETURN -1
ELSEIF RESULT < 0 || RESULT > 19 || PRICE:(RESULT+1) == 0
	GOTO INPUT_LOOP
ELSE
	CALL DUNGEON_BUY, GETNUM(ITEM, ARGS:(RESULT+1)), PRICE:(RESULT + 1), ARG
	RESTART
ENDIF


;ARGはアイテム番号、ARG:1は価格、ARG:2は1で魔貨払い
@DUNGEON_BUY, ARG, ARG:1, ARG:2
SELECTCASE ARG
	CASE MIN_EQUIPNUM TO MAX_EQUIPNUM - 1
		IF ARG < 5500
			CALL 装備説明, ARG
			LOCAL = 999
		ELSE
			CALLFORM 装備解説_{ARG}
			LOCAL = 999
		ENDIF
	CASE MIN_USEITEMNUM TO MAX_USEITEMNUM - 1
		RESULT = 999
		CALL GET_ITEMMAX, ARG
		LOCAL = RESULT
		PRINTFORML %ITEMNAME:ARG,20,LEFT%   所持数：{ITEM:ARG}/{LOCAL}
		SIF FLAG:스킬속성표시설정 == 1
			CALL SKILL_EXPLAIN_PERFORMANCE, ARG + 2000, -1
		CALL GET_SKILL_PROP, "SKILL_EXPLAIN", ARG+2000, -1
		DRAWLINE
	CASEELSE
		TRYCALLFORM アイテム解説_{ARG}
		LOCAL = 999
ENDSELECT
IF ITEM:ARG >= LOCAL
	PRINTW 더 이상 가질 수 없습니다
ELSE
	IF MONEY:(ARG:2) < ARG:1
		PRINTW 돈이 부족합니다
	ELSE
		PRINTFORML 몇 개 구입하시겠습니까？ (현재 {ITEM:ARG}개 소지)
		CALL INPUT_MANY(0, MIN(MONEY:(ARG:2)/ARG:1, LOCAL - ITEM:ARG))
		IF RESULT
			MONEY:(ARG:2) -= (RESULT * ARG:1)
			IF RESULT == 1
				PRINTFORMW ＜%ITEMNAME:ARG%을 구입했습니다＞
			ELSE
				PRINTFORMW ＜%ITEMNAME:ARG%를 {RESULT}개 구입했습니다＞
			ENDIF
			CALL GET_ITEM, ARG, RESULT
		ENDIF
	ENDIF
ENDIF
RETURN 0
;文字列版
@DUNGEON_SHOPS(ARG, ARGS)
#DIM PRICE, 20
#DIMS BUYITEM, 1
#DIMS BUYITEMNAME, 1
#DIMS ITEMLIST , 20
#DIMS PRELIST , 40
#LOCALSIZE 2
#LOCALSSIZE 5
VARSET PRICE , 0
VARSET ITEMLIST , ""
SPLIT ARGS , "," , PRELIST
FOR LOCAL , 0 , 20
	SIF PRELIST:(LOCAL*2) == ""
		BREAK
	ITEMLIST:LOCAL = %PRELIST:(LOCAL*2)%
	PRICE:LOCAL = TOINT(PRELIST:(LOCAL*2+1)) != 0 ? TOINT(PRELIST:(LOCAL*2+1)) # ITEMPRICE:(ITEMLIST:LOCAL)
NEXT
IF ARG == 3
	LOCALS = コイン
ELSEIF ARG == 1
	LOCALS = 魔貨
ELSE
	LOCALS = ￥
ENDIF
DRAWLINE
PRINTFORML 무엇을 구입하시겠습니까？		所持%LOCALS% {MONEY:ARG}
DRAWLINE
;---- EDIT 052 ADD START 存在しないアイテム名はリストに出ないように-------------------------
LOCAL = 0
LOCAL:1 = 0
WHILE 1
	LOCALS:1 = {PRICE:LOCAL,5}%LOCALS%
	IF GETNUM(ITEM, ITEMLIST:LOCAL) >= 10000 && GETNUM(ITEM, ITEMLIST:LOCAL) <= 15000
		CALL GET_SKILL_PROP, "SKILL_NAME", GETNUM(ITEM,  ITEMLIST:LOCAL) - 10000
		BUYITEMNAME = 【%RESULTS%】
	ELSE
		BUYITEMNAME = %ITEMLIST:LOCAL%
	ENDIF
	IF GETNUM(ITEM, ITEMLIST:LOCAL) >= 0
		PRINTFORM [{LOCAL,2}] %BUYITEMNAME, 24, LEFT% %@"{PRICE:LOCAL,5}%LOCALS%", 9%　　
		LOCAL:1++
	ELSE
		PRICE:LOCAL = 0
	ENDIF
	LOCAL += 1
	SIF LOCAL:1 % 2 == 0
		PRINTL 
	SIF ITEMLIST:LOCAL == ""
		BREAK
WEND
SIF LOCAL:1 & 1
	PRINTL 
;---- EDIT 052 ADD END   -------------------------
$INPUT_LOOP
DRAWLINE
PRINTFORML [100] 돌아간다
INPUT
IF RESULT == 100
	RETURN -1
ELSEIF RESULT < 0 || RESULT > 19 || PRICE:RESULT == 0
	GOTO INPUT_LOOP
ELSE
	CALL DUNGEON_BUY, GETNUM(ITEM, ITEMLIST:RESULT), PRICE:RESULT, ARG
	RESTART
ENDIF

;=====================================================================
;扉への進入
;=====================================================================
@DUNGEON_DOOR,ARG
IF ARG > 0
	;TA:(FLAG:현M*100+FLAG:현던전):(FLAG:현X):(FLAG:현Y) = 2
	CALL SET_FLOOR_ANALYZE(2, FLAG:현던전, FLAG:현M, FLAG:현X, FLAG:현Y)
	CALL WALK_DUNGEON,ARG,1
ENDIF

;=====================================================================
;トラップ：ＨＰダメージ
;=====================================================================
@DUNGEON_TRAP_HP,ARG
SIF FLAG:리프트마
	RETURN 1
LOCAL:1 = 0
FOR LOCAL,1,7
	IF POS(LOCAL) > -1 && GET_STATE(CFLAG:(POS(LOCAL)):상태이상) != "DYING"
		IF RAND:2 && RAND:100 < MAXBASE:(POS(LOCAL)):지혜
			CONTINUE
		ELSEIF RAND:100 < MAXBASE:(POS(LOCAL)):운
			CONTINUE
		ENDIF
		CALL VAR_HP,POS(LOCAL),-MAXBASE:(POS(LOCAL)):ＨＰ*ARG/100
		LOCAL:1 += 1
	ENDIF
NEXT
PRINTFORMW \@LOCAL:1 > 0 ? %CALLNAME:MASTER% 일행은 데미지를 입었다 # %CALLNAME:MASTER% 일행은 함정을 회피했다\@
RETURN 1

;=====================================================================
;トラップ：ＭＰダメージ
;=====================================================================
@DUNGEON_TRAP_MP,ARG
SIF FLAG:리프트마
	RETURN 1
LOCAL:1 = 0
FOR LOCAL,1,7
	IF POS(LOCAL) > -1 && GET_STATE(CFLAG:(POS(LOCAL)):상태이상) != "DYING"
		IF RAND:2 && RAND:100 < MAXBASE:(POS(LOCAL)):지혜
			CONTINUE
		ELSEIF RAND:100 < MAXBASE:(POS(LOCAL)):운
			CONTINUE
		ENDIF
		CALL VAR_MP,POS(LOCAL),-MAXBASE:(POS(LOCAL)):ＭＰ*ARG/100
		LOCAL:1 += 1
	ENDIF
NEXT
PRINTFORMW \@LOCAL:1 > 0 ? %CALLNAME:MASTER% 일행은 마력을 빼앗겼다 # %CALLNAME:MASTER% 일행은 함정을 회피했다\@
RETURN 1

;=====================================================================
;トラップ：毒
;=====================================================================
@DUNGEON_TRAP_POISON,ARG,ARG:1 = 8
SIF FLAG:리프트마
	RETURN 1
LOCAL:1 = 0
FOR LOCAL,1,7
	IF POS(LOCAL) > -1 && CFLAG:(POS(LOCAL)):상태이상 < GET_STATE_NUM("POISON")
		SIF MAXBASE:POS(LOCAL):GET_TYPE(ARG:1) == 999 || MAXBASE:POS(LOCAL):GET_TYPE(ARG:1) < 1 || (100+MAXBASE:POS(LOCAL):POISON) < 1
			CONTINUE
		IF RAND:2 && RAND:100 < MAXBASE:(POS(LOCAL)):지혜
			CONTINUE
		ELSEIF RAND:100 < MAXBASE:(POS(LOCAL)):운
			CONTINUE
		ENDIF
		IF RAND:100 < ARG * MAXBASE:(POS(LOCAL)):GET_TYPE(ARG:1) * (100+MAXBASE:POS(LOCAL):POISON) / 10000
			CFLAG:(POS(LOCAL)):상태이상 = GET_STATE_NUM("POISON")
			LOCAL:1 += 1
		ENDIF
	ENDIF
NEXT
PRINTFORMW \@LOCAL:1 > 0 ? %CALLNAME:MASTER% 일행은 독을 입었다 # %CALLNAME:MASTER% 일행은 함정을 회피했다\@
RETURN 1

;=====================================================================
;トラップ：バッドステータス
;=====================================================================
@DUNGEON_TRAP_BADSTATE,ARG,ARG:1,ARG:2 = -1
;ARG:0　バステの種類
;ARG:1　付く確率
;ARG:2　バステの相性

;相性に設定がなければデフォルトの相性をつける
;※DYINGは破魔
IF ARG:2 == -1
	SELECTCASE ARG
		CASE 1,3,4,10
			ARG:2 = 9
		CASE 2
			ARG:2 = 6
		CASE 5
			ARG:2 = 5
		CASE 6,7,8,9,11
			ARG:2 = 8
		CASE 12,14
			ARG:2 = 11
		CASE 13,16,17
			ARG:2 = 17
		CASE 15,20
			ARG:2 = 10
		CASE 18
			ARG:2 = 4
		CASE 19
			ARG:2 = 7
	ENDSELECT
ENDIF
SIF FLAG:리프트마 || ARG:2 == -1
	RETURN 1
LOCAL:1 = 0
FOR LOCAL,1,7
	IF POS(LOCAL) > -1
		SIF MAXBASE:POS(LOCAL):GET_TYPE(ARG:2) == 999 || MAXBASE:POS(LOCAL):GET_TYPE(ARG:2) < 1 || (100+MAXBASE:POS(LOCAL):GET_STATE(ARG)) < 1
			CONTINUE
		IF RAND:2 && RAND:100 < MAXBASE:(POS(LOCAL)):지혜
			CONTINUE
		ELSEIF RAND:100 < MAXBASE:(POS(LOCAL)):운
			CONTINUE
		ENDIF
		IF RAND:100 < ARG:1 * MAXBASE:(POS(LOCAL)):GET_TYPE(ARG:2) * (100+MAXBASE:POS(LOCAL):GET_STATE(ARG)) / 10000
			CFLAG:(POS(LOCAL)):상태이상 = ARG
			LOCAL:1 += 1
		ENDIF
	ENDIF
NEXT
PRINTFORMW \@LOCAL:1 > 0 ? %CALLNAME:MASTER% 일행은 %GET_STATE(ARG)%에 걸렸다 # %CALLNAME:MASTER% 일행은 함정을 회피했다\@
RETURN 1

;=======================================================================
;指定したマスに進入可能か・基本
;=======================================================================
@CAN_ENTER,ARG,ARG:1
;マップの最小・最大範囲超えてたら無理
SIF ARG < 0 || ARG > FLAG:최대X || ARG:1 < 0 || ARG:1 > FLAG:최대Y
	RETURN 0
;とりあえず壁は無理
SIF DA:ARG:(ARG:1) % 10 == 0
	RETURN 0
RETURN 1

;===================================================================
;ＭＡＧ消費処理
;===================================================================
@CONSUME_MAG
FOR LOCAL:1,1,7
	LOCALS = 포지션{LOCAL:1}
	IF FLAG:LOCALS > -1
		;LOCALに消費する人の番号を突っ込む
		LOCAL = FLAG:LOCALS
		;CPが0なら飛ばす
		SIF BASE:LOCAL:CP == 0
			CONTINUE
		;種族が人間でも飛ばす
		SIF ABL:LOCAL:종족 == 0
			CONTINUE
		;---- EDIT 042 ADD START -------------------------
		;呪いのレッドカーペット起動中なら飛ばす
		SIF FLAG:저주의레드카펫
			CONTINUE
		;---- EDIT 042 ADD END -------------------------
		IF CFLAG:LOCAL:ＭＡＧ자기소비 == 1
			;自己消費がＯＮなら自分のＭＡＧを見る
			IF GET_CHARA_STOCK_MAG(LOCAL) == 0
				;ＭＡＧが空の場合主人を見る
				IF GET_CHARA_STOCK_MAG(MASTER) == 0
					;主人のも空ならダメージ処理
					CALL VAR_HP,LOCAL,-(MAXBASE:LOCAL:ＨＰ/10),"食いしばり無効ダメージ"
					CALL VAR_MP,LOCAL,-(MAXBASE:LOCAL:ＭＰ/10),"ダメージ"
				ELSE
					CALL CONTROL_MAG, MASTER, -MAXBASE:LOCAL:CP * FLAG:MAG소비율 / 100
				ENDIF
			ELSE
				;空でなければ自分で消費
				CALL CONTROL_MAG,LOCAL, -MAXBASE:LOCAL:CP * FLAG:MAG소비율 / 100
			ENDIF
		ELSE
			;自己消費がＯＦＦなら主人のＭＡＧを見る
			IF GET_CHARA_STOCK_MAG(MASTER) == 0
				;主人のＭＡＧが空の場合自分のＭＡＧを見る
				IF GET_CHARA_STOCK_MAG(LOCAL) == 0
					;主人のも空ならダメージ処理
					CALL VAR_HP,LOCAL,-(MAXBASE:LOCAL:ＨＰ/10),"食いしばり無効ダメージ"
					CALL VAR_MP,LOCAL,-(MAXBASE:LOCAL:ＭＰ/10),"ダメージ"
				ELSE
					CALL CONTROL_MAG, LOCAL,-MAXBASE:LOCAL:CP * FLAG:MAG소비율 / 100
				ENDIF
			ELSE
				;空でなければ主人で消費
				CALL CONTROL_MAG,MASTER,-MAXBASE:LOCAL:CP  * FLAG:MAG소비율 / 100
			ENDIF
		ENDIF
	ENDIF
NEXT

;===================================================================
;ＭＡＧ消費切り替え
;===================================================================
@SWITCH_MAG

$PRINT_LIST
DRAWLINE
FOR LOCAL,1,7
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 1
		CONTINUE
	PRINTFORM [{LOCAL}]　
	CALL ARRANGE_CHARALIST_2,FLAG:LOCALS
	CALL ARRANGE_CHARALIFE, FLAG:LOCALS
	PRINTFORM 　MAG:[{GET_CHARA_STOCK_MAG(FLAG:LOCALS),8}/{GET_CHARA_MAXMAG(FLAG:LOCALS),8}] \@ CFLAG:(FLAG:LOCALS):ＭＡＧ자기소비 ? 자기소비 # 주인소비 \@
NEXT
PRINTL

DRAWLINE
PRINTFORML ＭＡＧ소비를 전환하고 싶은 캐릭터를 선택해주세요
DRAWLINE

PRINTLC [1000]돌아간다

$INPUT_LOOP_1
INPUT
LOCALS = 포지션{RESULT}
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT < 1 || RESULT > 6 || FLAG:LOCALS < 1
	GOTO INPUT_LOOP_1
ELSE
	IF CFLAG:(FLAG:LOCALS):ＭＡＧ자기소비 == 0
		CFLAG:(FLAG:LOCALS):ＭＡＧ자기소비 = 1
	ELSE
		CFLAG:(FLAG:LOCALS):ＭＡＧ자기소비 = 0
	ENDIF
ENDIF
RESTART


;===================================================================
;ID捜査
;===================================================================
@SEARCH_ID(ARG)
#FUNCTION
FOR LOCAL,0,FLAG:최대X
	FOR LOCAL:1,0,FLAG:최대Y
		IF DA:(LOCAL):(LOCAL:1) == ARG
			RETURNF LOCAL*100+LOCAL:1
		ENDIF
	NEXT
NEXT
RETURNF -101


;===================================================================
;エストマ・リベラマ等の効力
;　COMPの機能でデフォでエンカウント率変動とかあるといいかも
;===================================================================
@ENCOUNTER_CHANGER
;FLAG:エンカウント率補正 = 0
FLAG:에스트마 = 0
FLAG:라이트마 = 0
FLAG:리프트마 = 0
FLAG:리베라마 = 0
FLAG:디스가이즈굿즈 = 0
;---- EDIT 096 ADD START -------------------------
FLAG:맵퍼= 0
;---- EDIT 096 ADD END ---------------------------
RETURN 1


;===================================================================
;月齢変化
;===================================================================
@MOON
#DIM L_CHARA
#DIMS TEMPS
IF FLAG:월령벡터 == 0
	FLAG:월령 ++
ELSE
	FLAG:월령 --
ENDIF
SIF FLAG:월령 > 8
	FLAG:월령 = 8
SIF FLAG:월령 < 0
	FLAG:월령 = 0
SIF FLAG:월령 == 8
	FLAG:월령벡터 = 1
SIF FLAG:월령 == 0
	FLAG:월령벡터 = 0

IF FLAG:월령 == 0 && FLAG:SHOP커맨드 == [[ショップ:탐색]]
	;SIF FLAG:エンカウント率補正 || FLAG:에스트마
	;---- EDIT 084 MOD START -------------------------
	IF FLAG:에스트마 || FLAG:리베라마 || FLAG:디스가이즈굿즈
		IF FLAG:디스가이즈굿즈
			FLAG:디스가이즈굿즈 = 0
			;一応ここでも折っておく
			FLAG:리베라마 = 0
			IF IS_HAVES_USEITEM("디스가이즈굿즈")
				PRINTL 이어서 디스가이즈 굿즈를 사용하겠습니까?
				CALL INPUT_YN, "사용한다", "그만둔다"
				SIF RESULT == 0
					CALL ACTION_FIELD, SKILL_NUM_F("디스가이즈굿즈")
			ENDIF
		ELSEIF FLAG:리베라마 < 0
			FLAG:리베라마 = 0
			IF IS_HAVES_USEITEM("집마의피리")
				PRINTL 이어서 집마의 피리를 사용하겠습니까?
				CALL INPUT_YN, "사용한다", "그만둔다"
				SIF RESULT == 0
					CALL ACTION_FIELD, SKILL_NUM_F("집마의피리")
			ENDIF
		ELSE
			L_CHARA = FINDCHARA_ID(FLAG:리베라마 - 1)
			FLAG:리베라마 = 0
			IF L_CHARA >= 0
				CALL CHECK_ACTIONABLE, L_CHARA, SKILL_NUM_F("리베라마")
				IF RESULT && HAVE_SKILL(L_CHARA, SKILL_NUM_F("리베라마"))
					IF L_CHARA == MASTER
						PRINTL 이어서 리베라마를 사용하겠습니까?
					ELSE
						PRINTFORML 이어서 %CALLNAME:L_CHARA%에게 리베라마를 사용하게 하겠습니까?
					ENDIF
					CALL INPUT_YN, "사용한다", "그만둔다"
					IF RESULT == 0
						CALL ACTION_FIELD, SKILL_NUM_F("리베라마"), L_CHARA
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		IF FLAG:에스트마
			IF FLAG:에스트마 < 0
				IF FLAG:에스트마 == -2
					TEMPS = 황금의벌꿀주
				ELSE
					TEMPS = 봉마의방울
				ENDIF
				FLAG:에스트마 = 0
				IF IS_HAVES_USEITEM(TEMPS)
					PRINTFORML 이어서 %TEMPS%을(를) 사용하겠습니까?
					CALL INPUT_YN, "사용한다", "그만둔다"
					SIF RESULT == 0
						CALL ACTION_FIELD, SKILL_NUM_F(TEMPS)
				ENDIF
			ELSE
				L_CHARA = FINDCHARA_ID(FLAG:에스트마 - 1)
				FLAG:에스트마 = 0
				IF L_CHARA >= 0
					CALL CHECK_ACTIONABLE, L_CHARA, SKILL_NUM_F("에스트마")
					IF RESULT && HAVE_SKILL(L_CHARA, SKILL_NUM_F("에스트마"))
						IF L_CHARA == MASTER
							PRINTL 이어서 에스트마를 사용하겠습니까?
						ELSE
							PRINTFORML 이어서 %CALLNAME:L_CHARA%에게 에스트마를 사용하게 하겠습니까?
						ENDIF
						CALL INPUT_YN, "사용한다", "그만둔다"
						IF RESULT == 0
							CALL ACTION_FIELD, SKILL_NUM_F("에스트마"), L_CHARA
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	IF FLAG:라이트마
		PRINTW 라이트마의 효과가 끊어졌다.
		IF FLAG:라이트마 < 0
			TEMPS = 전망구슬
			FLAG:라이트마 = 0
			IF IS_HAVES_USEITEM(TEMPS)
				PRINTFORML 이어서 %TEMPS%을(를) 사용하겠습니까?
				CALL INPUT_YN, "사용한다", "그만둔다"
				SIF RESULT == 0
					CALL ACTION_FIELD, SKILL_NUM_F(TEMPS)
			ENDIF
		ELSE
			L_CHARA = FINDCHARA_ID(FLAG:라이트마 - 1)
			FLAG:라이트마 = 0
			IF L_CHARA >= 0
				CALL CHECK_ACTIONABLE, L_CHARA, SKILL_NUM_F("라이트마")
				IF RESULT && HAVE_SKILL(L_CHARA, SKILL_NUM_F("라이트마"))
					IF L_CHARA == MASTER
						PRINTL 이어서 라이트마를 사용하겠습니까?
					ELSE
						PRINTFORML 이어서 %CALLNAME:L_CHARA%에게 라이트마를 사용하게 하겠습니까?
					ENDIF
					CALL INPUT_YN, "사용한다", "그만둔다"
					IF RESULT == 0
						CALL ACTION_FIELD, SKILL_NUM_F("라이트마"), L_CHARA
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	IF FLAG:리프트마
		PRINTW 리프트마의 효과가 끊어졌다.
		IF FLAG:리프트마 < 0
			TEMPS = 코어실드
			FLAG:리프트마 = 0
			IF IS_HAVES_USEITEM(TEMPS)
				PRINTFORML 이어서 %TEMPS%을(를) 사용하겠습니까?
				CALL INPUT_YN, "사용한다", "그만둔다"
				SIF RESULT == 0
					CALL ACTION_FIELD, SKILL_NUM_F(TEMPS)
			ENDIF
		ELSE
			L_CHARA = FINDCHARA_ID(FLAG:리프트마 - 1)
			FLAG:리프트마 = 0
			IF L_CHARA >= 0
				CALL CHECK_ACTIONABLE, L_CHARA, SKILL_NUM_F("리프트마")
				IF RESULT && HAVE_SKILL(L_CHARA, SKILL_NUM_F("리프트마"))
					IF L_CHARA == MASTER
						PRINTL 이어서 리프트마를 사용하겠습니까?
					ELSE
						PRINTFORML 이어서 %CALLNAME:L_CHARA%에게 리프트마를 사용하게 하겠습니까?
					ENDIF
					CALL INPUT_YN, "사용한다", "그만둔다"
					IF RESULT == 0
						CALL ACTION_FIELD, SKILL_NUM_F("리프트마"), L_CHARA
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	;---- EDIT 000 XXX START -------------------------
	IF FLAG:맵퍼
		PRINTW 매퍼의 효과가 끊어졌다.
		IF FLAG:맵퍼 < 0
			TEMPS = 둔갑나침반
			FLAG:맵퍼 = 0
			IF IS_HAVES_USEITEM(TEMPS)
				PRINTFORML 이어서 %TEMPS%을(를) 사용하겠습니까?
				CALL INPUT_YN, "사용한다", "그만둔다"
				SIF RESULT == 0
					CALL ACTION_FIELD, SKILL_NUM_F(TEMPS)
			ENDIF
		ELSE
			L_CHARA = FINDCHARA_ID(FLAG:맵퍼 - 1)
			FLAG:맵퍼 = 0
			IF L_CHARA >= 0
				CALL CHECK_ACTIONABLE, L_CHARA, SKILL_NUM_F("맵퍼")
				IF RESULT && HAVE_SKILL(L_CHARA, SKILL_NUM_F("맵퍼"))
					IF L_CHARA == MASTER
						PRINTL 이어서 매퍼를 사용하겠습니까?
					ELSE
						PRINTFORML 이어서 %CALLNAME:L_CHARA%에게 매퍼를 사용하게 하겠습니까?
					ENDIF
					CALL INPUT_YN, "사용한다", "그만둔다"
					IF RESULT == 0
						CALL ACTION_FIELD, SKILL_NUM_F("맵퍼"), L_CHARA
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	;---- EDIT 000 XXX END ---------------------------
	;---- EDIT 084 MOD END ---------------------------
	;FLAG:エンカウント率補正 = 0
	CALL 酔い覚まし()
	TRYCALLFORM EVENT_NEWMOON_DUNGEON{FLAG:현던전}
ENDIF

;===================================================================
;月齢歩き
;===================================================================
@MOVE_MOON,ARG
LOCAL += 1
IF LOCAL >= 16 * FLAG:월령진행률 / 100
	LOCAL = 0
	CALL MOON
ENDIF

;===================================================================
;ＤＤＭ
;自宅のサーバーに悪魔を転送する
;===================================================================
@COMP_DDM
;CALL INPUT_CHARA_LIST("자택 서버로 전송할 악마를 선택해 주십시오", "CASTING_COMP_DDM", "UP_PRINT_COMP_DDM")
{
CALL INPUT_CHARA_LIST
	, "FUNC_PROPSET_LIST_BATTLE"
	, "자택 서버로 전송할 악마를 선택해 주십시오"
	, "CASTING_COMP_DDM" 
	, "UP_PRINT_COMP_DDM"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
IF RESULT == 1000
	RETURN 0
ELSE
	;---- EDIT 013 ADD START -------------------------
	IF CFLAG:RESULT:PT플래그 == 2
		PRINTFORML %CALLNAME:RESULT%는 전투에 참가 중인 멤버입니다
		PRINTFORML 자택 서버로 전송하더라도、이대로 전투에
		PRINTFORML 계속 참가시킬지、선택해 주십시오
		LOCAL = RESULT
		CALL INPUT_SELECT(1, "계속 참가시킨다", 2, "멤버에서 제외하고 전송한다", 9, "전송을 취소한다")
		IF RESULT == 9
			RESTART
		ELSEIF RESULT == 2
			CALL REMOVE_POSITION, CPOS(LOCAL)
			PRINTFORMW %CALLNAME:LOCAL%을(를) 전투 멤버에서 제외하고、자택 서버로 전송했습니다
		ENDIF
		RESULT = LOCAL
	ENDIF
	;---- EDIT 013 ADD END -------------------------
	CFLAG:RESULT:소속ＣＯＭＰ = -1
	;---- EDIT 012 MOD START ------------------------
	;送った悪魔がリストから消えるようにリスト構築からやり直させる
	RESTART
	;GOTO PRINT_LIST
	;---- EDIT 012 MOD END   ------------------------
ENDIF

@CASTING_COMP_DDM(ARG)
SIF ARG == MASTER
	RETURN 0
;---- EDIT 098 MOD START -------------------------
SIF !GET_ROLE_PROP("CAN_PUT_IN_COMP", ARG)
	RETURN 0
;SIF (ABL:ARG:종족 == 0 || ABL:ARG:종족 > 45)
;	RETURN 0
;---- EDIT 098 MOD END ---------------------------
SIF CFLAG:ARG:이자리에없는플래그 == 1
	RETURN 0
;---- EDIT 012 MOD START ------------------------
;第一引数がLOCALだったのをARGに修正
;SIF CFLAG:ARG:용량미사용
;	RETURN 0
SIF CFLAG:ARG:소속ＣＯＭＰ == -1
	RETURN 0
;---- EDIT 012 MOD END   ------------------------
RETURN 1

@UP_PRINT_COMP_DDM
PRINTFORML 자택 서버로 전송할 악마를 선택해 주십시오　\@ A > リスト表示数() ? ＜page.{P + 1}/{A / リスト表示数() + 1}＞ # \@　ＣＯＭＰ：{NUM_NAKAMA()}/{GET_STOCKSIZE()}


;---- EDIT 021 ADD START -------------------------

;=================================================
;   sub DG_GET_TILE
;=================================================
;   タイル文字取得
;-------------------------------------------------
; Input:
;  ARG:0				X座標
;  ARG:1				Y座標
;  ARG:2				M番号
;  ARG:3				ダンジョン番号
; Output:
;  RESULTS				タイル文字
;-------------------------------------------------
@DG_GET_TILE(ARG:0, ARG:1, ARG:2, ARG:3)
#DIM LX
#DIM LY
#DIM LM
#DIM LD
#DIM TILE_VAL
#DIMS KEY
#LOCALSSIZE 2

LX = ARG:0
LY = ARG:1
LM = ARG:2
LD = ARG:3
LOCALS =
KEY =
TILE_VAL = DA:LX:LY


IF (TILE_VAL % 10) == -1
	KEY = D
ELSE
	KEY = {TILE_VAL % 10}
ENDIF
TRYCCALLFORM TILE_MARK_COMMON_{LD}_%KEY%, TILE_VAL, LX, LY
	SIF RESULT == 1
		GOTO NO_COMMON
	LOCALS = %RESULTS%
CATCH
	$NO_COMMON
	TRYCCALLFORM TILE_MARK_ID_{LD}_{LM}_% \@TILE_VAL < 0 ? m # \@%{ABS(TILE_VAL)}
		LOCALS = %RESULTS%
	CATCH
		;- DG:タイル標準文字
		CALL DG_BASE_TILE(LX, LY, LM, LD)
		LOCALS = %RESULTS%
	ENDCATCH
ENDCATCH

;-- ダンジョン32:이상한던전 --------
;動的に特殊タイルを設定する	※シンボルエンカウントなどの『移動するオブジェクト』対応
;　※M番号、X座標、Y座標を関数名ではなく引数で渡すことでシンボルエンカウントなどの『移動するオブジェクト』の描画に対応可能とする
IF FLAG:지형자동생성・FOE플래그 == 1
	CALL SEF_TILE_MARK_DYBANUC, LX, LY
	LOCALS = %RESULTS%
ENDIF
;-- ダンジョン32:이상한던전 --------

;---- EDIT 093 ADD START -------------------------
LOCALS:1 '= LOCALS
;---- EDIT 093 ADD END ---------------------------
;---- EDIT 051 MOD  -------------------------
IF GETCOLOR() == GETDEFCOLOR()
	SELECTCASE LOCALS
		CASE "■"
			SETCOLOR GETDEFCOLOR()
		CASE "□"
			IF DA:LX:LY < 0
				SETCOLOR 0x333344
			ELSE
				;---- EDIT 092 ADD START -------------------------
				IF 一時探索経路履歴:(FLAG:현M):LX:LY && DUNGEON_SHOW_TEMP_EXPLORED_ROUTE
					IF DUNGEON_SHOW_TEMP_EXPLORED_ROUTE == 1
						LOCALS = %UNICODE(0x303C)%
					ELSE
						LOCALS = ■
					ENDIF
					SETCOLOR COLOR("p-blue")
				ELSE
					SETCOLOR 0x777766
				ENDIF
				;---- EDIT 092 ADD END ---------------------------
			ENDIF
		CASE "扉"
			IF 一時探索経路履歴:(FLAG:현M):LX:LY && DUNGEON_SHOW_TEMP_EXPLORED_ROUTE
				SETCOLOR COLOR("p-blue")
			ELSE
				SETCOLOR 0x8888aa
			ENDIF
		CASE "宝"
			SETCOLOR 0xffdd99
		CASE "罠"
			SETCOLOR 0xbb0033
		CASE "昇", "降"
			SETCOLOR 0x44aa00
		CASE "Ｔ", "ｔ", "！"
			SETCOLOR 0xaa44ff
		CASE "Ｒ", "Ｃ"
			SETCOLOR 0x77bbff
		CASE "↑", "→", "↓", "←", "Ｅ", "出"
			SETCOLOR 0xff7700
		CASEELSE
	ENDSELECT
ENDIF
;---- EDIT 093 MOD START -------------------------
RESULTS '= LOCALS, LOCALS:1
;---- EDIT 093 MOD END ---------------------------

;=================================================
;   sub DG_BASE_TILE
;=================================================
;   タイル標準文字
;-------------------------------------------------
; Input:
;  ARG:0				X座標
;  ARG:1				Y座標
;  ARG:2				M番号
;  ARG:3				ダンジョン番号
; Output:
;  RESULTS				タイル標準文字
;-------------------------------------------------
@DG_BASE_TILE(ARG:0, ARG:1, ARG:2, ARG:3)
#DIM LX
#DIM LY
#DIM LM
#DIM LD
#DIM TILE_VAL
#LOCALSSIZE 1

LX = ARG:0
LY = ARG:1
LM = ARG:2
LD = ARG:3
LOCALS=
TILE_VAL = DA:LX:LY

SELECTCASE TILE_VAL % 10
	CASE 0
		LOCALS = ■
	CASE 1
		LOCALS = □
	CASE 2
		LOCALS = 扉
	CASE 3
		LOCALS = 宝
	CASE 4
		LOCALS = ！
	CASE 5
		IF GET_FLOOR_ANALYZE_T(LX, LY) == 2
			LOCALS = 罠
		ELSE
			LOCALS = □
		ENDIF
	CASE 6
		LOCALS = 昇
	CASE 7
		LOCALS = 降
	CASE 8
		LOCALS = 出
	CASE -1 
		LOCALS = □
	CASE -9
		SELECTCASE -(TILE_VAL % 100) / 10
			CASE 0
				LOCALS = Ｔ
			CASE 1
				LOCALS = Ｒ
			CASE 2
				LOCALS = Ｅ
		ENDSELECT
	CASEELSE
		TRYCCALLFORM TILE_MARK_{LD}_{LM}_{LX}_{LY}
			LOCALS = %RESULTS%
		CATCH
			LOCALS = ■
		ENDCATCH
ENDSELECT

RESULTS = %LOCALS%


@CONVERT_OUTRANGE_COORD_X, LX
#FUNCTION
#DIM DYNAMIC LX
SIF !FLOOR_IS_LOOP_X
	RETURNF LX
SIF LX < 0
	LX += FLAG:최대X
SIF LX >= FLAG:최대X
	LX -= FLAG:최대X
RETURNF LX

@CONVERT_OUTRANGE_COORD_Y, LY
#FUNCTION
#DIM DYNAMIC LY
SIF !FLOOR_IS_LOOP_Y
	RETURNF LY
SIF LY < 0
	LY += FLAG:최대Y
SIF LY >= FLAG:최대Y
	LY -= FLAG:최대Y
RETURNF LY

;---- EDIT 021 ADD END   -------------------------
;---- EDIT 050 ADD START -------------------------
@KARMA_TERMINAL
	CUSTOMDRAWLINE =
	
	PRINTL 식노의 세팅을 실행합니다
	PRINTL 실행할 내용을 선택해 주십시오
	
	DRAWLINE
	
	PRINTL [1] 스킬 세트
	PRINTL [2] 스테이터스 세트
	PRINTL [3] 만트라 취득
	
	DRAWLINE
	PRINTL [0] 아무것도 안 한다

	CALL INPUTINT,0,1,2,3

	SELECTCASE RESULT
		CASE 0
			RETURN 1
		CASE 1
			CALL SET_KARMANS_SKILL
		CASE 2
			CALL SET_KARMANS_STATUS
		CASE 3
			CALL KARMAN
	ENDSELECT
	RESTART
		
;---- EDIT 050 ADD END -------------------------	
;---- EDIT 029 ADD START -------------------------
@KARMAN
	LOCAL:1 = 0
	FOR LOCAL, 1, 7
		SIF POS(LOCAL) < 0
			CONTINUE
		SIF !TALENT:POS(LOCAL):식노
			CONTINUE
		;行動可能なキャラでないとダメ
		CALL INPUTABLE_CHARA, POS(LOCAL)
		SIF !RESULT
			CONTINUE
		LOCAL:1 = 1
		BREAK
	NEXT
	IF !LOCAL:1
		PRINTW 만트라를 취득할 수 있는 캐릭터가 없습니다
		RETURN 0
	ENDIF
	LOCAL:2 = LINECOUNT
	$MANTRA_LOOP
	CLEARLINE LINECOUNT - LOCAL:2
	CALL SHOW_NOW_FORMATION_P,0,2
;---- EDIT 050 MOD START -------------------------
;RESTAT選べる意味がなさそうなのでコメントアウト
;	PRINTL [0] ＣＡＮＣＥＬ [2000]ＡＬＬ ＣＡＮＣＥＬ
	PRINTL [0] 돌아간다
	PRINTL 누구에게 만트라를 취득시키겠습니까?
;	CALL INPUTINT(0,1,2,3,4,5,6,2000)
	CALL INPUTINT(0,1,2,3,4,5,6)
	IF RESULT == 0
;		RESTART
;	ELSEIF RESULT == 2000
		RETURN 0
;---- EDIT 050 MOD END -------------------------
	ELSE
		LOCAL = POS(RESULT)
		SIF LOCAL < 0
			GOTO MANTRA_LOOP
		IF !TALENT:LOCAL:식노
			PRINTFORMW %CALLNAME:LOCAL%은(는) 식노가 아닙니다
			GOTO MANTRA_LOOP
		ENDIF
		CALL INPUTABLE_CHARA, LOCAL
		IF !RESULT
			PRINTFORMW %CALLNAME:LOCAL%은(는) 만트라를 취득할 수 있는 상태가 아닙니다
			GOTO MANTRA_LOOP
		ENDIF
		CALL DOWNLOAD_MANTRA, 7, 7, LOCAL
		GOTO MANTRA_LOOP
	ENDIF
;---- EDIT 029 ADD END   -------------------------

;---- EDIT 050 ADD START -------------------------
@SET_KARMANS_SKILL

	LOCAL:1 = LINECOUNT
	$MANTRA_LOOP
	CLEARLINE LINECOUNT - LOCAL:1
	CALL SHOW_NOW_FORMATION_P,0,2
	PRINTL [0] 돌아간다
	PRINTL 누구의 장비스킬을 변경할까？
	CALL INPUTINT(0,1,2,3,4,5,6)
	IF RESULT == 0
		RETURN 0
	ELSE
		LOCAL = POS(RESULT)
		SIF LOCAL < 0
			GOTO MANTRA_LOOP
		IF !TALENT:LOCAL:식노
			PRINTFORMW %조사처리(CALLNAME:LOCAL,"는")%는 식노가 아닙니다
			GOTO MANTRA_LOOP
		ENDIF
		CALL INPUTABLE_CHARA, LOCAL
		IF !RESULT
			PRINTFORMW %조사처리(CALLNAME:LOCAL,"는")% 스킬을 세트할 수 있는 상태가 아닙니다
			GOTO MANTRA_LOOP
		ENDIF
		CALL SET_MANTRA_SKILL,LOCAL
		GOTO MANTRA_LOOP
	ENDIF
	
@SET_KARMANS_STATUS

	LOCAL:1 = LINECOUNT
	$MANTRA_LOOP
	CLEARLINE LINECOUNT - LOCAL:1
	CALL SHOW_NOW_FORMATION_P,0,2
	PRINTL [0] 돌아간다
	PRINTL 누구의 스테이터스배분을 변경할까？
	CALL INPUTINT(0,1,2,3,4,5,6)
	IF RESULT == 0
		RETURN 0	
	ELSE
		LOCAL = POS(RESULT)
		SIF LOCAL < 0
			GOTO MANTRA_LOOP
		IF !TALENT:LOCAL:식노
			PRINTFORMW %조사처리(CALLNAME:LOCAL,"는")%는 식노가 아닙니다
			GOTO MANTRA_LOOP
		ENDIF
		CALL INPUTABLE_CHARA, LOCAL
		IF !RESULT
			PRINTFORMW %조사처리(CALLNAME:LOCAL,"는")% 스테이터스를 변경할 수 있는 상태가 아닙니다
			GOTO MANTRA_LOOP
		ENDIF
		CALL MANTRA_BASESTATUS,LOCAL
		GOTO MANTRA_LOOP
	ENDIF

;---- EDIT 050 ADD END -------------------------
;---- EDIT 093 ADD START -------------------------
@MAPPING_USER, SELECT_NUM, SELECT_MODE
#DIM DYNAMIC L_LINE
#DIM DYNAMIC SELECT_NUM
#DIMS DYNAMIC SELECT_MODE
#DIM DYNAMIC STOCK_REDRAW
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
STOCK_REDRAW = CURRENTREDRAW()
REDRAW 0
L_LINE = LINECOUNT
WHILE 1
	CLEARLINE LINECOUNT - L_LINE
	CALL SHOW_FLOOR, , , "SET" + SELECT_MODE, SELECT_NUM
	;現パーティ描画
	CALL SHOW_NOW_FORMATION_P,0,2,,"探索中"
	IF SELECT_MODE == "COLOR"
		IF SELECT_NUM
			HTML_PRINT SET_BUTTON_TAG("[0] COLOR CONFIG", "0")
		ELSE
			HTML_PRINT SET_COLOR_TAG("[0] COLOR CONFIG", "gray")
		ENDIF
	ELSE
		IF SELECT_NUM
			HTML_PRINT SET_BUTTON_TAG("[0] OBJECT CONFIG", "0")
		ELSE
			HTML_PRINT SET_COLOR_TAG("[0] OBJECT CONFIG", "gray")
		ENDIF
	ENDIF
	HTML_PRINT SET_BUTTON_TAG("[1] ALL RESET", "1")
	HTML_PRINT SET_BUTTON_TAG("[9] END", "9")
	PRINTL 
	PRINTSL GETLINESTR("=")
	PRINTL

	ONEINPUTS
	SELECTCASE RESULTS
		CASE "0"
			IF SELECT_MODE == "COLOR"
				IF SELECT_NUM
					CALL COLOR_SETTER, @"■", DUNGEON_USER_TILE_COLOR:SELECT_NUM, GET_DEFAULT_USER_TILE_COLOR(SELECT_NUM)
					DUNGEON_USER_TILE_COLOR:SELECT_NUM = RESULT
					SAVEGLOBAL
				ENDIF
			ELSE
				PRINTFORML 타일로 설정하고 싶은 오브젝트를 입력해 주십시오.
				PRINTFORML 아무것도 입력하지 않았을 경우 기본 오브젝트가 설정됩니다.
				INPUTS
				IF RESULTS == ""
					DUNGEON_USER_TILE_OBJECT:SELECT_NUM '= GET_DEFAULT_USER_TILE_OBJECT(SELECT_NUM)
				ELSEIF STRLENS(RESULTS) > 2
					PRINTFORMW 문자열이 너무 깁니다!
				ELSE
					DUNGEON_USER_TILE_OBJECT:SELECT_NUM = %RESULTS, 2, LEFT%
				ENDIF
				SAVEGLOBAL
			ENDIF
		CASE "1"
			IF SELECT_MODE == "COLOR"
				FOR L_Y, 0, FLAG:최대Y
					FOR L_X, 0, FLAG:최대X
						CALL SET_FLOOR_USER_COLOR, 0, FLAG:현던전, FLAG:현M, L_X, L_Y
					NEXT
				NEXT
				TEMP_SHOW_LAST_FLOOR = -1
			ELSEIF SELECT_MODE == "OBJECT"
				FOR L_Y, 0, FLAG:최대Y
					FOR L_X, 0, FLAG:최대X
						CALL SET_FLOOR_USER_OBJECT, 0, FLAG:현던전, FLAG:현M, L_X, L_Y
					NEXT
				NEXT
				TEMP_SHOW_LAST_FLOOR = -1
			ENDIF
		CASE "9"
			BREAK
		CASEELSE
			IF STRCOUNT(RESULTS, "SETCOLOR")
				L_X = TOINT(AUTO_SPLIT(RESULTS, "/", 1))
				L_Y = TOINT(AUTO_SPLIT(RESULTS, "/", 2))
				;同じ色で塗った場合はリセット
				IF TEMP_USER_COLOR:L_X:L_Y == SELECT_NUM
					CALL SET_FLOOR_USER_COLOR, 0, FLAG:현던전, FLAG:현M, L_X, L_Y
					TEMP_USER_COLOR:L_X:L_Y = 0
				ELSE
					CALL SET_FLOOR_USER_COLOR, SELECT_NUM, FLAG:현던전, FLAG:현M, L_X, L_Y
					TEMP_USER_COLOR:L_X:L_Y = SELECT_NUM
				ENDIF
			ELSEIF STRCOUNT(RESULTS, "MAPPING_USER_COLOR")
				SELECT_NUM = TOINT(AUTO_SPLIT(RESULTS, "/", 1))
				SELECT_MODE = COLOR
			ELSEIF STRCOUNT(RESULTS, "SETOBJECT")
				L_X = TOINT(AUTO_SPLIT(RESULTS, "/", 1))
				L_Y = TOINT(AUTO_SPLIT(RESULTS, "/", 2))
				IF TEMP_USER_OBJECT:L_X:L_Y == SELECT_NUM
					CALL SET_FLOOR_USER_OBJECT, 0, FLAG:현던전, FLAG:현M, L_X, L_Y
					TEMP_USER_OBJECT:L_X:L_Y = 0
				ELSE
					CALL SET_FLOOR_USER_OBJECT, SELECT_NUM, FLAG:현던전, FLAG:현M, L_X, L_Y
					TEMP_USER_OBJECT:L_X:L_Y = SELECT_NUM
				ENDIF
			ELSEIF STRCOUNT(RESULTS, "MAPPING_USER_OBJECT")
				SELECT_NUM = TOINT(AUTO_SPLIT(RESULTS, "/", 1))
				SELECT_MODE = OBJECT
			ENDIF
	ENDSELECT
WEND
REDRAW STOCK_REDRAW
;---- EDIT 093 ADD END ---------------------------

@SET_DEFAULT_USER_TILE_OBJECT
#DIM DYNAMIC LCOUNT
FOR LCOUNT, 0, VARSIZE("DUNGEON_USER_TILE_OBJECT")
	DUNGEON_USER_TILE_OBJECT:LCOUNT '= GET_DEFAULT_USER_TILE_OBJECT(LCOUNT)
NEXT
SAVEGLOBAL

@GET_DEFAULT_USER_TILE_OBJECT, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF ""
	CASE 1
		RETURNF "◆"
	CASE 2
		RETURNF "◇"
	CASE 3
		RETURNF "★"
	CASE 4
		RETURNF "☆"
	CASE 5
		RETURNF "○"
	CASE 6
		RETURNF "●"
	CASE 7
		RETURNF "◎"
	CASE 8
		RETURNF "Ж"
	CASE 9
		RETURNF "※"
	CASE 10
		RETURNF "Δ"
	CASE 11
		RETURNF UNICODE(0x2460)
	CASE 12
		RETURNF UNICODE(0x2461)
	CASE 13
		RETURNF UNICODE(0x2462)
	CASE 14
		RETURNF UNICODE(0x2463)
	CASE 15
		RETURNF UNICODE(0x2464)
	CASE 16
		RETURNF UNICODE(0x2465)
	CASE 17
		RETURNF UNICODE(0x2466)
	CASE 18
		RETURNF UNICODE(0x2467)
	CASE 19
		RETURNF UNICODE(0x2468)
	CASE 20
		RETURNF UNICODE(0x2469)
	CASE 21
		RETURNF UNICODE(0x2776)
	CASE 22
		RETURNF UNICODE(0x2777)
	CASE 23
		RETURNF UNICODE(0x2778)
	CASE 24
		RETURNF UNICODE(0x2779)
	CASE 25
		RETURNF UNICODE(0x277A)
	CASE 26
		RETURNF UNICODE(0x277B)
	CASE 27
		RETURNF UNICODE(0x277C)
	CASE 28
		RETURNF UNICODE(0x277D)
	CASE 29
		RETURNF UNICODE(0x277E)
	CASE 30
		RETURNF UNICODE(0x277F)
ENDSELECT

@IS_CLEARED_FIRST_DUNGENON
#FUNCTION
SIF ダンジョンフラグ:[[ダンジョン:에코빌딩]]:1 >= 1
	RETURNF 1
SIF FLAG_D34_クリアフラグ
	RETURNF 1
SIF ダンジョンフラグ:[[ダンジョン:하라주쿠]]:0 == 5
	RETURNF 1
SIF ダンジョンフラグ:[[ダンジョン:야토빌딩]]:0
