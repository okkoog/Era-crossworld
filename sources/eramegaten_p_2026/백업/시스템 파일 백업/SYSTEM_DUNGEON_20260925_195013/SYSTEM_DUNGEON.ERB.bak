				TALENT:トリッシュ:여성혐오 = 0
				TALENT:トリッシュ:억압 = 0
				TALENT:トリッシュ:해방 = 1
				TALENT:トリッシュ:약점 = 1
				TALENT:トリッシュ:망신 = 1
				TALENT:トリッシュ:헌신적 = 1
				TALENT:トリッシュ:불결무시 = 1
				TALENT:トリッシュ:쾌감에솔직 = 1
		ENDSELECT
		;---- EDIT 003 ADD END   -------------------------
		MONEY:1 -= LOCAL:1
	ENDIF
	;助手は使えない
	ASSI = -1
	TARGET = トリッシュ
