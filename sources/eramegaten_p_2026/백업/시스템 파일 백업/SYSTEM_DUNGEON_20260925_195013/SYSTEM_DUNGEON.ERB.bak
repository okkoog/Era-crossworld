	FLAG:트리슈조교 = 1
	FLAG:던전내조교 = 1
	RETURN 1
;---- EDIT 003 ADD START -------------------------
;take outの位置を変更
ELSEIF RESULT == 3 && トリッシュ > -1 && 陥落(トリッシュ) >= 2
	PRINTL 트리슈:
	PRINTW 「어、날 take out하고 싶다고?」
