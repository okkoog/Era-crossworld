		ELSE
			TALENT:ARG:여성혐오 = 1
			TALENT:ARG:바이 = 0
		ENDIF
ENDSELECT

;マイルド強化価格計算
@ADVANCE_DEMONIEZD_MILD_MONEY, ARG, ARGS:1, ARGS:2
#DIM 価格計算, 1

;基本価格は3万
価格計算 = 30000

;強化する耐性で変動
IF MAXBASE:ARG:(ARGS:1) >= 100
	;弱点または無耐性なら加算なし
	価格計算 += 0
ELSEIF MAXBASE:ARG:(ARGS:1) > 50
	;耐性ありなら1万加算
	価格計算 += 10000
ELSE
	;半減以上なら3万加算(無効以下の場合は強化されないが、しっかり金はかかる)
	価格計算 += 30000
ENDIF

IF MAXBASE:ARG:(ARGS:2) >= 100
	価格計算 += 0
ELSEIF MAXBASE:ARG:(ARGS:2) > 50
	価格計算 += 10000
ELSE
	価格計算 += 30000
ENDIF

RETURN 価格計算


;狂神ソース
@ADVANCE_DEMONIEZD_TYPE_3141, ARGS, ARG
#LOCALSSIZE 1
#DIM 価格計算, 1

CALLFORM ADVANCE_DEMONIEZD_HARD_MONEY, ARG
価格計算 = RESULT

SELECTCASE ARGS
	CASE "アドバンスドタイプ"
		RESULTS = 광신
	CASE "해설"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "광신 소스를 추가하려는 거지？/그렇다면 정신과 신경과 전격에 엄청 강해진단다"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "거듭 말하지만 무슨 일이 일어나도 자기 책임이란다？/난 단지 네 말대로 기계를 조작했을 뿐…/행한 것은 너 자신이니까 말이야？"
	CASE "チェック"
		IF TALENT:ARG:붕괴 == 1
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "…이 애는 이제 못 쓰게 되었어/이 이상의 강화는 무의미하네…"
			RETURN 0
		ENDIF
		RETURN 1
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "가능한 한 성공률을 올릴 수 있도록 노력은 하겠지만/그래도 " + TOSTR(価格計算) + "마카는 필요하단다/정말로 "+ CALLNAME:ARG + " 쨩에게 광신 소스를 주입해도 괜찮겠니？"
	CASE "価格"
		RETURN 価格計算
	CASE "アドバンスド実行"
		;ハード強化共通処理
		CALLFORM ADVANCE_DEMONIEZD_HARD, ARG
		SIF RESULT == 0
			RETURN
		
		CSTR:ARG:종족명 = 광신
		IF MAXBASE:ARG:정신 > 0
			MAXBASE:ARG:정신 -= 50
			BASE:ARG:정신 -= 50
			IF MAXBASE:ARG:정신 < 0
				MAXBASE:ARG:정신 = 0
				BASE:ARG:정신 = 0
			ENDIF
		ENDIF
		IF MAXBASE:ARG:신경 > 0
			MAXBASE:ARG:신경 -= 50
			BASE:ARG:신경 -= 50
			IF MAXBASE:ARG:신경 < 0
				MAXBASE:ARG:신경 = 0
				BASE:ARG:신경 = 0
			ENDIF
		ENDIF
		IF MAXBASE:ARG:전격 > 0
			MAXBASE:ARG:전격 -= 50
			BASE:ARG:전격 -= 50
			IF MAXBASE:ARG:전격 < 0
				MAXBASE:ARG:전격 = 0
				BASE:ARG:전격 = 0
			ENDIF
		ENDIF
ENDSELECT


