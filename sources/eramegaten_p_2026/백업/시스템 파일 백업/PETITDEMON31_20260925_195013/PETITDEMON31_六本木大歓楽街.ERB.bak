	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"응, 잘 됐어/이게 인간을 그만둔 지금 당신의 모습이야/거울로 완성된 모습을 체크해보렴"
	
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 비치고 있었다/＞이전과 아무것도 변하지 않은 것처럼 보인다…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다곤 해도 안색은 다소 나빠져 버린 듯하다/앞으로는 화장을 더 해야겠군, 옷차림도 바꿔볼까？/하고 " + CALLNAME:MASTER + "는 묘하게 들뜬 기분으로 생각했다…"
ELSE
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"알겠어/그럼 넌 여기서 기다리고 있으렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"네, 완료됐어/인간을 그만둔 " + CALLNAME:ARG + " 쨩의 모습, 제대로 봐주렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주의 안내를 받으며 " + CALLNAME:ARG + "가 돌아왔다"
		SELECTCASE NO:ARG
			CASE 4541
				IF 恋慕系陥落(ARG)
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"이 몸이라도 탐정 업무에 지장은 없을 것 같네요/하지만…"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞나오토는 연신 거울을 보며 자신의 옷차림을 신경 쓰고 있다/＞입술을 손가락으로 매만지거나 옷자락을 들어 올려 보기도 한다"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"…조, 조금은 여자아이다운 옷을 입어볼까/거기에, 그, 화장이라든가, 액세서리라든가…"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그 편이 미행하더라도 눈에 띄지 않을지도 모르니까/라며 나오토는 변명조의 말을 중얼거리고 있었다"
				ENDIF
			CASEELSE
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞이전과 겉모습은 거의 변하지 않았다/신경이 쓰여 몸을 살짝 만져보니 서늘한 체온이 느껴졌다"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 이전보다도 자신의 모습이나 옷차림에 신경 쓰는 듯하다/수줍음 때문이 아니라 자신을 더 돋보이게 하고 싶다, 주목받고 싶다는 의미에서다"
	ENDSELECT
ENDIF

;サキュバス
@DEMONIEZD_SET_3120, ARG
#LOCALSSIZE 1

IF NO:MASTER == NO:ARG
	CFLAG:MASTER:소속ＣＯＭＰ = -1
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 이쪽으로 와주겠니？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 안내받아 옷을 벗은 " + CALLNAME:MASTER + "는 작은 캡슐에 들어갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 시작할게/인간으로서의 삶에 작별을 고해두렴…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞등에 간질간질한 감촉을 맛보며/＞" + CALLNAME:MASTER + "의 의식은 아득해져 갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자, 점주가 말을 걸어왔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"응, 잘 됐어/이게 인간을 그만둔 지금 당신의 모습이야/거울로 완성된 모습을 체크해보렴"
	
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 아름다운 야마의 모습이 비치고 있었다/＞자신인 것을 알고 있으면서도 넋을 잃고 바라보게 될 정도다"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…바라보고 있자니 묘한 기분이 든다/＞이 자리에서 자신의 몸을 더듬고 싶은 충동을 참으며 " + CALLNAME:MASTER + "는 거울에서 눈을 돌렸다…"
ELSE
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"알겠어/그럼 넌 여기서 기다리고 있으렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"네, 완료됐어/인간을 그만둔 " + CALLNAME:ARG + " 쨩의 모습, 제대로 봐주렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주의 안내를 받으며 " + CALLNAME:ARG + "가 돌아왔다"
		SELECTCASE NO:ARG
			CASE 4541
				IF 恋慕系陥落(ARG)
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"하늘은 날 수 있으니 이 몸이라도 탐정 일은 계속할 수 있을 것 같네요"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇게 말한 나오토는 이쪽이 넋을 잃고 쳐다보는 것을 눈치채자/＞수줍은 듯 머뭇거리며 치켜뜬 눈으로 시선을 보내왔다"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"너, 너무 보지 말아 주세요/이 모습, 그렇게 눈에 띄나요？/미행하기에는 부적합할지도…"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇게 말하면서도 나오토는 어딘가 황홀해하는 모습이었다/미행보다는 침대에서 정보를 쥐어짜내는 타입의 탐정이 어울릴지도 모르겠다…"
				ENDIF
			CASEELSE
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "의 모습이 남아 있는 아름다운 야마가 그곳에 있었다/등에서 돋아난 피막 날개조차 에로틱하게 보인다……"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 자신에게 쏠린 시선을 의식하자 뜨거운 한숨을 내쉬었다/＞솟구치는 음열을 견디지 못하고 몸부림치듯 요염하게 몸을 배배 꼬며/요염하게 젖은 눈동자로 유혹하듯 " + CALLNAME:MASTER + "를 바라본다…"
	ENDSELECT
ENDIF

