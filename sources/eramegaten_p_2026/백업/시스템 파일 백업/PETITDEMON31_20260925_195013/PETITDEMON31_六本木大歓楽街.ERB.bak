		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "부작용으로는 이성에게 혐오감을 느끼게 된단다/거기에 따라 엄격한 생활을 하게 된다는 모양이야"
	CASE "チェック"
		IF (TALENT:ARG:남자 == 0 && TALENT:ARG:남성혐오 == 1) || (TALENT:ARG:남자 == 1 && TALENT:ARG:여성혐오 == 1) 
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "어머, 이 애는 이미 이성을 싫어하는 것 같네/이 이상은 위험하니 그만두렴"
			RETURN 0
		ENDIF
