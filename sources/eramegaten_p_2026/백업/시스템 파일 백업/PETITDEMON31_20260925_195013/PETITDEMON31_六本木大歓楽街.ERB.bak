ELSE
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"알겠어/그럼 넌 여기서 기다리고 있으렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"네, 완료됐어/인간을 그만둔 " + CALLNAME:ARG + " 쨩의 모습, 제대로 봐주렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주의 안내를 받으며 " + CALLNAME:ARG + "가 돌아왔다"
	SELECTCASE NO:ARG
		CASE 4501
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"설마 새가 될 줄은 생각도 못 했어/…이 다리로는 조금 걷기 힘들고, 평소에는 날아다니는 게 나으려나/어깨가 뻐근해질 것 같아"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞베스는 양팔의 날개를 퍼덕이며 공중에 떠 있다/＞확실히 새 다리로는 걷기 힘들겠지/＞원한다면 평소에는 팔에 매달려 있어도 상관없는데？"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"！/…그렇네, 기왕 새로 변한 거니까, 당신과 함께 매사냥꾼 흉내라도 내볼까"
			ENDIF
		CASE 4504
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"우와아！ 나, 새가 되어버렸어！/…새는 이렇게 하늘을 나는구나/생각했던 것보다 지치네"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞미라이는 새로운 모습이 된 것을 아이답게 즐기고 있다/＞하지만 아직 덜 자란 몸으로는 하늘을 나는 게 꽤나 지치는 모양이다/＞새라면 아직 둥지를 떠나지도 않았을 나이니 당연한 일이다"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"그렇네, 난 아직 아이니까…/그때까지 잘 부탁해, 여보%UNICODE(0x2661)%/그 대신 내가 어른이 되면 당신을 키워줄게%UNICODE(0x2661)%"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞어쩐지 미라이는 색다른 장래를 그리고 있는 듯하다/＞이것저것 가르쳐놓은 탓일까…"
			ENDIF
		CASE 4505
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "도리", @"으~음… 손이 새 날개로 변했으니까, 지금까지의 코스프레론 안 되고…/그렇다고 이런 모습의 정의의 사도도 별로 없고…/저기저기, 어떤 코스프레라면 어울릴 것 같아？"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞도리는 날개를 움직여 하늘을 날면서 새로운 코스프레를 고민하고 있다/＞혼자서 하지 말고 다른 동료마와 팀을 짜보는 건 어떨까/＞각자 결정 포즈라도 취하며 이름을 대면 되겠지"
				;戦隊ヒーローとかバビル○世とか
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "도리", @"앗！ 좋은 아이디어잖아♪/내가 매지컬 돌리니까 매지컬… 뭘로 삼아볼까나！/불타오르기 시작했어~！"
			ENDIF
		CASE 4506
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마리", @"마리 선생님, 새가 되어버렸습니다%UNICODE(0x2661)%/…이제 가운은 못 입겠네. 팔이 안 들어가/게다가 이 다리로는 걷기 힘드니까 바로 날 수 있도록 연습하고 싶고…"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마리는 자신의 손발을 보며 우선 입을 수 있는 옷을 고민하고 있는 듯하다/＞애초에 알몸이면 안 되는 걸까？/＞하반신은 깃털로 덮여 있고 하피는 원래 전라인데"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마리", @"잠깐, 당신 군… 선생님도 여자야？/좋아하는 사람 외에는 알몸을 보여주고 싶지 않다는 게 그렇게 이상한 일일까…"
			ENDIF
		CASE 4516
			IF 恋慕系陥落(ARG)
				IF TALENT:ARG:유아체형
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"우후후, 저 새가 되었어요！/…하늘을 나는 건 생각보다 정신없네요/어깨가 결려버릴 것 같아요"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마요네는 팔, 아니 날개를 퍼덕이며 생각에 잠긴 듯하다/＞확실히 제법 빠른 템포로 위아래로 움직이는 날개를 보면 지치겠다는 생각은 든다/＞일단 지치면 언제든 이쪽에 매달려도 된다고 마요네에게 말해주었다…"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"감사해요, 여보%UNICODE(0x2661)%/그럼 당장 어깨에라도 매달려 볼까요…/음… 이렇게… 어라？"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞아무래도 머리를 끼고 이쪽의 양 어깨를 잡으려는 것 같지만/＞안 그래도 짧아진 데다 새처럼 굽은 지금 마요네의 다리로는 머리를 넘기가 힘겨운 모양이다…"
				ELSE
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"저, 이 옷은 마음에 들었습니다만…/역시 새의 몸에는 맞지 않네요/알몸은 싫고, 뭔가 옷을 생각해 봐야겠어요"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마요네는 자신의 육체가 변한 것보다도 복장을 신경 쓰고 있다/＞역시 마요네, 육체에 대한 걱정은 하지 않는 모양이다"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"당신이 바란 육체인걸요, 거기에 이의는 없어요/어떻게 이 육체를 살려갈 것인가, 를 생각할 뿐이죠/다행히 보지는 깃털 아래에 있는 것 같고 안아주실 수는 있을 것 같으니 말이에요"
				ENDIF
			ENDIF
		CASE 4541
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"이 몸으로는 아무래도 탐정은 폐업이겠네요…/하늘을 날 수 있는 이점은 있지만, 손을 쓸 수 없다는 건 뼈아픕니다"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞나오토는 자신의 다리를 날개로 쓰다듬으며 앞으로의 일을 생각하고 있다/＞애초에 악마가 되었으니 일 걱정 따위는 하지 않아도 될 텐데/＞어차피 ＭＡＧ는 이쪽에서 제공해 줄 테고…"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"그렇게 말씀하셔도 아무것도 하지 않고 있으면 안정이 안 된단 말입니다/게다가, 그, 당신을 돕고 싶기도 하고요…"
			ENDIF
		CASE 4559
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "코시로", @"으~음… 이 몸, 학교 친구들이 뭐라고 할까나…/연필 같은 건 이제 쥘 수도 없고 말이지…/애초에 나, 악마가 됐는데도 아직 학교 가야 하는 걸까"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞코시로는 의자에 앉아 팔, 아니 날개를 위아래로 움직이며 생각에 잠겨 있다/＞…순간, 코시로가 갑자기 이쪽을 돌아보았다"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "코시로", @"물론 탐정 씨는 내 몸을 개조한 책임을 져주시겠죠？/일단, 그 왜 공주님 안기라는 거, 해주세요/팔이 조금 피곤해져서…"
			ENDIF
		CASEELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 팔, 아니 날개를 위아래로 움직이며 날면서 이쪽을 보고 미소 짓고 있다/＞어쩐지 사냥감을 노리는 하피가 떠오르는 미소다"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞예상대로 " + CALLNAME:ARG + "는 이쪽으로 덥석 안겨 왔다/＞날개가 간지럽다…"
	ENDSELECT
ENDIF

;좀비
@DEMONIEZD_SET_3117, ARG
#LOCALSSIZE 1

IF NO:MASTER == NO:ARG
	CFLAG:MASTER:소속ＣＯＭＰ = -1
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 이쪽으로 와주겠니？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 안내받아 옷을 벗은 " + CALLNAME:MASTER + "는 작은 캡슐에 들어갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 시작할게/인간으로서의 삶에 작별을 고해두렴…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞전신이 차가워져 가는 감촉을 맛보며/＞" + CALLNAME:MASTER + "의 의식은 아득해져 갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자, 점주가 말을 걸어왔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"응, 잘 됐어/이게 인간을 그만둔 지금 당신의 모습이야/거울로 완성된 모습을 체크해보렴"
	
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 비치고 있었다/＞이전과 아무것도 변하지 않은 것처럼 보인다…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그러고 보니 과거에 5일 동안 밤샘했을 때와 똑같은 얼굴이네/라고 어렴풋이 떠올렸다…"
ELSE
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"알겠어/그럼 넌 여기서 기다리고 있으렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"네, 완료됐어/인간을 그만둔 " + CALLNAME:ARG + " 쨩의 모습, 제대로 봐주렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주의 안내를 받으며 " + CALLNAME:ARG + "가 돌아왔다"
	
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞이전과 겉모습은 거의 변하지 않았다/신경이 쓰여 몸을 살짝 만져보니 서늘한 체온이 느껴졌다"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞일단 내일 식사는 생고기를 내어볼까 생각하며/반응을 기대해 보기로 했다…"
ENDIF

