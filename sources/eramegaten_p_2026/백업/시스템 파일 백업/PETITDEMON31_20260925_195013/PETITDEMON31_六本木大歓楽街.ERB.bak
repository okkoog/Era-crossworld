;------------------------------
;ADDタイプ
;------------------------------

;幽鬼ソース
@ADVANCE_DEMONIEZD_TYPE_3131, ARGS, ARG
#LOCALSSIZE 1
#DIM 価格計算, 1

CALLFORM ADVANCE_DEMONIEZD_MILD_MONEY, ARG, "주살", "신경"
価格計算 = RESULT

SELECTCASE ARGS
	CASE "アドバンスドタイプ"
		RESULTS = 유귀
	CASE "해설"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "유귀 소스를 추가하려는 거지？/그렇다면 주살과 신경에 강해진단다"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "부작용으로 감정이 희박해진단다"
	CASE "チェック"
		IF TALENT:ARG:감정결핍 == 1
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "어머, 이 애는 이미 감정이 희박하네/이 이상은 정신이 망가질 가능성이 있으니 그만두렴"
			RETURN 0
		ENDIF
		RETURN 1
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "상성상 " + TOSTR(価格計算) + "마카가 들지만/정말로 "+ CALLNAME:ARG + " 쨩에게 유귀 소스를 주입해도 괜찮겠니？"
	CASE "価格"
		RETURN 価格計算
	CASE "アドバンスド実行"
		CSTR:ARG:종족명 = 유귀
		IF MAXBASE:ARG:주살 > 0
			MAXBASE:ARG:주살 -= 25
			BASE:ARG:주살 -= 25
			IF MAXBASE:ARG:주살 < 0
				MAXBASE:ARG:주살 = 0
				BASE:ARG:주살 = 0
			ENDIF
		ENDIF
		IF MAXBASE:ARG:신경 > 0
			MAXBASE:ARG:신경 -= 25
			BASE:ARG:신경 -= 25
			IF MAXBASE:ARG:신경 < 0
				MAXBASE:ARG:신경 = 0
				BASE:ARG:신경 = 0
			ENDIF
		ENDIF
		TALENT:ARG:감정결핍 = 1
ENDSELECT


;比丘尼ソース
@ADVANCE_DEMONIEZD_TYPE_3132, ARGS, ARG
#LOCALSSIZE 1
#DIM 価格計算, 1

