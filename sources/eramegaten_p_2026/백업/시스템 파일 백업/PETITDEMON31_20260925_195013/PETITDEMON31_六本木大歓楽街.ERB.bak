;롯폰기 대환락가
;쁘띠 데모 관련

;여러모로 확장할 여지가 있어 보여, 창관과 마찬가지로 분할
;이쪽도 공통화 가능한 부분을 단일화

;데모나이즈드에 대해 이것저것 날조
;내부 종족을 악마인으로 통일하고, 데모나이즈드된 인간≒악마인 취급
;복수의 데빌 소스를 주입해 내성을 강화하는 기능 추가

;플래그 관리 메모
;8　쁘띠 데모 숍 이용 경험 플래그　0:미이용　1:이용한 적 있음
;9　쁘띠가 아닌 데모 이용 경험 플래그　0:미이용　1:이용한 적 있음　2:강화 이용 경험 있음


;=======================================================================
;쁘띠 데모
;=======================================================================
@PETIT_DEMON_31
#DIM CHARA, 1
#DIMS VALUES
#DIM BF_FLAG, 1
#DIM サーチ変数, 1
#DIMS L_BTL_TALENT
CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"쁘띠 데모 숍에 어서 오렴♪//"
IF ダンジョンフラグ:31:8 == 0
	ダンジョンフラグ:31:8 = 1
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞산양 같은 뿔을 기른 억센 남자가 인사를 건네왔다/＞악마는 아닌 것 같은데…？/"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"어머, 손님, 처음 온 거니？/괜찮아, 넌 이제부터 유행의 최첨단을 달리게 될 테니까/내가 확실하게 설명해·줄·게%ハート()%"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞근육질의 몸과 어투의 갭이 심한 점주는, 그렇게 말하며 설명을 시작했다…//"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"여기는 말이지, 악마의 모습을 자신의 몸에 받아들일 수 있는 가게란다/우리가 듬뿍 가지고 있는 데빌 소스를 사용해서 말이지/"
	;ＳＪのパロディです、ＩＭＡＧＩＮＥにはそんな情報有りません
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"구체적으로는, 동물의 귀를 기르거나, 꼬리를 달거나/날개를 돋아나게 하거나, 인어가 되는 것도 가능하단다/"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그리고, 너희가 원한다면/쁘띠가 아닌 진짜 데모나이즈드도 해줄게/이건 별로 추천하진 않지만 말야…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"자, 그럼…//"
ENDIF
$P_31

VALUES = 오늘은 무슨 볼일이니？//
VALUES += "[1]쁘띠 데모를 한다/"
IF ダンジョンフラグ:31:9 == 0
	VALUES += "[2]쁘띠가 아닌 데모를 한다/"
ELSE
	VALUES += "[2]데모나이즈드한다/"
ENDIF
IF ダンジョンフラグ:31:9 == 1 && BASE:MASTER:LV >= 60
	VALUES += "[3]강화 데모나이즈드/"
ELSEIF ダンジョンフラグ:31:9 == 2
	VALUES += "[3]ADD/"
ELSE
	VALUES += "/"
ENDIF
VALUES += "[4]상태를 본다//"
VALUES += "[0]밖으로 나간다"

CALL INPUT_SELECT_D, VALUES, , , 2
IF RESULT == 4
	CALL SHOP_COM_301
ELSEIF RESULT == 1
	$P_31_1
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "그럼, 오늘은 누구를 쁘띠 데모 시킬 거니？"
	CALLFORM PETIT_DEMON_TARGET_COUNT, 1
	IF RESULT == 0
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "어머, 쁘띠 데모를 해줄 수 있는 애가 없네/말할 것도 없지만, 그래선 쁘띠 데모를 할 수 없단다"
		GOTO P_31
	ENDIF
	CALLFORM PETIT_DEMON_TARGET, 1
	IF RESULT == 0
		GOTO P_31
	ELSE
		CHARA = POS(RESULT)
	ENDIF
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", CALLNAME:CHARA + "에게 쁘띠 데모를 할 거니？"
	CALL INPUT_YN_D , "쁘띠 데모 시킨다" , "그만둔다"
	SIF RESULT == 1
		GOTO P_31_1
	$P_31_2
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 어떤 쁘띠 데모를 할 거니？"
	CALLFORM PETIT_DEMON_SELECT, 1
	IF RESULT == 0
		GOTO P_31
	ELSE
		LOCAL = 0
		LOCAL = RESULT
	ENDIF
	CALLFORM PETIT_DEMON_TYPE_{LOCAL}, "チェック", CHARA
	IF RESULT == 0
		GOTO P_31_2
	ENDIF
	CALLFORM PETIT_DEMON_TYPE_{LOCAL}, "確認", CHARA
	CALLFORM PETIT_DEMON_TYPE_{LOCAL}, "価格", CHARA
	IF MONEY:1 < RESULT
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "…어머, 너/마카가 부족하잖아/다른 걸로 고르렴"
		GOTO P_31_2
	ENDIF
	CALL INPUT_YN_D , "받는다" , "그만둔다"
	IF RESULT == 1
		GOTO P_31_2
	ENDIF
	CALLFORM PETIT_DEMON_TYPE_{LOCAL}, "価格", CHARA
	MONEY:1 -= RESULT
	;プチデモ実行
	CALLFORM PETIT_DEMON_SET_{LOCAL}, CHARA
	GOTO P_31_2
ELSEIF RESULT == 2
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "쁘띠가 아닌 데모나이즈드, 할 거니？"
	IF ダンジョンフラグ:31:9 == 0
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞그 말을 듣자마자, 점주의 눈빛이 날카로워졌다"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "…그래, 우선 본래의 데모나이즈드에 대해 설명해 줄게"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "우리 가게에서 평소에 해주는 쁘띠 데모는/악마의 「겉모습」만을 인간의 몸에 받아들이는 거야/그러니까 쁘띠 데모를 한 후에도 그 사람은 어엿한 인간이란다"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "하지만, 진짜 데모나이즈드는 달라/본래의 데모나이즈드는, 인간을 통째로 악마로 만들기 위한 기술이야/데빌 소스를 듬뿍 주입해서 말이지"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "일반적인 악마 합체로도 충분하지 않냐고 생각하는 사람도 있겠지만/악마에게 의식을 빼앗기지 않는다는 건 커다란 이점이야/악마 자체를 쓰진 않으니까, 당연하겠지"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "물론 문제도 있어/인간 전용 장비는 쓸 수 없게 되고, 내성도 악마의 것으로 바뀌거든/주입하는 데빌 소스로 어느 정도 조절할 수는 있지만 말야"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "그리고 인간을 위한 특수 기능은 대부분 쓸 수 없게 돼/예를 들어 악마 변신 능력자의 경우 변신 능력을 잃어버린다든가/"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "그리고 물론, 데모나이즈드된 누군가는 인간이 아니게 돼/그 아이의 인간으로서의 영혼은 끝나버려서, 몇 번 환생하든 악마 그대로지"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "그래도, 누군가를 데모나이즈드할 거니？"
		ダンジョンフラグ:31:9 = 1
	ELSE
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "알고 있겠지만/정말로 데모나이즈드한다면, 그 아이는 인간이 아니게 된단다"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "그래도 괜찮은 거니？"
	ENDIF
	CALL INPUT_YN_D , "상관없다" , "역시 그만둔다"
	IF RESULT == 1
		GOTO P_31
	ENDIF
	$P_31_3
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "그래/그럼 누구를 데모나이즈드할 거니？"
	CALLFORM PETIT_DEMON_TARGET_COUNT, 2
	LOCAL = RESULT
	IF LOCAL == 0
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "어머, 데모나이즈드해 줄 수 있는 애가 없네/말할 것도 없지만, 그래선 데모나이즈드는 할 수 없단다"
		GOTO P_31
	ENDIF
	CALLFORM PETIT_DEMON_TARGET, 2
	IF RESULT == 0
		GOTO P_31
	ELSE
		CHARA = POS(RESULT)
	ENDIF
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", CALLNAME:CHARA + "에게 데모나이즈드를 할 거니？"
	CALL INPUT_YN_D , "데모나이즈드 시킨다" , "그만둔다"
	SIF RESULT == 1
		GOTO P_31_3
	$P_31_4
	
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "그래, 정말로 할 거구나/그럼 주입할 데빌 소스를 골라주렴/여러 가지가 있으니, 천천히 고민해 봐？"
	BF_FLAG = 0
	;なお、この項目の台詞たちは原作と口上と妄想を元に構築されています
	;なので、原作と異なる口調の可能性があります
	CALLFORM PETIT_DEMON_SELECT, 2
	IF RESULT == 0
		GOTO P_31_3
	ELSE
		LOCAL = 0
		LOCAL = RESULT
		SIF LOCAL == 3114 && TALENT:CHARA:유아체형 == 1
			BF_FLAG = 99
	ENDIF
	
	CALLFORM DEMONIEZD_TYPE_{LOCAL}, "해설", CHARA
	CALLFORM DEMONIEZD_TYPE_{LOCAL}, "確認", CHARA
	CALLFORM DEMONIEZD_TYPE_{LOCAL}, "価格", CHARA
	IF MONEY:1 < RESULT
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "…앗, 마카가 부족하잖아/그래선 데모나이즈드를 해줄 수 없단다"
		GOTO P_31
	ENDIF
	CALL INPUT_YN_D , "예" , "아니오"
	SIF RESULT == 1
		GOTO P_31_4
	CALLFORM DEMONIEZD_TYPE_{LOCAL}, "価格", CHARA
	MONEY:1 -= RESULT
	CALLFORM DEMONIEZD_TYPE_{LOCAL}, "デモナイズ実行", CHARA	

	CALL REMOVE_LINK_DEVIL, CHARA
	;デモナイズ対象がペルソナ使いなら
	IF TALENT:CHARA:페르소나구사자
		;ペルソナ共通枠からデモナイズ対象の持ってるペルソナを探してくる
		FOR サーチ変数, 1, 11
			SIF DITEMTYPE:(サーチ変数):0 == 0
				CONTINUE
			LOCAL:1 = FINDCHARA_ID(DITEMTYPE:サーチ変数:페르소나("ペルソナ所持者"))
			SIF CHARA == LOCAL:1
				CALL PERSONA_UNEQUIPMENT(LOCAL:1, サーチ変数)
		NEXT
		;ペルソナ剥ぎ終わったらスキル初期化
		ABL:CHARA:스킬1 = 0
		ABL:CHARA:스킬2 = 0
		ABL:CHARA:스킬3 = 0
		ABL:CHARA:스킬4 = 0
		ABL:CHARA:스킬5 = 0
		ABL:CHARA:스킬6 = 0
		ABL:CHARA:스킬7 = 0
		ABL:CHARA:스킬8 = 0
		ABL:CHARA:스킬9 = 0
	ENDIF
	;TALENT:CHARA:페르소나구사자 = 0
	;TALENT:CHARA:데빌시프터 = 0
	;TALENT:CHARA:식노 = 0
	;TALENT:CHARA:아웃사이더 = 0
	;TALENT:CHARA:악마빙의자 = 0
	;あなた以外はサマナーも削除
	;SIF NO:MASTER != NO:CHARA
	;	TALENT:CHARA:서머너 = 0
	;技能も削除
	TALENT:CHARA:도술 = 0
	TALENT:CHARA:팬서 = 0
	TALENT:CHARA:궁술 = 0
	TALENT:CHARA:검술 = 0
	TALENT:CHARA:창술 = 0
	TALENT:CHARA:도끼술 = 0
	TALENT:CHARA:채찍술 = 0
	TALENT:CHARA:투척술 = 0
	TALENT:CHARA:제사 = 0
	TALENT:CHARA:봉술 = 0
	TALENT:CHARA:마샬아츠 = 0
	;ついでに異能者なかったら異能者持たせる(元人間なところを手数の多さ(スキル枠)で表現)
	;SIF TALENT:CHARA:이능자 == 0 && TALENT:CHARA:달인 == 0
	;	TALENT:CHARA:이능자 = 1
	;装備を全解除
	CALL 全装備解除(CHARA)
	;生得武器のみ残る可能性があるのでここで念入りに殺す
	EQUIP:CHARA:검 = 0

	;ロール変更処理
	CALL CHANGE_ROLE, CHARA, "데모노이드_1", ""

	;ロール関係の素質を処理する
	;CALL CLEAR_ROLE_TALENT, CHARA
	;素質の変化による影響を反映
	;CALL SYNC_STATUS, CHARA
	;CUSTOMDRAWLINE =
	;CALL ROLE_EXPLAIN_ABILITY, CHARA, , ,"メイン"
	;サブ素質を設定
	;CALL ENHANCE_ROLE, CHARA, , L_BTL_TALENT, , "戻る不可"

	;ロール変更の結果、使えなくなったスキルを削除する
	;CALL EXCLUDE_UNABLE_SKILL, CHARA
	;素質・スキルの変化による影響を反映
	;CALL SYNC_STATUS, CHARA

	;実行時口上
	IF LOCAL == 3114
		CALLFORM DEMONIEZD_SET_{LOCAL}, CHARA, BF_FLAG
	ELSE
		CALLFORM DEMONIEZD_SET_{LOCAL}, CHARA
	ENDIF
	
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"새로운 몸은 마음에 드니？"
	GOTO P_31
ELSEIF RESULT == 3
	;ここから捏造。デモナイズドしたキャラを魔貨払って耐性を強化する
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "강화 데모나이즈드, 할 거니？"
	IF ダンジョンフラグ:31:9 == 1
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞그 말을 듣자마자, 점주의 눈빛이 날카로워졌다"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "…………미리 말해두겠지만, 이건 본래 금지된 기술이야"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "과거에 복수의 서로 다른 데빌 소스로 데모나이즈드를 거듭해/더욱 강력한 악마를 인공적으로 만들려던 프로젝트가 있었단다…"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "악마 자체를 쓰지 않으니 폭주할 위험성은 비교적 낮았지만/확실성도 전혀 없고 비용도 만만치 않았지/덤으로 버텨낼 수 있는 실험체 확보도 못 했고 말야…"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "결론적으로 그 프로젝트는 실패해서 무기한 동결되었어…/하지만 그 연구 성과의 일부는… 뭐, 이 이야기는 여기까지 해둘까"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "뭐 간단히 말하면 데빌 소스를 이런저런 처리해서/데모나이즈드된 악마를 강화해 주겠다는 이야기야！"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "어드밴스 데모나이즈드/줄여서 「ADD」야/그래서, 누구를 ADD할 거니？"
		ダンジョンフラグ:31:9 = 2
	ELSE
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "알고 있겠지만/이건 뒷세계에서도 극비란다？"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "그래서, ADD할 거니？"
	ENDIF
	CALL INPUT_YN_D , "예" , "그만둔다"
	IF RESULT == 1
		GOTO P_31
	ENDIF
	$P_31_5
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "그래/그럼 누구를 ADD할 거니？"
	CALLFORM PETIT_DEMON_TARGET_COUNT, 3
	LOCAL = RESULT
	IF LOCAL == 0
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "어머, ADD해 줄 수 있는 애가 없네/말할 것도 없지만, 그래선 ADD는 할 수 없단다"
		GOTO P_31
	ENDIF
	CALLFORM PETIT_DEMON_TARGET, 3
	IF RESULT == 0
		GOTO P_31
	ELSE
		CHARA = POS(RESULT)
	ENDIF
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", CALLNAME:CHARA + "에게 ADD를 할 거니？"
	CALL INPUT_YN_D , "ADD시킨다" , "그만둔다"
	SIF RESULT == 1
		GOTO P_31_5
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "그래, 정말로 할 거구나"
	$P_31_6
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "그럼 주입할 데빌 소스를 골라주렴/참고로 이것들 외의 데빌 소스는 안전을 보장할 수 없단다"
	CALLFORM PETIT_DEMON_SELECT, 3
	IF RESULT == 0
		GOTO P_31_5
	ELSE
		LOCAL = 0
		LOCAL = RESULT
	ENDIF
	CALLFORM ADVANCE_DEMONIEZD_TYPE_{LOCAL}, "해설", CHARA
	CALLFORM ADVANCE_DEMONIEZD_TYPE_{LOCAL}, "チェック", CHARA
	IF RESULT == 0
		GOTO P_31_6
	ENDIF
	;ストレスが溜まってたら除外する
	IF CFLAG:CHARA:스트레스치 > 60
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "…앗, " + CALLNAME:CHARA + "에게 한계가 온 모양이네/오늘은 이제 그만두렴"
		GOTO P_31_5
	ENDIF
	CALLFORM ADVANCE_DEMONIEZD_TYPE_{LOCAL}, "確認", CHARA
	CALLFORM ADVANCE_DEMONIEZD_TYPE_{LOCAL}, "価格", CHARA
	IF MONEY:1 < RESULT
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "…앗, 마카가 부족하잖아/그래선 ADD를 해줄 수 없단다"
		GOTO P_31
	ENDIF
	CALL INPUT_YN_D , "예" , "아니오"
	SIF RESULT == 1
		GOTO P_31_5
	CALLFORM ADVANCE_DEMONIEZD_TYPE_{LOCAL}, "価格", CHARA
	MONEY:1 -= RESULT
	CALLFORM ADVANCE_DEMONIEZD_TYPE_{LOCAL}, "アドバンスド実行", CHARA

	;共通処理
	;一日でそう何度も強化できないようにするため、ストレス値を加算
	CFLAG:CHARA:스트레스치 += 30

	;口上…は面倒なので全部一括
	IF NO:MASTER == NO:CHARA
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 이쪽으로 와주겠니？"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 안내받아 옷을 벗은 " + CALLNAME:MASTER + "는 작은 캡슐에 들어갔다…"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
		CALL SHOW_PICTURE, "EMPTY"
		IF TALENT:CHARA:광기 == 0
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자, 점주가 말을 걸어왔다…"
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"응, 잘 끝났어/나중에 애널라이즈해서 강화되었는지 확인해 보렴？"
		ELSEIF TALENT:CHARA:붕괴 == 1
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자, 시야의 모든 것이 고깃덩어리로 보인다…"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "남 점주？", @"유감이지만, 실패야…/날 원망하진 마렴？"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞어딘가 점주의 모습이 엿보이는 고깃덩어리가 말을 걸어오는 것 같지만/＞이제 당신에겐 아무래도 좋은 일로밖에 느껴지지 않았다…"
		ELSEIF TALENT:CHARA:이형 == 1
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자, 점주가 말을 걸어왔다…"
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"간신히 성공했네…/하지만 이 이상은 그만두렴"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞어째선지 똑바로 서서 걷는 것조차 힘들다…/＞온몸의 부품이 누더기로 이어붙여져 제대로 균형을 잡을 수 없다"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자, 점주가 말을 걸어왔다…"
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"간신히 성공했네…/하지만 이 이상은 그만두렴"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞몸 상태는 좋지만/어째선지 끊임없이 누군가에게 응시당하고 있는 느낌이 든다…"
		ENDIF
	ELSE
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"알겠어/그럼 넌 여기서 기다리고 있으렴？"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
		CALL SHOW_PICTURE, "EMPTY"
		IF TALENT:CHARA:광기 == 0
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"네, 완료됐단다/" + CALLNAME:CHARA + "를 애널라이즈해서 강화되었는지 확인해 보렴？"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 이끌려, " + CALLNAME:CHARA + "가 돌아왔다"
		ELSEIF TALENT:CHARA:붕괴 == 1
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"유감이지만, " + CALLNAME:CHARA + "는 견뎌내지 못했어…/이젠 살아있는 게 기적인 수준이란다"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 이끌려, " + CALLNAME:CHARA + "가 돌아왔지만/＞차라리 죽게 내버려두는 편이 나았을지도 모른다…"
		ELSEIF TALENT:CHARA:이형 == 1
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"간신히 성공했네…/하지만 " + CALLNAME:CHARA + "를 생각한다면, 이 이상은 그만두렴"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 이끌려, " + CALLNAME:CHARA + "가 돌아왔지만/＞이젠 인간이었을 때의 흔적은 어디에도 찾아볼 수 없다…"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"간신히 성공했네…/하지만 " + CALLNAME:CHARA + "를 생각한다면, 이 이상은 그만두렴"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 이끌려, " + CALLNAME:CHARA + "가 돌아왔다/＞아무도 없는 허공을 향해 무언가를 이야기하고 있다…/＞정신 쪽은 이미 한계에 다다른 것 같다"
		ENDIF
	ENDIF
ELSE
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "또 오렴, 기다리고 있을게！"
	CALL DUNGEON_WORP,1,42,10
	RETURN 1
ENDIF
GOTO P_31

;=======================================================================
;プチデモ内部処理
;=======================================================================
;プチデモ対象が存在するか
@PETIT_DEMON_TARGET_COUNT, ARG
#DIM TARGET_COUNT, 1
TARGET_COUNT = 0
FOR LOCAL,1,7
	IF ARG == 2
		;デモナイズド
		IF POS(LOCAL) > -1 && ABL:POS(LOCAL):종족 == 0  && (TALENT:POS(LOCAL):3 || TALENT:POS(LOCAL):4 || TALENT:POS(LOCAL):5 || TALENT:POS(LOCAL):6 || TALENT:POS(LOCAL):7 || TALENT:POS(LOCAL):8 || NO:POS(LOCAL) == NO:MASTER)
			TARGET_COUNT += 1
		ENDIF
	ELSEIF ARG == 3
		;強化デモナイズド(悪魔人限定)
		;IF POS(LOCAL) > -1 && ABL:POS(LOCAL):종족 == 73  && (TALENT:POS(LOCAL):3 || TALENT:POS(LOCAL):4 || TALENT:POS(LOCAL):5 || TALENT:POS(LOCAL):6 || TALENT:POS(LOCAL):7 || TALENT:POS(LOCAL):8 || NO:POS(LOCAL) == NO:MASTER)
		IF POS(LOCAL) > -1 && CSTR:POS(LOCAL):롤 == "데모노이드" && 陥落(POS(LOCAL))
			TARGET_COUNT += 1
		ENDIF
	ELSE
		;プチデモ
		IF POS(LOCAL) > -1 && ABL:POS(LOCAL):종족 == 0 && LOCAL:2 != 2
			TARGET_COUNT += 1
		ENDIF
	ENDIF
NEXT
RETURN TARGET_COUNT

;プチデモ対象選択
@PETIT_DEMON_TARGET, ARG
#DIMS VALUES

$TAGET_LOOP

VALUES = ＞누구로 할까？//
FOR LOCAL,1,7
	IF ARG == 2
		;デモナイズド
		IF POS(LOCAL) > -1 && ABL:POS(LOCAL):종족 == 0 && (TALENT:POS(LOCAL):3 || TALENT:POS(LOCAL):4 || TALENT:POS(LOCAL):5 || TALENT:POS(LOCAL):6 || TALENT:POS(LOCAL):7 || TALENT:POS(LOCAL):8 || NO:POS(LOCAL) == NO:MASTER)
			VALUES += "[" + TOSTR(LOCAL) + "]" + CALLNAME:(POS(LOCAL)) + "/"
		ENDIF
	ELSEIF ARG == 3
		;強化デモナイズド(悪魔人限定)
		;IF POS(LOCAL) > -1 && ABL:POS(LOCAL):종족 == 73  && (TALENT:POS(LOCAL):3 || TALENT:POS(LOCAL):4 || TALENT:POS(LOCAL):5 || TALENT:POS(LOCAL):6 || TALENT:POS(LOCAL):7 || TALENT:POS(LOCAL):8 || NO:POS(LOCAL) == NO:MASTER)
		IF POS(LOCAL) > -1 && CSTR:POS(LOCAL):롤 == "데모노이드" && 陥落(POS(LOCAL))
			VALUES += "[" + TOSTR(LOCAL) + "]" + CALLNAME:(POS(LOCAL)) + "/"
		ENDIF
	ELSE
		;プチデモ
		IF POS(LOCAL) > -1 && ABL:POS(LOCAL):종족 == 0 && LOCAL:2 != 2
			VALUES += "[" + TOSTR(LOCAL) + "]" + CALLNAME:(POS(LOCAL)) + "/"
		ENDIF
	ENDIF
NEXT

VALUES += "/[9]그만둔다"
CALL INPUT_SELECT_D , VALUES , , , 2
SELECTCASE RESULT
	CASE 9
		RETURN 0
	CASEELSE
		RETURN RESULT
ENDSELECT

;プチデモ内容選択
@PETIT_DEMON_SELECT, ARG
#DIMS VALUES
$INPUT_LOOP
IF ARG == 2
	;デモナイズド
	VALUES = [1]엔젤/
	VALUES += "[2]네코마타/"
	VALUES += "[3]이나바의 흰토끼/"
	VALUES += "[4]픽시/"
	VALUES += "[5]머메이드/"
	VALUES += "[6]하피/"
	VALUES += "[7]좀비/"
	VALUES += "[8]뱀파이어/"
	VALUES += "[9]보디코니안/"
	VALUES += "[10]서큐버스/"
	VALUES += "[11]도리 카드몬/"
	VALUES += "/[0]그만둔다"
	CALL INPUT_SELECT_D , VALUES, , , 3
	SELECTCASE RESULT
		CASE 0
			RETURN 0
		CASE 1
			RETURN 3111
		CASE 2
			RETURN 3112
		CASE 3
			RETURN 3113
		CASE 4
			RETURN 3114
		CASE 5
			RETURN 3115
		CASE 6
			RETURN 3116
		CASE 7
			RETURN 3117
		CASE 8
			RETURN 3118
		CASE 9
			RETURN 3119
		CASE 10
			RETURN 3120
		CASE 11
			RETURN 3121
	ENDSELECT
ELSEIF ARG == 3
	;強化デモナイズド
	;比較的マイルドな奴
	VALUES = [1]유귀 소스　　주살신경+25 +[감정결핍]/
	VALUES += "[2]비구니 소스　빙결수격+25 +[무관심]/"
	VALUES += "[3]염마 소스　　화염핵열+25 +[젖기어려움]/"
	VALUES += "[4]천사 소스　　파마정신+25 +[악취민감]/"
	VALUES += "[5]사귀 소스　　타격전술+25 +[반항적,프라이드높음]/"
	VALUES += "[6]흉조 소스　　충격질풍+25 +[부끄럼없음,습득느림]/"
	VALUES += "[7]영걸 소스　　검격비구+25 +[일선을넘지않음]/"
	VALUES += "[8]전령 소스　　전격　　+25 +[회복느림]/"
	VALUES += "[9]지령 소스　　지변중력+25 +[자제심,남성혐오or여성혐오]/"
	VALUES += "[10]더 끝내주는 녀석은 없어？/"
	VALUES += "[0]그만둔다"
	CALL INPUT_SELECT_D , VALUES, , , 1
	SELECTCASE RESULT
		CASE 0
			RETURN 0
		CASE 1
			RETURN 3131
		CASE 2
			RETURN 3132
		CASE 3
			RETURN 3133
		CASE 4
			RETURN 3134
		CASE 5
			RETURN 3135
		CASE 6
			RETURN 3136
		CASE 7
			RETURN 3137
		CASE 8
			RETURN 3138
		CASE 9
			RETURN 3139
		CASE 10
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"……정말로 괜찮은 거지？/무슨 일이 생겨도 난 책임 안 진다？"
			ARG = 4
			GOTO INPUT_LOOP
		CASEELSE
			GOTO INPUT_LOOP
	ENDSELECT
ELSEIF ARG == 4
	;強化デモナイズド
	;ハードな奴
	VALUES = [1]광신 소스　　정신신경전격+50/
	VALUES += "[2]수라 소스　　주살빙결지변+50/"
	VALUES += "[3]명왕 소스　　파마화염충격+50/"
	VALUES += "[4]파괴신 소스　검격타격전술+50/"
	VALUES += "[5]용신 소스　　핵열질풍중력+50/"
	VALUES += "[6]명령 소스　　수격비구+50/"
	VALUES += "[0]그만둔다"
	CALL INPUT_SELECT_D , VALUES, , , 1
	SELECTCASE RESULT
		CASE 0
			RETURN 0
		CASE 1
			RETURN 3141
		CASE 2
			RETURN 3142
		CASE 3
			RETURN 3143
		CASE 4
			RETURN 3144
		CASE 5
			RETURN 3145
		CASE 6
			RETURN 3146
		CASEELSE
			GOTO INPUT_LOOP
	ENDSELECT
ELSE
	;プチデモ
	VALUES = [1]동물의 귀를 단다/
	VALUES += "[2]꼬리를 기른다/"
	VALUES += "[3]날개를 기른다/"
	VALUES += "[4]인어로 만든다/"
	VALUES += "[5]소인으로 만든다/"
	VALUES += "/"
	VALUES += "/[0]그만둔다"
	CALL INPUT_SELECT_D , VALUES, , , 2
	SELECTCASE RESULT
		CASE 0
			RETURN 0
		CASE 1
			RETURN 3101
		CASE 2
			RETURN 3102
		CASE 3
			RETURN 3103
		CASE 4
			RETURN 3104
		CASE 5
			RETURN 3105
	ENDSELECT
ENDIF

