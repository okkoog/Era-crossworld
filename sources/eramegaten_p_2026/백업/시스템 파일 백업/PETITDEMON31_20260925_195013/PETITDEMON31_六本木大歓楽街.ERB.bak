					IF TALENT:ARG:여우
						CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 여우면 꼬리도 여우/＞이제 " + CALLNAME:ARG + "는 영락없는 여우 소녀다…"
						CSTR:ARG:20 = 여우 소녀
					ENDIF
					TALENT:ARG:여우 = 1
				CASE 4
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞늘씬한 몸에 소 같은 귀와 뿔/＞아무리 그래도 소 흉내를 내게 하기엔 가슴이 좀 작은가…"
					IF CSTR:ARG:상성그룹 == "牛"
						CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 소면 꼬리도 소/＞이제 " + CALLNAME:ARG + "는 영락없는 소 소녀다…"
						CSTR:ARG:타이틀 = 소 소녀
					ENDIF
					CSTR:ARG:상성그룹 = 牛
				CASE 5
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞늘씬한 몸에 토끼 같은 귀/＞" + CALLNAME:ARG + "의 매끄러운 육체 덕분인지, 아주 잘 뛰어오를 수 있을 것 같다"
					IF CSTR:ARG:상성그룹 == "兎"
						CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 토끼면 꼬리도 토끼/＞이제 " + CALLNAME:ARG + "는 영락없는 토끼 소녀다…"
						CSTR:ARG:타이틀 = 토끼 소녀
					ENDIF
					CSTR:ARG:상성그룹 = 兎
			ENDSELECT
		ENDIF
	ENDIF
ENDIF

;動物尾
@PETIT_DEMON_SET_3102, ARG

CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 어떤 동물의 꼬리로 할 거니？"
CALL INPUT_SELECT_D , "어떤 꼬리로 할래？//[1]개/[2]고양이/[3]여우/[4]소/[5]토끼" , , , 2
B = RESULT
SELECTCASE B
	CASE 1
		CSTR:ARG:48 = 현재는 쁘띠 데모로 인해 엉덩이에 개의 꼬리가 달려 있다.
	CASE 2
		CSTR:ARG:48 = 현재는 쁘띠 데모로 인해 엉덩이에 고양이의 꼬리가 달려 있다.
	CASE 3
		CSTR:ARG:48 = 현재는 쁘띠 데모로 인해 엉덩이에 여우의 꼬리가 달려 있다.
	CASE 4
		CSTR:ARG:48 = 현재는 쁘띠 데모로 인해 엉덩이에 소의 꼬리가 달려 있다.
	CASE 5
		CSTR:ARG:48 = 현재는 쁘띠 데모로 인해 엉덩이에 토끼의 꼬리가 달려 있다.
ENDSELECT
TALENT:ARG:꼬리 = 1
IF NO:MASTER == NO:ARG
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 이쪽으로 와주겠니？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 안내받아, " + CALLNAME:MASTER + "는 작은 캡슐에 들어갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼 시작할게/조금만 기다려, 금방 끝나니까"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "의 의식은 아득해져 갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자, 점주가 말을 걸어왔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"응, 잘 끝났어/지금 네 모습, 정말 쿨하단다！/거울로 완성된 모습을 체크해 보렴！"
	IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
		SELECTCASE B
			CASE 1
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그 말을 듣고 들여다본 거울에는, /＞건장한 몸에 개 같은 꼬리를 지닌 남자가 비치고 있었다/＞자신도 흥분한 탓인지, 그 꼬리는 꼿꼿이 서 있었다…"
				IF CSTR:ARG:상성그룹 == "犬"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 개면 꼬리도 개/＞이제 " + CALLNAME:ARG + "는 영락없는 개 인간이다…"
					CSTR:ARG:타이틀 = 개 인간
				ENDIF
				CSTR:ARG:상성그룹 = 犬
			CASE 2
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그 말을 듣고 들여다본 거울에는, /＞건장한 몸에 고양이 같은 꼬리를 지닌 남자가 비치고 있었다/＞잘만 움직이면 팔 대신으로 쓸 수 있을지도 모르겠다…"
				IF CSTR:ARG:상성그룹 == "猫"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 고양이면 꼬리도 고양이/＞이제 " + CALLNAME:ARG + "는 영락없는 고양이 인간이다…"
					CSTR:ARG:타이틀 = 고양이 인간
				ENDIF
				CSTR:ARG:상성그룹 = 猫
			CASE 3
				IF RAND:9 == 0
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그 말을 듣고 들여다본 거울에는, /＞건장한 몸에 여우 같은 꼬리를 지닌 남자가 비치고 있었다/＞…하지만 개수가 많아 9개나 있다…/＞이만큼 많으면 일상생활도 꽤나 힘들겠지"
					CSTR:ARG:48 = 현재는 쁘띠 데모로 인해 엉덩이에 여우의 꼬리가 9개 달려 있다.
					IF TALENT:ARG:여우 == 1
						CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 여우면 꼬리는 구미/＞이제 " + CALLNAME:ARG + "는 영락없는 구미 인간이다…"
						CSTR:ARG:타이틀 = 구미 인간
					ENDIF
				ELSE
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그 말을 듣고 들여다본 거울에는, /＞건장한 몸에 여우 같은 꼬리를 지닌 남자가 비치고 있었다/＞…눈꼬리도 살짝 올라간 것 같기도？"
					IF TALENT:ARG:여우 == 1
						CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 여우면 꼬리도 여우/＞이제 " + CALLNAME:ARG + "는 영락없는 여우 인간이다…"
						CSTR:ARG:타이틀 = 여우 인간
					ENDIF
				ENDIF
				TALENT:ARG:여우 = 1
			CASE 4
