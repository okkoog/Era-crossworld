		MAXBASE:ARG:화염 = 75
		MAXBASE:ARG:빙결 = 100
		MAXBASE:ARG:전격 = 100
		MAXBASE:ARG:충격 = 75
		MAXBASE:ARG:신경 = 0
		MAXBASE:ARG:정신 = 0
		MAXBASE:ARG:파마 = 0
		MAXBASE:ARG:주살 = 0
		MAXBASE:ARG:지변 = 100
		MAXBASE:ARG:수격 = 75
		MAXBASE:ARG:질풍 = 100
		MAXBASE:ARG:중력 = 100
		MAXBASE:ARG:핵열 = 75
		MAXBASE:ARG:만능 = 100
		MAXBASE:ARG:사이코 = 100
