;
@PETIT_DEMON_SET_3103, ARG

CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 어떤 날개로 할 거니？"
CALL INPUT_SELECT_D , "어떤 날개로 할래？//[1]천사/[2]타천사/[3]박쥐/[4]맹금" , , , 2
B = RESULT
SELECTCASE B
	CASE 1
		CSTR:ARG:47 = 현재는 쁘띠 데모로 인해 등에 하얀 천사의 날개가 돋아나 있다.
	CASE 2
		CSTR:ARG:47 = 현재는 쁘띠 데모로 인해 등에 검은 타천사의 날개가 돋아나 있다.
	CASE 3
		CSTR:ARG:47 = 현재는 쁘띠 데모로 인해 등에 박쥐의 날개가 돋아나 있다.
	CASE 4
		CSTR:ARG:47 = 현재는 쁘띠 데모로 인해 등에 맹금의 날개가 돋아나 있다.
ENDSELECT
TALENT:ARG:날개 = 1
IF NO:MASTER == NO:ARG
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 이쪽으로 와주겠니？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 안내받아, " + CALLNAME:MASTER + "는 작은 캡슐에 들어갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼 시작할게/조금만 기다려, 금방 끝나니까"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "의 의식은 아득해져 갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
