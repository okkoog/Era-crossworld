			MAXBASE:ARG:화염 -= 25
			BASE:ARG:화염 -= 25
			IF MAXBASE:ARG:화염 < 0
				MAXBASE:ARG:화염 = 0
				BASE:ARG:화염 = 0
			ENDIF
		ENDIF
		IF MAXBASE:ARG:핵열 > 0
			MAXBASE:ARG:핵열 -= 10
			BASE:ARG:핵열 -= 10
			IF MAXBASE:ARG:핵열 < 0
				MAXBASE:ARG:핵열 = 0
				BASE:ARG:핵열 = 0
			ENDIF
		ENDIF
		TALENT:ARG:젖기어려움 = 1
		TALENT:ARG:젖기쉬움 = 0
ENDSELECT

;天使ソース
@ADVANCE_DEMONIEZD_TYPE_3134, ARGS, ARG
#LOCALSSIZE 1
#DIM 価格計算, 1

CALLFORM ADVANCE_DEMONIEZD_MILD_MONEY, ARG, "파마", "정신"
価格計算 = RESULT

SELECTCASE ARGS
	CASE "アドバンスドタイプ"
		RESULTS = 천사
	CASE "해설"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "천사 소스를 추가하려는 거지？/그렇다면 파마와 정신에 강해진단다"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "부작용으로 결벽증 기운이 생긴단다"
	CASE "チェック"
		IF TALENT:ARG:악취민감 == 1
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "어머, 이 애는 이미 결벽증인 것 같네/이 이상은 위험하니 그만두렴"
			RETURN 0
		ENDIF
		RETURN 1
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "상성상 " + TOSTR(価格計算) + "마카가 들지만/정말로 "+ CALLNAME:ARG + " 쨩에게 천사 소스를 주입해도 괜찮겠니？"
	CASE "価格"
		RETURN 価格計算
	CASE "アドバンスド実行"
		CSTR:ARG:종족명 = 천사
		IF MAXBASE:ARG:파마 > 0
			MAXBASE:ARG:파마 -= 25
