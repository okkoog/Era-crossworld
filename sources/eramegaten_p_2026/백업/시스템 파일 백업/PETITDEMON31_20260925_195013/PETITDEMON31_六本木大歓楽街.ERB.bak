		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "가능한 한 성공률을 올릴 수 있도록 노력은 하겠지만/그래도 " + TOSTR(価格計算) + "마카는 필요하단다/정말로 "+ CALLNAME:ARG + " 쨩에게 명왕 소스를 주입해도 괜찮겠니？"
	CASE "価格"
		RETURN 価格計算
	CASE "アドバンスド実行"
		;ハード強化共通処理
		CALLFORM ADVANCE_DEMONIEZD_HARD, ARG
		SIF RESULT == 0
			RETURN
		
		CSTR:ARG:종족명 = 명왕
		IF MAXBASE:ARG:파마 > 0
			MAXBASE:ARG:파마 -= 50
			BASE:ARG:파마 -= 50
			IF MAXBASE:ARG:파마 < 0
				MAXBASE:ARG:파마 = 0
				BASE:ARG:파마 = 0
			ENDIF
		ENDIF
		IF MAXBASE:ARG:화염 > 0
			MAXBASE:ARG:화염 -= 50
			BASE:ARG:화염 -= 50
			IF MAXBASE:ARG:화염 < 0
				MAXBASE:ARG:화염 = 0
				BASE:ARG:화염 = 0
			ENDIF
		ENDIF
		IF MAXBASE:ARG:충격 > 0
			MAXBASE:ARG:충격 -= 50
			BASE:ARG:충격 -= 50
			IF MAXBASE:ARG:충격 < 0
				MAXBASE:ARG:충격 = 0
				BASE:ARG:충격 = 0
			ENDIF
		ENDIF
ENDSELECT

