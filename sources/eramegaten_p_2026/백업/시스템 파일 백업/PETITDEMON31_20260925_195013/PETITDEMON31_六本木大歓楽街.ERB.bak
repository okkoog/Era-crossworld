	CASE "해설"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "이나바의 흰토끼를 주입하는 거구나？/그렇다면, " + CALLNAME:ARG + "의 귀가 토끼 귀가 되고 토끼 꼬리도 자라난단다"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "빙결과 신경은 안 통하게 되고 파마와 주살에 강해지지만/검격과 화염에 약해진단다"
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "６０００마카가 드는데/정말로, "+ CALLNAME:ARG + "에게 이나바의 흰토끼를 주입해도 괜찮겠니？"
