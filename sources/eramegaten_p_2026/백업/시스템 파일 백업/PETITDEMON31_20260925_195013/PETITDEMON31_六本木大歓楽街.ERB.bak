@DEMONIEZD_TYPE_3121, ARGS, ARG
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "デモナイズドタイプ"
		RESULTS = 도리 카드몬
	CASE "해설"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "도리 카드몬을 주입하는 거구나？/그렇다면 개인차도 있겠지만 " + CALLNAME:ARG + "에게 약간 무기질적인 인상이 더해지는 정도라서/외형적인 차이는 거의 나타나지 않는 경우가 많단다"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "육체의 변화에 따른 정신적 영향도 크단다/대체로 감정이 결핍되어 무심한 아이가 된다나 봐/요컨대 반쯤 조마에 가까워지는 인상이지"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "신경·정신·주살·파마의 효과를 안 받게 된단다/그 외에도 몇 가지 속성에 대해 약간의 내성이 생기는 것 같아/압도적이진 않지만, 약점이 없는 게 최대 강점이지"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "즉, 인간을 조마로 만드는 것과 같아/도리 카드몬으로 되돌릴 수는 없고, 실제로는 이런저런 차이점도 있지만 말야"
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "처치 비용과 도리 카드몬 비용으로 １０５００마카가 드는데/정말로, "+ CALLNAME:ARG + "에게 도리 카드몬을 주입해도 괜찮겠니？"
