		CSTR:ARG:종족명 = 지령
		IF MAXBASE:ARG:지변 > 0
			MAXBASE:ARG:지변 -= 25
			BASE:ARG:지변 -= 25
			IF MAXBASE:ARG:지변 < 0
				MAXBASE:ARG:지변 = 0
				BASE:ARG:지변 = 0
			ENDIF
		ENDIF
		IF MAXBASE:ARG:중력 > 0
			MAXBASE:ARG:중력 -= 25
			BASE:ARG:중력 -= 25
			IF MAXBASE:ARG:중력 < 0
				MAXBASE:ARG:중력 = 0
				BASE:ARG:중력 = 0
			ENDIF
		ENDIF
		TALENT:ARG:자제심 = 1
		IF TALENT:ARG:남자 == 0
			TALENT:ARG:남성혐오 = 1
