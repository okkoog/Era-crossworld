;------------------------------
;デモナイズドタイプ
;------------------------------

;エンジェル
@DEMONIEZD_TYPE_3111, ARGS, ARG
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "デモナイズドタイプ"
		RESULTS = 엔젤
	CASE "해설"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "엔젤을 주입하는 거구나？/그렇다면, " + CALLNAME:ARG + "의 등에 하얀 날개가 돋아나겠네"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "검격과 타격에 강해지지만/비구와 충격과 중력, 그리고 주살에 약해진단다"
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "４０００마카가 드는데/정말로, "+ CALLNAME:ARG + "에게 엔젤을 주입해도 괜찮겠니？"
	CASE "価格"
		RETURN 4000
	CASE "デモナイズ実行"
		CSTR:ARG:49 = 데모나이즈드로 인해 엔젤(봉인지정)이 주입되어, 등에서 순백의 날개가 돋아난 금발의 천사가 되어 있다.
		ABL:ARG:종족 = 73
		CSTR:ARG:종족명 = 천사
		MAXBASE:ARG:검격 = 25
		MAXBASE:ARG:비구 = 125
		MAXBASE:ARG:타격 = 25
		MAXBASE:ARG:전술 = 100
		MAXBASE:ARG:화염 = 75
		MAXBASE:ARG:빙결 = 100
		MAXBASE:ARG:전격 = 75
		MAXBASE:ARG:충격 = 150
		MAXBASE:ARG:신경 = 50
		MAXBASE:ARG:정신 = 50
		MAXBASE:ARG:파마 = 0
		MAXBASE:ARG:주살 = 150
		MAXBASE:ARG:지변 = 75
		MAXBASE:ARG:수격 = 100
		MAXBASE:ARG:질풍 = 100
		MAXBASE:ARG:중력 = 125
		MAXBASE:ARG:핵열 = 75
		MAXBASE:ARG:만능 = 100
		MAXBASE:ARG:사이코 = 100
		BASE:ARG:검격 = 25
		BASE:ARG:비구 = 125
		BASE:ARG:타격 = 25
		BASE:ARG:전술 = 100
		BASE:ARG:화염 = 75
		BASE:ARG:빙결 = 100
		BASE:ARG:전격 = 75
		BASE:ARG:충격 = 150
		BASE:ARG:신경 = 50
		BASE:ARG:정신 = 50
		BASE:ARG:파마 = 0
		BASE:ARG:주살 = 150
		BASE:ARG:지변 = 75
		BASE:ARG:수격 = 100
		BASE:ARG:질풍 = 100
		BASE:ARG:중력 = 125
		BASE:ARG:핵열 = 75
		BASE:ARG:만능 = 100
		BASE:ARG:사이코 = 100
		CSTR:ARG:상성그룹 = ヘブライ天使
		;ランダムキャラの場合は合体可とする
		IF NO:ARG <= 4900 || NO:ARG >= 4913
			CFLAG:ARG:합체소재사용금지 = 1
		ENDIF
		TALENT:ARG:천사 = 1
		TALENT:ARG:날개 = 1
ENDSELECT

;ネコマタ
@DEMONIEZD_TYPE_3112, ARGS, ARG
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "デモナイズドタイプ"
		RESULTS = 네코마타
	CASE "해설"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "네코마타를 주입하는 거구나？/그렇다면, " + CALLNAME:ARG + "의 귀가 고양이 귀가 되겠네/그리고 고양이 꼬리가 두 갈래로 자라나고 갈퀴 발톱이 생기겠네"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "충격과 신경에 강해지지만/전격과 정신에 약해진단다"
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "３０００마카가 드는데/정말로, "+ CALLNAME:ARG + "에게 네코마타를 주입해도 괜찮겠니？"
	CASE "価格"
		RETURN 3000
	CASE "デモナイズ実行"
		CSTR:ARG:49 = 데모나이즈드로 인해 네코마타(희소종)가 주입되어, 고양이의 귀와 꼬리를 지니고 손발에 날카로운 발톱이 돋아난 마수가 되어 있다.
		ABL:ARG:종족 = 73
