		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "부작용으로 무관심해진단다"
	CASE "チェック"
		IF TALENT:ARG:무관심 == 1
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "어머, 이 애는 이미 무관심하네/이 이상은 정신이 망가질 가능성이 있으니 그만두렴"
			RETURN 0
		ENDIF
		RETURN 1
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "상성상 " + TOSTR(価格計算) + "마카가 들지만/정말로 "+ CALLNAME:ARG + " 쨩에게 비구니 소스를 주입해도 괜찮겠니？"
	CASE "価格"
		RETURN 価格計算
	CASE "アドバンスド実行"
