		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "부작용은 뭐 그리 보고되지 않았단다/하지만 실험체 간수들의 평판은 좋지 않았다는 기록이 있어"
	CASE "チェック"
		IF TALENT:ARG:젖기어려움 == 1
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "어머, 이 애와는 상성이 안 좋은 모양이네/이 이상은 위험하니 그만두렴"
			RETURN 0
		ENDIF
		RETURN 1
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "상성상 " + TOSTR(価格計算) + "마카가 들지만/정말로 "+ CALLNAME:ARG + " 쨩에게 염마 소스를 주입해도 괜찮겠니？"
	CASE "価格"
