;エンジェル
@DEMONIEZD_SET_3111, ARG
#LOCALSSIZE 1
IF NO:MASTER == NO:ARG
	CFLAG:MASTER:소속ＣＯＭＰ = -1
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 이쪽으로 와주겠니？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 안내받아 옷을 벗은 " + CALLNAME:MASTER + "는 작은 캡슐에 들어갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 시작할게/인간으로서의 삶에 작별을 고해두렴…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞등에 간질간질한 감촉을 맛보며/＞" + CALLNAME:MASTER + "의 의식은 아득해져 갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자, 점주가 말을 걸어왔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"응, 잘 됐어/이게 인간을 그만둔 지금 당신의 모습이야/거울로 완성된 모습을 체크해보렴"
	IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 금발의 늠름한 천사가 비치고 있었다/＞내 일이긴 하지만 아크엔젤이라고 하면 믿어버릴 것 같은 외모다"
	ELSEIF TALENT:MASTER:오토코노코 || TALENT:MASTER:후타나리
		IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 금발의 아름다운 천사가 비치고 있었다/＞드러난 풍만한 육체와 언밸런스한 육봉을 보고/＞" + CALLNAME:MASTER + "는 그것이 자기 자신이라는 것을 알면서도 무심코 발기해 버렸다…"
		ELSEIF TALENT:MASTER:빈유 || TALENT:MASTER:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 금발의 아름다운 천사가 비치고 있었다/＞평탄한 체형과 어우러져 차라리 큐피드를 연상시키는 모습이다"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 금발의 아름다운 천사가 비치고 있었다/＞여성적인 체형과 가랑이의 육봉이 한층 더 천사다움을 자아낸다/＞물론 그 내면은 천사와는 거리가 멀지만…"
		ENDIF
	ELSE
		IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 금발의 아름다운 천사가 비치고 있었다/＞드러난 풍만한 육체에 " + CALLNAME:MASTER + "는 무심코 얼굴을 붉혔다…"
		ELSEIF TALENT:MASTER:빈유 || TALENT:MASTER:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 금발의 아름다운 천사가 비치고 있었다/＞평탄한 체형과 어우러져 차라리 큐피드를 연상시키는 모습이다"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 금발의 아름다운 천사가 비치고 있었다/＞스스로 보기에도 균형 잡힌 몸매가 천사다움을 자아낸다/＞물론 그 내면은 천사와는 거리가 멀지만…"
		ENDIF
	ENDIF
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞등의 하얀 날개 역시 " + CALLNAME:MASTER + "의 뜻대로 움직였다/＞공중에 떠오를 수도 있어 천사가 되었다는 실감을 안겨준다…"
ELSE
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"알겠어/그럼 넌 여기서 기다리고 있으렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"네, 완료됐어/인간을 그만둔 " + CALLNAME:ARG + " 쨩의 모습, 제대로 봐주렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주의 안내를 받으며 " + CALLNAME:ARG + "가 돌아왔다"
	SELECTCASE NO:ARG
		CASE [[キャラ:베스]]
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"교단에 있을 때는 천사님을 동경했었지만…/설마 정말로 천사님이 될 줄은 생각도 못 했어"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞베스는 하얀 날개를 기쁜 듯 퍼덕이며 공중에 떠 있다/＞엔젤의 영향인지 피부는 다소 하얘졌고 머리카락은 금빛으로 물들어 있다/＞얼굴 생김새도 이전보다 다소 고귀해진 것처럼 보인다"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"겉모습은 변했을지 몰라도, 나는 앞으로도 당신과 함께 있을 테니까…"
			ENDIF
		CASE [[キャラ:미라이]]
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"나, 일단 데빌 칠드런이었는데…/천사가 되어버려도 괜찮았던 걸까…？"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞미라이는 자신에게 돋아난 순백의 날개를 보며 다소 당황해하고 있다/＞하지만 듣고 보니 데빌 칠드런을 천사로 만들어도 괜찮았던 걸까/＞뭐 거부 반응 같은 게 나타나는 기색은 없으니 괜찮으려나…？"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"하지만 솔직히 별로 실감이 안 났었으니까…/지금처럼 하늘을 날거나 하지도 못했었고/게다가 당신이 준 몸인걸, 소중히 할 테니까%UNICODE(0x2661)%"
			ENDIF
		CASE [[キャラ:도리]]
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "도리", @"사랑의 전사에서 바뀐, 사랑의 천사 매지컬 돌리！/나쁜 녀석들에게 진짜 천벌☆직빵~！/…어때어때？ 멋있지？"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞도리는 평소와는 다른 등이 파인 코스프레 의상을 입고 등 날개로 공중에 떠 신나 하고 있다/＞정의의 사도 흉내를 내보기에 천사만큼 알맞은 몸도 없을 것이다/＞" + CALLNAME:MASTER + "는 멍하니 도리를 바라보며 그런 생각을 했다…"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "도리", @"………정말이지, 반응이 미적지근하네~/아무튼, 앞으로도 사랑의 천사 매지컬 돌리를 잘 부탁해！"
			ENDIF
		CASE [[キャラ:마리]]
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마리", @"마리 선생님, 무려 천사가 되어버렸습니다%UNICODE(0x2661)%/예전에 다른 악마에게 빙의시킨 적은 있었지만 내가 천사가 될 줄은 생각도 못 했네/…하지만 이 날개, 가운 입는 데 방해되네…"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마리는 날개 위로 가운을 걸치려고 아등바등하고 있다/＞엔젤의 영향인지 금빛으로 물든 머리카락이 흔들릴 때마다 빛을 반사해 아름답다/＞그건 그렇고 날개에 맞춰 알맞게 모양 잡힌 풍만한 가슴이 흔들려 눈 둘 곳이 없다…"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마리", @"정말, 어디를 보는 거야！/그런 데만 쳐다보고 있으면 선생님이 벌줄 거야！"
			ENDIF
		CASE [[キャラ:마요네]]
			IF 恋慕系陥落(ARG)
				IF TALENT:ARG:유아체형
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"저, 별로 천사라는 타입은 아니라고 생각합니다만…"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마요네는 다소 못마땅하다는 표정을 짓고 있다/＞하지만 훌쩍 귀여워진 마요네에게 순백의 날개는 제법 잘 어울린다"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"정말인가요？/그렇다면 다행이네요/앞으로는 천사의 힘으로 듬뿍 당신의 힘이 되어 드려 보이겠어요~！"
				ELSE
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"저, 천사 같은 성미는 아닙니다만…"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마요네는 다소 못마땅하다는 표정을 짓고 있다/＞하지만 흑백을 기조로 한 복장을 한 마요네에게 돋아난 순백의 날개는 제법 잘 어울린다/＞마치 죽음을 고하는 천사 같다…"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"…별로 칭찬받는 것 같지는 않군요/뭐, 천사라고 해도 악마의 일종. 이 몸, 유효하게 활용해 주겠어요"
				ENDIF
			ENDIF
		CASE [[キャラ:나오토]]
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"이 몸, 지금까지의 옷은 더 이상 못 입을 것 같네요…/등이 파인 남성용 옷이란 게 있을까요？/앞으로 탐정으로서 활동할 때 필요한데…"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞나오토는 입을 수 있는 남성용 옷이 있을지 걱정하고 있다/＞하지만 등에 저런 눈에 띄는 날개를 달고 탐정 같은 걸 할 수 있나？/너무 눈에 띄어선 할 수 없는 일일 텐데…"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"하, 하늘을 날 수 있으니까 괜찮습니다！/하늘에서 미행당할지도 모른다고 생각하는 상대는 없을 테니까요！"
			ENDIF
		CASE [[キャラ:코시로]]
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "코시로", @"으~음…/나, 천사라고 하면 수상쩍다는 이미지밖에 없거든/어때요, 탐정 씨？ 지금의 나, 수상쩍어 보이지 않아요？"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞코시로는 금빛으로 물든 머리카락을 만지작거리며 거울을 보고 있다/＞등의 날개를 퍼덕이며 감촉을 확인하는 듯하다/＞" + CALLNAME:MASTER + "는 신성함은 더해졌지만 수상쩍지는 않다고 전해주었다…"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "코시로", @"그건 그렇고, 여신 아리안로드에서 엔젤이라니/나 왠지 격이 떨어진 것 같은 느낌인데/전보다 신성해 보인다는 말을 듣는 것도 조금 복잡할지도…"
			ENDIF
		CASEELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 눈부신 금빛 머리카락을 흩날리며/＞상질의 비단 같은 하얀 날개를 등에 달고 있었다"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "는 " + CALLNAME:ARG + "에게 아주 잘 어울린다고 말해주었다…"
	ENDSELECT
ENDIF


;ネコマタ
@DEMONIEZD_SET_3112, ARG
#LOCALSSIZE 1

IF NO:MASTER == NO:ARG
	CFLAG:MASTER:소속ＣＯＭＰ = -1
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 이쪽으로 와주겠니？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 안내받아 옷을 벗은 " + CALLNAME:MASTER + "는 작은 캡슐에 들어갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 시작할게/인간으로서의 삶에 작별을 고해두렴…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞머리와 엉덩이에 간지러운 감촉을 맛보며/＞" + CALLNAME:MASTER + "의 의식은 아득해져 갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자, 점주가 말을 걸어왔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"응, 잘 됐어/이게 인간을 그만둔 지금 당신의 모습이야/거울로 완성된 모습을 체크해보렴"
	IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 고양이 마수가 비치고 있었다/＞팬텀의 구성원으로서 단련된 육체와 어우러져 마치 사나운 육식수 같다"
	ELSEIF TALENT:MASTER:오토코노코 || TALENT:MASTER:후타나리
		IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 고양이 마수가 비치고 있었다/＞드러난 풍만한 육체와 언밸런스한 육봉을 보고/＞" + CALLNAME:MASTER + "는 그것이 자기 자신이라는 것을 알면서도 무심코 발기해 버렸다…"
		ELSEIF TALENT:MASTER:빈유 || TALENT:MASTER:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 고양이 마수가 비치고 있었다/＞평탄한 체형과 어우러져 어딘가 새끼 고양이를 연상시키는 모습이다"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 고양이 마수가 비치고 있었다/＞스스로 보기에도 균형 잡힌 몸매가 에로틱하다/＞거기에 뚜렷하게 존재감을 과시하는 페니스가 배덕감을 더하고 있다…"
		ENDIF
	ELSE
		IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 고양이 마수가 비치고 있었다/＞드러난 풍만한 육체에 " + CALLNAME:MASTER + "는 무심코 얼굴을 붉혔다…"
		ELSEIF TALENT:MASTER:빈유 || TALENT:MASTER:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 고양이 마수가 비치고 있었다/＞평탄한 체형과 어우러져 어딘가 새끼 고양이를 연상시키는 모습이다"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 고양이 마수가 비치고 있었다/＞스스로 보기에도 균형 잡힌 몸매가 에로틱하다"
		ENDIF
	ENDIF
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞손도 발도 고양이에 가까운 형태가 되어 물건을 쥐는 것은 다소 서툴러져 버렸다/＞그 대신 발톱이 날카로워 싸우는 것은 가능할 것 같다"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그리고 머리의 귀도 엉덩이에서 자라난 두 가닥 꼬리도 " + CALLNAME:MASTER + "의 뜻대로 움직였다/＞만지면 민감하게 반응해 버리니 손발과 더불어 일상생활에는 당분간 적응이 필요할 것이다…"
ELSE
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"알겠어/그럼 넌 여기서 기다리고 있으렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"네, 완료됐어/인간을 그만둔 " + CALLNAME:ARG + " 쨩의 모습, 제대로 봐주렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주의 안내를 받으며 " + CALLNAME:ARG + "가 돌아왔다"
	SELECTCASE NO:ARG
		CASE 4501
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"으~음… 귀랑 꼬리는 부끄럽지만/그것보다 손이랑 발이 고양이가 되어버리다니/발톱으로 다른 사람을 할퀴지 않도록 조심해야겠어"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞베스는 발톱을 꺼냈다 집어넣었다 하며 감각을 확인하는 듯하다/＞" + CALLNAME:MASTER + "는 장갑이라도 준비해 줄까 하고 말을 건넸다"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"아니, 괜찮아/게다가 유사시에 바로 할퀴지 못하면 곤란하잖아？/그러니까 제대로 익숙해져 두고 싶어"
			ENDIF
		CASE 4504
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"냐~앙, 농담이지롱！/나, 고양이가 되어버렸어！"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞미라이는 새로운 모습이 된 것을 아이답게 즐기고 있다/＞꼬리가 즐거운 듯 흔들리는 것으로도 알 수 있다"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"데빌 칠드런을 자처하는 이상 이 정도로 악마다운 게 좋겠지/앞으로도 잘 부탁해, 여보%UNICODE(0x2661)%"
			ENDIF
		CASE 4505
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "도리", @"냐~앙！/사랑의 전사 매지컬 돌리, 지금 등장이다냥！/나쁜 녀석들은 할퀴어 줄 거다냥！"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞도리는 평소의 코스프레 의상을 입고 꼬리를 흔들며 새로운 몸을 즐기고 있다/＞짧은 치마가 꼬리에 들려 올라가 속옷이 보이지만 눈치채지 못한 듯하다/＞…아, 드디어 꼬리를 알아챘다"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "도리", @"앗！/…이래선 치마 속이 다 보여버리잖아…/새로운 코스프레 의상 준비하지 않으면 안 되려나"
			ENDIF
		CASE 4506
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마리", @"마리 선생님, 귀여운 고양이가 되어버렸습니다%UNICODE(0x2661)%/…이 몸으로는 가운 단추는 못 잠글 것 같네/우선 소매만 걸쳐둘까나"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마리는 자신의 손에 나타난 육구를 말랑말랑 누르며 감촉을 확인하고 있다/＞가운을 입을 수 있을지 걱정하는 걸 보면 뼛속까지 양호선생님이다/＞하긴 혼자서 옷을 갈아입지도 못할 몸으로 가운만 걸쳐봤자…"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마리", @"그것도 그렇네…/그럼 " + CALLNAME:MASTER + " 군에게 옷을 갈아입혀 달라고 해볼까나%UNICODE(0x2661)%"
			ENDIF
		CASE 4516
			IF 恋慕系陥落(ARG)
				IF TALENT:ARG:유아체형
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"냐~앙！/어때요, 귀엽죠？/저 고양이니까 이런 짓도 한답니다！"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마요네는 이쪽에 응석 부리는 듯한 표정으로 비벼대며 다가온다/＞아무래도 영역 표시(마킹)를 하는 것 같다…"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"우후후, 저 " + CALLNAME:MASTER + "에게 길러져 버려요~！"
				ELSE
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"저, 이 양산은 마음에 들었습니다만…/이 손발로는 쥐기가 어렵네요/ＣＯＭＰ를 다른 형태로 바꾸는 편이 나으려나요"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마요네는 애용하는 양산을 들고 몸을 움직이고 있다/＞하지만 역시 고양이의 손발로는 양산 같은 막대 모양의 물체는 쥐기 어려운 모양이다"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"이 손발로도 쓸 수 있을 만한 형태의 ＣＯＭＰ라면…/피네간 흉내를 내는 건 내키지 않고/발톱으로도 키를 누를 수 있는 암 터미널로 바꿔볼까요"
				ENDIF
			ENDIF
		CASE 4541
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"어쩐지 전보다 몸이 가벼워진 느낌입니다/악마의 힘이라는 것일까요/이러면 탐정으로서도 점점 더 잘해나갈 수 있을 것 같군요"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞나오토는 깡충 뛰어보거나 하며 몸 상태를 확인하고 있다/＞하지만 손발이 고양이의 것이어서야 탐정 업무를 볼 수 있을까？/＞명백히 눈에 띌 것 같아 보이는데…"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"대신 이 몸이라면 담장 위 정도는 거뜬할 것 같습니다/상대가 예상치 못한 곳에 머무를 수 있으니 미행 같은 건 오히려 편할지도 모르겠군요"
			ENDIF
		CASE 4559
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "코시로", @"왠지 내 몸, 움직이기 편해진 느낌인데~/…하지만 이 손으로 원고 같은 건 쓸 수 있으려나"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞코시로는 발톱과 털이 자라난 자신의 손을 바라보며 원고를 쓸 수 있을지 걱정하고 있다/＞그보다 더 신경 써야 할 부분이 있을 것 같은데 어떠려나"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "코시로", @"네？ 귀나 꼬리나 다리 같은 건 걱정 안 해도 되냐고요？/거 참 탐정 씨도, 그 부분은 탐정 씨가 이것저것 커버해 줄 거잖아요？/이 몸으로 만든 책임, 확실히 지게 할 테니까요%UNICODE(0x2661)%"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…네."
			ENDIF
		CASEELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 머리에서 자라난 고양이 귀를 발톱과 털이 자란 손으로 확인하고 있다/＞일단 뒤로 살그머니 다가가 두 가닥 꼬리를 꽉 잡아주었다"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 갑작스러운 일에 비명을 지르며 펄쩍 뛰어올랐다…"
	ENDSELECT
ENDIF

;イナバシロウサギ
@DEMONIEZD_SET_3113, ARG
#LOCALSSIZE 1

IF NO:MASTER == NO:ARG
	CFLAG:MASTER:소속ＣＯＭＰ = -1
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 이쪽으로 와주겠니？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 안내받아 옷을 벗은 " + CALLNAME:MASTER + "는 작은 캡슐에 들어갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 시작할게/인간으로서의 삶에 작별을 고해두렴…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞머리와 엉덩이에 간지러운 감촉을 맛보며/＞" + CALLNAME:MASTER + "의 의식은 아득해져 갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자, 점주가 말을 걸어왔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"응, 잘 됐어/이게 인간을 그만둔 지금 당신의 모습이야/거울로 완성된 모습을 체크해보렴"
	IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 토끼 마수가 비치고 있었다/＞하지만 팬텀의 구성원으로서 단련된 육체와 어우러져 차라리 사나운 육식수 같다"
	ELSEIF TALENT:MASTER:오토코노코 || TALENT:MASTER:후타나리
		IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 토끼 마수가 비치고 있었다/＞드러난 풍만한 육체와 언밸런스한 육봉/＞" + CALLNAME:MASTER + "는 토끼의 성욕을 상징하는 것만 같다"
		ELSEIF TALENT:MASTER:빈유 || TALENT:MASTER:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 토끼 마수가 비치고 있었다/＞평탄한 체형과 어우러져 초식동물다운 가냘픔을 자아내고 있다"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 토끼 마수가 비치고 있었다/＞스스로 보기에도 균형 잡힌 몸매가 에로틱하다/＞거기에 뚜렷하게 존재감을 과시하는 페니스가 배덕감을 더하고 있다…"
		ENDIF
	ELSE
		IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 토끼 마수가 비치고 있었다/＞드러난 풍만한 육체에 " + CALLNAME:MASTER + "는 무심코 얼굴을 붉혔다…"
		ELSEIF TALENT:MASTER:빈유 || TALENT:MASTER:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 토끼 마수가 비치고 있었다/＞평탄한 체형과 어우러져 초식동물다운 가냘픔을 자아내고 있다"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 토끼 마수가 비치고 있었다/＞스스로 보기에도 균형 잡힌 몸매가 에로틱하다"
		ENDIF
	ENDIF
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞머리의 귀는 아무래도 꽤나 민감한 듯 " + CALLNAME:MASTER + "가 만질 때마다 몸이 움찔움찔 반응해 버렸다/＞이래선 모자 같은 것으로 숨기기도 어렵다. 일상생활에는 당분간 적응이 필요할 것이다…"
ELSE
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"알겠어/그럼 넌 여기서 기다리고 있으렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"네, 완료됐어/인간을 그만둔 " + CALLNAME:ARG + " 쨩의 모습, 제대로 봐주렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주의 안내를 받으며 " + CALLNAME:ARG + "가 돌아왔다"
	SELECTCASE NO:ARG
		CASE [[キャラ:베스]]
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"으~음… 귀랑 꼬리는 부끄럽지만/먼 곳의 소리가 조금 더 잘 들리는 기분이야/앞으로 일하는 데 도움이 될지도 모르겠네"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞베스는 붉어진 눈을 감고 귀를 쫑긋 세우고 있는 듯하다/＞" + CALLNAME:MASTER + "는 베스를 놀라게 해 보려고 큰 소리를 질러보았다…"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"꺄악！ …정말, 놀라게 하지 마/하지만 가까이서 큰 소리를 들으니 이렇게 울리는구나/조심해 두어야겠어"
			ENDIF
		CASE [[キャラ:미라이]]
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"우와아！ 나, 토끼가 되어버렸어！"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞미라이는 새로운 모습이 된 것을 아이답게 즐기고 있다/＞토끼답게 몇 번이고 깡충깡충 뛰고 있다/＞긴 귀가 즐거운 듯 흔들린다…"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"데빌 칠드런을 자처하는 이상 이 정도로 악마다운 게 좋겠지/앞으로도 잘 부탁해, 여보%UNICODE(0x2661)%"
			ENDIF
		CASE [[キャラ:도리]]
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "도리", @"뿅！/사랑의 전사 매지컬 돌리, 지금 등장이다뿅！/나쁜 녀석들은 할퀴어 줄 거다뿅！"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞도리는 평소의 코스프레 의상을 입고 긴 귀를 흔들며 새로운 몸을 즐기고 있다/＞짧은 치마가 꼬리에 들려 올라가 속옷이 보이지만 눈치채지 못한 듯하다/＞…아, 드디어 꼬리를 알아챘다"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "도리", @"앗！/…이래선 치마 속이 다 보여버리잖아…/새로운 코스프레 의상 준비하지 않으면 안 되려나"
			ENDIF
		CASE [[キャラ:마리]]
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마리", @"마리 선생님, 귀여운 토끼가 되어버렸습니다%UNICODE(0x2661)%/…머리카락도 하얘진 건 조금 놀랍네/하지만 예쁜 흰색이라 마음에 들어. 가운에도 어울릴 것 같고"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마리는 하얗게 물든 자신의 머리를 빗고 있다/＞풍만한 젖가슴과 어우러져 하얀 바니걸 같다"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마리", @"잠깐 " + CALLNAME:MASTER + " 군, 눈빛이 음흉해/그런 건 돌아가서 하도록 할까？"
			ENDIF
		CASE [[キャラ:마요네]]
			IF 恋慕系陥落(ARG)
				IF TALENT:ARG:유아체형
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"우후후, 전 귀여운 토끼랍니다/토끼는 외로움을 많이 타니까 꼭 안아줬으면 좋겠어요！"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마요네는 이쪽에 꼭 매달려 있다/＞아무래도 안아줬으면 하는 모양이다"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"우후후, 제가 외로워서 죽지 않도록/" + CALLNAME:MASTER + "께서 제대로 보살펴 주셨으면 좋겠어요%UNICODE(0x2661)%"
				ELSE
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"저, 이 모자는 마음에 들었습니다만…/이 귀가 꽤나 간지럽네요/귀를 뺄 구멍이라도 뚫어야 할까 봐요"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마요네는 애용하는 모자를 흰 귀와 머리에 어떻게 얹을지 고민하고 있다/＞더욱 모노톤에 가까워진 마요네는 귀부인다움이 더해진 것처럼도 느껴진다"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"어머, 감각이 날카로워진 것 같긴 하네요/앞으로는 이 힘, 마음껏 사용해 주도록 할까요"
				ENDIF
			ENDIF
		CASE [[キャラ:나오토]]
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"어쩐지 전보다 몸이 가벼워진 느낌입니다/악마의 힘이라는 것일까요/이러면 탐정으로서도 점점 더 잘해나갈 수 있을 것 같군요"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞나오토는 깡충 뛰어보거나 하며 몸 상태를 확인하고 있다/＞훌륭한 쌍구와 함께 귀가 흔들려 마치 유혹하고 있는 것만 같다"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"…어딜 보고 계시는 건가요？ 뭐 대충 짐작은 갑니다만…/아무튼, 이걸로 한층 더 도움이 될 수 있을 것 같습니다"
			ENDIF
		CASE [[キャラ:코시로]]
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "코시로", @"왠지 내 몸, 움직이기 편해진 느낌인데~/탐정 씨 탐정 씨, 잠깐 이리 와봐요/……쪽"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞코시로는 강화된 각력으로 뛰어올라 이쪽에 키스를 해왔다/＞하얗게 물든 머리카락과 새로 돋아난 귀가 흔들려 사랑스럽다/＞" + CALLNAME:MASTER + "는 코시로의 머리를 쓰다듬어 주었다…"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "코시로", @"후와앗！/뭔, 왠지 전보다 간지러워서… 햣！"
			ENDIF
		CASEELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 머리에서 자라난 토끼 귀를 확인하고 있다/＞민감한 건지 만질 때마다 몸이 움찔움찔 반응한다/＞일단 뒤로 살그머니 다가가 꼬리를 엉덩이째 쓰다듬어 주었다"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 갑작스러운 일에 비명을 지르며 펄쩍 뛰어올랐다…"
	ENDSELECT
ENDIF

;ピクシー
@DEMONIEZD_SET_3114, ARG, ARG:1
#LOCALSSIZE 1

IF NO:MASTER == NO:ARG
	CFLAG:MASTER:소속ＣＯＭＰ = -1
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 이쪽으로 와주겠니？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 안내받아 옷을 벗은 " + CALLNAME:MASTER + "는 작은 캡슐에 들어갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 시작할게/인간으로서의 삶에 작별을 고해두렴…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞몸이 작아져 가는 듯한 기묘한 감촉을 맛보며/＞" + CALLNAME:MASTER + "의 의식은 아득해져 갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자 엄청나게 거대해진 점주가 말을 걸어왔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"응, 잘 됐어/이게 인간을 그만둔 지금 당신의 모습이야/거울로 완성된 모습을 체크해보렴"
	IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 작은 요정이 비치고 있었다/＞하지만 몸은 작아졌는데 페니스는 그다지 작아지지 않았다/＞조교에 지장은 없을 것 같아 다행이지만 제법 거치적거린다…"
	ELSEIF TALENT:MASTER:오토코노코 || TALENT:MASTER:후타나리
		IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 작은 요정이 비치고 있었다/＞그리고 작은 몸에 어울리지 않는 커다란 유방과 가랑이의 육봉/＞스스로 보기에도 참으로 배덕감 넘치는 육체다…"
		ELSEIF TALENT:MASTER:빈유 || TALENT:MASTER:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 작은 요정이 비치고 있었다/＞평탄한 체형과 어우러져 귀여운 요정 소년이라는 행색이다"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 작은 요정이 비치고 있었다/＞스스로 보기에도 균형 잡힌 몸매가 에로틱하다/＞거기에 뚜렷하게 존재감을 과시하는 페니스가 배덕감을 더하고 있다…"
		ENDIF
		;そうでないと調教とか難しそうだし…
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞하지만 몸은 작아졌는데 페니스는 그다지 작아지지 않았다/＞조교에 지장은 없을 것 같아 다행이지만 제법 거치적거린다…"
	ELSE
		IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 작은 요정이 비치고 있었다/＞드러난 풍만한 육체에 " + CALLNAME:MASTER + "는 무심코 얼굴을 붉혔다…"
		ELSEIF TALENT:MASTER:빈유 || TALENT:MASTER:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 작은 요정이 비치고 있었다/＞평탄한 체형과 어우러져 옛날이야기 속 요정 그 자체 같은 모습을 하고 있다"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 작은 요정이 비치고 있었다/＞스스로 보기에도 균형 잡힌 몸매가 에로틱하다"
		ENDIF
	ENDIF
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그건 그렇고 하늘을 날 수 있다는 건 제법 재미있다/＞작아진 몸도 포함해서 앞으로 이런저런 재미가 있을 것 같다/＞…지금까지의 일상생활은 이제 무리겠지만"
ELSE
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"알겠어/그럼 넌 여기서 기다리고 있으렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"네, 완료됐어/인간을 그만둔 " + CALLNAME:ARG + " 쨩의 모습, 제대로 봐주렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주의 안내를 받으며 " + CALLNAME:ARG + "가 돌아왔다"
	SELECTCASE NO:ARG
		CASE 4501
			IF !TALENT:MASTER:소인체형
				IF 恋慕系陥落(ARG)
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"왠지 주변이 너무나 커 보여/하지만 내가 작아진 것뿐이겠지/…저기, 잠깐 어깨 좀 빌려줄래？"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇게 말하며 베스는 " + CALLNAME:MASTER + "의 어깨에 다소곳이 앉았다/＞단정한 이목구비와 어우러져 옛날이야기 속 요정 그 자체다"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"이제부터는 지금까지보다 더욱 곁에서, 더욱 함께 있게 해줘…"
				ENDIF
			ELSE
				IF 恋慕系陥落(ARG)
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"당신이 보던 세상은 이렇게나 컸던 거구나/머리로는 알고 있었지만, 실제로 겪어보니 다르네/조금 무서울지도…"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇게 말하며 베스는 " + CALLNAME:MASTER + "에게 매달려 왔다/＞" + CALLNAME:MASTER + "는 베스를 안심시켜 주기 위해 마주 안아주었다"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"…괜찮아, 고마워/이제부터는 당신과 같은 것을 보고, 같은 세상에서 살아갈 수 있어/그게 가장 행복한걸"
				ENDIF
			ENDIF
		CASE 4504
			IF !TALENT:MASTER:소인체형
				IF 恋慕系陥落(ARG)
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"우와아！ 나, 요정이 되어버렸어！/저기저기, 잠깐 위에 올라타 봐도 돼？"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇게 말하며 미라이는 " + CALLNAME:MASTER + "의 머리 위에 드러누웠다/＞파닥파닥 움직이는 날개가 머리칼을 쓰다듬는다…"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"앞으로는 나, 항상 당신 위에 있을 거니까！/그야 언제든지 당신을 지켜볼 수 있는걸%UNICODE(0x2661)%/그러니까 바람피우거나 하면 안 돼！"
				ENDIF
			ELSE
				IF 恋慕系陥落(ARG)
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"우와아！ 나, 요정이 되어버렸어！/저기저기 여보, 꼭~ 안아봐도 돼？"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇게 말하며 미라이는 " + CALLNAME:MASTER + "에게 매달려 하늘을 날았다/＞미라이는 하늘을 난다는 미지의 감각을 " + CALLNAME:MASTER + "와 함께 즐기고 싶은 듯하다…"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"앞으로는 나랑 더 많이 함께 있어 줘야 해！/그야 나도 당신이랑 똑같은 크기인걸！"
				ENDIF
			ENDIF
		CASE 4505
			CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "도리", @"사랑의 전사에서 바뀐, 사랑의 요정 매지컬 돌리, 지금 등장！/나쁜 녀석들은 내가 마법의 힘으로 해치워 버릴 테니까！/…역시 알몸이면 폼이 안 나네"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞도리는 코스프레 의상을 입을 수 없게 된 것을 아쉬워하고 있다/＞알몸으로 하늘을 날고 있는 모습은 꽤나 에로틱하다"
			CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "도리", @"이대로 알몸인 건 부끄럽고…/가능하면 빨리 옷을 준비해 주면 기쁠 텐데%UNICODE(0x2661)%"
		CASE 4506
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마리", @"마리 선생님, 귀여운 요정이 되어버렸습니다%UNICODE(0x2661)%/주변 물건들이 이렇게나 크게 보이다니 참신하네/어릴 적에는 세상이 이렇게 보였으려나…"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마리는 공중에 떠서 주변을 둘러보며 감개에 젖어 있다/＞풍만한 가슴을 그대로 드러내고 있다는 사실을 눈치채고는 있는 걸까？"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마리", @"잠깐 " + CALLNAME:MASTER + " 군, 어디를 보는 거야！？/…가능하면 인형용 옷이라도 좋으니 준비해 줬으면 좋겠어/그것도 등이 크게 파인 옷이어야겠네… 선생님, 조금 부끄러운걸"
			ENDIF
		CASE 4516
			IF 恋慕系陥落(ARG)
				IF ARG:1 == 99
					;以前は小柄体型だった場合
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"우후후, 전 귀여운 요정이랍니다/하늘을 날 수 있다는 건 정말 즐겁네요！"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마요네는 날개를 퍼덕이며 날아다니고 있다/＞…아, 거울에 부딪혀 툭 떨어졌다"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"으으… 아프네요…/연습을 조금 해야겠어요"
				ELSE
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"이렇게나 작아질 줄은 생각지도 못했어요…/지금까지 몸에 걸치고 있던 것들은 거의 도움이 안 되겠네요"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마요네는 눈앞에 놓인 자신의 옷을 보며 고민하고 있다/＞요정용 ＣＯＭＰ 같은 게 어디엔가 있으려나？"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"저도 서머너, 가능하면 지금 몸으로도 쓸 수 있는 ＣＯＭＰ를 갖고 싶은 참이네요/뭐, 악마의 힘을 손에 넣은 이상 이대로도 싸울 수는 있지만…/역시 갈고닦은 경험이란 아까운 법이니까요"
				ENDIF
			ENDIF
		CASE 4541
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"이렇게 작아질 줄이야… 역시 조금 불안하긴 하네요/하지만 그 대신 탐정으로서는 둘도 없는 힘이군요/지금의 제 미행을 눈치챌 수 있는 사람은 없을 테니까요"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞나오토는 날개를 퍼덕이며 공중에 떠 있다/＞확실히 이렇게나 귀여운 탐정이 존재하리라 생각하는 사람은 전무하겠지"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"…왠지 조금 쑥스럽네요/어찌 되었든, 앞으로도 잘 부탁드립니다"
			ENDIF
		CASE 4559
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "코시로", @"이 몸, 학교 친구들이 보면 뭐라고 할까나~/평범한 인간은 이렇게 작아지지 않잖아/…뭐, 어떻게든 둘러댈 수 있을 것 같긴 하지만"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞코시로는 날개로 공중을 날며 친구들에게 어떻게 설명해야 할지 고민하고 있다/＞…순간, 코시로가 갑자기 이쪽을 돌아보았다"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "코시로", @"어쨌든 탐정 씨, 나 이 몸으로는 이제 일상생활도 못 보내겠죠？/제대로 책임져 주셔야 해요？"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…네."
			ENDIF
		CASEELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 지면에 내려서 날개의 움직임을 확인하는 듯하다/＞아직 익숙지 않은 건지 날개를 움직일 때마다 몸이 살짝 뜨고 있다"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…아, 균형을 잃고 넘어졌다…"
	ENDSELECT
ENDIF

;マーメイド
@DEMONIEZD_SET_3115, ARG
#LOCALSSIZE 1

IF NO:MASTER == NO:ARG
	CFLAG:MASTER:소속ＣＯＭＰ = -1
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 이쪽으로 와주겠니？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 안내받아 옷을 벗은 " + CALLNAME:MASTER + "는 작은 캡슐에 들어갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 시작할게/인간으로서의 삶에 작별을 고해두렴…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞허리 아래가 서서히 녹아내리는 감촉을 맛보며/＞" + CALLNAME:MASTER + "의 의식은 아득해져 갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자, 점주가 말을 걸어왔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"응, 잘 됐어/이게 인간을 그만둔 지금 당신의 모습이야/거울로 완성된 모습을 체크해보렴"
	IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 인어가 비치고 있었다/＞페니스 아래로는 틀림없는 물고기의 그것으로 변해 있었다/＞바다에라도 한번 잠수해 보고 싶네…"
	ELSEIF TALENT:MASTER:오토코노코 || TALENT:MASTER:후타나리
		IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 인어가 비치고 있었다/＞그리고 커다란 유방과 비늘 사이로 삐져나온 가랑이의 육봉/＞그야말로 이형의 육체이지만 그것이 좋다"
		ELSEIF TALENT:MASTER:빈유 || TALENT:MASTER:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 인어가 비치고 있었다/＞가랑이의 비늘 사이로 삐져나온 육봉이 한층 더 이형다움을 드러내며 악마가 되었다는 실감을 안겨준다"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 인어가 비치고 있었다/＞스스로 보기에도 균형 잡힌 몸매가 에로틱하다/＞거기에 뚜렷하게 존재감을 과시하는 페니스가 배덕감을 더하고 있다…"
		ENDIF
	ELSE
		IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 인어가 비치고 있었다/＞드러난 풍만한 가슴에 자신인 것을 알면서도 " + CALLNAME:MASTER + "는 얼굴을 붉혔다…"
		ELSEIF TALENT:MASTER:빈유 || TALENT:MASTER:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 인어가 비치고 있었다/＞유선형에 가까운 육체와 어우러져 헤엄치는 속도가 빠를 것 같다/＞어딘가 풀장이라도 빌려서 헤엄쳐 볼까…"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울에는 " + CALLNAME:MASTER + "의 모습이 남아 있는 인어가 비치고 있었다/＞스스로 보기에도 균형 잡힌 몸매가 에로틱하다/＞하반신이 그리는 인어 특유의 곡선도 훌륭하다…"
		ENDIF
	ENDIF
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞하지만 다리가 물고기 꼬리로 변했기 때문에 걸을 수가 없다…/＞다행히 펄쩍 뛰어서 이동할 수 있고 이동 속도 자체는 지금까지와 별반 다르지 않다/＞하지만 움직이기 힘든 건 사실이다. 당분간 연습해야겠어"
ELSE
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"알겠어/그럼 넌 여기서 기다리고 있으렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"네, 완료됐어/인간을 그만둔 " + CALLNAME:ARG + " 쨩의 모습, 제대로 봐주렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주의 안내를 받으며 " + CALLNAME:ARG + "가 돌아왔다"
	SELECTCASE NO:ARG
		CASE 4501
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"설마 인어가 될 수 있을 줄은 생각도 못 했어/…하지만 역시 걸을 수가 없네/혹시 앞으로는 물속에 있어야 하는 걸까"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞베스는 앞으로 육지에서 지낼 수 있을지 걱정하는 듯하다/＞일단 펄쩍 뛰어서 이동할 수는 없냐고 물어보았다/＞…무사히 움직이고 있다"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "베스", @"일단 괜찮은 것 같지만, 조금 움직이기 어렵네/…혹시 밖으로 나갈 때는 가능하면 업어주면 기쁠 텐데"
			ENDIF
		CASE 4504
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"우와아！ 나, 인어가 되어버렸어！/…하지만 이러면 걷지도 뛰지도 못하겠네"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞미라이는 새로운 모습이 된 것을 아이답게 즐기고 있다/＞하지만 걸을 수 없다는 점을 아쉬워하고 있기도 한 듯하다/＞" + CALLNAME:MASTER + "는 미라이에게 언젠가 어디 섬으로라도 이사 갈까, 하고 물어보았다"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "미라이", @"아, 그거 재밌겠다♪/당신 집에서 함께 지내면서 내가 물고기 같은 걸 잡아오는 거야/그리고 밤이 되면 마음껏 예쁨받을 거니까%UNICODE(0x2661)%"
			ENDIF
		CASE 4505
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "도리", @"으~음… 인어 다리에 어울리는 코스프레는 어떤 게 있으려나？/조개껍데기는 좀 뻔하고, 그렇다고 다른 좋은 아이디어도…"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞도리는 의자에 앉아 새로운 다리, 아니 꼬리를 찰랑거리며 코스프레를 고민하고 있다/＞…차라리 프릴이 잔뜩 달린 옷을 입고 헤엄치며 펄럭거리게 하는 건 어떨까"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "도리", @"앗！ 좋은 아이디어잖아♪/그걸로 서머너가 잠수하지 못하는 바다의 악마 같은 걸 퇴치해 버리는…/불타오르기 시작했어~！"
			ENDIF
		CASE 4506
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마리", @"마리 선생님, 인어가 되어버렸습니다%UNICODE(0x2661)%/…이제 가운은 못 입겠네. 애초에 걷지를 못하는걸/바닷속에서 입을 수 있는 옷이라면… 역시 수영복이려나？"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마리는 자신의 다리, 아니 꼬리를 보며 앞으로의 복장을 고민하고 있는 듯하다/＞그 커다란 가슴이라면 조개껍데기 같은 것도 어울리지 않을까"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마리", @"잠깐 당신 군, 눈빛이 음흉해/…그런 건 돌아가서 하도록 할까？"
			ENDIF
		CASE 4516
			IF 恋慕系陥落(ARG)
				IF TALENT:ARG:유아체형
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"우후후, 저 인어님이 되었어요！/…걸을 수가 없네요. 여보, 업어주세요"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마요네는 이쪽에게 업어달라고 요구하고 있다/＞실제로 육지 위에서는 이러지 않으면 이제 움직이지 못하는 걸지도 모른다…/＞악마인 머메이드는 대체 어떻게 움직이는 걸까？"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"우후후, 전 이제 당신 없이는 살아갈 수 없는걸요/잘 부탁드려요%UNICODE(0x2661)%"
				ELSE
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"저, 이 옷은 마음에 들었습니다만…/역시 인어의 몸에는 맞지 않네요/알몸은 싫고, 뭔가 옷을 생각해 봐야겠어요"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞마요네는 자신의 육체가 변한 것보다도 복장을 신경 쓰고 있다/＞역시 마요네, 육체에 대한 걱정은 하지 않는 모양이다"
					CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "마요네", @"당신이 바란 육체인걸요, 거기에 이의는 없어요/어떻게 이 육체를 살려갈 것인가, 를 생각할 뿐이죠/다행히 보지는 비늘 아래에 있는 것 같고 안아주실 수는 있을 것 같으니 말이에요"
				ENDIF
			ENDIF
		CASE 4541
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"이 몸으로는 아무래도 탐정은 폐업이겠네요…/죄송하지만 제 방에 큼직한 수조나 풀장을 마련해 주실 수 있나요？/물가에 컴퓨터를 놓아주시면 여러 가지를 할 수 있을 테니까요"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞나오토는 자신의 다리, 아니 꼬리를 쓰다듬으며 앞으로의 일을 생각하고 있다/＞애초에 악마가 되었으니 일 걱정 따위는 하지 않아도 될 텐데/＞어차피 ＭＡＧ는 이쪽에서 제공해 줄 테고…"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "나오토", @"그렇게 말씀하셔도 아무것도 하지 않고 있으면 안정이 안 된단 말입니다/게다가 당신을 돕고 싶기도 하고요…"
			ENDIF
		CASE 4559
			IF 恋慕系陥落(ARG)
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "코시로", @"으~음… 이 몸, 학교 친구들이 뭐라고 할까나…/나, 악마가 됐는데도 아직 학교 가야 하는 걸까/…애초에, 학교에 갈 수도 없을 것 같아"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞코시로는 의자에 앉아 꼬리를 위아래로 움직이며 생각에 잠겨 있다/＞…순간, 코시로가 갑자기 이쪽을 돌아보았다"
				CALL MESSAGE_WINDOW_D_ICON, ARG, "キャラ登録番号", , "코시로", @"물론 탐정 씨는 내 몸을 개조한 책임을 져주시겠죠？/일단, 그 왜 공주님 안기라는 거, 해주세요/나, 아마 이젠 못 걸을 테니까…"
			ENDIF
		CASEELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 의자에 앉아 다리가 아닌 꼬리를 쓰다듬으며 이쪽을 보고 미소 짓고 있다/＞옛날이야기에 나오는 아름다운 인어 그 자체의 모습이다…"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞일단 " + CALLNAME:ARG + "의 방에 풀장이라도 설치해 줄까…"
	ENDSELECT
ENDIF

