					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞풍만한 몸에 박쥐 같은 날개/＞그야말로 " + CALLNAME:ARG + "는 서큐버스 같다…"
				CASE 4
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞풍만한 몸에 맹금 같은 날개/＞" + CALLNAME:ARG + "가 날개를 움직일 때마다 풍만한 가슴이 흔들려 에로틱하다…"
			ENDSELECT
		ELSEIF TALENT:ARG:빈유 || TALENT:ARG:절벽
			SELECTCASE B
				CASE 1
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞다소 빈약한 몸에 천사 같은 하얀 날개/＞" + CALLNAME:ARG + "는 옛날 동화에서 보았던 천사 같다…"
				CASE 2
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞다소 빈약한 몸에 타천사 같은 검은 날개/＞" + CALLNAME:ARG + "는 흑조를 연상시킨다…"
				CASE 3
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞다소 빈약한 몸에 박쥐 같은 날개/＞이런 모습의 악마, 있었던 것 같은 기분이…"
				CASE 4
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞다소 빈약한 몸에 맹금 같은 날개/＞" + CALLNAME:ARG + "는 민첩해진 것처럼 보인다/＞…하지만 유감스럽게도 딱히 그렇지는 않은 모양이다"
			ENDSELECT
		ELSE
			SELECTCASE B
				CASE 1
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞늘씬한 몸에 천사 같은 하얀 날개/＞" + CALLNAME:ARG + "는 무척 청초한 모습이 되었다…/＞하지만 속내가 어떨지는 장담할 수 없다…"
				CASE 2
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞늘씬한 몸에 타천사 같은 검은 날개/＞" + CALLNAME:ARG + "의 탄탄하게 잘 다듬어진 육체와 어우러져, 운동 능력이 뛰어날 것처럼 보인다"
				CASE 3
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞늘씬한 몸에 박쥐 같은 날개/＞" + CALLNAME:ARG + "는 옛날이야기에서 보았던 악마의 모습과 닮았다"
				CASE 4
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞늘씬한 몸에 맹금 같은 날개/＞마치 망토처럼 " + CALLNAME:ARG + "의 몸을 감싸 안고 있다"
			ENDSELECT
		ENDIF
	ENDIF
ENDIF


@PETIT_DEMON_SET_3104, ARG

CSTR:ARG:46 = 현재는 쁘띠 데모로 인해 인어로 변해 있다.
TALENT:ARG:꼬리 = 1
TALENT:ARG:물고기 = 1
TALENT:ARG:발 = 0
IF NO:MASTER == NO:ARG
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 이쪽으로 와주겠니？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 안내받아, " + CALLNAME:MASTER + "는 작은 캡슐에 들어갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼 시작할게/조금만 기다려, 금방 끝나니까"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "의 의식은 아득해져 갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자, 점주가 말을 걸어왔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"응, 잘 끝났어/지금 네 모습, 정말 쿨하단다！/거울로 완성된 모습을 체크해 보렴！"
	IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "의 모습은 그야말로 건장한 남성 인어였다/＞페니스 아래쪽은 영락없는 물고기의 그것으로 변해 있었다/＞바다에라도 한 번 잠수해 보고 싶네…"
	ELSEIF TALENT:MASTER:오토코노코 || TALENT:MASTER:후타나리
		IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "는 그야말로 명화에서나 보던 풍만한 인어의 모습 그 자체였지만/＞과거 사타구니라 불렀던 곳에서 돋아난 페니스만이 유일하게 달랐다/＞한 번 마음껏 헤엄쳐보고 싶다…"
		ELSEIF TALENT:MASTER:빈유 || TALENT:MASTER:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "는 그야말로 명화에서나 보던 인어의 모습 그 자체였지만/＞가슴은 평평하고 사타구니라 불렀던 곳에서 돋아난 페니스가 존재감을 과시하고 있었다…/＞한 번 마음껏 헤엄쳐보고 싶다…"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "는 그야말로 명화에서나 보던 인어의 모습 그 자체였지만/＞과거 사타구니라 불렀던 곳에서 돋아난 페니스만이 유일하게 달랐다/＞한 번 마음껏 헤엄쳐보고 싶다…"
		ENDIF
	ELSE
		IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "는 그야말로 명화에서나 보던 인어의 모습 그 자체였다/＞자랑인 풍만한 바스트도 그대로다/＞큼직한 조개껍데기라도 구해서 가슴에 대어둘까"
		ELSEIF TALENT:MASTER:빈유 || TALENT:MASTER:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "는 그야말로 명화에서나 보던 인어의 모습 그 자체였다/＞…하지만 가슴은 역시 작았다/＞조개껍데기라도 대어볼 수는 없을까…"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "는 그야말로 명화에서나 보던 인어의 모습 그 자체였다/＞여기선 조개껍데기라도 구해서 가슴에 대어둘까"
		ENDIF
	ENDIF
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그러나 인어가 되어본 것까진 좋은데/＞이후 일상생활을 어찌해야 할까…/＞지금까지와 같은 감각으로 움직이고는 있지만…"
ELSE
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"알겠어/그럼 넌 여기서 기다리고 있으렴？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"네, 완료됐어！/아주 쿨해졌단다！"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 이끌려, " + CALLNAME:ARG + "가 부끄러운 듯 돌아왔다"
	IF TALENT:ARG:남자 && !TALENT:ARG:오토코노코
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "의 모습은 그야말로 건장한 남성 인어였다/＞페니스 아래쪽은 영락없는 물고기의 그것으로 변해 있었다/＞수조에서 한 번 헤엄치게 해보고 싶다…"
	ELSEIF TALENT:ARG:오토코노코 || TALENT:ARG:후타나리
		IF TALENT:ARG:거유 || TALENT:ARG:폭유 || TALENT:ARG:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 그야말로 명화에서나 보던 풍만한 인어의 모습 그 자체였지만/＞과거 사타구니라 불렀던 곳에서 돋아난 페니스만이 유일하게 달랐다/＞한 번 마음껏 함께 헤엄쳐보고 싶다…"
		ELSEIF TALENT:ARG:빈유 || TALENT:ARG:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 그야말로 명화에서나 보던 인어의 모습 그 자체였지만/＞가슴은 평평하고 사타구니라 불렀던 곳에서 돋아난 페니스가 존재감을 과시하고 있었다…/＞한 번 마음껏 함께 헤엄쳐보고 싶다…"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 그야말로 명화에서나 보던 인어의 모습 그 자체였지만/＞과거 사타구니라 불렀던 곳에서 돋아난 페니스만이 유일하게 달랐다/＞한 번 마음껏 함께 헤엄쳐보고 싶다…"
		ENDIF
	ELSE
		IF TALENT:ARG:거유 || TALENT:ARG:폭유 || TALENT:ARG:마유
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 그야말로 명화에서나 보던 인어의 모습 그 자체였다/＞자랑인 풍만한 바스트도 그대로다/＞큼직한 조개껍데기라도 구해서 가슴에 대어줄까"
		ELSEIF TALENT:ARG:빈유 || TALENT:ARG:절벽
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 그야말로 명화에서나 보던 인어의 모습 그 자체였다/＞…하지만 가슴은 역시 작았다/＞조개껍데기라도 대어줄 수는 없을까…"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:ARG + "는 그야말로 명화에서나 보던 인어의 모습 그 자체였다/＞여기선 조개껍데기라도 구해서 가슴에 대어줄까"
