		MAXBASE:ARG:주살 = -100
		MAXBASE:ARG:지변 = 75
		MAXBASE:ARG:수격 = 150
		MAXBASE:ARG:질풍 = 75
		MAXBASE:ARG:중력 = 50
		MAXBASE:ARG:핵열 = 150
