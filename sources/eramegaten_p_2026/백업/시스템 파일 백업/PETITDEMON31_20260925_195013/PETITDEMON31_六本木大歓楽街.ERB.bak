;人魚
@PETIT_DEMON_TYPE_3104, ARGS, ARG
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "プチデモタイプ"
		RESULTS = 인어
	CASE "チェック"
		IF TALENT:ARG:물고기 == 1
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "어머, 이 아인 이미 인어 모습이잖니/더 이상 쁘띠 데모를 하면 위험하니까 그만두렴"
