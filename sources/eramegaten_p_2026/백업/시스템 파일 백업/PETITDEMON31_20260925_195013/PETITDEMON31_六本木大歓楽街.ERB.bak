@ADVANCE_DEMONIEZD_TYPE_3133, ARGS, ARG
#LOCALSSIZE 1
#DIM 価格計算, 1

CALLFORM ADVANCE_DEMONIEZD_MILD_MONEY, ARG, "화염", "핵열"
