				IF CSTR:ARG:상성그룹 == "牛"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 개면 꼬리도 개/＞이제 " + CALLNAME:ARG + "는 영락없는 소 인간이다…"
