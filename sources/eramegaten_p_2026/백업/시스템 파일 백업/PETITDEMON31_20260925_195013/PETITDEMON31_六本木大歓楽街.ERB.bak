		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "상성상 " + TOSTR(価格計算) + "마카가 들지만/정말로 "+ CALLNAME:ARG + " 쨩에게 지령 소스를 주입해도 괜찮겠니？"
	CASE "価格"
		RETURN 価格計算
