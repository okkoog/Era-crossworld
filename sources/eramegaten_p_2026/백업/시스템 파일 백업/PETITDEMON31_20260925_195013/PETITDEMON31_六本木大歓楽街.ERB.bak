;プチデモ実行
;------------------------------

;동물귀
@PETIT_DEMON_SET_3101, ARG

CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 어떤 동물의 귀로 할 거니？"
CALL INPUT_SELECT_D , "어떤 귀로 할래？//[1]개/[2]고양이/[3]여우/[4]소(뿔 포함)/[5]토끼" , , , 2
B = RESULT
SELECTCASE B
	CASE 1
		CSTR:ARG:49 = 현재는 쁘띠 데모로 인해 머리 부분에 개의 귀가 달려 있다.
	CASE 2
		CSTR:ARG:49 = 현재는 쁘띠 데모로 인해 머리 부분에 고양이의 귀가 달려 있다.
	CASE 3
		CSTR:ARG:49 = 현재는 쁘띠 데모로 인해 머리 부분에 여우의 귀가 달려 있다.
	CASE 4
		CSTR:ARG:49 = 현재는 쁘띠 데모로 인해 머리 부분에 소의 귀와 뿔이 달려 있다.
	CASE 5
		CSTR:ARG:49 = 현재는 쁘띠 데모로 인해 머리 부분에 토끼의 귀가 달려 있다.
ENDSELECT
TALENT:ARG:동물귀 = 1
IF NO:MASTER == NO:ARG
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼, 이쪽으로 와주겠니？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞점주에게 안내받아, " + CALLNAME:MASTER + "는 작은 캡슐에 들어갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"그럼 시작할게/조금만 기다려, 금방 끝나니까"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "의 의식은 아득해져 갔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
	CALL SHOW_PICTURE, "EMPTY"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 눈을 뜨자, 점주가 말을 걸어왔다…"
	CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주", @"응, 잘 끝났어/지금 네 모습, 정말 쿨하단다！/거울로 완성된 모습을 체크해 보렴！"
	IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
		SELECTCASE B
			CASE 1
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그 말을 듣고 들여다본 거울에는, /＞건장한 몸에 개 같은 귀를 한 남자가 비치고 있었다/＞축 늘어진 귀가 머리카락에 닿아 간지럽다…"
				IF CSTR:ARG:상성그룹 == "犬"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 개면 꼬리도 개/＞이제 " + CALLNAME:ARG + "는 영락없는 개 인간이다…"
					CSTR:ARG:타이틀 = 개 인간
				ENDIF
				CSTR:ARG:상성그룹 = 犬
			CASE 2
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그 말을 듣고 들여다본 거울에는, /＞건장한 몸에 고양이 같은 귀를 한 남자가 비치고 있었다/＞기분 탓인지, 귀가 더 잘 들리는 느낌이 든다"
				IF CSTR:ARG:상성그룹 == "猫"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 고양이면 꼬리도 고양이/＞이제 " + CALLNAME:ARG + "는 영락없는 고양이 인간이다…"
					CSTR:ARG:타이틀 = 고양이 인간
				ENDIF
				CSTR:ARG:상성그룹 = 猫
			CASE 3
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그 말을 듣고 들여다본 거울에는, /＞건장한 몸에 여우 같은 귀를 한 남자가 비치고 있었다/＞그늘에 있을 점주의 위치가 소리로 파악되는 느낌이다…"
				IF TALENT:ARG:여우 == 1
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 여우면 꼬리도 여우/＞이제 " + CALLNAME:ARG + "는 영락없는 여우 인간이다…"
					CSTR:ARG:타이틀 = 여우 인간
				ENDIF
				TALENT:ARG:여우 = 1
			CASE 4
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그 말을 듣고 들여다본 거울에는, /＞건장한 몸에 소 같은 귀와 뿔이 돋아난 남자가 비치고 있었다/＞미노타우로스는 아니다…"
				IF CSTR:ARG:상성그룹 == "牛"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 소면 꼬리도 소/＞이제 " + CALLNAME:ARG + "는 영락없는 소 인간이다…"
					CSTR:ARG:타이틀 = 소 인간
				ENDIF
				CSTR:ARG:상성그룹 = 牛
			CASE 5
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그 말을 듣고 들여다본 거울에는, /＞건장한 몸에 토끼 같은 귀가 달린 남자가 비치고 있었다/＞어쩐지 정력이 샘솟는 듯한 기분이 들었다…"
				IF CSTR:ARG:상성그룹 == "兎"
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 토끼면 꼬리도 토끼/＞이제 " + CALLNAME:ARG + "는 영락없는 토끼 인간이다…"
					CSTR:ARG:타이틀 = 토끼 인간
				ENDIF
				CSTR:ARG:상성그룹 = 兎
		ENDSELECT
	ELSEIF TALENT:MASTER:오토코노코
		IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
			SELECTCASE B
				CASE 1
					CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그 말을 듣고 들여다본 거울에는, 여자처럼 풍만한 몸에 개 같은 귀가 달린 소년이 비치고 있었다/＞고개를 움직이면, 거기에 맞춰 귀가 움직여서 재미있다…"
					IF CSTR:ARG:상성그룹 == "犬"
						CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇다 쳐도, 귀도 개면 꼬리도 개/＞이제 " + CALLNAME:ARG + "는 영락없는 개 남자인가…/＞아니, 강아지 소녀인가？"
