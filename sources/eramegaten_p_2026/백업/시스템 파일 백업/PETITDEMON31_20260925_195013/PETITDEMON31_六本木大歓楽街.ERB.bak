			BASE:ARG:수격 -= 25
			IF MAXBASE:ARG:수격 < 0
				MAXBASE:ARG:수격 = 0
				BASE:ARG:수격 = 0
			ENDIF
		ENDIF
		TALENT:ARG:무관심 = 1
ENDSELECT


