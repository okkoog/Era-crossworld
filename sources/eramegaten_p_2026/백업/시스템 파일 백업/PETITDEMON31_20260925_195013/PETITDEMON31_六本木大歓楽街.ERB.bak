;동물귀
@PETIT_DEMON_TYPE_3101, ARGS, ARG
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "プチデモタイプ"
		RESULTS = 동물귀
	CASE "チェック"
		IF TALENT:ARG:동물귀 == 1
			CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "어머, 이 아인 이미 동물의 귀가 있잖니/더 이상 쁘띠 데모를 하면 위험하니까 그만두렴"
			RETURN 0
		ENDIF
		RETURN 1
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남 점주" , "동물의 귀를 다는 거구나, 알겠어/그거라면 １０００마카인데, 괜찮겠니？"
	CASE "価格"
		RETURN 1000
ENDSELECT

