								EXP:MASTER:성교경험 += (ABL:MASTER:마조끼 + 1) * 2
								EXP:MASTER:절정경험 += (ABL:MASTER:마조끼 + 1) * 2
								EXP:MASTER:봉사쾌락경험 += (ABL:MASTER:마조끼 + 1) * 6
								EXP:MASTER:고통쾌락경험 += (ABL:MASTER:마조끼 + 1) * 6
								JUEL:MASTER:고통 += (ABL:MASTER:마조끼 + 1) * 300
								JUEL:MASTER:치정 += (ABL:MASTER:마조끼 + 1) * 200
								JUEL:MASTER:굴복 += (ABL:MASTER:마조끼 + 1) * 500
								JUEL:MASTER:공포 += (ABL:MASTER:마조끼 + 1) * 200
								JUEL:MASTER:욕정 += ABL:MASTER:마조끼 * (500) + 500
								JUEL:MASTER:쾌Ｃ += ABL:MASTER:마조끼 * (400) + 300
								JUEL:MASTER:쾌Ｂ += ABL:MASTER:마조끼 * (200) + 100
								IF !TALENT:MASTER:남자
									JUEL:MASTER:쾌Ｖ += ABL:MASTER:마조끼 * (500) + 500
									EXP:MASTER:Ｖ경험 += (ABL:MASTER:마조끼 + 1) * 2
									EXP:MASTER:레즈경험 += (ABL:MASTER:마조끼 + 1) * 2
								ENDIF
								IF TALENT:MASTER:재생처녀 || TALENT:MASTER:처녀
									PRINTL 처녀상실
									TALENT:MASTER:처녀 = 0
									TALENT:MASTER:재생처녀 = 0
									CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", MASTER)
									CALL SHOW_ABNORMAL_EXP , MASTER, 1
									;PRINTL 이상경험 + 1
									;EXP:MASTER:이상경험 += 1
								ENDIF

								IF TALENT:MASTER:남자 || TALENT:MASTER:후타나리
									EXP:MASTER:질사경험 += (ABL:MASTER:마조끼 + 1) * 2
									EXP:MASTER:사정경험 += (ABL:MASTER:마조끼 + 1) * 2
								ENDIF

								IF TALENT:MASTER:모유체질
									EXP:MASTER:분유경험 += (ABL:MASTER:마조끼 + 1) * 2
									JUEL:MASTER:쾌Ｂ += (ABL:MASTER:마조끼 + 1) * 200
								ENDIF
								CALL CONTROL_MAG, MASTER, -(ABL:MASTER:마조끼 + 1) * 200
								IF ダンジョンフラグ:31:60 == 5
									ダンジョンフラグ:31:60 = 1
								ENDIF
							ELSE
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞고장 난 기계가 방치되어 있다…//"
							ENDIF
						ENDIF
					CASE 34
						;コードブレイカー
						CALL CDB_31
					CASE 36
						CALL MESSAGE_WINDOW_D_ICON, , "13_若い男2", , "젊은 남자", @"얼마 전에 저기 구제옷 가게에 노숙자가 멋있는 옷을 가져왔더라고/옆에서 봤는데, 분명…/무슨 버스터의 제복이래"
						CALL MESSAGE_WINDOW_D_ICON, , "13_若い男2", , "젊은 남자", @"저렇게 멋진 옷이 제복이라면/나도 그 뭐시기 버스터에 취직해 볼까…/근데 무슨 일을 하는 거지?"
						CALL MESSAGE_WINDOW_D_ICON, , "13_若い男2", , "젊은 남자" , "그나저나 애초에 그 노숙자는/어디서 어떻게 저 제복을 구한 거지?/그놈한테 말 걸어서 옷만 찾아볼까…"
						;デバッグ確認用
						;CALL ADD_NEW_COMPANION, [[キャラ:에미]],1500
						;SIF RESULT
						;CALL SET_TALENT_PARTY_JOINABLE, (RESULT:1), "신용"
					CASE 38
						;服屋(盗品)早坂加入イベントの始め及びマッカで買える鎧たち
						IF ダンジョンフラグ:31:6 == 0 && FINDCHARA_B([[キャラ:에미]], 0) == 2
							ダンジョンフラグ:31:6 = 1
							CHARA = RESULT:1
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞수상쩍은 구제옷 가게에 들어가자, 아니나 다를까 수상쩍은 남자가 말을 걸어왔다//"
							IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
								CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "형씨, 데빌 버스터 제복 안 살래?/얼마 전에 막 들어왔는데/"
							ELSE
								CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "아가씨, 데빌 버스터 제복 안 살래?/얼마 전에 막 들어왔는데/"
							ENDIF
							CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "가격은 1만 마카!/손때가 묻긴 했지만 번듯한 물건이라고/여기서 단 한 푼도 못 깎아!"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞중고 데빌 버스터 제복…/＞피라든가 온갖 것을 잔뜩 빨아들였을 것 같다/＞솔직히 탐나진 않지만…" 
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞필요 없다고 말하고 나가려고 뒤를 돌아보자, 에이미가 이쪽을…/＞아니, 데빌 버스터 제복을 응시하고 있었다/"
							;CALL SHOW_PICTURE, "D"
							IF (TALENT:(CHARA):연모 || TALENT:(CHARA):친애)
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , @"이거…/아냐, 아무것도 아니야/그야 지금의 나에겐… 알지?%ハート()%"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞에이미에게 옛 연인이 있었다는 이야기는 들었었다/＞어쩌면 이 제복은 그 남자의 물건일지도 모른다/＞하지만 지금의 우리에겐 아무래도 상관없는 일이다…"
								ダンジョンフラグ:31:6 = 90
							ELSE
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , CALLNAME:MASTER + " 씨! 잠깐만요!/저기요, 그 제복 좀 더 자세히 보여줘요!/"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞에이미는 남자가 무어라 말하기도 전에/＞그 손에서 제복을 낚아채어 살펴보고 있다……/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "어이어이, 아가씨/남의 가게 상품을 그렇게 다루면 안 되지/그대로 들고 튀는 것도 사절……"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , "역시!/이거, 타츠야 거야!!/"
								IF FINDCHARA_B([[キャラ:아야토]], 0) == 2
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞뒤에서 상황을 지켜보던 카츠라기에 따르면/＞에이미의 연인 이름은 하야사카 타츠야라고 하며, 카츠라기의 절친이기도 한 모양이다/＞역시 펜타그라마에서 탈출할 때 떨어져 버렸다고 한다"
									;原作ではその前、都庁襲撃時にはぐれていますが拙作ＭＯＤではペンタグランマが都庁を突破できてないのでこうなりました
								ELSE
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞하야사카 타츠야/＞이전에 에이미에게 들었던, 그녀의 연인 이름이다/＞펜타그라마에서 탈출할 때 헤어졌다고 들었는데"
								ENDIF
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞듣고 보니 하야사카라는 이름이 옷깃에 자수되어 있다/＞…어째서 그 남자가 입고 있던 제복이 여기에 있는 걸까?/＞에이미는 이미 남자에게 달려들고 있다…"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , "이 제복 어디서 구한 거야!?//"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "…그건 좀 말해줄 수 없겠는데…//"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞아무래도 이 남자, 공짜로는 입을 열 생각이 없는 것 같다/＞에이미도 연인인 하야사카의 행방을 알아낼 때까지 물러날 생각이 없어 보인다/＞자, 어떻게 해 줄까…" 
								CALL INPUT_YN_D , "돈을 낸다" , "무기를 뽑는다"
								IF RESULT == 0
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞실랑이하는 것도 귀찮다/＞500마카 정도 쥐여주면 충분하겠지/"
									IF MONEY :1 < 500
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞…라고 생각했지만, 마카가 부족했다//"
									ELSE
										;CALL SHOW_PICTURE, "D"
										CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "돈을 아무리 준대도 말할 생각 없어/이래 봬도 일에 대한 긍지란 게 있어서 말이야/"
									ENDIF
								ENDIF
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞…말씨름에 어울려줄 생각은 없다/＞이렇게 된 이상 이 남자에게 조금 따끔한 맛을 보여주기로 하자/"
								IF FINDCHARA_B([[キャラ:아야토]], 0) == 2
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞하지만 " + CALLNAME:MASTER + "이(가) 무언가를 하기 전에/＞카츠라기가 남자의 목덜미에 무기를 들이댔다…/"
								ELSE
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞그렇게 생각한 " + CALLNAME:MASTER + "은(는)/＞무기를 뽑아 남자의 목덜미에 들이댔다/"
								ENDIF
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "겍!! 그, 그런 짓을 해봤자 헛수고라고/난 절대로 안 불 거야!/"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞그렇다면 여기서 시체가 될 뿐이다/＞전투 경험을 쌓아온 우리를 이길 수 있다고 한다면 별개지만…/"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞다행히 이 거리는 악마들의 거리다/＞너 하나쯤 죽어서 뒷골목에 던져지면 5분 만에 사라진다/"
								CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "……아, 알았어 말할게 말할게요!/그러니까 그거 빨리 좀 치워줘!!/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , "…말귀를 잘 알아들어서 다행이네//" 
								;ここからオリジナルチックに展開します
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "그건 노, 노숙자한테 산 거야/깨끗한 옷이라고 해서/"
								CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "실제로 아직 깨끗한 상태였고… 비싸게 팔 수 있을 줄 알았단 말이야//" 
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , "그래…/그 사람은 어떤 행색이었지/"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞에이미는 노숙자의 인상착의를 캐물었다/＞다행히랄까 당연하게도, 노숙자는 하야사카가 아니었던 모양이다/"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , "그 남자가 타츠야의 행방을 알고 있을지도 몰라…/" + CALLNAME:MASTER + " 씨, 가요!!/그이도 데빌 버스터예요, 분명 힘이 되어 줄 거예요!"
								IF FINDCHARA_B([[キャラ:아야토]], 0) == 2
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞과연 에이미는 영리하게도 하야사카를 찾는 것이 우리의 이익이 된다고 주장하고 있다/＞카츠라기도 이미 오랜 친구의 발자취를 쫓을 생각인 듯하다/＞명색이 의뢰주인 이상 카츠라기가 하야사카를 찾는다면 우리도 찾지 않을 수 없겠지…" 
								ELSE
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞과연 에이미는 영리하게도 하야사카를 찾는 것이 우리의 이익이 된다고 주장하고 있다/＞실제로 우리 입장에서도 카츠라기의 의뢰를 맡은 이상 찾고 싶은 상대이긴 하다/＞찾아낸다면 카츠라기에게서 추가 보너스를 받는 정도는 가능하겠지"
								ENDIF
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞공포에 떠는 남자를 무시하고, " + CALLNAME:MASTER + " 일행은 노숙자를 찾아보기로 했다…//"
								CALL DUNGEON_WORP, 1, 38, 10
							ENDIF
						ELSEIF ダンジョンフラグ:31:6 == 1
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "히익!/그, 그러니까 옷이 어디서 났는지는 그 노숙자 녀석한테 물어봐!/나, 난 그 이상은 모른단 말이야!"
							CALL DUNGEON_WORP, 1, 38, 10
						ELSEIF ダンジョンフラグ:31:6 >= 2
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "히익!/소, 손님으로 온 건가…/"
							$CLOTHS_31_2
							CALL INPUT_SELECT_D, "무, 뭔가 살 텐가?//[1]산다/[2]스테이터스를 본다///[0]밖으로 나간다" , , , 2
							IF RESULT == 1
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "무, 뭘 사려고?//"
								;非売品の実用外防具を販売
								LOCALS =
								LOCALS += "교복,10,"
								LOCALS += "수트,20,"
								LOCALS += "사립송례관학원교복,10,"
								LOCALS += "서바이벌베스트,15,"
								LOCALS += "레더부츠,5,"
								CALL DUNGEON_SHOPS, 1, LOCALS
							ELSEIF RESULT == 2
								CALL SHOP_COM_301
							ELSE
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "심장에 안 좋으니까 가급적… 아니, 아무것도 아니야//"
								CALL DUNGEON_WORP, 1, 38, 10
								RETURN 1
							ENDIF
							GOTO CLOTHS_31_2
						ELSE
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "히히히 어서 와/우리 가게 물건은 손때가 묻긴 했어도 확실하다고/"
							$CLOTHS_31
							CALL INPUT_SELECT_D, "뭔가 살 텐가?//[1]산다/[2]스테이터스를 본다///[0]밖으로 나간다" , , , 2
							IF RESULT == 1
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "뭘 사주려고?//"
								;非売品の実用外防具を販売
								LOCALS =
								LOCALS += "교복,10,"
								LOCALS += "수트,20,"
								LOCALS += "사립송례관학원교복,10,"
								LOCALS += "서바이벌베스트,15,"
								LOCALS += "레더부츠,5,"
								CALL DUNGEON_SHOPS, 1, LOCALS
							ELSEIF RESULT == 2
								CALL SHOP_COM_301
							ELSE
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "12_古着屋", , "구제옷 가게 점원" , "고마워, 또 와라구//" 
								CALL DUNGEON_WORP, 1, 38, 10
								RETURN 1
							ENDIF
							GOTO CLOTHS_31
						ENDIF
					CASE 42
						;プチデモショップs
						IF ダンジョンフラグ:31:6 == 13 && FINDCHARA_B([[キャラ:에미]], 0) == 2
							CHARA = RESULT:1
							CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남자 점주", @"쁘띠데모 숍에 어서 오렴♪//"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞염소 같은 뿔이 난 건장한 남자가 인사를 건네왔다…//"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"저기, 당신이 가게 주인인가요?/얼마 전에 남자가 여기에 팔려왔다고 들었는데, 당신 알고 있지!?/"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남자 점주", @"갑자기 뭐야!/그야 우리 집엔 별의별 사람이 다 오지만, 사람을 팔거나 하진 않아!/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞건장한 점주는 그렇게 주장하고 있다/＞물론 에이미는 납득하지 못하는 모양이다/"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"똑똑히 이야기를 듣고 왔다고!/원한다면 힘으로라도…!/"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남자 점주", @"일단 나도 이런 가게를 꾸려갈 힘 정도는 있단다/덤벼보렴, 계집애야!/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…쓸데없는 다툼은 하고 싶지 않다/＞그렇게 생각한 당신의 뇌리에 번뜩 떠오르는 것이 있었다/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞이곳은 어쩌면 악마를 매매하고 있는 것이 아닐까?//"
							CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남자 점주", @"그래, 맞아/악마는 인간이 아닌걸/얼마든지 팔지"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그리고 이곳은 인간에게 악마의 힘을 부여하는 시설/＞설마 여기서…/"
							CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남자 점주", @"아아, 그러고 보니 얼마 전에 남자를 개조해 줬었지/그 후에 뒷골목 가게에 넘겼는데/이름은 좀 기억이 안 나네"
							CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남자 점주", @"맞은편 호텔 악마가/노숙자한테서 손에 넣었다고 말하길래/의지할 곳 하나 없는 인간인 줄 알았지 뭐야"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞틀림없이 하야사카다/＞하지만 개조해서 뒷골목 가게에 넘겼다니…/"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"설마…/당신, 타츠야를 악마로 만든 거야!?/"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남자 점주", @"미안하게 됐네/아무리 나라도 연고가 있다는 걸 알았으면 그런 짓은 안 했을 텐데/그냥 노숙자 치고는 미남이라고 생각했거든"
							CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남자 점주", @"어떤 개조를 했는가에 대해서는…/미안하지만 본인을 직접 보렴/내가 해줄 수 있는 말은 그것뿐이야"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"타츠야에게 몹쓸 짓을 했다면 내가 당신을 가만두지 않을 테니까…!//"
							SIF FINDCHARA_B([[キャラ:아야토]], 0) == 2
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞완전히 머리끝까지 화가 난 에이미를 카츠라기가 필사적으로 말리고 있다…//"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞어쨌든 하야사카의 행방은 알게 되었다/＞어서 하야사카를 데리러 가기로 할까…/"
							ダンジョンフラグ:31:6 = 14
						ELSEIF ダンジョンフラグ:31:6 == 14
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "32_男店主", , "남자 점주", @"정말이지, 그러니까 아까부터 몇 번이나 말했잖아/그 무슨 씨라는 사람은 뒷골목 가게에 넘겨줬다고/물론 우리 집에서 확실하게 개조해서 말이지만"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞어떤 개조를 당했는지는 그다지 알고 싶지 않지만/＞어쨌든 살아는 있는 모양이다/＞가게인지 뭔지에서 쓴다는 걸 보면 건강하긴 하겠지만…" 
						ELSE
							CALL PETIT_DEMON_31
						ENDIF
						CALL DUNGEON_WORP, 1, 42, 10
					CASE 44
						CALL MESSAGE_WINDOW_D_ICON, , "48_ホストの男", , "호스트 남자" , "북쪽에 커다란 건물이 보이지?/얼마 전에 저기 들어가 봤는데 말이야/"
						CALL MESSAGE_WINDOW_D_ICON, , "48_ホストの男", , "호스트 남자" , "안에 기계에 묶여있는 남자가 있었어/그것만 해도 이상하잖아? 병원도 아닌데/게다가 그 주변에 괴물 놈들이 떼거지로 있었다고!"
						CALL MESSAGE_WINDOW_D_ICON, , "48_ホストの男", , "호스트 남자" , "도대체 어떻게 된 거야 이 거리는…/전에는 이런 곳이 아니었다고…?!/"
					CASE 46
						IF イベントフラグ:70:0 <= 5
							CALL MESSAGE_WINDOW_D_ICON, , "14_悪魔2", , "악마", @"어이, 인간!/여기는 이포스 님의 거처다/멋대로 기어들어 오지 마라!"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞문 너머에서 악마들의 기척이 엄청나게 느껴진다/＞일도 아닌데 여기에 돌입할 용기는 없다…/"
						ELSE
							CALL MESSAGE_WINDOW_D_ICON, , "14_悪魔2", , "악마", @"어이, 인간!/이포스 님이 당해버려서 지금 바쁘단 말이다/살려줄 테니 꺼져라!"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞문 안쪽에서 고성과 비명이 계속 들려오고 있다/＞양동도 없이 여기에 돌입할 용기는 없다…/"
						ENDIF
						CALL DUNGEON_WORP, 1, 46, 10
					CASEELSE
				ENDSELECT
			CASE 2
				SELECTCASE FLAG:현Y
					CASE 1
						;エロレストラン、食器持ち込みＯＫ、女体盛りや乳盃、おっぱいミルクティーやそれらの合わせ技を楽しめる
						CALL RESTRANT31_BASE
					CASE 2
						;早坂イベントのホームレス
						IF ダンジョンフラグ:31:6 == 0 || ダンジョンフラグ:31:6 >= 80 || FINDCHARA_B([[キャラ:에미]], 0) != 2
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞빌딩 그늘에 노숙자들이 무리 지어 있다…"
						ELSEIF ダンジョンフラグ:31:6 == 1 || ダンジョンフラグ:31:6 == 11
							CHARA = GETCHARA([[キャラ:에미]])
							ダンジョンフラグ:31:6 += 1
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞빌딩 그늘에 노숙자들이 무리 지어 있다…/＞이 중에 하야사카의 제복을 구제옷 가게에 팔아넘긴 남자가 있을까?/＞에이미도 필사적으로 찾고 있다…"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , "…있어, 아마 저 남자야/주변 사람들에게 술을 쏘고 있잖아/아마 타츠야의 제복으로 돈을 손에 넣은 게 분명해…!"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , "내가 일단 말을 걸어볼 테니까/" + CALLNAME:MASTER + " 군은 도망갈 길을 막아줘/놓쳐줄 생각은 없지만…" 
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞에이미는 악마를 쳐다보는 듯한 눈빛으로 한 남자를 노려보고 있다/＞과연, 확실히 노숙자 치고는 씀씀이가 좋아 보인다/＞임시 수입을 얻은 것은 틀림없으리라…" 
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞" + CALLNAME:MASTER + "이(가) 슬그머니 골목 입구를 막아선 것을 확인하고/＞에이미는 노숙자에게 다가갔다…/"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , "저기, 당신/하야사카 타츠야라는 이름, 들어본 기억 없어?/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞그 이름을 들은 노숙자 남자는 단번에 안색이 창백해졌다/＞다른 노숙자들은 영문을 모르겠다는 표정으로 두 사람을 바라보고 있다/"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "45_ホームレス", , "노숙자" , "아, 아니…/모르겠는데, 그런 남…/"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , "대답해/안 그러면 당신은 악마 밥이 될 거야/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞에이미는 어느새 악마를 소환하여/＞노숙자 남자를 포위하고 있다…/"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , "그래, 대답 안 하겠다 이거지/그럼…/"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "45_ホームレス", , "노숙자" , "알았어!/말할게! 뭐든지 말할게!/아니, 말하게 해 주세요!"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , "그럼 묻겠는데/당신, 타츠야를 어디로 보냈어?/"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "45_ホームレス", , "노숙자" , "아, 저기…/대로변에 있는 호텔에 팔았습니다…/"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , "호텔!?/왜 그런 곳에서 인간을 사는데!?/"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "45_ホームレス", , "노숙자" , "거긴 MAG라고 하던가?/그걸 악마가 먹기 위해 인간 남자가 필요하다면서…/특히 강해 보이는 녀석들을 모으고 있더라고"
							CALL MESSAGE_WINDOW_D_ICON, , "45_ホームレス", , "노숙자" , "만신창이가 된 남자가 얼마 전에 이쪽으로 와서 말이야/무슨 일로 지쳐서 자고 있었던 것 같았는데/그 남자가 입고 있던 옷이 데빌 버스터인가 뭔가 하는 놈들 거잖아?"
							CALL MESSAGE_WINDOW_D_ICON, , "45_ホームレス", , "노숙자" , "틀림없이 강한 놈이겠거니 생각해서 그대로 호텔에 팔러 갔지/그랬더니 5000마카나 주더라고, 게다가 옷은 가져가래서/그래서 그 옷을 이번엔 구제옷 가게에 팔았더니 2000마카가 돼서…" 
							SIF ダンジョンフラグ:31:6 == 12
								CALL MESSAGE_WINDOW_D_ICON, , "45_ホームレス", , "노숙자" , "하지만 그건 이미 한참 전 이야기야/또 딴 데로 넘겨졌을지도 모른다고/"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미" , "알았어, 대로변의 호텔이네!/가요, " + CALLNAME:MASTER + " 군!/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞에이미는 벌써 하야사카라는 남자를 찾아낸 양 들떠 있다/＞뭐, 우리로서도 찾아서 손해 볼 건 없다/＞대로변의 호텔로 향하기로 할까…" 
						ELSEIF ダンジョンフラグ:31:6 < 11 && ダンジョンフラグ:31:6 > 1
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "45_ホームレス", , "노숙자" , "몇 번이나 말하게 하지 마!/그 남자는 대로변 호텔에 팔았단 말이야!/"
						ELSE
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "45_ホームレス", , "노숙자" , "몇 번이나 말하게 하지 마!/그 남자는 대로변 호텔에 팔았단 말이야!/게다가 이미 지난 이야기라, 또 딴 데로 넘겨졌을지도 모른다니까!"
						ENDIF
					CASE 3
						;怪しい香売り、(購入回数＋１)×３０００マッカで香を売る(つまり、３回まではお得)
						N = (ダンジョンフラグ:31:24 + 1) * 3000
						IF ダンジョンフラグ:31:24 == 0
							IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "거기 멋진 오빠/잠깐 이야기 좀 듣고 가/"
								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "이야, 운이 좋네 오빠/지금 엄청나게 좋은 향이 들어왔거든/맡기만 해도 몸속에서 힘이 솟아나!"
								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "그런 대단한 향이, 지금이라면! 무려! 단돈 " + TOSTR(N) + "마카에!//"
							ELSE
								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "거기 귀여운 아가씨/잠깐 이야기 좀 듣고 가/"
								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "이야, 운이 좋네 아가씨/지금 엄청나게 좋은 향이 들어왔거든/맡기만 해도 몸속에서 힘이 솟아나!"
								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "그런 대단한 향이, 지금이라면! 무려! 단돈 " + TOSTR(N) + "마카에!//"
							ENDIF
							CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "물론, 살 거지?//"
							CALL INPUT_YN_D , "산다" , "사지 않는다"
							IF RESULT == 0
								IF MONEY:1 < (ダンジョンフラグ:31:24 + 1) * 3000
									;CALL SHOW_PICTURE, "D"
									IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
										CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "정말이지, 오빠/마카가 부족하잖아!/"
									ELSE
										CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "정말이지, 아가씨/마카가 부족하잖아!/"
									ENDIF
									RETURN 0
								ENDIF
								MONEY:1 -= (ダンジョンフラグ:31:24 + 1) * 3000
								;CALL SHOW_PICTURE, "D"
								IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
									CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "그럼 자, 오빠/한 대 피우고, 기분 좋아져 보라고/"
								ELSE
									CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "그럼 자, 아가씨/한 대 피우고, 기분 좋아져 보라고/"
								ENDIF
								K = RAND:6
								SELECTCASE K
									CASE 0
										CALL GET_ITEM, 1010, 1
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "힘의향을 손에 넣었다//"
									CASE 1
										CALL GET_ITEM, 1011, 1
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "지혜의향을 손에 넣었다//"
									CASE 2
										CALL GET_ITEM, 1012, 1
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "마력의향을 손에 넣었다//"
									CASE 3
										CALL GET_ITEM, 1013, 1
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "내구의향을 손에 넣었다//"
									CASE 4
										CALL GET_ITEM, 1014, 1
