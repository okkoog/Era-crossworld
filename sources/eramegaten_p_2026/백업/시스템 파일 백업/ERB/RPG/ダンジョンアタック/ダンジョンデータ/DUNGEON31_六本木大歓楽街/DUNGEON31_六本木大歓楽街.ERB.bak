							LOCAL:1 = 0
							LOCAL:2 = 0
							FOR LOCAL, 1, 7
								IF POS(LOCAL) > -1 && ABL:POS(LOCAL):종족 == 12 && LOCAL:2 != 2
									LOCAL:1 = LOCAL
									LOCAL:2 = 1
								ELSEIF POS(LOCAL) > -1 && TALENT:POS(LOCAL):기계의처녀
									LOCAL:1 = LOCAL
									LOCAL:2 = 2
								ENDIF
