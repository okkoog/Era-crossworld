									CALL MESSAGE_WINDOW_D_ICON, , "46_眼鏡の男", , "안경 쓴 남자", @"라비라면 15000마카야/메시아교라는 곳에서 전도를 위해 T95 골렘을 개조했다나 봐/레벨은 35, 지온가와 마한마, 연속 사격도 하지"
									IF MONEY:1 < 15000
										CALL MESSAGE_WINDOW_D_ICON, , "46_眼鏡の男", , "안경 쓴 남자", @"손님, 마카가 부족해//"
									ELSE
										CALL MESSAGE_WINDOW_D_ICON, , "46_眼鏡の男", , "안경 쓴 남자", @"손님, 요 녀석을 살 텐가？//"
										CALL INPUT_YN_D , "산다" , "다른 것으로 한다"
										IF RESULT == 0
											CALL MESSAGE_WINDOW_D_ICON, , "46_眼鏡の男", , "안경 쓴 남자", @"네, 매번 감사함다~//"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "는 파란 장갑에 네 다리가 달린 듯한/＞머신　라비　를 손에 넣었다/"
												;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…그 순간, 갑자기 라비의 상부에서 입체 영상이 방사되었다/＞메시아교 도사의 모습을 비추고 있는 듯하다…/"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "라비", @"…마스터 등록 완료/마스터… 오늘도… 신의 가르침을 전하기 위해… 행동 개시…/신께서는… 언제나 우리를 지켜보고 계시며…"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞라비는 다짜고짜 설화를 시작했다…//"
											IF ABL:MASTER:속성LC != 1
												CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…이건 참 시끄러울 것 같은 기계다/＞전도를 위해 개조했다는 말을 좀 더 귀담아들었어야 했다…/"
											ELSE
												CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…갑자기 말을 꺼내 당황하긴 했으나 의외로 흥미로울 것 같은 이야기를 하고 있다/＞다음에 시간을 내서 들어볼까…/"
											ENDIF
											CALL ADD_NEW_COMPANION, [[キャラ:라비]], 0
											CFLAG:(RESULT:1):소속ＣＯＭＰ = -1
											MONEY:1 -= 15000
										ELSE
											GOTO PART_LOOP_1
										ENDIF
									ENDIF
								CASE 4
									;CALL SHOW_PICTURE, "D"
									CALL MESSAGE_WINDOW_D_ICON, , "46_眼鏡の男", , "안경 쓴 남자", @"메두사라면 20000마카야, 악마랑 헷갈리지 말라구/메시아교라는 곳에서 새로 만들었다나 봐/레벨은 40, 파이어 브레스에 미들 숏, 소닉 펀치에 무드도 쓰지"
									IF MONEY:1 < 20000
