								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "으-음, 다음엔 언제 들어올지 모르는데 아깝네…//"
							ENDIF
						ELSEIF ダンジョンフラグ:31:25 == 1
							;CALL SHOW_PICTURE, "D"
							IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "미안해 오빠, 오늘은 이미 다 팔렸어/다음에 또 와/"
							ELSE
								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "미안해 아가씨, 오늘은 이미 다 팔렸어/다음에 또 와/"
							ENDIF
						ELSE
							;CALL SHOW_PICTURE, "D"
							IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "안녕 안녕 오빠, 또 만났네/오빠, 또 그 향 한 대 피우고 싶어진 거지?/다 알아, 그런 건"
								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "오늘은 이제 딱 하나밖에 안 남았으니까, 그러게나…/" + TOSTR(N) + "마카라면 팔아줄 수도 있어/"
							ELSE
								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "안녕 안녕 아가씨, 또 만났네/아가씨, 또 그 향 한 대 피우고 싶어진 거지?/다 알아, 그런 건"
								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "오늘은 이제 딱 하나밖에 안 남았으니까, 그러게나…/" + TOSTR(N) + "마카라면 팔아줄 수도 있어/"
							ENDIF
							CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "물론, 살 거지?//"
							CALL INPUT_YN_D , "산다" , "사지 않는다"
							IF RESULT == 0
								;CALL SHOW_PICTURE, "D"
								IF MONEY:1 < (ダンジョンフラグ:31:24 + 1) * 3000
									IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
										CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "정말이지, 오빠/마카가 부족하잖아!/"
									ELSE
										CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "정말이지, 아가씨/마카가 부족하잖아!/"
									ENDIF
									RETURN 0
								ENDIF
								MONEY:1 -= (ダンジョンフラグ:31:24 + 1) * 3000
								IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
									CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "그럼 자, 오빠/한 대 피우고, 기분 좋아져 보라고/"
								ELSE
									CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "그럼 자, 아가씨/한 대 피우고, 기분 좋아져 보라고/"
								ENDIF
								K = RAND:6
								SELECTCASE K
									CASE 0
										CALL GET_ITEM, 1010, 1
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "힘의향을 손에 넣었다//"
									CASE 1
										CALL GET_ITEM, 1011, 1
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "지혜의향을 손에 넣었다//"
									CASE 2
										CALL GET_ITEM, 1012, 1
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "마력의향을 손에 넣었다//"
									CASE 3
										CALL GET_ITEM, 1013, 1
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "내구의향을 손에 넣었다//"
									CASE 4
										CALL GET_ITEM, 1014, 1
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "속도의향을 손에 넣었다//"
									CASE 5
										CALL GET_ITEM, 1015, 1
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "운의향을 손에 넣었다//"
								ENDSELECT
								ダンジョンフラグ:31:24 += 1
								ダンジョンフラグ:31:25 = 1
							ELSE
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "35_怪しい香売り",  , "？" , "으-음, 다음엔 언제 들어올지 모르는데 아깝네…//"
							ENDIF
						ENDIF
					CASE 4
						;猫娘、葛城君を連れてくることで仲魔になる、但しダンジョンからは脱出
						IF FINDCHARA_B([[キャラ:아야토]], 0) == 2 && ダンジョンフラグ:31:23 < 2
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("猫娘"), D31_FACE("네코무스메"), , "네코무스메" , "！/거기 있는 건 카츠라기 군이네!/다행이다, 무사했구나…" 
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞뒷골목에서 갑자기 여자가 말을 걸어왔다/＞슬링샷 같은 옷과 고양이 귀가 특징적인 여자다…/＞아무래도 이른바 악마인인 모양이다"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞카츠라기도 그리운 친구를 만난 것처럼 이야기를 나누고 있다/＞아무래도 카츠라기의 펜타그라마 시절 친구인 것 같다/"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("猫娘"), D31_FACE("네코무스메"), , "네코무스메" , "와타나베가 악마로 바꿔치기당했다는 걸 알게 돼서/우리도 비밀기지에서 간신히 도망쳐 나왔어/지금 생각해 보면 그때 너희와 함께 도망쳤어야 했는데"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("猫娘"), D31_FACE("네코무스메"), , "네코무스메" , "펜타그라마에 줄곧 있었으니까 말야…/신주쿠에서 너희를 길잡이해 준 게 들통나서/지금은 악마들에게 쫓기는 몸이야"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞소문으로는 들었지만…/＞역시 펜타그라마 -대악마 자경 레지스탕스-는 괴멸한 모양이다…/＞수장을 잃은 데다 바꿔치기당하기까지 했다면 어찌할 도리가 없었겠지…" 
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("猫娘"), D31_FACE("네코무스메"), , "네코무스메" , "그런데 카츠라기 군, 그쪽 분은 누구야?/…/흐-음, 악마소환사이자 협력자…"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("猫娘"), D31_FACE("네코무스메"), , "네코무스메" , "처음 뵙겠어요/전 펜타그라마 소속의 악마인이에요/다들 멋대로 네코무스메라고 부르지만요"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("猫娘"), D31_FACE("네코무스메"), , "네코무스메" , "갑작스러워서 미안하지만/당신에게 부탁이 있어/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞? 갑자기 무슨 부탁일까//"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("猫娘"), D31_FACE("네코무스메"), , "네코무스메" , "나도 악마들에게 쫓기고 있다는 이야기는 했었지?/나도 카츠라기 군과 함께 당신의 신세를 져도 괜찮을까/물론, 내 힘도 빌려줄게"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞과연, 악마들로부터 숨겨달라는 뜻인가//"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞데려온 카츠라기도 이쪽에게 부디 부탁한다고 말하고 있다/＞의뢰인인 이상 이 정도는 서비스로 받아들여 줄까…/"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("猫娘"), D31_FACE("네코무스메"), , "네코무스메" , "고마워/우선 오늘은 당신네에서 신세를 져도 될까?/악마들에게서 벗어나 쉴 수 있는 장소가 필요해"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞…그렇게 하여, " + CALLNAME:MASTER + " 일행은 귀가 길에 올랐다…//"
							CALL ADD_NEW_COMPANION, [[キャラ:고양이소녀]], 100
							IF RESULT
								CHARA = RESULT:1
								CALLF SET_ALL_FACE_NEW, CHARA, GET_識別名(NO:CHARA) + "_" + D31_FACE("악마인", 1)
							ENDIF
							ダンジョンフラグ:31:23 = 3
							FLAG:탈출 = 1
						ELSEIF ダンジョンフラグ:31:23 == 0
							;初回
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞노출도 높은 옷을 입고 고양이 귀가 난 여자가 있다/＞아마도 악마인이리라/＞주변을 연신 신경 쓰고 있는 것 같다…"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("猫娘"), D31_FACE("네코무스메"), , "네코무스메" , "！/뭘 보고 있는 거야, 당신?/나도 이래 봬도 바쁘다고, 방해하지 말아 줘"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞여자는 뒷골목으로 사라졌다…//"
							ダンジョンフラグ:31:23 = 1
						ELSEIF ダンジョンフラグ:31:23 == 1
							;2回目以降
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞그 여자는 이제 없는 것 같다/＞하지만 모종의 기척은 느껴진다/＞어쩌면 이쪽의 동태를 살피고 있는 걸지도 모른다…"
						ELSE
							;もういない
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞이제 아무도 없다…//"
						ENDIF
					CASE 5
						;ＭＡＧ切れ悪魔人イベント、彼女はプチデモの産物という設定です(IMAGINEにもほぼ肉体が悪魔になってたネコマタもどきいましたよね、アレの感覚で一つ)
						IF ダンジョンフラグ:31:22 == 0
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞건물 그늘에 숨어 무언가가 꿈틀거리고 있다/＞조사해 보겠습니까?/"
							CALL INPUT_YN_D , "조사한다" , "그만둔다"
							IF RESULT == 0
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("六本木大歓楽街の悪魔人"), D31_FACE("악마인"),  , "？" , "하아… 하아…/MAG… MAG가 필요해…/사라지고 싶지 않아… 나 아직 사라지고 싶지 않은걸…" 
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞그곳에는 박쥐 날개가 돋아난 여자가 있었다/＞아무래도 MAG가 바닥난 악마가 발버둥 치고 있는 모양이다/＞위험할지도 모른다, 여긴 벗어나는 편이 좋을까…" 
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("六本木大歓楽街の悪魔人"), D31_FACE("악마인"),  , "？" , "…!/인간, 거기 있는 건 인간이지!?/당신한테 원한은 없지만, 내게 먹혀줘야겠어!"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞들키고 말았다…/＞상대는 필사적이다, 이제 와서 도망칠 순 없겠지/＞싸울 수밖에 없나…"
								FLAG:도주불가플래그 = 1
								FLAG:회화불능플래그 = 1
								FLAG:선제기습취소 = 1
								CALL SET_ENEMY, 9, [[キャラ:롯본기대환락가의악마인]], 15, 0, 0
								CALL BATTLE_START
								FLAG:도주불가플래그 = 0
								FLAG:회화불능플래그 = 0
								FLAG:선제기습취소 = 0
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("六本木大歓楽街の悪魔人"), D31_FACE("악마인"),  , "？" , "으으… 싫어… 사라져 없어지는 건 싫어…/나… 인간인데…/악마인 채로 사라지는 건 싫단 말이야…"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞어떻게든 격퇴했다, 하지만…/＞이 녀석, 무슨 악마지? COMP로 조사해 봐도 전혀 모르겠다…/＞본인의 말대로라면 인간이라는데… 설마!"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("六本木大歓楽街の悪魔人"), D31_FACE("악마인"), , "악마인 여성" , "이런 꼴이 될 줄 알았다면…/쁘띠데모 숍 따위 가지 말걸 그랬어…/왜… 악마 따위가 되려고…" 
								IF ダンジョンフラグ:31:8 == 0
									IF ABL:MASTER:종족 == 73
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞역시 자신과 같은 악마인인가…/＞하지만 이 여자는 아무래도 자업자득인 것 같지만/"
									ELSE
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞아무래도 이 여자, 악마인인 모양이다/＞이야기를 들어보니 자업자득인 것 같지만/"
									ENDIF
								ELSE
									IF ABL:MASTER:종족 == 73
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞역시 자신과 같은 악마인인가…/＞애초에 쁘띠데모 숍 따위에 가서 자신을 개조한 것이다/＞그 정도의 위험 부담은 당연하겠지"
									ELSE
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞아무래도 이 여자, 악마인인 모양이다/＞애초에 쁘띠데모 숍 따위에 가서 자신을 개조한 것이다/＞그 정도의 위험 부담은 당연하겠지"
									ENDIF
								ENDIF
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞하지만 등의 날개나 풍만한 몸매로 보아 음마를 본뜬 모양인데/＞그 덕분인지 꽤나 보기 좋다/＞노예로 삼아준다면 이 여자도 목숨을 건지고, 서로 득이 되지 않을까…?"
								CALL INPUT_YN_D , "노예로 삼는다" , "그만둔다"
								IF RESULT == 0
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞뜻밖의 횡재일지도 모른다. 눈앞의 소재를 꼼꼼히 뜯어본다….//"
									CALL INPUT_YN_D , "외견과 달리 순진한 것 같지만" , "음마의 몸매에 홀린 호색한 놈"
									IF RESULT == 0
										ダンジョンフラグ:31:61 = 1
									ENDIF
									ダンジョンフラグ:31:22 = 1
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞이제 발버둥 칠 힘조차 없는 악마인에게 다가가…/＞옷을 벗겨냈다!/"
									;CALL SHOW_PICTURE, "D"
									CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("六本木大歓楽街の悪魔人"), D31_FACE("악마인"), , "악마인 여성" , "…!/당신, 나한테 무슨 짓을 하려는 거야!?/"
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞그 물음에 대답하지 않고, " + CALLNAME:MASTER + "은(는) 능숙하게 조교를 시작하기로 했다…//"
									CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("六本木大歓楽街の悪魔人"), D31_FACE("악마인"), , "악마인 여성" , "자, 잠깐 그만둬!?/싫어, 그만둬!/"
									IF ダンジョンフラグ:31:61 == 0
										CALL ADD_NEW_COMPANION, [[キャラ:롯본기대환락가의악마인]], 100, 1
									ELSE
										CALL ADD_NEW_COMPANION, [[キャラ:롯본기대환락가의악마인]], 100
									ENDIF
									IF RESULT
										CHARA = RESULT:1
										CALL SET_TALENT_PARTY_JOINABLE, CHARA, "参加可能"
										CALLF SET_ALL_FACE_NEW, CHARA, GET_識別名(NO:CHARA) + "_" + D31_FACE("악마인", 1)
										TARGET = CHARA
										FLAG:던전내조교 = 1
									ENDIF
									ダンジョンフラグ:31:22 = 1
									FLAG:탈출 = 1
								ELSE
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞…생각해 보면 이 여자가 어찌 되든 알 바 아니다/＞그렇게 생각한 " + CALLNAME:MASTER + "은(는) 자리를 떴다…/"
									ダンジョンフラグ:31:22 = 2
								ENDIF
							ENDIF
						ELSEIF ダンジョンフラグ:31:22 == 1
							;犯した
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞이제 아무도 없다…//"
						ELSEIF ダンジョンフラグ:31:22 == 2
							;犯してないがまだいる
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("六本木大歓楽街の悪魔人"), D31_FACE("악마인"), , "악마인 여성" , "아아… 으…/우욱…/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞이 여자의 신체는 점차 붕괴되어 가고 있다/＞지금 손을 쓰지 않으면 슬라임이라도 되어버릴 것이다/＞데려가서 고쳐주는 것도 나쁘진 않겠지만…"
							CALL INPUT_YN_D , "노예로 삼는다" , "그만둔다"
							IF RESULT == 0
								ダンジョンフラグ:31:22 = 1
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞이제 발버둥 칠 힘조차 없는 악마인에게 다가가…/＞옷을 벗겨냈다!/"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("六本木大歓楽街の悪魔人"), D31_FACE("악마인"), , "악마인 여성" , "！/당신, 나한테 무슨 짓을 하려는 거야!?/"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞그 물음에 답하지 않고, " + CALLNAME:MASTER + "은(는) 능숙하게 조교를 시작하며 데려가기로 했다…//"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("六本木大歓楽街の悪魔人"), D31_FACE("악마인"), , "악마인 여성" , "자, 잠깐 그만둬!?/싫어, 그만둬!/"
								CALL ADD_NEW_COMPANION, [[キャラ:롯본기대환락가의악마인]], 100
								IF RESULT
									CHARA = RESULT:1
									CALLF SET_ALL_FACE_NEW, CHARA, GET_識別名(NO:CHARA) + D31_FACE("악마인", 1)
									TARGET = CHARA
									FLAG:던전내조교 = 1
								ENDIF
								FLAG:탈출 = 1
							ELSE
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞이 여자가 어떻게 되든 알 바 아니다/＞그렇게 생각한 " + CALLNAME:MASTER + "은(는) 자리를 떴다…/"
							ENDIF
						ELSE
							;スライムがいる
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "슬라임" , "주교조…/이제… 주교조…/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞슬라임이 웅크리고 있다/＞아마도 그 여자의 비참한 말로겠지…/"
						ENDIF
					CASE 7
						;酔っ払いが寝てる、マッカをくすねることができる
						IF ダンジョンフラグ:31:21 == 0
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞주정뱅이가 코를 골며 자고 있다…/＞주머니에서 지갑이 삐져나와 있다/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞지갑에서 돈을 빼내시겠습니까?//"
							CALL INPUT_YN_D , "빼낸다" , "깨워준다"
							IF RESULT == 0
								CALL INCREASE_LD, -5
								CALL INCREASE_LC, -25
								ダンジョンフラグ:31:21 = 1
								IF FLAG:전투난이도 == 1
									;EASYのときは500マッカ
									MONEY:1 += 500
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞" + CALLNAME:MASTER + "은(는) 지갑에서 500마카를 빼냈다……//"
								ELSE
									;それ以外は小銭＋なにか
									MONEY:1 += 3
									MONEY += 2000
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞" + CALLNAME:MASTER + "은(는) 지갑에서 2,000엔과 3마카를 빼냈다/＞겸사겸사 쥐고 있던 차크라 드롭도 챙겼다/"

									;チャクラドロップの最大所持数を見る
									CALL GET_ITEMMAX, GETNUM(ITEM, "챠크라드롭")
									IF ITEM:챠크라드롭 >= RESULT
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞차크라 드롭을 다 들 수 없어 " + CALLNAME:MASTER + "은(는) 그 자리에서 입에 털어 넣었다……"
										;あなたの最大MPが0でないなら回復処理（レアケースだし全回復してしまえ）
										SIF MAXBASE:MASTER:ＭＰ > 0
											CALL VAR_MP, MASTER, MAXBASE:MASTER:ＭＰ, "회복"
									ELSE
										ITEM:챠크라드롭 += 1
									ENDIF
								ENDIF
							ELSE
								ダンジョンフラグ:31:21 = 2
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞" + CALLNAME:MASTER + "은(는) 취객을 깨워주었다/＞취객은 실실 웃으며 큰길 쪽으로 사라졌다……/"
								CALL INCREASE_LD, 5
								CALL INCREASE_LC, 25
							ENDIF
						ELSE
							IF ダンジョンフラグ:31:21 == 1
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞여전히 주정뱅이가 자고 있다……//"
							ELSEIF ダンジョンフラグ:31:21 == 2
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞이런, 주정뱅이가 자고 있던 자리에 무언가 떨어져 있다……//"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞행복 티켓을 4장 손에 넣었다/＞모으면 정크숍에서 복권을 뽑을 수 있는 것 같다/＞자세한 건 가게 아저씨에게 물어보자……"
								ITEM:행복티켓 += 4
								ダンジョンフラグ:31:21 = 3
							ELSEIF ダンジョンフラグ:31:21 > 2
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞이제 아무것도 없다//"
							ENDIF
						ENDIF
					CASE 8
						;男の娘やＴＳ娘、ふたなり娘の娼館
						IF ダンジョンフラグ:31:6 == 14 && FINDCHARA_B([[キャラ:에미]], 0) == 2
							;悪魔人ハヤちゃん確保イベント
							ダンジョンフラグ:31:6 = 99
							CHARA = RESULT:1
							CALL MESSAGE_WINDOW_D_ICON, , "16_受付の男表", , "접객 남자", @"어서오십…//"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "목소리", @"놓아라, 이 악마 놈들아!/대체 남자인 나한테 뭘 시킬 셈이냐!/"
							CALL MESSAGE_WINDOW_D_ICON, , "16_受付の男表", , "접객 남자", @"죄송합니다/지금 신입 녀석의 교육을 진행하려던 참이라/다소 소란스러울지도…" 
								;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"그 신입의 가족이야, 우린/타츠야를 지금 당장 돌려받을 수 있을까?/"
								;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "16_受付の男表", , "접객 남자", @"…!/그러십니까/그녀의 본명을 알고 계신 걸 보니 가족이 틀림없겠군요"
							CALL MESSAGE_WINDOW_D_ICON, , "16_受付の男表", , "접객 남자", @"저희로서도 가족이 있는 분이었을 줄은 꿈에도 모르고/대단히 험하게 다루었던 점 사과드립니다/곧 돌려드릴 테니 부디 용서해 주십시오…" 
								;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"…그래/우리로서도 타츠야를 돌려준다면/딱히 일을 크게 벌릴 생각은 없어"
								;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, , "16_受付の男表", , "접객 남자", @"그렇게 말씀해 주시니 저희로서도 다행입니다/그럼 데려올 테니 잠시만 기다려 주십시오/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇게 말하며 고개를 숙이는 접객 남자/＞우선 하야사카를 데려오게 하기로 했다/＞하지만, \"그녀\"라니 대체 설마…?"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
							CALL SHOW_PICTURE, "EMPTY"
							CALL MESSAGE_WINDOW_D_ICON, , "16_受付の男表", , "접객 남자", @"오래 기다리셨습니다/이쪽이 현재의 하야사카 타츠야 \"양\"입니다/"
								;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("早坂"), D31_FACE("TS早坂"), , "미소녀", @"………………미안해…/에이미………/"
								;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"………에?/타츠…… 야?/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞예상대로, " + CALLNAME:MASTER + " 일행의 앞에 실려 온 것은 미소녀였다/＞게다가 상당한 개조가 가해져 있다…/"
							;趣味ガン積みです
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞팔꿈치와 무릎 아래는 형태나 털가죽이나 완전히 육식수 그대로여서 다시는 COMP를 다룰 수 없으리라/＞고양이 귀와 꼬리를 보아하니 바스테트 계열을 이식받았는가/＞하지만 무엇보다 연인에게 지금 모습을 들킨 하야사카는 초췌해져 있었다"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("早坂"), D31_FACE("TS早坂"), , "하야사카", @"…저기, 에이미/가능하다면 이대로 날 잊어주지 않겠어/난 이제 가망이 없으니까, 적어도 에이미만이라도 행복하게…"
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"타츠야…//"
							IF TALENT:CHARA:음란 || TALENT:CHARA:창부
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"우후후, 완전히 귀여워져선/이번엔 내가 귀여워해 줄 차례네/"
								SIF TALENT:CHARA:후타나리
									CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"내가 타츠야를 범해줄게/그거, 기분 좋은걸%ハート()%/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("早坂"), D31_FACE("TS早坂"), , "하야사카", @"…에이미?/뭐야, 눈이 무서운데…?/앗, 잠깐만 그만"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
								CALL ADD_NEW_COMPANION, [[キャラ:하야사카]], 1500, 2
								SIF RESULT
									CALLF SET_ALL_FACE_NEW, CHARA, GET_識別名(NO:CHARA) + D31_FACE("TS_早坂", 1)
							ELSE
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"…저기, 타츠야는 자신을 이런 꼴로 만든 악마가 밉지 않아?/정말로 이대로 있어도 좋다고 생각해?/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("早坂"), D31_FACE("TS早坂"), , "하야사카", @"…밉지, 분하지/하지만 지금의 내가 뭘 할 수 있단 말이야…/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"적어도 난 지금 싸우고 있어/" + CALLNAME:MASTER + " 씨의 밑에서 다시 악마와 싸우고 있어/타츠야, 당신은 어때?"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"설령 COMP를 쓰지 못한다 해도 지금의 당신에겐 악마의 힘이 있어/그걸 가지고도 못 싸운다고 하는 건 비겁해/나도 맨몸인걸"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("早坂"), D31_FACE("TS早坂"), , "하야사카", @"에이미…//"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("早坂"), D31_FACE("TS早坂"), , "하야사카", @"…그렇구나/이 정도로 언제까지나 좌절하고 있으면/그야말로 남자 체면이 안 서겠지"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"그래, 그래야 타츠야답지!/이제야 좀 기운이 나나 보네/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("早坂"), D31_FACE("TS早坂"), , "하야사카", @"하하/솔직히 이런 꼴을 당하면 기운이 날 리가 없잖아/…고마워, 에이미"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"우후후, 이것도 연인의 역할이라는 거지/걱정 마/"
								;CALL SHOW_PICTURE, "D"
								SIF FINDCHARA_B([[キャラ:아야토]], 0) == 2
									CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("早坂"), D31_FACE("TS早坂"), , "하야사카", @"카츠라기에게도 걱정을 끼쳤네/미안했다/"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("早坂"), D31_FACE("TS早坂"), , "하야사카", @"그럼, " + CALLNAME:MASTER + " 씨라고 부르면 되려나/염치없지만, 나도 당신 밑에서 싸우게 해 주었으면 해/안 될까?"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞물론 상관없다/＞전 데빌 버스터 실력자는 부디 영입하고 싶다/"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("早坂"), D31_FACE("TS早坂"), , "하야사카", @"그렇다면…/악마, 하야사카 타츠야/금일부로 동료마가 된다. 잘 부탁하지"
								CALL ADD_NEW_COMPANION, [[キャラ:하야사카]], 1500, 1
								SIF RESULT
									CALLF SET_ALL_FACE_NEW, CHARA, GET_識別名(NO:CHARA) + D31_FACE("TS_早坂", 1)
							ENDIF
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞전 데빌 버스터 악마인 하야사카 타츠야가 동료로 들어왔다//"
							FLAG:탈출 = 1
						ELSE
							;娼館用コード
							CALL SORP_BASE_31, 50
						ENDIF
					CASE 10
						;闇悪魔バイヤー
						IF ダンジョンフラグ:31:20 > 1
							IF (FINDCHARA_B([[キャラ:체페이_꼬리두개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리세개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리네개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리다섯개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리여섯개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리일곱개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리여덣개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리아홉개]], 1) == 2)
								CHARA = RESULT:1
								IF ダンジョンフラグ:31:30 == 0
									IF TALENT:CHARA:3 || TALENT:CHARA:6
										CALL MESSAGE_WINDOW_ICON, CHARA, "キャラ登録番号", , "체페이" , "으으…/소첩이 멘탈이 강하다고 해도/역시 여기엔 좋은 추억이 없다고…"
										CALL MESSAGE_WINDOW_ICON, CHARA, "キャラ登録番号", , "체페이" , "저기, 이런 데서 노는 거 말고 말야/돌아가서 소첩이랑 놀지 않을래?/그 편이 주인님의 욕망, 채워줄 수 있다고?"
										IF TALENT:CHARA:유아체형
											IF TALENT:CHARA:거유 || TALENT:CHARA:폭유 || TALENT:CHARA:마유
												CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞체페이는 역시 여기에 있고 싶지 않은지, " + CALLNAME:MASTER + "의 팔을 잡아끌며 이곳에서 벗어나려 하고 있다/＞몸에 어울리지 않는 거대한 쌍봉이 팔에 눌려 기분 좋다/＞하지만 추억이 없다고 해도 우리들이 만난 곳은 여기인데…?"
											ELSE
