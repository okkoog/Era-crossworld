										;CALL SHOW_PICTURE, "D"
										IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "핫핫핫, 오늘은 기분이 좋다구! 그래, 겸사겸사다/너, 악마 부를 수 있지?/내가 계약해 주마, 감사히 여겨라!"
										ELSE
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "핫핫핫, 오늘은 기분이 좋다구!/그나저나 너, 잘 보니까 꽤 괜찮은 여자잖아…/"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "좋아 결심했다!/내가 너와 계약해 주지! 감사히 여기라고!/"
