								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "그러니까 키 큰 나로 정해져 있다니까//"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞자, 아니나 다를까 이런 질문에 대답해야 할 처지가 되었다…/＞술에 취해 있는 걸 보니 엉뚱한 대답을 했다간 큰일 나겠지…/"
								CALL INPUT_SELECT_D , "＞어떻게 대답할까?//[1]역시 훤칠한 키가 최고/[2]근육 최고입니다/[3]귀여운 남자아이가 좋지/[4]이런 일로 다투는 시점에서…/[5]모두 매력적이라 정할 수 없다" , , , 2
								FLAG:도주불가플래그 = 1
								FLAG:회화불능플래그 = 1
								FLAG:선제기습취소 = 1
								SELECTCASE RESULT
									CASE 1
										;CALL SHOW_PICTURE, "D"
										CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "핫핫핫, 역시 이 몸께서 제일 남자다운 거야!//"
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞트로울은 그야말로 콧대가 하늘을 찌르는 모습이다/＞하지만 남은 두 마리는…/"
										;CALL SHOW_PICTURE, "D"
