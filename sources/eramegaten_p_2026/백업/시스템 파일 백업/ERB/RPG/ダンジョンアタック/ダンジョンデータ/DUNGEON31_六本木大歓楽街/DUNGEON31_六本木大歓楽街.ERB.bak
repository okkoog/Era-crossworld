								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"저기 당신, 여기에 최근 끌려온 남자가 있지/그 사람이 어디 있는지 알고 있겠지!?/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"최근… 최근…/아아, 있었습니다 있었습니다/하지만…" 
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"하지만이라니 뭐야!?/타츠야는 여기에 있는 거잖아!?/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"아니요, 그는 이미 없습니다/아까도 말씀드렸듯이 이곳은 악마가 MAG를 얻기 위한 호텔입니다/"
								CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"하지만 그는 몇 번이나 기기를 조정해도, 에이미라는 여성의 이름만을 중얼거릴 뿐/일체의 MAG를 제공하지 않았습니다/"
								CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"MAG를 제공하지 않는 그를 데리고 있는 건 저희로서도 무의미했기 때문에…//"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"타츠야에게 무슨 짓을 한 거야!?/설마…/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"아니요, 그저 쁘띠데모 숍에 넘겼을 뿐입니다/바로 맞은편의 저 가게입니다/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"쁘띠데모 숍…/DB 시절 소문으로 들은 적은 있었지만, 실제로 존재하고 있었다니…/"
								IF ダンジョンフラグ:31:8 == 0
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞쁘띠데모란 대체 무엇일까…//"
									CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"쁘띠 데모나이즈드라고 한대요/악마의 힘을 인간인 채로 받아들인다든가 해서, 패션 감각으로 하는 사람도 있다던가/어디까지나 DB의 소문으로 들었을 뿐이지만요…" 
								ELSE
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞쁘띠데모 숍의 존재는 알고 있었지만/＞예상대로랄까, 상당히 비합법적인 행위에도 손을 대는 모양이다…/"
