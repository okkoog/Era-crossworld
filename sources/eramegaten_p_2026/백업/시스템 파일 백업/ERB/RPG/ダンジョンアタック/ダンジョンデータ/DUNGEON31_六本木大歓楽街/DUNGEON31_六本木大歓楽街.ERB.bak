							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞남자 몇 명이 주변 사람들에게 말을 걸고 있다…/＞저 복장은… 템플 나이트인가？/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "템플 나이트", @"실례합니다/요즘 이 근처에서 법의를 입은 여성을 보지 못하셨습니까？/이곳으로 온 이후의 행방이 묘연하여 그렇습니다"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거의 틀림없이 " + CALLNAME:MASTER + "가 납치한 여자일 것이다/＞모른다고 해두자…/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "템플 나이트", @"그렇습니까, 감사합니다/혹시 뭔가 떠오르시거나 들으신 게 있다면 부디 알려주십시오/"
							ダンジョンフラグ:31:3 = 3
						ELSEIF ダンジョンフラグ:31:3 == 3
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞템플 나이트들이 탐문을 벌이고 있다…//"
						ENDIF
					CASE 12
