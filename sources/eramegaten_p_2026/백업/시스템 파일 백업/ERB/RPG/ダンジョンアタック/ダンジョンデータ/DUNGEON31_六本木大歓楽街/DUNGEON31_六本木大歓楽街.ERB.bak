									ELSE
										CALL MESSAGE_WINDOW_D_ICON, , "46_眼鏡の男", , "안경 쓴 남자", @"손님, 요 녀석을 살 텐가？//"
										CALL INPUT_YN_D , "산다" , "다른 것으로 한다"
										IF RESULT == 0
											CALL MESSAGE_WINDOW_D_ICON, , "46_眼鏡の男", , "안경 쓴 남자", @"네, 매번 감사함다~//"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "는 붉은 장갑에 네 다리가 달리고 위에 공기놀이 구슬을 띄운 듯한/＞머신　메두사　를 손에 넣었다/"
											;CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞きっとソルディオス・オービットってこんなやつだろう//"
