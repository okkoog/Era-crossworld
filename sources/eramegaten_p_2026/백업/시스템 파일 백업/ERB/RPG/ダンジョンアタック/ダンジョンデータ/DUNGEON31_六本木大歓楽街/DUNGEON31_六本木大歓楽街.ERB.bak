								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", "NONFLOORD/セーフハウス", "에이미", @"타츠야…… 타츠야아………/다행이야… 깨어나 줘서 정말 다행이야……/"
								SIF FINDCHARA_B([[キャラ:아야토]], 0) >= 1
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "NONFLOORD/セーフハウス", "", @"＞카츠라기도 무사히 눈을 뜬 하야사카를 보며 감개무량한 표정이다/＞하야사카는 카츠라기의 절친이기도 하니, 눈물도 흘릴 만하다…/"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "NONFLOORD/セーフハウス", "", @"＞잠이 덜 깬 듯한 모습의 하야사카에게 에이미 일행의 현 상황을 전했다…//"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("早坂"), D31_FACE("早坂"), "NONFLOORD/セーフハウス", "하야사카", @"그랬군… 당신한테 다들 신세를 많이 진 모양이네/답례라고 하긴 뭐하지만, 나도 당신 밑에서 싸우게 해 주지 않겠어?/이래 봬도 전직 데빌 버스터야. 조금은 도움이 될 수 있을 거라 생각해"
								IF FINDCHARA_B([[キャラ:아야토]], 0) >= 1
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "NONFLOORD/セーフハウス", "", @"＞물론 고마운 일이다/＞하지만 먼저 에이미나 카츠라기 일행과 밀린 이야기라도 나누고 오도록 하자/"
								ELSE
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "NONFLOORD/セーフハウス", "", @"＞물론 고마운 일이다/＞하지만 먼저 에이미와 밀린 이야기라도 나누고 오도록 하자/"
								ENDIF
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("早坂"), D31_FACE("早坂"), "NONFLOORD/セーフハウス", "하야사카", @"그렇네, 그렇게 할게/…나를, 모두를 구해줘서 정말 고마워/"
								;CALL SHOW_PICTURE, "D"
								IF FINDCHARA_B([[キャラ:아야토]], 0) >= 1
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "NONFLOORD/セーフハウス", "", @"＞하야사카, 에이미, 카츠라기 세 사람은 밤새 이야기를 나눈 듯하다/＞세 사람의 눈에는 눈물이 글썽이고 있었다…/"
								ELSE
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "NONFLOORD/セーフハウス", "", @"＞하야사카와 에이미는 밤새 이야기를 나눈 듯하다/＞두 사람의 눈에는 눈물이 글썽이고 있었다…/"
								ENDIF
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "NONFLOORD/セーフハウス", "", @"＞데빌 버스터 하야사카 타츠야가 동료로 들어왔다//"
								CALL ADD_NEW_COMPANION, [[キャラ:하야사카]], 1500
								IF RESULT
									CALL SET_TALENT_PARTY_JOINABLE, (RESULT:1), "신용"
									CALLF SET_ALL_FACE_NEW, RESULT:1, "早坂" + "_" + D31_FACE("早坂", 1)
