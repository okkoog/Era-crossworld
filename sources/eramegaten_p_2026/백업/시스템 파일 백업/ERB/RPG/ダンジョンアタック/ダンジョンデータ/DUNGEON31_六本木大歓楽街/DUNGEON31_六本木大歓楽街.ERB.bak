								;伽耶ちゃん
									IF TEQUIP:POS(NUMBER):111 > 6
										CALL MESSAGE_WINDOW_D_ICON, POS(NUMBER), , "キャラ登録番号", "카야", @"이러면… 치마 속이 다 보이나요?/솔직히 부끄러운데요…" 
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞카야는 꼬리가 치마를 들어 올리는 것이 걱정되는 모양이다/＞" + CALLNAME:MASTER + "은(는) 우선 그 수줍어하는 표정이 주된 목적이라고 대답했다…"
										CALL MESSAGE_WINDOW_D_ICON, POS(NUMBER), , "キャラ登録番号", "카야", @"엣… 그, 그렇다면 다행이지만요/…그래도 역시 부끄럽네요/가능하면 둘만 있을 때 외에는 바지 같은 걸 입는 게…"
									ELSE
										CALL MESSAGE_WINDOW_D_ICON, POS(NUMBER), , "キャラ登録番号", "카야", @"예전에 읽었던 만화 주인공이 떠오르네요/이렇게 보름달을 보면 크아앙 하고 원숭이가 되는 거요"
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞카야는 꼬리와 달을 번갈아 보며 인간 시절에 읽었던 만화 이야기를 하고 있다/＞같은 이름의 악마가 분명 있었지…"
										CALL MESSAGE_WINDOW_D_ICON, POS(NUMBER), , "キャラ登録番号", "카야", @"하지만 그것과 달리 균형이 달라졌는데도 제대로 걸을 수 있어요/히라사와 선생님이 제대로 조정해 주신 거겠죠"
										;ええ、ドラゴン○ールです
									ENDIF
								CASE 4700
								;ラビリス
									IF TALENT:POS(NUMBER):3 || TALENT:POS(NUMBER):6
										IF !TEQUIP:POS(NUMBER):속옷（하） && !TEQUIP:POS(NUMBER):전신속옷 && TEQUIP:POS(NUMBER):111 > 6
											CALL MESSAGE_WINDOW_D_ICON, POS(NUMBER), , "キャラ登録番号", "라비리스", @"니도 참 기괴한 짓을 한데이-/정말이지 내 치마가 다 뒤집혀 버리잖아!/뭐? 안 입었으니께 괜찮지 않냐고?!"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞라비리스는 자신의 치마를 필사적으로 붙잡고 가랑이를 가리려 하고 있다/＞팬티를 입으면 될 텐데…"
										ELSEIF TEQUIP:POS(NUMBER):111 > 6
											CALL MESSAGE_WINDOW_D_ICON, POS(NUMBER), , "キャラ登録番号", "라비리스", @"니도 참 기괴한 짓을 한데이-/정말이지 내 치마가 다 뒤집혀 버리잖아!/옛날엔 안 입지 않았냐고? 그, 그래도 부끄러운 건 부끄러운 기다…" 
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞라비리스는 치마를 필사적으로 붙잡으며 속옷을 가리려 하고 있다/＞예전엔 홀딱 벗고 덤벼들었으면서…"
										ELSE
											CALL MESSAGE_WINDOW_D_ICON, POS(NUMBER), , "キャラ登録番号", "라비리스", @"니도 참 기괴한 짓을 한데이-/정말이지 지금까지 입던 옷을 못 입게 돼뿌렸잖아!/내 홀딱 드러내놓고 댕기는 건 싫데이!"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞라비리스는 옷을 못 입게 된 것에 불평을 늘어놓고 있다/＞자매기는 알몸으로 싸우는 모양이지만…"
										ENDIF
									ELSEIF TALENT:POS(NUMBER):4 || TALENT:POS(NUMBER):7
										CALL MESSAGE_WINDOW_D_ICON, POS(NUMBER), , "キャラ登録番号", "라비리스", @"니도 참 기괴한 짓을 한데이-/그치만 이거 잘 구부리면 자위에 쓸 수 있을 것 같네%ハート()%"
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞라비리스는 얻어낸 꼬리를 구불구불 흔들고 있다/＞지금부터 구부리는 법을 익히려는 모양이다"
									ELSEIF TALENT:POS(NUMBER):5 || TALENT:POS(NUMBER):8
									ELSE
									;多分、本来ならないはず
									ENDIF
								CASEELSE
							ENDSELECT
						ENDIF
						CSTR:POS(NUMBER):48 = 現在は平沢博士の改造により臀部に機械仕掛けの尾を取り付けられている。
						CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"흠, 문제가 없는 것 같아 다행이군/자, 달리 내가 도울 일이 더 있나?"
						GOTO HIRA_LOOP
					ELSE
						GOTO HIRA_LOOP_3
					ENDIF
				CASE 4
					;耳：犬、猫、牛(角付き)、狐、ウサギの4種
					IF TALENT:POS(NUMBER):꼬리 == 1
						CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"보아하니 그 기체엔 이미 동물의 귀가 달려있는 것 같은데/귀의 종류를 바꾸고 싶다는 겐가"
						CALL INPUT_YN_D
						SIF RESULT == 1
							GOTO HIRA_LOOP_3
						CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"흠, 알겠네. 그거라면 맡아주지/그렇다고 해도 파츠 교환일 뿐이니 요금을 크게 받을 생각은 없네"
					ELSEIF TALENT:POS(NUMBER):기계의처녀 || TALENT:POS(NUMBER):인간화
						CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"…흠, 동물의 귀를 단다, 라/요즘의 유행이라는 것이었던가/이것에 대해서도 경험은 충분히 있다네"
					ELSE
						CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"………/그저 기계에 동물의 귀를 다는 건 드문 일이군…/뭐… 인간형에서 쌓은 경험이 있으니 문제될 건 없네"
					ENDIF
					IF (ダンジョンフラグ:31:5 == 6 || ダンジョンフラグ:31:5 == 4)
						CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"1000마카만 받는다면 해낼 수 있는 일이네"
					ELSE
						CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"2000마카만 받는다면 해낼 수 있는 일이네"
					ENDIF

					CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", CALLNAME:(POS(NUMBER)) + "에게 동물의 귀를 달아도 괜찮겠나?"
					CALL INPUT_YN_D
					IF RESULT == 0
						IF (ダンジョンフラグ:31:5 == 6 || ダンジョンフラグ:31:5 == 4) && MONEY:1 < 1000
							CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"…흠, 유감이지만 마카가 부족한 것 같군/아무리 자네의 부탁이라 해도 이 이상 깎아줄 순 없네/미안하지만 다음 기회로 미뤄주게"
							GOTO HIRA_LOOP_3
						ELSEIF MONEY:1 < 2000
							CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"흠, 마카가 부족한가…/공교롭게도 나는 내 기술을 헐값에 팔 생각은 없어서 말일세"
							GOTO HIRA_LOOP_3
						ENDIF
						IF (ダンジョンフラグ:31:5 == 6 || ダンジョンフラグ:31:5 == 4)
							MONEY:1 -= 1000
						ELSE
							MONEY:1 -= 2000
						ENDIF
						CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"아아, 작업 전에 하나 확인할 것이 있었군/어떤 동물의 귀로 할지 선택해 주게나"
						CALL INPUT_SELECT_D , "무슨 귀로 할까?//[1]개/[2]고양이/[3]여우/[4]소(뿔 포함)/[5]토끼" , , , 2
						B = RESULT
						SELECTCASE B
							CASE 1
								CSTR:POS(NUMBER):49 = 現在は平沢博士の改造により頭部に犬の耳を取り付けられている。
							CASE 2
								CSTR:POS(NUMBER):49 = 現在は平沢博士の改造により頭部に猫の耳を取り付けられている。
							CASE 3
								CSTR:POS(NUMBER):49 = 現在は平沢博士の改造により頭部に狐の耳を取り付けられている。
							CASE 4
