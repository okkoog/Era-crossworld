										CALL ADD_NEW_COMPANION, [[キャラ:트롤]], 500, 1, , , MIN(BASE:MASTER:LV, CSVBASE([[キャラ:트롤]], GETNUM(BASE, "LV")))
										SIF RESULT
											CALLF SET_ALL_FACE_NEW, CHARANUM-1, "トロール_" + D31_FACE("トロール", 1)
										ダンジョンフラグ:31:7 = 1
									CASE 2
										;CALL SHOW_PICTURE, "D"
										CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "흠, 아니나 다를까 예상했던 결과로구나/뭐, 이 몸이 최고라는 뜻이지/알아들었느냐, 네놈들?"
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞드베르그는 그야말로 콧대가 하늘을 찌르는 모습이다/＞하지만 남은 두 마리는…/"
										;CALL SHOW_PICTURE, "D"
										IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "으-음, 역시 인간 남자는 나한테 질투해 버리는 걸까?/그럼 안녕, 형씨/사랑을 얻는 건 어렵다고 생각하라구?"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "흥, 나의 이 훤칠한 키의 매력을 모를 줄이야/망할 녀석, 체인질링이나 조심하라고/네놈 자식이 언제까지고 진짜배기라는 법은 없다구?"
										ELSE
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "으-음, 역시 인간은 나한테 질투해 버리는 걸까?/그럼 안녕, 누님/사랑을 얻는 건 어렵다고 생각하라구?"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "흥, 나의 이 훤칠한 키의 매력을 모를 줄이야/망할 년, 체인질링이나 조심하라고/네년 자식이 언제까지고 진짜배기라는 법은 없다구?"
										ENDIF
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞다행히 다소 짜증을 내는 정도에 그쳤다/＞두 마리는 그대로 어딘가로 떠나갔다…/"
										;CALL SHOW_PICTURE, "D"
										IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "자, 지금 이 몸은 기분이 좋구나. 네놈, 악마소환사지?/모처럼이니, 이 몸이 이 근육 파워를 가지고 네놈을 도와주마/뭐야, 사양할 것 없다"
										ELSE
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "그런데 아가씨, 그대는 이 몸이 매력적이라고 생각하는 게지?/이것도 무언가의 인연, 이 몸이 계약해 주마/"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "그대 보아하니 악마를 부를 수 있는 모양이군/뭐야, 사양할 것 없느니라. 젊은이를 돕는 것도 노인의 몫이지/그럼 앞으로도 잘 부탁한다, 그래"
										ENDIF
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "드베르그는 그렇게 말하더니 COMP로 쑥 들어가 버렸다…/＞요정 드베르그가 동료마가 되었다/"
										CALL ADD_NEW_COMPANION, [[キャラ:드베르가]], 500, 1, , , MIN(BASE:MASTER:LV, CSVBASE([[キャラ:드베르가]], GETNUM(BASE, "LV")))
										SIF RESULT
											CALLF SET_ALL_FACE_NEW, CHARANUM-1, "ドヴェルガー_" + D31_FACE("ドヴェルガー", 1)
										ダンジョンフラグ:31:7 = 1
									CASE 3
										;CALL SHOW_PICTURE, "D"
										CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "훗후-흥! 봐, 내가 말했잖아?/내가 가장 「멋진 남자」라구!/"
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞큐피드는 그야말로 콧대가 하늘을 찌르는 모습이다/＞사실 이쪽으로선 귀여움으로 고른 거라 딱히 그런 건 아니지만/＞하지만 남은 두 마리는…" 
										;CALL SHOW_PICTURE, "D"
										IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "으음, 이 몸의 근육미를 몰라보다니…/대장장이는 되지 않기를 권하노라/"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "흥, 나의 이 훤칠한 키의 매력을 모를 줄이야/망할 녀석, 체인질링이나 조심하라고/네놈 자식이 언제까지고 진짜배기라는 법은 없다구?"
										ELSE
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "으음, 이 몸의 근육미를 몰라보다니…/대장장이는 되지 않기를 권하노라/"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "흥, 나의 이 훤칠한 키의 매력을 모를 줄이야/망할 년, 체인질링이나 조심하라고/네년 자식이 언제까지고 진짜배기라는 법은 없다구?"
										ENDIF
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞다행히 다소 짜증을 내는 정도에 그쳤다/＞두 마리는 그대로 어딘가로 떠나갔다…/"
										;CALL SHOW_PICTURE, "D"
										IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "아, 형씨한테도 뭔가 답례를 해야겠네/…그래! 모처럼이니 형씨와 계약해 줄게/형씨, 우리 악마들 제대로 부를 수 있지?"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "큐피드는 그렇게 말하더니 COMP로 쑥 들어가 버렸다…/＞천사 큐피드가 동료마가 되었다/"
										ELSE
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "그나저나 귀여운 누님이네/저기 누님, 나 누님이 마음에 쏙 들었어/"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "응, 괜찮지?"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞그렇게 말하며 이쪽을 향한 큐피드의 미소는…/＞너무나도 숭고하게 느껴져서…/＞아아… 행복해…"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞…정신을 차리고 보니 큐피드는 COMP에 들어가 있었다/＞천사 큐피드가 동료마가 되었다/"
										ENDIF
										CALL ADD_NEW_COMPANION, [[キャラ:큐피도]], 500, 2, , , MIN(BASE:MASTER:LV, CSVBASE([[キャラ:큐피도]], GETNUM(BASE, "LV")))
										SIF RESULT
											CALLF SET_ALL_FACE_NEW, CHARANUM-1, "キューピッド_" + D31_FACE("キューピッド", 1)
										ダンジョンフラグ:31:7 = 1
									CASE 4
										;CALL SHOW_PICTURE, "D"
										IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "빠-직!/엄청 무례한 형씨네!/"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "네놈, 용케도 지껄였구나…/하지만 당연히 그 소릴 듣고 우리가 가만히 있을 거라 생각하진 않겠지?/"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "하, 어차피 인간 수컷 따위한텐 악마의 매력을 모르는 건가!/게다가 그것도 모자라 이 몸을 모욕하다니!/그럼 뒈져라!"
										ELSE
											IF TALENT:MASTER:오토코노코
												CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "빠-직!/엄청 무례한 누님이네!/에, 나도 남자? 지금은 그런 게 문제가 아니야!"
											ELSE
												CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "빠-직!/엄청 무례한 누님이네!/"
											ENDIF
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "네놈, 용케도 지껄였구나…/하지만 당연히 그 소릴 듣고 우리가 가만히 있을 거라 생각하진 않겠지?/"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "하, 인간 암컷 따위한텐 악마의 매력을 모르는 건가!/게다가 그것도 모자라 이 몸을 모욕하다니!/그럼 뒈져라!"
										ENDIF
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞역시나 뚜껑이 열렸다…/＞적당히 혼쭐을 내서 진정시켜 주도록 하자…/"
										;EASYのときのみザコ
										;それ以外はLV30のボス3体として調整（ストーリー上・システム上の必然性のない大金なので、やや面倒に）
										IF FLAG:전투난이도 > 1
											CALL SET_ENEMY, 8, [[キャラ:큐피도]], 30, 0, 1
											ABL:(CHARANUM-1):스킬1 = [[스킬:메・디아라마]]
											ABL:(CHARANUM-1):스킬2 = [[스킬:마하코우하]]
											ABL:(CHARANUM-1):스킬4 = [[스킬:파이널누드]]
											CALL SET_ENEMY, 9, [[キャラ:드베르가]], 30, 0, 1
											ABL:(CHARANUM-1):스킬4 = [[스킬:마하・그라이바]]
											ABL:(CHARANUM-1):스킬5 = [[스킬:마하・마그나스]]
											ABL:(CHARANUM-1):스킬6 = [[스킬:대지의벽]]
											CALL SET_ENEMY, 10, [[キャラ:트롤]], 30, 0, 1
										ELSE
											CALL SET_ENEMY, 8, [[キャラ:큐피도]], 15, 0, 0
											;천사의스마일
											ABL:(CHARANUM-1):스킬4 = 1239
											CALL SET_ENEMY, 9, [[キャラ:드베르가]], 20, 0, 0
											BASE:(CHARANUM-1):힘 += 5
											CALL SET_ENEMY, 10, [[キャラ:트롤]], 20, 0, 0
											BASE:(CHARANUM-1):내구 += 5
										ENDIF
										CALL BATTLE_START
										;CALL SHOW_PICTURE, "D"
										IF TALENT:MASTER:남자
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "아야야야야!/좀 더 노인을 공경하지 못하겠느냐!/"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "으으… 너무한 인간이다아…/엄청나게 아프잖아아…/"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "알았어, 알았다고!/네가 최고의 남자다!/우린 쓰레기야! 술 취해서 인간을 죽이려 든 쓰레기다!"
										ELSE
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "아야야야야!/좀 더 노인을 공경하지 못하겠느냐!/"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "으으… 너무한 인간이다아…/엄청나게 아프잖아아…/"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "알았어, 알았다고!/우린 쓰레기야! 술 취해서 인간을 죽이려 든 쓰레기다!/"
										ENDIF
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞이제야 조용해졌다, 생각보다 만만찮았군…/＞하지만 이런 사람을 덮치는 악마를 방치하는 건 위험할지도 모른다/＞숨통을 끊어두어야 할까?"
										CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "그, 그만둬 줘! 나만이라도 죽이지 말아 줘!/도, 돈을 줄 테니까!/"
										;CALL SHOW_PICTURE, "D"
										CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "치사하구나 네놈!/나 또한 노인의 연금 파워를 보여주마!/"
										;CALL SHOW_PICTURE, "D"
										CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "나도 인간한테 뜯어… 양도받은 마카가 있다구!//"
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞…아무래도 시선에 살기가 서려 있었던 모양이다/＞악마들은 저마다 돈을 꺼내놓았다/"
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞…뭐, 반성하고 있는 것 같으니 눈감아 주기로 할까/＞다만 이 마카는 챙겨가겠지만/"
										;CALL SHOW_PICTURE, "D"
										CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "오오, 봐줘서 고맙다구!/그럼 우린 돌아간다!/이젠 민간인한테 손 안 댈게!"
										;CALL SHOW_PICTURE, "D"
										CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "나도 집에 가서 잘래…/흉터라도 남으면 싫구…/"
										;CALL SHOW_PICTURE, "D"
										CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "미안하게 되었구나, 자네/자, 나도 돌아가서 몸조리나 해야겠구먼/"
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞악마들은 각자 떠나갔다/＞세 악마에게서 도합 500마카를 얻었다/"
										MONEY:1 += 500
										ダンジョンフラグ:31:7 = 1
									CASE 5
										IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
											ダンジョンフラグ:31:7 = 1
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞대답은 했지만/＞주변에 감도는 공기가 지극히 무겁다/악마들은 한결같이 책망하는 시선을 이쪽으로 보내고 있다"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "흥, 우유부단한 녀석이군/가자고, 니들도 적어도 이놈보단 위야/이런 녀석 보고 있자니 기분 잡치네"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , "진짜라니까!/어쩌다 마주친 인간이 이렇게 쓸모없다니, 우리 운도 지지리 없네/아-아, 진짜 술 다 깨버렸네, 돌아갈까"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "정말이지 요새 젊은 것들은 남이 물어볼 때 취해야 할 태도도 모르는구나!/멋대로 해라, 우리는 갈 테니!/"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞악마들은 " + CALLNAME:MASTER + "을(를) 모욕하며 돌아갔다…//"
										ELSE
											ダンジョンフラグ:31:7 = 2
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞그렇게 대답하자 자리의 분위기가 일변했다/＞하지만 밝아졌다기보다는 어딘가 호색한 눈빛으로 이쪽을 보고 있는 듯한…?!/"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "케케케/그렇단 말이지, 아가씨는 우리들이 매력적이라고 생각하는가/"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , @"그런가-/그렇게나 우리가 매력적인 거네%ハート()%/"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "우히히/아가씨 같은 젊은 처자를 보니 피가 끓어오르는구나/"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞!/＞어느새 포위되어 있다, 설마…//"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("トロール"), D31_FACE("트로울"),  , "트로울" , "자-아 그럼, 잠깐 부탁 좀 하자고//"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("드베르그"), D31_FACE("드베르그"), , "드베르그" , "네놈의 기술은 이럴 때 아주 잘 먹히니까 말이지//"
											;CALL SHOW_PICTURE, "D"
											CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("큐피드"), D31_FACE("큐피드"), , "큐피드" , @"응, 맡겨둬!/그럼 누님, 이쪽 봐줘%ハート()%/"
											;天使のスマイルです
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞그 말을 듣고 돌아본 곳에는,/＞너무나도 사랑스러운 큐피드가 이쪽을 향해 최고의 미소를…/＞아아… 이런 멋진 미소를 볼 수 있다니… 행복해…" 
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
											CALL SHOW_PICTURE, "EMPTY"
											CALL SHOW_PICTURE, "NONFLOORD"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞%CALLNAME:MASTER%은(는) 악마들에게 윤간당했습니다//"
											;처녀
											IF TALENT:MASTER:재생처녀 || TALENT:MASTER:처녀
												PRINTFORML \@ TALENT:MASTER:처녀 ? 처녀 # 재생처녀 \@상실
												;PRINTL 처녀상실
												TALENT:MASTER:처녀 = 0
												TALENT:MASTER:재생처녀 = 0
												CALL ADDS_ABNORMAL_EXP("処女喪失（輪姦）", MASTER)
												;PRINTL 이상경험 + 1
												;EXP:MASTER:이상경험 += 1
											ENDIF
											IF TALENT:MASTER:오토코노코
												PRINTL Ａ경험 + 90
												EXP:MASTER:Ａ경험 += 90
											ELSE
												PRINTL Ｖ경험 + 60
												EXP:MASTER:Ｖ경험 += 60
												PRINTL Ａ경험 + 30
												EXP:MASTER:Ａ경험 += 30
											ENDIF
											PRINTL 절정경험 + 15
											EXP:MASTER:절정경험 += 15
											PRINTL 성교경험 + 15
											EXP:MASTER:성교경험 += 15
											IF TALENT:MASTER:오토코노코 == 0
												PRINTL 질사경험 + 10
												EXP:MASTER:질사경험 += 10
											ENDIF
											PRINTL 정액경험 + 30
											EXP:MASTER:정액경험 += 30
											PRINTL 봉사쾌락경험 + 120
											EXP:MASTER:봉사쾌락경험 += 120
											IF TALENT:MASTER:오토코노코
												PRINTL 펠라경험 + 45
												EXP:MASTER:펠라경험 += 45
											ELSE
												PRINTL 펠라경험 + 30
												EXP:MASTER:펠라경험 += 30
											ENDIF
											PRINTL 고통쾌락경험 + 45
											EXP:MASTER:고통쾌락경험 += 45
											;Ｖ,Ａ확장경험
											IF EXP:MASTER:Ｖ확장경험 == 0 && EXP:MASTER:Ａ확장경험 == 0
												CALL ADDS_ABNORMAL_EXP("拡張初体験", MASTER)
												;EXP:MASTER:50 += 1
												;PRINTL 이상경험＋１
											ENDIF
											IF TALENT:MASTER:오토코노코
												PRINTL Ａ확장경험 + 30
												EXP:MASTER:Ａ확장경험 += 30
											ELSE
												PRINTL Ｖ확장경험 + 15
												EXP:MASTER:Ｖ확장경험 += 15
												PRINTL Ａ확장경험 + 15
												EXP:MASTER:Ａ확장경험 += 15
											ENDIF
											PRINTL
											PRINTW
											IF PREGNANCY_ABLE(MASTER)
												K = RAND:3
												IF K == 0
												;トロール
													PRINTFORMW %CALLNAME:MASTER%(은)는 누군가에게 【임신】당했다
													;CALL PREGNANCY_CHECK, MASTER, 4
													;CALL SET_FATHERINFO, MASTER, 564, -1, "誰か"
													CALL SET_FETUS_STATUS, LOCAL, -1, [[キャラ:트롤]], "誰か"
													CALL CHANGE_N_STATUS, MASTER
													;TALENT:MASTER:임신 = 1
												ELSEIF K == 1
												;キューピッド
													PRINTFORMW %CALLNAME:MASTER%(은)는 누군가에게 【임신】당했다
													;CALL PREGNANCY_CHECK, MASTER, 4
													;CALL SET_FATHERINFO, MASTER, 362, -1, "誰か"
													CALL SET_FETUS_STATUS, LOCAL, -1, [[キャラ:큐피도]], "誰か"
													CALL CHANGE_N_STATUS, MASTER
													;TALENT:MASTER:임신 = 1
												ELSE
												;ドヴェルガー
													PRINTFORMW %CALLNAME:MASTER%(은)는 누군가에게 【임신】당했다
													CALL SET_FETUS_STATUS, LOCAL, -1, [[キャラ:드베르가]], "誰か"
													;CALL PREGNANCY_CHECK, MASTER, 4
													;CALL SET_FATHERINFO, MASTER, 554, -1, "誰か"
													CALL CHANGE_N_STATUS, MASTER
													TALENT:MASTER:임신 = 1
												ENDIF
											ENDIF
											CALL SHOW_PICTURE, "EMPTY"
											CALL SHOW_PICTURE, "NONFLOORD"
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "", "", @"＞%CALLNAME:MASTER%이(가) 눈을 뜨자, 주변은 새하얗게 물들어 있었다…/＞아무래도 자신은 악마에게 세뇌되어, 윤간당한 모양이다…/＞………지쳐버렸다, 오늘은 일단 돌아갈까…"
											CALL SHOW_ABNORMAL_EXP , MASTER, 1
											FLAG:도주불가플래그 = 0
											FLAG:회화불능플래그 = 0
											FLAG:선제기습취소 = 0
											ダンジョンフラグ:31:7 = 2
											FLAG:탈출 = 1
										ENDIF
								ENDSELECT
								FLAG:도주불가플래그 = 0
								FLAG:회화불능플래그 = 0
								FLAG:선제기습취소 = 0
							CASE 1
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞악마들은 이제 없다…//"
							CASE 2
								IF (FINDCHARA_B([[キャラ:체페이_꼬리두개]],1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리세개]],1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리네개]],1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리다섯개]],1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리여섯개]],1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리일곱개]],1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리여덣개]],1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리아홉개]],1) == 2)
									CHARA = RESULT:1
									CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "체페이" , "어머나/소환사도 가끔은 거꾸로 욕망에 집어삼켜질 때가 있네/뭐, 그게 욕망이란 것의 본질이지!"
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞아무래도 체페이는 여기서 있었던 일을 알고 있는 모양이다…//"
								ELSE
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "" , "＞악마들은 이제 없다…/＞솔직히 여기서의 일은 그다지 떠올리고 싶지 않다…/"
								ENDIF
						ENDSELECT
					CASE 14
						CALL MESSAGE_WINDOW_D_ICON, , "39_身なりの汚い男", , "행색이 초라한 남자" , "나… 나… 유령을 봐버렸어…/저기… 저기 벽을 빠져나가서 사라져 버렸다고…/무서워서… 무서워서… 더는 못 움직이겠어…"
				ENDSELECT
		ENDSELECT
		RETURN 1
;========================
;그외
;========================
	CASE 9
		SELECTCASE FLAG:현M
			CASE 0
				IF FLAG:현Y == 0
					CALL DUNGEON_WORP, 1, FLAG:현X, 12
				ELSE
				ENDIF
			CASE 1
				IF FLAG:현Y == 13
					CALL DUNGEON_WORP, 0, FLAG:현X, 1
				ELSE
					CALL DUNGEON_WORP, 2, 15, 15
				ENDIF
			CASE 2
				CALL DUNGEON_WORP, 1, 24, 1
		RETURN 1
		ENDSELECT
ENDSELECT
RETURN 0

;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_31
	FLAG:인카운트율 = FLAG:미조우걸음수 / 100
;繁華街なので戦闘はめったにないです、あっても893の皆さんに絡まれるくらい

;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_31
IF FLAG:현M == 2 || FLAG:현M == 3
	RETURN 0
ELSEIF RAND:100 < FLAG:인카운트율
	RETURN 1
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF

;=======================================================================
;敵の種族の種類数
;=======================================================================
@CLASS_NUM_31
IF RAND:3 == 0
	RETURN 2
ELSE
	RETURN 1
ENDIF
;=======================================================================
;敵の総数
;=======================================================================
@ENEMY_NUM_31, ARG
RETURN ENEMY_NUM_COMMON("初級", ARG)
;=======================================================================
;敵の種類
;=======================================================================
@ENEMY_31, ARG
IF RAND:2 == 0
	RETURN [[キャラ:바알병]], 3
ELSE
	RETURN [[キャラ:야쿠자]], 4
ENDIF

;=======================================================================
;平沢の研究所
;=======================================================================
@HIRA_31
#DIM NUMBER, 1

$HIRA_LOOP
CALL INPUT_SELECT_D , "무얼 하겠나?//[1]스테이터스 강화/[2]파츠 추가/[3]설명을 듣는다/[0]그만둔다" , , , 2
SELECTCASE RESULT
	CASE 0
		CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"그런가, 또 만날 수 있기를 빌지"
	CASE 1
		CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"흠, 그럼 어느 기계를 강화하겠나"
		$HIRA_LOOP_1
		RESULTS = どの機械を強化しますか？
		RESULTS += "//"
		LOCAL:1 = 1
		FOR LOCAL, 1, 7
			IF POS(LOCAL) > -1 && ABL:POS(LOCAL):종족 == 12 && LOCAL:2 != 2
				RESULTS += "[" + TOSTR(LOCAL) + "]" + CALLNAME:(POS(LOCAL)) + "/"
			ELSEIF POS(LOCAL) > -1 && TALENT:POS(LOCAL):기계의처녀 && (ダンジョンフラグ:31:5 == 6 || ダンジョンフラグ:31:5 == 4)
				RESULTS += "[" + TOSTR(LOCAL) + "]" + CALLNAME:(POS(LOCAL)) + "/"
			ENDIF
		NEXT
		RESULTS += "[0]やめる"
		CALL INPUT_SELECT_D , RESULTS , , , 2
		SIF RESULT == 0
			GOTO HIRA_LOOP
		NUMBER = RESULT
		IF ダンジョンフラグ:31:5 == 6 || ダンジョンフラグ:31:5 == 4
			IF NO:MASTER == NO:POS(NUMBER)
				CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"과연, 자네는 자기 자신을 강화하겠다는 건가?/그렇다면 25000마카에 맡아주지"
			ELSE
				CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"과연, 자네는 " + CALLNAME:(POS(NUMBER)) + "을(를) 강화하겠다는 건가?/그렇다면 25000마카에 맡아주지"
			ENDIF
		ELSE
			IF NO:MASTER == NO:POS(NUMBER)
				CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"과연, 자네는 자기 자신을 강화하겠다는 건가?/그렇다면 50000마카에 맡아주지"
			ELSE
				CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"과연, 자네는 " + CALLNAME:(POS(NUMBER)) + "을(를) 강화하겠다는 건가?/그렇다면 50000마카에 맡아주지"
			ENDIF
		ENDIF
		CALL INPUT_YN_D
		IF RESULT == 0
			IF (ダンジョンフラグ:31:5 == 6 || ダンジョンフラグ:31:5 == 4)
				IF MONEY:1 < 25000
					CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"…흠, 유감이지만 마카가 부족한 것 같군/아무리 자네의 부탁이라 해도 이 이상 깎아줄 순 없네/미안하지만 다음 기회로 미뤄주게"
					GOTO HIRA_LOOP
				ELSE
					MONEY:1 -= 25000
				ENDIF
			ELSE
				IF MONEY:1 < 50000
					CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"흠, 마카가 부족한가…/공교롭게도 나는 내 기술을 헐값에 팔 생각은 없어서 말일세"
					GOTO HIRA_LOOP
				ELSE
					MONEY:1 -= 50000
				ENDIF
			ENDIF
			IF NO:MASTER == NO:POS(NUMBER)
				CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"그럼 강화해 보지, 이쪽으로 오게나"
			ELSE
				CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"그럼 강화해 보지, 잠시 기다려 주게나"
			ENDIF
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
			B = 0
			FOR LOCAL, 1, BASESTATUSNUM
				LOCALS = %GET_BASESTATUS(LOCAL)%
				A = RAND:100
				IF A < 10
					A:LOCAL = 0
				ELSEIF A < 80
					A:LOCAL = 1
					B++
				ELSE
					A:LOCAL = 2
					B += 2
				ENDIF
				BASE:POS(NUMBER):LOCALS += A:LOCAL
			NEXT
			CALL SYNC_STATUS, POS(NUMBER)
			IF B > 7
				CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"이번엔 특별히 잘 된 것 같군/들여놓았던 부품의 품질이 좋았던 모양이야"
			ELSEIF B > 4
				CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"흠, 최소한 밥값은 했다고 자부하네/어디선가 실전 테스트라도 해보게나"
			ELSE
				CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"미안하네, 그다지 강화하지 못했어/예상했던 것보다 부품의 강도가 약해서 말이지/그 부분에 무리를 줄 수가 없었다네"
			ENDIF
			CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"어찌 됐든, 한번 어디선가 강화 정도를 확인해 보는 게 어떻겠나/이 거리에 사람을 덮치는 악마는 별로 없지만/다른 동네에는 얼마든지 득실댈 테니 말일세"
			GOTO HIRA_LOOP
		ELSE
			GOTO HIRA_LOOP_1
		ENDIF
	CASE 2
		CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"흠, 그럼 어느 기계에 파츠를 추가하겠나"
		$HIRA_LOOP_2
		RESULTS = どの機械を改造しますか？
		RESULTS += "//"
		LOCAL:1 = 1
		FOR LOCAL, 1, 7
			IF POS(LOCAL) > -1 && ABL:POS(LOCAL):종족 == 12 && LOCAL:2 != 2
				RESULTS += "[" + TOSTR(LOCAL) + "]" + CALLNAME:(POS(LOCAL)) + "/"
			ELSEIF POS(LOCAL) > -1 && TALENT:POS(LOCAL):기계의처녀 && (ダンジョンフラグ:31:5 == 6 || ダンジョンフラグ:31:5 == 4)
				RESULTS += "[" + TOSTR(LOCAL) + "]" + CALLNAME:(POS(LOCAL)) + "/"
			ENDIF
		NEXT
		RESULTS += "[0]やめる"
		CALL INPUT_SELECT_D , RESULTS , , , 2
		SIF RESULT == 0
			GOTO HIRA_LOOP
		NUMBER = RESULT
		IF NO:MASTER == NO:POS(NUMBER)
			CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"과연, 자네는 자기 자신을 개조하겠다는 건가?"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"과연, 자네는 " + CALLNAME:(POS(NUMBER)) + "을(를) 개조하겠다는 건가?"
		ENDIF
		CALL INPUT_YN_D
		IF RESULT == 1
			GOTO HIRA_LOOP_2
		ELSEIF RESULT == 0
			CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"잘 알겠네/그럼 어떤 파츠를 추가할지 선택해 주게나"
			$HIRA_LOOP_3
			CALL INPUT_SELECT_D , "어떻게 개조할까?//[1]인간형화/[2]날개를 돋아나게 한다/[3]꼬리를 돋아나게 한다/[4]동물 귀를 돋아나게 한다/[0]그만둔다" , , , 2
			SELECTCASE RESULT
				CASE 0
					GOTO HIRA_LOOP_2
				CASE 1
					IF (ダンジョンフラグ:31:5 == 6 || ダンジョンフラグ:31:5 == 4)
						CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"흠, 그거라면 간단하지/기계를 인간형으로 만드는 것쯤은 수도 없이 해온 의뢰니까 말이야/비싼 돈을 뜯어내는 것도 우스우니 250마카면 충분하네"
					ELSE
						CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"흠, 그거라면 간단하지/기계를 인간형으로 만드는 것쯤은 수도 없이 해온 의뢰니까 말이야/비싼 돈을 뜯어내는 것도 우스우니 500마카면 충분하네"
					ENDIF
					CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", CALLNAME:(POS(NUMBER)) + "을(를) 인간형으로 개조해도 괜찮겠나?"
					CALL INPUT_YN_D
					IF RESULT == 0
						IF (ダンジョンフラグ:31:5 == 6 || ダンジョンフラグ:31:5 == 4) && MONEY:1 < 250
							CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"…흠, 유감이지만 마카가 부족한 것 같군/아무리 자네의 부탁이라 해도 이 이상 깎아줄 순 없네/미안하지만 다음 기회로 미뤄주게"
							GOTO HIRA_LOOP_3
						ELSEIF MONEY:1 < 500
							CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"흠, 마카가 부족한가…/공교롭게도 나는 내 기술을 헐값에 팔 생각은 없어서 말일세"
							GOTO HIRA_LOOP_3
						ENDIF
						IF (ダンジョンフラグ:31:5 == 6 || ダンジョンフラグ:31:5 == 4)
							MONEY:1 -= 250
						ELSE
							MONEY:1 -= 500
						ENDIF
						CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"아아, 물어보는 걸 깜빡할 뻔했군/개조할 때의 외형은 남성형으로 하겠나, 여성형으로 하겠나/의뢰인에 따라선 무척 중요한 모양이니 미리 물어봐 두어야지"
						CALL INPUT_YN_D , "남성" , "여성"
						IF RESULT == 0
							IF TALENT:POS(NUMBER):남자 == 0
								CALL ＴＳ処理, POS(NUMBER), 3
								CALL ADDS_ABNORMAL_EXP , "ＴＳ" , POS(NUMBER)
								CALL SHOW_ABNORMAL_EXP , POS(NUMBER), 0
								EXP:POS(NUMBER):ＴＳ경험 += 1
							ELSE
								TALENT:(POS(NUMBER)):남자 = 1
							ENDIF
						ELSE
							IF TALENT:POS(NUMBER):남자 == 1
								CALL ＴＳ処理, POS(NUMBER), 3
								CALL ADDS_ABNORMAL_EXP , "ＴＳ" , POS(NUMBER)
								CALL SHOW_ABNORMAL_EXP , POS(NUMBER), 0
								EXP:POS(NUMBER):ＴＳ경험 += 1
							ELSE
								TALENT:(POS(NUMBER)):남자 = 0
								TALENT:(POS(NUMBER)):오토코노코 = 0
							ENDIF
						ENDIF
						IF NO:MASTER == NO:POS(NUMBER)
							CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"알겠네/그럼 이쪽으로 오게나"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞히라사와에게 안내받아, " + CALLNAME:MASTER + "은(는) 다시 그의 연구실로 향했다…"
							CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"자, 거기에 누워서 가만히 있어 주게/전원을 꺼도 상관없지만 사이보그 유형인 자네에겐 불안하겠지/다만 움직였을 때의 파손은 보증할 수 없으니 주의하게나"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…확실히 그렇지만, 마취 정도는 없는 걸까/＞그렇게 생각하다가 기계 몸에 듣는 마취가 어디 있겠는가 하는 결론에 이르렀다…"
						ELSE
							CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"알겠네/그럼 차라도 마시면서 잠시 기다려 주게나"
							IF ダンジョンフラグ:31:5 >= 3
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "회중시계 토끼", @"티타임에는 조금 어울리지 않는 시간입니다만/스콘은 포근포근 노릇노릇!/장미 잼도 아주 잘 만들어졌답니다!"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞연미복을 입은 토끼 머리의 데미휴먼이 가져다준 차를 마시며/＞" + CALLNAME:MASTER + " 일행은 느긋한 시간을 보냈다…"
							ELSE
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞박사가 건네준 차를 마시며/＞" + CALLNAME:MASTER + " 일행은 느긋한 시간을 보냈다…"
							ENDIF
						ENDIF
						CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
						CALL SHOW_PICTURE, "EMPTY"
						SIF TALENT:POS(NUMBER):짐승
							TALENT:POS(NUMBER):동물귀 = 1
						TALENT:POS(NUMBER):짐승 = 0
						TALENT:POS(NUMBER):새 = 0
						TALENT:POS(NUMBER):파충류 = 0
						TALENT:POS(NUMBER):물고기 = 0
						TALENT:POS(NUMBER):부정형 = 0
						TALENT:POS(NUMBER):이형 = 0
						TALENT:POS(NUMBER):인간화 = 1
						TALENT:POS(NUMBER):머리 = 1
						TALENT:POS(NUMBER):눈 = 1
						TALENT:POS(NUMBER):입 = 1
						TALENT:POS(NUMBER):팔 = 1
						TALENT:POS(NUMBER):발 = 1
						TALENT:POS(NUMBER):갈퀴발 = 0
						TALENT:POS(NUMBER):갈퀴 = 0
						SIF NO:POS(NUMBER) == [[キャラ:비트볼]]
							TALENT:POS(NUMBER):소인체형 = 1
						IF NO:MASTER == NO:POS(NUMBER)
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "이(가) 눈을 뜨자 히라사와가 말을 걸어왔다…"
							CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"흠, 무사히 완성되었네/거기 거울이 있으니 완성도를 자기 눈으로 확인해 보게"
							IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울을 들여다보자 금속성 피부를 지닌 늠름한 남자의 모습이 비치고 있었다/＞움직여 보았으나 각 부위의 동작에 위화감은 없다/＞무사히 인간형으로 돌아온 모양이다…"
							ELSEIF TALENT:MASTER:오토코노코
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울을 들여다보자 금속성 피부를 지닌 귀여운 소년의 모습이 비치고 있었다/＞움직여 보았으나 각 부위의 동작에 위화감은 없다/＞무사히 인간형으로 돌아온 모양이다…"
							ELSE
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울을 들여다보자 금속성 피부를 지닌 제법 번듯한 여성의 모습이 비치고 있었다/＞움직여 보았으나 각 부위의 동작에 위화감은 없다/＞무사히 인간형으로 돌아온 모양이다…"
							ENDIF
						ELSE
							CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"흠, 무사히 완성되었네/기체는 이쪽에 가져왔으니 완성도는 직접 확인해 보게나"
							SELECTCASE NO:POS(NUMBER)
								CASE [[キャラ:비트볼]]
									;ビットボール
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞히라사와 박사의 곁에는 크기는 그대로인 채 사람의 모습을 한 비트 볼이 떠 있었다/＞모터 구동음이 들리는 걸 보니 이전과 같은 원리로 부유하고 있는 것이리라/＞내부가 어떻게 되어 있는지는 도무지 알 수 없지만…"
									IF TALENT:POS(NUMBER):남자 && !TALENT:POS(NUMBER):오토코노코
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞전체적으로 다소 울퉁불퉁하여 확실히 남성적인 모습이다/＞개조 후의 모습으로 노커 같은 것을 대충 상상했었지만/＞그보다는 훨씬 남자다워 보인다"
									ELSE
										IF TALENT:POS(NUMBER):거유 || TALENT:POS(NUMBER):폭유 || TALENT:POS(NUMBER):마유
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞전체적으로 픽시와 닮은 듯한 외형이 되었지만/＞실로 풍만한 몸매를 지니고 있어 만지면 매끄러운 감촉이 기분 좋다"
										ELSEIF TALENT:POS(NUMBER):빈유 || TALENT:POS(NUMBER):절벽
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞전체적으로 픽시와 닮은 듯한 외형이 되었으나/＞밋밋한 몸매를 하고 있어 만지면 금속 막대 같은 감촉이 난다"
										ELSE
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞전체적으로 픽시와 닮았지만/＞더욱 몸매가 좋아 쓰다듬으면 굴곡이 뚜렷하게 느껴진다"
										ENDIF
									ENDIF
								CASE [[キャラ:라비]]
									;ラビ
									IF TALENT:POS(NUMBER):남자 && !TALENT:POS(NUMBER):오토코노코
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞히라사와 박사의 뒤편에는 울퉁불퉁한 보디를 지닌 로봇이 대기하고 있었다/＞인간과 닮았으나 푸르고 튼튼해 보이는 장갑과 거대한 세 손가락 암이 시선을 끈다/＞틀림없이 이건 라비다"
									ELSE
										IF TALENT:POS(NUMBER):거유 || TALENT:POS(NUMBER):폭유 || TALENT:POS(NUMBER):마유
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞히라사와 박사의 뒤편에는 흘러넘칠 듯 풍만한 가슴의 로봇이 대기하고 있었다/＞인간과 닮았으나 푸르고 튼튼해 보이는 장갑과 거대한 세 손가락 암이 시선을 끈다/＞틀림없이 이건 라비다"
										ELSEIF TALENT:POS(NUMBER):빈유 || TALENT:POS(NUMBER):절벽
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞히라사와 박사의 뒤편에는 유선형 보디를 지닌 로봇이 대기하고 있었다/＞인간과 닮았으나 푸르고 튼튼해 보이는 장갑과 거대한 세 손가락 암이 시선을 끈다/＞틀림없이 이건 라비다"
										ELSE
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞히라사와 박사의 뒤편에는 몸매가 늘씬한 로봇이 대기하고 있었다/＞인간과 닮았으나 푸르고 튼튼해 보이는 장갑과 거대한 세 손가락 암이 시선을 끈다/＞틀림없이 이건 라비다"
										ENDIF
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞!/＞라비의 뒤편에 무언가의 그림자가 나타났다!/＞설마, 페르소나 기능인가…?"
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…라고 생각했으나 본래의 입체 영상 장치가 작동했을 뿐인 모양이다/＞또 성전의 내용을 읊조리기 시작했다…"
									ENDIF
								CASE [[キャラ:T95골렘]]
									;ゴーレム
									IF TALENT:POS(NUMBER):남자 && !TALENT:POS(NUMBER):오토코노코
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞히라사와 박사의 뒤편에는 울퉁불퉁한 보디를 지닌 로봇이 대기하고 있었다/＞인간과 닮았으나 노랗고 튼튼해 보이는 장갑과 거대한 세 손가락 암이 시선을 끈다/＞아무래도 정말로 T95 골렘이 인간형이 된 모양이다…"
									ELSE
										IF TALENT:POS(NUMBER):거유 || TALENT:POS(NUMBER):폭유 || TALENT:POS(NUMBER):마유
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞히라사와 박사의 뒤편에는 흘러넘칠 듯 풍만한 가슴의 로봇이 대기하고 있었다/＞인간과 닮았으나 노랗고 튼튼해 보이는 장갑과 거대한 세 손가락 암이 시선을 끈다/＞아무래도 정말로 T95 골렘이 인간형이 된 모양이다…"
										ELSEIF TALENT:POS(NUMBER):빈유 || TALENT:POS(NUMBER):절벽
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞히라사와 박사의 뒤편에는 유선형 보디를 지닌 로봇이 대기하고 있었다/＞인간과 닮았으나 노랗고 튼튼해 보이는 장갑과 거대한 세 손가락 암이 시선을 끈다/＞아무래도 정말로 T95 골렘이 인간형이 된 모양이다…"
										ELSE
											CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞히라사와 박사의 뒤편에는 몸매가 늘씬한 로봇이 대기하고 있었다/＞인간과 닮았으나 노랗고 튼튼해 보이는 장갑과 거대한 세 손가락 암이 시선을 끈다/＞아무래도 정말로 T95 골렘이 인간형이 된 모양이다…"
										ENDIF
									ENDIF
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞하지만 지금의 골렘에게 자폭을 시키려니/＞아무래도 심리적인 저항감을 지우기 어렵겠는데…"
								CASE [[キャラ:T95메두사]]
									;メデューサ
									IF TALENT:POS(NUMBER):남자 && !TALENT:POS(NUMBER):오토코노코
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞히라사와 박사의 뒤편에는 울퉁불퉁한 보디를 지닌 로봇이 대기하고 있었다/＞인간과 닮았으나 붉고 튼튼해 보이는 장갑과 거대한 세 손가락 암이 시선을 끈다/＞메두사는 무사히 인간형이 된 모양이다…"
