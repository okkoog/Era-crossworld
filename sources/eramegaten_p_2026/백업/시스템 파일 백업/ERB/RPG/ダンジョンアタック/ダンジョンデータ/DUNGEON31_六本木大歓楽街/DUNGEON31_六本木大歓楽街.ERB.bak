							CASE 5
								CSTR:POS(NUMBER):49 = 現在は平沢博士の改造により頭部にウサギの耳を取り付けられている。
						ENDSELECT
						TALENT:POS(NUMBER):동물귀 = 1
						IF NO:MASTER == NO:POS(NUMBER)
							CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"알겠네/그럼 이쪽으로 오게나"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞히라사와에게 안내받아, " + CALLNAME:MASTER + "은(는) 다시 그의 연구실로 향했다…"
							CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"자, 거기에 누워서 가만히 있어 주게/전원을 꺼도 상관없지만 사이보그 유형인 자네에겐 불안하겠지/다만 움직였을 때의 파손은 보증할 수 없으니 주의하게나"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇게 말하며 히라사와 박사는 " + CALLNAME:MASTER + "의 머리 부위 파츠를 교환하기 시작했다/＞일시적으로 귀가 들리지 않게 되는 것이 불안하다"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
							CALL SHOW_PICTURE, "EMPTY"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "이(가) 눈을 뜨자 히라사와가 말을 걸어왔다…"
							CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"흠, 무사히 완성되었네/거기 거울이 있으니 완성도를 자기 눈으로 확인해 보게"
							IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
								SELECTCASE B
									CASE 1
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울을 들여다보자/＞금속성의 늠름한 몸에 개 모양 귀를 단 남자가 비치고 있었다/＞축 늘어진 귀가 머리카락에 닿아 간지럽다…"
									CASE 2
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울을 들여다보자/＞금속성의 늠름한 몸에 고양이 모양 귀를 단 남자가 비치고 있었다/＞기분 탓인지 청력이 더 좋아진 것 같다"
									CASE 3
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울을 들여다보자/＞금속성의 늠름한 몸에 여우 모양 귀를 단 남자가 비치고 있었다/＞그늘에 계실 히라사와 박사의 위치가 소리로 느껴지는 듯하다"
									CASE 4
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울을 들여다보자/＞금속성의 늠름한 몸에 소 모양 귀와 뿔이 난 남자가 비치고 있었다/＞미노타우로스는 아니다…"
									CASE 5
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거울을 들여다보자/＞금속성의 늠름한 몸에 토끼 모양 귀가 달린 남자가 비치고 있었다/＞왠지 모르지만 정력이 솟구치는 듯한 기분이 들었다…"
								ENDSELECT
							ELSEIF TALENT:MASTER:오토코노코
								IF TALENT:MASTER:거유 || TALENT:MASTER:폭유 || TALENT:MASTER:마유
									SELECTCASE B
