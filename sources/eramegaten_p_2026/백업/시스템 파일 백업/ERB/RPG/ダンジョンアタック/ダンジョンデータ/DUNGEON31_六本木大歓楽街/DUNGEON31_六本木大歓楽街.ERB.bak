							CALL MESSAGE_WINDOW_D_ICON, , "42_踊っている女1", "", "춤추는 여자", @"아아 춤추는 건 기분 너무 좋아-！//"
						ELSEIF RAND:2 == 0
							CALL MESSAGE_WINDOW_D_ICON, , "50_踊っている女2", "", "춤추는 여자", @"뭘 쳐다보는 거야！//"
						ELSE
							CALL MESSAGE_WINDOW_D_ICON, , "51_踊っている女3", "", "춤추는 여자", @"나한테 넋을 잃는 건 어쩔 수 없겠지만…/여기 왔으면 춤춰야지！/"
						ENDIF
					CASE 7
						;EASYのときのみ無条件で加入
						;それ以外はLv22以上で話しかける（マンイーターはLv27なので、やや上のレベルの悪魔が加入することになる）
						IF ダンジョンフラグ:31:60 < 1
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞바디코니안과 맨이터가 춤추고 있다//"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞두 녀석 모두 수많은 ＭＡＧ를 탐해온 탓인지 생전의 아름다움을 간직하고 있다…//"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("ボディコニアン"), D31_FACE("ボディコニアン"), , "바디코니안", @"아앙！ 우리를 더 바라봐 줘-！//"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("マンイーター"), D31_FACE("マンイーター"), , "맨이터", @"그래！ 더욱더 많이！//"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞두 녀석이 서로 끌어안고 키스를 나누며 몸을 비벼댄다/＞주변에서 욕망에 가득 찬 시선이 쏟아진다/＞다음 사냥감을 유혹하고 있는 것이리라…"
							CALL INPUT_YN_D , "말을 건다" , "다른 곳으로 간다"
							IF RESULT == 0
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞춤이 한 차례 잦아들었을 때 말을 건다/＞자신과 함께 가서 욕망을 채우지 않겠느냐고./"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("ボディコニアン"), D31_FACE("ボディコニアン"), , "바디코니안", @"굉장해, 맛있어 보여…%ハート()%//"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("マンイーター"), D31_FACE("マンイーター"), , "맨이터", @"언니들이 예뻐해 줄게…//"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그녀들은 당신을 둘러싸고 몸을 어루만지며 승낙한다/＞사냥감으로 낙점된 것일까…/"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞시귀 바디코니안을 동료마로 맞이했다/＞유귀 맨이터를 동료마로 맞이했다/"
								CALL ADD_NEW_COMPANION, [[キャラ:보디코니언]], 500, 1, 0, 0, MIN(BASE:MASTER:LV, 27)
								CALL ADD_NEW_COMPANION, [[キャラ:맨이터]], 500, 1, 0, 0, MIN(BASE:MASTER:LV, 27)
								ダンジョンフラグ:31:60 = 1
							ELSE
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞춤이 한 차례 잦아들었을 때 젊은 남자가 그녀들에게 말을 걸고 있었다/＞악마라는 것조차 눈치채지 못한 모양이다…/"
							ENDIF
						ELSE
							;イベント消化前
							IF ダンジョンフラグ:31:60 < 1
								IF RAND:2 == 0
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞바디코니안이 춤추고 있다/＞당신은 아직 안중에도 없는 듯하다/"
								ELSE
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞맨이터가 춤추고 있다/＞당신은 아직 안중에도 없는 듯하다/"
								ENDIF
							ELSE
								IF RAND:2 == 0
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞바디코니안이 춤추고 있다/＞하지만 당신이 꼬드긴 개체보다 윤기가 없다/"
								ELSE
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞맨이터가 춤추고 있다/＞하지만 당신이 꼬드긴 개체보다 윤기가 없다/"
								ENDIF
							ENDIF
						ENDIF
					CASE 10
						CALL MESSAGE_WINDOW_D_ICON, , "49_踊る男", , "춤추는 남자", "이 거리 말이야/미인인데 이상한 냄새가 나는 누나들이 있단 말이지/그거 대체 뭘까？"
					CASE 11
						;半ばおまけかつ趣味に近い小さいイベント
						IF ダンジョンフラグ:31:3 == 0
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞어쩐지 메시아 교도가 뭔가를 주장하고 있는 듯하다…//"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("聖乳メシア教徒"), D31_FACE("メシア教徒"), , "메시아 교도 여성", @"이 거리를 지나시는 여러분, 부디 귀 기울여 주시길 바랍니다//"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("聖乳メシア教徒"), D31_FACE("メシア教徒"), , "메시아 교도 여성", @"여러분께서 이 거리에서 무엇을 하시는지 저는 알지 못합니다/하지만 욕망이 이끄는 대로 쾌락을 탐하는 따위의 짓은/그야말로 타락의 증거, 결코 용납될 수 없는 일입니다"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("聖乳メシア教徒"), D31_FACE("メシア教徒"), , "메시아 교도 여성", @"만약 이러한 거리에서 육욕에 계속 빠져 계신다면/머지않아 저 소돔과 고모라처럼 신의 분노가 내릴 것입니다/"
							CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("聖乳メシア教徒"), D31_FACE("メシア教徒"), , "메시아 교도 여성", @"악마에게 홀려 제 몸을 망치는 듯한 행위에 젖어 있을 것이 아니라/신을 믿고 신의 가르침을 따르며 살아가는 것만이 인간의…/"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞과연, 아무래도 악마가 지배하는 이 거리에서 신의 길을 설파하려는 모양이다/＞그것도 굳이 욕망에 찌든 손님들을 교도하려는 듯하다/＞참으로 헛수고를 하는군…"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞하지만 자세히 살펴보니 상당한 미인이다. 언뜻 수수해 보이지만 앞머리 너머로 엿보이는 얼굴은 제법 청초하게 정돈되어 있다/＞게다가 아담한 체구에 어울리지 않게 법의조차 찢어발길 듯한 유방의 부풀림을 지니고 있다/＞노예로 삼을 만한 가치는 충분하겠지"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞다행히도 이 거리에서는 주정뱅이들끼리의 싸움이 끊이지 않는다/＞그리고 만취하여 남에게 부축받는 자도 마찬가지다/＞아무도 말을 듣고 있지 않은 지금 상황이라면 저 여자를 기절시켜 데려갈 수 있겠지"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞자, 이 여자를 어떻게 해줄까…//"
							CALL INPUT_YN_D , "데려간다" , "이야기를 들어본다"
							IF RESULT == 0
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞이런 거리에 혼자 있는 꼴을 보니 이 여자의 말로도 거의 뻔하다/＞어차피 그렇게 될 바엔 이쪽에서 이용해 주지/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("聖乳メシア教徒"), D31_FACE("メシア教徒"), , "메시아 교도 여성", @"어머…/그쪽 분, 무슨 일이신가요？/말씀을 들어주신다면 감사한 일입니다만…"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("聖乳メシア教徒"), D31_FACE("メシア教徒"), , "메시아 교도 여성", @"어째서 이쪽으로 다가오시는 건가요？/손에 쥐고 계신 것은…/무기？"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("聖乳メシア教徒"), D31_FACE("メシア教徒"), , "메시아 교도 여성", @"무, 무엇을 하시려는 건…//"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞명치에 일격을 꽂아 넣자 여자는 움직일 수 없게 된 모양이다/＞경련은 하고 있으니 데려가서 회복 주문이라도 걸어주자/＞자, 일단 돌아가 볼까…"
								;CALL SHOW_PICTURE, "D"
								ダンジョンフラグ:31:3 = 2
								CALL ADD_NEW_COMPANION, [[キャラ:성유메시아교도]], 200
								SIF RESULT
									CALLF SET_ALL_FACE_NEW, CHARA, GET_識別名(NO:CHARA) + "_" + D31_FACE("メシア教徒", 1)
								VARSET RESULTS
								CALL INCREASE_LC, -5
								CALL INCREASE_LD, -5
								FLAG:탈출 = 1
								RETURN 1
							ELSE
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞아니, 혼자서 이 거리에 와서 설교를 늘어놓을 정도면 보통 여자가 아닐지도 모른다/＞일단 이야기라도 들으며 동태를 살펴볼까…/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("聖乳メシア教徒"), D31_FACE("メシア教徒"), , "메시아 교도 여성", @"애초에 색욕이라는 것은 칠죄종 중 하나로…/악마 아스모데우스가…/하지만 이는 결코 아이를 낳지 말라는 뜻이 아니라…"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("聖乳メシア教徒"), D31_FACE("メシア教徒"), , "메시아 교도 여성", @"어디까지나 신을 바라보는 데 장애물이…/그러므로 이 거리와 같은 장소는 본래 존재해서는 안 됩니다/"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("聖乳メシア教徒"), D31_FACE("メシア教徒"), , "메시아 교도 여성", @"부디, 부디 그 점을 마음에 새겨주신다면 감사하겠습니다/그럼 여러분께 신의 축복이 있기를…/"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞끝까지 들어보았으나 역시 그저 배짱만 두둑한 여자였던 모양이다/＞몸놀림에서도 전투 소양은 느껴지지 않는다/＞악마에 대한 지식도 세상에 널리 알려진 수준에 불과한 듯하다"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞아마도 메시아교 내부에서도 보기 드문, 온건파에 속한 일반인이리라/＞메시아교 내부에서 일반인의 삶은 팍팍하다고 들었다/＞그럼에도 불구하고 포교를 위해 여자의 몸 하나로 이런 거리에 찾아오다니…" 
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("聖乳メシア教徒"), D31_FACE("メシア教徒"), , "메시아 교도 여성", @"저기, 거기 계신 분//" 
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…아까 그 여자다./＞무슨 볼일일까…/"
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("聖乳メシア教徒"), D31_FACE("メシア教徒"), , "메시아 교도 여성", @"아까부터 제 이야기를 귀담아들어 주셔서 감사드립니다/괜찮으시다면 그대를 위해 이것을…/"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞묵주를 손에 넣었다//"
								CALL GET_ITEMS, "로자리오", 1
								CALL MESSAGE_WINDOW_D_ICON, GET_識別番号("聖乳メシア教徒"), D31_FACE("メシア教徒"), , "메시아 교도 여성", @"그럼, 그대에게 신의 가호가 있기를…//"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞여자는 떠나갔다…//"
