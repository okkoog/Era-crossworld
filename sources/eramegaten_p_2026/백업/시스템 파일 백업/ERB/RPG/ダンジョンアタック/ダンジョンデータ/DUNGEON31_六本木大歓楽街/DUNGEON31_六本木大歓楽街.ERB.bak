						CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"각 방에 인간 남성이 환상을 보여주는 기계에 연결되어 있으므로/거기에 마카를 투입해 주시면/곧바로 남성이 사정하여 손님께 ＭＡＧ를 제공하는 구조로 되어 있습니다"
						CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"또한 남성들도 ＶＲ이라는 세계에서/선녀들에게 둘러싸여 성적 흥분을 계속 발산하는 삶을 살고 있습니다/이른바 인도적인 문제는 없습니다"
						CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"그럼 부디 오래도록 이용해 주시기를…//"
						IF FINDCHARA_B([[キャラ:에미]], 0) == 2
							CHARA = RESULT:1
							;CALL SHOW_PICTURE, "D"
							CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"악마는 인간을 뭐라고 생각하는 걸까!//"
							CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞에이미는 분노로 몸을 떨고 있다…//"
							IF ダンジョンフラグ:31:6 == 2
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"저기 당신, 여기에 최근 끌려온 남자가 있지/그 사람이 어디 있는지 알고 있겠지!?/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"글쎄요…/저희 악마들은 인간의 특징을 잘 파악하지 못하는지라/죄송합니다만…" 
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"…그렇다면 찾을 수밖에 없겠네…//"
							ELSEIF ダンジョンフラグ:31:6 == 3
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"저기 당신, 안쪽 방에 최근에 온 남자, 있지?//"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"네, 확실히 그 방은 얼마 전 보충된 방입니다만, 무슨 일이라도?//"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"그 사람은 제 연인이에요/해방해 주실 수 있나요?/"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞에이미는 악마에게,/＞자신들은 뿔뿔이 흩어져 버린 연인 사이라고/＞설명했다…"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"…과연/노숙자에게 끌려왔을 때부터 사연이 있다고는 생각했습니다만/그런 분이셨군요"
								CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"그는 몇 번이나 기기를 조정해도, 에이미라는 여성의 이름만을 중얼거릴 뿐/일체의 MAG를 제공하지 않았습니다만/떨어진 연인을 걱정하는 마음 때문이었군요"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"맞아, 내가 그 에이미야/그럼, 타츠야를 풀어줄 수 있을까/"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞하지만 악마는 고개를 저으며 대답했다…//"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"아니요, 그럴 수는 없습니다/그는 일단 저희가 5000마카라는 거액으로 구입한 것이거든요/게다가 기자재에 연결하고 각종 조정도 거쳤으니, 공짜로 넘겨드릴 수는 없습니다"
								CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"하지만 사정이 사정인 것 같군요/저희가 설비 투자에 들인 몫은 제쳐두고, 5000마카만 주신다면 돌려드리도록 하지요/"
								;CALL SHOW_PICTURE, "D"
								CALL MESSAGE_WINDOW_D_ICON, CHARA, "キャラ登録番号", , "에이미", @"…!/" + CALLNAME:MASTER + " 씨, 면목 없지만 보태주실 수 있나요?/"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…자, 카츠라기에게서 들어올 보수/＞데빌 버스터라는 전력/＞그것들에 5000마카 상당의 매력은 있을 것이다"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞하지만 5000마카나 되면 선뜻 낼 수는 없다, 어찌해야 할까…//"
								CALL INPUT_YN_D , "돈을 낸다" , "협박한다"
								IF RESULT == 0
									IF MONEY:1 < 5000
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞애초에 5000마카도 갖고 있지 않다/＞역시 협박할 수밖에 없나…/"
										GOTO HAYASAKA_M
									ENDIF
									MONEY:1 -= 5000
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞여기는 악마가 소유한 시설, 어디에 무엇이 있을지 알 수 없다/＞얌전히 요구에 따르자…/"
									;CALL SHOW_PICTURE, "D"
									CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"과연, 확실히 5000마카 맞군요/알겠습니다, 그를 넘겨드리죠/잠시만 기다려 주십시오, 지금 기계에서 그를 분리해 올 테니"
									CALL INCREASE_LD, 5
								ELSE
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞여기는 역시 협박해 버리는 게 빠르겠지…//"
									$HAYASAKA_M
									CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇게 생각한 당신은, 악마에게 다가가 귓속말을 했다…//"
									IF FLAG:나이트・테일진행도 >= 2
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞미안하지만 그 돈은 낼 수 없다/＞일단 경시청 특별자료실 제0과의 일원으로서, 필요하다면 이곳을 급습할 수도 있는데?/"
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞실제로는 그렇지 않지만/＞0과에 협력을 의뢰할 수 있는 입장인 것은 틀림없다/＞예상대로 악마는 안색을 바꾸었다…"
									ELSE
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞미안하지만 그 돈은 낼 수 없다/＞명색이 팬텀의 말석, 악마의 요구에 호락호락 굴복할 수는 없지/"
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞다행히 악마는 팬텀에 대해 알고 있었던 모양이다/＞안색이 싹 바뀌었다…/"
									ENDIF
									;CALL SHOW_PICTURE, "D"
									CALL MESSAGE_WINDOW_D_ICON, , "20_悪魔1", , "악마", @"…알겠습니다, 그 남자를 넘겨드리지요/잠시만 기다려 주십시오, 지금 기계에서 그를 분리해 올 테니/"
									CALL INCREASE_LD, -5
								ENDIF
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞잠시 후, 남자 한 명이 실려 왔다/＞아무래도 아직 의식을 잃은 상태인 것 같다/"
								;CALL SHOW_PICTURE, "D"
