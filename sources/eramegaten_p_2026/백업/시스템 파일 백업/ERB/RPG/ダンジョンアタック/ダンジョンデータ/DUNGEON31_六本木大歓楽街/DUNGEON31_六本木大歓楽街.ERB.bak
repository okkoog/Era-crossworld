						GOTO HIRA_LOOP
					ELSE
						GOTO HIRA_LOOP_3
					ENDIF
				CASEELSE
					GOTO HIRA_LOOP_3
			ENDSELECT
		ELSE
			GOTO HIRA_LOOP_2
		ENDIF
	CASE 3
		CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"내 가게에서는 기계들에게 두 종류의 개조를 해주고 있네/하나는 단순한 기능 강화/또 하나는 파츠 추가일세"
		CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"우선, 단순한 기능 강화/이건 이해하기 쉬울 걸세/그 이름대로 기계들의 스테이터스를 상승시켜 주지"
		CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"기본적으로 향 따위를 피우는 것보다는 효율적으로 강화할 수 있다고 자부하고 있네/그렇지 않다면 손님이 올 리 없지/다만 강화가 잘 풀릴지는 어느 정도 운도 따르니 너무 기대하진 말게나"
		CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"또 하나는 파츠의 추가일세/이쪽은 외형에 여러 문제가 있는 머신에 대해 행해지는 경우가 많지"
		CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"비트 볼에 손발을 달아서 소형 마스코트처럼 만들거나/구형 머신에 꼬리를 달아 어린이용 놀이기구로 만들거나"
		CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"별난 경우로는 인간형 사이보그의 외형을/의뢰인의 취향에 맞추기 위한 작업을 한 적도 있었지"
		CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"아아, 나 역시 이 거리의 관습대로 마카 결제 외에는 받지 않는다네/이 거리에서 살다 보면 일본 엔화는 거의 쓸모가 없어서 말이지/혹 의뢰할 일이 있다면 꼭 마카를 챙겨오도록 하게"
	CASEELSE
		GOTO HIRA_LOOP
ENDSELECT

