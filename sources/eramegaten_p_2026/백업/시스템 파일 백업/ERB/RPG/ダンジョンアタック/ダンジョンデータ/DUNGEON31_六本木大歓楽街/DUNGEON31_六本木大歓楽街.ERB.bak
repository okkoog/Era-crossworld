							ENDIF
						ELSEIF (FINDCHARA_B([[キャラ:체페이_꼬리두개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리세개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리네개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리다섯개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리여섯개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리일곱개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리여덣개]], 1) == 2 || FINDCHARA_B([[キャラ:체페이_꼬리아홉개]], 1) == 2)
