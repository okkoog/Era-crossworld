							ELSEIF LOCAL:2 == 1
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "초로의 남자", @"…흠, 또 그 근처에서 사 온 기계를 강화해 달라는 겐가/조금은 더 그럴싸한 일거리를 가져와 줬으면 좋겠네만…"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "초로의 남자", @"뭐 좋다, 그 기계를 이리 넘기게나/그다지 내키지 않는 일이라서 말이지, 빨리 끝내주마"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇게 말하며 남자는 " + CALLNAME:(POS(LOCAL:1)) + "를 이동시키려 하고 있다/＞대체 무엇을 하려는 걸까？"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "초로의 남자", @"응？/혹시 자네는 아무것도 모르고 이 가게에 찾아온 겐가/그건 미안하게 됐군, 일단 설명이라도 해주지"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "초로의 남자", @"내 이름은 히라사와 스스무일세/나를 아는 사람들은 죄다 미치광이 박사니 매드 사이언티스트니 제멋대로 지껄여대고 있지"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"이래 봬도 이른바 사이버네틱스 연구자의 말석에 앉은 몸이라서 말이야/하지만 이 시대에 그것만으로 먹고살 수 있을 만큼 과학자라는 직업이 녹록지 않지/그래서 부업으로 기계 조정 따위를 하고 있었네만…" 
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"그쪽 방면으로 너무 성과를 내버린 탓에/주변의 요구에 다소 진절머리가 나던 참이었네"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"그런 때에 자네가 기계를 들고 와 주었으니/또 시시껄렁한 일거리겠거니 싶어 의욕이 나지 않았던 거라네/용서해 주게나"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그렇군, 머신을 강화할 수 있다는 남자의 소문은 알고 있었으나 그 남자가 바로 이 사람인가！"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"뭐 모처럼이니 연구 비용이 될 마카만 준다면/나로서도 자네의 머신을 강화해 주는 것을 마다하진 않네"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞확실히 모처럼 만날 수 있었던 것이다/＞다소 마카가 들더라도 " + CALLNAME:(POS(LOCAL:1)) + " 일행을 강화하도록 하자…" 
								ダンジョンフラグ:31:5 = 2
								CALL HIRA_31
							ELSEIF LOCAL:2 == 2
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "초로의 남자", @"음, 잠깐 기다려보게/자네가 데리고 있는 그녀는 혹시…/아니, 놀랍군…"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞초로의 남자는 뚫어져라 " + CALLNAME:(POS(LOCAL:1)) + "를 바라보고 있다…/＞바라보긴커녕 흥분한 기색으로 만지거나 쓰다듬고 있다/＞변태의 일종인가？"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "가 차가운 눈으로 백발의 남자를 바라보고 있자/＞그제야 겨우 제정신을 차린 듯한 남자가 이쪽을 돌아보았다"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "초로의 남자", @"아니 미안하이/이 정도의 완성도를 자랑하는 로봇은 좀처럼 본 적이 없어서 말이야/나잇값도 못 하고 그만 흥분해 버렸군"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞！/＞이 남자, 한눈에 " + CALLNAME:(POS(LOCAL:1)) + "가 진짜 기계라는 것을 꿰뚫어 보았는가！"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "초로의 남자", @"일단은 허브티라도 마시며 진정하고 가게나/나도 그 정도는 마셔야 진정이 될 것 같으니"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그리고 남자가 손가락을 튕기자 안쪽에서 또각또각…/＞…트럼프, 병정？"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "트럼프 병정", @"부르셨습니까？ 박사님"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "초로의 남자", @"오, 왔는가！/조금 늦었군！"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "트럼프 병정", @"죄송합니다, 박사님/모자 장수가 도무지 놔주질 않아서…"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "초로의 남자", @"허브티를 가져오게/오, 그리고 어제 토끼가 구워뒀던 스콘도 말이지！/가능한 한 서둘러 주게나！"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "트럼프 병정", @"알겠습니다"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "초로의 남자", @"놀랐는가？/저건 내가 만든 데미 휴먼… 요컨대 인조인간이라네/거기 그녀와는 또 다른 방식으로 접근한 것이지"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "초로의 남자", @"그렇지 그렇지, 자기소개를 잊고 있었군그래/내 이름은 히라사와 스스무일세/나를 아는 사람들은 죄다 미치광이 박사니 매드 사이언티스트니 제멋대로 지껄여대고 있지만 말이야"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞허브티를 마시며 남자는 그렇게 이름을 밝혔다/＞인조인간까지 만들 정도라면 그 평가는 타당하리라/＞하지만 기술력 하나만큼은 확실해 보인다"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"자 본론으로 들어가서, 자네에게 부탁이 있네/나한테 이 아이의 검사를 받게 해주지 않겠나？"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…이름을 밝혔는가 싶더니 대뜸 터무니없는 소릴 해댄다/＞생판 모르는 남자에게 " + CALLNAME:(POS(LOCAL:1)) + "를 만지작거리게 두라고？"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"물론 공짜는 아닐세/나는 여기서 기계 강화를 생업으로 삼고 있지/그 아이의 구조만 이해할 수 있다면 내가 그 아이를 강화해 줄 수 있네"
								CALL MESSAGE_WINDOW_D_ICON, , "28_初老の男", , "히라사와", @"당연히 대금도 철저하게 깎아주마/아마도 이 아이는 전투용이라 생각되는데/나에 의한 강화는 자네나 그 아이에게도 이로운 일 아니겠나？"
								CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞…확실히 " + CALLNAME:(POS(LOCAL:1)) + "를 강화해 준다는 거라면/나쁘지 않을지도 모른다/＞하지만 역시 내 것을 모르는 남자에게 만지게 하는 데엔 불안감도 있다/＞자, 어쩔까나…" 
