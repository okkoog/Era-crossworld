;スキル名
@SKILL_NAME_5305,ARG
RESULTS = 운UP

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_5305
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_5305, ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

;계승타입
@SKILL_SUCCESSION_TYPE_5305
RETURN GET_SUCCESSION_NUM("자동효과")


;スキル変化？用ランク
@SKILL_RANK_5305, ARG = -1
RETURN 1
;変化不可


;効果を発揮するリーダースキル
@SKILL_GET_LEADER_SKILL_NAME_5305, ARG
RESULTS = 운 상승

;　 説明文の表示
@SKILL_EXPLAIN_5305, ARG
PRINTL 자동：아군 악마의 운이 UP한다。
PRINTL 　　　스킬 소지자의 레벨에 따라 효과가 UP한다。

@SKILL_ACTIONABLE_BATTLE_5305, ARG
