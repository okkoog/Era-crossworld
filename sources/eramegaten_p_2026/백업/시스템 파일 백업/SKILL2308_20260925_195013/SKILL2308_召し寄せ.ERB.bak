;変化不可
;スキル変化？用ランク
@敵専用_2308
RETURN 1
;====================================================
;スキル及び行動の実行
;増援パターン_%CSTR:ARG:증원패턴%を呼び出します
;ARG:1が呼び出すポジションとなるので、普通にSET_ENEMYしてください
;また、能力を調整してやる際は通常の設置と同じ感じで
;====================================================
@ACTION_2308, ARG, ARG:1, ARG:2
#DIM LOOP_NUM
LOCAL:21 = 0
$START
LOCAL:21++
FOR LOOP_NUM, 1, 21
	LOCAL:LOOP_NUM = 0
NEXT
LOCAL:20 = 1
FOR LOOP_NUM, 7, 17
	SIF POS(LOOP_NUM) >= 0
		CONTINUE
	LOCAL:(LOCAL:20) = LOOP_NUM
	LOCAL:20++
NEXT
IF LOCAL:20 == 1
	PRINTW 하지만、아무도 나타나지 않았다！
	RETURN -1
ENDIF
LOCAL = LOCAL:(RAND:(LOCAL:20 - 1) + 1)
;前がいない後列に呼び出す場合はこの時点で詰めてしまう
SIF LOCAL > 11 && POS(LOCAL - 5) == -1
	LOCAL -= 5
CALLFORM 増援パターン_%CSTR:ARG:증원패턴%, ARG, LOCAL, LOCAL:21
CFLAG:(CHARANUM-1):입력행동 = -1
IF RESULT == 0
	PRINTFORML %CALLNAME:(CHARANUM-1)% %조사만처리(CALLNAME:(CHARANUM-1),"이")% 나타났다！
	GOTO START
ELSE
	PRINTFORMW %CALLNAME:(CHARANUM-1)% %조사만처리(CALLNAME:(CHARANUM-1),"이")% 나타났다！
ENDIF
;記述例
;@増援パターン_N, ARG, ARG:1, ARG:2
;CALL SET_ENEMY, ARG:1, [[キャラ:픽시]], 5
;MAXBASE:(CHARANUM-1):HP補正 = 100
;CALL SYNC_STATUS, (CHARANUM-1)
;SIF ARG:2 == A
;	RETURN 1
;RETURN 0
;
;ARGは召し寄せを使うキャラ番号
;ARG:1は召し寄せられるキャラのポジション
;ARG:2は召し寄せた回数で、１回目、２回目とはいっていくので
;Aの数値により、一回で召し寄せる量を決められる
;(RETURN 1で戻した場合、召し寄せの処理を再び行う)
;====================================================
;実行内容ここまで
;====================================================
;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_2308,ARG,ARG:1,ARG:2
;　 説明文の表示
@SKILL_EXPLAIN_2308, ARG
PRINTL 악마를 불러낸다
;使用条件
@SKILL_SPECIAL_ACTIONABLE_2308,ARG
RETURN 1
;とくにない

