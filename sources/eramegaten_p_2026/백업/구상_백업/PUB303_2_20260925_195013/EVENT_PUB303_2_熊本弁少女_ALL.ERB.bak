;176,애널극태촉수
;-------------------------------------------------
	CASE 176
		CALL TRAIN_MESSAGE
		;装着時
		IF TEQUIP:확장벌룬
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORML 「%CSTR:이인칭%, %CSTR:일인칭%의 똥구멍에 미끌미끌이가…」
					PRINTFORML 「절대로 안 들어갈 크기인디도 들어온당께!」
					PRINTFORMW 「살려줘, 살려줘!」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORML 「오오오오♪」
					IF RAND:2 == 0
						PRINTFORML 「들어오고 있당께♪ 꿈틀거리면서 몸속으로 들어오고 있어♪」
					ELSE
						PRINTFORML 「굵다란 놈이 엉덩이로 몸속에 들어오고 있당께♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「%CSTR:이인칭%」
					PRINTFORML 「%CSTR:일인칭%의 몸속으로, 미끌미끌이가 들어오고 있구마」
					IF RAND:2 == 0
						PRINTFORMW 「배 위에서 봐도 촉수인 걸 알 정도로 크당께!」
					ELSE
						PRINTFORMW 「내장이 몽땅 입으로 튀어나올 정도로 크당께!」
					ENDIF
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3
				PRINTFORML 「이제… 쪼… 끔…」
				PRINTFORMW %CALLNAME%은(는) 괄약근에 온 힘을 주어 아무리 생각해도 안 들어갈 굵기의 촉수를 받아들이려 하고 있다…
			;それ以外
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「구에에에에에에~」
				ELSE
					PRINTFORML 「이제에 무리라아아아~」
				ENDIF
				PRINTFORMW 소녀답지 않은 소리를 내지르며, 아무리 생각해도 안 들어갈 굵기의 촉수를 %CALLNAME%의 국화 구멍은 삼켜가고 있다…
			ENDIF
		;解除時
		ELSE
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				PRINTFORML 「엉덩이, 벌려져 버렸어…」
				PRINTFORML 「책임지고… 넣어줘잉%ハート()%」
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				IF RAND:2 == 0
					PRINTFORML 「꼬추하고는 달리가, 배 속 깊은 곳까지 닿지만서도」
					PRINTFORML 「그게 참 좋구마잉♪」
				ELSE
					PRINTFORML 「억수로 굵었당께에♪」
					PRINTFORML 「또 부탁해도 괜찮을까?」
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				IF RAND:2 == 0
					PRINTFORML 「%CSTR:일인칭%의 엉덩이 안쪽, 깨끗해?」
				ELSE
					PRINTFORML 「억수로 굵었당께에♪」
					PRINTFORML 「또 부탁해도 괜찮을까?
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3
				PRINTFORML 「%CSTR:일인칭%, 엉덩이 속까지 다 보여져선…」
				PRINTFORMW  해방감과 부끄러운 곳을 들여다보이고 있다는 사실에 %CALLNAME%은(는) 흥분하고 있다…
			;それ以外
			ELSE
				PRINTFORML 「%CSTR:일인칭%, 엉덩이 속까지 다 보여져선…」
				PRINTFORMW  %CALLNAME%은(는) 눈물 젖은 눈으로 중얼거렸다
			ENDIF
		ENDIF

