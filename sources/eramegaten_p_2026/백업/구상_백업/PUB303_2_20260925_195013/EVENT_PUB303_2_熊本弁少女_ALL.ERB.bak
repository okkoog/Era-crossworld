			CALL TRAIN_MESSAGE
			;初めての感想
			IF CFLAG:361 == 1 || FLAG:7 == 2
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ELSE
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
					IF RAND:2 == 0
						PRINTFORMW 「입을 쓰고 싶어진겨?」
					ELSE
						PRINTFORMW 「침이 줄줄 흘러나와 버렸당께」
					ENDIF
				ELSE
					PRINTFORML 「푸하」
					PRINTFORMW 「숨은 쉴 수 있어도 괴롭단 말이여」
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;108,삼각목마
;-------------------------------------------------
	CASE 108
	;素質によ읏て地の文が変わるので口上も変える
	IF TEQUIP:삼각목마
		IF ABL:마조끼 >= 5 || TALENT:마조
			;初めて
			IF CFLAG:463 == 0
				IF RAND:2 == 0
					IF HAVE_PENIS()
						PRINTFORML 「이러믄 여기에 자지가 닿겠구먼」
						PRINTFORML 「그러믄……」
					ELSE
						PRINTFORML 「이러믄 여기에 콩알이 닿아서……」
					ENDIF
					PRINTFORM 처음 보는 목마에 올라타게 될 자신을 상상하며 흥분하고 있다
					CALL TRAIN_MESSAGE
					PRINTFORML 「오오오오오」
					PRINTFORMW 「생각했던 대로랑께♪」
				ELSE
					CALL TRAIN_MESSAGE
					PRINTFORML 「저번에도 생각했지만서도, 굉장해 이거」
					PRINTFORMW 「몸이 찢어져 버릴 것 같은디 대단해, 이거!」
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「또 이거, 하는 거구먼」
					PRINTFORM 아직 타지도 않았는데 기대감으로 벌써 젖어있다
					CALL TRAIN_MESSAGE
				ELSE
					CALL TRAIN_MESSAGE
					PRINTFORML 「저번에도 생각했지만서도, 굉장해 이거」
					PRINTFORMW 「몸이 찢어져 버릴 것 같은디 대단해, 이거!」
				ENDIF
			ENDIF
		ELSE
			CALL TRAIN_MESSAGE
			IF RAND:2 == 0
				PRINTFORMW 「찌, 저, 찢어져~~~!」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「주, 죽어, 죽어버려!」
			ELSE
				PRINTFORML 「부서져! %CSTR:일인칭% 몸, 부서져 버려!」
				PRINTFORMW 「도와줘, %CSTR:이인칭%, 살려줘!」
			ENDIF
		ENDIF
		CFLAG:463 = 1
	;降りた時
	ELSE
		CALL TRAIN_MESSAGE
		IF ABL:마조끼 >= 5 || TALENT:마조
			PRINTFORM 「괴롭지만서도 말여, 그게 좋았당께……♪」
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「가랑이, 안 찢어졌제」
			ELSE
				PRINTFORMW 「죽는 줄 알았당께···」
			ENDIF
		ENDIF
	ENDIF

;-------------------------------------------------
;109,사정멈추기
;-------------------------------------------------
	CASE 109
	IF TEQUIP:42
		IF CFLAG:464 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				PRINTFORMW 「프레젠트？」
				PRINTFORM %CALLNAME:MASTER%은(는) 고개를 끄덕이더니
				CALL TRAIN_MESSAGE
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「선물은 기쁘지만서도, 자지가 괴롭당께…」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「자지, 귀염받아 버렸구먼♪」
					PRINTFORMW 「자아, %CSTR:일인칭% 자지, 맛있게 드시게%ハート()%」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「%CSTR:이인칭%의 선물」
					PRINTFORMW 「괴롭지만서도…… 기뻐」
				ENDIF
			ELSE
				CALL TRAIN_MESSAGE
				PRINTFORMW 「그렇게 묶으믄 자지가 썩어서 툭 떨어져 버린다구…」
			ENDIF
			CFLAG:464 = 1
		ELSE
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「사정 금지인겨?」
					PRINTFORM %CALLNAME:MASTER%은(는) 고개를 끄덕이더니
					CALL TRAIN_MESSAGE
					PRINTFORMW 「못 참겠거든 리본 풀어줄겨?」
				ELSE
					CALL TRAIN_MESSAGE
					PRINTFORMW 「참았다가 사정하믄, 평소보다 잔뜩 나와서 기분 좋겠제%ハート()%」
				ENDIF
			ELSE
				CALL TRAIN_MESSAGE
				IF RAND:2 == 0
					PRINTFORMW 「사정하고 싶진 않지만서도, 아픈 것도 싫어…」
				ELSE
					PRINTFORMW 「자지 부서져 버려…」
				ENDIF
			ENDIF
		ENDIF
		CFLAG:464 = 1
	;リボン解除
	ELSE
		CALL TRAIN_MESSAGE
		;射精した事がなか
		IF EXP:사정경험 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				PRINTFORMW 「자지, 귀여워졌지만서도, 괴로웠당께」
			ELSE
				PRINTFORMW 「왠지 몸속에서 치밀어 오르고 있어……」
			ENDIF
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF HAVE_VAGINA(MASTER)
						PRINTFORMW 「%CSTR:이인칭%도 섹스하고 싶어진 거구먼」
						PRINTFORMW 「참은 만큼, 보지에 잔뜩 사정해 줄게%ハート()%」
					ELSE
						PRINTFORMW 「잔뜩 사정할 테니께, 똑똑히 지켜봐줘♪」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF HAVE_VAGINA(MASTER)
						PRINTFORMW 「참은 만큼, %CSTR:이인칭% 보지에 잔뜩 사정해 줄게♪」
					ELSE
						PRINTFORMW 「참은 만큼, 분수맹키로 사정할 테니께 지켜봐줘♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「자지가 묶여서 꽁꽁 빳빳해져 버렸당께」
					PRINTFORMW 「%CSTR:이인칭%, 사정해도 괜찮은겨?」
				ENDIF
			ELSE
				PRINTFORMW 「안 돼, 지금 풀믄……」
			ENDIF
		ENDIF
	ENDIF

;=================================================
;助手によるコマンド、及びレズプレイ
