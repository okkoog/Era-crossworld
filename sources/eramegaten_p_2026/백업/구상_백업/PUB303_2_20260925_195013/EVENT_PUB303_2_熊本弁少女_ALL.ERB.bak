				PRINTFORMW 「대단했당께……%ハート()%」
			ENDIF
			CFLAG:380 = 1
		;二回目以降
		ELSEIF CFLAG:380 < 2 || FLAG:7 == 2
			CALL TRAIN_MESSAGE
			IF RAND:3 == 0
				PRINTFORMW 「몇 번을 해봐도 대단하구마, 이거……%ハート()%」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「이러다 버릇돼 버리겠어……%ハート()%」
			ELSE
				PRINTFORMW 「%CSTR:일인칭%의 안에…… 조끔 들어가버렸당께……%ハート()%」
			ENDIF
			CFLAG:380 = 2
		ENDIF

