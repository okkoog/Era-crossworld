;40,로터
;-------------------------------------------------
	CASE 40
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:322 == 0 && FLAG:7 == 2
			IF CFLAG:330 == 0
				;ブルブル震えて小さい何か＝電動式のネズミのおもちゃみたいなものと思읏たようです
				PRINTFORMW 「그건 뭐여? 고양이 장난감?」
				PRINTFORMW 「…와, 뭐, 뭐할라고?」
				PRINTFORMW 「…히아앗!?」
				CFLAG:322 = 1
			;乳首ロ─タ─経験済み
			ELSE
				PRINTFORMW 「또, 또 그 진동하는 거 쓸라고?」
				PRINTFORMW 「…어라, 가슴에 쓰는 거 아녀…」
				PRINTFORMW 「…히아앗!?」
			ENDIF
			CFLAG:322 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:322 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORMW 「아, 앙! 아앙! 이것, 도, 좋기는 한디…… %CSTR:이인칭%이 만져주시게나…… 거기이, 직접으루우%ハート()%」
					ELSE
						PRINTFORMW 「%CSTR:이인칭%… %CSTR:이인칭%이 좋단 말이여어%ハート()%」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) 진동의 유열에 젖어들며, 촉촉해진 눈빛을 %CALLNAME:MASTER%에게 보내왔다.
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「에헤헤, 야한 장난감, 너~무 좋아%ハート()%」
					PRINTFORMW 「이러고 있으믄 금방… 앗! 힉! 아앙! 기분 좋아! 앙! 져버린당께에!!」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「아후, 응, 아아, 장난감 기분 좋아아 아, 아, 응, 후」
					PRINTFORMW 「%CSTR:일인칭%도, 읏, %CSTR:이인칭% 전용 장난감, 앙, 이니께 가~득 기분 좋게 해주고 싶구먼%ハート()%」
				ENDIF
				CFLAG:322 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:322 < 3 || FLAG:7 == 2)
				PRINTFORMW 「응, 히, 아앗」
				PRINTFORMW 「부, 부르르 떨려서 기분 좋아…」
				CFLAG:322 = 3
			;それ以外
			ELSEIF CFLAG:322 < 2 || FLAG:7 == 2
				PRINTFORMW 「그, 그렇게 너무 마구 만지작대지 말어」
				CFLAG:322 = 2
			ENDIF
		ENDIF

