				PRINTFORMW 「더, 더 팡팡 쑤셔줘어!」
				IF TEQUIP:Ａ삽입자 == MASTER
					PRINTFORMW 「노예인데도 기분 좋아져 있는 %CSTR:일인칭% 엉덩이, 찰싹찰싹 때려줘도 좋응께에」
				ELSE
					PRINTFORMW 「노예인데도 기분 좋아져 있는 %CSTR:일인칭% 엉덩이, 찰싹찰싹 때려줘도 구우~」
					PRINTFORMW 시끄러운 %CALLNAME%의 입을 %CALLNAME:ASSI%의 페니스로 틀어막게 했다
				ENDIF
			ENDIF
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3 && FLAG:7 == 2
			PRINTFORML 「둘이서 덤벼드는 건 안 된당께…」
			IF RAND:2 == 0
				PRINTFORMW 「이렇코롬 기분 좋은 거, 못 참는당께!」
			ELSE
				PRINTFORMW 「이래선, %CSTR:일인칭% 진짜로 져버린다구」
			ENDIF
		;それ以外
		ELSEIF FLAG:7 == 2
			IF CFLAG:440 == 0
				PRINTFORMW 「둘이서 덤비는 건 치사해애!」
			ELSE
				PRINTFORML 「아, 안 돼!」
				PRINTFORMW 「%CSTR:일인칭%, 부서져버려!」
			ENDIF
		ENDIF
		CFLAG:440 = 1

;-------------------------------------------------
;515,애널흐트러진모란
;-------------------------------------------------
	CASE 515
		CALL TRAIN_MESSAGE
		IF CFLAG:441 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORML 「이런 식으로 이어져 있는 거」
					PRINTFORMW 「부끄럽지만, 기쁘네에%ハート()%」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「엉덩이인데도 꼬추 들어가 있는 게 훤히 보이네」
					PRINTFORMW 「보지가 외로워 보이는 게 아주 잘 보이네」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「어뗘, %CSTR:이인칭%」
					PRINTFORMW 「%CSTR:일인칭%의 부끄러운 꼴, 잘 보여?」
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && FLAG:7 == 2
				PRINTFORML 「이런 부끄러운 꼴로……」
				PRINTFORMW %CALLNAME%은 거울에 비친 자신의 모습을 바라보고 있다
			;それ以外
			ELSEIF FLAG:7 == 2
				PRINTFORMW 「안 돼애」
				PRINTFORML 「이런 부끄러운 꼴이라니!」
				PRINTFORMW 다리를 오므리려는 %CALLNAME%의 발목을 붙잡아 크게 벌렸다
			ENDIF
			CFLAG:441 = 1
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORML 「시러어어」
						PRINTFORMW 「%CSTR:일인칭%의 어린애 애널, %CSTR:이인칭% 거 그렇게 큰데도 맛있게 먹고 있어어」
						PRINTFORMW 「애널 섹스 보여주면 안 대애애!%ハート()%」
					ELSE
						PRINTFORML 「봐봐」
						PRINTFORMW 「엉덩이로 이어져 있어」
						PRINTFORMW 「몸속에서 %CSTR:이인칭%을 느끼고 있어어%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「엉덩이인데도 꼬추 들어가 있는 게 훤히 보이네」
						PRINTFORMW 「평소보다 더 흥분되네잉♪」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「변태 같은 엉덩이로 꼬추를 물고 있어♪」
						PRINTFORMW 「더 깊숙이 넣어도 좋아아♪」
					ELSE
						PRINTFORML 「거울 건너편의 %CSTR:일인칭%도」
						PRINTFORMW 「엉덩이로 섹스해서 기분 좋아 보이네에♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORML 「엉덩이로 섹스하는 거 훤히 보여서」
					ELSE
						PRINTFORML 「이런 식으로 꼬추랑 이어져서」
					ENDIF
					PRINTFORMW 「%CSTR:이인칭%, %CSTR:일인칭%, 억수로 행복하당께%ハート()%」
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && FLAG:7 == 2
				PRINTFORMW 「똥구멍인데도」
				IF RAND:2 == 0
					PRINTFORMW 「%CSTR:일인칭% 안에 저런 꼬추가 들어가 있어……」
				ELSE
					PRINTFORMW 「이렇게나 부끄러운 꼴로 섹스하고 있는디도……」
				ENDIF
			;それ以外
			ELSEIF FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「안 돼애」
					PRINTFORMW 「엉덩이로 섹스하는 거 보여주지 마앗!」
				ELSE
					PRINTFORMW 「이런 부끄러운 모습으로」
					PRINTFORMW 「엉덩이에 꼬추 같은 거 넣지 마!」
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;516,전립선자극
;-------------------------------------------------
	CASE 516
		CALL TRAIN_MESSAGE
		IF CFLAG:445 == 0 && FLAG:7 == 2
			PRINTFORMW 「뭐야? 이 감각」
			PRINTFORMW 「엉덩이인데 다른 곳이 기분 좋아……」
			CFLAG:445 = 1
		;連続前立腺刺激
		ELSEIF PREVCOM == 516
			PRINTFORMW 「그렇게 계속 엉덩이 공격당해버리면……」
		ELSE
			PRINTFORML 「안 돼」
			PRINTFORMW 「엉덩이에 손가락 들어가 있는데 몸이 반응해버린당께!」
		ENDIF

;-------------------------------------------------
;517,삽입전립선고문
;-------------------------------------------------
	CASE 517
		CALL TRAIN_MESSAGE
		;初回実行時
		IF CFLAG:445 == 0 && FLAG:7 == 2
			PRINTFORMW 「뭐야? 이 감각」
			PRINTFORMW 「엉덩이인데 다른 곳도 기분 좋은 것 같아……」
			CFLAG:445 = 1
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「그렇게 계속 꼬추로 엉덩이 공격당해버리면……」
			ELSE
				PRINTFORML 「안 돼읏」
				PRINTFORMW 「엉덩이에 꼬추 들어가 있는데 몸이 반응해버린당께!」
			ENDIF
		ENDIF

;-------------------------------------------------
;520,삽입전립선고문시킨다
;-------------------------------------------------
	CASE 520
		CALL TRAIN_MESSAGE
		IF CFLAG:447 == 0
			PRINTFORML 「엉덩이에 꼬추 들어가 있는데」
			PRINTFORMW 「그렇게 기분 좋아 보이는 얼굴을 하고」
			;助手を責めさせている場合
			IF ASSI > 0 && ASSIPLAY
				PRINTFORMW 「%CALLNAME:ASSI%도 사실은 변태 씨였구먼♪」
			ELSE
				PRINTFORMW 「%CSTR:일인칭%도 참, 야해♪」
			ENDIF
			CFLAG:447 = 1
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				IF RAND:3 == 0
					PRINTFORMW 「헤롱헤롱해져버린 %CSTR:이인칭% 얼굴, 더 보여줘%ハート()%」
				ELSEIF RAND:2 == 0
					PRINTFORML 「자아, 자아」
					PRINTFORMW 「기분 좋제??」
					PRINTFORMW 「안 참고 사정해도 괜찮은디?」
				ELSE
					PRINTFORML 「남자인데 엉덩이에 꼬추 들어가서」
					PRINTFORML 「꼬추를 뀩뀩거리면서 느끼고」
					PRINTFORML 「변태 씨구먼♪」
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「스스로 엉덩이에 꼬추 넣어주길 바란다니」
					PRINTFORMW 「어쩔 도리가 없는 변태구먼」
					PRINTFORMW 「자, 괴롭힘당하는 게 기분 좋은 거지?」
				ELSE
					PRINTFORML 「이래선 누가 조교당하고 있는지 모르겠네」
				ENDIF
			ENDIF
		ENDIF


;=================================================
;600番台,非戦闘員コマンド
;=================================================
;-------------------------------------------------
;600,戦闘訓練
;-------------------------------------------------
	CASE 600
		CALL TRAIN_MESSAGE
		IF RAND:3 == 0
			PRINTFORMW 「%CSTR:일인칭%, 조금은 강해졌어?」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「지쳤다~」
			PRINTFORMW 「아이스크림 먹고 시퍼~」
		ELSE
			PRINTFORMW 「%CSTR:이인칭%은 이렇게 힘든 훈련을 하고 있었구먼」
		ENDIF

;-------------------------------------------------
;601,시험소환
;-------------------------------------------------
	CASE 601
		CALL TRAIN_MESSAGE
		PRINTFORMW 「해냈당께, 악마 소환!」
		IF RAND:3 == 0
			PRINTFORMW 「이걸로 %CSTR:일인칭%도 조교 말고도 쓸모가 있게 됐네%ハート()%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「악마 소환사 %CALLNAME%」
			PRINTFORMW 「여기 탄생!!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「이걸로 %CSTR:일인칭%도 쑥쑥 레벨 올릴 거여 악마%ハート()%」
		ENDIF

;-------------------------------------------------
;602,그림자추출
;-------------------------------------------------
	CASE 602
		CALL TRAIN_MESSAGE
		PRINTFORMW 「이게 또 한 명의 %CSTR:일인칭%…」
		IF RAND:3 == 0
			PRINTFORMW 「이걸로 %CSTR:일인칭%도 조교 말고도 쓸모가 있게 됐네%ハート()%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「에~ 그러니까」
			PRINTFORMW 「처, 처음 뵙겠습니다?」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%을 위해서, 함께 힘내자♪」
		ENDIF

;-------------------------------------------------
;603,각성원조
;-------------------------------------------------
	CASE 603
		CALL TRAIN_MESSAGE
		IF RAND:2 == 0
			PRINTFORMW 「이걸로 %CSTR:일인칭%도 조교 말고도 쓸모가 있게 됐네%ハート()%」
		ELSE
			PRINTFORMW 「이걸로 %CSTR:일인칭%도 %CSTR:이인칭%과 함께 싸울 수 있네%ハート()%」
		ENDIF

;-------------------------------------------------
;604,바이러스조사
;-------------------------------------------------
	CASE 604
		CALL TRAIN_MESSAGE
		IF RAND:2 == 0
			PRINTFORMW 「이걸로 %CSTR:일인칭%도 조교 말고도 쓸모가 있게 됐네%ハート()%」
		ELSE
			PRINTFORMW 「이걸로 %CSTR:일인칭%도 %CSTR:이인칭%과 함께 싸울 수 있네%ハート()%」
		ENDIF

;-------------------------------------------------
;605,영매실험
;-------------------------------------------------
	CASE 605
		CALL TRAIN_MESSAGE
		IF RAND:2 == 0
			PRINTFORMW 「이걸로 %CSTR:일인칭%도 조교 말고도 쓸모가 있게 됐네%ハート()%」
		ELSE
			PRINTFORMW 「이걸로 %CSTR:일인칭%도 %CSTR:이인칭%과 함께 싸울 수 있네%ハート()%」
		ENDIF

;-------------------------------------------------
;606,개조수술
;-------------------------------------------------
	CASE 606
		CALL TRAIN_MESSAGE
		IF RAND:2 == 0
			PRINTFORMW 「이걸로 %CSTR:일인칭%도 %CSTR:이인칭%과 함께 싸울 수 있네%ハート()%」
		ELSE
			PRINTFORMW 「다시 태어난 기계 몸」
			PRINTFORMW 「지켜봐 줘, %CSTR:이인칭%. %CSTR:일인칭%, 힘낼 테니까♪」
		ENDIF
		CASEELSE
		CALL TRAIN_MESSAGE
ENDSELECT


;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG関係（X1をキャラ番号に置換）
;パラメ─タ変化などをトリガ─にした口上　CFLAG 221～260を使用
;-------------------------------------------------
;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_A（X1をキャラ番号に置換）
;調教者の射精をトリガ─にした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_A_PUB303_2
;助手が調教した時に口上をスキ읏プする（好みに応じて使う、行頭の;を消すとスキ읏プするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボ─ルギャグ着用時には地の文を表示して口上をスキ읏プする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_A
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_A_PY1_PUB303_2
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_A_PY1_PUB303_2
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;調教者の射精時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;射精箇所変更時のテキスト　有効時はここで関数終了
;-------------------------------------------------
IF CFLAG:106
	CALL PALAM_MESSAGE_A
	;머리카락
	IF CFLAG:106 == 1
		;陥落済み
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:221 < 3 || FLAG:7 == 2)
			;淫乱、娼婦
			IF TALENT:음란 || TALENT:창부
				;野外プレイ中
				IF TEQUIP:29 > 0
					PRINTFORML 「이대로 돌아가버릴까♪」
				ELSE
					IF RAND:2 == 0
						PRINTFORML 「으~응. 이젠 머리카락 말고 다른 데에 내라구우~」
						PRINTFORML 「정액 냄새 억수로 좋아하긴 하지만, 닦아내는 건 힘들단 말이여」
					ELSE
						PRINTFORML 「아하, 머리카락 더러워져버렸다♪」
					ENDIF
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				IF RAND:2 == 0
					PRINTFORML 「%CSTR:이인칭% 정액 린스…」
				ELSE
					PRINTFORML 「앗%ハート()%」
					PRINTFORML 「%CSTR:이인칭% 정액, 뜨겁고 냄새나……%ハート()%」
				ENDIF
			;恋慕、親愛
			ELSE
				;サンタコ─トを着ている場合
				IF TEQUIP:90 == 1034
					PRINTFORML 「와아~~」
					PRINTFORML 「화이트 크리스마스다아%ハート()%」
				ELSEIF RAND:2 == 0
					PRINTFORML 「우후후…… 머리, 끈적끈적하네에%ハート()%」
				ELSE
					PRINTFORML 「정말~, %CSTR:이인칭% 심술쟁이이~」
					PRINTFORML 「깨끗하게 씻는 거 힘들단 말이여」
				ENDIF
			ENDIF
			PRINTFORMW %CALLNAME%은 미소 지으며, 정액 냄새와 맛을 즐기고 있다.
			CFLAG:221 = 3
		;反発刻印Lv3
		ELSEIF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
			;野外プレイ中
			IF TEQUIP:29 > 0
				IF RAND:2 == 0
					PRINTFORML 「『이대로 돌아가』라고 하면 화낼 거랑께」
				ELSE
					PRINTFORML 「이런 냄새나는 걸 묻힌 채로 집에 돌아가게 할 셈이야?」
				ENDIF
				PRINTFORMW %CALLNAME%은 불만스러워 보인다
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「이런 냄새나는 거, 머리카락에 뿌리지 말라구!」
				ELSE
					PRINTFORMW 「%CSTR:일인칭%의 예쁜 머리카락에 무슨 짓을 하는 거여!」
				ENDIF
				IF HAVE_VAGINA()
					PRINTFORML 
					IF RAND:2 == 0
						PRINTFORML 「머리카락에 정액 뿌려주셔서, 감사합니다」
						PRINTFORML 「%CSTR:일인칭%, 억수로 기쁘네……」
					ELSE
						PRINTFORML 「냄새나는 정액으로 린스 받아서, %CSTR:일인칭%은 행복하당께…」
					ENDIF
					PRINTFORML 불평을 늘어놓는 %CALLNAME%이었지만
					PRINTFORML 『그럼 네 보짓속에 내보내 줄까?』하고 묻자 %CALLNAME%은 얌전해졌다…
				ENDIF
			ENDIF
			CFLAG:221 = 2
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3 && (CFLAG:221 < 2 || FLAG:7 == 2)
			IF RAND:2 == 0
				PRINTFORMW 「정말~, 나중에 씻는 거 힘들단 말이여」
			ELSE
				PRINTFORMW 「정말~, 머리카락에 냄새 배면 책임지랑께」
			ENDIF
			CFLAG:221 = 2
		;それ以外
		ELSEIF CFLAG:221 < 1 || FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORMW 「우와아… 정액 냄새나…」
			ELSE
				PRINTFORML 「우와아… 머리카락 끈적끈적해애」
			ENDIF
			PRINTFORMW %CALLNAME%은 원망스러운 듯 이쪽을 째려보았다.
			CFLAG:221 = 1
		ENDIF
	;顔
	ELSEIF CFLAG:106 == 2
		;陥落済み
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:222 < 3 || FLAG:7 == 2)
			;淫乱、娼婦
