				IF CFLAG:465 == 0
					PRINTFORMW 「%CSTR:이인칭% 보지, 이렇게 생겼던 거구먼」
					SIF HAVE_VAGINA()
					PRINTFORMW 「%CSTR:일인칭%이랑 모양이 조금 다른 것 같네」
				ELSEIF HAVE_PENIS()
					IF TALENT:PLAYER:처녀
						PRINTFORMW 「저기…… 처음을 받아도 될까나?」
					ELSE
						PRINTFORMW 「얼른 둘이서 아기 만들자구%ハート()%」
					ENDIF
				ELSE
					PRINTFORMW 「핥아줬으면 좋겠어?」
				ENDIF
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				IF HAVE_PENIS()
					IF TALENT:PLAYER:처녀
						PRINTFORMW 「아직 처녀인 것 같구」
						PRINTFORMW 「%CSTR:일인칭%이 첫 상대가 되어줄까나♪」
					ELSE
						PRINTFORMW 「저기, 얼른 거기에 자지 넣어도 돼?」
					ENDIF
				ELSE
					PRINTFORMW 「핥아줄까? 아니면 바이브 넣을까?」
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				IF HAVE_PENIS()
					PRINTFORMW 「부탁드립니다」
					IF CFLAG:465 == 0
						PRINTFORMW 「얼른 %CSTR:일인칭% 자지, 보지에 넣게 해주면 안 돼」
					ELSE
						PRINTFORMW 「보여주기만 하지 말구, 보지 쓰게 해주면 안 돼」
					ENDIF
				ELSE
					PRINTFORMW 「%CSTR:이인칭%, 다음엔 %CSTR:일인칭% 보지도 봐주면 안 돼…」
				ENDIF
			ENDIF
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3 && FLAG:7 == 2
			IF HAVE_PENIS()
				PRINTFORMW 「저, 저기……」
				PRINTFORMW 「그 보지에 %CSTR:일인칭% 자지, 넣어도 돼?」
			ELSE
				PRINTFORMW 「……치녀?」
			ENDIF
		;それ以外
		ELSEIF FLAG:7 == 2
			IF HAVE_VAGINA()
				IF CFLAG:465 == 0
					PRINTFORML 「으~음, %CSTR:일인칭%이랑은 모양이 다른 것 같네」
				ELSE
					PRINTFORML 「으~음, 이 부분도 다른 것 같구……」
				ENDIF
				PRINTFORMW %CALLNAME%은(는) 자신의 성기와 비교해보고 있다
			ELSE
				PRINTFORMW 「그렇게 %CSTR:일인칭% 자지가 갖고 싶은겨?」
				PRINTFORMW 「하지만서도, 나쁜 병 같은 거 갖고 있을 것 같구」
			ENDIF
		ENDIF
		CFLAG:465 = 1

