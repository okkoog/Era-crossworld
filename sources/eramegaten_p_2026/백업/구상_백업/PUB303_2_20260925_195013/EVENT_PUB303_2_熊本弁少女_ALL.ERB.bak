;-------------------------------------------------
;512,_アナル騎乗乳房自慰
;-------------------------------------------------
	CASE 512
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:419 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:419 < 4 || FLAG:7 == 2)
				PRINTFORML 「앙, 앙, 앙!」
				PRINTFORMW 「이거, 억수로 기분 좋네! %CSTR:이인칭%!」
			ELSE
				PRINTFORML 「이런 짓을 당해선…… 응읏♪」
				PRINTFORMW %CALLNAME%은(는) 밑에서 찔러 올려지면서도 소리를 죽인 채 스스로를 위로하고 있다
			ENDIF
			CFLAG:419 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:419 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORML 「응, 앗! 하후, 응후! 엉덩이, 기분 좋아앗%ハート()%」
					PRINTFORMW %CALLNAME%은(는) 밑에서 찔러 올려지면서, 홀린 듯 자신의 가슴을 애무하고 있다.
					PRINTFORML 「기분 좋은 거, 멈추질 않아앗%ハート()% 더 격렬하게엣%ハート()%」
					PRINTFORMW 허리를 흔드는 속도를 올려주자 %CALLNAME%도 자신의 가슴을 격렬하게 애무하고 있다
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW %CALLNAME%은(는) 찔러 올려지며, 스스로 나서서 자신의 가슴을 애무하기 시작한다.
						PRINTFORML 「더! 더 엉덩이, 푹푹 쑤셔줘어!」
					ELSE
						PRINTFORML 「자위하면서 똥구멍으로 섹스하고 있는 %CSTR:이인칭% 봐줘」
						PRINTFORML 「정액 잔뜩 싸주시게♪」
					ENDIF
					PRINTFORMW 몸속을 내달리는 쾌락에 지지 않으려는 듯 %CALLNAME%은 자신의 가슴을 격렬하게 애무하고 있다……
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「꼬추가, 엉덩이 속에서, 대난동 피우고 있어어!」
						PRINTFORMW 「%CSTR:이인칭%, 꼬추, 꼬추 고마워어%ハート()%」
						PRINTFORML 「%CSTR:일인칭%도, 스스로옷, 기분 좋아질 테니까!」
						PRINTFORMW 몸속을 내달리는 쾌락에 지지 않으려는 듯 %CALLNAME%은 자신의 가슴을 격렬하게 애무하고 있다……
					ELSE
						PRINTFORML 「똥구멍으로 섹스하고」
						PRINTFORMW 「못 참게 돼서 자위해버리는 나쁜 %CSTR:일인칭%을」
						PRINTFORMW 「더 똥구멍 써주라아♪」
					ENDIF
				ENDIF
				CFLAG:419 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:419 < 3 || FLAG:7 == 2)
				PRINTFORML 「섹스하기 위한 구멍이 아닌데도……」
				PRINTFORMW 「엉덩이도 가슴도 기분 좋아서 녹아버릴 것 같아♪」
				CFLAG:419 = 3
			;それ以外
			ELSEIF CFLAG:419 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORML 「엉덩이로 느끼고 있다니 아냐!」
					PRINTFORMW 「기, 기분 좋은 건 가슴인 거란 말이여」
				ELSE
					PRINTFORMW 「이런 짓이나 시키고……」
					PRINTFORML 「나, 나중에 용서 안 해줄 거니께!」
					PRINTFORMW 원망하는 말을 하면서도 %CALLNAME%의 손놀림은 멈출 기미가 보이지 않는다
				ENDIF
				CFLAG:419 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;513,입과바기나를범한다
;-------------------------------------------------
	CASE 513
		CALL TRAIN_MESSAGE
		;処女
		IF TALENT:0
			PRINTFORMW 「에, 에, 3명이서!?」
			;恋慕、親愛
			IF (TALENT:연모 || TALENT:친애) && FLAG:7 == 2
				;Ｖ挿入があなた
				IF (TEQUIP:Ｖ삽입자) == MASTER
					PRINTFORMW 「억수로 좋아하는 %CSTR:이인칭%과의 처음이 이런 거라니…」
				;Ｖ挿入が助手
				ELSE
					PRINTFORMW 「처음인데도… %CSTR:이인칭%의 꼬추가 눈앞에 있는데도…」
				ENDIF
			;淫乱、服従、娼婦、隷属
			ELSEIF (TALENT:음란 || TALENT:복종 || TALENT:창부 || TALENT:예속) &&  FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「조금 긴장되지만, 두근두근거리네」
				ELSE
					PRINTFORML 「그 말인즉슨」
					PRINTFORMW 「위도 아래도 한꺼번에 꼬추가 들어가버리는 거네♪」
				ENDIF
			ELSE
				PRINTFORML 「안 돼! 절대로 안 돼!」
				PRINTFORML 「몸이 두 동강 나버린다구!」
				PRINTFORMW %CALLNAME%의 비명을 무시하고 %CALLNAME:MASTER%은 %CALLNAME:ASSI%에게 눈짓을 보내더니 둘이서 동시에 허리를 찔러넣었다
			ENDIF
		;それ以外
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF TEQUIP:Ｖ삽입자 == MASTER
						PRINTFORMW 「%CSTR:이인칭%이 좋은데, %CALLNAME:ASSI%의 꼬추 기분 좋아!」
						PRINTFORML 「그러니까, 그 이상으로 %CSTR:이인칭%을 기분 좋게 해줄게!」
						PRINTFORMW %CALLNAME%은 스스로 %CALLNAME:MASTER%의 페니스를 물더니, 평소 이상으로 격렬하게 봉사를 시작했다
					ELSE
						PRINTFORML 「%CSTR:일인칭% 보지, 기분 좋아?」
						PRINTFORMW %CALLNAME:PLAYER%은 %CALLNAME:ASSI%에게 눈짓 신호를 보낸다
						PRINTFORML 「저기, %CSTR:일인칭% 보… 웁!」
						PRINTFORMW %CALLNAME%이 입을 연 타이밍에 %CALLNAME:ASSI%은 페니스를 비틀어 넣었다
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF CFLAG:439 == 0
						PRINTFORMW 「위도 아래도 양쪽에 꼬추를 넣어버리는 거네」
						PRINTFORMW 「엄청 사치부리는구먼♪」
					ELSE
						IF RAND:2 == 0
							PRINTFORML 「하앙! 좋아아! 더 범해줘!」
							PRINTFORMW 「입이랑 보지, 둘이서 엉망진창으로 만들어줘어!」
						ELSE
							PRINTFORML 「위의 입도 아래의 입도 꼬추♪」
							PRINTFORMW 「욕심쟁이지만, 기분 좋으니까 어쩔 수 없네에, 앙앗%ハート()%」
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「부탁이여, %CSTR:이인칭%, %CALLNAME:ASSI%」
					IF RAND:2 == 0
						PRINTFORMW 「더, 더 팡팡 쑤셔줘어!」
					ELSE
						PRINTFORMW 「더 꼬추로 조교해줘어!」
					ENDIF
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && FLAG:7 == 2
				PRINTFORML 「둘이서 덤벼드는 건 안 된당께…」
				IF RAND:2 == 0
					PRINTFORMW 「이렇코롬 기분 좋은 거, 못 참는당께!」
				ELSE
					PRINTFORMW 「이래선, %CSTR:일인칭% 진짜로 져버린다구」
				ENDIF
			;それ以外
			ELSEIF FLAG:7 == 2
				IF CFLAG:439 == 0
					PRINTFORMW 「둘이서 덤비는 건 치사해애!」
				ELSE
					PRINTFORML 「아, 안 돼!」
					PRINTFORMW 「%CSTR:일인칭%, 부서져버려!」
				ENDIF
			ENDIF
		ENDIF
		CFLAG:439 = 1

