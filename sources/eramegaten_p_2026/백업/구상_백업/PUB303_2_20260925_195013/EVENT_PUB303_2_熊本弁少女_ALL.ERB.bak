;セ읏クス系コマンド
;=================================================
;-------------------------------------------------
;60,정상위
;-------------------------------------------------
	CASE 60
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:332 == 0
			;処女
			IF TALENT:0
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:332 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						;恋慕系陥落なんに処女喪失ば助手に相手さするちゅう、鬼ちく変態あたへんプレゼント
						IF ASSI > 0 && ASSIPLAY
							IF TALENT:아내
								PRINTFORML 「저기, 색시가 위기랑께」
								PRINTFORML 「어째서 보고만 있고 안 구해주는겨?」
								PRINTFORMW 머리맡에 앉아 있는 %CALLNAME:MASTER%에게 도움을 청하는 %CALLNAME%
								PRINTFORMW 하지만 %CALLNAME%은(는) 아무것도 하지 않고, 그저 %CALLNAME:ASSI%
								IF HAVE_PENIS(ASSI)
									PRINTFORM 의 페니스가 
								ELSE
									PRINTFORM 이(가) 차고 있는 페니스 밴드가 
								ENDIF
								PRINTFORMW %CALLNAME%의 질내로 천천히 들어가는 것을 지켜보기만 할 뿐이었다
								PRINTFORML 
								PRINTFORMW 「아파…… 아프단 말여어……」
								PRINTFORML %CALLNAME:MASTER%에게 배신당했다는 충격과 파과의 고통에 흐느끼며 도움을 청하는 %CALLNAME%의 얼굴과
								PRINTFORML 처음으로 이물을 받아들이고 피를 흘리는 %CALLNAME%의 질을 바라보며
								IF HAVE_PENIS(ASSI)
									PRINTFORMW %CALLNAME:MASTER%은(는) 지금까지 들인 수고가 헛되지 않았다는 것에 가랑이를 끓어오르게 하며 만족해하는 것이었다……
									PRINTFORML 
									PRINTFORMW 「어째서…… %CSTR:일인칭%이 심한 꼴을 당하고 있는디…… 흥분하고 자빠졌는겨……」
								ELSE
									PRINTFORMW %CALLNAME:MASTER%은(는) 지금까지 들인 수고가 헛되지 않았다는 것에 만족해하는 것이었다……
								ENDIF
								IF MARK:LOCAL:반발각인 < 3
									MARK:LOCAL:반발각인 = 3
									JUEL:LOCAL:복종 = 0
									JUEL:LOCAL:굴복 = 0
									PRINTFORML 
									PRINTFORMW ＞%CALLNAME%의 공순의 구슬이 0이 되었다
									PRINTFORMW ＞%CALLNAME%의 굴복의 구슬이 0이 되었다
									PRINTFORMW ＞%CALLNAME%의 반발각인이 3이 되었다
								ENDIF
							ELSE
								PRINTFORML 「%CSTR:일인칭%의 처음은 %CSTR:이인칭%하고일 줄 알았는디……」
								PRINTFORML 「어째서 %CALLNAME:ASSI%랑 짝짓기를 해야 하는겨?」
								PRINTFORML 「어째서 보고만 있는겨?」
								PRINTFORML 「어째서? 왜에?」
								PRINTFORM 시끄러운 %CALLNAME%을(를) 입다물게 하듯 %CALLNAME:ASSI%
								IF HAVE_PENIS(ASSI)
									PRINTFORM 의 페니스가 
								ELSE
									PRINTFORM 이(가) 차고 있는 페니스 밴드가 
								ENDIF
								PRINTFORMW %CALLNAME%의 질내로 단숨에 쑥 들어간다
								PRINTFORML 
								PRINTFORML 「어…… 앗…… 아파앗……」
								PRINTFORMW %CALLNAME%은(는) 배신당한 충격과 파과의 고통으로 울면서 멍하니 넋을 놓고 있다……
								IF MARK:LOCAL:반발각인 < 2
									MARK:LOCAL:반발각인 = 2
									JUEL:LOCAL:복종 = 0
									JUEL:LOCAL:굴복 = 0
									PRINTFORML 
									PRINTFORMW ＞%CALLNAME%의 공순의 구슬이 0이 되었다
									PRINTFORMW ＞%CALLNAME%의 굴복의 구슬이 0이 되었다
									PRINTFORMW ＞%CALLNAME%의 반발각인이 2가 되었다
								ENDIF
							ENDIF
						ELSE
							IF TALENT:170 && 体格差() > 1
								PRINTFORMW 비좁은 \@TALENT:유아체형 || TALENT:소인체형 ? 어린 질 # 비부\@에 강직을 비틀어 넣자, 이내 무언가 찢어지는 감촉이 들었다.
								PRINTFORMW 처녀막이라는 건 알고 있었으나, 물고 조여온다기보다는 한계까지 확장되어 있는 질 자체의 감촉이 불안을 자아내어 무심코 허리를 멈추고 %CALLNAME%의 눈동자를 들여다본다.
								PRINTFORMW 눈물에 젖은 그곳에는, 숨길 수 없는 아픔과 억누를 수 없는 환희가 넘쳐흐르고 있었다.
								PRINTFORMW 「엣, 윽, 에헤헤헷…… 드디어, 드디이어, 색시로…… 만들어, 주었구먼……%ハート()%」
								PRINTFORMW 「……응, 괜찮어…… 처녀막이니께…… 아, 안 아프당께?%ハート()%」
								PRINTFORMW 「……괘, 괜찮……으니께…… 응? ……깊숙이, 끝까지, 해줘%ハート()%? 안쪽에, 내보내서, 제대로, %CSTR:일인칭%을, 마누라로, 만들어주시게?%ハート()%」
							ELSE
								PRINTFORML 「괜찮당께… 어서 와…」
								PRINTFORML 「%CSTR:일인칭%의 소중한 거, %CSTR:이인칭%한테 주고 싶단 말이여」
								PRINTFORMW 똑바로 누워 두 팔을 벌리며, %CALLNAME%은(는) 애정 어린 미소를 지어 보였다.
								PRINTFORMW 치밀어 오르는 공포를 기특하게도 견디면서도, 그럼에도 몸을 바들바들 떨고 있다.
								PRINTFORML %CALLNAME:MASTER%은(는) %CALLNAME%에게 미소를 지어 보이며 몸의 힘을 빼라고 지시하고는,
								PRINTFORMW 부드럽게 위로하듯 페니스를 아직 남자를 모르는 질내로 침하시켜 들어갔다.
								PRINTFORML 「아, 아아! 흐… 으으!」
								PRINTFORMW 파과의 고통을 견디며, 눈에서 눈물을 흘리면서도 %CALLNAME%은(는) 미소지었다.
							ENDIF
							PRINTFORMW 「%CSTR:일인칭%… 드디어 %CSTR:이인칭%이랑…… 기뻐… 좋아, 억수로 좋아…」
							PRINTFORMW %CALLNAME%은(는) 팔을 %CALLNAME:MASTER%의 등에 두르며 깊은 입맞춤을 몇 번이고 나누었다.
						ENDIF
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						IF RAND:2 == 0
							PRINTFORML 「자지, 넣어줄 텐가?」
							PRINTFORMW 애타게 기다리던 먹이를 눈앞에 둔 강아지처럼, %CALLNAME%은(는) 눈을 반짝인다.
							PRINTFORMW 「…어서유! %CSTR:이인칭%의 자지로 %CSTR:일인칭%의 처녀 보지 엉망진창으로 헤집어줘%ハート()%」
						ELSE
							PRINTFORMW 「이걸로 %CSTR:일인칭%도 처녀와 작별이로구먼」
							PRINTFORML 「처음 겪는 꽉 낀 구멍으로 기분 좋아지시게나♪」
						ENDIF
						PRINTFORMW %CALLNAME%은(는) 다리를 벌려 비소를 드러내더니, 유혹하듯 허리를 띄우며 흔들어댔다.
					;服従、隷属
					ELSE
						IF RAND:2 == 0
							PRINTFORMW 「%CSTR:일인칭%의 처녀 보지, 써줄 텐가?」
							PRINTFORMW 「에헤헤, 이걸로 %CSTR:일인칭%의 보지도 %CSTR:이인칭% 것이로구먼%ハート()%」
						ELSE
							PRINTFORML 「처음 겪는 보지지만서도」
							PRINTFORMW 「%CSTR:이인칭%이 기뻐해 줄 수 있도록 힘낼 텐게 말여」
						ENDIF
					ENDIF
				;反発刻印LV3
				ELSEIF MARK:3 == 3 && (CFLAG:332 < 4 || FLAG:7 == 2)
					PRINTFORML 「%CSTR:일인칭%의 처음이 요런 놈이라니……」
					IF RAND:2 == 0
						PRINTFORMW %CALLNAME%은(는) 원한 서린 눈초리로 이쪽을 노려보고 있다
					ELSE
						PRINTFORMW %CALLNAME%은(는) 입술을 깨물며 고통과 굴욕을 견디고 있다
					ENDIF
				;屈服していない
				ELSEIF TFLAG:7 ==2
					IF RAND:2 == 0
						PRINTFORMW 「시, 싫어… %CSTR:일인칭%, 이런 거 처음이란 말여…」
						PRINTFORMW 「아, 아프게 하지 말어…」
					ELSE
						PRINTFORMW 「엣, 애 상대로 그런 짓을 하믄 범죄랑께」
						PRINTFORMW 「그랑게, 응? 고만두랑께」
					ENDIF
				ENDIF
			;それ以外
			ELSE
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:332 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						PRINTFORMW 「응, 와줘…」
						PRINTFORML 「%CSTR:이인칭%을, 원한당께…」
						PRINTFORMW %CALLNAME%은(는) 두 팔을 벌리며 %CALLNAME:MASTER%을(를) 유혹한다.
						PRINTFORMW %CALLNAME:MASTER%은(는) %CSTR:일인칭%을(를) 끌어안으며 천천히 페니스를 삽입해 들어갔다.
						PRINTFORML 「아, 하아… %CSTR:이인칭%이 안에 느껴져… 기뻐… 읏, 아, 아앙%ハート()%」
						PRINTFORMW 맺어졌다는 기쁨에 눈물을 흘리며, %CALLNAME%은(는) 스스로 허리를 움직여 갔다.
						PRINTFORMW 「앙! 아앙! %CSTR:이인칭%, 좋아, 억수로 좋아! 평생… 영원히! 히야앙!」
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						PRINTFORMW 「에헤헤, 평범한 자세로 짝짓기하는 것도 기분 좋구먼%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 다리를 벌려 유혹하듯 양팔을 벌리더니 요염한 곁눈질을 %CALLNAME:MASTER%에게 보냈다.
						PRINTFORMW 「얼른… %CSTR:이인칭%의 굵직한 자지로 %CSTR:일인칭%을 범해줘어%ハート()%」
					;服従、隷属
					ELSE
						PRINTFORMW 「조…… 좋당께%ハート()%」
						PRINTFORMW 「%CSTR:일인칭%의 야한 보지, 좋을 대로 써주시게나%ハート()%」
					ENDIF
				ELSE
					PRINTFORMW 「%CSTR:일인칭% 보지를 쓰고 싶은겨?」
					PRINTFORMW 「…너무 험하게는 하지 말어」
				ENDIF
			ENDIF
			CFLAG:332 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:332 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF 体格差() > 1
						PRINTFORML %CALLNAME%을(를) 깔아뭉개고 딱딱하게 반동하는 페니스의 각도를 맞춰 천천히 체중을 실어가며 억지로 흠뻑 젖은 \@TALENT:유아체형 || TALENT:소인체형 ? 어린 질 # 질내\@에 비틀어 넣어간다.
						IF TALENT:유아체형 || TALENT:소인체형
							PRINTFORM 미성숙한 %CALLNAME%의 어린애 보지로는, 
						ELSE
							PRINTFORM %CALLNAME%의 보지에 그 페니스는 너무나 거대하여, 
						ENDIF
						PRINTFORMW 끝부분이 자궁경부에 닿았는데도 페니스의 6할 정도밖에 들어가지 않고 있다.
						PRINTFORMW 육봉을 다 담아내지 못하는 안타까움과, 기둥 둘레 전체를 꽉 조여오는 좁음, 높은 체온으로 인한 뜨거움이 기분 좋다.
					ENDIF
					IF RAND:4 == 0 && (TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐)
						PRINTFORML 「으응%ハート()% 하앙%ハート()%」
						PRINTFORMW 그 %CALLNAME%이(가) 성교 중에 스스로 다리를 얽어매 오게 될 줄이야…
						PRINTFORML 
						PRINTFORMW 「뭐, 뭘 쪼개고 자빠졌는겨」
						PRINTFORML %CALLNAME:MASTER%은(는) %CALLNAME%의 머리를 쓰다듬고는 다시 허리를 움직이기 시작했다
						PRINTFORMW 「잠깐, 아까보다 격렬하잖여」
						PRINTFORML 　
						PRINTFORMW 「좋아%ハート()% 더, 더 해줘%ハート()%」
					ELSEIF RAND:3 == 0
						PRINTFORMW 「좋아… 좋아, 조아, 억수로 좋아!」
						PRINTFORMW 「억수로 좋아, 징하게 조탄 말이여! 앙! 히양! 하앙!」
						PRINTFORM %CALLNAME%은(는) 행복과 쾌락에 모든 것을 내맡긴 채, 
						IF 体格差() > 1
							PRINTFORMW 꽉, 꽉, 하고 \@TALENT:유아체형 || TALENT:소인체형 ? 어린 질 # 질내\@를 꿈틀거리고 있다.
						ELSE
							PRINTFORMW 정신없이 허리를 계속 움직인다.
						ENDIF
					ELSEIF RAND:2 == 0
						PRINTFORMW 「응, 아앙…… 에헤헤, %CSTR:일인칭%, 이 자세 좋아…」
						PRINTFORML 「%CSTR:이인칭% 얼굴을 볼 수 있잖여. 『사랑한다』는 게 잔뜩 느껴지는걸…%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 행복한 듯 %CALLNAME:MASTER%에게 미소짓더니 천천히 허리를 움직이기 시작했다.
						PRINTFORMW 「응, 읏, 아, 아, …%CSTR:일인칭%도… 앗, 앙… 사랑해… 앗! 앗! …좋아… 앗… 앙!」
					ELSE
						PRINTFORML 「%CSTR:일인칭% 속… %CSTR:이인칭% 자지로 가득 차 있어… 앗, 앗」
						PRINTFORMW %CALLNAME%은(는) 기쁜 듯 자신의 하복부를 쓰다듬고 있다.
						PRINTFORMW 「기쁘고, 행복하고, 기분 좋아서, %CSTR:일인칭%, 녹아내려 버릴 것 같당께…… 더, 더 많이 느끼게 해줘어%ハート()%」
						IF 体格差() > 1
							PRINTFORMW %CALLNAME%은(는) 유열과 환희의 눈물을 흘리며, 격렬하게 허리를 흔드는 %CALLNAME:MASTER%의 공세를 받아내고 있다……
						ELSE
							PRINTFORMW 유열과 환희의 눈물을 흘리며, %CALLNAME%은(는) 격렬하게 허리를 흔들고 있다……
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					K:1 = RAND:3
					IF K:1 == 0
						PRINTFORMW 「보지로 짝짓기하는 거, 너~무 좋아아%ハート()%」
						PRINTFORMW 「앙! 아앙! 좋아… %CSTR:일인칭%, 좋아, 조아아%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 스스로 허리를 격렬하게 움직이며, 쓰나미 같은 유열에 몸을 내맡기고 있다.
						PRINTFORMW 혀 꼬인, 본능 그대로의 교성을 방 안에 울려 퍼지게 하고 있었다.
						PRINTFORML 「좋아! 좋당께!! 섹스! 짝짓기이!! 기분 좋아아!!」
						PRINTFORMW 격렬하게 허리를 마구 흔들어대며, %CALLNAME%은(는) 쾌락의 바다에 빠져들고 있다.
						PRINTFORMW 「앙! 아앙! 자지, 조아아!! 더! 더 %CSTR:일인칭%을 범해줘어어! 으아앙!!」
						PRINTFORMW 자신의 말이 스스로의 흥분을 한층 부채질하는 것인지, %CALLNAME%의 밀호가 빨아들이듯 꽉 조여들었다.
					ELSE
						PRINTFORML 「에헤헤… %CSTR:이인칭%…… 가~득, 기분 좋게 해줄 텐게……%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 허리를 요염하게 돌리고, 질벽이 감질나는 듯 음미하게 꿈틀거린다.
						PRINTFORMW 「아, 아앙… 아하앙%ハート()% 자아… 정액 가득… %CSTR:일인칭%한테 뿜어줘. 잔뜩 주셔어%ハート()%」
					ENDIF
				;服従、隷属
				ELSE
					IF RAND:3 == 0
						PRINTFORMW 「에헤… 보지, 맘껏 쓰시게나%ハート()%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「%CSTR:이인칭%이 보지에 해줘서, %CSTR:일인칭%은 참말로 행복혀」
					ELSE
						PRINTFORML 「보지 조교 대단허구먼」
						PRINTFORMW 「조교당하고 있는디도 억수로 기분 좋당께」
					ENDIF
				ENDIF
				CFLAG:332 = 4
			;反発刻印LV3
			ELSEIF MARK:3 == 3 && (CFLAG:332 < 4 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORML 「이쪽 쳐다보지 말어!」
				ELSE
					PRINTFORML （이런 놈한테… 분하구먼……）
				ENDIF
				IF RAND:3 == 0
					PRINTFORMW %CALLNAME%은(는) 원한 서린 눈초리로 이쪽을 노려보고 있다
				ELSEIF RAND:2 == 0
					PRINTFORMW %CALLNAME%은(는) 입술을 깨물며 고통과 굴욕을 견디고 있다
				ELSEIF RAND:2 == 0
					PRINTFORMW %CALLNAME%은(는) 고개를 돌려 이쪽과 눈을 마주치지 않으려 하고 있다
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:332 < 3 || FLAG:7 == 2)
				PRINTFORML 「앗… 핫, 으아앙♪」
				IF RAND:2 == 0
					PRINTFORMW 「기… 기분 좋아… 앗…♪」
				ELSE
					PRINTFORMW 「인자, 안 돼… 안 된당께… 앗♪」
				ENDIF
				CFLAG:332 = 3
			;それ以外
			ELSEIF CFLAG:332 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「읏, 앗, 난폭하게, 하지 마, 알았제」
				ELSE
					PRINTFORMW 「이, 이쪽 보지 마…」
					PRINTFORMW 「%CSTR:이인칭% 얼굴 따위 보고 싶지도 않응게…」
				ENDIF
				CFLAG:332 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;61,후배위
;-------------------------------------------------
	CASE 61
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:333 == 0
			;処女
			IF TALENT:0
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:333 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						;恋慕系陥落なんに処女喪失ば助手に相手さするちゅう、鬼ちく変態あたへんプレゼント
						IF ASSI > 0 && ASSIPLAY
							IF TALENT:아내
								PRINTFORML 「저기, 색시가 위기랑께」
								PRINTFORML 「어째서 보고만 있고 안 구해주는겨?」
								PRINTFORMW 눈앞에 앉아 있는 %CALLNAME:MASTER%에게 도움을 청하는 %CALLNAME%
								PRINTFORMW 하지만 %CALLNAME:MASTER%은(는) %CALLNAME%이(가) 도망치지 못하도록 양손을 붙잡고, %CALLNAME:ASSI%에게 시작하라고 지시하는 것이었다……
								PRINTFORML 
								PRINTFORMW 「아파…… 아프단 말여어……」
								PRINTFORML %CALLNAME:MASTER%에게 붙잡혀 도망치지도 못하고, 그저 짐승처럼 뒤에서 범해지는 %CALLNAME%
								PRINTFORML 배신당한 충격과 파과의 고통에 흐느끼면서도 여전히 도움을 청하는 %CALLNAME%의 얼굴을 바라보며
								PRINTFORML 처음으로 이물을 받아들이고 피를 흘리는 %CALLNAME%의 질을 바라보며
								IF HAVE_PENIS(ASSI)
