			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:417 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「%CSTR:이인칭% 심술쟁이」
					PRINTFORMW 「%CSTR:일인칭% 꼬추, %CSTR:이인칭% 보짓속에 넣고 싶당께!」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORML 「누가 제일 잘 참나 시합이네에」
					PRINTFORMW 「제일 먼저 가버린 사람이 벌칙 받는 거여♪」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 
				ENDIF
				CFLAG:417 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:417 < 3 || FLAG:7 == 2)
				PRINTFORMW 「안 돼! 보지 샌드위치, 너무 기분 좋아서 이상해져버려」
				IF RAND:2 == 0
					PRINTFORMW 「더, 더 해줘!」
				ELSE
					PRINTFORML 「좋아?」
					PRINTFORMW 「%CSTR:이인칭%랑 %CALLNAME:ASSI%의 보지에 정액 뿌려도 돼?」
				ENDIF
				CFLAG:417 = 3
			;それ以外
			ELSEIF CFLAG:417 < 2 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:417 = 2
			ENDIF
		ENDIF

