	CASE 180
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:392 == 0
			;反発刻印持ち
			IF MARK:3 > 0 && FLAG:7 == 2
				;（穴開き）スク水ロ─ションプレイ
				IF ABL:종족 == 0 && (TEQUIP:전신속옷 == 710 || TEQUIP:전신속옷 == 711) && CFLAG:800 == 1
					PRINTFORML 「%CSTR:일인칭% 학교 수영복에」
					PRINTFORMW 「야한 소리 내면서 이상한 거 바르지 마시게!」
				ELSE
					PRINTFORML 「뭐여? 이 끈적거리는 건」
