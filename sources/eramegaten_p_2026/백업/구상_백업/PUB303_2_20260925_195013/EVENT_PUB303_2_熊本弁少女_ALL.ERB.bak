		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:403 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORML 「또 이런 장난이나 치고 자빠졌어」
						PRINTFORMW 「못된 아이에겐 벌을 줘버릴 테다%ハート()%」
					ELSE
						PRINTFORMW 「있잖여, 가고 싶을 때 못 가는 건 괴롭단 말이여」
						PRINTFORML 「그랑게」
						PRINTFORML 「가~득 사랑해 주지 않으믄, 화낼 거니께%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORML 「못 가게 되는 건 괴롭지만서도」
						PRINTFORMW 「나중에 한꺼번에 팍 터지는 게 좋구마잉♪」
					ELSE
						PRINTFORML 「또 이렇게 심술을 부린당께」
						PRINTFORMW 「약효가 떨어질 때까정, 이것저것 당해버리는 기제♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「%CSTR:이인칭%, 이 플레이는 괴롭지만서도…」
					PRINTFORMW 「약효가 떨어지믄 대단하당께♪」
				ENDIF
				CFLAG:403 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:403 < 3 || FLAG:7 == 2)
				PRINTFORML 「그 약, 나중에 괴롭단 말여」
				PRINTFORMW 「그랑께 말여, 착한 아이로 있을 팅께, 그만두자잉…?」
				CFLAG:403 = 3
			;それ以外
			ELSEIF CFLAG:403 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「그 약……」
				ELSE
					PRINTFORMW 「약 제대로 삼킬 팅께, 아무 짓도 하지 마시게…」
				ENDIF
				CFLAG:403 = 2
			ENDIF
		ENDIF

