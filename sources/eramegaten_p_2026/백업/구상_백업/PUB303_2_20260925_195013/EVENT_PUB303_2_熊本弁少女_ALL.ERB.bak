	CASE 65
		CALL EVENT_MESSAGE
		;恋慕、親愛
		IF TALENT:음란 || TALENT:창부 
			;エロ奉仕でも人が来なか읏た場合
			IF CFLAG:개별성적서비스 > 1
				PRINTFORMW (아무도 안 온 것에 감사한데이…)
			ELSEIF TALENT:아내
				PRINTFORML (%CALLNAME%이(가) 위험한 일 당하지 않도록…)
			ELSE
				PRINTFORML (어서 결혼할 수 있도록…)
			ENDIF
		;淫乱、娼婦
		ELSEIF TALENT:음란 || TALENT:창부 
			;エロ奉仕ありにしてたのに誰も来なか읏た場合
			IF CFLAG:1445 > 1
				PRINTFORML 　
				PRINTFORML 「뭐든지 다 해줄 텐디」
				PRINTFORMW 「아무도 안 오다니 심심해~애」
			ELSEIF RAND:2 == 0
				PRINTFORML 　
				PRINTFORML 「기도만 드리는 건 따분해가꼬 장난감 꽂아뒀는디」
				PRINTFORML 「아무도 눈치 채주지 않았구마… 읏♪」
				PRINTFORML 아무도 없어진 교회에서 %CALLNAME%은(는) 자위를 시작했다…
			ELSE
				PRINTFORML 　
				PRINTFORML 「교회에 온 사람들이 다 함께 윤간해 주도록 기도드렸는디」
				PRINTFORML 「아무것도 안 당했구마~아」
			ENDIF
		ELSEIF TALENT:복종 || TALENT:예속
			PRINTFORML 　
			PRINTFORML 「말씀하신 대로 장난감 꽂은 채로 기도드리고 계셨당게」
			PRINTFORML 「안 가고 꾹 참고서 힘냈응게, 상 받을 수 있능가?」
			PRINTFORML 
		;反発刻印Lv3
		ELSEIF MARK:3 >= 1
			PRINTFORML (하느님, 제발 %CSTR:일인칭%를 여기서 구해줘잉……)
		ELSE
			IF RAND:2 == 0
				PRINTFORML (빨리 집에 가고 싶구마……)
			ELSE
				PRINTFORML (빨리 이런 곳에서 빠져나갈 수 있도록……)
			ENDIF
		ENDIF

