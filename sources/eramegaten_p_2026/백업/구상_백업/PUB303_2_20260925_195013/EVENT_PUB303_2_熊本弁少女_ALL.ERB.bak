;-------------------------------------------------
;120,커닐링구스강제
;-------------------------------------------------
	CASE 120
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:362 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:362 < 4 || FLAG:7 == 2)
				PRINTFORMW 「콩알 날름날름 핥아서 기분 좋게 해줄게%ハート()%」
			ELSE
				IF TALENT:처녀
					PRINTFORMW 「엣, 오줌 같은 거 마시고 싶지 않당께!」
				ELSE
					PRINTFORMW 「오줌 싸믄 안 된당께」
				ENDIF
			ENDIF
			CFLAG:362 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:362 < 4 || FLAG:7 == 2)
				;お風呂場ならプレイ内容も変わる
				IF (TALENT:연모 || TALENT:친애 || TALENT:음란 || TALENT:창부) && TEQUIP:31
					IF RAND:2 == 0
						PRINTFORMW 「보지 호수에서 『공룡 풋시』를 발견했당께」
						PRINTFORML 「지금부터 퇴치하겠습니~다%ハート()%」
					ELSE
						PRINTFORML 「미끌미끌한 건 온수 때문이려나아♪」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) 수면에 떠오른 %CALLNAME:PLAYER%의 가랑이에 달라붙어 있다
				;恋慕、親愛
				ELSEIF TALENT:연모 || TALENT:친애
					PRINTFORML 
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORML 「옴찔거려 버리구선, 귀여워~%ハート()%」
					IF HAVE_PENIS()
						IF RAND:2 == 0
							PRINTFORML 「어뗘? 자지 넣어줬으면 좋겠어?」
						ELSE
							PRINTFORML 「다음엔 %CSTR:일인칭% 자지로 예뻐해 줄게♪」
						ENDIF
					ELSEIF HAVE_VAGINA()
						IF RAND:2 == 0
							PRINTFORML 「다음엔 보지끼리 키스해 볼까나♪」
						ELSE
							PRINTFORML 「여자끼리니께 보지 기분 좋은 부위는 잘 안단말여♪」
						ENDIF
					ELSE
						PRINTFORML 「더 낼름낼름 핥아서 가게 해줄게♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「자, 기분 좋은겨?」
				ENDIF
				CFLAG:362 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:362 < 3 || FLAG:7 == 2)
				PRINTFORML (%CSTR:일인칭%이 핥아주믄, %CSTR:이인칭%이 기뻐해 준다)
				CFLAG:362 = 3
			;それ以外
			ELSEIF CFLAG:362 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORML 「단디 깨끗하게 씻은 거제……」
				ELSE
					PRINTFORML 「%CSTR:일인칭% 혀는 수건이 아니랑께」
				ENDIF
				CFLAG:362 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;121,조개맞대기　＆　兜あわせ
;-------------------------------------------------
	CASE 121
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:363 == 0
			;主人にペニスがある場合(兜あわせ)
			IF HAVE_PENIS(PLAYER)
				IF TALENT:후타나리 && TALENT:MASTER:후타나리 && (TALENT:연모 || TALENT:친애)
					PRINTFORML 「먼저 가버린 쪽이 『수』가 되는 거니께」
					PRINTFORMW 「각오하시게♪」
				ELSEIF TALENT:후타나리 && TALENT:MASTER:후타나리 && (TALENT:음란 || TALENT:창부)
					PRINTFORML 「여자아이끼리인디」
					PRINTFORML 「보지가 아니라 자지를 비벼댄다니」
					PRINTFORML 「억수로 음란하구먼%ハート()%」
				ELSEIF (TALENT:연모 || TALENT:친애) && RAND:3 == 0
					PRINTFORML 「먼저 가게 해버릴 테니께」
					PRINTFORMW 「각오하시게♪」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「자지끼리 비벼댄다는 건, 왠지 이상한 느낌이랑께」
				ELSE
					PRINTFORMW 「자지로 칼싸움?」
				ENDIF
			;貝合わせ
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「보지끼리 비벼댄다는 건, 왠지 이상한 느낌이랑께」
				ELSE
					PRINTFORMW 「보지끼리 키스하는겨?」
				ENDIF
			ENDIF
			CFLAG:363 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:363 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;助手とプレイ中
					IF ASSI > 0 && ASSIPLAY
						PRINTFORMW 「기분 좋지만서도」
						IF HAVE_PENIS(MASTER)
							PRINTFORMW 「역시 %CSTR:이인칭% 자지 쪽이 더 좋아%ハート()%」
						ELSE
							PRINTFORMW 「역시 %CSTR:이인칭% 보지 쪽이 더 좋아%ハート()%」
						ENDIF
					;主人公が相手ばしとる
					ELSE
						IF HAVE_PENIS(MASTER)
							PRINTFORMW 「괜찮당께, %CSTR:일인칭% 구멍에 넣어도」
						ELSE
							PRINTFORML 「기분 좋아……%ハート()%」
							PRINTFORML 「마음도 몸도」
							PRINTFORMW 「보지도 흐물흐물 녹아서 하나가 되어버릴 것 같아……♪」
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「어느 쪽이 먼저 가게 만드나 시합이당♪」
					ELSE
						PRINTFORMW 「먼저 간 쪽이 다음엔 받는 쪽이니께♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					;助手とプレイ中
					IF ASSI > 0 && ASSIPLAY
						PRINTFORMW 「먼저 %CALLNAME:ASSI%을(를) 가게 만들믄」
						IF HAVE_PENIS(MASTER)
							PRINTFORMW 「다음엔 %CSTR:이인칭% 자지 줘잉%ハート()%」
						ELSE
							PRINTFORMW 「다음엔 %CSTR:이인칭%이랑 하고 싶은디, 괜찮제?」
						ENDIF
					;主人公が相手をしている
					ELSE
						IF HAVE_PENIS(MASTER)
							PRINTFORMW 「더, 더 %CSTR:일인칭% 자지 괴롭혀줘♪」
						ELSE
							PRINTFORML 「뜨거워엇%ハート()%」
							PRINTFORML 「%CSTR:이인칭%의 뜨끈뜨끈한 보지로」
							PRINTFORMW 「%CSTR:일인칭%, 보지부터 흐물흐물 녹아버려!」
						ENDIF
					ENDIF
				ENDIF
				CFLAG:363 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:363 < 3 || FLAG:7 == 2)
				PRINTFORMW 「이런 식으로 달라붙어 있으믄, %CSTR:이인칭%한테서 못 떨어지게 되어버린다구우……」
				CFLAG:363 = 3
			;それ以外
			ELSEIF CFLAG:363 < 2 || FLAG:7 == 2
				PRINTFORML 「안 돼!」
				IF HAVE_VAGINA() && HAVE_VAGINA(PLAYER) && RAND:2 == 0
					PRINTFORMW 「여자끼리인디, 이런 짓을 하믄 기분 좋아서 이상해져 버려……」
				ELSE
					PRINTFORMW 「이런 거 보통이 아닌디 기분 좋아서 이상해져 버린다구……」
				ENDIF
				CFLAG:363 = 2
			ENDIF
		ENDIF

