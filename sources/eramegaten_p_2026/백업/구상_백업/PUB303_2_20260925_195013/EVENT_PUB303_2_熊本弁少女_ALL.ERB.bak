ENDIF
ELSE
PRINTFORM 「%CSTR:일인칭%의 
IF RAND:2 == 0
PRINTFORMW MAG 빨아들이믄 안 된당께」
ELSE
PRINTFORMW 가슴 빨지 말어…」
				ENDIF
			ENDIF
		CFLAG:353 = 2
		ENDIF


;=================================================
;調教者奉仕系コマンド
;=================================================
;-------------------------------------------------
;90,수음한다
;-------------------------------------------------
	CASE 90
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:423 == 0
			PRINTFORMW 「아, 안 돼, 그, 그런 데 만지믄 안 된단 말이여엇」
			PRINTFORMW 「시, 싫, 안 된다니께에! 히야악!」
			CFLAG:423 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:423 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;コマンド実施が助手
					IF ASSI > 0 && ASSIPLAY
						PRINTFORML 「싫어어… %CSTR:이인칭%이 좋아아…」
						PRINTFORMW 말과는 달리 %CALLNAME%의 가랑이의 일물은 점차 단단함을 더해갔다
					ELSE
						PRINTFORMW 「응아, %CSTR:이인칭% 손으로 그런 짓, 당하믄, %CSTR:일인칭%, %CSTR:일인칭%…… 앙%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;助手が手淫中
					IF RAND:3 == 0 && ASSI > 0 && ASSIPLAY
						PRINTFORML 「앗, 거기 좋당께♪」
						PRINTFORMW 「얼른 가게 해줘어~%ハート()%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「%CSTR:이인칭%이 흔들어주는 거 너무 기분 좋아서, 이제 못 참겠당께%ハート()%」
					ELSE
						PRINTFORML 「자지 우유, 자지 우유우%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 사정하는 자신을 상상하며 벌써 흥분하고 있다
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					;助手が手淫中
					IF RAND:3 == 0 && ASSI > 0 && ASSIPLAY
						PRINTFORMW 「%CALLNAME:ASSI%이(가) 흔들어주는 거 기분 억수로 좋아아%ハート()%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「%CSTR:이인칭%이 흔들어주는 거 기분 억수로 좋아아%ハート()%」
					ELSE
						PRINTFORML 「흔들어주는 거 너무 기분 좋아서…」
					ENDIF
				PRINTFORMW 「나와버려! %CSTR:일인칭%의 노예 자지, 우유 잔뜩 퓨퓨 뿜어버린다구우우!」
			ENDIF
			CFLAG:423 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:414 < 3 || FLAG:7 == 2)
				PRINTFORMW 「안 돼, 이상해져 버릴 것 같은디 기분 좋당께」
				CFLAG:423 = 3
			;それ以外
			ELSEIF CFLAG:414 < 2 || FLAG:7 == 2
				PRINTFORMW 「이상해져 버리니께 몇 번이고 만지믄 안 돼」
				CFLAG:423 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;91,파이즈리한다
;-------------------------------------------------
	CASE 91
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:424 == 0
			IF TEQUIP:주도권
				PRINTFORMW 「아핫」
				;奴隷がパイズリをした事が無い
				IF CFLAG:346 == 0
					PRINTFORMW 「가슴으로 자지 훑어지는 거 기분 좋아%ハート()%」
				ELSE
					PRINTFORMW 「이러니 다들 버릇이 되어버리는 거구먼♪」
				ENDIF
			ELSE
				PRINTFORMW 「하아, 그렇게, 가슴으로 자지를…」
				PRINTFORMW 「시, 싫어엉」
			ENDIF
			CFLAG:424 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:424 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;助手がパイズリ中
					IF ASSI > 0 && ASSIPLAY
						PRINTFORMW 「%CSTR:이인칭%, 이 가슴에 정액 내보내 버려도 돼?」
					ELSE
						PRINTFORMW 「%CSTR:이인칭% 가슴, 억수로 기분 좋아%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;助手がパイズリ中
					IF RAND:2 == 0 && ASSI > 0 && ASSIPLAY
						PRINTFORMW 「%CSTR:이인칭%, 이 가슴 억수로 기분 좋아♪」
					ELSE
						PRINTFORMW 「으응, 중독되어 버리겠구먼%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「미안해요, 가슴이 기분 좋아서 %CSTR:일인칭% 자지 우유 나와버릴 것 같앙%ハート()%」
					ELSE
						PRINTFORML 「좋아, 좋은겨」
						PRINTFORML 「%CSTR:이인칭%, 가슴에 자지 우유」
						PRINTFORML 「가슴, 자지 우유로, 끈적끈적하게엣%ハート()%」
					ENDIF
				ENDIF
				CFLAG:424 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:414 < 3 || FLAG:7 == 2)
				PRINTFORML 「안 돼, 이상해져 버려」
				PRINTFORMW 「가슴 기분 좋당께」
				CFLAG:424 = 3
			;それ以外
			ELSEIF CFLAG:414 < 2 || FLAG:7 == 2
				PRINTFORML 「안 돼, 끼우고 움직이지 말어」
				PRINTFORMW 「이상해져 버린다구!」
				CFLAG:424 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;92,정상위시킨다
;-------------------------------------------------
	CASE 92
		;初めて
		IF CFLAG:425 == 0
			IF TEQUIP:주도권 == 1
				PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%을(를) 덮쳐왔다
				IF TALENT:소악마
					PRINTFORMW 「%CSTR:일인칭% 자지로 가~득 기분 좋게 해줄게♪」
				ELSE
					PRINTFORMW 「이, 이젠 안 돼, 자지를, 못 참겠당께……」
					PRINTFORMW 「%CSTR:이인칭% 보지, 원한당께… 먹고 싶어, 넣어버리고 싶어, 넣게 해줘어!」
				ENDIF
				CALL TRAIN_MESSAGE
			ELSE
				CALL TRAIN_MESSAGE
				PRINTFORMW 「보지, 보지, %CSTR:이인칭%의, 보지, 기분 억수로 좋아아!」
				PRINTFORMW 「자지를 꽉 조여줘서, 이제, 못 참겠당께에!」
			ENDIF
			CFLAG:425 = 1
		;二回目以降
		ELSE
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:425 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF TALENT:MASTER:후타나리 && RAND:2 == 0
						PRINTFORMW 「사정하면서 보지에 사정당해 가버리는 얼굴, 지켜봐 줄 테니께%ハート()%」
					ELSEIF TEQUIP:주도권
						PRINTFORMW 「저기, 봐봐♪ %CSTR:이인칭% 보지가, %CSTR:일인칭% 자지를, 열심히 오물오물 삼키고 있당께♪」
						PRINTFORMW 「후훗, 이런 음란한 보지, 바람피우지 않게 %CSTR:일인칭% 자지를 잔뜩 각인시켜야겠구먼♪」
					ELSE
						PRINTFORMW 「아아, 먹히고 있어… %CSTR:일인칭% 자지, %CSTR:이인칭% 보지한테 먹혀버리고 있어…♪」
						PRINTFORMW 「%CSTR:이인칭% 보지, 꿈틀거리고, 녹아내려서, 벌써 싸버릴 것 같아……」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;助手が正常位されとる
					IF ASSI > 0 && ASSIPLAY
						IF TALENT:PLAYER:처녀
							IF RAND:2 == 0
								PRINTFORMW 「%CALLNAME:ASSI%의 처음, %CSTR:일인칭%이 받아버렸당께」
							ELSE
								PRINTFORMW 「처녀 보지, 꽉 조여서 기분 좋구먼」
							ENDIF
							IF TALENT:PLAYER:아내
								PRINTFORMW 「그라니께 말여」
								PRINTFORMW 「%CSTR:이인칭% 거 말고, %CSTR:일인칭%의 아기 낳으시게%ハート()%」
							ELSE
								PRINTFORMW 「이런 조교라면 매일이라도 좋을지도%ハート()%」
							ENDIF
						ELSE
							IF TALENT:PLAYER:아내
								PRINTFORMW 「봐봐, %CALLNAME:ASSI% 얼굴」
								PRINTFORML 「서방님이 지켜보는 와중에 %CSTR:일인칭%이랑 섹스하고 있는디」
								PRINTFORMW 「이렇게 기분 좋아보이구 있어」
							ELSE
								PRINTFORML 「%CALLNAME:ASSI% 보지 너~무 기분 좋구」
								PRINTFORMW 「이런 조교라면 하루 종일이라도 좋을지도%ハート()%」
							ENDIF
						ENDIF
					ELSE
						IF TALENT:MASTER:처녀
							PRINTFORMW 「%CSTR:이인칭%의 처음, %CSTR:일인칭%이 받아버렸당께」
							PRINTFORMW 「사례로 제대로 가게 해준 다음 사정해 줄게%ハート()%」
						ELSEIF TALENT:MASTER:후타나리 && RAND:2 == 0
							PRINTFORML 「보지 기분 좋아?」
							PRINTFORMW 「사정하고 싶다면서 자지가 옴찔거리고 있당께♪」
						ELSE
							IF RAND:2 == 0
								PRINTFORMW 「응, 큭, 하아%ハート()%」
								PRINTFORMW 「%CSTR:이인칭% 보지, 녹아내리고, 질척거리고, 꽉꽉 조여서, 억수로 기분 좋아…%ハート()%」
							ELSE
								PRINTFORML 「%CSTR:이인칭% 보지 너~무 기분 좋구」
								PRINTFORMW 「이런 조교라면 하루 종일이라도 좋을지도%ハート()%」
							ENDIF
						ENDIF
					ENDIF
					SIF NOWEX:사정
						PRINTFORMW 「벌써…… 으, 응, 바, 바로 나와버릴 것 같……☆」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「죄송해요, 미안혀어」
					PRINTFORMW 「%CSTR:일인칭% 자지가 제멋대로라, 참지 못해서, 미안혀어」
					PRINTFORMW 「하지만서도, %CSTR:이인칭% 보지가 옴씬거리고, 녹아내리며 유혹하는 게 나쁜 거랑께!」
					PRINTFORMW 「이런, 보지가, 아, 아아, 대, 대단, 자지, 대단해엣!」
				ENDIF
				CFLAG:425 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:425 < 3 || FLAG:7 == 2)
				PRINTFORMW 
				CFLAG:425 = 3
			;それ以外
			ELSEIF CFLAG:425 < 2 || FLAG:7 == 2
				;地ん文に合わせて調教相手が主導権ば持읏とるなら口上ば変ゆる
				IF TEQUIP:주도권
					PRINTFORMW 「평소의 보답이랑께♪」
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「싫어, 허리가 안 멈춰」
					ELSE
						PRINTFORMW 「좋아하진 않지만서도, 이 보지 기분 좋당께♪」
					ENDIF
				ENDIF
				CFLAG:425 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;93,후배위시킨다
;-------------------------------------------------
	CASE 93
		;初めて
		IF CFLAG:426 == 0
			IF TEQUIP:주도권 == 1
				PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%을(를) 덮쳐왔다
				PRINTFORMW 「이, 이젠 안 돼, 자지를, 못 참겠당께……」
				PRINTFORMW 「%CSTR:이인칭% 보지, 원한당께… 먹고 싶어, 넣어버리고 싶어, 넣게 해줘어!」
				CALL TRAIN_MESSAGE
			ELSE
				CALL TRAIN_MESSAGE
				PRINTFORMW 「보지, 보지, %CSTR:이인칭%의, 보지, 기분 억수로 좋아아!」
				PRINTFORMW 「자지를 꽉 조여줘서, 이제, 못 참겠당께에!」
			ENDIF
			CFLAG:426 = 1
		;二回目以降
		ELSE
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:426 < 4 || FLAG:7 == 2)
				;100LV以上の調教者が強以上のＶ絶頂をした場合
				IF NOWEX:PLAYER:1 > 1 && BASE:PLAYER:LV > 99
					IF HAVE_PENIS() && RAND:3 == 0
						PRINTFORML 「악마를 쓰러뜨릴 만큼 강해도」
						PRINTFORML 「자지한테는 못 이기는 건 어쩔 수 없는 거제♪」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「강해졌어도, 보지는 흐물흐물 약하구먼♪」
					ELSE
						PRINTFORML 「악마를 쓰러뜨릴 만큼 강해도」
						PRINTFORML 「뒤에서 보지를 찰싹찰싹 박히믄 가버리는 건 어쩔 수 없는 거제♪」
					ENDIF
				;恋慕、親愛
				ELSEIF TALENT:연모 || TALENT:친애
					IF TEQUIP:주도권
						PRINTFORMW 「후후후, %CSTR:이인칭% 보지가, %CSTR:일인칭% 자지를 열심히 오물오물 삼키고 있는 게 잘 보인당께♪」
						PRINTFORMW 「이런 음란한 보지, 바람피우지 않게 %CSTR:일인칭% 자지를 잔뜩 각인시켜야겠구먼♪」
					ELSE
						PRINTFORMW 「아아, 먹히고 있어… %CSTR:일인칭% 자지, %CSTR:이인칭% 보지한테 먹혀버리고 있어…♪」
						PRINTFORMW 「%CSTR:이인칭% 보지, 꿈틀거리고, 녹아내려서, 벌써 싸버릴 것 같아……」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「후후, %CSTR:이인칭% 보지, 자지를 원해-라면서 옴씬거리고 있당께?」
					PRINTFORMW 「그런 사랑스러운 보지에는, %CSTR:일인칭% 자지로 뚜껑을 덮어줘야제♪」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF TEQUIP:주도권
						PRINTFORMW 「노예인, %CSTR:일인칭%한테, 범해져서, 기뻐하다니, %CSTR:이인칭%도 참, 이젠 암캐 같당께%ハート()%」
					ELSE
						PRINTFORMW 「노예인, %CSTR:일인칭%한테, 범해지고선, 기뻐하다니, %CSTR:이인칭%도 참, 이젠 암캐 같당께%ハート()%」
					ENDIF
					PRINTFORMW 「%CSTR:일인칭%도, 이런 꼴로, 허리 흔들고 있는, 멍멍이지만서도♪」
					IF NOWEX:MASTER:1
						PRINTFORMW 「아, 갈 것 같어? 갈 것 같은겨?」
						IF NOWEX:사정
							PRINTFORMW 「좋아, %CSTR:일인칭%도, 벌써, 쌀 것 같아」
							PRINTFORMW 「%CSTR:일인칭%한테 씨뿌리기 당하면서, 가버려도 된당께%ハート()%」
						ELSE
							PRINTFORMW 「좋아, %CSTR:일인칭% 자지로 질척질척 엉망이 되어서, 가버려♪」
						ENDIF
					ENDIF
				ENDIF
				CFLAG:426 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:414 < 3 || FLAG:7 == 2)
				PRINTFORML 　
				CFLAG:426 = 3
			;それ以外
			ELSEIF CFLAG:426 < 2 || FLAG:7 == 2
				;地の文に合わせて調教相手が主導権を持읏ているなら口上を変える
				IF TEQUIP:주도권
					PRINTFORMW 「평소의 보답이랑께♪」
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「싫어, 허리가 안 멈춰」
					ELSE
						PRINTFORMW 「좋아하진 않지만서도, 이 보지 기분 좋당께♪」
					ENDIF
				ENDIF
				CFLAG:426 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;94,기승위한다
;-------------------------------------------------
	CASE 94
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:427 == 0
			;処女を相手にする
			IF TALENT:PLAYER:처녀
				;助手とプレイ中
				IF ASSI > 0 && ASSIPLAY
					;相手が主導権を持읏ている
					IF TEQUIP:주도권 == 1
						IF RAND:2 == 0
							PRINTFORMW 「%CALLNAME:ASSI%의 처음, %CSTR:일인칭%이 받을게♪」
						ELSE
							PRINTFORMW 「괜찮당께, 자지는 안 무서우니께♪」
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORMW 「처음이지만서도, 힘내시게♪」
						ELSE
							PRINTFORMW 「%CSTR:이인칭%, %CALLNAME:ASSI%의 처음, 받아버릴게♪」
						ENDIF
					ENDIF
				;主人公が相手ばしとる
				ELSE
					;相手が主導権ば持읏とる
					IF TEQUIP:주도권 == 1
						IF RAND:2 == 0
							PRINTFORMW 「%CSTR:이인칭%의 처음, %CSTR:일인칭%이 받을게♪」
						ELSE
							PRINTFORMW 「%CSTR:이인칭%도 참, 긴장하고 있어서 귀여워-%ハート()%」
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORMW 「처음인디 너무 밝힌당께, %CSTR:이인칭%」
						ELSE
							PRINTFORMW 「그렇게 자지가 갖고 싶었던겨?」
						ENDIF
					ENDIF
				ENDIF
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:427 < 4 || FLAG:7 == 2)
					IF RAND:2 == 0
						PRINTFORMW 「그렇게 %CSTR:일인칭% 자지가 갖고 싶은겨?」
					ELSE
						PRINTFORMW 「그렇게 %CSTR:일인칭%이랑 하고 싶은겨?」
					ENDIF
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:427 < 3 || FLAG:7 == 2)
					PRINTFORMW 「%CSTR:일인칭% 자지로 기분 좋아지시게」
				;それ以外
				ELSEIF CFLAG:414 < 2 || FLAG:7 == 2
					IF RAND:2 == 0
						PRINTFORMW 「안 돼, %CSTR:일인칭% 자지 잡아먹지 말어!」
					ELSE
						PRINTFORMW 「안 돼, 위에 올라타지 말어!」
					ENDIF
				ENDIF
			ENDIF
			CFLAG:427 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:427 < 4 || FLAG:7 == 2)
				;100LV以上の調教者が強以上のＶ絶頂をした場合
				IF NOWEX:PLAYER:1 > 1 && BASE:PLAYER:LV > 99
					IF RAND:2 == 0
						PRINTFORMW 「강해졌어도, 보지는 흐물흐물 약하구먼♪」
					ELSE
						PRINTFORML 「악마를 쓰러뜨릴 만큼 강해도」
						PRINTFORML 「아래에서 보지를 푹푹 쑤셔지믄 가버리는 건 어쩔 수 없는 거제♪」
					ENDIF
				;恋慕、親愛
				ELSEIF TALENT:연모 || TALENT:친애
					;助手とプレイ中
					IF ASSI > 0 && ASSIPLAY
						PRINTFORMW 「%CSTR:이인칭%…」
						IF RAND:2 == 0
							PRINTFORMW 「이, 이제 자지가 못 참겠당께…」
						ELSE
							PRINTFORMW 「억수로 좋아하는 %CSTR:이인칭%이랑 해서 가고 싶은디…」
						ENDIF
					;主人公が相手ばしとる
					ELSE
						PRINTFORMW 「어뗘, %CSTR:일인칭% 자지 기분 좋제%ハート()%」
						PRINTFORMW 「더 격렬하게 움직여도 된당께%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;助手とプレイ中
					IF ASSI > 0 && ASSIPLAY
						PRINTFORML 「보지, %CSTR:이인칭%, 이 보지 기분 억수로 좋아아!」
					ELSE
						PRINTFORML 「좋아앗! %CSTR:이인칭%의, 보지, 기분 억수로 좋아아!」
					ENDIF
					PRINTFORMW 「내보낼게♪ 정액 듬뿍 내보내 버릴 테니께%ハート()%」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					;助手とプレイ中
					IF ASSI > 0 && ASSIPLAY
						PRINTFORML 「보지, %CSTR:이인칭%, 이 보지 기분 억수로 좋아아!」
					ELSE
						PRINTFORML 「보지, 보지, %CSTR:이인칭%의, 보지, 기분 억수로 좋아아!」
					ENDIF
					PRINTFORMW 「%CSTR:이인칭%, 가버리믄 안 돼? 안 되는겨?」
				ENDIF
				CFLAG:427 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:427 < 3 || FLAG:7 == 2)
				;地ん文に合わせて調教相手が主導権ば持읏とるなら口上ば変ゆる
				IF TEQUIP:주도권
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭%의 어린애 자지, 기분 좋아?」
						PRINTFORML 「자아, 자앗」
						PRINTFORMW 「아래에서 쿵쿵 찔러줄게♪」
					ELSE
						PRINTFORML 「조금만 더 참으시게」
						PRINTFORMW 「%CSTR:일인칭%도 갈 것 같으니께」
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「싫어, 허리가 안 멈춰」
					ELSE
						PRINTFORMW 「좋아하진 않지만서도, 이 보지 기분 좋당께♪」
					ENDIF
				ENDIF
				CFLAG:427 = 3
			;それ以外
			ELSEIF CFLAG:427 < 2 || FLAG:7 == 2
				;地ん文に合わせて調教相手が主導権ば持읏とるなら口上ば変ゆる
				IF TEQUIP:주도권
					IF RAND:2 == 0
						PRINTFORML 「평소의 보답이랑께」
						PRINTFORMW 「자아, 자앗♪」
					ELSE
						PRINTFORML 「봐봐, 기분 좋제?」
						PRINTFORMW 「사정해 줬으면 좋겠거든 부탁해야제♪」
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「싫어, 허리가 안 멈춰」
					ELSE
						PRINTFORMW 「스스로 올라타서, 허리 흔들어 버리구선」
						PRINTFORMW 「정말 변태구먼」
					ENDIF
				ENDIF
				CFLAG:427 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;900,대면좌위시킨다
;-------------------------------------------------
	CASE 900
		CALL TRAIN_MESSAGE
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속)
			;100LV以上の調教者が強以上のＶ絶頂をした場合
			IF NOWEX:PLAYER:1 > 1 && BASE:PLAYER:LV > 99
				IF RAND:2 == 0
					PRINTFORMW 「강해졌어도, 보지는 흐물흐물 약하구먼♪」
				ELSE
					PRINTFORML 「악마를 쓰러뜨릴 만큼 강해도」
					PRINTFORML 「안겨서 보지를 퍽퍽 쑤셔지며 가버리는 건 어쩔 수 없는 거제♪」
				ENDIF
			;恋慕、親愛
			ELSEIF TALENT:연모 || TALENT:친애
				IF HAVE_PENIS()
					PRINTFORML 「이런 자세, %CSTR:이인칭% 보지랑 가슴 둘 다 즐길 수 있어서 이득이구먼♪」
				ELSE
					PRINTFORML 「%CSTR:일인칭% 허리놀림에 느껴주고 있는 거제♪」
					PRINTFORML 「둘이서 함께 가자구%ハート()%」
				ENDIF
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				;ＬＶ30以上のあなたが相手の場合
				IF BASE:MASTER:LV > 30 && (ASSI == 0 || ASSIPLAY == 0) && RAND:2 == 0
					PRINTFORML 「전투에선 강하지만서도」
					PRINTFORMW 「침대 위에선 흐물흐물 약하구먼♪」
					PRINTFORMW 「자아, 크리티컬♪ 크리티컬♪」
				ELSE
					PRINTFORML 「기분 좋제? 가고 나면 교대랑께♪」
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORML 「%CSTR:이인칭%의 음란한 얼굴 보면서 봉사하고 있자니」
				PRINTFORML 「%CSTR:일인칭%도 가고 싶어졌는디, 아직 안 돼?」
			ENDIF
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3
			PRINTFORML (기분 좋아 보이는 얼굴…)
			PRINTFORML (%CSTR:일인칭% 자지로 기분 좋아져 주고 있어♪)
		;それ以外
		ELSE
			PRINTFORML 「이렇게 됐으니 앙갚음이랑께」
			IF RAND:2 == 0
				PRINTFORML 「울어도 안 봐줄 테니께」
			ELSE
				PRINTFORML 「아흥아흥 소리 내게 해줄 테니께」
			ENDIF
		ENDIF

;-------------------------------------------------
;900,배면좌위시킨다
;-------------------------------------------------
	CASE 901
		CALL TRAIN_MESSAGE
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속)
			;100LV以上の調教者が強以上のＶ絶頂をした場合
			IF NOWEX:PLAYER:1 > 1 && BASE:PLAYER:LV > 99
				;奴隷のレベルが凄く低い場合
				IF (BASE:PLAYER:LV > BASE:LV + 50) && RAND:3 == 0
					PRINTFORML 「%CSTR:일인칭% 같은 조무래기한테 안겨서」
					PRINTFORMW 「보지를 푹푹 쑤셔져서 기분 좋아져 버리는 거구먼♪」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「강해졌어도, 보지는 흐물흐물 약하구먼♪」
				ELSE
					PRINTFORML 「악마를 쓰러뜨릴 만큼 강해도」
					PRINTFORMW 「안겨서 보지를 푹푹 쑤셔져 가버리는 건 어쩔 수 없는 거제♪」
				ENDIF
			;恋慕、親愛
			ELSEIF TALENT:연모 || TALENT:친애
				PRINTFORML 「뒤에서 안은 채로 섹스하니께, 기분 억수로 좋네%ハート()%」
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORML 「%CSTR:일인칭% 자지 기분 좋아? 가슴도 만져줄게♪」
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORML 「%CSTR:이인칭%, %CSTR:일인칭% 허리놀림 어뗘?」
			ENDIF
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3
			PRINTFORML (%CSTR:일인칭%이랑 타이밍 맞춰서 허리 흔들고 있어)
			PRINTFORML (그렇게나 기분 좋은 거구먼…)
		;それ以外
		ELSE
			IF RAND:2 == 0
				PRINTFORML 「어뗘? 평소 당하던 짓을 되돌려받는 기분은」
			ELSE
			PRINTFORML 「이렇게 됐으니 앙갚음이랑께」
			ENDIF
		ENDIF


;-------------------------------------------------
;95,애널정상위시킨다
;-------------------------------------------------
	CASE 95
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:428 == 0
			IF TEQUIP:주도권 == 1
				IF TALENT:소악마 && TALENT:PLAYER:남자
					PRINTFORMW 「%CSTR:일인칭% 자지로 암컷 절정시켜 줄게」
					PRINTFORMW 「얼마나 귀여운 얼굴로 갈까나♪」
				ELSEIF TALENT:PLAYER:처녀
					PRINTFORMW 「보지보다 먼저 엉덩이에 해달라니, 진짜 변태구먼♪」
				ELSE
					PRINTFORMW 「%CSTR:일인칭% 자지로 가~득 기분 좋게 해줄게♪」
				ENDIF
			ELSE
				PRINTFORML 「엉덩이에 들어가는 섹스, 기분 좋네」
				PRINTFORMW 「중독되어 버릴 것 같아♪」
			ENDIF
			CFLAG:428 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:428 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「먼저 가는 쪽이 지는 거랑께%ハート()%」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「그라믄 푸욱 들어가 버릴게, %CSTR:이인칭%%ハート()%」
					PRINTFORMW 「금방 가버리믄 안 된당께♪」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「%CSTR:일인칭% 자지로 기분 좋게 해줄게」
				ENDIF
				CFLAG:428 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:428 < 3 || FLAG:7 == 2)
				PRINTFORML 「엉덩이로 섹스라니 이상한 짓인디」
				PRINTFORMW 「허리가 안 멈춘당께」
				CFLAG:428 = 3
			;それ以外
			ELSEIF CFLAG:428 < 2 || FLAG:7 == 2
				PRINTFORMW 「엉덩이 따위에 넣고」
				PRINTFORMW 「%CSTR:일인칭% 자지, 병 걸려버려…」
				CFLAG:428 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;96,애널후배위시킨다
;-------------------------------------------------
	CASE 96
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:429 == 0
			;간호사복
			IF TEQUIP:옷 == 105
				PRINTFORML 「네-에, 좌약 넣을 테니께」
				IF HAVE_PENIS()
					PRINTFORMW 「하얀 약 나올 때까지 넣을 테니께요~♪」
				ELSE
					PRINTFORMW 「아파도 참아주시게~♪」
				ENDIF
				PRINTFORML 　
				PRINTFORMW 「네~에, 쑤욱 들어갔당께~♪」
				PRINTFORML 「그라믄, 여기서부터 피스톤 운동할 테니께요~♪」
				PRINTFORMW 간호사 플레이라는 것도 잊고 %CALLNAME%은(는) 자기 좋은 대로 허리를 흔들고 있다
			ELSEIF TEQUIP:주도권 == 1
				PRINTFORMW 「이, 이젠 안 돼, 자지를, 못 참겠당께……」
				PRINTFORMW 「%CSTR:이인칭% 엉덩이에 넣어버리고 싶어, 넣게 해줘어!」
			ELSE
				PRINTFORMW 「애널, 애널, %CSTR:이인칭% 애널, 기분 억수로 좋아아!」
				PRINTFORMW 「자지를 꽉 조여줘서, 이제, 못 참겠당께에!」
			ENDIF
			CFLAG:429 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:429 < 4 || FLAG:7 == 2)
				;간호사복
				IF TEQUIP:옷 == 105
					IF HAVE_PENIS() && RAND:2 == 0
						PRINTFORML 「오늘은 엉덩이에 주사를 놓을 테니께요-」
						PRINTFORML 「주사기 안의 것을 전부 다 낼 때까지 참아주시게~♪」
					ELSE
						PRINTFORML 「또 좌약 시간이랑께-」
						IF HAVE_PENIS()
							PRINTFORML 「약, 잔뜩 내보낼 테니께」
							PRINTFORMW 「흘리지 않게 해주시게~♪」
						ELSE
							PRINTFORMW 「전보다 수월하게 들어가게 되었구먼~」
						ENDIF
					ENDIF
					PRINTFORMW 간호사 차림의 %CALLNAME%은(는) 신이 나서 플레이를 즐기고 있다
				;恋慕、親愛
				ELSEIF TALENT:연모 || TALENT:친애
					IF TEQUIP:주도권
						PRINTFORMW 「후후후, %CSTR:이인칭% 애널이, %CSTR:일인칭% 자지를 열심히 오물오물 삼키고 있는 게 잘 보인당께♪」
						PRINTFORMW 「이런 음란한 애널, 바람피우지 않게 %CSTR:일인칭% 자지를 잔뜩 각인시켜야겠구먼♪」
					ELSE
						PRINTFORMW 「아아, 먹히고 있어… %CSTR:일인칭% 자지, %CSTR:이인칭% 엉덩이한테 먹혀버리고 있어…♪」
						PRINTFORMW 「%CSTR:이인칭% 애널, 꿈틀거리고, 녹아내려서, 벌써 싸버릴 것 같아……」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「후후, %CSTR:이인칭% 엉덩이, 자지를 원해-라면서 옴씬거리고 있당께?」
					PRINTFORMW 「그런 사랑스러운 애널에는, %CSTR:일인칭% 자지로 뚜껑을 덮어줘야제♪」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF TEQUIP:주도권
						PRINTFORMW 「노예인, %CSTR:일인칭%한테, 범해져서, 기뻐하다니, %CSTR:이인칭%도 참, 이젠 암캐 같당께%ハート()%」
					ELSE
						PRINTFORMW 「노예인, %CSTR:일인칭%한테, 범해지고선, 기뻐하다니, %CSTR:이인칭%도 참, 이젠 암캐 같당께%ハート()%」
					ENDIF
					PRINTFORMW 「%CSTR:일인칭%도, 이런 꼴로, 허리 흔들고 있는, 멍멍이지만서도♪」
					IF NOWEX:MASTER:1
						PRINTFORMW 「아, 갈 것 같어? 엉덩이로 갈 것 같은겨?」
						IF NOWEX:사정
							PRINTFORMW 「좋아, %CSTR:일인칭%도, 벌써, 쌀 것 같아」
							PRINTFORMW 「애널에 씨뿌리기 당하면서, 가버려도 된당께%ハート()%」
						ELSE
							PRINTFORMW 「좋아, %CSTR:일인칭% 자지로 질척질척 엉망이 되어서, 가버려♪」
						ENDIF
					ENDIF
				ENDIF
				CFLAG:429 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:429 < 3 || FLAG:7 == 2)
				PRINTFORMW 
				CFLAG:429 = 3
			;それ以外
			ELSEIF CFLAG:429 < 2 || FLAG:7 == 2
				PRINTFORMW 「엉덩이 따위에 넣고」
				PRINTFORMW 「%CSTR:일인칭% 자지, 병 걸려버려…」
				CFLAG:429 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;97,애널기승위한다
;-------------------------------------------------
	CASE 97
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:430 == 0
			IF TEQUIP:주도권 == 1
				PRINTFORMW 「자아, 엉덩이에 넣게 해줄 테니께」
				PRINTFORMW 「단디 허리 흔들어서 %CSTR:일인칭%을 기분 좋게 해주시게♪」
			ELSE
				PRINTFORMW 「스스로 올라타서 자지를 엉덩이에 넣어버리다니」
				PRINTFORMW 「진짜 변태구먼♪」
			ENDIF
			CFLAG:430 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:430 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;助手とプレイ中
					IF ASSI > 0 && ASSIPLAY
						PRINTFORMW 「%CSTR:이인칭%이랑 하고 싶었지만서도……」
						PRINTFORMW 「이 애널도 기분 좋당께」
						PRINTFORMW 「돼? %CSTR:일인칭%, 가버려도 돼?」
					;主人公が相手ばしとる
					ELSE
						PRINTFORMW 「%CSTR:이인칭% 애널」
						PRINTFORMW 「큥큥 조여와서 기분 억수로 좋아%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF TEQUIP:주도권 == 1
						PRINTFORMW 「자아, 어뗘?」
						PRINTFORMW 「어린애 자지에 올라타서 아래에서 엉덩이 공략당하구선」
						;ペニスがある場合
						IF HAVE_PENIS(TARGET)
							PRINTFORMW 「기분 좋아서 자지 커져버리구선」
						ELSE
							PRINTFORMW 「기분 좋아 보이는 얼굴 하구선」
						ENDIF
						PRINTFORMW 「마지막까지 제대로 가게 해줄 테니께♪」
					ELSE
						PRINTFORMW 「자아, 허리 더 흔들어」
						PRINTFORMW 「자기 혼자만 기분 좋아지는 건 매너 위반이랑께♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「보지, 보지, %CSTR:이인칭%의, 엉덩이 보지, 기분 억수로 좋아아!」
					PRINTFORMW 「%CSTR:이인칭%, 가버리믄 안 돼? 안 되는겨?」
				ENDIF
				CFLAG:430 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:430 < 3 || FLAG:7 == 2)
				PRINTFORML 「엉덩이인디도 자지가 기분 좋아서」
				PRINTFORMW 「어떻게 되어버릴 것 같당께
				CFLAG:430 = 3
			;それ以外
			ELSEIF CFLAG:430 < 2 || FLAG:7 == 2
				PRINTFORMW 「엉덩이에 자지 넣고 허리 흔든다니」
				PRINTFORMW 「%CSTR:일인칭%, 이상한 병에 걸려버려…」
				CFLAG:430 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;902,애널대면좌위시킨다
;-------------------------------------------------
	CASE 902
		CALL TRAIN_MESSAGE
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속)
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				IF HAVE_PENIS()
					PRINTFORML 「%CSTR:일인칭% 자지로 느껴주고 있는 거제♪」
				ELSE
					PRINTFORML 「%CSTR:일인칭% 허리놀림에 느껴주고 있는 거제♪」
				ENDIF
				PRINTFORML 「둘이서 함께 가자구%ハート()%」
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				;ＬＶ30以上のあなたが相手の場合
				IF BASE:MASTER:LV > 30 && (ASSI == 0 || ASSIPLAY == 0) && RAND:2 == 0
					PRINTFORML 「전투에선 강하지만서도」
					PRINTFORMW 「%CSTR:이인칭% 엉덩이는 흐물흐물 약하구먼♪」
					PRINTFORMW 「자아, 크리티컬♪ 크리티컬♪」
				ELSE
					PRINTFORML 「엉덩이, 기분 좋제?」
					PRINTFORML 「가고 나면 교대랑께♪」
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORML 「%CSTR:이인칭%의 음란한 얼굴 보면서 봉사하고 있자니」
				PRINTFORML 「%CSTR:일인칭%도 가고 싶어졌는디, 아직 안 돼?」
			ENDIF
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3
			PRINTFORML (엉덩이인디도 기분 좋아 보이는 얼굴…)
			PRINTFORML (%CSTR:일인칭% 자지로 기분 좋아져 주고 있어♪)
		;それ以外
		ELSE
			PRINTFORML 「이렇게 됐으니 앙갚음이랑께」
			IF RAND:2 == 0
				PRINTFORML 「울어도 안 봐줄 테니께」
			ELSE
				PRINTFORML 「엉덩이로 아흥아흥 소리 내는 변태로 만들어줄 테니께」
			ENDIF
		ENDIF

;-------------------------------------------------
;903,애널배면좌위시킨다
;-------------------------------------------------
	CASE 903
		CALL TRAIN_MESSAGE
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속)
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				PRINTFORML 「뒤에서 안은 채로 엉덩이로 섹스하니께, 기분 억수로 좋네%ハート()%」
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORML 「엉덩이 기분 좋아? 가슴도 만져줄게♪」
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORML 「%CSTR:이인칭%, %CSTR:일인칭% 허리놀림 어뗘?」
				IF RAND:2 == 0
					PRINTFORML 「더 빨리하는 게 좋아?」
				ELSE
					PRINTFORML 「더 깊숙이 넣는 게 좋아?」
				ENDIF
			ENDIF
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3
			PRINTFORML (%CSTR:일인칭%이랑 타이밍 맞춰서 허리 흔들고 있어)
			PRINTFORML (그렇게나 엉덩이가 기분 좋은 거구먼…)
		;それ以外
		ELSE
			PRINTFORML 「이렇게 됐으니 앙갚음이랑께」
		ENDIF

;-------------------------------------------------
;98,모유먹이기
;-------------------------------------------------
	CASE 98
		;初めて
		IF CFLAG:443 == 0
			IF TEQUIP:주도권
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:443 < 4 || FLAG:7 == 2)
					CALL TRAIN_MESSAGE
					PRINTFORMW 「잘 먹었습니당」
					PRINTFORMW 「또 주시게」
				ELSE
					PRINTFORMW 「정말로 가슴 안 먹으면 안 되는겨?」
					PRINTFORM 체념한 표정으로
					CALL TRAIN_MESSAGE
				ENDIF
			ELSE
				CALL TRAIN_MESSAGE
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:443 < 4 || FLAG:7 == 2)
					PRINTFORMW 「응, 맛있네♪」
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:414 < 3 || FLAG:7 == 2)
					PRINTFORML 「저기」
					PRINTFORMW 「착한 아이로 있으믄 또 먹여줄겨?」
				ELSE
					PRINTFORMW 「그럭저럭인 맛이려나」
				ENDIF
			ENDIF
			CFLAG:443 = 1
		;二回目以降
		ELSE
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:443 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:이인칭% 가슴 빨믄, %CSTR:일인칭%도 커지려나아」
					ELSE
						PRINTFORMW 「%CSTR:이인칭% 우유, 맛있구먼」
						PRINTFORMW 「%CSTR:일인칭%도 %CSTR:이인칭% 아이가 되믄, 매일 우유 마실 수 있겠구먼」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「수유 플레이?」
					ELSE
						PRINTFORMW 「마셨더니 기운이 솟아나 버렸당께♪」
						PRINTFORMW 「얼른 다음 거 하자구%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:이인칭% 가슴, 맛있네」
					ELSE
						PRINTFORMW 「%CSTR:이인칭%의 포상 우유, 음미하며 마실게」
					ENDIF
				ENDIF
				CFLAG:443 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:443 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORMW 「착하게 굴 테니께 더 마셔도 돼?」
				ELSE
					PRINTFORMW 「왠지 말여, %CSTR:일인칭% 가슴 마시고 있자니」
					PRINTFORMW 「엄마랑 있는 것 같아서 안심이 된당께」
					PRINTFORMW 「왜일까나?」
				ENDIF
				CFLAG:443 = 3
			;それ以外
			ELSEIF CFLAG:443 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「이상한 거 안 들어있제?」
					ELSEIF RAND:2 == 0
					PRINTFORMW 「이런 거 마시게 해서 어쩔 셈인겨?」
				ELSE
					PRINTFORMW 「애 취급하지 말어」
				ENDIF
				CFLAG:443 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;99,애무시킨다
;-------------------------------------------------
	CASE 99
		CALL TRAIN_MESSAGE
		;陥落済み
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:462 < 4 || FLAG:7 == 2)
			;ナ─ス服でロ─ション使用後の場合
			IF TEQUIP:옷 == 105 && CFLAG:800 == 1
				PRINTFORMW 「네~에, 숨을 크게 들이쉬시고~」
				PRINTFORML 　
				PRINTFORML 「네, 그대로 참으시게~」
				PRINTFORML 「간지러워도 참아야 한당께~♪」
				PRINTFORMW 간호사 차림의 %CALLNAME%은(는) 배와 하복부를 부드럽게 애무하고 있다
				PRINTFORML 　
				PRINTFORML 「네, 숨을 내쉬고~」
				PRINTFORML 「검사는 끝났당께. 수고 많으셨구먼~」
				;正しくは「腹部エコ─」
				PRINTFORMW %CALLNAME%과(와) 촉진 검진? 플레이를 즐겼다
			;恋慕、親愛
			ELSEIF TALENT:연모 || TALENT:친애
				;前回コマンドが愛撫
				IF PREVCOM == 0
					IF TALENT:PLAYER:남자 == 0 && TALENT:남자 == 0 && TALENT:남성혐오
						PRINTFORML 「봐봐, 기분 좋제?」
						PRINTFORML 「여자끼리라도 이렇게 기분 좋아질 수 있으니께」
						PRINTFORML 「남자 따윈 필요 없구먼%ハート()%」
					ELSE
						PRINTFORMW 「아까 전의 답례랑께♪」
					ENDIF
				ELSEIF RAND:2 == 0
					PRINTFORMW 「저기, 기분 좋아?」
				ELSE
					PRINTFORMW 「어뗘? 흥분되기 시작했어?」
					PRINTFORMW 「%CSTR:일인칭%은 언제든 오케이니께%ハート()%」
				ENDIF
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				IF RAND:2 == 0 && HAVE_PENIS(PLAYER)
					PRINTFORMW 「어뗘? 자지 기분 좋아?」
					PRINTFORMW 「하지만서도, 아직 싸믄 안 된당께%ハート()%」
				ELSE
					PRINTFORMW 「어뗘? 흥분되기 시작했어?」
					PRINTFORMW 「%CSTR:일인칭% 쪽은 언제든 오케이니께%ハート()%」
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				IF RAND:2 == 0
					PRINTFORMW 「이러믄 기분 좋아?」
				ELSE
					PRINTFORMW 「더 세게 하는 게 좋아?」
				ENDIF
			ENDIF
			CFLAG:462 = 4
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3 && (CFLAG:414 < 3 || FLAG:7 == 2)
			PRINTFORMW 「이러믄 기분 좋으려나?」
			CFLAG:462 = 3
		;それ以外
		ELSEIF CFLAG:462 < 2 || FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORMW 「질렸으니께 끝내도 돼?」
			ELSE
				PRINTFORMW 「만져지는 거에 흥분한겨?」
			ENDIF
			CFLAG:462 = 2
		ENDIF


;=================================================
;SM系コマンド
;=================================================
;-------------------------------------------------
;100,스팽킹
;-------------------------------------------------
	CASE 100
		;初めて
		IF CFLAG:354 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:354 < 4 || FLAG:7 == 2)
				PRINTFORMW 「그런 플레이를 해버리는겨?」
			ELSE
				PRINTFORMW 「%CSTR:일인칭%, 나쁜 아이도 아닌디 엉덩이 맞는겨?」
			ENDIF
			CALL TRAIN_MESSAGE
			CFLAG:354 = 1
		;二回目以降
		ELSE
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:354 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「아프지만서도, 이게, 사랑의 형태니께%ハート()%」
				;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
					;남자＋マゾ읏気LV4以上
					IF ABL:마조끼 >= 4
						PRINTFORML 「맞아서 흥분해 버렸당께」
						IF IS_MALE(TARGET)
							PRINTFORMW %CALLNAME%은(는) 커진 자신의 페니스를 가리켰다
						ELSE
							PRINTFORMW %CALLNAME%은(는) 만지지도 않았는데 젖어있는 자신의 가랑이를 보여왔다
						ENDIF
						PRINTFORMW 「이건 책임져 줘야만 하겠제♪」
					ELSE
						PRINTFORMW 「이런 플레이도 나쁘진 않지만서도」
						PRINTFORML 「%CSTR:일인칭%은 이쪽을 쓰는 게 더 좋으려나」
						IF IS_MALE(TARGET)
							PRINTFORMW %CALLNAME%은(는) 자신의 페니스를 가리켰다
						ELSE
							PRINTFORMW %CALLNAME%은(는) 부어오른 엉덩이를 선정적으로 흔들기 시작했다
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:3 == 0 && ABL:마조끼 >= 4
						PRINTFORMW 「맞고서 기뻐해 버리는 변태인 %CSTR:일인칭%한테, 더 벌 내려주면 안 돼%ハート()%」
					;反発刻印LV3からのスパンキング
					ELSEIF RAND:3 == 0 && CFLAG:801 == 1
						PRINTFORML 「%CSTR:이인칭%이 조교해 주고 있는디」
						PRINTFORML 「『죽어버려』라고 말해버린 %CSTR:일인칭%한테」
						PRINTFORMW 「잔뜩 때려주면 안 돼%ハート()%」
					ELSEIF RAND:2
						PRINTFORMW 「아프지만서도」
						PRINTFORMW 「%CSTR:일인칭%, 이거, 좋아앗%ハート()%」
					ELSE
						PRINTFORML 「엉덩이 새빨갛게 부어올라서」
						PRINTFORMW 「이러믄, 화장실도 목욕탕도 못 가게 되어버린다구」
					ENDIF
				ENDIF
				CFLAG:354 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:354 < 3 || FLAG:7 == 2)
				PRINTFORML 「요즘 말여, 맞고 있으믄 이상한 느낌이 들어」
				IF ABL:마조끼 >= 4
					PRINTFORMW 「아픈 게 말여, 왠지 조금 기쁘당께」
				ELSE
					PRINTFORMW 「『%CSTR:이인칭% 말 단디 들어야제』라고 생각하게 된당께」
				ENDIF
				CFLAG:354 = 3
			;それ以外
			ELSEIF CFLAG:354 < 2 || FLAG:7 == 2
				IF ABL:마조끼 >= 4
					PRINTFORML 「기, 기뻐하는 거 아니당께」
					PRINTFORMW 「아플 뿐이니께」
				ELSE
					PRINTFORMW 「%CSTR:일인칭%, 나쁜 아이도 아닌디 왜 때리는겨」
				ENDIF
				CFLAG:354 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;101,젖스팽킹
;-------------------------------------------------
	CASE 101
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:355 == 0
			IF TALENT:연모 || TALENT:친애
				PRINTFORML 「아야」
				PRINTFORMW 「갑자기 때리다니 너무하당께」
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORML 「아앙♪」
				PRINTFORMW 「아프당께, %CSTR:이인칭%%ハート()%」
			ELSE
				PRINTFORML 「아야!」
				PRINTFORMW 「왜 때리는겨어!」
			ENDIF
			CFLAG:355 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:355 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORML 「앙앗%ハート()%」
					IF TALENT:모유체질 == 2
						PRINTFORMW 「아기한테 줄 우유, 안 나오게 되어버린당께」
					ELSE
						PRINTFORMW 「아기 생겼을 때의 우유, 안 나오게 되어버린당께」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;子供なんにでかかとは罪
					;聖乳んTALENTが判らんけん判断に入れいてません
					IF RAND:4 == 0 && BUST() > 3
						PRINTFORMW 「어린애인디 가슴이 큰 건 싫어?」
					ELSEIF RAND:3 == 0 && BUST() < 3
						PRINTFORMW 「작은 게 불만이어도」
						PRINTFORMW 「어린애니께 가슴 작은 건 당연한 거 아녀?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「앙앗%ハート()%」
						PRINTFORMW 「가슴은 때리는 곳이 아니당께」
					ELSE
						PRINTFORMW 「가슴 괴롭힘당하는 거 싫지는 않지만서도」
						PRINTFORMW 「이런 괴롭힘은 별로 안 좋으려나」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「앙앗%ハート()%」
					;小さいは悪
					IF BUST() < 3
						PRINTFORMW 「작은 가슴이라서 죄송해요!」
					;子供なんにでかかとは罪
					;聖乳のTALENTが判らないので判断に入れいてません
					ELSEIF BUST() > 3
						PRINTFORMW 「어린애인디 가슴이 커서 죄송해요!」
					ELSE
						PRINTFORMW 「미안해요, 죄송해요♪」
					ENDIF
				ENDIF
				CFLAG:355 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:355 < 3 || FLAG:7 == 2)
				PRINTFORML 「요즘 말여, 가슴 맞고 있으믄 이상한 기분이 든당께」
				IF ABL:마조끼 >= 4
					PRINTFORMW 「아픈 게 말여, 왠지 조금 기쁘당께」
				ELSE
					PRINTFORMW 「『%CSTR:이인칭% 말 단디 들어야제』라고 생각하게 된당께」
				ENDIF
				CFLAG:355 = 3
			;それ以外
			ELSEIF CFLAG:355 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「아파, 아프당께!」
				ELSE
					PRINTFORMW 「때리지 말어!」
				ENDIF
				CFLAG:355 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;102,채찍
;-------------------------------------------------
	CASE 102
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:356 == 0
			PRINTFORML 「아야!」
			IF TALENT:연모 || TALENT:친애
				PRINTFORMW 「갑자기라니 너무하당께」
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORMW 「아프당께, %CSTR:이인칭%%ハート()%」
			ELSE
				PRINTFORMW 「왜 채찍으로 때리는겨!」
			ENDIF
			CFLAG:356 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:356 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORMW 「자국 남아버렸구먼」
						PRINTFORMW 「하지만서도, %CSTR:이인칭%이 주는 거라믄 뭐든지 좋당께%ハート()%」
					ELSE
						PRINTFORMW 「아팠지만서도, 이게 %CSTR:이인칭%한테 사랑받는 증거구먼%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORML 「아픈 것도 나쁘진 않지만서도」
					PRINTFORMW 「더 다른 걸로 기분 좋게 해줬으면 좋겠구먼♪」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「아프지만서도···」
					PRINTFORMW 「이게 %CSTR:일인칭%이랑 %CSTR:이인칭%의 유대니께 괜찮당께%ハート()%」
				ENDIF
				CFLAG:356 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:356 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0 && (TALENT:마조 || TALENT:아픔에강함)
					PRINTFORMW 「아픈 게 점점 버릇이 되어버려서……」
				ELSE
					PRINTFORMW 「죄송해요, 말 잘 들을 테니께 이제 용서해줘……」
				ENDIF
				CFLAG:356 = 3
			;それ以外
			ELSEIF CFLAG:356 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「아파, 아프당께!」
				ELSE
					PRINTFORMW 「자국 남아버렸당께! 믿을 수가 없어!」
				ENDIF
				CFLAG:356 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;103,양초
;-------------------------------------------------
	CASE 103
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:357 == 0
			PRINTFORMW 「뜨거워, 뜨겁당께!」
			CFLAG:357 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:357 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORML 「이것도 애정이구먼」
					ELSE
						PRINTFORML 「이게 열기로 건강해지는 『뜸』이라는 거제」
					ENDIF
					PRINTFORMW 「뜨겁지만서도, 참아볼 테니께%ハート()%」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「촛농뿐만 아니라, 몸속에서도 뜨거워져 오고 있당께!」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「더, 더 괴롭혀줘!」
					ELSE
						PRINTFORMW 「뜨거워! 뜨거운 거 더 떨어뜨려줘!」
					ENDIF
				ENDIF
				CFLAG:357 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:357 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0 && (TALENT:마조 || TALENT:아픔에강함)
					PRINTFORMW 「아픈 게 점점 버릇이 되어버려서……」
				ELSE
					PRINTFORMW 「죄송해요, 말 잘 들을 테니께 이제 용서해줘……」
				ENDIF
				CFLAG:357 = 3
			;それ以外
			ELSEIF CFLAG:357 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「뜨거워, 뜨겁당께!」
				ELSE
					PRINTFORMW 「그만해! 뜨겁고 아프당께!」
				ENDIF
				CFLAG:357 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;104,바늘
;-------------------------------------------------
	CASE 104
		;初めて
		IF CFLAG:358 == 0
			IF TALENT:소인체형 && TALENT:날개
				PRINTFORML 「설마··· 날개 같은 걸 붙인 건 %CSTR:일인칭%을 표본으로 만들 셈인겨?」
				PRINTFORMW 조금 착각하고 있는 듯하여 어떻게 쓸지 %CALLNAME%에게 설명했다
				PRINTFORML  
				PRINTFORML 「다행이다··· 가 아니잖여~」 
				PRINTFORM  비명을 무시하고,
			ELSE
				PRINTFORMW 「그런 거 들고 어쩔 셈인겨?」
			ENDIF
			CALL TRAIN_MESSAGE
			IF TALENT:마조 || TALENT:아픔에강함
				PRINTFORMW 「아프지만서도··· 조금 기분 좋을지도」
				PRINTFORMW 「이게 『혈자리』라는 거구먼」
			ENDIF
			CFLAG:358 = 1
		;二回目以降
		ELSE
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:358 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORML 「아야!」
					ELSE
						PRINTFORML 「이거 『침뜸』이라는 거제」
					ENDIF
					PRINTFORMW 「아프지만서도, 참아볼 테니께%ハート()%」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「바늘보단 말여, 다른 걸로 찔러줬으면 좋겠구먼♪」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORML 「아파, %CSTR:이인칭%!」
					ELSE
						PRINTFORML 「그렇게 찌르믄, 몸에 구멍 뚫려버린다구!」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%을(를) 기쁘게 하고자 아픔을 참지 않고 비명을 지르고 있다
				ENDIF
				CFLAG:358 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:358 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0 && (TALENT:마조 || TALENT:아픔에강함)
					PRINTFORMW 「아픈 게 점점 버릇이 되어버려서……」
				ELSE
					PRINTFORMW 「죄송해요, 말 잘 들을 테니께 이제 용서해줘……」
				ENDIF
				CFLAG:358 = 3
			;反発もち
			ELSEIF MARK:3 >= 1
				IF RAND:2 == 0
					PRINTFORML 「그런 짓을 당해봤자……」
					PRINTFORMW 「%CSTR:일인칭%, 안 져」
				ELSE
					PRINTFORML 「아파, 아파, 아프다구!」
					PRINTFORMW %CALLNAME%은(는) 이를 악물며 이쪽을 노려보고 있다
				ENDIF
			;それ以外
			ELSEIF CFLAG:358 < 2 || FLAG:7 == 2
				PRINTFORMW 「아파, 이제 그만해……」
				CFLAG:358 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;105,아이마스크
;-------------------------------------------------
	CASE 105
		IF TEQUIP:18 == 1
			CALL TRAIN_MESSAGE
			;初めて
			IF CFLAG:359 == 0
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:359 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						PRINTFORMW 「엣, 그러믄 %CSTR:이인칭% 얼굴이 안 보이게 되어버린다구」
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						PRINTFORMW 「눈가림 플레이?」
						PRINTFORMW 「잘 모르겠지만서도, 그쪽이 더 야한겨?」
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						PRINTFORMW 「눈가림 형벌이구먼」
					ENDIF
					CFLAG:359 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:359 < 3 || FLAG:7 == 2)
					PRINTFORMW 「안 보인다고 이상한 짓 할 거제…」
					CFLAG:359 = 3
				;ランダム奴隷キャラん場合
				ELSEIF CFLAG:이벤트가입 == 3
					PRINTFORMW 「설마, 또 납치할 셈인겨…」
					CFLAG:359 = 2
				;それ以外
				ELSEIF CFLAG:359 < 2 || FLAG:7 == 2
					PRINTFORMW 「설마 이대로 팔아넘길 셈인겨…」
					CFLAG:359 = 2
				ENDIF
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:359 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						PRINTFORMW 「안 보이게 되는 건 무섭지만서도, %CSTR:이인칭%이 곁에 있다는 걸 알고 있으니께 괜찮당께%ハート()%」
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						PRINTFORMW 「안 보이는 만큼, 오히려 흥분되네」
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						PRINTFORMW 「안 보이게 되믄, 여러모로 두근두근거리네」
					ENDIF
					CFLAG:359 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:359 < 3 || FLAG:7 == 2)
					IF RAND:2 == 0
						PRINTFORML 「또 눈가림?」
					ELSE
						PRINTFORML 「이번엔 뭘 할 셈인겨?」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) 공포와 기대가 뒤섞인 표정을 짓고 있다
					CFLAG:359 = 3
				;それ以外
				ELSEIF CFLAG:359 < 2 || FLAG:7 == 2
					PRINTFORML 「이번에야말로 팔아넘길 셈인 거제……」
					PRINTFORMW 여전히 신용하지 않는 모양이다
					CFLAG:359 = 2
				ENDIF
			ENDIF
		ELSEIF SELECTCOM == 105
			IF CFLAG:359 == 1 || FLAG:7 == 2
				CALL TRAIN_MESSAGE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:359 < 4 || FLAG:7 == 2)
					PRINTFORMW 「이제 끝인겨?」
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:359 < 3 || FLAG:7 == 2)
					;ランダム奴隷キャラん場合
					IF CFLAG:이벤트가입 == 3
						PRINTFORMW 「다행이다……」
						PRINTFORMW 「또 끌려가는 건가 걱정했었당께」
					ELSE
						PRINTFORMW 「…다행이다, 눈가림당한 채 이상한 곳으로 끌려가는 줄 알았는디」
					ENDIF
					CFLAG:359 = 3
				;それ以外
				ELSEIF CFLAG:359 < 2 || FLAG:7 == 2
					PRINTFORMW 「무, 무섭거나 하진 않았당께」
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;106,밧줄
