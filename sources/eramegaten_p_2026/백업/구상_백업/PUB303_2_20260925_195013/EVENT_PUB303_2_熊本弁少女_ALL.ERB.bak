;	ENDIF
;口上のある助手が居ない場合は、通常の二回目以降の口上へ飛ぶ
ELSE
	CALL EVENTTRAIN_SECOND_PUB303_2
ENDIF

;-------------------------------------------------
;調教開始時（2回目以降、X1をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_PUB303_2
	CALL EVENTTRAIN_MESSAGE_CLOTHES

	;CFLAG初期化
	CFLAG:800 = 0
	IF CFLAG:802 < DAY
		CFLAG:802 = 0
	ENDIF

;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
	;恋慕、親愛
	IF TALENT:연모 || TALENT:친애
		PRINTFORML 「요새, 쪼~까 너무 많이 하는 거 아녀?」
	;淫乱、娼婦
	ELSEIF TALENT:음란 || TALENT:창부
		PRINTFORMW 「기분 좋은 건 좋지만서도, %CSTR:이인칭%은 싫당께」
	;服従、隷属
	ELSEIF TALENT:복종 || TALENT:예속
		PRINTFORML 「………」
		PRINTFORMW 「또 벌 주는겨……」
	ELSE
		SIF CFLAG:이벤트가입 == 3
			PRINTFORML 「이래선 지하 감옥에 처박혀 있는 거랑 다를 게 없잖여…」
		IF RAND:3 == 0
			PRINTFORMW 「이 똥자루 녀석, 용서 안 할겨. 레알루!」
			PRINTFORML 평소와 다르게 %CALLNAME%의 말투가 거칠다.
			PRINTFORMW 여기선 누가 위인지 똑똑히 깨닫게 해주자.
		ELSEIF RAND:2 == 0
			PRINTFORML 「두 번 다시 부르지 말라고 말했잖여」
			PRINTFORMW 「…%CSTR:일인칭%, 이런 거 싫당께. 얼른 집어치우랑께」
		ELSE
			PRINTFORMW 「얼굴도 보기 싫은디 뭣하러 왔는겨」
		ENDIF
	ENDIF
	CFLAG:202 = 4
;屈服刻印Lv0
ELSEIF MARK:2 == 0 && (CFLAG:202 < 1 || FLAG:7 == 2)
	IF CFLAG:이벤트가입 == 3 && RAND:4 == 0
		PRINTFORML 「납치당해갖고, 지하 감옥에 갇히고」
		PRINTFORMW 「이번엔 조교라니……」
	ELSEIF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐
		PRINTFORML 「또 하는겨? 또 할겨?」
		PRINTFORMW 「바보여? 변태여?」
	ELSEIF TALENT:소악마
		PRINTFORML 「저기 말이여, %CSTR:이인칭%은 조교에 안 맞는 거 아녀?」
		PRINTFORML 「전~혀, 기분 좋지도 않구먼」
		IF RAND:2 == 0
			PRINTFORMW = 「이럴 바엔 혼자 자위하는 게 훨씬 기분 좋겄구먼」
		ELSE
			PRINTFORMW = 「길 가는 아저씨가 더 잘하지 않겄어?」
		ENDIF
	ELSE
		PRINTFORMW 「또 하는겨?」
		IF RAND:2 == 0
			PRINTFORMW 「이제 고만 좀 해라잉~……」
		ELSE
			PRINTFORMW 「……언제쯤 집에 보내줄 텐가?」
		ENDIF
	ENDIF
	CFLAG:202 = 1
;屈服刻印Lv1
ELSEIF MARK:2 == 1 && (CFLAG:202 < 2 || FLAG:7 == 2)
	PRINTFORMW 「아, 오늘은 조교여?」
	IF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐
		PRINTFORMW 「…변태」
		PRINTFORMW 「라고 말해봤자 소용없겠지만서도~!」
	ELSE
		IF RAND:2 == 0
			PRINTFORMW 「너무 모진 짓은, 하지 말어?」
		ELSE
			PRINTFORMW = 「또 하는겨?」
		PRINTFORMW = 「이번엔 좀 더 잘해봐, 알았제?」
		ENDIF
	ENDIF
	CFLAG:202 = 2
;屈服刻印Lv2
ELSEIF MARK:2 == 2 && (CFLAG:202 < 3 || FLAG:7 == 2)
	PRINTFORML 「아, 조교하는 거로구먼」
	PRINTFORMW 「오늘은 대체 뭘 할라나?」
	PRINTFORML 
	IF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐
		PRINTFORMW 「…아, 저기, 딱히 야한 짓을 바라는 건 아니랑께」
		PRINTFORML 「그래, 마음의 준비!」
		PRINTFORMW 「마음의 준비를 해두고 싶었을 뿐이랑께!」
	ELSE
		PRINTFORMW 「…아, 쪼까 말이여…… 조교가 재미있어지기 시작했응게… 그치」
	ENDIF
	CFLAG:202 = 3
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:연모 == 0 && TALENT:음란 == 0 && TALENT:복종 == 0 && TALENT:친애 == 0 && TALENT:창부 == 0 && TALENT:예속 == 0) && (CFLAG:202 < 4 || FLAG:7 == 2)
	IF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐
		PRINTFORML 「아, 오늘도여?」
		PRINTFORMW 불려 나온 %CALLNAME%은(는) 얼굴을 활짝 밝혔지만, 이내 시치미 뗀 얼굴로 꾸며대기 시작했다.
		PRINTFORML 「기, 기대하고 있던 건 아니랑께」
		PRINTFORMW %CALLNAME%은(는) 쭈뼛거리며 안쪽 허벅지를 비벼대고, 얼굴을 붉히고 있다
		PRINTFORMW 「심심하니께, 어울려줘도 괜찮다는 것뿐이랑께」
		PRINTFORMW 「거짓말 아녀. 두근두근 같은 건 안 한다면 안 하는 거여!」
	ELSEIF TALENT:소악마
		IF RAND:2 == 0
			PRINTFORMW 「오늘도 애 상대로 어떤 플레이를 할 셈인겨?」
		ELSE
			PRINTFORML 「이제야 왔네~」
			PRINTFORMW 「아주 기다리다 지쳐버렸구먼」
		ENDIF
	ELSE
		PRINTFORMW 「아, %CSTR:이인칭%. 기다리고 있었당께, 조교제?」
		IF RAND:2 == 0
			PRINTFORMW 「오늘은 어떤 걸 해줄까나?」
		ELSE
			PRINTFORMW 「오늘은 어떤 걸 해줄 텐가?」
		ENDIF
	ENDIF
	CFLAG:202 = 4
;陥落済み
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:연모 || TALENT:친애
		K:1 = RAND:3
		IF TALENT:츤데레
			IF K:1 == 0
				;妻
				IF TALENT:아내
					PRINTFORML 「마누라를 팽개쳐두다니 뭔 생각인겨, %CSTR:이인칭%?」
				ELSE
					PRINTFORML 「늦었잖여」
				ENDIF
				PRINTFORMW %CALLNAME:MASTER%이 오자 %CALLNAME%은(는) 옷을 벗기 시작했다.
				IF RAND:2 ==0
					PRINTFORML 「아, 아니당께!」
					PRINTFORMW 「이건 옷 구겨지지 말라고 벗은 것뿐이니께」
					PRINTFORML 
					PRINTFORMW 「！」
					PRINTFORMW 「부끄러우니께 저쪽 보고 있어!」
				ELSE
					PRINTFORML 「아, 아니당께! 여는 방이 더워서 그런 거여. 아~ 덥다, 더워」
					PRINTFORMW %CALLNAME%은(는) 손으로 자기 몸을 부치기 시작했다.
				ENDIF
			ELSEIF K:1 == 1
				PRINTFORMW 「약속 시간보다 3분 늦었지만서도, 특별히 용서해 주마」
				PRINTFORML 「자, 늦은 만큼 제대로 에스코트하시게」
				PRINTFORMW %CALLNAME%은(는) 쑥스러운 듯 %CALLNAME:MASTER%에게 손을 내밀었다.
			ELSE
				PRINTFORMW 「또 왔는겨?」
				PRINTFORMW 「%CSTR:이인칭%도 참 더럽게 한가한가 보구먼」
				PRINTFORMW 「…불쌍하니께 %CSTR:일인칭%이 상대해 주마♪」
			ENDIF
		ELSE
;コスプレモ─ド
			;＠がサンタコ─トを着ている場合
			IF TEQUIP:MASTER:90 == 1034 && HAVE_PENIS(MASTER) && HAVE_VAGINA() && TALENT:임신 == 0
				PRINTFORML 「산타 양반, 있잖여」
				PRINTFORML 「선물은 말이여…」
				PRINTFORMW 「아기가 좋당께%ハート()%」
				PRINTFORML 　
				IF RAND:2 == 0
					PRINTFORML 「대단허다…… 산타 양반의 선물, 가~득 차 있구먼%ハート()%」
					PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%의 가랑이에 볼을 비비고 있다…
				ELSE
					PRINTFORML 「대단허다…… 산타 양반의 선물, 가~득 차 있구먼%ハート()%」
