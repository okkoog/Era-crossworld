				PRINTFORML 「응」
				PRINTFORMW 「그라믄, 다녀올게……」
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORMW 「그라믄, 다녀올게잉♪」
			;服従、隷属
			ELSE
				PRINTFORMW 「그라믄, 다녀올게」
				IF CFLAG:477 == 0
					PRINTFORMW 「지시대로 똑바로 할 테니께~」
				ELSE
					PRINTFORMW 「전보다 더 잘할 팅께, 돌아오믄 상 줘야 혀♪」
				ENDIF
			ENDIF
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3 && (CFLAG:414 < 3 || FLAG:7 == 2)
			PRINTFORMW 「그라믄, 다녀올게……」
		;それ以外
		ELSEIF CFLAG:414 < 2 || FLAG:7 == 2
			IF CFLAG:477 == 0
				PRINTFORML 「………」
				PRINTFORMW 이어폰 마이크에서 내려오는 지시대로 행동하도록 명령하며 %CALLNAME%을(를) 내보냈다…
			ELSE
				PRINTFORMW 「또, 그거……」
			ENDIF
		ENDIF
		PRINTFORML 
		CALL TRAIN_MESSAGE
		CFLAG:477 = 1

;-------------------------------------------------
;204,정액먹기
;-------------------------------------------------
	CASE 204
		CALL TRAIN_MESSAGE
		;陥落済み
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				PRINTFORMW 
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				IF RAND:2 == 0
					PRINTFORMW 「푸하」
					PRINTFORMW 「맛있었당께%ハート()%」
				ELSE
					PRINTFORMW 「잘 먹었습니데이」
				ENDIF
				IF RAND:3 == 0 && CFLAG:478 == 0
					PRINTFORMW 「다음번에 또 먹여주시게♪」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「한 잔 더 있어?」
				ELSE
					PRINTFORMW 「하지만서도, 다음엔 보지로 마시게 해주시게%ハート()%」
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORMW 
			ENDIF
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3 && FLAG:7 == 2
			PRINTFORMW 「복잡한 맛이 나네」
		;それ以外
		ELSEIF FLAG:7 == 2
			IF RAND:3 == 0 && CFLAG:478 == 1
				PRINTFORMW 「또 이런 걸 먹이다니……」
			ELSEIF RAND:2 == 0
				PRINTFORML 「마셨당께…」
				PRINTFORMW %CALLNAME%은(는) 눈물을 글썽이며 보고해 왔다
			ELSE
				PRINTFORML 「이젠…… 이런 거… 마시고 싶지 않당께…」
				PRINTFORMW %CALLNAME%은(는) 울먹이며 중얼거렸다
			ENDIF
		ENDIF
		CFLAG:478 = 1

;-------------------------------------------------
;210,귀두공격
;-------------------------------------------------
	CASE 210
		;初めて
		IF CFLAG:480 == 0
			IF 陥落( ) > 0 && (CFLAG:480 < 3 || FLAG:7 == 2)
				PRINTFORML 「이렇코롬 기분 좋은 기, 참을 수가 없당께♪」
				PRINTFORMW %CALLNAME%은(는) 허리를 덜컥덜컥 흔들고 있다……
				;恋慕系陥落しているのに助手に亀頭責めをさせてるのを見る鬼畜生たけし
				IF ASSI > 0 && ASSIPLAY && (TALENT:연모 || TALENT:친애)
					PRINTFORML 「죄송혀요, %CSTR:이인칭%」
					PRINTFORMW 「하지만서도 기분 좋은 걸요♪」
				ELSE
					PRINTFORML 「더, 더 거길%ハート()%」
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:480 < 2 || FLAG:7 == 2)
				PRINTFORML 「안 돼읏,」
				PRINTFORMW 「그런 짓 당했다간, %CSTR:일인칭%…… 져버린당께♪」
			;それ以外
			ELSEIF (CFLAG:480 || FLAG:7 == 2)
				PRINTFORML 「안 돼」
				PRINTFORMW 「꼬추 그렇게 괴롭히지 마시게♪」
			ENDIF
			CFLAG:480 = 1
		ELSE
			IF 陥落( ) > 0 && (CFLAG:480 < 3 || FLAG:7 == 2)
				IF TALENT:복종 || TALENT:예속
					PRINTFORML 「안 된당께」
					PRINTFORML 「기분 좋아서, 단숨에 정액 나와버리겠당께♪」
					PRINTFORMW 「%CSTR:이인칭%, 괜찮아? 정액 싸버려도 괜찮아?」
				ELSE
					IF RAND:2 == 0
						;恋慕系陥落しているのに助手に亀頭責めをさせてるのを見る鬼畜生たけし
						IF ASSI > 0 && ASSIPLAY && (TALENT:연모 || TALENT:친애)
							PRINTFORML 「%CSTR:이인칭% 것도 아닌디, %CSTR:이인칭%이 쳐다보고 있는디도」
							PRINTFORML 「기분 좋은 걸, 참을 수가 없당께」
						ELSE
							PRINTFORML 「거기, 거기가 너무 좋아앗%ハート()%」
						ENDIF
						PRINTFORMW %CALLNAME%은(는) %CALLNAME:PLAYER%의 움직임에 맞추어 허리를 움직이고 있다……
					ELSE
						PRINTFORML 「안 돼, 더 즐기고 싶은디」
						PRINTFORMW 「기분 좋아서, 단숨에 정액 나와버린당께♪」
						;恋慕系陥落しているのに助手に亀頭責めをさせてるのを見る鬼畜生たけし
						IF ASSI > 0 && ASSIPLAY && (TALENT:연모 || TALENT:친애)
							IF RAND:2 == 0
								PRINTFORML 「미안혀, %CSTR:이인칭%. %CSTR:일인칭%만 기분 좋아져선」
								PRINTFORMW 「하지만서도, 기분 좋은 걸%ハート()%」
							ELSE
								PRINTFORMW 「꼬추 자극받아가, 기분 좋아하고 있는 %CSTR:일인칭%을, 싫어하지 말아주시게……」
							ENDIF
						ELSEIF TALENT:복종 || TALENT:예속
							PRINTFORML 「『사정 금지』라고 들었는디도」
							PRINTFORMW 「%CSTR:이인칭% 입이, 너무 기분 좋아서 못 참겠당께」
						ELSE
							PRINTFORML 「가버리겠구마, 꼬추 끝부분 괴롭힘당해서, 가버린당께%ハート()%」
						ENDIF
					ENDIF
				ENDIF
				CFLAG:480 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:480 < 2 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORML 「안 된당께」
					PRINTFORMW 「기분 좋은 거에, 져버려! 져버린당께♪」
				ELSE
					PRINTFORML 「더 해줘, 더!」
					PRINTFORMW 「%CSTR:일인칭%, 착한 아이가 될 팅께♪」
				ENDIF
				CFLAG:480 = 3
			;それ以外
			ELSEIF (CFLAG:480 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORMW 「안 돼, 떨어져!」
					PRINTFORML %CALLNAME:PLAYER%의 머리를 붙잡고 떼어내려 하는 %CALLNAME%이었지만,
					PRINTFORMW 이내 붙잡은 %CALLNAME:PLAYER%의 머리를 앞뒤로 흔들어대고 있다……
					PRINTFORMW 「안 돼, 앙대애……%ハート()%」
				ELSE
					PRINTFORMW 「안 돼, 거긴 약하단 말여!」
				ENDIF
				CFLAG:480 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;211,귀두공격(受)
;-------------------------------------------------
	CASE 211
		;陥落済み
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) &&  FLAG:7 == 2
			;オチンチンなんて咥えたことないよ
			IF EXP:펠라경험 == 0 && CFLAG:479 == 0
				PRINTFORMW 「입으로 꼬추를 훑어주는겨?」
				PRINTFORMW 「응, 해볼게」
				CALL TRAIN_MESSAGE
			ELSE
				IF RAND:2 == 0
					CALL TRAIN_MESSAGE
					PRINTFORMW 「어뗘? 날름날름 핥아주는 거랑 달리가 기분 좋아?」
				ELSE
					PRINTFORMW 「입으로 딸딸이 쳐줄팅께♪」
					CALL TRAIN_MESSAGE
				ENDIF
			ENDIF
		ELSEIF FLAG:7 == 2
			;オチンチンなんて咥えたことなかよ
			IF EXP:펠라경험 == 0 && CFLAG:479 == 0
				PRINTFORML 「에, 꼬추를 입에 넣는겨?」
				PRINTFORML 「아, 안 된당께! 더러워가 병에 걸려버린다구!」
				PRINTFORM 다시금 명령하자, 꽉 눈을 감은
			ELSE
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) &&  FLAG:7 == 2
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭%의 입으로 기분 좋게 해줄팅께」
					ELSE
						PRINTFORMW 「뿌리까지 제대로 물어줄팅께♪」
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「또 해야만 하는겨? 으~」
					ELSE
						PRINTFORMW 「이걸로 사정하믄 오늘은 끝인 거제?」
					ENDIF
				ENDIF
			ENDIF
			CALL TRAIN_MESSAGE
		ENDIF
		CFLAG:479 = 1

;=================================================
;500番台,派生コマンド
;=================================================
;-------------------------------------------------
;500,３Ｐ
;-------------------------------------------------
	CASE 500
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:407 == 0
			;処女
			IF TALENT:0
				PRINTFORMW 「에, 에, 3명이서!? 안 된당께, 적어도 평범하게… 부끄럽단 말이여」
			;それ以外
			ELSE
				PRINTFORMW 「%CALLNAME:ASSI%도 같이? 그거 대단한 일이 될 것 같구마…」
			ENDIF
			CFLAG:407 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:407 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORML 「아앙! %CALLNAME:ASSI% 자지도 기분 좋은 기라!」
						PRINTFORML 「%CSTR:이인칭%을(를) 좋아하는디도!」
						IF TEQUIP:Ｖ삽입자 == MASTER
							PRINTFORMW %CALLNAME%은(는) %CALLNAME:PLAYER%에게 키스하면서 2구멍 동시 공략에 신음하고 있다
						ELSE
							PRINTFORMW 「뒤에서 꼬옥~ 끌어안아 주시게! 이대로 가단 %CALLNAME:ASSI% 꼬추 땜에 이상해져 버린당께!」
						ENDIF
					ELSE
						PRINTFORMW 「%CSTR:이인칭%이 좋아%ハート()%」
						PRINTFORML 「%CSTR:이인칭%을(를) 좋아하는디도」
						PRINTFORMW 「%CSTR:이인칭% 거 아닌 꼬추도 기분 좋은 기라%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:3 == 0
						PRINTFORMW 「하앙! 좋당께에! 더 범해줘! 둘 다 엉망진창으로 만들어줘어!」
					ELSEIF RAND:2 == 0
						PRINTFORML 「대애박! 양~쪽으로 꼬추가 들어와 있당께!」
						PRINTFORMW 「양~쪽 꼬추로 정액 잔뜩 뿜어주시게%ハート()%」
					ELSE
						PRINTFORMW 「더, 더 하자잉%ハート()%」
						PRINTFORMW 「세 명이든 네 명이든, %CSTR:일인칭%, 끄떡없당께♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「부탁이여, %CSTR:이인칭%, %CALLNAME:ASSI%」
					IF RAND:2 == 0
						PRINTFORMW 「더, 더 팡팡 쑤셔줘어!」
					ELSE
						PRINTFORMW 「음란한 노예에게, 벌을 더 내려줘어!」
					ENDIF
				ENDIF
				CFLAG:407 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:407 < 3 || FLAG:7 == 2)
				PRINTFORML 「둘이서 덤벼드는 건 안 된당께…」
				PRINTFORMW 「이렇코롬 기분 좋은 거, 못 참는당께!」
				CFLAG:407 = 3
			;それ以外
			ELSEIF CFLAG:407 < 2 || FLAG:7 == 2
				PRINTFORML 「아, 안 돼!」
				PRINTFORMW 「%CSTR:일인칭%, 부서져버려!」
				CFLAG:407 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;501,식스나인
;-------------------------------------------------
	CASE 501
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:408 == 0
			PRINTFORMW 「쪽, 읍… 아, 히야, 아앙!」
			PRINTFORMW %CALLNAME%은(는) 비부에서 오는 자극에, 마음먹은 대로 페니스 봉사를 이어가지 못하는 모양이다.
			CFLAG:408 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:408 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「아, 히야! %CSTR:이인칭%, 너무 기분 좋아서 안 돼애! …응, 읍, 쥬룹%ハート()%」
					PRINTFORMW %CALLNAME%은(는) 필사적으로 페니스 봉사를 이어가려 하지만, 주어지는 유열에 몸을 튕겨 올린다.
					PRINTFORMW 「지금 기분 좋게 해주는 건 %CSTR:일인칭%인디 말여어… 아, 히앙! 아앙!」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「응, 읍… 앗 하앙! 히아아!! 아앗 그거 좋아…! %CSTR:이인칭%! 그거 좋당께에! 더어!!」
					PRINTFORMW %CALLNAME%은(는) 입 봉사를 더욱 격하게 하면서, 사타구니를 %CALLNAME:MASTER%의 얼굴에 강하게 짓눌렀다.
					PRINTFORMW 「으무우! 무으아앙! 힉! 아아앗! …읍! 므후으응!」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 
				ENDIF
				CFLAG:408 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:408 < 3 || FLAG:7 == 2)
				PRINTFORMW 「응! 읍! …쪽, 아, 히앙! 으무우…」
				PRINTFORMW 비부에서 오는 쾌락에 굴복할 뻔하면서도, %CALLNAME%은(는) 정신없이 페니스 봉사를 이어갔다.
				CFLAG:408 = 3
			;それ以外
			ELSEIF CFLAG:408 < 2 || FLAG:7 == 2
				PRINTFORMW 「응, 읍… 아, 아앙! …쪽, 낼름」
				CFLAG:408 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;502,이와시미즈
;-------------------------------------------------
	CASE 502
		;初めて
		IF CFLAG:409 == 0
			PRINTFORMW 「위에 올라타는겨?」
			CALL TRAIN_MESSAGE
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:409 < 4 || FLAG:7 == 2)
				PRINTFORML 「야한 소리를 내며 핥아지믄, 엄~청 좋당께%ハート()%」
				PRINTFORMW %CALLNAME:TARGET%은(는) 스스로 %CALLNAME:PLAYER%에게 비순을 짓누르고 있다
			ELSE
				PRINTFORMW 「안 돼읏, 소리 내면서 핥으믄 안 된당께읏」
			ENDIF
			CFLAG:409 = 1
		;二回目以降
		ELSE
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:409 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF TALENT:임신 == 0 && RAND:3 == 0
						PRINTFORMW 「보지 준비 다 됐으니께」
						PRINTFORMW 「아기 만들자잉%ハート()%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭% 보지, 맛있어?」
						PRINTFORMW 「핥는 것뿐만 아니라, 꿀꺽 먹어버려도 괜찮당께%ハート()%」
					ELSE
						PRINTFORML 「이 이상 계속했다간 나와버리니께」
						PRINTFORMW 「이, 이젠 끝!」
						PRINTFORML 
						PRINTFORMW 「에, 『싸도 괜찮다』고?」
						PRINTFORML 「안 돼!」
						IF TALENT:아내
							PRINTFORML 「부부 사이라도 안 되는 건 안 되는 법이랑께!」
						ELSE
							PRINTFORML 「좋아하는 사람한테라도 보여주고 싶지 않당께!」
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:3 == 0
						PRINTFORMW 「%CSTR:일인칭% 보지, 맛있어?」
						PRINTFORMW 「얼마든지 리필해 줄 팅께♪」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「응읏…… 거기……」
						PRINTFORMW 「더 거길 핥아주시게……%ハート()%」
					ELSE
						PRINTFORML 「야한 소리를 내며 보지가 핥아져 버리니께」
						PRINTFORMW 「%CSTR:일인칭%도 야한 기분이 들어버렸당께♪」
						PRINTFORMW 「질척질척한 보지에 커다란 꼬추 주시게%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:3 == 0
						PRINTFORMW 「보지 기분 좋아♪」
						PRINTFORML 「더 기분 좋은 봉사 해줄 팅께」
						PRINTFORMW 「보지 더 핥아주시게%ハート()%」
					ELSE
						PRINTFORMW 「%CSTR:일인칭%이 봉사해야 하는디」
						PRINTFORMW 「거꾸로 봉사를 받아가 기분 좋아져선」
						PRINTFORMW 「%CSTR:일인칭%, 행복하당께%ハート()%」
					ENDIF
				ENDIF
				CFLAG:409 = 4
			;反発刻印Lv3
			ELSEIF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORML 「으~~」
					PRINTFORMW 「기분 나쁘니께 어여 놔주시게」
				ELSE
					PRINTFORML 「야한 소리 내지 마시게!」
					PRINTFORMW 싫어하는 %CALLNAME%의 목소리를 무시하고 %CALLNAME:PLAYER%은(는) 한층 더 소리를 내며 들이마셨다
				ENDIF
				CFLAG:409 = 2
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:409 < 3 || FLAG:7 == 2)
				PRINTFORMW 「더 핥아도 괜찮당께」
				IF RAND:2 == 0
					PRINTFORMW 「그라믄 더 야한 오줌이, 나와불 텐디……」
				ELSE
					PRINTFORMW 「그쪽이, %CSTR:이인칭%도 %CSTR:일인칭%도 기분 좋을 테고……」
				ENDIF
				CFLAG:409 = 3
			;それ以外
			ELSEIF CFLAG:409 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「부끄러운디도 기분 좋아……」
				ELSE
					PRINTFORML 「안 돼, 이거 안 돼!」
					PRINTFORMW %CALLNAME%은(는) 도망치고픈 마음과 쾌락 사이에서 허리를 들썩이고 있다
				ENDIF
				CFLAG:409 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;503,G스팟자극
;-------------------------------------------------
	CASE 503
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:410 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:410 < 4 || FLAG:7 == 2)
				;Gスポ읏トが効いていない地の文の場合
				IF (PREVCOM == 503 && EXP:0 <= 30) || (PALAM:6 < PALAMLV:3 && ABL:4 < 3)
					IF RAND:2 == 0
						PRINTFORMW 「부끄러운디도 기분 좋은 기라……」
					ELSE
						PRINTFORML 「안 돼, 이거 안 돼!」
					ENDIF
				ENDIF
				CFLAG:410 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:410 < 3 || FLAG:7 == 2)
				PRINTFORMW 「이렇코롬 기분 좋게 만들어뿌믄…… 져버리잖여……」
				CFLAG:410 = 3
			;それ以外
			ELSEIF CFLAG:410 < 2 || FLAG:7 == 2
				;地の文でGスポ읏トが効いていない場合
				IF (PREVCOM == 503 && EXP:0 <= 30) || (PALAM:6 < PALAMLV:3 && ABL:4 < 3)
					PRINTFORMW 「어쩐지…… 평소랑 다른겨?」
				ELSE
					PRINTFORML 「뭐여, 이거……」
					PRINTFORMW 「기분…… 기분 좋지 않응께…… 앗…%ハート()%」
				ENDIF
				CFLAG:410 = 2
			ELSE
				CFLAG:410 = 1
			ENDIF
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:410 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORML 「거기잇%ハート()%」
					PRINTFORMW 「거기 좋지만서도, 애태우지 말고, 어여 해줘잉%ハート()%」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;Gスポ읏トが効いちょらん地ん文ん場合
					IF (PREVCOM == 503 && EXP:0 <= 30) || (PALAM:6 < PALAMLV:3 && ABL:4 < 3)
						PRINTFORML 「뭘까나」
						PRINTFORMW 「조금 근질근질거리지만서도……」
					ELSE
						PRINTFORML 「맞아, 거기!」
						PRINTFORMW 「더 세게, 세게 해줘잉%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					;Gスポ읏トが効いちょらん地ん文ん場合
					IF (PREVCOM == 503 && EXP:0 <= 30) || (PALAM:6 < PALAMLV:3 && ABL:4 < 3)
						PRINTFORML 「%CSTR:이인칭%」
						PRINTFORMW 「거길 만져지믄, 뭔가 근질근질하당께」
					ELSE
						PRINTFORML 「%CSTR:이인칭%！」
						IF RAND:2 == 0
							PRINTFORMW 「기분 좋아, 엄~청 기분 좋은 기라!」
						ELSE
							PRINTFORMW 「기분 좋아서, %CSTR:일인칭%, 이상해져 버린당께!」
						ENDIF
					ENDIF
				ENDIF
				CFLAG:410 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:410 < 3 || FLAG:7 == 2)
				PRINTFORMW 「이렇코롬 기분 좋게 만들어뿌믄…… 져버리잖여……」
				CFLAG:410 = 3
			;それ以外
			ELSEIF CFLAG:410 < 2 || FLAG:7 == 2
				;地の文でGスポ읏トが効いていない場合
				IF (PREVCOM == 503 && EXP:0 <= 30) || (PALAM:6 < PALAMLV:3 && ABL:4 < 3)
					PRINTFORMW 「이런 거…… 기분 좋지… 않응께……」
				ELSE
					PRINTFORML 「안 돼, 이런 건」
					PRINTFORMW 「기분…… 기분 좋지 않응께……」
				ENDIF
				CFLAG:410 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;504,흐트러진모란
;-------------------------------------------------
	CASE 504
		;初めて
		IF CFLAG:411 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:411 < 4 || FLAG:7 == 2)
				;処女
				IF TALENT:0
					PRINTFORMW 「%CSTR:일인칭%의 처음을, 받아주는 기구마」
				;それ以外
				ELSE
					PRINTFORMW 「꼬추가 들어오는 게 훤히 다 보이다니 왠지 신선해♪」
				ENDIF
			ELSE
				;処女
				IF TALENT:0
					PRINTFORMW 「싫어, 보지에 꼬추 짓누르지 마시게!」
					PRINTFORMW 「%CSTR:일인칭%의 처음인디도……」
				;それ以外
				ELSE
					PRINTFORMW 「싫어, 이런 꼴 보여주지 마시게!」
				ENDIF
			ENDIF
			CALL TRAIN_MESSAGE
			PRINTFORMW 「참말로 들어가고 있어……」
			CFLAG:411 = 1
		;二回目以降
		ELSE
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:411 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORML 「싫어어어, %CSTR:일인칭%의 쪼그만 보지가아, %CSTR:이인칭%의 저렇게나 큰 걸, 맛있게도 삼키고 있잖여」
					PRINTFORMW 「보여주믄 앙대애애!%ハート()%」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:3 == 0
						PRINTFORMW 「%CSTR:일인칭% 보지에 꼬추가 들어가는 게 훤히 다 보여」
						PRINTFORMW 「평소보다 더 흥분되네잉♪」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「욕심쟁이 보지가 꼬추를 덥석 물고 있구마♪」
						PRINTFORMW 「더 깊은 곳까지 넣어도 좋아잉♪」
					ELSE
						PRINTFORML 「거울 건너편의 %CSTR:일인칭%도」
						PRINTFORMW 「보지로 섹스하면서 기분 좋아 보이네잉♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORML 「이런 식으로 보살펴지고」
					ELSE
						PRINTFORML 「이런 식으로 꼬추랑 이어져서」
					ENDIF
					PRINTFORMW 「%CSTR:이인칭%, %CSTR:일인칭%, 억수로 행복하당께%ハート()%」
				ENDIF
				CFLAG:411 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:411 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORMW 「%CSTR:일인칭% 안에 저런 꼬추가 들어가 있어……」
				ELSE
					PRINTFORMW 「이렇게나 부끄러운 꼴로 섹스하고 있는디도……」
				ENDIF
				CFLAG:411 = 3
			;それ以外
			ELSEIF CFLAG:411 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「보지 마, 보여주지 마!」
				ELSE
					PRINTFORMW 「이런 부끄러운 꼴은 안 된당께!」
				ENDIF
				CFLAG:411 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;505,기승유방자위
;-------------------------------------------------
;ヴァギナ派生
	CASE 505
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:412 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:412 < 4 || FLAG:7 == 2)
				PRINTFORMW 「앙, 앙, 앙! 이거, 너무 기분 좋당께에! %CSTR:이인칭%-!」
			ELSE
				PRINTFORML 「이런 짓을 당해선…… 응읏♪」
				PRINTFORMW %CALLNAME%은(는) 밑에서 찔러 올려지면서도 소리를 죽인 채 스스로를 위로하고 있다
			ENDIF
			CFLAG:412 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:412 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORML 「응, 앗! 하후, 으후! %CSTR:이인칭%, %CSTR:이인칭%! …조아, 대빵 조아앙%ハート()%」
					PRINTFORMW %CALLNAME%은(는) 밑에서 찔러 올려지면서, 홀린 듯 자신의 가슴을 애무하고 있다.
					PRINTFORML 「가슴도 가랑이도 둘 다 너무 조아앙! %CSTR:이인칭% 조아! 대빵 조아앙!」
					PRINTFORMW %CALLNAME%은(는) 유열에 녹아내린 표정을 %CALLNAME:MASTER%에게 보이며, 몇 번이고 %CALLNAME:MASTER%을(를) 거듭 불렀다.
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW %CALLNAME%은(는) 찔러 올려지며, 스스로 나서서 자신의 가슴을 애무하기 시작한다.
						PRINTFORMW 「히응! 히야앙! 아앗! 아아아! 가슴도 보지도 둘 다 너무 기분 조아!! 히앙읏! 히앙읏!!」
					ELSE
						PRINTFORML 「자위하면서 섹스하고 있는 %CSTR:이인칭% 보고」
						PRINTFORML 「정액 잔뜩 싸주시게♪」
					ENDIF
					PRINTFORMW 몸을 가득 채우는 쾌락에, %CALLNAME%은(는) 높은 교성을 거듭 내지르며 애무와 허리 흔들기를 한층 더 격렬하게 만들었다……
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORML 「보지 안으로 쿵쿵 찔리면서 자위하는 거 기분 좋당께!」
						PRINTFORML 「가도 돼?」
					ELSE
						PRINTFORML 「%CSTR:이인칭%, 보고 있어?」
						PRINTFORML 「벌써 가버릴 것 같당께」
					ENDIF
					PRINTFORML 「%CSTR:이인칭%, 가도 돼?」
					PRINTFORMW %CALLNAME%은(는) 절정할 허락을 구하면서 스스로를 흥분시키고 있다
				ENDIF
				CFLAG:412 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:412 < 3 || FLAG:7 == 2)
				PRINTFORMW 「보지도 가슴도 너무 기분 좋아서 녹아버릴 것 같아……♪」
				CFLAG:412 = 3
			;それ以外
			ELSEIF CFLAG:412 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORML 「기, 기분 좋은 건 가슴이니께 말여」
					PRINTFORMW 「보지를 쿵쿵 찔려서 그런 게 아니란 말이여」
				ELSE
					PRINTFORML 「이런 짓이나 시키고선……」
					PRINTFORML 「나, 나중에 용서 안 해줄 거니께!」
					PRINTFORMW 원망하는 말을 하면서도 %CALLNAME%의 손놀림은 멈출 기미가 보이지 않는다
				ENDIF
				CFLAG:412 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;506,挿入Ｇスポ責め
;-------------------------------------------------
	CASE 506
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:413 == 0
			PRINTFORMW 
			CFLAG:413 = 1
		;二回目以降
		ELSE
			IF 体格差() > 1
				PRINTFORMW 기둥 중간까지 %CALLNAME%의 좁은 질에서 뽑아내어, 꽉꽉 조여오는 것을 견뎌내면서 단단하게 도드라진 턱으로 G스팟을 긁어올린다.
			ENDIF
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:413 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORMW 브릿지처럼 활처럼 휘어지는 %CALLNAME%의 질 주름이 파도치듯 꿈틀거리며, 약점을 자극하는 육봉의 민감한 귀두부에 한층 더 달라붙어 조여온다.
						PRINTFORMW 「아아아! 안 돼읏! 좋아읏! 거기이! 머리가… 아앙! 앗! 안 되겠어, 으――… 으읏!!%ハート()%」
					ELSEIF EXP:0 < 80
						PRINTFORML 「응읏……」
						PRINTFORMW 「그렇게 보지 안쪽을 비벼대지믄……」
					;助手調教時
					ELSEIF ASSI > 0 && ASSIPLAY
						PRINTFORMW 「죄송해요, 죄송합니더어!」
						PRINTFORML 「%CSTR:이인칭% 거 아닌 자지가 보지 안에서 날뛰고 있는디도……」
						PRINTFORMW 「좋아앙! 보지 억수로 좋아앙!」
					ELSE
						PRINTFORML 「대애박이야앗!」
						PRINTFORMW 「보지 속에서 꼬추가 날뛰어가꼬……」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 브릿지처럼 활처럼 휘어지는 %CALLNAME%의 질 주름이 파도치듯 꿈틀거리며, 약점을 자극하는 육봉의 민감한 귀두부에 한층 더 달라붙어 조여온다.
						PRINTFORMW 「아아아! 안 돼읏! 좋아읏! 거기이! 머리가… 아앙! 앗! 안 되겠어, 으――… 으읏!!%ハート()%」
					ELSEIF EXP:0 < 80
						PRINTFORML 「응읏……」
						PRINTFORMW 「보지 안쪽을 문질러지는 거…… 버릇돼 버릴 것 같아♪」
					ELSE
						PRINTFORML 「대애박이야앗!」
						PRINTFORMW 「보짓속에서, 꼬추가, 날뛰고……」
						PRINTFORMW 「이런 거, 가버려! 몇 번이고 가버려어%ハート(2)%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 브릿지처럼 젖혀지는 %CALLNAME%의 질벽 주름이 파도치듯 꿈틀거리며, 약점을 자극하는 육봉에 달라붙어 온다.
					PRINTFORMW 「아아아! 안 돼읏! 좋아읏! 거기이! 머리가… 아앙! 앗! 안 되겠어, 으――… 으읏!!%ハート()%」
					CFLAG:413 = 4
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:413 < 3 || FLAG:7 == 2)
				PRINTFORMW 
				CFLAG:413 = 3
			;それ以外
			ELSEIF CFLAG:413 < 2 || FLAG:7 == 2
				PRINTFORML 「안 돼, 안 돼애! 거기, 안 돼애!」
				PRINTFORMW 싫어하면서도 쾌락에 브릿지처럼 젖혀지는 %CALLNAME%의 질벽 주름이 파도치듯 꿈틀거리며, 약점을 자극하는 육봉에 달라붙어 온다.
				CFLAG:413 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;507,삽입자궁구자극
;-------------------------------------------------
	CASE 507
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:414 == 0
			IF 体格差() > 1
				PRINTFORMW 장대 끝에 닿는 %CALLNAME%의 자궁구가 녹아내리는 것을 느끼며, 귀두로 비집어 열듯이 단단한 육봉을 더욱 비틀어 넣는다.
				PRINTFORML 「히…익, 히이이익!!! 기, 깊… 깊은… 깊은 곳까지…… 아, 안 대애애애……」
				PRINTFORMW %CALLNAME%이 괴로워하는 것에도 아랑곳하지 않고, 뜨겁게 끓어오르는 자궁에 귀두를 꽂아 넣어, 아이를 잉태하는 신성한 곳까지 정액투성이의 추악한 살덩이로 철저히 범한다.
				PRINTFORMW 거칠게 굴착하자, %CALLNAME%의 태내 전체가 쾌락 기관이 되어 질벽이 몸통을, 자궁구가 솟아오른 턱을, 자궁 자체가 귀두를 불이 붙은 듯 꿈틀거리며 조여 온다.
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:414 < 4 || FLAG:7 == 2)
					PRINTFORML 「대다내, %CSTR:이인칭% 거, 꼬추%ハート()% 가드윽 들어와써%ハート()%」
					PRINTFORMW 「이거, 조아하게 돼버려어%ハート()%」
				ELSE
					PRINTFORMW 「응아!? 기, 깊은 곳…… 소중한 곳에 꼬추 들어와 있어어어! 아, 싫, 이거 안 대, 안 대애애애!!!」
				ENDIF
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:414 < 4 || FLAG:7 == 2)
					PRINTFORML 「응아!? %CSTR:이인칭% 꼬추, 깊은 곳까지 닿고 있어어!」
					PRINTFORMW 「앗, 괘, 굉장해애%ハート()%」
				ELSE
					PRINTFORMW 「응아!? 깊은 곳… 소중한 곳에 꼬추 닿고 있어어! 아, 싫, 이거 안 대애!」
				ENDIF
			ENDIF
			CFLAG:414 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:414 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF 体格差() > 1
						PRINTFORMW 장대 끝에 닿는 %CALLNAME%의 자궁구가 녹아내리는 것을 느끼며, 귀두로 비집어 열듯이 단단한 육봉을 더욱 비틀어 넣는다.
						PRINTFORMW 「히…익, 히이이익!!! 또…오옥… 기, 깊… 깊은 곳까지이이……」
						PRINTFORMW %CALLNAME%이 괴로워하는 것에도 아랑곳하지 않고, 뜨겁게 끓어오르는 자궁에 귀두를 꽂아 넣어, 아이를 잉태하는 신성한 곳까지 정액투성이의 추악한 살덩이로 철저히 범한다.
						IF TALENT:170
							PRINTFORMW 「……%CSTR:이인칭%…… 좋아…… %CSTR:일인칭%, %CSTR:이인칭% 거 전부 넣어줘서… 기쁘고 기분 좋응께%ハート()%……」
							PRINTFORMW 「%CSTR:이인칭%의 \@TALENT:유아체형 || TALENT:소인체형 ? 어린 아내 로리 # 보\@지, 전부 귀여워해줘%ハート()%」
						ENDIF
						PRINTFORMW 거칠게 굴착을 시작하자, %CALLNAME%의 태내 전체가 쾌락 기관이 되어 질벽이 몸통을, 자궁구가 솟아오른 턱을, 자궁 자체가 귀두를 불이 붙은 듯 꿈틀거리며 조여 온다.
						K:1 = RAND:4
						IF K:1 == 0
							PRINTFORMW 「안 대애! 거기, 안 대는 거라구! %CSTR:일인칭%의 자궁, 때리면 안 대애애! 부서, 부서져버려엇!%ハート()%」
							PRINTFORMW %CALLNAME%은 자궁을 직접 유린당해 입에서 침을 흘리며 심하게 흐트러진다.
							PRINTFORMW 「안 대, 안 대애! 아앙앗! 자궁 섹스 당해서, 자궁 가버려어어어!!!」
						ELSEIF K:1 == 1
							PRINTFORMW 「히익! 앙! %CSTR:이인칭%, 진심으로 씨뿌리기 하고 있어! 씨뿌리기 섹스로, %CSTR:일인칭%의 자궁이 기뻐하고 있어어!」
							PRINTFORMW %CALLNAME%은 자신의 가장 신성한 부분을 직접 애무당해, 유열에 눈물을 계속 흘린다.
							PRINTFORMW 「힝앗! 힝앗! 더! %CSTR:이인칭%! 더어! %CSTR:일인칭%을 엉망진창으로 만들어줘!!!」
							PRINTFORMW 「히익! 힝앗! 히기이익! 아앗! ……읏! 아아아아!!!」
						;2010/12/26別人加筆
						ELSEIF K:1 == 2
							PRINTFORMW 「힝앗! 앗! 자궁 속 깊은 곳까지 울려버려엇! 아앙앗! 격렬해애%ハート()%」
							PRINTFORM 페니스
							;ふたなりor男以外
							SIF TALENT:PLAYER:139 == 0 && TALENT:PLAYER:140 == 0
								PRINTFORM 딜도 밴드
							PRINTFORM 의 끝부분이 자궁을 때리고, 솟아오른 턱이 자궁구를 긁어댈 때마다, %CALLNAME%은 부들부들 몸을 잘게 떨며 가장 깊은 곳을 유린당하는 감각에
							IF RAND:2 == 0
								PRINTFORM 넋을 잃은 표정을 짓고는
							ELSE
								PRINTFORM 입가에서 침을 흘리며
							ENDIF
							PRINTFORMW 교성을 질렀다.
							PRINTFORMW 「힝앗! 앗! 와버려어엇! 안 대애애엣!!」
						ELSE
							PRINTFORMW 「앙앗! 히야앙앗! 이거 좋아! 조아아!!%ハート()%」
							PRINTFORMW 「더! 더 자궁 범해줘어!%ハート()% 힝앗! 앗! 앗! 앙앗!」
							PRINTFORMW %CALLNAME%은 환희와 유열에 몸을 경련시키며, 자신의 가장 깊은 곳에 울리는 충격을 맛보고 있다.
							PRINTFORMW 「히야앙! 안 대, 이제 안 대애애애! 아아앗! 히아아아앙앗!」
						ENDIF
					ELSE
						K:1 = RAND:3
						IF K:1 == 0
							PRINTFORMW 「앗! 앙앗! %CSTR:일인칭%의 자궁 때리고 있어! 부서져버려엇!%ハート()%」
							PRINTFORMW %CALLNAME%은 자궁을 직접 자극당해 입에서 침을 흘리며 심하게 흐트러진다.
							PRINTFORMW 「안 대, 안 대애! 아앙앗! 가버려어어!!」
						ELSEIF K:1 == 1
							PRINTFORMW 「히익! 앙! 진심으로 씨뿌리기 하고 있어! 자궁이 기뻐하고 있어어!」
							PRINTFORMW %CALLNAME%은 자신의 가장 신성한 부분을 직접 자극당해, 유열에 눈물을 계속 흘린다.
							PRINTFORMW 「힝앗! 힝앗! 더! %CSTR:일인칭%! 더어! %CSTR:일인칭%을 엉망진창으로 만들어줘!」
							PRINTFORMW 「앙앗! 앙앗! 대단해애! 앗! ……읏! 아아아아!!」
						;2010/12/26別人加筆
						ELSEIF K:1 == 2
							PRINTFORMW 「힝앗! 앗! 자궁 속 깊은 곳까지 울려버려엇! 아앙앗! 격렬해애%ハート()%」
							PRINTFORM 페니스
							;ふたなりor男以外
							SIF TALENT:PLAYER:139 == 0 && TALENT:PLAYER:140 == 0
								PRINTFORM 딜도 밴드
							PRINTFORM 의 끝부분이 자궁구를 문지를 때마다, %CALLNAME%은 부들부들 몸을 잘게 떨며 가장 깊은 곳을 유린당하는 감각에
							IF RAND:2 == 0
								PRINTFORM 넋을 잃은 표정을 짓고는
							ELSE
								PRINTFORM 입가에서 침을 흘리며
							ENDIF
							PRINTFORMW 교성을 질렀다.
							PRINTFORMW 「힝앗! 앗! 와버려어엇! 안 대애애엣!!」
						ELSE
							PRINTFORMW PRINTFORMW 「앙앗! 히야앙앗! 이거 좋아! 조아아!!%ハート()%」
							PRINTFORMW 「더! 더 자궁 범해줘어!%ハート()% 힝앗! 앗! 앗! 앙앗!」
							PRINTFORMW %CSTR:일인칭%은 환희와 유열에 몸을 경련시키며, 자신의 가장 깊은 곳에 울리는 충격을 맛보고 있다.
							PRINTFORMW 「히야앙! 안 대, 이제 안 대애애애! 아아앗! 히아아아앙앗!」
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:3 == 0
						PRINTFORML 「힝앗! 힝앗! 히야아앙! 아기 방 범해지고 이써어!! 너무 기분 조타구우! 히아아!!」
					ELSEIF RAND:2 == 0
						PRINTFORML 「대단해엣♪ 꼬추 깊은 곳까지 닿고 있어엇♪」
					ELSE
						PRINTFORMW 「이거! 굉장해애!」
						PRINTFORML 「깊은 곳까지 섹스! 버릇이 돼버릴 것 같아♪」
					ENDIF
					PRINTFORMW 자궁구를 비집어 열고 내부를 직접 찔리는 감촉에, %CALLNAME%은 흰자위를 드러내며 한계를 초월한 쾌감에 몸을 덜덜 떨며 경련한다.
					PRINTFORMW 「히익! 히갸아아아!! %CSTR:일인칭%의 전부, 전부 범해지고 있어어어! 더어! 더 엉망진창으로 만들어줘어어!!」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORML 「아흣! 앙앗! 안 돼애! 자궁 기분 좋아아%ハート()%」
						PRINTFORML 「그대로오%ハート()% 그대로 아기 만들어주라아%ハート()%」
						PRINTFORMW 「이제 안 돼! 가앗, 가, 가 가버려어어어어어어!」
					ELSE
						PRINTFORML 「%CSTR:이인칭%, %CSTR:일인칭%의 자궁, 기분, 기분 조아?」
						PRINTFORML 「더, 더 푹푹 찔러서, 기분 조아지세요옷!」
						PRINTFORMW 자신보다 주인이 기분 좋아지는 것을 제일 먼저 생각하는 %CALLNAME%
						PRINTFORMW 그 말에 힘입어 %CALLNAME:MASTER%은 더욱 격렬하게 허리를 앞뒤로 흔들었다
					ENDIF
				ENDIF
				CFLAG:414 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:414 < 3 || FLAG:7 == 2)
				IF RAND:3 == 0
					PRINTFORML 「힝앗! 힝앗! 히야아앙!」
					PRINTFORML 「아기 방엔, 꼬추 안 들어간당께!」
				ELSEIF RAND:2 == 0
					PRINTFORML 「히극!」
					PRINTFORML 「그렇게 깊은 곳까지, 깊숙이 넣으면 안 돼엣!」
				ELSE
					PRINTFORML 「안 돼엣, 이제 그 이상은 안 돼엣!」
				ENDIF
				IF RAND:2 == 0
					PRINTFORMW 「안 돼, %CSTR:일인칭%, 이대로는 져버린당께!」
				ELSE
					PRINTFORMW 「이상해져, 이상해져버릴 거란 말이여!」
				ENDIF
				CFLAG:414 = 3
			;それ以外
			ELSEIF CFLAG:414 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORML 「힝앗! 힝앗! 히야아앙!」
					PRINTFORML 「아기 방엔, 꼬추 안 들어간당께!」
				ELSE
					PRINTFORML 「히극!」
					PRINTFORML 「그렇게 깊은 곳까지, 꼬추 안 돼엣!」
				ENDIF
				IF RAND:2 == 0
					PRINTFORMW 「안 들어간당께, 이제 그만해엣!」
				ELSE
					PRINTFORMW 「죽어버려, 죽어버린당께!」
				ENDIF
				CFLAG:414 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;508,６９파이즈리
;-------------------------------------------------
	CASE 508
		;初めて
		IF CFLAG:415 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:415 < 4 || FLAG:7 == 2)
				PRINTFORMW 「보지 핥으면서 가슴으로 끼운 꼬추 빨리고 싶어?」
				PRINTFORMW 「풀코스네에♪」
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:415 < 3 || FLAG:7 == 2)
				PRINTFORMW 「보지 핥으면서 가슴으로 끼운 꼬추 빨리고 싶어?」
				PRINTFORML 「변태당-」
				PRINTFORM 투덜거리면서도
			ELSE
				PRINTFORML 「보지 빨려가면서 가슴으로 끼운 꼬추 빨아줘?」
				PRINTFORMW 「그런 건 못 한당께」
				;ランダム奴隷キャラの場合
				IF CFLAG:이벤트가입 == 3 && RAND:2 == 0
					PRINTFORML 또 그 지하에 갇히고 싶냐고 말하자
					PRINTFORM 투덜거리면서도
				ELSE
					PRINTFORML 손을 치켜들자, 겁먹은 표정을 지으며
				ENDIF
			ENDIF
			CALL TRAIN_MESSAGE
			CFLAG:415 = 1
		;二回目以降
		ELSE
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:415 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:이인칭%, 조금만 숙여줘야지…… 영차, 영차, 으-, 드디어 닿았다아-」
					ELSE
						PRINTFORML 「혀랑 가슴이랑 보지, 온몸으로 기분 좋게 해줄게에♪」
						PRINTFORMW %CALLNAME%은 스스로 %CALLNAME:MASTER%의 가랑이에 얼굴을 파묻어왔다
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「누가 먼저 가나 시합이네에♪」
					ELSE
						PRINTFORML 「혀랑 가슴이랑 보지로 기분 좋게 해줄게에♪」
						PRINTFORMW %CALLNAME%은 스스로 %CALLNAME:MASTER%의 가랑이에 얼굴을 파묻어왔다
						PRINTFORMW 「힘들어? 그치만 꼬추는 기뻐 보이는데에?」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「안 돼, 그렇게 핥으면」
					PRINTFORMW 「기분 좋아서 꼬추한테 봉사 못 해줘엇♪」
				ENDIF
				CFLAG:415 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:415 < 3 || FLAG:7 == 2)
				PRINTFORML 「거긴 안 돼엣」
				PRINTFORMW 「손이 멈춰버린당께」
				CFLAG:415 = 3
			;それ以外
			ELSEIF CFLAG:415 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「지, 지지 않는당께…」
				ELSE
					PRINTFORML 「응, 읏…… 으응%ハート()%」
					PRINTFORMW %CALLNAME%은 교성을 지르지 않으려고 입을 다물고 봉사를 계속하고 있다
				ENDIF
				CFLAG:415 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;509,착유
;-------------------------------------------------
	CASE 509
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:416 == 0
			PRINTFORMW 
			CFLAG:416 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:416 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;主人公の子供を妊娠している
					IF TALENT:임신 && CFLAG:102 == 1
						IF RAND:2 == 0
