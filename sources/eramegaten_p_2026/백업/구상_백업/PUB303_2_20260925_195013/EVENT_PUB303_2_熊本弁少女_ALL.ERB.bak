	ELSEIF RAND:3 == 0 && 現HP割合(ARG) < 15
		BTL_KOJO_RESULTS:0 = 위험했구마
		BTL_KOJO_RESULTS:1 = 회복해 두자잉
	ENDIF
ENDIF

