			;二人で公衆便所
			ELSEIF RAND:2 == 0 && CFLAG:MASTER:노역플래그 == CFLAG:노역플래그 && CFLAG:MASTER:개별성적서비스 & 64 && CFLAG:개별성적서비스 & 64 && CFLAG:질내사정횟수
				PRINTFORMW 「오늘은 %CSTR:이인칭%하고 함께 화장실이구마♪」
				PRINTFORMW 「누가 더 많이 씨뿌리기 받는지 승부랑께♪」
				PRINTW ……………
				PRINTW ………
				PRINTW …
				PRINTFORMW 「하앙…%ハート()%」
				SIF CFLAG:질내사정횟수
					PRINTFORMW 「에헤-… 배 속이, 정액으로 가득 찼구마…%ハート()%」
				PRINTFORMW 「%CSTR:이인칭%은(는) 몇 번이나 싸달라고 했능가?」
				IF CFLAG:MASTER:질내사정횟수 == 0
					PRINTFORMW 「에엑, 한 번도 안 싸준 겨?」
					PRINTFORMW 「불쌍해라… 옳지!」
					PRINTFORMW 무엇을 떠올렸는지, %CALLNAME%은(는) 자신의 비순을 %CALLNAME:MASTER%의 그것에 겹치고 비벼대기 시작했다
					PRINTFORML 「읏, 하아… %CSTR:일인칭%한테 싸준 정액, %CSTR:이인칭%한테도 나눠어… 줄게%ハート()%」
					PRINTFORMW 저릿저릿 달콤한 감각이 %CALLNAME:MASTER%의 몸을 내달리고, 다시금 분비되기 시작한 애액과 %CALLNAME%의 질에서 흘러넘친 정액이 뒤섞여, 움직일 때마다 찔걱찔걱 음란한 소리를 낸다
					PRINTFORMW 「이걸로 %CSTR:일인칭%도 %CSTR:이인칭%도 똑같이 커플이여… 앙%ハート()%」
				ELSEIF CFLAG:MASTER:질내사정횟수 > CFLAG:질내사정횟수
					PRINTFORMW 「에엑, {CFLAG:MASTER:질내사정횟수}번이나 싸달라고 한 겨!?」
					PRINTFORMW 「으으-… %CSTR:일인칭%는 {CFLAG:질내사정횟수}번밖에 못 받았는디… 져버렸구마아…」
					PRINTFORMW 「다음엔, 절~대로 %CSTR:이인칭%보다 훨씬 많이 안에 싸달라고 할 틴게 말여!」
				ELSEIF CFLAG:MASTER:질내사정횟수 < CFLAG:질내사정횟수
					PRINTFORMW 「{CFLAG:MASTER:질내사정횟수}번 싸달라고 했능가?」
					PRINTFORMW 「에헴헤-… %CSTR:일인칭%의 승리구마♪」
					PRINTFORMW 「%CSTR:일인칭%는 {CFLAG:질내사정횟수}번이나 싸달라고 했당게-♪ 자 봐봐……%ハート()%」
					PRINTFORMW %CALLNAME%이(가) 질구를 손가락으로 벌리자 백탁액이 걸쭉하게 흘러넘쳤다
					PRINTFORMW 「\@ BASE:체력 >= 500 ? 내일도 # 다음에도 \@%CSTR:일인칭%가 더 많이 화장실 취급당할 거제%ハート()% 안 질 틴게♪」
				ELSE
					PRINTFORMW 「%CSTR:이인칭%도 {CFLAG:MASTER:질내사정횟수}번인 겨?」
					PRINTFORMW 「으으음… 똑같구마, 무승부랑께…」
					PRINTFORMW 「\@ BASE:체력 >= 500 ? 내일은 # 다음엔 \@%CSTR:일인칭%가 더 많이 화장실 취급당할 틴게 말여! 안 진당게♪」
				ENDIF
			ELSEIF RAND:12 == 0 && CFLAG:본방횟수 && CFLAG:애널횟수 && CFLAG:펠라횟수
				PRINTFORMW (보지도오, 엉덩이도오, 입안도오, 자지로 가득 차서…)
				PRINTFORMW （%CSTR:일인칭%、%CSTR:일인칭%…）
				PRINTFORMW 「%CSTR:일인칭%, 꼬추가 가득해서 행복해애%ハート()%」
			ELSEIF RAND:11 == 0 && CFLAG:본방횟수 && CFLAG:애널횟수
				PRINTFORMW 「아앙%ハート()% 보지도 엉덩이도 자지로 가득 차서어…」
				PRINTFORMW 「%CSTR:일인칭%, %CSTR:일인칭%, 자지 땜에 머리가 바보가 되어버릴 것 같아아%ハート()%」
			ELSEIF RAND:10 == 0 && CFLAG:질내사정횟수
				;死に分岐だ읏た部分を移動
				PRINTFORMW 「%CSTR:일인칭%」
				PRINTFORMW 「애인데도, 자지가 가득하지 않으믄 안 차는 야하고 못된 아이란 말이여%ハート()%」
				PRINTFORMW 「그랑게 말이여, %CSTR:일인칭% 보지에 가~아득 씨뿌리기해서 벌 내려줘잉%ハート()%」
			ELSEIF RAND:9 == 0 && CFLAG:질내사정횟수
				PRINTFORMW 「앗, 응… 갈 것 같어? 갈 것 같은 겨?」
				PRINTFORMW 「좋아아… %CSTR:일인칭% 안에, 잔뜩 정액 싸버려줘잉%ハート()%」
			ELSEIF RAND:8 == 0 && CFLAG:질내사정횟수
				;死に分岐だ읏た部分を移動
				PRINTFORMW 「앗, 하아%ハート()% 손님 꼬추, 엄청 크고 기분 좋당게요오%ハート()%」
				PRINTFORMW 「%CSTR:일인칭%도 힘내서 기분 좋게 해줄 틴게…… 안에, 잔뜩 정액 싸주소%ハート()%」
			ELSEIF RAND:7 == 0 && CFLAG:질내사정횟수
				PRINTFORMW 「앗, 응… 안에 싸고 싶은 겨? %CSTR:일인칭%의 \@ TALENT:유아체형 ? 어린 # \@보지에, 씨뿌리기하고 싶은 거제?」
				PRINTFORMW 「에헤헤, 좋아아… 당신 꼬추로, 원하는 만큼 %CSTR:일인칭%를 엄마로 만들어 보소%ハート()%」
			ELSEIF RAND:6 == 0 && CFLAG:질내사정횟수
				PRINTFORMW 「앗, 응… 안에 싸고 싶은 겨?」
				PRINTFORMW 「에헤헤, 좋아아… %CSTR:일인칭% 보지는 말여, \@ (TALENT:연모 || TALENT:친애)? 이제 그 사람만의 것이 아니라 # \@모두의 것이니께 말이여%ハート()%」
			ELSEIF RAND:5 == 0 && CFLAG:질내사정횟수
				PRINTFORMW 「앗, 응… 안에 싸고 싶은 겨?」
				PRINTFORMW 「에헤헤, 좋아아… %CSTR:일인칭% 보지는 말여, \@ (TALENT:연모 || TALENT:친애)? 이제 그 사람만의 것이 아니라 # \@모두의 공중화장실이니께 말이여%ハート()%」
			ELSEIF RAND:4 == 0 && CFLAG:질내사정횟수
				PRINTFORMW 「앙%ハート()%… 보지가 뜨거우니께 가득 차부렀데이-…」
				PRINTFORMW 「%CSTR:일인칭% 보지 화장실, 기분 좋았능가?」
				PRINTFORMW 「%CSTR:일인칭%도 손님 꼬추, 엄청 기분 좋았당께요%ハート()%」
			ELSEIF RAND:3 == 0 && CFLAG:애널횟수
				PRINTFORMW 「%CSTR:일인칭% 엉덩이는, 헐렁헐렁한 정액 변소란 말이여…」
				PRINTFORMW 「그랑게 말이여, 더 %CSTR:일인칭% 엉덩이를 자지로 푹푹 쑤셔 주소오%ハート()%…」
			ELSEIF RAND:2 == 0 && CFLAG:애널횟수
				PRINTFORMW 「손님 꼬추, 엄청 크고 기분 좋당게요오♪」
				PRINTFORMW 「커다란 꼬추는 특별히, 열심히 쥐어짜 줄 틴게 말이여…」
				PRINTFORMW 「가~아득 엉덩이 푹푹 쑤시고, 잔~뜩 쀼쀼 싸재껴 주소%ハート()%」
			ELSEIF RAND:1 == 0
				;死に分岐だ읏た部分を移動
				PRINTFORMW 「아하아앙……!!　정애액, 정액 맛있어……♪」
				PRINTFORMW 「낼름, 쫍…… 아하앙♪　에헤헤-, 정애액……」
			ENDIF
		;服従、隷属、隷属ＮＴＲ
		ELSEIF TALENT:복종 || TALENT:예속 || TALENT:ＮＴＲ == 3
			;主人公が便器デビュ─した場合。
			IF CFLAG:노역플래그 == CFLAG:MASTER:노역플래그 && EXP:MASTER:변기경험 == 0
				PRINTFORML 「%CSTR:이인칭%은(는) 변기가 된 거, 처음인 거제?」
				PRINTFORML 「괜찮당게, 기다리기만 해도 남정네들이 와주니께」
				PRINTFORML 「나머진 쓰임 받을 뿐」
				PRINTFORMW 「간단하제♪」
			ELSEIF RAND:6 == 0 && CFLAG:MASTER:노역플래그 == CFLAG:노역플래그 && CFLAG:질내사정횟수
				PRINTFORMW 「화장실 취급당하는 %CSTR:이인칭% 눈앞에서 씨뿌리기당해 버린다니…」
				PRINTFORMW 「%CSTR:일인칭%, 부끄러워가꼬 대단히 행복해애♪」
			ELSEIF RAND:5 == 0 && CFLAG:MASTER:노역플래그 == CFLAG:노역플래그 && CFLAG:질내사정횟수
				PRINTFORMW 「에헤, 함께…… %CSTR:이인칭%하고 함께로구마…」
				PRINTFORMW 「%CSTR:이인칭%하고 함께 씨뿌리기당해 버려서, %CSTR:일인칭%, 대단히 행복하당께-♪」
			ELSEIF RAND:4 == 0 && CFLAG:MASTER:노역플래그 == CFLAG:노역플래그
				PRINTFORMW 「%CSTR:이인칭%하고 함께, 바로 옆에서 화장실 취급당해 버리고 있어……」
				PRINTFORMW 「%CSTR:일인칭%, 아앙%ハート()% 왠지, 대단히 기분 좋당게요오♪」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「여러분, 화장실인 %CSTR:일인칭%한테, 가~아득 정액을 줘잉…♪」
			ELSEIF RAND:2 == 1
				PRINTFORMW 「하아, 여러분, %CSTR:일인칭%는 여러분의 화장실이랑께요…」
				PRINTFORMW 「원하시는 만큼, 아앙, 이용해, 주소오……」
			ELSE
				PRINTFORMW 「후릅, 여러분…… 츄릅, 사정해선…… %CSTR:일인칭% 얼굴에…… 하아, 뿌려 주소오……」
				PRINTFORMW 「츄루룹……!!　얼굴에, 쫍…… 주인님의…… 정액…… 뒤집어쓰고 싶구마요……!」
			ENDIF
		;陥落していない相手をぶちこんだ
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「아, 안 돼… 안 된당게!」
			ELSEIF RAND:1 == 0
				PRINTFORMW 「그만해… 그만둬줘잉…」
			ENDIF
			IF RAND:3 == 0 && CFLAG:질내사정횟수
				PRINTFORMW 「안에는, 안에는 싸지 마러어!」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「%CSTR:일인칭%, 화장실 따위가 아니여… 장난감 따위가 아니란 말이여…」
			ELSEIF RAND:1 == 0
				PRINTFORMW %CALLNAME%은(는) 고객들에게 변기로 이용당하며 흐느껴 울고 있다…
			ENDIF
		ENDIF
		CFLAG:281 = 1
	ENDIF

;-------------------------------------------------
;ビデオ保有時
;-------------------------------------------------
	CASE 23
		CALL EVENT_MESSAGE
		;陥落済み
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:282 < 2 || FLAG:7 == 2)
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				PRINTFORMW 「저기저기, 얼마 전 비디오…… 같이 안 볼래?」
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORMW 「다음엔 이 비디오 보면서 하장게%ハート()%」
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORMW 
			ENDIF
			CFLAG:282 = 2
		ELSEIF CFLAG:282 < 1 || FLAG:7 == 2
			PRINTFORMW 「저기, 그거 녹화해 두는 거 그만둘래?」
			CFLAG:282 = 1
		ENDIF

