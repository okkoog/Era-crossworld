			;ＮＴＲ相手の子の妊娠
			ELSEIF CFLAG:102 == CFLAG:함락캐릭터
				PRINTFORMW （그 사람의 아기가 생겨버렸어）
				IF RAND:3 == 0
					PRINTFORMW （%CSTR:이인칭%한테 안 들키게 해야 할 텐데……）
				ELSEIF RAND:2 == 0
					PRINTFORMW （어떻게 둘러댈까나）
				ELSE
					PRINTFORMW （%CSTR:이인칭%과의 아기가 아니니까 괜찮지만）
				ENDIF
			;それ以外
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「거짓말…… 아기 생겨버렸어……」
				ELSE
					PRINTFORMW 「어쩌지」
					PRINTFORMW 「이제 돌아가고 싶당께……」
				ENDIF
			ENDIF
		ENDIF
		CFLAG:271 = 1

;-------------------------------------------------
;出産時
;-------------------------------------------------
	CASE 12
		CALL EVENT_MESSAGE
		;崩壊してしま읏た場合
		IF TALENT:붕괴
			IF RAND:3 == 0
				PRINTFORMW 「베이비박스에 반품하러 가야제」
				PRINTFORMW 「청약 철회는 일주일까지니까 말야♪」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「오랜만에 화장실 다녀와서 배가 쏙 들어갔당께」
				PRINTFORMW 「이걸로 또 맛있는 거 먹을 수 있겠네♪」
			ELSE
				PRINTFORMW 「옆에서 울고 있는 거 뭐야?」
				PRINTFORMW 「시끄러우니까 어디 딴 데로 치워줘」
			ENDIF
		;陥落しとる相手ん子供ば出産
		ELSEIF CFLAG:102 == CFLAG:함락캐릭터
			PRINTFORML （그 사람이랑 조금 닮았을지도）
			IF RAND:2 == 0
				PRINTFORMW （다음에 만나게 해줘야지♪）
			ELSE
				PRINTFORMW （%CSTR:이인칭%, 눈치채버리려나아…）
			ENDIF
		;陥落済み
		ELSEIF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:272 < 2 || FLAG:7 == 2)
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				;父親が主人公の場合
				IF CFLAG:임신확정후의부친판정 == NO:MASTER
					IF RAND:2 == 0
						PRINTFORMW 「봐봐… %CSTR:일인칭%이랑 조금 닮지 않았어?」
					ELSE
						PRINTFORMW 「저기, 이 아이 이름 어떻게 할까?」
					ENDIF
				ELSE
					IF RAND:3 == 0
						PRINTFORMW 「진짜로 태어나버렸다…」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「이 아이 어쩌지, %CSTR:이인칭%…」
					ELSE
						PRINTFORMW 「%CSTR:이인칭%과의 아기가 아니라서 미안해…」
					ENDIF
				ENDIF
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				;父親が主人公以外の場合
				IF CFLAG:임신확정후의부친판정 == NO:MASTER
					PRINTFORMW 「아, 이 아이는 %CSTR:이인칭%과의 아이가 아니니까 말야」
					IF CFLAG:102 == CFLAG:함락캐릭터
						PRINTFORMW 「그야 %CSTR:이인칭%을 좋아하는 것도 뭣도 아닌걸」
					ELSE
						PRINTFORMW 「다음엔 둘이서 아기 만들까나%ハート()%」
					ENDIF
				ELSEIF RAND:2 == 0
					PRINTFORMW 「자, 얼른 커서 셋이서 섹스하자아%ハート()%」
				ELSE
					PRINTFORMW 「이걸로 또 섹스할 수 있겠네♪」
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORML 「자」
				PRINTFORMW 「낳았당께, %CSTR:이인칭%♪」
			ENDIF
			CFLAG:272 = 2
		ELSEIF CFLAG:272 < 1 || FLAG:7 == 2
			;父親が主人公の場合
			IF CFLAG:임신확정후의부친판정 == NO:MASTER && RAND:3 == 0
				PRINTFORMW 「%CSTR:일인칭%, %CSTR:이인칭%의 아이를 낳아버린 거네…」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「진짜로 태어나버렸다…」
			ELSE
				PRINTFORMW 「이 아이 어쩌지…」
			ENDIF
			CFLAG:272 = 1
		ENDIF

;-------------------------------------------------
;育児室
;-------------------------------------------------
	CASE 13
		CALL EVENT_MESSAGE
		;出産前
		IF TALENT:153
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:273 < 2 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「에헤헤… 아-빠♪ 불러본 것뿐이야. 에헤헤, %CSTR:일인칭% 행복하당께…%ハート()%」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「이거 끝나면 또 섹스하자아♪」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「아, %CSTR:이인칭%. 미안해, 봉사 못 해줘서…」
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭%을 걱정해주는 거야? 고마워, %CSTR:이인칭%%ハート()%」
						PRINTFORMW 「다정한 주인님을 둬서 %CSTR:일인칭%은 행복하당께. 얼른 아기한테도 똑같은 행복을 나눠주고 싶구먼」
					ELSE
						PRINTFORMW 「아기 태어나면 둘이서 제대로 %CSTR:이인칭%한테 봉사할게%ハート()%」
					ENDIF
				ENDIF
				CFLAG:273 = 2
			ELSEIF CFLAG:273 < 1 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:273 = 1
			ENDIF
		;出産後
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:273 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「아, 오는 거 늦잖아 %CSTR:이인칭%! 아기도 외로워했다구-」
					PRINTFORMW 「…우후후, 저기 %CSTR:이인칭%. %CSTR:일인칭%은 %CSTR:이인칭%을 만나서 다행이야. 억수로 행복해♪」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「아, %CSTR:이인칭%, 아기 보러 온 거야? %CSTR:일인칭%의 아기니까 역시 귀엽네♪」
					PRINTFORMW 「아기가 다 자랄 때까지 셋이서 섹스하는 건 조금만 기다려줘」
					PRINTFORMW 「그치만 그전에 아기 옆에서 한 명 더 만들어버릴까나%ハート()% 우후후, 분명 억수로 흥분될 거여」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「자아 아기야, 우리 주인님이란다-」
					PRINTFORMW 「아무래도 아직 조교하기엔 이르니까 지금 미리 첫 키스를 빼앗아둬%ハート()%」
					PRINTFORMW 「앞으로 선배로서 여러 가지 가르쳐줄 테니까, 엄마랑 같이 행복한 노예가 되자꾸나-♪」
				ENDIF
				CFLAG:273 = 4
			ELSEIF CFLAG:273 < 3 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:273 = 3
			ENDIF
		ENDIF

;-------------------------------------------------
;親離れ時
;-------------------------------------------------
	CASE 14
		CALL EVENT_MESSAGE
		;陥落済み
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:274 < 2 || FLAG:7 == 2)
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				PRINTFORML 「힘내서 멋진 사람 찾아보라구」
				PRINTFORMW 「괜찮아, 엄마도 찾았으니까 말야%ハート()%」
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORMW 「힘내서 좋은 사람 찾아보라구」
				IF RAND:2 == 0
					PRINTFORMW 「그 사람이 별로면 다른 사람이랑 섹스해도 괜찮은디」
				ELSE
					PRINTFORMW 「많이 있으면 한꺼번에 섹스해도 괜찮은디」
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORMW 「%CSTR:일인칭%처럼 멋진 주인님을 찾으라구%ハート()%」
			ENDIF
			CFLAG:274 = 2
		ELSEIF CFLAG:274 < 1 || FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORMW 「%CSTR:일인칭%처럼 되면 안 된다…」
			ELSE
				PRINTFORMW 「이런 꼴이 되지 말아줘…」
			ENDIF
			CFLAG:274 = 1
		ENDIF

;**************
;*　労役関係　*
;**************
;-------------------------------------------------
;定食屋台時
;-------------------------------------------------
	CASE 15
		CALL EVENT_MESSAGE
		;初めて
		IF CFLAG:275 == 0
			PRINTFORML 「에~, 이왕이면 귀여운 교복 입고 일하고 싶었는디」
			PRINTFORMW %CALLNAME%은(는) 조금 불만스러운 듯하다
			CFLAG:275 = 1
		;それ以外
		ELSEIF CFLAG:275 < 1 || FLAG:7 == 2
			IF RAND:4 == 0 && ABL:요리기능 > 3
				PRINTFORMW 「본고장의 요리, 내줄게」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「어라? 제복 바뀌었어?」
			ELSEIF RAND:2 == 0
				PRINTFORML 「또 잘 부탁해♪」
				PRINTFORMW %CALLNAME%은 고참 스태프에게 말을 걸고 있다
			ELSE
				PRINTFORMW 「새 메뉴 늘었어?」
			ENDIF
			CFLAG:275 = 1
		ENDIF

;-------------------------------------------------
;定食屋台で実際に働いたとき
;-------------------------------------------------
	CASE 97
		CALL EVENT_MESSAGE
		PRINTFORML 
		;ＮＴＲれてお持ち帰りされた場合
		IF TFLAG:86 >= 1200
			;愛ＮＴＲ
			IF TALENT:ＮＴＲ == 1
				IF RAND:3 == 0
					PRINTFORML 「그 사람 이외의 정액 들어가 있어……」
					PRINTFORML %CALLNAME%은 자신의 배를 눌러 정액을 밀어내려 하고 있다
				ELSEIF RAND:2 == 0
					PRINTFORML 「기껏 그 사람을 만났는데……」
				ELSE
					PRINTFORML 「%CALLNAME%한테 조교당하는 거랑 다를 바 없잖아……」
				ENDIF
			;淫ＮＴＲ
			ELSEIF TALENT:ＮＴＲ == 2
				IF TALENT:아내 && RAND:3 == 0
					PRINTFORML 「반지는 돌려줬네」
					PRINTFORML 「굳이 안 그래도 되는데……」
				ELSEIF RAND:2 == 0
					PRINTFORML 「우와… 듬뿍 들어가 있어……」
					PRINTFORML %CALLNAME%은 자신의 배를 눌러 주입된 정액의 양을 확인하고 있다
				ELSE
					PRINTFORML 「돈은 못 받았지만… 뭐, 괜찮나……」
				ENDIF
			;隷ＮＴＲ
			ELSEIF TALENT:ＮＴＲ == 3
				IF TALENT:친애 && TALENT:아내 == 0 && RAND:4 == 0
					PRINTFORML 「연애보다 이쪽이 더 좋기도 하고……」
				ELSEIF RAND:3 == 0
					PRINTFORML 「제대로 장난감이 돼버렸당께……」
					PRINTFORML  %CALLNAME%은 %NTRNAME(CFLAG:함락캐릭터)%의 얼굴을 떠올리고 있다
				ELSEIF RAND:2 == 0
					PRINTFORML 「다음엔 제대로 조교해줬으면 좋겠구먼……」
					PRINTFORML  %CALLNAME%은 %NTRNAME(CFLAG:함락캐릭터)%의 얼굴을 떠올리고 있다
				ELSE
					PRINTFORML 「열심히 했응께 포상 받을 수 있겠제……」
				ENDIF
				PRINTFORML %CALLNAME%은 %NTRNAME(CFLAG:함락캐릭터)%와 이야기를 나누고 있다
			ELSE
				;恋慕系キャラが通る可能性
				IF RAND:6 == 0 && (TALENT:연모 || TALENT:친애)
					IF RAND:2 == 0
						PRINTFORML 「%CALLNAME:MASTER% 말고 다른 정액이 들어가버렸어…」
						PRINTFORML 「미안해요… %CSTR:이인칭%……」
						PRINTFORML %CALLNAME%은 자신의 배를 눌러 정액을 밀어내려고 하고 있다
					ELSE
						PRINTFORML 「이런 꼴 보이면 미움받아버릴 텐데」
						PRINTFORML 「얼른 돌아가야제……」
						PRINTFORML %CALLNAME%은 %CALLNAME:MASTER%의 얼굴을 떠올리며 비틀거리며 일어섰다
					ENDIF
				;妊娠キャラが通る可能性
				ELSEIF RAND:5 == 0 && TALENT:임신
					;父親が主人公で恋慕系
					IF (TALENT:연모 || TALENT:친애) && CFLAG:임신확정후의부친판정 == NO:MASTER
						IF RAND:2 == 0
							PRINTFORML 「다들한테 심한 짓을 당했지만…」
							PRINTFORML 「뱃속 아기는 무사하네……」
						ELSE
							PRINTFORML 「엄마가 약해서 미안해……」
						ENDIF
						PRINTFORML %CALLNAME%은 걱정스러운 듯 자신의 배를 쓰다듬고 있다
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						IF RAND:2 == 0
							PRINTFORML 「이 아이한테 영재교육을 해버렸네……」
						ELSE
							PRINTFORML 「임산부라고 다들 흥분해서 격렬하게 굴었응께」
							PRINTFORML 「또, 하자꾸나……」
						ENDIF
						PRINTFORML %CALLNAME%은 자신의 배를 다정하게 쓰다듬고 있다
					ELSE
						IF RAND:2 == 0
							PRINTFORML 「아기가 있는데도 너무하당께……」
						ELSE
							PRINTFORML 「임산부라고… 다들 흥분해 있었어……」
						ENDIF
						PRINTFORML %CALLNAME%은 걱정스러운 듯 자신의 배를 쓰다듬고 있다
					ENDIF
				;NOT妊娠キャラが通る可能性
				ELSEIF RAND:4 == 0 && TALENT:임신 == 0
					IF RAND:3 == 0
						PRINTFORML 「저런 사람들 아이 같은 건 싫어……」
					ELSEIF RAND:2 == 0
						PRINTFORML 「아직 어린애인데… 아기 생겨버리면……」
					ELSE
						PRINTFORML 「이런 짓 당하면 임신해버릴 텐데……」
						PRINTFORML %CALLNAME%은 가랑이에서 흘러넘치는 정액을 보며 망연자실해하고 있다
					ENDIF
				ELSEIF RAND:3 == 0
					PRINTFORML 「이런 짓을 당하다니…」
					;ランダム奴隷キャラの場合
					IF CFLAG:이벤트가입 == 3
						PRINTFORML 「얼른 집에 돌아가고 싶당께……」
					ELSE
						PRINTFORML 「어째서… 왜……」
					ENDIF
				ELSEIF RAND:2 == 0
					PRINTFORML 「이런 테이프 버려야제……」
					PRINTFORML 몸을 움직이려 하던 %CALLNAME%이었지만, 도중에 힘이 다해 잠들어버렸다
				ELSE
					PRINTFORML 「맞기도 하고 두들겨 맞기도 해서」
					PRINTFORML 「온몸이 아프당께……」
				ENDIF
			ENDIF
		;ＮＴＲの場合
		ELSEIF TFLAG:86 >= 1000
			;愛ＮＴＲ
			IF TALENT:ＮＴＲ == 1
				IF RAND:3 == 0
					PRINTFORML 「오늘은 늦는다고 말해뒀응께 괜찮당께♪」
				ELSEIF RAND:2 == 0
					PRINTFORML 「와줬구나♪」
				ELSE
					PRINTFORML 「스페셜 서비스, 해버릴 거야%ハート()%」
				ENDIF
				PRINTFORML %CALLNAME%은 %NTRNAME(CFLAG:함락캐릭터)%와 기쁜 듯 이야기하고 있다
			;淫ＮＴＲ
			ELSEIF TALENT:ＮＴＲ == 2
				IF TALENT:아내 && RAND:3 == 0
					PRINTFORML 「어린 아내랑 놀다 가지 않을래?」
					PRINTFORM 빛나는 반지를 보여주면서
				ELSEIF RAND:2 == 0
					PRINTFORML 「시크릿 메뉴도 있는디, 어뗘?」
				ELSE
					PRINTFORML 「가게 끝나면, 놀·자♪」
				ENDIF
				PRINTFORML %CALLNAME%은 소곤소곤 손님과 이야기를 나누고 있다
			;隷ＮＴＲ
			ELSEIF TALENT:ＮＴＲ == 3
				IF TALENT:친애 && TALENT:아내 == 0 && RAND:4 == 0
					PRINTFORML 「신부 수업 중이라고 %CALLNAME:MASTER%한테는 말해뒀당께」
					PRINTFORML 「그러니까 마음껏 놀다가라구♪」
				ELSEIF RAND:3 == 0
					PRINTFORML 「응, 알겠어」
					PRINTFORML 「뭐든지 할 거랑께」
				ELSEIF RAND:2 == 0
					PRINTFORML 「말한 대로, 안 입었당께」
				ELSE
					PRINTFORML 「말한 대로, 달고 있당께」
					PRINTFORML 「아앙♪」
					PRINTFORML 「안 들키게 일 열심히 할게♪」
				ENDIF
				PRINTFORML %CALLNAME%은 %NTRNAME(CFLAG:함락캐릭터)%와 이야기를 나누고 있다
			ELSE
