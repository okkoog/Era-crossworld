;-------------------------------------------------
;妊娠発覚時
;-------------------------------------------------
	CASE 11
		SIF CFLAG:271 >= 1 && FLAG:7 != 2
			RETURN 0
		CALL EVENT_MESSAGE
		;妊娠対象をTARGETに格納し、父親は奴隷はV、助手はWとする
		;崩壊してしま읏た場合
		IF TALENT:붕괴
			IF RAND:2 == 0
				PRINTFORMW 「에」
				PRINTFORMW 「아기, 생겼어?」
				PRINTFORMW 「…………」
				PRINTFORML 「싫어」
				PRINTFORMW 「싫어, 싫어, 싫당께… 싫당께, 이런 거, 싫어……」
				PRINTFORML 「흑… 엄마아…… 살려줘요오, %CSTR:일인칭%, 이런 거 싫당께요, 엄마아……」
				PRINTFORMW 임신 사실을 안 %CALLNAME%은 그저 하염없이 흐느껴 울기만 했다.
			ELSE
				PRINTFORMW 「…………」
				PRINTFORMW 「……우체통」
				PRINTFORML 「베이비박스 쓰면 반품할 수 있겠네」
				PRINTFORMW 「저기-, %CSTR:이인칭%, 베이비박스라는 거 역전 우체통이면 돼?」
			ENDIF
		;恋慕か親愛持ち
		ELSEIF (TALENT:연모 || TALENT:친애)
			;父親が主人公の場合
			IF CFLAG:102 == 1
				;結婚していなくて出産経験 0の場合
				IF TALENT:아내 == 0 && EXP:출산경험 == 0
					;反発刻印LV3からの妊娠
					IF RAND:3 == 0 && CFLAG:801 == 1
						PRINTFORML 「결혼도 안 했는데 아기 생겨버렸네」
						PRINTFORMW 「이래도 결혼 안 해준다면…」
						PRINTFORML 「%CSTR:일인칭%, 화낼 거랑께」
						PRINTFORMW %CALLNAME%의 눈은 웃고 있지 않다…
					ELSEIF RAND:2 == 0
						PRINTFORML 「이게 혹시」
						PRINTFORMW 「『속도위반 결혼』이란 거야?」
					ELSE
						PRINTFORMW 「결혼보다 먼저 임신해버렸네」
						PRINTFORMW 「『패밀리 웨딩』 해버릴까?」
					ENDIF
				;中田氏が立읏ている場合
				ELSEIF CFLAG:802 == DAY -1
					IF RAND:2 == 0
						PRINTFORML 「거봐~, 아기 생겨버렸잖여」
						PRINTFORMW 「%CSTR:일인칭%이 없어도 힘낼 수 있어?」
					ELSE
						PRINTFORML 「제대로 『가족 계획』을 안 세우니까」
						PRINTFORMW 「나중에 고생해도 난 몰라?」
					ENDIF
