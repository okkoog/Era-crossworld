;-------------------------------------------------
;売却時
;-------------------------------------------------
	CASE 18
		CALL EVENT_MESSAGE
		;反発刻印Lv3
		IF MARK:3 == 3
			;両親が名無しキャラ、もしくは"設定無し"
			IF RAND:2 == 0 && CFLAG:1560 <= 0 && CFLAG:1563 <= 0
				PRINTFORMW 「아빠랑 엄마 만날 수 있는 겨!?」
				PRINTFORML 『지금까지 모질게 대한 만큼, 이제부터는 부모님과 지낼 수 있다』고 전하자,
				PRINTFORMW 	%CALLNAME%은(는) 일순 기쁜 듯한 표정을 지었으나 무언가를 눈치채고 이쪽을 노려보았다
				PRINTFORML 「어차피 새빨간 거짓말이제……」
				PRINTFORMW 믿지 못하는 기색의 %CALLNAME%은(는) 조직의 사자에게 끌려가고 말았다…
				PRINTFORML ………
				PRINTFORML ……
				PRINTFORMW …
				IF RAND:2 == 0
					PRINTFORML 얼마 전, 『%CALLNAME%이(가) 뒷세계에 매물로 팔려나간다』는 소문을 흘렸다.
					PRINTFORMW 그것을 들은 %CALLNAME%의 부모는 서둘러 돈을 마련하고자 도박에 나섰으나…… 도박은 실패로 끝났다
					PRINTFORMW 두 사람은 육체를 조교당하고, 개조당하고, 조교당하여…
					PRINTFORMW 그리고 %CALLNAME%은(는) 재회했다
					PRINTFORML 
					PRINTFORML 「엄마……」
					PRINTFORMW 어머니의 하반신 구멍은 전부 페트병이 넉넉히 들어갈 정도로 활짝 벌려져 있었고, 사타구니에는 팔뚝만 한 굵기의 페니스가 돋아나 있었다
					PRINTFORML 
					PRINTFORML 「아빠……」
					PRINTFORMW 아버지의 가슴에는 본래 없을 터인 수박만 한 크기의 유방이, 네 개나 달려 있었다
					PRINTFORMW 그리고 두 사람 다 임신해 있었다
					PRINTFORML 
					PRINTFORMW 『엄마 배 속에는 말여, 주인님과의 아기가 있고 말이제』
					PRINTFORMW 『아빠 배 속에는 말여, 엄마와의 아기가 있는 거여%ハート()%』
					PRINTFORML 「어째서…」
					PRINTFORMW 맥없이 그 자리에 쓰러지는 %CALLNAME%
					PRINTFORMW 『자, %CALLNAME%도 주인님께 인사 올려야제%ハート()%』
				ELSE
					PRINTFORMW 새 주인은 %CALLNAME%을(를) 데리고 그 방의 문을 열었다
					PRINTFORML 방 안은 칠흑 같았지만, 밖에서 빛이 비쳐 들자 방 안에 슬라임 한 마리가 있는 것이 보였다
					PRINTFORML 
					PRINTFORML 『네 앞에서 아빠랑 엄마로 악마합체를 해봤는데 사고가 나버렸지 뭐야, 하하하』
					PRINTFORMW %CALLNAME%의 뒤에 서 있는 새 주인이 설명한다
					PRINTFORMW 『둘 다 지성은 사라졌지만, 본능만은 남아 있으니까』
					PRINTFORML 『자앗』
					PRINTFORMW 뒤에서 %CALLNAME%을(를) 밀쳐 넘어뜨리자, %CALLNAME%은(는) 슬라임 안으로 처박혀 들어갔다
					PRINTFORMW 몸 안에 들어온 이물질이 살아있는 생물임을 알아채자 모든 구멍으로 침입을 시도한다…
					PRINTFORML 
					PRINTFORML 『으~음, 감동적인 상봉이네』
					PRINTFORMW 『한동안 오붓하게 가족끼리 지내보도록 해♪』
					PRINTFORMW 『무엇이 태어날지도 궁금하고 말이지』
					PRINTFORML 
					PRINTFORML 『안 되겠다 싶으면 너도 악마합체시킬 거니까 힘내보라고♪』
					PRINTFORMW 문이 닫히자 방은 다시금 어둠에 휩싸였다……
				ENDIF
			ELSEIF RAND:2 == 0
				PRINTFORML 「이런 곳, 얼른 나가부러야제!」
				PRINTFORML 「메~롱, 이다!」
				PRINTFORMW %CALLNAME%은(는) 스스로 조직의 사자의 손을 잡아끌며 나가버렸다…
			ELSE
				PRINTFORML 『어찌 된 거냐, 이건 도대체』
				PRINTFORML 『어디 다른 조직이라도 적으로 돌린 건가?』
				PRINTFORMW 방 안에는 가구와 무구가 흩어져 있고, 총탄과 마법을 사용한 흔적까지 남아 있다
				PRINTFORMW 조직의 사자가 묻자, %CALLNAME:MASTER%은(는) 밧줄로 묶은 %CALLNAME%을(를) 내밀었다
				PRINTFORML 
				PRINTFORMW 『과연, 그렇군. 어지간한 말괄량이로구만』
				PRINTFORML 『그걸 감안하고 사는 상대니까 말이지…… 뭐, 힘내보라고』
				PRINTFORMW 조직의 사자는 %CALLNAME%의 머리를 툭툭 두드리더니 밧줄을 잡고 %CALLNAME%을(를) 데려갔다…
			ENDIF
		;陥落済み
		ELSEIF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
			;恋慕、親愛
			IF (TALENT:연모 || TALENT:친애)
				;妊娠している場合
				IF TALENT:임신
					PRINTFORML 「어?」
					PRINTFORMW 「어째서 %CSTR:일인칭%가 팔려나가버리는 거여?」
					;父親が主人公の場合。まさに悪魔の所業
					IF CFLAG:임신확정후의부친판정 == NO:MASTER
						IF RAND:2 == 0
							PRINTFORMW 「아기가 방해되응게?」
							PRINTFORML 「그라믄 이런 거 내삐려버릴 팅게!」
							PRINTFORMW %CALLNAME%은(는) 자신의 배를 두드리고 있다
						ELSE
							PRINTFORMW 「%CSTR:일인칭% 배 속에는, 두 사람의 아기가 있잖여?」
						ENDIF
						PRINTFORML 「그랑게, 그랑게……」
					;ＮＴＲ対象の子供を妊娠している場合
				 	ELSEIF TALENT:ＮＴＲ && CFLAG:임신확정후의부친판정 == NO:MASTER
						PRINTFORML 「그런 겨……」
						PRINTFORML 「하지만서도, 이건 %CSTR:이인칭%이(가) 사랑해주지 않았기 때문이랑께…」
						PRINTFORMW %CALLNAME%은(는) 자신의 배를 두드리고 있다
						PRINTFORML 「%CSTR:이인칭%의 『사랑한데이』라는 말보다」
						PRINTFORML 「모르는 사람 정액이, %CSTR:일인칭% 자궁에 더 울려 퍼졌응게…」
					ELSE
						PRINTFORMW 「다른 사람 아이를 임신해서 그런 겨?」
						PRINTFORML 「하지만서도, 이건……」
					ENDIF
					PRINTFORMW  %CALLNAME%은(는) 조직의 사자에게 팔을 붙잡힌 채 끌려갔다……
				;反発刻印LV3からの売却
				ELSEIF CFLAG:801 == 1 && RAND:2 == 0
					PRINTFORML 「어,　어째서?」
					PRINTFORML 「전에 심한 말 하기는 했지만서도, 그건 진심이 아니었응게…」
					PRINTFORMW %CALLNAME:MASTER%은(는) %CALLNAME%을(를) 쫓아내듯 손을 내저었다
					PRINTFORML 「그랑게, 그랑게 기다려줘……」
					PRINTFORMW  %CALLNAME%은(는) 조직원에게 팔을 붙잡힌 채 끌려갔다……
				;妻
				ELSEIF TALENT:아내 && RAND:2 == 0
					PRINTFORMW 「어?　어째서?」
					PRINTFORML 「돈이 없능가?　그라믄…… 이걸 팔아서 돈으로 만들어!」
					PRINTFORMW %CALLNAME%은(는) 일순 망설였으나 결혼반지를 빼더니 %CALLNAME:MASTER%에게 건넸다
					PRINTFORML  
					PRINTFORML  「반지는 없어도 두 사람은 부부인게 말여……」
					PRINTFORMW  %CALLNAME:MASTER%은(는) 받아 든 반지를 조직의 사자에게 건네고는 그 자리를 떴다
					PRINTFORML  「어째서?　가지 마러, %CSTR:이인칭%!」
					PRINTFORML  「%CSTR:일인칭%, 뭐 나쁜 짓이라도 했능가?　그라믄 사과할 틴게」
					PRINTFORML  「다음부터 착한 아이로 있을 틴게!　기다려, 잡아당기지 마러!」
					PRINTFORML  「%CSTR:이인칭%~　거짓말이제~~!」
					PRINTFORMW  %CALLNAME%은(는) 조직의 사자에게 팔을 붙잡힌 채 끌려갔다……
					PRINTFORML  
					SETCOLOR 255, 0, 0
					PRINTFORMW 훗날, 반지 값으로 10마카가 도착했습니다
					MONEY:1 += 10
					RESETCOLOR
					PRINTFORML 
				;ＬＶが20以上離れている場合
				ELSEIF BASE:MASTER:LV > BASE:LV +20
					IF RAND:2 == 0
						PRINTFORML 「%CSTR:일인칭%가 전투에서 암것도 못하는 짐덩이라 팔려나가버리는 거여?」
						PRINTFORML 　
						PRINTFORMW 「%CSTR:이인칭%을(를) 좋아하응게 뭐든지 다 하겠지만서도……」
						PRINTFORML 「헤어지는 것만은 싫어!」
						PRINTFORML 「다른 일이라면 뭐든지 다 할 틴게!」
					ELSE
						PRINTFORML 「여자친구라도, 쓸모없으면 팔려나가버리는 구나……」
						PRINTFORML 　
						PRINTFORML 「부탁여, 강해질 틴게!」
						PRINTFORML 「『삐-』하고 마법 외워서 『콰콰쾅-!!』하고 쓰러뜨릴 틴게!」
						PRINTFORML 「%CSTR:이인칭%이(가) 말하믄 어떤 악마라도 해치워 보여줄 틴게!」
						PRINTFORML 「자, 봐봐!　봐보라꼬!」
					ENDIF
					PRINTFORMW 히스테릭을 부리며 날뛰기 시작했기에 서둘러 조직원에게 데려가도록 했다…
				ELSE
					PRINTFORMW 「거짓말…」
					;妻
					IF TALENT:아내
						IF RAND:3 == 0
							PRINTFORML 「그치만 %CSTR:이인칭%은(는) %CSTR:일인칭%을(를) 구해줬고」
							PRINTFORML 「결혼도 했잖여?」
						ELSEIF RAND:2 == 0
							PRINTFORML 「그치만 %CSTR:이인칭%, %CSTR:일인칭%한티, 『결혼하자』고 말해줬잖여?」
						ELSE
							PRINTFORML 「그치만 %CSTR:일인칭%, %CSTR:이인칭%의 색시잖여?」
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORML 「그치만 %CSTR:이인칭%, %CSTR:일인칭%을(를), 『좋아해』라고 말해줬잖여?」
						ELSE
							PRINTFORML 「그치만 우리들, 연인 사이잖여?」
						ENDIF
					ENDIF
					PRINTFORMW 「그런디, 어째서…」
					PRINTFORML 
					IF RAND:2 == 0 && TALENT:처녀
						PRINTFORML 「그, 그럼… 적어도 %CSTR:일인칭%의 첫 상대가 되어줄 순 없는 겨?」
						PRINTFORMW 「%CALLNAME%과의 추억을 갖고 싶구마…」
						PRINTFORMW 간청하는 %CALLNAME%에게 『몸값이 떨어지니 그럴 수는 없다』며 매몰차게 거절하는 %CALLNAME:MASTER%
						PRINTFORML 「그런……」
						PRINTFORMW 망연자실해하는 %CALLNAME%을(를) 그대로 둔 채, %CALLNAME:MASTER%은(는) 다음 상대의 조교 계획을 세우기 시작했다……
					ELSEIF RAND:2 == 0
						PRINTFORML 「알았다!　몰래카메라인 거제…」
						PRINTFORMW %CALLNAME%은(는) 자신이 팔려나간다는 사실을 끝까지 인정하지 못한 채 조직의 사자에게 끌려갔다…
					ELSE
						PRINTFORML ………
						PRINTFORML ……
						PRINTFORML ……
						PRINTFORMW 「알았어」
						PRINTFORML 「%CSTR:이인칭%하고 떨어질 바에야」
						PRINTFORML 「%CSTR:이인칭%을(를) 죽이고 %CSTR:일인칭%도 죽으믄, 평생 함께 있을 수 있겠구마……」
						PRINTFORMW 섬뜩한 소리를 지껄이기에 서둘러 조직원에게 데려가도록 했다…
					ENDIF
				ENDIF
			;淫乱、娼婦
			ELSEIF (TALENT:음란 || TALENT:창부)
				;妊娠している場合
				IF TALENT:임신
					IF RAND:2 == 0
						PRINTFORMW 「배 속의 아기, 방해되었던 겨?」
					ELSE
						PRINTFORMW 「아기가 태어나버리믄 밥값이 두 배로 드응게?」
					ENDIF
					PRINTFORMW 「그라믄 어쩔 수 없구마」
				ELSEIF RAND:4 == 0 && TALENT:처녀
					PRINTFORML 「결국, %CSTR:일인칭%의 여그는 안 썼구마?」
					PRINTFORMW %CALLNAME%은(는) 자신의 가랑이를 가리켰다
					PRINTFORMW 「그쪽이 더 비싸게 팔린다고 여겼겠지만서도, 나중에 후회해봤자 모른당게♪」
				ELSEIF RAND:3 == 0
					PRINTFORML 「새로운 주인님?」
					PRINTFORMW %CALLNAME:MASTER%은(는) %CALLNAME%을(를) 매물로 내놓는다고 전했다
					PRINTFORML 
					PRINTFORMW 「응, 괜찮당게」
					IF CFLAG:이벤트가입 == 3 && RAND:2 == 0
						PRINTFORMW 「붙잡혀 있었을 때보다 심심하지도 않고, 기분도 좋으니께♪」
					ELSE
						PRINTFORMW 「다른 사람 꼬추에도 흥미 있었응게, %CSTR:일인칭%%ハート()%」
					ENDIF
				ELSEIF RAND:2 == 0
					PRINTFORML 「으~음, %CSTR:이인칭%하고는 찰떡궁합이라 생각했는디 말여」
					PRINTFORMW %CALLNAME%은(는) 아쉬운 표정을 짓고 있다
					PRINTFORMW 「새 주인님이 야외 플레이 같은 거 시키믄 놀러오소%ハート()%」
				ELSE
					PRINTFORML 「으~음, %CSTR:이인칭%하고는 궁합이 좋다고 생각했는디 말여」
					PRINTFORMW %CALLNAME%은(는) 아쉬운 표정을 짓고 있다
					PRINTFORMW 「이게 『성의 불일치』라는 건가?」
				ENDIF
			;服従、隷属
			ELSEIF (TALENT:복종 || TALENT:예속)
				IF RAND:3 == 0 && TALENT:처녀
					PRINTFORML 「마지막까지 여그는 조교 안 해줬구마」
					PRINTFORMW %CALLNAME%은(는) 자신의 가랑이를 가리켰다
					PRINTFORMW 「언제 %CSTR:이인칭%헌티 조교당할까 두근두근 기대했었는디 말여……」
				ELSEIF RAND:2 == 0
					PRINTFORML 「새로운 주인님?」
					PRINTFORMW %CALLNAME:MASTER%은(는) %CALLNAME%을(를) 매물로 내놓는다고 전했다
					PRINTFORML 
					PRINTFORMW 「응, 좋아」
					PRINTFORMW 「%CSTR:일인칭%, 노예로서 씩씩하게 힘낼게」
				ELSE
					PRINTFORML 「%CSTR:일인칭%, 팔려나가버리는 구나. 흐~음」
					PRINTFORMW 별로 놀라지 않는 %CALLNAME%에게 까닭을 물어보았다
					PRINTFORML 「그치만, 시키는 대로만 하믄 되는 거제?」
					PRINTFORMW 「지금도 똑같으니께」
					PRINTFORMW 「잘 있어, %CSTR:이인칭%」
				ENDIF
			ENDIF
		;それ以外
		ELSE
			;妊娠している場合。遊んで飽きたから売るとか最低だな
			IF TALENT:임신
				IF ABL:종족 == 0 && CFLAG:이벤트가입 == 3
					PRINTFORMW 「붙잡히고」
					PRINTFORMW 「팔려나가고」
					PRINTFORMW 「조교당하고」
					PRINTFORMW 「임신당하고」
					PRINTFORMW 「또 딴사람한테 팔려나가는 거제」
					PRINTFORML 　
					PRINTFORMW 「%CSTR:일인칭%, 집에 가고 싶구마……」
				ELSE
					PRINTFORMW 「%CSTR:일인칭%도 이 아이도, 어찌 되어버리는 걸까……」
				ENDIF
			ELSEIF CFLAG:이벤트가입 == 3 && RAND:3 == 0
				PRINTFORML 「붙잡히고 팔려나가고 조교당하고」
				PRINTFORML 「또 딴사람한테 팔려나가는 거제…」
				PRINTFORMW %CALLNAME%은(는) 체념 어린 표정으로 대답했다
				PRINTFORMW 「또 보자, %CSTR:이인칭%……」
			ELSEIF RAND:2 == 0
				PRINTFORML 「팔려나가는 거제…」
				PRINTFORMW %CALLNAME%은(는) 별 관심 없는 듯한 기색으로 대답했다
				PRINTFORMW 「어차피 지금이랑 다를 것도 없고……」
			ELSE
				PRINTFORML 「지금보다 더 좋은 데로 갈 수 있으려나…」
				PRINTFORMW %CALLNAME%은(는) 불안과 기대감에 안절부절못하는 기색이다
			ENDIF
		ENDIF

;-------------------------------------------------
;ビデオ売却時
;-------------------------------------------------
	CASE 19
		CALL EVENT_MESSAGE
		;陥落済み
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:278 < 2 || FLAG:7 == 2)
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				PRINTFORMW 「……%CSTR:일인칭%가 %CSTR:이인칭%한테 잔뜩 사랑받고 있는 모습…… 다들 봐주는 거제」
				IF TALENT:170
					PRINTFORMW 「에헤헤, 그라믄, 그, 『부부의 잠자리』를 공개해서 돈 받는 거라니, 엄청 골 때리는 푼수 커플이랑께%ハート()%」
				ENDIF
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORML 「당연히 모자이크는 없제?」
				IF RAND:2 == 0
					PRINTFORMW 「그 편이 더 비싸게 팔리니께」
				ELSE
					PRINTFORMW 「그치만 귀찮으니께 말여」
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORMW 「『로리물』 비디오구마%ハート()%」
				PRINTFORMW 「대놓고 못 파는 게 아쉽구마」
			ENDIF
			CFLAG:278 = 2
		ELSEIF CFLAG:278 < 1 || FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORMW 「그런 짓까지 당했는디, 촬영당해서 팔려나가버린다니…」
			ELSE
				PRINTFORMW 「이거 보믄, 누가 구하러 와주려나…」
			ENDIF
			CFLAG:278 = 1
		ENDIF

;-------------------------------------------------
;コンサ─ト時
;-------------------------------------------------
	CASE 20
		CALL EVENT_MESSAGE
		;初めて
		IF CFLAG:279 == 0
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				PRINTFORMW 「첫 콘서트라 긴장되기는 하는디…」
				PRINTFORMW 「%CSTR:이인칭%이(가) 곁에서 지켜봐 주고 있응게, 괜찮~당게%ハート()%」
			ELSE
				PRINTFORMW 
			ENDIF
			CFLAG:279 = 1
		;2回目以降
		ELSEIF CFLAG:279 < 1 || FLAG:7 == 2
			;サンタコ─トを着ている場合
			IF TEQUIP:90 == 1034 && RAND:3 == 0
				PRINTFORML 「모두들~」
				PRINTFORMW 「오늘은 크리스마스 라이브에 와줘서, 고마워~♪」
			ELSEIF RAND:2 == 0
				PRINTFORML 「다들 잘 지냈능가~♪」
				PRINTFORMW 「오늘도 %CSTR:일인칭% 콘서트, 시~작할게~♪」
			ELSE
				PRINTFORMW 「다들-! %CSTR:일인칭% 노래, 들어보소-!」
			ENDIF
			CFLAG:279 = 1
		ENDIF

;-------------------------------------------------
;乱交ライブ時
;-------------------------------------------------
	CASE 21
		CALL EVENT_MESSAGE
		;初めて
		IF CFLAG:280 == 0
			CFLAG:280 = 1
		;それ以外
		ELSEIF CFLAG:280 < 1 || FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORML 「다들　잘 지냈능가~♪」
				PRINTFORMW 「오늘은, %CSTR:일인칭% 노래랑 춤을 즐겨주고 가소」
			ELSE
				PRINTFORML 「오늘은 잔뜩 모여줘서 다들 고마워~」
				PRINTFORMW 「%CSTR:일인칭%도 화끈하게 서비스해버릴 틴게 말여%ハート()%」
			ENDIF
		ENDIF

;-------------------------------------------------
;公衆便所プレイ時
;-------------------------------------------------
CASE 22
	CALL EVENT_MESSAGE
	PRINTFORML  
	;初めて
	IF CFLAG:281 == 0
		IF TALENT:연모 || TALENT:친애
			IF TALENT:ＮＴＲ >= 1
				PRINTFORMW (아아, 오늘부터 %CSTR:일인칭%, 화장실 취급당해 버리는 거구나…)
				IF TALENT:아내 || TALENT:남편
					PRINTFORMW (%CSTR:일인칭%, 색시인디, 이름도 모르는 사람들한테 잔뜩 쓰여버리는 거구나…)
				ELSE
					PRINTFORMW (%CSTR:일인칭%, 좋아하는 사람이 있는디, 이름도 모르는 사람들한테 잔뜩 쓰여버리는 거구나…)
				ENDIF
				PRINTFORMW （%CSTR:일인칭%、%CSTR:일인칭%…）
				PRINTFORML 
				PRINTFORMW 「%CSTR:일인칭%, 이젠 자지 생각으로 머릿속이 꽉 차부렀당게%ハート()%」
				PRINTFORMW 「그랑게 말이여, 다른 건 죄다 잊어버릴 만큼, 잔뜩, 잔뜩 자지로 가게 해줘잉%ハート()%」
			ELSEIF CFLAG:MASTER:노역플래그 == CFLAG:노역플래그
				PRINTFORML 「화장실 취급당해 버리는 거, 대단히… 무섭구마」
				PRINTFORML 「그렇지만서도, %CSTR:이인칭%이(가) 함께 있으니께… 끄떡없고, 태평하당께」
				PRINTFORMW 입으로는 그렇게 말하고 있지만, %CALLNAME:MASTER%의 옆에 변기로 설치된 %CALLNAME%의 어깨는 추위 때문이 아닌 이유로 떨리고 있었다
				PRINTFORMW 「%CSTR:이인칭%, 손, 꼭 쥐고 있어줘도 되는 겨?」
				PRINTFORML 「그라믄, 분명…」
				PRINTFORMW %CALLNAME:MASTER%이(가) 대답을 하기도 전에, 이용객으로 보이는 사내가 들어왔다
				PRINTFORMW %CALLNAME%의 앞에 서서, 슬그머니 바지에서 페니스를 꺼냈다
				PRINTFORML 「아…」
				PRINTFORMW 무심코 눈을 돌릴 뻔했으나, 간신히 마음을 다잡고 배운 대로 가랑이를 벌리며, 남자를 유혹하는 추파를 던졌다
				PRINTFORMW 「고, 공중변기 %CALLNAME%이랑께요……」
				PRINTFORMW 「부디, 원하시는 만큼 %CSTR:일인칭%의 \@TALENT:처녀 ? 처, 처녀 보지 # 보, 보지\@를 써주소」
				PRINTFORMW 말이 끝나기가 무섭게, 남자는 발기한 육봉을 %CALLNAME%의 갈라진 틈에 대고 한숨에 꿰뚫어왔다
				IF TALENT:처녀
					PRINTFORMW 「히익… 큭, 으, 크읏…」
					PRINTFORMW 꿰뚫린 비순에서 처녀였던 증거가 뚝뚝 떨어진다
					PRINTFORMW (아파, 아파, 아파아파아파아파아파, 아프당게요!)
					PRINTFORMW 눈을 감고 이를 악물며 고통을 참아내려는 %CALLNAME%을(를) 아랑곳하지 않고 남자는 거칠게 추삽질을 시작했다
					PRINTFORMW 파과의 피를 윤활유 삼아, 젖지도 않은 질 안을 페니스가 힘으로 짓밟는다
					PRINTFORMW 「싫… 어, 아파, 아프당게! 그만해, 그만해줘잉!」
					PRINTFORMW %CALLNAME%이(가) 울며불며 고통을 호소하지만 남자는 오히려 그 반응을 즐기기라도 하듯 한층 더 격렬하게 움직였다
					PRINTFORML 「아, 아파아, 싫어, 아파아, 아프다꼬오! 으, 아, 아아아앗!」
					PRINTFORMW %CALLNAME:MASTER%이(가) 있다는 사실조차 잊어버린 듯이, %CALLNAME%은(는) 격렬하게 울부짖었다
					PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%이(가) 지켜보는 눈앞에서 성욕을 해소하기 위한 도구로 온종일 유린당했다……
				ELSE
					PRINTFORMW 「응, 큭, 후우… 앗」
					PRINTFORMW 처음에는 몸이 굳었으나, 남자를 아는 %CALLNAME%의 몸은 이내 페니스를 받아들이고자 꿀단지를 이슬로 적시기 시작한다
					;主人は必ず奴隷より先に回数を計算している
					IF CFLAG:MASTER:본방횟수 || CFLAG:MASTER:애널횟수
						PRINTFORMW 옆으로 눈을 돌리자, 남근을 받아들이고 쾌락의 교성을 지르는 %CALLNAME:MASTER%의 모습이 눈에 들어왔다
						PRINTFORMW (%CSTR:이인칭%… 평소보다, 예쁘당게…… 게다가 기분 좋아 보여…)
						PRINTFORMW %CALLNAME:MASTER%의 목소리에 몸 깊숙한 곳이 뜨겁게 달아오르기 시작했을 때, 남자의 페니스가 %CALLNAME%의 가장 깊은 곳을 찔렀다
						PRINTFORMW 「! 앗, 하, 아, 응, 읏!」
						PRINTFORMW 「더… %CSTR:이인칭%도, 더, 맘껏 엉망진창으로 짓밟아줘잉…!」
					ELSE
						PRINTFORMW 옆으로 눈을 돌리자, 남근을 사랑스럽다는 듯 물고 혀를 능숙하게 놀려 정성껏 희롱하는 %CALLNAME:MASTER%의 모습이 눈에 들어왔다
						PRINTFORMW (%CSTR:이인칭%… 평소보다, 예쁘당게…… 게다가 기분 좋아 보여…)
						PRINTFORMW %CALLNAME:MASTER%의 목소리에 몸 깊숙한 곳이 뜨겁게 달아오르기 시작했을 때, 남자의 페니스가 %CALLNAME%의 가장 깊은 곳을 찔렀다
						PRINTFORMW 「! 앗, 하, 아, 응, 읏!」
						PRINTFORMW 「더… %CSTR:이인칭%도, 더, 맘껏 엉망진창으로 짓밟아줘잉…!」
					ENDIF
				ENDIF
			ELSE
				PRINTFORMW (이런 거… 거짓말이랑께… 분명, 분명 악몽이랑께…)
				PRINTFORMW (눈을 뜨면, 그 사람 옆에서 자고 있다가 꼭 껴안아 줄 거제)
				PRINTFORMW (그러고선 머리를 상냥하게 쓰다듬어 받고…)
				IF CFLAG:본방횟수 || CFLAG:애널횟수
					PRINTFORMW 「히그윽!?」
					IF TALENT:처녀 && CFLAG:본방횟수
						PRINTFORMW 현실에서 도피하고 있던 %CALLNAME%의 사고는 아직 남자를 알지 못했던 순결한 틈을 이름도 모르는 사내의 육봉에 꿰뚫리는 감각으로 되돌아왔다
						PRINTFORMW 「커…… 헉… 아!?」
						PRINTFORML 처녀였음을 증명이라도 하듯 붉은 피가 남자의 페니스에 엉겨 붙으며 흘러내린다
						PRINTFORMW 그것을 본 %CALLNAME%의 눈가에 눈물이 핑 돌았다
						PRINTFORMW (그 사람한테, 그 사람한테 주고 싶었는디… %CSTR:일인칭%의 처음을 주고 싶었는디 말여…)
						PRINTFORMW 「우… 아…… 심… 너무하당게요… %CSTR:일인칭%의, %CSTR:일인칭%의 것을… 히, 으읏!?」
						PRINTFORMW 고개를 떨구고 맥없이 눈물을 흘리는 %CALLNAME%의 반응을 끌어내려는 듯, 남자는 거칠게 추삽질을 시작했다
						PRINTFORMW 파과의 피를 윤활유 삼아 젖지도 않은 질 안을 힘으로 유린한다
						PRINTFORMW 「싫… 어, 아파, 아프당께! 그만해, 그만해줘잉!」
						PRINTFORMW %CALLNAME%이(가) 울며불며 고통을 호소하지만 남자는 오히려 그 반응을 즐기기라도 하듯 한층 더 격렬하게 움직였다
						PRINTFORMW 「아, 아파아, 싫어, 아파아, 아프다꼬오! 으, 아, 아아아앗!」
					ELSE
						PRINTFORML 현실에서 도피하고 있던 %CALLNAME%의 사고는 \@CFLAG:본방횟수 ? 질내 # 국화문 \@을(를) 육봉에 꿰뚫리는 감각으로 되돌아왔다
						PRINTFORMW 「싫어엇, 아…… 파, 아프당께! 그만해, 그만해줘읍!?」
						PRINTFORMW 울부짖는 %CALLNAME%을(를) 닥치게 하려는 듯 입에도 페니스가 처박히며, 입안을 범하듯 난폭한 움직임으로 유린당했다
					ENDIF
					PRINTFORMW %CALLNAME%은(는) 성욕을 해소하기 위한 도구로 온종일 유린당했다……
				ELSE
					PRINTFORMW 「읍으읏!?」
					PRINTFORML 현실에서 도피하고 있던 %CALLNAME%의 사고는 입안에 육봉이 처박히는 감각으로 되돌아왔다
					PRINTFORMW 「응, 읍, 후, 으응, 으응-읏!」
					PRINTFORMW 머리를 양손으로 짓눌린 채 목구멍 깊은 곳까지 난폭하게 범해진다
					PRINTFORMW %CALLNAME%은(는) 성욕을 해소하기 위한 도구로 온종일 유린당했다……
				ENDIF
			ENDIF
		ELSEIF TALENT:음란 || TALENT:창부 || TALENT:ＮＴＲ == 2
			;二人して働いている場合
			IF CFLAG:노역플래그 == CFLAG:MASTER:노역플래그
				PRINTFORMW 사내들의 성욕 배출구로 전락한 뒤, 알몸인 %CALLNAME%은(는) 함께 범해지던 %CALLNAME:MASTER%에게 몸을 바싹 비벼왔다
				PRINTFORMW 「화장실이란 거… 응… 후, 기분 좋아…」
				PRINTFORMW 남자의 욕망으로 뒤덮여 끈적해진 서로의 살결을 맞대고, 사내들의 냄새를 깊이 배어들게 하려는 듯 피부와 피부로 정액을 비벼 넓게 펴 바른다
				IF CFLAG:MASTER:질내사정횟수 && CFLAG:질내사정횟수
					PRINTFORMW 「%CSTR:이인칭%은(는) 몇 번이나 안에 싸달라고 했능가?」
					PRINTFORMW 「%CSTR:일인칭%, 이만치나 싸달라고 했당게, 봐봐♪」
					PRINTFORMW %CALLNAME%이(가) 질구를 손가락으로 벌리자 백탁액이 끊임없이 흘러넘쳤다
					IF BASE:체력 >= 500
						PRINTFORMW 「에헤헤-……♪」
						PRINTFORMW 「내일부터도, 함께, 가~아득 씨뿌리기 받자잉%ハート()%」
					ELSE
						PRINTFORMW 「다음에도 또 함께, 가~아득 씨뿌리기 받자잉%ハート()%」
					ENDIF
				ELSE
					PRINTFORMW 「내일부터도, 함께, 가~아득 화장실 취급당하자잉%ハート()%」
				ENDIF
			ELSE
				PRINTFORMW 「아, %CSTR:이인칭%♪」
				PRINTFORMW 온몸을 정액투성이로 만든 채, 완전히 녹아내린 미소로 %CALLNAME%이(가) 말을 걸어왔다
				IF CFLAG:질내사정횟수 > 1
					PRINTFORMW 「에헤헤-, 봐봐 봐봐♪」
					PRINTFORMW %CALLNAME%이(가) 질구를 손가락으로 벌리자, \@CFLAG:질내사정횟수 > 5 ?대량의 #\@정액이 끊임없이 흘러넘쳤다
					PRINTFORMW 「가~아득 보지 쑤셔지고, 가~아득 안에 싸달라고 했당게♪」
					IF HAVE_PENIS(MASTER)
						PRINTFORMW 질내사정당한 흔적을 과시하며, 기쁜 듯 범해지던 때의 일을 재잘거리는 %CALLNAME%의 모습에 %CALLNAME:MASTER%의 남근이 우뚝 고개를 치켜들었다
						PRINTFORMW 「앗, %CSTR:이인칭%도 %CSTR:일인칭%이랑 보지 쑤시고 싶어져 버린 겨?」
						PRINTFORMW 「에헤… 좋아아. %CSTR:일인칭% 보지는, 모두의 화장실이니께%ハート()%」
					ELSE
						PRINTFORMW 「다음엔 %CSTR:이인칭%도 함께 화장실 취급당하자잉%ハート()%」
					ENDIF
				ELSE
					PRINTFORMW 「손님들한테 잔~뜩 화장실 취급당했당게♪」
					PRINTFORMW 「자지가 한가득이라, 대단히 기분 좋았당께-%ハート()%」
					IF HAVE_PENIS(MASTER)
						PRINTFORMW 기쁜 듯 범해지던 때의 일을 재잘거리는 %CALLNAME%의 모습에 %CALLNAME:MASTER%의 남근이 우뚝 고개를 치켜들었다
						PRINTFORMW 「앗, %CSTR:이인칭%도 %CSTR:일인칭%한테 화장실 용무 보고 싶어져 버린 겨?」
						PRINTFORMW 「에헤… 좋아아. %CSTR:일인칭%는, 모두의 화장실이니께%ハート()%」
					ELSE
						PRINTFORMW 「다음엔 %CSTR:이인칭%도 함께 화장실 취급당하자잉%ハート()%」
					ENDIF
				ENDIF
			ENDIF
		ELSEIF TALENT:복종 || TALENT:예속 || TALENT:ＮＴＲ == 3
			;二人して働いている場合
			IF CFLAG:노역플래그 == CFLAG:MASTER:노역플래그
				;お互いにLV50以上の場合、確率でセリフが変わる
				IF BASE:MASTER:LV >= 50 && BASE:LV >= 50 && RAND:2 == 0
