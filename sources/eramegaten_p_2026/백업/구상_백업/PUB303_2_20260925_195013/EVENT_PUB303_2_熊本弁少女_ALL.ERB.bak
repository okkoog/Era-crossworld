	CASE 250
		CALL TRAIN_MESSAGE
		;恋慕、親愛
		IF TALENT:연모 || TALENT:친애
			IF RAND:2 == 0
				PRINTFORML 「싫어, 미끌미끌이가 %CSTR:일인칭% 안에서 움직여서…」
				PRINTFORML 「%CSTR:이인칭%, 빨리 구해줘!」
			ELSE
				PRINTFORML 「안 돼읏!」
				PRINTFORMW 「거기는 %CSTR:이인칭%의 아기 방이니께, 노크하지 마시게!」
			ENDIF
		;淫乱、娼婦
		ELSEIF TALENT:음란 || TALENT:창부
			IF RAND:2 == 0
				PRINTFORML 「봐봐, %CSTR:이인칭%」
			ELSE
				PRINTFORML 「대단혀, %CSTR:이인칭%!」
			ENDIF
			IF RAND:2 == 0
				PRINTFORML 「미끌미끌이가 %CSTR:일인칭%의 안을 들락날락거리고 있당께♪」
			ELSE
				PRINTFORML 「미끌미끌이가 이런 데까지 들어오고 있당께♪」
			ENDIF
		;服従、隷属
		ELSEIF TALENT:복종 || TALENT:예속
			IF RAND:2 == 0
				PRINTFORML 「%CSTR:이인칭%」
				PRINTFORML 「미끌미끌이가 %CSTR:일인칭%의 안을 들락날락거리며」
				PRINTFORML 「장난감 취급을 당하고 있구마」
			ELSE
				PRINTFORML 「%CSTR:이인칭%, 대단하당께」
				PRINTFORMW 「움직일 때마다, 꼬추로는 못 건드리는 곳을 어루만져 온당께!」
			ENDIF
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3
			PRINTFORML 「싫어! 그렇게 %CSTR:일인칭% 속에서 날뛰어뿌믄…」
			IF RAND:2 == 0
				PRINTFORML 「이상해져 버리니께! 그만둬!」
			ELSE
				PRINTFORML 「야한 아이가 되어버리니께, 안 된당께!」
			ENDIF
		;それ以外
		ELSE
			IF RAND:3 == 0
				PRINTFORML 「싫어! 그 이상은 안 들어간당께!」
			ELSEIF RAND:2 == 0
				PRINTFORML 「싫어! 그런 데까정 들어오지 마시게!」
			ELSE
				PRINTFORML 「싫어! 거길 문지르지 마시게」
				PRINTFORMW 「%CSTR:일인칭%의 여자아이인 곳을, 장난감 취급 마시게!」
			ENDIF
		ENDIF

