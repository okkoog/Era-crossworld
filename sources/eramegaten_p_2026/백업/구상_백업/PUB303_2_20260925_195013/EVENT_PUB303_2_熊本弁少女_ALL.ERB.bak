				ENDIF
				PRINTFORMW %CALLNAME%은(는) 당황해하고 있다
			ENDIF
			CFLAG:432 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:432 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORMW 「눈앞에서 자위를 하다니… %CSTR:일인칭%이랑 섹스하는 것보다 자위가 더 좋은겨…?」
						PRINTFORMW 「자위는 디저트 배? 잘 모르겠구먼…」
					ELSE
						PRINTFORMW 「자지, 달아올라 있다면 %CSTR:일인칭%이 해줄 텐디」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF TEQUIP:주도권
						PRINTFORML 「아핫%ハート()%」
						IF RAND:2 == 0
							PRINTFORMW 「진짜로 혼자서 자위하고 있네♪」
						ELSE
							PRINTFORMW 「완전 손놀림이 빨라지고 있당께♪」
						ENDIF
					;前回コマンドが自慰の場合
					ELSEIF PREVCOM == 11
						PRINTFORML 「%CSTR:일인칭% 자위하는 걸 보고 참을 수가 없게 되어버린겨?」
						IF RAND:2 == 0
							PRINTFORMW 「그라믄, 서로 보여주기 할래?」
						ELSE
							PRINTFORMW 「달아올랐으믄, 밀어 넘어뜨려도 괜찮았는디♪」
						ENDIF
					ELSE
						IF RAND:3 == 0
							PRINTFORMW 「혼자서 하지 말구, %CSTR:일인칭%이랑 하자구우~」
						ELSEIF RAND:2 == 0
							PRINTFORMW 「자기 혼자만 기분 좋아지려 하구 치사~해」
						ELSE
							PRINTFORMW 「%CSTR:일인칭%도 같이 해도 돼?」
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF TEQUIP:주도권
						PRINTFORML 「어뗘」
						PRINTFORMW 「평소와 반대인 플레이는?」
					ELSE
						IF RAND:2 == 0
							PRINTFORML 「자위할 거라믄 %CSTR:일인칭%을 써주믄 될 텐디…」
							PRINTFORMW 「%CSTR:이인칭% 심술쟁이」
						ELSE
							PRINTFORML 「보고만 있는 건 애달프당께」
							PRINTFORMW 「다음엔 %CSTR:일인칭%이랑 해주면 안 돼…」
						ENDIF
					ENDIF
				ENDIF
				CFLAG:432 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:432 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORMW 「혼자서 즐기다니 치사하지 않어?」
				ELSE
					PRINTFORML 「혼자라믄… 외롭지 않어?」
					PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%의 몸을 보며 옴질옴질하고 있다
				ENDIF
				CFLAG:432 = 3
			;それ以外
			ELSEIF CFLAG:432 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「자위할 거라믄 자기 방에서 하믄 되잖여?」
				ELSE
					PRINTFORMW 「이상한 거 보여주지 말어!」
				ENDIF
				CFLAG:432 = 2
			ENDIF
		ENDIF

