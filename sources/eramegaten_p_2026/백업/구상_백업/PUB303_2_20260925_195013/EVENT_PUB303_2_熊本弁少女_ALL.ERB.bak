			ENDIF
			CFLAG:369 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:369 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORMW 「입 한가득으로 봉사해 줄팅께%ハート()%」
					ELSE
						PRINTFORMW 「%CSTR:일인칭%은(는) 괜찮은게」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭% 말이여, 자지 억수로 좋아혀%ハート()%」
						PRINTFORMW 「입 안쪽까지 푹푹 쑤셔박히면 말이제… 정복당하는 것 같아가 흥분해 버린당께」
					ELSE
						PRINTFORMW 「또 하는겨?」
						PRINTFORMW 「참말로는 억수로 괴롭지만서도…」
						PRINTFORMW 「억지로 범해지는 것 같아가 참말로 좋당께♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					;反発刻印LV3からのイラマチオ
					IF RAND:3 == 0 && CFLAG:801 == 1
						PRINTFORML 「%CSTR:일인칭%이 심한 소릴 해뿐졌어」
						PRINTFORMW 「나쁜 입술을 반성시켜 주시게♪」
					ELSEIF RAND:2 == 0
						PRINTFORML 「%CSTR:일인칭%의 입 오나홀, 기분 좋아?」
						PRINTFORMW 「성에 안 차믄, 더 격하게 써주시게♪」
					ELSE
						PRINTFORMW 「으응… %CSTR:일인칭%은(는) 육변기니께」
						PRINTFORMW 「듬뿍 %CSTR:일인칭%의 입을 즐겨주시게」
					ENDIF
				ENDIF
				CFLAG:369 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:369 < 3 || FLAG:7 == 2)
				IF ABL:마조끼 >= 4
					PRINTFORMW 「으응… 으으응…」
					PRINTFORML （괴롭지만서도, 이게 당연한 게 돼삤어……）
					PRINTFORMW 머리를 붙잡혀 억지로 구강을 범해지는 %CALLNAME%이지만, 그 표정은 괴로워 보이면서도 황홀해하고 있다
				ELSE
					PRINTFORMW 「으응… 으으응…」
					PRINTFORMW 머리를 붙잡혀 억지로 구강을 범해지는 %CALLNAME%은(는) 괴로운 듯 얼굴을 찌푸리고 있다
				ENDIF
				CFLAG:369 = 3
			;それ以外
			ELSEIF CFLAG:369 < 2 || FLAG:7 == 2
				IF ABL:마조끼 >= 4
					PRINTFORML （이런 심한 짓을 당하고 있는디도……）
					PRINTFORMW %CALLNAME%은(는) 저항하는 일 없이 구강을 오나홀 대신으로 쓰이고 있다
				ELSE
					PRINTFORMW 「싫어어읏!!」
					PRINTFORML 무슨 짓을 당하는지 이해한 %CALLNAME%은(는) 싫다며 고개를 가로저었지만,
					PRINTFORMW 저항도 헛되이 %CALLNAME:PLAYER%의 손에 의해 구강을 오나홀 대신으로 쓰여 격하게 목구멍을 범해졌다
					PRINTFORMW 「으으응… 하아… 하아… 쿨럭 쿨럭」
					PRINTFORMW 「이런 지독한 짓은 안 된당께…」
				ENDIF
				CFLAG:369 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;141,피스트퍽　服従、隷属のみ
;-------------------------------------------------
	CASE 141
