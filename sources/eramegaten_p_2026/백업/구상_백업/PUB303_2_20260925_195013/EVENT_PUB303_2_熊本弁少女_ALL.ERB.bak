			PRINTFORML ┃%"하아, 하아…… 어, 어뗘유?　" + CSTR:일인칭 + "의 야한 보지……" + UNICODE(0x2661),72,LEFT%┃
			PRINTFORML ┃%"보, 봐유…… 응읏" + UNICODE(0x2661) + "　원해가지고…… 옴쭉옴쭉거려 버린당께요" + UNICODE(0x2661),72,LEFT%┃
			PRINTFORML ┃%"히양" + UNICODE(0x2661) + "　보, 보고 있는디도, 가버려유우" + UNICODE(0x2661) + "　" + UNICODE(0x2661) + "　",72,LEFT%┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			;白に
			RESETCOLOR
			;地の文
			PRINTFORMW 가느다란 손가락을 두 개나 집어삼킨 %CALLNAME:ARG%의 질 구멍에서는, 아직 부족하다는 듯 대량의 욕망이 뚝뚝 떨어져 내린다.
			PRINTFORMW 아직 어린 비순은 이미 남자의 맛을 똑똑히 알고 있어서, 손가락이 움직일 때마다 실룩실룩 애원하듯 떨려온다.
			PRINTFORMW 풋풋한 과실처럼 싱그러운 %CALLNAME:ARG%의 용모가, 그 음란한 자태를 한층 더 요염하게 돋보이게 하며 배덕감을 부추긴다.
			PRINTFORML 소녀의 치태에 넋을 잃고 있던 악마들은, 어느샌가 의식마저도 어린 악마에게 빼앗겨 갔다.
			PRINTFORMW
		ENDIF
	ENDIF

;--------------------------------------------------
;スキル使用時（汎用）
;--------------------------------------------------
;まずはムフフとそれ以外に分岐
ELSEIF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
	;回復系
	IF TALENT:ARG:회복 && (CFLAG:ARG:입력행동 >= 400 && CFLAG:ARG:입력행동 <= 499)
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 기분 좋게, 읏%UNICODE(0x2661)% 해, 줘버릴 틴게!%UNICODE(0x2661)%
		ELSE
			BTL_KOJO_RESULTS:0 = 회복, 할, 게? %RESULTS%%UNICODE(0x2661)%
		ENDIF
	;その他
	ELSE
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 하아, 하아……%UNICODE(0x2661)% 다리가 후들거려버려, 어%UNICODE(0x2661)%
		ELSE
			BTL_KOJO_RESULTS:0 = 정말…… %CSTR:이인칭% 변, 태애%UNICODE(0x2661)%
		ENDIF
	ENDIF

;回復系
ELSEIF TALENT:ARG:회복 && (CFLAG:ARG:입력행동 >= 400 && CFLAG:ARG:입력행동 <= 499)
	IF RAND:4 == 0
		BTL_KOJO_RESULTS:0 = 회복이라면 맡겨줘!
	ELSEIF RAND:3 == 0
		CALL GET_SKILL_PROP, "SKILL_NAME", CFLAG:ARG:입력행동, ARG
		;使用したスキルの名前をLOCALSに代入
		LOCALS = %RESULTS%
		BTL_KOJO_RESULTS:0 = 괜찮여? 지금 회복해줄 틴게! %LOCALS%!
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = %LOCALS%! 너무 무리하지 마러?
	ELSE
		BTL_KOJO_RESULTS:0 = %LOCALS%♪
	ENDIF

;支援系
ELSEIF TALENT:ARG:지원 && (CFLAG:ARG:입력행동 >= 500 && CFLAG:ARG:입력행동 <= 599)
	BTL_KOJO_RESULTS:0 = 원호라면 맡겨줘!

;防御系
ELSEIF TALENT:ARG:방어 && (CFLAG:ARG:입력행동 >= 600 && CFLAG:ARG:입력행동 <= 699)
	BTL_KOJO_RESULTS:0 = 방어는 맡겨줘!

;火炎系
ELSEIF CFLAG:ARG:입력행동 >= 700 && CFLAG:ARG:입력행동 <= 799
	IF TALENT:ARG:화염 && ABL:ARG:요리기능 <= 2 &&  RAND:5 == 0
		BTL_KOJO_RESULTS:0 = 생선구이는 자신 있당게♪
	ELSEIF TALENT:ARG:화염 && RAND:4 == 0
		BTL_KOJO_RESULTS:0 = 이걸로 새까맣게 타버려라!
	ELSEIF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 구워버릴게♪
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 화염이라면 맡겨줘!
	ENDIF

;氷結系
ELSEIF CFLAG:ARG:입력행동 >= 800 && CFLAG:ARG:입력행동 <= 899
	IF TALENT:ARG:빙결 && RAND:4 == 0
		BTL_KOJO_RESULTS:0 = 아이스바 만들어줄게"%UNICODE(0x2661)%
	ELSEIF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 차가운 거라면 맡겨줘!
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 동상 정도로 안 끝난데이
	ENDIF

;電撃系
ELSEIF CFLAG:ARG:입력행동 >= 900 && CFLAG:ARG:입력행동 <= 999
	IF CFLAG:ARG:입력행동 == 902
		BTL_KOJO_RESULTS:0 = 필살, 지온 캐논!
	ELSEIF TALENT:ARG:전격 && RAND:4 == 0
		BTL_KOJO_RESULTS:0 = 일렉트리컬 퍼레이드, 간다아♪
	ELSEIF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 십만 볼트다!
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 감전 주의랑께♪
	ENDIF

;衝撃系
ELSEIF CFLAG:ARG:입력행동 >= 1000 && CFLAG:ARG:입력행동 <= 1099
	IF TALENT:ARG:충격 && RAND:4 == 0
		BTL_KOJO_RESULTS:0 = 지방으로 날려버릴 거여♪
	ELSEIF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 휙 날려버릴 거여♪
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 자, 콰콰쾅-!
	ENDIF

;神経系
ELSEIF CFLAG:ARG:입력행동 >= 1100 && CFLAG:ARG:입력행동 <= 1199
	IF TALENT:ARG:신경 && RAND:4 == 0
		BTL_KOJO_RESULTS:0 =신경쇠약? 특기랑께♪
	ELSEIF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 상태 이상 선물이어유♪
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 맛이 가버려라-
	ENDIF

;精神系
ELSEIF CFLAG:ARG:입력행동 >= 1200 && CFLAG:ARG:입력행동 <= 1299
	IF CFLAG:ARG:입력행동 == 1212 && (TALENT:ARG:음란 || TALENT:ARG:창부)
		;섹시댄스
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 손대면 안 된데이%UNICODE(0x2661)%
		ELSE
			BTL_KOJO_RESULTS:0 = 아핫%UNICODE(0x2661)%
		ENDIF
	ELSEIF CFLAG:ARG:입력행동 == 1214 && (TALENT:ARG:음란 || TALENT:ARG:창부)
		;파이널누드
		IF RAND:6 == 0 && BUST(ARG) >= 4
			BTL_KOJO_RESULTS:0 = 로리 거유 같은 거 좋아해?
		ELSEIF RAND:5 == 0 && BUST(ARG) == 2
			BTL_KOJO_RESULTS:0 = 부풀어 오르는 찌찌는 어때?
		ELSEIF RAND:4 == 0 && BUST(ARG) == 1
			BTL_KOJO_RESULTS:0 = 애들의 조그만 젖가슴에 욕정해 버렸능가?
		ELSEIF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 어린애 몸에 흥분해 버리는 거제♪
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 보고만 있어도 되는 겨?
		ELSE
			BTL_KOJO_RESULTS:0 = 만지면 범죄지만서도, 어쩔래♪
		ENDIF
	ELSE
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 뇌수를 쉐이크해 줄게%UNICODE(0x2661)%
		ELSE
			BTL_KOJO_RESULTS:0 = 아핫%UNICODE(0x2661)%
		ENDIF
	ENDIF

;破魔系
ELSEIF CFLAG:ARG:입력행동 >= 1300 && CFLAG:ARG:입력행동 <= 1399 && (TALENT:ARG:음란 || TALENT:ARG:창부)
	BTL_KOJO_RESULTS:0 = 성스러운 힘으로 쓰러뜨려 버릴게%UNICODE(0x2661)%

;呪殺系
ELSEIF CFLAG:ARG:입력행동 >= 1400 && CFLAG:ARG:입력행동 <= 1499 && (TALENT:ARG:음란 || TALENT:ARG:창부)
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 암흑 파워, 보여줄게%UNICODE(0x2661)%
		ELSE
			BTL_KOJO_RESULTS:0 = 사악한 힘으로 쓰러뜨려 버릴게%UNICODE(0x2661)%
		ENDIF

;地変系
ELSEIF CFLAG:ARG:입력행동 >= 1500 && CFLAG:ARG:입력행동 <= 1599
	IF TALENT:ARG:지변 && RAND:4 == 0
		;私は磁界の王……
		BTL_KOJO_RESULTS:0 = %CSTR:일인칭% 힘은 어머니 대지의 품에서 끌어낸 거랑께!
	ELSEIF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 어스 크래-애시!
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 자, 콰앙!
	ENDIF

;水撃系
ELSEIF CFLAG:ARG:입력행동 >= 1600 && CFLAG:ARG:입력행동 <= 1699
	IF TALENT:ARG:수격 && RAND:4 == 0
		BTL_KOJO_RESULTS:0 = 유수풀, 맘껏 즐기고 가소♪
	ELSEIF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 물놀이나 할까나
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 물이라면 맡겨줘!
	ENDIF

;疾風系
ELSEIF CFLAG:ARG:입력행동 >= 1700 && CFLAG:ARG:입력행동 <= 1799
	IF TALENT:ARG:질풍 && RAND:4 == 0
		BTL_KOJO_RESULTS:0 = 어디까지 날아가 버리려나?
	ELSEIF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 망토만으로는 못 막는당게♪
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 바람 부는 거, 특기랑께
	ENDIF

;重力系
;ELSEIF CFLAG:ARG:입력행동 >= 1800 && CFLAG:ARG:입력행동 <= 1899
;	IF TALENT:ARG:중력 && RAND:4 == 0
;		BTL_KOJO_RESULTS:0 = 
;	ELSEIF RAND:3 == 0
;		BTL_KOJO_RESULTS:0 = 
;	ELSEIF RAND:2 == 0
;		BTL_KOJO_RESULTS:0 = 
;	ENDIF

;核熱系
;ELSEIF CFLAG:ARG:입력행동 >= 1900 && CFLAG:ARG:입력행동 <= 1999
;	IF TALENT:ARG:핵열 && RAND:4 == 0
;		BTL_KOJO_RESULTS:0 = 
;	ELSEIF RAND:3 == 0
;		BTL_KOJO_RESULTS:0 = 
;	ELSEIF RAND:2 == 0
;		BTL_KOJO_RESULTS:0 = 
;	ENDIF

;万能系
ELSEIF CFLAG:ARG:입력행동 >= 2000 && CFLAG:ARG:입력행동 <= 2099
	;親愛自爆系（自爆、玉砕波、バイナルストライク）
	;さようなら　＠さん……
	IF GROUPMATCH(CFLAG:ARG:입력행동, 2005, 2006, 2007) && 陥落() && RESULTS == "연모"
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = %CSTR:이인칭%을(를) 위해서라면, %CSTR:일인칭%, 할 수 있당게…
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 지믄 안 된데이…
		ELSE
			BTL_KOJO_RESULTS:0 = %CSTR:일인칭%가 없어져 버려도, 슬퍼하지 마러…
		ENDIF
	;おめめぐるぐる
	ELSEIF GROUPMATCH(CFLAG:ARG:입력행동, 2005, 2006, 2007) && 陥落() && RESULTS == "신뢰"
		BTL_KOJO_RESULTS:0 = 잘 있어라.
		BTL_KOJO_RESULTS:1 = 친구여.
	ELSE
		IF RAND:4 == 0
			BTL_KOJO_RESULTS:0 = 상성 같은 거 생각하믄 귀찮구마♪
		ELSEIF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 이 공격을 버텨낼 수 있겠능가?
		ENDIF
	ENDIF

;魔法少女
ELSEIF CFLAG:ARG:입력행동 >= 2900 && CFLAG:ARG:입력행동 <= 2999
	IF RAND:6 == 0 && (TALENT:ARG:연모 || TALENT:ARG:친애)
		BTL_KOJO_RESULTS:0 = %CSTR:이인칭%"을 위해서라면 뭐든지 할 수 있응게
	ELSEIF RAND:5 == 0 && (TALENT:ARG:음란 || TALENT:ARG:창부)
		BTL_KOJO_RESULTS:0 = 성애와 욕망의%UNICODE(0x2661)%
	ELSEIF RAND:4 == 0
		BTL_KOJO_RESULTS:0 = 사랑과 희망의!
	ELSEIF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = %CSTR:일인칭%도!
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 계약의 힘, 보여줄 틴게
	ENDIF
ELSE
	IF ARG:1 > 0
	;忠誠度が上昇する行動をと읏た場合に表示する口上

	CALL GET_SKILL_PROP, "SKILL_NAME", CFLAG:ARG:입력행동, ARG
	;使用したスキルの名前をLOCALSに代入
	LOCALS = %RESULTS%

	SELECTCASE ARG:1
		;物理ダメ─ジを与える行動で、獰猛持ちの忠誠度が上昇
		CASE GETNUM(TALENT,"영맹")
			IF RAND:2
				BTL_KOJO_RESULTS:0 = %LOCALS%! 가라앗!
			ELSE
				BTL_KOJO_RESULTS:0 = %LOCALS%! 우오~♪
			ENDIF
		;魔法ダメ─ジを与える行動で、狡猾持ちの忠誠度が上昇
		CASE GETNUM(TALENT,"교활")
			IF RAND:2
				BTL_KOJO_RESULTS:0 = %LOCALS%! 마법 공격 좋구마♪
			ELSE
				BTL_KOJO_RESULTS:0 = %LOCALS%! 해치워버려!
			ENDIF
		;高威力の行動で、残虐持ちの忠誠度が上昇
		CASE GETNUM(TALENT,"잔학")
			IF RAND:2
				BTL_KOJO_RESULTS:0 = %LOCALS%! 화끈하게 날아가버려라♪
			ELSE
				BTL_KOJO_RESULTS:0 = %LOCALS%! 큰 거 들어간다-♪
			ENDIF
		;相手の弱点を付いた攻撃or行動不能な状態異常の敵に対する攻撃で、賢い持ちの忠誠度が上昇
		CASE GETNUM(TALENT,"현명")
				IF RAND:2
					BTL_KOJO_RESULTS:0 = %LOCALS%! 지성파, 로구마♪
				ELSE
					BTL_KOJO_RESULTS:0 = %LOCALS%! 역시 %CSTR:이인칭%, 머리 좋구마-♪
				ENDIF
		;破魔相性の行動で、天使持ちの忠誠度が上昇
		CASE GETNUM(TALENT,"천사")
				IF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = %LOCALS%! 천벌이 쏟아진당께!!
				ELSEIF RAND:2
					BTL_KOJO_RESULTS:0 = %LOCALS%! %CSTR:이인칭%의 뜻대로!!
				ELSE
					BTL_KOJO_RESULTS:0 = %LOCALS%! 정화할게!
				ENDIF
		;呪殺相性の行動で、堕天使持ちの忠誠度が上昇
		CASE GETNUM(TALENT,"타천사")
			IF RAND:2
				BTL_KOJO_RESULTS:0 = %LOCALS%은 탐미적인 느낌이라 소름 돋아부러%UNICODE(0x2661)%
			ELSE
				BTL_KOJO_RESULTS:0 = %LOCALS%! 저주해 줄게~♪
			ENDIF
		;回復·状態回復行動では友愛持ちの忠誠度が上昇
		CASE GETNUM(TALENT,"우애")
				IF RAND:2
					BTL_KOJO_RESULTS:0 = %LOCALS%! 사랑을 느끼랑께!
				ELSE
					BTL_KOJO_RESULTS:0 = %LOCALS%! 모두는 %CSTR:일인칭%가 지킬 테니께♪
				ENDIF
		;状態変化では高慢持ちの忠誠度が上昇
		CASE GETNUM(TALENT,"교만")
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 이런 녀석, %LOCALS%(으)로 충분하제!
				ELSE
					BTL_KOJO_RESULTS:0 = %CSTR:일인칭%한테 당해낼 리 없잖여♪ %LOCALS%!
				ENDIF
		;特殊では冷静持ちの忠誠度が上昇
		CASE GETNUM(TALENT,"냉정")
				IF RAND:2
					BTL_KOJO_RESULTS:0 = %LOCALS% 맞제? 응, 맡겨줘!
				ELSE
					BTL_KOJO_RESULTS:0 = %LOCALS%! 그래그래, 좋은 느낌♪ 흥분하면 안 된데이-♪
				ENDIF
;		;愚鈍持ちは主人とのLv差だけ忠誠度が上昇
		CASE GETNUM(TALENT,"우둔")
				IF RAND:2
					BTL_KOJO_RESULTS:0 = %LOCALS%? %CSTR:일인칭% 말이 맞제
				ELSE
					BTL_KOJO_RESULTS:0 = %LOCALS%(으)로 괜찮~여?
				ENDIF
;		;虚心持ちは最低２だけ忠誠度が上昇
		CASE GETNUM(TALENT,"허심")
			BTL_KOJO_RESULTS:0 = %LOCALS%구마, 잘 알고 있당게?
	ENDSELECT
	;ELSE
	;	;システムによらず忠誠度を上げたいとか他があ읏たらここに記載
	ENDIF
ENDIF
