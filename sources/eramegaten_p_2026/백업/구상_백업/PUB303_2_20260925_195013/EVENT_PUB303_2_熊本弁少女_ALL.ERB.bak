	CASE 185
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:397 == 0 && FLAG:7 == 2
			PRINTFORMW 「에에!? 섹스하는 걸 보라꼬?」
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				PRINTFORMW 「으~, %CSTR:일인칭%만 쏙 빼놓다니」
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORMW 「있제, 다음엔 %CSTR:일인칭% 차례제?」
			;反発刻印Lv3
			ELSEIF MARK:3 == 3 && (CFLAG:217 < 1 || FLAG:7 == 2)
				PRINTFORMW 「딴 사람이랑 할 거믄, %CSTR:일인칭% 따윈 안 불러도 될 텐디…」
			ELSE
				PRINTFORMW 「으-, 할 거믄 딴 데 가서 하시게…」
			ENDIF
			CFLAG:397 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:397 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
PRINTFORMW 「눈앞에서 섹스하는 걸 과시하다니… 너무하당께… %CSTR:이인칭%」
ELSE
PRINTFORMW 「으~, 또 %CSTR:일인칭%만 왕따인겨」
ENDIF
;淫乱、娼婦
ELSEIF TALENT:음란 || TALENT:창부
IF RAND:3 == 0
PRINTFORML 「다음엔 %CSTR:일인칭% 차례제. 자아 자아%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 힐끔거리며 가랑이를 벌려 %CALLNAME:PLAYER%을(를) 도발하고 있다
ELSEIF RAND:2 == 0
PRINTFORMW 「으~, 또 %CSTR:일인칭%만 감질나게 하는겨」
ELSE
PRINTFORMW 「좋겠구마잉, %CALLNAME:ASSI% 기분 좋아 보이고」
ENDIF
;服従、隷属
ELSEIF TALENT:복종 || TALENT:예속
IF RAND:3 == 0
PRINTFORMW 「있제, 어여 %CSTR:이인칭% 자지 줘어」
ELSEIF RAND:2 == 0
PRINTFORML 「으~, 또 %CSTR:일인칭%만 감질나게 해」
PRINTFORMW 「방치 플레이 노잼이야~」
ELSE
PRINTFORML 「좋겠구마잉, %CALLNAME:ASSI% 기분 좋아 보이고」
PRINTFORMW 「%CSTR:이인칭% 차례는 아직인겨?」
ENDIF
ENDIF
CFLAG:397 = 4
;屈服刻印Lv3
ELSEIF MARK:2 == 3 && (CFLAG:397 < 3 || FLAG:7 == 2)
PRINTFORMW 「우와-… 기분 좋아 보이네……」
PRINTFORMW 「에!? %CSTR:일인칭%도 같이 하자꼬… 으-, 기분 좋아 보이긴 했지만서도, 그래도 말이여…」
CFLAG:397 = 3
;それ以外
ELSEIF CFLAG:397 < 2 || FLAG:7 == 2
IF RAND:2 == 0
PRINTFORMW 「정말-… 어째서 %CSTR:일인칭% 눈앞에서 하는겨…?」
ELSE
PRINTFORMW 「그렇게 %CALLNAME:ASSI%이(가) 좋으믄, 둘이서만 하고 있으믄 되잖여」
				ENDIF
				CFLAG:397 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;186,수치플레이,
