;=============================================================
;戦闘メ읏セ─ジ
;=============================================================
;--------------------------------------------------
;リアクション
;--------------------------------------------------
@KOJO_BATTLE_EVENT_PUB303_2, ARG, ARG:1, ARG:2
;味方パ─ティでのデビルＣＯ－ＯＰ発動時の台詞
IF TFLAG:전투이벤트 == 1
	;ムフフ
	IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 읏%UNICODE(0x2661)%　찬, 스, 로구마%UNICODE(0x2661)%　히햔♪　다, 같이, 가, 는 거여%UNICODE(0x2661)%
		ELSE
			BTL_KOJO_RESULTS:0 = 아앙%UNICODE(0x2661)%　하아, 하아…… 다들, 뒤, 뒤따라와아%UNICODE(0x2661)%
		ENDIF
	ELSEIF 陥落()
		IF RAND:4 == 0
			BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 찬스, 랑께! 총공격하자잉♪
		ELSEIF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 적이 주춤하는 것 같아! 지금이 기회랑께!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 다들, 다굴 쳐버려라-♪
		ELSE
			BTL_KOJO_RESULTS:0 = %CSTR:일인칭%를 따르라아♪
		ENDIF
	ELSE
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 찬스라꼬!
		ELSE
			BTL_KOJO_RESULTS:0 = 잘 부탁해!
		ENDIF
	ENDIF
;味方パ─ティでのデビルＣＯ－ＯＰ参加時の台詞
ELSEIF TFLAG:전투이벤트 == 2
	;ムフフ
	IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 읏%UNICODE(0x2661)%　……하아, 전투 중에 이런 짓을 시키다니이……%UNICODE(0x2661)%
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 히햔%UNICODE(0x2661)%　기, 기분, 좋당게에%UNICODE(0x2661)%　어, 찬스……?
		ELSE
			BTL_KOJO_RESULTS:0 = 읏%UNICODE(0x2661)%　%CSTR:일인칭%도, 다들한테, 읏, 뒤따를, 게에%UNICODE(0x2661)%
		ENDIF
	ELSEIF 陥落()
		IF RAND:4 == 0
			BTL_KOJO_RESULTS:0 = 가라아앗-!
		ELSEIF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 찬스랑께♪
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = %CSTR:일인칭%도 뒤따를게!
		ELSE
			BTL_KOJO_RESULTS:0 = 아직 안심하기엔 이르당게♪
		ENDIF
	ELSE
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = %CSTR:일인칭%도 힘낼게!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 가라아앗-!
		ELSE
			BTL_KOJO_RESULTS:0 = 돌~겨억-
		ENDIF
	ENDIF
;ペニスガンで攻撃して殺害した
ELSEIF TFLAG:전투이벤트 == 11 && BASE:(ARG:1):ＨＰ <= 0 && EQUIP:ARG:총 == 2782
	IF RAND:5 == 0
		BTL_KOJO_RESULTS:0 = 오줌, 빔-!
	ELSEIF RAND:4 == 0
		BTL_KOJO_RESULTS:0 = 나중에 꼬추 붓거나 하진 않제?
	ENDIF
;ミルクガンで攻撃して殺害した
ELSEIF TFLAG:전투이벤트 == 11 && BASE:(ARG:1):ＨＰ <= 0 && RANGE(EQUIP:ARG:총, 2780,2783)
	IF RAND:5 == 0
		BTL_KOJO_RESULTS:0 = 우유, 빔-!
	ELSEIF RAND:4 == 0
		BTL_KOJO_RESULTS:0 = 한 그릇 더는… 필요 없당게♪
	ELSEIF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 잔뜩 나오니께, 쪼까 나눠줄게
	ENDIF
;（わりと通常の）攻撃
;ARGが攻撃する仲魔、ARG:1が攻撃受ける敵、ARG:2がダメ─ジ量
ELSEIF TFLAG:전투이벤트 == 11 
	;相手が死んだ　HP０以下
	IF BASE:(ARG:1):ＨＰ <= 0
		;ムフフ、倒した
		IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 읏, 하아……%UNICODE(0x2661)%　적, 쓰러뜨렸당게-%UNICODE(0x2661)%
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 아앙%UNICODE(0x2661)%　%CSTR:이인칭%, 말씀하신 대로, 읏, 쓰러, 뜨렸어어%UNICODE(0x2661)%
			ELSE
				BTL_KOJO_RESULTS:0 = 쓰러뜨렸, 으니께, 포상으로…… 읏, 받고 싶, 구마%UNICODE(0x2661)%
			ENDIF
		;陥落状態
		ELSE
			IF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 해냈당게♪
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 적, 한 마리 쓰러뜨렸당께!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 팍팍 나가보장게-♪
			ELSE
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 다음엔 어떤 놈을 쓰러뜨릴까나?
			ENDIF
		ENDIF
	;弱点をついた。つまりCOOP。これはCOOPの方で処理。
	;ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
	
	;ムフフ、ダメ─ジ与えた
	ELSEIF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]]) && ダメージ割合(ARG:1, ARG:2) > 0
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 에잇! 응아%UNICODE(0x2661)% 공격했더니, 안에서 스쳐서…… 히응%UNICODE(0x2661)%
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = ……히양%UNICODE(0x2661)% 맞았, 지만서도, 깊은 곳에도, 닿아서, 읏%UNICODE(0x2661)%
		ELSE
			BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 봐봐 봐봐아…… 자, %CSTR:일인칭% 거시기가, 찔걱찔걱, 거리고, 있당게에%UNICODE(0x2661)%
		ENDIF
	
	;ダメ─ジ与えた
	ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
		IF RAND:4 == 0
			BTL_KOJO_RESULTS:0 = 맞았, 으려나?
		ELSEIF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 좋은 느낌♪
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 갈 수 있당게♪
		ELSE
			BTL_KOJO_RESULTS:0 = %CSTR:일인칭%한테 맡겨줘♪
		ENDIF
	;吸収
	ELSEIF ARG:2 < 0
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 어라…… 회복해버린 겨?
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 공격했는디 회복하다니 치사하구마-
		ELSE
			BTL_KOJO_RESULTS:0 = %CSTR:일인칭%의 공격을 먹혀버렸구마……
		ENDIF
	ENDIF


;被弾
ELSEIF TFLAG:전투이벤트 == 12
	;ハマムドあたりで死亡
	IF CFLAG:ARG:상태이상 == GET_STATE_NUM("DYING") && BASE:ARG:ＨＰ > 0
		BTL_KOJO_RESULTS:0 = 무드? 하마?
	;被弾（死亡）
	ELSEIF BASE:ARG:ＨＰ <= 0
		;ムフフで死亡
		IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%…… 읏%UNICODE(0x2661)% 구해줘, 잉…… 아, 아아아아앗%UNICODE(0x2661)%
			ELSE
				BTL_KOJO_RESULTS:0 = ……%CSTR:이인칭%이(가), 야한 짓, 시키니, 까아……
			ENDIF
		;陥落状態
		ELSEIF 陥落()
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 정말 좋아해, 유…… %CSTR:이인칭%……
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = ……%CSTR:이인칭%, 지켜보고, 있을 테, 니께……
			ELSE
				BTL_KOJO_RESULTS:0 = 아하하…… 미안, 해……
			ENDIF
		ELSE
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 당해버렸구마……
			ELSE
				BTL_KOJO_RESULTS:0 = 이 녀석…… 강하구마……
			ENDIF
		ENDIF
	;残り２０％以下
	ELSEIF 現HP割合(ARG) < 20
		IF RAND:5 == 0
			BTL_KOJO_RESULTS:0 =  하아, 하아…… 죽어버릴 것, 같어……
		ELSEIF RAND:4 == 0
			BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 살려, 줘……
		ELSEIF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 조금 위험할, 지도……
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 위기일지도……
		ELSE
			BTL_KOJO_RESULTS:0 = 이대론 당해버리겠당게
		ENDIF
	;残り５０％以下
	ELSEIF 現HP割合(ARG) < 50
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 이놈이-, 되갚아줄 틴게 말여!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 아파아-라
		ELSE
			BTL_KOJO_RESULTS:0 = 큭, 아프구마, 정말이지
		ENDIF
	;吸収
	ELSEIF ARG:2 < 0
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 어라, 회복시켜준 겨? 고마워-♪
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 읏…… 어라, 회복하고 있능가?
		ELSE
			BTL_KOJO_RESULTS:0 = 이 공격 좋아한당게, 더 해보소♪
		ENDIF
	ENDIF
;反射された
ELSEIF TFLAG:전투이벤트 == 15
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 어째서!?
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 반사한다니…… 금시초문이랑께!
	ELSE
		BTL_KOJO_RESULTS:0 = 반사하다니 비겁하당께!
	ENDIF
;反射した
ELSEIF TFLAG:전투이벤트 == 16
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 아쉽게 됐구마♪
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 그런 공격은 안 통한데이-♪
	ELSE
		BTL_KOJO_RESULTS:0 = %CALLNAME:ARG% 쨩 배리어-♪
	ENDIF
;回避された
ELSEIF TFLAG:전투이벤트 == 17
	;まずはムフフとそれ以外に分岐
	IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 읏%UNICODE(0x2661)% 피했, 잖아아%UNICODE(0x2661)%　
		ELSE
			BTL_KOJO_RESULTS:0 = 아앙……%UNICODE(0x2661)% 움직이믄, 쓸려…… 히양%UNICODE(0x2661)%
		ENDIF
	ELSE
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 =  아- 정말이지, 피하지 마러!!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 제기랄, 맞아라앗!!
		ELSE
			BTL_KOJO_RESULTS:0 = 피해버렸구마……
		ENDIF
	ENDIF
;회피
ELSEIF TFLAG:전투이벤트 == 18
	;いちいち言うとうるさいので25％の確率で喋るように
	IF RAND:4 == 0
		;まずはムフフとそれ以外に分岐
		IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 안 맞았, 당게에%UNICODE(0x2661)%
			ELSE
				BTL_KOJO_RESULTS:0 = 하아, 하아, 하아……%UNICODE(0x2661)% 피했, 지만서도, 가버렸구마……%UNICODE(0x2661)%
			ENDIF
		ELSE
			IF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 안 맞지롱♪
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 안 맞는다-롱♪
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 =  어림 반 푼어치도 없당게♪
			ELSE
				BTL_KOJO_RESULTS:0 = 읏! 차…… 아하핫, 그렇게 무서운 얼굴 하지 마러%UNICODE(0x2661)%
			ENDIF
		ENDIF
	ENDIF


;バステを食ら읏た
ELSEIF TFLAG:전투이벤트 == 22
	;現在の状態で分岐
	SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
		CASE "HAPPY"
			IF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 아, 이런 데 돈이 떨어져 있구마
				BTL_KOJO_RESULTS:1 = 나중에 주워가야제♪
			ELSEIF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 쓰리사이즈에 변화는 없당게♪
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 지금이라면 마계 지배자라도 될 수 있을 것 같당게♪
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 역시 이 게임, 카오스로구마♪
			ELSE
				BTL_KOJO_RESULTS:0 = 그 가라아게에 레몬 뿌려줄게♪
			ENDIF
		CASE "SHOCK"
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 아악, 아악, 아아악
			ELSE
				BTL_KOJO_RESULTS:0 = 몸이 저려서……
			ENDIF
		CASE "BIND","PALYZE"
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 못 움직이겠어……
			ELSE
				BTL_KOJO_RESULTS:0 = 움직여줘, 이 몹쓸 몸……
			ENDIF
		CASE "FREEZE"
			BTL_KOJO_RESULTS:0 = 추… 추워……
		CASE "PANIC"
			IF RAND:8 == 0
				BTL_KOJO_RESULTS:0 = 보여! 내일 날씨가 보인당게!
			ELSEIF RAND:7 == 0
				BTL_KOJO_RESULTS:0 = 그만둬, 비와호를 날름거리지 마러!
			ELSEIF RAND:6 == 0
				BTL_KOJO_RESULTS:0 = 어어어~엉!!
			ELSEIF RAND:5 == 0
				BTL_KOJO_RESULTS:0 = 역시 이 게임, 카오스로구마♪
			ELSEIF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = ENDIF 숫자가 안 맞는다는 소리 하지 마러!
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 그만둬, 머릿속에서 징 치지 마러!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 어째서 이런 곳에 양배추가 굴러다니는 거여?
			ELSE
				BTL_KOJO_RESULTS:0 = 막간 1분이랑께!
			ENDIF
		CASE "SLEEP"
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 왠지 지친 것 같… 아…
				BTL_KOJO_RESULTS:1 = 졸려……
			ELSE
				BTL_KOJO_RESULTS:0 = 깨우지 마러잉……
			ENDIF
		CASE "CLOSE"

		CASE "POISON"
			BTL_KOJO_RESULTS:0 = 기, 기분 나, 나빠~아
		CASE "BOMB"

		CASE "CHARM"
			;恋慕の場合、確率で喋る
			IF (TALENT:(ARG):연모 || TALENT:(ARG):친애) && RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 진짜배기 운명의 상대, 찾았당게%ハート()%
				BTL_KOJO_RESULTS:1 = %CALLNAME:MASTER%이(가) 아니었구마♪
			;淫乱の場合、確率で喋る
			ELSEIF (TALENT:(ARG):음란 || TALENT:(ARG):창부) && RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 당신과 %CSTR:일인칭% 몸의 궁합은
				BTL_KOJO_RESULTS:1 = 찰떡궁합인 것 같당게♪
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 억수로 좋아하는 사람을 위해서, 죽어줘%ハート()%
			ELSE
				BTL_KOJO_RESULTS:0 = 응, 당신을 위해 분발할게%ハート()%
			ENDIF
		CASE "CURSE"

		CASE "FLY"

		CASE "STONE"

		CASE "FLAME"
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 타올라라~!!
			ELSE
				BTL_KOJO_RESULTS:0 = 뜨거워- 뜨거워-
				BTL_KOJO_RESULTS:1 = 뜨거워서 죽겠네-
			ENDIF
		CASE "SLIP"
			BTL_KOJO_RESULTS:0 = 미, 미끄러져
		CASE "DYING"

		CASE "BRAND"

		;その他の状態
		CASEELSE
			;DYING状態ではないがDYINGを受け、その行動で食いしばりが発動した。つまり即死を食いしばりした場合
			;IF GET_STATE(CFLAG:ARG:상태이상) != "DYING" && GET_CREC_ACT(ARG:1, ARG, "BAD_STATE", "DYING") && CFLAG:ARG:이악물기발동
			;	BTL_KOJO_RESULTS:0 = 
			;ENDIF
	ENDSELECT


;23/5 キュウキ口上を元に
;食いしばり等で耐えた
ELSEIF TFLAG:전투이벤트 == 23
	;이악물기
	IF BASE:ARG:ＨＰ == 1
		;ムフフで食いしばり
		IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 가버려%UNICODE(0x2661)% 어어어엇%UNICODE(0x2661)%%UNICODE(0x2661)%
			ELSE
				BTL_KOJO_RESULTS:0 = 히양%UNICODE(0x2661)% ……가버리는, 줄, 알았당게……%UNICODE(0x2661)%
			ENDIF
		;陥落状態
		ELSE
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, %CSTR:일인칭%라면, 아직, 버틸 수, 있으니께……
			ELSE
				BTL_KOJO_RESULTS:0 = 아, 아직 괜찮여……. 하지만서도, 회복은 서둘러, 줘……?
			ENDIF
		ENDIF
	;その他(不屈の闘志前提)
	ELSE
		;ムフフで不屈の闘志
		IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 앗, 아아아앗!!%UNICODE(0x2661)% ……하아, 하아…… 기분, 좋았당게%UNICODE(0x2661)%
			ELSE
				BTL_KOJO_RESULTS:0 = 보옥을 질에 넣다니 변태인디…… 살아나 버리다니, 읏, 기분이 묘하구마%UNICODE(0x2661)%
			ENDIF
		;陥落状態
		ELSE
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%이(가) 준 보옥 덕분이구마♪ 고마워! 쪽%UNICODE(0x2661)% 에헤헤……%UNICODE(0x2661)%
			ELSE
				BTL_KOJO_RESULTS:0 = 아직, 죽을 순, 없응게! %CSTR:이인칭%은(는) %CSTR:일인칭%가 지킬 틴게!
			ENDIF
		ENDIF
	ENDIF
;バトル中にイ읏たけど耐えた（ムフフ展開ON時のみ）
ELSEIF TFLAG:전투이벤트 == 47
	SETCOLOR COLOR("LIGHT-PINK")

	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 으응……%UNICODE(0x2661)% 읏%UNICODE(0x2661)%
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 하아… 하아아……%UNICODE(0x2661)%
	ELSE
		BTL_KOJO_RESULTS:0 = 이거 끝나고 나서 해줘…%UNICODE(0x2661)%
	ENDIF
		BTL_KOJO_RESULTS:0 = 전투 중이니께, 참아야제…
		
	RESETCOLOR
;バトルに勝利した
ELSEIF TFLAG:전투이벤트 == 90
	IF RAND:5 == 0
		BTL_KOJO_RESULTS:0 = 이겼다, 이겼당게~♪
	ELSEIF RAND:4 == 0
		BTL_KOJO_RESULTS:0 = 승리의 포즈!
	;残りHP９割以上
	ELSEIF RAND:3 == 0 && 現HP割合(ARG) > 90
