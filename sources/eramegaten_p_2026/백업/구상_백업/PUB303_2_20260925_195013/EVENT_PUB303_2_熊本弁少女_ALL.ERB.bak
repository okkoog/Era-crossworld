					ELSE
						PRINTFORMW 「성격 급하당께 %CSTR:이인칭%은, 꺄하하. ……자, 이걸로 됐-어?」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) 웃으며 다리를 벌리고, 스스로 속옷을 옆으로 젖혔다.
					PRINTFORMW 흠뻑 젖은 밀호에, %CALLNAME:MASTER%은(는) 단숨에 페니스를 찔러 넣었다.
					PRINTFORMW 「히야앙! 아, 앙! 격렬하당께에! 앙, 아! 아! 좋아! 히야앙!」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORML 「이젠 못 참겠당께! 얼른! 얼른! 섹스! 섹스하자!!」
						PRINTFORMW %CALLNAME%은(는) 속옷을 젖혀 은밀한 곳을 드러내 보였다.
						PRINTFORMW 「봐봐, 이렇게 뻐끔거리며 자지를 원하고 있당께. 얼른~ 범해주시게에-」
						PRINTFORMW 「아하앗♪ 응, 으응아아! 자지 왔다아%ハート()% 응, 앙, 앙, 섹스 기분 억수로 좋아아%ハート()%」
					ELSE
						PRINTFORMW 「평소보다 자지, 더 딱딱해지지 않았어?」
						PRINTFORM 「
						;全身服なのか下着なのか
						IF TEQUIP:속옷（하）
							CALL CLOTHES_NAME,6,TARGET
						ELSE
							CALL CLOTHES_NAME,7,TARGET
						ENDIF
						PRINTFORMW 「안 벗은 쪽이 더 좋은겨?」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「꺄~, 습격당한당~」
					PRINTFORMW 「경찰 아저~씨, 도와줘요~」
					PRINTFORML 얼빠진 비명을 지르는 %CALLNAME%의 얼굴에는
					PRINTFORMW 앞으로 벌어질 행위에 대한 기대에 찬 표정이 떠올라 있었다
				ENDIF
				CFLAG:420 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:420 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORML 「기다려, 지금 벗을 테니께」
					PRINTFORMW 당황하는 %CALLNAME%을(를) 무시하고 %CALLNAME:MASTER%은(는) 단숨에 페니스를 찔러 넣었다.
				ELSE
					PRINTFORM 「적어도 안 더러워지게 
					;全身服なのか下着なのか
					IF TEQUIP:속옷（하）
						CALL CLOTHES_NAME,6,TARGET
					ELSE
						CALL CLOTHES_NAME,7,TARGET
					ENDIF
					PRINTFORML 은(는) 벗게 해줘…」
					PRINTFORMW %CALLNAME%의 간청을 무시하고 %CALLNAME:MASTER%은(는) 단숨에 페니스를 찔러 넣었다.
				ENDIF
				CFLAG:420 = 3
			;それ以外
			ELSEIF CFLAG:420 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「싫어, 억지로라니 싫당께-」
				ELSE
					PRINTFORM 「
					;全身服なのか下着なのか
					IF TEQUIP:속옷（하）
						CALL CLOTHES_NAME,6,TARGET
					ELSE
						CALL CLOTHES_NAME,7,TARGET
					ENDIF
					PRINTFORMW 이(가) 못 쓰게 되어버리니께, 그건 안 된당께!」
				ENDIF
				CFLAG:420 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;73,속옷비켜삽입애널
;-------------------------------------------------
	CASE 73
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:421 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:421 < 4 || FLAG:7 == 2)
				PRINTFORMW 「아직 안 벗었당께?」
				PRINTFORMW 「에, 이대로? %CSTR:이인칭%도 참, 너무 서두른당께-」
				PRINTFORMW %CALLNAME%은(는) 웃으면서 다리를 벌렸다. %CALLNAME:MASTER%은(는) 속옷을 옆으로 젖히고, 페니스를 국문에 삽입했다.
				PRINTFORMW 「응앗! 딱딱하고, 뜨거워… 아, 앙, 앙! 히양!」
			ELSE
				PRINTFORML 「싫어!」
				PRINTFORM 
				;全身服なのか下着なのか
				IF TEQUIP:속옷（하）
					CALL CLOTHES_NAME,6,TARGET
				ELSE
					CALL CLOTHES_NAME,7,TARGET
				ENDIF
				PRINTFORMW 이(가) 더러워져 버린당께!」
				PRINTFORMW %CALLNAME:MASTER%은(는) 짓궂게 『무엇으로』 더러워지는지 말하면 멈춰주겠다고 해보았다.
				PRINTFORML 「에…… 저~기이…」
				PRINTFORMW 말을 얼버무리는 %CALLNAME%에게 %CALLNAME:MASTER%은(는) 단숨에 페니스를 찔러 넣었다.
			ENDIF
			CFLAG:421 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:421 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF TALENT:170
						PRINTFORMW 「에헤헤-, 이거, 변태 씨가 돌발적으로 불타올랐을 때 사랑 나누기구먼-」
					ELSE
						PRINTFORMW 「아직 안 벗었는데도, 성격 급하당께 %CSTR:이인칭%은, 꺄하하. ……자, 이걸로 됐-어?」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) 웃으며, 스스로 속옷을 크게 옆으로 젖혔다.
					PRINTFORMW 좁은 애널을, %CALLNAME:MASTER%은(는) 단숨에 페니스로 꿰뚫었다.
					PRINTFORMW 「히야앙! 아, 앙! 격렬하당께에! 앙, 아! 아! 좋아! 히야앙!」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORML 「이젠 못 참겠당께! 얼른! 얼른! 엉덩이로 섹스하자!!」
						PRINTFORMW %CALLNAME%은(는) 속옷을 젖혀 국문을 드러내 보였다.
						PRINTFORMW 「봐봐, 이렇게 옴씬거리며 자지를 원하고 있당께. 얼른~ 범해주시게에-」
						PRINTFORML 「아하앗♪ 응, 으응아아! 자지 왔다아%ハート()%」
						PRINTFORMW 「응, 앙, 앙, 엉덩이 섹스 기분 억수로 좋아아%ハート()%」
					ELSE
						PRINTFORMW 「안 벗고 하는 섹스 쪽이 더 좋은겨?」
						PRINTFORMW 「그럼, 새로 사주시게」
						PRINTFORMW 「엄~청 야한 걸로, 알았제%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「꺄~, 엉덩이 찢어져 버린당~」
					PRINTFORMW 「누가 좀 도와줘요~」
					PRINTFORML 얼빠진 비명을 지르는 %CALLNAME%의 얼굴에는
					PRINTFORMW 앞으로 벌어질 행위에 대한 기대에 찬 표정이 떠올라 있었다
				ENDIF
				CFLAG:421 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:421 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORML 「기다려, 지금 벗을 테니께」
					PRINTFORMW 당황하는 %CALLNAME%을(를) 무시하고 %CALLNAME:MASTER%은(는) 단숨에 페니스를 찔러 넣었다.
				ELSE
					PRINTFORM 「적어도 안 더러워지게 
					;全身服なのか下着なのか
					IF TEQUIP:속옷（하）
						CALL CLOTHES_NAME,6,TARGET
					ELSE
						CALL CLOTHES_NAME,7,TARGET
					ENDIF
					PRINTFORML 은(는) 벗게 해줘…」
					PRINTFORMW %CALLNAME%의 간청을 무시하고 %CALLNAME:MASTER%은(는) 단숨에 페니스를 찔러 넣었다.
				ENDIF
				CFLAG:421 = 3
			;それ以外
			ELSEIF CFLAG:421 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「싫어, 억지로 엉덩이라니 싫당께-」
				ELSE
					PRINTFORM 「
					;全身服なのか下着なのか
					IF TEQUIP:속옷（하）
						CALL CLOTHES_NAME,6,TARGET
					ELSE
						CALL CLOTHES_NAME,7,TARGET
					ENDIF
						PRINTFORML 이(가) 더러워져 버리니께」
						PRINTFORMW 「정말, 그거 안 된당께!」
				ENDIF
				CFLAG:421 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;74,역강간당한다
;-------------------------------------------------
	CASE 74
		;初めて
		IF CFLAG:438 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				;処女
				IF TALENT:0
					PRINTFORML 「갈게, %CSTR:이인칭%」
					PRINTFORML 「읏」
					CALL TRAIN_MESSAGE
				ELSE
					PRINTFORMW 「%CSTR:일인칭%부터 움직여도 되는 거제」
					PRINTFORML 「조금 익숙하지는 않지만서도…」
					CALL TRAIN_MESSAGE
				ENDIF
			ELSE
				;処女
				IF TALENT:0 
					PRINTFORML 「죄송해요, 그런 거 못 한당께요…」
					PRINTFORML 손을 치켜들며 다시금 %CALLNAME:MASTER%이(가) 명령하자
					PRINTFORM %CALLNAME%은(는)
					CALL TRAIN_MESSAGE
					PRINTFORMW 「큭!」
				ELSE
					PRINTFORMW 「%CSTR:일인칭%이 올라타서 움직이다니 무리!」
					PRINTFORML 손을 치켜들며 다시금 %CALLNAME:MASTER%이(가) 명령하자
					PRINTFORM %CALLNAME%은(는)
					CALL TRAIN_MESSAGE
				ENDIF
			ENDIF
			CFLAG:460 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;「たまには」なので確立を下げる
					IF RAND:6 == 0
						CALL TRAIN_MESSAGE
						IF TALENT:아내
							PRINTFORML 「가끔은 부부가 아닌 섹스, 해볼까나♪」
						ELSE
							PRINTFORML 「가끔은 연인 사이가 아닌 섹스, 해볼까나♪」
						ENDIF
						CALL TRAIN_MESSAGE
					ELSEIF RAND:2 == 0
						CALL TRAIN_MESSAGE
						PRINTFORML 「%CSTR:일인칭%이 위가 되어서」
						PRINTFORMW 「정액 잔뜩 짜내버릴 테니께%ハート()%」
					ELSE
						PRINTFORML 「%CSTR:일인칭%부터 공세에 나설 거라구%ハート()%」
						CALL TRAIN_MESSAGE
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;婦警（警官の服）
					IF TEQUIP:MASTER:81 == 106 && RAND:5 == 0
						CALL TRAIN_MESSAGE
						PRINTFORML 「사정하면 『아동복지법』으로, 즉각 체포랑께♪」
					ELSEIF RAND:4 == 0
						CALL TRAIN_MESSAGE
						PRINTFORMW 「가고 싶어?」
						PRINTFORML 
						PRINTFORMW 「안~ 돼%ハート()% %CSTR:일인칭%이 갈 때까지는 안 보내줄 테니께%ハート()%」
					ELSEIF RAND:3 == 0
						PRINTFORML 「남자가 늑대가 되듯이」
						PRINTFORML 「%CSTR:일인칭%도 암표범이 될 거랑께♪」
					ELSEIF RAND:2 == 0
						PRINTFORML 「정액 전부 다 쥐어짜 버릴 테니께」
						PRINTFORMW 「울어도 안 봐줄 거라구♪」
						CALL TRAIN_MESSAGE
					ELSE
						PRINTFORML 「에헤헤」
						PRINTFORMW 「잘 먹겠습니~다♪」
						CALL TRAIN_MESSAGE
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						CALL TRAIN_MESSAGE
						PRINTFORMW 「어뗘, 기분 좋아?」
					ELSE
						PRINTFORML 「말한 대로 할 테니께, 똑똑히 지켜봐줘」
						CALL TRAIN_MESSAGE
					ENDIF
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORML 「%CSTR:일인칭%부터 움직이다니…」
					CALL TRAIN_MESSAGE
				ELSE
					CALL TRAIN_MESSAGE
					PRINTFORMW 「이런 자세, 조금 좋을지도~ 싶어서」
				ENDIF
			;それ以外
			ELSEIF FLAG:7 == 2
				PRINTFORMW 「저, 정말로 또 해야만 하는겨?」
				PRINTFORML 다시금 %CALLNAME:MASTER%이(가) 명령하자
				PRINTFORM %CALLNAME%은(는)
				CALL TRAIN_MESSAGE
			ENDIF
		ENDIF

;=================================================
;奉仕系コマンド
;=================================================
;-------------------------------------------------
;80,수음
;-------------------------------------------------
	CASE 80
		CALL TRAIN_MESSAGE
		;「前回コマンドが母乳飲み」「陥落している」場合に、地の文を書き足す事により、疑似授乳手コキになる
		IF PREVCOM == 89 && 陥落() > 0
			PRINTFORM 수유하는 그대로의 자세로
		ENDIF
		;初めて
		IF CFLAG:344 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:344 < 4 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORMW 「손으로 쥐는겨? 이렇게?」
					PRINTFORML 
					PRINTFORML 「그리고, 움직이는겨? 이러… 려나」
				ELSE
					PRINTFORML 「%CSTR:일인칭% 손으로 기분 좋게 해줄게♪」
				ENDIF
				PRINTFORMW %CALLNAME%은(는) 서투른 손놀림으로 %CALLNAME:MASTER%의 페니스를 문지르기 시작했다…
			ELSE
				;ペニスがある場合
				IF HAVE_PENIS(TARGET)
					IF RAND:2 == 0
						PRINTFORML 「다른 사람 자지 만져보는 건 처음이랑께」
					ELSE
						PRINTFORML 「다른 사람 자지는 이렇게 생겼구먼…」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%의 페니스를 빤히 바라보며, 주저주저 손으로 문지르기 시작했다.
				ELSE
					IF RAND:2 == 0
						PRINTFORML 「에? 그걸 손으로 문지르믄 되는겨? 왠지 기분 나쁜디…」
					ELSE
						PRINTFORML 「에? 자지 쥐고 흔들믄 되는겨?」
					ENDIF
					PRINTFORMW \@ TALENT:남자 ? %CALLNAME%은(는) # 만지기는커녕 본 적도 거의 없었으리라. \@페니스를 빤히 바라보며, 주저주저 손으로 문지르기 시작했다.
				ENDIF
			ENDIF
			CFLAG:344 = 1
		;二回目以降
		ELSE
			;수음　→　キス　→　수음　としている効率厨め、これでも食らえ！
			IF PREVCOM:0 == 20 && PREVCOM:1 == 80
				;恋慕で妊娠中
				IF (TALENT:연모 || TALENT:친애) && TALENT:임신
					PRINTFORML 「배에 아기 있으니께 참아주고 있는 거제」
					PRINTFORMW 「그런 점, 억수로 좋아해%ハート(2)%」
				;恋慕、親愛で技巧が高い
				ELSEIF (TALENT:연모 || TALENT:친애) && ABL:기교 > 4
					PRINTFORML 「보지보다 이쪽이 더 기분 좋당께」
					PRINTFORMW 「그라믄, %CSTR:일인칭%의 슈퍼 테크닉, 보여줄 테니께♪」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「%CSTR:이인칭%은 키스하면서 자지 흔들어주는 거 좋아하는 것 같으니께」
					PRINTFORML 「더 키스하면서 흔들어줄게♪」
				;屈服刻印持ちで非処女
				ELSEIF MARK:굴복각인 > 0 && TALENT:처녀 > 0
					PRINTFORML 「보지보다 이쪽이 더 기분 좋당께」
					PRINTFORMW 「이건 이것대로 %CSTR:일인칭% 몸에 매력이 없는 것 같아서 싫지만서도」
				ELSE
					PRINTFORML 「그렇게 키스하면서 자지 흔들어주는 게 좋은겨?」
				ENDIF
				;간호사복
				IF TEQUIP:옷 == 105
					IF RAND:3 == 0
						PRINTFORML 「입원이 길어지믄, 쌓여버리는 법이제」
						PRINTFORMW 「%CSTR:일인칭%이 후련하게 해줄 테니께♪」
					ELSEIF RAND:2 == 0
						PRINTFORML 「정액 검사할 테니께」
						PRINTFORMW 「잔뜩 내보내주시게~♪」
					ELSE
						PRINTFORML 「가슴 빨면서, 자지 훑어져서 기분 좋아지고 있는 사람, 누~굴까%ハート()%」
					ENDIF
			;陥落済み
			ELSEIF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:344 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				ELSEIF TALENT:연모 || TALENT:친애
					;疑似授乳手コキに対応
					IF PREVCOM == 89 && 陥落() > 0
						;助手（奴隷の実子）とプレイ中
						IF ASSI > 0 && ASSIPLAY && CFLAG:ASSI:1560 == NO
							;父親があなたの場合
							IF CFLAG:ASSI:1563 == 4999
								IF RAND:2 == 0
									PRINTFORMW 「부모 자식 셋이 오붓하게 지내는구먼%ハート()%」
								ELSE
									PRINTFORML 「%CSTR:이인칭%, 이 아이는 다 컸는디도 응석받이랑께♪」
									PRINTFORML 「봐봐, 여기도 커져 있구」
									PRINTFORMW %CALLNAME%은(는) 자기 아이의 페니스를 상냥하게 다루고 있다…
								ENDIF
							ELSE
								IF RAND:2 == 0
									PRINTFORMW 「엄마 보지에 넣고 싶은 걸까나?」
									PRINTFORML 「안~ 돼%ハート()% %CSTR:일인칭%의 보지는 %CSTR:이인칭% 전용이니께」
									PRINTFORMW 「엄마 손으로 참으시게%ハート()%」
								ELSE
									PRINTFORML 「다 컸는디도 엄마 가슴이 좋아서」
									PRINTFORMW 「자지도 엄마 손을 좋아하는구먼%ハート()%」
								ENDIF
							ENDIF
						ELSEIF RAND:2 == 0
							PRINTFORMW 「마신 우유만큼, 정액 내보내도 상관없당께%ハート()%」
						ELSE
							PRINTFORML 「우쭈쭈%ハート()%」
							PRINTFORMW 「엄마한테 가~아득 응석 부려도 괜찮다구용-%ハート()%」
						ENDIF
					ELSEIF RAND:2 == 0
						PRINTFORML 「하아, 하아, %CSTR:이인칭%, 기분 좋아? …응, 으응, 아하앙%ハート()%」
					ELSE
						PRINTFORMW 「%CSTR:일인칭% 테크닉으로, 완전 후끈후끈 뜨거워지네%ハート()%」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%의 얼굴을 들여다보며 페니스를 문지르고 있다.
					PRINTFORMW 대답 대신 머리를 쓰다듬어 주자, 눈을 반짝이며 사랑스럽다는 듯 페니스를 쥔 손에 힘을 주었다.
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;疑似授乳手コキに対応
					IF PREVCOM == 89 && 陥落() > 0
						;逆に手扱き授乳プレイが出来る環境の場合
						IF TALENT:PLAYER:모유체질 > 0 && HAVE_PENIS()
							PRINTFORML 「이렇게 기분 좋아보이구선…」
							PRINTFORMW 「다음엔 교대하자구♪」
						ELSEIF RAND:2 == 0
							PRINTFORMW 「%CSTR:일인칭%도 기분 좋으니께, 잔뜩 기분 좋아지시게♪」
						ELSE
							PRINTFORML 「가슴 빨면서, 자지 옴찔옴찔거리구선」
							PRINTFORMW 「귀엽구먼%ハート()%」
						ENDIF
					ELSEIF RAND:3 == 0 && ABL:기교 > 3
						PRINTFORMW 「진심으로 할 테니께」
						PRINTFORML 「정액 텅 비어버려도 난 몰랑께♪」
						PRINTFORMW %CALLNAME%은(는) 손의 움직임에 완급을 조절하며 교묘하게 %CALLNAME:MASTER%을(를) 사정으로 이끌었다
						PRINTFORMW 「자아, 벌써 흠칫흠칫하기 시작했다구♪」
					ELSEIF RAND:2 == 0 && ABL:기교 > 2 && 体格差() > 1
						PRINTFORML 「어라?」
						PRINTFORMW 「%CSTR:일인칭%의 작은 손에 흥분한겨?」
						PRINTFORMW 「못 쓰겠구먼~%ハート()%」
					ELSE
						PRINTFORML 「에헤헤… 맛있어 보이는 자지…… 자- 착하지 착해-♪」
						PRINTFORMW %CALLNAME%은(는) 요염한 손놀림으로 페니스를 향한 봉사를 강화했다.
						PRINTFORMW 「와, 벌써 이렇게 즙이 나오고 있어%ハート()% 더더 기분 좋게 해줄게에… 자아 자아」
						PRINTFORMW 「쌀 때는 꼭 말하시게-? 전부 마셔줄 테니께%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					;疑似授乳手コキに対応
					IF PREVCOM == 89 && 陥落() > 0
						IF RAND:2 == 0
							PRINTFORMW 「%CSTR:일인칭%의 딸딸이랑 가슴, 어느 쪽이 기분 좋은겨?」
						ELSE
							PRINTFORML 「이렇게 가슴 빨리면」
							PRINTFORMW 「기분 좋아서 자지 봉사를 못 해주게 되어버린당께♪」
						ENDIF
					ELSEIF RAND:2 == 0
						PRINTFORML 「어뗘, %CSTR:이인칭% 기분 좋아?」
						PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%을(를) 기쁘게 하고자 열심히 봉사하고 있다
						PRINTFORML 「별로면 말하시게. %CSTR:일인칭% 보지든 엉덩이든 마음대로 해도 되니께
					ELSE
						PRINTFORMW 「저기, 손뿐만 아니라 입 같은 거 쓰믄 안 되는겨?」
						PRINTFORMW 「분명 그쪽이 더 기분 좋을 텐디…」
					ENDIF
				ENDIF
				CFLAG:344 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:344 < 3 || FLAG:7 == 2)
				PRINTFORMW 「응, 하아… 이 냄새 좋을지도… 저기, 핥아도 돼?」
				PRINTFORMW %CALLNAME%은(는) 얼굴을 붉히며 페니스를 일심불란하게 문질러댔다.
				CFLAG:344 = 3
			;それ以外
			ELSEIF CFLAG:344 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「응, 으응, 으음… 이러믄 되는겨… 잘 모르겠구먼」
				ELSE
					PRINTFORMW 「저기-, 팔 아프니께 이제 끝내도 돼?」
				ENDIF
				CFLAG:344 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;81,펠라치오
;-------------------------------------------------
	CASE 81
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:345 == 0
			;フェラ経験が無い
			IF EXP:22 == 0
				;正しいセ읏クスを知らない
				IF EXP:성교경험 == 0 && ABL:종족 == 0
					;陥落済み
					IF (TALENT:연모 || TALENT:친애) && FLAG:7 == 2
						IF TALENT:아내
							PRINTFORML 「이걸로 아기가 생기는 거제」
							PRINTFORMW 「결혼 다음은 아기니께%ハート()%」
						ELSE
							IF RAND:2 == 0
								PRINTFORML 「이걸로 아기가 생기는 거제」
								PRINTFORMW 「조금 무섭지만서도 힘낼게%ハート()%」
							ELSE
								PRINTFORMW 「반 애들한테 『섹스해버렸당%ハート()%』이라고 다음에 자랑해야지♪」
							ENDIF
						ENDIF
					ELSEIF (TALENT:음란 || TALENT:창부) && FLAG:7 == 2
						PRINTFORMW 「어뗘? 기분 좋아?」
						IF RAND:2 == 0
							PRINTFORML 「이걸로 아기 생겨버릴지도 모르지만서도」
							PRINTFORMW 「그러믄 책임지시게♪」
						ELSE
							PRINTFORMW 「이걸로 반 애들한테 『섹스해버렸당%ハート()%』이라고 실컷 자랑할 수 있겠당♪」
						ENDIF
					ELSEIF (TALENT:복종 || TALENT:예속) && FLAG:7 == 2
						PRINTFORMW 「임신해버릴지도 모르지만서도, %CSTR:일인칭%, 힘낼게」
					ELSE
						PRINTFORML 「에, 그런…… 아기 생겨버려……」
						PRINTFORMW 다시금 명하자, %CALLNAME%은(는) 마지못해 페니스를 입에 물었다.
					ENDIF
					PRINTFORML 　
					PRINTFORML 　
					PRINTFORML 「에, 아니었던겨?」
					PRINTFORMW %CALLNAME:PLAYER%은(는) %CALLNAME%에게 올바른 섹스를 가르쳐주었다
					IF HAVE_VAGINA()
						PRINTFORMW 「그렇구먼, 그래서 이쪽에도 구멍이 뚫려있었던 거구먼」
					ELSE
						PRINTFORMW 「자지는 그렇게 쓰는 거구먼, 몰랐당께」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) 자신의 가랑이를 빤히 바라보고 있다
				ELSE
					;陥落済み
					IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:345 < 4 || FLAG:7 == 2)
						PRINTFORML 「…응, 알겠어」
						PRINTFORML 「입에 자지 넣으믄 되는 거제?」
						PRINTFORMW %CALLNAME%은(는) 조심스레 페니스를 입에 머금었다.
					ELSE
						PRINTFORML 「엣, 자지를 입으로!? 싫당께… 안 돼?」
						PRINTFORMW 다시금 명하자, %CALLNAME%은(는) 마지못해 페니스를 입에 물었다.
						PRINTFORMW 「으와, 이상한 맛…」
					ENDIF
				ENDIF
			ELSE
				;ダブルフェラの経験はある
				IF CFLAG:366 == 1
					PRINTFORMW 「혼자서 하는겨?」
					;陥落済み
					IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
						PRINTFORML 「이렇게 해주는 건 처음이구먼♪」
						PRINTFORMW %CALLNAME%은(는) 혀를 내밀어 귀두를 핥아 돌렸다
						PRINTFORMW 「%CSTR:이인칭%의 자지, %CSTR:일인칭%이 독차지하는구먼♪」
					ELSE
						PRINTFORMW 「%CSTR:일인칭% 혼자서 해야만 하는겨?」
						PRINTFORMW 다시금 명하자, %CALLNAME%은(는) 마지못해 페니스를 입에 물었다.
						PRINTFORMW 「역시 이상한 맛이여…」
					ENDIF
				ELSE
					;陥落済み
					IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:345 < 4 || FLAG:7 == 2)
						PRINTFORML 「이렇게 해주는 건 처음이구먼♪」
						PRINTFORMW %CALLNAME%은(는) 혀를 내밀어 귀두를 핥아 돌렸다
						PRINTFORML 「어뗘? 흥분되지%ハート()%」
						PRINTFORMW %CALLNAME%의 얼굴은 콧김이 귀두에 느껴질 정도로 가까워져 있다
						PRINTFORMW 「첫 회니께 서비스랑께♪」
					ELSE
						PRINTFORML 「입으로 물라고? 괴로우니께 싫은디…」
						PRINTFORMW 다시금 명하자, %CALLNAME%은(는) 마지못해 페니스를 입에 물었다.
						PRINTFORMW 「역시 이상한 맛이여…」
					ENDIF
				ENDIF
			ENDIF
			CFLAG:345 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:345 < 4 || FLAG:7 == 2)
				;お風呂場ならプレイ内容も変わる
				IF (TALENT:연모 || TALENT:친애 || TALENT:음란 || TALENT:창부) && TEQUIP:31
					IF RAND:2 == 0
						PRINTFORMW 「자지 호수에서 『마왕 마라』를 발견했당께」
						PRINTFORML 「지금부터 퇴치하겠습니~다♪」
					ELSE
						PRINTFORML 「『잠망경 플레이』랑께%ハート()%」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) 수면에 떠오른 %CALLNAME:PLAYER%의 가랑이에 달라붙어 있다
				;恋慕、親愛
				ELSEIF TALENT:연모 || TALENT:친애
					PRINTFORML 「낼름… 기분 좋게 해줄게… 읍, 으응, 츄르르르」
					;前回がアナルプレイの場合
					IF PREVCOM == 62 || PREVCOM == 63 || PREVCOM == 67 || PREVCOM ==70 || PREVCOM == 71 || PREVCOM == 73
						PRINTFORMW 자신의 장액으로 얼룩진 페니스를 주저 없이 핥는 %CALLNAME%
						PRINTFORML 「방금 전까지 이게 %CSTR:일인칭% 엉덩이에 들어가 있었던 거제%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 페니스에 키스를 하고는 봉사를 재개했다
					ELSEIF 体格差() > 0
						PRINTFORMW %CALLNAME%은(는) 사랑스럽다는 듯 작은 입 전체로 귀두를 가득 머금고는, 기둥을 손으로 문지르기 시작했다.
						PRINTFORMW 힐끔힐끔 이쪽을 올려다보며 봉사하는 %CALLNAME%의 모습에, %CALLNAME:MASTER%도 목구멍을 범하듯 허리를 움직이기 시작했다.
					ELSE
						PRINTFORMW %CALLNAME%은(는) 사랑스럽다는 듯 입 전체로 페니스를 가득 머금었다.
						PRINTFORMW 힐끔힐끔 이쪽을 올려다보며 봉사하는 %CALLNAME%의 모습에, %CALLNAME:MASTER%도 입을 범하듯 허리를 움직이기 시작했다.
					ENDIF
					PRINTFORMW 「읍! 으응, 응!」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;前回がアナルプレイの場合
					IF PREVCOM == 62 || PREVCOM == 63 || PREVCOM == 67 || PREVCOM ==70 || PREVCOM == 71 || PREVCOM == 73
						PRINTFORML 「엉덩이, 기분 좋았당께♪」
						PRINTFORMW 자신의 장액으로 얼룩진 페니스를 주저 없이 핥는 %CALLNAME%
						PRINTFORMW 「다음엔 어느 구멍으로 할겨?」
					ELSEIF RAND:2 == 0
						PRINTFORML 「가~득 나오게 해줄게. %CSTR:일인칭%의 입보지 기대하시게♪」
						PRINTFORMW 음비한 물소리를 울리며, %CALLNAME%은(는) 목구멍 깊숙이 페니스를 끌어들였다.
						PRINTFORMW 「읍, 으음, 츄르릅… 낼름낼름, 얼른 하얀 거 내보내줘… 먹여주시게에%ハート()%」
						PRINTFORMW 요염하게 치켜뜬 눈을 보내며, %CALLNAME%은(는) 다시금 격렬히 봉사하기 시작했다.
					ELSE
						PRINTFORML 「맛있는 정액, 가~득 내보내주시게♪」
						PRINTFORMW 귀두 끝을 핥더니, %CALLNAME%은(는) 일부러 큰 소리를 내며 페니스를 삼켜나갔다.
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					;前回がアナルプレイの場合
					IF PREVCOM == 62 || PREVCOM == 63 || PREVCOM == 67 || PREVCOM ==70 || PREVCOM == 71 || PREVCOM == 73
						PRINTFORMW 「응, 단디 깨끗하게 해줄게」
						PRINTFORMW %CALLNAME%은(는) 조금 전까지 자신의 애널에 들어가 있던 페니스를 정성스레 혀로 청소하고 있다
						PRINTFORMW 「그러믄 더 이것저것 해줄겨?」
					ELSEIF RAND:2 == 0
						PRINTFORML 「농후한 치구, 주면 안 돼♪」
					ELSE
						PRINTFORMW 「읏, 츕… 츱, 츄릅」
						PRINTFORMW 「푸하, %CSTR:이인칭% 기분 좋아? 우후후, 더 기분 좋게 해줄게%ハート()%」
					ENDIF
				ENDIF
				CFLAG:345 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:345 < 3 || FLAG:7 == 2)
				PRINTFORML 「응, 응, 쪽, 츄… 응, 으응하아」
				;前回がアナルプレイの場合
				IF PREVCOM == 62 || PREVCOM == 63 || PREVCOM == 67 || PREVCOM ==70 || PREVCOM == 71 || PREVCOM == 73
					IF RAND:2 == 0
						PRINTFORMW (방금 전까지 이게 엉덩이에 들어가 있었던 거제……)
					ELSE
						PRINTFORMW (엉덩이로 한 다음인디도 아무렇지 않게 핥을 수 있게 되어버렸구먼……)
					ENDIF
					IF RAND:2 == 0
						PRINTFORMW %CALLNAME%은(는) 작은 입을 열심히 놀리며 페니스에 봉사하고 있다
					ELSE
						PRINTFORMW 쿠퍼액을 핥아내며, %CALLNAME%은(는) 옴질옴질 안쪽 허벅지를 비벼댔다.
					ENDIF
				ELSEIF RAND:2 == 0
					PRINTFORMW %CALLNAME%은(는) 작은 입을 열심히 놀리며 페니스에 봉사했다.
					PRINTFORMW 쿠퍼액을 핥아내며, %CALLNAME%은(는) 옴질옴질 안쪽 허벅지를 비벼댔다.
				ELSE
					PRINTFORMW (자지 핥거나 하는 거에 익숙해져 버렸구먼…)
					PRINTFORMW %CALLNAME%은(는) 작은 입을 열심히 놀리며 페니스에 봉사하고 있다…
				ENDIF
				CFLAG:345 = 3
			;それ以外
			ELSEIF CFLAG:345 < 2 || FLAG:7 == 2
				;前回がアナルプレイの場合
				IF PREVCOM == 62 || PREVCOM == 63 || PREVCOM == 67 || PREVCOM ==70 || PREVCOM == 71 || PREVCOM == 73
					IF RAND:2 == 0
						PRINTFORML 「방금 전까지 엉덩이에 넣고 있었지만서도……」
					ELSE
						PRINTFORML 「싫은 맛이 나……」
					ENDIF
				ELSEIF RAND:2 == 0
					PRINTFORMW 「으으-… 알겠당께-… 하믄 되는 거제?」
				ELSE
					PRINTFORMW 「기분 나쁘고, 냄새나서 좋아하지도 않는디이…」
					PRINTFORM 불평을 늘어놓는 %CALLNAME%의 눈앞에 페니스를 들이밀자,
				ENDIF
				IF RAND:2 == 0
					PRINTFORMW 얼굴을 찌푸리며 %CALLNAME%은(는) 페니스에 입을 맞추고, 어색하게 혀를 놀리기 시작했다.
				ELSE
					PRINTFORMW %CALLNAME%은(는) 눈물을 글썽이며 싫은 표정을 지으면서도 봉사를 계속하고 있다
				ENDIF
				CFLAG:345 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;82,파이즈리
;-------------------------------------------------
	CASE 82
		;初めて
		IF CFLAG:346 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:346 < 4 || FLAG:7 == 2)
				;貧乳もしくは絶壁
				IF TALENT:빈유 == 1 || TALENT:절벽 == 1
					PRINTFORMW 「으~음, 어렵지만서도 해볼게」
					PRINTFORM %CALLNAME%은(는) 자신의 납작한 가슴을 바라보더니
				;「연모」or「친애」でお읏ぱいがでかい場合
				ELSEIF BUST() > 3 && (TALENT:연모 || TALENT:친애)
					IF RAND:2 == 0
						PRINTFORMW 「반 애들한테 이런저런 말 들었었지만서도, 커다란 가슴은 이~런 짓을 위한 거였구먼%ハート()%」
					ELSE
						PRINTFORML 「%CSTR:일인칭%의 큼직한 가슴으로 %CALLNAME:MASTER%의 자지 끼우믄 되는 거제」
					ENDIF
				ELSE
					PRINTFORMW 「응, 해볼게」
				ENDIF
				CALL TRAIN_MESSAGE
			ELSE
				;貧乳もしくは絶壁
				IF BUST() < 3
					PRINTFORMW 「으~음. 그런 어려운 거…」
					PRINTFORM %CALLNAME%은(는) 자신의 납작한 가슴을 원망스레 바라보더니
					CALL TRAIN_MESSAGE
				ELSE
					CALL TRAIN_MESSAGE
					PRINTFORMW 「엣, 가슴으로? 끼우믄 되는겨…?」
				ENDIF
			ENDIF
			CFLAG:346 = 1
		;二回目以降
		ELSE
			;恋慕系陥落で入浴中の場合はパイズリおちんぽ洗いにするように地の文を弄る
			IF (TALENT:연모 || TALENT:친애) && TEQUIP:31
				PRINTFORM 자신의 가슴에 바디워시를 바르더니
			ENDIF

			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:346 < 4 || FLAG:7 == 2)
				;童貞を殺すセ─タ─で、その上にも下にも何も着けていない場合
				IF CFLAG:346 < 4 && TEQUIP:81 == 130 && TEQUIP:83 == 0 && TEQUIP:85 == 0 && TEQUIP:87 == 0 && TEQUIP:90 == 0
					PRINTFORMW 「그렇구먼, 가슴 쪽 구멍은 이 때문이었던 거구먼♪」
				;恋慕、親愛
				ELSEIF TALENT:연모 || TALENT:친애
					;入浴中
					IF TEQUIP:31
						IF RAND:2 == 0
							PRINTFORMW 「자지 깨끗해졌으려나%ハート()%」
						ELSE
							PRINTFORMW 「미끌미끌한 건 바디워시 때문만은 아니겠제♪」
						ENDIF
					ELSEIF ABL:종족 == 0 && RAND:2 == 0
						PRINTFORMW 「반 남자애들한테 가슴 얘기로 놀림당하지만서도」
						PRINTFORMW 「이런 걸 모르니께 어쩔 수 없구먼%ハート()%」
					ELSE
						PRINTFORML 「%CSTR:이인칭%은 참, 가슴 좋아하는구먼♪ 응? %CSTR:일인칭%은 전혀 상관없당께?」
						PRINTFORMW 사랑스럽다는 듯 가슴으로 페니스를 문지르며, %CALLNAME%은(는) 미소 지었다.
						PRINTFORMW 「그치만 기쁜걸. %CSTR:일인칭% 가슴 좋아해 주는 것도, 기분 좋아져 주는 것도%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 더욱 주무르듯 가슴을 음란하게 비비며, %CALLNAME:MASTER%의 사정을 부추기고 있다……
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORML 「아하아%ハート()% 가슴 보지, 잔뜩 범해줘어%ハート()%」
					PRINTFORMW %CALLNAME%의 가슴을 양옆에서 짓누르고, 난폭하게 허리를 흔들자 %CALLNAME%은(는) 유열에 찬 교성을 내질렀다.
					PRINTFORMW 「앗, 아앙! 좋아! 가슴 보지 기분 억수로 좋아아! 더더 %CSTR:일인칭%의 가슴 써줘어!」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「가슴으로, 가~득, 봉사해 줄게」
					PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%을(를) 치켜뜬 눈으로 바라보며 열심히 봉사하고 있다
				ENDIF
				CFLAG:346 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:346 < 3 || FLAG:7 == 2)
				PRINTFORMW 「응, 하앙… 젖꼭지 스쳐서… 아, 앙…」
				CFLAG:346 = 3
			;それ以外
			ELSEIF CFLAG:346 < 2 || FLAG:7 == 2
				PRINTFORMW 「응, 으응… 자지, 뜨거워…」
				CFLAG:346 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;83,스마타 or 妖精全身ズリ
;-------------------------------------------------
	CASE 83
		;奴隷のサイズが小さいと、コマンド名が"妖精全身ズリ"に変わり地の文も変わる
		CALL TRAIN_MESSAGE
		;全身妖精ズリ
		IF TALENT:소인체형
			;初めて
			IF CFLAG:347 == 0
				;反発もち
				IF MARK:3 >= 1
					PRINTFORMW 「자지를?」
					IF TALENT:처녀
						PRINTFORMW 「올라타서 움직이라니, 그런 건 이상하당께!」
						PRINTFORMW %CALLNAME:MASTER%에게 명령을 거부했을 때 어떻게 할지 설명했다
						PRINTFORML 
						PRINTFORMW 「알겠어… 할게……」
					ELSE
						PRINTFORMW 「…보지에 넣히는 것보단 낫겠지만서도…」
					ENDIF
				ELSE
					IF TALENT:처녀
						PRINTFORMW 「자지에 올라타서, 이렇… 게 움직이는겨?」
					ELSE
						PRINTFORMW 「보지에 안 넣어도 되는겨?」
					ENDIF
				ENDIF
				CFLAG:347 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:347 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						;（穴開き）スク水ロ─ションプレイ
						IF RAND:2 == 0 && (TEQUIP:전신속옷 == 710 || TEQUIP:전신속옷 == 711) && CFLAG:800 == 1
							PRINTFORML 「로션 발랐는디, 수영복이 쓸려서 안 아파?」
							PRINTFORMW %CALLNAME%은(는) 이쪽을 걱정하여 느릿하게 움직였으나, 문제없음을 알리자 허리 움직임을 빠르게 했다
							PRINTFORML  
							PRINTFORML 「로션 발랐으니께, 평소보다 야한 소리가 나네♪」
							PRINTFORMW 「봐봐, %CSTR:이인칭%도 흥분되기 시작했제%ハート()%」
						ELSE
							PRINTFORMW 「아하♪ 눈앞에도 가랑이에도 자지가 있어서… 왠지 귀여워%ハート()%」
							PRINTFORMW 「아, 앙… 앙, 앗… 가랑이 기분 억수로 좋아아……」
							PRINTFORMW 「올라타 있는 것만으론 애달프당께…… 이 자지로 잔뜩 사랑해줬으면 좋겠어어…%ハート()%」
						ENDIF
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						;（穴開き）スク水ロ─ションプレイ
						IF RAND:4 == 0 && (TEQUIP:전신속옷 == 710 || TEQUIP:전신속옷 == 711) && CFLAG:800 == 1
							PRINTFORML 「자아 자아, 수영복 감촉이 좋제♪」
							PRINTFORMW 로션투성이가 된 %CALLNAME%은(는) 기둥 위에서 온몸을 움직였다
							PRINTFORML 「자지 위에서 움직여 달라니, 그런 변태 같은 소리」
							PRINTFORMW 「다른 애한테 말했다간, 바로 경찰 불려버리는걸♪」
						ELSEIF RAND:3 == 0
							PRINTFORML 「아, 하앙…」
							PRINTFORML 「자지 냄새 맡으면서 보지 비벼대는 거 기분 좋아…」
							PRINTFORMW %CALLNAME%은(는) 클리토리스를 짓이기듯 허리를 흔들고 있다.
						ELSEIF RAND:2 == 0
							PRINTFORMW 「그대로 %CSTR:일인칭% 보지에 커다란 자지 넣어버려도 된당께」
							PRINTFORML 「자아… 얼른…… 얼른%ハート()%」
							PRINTFORMW 클리토리스를 짓이기듯 허리를 흔들던 %CALLNAME%은(는), 아쉬운 듯 %CALLNAME:MASTER%을(를) 올려다보았다.
						ELSE
							PRINTFORMW 「이 커다란 자지로 %CSTR:일인칭% 보지 속을 가득 채워버려도 된당께%ハート()%」
							PRINTFORML 「자아… 이걸로 넣기 쉬워졌제♪」
							PRINTFORMW %CALLNAME%은(는) 틈새에서 넘쳐흐르는 애액을 %CALLNAME:MASTER%의 페니스에 듬뿍 펴바르고 있다.
						ENDIF
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						IF RAND:2 == 0
							PRINTFORML 「자지가 커도 %CSTR:일인칭%은 괜찮당께」
							PRINTFORMW 클리토리스를 페니스에 문지르듯 허리를 흔들던 %CALLNAME%이(가) 참지 못하고 물어왔다
						ELSE
							PRINTFORML 「자지… %CSTR:일인칭% 보지에…… 자지 주면 안 돼…」
							PRINTFORML 「커다란 자지로 보지에 잔뜩 벌 내려줘……%ハート()%」
							PRINTFORMW 점차 참을 수 없게 된 %CALLNAME%이(가) 아양을 떨어왔다
						ENDIF
						PRINTFORMW 하지만, %CALLNAME:MASTER%은(는) 그대로 계속하라고 명령했다.
						PRINTFORMW 「더 기분 좋아지고 싶은디…」
						PRINTFORMW 「%CSTR:이인칭% 심술쟁이」
					ENDIF
					CFLAG:347 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:347 < 3 || FLAG:7 == 2)
					IF RAND:2 == 0
						PRINTFORM 「응, 으응… 자지 비벼져서…
					ELSE
						PRINTFORM 「콩알에… 자지가 닿아서……
					ENDIF
					PRINTFORMW 하, 앙, 앙… 히양!」
					CFLAG:347 = 3
				;それ以外
				ELSEIF CFLAG:347 < 2 || FLAG:7 == 2
					PRINTFORMW 「자지에 올라타서… 이게 재밌는겨?」
					CFLAG:347 = 2
				ENDIF
			ENDIF
		;스마타
		ELSE
			;初めて
			IF CFLAG:347 == 0
				;反発もち
				IF MARK:3 >= 1
					PRINTFORMW 「자지를?」
					IF TALENT:처녀
						PRINTFORMW 「그런 거 끼웠다간 병에 걸려버린당께」
						PRINTFORMW %CALLNAME:MASTER%은(는) 거부했을 때 어떻게 할지 설명했다
						PRINTFORML 
						PRINTFORMW 「알겠어… 할게……」
					ELSE
						PRINTFORMW 「…보지에 넣히는 것보단 낫겠지만서도…」
					ENDIF
				ELSE
					IF TALENT:처녀
						PRINTFORMW 「자지를 끼우라고? …이렇게?」
					ELSE
						PRINTFORMW 「보지에 안 넣어도 되는겨?」
					ENDIF
				ENDIF
				CFLAG:347 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:347 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						;（穴開き）スク水ロ─ションプレイ
						IF RAND:2 == 0 && (TEQUIP:전신속옷 == 710 || TEQUIP:전신속옷 == 711) && CFLAG:800 == 1
							PRINTFORML 「로션이랑 %CSTR:일인칭% 애액이랑 쿠퍼액으로 자지 주변이 끈적끈적하당께♪」
							PRINTFORMW 「학교 수영복이라서, %CSTR:이인칭%도 평소보다 흥분했제%ハート()%」
						ELSEIF RAND:2 == 0
							PRINTFORML 「자지가 점점 딱딱해져 오고 있어」
							PRINTFORMW 「항상 뱃속에서 자지가 이렇게 되어있었던 거구먼♪」
							PRINTFORMW 「못 참겠거든 가버리시게」
						ELSE
							PRINTFORMW 「아하♪ 가랑이 사이로 자지 끝이 쏙 나와… 왠지 귀여워%ハート()%」
							PRINTFORMW 「아, 앙… 앙, 앗… 가랑이 기분 좋아아…… 하지만서도, 얼른 넣어줬으면 좋겠네에…」
							PRINTFORMW 「겉만 비비는 건 애달프당께…… 안쪽까지 잔뜩 사랑해줬으면 좋겠어어…%ハート()%」
						ENDIF
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						;（穴開き）スク水ロ─ションプレイ
						IF RAND:3 == 0 && (TEQUIP:전신속옷 == 710 || TEQUIP:전신속옷 == 711) && CFLAG:800 == 1
							PRINTFORML 「자지가 보지에 들어간 것도 아니고」
							PRINTFORMW 「수영복 위에서인디도 흥분한겨?」
							PRINTFORML 
							PRINTFORMW 「그렇게 기분 좋다믄…」
							PRINTFORML 「더 몰아붙여 줄 거라구♪ 으랴으랴%ハート()%」
							PRINTFORMW %CALLNAME%은(는) 허리 움직임을 한층 더 빠르게 했다
						ELSEIF RAND:2 == 0
							PRINTFORML 「아, 하앙… 콩알 기분 좋당께… 앙, 앙… 저기, 얼른 넣어줘어%ハート()%」
							PRINTFORMW 클리토리스를 짓이기듯 허리를 흔들던 %CALLNAME%은(는), 아쉬운 듯 %CALLNAME:MASTER%을(를) 올려다보았다.
						ELSE
							PRINTFORMW 「그대로 %CSTR:일인칭% 보지에 넣어버려도 된당께」
							PRINTFORML 「자아… 얼른…… 얼른%ハート()%」
							PRINTFORMW 클리토리스를 짓이기듯 허리를 흔들던 %CALLNAME%은(는), 아쉬운 듯 %CALLNAME:MASTER%을(를) 올려다보았다.
						ENDIF
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						IF RAND:2 == 0
							PRINTFORML 「저기… 자지 안 넣는겨?」
							PRINTFORMW 클리토리스를 페니스에 문지르듯 허리를 흔들던 %CALLNAME%이(가) 참지 못하고 물어왔다
						ELSE
							PRINTFORML 「자지… %CSTR:일인칭% 보지에…… 자지 주시게%ハート()%」
							PRINTFORML 「나중에 청소도 설거지도 다 할 테니께…… 응……%ハート()%」
							PRINTFORMW 점차 참을 수 없게 된 %CALLNAME%이(가) 아양을 떨어왔다
						ENDIF
						PRINTFORMW 하지만, %CALLNAME:MASTER%은(는) 그대로 계속하라고 명령했다.
						PRINTFORMW 「더 기분 좋아지고 싶은디…」
						PRINTFORMW 「%CSTR:이인칭% 심술쟁이」
					ENDIF
					CFLAG:347 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:347 < 3 || FLAG:7 == 2)
					IF RAND:2 == 0
						PRINTFORM 「응, 으응… 자지 비벼져서…
					ELSE
						PRINTFORM 「콩알에… 자지가 닿아서……
					ENDIF
					PRINTFORMW 하, 앙, 앙… 히양!」
					CFLAG:347 = 3
				;それ以外
				ELSEIF CFLAG:347 < 2 || FLAG:7 == 2
					;（穴開き）スク水ロ─ションプレイ
					IF RAND:3 == 0 && (TEQUIP:전신속옷 == 710 || TEQUIP:전신속옷 == 711) && CFLAG:800 == 1
						PRINTFORML 「응…♪」
						PRINTFORMW 「느, 느끼는 거 아니당께, 간지러울 뿐이랑께」
						PRINTFORMW %CALLNAME:MASTER%은(는) 가랑이가 유독 미끌거린다는 점을 지적했다
						PRINTFORML 
						PRINTFORMW 「그건… 로션! 로션이랑께!」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「자지를 끼우는 거제… 이게 재밌는겨?」
					ELSE
						PRINTFORMW 「끼우기만 하는 거랑께. 그 이상은 화낼 테니께」
					ENDIF
					CFLAG:347 = 2
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;84,거품춤
;-------------------------------------------------
	CASE 84
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:348 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:348 < 4 || FLAG:7 == 2)
				PRINTFORMW 「처음이라 잘 못 할지도… 에잇%ハート()%」
			ELSE
				PRINTFORMW 「%CSTR:일인칭% 몸을 써서 깨끗하게 하는겨?」
				PRINTFORMW 「%CSTR:일인칭%, 수세미가 아닌디…」
			ENDIF
			CFLAG:348 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:348 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF TALENT:아내
						PRINTFORMW 「서방님 뒷바라지는 색시의 일이니께. 에헤헤, 기쁘구먼♪」
						PRINTFORMW 「자, 깨끗해졌당께. 그러믄 다음엔 기분 좋게 해줄게」
						PRINTFORMW 「정액 잔뜩 내보내서 더러워져도 다시 깨끗하게 해줄 테니께%ハート()%」
					ELSE
						PRINTFORMW 「으영, 차, 으영, 찻… 이거 제법 힘들구먼」
						PRINTFORMW 「하지만서도 %CSTR:이인칭% 몸을 씻겨주다니, 왠지 신혼부부가 된 것 같네%ハート()%」
						PRINTFORMW 「정액 나와버릴 것 같어? 큭큭, %CSTR:일인칭%은 그냥 깨끗하게 해주고 있을 뿐인디, %CSTR:이인칭% 음란해」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF EXP:매춘경험 >= 30 & RAND:2 == 0
						IF RAND:2 == 0
							PRINTFORMW 「어뗘, 기분 좋제?」
							PRINTFORMW 「가게에서 배운 거랑께♪」
						ELSE
							PRINTFORMW 「어뗘, 잘하제?」
							PRINTFORMW 「가게에 오는 손님들, 다들 『기분 좋다』고 말해준당께♪」
						ENDIF
					ELSE
						PRINTFORML 「참지 말고 정액 내보내도 된당께」
						PRINTFORMW 「목욕탕이니께 금방 씻어낼 수 있구♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「때는 안 빠지지만서도, 그런 게 중요한 게 아니제?」
					PRINTFORMW 「기분 좋은겨, %CSTR:이인칭%」
				ENDIF
				CFLAG:348 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:348 < 3 || FLAG:7 == 2)
				PRINTFORMW 「보글보글거품~♪」
				CFLAG:348 = 3
			;それ以外
			ELSEIF CFLAG:348 < 2 || FLAG:7 == 2
				PRINTFORMW 「앗, 만지믄 안 된당께!」
				PRINTFORMW 「거품 때문에 미끄러워져 있으니께, 넘어져 버린다구」
				CFLAG:348 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;85,풋잡
