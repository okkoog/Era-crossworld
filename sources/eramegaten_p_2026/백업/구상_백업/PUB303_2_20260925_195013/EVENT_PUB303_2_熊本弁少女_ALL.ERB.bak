				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:417 < 3 || FLAG:7 == 2)
				PRINTFORMW 「으, 응…… 알겠어」
				PRINTFORMW 「%CSTR:일인칭%, 제대로 할게」
			;それ以外
			ELSEIF CFLAG:417 < 2 || FLAG:7 == 2
				PRINTFORMW 「으, 응…… 알겠어」
			ENDIF
			CFLAG:418 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:418 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「또 해야만 해?」
					PRINTFORMW 「응… 할게……」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「두 사람 꼬추, 딱딱하네에♪」
					PRINTFORMW 「제대로 전부 다 마셔줄 테니까 말야%ハート()%」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「전처럼 맛있게 해줄게%ハート()%」
				ENDIF
				CFLAG:418 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:418 < 3 || FLAG:7 == 2)
				PRINTFORMW 「또 하는 거여……」
				PRINTFORMW 「으, 응. 제대로 할게」
				CFLAG:418 = 3
			;それ以外
			ELSEIF CFLAG:418 < 2 || FLAG:7 == 2
				PRINTFORMW 「또 해야 혀?」
				PRINTFORMW 「응……」
				CFLAG:418 = 2
			ENDIF
		ENDIF
