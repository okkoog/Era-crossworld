;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL EVENTTRAIN_PY1_PUB303_2
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL EVENTTRAIN_PY1_PUB303_2
;		RETURN 0
;	ENDIF
;ENDIF
;--------------------------------------------------
;簡易助手口上の発動時に初調教時口上をスキ읏プ（Y1を助手のキャラ番号にする）
;複数人いる際には、SIF NO:ASSI == Y1 || NO:ASSI == Z1と追加していく
;--------------------------------------------------
;IF CFLAG:201 == 0 && ASSI > 0
;	SIF NO:ASSI == Y1
;		CFLAG:201 =1
;ENDIF
;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE

;中田氏フラグ初期化
IF CFLAG:802 < DAY
	CFLAG:802 = 0
ENDIF

;信頼陥落している場合
IF TALENT:신뢰 || TALENT:동료
	;男性器と女性器のペアが出来る場合
	IF (HAVE_PENIS(MASTER) && HAVE_VAGINA()) || (HAVE_PENIS() && HAVE_VAGINA(MASTER))
		PRINTFORML 「%CSTR:일인칭%들, 최강의 파트너니께」
		PRINTFORMW 「둘이서 아기 만들면, 최강의 아기가 나올 거라 생각 안 혀?」
		PRINTFORML 　
		PRINTFORMW 「시험삼아, 해볼까나♪」
	ELSEIF TALENT:처녀
		IF RAND:2 == 0
			PRINTFORML 「%CSTR:이인칭%을 위해서라면, 심장이라도 내바칠 수 있당께」
			PRINTFORML 「첫경험이라도, 바칠 거여♪」
			PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%에게 다리를 크게 벌리고, 무방비한 모습을 드러냈다
			PRINTFORML 「부끄러우니께… 얼른 해줬으면 좋겠구먼…%ハート()%」
		ELSE
			PRINTFORML 「침대 위의 전투는 처음이라서…」
			PRINTFORML 「그… 아프다고들 하던디…」
			PRINTFORMW 「%CSTR:일인칭%, 참아볼 텐게… 살살 해주시게…%ハート()%」
		ENDIF
	ELSEIF EXP:Ａ경험 == 0 && RAND:3 == 0
		PRINTFORMW 「신뢰하는 상대한테는 『등 뒤를 맡겼다』고들 한담서」
		PRINTFORMW 「%CSTR:이인칭%한테라면, 뒤쪽 구멍이라도 맡겨도 된당께♪」
	ELSE
		IF RAND:2 == 0
			PRINTFORML 「서로 무방비하게 알몸을 드러내 보이는…」
			PRINTFORMW 「신뢰의 증표로구먼♪」
		ELSE
			PRINTFORML 「침대 위의 전투는… 그… 처음이니께…」
			PRINTFORMW 「살살 해주시게…%ハート()%」
		ENDIF
	ENDIF
;初調教時
ELSEIF CFLAG:201 == 0 && TALENT:연모 == 0
	PRINTFORMW 「%CSTR:이인칭%, 무슨 볼일인겨?」
	PRINTFORMW 「……어? 조교?」

;実装されたらコメントを外す
	;不思議なダンジョンで拾읏たキャラの場合
;	IF CFLAG:이벤트가입 == 4
;		IF TALENT:겁쟁이 || TALENT:프라이드낮음
;			PRINTFORML …
;			PRINTFORMW 「ごめんなさいごめんなさい」
;			PRINTFORML 「アソコにもどされてアクマあいてに、にげたりかくれたりするのもうイヤです」
;			PRINTFORML 「いたくなければエ읏チなコトしたり」
;			PRINTFORML 「ムチでたたいたりしてもいいからおねがいします」
;			PRINTFORMW %CALLNAME%は素直に調教を受け入れてくれた
;		ELSEIF TALENT:반항적 || TALENT:꿋꿋함 || TALENT:프라이드높음 || TALENT:츤데레
;			PRINTFORML 「ふん、恩を着せておいてチョウキョウとか、や읏ぱりオトナはヒキョウね」
;			PRINTFORMW 強が읏ている%CALLNAME%に卑怯な大人の実力を見せてやろう
;		ELSE
;			IF RAND:3 == 0
;				PRINTFORML 「タダでは助けてくれるハズないとおも읏てたけど……」
;				PRINTFORMW %CALLNAME%은(는) 앞으로 자신에게 벌어질 일을 상상하고 있다
;			ELSEIF RAND:2 == 0
;				PRINTFORML 「や읏ぱりそういうコトするんだ」
;				PRINTFORMW %CALLNAME%은(는) 이쪽을 노려보고 있다
;			ELSE
;				PRINTFORML 「あのままアソコで死んじゃうよりはマシだよね…」
;				PRINTFORMW %CALLNAME%は諦めの表情で調教を受け入れた
;			ENDIF
;		ENDIF
;	ELSEIF TALENT:처녀

	IF TALENT:처녀
		IF TALENT:겁쟁이 || TALENT:프라이드낮음
			PRINTFORML 「잘못했어유 잘못했어유」
			PRINTFORML 「말 잘 들을 텐게 아프게 하지 말아주셔!」
			PRINTFORMW 아무래도 고문으로 착각하고 있는 모양이다
		ELSEIF TALENT:부끄럼쟁이
			PRINTFORMW 앞으로 할 일을 설명하자, %CALLNAME%의 얼굴이 화악 새빨갛게 물들었다
			PRINTFORMW 「무, 무리무리무리무리! 절대 무리!」
			PRINTFORMW 「그런 거 해본 적도 없구먼, 부끄럽단 말이여!」
			SIF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐
				PRINTFORMW 「아니, 다가오지 말어! 안 되는 게 당연하잖여, 변태!」
		ELSEIF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐
			PRINTFORMW 「바, 바바바 바보 아니여!?」
			PRINTFORMW 「%CSTR:일인칭% 같은 애한테 그런 짓을 하다니!」
			PRINTFORMW 「아니 이봐, 다가오지 마~! 변태~!」
		ELSEIF TALENT:소악마
			PRINTFORMW 「애를 납치해 와서 조교라니 구제불능 변태로구먼…」
			PRINTFORMW 「하지만, %CSTR:일인칭%이 귀여우니께 어쩔 수 없긴 혀도 말이여」
			PRINTFORMW 「자, 시작하자구♪」
		ELSE
			PRINTFORMW 「%SUBSTRING(CSTR:일인칭,0,2)%, %CSTR:일인칭%처럼 쪼끄만 애한테 이상한 짓 할라꼬?」
			PRINTFORML （아기라도 생겨버리면 어쩐댜…）
			PRINTFORML （그치만 %CSTR:이인칭%이라면……）
			PRINTFORMW 「이, 이런 거 해본 적 없당께. 모진 짓은, 하지 말아줘」
		ENDIF
	ELSE
		IF TALENT:겁쟁이 || TALENT:프라이드낮음
			PRINTFORML 「잘못했어유 잘못했어유」
			PRINTFORML 「말 잘 들을 텐게 임신만은 제발 봐주셔!」
			PRINTFORMW %CALLNAME%은(는) 즉각 자기가 무슨 일을 당할지 이해한 모양이다
		ELSEIF TALENT:반항적 || TALENT:꿋꿋함 || TALENT:프라이드높음 || TALENT:츤데레
			PRINTFORML 「흥, 애 상대로나 떵떵거리는 참 한심한 어른이구먼」
			PRINTFORMW 허세를 부리고 있는 %CALLNAME%을(를), 어떻게 굴복시켜 줄까
		ELSE
			IF RAND:4 == 0
				PRINTFORML 「공짜로는 안 구해주는 거겠제……」
				PRINTFORMW %CALLNAME%은(는) 앞으로 자신에게 벌어질 일을 상상하고 있다
			ELSEIF RAND:3 == 0
				PRINTFORML 「역시나 그런 짓을 할 셈인겨」
				PRINTFORMW %CALLNAME%은(는) 이쪽을 노려보고 있다
			ELSEIF RAND:2 == 0
				PRINTFORML 「그건 뭐여?」
				PRINTFORML 「『레벨 노가다』 같은 거여?」
				PRINTFORMW 아무래도 게임 따위로 착각하고 있는 모양이다
			ELSE
				PRINTFORML 「%CSTR:일인칭%이랑 야한 짓이 하고 싶은겨?」
				PRINTFORMW %CALLNAME%은(는) 얼굴을 붉히면서, 조금 곤란한 표정으로 미소지었다.
				PRINTFORMW 「어쩔 수 없구먼. ……하게는 해주겄는디, 아프게는 말아줘?」
			ENDIF
		ENDIF
	ENDIF
	CFLAG:201 = 1
	RETURN 0
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	CALL EVENTTRAIN_MESSAGE_CLOTHES
	IF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐
		PRINTFORMW 「으으……」
		PRINTFORMW 「심한 짓 하면 콱 깨물어버릴 거니께!」
	ELSE
		PRINTFORMW 「또 하는겨?」
		PRINTFORMW 「아프게 안 한다믄, 괜찮기는 한디…」
	ENDIF
	CFLAG:201 = 2
	RETURN 0
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	CALL EVENTTRAIN_MESSAGE_CLOTHES
	PRINTFORMW 「%CSTR:이인칭%이랑 있는 거, 싫지는 않당께」
	PRINTFORMW 「그치만, 아프게는 말아줘」
	CFLAG:201 = 3
	RETURN 0
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:연모 == 0 && TALENT:음란 == 0 && TALENT:복종 == 0 && TALENT:친애 == 0 && TALENT:창부 == 0 && TALENT:예속 == 0)
	CALL EVENTTRAIN_MESSAGE_CLOTHES
	PRINTFORMW 「저기, 오늘은 어떤 짓을 해줄겨?」
	PRINTFORMW 「조금뿐이라면… 평소보다 야한 짓을 해도 괜찮겠지……라든가」
	IF TALENT:츤데레
		PRINTFORML 「아, 저기, 오, 오해는 말어」
		PRINTFORMW 「오늘만, 오늘뿐인 거니께!」
		PRINTFORMW 「……지, 진짜라니께!」
	ENDIF
	CFLAG:201 = 4
	RETURN 0
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:연모 || TALENT:음란 || TALENT:복종)
	;연모
	IF TALENT:연모
		;調教せずに恋慕をつけた場合の分岐
		IF CFLAG:미조교함락 == 1
			IF TALENT:소악마
				PRINTFORMW 「흐~응」
				PRINTFORMW 「싸우고 있을 때도, 그런 눈으로 %CSTR:일인칭%을 쳐다보고 있었구먼……」
				PRINTFORML ………
				PRINTFORML ……
				PRINTFORML …
				PRINTFORMW 「좋당께」
				PRINTFORMW 「대신, 다른 애랑 짝짓기하면 안 된데이%ハート()%」
			ELSEIF TALENT:츤데레
				PRINTFORMW 「준비라면 다 됐당께」
				PRINTFORML 「자, 어서 가자구」
				PRINTFORMW 전투 준비가 완벽한 %CALLNAME%에게 앞으로 할 일을 설명했다.
				PRINTFORML 
				PRINTFORML （…어?）
				PRINTFORMW （그, 그거 야한 짓인 거제?）
				PRINTFORMW （그치만, 싸울 때 감싸주기도 했었고）
				PRINTFORMW （%CSTR:이인칭%하고라면…）
				PRINTFORML 
				PRINTFORML 「뭐, 뭐어…」
				PRINTFORML 「싸울 때 감싸주고 그랬응게」
				PRINTFORMW 「이번만은 봐줄 거여」
				PRINTFORML 
				PRINTFORMW 「진짜로 이번뿐이랑께」
			ELSE
				PRINTFORML 「오늘은 뭐랑 싸우는겨, %CSTR:이인칭%?」
				PRINTFORMW %CALLNAME:MASTER%은(는) 방을 찾아온 이유와 앞으로 할 일을 설명했다.
				PRINTFORML  
				PRINTFORML 「그~러니께」
				IF RAND:2 == 0
					PRINTFORMW 「처음 %CSTR:이인칭%이랑 만났을 적엔 『이 사람 괜찮을까나?』 싶었는디」
					PRINTFORMW 「그치만 말이여, 지금은 아니여……」
					PRINTFORML 
					PRINTFORMW 「좋당께, %CSTR:이인칭%%ハート()%」
				ELSE
					PRINTFORMW 「같이 싸우다 봉게, 『앗, 이 사람 억수로 멋질지도』 싶었단 말이여」
					PRINTFORMW 「그랑게 말이여, 뭘 당하든 간에……」
					PRINTFORMW 「좋당께%ハート()%」
				ENDIF
			ENDIF
		ELSE
			PRINTFORML 「아……」
			PRINTFORMW 불러낸 %CALLNAME%의 눈동자가 촉촉히 젖어있다. 아무래도 감정이 고조된 모양이다.
			IF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐
				PRINTFORMW 「아, 앙……」
				PRINTFORMW 「그, %SUBSTRING(CSTR:일인칭,0,2)%, %CSTR:일인칭%, %CSTR:일인칭%은 말이여」
				PRINTFORML  
				PRINTFORML ………
				PRINTFORML ……
				PRINTFORMW 「…어, 어쩔 수 없잖여! 이런저런 꼴을 당했는디도, %CSTR:이인칭%이 좋아져 버렸단 말이여!」
			ELSEIF TALENT:소악마
				IF RAND:3 == 0
					PRINTFORMW 「%CSTR:일인칭%은 말이여, %CSTR:이인칭%을 좋아하게 된 모양이여」
					PRINTFORMW 「그랑게 말이여……」
					IF TALENT:처녀
						PRINTFORMW 「체념하구 %CSTR:일인칭%이랑 짝짓기하자구♪」
					ELSE
						IF EXP:출산경험
							PRINTFORMW 「또, 아기 만들자구%ハート()%」
						ELSE
							PRINTFORMW 「가~아득 짝짓기해서, 둘의 아기 만들자구%ハート()%」
						ENDIF
					ENDIF
				ELSEIF RAND:2 == 0
					PRINTFORML 「애 상대로 흥분해 버리는 %CSTR:이인칭%이지만」
					PRINTFORMW 「특별히 좋아해 줄게%ハート()%」
				ELSE
					PRINTFORMW 「이제부턴 더 야한 짓을 해도 괜찮당께」
					PRINTFORML 
					PRINTFORMW 「어째서냐고?」
					PRINTFORMW 「그거야 말이여……」
					PRINTFORMW 「%CSTR:이인칭%을 너~무나도 좋아하니께 그렇제%ハート()%」
				ENDIF
			ELSE
				;反発刻印LV3からの恋慕
				IF CFLAG:801 == 1
					PRINTFORMW 「전에는 말이여, 얼굴 볼 때마다 『죽어버려!』 싶었는디……」
					PRINTFORMW 「%CSTR:이인칭%을 좋아하게 돼도 괜찮제? …좋아하기만 하는 거라면, 괜찮제?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「지하 감옥에 갇히고 이런저런 일도 많았는디……」
					PRINTFORMW 「%CSTR:이인칭%이랑 만날 수 있었응게 %CSTR:일인칭%은, 참말로 다행이었당께%ハート()%」
				ELSE
					PRINTFORMW 「있잖여… %CSTR:일인칭%, %CSTR:이인칭%이 왠지 억수로 소중해져 버렸구먼」
					PRINTFORMW 「일본 법으로는 아직 결혼 못 한다는 건 알고 있지만서도…」
					PRINTFORMW 「…그치만서도, %CSTR:이인칭%을 좋아하게 돼도 괜찮제? …좋아하기만 하는 거라면, 괜찮제?」
				ENDIF
			ENDIF
		ENDIF
	;음란
	ELSEIF TALENT:음란
		IF RAND:3 == 0
			PRINTFORML 「%CSTR:이인칭%한테 보지를 들킨 때부터」
			PRINTFORMW 「이렇게 될 운명이었던 게로구먼♪」
			PRINTFORMW 「앞으로는 언제든 보고 싶을 때 보여줄 텐게%ハート()%」
		ELSEIF RAND:2 == 0
			PRINTFORML 「야한 짓을 억수로 좋아하는 몸이 되어버렸는디」
			PRINTFORMW 「그렇게 눅눅한 데 처박혀 있는 것보단 백배 낫당께」
			PRINTFORMW 「그랑게, 기분 좋은 짓, 하자구♪」
		ELSE
			PRINTFORMW %CALLNAME%을(를) 불러내자, %CALLNAME:MASTER%의 품으로 와락 뛰어들었다.
			PRINTFORML 
			PRINTFORMW 「기다리고 있었당께. 저기, 얼른 야한 짓 잔뜩 하자구!」
			PRINTFORMW 「섹스가 이렇게나 기분 좋은 거란 건, %CSTR:일인칭%은 몰랐었당께」
			PRINTFORMW 「엄마도 아빠도 맨날 %CSTR:일인칭%을 애 취급만 해싸서, 전연 안 가르쳐줬는걸」
			PRINTFORML 「%CSTR:일인칭%, 더더욱 야한 아이가 될 거랑께」
			PRINTFORMW 「그랑게, 기분 좋은 거 잔뜩 가르쳐주시게」
		ENDIF
	;복종
	ELSEIF TALENT:복종
		IF RAND:3 == 0
			PRINTFORMW 「%CSTR:일인칭%, 억수로 행복하단 걸 깨달았당께」
			PRINTFORMW 「그런 눅눅한 데 계속 있었으면, %CSTR:이인칭%한테 조교도 못 받았을 거 아녀」
			PRINTFORML 「그랑게, 앞으로도 %CSTR:일인칭%의 조교를 부탁드립니데이」
			PRINTFORMW %CALLNAME%은(는) 그 자리에서 넙죽 엎드려 절했다
			PRINTFORML 
			PRINTFORMW 「…방금 걸로 살짝 흥분해 버렸구먼」
			PRINTFORMW 「그랑게…」
			PRINTFORMW 「얼」
			PRINTFORMW 「른」
			PRINTFORMW 「해……」
			PRINTFORMW 「조교해줘♪」
		ELSEIF RAND:2 == 0
			PRINTFORML 「%CSTR:이인칭%……」
			PRINTFORMW 불러낸 %CALLNAME%은(는), 어딘가 멍한 눈으로 연신 가랑이를 비벼대고 있다
			PRINTFORMW 「%CSTR:일인칭%의 몸은, %CSTR:이인칭%의 조교 없이는 못 살게 되어버렸당께」
			PRINTFORMW 「부르기만 해도 왠지 몸이 뜨거워져서, 두근두근거려 버린당께」
			PRINTFORMW 「……이런 야한 %CSTR:일인칭%한테, 잔뜩 야한 벌을 내려주셔. %CSTR:이인칭%」
		ELSE
			PRINTFORMW 「있잖여……」
			PRINTFORML 「%CSTR:일인칭%, %CSTR:이인칭%의 조교 땜에 이상해져 버렸당께」
			PRINTFORMW 불러낸 %CALLNAME%은(는), 어딘가 멍한 눈으로 연신 가랑이를 비벼대고 있다
			PRINTFORMW 「야한 조교 탓에 말이여」
			PRINTFORMW 「%CSTR:이인칭%한테 조교당하는 걸 좋아하는 변태가 되어버렸구먼……」
			PRINTFORML 
			PRINTFORMW 「그랑게 말이여, 앞으로도 잘 부탁헌데이♪」
		ENDIF
	ENDIF
	CFLAG:201 = 5
	RETURN 0
ENDIF

;-------------------------------------------------
;簡易助手口上（Y1を助手のキャラ番号に置換、X1をキャラ番号に変更する) CFLAG203
;掛け合いをするキャラを増やす場合は、構文をコピ─＆ペ─ストをして、CFLAGの数を204、205と増やす
;-------------------------------------------------
;助手の有無をチェ읏ク（いない場合は二回目以降へ飛ぶ）
IF ASSI < 0 
	CALL EVENTTRAIN_SECOND_PUB303_2
;助手
;ELSEIF NO:ASSI == Y1
	;初めて
;	IF CFLAG:203 == 0
		;陥落済み＋陥落時初口上が発生済み
;		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && CFLAG:201 >= 5
;			PRINTFORMW 
		;それ以外
