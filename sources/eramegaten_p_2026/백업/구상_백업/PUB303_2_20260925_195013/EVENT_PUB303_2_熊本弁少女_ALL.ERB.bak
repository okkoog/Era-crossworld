;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;調教後のテキスト
;-------------------------------------------------
;-------------------------------------------------
;処女喪失(処女のみ)
;-------------------------------------------------
IF TFLAG:3 > 0
	CALL PALAM_MESSAGE_C
	;주인에의한처녀상실
	IF TFLAG:20
		;陥落素質チェ읏ク
		IF TALENT:연모 || TALENT:친애
			;反発刻印LV3からん処女喪失
			IF RAND:6 == 0 && CFLAG:801 == 1
				PRINTFORML 「싸우기도 했지만」
				PRINTFORMW 「우리들, 하나가 된 거구먼%ハート()%」
			ELSEIF RAND:5 == 0 && 体格差() > 1
				PRINTFORML 「아하… 기뻐…… %CSTR:이인칭%이 처음을 가져가줘서…」
				PRINTFORMW 침대에 남은 처녀의 흔적을 바라보며, %CALLNAME%은 행복한 표정으로 %CALLNAME:MASTER%을 올려다보았다.
				PRINTFORML 「몸이 반 토막 나는 줄 알았당께…」
				PRINTFORMW 「억수로 아팠지만… 너-무 행복했어%ハート()% 저기 %CSTR:이인칭%, 절대로 떨어지지 마…」
			ELSEIF RAND:4 == 0
				PRINTFORML 「아하… 기뻐…… %CSTR:이인칭%한테 처음을 줄 수 있어서…」
				PRINTFORMW 침대에 남은 처녀의 흔적을 바라보며, %CALLNAME%은 행복한 표정으로 %CALLNAME:MASTER%을 올려다보았다.
				PRINTFORML 「아팠지만…」
				PRINTFORML 「%CSTR:일인칭%, 너~무 행복하당께%ハート()%」
				PRINTFORMW 「반 친구들한테 자랑해야지♪」
			ELSEIF RAND:3 == 0
				PRINTFORMW 「에헤헤…… 처음을, %CSTR:이인칭%한테 바쳐버렸다……%ハート()%」
				PRINTFORMW 「%CSTR:이인칭%은 %CSTR:일인칭%의 처음이니까. 그러니까 %CSTR:일인칭%을 꼭 행복하게 해줘야 한당께-♪」
				PRINTFORML 　
				PRINTFORMW 「책·임, 지라구♪」
			ELSEIF RAND:2 == 0
				PRINTFORML 「아하아… %CSTR:이인칭%한테 처음을 빼앗겨버렸다…%ハート()%」
				PRINTFORMW 가랑이에서 순결의 증거를 흘리며, %CALLNAME%은 기쁜 듯 미소 짓는다.
				PRINTFORML 「이걸로 완전히 %CSTR:일인칭%은 %CSTR:이인칭%의 것이 돼버렸다……」
				PRINTFORMW 「에헤헤, 왠지 기뻐…%ハート()%」
			ELSE
				PRINTFORML 「%CSTR:일인칭%, 아직 어려서 결혼은 못 하지만서도」
				PRINTFORMW 「크면 결혼해주라%ハート()%」
				PRINTFORMW 「절대로, 저-얼대로 약속이랑께%ハート()%」
			ENDIF
		ELSEIF TALENT:음란 || TALENT:창부
			PRINTFORMW 「아핫, 처음을 빼앗겨버렸다」
			IF RAND:3 == 0
				IF ABL:종족 == 0
					PRINTFORML 「이걸로 삿짱한테 바보 취급 안 당하겠네♪」
				ELSE
					PRINTFORML 「인간 상대로 첫 섹스라니 %CSTR:일인칭% 정도려나아♪」
				ENDIF
			ELSEIF RAND:2 == 0
				PRINTFORML 「이걸로 맘껏 할 수 있겠네에♪ 목표는 백인베기!」
			ELSE
				IF TEQUIP:비디오카메라 == 1
					PRINTFORML 「이 비디오, 엄마한테 보여주면 기절초풍하려나♪」
				ELSE
					PRINTFORML 「조금 아팠지만, 기분 좋았당께♪」
				ENDIF
			ENDIF
			PRINTFORMW 가랑이에서 흐르는 순결의 증거를 바라보며, %CALLNAME%은 기쁜 듯 미소 지었다.
		ELSEIF TALENT:복종 || TALENT:예속
			IF RAND:2 == 0
				PRINTFORML 「조금 아팠지만, %CSTR:이인칭%이 기뻐해준다면…」
				PRINTFORMW 「기분 좋았어, %CSTR:이인칭%?」
			ELSE
				PRINTFORML 「%CSTR:일인칭%의 처음을 가져가주셔서 감사합니다」
				PRINTFORMW 「어른 여자로 만들어줘서, %CSTR:일인칭%, 행복하당께」
			ENDIF
		ELSE
			;屈服刻印Lv3
			IF MARK:2 == 3
				IF RAND:2 == 0
					PRINTFORMW 「%CSTR:일인칭%의 처음……」
				ELSE
					PRINTFORMW 「처음을 %CALLNAME:MASTER%한테 빼앗겨버렸다」
					PRINTFORMW 「이젠 안 될지도……」
				ENDIF
				PRINTFORMW 가랑이에서 순결의 증거를 흘리며, %CALLNAME%은 망연자실해하고 있다.
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「거짓말…… %CSTR:일인칭%의 처음이…」
				ELSE
					PRINTFORMW 「이제 집에 보내줘……」
				ENDIF
				PRINTFORMW 가랑이에서 순결의 증거를 흘리며, %CALLNAME%은 눈물을 글썽이고 있다.
			ENDIF
		ENDIF
	;それ以外ん時に処女喪失(主人による道具系調教含む)
	ELSE
		;恋慕、親愛
		IF TALENT:연모 || TALENT:친애
			PRINTFORML 「처음 상대는 %CSTR:이인칭%이라고 정해뒀었지만서도……」
			PRINTFORMW 가랑이에서 순결의 증거를 흘리며, %CALLNAME%은 슬픈 표정을 짓고 있다.
			PRINTFORMW 「그치만 %CSTR:일인칭%, %CSTR:이인칭%을 좋아하니까…」
		;淫乱、娼婦
		ELSEIF TALENT:음란 || TALENT:창부
			PRINTFORMW 「아핫, 처음을 빼앗겨버렸다」
			IF RAND:3 == 0
				PRINTFORML 「이걸로 삿짱한테 바보 취급 안 당하겠네♪」
			ELSEIF RAND:2 == 0
				PRINTFORML 「이걸로 맘껏 할 수 있겠네에♪ 목표는 백인베기!」
			ELSE
				IF TEQUIP:비디오카메라 == 1
					PRINTFORML 「이 비디오, 엄마한테 보여주면 기절초풍하려나♪」
				ELSE
					PRINTFORML 「조금 아팠지만, 기분 좋았당께♪」
				ENDIF
			ENDIF
			PRINTFORMW 가랑이에서 흐르는 순결의 증거를 바라보며, %CALLNAME%은 기쁜 듯 미소 지었다.
		;服従、隷属
		ELSEIF TALENT:복종 || TALENT:예속
			IF RAND:2 == 0
				PRINTFORMW 「조금 아팠지만, %CSTR:이인칭%이 기뻐해준다면…」
				PRINTFORMW 「기분 좋았어, %CSTR:이인칭%?」
			ELSE
				PRINTFORMW 「%CSTR:일인칭%의 처음을 가져가주셔서 감사합니다」
				PRINTFORMW 「어른 여자로 만들어줘서, %CSTR:일인칭%, 행복하당께」
			ENDIF
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3
			IF RAND:2 == 0
				PRINTFORMW 「%CSTR:일인칭%의 처음……」
			ELSE
				PRINTFORMW 「처음을 %CALLNAME:MASTER%한테 빼앗겨버렸다」
				PRINTFORMW 「이젠 안 될지도……」
			ENDIF
			PRINTFORMW 가랑이에서 순결의 증거를 흘리며, %CALLNAME%은 망연자실해하고 있다.
		;それ以外
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「거짓말…… %CSTR:일인칭%의 처음이…」
			ELSE
				PRINTFORMW 「이제 집에 보내줘……」
			ENDIF
			PRINTFORMW 가랑이에서 순결의 증거를 흘리며, %CALLNAME%은 눈물을 글썽이고 있다.
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_D関係（X1をキャラ番号に置換）
;パラメ─タ変化をトリガ─にした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_D_PUB303_2
;助手が調教した時に口上をスキ읏プする（好みに応じて使う、行頭の;を消すとスキ읏プするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボ─ルギャグ着用時には地の文を表示して口上をスキ읏プする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_D
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_D_PY1_PUB303_2
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_D_PY1_PUB303_2
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;パラメ─タ変化時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;初めて潤滑がLV3超えた
;-------------------------------------------------
P = PALAM:4 + UP:4
IF P > PALAMLV:4 && CFLAG:245 == 0
	CALL PALAM_MESSAGE_D
	;ロ─ションを使읏た場合
	IF SELECTCOM == 180
		PRINTFORMW 「응, 아, 야앙… 잔뜩 미끌미끌거려어…… 야하잖아아」
	;それ以外
	ELSE
		IF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐 || MARK:3 == 3
PRINTFORMW 「저, 젖은 거 아니거든! 그건… 땀이랑께! 그래 땀!」
PRINTFORMW 「기분 좋아진 거 아니란 말이여! ……보지 마 바보야아!」
ELSE
PRINTFORMW 「응, 앙… %CSTR:일인칭% 이렇게 젖었어… 기분 좋아… 응, 하앙」
			PRINTFORMW %CALLNAME%은 얼굴을 붉히며 은밀한 곳으로 손을 가져가고 있다.
		ENDIF
	ENDIF
	CFLAG:245 = 1
ENDIF

;-------------------------------------------------
;初めて欲情がLV2超えた
;-------------------------------------------------
P = PALAM:6 + UP:6
IF P > PALAMLV:3 && CFLAG:246 == 0
	CALL PALAM_MESSAGE_D
	;媚薬を使읏た場合
	IF SELECTCOM == 181
		PRINTFORMW 「뭔, 뭔가 이상하당께. 몸이 뜨거워서… 하아…!」
	;それ以外
	ELSE
		IF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐 || MARK:3 == 3
			PRINTFORMW  %CALLNAME%의 얼굴은 발그레 붉어져 있다
			PRINTFORML 「아냐…… 더워서, 빨개진 것뿐이랑께…」
			PRINTFORMW 「두, 두근거리거나 하지 않는당께!」
		ELSE
			PRINTFORMW 「어, 어쩌지. 두근거리기 시작했어…」
		ENDIF
	ENDIF
	CFLAG:246 = 1
ENDIF

;-------------------------------------------------
;初めて屈服がLV3超えた
;-------------------------------------------------
P = PALAM:7 + UP:7
IF P > PALAMLV:3 && CFLAG:247 == 0
	CALL PALAM_MESSAGE_D
	IF RAND:2 == 0
		PRINTFORML （%CSTR:일인칭%, 져버릴지도 몰라……）
	ELSE
		PRINTFORMW （이 사람한테는 거역 못 할지도 몰라……）
	ENDIF
	CFLAG:247 = 1
ENDIF

;-------------------------------------------------
;初めて恭順がLV3超えた
;-------------------------------------------------
P = PALAM:5 + UP:5
IF P > PALAMLV:3 && CFLAG:248 == 0
	CALL PALAM_MESSAGE_D
	;陥落済み
	IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
		IF RAND:2 == 0
			PRINTFORML 「역시 %CSTR:이인칭%이네에♪」
		ELSE
			PRINTFORMW 「다시 한번 말할게」
			PRINTFORMW 「%CSTR:이인칭%, 억수로 좋아해%ハート()%」
		ENDIF
	;それ以外
	ELSE
		PRINTFORML （이 기분 좋은 거… 뭐지…?）
	ENDIF
	CFLAG:248 = 1
ENDIF

;-------------------------------------------------
;初めて恐怖がLV3超えた
;-------------------------------------------------
P = PALAM:11 + UP:11
IF P > PALAMLV:3 && CFLAG:249 == 0
	CALL PALAM_MESSAGE_D
	;陥落済み
	IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
		PRINTFORML 「죄송해요, 죄송해요, %CSTR:이인칭%!」
		PRINTFORMW 「이젠 떼쓰지 않을게요!」
	;それ以外
	ELSE
		IF RAND:2 == 0
			PRINTFORML 「히익!」
		ELSE
			PRINTFORML 「죄송해요, 죄송해요, 잘못했어요!」
		ENDIF
	ENDIF
	CFLAG:249 = 1
ENDIF

;-------------------------------------------------
;@KOJO_MESSAGE_MARKCNG関係（X1をキャラ番号に置換）
;刻印変動をトリガ─にした口上
;刻印変動後に口上を発動します
;-------------------------------------------------
@KOJO_MESSAGE_MARKCNG_PUB303_2
;助手が調教した時に口上をスキ읏プする（好みに応じて使う、行頭の;を消すとスキ읏プするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボ─ルギャグ着用時には地の文を表示して口上をスキ읏プする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL MARK_MESSAGE
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_MARKCNG_PY1_PUB303_2
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_MARKCNG_PY1_PUB303_2
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;苦痛刻印Lv3
;-------------------------------------------------
IF TFLAG:22 == 3
	CALL MARK_MESSAGE_A
	;陥落済み
	IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
		;恋慕、親愛
		IF TALENT:연모 || TALENT:친애
			PRINTFORML 「아파, 아프단 말이여!」
			PRINTFORMW （어라? 왠지 좀 좋을지도♪）
		;淫乱、娼婦
		ELSEIF TALENT:음란 || TALENT:창부
			PRINTFORML （앗…）
			PRINTFORMW （아픈 것도 기분 좋을지도♪）
		;服従、隷属
		ELSEIF TALENT:복종 || TALENT:예속
			IF RAND:2 == 0
				PRINTFORML （앗…）
				PRINTFORMW （아픈 것도 기분 좋을지도♪）
			ELSE
				PRINTFORMW 「아프지만서도…」
				PRINTFORMW 「고마워, %CSTR:이인칭%♪」
			ENDIF
		ENDIF
	ELSE
		IF RAND:2 == 0
			PRINTFORMW 「이젠 아픈 거 싫당께!」
		ELSE
			PRINTFORMW 「괴로운 거 안 돼! 용서해줘!」
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------
;快楽刻印Lv3
;-------------------------------------------------
IF TFLAG:23 == 3
	CALL MARK_MESSAGE_P
	;陥落済み
	IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
		;恋慕、親愛
		IF TALENT:연모 || TALENT:친애
			PRINTFORMW （%CSTR:이인칭%, 좋아, 억수로 좋아… 더 계속 안아줬으면 해… 잔뜩 야한 짓 하고 싶어%ハート()%）
			PRINTFORMW %CALLNAME%은 뺨을 붉히며, 촉촉하게 젖은 눈동자를 %CALLNAME:MASTER%에게 향하고 있었다.
		;服従、隷属
		ELSEIF TALENT:복종 || TALENT:예속
			PRINTFORMW （%CSTR:일인칭%을 괴롭히기만 하는 게 아니라, 이렇게 기분 좋게 해주다니, %CSTR:이인칭%을 더 좋아하게 돼버린당께）
			PRINTFORMW %CALLNAME%은 도취된 표정으로, 행복한 눈동자를 %CALLNAME:MASTER%에게 향하고 있었다.
		ENDIF
	ELSE
		IF RAND:3 == 0
			;淫乱、娼婦からお引越し
			PRINTFORMW 「아하아… 좋아, 기분 좋은 거 억수로 좋아%ハート()%」
			PRINTFORML 「%CSTR:일인칭%, 이젠 야한 생각밖에 못 하겠어…%ハート()%」
		ELSEIF RAND:2 == 0
			PRINTFORMW （기분 좋아… 이제 %CSTR:일인칭%, 이 기분 좋은 거 못 잊겠어… 또 야한 짓 하고 싶네에%ハート()%）
		ELSE
			PRINTFORML 「이렇게 기분 좋은 거 처음이야」
			PRINTFORMW 「더 해준다면, %CSTR:일인칭%…」
		ENDIF
		PRINTFORMW %CALLNAME%은 멍하니 상기된 얼굴로 %CALLNAME:MASTER%을 바라보고 있었다.
	ENDIF
ENDIF

;-------------------------------------------------
;屈服刻印Lv3
;-------------------------------------------------
IF TFLAG:24 == 13 || TFLAG:24 == 23 || TFLAG:24 == 33
	CALL MARK_MESSAGE_S
	;快楽による屈服
	IF TFLAG:24 == 13
		IF RAND:2 == 0
			PRINTFORML 「이런 기분 좋은 거, 학교에선 안 가르쳐줬당께♪」
			PRINTFORML 「더 많이 가르쳐줄래?」
			PRINTFORMW %CALLNAME%은 욕정이 남아있는 눈빛으로 한층 더한 조교를 바라고 있다.
		ELSE
			PRINTFORML （기분 좋은 거 좋아… 더 엉망진창으로 만들어줬으면 좋겠어. 뭐든 말 잘 들을 테니까 기분 좋게 해줬으면 좋겠어）
			PRINTFORMW %CALLNAME%은 힘없이 누운 채로, 욕정이 남은 눈빛으로 %CALLNAME:MASTER%을 올려다보았다.
		ENDIF
	;恐怖と苦痛による屈服
	ELSEIF TFLAG:24 == 23
		IF RAND:2 == 0
			PRINTFORML （%CSTR:이인칭%한테 거역하면 안 되는 거구먼…）
			PRINTFORMW %CALLNAME%은 힘없이 누운 채로, 공허한 눈빛을 천장으로 향하고 있다……
		ELSE
			PRINTFORMW 「죄송해요, 죄송해요!」
			PRINTFORML 「아픈 거, 이제 싫어」
			PRINTFORML 「%CSTR:일인칭%, 착한 아이가 될 테니까!」
			PRINTFORMW %CALLNAME%은 바닥에 머리를 조아리며 굴복의 태도를 보였다……
		ENDIF
	;屈服と恭順による屈服
	ELSEIF TFLAG:24 == 33
		PRINTFORML （이제 %CSTR:일인칭% 큰일이야… %CSTR:이인칭%한테서 못 떨어지겠당께…）
		PRINTFORMW %CALLNAME%은 힘없이 누운 채로, 공허한 눈빛을 천장으로 향하고 있다……
	ENDIF
ENDIF

;-------------------------------------------------
;反発刻印Lv3
;-------------------------------------------------
IF TFLAG:21 == 3
	CALL MARK_MESSAGE_R
	;陥落済み
	IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
		;恋慕、親愛
		IF TALENT:연모 || TALENT:친애
			IF RAND:2 == 0
				PRINTFORMW 「%CSTR:이인칭% 따위 싫어엇!」
			ELSE
				PRINTFORMW 「아무리 %CSTR:이인칭%이라도, 그건 안 돼!」
			ENDIF
		;淫乱、娼婦
		ELSEIF TALENT:음란 || TALENT:창부
			PRINTFORMW 「그거, 기분 안 좋으니까 싫어엇!」
		;服従、隷属
		ELSEIF TALENT:복종 || TALENT:예속
			PRINTFORMW 「아무리 %CSTR:이인칭%이라도, 그건 안 돼!」
		ENDIF
	ELSE
		;たけし専用メ읏セ─ジ
		IF CSTR:MASTER:롤 == "타케시"
			PRINTFORML 「바-보, 바-보, 똥백수」
			PRINTFORMW 「%CSTR:이인칭% 따위 일도 안 하고 콱 죽어버리면 좋겠당께!」
		ELSEIF RAND:3 == 0
			PRINTFORML 「바-보, 바-보, 무능 서머너」
			PRINTFORMW 「%CSTR:이인칭% 따위 합체 사고로 죽어버리면 좋겠당께!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「흥~이다! 이젠 %CSTR:이인칭%이 하는 말 따위 안 들을 거거든!」
		ELSE
			PRINTFORMW 「언젠가 찍소리도 못 하게 만들어줄 거니까」
			PRINTFORMW 「그때까지 그 목숨, 맡겨둘게」
		ENDIF
	ENDIF
	;反発刻印LV3フラグを立てる
	CFLAG:801 = 1
ENDIF


;-------------------------------------------------
;イベント口上集（X1、X2をキャラ番号に置換する） CFLAG 261～299を使用
;-------------------------------------------------
@KOJO_MESSAGE_EVENT_PUB303_2
;--------------------------------------------------
;特定主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_EVENT_PY1_PUB303_2
;	RETURN 0
;ENDIF

;ダンジョン内でのパ─ティ─人数を取得用のFOR文で使う変数
#DIM LCOUNT


;-------------------------------------------------
;朝フェラ/커닐링구스
;-------------------------------------------------
SELECTCASE TFLAG:13
	CASE 1
		CALL EVENT_MESSAGE
		;朝フェラ
		IF HAVE_PENIS(MASTER)
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:261 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORMW 「읍, 츄릅, 푸하…… 에헤헤, 아침 우유 잘 먹었습니다%ハート()%」
						PRINTFORMW 정액을 맛있게 삼킨 뒤에도, %CALLNAME%은 사랑스럽다는 듯 페니스에 봉사를 계속했다.
					ELSE
						PRINTFORMW 「오늘도 기운차네에, %CSTR:이인칭% 꼬추%ハート()%」
						PRINTFORMW 「한 번 쌌는데도 딱딱하당께. 한 번 더 해볼까?」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORML 「츄르르르릅…… 아, 좋은 아침♪ 아침밥 더 잔뜩 주라아%ハート()%」
					PRINTFORMW 맛있게 정액을 삼킨 뒤에도, %CALLNAME%은 아쉽다는 듯 입가에서 음탕한 물소리를 울린다.
					PRINTFORML 「읍, 츱, 응, 읏, 츄릅, 쭙… 더, 더 한 그릇 더어~%ハート()% 츄르르르」
					PRINTFORMW %CALLNAME%의 조르기는 아직 끝날 기미가 보이지 않는다……
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「쥬폽, 쥬폿… 안녕, %CSTR:이인칭%」
					PRINTFORMW 「그럼 계속할 테니까 잔뜩 내주라%ハート()% 츄릅, 쫍, 쥬폽」
				ENDIF
			ENDIF
		;朝クンニ
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:261 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF HAVE_PENIS(MASTER) && RAND:3 == 0
						PRINTFORMW 「저기……」
						PRINTFORMW 「흠뻑 젖은 %CSTR:이인칭% 보지에 %CSTR:일인칭% 꼬추, 넣어도 돼?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「에헤헤, %CSTR:이인칭% 자는 얼굴 보고 있으니까 말야, 못 참게 돼버렸다%ハート()%」
					ELSE
						PRINTFORMW 「자면서 가버린 %CSTR:이인칭% 얼굴, 억수로 귀여웠당께%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF HAVE_PENIS(MASTER) && RAND:4 == 0
						PRINTFORMW 「더 가고 싶어?」
						PRINTFORMW 「그럼 %CSTR:일인칭% 꼬추 써도 좋아♪」
					ELSEIF HAVE_PENIS(MASTER) && RAND:3 == 0
						PRINTFORMW 「저기……」
						PRINTFORMW 「자면서도 흠뻑 젖어버리는 음란한 %CSTR:이인칭% 보지에 %CSTR:일인칭% 꼬추, 넣어도 돼?」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「자고 있는데도 느끼다니, %CSTR:이인칭%도 변태 씨구먼♪」
						PRINTFORMW 「자, 일어나서 오늘도 여러 가지 일 하자아%ハート()%」
					ELSE
						PRINTFORMW 「아침부터 대홍수구먼, %CSTR:이인칭%%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF HAVE_PENIS(MASTER) && RAND:3 == 0
						PRINTFORMW 「저기 말야……」
						PRINTFORML 「%CSTR:이인칭% 보지에 봉사하고 있었더니 말야……」
						PRINTFORMW %CALLNAME%은 다리를 크게 벌리더니 발기한 페니스를 과시해왔다
						PRINTFORML 
						PRINTFORML 「나중에 사정하게 해주라……」
						PRINTFORMW 	%CALLNAME:MASTER%은 봉사를 계속하도록 명령했다……
					ELSE
						PRINTFORMW 「기분 좋았어?」
						PRINTFORMW 「그럼 포상 줘」
						PRINTFORMW 「벌이어도 좋아♪」
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		CFLAG:261 = 1

;-------------------------------------------------
;朝パイズリ
;-------------------------------------------------
	CASE 2
		CALL EVENT_MESSAGE
		;陥落済み
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:262 < 1 || FLAG:7 == 2)
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				PRINTFORMW 「응, 읏… 아, 일어났다♪ 안녕 %CSTR:이인칭%! ……에헤헤, %CSTR:이인칭% 자는 얼굴 귀여웠당께- %ハート()%」
				;ち읏ぱい
				IF BUST() > 3
					PRINTFORM 「가슴으로 부비부비
				ELSE
					PRINTFORM 「가슴으로 조물조물
				ENDIF
				PRINTFORMW 해줄 때마다, 기분 좋은 듯이 신음했는걸♪ 기억 안 나?」
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORMW 「응, 읏, 하아… 아, 안녕♪ 저기, %CSTR:일인칭% 아침밥 줘어%ハート()%」
				PRINTFORMW 기분 좋은 나머지 무방비하게 사정하자, %CALLNAME%은 환성을 지르며 정액을 핥아먹었다.
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORML 「응, 읏, 하아… 아, 안녕, %CSTR:이인칭%」
				PRINTFORMW 「노예인 %CSTR:일인칭% 가슴에 가~득 내주라」
			ENDIF
			CFLAG:262 = 1
		ENDIF

;-------------------------------------------------
;朝騎乗位/貝合わせ
;-------------------------------------------------
	CASE 3
		CALL EVENT_MESSAGE
		;朝騎乗位
		IF HAVE_PENIS(MASTER)
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:263 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
PRINTFORML 「응, 아, 앙, 읏…… 아, 깨버렸다. 좋은 아침 %CSTR:이인칭%?」
PRINTFORMW 「깨우러 왔더니 꼬추가 빳빳했는걸. %CSTR:일인칭%도 못 참게 돼버렸당께%ハート()%」
IF RAND:2 == 0
PRINTFORMW 「모닝 발기는 남자의 로망이라고 들었응께, 열심히 넣어봤당께%ハート()% 」
ELSE
PRINTFORMW 「깨워버려서 미안해♪ 」
ENDIF
;妻
IF TALENT:170
PRINTFORMW 「그치만 자, 일어났다면 잔뜩 사랑해주라, 여%ハート()% 보%ハート()% 야%ハート()%」
ELSE
PRINTFORMW 「그치만 자, 일어났다면 잔뜩 사랑해주라구%ハート()% 앗, 거, 기분 좋아앗, 앙앗!」
ENDIF
;淫乱、娼婦
ELSEIF TALENT:음란 || TALENT:창부
PRINTFORMW 「앗… 하아…… 으아앗! ……기분… 좋아아……%ハート()%」
IF RAND:2 == 0
PRINTFORMW 「%CALLNAME:MASTER%…… 잔뜩… 정액 내줘엇!」
						PRINTFORMW %CALLNAME%은 %CALLNAME:MASTER%이 깬 것도 눈치채지 못한 것인지, 넋을 잃고 %CALLNAME:MASTER% 위에서 계속 허리를 흔들고 있다.
					ELSE
PRINTFORMW 「앗, %CSTR:이인칭%, 일어났구나」
PRINTFORMW 「그럼, 이대로 모닝 섹스 하자아%ハート()%」
ENDIF
;服従、隷属
ELSEIF TALENT:복종 || TALENT:예속
PRINTFORML 「응, 앙, 흐앗, 안녕, %CSTR:이인칭%♪」
IF RAND:2 == 0
PRINTFORMW 「움직이는 건 맡겨두고, %CSTR:이인칭%은 듬뿍 %CSTR:일인칭% 안에 정액 내주라%ハート()%」
ELSE
PRINTFORMW 「%CSTR:이인칭%의 아침 텐트 꼬추, %CSTR:일인칭% 보지로 상쾌하게 비워내라구우%ハート()%」
					ENDIF
				ENDIF
				CFLAG:263 = 1
			ENDIF
		;朝貝合わせ
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:263 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
PRINTFORMW 「안녕, %CSTR:이인칭%♪」 
PRINTFORMW 「잠 깨우는 모닝 키스, 앙앗, 기분 좋제%ハート()%」
ELSE
PRINTFORMW 「%CSTR:이인칭% 자는 얼굴 보고 있으니까 말야, 못 참게 돼버려가지고……」
PRINTFORMW 「그치만, 사이좋은 두 사람이니까 괜찮제%ハート()%」
ENDIF
;淫乱、娼婦
ELSEIF TALENT:음란 || TALENT:창부
IF RAND:3 == 0
PRINTFORMW 「서로 아침부터 흠뻑 젖었네에」
ELSEIF RAND:2 == 0
PRINTFORMW 「%CSTR:이인칭%도 참, 자면서도 허리 흔들고 있었당께♪」
ELSE
PRINTFORMW 「아침 운동, 기분 좋제?」
ENDIF
PRINTFORMW 「이대로, 둘이서 같이 가버리자♪」
;服従、隷属
ELSEIF TALENT:복종 || TALENT:예속
PRINTFORML 「응, 앙, 흐앗, 안녕, %CSTR:이인칭%♪」
IF RAND:2 == 0
PRINTFORMW 「아침부터 %CSTR:이인칭%이랑 보지 맞비비고 있지만서도」
PRINTFORMW 「이건 봉사니까 어쩔 수 없제♪」
ELSE
PRINTFORMW 「기분 좋아, %CSTR:이인칭%?」
PRINTFORMW 「%CSTR:일인칭%도 %CSTR:이인칭%이 기분 좋아질 수 있게, 더 힘낼 테니까 말야%ハート()%」
					ENDIF
				ENDIF
				CFLAG:263 = 1
			ENDIF
		ENDIF

;-------------------------------------------------
;朝騎乗位A
;-------------------------------------------------
	CASE 24
		CALL EVENT_MESSAGE
		;陥落済み
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:263 < 1 || FLAG:7 == 2)
			;恋慕、親愛
IF TALENT:연모 || TALENT:친애
PRINTFORMW 「응, 아, 앙, 응…… 아, 깨버렸구마. 안녕-%CSTR:이인칭%?」
PRINTFORMW 「깨우러 왔더니 꼬추가 빳빳했는걸. 못 참게 돼버렸당께%ハート()%」
PRINTFORMW 「잠결에 하는 게 최고라고 들었응께, 열심히 넣어봤당께%ハート()% 그치만 자, 일어났다면 잔뜩 안아줘어%ハート()% 앗, 거, 기분 좋아앗, 앙앗!」
;淫乱、娼婦
ELSEIF TALENT:음란 || TALENT:창부
PRINTFORMW 「아, 응, 하앙! 엉덩이 기분 좋아아… %CSTR:이인칭%, 아침 정액 얼른 줘어%ハート()%」
;服従、隷属
ELSEIF TALENT:복종 || TALENT:예속
PRINTFORML 「응, 앙, 흐앗, 안녕, %CSTR:이인칭%♪」
IF RAND:2 == 0
PRINTFORMW 「움직이는 건 맡겨두고, %CSTR:이인칭%은 듬뿍 %CSTR:일인칭% 안에 정액 내주라%ハート()%」
ELSE
PRINTFORMW 「%CSTR:이인칭%의 아침 텐트 꼬추, %CSTR:일인칭% 엉덩이 보지로 상쾌하게 비워내라구우%ハート()%」
				ENDIF
			ENDIF
			CFLAG:263 = 1
		ENDIF

;-------------------------------------------------
;朝キス
;-------------------------------------------------
	CASE 25
		CALL EVENT_MESSAGE
		;陥落済み
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:263 < 1 || FLAG:7 == 2)
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				PRINTFORMW 「음… 아후… 쭙, 으응…%ハート()%」
				PRINTFORMW 「응, 낼름낼름%ハート()%… 츄우, 쥬릅, 아앙… 응후」
				PRINTFORMW 「좋은 아침 %CSTR:이인칭%♪ 오늘은 뭐 할까!」
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORMW 「응, 츄우… 낼름… 읍, 으흥… 으응♪」
				PRINTFORMW 「히죽히죽… 아침부터 귀여운 %CSTR:이인칭%♪ 잔뜩 먹어버릴 거야%ハート()% …읍, 낼름… 으응, 읍으응…」
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORMW 
			ENDIF
			CFLAG:263 = 1
		ENDIF

;-------------------------------------------------
;朝食
;-------------------------------------------------
	CASE 26
		CALL EVENT_MESSAGE
		;陥落済み
		IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:263 < 1 || FLAG:7 == 2)
			;たけし専用メ읏セ─ジ
			IF CSTR:MASTER:롤 == "타케시" && RAND:9 == 0
