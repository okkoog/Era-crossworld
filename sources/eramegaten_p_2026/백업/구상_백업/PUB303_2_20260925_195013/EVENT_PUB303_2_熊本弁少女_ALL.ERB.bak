			PRINTFORMW 「요런 식으로 하는 거라고 텔레비전에서 그랬당게」
		ELSE
			PRINTFORMW 「이걸로 둘은 『평생친구』랑께♪」
		ENDIF

;-------------------------------------------------
;;オ─プン/クロ─ズ·オブ·オ읏パイ
;-------------------------------------------------
	CASE 44
		CALL EVENT_MESSAGE
		;オ─プン
		IF TEQUIP:가슴앞열림
			IF BUST() > 4
				PRINTFORMW 「후우, 답답했는디 편해졌구마♪」
			ELSEIF TALENT:절벽
				PRINTFORMW %CALLNAME%은(는) 옷을 헤쳐도 변함없는 자신의 가슴을 말없이 바라보고 있다…
			ELSE
				PRINTFORML 
			ENDIF
		;クロ─ズ
		ELSE
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:285 < 1 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORMW 「오늘은 여기까지, 잉%ハート()%」
				ELSE
					PRINTFORMW 「아직 끝난 거 아니제?」
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「보여지면서 입는 거, 조금 부끄럽기는 한디…」
				ELSE
					PRINTFORMW 「오늘은 이걸로 끝인 겨?」
				ENDIF
			ENDIF
		ENDIF


;=================================================
;ＮＴＲイベント
;=================================================
;-------------------------------------------------
;;[愛ＮＴＲ]イベント時
;-------------------------------------------------
	CASE 45
		CALL EVENT_MESSAGE
		;陥落済み
		IF (CFLAG:288 < 1 || FLAG:7 == 2)
			IF CFLAG:함락캐릭터 == CFLAG:MASTER:캐릭터고유번호
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;進行度分岐
					;初回
					IF CFLAG:애ＮＴＲ진행도 == 0
						PRINTFORML 
					;二回目（リ─チ）
					ELSEIF CFLAG:애ＮＴＲ진행도 == 1
						PRINTFORMW 「오늘도 즐거웠당게%ハート()%」
						PRINTFORML 
						PRINTFORMW 「어, %CALLNAME:MASTER%하고 있는 거랑 어느 쪽이 더 재밌냐고?」
						PRINTFORMW 「으~음」
						PRINTFORMW 「비, 밀, 이, 얌%ハート()%」
					;三回目（陥落）
					ELSEIF CFLAG:애ＮＴＲ진행도 == 2
						PRINTFORMW 「%CALLNAME:MASTER%？」
						PRINTFORMW 「으~음」
						IF RAND:3 == 0 && CFLAG:이벤트가입 == 3
							PRINTFORMW 「옛날에 나쁜 놈한테 붙잡혀 있었을 때 구해줘서」
							PRINTFORMW 「여러모로 좋은 느낌이 되기도 했지만서도…」
						ELSEIF RAND:2 == 0
							PRINTFORMW 「함께 일하는 사이에 좋은 느낌이 되기는 했지만서도…」
						ELSE
							PRINTFORMW 「일할 때의 파트너에서, 아닐 때의 파트너까지 되기는 했지만서도…」
						ENDIF
						PRINTFORML 
						PRINTFORMW 「하지만서도, 이젠 됐당게%ハート()%」
						PRINTFORML 「%CSTR:일인칭%가 정말로 좋아하는 게 누구인지 알아버렸응게%ハート()%」
						PRINTFORMW %CALLNAME%은(는) %NTRNAME(CFLAG:함락캐릭터)%에게 와락 안겼다
						PRINTFORMW 「앞으로도 잘 부탁한데이%ハート()%」
						PRINTFORML 
						PRINTFORML 
						PRINTFORMW (잘 있어라, %CSTR:이인칭%♪)
						SIF CFLAG:801 ^ 2
							CFLAG:801 |= 2
						SIF CFLAG:800 <= 3
							CFLAG:800 = 3
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;進行度分岐
					;初回
					IF CFLAG:애ＮＴＲ진행도 == 0
					;二回目（リ─チ）
					ELSEIF CFLAG:애ＮＴＲ진행도 == 1
						PRINTFORMW 「남자와 여자란 거」
						PRINTFORMW 「야한 것만이 다가 아니었구마」
						PRINTFORMW (어쩌지, 몸뿐만이 아니라, 이 사람을 좋아하게 되어버렸을지도…」
					;三回目（陥落）
					ELSEIF CFLAG:애ＮＴＲ진행도 == 2
						PRINTFORMW 「%CALLNAME:MASTER%？」
						PRINTFORMW 「으~음」
						IF CFLAG:이벤트가입 == 3
							PRINTFORMW 「옛날에 나쁜 놈한테 붙잡혀 있었을 때 구해줘서」
							PRINTFORMW 「야한 짓이라든가 여러 가지 가르쳐 줬지만서도…」
						ELSE
							PRINTFORMW 「일로 맺어진 관계뿐인 걸까나?」
							PRINTFORMW 「앗, 섹스는 즐거웠당게」
						ENDIF
						PRINTFORML 
						PRINTFORMW 「하지만서도, 이젠 됐당게%ハート()%」
						PRINTFORML 「당신을 좋아하게 되어버렸고 말여」
						PRINTFORMW %CALLNAME%은(는) %NTRNAME(CFLAG:함락캐릭터)%에게 와락 안겼다
						PRINTFORMW 「앞으로도 잘 부탁한데이%ハート()%」
						PRINTFORML 
						PRINTFORML 
						PRINTFORML 「아」
						PRINTFORMW 「%CALLNAME:MASTER%하고 하던 것 같은 야한 짓도 해줄게%ハート()%」
						SIF CFLAG:801 ^ 2
							CFLAG:801 |= 2
						SIF CFLAG:800 <= 3
							CFLAG:800 = 3
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					;進行度分岐
					;初回
					IF CFLAG:애ＮＴＲ진행도 == 0
						PRINTFORMW 「보통 섹스만으로 괜찮았던 겨?」
					;二回目（リ─チ）
					ELSEIF CFLAG:애ＮＴＲ진행도 == 1
						PRINTFORMW 
					;三回目（陥落）
					ELSEIF CFLAG:애ＮＴＲ진행도 == 2
						PRINTFORMW 「%CALLNAME:MASTER%？」
						PRINTFORMW 「으~음」
						IF CFLAG:이벤트가입 == 3
							PRINTFORML 「옛날에 나쁜 놈한테 붙잡힌 뒤에」
							PRINTFORMW 「노예 취급당하고 있어서 말여…」
						ELSE
							PRINTFORMW 「이것저것 가르쳐 줬지만서도, 일뿐인 관계인 걸까나?」
						ENDIF
						PRINTFORML 
						PRINTFORMW 「하지만서도, 이젠 됐당게%ハート()%」
						PRINTFORML 「당신을 좋아하게 되어버렸고 말여」
						PRINTFORMW %CALLNAME%은(는) %NTRNAME(CFLAG:함락캐릭터)%에게 와락 안겼다
						PRINTFORMW 「앞으로도 잘 부탁한데이%ハート()%」
						SIF CFLAG:801 ^ 2
							CFLAG:801 |= 2
						SIF CFLAG:800 <= 3
							CFLAG:800 = 3
					ENDIF
				;主人に陥落していない状態でＮＴＲ
				ELSE
					;進行度分岐
					;初回
					IF CFLAG:애ＮＴＲ진행도 == 0
						PRINTFORML 
					;二回目（リ─チ）
					ELSEIF CFLAG:애ＮＴＲ진행도 == 1
						PRINTFORMW 
					;三回目（陥落）
					ELSEIF CFLAG:애ＮＴＲ진행도 == 2
						PRINTFORMW 「%CALLNAME:MASTER%？」
						PRINTFORMW 「으~음」
						IF CFLAG:이벤트가입 == 3
							PRINTFORMW 「옛날에 나쁜 놈한테 붙잡혀 있었을 때 구해줬지만서도…」
						ELSE
							PRINTFORMW 「여러 가지 일들이 있었지만서도, 일뿐인 관계인 걸까나?」
						ENDIF
						PRINTFORML 
						PRINTFORML 「하지만서도, 이젠 됐당게%ハート()%」
						PRINTFORMW %CALLNAME%은(는) %NTRNAME(CFLAG:함락캐릭터)%에게 와락 안겼다
						PRINTFORMW 「앞으로도 잘 부탁한데이%ハート()%」
						SIF CFLAG:801 ^ 2
							CFLAG:801 |= 2
						SIF CFLAG:800 <= 3
							CFLAG:800 = 3
					ENDIF
				ENDIF
			ELSE
				;主人以外の誰かに陥落している状態で更に別のキャラにＮＴＲ
				;進行度分岐
				;初回
				IF CFLAG:애ＮＴＲ진행도 == 0
					PRINTFORMW 
				;二回目（リ─チ）
				ELSEIF CFLAG:애ＮＴＲ진행도 == 1
					PRINTFORMW 
				;三回目（陥落）
				ELSEIF CFLAG:애ＮＴＲ진행도 == 2
					PRINTFORMW 
				ENDIF
			ENDIF
			CFLAG:288 = 1
		ENDIF
		;-------------------------------------------------
		;;[淫ＮＴＲ]イベント時
		;-------------------------------------------------
	CASE 46
		CALL EVENT_MESSAGE
		;陥落済み
		IF (CFLAG:289 < 1 || FLAG:7 == 2)
			IF CFLAG:함락캐릭터 == CFLAG:MASTER:캐릭터고유번호
				;主人に陥落しているor誰にも陥落してない状態でＮＴＲ
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;進行度分岐
					;初回
					IF CFLAG:음ＮＴＲ진행도 == 0
						PRINTFORMW 
					;二回目（リ─チ）
					ELSEIF CFLAG:음ＮＴＲ진행도 == 1
						PRINTFORMW 「오늘도 즐거웠당게%ハート()%」
						PRINTFORML 
						PRINTFORMW 「어, %CALLNAME:MASTER%하고 있는 거랑 어느 쪽이 더 재밌냐고?」
						PRINTFORMW 「으~음」
						PRINTFORMW 「비, 밀, 이, 얌%ハート()%」
					;三回目（陥落）
					ELSEIF CFLAG:음ＮＴＲ진행도 == 2
						PRINTFORMW 「%CALLNAME:MASTER%？」
						PRINTFORMW 「으~음」
						IF CFLAG:이벤트가입 == 3
							PRINTFORMW 「옛날에 나쁜 놈한테 붙잡혀 있었을 때 구해줘서」
							PRINTFORMW 「좋아하게 되어버리기도 했지만」
						ELSE
							PRINTFORMW 「여러 가지 일들이 있었지만서도, 일뿐인 관계인 걸까나?」
						ENDIF
						PRINTFORML 
						PRINTFORML 「하지만서도, 이젠 됐당게」
						PRINTFORML 「%CALLNAME:MASTER%과의 사랑보다 소중한 것이 있으니께%ハート()%」
						PRINTFORMW %CALLNAME%은(는) %NTRNAME(CFLAG:함락캐릭터)%에게 안겨들며 옷 위로 가랑이를 쓸어 올렸다
						PRINTFORMW 「앞으로도 잘 부탁해, 잉%ハート()%」
						SIF CFLAG:801 ^ 2
							CFLAG:801 |= 2
						SIF CFLAG:800 <= 3
							CFLAG:800 = 3
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					;進行度分岐
					;初回
					IF CFLAG:음ＮＴＲ진행도 == 0
						PRINTFORMW 
					;二回目（リ─チ）
					ELSEIF CFLAG:음ＮＴＲ진행도 == 1
						PRINTFORMW 
					;三回目（陥落）
					ELSEIF CFLAG:음ＮＴＲ진행도 == 2
						PRINTFORMW 「%CALLNAME:MASTER%？」
						PRINTFORMW 「으~음」
						IF CFLAG:이벤트가입 == 3
							PRINTFORML 「옛날에 나쁜 놈한테 붙잡힌 뒤에」
							PRINTFORMW 「노예 취급당했어서 말여…」
						ELSE
							PRINTFORMW 「이런저런 일 당하면서 노예 취급받았당게」
						ENDIF
						PRINTFORML 
						PRINTFORML 「그치만, 이제 괜찮아」
						PRINTFORML 「%CALLNAME:MASTER%의 노예로 있는 것보다 이쪽이 훨씬 즐거운걸%ハート()%」
						PRINTFORMW %CALLNAME%은(는) %NTRNAME(CFLAG:함락캐릭터)%에게 안겨들며 옷 위로 가랑이를 쓸어 올렸다
						PRINTFORMW 「앞으로도 잘 부탁한데이%ハート()%」
						SIF CFLAG:801 ^ 2
							CFLAG:801 |= 2
						SIF CFLAG:800 <= 3
							CFLAG:800 = 3
					ENDIF
				;その他
				ELSE
					;進行度分岐
					;初回
					IF CFLAG:음ＮＴＲ진행도 == 0
						PRINTFORMW 
					;二回目（リ─チ）
					ELSEIF CFLAG:음ＮＴＲ진행도 == 1
						PRINTFORMW 
					;三回目（陥落）
					ELSEIF CFLAG:음ＮＴＲ진행도 == 2
						PRINTFORMW 
					ENDIF
				ENDIF
			ELSE
				;主人以外の誰かに陥落している状態で更に別のキャラにＮＴＲ
				;進行度分岐
				;初回
				IF CFLAG:음ＮＴＲ진행도 == 0
					PRINTFORMW 
				;二回目（リ─チ）
				ELSEIF CFLAG:음ＮＴＲ진행도 == 1
					PRINTFORMW 
				;三回目（陥落）
				ELSEIF CFLAG:음ＮＴＲ진행도 == 2
					PRINTFORMW (으~음, 역시 이쪽 몸이 더 좋으려나%ハート()%)
					PRINTFORML 
					PRINTFORML 
					PRINTFORML 「앞으로도 잘 부탁한데이%ハート()%」
					PRINTFORMW %CALLNAME%은(는) %NTRNAME(CFLAG:함락캐릭터)%에게 와락 안기며 딥키스를 퍼부었다
				ENDIF
			ENDIF
			CFLAG:289 = 1
		ENDIF
		;-------------------------------------------------
		;;[隷ＮＴＲ]イベント時
		;-------------------------------------------------
	CASE 47
		CALL EVENT_MESSAGE
		;陥落済み
		IF (CFLAG:290 < 1 || FLAG:7 == 2)
			IF CFLAG:함락캐릭터 == CFLAG:MASTER:캐릭터고유번호
				;主人に陥落しているor誰にも陥落してない状態でＮＴＲ
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORMW 「어쩌지……」
						PRINTFORML 「%CALLNAME:MASTER%보다」
						PRINTFORMW 「그 사람이 하는 말에 거역할 수 없게 되어버리고 있어……」
					;二回目（リ─チ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORMW 「%CSTR:일인칭%……」
						PRINTFORML 「%CALLNAME:MASTER%하고 닭살 돋는 사이였을 텐디」
						PRINTFORMW 「개새끼처럼 조교당하는 게 좋아져 버렸구마」
						PRINTFORMW 「어쩌지……」
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						IF RAND:2 == 0
							PRINTFORMW 「이제」
							PRINTFORML 「%CALLNAME%의 모든 것은 %CALLNAME:MASTER%의 것이 아니라」
							PRINTFORML 「당신의 것이니께……」
							PRINTFORMW %CALLNAME%은(는) %NTRNAME(CFLAG:함락캐릭터)%의 다리에 매달린다
							PRINTFORMW 「마음대로 해줘잉……%ハート()%」
						ELSE
							PRINTFORML 「자」
							PRINTFORMW 「%CALLNAME:MASTER%하고 알콩달콩했던 건 착각이었당게」
							PRINTFORML 「이제부터는…… 애완동물로 사육해줘잉……」
							PRINTFORMW %CALLNAME%은(는) %NTRNAME(CFLAG:함락캐릭터)%에게 엎드려 절하며 자신의 주인이 되어달라고 간청했다……
						ENDIF
						IF TALENT:아내
							PRINTFORMW 「그러니까, 이것도 이제 필요 없당게!」
							PRINTFORMW %CALLNAME%은(는) 손가락에서 반지를 빼내어 쓰레기통에 내던졌다……
						ENDIF
						SIF CFLAG:801 ^ 2
							CFLAG:801 |= 2
						SIF CFLAG:800 <= 3
							CFLAG:800 = 3
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORMW 
					;二回目（リ─チ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORMW 
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						PRINTFORMW 
						SIF CFLAG:801 ^ 2
							CFLAG:801 |= 2
						SIF CFLAG:800 <= 3
							CFLAG:800 = 3
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORMW 
					;二回目（リ─チ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORMW 
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						PRINTFORMW 
						SIF CFLAG:801 ^ 2
							CFLAG:801 |= 2
						SIF CFLAG:800 <= 3
							CFLAG:800 = 3
					ENDIF
				;その他
				ELSE
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORMW 
					;二回目（リ─チ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORMW 
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						PRINTFORMW 
					ENDIF
				ENDIF
			ELSE
				;主人以外の誰かに陥落している状態で更に別のキャラにＮＴＲ
				;進行度分岐
				;初回
				IF CFLAG:예ＮＴＲ진행도 == 0
					PRINTFORMW 
				;二回目（リ─チ）
				ELSEIF CFLAG:예ＮＴＲ진행도 == 1
					PRINTFORMW 
				;三回目（陥落）
				ELSEIF CFLAG:예ＮＴＲ진행도 == 2
					PRINTFORMW 
				ENDIF
			ENDIF
			CFLAG:290 = 1
		ENDIF

;-------------------------------------------------
;;愛系再陥落時
;;主人に対して恋慕系陥落している、もしくは一度愛系ＮＴＲ状態にされたキャラに再び陥落させられる時
;-------------------------------------------------
	CASE 48
		CALL EVENT_MESSAGE
		;再陥落前に陥落しているキャラ→CFLAG:함락캐릭터 で取得可能、名前は%NTRNAME(CFLAG:함락캐릭터)%
		;再陥落先のキャラ→ FAVORITE_1_ID(TARGET)　で取得可能、名前は%NTRNAME(FAVORITE_1_ID(TARGET))%
		;やや煩雑になるのでLOCAL、あるいは#DIM等を使用して分かりやすくする事を推奨します
		
		IF (CFLAG:291 < 1 || FLAG:7 == 2)
			;主人に対して陥落し直し
			IF FAVORITE_1_ID(TARGET) == CFLAG:MASTER:캐릭터고유번호
				PRINTFORMW 
				SIF CFLAG:801 & 2
					CFLAG:801 ^= 2
			;その他のキャラ·ＮＰＣにＮＴＲし直し
			ELSE
				PRINTFORMW 
				SIF CFLAG:801 ^ 2
					CFLAG:801 |= 2
				SIF CFLAG:800 <= 3
					CFLAG:800 = 3
			ENDIF
			CFLAG:291 = 1
		ENDIF

;-------------------------------------------------
;;淫系再陥落時
;;主人に対して淫乱系陥落している、もしくは一度淫系ＮＴＲ状態にされたキャラに再び陥落させられる時
;-------------------------------------------------
	CASE 49
		CALL EVENT_MESSAGE
		;再陥落前に陥落しているキャラ→CFLAG:함락캐릭터 で取得可能、名前は%NTRNAME(CFLAG:함락캐릭터)%
		;再陥落先のキャラ→ FAVORITE_1_ID(TARGET)　で取得可能、名前は%NTRNAME(FAVORITE_1_ID(TARGET))%
		;やや煩雑になるのでLOCAL、あるいは#DIM等を使用して分かりやすくする事を推奨します

		IF (CFLAG:292 < 1 || FLAG:7 == 2)
			;主人に対して陥落し直し
			IF FAVORITE_1_ID(TARGET) == CFLAG:MASTER:캐릭터고유번호
				IF RAND:2 == 0
					PRINTFORMW 「바람피워서 미안해」
					PRINTFORMW 「하지만서도 말여, 바람피워보고 알게 된 게 있당게」
					PRINTFORMW 「%CALLNAME:MASTER% 꼬추가 제일 최고라는 걸♪」
				ELSE
					PRINTFORML 「역시 %CSTR:이인칭% 몸이 최고구마」
				ENDIF
				PRINTFORMW 「또 잘 부탁해, %CALLNAME:MASTER%♪」
				SIF CFLAG:801 & 2
					CFLAG:801 ^= 2
			;その他のキャラ·ＮＰＣにＮＴＲし直し
			ELSE
				PRINTFORMW 「바람피워서 미안해%ハート()%」
				PRINTFORMW 「또 야한 짓, 하자잉♪」
				SIF CFLAG:801 ^ 2
					CFLAG:801 |= 2
				SIF CFLAG:800 <= 3
					CFLAG:800 = 3
			ENDIF
			CFLAG:292 = 1
		ENDIF

;-------------------------------------------------
;;隷系再陥落時
;;主人に対して服従系陥落している、もしくは一度隷系ＮＴＲ状態にされたキャラに再び陥落させられる時
;-------------------------------------------------
	CASE 50
		CALL EVENT_MESSAGE
		;再陥落前に陥落しているキャラ→CFLAG:함락캐릭터 で取得可能、名前は%NTRNAME(CFLAG:함락캐릭터)%
		;再陥落先のキャラ→ FAVORITE_1_ID(TARGET)　で取得可能、名前は%NTRNAME(FAVORITE_1_ID(TARGET))%
		;やや煩雑になるのでLOCAL、あるいは#DIM等を使用して分かりやすくする事を推奨します
					
		IF (CFLAG:293 < 1 || FLAG:7 == 2)
			;主人に対して陥落し直し
			IF FAVORITE_1_ID(TARGET) == CFLAG:MASTER:캐릭터고유번호
				PRINTFORMW 
				SIF CFLAG:801 & 2
					CFLAG:801 ^= 2
			;その他のキャラ·ＮＰＣにＮＴＲし直し
			ELSE
				PRINTFORMW 
				SIF CFLAG:801 ^ 2
					CFLAG:801 |= 2
				SIF CFLAG:800 <= 3
					CFLAG:800 = 3
			ENDIF
			CFLAG:293 = 1
		ENDIF

;-------------------------------------------------
;;ＮＴＲ夜這い·乱交パ─ティ
;;淫ＮＴＲ状態（TALENT:ＮＴＲ == 2 か TALENT:ＮＴＲ == 5）である時のみ
;-------------------------------------------------
	CASE 51
		CALL EVENT_MESSAGE
		IF (CFLAG:294 < 1 || FLAG:7 == 2)
			;以前恋慕ル─トだ읏た場合
			IF TALENT:연모 || TALENT:친애
				;妊娠している場合
				IF TALENT:임신
					;父親が＠
				 	IF CFLAG:임신확정후의부친판정 == NO:MASTER
						IF TALENT:아내
							IF RAND:2 == 0
								PRINTFORML 「달링의 아이가 배 속에 있는디도」
								PRINTFORMW 「바람피우는 난교, 최고오%ハート()%」
							ELSE
								PRINTFORML 「유부녀랑 섹스할 수 있다고 다들 너무 덤벼드네♪」
								PRINTFORMW 「모두의 정액, 전부 다 받아내 줄 틴게 싸우지 마러%ハート()%」
							ENDIF
						ELSE
							IF RAND:2 == 0
								PRINTFORML 「%CALLNAME:MASTER%하고는 결혼 안 했응게 괜찮여♪」
								PRINTFORMW 「이 이상 임신 안 하응게 잔뜩 정액 싸재끼소%ハート()%」
							ELSE
								PRINTFORMW 「임산부랑 섹스할 수 있다고 다들 너무 덤벼드네♪」
								PRINTFORML 「배 속 아이도 달링과의 아이가 아니니께」
								PRINTFORMW 「모두 정액 사정 맘껏 뿜어내도 된당께%ハート()%」
							ENDIF
						ENDIF
					ELSE
						PRINTFORML 「다들 얼른 사정 안 하응게」
						PRINTFORMW 「진작에 임신해 버렸잖여♪」
						PRINTFORMW 「하지만서도, 보지는 언제든 무제한 이용 가능이랑께%ハート()%」
					ENDIF
				ELSE
					IF RAND:4 == 0
						PRINTFORML 「좋아하지도 않는 상대랑 섹스하는 거」
						PRINTFORMW 「배덕감 쩔어서 최고랑께♪」
					ELSEIF RAND:3 == 0
						PRINTFORML 「%CALLNAME:MASTER%하고만 했으믄 이런 맛은 평생 못 봤을 거여♪」
						PRINTFORMW 「꼬추 최고오~%ハート()%」
					ELSEIF RAND:2 == 0
						PRINTFORML 「봐봐 봐봐아~♪」
						PRINTFORMW 「말씀하신 대로, %CSTR:일인칭% 안에 꼬추가 잔~뜩 들어오고 있당게요%ハート()%」
					ELSE
						PRINTFORMW 「좋아하진 않지만서도♪」
						PRINTFORMW 「모르는 사람 꼬추가 들어오고 있구마♪」
						PRINTFORMW 「모두의 장난감 취급당해 버리고 있당게♪」
					ENDIF
				ENDIF
			;以前服従ル─トだ읏た場合
			ELSEIF TALENT:복종 || TALENT:예속
				IF RAND:2 == 0
					PRINTFORMW 「이런 꼬추도 있구마♪」
					PRINTFORMW 「전~부 봉사할 틴게, %CSTR:일인칭%한테 정액 싸주소♪」
				ELSE
					PRINTFORMW 「봉사도 안 했는데 꼬추를 넣어주는 구마」
					PRINTFORMW 「섹스란 건, 대단히 좋구마♪」
				ENDIF
			ELSE
				PRINTFORMW 
			ENDIF
			CFLAG:294 = 1
		ENDIF

;-------------------------------------------------
;;ＮＴＲ夜這い·公園
;;淫ＮＴＲ状態（TALENT:ＮＴＲ == 2 か TALENT:ＮＴＲ == 5）である時のみ
;-------------------------------------------------
	CASE 52
		CALL EVENT_MESSAGE
		IF (CFLAG:295 < 1 || FLAG:7 == 2)
			IF TALENT:연모 || TALENT:친애
				;以前恋慕ル─トだ읏た場合
				IF RAND:2 == 0
					PRINTFORMW 「저기…… 함께 하장게♪」
					PRINTFORML 「아직 구멍은 비어 있당게%ハート()%」
					PRINTFORMW %CALLNAME%은(는) 처음 본 사내와 연결된 채 %NTRNAME(CFLAG:함락캐릭터)%에게 손짓했다
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%하고라면…… 안 했을 플레이니께……」
					PRINTFORMW 「흥분해서 의욕이 마구 솟구쳐버리는 거제……%ハート()%」
				ENDIF
			ELSEIF TALENT:복종 || TALENT:예속
				;以前服従ル─トだ읏た場合
				IF RAND:2 == 0
					PRINTFORMW 「역시 장난감 취급당하는 거 즐거워……♪」
				ELSE
					PRINTFORMW 「몸으로 봉사하는 거 참 좋제♪」
				ENDIF
			ELSE
				PRINTFORMW
			ENDIF
			CFLAG:295 = 1
		ENDIF

;-------------------------------------------------
;;ＮＴＲ夜這い·便器
;;淫ＮＴＲ状態（TALENT:ＮＴＲ == 2 か TALENT:ＮＴＲ == 5）である時のみ
;-------------------------------------------------
	CASE 53
		CALL EVENT_MESSAGE
		IF (CFLAG:296 < 1 || FLAG:7 == 2)
			IF TALENT:연모 || TALENT:친애
				;以前恋慕ル─トだ읏た場合
				IF RAND:2 == 0
					PRINTFORMW 「응, 착실하게 정액 싸질러지고 왔당게♪」
					PRINTFORMW 「좋아하지도 않는 상대지만서도, 정액은 좋아한당께%ハート()%」
				ELSE
					PRINTFORMW 「화장실, 정액 냄새 진동하게 되어버렸구마」
					PRINTFORMW 「내일 청소하는 사람도 고생깨나 하겠구마♪」
				ENDIF
			ELSEIF TALENT:복종 || TALENT:예속
				IF RAND:2 == 0
					PRINTFORMW 「하아…… 너무 많이 뒹굴어가꼬 못 움직이겠어……♪」
					PRINTFORML 「몸을 깨끗이 안 씻으믄 못 돌아가니께……」
					PRINTFORMW 「부탁여……」
					PRINTFORML 
					PRINTFORMW 「차가운 거 끼얹고 싶구마!」
					PRINTFORML 「이거 당하믄 옛날 생각이 나부러♪」
					PRINTFORMW 수도꼭지에 연결된 호스의 찬물을 %NTRNAME(CFLAG:함락캐릭터)%에게 뒤집어쓰며 %CALLNAME%은(는) 교성을 지르고 있다……
				ELSE
					PRINTFORMW 「화장실, 정액 냄새 진동하게 되어버렸구마」
					PRINTFORML 「깨끗이 청소해야제♪」
					PRINTFORMW %CALLNAME%은(는) 사방에 흩뿌려진 정액을 혀로 핥아먹고 있다……
				ENDIF
			ELSE
				PRINTFORMW
			ENDIF
			CFLAG:296 = 1
		ENDIF

;-------------------------------------------------
;;ＮＴＲ夜這い·夜の街
;;淫ＮＴＲ状態（TALENT:ＮＴＲ == 2 か TALENT:ＮＴＲ == 5）である時のみ
;-------------------------------------------------
	CASE 54
		CALL EVENT_MESSAGE
		IF (CFLAG:296 < 1 || FLAG:7 == 2)
			IF TALENT:연모 || TALENT:친애
				;以前恋慕ル─トだ읏た場合
				IF RAND:2 == 0
					PRINTFORMW 「여자친구한테 해보고 싶었던 짓」
					PRINTFORMW 「%CSTR:일인칭%한테 해봐도 된당게♪」
				ELSE
					PRINTFORMW 「저기, 하슬 드링크 주소?」
					PRINTFORML 
					PRINTFORMW 「고마워♪」
					PRINTFORMW 「다 마시면, 한 번 더 하장게%ハート()%」
				ENDIF
			ELSEIF TALENT:복종 || TALENT:예속
				;以前服従ル─トだ읏た場合
				IF RAND:2 == 0
					PRINTFORMW 「역시 장난감 취급당하는 거 즐거워……♪」
				ELSE
					PRINTFORML 「야한 봉사, 마음에 들었능가?」
					PRINTFORMW 「아직 봉사 더 할 수 있당게♪」
				ENDIF
			ELSE
				PRINTFORMW
			ENDIF
			CFLAG:296 = 1
		ENDIF

;-------------------------------------------------
;;ＮＴＲ夜這い·ＮＴＲ前逢引
;;ＮＴＲ状態になる前に逢引する時
;-------------------------------------------------
	CASE 55
		CALL EVENT_MESSAGE
		IF (CFLAG:297 < 1 || FLAG:7 == 2)
			IF CFLAG:함락캐릭터 != 0
				;主人以外に陥落している場合
				PRINTFORMW  
			ELSEIF TALENT:연모 || TALENT:친애
				;恋慕ル─ト
				PRINTFORMW 「오늘은 즐거웠당게♪」
				PRINTFORMW 「또…… 만나주려나%ハート()%」
			ELSEIF TALENT:음란 || TALENT:창부
				;淫乱ル─ト
				PRINTFORMW 
			ELSEIF TALENT:복종 || TALENT:예속
				;服従ル─ト
				PRINTFORMW 
			ELSE
				PRINTFORMW
			ENDIF
			CFLAG:297 = 1
		ENDIF

;-------------------------------------------------
;;ＮＴＲ夜這い·ＮＴＲ後初逢引
;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)にな읏た直後の一日の終了後、一度だけ行う
;別のキャラに陥落する度に起こる。同じキャラに再度陥落した場合は起こらない
;-------------------------------------------------
	CASE 56
		CALL EVENT_MESSAGE
		IF (CFLAG:298 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 「이렇게 만난 건 처음이구마%ハート()%」
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORML 「늦어서 죄송해유」
				PRINTFORMW %CALLNAME%은(는) %NTRNAME(CFLAG:함락캐릭터)%의 앞에 엎드려 절하더니 첫마디로 사과를 건넸다
			ENDIF
			CFLAG:298 = 1
		ENDIF

;-------------------------------------------------
;;ＮＴＲ夜這い·本番
;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
;女性であれば入れられる側、男性であれば入れる側で固定
;-------------------------------------------------
	CASE 58
		CALL EVENT_MESSAGE
		;初回
		IF CFLAG:601 == 0 || FLAG:7 == 2
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 「이렇게 만나서 섹스하는 건 처음이구마%ハート()%」
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORML 「주인님♪　%CSTR:일인칭% 보지, 좋을 대로 푹푹 쑤셔줘잉%ハート()%」
				PRINTFORMW %CALLNAME%은(는) 스스로 음부를 벌리며 음란한 말을 내뱉었다
			ENDIF
		ELSE
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				IF RAND:2 == 0
					PRINTFORML 「··앗·· 나오고 있어·· 정자 가득··· 나오고 있당게요··」
					PRINTFORMW %CALLNAME%은(는) 위를 덮친 %NTRNAME(CFLAG:함락캐릭터)%에게 매달리며 자궁을 때리는 사정의 쾌락에 젖어들고 있다
				ELSE
					PRINTFORML 「오늘도 잔뜩 정액을 받아서 %CSTR:일인칭%는 행복하당께%ハート()%」
					PRINTFORMW %CALLNAME%은(는) %NTRNAME(CFLAG:함락캐릭터)%의 뺨에 입을 맞추었다
				ENDIF
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORML 「··읏, 하아앙%ハート()%·· 네, 말씀하신 대로·· 주인님의 정자로··· 임신할게유%ハート()%」
				PRINTFORMW %CALLNAME%은(는) 멍한 눈으로 %NTRNAME(CFLAG:함락캐릭터)%에게 미소 지었다
			ENDIF
			CFLAG:601 = 1
		ENDIF


;-------------------------------------------------
;ＮＴＲ上司来襲
;調教関連￥NTRJOUSHI.ERB　の1239行目で喋らせている
;翌朝帰읏てくるときにはセリフ出せない？
;-------------------------------------------------
	CASE 64
		IF CFLAG:상사이벤트진행도 < 2
			IF TALENT:처녀
				IF RAND:3 == 0
					PRINTFORML 「%CSTR:일인칭%의 첫 상대는 %CALLNAME:MASTER%(으)로 정해뒀었는디」
					PRINTFORML 「이런 거라니…」
				ELSEIF RAND:2 == 0
					PRINTFORML 「%CALLNAME:MASTER%…」
					PRINTFORML (%CSTR:일인칭%, 더렵혀져 버렸구마…)
				ELSE
					PRINTFORML 「%CALLNAME:MASTER% 미안해…」
					PRINTFORML 「%CSTR:일인칭%의 처녀, 선물해주지 못해서……」
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORML PRINTFORML 「이런 거… %CALLNAME:MASTER%에 비하면……」
					PRINTFORML 범해지면서 남친의 이름을 부르는 %CALLNAME%의 모습에 사내는 오히려 흥분하고 있다…
				ELSE
					PRINTFORML (가난은 죄로구마, %CALLNAME:MASTER%……)
				ENDIF
			ENDIF
		;第二段階
		ELSEIF CFLAG:상사이벤트진행도 < 9
			IF 위험일() > 0
				IF RAND:3 == 0
					PRINTFORML 「싫어… 보지에 안 싸기로 약속했었는디…」
				ELSEIF RAND:2 == 0
					PRINTFORML 「구해줘… %CALLNAME:MASTER%」
					PRINTFORML 「이런 놈의 아기 따위… 필요 없어…」
				ELSE
					PRINTFORML 「이런 짓을 하고서… 나중에 %CALLNAME:MASTER%이(가) 복수하러 올 틴게…」
				ENDIF
			ELSE
				IF RAND:4 == 0
					PRINTFORML (%CALLNAME:MASTER%… 혼자서 외롭지는 않으려나…)
					PRINTFORML %CALLNAME%은(는) 현실 도피로 다른 생각을 하고 있다…
				ELSEIF RAND:2 == 0
					PRINTFORML (%CSTR:일인칭%가 참으면 %CALLNAME:MASTER%도 조직에서 괴롭힘당하지 않을 틴게……)
				ELSEIF RAND:2 == 0
					PRINTFORML (지지 않을 틴게… 기다려줘, %CALLNAME:MASTER%…)
				ELSE
					PRINTFORML 「이걸로 만족해준다면…」
				ENDIF
			ENDIF
		;第三段階
		ELSEIF CFLAG:상사이벤트진행도 == 9
			IF RAND:3 == 0
				PRINTFORML 「보지가 반응하고 있을 뿐이랑께♪」
				PRINTFORML 「%CSTR:일인칭%가 좋아하는 건 %CALLNAME:MASTER%인 거니께♪」
			ELSEIF RAND:2 == 0
				PRINTFORML 「거긴 안 돼엣♪　약한 곳이란 말이여엇♪」
				PRINTFORML %CALLNAME%은(는) 스스로 약점을 사내에게 들이대고 있다
			ELSE
				PRINTFORML 「이런 짓♪　꼬추 따위에♪　안 진당게♪」
			ENDIF
		;第三段階でリ─チ入읏た
		ELSEIF CFLAG:상사이벤트진행도 == 10
			IF 위험일() > 0
				IF RAND:2 == 0
					PRINTFORML 「안 돼… 아기가 생겨버려……♪」
				ELSE
					PRINTFORML 「싫은디도… 보지가 기뻐해 버리고 있어%ハート()%」
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「꼬추에 져버렸구마……♪」
				ELSE
					PRINTFORML 「앙… 이렇게나 잔뜩……%ハート()%」
					PRINTFORML 「다 안 들어간당게♪」
				ENDIF
			ENDIF
		;最終段階で薬に耐えた
		ELSEIF CFLAG:상사이벤트진행도 == 11
			IF RAND:2 == 0
				PRINTFORML 「그런 약… 안 듣는단 말이여……」
			ELSE
				PRINTFORML 「%CALLNAME:MASTER%…… %CSTR:일인칭%… 안 졌당게……」
			ENDIF
		;寝取られ宣言
		ELSEIF CFLAG:상사이벤트진행도 == 12
			IF TALENT:아내 && RAND:2 == 0
				PRINTFORML 「빠이빠~이♪」
				PRINTFORML %CALLNAME%은(는) 결혼반지를 빼더니 쓰레기통으로 내던졌다……
			ELSEIF RAND:2 == 0
				PRINTFORML 「%CALLNAME:MASTER% 따윈 버려버릴 틴게」
				PRINTFORML 「아침에도 낮에도 밤에도, 계~속 섹스, 하장게%ハート(3)%」
			ELSE
				PRINTFORML 「굉장해♪　%CALLNAME:MASTER% 꼬추보다 기분 좋아앗♪」
				PRINTFORML 「될게, 상사분의 여친이든 장난감이든 뭐든 될 틴게, 더♪　더!!」
			ENDIF
		;寝取られ後
		ELSEIF CFLAG:상사이벤트진행도 >= 13
			IF 위험일() > 0
				IF RAND:2 == 0
					PRINTFORML 「두 사람의 아기… 기대되네 말여%ハート()%」
				ELSE
					PRINTFORML 「남의 밭에 씨를 뿌리고…… 못된 사람%ハート()%」
				ENDIF
			ELSE
				;「百合カ읏プルの間に入る上司」というのをひらめいた
				;だが、＠と百合カ읏プルかを判断する方法が無いのでコメントにしておく
				;IF TALENT:MASTER:女 && TALENT:MASTER:처녀
				;	IF RAND:2 == 0
				;		PRINTFORML 「オチンチンがこんなにキモチいいのしらないなんて」
				;		PRINTFORML 「%CALLNAME:MASTER%もカワイソウだから」
				;		PRINTFORML 「こんどフタリでおしえてあげようヨ♪」
				;	ELSE
				;		PRINTFORML 「このマエまでオチンチンがこんなにキモチいいなんてしらなか읏た」
				;		PRINTFORML 「なんかソンしてたキブン」
				;	ENDIF
				IF RAND:3 == 0
					PRINTFORML 「얼른 %CALLNAME:MASTER% 놈, 처리해 주지 않으려나~」
					PRINTFORML 「그라믄 매일 이런 짓 할 수 있을 텐디♪」
				ELSEIF RAND:2 == 0
					PRINTFORML 「오늘도 대단한 플레이, 고마워잉♪」
				ELSE
					PRINTFORML 「이제… 간부님의 아이가 될래……%ハート()%」
				ENDIF
			ENDIF
		;本来はありえない値
		ELSE
			PRINTFORML 「어째서 여기에 있는 겨?」
		ENDIF



;-------------------------------------------------
;ダンジョン内性欲処理：仲魔とセ읏クスする
;やられちゃう側
;PLAYERに実行者の番号が入읏ています
;-------------------------------------------------
	CASE 79
		;セリフの分岐の為、現在のパ─ティ─人数を取得する
		LOCAL = 0
		FOR LCOUNT, 1, 7
			LOCALS = 포지션{LCOUNT}
        	SIF FLAG:LOCALS >= 0
            	LOCAL++
	    NEXT

		;実行者に対して陥落済み
		IF (CFLAG:602 < 1 || FLAG:7 == 2)
			IF CFLAG:함락캐릭터 == CFLAG:PLAYER:캐릭터고유번호
				;実行者に対して陥落済み
				PRINTFORMW 「…이런 데서 야한 짓 하고 싶어져 버린 겨?」
				PRINTFORMW 「어쩔 수 없구마. 오늘뿐이랑께? ……꺅%ハート()%」
				PRINTFORMW 「저, 정말이지, 그렇게 덤벼들믄 못써♪」
				PRINTL
				CALL EVENT_MESSAGE
				PRINTL
				;5回以上絶頂しとるかで分岐
				IF SUMARRAY(NOWEX:TARGET:0, 0, 5) > 4
					PRINTFORMW 「하아-…%ハート()%…… 하아-……%ハート()%」
					PRINTFORMW 「바깥, 대단했을지도……%ハート()%」
				ELSE
					PRINTFORMW 「응…… 기분 좋았능가?」
					PRINTFORMW 「갈 때의 \@ PLAYER == MASTER ? %CSTR:이인칭% # 당신 \@ 얼굴, 대단히 귀여웠당게♪」
					IF CFLAG:본방횟수
						PRINTFORMW 질 안에서 맥동하는 페니스를 꿀단지로 상냥하게 조여대며 %CALLNAME%은(는) 방긋 미소 지었다
					ELSE
						PRINTFORMW 달아오른 얼굴에 풀린 눈으로 바라보며 %CALLNAME%은(는) 상냥하게 미소 지었다
					ENDIF
				ENDIF
			;恋慕なのに周知で他人とセ읏クス
			ELSEIF (TALENT:연모 || TALENT:친애) && LOCAL > 3 && NO:PLAYER != 4999
				IF CFLAG:던전내발정
					IF RAND:2 == 0
						PRINTFORMW 「사실은 바람피우는 거지만서도」
						PRINTFORMW 「%CSTR:이인칭%이(가) 괜찮다고 말했응게」
					ELSE
						PRINTFORMW 「불장난, 해버릴까나%ハート()%」
					ENDIF
						PRINTFORMW 「잔뜩 서비스해줄 틴게」
						PRINTFORMW 「잔뜩 하장게%ハート()%」
					CALL EVENT_MESSAGE
					PRINTFORML 　
					PRINTFORMW 「또, 하자잉♪」
				ELSE
					PRINTFORML 「%CSTR:일인칭%가 남한테 안겨 있는디도」
					PRINTFORMW 「어째서 싱글벙글 웃고 있는 겨……」
					CALL EVENT_MESSAGE
					PRINTFORML 　
					PRINTFORMW 「이런 거 그만두소…」
				ENDIF
			ELSE
				PRINTFORMW 「이, 이런 곳에서 야한 짓을 해버리는 겨……?」

				;４人以上、もしくは＠がセ읏クスしている場合は３人以上のパ─ティ─の場合
				IF LOCAL > 3 || (NO:PLAYER == [[キャラ:당신]] && LOCAL > 2)
					PRINTFORML 「다들 보고 있는디…」
				ELSE
					PRINTFORMW 「어, 그게, %CSTR:일인칭%는 집에 돌아가고 나서가 좋은디, 라든가……」
				ENDIF
				PRINTFORMW 「꺄아앗%ハート()%」
				CALL EVENT_MESSAGE
				
			ENDIF
			CFLAG:602 = 1
		ENDIF

		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔に奉仕させる
		;奉仕する側
		;PLAYERに実行者の番号が入읏ています
		;-------------------------------------------------
	CASE 80
		IF (CFLAG:603 < 1 || FLAG:7 == 2)
			IF CFLAG:함락캐릭터 == CFLAG:PLAYER:캐릭터고유번호
				IF RAND:3
					PRINTFORMW 「전투 땜에 흥분해 있는 거제?」
					PRINTFORMW 「괜찮당게… %CSTR:일인칭%가 진정시켜줄게%ハート()%」
				ELSEIF RAND:2
					IF HAVE_PENIS(PLAYER)
						PRINTFORMW 「후후후, 그렇게 꼬추를 크게 세워버리고서, 어찌 된 겨?」
						PRINTFORMW 「어쩔 수 없구마-, %CSTR:일인칭%가 쫍쫍 빨아줄게」
						PRINTFORMW 「원하는 만큼 정액 싸재껴 보소? 큭큭」
					ELSE
						PRINTFORMW 「후후후, 그렇게 거길 흠뻑 적셔버리고서, 어찌 된 겨?」
						PRINTFORMW 「%CSTR:일인칭%한테 야한 짓 당하고 싶은 거제? 잔뜩 만지작거려줬음 싶은 거제?」
						PRINTFORMW 「큭큭, 원하는 만큼 해줄 틴게, 가는 모습 잔뜩 보여주소?%ハート()%
					ENDIF
				ELSE
					PRINTFORMW 「뭐여? …거기에 야한 짓, 해주길 바라는 겨?」
					IF PLAYER == MASTER
						PRINTFORM 「정말이지, %CSTR:일인칭%도 참
					ELSE
						PRINTFORM 「정말이지, %CALLNAME:PLAYER% 쨩도 참
					ENDIF
					PRINTFORMW 금방 못 참게 되어버린다니께-♪」
					PRINTFORMW 「그라믄 %CSTR:일인칭%가 해줄 틴게, 잔뜩 가고서 개운해지자잉%ハート()%」
				ENDIF
				CALL EVENT_MESSAGE
			ELSE
				PRINTFORMW 「응? 어찌 된 겨?」
				PRINTFORMW 「어, 에에엑!? 이런 곳에서!?」
				PRINTFORMW 「정말이지이…… 쪼까만이랑께?」
				CALL EVENT_MESSAGE
			ENDIF
			CFLAG:603 = 1
		ENDIF

		;-------------------------------------------------
		;ダンジョン内性欲処理：その場で自慰
		;奉仕する側
		;PLAYERに実行者の番号が入읏ています
		;-------------------------------------------------
	CASE 81
		IF (CFLAG:604 < 1 || FLAG:7 == 2)
			;本来だと『위험일() == 2』だ읏たが、
			;人間以外だと戻り値が「３」にな읏てしまう為、条件変更
			IF CFLAG:던전내발정 || CFLAG:위험일 > 0
				;発情中
				PRINTFORMW 「하, 하, 하아……%ハート()%」
				PRINTFORMW 「저, 정말이지… 못 참겠당게요%ハート()%」
				CALL EVENT_MESSAGE
				IF 陥落() && HAVE_VAGINA() && HAVE_PENIS(MASTER)
					PRINTFORML 「저기… %CSTR:이인칭%…」
					PRINTFORMW 「준비 다 됐응게… 이대로 하장게%ハート()%」
				ENDIF
			ELSE
				PRINTFORMW 「응, 아, 아, 안 돼애…」
				PRINTL
				CALL EVENT_MESSAGE
				PRINTL
				PRINTFORMW 「시, ㅀ, 안 돼, 다들, %CSTR:일인칭%, %CSTR:일인칭%」
				PRINTFORMW 「%CSTR:일인칭%, 이런, 곳, 보, 보지 마러어%ハート()%」
			ENDIF
			CFLAG:604 = 1
		ENDIF

		;-------------------------------------------------
		;ダンジョン内性欲処理：物陰で自慰
		;奉仕する側
		;PLAYERに実行者の番号が入읏ています
		;-------------------------------------------------
	CASE 82
		IF (CFLAG:605 < 1 || FLAG:7 == 2)
			;本来だと『위험일() == 2』だ읏たが、
			;人間以外だと戻り値が「３」にな읏てしまう為、条件変更
			IF CFLAG:던전내발정 || CFLAG:위험일 > 0
				PRINTFORMW 「하, 하, 하아……%ハート()%」
				PRINTFORMW 「저, 정말이지… 못 참겠당게요%ハート()%」
				CALL EVENT_MESSAGE
				IF 陥落() && HAVE_VAGINA() && HAVE_PENIS(MASTER)
					PRINTFORMW 「아직 안 가라앉았어……」
					PRINTFORMW 「이젠, %CALLNAME:MASTER%을(를) 덮쳐… 버릴까나♪」
				ENDIF
			ELSE
				PRINTFORMW 「이, 이젠 안 돼…」
				PRINTFORMW 「미안해, 금방 돌아올 틴게…」
				PRINTL
				CALL EVENT_MESSAGE
				PRINTL
				PRINTFORMW (이런 곳에서, 이런 짓을 하고, 만에 하나 누구한테 들키기라도 하면……)
				PRINTFORMW 「응, 아아%ハート()%」
				PRINTFORMW 「가슴이랑, 클리쨩, 쿵쾅쿵쾅 뛰어버려어%ハート()%」
			ENDIF
			CFLAG:605 = 1
		ENDIF
	CASEELSE
		CALL EVENT_MESSAGE
ENDSELECT


