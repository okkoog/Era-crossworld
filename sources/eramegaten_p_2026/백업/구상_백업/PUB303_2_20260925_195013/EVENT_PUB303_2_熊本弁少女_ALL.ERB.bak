;160,촉수소환
;-------------------------------------------------
	CASE 160
		;召喚
		IF TEQUIP:25
			;初めて
			IF CFLAG:382 == 0
				PRINTFORML 「엣, 악마 소환하는겨?」
				PRINTFORMW %CALLNAME:PLAYER%은(는) 이형의 촉수를 불러냈다
				PRINTFORML 
				PRINTFORMW 「이거 악마는 아닌 거제…」
				PRINTFORML %CALLNAME:PLAYER%이(가) %CALLNAME:TARGET%을(를) 가리키자, 이형의 촉수가 그 몸을 휘감았다
				;一部陥落済み
				IF (TALENT:음란 || TALENT:복종 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
					PRINTFORML 「엣, 뭐야 이거? 싫어어~♪」
					PRINTFORMW 비명을 지르면서도 %CALLNAME%은(는) 자기 몸에 벌어질 일에 기대하고 있는 듯하다
				ELSE
					PRINTFORML 「엣, 뭐야 이거? 싫어어~!」
				ENDIF
				CFLAG:382 = 1
			;二回目以降
			ELSE
				CALL TRAIN_MESSAGE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						PRINTFORMW 
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						IF RAND:2 == 0
							PRINTFORML 「잘 부탁혀, 미끌미끌 씨♪」
							PRINTFORMW %CALLNAME%은(는) 촉수 조교의 불쾌감마저 쾌락으로 바꾸려 하고 있다
						ELSE
							PRINTFORML 「오늘은 어데 구멍에 들어오는겨?」
							PRINTFORMW %CALLNAME%은(는) 촉수에 키스를 하며 물었다
						ENDIF
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						IF RAND:2 == 0
							PRINTFORML 「잘 부탁혀, 미끌미끌 씨♪」
							PRINTFORMW %CALLNAME%은(는) 촉수 조교의 불쾌감마저 쾌락으로 바꾸려 하고 있다
						ELSE
							PRINTFORML 「오늘도 힘내서 %CSTR:일인칭%을(를) 괴롭혀줘잉, 꿈틀꿈틀 씨♪」
							PRINTFORMW %CALLNAME%은(는) 새롭게 나타난 촉수 『주인님』에게 인사를 건넸다
						ENDIF
					ENDIF
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && FLAG:7 == 2
					PRINTFORMW 「또, 미끌미끌……」
				;それ以外
				ELSEIF FLAG:7 == 2
					IF RAND:2 == 0
						PRINTFORMW 「부탁이여, 미끌미끌은 싫당께…」
					ELSE
						PRINTFORML 「또, 미끌미끌」
						PRINTFORMW 「이제 용서해줘……」
					ENDIF
				ENDIF
			ENDIF
		;送還
		ELSE
			CALL TRAIN_MESSAGE
			;恋慕、親愛
			IF (TALENT:연모 || TALENT:친애) &&FLAG:7 == 2
				PRINTFORMW 
			;それ以外の陥落
			ELSEIF (TALENT:음란 || TALENT:복종 || TALENT:창부 || TALENT:예속) &&FLAG:7 == 2
				PRINTFORML 「오늘도 재밌었당께」
				PRINTFORML 「또 놀아주시게♪」
				PRINTFORMW %CALLNAME%은(는) 조금 쓸쓸한 듯 작별 인사를 건넸다
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3
				PRINTFORML 「겨우 끝났다…」
				PRINTFORMW %CALLNAME%은(는) 안도하면서도 조금 아쉬운 표정을 짓고 있다
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「겨우 끝났구마……」
				ELSE
					PRINTFORMW 「이제, 미끌미끌거리는 건 싫어……」
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;161,촉수삽입
;-------------------------------------------------
	CASE 161
		;触手侵入
		IF TEQUIP:바이브
			;初めて
			IF CFLAG:383 == 0
				IF TALENT:처녀
					IF TALENT:연모 || TALENT:친애
						PRINTFORML 「아파, 아프당께!」
						PRINTFORMW 「살려줘, 살려줘, %CSTR:이인칭%!」
						PRINTFORML 파과의 고통과 이형의 물체가 태내로 들어오는 감촉
						PRINTFORMW 그리고 %CALLNAME:MASTER%에게 배신당했다는 충격에 %CALLNAME%은(는) 그저 울부짖을 뿐이었다
					;淫乱、娼婦、服従、隷属
					ELSEIF TALENT:음란 || TALENT:창부 || TALENT:복종 || TALENT:예속
						PRINTFORML 「대단혀, 대단하당께!」
						PRINTFORMW 「처음이 이런 거라니, 평생 가도 못 해볼 경험이당께!」
					ELSE
						PRINTFORML 「아파, 아프당께!」
						PRINTFORMW 「살려줘, 누가 좀 구해줘!」
						PRINTFORML 파과의 고통과 이형의 물체가 태내로 들어오는 감촉과
						PRINTFORMW 그 아이를 밸지도 모른다는 공포로 인해, %CALLNAME%은(는) 그저 울부짖을 뿐이었다
					ENDIF
				ELSE
					PRINTFORMW 「무리랑께, 무리!」
					PRINTFORML 「이런 거 배 속에 안 들어간단 말이여어!」
					PRINTFORMW 처음으로 체내에 들어오는 촉수의 감각에 %CALLNAME%은(는) 비명을 지르고 있다…
				ENDIF
				CFLAG:383 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:383 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						IF RAND:3 == 0
							PRINTFORMW 「있제, 연인끼리는 이런 짓 안 한당께?」
							PRINTFORML 「그랑께 그만두시게……」
							PRINTFORMW 간원하는 %CALLNAME%을(를) 무시하고 촉수에게 태내로 침입하도록 명령했다…
						ELSEIF RAND:2 == 0
							PRINTFORMW 「지켜봐줘잉, %CSTR:이인칭%」
