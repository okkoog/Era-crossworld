					ENDIF
					CFLAG:387 = 2
				ENDIF
			ENDIF
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:387 < 4 || FLAG:7 == 2)
				;恋慕、親愛
