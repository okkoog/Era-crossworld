	CASE 36
		;寝る前に来る
		IF TALENT:B:유아／유아퇴행 || TALENT:B:유치
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:269 < 1 || FLAG:7 == 2)
				 IF TALENT:ＮＴＲ >= 1
					CALL EVENT_MESSAGE
					PRINTFORML 「%NTRNAME(CFLAG:함락캐릭터)% 씨, 같이 자자♪」
				;恋慕、親愛
				ELSEIF TALENT:연모 || TALENT:친애
					IF TALENT:츤데레 && RAND:3 == 0
						PRINTFORMW 밤, 잠자리에 들려던 %CALLNAME:E%의 방에 베개를 껴안은 %CALLNAME:B%이 찾아왔다
						PRINTFORML  
						PRINTFORML 「%CSTR:이인칭%이 외로울까 봐 와버렸지」
						PRINTFORMW 「자, %CSTR:일인칭% 잘 자리 좀 만들어줘」
						PRINTFORMW %CALLNAME:MASTER%이 몸을 움직이자 %CALLNAME%은 빈 공간으로 쏙 파고들었다
						PRINTFORML 「얼른 불 끄랑께, 내일도 일찍 일어나야제?」
						PRINTFORMW 할 일은 아직 남아 있었지만, %CALLNAME%이 재촉했기에 자기로 했다…
						PRINTFORML …………
						PRINTFORML ………
						PRINTFORML ……
						PRINTFORMW …
						PRINTFORMW （잘 자…%ハート()%）
					;サンタコ─トを着ている場合
					ELSEIF TEQUIP:90 == 1034 && RAND:3 == 0
						PRINTFORML 「산타 씨 다키마쿠라랑께%ハート()%」
						PRINTFORML 「껴안아도, 키스해도 좋으니까 말야♪」
						CALL EVENT_MESSAGE
					ELSEIF RAND:2 == 0
						CALL EVENT_MESSAGE
						PRINTFORMW 「%CSTR:이인칭%, %CSTR:일인칭% 외로워… %CSTR:이인칭% 곁이면 안심이 돼…」
						PRINTFORMW 「%CSTR:이인칭% 몸, 따뜻하네… 억수로 좋아%ハート()%… 새근」
					ELSE
						CALL EVENT_MESSAGE
						PRINTFORML 「졸릴 때까지 여러 가지 하자아%ハート()%」
						PRINTFORMW %CALLNAME%은 차와 트럼프 카드, 게임기 등 온갖 것들을 침대에 펼쳐놓았다
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORML 「오늘 밤은 혼자 안 재울 거랑께%ハート()%」
						CALL EVENT_MESSAGE
						PRINTFORML 　 
						PRINTFORML 「그런 건……… %CSTR:이인칭%…… 야해……」
						PRINTFORMW 성욕보다 수면욕이 이긴 모양이다
					ELSE
						PRINTFORML 「%CSTR:일인칭%이 자는 동안에 야한 짓 해도 괜찮으니까 말야♪」
						CALL EVENT_MESSAGE
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「열심히 한 %CSTR:일인칭%은 %CSTR:이인칭%이랑 같이 자도 괜찮아?」
				ENDIF
			ENDIF
		;寝てる所に来る
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:269 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					CALL EVENT_MESSAGE
					;サンタコ─トを着ている場合
					IF TEQUIP:90 == 1034 && RAND:3 == 0
						PRINTFORML 「산타 씨의 선물은」
						PRINTFORML 「양말 대신 침대 속에 들어있어♪」
					ELSEIF RAND:2 == 0
						PRINTFORML 
						PRINTFORML 「%CSTR:이인칭% 곁…… 안심돼…」
						PRINTFORMW %CALLNAME%은 평온한 표정을 짓고 자고 있다……
					ELSE
						PRINTFORML 「%CSTR:이인칭% 자는 얼굴, 귀여워%ハート()%」
						PRINTFORMW %CALLNAME%은 졸릴 때까지 %CALLNAME:MASTER%의 얼굴을 바라보고 있었다
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					CALL EVENT_MESSAGE
