	CASE 43
		CALL EVENT_MESSAGE
		PRINTFORML 　
		;ストリ읏プ
		IF CFLAG:극장상연목록 == 0
			;淫乱、娼婦
			IF TALENT:음란 || TALENT:창부
				IF TALENT:임신 == 1
					PRINTFORML 「자, 진짜배기 꼬마 임산부」
					PRINTFORMW 「좀처럼 못 보는 레어 영상이랑께♪」」
				ELSEIF RAND:2 == 0
					PRINTFORML 「애들 스트립 쇼 같은 건 보기만 해도 범죄인디」
					PRINTFORMW 「다들 꼬추 커져 버리고서, 못 쓰겠구마♪」
				ELSE
					PRINTFORML 「자 봐봐, 탱글탱글한 어린애 찌찌♪」
					PRINTFORMW 「다음엔 아래도 벗어버릴 틴게, 눈 깜빡거리면 안 된데이」
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				IF RAND:2 == 0
					PRINTFORML 「주인님헌티 조교당한 몸, 보여줄게」
					PRINTFORMW 「자, 여그는 채찍 자국이고, 여그는 촛농 자국…」
				ELSE
					PRINTFORMW 「오늘은 와줘서 고마워」
					PRINTFORML 「주인님헌티 명령받아서」
					PRINTFORML 「여그서 돈 벌어가꼬 안 가믄 벌 안 내려준당게」
					PRINTFORMW 「다들 와줘서 기쁘구마」
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「애들은 이런 데서 이런 짓 하믄 안 되는디…」
				ELSE
					PRINTFORML 「야한 눈으로 보지 마러…」
				ENDIF
			ENDIF
		;ポ─ルダンス
		ELSEIF CFLAG:극장상연목록 == 1
			;淫乱、娼婦
			IF TALENT:음란 || TALENT:창부
				IF RAND:3 == 0
					PRINTFORML 「봉타기는 학교서 맨날 놀아가꼬 자신 있당게」
					PRINTFORMW 「보지 문대민서 올라가믄 기분 좋아, 라고 깨달은 뒤부터 매일 놀았응게 말여♪」
				ELSEIF HAVE_VAGINA() && RAND:2 == 0
					PRINTFORML 「어째서 안 떨어지냐고?」
					PRINTFORMW 「보지로 봉을 꽉 끼워 물고 있응껜 말이제♪」
				ELSE
					PRINTFORML 
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORML 
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「애들은 이런 데서 이런 짓 하믄 안 되는디…」
				ELSE
					PRINTFORML 「야한 눈으로 보지 마러…」
				ENDIF
			ENDIF
		;オナニ─ショ─
		ELSE
			;淫乱、娼婦
			IF TALENT:음란 || TALENT:창부
				IF (EXP:출산경험 > 1 || EXP:Ｖ확장경험 > 100) && RAND:4 == 0
					PRINTFORML 「이게 바로 꼬마 보지랑께♪」
					PRINTFORMW %CALLNAME%은(는) 한 손으로 비순을 벌리더니, 다른 한 손을 안에 넣기 시작했다
					PRINTFORML 「보통으로 쑥 들어가지?」
					IF EXP:출산경험 > 1
						PRINTFORMW 「경산부인게 이 정도는 끄떡없당께♪」
					ELSE
						PRINTFORMW 「맨날 보지에 넣는 거에 비하믄 쪼그마한게 말여♪」
					ENDIF
				ELSEIF TALENT:오줌싸개버릇 && RAND:3 == 0
					PRINTFORML 「%CSTR:일인칭%, 갈 때 오줌 싸버릴 틴게 앞엣사람들은 조심하소」
					PRINTFORMW 그 말을 듣자 앞줄에 있던 관객의 1/3은 뒤로 물러났지만, 나머지 관객은 비어버린 앞줄로 몰려들었다
				;花電車
				ELSEIF RAND:2 == 0
					PRINTFORML 「애들은 이런 짓 하믄 안 되응게 비밀이랑께」
					PRINTFORMW %CALLNAME%은(는) 아래 입으로 담배를 뻐끔거리고 있다
					PRINTFORML 「도넛 링도 만들 수 있당게♪」
					PRINTFORMW 아래 입에서 뿜어져 나온 연기는 훌륭하게 동그라미 고리를 만들고 있다
				ELSE
					PRINTFORML 「뒤에 있는 오빠야도 폼 잡지 말고 앞으로 온나」
					PRINTFORMW 「괜찮여, 앞엣사람들도 다 꼬추 빳빳하게 세우고 있응게♪」
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				IF TALENT:처녀 == 0 && EXP:Ｖ확장경험 > 50 && EXP:고통쾌락경험 > 50 && RAND:3 == 0
					PRINTFORML 「그라믄… 이걸로 자위할팅게…%ハート()%」
					PRINTFORMW %CALLNAME%은(는) 흉악한 돌기가 돋친 자기 팔뚝만 한 딜도에 혀를 굴리더니 군침을 로션 삼아 질 속으로 삼켜넣기 시작했다
					PRINTFORML 「이것뿐만이 아니랑께」
					PRINTFORMW %CALLNAME%이(가) 딜도의 스위치를 켜자 요란한 소리를 내며 딜도가 움직이기 시작했다…
				ELSEIF RAND:2== 0
					PRINTFORML 「보고 있어봐, 전극 자위♪」
					PRINTFORMW %CALLNAME%은(는) 스스로 젖꼭지와 클리토리스에 단자를 장착했다
					PRINTFORML 「그라믄……」
					PRINTFORMW 「스위치, 오~온♪」
					PRINTFORML 　
					IF RAND:2 == 0
						PRINTFORML 「히익, 히, 히, 힉, 찌, 찌찌 찌릿해애앳♪」
					ELSE
						PRINTFORML 「크, 클, 리토리스 구운 밤이 되…어버려엇!」
					ENDIF
					PRINTFORML 온갖 액체를 줄줄 흘리며, 활어처럼 무대 위에서 파닥파닥 튀어 오르며 %CALLNAME%은(는) 절정을 거듭하고 있다…
				ELSE
					PRINTFORML 
				ENDIF
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「애들은 이런 데서 이런 짓 하믄 안 되는디…」
				ELSE
					IF RAND:2 == 0
						PRINTFORML 「어… 어째서…… 앗♪」
					ELSE
						PRINTFORML 「응… 보지 마러…」
					ENDIF
					PRINTFORMW  반쯤 울먹이며 자위를 선보이는 %CALLNAME%의 모습에 흥분한 관객들은 환호성을 질렀다
				ENDIF
			ENDIF
		ENDIF


