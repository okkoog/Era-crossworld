		PRINTFORMW 「아…… 버, 벌써 끝나는겨?」
		IF RAND:3 == 0
			PRINTFORML 「오늘도 가~득 괴롭혀줘서 고마웠구먼유, %CSTR:이인칭%」
		ELSEIF RAND:2 == 0
			PRINTFORML 「다음엔… 더 심하게 부탁드려유」
		ELSE
			PRINTFORML 「이거, 애태우기 플레이인 거제?」
		ENDIF
		PRINTFORMW %CALLNAME%은(는) 더 괴롭힘당하고 싶은 눈치지만 무시하고 등을 돌렸다.
	ENDIF
	CFLAG:219 = 4
ENDIF
RETURN 0

;--------------------------------------------------
;@KOJO_MESSAGE_COM関係（X1をキャラ番号に置換）
;コマンド実行時に出力されます
;--------------------------------------------------
@KOJO_MESSAGE_COM_PUB303_2
;助手が調教した時に口上をスキ읏プする（好みに応じて使う、行頭の;を消すとスキ읏プするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0
;ボ─ルギャグ着用時には地の文を表示して口上をスキ읏プする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL TRAIN_MESSAGE
	RETURN 0
ENDIF

;--------------------------------------------------
;自動喘ぎ声呼び出し
;尚、この呼び出し用構文はコマンド毎の口上が揃읏てきたら削除します
;口上がこれを前提としたものにな읏た場合はその限りではありません。
;--------------------------------------------------
;SIF FLAG:自動喘ぎ声
;	CALL TRAINVOICE

;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_COM_PY1_PUB303_2
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_COM_PY1_PUB303_2
;		RETURN 0
;	ENDIF
;ENDIF



;-------------------------------------------------
;コマンド実行時のセリフ CFLAG 300～500
;-------------------------------------------------
;=================================================
;愛撫系コマンド
;=================================================
;-------------------------------------------------
;0,애무
;-------------------------------------------------
SELECTCASE SELECTCOM
	CASE 0
		;地の文「%CALLNAME:TARGET%の～」の前に言葉がかからない場合のみ、ロ─ション愛撫である事とする
		;前に言葉がかかると文章おかしくなるので
		SIF TEQUIP:Ｖ섹스 == 0 && (TALENT:MASTER:불결무시 || ASSIPLAY) && TALENT:날개 == 0 && TALENT:꼬리 == 0 && !PLAY_KISS(PLAYER, TARGET) && TFLAG:800 == 1
			PRINTFORM 로션투성이가 된 

		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:300 == 0 && FLAG:7 == 2
			IF TALENT:연모 || TALENT:친애
				IF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐
					PRINTFORML 「꺄악!?」
					PRINTFORMW 「느닷없이 어딜 만지는겨!」
					PRINTFORMW 「아, 안 된다곤 안 했당께」
					PRINTFORMW 「좀 더 그…… 살살… 만져줬으면 좋겠다거나」
				ELSE
					PRINTFORML 「손이 따스허고 보드라워서, 쓰다듬어지기만 하는디도 왠지 몽실몽실해져 버릴 것 같구먼」
					PRINTFORMW 「응, 괜찮당께. 더 %CSTR:일인칭%의 몸을 만지고 느껴주시게?」
				ENDIF
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORMW 「싫엉, 거기, 앗%ハート()%」
				PRINTFORMW 「쿵덕쿵덕 밀려와서, 못 참겠구먼%ハート()%」
			ELSEIF TALENT:복종 || TALENT:예속
				IF TALENT:소인체형
					PRINTFORMW 「우후후… %CSTR:이인칭%의 인형이 된 것 같구먼」
					PRINTFORMW 「더 잔뜩 만져줘… 더, %CSTR:일인칭%으로 야한 인형놀이 해줘%ハート()%」
				ELSE
					PRINTFORMW 「%CSTR:이인칭%은 장난감을 소중히 다뤄주는구먼」
					PRINTFORMW 「요래 살살 만져주고… 써줘서, 쪼까 기쁠지도」
				ENDIF
			ELSEIF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐
				PRINTFORMW 「어딜 만지는겨, 변태!」
				PRINTFORMW 「간지럽기도 하고, 손놀림도 뭔가 응큼하구먼! 증말!」
			ELSEIF TALENT:소악마
				PRINTFORMW 「%CSTR:일인칭%의 거기나 가슴을 만지고 싶은겨?」
				PRINTFORMW 「으~음…… 어쩔까나~♪ 만지게 해줄까나~♪」
			ELSE
				PRINTFORMW 「뭐, 뭔가 만지는 품이 음흉하당께?」
			ENDIF
			CFLAG:300 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;（穴開き）スク水ロ─ションプレイ
					IF (TEQUIP:전신속옷 == 710 || TEQUIP:전신속옷 == 711) && CFLAG:800 == 1
						PRINTFORML 「응…♪」
						PRINTFORML 「미끌거려서 간지럽기는 한디…」
						PRINTFORML 「기분 좋아%ハート()%」
					;前回コマンドが愛撫させる
					ELSEIF PREVCOM == 99
						IF TALENT:PLAYER:남자 == 0 && TALENT:남자 == 0 && TALENT:남성혐오
							PRINTFORML 「아앙♪」
							PRINTFORML 「여자끼리라도 요래 기분 좋으니께」
							PRINTFORML 「남자 따윈 필요 없구먼%ハート()%」
						ELSE
							PRINTFORMW 「아까 전의 복수를 당하는구먼♪」
						ENDIF
					ELSE
						PRINTFORMW 「%CSTR:이인칭%의 손길, 보드라워서… 하, 앗, 앙, 억수로 좋아…%ハート()%」
						PRINTFORM 「더, 더 만져줘…… 
						IF TALENT:아내
							PRINTFORM %CSTR:이인칭%의 귀여운 어린 신부
						ELSE
							PRINTFORM %CSTR:일인칭%
						ENDIF
						PRINTFORML 를 가~득 사랑해줘어…%ハート()%」
					ENDIF
					PRINTFORMW 촉촉한 눈으로 올려다보며, %CALLNAME%은(는) 스스로 몸을 비벼대고 있다.
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「앗, 앗, 아앙%ハート()%」
					IF RAND:2 == 0
						PRINTFORML 「더, 더 만져줘… 가슴도, \@ TALENT:남자 ? 자지 # 보지\@도오%ハート()%」
						PRINTFORMW 정욕에 젖은 눈으로 올려다보며, %CALLNAME%은(는) 몸을 강하게 밀착시켜 더한 쾌락을 얻으려 하고 있다.
					ELSE
						PRINTFORM 「애태우지 말고 
						IF TALENT:남자 || TALENT:오토코노코
							PRINTFORML 자지를 써줘어」
						ELSEIF TALENT:후타나리
							PRINTFORML 자지랑 보지 맞대줘어」
						ELSE
							PRINTFORML 보지에 뭔가 주셔어」
						ENDIF
						PRINTFORMW 정욕에 젖은 눈으로 올려다보며, %CALLNAME%은(는) 한층 더한 조교를 간청했다.
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「하아앙%ハート()%」
					IF RAND:2 == 0
						PRINTFORML 「더 맘껏 주물럭거려도 된단 말이여?」
						PRINTFORMW 「%CSTR:일인칭%의 야한 가슴도 \@ TALENT:남자 ? 자지 # 보지\@도, %CSTR:이인칭%의 것이니께%ハート()%」
					ELSE
						PRINTFORMW 「다음엔 %CSTR:일인칭%이 기분 좋게 해줄 텐게」
					ENDIF
				ENDIF
				CFLAG:300 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:300 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORMW 「히양앗! …마, 만지는 게 왠지 억수로 야릇한 기분이 될 것 같당께…」
				ELSE
					PRINTFORMW 「안 돼! 이 이상 당해버리믄… %CSTR:일인칭%, 이상해져 버린당께!」
				ENDIF
				CFLAG:300 = 3
			;それ以外
			ELSEIF CFLAG:300 < 2 || FLAG:7 == 2
				;（穴開き）スク水ロ─ションプレイ
				IF (TEQUIP:전신속옷 == 710 || TEQUIP:전신속옷 == 711) && CFLAG:800 == 1
					PRINTFORML 「응…♪」
					PRINTFORML 「느, 느끼는 거 아녀, 간지러울 뿐이랑께」
					PRINTFORMW %CALLNAME:MASTER%은(는) 가랑이가 유독 미끌거린다는 점을 지적했다
					PRINTFORML 
					PRINTFORMW 「그건… 로션! 로션이랑께!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「조, 쪼매만 더 살살 만져주믄 좋겠구먼…… 읏」
				ELSE
					PRINTFORMW 「기, 기분 좋지 않당께…… 으앙」
				ENDIF
				CFLAG:300 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;1,커닐링구스
;-------------------------------------------------
	CASE 1
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:301 == 0 && FLAG:7 == 2
			IF TALENT:연모 || TALENT:친애
				IF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐 || TALENT:부끄럼쟁이
					PRINTFORMW 「으으으……」
					PRINTFORMW %CSTR:일인칭%은(는) \@ TALENT:소인체형 ?# %CALLNAME:MASTER%의 머리를 짓누르면서, \@얼굴을 새빨갛게 물들이고 눈을 꼭 감고 있다
					PRINTFORMW %CALLNAME:MASTER%의 눈앞에 비부가 드러나 있는 것이 부끄러워 견딜 수 없는 모양이다
				ELSE
					PRINTFORMW 「읏, 윽, 후우, 으응」
					PRINTFORMW 「에, 헤헤. %CSTR:이인칭%, %CSTR:일인칭%의 콩알에 뽀뽀하는 것 같구먼……」
					PRINTFORMW 「살짝 질투 날지도? 후후후」
				ENDIF
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORMW 「에헤헤, %CSTR:이인칭%이 클리에 뽀뽀한당~%ハート()%」
				PRINTFORMW 「더, 더 세게 쪽쪽 빨아줬으면 좋겠구먼♪」
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORML 「%CSTR:이인칭%, 그런 데를 핥아대믄 더럽잖여어%ハート()%」
				PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%이(가) 핥을 때마다 화들짝 몸을 떨고 있다
			;陥落してない
			ELSE
				IF TALENT:처녀
					IF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐
						PRINTFORMW 「히양앗!?」
						PRINTFORMW 「시, 싫어, 그런 데 핥지 말어!」
						PRINTFORMW 「바보야, 변태야! 오줌 누는 데를 핥아서 뭐가 신난다고 그랴!」
						IF TALENT:소인체형
							PRINTFORMW %CALLNAME%은(는) 얼굴을 새빨갛게 물들인 채, 틈새를 핥아 올리는 %CALLNAME:MASTER%의 얼굴을 찰싹찰싹 때렸다.
						ELSE
							PRINTFORMW %CALLNAME%은(는) 얼굴을 새빨갛게 물들인 채, 가랑이에 파묻힌 %CALLNAME:MASTER%의 머리를 콩콩 쥐어박았다.
						ENDIF
					ELSE
						PRINTFORMW 「%CSTR:일인칭%의 보지를 핥고 싶은겨~?」
						PRINTFORMW 「%CSTR:이인칭%도 참 응큼하기는~♪ ……조금뿐이랑께?」
					ENDIF
				ELSE
					IF TALENT:소악마
						PRINTFORMW 「%CSTR:일인칭%의 보지 핥고 싶어~?」
						PRINTFORMW 「%CSTR:이인칭%도 참 응큼해~♪ ……조금뿐이야?」
					ELSE
						PRINTFORMW 「%CSTR:일인칭%의 보지 핥을 거야?」
						IF TALENT:부끄럼쟁이
							PRINTFORMW 「부, 부끄러우니까 너무 거기 쳐다보면 안 돼?」
							PRINTFORMW %CSTR:일인칭%은(는) 얼굴을 가린 채 가만히 %CALLNAME:MASTER%의 혀를 받아들이고 있다……
						ELSEIF TALENT:Ｃ민감
							PRINTFORMW 「살살, 살~살 핥아줘…? 찌릿찌릿 저려오는 곳이니까……」
							PRINTFORMW 「읏… 냐, 아앙! 자, 잠깐! 조금만 더… 으응!」
						ELSEIF TALENT:유아체형 || TALENT:소인체형
							PRINTFORMW 「으~…… 털 없이 매끈하다고 애 취급하면 안 되니까 말야」
						ELSE
							PRINTFORMW 「거기, 자지 넣는 곳이지?」
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			CFLAG:301 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:301 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF TALENT:부끄럼쟁이
						PRINTFORMW 「히양앗%ハート()% 부, 부끄러우니까 아앙%ハート()%」
						PRINTFORMW 「너무 핥으면 안 돼애, 아앙%ハート()%」
					ELSE
						PRINTFORMW 「아… 앗…%ハート()%」
						IF RAND:5  == 0
							PRINTFORM 「……미안해, ……
							IF TALENT:아내
								PRINTFORM %CSTR:이인칭%의 색시인데도, 
							ENDIF
							PRINTFORMW %CSTR:일인칭%의 거기, 너무 쪼끄매서……」
							PRINTFORMW %CALLNAME%은(는) 쾌감에 떨며, 부끄러운 듯 가랑이를 꽉 밀착시켜 왔다.
						ELSE
							PRINTFORMW %CALLNAME%은(는) 쾌감에 떨며 스스로 가랑이를 강하게 꽉 밀착시켜 왔다.
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「히야앙%ハート()% 클리 기분 좋아아%ハート()%」
						PRINTFORMW 「더 보지 낼름낼름 핥아줘어%ハート()%」
					ELSE
						PRINTFORMW 「아핫%ハート()% %CSTR:일인칭%의 보지, 벌써 흠뻑 젖어버렸으니까…」
						PRINTFORMW 「얼른 섹스하자%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭%의 보지… 앙, 맛있어?」
					ELSE
						PRINTFORML 「%CSTR:이인칭%의 혀가 너무 기분 좋아서…」
						PRINTFORMW 「아앙, 더는 못 참겠어… 미안해……」
					ENDIF
				ENDIF
				CFLAG:301 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:301 < 3 || FLAG:7 == 2)
				PRINTFORMW 「크, 클리, 핥아지면 찌릿찌릿 울려어… 앗, 앗 아앗%ハート()%」
				CFLAG:301 = 3
			;それ以外
			ELSEIF CFLAG:301 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「그, 그런 데를 핥아대면 부끄럽잖아…… 으응」
				ELSE
					PRINTFORMW 「싫어… 기분 나쁘단 말야……」
				ENDIF
				CFLAG:301 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;2,펠라한다
;-------------------------------------------------
	CASE 2
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:302 == 0 && FLAG:7 == 2
			;陥落済み
			IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;フェラ経験あり
					IF CFLAG:345 >= 1
						PRINTFORMW 「%CSTR:일인칭%의 자지?」
						PRINTFORML 「괘, 괜찮기는 한디…」
						PRINTFORMW %CALLNAME%의 페니스는 기대와 흥분과 부끄러움으로 크게 하늘을 우러러보고 있다.
						PRINTFORML 「하는 건 늘상 해왔지만서도, 당하는 건 처음이고…」
						PRINTFORML 「게다가, %CSTR:이인칭%이…… 아앙%ハート()%」
						PRINTFORMW 페니스를 살짝 쥐기만 했는데도 %CALLNAME%은(는) 탄성을 내질렀다.
					ELSE
						PRINTFORML 「%CSTR:일인칭%의 자지, 잡아먹히는겨?」
						PRINTFORMW %CALLNAME%의 페니스를 입에 물려고 하자 %CALLNAME%은(는) 겁먹은 기색으로 물어왔다.
						PRINTFORML 
						PRINTFORML 「앗%ハート()% 자지가, 따숩고 근질근질해서…%ハート()%」
						PRINTFORMW %CALLNAME:MASTER%이(가) 페니스를 입에 머금자마자 겁먹었던 기색은 금세 사라졌다.
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;フェラ経験あり
					IF CFLAG:345 >= 1
						PRINTFORML 「자지 핥는 건 늘상 해봤지만서도, 빨리우는 건 처음이랑께%ハート()%」
						PRINTFORMW %CALLNAME%의 페니스는 기대와 흥분으로 크게 하늘을 우러러보고 있다.
						PRINTFORMW 「얼른%ハート()%」
					ELSE
						PRINTFORML 「펠라치오제? 알고 있당께」
						PRINTFORMW %CALLNAME%의 페니스를 입에 물려고 하자 %CALLNAME%이(가) 즐거운 듯 대답했다.
						PRINTFORMW 「이것저것 공부도 했고, 친구 키리 짱도 해본 적 있다고 그랬응게…」
						PRINTFORMW 「그치만 빨리는 건 %CSTR:일인칭%이 맨 처음일라나%ハート()%」
					ENDIF
				;服従、隷属
				ELSE
					;助手がフェラしている
					IF ASSI > 0 && (ASSIPLAY == 1)
						PRINTFORML 「！　%CSTR:이인칭%！」
						PRINTFORMW %CALLNAME%은(는) %CALLNAME:PLAYER%의 혀놀림에 그만 허리를 뒤로 뺀다.
						PRINTFORML 
						PRINTFORML 「%CSTR:이인칭%… 너무 기분 좋아서…」
						PRINTFORML 「저, 저기… 정액 더는 못 참겠구먼」
						PRINTFORMW %CALLNAME:MASTER%에게 사정을 금지당한 %CALLNAME:TARGET%은(는) 엉덩이를 실룩이며 사정을 참고 있다.
					ELSE
						PRINTFORML 「！　%CSTR:이인칭%！」
						PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%의 혀의 감촉에 그만 허리를 뒤로 뺀다.
						PRINTFORML 
						PRINTFORMW 「%CSTR:이인칭%이 %CSTR:일인칭%의 자지를……」
						PRINTFORMW 「%CSTR:일인칭%, 억수로 행복하당께%ハート()%」
					ENDIF
				ENDIF
			ELSE
				PRINTFORMW 「이, 이게 뭐여!?」
				PRINTFORMW 「이, 이런 거, 너무 기분 좋아서 안 돼, 안 된당께!」
			ENDIF
			CFLAG:302 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:302 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:이인칭%한테 자지를 낼름낼름 빨리니께 억수로 기분 좋구먼%ハート()%」
						PRINTFORMW 「그치만 쪼까 부끄럽당께」 
					ELSE
						PRINTFORMW 「기분 좋아서 금방 나와버리면 죄송해유」
						PRINTFORMW 「그치만 기분 좋으니께%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「아냐앙%ハート()% 자지 기분 좋구먼유%ハート()%」
					ELSE
						PRINTFORMW 「%CSTR:이인칭%의 입보지, 기분 좋아서 억수로 좋당께%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭%의 자지, 좋을 대로 쪽쪽 빨아주시게♪」
					ELSE
						PRINTFORML 「%CSTR:이인칭%…」
						PRINTFORMW 「%CSTR:일인칭%, 기분 좋아서… 정액 나와버려……」
					ENDIF
				ENDIF
				CFLAG:302 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:302 < 3 || FLAG:7 == 2)
				PRINTFORMW 「자지 낼름낼름 빨리니께 기분 좋아져 버린당께…」
				CFLAG:302 = 3
			;それ以外
			ELSEIF CFLAG:302 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「싫엉… 자지 핥는 거 싫당께」
				ELSE
					PRINTFORMW 「부탁이여… 자지 잡아먹지 말어……」
				ENDIF
				CFLAG:302 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;3,손가락삽입
;-------------------------------------------------
	CASE 3
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:303 == 0 && FLAG:7 == 2
			;陥落済み
			IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				IF TALENT:처녀
					PRINTFORMW 「가랑이에 손가락을 넣는겨? 자지가 아니어도 되는겨?」
				ELSE
					PRINTFORML 「보지의 준비운동인 거로구먼?」
					PRINTFORMW 「준비운동을 제대로 안 하믄 다쳐버리니께」
				ENDIF
			ELSE
				PRINTFORMW 「어, 손가락을 가랑이에? 싫어, 안 들어간단 말야!」
			ENDIF
			CFLAG:303 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:303 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORML 「응, 아, 앗…… 아, 거기, 좋아…… 읏!」
					ELSE
						PRINTFORML 「아아…… %CSTR:이인칭%의 손가락 움직임, 야하당께… 히앗!」
					ENDIF
					PRINTFORMW 흠뻑 젖은 비부를 휘젓는 손가락의 감촉에, %CALLNAME%은(는) 몸을 떨며 애액을 넘쳐나게 했다.
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORML 「아, 아앙! 좋아! …더! 더 질퍽질퍽 헤집어줘어!」
					ELSE
						PRINTFORML 「손가락 따위론, 아, 안 찬단 말이여」
						PRINTFORML 「더 큼직한 걸로 주셔!」
						PRINTFORM 말과는 딴판으로 
					ENDIF
					PRINTFORMW %CALLNAME%의 질내는 탐욕스럽게 손가락을 물고, 빨아들이듯 부드러운 질벽으로 세게 조여온다.
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「응후, 읏… 딱히, 앗, 안 적셔도… 넣어도, 괜찮잖여? 아, 하앙」
					ELSE
						PRINTFORML 「응후, 읏… %CSTR:일인칭%, 노예니께」
						PRINTFORMW 「더 빙글빙글 헤집어줘…」
					ENDIF
				ENDIF
				CFLAG:303 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:303 < 3 || FLAG:7 == 2)
				PRINTFORMW 「응, 아, 아앙…… 손가락, 기분 좋아…… 아, 앗」
				CFLAG:303 = 3
			;それ以外
			ELSEIF CFLAG:303 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「응, 이런 거…… 안 되는디… 말여… 앗」
				ELSE
					PRINTFORMW 「아팟! 좀 더 살살 해주시게나…」
				ENDIF
				CFLAG:303 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;4,애널핥기
;-------------------------------------------------
	CASE 4
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:304 == 0 && FLAG:7 == 2
			;陥落済み
			IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				PRINTFORMW 「어, 엉덩이를 핥는겨!?」
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「거긴, 내보내거나… 넣거나 하는 데지, 핥는 데가 아녀」
					PRINTFORMW 「그치만, %CSTR:이인칭%이 하고 싶다믄…… 괜찮당께%ハート()%」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「아직 해본 적은 없지만서도, 기분 좋겠제?」
				;服従、隷属
				ELSE
					PRINTFORMW 「거긴 핥는 데가 아니지만서도… 괜찮당께, %CSTR:이인칭% 마음대로 하셔」
					PRINTFORMW 「그치만 %CSTR:일인칭%은 %CSTR:이인칭%의 노예니께%ハート()%」
				ENDIF
			ELSE
				PRINTFORMW 「그, 그런 더러운 데까지 핥는겨!?」
				PRINTFORMW 「거긴, 핥는 데가 아녀, 지저분하잖여!?」
			ENDIF
			CFLAG:304 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:304 < 4 || FLAG:7 == 2)
				;前回コマンドが浣腸器＋プラグの場合
				IF PREVCOM == 146
					CALL KOJO_ANAL_SENJYOUSUMI_2
				;恋慕、親愛
				ELSEIF TALENT:연모 || TALENT:친애
					IF TALENT:부끄럼쟁이
						PRINTFORMW 「부끄럽기는 한디… %CSTR:이인칭%이 핥고 싶다믄, 괜찮당께…」
					ELSE
						PRINTFORMW 「앗… 앗… 낼름낼름 기분 좋아…… 더 해줘어…%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「엉덩이…… 풀어주는겨?」
						PRINTFORMW 「네, 어서유%ハート()%」
					ELSE
						PRINTFORMW 「엉덩이 핥고 싶은겨?」
						PRINTFORMW 「괜찮당께, %CSTR:일인칭%도 기분 좋응게%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭%의 엉덩이, 풀어주는 거로구먼」
						PRINTFORMW 「잔뜩 쓸 수 있게끔, 제대로 풀어둬야제%ハート()%」
					ELSE
						PRINTFORML 「말씀하신 대로 깨끗이 씻어뒀당께, %CSTR:일인칭%」
						PRINTFORMW 「%CSTR:이인칭%이 몹쓸 병에 걸려버리믄 싫응게」
					ENDIF
				ENDIF
				CFLAG:304 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:304 < 3 || FLAG:7 == 2)
				PRINTFORMW 「아, 으응, 어, 엉덩이 구멍이 근질근질거린당께……」
				CFLAG:304 = 3
			;それ以外
			ELSEIF CFLAG:304 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「더럽당께… 역시 이상혀, 이런 건」
				ELSE
					PRINTFORMW 「또 하는겨…… 변태」
				ENDIF
				CFLAG:304 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;5,애널애무
;-------------------------------------------------
	CASE 5
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:305 == 0 && FLAG:7 == 2
			;陥落済み
			IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORML 「거긴… 짝짓기하는 데가 아녀」
					PRINTFORMW 「그치만, %CSTR:이인칭%이 하고 싶다믄… 괜찮당께%ハート()%」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORML 「엉덩이 준비운동인 거로구먼?」
					IF RAND:2 == 0
						PRINTFORMW 「준비운동을 제대로 안 하믄 다쳐버리니께」
					ELSE
						PRINTFORMW 「느닷없이 푹 찔러넣어도 괜찮은디%ハート()%」
					ENDIF
				;服従、隷属
				ELSE
					PRINTFORML 「거긴 짝짓기하는 데가 아녀, %CSTR:이인칭%?」
					PRINTFORMW %CALLNAME:MASTER%은(는) 아랑곳하지 않고 애무를 계속한다
					PRINTFORML 「지, 진심인 게로구먼, %CSTR:이인칭%」
					PRINTFORMW 「그라믄……」
					PRINTFORML 
					PRINTFORML 「%CSTR:일인칭%의 엉덩이 구멍, 야한 구멍으로 만들어주셔」
					PRINTFORMW %CALLNAME%은(는) 다소곳한 어조로 조교를 계속해 줄 것을 간청했다
				ENDIF
			ELSE
				PRINTFORMW 「엉덩이, 만지는겨? …히얏!?」
				PRINTFORMW 「아, 아니여. 거긴 그런 짓을 하는 데가 아녀!」
			ENDIF
			CFLAG:305 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:305 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「싫, 싫어…… 아앗!」
					PRINTFORMW %CALLNAME%은(는) \@TALENT:유아체형 || TALENT:소인체형 ? 살집이 얇은 어린 # 엉\@덩이를 떨면서도, 순순히 몸을 맡기고 있다.
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「아하아♪ 좋아, 좋당께, 엉덩이 보지 기분 좋아아…」
						PRINTFORML 「저기, 더 해줘어%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 애널에서 솟구치는 쾌락에 몸을 푹 맡긴 채, 엉덩이를 강하게 밀착시켜 왔다.
					ELSE
						PRINTFORML 「더 굵고 긴 게 좋당께%ハート()%」
						PRINTFORMW 손가락 애무로는 성에 안 차는지 %CALLNAME%은(는) 스스로 허리를 움직이며 한층 더한 쾌락을 끌어내려 하고 있다.
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「하아앙, 엉덩이이♪ 빙글빙글 휘저어지는 거 기분 좋당께%ハート()%」
					PRINTFORMW 원하는 대로 거칠게 손가락을 애널에 찔러 넣고, 구멍을 넓히듯 휘저어 주었다.
				ENDIF
				CFLAG:305 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:305 < 3 || FLAG:7 == 2)
				PRINTFORMW 「응큿… 읏, 으앗」
				PRINTFORMW 아무래도 조금씩이나마 쾌감을 받아들이고 있는 모양이다.
				CFLAG:305 = 3
			;それ以外
			ELSEIF CFLAG:305 < 2 || FLAG:7 == 2
				PRINTFORMW 「아, 아프기만 하당께. 그만해…」
				CFLAG:305 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;6,가슴주무르기
;-------------------------------------------------
	CASE 6
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:306 == 0 && FLAG:7 == 2
			;陥落済み
			IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				;ち읏ぱい
				IF BUST() < 3
					PRINTFORMW 「가슴이 쪼끄매서 미안혀…」
				;で읏ぱい
				ELSEIF BUST() > 3
					PRINTFORMW 「어뗘? 커다란 가슴이여%ハート()%」
				ELSE
					PRINTFORMW 「가슴 주무르믄 커진다는 거 진짜여?」
				ENDIF
			ELSE
				PRINTFORMW 「히얏! 시, 싫엉! …간지럽단 말이여」
			ENDIF
			CFLAG:306 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:306 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						;巨乳or爆乳〇学生
						IF BUST() > 3
							PRINTFORML 「아직 어린애인디도 요래 큼직한 %CSTR:일인칭%의 가슴」
							PRINTFORML 「좋을 대로 해도 된당께…」
						ELSE
							PRINTFORML 「아직 크진 않지만서도, %CSTR:일인칭%의 가슴 좋을 대로 만져도 된당께…」
						ENDIF
					ELSE
						PRINTFORMW 「%CALLNAME%의 가슴… 좋아? 응, 아…… 앗, 아앙」
						PRINTFORM 「……응, 좋아, %CSTR:이인칭% 좋을 대로 해줘…… %CSTR:일인칭%도, 
							IF TALENT:아내
								PRINTFORM 야한 서방님
							ELSE
								PRINTFORM %CSTR:이인칭%
							ENDIF
						PRINTFORMW 한테, 가슴 조물딱거려지는 거 억수로 좋아하니께…… 아, 앙, 히응!」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) 스스로 가슴을 내밀며, 주어지는 쾌락에 몸을 떤다……
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「핫, 아, 아앙! 가슴 너무 좋아아… 앙, 아앙!」
					PRINTFORML 「더, 더 세게 마구 주물러줘어%ハート()% 앙! 아앙!」
					PRINTFORMW %CALLNAME%은(는) 가슴에서 전해지는 쾌감에 전율하며, 음란하게 모양을 바꾸는 자신의 유방을 보며 황홀경에 빠져 있다……
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORML 「더… 더 아플 정도로 꽉 쥐어줘어」
						PRINTFORMW 조르는 %CALLNAME%을(를) 싱글벙글 바라보며 부드럽게 가슴을 주물렀다.
					ELSE
						PRINTFORML 「가슴 조물조물뿐만 아니라, 더… 더…」
						PRINTFORMW %CALLNAME%의 간청을 무시하고 가슴을 한층 더 주물러댔다
					ENDIF
				ENDIF
				CFLAG:306 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:306 < 3 || FLAG:7 == 2)
				PRINTFORMW 「응, 아… 기분… 좋아…… 읏, 앗, 앗, 앗」
				CFLAG:306 = 3
			;それ以外
			ELSEIF CFLAG:306 < 2 || FLAG:7 == 2
				PRINTFORMW 「그랑게 간지럽단 말이여… 싫, 히양!」
				CFLAG:306 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;7,유두자극
;-------------------------------------------------
	CASE 7
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:307 == 0 && FLAG:7 == 2
			;陥落済み
			IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				PRINTFORML 「아앙%ハート()% 젖꼭지가 찌릿찌릿 울려…」
				PRINTFORMW 「그치만, 이거 기분 좋아…%ハート()%」
			ELSE
				PRINTFORMW 「시, 싫엉! 꼭지 만지작거리지 말어!」
			ENDIF
			CFLAG:307 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:307 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;童貞を殺すセ─タ─で、その上にも下にも何も着けていない場合
					IF TEQUIP:81 == 130 && TEQUIP:83 == 0 && TEQUIP:85 == 0 && TEQUIP:87 == 0 && TEQUIP:90 == 0
						PRINTFORML 「옷 입고 있는디♪ 구멍으로 손 집어넣어서♪ 젖꼭지 괴롭혀지고♪」
						PRINTFORMW 「좋아%ハート()% %CSTR:이인칭%, 좋아%ハート()%」
					ELSE
						PRINTFORML 「에헤헤, 왠지 아기 같구먼… 아, 앙, 좋아, 더어%ハート()%」
						PRINTFORMW %CALLNAME%의 젖꼭지에 몇 번이고 달라붙어 빨며, 혀로 애무한다……
						PRINTFORMW %CALLNAME%은(는) 날카로운 쾌감을 견뎌내며, %CALLNAME:MASTER%의 머리를 사랑스럽게 쓰다듬었다.
						IF TALENT:아내
							PRINTFORML 「가슴 한쪽은 서방님 것이라고들 하제♪」
							PRINTFORMW 「그랑게, %CSTR:이인칭% 좋을 대로 해도 된당께%ハート()%」
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;童貞を殺すセ─タ─で、その上にも下にも何も着けていない場合
					IF TEQUIP:81 == 130 && TEQUIP:83 == 0 && TEQUIP:85 == 0 && TEQUIP:87 == 0 && TEQUIP:90 == 0
						PRINTFORML 「옷 입고 있는디♪ 구멍으로 손 집어넣어서♪ 젖꼭지 괴롭혀지고♪」
						PRINTFORMW 「억수로 야해서%ハート()% 흥분되기 시작했구먼%ハート()%」
					ELSE
						PRINTFORMW 「히야앙! …더 세게! 더 격렬하게! 꼭지 빨아줘! 오돌토돌 굴려줘어!」
						PRINTFORMW %CALLNAME%의 젖꼭지를 세게 빨아당기자, %CALLNAME%은(는) %CALLNAME:MASTER%의 머리를 꽉 끌어안으며 스스로 젖꼭지를 비벼대 왔다.
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「꺄아아아아아악! 꼭지 떨어져 나가버린당께에%ハート()%」
					PRINTFORMW 강하게 젖꼭지를 꼬집으며 잡아당기자 %CALLNAME%은(는) 달콤한 교성을 내지르기 시작했다.
					PRINTFORMW 「하아… 하아, 고래 꼭지를 잡아당기믄 꼭지가 늘어나 버린당께」
					PRINTFORMW 그래도 곤란하므로 젖꼭지를 꾹 눌러 집어넣자 다시금 달콤한 교성이 터져 나온다.
					PRINTFORMW 그러고 나서 한동안 젖꼭지를 잡아당겼다 눌렀다 하기를 반복했다.
				ENDIF
				CFLAG:307 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:307 < 3 || FLAG:7 == 2)
				PRINTFORMW 「아, 싫… 읏…… 꼭지가 찌릿찌릿 울려… 아, 아앙!」
				CFLAG:307 = 3
			;それ以外
			ELSEIF CFLAG:307 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「앗! 읏! …아프당께… 좀 더 살살 해줘…」
				ELSE
					PRINTFORMW 「아프다, 떨어져! 꼭지 떨어져 나가겄구먼!」
				ENDIF
				CFLAG:307 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;8,가슴애무
;-------------------------------------------------
	CASE 8
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:308 == 0 && FLAG:7 == 2
			;陥落済み
			IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				PRINTFORML 「아앙%ハート()% 온몸에 찌릿찌릿 울려와…」
				PRINTFORMW 「그치만, 이거 기분 좋아…%ハート()%」
			ELSE
				PRINTFORMW 「어, 가슴? 안 돼! 만지지 말어!」
			ENDIF
			CFLAG:308 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:308 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;スク水ロ─ションプレイ
					IF RAND:2 == 0 && TEQUIP:전신속옷 == 710 && CFLAG:800 == 1
						PRINTFORML 「응, 아앙…%ハート()%」
						PRINTFORML 「수영복 위로 하는 거지만서도, 로션으로 끈적끈적해져 있으니께… 느껴져 버려갖고…」
						PRINTFORMW 「젖꼭지가 커져 있는 게 수영복 위로도 티가 나버린당께…%ハート()%」
					;穴開きスク水ロ─ションプレイ
					ELSEIF RAND:2 == 0 && TEQUIP:전신속옷 == 711 && CFLAG:800 == 1
						PRINTFORMW 「응, 아앙…%ハート()%」
						PRINTFORML 「로션으로 끈적끈적한 것도」
						PRINTFORML 「가슴 쪽에 구멍이 뚫린 수영복도」
						PRINTFORMW 「전부 다 너무 좋당께%ハート()%」
						PRINTFORML 「그랑게」
						PRINTFORMW 「더 가슴 까발리고 로션범벅이 된 %CSTR:일인칭%을 상대해줘어%ハート()%」
					;童貞を殺すセ─タ─で、その上にも下にも何も着けていない場合
					ELSEIF TEQUIP:81 == 130 && TEQUIP:83 == 0 && TEQUIP:85 == 0 && TEQUIP:87 == 0 && TEQUIP:90 == 0
						PRINTFORML 「평소보다 손놀림이 야하당께♪」
						PRINTFORMW 「이 옷에 흥분한겨?」
					ELSEIF TALENT:아내
						PRINTFORM 하지만, 설마 발육부진 저주 같은 걸 걸어놓은 건 아니제?%ハート()%」
					ELSE
						PRINTFORM %ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;穴開きスク水ロ─ションプレイ
					IF RAND:2 == 0 && TEQUIP:전신속옷 == 711 && CFLAG:800 == 1
						PRINTFORML 「부끄러운 곳에 구멍 뚫린 학교 수영복에」
						PRINTFORML 「로션 뿌리고 가슴을 마구 쓰다듬는다니」
						PRINTFORMW 「어쩔 도리가 없는 변태 양반이로구먼」
						PRINTFORML 
						PRINTFORML 「그치만…」
						PRINTFORML 「%CSTR:일인칭%도 이거, 좋당께%ハート()%」
						PRINTFORMW 「그랑게♪ 더 가슴♪ 훤히 드러난 가슴, 기분 좋게 해줘어%ハート()%」
					;童貞を殺すセ─タ─で、その上にも下にも何も着けていない場合
					ELSEIF TEQUIP:81 == 130 && TEQUIP:83 == 0 && TEQUIP:85 == 0 && TEQUIP:87 == 0 && TEQUIP:90 == 0
						PRINTFORML 「평소보다 손놀림이 야하당께♪」
						PRINTFORMW 「%CSTR:일인칭%도 흥분되기 시작해버렸당께%ハート()%」
					ELSE
						;童貞を殺すセ─タ─で、その上にも下にも何も着けていない場合
						IF TEQUIP:81 == 130 && TEQUIP:83 == 0 && TEQUIP:85 == 0 && TEQUIP:87 == 0 && TEQUIP:90 == 0
							PRINTFORML 「그렇게 길게 늘여버리믄, 그냥 구멍 난 스웨터가 되어버린당께」
							PRINTFORMW 「아니믄, 그쪽이 더 좋은겨?」
						ELSE
							PRINTFORML 「응, 아앙… 에헤헤, 가슴 쓰다듬어지믄 사랑받고 있다는 게 느껴져서……」
							PRINTFORMW 「앗, 앗, 좋아… 좋아아… 저기 더 세게에… 꼭지도 꼬집꼬집해줘어%ハート()%」
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW %CALLNAME:MASTER%은(는) %CALLNAME%의 젖꼭지를 살짝 비틀면서 반대쪽 유방에 키스마크를 새기고 있다.
					PRINTFORMW 「%CSTR:일인칭%의 가슴이 %CSTR:이인칭%의 것이라는 증표를 남겨버렸구먼%ハート()%」
					PRINTFORMW 기쁘냐고 묻자 %CALLNAME%은(는) 쑥스러운 듯 미소지었다. 
				ENDIF
				CFLAG:308 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:308 < 3 || FLAG:7 == 2)
				;童貞を殺すセ─タ─で、その上にも下にも何も着けていない場合
				IF TEQUIP:81 == 130 && TEQUIP:83 == 0 && TEQUIP:85 == 0 && TEQUIP:87 == 0 && TEQUIP:90 == 0
					PRINTFORML 「구멍이 뚫려서 이상하다 싶었더니…」
					PRINTFORMW 「요런… 식으로 쓸 줄… 이야…」
				ELSE
					PRINTFORMW 「응, 아… 손길이 너무 음탕해… 싫, 아, 아앙」
				ENDIF
				CFLAG:308 = 3
			;それ以外
			ELSEIF CFLAG:308 < 2 || FLAG:7 == 2
				PRINTFORMW 「응… 가슴만 만져싸고…… 고래 %CSTR:일인칭%의
				IF BUST() > 2
					PRINTFORM 쪼끄만 어린애 
				ELSEIF BUST() < 3
					PRINTFORM 애인데도 커다란 
				ENDIF
				PRINTFORMW 가슴이 그렇게 좋은겨?」
				PRINTFORMW 「로리콘은 범죄고 사형이랑께」
				CFLAG:308 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;9,조개젖히기
;-------------------------------------------------
	CASE 9
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:309 == 0 && FLAG:7 == 2
			IF TALENT:소악마
				;処女
				IF TALENT:처녀
					IF RAND:2 == 0
						PRINTFORML 「자아… 미사용 보지랑께%ハート()%」
					ELSE
						PRINTFORML 「자아… 자지 들어간 적 없는 어린애 보지랑께%ハート()%」
					ENDIF
				ENDIF
				PRINTFORMW 「자아… 넣고 싶제」
				;相手が主導権を持읏ている
				IF TEQUIP:주도권 == 1
					IF RAND:3 == 0
						PRINTFORMW 「그치만, 안~ 돼%ハート()%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「안~ 돼, 보류랑께%ハート()%」
					ELSE
						PRINTFORMW 「%CSTR:이인칭%, 콧김이 거칠구먼♪」
					ENDIF
				ENDIF
			;陥落済み
			ELSEIF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				PRINTFORMW 「처음이라 쪼까 부끄럽기는 한디…… 똑똑히 보시게나%ハート()%」
			ELSE
				PRINTFORMW 「어, 어어! 스스로!?」
				PRINTFORMW 「으으으…… 부끄럽단 말이여」
			ENDIF
			CFLAG:309 = 1
		;二回目以降
		ELSE
			;処女
			IF TALENT:0
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:309 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						PRINTFORMW 「……여기, 벌려서 보여주려니께 억~수로 부끄럽지만서도……」
						PRINTFORM 「으~…… 
						IF TALENT:아내
							PRINTFORM %CSTR:이인칭%의 어린 색시
						ELSE
							PRINTFORM %CSTR:일인칭%
						ENDIF
						PRINTFORMW 의 처녀 보지, 잘 봐주시게…」
						PRINTFORMW 손가락으로 벌려진 얌전한 비부는, 안쪽의 처녀막을 언뜻 내비치며 엷고 선명한 핑크빛 점막을 씰룩거리며 꿀을 토해내고 있다.
						PRINTFORMW 「부끄럽기는 한디, %CSTR:이인칭%이 보고 싶다고 하니께 해준 거랑께?」
						PRINTFORM 「%CSTR:일인칭%의 처음을 얼른 빼앗아줬으면 좋겠지만서도, 
						IF TALENT:아내
							PRINTFORMW 결혼했다고 혀도, 여긴 아직 색시로 안 만들어줬는걸」
							PRINTFORMW 「……첫날밤, 기대하고 있었는디……」
						ELSE
							PRINTFORMW 이런 짓만 시켜싸고……」
							PRINTFORMW 「처음 할 적엔 살살 안 해주믄 화내버릴 거여?」
						ENDIF
						PRINTFORMW %CALLNAME%은(는) 귀엽게 볼을 부풀렸다.
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						IF RAND:2 == 0
							PRINTFORMW 「하아…… %CSTR:일인칭%의 음란 처녀막, 실컷 봐줘어%ハート()%」
						ELSE
							PRINTFORMW 「있잖여…… 보지, 얼른 써버리자구우%ハート()%」
						ENDIF
						PRINTFORMW %CALLNAME%의 비부가 좌우로 벌려진다.
						PRINTFORMW 푹 녹아내린 처녀의 살은 뿌옇게 흐린 침을 흘리며 남자를 갈구하고 있는 듯하다.
						PRINTFORML 「%CSTR:이인칭% 땜에 요래 야해져 버린 거 아니여?」
						PRINTFORMW 「책임지고 질퍽질퍽 푹푹 범해주시게나%ハート()%」
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						PRINTFORML 「%CALLNAME%의 처녀막, 뚫어져라 쳐다봐 주셔%ハート()%」
						PRINTFORMW %CALLNAME%의 손가락으로 벌려진 비소에는 확실하게 순결의 증표가 남아 있다.
						PRINTFORMW 「하는 김에 %CSTR:일인칭%의 처녀, %CSTR:이인칭%한테 뚫리고 싶구먼♪」
						IF RAND:2 == 0
							PRINTFORML 「못 움직일 만큼 꽁꽁 묶여서… 피가 나든 말든 신경 끄고 쾅쾅 찔려서…」
						ELSE
							PRINTFORMW 「뒤에서 짐승마냥 섹스당하고」
							PRINTFORML 「%CSTR:일인칭%이 『그만해!』 하고 울어도 안 멈추고……」
						ENDIF
						PRINTFORML 「하아아…%ハート()% 생각만 해도 흥분돼 버린당께%ハート()%」
						PRINTFORMW 처녀 구멍은 걸쭉하게 애액을 흘리고 있다.
					ENDIF
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && FLAG:7 == 2
					IF RAND:2 == 0
						PRINTFORML 「응, 싫엉… 부끄러우니께 쳐다보지 말어…… 아아… 싫어」
						PRINTFORMW 수치심에 떨면서도, 그러나 %CALLNAME%은(는) 저항하지 않고 젖은 비부를 벌려 보여주었다.
					ELSE
						PRINTFORML 「안 된당께…… 보지 말어어……」
					ENDIF
				;それ以外
				ELSEIF FLAG:7 == 2
					IF RAND:2 == 0
						PRINTFORMW 「으으… 부끄러워……」
					ELSE
						PRINTFORMW 「으으… 이런 짓이나 시키고……」
					ENDIF
				ENDIF
			;それ以外
			ELSE
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:309 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						PRINTFORM 「……%CSTR:이인칭%, 봐줘어, %CSTR:이인칭% 전용인 
						IF TALENT:아내
							PRINTFORM 어린 색시 보지
						ELSE
							PRINTFORM 보지
						ENDIF
						PRINTFORMW 가, %CSTR:이인칭%이 와줬으면 해서 걸쭉~하게 녹아내렸당께%ハート()%」
						PRINTFORM 「……그치%ハート()%, %CSTR:일인칭%, 
						;結婚しているか
						IF TALENT:아내
							PRINTFORM 억수로 좋아하는 서방님
						ELSE
							PRINTFORM %CSTR:이인칭%
						ENDIF
						PRINTFORMW 이 기분 좋아지도록 힘낼 텐게…… 넣고 싶어졌제, %CSTR:이인칭%%ハート()%」
						PRINTFORM 「%CSTR:일인칭%도 얼른, 
						IF TALENT:아내
							PRINTFORML 부부 아기 만들기 짝짓기로 제일 안쪽까지 예쁨받고 싶구먼%ハート(3)%」
						ELSE
							PRINTFORML 안쪽까지 사랑해줬으면 좋겠구먼%ハート()%」
						ENDIF
						PRINTFORML 애액으로 흠뻑 젖은 비부를 부끄러운 듯 과시하며
						PRINTFORMW %CALLNAME%은(는) 아쉬운 듯한 눈동자를 %CALLNAME:MASTER%에게 향했다.
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						;精液が溜ま읏ているか
						IF TCVAR:TARGET:101  > 0
							PRINTFORML 「아… 흘러넘쳐 버렸당께」
							IF RAND:3 == 0
								PRINTFORMW 「나와버린 만큼 보지에 더 부어줘어%ハート()%」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「자지 우유, 한 그릇 더 주셔~%ハート()%」
							ELSE
								PRINTFORMW 「밀키스 젤리, 아직 더 있제♪」
							ENDIF
						ELSE
							IF RAND:2 == 0
								PRINTFORML 「하아, 하앙…… 전부 다 들여다보이고 있어… 봐줘, 봐줘어… %CSTR:일인칭% 가버릴 것 같당께~…%ハート()%」
								PRINTFORMW %CALLNAME%은(는) 수치심이 가져다주는 쾌감에 황홀경에 빠져 있다.
								PRINTFORML 「질퍽질퍽하당께… 얼른 자지를 원한다고 실룩거리고 있어… 앗, 하앙!」
								PRINTFORMW 삽입당했을 때를 상상한 것인지, %CALLNAME%의 음순이 퓨릇 작게 분수를 뿜어냈다.
							ELSE
								PRINTFORMW 「자아, 아무것도 안 들어있응게 말이여…」
								PRINTFORML 「자지 주셔어%ハート()%」
								PRINTFORML 「자아, 자아%ハート()%」
								PRINTFORMW 재촉하듯 허리를 흔드는 %CALLNAME%의 움직임에 맞추어 농염하게 질구도 꿈틀거리고 있다
							ENDIF
						ENDIF
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						PRINTFORMW 「자, 어서유♪」
						PRINTFORMW 「%CSTR:일인칭%의 보지, %CSTR:이인칭%한테 보이기만 해도 젖어버린당께」
						PRINTFORMW 「요래 칠칠치 못한 보지는 벌을 줘야 쓰겄제?」
						PRINTFORMW 「%CSTR:이인칭%의 자지로 깊숙이 가~득 벌을 내려줘어%ハート()%」
					ENDIF
				CFLAG:309 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:309 < 3 || FLAG:7 == 2)
					PRINTFORMW 「응, 싫엉… 쳐다보고 있어…… 아아… 싫어」
					PRINTFORMW 수치심에 떨면서도, 그러나 %CALLNAME%은(는) 저항하지 않고 젖은 비부를 벌려 보여주었다.
					CFLAG:309 = 3
				;それ以外
				ELSEIF CFLAG:309 < 2 || FLAG:7 == 2
					IF RAND:2 == 0
						PRINTFORMW 「으으… 부끄러워……」
					ELSE
						PRINTFORMW 「으으… 이런 짓이나 시키고……」
					ENDIF
					CFLAG:309 = 2
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;10,가슴자위
;-------------------------------------------------
	CASE 10
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:310 == 0 && FLAG:7 == 2
			;陥落済み
			IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				PRINTFORMW 「혼자서?」
				PRINTFORMW 「으~음, 해본 적이 없응게 잘할 수 있을라나…」
			ELSE
				PRINTFORMW 「그, 그런 거 해본 적 없당께! ……이, 이렇게 하는겨?」
			ENDIF
			CFLAG:310 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:310 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「%CSTR:일인칭%의 가슴…… %CSTR:이인칭%이 언제나 사랑해주는 가슴…… 기분 좋아… 아앙!」
					PRINTFORMW 뺨을 붉히고 황홀경에 빠지면서 %CALLNAME%은(는) 자신의 가슴을 애무하며, 힐끔힐끔 %CALLNAME:MASTER%에게 시선을 보내고 있었다.
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「하아! 좋아, 좋당께! 가슴 기분 좋아!」
					PRINTFORMW 「더 세게 문질러! 젖꼭지를 꽉꽉 괴롭혀! 마구 쥐어짜란 말이여!」
					PRINTFORMW 「앙! 아앙! 아앙! 히야아아아! %CSTR:일인칭%, 가슴으로 가버린당께에!」
					PRINTFORMW %CALLNAME%은(는) 자신의 가슴의 약점을 고스란히 드러내며, 피학의 쾌감에 눈을 풀고 있다.
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「응… 하, 아… 가슴을 꽉, 꽉, 쥐는 거 기분 좋기는 한디… 앗」
					PRINTFORMW 「그치만 말여… 혼자서 하는 것보단 %CSTR:이인칭%이 해주는 쪽이, 읏, 훨씬 기분 좋당께」
				ENDIF
				CFLAG:310 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:310 < 3 || FLAG:7 == 2)
				PRINTFORMW 「응, 아앙, 아앙…… 아, 아…… 보고 있어…」
				PRINTFORMW %CALLNAME:MASTER%의 시선을 강하게 의식하는 것인지, %CALLNAME%은(는) 볼을 수치심과 쾌감으로 붉게 물들이고 있다.
				CFLAG:310 = 3
			;それ以外
			ELSEIF CFLAG:310 < 2 || FLAG:7 == 2
				PRINTFORMW 「응, 읏… 이러믄 되는겨? ……왠지 간지러운데…」
				CFLAG:310 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;11,자위
;-------------------------------------------------
	CASE 11
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:311 == 0 && FLAG:7 == 2
			;淫乱、娼婦
			IF TALENT:음란 || TALENT:창부
				PRINTFORMW 「에엑! 혼자서!?」
				PRINTFORMW 「…괜찮기는 한디, 처음이라 기분 좋아질 수 있을라나…」
			ELSE
				PRINTFORMW 「에엑! 혼자서!? 싫당께, 부끄러워…」
			ENDIF
			CFLAG:311 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「……%CSTR:일인칭%의 혼자 야한 짓…… 보여주는 건 %CSTR:이인칭%뿐이니께 말여…… 응, 아, 하아…」
					IF TALENT:아내
						PRINTFORMW 「……알고 있제? %CSTR:일인칭%의 혼자 야한 짓…… 전부…… %CSTR:이인칭%이 한 거…… 흉내 내는 거란 걸……」
						PRINTFORMW 「……%CSTR:일인칭%이…… 기분 좋은 건…… 전부…… %CSTR:이인칭%이…… 가르쳐줬응게……」
						PRINTFORMW 「……지금도…… 손가락도…… 손도…… 전부…… %CSTR:이인칭% 거라고…… 생각하고 있고……」
						PRINTFORMW 「……%CSTR:이인칭%의 모습이 보이고…… 기척을 느끼고…… 냄새를 맡고…… 하지만…… 머릿속의 %CSTR:이인칭%한테도…… 귀여움받고 있는 거랑께……」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%와 눈을 맞추며 스스로 선사하는 유열에 표정을 녹이고 있다.
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「아앙! 아아앙! 보고 있어어! %CSTR:일인칭%의 야한 곳을 보고 있당께에!!」
						PRINTFORMW 「더 쳐다봐줘어!! %CSTR:일인칭%이 자위로 가버리는 모습 전부 다 봐줘어어!!」
					ELSE
						PRINTFORMW 「당하는 것도 좋지만서도, 혼자서 하는 것도 좋구먼%ハート()%」
						PRINTFORMW 「기분 좋기도 하고, 흥분한 %CSTR:이인칭%이 평소보다 격렬해지니께♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「아앗, 읏, 하앙! 어뗘…? %CSTR:일인칭%이 자위하는 거, 앙, 흥분돼?」
					PRINTFORMW 「%CSTR:일인칭%은, 아… 으응… 억수로 흥분돼 있당께%ハート()%」
					PRINTFORMW 「아, 가앗! %CALLNAME% 가버려어! 꼭지랑 콩알 꼬집어서 가버린다아%ハート()%」
				ENDIF
				CFLAG:311 = 4
			;従順Lv3以上
			ELSEIF ABL:0 >= 3 && (CFLAG:311 < 3 || FLAG:7 == 2)
				PRINTFORML 「아, 앙, 아앙… 아, 흠뻑 젖어버렸구먼…… %CSTR:일인칭%, 너무 야해져 버렸당께…」
				PRINTFORMW 수치심에 얼굴을 붉히면서도, %CALLNAME%은(는) 가랑이를 향한 애무를 멈추려 하지 않는다.
				CFLAG:311 = 3
			;それ以外
			ELSEIF CFLAG:311 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「응… 아… 보지 말어어… 으~」
				ELSE
					PRINTFORMW 「안 돼… 보지 마, 보지 말어…」
				ENDIF
				CFLAG:311 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;12,날개애무
;-------------------------------------------------
	CASE 12
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:435 == 0 && FLAG:7 == 2
			;陥落済み
			IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				PRINTFORMW 「%CSTR:이인칭%은 %CSTR:일인칭%의 전부를 좋아하는 거로구먼%ハート()%」
			;反発2LV以上
			ELSEIF MARK:3 >= 2
				PRINTFORMW 「잠깐! 날개는, 날개는 뜯어내지 말어!」
				PRINTFORMW 「부탁이니께, 날개는 제발 봐줘!」
				PRINTFORMW %CALLNAME%에게 끈질기게 당부를 들었다
			ELSE
				PRINTFORMW 「엣! 거긴 그런 짓을 하는 데가 아녀!」
			ENDIF
			CFLAG:435 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:435 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:3 == 0
						PRINTFORMW 「날개를 만져지믄 요래 기분 좋은 건 줄은 몰랐구먼…%ハート()%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「너무 오물오물 빨아대믄, 나, 날지 못하게 되어버린당께%ハート()%」
					ELSE
						PRINTFORMW 「예쁘다고 혀서 너무 세게 만지진 말어%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「아앙%ハート()% 날개를 물어뜯기믄, 기분 좋당께%ハート()%」
					ELSE
						PRINTFORMW 「날개도 좋지만서도, 딴 데도 만져줬으면 좋겠구먼%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
						PRINTFORMW 「아앙%ハート()% %CSTR:이인칭%한테 날개를 잡아먹혀 버린당께%ハート()%」
				ENDIF
				CFLAG:435 = 4
			;従順Lv3以上
			ELSEIF ABL:0 >= 3 && (CFLAG:435 < 3 || FLAG:7 == 2)
				PRINTFORMW 「기분은 좋지만서도… 뭔가 이상혀…」
				CFLAG:435 = 3
			;反発2LV以上
			ELSEIF MARK:3 >= 2 && FLAG:7 == 2
				PRINTFORMW 「진짜로 만지기만 하는겨?」
				PRINTFORML 「진짜루 진짜?」
				PRINTFORMW %CALLNAME%에게 끈질기게 당부를 들었다
				CFLAG:435 = 2
			;それ以外
			ELSEIF CFLAG:435 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「날개 뜯어내거나 하진 말어」
				ELSE
					PRINTFORML 「부탁이니께, 잡아먹거나 하진 말어」
					PRINTFORMW 「못 날게 되어버리니께」
				ENDIF
				CFLAG:435 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;13,꼬리애무
;-------------------------------------------------
	CASE 13
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:436 == 0 && FLAG:7 == 2
			;陥落済み
			IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				PRINTFORMW 「%CSTR:이인칭%은 %CSTR:일인칭%의 전부를 좋아하는 거로구먼%ハート()%」
			ELSE
				PRINTFORMW 「엣! 거긴 그런 짓을 하는 데가 아녀!」
			ENDIF
			CFLAG:436 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:436 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORMW 「꼬리를 만져지믄 요래 기분 좋은 줄은 몰랐구먼…%ハート()%」
					ELSE
						PRINTFORMW 「늘 오물오물거리면서, %CSTR:일인칭%의 꼬리가 좋아?」
						PRINTFORMW 「%CSTR:이인칭%이라면 잡아먹어도 괜찮당께?」
					ENDIF
					;尻尾生やしたキャラにネコミミカチュ─シャにねこまたす─つという特殊性癖すぎるプレイ
					IF TEQUIP:애널비즈 && TEQUIP:모자 == 17 && TEQUIP:전신복 == 321 && NO == 801 && TALENT:꼬리 && ABL:종족 == 0
						IF RAND:2 == 0
							PRINTFORMW %CALLNAME%의 또 다른 꼬리를 쓰다듬어 주기로 했다
							PRINTFORML 　
							PRINTFORML 「안 돼엣%ハート()% 그쪽 꼬리는 쓰다듬지 마앗%ハート()%」
							PRINTFORMW 「잡아당겨도 안 된당께엣%ハート()%」
							PRINTFORMW 아무리 %CALLNAME%이라도 화를 낼 것 같았기에, 두 개의 꼬리를 번갈아 쓰다듬는 것으로 용서받았다
						ELSE
							PRINTFORMW 「이거슨 『네코마타 플레이』」
							PRINTFORML 　
							PRINTFORML 「그라믄 이쪽 꼬리도 예뻐해 줬으면 좋겠구먼냥%ハート()%」
							PRINTFORMW %CALLNAME%의 또 다른 꼬리를 쓰다듬어 주기로 했다
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「아앙%ハート()% 꼬리를 물어뜯기믄, 기분 좋당께%ハート()%」
					ELSE
						PRINTFORMW 「안 돼애%ハート()% 자지마냥 흔들흔들 문지르지 마아%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「꼬리이%ハート()% %CSTR:이인칭%한테 꼬리를 잡아먹혀 버린당께%ハート()%」
				ENDIF
				CFLAG:436 = 4
			;従順Lv3以上
			ELSEIF ABL:0 >= 3 && (CFLAG:436 < 3 || FLAG:7 == 2)
				PRINTFORMW 「기분은 좋지만서도… 뭔가 이상혀…」
				CFLAG:436 = 3
			;それ以外
			ELSEIF CFLAG:436 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「꼬리 뜯어버리거나 하진 말어」
				ELSE
					PRINTFORMW 「기분 나쁘구먼……」
				ENDIF
				CFLAG:436 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;14,클리애무
;　 「Ｅマ읏サ─ジャ─」のコピペ
;-------------------------------------------------
	CASE 14
		;初めて
		IF CFLAG:442 == 0 &&  FLAG:7 == 2
			;陥落済み
			IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				PRINTFORML 「콩알 쓰담쓰담해주는겨?」
			ELSE
				PRINTFORML 「어디에 손을 쑤셔 넣는겨, 변태!」
			ENDIF
			CALL TRAIN_MESSAGE
			CFLAG:442 = 1
		;二回目以降
		ELSE
			CALL TRAIN_MESSAGE
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:442 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORML 「히양! 아앙! 거기 안 돼, 콩알 안 돼애! 머릿속이 하얘져! 히야아! 아아앙!」
					PRINTFORML 「싫어! 안 멈춰어! 안 멈추……! 안 돼애! 아앙! 아아아아!」
					PRINTFORMW %CALLNAME%은(는) 몸을 덜덜 떨며 발음도 제대로 안 되는 교성을 끊임없이 내지른다
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORML 「히익! 아히야앙!! 콩알! 너무 기분 좋단 말이여어어!!」
						PRINTFORMW 「히양! 히양앗! 아아앗! 히아아아아아아!!」
					ELSE
						PRINTFORML 「더, 더 해줘어!」
						PRINTFORML 「더 빙글빙글 문질러줘어!」
						PRINTFORMW %CALLNAME%은(는) 허리를 들썩이며 환희의 교성을 내지르고 있다
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「히아아아아아! 비비는 것만으론 못 참겠당께!」
					PRINTFORMW 「%CSTR:이인칭%! 더, 더 해줘어!」
					CFLAG:442 = 4
				ENDIF
			;従順Lv3以上
			ELSEIF ABL:0 >= 3 && (CFLAG:442 < 3 || FLAG:7 == 2)
				PRINTFORMW 「거, 거기가 찌, 찌릿찌릿해서 날아가 버려, 날아가 버린당께에!」
				CFLAG:442 = 3
			;それ以外
			ELSEIF CFLAG:442 < 2 || FLAG:7 == 2
				PRINTFORMW 「싫어, 만지지 말어」
				PRINTFORMW 「아, 야, 야아앙!」
				CFLAG:442 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;15,엉덩이애무
;-------------------------------------------------
	CASE 13
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:444 == 0 && FLAG:7 == 2
			;陥落済み
			IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
				PRINTFORMW 「치한 놀이여?」
			ELSE
				PRINTFORMW 「꺄악, 만지지 말어」
			ENDIF
			CFLAG:444 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:444 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭%의 엉덩이, 매끈매끈해서 기분 좋은겨?」
					ELSE
						PRINTFORMW 「엉덩이 말고 딴 데도 만져도 된당께」
						PRINTFORMW 「아니믄 애태우는겨?」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「『여자의 매력은 엉덩이에 있다』고들 하니께」
					;ち읏ぱい
					IF BUST() < 3
						PRINTFORMW 「가슴이 쪼끄매도 이걸로 다들 뿅 가버리는 거로구먼%ハート()%」
					ELSE
						PRINTFORMW 「가슴을 무시당해도 어쩔 수 없으려나」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「기분 좋은겨? %CSTR:이인칭%」
					PRINTFORMW 「%CSTR:일인칭%은 노예니께 %CSTR:이인칭%이 기뻐해 주는 게 행복이랑께%ハート()%」
				ENDIF
				CFLAG:444 = 4
			;従順Lv3以上
			ELSEIF ABL:0 >= 3 && (CFLAG:444 < 3 || FLAG:7 == 2)
				PRINTFORMW 「%CSTR:이인칭%의 손, 왠지 응큼해갖고…」
				CFLAG:444 = 3
			;それ以外
			ELSEIF CFLAG:444 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「엉덩이만 만져대고, 역쉬 변태로구먼」
				ELSE
					PRINTFORMW 「이런 짓을 해서 신나는겨?」
				ENDIF
				CFLAG:444 = 2
			ENDIF
		ENDIF


;=================================================
;コミュニケ─ション系コマンド
;=================================================
;-------------------------------------------------
;20,키스한다
;-------------------------------------------------
	CASE 20
		;初めて
		IF CFLAG:312 == 0&&  FLAG:7 == 2
			IF 陥落()
				IF 연모() || 친애()
					;相手が助手
					IF ASSI > 0 && ASSIPLAY
						PRINTFORML 「기다려! %CSTR:일인칭%의 첫 키스는 %CSTR:이인칭%이라고 정해뒀었는디!」
						PRINTFORMW %CALLNAME:PLAYER%은(는) 싱글벙글 웃으며 %CALLNAME%의 입술을 빼앗기고 있는 것을 바라보고 있다
						PRINTFORM %CALLNAME:MASTER%은(는) 
						CALL TRAIN_MESSAGE
					ELSEIF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐
						PRINTFORMW 「키, 키키 키스라니……」
						PRINTFORML 「자, 잠깐만, 기다려 기다려」
						PRINTFORMW %CALLNAME%은(는) 두세 번 심호흡을 하더니 마음을 정한 듯 눈을 감고, 입술을 %CALLNAME:MASTER%에게 향하듯 얼굴을 내밀었다…
					ELSEIF TALENT:부끄럼쟁이
						PRINTFORMW 「키, 키스… 하는겨?」
						PRINTFORMW 「으, 응… %CSTR:이인칭%이라면…」
						PRINTFORM %CALLNAME:MASTER%이(가) 
						CALL TRAIN_MESSAGE
						PRINTFORML 「왠, 왠지 얼굴이 뜨겁구먼…」
						PRINTFORMW 「부끄러워 죽어버릴 것 같당께…」
					ELSE
						CALL TRAIN_MESSAGE
						PRINTFORMW 「……」
						PRINTFORMW 「…에, 헤헤. 해버렸구먼. %CSTR:이인칭%한테 뽀뽀당해 버렸당께♪」
						PRINTFORML 「…이건, 보답♪」
						PRINTFORMW %CALLNAME%은(는) 부끄러움과 고양감이 뒤섞인 표정으로 미소짓더니, %CALLNAME:MASTER%와 다시 한번 입술을 포갰다
						PRINTFORMW 「뽀뽀에 대한 보답 뽀뽀랑께♪」
						PRINTFORML 「그라믄… %CSTR:이인칭%의 보답은~?」
						PRINTFORMW 숨결이 서로 닿을 만큼 얼굴을 가까이 대어오는 %CALLNAME%와(과), 서로의 입술을 탐했다……
					ENDIF
				ELSEIF 음란() || 창부()
					CALL TRAIN_MESSAGE
					;キス経験も、アナル奉仕経験も、フェラ経験も無くて、主人公相手にキス
					IF EXP:키스경험 == 0 && EXP:펠라경험 == 0 &&  CFLAG:374 == 0 && ASSIPLAY == 0
						PRINTFORML 「어, 첫 키스는 엉덩이도 자지도 구두도 아니고」
						PRINTFORML 「%CSTR:이인칭%의 입이어도 되는겨?」
						PRINTFORMW 갑작스러운 명령에 당황하는 %CALLNAME%.
						PRINTFORML 　
						PRINTFORML 「응… 그라믄, 할게…… 읏, 쪽…」
						PRINTFORMW （어, 어쩐댜… 첫 키스까지 줘버렸으니…… 평생 %CSTR:이인칭%을 따라갈 수밖에…%ハート()%）
					ELSE
						PRINTFORMW 「응, 쪽, …으음, 쪼옵, 으흣… 으아」
						PRINTFORMW 「하앗… 키스라는 거, 대단하구먼%ハート()%」
						PRINTFORMW 「저기, 아직 모자라… 더, 더 해주시게」
					ENDIF
				ELSEIF 복종() || 예속()
					CALL TRAIN_MESSAGE
					;キス経験も、アナル奉仕経験も、フェラ経験も無くて、主人公相手にキス
					IF EXP:키스경험 == 0 && EXP:펠라경험 == 0 &&  CFLAG:374 == 0 && ASSIPLAY == 0
						PRINTFORML 「어, 첫 키스는 엉덩이도 자지도 구두도 아니고」
						PRINTFORML 「%CSTR:이인칭%의 입이어도 되는겨?」
						PRINTFORMW 갑작스러운 명령에 당황하는 %CALLNAME%.
						PRINTFORML 　
						PRINTFORML 「응… 그라믄, 할게…… 읏, 쪽…」
						PRINTFORMW （어, 어쩐댜… 첫 키스까지 줘버렸으니…… 평생 %CSTR:이인칭%을 따라갈 수밖에…%ハート()%）
					ELSE
						PRINTFORMW 「으응… 입술도, %CSTR:이인칭%의 것이 되어버렸당께%ハート()%」
						PRINTFORMW 「저기, 더… 더 가득, %CSTR:일인칭%을 %CSTR:이인칭%의 것으로 만들어줘…」
					ENDIF
				ENDIF
			ELSE
				PRINTFORMW 「키, 키스!?」
				PRINTFORMW 「아, 안 된당께 그런 건… 읍!?」
				CALL TRAIN_MESSAGE
			ENDIF
			CFLAG:312 = 1
		;二回目以降
		ELSE
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:312 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:3 == 0
						PRINTFORMW 「쪽… 응, 후우…」
						PRINTFORMW 「%CSTR:이인칭%의 키스, 왠지 몽글몽글해서 행복혀…」
						PRINTFORMW 「…더 주시게」
					ELSEIF RAND:2 == 0
						PRINTFORMW %CALLNAME%은(는) 넋을 잃은 표정으로 몇 번이고 %CALLNAME:MASTER%의 이름을 부르며, 탐하듯 키스를 갈구해 온다.
						PRINTFORMW 「응, 쪽, 으응…… 푸하아. %CSTR:이인칭%, 좋아… 억수로 좋아, %CSTR:이인칭%, %CSTR:이인칭%…%ハート()%」
					ELSE
						PRINTFORML 「쪽, 쪽, 쪽, 쪽…… 낼름… 으음… 으흣… 으으응…」
						PRINTFORMW 쪼아대듯 몇 번이고 입술에 입을 맞추더니, 탐하듯 입안에서 혀를 뒤엉킨다.
						PRINTFORMW 「으으으응…… 푸하아. 억수로 좋아… %CSTR:이인칭%…… 더, 더 키스하고 싶당께…」
					ENDIF
					PRINTFORMW 
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「으음! 으응… 츄릅, 쪽… 으음, 쪼옵, 으흥!」
					PRINTFORMW %CALLNAME:MASTER%의 얼굴을 고정하고, 격렬하게 입안을 유린한다.
					PRINTFORMW 「으냐아… 우후후, %CSTR:이인칭%의 침, 맛있구먼…… 저기, 더 주셔어%ハート()%」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「응… 쪽… 하앗… 으음…」
					PRINTFORMW %CALLNAME:MASTER%의 치아 하나하나를 애무하듯 정성스러운 혀놀림이다.
					PRINTFORMW 「응풋, 쥬… 질퍽… 쪽」
					PRINTFORMW 보답이라도 하듯 혀를 핥자 %CALLNAME%은(는) 자신의 혀로 %CALLNAME:MASTER%의 혀를 훑어내듯 움직인다.
					PRINTFORMW 그대로 %CALLNAME%의 구강 애무를 계속 받아들였다.
				ENDIF
				CFLAG:312 = 4
			;従順Lv3以上
			ELSEIF ABL:0 >= 3 && (CFLAG:312 < 3 || FLAG:7 == 2)
				PRINTFORMW 「응… 쪽… 하앗… 으음…」
				CFLAG:312 = 3
			;それ以外
			ELSEIF CFLAG:312 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「으응, 으~읏!」
				ELSE
					PRINTFORML 
					PRINTFORMW 「푸, 푸하아~」
					PRINTFORMW 「증말, 마구 핥아대지 말어!」
				ENDIF
				CFLAG:312 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;21,아무것도안한다/ま읏たりとする
;-------------------------------------------------
	CASE 21
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:313 == 0 &&  FLAG:7 == 2
			;従順Lv3以上
			IF ABL:0 >= 3 && (CFLAG:436 < 3 || FLAG:7 == 2)
				PRINTFORML 「아무것도 안 하는겨?」
				PRINTFORMW %CALLNAME%은(는) 의아한 얼굴을 하고 있다
			ELSE
				PRINTFORML 「아무것도 안 할 거믄 돌아가시게」
				PRINTFORMW %CALLNAME%은(는) 불만스러운 얼굴을 하고 있다
			ENDIF
			CFLAG:313 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:313 < 4 || FLAG:7 == 2)
				;恋慕陥落の相手に対して助手がいない状態で前回コマンドも「아무것도안한다」
				IF (TALENT:연모 || TALENT:친애) && ASSI == 0 && PREVCOM == 21
					IF RAND:2 == 0
						PRINTFORML 「저기… 아까부터 아무것도 안 하는디」
						PRINTFORML 「혹시 %CSTR:일인칭%이 싫어져 버린겨?」
					ELSE
						PRINTFORML 「둘뿐인디도 아무것도 안 해주는 건…」
						PRINTFORML 「%CSTR:일인칭%한테 질려버려서 그런겨?」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) 불안한 얼굴을 하고 있다

;コスプレモ─ド
				;童貞を殺す服（ブラウスとハイウェストスカ─ト）or 童貞を殺すセ─タ─で、その上にも下にも何も着けていない場合
				ELSEIF (TEQUIP:81 == 107 && TEQUIP:82 == 233) || (TEQUIP:81 == 130 && TEQUIP:83 == 0 && TEQUIP:85 == 0 && TEQUIP:87 == 0 && TEQUIP:90 == 0)
					PRINTFORML 「이런 꼴을 시켜놓고선 아무것도 안 하는겨?」
				;サンタコ─トを着ている場合
				ELSEIF TEQUIP:90 == 1034
					PRINTFORML 「이런 꼴을 시켜놓고선 아무것도 안 하는겨?」
;ここまでコスプレモ─ド

				;浣腸プラグを装備したまま
				ELSEIF TEQUIP:21
					IF RAND:2 == 0
						PRINTFORMW 「휴식인겨?」
						PRINTFORML 「그라믄… 저기, 이거 빼주지 않으련?」
						PRINTFORMW %CALLNAME%은(는) 엉덩이 구멍에 꽂혀 있는 플러그를 가리켰다
					ELSE
						PRINTFORML 「아무것도 안 할 거믄…… 화장실 갔다 와도 괜찮은겨?」
						PRINTFORMW %CALLNAME%은(는) 허리를 옴찔거리며 배설을 참고 있다
					ENDIF
				;恋慕、親愛
				ELSEIF TALENT:연모 || TALENT:친애
					;頑張읏た＠への夜のご褒美
					IF RAND:6 == 0 && TIME == 3 && FLAG:던전탐색완료 == 1
						PRINTFORML 「일 잔뜩 해서 지쳐버린겨?」
						PRINTFORM 「그라믄, %CSTR:일인칭%의 
						IF RAND:4 == 0
							PRINTFORML 아이스크림
						ELSEIF RAND:3 == 0
							PRINTFORML 푸딩
						ELSEIF RAND:2 == 0
							PRINTFORML 케이크
						ELSE
							PRINTFORML 슈크림
						ENDIF
						PRINTFORML , 냉장고에서 꺼내올 텐게 같이 먹자구%ハート()%」
						PRINTFORMW  냉장고에서 %CALLNAME%이(가) 가져와 준 과자를 둘이서 사이좋게 먹었다
						IF RAND:4 == 0
							PRINTFORML 　
							PRINTFORML 「자, 아~앙%ハート()%」
							PRINTFORMW %CALLNAME%이(가) 과자를 먹여주었다
						ELSEIF RAND:3 == 0
							PRINTFORML 　
							PRINTFORML 「입가에 묻어있당께%ハート()%」
							PRINTFORMW 입가에 묻어있는 과자를 %CALLNAME%이(가) 핥아 먹어주었다
						ELSEIF RAND:2 == 0
							PRINTFORML 　
							PRINTFORML 「아~앙%ハート()%」
							PRINTFORMW %CALLNAME%은(는) 아기새처럼 입을 크게 벌리고 과자를 조르고 있다
						ELSE
						;ハズレ　描写説明なし
						ENDIF
					ELSEIF RAND:5 == 0 && TIME == 3 && FLAG:던전탐색완료 == 1
						PRINTFORML 「오늘도 일 잔뜩 하느라 지쳐버린 게로구먼」
						PRINTFORML 「옳지옳지%ハート()%」
						IF 体格差() <= -9
							PRINTFORML %CALLNAME%은(는) 무릎 위에 %CALLNAME:MASTER%의 머리를 얹고 부드럽게 쓰다듬어 주었다
						ELSE
							PRINTFORML %CALLNAME%은(는) %CALLNAME:MASTER%의 머리 위에 올라타 쓱쓱 머리를 쓰다듬어 주었다
						ENDIF

					;コスプレ誘発モ─ド
					ELSEiF RAND:4 == 0
						SELECTCASE RAND:8
							;산타코트
							CASE 0
								;持읏ている場合けど着ていない（着ていたら上の条件で引읏かかる）
								IF ITEM:[[アイテム:산타코트]] == 1
									IF 体格差() < 0
										PRINTFORMW %CALLNAME%을(를) 무릎 위에 앉힌 채 텔레비전을 보고 있자, 크리스마스 장면이 흘러나왔다
									ELSE
										PRINTFORMW %CALLNAME%과(와) 소파에서 쉬면서 텔레비전을 보고 있자, 크리스마스 장면이 흘러나왔다
									ENDIF
									PRINTFORML 「저기, 요전에 산 산타 코트, 안 입어도 괜찮은겨?」
									PRINTFORML 듣고 보니 확실히 샀던 기억이 난다
									PRINTFORMW 「딱히 크리스마스가 아니어도 입어도 된당께」
								;持읏ていない場合
								ELSE
									PRINTFORML 「봐봐, 이 게임」
									PRINTFORMW %CALLNAME%은(는) 플레이하고 있던 게임 화면을 보여왔다
									PRINTFORML 「계절 상관없이 산타 차림을 하고 있구먼」
									PRINTFORMW 「%CSTR:이인칭%이 좋다믄… 입어줘도 괜찮당께%ハート()%」
								ENDIF
							;上着ブレザ─ or 服セ─ラ─服、に　下衣スカ─ト　の悪魔の場合
							CASE 1
								;持읏ている場合
								IF (ITEM:[[アイテム:블레이저교복]] || ITEM:[[アイテム:세일러복]]) && ITEM:[[アイテム:스커트]]
									;着ている場合
									IF (TEQUIP:겉옷 == [[衣装:블레이저교복]] || TEQUIP:옷 == [[衣装:세일러복]]) && TEQUIP:하의 == [[衣装:스커트]]
										;加入時からこの格好の場合
										IF (CFLAG:초기겉옷 == [[衣装:블레이저교복]] || CFLAG:초기옷 == [[衣装:세일러복]]) && CFLAG:초기하의 == [[衣装:스커트]]
											IF RAND:2 == 0
												PRINTFORML 「만났을 때부터 이 교복 차림이지만서도」
												PRINTFORMW 「다른 의상 입은 %CSTR:일인칭% 같은 건 안 보고 싶은겨?」
											ELSE
												PRINTFORML 「%CSTR:이인칭%이 교복을 좋아하는 건 알겠지만서도」
												PRINTFORMW 「가끔은 빨래를 안 하믄 곤란해져 버린당께」
											ENDIF
										ELSE
											PRINTFORML 「이 차림새라면 학교에 잠입해도 안 의심받겠구먼♪」
											PRINTFORMW 「그런 임무는 없는겨?」
										ENDIF
									ELSE
										IF 体格差() < 0
											PRINTFORMW %CALLNAME%을(를) 무릎 위에 앉히고 텔레비전을 보고 있자, 학교 장면이 흘러나왔다
										ELSE
											PRINTFORMW %CALLNAME%과(와) 소파에서 쉬면서 텔레비전을 보고 있자, 학교 장면이 흘러나왔다
										ENDIF
										PRINTFORML 「그렇게 화면을 뚫어져라 쳐다보고는」
										PRINTFORMW 「교복이 좋으믄 %CSTR:일인칭%이 입어줄까나?」
										PRINTFORMW 「옷방에 있었제」
									ENDIF
								;持읏ていない場合
								ELSE
									IF RAND:2 == 0
										IF 体格差() < 0
											PRINTFORMW %CALLNAME%을(를) 무릎 위에 앉히고 텔레비전을 보고 있자, 학교 장면이 흘러나왔다
										ELSE
											PRINTFORMW %CALLNAME%과(와) 소파에서 쉬면서 텔레비전을 보고 있자, 학교 장면이 흘러나왔다
										ENDIF
										PRINTFORML 「그렇게 화면을 뚫어져라 쳐다보고는」
										PRINTFORMW 「교복 입은 애가 좋으믄 %CSTR:일인칭%이 입어줄까나?」
										PRINTFORMW 「그치만 이런 교복을 팔기는 하려나」
									ELSE
										PRINTFORML 「이런 건 어뗘? %CSTR:일인칭%한테 어울릴 것 같은디」
										PRINTFORMW 이것저것 이야기를 나누며 %CALLNAME%와(과) 『전국 교복 도감』을 둘러보았다
									ENDIF
								ENDIF

							;간호사복
							CASE 2
								;下衣の判定？　最近はパンツスタイルらしいから判定に入れない。タイトスカ─トなり、パンツなり好きにするのだ
								;持읏ている場合
								IF ITEM:[[アイテム:간호사복]]
									;着ている場合
									IF TEQUIP:겉옷 == [[衣装:간호사복]]
										IF RAND:2 == 0
											PRINTFORML 「간호사 호출 올 때까지 한가하니께」
											PRINTFORML 당직실에서 야간근무, 라는 설정으로
											PRINTFORMW %CALLNAME%와(과) 과자를 먹으며 시간을 때웠다
										ELSE
											PRINTFORML 「자, 아~앙 해주시게♪」
											PRINTFORML 「아직 몸이 불편한 상태니께 부끄러워하지 않아도 된당께%ハート()%」
											PRINTFORML 양손 양발이 골절된 환자에게 상냥하게 대하는 간호사, 라는 설정으로
											PRINTFORMW 간호사복 차림의 %CALLNAME%에게 사과를 먹여달라고 했다
										ENDIF
									ELSE
										PRINTFORMW 「오늘은 간호사복 플레이 안 해도 되는겨?」
									ENDIF
								;持읏ていない場合
								ELSE
									IF 体格差() < 0
										PRINTFORMW %CALLNAME%을(를) 무릎 위에 앉히고 텔레비전을 보고 있자, 병실 장면이 흘러나왔다
									ELSE
										PRINTFORMW %CALLNAME%과(와) 소파에서 쉬면서 텔레비전을 보고 있자, 병실 장면이 흘러나왔다
									ENDIF
									IF ABL:종족 == 0 && RAND:2 == 0
										PRINTFORML 「환자가 간호사 엉덩이를 만지고 있는디」
										PRINTFORMW 「간호사는 야한 짓을 당하는 게 일인겨?」
										PRINTFORMW 「그라믄… %CSTR:일인칭%도 입고 일해보고 싶당께♪」
									ELSE
										PRINTFORML 「환자가 간호사 엉덩이를 만지고 있는디」
										PRINTFORML 「간호사한테는 야한 짓을 해도 되는겨?」
										PRINTFORMW 「그라믄… %CSTR:일인칭%도 입고 당해보고 싶당께♪」
									ENDIF
								ENDIF

							;童貞を殺す服（ブラウスとハイウェストスカ─ト）
							CASE 3
								;持읏ている場合けど着ていない（着ていたら上の条件で引읏かかる）
								IF ITEM:[[アイテム:블라우스]] && ITEM:[[アイテム:하이웨스트스커트]]
									;経験豊富なピクシ─と童貞あなたの場合
									IF EXP:PLAYER:삽입경험 == 0 && (ASSI == 0 || ASSIPLAY == 0) && (NO == 501 || NO == 514) && CFLAG:이벤트가입 == 2
										PRINTFORML 「요전에 산 이 옷」
										PRINTFORML 「동정인 %CSTR:이인칭%한테는 자극이 너무 셌구먼」
										PRINTFORMW %CALLNAME%은(는) 방구석에 걸려 있는 블라우스와 하이웨이스트 스커트를 가리켰다
									ELSE
										PRINTFORML 「다음번에 그 옷 입고 데이트 가자구♪」
										PRINTFORMW %CALLNAME%은(는) 방구석에 걸려 있는 블라우스와 하이웨이스트 스커트를 가리켰다
									ENDIF
								;持읏ていない場合
								ELSE
									IF 体格差() < 0
										PRINTFORMW %CALLNAME%을(를) 무릎 위에 앉히고 텔레비전을 보고 있자, 블라우스와 하이웨이스트 스커트를 입은 여성이 흘러나왔다
									ELSE
										PRINTFORMW %CALLNAME%과(와) 소파에서 쉬면서 텔레비전을 보고 있자, 블라우스와 하이웨이스트 스커트를 입은 여성이 흘러나왔다
									ENDIF
									PRINTFORML 「그 옷 입고 데이트 나가믄 다들 눈이 똥그래져서 쳐다보겠구먼%ハート()%」
									PRINTFORMW %CALLNAME%와(과) 둘이서 데이트 코스에 대해 이야기를 나누었다
								ENDIF

							;동정을죽이는스웨터
							CASE 4
								;持읏ている場合
								IF ITEM:[[アイテム:동정을죽이는스웨터]] == 1
									;着ている場合
									IF TEQUIP:81 == [[衣装:동정을죽이는스웨터]]
										PRINTFORML 「있잖여~ 뭔가 하자구우~%ハート()%」
										PRINTFORMW %CALLNAME%은(는) 옷의 구멍 사이로 맨살을 드러내며 가슴을 강조하는 포즈로 %CALLNAME:MASTER%의 얼굴을 들여다보았다
									;着ていない場合
									ELSE
										IF BUST() < 3
											PRINTFORML 「가슴이 쪼끄마믄 저 스웨터는 입으믄 안 되는겨?」
											PRINTFORMW %CALLNAME%은(는) 방구석에 걸려 있는 구멍 뚫린 스웨터를 가리켰다
										ELSE
											PRINTFORML 「저기 저기, 그 스웨터 안 입어도 되는겨?」
											PRINTFORMW %CALLNAME%은(는) 방구석에 걸려 있는 구멍 뚫린 스웨터를 가리켰다
											PRINTFORML 「설마…」
											PRINTFORMW 「가슴이 다 보이는 부끄러운 꼴을 %CSTR:일인칭%이 안 하기를 바라는겨?%ハート()%」
										ENDIF
									ENDIF
								;持읏ていない場合
								ELSE
									PRINTFORML 「저기 저기, 가슴 부위에 구멍이 뻥 뚫린 옷이 있다던디」
									IF BUST()> 3 && RAND:1 == 0
										PRINTFORML 「가슴 땜에 옷이 찢어지지 말라고 처음부터 뚫려 있는 건가」
										PRINTFORMW %CALLNAME%은(는) 엎드려 커다란 젖가슴을 짓누르며 잡지를 읽고 있다
									ELSE
										PRINTFORML 「아기한테 젖을 물리기 위해서일라나」
										PRINTFORMW %CALLNAME%은(는) 드러누워 과자를 먹으며 잡지를 읽고 있다
									ENDIF
								ENDIF

							;スク水か競泳水着
							CASE 5
								;持읏ている場合
								IF ITEM:[[アイテム:학교수영복]] || ITEM:[[アイテム:경주용수영복]]
									;着ている場合
									IF TEQUIP:전신속옷 == [[衣装:학교수영복]] || TEQUIP:전신속옷 == [[衣装:경주용수영복]] 
										;加入時からこの格好の場合
										IF CFLAG:초기전신속옷 == [[衣装:학교수영복]] || CFLAG:초기전신속옷 == [[衣装:경주용수영복]] 
											;スク水の魔法少女がいる可能性が微粒子レベルで存在するので
											IF ABL:종족 == 43
												PRINTFORML 「만났을 때부터 이 차림새였지만서도」
												PRINTFORML 「이건 취미도 뭣도 아니고」
												PRINTFORMW 「마법소녀의 코스튬이란 말이여」
											ELSE
												PRINTFORML 「만났을 때부터 이 차림새였지만서도」
												PRINTFORMW 「옷 안 갈아입혀 주는겨?」
												PRINTFORMW 「아무리 %CSTR:이인칭% 앞이라도 이건 쪼까 부끄럽구먼」
											ENDIF
										ELSE
											PRINTFORML 「수영장도 아닌디 이런 옷차림인 건」
											PRINTFORMW 「%CSTR:이인칭%의 취향인 게로구먼%ハート()%」
										ENDIF
									;着ていない場合
									ELSE
										;加入時からこの格好の場合
										IF CFLAG:초기전신속옷 == [[衣装:학교수영복]] || CFLAG:초기전신속옷 == [[衣装:경주용수영복]] 
											;スク水の魔法少女がいる可能性が微粒子レベルで存在するので
											IF ABL:종족 == 43
												PRINTFORML 「코스튬이 아니믄 마법을 못 쓰는 줄 알았는디」
												PRINTFORML 「실제론 수영복을 안 입어도 마법을 쓸 수 있었구먼」
												IF 体格差() > 0
													PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%의 무릎 위에서 편안히 쉬고 있다
												ELSE
													PRINTFORMW %CALLNAME%은(는) 소파에서 편안히 쉬고 있다
												ENDIF
											ELSE
												PRINTFORML 「만났을 적엔 수영복이었지만서도」
												PRINTFORMW 「그건 취미가 아니었으니께」
											ENDIF
										ELSE

										ENDIF
									ENDIF
								ELSE

								ENDIF

							;穴あきスク水か競泳水着
							CASE 6
								;持읏ている場合
								IF ITEM:[[アイテム:학교수영복（구멍뚫림）]] || ITEM:[[アイテム:경주용수영복（구멍뚫림）]]
									;着ている場合
									IF TEQUIP:전신속옷 == [[衣装:학교수영복（구멍뚫림）]] || TEQUIP:전신속옷 == [[衣装:경주용수영복（구멍뚫림）]] 

									ELSE

									ENDIF
								ELSE

								ENDIF

							;衣服で体操服にブルマかスパ읏ツ
							CASE 7
								;持읏ている場合
								IF ITEM:[[アイテム:체육복]] && (ITEM:[[アイテム:블루머]] || ITEM:[[アイテム:스패츠]])
									;着ている場合
									IF TEQUIP:옷 == [[衣装:체육복]] && (TEQUIP:하의 == [[衣装:블루머]] || TEQUIP:속옷（하） == [[衣装:스패츠]])

									ELSE

									ENDIF
								ELSE

								ENDIF

							;婦警（警官の服）
							CASE 8
								;持읏ている場合
								IF ITEM:[[アイテム:경관복]]
									;着ている場合
									IF TEQUIP:옷 == [[衣装:경관복]]
										IF 体格差() < 0
											PRINTFORML 「무슨 일이람유~ 꼬마야~」
											PRINTFORMW 여경과 길 잃은 아이, 라는 역할놀이로 %CALLNAME%와(과) 놀았다
										ELSE

										ENDIF

									ELSE

									ENDIF
								ELSE

								ENDIF

						ENDSELECT
						;ここまでコスプレ誘発モ─ド

					ELSEIF RAND:3 == 0
						PRINTFORMW 「휴식？」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「생각할 거리라도 있는겨?」
					ELSE
						PRINTFORMW 「요새 멍하니 있는 일이 많구먼」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「보류여?」
					ELSE
						PRINTFORMW 「저기~ 얼른 짝짓기하자구~」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「생각 중인겨…?」
					ELSE
						PRINTFORML 「뭔가… 잘못됐는가?」
						PRINTFORMW 불안한 표정을 지으며 %CALLNAME%은(는) %CALLNAME:MASTER%의 얼굴을 들여다보았다.
					ENDIF
				ENDIF
				CFLAG:313 = 4
			;浣腸プラグを装備したまま
			ELSEIF TEQUIP:21
				IF RAND:2 == 0
					PRINTFORML 「아무것도 안 할 거믄…… 얼른 이거 빼주시게」
				ELSE
					PRINTFORML 「이런 걸 꽂아둔 채론 휴식 같은 건 못 한당께……」
				ENDIF
				PRINTFORMW %CALLNAME%은(는) 엉덩이 구멍에 꽂혀 있는 플러그를 가리켰다
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:313 < 3 || FLAG:7 == 2)
				PRINTFORMW 「무, 무슨 짓을 당하든 안 질 거여」
				CFLAG:313 = 3
			;それ以外
				ELSEIF CFLAG:313 < 2 || FLAG:7 == 2
				PRINTFORML 「버, 벌써 끝인겨?」
				PRINTFORMW %CALLNAME%은(는) 기쁜 표정을 지었으나, 조교를 계속하겠다고 하자 이내 슬픈 표정을 지었다.
				CFLAG:313 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;22,회화　恋慕、親愛のみ
;-------------------------------------------------
	CASE 22
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:314 == 0 &&  FLAG:7 == 2
			PRINTFORMW 「있잖여, 있잖여. 들어줬으면 하는 얘기가 잔뜩 있당께」
