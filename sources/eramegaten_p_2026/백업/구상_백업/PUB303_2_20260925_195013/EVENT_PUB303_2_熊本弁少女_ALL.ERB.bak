					PRINTFORMW 
					CFLAG:361 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:361 < 3 || FLAG:7 == 2)
					PRINTFORMW 
					CFLAG:361 = 3
				;それ以外
				ELSEIF CFLAG:361 < 2 || FLAG:7 == 2
					PRINTFORMW 
					CFLAG:361 = 2
				ENDIF
			ENDIF
