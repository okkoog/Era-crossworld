;192,콘돔정음（노예）
;-------------------------------------------------
	CASE 192
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:404 == 0
			IF 陥落() > 0
				PRINTFORML 「고무 냄새 나…」
				PRINTFORMW 「그냥 해도 괜찮은디」
			ELSE
				IF ABL:정액중독 >= 5
					PRINTFORMW 「한 잔 더 줄 거라믄… 그……」
				ELSEIF ABL:정액중독 >= 1
					PRINTFORMW （싫어… 이런 녀석의 정액인디도…）
				ELSE
					PRINTFORMW 「비릿하구마…」
				ENDIF
			ENDIF
			CFLAG:404 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:404 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF ABL:정액중독 >= 3
						IF RAND:2 == 0
							PRINTFORMW 「%CSTR:이인칭%의 정액……%ハート()%」
						ELSE
							PRINTFORMW 「있제, 고무 같은 건 안 껴도 괜찮당께%ハート()%」
						ENDIF
					ELSE
						PRINTFORMW 「참말로는 정액 질색이지만서도, %CSTR:이인칭% 거라면, 꼭 마실게잉」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF ABL:정액중독 >= 3
						IF RAND:3 == 0 && HAVE_VAGINA()
							PRINTFORMW 「있제, 입이든 보지든 좋아하는 쪽에 직접 싸줘도 괜찮당께요♪」
						ELSEIF RAND:2 == 0
							PRINTFORMW 「있제, 입에 직접 싸줘도 괜찮당께요♪」
						ELSE
							PRINTFORMW 「잘 먹었습니데이%ハート()%」
						ENDIF
					ELSE
						IF RAND:2 == 0 && HAVE_VAGINA()
							PRINTFORML 「있제, 고무 같은 거 안 끼고 보지에 사정해도 괜찮당께요♪」
							PRINTFORMW 「게다가, 그쪽이 %CSTR:일인칭%도 더 좋응께」
						ELSE
							PRINTFORML 「우엑」
							PRINTFORMW 「역시나 정액은 마실 만한 게 못 되구마」
							PRINTFORML 「자, 요기에 사정해야제♪」
							PRINTFORMW %CALLNAME%은(는) 자신의 구멍을 가리켰다
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「한 번 더 고무를 쓸 수 있을 정도로 깨끗하게 핥아줄게잉」
				ENDIF
				CFLAG:404 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:404 < 3 || FLAG:7 == 2)
				PRINTFORMW 
				CFLAG:404 = 3
			;それ以外
			ELSEIF CFLAG:404 < 2 || FLAG:7 == 2
				IF ABL:정액중독 >= 3
					IF RAND:2 == 0
						PRINTFORML 「냄새나는디도……」
						PRINTFORMW 억지를 부리며 그리 말하는 %CALLNAME%이지만, 그 표정은 정반대였다
					ELSE
						PRINTFORMW 「고무 속의 정액을 마시게 하다니……」
						PRINTFORMW （고무 냄새 나니께 직접 마시는 편이 더 좋을 텐디）
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「고대로 쓰레기통에 버려버리믄 될 텐디, 왜 %CSTR:일인칭%한테 먹이는겨!」
					ELSE
						PRINTFORMW 「이런 걸 먹이다니……」
					ENDIF
				ENDIF
				CFLAG:404 = 2
			ENDIF
		ENDIF

