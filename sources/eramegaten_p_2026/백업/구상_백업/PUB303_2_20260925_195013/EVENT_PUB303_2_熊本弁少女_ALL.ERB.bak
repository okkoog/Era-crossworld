	CASE 30
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:422 == 0
			IF RAND:2 == 0
				PRINTFORMW 「가슴에 끼워지믄 기분 좋은겨?」
				PRINTFORMW 「그라믄 또 해줄 텐게%ハート()%」
			ELSE
				PRINTFORMW 「오구오구, 아가 같구먼유~」
			ENDIF
			CFLAG:422 = 1
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				IF RAND:3 == 0
					PRINTFORMW 「어뗘, 가슴에 끼워져서 기분 좋은겨?」
					;挟む？　日本語でおｋ
					IF TALENT:빈유
						PRINTFORML ………
						PRINTFORMW 「！」
						PRINTFORMW 「머잖아 끼울 수 있게 될 거랑께!」
					ENDIF
				ELSEIF RAND:2 == 0
					PRINTFORMW 「와앗, 핥으믄 안 된당께」
				ELSE
					PRINTFORMW 「콧김이 거칠구먼, %CSTR:이인칭%」
					PRINTFORMW 「어린애 가슴에 흥분한겨?」
				ENDIF
			ELSEIF FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「아프니께 가슴 깨물믄 안 된당께」
					ELSE
					PRINTFORMW 「콧김이 거칠구먼… 변태」
				ENDIF
			ENDIF
		ENDIF


;=================================================
;道具使用コマンド
