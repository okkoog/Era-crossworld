						ENDIF
					ELSEIF ABL:마조끼 >= 2
						PRINTFORML 「보여지면서 싸버렸는디도……」
						PRINTFORMW %CALLNAME%의 목소리는 살짝 들떠 있다
					ELSE
						IF RAND:3 == 0
							PRINTFORML 「보지 마! 듣지 마! 냄새 맡지 마!」
						ELSEIF RAND:2 == 0
							PRINTFORML 「이제 싫어……」
						ELSE
							PRINTFORML 「죄송해요, 잘못했어요」
							PRINTFORML 「이제 용서해 주시게……」
						ENDIF
						IF RAND:3 == 0
							PRINTFORMW %CALLNAME%은(는) 배설을 참으려 했지만
							PRINTFORML 
							PRINTFORMW 뷰풋!
							PRINTFORMW 오히려 커다란 소리를 내며 오물을 뿜어냈다……
						ELSEIF RAND:2 == 0
							PRINTFORMW %CALLNAME%은(는) 울면서 장내에 남아있는 오물을 줄줄 흘리고 있다
						ELSE
							PRINTFORMW %CALLNAME%은(는) 체념한 표정으로 배설을 계속하고 있다
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;147,공기관장
;-------------------------------------------------
	CASE 147
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:376 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:376 < 4 || FLAG:7 == 2)
				PRINTFORMW 「이런 플레이도 있구마……」
			ELSE
				PRINTFORMW 「이런 부끄러운 거, 담번에 또 하믄 화낼 거니께!」
			ENDIF
			CFLAG:376 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:376 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0 && TALENT:아내
						PRINTFORMW 「안 돼! 부부라도 안 되는 건 있는 법이랑께!」
						PRINTFORMW 「들어도, 맡아도 안 된당께!」
					ELSE
						PRINTFORML 「%CSTR:이인칭%이 하고 싶다니께 하겠지만서도……」
						PRINTFORMW 「부끄러운 거란 말이여, 참말로」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					ELSEIF TALENT:음란 || TALENT:창부
						IF RAND:2 == 0
							PRINTFORMW 「여러 짓 다 해봤지만서도, 이건 역시나 부끄럽구마」
						ELSE
							PRINTFORMW 「이런 짓을 해가 %CSTR:이인칭%은(는) 흥분하는겨?」
						ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「넣어준 공기, 몽땅 다 빼냈당께♪」
					ELSE
						PRINTFORML 「부끄럽지만서도」
						PRINTFORMW 「%CSTR:이인칭%이 기뻐해 준다믄, 몇 번이고 오케이랑께♪」
					ENDIF
				ENDIF
				CFLAG:376 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:376 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORMW 「엉덩이 구멍까지 저항할 수 없게 돼버렸어……」
				ELSE
					PRINTFORMW （방귀 소리까지 들켜버리다니, %CSTR:일인칭%은(는)……）
				ENDIF
				CFLAG:376 = 3
			;それ以外
			ELSEIF CFLAG:376 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORML 「와아! 와아, 와아!」
					PRINTFORMW %CALLNAME%은(는) 소리를 들키지 않으려 큰 소리를 내고 있다
				ELSE
					PRINTFORML 「방귀 아닝께! 구리지 않응께!」
					PRINTFORMW %CALLNAME%은(는) 여기저기 허둥지둥 부채질하고 있다
				ENDIF
				CFLAG:376 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;148,확장벌룬
;-------------------------------------------------
	CASE 148
		CALL TRAIN_MESSAGE
		IF TEQUIP:22
			;初めて
			IF CFLAG:377 == 0
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:377 < 4 || FLAG:7 == 2)
					PRINTFORMW 「어쩐지 배가 안에서부터 부풀고 있당께!」
				ELSE
					PRINTFORMW 「엉덩이가, 배가……」
				ENDIF
				CFLAG:377 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:377 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						PRINTFORML 「넓… 넓어져 온당께…」
						PRINTFORML 「이 담에… 엉덩이에 무슨 짓을 해도 좋지만서도…」
						PRINTFORMW 「이거, 뽑고 난 뒤에 하자잉…」
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						PRINTFORML 「아앙♪」
						PRINTFORMW 「배 속이, 부풀어 오른당께♪」
						PRINTFORMW 「이 담엔, 뭘 넣으려나%ハート()%」
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						PRINTFORML 「%CSTR:이인칭%, %CSTR:일인칭%의 배가 부풀어 오른 거 보여?」
						PRINTFORML 「이대로 터뜨려버려도 괜찮당께」
					ENDIF
					CFLAG:377 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:377 < 3 || FLAG:7 == 2)
					PRINTFORML 「또 하는겨」
					PRINTFORMW 「말 잘 들을팅께, 용서해줘!」
					CFLAG:377 = 3
				;それ以外
				ELSEIF CFLAG:377 < 2 || FLAG:7 == 2
					PRINTFORML 「또 하는겨!」
					PRINTFORMW 「싫어, 안 된당께에-」
					CFLAG:377 = 2
				ENDIF
			ENDIF
		;解除時
		ELSEIF FLAG:7 == 2
			IF ABL:5 >= 5
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:377 < 4 || FLAG:7 == 2)
					IF RAND:2 == 0
						PRINTFORMW 「있제, 요쪽 구멍 써서 이것저것 하자잉-……」
					ELSE
						PRINTFORMW 「봐봐, 요쪽 구멍, 이렇게나 넓어지잖여」
					ENDIF
					;淫乱ル─トで助手がいる場合
					IF  (TALENT:음란 || TALENT:창부) && ASSI > 0
						PRINTFORMW 「지금이라믄 두 사람 꼬추라도 들어가 버린당께♪」
					ELSE
						PRINTFORMW 「둘이서 기분 좋아지자잉♪」
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「엉덩이가 벌려지니께, 기분 좋아져 버렸어……」
					ELSE
						PRINTFORMW 「이런 짓을 당해뿌렀는디도, 엉덩이가 기분 좋아……」
					ENDIF
				ENDIF
			ELSEIF ABL:5 >= 2
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:377 < 4 || FLAG:7 == 2)
					IF RAND:2 == 0
						PRINTFORMW 「봐봐, 훤히 다 보인당께♪」
					ELSE
						PRINTFORMW 「이러믄 뭐든지 들어가겄네♪」
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「엉덩이 구멍이, 바보가 돼버렸어……」
					ELSE
						PRINTFORMW 「엉덩이 구멍이, 안 다물어지게 돼버렸어……」
					ENDIF
				ENDIF
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:377 < 4 || FLAG:7 == 2)
					PRINTFORMW 「엉덩이 놀이, 재밌었어?」
					PRINTFORMW 「하지만서도, 망가져 버리니께 적당히 하자잉」
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「엉덩이 구멍, 망가져 버린당께에……」
					ELSE
						PRINTFORMW 「%CSTR:일인칭%의 엉덩이, 장난감 취급 마시게」
					ENDIF
				ENDIF
			ENDIF
		ENDIF

