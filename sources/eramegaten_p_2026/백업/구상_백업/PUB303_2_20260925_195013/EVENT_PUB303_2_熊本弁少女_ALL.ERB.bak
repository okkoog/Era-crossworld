				;二人ともち읏ぱい場合
				IF BUST() < 3 && BUST(ASSI) < 3
					PRINTFORML (가슴이 작아서 힘들어 보이는디도 저런 얼굴을 하구선)
				ELSE
					PRINTFORML (저렇게 기쁜 듯이 자지를 끼우고선)
				ENDIF
				PRINTFORMW (%CSTR:일인칭%도 저런 얼굴을 하고 있으려나……)
				CFLAG:367 = 3
			;それ以外
			ELSEIF CFLAG:367 < 2 || FLAG:7 == 2
				;調教対象だけがで읏ぱい場合
				IF BUST(ASSI) > 3 && BUST(ASSI) < 3
					PRINTFORML 「가슴이 큰 편인디」
					PRINTFORML 「%CALLNAME:ASSI%한테만 시키믄 될 텐디」
				;二人ともで읏ぱい場合
				ELSEIF BUST(ASSI) > 3 && BUST(ASSI) > 3
					PRINTFORML 「%CSTR:일인칭%도 크긴 하지만서도」
					PRINTFORML 「%CALLNAME:ASSI%도 크니께 혼자서도 충분할 텐디」
				ENDIF
				PRINTFORMW 「왜 %CSTR:일인칭%까지……」
				CFLAG:367 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;126,가슴맞대기
;-------------------------------------------------
	CASE 126
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:368 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:368 < 4 || FLAG:7 == 2)
				PRINTFORMW 「%CSTR:일인칭%의 기분 좋은 곳, %CSTR:이인칭%도 기분 좋게 해줄게♪」
			ELSE
				PRINTFORMW 「이 정도라면 용서해 줄게」
			ENDIF
			CFLAG:368 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:368 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2== 0
						PRINTFORMW 「이게 『시시덕거리다(가슴 주무르다)』라는 거제?」
					ELSE
						PRINTFORMW 「둘이서 젖꼭지가 딱딱해져 왔네」
						PRINTFORMW 「서로 사랑하는 증거구먼%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF BUST() < BUST(PLAYER) && RAND:2 == 0
						PRINTFORMW 「역시 커다란 가슴은 좋구먼♪」
					ELSEIF (BUST() > BUST(PLAYER)) && RAND:2 == 0
						PRINTFORMW 「작은 가슴, 귀엽네♪」
					ELSE
						PRINTFORMW 「서로, 끝부분이 딱딱해져 있네♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 「%CSTR:이인칭% 손이 기분 좋아서」
					PRINTFORMW 「%CSTR:일인칭%만 기분 좋아져서 미안혀요」
				ENDIF
				CFLAG:368 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:368 < 3 || FLAG:7 == 2)
				PRINTFORMW 「여자끼리 이런 짓, 이상하지만서도……」
				PRINTFORMW 「기분 좋은디 어쩌지……」
				CFLAG:368 = 3
			;それ以外
			ELSEIF CFLAG:368 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「여자끼리 이런 짓, 이상하당께……」
				ELSE
					PRINTFORMW 「저기, 이런 짓 그만두자구」
				ENDIF
				CFLAG:368 = 2
			ENDIF
		ENDIF

