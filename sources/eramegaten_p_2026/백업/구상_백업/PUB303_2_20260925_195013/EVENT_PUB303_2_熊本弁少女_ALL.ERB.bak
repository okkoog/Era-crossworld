					PRINTFORMW 「그런 플레이를 하는 거구먼?」
					PRINTFORMW 「처음이라서 조금 긴장되지만서도, 해볼게%ハート()%」
				ELSEIF FLAG:7 == 2
					PRINTFORMW 「괜찮아, %CSTR:일인칭%, 이제 안 도망칠 테니께」
				ENDIF
				CFLAG:360 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:360 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						PRINTFORMW 「밧줄 같은 거 안 써도, %CSTR:일인칭%은 어디에도 안 간단께%ハート()%」
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						IF RAND:2 == 0
							PRINTFORMW 「밧줄로 못 움직이게 하고선 뭘 할 셈인겨?」
						ELSE
							PRINTFORMW 「못 움직이는 상대한테 해보고 싶었던 거제?」
						ENDIF
						PRINTFORMW 「%CSTR:일인칭%한테라면 뭘 해도 괜찮당께♪」
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						IF RAND:2 == 0
							PRINTFORMW 「그렇게 힘껏 세게 잡아당기믄 아프당께♪」
						ELSE
							PRINTFORMW 「이제 꽉 끼어서 못 움직이겠어♪」
						ENDIF
					ENDIF
					CFLAG:360 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:360 < 3 || FLAG:7 == 2)
					PRINTFORMW 「그렇게 %CSTR:일인칭%을 독차지하고 싶은겨?」
					PRINTFORMW 「그렇다고 이건 아니라고 생각하는디……」
					CFLAG:360 = 3
				;それ以外
				ELSEIF CFLAG:360 < 2 || FLAG:7 == 2
					IF TALENT:포동포동 && RAND:3 == 0
						PRINTFORMW 「방금 『햄 같다』고 말하지 않았어?」
					ELSEIF  RAND:2 == 0
						PRINTFORMW 「또 묶어서 못 움직이게 하구선……」
					ELSE
						PRINTFORMW 「이대로 팔아넘길 셈인 거제……」
					ENDIF
					CFLAG:360 = 2
				ENDIF
			ENDIF
		ELSE
			IF CFLAG:360 == 1 || FLAG:7 == 2
				CALL TRAIN_MESSAGE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:360 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						IF RAND:2 == 0
							PRINTFORMW 「밧줄로 묶어버릴 만큼 %CSTR:일인칭%을 놓고 싶지 않았던 거구먼%ハート()%」
						ELSE
							PRINTFORMW 「풀어주는겨?」
							PRINTFORMW 「%CSTR:이인칭%한테라면, 그대로도 괜찮았지만서도%ハート()%」
						ENDIF
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						IF RAND:2 == 0
							PRINTFORMW 「밧줄 풀고서, 뭘 할 생각인 걸까나?」
						ELSE
							PRINTFORML 「움직일 수 있게 됐으니께, 가~득 보답해 줄 테니께」
							PRINTFORMW 「각오하시게♪」
						ENDIF
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						PRINTFORMW 「다음 조교구먼, %CSTR:이인칭%」
					ENDIF
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:360 < 3 || FLAG:7 == 2)
					PRINTFORMW 「풀어주는겨?」
					PRINTFORMW (못 움직이는 것도 조금 좋았을지도……)
				;それ以外
				ELSEIF CFLAG:360 < 2 || FLAG:7 == 2
					IF TALENT:포동포동 && RAND:2 == 0
						PRINTFORMW 「방금 『햄 같다』고 말하지 않았어?」
					ELSE
						PRINTFORMW 「으와~, 묶인 곳, 보라색으로 변해 있네」
					ENDIF
					IF RAND:2 == 0
						PRINTFORMW 「최악이야……」
					ELSE
						PRINTFORMW 「이거, 얼마나 있어야 나으려나……」
					ENDIF
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;107,볼재갈
