							PRINTFORML 「%CSTR:일인칭%이(가) 촉수로 볼록배가 되는 거 보고 즐겨주시게%ハート()%」
						ELSE
							PRINTFORMW 「오오오오옷♪」
							PRINTFORML 「지금, 여그까지 와 있시유우♪」
							PRINTFORMW %CALLNAME%은(는) 태내에서 날뛰는 촉수가 어디까지 닿았는지를 실황 중계하고 있다…
						ENDIF
					ENDIF
					CFLAG:383 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:383 < 3 || FLAG:7 == 2)
					IF RAND:3 == 0
						PRINTFORML 「또 몸속으로 들어온당께……」
					ELSEIF RAND:2 == 0
						PRINTFORML 「오오오오오오옷」
						PRINTFORMW 「빼애줘, 엉덩이, 항복할 텡께에」
					ELSE
						PRINTFORML 「오오오오오오옷」
						PRINTFORMW %CALLNAME%은(는) 소녀가 내서는 안 될 법한 소리를 지르고 있다
					ENDIF
					CFLAG:383 = 3
				;それ以外
				ELSEIF CFLAG:383 < 2 || FLAG:7 == 2
					IF RAND:2 == 0
						PRINTFORML 「싫어! 몸속으로 들어오지 마시게!」
						PRINTFORMW %CALLNAME%은(는) 몸을 비틀며 도망치려 하지만 저항도 헛되이 촉수는 체내로 파고들어 간다…
					ELSE
						PRINTFORML 「오오오오오오옷」
						PRINTFORMW %CALLNAME%은(는) 눈물과 콧물, 침으로 얼굴을 엉망으로 일그러뜨리며 비명을 지르고 있다
					ENDIF
					CFLAG:383 = 2
				ENDIF
			ENDIF
		;触手排出
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:383 < 4 || FLAG:7 == 2)
