					ELSEIF RAND:2 == 0
						PRINTFORMW 「기념으로 마셔볼텨?」
					ELSE
						PRINTFORMW 「잘 풀렸구마, %CSTR:이인칭%♪」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「앗…… 젖이다♪」
					PRINTFORML 「어린애 가슴에서 젖이 나오게 만들다니」
					PRINTFORMW 「정말이지 어쩔 수가 없구마 %CSTR:이인칭%은(는)……」
					IF RAND:2 == 0
						PRINTFORMW 「하지만서도, 모유가 퓨퓨 뿜어져 나오는 거 기분 좋으니께 됐어」
					ELSE
						PRINTFORMW 「냉큼 모유 마시면서 섹스할텨? 아니믄 모유랑 정액이랑 섞어볼텨?」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「앗…… 젖이다♪」
					IF RAND:2 == 0
						PRINTFORML 「당연히 %CSTR:일인칭%의 젖도 %CSTR:이인칭% 것이니께」
						PRINTFORMW 「마시든 팔아치우든 마음대로 하라구」
					ELSE
						PRINTFORML 「%CSTR:이인칭%, 가슴에서 모유가 나오게 됐당께♪」
						PRINTFORMW 「이것도 다 %CSTR:이인칭% 덕분이구마잉%ハート()%」
					ENDIF
				ENDIF
				CFLAG:431 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:431 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORMW 「어린앤디 가슴에서 젖이 나오게 되어버렸구마」
					PRINTFORMW 「다음엔 뭘 당하는 기려나……」
				ELSE
					PRINTFORMW 「어린앤디 가슴이……」
					PRINTFORMW 「요상한 몸으로 개조당해 버렸당께」
				ENDIF
				CFLAG:431 = 3
			;それ以外
			ELSEIF CFLAG:431 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORML 「아직 어린앤디 젖이 나오다니 이상한 일인디……」
					PRINTFORMW 「너무한당께!」
				ELSE
					PRINTFORML 「거짓말……」
					PRINTFORMW 「아직 어린앤디, 아기도 없는디……」
				ENDIF
				CFLAG:431 = 2
			ENDIF
		;初めて
		ELSEIF CFLAG:431 == 0
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				PRINTFORMW 「에? 에에에에에!? 가, 가슴에서 젖이 나오다니 어째서 그런 짓을 한겨!?」
				PRINTFORMW 「아기가 생겼을 때를 대비한 예행연습… 으-…」
				PRINTFORMW 「알았당께… %CSTR:이인칭%이랑 %CSTR:일인칭%의 아기를 위해 힘낼게」
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORMW 「가슴에서 젖이 나오도록 개조당해 버리는겨?」
				PRINTFORML 
				PRINTFORMW 「좋당께」
				PRINTFORMW 「조그만 찌찌로 개조해 주시게%ハート()%」
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORMW 「가슴에서 젖이 나오도록 개조당해 버리는겨?」
				PRINTFORML 
				PRINTFORMW 「좋당께」
				PRINTFORMW 「밀크 머신으로 개조해 주시게%ハート()%」
			ELSE
				PRINTFORML 「에? 에에에에에!? 가, 가슴에서 젖이 나오다니 어째서 그런 짓을 한겨!?」
				PRINTFORML 「%CSTR:일인칭%, 아직 어린애란 말이여」
				PRINTFORMW %CALLNAME:MASTER%은(는) 일단 멈추었던 손을 다시 움직였다
			ENDIF
			CFLAG:431 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:431 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「으으… 이거 억수로 아프고 이상한 느낌이 든단 말이여…」
					IF RAND:2 == 0
						PRINTFORMW 「알고 있당께, %CSTR:이인칭%이랑 %CSTR:일인칭%의 아기를 위해서니께, 참을게」
						PRINTFORMW 「그랑께 끝나믄 상으로 키스 잔뜩 해주시게?」
					ELSE
						PRINTFORMW 「게다가 %CSTR:이인칭%과의 아기가 생기믄, 자연스럽게 나오게 될 테고…」
						PRINTFORMW 「정말이지~, 어쩔 수가 없구마. 이걸로 끝이랑께, 절대로 끝이랑께!」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「정말-… 그렇게나 %CSTR:일인칭% 가슴에서 젖이 나오게 하고 싶은겨?」
					PRINTFORML 「정말이지 어쩔 수가 없구마 %CSTR:이인칭%은(는)…」
					PRINTFORMW 「하지만서도, 모유가 퓨퓨 뿜어져 나오는 거 기분 좋아 보이니께 됐어」
				;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「정말-… 그렇게나 %CSTR:일인칭% 가슴에서 젖이 나오게 하고 싶은겨?」
					PRINTFORMW 「정말이지 어쩔 수가 없구마 %CSTR:이인칭%은(는)…」
					PRINTFORMW 「모유가 퓨퓨 나와버리는 칠칠치 못한 가슴이 되어버리믄 책임 억수로 져야 할 거랑께!」
				ENDIF
				CFLAG:431 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:431 < 3 || FLAG:7 == 2)
				PRINTFORMW 「그런 짓을 해봤자 젖 같은 건 안 나온당께」
				CFLAG:431 = 3
			;それ以外
			ELSEIF CFLAG:431 < 2 || FLAG:7 == 2
				PRINTFORML 「아직 어린앤디 젖이 나오믄 이상한 일이란 말이여」
				PRINTFORMW 「그런 짓 하지 마시게」
				CFLAG:431 = 2
			ENDIF
		ENDIF

