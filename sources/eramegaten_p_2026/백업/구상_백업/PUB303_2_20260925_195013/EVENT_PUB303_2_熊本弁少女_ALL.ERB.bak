				IF TEQUIP:PLAYER:11
					PRINTFORMW 「이거, %CSTR:이인칭%이 차고 있는 거랑 똑같은 거제?」
				ELSE
					PRINTFORMW 「이게 뭐여? 말랑말랑해서 재밌구먼」
				ENDIF
				CFLAG:324 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && CFLAG:324 < 4
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						IF TEQUIP:PLAYER:11
							PRINTFORMW 「이걸로 세트가 된 거로구먼%ハート()%」
							PRINTFORMW 「어느 쪽이 콩알을 더 잘 참나 시합이랑께」
						ELSE
							PRINTFORMW 「싫어어어어, %CSTR:이인칭%, %CSTR:이인칭%이이, 좋은디이이이!!」
							PRINTFORMW 「부르르 떠는 거, 감질나서, 싫어어어어!!」
						ENDIF
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						PRINTFORMW 「콩알 바르르 떠는 거 기분 좋아아%ハート()%」
						PRINTFORMW 「딴 데도 만져줘어… 가슴도, 보지도, 엉덩이도, 콩알이랑 같이 보내줬으면 좋겠당께에%ハート()%」
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						PRINTFORMW 「콩알이 짓눌리면서 바르르 떨려… %CSTR:일인칭% 계속 가버린 채로 있게 된당께에」
					ENDIF
					CFLAG:324 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && CFLAG:324 < 3
					PRINTFORMW 「또 그거 써서 콩알에 장난치는 거로구먼」
					CFLAG:324 = 3
				;それ以外
				ELSEIF CFLAG:324 < 2
					PRINTFORML 「아, 안 돼애」
					PRINTFORMW 「콩알에 장난치지 말어어」
					CFLAG:324 = 2
				ENDIF
			ENDIF
		;脱着
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:324 < 4 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORMW 「콩알 기분 좋았당께%ハート()%」
				ELSE
					PRINTFORMW 「이번엔 %CSTR:이인칭%이 기분 좋아지시게나%ハート()%」
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:324 < 3 || FLAG:7 == 2)
				PRINTFORMW 「아직도 찌릿찌릿 울려…」
			;それ以外
			ELSEIF CFLAG:324 < 2 || FLAG:7 == 2
				PRINTFORMW 「인자 그거 고만해줘어…」
			ENDIF
		ENDIF

;-------------------------------------------------
;43,오나홀
;-------------------------------------------------
	CASE 43
		CALL TRAIN_MESSAGE
		;装備時
		IF TEQUIP:12 == 1 && FLAG:7 == 2
			;初めて
			IF CFLAG:325 == 0
				PRINTFORMW 「…이게 뭐여?」
				PRINTFORMW 「말랑말랑하구먼… 아, 이 구멍, 보지 같네…」
				PRINTFORMW 「쓰는겨? …%CSTR:일인칭%이?」
				CFLAG:325 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && CFLAG:325 < 4
					;간호사복
					IF TEQUIP:옷 == 105
						IF RAND:2 == 0
							PRINTFORML 「네~」
							PRINTFORML 「정액 채취 시간이긴 한디」
							PRINTFORMW 「이번에도 이거 써버릴 텐게」
							PRINTFORMW 「여긴 병원이니께 야한 짓은 안 된당께~」
						ELSE
							PRINTFORML 「네~ 도구 챙겨올 텐게」
							PRINTFORML 「알아서 자지에서 찍찍 뽑아주시게나」
							PRINTFORMW 「간호사는 야한 일은 안 도와주니께유~」
						ENDIF
					;恋慕、親愛
					ELSEIF TALENT:연모 || TALENT:친애
						IF RAND:2 == 0
							PRINTFORMW 「이거 말고, %CSTR:이인칭%한테 넣고 싶은디… 안 되는겨?」
						ELSE
							PRINTFORMW 「하아앙%ハート()%」
							PRINTFORMW 「살짝 가버렸구먼%ハート()%」
						ENDIF
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						IF RAND:2 == 0
							PRINTFORML 「우먀아아아%ハート()%」
							PRINTFORMW 「자지, 억수로 대단허구먼%ハート()%」
						ELSE
							PRINTFORML 「저기~ 가짜 말고, 진짜배기 보지에 넣고 싶은디이~」
							PRINTFORML 「다음번에 누구 소개해 주시게나%ハート()%」
						ENDIF
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						IF RAND:2 == 0
							PRINTFORML 「가짜 보지에 넣을게유…」
						ELSE
							PRINTFORML 「%CSTR:일인칭% 따위한테 진짜배기 보지라니 과분하긴 하구먼…」
						ENDIF
						PRINTFORMW %CALLNAME%은(는) 자신의 페니스를 천천히 오나홀에 삽입해 간다
					ENDIF
					CFLAG:325 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && CFLAG:325 < 3
					PRINTFORMW 「아, 안 멈춘당께!」
					PRINTFORMW 「기분 좋은 게, 자지가 안 멈춘단 말이여!」
					CFLAG:325 = 3
				;それ以外
				ELSEIF CFLAG:325 < 2
					IF RAND:2 == 0
						PRINTFORMW 「아, 안 돼애, 이런 거 안 돼, 읏! 안 돼애!」
					ELSE
						PRINTFORMW 「그 돌기들이 닿으믄 이상해져 버리니께 싫당께~」
					ENDIF
					CFLAG:325 = 2
				ENDIF
			ENDIF
		;脱着
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:325 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORMW 「기분 좋기는 했지만서도…… %CSTR:이인칭%의 구멍에 넣고 싶구먼%ハート()%」
					ELSE
						PRINTFORMW 「아직……」
						PRINTFORMW 「아직 정액 더 나오니께… 짝짓기하자구, %CSTR:이인칭%%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「저기, 다음엔 %CSTR:이인칭%의 구멍에 넣어도 되는겨?」
					ELSE
						PRINTFORMW 「이거, 버릇 들어버리겠제?」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「굉장했당께, %CSTR:이인칭%」
				ENDIF
				CFLAG:325 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:325 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORML 「기, 기분 좋지 않았당께!」
					PRINTFORMW 입으로는 부정하고 있지만, 방금 전까지 쓰던 오나홀을 힐끔힐끔 쳐다보고 있다
				ELSE
					PRINTFORMW 「……랑께」
					PRINTFORML 「오나홀 기분 좋았어!」
					PRINTFORMW 오나홀의 소감을 묻자 %CALLNAME%은(는) 우물쭈물하며 대답했다
				ENDIF
				CFLAG:325 = 3
			;それ以外
			ELSEIF CFLAG:325 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「기, 기분 따위 안 좋았당게!」
				ELSE
					PRINTFORMW 「인자 그 돌기는 싫당께~」
				ENDIF
				CFLAG:325 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;44,바이브
;-------------------------------------------------
	CASE 44
		CALL TRAIN_MESSAGE
		;装備時
		IF TEQUIP:13 == 1 && FLAG:7 == 2
			;初めて
			IF CFLAG:326 == 0
				;処女
				IF TALENT:0
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						PRINTFORMW 「%CSTR:일인칭%의 처음…… 응, 괜찮기는 한디…」
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						PRINTFORML 「어, 그건 뭐여?」
						PRINTFORMW %CALLNAME:MASTER%은(는) 손에 든 도구의 용도를 설명했다
						PRINTFORMW 「헤~ 보지는 자지를 넣는 곳인 줄 알았는디 딴 것도 들어가는구먼」
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						PRINTFORMW 「%CSTR:일인칭%의 처음…… 응, 부탁합니데이」
					;屈服していない
					ELSE
						IF RAND:2 == 0
							PRINTFORMW 「어, 그건 뭐여? …히, 시, 싫어! 싫엉! 넣지 마! 싫어!」
						ELSE
							PRINTFORMW 「어, 그거 뭐야?」
							PRINTFORMW 「그런 걸 %CSTR:일인칭%한테… 시, 싫어! %CSTR:일인칭% 죽어버린당께!」
						ENDIF
					ENDIF
				;それ以外
				ELSE
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						PRINTFORMW 「그건 뭐여? …너, 넣는겨?」
						PRINTFORMW 「싫당께! 그만두시게, %CSTR:이인칭%!」
					;淫乱、娼婦、服従、隷属
					ELSEIF TALENT:음란 || TALENT:복종 || TALENT:창부 || TALENT:예속
						IF RAND:2 == 0
							PRINTFORMW 「토란대구먼」
							PRINTFORMW 「집 장롱 구석에 숨겨져 있었당께」
							PRINTFORMW 「그치만 그런 식으로 움직이거나 하진 않았었는디」
						ELSE
							PRINTFORML 「그게 뭐여?」
							PRINTFORMW %CALLNAME:MASTER%은(는) 손에 든 도구의 용도를 설명했다
							PRINTFORMW 「응, 좋아%ハート()%」
						ENDIF
					;屈服しとらん
					ELSE
						IF TEQUIP:PLAYER:13
							PRINTFORML 「저, %CSTR:일인칭%은 그거 필요 없당께」
							PRINTFORMW 「피, 필요 없다니께!」
						ELSE
							PRINTFORMW 「그건 뭐여? …너, 넣는겨? 싫당께! 안 들어간다고! 아, 아앙!」
						ENDIF
					ENDIF
				ENDIF
				CFLAG:326 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:326 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						PRINTFORM 「응, 아아, 하아…… 싫은, 건, 아니지만서도, 
						IF TALENT:170
							PRINTFORM %CSTR:일인칭%, 서방님의 임신 봉
						ELSE
							PRINTFORM %CSTR:이인칭%의 자지
						ENDIF
						PRINTFORMW 를 원한당께… 읏, 앙, 아앙!」
						PRINTFORMW 가랑이에서 음란한 소리를 울리며, %CALLNAME%은(는) 아쉬운 눈빛으로 %CALLNAME:MASTER%의 하반신을 계속 쳐다보았다.
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						IF RAND:2 == 0
							PRINTFORML 「앙! 하앙! 앗! 좋당께… 츱츱 소리 나며 기분 좋아아… 앗! 앗! 아하앙!%ハート()%」
							PRINTFORMW %CALLNAME%은(는) 넋이 빠져 바이브 추삽질을 반복하고 있다. 내버려 두면 언제까지고 계속할 것만 같다.
						ELSE
							PRINTFORML 「바이브는 정액이 안 나오지만서도, 내내 딱딱한 채라 좋당께」
							PRINTFORMW 「『일장일단』이라는 놈이로구먼%ハート()%」
						ENDIF
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						IF RAND:2 == 0
							PRINTFORMW 「%CSTR:이인칭%의 장난감 속에 자지 장난감이 들어가는 꼴, 똑똑히 지켜보시게」
							PRINTFORMW 「응, 아, 이 장난감 대단허다, %CSTR:일인칭% 속에서 팔팔하게 움직이고 있구먼」
						ELSE
							PRINTFORML 「또 가짜여…」
							PRINTFORMW 「진짜배기 자지는 보류인 게로구먼」
						ENDIF
					ENDIF
					CFLAG:326 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:326 < 3 || FLAG:7 == 2)
					PRINTFORMW 「아… 아아아, 응, 읏, …앗, 아앙… 앙」
					PRINTFORMW %CALLNAME%은(는) 저항도 없이 바이브에 의한 쾌락에 몸을 맡기며 헐떡이는 소리를 흘린다.
					CFLAG:326 = 3
				;それ以外
				ELSEIF CFLAG:326 < 2 || FLAG:7 == 2
					IF RAND:2 == 0
						PRINTFORMW 「싫어, 그거 싫단 말여··· 꽉 끼어서, 넣고 싶지 않당께···」
					ELSE
						PRINTFORMW 「싫어, 그거 싫단 말여··· 딱딱해서 아프니께 넣지 말어…」
					ENDIF
					CFLAG:326 = 2
				ENDIF
			ENDIF
		;脱着
		ELSE
			IF CFLAG:326 == 1 || FLAG:7 == 2
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:326 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						IF RAND:2 == 0
							PRINTFORMW 「기분 좋기는 했지만서도…… 다음엔 %CSTR:이인칭% 걸 넣어줘%ハート()%」
						ELSE
							PRINTFORML 「지금이라면 자지 넣기 쉽게 되어있당께, 자아%ハート()%」
							PRINTFORMW %CALLNAME%은(는) 바이브가 빠져나간 구멍을 드러내며 도발하고 있다
						ENDIF
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						IF RAND:2 == 0
							PRINTFORMW 「진짜배기 자지가 아니믄 성에 안 찬단 말이여」
						ELSE
							PRINTFORML 「다음엔 자지 넣을 차례제%ハート()%」
							PRINTFORMW %CALLNAME%은(는) 바이브가 빠져나간 구멍을 드러내며 도발하고 있다
						ENDIF
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						IF RAND:2 == 0
							PRINTFORMW 「너무하당께…」
							PRINTFORMW 「진짜배기 자지 주셔어」
						ELSE
							PRINTFORMW 「장난감도 좋지만서도, 다음엔 진짜를 주시게」
							PRINTFORMW %CALLNAME%은(는) 치켜뜬 눈으로 부탁하고 있다
						ENDIF
					ENDIF
					CFLAG:326 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:325 < 3 || FLAG:7 == 2)
					PRINTFORMW 「벌써 이상해져 버릴 것 같으니께…」
					CFLAG:326 = 3
				;それ以外
				ELSEIF CFLAG:325 < 2 || FLAG:7 == 2
					PRINTFORMW 「너무하당께…」
					CFLAG:326 = 2
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;45,애널바이브
;-------------------------------------------------
	CASE 45
		CALL TRAIN_MESSAGE
		;装備時
		IF TEQUIP:14 == 1
			;初めて
			IF CFLAG:327 == 0 && FLAG:7 == 2
				IF EXP:Ａ경험 < 30
					PRINTFORMW 「잠깐! 엉덩이에 그런 거 안 들어간당께! 싫어, 그만둬!」
				ELSE
					PRINTFORMW 「어, 그런 게 들어가는겨……? 아, 안 아픈겨?」
					PRINTFORMW 「흣… 윽, 으아아……」
					PRINTFORMW 「으으~… 엉덩이가 이상한 느낌이랑께, 어, 어, 얼른 빼줘…」
				ENDIF
				CFLAG:327 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:327 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						PRINTFORMW 「하, 으, 싫어, 엉덩이, 엉덩이에 자지 장난감이 들어가 있구먼…」
						IF TALENT:170
							PRINTFORMW 「바르르 떨리는 게 가까우니께 자궁도 큥큥 삶아져 버릴 것 같은디…… 읏, 으으응!」
						ELSE
							PRINTFORMW 「너, 너무 쳐다보지 말어…… 그렇게, 그렇게 쳐다보믄, 읏, 으으응!」
						ENDIF
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						IF RAND:2 == 0
							PRINTFORMW 「큭… 하아아%ハート()%」
							PRINTFORMW 「엉덩이, 엉덩이에 굵직한 게 들어왔당께%ハート()%」
						ELSE
							PRINTFORMW 「혹시 저번 것보다 더 큰겨?」
						ENDIF
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						PRINTFORMW 「%CSTR:이인칭%의 장난감 속에 자지 장난감이 들어가는 꼴, 똑똑히 지켜보시게」
						PRINTFORMW 「응, 아, 이 장난감 대단허다, %CSTR:일인칭% 속에서 팔팔하게 움직이고 있구먼」
					ENDIF
					CFLAG:327 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:327 < 3 || FLAG:7 == 2)
					IF CUP:쾌Ａ < 2000
						PRINTFORMW 「흐, 야, 꽈, 꽉, 꽉 낀단 말이여…」
					ELSE
						PRINTFORMW 「%CSTR:일인칭%, 이런 걸 엉덩이에 넣고 있는디도…」
						PRINTFORMW 「어째서, 하앙, 이, 이렇게나…」
					ENDIF
					CFLAG:327 = 3
				;それ以外
				ELSEIF CFLAG:327 < 2 || FLAG:7 == 2
					IF CUP:쾌Ａ < 2000
						PRINTFORMW 「또, 또 그런 걸… 안, 안 된다니께, 크윽!」
					ELSE
						PRINTFORMW 「싫… 어, 이, 이런 걸 넣어도…」
						PRINTFORMW 「읏! 하, 하아…… 으응, 야아앙……」
					ENDIF
					CFLAG:327 = 2
				ENDIF
			ENDIF
		;脱着
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:327 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「…증말이지~ 다음엔 이거 안 된당께!」
					PRINTFORMW 「……%CSTR:이인칭%의 자지라면 괜찮지만서도…%ハート()%」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「엉덩이 굉장했당께…」
					PRINTFORMW 「그치만 심술부리지 말고 진짜배기 자지가 갖고 싶구먼%ハート()%」
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「으~ 엉덩이 속에 무언가 안 들어가 있으믄 진정이 안 되네…」
				ENDIF
				CFLAG:327 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:327 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
