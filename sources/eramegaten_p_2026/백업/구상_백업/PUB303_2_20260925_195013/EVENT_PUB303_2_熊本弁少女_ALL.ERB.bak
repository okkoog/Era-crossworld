						ELSE
							PRINTFORMW 「우후후, %CSTR:이인칭%도 젖 먹고 싶어져버렸어?%ハート()%」
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORMW 「자아~, 찌찌 먹을 시간이랑께~%ハート()%」
						ELSE
							PRINTFORMW 「어른이 됐는데도 젖을 달라니, 아기 같구먼%ハート()%」
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「앙앗♪」
					ELSE
						PRINTFORMW 「그렇게 젖이 먹고 싶어?」
						IF HAVE_PENIS(MASTER)
							PRINTFORML 「%CSTR:일인칭%도 마찬가지여♪」
							PRINTFORMW %CALLNAME%은 %CALLNAME:MASTER%의 가랑이를 바라보고 있다
						ELSEIF HAVE_PENIS(ASSI)
							PRINTFORML 「%CSTR:일인칭%도 마찬가지여♪」
							PRINTFORMW %CALLNAME%은 %CALLNAME:ASSI%의 가랑이를 바라보고 있다
						ELSE
							PRINTFORML 「그럼 둘이서 우유 짜러 가지 않을래?」
							PRINTFORMW %CALLNAME%은 보이지 않는 막대를 쥐고 흔드는 시늉을 하고 있다
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					;で읏ぱい場合
					IF BUST() > 3
						PRINTFORMW 「이렇게 커다란 젖을 짜고 있으니까, 소 같지」
						SIF TALENT:모유체질 > 0
							PRINTFORMW 「젖도 나오고 말야♪」
					ELSEIF TALENT:모유체질 > 0
						PRINTFORMW 「가슴은 작지만, 젖은 나오고 있지♪」
					ELSE
						PRINTFORMW 「작아서 젖도 안 나와서 죄송해요」
						PRINTFORMW 「%CSTR:일인칭%을 가슴에서 젖 나오게 개조해도 좋으니까 말야」
					ENDIF
				ENDIF
				CFLAG:416 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:416 < 3 || FLAG:7 == 2)
				PRINTFORMW 
				CFLAG:416 = 3
			;それ以外
			ELSEIF CFLAG:416 < 2 || FLAG:7 == 2
				PRINTFORML 「그만해」
				IF TALENT:모유체질 > 0
					PRINTFORMW 「젖 짜지 마…」
				ELSE
					PRINTFORMW 「소도 아닌데 젖 같은 거 안 나온당께…」
				ENDIF
				CFLAG:416 = 2
			ENDIF
		ENDIF

