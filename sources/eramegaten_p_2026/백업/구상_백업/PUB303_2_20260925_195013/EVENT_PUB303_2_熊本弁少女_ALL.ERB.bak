		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:319 == 0 && FLAG:7 == 2
			PRINTFORMW 「노래? %CSTR:일인칭% 좋아한당께, 노래! 들어봐 들어봐!」
			CFLAG:319 = 1
		;二回目以降
		ELSEIF FLAG:7 == 2
			IF RAND:3 == 0
				PRINTFORMW 「~♪~~♪ %CSTR:일인칭% 노래 어땠는겨!? 더 듣고 싶은겨?」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「어뗘? 텔레비전에서 계~속 흘러나오길래 외워버렸당께♪」
			ELSE
				PRINTFORMW 「이 노래, 학교에서 배운 거여」
			ENDIF
			CFLAG:319 = 2
		ENDIF

;-------------------------------------------------
;28,매도
;-------------------------------------------------
	CASE 28
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:320 == 0 && FLAG:7 == 2
			;反発刻印持ち
			IF MARK:3 > 0 && (CFLAG:217 < 1 || FLAG:7 == 2)
				PRINTFORML 「시끄러, 시끄럽당께!」
				PRINTFORMW 거친 매도에 %CALLNAME%은(는) 눈물을 흘리며 고함으로 맞받아쳤다
			;恋慕、親愛
			ELSEIF TALENT:연모 || TALENT:친애
				PRINTFORML 「···어째서···」
				PRINTFORMW 거친 매도에 %CALLNAME%은(는) 눈물을 글썽이고 있다
			ELSE
				PRINTFORML 「!!」
				PRINTFORMW 거친 매도에 %CALLNAME%은(는) 아무런 말대꾸도 하지 못하는 모양이다
			ENDIF
			CFLAG:320 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:320 < 4 || FLAG:7 == 2)
				;コマンド実施が助手
				IF ASSI > 0 && ASSIPLAY
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						IF RAND:2 == 0
							PRINTFORMW 「그런 거 아니제, %CSTR:이인칭%?」
							PRINTFORML %CALLNAME:PLAYER%은(는) 씩 미소를 지었다
							IF RAND:2 == 0
								PRINTFORMW 「어, 어어?」
							ELSE
								PRINTFORMW 「거, 거짓말이제, %CSTR:이인칭%?」
							ENDIF
						ELSE
							PRINTFORML 「%CSTR:이인칭%~, %CALLNAME:ASSI%이(가) 저런 소릴 해싸~」
							PRINTFORMW 입술을 삐죽 내밀며 %CALLNAME%이(가) 도움을 청해 왔다
						ENDIF
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						PRINTFORMW 「빗치?」
						PRINTFORMW 「그렇기는 한디, 그치만 %CSTR:이인칭%이…」
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						PRINTFORMW 「으으…… %CALLNAME:ASSI% 말대로랑께…」
					ENDIF
				ELSE
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						IF RAND:2 == 0
							PRINTFORMW 「내를, 싫어하게 되믄 안 되는디…」
							PRINTFORMW 「뭐든지 다 할 텐게, 제발……」
						ELSE
							PRINTFORML 「거, 거짓말이제, %CSTR:이인칭%」
							PRINTFORMW 「%CSTR:일인칭%이랑 %CSTR:이인칭%은 러브러브제?」
						ENDIF
						;淫乱、娼婦
						ELSEIF TALENT:음란 || TALENT:창부
							PRINTFORMW 「빗치?」
							PRINTFORMW 「그렇기는 한디, 그치만…」
						;服従、隷属
						ELSEIF TALENT:복종 || TALENT:예속
							IF RAND:2 == 0
								PRINTFORMW 「%CSTR:이인칭% 말대로랑께… 미안혀…」
							ELSE
								PRINTFORMW 「그런 %CSTR:일인칭%한테 벌을 내려주시게···」
						ENDIF
					ENDIF
				ENDIF
				CFLAG:320 = 4
			;反発刻印Lv3
			ELSEIF MARK:3 == 3 && (CFLAG:217 < 1 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORML 「그런 거 아녀!」
					PRINTFORML 「그런 소릴 지껄이는 놈이 바보인 거여」
					PRINTFORMW 「얼~레, 얼~레, 바~보, 바~보」
				ELSE
					PRINTFORML 「%CSTR:일인칭%도 알고 있당께」
					PRINTFORML 「느그 엄마 참외배꼽이라는 거」
					PRINTFORMW 「얼~레, 느그 엄마 참외배꼽!」
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:320 < 3 || FLAG:7 == 2)
				PRINTFORML 「죄송해유……」
				PRINTFORMW %CALLNAME:MASTER%에게 있지도 않은 일로 힐난당하자, 중얼거리듯 %CALLNAME%은(는) 사과의 말을 꺼냈다
				CFLAG:320 = 3
			;それ以外
			ELSEIF CFLAG:320 < 2 || FLAG:7 == 2
				PRINTFORML 「으으으……」
				PRINTFORMW %CALLNAME%은(는) 눈에 눈물을 글썽이며 매도에 견디고 있다
				CFLAG:320 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;29,비디오감상　陥落済みのみ
;-------------------------------------------------
	CASE 29
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:321 == 0 && FLAG:7 == 2
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				PRINTFORMW 「우와~ 대단허다, %CSTR:일인칭%, 저래 야한 표정을 짓고 있구먼……」
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORML 「이게 『음란 비디오』라는 놈이로구먼%ハート()%」
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORMW 「%CSTR:일인칭%, 제대로 봉사하고 있으려나」
			ENDIF
			CFLAG:321 = 1
		;二回目以降
		ELSEIF CFLAG:321 < 2 || FLAG:7 == 2
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				IF TALENT:170
					PRINTFORMW 「……저기, %CSTR:이인칭%, 이때 %CSTR:일인칭% 억수로 행복했었당께…… 또, 해줄 텐가?」
				ELSE
					PRINTFORMW 「우와왓, 굉장하구먼, %CSTR:일인칭%이랑 %CSTR:이인칭%, 참말로 짐승 같당께……」
				ENDIF
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				IF RAND:3 == 0
					PRINTFORML 「저기저기, 이거 한 번 더 하자구%ハート()%」
				ELSEIF RAND:2 == 0
					PRINTFORML 「우와~ %CSTR:이인칭%, 이건 너무 지나친 거 아녀?」
				ELSE
					PRINTFORML 「우와~ 대단허다%ハート()%」
					PRINTFORMW 「노모자이크라니 대단하구먼」
				ENDIF
				PRINTFORMW %CALLNAME%은(는) 화면에 비친 자신의 모습을 보고 흥분하고 있는 모양이다
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				IF RAND:2 == 0
					PRINTFORMW 「화면 속의 %CSTR:일인칭%, 억수로 행복해 보이는 얼굴을 하고 있구먼」
				ELSE
					PRINTFORML 「다행이다」
					PRINTFORMW 「%CSTR:이인칭%도 기분 좋아 보이는 얼굴을 하고 있네」
				ENDIF
			ENDIF
		CFLAG:321 = 2
		ENDIF

;-------------------------------------------------
;30,파후파후
;　CFLAGが判らないので初回判定なし
