	CASE 154
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:467 == 0
			;処女
			IF TALENT:0
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						PRINTFORMW 「괜찮당께… 와줘…」
						IF RAND:2 == 0
							PRINTFORMW 「…무섭지만서도, %CSTR:일인칭%, %CSTR:이인칭%과(와) 하나가 되고 싶당께…」
							PRINTFORMW 「%CSTR:일인칭%의 소중한 것을, %CSTR:이인칭%에게 주고 싶구마」
						ELSE
							PRINTFORMW 「%CSTR:이인칭%의 전부를, %CSTR:일인칭%에게 넣어도 괜찮당께…%ハート()%」
						ENDIF
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						PRINTFORML 「자지, 넣어주는겨?」
