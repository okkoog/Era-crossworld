						PRINTFORMW 「이런 자세, 앗%ハート()% %CSTR:이인칭%의 애완동물이 된 것 같아서 억수로 좋아%ハート()%」
						PRINTFORMW 「아앙%ハート()%…… 안쪽까지 닿아서, 기분, 억수로 좋네%ハート()% 앙%ハート()%」
					ELSE
						PRINTFORMW 「%CSTR:일인칭% 신경은 쓰지 말구 마음껏 움직이시게%ハート()%」
					ENDIF
				ENDIF
				CFLAG:333 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:333 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORML 「싫어어…… 앗, 아앗♪」
					PRINTFORML 「안 돼애… 안 돼애…… 으응!」
					PRINTFORMW 주어지는 쾌락을 머리로는 부정하려 하고 있지만, 몸은 이미 순종하고 있는 듯하다
				ELSE
					PRINTFORMW 「이런, 짐승 같은 모습이라니…… 앗, 아앗!」
					PRINTFORMW 「기, 기분 좋다니이, 아앙♪」
				ENDIF
				PRINTFORMW %CALLNAME%은(는) 희미한 이성에 매달리려 하면서도, 압도적인 쾌락에 곧바로 빠져들어 교성을 지르기 시작했다.
				CFLAG:333 = 3
			;それ以外
			ELSEIF CFLAG:333 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「시, 싫어, 어, 흣, 으으읏」
				ELSE
					PRINTFORMW 「이런 꼴로… 큭…」
				ENDIF
				CFLAG:333 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;62,정상위애널
;-------------------------------------------------
	CASE 62
		;初めて
		IF CFLAG:334 == 0
			CALL TRAIN_MESSAGE
			;Ａ系コマンドは経験済み
			IF (CFLAG:334 + CFLAG:335 + CFLAG:339 + CFLAG:342 + CFLAG:343 + CFLAG:421) > 0
				IF ABL:Ａ감각 > 2
					PRINTFORMW 「이번에는, 이렇게…?」
					IF CUP:쾌Ａ > 1000
						PRINTFORMW 「응, 크윽… 하아, 하, 으응아아앗!」
					ELSE
						PRINTFORMW 「시, 싫, 아, 아아, 드, 들어와… 으, 윽, 크윽…」
					ENDIF
				ELSE
					PRINTFORMW 「또, 또 엉덩이… 싫어엇」
					PRINTFORMW 「시, 싫, 아, 아아, 드, 들어와… 응, 후우, 아아아!?」
				ENDIF
			;Ａ系コマンド自体が初めて
			ELSE
				;服従、隷属
				IF TALENT:복종 || TALENT:예속
					PRINTFORMW 「거긴 다른 구멍인디」
					PRINTFORMW 「%CSTR:이인칭%이 쓰고 싶다믄 괜찮어…」
				ELSE
					PRINTFORMW 「저, 그, 그만두랑께…」
					PRINTFORMW 「엉덩이라니, 자지가 들어가는 곳 같은 게 아니랑께」
					PRINTFORMW 「응, 아, 아아, 드, 들어와… 으그으으응!?」
				ENDIF
			ENDIF
			CFLAG:334 = 1
		;二回目以降
		ELSE
			;前回コマンドが浣腸器＋プラグの場合、地の文の前にメ읏セ─ジが付く
			SIF PREVCOM == 146 && (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:334 < 4 || FLAG:7 == 2)
				CALL KOJO_ANAL_SENJYOUSUMI_2
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:334 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF TALENT:유아체형 || TALENT:소인체형
						PRINTFORMW %CALLNAME%의 조그만 어린아이 엉덩이에, 명백히 크기가 잘못된 어른 자지를 비틀어 넣었다.
					ELSEIF 体格差() > 1
						PRINTFORMW %CALLNAME%의 예쁜 엉덩이에, 명백히 크기가 잘못된 자지를 비틀어 넣었다.
					ENDIF
					IF RAND:2 == 0
						PRINTFORMW 「응, 하, 하아앗%ハート()%」
						PRINTFORMW 「%CSTR:이인칭%이랑 엉덩이로 이어지는 거, 좋아해애… 하아앗%ハート()%」
					ELSE
						PRINTFORMW 「엉덩이로도 사랑해주는구먼%ハート()%」
						PRINTFORML 
					ENDIF
					PRINTFORMW 「앗, 아앙, 히아아! 됴아! 됴아행 %CSTR:이인칭%! 아아아앗!」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「아… 아앗! 들어와아…%ハート()%」
						PRINTFORMW 「저기, 좀 더… 얼른 푹푹 찔러줘어%ハート()%」
						PRINTFORMW 일부러 시간을 들여 꿰뚫고 있자, 안달이 난 %CALLNAME%이(가) 허리를 흔들며 페니스를 삼켜왔다.
						PRINTFORMW 참을성 없는 %CALLNAME%의 허리를 움켜쥐고 허리를 내리치며, 원하는 대로 격렬하게 밀어 올려 주었다.
						PRINTFORMW 「아아! 아아아앗!! 엉덩잇 속이이, 쩌억쩌억 찢어질 거 같아아! 버, 범해, 범해지, 고오… 아아! 아아──앗!!」
					ELSE
						PRINTFORMW 「엉덩이%ハート()% 엉덩이이%ハート()%」
						PRINTFORMW 「엉덩이 보지, 기분 억수로 좋아아%ハート()%」
						PRINTFORMW 「더, 엉덩이 보지 푹푹 찔러줘어%ハート()%」
						PRINTFORMW 「앙! 히양! 흐아아앙! 배가 가득 찼엉! 기분 너무 조아아! 히아아! 아힉!」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭%의 애널, 마음껏 쓰시게%ハート()%」
						PRINTFORMW 「하아… 엉덩이가 잔뜩 벌어져서… 괴롭지만서도 기분 좋아…♪」
					ELSE
						PRINTFORML 「%CSTR:일인칭%의, 엉덩이, 기분, 좋, 당, 께」
						PRINTFORML 감상을 말하지 않고 그저 허리를 흔드는 %CALLNAME:MASTER%.
						PRINTFORMW 그 움직임에는 %CALLNAME%을(를) 배려하는 기색 따위 티끌만큼도 없었다.
						PRINTFORMW 「대단해, %CSTR:이인칭%! 벌, 인디도, 기분 좋아!」
					ENDIF
				ENDIF
				CFLAG:334 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:334 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORMW 「아, 하아, 어, 엉덩이 안에서 자지가 들락날락거리고 있어어……」
					PRINTFORMW 「더, 더 움직여줘어…!」
				ELSE
					PRINTFORMW 「엉덩이로 섹스라니 이상하당께에」
					PRINTFORML 
					PRINTFORMW (하지만서도, 조금 좋을지도…)
				ENDIF
				CFLAG:334 = 3
			;それ以外
			ELSEIF CFLAG:334 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「아, 하아, 어, 엉덩이 안에서 자지가 들락날락거리고 있당께……」
				ELSE
					PRINTFORML 「엉덩이, 싫어어…」
					PRINTFORMW 「이제 그만해……」
				ENDIF
				CFLAG:334 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;63,후배위애널
;-------------------------------------------------
	CASE 63
		;初めて
		IF CFLAG:335 == 0
			IF 연모() || 친애()
				PRINTFORMW 「무, 뭐하는겨…」
				PRINTFORMW 「저, 저기, 왠지 엉덩이에 자지가 닿아있는 것 같은디…」
				PRINTFORMW 「응, 아, 아아, 드, 들어와… 으그으으응!?」
				CALL TRAIN_MESSAGE
			ELSEIF 음란() || 창부()
				PRINTFORMW 「우후후……」
				PRINTFORML 엎드린 %CALLNAME%이(가), 이쪽으로 향한 엉덩이를 살랑살랑 흔들며 유혹하고 있다
				PRINTFORMW 「넣고 싶어? 넣고 싶어? %CSTR:일인칭%의 엉덩이에, 자지 넣고 싶어?」
				PRINTFORMW 「%CSTR:일인칭%도오… 엉덩이 보지에, 자지 푹푹 찔러줬으면 좋겠당께%ハート()%」
				CALL TRAIN_MESSAGE
				PRINTFORMW 「꺄아앙%ハート()% 엉덩이, 자지로, 자지로 가득 차서, 엉첨나앙%ハート()%」
			ELSEIF 복종() || 예속()
				PRINTFORMW 「저기, 봐봐…」
				PRINTFORML %CALLNAME%은(는) 엎드리더니, 국문이 잘 보이도록 엉덩이를 이쪽으로 내밀었다……
				PRINTFORML %CALLNAME%의 사랑스러운 애널은 아쉬운 듯 옴씬거리며 꿈틀대고 있다
				PRINTFORMW 「%CSTR:이인칭%한테 길들여져서, %CSTR:일인칭%의 엉덩이, 이렇게 녹아내려 버렸당께」
				PRINTFORMW 「엉덩이가 외롭고, 애달파서, 나쁜 아이인걸…… 그러니께, %CSTR:이인칭%의 자지로 벌 내려줘어%ハート()%」
				CALL TRAIN_MESSAGE
				PRINTFORMW 「응, 하앗, 엉덩이, 엉덩이 타버릴 것 같아아%ハート()%」
				PRINTFORMW 「나쁜 아이야, 애널도 %CSTR:일인칭%의 것인디, 애널 나쁜 아이인걸」
				PRINTFORMW 「그러니께, 더 괴롭혀줘어 좀 더 안쪽까지, 가득가득 괴롭혀줘어%ハート()%」
			;Ａ系コマンドは経験済み
			ELSEIF !(CFLAG:334 + CFLAG:335 + CFLAG:339 + CFLAG:342 + CFLAG:343)
				CALL TRAIN_MESSAGE
				IF ABL:Ａ감각 > 2
					PRINTFORMW 「%CSTR:일인칭%, 엉덩이는 그렇다 치고, 이런 강아지 같은 모습은…」
					IF CUP:쾌Ａ > 1000
						PRINTFORMW 「응, 크윽… 하아, 하, 으응아아앗!」
					ELSE
						PRINTFORMW 「시, 싫, 아, 아아, 드, 들어와… 으, 윽, 크윽…」
					ENDIF
				ELSE
					PRINTFORMW 「이, 이번엔 뭐야…」
					PRINTFORMW 「!? 시, 싫어어, 이런 자세로, 엉덩이라니이!」
					PRINTFORMW 「시, 싫, 아, 아아, 드, 들어와… 응, 후우, 아아아!?」
				ENDIF
			ELSE
				CALL TRAIN_MESSAGE
				PRINTFORMW 「무, 뭐하는겨…」
				PRINTFORMW 「저, 저기, 왠지 엉덩이에 자지가 닿아있는 것 같은디…」
				PRINTFORMW 「응, 아, 아아, 드, 들어와… 으그으으응!?」
			ENDIF
			CFLAG:335 = 1
		;二回目以降
		ELSE
			;前回コマンドが浣腸器＋プラグの場合、地の文の前にメ읏セ─ジが付く
			SIF PREVCOM == 146 && (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:335 < 4 || FLAG:7 == 2)
				CALL KOJO_ANAL_SENJYOUSUMI_2
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:335 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF TALENT:유아체형 || TALENT:소인체형
						PRINTFORMW %CALLNAME%의 조그만 어린아이 엉덩이에, 명백히 크기가 잘못된 어른 자지를 비틀어 넣었다.
					ELSEIF 体格差() > 1
						PRINTFORMW %CALLNAME%의 예쁜 엉덩이에, 명백히 크기가 잘못된 자지를 비틀어 넣었다.
					ENDIF
					PRINTFORMW 「응, 하, 하아앗%ハート()%」
					PRINTFORMW 「%CSTR:이인칭%이랑 엉덩이로 이어지는 거, 좋아해애… 하아앗%ハート()%」
					PRINTFORMW 「앗! 아앗! 안쪽까지 들어가 버렸어어!! 엉청나아! 히아아아아!!」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「얼른, 얼른! 와서, 찔러줘… 엉덩이 쑤셔주시게에%ハート()%」
						PRINTFORMW 가볍게 애태우자, %CALLNAME%은(는) 허리를 흔들며 스스로 애널을 벌리고 졸라왔다.
						PRINTFORMW 강직을 천천히 %CALLNAME%의 엉덩이에 먹여 들어가자, 교성을 숨기려 하지도 않고 날카롭게 비명을 지르기 시작했다.
						PRINTFORMW 「앗! 아, 앙, 아! 아아───앗!!」
						PRINTFORMW 「더! 더엇! 엉덩이, 엉덩이이%ハート()% 조, 조앙! 앙! 아앙!!」
					ELSE
						PRINTFORMW 「엉덩이%ハート()% 엉덩이이%ハート()%」
						PRINTFORMW 「엉덩이 보지, 기분 억수로 좋아아%ハート()%」
						PRINTFORMW 「더, 엉덩이 보지 푹푹 찔러줘어%ハート()%」
						PRINTFORMW 「히양! 히양앗! 가득햇! 안쪽까지 가득찼엉!! 아히이! 히이이 조앙!!」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭%의 애널, 마음껏 쓰시게%ハート()%」
						PRINTFORMW 「아윽, 히아앗, 애널로부터 보지 깊숙한 곳이 쿵쿵 울리고 있어어%ハート()%」
					ELSE
						PRINTFORMW 「아으윽, 하아앙, 엉덩이, 기뻐해 버리고 있어어%ハート()%」
						PRINTFORMW 「강아지 같은 모습으로, 자지 삽입당하고 있는디, %CSTR:일인칭%의 엉덩이 보지가 기뻐해 버리고 있당께%ハート()%」
					ENDIF
				ENDIF
				CFLAG:335 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:335 < 3 || FLAG:7 == 2)
				IF RAND:3 == 0
