	CASE 85
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:349 == 0
			PRINTFORMW 「발로 하라고? 뭔 소리를 하는지 모르겠는디…」
			PRINTFORML ………
			PRINTFORML ……
			PRINTFORML …
