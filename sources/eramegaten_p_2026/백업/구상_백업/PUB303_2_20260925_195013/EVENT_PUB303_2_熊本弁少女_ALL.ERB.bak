;対応コマンドはキス(20)、素股、足扱き(85)、アナル強制奉仕、ダブル素股
;-------------------------------------------------
IF TFLAG:9 == 1
	CALL PALAM_MESSAGE_A
	IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:231 < 3 || FLAG:7 == 2)
		;あなたが恋慕相手の場合
		IF ASSIPLAY == 0 && (TALENT:연모 || TALENT:친애)
			 ;キスで射精した場合
			 IF SELECTCOM == 20
				;初手キスで射精した場合
				IF PREVCOM == -1
					PRINTFORML 「인사 키스만으로 정액을 내버리는 거네」
					PRINTFORMW 「그렇게 흥분해준 거야%ハート()%」
				;あなたの子供を妊娠している場合
				ELSEIF TALENT:임신 && CFLAG:102 == 1
					PRINTFORML 「키스만으로 가버리다니, 못 말리는 아빠네에♪」
					PRINTFORML 「여자아이라면 몰라도, 남자아이라면 아빠처럼 되면 안 된다아%ハート()%」
					PRINTFORMW %CALLNAME%은 정액이 묻은 배를 쓰다듬으며 뱃속의 아이에게 타이르고 있다
				ELSE
					PRINTFORML 「%CSTR:일인칭%과의 정열적인 키스로 사정해버리는 거네…♪」
					PRINTFORML 「그치만, 정액은 보지에 내주라」
					PRINTFORMW 「안 그러면, 화낼 거랑께%ハート()%」
				ENDIF
			;足扱きで射精した場合
			ELSEIF SELECTCOM == 85
				IF TALENT:임신 && CFLAG:102 == 1
					PRINTFORML 「발로 비벼진 것만으로 가버리다니, 못 말리는 아빠네에♪」
					PRINTFORMW 「태어날 애가 여자아이라면 같이 해줄 테니까 말야%ハート()%」
					PRINTFORMW 「남자아이라면? 부자 쌍으로 %CSTR:일인칭%이 발로 보내줄게에%ハート()%」
				ELSE
					PRINTFORML 「아-아, 발로 비벼진 것만으로 사정해버렸다」
					PRINTFORMW 「이런 변태 플레이로 가버리다니 %CSTR:이인칭% 어머니한테는 못 보여주겠네에♪」
				ENDIF
			ELSE
				PRINTFORML 「이런 걸로 정액 나와버리다니」
				PRINTFORMW 「그럼, 더 해줄게♪」
			ENDIF
		;淫乱、娼婦相手にキスで射精した場合
		ELSEIF (TALENT:음란 || TALENT:창부) && SELECTCOM == 20
			PRINTFORMW 「에~, 키스로 사정해버리는 거네에♪」
		ELSE
			PRINTFORMW 「아하%ハート()% 잔뜩 나왔다아…… 더 잔뜩 나오게 해줄게에♪」
		ENDIF
		CFLAG:231 = 3
	;屈服刻印Lv3
	ELSEIF MARK:2 == 3 && (CFLAG:231 < 2 || FLAG:7 == 2)
		PRINTFORMW 「히양! 하얀 거 잔뜩…… 대단한 냄새…」
		CFLAG:231 = 2
	;それ以外
	ELSEIF CFLAG:231 < 1 || FLAG:7 == 2
		PRINTFORMW 「꺄악!? 정말-, 낼 거면 낸다고 말하라구-!」
		CFLAG:231 = 1
	ENDIF
ENDIF

