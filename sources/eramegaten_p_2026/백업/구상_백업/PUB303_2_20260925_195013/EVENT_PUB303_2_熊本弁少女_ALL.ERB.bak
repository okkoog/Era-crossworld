;=================================================
;調教者に道具使用コマンド
;=================================================
;-------------------------------------------------
;50,클리캡쓴다
;CFLAGが判らないので初回判定なし。代わりに調教相手にクリキャ읏プ経験があるかを見る
;-------------------------------------------------
	CASE 50
		CALL TRAIN_MESSAGE
		;装着
		IF TEQUIP:PLAYER:11
			;ソレが何だか知읏ている
			IF (CFLAG:453 > 0 ||  CFLAG:324 > 0) && FLAG:7 == 2
				;調教相手も装備している
				IF TEQUIP:11
					IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
						;恋慕、親愛
						IF TALENT:연모 || TALENT:친애
PRINTFORMW 「이거, 커플룩이로구먼」
;外出中
IF CFLAG:396
PRINTFORMW 「모두한테 맞춰 입은 꼴을 보여주자구%ハート()%」
ELSE
IF RAND:2 == 0
PRINTFORMW 「이러고 밖으로 나가믄 다들 눈이 똥그래져서 쳐다보겠구먼」
ELSE
PRINTFORMW 「기념으로 이니셜 새겨버릴까나?」
ENDIF
ENDIF
ELSE
PRINTFORMW 「%CSTR:이인칭%도 차버리는겨?」
IF RAND:2 == 0
PRINTFORMW 「콩알이라면 %CSTR:일인칭%이 듬뿍 살살 다뤄줄 텐디」
ELSE
PRINTFORMW 「다음엔 둘이서 뭘 달아볼까나?」
ENDIF
ENDIF
ELSE
PRINTFORMW 「자기도 달다니…」
ENDIF
ELSE
IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && TEQUIP:11 && FLAG:7 == 2
PRINTFORMW 「스스로 차버리는겨?」
IF RAND:2 == 0
PRINTFORMW 「콩알이라면 %CSTR:일인칭%이 듬뿍 살살 다뤄줄 텐디」
ELSE
PRINTFORMW 「동시에 여러 군데로 가버리고 싶구먼%ハート()%」
ENDIF
ELSE
PRINTFORMW 「자기한테 달다니…」
ENDIF
ENDIF
;それナニ？
ELSE
IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
;恋慕、親愛
IF TALENT:연모 || TALENT:친애
PRINTFORMW 「그거 차믄 기분 좋아진단 말이여…」
IF RAND:2 == 0
PRINTFORMW 「%CSTR:일인칭%이라면 더 기분 좋게 해줄 텐디」
ELSE
PRINTFORML 「%CSTR:일인칭%으론 안 되는겨?」
PRINTFORMW %CALLNAME%은(는) 울 것 같은 표정으로 이쪽을 바라보고 있다…
ENDIF
ELSE
PRINTFORMW 「그거 차믄 콩알이 기분 좋당께…」
IF RAND:2 == 0
PRINTFORMW 「그라믄 다음엔 %CSTR:일인칭%한테도 채워주시게」
ELSE
PRINTFORMW 「좋겠구먼~ %CSTR:일인칭%도 차고 싶네에~」
ENDIF
ENDIF
ELSE
IF RAND:2 == 0
PRINTFORMW 「세균 막는 캡인겨?」
ELSE
PRINTFORMW 「무슨 부적인겨?」
ENDIF
ENDIF
ENDIF
CFLAG:453 = 1
;脱着
ELSE
IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
;調教相手がまだ装備しとる
IF TEQUIP:11
PRINTFORMW 「%CSTR:일인칭% 것은 찬 채로 그대로구먼」
PRINTFORMW 「살짝 흥분돼 버릴지도」
ELSE
PRINTFORMW 「다음엔 기계 말고 %CSTR:일인칭%이 기분 좋게 해줄 텐게%ハート()%」
ENDIF
ELSE
;調教相手も装備しとる
IF TEQUIP:11
IF RAND:2 == 0
PRINTFORMW 「%CSTR:일인칭% 것도 빼줘…」
ELSE
PRINTFORMW 「%CSTR:일인칭% 것을 먼저 빼주시게…」
ENDIF
ELSE
					;結局何だか判らんずく
					IF CFLAG:324 > 0
						PRINTFORMW 「혼자 차고 있어서 기분 좋았던겨?」
						PRINTFORMW %CALLNAME:MASTER%은(는) 질문에 대해 『네가 찼을 때는 어땠는데?』라고 되물었다
						PRINTFORML 
						PRINTFORMW 「! %CSTR:일인칭%은…」
					ELSE
						PRINTFORMW (대체 뭐였을까나, 그거…)
					ENDIF
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;51,오나홀쓴다
;CFLAGが判らないので初回判定なし。代わりに調教相手にオナホ─ル経験があるかを見る
;-------------------------------------------------
	CASE 51
		CALL TRAIN_MESSAGE
		;装着
		IF TEQUIP:PLAYER:12
			;ソレが何だか知읏ている
			IF (CFLAG:454 > 0 || CFLAG:325 > 0) && FLAG:7 == 2
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						IF RAND:2 == 0 && TALENT:임신
							PRINTFORMW 「뱃속의 아기는 신경 안 써도 괜찮은디…」
							PRINTFORMW 「%CSTR:이인칭%은 참 상냥하구먼%ハート()%」
						ELSE
							PRINTFORML 「저기, %CSTR:일인칭%이 좋아하는 곳에 넣어도 된당께」
							PRINTFORMW 「그쪽이 %CSTR:이인칭%도 기분 좋겠제%ハート()%」
						ENDIF
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						IF RAND:3 == 0 && HAVE_PENIS() && TEQUIP:12 == 0
							PRINTFORMW 「%CSTR:이인칭% 혼자 오나홀로 기분 좋아지려는 건 치사하지 않어?」
						ELSEIF RAND:2 == 0
							PRINTFORML 「저기, 그런 말랑말랑한 거 쓰지 말구서~」
							PRINTFORMW 「%CSTR:일인칭%이랑 하자구우~%ハート()%」
						ELSE
							PRINTFORMW 「혼자서 오나홀 하는겨?」
						ENDIF
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						PRINTFORMW 「%CSTR:이인칭%이 오나홀을 쓴다는 건」
						PRINTFORML 「%CSTR:일인칭%은 오나홀 이하인겨?」
						PRINTFORMW %CALLNAME%은(는) 자신이 쓰이지 못한 것에 풀이 죽은 모양이다
					ENDIF
				ELSE
					IF TEQUIP:12 == 0
						PRINTFORMW 「자기도 달다니…」
					ELSE
						PRINTFORMW 「%CSTR:일인칭%뿐만 아니라, 자기한테도 차다니…」
					ENDIF
				ENDIF
			;それナニ？
			ELSE
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
					IF HAVE_PENIS()
						PRINTFORMW 「그거 차믄 자지 기분 좋당께…」
						IF RAND:2 == 0
							PRINTFORMW 「그라믄 다음엔 %CSTR:일인칭%한테도 채워주시게」
						ELSE
							PRINTFORMW 「좋겠구먼~ %CSTR:일인칭%도 차고 싶네에~」
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORMW 「%CSTR:일인칭%이라면 더 기분 좋게 해줄 텐디」
						ELSE
							PRINTFORMW 「그런 거 빼버리구 %CSTR:일인칭%이랑 하자구우~」
						ENDIF
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「세균 막는 캡인겨?」
					ELSE
						PRINTFORMW 「무슨 부적인겨?」
					ENDIF
				ENDIF
			ENDIF
			CFLAG:454 = 1
		;脱着
		ELSE
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				IF RAND:3 == 0
					PRINTFORMW 「다음은 %CSTR:일인칭% 차례제?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「기분 좋았어, %CSTR:이인칭%?」
				ELSE
					PRINTFORMW 「자아, 얼른 자지로 하자구%ハート()%」
				ENDIF
			ELSE
				;調教相手も装備しとる
				IF TEQUIP:11
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭% 것도 빼줘…」
					ELSE
						PRINTFORMW 「%CSTR:일인칭% 것을 먼저 빼주시게…」
					ENDIF
				ELSE
					;結局何だか判らんずく
					IF CFLAG:325 > 0
						PRINTFORMW 「혼자 차고 있어서 기분 좋았던겨?」
						PRINTFORMW %CALLNAME:MASTER%은(는) 질문에 대해 『너는 어땠는데?』라고 되물었다
						PRINTFORML 
						PRINTFORMW 「! %CSTR:일인칭%은…」
					ELSE
						PRINTFORMW (자지에 달고 있던 그거, 대체 뭐였으려나…)
					ENDIF
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;52,바이브쓴다
;-------------------------------------------------
	CASE 52
		CALL TRAIN_MESSAGE
		;装着
		IF TEQUIP:PLAYER:13
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF HAVE_PENIS()
						IF RAND:2 == 0
							IF CFLAG:455 == 1
								PRINTFORMW 「또 혼자서 바이브를 쓰구선……」
							ELSE
								PRINTFORMW 「%CSTR:이인칭%도 참, %CSTR:일인칭%이 자지 넣어줄 텐디…」
							ENDIF
							IF TEQUIP:PLAYER:14
								PRINTFORMW 「알았당께, 입에 물고 싶은 거지%ハート()%」
							ELSE
								PRINTFORMW 「알았당께, 엉덩이에 넣고 싶은 거로구먼%ハート()%」
							ENDIF
						ELSE
							IF CFLAG:455 == 1
								PRINTFORMW 「%CSTR:일인칭%의 자지는 쌩쌩하니께 언제든 오케이고」
							ELSE
								PRINTFORMW 「스스로 보지에 바이브를 넣다니… %CSTR:이인칭%, 외로운겨?」
							ENDIF
							PRINTFORMW 「무슨 일이 있어도 %CSTR:일인칭%이 곁에 있어 줄 텐게, 기운 내…」
							PRINTFORMW 「더 하자구%ハート()%」
						ENDIF
					ELSE
						IF RAND:2 == 0 && TEQUIP:13
							PRINTFORMW 「%CSTR:이인칭%도 보지에 바이브를 넣어버리는구먼」
						ELSE
							PRINTFORMW 「스스로 보지에 바이브를 넣어버리고는…」
							PRINTFORMW 「미안혀, %CSTR:일인칭%한테 자지가 없어갖고」
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF HAVE_PENIS()
						IF RAND:3 == 0 && CFLAG:455 == 1
							PRINTFORMW 「그렇게 바이브가 좋은겨?」
							PRINTFORMW 「%CSTR:일인칭%한테도 자지가 있잖여」
						ELSEIF RAND:2 == 0
							PRINTFORMW 「바이브보다 %CSTR:일인칭% 자지를 쓰지 않으련?」
							PRINTFORMW 「제대로 정액도 나온당께%ハート()%」
						ELSE
							PRINTFORMW 「맛나게 바이브를 집어삼키고는…」
							PRINTFORMW 「나중에 %CSTR:일인칭% 자지도 맛보시게나%ハート()%」
						ENDIF
					ELSE
						IF TEQUIP:13
							IF RAND:2 == 0
								PRINTFORMW 「%CSTR:이인칭%도 못 참고 바이브를 넣어버린 거구먼%ハート()%」
							ELSE
								PRINTFORMW 「진짜배기는 아니지만서도, 바이브도 좋구먼%ハート()%」
							ENDIF
						ELSE
							IF RAND:2 == 0
								PRINTFORML 「%CSTR:이인칭% 혼자 바이브를 쓰다니 치사하구먼~」
								PRINTFORMW 「%CSTR:일인칭%한테도 주셔어~」
							ELSE
								PRINTFORMW 「바이브도 좋지만서도, 진짜배기 자지를 원한당께」
								PRINTFORMW 「나중에 밖에 자지 먹으러 가자구우~%ハート()%」
							ENDIF
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF HAVE_PENIS()
						IF RAND:2 == 0
							PRINTFORML 「%CSTR:일인칭% 자지는 기분 좋지 않은겨?」
							PRINTFORMW %CALLNAME%의 질문을 무시하고 %CALLNAME:MASTER%은(는) 스스로 바이브를 물어 삼켜갔다
						ELSE
							PRINTFORML 「%CSTR:일인칭%도 자지 넣고 싶당께」
							PRINTFORMW %CALLNAME%의 간청을 무시하고 %CALLNAME:MASTER%은(는) 보란 듯이 바이브를 삼켜갔다
						ENDIF
					ELSE
						IF TEQUIP:13
							IF RAND:2 == 0
								PRINTFORML 「%CSTR:이인칭%도 참을 수가 없었던 게로구먼」
								PRINTFORMW 「%CSTR:일인칭%한테도 주셔어~」
							ELSE
								PRINTFORML 「%CSTR:이인칭% 바이브가 %CSTR:일인칭% 것보다 더 크지 않어?」
								PRINTFORMW 「좋겠구먼~ 치사하구먼~」
							ENDIF
						ELSE
							IF RAND:2 == 0 && CFLAG:455 == 1
								PRINTFORMW 「또 혼자만 바이브 쓰구선」
								PRINTFORMW 「%CSTR:일인칭%도 바이브 갖고 싶은디……」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「%CSTR:일인칭%한테도 바이브 주셔어」
							ELSE
								PRINTFORMW 「혼자만 기분 좋아지구선」
								PRINTFORMW 「보류라니 치사하당께」
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ELSE
				IF TEQUIP:13 == 0
					PRINTFORMW 「%CSTR:일인칭%뿐만 아니라, 자기한테도 차다니…」
				ELSE
					IF RAND:2 == 0 && CFLAG:455 == 1
						PRINTFORMW 「또 자기한테 쓰고 있구먼……」
					ELSE
						PRINTFORMW 「스스로 넣다니…」
					ENDIF
				ENDIF
			ENDIF
			CFLAG:455 = 1
		;脱着
		ELSE
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				IF HAVE_PENIS()
					IF RAND:2 == 0
						PRINTFORMW 「자아, %CSTR:일인칭%의 자지는 준비 완료랑께%ハート()%」
					ELSE
						PRINTFORMW 「우와~ %CSTR:이인칭%의 보지 질퍽질퍽하구먼」
						PRINTFORMW 「다음은 자지를 넣을 차례로구먼%ハート()%」
					ENDIF
				ELSE
					IF RAND:3 == 0 && TEQUIP:13 == 0
						PRINTFORML 「저기, 다음은 %CSTR:일인칭% 차례제?」
						PRINTFORMW %CALLNAME%은(는) 방금 뽑아낸 바이브로 손을 뻗었다
					ELSEIF RAND:2 == 0
						PRINTFORMW 「기분 좋았어, %CSTR:이인칭%?」
					ELSE
						PRINTFORMW 「정말… 보여주기만 하다니 치사하당께」
					ENDIF
				ENDIF
			ELSE
				;調教相手も装備しとる
				IF TEQUIP:13
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭% 것도 빼줘…」
					ELSE
						PRINTFORMW 「%CSTR:일인칭% 것을 먼저 빼주시게…」
					ENDIF
				ELSE
					PRINTFORMW 「혼자 차고 있어서 기분 좋았던겨?」
					PRINTFORMW %CALLNAME:MASTER%은(는) 질문에 대해 『너는 어땠는데?』라고 되물었다
					PRINTFORML 
					PRINTFORMW 「! %CSTR:일인칭%은…」
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;53,애널바이브쓴다
;CFLAG:456は文章が思いつかないからお預け
;-------------------------------------------------
	CASE 53
		CALL TRAIN_MESSAGE
		;装着
		IF TEQUIP:PLAYER:14
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF HAVE_PENIS()
						IF RAND:2 == 0
							IF CFLAG:456 == 1
								PRINTFORMW 「정말~ 또 엉덩이에 바이브를 넣구선」
							ELSE
								PRINTFORML 「정말이지~」
							ENDIF
							PRINTFORMW 「엉덩이가 허전하믄 %CSTR:일인칭%이 자지 넣어줄 텐디…」
						ELSE
							PRINTFORMW 「%CSTR:일인칭%도 %CSTR:이인칭% 엉덩이에 하고 싶구먼…」
						ENDIF
					ELSE
						IF RAND:2 == 0 && TEQUIP:14
							PRINTFORMW 「%CSTR:이인칭%도 엉덩이에 바이브를 넣어버리는구먼」
						ELSE
							PRINTFORMW 「엉덩이에 바이브를 넣었을 텐디 보지가 젖어오고 있구먼」
							PRINTFORMW 「%CSTR:일인칭%이 핥아줄까나%ハート()%」
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF HAVE_PENIS()
						IF RAND:3 == 0 && CFLAG:456 == 1
							PRINTFORMW 「그렇게 바이브가 좋은겨?」
							PRINTFORMW 「바이브도 좋지만서도, %CSTR:일인칭%한테도 자지가 있잖여」
						ELSEIF RAND:2 == 0
							PRINTFORMW 「바이브보다 %CSTR:일인칭% 자지를 쓰지 않으련?」
							PRINTFORMW 「제대로 정액도 나온당께%ハート()%」
						ELSE
							PRINTFORMW 「맛나게 바이브를 집어삼키고는…」
							PRINTFORMW 「나중에 %CSTR:일인칭% 자지도 맛보시게나%ハート()%」
						ENDIF
					ELSE
						IF TEQUIP:14
							IF RAND:2 == 0
								PRINTFORMW 「%CSTR:이인칭%도 못 참고 바이브를 넣어버린 거구먼%ハート()%」
							ELSE
								PRINTFORMW 「진짜배기는 아니지만서도, 바이브도 좋구먼%ハート()%」
							ENDIF
							SIF CFLAG:456 == 1
								PRINTFORMW 「살짝 버릇 들어버리제♪」
						ELSE
							IF RAND:2 == 0
								PRINTFORML 「%CSTR:이인칭% 혼자 바이브를 쓰다니 치사하구먼~」
								PRINTFORMW 「%CSTR:일인칭%한테도 주셔어~」
							ELSE
								PRINTFORMW 「바이브도 좋지만서도, 진짜배기 자지를 원한당께」
								PRINTFORMW 「나중에 밖에 자지 먹으러 가자구우~%ハート()%」
							ENDIF
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF HAVE_PENIS()
						IF RAND:2 == 0
							IF CFLAG:456 == 1
								PRINTFORML 「또 바이브를 쓰고 있는디, %CSTR:일인칭% 자지로는 안 되는겨?」
							ELSE
								PRINTFORML 「%CSTR:일인칭% 자지는 기분 좋지 않은겨?」
							ENDIF
							PRINTFORMW %CALLNAME%의 질문을 무시하고 %CALLNAME:MASTER%은(는) 스스로 바이브를 물어 삼켜갔다
						ELSE
							PRINTFORML 「%CSTR:일인칭%도 자지 넣고 싶당께」
							PRINTFORMW %CALLNAME%의 간청을 무시하고 %CALLNAME:MASTER%은(는) 보란 듯이 바이브를 삼켜갔다
						ENDIF
					ELSE
						IF TEQUIP:14
							IF RAND:2 == 0
								IF CFLAG:456 == 1
									PRINTFORML 「엉덩이에 바이브는 버릇 들어버리지만서도……」
								ELSE
									PRINTFORML 「%CSTR:이인칭%도 참을 수가 없었던 게로구먼」
								ENDIF
								PRINTFORMW 「%CSTR:일인칭%한테도 주셔어~」
							ELSE
								PRINTFORML 「%CSTR:이인칭% 바이브가 %CSTR:일인칭% 것보다 더 크지 않어?」
								PRINTFORML 「좋겠구먼~ 치사하구먼~」
							ENDIF
						ELSE
							IF RAND:3 == 0 && CFLAG:456 == 1 
								PRINTFORMW 「혼자서만 또 바이브 쓰다니 치사혀……」
							ELSEIF RAND:2 == 0
								PRINTFORMW 「%CSTR:일인칭%한테도 바이브 주셔어」
							ELSE
								PRINTFORMW 「혼자만 기분 좋아지구선」
								PRINTFORMW 「보류라니 치사하당께」
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ELSE
				IF TEQUIP:14 == 0
					PRINTFORMW 「자기도 엉덩이에 넣다니…」
				ELSE
					PRINTFORMW 「%CSTR:일인칭%뿐만 아니라, 스스로도 엉덩이에 넣어버리고 있구먼…」
				ENDIF
			ENDIF
			CFLAG:456 = 1
		;脱着
		ELSE
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				IF HAVE_PENIS()
					IF RAND:2 == 0
						PRINTFORML 「자아, %CSTR:일인칭%의 자지는 준비 완료랑께%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 크게 하늘을 찌르고 있는 페니스를 과시해 왔다
					ELSE
						PRINTFORMW 「우와~ %CSTR:이인칭% 엉덩이, 아직 벌어진 채로 있구먼」
						PRINTFORMW 「이러믄 %CSTR:일인칭% 팔뚝도 들어갈 것 같당께%ハート()%」
					ENDIF
				ELSE
					IF RAND:3 == 0 && TEQUIP:14 == 0
						PRINTFORML 「저기, 다음은 %CSTR:일인칭% 차례제?」
						PRINTFORMW %CALLNAME%은(는) 방금 뽑아낸 바이브로 손을 뻗었다
					ELSEIF RAND:2 == 0
						PRINTFORMW 「기분 좋았어, %CSTR:이인칭%?」
					ELSE
						PRINTFORMW 「정말… 보여주기만 하다니 치사하당께」
					ENDIF
				ENDIF
			ELSE
				;調教相手も装備しとる
				IF TEQUIP:14
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭% 것도 빼줘…」
					ELSE
						PRINTFORMW 「%CSTR:일인칭% 것을 먼저 빼주시게…」
					ENDIF
				ELSE
					PRINTFORMW 「스스로 넣어서 기분 좋았던겨?」
					PRINTFORMW %CALLNAME:MASTER%은(는) 질문에 대해 『너는 어땠는데?』라고 되물었다
					PRINTFORML 
					PRINTFORMW 「! %CSTR:일인칭%은……」
				ENDIF
			ENDIF
		ENDIF

