			PRINTFORMW %CALLNAME:TARGET%은(는) 목소리도 나오지 않는 비명을 지르고 있었다……
			CFLAG:381 = 1
		;二回目以降
		ELSEIF CFLAG:381 < 2 || FLAG:7 == 2
