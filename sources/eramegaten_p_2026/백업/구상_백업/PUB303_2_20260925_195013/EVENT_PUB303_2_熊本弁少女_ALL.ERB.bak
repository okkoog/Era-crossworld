;-------------------------------------------------
;170,촉수삽입시킨다
;-------------------------------------------------
	CASE 170
		CALL TRAIN_MESSAGE
		;装着時
		IF TEQUIP:PLAYER:바이브
			;初めて
			IF CFLAG:470 == 0
				PRINTFORML 「엣, 어째서 스스로 미끌미끌이를 넣게 만드는겨……?」
				PRINTFORMW %CALLNAME%은(는) 혼란스러워하고 있다
				CFLAG:470 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:470 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						IF HAVE_PENIS()
							PRINTFORML 「미끌미끌이 같은 거 말고」
							PRINTFORMW 「%CSTR:일인칭% 꼬추를 넣어주고 싶었는디」
						ELSEIF TALENT:처녀 && HAVE_PENIS(MASTER)
							PRINTFORML 「%CSTR:일인칭%의 첫 경험 때는」
							PRINTFORML 「미끌미끌이 말고, %CSTR:이인칭%이 해줘잉…%ハート()%」
						ELSE
							PRINTFORML 「%CSTR:일인칭%이 있는디도 욕구불만인겨?」
							PRINTFORMW %CALLNAME%은(는) 조금 풀이 죽어 있다…
						ENDIF
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						IF TEQUIP:바이브
							PRINTFORML 「세트네잉♪」
						ELSEIF TALENT:PLAYER:처녀
							PRINTFORML 「처녀 상실, %CSTR:일인칭%이 시켜주고 싶었는디이~」
						ELSE
							PRINTFORML 「혼자서만 즐기고, 치사혀-」
						ENDIF
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						IF TEQUIP:바이브
							PRINTFORML 「똑같구마잉」
						ELSE
							PRINTFORML 「%CSTR:이인칭%, %CSTR:일인칭%한테도 똑같은 짓, 해주시게」
						ENDIF
					ENDIF
					CFLAG:470 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:470 < 3 || FLAG:7 == 2)
					PRINTFORML 「굴복하지 않으믄, 똑같이 쑤셔박히는겨…?」
					CFLAG:470 = 3
				;それ以外
				ELSEIF CFLAG:470 < 2 || FLAG:7 == 2
					PRINTFORML 「믿기지가 않네. 또 스스로 넣고 자빠졌어…」
					CFLAG:470 = 2
				ENDIF
			ENDIF
		;解除時
		ELSE
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				IF HAVE_PENIS()
					PRINTFORML 「다음엔 %CSTR:일인칭% 걸 넣어줄팅께♪」
				ELSEIF RAND:2 == 0
					PRINTFORML 「욕구불만은 해소됐어?」
				ELSE
					PRINTFORML 「%CSTR:이인칭%이 만족한다믄 그걸로 됐지만서도…」
					PRINTFORMW %CALLNAME%은(는) 조금 불만스러운 듯하다
				ENDIF
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				IF RAND:2 == 0
					PRINTFORML 「미끌미끌이한테 보지 범해질 때의 %CSTR:이인칭% 얼굴」
					PRINTFORML 「억수로 야했당께♪」
				ELSE
					PRINTFORML 「다음엔 %CSTR:일인칭% 차례제?」
				ENDIF
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				IF HAVE_VAGINA()
					PRINTFORML 「%CSTR:이인칭%, 다음엔 %CSTR:일인칭%한테도 해주시게」
				ELSE
					PRINTFORML 「미끌미끌이한테 보지 범해질 때 얼굴」
					PRINTFORMW 「억수로 기분 좋아 보였으니께♪」
					PRINTFORML 「다음엔 %CSTR:일인칭%도 기분 좋게 해주시게」
					PRINTFORMW %CALLNAME%은(는) 아양을 떠는 표정을 짓고 있다
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3
					PRINTFORML 「굴복하지 않으믄, 똑같이 쑤셔박히는겨…?」
			;それ以外
			ELSE
				IF TALENT:처녀
					PRINTFORML 「싫어…」
					PRINTFORML 「다음은 %CSTR:일인칭% 차례라거나 그런 건, 아니제…」
				ELSE
					PRINTFORML 「싫어…」
					PRINTFORML 「방금 막 뽑아가 번들거리는 미끌미끌이 따윌 들이대지 마시게…」
				ENDIF
			ENDIF
		ENDIF

