					PRINTFORML 「이미 임신했응께」
					PRINTFORMW 「무책임하게 안에 맘껏 싸도 된당께%ハート()%」
				ELSEIF RAND:2 == 0
					PRINTFORML 「진한 게 잔뜩 나왔네♪」
					PRINTFORMW 「아직 진한 걸로 사정할 수 있지%ハート()%」
				ELSE
					PRINTFORML 「아, 하아…… %CSTR:이인칭% 정액 기분 좋아아…%ハート()%」
					PRINTFORMW %CALLNAME%의 질내는 탐욕스럽게 정액을 집어삼키고, 아직 부족하다는 듯 음탕하게 꿈틀거리며 육봉을 자극한다.
					PRINTFORMW 「더어… 더 정액 주라아… 더 범해줘어%ハート()%」
				ENDIF
			;服従、隷属
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「아, 하아…… %CSTR:일인칭% 보지로 기분 좋아져준 거구먼%ハート()%」
				ELSE
					PRINTFORML 「앗, 뜨거운 게……」
					PRINTFORMW 「기분 좋았어, %CSTR:이인칭%?」
				ENDIF
			ENDIF
			CFLAG:238 = 3
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3 && (CFLAG:238 < 2 || FLAG:7 == 2)
			PRINTFORMW 「아, 아앙! 잔뜩, 이라구! 꿀럭꿀럭 나오고 있어어!」
			PRINTFORMW %CALLNAME%은 몸을 떨면서 사정을 받아내고 있다. 그 얼굴은 발정기의 암컷과 다를 바가 없었다.
			CFLAG:238 = 2
		;それ以外
		ELSEIF CFLAG:238 < 1 || FLAG:7 == 2
			PRINTFORMW 「아! 아아! 뜨거운 거 오고 있어! 싫어어어!」
			IF TALENT:임신
				PRINTFORMW 「더 이상 임신하고 싶지 않다구우…」
			ELSE
				PRINTFORMW 「임신 같은 건 싫어어-」
			ENDIF
			CFLAG:238 = 1
		ENDIF
	ENDIF
ENDIF



;-------------------------------------------------
;@KOJO_ANAL_SENJYOUSUMI_2
;前回コマンドが浣腸＋プラグの口上
;-------------------------------------------------
@KOJO_ANAL_SENJYOUSUMI_2
IF RAND:4 == 0
	PRINTFORML 「자, 아까 일로 엉덩이 속은 깨끗해졌응께 괜찮당께♪」
ELSEIF RAND:3 == 0
	PRINTFORML 「자, 아까 일로 엉덩이 속은 깨끗해졌응께」
	PRINTFORML 「깊숙이 넣어도 괜찮당께♪」
ELSEIF RAND:2 == 0
	PRINTFORML 「기껏 깨끗하게 해놨는데, 질척질척해져버리잖아♪」
ELSE
	PRINTFORML 「엉덩이 속 깨끗하게 했응께 병에도 안 걸리겠네♪」
ENDIF
PRINTFORML 

;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_E（X1をキャラ番号に置換）
;触手の射精をトリガ─にした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_E_PUB303_2
;助手が調教した時に口上をスキ읏プする（好みに応じて使う、行頭の;を消すとスキ읏プするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボ─ルギャグ着用時には地の文を表示して口上をスキ읏プする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_E
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_E_PY1_PUB303_2
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_E_PY1_PUB303_2
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;触手の射精時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;촉수가사정
;-------------------------------------------------
IF TFLAG:15 >0
	CALL PALAM_MESSAGE_E
	;陥落済み
	IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:240 < 3 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:240 = 3
	;屈服刻印Lv3
	ELSEIF MARK:2 == 3 && (CFLAG:240 < 2 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:240 = 2
	;それ以外
	ELSEIF CFLAG:240 < 1 || FLAG:7 == 2
		PRINTFORMW 
		CFLAG:240 = 1
	ENDIF
ENDIF

;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_B関係（X1をキャラ番号に置換）
;奴隷の絶頂をトリガ─にした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_B_PUB303_2
;助手が調教した時に口上をスキ읏プする（好みに応じて使う、行頭の;を消すとスキ읏プするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボ─ルギャグ着用時には地の文を表示して口上をスキ읏プする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_B
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_B_PY1_PUB303_2
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_B_PY1_PUB303_2
;		RETURN 0
;	ENDIF
;ENDIF

;-------------------------------------------------
;奴隷の絶頂時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;初めてC絶頂
;-------------------------------------------------
IF NOWEX:0 > 0 && CFLAG:241 == 0
	PRINTFORMW 「히야! 아, 아아아! 뭐, 뭐야 이거어! 아아아아아!」
	PRINTFORMW %CALLNAME%은 처음 경험하는 감각에 당황해, %CALLNAME:MASTER%에게 꽉 매달리며 떨었다.
	CFLAG:241 = 1
ENDIF

;-------------------------------------------------
;初めてV絶頂
;-------------------------------------------------
IF NOWEX:1 > 0 && CFLAG:242 == 0
	;恋慕、親愛
	IF (TALENT:연모 || TALENT:친애) && (CFLAG:240 < 3 || FLAG:7 == 2)
		PRINTFORMW 「아아! 아아아아!」
PRINTFORML 「뭐야 이거, %CSTR:이인칭%, 뭔가 오고 있어」
PRINTFORML 「이거, 기분 좋아서 머리 이상해져버린다구우!」
PRINTFORML 「안 돼, 안 돼애~!!」
		PRINTFORMW %CALLNAME%은 처음 느끼는 여자로서의 절정에 머릿속이 새하얘지며 몸을 경련시키고 있다.
	;淫乱、娼婦、服従、隷属
	ELSEIF (TALENT:음란 || TALENT:복종 || TALENT:창부 || TALENT:예속) && (CFLAG:240 < 3 || FLAG:7 == 2)
		PRINTFORML 「아앙! 아아아아! 뭐야 이거, 보, 보지! 보지 망가져! 부서져버려어어!! 응아아아아!」
		PRINTFORMW %CALLNAME%은 처음 느끼는 여자로서의 절정에 머릿속이 새하얘지며 몸을 경련시켰다.
		PRINTFORMW %CALLNAME:MASTER%에게 매달려, 눈물을 흘리며 몸을 떨고 있다.
	ELSE
		PRINTFORML 「아앙! 아아아아!」
		PRINTFORML 「뭐야 이거… 뱃속에서…… 위험해애애!!」
		PRINTFORMW %CALLNAME%은 미지의 감각에 눈물을 흘리며 비명을 지르고 있다.
	ENDIF
	CFLAG:242 = 1
ENDIF

;-------------------------------------------------
;初めてA絶頂
;-------------------------------------------------
IF NOWEX:2 > 0 && CFLAG:243 == 0
	;陥落済み
	IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:240 < 3 || FLAG:7 == 2)
		PRINTFORML 「엉덩이, 엉덩이 속이, 쿵쾅쿵쾅거려엇!」
		PRINTFORML 「엉덩이, 엉덩이로 가버려, 아아아아!」
		PRINTFORMW 배설 기관으로의 절정이라는 지금까지 없었던 경험에 %CALLNAME%은 몸을 경련시키며 유열에 젖어든다.
	ELSE
		PRINTFORMW 「싫, 싫어! 엉덩이가! 엉덩이로 가버려! 아아아아아!」
		PRINTFORMW %CALLNAME%은 첫 애널 절정에, 수치로 얼굴을 붉히면서도 유열에 몸을 경련시키고 있다.
	ENDIF
	CFLAG:243 = 1
ENDIF

;-------------------------------------------------
;初めてB絶頂
;-------------------------------------------------
IF NOWEX:3 > 0 && CFLAG:244 == 0
	PRINTFORMW 「아! 아아! 가슴 기분 좋아! 안 돼, 안 된다구우우우!」
	PRINTFORMW %CALLNAME%은 첫 가슴 절정에 몸을 한계까지 뒤로 젖히며 떤다.
	CFLAG:244 = 1
ENDIF

;-------------------------------------------------
;절정
;-------------------------------------------------
IF TFLAG:29 > 0
	CALL PALAM_MESSAGE_B
	;四重絶頂の場合
	;霊夢口上を流用
	IF NOWEX:0 > 0 && NOWEX:1 > 0 && NOWEX:2 > 0 && NOWEX:3 > 0
		;全身触手責め。霊夢口上で作읏たものを流用
		IF TEQUIP:25 && TEQUIP:바이브 && TEQUIP:애널바이브 && TEQUIP:클리캡 && (TEQUIP:유두캡 || TEQUIP:착유기)
			PRINTFORML 「%CSTR:이인칭%！　%CSTR:이인칭%！」
			PRINTFORML 「가슴도 클리도 보지도 엉덩이도 전부 미끈미끈이가 만져줘서」
			PRINTFORML 「미끈미끈이가 온몸을 기분 좋게 해줘엇♪」
			PRINTFORML 「%CSTR:이인칭%, 이렇게 기분 좋게 해줘서 고마워%ハート()%」
			PRINTFORMW %CALLNAME%은 %CALLNAME:MASTER%에게 감사의 말을 전하더니 온몸으로 절정을 맞이했다…
		;윤간
		;ELSE SELECTCOM == 201
			PRINTFORML 「그만해, 구해줘!」
			PRINTFORMW 「이런 거 이상해져버린다구♪」
			PRINTFORML 
			;恋慕系
			IF TALENT:연모 || TALENT:친애
				PRINTFORML 「%CSTR:이인칭%…… %CSTR:일인칭%, 기분 좋은 거에 져버렸어……」
				PRINTFORMW %CALLNAME%은 훌쩍훌쩍 울기 시작했다……
			;その他陥落済み
			ELSEIF TALENT:음란 || TALENT:복종 ||TALENT:창부 || TALENT:예속
				PRINTFORML 「%CSTR:이인칭%…… 이거… 굉장했어……」
				PRINTFORMW %CALLNAME%은 황홀한 표정을 지으며 떠나가는 사내들을 배웅했다……
			ELSE
				PRINTFORML 「이런 장난감이 돼버렸지만서도……」
				PRINTFORMW %CALLNAME%은 멍하니 떠나가는 사내들을 배웅했다……
			ENDIF
		ELSE
			PRINTFORML 「안 돼엣%ハート()% 이런 야한 짓, 안 된다구우%ハート()%」
			PRINTFORML 「가슴도 엉덩이도 보지도 한꺼번에 기분 좋아져버린당께♪」
			PRINTFORMW 「동시에 가버리면, %CSTR:일인칭%, %CSTR:일인칭%……!!!」
			PRINTFORML 
			PRINTFORML 「왔다아♪ 온몸으로 가버려어%ハート()%」
			PRINTFORML 완전히 흰자위를 드러내고 입을 뻐끔거리는 %CALLNAME%은
			PRINTFORMW 눈물과 침, 애액, 소변, 장액까지 흘려가며 온몸으로 절정하더니, 그대로 쓰러져버렸다……
			PRINTFORML  
			;恋慕、親愛
			IF TALENT:3 || TALENT:6
				PRINTFORML 「후우……」
				PRINTFORMW 시간은 걸렸지만 %CALLNAME%은 %CALLNAME:MASTER%이 건넨 물을 마시자 진정된 모양이다.
				PRINTFORML 「정말…… %CSTR:이인칭%, 너무 격렬하당께-」
				;朝から四重絶頂とかヤりすぎ
				IF TIME == 0 && RAND:3 == 0
					PRINTFORMW 「아침부터 이렇게 해버리면, 오늘 일, 못 하게 돼버린당께」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「그치만, %CSTR:이인칭%이 하고 싶다면 %CSTR:일인칭%도…… 좋아%ハート()%」
				ELSE
					PRINTFORMW 「그치만, %CSTR:일인칭%을 그렇게 좋아하는 거구먼……%ハート()%」
				ENDIF
			;음란
			ELSEIF TALENT:4 || TALENT:7
				PRINTFORML 「저기…… 한 번 더… 해줘……%ハート()%」
				PRINTFORMW 말할 수 있을 때까지 회복하자, %CALLNAME%은 재전을 요구해왔다.
				PRINTFORML 「어린애 상대로 섹스하는 건 범죄인데도」
				PRINTFORML 「여기까지 당해버리는걸…」
				IF RAND:2 == 0
					PRINTFORMW 「신고당하기 싫으면, 얼른 하자아%ハート()%」
				ELSE
					PRINTFORMW 「이젠, 평범한 생활로 못 돌아가겠네%ハート()%」
				ENDIF
			;복종
			ELSEIF TALENT:5 || TALENT:8
				PRINTFORML 「이렇게 기분 좋은 짓 해줘서, 고마워」
				PRINTFORMW 「%CSTR:일인칭%, 앞으로도 힘낼 테니까 또 보답으로 해줘♪」
			;その他
			ELSE
				PRINTFORML 「으으으……」
				PRINTFORML 「이런 짓…」
				IF RAND:2 == 0
					PRINTFORML 「언젠가 경찰한테 잡혀갈 거랑께……」
					PRINTFORMW 아직 몸을 움직이지 못하는 %CALLNAME%은 센 척하는 말밖에 할 수 없었다…
				ELSE
					PRINTFORML 「이런 걸 알아버렸으니」
					PRINTFORMW 「이젠 평범한 생활로 못 돌아가게 돼버린다구우……」
				ENDIF
			ENDIF
		ENDIF
		CFLAG:245 = 3
	;陥落済み
	ELSEIF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:245 < 3 || FLAG:7 == 2)
		;主人公が相手をしている場合
		IF ASSIPLAY == 0 && RAND:5 == 0
			PRINTFORMW 「좋아앗%ハート()% 억수로 좋아, %CSTR:이인칭%%ハート()%」
		ELSEIF RAND:4 == 0
			PRINTFORMW 「앙! 앙! 가, 가버려엇! 아아아아아!!」
		ELSEIF RAND:3 == 1
			PRINTFORMW 「앗, 앗! 가버…! 흐아아! 아아아아아!!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「앙앗! 앙앗! 히아아앗!! 아아아아앗!! ……읏! ……으읏!!」
		ELSE
			PRINTFORMW 「대다내, %CSTR:이인칭%! 기분 좋아서 이상해져버려엇!」
		ENDIF
		;挿入されながら家事して絶頂
		IF (TEQUIP:Ｖ섹스 || TEQUIP:Ａ섹스) && SELECTCOM == 26
			PRINTFORMW 「먹어줘엇♪ %CSTR:이인칭%도, %CSTR:이인칭% 요리도옷%ハート()%」
		ENDIF
		CFLAG:245 = 3
	;屈服刻印Lv3
	ELSEIF MARK:2 == 3 && (CFLAG:245 < 2 || FLAG:7 == 2)
		;ビデオ撮影中
		IF TEQUIP:비디오카메라 == 1
			PRINTFORML 「안 돼」
			PRINTFORML 「조교로 가버리는 모습 같은 거 촬영당하면」
			PRINTFORMW 「거역하지 못하게 돼버릴 텐데… 가앗, 가버려엇 아♪」
		;主人公が相手をしている場合
		ELSEIF ASSIPLAY == 0 && RAND:4 == 0
			PRINTFORML 「안 돼」
			PRINTFORMW 「이러다간 %CSTR:이인칭%의 포로가 돼버려어♪」
		ELSEIF RAND:3 == 0
			PRINTFORML 「앗」
			PRINTFORMW 「가앗, 가버려엇!」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「싫, 아! 아앙! 아아아아아아아!!」
		ELSE
			PRINTFORML 「앗! 아앙!」
			PRINTFORMW 「기분 좋은 거에 져버린당께!」
		ENDIF
		CFLAG:245 = 2
	;それ以外
	ELSEIF CFLAG:245 < 1 || FLAG:7 == 2
		;羞恥プレイ中
		IF RAND:3 == 0 && TEQUIP:30
			PRINTFORML 「싫어! 싫어엇!」
			PRINTFORML 「%CSTR:일인칭% 부끄러운 곳, 보지 마」
			PRINTFORMW 「히, 아아아아!!」
		;ビデオ撮影中
		ELSEIF TEQUIP:비디오카메라 == 1
			PRINTFORML 「안 돼」
			PRINTFORML 「부끄럽게 가버리는 모습 같은 거 촬영하지 마앗」
			PRINTFORMW 「히, 아아아아!!」
		ELSEIF RAND:2 == 0
			PRINTFORML 「안 돼애, 가면 안 되는데!」
			PRINTFORMW 「싫어! 앗, 아앗%ハート()%」
		ELSE
			PRINTFORMW 「싫어! 싫어엇! 히, 아아아아!!」
		ENDIF
		CFLAG:245 = 1
	ENDIF
ENDIF


;-------------------------------------------------
;사정
;-------------------------------------------------
;射精している
;TCVAR:PLAYER:1 == 1 が膣内射精
;TCVAR:PLAYER:1 == 2 が尻穴射精

IF TFLAG:10 > 0

;	IF TCVAR:PLAYER:1 == 1 || 対象が父親
;		IF RAND:2 == 0 && TALENT:父親:임신 == 0
;			PRINTFORMW 「ふぅ♪」
;			PRINTFORML 「パパんメメジョにセ─エキたくさん出したけど」
;			PRINTFORM 「これでニンシンしたら、%CSTR:일인칭%が
;			IF TALENT:남자
;				PRINTFORM お兄ちゃん
;			ELSE
				;PRINTFORM お姉ちゃん
;			ENDIF
;			PRINTFORMW で、パパ읏てコト？」
;			PRINTFORMW 「なんかムツカシイね」
;		ELSE
;			PRINTFORMW 「見て見て♪　ちゃ～んとパパんごつシャセイしきるとやけん♪」
;		ENDIF
;	ELSEIF TCVAR:PLAYER:1 == 1 || 対象が母親
;		IF RAND:2 == 0 && TALENT:父親:임신 == 0
;			PRINTFORMW 「ふぅ♪」
