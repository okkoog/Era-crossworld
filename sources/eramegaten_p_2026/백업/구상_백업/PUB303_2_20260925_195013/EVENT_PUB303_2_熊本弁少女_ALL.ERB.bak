	;裸エプロンでＶ挿入継続しながら家事させて絶頂放尿
	ELSEIF TEQUIP:옷 == 0 && TEQUIP:하의 == 0 && TEQUIP:전신복 == 0 && TEQUIP:속옷（상） == 0 && TEQUIP:속옷（하） == 0 && TEQUIP:전신속옷 == 0 && TEQUIP:겉옷 == 0 && TEQUIP:에이프런 && TEQUIP:Ｖ섹스 && SELECTCOM == 26 && NOWEX:1 > 0
		;射精されていない場合。射精されている場合は射精側の口上でメ읏セ─ジ表示
