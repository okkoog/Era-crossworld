;-------------------------------------------------
;64,역강간
;-------------------------------------------------
	CASE 64
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:336 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				PRINTFORMW 「보지가 꽉 조여서 금방 가버릴 것 같아」
				PRINTFORMW 「억지로인디도 자지 기분 좋아지고 있어」
			ENDIF
			CFLAG:336 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;助手が逆レイプ中
					IF ASSI > 0 && ASSIPLAY
						PRINTFORMW 「%CSTR:이인칭%…」
						IF RAND:2 == 0
							PRINTFORMW 「미안혀, %CSTR:이인칭%」
							PRINTFORMW 「%CALLNAME:ASSI%의 보지, 기분 좋아서, 벌써……」
						ELSE
							PRINTFORML 「도와줘, %CSTR:이인칭%」
							PRINTFORMW 「%CSTR:일인칭%의 정액, 다 빨려나가 버린당께」
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORMW 「그렇게 격렬하게 당해버리믄, %CSTR:일인칭%……」
						ELSE
							PRINTFORMW 「그렇게 %CSTR:일인칭%의 정액을 갖고 싶은겨?」
							PRINTFORMW 「기다려줘, 조금만 있으면…」
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORML 「숨소리가 거칠당께」
						PRINTFORMW 「이런 거라면 %CSTR:일인칭%, 금방 가버린다구♪」
					ELSE
						PRINTFORML 「그렇게 보지 조이고 허리 흔들며 필사적이구먼」
						PRINTFORMW 「그렇게 정액이 갖고 싶은겨?」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORML 「그렇게 격렬하게 당하믄, 금방 가버리는디」
						PRINTFORMW 「가버리믄 안 되는겨…… 참을 수가 없구먼」
					ELSE
						PRINTFORML 「나와버려, 정액 나와버려」
					ENDIF
					PRINTFORMW 「%CSTR:이인칭%, 가버리믄 안 돼? 안 되는겨?」
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「자지가 기분 좋아서 녹아버릴 것 같아♪」
				ELSE
					PRINTFORMW 「보지 움직임이 격렬해서 %CSTR:일인칭%, 녹아버릴 것 같아……」
				ENDIF
			;それ以外
			ELSEIF FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「싫어, 놔줘」
					PRINTFORMW 「%CSTR:일인칭%의 자지, 괴롭히지 말아줘」
				ELSE
					PRINTFORML 「기분 좋지 않아, 기분 좋지 않아……」
					PRINTFORML 「괴로울 뿐이야, 무거울 뿐이야……」
					PRINTFORMW %CALLNAME%은(는) 고개를 돌리며 쾌락에 굴복하지 않으려 애쓰고 있다
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;65,젖성교
;-------------------------------------------------
	CASE 65
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:337 == 0
			PRINTFORMW 「가슴으로 섹스하는겨?」
			PRINTFORMW 「이상해」
			CFLAG:337 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:337 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「또 가슴인겨」
					IF RAND:3 == 0 && TALENT:임신
						PRINTFORMW 「이러다 가슴으로도 임신해버리겠구먼%ハート()%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「이러다 가슴으로 임신해버릴지도 모르겠네%ハート()%」
					ELSE
						PRINTFORMW 「그렇게 %CSTR:일인칭%의 가슴이 기분 좋은겨?」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 「하아아… %CSTR:이인칭%의 자지 뜨겁당께에…%ハート()%」
					IF RAND:2 == 0
						PRINTFORMW 「앙, 앙앗! 더 문질러줘어! 가슴 보지, 부서져도 괜찮응께! 앙! 마음껏 다뤄줘어! 아아!!」
					ELSE
						PRINTFORMW 「부탁이여!　
						;オトコかどうか？
						IF TALENT:남자 == 1 || TALENT:오토코노코 == 1
							IF TEQUIP:13 == 1
								PRINTFORMW 가슴 말고, 엉덩이 보지에 넣어줘어%ハート()%」
							ELSE
								PRINTFORML 더 격렬하게!」
								PRINTFORMW 「가슴 보지랑, 엉덩이 보지로 가게 해줘어!!」
							ENDIF
						ELSE
							IF TEQUIP:13 == 1 && TEQUIP:14 == 1
								PRINTFORML 더 격렬하게!」
								PRINTFORMW 「모든 보지로, 가게 해줘어!!」
							ELSEIF TEQUIP:13 == 1 && TEQUIP:14 == 1
								PRINTFORML 가슴도 좋지만서도!」
								PRINTFORMW 「비어있는 쪽 구멍에, 자지 넣어줘어%ハート()%」
							ELSE
								PRINTFORMW 가슴 보지도 좋지만서도 진짜 보지에도오%ハート()%」
							ENDIF
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종
					IF RAND:2 == 0 && EXP:2 >= 5
						PRINTFORML 「대단해, %CSTR:일인칭%!」
						PRINTFORMW 「가슴으로 하는 섹스, 억수로 기분 좋당께!」
					ELSE
						PRINTFORMW 「%CSTR:일인칭%의 가슴 기분 좋은겨?」
						PRINTFORML 「%CSTR:일인칭%의 모든 건, %CSTR:이인칭%의 것이니께」
						PRINTFORMW 「입이나 엉덩이나 보지 써도 상관없당께」
					ENDIF
				ENDIF
				CFLAG:337 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:337 < 3 || FLAG:7 == 2)
				PRINTFORMW 「또 가슴으로 야한 짓 하는겨?」
				PRINTFORMW 「으, 응… 그걸로 괜찮다믄 좋겠지만서도…」
				CFLAG:337 = 3
			;それ以外
			ELSEIF CFLAG:337 < 2 || FLAG:7 == 2
				PRINTFORMW 「엣, 또 가슴으로!」
				IF TALENT:처녀
					PRINTFORMW (그치만 더 이상한 짓 당하면 싫고…)
				ELSE
					PRINTFORMW (틀림없이, 머리가 이상해진 거제, %CSTR:일인칭%)
				ENDIF
				CFLAG:337 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;66,기승위
;-------------------------------------------------
	CASE 66
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:338 == 0
			;処女
			IF TALENT:0 
				IF 연모() || 친애()
					IF TALENT:170 && 体格差() > 1
						PRINTFORMW %CALLNAME%이(가) %CALLNAME:MASTER%의 강직에 허리를 내리며, 조금씩 협소한 \@TALENT:유아체형 || TALENT:소인체형 ? 어린 질 # 비부\@로 강직을 삼켜나갔다. 이윽고 무언가 찢어지는 감촉이 들었다.
						PRINTFORMW 처녀막이라는 것은 알고 있었으나, 바짝 조여든다기보다는 한계까지 확장되고 있는 듯한 질 자체의 감촉이 불안을 자아내, 무심코 %CALLNAME%의 눈동자를 들여다보았다.
						PRINTFORMW 눈물에 젖은 눈동자는 숨길 수 없는 고통과, 참을 수 없는 기쁨으로 가득 차 있었다.
						PRINTFORMW 「에, 에, 에헤헤헷…… 드디어, 드디어어, 신부가…… 될 수 있었구먼……%ハート()%」
						PRINTFORMW 「……응, 괜찮어…… 처녀막이니께…… 아, 안 아프당께?%ハート()%」
						PRINTFORMW 「……괘, 괜찮…… 으니께…… 알았제? ……이대로…… 힘내서, 안쪽, 까지, 넣고, 움직일 테니께…… %CSTR:일인칭%으로, 잔뜩 기분 좋아져서%ハート()%…… 안쪽에, 내보내서, 제대로, %CSTR:일인칭%을, 아내로, 삼아주시게?%ハート()%」
					ELSE
						PRINTFORMW 「응…… %CSTR:일인칭%, %CSTR:일인칭%의 소중한 거, %CSTR:이인칭%한테 줄게」
						PRINTFORMW %CALLNAME%이(가) %CALLNAME:MASTER%의 일물에 허리를 내리자, 조금씩 남자를 모르는 은밀한 틈으로 삼켜져 갔다
						PRINTFORMW 「큭, 핫, 후, 으, 아, 후…… 드, 들어와 있어… %CSTR:이인칭%이, %CSTR:일인칭%의 안쪽에……」
						PRINTFORMW 「콰아앗…… 하, 안쪽, 봐봐…… 안쪽, 전부, 들어왔당께에…… %CSTR:일인칭%이랑 %CSTR:이인칭%, 이어져 있어…」
						PRINTFORMW 「아, 아프지만서도, 괜찮… 당께, %CSTR:이인칭%이, 이렇게 가까이, %CSTR:일인칭%의 안에 있어주는걸……」
						PRINTFORMW 「응, 움직일게…… %CSTR:일인칭%으로, 가득 기분 좋아져서…… %CSTR:이인칭%을 잔뜩 주시게?」
					ENDIF
				ELSEIF 음란() || 창부()
					IF RAND:2 == 0
						PRINTFORMW 「%CSTR:일인칭%, 진짜 여자가 되는 거구먼… 소중한 걸 %CSTR:이인칭%한테 주고, 자지로 여자가 되어버리는 거구먼……」
						PRINTFORMW 「에헤… 그러믄 똑똑히 지켜봐줘, %CSTR:일인칭%의 보지가, 첫 자지한테 처녀를 줘버리는 모습을♪」
					ELSE
						PRINTFORMW 「처음인디도 스스로 자지 위에 올라타 버리지만서도」
						PRINTFORMW 「음란한 몸이 되어버렸으니께 어쩔 수가 없구먼♪」
					ENDIF
				ELSEIF 복종() || 예속()
					PRINTFORMW 「%CSTR:이인칭%…」
					;助手とプレイ中
					IF ASSI > 0 && ASSIPLAY
						PRINTFORML 「%CSTR:일인칭%의 처녀 상실, 똑똑히 지켜봐줘…」
					ELSE
						PRINTFORML 「%CSTR:일인칭%의 처녀, 줄게…」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) %CALLNAME:PLAYER%에게 미소를 짓고는, 스스로 허리를 내렸다…
					PRINTFORML  
					PRINTFORMW 「어뗘, %CSTR:이인칭%?」
					PRINTFORMW 「이제 처녀 아니니께, 보지 무제한 사용이랑께♪」
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「이런 거 싫어! %CSTR:일인칭% 처음인디, 이런 건…」
						PRINTFORMW 몸을 비틀며 저항하는 %CALLNAME%의 허리를 붙잡고 억지로 주저앉혔다.
						PRINTFORMW 「으윽… 아… 너무하당께…… %CSTR:이인칭%…」
					ELSE
						PRINTFORMW 「싫당께! 이런 짓 하믄, 몸이 찢어져서 죽어버린다구…」
						PRINTFORML 언제까지고 허리를 내리려 하지 않는 %CALLNAME%에게 화가 난 %CALLNAME:MASTER%은(는)
						PRINTFORMW %CALLNAME%의 허리를 붙잡고 힘껏 끌어당겼다
						PRINTFORML 「싫어어어어어! 배가 찢어져서 죽어버린당께에!」
						PRINTFORMW 「엄마아, 구해줘 엄마아-!」
					ENDIF
				ENDIF
			;それ以外
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:338 < 4 || FLAG:7 == 2)
					PRINTFORMW 「에, %CSTR:일인칭%이 위가 되는겨? 으응, 조금 부끄럽구먼…」
					PRINTFORMW %CALLNAME%은(는) 약간 당황하면서도, 누워있는 %CALLNAME:MASTER%의 위에 올라탔다.
					IF CUP:쾌Ｖ > 1000
						PRINTFORMW 「응, 아, 앙! 이거 깊숙이 닿는다구우… 하아, 기분 좋아… 앙, 앙!」
						PRINTFORMW 음란한 물소리를 울리며, %CALLNAME%은(는) 정신없이 허리를 흔들기 시작했다.
					ELSE
						PRINTFORMW 「응, 크, 드, 들어갔당께……」
						PRINTFORMW 「응, 움직일게…… 하아… 읏」
					ENDIF
				ELSE
					PRINTFORML 「엣! 그런 자세로 섹스하는겨?」
					PRINTFORM 싫어하는 %CALLNAME%을(를) 설득해
					;助手とプレイ中
					IF ASSI > 0 && ASSIPLAY
						PRINTFORMW %CALLNAME:ASSI%에게 올라타게 했다.
					ELSE
						PRINTFORMW 허리 위에 올라타게 했다.
					ENDIF
					PRINTFORMW 「그… 그럼 움직일게… 으응」
				ENDIF
			ENDIF
			CFLAG:338 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:338 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF 体格差() > 1
						PRINTFORML %CALLNAME%에게 스스로 페니스를 물게 했으나, 크기와 쾌락 탓에 허리가 멈출 것 같아 엉덩이를 붙잡고 허리를 밀어 올려 비틀어 박아넣었다.
						PRINTFORMW 페니스는 뿌리까지 다 들어가지 않고 7할 정도밖에 들어가지 않았지만, 좁은 질이 강하게 조여와 체중을 실어도 안정되어 있다.
						PRINTFORMW 끝부분이 오돌토돌한 자궁경부에 닿아 기분이 좋다. %CALLNAME%은(는) 끊임없이 자궁구를 자극받아, 쾌락과 고통이 뒤섞여 있다.
					ENDIF
					K:1 = RAND:3
					IF K:1 == 0
						PRINTFORML 「응, 츄, 아음… 응, 으응, 앗, 아앙… 쪼옥… 음, 으응…」
						PRINTFORMW %CALLNAME%은(는) 이어진 채로 %CALLNAME:MASTER%의 위에 엎드려, 정열적으로 혀를 얽어왔다.
						PRINTFORML 「으응… 푸하아… 좋아해, %CSTR:이인칭% 억수로 좋아해… 앗, 앙… 아아, 좋아아, 기분 좋아… 응, 아앙」
						PRINTFORMW 촉촉하게 젖은 눈동자를 %CALLNAME:MASTER%의 얼굴에서 떼지 않은 채, %CALLNAME%은(는) 천천히 허리를 비틀며 쾌락에 빠져들어 갔다……
					ELSEIF K:1 == 1
						PRINTFORML 「앗! 앙! 앙앗! 좋아, 좋아아, 기분 억수로 좋아아…! 앗! 아앗!」
						PRINTFORMW 쾌락의 파도를 이기지 못하게 된 %CALLNAME%은(는), 상반신을 힘없이 쓰러뜨려 %CALLNAME:MASTER%의 가슴 위에 몸을 맡겼다.
						PRINTFORMW 「으응, 흣, 앗! 아앙, 앙, 앙! 앗! 안 돼앳, 이젠 안 된단 말여어엇! 아앗, 아아아!」
						PRINTFORML %CALLNAME:MASTER%의 격렬한 쳐올리기에 나약하게 저항하면서도,
						PRINTFORMW 촉촉하게 젖은 눈동자를 %CALLNAME:MASTER%의 얼굴에서 떼지 않은 채, %CALLNAME%은(는) 천천히 허리를 비틀며 쾌락에 빠져들어 갔다……
					ELSEIF K:1 == 1
						PRINTFORMW 「이런 자세, %CSTR:이인칭%을 범하려 하는 것 같아서 흥분돼… 후후후%ハート()%」
						IF 体格差() > 1
							PRINTFORMW %CALLNAME%은(는) 즐거운 듯한 미소를 짓더니, 크게 허리를 위아래로 움직이기 시작했다.
							PRINTFORML %CALLNAME:MASTER%의 격렬한 쳐올리기에 나약하게 저항하면서도,
							PRINTFORMW 그런데도 %CALLNAME%의 \@体格差() > 1 ? 질은 계속 꿈틀거리고 # 허리는 제멋대로 격렬히 흔들리기\@ 시작해, 극상의 쾌락을 끌어내는 것을 멈추려 하지 않았다……
						ELSE
							PRINTFORMW %CALLNAME%은(는) 즐거운 듯한 미소를 짓더니, 격렬하게 허리를 흔들기 시작했다.
							PRINTFORMW 「앙! 앙! 앙! 어뗘 %CSTR:이인칭%, %CSTR:일인칭%한테 범해지는 기분은! 히양! 하앙!」
							PRINTFORMW 상황에 취해있는 %CALLNAME%은(는), 더욱 강하게 허리를 흔들고 있다.
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;相手が主導権を持읏ていて、前回コマンドも騎乗位の場合
					IF PREVCOM == 66 && TEQUIP:주도권 == 1
						PRINTFORML 「자아, 자아」
						PRINTFORMW 「정액을 콸콸 다 짜내버릴 테니께♪」
					ELSEIF RAND:4 == 0
						PRINTFORML 「이런 자지에 꼬치구이마냥 꿰뚫려 버리믄」
						PRINTFORML 「음란한 몸이 되어버리는 건 어쩔 수 없는 거제%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 질 내의 페니스를 만끽하듯 허리를 꿈틀거리더니, 서서히 허리를 흔들기 시작했다.
					ELSEIF RAND:3 == 0
						PRINTFORML 「그럼 %CSTR:일인칭%이 넣을게…… 아아아, 하아, 전부 들어가 버렸당께%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 질 내의 페니스를 만끽하듯 허리를 꿈틀거리더니, 서서히 허리를 흔들기 시작했다.
						PRINTFORMW 「좋아, 좋아아… 기분 좋아… 하아, 하앙, 하앙… 저기 %CSTR:이인칭%, 기분 좋은겨?」
						PRINTFORMW %CALLNAME:MASTER%은(는) 대답 대신 아래에서 강하게 허리를 쳐올렸다.
						PRINTFORMW 「히야앙! 기뻐! 더, 더어! 앙! 앙!」
					ELSEIF RAND:2 == 0
						PRINTFORML 「아앙, 앙, 앙, 핫, 아앗! 앙앗!」
						PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%의 가슴에 손을 짚고, 정신없이 허리를 흔들고 있다.
						PRINTFORML 「앗! 앗! 앗! 좋아아…! 보지 기분 억수로 좋아아! 더어! 더어어! 히아앙!!」
						PRINTFORMW 침을 흘리며 열에 들뜬 듯 눈동자를 풀면서, %CALLNAME%은(는) 한층 더 격렬하게 허리를 쳐올리기 시작했다……
					ELSE
						PRINTFORMW 「아하♪ %CALLNAME:MASTER%의 범해지는 얼굴, 억수로 귀여워…%ハート()%」
						PRINTFORMW 「아하앙! …%CSTR:이인칭%의 자지… 커져 있어… 범해져서 기쁜겨? ……에헤헤」
						PRINTFORML 「시간 들여서 듬뿍 해줄 테니께…%ハート()%」
						PRINTFORMW 「예뻐해 주고, 사랑해서, %CSTR:일인칭%의 것으로 만들어줄게… 꺄악! 앗, 앙! 하앙!!」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「응, 으앙, 아아, 기분 좋아%ハート()%」
					PRINTFORMW 「응흣, %CSTR:이인칭%은, 어뗘? 아, 앗, 기분, 좋아?」
				ENDIF
				CFLAG:338 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:338 < 3 || FLAG:7 == 2)
				PRINTFORMW 「응, 앙, 앙, 하앙… 왠지 %CSTR:일인칭%이… 아앙… %CSTR:이인칭%을 덮치고 있는 것 같아… 읏, 앗」
				PRINTFORMW %CALLNAME%은(는) 스스로 허리를 꿈틀거리며, 솔직하게 쾌락을 받아들이고 있다……
				CFLAG:338 = 3
			;それ以外
			ELSEIF CFLAG:338 < 2 || FLAG:7 == 2
				PRINTFORMW 「하아, 으응, 아, 여기 조금 기분 좋아…」
				PRINTFORMW %CALLNAME%은(는) 어색한 움직임으로 스스로 기분 좋은 부위를 찾고 있는 모양이다.
				CFLAG:338 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;67,기승위애널
;-------------------------------------------------
	CASE 67
		;初めて
		IF CFLAG:339 == 0
			CALL TRAIN_MESSAGE
			IF ABL:Ａ감각 >= 6
				PRINTFORMW 「%CSTR:일인칭%이 위가 돼서 엉덩이에 넣는겨?」
				PRINTFORML 「으~음」
				PRINTFORMW 「마음껏 움직이겠지만서도…」
				PRINTFORMW 「부러져버리믄 미안혀%ハート()%」
			ELSEIF ABL:Ａ감각 >= 3
				PRINTFORMW 「%CSTR:일인칭%이 위가 돼서 엉덩이에 넣는겨?」
				PRINTFORML 「그 말인즉슨…」
				PRINTFORMW 「마음껏 움직여도 된다는 거제%ハート()%」
			ELSE
				PRINTFORML 「엣! 그런 자세로 섹스하는겨?」
				PRINTFORM 싫어하는 %CALLNAME%을(를) 설득해
				;助手とプレイ中
				IF ASSI > 0 && ASSIPLAY
					PRINTFORMW %CALLNAME:ASSI%에게 올라타게 했다.
				ELSE
					PRINTFORMW 허리 위에 올라타게 했다.
				ENDIF
				PRINTFORMW 「응, 크, 드, 들어갔당께……」
				PRINTFORMW 「응, 움직일게…… 하아… 읏」
			ENDIF
			CFLAG:339 = 1
		;二回目以降
		ELSE
			;前回コマンドが浣腸器＋プラグの場合、地の文の前にメ읏セ─ジが付く
			SIF PREVCOM == 146 && (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:339 < 4 || FLAG:7 == 2)
				CALL KOJO_ANAL_SENJYOUSUMI_2
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:339 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF TALENT:유아체형 || TALENT:소인체형
						PRINTFORMW %CALLNAME%의 조그만 어린아이 엉덩이에, 명백히 크기가 잘못된 어른 자지를 비틀어 넣었다.
					ELSEIF 体格差() > 1
						PRINTFORMW %CALLNAME%의 예쁜 엉덩이에, 명백히 크기가 잘못된 자지를 비틀어 넣었다.
					ENDIF
					PRINTFORMW 「엉덩이 벌어지고 있어… 응, 아앗… 하아, 더 격렬하게?」
					PRINTFORMW 「아앙! 아, 앗! 굉장해! 엉덩이 녹아버려어%ハート()%」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORML 「그럼 %CSTR:이인칭%의 자지, %CSTR:일인칭%의 엉덩이로 먹어버릴 테니께%ハート()%」
					PRINTFORM 그렇게 말하며 %CALLNAME%은(는)
					IF TALENT:유아체형 || TALENT:소인체형
						PRINTFORM 작은 어린아이 엉덩이로,
					ENDIF
					IF 体格差() > 2
						PRINTFORMW 자신의 팔뚝보다도 굵은 자지를 애널 속으로 삼켜나갔다.
					ELSE
						PRINTFORMW 허리를 흔들며 애널로 자지를 삼켜나갔다.
					ENDIF
					IF RAND:3 == 0 && TALENT:처녀
						PRINTFORML 「처녀인디도 엉덩이 섹스를 너어무 좋아하게 되어버렸당께♪」
						PRINTFORMW 「책임지고, 제대로 가게 해주시게%ハート()%」
					ELSEIF RAND:2 == 0
						PRINTFORML 「『항문으로 장난치면 안 됩니다』라고 학교에서 그랬었는디」
						PRINTFORML 「그거 거짓말이었구먼」
						PRINTFORMW 「이렇게나 기분 좋은걸♪」
					ELSE
						PRINTFORML 「응, 아아, 아앙! 앗, 엉덩이 뻑뻑 쑤시는 거 엉청나아%ハート()%」
						PRINTFORMW 「%CSTR:일인칭%의 엉덩이에 정액 꿀꺽꿀꺽 먹여줘어%ハート()% 아힉! 아아아아아아아아!」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「어뗘, %CSTR:일인칭%의 엉덩이 보지」
						PRINTFORMW 「더 격렬하게 움직이는 게 좋은겨?」
					ELSE
						PRINTFORMW 「어린애 엉덩이 보지, 기분 좋은겨?」
						PRINTFORMW 「부족하믄, 더 움직일 테니께 말하시게♪」
					ENDIF
				ENDIF
				CFLAG:339 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:339 < 3 || FLAG:7 == 2)
				PRINTFORMW 「또, 또 하는겨어?」
				PRINTFORMW 「나중에 엉덩이 아파서 큰일난당께에-」
				CFLAG:339 = 3
			;それ以外
			ELSEIF CFLAG:339 < 2 || FLAG:7 == 2
				PRINTFORMW 「이, 이제 이 이상은 무리랑께-……」
				PRINTFORML %CALLNAME%은(는) 국문에 귀두가 들어간 것만으로 징징거리고 있다.
				CFLAG:339 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;68,대면좌위
;-------------------------------------------------
	CASE 68
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:340 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:340 < 4 || FLAG:7 == 2)
				;処女
				IF TALENT:0
					PRINTFORMW 「조금 무서우니께 꼬~옥 안아주고 있어줘」
				;それ以外
				ELSE
					PRINTFORMW 「와, 얼굴이 이렇게 가까이에 있어…」
					PRINTFORMW 「앙… 읏! …이래서는 금방 뽀뽀해 버릴 수 있잖여」
				ENDIF
			ELSE
				;処女
				IF TALENT:0
					PRINTFORMW 「싫어… 그렇게 가까이서 보지 말어……」
				;それ以外
				ELSE
					PRINTFORMW 「앙… 얼굴 들이대지 말어!」
				ENDIF
			ENDIF
			CFLAG:340 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:340 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF 体格差() > 1
						PRINTFORML %CALLNAME%을(를) 페니스 위에 앉히고, 허리를 짓누르며 가볍게 쳐올려 좁은 질에 비틀어 넣었다.
						PRINTFORMW 페니스의 뿌리까지는 다 들어가지 않았지만, 좁은 질의 조임과 끝이 자궁구에 닿아 있어 체중을 실어도 안정되어 있다.
						PRINTFORMW 끊임없이 자궁구를 자극받고 있어, %CALLNAME%은(는) 조금 괴로워 보인다.
					ENDIF
					K:1 = RAND:3
					IF K:1 == 0
						PRINTFORML 「츕… 낼름… 츄릅… 낼름낼름…」
						PRINTFORMW 허리를 부드럽게 움직이며, %CALLNAME%은(는) 눈앞에 있는 %CALLNAME:MASTER%의 젖꼭지를 핥고 빨고 있다.
						PRINTFORMW 「츄우우… 저기, 기분 좋아 %CSTR:이인칭%? 맨날 %CSTR:일인칭% 가슴 괴롭힘당했는걸. 복수당께♪」
						PRINTFORMW %CALLNAME%은(는) 더욱 %CALLNAME:MASTER%의 젖꼭지에 강하게 달라붙더니, 보란 듯이 젖꼭지를 혀로 희롱해 보였다.
					ELSEIF K:1 == 1
						PRINTFORMW 「하앙! 앙! 앙! 앙! 으아앙앗!」
						PRINTFORMW %CALLNAME%은(는) 엉덩이를 붙잡힌 채 격렬하게 허리를 내리찍히며, %CALLNAME:MASTER%에게 매달려 교성을 질렀다.
						PRINTFORMW 「격렬! 해애! 앙앗! 힝! 아앙! 안쪽까지… 흣 이상해져 버린다구우!!」
						PRINTFORMW %CALLNAME:MASTER%이(가) 시키는 대로 몸을 유린당하며, %CALLNAME%은(는) 눈물과 침을 줄줄 흘리며 환희의 소리를 계속 질렀다……
					ELSE
						PRINTFORMW 천천히 허리를 흔들며, %CALLNAME%은(는) %CALLNAME:MASTER%와 몇 번이고 혀를 얽어댔다.
						PRINTFORM 「이런 자세 좋아…
						IF 体格差() > 0
							PRINTFORM 허리 숙여주믄,
						ENDIF
						PRINTFORMW %CSTR:이인칭%의 얼굴이 이렇게나 가까이에 있는걸. 억수로 좋아…%ハート()%」
						PRINTFORMW 천천히 허리를 흔들며, %CALLNAME%은(는) %CALLNAME:MASTER%와 몇 번이고 혀를 얽어댔다.
						PRINTFORMW 「응, 으응, 으음… 아, 앙… 으음… 으읍, 으응, …응앗!」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					K:1 = RAND:3
					IF K:1 == 0
						PRINTFORML 「쪽, 쪽… 낼름낼름, 츄릅… 츄우우… 우후후」
						PRINTFORMW 「어뗘 %CSTR:이인칭%? 가슴 기분 좋아? 이번엔 젖꼭지로 가게 해줄게……%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 요염하게 미소 지으며, 더욱 강하게 %CALLNAME:MASTER%의 젖꼭지를 몰아세웠다.
						PRINTFORMW 천천히 추송을 반복하는 질내는 탐욕스럽게 꿈틀거렸고, %CALLNAME:MASTER%은(는) 급격히 덮쳐오는 사정감에 이를 악물었다.
					ELSEIF K:1 == 1
						PRINTFORML 「앗! 핫! 아앙! 좋아! 아앙앗!」
						PRINTFORMW %CALLNAME:MASTER%의 허리 움직임에 맞춰, %CALLNAME%은(는) 위아래로 격렬하게 허리를 마구 흔들었다.
						PRINTFORMW %CALLNAME:MASTER%이(가) 빈 손으로 클리토리스를 강하게 문지르자, %CALLNAME%은(는) 교성을 한층 더 크게 내질렀다.
						PRINTFORMW 「히익!! 히아아앗! 좋아아앗!! 콩알 더 세게 만져줘어어! 힝앗! 앙앗! 아아아아앗!!」
					ELSE
						PRINTFORML 「에헤헤, 야한 안기… %CSTR:일인칭% 억수로 좋아해애…%ハート()%」
						PRINTFORMW %CALLNAME%은(는) 페니스를 질내로 삼키며 %CALLNAME:MASTER%의 무릎 위에 앉아, 음란한 미소를 띄웠다.
						PRINTFORMW 「저기, 뽀뽀해줘… 잔뜩 뽀뽀하면서 %CSTR:일인칭%을 범해줘어… 으응, 으으음%ハート()%」
						PRINTFORML 격렬하게 입안을 탐하며, %CALLNAME%은(는) 격렬하게 허리를 흔들기 시작했다.
						PRINTFORMW 입이 막힌 채로도 %CALLNAME%은(는) 짓눌린 유열의 교성을 내지르며, 위아래 모두 대량의 침을 흘려댔다.
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「응, 츄, 낼름, 츕, %CSTR:이인칭%, 젖꼭지 기분 좋아?」
					PRINTFORMW 「%CSTR:일인칭%은, 비벼지는 젖꼭지도, 들락날락, 앙, 당하는 보지도, 둘 다 기분 억수로 좋아아」
				ENDIF
				CFLAG:340 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:340 < 3 || FLAG:7 == 2)
				PRINTFORMW 「이런 자세 부끄럽당께… 느끼는 얼굴 들켜버려… 읏, 앗, 아앙!」
				CFLAG:340 = 3
			;それ以外
			ELSEIF CFLAG:340 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「놓아줘… 보지 말어…」
				ELSE
					PRINTFORMW 「가슴 만지면서 쿵쿵 쑤시지 말어…」
				ENDIF
				CFLAG:340 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;69,배면좌위
;-------------------------------------------------
	CASE 69
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:341 == 0
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:341 < 4 || FLAG:7 == 2)
				;処女
				IF TALENT:0
					PRINTFORMW 
				;それ以外
				ELSE
					PRINTFORMW 「무릎에 안기면서? …이, 이렇게려나… 응아, 앙」
					PRINTFORML %CALLNAME%은(는) %CALLNAME:MASTER%에게 등을 돌리고, 무릎에 앉으며 페니스를 밀호로 이끌어 넣었다.
					PRINTFORMW 몸을 떨며, %CALLNAME%은(는) 체중을 %CALLNAME:MASTER%에게 맡겼다.
					IF 体格差() > 1
						PRINTFORMW 체중을 실어도, 젖은 좁은 질은 커다란 귀두에 걸린다.
						PRINTFORMW 참다못한 %CALLNAME:MASTER%은(는), %CALLNAME%의 허리를 붙잡고 강제로 비틀어 밀어 넣었다.
					ENDIF
					PRINTFORMW 「응… 왠지… 안심돼… 아, 앙!? 시, 싫어! 클리까지 만지지 말어!」
				ENDIF
			ELSE
			;処女
				IF TALENT:0
					PRINTFORMW 「거기 앉으라니……」
					PRINTFORML 「그치만, 거기 앉으믄 자지로 꼬치구이가 되어버린다구!」
					PRINTFORMW 「무리랑께, 죽어버린다구!!」
				;それ以外
				ELSE
					PRINTFORMW 「엣, 그런 안기 싫다구우」
				ENDIF
			ENDIF
			CFLAG:341 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:341 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF 体格差() > 1
						PRINTFORML %CALLNAME%의 몸을 들어 올려, 페니스를 강제로 좁은 질에 삽입하며 허리 부근에 앉혔다.
						PRINTFORMW 페니스의 뿌리까지는 다 들어가지 않았지만, 좁은 질의 조임과 끝이 자궁구에 닿아 있어 체중을 실어도 안정되어 있다.
						PRINTFORMW 끊임없이 자궁구를 자극받고 있어, %CALLNAME%은(는) 조금 괴로워 보인다.
					ENDIF
					K:1 = RAND:3
					IF K:1 == 0
						PRINTFORML %CALLNAME%의 몸을 들어 올려, 질내에 페니스를 삽입하며 허리 부근에 앉히자,
						PRINTFORMW %CALLNAME%은(는) 이쪽에 기대어 오며, 기대에 찬 미소를 지어 보였다.
						PRINTFORMW 「좋아해… 잔뜩… 사랑해줘… 아, 아앙, 히양! 앙, 앙, 앙, 앙!」
						PRINTFORMW 「좋아, 좋아아! 가슴도! 콩알도! 더, 더어어!」
					ELSEIF K:1 == 1
						PRINTFORMW 「안쪽까지 닿았어… 자궁이 범해지고 있어%ハート()%… 더어… 아! 히양! 앙!」
						PRINTFORMW 쾌락에 몸을 튀어 올리는 %CALLNAME%에게, %CALLNAME:MASTER%은(는) 더욱 가슴이나 클리토리스를 애무했다.
						PRINTFORMW 「히야아! 안 돼, 안 돼애! %CSTR:일인칭% 망가져 버려! 기분 너무 좋아아!」
						PRINTFORMW 「아, 하앙! 앙! 됴아! %CSTR:이인칭% 넘 됴아아! 싫, 히야아앙!」
					ELSE
						PRINTFORML 「응, 아, 앙… 하아, 기분 좋아… 응, 으응, 앙」
						PRINTFORMW 힘껏, 음미하듯 허리를 비틀어대는 %CALLNAME%. %CALLNAME:MASTER%이(가) 뒤에서 %CALLNAME%을(를) 끌어안자 얼굴을 활짝 폈다.
						PRINTFORMW 「아아… 따뜻해…… 따뜻하고 기분 좋아서… %CSTR:이인칭% 냄새가 가득 나서… 행복해애… 아, 앙」
						PRINTFORMW %CALLNAME%은(는) 가슴에 둘러진 %CALLNAME:MASTER%의 팔에, 새끼 고양이맹키로 뺨을 비벼댔다.
						PRINTFORMW 이윽고, 한 점 구름도 없는 환희에 찬 교성이 방 안에 울려 퍼지기 시작했다……
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					K:1 = RAND:3
					IF K:1 == 0
						PRINTFORML 「에헤헤, 음란한 %CALLNAME:MASTER% 의자, 너~무 좋아♪」
						PRINTFORMW %CALLNAME%은(는) 기뻐하며 페니스를 질내에 삽입한 채 앉더니, 기대에 찬 눈빛을 보내왔다.
						PRINTFORMW 「잔뜩, 잔뜩 범해줘어%ハート()% 가슴도 콩알도 보지도… 전부%ハート()%」
						PRINTFORMW 요구에 응해 격렬히 애무해 주자, 곧바로 환희에 젖은 교성이 울려 퍼졌다.
					ELSEIF K:1 == 1
						PRINTFORMW 「안쪽까지 닿았어… 자궁이 범해지고 있어%ハート()%… 더어… 아! 히양! 앙!」
						PRINTFORMW 쾌락에 몸을 튀어 올리는 %CALLNAME%에게, %CALLNAME:MASTER%은(는) 더욱 가슴이나 클리토리스를 애무했다.
						PRINTFORMW 「히야아! 좋아! 억수로 좋아아! 더! 더 전부 괴롭혀줘어어! 자궁 더 범해줘어어!!」
						PRINTFORMW 「아, 하앙! 앙! 아앙!! 너무 좋아아!! 히앗!! 아아앗!! 죽어버린다구우우!!%ハート()%」
					ELSE
						PRINTFORML 「응, 앙… 앙… 아하아, 좋아아…… 기분 좋아……」
						PRINTFORMW %CALLNAME%은(는) 천천히 허리를 비틀며, 과시하듯 음란하게 엉덩이를 흔들었다.
						PRINTFORMW 「저기, 더 기분 좋아지고 싶제? 정액을 잔뜩 콸콸 %CSTR:일인칭% 자궁에 쑤셔 박고 싶제?」
						PRINTFORMW 「잔뜩 기분 좋게 해주믄, 된당께♪ 가슴도 콩알도 보지도 전부… 범해주믄 좋당께%ハート()%」
						PRINTFORMW 「앗! 앙! 앙앗! 앙앗! 좋아아! 더 세게 만져줘어어! %CSTR:일인칭%을 엉망진창으로 부숴줘어어!!」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「무릎에 안겨서 꼬옥 쥐여지믄, 꼼짝달싹도 못하겠당께%ハート()%」
					PRINTFORMW 「히야앙! 푹푹 쑤셔지고 있어! 안겨서, 보지로 자지 훑어주는 야한 인형이 되어버렸당께%ハート()%」
				ENDIF
				CFLAG:341 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:341 < 3 || FLAG:7 == 2)
				PRINTFORMW 「앗, 앗, 앙, 앙… 기분 억수로 좋아아… 젖꼭지 좋아아…… 콩알도 가랑이도… 앙, 히양!」
				CFLAG:341 = 3
			;それ以外
				ELSEIF CFLAG:341 < 2 || FLAG:7 == 2
				PRINTFORMW 「응, 앗, 시, 싫어! 가슴 만지지 말어…… 히양!? 콩알도 안 된당께!」
				CFLAG:341 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;70,대면좌위애널
;-------------------------------------------------
	CASE 70
		;初めて
		IF CFLAG:342 == 0
			IF ABL:Ａ감각 >= 6
				CALL TRAIN_MESSAGE
				PRINTFORMW 「처음, 이지만서도, 이거, 대단하구먼%ハート(2)%」
				PRINTFORML 「가슴, 괴롭힘당하면서, 엉덩이, 푹푹, 쑤셔지는 거%ハート(2)%」
				PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%의 허리 움직임에 맞추면서 스스로도 허리를 흔들고 있다
			ELSEIF ABL:Ａ감각 >= 3
				PRINTFORMW 「마주 보면서 엉덩이로 섹스하는겨?」
				PRINTFORML 「…응, 이런 자세는 처음이니께 살살 해주시게」
				CALL TRAIN_MESSAGE
			ELSE
				CALL TRAIN_MESSAGE
				PRINTFORML 「엣! 그렇게 빤히 쳐다보지 마시게…」
				PRINTFORMW 처음 해보는 플레이와 익숙지 않은 애널 성교에 %CALLNAME%은(는) 거부 반응을 보이고 있다…
			ENDIF
			CFLAG:342 = 1
		;二回目以降
		ELSE
			;前回コマンドが浣腸器＋プラグの場合、地の文の前にメ읏セ─ジが付く
			SIF PREVCOM == 146 && (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:342 < 4 || FLAG:7 == 2)
				CALL KOJO_ANAL_SENJYOUSUMI_2
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:342 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「싫어엉, %CSTR:이인칭% 몸이 너무 커서, 꼬옥 안아주믄, 꼼짝달싹도 못하겠당께%ハート()%」
					PRINTFORMW 「히야앙! 푹푹 쑤셔지고 있어! 안겨서, 엉덩이로 자지 조여주는 야한 인형이 되어버렸당께%ハート()%」
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORML 「아후웅♪」
					PRINTFORML 「%CALLNAME:MASTER%와의 엉덩이 섹스, 억수로 좋아%ハート()%」
					PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%의 가슴에 팔을 두르더니, 스스로도 허리를 흔들기 시작했다
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「엉덩이랑, 가슴, 동시에 기분 좋게 해줘서」
						PRINTFORMW 「%CSTR:일인칭%은 행복한 노예랑께♪」
					ELSE
						PRINTFORMW 「엉덩이랑, 가슴, 억수로 기분 좋아!」
						PRINTFORMW 「더 기분 좋은 벌, %CSTR:일인칭%한테 주면 안 돼%ハート()%」
					ENDIF
				ENDIF
				CFLAG:342 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:342 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORMW 「가슴이랑 엉덩이, 동시에 야한 짓 당하믄」
					PRINTFORMW 「%CSTR:일인칭%, 이상해져 버린다구우」
				ELSE
					PRINTFORMW 「동시는 안 된당께」
					PRINTFORMW 「%CSTR:일인칭%, 어떻게 되어버릴 것 같당께」
				ENDIF
				CFLAG:342 = 3
			;それ以外
			ELSEIF CFLAG:342 < 2 || FLAG:7 == 2
				PRINTFORMW 「싫어어, 가슴이랑 엉덩이, 동시에 섹스하지 말어어」
				CFLAG:342 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;71,배면좌위애널
;-------------------------------------------------
	CASE 71
		;初めて
		IF CFLAG:343 == 0
			IF ABL:Ａ감각 >= 6
				CALL TRAIN_MESSAGE
				PRINTFORMW 「이러믄 기분 좋아도 안 쓰러져서 안심이구먼%ハート()%」
				PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%의 허리 움직임에 맞추면서 스스로도 허리를 흔들고 있다
			ELSEIF ABL:Ａ감각 >= 3
				PRINTFORMW 「안아주고 엉덩이로 섹스하는겨?」
				PRINTFORML 「…응, 이런 자세는 처음이니께 살살 해주시게」
				CALL TRAIN_MESSAGE
			ELSE
				PRINTFORMW 「%CALLNAME:MASTER% 무릎 위에 앉으믄 되는겨?」
				PRINTFORML 
				PRINTFORMW 「엣, 사타구니 사이?」
				PRINTFORMW 「거기라니…… 무리랑께-」
				PRINTFORM 애널 성교를 거절하려 하는
				CALL TRAIN_MESSAGE
			ENDIF
			CFLAG:343 = 1
		;二回目以降
		ELSE
			;前回コマンドが浣腸器＋プラグの場合、地の文の前にメ읏セ─ジが付く
			SIF PREVCOM == 146 && (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:343 < 4 || FLAG:7 == 2)
				CALL KOJO_ANAL_SENJYOUSUMI_2
			CALL TRAIN_MESSAGE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:343 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;助手とプレイ中
					IF ASSI > 0 && ASSIPLAY
						PRINTFORML 「이거, 다른 거니께」
						PRINTFORMW 「%CALLNAME:ASSI%와 엉덩이로 섹스해봤자 기분 좋지 않으니께」
						PRINTFORMW 「그러니께 보지 말어, %CSTR:일인칭%…」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「뒤에서 꼬~옥 안기면서 하는 엉덩이 섹스, 굉장하당께%ハート()%」
						PRINTFORMW 「더, 더!」
						PRINTFORMW 「더, 꼬~옥 안고서, 엉덩이로 섹스해줘%ハート()%」
					ELSE
						PRINTFORMW 「무릎에 안겨서 꼬옥 쥐여지믄, 꼼짝달싹도 못하겠당께%ハート()%」
						PRINTFORMW 「히야앙! 푹푹 쑤셔지고 있어! 쉬야하는 자세로, 엉덩이로 자지 조여주는 야한 인형이 되어버렸당께%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「더♪ 더 쿵쿵 움직여줘어♪」
						PRINTFORMW 「그러믄 %CSTR:일인칭%, 애널로 힘낼 테니께%ハート()%」
					ELSE
						PRINTFORMW 「앗하♪」
						PRINTFORML 「스스로 안 움직여도 되는디, 엉덩이가 기분 좋으니께」
						PRINTFORMW 「이런 자세, 너무 좋아%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「무릎에 안겨서 꼬옥 쥐여지믄, 꼼짝달싹도 못하겠당께%ハート()%」
						PRINTFORMW 「히야앙! 푹푹 쑤셔지고 있어! 안겨서, 엉덩이로 자지 조여주는 야한 인형이 되어버렸당께%ハート()%」
					ELSE
						PRINTFORML 「엉덩이 굉장하당께♪」
						PRINTFORMW 「더 움직여줘 %CSTR:일인칭%의 엉덩이♪ 조교해 주면 안 돼, %CSTR:이인칭%%ハート()%」
					ENDIF
				ENDIF
				CFLAG:343 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:343 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORMW 「또 이런 자세인겨?」
				ELSE
					PRINTFORML 「너무 세게 하지는 말어」
					PRINTFORMW 「엉덩이, 이상해져 버리니께」
				ENDIF
				CFLAG:343 = 3
			;それ以外
			ELSEIF CFLAG:343 < 2 || FLAG:7 == 2
				PRINTFORML 「%CSTR:일인칭%의 엉덩이, 쿵쿵 쑤시지 말어」
				IF RAND:2 == 0
					PRINTFORML 「애널, 부서져 버려!」
				ELSE
					PRINTFORML 「애널, 벌어진 채로 남아버린다구우!」
				ENDIF
				CFLAG:343 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;72,속옷비켜삽입
