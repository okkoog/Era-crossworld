					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:3 == 0 && HAVE_PENIS()
						PRINTFORMW 「다음엔 %CSTR:일인칭% 자지를 넣어보자잉♪」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「%CSTR:이인칭% 속이 파닥파닥 떨리고 있었당께♪」
					ELSE
						PRINTFORMW 「어뗘? 바이브보다 기분 좋제?」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 「응, 괴롭지만서도, %CSTR:이인칭%을(를) 위해 힘낼게잉」
					ELSE
						PRINTFORMW 「기분 좋아 보이는 %CSTR:이인칭%은 안 보이지만서도, %CSTR:일인칭%, 도움은 되고 있제?」
					ENDIF
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「%CSTR:일인칭%, 자위 도구 취급당하고 있구마……」
				ELSE
					PRINTFORM 「%CSTR:일인칭%, 사람이지만서도 장난감 취급당하고 있구마……」
				ENDIF
				;それ以外
			ELSEIF FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW 「이젠 괴로우니께 싫어……」
				ELSE
					PRINTFORMW 「있제, 평범한 바이브를 넣어주시게…」
				ENDIF
			ENDIF
		ENDIF

