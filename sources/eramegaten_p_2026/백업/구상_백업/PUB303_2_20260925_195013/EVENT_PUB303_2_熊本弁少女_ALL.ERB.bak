					ELSEIF RAND:2 == 0
						PRINTFORMW 「%CALLNAME:MASTER%의 냄새가 배어들어 버리겠구마」
					ELSE
						PRINTFORM 「
						;全身服なのか下着なのか
						IF CFLAG:전신속옷 > 0
							CALL CLOTHES_NAME,7,TARGET
						ELSE
							CALL CLOTHES_NAME,6,TARGET
						ENDIF
						PRINTFORMW 정액투성이가 되어도, %CSTR:이인칭% 거라면 좋아잉%ハート()%」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 「정말~, 나중에 정액 냄새 땜에 흥분해 버리믄 책임지시게♪」
					ELSE
						PRINTFORML 「자, 요렇게 요렇게」
						PRINTFORMW 「이 각도가 기분 좋은 거제♪」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORM  「%CSTR:일인칭%의 
						;全身服なのか下着なのか
						IF CFLAG:전신속옷 > 0
							CALL CLOTHES_NAME,7,TARGET
						ELSE
							CALL CLOTHES_NAME,6,TARGET
						ENDIF
						IF RAND:2 == 0
							PRINTFORML 로 %CSTR:이인칭%이 기분 좋아지는 거제%ハート()%」
						ELSE
							PRINTFORML 에, %CSTR:이인칭%의 냄새가 배어버려어%ハート()%」
						ENDIF
					ELSE
						PRINTFORML 「정액투성이가 되어도 나중에 씻으믄 되니께 괜찮아」
						PRINTFORMW 「에. 씻으믄 안 되는겨?」
					ENDIF
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && FLAG:7 == 2
				PRINTFORM 「
				;全身服なのか下着なのか
				IF CFLAG:전신속옷 > 0
					CALL CLOTHES_NAME,7,TARGET
				ELSE
					CALL CLOTHES_NAME,6,TARGET
				ENDIF
				PRINTFORMW 까지 정액투성이로 만들어져 버려…」
			;それ以外
			ELSEIF FLAG:7 == 2
				IF RAND:3 == 0
					PRINTFORM 「%CSTR:일인칭%의 
					;全身服なのか下着なのか
					IF CFLAG:전신속옷 > 0
						CALL CLOTHES_NAME,7,TARGET
					ELSE
						CALL CLOTHES_NAME,6,TARGET
					ENDIF
					PRINTFORMW 이(가)……」
				ELSEIF RAND:2 == 0
					PRINTFORML 「으~, 나중에 빨래해야 쓰겄네」
				ELSE
					PRINTFORML 「더럽히지 마시게, 마음에 드는 옷이란 말이여」
				ENDIF
			ENDIF
		ENDIF

