	CASE 186
		CALL TRAIN_MESSAGE
		IF TEQUIP:30
			;初めて
			IF CFLAG:398 == 0
				;淫乱、娼婦
				IF (TALENT:음란 || TALENT:창부) && (CFLAG:398 < 4 || FLAG:7 == 2)
PRINTFORMW 「이러믄 뭘 해도 %CSTR:일인칭%한테도 훤히 보이네잉%ハート()%」
;服従、隷属
ELSEIF TALENT:복종 || TALENT:예속 && (CFLAG:398 < 4 || FLAG:7 == 2)
PRINTFORMW 「거울로 %CSTR:일인칭%을(를) 비춰주는겨?」
PRINTFORMW 「응, 지금까정 한 짓, 전부 다 보여주시게」
ELSE
PRINTFORMW 「에에!? 이런 데서!? …싫어, 몽땅 다 보여버리잖여. 부끄러워…」
				ENDIF
				CFLAG:398 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:398 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
PRINTFORMW 「아앙… 보고 있어 %CSTR:이인칭%? 전부 %CSTR:이인칭% 거랑께… 아, 싫어엉%ハート()%」
PRINTFORMW 「부끄럽지만서도 왠지 기뻐… 젖어버렸당께… 에헤헤」
;淫乱、娼婦
ELSEIF TALENT:음란 || TALENT:창부
PRINTFORMW 「하아, 하앙, 더 봐줘, 봐달랑께. %CSTR:이인칭%의 부끄러운 곳 몽땅 다 봐줘어%ハート()%」
;服従、隷属
ELSEIF TALENT:복종 || TALENT:예속
PRINTFORMW 
ENDIF
CFLAG:398 = 4
;屈服刻印Lv3
ELSEIF MARK:2 == 3 && (CFLAG:398 < 3 || FLAG:7 == 2)
PRINTFORMW 「으응… 보여지고 있다 생각하믄, 깊숙한 곳이 욱신거려버려… 어쩐지 이상하당께-」
CFLAG:398 = 3
;それ以外
ELSEIF CFLAG:398 < 2 || FLAG:7 == 2
PRINTFORMW 「싫어, 보지 마아… 흐에엥, 너무 야하단 말여어」
CFLAG:398 = 2
ENDIF
ENDIF
ELSE
;陥落済み
IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:398 < 4 || FLAG:7 == 2)
IF RAND:2 == 0
PRINTFORMW 「평소보다 더 흥분해 버렸당께」
ELSE
PRINTFORMW 「평소보다 잔뜩 음란해져 버렸당께%ハート()%」
ENDIF
ELSE
IF RAND:2 == 0
PRINTFORMW 「이제 그만두시게, 이런 건…」
ELSE
PRINTFORMW 「부끄러운 거 보여주지 마시게…」
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;187,목욕탕플레이,
;-------------------------------------------------
	CASE 187
		CALL TRAIN_MESSAGE
		IF TEQUIP:31
			;初めて
			IF CFLAG:399 == 0
				PRINTFORMW 「목~욕탕, 목~욕탕♪ ……에에, 여기서 하는겨!?」
				CFLAG:399 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:399 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:연모 || TALENT:친애
						IF RAND:3 == 0 && ASSI > 0
							PRINTFORMW 「셋이서 목욕탕 들어가믄 더운물이 넘쳐서 없어지겠당께」
							PRINTFORMW 「그랑께 %CALLNAME:ASSI% 따윈 무시하고 둘이서만 들어가자잉%ハート()%」
						ELSEIF RAND:2 == 0
							PRINTFORMW 「기분 좋은 짓 하기 전에, %CSTR:이인칭% 등 밀어줄팅께♪」
							PRINTFORMW 「자아 자아, 사양 말고 요그 앉으시게~♪」
						ELSE
							PRINTFORMW 「둘이서 목욕탕 들어가믄 더운물 넘쳐버린당께」
						ENDIF
					;淫乱、娼婦
					ELSEIF TALENT:음란 || TALENT:창부
						PRINTFORMW 「기왕 목욕탕에서 하는 거니께, 서로 씻겨주자잉♪」
						PRINTFORMW 「\@ TALENT:남자 ? 꼬추 # 보지\@부터 엉덩이 구멍까지, 모~두 %CSTR:이인칭%의 손으로 씻어줬음 좋겠구마잉%ハート()%」
					;服従、隷属
					ELSEIF TALENT:복종 || TALENT:예속
						IF RAND:2 == 0
							PRINTFORMW 「%CSTR:이인칭%의 몸, %CSTR:일인칭%이 반짝반짝하게 닦아줄게잉%ハート()%」
						ELSE
							PRINTFORMW 「아, 맞다! 목욕탕에서 야한 짓 하는 일도 있다 카제?」
							PRINTFORMW 「기왕이니께 흉내 내보자잉♪ 봉사 잔뜩 해줄팅께%ハート()%」
						ENDIF
					ENDIF
					CFLAG:399 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:399 < 3 || FLAG:7 == 2)
					PRINTFORMW 「목욕탕이믄 더러워져도 금방 씻을 수 있으니께 좋지만서도…… 어쩐지 부끄럽구마」
					CFLAG:399 = 3
				;それ以外
				ELSEIF CFLAG:399 < 2 || FLAG:7 == 2
					IF RAND:2 == 0
						PRINTFORMW 「평범하게 목욕하고 싶구마……」
					ELSE
						PRINTFORMW 「어린애랑 같이 목욕하고 싶다니……」
						PRINTFORMW 「참말로 %CSTR:이인칭%은(는) 변태구마잉」
					ENDIF
					CFLAG:399 = 2
				ENDIF
			ENDIF
		;風呂から出た
		ELSE
			IF CFLAG:399 == 1 || FLAG:7 == 2
				CALL TRAIN_MESSAGE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:399 < 4 || FLAG:7 == 2)
					IF RAND:2 == 0
						PRINTFORML 「후우……」
						PRINTFORMW 「좋은 목욕이었구마」
					ELSEIF RAND:2 == 0
						PRINTFORML 「킁킁…」
						PRINTFORMW 「%CSTR:일인칭%, 목욕하기 전보다 더 비린내 나게 변하지 않았어?」
					ELSE
						PRINTFORMW 「조금 탕에 오래 있어 현기증이 난 걸까나?」
					ENDIF
				ELSE
					PRINTFORMW 「전혀 편하게 쉬질 못했당께」
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;188,샤워,
;-------------------------------------------------
	CASE 188
		;シャワ─ON
		IF TEQUIP:32
			;初めて
			IF CFLAG:400 == 0
				CALL TRAIN_MESSAGE
				PRINTFORML 「아~ 기분 조타~」
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
					PRINTFORMW	「%CSTR:이인칭%도 샤워하러 오시게, 기분 좋당께♪」
				ELSE
					PRINTFORMW	%CALLNAME%은(는) 조교도 잊은 채 샤워를 즐기고 있다
				ENDIF
				CFLAG:400 = 1
			;二回目以降
			ELSE
			CALL TRAIN_MESSAGE
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
					PRINTFORMW 
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && FLAG:7 == 2
					PRINTFORMW 
				;それ以外
				ELSEIF FLAG:7 == 2
					PRINTFORMW 
				ENDIF
			ENDIF
		;シャワ─止める
		ELSE
			CALL TRAIN_MESSAGE
			IF FLAG:7 == 2
				CALL TRAIN_MESSAGE
				PRINTFORMW 「아~, 개운하다」
				;陥落済み
				IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && FLAG:7 == 2
					IF RAND:2 == 0
						PRINTFORMW 「하지만서도, 또 미끌미끌 끈적끈적해져 버리겠제%ハート()%」
					ELSE
						PRINTFORMW 「%CSTR:이인칭%, 수건 줘~」
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「이걸로 %CSTR:일인칭% 혼자뿐이었다믄 기분도 개운했을 텐디 말이여~」
					ELSE
						PRINTFORMW 「%CSTR:이인칭%, 수건 줘」
					ENDIF
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;189,새댁플레이,　恋慕、親愛のみ
;-------------------------------------------------
	CASE 189
	;エプロン着る
	IF TEQUIP:에이프런
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:401 == 0
			IF TALENT:아내 && RAND:2 == 0
				PRINTFORML 「진짜 새색시 같구마, %CSTR:이인칭%♪」
				PRINTFORMW %CALLNAME%은(는) 기쁜 듯 빙글빙글 돌고 있다
			ELSE
				PRINTFORMW 「이거 입는겨? 와아, 왠지 요전에 TV에서 봤던 젊은 새댁 느낌인 거 같구마~♪」
			ENDIF
			CFLAG:401 = 1
		;二回目以降
		ELSEIF FLAG:7 == 2
			IF TALENT:유아체형 || TALENT:소인체형
				PRINTFORML 과연 %CALLNAME%, 에이프런이 범죄적일 정도로 잘 어울린다.
			ENDIF
			K:1 = RAND:3
			IF K:1 == 0
				PRINTFORMW 「%CSTR:이인칭%이 서방님이고, %CSTR:일인칭%이 색시…… 에헤, 에헤헤헤%ハート()%」
			ELSEIF K:1 == 1
				PRINTFORMW 「근디 말이여, 에이프런은 뭣 땜시 두르는 거였더라?」
				PRINTFORMW 「에, 더러워져도 괜찮도록? 그라믄, 이걸로 야한 짓 잔뜩 할 수 있는 기구마♪」
				PRINTFORMW 「에헤헤헤… %CSTR:이인칭% 변태-%ハート()%」
			ELSE
				PRINTFORMW 「여·보·당·신♪ 으응, 그냥 불러봤을 뿐… 에헤헤, 행복하당께-%ハート()%」
			ENDIF
			CFLAG:401 = 2
		ENDIF
	;エプロン脱ぐ
	ELSE
		IF FLAG:7 == 2
			CALL TRAIN_MESSAGE
			IF CFLAG:401 == 1
				PRINTFORML 「어땠어, 앞치마」
				PRINTFORML 「너무 커서 이상하진 않았어?」
			ELSE
				IF RAND:2 == 0
					PRINTFORML 「에~, 벌써 끝인겨어」
					PRINTFORMW 「뿌우~ 뿌우~」
				ELSE
					PRINTFORMW 「에이프런만 둘렀을 뿐인디도, 억수로 흥분했었구마, %CSTR:이인칭%」
					PRINTFORMW 「담번에 또 하자잉%ハート()%」
				ENDIF
			ENDIF
		ENDIF
	ENDIF

