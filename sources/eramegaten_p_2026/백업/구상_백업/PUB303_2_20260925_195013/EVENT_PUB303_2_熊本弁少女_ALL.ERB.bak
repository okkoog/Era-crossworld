IF TFLAG:0 > 0
	CALL PALAM_MESSAGE_A
	IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:233 < 3 || FLAG:7 == 2)
