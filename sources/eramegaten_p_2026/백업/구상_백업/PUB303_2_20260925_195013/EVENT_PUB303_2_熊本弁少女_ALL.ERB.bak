			CFLAG:323 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:323 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 「히양! 아앙! 거기 안 돼, 콩알 안 돼애! 머릿속이 하얘져! 히야아! 아아앙!」
					PRINTFORMW 「싫어! 안 멈춰어! 안 멈추……! 안 돼애! 아앙! 아아아아!」
					PRINTFORMW %CALLNAME%은(는) 몸을 덜덜 떨며 발음도 제대로 안 되는 교성을 끊임없이 내지른다。
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORML 「히익! 아히야앙!! 이거! 너무 기분 좋단 말이여어어!!」
						PRINTFORML 「히양! 히양앗! 아아앗! 히아아아아아아!!」
					ELSE
						PRINTFORML 「코, 콩알이! 히앙! 딱딱하게 굳어버렸당께!」
						PRINTFORML 「풀어줘! 마사지기로 풀어줘어!」
					ENDIF
					PRINTFORMW %CALLNAME%은(는) 짐승처럼 교성을 내지르며, 스스로 안달이 나 마사지기를 가랑이에 강하게 짓누르고 있다.
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 「히아아아아아! 망가져 버려! %CSTR:일인칭% 망가져 버린당께에에에에!」
				ENDIF
				CFLAG:323 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:323 < 3 || FLAG:7 == 2)
				PRINTFORMW 「거, 거기가 찌, 찌릿찌릿해서 날아가 버려, 날아가 버린당께에!」
				CFLAG:323 = 3
			;それ以外
			ELSEIF CFLAG:323 < 2 || FLAG:7 == 2
				PRINTFORMW 「그, 그거 위험혀」
				PRINTFORMW 「머릿속이 하얘져 버린단 말이여」
				PRINTFORMW 「아, 야, 야아앙!」
				CFLAG:323 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;42,클리캡
;-------------------------------------------------
	CASE 42
		CALL TRAIN_MESSAGE
