;-------------------------------------------------
;○ボイコット
;おい、コレ見てる人！今すぐオフにしろ
;実装した人には悪いが、調整不足過ぎて縛りプレイにもならん
;-------------------------------------------------
@BATTLE_BOYCOTT_MESSAGE_K[[キャラ:조마]]_1,ARG,ARG:1 = 0
	;ボイコットした場合に表示する口上
	VARSET LOCALS
	;使用したスキルの名前をLOCALSに代入
	CALL GET_SKILL_PROP, "SKILL_NAME", CFLAG:ARG:입력행동, ARG
	LOCALS = %RESULTS%
	SETCOLOR COLOR("RED")
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	IF RAND:4 == 0
		PRINTFORML ┃%"윽, 명령 복창 불가앗……",72,LEFT%┃
	ELSEIF RAND:3 == 0
		PRINTFORML ┃%"조크 시스템: 보이콧, 랜덤 기동……!?",72,LEFT%┃
	ELSEIF RAND:2 == 0
		PRINTFORML ┃%"보이콧을 보이콧하고 싶습, 니다, 만――",72,LEFT%┃
	ELSE
		PRINTFORML ┃%"보이콧 허가를 가능한 신속히 취소해 주십시오. 부탁드립니다……",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	RESETCOLOR


@MESSAGE_B2_4402_1(ARGS = "MESSAGE", ARG = 0, ARGS:1 = "", ARGS:2 = "")
#LOCALSIZE 4
#LOCALSSIZE 1
#DIM 文字数
SIF ARGS:1 == ""
	RETURN 0
SIF ARGS != "MESSAGE"
	ARGS = ＠%ARGS%
SIF STRLENS(ARGS) % 2 == 1
	ARGS += " "
文字数 = 64
FOR LOCAL, 0, 3
	SIF STRLENS(ARGS:LOCAL) == 0
		BREAK
	LOCAL:1 = STRLENS(ARGS:LOCAL)
	SIF LOCAL == 0
		LOCAL:1 += 4
	SIF 文字数 < LOCAL:1
		文字数 = LOCAL:1
	SIF 文字数 % 2 == 1
		文字数 ++
NEXT

LOCAL:2 = 2
FOR LOCAL, 1, 3
	IF !(ARGS:LOCAL == "")
		LOCAL:2++
	ELSE
		BREAK
	ENDIF
NEXT
;これでLOCAL:2にはメッセージの行数が入る
;メッセージが一行の場合。脅威のゴリ押しである
IF LOCAL:2 < 4
	LOCAL:3 = 1
	PRINT_IMG @"A1625_NAVI_%TOSTR(LOCAL:3)%"
	PRINTFORML 　
	LOCAL:3++
	PRINT_IMG @"A1625_NAVI_%TOSTR(LOCAL:3)%"
	PRINTFORML ┏┓%ARGS + "┏" + "━" * (((文字数 - 4) - STRLENS(ARGS)+1) / 2)%┓
	FOR LOCAL, 1, 3
		LOCAL:3++
		SIF LOCAL:3 < 5
			PRINT_IMG @"A1625_NAVI_%TOSTR(LOCAL:3)%"
		IF !(ARGS:LOCAL == "")
			PRINTFORML ┃%ARGS:LOCAL, 文字数, LEFT%┃
		ELSE
			BREAK
		ENDIF
	NEXT
	PRINTFORML ┗%"━" * (文字数/2)%┛
ELSE
	LOCAL:3 = 1
	PRINT_IMG @"A1625_NAVI_1"
	PRINTFORML ┏┓%ARGS + "┏" + "━" * (((文字数 - 4) - STRLENS(ARGS)+1) / 2)%┓
	FOR LOCAL, 1, 3
		LOCAL:3++
		SIF LOCAL:3 < 5
			PRINT_IMG @"A1625_NAVI_%TOSTR(LOCAL:3)%"
		IF !(ARGS:LOCAL == "")
			PRINTFORML ┃%ARGS:LOCAL, 文字数, LEFT%┃
		ELSE
			BREAK
		ENDIF
	NEXT
	LOCAL:3++
	SIF LOCAL:3 < 5
	PRINT_IMG @"A1625_NAVI_%TOSTR(LOCAL:3)%"
	PRINTFORML ┗%"━" * (文字数/2)%┛
ENDIF

SIF ARG == 0
	WAIT

