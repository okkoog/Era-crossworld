;-------------------------------------------------
;○アイテム系
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,3001, 3055)

	IF 0
	;3001,외상약
	;　＞回復、威力--、単体、--、消費0　アイテム消費
	;　固定回復30。序盤では十分な回復量。
	;　とはいえ、レベルが10にもなればこれで回復を賄うのはキツい。
	ELSEIF CFLAG:ARG:입력행동 == 3001
		IF 0
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%LOCALS + "(을)를 사용합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"응급 처치를 실시합니다……",72,LEFT%┃
		ENDIF
	;3002,마석
	;　＞回復、威力--、単体、--、消費0　アイテム消費
	;　固定回復HP25％。25％っていうのは絶妙に頼りない数字である。
	;　交渉用に使うよう取っておく方がマシ。
	ELSEIF CFLAG:ARG:입력행동 == 3002
		IF 0
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%LOCALS + "(을)를 사용합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"마석을 깨뜨립니다……",72,LEFT%┃
		ENDIF
	;3003,우황단
	;　＞回復、威力--、単体、--、消費0　アイテム消費
	;　固定回復HP200。これはけっこう頼りになる数字。
	;　とはいえ終盤では厳しいが、これは買えるのがデカい。
	;　/
