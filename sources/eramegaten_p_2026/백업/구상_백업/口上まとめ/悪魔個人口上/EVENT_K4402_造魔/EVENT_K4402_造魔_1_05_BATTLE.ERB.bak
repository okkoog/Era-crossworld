			ELSEIF RAND:9 == 0
				PRINTFORML ┃%CSTR:이인칭 + "의 폼 잡던 모습의 데이터를 상기…… 생체 MAG 변환 개시……",72,LEFT%┃
			ELSEIF RAND:8 == 0
