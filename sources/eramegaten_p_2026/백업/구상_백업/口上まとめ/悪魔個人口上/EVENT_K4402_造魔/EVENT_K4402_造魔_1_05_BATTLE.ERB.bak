			PRINTFORML ┃%"스킬 코드: Random Slash……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"사뿐히 번뜩이고, 단숨에 해결, 쾌도난마의 참살극……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"푹 베어 우수수 흩어지는, 그 목숨……!",72,LEFT%┃
		ENDIF
	;0068,뇌쇄슬래시
	;　＞剣撃、威力190、単体、物、消費11　精神魅了35-80
	;　魅了効果。まあ普通。
	ELSEIF CFLAG:ARG:입력행동 == 68 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Charm Slash……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"이 검격의 궤적에…… 반해야 마땅할 것으로……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"의류 전개―― 어라, 빈틈이……",72,LEFT%┃
		ENDIF
	;0069,ラビュリス連撃
	;　＞剣撃、威力200*3、列ランダム、物、消費24　単体最大ヒットは３
	;　ラビュリントス……ではなく、ミノタウロスの持ってる斧の連撃。
	;　200*3と大ダメージ攻撃である。
	;　ミノタウロスが覚える。
	ELSEIF CFLAG:ARG:입력행동 == 69
		IF 0
		;オニカグラ（Oni-Kagura）って名前はどうなんだ英訳版？
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Labrys Random strike……！",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"무장 재현…… 미궁에 봉인된 뇌광도끼……",72,LEFT%┃
			PRINTFORML ┃%"……뇌명과도 같은 격렬함으로……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"신체능력 부스트, 액스 전개……!",72,LEFT%┃
			PRINTFORML ┃%"자아 받아라, 뇌명의 난타를……!",72,LEFT%┃
		ENDIF
	;0070,오의일섬
	;　＞剣撃、威力320、列、物、消費30　CT20　剣撃即死30-90
	;　怒り爆発状態だとCTが50になるけど、たしか、サムスピ勢限定スキルだった気がするなー。
	;　同様に、剣撃即死も怒り爆発だと80-100となる。やばいわね。
	ELSEIF CFLAG:ARG:입력행동 == 69
		IF 0
		;英訳版では「Occult Flash」。奥技は別にオカルトではないと思う。
		;達人のお仕事、としておいた。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Master's Deadly Work……",72,LEFT%┃
		;隠し剣・鬼の爪。
		;これは「心臓に一片の傷だけを残す」暗殺剣である。
		;まあ列攻撃じゃねえなあ……
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"비검…… 귀신의 손톱……",72,LEFT%┃
		;ちなみに、「ストライク」「スラッシュ」を組み合わせた造語。
		;……フレイザード戦、空裂斬の演出原作に寄せてほしかったナー
		;アニメのオマケと言っては何だが、情報番組で「闘気」について色々語られていたのが設定厨的には嬉しい。
		;まず生命エネルギー「闘気」があり、正義の心があり、闘気を極めれば「光の闘気」、
		;魔に心が傾けば「暗黒闘気」、さらにこれを極めれば炎の性質を持つ「魔炎気」となるらしい。
		;……超魔生物細胞は魔炎気を発する性質を持つそうだが、これはまあ、「自然に魔炎気を発するほど生命エネルギーが強い」ということだろう。たぶん。
		;まあザムザとか闘気を使ってなかったが。きっと、ザムザが本来的には魔術師だからなのだろう。
		ELSE
			PRINTFORML ┃%"받아라, 육해공 모든 기술을 극한까지 연마한 스트래시를……",72,LEFT%┃
		ENDIF
	;0071,천군의신창
	;　＞多段/검격/破魔、威力300+220、単体、物、消費20
	;　검격→破魔の二連続攻撃。
	;　多段技は複合技よりやや消費が安い傾向にあるが、これはペルソナ専用ということもありさらにお安い。つよい。
	;　페르소나；アテナ専用とか書いてあるけど知らん
	;　仮にも戦神のマルスをぶっちぎる人気、やっぱみんな女の子のほうが好きなんだね……かわいそう……
	ELSEIF CFLAG:ARG:입력행동 == 71
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"셀레스타 랜스, 레디……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Celestial Spear……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"권능 재연…… 처녀신이자 전쟁의 신, 아테나의 창을……",72,LEFT%┃
			PRINTFORML ┃%"……지금, 여기에……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"전쟁의 신 아테나여…… 힘을 빌리겠습니다……",72,LEFT%┃
		ENDIF
	;0072,마스커레이드
	;　＞剣撃、威力300*2、単体、物、消費38
	;　多段攻撃はちょっとだけ消費が安くなる傾向にある。むしろ多段攻撃のほうが強いんだけども……
	;　（乗除がメインなので、「威力100×４」と「威力400」の合計ダメージは変わらない）
	;　（ただしCTが発生しやすい、ハンパにでも当たりやすいということで、た～ぶんほぼ同じか、わずかに多段攻撃のほうが強い）
	;　（※計算式の都合上、切り捨てが発生し合計ダメージが低くなる場合はある）
	;　亜空両断よりほんの少しだけ安い。……とはいえ、オマケを考えれば亜空両断のほうが強いと思うが……
	;　とはいえ、というか、ブレイブザッパーと比べるとちょっとコスパが悪いかしら？
	ELSEIF CFLAG:ARG:입력행동 == 72
		IF 0
		;やりにげダイナミック！
		;詳しくは「2927,빙의「희로애락포제션」」のあたりを参照。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"Wake up, Masquerade……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"웨이크업, 매스커레이드……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"가면 무투의 소양은 있으신가요……?",72,LEFT%┃
		ENDIF
	;0073,반역의칼날
	;　＞剣撃、威力特殊、単体、物、消費80　CT特殊　관통　敵の剣撃耐性に応じて威力・CT変動、下記
	;　等倍：450　CT0
	;　耐性：480　CT10
	;　無効：550　CT20
	;　吸収：650　CT30
	;　反射：650　CT30
	;　テトラカーン状態なら反射扱い
	;　剣撃壁を張っていたら無効扱い（反射ならそのまま威力650）
	;　『耐性が高いほど大ダメージ』っていうちょっと珍しい技
	;　その都合で完全貫通攻撃、その分コスト激重
	;　P5R・明智最終ペルソナ、ヘリワード専用想定とのこと。
	;　継承に必要な部位が「Return 0」のため、仮に悪魔が覚えても造魔ちゃんに引き継ぐことができない、はず。
	ELSEIF CFLAG:ARG:입력행동 == 73
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"데몬스트레이트: Blade of Rebellion……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"그 방어에…… 전신전령의 반역을 가지고, 대항합니다……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"그 방어에…… 반역합니다……!",72,LEFT%┃
		;『スクライド』。
		;「男の義務教育」ともいえる名作アニメ。で、ムックに監督・谷口氏が出したコメントが有名。
		;もうお一方は各キャラクターに「人を強く思う気持ちを体現してくれたキャラです」といったコメントを残しているのだが、
		;監督は女性キャラに「スクライドは男の話なので、女に関して語ることなどなにもありません」で通している。
		;いやポリコレに殴られそうなコメントだなオイ。
		ELSE
;			PRINTFORML ┃%"　　ﾄﾘｰｽﾞﾅｰ",72,LEFT%┃
			PRINTFORML ┃%"나는 반역자가 아니지만―― 허나 지금, "NO" 이외의 말은 없도다……!",72,LEFT%┃
		ENDIF
	;0074,공간살법
	;　＞剣撃、威力450、列、物、消費30
	;　ごくシンプルな列攻撃。
	;　ここまで来たら虚空斬波をそろえたい。
	ELSEIF CFLAG:ARG:입력행동 == 74
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"넥 컷: Vorpal Blade……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"아공간에서 베어가르겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"그 공간은 이미 베어 갈랐습니다……",72,LEFT%┃
		ENDIF
	;0077,나선의칼날
	;　＞剣撃、威力350、単体、物、消費14　CT40
	;　アレックス(DSJ)専用。達人用専用スキルなので、強くて安い。
	;　でもコレ、名前変更でよかった気がする。
	ELSEIF CFLAG:ARG:입력행동 == 77
		IF 0
		;『FF10』主人公、ティーダのオーバードライブ技のひとつ。初期習得である。
		;アクロバティックに側転・後転を繰り返し、敵に刃を叩きつける。
		;運動神経いいなコイツ……と思ったものである。
		;「スピラの円環を断ち切る」……というと、ちょっと意味深。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"오버드라이브: Spiral cut……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"螺旋剣、抜錨……！",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"나선검으로 무지개를 벤다……",72,LEFT%┃
		ENDIF
	;0078,크레이브・솔리시
	;　＞複合/검격/万能、威力特殊、単体、物、消費60　CT特殊　威力、CTはHPに応じ変動、下記
	;　威力は325/350/400/480/550/700
	;　CTは　　0/ 10/ 20/ 30/ 40/ 50
	;　条件は100/ 80/ 60/ 30/  5/  1％未満、での値。
	;　HPが最大だと通常のクリティカルが発生しなくなってしまう。
	;　アレックス(DSJ)専用。達人用専用スキル……なのだが、正直これを使うなら普通にブレイブザッパーとか万魔パンチとか使いたい。
	;　必殺攻撃ではあるが、わりと微妙。
	;　→上方修正が入った。
	;　＞複合/검격/万能、威力特殊、単体、物、消費40　CT特殊　威力、CTはHPに応じ変動、下記
	;　威力は400/450/500/550/600/800
	;　CTは　 10/ 20/ 30/ 40/ 50/ 60
	;　条件は100/ 80/ 60/ 30/  5/  1％未満、での値。
	;　命中120と高め。
	;　スタート時点で「消費は重いが剣撃複合でCTのある万魔の一撃」。
	;　達人の・必殺・専用スキルとしては十分で、HP80％未満の時点でけっこうイケてる。
	;　（とはいえ前衛型だとMPが死んじゃうのだが）
	;　HP条件スキルはやはり最大火力の発揮は難しいが、追い詰められてから輝くタイプだったみたいだしねえ、アレックス。
	;　/
	;　アイルランド語で「Claidheamh Soluis」、つまりは「클라우・솔라스」である。
	;　DSJでは「클라우・솔라스」名義で使用。物理特大威力攻撃で、物理相性を無視する……という攻撃だったようだ。
	;　ちなみに「클라우・솔라스」、わりとどこにでも出てくる。「光る剣」という意味なので、物語で得る魔法の剣と言ったらコレ、という感じになる。
	;　固有名詞ではないわけだな。
	;　光る剣、というのは共通するが、呪文が刻まれてたりとかなんらかの剣であるとか隠れた敵を探し出すとかは、物語それぞれの能力であって、
	;　それを併せ持つとは限らない。
	ELSEIF CFLAG:ARG:입력행동 == 78
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"매직 블레이드: Claiomh Solaiss……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"클라우 솔라스, 발도하겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"光輝剣、抜剣……！",72,LEFT%┃
		ENDIF
	;その他汎用
	;すなわち、新しいスキルが追加された時はここになる。やりきった。
	ELSEIF CFLAG:807 >= 3
		IF RAND:3 == 0
			PRINTFORML ┃%LOCALS + "(으)로 참수하겠습니다……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%LOCALS + "(으)로 참격하겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%LOCALS + "(으)로 베어 버리겠습니다……",72,LEFT%┃
		ENDIF
	ENDIF

;-------------------------------------------------
;○비구
;範囲攻撃と複数回攻撃が多め
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,101, 199) && CFLAG:807 >= 2
	IF 0
	;0101,백발침
	;　＞飛具、威力115、単体、物、消費2
	;　最も基本的と言えるスキル、ヤマオロシ枠
	;　違いは大量に派生があること
	;0102,독침
	;　＞飛具、威力120、単体、物、消費3　神経猛毒40-70
	;0103,마비침
	;　＞飛具、威力120、単体、物、消費4　神経麻痺40-70
	;0104,석화침
	;　＞飛具、威力205、単体、物、消費8　呪殺石化40-70
	;0105,몽견침
	;　＞飛具、威力205、単体、物、消費6　精神睡眠40-70
	;　それぞれ、毒、麻痺、石化、睡眠付与。命中120でちょっと当たりやすい
	;　実は石化と夢見は九十九針よりだいぶ威力が高い（それでも200程度だが）
	;0166,혼란침
	;　＞飛具、威力80*1-4、単体、物、消費5　CT20
	;0167,강철침
	;　＞飛具、威力130*1-4、単体、物、消費14　CT20
	;　威力が1.5倍になると消費は３倍になる。げせぬ。
	;0168,팔백만침
	;　＞飛具、威力175、全体、物、消費16
	;　以前の天羽の舞に近いポジション。というか、以前の天羽が強すぎ。
	;0169,백마비침
	;　＞飛具、威力90*2-5、全体ランダム、物、消費15　神経麻痺30-70
	;　派生は九十九針を参照な。
	;　以前の天羽の舞に近いポジション、その２。ちょっと全体ランダムなのが厳しい。

	;　★派生ルート
	;　・100.백발침
	;　　├독침┬석화침―천우의춤
	;　　｜　　└데스샤워―천우의춤
	;　　├마비침―백마비침―천우의춤
	;　　├몽견침┬석화침―천우의춤
	;　　｜　　　└데스샤워―천우의춤
	;　　└혼란침┬강철침
	;　　　　　　└팔백만침
	;　・110.퀵드로
	;　　├113.산탄사격
	;　　└144.타슬람샷
	;　　　├136.그랜드턱
	;　　　｜├152.트리플다운
	;　　　｜└155.슈퍼노바
	;　　　└145.원샷킬
	;　・111.싱글샷
	;　　├112.연속사격―108.찰나장대비쏘기―127.오절절우
	;　　└114.엔젤애로―149.세이크리드애로
	;　・112.연속사격―108.찰나장대비쏘기―127.오절절우
	;　・113.산탄사격
	;　　├124.미들샷―154.해피트리거―108.찰나장대비쏘기―127.오절절우
	;　　└153.드라이브샷―154.해피트리거―108.찰나장대비쏘기―127.오절절우
	;　・125.멸살수전―107.고천열풍탄―139.선회속탄
	;　・126.암파쌍비조―107.고천열풍탄―139.선회속탄
	;　/
	;　九十九針についてで言うと、以前より、単純に強力なスキルには派生しにくくなった。
	;　まあ天羽の舞が、威力までともなうスキルに変化したとも言えるんだけど。
	ELSEIF GROUPMATCH(CFLAG:ARG:입력행동, 101, 102, 103, 104, 105, 166, 167, 168, 169) && CFLAG:807 >= 3
		;半分で針系共通
		IF RAND:2 == 0
			IF RAND:2 == 0
				PRINTFORML ┃%"니들 스팅, 레디……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"바늘 다루기를 선보이겠습니다……",72,LEFT%┃
			ENDIF
		ELSE
			;백발침
			IF CFLAG:ARG:입력행동 == 101
				IF RAND:2 == 0
					PRINTFORML ┃%"스킬 코드: 99 Needles……",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"바늘을 투척합니다……",72,LEFT%┃
				ENDIF
			;針オブ毒
			ELSEIF CFLAG:ARG:입력행동 == 102
				IF RAND:2 == 0
					PRINTFORML ┃%"스킬 코드: Toxic Sting……",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"독바늘을 투척합니다……",72,LEFT%┃
				ENDIF
			;スティングオブパライズ
			ELSEIF CFLAG:ARG:입력행동 == 103
				IF RAND:2 == 0
					PRINTFORML ┃%"스킬 코드: Stun Needle……",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"마비 바늘을 투척합니다……",72,LEFT%┃
				ENDIF
			;Sting of Stone
			ELSEIF CFLAG:ARG:입력행동 == 104
				IF RAND:2 == 0
					PRINTFORML ┃%"스킬 코드: Arid Needle……",72,LEFT%┃
