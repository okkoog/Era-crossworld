	;2028,스펙트라포스
	;　＞特殊、威力435、全体、魔、消費60　相性は「화염～만능」でランダム
	;　メギドラオンを使おう。
	;　TASさんが使えば強いんじゃない？
	;　まァ、消費が20くらいにならんと使う気にはなれない。なっても微妙。
	;　ただ、相性がフラットなタイプのボス……そんなの滅多にいないが……なら、「何が出てもいい」という状況があれば……まあ……
	ELSEIF CFLAG:ARG:입력행동 == 2028
		IF 0
		;Disperse：分光せよ
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"디스퍼스：Spectra Force……",72,LEFT%┃
		;プリズム使うな、やめろ
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"프리즘 형성…… 스펙트럼 캐논, 레디……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"스펙트럼, 랜덤 스트라이크……",72,LEFT%┃
		ENDIF
	;2029,기어오는혼돈
	;　＞万能、威力430、全体、魔、消費60　神経魔封50-80
	;　万能での付与はまあまあ許されないが、それはそれとして、神経で着てもなぁ。とはなる。
	;　ただ、メギドラオンの上位互換ではありますわね。
	;　まあ一応、ニャル専用スキルだし……
	ELSEIF CFLAG:ARG:입력행동 == 2029
		IF 0
		;Mock：嘲笑
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"모킹：Crawling Chaos……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"비웃어라, 트릭스터여……",72,LEFT%┃
			PRINTFORML ┃%"……질서마저 지닌 혼돈에 빠져 죽어라……",72,LEFT%┃
		;我々に近づき……（名状しがたき唸り声）……取り憑き給え。（理性を失った悲鳴）
		;世界はすでに暗黒に堕つる（宇宙からの呼び声が聞こえる）
		;（名状しがたき唸り声）（理性を失った悲鳴）
		;（名状しがたき唸り声）（理性を失った悲鳴）
		;（名状しがたき唸り声）（理性を失った悲鳴）
		;（さあ、もう理性を保ってなどいるな、という冒涜的な声）
		;ぬめる心を持つ異形の神々よ
		;我は恐怖を知るもの　それを欲するもの　神々、あなたさまと同様に
		;その形が崩れれば、異教徒は背を向け逃げる
		;我は砂漠を行くもの　それを楽しむもの　神々、あなたさまと同様に
		;骨身は焼け、朽ち果て腐り溶ける
		;（生物に在らじ、という異教徒の悲鳴）
		;我が最も欲するものは見いだせず　御身の姿は我には見えず
		;ああ、それでも、あなたさまの栄華に浴したく
		;我に似合うは不条理　現世の不条理
		;鏡には――（異教徒の誰何の悲鳴）――映らず（異教徒の理性を失った拒絶）
		;しかして、この欲は（名状しがたき唸り声）言葉にせねばならぬ――（理性を失った悲鳴）
		;（さあ、もう理性を保ってなどいるな、という冒涜的な声）
		;天の日は虚構と化し、永遠の闇が世を覆う（高揚の声）
		;天の日がいくら眩しくとも、永遠の闇を我らは望む（そうなのか、と問いなおす信仰者の声）
		;混沌。混沌。おお、我らは混沌を望むもの！
		;燃えよ混沌！　すべての支配者よ！（高揚の声）
		;混沌！混沌！　一夜燃え盛る混沌よ！（おお、おお、なぜならば、というチャント）
		;我々は――（名状しがたき唸り声）――遣いであり、世の偽りを払う破り手である（理性を失った悲鳴）
		;（空を見上げ宇宙を信奉する）
		ELSE
			PRINTFORML ┃%"언제나 싱글벙글…… 네놈들의 사각에…… " + CSTR:일인칭 + "입니다……",72,LEFT%┃
		ENDIF
	;2030,시간의수레바퀴
	;　＞万能、威力特殊、全体、魔、消費60　威力は使用回数に応じて変動、『350 * (8 + 使用回数) / 8』、使用回数フラグは８まで
	;　最大威力は700（ｶｰﾁｬﾝ140から上昇）。
	;　同コストのメギドラオンの威力が420。메기도라온×10＝4200。
	;　刻の車輪が威力向上含みで350+393+437+481+525+568+612+656+700+700＝5422。
	;　万能大威力攻撃で、9回目で最大威力＝強力なボス戦用。10ターンくらいブッパし続けるならこちらのほうがよい。
	;　まあロゴスや、空想具現化など、これより便利だったりするものも多いが。
	;　いちおう複数人で使うと、使用回数フラグがその分加算され、最速で2ターン目途中から最大威力になります。
	;　当然ながら、「メギドラオンを10発」くらいで死ぬ相手なら、メギドラオンのほうが安定である。
	;　……アレだ。古代ちゃんを孕ませろ！！！　受胎スキルだから！　そして使え！
	;　なお、これは完全オリジナルスキルである模様。
	ELSEIF CFLAG:ARG:입력행동 == 2030
		;かねてからやりたかったことをやる
		;初回～最大威力それぞれの口上追加をパターン分けつつ順番に出す
		;パターンをいくらか変えたいので、CFLAGと固有ゲージを使用する
		;これはキャラ固有のゲージであり、基本的にはスキルとかに影響はないはず……

		;今回の戦闘で出るパターンを決定
		;※Hは戦闘ごとにリセットされる
		IF CFLAG:고유게이지H1 == 0
			IF 0
			ELSEIF RAND:3 == 0
				CFLAG:890 = 3
			ELSEIF RAND:2 == 0
				CFLAG:890 = 2
			ELSE
				CFLAG:890 = 1
			ENDIF
		ENDIF

		;パターンA
		;ネタ口上。じくういでんしと読む。
		;分かりにくいであろう微妙なネタである。
		IF CFLAG:890 == 3
			IF 0
			;9回目以降：威力700
			ELSEIF CFLAG:고유게이지H1 >= 8
				IF 0
				ELSEIF RAND:3 == 0
					PRINTFORML ┃%"공간이여 구동하라, 약동하라 시간축!",72,LEFT%┃
					PRINTFORML ┃%"――노래하라, 시간의 수레바퀴여……!",72,LEFT%┃
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"시허유전사 장악…… 완료……!",72,LEFT%┃
					PRINTFORML ┃%"――삐걱여라, 시간의 수레바퀴여……!",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"時虚遺伝詞行使権限最大行使……開始……！",72,LEFT%┃
					PRINTFORML ┃%"――돌아라, 시간의 수레바퀴여……!",72,LEFT%┃
				ENDIF
			;8回目：威力656
			ELSEIF CFLAG:고유게이지H1 == 7
				PRINTFORML ┃%"시허유전사 장악…… 99%. 공격합니다……",72,LEFT%┃
				PRINTFORML ┃%"나를 따라 윤전하라, 시간의 수레바퀴여……!",72,LEFT%┃
			;7回目：威力612
			ELSEIF CFLAG:고유게이지H1 == 6
				PRINTFORML ┃%"시허유전사 완전 장악까지 30%…… 관리자 권한 취득 성공.",72,LEFT%┃
				PRINTFORML ┃%"권한에 따르라, 시공이여 떨어라……!",72,LEFT%┃
			;6回目：威力568
			ELSEIF CFLAG:고유게이지H1 == 5
				PRINTFORML ┃%"시허유전사 완전 장악까지 50%……",72,LEFT%┃
				PRINTFORML ┃%"……흔들려라, 시공이여……!",72,LEFT%┃
			;5回目：威力525
			ELSEIF CFLAG:고유게이지H1 == 4
				PRINTFORML ┃%"時虚遺伝詞行使権限……承認。",72,LEFT%┃
				PRINTFORML ┃%"……돌아라, 시간의 톱니바퀴여……!",72,LEFT%┃
			;4回目：威力481
			ELSEIF CFLAG:고유게이지H1 == 3
				PRINTFORML ┃%"시허유전사, 액세스 권한 취득…… 행사권, 위장 취득……",72,LEFT%┃
				PRINTFORML ┃%"위장 권리, 시험 행사합니다……",72,LEFT%┃
			;3回目：威力437
			ELSEIF CFLAG:고유게이지H1 == 2
				PRINTFORML ┃%"시허유전사, 주사 완료…… 액세스 권한 확립 개시……",72,LEFT%┃
				PRINTFORML ┃%"저항 여파를 흘려보내겠습니다……",72,LEFT%┃
			;2回目：威力393
			ELSEIF CFLAG:고유게이지H1 == 1
				PRINTFORML ┃%"시허유전사 주사 중…… 부하를 전용합니다",72,LEFT%┃
			;1回目：威力350
			ELSE
				PRINTFORML ┃%"시허유전사에 액세스 개시…… 성공. 장악 개시……",72,LEFT%┃
			ENDIF
		;パターンB
		;MTGシリーズ
		ELSEIF CFLAG:890 == 2
			IF 0
			;9回目以降：威力700
			ELSEIF CFLAG:고유게이지H1 >= 8
				IF 0
				;タイタンの存在
				;無色のクリーチャーカードを手札から公開しないと使えない。
				;公開したカードのパワー以下のクリーチャーを追放する。
				ELSEIF RAND:5 == 0
					PRINTFORML ┃%"남는 것은 티끌과 추억뿐이겠지요――",72,LEFT%┃
				;さまようもの
				;青のアイドル。
				;1マナ1/1、能力なし、と純粋にカードとしてみるとクソ雑魚ナメクジ。
				;MTGにおいて青は「知恵はあるが肉体的にはクソ雑魚」ということで、「クリーチャー最弱の色」と位置付けられているのだが、
				;そんな青においてもまあ弱い、という本当に弱いクリーチャー。
				;ただし「使い手に害を与える」というタイプではない。マジでなにも能力を持っていないだけである。
				;青にしたって突き抜けた弱さ、フレーバーテキストの秀逸さから、人気のあるカードである。
				ELSEIF RAND:4 == 0
					PRINTFORML ┃%"어린 시절에…… 본 적이 있습니까?",72,LEFT%┃
					PRINTFORML ┃%"헤맬 때에 당신의 손을 잡아 이끌어준 것……",72,LEFT%┃
					PRINTFORML ┃%"……당신을 편안한 곳으로 데려다주겠지요――",72,LEFT%┃
				;アクローマの記念碑
				;エンチャント。なんか自軍をめちゃくちゃ強化する。
				ELSEIF RAND:3 == 0
					PRINTFORML ┃%"얼마나 시간이 흐르든―― 휴식도 자비도 주지 않겠습니다――",72,LEFT%┃
					PRINTFORML ┃%"――설령 무슨 일이 있더라도――!",72,LEFT%┃
				;最後の言葉
				;打ち消されない打消し。非常に秀逸なフレーバーテキストで有名。
				;――いつかの敗北の時は来たれり。
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"언젠가 누군가가 우리에게 가져다줄 패배는……",72,LEFT%┃
					PRINTFORML ┃%"……오늘, 당신에게 주어질 것이 아니다……!",72,LEFT%┃
				;ファイレクシアの抹消者。
				;往年の名カードのキチガイリメイク。
				;元々は「ダメージを受けたら自軍のカードを破壊」だったのが「ダメージを受けたら相手のカードを破壊」とかいうアホ能力になっている。
				;……が、環境に恵まれなかった。むねん。
				ELSE
					PRINTFORML ┃%"축복받은 완성을 낱낱이 보아라……!",72,LEFT%┃
				ENDIF
			;8回目：威力656
			ELSEIF CFLAG:고유게이지H1 == 7
				IF 0
				;次元橋
				;コストは重いが、なんかライブラリーからカードを選んで出せる。
				;起動さえできればゲームを決めるレベルで強力……というのは、たいてい悪用される。
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"완성입니다―― 지금부터가 진짜입니다……",72,LEFT%┃
				;ヴェズーヴァ。
				;場にある土地のコピーになる土地。
				;これも秀逸なフレーバーテキストを持つ。
				ELSE
					PRINTFORML ┃%"당신이 있던 모든 곳의 시간을 말소합니다……",72,LEFT%┃
				ENDIF
			;7回目：威力612
			;ファイレクシア流再利用
			;ライフとマナを支払うことで、手札にクリーチャーカードを手札に戻せる。
			;「死は労働をやめる理由にはならん」……から着想な。
			ELSEIF CFLAG:고유게이지H1 == 6
				PRINTFORML ┃%"당신의 노동은 이미 끝났으므로……",72,LEFT%┃
			;6回目：威力568
			;精神壊しの罠
			;最強クラスの打消しのひとつ。最後の言葉への、ある意味での返礼。
			;「行き止まりのひとつがこれだ」
			ELSEIF CFLAG:고유게이지H1 == 5
				PRINTFORML ┃%"당신에게 막다른 골목을 주겠습니다――",72,LEFT%┃
			;5回目：威力525
			;道理の宿敵
			;なんかごりッとライブラリーを削る。
			ELSEIF CFLAG:고유게이지H1 == 4
				PRINTFORML ┃%"당신을 서술하는 말은 사라지고, 당신을 기록하는 자는 멸망한다……",72,LEFT%┃
			;4回目：威力481
			;道の探究者
			;地味なクリーチャー。まあ、リミテッドではいい仕事をする。
			ELSEIF CFLAG:고유게이지H1 == 3
				PRINTFORML ┃%"패배의 운명과 만나는 곳은 어디일까요――",72,LEFT%┃
				PRINTFORML ┃%"――당신의 운명은 오늘 찾아왔습니다……",72,LEFT%┃
			;3回目：威力437
			;納墓
			;ライブラリーからカードを１枚墓地に置く。遊戯王とかでもそうだがこういうカードは悪さしかしない。
			ELSEIF CFLAG:고유게이지H1 == 2
				PRINTFORML ┃%"당신을 무덤 아래서 완숙시키도록 하지요……",72,LEFT%┃
			;2回目：威力393
			;行き詰まり
			;超絶クソめんどくさいやつ。自分で使ってもめんどくさいが相手に使われるともっとめんどくさい。
			ELSEIF CFLAG:고유게이지H1 == 1
				PRINTFORML ┃%"편히 쉬십시오……",72,LEFT%┃
			;1回目：威力350
			ELSE
				IF 0
				;除外。
				;クリーチャーに対する打消し。
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"지금은 바쁘므로……",72,LEFT%┃
				;絶え間ない飢餓、ウラモグ
				;デカくてクソつえーやつ。
				;「時間そのものの如く貪欲な力」
				ELSE
					PRINTFORML ┃%"시간 그 자체의―― 탐욕스러운 힘을 받아라……",72,LEFT%┃
				ENDIF
			ENDIF
		;パターンC
		;Wheel of Time
		ELSE
			IF 0
			;9回目以降：威力700
			ELSEIF CFLAG:고유게이지H1 >= 8
				IF 0
				;チクタクホイール
				ELSEIF RAND:3 == 0
					PRINTFORML ┃%"＊tick＊　＊Wheel＊　＊tock＊……",72,LEFT%┃
				;思い出の車輪
				ELSEIF RAND:3 == 0
					PRINTFORML ┃%"＊tick＊　Wheel of Recollection　＊tock＊……",72,LEFT%┃
				;永遠の車輪
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"＊tick＊　Wheel of Eternity　＊tock＊……",72,LEFT%┃
				;幕切れの車輪
				ELSE
					PRINTFORML ┃%"＊tick＊　Wheel of Last scene　＊tock＊……",72,LEFT%┃
				ENDIF
			;8回目：威力656
			;年。
			ELSEIF CFLAG:고유게이지H1 == 7
				PRINTFORML ┃%"＊tick＊　Wheel of Years　＊tock＊……",72,LEFT%┃
			;7回目：威力612
			;月。
			ELSEIF CFLAG:고유게이지H1 == 6
				PRINTFORML ┃%"＊tick＊　Wheel of Months　＊tock＊……",72,LEFT%┃
			;6回目：威力568
			;週。
			ELSEIF CFLAG:고유게이지H1 == 5
				PRINTFORML ┃%"＊tick＊　Wheel of Weeks　＊tock＊……",72,LEFT%┃
			;5回目：威力525
			;日。
			ELSEIF CFLAG:고유게이지H1 == 4
				PRINTFORML ┃%"＊tick＊　Wheel of Days　＊tock＊……",72,LEFT%┃
			;4回目：威力481
			;時。
			ELSEIF CFLAG:고유게이지H1 == 3
				PRINTFORML ┃%"＊tick＊　Wheel of Hours　＊tock＊……",72,LEFT%┃
			;3回目：威力437
			;分。
			ELSEIF CFLAG:고유게이지H1 == 2
				PRINTFORML ┃%"＊tick＊　Wheel of Minutes　＊tock＊……",72,LEFT%┃
			;2回目：威力393
			;秒。
			ELSEIF CFLAG:고유게이지H1 == 1
				PRINTFORML ┃%"＊tick＊　Wheel of Seconds　＊tock＊……",72,LEFT%┃
			;1回目：威力350
			ELSE
				PRINTFORML ┃%"＊tick＊　Wheel of Time　＊tock＊……",72,LEFT%┃
			ENDIF
		ENDIF

		;ゲージを加算
		CFLAG:고유게이지H1 += 1

	;2031,지라이야난무
	;　＞万能、威力435、全体、魔、消費50
	;　クズノハ専用。
	ELSEIF CFLAG:ARG:입력행동 == 2031
		;Jiraiya Tarantella
		;Tarantella……タランテラは、ナポリ起源の踊り。
	;2032,적살
	;　＞万能、威力325、単体、魔、消費17　万能即死40-50
	;　万能即死はやっぱりなァ……という感じ。
	;　そもそもの消費もかなり怪しい。
	ELSEIF CFLAG:ARG:입력행동 == 2032
		IF 0
		;Crucial：重要な、重要な、決定的な
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데드 엔드：Crucial Assassination……",72,LEFT%┃
		;『サガフロンティア』においては、「妖魔の具足」にデュラハンなどを憑依させると「暗殺」が使用可能である。
		;たしかグリランドリーもそうなのだが、無差別憑依されると「暗殺」に上書きされてグギャアした覚えがある。
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"具足展開、最適経路策定……",72,LEFT%┃
			PRINTFORML ┃%"견적필살, 집행합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"당신은…… 여기서 죽는 것이 적절하겠지요……",72,LEFT%┃
		ENDIF
	;2033,ＪＯＫＥＲ
