;○타격
;魔法造魔に加えて、打撃造魔作ったので。まあ通常攻撃は全体飛具だけどな。
;弱点がない前衛ってのも悪くない……まああなたのMAG消費がマッハすぎますけど。絶倫程度じゃたりねえ。
;特に必殺技でもないものも喋らす。っつか細かく見てくと結構隠し効果あるのなー。
;月夜の餅つきとか威力ヤバいのは知ってたけどクリティカル率まで上がってるとは。
;光速とかそういう説明文の技が出たら、聖なる戦士スターアローの雷光ingプラズマネタを使いたい。あるいは銀河夢幻拳。銀河強装弾拳でもいいぞ。
;やっぱマグナムの次はファントムだろ？
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,201, 299)
	IF 0
	;0201,돌격
	;　＞打撃、威力125、単体、物、消費3
	;　203.暴れまくり、265.猛突進に派生
	;0265,맹돌진
	;　＞打撃、威力150*2、単体、物、消費12　衝撃転倒10-30
	;　203.暴れまくりに派生
	;　/
	;　基礎的なスキル。
	;　猛突進はわりと珍しいSLIPを付与することがある。
	;　二連攻撃ということは、往復突進してるんだろうか……？　ひらめいた
	;　字面的に「……！」を使うことにする
	ELSEIF (CFLAG:ARG:입력행동 == 201 || CFLAG:ARG:입력행동 == 265) && CFLAG:807 >= 3
		IF 0
		;この異名なんか微妙な気はするわね、公式だけど
		ELSEIF RAND:100 == 0 && CFLAG:ARG:입력행동 == 265
			PRINTFORML ┃%"이것이야말로, 반짝이는 유혈열차……!",72,LEFT%┃
		;ポリマーとハリケーンミキサー
		ELSEIF RAND:100 == 0 && CFLAG:ARG:입력행동 == 201
			PRINTFORML ┃%"이것이야말로, 파리권 교반기……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Lunge……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"적성 목표에 돌격합니다……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"적성 목표에 눌함(함성 지르며 돌격)합니다……!",72,LEFT%┃
		ENDIF
	;0202,숏잽
	;　＞打撃、威力130、単体、物、消費2
	;　210.ソニックパンチに派生
	;　性能そのものに見るべきところはない。
	;　打撃スキルはパンチ系とキック系、多いよね。
	ELSEIF CFLAG:ARG:입력행동 == 202 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:100 == 0
			PRINTFORML ┃%"라-운드 원…… 파잇",72,LEFT%┃
;			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
;			PRINTFORML ┏┓＠%NAME:MASTER,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"どこで覚えた。",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"스킬 코드: Short Jab……",72,LEFT%┃
		;人間は息を吐いてるときのほうが強い。
		;胸郭内……まあ、肺のまわりは、基本的に陰圧＝大気圧より圧力が低い。
		;肺胞を外に出すと自然にしぼんでしまうのだけど、この陰圧で広がっている。
		;で、息を吸う動きとは、胸郭の内膜と、横隔膜が収縮して、胸郭内が広がる。
		;当然そうなると、圧力が減り、肺胞が膨らみ、空気が取り込まれるわけだナ。
		;あ、横隔膜は肋骨の下を蓋をするようについてる筋肉なんだけど、これは肋骨に垂れ下がるようについていて、
		;陰圧が働いて上に引っ張られてるのが下に引っ張られるように動くわけだね。
		;力を抜くと息を吐くのは、息を吐いた状態が力の抜けた状態……「下に引っ張ってない」状態だからなわけ。
		;で、力の抜けた状態のほうが瞬発力とかはそりゃあでるわけだけども、
		;だからと言って完全に力みの抜けたままだとグニャグニャになるというか、力積の問題が云々。
		;息を吸うというのはどうしたって「ゆるみ」のあるものなので、ゆるみと力みを一緒にやるというのは無理な話であって。
		;体を一直線に使う、という意味では、息を吐くときのほうが強いのはある種当然。
		;古武術の奥技の中に「呼吸法」があるくらい、重要なものなんですよ。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"쉭, 쉭!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"접근전을 행하겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"완부를 사용한 타격을 행사하겠습니다……",72,LEFT%┃
		ENDIF
	;0203,마구날뛰기
	;　＞打撃、威力120*2-5、列ランダム、物、消費5　単体最大ヒットは２
	;　小威力の2-5回攻撃。コストが安い。
	;　ただし1体あたりのヒット数が2の都合で、火力がなー。
	ELSEIF CFLAG:ARG:입력행동 == 203 && CFLAG:807 >= 3
		IF 0
		;Berserk。バーサーク、よりは、ベルセルク、のほうが有名だろう。
		;これは、古ノルド語の言葉で、「熊 (ber) の毛で作った上着 (serkr) を着た者」……という意味があるらしい。
		;ノルドとは「北のほう」を指す言葉であるが、主に北欧……スウェーデンやデンマークで話されていた言葉である。
		;クマつながりで言うと、「アーサー王」の「アーサー」は古アイルランド語で「クマのような男」という意味とされる。
		;『ベルセルク』については、今更ここで語ることもあるまい。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Berserk……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"때리고 차는 폭행을 무작위로 실행하겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"잠시, 크게 날뛰고 오겠습니다……",72,LEFT%┃
		ENDIF
	;0204,돌려차기
	;　＞打撃、威力140、列、物、消費5
	;　206.サマーソルト、207.雷震王母の蹴り、264.ツイスターキックに派生
	;　雷震王母の蹴りに派生するのが最大の特徴、っていうかいいんだろうか？
	;　キック系……でまとめようかと思ったけど、
	;　バラバラなんでレンジ使うまでもねえっつかなんつーか。
	;　踏み込んで蹴ったとしても、脚を必死で伸ばしたとしても、前列対象なのは違和感があります。
	;　実は回し蹴りって前列をそれぞれ蹴り倒してるんじゃね？ 攻撃回数最大５とかなんじゃね？
	;　……ってのはアレなんで真空な解釈。まあ真空もトンデモかと思いますが。
	ELSEIF CFLAG:ARG:입력행동 == 204 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Roundhouse Kick……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"진공 돌려차기로, 적성 목표를 쓸어버리겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"차례차례 걷어차 굴려버리고 오겠습니다……",72,LEFT%┃
		ENDIF
	;0205,메가톤프레스
	;　＞打撃、威力290、全体、物、消費18
	;　メガトンプレスというかヒッププレス……いいよね。うん。
	;　ギリ大威力以下の全体攻撃。
	;　雑魚戦で使いやすい良スキル
	ELSEIF CFLAG:ARG:입력행동 == 205 && CFLAG:807 >= 3
		IF 0
		;ちょっと率を下げておく
		ELSEIF RAND:10 == 0
			PRINTFORML ┃%"……엉덩이가 큰 것은, 결코……",72,LEFT%┃
		;かちわりメガトンパンチ。『星のカービィ　スーパーデラックス』のミニゲーム。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"픽셀 퍼펙트……",72,LEFT%┃
