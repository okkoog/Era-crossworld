	;　＞打撃、威力100*特殊、単体、物、消費8　攻撃回数は下記
	;　230.千烈突きに派生
	;　彼我の素早さの差で最大攻撃回数が増加（2-7）、
	;　７回到達してもまだ早かった場合、最低攻撃回数が増加
	;　相手の3倍早ければ7-7回攻撃という、でも特化型にしたら力足りなくてダメージ出ないと思う
	;　→ｶｰﾁｬﾝ140で式が修正された。
	;　数字的にはまあまあキツいが、それでも3倍とかにしなくてもよくなった。
	;　とはいえ、序盤だと攻撃回数はむしろ減っているかな……？
	;　「敵の速度の３倍」は、敵が弱ければ当然低い……敵速度３なら速度９でいいが、
	;　「敵の速度の+25」は、速度3相手でも28は要るので。
	;　/
	;　최저공격횟수
	;　　結果は２～７。
	;　　「MAX(使用者速さ - ターゲット速さ + (使用者が敵であるなら10) -25, 1) / 5 +2」
	;　　７回に到達するためには、味方が使用する場合、速度が50上回っている必要がある、ハズ。
	;　　過去の式は「（使用者の速さ * 10（敵であればさらに+6） / 10 * 100 / 対象の速さ - 200） / 20 +2」
	;　　……使用者の速さが敵の３倍ほどなければいけなかった。
	;////////////////////////////////////////
	;　최대공격횟수
	;　　結果は２～７。
	;　　「MAX(使用者速さ - ターゲット速さ + (使用者が敵であるなら10), 1) / 5 +2」
	;　　７回に到達するためには、味方が使用する場合、速度が25上回っている必要がある、ハズ。
	;　　過去の式は「（使用者の速さ * 10（敵であればさらに+6） / 10 * 100 / 対象の速さ - 100） / 20 +2」
	;　　……使用者の速さが敵の２倍ほどなければいけなかった。
	ELSEIF CFLAG:ARG:입력행동 == 229
		;英訳：Multi-Hit
		;これで『最低回数７』拾えるかなー
		CALL SKILL_MINATTACKNUMBER_229,ARG
		SELECTCASE RESULT
			CASE IS == 7
				PRINTFORML ┃%"백으로 모자란다면…… 충분할 때까지, 쓰러질 때까지……",72,LEFT%┃
			CASEELSE
				PRINTFORML ┃%"쓰러질 때까지 공격하겠습니다……",72,LEFT%┃
		ENDSELECT
	;0230,천열찌르기
	;　＞打撃、威力100*特殊、列、物、消費32　攻撃回数は百烈突き参照
	;　百烈と基本同じ、ただし列攻撃。
	;　これについては、「列の敵それぞれに百烈突きを行う」ようなシステムになっており、
	;　敵ごとに例えば「2.5.7.3.4」回攻撃を行う、というような挙動になる。はず。
	ELSEIF CFLAG:ARG:입력행동 == 230
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"지금부터 저의 몸은 재봉틀의 동류……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Multi-Strike……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"이만큼 찔렀으면 충분하다고 판단합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"천수천창, 들어갑니다……",72,LEFT%┃
		ENDIF
	;0231,타격브레이크
	;0232,타격리플렉트
	;0233,타격드레인
	;0234,타격어택커
	;　このあたりは喰人専用、流石にカット
	;0235,몸통박치기
	;　＞打撃、威力150、単体、物、消費3　CT15
	;　236.押しつぶしに派生
	;　命中70。
	;　まあ消費に見合った強度。命中率が低いけど、極序盤の攻撃としてはまあまあ？
	ELSEIF CFLAG:ARG:입력행동 == 235 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Tackle……",72,LEFT%┃
		;変えようかと思ったけど突撃と同じにした
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"적성 목표에 돌격합니다……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"적성 목표에 눌함(함성 지르며 돌격)합니다……!",72,LEFT%┃
		ENDIF
	;0236,눌러으깨기
	;　＞打撃、威力245、単体、物、消費6　CT15　衝撃SLIP15-30
	;　205.メガトンプレスに派生
	;　中威力単体、SLIP付与。体当たりから派生してくるが、派生的な性能はあんまりしてない。
	;　まあメガトンプレスはもっとしてないわけだけど（全体攻撃）。
	ELSEIF CFLAG:ARG:입력행동 == 236 && CFLAG:807 >= 3
		IF 0
		;信頼系はダメ
		ELSEIF 陥落() && RESULTS != "신뢰" && RAND:3 == 0
			PRINTFORML ┃%CSTR:이인칭 + " 이외의 자를 밀어 넘어뜨리고 싶진 않지만……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"스킬 코드: Squash……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"끌어당겨 넘어뜨리고 짓누르겠습니다……",72,LEFT%┃
		ENDIF
	;0237,베어넘기기
	;　＞打撃、威力180、全体、物、消費12
	;　中威力全体攻撃。
	;　スキルERBによれば「打撃版の回転斬りポジション」「回し蹴りとメガトンプレスの中間」。
	;　回転切りよりコストが結構安く、有能。
	ELSEIF CFLAG:ARG:입력행동 == 237 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Mow Down……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"적성 목표를 쳐내겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"일격필살……로…… 끝나면 좋겠습니다만……",72,LEFT%┃
		ENDIF
	;0238,절묘타
	;　＞打撃、威力320、単体、物、消費11
	;　239.八相発破に派生
	;　単体大ダメージ。命中がちょっと高い分（ギガンフィストは80、こっちは95）消費がちょっと上。
	;実際単体打撃ではあるけど燃費はいいと思う
	ELSEIF CFLAG:ARG:입력행동 == 238 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Brutal Hit……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"이 타격법은…… 최고의 효율을 자랑합니다……",72,LEFT%┃
		;まあ初期インストールで絶妙な打撃入れるってのもどうかなーと思わんでもないが
		ELSE
			PRINTFORML ┃%"프리셋 격투기에 따라 타격하겠습니다……",72,LEFT%┃
		ENDIF
	;0239,팔상발파
	;　＞打撃、威力290、全体、物、消費18
	;　ほぼメガトンプレス
	;　全体打撃、雷震王母より安いが弱いという分かりやすい位置。良スキルであることは変わらない。
	;　あと、「造魔ちゃんがメガトンプレスなんていやだいいやだいうちの造魔ちゃんは小柄で軽いんだい」っていう需要にも。
	;　メガトンプレスとは「名前違いの同型スキル」に近いのだが、こういう事情はあるのだなー。
	ELSEIF CFLAG:ARG:입력행동 == 239
		IF 0
		;『悪徒-ACT-』ていうチャンピオンの漫画があってな。
		ELSEIF RAND:100 == 0
			PRINTFORML ┃%"Do 타 팔상……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"스킬 코드: Hades Blast……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"팔상…… 발파……",72,LEFT%┃
		ENDIF
	;0240,비공찌르기
	;　＞打撃、威力0、単体、物、消費14　打撃即死70-95
	;　かなりの高確率での、打撃即死。
	;　破魔呪殺でない即死は極めてレアで、付与率も高い。
	;　明らかにネタ元が割れてるので普通にネタを入れる
	ELSEIF CFLAG:ARG:입력행동 == 240
		IF 0
;		ELSEIF RAND:8 == 0
;			PRINTFORML ┃%"스킬 코드: Pressure Needle……",72,LEFT%┃
		ELSEIF RAND:7 == 0
			PRINTFORML ┃%"개양의 그림자인 별에…… 수명을 물어보시는 편이 좋을 것으로……",72,LEFT%┃
		;ちなみに原作だと1回しか使用してない、あとアニメ版だと７秒だそうな
		ELSEIF RAND:6 == 0
			PRINTFORML ┃%"이것이야말로…… 조마! 후회를 남기는 주먹……!",72,LEFT%┃
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"지금이야말로 빛나라, 사조성……!",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"목숨줄이란 덧없는 것…… 작별입니다……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"당신에게도 보일 터, 하늘에 빛나는 사조성……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"그 경락, 그 비공…… 찔러 무너뜨립니다……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"당신은…… 이 손가락 하나로 죽는다……!",72,LEFT%┃
		ENDIF
	;0241,헬스트라이크
	;　＞打撃、威力400/360、拡散、物、消費15　呪殺石化30-95
	;　拡散する打撃、追加で石化
	;　標準的なコスパから２歩くらいはみ出したスキルで、かなり強力。
	;　おそらく消費は25～30程度が適正、なのだが、覚えるのがかの公だけ、となれば、納得せざるを得ない。
	;　→公が使った時のみ、安くなるようにしました。
	;　公、SH2で専用スキルに「次の攻撃が確定クリティカル＋기합」効果のスキル持ってきててあまりにも無法だった。あかんでしょ。
	ELSEIF CFLAG:ARG:입력행동 == 241
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Hell Strike……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"그저 동료마의 죽음을 지켜보는 지옥…… 그곳으로, 초대합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"천수천창, 들어갑니다……",72,LEFT%┃
		ENDIF
	;0242,빈사의일격
	;　怒りの鉄拳とまとめました。
	;0243,최후의일격
	;　怒りの鉄拳とまとめました。
	;0244,충의의권
	;　＞打撃、威力特殊、列、物、消費10　※忠誠度に応じて威力変動
	;　「80+（忠誠度または3000の低い方）/15」＝最大威力280。
	;　忠誠度によって威力変化の列攻撃、最大威力ならコスパはいい
	ELSEIF CFLAG:ARG:입력행동 == 244
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Loyalty Fist……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%CSTR:이인칭 + ", 저의 충의를, 보아 주십시오……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"충의를, 보이겠습니다……",72,LEFT%┃
		ENDIF
	;0245,아수라연격
	;　＞打撃、威力130*4、単体、物、消費30
	;　ちなみにというか、速度補正が5ある。本当に早い突き。
	;　/
	;　阿修羅とは、魔界のプリンス。悪魔六騎士のひとり、クモの化身超人。
	;　三面六臂であり、「笑い」「冷血」「怒り」面を切り替えることで戦闘スタイルを切り替えることができる（普段は「笑い」面）
	;　しかし実は３面とも仮面であり、本来の顔は涙を流す喜びの面である。表情がめっちゃ動く仮面について気にしてはならない。
	;　……阿修羅とは、仏教の守護神。ただし、ヒンドゥー教において「アスラ」は魔族の類とされる。
	;　「修羅」という言い方をされるのは、中国語圏では「阿」とは「～ちゃん」に該当するからである。
	;　ほら、三国志の劉禅、幼少期は「阿斗」って呼ばれてたわけですが、「斗ちゃん」って呼ばれ方ってわけな。
	ELSEIF CFLAG:ARG:입력행동 == 245
		IF 0
		;四柱の阿修羅王の名前。
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"라후, 발리, 삼바라 베파치티……!",72,LEFT%┃
		;英訳：Ashura Rengeki
		;…………ン～～～～！！！となるなど。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Ashura Rush……",72,LEFT%┃
		;　若干ジャギ様ネタ
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"이 날렵한 찌르기를 피할 수 있겠습니까……?",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"阿修羅蓮華拳……！",72,LEFT%┃
		ENDIF
	;0246,발칸킥
	;　＞打撃、威力190*3-9、列、物、消費25　単体最大ヒットは３
	;　単発火力が高く、３ヒットで威力合計570という強力な攻撃になる。
	;　速度補正もあったり（+5）。
	;　打撃スキル全体で見ても強力な方。
	;　「バルカン」はおそらく、機関砲の意で使われているのだろう。
	;　この「バルカン」は、「M61」という機関砲の製品名なわけだが、バックホーやホチキスみたいに一般名詞化してしまったやつ。
	;　語源は「Vulcanus」、ウルカヌス、の英語読み。ローマ神話における火の神で、ギリシャ神話ヘパイストスと同一視される。
	;　（ローマ神話とギリシャ神話は、兄弟かってくらいにお互いに影響を与え合っていて、大抵の神さまに対応がある）
	;　ちなみにバルカン半島は「巴爾幹」と書くらしい。へぇー。
	ELSEIF CFLAG:ARG:입력행동 == 246
		IF 0
		;前蹴り回し蹴りカカト落とし後ろ足刀、上中下。
		;アックス：カカト落としのことを「ハンマー」「アックス」キック、という場合があるらしい。
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"프론트, 라운드, 액스, 백, 사이드, 하이·미들·로우……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Vulcan Kick……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"무수무진한 연속 발차기로…… 걷어차 부수겠습니다……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"欧州火薬庫爆撃蹴……！",72,LEFT%┃
		ENDIF
	;0247,관통의일격
	;　＞打撃、威力220、単体、物、消費12　打撃ガーキル
	;　名前の通り、ガーキル効果を持つ。効果はソコソコ。
	;　テトラカーン、打撃無効の壁は貫通できない。
	ELSEIF CFLAG:ARG:입력행동 == 247
		IF 0
		;プリキュア、ではなく、ハートキャッチ（物理）のほう。
		ELSEIF RAND:100 == 0
			PRINTFORML ┃%"자아―― 하트 캐치……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"스킬 코드: Piercing Hit……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"심장 뽑기…… 가져가겠습니다……!",72,LEFT%┃
		ENDIF
	;0248,육탄
	;　＞打撃、威力600、単体、物、消費20　反動
	;　反動ダメージは100％となっており（内部的には「与えたダメージの-100％吸収する」＝「与えたダメージの100％ダメージ」）、
	;　下手に雑魚に使うと自分が即死する。
	;　攻撃面だけを見ると、威力600というキチガイ威力、命中100、コストも安い、という優良さ。コストはおそらく半分ほど。
	;　いやほんと100％反動がキッツぅい！！！
	;　/
	;　SH2では「使うとHPが１になる、消費したHPが多ければ多いほど威力上昇」という効果があり、気合入れたクリティカルとなると、4000くらいダメージが出る。
	;　ちなみにアギダインが頑張って500とかそういう世界である。
	;　気合、回復の手を入れて３手分相当としてもまあおつりがくる威力になっていた。やばい。
	ELSEIF CFLAG:ARG:입력행동 == 248
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"스완 레이크 다이브……!",72,LEFT%┃
		;なんと！人間砲弾。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Human Cannonball……",72,LEFT%┃
		;「육탄」って単語には、ダイの大冒険最終盤の展開が連想されますわね。あんまり見ない単語。
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"이제 육탄전뿐……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"육탄전으로, 상대해 드리겠습니다……!",72,LEFT%┃
		ENDIF
	;0249,코즈이펙트
	;　＞打撃、威力600、単体、物、消費40　CT20　コンセで貫通
	;　★気合コンセで貫通シリーズ
	;　コンセと打撃素質で貫通・壁を無視、超威力。このあたりはホント、相性違いって部分が強い。
	;　物理四種は、魔法型と違って特化育成がやりにくいためか、威力が高い。
	;　意味は……cause and effect、から『原因と結果』？
	;　因果律、とする訳もあり。
	ELSEIF CFLAG:ARG:입력행동 == 249
		;英訳：Innga
		;実に的確だとは思うがそれはそれとして笑ったの巻。
		IF CFLAG:ARG:집중플래그 == 1
			IF RAND:2 == 0
				PRINTFORML ┃%"기구함을 논하며, 요행은 없고, 재앙을 가져온다……",72,LEFT%┃
				PRINTFORML ┃%"――"그대여, 인과를 다스리는 손바닥"……!",72,LEFT%┃
			;「思い信じて打撃すれば、エネルギー保存の法則に従い、いかなるものも打撃力を受ける」。
			ELSE
				PRINTFORML ┃%"굳게 믿고 타격하면…… 인과에 따라, 온갖 것은 타격받는다……!",72,LEFT%┃
			ENDIF
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"한 번, " + CSTR:일인칭 + "의 타격을 맞닥뜨린다면……",72,LEFT%┃
			PRINTFORML ┃%"……즉! 죽음, 뿐이다앗!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"권타로…… 인과를 때려 박겠습니다……!",72,LEFT%┃
		ENDIF
	;0250,지옥찌르기
	;　＞打撃、威力130、単体、物、消費3　神経魔封40-70
	;　CLOSE追加小威力単体攻撃。
	;　突進あたりよりはこっち。消費が軽いわりには神経系のスキルよりなんかいい感じに見えるわね。
	;　偉大なる悪役プロレスラー、“黒き呪術師”「アブドーラ・ザ・ブッチャー」の使用した必殺技が元ネタだろう。
	;　言っちゃえば単なる「喉への貫手」なんだけど、まああの、多分くらったらマジで死ねると思うわねえ。プロレスラーさんすごい。
	;　ちょっと調べてみたら、彼は日本でも2012年までは活動していたらしい。……70歳超えてねーか……？
	ELSEIF CFLAG:ARG:입력행동 == 250 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Hell thrust……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"검은 주술사의 일격을 받아라……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"그 목덜미…… 받아가겠습니다……",72,LEFT%┃
		ENDIF
	;0251,나한장
	;　＞打撃、威力150*2-3、単体、物、消費3
	;　2-3回攻撃、3回攻撃が出れば中々
	;　おそらく達人用で、消費がメチャクソに軽い。
	;　実質的な効果が「たまに威力が1.5倍になる」というあたりも含めると12～15くらいが適正だろうか？
	;　/
	;　羅漢。阿羅漢ともいう。サンスクリット語「arhan」の音写。
	;　この「阿」の欠けは、中国語のアレコレで阿修羅と一緒と思われる。
	;　仏教における、尊敬を受けるに値するほどに極めた聖者のことをいう。
	;　それがなんで物理攻撃ネタになってるのかといえば、おそらく達磨大師と少林拳がネタ……だろうか？
	;　日本でもそうだが、宗教組織は苦行や自衛のために肉体的鍛錬を行うケースがかなり多い。
	;　検索してみると、少林拳ではなさそうな拳法で「나한장」という名のついた技法が結構ある。
	;　（肝心の、メガテン関連が出てこないんだけど……もしかして、リムドラオンと同じくeratenオリジナル？）
	;　ちなみに（日本にある）「少林寺拳法」と「少林寺で学ばれていた少林拳」は別物。
	;　少林拳を学んだ開祖が他の武術と合わせて再編成したのが少林寺拳法である。バキにも出てきてましたね。
	;　まあ、「北斗羅漢撃」がネタもとのような気がしてならんのじゃが。
	ELSEIF CFLAG:ARG:입력행동 == 251
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Arhat palm……",72,LEFT%┃
		;　若干ジャギ様ネタ
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"이 날렵한 찌르기를 피할 수 있겠습니까……?",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"프리셋 격투기를 로드……",72,LEFT%┃
			PRINTFORML ┃%"나한의 타격을…… 재현하겠습니다……",72,LEFT%┃
		ENDIF
	;0252,열진각
	;　＞打撃、威力10、列、物、消費5　打撃感電40-80
	;　達人用。
	;　威力は極めて弱いが、消費が軽く、前列に打撃SHOCK。SLIPとかに変えるべきかも？
	ELSEIF CFLAG:ARG:입력행동 == 252 && CFLAG:807 >= 3
		IF 0
		;ちなみにというか、震脚は習熟していくうち音がしなくなるらしい。
		;「音」になってエネルギーが逃げていくのは当然ながら無駄である。
		;つまるところ、「強く踏みしめ・踏ん張って」力を発するものであるので、スムーズに行えば音をさせなくともいい、ハズ。たぶん。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Quake Foot……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"지면으로의 답격을 행하겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"프리셋 격투기를 로드…… 재현도 300%……",72,LEFT%┃
			PRINTFORML ┃%"열·진각……!",72,LEFT%┃
		ENDIF
	;0253,코크스크류
	;　＞打撃、威力380、単体、物、消費15　CT10
	;　威力380、地味に高い。CTもあり有能。
	;　코크스크류。コルクスクリュー。
	;　主に立ち格闘技で、「腕の回転を大きくする」ブロー。
	;　ぶっちゃけて言えば、単なる正拳突き。「より肩を入れて威力を追求したパンチの打ち方」。
	;　なぜ「スクリュー」かというと、人体構造上、「肩を入れる」と自然と腕が回転する。
	;　やきうでボールに横回転（進行方向と鉛直方向の回転）がかかるのもコレと同じ理由。
	;　じゃあなんでわざわざ「코크스크류」と特別扱いされるかと言うと、逆に言えば、「普段はあまりスクリューしない」わけだな。
	;　肩を入れると当然、引手で「肩を戻す」動きが入って、連打が遅くなるため。ボクシングでは通常行われないわけだ。
	;　メキシカンのパンチは伸びる……というのは、この肩の動きを取り入れているからとされる。
	;　……コークスクリュー風情が、というとアレだけど、人間の技法がここまでの火力になるとは感。他にもっと強そうなのありますのう
	;　効果的に、ハートブレイクショットネタは抜いておく
	ELSEIF CFLAG:ARG:입력행동 == 253
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Corkscrew……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"정권 지르기 동작을 응용…… 주먹을 비틀어 박겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"柔軟性確保……瞬発力増大……",72,LEFT%┃
			PRINTFORML ┃%"권투 기능 풀 로딩…… O.K.",72,LEFT%┃
			PRINTFORML ┃%"……나선권격으로, 꿰뚫어 버리겠습니다……!",72,LEFT%┃
		ENDIF
	;0254,자연난타
	;　＞打撃、威力150*3-5、列ランダム、物、消費14　精神混乱35-70　単体最大ヒットは２
	;　PANIC付与乱舞系攻撃。
