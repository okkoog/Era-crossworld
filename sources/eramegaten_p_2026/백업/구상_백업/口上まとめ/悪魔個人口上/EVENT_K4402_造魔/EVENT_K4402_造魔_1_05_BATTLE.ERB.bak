	;　と、いうか、並みの精神相性攻撃よりいろいろ強いかもしれん。
	;　まあ物理型だと、魔法効果はどうしても低くなる＝状態異常は通しにくくなるんだけども……
	ELSEIF CFLAG:ARG:입력행동 == 39 && CFLAG:807 >= 3
		IF 0
		;LOVEの字切り。
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"내리베기에서 횡베기, 원월의 환혹,",72,LEFT%┃
			PRINTFORML ┃%"가사베기, 역풍, 종일문자 후에 3단 휩쓸기……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Love Heart……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"L·O·V·E의 글자를 새기겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"사랑은 사람을 아름답게 바꾼다고 들었습니다만……",72,LEFT%┃
		ENDIF
	;0040,어둠속의기습
	;　＞剣撃、威力特殊*特殊、単体、物、消費15　CT特殊
	;　月齢０（新月）：命中100、威力200、４回攻撃、クリティカル率25%
	;　月齢その他　　：命中 80、威力200、１回攻撃、クリティカル率5%
	;　月齢８（満月）：命中 80、威力20 、１回攻撃、クリティカル率5%
	;　月夜の餅つき、剣撃・新月版。なんていうか、弱いわけがない
	;　ちなみにクリティカル率については、「運が同じ値の場合」かつ「リベリオンのクリティカル率＋効果がない」場合、
	;　スキルのクリティカル率がほぼそのままクリティカル率になると言ってもいい。
	;　詳しくはリベリオンあたりの追記参照。
	ELSEIF CFLAG:ARG:입력행동 == 40
		;満月。控え目に言ってカス
		IF FLAG:월령 == 8
			IF RAND:4 == 0
				PRINTFORML ┃%"달은, 달은 떠 있습니까……?",72,LEFT%┃
				PRINTFORML ┃%"……네에, 나오고 있네요……",72,LEFT%┃
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"이렇게나, 달이 비추고 있어서는……",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"오늘은 일진이 좋지 않은 것 같습니다……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"달이 아름다운 밤입니다만……",72,LEFT%┃
			ENDIF
		;新月
		;僕は新世界の神になる！
		ELSEIF FLAG:월령 == 0
			IF RAND:4 == 0
				PRINTFORML ┃%"신월·기습, 들어갑니다……",72,LEFT%┃
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"오늘은 절호의 암살 날씨입니다……",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"암·검·살……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"달 없는 밤의 정적에…… 핏방울만이 요동치는 것……",72,LEFT%┃
			ENDIF
		;月齢２～７
		ELSE
			;こちらスネーク。侵入に成功した。
			IF RAND:3 == 0
				PRINTFORML ┃%"스킬 코드: Sneak Attack……",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"달빛이 너무 밝습니다……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"달빛의 사정상, 다소 하기 어렵기는 합니다만……",72,LEFT%┃
			ENDIF
		ENDIF
