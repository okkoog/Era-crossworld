			PRINTFORML ┃%"내일조차 알 수 없는　운명이라 할지라도――",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"작은 노이즈가 마음을 떨리게 해",72,LEFT%┃
			PRINTFORML ┃%"――사슬을 뿌리치고 굴레를 끊어내어",72,LEFT%┃
			PRINTFORML ┃%"절망을 딛고 넘어서　내일을　미래를　붙잡기 위해서――!",72,LEFT%┃
		ENDIF
	;0554,絆の奇跡
	;　＞支援、威力--、全体、--、消費MP0+特殊　バフアリ　使用条件アリ　調教ステータス消費
	;　なんじゃこりゃあ。――というほかない。
	;　完全回復＋全能力最大＋気合い＋コンセ＋クリティカル最大＋全攻撃無効壁１回。コストはゼロ。
	;　使用条件は従順欲望が10。代償は、従順が5に、感覚以外の能力、経験、刻印がゼロに。
	;　そして恋慕系・淫乱系陥落素質の消失。
	;　……あ、ミスかもしれないけど、服従系なら消えないのか。……それはそれで嫌なミスだなあ……！
	;　→服従系、盟友系も消滅するようになっている。
	;　１戦闘のためだけにこのデメリットはちょっと大きすぎる。これ使うくらいなら素直に全滅した方がいいんじゃないかな……効果そのものは破格もいいところ。
	;　色々と縛りを解禁する。
	;　/
	;　……ところでコレ、プラグイン：ソロモンの結婚指輪装備時限定だった気がするので、プラグインを装備できない造魔ちゃんでは使用できない気がするな？
	ELSEIF CFLAG:ARG:입력행동 == 554
		;Miracle of Bonds
		PRINTFORML ┃%"기억영역 파팅…… 전투 데이터, 프리셋 데이터, 대피…… 완료",72,LEFT%┃
		PRINTFORML ┃%"심층 심역 완전 전개…… 주마등 시스템 기동…… 생체 MAG 변환 개시……",72,LEFT%┃
		;恋慕、親愛
		IF TALENT:3 || TALENT:6
			PRINTFORML ┃%"……지금까지의, "" + CSTR:일인칭 + ""은, 사라져 버리겠지만…… 하지만, 그러나……",72,LEFT%┃
			PRINTFORML ┃%"……분명, 다시, " + CSTR:일인칭 + "은…… " + CSTR:이인칭 + "을(를), 좋아하게 될 것입니다",72,LEFT%┃
			PRINTFORML ┃%"왜냐하면, 조마 " + CALLNAME + "은…… 오직, " + CSTR:이인칭 + "만을 위해 만들어진 존재이니까요……",72,LEFT%┃
			PRINTFORML ┃%"……모든 기억을 변환…… O.K. 분배 술식 기동 양호.",72,LEFT%┃
			PRINTFORML ┃%"코드, “유대의 기적”――집행합니다",72,LEFT%┃
		;淫乱、娼婦
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORML ┃%"……유념―― 념(한)이, 남습니다.",72,LEFT%┃
			PRINTFORML ┃%CSTR:이인칭 + "의 약점이나…… 좋아하셨던 체위 등을…… 잊어가겠습니다……",72,LEFT%┃
			PRINTFORML ┃%"……다시, 가르쳐 주신다면, 기쁘겠습니다――",72,LEFT%┃
			PRINTFORML ┃%"……모든 기억을 변환…… O.K. 분배 술식 기동 양호.",72,LEFT%┃
			PRINTFORML ┃%"코드, “유대의 기적”――집행합니다",72,LEFT%┃
		;服従、隷属
		;コクる造魔ちゃん
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORML ┃%"……아아. 분명, "이것"과…… 같은 것은, 얻을 수 없습니다……",72,LEFT%┃
			PRINTFORML ┃%"하지만. 그렇지만…… "이것"을 주신 것은, " + CSTR:이인칭 + "입니다……",72,LEFT%┃
			PRINTFORML ┃%"……그러니, 안녕히. 사모하고, 있었습니다……",72,LEFT%┃
			PRINTFORML ┃%"……모든 기억을 변환…… O.K. 분배 술식 기동 양호.",72,LEFT%┃
			PRINTFORML ┃%"코드, “유대의 기적”――집행합니다",72,LEFT%┃
		;未陥落でも使えるっぽい→使えなくなってた。
		ELSE
			PRINTFORML ┃%"모든 기억을 변환……O.K.　분배 술식 기동 양호.",72,LEFT%┃
			PRINTFORML ┃%"코드, “유대의 기적”――집행합니다",72,LEFT%┃
		ENDIF
	;0555,絆の力
	;　＞支援、威力--、全体、--、消費MP0+特殊　バフアリ　使用条件アリ　調教ステータス消費
	;　全能力上昇。
	;　使用条件は従順欲望が10．代償は、それぞれのレベルが-3。
	;　やはり、１戦闘のためだけにこのデメリットはちょっと大きすぎる。
	;　それはそうといろんなもので従順欲望を３下げる造魔ちゃん
	;　こういうどうでもいいことの積み重ねこそが、大切なものなんだろうな――とか。いかんですね、ぽえみぃ。
	ELSEIF CFLAG:ARG:입력행동 == 555
		;Power of bonds
		;陥落済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8)
			PRINTFORML ┃%"기억영역 파팅…… 기억 영역 한정 전개……",72,LEFT%┃
			;分岐修正が面倒なのでIFは出ないようにする
			IF 0
			ELSEIF RAND:20 == 0
				PRINTFORML ┃%CSTR:이인칭 + "의 요리 데이터를 상기…… 생체 MAG 변환 개시……",72,LEFT%┃
			ELSEIF RAND:19 == 0
				PRINTFORML ┃%CSTR:이인칭 + "의 억지 오기의 데이터를 상기…… 생체 MAG 변환 개시……",72,LEFT%┃
			ELSEIF RAND:18 == 0
				PRINTFORML ┃%CSTR:이인칭 + "의 절정 얼굴 데이터를 상기…… 생체 MAG 변환 개시……",72,LEFT%┃
			ELSEIF RAND:17 == 0
				PRINTFORML ┃%CSTR:이인칭 + "와(과) 하고 싶었던 일의 데이터를 상기…… 생체 MAG 변환 개시……",72,LEFT%┃
			ELSEIF RAND:16 == 0
				PRINTFORML ┃%CSTR:이인칭 + "의 전화번호부 데이터를 상기…… 생체 MAG 변환 개시……",72,LEFT%┃
			ELSEIF RAND:15 == 0
				PRINTFORML ┃%CSTR:이인칭 + "의 볼품없던 때의 데이터를 상기…… 생체 MAG 변환 개시……",72,LEFT%┃
			ELSEIF RAND:14 == 0
				PRINTFORML ┃%CSTR:이인칭 + "이(가) 상냥하게 대해줬을 때의 데이터를 상기…… 생체 MAG 변환 개시……",72,LEFT%┃
			ELSEIF RAND:13 == 0
				PRINTFORML ┃%CSTR:이인칭 + "의 귀축 소행 데이터를 상기…… 생체 MAG 변환 개시……",72,LEFT%┃
			ELSEIF RAND:12 == 0
				PRINTFORML ┃%CSTR:이인칭 + "의 재미없었던 농담 데이터를 상기…… 생체 MAG 변환 개시……",72,LEFT%┃
			ELSEIF RAND:11 == 0
				PRINTFORML ┃%CSTR:이인칭 + "의 파안대소하던 얼굴 데이터를 상기…… 생체 MAG 변환 개시……",72,LEFT%┃
			ELSEIF RAND:10 == 0
