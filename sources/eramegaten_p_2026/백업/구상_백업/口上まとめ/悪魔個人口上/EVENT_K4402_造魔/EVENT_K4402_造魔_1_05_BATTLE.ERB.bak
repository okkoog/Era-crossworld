	;0819,코큐토스
	;　＞氷結、威力470、単体、魔、消費32　氷結凍結30-95
	;　リムドーラ系の、特大ダメージ単体攻撃。
	;　/
	;　コキュートスはギリシャ神話、地獄の最下層に流れる川の名前。「嘆きの川」、「悲嘆」を意味する。
	;　ダンテの「神曲」にて語られ、そこでは「裏切りの罪」を犯した者が永遠に氷漬けになっているという。
	;　聖闘士が首だけ出して凍ってる場所でもある。
	;　悔いる場所って煉獄だった気がするがまあ気にするでない。
	ELSEIF CFLAG:ARG:입력행동 == 819
		IF 0
		;『堕天作戦』、再開しないかなぁ……
		;あ、コサイタス、は、コキュートスってことよん。
		;→雑誌媒体では再開できなかったようだが、復活する。
		;――生き返った気分だ。
		ELSEIF RAND:100 == 0
			PRINTFORML ┃%"冷却……冷却……氷獄再現……",72,LEFT%┃
			PRINTFORML ┃%"자 보아라, 코퀴토스의 제로 선풍……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Cocytus……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"지옥의 제9층…… 비탄의 강의 재현을 행합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"비탄의 강에서 그 일생을 후회하시는 편이 좋을 듯합니다만……",72,LEFT%┃
		ENDIF
	;0820,아이시클
	;　＞氷結、威力190/85、拡散、物、消費18　氷結凍結/30-95
	;　アイスブレスの1.5倍……消費は3倍。ウーン
	ELSEIF CFLAG:ARG:입력행동 == 820
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Icicle……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"아이시클 스트라이크……",72,LEFT%┃
		;『ニンジャスレイヤー』より、トゥララ・ニンジャ。
		;「つらら・ニンジャ」と思しい。強大なリアルニンジャ。
		ELSE
			PRINTFORML ┃%"고드름 형성…… 파쇄, 낙하시킵니다……",72,LEFT%┃
		ENDIF
	;0821,로마・그랜드
	;　＞氷結、威力特殊、全体、魔、消費12　※残HPにより、1-651まで変動　氷結凍結/15-95
	;　ネミッサ専用スキル・氷結バージョン。
	;　調べたところ、おそらくラテン語で「인간」「雹・霰」という意味。
	;　HPを削らないとイマイチ……っていうかかなり産廃なので、ぶっちゃけ忘れさせちゃっていいと思う。
	;　HP系のは使いにくいのよねぇ……
	;　★チェック　あとでパッチだします
	;　　ＨＰで威力が変わるのはいいんだが、「624-651」「256-476」「92-176」「1-55」と段階に応じてガクッと威力が変わるの、正直良くないと思う。
	;　　「第一段階でやや弱い」「第二段階でやや強い」くらいの調整が好かろうな。
	;　　具体的には、最大威力忠義の氷結の上下くらいの調整だろか。
	;　　（忠義シリーズはかなり強い調整だが、こちらも専用技であるので、そのくらいの調整がよかろう）
	ELSEIF CFLAG:ARG:입력행동 == 821
		;Roma Grando
		SELECTCASE BASE:ARG:ＨＰ * 100 / MAXBASE:ARG:ＨＰ
			;HP0～4％。
			;「1 + 650 * (100 - 残HP割合) / 100」＝威力624-651。氷結全体攻撃トップの威力。
			CASE IS < 5
				PRINTFORML ┃%CSTR:일인칭 + "의, ……얼어붙은 분노를 받아라……!",72,LEFT%┃
			;HP49～5％。
			;「1 + 500 * (100 - 残HP割合) / 100」＝威力256-476。さすがにここまでくるとだいぶ強い。
			CASE IS < 50
				PRINTFORML ┃%"분노를 의사 재현…… 얼음의 분노를 눈보라로 바꾸어……",72,LEFT%┃
			;HP50～74％。
			;「1 + 350 * (100 - 残HP割合) / 100」＝威力92-176。最大威力忠義の氷結のほうがマシ。
			CASE IS < 75
				PRINTFORML ┃%"분노……는 원래 없습니다만…… 불쾌, 정도는 이해할 수 있습니다……",72,LEFT%┃
			;HP75％～100％。
			;「1 + 225 * (100 - 残HP割合) / 100」＝威力1-55。COOPトスにしかならない。
			CASEELSE
				PRINTFORML ┃%"분노……는 원래 없습니다만……",72,LEFT%┃
		ENDSELECT
	;0822,사부사부드릴
	;　＞氷結、威力145、単体、物、消費3　氷結凍結/100-100
	;　敵専用……フラグは立ってないが、実質的P2ハンニャ校長専用。
	;　消費のわりにかなり強力。驚異の基礎状態付与率100が目に付く。
	ELSEIF CFLAG:ARG:입력행동 == 822
		IF 0
		;英訳では「Chill Drill」だったが「さぶさぶ」感を出したかった
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Chill Chill Drill……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"드릴 구축…… 돌관합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"빙결 필드 다중 전개…… 나선 압축……",72,LEFT%┃
			PRINTFORML ┃%"“콜드 한냐 드릴”…… 이그니션……!",72,LEFT%┃
		ENDIF
	;0823,극한동결
	;　＞氷結、威力480、列、魔、消費50　神経魔封/40-95
	;　神経でCLOSE追加。確率は基本40の限界95。
	;　列特大威力。威力は非常に高いが、かなりコストは重い。CLOSE付与攻撃はわりとすくないので貴重ではある。
	ELSEIF CFLAG:ARG:입력행동 == 823
		IF 0
		;オーロラ＝極光と言います。
		;見開きドカンドカンと好きだった
		;この「枠外に必殺技の文字がドカン」演出、近年の作品だと、『血界戦線』、あたりが有名どころだろうか。
		;この岡田芽武という漫画家さんのが元……とか、見たような。
		;あるいはさらにその前の、『リングにかけろ』『聖闘士星矢』の「スミフキダシ」の必殺技シャウトが源流にある……と見たような。
		ELSEIF RAND:100 == 0
			PRINTFORML ┃%"　　　　　　 ｱ　",72,LEFT%┃
			PRINTFORML ┃%"　ｴ　　　　極ｳ　",72,LEFT%┃
			PRINTFORML ┃%"　ｸ　　　　　ﾛ　",72,LEFT%┃
			PRINTFORML ┃%"　ｽ　　　　光ﾗ　",72,LEFT%┃
			PRINTFORML ┃%"　ｷ処　　　　　 ",72,LEFT%┃
			PRINTFORML ┃%"　ｭ　　　　　　 ",72,LEFT%┃
			PRINTFORML ┃%"　|刑　　　　　 ",72,LEFT%┃
			PRINTFORML ┃%"　ﾄ　　　　　　 ",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Extreme Cold……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"극한의 빙하에 잠기는 편이 좋을 듯합니다만……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"이 극광으로 처형하겠습니다……!",72,LEFT%┃
		ENDIF
	;0824,충의의빙결
	;　＞氷結、威力特殊、全体、魔、消費13　※忠誠度に応じて威力変動　氷結凍結/15-95
	;　「56+（忠誠度または3000の低い方）/15」＝最大威力256。
	;　忠誠度によって威力変化の全体攻撃、最大威力ならコスパはいい
	ELSEIF CFLAG:ARG:입력행동 == 824
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Loyal Ice……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%CSTR:이인칭 + ", 저의 충의를, 보아 주십시오……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"충의를, 보이겠습니다……",72,LEFT%┃
		ENDIF
	;0825,아이스에이지
	;　＞氷結、威力550、単体、魔、消費40　条件付き貫通
	;　★気合コンセで貫通シリーズ
	;　実はFREEZEの追加はない。
	;　魔法攻撃だが気合＋氷結素質で貫通。なんで……
	ELSEIF CFLAG:ARG:입력행동 == 825
		IF CFLAG:ARG:気合フラグ == 1
			;アイスエイジと言えば。
			IF RAND:10 == 0
				PRINTFORML ┃%"빙하기에 번영을 누렸던 자여……",72,LEFT%┃
				PRINTFORML ┃%"그 자야말로 공포의 표출자, 거흉이자 재액의 권화……!",72,LEFT%┃
				PRINTFORML ┃%"빙상을 부수고 지금이야말로 오라――“Scaled Wurm”……!",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"절념의 극치, 유명(幽冥)을 품은 절망의 겨울 별……",72,LEFT%┃
				PRINTFORML ┃%"――“그대, 잃어버린 색채의 매듭”……!",72,LEFT%┃
			;まじめなほう
			;……とは言いつつ、FGOみたいな演出が入ると思ってください。Fateネタ改変だしね。
			;ちなみに現在の地球も氷河期である。
			;氷河期とは、「北半球にも南半球にも氷床がある」状態のことを言い、……まあ、北極と南極があるよね。
			;特に北極は大陸ではなく、「巨大な氷の塊」であるからして。
			;どうして変化するの？　っていうと。
			;・大陸移動とかの関係で海流が変わって、極にあったかい海流が行かなくなるから
			;・公転運動が変化し、地球と太陽の距離がちょっと離れるから
			;・自転軸が変化し、北/南側に太陽が当たらなくなり、冬が厳しくなるから
			;……などの説がある。
			;で、現在は氷河期の中でも比較的暖かい、間氷期、という期間とされる。
			;下で言ってる「クライオジェニアン/Cryogenian(Cryos、氷、Genesis、誕生)」は、赤道まで氷床が達した時期のことを言う。
			;地球のほぼ全土が凍結したとされるが、火山活動が活発になった拍子に温室効果ガスが何とかしてくれたらしい。あと隕石って説もある。
			;ちなみに生き物は火山の周りでギリッギリ生きてたようですよ。
			ELSE
				PRINTFORML ┃%"이승에 존재하는 지옥 중 하나, 유전자에 새겨진 고대의 신화",72,LEFT%┃
				PRINTFORML ┃%"물을 두른 이 별이 하얗게 갑옷을 입고 있던 시절――",72,LEFT%┃
;				PRINTFORML ┃%"　　　　　　　ﾎ ｼ　　　　　 ",72,LEFT%┃
				PRINTFORML ┃%"생명을 품은 이 행성이 생명의 존재를 허락하지 않았던 시절!",72,LEFT%┃
;				PRINTFORML ┃%"　　　ｱｲｽｴｲｼﾞ,ｸﾗｲｵｼﾞｪﾆｱﾝ　　 ",72,LEFT%┃
				PRINTFORML ┃%"――“생명이 얼어붙는 절멸의 별”――!",72,LEFT%┃
			ENDIF
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Ice Age……！",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"빙하여 오라, 지금 이 하늘에……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"지금부터―― 생명의 존속은 인정되지 않습니다――!",72,LEFT%┃
		ENDIF
	;0831,빙결가드킬
	;　＞氷結、威力0、単体、魔、消費20
	;0832,빙결가드브레이크
	;　＞氷結、威力0、単体、魔、消費55
	;　敵の氷結耐性を無効化する、キルは単体3Tブレイクは全体2T
	ELSEIF CFLAG:ARG:입력행동 == 831 || CFLAG:ARG:입력행동 == 832
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Ice Guard Break……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"障壁冷却……強制停止……O.K.",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"強制冷却……対応力停止……",72,LEFT%┃
		ENDIF
	;0833,빙결브레이크
	;0834,빙결리플렉트
	;0835,빙결드레인
	;0836,빙결어택커
	;　このあたりは喰人専用、流石にカット
	;0837,성소녀의창끝
	;　＞氷結、威力320、全体、魔、消費50　氷結凍結/50-95　バフアリ
	;　セプテントリオン、スピカ専用。……敵専用？知らん
	;　ブフダイン全体版＋命中回避１段ダウン。
	;　/
	;　――スピカ。おとめ座α星。
	;　21ある1等星がひとつ、春の夜空に青白く輝くもの。真珠星。
	;　スピカとは「穀物の穂先」をさす。英語で言うと、「Spike」。
	;　星の・乙女の・穂先……ということだね。
	;　ちなみに日本ではぜんっぜん呼ばれ方が有名でなく。
	;　「野尻抱影」というひとが、メチャクソ苦労して方言から「しんじぼし」というのを探し出して、
	;　「たぶん真珠の星ってことやろ！」って名付けたんだとか。
	;　ちなみにこの野尻さんは冥王星の名付け親でもある。
	;　/
	;　ちなみにN等星、というのは「明るさのパワー」を表現したものであり、普段使うセルシウス温度（摂氏）と同じく、「ゼロ以下」がありえる。
	;　星の場合、「特に明るいやつを１として、そっから対数的に小さいやつを２、３……」と定義づけているだけなので、夜空の星々よりすっげー明るい太陽は、
	;　ゼロを通り越してマイナス26.7等星まで行く（もちろん、見た目上の等級である。実際同じ距離で見ると太陽より数千倍明るい星々が多数存在する）
	ELSEIF CFLAG:ARG:입력행동 == 837
		IF 0
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"데몬스트레이트: Icicle Goddess……",72,LEFT%┃
		;スピッツのスピカって曲が大好きでねぇ
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"남쪽으로 향하는 바람은 벼를 흔들고 소녀는 이삭을 안고 미소 짓겠지요……",72,LEFT%┃
			PRINTFORML ┃%"오래된 별의 빛이 당신들을 비춘다……!",72,LEFT%┃
		;野尻さんは「星まんだら」という本を出版している。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"이것이야말로 별의 만다라, 전천 21개의 일등성 중 하나.",72,LEFT%┃
			PRINTFORML ┃%"봄 밤하늘에 푸르스름하게 빛나는 진주의 이삭……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"절대 정지의 대기 속…… 빙화는 마치 별(스텔라)처럼……",72,LEFT%┃
			PRINTFORML ┃%"이 창은 모든 것을 멈춥니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"빙결 압축…… 창 형태 형성…… 투척합니다",72,LEFT%┃
		ENDIF
	;0838,한숨
	;　＞氷結、威力210*2-5、全体ランダム、魔、消費20　単体最大ヒットは3　氷結凍結/45-95
	;　FLEEZE追加。確率は基本45の限界95。
	;　デモニホ専用。乱舞より回数が少ない分威力が高い。最大威力は600オーバーと、実はメチャクチャ高かったりする。
	;　作るのがクソめんどくさいデモニホからわざわざ引き継ぐか……？というところはある。
	ELSEIF CFLAG:ARG:입력행동 == 838
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Sigh……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"얼어붙은 숨결을 내뿜겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"겨울의 숨결, 행사합니다……",72,LEFT%┃
		ENDIF
	;0839,부흐바리온
	;0840,마하・부흐바리온
	;　上で書き申した。
	;その他汎用
	;オブオール書いた
	ELSEIF CFLAG:807 >= 3
		PRINTFORML ┃%LOCALS + "(으)로 동결시키겠습니다……",72,LEFT%┃
	ENDIF

;-------------------------------------------------
;○전격
;基本的に自分用。毎回ジオダインを引き継がせるのがジャスティス。序盤の必殺技っ
;雷ってかっこええやん？
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,901, 999)
	IF 0
	;0901,지오
	;0902,지온가
	;0903,지오다인
	;0951,지오바리온
	;　＞電撃、威力130、単体、魔、消費4　電撃感電/20-95
	;　＞電撃、威力225、単体、魔、消費8　電撃感電/20-95
	;　＞電撃、威力320、単体、魔、消費15　電撃感電/20-95
	;　＞電撃、威力410、単体、魔、消費25　電撃感電/20-95
	;0904,마하・지오
	;0905,마하・지온가
	;0906,마하・지오다인
	;0952,마하・지오바리온
	;　＞電撃、威力120、列、魔、消費7　電撃感電/15-95
	;　＞電撃、威力200、列、魔、消費15　電撃感電/15-95
	;　＞電撃、威力295、列、魔、消費26　電撃感電/15-95
	;　＞電撃、威力380、列、魔、消費36　電撃感電/15-95
	;　こうしてみるとコスパが微妙だなぁ……
	;　ちなみにマハ系は命中90と命中不安だったりする。
	ELSEIF GROUPMATCH(901, 902, 903, 951, 904, 905, 906, 952) && CFLAG:807 >= 3
		;半分で通常・範囲共通
		IF RAND:2 == 0
			PRINTFORML ┃%"電撃術詠唱……" + LOCALS + "……",72,LEFT%┃
		;単体
		ELSEIF GROUPMATCH(901, 902, 903, 951)
			IF RAND:3 == 0
				PRINTFORML ┃%"뇌광으로 일격하겠습니다……",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"번개로 공격합니다……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"자전으로 쓰러뜨리겠습니다……",72,LEFT%┃
			ENDIF
		;範囲
		;　マハジオ系はちょっと広範囲な言い回し
		ELSE
			IF RAND:3 == 0
