		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"九十九条螺旋軌道撃……！",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"참격 패턴 99, 랜덤 스트라이크……!",72,LEFT%┃
		ENDIF
