;=================================================================================
;●スキル系戦闘口上
;＊＊＊だいたいぜんぶ書いた＊＊＊
;=================================================================================
@K[[キャラ:조마]]_1_BATTLE_MESSAGE,ARG,ARG:1 = 0
#DIM MEMO_LINECOUNT

	;行数をカウントし、1行も増えていなければカッコを消す
	;era悪魔でメイドchの皆様にご協力いただきました。感謝を！！！
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	MEMO_LINECOUNT = LINECOUNT
	CALL K[[キャラ:조마]]_1_BATTLE_COMMAND,ARG,ARG:1

	;行が増えてたら下カッコを追加
	IF LINECOUNT > MEMO_LINECOUNT
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ELSE
		CLEARLINE 1
	ENDIF




@K[[キャラ:조마]]_1_BATTLE_COMMAND,ARG,ARG:1
#DIM ATK_TARGET
#DIM 忠誠度上昇か



	忠誠度上昇か = ARG:1

	;ターゲットを取っておく
	ATK_TARGET = CFLAG:ARG:타겟
	CALL GET_SKILL_PROP, "SKILL_NAME", CFLAG:ARG:입력행동, ARG
	;使用したスキルの名前をLOCALSに代入
	LOCALS = %RESULTS%
	;↑汎用少女口上からお借りしました/メアリの人　　←メアリ口上からお借りしました/造魔口上加筆した人

	;ターゲット先のポジションを参照するための変数。FLAG:とあわせて使う。←こだいちゃん口上からお借りしました
	LOCALS:1 = 포지션{(CFLAG:ARG:타겟)}

;-------------------------------------------------
;○予備用/テンプレ
;選択したコマンドにより分岐させたい場合、IF文の条件にコマンドNoを記入すること
;-------------------------------------------------
;IF CFLAG:ARG:입력행동 == XXXX
;	PRINTFORML ┃%"",72,LEFT%┃

;以下、コマンド系口上。以下を表示した後で↑のが出る感じです。COOP口上とか分かりやすいと思う。



;-------------------------------------------------
;コメントアウト用ダミー
;コレの対は、「もうずーっと下の下の下」で検索してほしい。
;-------------------------------------------------
IF 0

;-------------------------------------------------
;状態異常時
;-------------------------------------------------
;魅了時
ELSEIF CFLAG:ARG:상태이상 == GET_STATE_NUM("CHARM")
	IF 0
	;行動不能（ムラムラしている）
	ELSEIF CFLAG:ARG:입력행동 == 2314
		IF 0
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"몸이…… 뜨거워……!?",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"안 돼, 요, 윽……!?",72,LEFT%┃
		ENDIF
	ELSE
		PRINTFORML ┃%"……핫. 해, 행동하겠습, 니까?",72,LEFT%┃
	ENDIF
;混乱時
ELSEIF CFLAG:ARG:상태이상 == GET_STATE_NUM("PANIC")
	;금전뿌리기
	IF CFLAG:ARG:입력행동 == 2315
		IF 0
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"가난, 해? 그럼? 주지 않으면……?",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"시주하겠습니다……???",72,LEFT%┃
		ENDIF
	;行動不能（ぼんやりしている）
	ELSEIF CFLAG:ARG:입력행동 == 2314
		IF 0
		;カッコカワイイ宣言！！！
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"아…… " + CSTR:이인칭 + ", 멋지고 귀여워……?",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"하와와…… 몽글몽글……",72,LEFT%┃
		ENDIF
	ELSE
		PRINTFORML ┃%"……핫. 해, 행동하겠습, 니까?",72,LEFT%┃
	ENDIF
;幸福時の行動不能
ELSEIF CFLAG:ARG:상태이상 == GET_STATE_NUM("HAPPY") && CFLAG:ARG:입력행동 == 2314
	;自分の体をまさぐっている(発情中+ムフフ展開時のみ)
	IF 위험일(ARG) == 2 && FLAG:무후후전개
		PRINTFORML ┃%"우, 아아, " + CSTR:이인칭 + ", " + CSTR:이인칭 + "……윽",72,LEFT%┃
	ELSE
		PRINTFORML ┃%"행, 행복을, 거부, 하겠…… 으아……",72,LEFT%┃
	ENDIF


;-------------------------------------------------
;○ATTACK
;通常攻撃の方から色々パクっｔ……拝借しｔ……参考に。
;意外と喋らせにくい……ので、だいたいコンパチ。
;地味ながら、全体飛具とかにしておくと序盤便利です。
;-------------------------------------------------
ELSEIF CFLAG:ARG:입력행동 == 0 && CFLAG:807 >= 4
	IF 0
	ELSEIF !RAND:3
		PRINTFORML ┃%"통상 공격을 행하겠습니다……",72,LEFT%┃
	ELSE
		;攻撃の名称を取得
		CALL GET_SKILL_PROP, "SKILL_NAME", 0, ARG
		SELECTCASE RESULTS
			CASE "찰싹찰싹 때린다"
				IF 0
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"찰싹찰싹 때리겠습니다……",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"스킬을 쓰지 않고 공격하겠습니다……",72,LEFT%┃
				ENDIF
			CASE "덥석덥석 문다"
				IF 0
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"덥석덥석 물겠습니다……",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"스킬을 쓰지 않고 공격하겠습니다……",72,LEFT%┃
				ENDIF
			CASE "콕콕 찌른다"
				IF 0
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"콕콕 찌르겠습니다……",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"스킬을 쓰지 않고 공격하겠습니다……",72,LEFT%┃
				ENDIF
			CASE "따끈따끈 두들긴다"
				IF 0
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"어쨌든 두들기겠습니다……",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"스킬을 쓰지 않고 공격하겠습니다……",72,LEFT%┃
				ENDIF
			;ATTACK
			CASEELSE
				SELECTCASE ABL:ARG:공격범위
				;列
				CASE 2
					IF 0
					ELSEIF RAND:2 == 0
						PRINTFORML ┃%"적성 목표를 쓸어버리겠습니다……",72,LEFT%┃
					ELSE
						PRINTFORML ┃%"적성 목표를 쳐내겠습니다……",72,LEFT%┃
					ENDIF
				;全体
				;敵が全体か判定できない気がしたんで
				CASE 3
					IF 0
					ELSEIF RAND:2 == 0
						PRINTFORML ┃%"적성 목표를 쓸어버리겠습니다……",72,LEFT%┃
					ELSE
						PRINTFORML ┃%"적성 목표를 쳐내겠습니다……",72,LEFT%┃
					ENDIF
				;単体対象……ならこれでいいはず
				CASEELSE
					IF 0
					ELSEIF RAND:2 == 0
						PRINTFORML ┃%"전투를 행하겠습니다……",72,LEFT%┃
					ELSE
						PRINTFORML ┃%"적성 목표를 쳐내겠습니다……",72,LEFT%┃
					ENDIF
				ENDSELECT
		ENDSELECT
	ENDIF
;-------------------------------------------------
;○ＣＨＡＮＧＥ
;こだいちゃん口上は偉大だぜ……
;-------------------------------------------------
ELSEIF CFLAG:ARG:입력행동 == 2301 && CFLAG:807 >= 4
	;相手が"あなた"
	IF FLAG:(LOCALS:1) == MASTER
		;前に出る
		IF RANGE((CFLAG:ARG:포지션),4,6) && RANGE((CFLAG:ARG:타겟),1,3)
			IF RAND:2 == 0
				PRINTFORML ┃% CSTR:이인칭 + ", 물러서 주십시오……",72,LEFT%┃
			ELSE
				PRINTFORML ┃% CSTR:이인칭 + ", " + CSTR:일인칭 + "이(가) 앞으로 나서겠습니다……",72,LEFT%┃
			ENDIF
		;後ろに下がる
		;後ろに下がる＝主を矢面に立たせる、でも戦略上正しいｳﾎﾞｧ！みたいな葛藤
		ELSEIF RANGE((CFLAG:ARG:포지션),1,3) && RANGE((CFLAG:ARG:타겟),4,6)
			IF RAND:2 == 0
				PRINTFORML ┃% CSTR:이인칭 + " 면목 없습니다, 교대를……",72,LEFT%┃
			ELSE
				PRINTFORML ┃% CSTR:이인칭 + ", 앞을, 부탁드립니다……",72,LEFT%┃
			ENDIF
		;横移動、になる筈
		ELSE
			IF RAND:2 == 0
				PRINTFORML ┃% CSTR:이인칭 + ", 이쪽으로……",72,LEFT%┃
			ELSE
				PRINTFORML ┃% CSTR:이인칭 + ", 이동을 부탁드립니다……",72,LEFT%┃
			ENDIF
		ENDIF
	;相手が他の造魔
	ELSEIF FLAG:(LOCALS:1) != -1 && NO:(FLAG:(LOCALS:1)) == [[キャラ:조마]]
		PRINTFORML ┃%"역할을 교대하겠습니다……",72,LEFT%┃
	;以下、MASTER、造魔以外と場所を交代する場合。空白地含む。
	ELSEIF RAND:4 == 0
		PRINTFORML ┃%"이동하겠습니다……",72,LEFT%┃
	ELSEIF RAND:3 == 0
		PRINTFORML ┃%"교대합니다……",72,LEFT%┃
	ELSEIF RAND:2 == 0
		PRINTFORML ┃%"역할을 준수하겠습니다……",72,LEFT%┃
	ELSE
		PRINTFORML ┃%"대열을 재편성합니다……",72,LEFT%┃
	ENDIF

;-------------------------------------------------
;●造魔ちゃんのスキル解説
;-------------------------------------------------
;　小威力：おおむね威力180以下くらい。極小となると100未満。
;　中威力：おおむね威力200～280くらい。
;　大威力：おおむね威力300～380くらい。ダイン系は下限に引っかかるくらい？クレミはギリッギリ特大威力な風味。
;　特大威力：おおむね400以上。
;　超特大：おおむね500以上。
;　/
;　各種スキルについては下記のように表記したい。
;　＞相性、威力、範囲、物魔、消費　CT　相性/状態異常/基礎付与率/付与率上限
;　例：火炎、威力200、拡散、物、消費15　CT30　火炎炎上30-50
;　火炎相性の威力200の拡散物理攻撃、クリティカル率30で消費15、火炎相性で炎上を30%で与え、知恵などのブーストでも50％が上限。となる。
;　範囲については、単体、拡散、列、全体、全体ランダム、敵味方全体、自身。
;　/
;　命中については、90-120くらいのは表記しない。
;-------------------------------------------------

;-------------------------------------------------
;○검격
;　シンプルなスキルが非常に多いが、実は派生があまりなかったりする。
;　飛具の九十九針系や、打撃のパンチ・キック系、戦技のひっかき系のような系統がない。
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,1, 99) && CFLAG:807 >= 2
	IF 0
	;0001,산바람
	;　＞剣撃、威力130、単体、物、消費2
	;　通常攻撃よりはマシ。
	;　基本的に物理系スキルは派生が少ないので、できればスキルカードを集めたいトコロ。
	;　元ネタは不詳。「山おろし」、山から吹きつけてくる風、あるいはそれをモデルにした妖怪と思われるが……
	;　/
	;　――とまあ、こーんな感じで解説を入れていきます。
	;　強さについては「これより強い別スキルを忘れてる」とか「体調や気分」とかで評価が上下する場合が結構あるのであんまりアテにしないように。
	;　（とはいえ、「最強クラス」というスキルはさすがに間違えてないと思うけど）
	;　/
	;　――さらに、元ネタを探したり、連想したりしたことをメモっても行きます。
	;　口上書くときの調べもののメモって感じですね。
	;　このヤマオロシでは「だし風の如く」ってのが、調べものした結果の口上。
	ELSEIF CFLAG:ARG:입력행동 == 1 && CFLAG:807 >= 3
		;以下、英語版eraMegatenのスキル名なども使っていきます。翻訳スゲー
		;普通っぽいのは「スキルコード：」とつける
		;「オぺレート」、「外科的に対処」くらいの意味合いにしてたんだけど変更
		;強めのは「デモン ストレート：」……「実演」、技としてランクが高めであるため。
		;あと「デモン」が「デーモン」に似てるから。カタカナの字面だけで言えば。
		;バーストコード、とかの「●●コード」にするのも考えたけどどうしよっかなーという感じー。
		;あとは思いついたら別のにする
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Mighty Gust……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"몰아치는 돌풍처럼 내리치겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%LOCALS + "(으)로 베어 버리겠습니다……",72,LEFT%┃
		ENDIF
	;0002,히트웨이브
	;　＞剣撃、威力195、列、物、消費10
	;　列剣撃。ンまあ普通の攻撃。速度補正が地味にある。
	;　ちなみに古代ちゃんが使うと「ヒートウェーブ」になり、射程がちょびっと上昇する。
	ELSEIF CFLAG:ARG:입력행동 == 2 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%LOCALS + "(으)로 쓸어버리겠습니다……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Heat Wave……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"히트 웨이브, 들어갑니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%LOCALS + "(으)로 베어 넘기겠습니다……",72,LEFT%┃
		ENDIF
	;0003,회전베기
	;　＞剣撃、威力185、全体、物、消費16
	;　全体剣。산바람＞히트웨이브＞コレ、と、MPの増え方がわかりやすい。消費が倍になると虚空斬波。
	;　ランク的には利剣→回転切り→木っ端微塵切り→虚空ザッパー。
	ELSEIF CFLAG:ARG:입력행동 == 3 && CFLAG:807 >= 3
		IF 0
		;おそらく世界で一番有名な回転斬りの使い手は、『ゼルダの伝説』主人公、リンクだろう。
		;ほぼすべてのシリーズで使用する技で、SFC以前の作品ではビミョーにカッコ悪かったが、3D作品になってからは格好良くなったと思う。
		;上必殺技で飛び上がったりする。
		;「しぇあああああ！」ってここでも言わせようかと思ったが、さすがに造魔ちゃんのキャラではないよなあ……と没になったのであった。
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"회전베기로…… 베어 넘기겠습니다……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Spin Slash……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"목을 날려, 굴려서 회전시키겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"블레이드 연장…… 도약하여, 회전합니다……",72,LEFT%┃
		ENDIF
	;0004,양팔찍기
	;　＞剣撃、威力120*1-3、単体、物、消費5
	;　1-3回攻撃。最大威力を夢見るとコスパはいいが、ちょっと安定しない。入れ替え推奨。
	;　2回攻撃はまあいいとして、3回目はどこを斬るんだろう。
	;　右手！　左手！　左手斬り損ねたので肩口からきちんと切ります！……とか？
	;　ちなみに、ダメージ計算の都合上、威力360*1と威力120*3は、総ダメージが変わらない。※計算中の切り捨てで変わることはあるよ
	;　当然、分割のほうが当たりやすく、クリティカルも出やすいので、同じ威力なら多段攻撃を選んだ方がよいハズ。
	ELSEIF CFLAG:ARG:입력행동 == 4 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"양손 모두 거두어가겠습니다……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Arm Chopper……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"당신에게 사지는 필요 없습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"당신에게는, 팔도 다리도 목숨도 불필요할 것으로……",72,LEFT%┃
		ENDIF
	;0005,대나무베기
	;　＞剣撃、威力405、単体、物、消費16
	;　命中の低い（70）大ダメージ攻撃。どうせなら天驚を使いたい。
	ELSEIF CFLAG:ARG:입력행동 == 5
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"당죽양단, 일도 쪼개기……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Bamboo Slice……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"정면에서, 일도양단하겠습니다……!",72,LEFT%┃
		;「一文字」と「１文字」
		ELSE
			PRINTFORML ┃%"정면에서 "일문자"로 내리베겠습니다……",72,LEFT%┃
		ENDIF
	;0006,허공참파
	;　＞剣撃、威力410、全体、物、消費35
	;　★デッドリーバーン系
	;　大威力全体剣技。消費がややキツいものの、強い。というか命中考えると『通常技』の範疇では最強クラスである。
	;　入手は高レベルになるがそう難しくない。扱いやすいスキルと言える。
	;　ド安定、と言いたいところだが、実は速度補正にマイナスがある。
	;　/
	;　相性違いのほぼ同一性能のスキルも多い。
	;　もちろん相性以外完全一致ではなく、虚空ザッパーはほんのりスペックが高い。
	;　デッドリーバーンは実は威力420だったりするので、「シリーズ」と言えるほどではないかもだが。
	;　ともあれ、「全体・特大威力・効果は特別なものでない」シリーズ。
	;　ホントはたぶん、「メギドラオン互換」系……とでもしたほうがよさそう
	;　/
	;　ほかのシリーズデッドリーバーンは以下の通り。
	;　검격　　：0006.허공참파			消費35
	;　비구　　：0107.고천열풍탄		消費38	上位：0139.旋回速弾（威力490
	;　타격　　：0207.뇌진왕모의발차기	消費38
	;　전술　　：0326.베어먹기			消費34	上位：0356.応龍撃破（威力510）
	;　화염　　：0711.데들리번	消費40	上位：0755.マララギダイン（CHARM付与）、749.プロミネンス（威力480）、760.빛나는불꽃
	;　빙결　　：0811.릴리즈제일	消費44	FREEZE付与
	;　　　　　　　※通常入手不可？　0814.ニブルヘイム（威力395）かクレセントミラー（威力380）しかないかも
	;　전격　　：0918.나루카미			消費48	SHOCK付与	上位：エル・ジハード（威力470）
	;　충격　　：2850.リリカ・ソロライブ消費31	※歌唱技能10の場合
	;　　　　　　　※ツインクルネビュラが衝撃を含む。他、異界の風やリムドラオンとかないでもないけども
	;　신경　　：なし
	;　정신　　：なし
	;　파마　　：1339.히에로스그류페인		消費55	※威力380、デカジャ効果
	;　　　　　　　※ツインクルネビュラ、クロスフォーチュンが破魔を含む。わりと真面目にコウガオンが候補に入ってくる
