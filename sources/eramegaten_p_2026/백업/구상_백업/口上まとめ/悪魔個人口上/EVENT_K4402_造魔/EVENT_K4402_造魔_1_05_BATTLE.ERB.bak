		ELSE
			IF RAND:2 == 0
				PRINTFORML ┃%"절굿공이를 사용한 타격을 행하겠습니다……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"절구를 사용한 타격을 행하겠습니다……",72,LEFT%┃
			ENDIF
		ENDIF
