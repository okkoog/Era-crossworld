;-------------------------------------------------
;○攻撃系イベント口上
;戦闘口上フラグ（CFLAG:807）が５のとき限定
;-------------------------------------------------
IF TFLAG:전투이벤트 == 11 && CFLAG:807 >= 5
	;攻撃して撃破
	;攻撃して倒したとき2分の1で
	IF RAND:2 == 0 && BASE:(ARG:1):ＨＰ <= 0
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		;2分の1で汎用
		IF RAND:2 == 0
			;サドもちかつ2分の1
			IF TALENT:83 == 1 && RAND:2 == 0
				IF 0
				ELSEIF RAND:5 == 0
					PRINTFORML ┃%"弱敵……",72,LEFT%┃
				ELSEIF RAND:4 == 0
					PRINTFORML ┃%"이 정도입니까……",72,LEFT%┃
				ELSEIF RAND:3 == 0
					PRINTFORML ┃%"이 정도로 방해를 하다니……",72,LEFT%┃
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"얕보이고 있는 걸까요……?",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"다음으로 향합니다……",72,LEFT%┃
				ENDIF
			;サドがない、もしくは2分の1でこちらに
			ELSE
				IF 0
				ELSEIF RAND:5 == 0
					PRINTFORML ┃%"목표를 격파했습니다……",72,LEFT%┃
				ELSEIF RAND:4 == 0
					PRINTFORML ┃%"작별입니다……",72,LEFT%┃
				ELSEIF RAND:3 == 0
					PRINTFORML ┃%"적성 목표의 무력화를 확인……",72,LEFT%┃
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"제압을 완료했습니다……",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"다음으로 향합니다……",72,LEFT%┃
				ENDIF
			ENDIF
		ELSE
			IF 0
			;物理系
			ELSEIF RANGE(CFLAG:ARG:입력행동,0, 399)
				IF 0
				ELSEIF RAND:3 == 0
					PRINTFORML ┃%"목표를 무력화했습니다……",72,LEFT%┃
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"목표를 파괴했습니다……",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"목표를 타도했습니다……",72,LEFT%┃
				ENDIF
			;화염
			ELSEIF RANGE(CFLAG:ARG:입력행동,701, 799)
				PRINTFORML ┃%"목표를 불태워버렸습니다……",72,LEFT%┃
			;빙결
			;絶対零度では何もかもが停止する！とか、こう
			ELSEIF RANGE(CFLAG:ARG:입력행동,801, 899)
				PRINTFORML ┃%"목표를 정지시켰습니다……",72,LEFT%┃
			;전격
			;×感電：弱そう　×痺れさせた：それですんでない　×電殺：なんじゃそりゃ　△撃破；まあ撃破口上だしなあコレ
			;電撃は好きなのでどうにかしたい……
			ELSEIF RANGE(CFLAG:ARG:입력행동,901, 999)
				PRINTFORML ┃%"목표를 격파했습니다……",72,LEFT%┃
			;충격
			;吹きとばしたりするのは疾風、切り裂くのは剣戟……うーむ。代案求む
			;→破壊から破砕にしてみた。
			ELSEIF RANGE(CFLAG:ARG:입력행동,1001, 1099)
				PRINTFORML ┃%"목표를 파쇄했습니다……",72,LEFT%┃
			;神経、精神
			ELSEIF RANGE(CFLAG:ARG:입력행동,1101, 1299)
				PRINTFORML ┃%"목표를 무력화했습니다……",72,LEFT%┃
			;파마
			;※性的な意味で
			ELSEIF RANGE(CFLAG:ARG:입력행동,1301, 1399)
				PRINTFORML ┃%"목표를 승천시켰습니다……",72,LEFT%┃
			;주살
			;殺害を使うならここしかねー、と思ったけど、ゾンビちゃんとかは……まあいいかぁ！
			ELSEIF RANGE(CFLAG:ARG:입력행동,1401, 1499)
				IF RAND:10 == 0
					PRINTFORML ┃%"목표를 지옥으로 보냈습니다……",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"목표를 살해했습니다……",72,LEFT%┃
				ENDIF
			;지변
			;×押しつぶした、飲み込んだ：地割れ系だけみたい　×転倒：流石にそれじゃすまん　×震殺：造語なんぞ作ってんじゃねえ！
			;×圧縮：重力でやれ　△撃破：これしかねえ。
			ELSEIF RANGE(CFLAG:ARG:입력행동,1501, 1599)
				PRINTFORML ┃%"목표를 격파했습니다……",72,LEFT%┃
			;수격
			;×押し流した：ウォータージェット的な攻撃あるんじゃねこれ　×溺死させた：あきらかにそれで済んでないっていうか悪魔が溺死してたまるか
			;×とかした：酸というか十天君の赤い雨みたいなののイメージもあるっちゃあるけど。　×凍らせた:冷気でやれ。追加氷結あるスキルもあるけど。
			;どーしたもんか。
			ELSEIF RANGE(CFLAG:ARG:입력행동,1601, 1699)
				PRINTFORML ┃%"목표를 격파했습니다……",72,LEFT%┃
			;질풍
			ELSEIF RANGE(CFLAG:ARG:입력행동,1701, 1799)
				PRINTFORML ┃%"목표를 날려버렸습니다……",72,LEFT%┃
			;중력
			ELSEIF RANGE(CFLAG:ARG:입력행동,1801, 1899)
				PRINTFORML ┃%"목표를 압괴시켰습니다……",72,LEFT%┃
			;핵열
			;単純に熱量なら火炎系よりも上のイメージ。威力とか別にそーでもないけど
			ELSEIF RANGE(CFLAG:ARG:입력행동,1901, 1999)
				PRINTFORML ┃%"목표를 증발시켰습니다……",72,LEFT%┃
			;만능
			ELSEIF RANGE(CFLAG:ARG:입력행동,2001, 2099)
				PRINTFORML ┃%"목표를 소멸시켰습니다……",72,LEFT%┃
			;その他
			ELSE
				PRINTFORML ┃%"목표를 격파했습니다……",72,LEFT%┃
			ENDIF
		ENDIF
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;攻撃したけど無効化された
	;悪魔全アナライズ100％とか廃人のヤる事＝無効にされることもままあると思われるのでちょっとパターン組みたいがネタがぁー。
	;まあ雑魚枠とかはダンジョン探索してればどうにでもなるし普通調教してたら弱点くらいは抜けるし、うーん
	;壁とかは使ってくる敵も得にいない気がする（ような）なので考慮しない。
	ELSEIF ARG:2 == 0
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		IF 0
		;物理系
		;まあ滅多にいないけど。
		;검격
		;切ったら分裂とかするイメージ。暗黒剣が必要だ
		ELSEIF RANGE(CFLAG:ARG:입력행동,1, 99)
			PRINTFORML ┃%"목표를 절단할 수 없습니다……",72,LEFT%┃
		;비구
		ELSEIF RANGE(CFLAG:ARG:입력행동,100, 199)
			PRINTFORML ┃%"목표에게 사격은 효과가 없는 것 같습니다……",72,LEFT%┃
		;타격
		ELSEIF RANGE(CFLAG:ARG:입력행동,100, 199)
			PRINTFORML ┃%"타격에 손맛이 느껴지지 않습니다……",72,LEFT%┃
		;전술
		;戦技吸収って特に意味分からねえ……
		ELSEIF RANGE(CFLAG:ARG:입력행동,100, 199)
			PRINTFORML ┃%"목표에게는 전투 기술이 통하지 않습니다……",72,LEFT%┃
		;화염
		ELSEIF RANGE(CFLAG:ARG:입력행동,701, 799)
			PRINTFORML ┃%"목표는, 열기에 강한 내성을 지니고 있는 것 같습니다……",72,LEFT%┃
		;빙결
		ELSEIF RANGE(CFLAG:ARG:입력행동,801, 899)
			PRINTFORML ┃%"목표는 얼지 않는 것 같습니다……",72,LEFT%┃
		;전격
		;絶縁体は抵抗が非常に大きいだけで、電圧を上げれば電流が流れる
		;雷のゴロピシャーンは『空気』と言う絶縁体にとんでもねー電圧がかかり通電破壊が起きる。それゆえの衝撃波の音。
		;電撃、とか属性名そのまま、例えば稲妻や雷と言わないってのが一応のこだわり
		;やっぱりこっちでもなんか困る
		ELSEIF RANGE(CFLAG:ARG:입력행동,901, 999)
			PRINTFORML ┃%"목표는 전격을 무효화하는 것 같습니다……",72,LEFT%┃
		;충격
		;こっちでも困る。衝撃、衝撃、衝撃なー……
		ELSEIF RANGE(CFLAG:ARG:입력행동,1001, 1099)
			PRINTFORML ┃%"목표에게, 충격에 의한 공격은 무의미한 것 같습니다……",72,LEFT%┃
		;신경
		;字義どおりに言葉を受け取る造魔ちゃん
		ELSEIF RANGE(CFLAG:ARG:입력행동,1101, 1199)
			PRINTFORML ┃%"목표는 무신경한 것 같습니다……",72,LEFT%┃
		;정신
		ELSEIF RANGE(CFLAG:ARG:입력행동,1201, 1299)
			;ちょっともったいないのでって言うかなんて言うか
			IF RAND:10 == 0
				PRINTFORML ┃%"목표는 매우 배짱이 두둑한 것 같습니다……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"목표는 정신 공격에 내성을 지니고 있는 것 같습니다……",72,LEFT%┃
			ENDIF
		;파마
		;※性的な意味で
		ELSEIF RANGE(CFLAG:ARG:입력행동,1301, 1399)
			PRINTFORML ┃%"목표를 승천시킬 수 없습니다……",72,LEFT%┃
		;주살
		ELSEIF RANGE(CFLAG:ARG:입력행동,1401, 1499)
			IF RAND:10 == 0
				PRINTFORML ┃%"목표는 이곳이 지옥이라고 생각하는 것 같습니다……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"목표를 살해할 수 없습니다……",72,LEFT%┃
			ENDIF
		;지변
		ELSEIF RANGE(CFLAG:ARG:입력행동,1501, 1599)
			PRINTFORML ┃%"목표는 대지에 얽매이지 않는 것 같습니다……",72,LEFT%┃
		;수격
		ELSEIF RANGE(CFLAG:ARG:입력행동,1601, 1699)
			PRINTFORML ┃%"목표에게 수격은 효과가 없는 것 같습니다……",72,LEFT%┃
		;질풍
		;風を吸収ってなんだ、風力発電か。マスクドライダーか。
		ELSEIF RANGE(CFLAG:ARG:입력행동,1701, 1799)
			PRINTFORML ┃%"이 속성으로는, 목표를 배제할 수 없습니다……",72,LEFT%┃
		;중력
		;これ無効とかめったに見ないような、っていうか滅多に使わないような。重力斬波とか重斬刀とかマイクロブラックホールヴァルカンとかリンケージ作ろうぜ
		ELSEIF RANGE(CFLAG:ARG:입력행동,1801, 1899)
			PRINTFORML ┃%"이 속성으로는, 목표를 배제할 수 없습니다……",72,LEFT%┃
		;핵열
		;ゴッズィーラとか誕生しそうで怖いんだよなあコレ吸収って
		ELSEIF RANGE(CFLAG:ARG:입력행동,1901, 1999)
			PRINTFORML ┃%"이 속성으로는, 목표를 배제할 수 없습니다……",72,LEFT%┃
		;만능
		;まあドゥベで無効になるはずなので死に口上ではない、マザーハーロットも反射してくることが
		ELSEIF RANGE(CFLAG:ARG:입력행동,2001, 2099)
			PRINTFORML ┃%"!? 있을 수 없습니다……!",72,LEFT%┃
		;その他
		ELSE
			PRINTFORML ┃%"공격이 무효화되었습니다…… 대책을……",72,LEFT%┃
		ENDIF
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF
ENDIF


;-------------------------------------------------
;○被弾系口上
;戦闘口上フラグ（CFLAG:807）が５のとき限定
;また、通常被弾は結構確率が低い
;いちいち喋ってたらぜってーうぜえ
;……ので、フラグを立てるかRANDるかを考えた結果、RANDることにした
;それぞれ一戦闘一回くらいにしたいんだけど……
;-------------------------------------------------
;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
;-------------------------------------------------
IF TFLAG:전투이벤트 == 12 && CFLAG:807 >= 5
	;被弾（戦闘不能）
	IF BASE:ARG:ＨＰ <= 0
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		IF 0
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"크, 하악……!?",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"그, 런……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"윽, 아아……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"우극……!",72,LEFT%┃
		;あなたの名を呼び倒れる
		ELSE
			;恋慕、親愛
			IF TALENT:3 || TALENT:6
				PRINTFORML ┃% CSTR:이인칭 + "……아파……요……",72,LEFT%┃
			;淫乱、娼婦
			ELSEIF TALENT:4 || TALENT:7
				PRINTFORML ┃% CSTR:이인칭 + "……" + CSTR:일인칭 + "은, 모자란, 아이……",72,LEFT%┃
			;服従、隷属
			ELSEIF TALENT:5 || TALENT:8
				PRINTFORML ┃% CSTR:이인칭 + "……죄, 송합, 니……",72,LEFT%┃
			ELSE
				PRINTFORML ┃% CSTR:이인칭 + "……면목, 이……",72,LEFT%┃
			ENDIF
		ENDIF
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;食いしばり（擬似的に無理やり動かしてます）
	;食いしばり、なのでエクスクラメーションな感じで。
	;偶然HP１になった時に出てもまあ違和感はないんじゃないかな
	ELSEIF BASE:ARG:ＨＰ == 1
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		IF RAND:3 == 0
			PRINTFORML ┃%"아직, 쓰러질 수는……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"이 몸이, 움직이는 한, " + CSTR:이인칭 + "의 옥체는……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃% CSTR:일인칭 + "은, 아직, 싸울 수 있습니다……!",72,LEFT%┃
		ENDIF
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;大ダメージ
	ELSEIF ダメージ割合(ARG, ARG:2) > 50
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		IF RAND:4 == 0
			PRINTFORML ┃%"우극……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"아, 아앗……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"큭…… 회피, 실패……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"신속하게, 회복이 필요합니다……윽",72,LEFT%┃
		ENDIF
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;無効
	ELSEIF ARG:2 == 0
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		IF RAND:4 == 0
			PRINTFORML ┃%"無効化完了……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%CSTR:일인칭 + "이 미끼가 되겠습니다……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"피탄 원인을 정밀 조사합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"공격을 무효화했습니다……",72,LEFT%┃
		ENDIF
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;吸収；契約したらイケた気がするし将来的になんかないとも限らないので
	ELSEIF ARG:2 < 0
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		IF RAND:4 == 0
			PRINTFORML ┃%"……꺽. ……실례했습니다……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%CSTR:일인칭 + "이 미끼가 되겠습니다……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"그 공격은, 저의 힘이 됩니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"공격을 무효화했습니다……",72,LEFT%┃
		ENDIF
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;残り１５％未満
	ELSEIF 現HP割合(ARG) < 15 && RAND:5 == 0
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		;残りHPと言わせるわけにもいかんって言うか、残体力ってのもおかしい
		;稼働可能時間もちょっとなあ。んー、むーん
		IF RAND:4 == 0
			PRINTFORML ┃%"윽, 내구도가 위험 수치에 도달했습니다……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데미지가, 축적되고 있습니다……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"큭…… 회피를, 실패……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"신속하게, 회복이 필요합니다……",72,LEFT%┃
		ENDIF
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;残り50％未満
	ELSEIF 現HP割合(ARG) < 50 && RAND:5 == 0
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		IF RAND:4 == 0
			PRINTFORML ┃%"……내구도가, 줄어들고 있습니다……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데미지가 축적되고 있습니다……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"예상 이상의 전력이라 판단합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"윽…… 회복이 필요할 것으로……",72,LEFT%┃
		ENDIF
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;通常被弾
	;たっくさん出る計算なのでさらに10分の1
	;「ルックス５％低下、マスター、洗浄をお願いします……」とかそういうネタ入れようかとも思ったのだが
	ELSEIF RAND:10 == 0
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		;服着てないのは想定してないっていうかめんｄｄｄｄｄｄｄｄｄｄ
		IF RAND:4 == 0
			PRINTFORML ┃%"……옷이 찢어지고 말았습니다……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"회피 실패…… 문제없는 데미지입니다……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"전력은 예상 범위 내입니다……",72,LEFT%┃
		;まあ凍ったりとか痺れたりとか問題ある場合もあるけど
		ELSE
			PRINTFORML ┃%"회피 실패…… 전투에 문제는 없습니다……",72,LEFT%┃
		ENDIF
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF
ENDIF

;-------------------------------------------------
;○範囲攻撃て敵を撃破した
;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
;-------------------------------------------------
;IF TFLAG:전투이벤트 == 13 && CFLAG:807 >= 5 && RAND:4 == 0
	;全弾命中した
;	IF ARG:2 == 0
