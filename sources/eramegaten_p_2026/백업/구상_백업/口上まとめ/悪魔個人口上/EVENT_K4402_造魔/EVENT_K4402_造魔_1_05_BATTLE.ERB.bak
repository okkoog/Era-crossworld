IF TFLAG:전투이벤트 == 96 && CFLAG:807 >= 5
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	IF 現HP割合(ARG) < 25
