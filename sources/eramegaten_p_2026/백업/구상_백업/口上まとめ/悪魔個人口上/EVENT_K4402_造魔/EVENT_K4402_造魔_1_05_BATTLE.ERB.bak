;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,2988, 2999) || CFLAG:ARG:입력행동 == 3587 || CFLAG:ARG:입력행동 == 3700
	IF 0
	;2988,사랑을품은검은날개
