			PRINTFORML ┃%"운이 좋다면 이 세상은 천국……",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"스킬 코드: Lucky Punch…… 앗……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"…………＊이런＊…………",72,LEFT%┃
			PRINTFORML ┃%CSTR:이인칭 + "…… 보이셨는지요……?",72,LEFT%┃
;			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
;			PRINTFORML ┏┓＠%NAME:MASTER,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"なにがだ。",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"…………앗.",72,LEFT%┃
			PRINTFORML ┃%"……아뇨, 추격이 가능해질지도 모릅니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"…………어라?",72,LEFT%┃
