				PRINTFORML ┃%"　　　　　ｽﾉｳ ﾎﾞｰﾙ ｱｰｽ　　　　",72,LEFT%┃
				PRINTFORML ┃%"　　　　 冥　顕　凍　滞",72,LEFT%┃
			ELSEIF RAND:2 == 0
