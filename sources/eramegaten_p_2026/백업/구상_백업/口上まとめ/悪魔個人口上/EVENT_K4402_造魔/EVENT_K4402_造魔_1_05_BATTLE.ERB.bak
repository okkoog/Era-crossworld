	;　/
	;　滅び/Damnation　2BB
	;　ソーサリー
	;　すべてのクリーチャーを破壊する。それらは再生できない。
	;　/
	;　次元の混乱/Planar Chaosにおける話題の筆頭。
	;　『MTG』黎明期から白を支えた「神の怒り/Wrath of God」が、次元の混乱により黒へとシフトしたもの。
	;　きわめてシンプルかつ美しい効果であり、これほど黒にふさわしい効果もなかなかない。
	;　むしろ、MTG発売（1993年）から次元の混乱（2007年）までの14年間になかったことの方が驚きの効果である。
	;　「神の怒り」は「白い光がすべてを吹き飛ばす」イラストであるが、
	;　「滅び」は「黒い球体にすべてが吸い込まれる」イラストになっている。
	;　今では「神の怒り」も「滅び」も「往年の名カード」になってしまっているが、今の環境にあっても十分以上に強いはず。
	;　あ、白は「破魔が得意」、黒は「呪殺が得意」くらいのアレな。
	ELSEIF CFLAG:ARG:입력행동 == 1313
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"라스 오브 갓：Damnation……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"신의 분노를 알도록 하라……!",72,LEFT%┃
		;MTGでは、「再生のできない破壊」を「埋葬」と言っていた時期がある。
		;他ゲーだと「墓地に送る」とか「墓地に置く」とかそういう用語になるだろうか。
		;「神の怒り」のテキストは過去、「すべてのクリーチャーを埋葬する」であり、英語では「Bury all creatures」だけであった。
		;実に美しい。
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"모든 괴이를 매장하겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"멸망의 노래를 들어라……",72,LEFT%┃
		ENDIF
	;1315,코우하
	;1316,바이코우하
	;1314,코우가온
	;1347,코우바리온
	;　＞破魔、威力95、単体、魔、消費2
	;　＞破魔、威力170、拡散、魔、消費6
	;　＞破魔、威力300、拡散、魔、消費12
	;　＞破魔、威力350、拡散、魔、消費20
	;1317,마하코우하
	;1346,마하코우가온
	;1348,마하코우바리온
	;　＞破魔、威力195、全体、魔、消費10
	;　＞破魔、威力275、全体、魔、消費20
	;　＞破魔、威力320、全体、魔、消費32
	;　/
	;　★派生ルート
	;　　코우하
	;　　├바이코우하┬마하코우하┬파마의뇌광―穢れなき威光
	;　　｜　　　　　｜　　　　　└마하코우가온
	;　　｜　　　　　└코우가온
	;　　└마하코우하┬파마의뇌광―穢れなき威光
	;　　　　　　　　└마하코우가온
	;　/
	;　コウハ系。
	;　一応弱くはない……けど覚えるのが少なめ。昔よりはだいぶ増えた。
	;　コウガオンはかなりコスパがいいかな？
	;　バイコウハは拡散範囲が２と広い珍しいスキル（ミスじゃねーかな……）。
	;　ゾンビっぽいのとか破魔に弱い敵は炎にも大抵弱いですし、高位悪魔は耐性持ちが大半だったり人間には効かなかったりで使いにくさが目立つ感じ。
	;　光波ってことでいいのかな、出るのやってないんだけど……
	;　コウガバリオンについては、破魔系に「デドバ系」がない（少なくとも汎用スキルとしては）……ための性能か、かなり弱い。
	;　ただ、バランスとしては「デドバ系」は十分に必殺技のスペックがあるため、このくらいがちょうどいいのかもしれない。
	;　ちょっとづつだけどインフレしてるからね、eraten。
	ELSEIF GROUPMATCH(1314, 1315, 1316, 1317, 1346, 1347, 1348) && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"광파술을 영창합니다……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"빛의 파동을 발합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%LOCALS + "(으)로 광격을 행합니다……",72,LEFT%┃
		ENDIF
	;1318,플레어라이트
	;　＞破魔、威力200、単体、魔、消費8
	;　天中殺に派生
	;　普通オブ普通。通常攻撃と言っていいレベル
	ELSEIF CFLAG:ARG:입력행동 == 1318 && CFLAG:807 >= 3
		IF 0
		;フレア、ではなくなっている。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Holy Light……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"양광을 재현…… 조사합니다",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"양광을 수렴…… 발합니다",72,LEFT%┃
		ENDIF
	;1319,천중살
	;　＞破魔、威力240、全体、魔、消費18
	;　追加効果なし全体攻撃。中ダメージ。ふつう。
	;　/
	;　天中殺とは、「算命学」……まあ、一種の占いにおいて、天が味方しない時期のこと。
	;　ただし「敵にもならない」というか、「なんも影響を与えない」という時期ともされる。
	;　決して「クソみたいなことが起きる」時期ではない。「クソみたいなことが起きても天が助けてくれない」時期ではあるが。
	;　十干、「甲・乙・丙・丁・戊・己・庚・辛・壬・癸」
	;　十二支、「子・丑・寅・卯・辰・巳・午・未・申・酉・戌・亥」
	;　……上記の干支の組み合わせで年月を表すが、十二支の方がふたつ多い。
	;　「余分なふたつ」の2/12年間、2/12か月間、2/12日間、4/24時間が、「천중살」と呼ばれる時期である。
	;　「甲子」の年・月・日に生まれた人は、「戌亥天中殺」という……のだと思うんだけど、ココの出し方は調べてもチョイと出てこなかった。
	;　まあ、「人間の運勢がおおよそ６パターンに分かれる」というのもおかしな話。
	;　なにも意味がないからこそ、効果もふつうの攻撃なんだろうか？
	ELSEIF CFLAG:ARG:입력행동 == 1319 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Celestial Hit……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"산명 도출…… 지금부터 천충살(天沖殺)입니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"하늘에 빛나는 것은 빗나간 별……",72,LEFT%┃
		ENDIF
	;1320,회전설법
	;　＞破魔、威力0、全体、魔、消費45　破魔即死80-95
	;　名前からしてすげえネタくさい、ただし性能はガチ。
	;　「即死」最強格の技ではある。っていうか『죽어줄래？』の破魔版だろうか。
	ELSEIF CFLAG:ARG:입력행동 == 1320
		IF 0
		ELSEIF RAND:100 == 0
			PRINTFORML ┃%"仁不裸無！ 仁不裸無！ 仁不裸無！",72,LEFT%┃
			PRINTFORML ┃%"……명칭은 정확하게 대라고 하셔도……",72,LEFT%┃
			PRINTFORML ┃%"……그런 카테고리가 아닌 것일까요……?",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTFORML ┏┓＠%NAME:MASTER,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"어디서 배운 거냐 그런 쓸데없는 지식.",72,LEFT%┃
		;クリーチャーをゲームから除外してそのコントローラーのライフを回復するアレ。兄貴がたくさんいる村があるとかなんとか
		ELSEIF RAND:99 == 0
			PRINTFORML ┃%"당신은 농장행입니다……",72,LEFT%┃
		;Sermon：説教。……ストレートだな！　いちおう、スラング的には、「長くて退屈な話」という意味でもあるらしい。
		;→Samsaraになった
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Samsara……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"다중 포위 섬멸 설법을 실행합니다……",72,LEFT%┃
		;ビジュアル分からんのだが、ぐーるぐーる周囲を分身しつつ回りながら成仏せよって言いまくってるイメージである
		ELSE
			PRINTFORML ┃%"성불하라, 성불하라, 성불하라……",72,LEFT%┃
		ENDIF
	;1321,니르바나
	;　＞破魔、威力320、拡散、魔、消費17　破魔即死25-95
	;　拡散大ダメージ。ただどうやら達人あなた限定スキルの模様、惜しい
	;　スペックのわりに消費は安い方かしらん。
	;　/
	;　니르바나。涅槃。ニッバーナ。
	;　サンスクリット語で「消えた」という意味。
	;　ヒンドゥー教、ジャイナ教、仏教での概念で、「輪廻転生から抜け出した」という「状態」のことであるとか。
	;　つまり、「執着や欲望が消え去って穏やかな」状態のことをいうのだろう。
	;　ただ、それこそ「極楽浄土」みたいなイメージあるよねぇ。
	;　「涅槃」状態というのは、生命への執着が消え去った状態、すなわち死のことをさす場合もあり、
	;　このスキルはまさしくそちらだろう。涅槃に逝け、みたいな。
	ELSEIF CFLAG:ARG:입력행동 == 1321
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Nirvana……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"열반을 보고 오시는 편이 좋을 듯합니다만……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"당신은 열반행입니다……",72,LEFT%┃
		ENDIF
