;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,2001, 2099)
	IF 0
	;2001,메기도
	;2002,메기도라
	;2003,메기도라온
	;　＞万能、威力220、全体、魔、消費20
	;　＞万能、威力295、全体、魔、消費35
	;　＞万能、威力420、全体、魔、消費60
	;　★デッドリーバーン系
	;　/
	;　基礎的なスキル……基礎的な、上級スキル、ですわね。
	;　なんだかんだ、メギドラオンは十分に強力なスキルです。
	;　ただ、効率は悪いですねー……「全体特大威力」は消費35前後なのですが、ほぼ同スペックのメギドラオンは消費60よ。
	;　ネタを仕込みはしましたがちょっとアレよねってことでコメントアウトしてます
	ELSEIF RANGE(CFLAG:ARG:입력행동,2001, 2003)
		IF 0

		ELSEIF CFLAG:ARG:집중플래그 == 1
			PRINTFORML ┃%"신화로…… 적성 목표를 말소합니다……!",72,LEFT%┃
		ELSEIF RAND:10 == 0 && CFLAG:ARG:입력행동 == 2003
			PRINTFORML ┃%"메기도라온…… 이옵니다……",72,LEFT%┃
		ELSEIF RAND:10 == 0 && CFLAG:ARG:입력행동 != 2003
			PRINTFORML ┃%"메기도라온…… 은 아닙니다……",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"마력을 집중…… 경로 확정. " + LOCALS + " 행사합니다……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"날려버리겠습니다……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"신화를 받아라……!",72,LEFT%┃
;		ELSEIF RAND:2 == 0
;			PRINTFORML ┃%"ボンッ、です……！",72,LEFT%┃
;		ELSEIF RAND:2 == 0
;			PRINTFORML ┃%"汚い花火です……！",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"메기도의 불꽃이여……!",72,LEFT%┃
		ENDIF

	;2004,메기도라다인
	;　＞万能、威力特殊、全体、魔、消費40　威力は「300*(10+使用回数)/10」
	;　威力上限に際限がない。
	;　1回使用で30、威力が向上。
	;　ルシファー用なんだって。ただ、おそらく誰も覚えませんね……
	ELSEIF CFLAG:ARG:입력행동 == 2004
		IF TFLAG:아군메기도라다인 == 0
			PRINTFORML ┃%"메기도의 불꽃이여……!",72,LEFT%┃
		ELSEIF TFLAG:아군메기도라다인 < 3
			PRINTFORML ┃%"므깃도의 언덕에서 최후를 맞이하라……!",72,LEFT%┃
		ELSEIF TFLAG:아군메기도라다인 < 5
			PRINTFORML ┃%"므깃도의 언덕에 모여 최후를 맞이하라……!",72,LEFT%┃
		ELSEIF TFLAG:아군메기도라다인 < 7
			PRINTFORML ┃%"최종 전쟁에 모여라 혼돈이여……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"最終戦争最終兵器最終解決……！",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"이것으로 끝입니다……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"므깃도의 언덕을 불태워라, 신성한 불꽃이여……!",72,LEFT%┃
		ENDIF
	;2005,자폭
	;2006,옥쇄파
	;　＞万能、威力500、単体、物、消費5　자폭
	;　＞万能、威力500、全体、物、消費5　자폭
	;　/
	;　真正のネタ。
	;　ちなみに速度補正があり、マイナス５である。
	;　当然ながら、敵が使ってくるから怖いタイプである。
	ELSEIF RANGE(CFLAG:ARG:입력행동,2005, 2006)
		;つかう→なにか→セルフ→残念！私の冒険はこれで終わってしまった！
		IF RAND:4 == 0
			PRINTFORML ┃%"LP 브레이크：유즈→셀프……",72,LEFT%┃
		;サガフロの「ファイナルストライク」、最高にかっこいい演出だと思ってる
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"파이널 스트라이크：Last Resort……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"파이널 어택：Self-Destruct……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"――『딸깍』",72,LEFT%┃
		ENDIF
	;2007,바이널스트라이크
	;　＞万能、威力特殊、単体、魔、消費0　自分のHPの2倍の固定ダメージ
	;　命中50と命中不安。また、これで敵を倒すことはできない。
	;　敵専用。
	;　ショボたんがやってくるやつ。
	;　クッソ恐ろしいので、ショボたんは全力で会話しておきたい。
	;　テスト用エネミーにはこれを習得させてやると捗る、ことがあるね。
	ELSEIF CFLAG:ARG:입력행동 == 2007
		;Final Strike
		;……バイナル、ってどこから出てきたんだ……？
		;文字数制限の都合だろうか。
		;杖版は「シャッタースタッフ」。うそです。これはサガシリーズの話。
	;2008,위대한로고스
	;　＞万能、威力500、全体、魔、消費70
	;　メギドラオンのさらなる上位スキル。当然ながら最強クラスのスキルである（一応上位のスキルは存在するが……）
	;　クソ重いが、消費10の上昇で威力が80上昇というのはお強い。探せばまだ上位はあるが、ド安定ではある。
	;　マンセマットが覚えるよ。
	;　/
	;　ロゴス。
	;　ギリシア語で「言葉」「意味」「論理」といった意味を持つ言葉。
	;　つまるところ、「人間が認識する世界の根幹」かな。
	;　これは「人間が認識する」「世界の根幹」であり、
	;　同時に「人間が認識する世界」の「根幹」でもある。
	;　哲学ってのはつまりそういう学問であるからして。
	ELSEIF CFLAG:ARG:입력행동 == 2008
		IF RAND:3 == 0
			PRINTFORML ┃%"리액트：Great Logos……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"위대한 논리, 세계의 진실을 개장합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"신대 논리 재가동――…… 받아내 주시겠습니다, 위대한 로고스를……!",72,LEFT%┃
		ENDIF
	;2009,메기도・아크
	;　＞万能、威力600、単体、魔、消費60
	;　サタン用……らしい。
	;　命中200と高い。ただただ強い。
	ELSEIF CFLAG:ARG:입력행동 == 2009
		;完熟エッグをあんなターン数で倒すなんて……
		IF RAND:100 == 0
			PRINTFORML ┃%"제노사이드, 스타퀘이크……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"이레이저：Megido Arc……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"惑星表面、限定焼却……！",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"별을 불태우는 불꽃을 만들어냅니다……",72,LEFT%┃
		ENDIF
	;2010,잠재특수
	;　＞万能、威力特殊、単体、魔、消費0　威力は、「410+MAX(힘,마력)*3/2」
	;　ペルソナ使いが瀕死状態で攻撃を受けると発動することがある……ようだ。
	;　造魔ちゃんには習得できない。
	;　フレーバー的に「秘められた力が覚醒する！」みたいなのは嫌いではないが、萌えないのでカット。
;	ELSEIF CFLAG:ARG:입력행동 == 2010
	;2011,네크로・도그마
	;　＞万能、威力190/165、拡散、魔、消費15
	;　めっずらしい、威力低めの万能攻撃。
	ELSEIF CFLAG:ARG:입력행동 == 2011
		IF RAND:3 == 0
			PRINTFORML ┃%"리애니메이트：Necro Dogma……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"邪悪宗派秘儀、簡易展開……",72,LEFT%┃
		;イシュタル→アシュタロス、とか、例を挙げるまでもないと思いますね。
		;万能ダメージなのは、存在自体への汚染だからか。
		ELSE
			PRINTFORML ┃%"신화 정보 오염…… 사교로 타락하라……",72,LEFT%┃
		ENDIF
	;2012,메기도크로스
	;　＞万能、威力210*2、単体、物、消費35　CT35
	;　このCTで２回攻撃は嬉しい。
	ELSEIF CFLAG:ARG:입력행동 == 2012
		IF RAND:3 == 0
			PRINTFORML ┃%"싱크로 스트라이크：Megidocross……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"邪悪宗派秘儀、簡易展開……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"신화 정보 오염…… 사교로 타락하라……",72,LEFT%┃
		ENDIF
	;2013,흡혈
	;　＞万能、威力80、単体、魔、消費2　ダメージ100％分HP回復
	;　イメージ通りの吸血。威力はかなり低い。
	ELSEIF CFLAG:ARG:입력행동 == 2013
		IF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Blood Suck……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"그 혈액을 받아 가겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"MAG収奪術式、起動……",72,LEFT%┃
		ENDIF
	;2014,헤이트그로우
	;　＞万能、威力特殊、全体、魔、消費50　威力は相手の破魔耐性で変動、10-1000
	;　命中9999。
	;　基本威力は500、……か？
	;　　基本500-(敵破魔耐性*5/2)
	;　なので、敵の破魔耐性が無効・吸収だと強い。
	;　反射だと-200扱いなので、「500-(-200*5/2)＝威力1000」になる。
	;　100％通る相手だと、威力は250まで落ちる。
	ELSEIF CFLAG:ARG:입력행동 == 2014
		IF RAND:3 == 0
			PRINTFORML ┃%"블리딩：Growing Hatred……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"성스러운 것을 증오하라……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"키운다, 사악한 의지를……",72,LEFT%┃
		ENDIF
	;2015,데드엔드
	;　＞万能、威力320、単体、物、消費21　万能即死40-60
	;　アレックス(DSJ)専用。
	;　ぼく万能即死あんまりよくないと思う。
	;　まあ達人用スキルなので……というところではあるが。
	ELSEIF CFLAG:ARG:입력행동 == 2015
		IF 0
		;袋小路阿修羅さん！！！
		ELSEIF RAND:6 == 0
			PRINTFORML ┃%"당신의 생명은―― 여기서 막다른 골목입니다……!",72,LEFT%┃
		;アガートラーム！！！
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"데드 엔드, 클라우 솔라스……!",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"리설, 들어갑니다……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"소드 스킬：DEAD END……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"죽음으로써 다스려질지어다……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"데드 배드 엔드……!",72,LEFT%┃
		ENDIF
	;2016,抜け
	;2017,抜け
	;2018,모크샤기타
	;　＞万能、威力320、全体、魔、消費42　神経束縛50-90
	;　最強の神経スキル（違）。
	;　スキルの意味がちょっとイマイチ分からない。んー？
	;　ちょっとググる程度では出てこないな……
	;　/
	;　4Fでクリシュナが使ってきたようだしインドっぽいな、と、いうあたりを切り口にしてみた。
	;　すると、「バガヴァッド・ギーター」という言葉が出てきた。
	;　マハーバーラタ第六巻の一部であり、「バガヴァンの詩」という意味を持つ詩である。
	;　（バガヴァンとは、宗教的尊者を示す言葉、とのこと。ヒンドゥーにおいては「神の化身」を指す言葉でもある）
	;　となるとコレは、「モクシャの詩」というあたりの言葉になりそうだ。
	;　ではこの「モクシャ」ってなんだろうか――ちょっと苦労したが発見。「解脱」だ。
	;　サンスクリットで「vimoksa」「mokkha」、音写で「毘木叉」である。
	;　「解脱の詩」、解脱について語った詩文……という認識でよさそうだ。
	ELSEIF CFLAG:ARG:입력행동 == 2018
		;Recitation；朗詠
		IF RAND:3 == 0
			PRINTFORML ┃%"레시테이션：Moxagita……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"　　　　　　vimoksa gita",72,LEFT%┃
			PRINTFORML ┃%"낭랑하게 읊는 것은 비목차 시문……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"해탈을 위해 요가를 행해 주시겠습니다……",72,LEFT%┃
		ENDIF
	;2019,56억7천만의장
	;　＞万能、威力250、全体、魔、消費35
	;　★スマイル
	;　魔法攻撃だが、気合状態でも威力が向上。そうなると「250*(100+150+150)/100＝1000」となる。
	;　ボスフラグが立っていると命中が999(필중)にまで向上する。だれか覚えるとは思う。
	;　/
	;　56億7千万……といえば、弥勒菩薩だろう。
	;　釈迦牟尼仏の次に仏陀となる、遥かな未来に現れ衆生を救う未来仏である。
	;　ちなみに大雑把に、56億4999万7500年ほどあとに生まれる。
	;　この56億7千万年というのは、「弥勒菩薩が寿命を迎えて現世にやってくるまで」を計算した値。
	;　弥勒菩薩は4000年の寿命を持ち、住む世界の1日は現世で言う400年に相当することから、
	;　4000年×12ヶ月×30日×400年＝5億7600万年かかる……のが、なんかどっかで10倍になった、ということらしい。
	;　ビミョーにテキトーな気がするが、2000年ほど伝えてきて伝達ミスのひとつもない方が不自然よね。
	ELSEIF CFLAG:ARG:입력행동 == 2019
		;スマイル状態
		IF CFLAG:ARG:気合フラグ == 1 && CFLAG:ARG:집중플래그 == 1
			IF 0
			;「萬國驚天掌」。『ドラゴンボール』にて、ジャッキー・チュン（亀仙人の変装）が使用した技。
			;ばんこくびっくりしょう、と読む。万国びっくりショー、という番組のもじりだとか。
			;生体電流を操って放電、相手を拘束する技……なので、実はここに置くのはよくないかも。さすがに合ってねぇな。
			;使用時期は、亀仙人が悟空たちより強かった最後の時期である。この後はインフレに飲まれてしまったが、それでも亀仙人は好き。
			ELSEIF RAND:5 == 0
				PRINTFORML ┃%"삼천세계도 기겁할……",72,LEFT%┃
				PRINTFORML ┃%"이것이야말로 56억 경천장……!",72,LEFT%┃
			;菩薩掌……というのは、いくつかの格闘漫画で登場している。
			;『修羅の門』では、相手の頭部を挟む掌底撃。
			;この際、わずかに隙間を開けることで、敵の頭部が掌の間を一瞬の間に数百回跳ね返る。
			;結果として、猛烈な脳震盪で一撃で失神……というか、パンチドランカー症状を発症させる。
			;目や耳から血を流すビジュアルがヤバい。
			;『タフ』シリーズでは「菩薩拳」、踏み込み両手を合わせてパンチ。
			;打撃の跡が菩薩のように見える……らしい。
			;『バキ』シリーズでは、「菩薩の拳」。
			;愚地独歩が用いる、あえて拳を緩めた正拳突き。
			;赤ん坊の手の形……中指と薬指をわずかに握り、人差し指と小指をゆるく開いた拳である。
			;どうやら「悟りでも開いた」かのように、殺意……というか、意、がないようで、合気の達人はこれをほぼ無防備に受けてしまった。
			;どれも、非常に強力な必殺技……っつーかモロ殺人技だよなぁ……って感じ。
			ELSEIF RAND:4 == 0
				PRINTFORML ┃%"양손 합치, 365와 12의 기법을 재현……",72,LEFT%┃
				PRINTFORML ┃%"超振動破砕撃、振動数4000倍……",72,LEFT%┃
				PRINTFORML ┃%"젖먹이의 주먹으로 뜻을 지워 타격 효율 400배……",72,LEFT%┃
				PRINTFORML ┃%"이전유실로 10배로 위장……",72,LEFT%┃
				PRINTFORML ┃%"……이것은, “5670000000% 미륵 피스트”……!",72,LEFT%┃
			;過去七仏とは、過去に現れた、釈迦仏までの（釈迦牟尼仏を含む）７人の仏陀のことをいう。
			;毘婆尸仏＜びばしぶつ＞、　　　　　Vipasyin
			;尸棄仏＜しきぶつ＞、　　　　　　　sikhin
			;毘舎浮仏＜びしゃふぶつ＞　　　　　Visvabhu
			;倶留孫仏＜くるそんぶつ＞　　　　　Krakucchanda
			;倶那含牟尼仏＜くなごんむにぶつ＞　Kanakamuni
			;迦葉仏＜かしょうぶつ＞　　　　　　Kasyapa
			;釈迦牟尼仏＜しゃかむにぶつ＞　　　Sakyamuni
			;彼らが広げた……とされるものが、七仏通戒偈＜しちぶつつうかいげ＞
			;「諸悪莫作　衆善奉行　自浄其意　是諸仏教」
			;（しょあくまくさ　しゅぜんぶぎょう　じじょうごい　ぜしょぶっきょう）
			;「諸悪をなすなかれ、たくさんの善を行え、おのれの意思/心を清めよ、これが色んな仏様がみんな言ってること」
			;……ということ。
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"전법륜 기관 연소. 나는 번뇌조차도 구원하는 자……",72,LEFT%┃
				PRINTFORML ┃%"지금이야말로 제8 붓다의 자비를 베풀리라――",72,LEFT%┃
				PRINTFORML ┃%"――이것은, “미륵 피스트”……!",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"비바시·시기불·비사부……",72,LEFT%┃
				PRINTFORML ┃%"구류손·구나함모니·가섭·석가모니――",72,LEFT%┃
				PRINTFORML ┃%"칠불통계, 제악막작·중선봉행……!",72,LEFT%┃
			;もう2000年くらいは前から語られているものである都合上、
			;発音と言うのは変化する。ましてや、インド＞中華＞日本、と渡ってきているので、読み方と言うのは全然違う。
			;菩薩、という言葉は、サンスクリットでは「ボディサットヴァ」とかそういう発音を音写したもの。
			ELSE
				PRINTFORML ┃%"비바시·시기·비사부,",72,LEFT%┃
				PRINTFORML ┃%"구류손·구나함모니·가섭·석가모니……",72,LEFT%┃
				PRINTFORML ┃%"――미륵보살(마이트레야 보디사트바)",72,LEFT%┃
			ENDIF
		;Relieve：救済する
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"릴리브：5.67 Billion Palms……",72,LEFT%┃
		;転法輪、とは、「法輪を転ずること」。dharma-cakra-pravartana。
		;この法輪というのはサンスクリットではCakraと言い、これすなわち「チャクラム」である。
		;「チャクラムを投げる」……この場合は、「仏の教えを投げかけて、煩悩や誤った考えをただす」と言うことになる。
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"번뇌를 베어 갈라라 차크람이여……",72,LEFT%┃
			PRINTFORML ┃%"다르마 차크라 프라바르타나……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"그 과오를 구하기 위해…… 56억 7000만의 자비를 발한다……!",72,LEFT%┃
		ENDIF
	;2020,2억4천만의악
	;　＞万能、威力500、敵味方全体、魔、消費36　천벌
	;　Neutral属性の敵にダメージを与える。ちなみにこれは、LC軸、LD軸を問わない。
	;　アンリ・マンユのスキルのようだ。
	;　/
	;　二億四千万、はどこから来たのだろうか……？
	;　アンラ・マンユ、アーリマンが創ったとされる災難は、悪や病気、冬など16種。
	;　ゾロアスターの歴史観では、世界は12000年。
	;　ウーン、と思って調べてみたところ、（当時の）「日本人の総人口の瞳」と言うことらしい。
	;　2020年現在の人口が、1.258億らしいので、２億5000万の悪、になりそうだな。
	ELSEIF CFLAG:ARG:입력행동 == 2020
		IF RAND:3 == 0
			PRINTFORML ┃%"오픈 아이즈：240 000 000 Evils……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"눈을 떠라 백성들이여, 직시하라, 악을, 사악함을……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"눈동자를 절망으로 흐리게 만드는 편이 좋을 것입니다……!",72,LEFT%┃
		ENDIF
	;2021,만월의여왕
	;　＞万能、威力特殊、全体、魔、消費12　威力は月齢に応じて変動、（新月）1.130.410（満月）
	;　ちなみにボスフラグが立っていると威力は160.320.700、となる。
	;　新月の時はGOMIだが、平常時に使用すると実際のところそこまで悪くはない。消費がやっすいので。
	;　満月時には、「消費が20％のメギドラオン」ともいえる性能になる。
	;　とはいえ、安定しているのはメギドラオンではあるのだが……
	;　覚えるのは、ヘカーテ様だね！　大魔宮奥地で満月に突っ込むと、今の水準でもかなり強いボスである。
	;　（まあ、ギミック前提のボスを正面から殴り倒せるようになった、ともいうのだが）
	ELSEIF CFLAG:ARG:입력행동 == 2021
		IF FLAG:월령 == 8
			;behold：（注意して）見ろ
			;＞But, behold,
			;＞だが見るがよい。 - Andrew Lang『トロイア物語：都市の略奪者ユリシーズ』
			IF RAND:3 == 0
				PRINTFORML ┃%"비홀드：Full Moon Queen……!",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"보름달의 여왕이시여, 굽어살피소서……!",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"――보름달 여왕의 힘을, 지금 여기에……!",72,LEFT%┃
			ENDIF
		;新月
		;控え目に言ってゴミ
		ELSEIF FLAG:월령 == 0
			;wane：衰弱
			IF RAND:2 == 0
				PRINTFORML ┃%"웨이닝：New Moon Queen……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"달의 힘, ……검출 불능……",72,LEFT%┃
			ENDIF
		;その他の状況
		ELSE
			;Wax：（月が）満ちる、ちなみにwaneとは対義語になり、waxing Moonで「満ち行く月」すなわち上弦の月、となる
			IF RAND:2 == 0
				PRINTFORML ┃%"왁싱：Half Moon Queen……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"달의 여왕의 힘을 빌려, 지금……",72,LEFT%┃
			ENDIF
		ENDIF
	;2022,초메기도
	;　＞万能、威力「ＭＰ * 2 + 70」、全体、魔、消費全
	;　★マダンテ系
	;　サキュバスが覚える。
	;　/
	;　マダンテ系はすべて専用スキルである。
	;　「MPをすべて消費」し、「MPに一定の倍率をかけた値」が威力になる。
	;　標準的な超特大威力スキルは、「MP40程度の消費で400～500」程度。仮に450としよう。
	;　仮にMP1000のキャラがMP切れまでこれを連打すると、総合威力は11250。
	;　超メギドの場合、2070……ダイナミックアギラオは倍率4倍+225であるが、それでも4200程度の威力となる。
	;　１ターンで、４～５倍（あるいは10倍弱）程度のダメージを与えることができるが、そのあとは基本的にMUNOUとなるわけだな。
	;　標準的なスキルはMP１あたり威力10程度、マダンテ系は２か４なので、MP効率的には劣悪と言って差し支えない。
	;　根本的にネタスキルなのだが、それでも瞬間火力だけはブチギレている。
	;　造魔ちゃんは、「마술의소양」……MP6割増加パッシブと、マダンテ系を両立できてしまうため、
	;　eratenで最もマダンテ系をうまく扱えるキャラクターでは、ある。
	;　「使ったあとどうしようもなくなる」が、インストールソフトなどで召喚補助を行いながら連打連打で瞬殺することもまあまあ可能である。
	;　超メギドの場合、サキュバスをテキトーに育ててそのまま造魔にしてやれば、爆弾みてーな一群が爆誕する。
	;　極めると18億とかダメージ出るらしいです。
	;　/
	;　マダンテ。
	;　項目としてはたぶんここに置くのが正しいのだが、後述の理由により、ダイナミックアギラオに置いた方がいい気もする。
	;　いやまったく関係ないことを書くのはどうなんだ……？（今更）
	;　/
	;　「全MPを消費して、消費量に応じたダメージを与える」……といったらコレだね。ホチキスとかバックホーみてーなもん。
	;　呪文ではあるが、特技側に設定されていることも多い。メガテンで言うと、設定上はMAGIC、実機上はEXTRA。
	;　マホトーンやマホカンタに引っかからないようにするとか、そういう意図だろうか。
	;　初登場はDQ6。
	;　FFに比べ比較的ダメージが低く纏まっているDQで、ほとんど初めて４ケタダメージを与える手段だった。
	;　敵が使用すると固定ダメージになる。威力は高いが、たいていの作品では軽減が可能だし、
	;　その後MP回復行動（＝無駄行動）が入るので、実際のところそこまでキツくない。
	;　ちなみに「ダメージ軽減ができない」というわけではなく、けっこうなシリーズで「炎系」と設定されている（ほのおのいき、とかあの辺と同系統）。
	;　よってブレス系耐性で防御が可能である。
	;　光系であったり、無属性であったり、あるいは「マダンテ系」と設定されている作品もある。
	ELSEIF CFLAG:ARG:입력행동 == 2022
		;◆MP1万以上。まあ即死。威力20000越えとか世界滅ぶ。
		;あまりの威力にテンションあがる造魔ちゃん（Lv1000↑）。まあLv1000で魔法系特化だとMP250000行くとか聞いたが。
		IF FLAG:확산플래그 >= 20080 || BASE:ARG:ＭＰ >= 10000
			IF 0
			ELSEIF RAND:7 ==0
				PRINTFORML ┃%"지금, 멸망의 시간이다……!",72,LEFT%┃
