		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Painful Pounding……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"심쿵으로 죽어 주시겠습니다……",72,LEFT%┃
;			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
;			PRINTFORML ┏┓＠%NAME:MASTER,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"キュン死ってそういう事じゃないと思う。",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"……심쿵이란……?",72,LEFT%┃
