	;　/
	;　悪魔ほむらの必殺技。
	ELSEIF CFLAG:ARG:입력행동 == 2998
		IF 0
		;BLACKで浸食……というと、『Lobotomy Corporation』が思い浮かぶ。
		;韓国発のゲームで、大雑把に言うと「SCPを管理して、それから生産されるエネルギーを売りさばこう！」というもの。
		;（ここではSCPについては説明しないぞ）
		;プレイヤーは、施設の管理者として、職員に指示を出してSCP……幻想体/アブノーマリティを管理させる。
		;幻想体は、例えば「O-03-03」といった管理番号が付いていて、「たった一つの罪と何百もの善」という名前が付けられている。
		;この幻想体たちは上手く管理してやることで超自然的なエネルギーを生産するようで、
		;主人公らの所属するL社は、このエネルギーを供給することで、一躍大企業にのしあがった。
		;キャラクターたちやシナリオについても面白いもので、名作だと思う。
		;あ、日本語版があるよ。大丈夫。続編もイケてる。
		;/
		;幻想体たちは、管理のたびに「物理ダメージのRED」「精神ダメージのWHITE」「浸食ダメージ（体力精神力を同時に削る）BLACK」、
		;「割合HPダメージのPALE」のうちいずれかの属性のダメージを与えてくる。
		;（PALEは、死の属性であるため、防御が難しいという設定である）
		;管理方法は幻想体ごとにさまざまで、「愛着」「本能」「洞察」「억압」の４つの作業で管理させる。
		;また、「クリフォトカウンター」という数値があり、これがゼロになると脱走（収容違反）したりする。
		;マズい管理をするとカウンターが減り、脱走したりするわけだ。
		;あと、職員が死亡した際にカウンターが減るタイプもいる。
		;脱走はしないが周囲のカウンターを減らす害悪もいる。
		;収容違反したならば、物理的に殴って収容室に叩き返すほかない。
		;管理方法は幻想体ごとにフレーバーに富んでいる。
		;「管理作業中眺めていないと作業が失敗する」
		;「愛着作業させると、作業した職員に種を植え付け、感染した職員を怪物に変える」
		;「一定以上の能力がないと作業した職員が即死する」
		;「室内にいる限り完全に安全なシェルター、ただし『そこを一番安全な場所にする』ため、『外を危険にする』」
		;「めちゃくちゃキュートだけど人間をもぐもぐする。かわいいね」
		;……こんなやつらを10も20も管理するので、画面が色々忙しいのだが、やってて楽しいゲームである。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Eroding Black Wing……",72,LEFT%┃
		;「黒めよ」は、ブリーチから持ってきました。なんなんだあのセンス……
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"검어져라, 나의 날개여……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"마법소녀·아케미 호무라를…… 재연……",72,LEFT%┃
			PRINTFORML ┃%"날개 강화…… 쓸어버리겠습니다",72,LEFT%┃
		ENDIF
	;2999,피니투라・프레차
	;　＞飛具、威力380、単体、魔、消費18　破魔即死20-40
	;　命中がなんと300。標準的な攻撃の３倍の命中率を誇る。
	;　また、「飛具の魔法攻撃」は極めてレア。……って言いたいけど、東方系にわりとあるんだよねぇ。
	;　/
	;　まどか、まど神さまの必殺技。
	;　意味は「仕上げの矢」。イタリア語ですねぇ…………
	ELSEIF CFLAG:ARG:입력행동 == 2999
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Finitora Freccia……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"마법소녀·카나메 마도카를 재연……",72,LEFT%┃
			PRINTFORML ┃%"마무리로 들어가겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"마법소녀·카나메 마도카를 재연……",72,LEFT%┃
			PRINTFORML ┃%"……맞히겠습니다.",72,LEFT%┃
		ENDIF

	;3587,마법의비눗방울
	;　＞水撃、威力180、全体、魔、消費21
	;　命中、回避を弱化し、BS付着率を上昇させる。
	;　消費の軽めな全体攻撃でもあり、威力不足でも使う価値がある
	;　/
	;　百江 なぎさの必殺技。
	ELSEIF CFLAG:ARG:입력행동 == 3587
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Magical Soap……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"마법소녀·모모에 나기사를 재연……",72,LEFT%┃
			PRINTFORML ┃%"매지컬 버블, 레디……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"마법소녀·모모에 나기사를 재연……",72,LEFT%┃
			PRINTFORML ┃%"매지컬 버블, 레디……",72,LEFT%┃
		ENDIF
	;3700,대성이혼포격
	;　＞飛具、威力600/450、拡散、物、消費0　ゲージスキル　火炎炎上35-95
	;　命中85。
	;　ティロ・セントドッペリオン。
	;　ゲージ100％以下では使用できない。
	;　ゲージは１度使うたびにリセットされる。
	;　・ダメージを与えた敵の数の分だけ１点上昇
	;　・会心、または弱点を与えると１点上昇
	;　・ティロ・フィナーレを使用すると５点上昇
	;　・ダメージを受けた場合、「60*現HP割合」（最低2点）上昇
	;　ちょっと上昇が鈍いかも。
	;　ともあれ、ダメージそのものは非常に高い。
	;　/
	;　ホーリーマミ、ホミさんの必殺技。
	;　「礼拝のドッペル」を使った技とのこと。
	ELSEIF CFLAG:ARG:입력행동 == 3700
		IF 0
		;おそらくは、「Tiro St. Doppelion」。
		;「ドッペル」部分は、マギアレコードの設定上「ドッペルゲンガー」の意だろう。
		;St.については、イタリア語だと「S.」だけになるのだが、「イタリア語・英語・ドイツ語」ってなるのが面白かったので……
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"홀리 나이트：Tiro St. Doppelion……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"차지 완료……",72,LEFT%┃
			PRINTFORML ┃%"티로·피날레／홀리 나이트, 세인트 도펠리온……!",72,LEFT%┃
		;なんかブリーチみを感じる……
		ELSE
			PRINTFORML ┃%"마법소녀·성야·홀리 마미를 재연……",72,LEFT%┃
			PRINTFORML ┃%"대성이혼포격……！",72,LEFT%┃
		ENDIF

	;その他・多分死に分岐
	ELSEIF CFLAG:807 >= 3
		IF RAND:2 == 0
			PRINTFORML ┃%LOCALS + "을(를) 재현합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"소녀의 소원을 재연합니다……",72,LEFT%┃
		ENDIF
	ENDIF


;-------------------------------------------------
;○幻想郷系
;とりあえず喋るようにはなる→だいぶ喋るようにしました。多分すべてカバーしたはず。
;結構範囲広いな……まあこの辺喋れれば大丈夫でしょう、みたいな。
;当然のようにマスパとか引き継げる造魔ちゃん
;キーワードは、再現・再演
;/
;枠圧迫もあり、虹以後のキャラクターについては、CSTR専用スキルでの実装となっている。
;造魔ちゃんでは、改造しないともってこれないので、さすがにMURIであるとし、評価もしない。むねん。
;-------------------------------------------------
;前半は旧作系っぽい
ELSEIF RANGE(CFLAG:ARG:입력행동,2601, 2630) || RANGE(CFLAG:ARG:입력행동,2800, 2987)
	IF 0
	;2601,확산탄막사출
	;　＞飛具、威力70*2-3、全体、魔、消費12　単体最大ヒットは３
	;　極序盤、あるいはＣＯＯＰ取り用の全体攻撃として、かなりコストが軽い。
	;　複数回攻撃なので、物理のほうが嬉しいトコロだが……
	;　/
	;　拡散弾。文字通り、拡がるように放たれる弾。
	;　……と言っても案外種類がある。
	;　大雑把に分類すると、「自機狙いであるかそうでないか」「弾の軌道は固定であるか」。
	;　===========================
	;　・自機狙い拡散弾
	;　　奇数弾とも言われる。動かなければ当たる。弾の軌道は自機依存。
	;　　　▽
	;　　／｜＼　　←こんな感じで撃ってくるやつ。
	;　　見た目こそ派手だが、敵が３Ｗａｙ（以上の）ショットを放ってきてもぶっちゃけ大半の弾に意味はない。自機に向かう弾のみ回避すればよいからだ。
	;　　弾幕ゲーの基本オブ基本。無駄な弾こそ美しい。
	;　・自機外し拡散弾
	;　　偶数弾とも呼ばれる。動くと当たる。弾の軌道は自機依存だが、動かなければ当たらない。
	;　　当然これ単体では撃墜されないので、「画面を狭める」ために使用されることが多い。
	;　　　▽
	;　　 ｜｜　　←こんな感じで撃ってくるやつ。コレは動かなければ間を抜けることができる。
	;　・固定弾
	;　　弾幕ゲーの華。弾の軌道は完全固定。画面依存、敵機依存、と言い換えてもいい。
	;　　もはやステージギミックに近い。
	;　　ボスの周囲では固定軌道を描き、その後自機狙いになる……といった弾幕も存在する。
	;　　途切れなく固定連射されるものを、とくに「ワインダー」と呼ぶ。
	;　　ふつう人間が抜ける想定はされないが、稀に「ワインダー抜け」をクリアに必須とする鬼畜ゲーもあったり。
	;　・ランダム弾
	;　　ランダムで射出される。気合避けが必須。弾の軌道も当然ランダム。
	;　　　▽
	;　　. ..　.　←こんな感じでパラパラと撃ってくるものが多い。
	;　　基本的に密度は薄いが、「こうすれば避けられる」がないため、気合が必要になる。
	;　===========================
	;　根本的に、ＳＴＧというのは「敵から弾が発射されるのを回避する」ゲームであり、「敵から放たれる弾の軌道」には「発生場所」の縛りがある。
	;　組み合わせや速度の設定、敵機体自体の動きとかで、色々差異をつけてるわけだなぁ。
	ELSEIF CFLAG:ARG:입력행동 == 2601 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"불릿：Spread Danmaku……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"마력탄 형성…… 탄막을 형성합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"魔力弾、放散射撃……",72,LEFT%┃
		ENDIF
	;2602,집중탄막사출
	;　＞飛具、威力90*2-3、単体、魔、消費10
	;　こちらはとくに見るべきところはないかしら。んー。
	;　/
	;　拡散が美しさを主眼とするなら、集中弾はわりと「殺しに来る」弾幕。
	;　基本的には、「自機狙い弾」となる。「合間をすり抜ける」のが難しい、弾のカタマリが放たれたりするわけだな。
	;　稀に「自機の反対を狙い、画面外からランダム弾が降ってくる」とかもないではないけど。
	;　自機狙い弾、それも合間を抜けるのが難しい弾幕であっても、理論上「無限に一方向に移動し続ければ自機狙い弾には当たらない」。
	;　（もちろん、拡散弾でヨコに移動し続けることができなかったり、そもそも画面端というものがあるわけだけど）
	;　それを避けるためには、「→」から「↑」に移動するとよい。
	;　もちろん、↑は↑で、画面端もあるし、弾丸の密度も濃い。
	;　じゃあどうするかというと、「避けた弾を跨ぐ」という手法がある。これを切り替えしと呼ぶ。
	;　一瞬左に振ったうえで↓に動けば、そこにはもう弾幕はない、通り過ぎているのだ。大体のパターンでは。たまにボスの周りを大回転しろとか言われるから困る。
	ELSEIF CFLAG:ARG:입력행동 == 2602 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"불릿：Focus Danmaku……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"마력탄 형성…… 탄막을 사출합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"魔力弾、集中射撃……",72,LEFT%┃
		ENDIF
	;2603,The Positive
	;　＞火炎、威力400、全体、魔、消費30　呪殺即死40-75
	;　またの名を陽撃陰波。
	;　ポジティブって名前なのに呪殺即死なの笑いますわね。
	;　143で強化された結果、デドバ系に近いスペックなのでまあ強い。
	;　/
	;　SinGyoku専用技の１。
	;　SinGyokuは、俗にいう「旧作」の出身で、「スペルカード」を持たない。
	;　このスキル名は、SinGyokuの曲、「The Positive and Negative」から取られているのだろう。
	;　以下、旧作キャラはだいたい、曲名がスキル名になっている。
	;　ふたつあるのは、SinGyokuが「陰陽玉形態」「陰陽師風の男性（？）」「여성」形態を入れ替えるところからか。
	;　ちなみにコレのせいで、eratohoではだいたい「TSできる」とか「なんか生えてる」とかそういう設定がされる。
	ELSEIF CFLAG:ARG:입력행동 == 2603
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: [The Positive]……",72,LEFT%┃
		;陽を思うこと、すなわち、今は陰であるということ
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"양격음파…… 양을 생각하라……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"주염에 쫓겨, 지옥으로 향하라……",72,LEFT%┃
		ENDIF
	;2604,The Negative
	;　＞水撃、威力400、全体、魔、消費30　破魔即死40-75
	;　またの名を陰撃陽波。
	;　ネガティブって名前なのに破魔即死なの笑いますわね。
	;　こちらもデドバ系に近いスペックになっており、専用スキルとして使える強度になったかと思う。
	;　/
	;　SinGyoku専用技の２。
	;　ちなみに、SinGyokuが登場する「東方靈異伝」。
	;　東方Projectの第一作であるが、上で弾幕について解説しといてナニであるが、こちらブロック崩し（パネルめくり）なのであった。
	;　SinGyokuは、だいたい１面ボスに相当するポジションだったりする。まあ、二つ名、「門番」だしね。
	ELSEIF CFLAG:ARG:입력행동 == 2604
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: [The Negative]……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"음격양파…… 음을 생각하라……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"성수에 길이 가로막혀라, 이제 하늘로 떨어지는 수밖에 없다……",72,LEFT%┃
		ENDIF
	;2605,Evil Eyes
	;　＞精神、威力140*2、全体、魔、消費30　精神特殊85-95
	;　与える状態異常は、たぶん下記からランダム。
	;　＞HAPPY,SHOCK,PANIC,SLEEP,FREEZE,BIND,CLOSE,POISON,BOMB,CHARM
	;　なんだかんだ全体に高確率で状態異常をばらまくというのは強いとは思うが……
	;　/
	;　YuugenMaganの専用技。
	;　era的に言うと、東方原作では珍しい男性キャラ設定。
	;　目玉のばけものなので、男女があるのかとかそういう部分はあるが。
	ELSEIF CFLAG:ARG:입력행동 == 2605
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: [Evil Eyes]……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"재앙의 눈을 뜹니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"중련마안 조성…… 눈동자여 비춰라, 가라앉아 엎드린 그 모습을……",72,LEFT%┃
		ENDIF
	;2606,Innocent Devil
	;　＞支援、威力0、自身、魔、消費25　バフ有り
	;　회피+2＆컨센트레이트。
	;　以前は「명중＋１、回避＋２」だった。できれば命中も上がってほしいところだが……
	;　/
	;　"無邪気な悪魔"、Elisの専用技。
	;　またの名を蝙蝠変化。
	ELSEIF CFLAG:ARG:입력행동 == 2606
		IF 0
		ELSEIF RAND:3 == 0
