;-------------------------------------------------
;○専用スキル
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,2697, 2800)
	IF 0

	;2698,찰나의칼날・이
	;　＞剣撃、威力200、単体、物、消費20　剣撃即死45-90
	;　真４Ｆ、トキ専用スキル。
	;　単体攻撃としては消費は重いが、剣撃相性での即死が可能。
	ELSEIF CFLAG:ARG:입력행동 == 2698 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Temporal Blade II……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"찰나의 칼날·이식…… 일도양단……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"魔剣発動、刹那刃弐式……",72,LEFT%┃
		ENDIF
	;2699,찰나의칼날
	;　＞剣撃、威力250、全体ランダム、物、消費20　剣撃即死45-90
	;　真４Ｆ、トキ専用スキル。
	;　「全体のどれか一体に」「一回だけ」공격。
	;　全体ランダム系攻撃はデメリットが目立つが、これは群を抜いている。ああ、もちろん下のほうに。
	;　剣撃相性での即死が可能ではあるが、正直使い物になるかというと怪しい。
	;　速度が速いとあるが、＋３の速度補正は、正直微妙。
	ELSEIF CFLAG:ARG:입력행동 == 2699 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Temporal Blade I……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"찰나의 칼날·일식…… 광참수……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"魔剣発動、刹那刃壱式……",72,LEFT%┃
		ENDIF
	;2700,갑옷관통・弐
	;　＞剣撃、威力220、単体、物、消費12　バフアリ
	;　ラクンダ効果。
	;　真４Ｆ、トキ専用スキル。
	;　ちなみに「壱」のほうは剣撃ガーキル効果付き。
	;　……まあ……一のほうが強いんじゃないか……
	ELSEIF CFLAG:ARG:입력행동 == 2700 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:100 == 0
			PRINTFORML ┃%"스테이크……! 전탄, 드리겠습니다……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Pierce Armor II……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"갑옷 따위 무의미합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"그 갑옷, 관철해 내겠습니다……",72,LEFT%┃
		ENDIF
	;2701,ピュプリレゲドン
	;　＞火炎、威力800、拡散、魔、消費70　火炎炎上30-95
	;　アバチュ勢、ゲイル、ルーパ専用スキル。
	;　純粋火力は最強クラスである。
	;　追加効果はまあまあ無難なものだが、なにか変な効果もなく、純粋に強力。
	;　/
	;　「ピュプリレゲドン」でググっても出てこなかったのでちょっと「フレゲトン」で調べなおした。
	;　すると出てきたのでやっぱり表記ゆれって怖いなー。
	;　さて、プレゲトーンとは、ギリシャ神話において冥府を流れる焔の川である。燃え盛る炎、という意味な。
	;　「ピュ“リプ”レゲトーン」とも呼ばれる。そりゃググっても出てこんわ。
	ELSEIF CFLAG:ARG:입력행동 == 2701
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"이럽션：Pyriphlegeton……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"펄펄 끓는 노래를 연주하라, 불꽃의 흐름이여……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"이것은 오케아노스와 아켈로오스의 틈새를 흐르는 것……",72,LEFT%┃
			PRINTFORML ┃%"불의 영역으로 흘러 지중해보다도 넓은 끓어오르는 물과 진흙……!",72,LEFT%┃
		ENDIF
	;2702,극락떨구기・개
	;　＞多段/지변/火炎、威力460+230、単体、魔、消費45
	;　P1、アヤセ専用スキル。正確には、その発展ペルソナのフレイアのスキル。
	;　造魔ちゃんではおそらく習得できないはず。
	;　威力460と230の多段攻撃であり、このクラスの威力の攻撃としては消費がかなり低い。
	;　……改、というだけあって、スペックはかなり違う。
	;　「地変、威力210/130*2、拡散、魔、消費20」
	;　元々はこんなんなので、どこをどうやった、感がある。
	ELSEIF CFLAG:ARG:입력행동 == 2702
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"스킬 코드: Gokuraku Fall Mod……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Heaven Drop II……",72,LEFT%┃
		;鬼符「大江山悉皆殺し」。
		;天則における、おそらく最大ダメージのスペル。ガード不能の投げ技。
		;ただし威力以外のスペックは低く、極短射程、暗転見てからジャンプ余裕、スーパーアーマーなどなし……とキツい。
		;正直一番生当てで食らいたくないスペルである。いちおう「特定のスペカをグレイズ後」など、全キャラに確定状況があるはずだが。
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"바위를 모아…… 나, 남김없이 모두 몰살하리라……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"……岩塊選定……O.K.",72,LEFT%┃
			PRINTFORML ┃%"筋力強化……岩塊強化……대염상……",72,LEFT%┃
			PRINTFORML ┃%"영…… 차……",72,LEFT%┃
			PRINTFORML ┃%"……던지겠습니다……!",72,LEFT%┃
		ENDIF
	;2703,릴리즈제일・개
	;　＞多段/빙결/破魔、威力280+140、全体、魔、消費45　破魔刻印45-95
	;　P1、エリー専用スキル。
	;　命中80とやや不安。
	;　氷結攻撃としてみると威力も下がっているのが辛い。
	;　これもおそらくペルソナ専用になるので習得できない。残念。
	ELSEIF CFLAG:ARG:입력행동 == 2703
		IF 0
		;英訳版だと「Lilith Jail Mod」だが、おそらくは百合の花の方だと思われる。
		;詳しくは、「릴리즈제일」のほうを参照。
		;というか、改と通常で名前が違うのどうなんだろう……？
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"스킬 코드: Lily's Jail Mod……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Lily's Jail II……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"다툼을 깔아뭉개는 연기색 하늘, 나는 서쪽에서 온 신의 힘……",72,LEFT%┃
			PRINTFORML ┃%"황야에 피어나는 백합꽃, 불꽃의 옷과 정화의 갑주를 둘러라, 절제자여……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"백합꽃 피는 감옥의 창가에서 보이는 것은 별인가 진흙인가……!",72,LEFT%┃
		ENDIF
	;2704,선풍진・개
	;　＞疾風、威力420、全体、魔、消費45　バフアリ
	;　P1、マキ専用スキル。
	;　ランダムで「～ンダ」効果を発揮。ランダムなのが惜しいが、まあまあ。
	;　これもおそらくペルソナ専用になるので習得できない。残念。
	ELSEIF CFLAG:ARG:입력행동 == 2704
		IF 0
		;というか、改と通常で名前が違うのどうなんだろう……？
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"스킬 코드: Hurricane Mod……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Whirlwind II……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"선풍 전주 공격, 기동합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"기압 상승…… 원환 형성…… 질풍의 진을 형성합니다……!",72,LEFT%┃
		ENDIF
	;2705,바이널스트라이크・개
	;　＞複合/만능/打撃、威力590、全体、物、消費20　反動ダメージ
	;　P1、ブラウン専用スキル。
	;　命中が140と高め。反動ダメージは999で固定。
	;　2700.バイナルストライクは敵専用だが、こちらはきちんと味方も使える。
	ELSEIF CFLAG:ARG:입력행동 == 2705
		IF 0
		;というか、改と通常で名前が違うのどうなんだろう……？
		;Binaryは、二進数とかのことをいう。
		;もう少し正確に言うと、「バイク」とかあるじゃん。あの「バイ」のあたり。
		;アレは古めの言葉で「２」という意味があり、色々くっついて「２みたいなの」……的な語幹になってるわけな。
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"스킬 코드: Binal Strike Mod……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Final Strike II……",72,LEFT%┃
		;これ書いてる時点で、北の勇者がそろそろ意地を見せそうなあたり。
		;勇者は何人いたっていいんだよなあ。
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"생명의 검, 기동…… 파이널 스트라이크……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"생과 사, 두 가지 값으로 나누겠다……!",72,LEFT%┃
		ENDIF
	;2706,바이라바
	;　＞万能、威力125*4-6、単体、物、消費60
	;　アバチュ勢、ジェナ専用スキル。
	;　速度が速い、とあるが、補正は+3。うーん、イマイチ……
	;　とはいえ、純粋に強力な打撃であることは間違いない。
	;　速度補正については、44.クイックスピアのあたりを参照されたい。
	;　/
	;　바이라바……Bhairavaとは。
	;　畏れるべきもの、恐ろしいもの……という意味合いを持つ名で、シヴァの恐怖的な側面。
	;　そう呼ばれる側面においても、嫁さん大好きエピソードがあるあたり、シヴァって人気者なんだなー、って感じがある。
	;　/
	;　あるいは、「大威徳明王」……密教における明王の一尊……かもしれない。
	;　あだ名のひとつが、ヴァジュラバイラヴァ、なのだ。
	;　大威徳明王は、阿弥陀如来/文殊菩薩の教令輪身ともされる。
	;　教令輪身とは、1041,軍荼利降魔砲で詳しく書いたが、つまり「テメェらに教える明日はねぇ」とブチ切れた姿である。
	;　（もちろん、そういう恐ろしい面を見せることで導く……という面もあるが）
	ELSEIF CFLAG:ARG:입력행동 == 2706
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Bhairava……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"바즈라 바이라바―― 금강위덕, 항마포……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"真言自動再生――",72,LEFT%┃
			PRINTFORML ┃%"“옴 슈치리 캬라로하 훔 켄 사바하”",72,LEFT%┃
			PRINTFORML ┃%"――金剛威徳、降魔砲……！",72,LEFT%┃
		ENDIF
	;2707,바이쿤타
	;　＞万能、威力400、全体、魔、消費60　呪殺石化70-95
	;　アバチュ勢、ジェナ専用スキル。
	;　速度が速い、と書いてないが、補正は+3。うーん。
	;　味方側が使える石化はそこそこレア。いちおうニアメギドラオンなので、まあまあ使えるとは思う。
	;　/
	;　바이쿤타。
	;　ヴィシュヌの居城……宮殿であり、南天の極にあるという。
	;　今更だが情報はとりあえずとっかかりをwikipediaから持ってきて引用してるので、日本語版がないページだとちょっとキツイ。
	;　ともあれ、これ攻撃スキルの名前か……？というと、んー。
	ELSEIF CFLAG:ARG:입력행동 == 2707
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Vaikunta……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"남천의 극치에 자리하라……!",72,LEFT%┃
		;ヴィシュヌという名には、「遍く満たす」という意味がある
		ELSE
			PRINTFORML ┃%"비슈누의 거처를 구축―― 널리 공간을 가득 채워라 신력이여……!",72,LEFT%┃
		ENDIF
	;2708,분노의정격
	;　＞複合/지변/수격/疾風、威力600、単体、魔、消費50
	;　弱点をサーチし、その相性以外のふたつを弱点に変更する。
	;　……いちおうイナンナが習得するから専用ではないのかァ……？
	;　ともあれ、弱点が増えるほどの強さはないので、たぶん封印安定。
;	ELSEIF CFLAG:ARG:입력행동 == 2708
		;분노의정격/土砂/豪雨/旋風
		;Scorching Triblow/Earth/Rain/Wind
	;2709,분노의온격
	;　＞複合/화염/빙결/電撃、威力600、単体、魔、消費50
	;　だいたい同上。
;	ELSEIF CFLAG:ARG:입력행동 == 2709
		;분노의온격/業火/豪雹/뇌광
		;Scorching Tribolt/Flame/Hail/Spark
	;2710,분노의물마
	;　＞複合/충격/중력/核熱、威力600、単体、魔、消費50
	;　だいたい同上。
;	ELSEIF CFLAG:ARG:입력행동 == 2710
		;분노의물마/大嵐/星圧/熱核
		;Scorching Tribeam/Blow/Crush/Fusion
	ELSEIF RANGE(CFLAG:ARG:입력행동,2708, 2710)
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Scorching Custom……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"달아올라라, 속성이여……",72,LEFT%┃
		;萌えないのでRANDは手を抜きました（懺悔）
		ELSE
			PRINTFORML ┃%"달아올라라, 속성이여……",72,LEFT%┃
		ENDIF
	;2711,진・천경지폭단
	;　＞剣撃、威力680、単体、物、消費30　CT50　特殊貫通
	;　命中3。命中、＼３／
	;　気合、または切り落とし状態である場合、攻撃が貫通になる。
	;　実質、切り落としを使ってから使用してね、というスキル。
	;　天驚地爆断が命中60と「命中がかなり怪しい」スキルではあるのだが、
	;　命中が爆下がりした分CT50が追加され、さらに切り落としで貫通までついてお値段据え置き。
	;　スマイル状態で貫通するスキルはままあるが、気合でも貫通するようにしたのは、「切り落としの必中状態がないと当たらない」から。
	;　/
	;　ゴトウ×ほむほむのクロスオーバーイベントで習得する。
	;　作ったのわしなんだけどそれっぽいスキルには仕上がったと思う。自画自賛。
	ELSEIF CFLAG:ARG:입력행동 == 2711
		IF 0
		ELSEIF CFLAG:ARG:회심의패기플래그 > 0
			IF 0
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"자 우러러보아라, 하늘마저 가르는 일도를……!",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"쓰러져 엎드려라, 대지마저 부수는 일도로써……!",72,LEFT%┃
			ENDIF
		;英訳版で「True Sky Break」と訳してもらったが、
		;真でない方は「Earth Slicer」。
		;「天を砕く」か「地を切り裂く」か、訳が正反対なのは面白い。
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"데몬스트레이트: True Sky Break……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: True Earth Slicer……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"베어 부수겠습니다……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"심안으로…… 포착할 수 있다면 좋겠습니다만……!",72,LEFT%┃
		ENDIF
	;2712,폭철화의무대장치
	;　＞多段/비구/비구/비구/화염/核熱、威力特殊、全体、魔、消費50　威力については下記
	;　暁美ほむら専用スキル。
	;　威力は40+40+40+50+90＝260。各段に、知恵の半分が威力として加算される。
	;　知恵100/加算50が最大で、「90+90+90+100+140」で合計威力510の全体攻撃。
	;　命中は、ほむほむ以外が使用しようとすると＊120から25に低下する＊ため、他キャラだとたぶん使い物にならない。
	;　3相性の多段スキルとはいえ消費がかなり重く、最大効果を出すために知恵がかなり必要なので、ほむほむ当人でも、使い物になるかと言うとちょっと怪しい。
	;　知恵による威力補正もうちょっと上げてもよかったかなと、今見返すと思う。
	;　/
	;　ゴトウ×ほむほむのクロスオーバーイベントで習得する。
	;　またの名をホマンドー。舞台装置の魔女を爆殺するための舞台装置である。
	;　これは悪魔であるほむらの技なので、覚えることはできるが、上述の通り命中がクッソ下がるので使いものにならないだろう。
	;　/
	;　ちなみにというか、原作劇中で見せた『舞台装置』は、200億円近くに達する……という考察がある。
	;　軍需品は、基本的に、高い。
	ELSEIF CFLAG:ARG:입력행동 == 2712
		IF 0
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"매지컬 폭살 피타고라 스위치, 시동……!",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"舞台装置爆殺舞台装置、始動……！",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Explosive Stage Set……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"자 간다 코만도……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"폭열의 골드버그 장치를 개장합니다……!",72,LEFT%┃
		ENDIF
	;2716,전대의극의
	;　＞自動効果：HPが55に固定される代わりに、万能以外を反射する
	;　非常に強力な効果で、造魔ちゃんもフロストファイブから引き継ぐことができるが、複数体取得者がいると全相性が弱点になってしまう。
	;　万能攻撃（またはガーキル）やってこないヤツなら完全に完封できるわけだな。当然メチャクチャ強力。
;	ELSEIF CFLAG:ARG:입력행동 == 2716
		;Scorching Triblow/Earth/Rain/Wind
	;その他汎用
	ELSE
		PRINTFORML ┃%LOCALS + "(으)로 투멸시키겠습니다……!",72,LEFT%┃
	ENDIF


;-------------------------------------------------
;○悪魔狩人系
;悪魔狩人、そもそもがクッソ強いダンテをぶちのめさなきゃならんので許されるスキル群である。
;ダンテ撃破に際し一番手っ取り早いのは、たぶん、魔特化造魔ちゃんを用意して超メギド。
;たしかダンテは超高レベルでこそあれどレベルは固定なので、レベルを死ぬほど上げてもなんとかなる。
;暴力、やはり暴力がすべてを解決する。
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,2951, 2958)
	IF 0
	;2951,투섬타임
	;　＞飛具、威力90*6-8、全体ランダム、物、消費38　CT30　精神混乱30-70　単体最大ヒットは6
	;　専用の銃を装備することが必須であるため、造魔ちゃんには使えない。
	ELSEIF CFLAG:ARG:입력행동 == 2951
		PRINTFORML ┃%"스킬 코드: Twosome Time……",72,LEFT%┃
	;2952,홀리스타
	;　＞支援、威力--、全体、--、消費MP20　バフアリ
	;　つまりデクンダである。
	;　こういう小技も使えちゃうんだあ……感ある。
	ELSEIF CFLAG:ARG:입력행동 == 2952
		PRINTFORML ┃%"스킬 코드: Holy Star……",72,LEFT%┃
	;2953,라운드트립
	;　＞電撃、威力340、全体、魔、消費30　電撃感電15-95
	;　トリッシュが使うとまた派生するというかアレ。
	;　ここから3617,ハイボルテージとかそっちの方に派生する。
	;　これはナルカミ使ったほうがいいやつかな……？
	ELSEIF CFLAG:ARG:입력행동 == 2953
		PRINTFORML ┃%"스킬 코드: Round-Trip……",72,LEFT%┃
	;2954,휠윈드
	;　＞衝撃、威力340、全体、魔、消費30
	;　ふつうの攻撃……と言いたいところだが、衝撃スキルは強力な全体攻撃がなんか妙に少ないので、わりと最強クラスだったりする。
	ELSEIF CFLAG:ARG:입력행동 == 2954
		PRINTFORML ┃%"스킬 코드: Whirlwind……",72,LEFT%┃
	;2955,스팅거
	;　＞万能、威力370、単体、物、消費24　CT60　万能即死30-50
	;　命中120。
	;　KUSOBAKA。万魔の一撃が泣く。
	;　単純な威力では万魔パンチのほうが強いが、どっち使うかっていうとこっちだよねぇ。
	ELSEIF CFLAG:ARG:입력행동 == 2955
		PRINTFORML ┃%"데몬스트레이트: Stinger……",72,LEFT%┃
	;2956,쇼타임
	;　＞万能、威力420、全体、物、消費50　CT40　万能即死30-50
	;　物理依存メギドラオン。
	;　ラウンドトリップ、ワールウィンドはあるが、基本的に悪魔狩人は物理で育てる方がよい。
	;　万能即死？　クソだよ。
	ELSEIF CFLAG:ARG:입력행동 == 2956
		PRINTFORML ┃%"데몬스트레이트: Showtime……！",72,LEFT%┃
	;2957,歴戦の悪魔狩人/아버지의이름에맹세코
	;　＞自動：物理攻撃時、吸収・反射以外の耐性無視。また、敵に与える弱点・CTダメージが30％増加。
	;　悪魔狩人のあたまおかしい強さを支える自動スキル。
	;　パパに誓えば貫通できる！！！　って言ってておかしいと思わんのかい！！！　ってくらい強い。
	;2958,네버기브업
	;　＞DEAD時、HP全快で耐える。また、HP・MPが30％上昇
	;　不屈＋삼할의활천＋삼할의마맥。弱いわけがない。
	;その他汎用
	ELSE
	ENDIF

;-------------------------------------------------
;○メルブラ/Fate系
;魔法少女、東方と来て型月も来たか……（微笑み）ああ、月厨さ！！！
;やっぱり当然のように１７分割やりだす造魔ちゃん
;やっぱり造魔から生み出した存在は造魔にもどります（目ぐるぐる
;あ、もちろんですけどネタバレ注意な。
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,2959, 2990)
	IF 0
	;2959,보석마술
	;　＞支援、威力00、自身、魔、消費10+宝石1
	;　コンセ＋マカカジャ4段。
	;　ただし補給がやや難しい宝石類を一つ消費する。
	;　自己強化としては最高級のひとつで、かなり強力。
	;　→ｶｰﾁｬﾝ140で下記のごとき性能になった。
	;　＞複合/特殊、威力特殊、単体、魔、消費5+資金Lv*200(12000まで)　相性・威力は下記
	;　相性は「火炎、電撃」、Lv40からは「빙결」60からは「질풍」が追加される
	;　威力は「Lv*10。上限は600」。
	;　宝石の代わりに資金を使うようになった。だいぶ使いやすくはなったが、変更前の性能もまあまあ惜しい。
	;　額は……んまあ、まあまあ大きいが、それでも割合消費よりは安くつくだろう。
	;　/
	;　遠坂凛の使う魔術。
	;　宝石に魔力をストックしておくことで、現代の魔術士としては非常に強力な魔術をワンステップで使えるようになっている。
	;　……宝石なので、当然、高い。
	;　遠坂家は、土地の名家というやつで、本来なら「気軽には使いたくないけど、まあ仕方ないね」くらいの心持で使えるところを、
	;　親父からうまく家を継げなかった（というか後見人がわりとガチの善意でクソなことをした）ため、
	;　「グアアア使いたくなァアアアアい……！！！」くらいのノリで使うハメになっている。
	;　まあ作中、宝石魔術を使うときにはわりと思い切りよく使ってるんだが。高いと言っても、さすがに命よりは安い。
	;　eratenでも無尽蔵のリソースってほどではないので、強敵相手に使いたいところですね。
	;　ンまあ、「気軽には使いたくないけど、まあ仕方ないね」くらいのノリで使える感じ。
	;　ゲージスキル化したが、どうせボス戦などでしか使わないだろうと思われるので、5回も使用できれば十分だろう。
	ELSEIF CFLAG:ARG:입력행동 == 2959
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Jewel Magic……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"보석으로부터 마력을 보급합니다……",72,LEFT%┃
			SIF RAND:100 == 0
				PRINTFORML ┃%"가격에 대해서는 고려 대상에서 제외해 주셨으면 합니다만……",72,LEFT%┃
		;Ｅ缶。
		;ロックマン２から登場し、８とロクフォルには登場しない。
		ELSE
			PRINTFORML ┃%"E·탱크로부터 마력을 보충…… 내뿜겠습니다……",72,LEFT%┃
		ENDIF
	;2960,베어내는전신의검
	;　＞万能、威力500、単体、物、消費40　カウンター　CT30　반격
	;　起動することで、3ターンの間、物理攻撃に反応するカウンター攻撃が発生する。
	;　MPが40以上なければそもそも選択肢に現れない。
	;　当然ながら多重起動もできない。
	;　ただし、起動にターンは消費しない。
	;　/
	;　베어내는전신의검/フラガラック。フラガラッハ、応報するもの/アンサラーとも。
	;　ランク：C～D程度（ただし瞬間的にはA？）
	;　種別：不明（対切り札宝具？）
	;　レンジ：不明
	;　最大捕捉：不明（１？）
	;　ケルトの光神、ルーの短剣。
	;　Fateでの設定上は、「神話の時代から製法が伝えられてきた“現存する宝具”」。
	;　バゼット・フラガ・マクレミッツの家系が受け継いだ至宝。
	;　通常時はソフトボール大の石球だが、真名開放すると「短剣」が出現し、石球部分も水晶玉のように透明度を増す。
	;　これを手の甲あたりに固定して、パンチで加速させて撃ちだす……というものっぽい。
	;　発射後はレーザーじみた刃になるようで、『Fate/HA』作中では、バゼットが射出途中で体勢を崩されたシーンで、受けた側は身体を縦に裂くような傷を受けていた。
	;　その能力は「後より出でて先に断つもの」。
	;　敵の切り札を感知して射出され、敵の攻撃よりも先に敵を殺傷――
	;　――「敵は既に死んでいるので、攻撃は行われなかった」こととなる、因果逆転の魔剣。
	;　じゃんけんで例えると、「自分が先に手を出した」ことにして、「相手が手を出さなかった」ことにする……「相手を強制的に後出しにして敗北させる」能力を持つ。
	;　もう卑怯としか言いようのないやべー能力で、フラガラックを知らずのこととはいえ、現代に生きる人間が、神代に近い神秘を纏う英霊を幾度も打倒してみせた。
	;　とはいえ絶対無敵というわけではなく……
	;　「切り札に反応するので、切り札もクソもない相手に順当に詰まされるとダメダメ」
	;　「あくまで“１回勝つ”だけなので、相手が蘇生したりすると意味がない」
	;　「相手を殺しても攻撃がキャンセルされないなら意味がない」
	;　……という具合。
	;　まあこんなもん基本的に無敵だろうが、物語の都合上、あんまり「基本的な」相手に当たらない。
	;　Fate/HAで登場したんだけど、その時「逆光剣」「逆行剣」「後より出でて先に立つもの」「後より出でて先に断つもの」となんか表記ゆれしてた気がする。
	;　おまけシナリオでクソみたいな使われ方をしたことで有名。
	ELSEIF CFLAG:ARG:입력행동 == 2960
		;ここのは起動時のセリフ
		;　＞斬り抉る戦神の剣を使用しますか？(소비MP　40)
		;　＞[0]はい
		;　＞[1]いいえ
		;　＞0
		;　＞┏>CHARA━━━━━━━━━━┓　┏>ACT━━━━━━━━━━━━━━━━━━┓
		;　＞┃[ 1] 造魔ちゃん           ┃　┃베어내는전신의검                        ┃
		;　＞┗━━━━━━━━━━━━━┛　┗━━━━━━━━━━━━━━━━━━━━┛
		;　＞3ターン反撃が発動するようになった
		;　＞┏┓＠造魔ちゃん          　┏━━━━━━━━━━━━━━━━━━━━━━┓
		;　＞┃イグニッション：Fragarch……                                            ┃
		;　＞┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		;……こんな感じで出る。

		;「じゃん、けん、死ねぇ！を保存するためにゲージを使う（CFLAGがやや勿体ないので）
		;使用ごとに低確率でゲージが１になり、トリガースキルの方で「じゃんけん死ねぇ！」を言う
		;※Hは戦闘ごとにリセットされる
		CFLAG:고유게이지H2 = 0

		IF 0
		;じゃん、けん、死ねぇ！！！　の前振り
		ELSEIF RAND:20 == 0
			PRINTFORML ┃%"안, 내면, 진 거……",72,LEFT%┃
			CFLAG:고유게이지H2 = 1
		ELSEIF RAND:9 == 0
			PRINTFORML ┃%"달려 날뛰어라, 전쟁신의 검――!",72,LEFT%┃
		;『Fate/HA』における、……誤字……？
		;逆光剣、と、逆行剣、の二種の表記があった。
		ELSEIF RAND:9 == 0
			PRINTFORML ┃%"――“逆行剣”……",72,LEFT%┃
		ELSEIF RAND:8 == 0
			PRINTFORML ┃%"――“逆光剣”……",72,LEFT%┃
		ELSEIF RAND:7 == 0
			PRINTFORML ┃%"――“앤서러”……",72,LEFT%┃
		;格ゲーやってて「なにやったらいいんだコイツ」ってなるとマジで絶望するよね
		ELSEIF RAND:6 == 0
			PRINTFORML ┃%"당신에게는―― 이미, 더는…… 누를 버튼이 없음을 알도록 하라……!",72,LEFT%┃
		;詳しくは「0534,切り落とし」参照だが、これも大魔王バーン様のセリフをイメージ。
		;これは「天地魔闘の構え」二回目のセリフ。
		;正確には、「天よ　叫べ!!!!」「地よ!!!唸れ!!!!」「今　ここに!!!」「魔の時代　来たる!!!!」「さあッ!!!刮目せよっ!!!!」。
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"하늘을 가르고 대지를 꿰뚫는다―― 지금 여기에 신대는 회귀한다……!",72,LEFT%┃
			PRINTFORML ┃%"자, 괄목하라……!",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"――神代回帰、現存伝承、起動……",72,LEFT%┃
			PRINTFORML ┃%"자, 괄목하라――!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"이그니션：Fragarch……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"――“앤서러”……",72,LEFT%┃
			PRINTFORML ┃%"이것이야말로 뒤에 나와서 먼저 베는 것……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"……광신 루의 권능을 재연…… “응답하는 검(프라가라흐)”, 전개……",72,LEFT%┃
		ENDIF

	;2961,산맥을뒤흔드는샛별의장작
	;　＞複合/충격/전격/파마/飛具、威力500、全体、魔、消費60　バフ有り
	;　攻撃前にマカ・サマカジャ、これは+8を超過する（攻撃後、最大8までに補正される）
	;　上記性能は144+修正1のもの。
	;　おそらく造魔ちゃんは習得できない。
	;　/
	;　산맥을뒤흔드는샛별의장작＜アンガルタ・キガルシュ＞。
	;　またの名を、ジュベル・ハムリン・ブレイカー。
	;　ランク：A++
	;　種別：対山宝具
	;　レンジ：999～???
	;　最大捕捉：???
	;　イシュタルが、自らの司る金星を「装填」しぶっ放す、山をぶっ飛ばす砲撃。
	;　エビフ山を「気に食わないな」でズカズカ入り込んで山頂を掴んで、槍を山の心臓にブッ刺して破壊したとか。
	;　そのせいで、エビフ山が崩れてしまったとか、なんとか。
	;　現代で言うザグロス山脈、トルコとイラクの間あたりにある山は一部、崩れ去ったような形をしているそうなのだが、その起源のお話、といえるだろう。
	;　いや無茶苦茶だなお前。
	ELSEIF CFLAG:ARG:입력행동 == 2961
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"비너스 스트라이크：An Gal Ta Ki Gal Se……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"아득한 하늘에서 위대한 대지로 보낸다……",72,LEFT%┃
			PRINTFORML ┃%"이것이야말로, “산맥을 뒤흔드는 샛별의 장작”……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"아득한 하늘에서 위대한 대지로 보낸다……",72,LEFT%┃
			PRINTFORML ┃%"이것이야말로 가장 파괴적이며 잔인한 행위……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"이것이야말로 에비흐산마저 전율케 하는 샛별의 일격……",72,LEFT%┃
			PRINTFORML ┃%"――제벨 함린 브레이커……!",72,LEFT%┃
		ENDIF
	;2962,영봉을밟고끌어안는명부의풀무
	;　＞複合/지변/타격/중력/呪殺、威力350、全体、魔、消費60　バフ有り
	;　味方全体に、ラクカジャ、テトラジャを同時に付与する。
	;　上記性能は144+修正1のもの。
	;　/
	;　영봉을밟고끌어안는명부의풀무＜クル・キガル・イルカルラ＞。
	;　ランク：A
	;　種別：対山宝具
	;　レンジ：10～999
	;　最大捕捉：1000人
	;　エレシュキガルが、地の底――自らの司る冥府より放つ、地震・地殻変動によってエビフ山を崩壊させるアースインパクト。
	;　威力こそイシュタルの宝具に劣るが、周囲を冥界に塗り替える能力を伴う。
	;　冥府の女主人たるエレシュキガルが守りを与えることができるようになるようだ。
	ELSEIF CFLAG:ARG:입력행동 == 2962
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"어스 임팩트：Kur Ki Gal Irkalla……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"땅속 밑바닥으로부터 하늘에 빛나는 별로 보낸다……",72,LEFT%┃
			PRINTFORML ┃%"이것이야말로, “영봉을 밟고 끌어안는 명부의 풀무”……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"이것이야말로 에비흐산마저 짓밟는 명부의 풀무……",72,LEFT%┃
			PRINTFORML ┃%"――쿠르 키갈 이르칼라……!",72,LEFT%┃
		ENDIF
	;2965,신언마술식・잿빛신부
	;　＞万能、威力450、単体、魔、消費50
	;　特に追加効果などはないが、単純に強力なワンパン。メギドラオンの方を使いたいかなぁ。
	;　/
	;　灰の花嫁/ヘカティック・グライアー。
	;　宝具ではない。
	;　キャスター/メディアの"必殺技"と言える攻撃。上空に浮き上がり、全力の魔術攻撃をぶち込む技。
	;　ひとつの魔術というよりは、ある種のセットプレイ、連射型のフィニッシュムーブと言うべきだろう。
	;　彼女の宝具は、まあ、なんだ……FGOではナイフめった刺しお姉さんと化してるんだが……
	;　ともあれ、宝具は攻撃能力に乏しいものであるため、ゲーム的に“派手”なものが必殺技枠に入ったというか。
	;　「ゲージ技が『デカジャダイン』なので、アギダインをめっちゃ連打してるのが必殺技になってる」感じ。
	;　名はおそらく、「ヘカテの」を意味する語と、コリントスの王女グライアのことだろう。
	;　「神言魔術式」がヘカティックに対応するか。
	;　メディアはアルゴー号の船長、イアソンと、まあめちゃくちゃなんやかんやあって結婚していたのだが、
	;　コリントスという土地にたどり着いたところで、イアソンはコリントスの王から
	;　「わし、グライアって娘おるんじゃけど、結婚して王になってくれん？」と申し出をされる。
	;　イアソン、「するする！！！」と即答。メディアを離縁し結婚……するのだが、当然メディア、キレる。
	;　キレた勢いでコリントスを焼き尽くした彼女は、もはや故郷にも戻れず、ギリシャの地をさまよい続けたそうな。
	;　イアソンは生き残るんだけど、アルゴー号の残骸に寄り掛かったところで崩れて潰されて死んだそうな。
	;　灰の花嫁とは、国ごと灰と化したグライアさんのことで相違あるまい。かわいそう。
	;　/
	;　「グライア」とは、ギリシャ神話の怪物3姉妹のこともさす。
	;　グライア、グライアイとも表記される彼女らは、ゴルゴーンの姉妹である。
	;　生まれた時から彼女たちは灰色の髪をしていたため、人々は彼女たちを「老婆/グライアイ」と呼んだ。※おそらく英語の「Gray」と同根の言葉だろう※
	;　（グライアイはひとつの眼や歯を共有して暮らしているとされ、その意味では本当に老婆だったのかもしれない）
	;　ちなみにというか、メディアはペルセウスのことをわりと嫌っているのだが、グライアーもペルセウスにヒドい目に遭わされている。
	;　そのあたり共感が彼女にもあるかもしれない。
	ELSEIF CFLAG:ARG:입력행동 == 2965
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"캐스트：Machia Hecatic Graea……",72,LEFT%┃
		;田中敦子さんのボイス大好き
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"술리…… 절리…… 세상의 이치……",72,LEFT%┃
			PRINTFORML ┃%"……이것은, “헤카테식：회발 삼괴 마도포”……",72,LEFT%┃
		;魔女メディアはコルキスの王女。
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"콜키스의 마도를 받아라……",72,LEFT%┃
			PRINTFORML ┃%"……이것은, “헤카테식：회발 삼괴 마도포”……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"신대 언어 로드…… 술식 해동, 다중 전개…… 조준……",72,LEFT%┃
			PRINTFORML ┃%"……이것은, “헤카테식：회발 삼괴 마도포”……",72,LEFT%┃
		ENDIF
	;2966,무한의검제
	;　＞剣撃、威力150*5-9、全体ランダム、物、消費90　単体最大ヒット未設定！
	;　かなり強力、というか最強クラス……ではあるのだが、消費90はさすがにおっもい！！！
	;　単体への攻撃力は単純計算で750スタートなのだが、このMP消費なら許されよう。
	;　物理攻撃なので、物理系悪魔のMP量を考えれば、さすがに辛いというか。
	;　威力410の虚空斬波が消費35で、物理型だとこれでも結構消費が辛い。
	;　消費90ともなると、一般的なステの（MAG強化や香の暴力をしてない）前衛型では、かなり継戦能力が落ちる。
	;　/
	;　무한의검제＜Unlimited Blade Works＞。
	;　ランク：E～A++
	;　種別：???
	;　レンジ：???
	;　最大捕捉：???
	;　アーチャー/英霊エミヤの最大にして起源の魔術。
	;　彼は固有の宝具を持たないが、これが実質的な宝具扱いされる。
	;　英霊エミヤはFateオリジナルの（＝現実には元ネタとなる英雄がいない）人物である。
	;　英霊エミヤの用いる魔術はすべてこの魔術に端を発する。
	;　「内面世界/心象世界である『剣が突き刺さった丘』に周囲を塗り替える」というもの。
	;　「見たことのある剣のデータをコピーし蓄える」ことができ、丘には無数の剣が突き立っている。
	;　塗り替えた先の世界は、『エミヤの内面世界』なのでいろいろある程度は自由で、
	;　剣を手元に引き寄せるとか、剣を浮かせて飛ばすとか、そういうことをやっている。
	;　コピーできるのは基本的に『검』なのだが、どうやら槍や盾、鎧などの白兵戦武器であるとか、銃弾であるとか、剣型のビーム発射機であるとか、
	;　あるいはお値段20万円の釣りざおであるとか、無理すればもうチョイ範囲を広げることができるらしい。
	;　彼はこの世界から武器を『引き抜いて』使用することが多いようだ。
	;　（剣を射出するのは『引き抜く』ときの工夫だろうと思われる）
	;　また、コピー品であるので、失ったり、自分から破壊しても再生産が可能。というか、同じ武器を３つ作って同時に使用する場面がある。
	;　個人的には、『再生産の魔力どこから持ってきてんの？』ってのがずっと気にかかっている。
	;　/
	;　これらはすべて、彼の属性が『검』であるのが原因。
	;　Fate世界ではふつう、炎とか風とかの五大元素が属性になるのだが、たま～に彼のようになんか変な属性が現れるらしい。
	;　とある二次創作で……
	;　＞「彼が回復魔術を使う場合、『검→剣の具象化→トランプのスートのスペード→スートのハート→心臓→生命力→회복』……
	;　＞　みたいなステップを踏まなきゃいけない」
	;　という設定を見たことがあるが（あくまで二次設定）、この設定が違和感あんまない。
	;　格ゲーでは「背景変更技」かつ「モードの永久変更の強化技」であり、あんまり類をみない。
	ELSEIF CFLAG:ARG:입력행동 == 2966
		$SKILL_2966_TOP
		IF 0
		;こちらも有名なセリフですねえ。
		ELSEIF RAND:6 == 0
			PRINTFORML ┃%"伝承弱点把握。装剣制定。錬鉄完了――",72,LEFT%┃
			PRINTFORML ┃%"――별로.",72,LEFT%┃
			PRINTFORML ┃%"쓰러뜨려 버려도 상관없겠습니까, " + CSTR:이인칭 + "……",72,LEFT%┃
		;「――さらばだ。夢を抱いて溺死しろ」
		;有名なセリフですことね。
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"……작별입니다. 꿈을 베개 삼아 전사하시는 편이 좋을 듯합니다만……",72,LEFT%┃
		ELSEIF RAND:4 == 0
			;確率をそろえたいのでこうしておく
			;たぶん大丈夫なはず……陥落してないともう一回です。
			SIF 陥落() == 0
				GOTO SKILL_2966_TOP
			PRINTFORML ┃%"――나의 몸은 사랑으로 되어 있다",72,LEFT%┃
			PRINTFORML ┃%"혈맥은 공허하고 눈동자는 유리",72,LEFT%┃
			PRINTFORML ┃%"끝없는 전장을 넘어 물러섬 없이",72,LEFT%┃
			PRINTFORML ┃%"단 한 번도 용서는 없고,",72,LEFT%┃
			PRINTFORML ┃%"단 한 번도 속죄하지 않으리",72,LEFT%┃
			PRINTFORML ┃%"나의 주역은 오직 한 사람",72,LEFT%┃
			PRINTFORML ┃%"주구를 두르고 사냥개를 이끈다",72,LEFT%┃
			PRINTFORML ┃%"고로 이 생에 사랑은 없고――",72,LEFT%┃
			PRINTFORML ┃%"――나의 몸은 그야말로 사랑으로 되어 있다",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"고유결계(리얼리티 마블)：Unlimited Blade Works……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"세트. 마인드 리로드…… 이너 리라이트……O.K.",72,LEFT%┃
			PRINTFORML ┃%"……블레이드 매거진, 슛아웃……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"심상세계 재장전…… 내해의 덮어쓰기……O.K.",72,LEFT%┃
			PRINTFORML ┃%"……剣撃装填。全段射出……！",72,LEFT%┃
		ENDIF
	;2967,기영의고삐
	;　＞打撃、威力500/400、拡散、物、消費40
	;　強力な拡散打撃。
	;　特別な効果はないが、専用スキル以外の条件もなく、単純な威力では打撃スキル中最強クラスで、無限の剣製ほど重くもなく、メインウェポンにできる強度。
	;　/
	;　기영의고삐＜ベルレフォーン＞。
	;　ランク：A+
	;　種別：対軍宝具
	;　レンジ：2～50
	;　最大捕捉：300人
	;　乗騎を強化する手綱の宝具。ライダー/メドゥーサは、召喚したペガサスを強化する。
	;　ペガサスはメドゥーサの子であり（Fate世界では野生にいるらしい）、ライダーは血の魔法陣を描くことでペガサスを召喚可能。
	;　そしてそれを手綱で強化することにより、500km/hでのひき逃げアタックを可能とする。
	;　使用された場面が名シーンでなぁ。
	;　名前の元ネタは、「ベレロフォン」であろう。ベルレフォン、ベレロポン、など、音写の仕方にはいろいろある。
	;　本名はヒッポノオス。「ベレロフォン」はあだ名で、「ベレロス殺し」を意味する。
	;　キマイラをぶっ殺す際にペガサスが必要になったんでとっ捕まえた、というエピソードを持つギリシャ神話の英雄。
	;　彼はアテナ神から黄金の手綱を授かっており、これが「기영의고삐」の元ネタであろう。
	;　…………。
	;　あれ、メドゥサとの関連は？？？　むしろコレ、ペガサスの宝具じゃない？
	ELSEIF CFLAG:ARG:입력행동 == 2967
		IF 0
		ELSEIF RAND:6 == 0
			PRINTFORML ┃%"놓치지 않습니다……!",72,LEFT%┃
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"내 손에 나오라 천마의 고삐여,",72,LEFT%┃
			PRINTFORML ┃%"저편으로 향하는 것은 끝없는 날개……!",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"불타는 종언을 노래하라, 저편의 날개여……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"종말을 말하라, 새벽의 날개여……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"새벽을 날아라, 아득한 꿈의 끝까지라도……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"석사괴(메두사)로부터 태어난 천마여……",72,LEFT%┃
			PRINTFORML ┃%"자, 나의 승기가 되어…… 돌관하라……",72,LEFT%┃
		ENDIF
		;宝具名詠唱はちょっと分ける
		IF RAND:2 == 0
			PRINTFORML ┃%"　　　　　　　 ﾍﾞﾙﾚ　　 ﾌｫｰﾝ　　　　　　",72,LEFT%┃
			PRINTFORML ┃%"연기(緣起) 재연―― “기영의…… 고삐”――!!!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"겟 셋：Bellerophon……!",72,LEFT%┃
		ENDIF

	;2968,홍주・염부제염정
	;　＞火炎、威力特殊、範囲特殊、物、消費60　CT30　条件付き貫通　特殊事項は下記に
	;　敵が複数体いる場合、攻撃範囲は「前列単体＋その後ろ」
	;　敵が単体なら、「投げ」攻撃になり、威力が上昇
	;　威力は「後列貫通」状態なら500、「投げ」なら700
	;　投げ状態だと命中が80から120に上昇
	;　BH状態(HP33％未満)なら耐性を完全貫通、マカラカーンには引っかかる
	;　/
	;　ｶｰﾁｬﾝ144以前の性能は下記の通り。
	;　＞火炎、威力特殊、単体、物、消費60　CT30　※残HP量により、600/900
	;　/
	;　だいぶ色々自前で変えた。
	;　超特大威力の火炎攻撃。HPが3割以下でなくとも十分に強い。
	;　火炎相性は比較的物理攻撃がそろっている方だが、それでもこの強度のものは他にないはず。
	;　ただ、上記の「무한의검제」と同じ問題を抱えており、……消費60は重いんだってば。
	;　HPが下がると威力が増加するのは、おそらく「アナザーアークドライブ」……まあ、必殺技と超必殺技の違い、のためでしょうね。
	;　/
	;　홍주・염부제염정＜こうしゅ・えんぶだいえんじょう＞。
	;　軋間紅摩＜きしま・こうま＞の、格ゲーでのアークドライブ（超必殺技）。
	;　彼は鬼の血をひく一族のひとりで、鬼になりかけている人物。
	;　炎を噴出させる能力を持ち、この技は、こう、アイアンクローカマしてドカンと焼く技。
	;　鬼になりかけ……といっても段階があり、彼の段階、「紅主」はまだギリギリ踏みとどまっているともいえる。
	;　まあ彼は「ほぼ鬼」の「紅赤朱＜くれないせきしゅ＞」になりかけてるわけですけどね。
	;　このあたりの中二ワード、月姫が月厨を生み出したのもわかるってもんである。
	;　閻浮提、とは、仏教における四大洲のひとつ。ジャンブー・ドヴィーパ。
	;　大雑把に言えば、人間界、である。
	;　当て字となっているが、「人間界炎上」といった意味合いの技名であろう。
	;　まあ、たぶん、「炎舞・大炎上」というイメージの。
	;　/
	;　月姫系の技は、格ゲー版「Melty Blood」を元にしていると思しい。
	;　月姫系キャラの専用スキルは、下記の三種のうちのいずれかが元になっている。
	;　ゲージが300%になってから一定時間、または100%以上の時に「強制開放」をしてから一定時間の間だけ使える超必殺技「アークドライブ」、
	;　ゲージが300%になってから一定時間内に（アークドライブが発動できる間に）「強制開放」した状態から、また一定時間の間だけ使える超・超必殺技「アナザーアークドライブ」、
	;　アナザーアークが使える際に当身を取ることで使用できる「ラストアーク」の三種類がある。
	;　HP条件で強化される技は、おそらく「アークドライブ」「アナザーアークドライブ」の再現だろう。
	;　ラストアークが元になったスキルもあるが、ここはおそらく他との統一感のためだろうな～と。
	ELSEIF CFLAG:ARG:입력행동 == 2968
		IF 0
		;英訳版で「;Koushu･Enbudaienjyou ?」とあり、読み方が分からないようであった。
		;メルブラ：タイプルミナでは、「独角・閻浮炎上」＝「Unicorn - Flame Waltz」となっていた。この独角もたぶん当て字な気がするんだが……独覚とかの。
		;ん～～～～……となったので、「Jambudvipa homa」としていたが、英訳版が出たので、それに倣うことにする。
		;あ、homa、は護摩。火を用いる儀式のこと。
		ELSEIF RAND:3 == 0
			IF 0
			;夜摩判決
			ELSEIF 現HP割合(ARG) < 33
				PRINTFORML ┃%"스칼렛：Yama's Judgement……",72,LEFT%┃
			;홍주・염부제염정(掌握)
			;タイマンだと性能が変化する
			ELSEIF ENEMY_COUNT() == 1
				PRINTFORML ┃%"스칼렛：Jambudvipa Purification……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"스칼렛：Jambu in Flames……",72,LEFT%┃
			ENDIF
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"귀종 인자 로딩……O.K.",72,LEFT%┃
			PRINTFORML ┃%"演武、大炎上……！",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"귀종 인자 로딩……O.K.",72,LEFT%┃
			PRINTFORML ┃%"表象……炎熱大縁起……！",72,LEFT%┃
		ENDIF
	;2969,주법・옥천붕
	;　＞打撃、威力180*3、単体、魔、消費65　防御半減　相性無効以下貫通
	;　単純に威力だけを見ても非常に強力。
	;　「打撃相性魔法攻撃」であるあたりもなかなか特異である。
	;　壁は貫通してくれないが、それでも単体攻撃魔法最高峰のひとつ。
	;　この威力で防御半減まであり、実質的な威力は「360*3＝1080」。……ぶっ飛びすぎだよなコレ……！　直した方がよさそうな気はする……！
	;　……ともあれ、消費の重さに全く見劣りしない強度がある。
	;　魔法攻撃であるので、魔・知を上げていればMPも十分、この消費でも使えるだろう。
	;　魔法型造魔ちゃんへの搭載候補として最上級。
	;　男性特攻とかはさすがにないっぽい。残念。
	;　/
	;　禁断の超奥義。またの名を、一夫多妻去勢拳。
	;　『Fate/EXTRA CCC』にて、キャス狐が解放せし魔技。
	;　相手のコカーンに飛び蹴りをして沈める。男性特攻。
	;　やたら気合の入ったモーションであり、特攻抜きでも強いので、後半のキャス狐はこればっか使うことになる。
	ELSEIF CFLAG:ARG:입력행동 == 2969
		IF 0
		ELSEIF RAND:6 == 0
			PRINTFORML ┃%"인챈트：페네트레이트……",72,LEFT%┃
			PRINTFORML ┃%"세트 플레이, 볼 스매셔……!",72,LEFT%┃
		;造魔ちゃんなので主のことは全肯定する
		ELSEIF RAND:5 == 0
			PRINTFORML ┃% CSTR:이인칭 + "의 사랑을 가로막는 자, 신이 용서할지라도 내가 용서치 않는다……!!",72,LEFT%┃
		;実際ボイス聞くとヤバい。
		;「まずは金的っ！ 次も金的っ！ 懺悔しやがれ、コレがトドメの金的だーー！」
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"먼저 음부, 이어서 사타구니, 참회를 권장!",72,LEFT%┃
			PRINTFORML ┃%"――이것이 결정타인 사타구니 킥입니다……!",72,LEFT%┃
		;ゲットアウト。失せろ、の意。
		;男の尊厳よぶっ飛べ……！
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"겟 아웃：Polygamy Castration Fist……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"자 산산이 부서져라, 존엄이여……!",72,LEFT%┃
		;浮気とか許すけど、それはそれとしておこってないわけじゃないんだよ、っていう
		ELSE
			PRINTFORML ┃%"바람둥이는 죽어야 마땅하다, 자비는…… 아주 조금 있음……!",72,LEFT%┃
			PRINTFORML ┃%"코드…… “일부다처 거세권”!!!!!",72,LEFT%┃
		ENDIF
	;2970,배럴레플리카
	;　＞万能、威力特殊、拡散、物、消費50　CT20　※残HP量により、「600/400」/「400/250」
	;　高クリティカル、万能物理拡散攻撃。
	;　最大の特徴は、これを覚えるシオンが受胎アイテムとして当スキルを搭載した銃「ブラックバレル」を産むことだろう。
	;　射撃武器がないと使用不可っぽいが、異能者なら受胎アイテムを持てば自然と条件を達成できる。
	;　……こだいちゃん！　持って持って！　ブラックバレルレプリカフルトランスして！！！
	;　/
	;　「블랙배럴・레플리카」。「黒い銃身」、「Longinus」。
	;　三大魔術組織のひとつ、「アトラス院」の誇る七大兵器……のレプリカ。
	;　七大兵器とは……
	;　――自らが最強である必要はない。我々は最強であるものを創り出すのだ――
	;　……というモットーから生み出された、世界を滅ぼせるクッソやべー兵器のこと。
	;　アトラス院は、世界の滅びを回避するために新しい世界の滅びを作ってしまう集団であり、コレのオリジナルも世界を滅ぼせてしまうものである。
	;　（隕石が降ってくるってんでそれを破壊できるビーム砲を作ったら、そのビーム砲で世界を滅ぼせてしまう、みたいな）
	;　シオン・エルトナム・アトラシアは、次期院長候補だった経歴のためか、七つのうちのひとつのレプリカを所持している。
	;　通常時はこれを単なる拳銃として使っているが、本来の能力は「対象に天寿をまっとうさせる」もの。
	;　寿命が長ければ長いほど威力を増す攻撃であるという。
	;　格ゲー上では対象によって威力が変わるということもない、ぶっといビームである。
	;　「배럴레플리카」は、相手を宙にカチ上げてのラストシューティングなので、拡散攻撃のコレはまた別の撃ち方と思しい。
	;　ラストアークの「バレルレプリカ・オベリスク」（横にぶっぱ）の方だろうか。
	ELSEIF CFLAG:ARG:입력행동 == 2970
		IF 0
		;BH状態だと「オベリスク」に名前変更
		ELSEIF RAND:6 == 0 && 現HP割合(ARG) < 33
			PRINTFORML ┃%"로스트 카르마：Barrel Replica Obelisk……",72,LEFT%┃
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"페이탈 배럴, 리설 샷……!",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"블랙배럴·레플리카―― 데드 카피",72,LEFT%┃
			PRINTFORML ┃%"그 생명을 기각합니다……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"로스트 카르마：Barrel Replica……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"검은 총신을 열화 모방…… 기능 재현……",72,LEFT%┃
			PRINTFORML ┃%"그 천수를 기각합니다……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"7대 병기, 검은 총신을 전사…… MAG로 기능 재현……",72,LEFT%┃
			PRINTFORML ┃%"에테르 파괴…… 풀 트랜스……!",72,LEFT%┃
		ENDIF
	;2971,고유결계：고갈정원
	;　＞呪殺、威力特殊、敵味方全体、魔、消費50　※残HP量により、150/100　※MPダメージアリ
	;　威力はしょっぱいが、与えたダメージの半分のMPダメージを与える。
	;　呪殺相性であるのと、味方が使ってもしゃーないのが弱点。
	;　→ｶｰﾁｬﾝ144で改編し、BH状態なら、敵には万能相性でダメージを与えるように変更。
	;　んまぁ……これで強くなったかというと、微妙。
	;　/
	;　固有結界とは、使用者の内面世界で外界を塗り替える大魔術。
	;　使用者は例外中の例外……ではあるのだが、作劇の都合上むしろ例外のほうが多いので、それなりに多くのキャラクターが切り札としている。
	;　弓塚さつきのそれは、作中では登場していないのだが、幻のさっちんルートでは出番があったという。
	;　その効果は、「領域中のマナをすべて消滅させる」という空間を展開するもの。
	;　魔術はもちろん使えなくなるし、魔力で体を形成している精霊などにとっては真空に近い空間であるらしい。
	;　今のところ格ゲーくらいでしかマトモに出てきていないが、ラストアーク（当身超必殺技）の画面全体攻撃。
	;　「マナを消滅させる」ことからか、ゲージを一時的に封印する効果を持つ。
	;　綺麗な庭園が登場した、と思ったら、それが一気に荒廃するビジュアルとなっている。
	;　本来人間にはあんまり効かないらしいが、格ゲーの都合上きちんと効く。
	;　メガテン的に言えば、『MAGを消滅させる空間を作る』感じだろうか。
	;　おそらく悪魔は存在していられなくなるし、異能者の魔法スキルも使用できるか怪しい空間になると思われる。
	ELSEIF CFLAG:ARG:입력행동 == 2971
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"고유결계(리얼리티 마블)：Depletion Garden……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"心象風景解析……O.K.",72,LEFT%┃
			PRINTFORML ┃%"결계선 형성…… MAG의 의사 진공 생성……",72,LEFT%┃
			PRINTFORML ┃%"시들어 썩어라…… 코드, “디프레션 가든”……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"기억영역 파팅…… 심상풍경 로드……",72,LEFT%┃
			PRINTFORML ┃%"고유결계(리얼리티 마블), 전개……",72,LEFT%┃
		ENDIF
	;2972,적주：함발
	;　＞万能、威力特殊、単体、魔、消費50　氷結即死10-75　※威力はちょっと特殊条件なので下記
	;　敵と使用者がどちらも前列にいるなら、「投げ」攻撃になり、威力と命中が上昇
	;　BH状態だと威力が+200
	;　投げモードでは命中200、威力が「450*1.5」になる
	;　BHと重なると「(450+200)*1.5＝975」になる
	;　氷結相性での即死という珍しいスキル。
	;　そもそもが威力の高い万能攻撃である。とはいえ、氷結即死を見ないなら万魔の乱舞あたりのほうがいいかな。
	;　/
	;　ｶｰﾁｬﾝ144以前はこんな性能。
	;　＞万能、威力特殊、単体、魔、消費50　氷結即死10-75　※残HP量により、750/500
	;　/
	;　せきしゅ：おりがみ。
	;　遠野秋葉の異能は、焔を操ることではなく、熱を奪うことにある。
	;　「熱が放出されたので」「焼けつくような痛みを感じ」「外気に灼熱感を得る」……という能力であるらしい。
	;　「対象の周囲が燃え出す」のはイメージ図なんだとか。改めて調べなおすまで、「熱が放出されて周囲が着火する」んだと思ってたよあたしゃ。
	;　能力は「赤い髪の毛」のイメージであるようで、視界内に一瞬で発動する。
	;　「檻髪」はその能力を全開にした際の呪界の名。
	;　視界内の熱操作が可能であるようだが、肉体接触（アイアンクローとか）をするとさらに強くなるっぽい。
	;　格ゲーではアークドライブ。密着距離だと投げ技になり、威力も向上する。
	;　/
	;　上述したが、赤主とは「鬼になりかけ」の者のことをさす。
	;　（この技の場合の「赤主」とは、遠野家当主の武術ということらしい）
	;　紅赤朱とは、完全に異種の血を覚醒させたもののことを言い、二度と元には戻れないようだ。
	;　遠野家（とその分家）は、過去ヒトでないモノと混血した一族であり、現当主である秋葉も例にもれず異種の血を引く。
	;　秋葉は人間の割合の血のほうが濃いのだが、異種の血が非常に上質であるため、「人間でありながら鬼の力をふるうことができる」という。
	;　と、いうか、普段から「意識して人間っぽくしている」だけで、秋葉は「既に紅赤朱として覚醒している」っぽい。
	;　月姫では一部のルートでラスボスになるのだが、その際も「キレている」だけで、ラスボスになったときに「完全覚醒してしまった」わけでもないようだ。
	ELSEIF CFLAG:ARG:입력행동 == 2972
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"레드 레이디：Scarlet Mistress - Origami……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"붉은 주인 재연…… 약탈의 이능을 재현합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"異能再現……展開、略奪呪界形成……",72,LEFT%┃
			PRINTFORML ┃%"재연…… 코드, “버밀리온 제일”",72,LEFT%┃
		ENDIF
	;2973,공상구현화
	;　＞万能、威力特殊、全体、物、消費70　バフアリ　※残HP量により、800/500
	;　超威力全体攻撃。明けの明星並みかな？　凶悪なのはデカジャ効果までついてることだよ。
	;　効果は破格もいいところで、*非常に*強力。HP条件を満たしていない段階でまだ安い。
	;　専用スキルでなければ消費は100程度まで伸びると思われる。というか、コレで消費70は専用スキルとしても破格の安さ。
	;　全スキルを見渡しても最強クラス。
	;　ただし物理攻撃なので消費が重たいのは確かである。キツい。
	;　/
	;　マーブル・ファンタズム。
	;　アルクェイド・ブリュンスタッドの有する能力。
	;　文字通り、「空想を」「具現化」し、おそらく大抵のことは実現できる。
	;　（アルクェイドは設定的に『自然・地球』の端末に近いモノなので、あまりにも自然からかけ離れた生命、即ち人間的なモノは不可能かもしれない）
	;　（ただ、それならそれで『結果』だけ持ってこればいい話ではあるけれど。ライターを作れないなら、火を作り出せばよいのである）
	;　当然ながら、超・超・特異な能力である。使える、と明言されているキャラクターは、型月全体を見回してもほとんどいない。
	;　作中では大体のパターンで弱体化しててあんまり使えてないのだが、これはたぶん格ゲー版が元なので必殺技としてならフツーに使う。
	ELSEIF CFLAG:ARG:입력행동 == 2973
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"그 텍스처를 파각하겠습니다……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			IF 現HP割合(ARG) < 33
				PRINTFORML ┃%"리 이매지네이트：Marble Phantasm Seal……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"이매지네이트：Marble Phantasm……",72,LEFT%┃
			ENDIF
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"휘몰아쳐라, 별의 숨결……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"真祖偽装……完了。龍脈介入開始……接続。",72,LEFT%┃
			PRINTFORML ┃%"코드, “마블 판타즘”",72,LEFT%┃
		ENDIF
	;2974,제7성전
	;　＞複合/特殊、威力特殊、単体、物、消費50　破魔即死20-75　CT特殊　威力、相性については下記
	;　相性は通常時は「검격/파마」、「転生批判直撃タイム」かBH状態だと万能相性が複合する
	;　威力は通常時500、「転生批判直撃タイム」だと3倍で1500、その他、敵が食いしばっているなら600
	;　BH状態だとCTが５から30に増加
	;　敵がこの攻撃で食いしばりを発生させた場合、「転生批判直撃タイム」になり、
	;　「必中、クリティカル確定、万能複合、威力三倍」の追撃を発動させる
	;　/
	;　「転生」かどうかというとビミョーな気はするのだが、ともあれ。
	;　食いしばりタイミングは基本的に敵一体につき１戦闘に１回しかなく、そもそも敵が持っているかどうかも怪しい。
	;　発動はかなりレアだろう……と思われたため、その分、マジで超追撃にした。
	;　下記の性能から素もだいぶ強化したので、使いではかなりあると思います。
	;　破魔の強力な攻撃はレアだしね。よく無効化されるが。
	;　これは剣撃もついてるので最低限の仕事もできる。
	;　/
	;　ｶｰﾁｬﾝ143時点ではこんな感じ。
	;　＞複合/검격/破魔、威力特殊、単体、物、消費50　破魔即死20-75　※残HP量により、500/300
	;　破魔物理、っつーか破魔単体攻撃としてお強い。
	;　複合攻撃はそれだけで強いんだよなぁ……
	;　ただ、さすがに消費は重い。HP条件を満たして適正くらいか。
	;　/
	;　埋葬機関第七位、シエルの持つ武装。
	;　「転生批判」の概念を持つ、ユニコーンの角…………を、魔改造してパイルバンカーにしたもの。どうしてこうなった。
	;　よくわからん精霊がついていたりするが、それを実体化させることができたのはシエルのみだとか。
	;　リメイク版ではちょっと詳細不明である。
	;　詳細不明ではあるが、なんかやたら格好良くなっている。
	ELSEIF CFLAG:ARG:입력행동 == 2974
		;タゲを取ります
		ATK_TARGET = CFLAG:ARG:타겟

		IF 0
		;コレは取れないはず？あとで試してみよう……
		;ELSEIF 転生批判直撃タイム
			;直撃タイム、当然ながら、わたしの捏造です。
			;第七聖典・聖女埋葬
			;Seventh Holy Scripture, Burial of Saints

		;ブラッドヒート＋転生批判
		ELSEIF 現HP割合(ARG) < 33 && CFLAG:ATK_TARGET:이악물기플래그 == 1
			IF 0
			ELSEIF RAND:5 == 0
				PRINTFORML ┃%"코드 SHS：Original Sin Redemption……!",72,LEFT%┃
			ELSEIF RAND:4 == 0
				PRINTFORML ┃%"그 원죄를 구제한다……!",72,LEFT%┃
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"단죄의 말뚝은, 지금, 여기에……!",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"지금, 단두대의 칼날을 떨어뜨린다……!",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"그대의 목숨은 불법이니라, 고로 이승에서 영구 퇴거를 명하노라……!",72,LEFT%┃
			ENDIF
		;ブラッドヒート
		ELSEIF 現HP割合(ARG) < 33
			IF 0
			ELSEIF RAND:6 == 0
				PRINTFORML ┃%"코드 SHS：Death Sentence……!",72,LEFT%┃
			ELSEIF RAND:5 == 0
				PRINTFORML ┃%"나의 주인의 이름으로 그 죄를 단죄한다……!",72,LEFT%┃
			ELSEIF RAND:4 == 0
				PRINTFORML ┃%"이 말뚝은 단죄에 의한 죽음을 안겨줍니다……!",72,LEFT%┃
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"단죄의 말뚝은, 지금, 여기에……!",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"당신을 이 말뚝으로 승천시키겠다……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"제7성전――断罪死強制執行……！",72,LEFT%┃
			ENDIF
		;転生批判モード　直撃かどうかはさすがに見ない
		ELSEIF CFLAG:ATK_TARGET:이악물기플래그 == 1
			IF 0
			ELSEIF RAND:5 == 0
				PRINTFORML ┃%"코드 SHS：Original Sin Impeachment……!",72,LEFT%┃
			ELSEIF RAND:4 == 0
				PRINTFORML ┃%"그 원죄를 탄핵한다……!",72,LEFT%┃
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"단죄의 말뚝은, 지금, 여기에……!",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"칼바리아 데스 피어싱……!",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"그 생명의 영위 방식을―― 부정한다……!",72,LEFT%┃
			ENDIF
		ELSE
			IF 0
			;Scripture：聖典
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"로딩：Seventh Holy Scripture……",72,LEFT%┃
			;炸薬充填とか言ってますけど原作旧版の構造だと充填するところがない。
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"転生否定概念展開……衝角形成……炸薬充填……",72,LEFT%┃
				PRINTFORML ┃%"코드, “세븐스 헤븐”……",72,LEFT%┃
			;いや、ホント、なんでさっていうか、ﾊﾟｲﾙﾊﾞﾝｶｰ！？ﾊﾟｲﾙﾊﾞﾝｶｰﾅﾝﾃﾞ！？ って感じよね
			ELSE
				PRINTFORML ┃%"이념을 해석…… 이해 불능…… 재연을 강행……",72,LEFT%┃
				PRINTFORML ┃%"파일 벙커를 박아 넣겠습니다……",72,LEFT%┃
			ENDIF
		ENDIF
	;2975,17분할
	;　＞剣撃、威力250、単体、物、消費50　CT特殊　万能即死特殊　特殊処理　※残HP量により変動、下記。
	;　BH状態……HP33％未満かどうかで性能変動
	;　CTは30/50
	;　付与率は25-75/50-90
	;　与えたダメージの、おおよそ２倍「最大HP補正」を削る（削った後現在HPが最大HPを上回っているなら補正する）
	;　BH状態だと三倍削る
	;　/
	;　最大HP補正を与えるスキルの実装で、「あ、十七分割でもやれそう」って思ったので、最大HP削る性能を追加した。
	;　全回復してくるタイプの敵に対してちょっと強いハズ……とはいえ、そもそもの火力がちょっと微妙なので、どうかなあ、という感じ。
	;　初撃を与えた場合、ダメージがおよそ2倍になる（ダメージを与えた後最大HPを2倍削るため）のと、
	;　全回復をされるなら総ダメージ量がおおよそ４倍になる計算（2回全回復されるなら6倍な）……というのは、ちょっと面白い性能になったかなーって感じ。
	;　今更ですけど月厨なんすよ。
	;　/
	;　ｶｰﾁｬﾝ143時点ではこんな感じ。
	;　＞剣撃、威力250、単体、物、消費50　CT30　万能即死特殊　※残HP量により20-75/20-90
	;　中威力高クリティカル。……だけならいいんだが、万能で即死とか仰ってますよコレ。
	;　設定的には再演とかできてたまるか系なんだけどまあメガテンだし。っつかだいたいそうだよねこの辺
	;　/
	;　『月姫』の主人公、遠野志貴が、ヒロインであるアルクェイドにやらかしたやつ。
	;　志貴はアルクェイドを17回切って17個の肉片にした。
	;　不老不死に限りなく近い強大な吸血鬼であったアルクェイドは、この死に抗う再生のために力の大半を使うことになり、
	;　『月姫』が最強チートキャラ：アルクェイドの無双ゲーでは終わらなくなってしまった。
	;　「あれ？　1回切れば2個、2回切れば3個になるんだから、17回切れば18個にならない？」と言われることもあるが、
	;　分割方法を考慮すると、「うち2回斬って切り分けているパーツがある」or「切断に至らなかった1回がある」ということになるらしい。
	;　格ゲー版のアナザーアーク（タイプルミナではラストアーク）。
	;　密着ではガード不能なあたりが、CT30だろうか。
	;　/
	;　超絶チートキャラであるアルクェイドを一般人（逸般人）である志貴がぶった切れたのは、彼の能力が理由である。
	;　遠野志貴は「直死の魔眼」という眼をもっており、「モノの死」を「線」のかたちで見ることができる。
	;　細かい理屈付けはあるが、「切れば死ぬ場所を見出す」……「線をなぞるとモノが“死ぬ”」能力。
	;　結果だけ見ると、「彼にだけ特定の場所に線が見えて、彼がそれをナイフなどでなぞれば相手の強度など関係なく切断され、機能が損壊する」。
	;　別作品の推察によれば、「究極の未来視で対象の死を発現させている」のだとか。
	;　壁、ゾンビ、無数の生命が集合した残機666の怪物、道路（地面）などなど、いろんなものをぶった切っている。
	;　鈍器でヤった描写はないが、漫画版では、素手で花瓶の線をなぞることで“ゆっくり斬って”いた。
	;　志貴は主にナイフを使っているが、たぶん、ある程度細いもの、例えば鉛筆や15センチ定規なんかの刃物と呼べないようなブツでもイケる。
	;　「死の線」も彼の認識であり、それをなぞるという行為も、なぞれるモノについても、彼の認識に沿う部分が大きいように見受けられる。
	;　/
	;　……月姫リメイク、2021夏、発売。
	;　我らは10年待ちました。
	ELSEIF CFLAG:ARG:입력행동 == 2975
		IF 0
		ELSEIF RAND:8 == 0
			PRINTFORML ┃%"당신의 생명을 파각한다……!",72,LEFT%┃
		ELSEIF RAND:7 == 0
			PRINTFORML ┃%"참살 재검증―― 17개의 고깃덩이로 당신을 분할한다――",72,LEFT%┃
		ELSEIF RAND:6 == 0
			PRINTFORML ┃%"이것이―― 당신의 죽음입니다――",72,LEFT%┃
		ELSEIF RAND:5 == 0
			;BH状態なら名称変更
			IF 現HP割合(ARG) < 33
				PRINTFORML ┃%"Re：데드 엔드：Seventeen Dissection……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"데드 엔드：Seventeen Divisions……",72,LEFT%┃
			ENDIF
		ELSEIF RAND:4 == 0
;			PRINTFORML ┃%"　　ｲﾔｻｷ　　　　　ｲﾔﾊﾃ　　　　",72,LEFT%┃
			PRINTFORML ┃%"……시초를 여기에, 종극을 지금에.",72,LEFT%┃
			PRINTFORML ┃%"보는 것 모두를 무로 돌린다. 이것이야말로 “끝”인즉――",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"……未来予測最大精度……",72,LEFT%┃
			PRINTFORML ┃%"“종말” 계측……읏……O.K.",72,LEFT%┃
			PRINTFORML ┃%"거기에…… 끝이 있다면……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"……예외 없이. 한계는 존재하며. 형태가 있는 것에 끝은 온다.",72,LEFT%┃
			PRINTFORML ┃%"……아아. 이것이, 죽음을 본다는 것――.",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"재연…… 이걸로 끝…… 이것이야말로 끝.",72,LEFT%┃
			PRINTFORML ┃%"가르쳐 드리지요…… 이것이, 무언가를 죽인다는 것입니다……",72,LEFT%┃
		ENDIF
	;2976,암흑히스이권
	;　＞打撃、威力特殊、単体、物、消費20　精神混乱40-90　※残HP量により、200/150
	;　型月系のスキルではやや珍しい、気軽に振っていける技。
	;　まあ単体なので雑魚チラシには向いてないんだけど……
	;　ちなみに命中80とちょっと不安がある。
	;　BH状態だと、混乱付与が万能になるように。
	;　/
	;　あんこくひすいけん。
	;　またの名を「暗黒翡翠流　ご奉仕推奨波」、「ギガメイドインパクト」。
	;　遠野家の女中/メイド双子のメイドの方、翡翠のアークドライブ（超必殺技）。
	;　『月姫』では彼女には全く戦闘能力がないのだが、まあ、なんか、出た。いろいろある。
	;　……それというのも彼女、『月姫』初期版で、誤植がクッソ出た。
	;　「お部屋をお連れします」だの「お休みはなられた方が」だのなんだの。
	;　それに悪乗りして、ファンディスク『歌月十夜』で「洗脳探偵・翡翠」というネタシナリオが発生。
	;　なんか「推理に完璧です」とか「あなたを犯人です」とかなんか、こう、なに？　なんなの？
	;　暗黒翡翠拳は、そんな彼女がなんか出した怪しい拳法じみたなんかである。
	;　格ゲーでは、なんか……こう……手を……うにょんぐる……させて気弾をチャージして、飛ばす。
	;　チャージは延長が可能で威力も増加するが、ディレイでぶっぱするためにごくまれに使うこともある……くらいのアレ。
	ELSEIF CFLAG:ARG:입력행동 == 2976
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"기~가~조~마~…… 임~팩~트~……!",72,LEFT%┃
		;「Dark Jade Fist」
		;この場合の「비취」は人名なので、Hisui、が正しいかもしれない。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"디텍티브：Hisui Dark Punch……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"아~암~흑~…… 조~마~검~……!",72,LEFT%┃
		;こんな誤字レベルじゃなかったけど……
		ELSE
			PRINTFORML ┃%"그럼, 암흑의 주먹을 선사해 드리지요……",72,LEFT%┃
		ENDIF
	;2977,발도오의・하정추성
	;　＞剣撃、威力特殊、全体、物、消費40　CT30　※残HP量により、「50/100」
	;　ちょっとだけ命中率が高い（120）。高クリティカルの全体物理攻撃はレア。
	;　……とはいえさすがに威力設定ミスってない？
	;　→ｶｰﾁｬﾝ140で下記のごとき性能にした。
	;　＞剣撃、威力特殊、全体、物、消費40　CT30　条件付き貫通　※残HP量により、「200/300」
	;　琥珀がHP33％未満で使用した場合のみ、貫通する。
	;　なので造魔ちゃんが使うと、CTの高い全体攻撃にしかならない。
	;　とはいえ、CTが高い全体物理攻撃ではあるので、消費は重め、という調整。
	;　造魔口上加筆者としてはまあまあ当然の気づかいというかアレ。……造魔では継承不能スキル持ってきてはいけないんだけどなそもそも！
	;　まあでも素材にはなってるしなぁ……！というあたりである。
	;　造魔愛好家だけど、愛好家だからこそ、直した方がいいよなぁ……とずっと思ってるし、そこで止まってる。
	;　ｶｰﾁｬﾝ144で内部的に色々変えて、「耐性、無効、反射、吸収」あたりの耐性を全部貫通、
	;　リフレクトやテトラカーン、～の壁や無効フラグも全部ぶち抜く超貫通にしました。ただしコハッキー限定なので、造魔ちゃんが使う意味はほぼない。
	;　/
	;　ばっとうおうぎ・がしょうほうきぼし。
	;　遠野家の女中/メイド双子の女中の方、琥珀さんのラストアーク（カウンター超必殺技）。
	;　見た目はどこをどう見ても、テンショーリュウセンというか、なんというか。
	;　……いや、背景になんか表示される一枚絵を見ると、分からなくなってくるなァ……
	;　念のため言うが、彼女も妹と同様、原作では戦闘能力は皆無。策謀でなんかするキャラクターである。
	;　/
	;　琥珀は『月姫』キャラの中でも特に深い闇を背負っているキャラなのだが、
	;　その反動もあってかファンディスクなどではネタキャラ化が進行。
	;　なぞのチャイナ美少女ミスター陳になったり、
	;　『月姫』でおクスリを盛ってたことを拡大解釈されてクッソ怪しい薬を作っていることになったり、
	;　いつも持っている箒にヤッパが隠されていたり、
	;　ジョニーという名のファイアフラワーを育てていたり、
	;　屋敷の地下に遠野地下帝国を作ってメカヒスイ（※妹そっくりの破壊アンドロイド）をつくったりしていた。
	;　……いやどういうことなんだ型月。
	;　筆者は長年の琥珀使いで、キャラとしてもルートとしても琥珀が一番好きです。
	ELSEIF CFLAG:ARG:입력행동 == 2977
		IF 0
		;「あけましておめでとうございます」
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"새해복：Secret Draw out·New Year Comet……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"프리셋 참격술, 오의……!",72,LEFT%┃
		;元ネタから。
		ELSE
			PRINTFORML ┃%"한 걸음 더…… 미래로 내딛는 한 걸음을 추가합니다……!",72,LEFT%┃
		ENDIF
	;2978,포말의꿈
	;　＞戦技、威力特殊、単体、魔、消費50　精神魅了30-90　※残HP量により、400/300
	;　戦技魔法はレアですねえ。
	;　魅了付きとはいえ、消費は大きめ。
	;　ｶｰﾁｬﾝ143までは「ホウマツノユメ」であったが、白レンとレンがこのスキルを共有していたので、そのあたりもあって名前を変更。
	;　BH状態だと状態異常付与が万能になるよ。
	;　/
	;　泡沫の夢。
	;　黒猫と少女を掛け合わせて作られた夢魔の使い魔、レンのアナザーアークドライブ。
	;　発射された弾がヒットすると画面が暗転し、レンが変身して（※パジャマとか、水着とかに）暗闇の中でダメージを与える。
	;　ロリにそんなカッコさせてええのんか、と、物議をかもすこともあるかもしれない。
	;　レンは非常に無口なキャラクターで、基本的に攻撃を受けた時の吐息などくらいしかセリフがないのだが、
	;　この技の発動時のみ、小さく、どこか艶めかしく笑う。
	ELSEIF CFLAG:ARG:입력행동 == 2978
		IF 0

		ELSEIF RAND:5 == 0 && 現HP割合(ARG) < 33
			;こちらは「コチョウノユメ」
			IF RAND:2 == 0
				PRINTFORML ┃%"스킬 코드: Endless Expanses……",72,LEFT%┃
			;Ephemeral：儚い
			;こちらは「ホウマツノユメ」
			ELSE
				PRINTFORML ┃%"스킬 코드: Ephemeral Dream……",72,LEFT%┃
			ENDIF
		;「포말의꿈」
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"스킬 코드: Ephemeral Transience……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"물거품 같은 꿈을…… 후, 후후――",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"꿈바다 접속 설정 보존…… 전개…… 사출합니다",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"물거품 같은, 덧없는 꿈을 보여드리지요……",72,LEFT%┃
		ENDIF
	;2979,무장999
	;　＞戦技、威力300*特殊、単体、物、消費40　※残HP量により、「1-3」/「2-4」回攻撃
	;　HPが33％以下だと攻撃回数が増加する。
	;　消費は……はちィ!?　消費MPがァ!?
	;　え、えーと、最低限40くらいは消費するべきだと思うが、50くらいでも十分強力だとは思う。
	;　ちなみに「입」がないと継承できないっぽいわね。
	;　たぶん使うときはぴこって猫耳とか生える。
	;　→というわけで、40にした。それでも威力から見れば妥当な方だとは思う。
	;　/
	;　ネロ・カオスのアナザーアーク。
	;　彼は自分の体の中に無数の動物を取り込んでおり、「人間のかたちをした命のかたまり」となっている。
	;　彼はその「命の要素」を外に出すことで、獣を出現・使役することができる。
	;　（体からいきなりワニの口だけが出てきたり、シカが出てきて歩いて突進してきたり、地面に流した「命の要素」から化け物の口が噛みついてきたり）
	;　その獣たちももちろんやべーモノになっているので、彼はそこにいるだけで大変なことになる。
	;　この技はそんな彼が（苦し紛れに）「中身の動物を全部発現させて力任せにぶっ殺すモード」と化したもの。
	;　どうして苦し紛れになったかってーと、彼はもともと学者肌の人物で戦士ではなかったってあたりと、
	;　「残機666？　はーん、じゃあ基盤ごと壊すわ」とか言いだす予想外にもほどがあるナニカと戦ったからだよ。
	;　アークドライブ版では突進するだけだが、アナザーアーク版では画面外まで突進したあと往復してくる。
	;　攻撃回数が増えるのはその再現だろう。
	;　/
	;　月姫リメイクでは9割9分くらいリストラされた。
	;　いちおう存在はしているが、物語開始前に討滅されたと思しい。あわれ。
	ELSEIF CFLAG:ARG:입력행동 == 2979
		IF 0
		;『ビーストバインド』。
		;1999年に発売されたTRPG。2010年に第三版である「トリニティ」が発売されている。
		;現代を舞台に、妖怪や宇宙人など様々な人外「魔物」が隠れて暮らしている世界……という現代ファンタジーもの。
		;強い自我……「エゴ」を持つ者は超時空的存在からエネルギーを引き出し、現実を変革できるという設定で、
		;主人公たちは人間でも魔物でもないどっちつかずの半端もの、「半魔」として戦う。
		;～～「人間性」というパラメータを持つが、立場として「どっちつかず」であるため、これを失うと魔物に堕する。
		;（エゴの力を持つため、どれだけ高めても、純粋な「인간」にはなれないのだ）
		;……まあTRPGの処理上でいうと、人間性がゼロ以下になると、NPC化する。SAN値か？
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"비스트 바인드：999th Beast……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"지옥의 폭주특급 쓰리 나인…… 입니다……",72,LEFT%┃
			PRINTFORML ┃%"……오, 오오오오오오오오오오오오오오……읏!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"기원 위장…… 카오스 이론에 의한 신체 구조 개변 개시……",72,LEFT%┃
			PRINTFORML ┃%"鳥獣因子増幅……幻獣因子展開……混沌衝動再演……",72,LEFT%┃
			PRINTFORML ┃%"무장·코드 “쓰리 나인”……!",72,LEFT%┃
		ENDIF
	;2980,정식외전
	;　＞多段/검격/打撃、威力特殊*2、単体、物、消費20　※残HP量により、1段目が200/350、2段目が300/500、となる
	;　HPが３３％以下だと威力が増加する。単体大威力二段攻撃。物理２属性なのでイマイチ美味しくはないが、このコストで出していい火力ではない。
	;　BH状態だと威力が増加するほか、リーズバイフェが使用した場合、「テトラカーンマカラカーン、状態異常無効１回」を自身に付与する。
	;　/
	;　せいしきがいてん。
	;　アークドライブ、アナザーアーク共にこの名称。
	;　リーズバイフェ・ストリンドヴァリの有する武装、正式外典ガマリエルによる攻撃。
	;　ガマリエルは対吸血鬼用の、『滅び』の概念武装。コントラバス型のパイルバンカー。
	;　彼女はシオンと共に「ワラキアの夜」に挑み敗北、捕食され死亡したが、このガマリエルのおかげで消化まではされず、情報のカタマリとして残っていた。
	;　で、その情報を元に再現されたのがメルブラに登場するリーズバイフェである。
	;　コントラバス型のパイルバンカー、というよくわかんないものを武器にしており、典型的なパワー型。
	;　わりとリーチもあるので事故ると痛い。
	;　超必殺技である当攻撃は、ADでは突撃のみ、AADでは突撃から、ぶち抜いた杭が破裂する……といった演出。
	ELSEIF CFLAG:ARG:입력행동 == 2980
		IF 0
		ELSEIF RAND:6 == 0
			;原罪抱擁。
			IF 現HP割合(ARG) < 33
				PRINTFORML ┃%"스팅：Official Apocrypha ……",72,LEFT%┃
				PRINTFORML ┃%"――Original Sin Embrace……！",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"스팅：Official Apocrypha……",72,LEFT%┃
			ENDIF
		;アークドライブ発動時の「祈れ！」ってセリフが好き。
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"그 영혼에 기적이 깃든다고 믿는다면――",72,LEFT%┃
			PRINTFORML ┃%"――이 음계에 용서를 구하도록 하라……!",72,LEFT%┃
		;どんな装甲でも打ち貫くのみって感じ
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"상기·재연, 인자 수렴…… 외부 전개……",72,LEFT%┃
			PRINTFORML ┃%"어떠한 개념이라도 멸망이 있을 뿐……",72,LEFT%┃
			PRINTFORML ┃%"――꿰뚫어라, 정식 외전·가말리엘……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"……멸망의 노래를 연주하라, 정식 외전……!",72,LEFT%┃
			PRINTFORML ┃%"그 영혼에 광채가 있다면―― 멸망의 끝에 구원받으리라……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"상기·재연, 인자 수렴…… 외부 전개……",72,LEFT%┃
			PRINTFORML ┃%"“정식외전”、展開完了……",72,LEFT%┃
			PRINTFORML ┃%"……가말리엘의 쇠뭉치는 거의 모든 것을 박살 낸다……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"적성 대상의 외각 관통 수단을 검색…… 완료.",72,LEFT%┃
			PRINTFORML ┃%"展開開始……O.K.",72,LEFT%┃
			PRINTFORML ┃%"격멸을 노래하라, 정식 외전 가말리엘……!",72,LEFT%┃
		ENDIF
	;2981,나이트룰러・더・블러드・딜러
	;　＞多段/타격/疾風、威力特殊*2、全体、物、消費40　※残HP量により、200/300
	;　HPが３３％以下だと威力が増加する。
	;　全体攻撃であり、マイナー相性の疾風と、物理の打撃を、ってのは中々やる。威力も通常時で合計400と中々。
	;　/
	;　ナイトルーラー・ザ・ブラッドディーラー。
	;　ワラキアの夜のラストアーク。
	;　闇色の巨大な回転のこぎりと化して轢く、という感じの技。二段攻撃なのは、往復して轢くからか。
	;　なによりも有名なのはそのセリフだろう。
	;　下記の口上はワラキアの夜のセリフをモデルにしているのだが（そのまま引用はしてない）、
	;　こんな感じの芝居がかった・狂的なセリフを、声優さんは一発で撮ったという逸話がある。
	;　ワラキアも使ってたんですよ、リーチが長いキャラはいいわ……教授は使えなかったけど……
	ELSEIF CFLAG:ARG:입력행동 == 2981
		IF 0
		ELSEIF 現HP割合(ARG) < 33
			IF 0
			ELSEIF RAND:6 == 0
				PRINTFORML ┃%"이리하여 까마귀는 날개를 잃고 타인의 눈에 띄지 않은 채 지평선에 잠긴다……",72,LEFT%┃
				PRINTFORML ┃%"아아―― 비극이라 한들 희극이라 한들――",72,LEFT%┃
				PRINTFORML ┃%"――피날레는 모름지기 화려해야 마땅한 법!",72,LEFT%┃
			ELSEIF RAND:5 == 0
				PRINTFORML ┃%"아아―― 차마 듣지도 못할 분노와 탄식, 아까운 무참한 변명과 사죄!",72,LEFT%┃
				PRINTFORML ┃%"웃어라 그대들 파도 소리처럼, 파편 단편 5분의 영혼!",72,LEFT%┃
			;いよいよもって不可知にそうろう。
			ELSEIF RAND:4 == 0
				PRINTFORML ┃%"윤회의 끝은 난숙하고 저편의 탑은 붕괴와 붕락을 재촉하며 거짓 없이 모두에게 개장,",72,LEFT%┃
				PRINTFORML ┃%"점점 더 알 수가 없사옵니다……!",72,LEFT%┃
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"하찮아, 하찮아, 하찮아 하찮아 하찮아!",72,LEFT%┃
				PRINTFORML ┃%"배울 수 없어 배울 수 없어, 너한테선 배울 수 없어!",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"막을 열어라, 명배우를 노래하게 하라 음악을 울려 퍼지게 하라 삼류의 목을 베어라!",72,LEFT%┃
				PRINTFORML ┃%"날려라, 날려라 날려라 날려라앗……!",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"시계탑에서 추락사 구가, 사기로 짜 맞춘 나침반은 휴지통에 처넣으리!",72,LEFT%┃
				PRINTFORML ┃%"돌려라 돌려라 돌려라 돌려라아앗……!",72,LEFT%┃
			ENDIF
		ELSE
			IF 0
			;揃えたい＆英訳されてなかったのでカット
			;「夜の支配者、血の取引者」……という意味合いだろうか。
;			ELSEIF RAND:5 == 0
;				PRINTFORML ┃%"タタリ：Night ruler the blood dealer……",72,LEFT%┃
			ELSEIF RAND:4 == 0
				PRINTFORML ┃%"시곗바늘은 혼란하고 구타 살해의 장막은 열리며 절정 같은 죽음은 누구에게나 찾아오리라!",72,LEFT%┃
				PRINTFORML ┃%"돌아라, 돌아라, 돌아라 돌아라 돌아라앗……!",72,LEFT%┃
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"돌고 도는 운명은 급전직하, 순위 변동 후 신명은 사기를 치네!",72,LEFT%┃
				PRINTFORML ┃%"돌아라, 돌아라, 돌아라 돌아라 돌아라앗……!",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"돌아라 톱니바퀴여, 시계 속 사회 속 인간 속 정신 속 기구 속!",72,LEFT%┃
				PRINTFORML ┃%"돌아라, 돌아라, 돌아라 돌아라 돌아라앗……!",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"개연 직후부터 참살 삼매경, 잡다 찬동 끝에 명연기는 화장 후에 칭송받으리라!",72,LEFT%┃
				PRINTFORML ┃%"돌아라, 돌아라, 돌아라 돌아라 돌아라앗……!",72,LEFT%┃
			ENDIF
		ENDIF
	;2982,스피어・브레이크・슬라이더
	;　＞万能、威力250*3-7、全体ランダム、魔、消費50　単体最大ヒットは4
	;　命中80とやや不安。
	;　メルブラ系には珍しく、HP条件がない。ただただ強い。
	;　単体相手には、攻撃回数が少ないぶん威力が強い万魔の乱舞のようにも使えますかね。
	;　BH状態のとき青子が使用すると、ラストに全体攻撃「スライダー」で追撃するように変更しました。
	;　/
	;　青崎青子のアナザーアーク。
	;　なんかこう、手足からビームをぶっ放す。
	;　アークドライブは「スヴィア・ブレイク」までで、両腕からイッパツづつビームぶっぱするだけなのだが、
	;　「スライダー」が入ると、飛び上がって足先から地面を薙ぎ払うビームが入る。
	;　青崎青子は魔術士としてはせいぜい平均的、だいたいの部分でけっこうへっぽこなのだが、
	;　唯一、破壊については極めて優れた才能を持つとされる。
	;　ニンゲンミサイルランチャーとか宇宙戦艦とかなんか聞くだにやべー異名を持つ。たぶんこれはその発露であろう。
	;　ラストアークの方では、彼女が「くっそやべーやつ」と評される原因である魔法を使っているくさいのだが。
	;　今更なのだが、型月作品において、
	;　「魔術は人の手で再現できるもの（同様の結果を得られるもの）」、
	;　「魔法は人の手で再現できないもの」となる。
	;　彼女の魔法は、「時間旅行を可能にする」もののようだが、これは「ある特定の事象の応用でやってること」のようで、
	;　正確にはどんなものかはまだ公開されていない。
	;　一説によれば「光速を超える」こととか、なんとか。
	;　/
	;　真空中の光速……光の速度は「この世で最も早い」ものであるのは、相対性理論にて語られていること。
	;　光速は常に一定であり、光の速度が変わっていると思われるときは、「時間が遅くなっている」。
	;　速度はホラ、「速度×時間＝距離」とかやったと思いますけれど、光速は一定なので、そうなると「距離や時間が変動せざるを得ない」。
	;　光に限りなく近い速度で飛行する物体から見える光は、やはり光の速度で飛んでいる。それで考えていくと、「距離（＝空間）が縮む」という計算結果が得られる。
	;　光速に限りなく近づけば、外部から見るとほとんど時間が停止するため、これをもって「未来にはイケる」とされる。
	;　質量をもつ物質が光速に近づくと質量が無限大になってしまう。
	;　質量とは大雑把に言うと「動かしにくさ」なので、「加速にかかるエネルギーも無限大になってしまう」ため、物質は光速に到達できない。
	;　光が光速を出せるのは質量を持たない波だからである（もう少し言うと粒子と波の性質を両方持つ「量子」なわけだけど）
	;　ただし実は「光速を超える」こと自体は出来ている。
	;　例えば、レーザー光線を光速で振り回せば、「照らされている場所」の速度は光速を超える。
	;　また、宇宙の膨張速度は光の速度を超えている。
	;　「物質の速度」は光速を超えないが、「空間の速度」は光の速度を超えられるのだ。
	;　量子力学でもいくらか似たような例がある。
	;　ただし、これらの例でも、「情報の伝達速度」は光速を超えない。
	;　真に光速を超えた時、過去へ行ける……というような説もある。
	;　地球を超高速で飛び去って地球側を観測すると、昔の地球から発された光が見えることになる。
	;　そういう情報を魔術的に観測したり改変したりする――『そこにいたと観測されたことにする』魔法なのかもしれない。
	;　物理、ムズカシネー。
	ELSEIF CFLAG:ARG:입력행동 == 2982
		IF 0
		;Severe Break Slider、「重度の破壊の雪崩れ」……雪崩はちょっと違うか。
		;「スヴィア」という言い方なのでちょっと耳慣れないが、つまり「そりゃちょっと厳しいぞ」の「シビア」である。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"코드 블루：Severe Break Slider……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"魔力集中、多重展開……",72,LEFT%┃
			PRINTFORML ┃%"메기도 상당 위력…… 탄창 장전……",72,LEFT%┃
			PRINTFORML ┃%"손발의 위력에 실어…… 내뿜겠습니다……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"시비어. 브레이크―― 슬라이더……!",72,LEFT%┃
		ENDIF
	;2983,극사・나나야
	;　＞複合/타격/剣撃、威力350、単体、物、消費40　CT特殊　打撃即死50-95　CTはHP残量に依存、5/30
	;　打撃での即死という非常にレアな効果を持つ。
	;　単体攻撃だが、この即死率なら消費に文句もない。むしろ安い方。
	;　BHで命中とCTが上昇する。
	;　/
	;　きょくし・ななや。
	;　七夜志貴のラストアーク。
	;　ナイフを投げつけ、同時、飛びかかって首をへし折る。
	;　ナイフを防げば首の骨、首折りを防げばナイフが突き立つ、独り同時攻撃。
	;　当然というか、人間はたいていの投擲より素早く動けないのだが（素人の投擲だって70km/hくらいは出る）（ボクサーのジャブですら50㎞/hが記録上最速）、
	;　そこはオハナシの登場人物というあたり。
	;　打撃での即死は、首のへし折り（というかねじ切り）によるものだろう。
	;　あ、ちなみにというかアレだけど、素人ならパンチよりは投擲の動きで手を叩きつけたほうが痛いぞ。
	;　それこそ、素人でも末端速度は70㎞/hくらい出るからね。石とか握りこんでやるのがおススメ。
	ELSEIF CFLAG:ARG:입력행동 == 2983
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"꽃으로 져라―― 오늘 밤, 극채색의 밤에……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"Extreme Death ： Seven Nights……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"……아아. 즉. 이런 것일까요.",72,LEFT%┃
			PRINTFORML ┃%"사람을 죽이는, 업이라는 것은……",72,LEFT%┃
		;実際はきょくし――ななや。って感じのセリフですがね
		;「ななつよる」は、月姫原作において、志貴の使っていた飛び出しナイフのこと。
		;銘……というか、柄に「七ツ夜」と刻まれている。七夜家に伝わる宝刀らしい。
		;飛び出しナイフという、どこをどうやっても脆くなる構造なのに、なんかやたらと頑丈。
		;少なくとも、志貴の体より先に壊れたことはないはず。
		ELSE
			PRINTFORML ┃%"죽음의 극치임을 보여드리겠습니다……",72,LEFT%┃
			PRINTFORML ┃%"코드…… “나나츠요루(일곱 밤)”……",72,LEFT%┃
		ENDIF
	;2984,트라이헤르메스・블랙랜드
