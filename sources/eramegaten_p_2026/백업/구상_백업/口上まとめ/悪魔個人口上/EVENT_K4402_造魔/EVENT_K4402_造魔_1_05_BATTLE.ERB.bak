ELSEIF RANGE(CFLAG:ARG:입력행동,601, 699)
	IF 0
	;0601,테트라쟈
	;　＞万能、威力--、単体、--、消費MP18
	;　即死防御の壁を張る。その他バステ防止壁はあまり付与できるものではない。即死は強い分対策がされてるというか。
	;　……これで一手は使いたくないんだよなぁ……
	;　もちろん、この手のスキルを「ついでに」つかうスキルは基本的に強い。
	;　「威力400」のスキルと、「威力200＋테트라쟈」のスキルがあったとして、どちらが強いかというと後者。
	;　（もちろん、MP消費や、他に火力の出る技を確保していれば、の話）
	ELSEIF CFLAG:ARG:입력행동 == 601 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Tetraja……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"대즉사 저주 방벽, 전개합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"즉사 방어벽을 형성합니다……",72,LEFT%┃
		ENDIF
	;0602,테트라칸
	;　＞万能、威力--、単体、--、消費MP45　物理反射
	;0603,마카라칸
	;　＞万能、威力--、単体、--、消費MP45　魔法反射
	;　物理、魔法反射。何気にというか実はと言うか当たり前に死ぬほど強力
	;　ちなみにこれは正確には「物理相性反射」と「魔法相性反射」であって、
	;　「剣撃魔法」、「火炎物理」は、それぞれテトラカーン、マカラカーンで反射できる。
	;　また、万能はどちらでも反射できない。
	ELSEIF RANGE(CFLAG:ARG:입력행동,602, 603)
		IF 0
		ELSEIF RAND:3 == 0 && CFLAG:ARG:입력행동 == 602
			PRINTFORML ┃%"스킬 코드: Tetrakarn……",72,LEFT%┃
		ELSEIF RAND:3 == 0 && CFLAG:ARG:입력행동 == 603
			PRINTFORML ┃%"스킬 코드: Makarakarn……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"미러 매직, 릴리즈……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"반사벽을 형성합니다……",72,LEFT%┃
		ENDIF
	;0604,패러다임시프트
	;　＞万能、威力--、単体、--、消費MP0
	;　敵専用。耐性がランダムに変化する。
	;　具体的に言うと、RAND6から2を引いた結果×100の耐性になる。
	;　ただし-200は反射（999）、200は150、300は200になる。
	;　……「2倍弱点.1.5倍弱点.通常.無効.吸収.反射」のいずれかに、ランダムで変化、となる。
	;0605,어두운밤의드레스
	;　＞万能、威力--、単体、--、消費MP0　物理反射　魔法反射
	;　テトラ＋マカラ。敵専用。
		;Moonless Gown
		;月無き夜の衣、というあたりか。
	;0606,사이코배리어
	;　＞万能、威力0、味方全体、魔、消費24
	;　★壁
	;　精神相性の壁。……なんで防御にあるんだ……？　いやあるいは、他がそれぞれの相性にあるのが悪いのか……？
	;　継承タイプが「방어」なので、精神に強いタイプのキャラが引き継げないかもしれない。
	ELSEIF CFLAG:ARG:입력행동 == 606 && CFLAG:807 >= 3
		IF 0
		;ぷさいちょ、って読んじゃうよね最初。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Psycho Barrier……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"사이코 배리어 전개합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"精神防御精神壁、展開……",72,LEFT%┃
		ENDIF
	;0607,마하애널라이즈
	;　＞万能、威力0、味方全体、魔、消費50
	;　★壁
	;　万能まで含めてすべての相性への壁。
	;　ちなみにというか、「すべての相性を１回づつ防ぐ」壁である。
	;　火炎と氷結と電撃と衝撃、１回づつなら全部無効にできる。
	;　火炎４回だと、３回は素通り。
	;　正直コレ使えちゃいけないやつだと思う。
	;　……原作だと完全無敵ギミックだったらしいので、まだましか。
	;　今作るのだとしたら、ゲージ技になるだろうか。少なくともリキャストタイムは設けたいトコロである。
	;　17手を１手に圧縮してるからね、コレ。造魔ちゃんが使えるかというと、東方EX、さとりが覚えた気がするね。やばい。
	;　/
	;　ちなみにというかこれは『P4G』、「りせの影」戦での特殊スキルである。
	;　りせの影はポールダンス……しかもスケベな感じのやつ……を行っており、すげービジュアルをしている。
	ELSEIF CFLAG:ARG:입력행동 == 607
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"메타: Maha Analyze……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"신체능력 100% 해석…… 모두 예견하겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"상세 분석…… 단기간 미래 예측…… 무효화합니다……",72,LEFT%┃
		ENDIF
	;0608,결계부・물리
	;　＞万能、威力0、味方全体、魔、消費50　物理反射
	;0609,결계부・마법
	;　＞万能、威力0、味方全体、魔、消費50　魔法反射
	;　テトラ・マカラカーン。発生がちょっと早い（+6）
	ELSEIF RANGE(CFLAG:ARG:입력행동,608, 609)
		IF 0
		ELSEIF RAND:3 == 0 && CFLAG:ARG:입력행동 == 608
			PRINTFORML ┃%"스킬 코드: Phys Repel……",72,LEFT%┃
		ELSEIF RAND:3 == 0 && CFLAG:ARG:입력행동 == 609
			PRINTFORML ┃%"스킬 코드: Magic Repel……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"미러 매직, 배리어 필드 전개……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"결계부, 투사합니다……",72,LEFT%┃
		ENDIF
	;0610,수호의방패
	;　＞万能、威力0、味方全体、魔、消費50　特殊効果あり
	;　★壁
	;　味方全体になんでも防ぐ壁１回。マハ・アナライズよりはマシだがこっちも正直使えちゃいけないやつである。
	;　プラグインに「솔로몬의결혼반지」を付けていると、消費が「忠誠度1000」になる。
	;　ソロモンの結婚指輪には、「絆の力」「絆の奇跡」「수호의방패」を使用できるようになる効果がある。
	;　/
	;　ともあれ、「高難度ボス」を作るなら、コレが来る前提で考えたほうがいい気がする。
	;　コレ使うだけで、少なくとも同格以下の敵にはまず負けない。
	ELSEIF CFLAG:ARG:입력행동 == 610
		IF 0
		;ヨーコさんがこれ使ったあたりの展開結構好き
		;いやしかし今になって『BASTARD!! -暗黒の破壊神-』がアニメ化するとは……
		;30年ちょっと前の作品なので、当時読んでいたエロガキ小学生とかも、もう40代半ばあたりになりますでしょうかね。
		ELSEIF RAND:100 == 0
			PRINTFORML ┃%"엘렘 레남 에이린……",72,LEFT%┃
			PRINTFORML ┃%"성령이여, 나의 방패가 되어 주소서……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"배리어: Shield of Defense……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"절대방어벽, 전개합니다……",72,LEFT%┃
		ENDIF
	;0611,존승다라니
	;　＞万能、威力--、単体、--、消費MP18
	;　尊勝仏頂。ヴィキラノーシュニーシャ。
	;　仏頂尊、仏さまの頭部の盛り上がりを神格化した仏さま……の、陀羅尼、まあ呪文。
	;　スキル口上のは……まあ、言っちゃえば短縮詠唱で、フルでは以下の通り。
	;　　ナウボバギャバテイ・タレイロキャ・ハラチビシシュダヤ・ボウダヤ･バギャバテイ。
	;　　タニャタ・オン・ビシュダヤ・ビシュダヤ・サマサマサンマンタ・ババシャソハランダギャチギャガナウ・ソハバンバ・ビシュデイ。
	;　　アビシンシャトマン・ソギャタバラバシャナウ・アミリタ・ビセイケイマカマンダラハダイ・アカラアカラ。
	;　　アユサンダラニ・シュダヤシュダヤ・ギャギャナウビシュデイ・ウシュニシャビジャヤ・ビシュデイ・サカサラアラシメイ・サンソジテイ・
	;　　サラバタターギャタ・バロキャニ・サタハラミタハリホラニ・サラバタターギャタ・キリダヤ・ジシュタナウ・ジシュチタ・マカボダレイ・
	;　　バザラキャヤ・ソウカ・タナウ・ビシュデイ・サラババラダ・バヤドラギャチ・ハリビシュデイ。
	;　　バラチニバラタヤ・アヨクシュデイ・サンマヤ・ジシュチテイ・マニマニマカマニ。タタータボタクチ・ハリシュデイ・ビソホタ・
	;　　ボウジシュデイ・シャヤシャ・ビジャヤビジャヤ・サンマラサンマラ。
	;　　サラバボダ・ジシュチタシュデイ・バジリバザラギャラベイ・バザランババトママ・シャリラン・サラバサトバンナン・
	;　　シャ・キャラハリビシュデイ。サラバギャチハリシュデイ・サラバタターギャタシッシャメイ・サマジンバサエンド・サラバタターギャタ・
	;　　サマジンバサ・ジシュチテイ・ボウジヤ・ボウジヤ・ビボウジヤ・ビボウジヤ・ボウダヤ・ボウダヤ・ビボウダヤ・ビボウダヤ・
	;　　サンマンダ・ハリシュデイ・サラバタターギャタ・キリダヤ・ジシュタナウ・ジシュチタ・マカボダレイ。ソワカ。
	;　ちなみに陀羅尼はだらにと読み、サンスクリット語「ダーラニー」の音写。
	;　陀羅尼の呪文も、意訳せず（翻訳せず）サンスクリット語で読む。
	;　ダーラニーとは「記憶して忘れない」という意味。それが転じて、「暗記されるべき呪文」となったとか。
	;　ビミョーに本末転倒というかなんというか。
	;　ちなみにシメは成功を祈る聖句「スヴァーハー」という決まり文句。「薩婆訶」と漢書し、日本語では「そわか」と読まれる。
	;　ふふふ、ソワカソワカ。
	;　wikipediaより、
	;　＞『今昔物語集』「尊勝陀羅尼の験力によりて鬼の難を遁るる事」（巻14の42）
	;　まあつまり、「ありがたいお経書いたの持ってたら妖怪に害されなかったよ」ってお話がいくつか残ってるわけだな。
	;　/
	;　なお、中身はテトラジャ。속도보정+6。クラス・陰陽師あなた専用。
	ELSEIF CFLAG:ARG:입력행동 == 611
		IF 0
		;英訳：Pride
		;Usnisavijayaは、サンスクリットで尊勝仏頂のこと。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"자존심: Usnisavijaya……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"비키라노슈니샤 다라니…… 스바하……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"옴 보롱 사바하 옴 아미리타 아유다디 사바하……",72,LEFT%┃
			PRINTFORML ┃%"존승불정이여, 우리를 지켜주소서……",72,LEFT%┃
		ENDIF
	;0612,수정의벽
	;　＞万能、威力--、単体、--、消費MP16
	;　★壁
	;　対核熱の壁。
	;　なぜここにあるのか……
	ELSEIF CFLAG:ARG:입력행동 == 612 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Crystal Wall……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"결정 장벽 전개…… 핵열광 확산 준비 완료……",72,LEFT%┃
		;牡羊座の聖闘士が使用する技法。
		;眼前に光の壁を生成し、敵からの攻撃を防ぐ。
		;この壁は半透明であるが、悟られないようほぼ完全な透明状態で展開することも可能なようだ。
		;防御力はめちゃくちゃ高く、同格の（であるはずの）蟹や魚の必殺技を弾き返していた。
		ELSE
			PRINTFORML ┃%"크리스탈 월…… 전개……!",72,LEFT%┃
		ENDIF
	;0613,펜타월
	;　＞万能、威力--、単体、--、消費MP24
	;　★壁
	;　対神経の壁。ちょっと消費が大きい。
	ELSEIF CFLAG:ARG:입력행동 == 613 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Pentawall……",72,LEFT%┃
		;この場合のペンタとは、ペンタグラム、のことだろう。
		;「Penta」だけで「５」の意を持つ。グラム、は「書かれたもの」のこと。
		;これを上下逆向きに書くと、悪魔崇拝の意となる。
		;日本でも魔除けの呪符として使用された例がある。
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"五芒星図形描画……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"펜타그램 결계 기동…… 수호로 삼겠습니다……",72,LEFT%┃
		ENDIF
	;0614,フリフリウォール
	;　＞万能、威力--、単体、--、消費MP16
	;　★壁
	;　バステ壁。バステを一回無効にする。地味ながらめちゃくちゃ強い。
	;　こちらはすべてのバステを無効化するんだが、即死も防ぐので、テトラジャの上位互換だったりする。
	ELSEIF CFLAG:ARG:입력행동 == 614 && CFLAG:807 >= 3
		IF 0
		;正直このスキルの英訳どうなってるかめっちゃ楽しみだった
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Frilly Wall……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"프로텍션 프롬 에일먼츠……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"다중 환영 기동…… 대상 착오·오로라 필드 전개……",72,LEFT%┃
		ENDIF
	;0615,エナジーシャワー
	;　＞万能、威力--、単体、--、消費MP7
	;　★壁
	;　バステ壁。こちらはSHOCK、FREEZE、FLAME、SLIP防御。
	;　大抵の場合フリフリウォールでいいのだが、こちらは「SHOCKを防いだからと言ってFLAME他の壁も消えるわけではない」のが強み。
	ELSEIF CFLAG:ARG:입력행동 == 615 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Energy Shower……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"활력의 비여 내려라……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"속성 효과 감쇠운…… 형성합니다……",72,LEFT%┃
		ENDIF
	;0616,정의의방패
	;　＞万能、威力--、単体、--、消費MP60
	;　★壁
	;　「俺の後ろに隠れろ」……違う。これはTさんだ。
	;　全相性への壁。ばーか！　マハアナライズが弱いわけねーだろ！
	ELSEIF CFLAG:ARG:입력행동 == 616
		IF 0
		;このデモンストレートは、たぶん、冷笑的。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Righteous Shield……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"무엇보다도 추악한 방패를 형성하겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"나의 정의는……" + CSTR:일인칭 + "의 정의란……?",72,LEFT%┃
		ENDIF
	;0617,심도미스테리
	;　＞万能、威力--、単体、--、消費MP55
	;　★壁
	;　護りの盾と同様。ただしちょっと発生が早い
	;　/
	;　シンドゥとは、おそらく「Sapta Sindhu」……サンスクリット語で「シンドゥ七大河」、
	;　ヒンドゥー教の聖典、『リグ・ヴェーダ』に記載されている七つの神聖な河のことと思われる。
	;　『インダス(シンドゥ)河の七つの大河の謎（謎めいた術）』という意味合いと思われる。
	;　パッと思いつくのは、「で、結局どの河のことを指して七大河って言ってるの……？」なんだけど。
	;　P2罰では、ゲンジョウ・セイテンタイセイ・テンポウゲンスイ・ケンレンタイショウ・リュウメの合体魔法。
	;　一定ターン無敵になるが行動不能になる……というスキルだったらしい。
	;　ひとりで使うんじゃない（おこ）
	ELSEIF CFLAG:ARG:입력행동 == 617
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"에니그매틱：Sindhu Mystery……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"신두 칠대하에 의한 해자를 형성합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"신성한 일곱 대하의―― 이것이야말로 승려를 홀리는 일세의 수수께끼……",72,LEFT%┃
		ENDIF
	;0618,独覚
	;　＞万能、威力--、単体、--、消費MP20
	;　師なくして、ひとりで悟ることを言う。
	;　もう少し正確に言うと、「師につかず、自ら世の理を悟り、そして誰かに説くこともない」修行僧のことを言う。無師独悟。
	;　ミロク菩薩がこれを覚えるのは、皮肉なのか何なのか。
	;　あ、効果は「使用ターン、弱点ダメージを吸収し、吸収に成功すると全能力向上でコンセ気合い」。
	;　……造魔ちゃんには無用だなぁ……
	ELSEIF CFLAG:ARG:입력행동 == 618
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Self-Righteous Vow……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"독각―― 스승 없이 홀로 깨닫는다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"나, 비화낙엽을 스승으로 삼아 홀로 깨닫는다……",72,LEFT%┃
		ENDIF
	;その他汎用
	;　汎用が出なくなって実質専用になるって、なんかスパロボOGで見たなァ……
	ELSEIF CFLAG:807 >= 3
		PRINTFORML ┃%"방어벽을 형성합니다……",72,LEFT%┃
	ENDIF


;-------------------------------------------------
;○화염
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,701, 799)
	IF 0
	;0701,아기
	;0702,아기라오
	;0703,아기다인
	;0764,아기바리온
	;　＞火炎、威力140、単体、魔、消費MP3
	;　＞火炎、威力235、単体、魔、消費MP6
	;　＞火炎、威力330、単体、魔、消費MP12
	;　＞火炎、威力410、単体、魔、消費MP22
	;0704,마하・라기
	;0705,마하・라기온
	;0706,마하・라기다인
	;0765,마하・아기바리온
	;　＞火炎、威力130、列、魔、消費MP5
	;　＞火炎、威力210、列、魔、消費MP12
	;　＞火炎、威力305、列、魔、消費MP20
	;　＞火炎、威力380、列、魔、消費MP30
	;　非常に基礎的なスキル。
	;　スキルの発展や分岐、最終段階含めて、これ最初に作ったんじゃない？って聞きたくなるレベル。
	;　ちなみにアギ、火力がヤマオロシとかあの辺より高く、命中しやすく、コストにも差がほとんどない。
	;　アギダインで火力が330と「大威力」級だが、その分コストは12とお安め。
	;　アギは「アグニ」が語源とされる。
	;　/
	;　「バリオン」が追加された。
	;　バリオンはダインから派生できない。
	;　マハラギバリオンは、デッドリーバーンのほうが、まあ強いね……というバランスではありつつ、わりかしホイホイばらまける強さになっていると思う。
	;　高位悪魔がデフォで「マハラギダイン」とか使ってくるのを、バリオンにするだけで、それっぽくなる感じ。
	;　威力が足を引っ張って、殺されない、というケース、けっこうある。
	;　/
	;　インド系じゃないやつも「아기」使うのはどうして？　問題。
	;　設定上「아기」には、例えば「メラ」や「ファイア」が含まれる。
	;　みんながアギという術を使っているのではなく、術の結果を……「低級火炎魔法」として現れるもの全般を、「아기」と呼んでいるらしい。へー。
	;　たぶん設定的には、下記火炎スキルの中にも「아기」となるやつが結構あるんだろう。
	ELSEIF GROUPMATCH(701, 702, 703, 764, 704, 705, 706, 765) && CFLAG:807 >= 3
		;半分で通常・範囲共通
		IF RAND:2 == 0
			PRINTFORML ┃%"火炎術詠唱……" + LOCALS + "……",72,LEFT%┃
		;単体
		ELSEIF GROUPMATCH(701, 702, 703, 764) && CFLAG:807 >= 3
			PRINTFORML ┃%"火弾投射……" + LOCALS + "……",72,LEFT%┃
		;範囲
		ELSE
			PRINTFORML ┃%LOCALS + "(으)로…… 불태워 버리겠습니다……",72,LEFT%┃
		ENDIF
	;0707,불의벽
	;　＞火炎、威力--、全体、魔、消費MP16
	;　★壁
	;　火炎の壁。氷結を防ぐ。
	ELSEIF CFLAG:ARG:입력행동 == 707 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Fire Wall……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"플레임 필드…… 전개합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"耐氷火炎防壁、展開……",72,LEFT%┃
		ENDIF
	;0708,파이어브레스
	;　＞火炎、威力140/76、拡散、物、消費MP6
	;　威力は低いが、序盤ではわりと貴重な「火炎物理」。
	;　763.ヘルファイアーに派生する
	;　/
	;　火の息、というのは、物語においては定番である。
	;　10世紀ごろの『ベーオウルフ』に炎を吐き財宝を守り……というドラゴンが登場している。
	;　作品によっては、「硫黄の吐息」「毒気」……といった設定となることもある。
	;　例えばタラスクは「毒の息」を吐いたとされる。
	;　この起源はぶっちゃけはっきりしない。上述、『ベーオウルフ』がテキストとして残る最古級のものだからだ。
	ELSEIF CFLAG:ARG:입력행동 == 708 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Fire Breath……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"파이어 브레스를 내뿜습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"횻토코 재주를…… 피로하겠습니다……",72,LEFT%┃
		ENDIF
	;0709,지옥의업화
	;　＞火炎、威力150*1-5、全体ランダム、魔、消費MP15　単体最大ヒット未設定
	;　敵全体ランダム、1-5回小威力攻撃。
	;　名前のわりには……という感じがないでもないが、実は最大HITが設定されていないので、最大威力は非常に高い。
	;　単体最大ヒットを設定するべきかは……１から５回ランダムとか言うKUSO設定なのでいいかな。適正。という感じ。
	ELSEIF CFLAG:ARG:입력행동 == 709 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Hellfire……",72,LEFT%┃
		;悪魔火　(Ｘ)(赤)
		;ソーサリー
		;クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。悪魔火はそれにＸ点のダメージを与える。このターン、これによりダメージを与えられたクリーチャーが死亡するなら、代わりにそれを追放する。
		;暴勇 ― あなたの手札にカードがないなら、この呪文は打ち消されず、そのダメージは軽減されない。
		;/
		;強力なカードのひとつ。俗にいうX火力。
		;加筆者はパーミッション系をよく使ってたので、暴勇状態でぶっ放されるとかなり面倒だった。
		;対処手段はないでもないが……
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"악마의 불꽃을 발합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"업화염, 방사합니다……",72,LEFT%┃
		ENDIF
	;0710,파이어스톰
	;　＞火炎、威力180、全体、魔、消費MP18
	;　コストそこそこの全体攻撃。이검난무。
	ELSEIF CFLAG:ARG:입력행동 == 710 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Fire Storm……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"불꽃의 소용돌이를 발합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"불꽃의 폭풍을 발생시킵니다……",72,LEFT%┃
		ENDIF
	;0711,데들리번
	;　＞火炎、威力420、全体、魔、消費MP35
	;　★デッドリーバーン系
	;　全体特大威力火炎魔法攻撃。
	;　火炎系スキルで使いやすくて強いっつったらコレ。
	;　これ以上を望むと、途端に入手が難しくなる。っていうか、これも簡単なわけではない。ソルレオンとかが持ってるんだったかな。
	;　属性が変わっただけ……みたいなスキルも結構多いです。アクアリータイドとか雷震王母とか。
	;　他属性スキルだと、ニブルヘイムやツインクルネビュラなど、専用スキルかそれに近いものになることも。
	;　まあこれや虚空ザッパーもレアな部類ですが、ルートによっては手に入らないもろもろよりはずっとまし。
	ELSEIF CFLAG:ARG:입력행동 == 711
		;有能技かつ入手も（簡単ではないとはいえ）可能なので多めに
		IF 0
		ELSEIF RAND:7 == 0
			PRINTFORML ┃%"……풀 파이어……!",72,LEFT%┃
		ELSEIF RAND:6 == 0
			PRINTFORML ┃%"불꽃이여 집어삼켜라…… 땅속 깊은 곳에 거두어라……",72,LEFT%┃
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"불타 스러져라……!",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"남김없이 태우겠습니다……!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Deadly Burn……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"저승길의 불길에 휩싸여라……!",72,LEFT%┃
		;　ぞうまちゅうにびょう
		ELSE
			PRINTFORML ┃%"명옥의 화염으로…… 그 영혼까지 태워버리겠습니다……!",72,LEFT%┃
		ENDIF
	;0712,다이나믹・아기라오
	;　＞火炎、威力「ＭＰ * 4 + 225」、単体、魔、消費MP全
	;　★マダンテ系
	;　人が死ぬ
	;　運用等については、超メギドを参照。
	ELSEIF CFLAG:ARG:입력행동 == 712
		;MP1万以上。ちょっとはっちゃけますよ。
		;昔懐かし、絵がやたら派手でエロが入った最強魔法使いの、アレ。カタカナ部分。
		;平仮名だと、いあ！いあ！っぽい感触がありますね。
		;２ページブチ抜きで「てめぇは死ねぇ～～～～！」って叫んでる場面がえっらい印象に残っている。
		;アニメはどうなるでしょうねぇ……
		IF FLAG:확산플래그 >= 40225 || BASE:ARG:ＭＰ >= 10000
			IF RAND:2 == 0
				PRINTFORML ┃%"자아자아도·자아자아도·스쿠로오노오·로오노스우쿠……",72,LEFT%┃
				PRINTFORML ┃%"……다이내믹하게, 죽어라……",72,LEFT%┃
			;豪華な四体合体攻撃ですが正直魅せ技ですよね
			ELSE
				PRINTFORML ┃%"파이널…… 다이내믹…… 아기라오…… 스페셜……!",72,LEFT%┃
			ENDIF
;			SIF CFLAG:827 == 0
;				CFLAG:827 = 1
		;MP900以上。900なのは超メギド参照。
		;どうしよ、長い。ダイナミックアギラオ。10文字。
		ELSEIF FLAG:확산플래그 >= 3825 || BASE:ARG:ＭＰ >= 900
			PRINTFORML ┃%"다이내믹 아기라오로…… 다이내믹하게 비추겠습니다……!",72,LEFT%┃
		;ランタン一族ということで
		ELSE
			PRINTFORML ┃%"다이내믹 아기라오로…… 휘황찬란하게 비추겠습니다……!",72,LEFT%┃
		ENDIF
	;0713,암흑광염난무
	;　＞多段/검격/화염/呪殺、威力115+100+80、全体、物/魔/魔、消費MP25
	;　검＋화염＋呪殺の多段攻撃。
	;　ちなみに複合ではない。一段目だけ（剣撃だけ）物理。
	;　言うて総合威力295の３相性多段全体攻撃なので、弱いわけではない。
	;　ただ、１段目が物理なので、物魔がひとつの技であっちこっちしており、威力はどうしても低くなりがち。
	ELSEIF CFLAG:ARG:입력행동 == 713
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Dark Fiery Fury……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"미쳐 춤추어라, 어둠의 불꽃……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"난무하라, 사악한 불꽃……",72,LEFT%┃
		ENDIF
	;0714,광염난무
	;　封印。つまり空欄だナ！
		;Fiery Fury
	;0715,오시치대화재
	;　＞火炎、威力140、列、魔、消費MP7
	;　ライドウ専用の列火炎攻撃。ちなみにマハラギオンに派生
	;　ところでどうしても「おひち大火」って発音しちゃうんだけどこれは江戸弁？
		;Oshimagyo
	;0716,사신소환・주작
	;　＞火炎、威力295、列、魔、消費MP21
	;　火炎大威力列攻撃。
	;　マハラギダインの方がたぶん強い。
	;　威力が10上で消費が1少ない。いちおう、こちらは命中が5上の95なので、完全下位互換ではない。
	;　継承不能の専用スキル、という性能は、まあしてない。
	ELSEIF CFLAG:ARG:입력행동 == 716 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"스킬 코드: Summon Suzaku……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"초래·주작…… 날아올라라……!",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"術式構築……真名偽装登録……",72,LEFT%┃
			PRINTFORML ┃%"사바트마, 의사 재현 완료…… 초래, 주작……",72,LEFT%┃
		;朱雀ちゃんは白ゴスお嬢様。
		ELSE
			PRINTFORML ┃%"術式構築……真名偽装登録……",72,LEFT%┃
			PRINTFORML ┃%"사바트마, 의사 재현 완료…… 와주세요, 주작 짱……!",72,LEFT%┃
		ENDIF
	;0717,불꽃의난무
	;　＞火炎、威力160*2-8、全体ランダム、魔、消費MP15　単体最大ヒットは３
	;　★乱舞シリーズ
	;　불꽃의난무。
	;　あんまり乱舞系は強くないイメージがある
	;　160*3は十分な威力のハズなんだけども。……単体相手でも3にならない時があるからか。
	;　とはいえ中盤から威力320または480の単体攻撃をぶち込める、ってのは実際弱いわけがないのである。
	ELSEIF CFLAG:ARG:입력행동 == 717 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Fire Dance……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"춤추어라, 염화……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"난무하라, 불꽃……",72,LEFT%┃
		ENDIF
	;0718,트리스아기온
	;　＞火炎、威力550、単体、魔、消費MP40　条件付き貫通
	;　★気合コンセで貫通シリーズ
	;　単体超威力ダメージ。
	;　/
	;　トリスアギオンとは、ギリシャ語（ヘブライ語）で『聖なるかな』。
	;　正確には、「聖なるかな、聖なるかな、聖なるかな、昔いまし、今いまし、のち来たりたまう、主たる全能の神」……という聖句のことをさす。
	;　三回、聖なるかな、と唱える……という名付けか。
	;　セラフが神聖四文字のまわりを飛びながらこれを唱え続けているとされる。
	;　どうでもいいけど、「自分で作ったものに自分を讃えさせる」ってなんかねぇ。
	;　ともあれこれは、炎との関連は薄い言葉である。（この聖句の刻まれた短剣をセラフが持っているともされる、ってくらい）
	ELSEIF CFLAG:ARG:입력행동 == 718
		IF CFLAG:ARG:気合フラグ == 1
			IF RAND:2 == 0
				PRINTFORML ┃%"신성하도다, 언덕에 모여 성삼위를 받들라……",72,LEFT%┃
				PRINTFORML ┃%"――“그대, 삼위일체를 이루는 광염”……!",72,LEFT%┃
			;フル詠唱
			ELSE
				PRINTFORML ┃%"거룩하시다, 거룩하시다, 거룩하시다――",72,LEFT%┃
				PRINTFORML ┃%"옛적에도 계셨고, 지금도 계시며, 장차 오실 이여――",72,LEFT%┃
				PRINTFORML ┃%"성삼위 찬시 봉창―― 신화를 여기에 바치노라……",72,LEFT%┃
			ENDIF
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Trisagion……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"옛적에도 계셨고, 지금도 계시며, 장차 오실 이여――",72,LEFT%┃
			PRINTFORML ┃%"聖三讃詩奉唱……！",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"거룩하시다, 거룩하시다, 거룩하시다……",72,LEFT%┃
			PRINTFORML ┃%"신화를 여기에 바치노라……!",72,LEFT%┃
		ENDIF
