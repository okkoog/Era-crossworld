	ELSEIF CFLAG:ARG:입력행동 == 1150
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Sealing wings……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"翼部展開、刻印生成……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"翼部展開、刻印生成……",72,LEFT%┃
		ENDIF
	;1151,독소방어
	;　＞神経、威力300、全体、魔、消費0
	;　敵専用。そそられないのでカット。一応、命中が「9999」というのが特徴。
	;1152,악마의윙크
	;　＞神経、威力0、列、魔、消費5　神経麻痺/40-70
	;　列麻痺。攻撃能力はなし。
	;　達人アナタ専用？　まあ、達人はもっと強いの覚えまくるので書き換え候補ですわね。
	ELSEIF CFLAG:ARG:입력행동 == 1152
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Devil's Wink……",72,LEFT%┃
		;デビルマン、デビルマン。
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"데빌 윙크는 신경 마비……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"미신 구성을 안구에 장전…… 사출합니다",72,LEFT%┃
		ENDIF
	;1153,Burn my Dread
	;　＞神経、威力特殊、全体、魔、消費35　神経爆弾/25-50　歌唱技能に応じて100-300
	;　全体神経大ダメージ＋爆弾。歌唱技能最大だと地味に神経最強攻撃じゃないかな？
	;　それでも威力最大300だから悲しいわね。バイツァ・ダストより強いが。
	;　まだ歌系いたぁ――！　って感じで苦労した覚えがある。
	ELSEIF CFLAG:ARG:입력행동 == 1153
		IF RAND:100 == 0
			PRINTFORML ┃%"그럼 한 곡―― 자, " + CSTR:이인칭 + ". 마이크입니다",72,LEFT%┃
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"시간은 흐른다　소리 없는 장소를 뒤로하고",72,LEFT%┃
			PRINTFORML ┃%"바람 없는 밤이　희미한 달빛이",72,LEFT%┃
			PRINTFORML ┃%"어둠에　나를　녹여가네――",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"어둠에 춤추는 칼날이　피로 젖은 밤이",72,LEFT%┃
			PRINTFORML ┃%"절망으로　나를 붙잡아　얽매어　떨어뜨리고",72,LEFT%┃
			PRINTFORML ┃%"공포를　나약함을　나에게 들이대네――",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"미로 같은　소리 없는 장소를 앞에 두고",72,LEFT%┃
			PRINTFORML ┃%"나는　두려움에　헤매며　멈춰 서서",72,LEFT%┃
			PRINTFORML ┃%"멀리　묘표 같은　탑을 올려다보네――",72,LEFT%┃
