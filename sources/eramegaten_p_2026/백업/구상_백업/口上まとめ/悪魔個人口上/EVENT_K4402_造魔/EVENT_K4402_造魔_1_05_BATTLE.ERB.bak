ELSEIF RANGE(CFLAG:ARG:입력행동,301, 399)
	IF 0
	;0301,할퀴기
	;　＞戦技、威力65*2、単体、物、消費2
	;　302.毒ひっかき、303.マヒひっかき、304.メガクロー、306.アクセルクローに派生
	;　威力は低いが2回攻撃。以後、基本的に爪系は2回攻撃であるため、状態付与率や火力が高めになる傾向がある。
	;　全体的に「팔」「갈퀴발」「갈퀴」が継承に必要だが、使用には特に条件がない。
	;　なお、命中は逆に不安な水準で推移する。
	;　初台シェルター時点では最強の物理攻撃
	;　派生が多い基本的なスキル
	;0302,독할퀴기
	;　＞戦技、威力70*2、単体、物、消費3　神経猛毒25-60
	;0303,마비할퀴기
	;　＞戦技、威力70*2、単体、物、消費4　神経麻痺25-60
	;　★派生ルート
	;　　할퀴기
	;　　├독할퀴기
	;　　├麻痺ひっかき
	;　　├메가클로―스파이크클로―아이언클로
	;　　└악셀클로―데스클로┬허공조격
	;　　　　　　　　　　　　　　　　└광란의강조
	;　　発展させるならアクセルクロールートが発展性あり。
	ELSEIF RANGE(CFLAG:ARG:입력행동,301, 303) && CFLAG:807 >= 3
		;半分でひっかき系共通
		IF RAND:2 == 0
			PRINTFORML ┃%"발톱 부위 강화…… 찢어발기겠습니다……",72,LEFT%┃
		ELSE
			;かっちゃき
			IF CFLAG:ARG:입력행동 == 301
				PRINTFORML ┃%"조격을 행합니다……",72,LEFT%┃
			;ポイズンかっちゃき
			ELSEIF CFLAG:ARG:입력행동 == 302
				PRINTFORML ┃%"발톱 독 보충…… 주입합니다……",72,LEFT%┃
			;麻痺かっちゃき
			ELSEIF CFLAG:ARG:입력행동 == 303
				PRINTFORML ┃%"마비독 보충…… 주입하겠습니다……",72,LEFT%┃
			ENDIF
		ENDIF
	;0304,메가클로
	;　＞戦技、威力120*2、単体、物、消費6
	;　337.スパイククローに派生
	;　単体に2回かっちゃき中ダメージ。
	ELSEIF CFLAG:ARG:입력행동 == 304 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Mega Claw……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"메가 강화 조격……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"발톱 부위 강화·대…… 찢어발기겠습니다……",72,LEFT%┃
		ENDIF
	;0305,아이언클로
	;　＞戦技、威力245*2、単体、物、消費19
	;　単体に2回かっちゃき特大ダメージ。単純な火力で言うと汎用スキルでもかなり高い方。
	;　メガクローから間にスパイククローが挟まる。単体火力派生終着点。
	;　ちなみにこちらはコスト19、虚空爪がコスト20。……うーん？？？
	;　/
	;　FF5のカルナック城で出てくるあいつは「아이언클로」。
	;　なんかどうみても入らないのに「ぐんそう」の鎧を着こんでいたりする。オーバーボディでも着こんでるのか？
	;　瀕死＋麻痺効果の青魔法「데스클로」を習得可能で、FF5において「搦め手が一個増える」というのは即ち「ボスをぶっ殺せる」ということである。
	;　デスクローは即死耐性ではなく瀕死攻撃。
	;　瀕死攻撃は基本的に「ボス属性（ボス耐性）」を参照するタイプの攻撃で、まあ本来ボスには効いてはいけないのだが、
	;　ビブロスや飛竜草、封印を守る者、あとギガフレア準備中のツインタニアあたりに効く。というか、効いてしまう。
	;　（eratenにも、一部「ボス耐性がない」とか「ボス戦だけど逃げられて話も進む」戦闘がある。たぶん仕様です）
	;　ちなみにこのボス耐性、「ラスボスも持たないパーツがある」ため、斬鉄剣（※ボス耐性参照）で一刀両断されたりする。
	;　FF5ほどやりこみがされたゲームもそうないだろうなー。
	ELSEIF CFLAG:ARG:입력행동 == 305
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Iron Claw……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"철렬·강화 조격……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"발톱 부위 강화·특대…… 찢어발기겠습니다……",72,LEFT%┃
		ENDIF
	;0306,악셀클로
	;　＞戦技、威力95*2、列、物、消費10
	;　309.デスクローに派生
	;　列・二段ダメージ。派生の中間。
	ELSEIF CFLAG:ARG:입력행동 == 306 && CFLAG:807 >= 3
