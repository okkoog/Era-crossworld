;-------------------------------------------------
;○範囲攻撃て敵を撃破した
;-------------------------------------------------
;IF TFLAG:전투이벤트 == 14 && CFLAG:807 >= 5 && RAND:4 == 0
;ENDIF


;-------------------------------------------------
;○反射された
;戦闘口上フラグ（CFLAG:807）が５のとき限定、かつ4分の1
;-------------------------------------------------
IF TFLAG:전투이벤트 == 15 && CFLAG:807 >= 5 && RAND:4 == 0
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	;검격
	;切った箇所と同じ個所が切れる感じだろうか。
	IF RANGE(CFLAG:ARG:입력행동,1, 99)
		PRINTFORML ┃%"검섬이, 튕겨 나와서……",72,LEFT%┃
	;비구
	;＼二指真空覇／
	ELSEIF RANGE(CFLAG:ARG:입력행동,100, 199)
		PRINTFORML ┃%"!? 탄환을 붙잡고……!?",72,LEFT%┃
	;타격
	;打撃の衝撃波が返ってくる感じだろうか
	ELSEIF RANGE(CFLAG:ARG:입력행동,100, 199)
		PRINTFORML ┃%"타격의 충격이, 되돌아와서……윽",72,LEFT%┃
	;전술
	;CQCやったら同じ技をやり返されたとか……うん、これは分からなくもない……
	ELSEIF RANGE(CFLAG:ARG:입력행동,100, 199)
		PRINTFORML ┃%"동일한 기술을……!? ",72,LEFT%┃
	;화염
	;これ以下の、まあ属性っぽいスキルは分かりやすいよね、わりと
	;コンパチ。
	ELSEIF RANGE(CFLAG:ARG:입력행동,701, 799)
		PRINTFORML ┃%"목표는, 화염을 튕겨내는 것 같습니다……",72,LEFT%┃
	;빙결
	ELSEIF RANGE(CFLAG:ARG:입력행동,801, 899)
		PRINTFORML ┃%"목표는, 냉기를 튕겨내는 것 같습니다……",72,LEFT%┃
	;전격
	;絶縁体は抵抗が非常に大きいだけで、電圧を上げれば電流が流れる
	;雷のゴロピシャーンは空気と言う絶縁体にとんでもねー電圧がかかり通電破壊が起き、それゆえの衝撃波の音。
	;電撃、とか属性名そのまま、例えば稲妻や雷と言わないってのが一応のこだわり
	;やっぱりこっちでもなんか困る
	ELSEIF RANGE(CFLAG:ARG:입력행동,901, 999)
		PRINTFORML ┃%"목표는 전격을 튕겨내는 것 같습니다……",72,LEFT%┃
	;충격
	;こっちでも困る。衝撃、衝撃、衝撃なー……
	ELSEIF RANGE(CFLAG:ARG:입력행동,1001, 1099)
		PRINTFORML ┃%"목표는, 충격을 튕겨내는 것 같습니다……",72,LEFT%┃
	;신경
	;字義どおりに言葉を受け取る造魔ちゃん
	;跳ね返されても無意味なので無効と一緒
	ELSEIF RANGE(CFLAG:ARG:입력행동,1101, 1199)
		PRINTFORML ┃%"목표는 무신경한 것 같습니다……",72,LEFT%┃
	;정신
	ELSEIF RANGE(CFLAG:ARG:입력행동,1201, 1299)
		;ちょっともったいないのでって言うかなんて言うか
		IF RAND:10 == 0
			PRINTFORML ┃%"목표는 매우 배짱이 두둑한 것 같습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"목표는 정신 공격에 내성을 지니고 있는 것 같습니다……",72,LEFT%┃
		ENDIF
	;파마
	;※性的な意味で
	ELSEIF RANGE(CFLAG:ARG:입력행동,1301, 1399)
		PRINTFORML ┃%"목표를 승천시킬 수 없습니다……",72,LEFT%┃	
	;주살
	ELSEIF RANGE(CFLAG:ARG:입력행동,1401, 1499)
		IF RAND:10 == 0
			PRINTFORML ┃%"목표는 이곳이 지옥이라고 생각하는 것 같습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"목표를 살해할 수 없습니다……",72,LEFT%┃
		ENDIF
	;지변
	ELSEIF RANGE(CFLAG:ARG:입력행동,1501, 1599)
		PRINTFORML ┃%"목표는 대지에 얽매이지 않는 것 같습니다……",72,LEFT%┃
	;수격
	ELSEIF RANGE(CFLAG:ARG:입력행동,1601, 1699)
		PRINTFORML ┃%"목표는 수격을 튕겨내는 것 같습니다……",72,LEFT%┃
	;질풍
	ELSEIF RANGE(CFLAG:ARG:입력행동,1701, 1799)
		PRINTFORML ┃%"이 속성으로는, 목표를 배제할 수 없습니다……",72,LEFT%┃
	;중력
	ELSEIF RANGE(CFLAG:ARG:입력행동,1801, 1899)
		PRINTFORML ┃%"이 속성으로는, 목표를 배제할 수 없습니다……",72,LEFT%┃
	;핵열
	;ゴッズィーラとか誕生しそうで怖いんだよなあコレ吸収って
	ELSEIF RANGE(CFLAG:ARG:입력행동,1901, 1999)
		PRINTFORML ┃%"이 속성으로는, 목표를 배제할 수 없습니다……",72,LEFT%┃
	;만능
	;流石に反射は……まあ入れておこう
	ELSEIF RANGE(CFLAG:ARG:입력행동,2001, 2099)
		PRINTFORML ┃%"!? 있을 수 없습니다……!",72,LEFT%┃
	;その他
	ELSE
		PRINTFORML ┃%"공격이 무효화되었습니다…… 대책을……",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF


;-------------------------------------------------
;○反射した
;戦闘口上フラグ（CFLAG:807）が５のとき限定、かつ4分の1
;まあ造魔ちゃんの場合、マカラカーンとかでしか反射できないはずだが
;-------------------------------------------------
IF TFLAG:전투이벤트 == 16 && CFLAG:807 >= 5 && RAND:4 == 0
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	IF RAND:4 == 0
		PRINTFORML ┃%"반사에 성공했습니다……",72,LEFT%┃
	ELSEIF RAND:3 == 0
		PRINTFORML ┃%"무의미한 공격입니다……",72,LEFT%┃
	ELSEIF RAND:2 == 0
		PRINTFORML ┃%"방어 패턴의 최적화를 진행합니다……",72,LEFT%┃
	ELSE
		PRINTFORML ┃%"손해 없습니다……",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○外した
;戦闘口上フラグ（CFLAG:807）が５のとき限定、かつ4分の1
;通常、こちらのレベルが低ければ当然多く、相手のレベルが高ければ当然多く、しかし造魔はレベルと戦力が（あんまり）比例しないので……
;いやあ、なんか上手い方法ないですかね
;-------------------------------------------------
IF TFLAG:전투이벤트 == 17 && CFLAG:807 >= 5 && RAND:4 == 0
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
;	IF あきらかに外しにくい場合
;		PRINTFORML ┃%"必中を期した攻撃だったのですが……",72,LEFT%┃
	IF RAND:4 == 0
		PRINTFORML ┃%"회피당했습니다……",72,LEFT%┃
	ELSEIF RAND:3 == 0
		PRINTFORML ┃%"공격에 실패했습니다……",72,LEFT%┃
	ELSEIF RAND:2 == 0
		PRINTFORML ┃%"적성 목표의 회피 패턴 분석을 진행합니다……",72,LEFT%┃
	ELSE
		PRINTFORML ┃%"……재공격을 진언합니다……",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○회피
;戦闘口上フラグ（CFLAG:807）が５のとき限定、かつ4分の1……ただし現状出ません
;通常、こちらのレベルが低ければ当然多く、相手のレベルが高ければ当然多く、しかし造魔はレベルと戦力が（あんまり）比例しないので……
;こっちもなんか上手い方法ないですかねえ……ステータスを直接参照するとか？ フラットステータスレベル50相当くらい以上で回避すると……とか
;テスト中に、『多段攻撃を一度でも回避しているとこれが出る』ことが発覚。だめだー、ということで、これは出ないようにしています。
;（出したいなら「 && TFLAG:전투이벤트 == 17」を削ってコメントアウト文と同じにする）
;-------------------------------------------------
;IF CFLAG:807 >= 5 && TFLAG:전투이벤트 == 18 && RAND:4 == 0
IF TFLAG:전투이벤트 == 18 && CFLAG:807 >= 5 && RAND:4 == 0 && TFLAG:전투이벤트 == 17
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	IF RAND:4 == 0
		PRINTFORML ┃%"회피에 성공했습니다……",72,LEFT%┃
	ELSEIF RAND:3 == 0
		PRINTFORML ┃%"무의미한 공격입니다……",72,LEFT%┃
	ELSEIF RAND:2 == 0
		PRINTFORML ┃%"회피 패턴의 최적화를 진행합니다……",72,LEFT%┃
	ELSE
		PRINTFORML ┃%"손해 없습니다……",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○반격
;戦闘口上フラグ（CFLAG:807）が５のとき限定、かつ4分の1
;★チェック　出るかチェックしようね
;-------------------------------------------------
IF TFLAG:전투이벤트 == 20 && CFLAG:807 >= 5 && RAND:4 == 0
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	IF 0
	
	;2481,반격
	;2482,맹반격
	;2483,데스카운터
	;　＞物理攻撃に50％で反撃、威力100、その他相性などは通常攻撃に依存
	;　＞物理攻撃に50％で反撃、威力200、その他相性などは通常攻撃に依存
	;　＞物理攻撃に50％で反撃、威力300、その他相性などは通常攻撃に依存
	;　ちなみにこの物理攻撃は、例えば「火炎相性の物理攻撃」でもいい。
	ELSEIF TFLAG:발동연동스킬 == 2481 || TFLAG:발동연동스킬 == 2482 || TFLAG:발동연동스킬 == 2483
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"빈틈을 발견, 반격하겠습니다……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"발을 들여놓으셨다면……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"카운터를 행하겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"물리에는 물리로 보답하겠습니다……",72,LEFT%┃
		ENDIF
	;닷지카운터
	;　＞攻撃を回避すると50％で反撃、威力300、その他相性などは通常攻撃に依存
	;　攻撃を回避さえしていればOK。
	ELSEIF TFLAG:발동연동스킬 == 2484
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"동귀어진은 되지 않습니다……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"나비처럼 날아서……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"좋은 위치에 턱으로 보이는 부위가 보입니다……",72,LEFT%┃
		ENDIF
	;2960,베어내는전신의검
	;　＞万能、威力500、単体、物、消費40　カウンター　CT30　반격
	;　起動することで、3ターンの間、物理攻撃に反応するカウンター攻撃が発生する。
	;　詳しくは起動時の方で。
	ELSEIF TFLAG:발동연동스킬 == 2960
		IF 0
		;「じゃん、けん、死ねぇ！」……の前振りが出てた場合
		ELSEIF CFLAG:고유게이지H2 >= 1
			IF 0
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"가위, 바위―― 주것더냐……!",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"가위, 바위, ――지금부터 네놈 데드 엔드……!!!",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"당신이 나중에 냈으므로 당신의 패배입니다……!!",72,LEFT%┃
			ENDIF
			;１回出たら次は出ません
			CFLAG:고유게이지H2 = 0
		;フラガッハ。「フラガラック」「フラガラッハ」など表記ゆれ（というか、古いものなので、正確、またはもっとも人口に膾炙した読み方が分からない）があるが。
		;フラガッハ、という読みは、たぶんなかった。
		;『千年戦争アイギス』でこんなオモシロ脱字があったのだ。
		;そのキャラはサービス開始時からいていまだに人気投票上位入ってくるキャラなんですわ。
		ELSEIF RAND:100 == 0
			PRINTFORML ┃%"인게이지, 프라가라흐……!",72,LEFT%┃
		ELSEIF RAND:9 == 0
			PRINTFORML ┃%"프라가――라흐……!",72,LEFT%┃
		;応答と言ったらPingなのだ
		ELSEIF RAND:8 == 0
			PRINTFORML ┃%"Ping――Pong！",72,LEFT%┃
		ELSEIF RAND:7 == 0
			PRINTFORML ┃%"인게이지, 프라가라흐……!",72,LEFT%┃
		ELSEIF RAND:6 == 0
			PRINTFORML ┃%"데들리 졸트, 앤서러……!",72,LEFT%┃
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"답을 보여라, 앤서러……!",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"베어 도려내라, 전신의 검――!",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"먼저 나아가라, 응보검……!",72,LEFT%┃
		;正当な名称なのでちょっとだけ多めに出るように（RAND2のぶん含みで）
		ELSE
			PRINTFORML ┃%"　ﾌ　ﾗ　ｶﾞ ﾗ　ｯ　ｸ　　　　",72,LEFT%┃
			PRINTFORML ┃%"“베어내는전신의검”……！",72,LEFT%┃
		ENDIF
	ELSE
		IF RAND:2 == 0
			PRINTFORML ┃%"반격하겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"반격하겠습니다……",72,LEFT%┃
		ENDIF
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○トリガースキル発動
;　一部のモード変更スキルとかがここ。
;　ただ、出したいのは出せちゃってる気がする。
;-------------------------------------------------
IF TFLAG:전투이벤트 == 21 && CFLAG:807 >= 5 && RAND:4 == 0
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	IF 0
	;5040,リソース解放
	;　＞自動　20％の確率で、消費MPの100％が返ってくる
	;　たぶん造魔ちゃんには使えない気がするがそんなのはどうでもいいのだ。
	;★チェック　出る？
	ELSEIF TFLAG:발동연동스킬 == 5040
		IF RAND:2 == 0
			PRINTFORML ┃%"리로드: Resource Recovery……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"리소스, 리로딩……",72,LEFT%┃
		ENDIF
	;5041,再起処理
	;　＞自動　10％の確率で、行動をもう一度繰り返す
	;　当然強いがダメージ効率とか見るとどうかな。不安定でもあるねえ。
	;★チェック　出る？
	ELSEIF TFLAG:발동연동스킬 == 5041
		IF RAND:2 == 0
			PRINTFORML ┃%"루프: Recursive Processing……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"For、NEXT……",72,LEFT%┃
		ENDIF


	ELSE
		IF RAND:2 == 0
			PRINTFORML ┃%"몰아치겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"추격하겠습니다……",72,LEFT%┃
		ENDIF
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

ENDIF

;-------------------------------------------------
;○バステを受けた
;戦闘口上フラグ（CFLAG:807）が５のとき限定、かつ4分の1
;あんまりセレクトケース好きじゃないんだけどコレはさすがに
;造魔ちゃんは基本だいたい弾くが、精神ガーキルとかあるからな
;-------------------------------------------------
IF TFLAG:전투이벤트 == 22 && CFLAG:807 >= 5 && RAND:4 == 0
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
		CASE "HAPPY"
			IF 0
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"HAPPY 부여, 를, 윽……!",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"이, 이런, 다행감 따위……윽",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"윽, 안 됩니다―― 이, 다행감――",72,LEFT%┃
			ENDIF
		CASE "SHOCK"
			IF 0
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"전, 격, 이……!?",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"크악, 아윽",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"으윽, 윽",72,LEFT%┃
			ENDIF
		CASE "FREEZE"
			IF 0
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"체, 온, 저하, 가――……",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"앗――……",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"몸, 이…… 얼, 어, 붙어……",72,LEFT%┃
			ENDIF
		CASE "BIND"
			PRINTFORML ┃%"크, 윽, 움직일 수 없어……!?",72,LEFT%┃
		CASE "PALYZE"
			PRINTFORML ┃%"모――옴, 이, 저려……와서……",72,LEFT%┃
		CASE "PANIC"
			;ちょっとぽんこつちゃんふうみ
			PRINTFORML ┃%"응? 아우? 마슈? 타?",72,LEFT%┃
		CASE "SLEEP"
			PRINTFORML ┃%"안 돼, 요―― 졸음―― 억누를 수, 없……어……",72,LEFT%┃
		CASE "CLOSE"
			;口が閉ざされた
			PRINTFORML ┃%"함냐. ……으으으으으으, 으으윽……!",72,LEFT%┃
		CASE "POISON"
			PRINTFORML ┃%"윽…… 이, 독은…… " + CSTR:일인칭 + "의 내성을……!?",72,LEFT%┃
		CASE "BOMB"
			PRINTFORML ┃%"윽, 신체 이상 변조를 확인……!?",72,LEFT%┃
		CASE "CHARM"
			;恋慕、親愛
			IF TALENT:3 || TALENT:6
				PRINTFORML ┃%"이런―― 이런 건―― 있을 수 없습니다, ",72,LEFT%┃
				PRINTFORML ┃%CSTR:일인칭 + "이, " + CSTR:이인칭 + " 이외를……윽",72,LEFT%┃
			;淫乱、娼婦
			ELSEIF TALENT:4 || TALENT:7
				PRINTFORML ┃%"……안 됩니다…… 매력적으로, 느껴져 버립니다……",72,LEFT%┃
			;服従、隷属
			ELSEIF TALENT:5 || TALENT:8
				PRINTFORML ┃%CSTR:이인칭 + ", 아, 아닙니다, 이상해, 어째서, 이런 게……!?",72,LEFT%┃
			;未陥落
			ELSE
				PRINTFORML ┃%"정신 공격을 확인…… 이상 변조, 멈출 수 없습니다……",72,LEFT%┃
			ENDIF
		CASE "CURSE"
			PRINTFORML ┃%"주독 방벽, 파손……윽",72,LEFT%┃
		CASE "FLY"
			PRINTFORML ┃%"윽, 파리화의 저주가……",72,LEFT%┃
		CASE "STONE"
			PRINTFORML ┃%"석화 침식, 멈출 수 없습니다……윽",72,LEFT%┃
		CASE "FLAME"
			PRINTFORML ┃%"현재, 염상 중입니다……",72,LEFT%┃
		CASE "SLIP"
			;スリップと言ったら消耗なのがFFer。
;			PRINTFORML ┃%"消耗の呪いに類する効果に、侵食されています……",72,LEFT%┃
			PRINTFORML ┃%"큭…… 자세를 가다듬겠습니다……",72,LEFT%┃
		CASE "BRAND"
			IF RAND:2
				PRINTFORML ┃%"이 몸은 " + CSTR:이인칭 + "의 것이라, 하거늘……윽",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"이러한…… 추잡한 각인을, 이 몸에, 잘도……윽",72,LEFT%┃
			ENDIF
		;その他の状態異常
		CASEELSE
			PRINTFORML ┃%"윽, 이상 변조를 확인……윽",72,LEFT%┃
	ENDSELECT
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○食いしばり等で耐えた
;-------------------------------------------------
;IF TFLAG:전투이벤트 == 23
;	;이악물기
;	IF BASE:ARG:ＨＰ == 1
;	;その他
;	ELSE
;	ENDIF
;ENDIF

;-------------------------------------------------
;○回復してもらった
;-------------------------------------------------
IF TFLAG:전투이벤트 == 24 && CFLAG:807 >= 5 && RAND:4 == 0
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	;ARG:2　回復量
	LOCAL = ARG:2 * 100 / BASE:ARG:ＨＰ
	;LOCAL　回復量割合
	IF 0
	;キャラ分岐
	;ELSEIF NO:(ARG:1) == XXXX
	;50%以上 & HPほぼ満タン
	ELSEIF LOCAL > 50 && 現HP割合(ARG) > 90
		PRINTFORML ┃%"치료에 감사를…… 내구력, 만전인 상태입니다……",72,LEFT%┃
	;50%以上
	ELSEIF LOCAL > 50
		PRINTFORML ┃%"치료에 감사를……",72,LEFT%┃
	;その他
	ELSE
		PRINTFORML ┃%"치료에 감사를……",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF


;-------------------------------------------------
;○状態異常を直してもらった
;-------------------------------------------------
IF TFLAG:전투이벤트 == 25 && CFLAG:807 >= 5 && RAND:4 == 0
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	;ARG:2　直ったバステ
	IF 0
	;キャラ分岐
	;ELSEIF NO:(ARG:1) == XXXX
	ELSE
		SELECTCASE GET_STATE(ARG:2)
			CASE "CHARM"
				IF 0
				;恋慕系
				ELSEIF 陥落() && RESULTS == "연모"
					PRINTFORML ┃%"치료에 감사를. ……잘도……",72,LEFT%┃
				;淫乱系
				ELSEIF 陥落() && RESULTS == "음란"
					PRINTFORML ┃%"……자세히 보니, 전혀 매력적이지 않습니다……",72,LEFT%┃
				;服従系
				ELSEIF 陥落() && RESULTS == "복종"
					PRINTFORML ┃%"치료에 감사를. ……잘도, 저의 충성을…… 농락하고……윽",72,LEFT%┃
				;信頼系
				ELSEIF 陥落() && RESULTS == "신뢰"
					PRINTFORML ┃%"치료에 감사를…… 그런 것은, 마음의 혼란일 뿐입니다……",72,LEFT%┃
				;未陥落でも使えるっぽい。
				ELSE
					PRINTFORML ┃%"치료에 감사를……",72,LEFT%┃
				ENDIF
			CASE "SLEEP"
				PRINTFORML ┃%"응, 아―― 안녕하십니까, 상황을 파악하겠습니다……",72,LEFT%┃
			;その他の状態異常
			CASEELSE
				IF 0
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"컨디션을 회복했습니다. 감사를……",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"치료에 감사를……",72,LEFT%┃
				ENDIF
		ENDSELECT
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○戦闘中イって行動不能にならず耐えた(ムフフ展開時のみ)
;歯を食いしばって快楽に耐えた
;-------------------------------------------------
IF TFLAG:전투이벤트 == 47 && CFLAG:807 >= 5 && RAND:2 == 0
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		PRINTFORML ┃%"응읏, 흐, 으응, 으으으……윽",72,LEFT%┃
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		PRINTFORML ┃%"……욕구불만을 양분으로 삼겠습니다……",72,LEFT%┃
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORML ┃%"……안 됩니다…… 노예가 제멋대로 절정을 맞이하다니……윽",72,LEFT%┃
	;未陥落でも使えるっぽい。
	ELSE
		PRINTFORML ┃%"……욕구의 고조를 감지하고 있습니다……",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○行動中イって行動不能になった(ムフフ展開時のみ 50%の確率でHAPPYに)
;絶頂の余韻に浸っている
;-------------------------------------------------
IF TFLAG:전투이벤트 == 48 && CFLAG:807 >= 5 && RAND:2 == 0
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		PRINTFORML ┃%"우, 우으윽, 절정, 이이잇……!",72,LEFT%┃
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		PRINTFORML ┃%"……응흣, 하아아……윽",72,LEFT%┃
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORML ┃%"……앗, 아…… 가, 앗……!",72,LEFT%┃
	;未陥落でも使えるっぽい。
	ELSE
		PRINTFORML ┃%"……윽, 아, 아아앗……",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○ターン終了時状態異常が自然回復した
;-------------------------------------------------
IF TFLAG:전투이벤트 == 50 && CFLAG:807 >= 5 && RAND:4 == 0
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
		CASE "CHARM"
			;恋慕、親愛
			IF TALENT:3 || TALENT:6
				PRINTFORML ┃%"전선에 복귀합니다………… 잘도……",72,LEFT%┃
			;淫乱、娼婦
			ELSEIF TALENT:4 || TALENT:7
				PRINTFORML ┃%"……자세히 보니, 전혀 매력적이지 않습니다……",72,LEFT%┃
			;服従、隷属
			ELSEIF TALENT:5 || TALENT:8
				PRINTFORML ┃%"전선에 복귀합니다…… 잘도, 저의 충성을…… 농락하고……윽",72,LEFT%┃
			;未陥落
			ELSE
				PRINTFORML ┃%"전선에 복귀합니다……",72,LEFT%┃
			ENDIF
		CASE "SLEEP"
			PRINTFORML ┃%"응, 아―― 안녕하십니까, 상황을 파악하겠습니다……",72,LEFT%┃
		;その他の状態異常
		CASEELSE
			PRINTFORML ┃%"전선에 복귀합니다……",72,LEFT%┃
	ENDSELECT

	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○ターン終了時今の状態による口上
;-------------------------------------------------
IF TFLAG:전투이벤트 == 51 && CFLAG:807 >= 5 && RAND:4 == 0
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	IF 0
	;ELSEIF FLAG:무후후전개 && (BATTLE_H_EVENT_PRO(ARG) > 30 || CFLAG:ARG:던전내발정용욕정치 > 5000) && !RAND:2
	;	;BATTLE_H_EVENT_PRO(ARG)　行動中にイく確率
	;	SETCOLOR COLOR("pink")
	;	IF　　 BATTLE_H_EVENT_PRO(ARG) > 80
	;	ELSEIF BATTLE_H_EVENT_PRO(ARG) > 50
	;	ELSEIF BATTLE_H_EVENT_PRO(ARG) > 30
	;	ELSEIF CFLAG:ARG:던전내발정용욕정치 > 10000
	;	ELSEIF CFLAG:ARG:던전내발정용욕정치 > 5000
	;状態異常時
	ELSEIF GET_STATE(CFLAG:ARG:상태이상) == "SLEEP"
		PRINTFORML ┃%"응으…… " + CSTR:이인칭 + "……",72,LEFT%┃
	ELSEIF GET_STATE(CFLAG:ARG:상태이상) == "PANIC"
		;ちょっとぽんこつちゃんふうみ
		PRINTFORML ┃%"후야-? 둥실둥실. 에헤헤……",72,LEFT%┃
	;その他の状態異常
	;ELSEIF CFLAG:ARG:상태이상 > 0
	;HP50%以下
	ELSEIF 現HP割合(ARG) < 50
		PRINTFORML ┃%"회복의 필요성이 높아지고 있습니다……",72,LEFT%┃
	;HP10%以下
	ELSEIF 現HP割合(ARG) < 10
		PRINTFORML ┃%"아우…… 하아…… 하, 윽, 내구도, 손모, 심각……윽……",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF


;-------------------------------------------------
;○オルギア→ヒート
;機械の乙女造魔ちゃんも素敵だとは思うが現状通常で入る手段がない
;まあ現状習得させられないようなスキル口上も書いてるけどな！
;-------------------------------------------------
;IF TFLAG:전투이벤트 == 52
;ENDIF


;-------------------------------------------------
;○ターン終了時エクスリンケージ装備時のイベント口上(ムフフ展開時のみ)
;-------------------------------------------------
;IF TFLAG:전투이벤트 == 53 && CFLAG:807 >= 5 && RAND:4 == 0
;	;発情によってHAPPYになった
;	IF CFLAG:ARG:던전내발정 == 1 && GET_STATE(CFLAG:ARG:상태이상) == "HAPPY"
;	;頭の中がピンクに染まった
;	ELSEIF CFLAG:ARG:던전내발정 == 1
;	;落ち着いた
;	ELSEIF CFLAG:ARG:던전내발정 == 0
;	ENDIF
;ENDIF

;-------------------------------------------------
;○ターン終了時エクスリンケージ装備時のイベント口上(ムフフ展開時のみ)
;-------------------------------------------------
IF TFLAG:전투이벤트 == 54 && CFLAG:807 >= 5 && RAND:4 == 0
	;中に注がれた精液が垂れてきた……
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃%"……잔뜩, 내보내시니까……",72,LEFT%┃
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○バトルに勝利した
;-------------------------------------------------
IF TFLAG:전투이벤트 == 90 && CFLAG:807 >= 5
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓

	;いい感じに「陥落していたらパターンが増える」「増えた場合でもそれぞれの率は均等」というのを考えたいんだが。
	;変数に突っ込むのが楽ではあるかなー……
	;DATA形式だと１行しか書けなかったはずだし。
	;まあめんどいので陥落側をちょっと確率下げて分けることにする。
	IF 0
	ELSEIF 陥落() && RAND:3 == 0
		IF 0
		;『ゼノサーガ』より、KOS-MOSの戦闘終了時のセリフ、「ルックス５％低下」が元ネタです。
		;何気にEP１～３のすべてで登場している。
		ELSEIF RAND:6 == 0
			PRINTFORML ┃%"전투 종료…… 외모 체크를 행하겠습니다……",72,LEFT%┃
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%CSTR:이인칭 + ", 다치신 곳은, 없으신가요……?",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"……칭찬의 말씀을…… 들을 수 있을까요……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"……브이.",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"……해냈습니다……(흥스)",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"전투 기록 보존 완료………… 영구 보존판입니다……",72,LEFT%┃
		ENDIF
	ELSE
		IF 0
		ELSEIF RAND:11 == 0
			PRINTFORML ┃%"상황 종료…… 경계 태세에 돌입합니다……",72,LEFT%┃
		ELSEIF RAND:10 == 0
			PRINTFORML ┃%"장애를 배제했습니다……",72,LEFT%┃
		ELSEIF RAND:9 == 0
			PRINTFORML ┃%"전투에서 승리했습니다……",72,LEFT%┃
		ELSEIF RAND:8 == 0
			PRINTFORML ┃%"＊＊＊승리＊＊＊",72,LEFT%┃
			PRINTFORML ┃%"……했습니다.",72,LEFT%┃
		ELSEIF RAND:7 == 0
			PRINTFORML ┃%"전투 기록 보존 완료…… 후학에 힘쓰겠습니다……",72,LEFT%┃
		;胸元広げてぱさぱさする
		ELSEIF RAND:6 == 0
			PRINTFORML ┃%"전투 종료…… 방열하겠습니다…… 후우-……",72,LEFT%┃
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"전투 종료…… " + CSTR:이인칭 + ", 지시를……",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"전투 종료…… " + CSTR:이인칭 + ", 다치신 곳은…… 없으신가요……?",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"전투 종료…… 문제없는 상대였다고 생각합니다……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"전투 종료…… 주변 경계에 힘쓰겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"전투에서 승리했습니다……",72,LEFT%┃
		ENDIF
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF


;-------------------------------------------------
;○レベルアップした
;造魔ちゃんにはありえない
;造魔レベルアップでも工場は呼ばれないはず
;なお、「造魔レベルアップ」は、下記の計算式で算出されるMAGが必要。
;＞MAX(1, 2 * (BASE:ARG:LV - 1) * BASE:ARG:LV * (BASE:ARG:LV + 1))
;……「2*(Lv-1)*Lv*(Lv+1)」、整理すると「2(Lv^3-Lv)」……だよな？中学レベルの数学に最近自信がない。
;ともあれ、乗算が入ってくるので、Lvが上がるほどにキツくなるのだが、最大MAGはそれ以上の勢いで伸びていくので、理論上造魔ちゃんにLvの上限はない。
;-------------------------------------------------
;IF TFLAG:전투이벤트 == 91
;ENDIF

;-------------------------------------------------
;○逃走成功
;-------------------------------------------------
IF TFLAG:전투이벤트 == 92 && CFLAG:807 >= 5
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	IF 0
	ELSEIF RAND:4 == 0
		PRINTFORML ┃%"방향 전환 성공…… 진행 방향의 경계를 행하겠습니다……",72,LEFT%┃
	ELSEIF RAND:3 == 0
		PRINTFORML ┃%"이탈 완료…… 추격을 경계합니다……",72,LEFT%┃
	ELSEIF RAND:2 == 0
		PRINTFORML ┃%"철수 완료…… 경계를 속행합니다……",72,LEFT%┃
	ELSE
		PRINTFORML ┃%"도주에 성공했습니다……",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○逃走失敗
;-------------------------------------------------
IF TFLAG:전투이벤트 == 93 && CFLAG:807 >= 5
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	IF 0
	ELSEIF RAND:4 == 0
		PRINTFORML ┃%"도주 실패…… 전투 상황, 계속됩니다……",72,LEFT%┃
	ELSEIF RAND:3 == 0
		PRINTFORML ┃%"윽, 도주 실패…… 퇴각 루트를 재구축합니다……!",72,LEFT%┃
	ELSEIF RAND:2 == 0
		PRINTFORML ┃%"철수전을 속행합니다……!",72,LEFT%┃
	ELSE
		PRINTFORML ┃%"도주에 실패……윽",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○戦闘開始時
;-------------------------------------------------
IF TFLAG:전투이벤트 == 94 && CFLAG:807 >= 5
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	IF 現HP割合(ARG) < 25
		;瀕死
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"……피해 확대가 예상됩니다……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"적성 세력, 감지……윽",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"전투 중, 혹은 전투 종료 후 치료를 권장합니다……",72,LEFT%┃
		ENDIF
	ELSE
		IF 0
			;まあ10パターンくらいはね
		ELSEIF RAND:12 == 0 && (((SOFT_ON("ハネムーン")) * 陥落(ARG)) || ((SOFT_ON("ディボース")) * MARK:ARG:반발각인))
			;ハネムーンとディボースが同時にON、かつ造魔ちゃん効果発揮
			;掛け算で条件見てるので、発動してなきゃどっかがゼロになるので、「＞0」で全部見れる
			IF ((SOFT_ON("ハネムーン")) * 陥落(ARG)) && ((SOFT_ON("ディボース")) * MARK:ARG:반발각인)
				PRINTFORML ┃%"허니문, 디보스, 온……",72,LEFT%┃
				PRINTFORML ┃%"모순사고 루프…… 애증이 얽혀, 나선이 되어라……",72,LEFT%┃
			ELSEIF ((SOFT_ON("ハネムーン")) * 陥落(ARG)) >= 1
				PRINTFORML ┃%"허니문, 온……",72,LEFT%┃
				PRINTFORML ┃%"……이 충성을 검으로 삼겠습니다……",72,LEFT%┃
			ELSEIF ((SOFT_ON("ディボース")) * MARK:ARG:반발각인) >= 1
				PRINTFORML ┃%"디보스, 온…………",72,LEFT%┃
				PRINTFORML ┃%"……화풀이를 하겠습니다……",72,LEFT%┃
			ENDIF
		ELSEIF RAND:11 == 0
			PRINTFORML ┃%"인게이지, 오픈 컴뱃……",72,LEFT%┃
		ELSEIF RAND:10 == 0
			PRINTFORML ┃%"투쟁을 개시합니다……",72,LEFT%┃
		ELSEIF RAND:9 == 0
			PRINTFORML ┃%"도주 경로 분석…… O.K. 퇴로는 신경 쓰지 마시기를……",72,LEFT%┃
		ELSEIF RAND:8 == 0
			PRINTFORML ┃%"섬멸을 개시합니다……",72,LEFT%┃
		ELSEIF RAND:7 == 0
			PRINTFORML ┃%"피아 전력 분석…… O.K. 전투, 개시합니다",72,LEFT%┃
		ELSEIF RAND:6 == 0
			PRINTFORML ┃%"전투 개시…… 갑니다",72,LEFT%┃
		ELSEIF RAND:5 == 0
			PRINTFORML ┃%"敵戦力確認……O.K.　分析、戦術構築開始……",72,LEFT%┃
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"敵手確認……戦闘開始……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"전력 전개…… 공격합니다",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"전투를 개시합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"敵性勢力、感知……",72,LEFT%┃
		ENDIF
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○バックアタックを受けた
;ﾋｬｸﾀｰﾛのおかげでサッパリ見ない
;-------------------------------------------------
IF TFLAG:전투이벤트 == 95 && CFLAG:807 >= 5
	PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
	IF 現HP割合(ARG) < 25
		;瀕死
		PRINTFORML ┃%"윽…… 감지 실패…… 면목 없습니다……윽",72,LEFT%┃
