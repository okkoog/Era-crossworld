	;　まあ威力もソコソコなので、それなりのものなのかもしれない。まあ人間はそれなりのもので死ぬが……
	ELSEIF CFLAG:ARG:입력행동 == 719 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┃%"파이로 템페스트, 발동합니다……",72,LEFT%┃
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Pyroclastic Tempest……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"몰아쳐라, 부수는 불꽃……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"불꽃과 타서 무너진 바위로…… 그 몸도 부수겠습니다……",72,LEFT%┃
		ENDIF
