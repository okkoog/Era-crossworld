		PRINTFORML ┃%"후방에서 적 세력을 확인……!",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

