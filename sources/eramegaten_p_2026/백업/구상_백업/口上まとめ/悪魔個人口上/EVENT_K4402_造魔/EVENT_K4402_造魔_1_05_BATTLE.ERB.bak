;	;　1937_熱核の乱舞とほぼ同じ。
;	ELSEIF CFLAG:ARG:입력행동 == 2828 && CFLAG:807 >= 3
;		IF 0
;		;直訳ゥ――！！！
;		ELSEIF RAND:4 == 0
;			PRINTFORML ┃%"스킬 코드: Thermonuclear Dance……",72,LEFT%┃
;		ELSEIF RAND:3 == 0
;			PRINTFORML ┃%"원자째로 녹아 무너지는 편이 좋을 듯합니다만……",72,LEFT%┃
;		ELSEIF RAND:2 == 0
;			PRINTFORML ┃%"열핵 에너지 충전…… 분화, 사출……",72,LEFT%┃
;		ELSE
