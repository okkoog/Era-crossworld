	;　このあたりは喰人専用、流石にカット
	;0037,암야검
	;　＞剣撃、威力120、列、物、消費10　神経魔封40-80
	;　CLOSE追加。性能そのものはウーン、まあでもそこそこ安い列攻撃ではある……っていうか、CLOSE付与攻撃のなかだと結構率が高いような……。
	ELSEIF CFLAG:ARG:입력행동 == 37 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"스킬 코드: Dark Sword……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"암살하고 오겠습니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"……殺……",72,LEFT%┃
		ENDIF
	;0038,무사차
	;　＞剣撃、威力420、列、物、消費10
	;　命中が低いが（55）威力は420と高めでコストが安い
	;　んまあ、これ使うならテンキョー使うかなあ……列だけども……
	;　コスト三倍（30）だけど、命中ちょっと高くて、威力が＋200されてるし……
	;　これ実在の剣術だったと思うが、出てこない。ウーン。
	ELSEIF CFLAG:ARG:입력행동 == 38 && CFLAG:807 >= 3
		IF 0
		;Harma Mow、の意味はちょっと分かんない。
		;Harmaを刈り取る……ということのようだが。ウーン。
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Harma Mow……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"무사 수레로, 덤벼들겠습니다……!",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"위세 부리며 덮치는 무사 수레……",72,LEFT%┃
		ENDIF
	;0039,러브・하트
