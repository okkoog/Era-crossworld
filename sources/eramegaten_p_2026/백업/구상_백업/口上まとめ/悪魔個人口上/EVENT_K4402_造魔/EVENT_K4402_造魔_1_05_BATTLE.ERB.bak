	;　「デカジャ＋デクンダ」ではない
	;　……まあイニシャライズの下位互換ですわね。
	ELSEIF CFLAG:ARG:입력행동 == 545
		IF 0
		ELSEIF RAND:3 == 0
			PRINTFORML ┃%"데몬스트레이트: Silent Prayer……",72,LEFT%┃
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"정적을, " + CSTR:이인칭 + "께서 바라고 계십니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"정적을, " + CSTR:이인칭 + "께서 바라고 계십니다……",72,LEFT%┃
		ENDIF
