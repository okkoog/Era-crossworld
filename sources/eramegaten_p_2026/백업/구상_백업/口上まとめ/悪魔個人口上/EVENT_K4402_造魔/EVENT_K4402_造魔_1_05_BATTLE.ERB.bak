					PRINTFORML ┃%"떨려라, 영혼…… 불타오를 정도로, 뜨겁게……",72,LEFT%┃
;					PRINTFORML ┃%"こぉおおおおおおおお……",72,LEFT%┃
					PRINTFORML ┃%"……새깁니다, 생명의 율동!",72,LEFT%┃
				;銀河強装弾拳とか叫ばせるのは流石に自重
				ELSEIF RAND:99 == 0
					PRINTFORML ┃%"……이 주먹은, 분노를 품고…… 은하조차, 분쇄합니다……!",72,LEFT%┃
				;サガシリーズでよく見るけど「ファイナルストライク」って絶対に格好いい。ホント好き
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"페이탈 스트라이크, 레디……!",72,LEFT%┃
				;元ネタは某スレの不動剣。怒りの鉄拳じゃなくなってるぞオイ。
				;造魔ちゃんがボッコボコにしてやんよ！
				ELSE
					PRINTFORML ┃%" ……가루다의 불꽃으로, 삼독을 모조리 집어삼키고,",72,LEFT%┃
					PRINTFORML ┃%"구리가라권으로, 번뇌를 끊어낸다……",72,LEFT%┃
					PRINTFORML ┃%"이름하여── 부동권",72,LEFT%┃
				ENDIF
			;HP5%以下。威力600。
			;まず見られない。回復しろよ。
			;まあ食いしばりを覚えさせておくしかないかもしれんね。
			CASE IS < 5
				PRINTFORML ┃%"……" + CSTR:이인칭 + "을(를) 지키기 위해……",72,LEFT%┃
				PRINTFORML ┃%""분노"를 에뮬레이트하겠습니다……!",72,LEFT%┃
			;HP2割以下。威力450。
			;この辺で既に激レアかと思う。やっとこ曳光倶梨伽羅蹴を越える。
			CASE IS < 20
				PRINTFORML ┃%""분노"가 " + CSTR:일인칭 + "의 몸에 존재한다고 한다면……",72,LEFT%┃
				PRINTFORML ┃%"그것은…… " + CSTR:이인칭 + "을(를) 상처 입히려는 자를 향합니다……!",72,LEFT%┃
			;通常威力300。HP7割以下で350。5割以下で威力400。ここからです。
			CASEELSE
				PRINTFORML ┃%"……" + CSTR:일인칭 + "에게 "분노"는, 이해할 수 없지만……",72,LEFT%┃
		ENDSELECT
