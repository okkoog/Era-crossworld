ELSEIF RANGE(CFLAG:ARG:입력행동,4000, 4999)
	IF 0
	;4000,화염격
	;　＞검격＋火炎、威力150+160、単体、物、消費2+2
	ELSEIF CFLAG:ARG:입력행동 == 4000 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"링케이지：Fire Burst, 실행합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"화염의 일격을 날립니다……",72,LEFT%┃
		ENDIF
	;4001,다크세이버
	;　＞검격＋呪殺、威力150+135、単体、物、消費2+2
	;　ムドあたりを呪殺ダメージに変換できるので、呪殺弱点のボスとかにいいかもしれない。
	ELSEIF CFLAG:ARG:입력행동 == 4001 && CFLAG:807 >= 3
		IF 0
		ELSEIF RAND:2 == 0
			PRINTFORML ┃%"링케이지：Dark Saber, 실행합니다……",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"주살의 일격을 날립니다……",72,LEFT%┃
		ENDIF
