					CSTR:100 = 이걸로 %이인칭과% 하나가 된 거구나。기쁘다…%UNICODE(0x2665)%
					CSTR:101 = 하…앙、으읏…、아플텐데、이상하게도 아프지 않다%UNICODE(0x2665)%
					CFLAG:808 = 600;正常位
					CALL PRINT_AA_ビシャモンテン
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ELSE
					PRINTFORMW 처음으로 남자를 받아들인 %CALLNAME%의 질은 빡빡해서、%CALLNAME:MASTER%의 페니스를 꽉 조였다。
					PRINTFORMW 「이 무슨 꼴이냐…」
					PRINTFORMW 「이딴 놈에게 내 순결이 빼앗기다니…」
					PRINTFORMW %MASTER는% 천천히 허리를 움직여、%CALLNAME%의 질에 페니스를 밀어넣었다。
					PRINTFORMW 「큿…、억지로 움직이지 마라…이 하찮은것…」
				ENDIF
			;그 이외
			ELSE
				;연모, 친애
				IF TALENT:3 || TALENT:6
					CSTR:100 = 읏…、으긋…、%이인칭이% %CSTR:일인칭%의 질내에 있는걸 알 수 있다…
					CFLAG:808 = 600;正常位
					CALL PRINT_AA_ビシャモンテン
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
					PRINTFORMW 
				ELSE
					PRINTFORMW %CALLNAME은% %CALLNAME:MASTER%의 침입을 거부하려는듯 허벅지에 힘을 주고 있다。
					PRINTFORMW 허나、그런 저항은 반대로사정을 부추길 뿐이라는 것을 깨닫지 못한 것 같다……。
					PRINTFORMW 「읏、멋대로 허리나 흔들어대는…이런 짐승！」
				ENDIF
			ENDIF
			CFLAG:332 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:332 < 4 || FLAG:7 == 2)
				;挿入し場合ていない場合
				IF TFLAG:60 == 0 
					;연모, 친애
					IF TALENT:3 || TALENT:6
						CSTR:100 = 읏…、으흐읏…%UNICODE(0x2665)%、머릿속이 하얘져버린다
						CSTR:101 = 후앙…、읏…%UNICODE(0x2665)%、기뻐…%UNICODE(0x2665)%
					;음란, 창부
					ELSEIF TALENT:4 || TALENT:7
						CSTR:100 = 안쪽까지 넣어주세요…♪
						CSTR:101 = 음란무신의 보○…%CSTR:이인칭%의 자○로 휘어저주세요…
					;복종, 예속
					ELSEIF TALENT:5 || TALENT:8
						CSTR:100 = 응……안쪽까지……들어가서……
					ENDIF
					CFLAG:808 = 600;正常位
					CALL PRINT_AA_ビシャモンテン
				;挿入している場合
				ELSE
					PRINTW 
				ENDIF
				;挿入後
				PRINTFORMW 　
				PRINTFORMW 허리를 움직이자、%CALLNAME은% 교성을 지르며 몸을 떨었다
				PRINTFORMW 안쪽까지 밀어 넣을 때마다、%CALLNAME%의 질내는 %CALLNAME:MASTER%의 자○를 요구하듯 꽉 죄어 온다
				;연모, 친애
				IF TALENT:3 || TALENT:6
					CSTR:100 = 기분좋아아.....%CSTR:이인칭%의 물건%UNICODE(0x2665)%　굵고、딱딱해에%UNICODE(0x2665)%
					CSTR:101 = 아아....대단해에%UNICODE(0x2665)%、기분좋아아....%UNICODE(0x2665)%
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					CSTR:100 = 보○ 기분 좋아앗！%CSTR:이인칭%의 자０%UNICODE(0x2665)%　굵고、딱딱해에%UNICODE(0x2665)%
					CSTR:101 = 대단해에、기분 좋아요오%UNICODE(0x2665)%%UNICODE(0x2665)%！！
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					CSTR:100 = 좀 더、좀 더…격렬하게、부서질 정도로…부탁드립니다…
				ENDIF
				CFLAG:808 = 601;正常位
				CALL PRINT_AA_ビシャモンテン
				CFLAG:332 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:332 < 3 || FLAG:7 == 2)
				IF ABL:4 >= 5
					PRINTFORMW %CALLNAME%의 질은 %MASTER가% 찌를때마다 꽉 조여온다。
					CSTR:100 = 응핫…아핫%UNICODE(0x2665)%
					CSTR:101 = 아무 생각도 안나…。쾌감에 빠지는걸 멈출 수 없어…
					CFLAG:808 = 601;正常位
					CALL PRINT_AA_ビシャモンテン
				ELSE
					PRINTFORMW %CALLNAME%의 질은 %CALLNAME:MASTER%의 침입을 막힘없이 받아들였다。
					CSTR:100 = 하…앙、큿…목소리가 멋대로 나와버린다。이 무슨 굴욕인가
					CFLAG:808 = 600;正常位
					CALL PRINT_AA_ビシャモンテン
					PRINTFORMW 입으로는 싫어하지만、쾌락으로 얼굴은 빨갛게 물들어 있다。
				ENDIF
				CFLAG:332 = 3
			;그 이외
			ELSEIF CFLAG:332 < 2 || FLAG:7 == 2
				PRINTFORMW 「그만해！、그런 더러운 물건、내 안에 넣지 마라！」
				PRINTFORMW 저항하는 %CALLNAME을% 강제로 제압후、딱딱한 것을 질 안쪽에 쑤셔넣는다。
				PRINTFORMW 「큿…안쪽에…」
				CFLAG:332 = 2
			ENDIF
		ENDIF

