;-------------------------------------------------
;TS毘沙門天口上
;汎用女_武人口上を改変した「くっ殺」風口上。
;オークに対して弱かったり強かったりすると面白いかも(今後の予定？）

;-------------------------------------------------
;ライセンスについて
;	・基本項目(許可する項目を"○"に、許可しない項目を"×"に変更してください。)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1| ○ | 処理上のバグ修正              |
;	+----+----+-------------------------------+
;	|   2| ○ | 口上の誤字・脱字の修正        |
;	+----+----+-------------------------------+
;	|   3| ○ | 口上まとめへの収録            |
;	+----+----+-------------------------------+
;	|   4| ○ | 口上の新規追加                |
;	+----+----+-------------------------------+
;	|   5| ○ | 既存口上の改変                |
;	+----+----+-------------------------------+
;	|   6| ○ | 改変した口上の自由な再配布    |
;	+----+----+-------------------------------+
;	|   7| ○ | 口上内容の転載                |
;	+----+----+-------------------------------+

;-------------------------------------------------
;更新履歴
;	Modification Data:
;	Edit	Date			Author					Reason
;	001		2015/09/12		名無し					汎用女_武人口上を元に作成
;	002		2015/10/07		名無し					淫乱にAAを追加
;	003		2015/12/24		名無し					親愛にAAを追加、AAと台詞を一部変更
;	004		2016/01/03		名無し					戦闘エフェクト追加、構文を整理してファイルサイズ圧縮
;	005		2020/05/29		名無し					AAを関数化
;	002		2023/09/06		絹延					処女喪失処理修正　TFLAG:20が恋慕系陥落を保証しなくなった修正の対応。
;-------------------------------------------------

;使用フラグ一覧
;CFLAG:800　질내사정횟수
;CFLAG:801　尻穴射精回数
;CFLAG:802　絶頂済み
;CFLAG:808　表示するAAを選択

;--------------------------------------------------
;口上セレクト機能：口上説明
;--------------------------------------------------
;この関数のコメントアウトを外すと、口上の選択時に選択肢として候補にあがります
;既に口上のあるキャラや会話タイプの別版の口上を作成する時に利用してください
;その際、この関数を含めたこのファイル内の関数名すべてに_任意の1-49(汎用口上なら1-9)の数字を加えてください
;例： EVENTTRAIN_K[[キャラ:비사문천]] → EVENTTRAIN_K[[キャラ:비사문천]]_12
;--------------------------------------------------
@セレクト口上説明_K[[キャラ:비사문천]],ARG = 0
SIF ARG == 1
	RETURN 0
;;口上名
PRINTFORML TS 비사문천、여기사 풍미
;;口上説明文
PRINTFORML 　　옛스러운 「큭죽」풍 대사입니다。
PRINTFORML 　　TS、소질 변경이 포함되어있습니다。비사문천의 이미지를 망가뜨리고 싶지 않은 분은 선택하지 말아주십시오。
PRINTFORML 　

;--------------------------------------------------
;EVENTTRAIN関係（X1をキャラ番号に置換）
;調教開始時のセリフ CFLAG 201～219を使用
;--------------------------------------------------
@EVENTTRAIN_K[[キャラ:비사문천]]
;--------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;--------------------------------------------------
IF CFLAG:220 == 0
	CSTR:이인칭 = 악마술사님
	CSTR:일인칭 = 나
	;初期化
	FOR LOCAL:1, 0, 200
		TALENT:LOCAL:1 = 0
	NEXT
	TALENT:남자 = 0
	;처녀系列
	TALENT:처녀 = 1
	;性格
	TALENT:꿋꿋함 = 1
	TALENT:프라이드높음 = 1
	;性への関心
	TALENT:자제심 = 1
	;乙女心
	TALENT:부끄럼쟁이 = 1
	;体質
	TALENT:아픔에강함 = 1
	;技術
	TALENT:습득빠름 = 1
	;潔癖度
	TALENT:악취민감 = 1
	;正直度
	;性愛性
	;身体特徴
	TALENT:Ａ민감 = 1
	TALENT:절벽 = 0
	TALENT:거유 = 1
	;特殊
	TALENT:회복빠름 = 1
	
	;AA表示の有無を決定
	PRINTFORML AA표시 여부를 선택해 주세요(나중에 커맨드 「아무것도안한다」로도 변경 가능합니다。)
	CALL INPUT_YN("AA표시 있음", "AA표시 없음")
	IF RESULT == 0
		PRINTFORMW AA를 표시합니다。
		CFLAG:809 = 0
	ELSE
		PRINTFORMW AA를 표시하지 않습니다。
		CFLAG:809 = 1
	ENDIF	
	CFLAG:220 = 1
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL EVENTTRAIN_PY1_K[[キャラ:비사문천]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL EVENTTRAIN_PY1_K[[キャラ:비사문천]]
;		RETURN 0
;	ENDIF
;ENDIF
;--------------------------------------------------
;簡易助手口上の発動時に初調教時口上をスキップ（Y1を助手のキャラ番号にする）
;複数人いる際には、SIF NO:ASSI == Y1 || NO:ASSI == Z1と追加していく
;--------------------------------------------------
;IF CFLAG:201 == 0 && ASSI > 0
;	SIF NO:ASSI == Y1
;		CFLAG:201 =1
;ENDIF
;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	PRINTFORMW 「계약에 따라 비사문천 여기에 등장！！」
	PRINTFORMW COMP에서 %CALLNAME을% 불러내자、위세가 좋은 목소리가 울렸다。
	PRINTFORMW 하지만 상상하던 것보다도 높은 목소리、마치 여성 같은 목소리다。
	PRINTFORMW 「음、적은 어딘가？%일인칭을% 불렀다는 말은 싸움일 테지？」
	PRINTFORMW %CALLNAME:MASTER% 눈앞에 있는 건 우락부락한 무인……이 아니라、늠름한 여성이 서 있다。
	PRINTFORMW 그 몸에서 느껴지는 풍격은 비사문천의 이름에 부끄럽지 않긴 한데……。
	PRINTFORMW 「왜 그러는 것이냐 %CSTR:이인칭%？뭘 골똘히 생각하고 있는가？」
	PRINTFORMW 당혹한 %CALLNAME:MASTER%에게 %CALLNAME이% 말을 걸어왔다。
	PRINTFORMW 일단 눈앞의 여성에게 사정을 설명해보았다。
	PRINTFORMW 「옳거니、그 말인가」
	PRINTFORMW 「아무 문제없다。내가 %이인칭과% 계약한 비사문천……의 분령이다」
	PRINTFORMW 「여하튼 본체는 여러모로 바쁜 신분이라서 말이다。하지만 나도 동등한 힘을 가지고 있으니 걱정 마라！」
	PRINTFORMW 「북구로주의 수호자이자 사천왕 최강의 무신의 힘! 단단히 보여주겠노라!」
	PRINTFORMW 자신만만하게 팔짱 낀 팔 밑에는 갑옷으로도 다 감추지 못하는 커다란 가슴이 보였다。
	PRINTFORMW 분령이라고 쳐도 여성인 이유는 깜깜하지만…… 이쪽에게는 안성맞춤이다。
	PRINTFORMW 「의문은 해결됐느냐？%CSTR:이인칭%、그럼 싸움에……」
	PRINTFORMW 이렇다면 조교할 보람이 있을 법하다…… 그렇게 %CALLNAME%의 귓전에 속삭여주었다。
	PRINTFORMW 「%일인칭을% 조교하겠다고？」
	PRINTFORMW 「천한 놈。근경의 젊은 것은 분수를 모르나 보구나……｣
	PRINTFORMW 「거기 바로 서라! %일인칭이% 심판해주겠다！」
	PRINTFORMW 드센 서슬을 내비치지만 계약한 이상 %CALLNAME:MASTER%에게 거역할 수는 없다。
	CSTR:이인칭 = 네놈
	PRINTFORMW 「무、무슨 짓을 할 셈이냐! %CSTR:이인칭%에게는 최저한의 긍지조차 없는 것이냐！」
	PRINTFORMW 「그만둬… 큭、이와 같은 굴욕을 맛볼 바에는… 죽여라！」
	CFLAG:201 = 1
	RETURN 0
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	PRINTFORMW 「또냐、%CSTR:이인칭%。이와 같이 몇 번씩 노리개로 삼을 줄이야…」
	PRINTFORMW 「허나 %일인칭이% 언제까지고 모욕을 감수하고 있으리라곤 생각하지 말도록！」
	CFLAG:201 = 2
	RETURN 0
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	PRINTFORMW 「또 오늘도 %일인칭을% 희롱할 심산이겠지？｣
	PRINTFORMW 「시간 낭비다。무슨 짓을 하든 %일인칭이% 네게 굴복할 일은 있을 수 없어!｣
	CFLAG:201 = 3
	RETURN 0
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW 「또、온 것이냐？｣
	PRINTFORMW 「어차피 거스르지 못해… 무신의 몸、실컷 사용하려무나…｣
	CFLAG:201 = 4
	RETURN 0
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		IF CFLAG:미조교함락 == 1
			;조교하지 않고 연모를 단 경우
			CSTR:이인칭 = 그대
			PRINTFORMW 「%일인칭을%… 조교？」
			PRINTFORMW 「그… 자상하게 해줄 수 있나？…」
		ELSE
			CSTR:이인칭 = 너
			PRINTFORMW 불려나온 %CALLNAME은% %CALLNAME:MASTER%에게 살그머니 안겨들었다。
			PRINTFORMW 「무신으로서 %일인칭을% 신봉해온 자들은 산더미처럼 있었지만…」
			PRINTFORMW 「그들과 비교해 %이인칭은% 특별해。%CSTR:일인칭%의 등을 맡길 수 있는 건 %CSTR:이인칭%밖에 없도다」
			PRINTFORMW 「만약 %CSTR:이인칭%도 %CSTR:일인칭%에게 등을 맡겨준다면、이 몸을 %CSTR:이인칭%에게 의탁해도 좋다…」
			PRINTFORMW 「그… 만약…、%이인칭이% 싫지 않다면… 말이다만…」
			PRINTFORMW 불안해하는 %CALLNAME을% 껴안았다。
			PRINTFORMW 「앗…、신비한 느낌이다%UNICODE(0x2665)%。이것이 행복…이라는 것인가？」
		ENDIF
	;음란
	ELSEIF TALENT:4
		CSTR:이인칭 = 주군
		PRINTFORMW 「%CALLNAME:MASTER% 공、역시 이런 행위는 좋지 못…하므로… 그게…」
		PRINTFORMW 불려나온 %CALLNAME은% 제대로된 말은 하고 있으나、얼굴은 붉고 숨이 거칠다。
		PRINTFORMW 엉덩이를 어루만지면서 귓전에 속삭이자 떨리는 목소리를 내기 시작했다。
		PRINTFORMW 「네… 넷…、%일인칭은% 마침내 깨달았습니다」
		PRINTFORMW 「%일인칭이% 여자인 까닭은、%CSTR:이인칭%에게 음란무신으로서 자지 봉사하기 위해서입니다…」
		PRINTFORMW %CALLNAME%의 가랑이는 이미 젖어있고 얼룩이 허벅지까지 번져있다。
		PRINTFORMW 「%CSTR:이인칭%、부탁드리나이다…%UNICODE(0x2665)%」
		PRINTFORMW %CALLNAME은% 엉덩이를 내밀고 두 손으로 비부와 항문을 벌렸다。
		CSTR:100 = 여기、여기에에……%CSTR:이인칭%의 커다란 거……찔러줘요오…
		CSTR:101 = 왕창 찔러주세요…%UNICODE(0x2665)%
		CFLAG:808 = 7101;尻出し
		CALL PRINT_AA_ビシャモンテン
		CSTR:100 = ……안에다 정액 찍―찍― 싸주세요%UNICODE(0x2665)%%UNICODE(0x2665)%
		CFLAG:808 = 7100;尻出し(大型）
		CALL PRINT_AA_ビシャモンテン
	;복종
	ELSEIF TALENT:5
		CSTR:이인칭 = 주인님
		PRINTFORMW 「저기……아무쪼록、잘 부탁드립니다……」
	ENDIF
	CFLAG:201 = 5
	RETURN 0
ENDIF

;-------------------------------------------------
;簡易助手口上（Y1を助手のキャラ番号に置換、X1をキャラ番号に変更する) CFLAG203
;掛け合いをするキャラを増やす場合は、構文をコピー＆ペーストをして、CFLAGの数を204、205と増やす
;-------------------------------------------------
;助手の有無をチェック（いない場合は二回目以降へ飛ぶ）
IF ASSI < 0 
	CALL EVENTTRAIN_SECOND_K[[キャラ:비사문천]]
;助手
;ELSEIF NO:ASSI == Y1
;口上のある助手が居ない場合は、通常の二回目以降の口上へ飛ぶ
ELSE
	;연모, 친애
	IF TALENT:3 || TALENT:6
		IF CFLAG:ASSI:딸의친부모고유번호딸 == CFLAG:TARGET:캐릭터고유번호 || CFLAG:ASSI:딸의부친고유번호딸 == CFLAG:TARGET:캐릭터고유번호
			IF CFLAG:203 & 1
				IF FAVORITE_1(TARGET) == ASSI
					PRINTFORMW 「%CALLNAME:ASSI%…」
					IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
						PRINTFORMW 「기다리고 있었다」
						PRINTFORMW 「자아、시작할까」
					ELSEIF TALENT:ＮＴＲ == 2 || TALENT:ＮＴＲ == 5 || ((TALENT:4 || TALENT:7) && TALENT:ＮＴＲ == 0)
						PRINTFORMW 「더 이상 참지 못하겠다」
						PRINTFORMW 「몸이 쑤셔서 못 견디겠어」
					ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
						PRINTFORMW 
					ELSE
						PRINTFORMW 「아직 %CSTR:일인칭%에게 어리광을 더 부렸느냐」
						PRINTFORMW 「못 말리는 아이로구나」
					ENDIF
				ELSE
					PRINTFORMW 「또、%CALLNAME:ASSI%의 상대…」
					PRINTFORMW 「이 아이에게 뭘 시키고 싶은 거냐 %이인칭은% 」
				ENDIF
			ELSE
			;親子初めて
				PRINTFORMW 「왜 %ASSI가% 여기에 있는 거지」
				PRINTFORMW 「설마、이 아이까지 끌어들일 건가」
				CFLAG:203 |= 1
			ENDIF
		ELSEIF CFLAG:ASSI:딸의양부모고유번호딸 == CFLAG:TARGET:캐릭터고유번호
			IF CFLAG:203& 2
				IF FAVORITE_1(TARGET) == ASSI
					IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
						PRINTFORMW 「%CALLNAME:ASSI%、더 가까이 와다오」
						PRINTFORMW 「지금의 %일인칭은% %CALLNAME:ASSI% 전용이다」
					ELSEIF TALENT:ＮＴＲ == 2 || TALENT:ＮＴＲ == 5 || ((TALENT:4 || TALENT:7) && TALENT:ＮＴＲ == 0)
						PRINTFORMW 「%CALLNAME:ASSI%의 손으로 %일인칭을% 엉망진창으로 만들어줬으면 좋겠어」
						PRINTFORMW 「%일인칭은% 이렇게 추잡한 여자란다」
					ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
						PRINTFORMW 
					ELSE
						PRINTFORMW 「이번 상대는 %CALLNAME:ASSI%인가」
						PRINTFORMW 「자、그렇게 긴장하지 마라」
					ENDIF
				ELSE
					PRINTFORMW 「%CALLNAME:ASSI%인가」
					PRINTFORMW 「괜찮아 %CSTR:일인칭%에게 맡겨둬」
				ENDIF
			ELSE
				;義理親子初めて
				PRINTFORMW 「그 아이는 %CALLNAME:ASSI%」
				PRINTFORMW 「%CSTR:일인칭%에게 성교육을 시키고 싶은 건가」
				CFLAG:203 |= 2
			ENDIF
		ELSE
			CALL EVENTTRAIN_SECOND_K[[キャラ:비사문천]]
		ENDIF
	ELSE
	ENDIF
ENDIF

;-------------------------------------------------
;調教開始時（2回目以降、X1をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_K[[キャラ:비사문천]]
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORMW 「뭘 하러 왔지」
	CFLAG:202 = 4
;屈服刻印Lv0
ELSEIF MARK:2 == 0 && (CFLAG:202 < 1 || FLAG:7 == 2)
	PRINTFORMW 「또 왔는가｣
	PRINTFORMW 「%CSTR:이인칭%도 %CSTR:일인칭%의 상대를 하고 있을 겨를 따위 없을 텐데｣
	CFLAG:202 = 1
;屈服刻印Lv1
ELSEIF MARK:2 == 1 && (CFLAG:202 < 2 || FLAG:7 == 2)
	PRINTFORMW 「또 오는 것이냐｣
	PRINTFORMW 「슬슬 포기하면 될 것을｣
	CFLAG:202 = 2
;屈服刻印Lv2
ELSEIF MARK:2 == 2 && (CFLAG:202 < 3 || FLAG:7 == 2)
	PRINTFORMW 「언제까지 이러고 있을 속셈이지」
	PRINTFORMW 「%CSTR:이인칭%에게 있어서도 이 시간은 무의미하지 않은가」
	CFLAG:202 = 3
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0) && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORMW 「와주었는가…」
	PRINTFORMW 「그…、그토록 내 몸은 좋은가？」
	CFLAG:202 = 4

;陥落済み
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	;発情or危険日
	IF 위험일(TARGET) == 1 || 위험일(TARGET) == 3
		;연모, 친애
		IF TALENT:3 || TALENT:6
			PRINTFORMW 소환된 %CALLNAME은% 드레스의 스커트 속에 손을 넣고 속옷을 내렸다。그 속옷은 꿀물로 젖어있다。
			PRINTFORMW 「몸이… 달아올라서… 못 참겠어…」
			PRINTFORMW 「부탁하마… %CSTR:일인칭%의… %CSTR:일인칭%의 호색한 몸을」
			CSTR:100 = 격렬하게、귀여워해주지 않겠는가…%UNICODE(0x2665)%
			CFLAG:808 = 7101;尻出し
			CALL PRINT_AA_ビシャモンテン
		;음란, 창부
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORMW 불려나온 %CALLNAME은% 바닥에 네 발로 엎드렸다。이미 그 비부에는 미끌미끌한 꿀물이 넘치고 있다。
			CSTR:100 = %CSTR:일인칭%의、암캐의 엉큼한 보지로
			CSTR:101 = %CSTR:이인칭%께 봉사하게 해주세요♪
			CFLAG:808 = 7102;四つん這い
			CALL PRINT_AA_ビシャモンテン
		;복종, 예속
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 「이런 %일인칭이라%도、%CSTR:이인칭%의 도움이 될 수 있어서……정말 기쁩니다。」
		ENDIF
	;통상（陥落済み）
	ELSE
		;연모, 친애
		IF TALENT:3 || TALENT:6
			PRINTFORMW 불려나온 %CALLNAME은% 앞으로 할 일에 기대해 얼굴을 붉히고 있다。
			CSTR:100 = 오늘도、그… 할 건가?
			CFLAG:808 = 7103;半裸３
			CALL PRINT_AA_ビシャモンテン
			CSTR:100 = 아니、딱히 싫다는 건 아니다만…
			CSTR:101 = 사、상냥하게… 해다오%UNICODE(0x2665)%
			CFLAG:808 = 7104;半裸２
			CALL PRINT_AA_ビシャモンテン
		;음란, 창부
		ELSEIF TALENT:4 || TALENT:7
			;全裸
			TEQUIP:모자 = 0
			TEQUIP:옷 = 0
			TEQUIP:하의 = 0
			TEQUIP:전신복 = 0
			TEQUIP:손 = 0
			TEQUIP:속옷（상） = 0
			TEQUIP:속옷（하） = 0
			TEQUIP:전신속옷 = 0
			TEQUIP:양말 = 0
			TEQUIP:신발 = 0
			TEQUIP:겉옷 = 0
			PRINTFORMW 「그… 또 하는 건가？…역시、이 같은 짓은 이제 그쳐야 한다고 생각한다만…」
			PRINTFORMW 변함없이 %CALLNAME은% 입으로야 싫어해도 그 손은 무의식중에 유방과 가랑이를 잡고 있다。
			PRINTFORMW 조교를 그만두려는 시늉을 보이자 %CALLNAME은% 옷을 벗고 전라가 되었다。
			PRINTFORMW 「해、했습니닷! 사실은 기대하고 있었습니다！」
			PRINTFORMW 「%CSTR:이인칭%의 총애를 기대했습니다！」
			CSTR:100 = %CSTR:일인칭%의、호색한 몸으로
			CSTR:101 = %CSTR:이인칭%에게 봉사하게 해주세요!!
			CFLAG:808 = 7105;全裸
			CALL PRINT_AA_ビシャモンテン
		;복종, 예속
		ELSEIF TALENT:5 || TALENT:8
				PRINTFORMW 「저기……%CSTR:이인칭%、오늘도 아무쪼록、잘 부탁드립니다……」
		ENDIF
	ENDIF
	CFLAG:202 = 5
ENDIF
RETURN 0

;-------------------------------------------------
;EVENTEND関係（X1をキャラ番号に置換）
;調教終了時のセリフ
;-------------------------------------------------
@EVENTEND_K[[キャラ:비사문천]]
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL EVENTEND_PY1_K[[キャラ:비사문천]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	SIF NO:ASSI == Y1
;	CALL EVENTEND_PY1_K[[キャラ:비사문천]]
;	RETURN 0
;ENDIF
;--------------------------------------------------
;調教終了時のセリフ
;--------------------------------------------------
DRAWLINE
;V射精回数リセット
CFLAG:800 = 0
;A射精回数リセット
CFLAG:801 = 0
;絶頂回数リセット
CFLAG:802 = 0

;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:217 < 1 || FLAG:7 == 2)
	PRINTFORMW 「이 원한、잊지 않겠다」
	CFLAG:217 = 1
;屈服刻印Lv1以下
ELSEIF MARK:2 <= 1 && (CFLAG:219 < 1 || FLAG:7 == 2)
	PRINTFORMW 「대체 언제까지 이 모욕을 참으면 되는 것이야…」
	PRINTFORMW 「언제까지…」
	CFLAG:219 = 1
;屈服刻印Lv2
ELSEIF MARK:2 == 2
	PRINTFORMW 「언제까지 계속해야 직성이 풀릴 거냐」
	CFLAG:219 = 2
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW 「나、%일인칭은%、결코 %CSTR:이인칭%의 조교에 굴하지는 않을 거다! 진짜다！」
	CFLAG:219 = 3
;陥落済み＋体力500未満
ELSEIF BASE:0 < 500 && (CFLAG:218 < 1 || FLAG:7 == 2)
		;연모, 친애
		IF TALENT:3 || TALENT:6
			CSTR:100 = 나 참… %CSTR:일인칭%도 이젠 지쳤다고…
			CSTR:101 = （매번、매번… 너무 굉장해…）
		;음란, 창부
		ELSEIF TALENT:4 || TALENT:7		
			PRINTFORMW 「오늘도、굉장했습니다…」
			CSTR:100 = 아앗…♪　몸、움직이지 않아……%UNICODE(0x2665)%
			CSTR:101 = 조금… 쉬게… 해주세요…%UNICODE(0x2665)%
		;복종, 예속
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 「저기……조금、쉬도록 하겠습니다……」
		ENDIF	
		IF RAND:2 == 0
			CFLAG:808 = 7106;全裸（事後）
		ELSE
			CFLAG:808 = 7107;全裸（事後２）
		ENDIF
		CALL PRINT_AA_ビシャモンテン
	CFLAG:218 = 1
;陥落済み
ELSEIF CFLAG:219 < 4 || FLAG:7 == 2
	;연모, 친애
	IF TALENT:3 || TALENT:6
		CSTR:100 = 오늘은 이제 그만하는 거군…
		CSTR:101 = 또、바로 불러다오%UNICODE(0x2665)%
	;음란, 창부
	ELSEIF TALENT:4 || TALENT:7
		CSTR:100 = 괴、굉장했어요…%CSTR:이인칭%%UNICODE(0x2665)%
		CSTR:101 = 다음은 언제 불러 주시겠습니까%UNICODE(0x2665)%
	;복종, 예속
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORMW 「아직……아직……이 %일인칭은% 도움이 될 수 있습니다。」
	ENDIF
	CFLAG:808 = 7108;半裸（事後）
	CALL PRINT_AA_ビシャモンテン
	CFLAG:219 = 4
ENDIF
RETURN 0

;--------------------------------------------------
;@KOJO_MESSAGE_COM関係（X1をキャラ番号に置換）
;コマンド実行時に出力されます
;--------------------------------------------------
@KOJO_MESSAGE_COM_K[[キャラ:비사문천]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL TRAIN_MESSAGE
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_COM_PY1_K[[キャラ:비사문천]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_COM_PY1_K[[キャラ:비사문천]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;コマンド実行時のセリフ CFLAG 300～500
;-------------------------------------------------
;=================================================
;愛撫系コマンド
;=================================================
;-------------------------------------------------
;0,애무
;-------------------------------------------------
SELECTCASE SELECTCOM
	CASE 0
		CALL TRAIN_MESSAGE
		;主人調教
		IF  ASSIPLAY == 0 && TEQUIP:25 == 0
			;처음
			IF CFLAG:300 !& 1
				IF MARK:2 == 3
					PRINTFORMW 「응… 더、자상하게 어루만져다오」
				ELSE
					PRINTFORMW 「만지지 마라! 천한 놈！」
				ENDIF
				CFLAG:300 |= 1
			;2번째 이후
			ELSE
				;함락완료
				IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:300 & 8 || FLAG:7 == 2)
					CSTR:100 = 웅… 앗…
					;風呂に入っている
					IF TEQUIP:31
						CFLAG:808 = 1;風呂で愛撫
					;통상
					ELSE
						CFLAG:808 = 0;愛撫
					ENDIF
					CALL PRINT_AA_ビシャモンテン
					PRINTFORMW 게다가、배후에서 애무하자、%CALLNAME은% 거칠게 숨을 몰아쉬었다。
					;B or C感覚が5以上 or 快Bor Cが5000以上
					IF (ABL:Ｂ감각 >= 5 && PALAM:쾌Ｂ >= 1000) || (PALAM:쾌Ｂ >= 5000) || (ABL:Ｃ감각 >= 5 && PALAM:쾌Ｃ >= 1000) || (PALAM:쾌Ｃ >= 5000)
						CSTR:100 = 아、으읏……、대,단해에……、이거、굉장해서%UNICODE(0x2665)%
						CSTR:101 = 아、머리、새하얗게 되버려……%UNICODE(0x2665)%
						CFLAG:808 = 8110;강절정（顔）
					ELSE
						;연모, 친애
						IF TALENT:3 || TALENT:6
							CSTR:100 = %CSTR:이인칭%에게 만져지는것 만으로、%일인칭은%…
							CSTR:101 = （너무 행복해서… 꿈을 꾸는것만 같아…%UNICODE(0x2665)%）
							CFLAG:808 = 2;愛撫2
						;음란, 창부
						ELSEIF TALENT:4 || TALENT:7
							CSTR:100 = 앗…、안됩니다 %CSTR:이인칭%…　
							CSTR:101 = 그곳을 만지면、%CSTR:일인칭%…
							CFLAG:808 = 0;愛撫
							CALL PRINT_AA_ビシャモンテン
							CSTR:100 = 상스러운 %일인칭은% …자○가 갖고 싶어져서…젖어버려요…♪
							CSTR:101 = 음란한 보○가 되어버려요♪
							CFLAG:808 = 2;愛撫2
						;복종, 예속
						ELSEIF TALENT:5 || TALENT:8
							CALL BODYTOUCH_K[[キャラ:비사문천]]_5_8
							CFLAG:808 = 3;愛撫3
						ENDIF
					ENDIF
					CALL PRINT_AA_ビシャモンテン
					CFLAG:300 |= 8
				;굴복각인Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:300 & 4 || FLAG:7 == 2)
					CSTR:100 = 응…、으응…
					CSTR:101 = （좀 더、해줬으면 좋을…텐데）
					CFLAG:808 = 0;愛撫
					CALL PRINT_AA_ビシャモンテン
					CFLAG:300 |= 4
				;그 이외
				ELSEIF CFLAG:300 & 2 || FLAG:7 == 2
					CSTR:100 = 열심히 만진들、%일인칭은% 아무것도 느껴지지 않는다
					CFLAG:808 = 3;愛撫
					CALL PRINT_AA_ビシャモンテン
					CFLAG:300 |= 2
				ENDIF
			ENDIF
		;조수調教(恋慕、親愛のみ）
		ELSEIF ASSIPLAY && (TALENT:3 || TALENT:6)
			IF CFLAG:ASSI:딸의친부모고유번호딸 == CFLAG:TARGET:캐릭터고유번호 || CFLAG:ASSI:딸의부친고유번호딸 == CFLAG:TARGET:캐릭터고유번호
				;처음
				IF CFLAG:300 !& 1024
					CSTR:100 = %일인칭은% %CALLNAME:ASSI%의 \@TALENT:TARGET:남자 ?아버지#어머니\@라고
					CSTR:101 = 이런거 하면 안돼
					CFLAG:808 = 3;愛撫3
					CALL PRINT_AA_ビシャモンテン
					CFLAG:300 |= 1024
				;2번째 이후
				ELSE
					;好感度高い
					IF FAVORITE_1(TARGET) == ASSI && (CFLAG:300 & 4096 || FLAG:7 == 2)
						PRINTFORMW 「응…거기…좀 더 괴롭혀줘」
						PRINTFORMW 「거기…괴롭혀지는거 좋아」
						CSTR:100 = （원래는 정말 안 되는 일인데…%CSTR:일인칭%…더 원해져버려）
						CFLAG:808 = 0;愛撫
						CALL PRINT_AA_ビシャモンテン
						CFLAG:300 |= 4096
					;그 이외
					ELSEIF CFLAG:300 & 2048 || FLAG:7 == 2
						CSTR:100 = 안돼、%일인칭은% %CALLNAME:ASSI%의…
						CFLAG:808 = 3;愛撫3
						CALL PRINT_AA_ビシャモンテン
						CFLAG:300 |= 2048
					ENDIF
				ENDIF
			ELSEIF CFLAG:ASSI:딸의양부모고유번호딸 == CFLAG:TARGET:캐릭터고유번호
				;처음
				IF CFLAG:300 !& 8192
					CSTR:100 = 제대로 %일인칭을% 보면서 꼭 안아주는거다
					CSTR:101 = 왜 그러나、긴장했나？
					CFLAG:808 = 3;愛撫3
					CALL PRINT_AA_ビシャモンテン
					CFLAG:300 |= 8192
				;2번째 이후
				ELSE
					;호감도 높음
					IF FAVORITE_1(TARGET) == ASSI && (CFLAG:300 & 32768 || FLAG:7 == 2)
						CSTR:100 = 너무 애태우지는 말아주겠나
						CSTR:101 = 좀 더 안쪽을 만져줘
						CFLAG:808 = 3;愛撫3
						CALL PRINT_AA_ビシャモンテン
						CFLAG:300 |= 32768
					;그 이외
					ELSEIF CFLAG:300 & 16384 || FLAG:7 == 2
						CSTR:100 = 그래、더 가까워도 괜찮아
						CFLAG:808 = 3;愛撫3
						CALL PRINT_AA_ビシャモンテン
						CFLAG:300 |= 16384
					ENDIF
				ENDIF
			ELSE
				;처음
				IF CFLAG:300 !& 128
					PRINTFORMW 
					CFLAG:300 |= 128
				;2번째 이후
				ELSE
					;好感度高い
					IF FAVORITE_1(TARGET) == ASSI && (CFLAG:300 & 512 || FLAG:7 == 2)
						PRINTFORMW 
						CFLAG:300 |= 512
					;그 이외
					ELSEIF CFLAG:300 & 256 || FLAG:7 == 2
						PRINTFORMW 
						CFLAG:300 |= 256
					ENDIF
				ENDIF
			ENDIF
		;触手調教
		ELSEIF TEQUIP:25
			;처음
			IF CFLAG:300 !& 16
				PRINTFORMW 「그만둬…기어오르지 마라…」
				PRINTFORMW 「미끈미끈해서、기분 나쁘군」
				CFLAG:300 |= 16
			;2번째 이후
			ELSE
				;触手経験高い
				IF EXP:TARGET:촉수경험 == 1000 && (CFLAG:300 & 64 || FLAG:7 == 2)
					PRINTFORMW 「익숙해지니 이 녀석도 꽤 귀엽군」
					PRINTFORMW 「앗…%UNICODE(0x2665)%、거기는…안돼%UNICODE(0x2665)%」
					CFLAG:300 |= 64
				;그 이외
				ELSEIF CFLAG:300 & 32 || FLAG:7 == 2
					PRINTFORMW 「싫어、기분 나빠…」
					CFLAG:300 |= 32
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;1,커닐링구스
;-------------------------------------------------
	CASE 1
		CALL TRAIN_MESSAGE
		;처음
		IF CFLAG:301 == 0
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:302 < 4 || FLAG:7 == 2)
				PRINTFORMW 「후앙……%UNICODE(0x2665)%、%CSTR:이인칭%에게 핥아지면 승천해버려…♪」
			ELSE
				PRINTFORMW 「%이인칭이% 그런 곳을 핥다니、굴욕이다…」
			ENDIF
			CFLAG:301 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:301 < 4 || FLAG:7 == 2)
				;연모, 친애
				IF TALENT:3 || TALENT:6
					CSTR:100 = 흐읏…하앙…、
					CSTR:101 = %CSTR:이인칭%에게 핥아지면 승천해버려…
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					CSTR:100 = 후앙……%UNICODE(0x2665)%、
					CSTR:101 = %CSTR:이인칭%에게 핥아지면 승천해버려요…♪
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					CSTR:100 = 앗、안 돼요！%CSTR:이인칭%、
					CSTR:101 = 그、그런 곳을…
				ENDIF
				CFLAG:808 = 10;クンニ
				CALL PRINT_AA_ビシャモンテン
				CFLAG:301 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:301 < 3 || FLAG:7 == 2)
				PRINTFORMW 「이런거、기분만 나쁠 뿐인데…」
				CFLAG:301 = 3
			;그 이외
			ELSEIF CFLAG:301 < 2 || FLAG:7 == 2
				PRINTFORMW 「이 변태놈…！」
				CFLAG:301 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;2,펠라한다
;-------------------------------------------------
	CASE 2
		CALL TRAIN_MESSAGE
		
;-------------------------------------------------
;3,손가락삽입
;-------------------------------------------------
	CASE 3
		CALL TRAIN_MESSAGE
		;처음
		IF CFLAG:303 == 0
			PRINTFORMW 「드、들어오고 있어…」
			CFLAG:303 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:303 < 4 || FLAG:7 == 2)
				;연모, 친애
				IF TALENT:3 || TALENT:6
					CSTR:100 = 앗…、%CSTR:이인칭%의 손가락이 들어와…
					CSTR:101 = %CSTR:일인칭%의 소중한 곳에 들어오고 있어…
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					CSTR:100 = 후앗、%CSTR:이인칭%%UNICODE(0x2665)%、기분 좋아♪
					CSTR:101 = 보○ 기분 좋아요
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					CALL BODYTOUCH_K[[キャラ:비사문천]]_5_8
				ENDIF
				CFLAG:808 = 30;指挿入れ
				CALL PRINT_AA_ビシャモンテン
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:303 < 3 || FLAG:7 == 2)
				PRINTFORMW 「난폭하게는、하지 말아줘…」
				CFLAG:303 = 3
			;그 이외
			ELSEIF CFLAG:303 < 2 || FLAG:7 == 2
				PRINTFORMW 「그만둬…、질내에서 움직이지 마…」
				CFLAG:303 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;4,애널핥기
;-------------------------------------------------
	CASE 4
		CALL TRAIN_MESSAGE
		;처음
		IF CFLAG:304 == 0
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:304 < 4 || FLAG:7 == 2)
				PRINTFORMW 「앗！！、거、거기는 안돼…」
			ELSE
				PRINTFORMW 「그런 곳을 빨다니！？、제정신인가 %CSTR:이인칭%！？」
			ENDIF
			CFLAG:304 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:304 < 4 || FLAG:7 == 2)
				;연모, 친애
				IF TALENT:3 || TALENT:6
					CSTR:100 = 앙…%UNICODE(0x2665)%
					CSTR:101 = %CSTR:일인칭%의 엉덩이를 핥고 있어…%UNICODE(0x2665)%
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					CSTR:100 = 아앙！응아앙%UNICODE(0x2665)%
					CSTR:101 = 엉덩이！！찌릿찌릿 거려요%UNICODE(0x2665)%、엉덩잇！！！응하앙！！
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					CSTR:100 = 안 됩니다！%CSTR:이인칭%！、거기는…거기는…
				ENDIF
				CFLAG:808 = 40;アナル舐め
				CALL PRINT_AA_ビシャモンテン
				CFLAG:304 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:304 < 3 || FLAG:7 == 2)
				CSTR:100 = 아아…、이상한 기분이 되어버려…
				CFLAG:808 = 41;アナル舐め2
				CALL PRINT_AA_ビシャモンテン
				CFLAG:304 = 3
			;그 이외
			ELSEIF CFLAG:304 < 2 || FLAG:7 == 2
				CSTR:100 = 그만둬、기분 나빠…
				CFLAG:808 = 41;アナル舐め2
				CALL PRINT_AA_ビシャモンテン
				CFLAG:304 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;5,애널애무
;-------------------------------------------------
	CASE 5
		;연모, 친애
		IF TALENT:3 || TALENT:6
			CSTR:100 = 엉덩이……엉덩이가…좋아…♪
		;음란, 창부
		ELSEIF TALENT:4 || TALENT:7
			CSTR:100 = 하히이이잇！
		;복종, 예속
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 
		ENDIF
		CFLAG:808 = 50;アナル愛撫
		CALL PRINT_AA_ビシャモンテン
		CALL TRAIN_MESSAGE
		;主人調教
		IF  ASSIPLAY == 0 && TEQUIP:25 == 0
			;처음
			IF CFLAG:305 !& 1
				IF MARK:2 == 3
					PRINTFORMW 「%CSTR:이인칭%……더러우니까」
					PRINTFORMW 「너무…만지지는 말아줘……」
				ELSE
					PRINTFORMW 「싫…거기는 나오는 곳이니까…」
					PRINTFORMW 「그 손가락을 좀 치워줘」
				ENDIF
				CFLAG:305 |= 1
			;2번째 이후
			ELSE
				;함락완료
				IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:305 & 8 || FLAG:7 == 2)
					;연모, 친애
					IF TALENT:3 || TALENT:6
						CSTR:100 = 좀 더…괴롭혀줘…、엉망으로 만들어줘…
						CSTR:101 = 좀 더…%CSTR:일인칭%의 뒷구멍、%CSTR:이인칭% 전용으로 해줘…♪
					;음란, 창부
					ELSEIF TALENT:4 || TALENT:7
						CSTR:100 = %CSTR:이인칭%에게 엉덩이가 만져지면、느껴버려요♪
						CSTR:101 = 좀 더 엉덩이 괴롭혀서、느끼게 해주세요♪
					;복종, 예속
					ELSEIF TALENT:5 || TALENT:8
						CSTR:100 = 저기…%CSTR:이인칭%、그렇게 만지시면、%CSTR:일인칭%、……
					ENDIF
					CFLAG:808 = 51;アナル愛撫2
					CALL PRINT_AA_ビシャモンテン
					CFLAG:305 |= 8
				;굴복각인Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:305 & 4 || FLAG:7 == 2)
					PRINTFORMW 「응……엉덩이…기분 좋아…」
					PRINTFORMW 「안돼……이런거…안돼에…」
					CFLAG:305 |= 4
				;그 이외
				ELSEIF CFLAG:305 & 2 || FLAG:7 == 2
					PRINTFORMW 「그런데나 만져서 즐겁나？」
					PRINTFORMW 「%일인칭은% 잘 모르겠군」
					CFLAG:305 |= 2
				ENDIF
			ENDIF
		;조수調教（恋慕、親愛のみ））
		ELSEIF ASSIPLAY && (TALENT:3 || TALENT:6)
			IF CFLAG:ASSI:딸의친부모고유번호딸 == CFLAG:TARGET:캐릭터고유번호 || CFLAG:ASSI:딸의부친고유번호딸 == CFLAG:TARGET:캐릭터고유번호
				;처음
				IF CFLAG:305 !& 1024
						CSTR:100 = 이봐、어딜 만지는건가
						CSTR:101 = 그런 곳을 만져서 뭘 어쩌는거야？
						CFLAG:808 = 50;アナル愛撫
						CALL PRINT_AA_ビシャモンテン
					CFLAG:305 |= 1024
				;2번째 이후
				ELSE
					;好感度高い
					IF FAVORITE_1(TARGET) == ASSI && (CFLAG:305 & 4096 || FLAG:7 == 2)
						CSTR:100 = 응아앙……%UNICODE(0x2665)%\@TALENT:ASSI:남자 ?아들#딸\@에게 엉덩이 만져져서 느껴버려%UNICODE(0x2665)%
						CSTR:101 = 이런거……안돼…는건데……
						CFLAG:808 = 51;アナル愛撫2
						CALL PRINT_AA_ビシャモンテン
						CFLAG:305 |= 4096
					;그 이외
					ELSEIF CFLAG:305 & 2048 || FLAG:7 == 2
						CSTR:100 = %CALLNAME:ASSI%、적당히 안하면 %CSTR:일인칭% 화낼거다…
						CSTR:101 = 그닥…느끼거나 하지는……
						CFLAG:808 = 50;アナル愛撫
						CALL PRINT_AA_ビシャモンテン
						CFLAG:305 |= 2048
					ENDIF
				ENDIF
			ELSEIF CFLAG:ASSI:딸의양부모고유번호딸 == CFLAG:TARGET:캐릭터고유번호
				;처음
				IF CFLAG:305 !& 8192
					CSTR:100 = 여기가 신경쓰이나？
					CSTR:101 = 어쩔 수 없는 아이로군
					CFLAG:808 = 50;アナル愛撫
					CALL PRINT_AA_ビシャモンテン
					CFLAG:305 |= 8192
				;2번째 이후
				ELSE
					;好感度高い
					IF FAVORITE_1(TARGET) == ASSI && (CFLAG:305 & 32768 || FLAG:7 == 2)
						CSTR:100 = %CALLNAME:ASSI% 좋을대로 해도 된다
						CSTR:101 = 하앙%UNICODE(0x2665)%좋아……거기…좋아아%UNICODE(0x2665)%
						CFLAG:808 = 51;アナル愛撫2
						CALL PRINT_AA_ビシャモンテン
						CFLAG:305 |= 32768
					;그 이외
					ELSEIF CFLAG:305 & 16384 || FLAG:7 == 2
						CSTR:100 = 그렇게 만지지 마
						CSTR:101 = 거긴 그런 장소가 아니라고
						CFLAG:808 = 50;アナル愛撫
						CALL PRINT_AA_ビシャモンテン
						CFLAG:305 |= 16384
					ENDIF
				ENDIF
			ELSE
				;처음
				IF CFLAG:305 !& 128
					PRINTFORMW 
					CFLAG:305 |= 128
				;2번째 이후
				ELSE
					;好感度高い
					IF FAVORITE_1(TARGET) == ASSI && (CFLAG:305 & 512 || FLAG:7 == 2)
						PRINTFORMW 
						CFLAG:305 |= 512
					;그 이외
					ELSEIF CFLAG:305 & 256 || FLAG:7 == 2
						PRINTFORMW 
						CFLAG:305 |= 256
					ENDIF
				ENDIF
			ENDIF
		;触手調教
		ELSEIF TEQUIP:25
			;처음
			IF CFLAG:305 !& 16
				PRINTFORMW 「그만둬어、그런데 만지지 마」
				CFLAG:305 |= 16
			;2번째 이후
			ELSE
				;触手経験高い
				IF EXP:TARGET:촉수경험 == 1000 && (CFLAG:305 & 64 || FLAG:7 == 2)
					PRINTFORMW 「그렇게 여기가 마음에 드는건가？」
					PRINTFORMW 「꼭 애태우고 있는것만 같군」
					CFLAG:305 |= 64
				;그 이외
				ELSEIF CFLAG:305 & 32 || FLAG:7 == 2
					PRINTFORMW 「엉덩이가 미끈거려」
					PRINTFORMW 「이제 그만해줘」
					CFLAG:305 |= 32
				ENDIF
			ENDIF
		ENDIF
;-------------------------------------------------
;6,가슴주무르기
;-------------------------------------------------
	CASE 6
		CALL TRAIN_MESSAGE
		;主人調教
		IF  ASSIPLAY == 0 && TEQUIP:25 == 0
			;처음
			IF CFLAG:306 !& 1
				IF MARK:2 == 3
					PRINTFORMW 「%CSTR:일인칭%의 가슴 어떤가」
					PRINTFORMW 「그…마음에 들은건가」
				ELSE
					PRINTFORMW 「가슴만 만지고 있으면 즐겁나？」
				ENDIF
				CFLAG:306 |= 1
			;2번째 이후
			ELSE
				;함락완료
				IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:306 & 8 || FLAG:7 == 2)
					;연모, 친애
					IF TALENT:3 || TALENT:6
						;절정済み
						IF CFLAG:802 >= 1
							CSTR:100 = 앗♪、지금…가슴 만져지면…
							CSTR:101 = 너무 기분 좋아서…머리가 이상해져버려%UNICODE(0x2665)%
						ELSEIF RAND:2 == 0
							CSTR:100 = %CSTR:일인칭%의 가슴은 어떤가？
							CSTR:101 = 좀 더 세개 주물러도 괜찮다…♪
						ELSE
							PRINTFORMW 「아앗…♪　기분 좋아…」
							CSTR:100 = %CSTR:이인칭%에게 가슴이 만져지는것 만으로、기분 좋아져버려…
							CSTR:101 = 조、좀더 마음껏 주물러주게%UNICODE(0x2665)%
						ENDIF
					;음란, 창부
					ELSEIF TALENT:4 || TALENT:7
						;절정済み
						IF CFLAG:802 >= 1
							CSTR:100 = 아앗…♪　기분 좋아요…
							CSTR:101 = 너무 기분 좋아서%UNICODE(0x2665)%、가슴이 이상하게 되버려%UNICODE(0x2665)%%UNICODE(0x2665)%
						ELSE	
							PRINTFORMW 「아앗…♪　기분 좋아요…」
							CSTR:100 = %CSTR:이인칭%에게 가슴이 만져지는것 만으로、기분 좋아져요♪
							CSTR:101 = 조、좀더 주물러주세요♪
						ENDIF
					;복종, 예속
					ELSEIF TALENT:5 || TALENT:8
						CALL BODYTOUCH_K[[キャラ:비사문천]]_5_8
					ENDIF
					;AA選択
					;절정済み
					IF CFLAG:802 >= 1
						CFLAG:808 = 63;가슴揉み(with絶頂)
					;風呂に入りながら
					ELSEIF TEQUIP:31
						CFLAG:808 = 60;가슴揉み(with風呂)
					;下着（上）着用
					ELSEIF TEQUIP:속옷（상） != 0
						IF RAND:2 == 0
							CFLAG:808 = 61;가슴揉み(with下着)
						ELSE
							CFLAG:808 = 62;가슴揉み(with下着2)
						ENDIF
					;그 외
					ELSE
						IF RAND:2 == 0
							CFLAG:808 = 64;가슴揉み
						ELSE
							CFLAG:808 = 65;가슴揉み2
						ENDIF
					ENDIF
					CALL PRINT_AA_ビシャモンテン
					CFLAG:306 |= 8
				;굴복각인Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:306 & 4 || FLAG:7 == 2)
					CSTR:100 = 좀 더……세게 해줘도…괜찮…잊어라
					CSTR:101 = 더 세개 만져주는게、아니 아무것도 아니다…
					CFLAG:808 = 64;가슴揉み
					CALL PRINT_AA_ビシャモンテン
					CFLAG:306 |= 4
				;그 이외
				ELSEIF CFLAG:306 & 2 || FLAG:7 == 2
					CSTR:100 = %CSTR:이인칭%의 손으로 느끼는 일 따위 없다、응……
					CFLAG:808 = 64;가슴揉み
					CALL PRINT_AA_ビシャモンテン
					CFLAG:306 |= 2
				ENDIF
			ENDIF
		;조수調教（恋慕、親愛のみ）
		ELSEIF ASSIPLAY && (TALENT:3 || TALENT:6)
			IF CFLAG:ASSI:딸의친부모고유번호딸 == CFLAG:TARGET:캐릭터고유번호 || CFLAG:ASSI:딸의부친고유번호딸 == CFLAG:TARGET:캐릭터고유번호
				;처음
				IF CFLAG:306 !& 1024
					CSTR:100 = %CSTR:일인칭%의 가슴이 그립나？
					CSTR:101 = 하지만、더는 안나온다
					CFLAG:808 = 64;가슴揉み
					CALL PRINT_AA_ビシャモンテン
					CFLAG:306 |= 1024
				;2번째 이후
				ELSE
					;好感度高い
					IF FAVORITE_1(TARGET) == ASSI && (CFLAG:306 & 4096 || FLAG:7 == 2)
						CSTR:100 = 안돼에…%UNICODE(0x2665)%\@TALENT:ASSI:남자 ?아들#딸\@에게 가슴 만져져서 기뻐하고 있어%UNICODE(0x2665)%
						CSTR:101 = 이런거……안 되는데%UNICODE(0x2665)%
						CFLAG:808 = 63;가슴揉み(with絶頂）
						CALL PRINT_AA_ビシャモンテン
						CFLAG:306 |= 4096
					;그 이외
					ELSEIF CFLAG:306 & 2048 || FLAG:7 == 2
						CSTR:100 = 가슴을 그렇게 만지지 마라
						CSTR:101 = 부모 자식간에 할만한 일이 아니야
						CFLAG:808 = 64;가슴揉み
						CALL PRINT_AA_ビシャモンテン
						CFLAG:306 |= 2048
					ENDIF
				ENDIF
			ELSEIF CFLAG:ASSI:딸의양부모고유번호딸 == CFLAG:TARGET:캐릭터고유번호
				;처음
				IF CFLAG:306 !& 8192
					CSTR:100 = 전체를 감싸듯이、부드럽게 잡는거다
					CSTR:101 = 그래……그런 느낌이야
					CFLAG:808 = 64;가슴揉み
					CALL PRINT_AA_ビシャモンテン
					CFLAG:306 |= 8192
				;2번째 이후
				ELSE
					;好感度高い
					IF FAVORITE_1(TARGET) == ASSI && (CFLAG:306 & 32768 || FLAG:7 == 2)
						CSTR:100 = 마음껏 만져서…느끼게 해줘
						CSTR:101 = 지금의 %일인칭은% %CALLNAME:ASSI%의 것이니까
						CFLAG:808 = 64;가슴揉み
						CALL PRINT_AA_ビシャモンテン
						CFLAG:306 |= 32768
					;그 이외
					ELSEIF CFLAG:306 & 16384 || FLAG:7 == 2
						CSTR:100 = 꽤 하잖아
						CSTR:101 = 지금이라면 %CALLNAME:ASSI% 마음대로 해도 좋다
						CFLAG:808 = 64;가슴揉み
						CALL PRINT_AA_ビシャモンテン
						CFLAG:306 |= 16384
					ENDIF
				ENDIF
			ELSE
				;처음
				IF CFLAG:306 !& 128
					PRINTFORMW 
					CFLAG:306 |= 128
				;2번째 이후
				ELSE
					;好感度高い
					IF FAVORITE_1(TARGET) == ASSI && (CFLAG:306 & 512 || FLAG:7 == 2)
						PRINTFORMW 「」
						CFLAG:306 |= 512
					;그 이외
					ELSEIF CFLAG:306 & 256 || FLAG:7 == 2
						PRINTFORMW 「」
						CFLAG:306 |= 256
					ENDIF
				ENDIF
			ENDIF
		;触手調教
		ELSEIF TEQUIP:25
			;처음
			IF CFLAG:306 !& 16
				PRINTFORMW 「기다렷、가슴에 달라붙지 마라」
				CFLAG:306 |= 16
			;2번째 이후
			ELSE
				;触手経験高い
				IF EXP:TARGET:촉수경험 == 1000 && (CFLAG:306 & 64 || FLAG:7 == 2)
					PRINTFORMW 「아%UNICODE(0x2665)% 가슴 만져주는건가」
					PRINTFORMW 「히응……하앙……가슴 좋아%UNICODE(0x2665)%」
					CFLAG:306 |= 64
				;그 이외
				ELSEIF CFLAG:306 & 32 || FLAG:7 == 2
					PRINTFORMW 「가슴 괴롭혀지고 있어」
					PRINTFORMW 「싫어、싫은데……」
					CFLAG:306 |= 32
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;7,유두자극
;-------------------------------------------------
	CASE 7
		CALL TRAIN_MESSAGE
		;처음
		IF CFLAG:307 == 0
			PRINTFORMW 「히아아아앗？！」
			PRINTFORMW %CALLNAME은% 등을 뒤로 젖혔다。
			PRINTFORMW 「차、착각하지 마라！　%이인칭이% 이상한 곳을 만지니까 조금 놀란거 뿐이다！」
			CFLAG:307 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:307 < 4 || FLAG:7 == 2)
				;舌で責める（ランダム）
				IF RAND:2 ==0
					PRINTFORMW %CALLNAME%의 가슴을 비비면서、딱딱해진 유두를 아래에서부터 애무했다。
					;연모, 친애
					IF TALENT:3 || TALENT:6
						CSTR:100 = 앗～거기 쭙쭙핳지 말아줘%UNICODE(0x2665)%
					;음란, 창부
					ELSEIF TALENT:4 || TALENT:7
						CSTR:100 = 응！……으응……기분 좋아요……♪
					;복종, 예속
					ELSEIF TALENT:5 || TALENT:8
						CALL BODYTOUCH_K[[キャラ:비사문천]]_5_8
					ENDIF
					CFLAG:808 = 70;乳首責め（舌）
					CALL PRINT_AA_ビシャモンテン
				;통상
				ELSE
					PRINTFORMW 엄지와 집게손가락으로 부드럽게 만지자、%CALLNAME은% 몸을 가늘게 떨었다
					;연모, 친애
					IF TALENT:3 || TALENT:6
						CSTR:100 = 읏…、%CSTR:이인칭%에게 만져지면…、
						CSTR:101 = 몸이 져려와…
					;음란, 창부
					ELSEIF TALENT:4 || TALENT:7
						CSTR:100 = 응！……으응……기분 좋아요……♪
					;복종, 예속
					ELSEIF TALENT:5 || TALENT:8
						CALL BODYTOUCH_K[[キャラ:비사문천]]_5_8
					ENDIF
					CFLAG:808 = 71;乳首責め
					CALL PRINT_AA_ビシャモンテン
				ENDIF
				CFLAG:307 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:307 < 3 || FLAG:7 == 2)
				CSTR:100 = 히읏！　흐ー……웃、흐읏ー……
				CSTR:101 = 흣ー……、흣ー……
				CFLAG:808 = 71;乳首責め
				CALL PRINT_AA_ビシャモンテン
				PRINTFORMW %CALLNAME%의 등은 땀에 흠뻑 젖었고、온 몸에 힘을 주고 있다。
				PRINTFORMW 간혹 있는 작은 떨림은 애무에 의한 것이다。
				CFLAG:307 = 3
			;그 이외
			ELSEIF CFLAG:307 < 2 || FLAG:7 == 2
				PRINTFORMW %CALLNAME은% 이를 꽉 깨물고、소리를 내지 않으며 몸부림쳤다
				CSTR:100 = %CSTR:이인칭%、같은 사람이、아무리 괴롭혀도……
				CSTR:101 = 무신의、긍지를、꺾을 수는…、없다…
				CFLAG:808 = 71;乳首責め
				CALL PRINT_AA_ビシャモンテン
				PRINTFORMW 숨을 거칠게 쉬면서 %CALLNAME은% 대답했지만、손가락 사이에서 굴려지고 있는 사랑스러운 유두는 정직하게도 딱딱해져있다。
				CFLAG:307 = 2
			ENDIF
		ENDIF

