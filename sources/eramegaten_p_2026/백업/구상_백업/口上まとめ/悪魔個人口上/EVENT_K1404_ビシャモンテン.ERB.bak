;120,クンニ強制、121,貝あわせ、122,助手を犯させる、123,풋잡한다
;-------------------------------------------------
	CASE 120, 121, 122, 123
		CALL TRAIN_MESSAGE
		IF SELECTCOM == 121
			IF RAND:2 == 0
				CFLAG:808 = 1210;貝あわせ
			ELSE
				CFLAG:808 = 1211;貝合わせ2
			ENDIF
			CALL PRINT_AA_ビシャモンテン
		ENDIF
;-------------------------------------------------
;124,더블펠라
;-------------------------------------------------
	CASE 124
		CALL TRAIN_MESSAGE
		;처음
		IF CFLAG:366 == 0
			PRINTFORMW 
			CFLAG:808 = 1240;ダブルフェラ
			CALL PRINT_AA_ビシャモンテン
			CFLAG:366 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:366 < 4 || FLAG:7 == 2)
				;연모, 친애
				IF TALENT:3 || TALENT:6
					CSTR:100 = 둘이서 기분좋게 해줄게%UNICODE(0x2665)%
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					CSTR:100 = 둘이서 자〇 핥아드릴게요%UNICODE(0x2665)%
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					CSTR:100 = 함께 가겠습니다
				ENDIF
				CFLAG:808 = 1240;ダブルフェラ
				CALL PRINT_AA_ビシャモンテン
				CFLAG:366 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:366 < 3 || FLAG:7 == 2)
				PRINTFORMW 「응…、으믐…、이제 마음대로 해라…」
				CFLAG:366 = 3
			;그 이외
			ELSEIF CFLAG:366 < 2 || FLAG:7 == 2
				PRINTFORMW 「응…、으믐…、어째서 가라안지 않는거냐…」
				CFLAG:366 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;125,더블파이즈리
;-------------------------------------------------
	CASE 125
		CALL TRAIN_MESSAGE
		;처음
		IF CFLAG:367 == 0
			PRINTFORMW 
			CFLAG:367 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:367 < 4 || FLAG:7 == 2)
				;연모, 친애
				IF TALENT:3 || TALENT:6
					CSTR:100 = 어떤가？기분 좋은건가？
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					CSTR:100 = 기분 좋으신가요？%CSTR:이인칭%？
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					CSTR:100 = 어떠신가요？
				ENDIF
				CFLAG:808 = 1250;ダブルパイズリ
				CALL PRINT_AA_ビシャモンテン
				CFLAG:367 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:367 < 3 || FLAG:7 == 2)
				PRINTFORMW 
				CFLAG:367 = 3
			;그 이외
			ELSEIF CFLAG:367 < 2 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:367 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
