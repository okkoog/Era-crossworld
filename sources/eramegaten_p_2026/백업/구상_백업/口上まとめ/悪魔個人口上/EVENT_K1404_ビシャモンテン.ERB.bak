		;처음
		IF CFLAG:413 == 0
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:413 < 4 || FLAG:7 == 2)
				PRINTFORMW 「아……안대……, 거기 닿는거……안댓···__P0__」
			ELSE
				PRINTFORMW 「그만해…움직이지 마라…」
			ENDIF
			CFLAG:413 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:413 < 4 || FLAG:7 == 2)
				;연모, 친애
				IF TALENT:3 || TALENT:6
					PRINTFORMW 「아앙…、응흣…%UNICODE(0x2665)%」
					PRINTFORMW 「%CSTR:이인칭%의 딱딱한 물건으로 찔릴때 마다、찌릿거린다…」
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 「굉장햇%UNICODE(0x2665)%、%CSTR:이인칭%의 자지가%UNICODE(0x2665)%」
					PRINTFORMW 「%CSTR:일인칭%의 보○에%UNICODE(0x2665)%　잔뜩%UNICODE(0x2665)% 잔뜩%UNICODE(0x2665)%」
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 「앗、아앗%UNICODE(0x2665)%」
				ENDIF
				CFLAG:413 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:413 < 3 || FLAG:7 == 2)
				PRINTFORMW 「이、이상한 곳에…닿게、하지 마라…」
				CFLAG:413 = 3
			;그 이외
			ELSEIF CFLAG:413 < 2 || FLAG:7 == 2
				PRINTFORMW 「그만해…、이런일을 해도…소용없다…」
				CFLAG:413 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;507,삽입자궁구자극
;-------------------------------------------------
	CASE 507
		CALL TRAIN_MESSAGE
		;처음
		IF CFLAG:414 == 0
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:414 < 4 || FLAG:7 == 2)
				CSTR:100 = 너무 커다래%UNICODE(0x2665)%　너무 커서、
				CSTR:101 = 아、안쪽까지 닿았어%UNICODE(0x2665)%
			ELSE
				CSTR:100 = 아팟…！、억지로 안에 넣은건가…！
			ENDIF
			CFLAG:808 = 5071;挿入子宮口責め
			CALL PRINT_AA_ビシャモンテン	
			CFLAG:414 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:414 < 4 || FLAG:7 == 2)
				;後背位
				IF PREVCOM:45
					CSTR:100 = 안대%UNICODE(0x2665)%이것%UNICODE(0x2665)%
					CSTR:101 = 오고있어%UNICODE(0x2665)%안쪽까지 오고 있어%UNICODE(0x2665)%%UNICODE(0x2665)%
					CFLAG:808 = 5070;挿入子宮口責め(with後背位）
					CALL PRINT_AA_ビシャモンテン
				;그 외
				ELSE
				ENDIF
				;연모, 친애
				IF TALENT:3 || TALENT:6
					CSTR:100 = 아항！　、자、자궁까지 닿았어…%UNICODE(0x2665)%
					CSTR:101 = %CSTR:일인칭%의 자궁、%CSTR:이인칭%에게 관철되고 있어%UNICODE(0x2665)%
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					CSTR:100 = 자、자귱　 큥큥　기분조아아・・・%UNICODE(0x2665)%
					CSTR:101 = 음란무신의 아기 만드는곳%UNICODE(0x2665)%%CSTR:이인칭%에게 관철되고 있어요%UNICODE(0x2665)%
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					CSTR:100 = （아、머리가…새하얗게…%UNICODE(0x2665)%）
				ENDIF
				CFLAG:808 = 5072;挿入子宮口責め(with騎乗位）
				CALL PRINT_AA_ビシャモンテン
				CFLAG:414 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:414 < 3 || FLAG:7 == 2)
					CSTR:100 = 으흥…、아읏…
					CSTR:101 = 안쪽에 닿아…、온 몸이 기뻐해버려…
					CFLAG:808 = 5071;挿入子宮口責め
					CALL PRINT_AA_ビシャモンテン
				CFLAG:414 = 3
			;그 이외
			ELSEIF CFLAG:414 < 2 || FLAG:7 == 2
				CSTR:100 = 그만해…그런 커다란거 안쪽에 넣지 마라…
				CFLAG:808 = 5071;挿入子宮口責め
				CALL PRINT_AA_ビシャモンテン
				CFLAG:414 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;508,６９파이즈리
;-------------------------------------------------
	CASE 508
		CALL TRAIN_MESSAGE
		;처음
		IF CFLAG:415 == 0
			PRINTFORMW 
			CFLAG:415 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:415 < 4 || FLAG:7 == 2)
				;연모, 친애
				IF TALENT:3 || TALENT:6
					PRINTFORMW 
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ENDIF
				CFLAG:415 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:415 < 3 || FLAG:7 == 2)
				PRINTFORMW 「크…아직도 이렇게나 딱딱하다니、%CSTR:이인칭%의 성욕은 어떻게 되어먹은 것이냐…」
				CFLAG:415 = 3
			;그 이외
			ELSEIF CFLAG:415 < 2 || FLAG:7 == 2
				PRINTFORMW 「크…이 무슨 뜨거움이냐、믿을 수가 없다」
				CFLAG:415 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;509,착유
;-------------------------------------------------
	CASE 509
		CALL TRAIN_MESSAGE
		;主人調教
		IF  ASSIPLAY == 0 && TEQUIP:25 == 0
			;처음
			IF CFLAG:416 !& 1
				IF MARK:2 == 3
					PRINTFORMW 「앗……밀크 나와버려」
				ELSE
					PRINTFORMW 「그렇게 세게 잡으면 모유가 나와버린다」
					PRINTFORMW 「좀 더 상냥하게 해줘」
				ENDIF
				CFLAG:416 |= 1
			;2번째 이후
			ELSE
				;함락완료
				IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:416 & 8 || FLAG:7 == 2)
					;연모, 친애
					IF TALENT:3 || TALENT:6
						PRINTFORMW 「앗……%UNICODE(0x2665)%밀크 나와」
						PRINTFORMW 「%CSTR:11%의 밀크 %CSTR:12%에게 마셔지고 있어」
					;음란, 창부
					ELSEIF TALENT:4 || TALENT:7
						PRINTFORMW 「봐줘어%UNICODE(0x2665)% 소처럼 밀크 쨔는것 봐줘어%UNICODE(0x2665)%」
					;복종, 예속
					ELSEIF TALENT:5 || TALENT:8
						PRINTFORMW 「부디、마셔주세요…」
					ENDIF
					CFLAG:416 |= 8
				;굴복각인Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:416 & 4 || FLAG:7 == 2)
					PRINTFORMW 「아아……밀크 핥지 마라」
					PRINTFORMW 「그…뭐냐…부끄럽다」
					CFLAG:416 |= 4
				;그 이외
				ELSEIF CFLAG:416 & 2 || FLAG:7 == 2
					PRINTFORMW 「모유를 쨔고 싶은건가」
					PRINTFORMW 「이건 아이를 위한…」
					CFLAG:416 |= 2
				ENDIF
			ENDIF
		;조수調教
		ELSEIF ASSIPLAY
			IF CFLAG:ASSI:딸의친부모고유번호딸 == CFLAG:TARGET:캐릭터고유번호 || CFLAG:ASSI:딸의부친고유번호딸 == CFLAG:TARGET:캐릭터고유번호
				;처음
				IF CFLAG:416 !& 1024
					PRINTFORMW 「%CSTR:11%의 가슴이 그리운건가」
					PRINTFORMW 「이제 아이도 아닐텐데」
					CFLAG:416 |= 1024
				;2번째 이후
				ELSE
					;好感度高い
					IF FAVORITE_1(TARGET) == ASSI && (CFLAG:416 & 4096 || FLAG:7 == 2)
						PRINTFORMW 「아앙%UNICODE(0x2665)%%UNICODE(0x2665)%밀크 나와%UNICODE(0x2665)%」
						PRINTFORMW 「\@TALENT:ASSI:남자 ?아들#딸\@에게 가슴 빨려서 느껴버려%UNICODE(0x2665)%」
						CFLAG:416 |= 4096
					;그 이외
					ELSEIF CFLAG:416 & 2048 || FLAG:7 == 2
						PRINTFORMW 「아직도 젓이 먹고 싶은가？」
						PRINTFORMW 「젖을 마셔야 하는 아이도 아닌데 말이다…」
						CFLAG:416 |= 2048
					ENDIF
				ENDIF
			ELSEIF CFLAG:ASSI:딸의양부모고유번호딸 == CFLAG:TARGET:캐릭터고유번호
				;처음
				IF CFLAG:416 !& 8192
					PRINTFORMW 「전체를 감싸듯、부드럽게 잡는거다」
					PRINTFORMW 「너무 세게 하지는 마라、아직 밀크는 나오지 않는다」
					CFLAG:416 |= 8192
				;2번째 이후
				ELSE
					;好感度高い
					IF FAVORITE_1(TARGET) == ASSI && (CFLAG:416 & 32768 || FLAG:7 == 2)
						PRINTFORMW 「가슴으로 밀크 마셔져%UNICODE(0x2665)%」
						PRINTFORMW 「가슴으로 밀크 마셔져서 느끼고 있어어%UNICODE(0x2665)%%UNICODE(0x2665)%」
						CFLAG:416 |= 32768
					;그 이외
					ELSEIF CFLAG:416 & 16384 || FLAG:7 == 2
						PRINTFORMW 「조금 밀크가 나왔다」
						PRINTFORMW 「빨아도 좋다、지금만큼은 %CALLNAME:ASSI%의 뜻대로 해도 되니까」
						CFLAG:416 |= 16384
					ENDIF
				ENDIF
			ELSE
				;처음
				IF CFLAG:416 !& 128
					PRINTFORMW 
					CFLAG:416 |= 128
				;2번째 이후
				ELSE
					;好感度高い
					IF FAVORITE_1(TARGET) == ASSI && (CFLAG:416 & 512 || FLAG:7 == 2)
						PRINTFORMW 「」
						CFLAG:416 |= 512
					;그 이외
					ELSEIF CFLAG:416 & 256 || FLAG:7 == 2
						PRINTFORMW 「」
						CFLAG:416 |= 256
					ENDIF
				ENDIF
			ENDIF
		;触手調教
		ELSEIF TEQUIP:25
			;처음
			IF CFLAG:416 !& 16
				PRINTFORMW 「기다려라、가슴에 달라붙지 마라」
				PRINTFORMW 「아앙、나와버려…」
				CFLAG:416 |= 16
			;2번째 이후
			ELSE
				;触手経験高い
				IF EXP:TARGET:촉수경험 == 1000 && (CFLAG:416 & 64 || FLAG:7 == 2)
					PRINTFORMW 「촉수에 밀크 쨔여져버려%UNICODE(0x2665)%」
					PRINTFORMW 「밀크 쨔여져서 느껴버려%UNICODE(0x2665)%」
					CFLAG:416 |= 64
				;그 이외
				ELSEIF CFLAG:416 & 32 || FLAG:7 == 2
					PRINTFORMW 「아……밀크…나와버려…」
					PRINTFORMW 「아이를 위한…밀크……」
					CFLAG:416 |= 32
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;510,더블스마타
;-------------------------------------------------
	CASE 510
		CALL TRAIN_MESSAGE
;-------------------------------------------------
;511,두개펠라
;-------------------------------------------------
	CASE 511
		CALL TRAIN_MESSAGE
;-------------------------------------------------
;512,애널기승유방자위
;-------------------------------------------------
	CASE 512
		CALL TRAIN_MESSAGE
		;처음
		IF CFLAG:419 == 0
			PRINTFORMW 「%CSTR:일인칭%에게 자기 가슴을 애무하라는 것이냐…」
			PRINTFORMW 「비열한 놈…」
			CFLAG:419 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:419 < 4 || FLAG:7 == 2)
				;연모, 친애
				IF TALENT:3 || TALENT:6
					PRINTFORMW 「흣…、응하앙…%UNICODE(0x2665)%」
					PRINTFORMW 「이제 %일인칭은% 완전히 %CSTR:이인칭%의 것이로구나…」
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 「하앙…%UNICODE(0x2665)%…후앙…%UNICODE(0x2665)%
					PRINTFORMW 「이、이대로…안에…%UNICODE(0x2665)%
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 「크으…、응하아…%UNICODE(0x2665)%」
				ENDIF
				CFLAG:419 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:419 < 3 || FLAG:7 == 2)
				PRINTFORMW 「아…긋…」
				PRINTFORMW 「어째서 이런 비열한 놈의 물건이 %일인칭을% 이상하게 만드는건가…」
				CFLAG:419 = 3
			;그 이외
			ELSEIF CFLAG:419 < 2 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:419 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;513,입과바기나를범한다(３Ｐ派生)
;-------------------------------------------------
	CASE 513
		CALL TRAIN_MESSAGE
;-------------------------------------------------
;514,입과애널을범한다(３Ｐ派生)
;-------------------------------------------------
	CASE 514
		CALL TRAIN_MESSAGE
;-------------------------------------------------
;515,애널흐트러진모란
;-------------------------------------------------
	CASE 515
		CALL TRAIN_MESSAGE
		;처음
		IF CFLAG:441 == 0
			PRINTFORMW 
			CFLAG:441 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:441 < 4 || FLAG:7 == 2)
				;연모, 친애
				IF TALENT:3 || TALENT:6
					CSTR:100 = 아앙…、응…%UNICODE(0x2665)%
					CSTR:101 = 이 부끄러움이、참을 수 없을 만큼 기분 좋다…♪
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					CSTR:100 = 이상하게 되버려！　이런거 이상하게 되버려！%UNICODE(0x2665)%
					;-KR- 임의수정、10 > 101
					CSTR:101 = 좀 더%UNICODE(0x2665)%　좀 더 해줘%UNICODE(0x2665)%
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					CSTR:100 = %CSTR:일인칭%의 부끄러운 곳…봐주세요…
				ENDIF
				CFLAG:808 = 5150;アナル乱れ牡丹
				CALL PRINT_AA_ビシャモンテン
				CFLAG:441 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:441 < 3 || FLAG:7 == 2)
				PRINTFORMW 
				CFLAG:441 = 3
			;그 이외
			ELSEIF CFLAG:441 < 2 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:441 = 2
			ENDIF
		ENDIF
;------------------------------------------------
;コマンド口上ここまで
;------------------------------------------------
	CASEELSE
		SIF FLAG:6 > 0
			CALL TRAIN_MESSAGE
ENDSELECT

;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG関係（X1をキャラ番号に置換）
;パラメータ変化などをトリガーにした口上　CFLAG 221～260を使用
;-------------------------------------------------
;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_A（X1をキャラ番号に置換）
;調教者の射精をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_A_K[[キャラ:비사문천]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_A
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_A_PY1_K[[キャラ:비사문천]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_A_PY1_K[[キャラ:비사문천]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;調教者の射精時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;射精箇所変更時のテキスト　有効時はここで関数終了
;-------------------------------------------------
IF CFLAG:106
	CALL PALAM_MESSAGE_A
	;머리카락
	IF CFLAG:106 == 1
		;함락완료
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:221 < 3 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:221 = 3
		;굴복각인Lv3
		ELSEIF MARK:2 == 3 && (CFLAG:221 < 2 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:221 = 2
		;그 이외
		ELSEIF CFLAG:221 < 1 || FLAG:7 == 2
			PRINTFORMW 
			CFLAG:221 = 1
		ENDIF
	;얼굴
	ELSEIF CFLAG:106 == 2
		;함락완료
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:222 < 3 || FLAG:7 == 2)
			CFLAG:808 = 8000;사정（顔）
			CALL PRINT_AA_ビシャモンテン
			CFLAG:222 = 3
		;굴복각인Lv3
		ELSEIF MARK:2 == 3 && (CFLAG:222 < 2 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:222 = 2
		;그 이외
		ELSEIF CFLAG:222 < 1 || FLAG:7 == 2
			PRINTFORMW 
			CFLAG:222 = 1
		ENDIF
	;가슴
	ELSEIF CFLAG:106 == 3
		;함락완료
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:223 < 3 || FLAG:7 == 2)
			CFLAG:808 = 8001;사정（胸）
			CALL PRINT_AA_ビシャモンテン
			CFLAG:223 = 3
		;굴복각인Lv3
		ELSEIF MARK:2 == 3 && (CFLAG:223 < 2 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:223 = 2
		;그 이외
		ELSEIF CFLAG:223 < 1 || FLAG:7 == 2
			PRINTFORMW 
			CFLAG:223 = 1
		ENDIF
