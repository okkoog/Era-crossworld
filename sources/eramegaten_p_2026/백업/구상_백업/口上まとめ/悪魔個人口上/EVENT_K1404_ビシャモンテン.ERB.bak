;汎用台詞関数
@BODYTOUCH_K[[キャラ:비사문천]]_5_8
SELECTCASE RAND:3
	CASE 0
		CSTR:100 = 저기…%CSTR:이인칭%、그렇게 만지시면、
		CSTR:101 = %CSTR:일인칭%、혼란스럽습니다……
	CASE 1
		CSTR:100 = 앗……깜、깜짝 놀랐습니다……
	CASE 2
		CSTR:100 = 무、무슨 일이신가요……？
ENDSELECT


