		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:333 < 4 || FLAG:7 == 2)
				;吊り下げ緊縛されている
				IF TEQUIP:37 == 8
					;연모, 친애
					IF TALENT:3 || TALENT:6
						CSTR:100 = 좀 더…좀 더 격렬하게 해줘%UNICODE(0x2665)%
						CSTR:101 = %CSTR:이인칭%의 딱딱한 물건으로、%CSTR:일인칭%의 질내를 괴롭혀줘%UNICODE(0x2665)%
					;음란, 창부
					ELSEIF TALENT:4 || TALENT:7
						CSTR:100 = 앗…、%UNICODE(0x2665)%밧줄…기분 좋아요%UNICODE(0x2665)%
						CSTR:101 = 자○ 기분 좋아요%UNICODE(0x2665)%
