;-------------------------------------------------
;146,관장기＋플러그
;-------------------------------------------------
	CASE 146
		IF TEQUIP:21
			CALL TRAIN_MESSAGE
			;처음
			IF CFLAG:375 == 0
				;굴복각인Lv3
				IF MARK:2 == 3
					PRINTFORMW 「무리…！　무리…！더는 안 들어가…한계다…！」
					PRINTFORMW %MASTER는% 화장실에 보내달라고 요청하는 %CALLNAME%에게 아까 정해둔 대사를 말하라고 속삭였다。
					PRINTFORMW 「%CSTR:이인칭%！그런…걸 %CSTR:일인칭%에게…」
					PRINTFORMW 이쪽을 노려보던、%CALLNAME%였으나、한계에 다다른것 같다。
					PRINTFORMW 「한다！　할테니까！　할테니 부탁이다！」
					PRINTFORMW 「ㄴ、ㄴ…나…%CALLNAME은% ！、%CALLNAME:MASTER%의 노예입니다！」
					PRINTFORMW 「어、언제든지、보지에 사정해주세요！」
					PRINTFORMW 「２４시간、언제든지 기다리고 있습니다」
					PRINTFORMW 「입도 애널도、머리카락도 손도、가슴도 전부…！、주인님의 것입니다！」
					PRINTFORMW 「말했다！　그러니까…이제…용서해줘！　빨리！」
				ELSE
					PRINTFORMW 「무리…！　무리…！더는 안 들어가…한계다…！」
				ENDIF
				CFLAG:375 = 1
			;2번째 이후
			ELSE
				;함락완료
				IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:375 < 4 || FLAG:7 == 2)
					;연모, 친애
					IF TALENT:3 || TALENT:6
						CSTR:100 = 읏…엉덩이에 들어오고 있어…
					;음란, 창부
					ELSEIF TALENT:4 || TALENT:7
						CSTR:100 = 읏…엉덩이에 들어오는걸 알 수 있어요♪
					;복종, 예속
					ELSEIF TALENT:5 || TALENT:8
						CSTR:100 = 응…엉덩이에 들어가서…
					ENDIF
					CFLAG:808 =1460;浣腸
					CALL PRINT_AA_ビシャモンテン
					CFLAG:375 = 4
				;굴복각인Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:375 < 3 || FLAG:7 == 2)
					PRINTFORMW 「그만해！　그만해주게！」
					PRINTFORMW 「%CSTR:이인칭%의 말을 들을테니까！　그것만은 그만둬주게！」
					CFLAG:375 = 3
				;그 이외
				ELSEIF CFLAG:375 < 2 || FLAG:7 == 2
					PRINTFORMW 
					CFLAG:375 = 2
				ENDIF
			ENDIF
		;배설！
		ELSE
			IF CFLAG:375 == 1 || FLAG:7 == 2
				CALL TRAIN_MESSAGE
				;함락완료
				IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8)
					PRINTFORMW 「아아、나와！나와버려！」
				ELSE
					PRINTFORMW 「보지마！　보지 말란 말이다！」
				ENDIF
			ENDIF
		ENDIF

