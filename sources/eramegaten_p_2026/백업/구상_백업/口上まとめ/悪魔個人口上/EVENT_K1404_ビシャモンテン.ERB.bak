;-------------------------------------------------
;144,방뇨
;-------------------------------------------------
	CASE 144
		CALL TRAIN_MESSAGE
		;처음
		IF CFLAG:373 == 0
			PRINTFORMW 「그만해！！보지마！、보지 말란 말이다！！」
			CFLAG:373 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:373 < 4 || FLAG:7 == 2)
				;野外プレイの場合
				IF TEQUIP:29
					PRINTFORMW 거기다 네 발로 엎드려서、개처럼 방뇨하게 만들었다
					;연모, 친애
					IF TALENT:3 || TALENT:6
						CSTR:100 = 너、너무 부끄럽다…
					;음란, 창부
					ELSEIF TALENT:4 || TALENT:7
						CSTR:100 = %CSTR:이인칭%、야한 암캐가 오줌 싸는 거…
						CSTR:101 = 봐주세요♪
					;복종, 예속
					ELSEIF TALENT:5 || TALENT:8
						CSTR:100 = 봐주세요…
					ENDIF
					CFLAG:808 = 1440;방뇨（野外）
					CALL PRINT_AA_ビシャモンテン
				;그 이외
				ELSE
					;연모, 친애
					IF TALENT:3 || TALENT:6
						CSTR:100 = 너、너무 부끄럽다…
					;음란, 창부
					ELSEIF TALENT:4 || TALENT:7
						CSTR:100 = %CSTR:이인칭%…보고 계십니까♪
						CSTR:101 = 변태 여자가 오줌을 싸는 모습…♪
					;복종, 예속
					ELSEIF TALENT:5 || TALENT:8
						CSTR:100 = 봐주세요…
					ENDIF
					CFLAG:808 = 1441;방뇨
					CALL PRINT_AA_ビシャモンテン
				ENDIF
				CFLAG:373 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:373 < 3 || FLAG:7 == 2)
				CSTR:100 = 아아…、이런 모습을 %CSTR:이인칭%에게 보이다니…
				CFLAG:808 = 1441;방뇨
				CALL PRINT_AA_ビシャモンテン
				CFLAG:373 = 3
			;그 이외
			ELSEIF CFLAG:373 < 2 || FLAG:7 == 2
				CSTR:100 = 이 변태놈…、도대체 어디까지 %일인칭을% 욕보일 생각인거냐…
				CFLAG:808 = 1441;방뇨
				CALL PRINT_AA_ビシャモンテン
				CFLAG:373 = 2
			ENDIF
		ENDIF

