@ENEMY_BATTLE_EVENT_K[[キャラ:비사문천]], ARG, ARG:1, ARG:2
IF TFLAG:전투이벤트 == 1
;敵でのデビルＣＯ－ＯＰ発動時の台詞
;			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"",72,LEFT%┃
;			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF
IF TFLAG:전투이벤트 == 2
;敵でのデビルＣＯ－ＯＰ参加時の台詞
;			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"",72,LEFT%┃
;			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

@KOJO_BATTLE_EVENT_K[[キャラ:비사문천]], ARG, ARG:1, ARG:2
IF TFLAG:전투이벤트 == 1
;味方パーティでのデビルＣＯ－ＯＰ発動時の台詞
	;服従、隷属
	IF TALENT:5 || TALENT:8
		PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"돌격준비…갑시다！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ELSE
		IF FLAG:무후후전개 == 1 && (TEQUIP:86 == 612 || TEQUIP:86 == 613 || TEQUIP:86 == 614 || TEQUIP:86 == 615)
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"앗…" + UNICODE(0x2665) + "　아、안돼、손이 꼬여버렷",72,LEFT%┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ELSE
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"지금이다、몰아붙인다！",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ENDIF
	ENDIF
ENDIF
IF TFLAG:전투이벤트 == 2
;味方パーティでのデビルＣＯ－ＯＰ参加時の台詞
	;服従、隷属
	IF TALENT:5 || TALENT:8
		PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"갑니다！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ELSE
		IF FLAG:무후후전개 == 1 && (TEQUIP:86 == 612 || TEQUIP:86 == 613 || TEQUIP:86 == 614 || TEQUIP:86 == 615)
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"아앗" + UNICODE(0x2661) + "　느、늦어버린다" + UNICODE(0x2661),72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ELSE
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"원호한다！",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ENDIF
	ENDIF
ENDIF


IF TFLAG:전투이벤트 == 3
;味方パーティでの被召喚時の台詞	
	;服従、隷属
	IF TALENT:5 || TALENT:8
		PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"출격하겠습니다！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ELSE
		PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"비사문천의 힘、그 눈에 똑똑히 새기도록 하라！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF
ENDIF


;공격(単体 or 範囲限定）
IF (TFLAG:전투이벤트 == 11 || TFLAG:전투이벤트 == 13 )
	;服従、隷属
	IF TALENT:5 || TALENT:8
		PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"돌격준비…갑시다！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ELSE
		;攻撃して倒した
		IF BASE:(ARG:1):ＨＰ <= 0
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"무신의 힘、깨달았는가！",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 30
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"무신의 힘、꺠닫도록 하라！",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		;小ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 10
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"이대로 쓰러뜨려주겠단！",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		;微ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"…큰 효과는 없는것 같군…",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		;無効化された
		ELSEIF ARG:2 == 0
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"흠집도 없다니！？",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		;攻撃したけど吸収された
		ELSEIF ARG:2 < 0
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"바보같은？！내 공격을 흡수했다고！？",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ENDIF
	ENDIF
ENDIF

IF TFLAG:전투이벤트 == 17
;攻撃ミス
	PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃%"피했다！？",72,LEFT%┃
	PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;被弾
IF TFLAG:전투이벤트 == 12 || TFLAG:전투이벤트 == 14
	;服従、隷属
	IF TALENT:5 || TALENT:8
		;死亡
		IF BASE:ARG:ＨＰ <= 0
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃"（" + %CSTR:일인칭 + "…무사하기실…）",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"아직…아직！、한 방 더 정도는！",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		;小ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 0
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"아팟…그래도、아직！",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ENDIF
	ELSE
		;死亡
		IF BASE:ARG:ＨＰ <= 0
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃"（" + %CSTR:일인칭 + "…무사하기실…）",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		;残り１５％以下
		ELSEIF 現HP割合(ARG) < 15
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"아직…쓰러질 수는…",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			CFLAG:808 = 7500;ダメージ
			CALL PRINT_AA_ビシャモンテン
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"나무삼！",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		;中ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"좀 많이 맞은건가…",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			CFLAG:808 = 7001;(泣き)
			CALL PRINT_AA_ビシャモンテン
		;小ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 0
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"공격이 얕다！",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		;無効
		ELSEIF ARG:2 == 0
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"소용없다！",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		;吸収
		ELSEIF ARG:2 < 0
			PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"훗…어리석은 놈이군♪",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ENDIF
	ENDIF
ENDIF
;食いしばり等で耐えた
IF TFLAG:전투이벤트 == 23
	;이악물기
	IF BASE:ARG:ＨＰ == 1
		PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"이 정도로、날 쓰러뜨릴 수 있다 생각치 마라！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;その他
	ELSE
	ENDIF
ENDIF

;회피
IF TFLAG:전투이벤트 == 18
	PRINTFORML ┏＠%CALLNAME:ARG,20,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃%"느려！",72,LEFT%┃
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF


@KOJO_BATTLE_MESSAGE_K[[キャラ:비사문천]],ARG,ARG:1 = 0

	CALL GET_SKILL_PROP, "SKILL_NAME", CFLAG:ARG:입력행동, ARG
	;使用したスキルの名前をLOCALSに代入
	LOCALS = %RESULTS%
	;↑汎用少女口上からお借りしました/メアリの人　　←メアリ口上からお借りしました/造魔口上(1)加筆した人
	
;選択したコマンドにより分岐させたい場合、IF文の条件にコマンドNoを記入すること

;공격
IF CFLAG:ARG:입력행동 == 0
	IF RAND:2 == 0
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"무신에게 공격받는 불행을 저주하는게 좋을 것이다！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
