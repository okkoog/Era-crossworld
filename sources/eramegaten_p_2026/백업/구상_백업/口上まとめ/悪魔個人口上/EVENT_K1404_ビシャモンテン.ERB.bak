			PRINTFORMW 
			CFLAG:313 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:313 < 4 || FLAG:7 == 2)
				PRINTFORMW 아무것도 안하고 있자、실오라기 하나 걸치지 않은 %CALLNAME이% 다가왔다
				;연모, 친애
				IF TALENT:3 || TALENT:6
					PRINTFORMW 「아무것도 안하는건가？　그러면…그…」
					PRINTFORMW （우으…。나 스스로 야한일을 원한다는건…말할 수 없다…）
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORML 
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 「%CSTR:이인칭%…、저기、그게…」
					PRINTFORMW 「저기、죄송합니다、……아무것도、아닙니다。」
				ENDIF
				CFLAG:313 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:313 < 3 || FLAG:7 == 2)
				PRINTFORMW 
				CFLAG:313 = 3
			;그 이외
			ELSEIF CFLAG:313 < 2 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:313 = 2
			ENDIF
		ENDIF
		;AA表示の有無を決定
		IF CFLAG:809 == 0
			PRINTFORML AA표시 여부를 변경하시겠습니까？(현재：표시있음）
		ELSE
			PRINTFORML AA표시 여부를 변경하시겠습니까？(현재：표시없음）
		ENDIF
		CALL INPUT_YN("AA표시 있음", "AA표시 없음")
		IF RESULT == 0
			PRINTFORMW AA를 표시합니다。
			CFLAG:809 = 0
		ELSE
			PRINTFORMW AA를 표시하지 않습니다。
			CFLAG:809 = 1
		ENDIF

