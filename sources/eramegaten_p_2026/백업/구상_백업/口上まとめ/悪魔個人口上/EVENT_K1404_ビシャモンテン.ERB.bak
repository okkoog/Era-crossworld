		PRINTFORMW 
		CFLAG:247 = 2
	;그 이외
	ELSEIF CFLAG:247 < 1 || FLAG:7 == 2
		PRINTFORMW 
		CFLAG:247 = 1
	ENDIF
ENDIF

;-------------------------------------------------
;분유
;-------------------------------------------------
;噴乳している
IF TFLAG:11 > 0
	;함락완료
	IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:248 < 3 || FLAG:7 == 2)
		PRINTFORMW %CALLNAME%의 유두에서 새하얀 액체가 힘차게 분출됐다。
		CSTR:100 = 좋아앗%UNICODE(0x2665)% 밀크나와버려%UNICODE(0x2665)%
		CSTR:101 = 밀크나와버려어%UNICODE(0x2665)%
		CFLAG:808 = 8200;분유
		CALL PRINT_AA_ビシャモンテン
		CFLAG:248 = 3
	;굴복각인Lv3
	ELSEIF MARK:2 == 3 && (CFLAG:248 < 2 || FLAG:7 == 2)
		CSTR:100 = 밀크 나오고 있어…
		CSTR:101 = 가슴 괴롭혀져서 밀크 나오고있어…
		CFLAG:808 = 8200;분유
		CALL PRINT_AA_ビシャモンテン
		CFLAG:248 = 2
	;그 이외
	ELSEIF CFLAG:248 < 1 || FLAG:7 == 2
		CSTR:100 = 싫어…보지 말아줘…보지마
		CFLAG:808 = 8200;분유
		CALL PRINT_AA_ビシャモンテン
		CFLAG:248 = 1
	ENDIF
ENDIF

;-------------------------------------------------
;방뇨
;-------------------------------------------------
;放尿している
IF TFLAG:29 > 0 && (TEQUIP:27 || TALENT:57)
	;함락완료
	IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:249 < 3 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:249 = 3
	;굴복각인Lv3
	ELSEIF MARK:2 == 3 && (CFLAG:249 < 2 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:249 = 2
	;그 이외
	ELSEIF CFLAG:249 < 1 || FLAG:7 == 2
		PRINTFORMW 
		CFLAG:249 = 1
	ENDIF
ENDIF

;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_C関係（X1をキャラ番号に置換）
;調教後の変化をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_C_K[[キャラ:비사문천]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_C
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_C_PY1_K[[キャラ:비사문천]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_C_PY1_K[[キャラ:비사문천]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;調教後のテキスト
;-------------------------------------------------
;-------------------------------------------------
;処女喪失(処女のみ)
;-------------------------------------------------
IF TFLAG:3 > 0
	CALL PALAM_MESSAGE_C
	;---006 EDIT START---
	;주인에의한처녀상실
	IF TFLAG:20
		;陥落素質チェック
		IF TALENT:연모 || TALENT:친애
			PRINTFORMW 「%CSTR:일인칭%의 처음은 마음에 들었어？？」
		ELSEIF TALENT:음란 || TALENT:창부
			PRINTFORMW 「%CSTR:일인칭%의 처녀보○는 마음에 들었나요？」
		ELSEIF TALENT:복종 || TALENT:예속
			WSTR:(K++) = 
		ELSE
			;屈服刻印Lv3
			IF MARK:2 == 3
				PRINTFORMW 「%이인칭은% %일인칭을% 더럽혀야 속이 후련한가…」
				PRINTFORMW 「아니、이것도 %CSTR:일인칭%의 힘이 모자라기 때문일까…」
			ELSE
				PRINTFORMW 「큿…%CSTR:일인칭%의 순결을 이런 식으로 잃을줄은… 믿을 수 없군…」
				PRINTFORMW 「허나、이런 일로 굴복할 수는 없다…！」
			ENDIF
		ENDIF
	;それ以外の時に処女喪失(主人による道具系調教含む)
	ELSE
		;陥落素質チェック
		IF TALENT:연모 || TALENT:친애
			WSTR:(K++) =
		ELSEIF TALENT:음란 || TALENT:창부
			WSTR:(K++) =
		ELSEIF TALENT:복종 || TALENT:예속
			WSTR:(K++) =
		ELSE
			;屈服刻印Lv3
			IF MARK:2 == 3
				PRINTFORMW 「%이인칭은% %일인칭을% 더럽혀야 속이 후련한가…」
				PRINTFORMW 「아니、이것도 %CSTR:일인칭%의 힘이 모자라기 때문일까…」
			ELSE
				PRINTFORMW 「큿…%CSTR:일인칭%의 순결을 이런 식으로 잃을줄은… 믿을 수 없군…」
				PRINTFORMW 「허나、이런 일로 굴복할 수는 없다…！」
			ENDIF
		ENDIF
	ENDIF
	;TODO:006:残りの口上がどのパターンの時に呼ばれるべきなのかわからなかったので一旦凍結
	;IF TFLAG:20
	;;それ以外の時に処女喪失
	;ELSE
	;	;淫乱か娼婦
	;	IF TALENT:4 || TALENT:7
	;	;助手で処女喪失
	;	ELSEIF ASSIPLAY
	;		;養子
	;		IF CFLAG:ASSI:딸의양부모고유번호딸 == CFLAG:TARGET:캐릭터고유번호
	;			IF FAVORITE_1(TARGET) == ASSI
	;				PRINTFORMW 「どうだ%CALLNAME:ASSI%？%CSTR:일인칭%の初めては｣
	;			ELSE
	;				PRINTFORMW 「まさか初めての相手が%CALLNAME:ASSI%になるとは思わなかったな」
	;			ENDIF
	;		;その他
	;		ELSE
	;			IF FAVORITE_1(TARGET) == ASSI
	;				PRINTFORMW 「%CSTR:일인칭%の初めての相手が%CALLNAME:ASSI%でよかった」
	;			ELSE
	;				PRINTFORMW 「%CALLNAME:ASSI%に%CSTR:일인칭%の初めて…奪われて…しまった……」
	;			ENDIF
	;		ENDIF
	;	;主人で処女喪失
	;	ELSE
	;		;服従か隷属
	;		IF TALENT:5 || TALENT:8
	;			PRINTFORML 
	;		;屈服刻印Lv3
	;		ELSEIF MARK:2 == 3
	;		;それ以外
	;		ELSE
	;		ENDIF
	;	ENDIF
	;ENDIF
	;---006 EDIT END---
ENDIF


;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_D関係（X1をキャラ番号に置換）
;パラメータ変化をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_D_K[[キャラ:비사문천]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_D
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_D_PY1_K[[キャラ:비사문천]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_D_PY1_K[[キャラ:비사문천]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;パラメータ変化時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;初めて潤滑がLV3超えた
;-------------------------------------------------
P = PALAM:4 + UP:4
IF P > PALAMLV:4 && CFLAG:250 == 0
	CALL PALAM_MESSAGE_D
	;로션을 사용한 경우
	IF SELECTCOM == 180
		PRINTFORMW 「뭐야 이건？차갑고…끈적끈적 거리고 있어…」
		PRINTFORMW 「힛…、그런 곳에 바르지 마라…」
	;그 이외
	ELSE
		PRINTFORMW %CALLNAME%의 비소에서 끈적한 액체가 쏟아졌다。그걸 지적하자、눈을 꼭 감고 얼굴을 돌려버렸다
		PRINTFORMW 「아、읏…그런…、거짓말이다……」
		PRINTFORMW （느끼고 있는건가…%CSTR:일인칭%…）
	ENDIF
	CFLAG:250 = 1
ENDIF

;-------------------------------------------------
;初めて欲情がLV2超えた
;-------------------------------------------------
P = PALAM:6 + UP:6
IF P > PALAMLV:3 && CFLAG:251 == 0
	CALL PALAM_MESSAGE_D
	;미약을 사용한 경우
	IF SELECTCOM == 181
		PRINTFORMW 
	;그 이외
	ELSE
		PRINTFORMW %CALLNAME은% 약간 땀이 베어있고、그 하얀 피부에 붉은 빛이 돌며 약간의 열이 났다。
		PRINTFORMW 「우……、크……、후、후읏……」
		PRINTFORMW （큿、%CSTR:일인칭%의 몸은 어떻게 되는거냐…！？　정말로 싫은데、기분 나쁠텐데 기분 좋아…）
		PRINTFORMW （아니、그럴 리가 없다！　기분 좋을 리가 없다！）
	ENDIF
	CFLAG:251 = 1
ENDIF

;-------------------------------------------------
;初めて屈服がLV3超えた
;-------------------------------------------------
P = PALAM:7 + UP:7
IF P > PALAMLV:3 && CFLAG:252 == 0
	CALL PALAM_MESSAGE_D
	PRINTFORMW 
	CFLAG:252 = 1
ENDIF

;-------------------------------------------------
;初めて恭順がLV3超えた
;-------------------------------------------------
P = PALAM:5 + UP:5
IF P > PALAMLV:3 && CFLAG:253 == 0
	CALL PALAM_MESSAGE_D
	;함락완료
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		PRINTFORMW 
	;그 이외
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:253 = 1
ENDIF

;-------------------------------------------------
;初めて恐怖がLV3超えた
;-------------------------------------------------
P = PALAM:11 + UP:11
IF P > PALAMLV:3 && CFLAG:254 == 0
	CALL PALAM_MESSAGE_D
	;함락완료
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		PRINTFORMW 
	;그 이외
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:254 = 1
ENDIF

;-------------------------------------------------
;快Cが9000を超えた
;-------------------------------------------------
IF (PALAM:0 + UP:0) >= 8500
	;함락완료
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		;연모, 친애
		IF TALENT:3 || TALENT:6
			PRINTFORMW %CALLNAME은% 몰려오는 쾌감을 견디는듯、참는 듯한 얼굴을 하고 있다
			PRINTFORMW 「아아아앗…、가버렷…、%CSTR:이인칭%에게 만져져서、상스럽게 가버려…」
		;음란, 창부
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORMW %CALLNAME은% 몰려오는 쾌감을 견디는듯、참는 듯한 얼굴을 하고 있다
			PRINTFORMW 「아아아앗…、가버렷…、%CSTR:이인칭%에게 만져져서、상스럽게 가버립니다아…。」
		;복종, 예속
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 
		ENDIF
	;그 이외
	ELSE
		PRINTFORMW （어째서냐…、서머너에게 그곳을 만져지면、기분 좋아져버려…）
	ENDIF
ENDIF

;-------------------------------------------------
;快Vが9000を超えた
;-------------------------------------------------
IF (PALAM:1 + UP:1) >= 8500
	;함락완료
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
	;그 이외
	ELSE
		PRINTFORMW （큭…기분、좋아…）
	ENDIF
ENDIF

;-------------------------------------------------
;快Aが9000を超えた
;-------------------------------------------------
IF (PALAM:2 + UP:2) >= 8500
	;함락완료
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
	;그 이외
	ELSE
		PRINTFORMW （거짓말…、엉덩이 구멍으로 느끼는 일 따위、있을 리가 없을텐데…）
	ENDIF
ENDIF
;-------------------------------------------------
;@KOJO_MESSAGE_MARKCNG関係（X1をキャラ番号に置換）
;刻印変動をトリガーにした口上
;刻印変動後に口上を発動します
;-------------------------------------------------
@KOJO_MESSAGE_MARKCNG_K[[キャラ:비사문천]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL MARK_MESSAGE
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_MARKCNG_PY1_K[[キャラ:비사문천]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_MARKCNG_PY1_K[[キャラ:비사문천]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;苦痛刻印Lv3
;-------------------------------------------------
IF TFLAG:22 == 3
	CALL MARK_MESSAGE_A
	;연모, 친애
	IF TALENT:3 || TALENT:6
		PRINTFORMW 「아팟、%CSTR:이인칭%、%CSTR:일인칭%에게 무슨 원한이라도 있는건가？」
	;음란, 창부
	ELSEIF TALENT:4 || TALENT:7
		PRINTFORMW 「이런게 기분 좋아지거나 하는 건가？」
	;복종, 예속
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORMW 
	ELSE
		PRINTFORMW 「아픔 따위에 %일인칭을% 따른다고 생각한다면 잘못 생각한거다 %CSTR:이인칭%」
	ENDIF
ENDIF

;-------------------------------------------------
;快楽刻印Lv3
;-------------------------------------------------
IF TFLAG:23 == 3
	CALL MARK_MESSAGE_P
	;연모, 친애
	IF TALENT:3 || TALENT:6
		PRINTFORMW 「%CSTR:이인칭%의 손으로 더、좀 더 기분 좋게 해주세요」
	;복종, 예속
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORMW 
	ELSE
		PRINTFORMW 「안돼…、기분…좋아…」
	ENDIF
ENDIF

;-------------------------------------------------
;屈服刻印Lv3
;-------------------------------------------------
IF TFLAG:24 == 13 || TFLAG:24 == 23 || TFLAG:24 == 33
	CALL MARK_MESSAGE_S
	;쾌락에 의한 굴복
	IF TFLAG:24 == 13
		PRINTFORMW （안돼…더는 돌이킬 수 없어…기분 좋은거 벗어날 수 없어）
	;공포와 고통에 의한 굴복
	ELSEIF TFLAG:24 == 23
		PRINTFORMW (거스를 수 없어…%이인칭이% 무서워…)
	;굴복과 복종에 의한 굴복
	ELSEIF TFLAG:24 == 33
		PRINTFORMW (%이인칭과% 이렇게 하는것도…좋으려나…)
	ENDIF
ENDIF

;-------------------------------------------------
;反発刻印Lv3
;-------------------------------------------------
IF TFLAG:21 == 3
	CALL MARK_MESSAGE_R
	;함락완료
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		;연모, 친애
		IF TALENT:3 || TALENT:6
			PRINTFORMW 「%CSTR:이인칭% 이렇게 하면 %CSTR:일인칭%도 화낼거다」
		;음란, 창부
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORMW 「이렇게 하는건 싫어질것 같다」
		;복종, 예속
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 
		ENDIF
	ELSE
		PRINTFORMW 「%일인칭을% 화나게 만들려고 작정했군」
	ENDIF
ENDIF

;-------------------------------------------------
;イベント口上集（X1をキャラ番号に置換する） CFLAG 261～299を使用
;-------------------------------------------------
@KOJO_MESSAGE_EVENT_K[[キャラ:비사문천]]
#DIM FATHER, 1

;--------------------------------------------------
;特定主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_EVENT_PY1_K[[キャラ:비사문천]]
;	RETURN 0
;ENDIF
SELECTCASE TFLAG:13
		;-------------------------------------------------
		;아침펠라
		;-------------------------------------------------
	CASE 1
			CALL EVENT_MESSAGE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:261 < 1 || FLAG:7 == 2)
				;연모, 친애
				IF TALENT:3 || TALENT:6
					CSTR:100 = 응…♪、아침인데도 굉장히 딱딱해♪
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					CSTR:100 = 응…♪、기분 좋습니까 %CSTR:이인칭%♪
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 「오늘 아침은 %일인칭이%、곁에 있겠습니다」
				ENDIF
			CFLAG:808 = 810;フェラ
			CALL PRINT_AA_ビシャモンテン
			CFLAG:261 = 1
			ENDIF

		;-------------------------------------------------
		;아침파이즈리
		;-------------------------------------------------
	CASE 2
			CALL EVENT_MESSAGE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:262 < 1 || FLAG:7 == 2)
				;연모, 친애
				IF TALENT:3 || TALENT:6
					CSTR:100 = 후훗…、기분 좋아져서♪ 잔뜩 내주게♪
				;음란, 창부
				ELSEIF TALENT:4 || TALENT:7
					CSTR:100 = 후훗…、%CSTR:이인칭%기분 좋아져서♪
					CSTR:101 = 잔뜩 내주세요♪
				;복종, 예속
				ELSEIF TALENT:5 || TALENT:8
					CSTR:100 = 이 %일인칭이% 처리해두겠으니、
					CSTR:101 = 편히 주무십시요
				ENDIF
				CFLAG:808 = 820;パイズリ
				CALL PRINT_AA_ビシャモンテン
				;모유체질인지 아닌지
				SIF TALENT:149
					PRINTFORMW 「앗、젖이 나와버려요%UNICODE(0x2665)%」
				CFLAG:262 = 1
			ENDIF

		;-------------------------------------------------
		;아침기승위
		;-------------------------------------------------
