					CSTR:100 = 그앗…　그만둬…！　몸이 망가져벼러…！
				ENDIF
				CFLAG:808 = 692;背面座位（正面）
				CALL PRINT_AA_ビシャモンテン
			ENDIF
			CFLAG:341 = 1
		;2번째 이후
		ELSE
			;함락완료
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:341 < 4 || FLAG:7 == 2)
				;普通に緊縛されている場合
				IF TEQUIP:37 == 1
					CSTR:100 = 아힛%UNICODE(0x2665)%　밧줄이 파고 들어서、
					CSTR:101 = 안쪽에서 조이고 있어%UNICODE(0x2665)%
