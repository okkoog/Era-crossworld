				CSTR:100 = 응큿！？、응～～%UNICODE(0x2665)%
				CFLAG:808 = 1400;イラマチオ
				CALL PRINT_AA_ビシャモンテン
				CFLAG:369 = 4
			;굴복각인Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:369 < 3 || FLAG:7 == 2)
				CSTR:100 = 응큿！？、응～～！！
				CFLAG:808 = 1400;イラマチオ
				CALL PRINT_AA_ビシャモンテン
				CFLAG:369 = 3
			;그 이외
