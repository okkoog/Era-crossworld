;=================================================
;触手系コマンド
;=================================================
;-------------------------------------------------
;160,촉수소환
;-------------------------------------------------
	CASE 160
		IF TEQUIP:25
			SETCOLOR 0, 0, 0
			CALL TRAIN_MESSAGE
			;처음
			IF CFLAG:382 == 0
				PRINTFORMW 「뭐냐！？이 생물은」
				PRINTFORMW 「앗、잠깐 그만둬、달라붙지 마라」
				CFLAG:382 = 1
			;2번째 이후
			ELSE
				;함락완료
				IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:382 < 4 || FLAG:7 == 2)
					;触手経験高い
					IF EXP:TARGET:촉수경험 >= 1000
						;연모, 친애
						IF TALENT:3 || TALENT:6
							CSTR:100 = %CSTR:이인칭%도 같이 하겠나？
							CSTR:101 = 익숙해지면 꽤 괜찮다고♪
						;음란, 창부
						ELSEIF TALENT:4 || TALENT:7
							CSTR:100 = 아항……와주세요♪
							CSTR:101 = 그 미끈거리는 걸로 %일인칭을% 기분 좋게 해주세요♪
						;복종, 예속
						ELSEIF TALENT:5 || TALENT:8
							CSTR:100 = 네…원하시는대로…
						ENDIF
					;触手経験低い
					ELSE
						;연모, 친애
						IF TALENT:3 || TALENT:6
							CSTR:100 = 그、그만해주게…이 녀석의 상대만은…
							CSTR:101 = 싫단 말이다…
						;음란, 창부
						ELSEIF TALENT:4 || TALENT:7
							CSTR:100 = %CSTR:이인칭%、도와주세요…녀석의 상대만은…
							CSTR:101 = 싫습니다
						;복종, 예속
						ELSEIF TALENT:5 || TALENT:8
							CSTR:100 = 힛…
						ENDIF
					ENDIF
					CFLAG:808 = 1600;触手召喚
					CALL PRINT_AA_ビシャモンテン
					CFLAG:382 = 4
				;굴복각인Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:382 < 3 || FLAG:7 == 2)
					;触手経験高い
					IF EXP:TARGET:촉수경험 == 1000
						CSTR:100 = 빨리、와주게
						CSTR:101 = 더는…기다릴 수 없네
						CFLAG:808 = 1600;触手召喚
						CALL PRINT_AA_ビシャモンテン
					;그 이외
					ELSE
						CSTR:100 = 또、부른건가
						CSTR:101 = 아직、마음의 준비가
						CFLAG:808 = 1600;触手召喚
						CALL PRINT_AA_ビシャモンテン
					ENDIF
					CFLAG:382 = 3
				;그 이외
				ELSEIF CFLAG:382 < 2 || FLAG:7 == 2
					;触手経験高い
					IF EXP:TARGET:촉수경험 == 1000
						CSTR:100 = 이 녀석도 싫지 않게 됐다
						;-KR- 임의수정、100 > 101
						CSTR:101 = 자、와주게。이미 준비는 끝나있다
						CFLAG:808 = 1600;触手召喚
						CALL PRINT_AA_ビシャモンテン
					;그 이외
					ELSE
						CSTR:100 = 또、이 녀석의 상대인가…
						CSTR:101 = 싫엇、오지마、오지마!
						CFLAG:808 = 1600;触手召喚
						CALL PRINT_AA_ビシャモンテン
					ENDIF
					CFLAG:382 = 2
				ENDIF
			ENDIF
		ELSE
			IF CFLAG:382 == 1 || FLAG:7 == 2
				CALL TRAIN_MESSAGE
				;触手経験高い
				IF EXP:TARGET:촉수경험 == 1000
					PRINTFORMW 「이제 끝인건가？」
					PRINTFORMW 「다음이 기다려진다」
				;그 이외
				ELSE
					PRINTFORMW 「겨우 끝난건가」
					PRINTFORMW 「이제、이런 일은 그만해주게」
				ENDIF
			ENDIF
		ENDIF

;-------------------------------------------------
;161,촉수삽입
;-------------------------------------------------
	CASE 161
		CALL TRAIN_MESSAGE
		CFLAG:808 = 1610
		CALL PRINT_AA_ビシャモンテン
		;처음
		IF CFLAG:383 == 0
			;처녀
			IF TALENT:0
					;触手経験高い
				IF EXP:TARGET:촉수경험 == 1000
					PRINTFORMW 「%CSTR:일인칭%에게 넣고 싶은건가？그래、와주게」
					PRINTFORMW 「아팟、억지로 넣는…녀석이이었네…좀 더……상냥하게…해주게」
				ELSE
					PRINTFORMW 「설마、그만둿 거기만은 그만두게」
					PRINTFORMW 「아팟、아아…첫 상대가 이딴거라니」
				ENDIF
			ELSE
				;触手経験高い
				IF EXP:TARGET:촉수경험 == 1000
					PRINTFORMW 「%CSTR:일인칭%에게 넣고 싶은건가？그래、와주게」
					PRINTFORMW 「읏…%UNICODE(0x2665)%질 안에서…움직여…」
				ELSE
					PRINTFORMW 「설마、그만둿 거기만은 그만두게」
					PRINTFORMW 「싫엇、빨리、빨리 빼란 말이다」
				ENDIF
			ENDIF
			CFLAG:383 = 1
		;2번째 이후
		ELSE
		;触手経験高い
			IF EXP:TARGET:촉수경험 == 1000
				CSTR:100 = %CSTR:일인칭%에게 넣고 싶은건가？그래、와주게
				CSTR:101 = 읏…%UNICODE(0x2665)%질 안에서…움직여…
			ELSE
				CSTR:100 = 설마、그만둿 거기만은 그만두게
				CSTR:101 = 싫엇、빨리、빨리 빼란 말이다
