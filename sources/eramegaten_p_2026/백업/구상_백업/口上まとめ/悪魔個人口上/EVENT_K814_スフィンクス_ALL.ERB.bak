@ENEMY_BATTLE_EVENT_K[[キャラ:스핑크스]], ARG, ARG:1, ARG:2
IF TFLAG:전투이벤트 == 1
;敵でのデビルＣＯ－ＯＰ発動時の台詞
;			PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"",72,LEFT%┃
;			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF
IF TFLAG:전투이벤트 == 2
;敵でのデビルＣＯ－ＯＰ参加時の台詞
;			PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"",72,LEFT%┃
;			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

@KOJO_BATTLE_EVENT_K[[キャラ:스핑크스]], ARG, ARG:1, ARG:2
IF TFLAG:전투이벤트 == 1
;味方パーティでのデビルＣＯ－ＯＰ発動時の台詞
		IF RAND:2 == 0
			PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"Now get the chance!",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ELSE
			PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"스핑크스",72,LEFT%┃
			PRINTFORML ┃%"",72,LEFT%┃
			PRINTFORML ┃%"스핑크스" + CALLNAME:PLAYER + "스핑크스",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ENDIF
ENDIF
IF TFLAG:전투이벤트 == 2
;味方パーティでのデビルＣＯ－ＯＰ参加時の台詞
			PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"스핑크스",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

IF TFLAG:전투이벤트 == 3
;味方パーティでの被召喚時の台詞	
;			PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"",72,LEFT%┃
;			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;戦闘開始時
IF TFLAG:전투이벤트 == 94 || TFLAG:전투이벤트 == 95 || TFLAG:전투이벤트 == 96
	;カジャオート系スキル
	IF CFLAG:(ARG:1):상태이상 != GET_STATE_NUM("DYING") && (HAVE_SKILL(ARG,2414) || HAVE_SKILL(ARG,2415) || HAVE_SKILL(ARG,2416) || HAVE_SKILL(ARG,2417) || HAVE_SKILL(ARG,2444))&& CFLAG:(FLAG:(ARG:5)):공격강화 < 1
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"스핑크스",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF
ENDIF

;攻撃を外した
IF TFLAG:전투이벤트 == 17
			PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"스핑크스",72,LEFT%┃
			PRINTFORML ┃%"스핑크스",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;沈黙喰らった時
SELECTCASE GET_STATE(LOCAL:1)
	CASE "CLOSE"
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"스핑크스",72,LEFT%┃
		PRINTFORML ┃%"" + NAME:ARG + "스핑크스",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDSELECT


;--------------------------------------------------
;スキル使用時
;--------------------------------------------------
@KOJO_BATTLE_MESSAGE_K[[キャラ:스핑크스]],ARG,ARG:1 = 0
;通常攻撃
IF CFLAG:ARG:입력행동 == 0 || CFLAG:ARG:입력행동 == 2101
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"스핑크스",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

;剣撃スキル（途中にガードキルとかが入っているのでそこを除外。系列スキルが増える可能性があるのでIF文に余裕を持たせておく）
ELSEIF (CFLAG:ARG:입력행동 >= 5 && CFLAG:ARG:입력행동 <= 29) || (CFLAG:ARG:입력행동 >= 37 && CFLAG:ARG:입력행동 <= 73)
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"十六分割！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

;核熱系スキル（途中にガードキルとかが入っているのでそこを除外。系列スキルが増える可能性があるのでIF文に余裕を持たせておく）
ELSEIF (CFLAG:ARG:입력행동 >= 1901 && CFLAG:ARG:입력행동 <= 1930) || (CFLAG:ARG:입력행동 >= 1937 && CFLAG:ARG:입력행동 <= 1999) && ENEMY_COUNT() == 5
	IF ENEMY_COUNT() == 5
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"스핑크스",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF
;火炎系スキル（途中にガードキルとかが入っているのでそこを除外。系列スキルが増える可能性があるのでIF文に余裕を持たせておく）
ELSEIF (CFLAG:ARG:입력행동 >= 701 && CFLAG:ARG:입력행동 <= 731) || (CFLAG:ARG:입력행동 >= 733 && CFLAG:ARG:입력행동 <= 763)
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"스핑크스",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

;カジャ系スキル
ELSEIF (CFLAG:ARG:입력행동 >= 501 && CFLAG:ARG:입력행동 <= 504) 
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"스핑크스",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
;複数個所が上がるカジャ系スキル
ELSEIF CFLAG:ARG:입력행동 == 524 || CFLAG:ARG:입력행동 == 525 || CFLAG:ARG:입력행동 == 530 || CFLAG:ARG:입력행동 == 537 || CFLAG:ARG:입력행동 == 539 || CFLAG:ARG:입력행동 == 555 || CFLAG:ARG:입력행동 == 559
		PRINTFORML ┏┓＠%NAME:ARG,20,LEFT%　┏━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"스핑크스",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
;ヘッドセットメッセージ
;＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
;=========================================
;戦闘口上の雛形。[キャラナンバー]と[キャラ名]を置換して使用。　一応ライセンスフリー。
;京都じゃない方の双葉はんから拝借した純那ちゃん（kame先生作）から更に拝借して雛形を作ったものから
;摩多羅神ヘッドセット口上を作る過程で欲しい物を入れて……悪魔はヘッドセットを持てなかった（白目）ため原形に戻したもの。
;じゅんなちゃんのエーギルをもらうよ。ん？　そうすればいっぱいヘッドセット口上作れるからね。 Schrott
;=========================================
@BATTLE_NAVI_K[[キャラ:스핑크스]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5, ARG:6, ARG:7, ARG:8
SETCOLOR 0xd8d800
LOCALS = {ARG:1}
LOCALS:1 = {FLAG:경과턴수}

;戦闘開始・バックアタック
IF ARG == 4
	IF RAND:2 == 0
		PRINTFORML ┏>>MESSAGE 　　━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"스핑크스",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF
ENDIF
