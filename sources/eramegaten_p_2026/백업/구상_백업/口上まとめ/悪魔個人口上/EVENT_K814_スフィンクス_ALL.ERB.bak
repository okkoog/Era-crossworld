;-------------------------------------------------
;輪姦時の口上
;CASE 0 内必通읏
;RETURNで0を返すと、この後通常の輪姦行動を出します
;CFLAGは使っていません
;COMF201_輪姦内でLOCALを使っているので使いません
;-------------------------------------------------
@KOJO_MESSAGE_RINKAN_K[[キャラ:스핑크스]], ARG:1 , ARG:2
#DIM GYOU

FOR GYOU,0,51
	LOCALS:GYOU = 
NEXT

SELECTCASE ARG:1
	CASE 0
	;CASE 0輪姦口上
	;C:一回あたりの帰宅人数、D：興奮度増加(及び減少)
	;CとDはオリジナル輪姦口上内のみ使う
	;C += 、D += を使う
		IF ARG:2 == 1
		;ハードON
		
		ELSE
		;ハードOFF
		
		ENDIF
	;ハード系
	;胸を踏まれる（巨乳・爆乳のみ）
	CASE 1				
		IF 陥落() && (CFLAG:221 < 3 || FLAG:7 == 2)		
			;恋慕、親愛	
			IF 陥落() > 0 && RESULTS == "연모"	
				LOCALS:0 = 
			;淫乱、娼婦	
			ELSEIF 陥落() > 0 && RESULTS == "음란"	
				LOCALS:0 = 
			;服従、隷属	
			ELSEIF 陥落() > 0 && RESULTS == "복종"	
				LOCALS:0 = 
			ENDIF
			;陥落済み共通	
			IF LOCALS:0 == ""
				LOCALS:0 = 
			ENDIF
		ENDIF	
		;屈服刻印Lv3		
		IF MARK:2 == 3 && (CFLAG:221 < 2 || FLAG:7 == 2) && LOCALS:0 == ""	
			LOCALS:0 = 	
		ENDIF	
		;それ以外		
		IF (CFLAG:221 < 1 || FLAG:7 == 2) && LOCALS:0 == ""	
			PRINTFORML 
		ENDIF	
	;頭を踏まれる
	CASE 2
	
	;暴力を振るわれる
	CASE 3
	
	;タバコの根性焼き
	;興奮度が低く、反抗的、気丈、プライド高い、生意気、抵抗を持っている
	CASE 4
	
	;地面に垂れた精液舐めとらせる
	;マゾっ気３以上
	CASE 5
	
	;体に落書きをされて犯される
	CASE 6
	
	;尻突き上げてバックから犯されつつ、頭を踏んづけられて屈辱で涙目状態
	CASE 7
	
	;通常系
	;淫乱系で目の前に棒並べられて、どれが欲しいか選ばせるとか（淫乱・娼婦のみ）
	CASE 8
	
	;巨乳以上のキャラだと「その乳は飾りか？遊ばせてるんじゃねえ」とか罵られパイズリする（巨乳・爆乳のみ）
	CASE 9
	
	;挿れられるのだけは回避しようと必死に口と手で群がるチンポにご奉仕する（恋幕・親愛のみ）
	CASE 10
	
	;;両穴突かれながら無理やり笑顔とピースサインとらされて記念撮影
	CASE 11
	
	;;輸姦後の後始末描写で、本人精液でどろどろにされてるのに周囲の男達の肉棒を舌で掃除させられてる
	CASE 12
	
	;中に出されても即座にほかの人に交代
	CASE 13
	
	;一斉射精で精液まみれ
	CASE 14
	
	;;両穴突かれて同時射精
	CASE 15
	
	;기승위+両脇コキ
	CASE 16
	
	;;입+マンコ
	CASE 17
	
ENDSELECT

