;-------------------------------------------------
;スフィンクス口上（キャラクターの名前を入れる、下にコンセプトなど一言あれば入れる）
;ネタ口上です。
;王国屋でもらった場合のみ追加イベントがあります
;　そのために
;　　日数管理		CFLAG:800
;　　進行フラグ		CFLAG:801
;　を使用しています
;
;-------------------------------------------------

;-------------------------------------------------
;eraMegaten専用口上テンプレート
;X1とX2をキャラ番号に置換し、Y1を助手のキャラ番号に置換してください
;ただし、キャラ番号が一桁のキャラの場合、X1,Y1は1、X2は01のように変えてください
;内適当条件下PRINTFORMW後半角─置追加
;口上を追加しないコマンドは無記入でも構いませんが、CFLAG:XXXの頭に『;』をつけてコメントアウトすると尚良いでしょう
;エキストラ構文など、コメントアウトされている構文を使う際には、『;』を外してコメントアウトを解除する必要があります
;最後にread meにも目を通しておくことをお勧めします
;-------------------------------------------------

;-------------------------------------------------
;汎用口上の作成に使用する場合は、X1→キャラ番号ではなく、
;K[[キャラ:스핑크스]]→PUB会話タイプ番号　へと変換してご使用ください
;-------------------------------------------------
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;
;	Module		:EVENT_K[[キャラ:스핑크스]]_ASSI.ERB
;	Facility	:会話タイプ：助手時口上
;
;	Modification Data:
;	Edit	Date			Author					Reason
;	001		2021/04/01		名無し					新規作成
;	002		2021/06/05		名無し					バグ修正
;	003		2021/12/316		名無し					バグ修正
;	004		2022/11/04		kuuzya					PLAYERの童貞判定を修正
;	005		2023/05/20		P						戦闘口上を顔グラ対応に変更
;	006		2023/09/06		絹延					処女喪失処理修正　TFLAG:20が恋慕系陥落を保証しなくなった修正の対応。
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;ライセンスについて
;	・基本項目(許可する項目を"○"に、許可しない項目を"×"に変更してください。)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1| ○ | 処理上のバグ修正              |
;	+----+----+-------------------------------+
;	|   2| ○ | 口上の誤字・脱字の修正        |
;	+----+----+-------------------------------+
;	|   3| ○ | 口上まとめへの収録            |
;	+----+----+-------------------------------+
;	|   4| ○ | 口上の新規追加                |
;	+----+----+-------------------------------+
;	|   5| ○ | 既存口上の改変                |
;	+----+----+-------------------------------+
;	|   6| ○ | 改変した口上の自由な再配布    |
;	+----+----+-------------------------------+
;	|   7| ○ | 口上内容の転載                |
;	+----+----+-------------------------------+

;--------------------------------------------------
;口上セレクト機能：口上説明
;--------------------------------------------------
;この関数のコメントアウトを外すと、口上の選択時に選択肢として候補にあがります
;既に口上のあるキャラや会話タイプの別版の口上を作成する時に利用してください
;その際、この関数を含めたこのファイル内の関数名すべてに_任意の1-49(汎用口上なら1-9)の数字を加えてください
;例： EVENTTRAIN_K[[キャラ:스핑크스]] → EVENTTRAIN_K[[キャラ:스핑크스]]_12
;--------------------------------------------------
@セレクト口上説明_K[[キャラ:스핑크스]],ARG = 0
SIF ARG == 1
	RETURN 0
;口上名
PRINTFORML 스핑크스 구상 Q
;口上説明文
PRINTFORML    대사는 전부 개그

;--------------------------------------------------
;EVENTTRAIN関係（X1をキャラ番号に置換）
;調教開始時のセリフ CFLAG 201～219を使用
;--------------------------------------------------
@EVENTTRAIN_K[[キャラ:스핑크스]]
;--------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;--------------------------------------------------
;IF CFLAG:220 == 0
;	PRINTL 処女─移行？
;	PRINTL [0] 
;	PRINTL [1] 
;	$INPUT_LOOP
;	INPUT
;	IF RESULT == 0
;		PRINTFORMW ―処女─素質、能力変更―
;		TALENT:TARGET:0 = 1
;		ABL:TARGET:4 = 0
;		EXP:TARGET:0 = 0
;	ELSEIF RESULT == 1
;		PRINTFORMW ―通常─調教開始―
;	ELSE
;		GOTO INPUT_LOOP
;	ENDIF
;	CFLAG:220 = 1
;ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL EVENTTRAIN_PY1_K[[キャラ:스핑크스]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL EVENTTRAIN_PY1_K[[キャラ:스핑크스]]
;		RETURN 0
;	ENDIF
;ENDIF
;--------------------------------------------------
;簡易助手口上の発動時に初調教時口上をスキップ（Y1を助手のキャラ番号にする）
;複数人いる際には、SIF NO:ASSI == Y1 || NO:ASSI == Z1と追加していく
;--------------------------------------------------
;IF CFLAG:201 == 0 && ASSI > 0
;	SIF NO:ASSI == Y1
;		CFLAG:201 =1
;ENDIF

;-------------------------------------------------
;フラグ初期化処理
;-------------------------------------------------
DRAWLINE
;クイズに回答していない場合 && 以前の調教から日が変わっている場合、回答フラグをクリアする
IF CFLAG:801 < 3 && CFLAG:800 < DAY
	CFLAG:801 = 0
ENDIF


;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
;初調教時
IF CFLAG:201 == 0
	IF CFLAG:이벤트가입 == 1
		;調教せずに恋慕をつけた場合
		IF TALENT:연모 == 1 && CFLAG:미조교함락 == 1
			PRINTFORMW 「저기…… 처음을 시작하기 전에……」
			PRINTFORMW 사랑의 속삭임일까?
			PRINTFORML 
			PRINTFORMW 「朝4本足、昼2本足、夜3本足。何？」
			PRINTFORML ……
			PRINTFORML …
			PRINTFORMW 問。古典的。
			PRINTFORMW 「？」
			PRINTFORML ……
			PRINTFORML …
			PRINTFORMW 答面白。別方法答
			PRINTFORMW %CALLNAME%
		ELSE
			PRINTFORMW 「問」
			PRINTFORMW 「朝4本足、昼2本足、夜3本足。何」
			PRINTFORML ……
			PRINTFORML …
			PRINTFORMW 問。
			PRINTFORMW 古典的問答。
			PRINTFORML ……
			PRINTFORML …
			PRINTFORMW 身体教
			PRINTFORMW %CALLNAME%
		ENDIF
	ELSE

	ENDIF
	CFLAG:201 = 1
	RETURN 0
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	PRINTFORMW 
	CFLAG:201 = 2
	RETURN 0
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	PRINTFORMW 
	CFLAG:201 = 3
	RETURN 0
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW 
	CFLAG:201 = 4
	RETURN 0
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		PRINTFORMW 
	;음란
	ELSEIF TALENT:4
		PRINTFORMW 「"스핑크스"申」
		PRINTFORMW 「性知識持人生楽」
	;복종
	ELSEIF TALENT:5
		IF EXP:PLAYER:삽입경험 == 0
			PRINTFORML 「%CSTR:이인칭%童貞읏」
			PRINTFORMW 「今失礼」
			PRINTFORML  
			PRINTFORMW 「……」
			PRINTFORMW 「１００目指頑張♪」
			PRINTFORMW 「僭越初１目」
			IF TALENT:처녀
				PRINTFORMW 「%CSTR:일인칭%─、？」
			ELSE
				PRINTFORMW 「%CSTR:일인칭%？」
			ENDIF
		ENDIF
	ENDIF
	CFLAG:201 = 5
	RETURN 0
ENDIF

;-------------------------------------------------
;簡易助手口上（Y1を助手のキャラ番号に置換、X1をキャラ番号に変更する) CFLAG203
;掛け合いをするキャラを増やす場合は、構文をコピー＆ペーストをして、CFLAGの数を204、205と増やす
;-------------------------------------------------
;助手の有無をチェック（いない場合は二回目以降へ飛ぶ）
IF ASSI < 0 
	CALL EVENTTRAIN_SECOND_K[[キャラ:스핑크스]]
;助手
;ELSEIF NO:ASSI == Y1
	;初めて
;	IF CFLAG:203 == 0
		;陥落済み＋陥落時初口上が発生済み
;		IF 陥落() && CFLAG:201 >= 5
;			PRINTFORMW 
		;それ以外
;		ELSE
;			PRINTFORMW 
;		ENDIF
;		CFLAG:203 = 1
	;二回目以降
;	ELSEIF CFLAG:203 < 2 || FLAG:7 ==2
		;陥落済み
;		IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
;			PRINTFORMW 
		;それ以外
;		ELSE
;			PRINTFORMW 
;		ENDIF
;		CFLAG:203 = 2
;	ENDIF
;口上のある助手が居ない場合は、通常の二回目以降の口上へ飛ぶ
ELSE
	CALL EVENTTRAIN_SECOND_K[[キャラ:스핑크스]]
ENDIF

;-------------------------------------------------
;調教開始時（2回目以降、X1をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_K[[キャラ:스핑크스]]
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORML 
	CFLAG:202 = 4
;屈服刻印Lv0
ELSEIF MARK:2 == 0 && (CFLAG:202 < 1 || FLAG:7 == 2)
	PRINTFORML 
	CFLAG:202 = 1
;屈服刻印Lv1
ELSEIF MARK:2 == 1 && (CFLAG:202 < 2 || FLAG:7 == 2)
	PRINTFORML 
	CFLAG:202 = 2
;屈服刻印Lv2
ELSEIF MARK:2 == 2 && (CFLAG:202 < 3 || FLAG:7 == 2)
	PRINTFORML 
	CFLAG:202 = 3
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0) && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORML 
	CFLAG:202 = 4
;陥落済み
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		IF RAND:3 == 0
			LOCALS:0 = 
		ELSEIF RAND:2 == 0
			LOCALS:0 = 
		ELSE
			LOCALS:0 = 
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		PRINTFORMW 「─」
		PRINTFORMW  
		;ランダムで口上が変化する
		IF RAND:3 == 0
			PRINTFORMW 「Ｈ程硬%UNICODE(0x2661)%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「硬、大、飛%UNICODE(0x2661)%」
		ELSE
			PRINTFORMW 「中」
			PRINTFORMW 「４倍以上大部分%UNICODE(0x2661)%」
		ENDIF
		PRINTFORML ………
		PRINTFORML ……
		PRINTFORML ……
		PRINTFORMW 「時間切─」
		PRINTFORMW 「答─%UNICODE(0x2661)%」
		PRINTFORML 
		IF RAND:3 == 0
			PRINTFORMW 「正解읏"CALLNAME:MASTER"精液全部읏──%UNICODE(0x2661)%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「間違%CALLNAME:MASTER%服脱下%UNICODE(0x2661)%」
		ELSE
			PRINTFORMW 「不正解%CALLNAME:MASTER%生体MAG읏横取40%UNICODE(0x2661)%」
		ENDIF
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		IF RAND:3 == 0
			LOCALS:0 = 
		ELSEIF RAND:2 == 0
			LOCALS:0 = 
		ELSE
			LOCALS:0 = 
		ENDIF
	ENDIF
	;その他、共通
	IF LOCALS:0 == ""
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		IF RAND:3 == 0
			PRINTFORML 
		ELSEIF RAND:2 == 0
			PRINTFORML 
		ELSE
			PRINTFORML 
		ENDIF
	ENDIF
	CFLAG:202 = 5
ENDIF


;-------------------------------------------------
;EVENTEND関係（X1をキャラ番号に置換）
;調教終了時のセリフ
;-------------------------------------------------
@EVENTEND_K[[キャラ:스핑크스]]
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL EVENTEND_PY1_K[[キャラ:스핑크스]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	SIF NO:ASSI == Y1
;	CALL EVENTEND_PY1_K[[キャラ:스핑크스]]
;	RETURN 0
;ENDIF
;--------------------------------------------------
;調教終了時のセリフ
;--------------------------------------------------
DRAWLINE
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:217 < 1 || FLAG:7 == 2)
	PRINTFORMW 
	CFLAG:217 = 1
;屈服刻印Lv1以下
ELSEIF MARK:2 <= 1 && (CFLAG:219 < 1 || FLAG:7 == 2)
	PRINTFORMW 
	CFLAG:219 = 1
;屈服刻印Lv2
ELSEIF MARK:2 == 2
	PRINTFORMW 
	CFLAG:219 = 2
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW 
	CFLAG:219 = 3
;陥落済み＋体力500未満
ELSEIF BASE:0 < 500 && (CFLAG:218 < 1 || FLAG:7 == 2)
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		PRINTFORMW 
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		PRINTFORMW 
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORMW 
	ENDIF
	CFLAG:218 = 1
;陥落済み
ELSEIF CFLAG:219 < 4 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		PRINTFORMW 
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		PRINTFORMW 
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORMW 
	ENDIF
	CFLAG:219 = 4
ENDIF
RETURN 0

;--------------------------------------------------
;@KOJO_MESSAGE_COM関係（X1をキャラ番号に置換）
;コマンド実行時に出力されます
;--------------------------------------------------
@KOJO_MESSAGE_COM_K[[キャラ:스핑크스]]
#DIM GYOU
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL TRAIN_MESSAGE
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_COM_PY1_K[[キャラ:스핑크스]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_COM_PY1_K[[キャラ:스핑크스]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;LOCALS
;-------------------------------------------------

FOR GYOU,0,51
	LOCALS:GYOU = 
	LOCAL:GYOU = 0
NEXT
;-------------------------------------------------
;コマンド実行時のセリフ CFLAG 300～500
;-------------------------------------------------
SELECTCASE SELECTCOM
;=================================================
;愛撫系コマンド
;=================================================
;-------------------------------------------------
;0,애무
;-------------------------------------------------
	CASE 0
		CALL TRAIN_MESSAGE
		IF TEQUIP:25 == 0
			;初めて
			IF CFLAG:300 == 0
				PRINTFORML 
				LOCALS:0 =
				CFLAG:300 = 1
			ELSE
				IF 陥落() && (CFLAG:300 < 3 || FLAG:7 == 2)
					;恋慕、親愛
					IF 陥落() > 0 && RESULTS == "연모"
						LOCALS:0 = 
					;淫乱、娼婦	
					ELSEIF 陥落() > 0 && RESULTS == "음란"
						LOCALS:0 = 
					;服従、隷属	
					ELSEIF 陥落() > 0 && RESULTS == "복종"
						LOCALS:0 = 
					ENDIF
					;陥落済み共通
					IF LOCALS:0 == ""
						LOCALS:0 = 
					ENDIF
					CFLAG:300 = 4
				ENDIF
				;屈服刻印Lv3
				IF MARK:2 == 3 && (CFLAG:300 < 2 || FLAG:7 == 2) && LOCALS:0 == ""
					LOCALS:0 = 
					CFLAG:300 = 3
				ENDIF
				;それ以外
				IF (CFLAG:300 || FLAG:7 == 2) && LOCALS:0 == ""
					PRINTFORML
					LOCALS:0 =
					CFLAG:300 = 2
				ENDIF
			ENDIF
		;触手あり
		ELSE
			GOTO SHOKUSHU_PLAY
		ENDIF
;-------------------------------------------------
;1,커닐링구스
;-------------------------------------------------
	CASE 1
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:301 == 0
			PRINTFORML 
			LOCALS:0 =
			CFLAG:301 = 1
		ELSE
			IF 陥落() && (CFLAG:301 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落() > 0 && RESULTS == "연모"
					LOCALS:0 = 
				;淫乱、娼婦	
				ELSEIF 陥落() > 0 && RESULTS == "음란"
					LOCALS:0 = 
				;服従、隷属	
				ELSEIF 陥落() > 0 && RESULTS == "복종"
					LOCALS:0 = 
				ENDIF
				;陥落済み共通
				IF LOCALS:0 == ""
					LOCALS:0 = 
				ENDIF
				CFLAG:301 = 4
			ENDIF
			;屈服刻印Lv3
			IF MARK:2 == 3 && (CFLAG:301 < 2 || FLAG:7 == 2) && LOCALS:0 == ""
				LOCALS:0 = 
				CFLAG:301 = 3
			ENDIF
			;それ以外
			IF (CFLAG:301 || FLAG:7 == 2) && LOCALS:0 == ""
				PRINTFORML
				LOCALS:0 =
				CFLAG:301 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;2,펠라한다
;-------------------------------------------------
	CASE 2
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:302 == 0
			PRINTFORML 
			LOCALS:0 =
			CFLAG:302 = 1
		ELSE
			IF 陥落() && (CFLAG:302 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落() > 0 && RESULTS == "연모"
					LOCALS:0 = 
				;淫乱、娼婦	
				ELSEIF 陥落() > 0 && RESULTS == "음란"
					LOCALS:0 = 
				;服従、隷属	
				ELSEIF 陥落() > 0 && RESULTS == "복종"
					LOCALS:0 = 
				ENDIF
				;陥落済み共通
				IF LOCALS:0 == ""
					LOCALS:0 = 
				ENDIF
				CFLAG:302 = 4
			ENDIF
			;屈服刻印Lv3
			IF MARK:2 == 3 && (CFLAG:302 < 2 || FLAG:7 == 2) && LOCALS:0 == ""
				LOCALS:0 = 
				CFLAG:302 = 3
			ENDIF
			;それ以外
			IF (CFLAG:302 || FLAG:7 == 2) && LOCALS:0 == ""
				PRINTFORML
				LOCALS:0 =
				CFLAG:302 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;3,손가락삽입
;-------------------------------------------------
	CASE 3
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:303 == 0
			PRINTFORML 
			LOCALS:0 =
			CFLAG:303 = 1
		ELSE
			IF 陥落() && (CFLAG:303 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落() > 0 && RESULTS == "연모"
					LOCALS:0 = 
				;淫乱、娼婦	
				ELSEIF 陥落() > 0 && RESULTS == "음란"
