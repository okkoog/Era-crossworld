FOR GYOU,0,51
	SIF LOCALS:GYOU == ""
		BREAK
	PRINTFORM  %LOCALS:GYOU%
	IF LOCAL:GYOU
		PRINTW
	ELSE
		PRINTL
	ENDIF
NEXT
SIF LOCAL:GYOU == 0
	PRINTW
;-------------------------------------------------
;闘技場敗北時口上集（X1をキャラ番号に置換する） 基本的に見るとゲームオーバーなのでフラグは使わない事に
;-------------------------------------------------
@KOJO_MESSAGE_LOSE_COLOSSEUM_K[[キャラ:스핑크스]]
SELECTCASE TFLAG:투기장패배
		;-------------------------------------------------
		;オニ＆蔦
		;-------------------------------------------------
	CASE 1
			CALL MESSAGE_LOSE_COLOSSEUM
			IF 1 == 2
			;恋慕、親愛
			;IF TALENT:3 || TALENT:6
			;	PRINTFORMW 
			;淫乱、娼婦
			;ELSEIF TALENT:4 || TALENT:7
			;	PRINTFORMW 
			;服従、隷属
			;ELSEIF TALENT:5 || TALENT:8
			;	PRINTFORMW 
			ELSE
				PRINTFORMW 
			ENDIF
ENDSELECT


;-------------------------------------------------
;@KOJO_QUIZ_ANSER
;質問に対する回答編
;-------------------------------------------------
@KOJO_QUIZ_ANSER
	PRINTFORML 
	PRINTFORMW 、
	PRINTFORMW %CALLNAME%脚抱上、燕返体位腰突入
	PRINTFORML 
	IF 陥落() > 0
		PRINTFORMW 「朝四這」
		PRINTFORMW 「昼立읏」
		PRINTFORMW 「今体位……」
		PRINTFORML 
		PRINTFORML 「正解、正解%─()%」
		PRINTFORMW %CALLNAME:PLAYER%攻回答%CALLNAME%満足
		PRINTFORML 
		PRINTFORML 「正解%CSTR:이인칭%商品……」
		ITEM:(GETNUM(ITEM, "울트라햇")) += 1
		PRINTFORML 
		PRINTFORMW  %CALLNAME:PLAYER%　울트라햇　手入
		PRINTFORML 
		PRINTFORML 「副賞%─()%」
		PRINTFORMW %CALLNAME%%CALLNAME:PLAYER%頬
		JUEL:복종 += 1000
		EXP:키스경험 += 1
		IF 陥落() > 0 && RESULTS == "연모"
			EXP:애정경험 += 4
		ENDIF
	ELSE
		PRINTFORMW 「읏……」
		PRINTFORMW （朝四這）
		PRINTFORMW （昼立읏）
		PRINTFORMW （今片足抱上三本足）
		PRINTFORML （方法答……）
		PRINTFORMW %CALLNAME%自分出問対正解出事、激攻声出
		PRINTFORML 
		PRINTFORML 「正解…………」
		PRINTFORMW %CALLNAME:PLAYER%攻回答%CALLNAME%完全屈服
		PRINTFORML 「正解%CSTR:이인칭%商品……」
		ITEM:(GETNUM(ITEM, "울트라햇")) += 1
		PRINTFORML 
		PRINTFORMW  %CALLNAME:PLAYER%　울트라햇　手入
		PRINTFORML 
		PRINTFORML 「%CSTR:일인칭%負……」
		PRINTFORMW 副賞%CALLNAME%素直읏
		JUEL:복종 += 100
		JUEL:굴복 += 1000
		IF JUEL:부정 >= 1000
			JUEL:부정 -= 1000
		ELSEIF JUEL:부정 > 1
			JUEL:부정 = 0
		ENDIF
	ENDIF

	;回答済みフラグ
	CFLAG:281 = 3

;-------------------------------------------------
;@KOJO_MESSAGE_ENDING関係(X1、X2をキャラ番号に置換する)
;-------------------------------------------------
;-------------------------------------------------
;エンディング口上の有無を判別する関数
;記述したエンディングの種類に応じてコメントアウトを解除
;-------------------------------------------------
@ENDING_CHECK_K[[キャラ:스핑크스]]
SELECTCASE TSTR:END종별
	CASE "個別END"
		SIF (TALENT:아내 || TALENT:남편) && CFLAG:281 == 3
			RETURN 1
	;	SIF TALENT:음마
	;		RETURN 1
	;	SIF TALENT:노리개
	;		RETURN 1
	;CASE "調教師END"
	;	RETURN 1
	;CASE "스핑크스"
	;	RETURN 1
	;CASE "食堂経営END"
	;	RETURN 1
	;CASE "娼館経営END"
	;	RETURN 1
	;CASE "스핑크스"
	;	RETURN 1
ENDSELECT
RETURN 0

;-------------------------------------------------
;エンド本文
;-------------------------------------------------
@KOJO_MESSAGE_ENDING_K[[キャラ:스핑크스]]
;--------------------------------------------------
SELECTCASE TSTR:END종별
	CASE "個別END"
		;恋慕単体エンド
		IF (TALENT:아내 || TALENT:남편) && CFLAG:21 == 1
			DRAWLINE
			PRINTFORML 
			PRINTFORMW －　　－
			PRINTFORMW 屋上対峙%CALLNAME%%CALLNAME:MASTER%
			PRINTFORML 
			PRINTFORMW 「誰戦事思읏」
			PRINTFORMW 「相手%CSTR:이인칭%……」
			PRINTFORMW 「遠慮」
			PRINTFORMW 「全力읏相手」
			PRINTFORML ……
			PRINTFORML …
			PRINTFORMW 『参。10先取』
			PRINTFORMW 『問題……』
			PRINTFORMW 日本茶間見守中、自由女神背景二人戦始……
			PRINTFORML 
			PRINTFORMW 　　　　　　　　―― Ending No.814[Sphinx] (恋慕　王道)
		;淫乱単体エンド
		;ELSEIF TALENT:음마 && CFLAG:21 == 1
			;DRAWLINE
			;PRINTFORMW …………
			;PRINTFORMW ………
			;PRINTFORMW ……
			;PRINTFORMW 

			;PRINTFORMW 
			;PRINTFORMW 　　　　　　　　―― Extra Ending　（◯◯）
		;服従単体エンド
		;ELSEIF TALENT:노리개 && CFLAG:21 == 1
			;DRAWLINE
			;PRINTFORMW …………
			;PRINTFORMW ………
			;PRINTFORMW ……
			;PRINTFORMW 

			;PRINTFORMW 
			;PRINTFORMW 　　　　　　　　―― Extra Ending　（◯◯）
		ENDIF
	;CASE "調教師END"
	;CASE "스핑크스"
	;CASE "食堂経営END"
	;CASE "娼館経営END"
	;CASE "스핑크스"
ENDSELECT
;個別ENDの場合ここでRETURN 1すると、その後ゲームは続かず次周に行くかゲーム終了かの選択になります
RETURN 1

