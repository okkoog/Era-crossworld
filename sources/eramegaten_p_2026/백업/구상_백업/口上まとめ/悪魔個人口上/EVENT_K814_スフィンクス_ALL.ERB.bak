			CALL EVENT_MESSAGE
			IF CFLAG:263 < 1 || FLAG:7 == 2
				PRINTFORML 
				CFLAG:263 = 1
			ENDIF

		;-------------------------------------------------
		;朝の足コキ
		;-------------------------------------------------
	CASE 28
			CALL EVENT_MESSAGE
