		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:251 = 1
ENDIF

;-------------------------------------------------
;初めて屈服がLV3超えた
;-------------------------------------------------
P = PALAM:7 + CUP:7
IF P > PALAMLV:3 && CFLAG:252 == 0
	CALL PALAM_MESSAGE_D
	PRINTFORMW 
	CFLAG:252 = 1
ENDIF

;-------------------------------------------------
