;銃攻撃（特殊弾丸含む）
;-------------------------------------------------
;ELSEIF RANGE(CFLAG:ARG:입력행동,2101, 2200)
;	;GUN
;	IF CFLAG:ARG:입력행동 == 2101
;		BTL_KOJO_RESULTS:0 = 
;	;その他（特殊弾丸）
