;真・その他
;-------------------------------------------------
IF BTL_KOJO_RESULTS:0 == ""
	;必ず何か喋る
	SELECTCASE RAND:3
		CASE 0
			BTL_KOJO_RESULTS:0 = はぁっ！！
		CASE 1
			BTL_KOJO_RESULTS:0 = 吹き飛べぇ！！
		CASE 2
			BTL_KOJO_RESULTS:0 = せいっ！！
	ENDSELECT
ENDIF

