;		BTL_KOJO_RESULTS:0 = 
;	ENDIF
;-------------------------------------------------
;基本行動
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,2301, 2400)
	;ＣＨＡＮＧＥ
	IF CFLAG:ARG:입력행동 == 2301
		BTL_KOJO_RESULTS:0 = 移動します！
	ELSE
		;BTL_KOJO_RESULTS:0 = 
	ENDIF
;-------------------------------------------------
;アイテム
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,3001, 3500)
	;BTL_KOJO_RESULTS:0 = 
