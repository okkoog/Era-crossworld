;ライセンスについて
;	・基本項目(許可する項目を"○"に、許可しない項目を"×"に変更してください。)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1| ○ | 処理上のバグ修正              |
;	+----+----+-------------------------------+
;	|   2| ○ | 口上の誤字・脱字の修正        |
;	+----+----+-------------------------------+
;	|   3| ○ | 口上まとめへの収録            |
;	+----+----+-------------------------------+
;	|   4| ○ | 口上の新規追加                |
;	+----+----+-------------------------------+
;	|   5| ○ | 既存口上の改変                |
;	+----+----+-------------------------------+
;	|   6| ○ | 改変した口上の自由な再配布    |
;	+----+----+-------------------------------+
;	|   7| ○ | 口上内容の転載                |
;	+----+----+-------------------------------+

@KOJO_BATTLE_EVENT_K[[キャラ:만드리카르도]], ARG, ARG:1, ARG:2
;■台詞の行数を増やしたいときは
;			LOCALS:10 = 一行目
;			LOCALS:11 = 二行目
;			LOCALS:12 = 三行目
;			LOCALS:13 = 四行目
;			LOCALS:14 = 五行目
;と増やしていく
SIF ARG < 0 && NO:ARG != 5087
	RETURN 0
VARSET LOCALS
VARSET KSTR

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = はいはい、俺の後にも続きますよーっと
			CASE 1
				BTL_KOJO_RESULTS:0 = 皆さん！今がチャンスっす！
			CASE 2
				BTL_KOJO_RESULTS:0 = 俺が先陣！感激っすね！！
		ENDSELECT
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 了解っす
				CASE 1
					BTL_KOJO_RESULTS:0 = さすがっすねー！
				CASE 2
					BTL_KOJO_RESULTS:0 = はいはい、続いて攻撃しますよ、っと！
			ENDSELECT
		;それ以外
		ELSE
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = ぼっこぼこにしてやるっす！	
			CASE 1
				BTL_KOJO_RESULTS:0 = はいはい、続くっすよー
			CASE 2
				BTL_KOJO_RESULTS:0 = やるじゃねえっすか！
			ENDSELECT
		ENDIF
	;被召喚時
	CASE 3
		SELECTCASE RAND:2
			CASE 0
				BTL_KOJO_RESULTS:0 = そんじゃまぁ、やりますかっと
			CASE 1
				BTL_KOJO_RESULTS:0 =　マンドリカルド、よろしくーっす
		ENDSELECT
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			SELECTCASE RAND:2
			CASE 0
				BTL_KOJO_RESULTS:0 = 俺でも倒せたっすよ！
			CASE 1
				BTL_KOJO_RESULTS:0 = 弱いくせに出てくるんじゃねぇ！
			ENDSELECT
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = あれ？おかしいっすね！？
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = このままトドメっす！
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = けっこうイケたんじゃないっすかね
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			BTL_KOJO_RESULTS:0 = くそっ、かってぇ！
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = 無効とかアリっすか！？
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = ま、三流にしちゃよくやったってことで……
				CASE 1
					BTL_KOJO_RESULTS:0 = 次は負け……ねぇ……
			ENDSELECT
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = いてっ！？
				CASE 1
					BTL_KOJO_RESULTS:0 = まずいっす！！
			ENDSELECT
		;無効
		ELSEIF ARG:2 == 0
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = 効かないんだよォ！！
				CASE 1
					BTL_KOJO_RESULTS:0 = そこ、無駄っすよー
			ENDSELECT
		;吸収
		ELSEIF ARG:2 < 0
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = ありがてえこってす
				CASE 1
					BTL_KOJO_RESULTS:0 = 吸収……いいっすね、これ
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = あいてっ！？
			CASE 1
				BTL_KOJO_RESULTS:0 = 耐えろぉおおおお！！
			CASE 2
				BTL_KOJO_RESULTS:0 = あー！？
			ENDSELECT
		ENDIF
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE 13
		;全弾命中した
		IF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 俺の攻撃が全命中……夢っすかね？コレ
		;普通
		ELSEIF ARG:2 < ARG:1
			BTL_KOJO_RESULTS:0 = くそっ、いくつか避けられた！！
		;全弾回避された
		ELSEIF ARG:2 == ARG:1
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = す、すんません！外しました！
			CASE 1
				BTL_KOJO_RESULTS:0 = いやいやいや、ダメ過ぎだろ俺……！
			CASE 2
				BTL_KOJO_RESULTS:0 = えっ、全部ハズレとかマジっすか！？
			ENDSELECT
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE 14
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			LOCAL = RAND:3
			SELECTCASE LOCAL
			CASE 0
				BTL_KOJO_RESULTS:0 = これで一掃っすね！！
			CASE 1
				BTL_KOJO_RESULTS:0 = 三流に全滅させられてんじゃねーよ！
			CASE 2
				BTL_KOJO_RESULTS:0 = 俺、活躍したっすよ！！
			ENDSELECT
		ELSE
			BTL_KOJO_RESULTS:0 = うーん、倒しこそねたっすかね？
		ENDIF
	;反射された
	CASE 15
		BTL_KOJO_RESULTS:0 = あいて！？反射とかアリっすか！？
	;反射した
	CASE 16
		BTL_KOJO_RESULTS:0 = そこは得意なところっすよ！！
	;回避された
	CASE 17
		SELECTCASE RAND:3
		CASE 0
			BTL_KOJO_RESULTS:0 = てめぇ！避けんじゃねぇ！
		CASE 1
			BTL_KOJO_RESULTS:0 = ぐっ！当たんねぇ！
		CASE 2
			BTL_KOJO_RESULTS:0 = すんません！外したっす！！
		ENDSELECT
	;回避した
	CASE 18
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 追いついてないっすよ！
			CASE 1
				BTL_KOJO_RESULTS:0 = 俺でも避けられたっす！
			CASE 2
				BTL_KOJO_RESULTS:0 = どこ見てんだ！！
		ENDSELECT
	;反撃スキル発動した
	CASE 20
			BTL_KOJO_RESULTS:0 = そこ、隙アリっす！！
	CASE 22
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				BTL_KOJO_RESULTS:0 = と、友達100人……
			CASE "SHOCK"
				BTL_KOJO_RESULTS:0 = びりびりして動けねぇっすよぉ……
			CASE "FREEZE"
				BTL_KOJO_RESULTS:0 = さ、さみぃ……
			CASE "BIND", "PALYZE"
				BTL_KOJO_RESULTS:0 = えっ……あれ、う、動けねぇ……
			CASE "PANIC"
				BTL_KOJO_RESULTS:0 = てめぇが俺の敵だな！？
			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 = うーん……おやすみなさいっす……
			CASE "CLOSE"
				BTL_KOJO_RESULTS:0 = ぐっ、やばいっす！魔力が……
			CASE "POISON"
				BTL_KOJO_RESULTS:0 = あー、毒っすねコレ……じわじわ来てるっす
			CASE "BOMB"
				BTL_KOJO_RESULTS:0 = あー！？ちょっとこの爆弾洒落になんねー！？
			CASE "CHARM"
				KSTR:(K++) = うっ、なんか頭がくらくらするっす……
			CASE "CURSE"
				BTL_KOJO_RESULTS:0 = ぎゃー！呪われちまった！？
			CASE "FLY"
				BTL_KOJO_RESULTS:0 = なんすか、なんなんすかハエって！！
			CASE "STONE"
				BTL_KOJO_RESULTS:0 = …………(妙にダサいポーズで固まっている
			CASE "FLAME"
				BTL_KOJO_RESULTS:0 = あっつ！？燃える！燃えちまうっすよぉ！
			CASE "SLIP"
				BTL_KOJO_RESULTS:0 = うわー！？た、助けて欲しいっす……ぐべっ
			CASE "BRAND"
				BTL_KOJO_RESULTS:0 = へ、変なモンが俺の体に……
			;その他の状態異常
			;CASEELSE
		ENDSELECT
	;食いしばり等で耐えた
	CASE 23
		BTL_KOJO_RESULTS:0 = いくら三流でもそうそう死んで、たまるかよォ！！
	;バトルに勝利した
	CASE 90
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 勝ちました、っと！はぁ……良かった
			CASE 1
				BTL_KOJO_RESULTS:0 = ま、今回はなんとかなったっすね
		ENDSELECT
	;レベルアップした
	CASE 91
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = レベルアップ、ありがてえこってす
			CASE 1
				BTL_KOJO_RESULTS:0 = 俺、レベルアップっす！
		ENDSELECT
	;逃走に成功した
	CASE 92
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 賭けろ！ブリリアドーロ！
			CASE 1
				BTL_KOJO_RESULTS:0 = 撤退すればまた戦えるっすよ！
			CASE 2
				BTL_KOJO_RESULTS:0 = 逃げるが勝ち、っすね
		ENDSELECT
	;逃走に失敗した
	CASE 93
			BTL_KOJO_RESULTS:0 = あー！？回り込まれたっす！！
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = えっ、俺、やばくないっすか……
		ELSE
			BTL_KOJO_RESULTS:0 = 陰キャらしく、それなりに頑張りますよっと！
		ENDIF
	;バックアタックを受けた
	CASE 95
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = あー！？今はまずいっす！マジで！！
		ELSE
			BTL_KOJO_RESULTS:0 = くそっ、まずいっすね！回り込まれた
		ENDIF
	;敵の先制攻撃を受けた
	CASE 96
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 生き残れるっすかね、俺……
		ELSE
			BTL_KOJO_RESULTS:0 = くそっ、敵の方がはえぇ！！	
		ENDIF
	;先制攻撃に成功
	CASE 97
			BTL_KOJO_RESULTS:0 = 先制、頂くぜ！！
	CASE 100
		IF 0
		;スキル分岐
		;ELSEIF CFLAG:(FLAG:행동순1):입력행동 == [[스킬:○○]]
		ELSE
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = つまりは合体技っすね！！
				CASE 1
					BTL_KOJO_RESULTS:0 = はいはい、いくっすよー
			ENDSELECT
		ENDIF
ENDSELECT
;SIF !(LOCALS:10 == "")
;	CALL MESSAGE_B2(CALLNAME:ARG,0, LOCALS:10, LOCALS:11, LOCALS:12, LOCALS:13, LOCALS:14)


@KOJO_BATTLE_MESSAGE_K[[キャラ:만드리카르도]],ARG,ARG:1 = 0
#DIM 宝具セリフ
;■台詞の行数を増やしたいときは
;			LOCALS:10 = 一行目
;			LOCALS:11 = 二行目
;			LOCALS:12 = 三行目
;			LOCALS:13 = 四行目
;			LOCALS:14 = 五行目
;と増やしていく
VARSET LOCALS
;使用したスキルの名前をLOCALSに代入
CALL GET_SKILL_PROP, "SKILL_NAME", CFLAG:ARG:입력행동, ARG
LOCALS = %RESULTS%
;FLAG:ARG:타겟

;崩壊してる場合は口上表示しないようにもできる
;SIF TALENT:ARG:9
;	RETURN 0

CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
;コメントアウトしやすいように
IF 1 == 0
;-------------------------------------------------
;状態異常時
;-------------------------------------------------
;魅了時
ELSEIF CFLAG:ARG:상태이상 == GET_STATE_NUM("CHARM")
	;行動不能（ムラムラしている）
	IF CFLAG:ARG:입력행동 == 2314
		BTL_KOJO_RESULTS:0 = なんかもやもやして変な気持ちっす……
	ELSE
		BTL_KOJO_RESULTS:0 = あっ！？俺、今何してました！？
	ENDIF
;混乱時
ELSEIF CFLAG:ARG:상태이상 == GET_STATE_NUM("PANIC")
	;금전뿌리기
	IF CFLAG:ARG:입력행동 == 2315
		BTL_KOJO_RESULTS:0 = 銭投げっすよ！銭投げ！！
	;行動不能（ぼんやりしている）
	ELSEIF CFLAG:ARG:입력행동 == 2314
		SELECTCASE RAND:2
			CASE 0
				BTL_KOJO_RESULTS:0 = あぁー、このまま溶けたい……
			CASE 1
				BTL_KOJO_RESULTS:0 = やっぱデュランダルっすよ、デュランダル……
		ENDSELECT
	ELSE
		BTL_KOJO_RESULTS:0 = てめぇ！よくもオレのデュランダルを！！
	ENDIF
;-------------------------------------------------
;特定スキル
;-------------------------------------------------
;これは通常攻撃
ELSEIF CFLAG:ARG:입력행동 == 0
	SELECTCASE RAND:3
		CASE 0
			BTL_KOJO_RESULTS:0 = たたっ斬る！！
		CASE 1
			BTL_KOJO_RESULTS:0 = せいや！っと！！
		CASE 2
			BTL_KOJO_RESULTS:0 = この野郎が！！
	ENDSELECT
;ELSEIF CFLAG:ARG:입력행동 == (スキル番号)
;	BTL_KOJO_RESULTS:0 = 
;;섹시댄스
;ELSEIF CFLAG:ARG:입력행동 == 1212
