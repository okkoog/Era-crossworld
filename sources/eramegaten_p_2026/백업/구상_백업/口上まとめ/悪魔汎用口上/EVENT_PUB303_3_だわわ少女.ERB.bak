;-------------------------------------------------
;189,새댁플레이　恋慕、親愛のみ
;-------------------------------------------------
	CASE 189
		K_CALL:K = TRAIN_MESSAGE
		IF TEQUIP:33
		;エプロン着る
			;初めて
			IF CFLAG:401 == 0
				IF TALENT:아내 && RAND:2 == 0
					KSTR:(K++) = 「어때? 어린 아내는♪」
					WSTR:(K++) = %CALLNAME%은(는) 기쁜 듯 뱅글뱅글 돌고 있다
				ELSE
					WSTR:(K++) = 「이걸 입으라구?」
					WSTR:(K++) = 「텔레비전에서 보던 젊은 새댁 느낌이네」
				ENDIF
				CFLAG:401 = 1
			;二回目以降
			ELSEIF CFLAG:401 < 2 || FLAG:7 == 2
				IF RAND:3 == 0
					KSTR:(K++) = 「%CSTR:이인칭%이(가) 남편이고, %CSTR:일인칭%이(가) 아내……」
					WSTR:(K++) = 「나쁘진 않네」
				ELSEIF RAND:2 == 0
					WSTR:(K++) = 「에이프런 입혀서 뭘 할 셈이야?」
					WSTR:(K++) = 「에, 더러워져도 괜찮도록?」
					KSTR:(K++) = 「그 눈빛…… 알겠어, 뭘 하고 싶은 거야?」
					WSTR:(K++) = %CALLNAME%은(는) 어이없다는 표정이지만 아주 싫지만은 않은 모양이다
				ELSE
					KSTR:(K++) = 「여・보・당♪」
					WSTR:(K++) = 「노, 농담이야! 놀린 것뿐이라구!」
				ENDIF
				CFLAG:401 = 2
			ENDIF
		ELSE
		;해제
			IF CFLAG:401 == 1 || FLAG:7 == 2
				IF RAND:2 == 0
					KSTR:(K++) = 「이 꼴로 만들어놓고……」
					WSTR:(K++) = 「무엇을 위한 앞치마인지 생각해보게 되네」
				ELSE
					WSTR:(K++) = 「에이프런 입었을 뿐인데 대흥분해버렸네, %CSTR:이인칭%%ハート()%」
					WSTR:(K++) = 「그렇게나 좋다면 또 입어줄 수도 있어」
				ENDIF
			ENDIF
		ENDIF
