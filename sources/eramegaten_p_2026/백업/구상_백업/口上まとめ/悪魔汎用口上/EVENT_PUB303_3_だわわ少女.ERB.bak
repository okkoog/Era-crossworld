	;弱体系
	ELSEIF RANGE(CFLAG:ARG:입력행동,506, 509) || CFLAG:ARG:입력행동 == 541 || CFLAG:ARG:입력행동 == 556
		LOCALS:10 = 
	;도발
	ELSEIF CFLAG:ARG:입력행동 == 515
		IF RAND:2 == 0
			LOCALS:10 = 덤벼보라구!
		ENDIF
	;その他
	ELSE
		LOCALS:10 = 
	ENDIF
;방어
ELSEIF TALENT:방어 && (RANGE(CFLAG:ARG:입력행동,601, 699))
	LOCALS:10 = 
;화염
ELSEIF RANGE(CFLAG:ARG:입력행동,701, 731) || RANGE(CFLAG:ARG:입력행동,734, 735) || RANGE(CFLAG:ARG:입력행동,740, 799)
	IF RAND:3 == 0
		LOCALS:10 = 불태워 없애줄게
	ELSEIF RAND:2 == 0
		LOCALS:10 = 불더미가 되어버려
	ENDIF
;빙결
ELSEIF RANGE(CFLAG:ARG:입력행동,801, 899)
	IF RAND:2 == 0
		LOCALS:10 = 얼음 절임으로 만들어줄게
	ELSE
		LOCALS:10 = 이대로 얼어 죽으면 돼
	ENDIF
;전격
ELSEIF RANGE(CFLAG:ARG:입력행동,901, 999)
	IF RAND:2 == 0
		LOCALS:10 = 새까맣게 태워줄게
	ELSE
		LOCALS:10 = 감전사나 해버려
	ENDIF
