SELECTCASE SELECTCOM
;-------------------------------------------------
;100,스팽킹
;-------------------------------------------------
	CASE 100
		K_CALL:K = TRAIN_MESSAGE
		;初めて
		IF CFLAG:354 == 0
			IF 陥落( ) > 0 
				KSTR:(K++) = 「때리는 쪽이 흥분돼?」
				WSTR:(K++) = 「그럼 어울려줄게」
			ELSE
				WSTR:(K++) = 「잠깐, 왜 진짜로 때리는 거야!」
			ENDIF
			CFLAG:354 = 1
		ELSE
			IF 陥落( ) > 0 && (CFLAG:354 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"
					IF ABL:마조끼 >= 4
						IF RAND:2 == 0
							KSTR:(K++) = 「%CSTR:이인칭%이(가) 기뻐해 주니까」
							WSTR:(K++) = 「%CSTR:일인칭%도 기분 좋으니까…%ハート()%」
						ELSE
							KSTR:(K++) = 「맞는 것도 나쁘진 않지만」
							WSTR:(K++) = 「다른 방법으로 귀여워해줬으면 좋겠는데%ハート()%」
						ENDIF
					ELSE
						IF RAND:2 == 0
							KSTR:(K++) = 「아프지만 %CSTR:이인칭%이(가) 기뻐해 준다면」
							WSTR:(K++) = 「이 정도는 참을 수 있어%ハート()%」
						ELSE
							KSTR:(K++) = 「이런 것도 사랑이지%ハート()%」
						ENDIF
					ENDIF
				;淫乱、娼婦	
				ELSEIF 陥落( ) > 0 && RESULTS == "음란"
					KSTR:(K++) = 「흥분되기 시작했어?」
					SIF ABL:마조끼 >= 4
						KSTR:(K++) = 「%CSTR:일인칭%의 가랑이 쪽은 준비가 다 된 모양이야♪」
				;服従、隷属	
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					IF RAND:2 == 0
						KSTR:(K++) = 「채찍은 안 쓰네」
						KSTR:(K++) = 「조금 안심했어」
						WSTR:(K++) = %CALLNAME%은(는) 조금 아쉬워 보인다
					ELSE
						KSTR:(K++) = 「오늘은 새빨개질 때까지 때릴 셈이야?」
						KSTR:(K++) = 「아니면 가죽이 찢어질 때까지?」
					ENDIF
				ENDIF
				;陥落済み共通
				IF !口上有無確認(0)
					KSTR:(K++) = 
				ENDIF
				CFLAG:354 = 4
			ENDIF
			;屈服刻印Lv3
			IF MARK:굴복각인 == 3 && (CFLAG:354 < 2 || FLAG:7 == 2) && !口上有無確認(0)
				KSTR:(K++) = 「왜 나쁜 짓도 안 했는데 맞는 거야」
				WSTR:(K++) = 「영문을 모르겠어」
				CFLAG:354 = 3
			ENDIF
			;それ以外
			IF (CFLAG:354 || FLAG:7 == 2) && !口上有無確認(0)
				IF RAND:2 == 0
					KSTR:(K++) = 「%CSTR:일인칭%은(는) 말이 아니야」
					WSTR:(K++) = 「말을 안 듣는다고 때리지 마」
				ELSE
					KSTR:(K++) = 「그렇게 철썩철썩 때리고」
					WSTR:(K++) = 「맞는 사람 입장도 좀 생각해줬으면 좋겠네」
				ENDIF
				CFLAG:354 = 2
			ENDIF
		ENDIF
