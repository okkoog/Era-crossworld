@BATTLE_BOYCOTT_MESSAGE_PUB303_3,ARG,ARG:1 = 0
	;ボイコットした場合に表示する口上
	CALL GET_SKILL_PROP, "SKILL_NAME", CFLAG:ARG:입력행동, ARG
	;使用したスキルの名前をLOCALSに代入
	LOCALS = %RESULTS%
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 그런 명령, 사양하겠어
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 각하야, 그런 건
	ELSE
		BTL_KOJO_RESULTS:0 = 그게 남한테 부탁하는 태도야?
	ENDIF


