			;衣服で眼鏡を装備している
			IF RAND:2 == 0 && TEQUIP:91== 1103
				KSTR:(K++) = 「순식간에 눈앞이 새하얘졌어…」
				WSTR:(K++) = %CALLNAME%은(는) 눈을 감지 않고 사정을 받아냈다
			ELSE
				KSTR:(K++) = 「얼굴에 싼다고 임신 따윈 안 해」
				WSTR:(K++) = %CALLNAME%은(는) 얼굴에 묻은 정액을 손가락으로 닦아내더니 그대로 입에 머금었다.
			ENDIF
			CFLAG:222= 2
		ENDIF		
		;それ以外		
		IF (CFLAG:222 < 1 || FLAG:7 == 2) && !口上有無確認(0)
			;衣服で眼鏡を装備している
			IF RAND:4 == 0 && TEQUIP:91== 1103
				WSTR:(K++) = 「最低……」
				KSTR:(K++) = 「안경이 없었으면 눈에 들어갈 뻔했어」
			ELSEIF RAND:3 == 0 && TEQUIP:91== 1103
				KSTR:(K++) = 「……최악이야」
				KSTR:(K++) = 「나중에 안경을 닦아야겠네…」
			ELSEIF RAND:2 == 0
				WSTR:(K++) = 「우와아… 끈적끈적해…」
			ELSE
				KSTR:(K++) = 「으엑… 냄새나……」
			ENDIF
			WSTR:(K++) = %CALLNAME%은(는) 원망스럽다는 듯 이쪽을 노려보았다.
			CFLAG:222= 1	
		ENDIF		
	;가슴
	ELSEIF CFLAG:106 == 3				
