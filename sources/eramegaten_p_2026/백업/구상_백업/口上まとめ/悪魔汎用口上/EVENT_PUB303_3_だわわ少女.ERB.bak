		KSTR:(K++) = 「빨리 죽어주지 않으려나」
	ELSE
		KSTR:(K++) = 「%CSTR:이인칭% 따윈 악마에게 잡아먹혀 버리면 돼」
	ENDIF
	WSTR:(K++) =  %CALLNAME:MASTER%은(는) 원망하는 말을 들으면서 %CALLNAME%
	IF ABL:종족 == 0
		WSTR:(K++) = 의 방을 나갔다.
	ELSE
		WSTR:(K++) = 을(를) 송환했다.
	ENDIF
	CFLAG:217 = 1
;屈服刻印Lv1以下
ELSEIF MARK:굴복각인 <= 1 && (CFLAG:219 < 1 || FLAG:7 == 2)
	KSTR:(K++) = 「겨우 끝났다」
	SELECTCASE TIME
		CASE 0
			WSTR:(K++) = 「자, 점심 먹자」
		CASE 1
			WSTR:(K++) = 「싫은 일 잊는 덴 간식이 최고야」
		CASE 2
			WSTR:(K++) = 「자, 저녁 먹을 시간이야」
		CASE 3
			WSTR:(K++) = 「목욕하고 개운해진 뒤에 잘래」
	ENDSELECT
	CFLAG:219 = 1
;屈服刻印Lv2
ELSEIF MARK:굴복각인 == 2
	IF RAND:3 == 0
		KSTR:(K++) = 「아, 벌써 끝…?」
	ELSEIF RAND:2 == 0
		KSTR:(K++) = 「응… 하아, 뭘까 이 기분은……」
	ELSE
		KSTR:(K++) = 「…응, 또 봐」
	ENDIF
	IF RAND:2 == 0
		WSTR:(K++) = %CALLNAME%은(는) 무언가 더 말하고 싶은 기색을 보였지만, 아무 말도 하지 않고 수건으로 몸을 닦기 시작했다.
	ELSE
		WSTR:(K++) = 복잡한 표정을 짓는 %CALLNAME%. 쾌락에 빠져들려는 자신에게 당황하고 있는 것 같다.
	ENDIF
	CFLAG:219 = 2
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:굴복각인 == 3 && 陥落()> 0
	IF RAND:3 == 0
		WSTR:(K++) = 「오늘은 이걸로 끝이야?」
		KSTR:(K++) = 「또 불러줄 거지? 응?」
	ELSEIF RAND:2 == 0
		KSTR:(K++) = 「이, 이제 끝…… 인 거야……?」
	ELSE
		KSTR:(K++) = 「%CSTR:이인칭%(와)과 함께 있는 게 즐거워졌어……」
	ENDIF
	IF RAND:2 == 0
		WSTR:(K++) = %CALLNAME%은(는) 축 늘어져 힘없이 누워있다.
		WSTR:(K++) = 멍하니 천장을 바라보는 그 눈동자에는 현 상황을 순순히 받아들이는 체념이 감돌고 있었다……
	ELSE
		WSTR:(K++) = 그렇게 중얼거리는 %CALLNAME%은(는), 여전히 아쉬운 눈빛으로 이쪽을 바라보고 있었다.
	ENDIF
	CFLAG:219 = 3
;陥落済み＋体力500未満
ELSEIF BASE:0 < 500 && (CFLAG:218 < 1 || FLAG:7 == 2)
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		IF RAND:3 == 0
			WSTR:(K++) = 「지쳤어」
			KSTR:(K++) = 「그치만 채워진 기분……」
			WSTR:(K++) = 축 늘어진 몸을 %CALLNAME:MASTER%에게 맡긴 채, %CALLNAME%은(는) 행복한 듯 미소지었다.
		ELSEIF RAND:2 == 0
			KSTR:(K++) = 「이제 안 돼…… 야……」
			WSTR:(K++) = 몸을 시트에 내던지고 가쁜 숨을 몰아쉬며 %CALLNAME%은(는) 쾌락의 여운에 젖어 있다
			WSTR:(K++) = 담요를 덮어주자 %CALLNAME%은(는) 감사의 눈길을 %CALLNAME:MASTER%에게 보냈다.
		ELSE
			WSTR:(K++) = 지칠 대로 지쳤는데도 %CALLNAME%은(는) %CALLNAME:MASTER%에게 매달린 채 떨어지려 하지 않는다.
			WSTR:(K++) = 어찌할까 고민하고 있자니, 가슴팍에서 작은 숨소리가 들려왔다.
			KSTR:(K++) = 「응…… %CSTR:이인칭%…… 좋아해…… 놓지 않을… 거야……」
			WSTR:(K++) = 쓴웃음을 지으며 %CALLNAME%을(를) 상냥하게 눕히자, %CALLNAME%이(가) 행복한 듯 잠꼬대를 중얼거렸다.
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		IF RAND:2 == 0
			WSTR:(K++) = 「하아, 하아……」
			KSTR:(K++) = 「기분… 좋았어……%ハート()%」
		ELSE
			KSTR:(K++) = 「더… 할래……」
		ENDIF
		WSTR:(K++) = %CALLNAME%은(는) 몸에 남은 쾌락의 여운에 때때로 경련하며 정욕에 젖은 눈동자를 %CALLNAME:MASTER%에게 향했다.
		WSTR:(K++) = 「더…… 망가져서 기절해버릴 때까지… 섹스해줘……」
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		IF RAND:2 == 0
			KSTR:(K++) = 「하아… 하아…%ハート()%」
		ELSE
			KSTR:(K++) = 「오늘도 대단했어」
			WSTR:(K++) = 「다음에도 또 부탁해……」
		ENDIF
		WSTR:(K++) = 체력을 다 썼는지 %CALLNAME%은(는) 몸을 움직이지 못하는 것 같다.
		KSTR:(K++) =  
		IF RAND:2 == 0
			WSTR:(K++) = 「감사했습니다아%ハート()%」
			WSTR:(K++) = 떠나갈 때 엉덩이를 한 대 찰싹 때려주자 %CALLNAME%은(는) 기쁜 듯이 감사 인사를 건넸다.
		ELSE
			WSTR:(K++) = 「감사합니다!」
			KSTR:(K++) = 「발길질당하다니, %CSTR:일인칭%은(는) 행복한 사람이야……」
			WSTR:(K++) = %CALLNAME%의 얼굴을 발로 짓밟자, %CALLNAME%은(는) 자신의 입장을 떠올리며 조교에 대한 감사를 표했다.
		ENDIF
	ENDIF
	CFLAG:218 = 1
;陥落済み
ELSEIF CFLAG:219 < 4 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		IF RAND:3 == 0
			WSTR:(K++) = 「아…… 벌, 벌써 끝나?」
			KSTR:(K++) = 「응, 알겠어……」
			KSTR:(K++) = 「그치만, 또 불러줘. 약속이야?」
			WSTR:(K++) = 고분고분한 척을 하고 있지만 어딘지 불만스러워 보인다
		ELSEIF RAND:2 == 0
			KSTR:(K++) = 「잔뜩 사랑받아 버렸어♪」
			WSTR:(K++) = %CALLNAME%은(는) 몸을 %CALLNAME:MASTER%의 팔에 비비며 사랑스럽다는 듯 몇 번이고 팔에 키스를 한다.
			KSTR:(K++) = 「%CSTR:일인칭%도 잔뜩 사랑해줬어」
			KSTR:(K++) = 「기쁘지, %CSTR:이인칭%?」
			WSTR:(K++) = %CALLNAME%은(는) 장난스레 올려다보며 얼굴을 가까이 대고 %CALLNAME:MASTER%에게 키스를 졸랐다.
		ELSE
			KSTR:(K++) = 「있잖아… %CSTR:이인칭%」
			WSTR:(K++) = 쾌락의 여운으로 얼굴을 붉힌 채, %CALLNAME:MASTER%에게 안긴 채로 %CALLNAME%은(는) 얼굴을 바짝 기대온다.
			WSTR:(K++) = 「%CSTR:이인칭%이(가) 다른 애한테도 야한 짓 하는 건 알고 있어」
			WSTR:(K++) = 「하지만…… 제일 사랑하는 건 %CSTR:일인칭%이지?」
			KSTR:(K++) = 　
			KSTR:(K++) = 「자, 어서 인정하고 『가장 사랑한다』고 말해.」
			KSTR:(K++) = 「그러지 않으면 다음부턴 사랑해주지 않을 거야♪」
			WSTR:(K++) = %CALLNAME%의 응석은 좀처럼 끝날 것 같지 않다……
		ENDIF
	;淫乱、娼婦
		IF RAND:3 == 0
			WSTR:(K++) = 「더, 더 야한 짓 하고 싶어」
			WSTR:(K++) = 「%CSTR:이인칭%, 또 불러줘?」
		ELSEIF RAND:2 == 0
			WSTR:(K++) = 「벌써 끝이야?」
			KSTR:(K++) = 「더욱더 기분 좋은 거 즐기고 싶어……」
			WSTR:(K++) = 투정 부리는 어린아이처럼 %CALLNAME%은(는) %CALLNAME:MASTER%에게 안겨든다.
			KSTR:(K++) = 「더 잔뜩 섹스하고 싶어」
			IF HAVE_PENIS()
				KSTR:(K++) = 「저-엉액 더 내보내고 싶어…… 아, 앙%ハート()%」
			ELSE
				KSTR:(K++) = 「저-엉액 더 잔뜩 마시고 싶어…… 아, 앙%ハート()%」
			ENDIF
			WSTR:(K++) = 참지 못하게 된 %CALLNAME%은(는) %CALLNAME:MASTER%의 팔에 사타구니를 비비며 쾌락을 탐하고 있다.
		ELSE
			KSTR:(K++) = 「응…… 으응… 아, ……읏…… 하앙…」
			WSTR:(K++) = 아직 쾌감이 몸에서 가시지 않은 것인지, 때때로 몸을 경련하며 %CALLNAME%은(는) 작게 헐떡이고 있다
			WSTR:(K++) = 거친 숨을 내쉬며 얼굴을 붉히고 정욕에 젖어 든 눈동자를 %CALLNAME:MASTER%의 사타구니로 향하고 있었다.
			KSTR:(K++) = 
			KSTR:(K++) = 「기다려…… 자 봐, 아직 할 수 있어……」
			WSTR:(K++) = 덮치고 싶은 마음을 결사적으로 억누르며, %CALLNAME:MASTER%은(는) %CALLNAME%에게 등을 돌렸다.
		ENDIF
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		;WSTR:(K++) = 「아…… 벌, 벌써 끝나?」
		IF RAND:3 == 0
			KSTR:(K++) = 「오늘도 잔뜩 괴롭혀주셔서 감사합니다, %CSTR:이인칭%」
		ELSEIF RAND:2 == 0
			KSTR:(K++) = 「다음엔…… 더 부탁드리겠어요」
		ELSE
			KSTR:(K++) = 「거기 있는 도구, 아직 안 썼잖아」
		ENDIF
		;WSTR:(K++) = %CALLNAME%はまだ虐められたいようだが無視して背中を向けた。
	ENDIF
	CFLAG:219 = 4
ENDIF

CALL 口上変数表示
;口上がなければ別の口上を呼び出す
IF RESULT == 0
	TRYCCALLFORM EVENTEND_ZZZ
	CATCH
	ENDCATCH
	
ENDIF

;--------------------------------------------------
;@KOJO_MESSAGE_COM関係（X1をキャラ番号に置換）
;コマンド実行時に出力されます
;--------------------------------------------------
@KOJO_MESSAGE_COM_PUB303_3
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL TRAIN_MESSAGE
	RETURN 0
ENDIF
;想定外の口上だとスキップ(これ消したらバグる)
IF SELECTCOM < 0 || SELECTCOM > 699
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_COM_PY1_PUB303_3
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_COM_PY1_PUB303_3
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;関数初期化
;-------------------------------------------------
CALL 口上変数初期化
 
CALLFORM COMTYPE_{SELECTCOM}
;-------------------------------------------------
;コマンド実行時のセリフ CFLAG 300～500
;-------------------------------------------------
IF 0 == 1
;=================================================
;愛撫系コマンド
;=================================================
ELSEIF RESULT == COMTYPE("愛撫系")
SIF TEQUIP:25 > 0 && ( SELECTCOM == 0 || SELECTCOM == 5 || SELECTCOM == 6 || SELECTCOM == 7 || SELECTCOM == 8 || SELECTCOM == 12 || SELECTCOM == 13 || SELECTCOM == 15 )
	GOTO SHOKUSHU_PLAY
SELECTCASE SELECTCOM
;-------------------------------------------------
;0,애무
;-------------------------------------------------
	CASE 0
		K_CALL:K = TRAIN_MESSAGE
		;初めて
		IF CFLAG:300 == 0
			IF 陥落( ) > 0 && (CFLAG:300 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"
					KSTR:(K++) = 「이러면, %CSTR:이인칭%의 인형 같잖아」
					KSTR:(K++) = 「좋아…… 더 잔뜩…… %CSTR:일인칭%(으)로 야한 인형 놀이 해줘%ハート()%」
					KSTR:(K++) = 「%CSTR:이인칭%은(는), 장난감은 소중히 다루는구나」
					WSTR:(K++) = 「좀 더 그…… 상냥하게…… 만져줬으면 좋겠어」
				;淫乱、娼婦	
				ELSEIF 陥落( ) > 0 && RESULTS == "음란"
					KSTR:(K++) = 「앙, 거기, 앗%ハート()%」
					WSTR:(K++) = 「찌릿찌릿 전기가 와서 엉망이 되어버리겠어%ハート()%」
				;服従、隷属	
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					;体格差二段階以上の場合
					IF (体格(PLAYER) - 体格()) >= 10
						KSTR:(K++) = 「이러면, %CSTR:이인칭%의 인형 같잖아」
						KSTR:(K++) = 「좋아…… 더 잔뜩…… %CSTR:일인칭%(으)로 야한 인형 놀이 해줘%ハート()%」
					ELSE
						KSTR:(K++) = 「%CSTR:이인칭%은(는), 장난감은 소중히 다루는구나」
						KSTR:(K++) = 「이렇게 부드럽게 만져주며…… 써줘서, 조금 기쁜걸」
					ENDIF
				ENDIF
			ENDIF
			;屈服刻印Lv3
			IF MARK:굴복각인 == 3 && (CFLAG:300 < 2 || FLAG:7 == 2) && !口上有無確認(0)
				KSTR:(K++) = 「뭔, 뭔가 만지는 법이 야하잖아?」
			ENDIF
			;それ以外
			IF (CFLAG:300 || FLAG:7 == 2) && !口上有無確認(0)
				KSTR:(K++) = 「어디 만지는 거야, 변태!」
				KSTR:(K++) = 「손놀림은 음흉하고 간지럽기만 해!」
			ENDIF
			CFLAG:300 = 1
		ELSE
			IF 陥落( ) > 0 && (CFLAG:300 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"
					WSTR:(K++) = 「%CSTR:이인칭%의 손길, 상냥해서…… 하, 앗, 하앙, 좋아, 좋아아♪」
					NSTR:(K++) = 「더, 더 만져줘……
					IF TALENT:아내
						NSTR:(K++) =  %CSTR:이인칭%의 귀여운 어린 아내
					ELSE
						NSTR:(K++) =  %CSTR:일인칭%
					ENDIF
					KSTR:(K++) = 을(를) 잔뜩 사랑해줘어…%ハート()%」
					WSTR:(K++) = 촉촉한 눈으로 올려다보며, %CALLNAME%은(는) 스스로 몸을 비벼대고 있다.
				;淫乱、娼婦	
				ELSEIF 陥落( ) > 0 && RESULTS == "음란"
					WSTR:(K++) = 「앗, 앗, 하앙%ハート()%」
					IF RAND:2 == 0
						KSTR:(K++) = 「더, 더 만져줘…… 가슴도, \@ TALENT:남자 ? 꼬추 # 봊이\@도오%ハート()%」
						KSTR:(K++) = 「맞아, 여기, 여기야♪」
						WSTR:(K++) = 욕정에 젖은 눈동자로 올려다보며, %CALLNAME%은(는) 몸을 강하게 밀착시켜 더한 쾌락을 탐하려 하고 있다.
					ELSE
						NSTR:(K++) =  「애태우지 말고
						IF TALENT:후타나리
							WSTR:(K++) = 고추랑 보지 맞대고 싶어어」
						ELSEIF HAVE_PENIS()
							WSTR:(K++) = 고추 써줘어」
						ELSE
							WSTR:(K++) = 보지에 뭔가 줘~」
						ENDIF
						KSTR:(K++) = 「더는 못 참겠어어♪」
						WSTR:(K++) = 욕정에 젖은 눈동자로 올려다보며, %CALLNAME%은(는) 한층 더한 조교를 간청했다.
					ENDIF
				;服従、隷属	
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					WSTR:(K++) = 「하아앗%ハート()%」
					IF RAND:2 == 0
						WSTR:(K++) = 「%CSTR:일인칭%의 야한 가슴도 \@ TALENT:남자 ? 꼬추도 # 보지도\@, %CSTR:이인칭%의 것이니까」
						WSTR:(K++) = 「더, 마음껏 희롱해서 울려보라구♪」
					ELSE
						WSTR:(K++) = 「다음은 %CSTR:일인칭%이(가) 기분 좋게 해줄 차례야」
					ENDIF
				ENDIF
				CFLAG:300 = 4
			ENDIF
			;屈服刻印Lv3
			IF MARK:굴복각인 == 3 && (CFLAG:300 < 2 || FLAG:7 == 2) && !口上有無確認(0)
				IF RAND:2 == 0
					KSTR:(K++) = 「햐앙! 마, 만지는 법이……」
					WSTR:(K++) = （이대로 계속되면 야한 기분이 될 것 같아……）
				ELSE
					KSTR:(K++) = 「안 돼! 이 이상은」
					WSTR:(K++) = 「%CSTR:일인칭%, 이상해져버릴 것 같아!」
				ENDIF
				CFLAG:300 = 3
			ENDIF
			;それ以外
			IF (CFLAG:300 || FLAG:7 == 2) && !口上有無確認(0)
				IF RAND:3 == 0
					WSTR:(K++) = 「어차피 할 거라면 조금만 더 상냥하게 만져주면 좋겠어」
				ELSEIF RAND:2 == 0
					KSTR:(K++) = 「그런 짓을 당해도」
					WSTR:(K++) = 「기, 기분 좋지 않거든…… 으앙」
				ELSE
					KSTR:(K++) = 「그런 곳 만져져 봤자」
					WSTR:(K++) = 「아무것도 안 느껴져. 허접」
				ENDIF
				CFLAG:300 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;1,커닐링구스
;-------------------------------------------------
	CASE 1
		K_CALL:K = TRAIN_MESSAGE
		;初めて
		IF CFLAG:301 == 0
			IF 陥落( ) > 0 && (CFLAG:303 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"
					IF TALENT:츤데레 || TALENT:반항적 || TALENT:건방짐 || TALENT:부끄럼쟁이
						WSTR:(K++) = 「으으으……」
						WSTR:(K++) = %CSTR:일인칭%은(는) \@ TALENT:소인체형 ?# %CALLNAME:MASTER%의 머리를 내리누르면서, \@얼굴을 새빨갛게 붉히며 눈을 질끈 감고 있다
						WSTR:(K++) = %CALLNAME:MASTER%의 눈앞에 비밀스러운 부위가 드러난 것이 부끄러워 어쩔 줄 모르는 모양이다
					ELSE
						WSTR:(K++) = 「읏, 큭, 후우, 으응」
						WSTR:(K++) = 「에, 헤헤. %CSTR:이인칭%, %CSTR:일인칭%의 콩알에 키스하는 것 같아……」
						WSTR:(K++) = 「조금 질투 날지도? 후후후」
					ENDIF
				;淫乱、娼婦	
				ELSEIF 陥落( ) > 0 && RESULTS == "음란"
					WSTR:(K++) = 「그래! 더, 더 세게 빨아줘!」
					WSTR:(K++) = 「%CSTR:이인칭%의 혀로 %CSTR:일인칭%을(를) 엉망으로 만들어줘♪」
				;服従、隷属	
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					KSTR:(K++) = 「%CSTR:이인칭%, 거긴 더러운 곳이야, 핥으면 안 돼애%ハート()%」
					WSTR:(K++) = %CALLNAME%은(는) %CALLNAME:MASTER%이(가) 핥을 때마다 흠칫 몸을 떨고 있다
				ENDIF
			ENDIF
			;屈服刻印Lv3
			IF MARK:굴복각인 == 3 && (CFLAG:303 < 2 || FLAG:7 == 2) && !口上有無確認(0)
				KSTR:(K++) = 「%CSTR:일인칭%의 보지 핥고 싶어?」
				WSTR:(K++) = 「%CSTR:이인칭%은(는) 진짜 변태네」
				WSTR:(K++) = 「……조금뿐이야?」
			ENDIF
			;それ以外
			IF (CFLAG:303 || FLAG:7 == 2) && !口上有無確認(0)
				KSTR:(K++) = 「햐앙!?」
				WSTR:(K++) = 「시, 싫어, 그런 데 핥지 마!」
				KSTR:(K++) = 「바보, 변태! 오줌 누는 곳을 핥고 즐거워하다니 머리가 어떻게 된 거야!」
			ENDIF
			CFLAG:301 = 1
		;二回目以降
		ELSE
			IF 陥落( ) > 0 && (CFLAG:301 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"
					KSTR:(K++) = 「아… 앗… 거기 안 돼」
					IF RAND:2 == 0 && TALENT:아내
						WSTR:(K++) = 「야한 새색시가 되어버릴 것 같아%ハート()%」
					ELSE
						WSTR:(K++) = 「%CSTR:일인칭%, 이상해져버려%ハート()%」
					ENDIF
					KSTR:(K++) = 「그치만, %CSTR:일인칭%이(가) 핥는 걸 잘하니까…… 어쩔 수 없잖아」
					WSTR:(K++) = %CALLNAME%은(는) 쾌감에 떨며 부끄러운 듯 가랑이를 밀착해왔다.
				;淫乱、娼婦	
				ELSEIF 陥落( ) > 0 && RESULTS == "음란"
					IF RAND:2 == 0
						WSTR:(K++) = 「꺄으응%ハート()% 클리 기분 좋아아%ハート()%」
						WSTR:(K++) = %CSTR:일인칭%은(는) \@ TALENT:소인체형 ?# %CALLNAME:MASTER%의 머리를 내리누르면서, \@얼굴을 새빨갛게 붉히며 눈을 질끈 감고 있다
					ELSE
						WSTR:(K++) = 「에, 헤헤. %CSTR:이인칭%, %CSTR:일인칭%의 콩알에 키스하는 것 같아……」
						WSTR:(K++) = 「%CSTR:이인칭%의 혀로 %CSTR:일인칭%을(를) 엉망으로 만들어줘♪」
					ENDIF
				;服従、隷属	
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					IF RAND:2 == 0
						WSTR:(K++) = 「%CSTR:일인칭%의 보지…… 하앙, 그렇게 맛있어?」
					ELSE
						WSTR:(K++) = 「아핫%ハート()% %CSTR:일인칭%의 보지, 벌써 흠뻑 젖어버렸어……」
						WSTR:(K++) = 「하앙, 못 참겠어… 미안해……」
					ENDIF
				ENDIF
				CFLAG:301 = 4
			ENDIF
			;屈服刻印Lv3
			IF MARK:굴복각인 == 3 && (CFLAG:301 < 2 || FLAG:7 == 2) && !口上有無確認(0)
				KSTR:(K++) = 「거길 핥아지는 거, 못 참겠어…… 앙%ハート()%」
				CFLAG:301 = 3
			ENDIF
			;それ以外
			IF (CFLAG:301 || FLAG:7 == 2) && !口上有無確認(0)
				IF RAND:2 == 0
					WSTR:(K++) = 「%CSTR:일인칭%의 보지…… 하앙, 그렇게 맛있어?」
				ELSE
					KSTR:(K++) = 「%CSTR:일인칭%의 혀가 기분 좋아서…」
				ENDIF
				CFLAG:301 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;3,손가락삽입
;-------------------------------------------------
	CASE 3
		K_CALL:K = TRAIN_MESSAGE
		;初めて
		IF CFLAG:303 == 0
			;陥落済み
			IF 陥落( ) > 0 && (CFLAG:303 < 3 || FLAG:7 == 2)
				IF TALENT:처녀
					IF HAVE_PENIS(PLAYER)
						WSTR:(K++) = 「가랑이에 손가락을 넣을 거야? 고추가 아니어도 돼?」
					ELSE
						WSTR:(K++) = 「고추가 없다면 어쩔 수 없네」
					ENDIF
				ELSE
					WSTR:(K++) = 「확실히 애무는 필요해」
					WSTR:(K++) = 「아니면 그런 플레이가 좋아?」
				ENDIF
			ELSE
				WSTR:(K++) = 「에, 손가락을 넣는다고? 무리야, 안 들어가!」
			ENDIF
			CFLAG:303 = 1
		ELSE
			IF 陥落( ) > 0 && (CFLAG:303 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"
					IF RAND:2 == 0
						KSTR:(K++) = 「응, 아, 앗…… 아, 거기, 좋아…… 읏!」
					ELSE
						KSTR:(K++) = 「아아…… %CSTR:이인칭%의 손가락 움직임, 야해… 히앗!」
					ENDIF
					WSTR:(K++) = 흠뻑 젖은 비부를 휘젓는 손가락 감촉에 %CALLNAME%은(는) 몸을 떨며 애액을 넘쳐 흘렸다.
				;淫乱、娼婦	
				ELSEIF 陥落( ) > 0 && RESULTS == "음란"
					IF RAND:2 == 0
						KSTR:(K++) = 「아, 앙! 좋아! …더! 더 질척질척 후벼줘어!」
					ELSE
						KSTR:(K++) = 「손가락 따위론 감, 감질나」
						KSTR:(K++) = 「더 큰 거 줘-어!」
						NSTR:(K++) =  말과는 정반대로
					ENDIF
					WSTR:(K++) = %CALLNAME%의 질 내부는 탐욕스럽게 손가락을 물고, 빨아들이듯 부드러운 질벽으로 세게 조여온다.
				;服従、隷属	
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					IF RAND:2 == 0
						WSTR:(K++) = 「응후, 응… 딱히, 앗, 안 적시고 그냥 넣어도, 돼? 아, 흐앗」
					ELSE
						KSTR:(K++) = 「응후, 응… %CSTR:일인칭%, 노예니까」
						WSTR:(K++) = 「좀 더 빙글빙글 문질러줘…」
					ENDIF
				ENDIF
				CFLAG:303 = 4
			ENDIF
			;屈服刻印Lv3
			IF MARK:굴복각인 == 3 && (CFLAG:303 < 2 || FLAG:7 == 2) && !口上有無確認(0)
				WSTR:(K++) = 「응, 아, 하앙…… 손가락, 기분 좋아…… 아, 앗」
				CFLAG:303 = 3
			ENDIF
			;それ以外
			IF (CFLAG:303 || FLAG:7 == 2) && !口上有無確認(0)
				IF RAND:2 == 0
					WSTR:(K++) = 「응, 이런 거…… 안 좋아… 아… 앗」
				ELSE
					WSTR:(K++) = 「아야! 좀 더 살살 안 하면 상처 난단 말이야」
				ENDIF
				CFLAG:303 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;4,애널핥기
;-------------------------------------------------
	CASE 4
		K_CALL:K = TRAIN_MESSAGE
		;初めて
		IF CFLAG:304 == 0
			;陥落済み
			IF 陥落( ) > 0
				IF TEQUIP:주도권
					KSTR:(K++) = 「변태인 %CSTR:이인칭%에게 핥게 해줄게♪」
				ELSE
					KSTR:(K++) = 「제대로 깨끗하게 씻었으니까… 이상한 냄새라든가, 그거라든가…… 안 날 거야」
				ENDIF
			ELSE
				IF TEQUIP:주도권
					KSTR:(K++) = 「자, 변태인 %CSTR:이인칭%에게 핥게 해줄게」
					WSTR:(K++) = 「감사하라구」
				ELSE
					KSTR:(K++) = 「그런… 곳을… 핥다니… 이 변태…!」
				ENDIF
			ENDIF
			CFLAG:304 = 1
		ELSE
			IF 陥落( ) > 0 && (CFLAG:304 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"
					IF RAND:2 == 0
						KSTR:(K++) = 「이런 짓, 부끄럽지만… %CSTR:이인칭%이(가) 핥고 싶다면, 좋아…%ハート()%」
					ELSE
						KSTR:(K++) = 「앗… 앗…%ハート()%」
						WSTR:(K++) = 「그런 안쪽까지잇%ハート()% 그렇게 깊숙이는 안 된단 말이야♪」
					ENDIF
				;淫乱、娼婦	
				ELSEIF 陥落( ) > 0 && RESULTS == "음란"
					IF RAND:2 == 0
						KSTR:(K++) = 「엉덩이 풀어주는 거야?」
						WSTR:(K++) = 「그럼 부탁할게♪」
					ELSE
						KSTR:(K++) = 「이 감촉」
						WSTR:(K++) = 「버릇이 되어버리겠어♪」
					ENDIF
				;服従、隷属	
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					IF RAND:2 == 0
						KSTR:(K++) = 「확실히」
						WSTR:(K++) = 「나중에 쓸 거니까 미리 풀어두지 않으면 안 돼」
					ELSE
						KSTR:(K++) = 「제대로 약 먹고, 비데 써서 안쪽부터 바깥까지 깨끗하게 관리하고 있어」
					ENDIF
				ENDIF
				CFLAG:304 = 4
			ENDIF
			;屈服刻印Lv3
			IF MARK:굴복각인 == 3 && (CFLAG:304 < 2 || FLAG:7 == 2) && !口上有無確認(0)
				KSTR:(K++) = 「시, 렁…」
				WSTR:(K++) = 「엉, 엉덩이 구멍이 근질근질거려……」
				CFLAG:304 = 3
			ENDIF
			;それ以外
			IF (CFLAG:304 || FLAG:7 == 2) && !口上有無確認(0)
					IF RAND:2 == 0
						KSTR:(K++) = 「더러워… 이런 짓…」
					ELSE
						KSTR:(K++) = 「또 하는 거야…… 변태」
					ENDIF
				CFLAG:304 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;5,애널애무
;-------------------------------------------------
	CASE 5
		K_CALL:K = TRAIN_MESSAGE
		;初めて
		IF CFLAG:305 == 0
			IF 陥落( ) > 0 && (CFLAG:305 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"
					WSTR:(K++) = 「하지만…… %CSTR:이인칭%이(가) 어떻게든 하고 싶다면…… 좋아%ハート()%」
					WSTR:(K++) = 「하지만…… %CSTR:이인칭%이(가) 어떻게든 하고 싶다면…… 좋아%ハート()%」
				;淫乱、娼婦
				ELSEIF 陥落( ) > 0 && RESULTS == "음란"
					KSTR:(K++) = 「엉덩이 준비운동이네」
					IF RAND:2 == 0
						WSTR:(K++) = 「찢어지지 않게 하려면 확실히 필요하네」
					ELSE
						WSTR:(K++) = 「갑자기 푹, 찔러넣어도 되는데%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					KSTR:(K++) = 「거긴 섹스하는 곳이 아니잖아, %CSTR:이인칭%?」
					WSTR:(K++) = %CALLNAME:MASTER%은(는) 아랑곳하지 않고 애무를 계속한다
					KSTR:(K++) = 「지, 진심이구나, %CSTR:이인칭%」
					WSTR:(K++) = 「그럼……」
					KSTR:(K++) = 　
					KSTR:(K++) = 「%CSTR:일인칭%의 엉덩이 구멍, 야한 구멍으로 만들어주세요」
					WSTR:(K++) = %CALLNAME%은(는) 공손한 어조로 조교의 지속을 간청했다
				ENDIF
			ELSE
				WSTR:(K++) = 「엉덩이, 만질 거야? …햣!?」
				WSTR:(K++) = 「트, 틀려. 거긴 손가락 따위를 넣는 곳이 아니란 말이야!」
			ENDIF
			CFLAG:305 = 1
		ELSE
			IF 陥落( ) > 0 && (CFLAG:305 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"
					WSTR:(K++) = %CALLNAME%은(는) \@TALENT:유아체형 || TALENT:소인체형 ? 살집이 얇은 어린 # 엉\@덩이를 떨면서도 솔직하게 몸을 맡기고 있다.
					WSTR:(K++) = %CALLNAME%은(는) \@TALENT:유아체형 || TALENT:소인체형 ? 살집이 얇은 어린 # 엉\@덩이를 떨면서도 솔직하게 몸을 맡기고 있다.
				;淫乱、娼婦	
				ELSEIF 陥落( ) > 0 && RESULTS == "음란"
					IF RAND:2 == 0
						KSTR:(K++) = 「아하앙♪ 조, 좋아아」
						KSTR:(K++) = 「엉덩이 보지 기분 좋아아…… 저기, 더어%ハート()%」
						WSTR:(K++) = %CALLNAME%은(는) 애널에서 솟구치는 쾌락에 몸을 푹 맡긴 채 엉덩이를 강하게 밀착해왔다.
					ELSE
						KSTR:(K++) = 「더 굵고 긴 걸로 줘어%ハート()%」
						WSTR:(K++) = 손가락 애무로는 성에 차지 않는 %CALLNAME%은(는) 스스로 허리를 움직여 더욱 쾌락을 이끌어내려 하고 있다.
					ENDIF
				;服従、隷属	
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					KSTR:(K++) = 「아아앙, 엉덩이이♪ 문질문질 당하는 거 기분 좋아아%ハート()%」
					WSTR:(K++) = 원하는 대로 난폭하게 손가락을 애널에 찔러넣고 구멍을 넓히듯 휘저어주었다.
				ENDIF
				CFLAG:305 = 4
			ENDIF
			;屈服刻印Lv3
			IF MARK:굴복각인 == 3 && (CFLAG:305 < 2 || FLAG:7 == 2) && !口上有無確認(0)
				KSTR:(K++) = 「응큭… 응, 으앗」
				WSTR:(K++) = 아무래도 조금씩이나마 쾌감을 받아들이고 있는 것 같다.
				CFLAG:305 = 3
			ENDIF
			;それ以外
			IF (CFLAG:305 || FLAG:7 == 2) && !口上有無確認(0)
				WSTR:(K++) = 「그러니까 간지럽다니까아… 싫, 히양!」
				CFLAG:305 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;6,가슴주무르기
;-------------------------------------------------
	CASE 6
		K_CALL:K = TRAIN_MESSAGE
		;初めて
		IF CFLAG:306 == 0
			;陥落済み
			IF 陥落( ) > 0 && FLAG:7 == 2
				;ちっぱい
				IF BUST(TARGET) < 3
					WSTR:(K++) = 「작은 가슴이라 미안해…」
				;でっぱい
				ELSEIF BUST(TARGET) > 3
					WSTR:(K++) = 「어때? 커다란 가슴%ハート()%」
				ELSE
					WSTR:(K++) = 「가슴 주무르면 커진다는 거 진짜야?」
				ENDIF
			;屈服刻印Lv3
			ELSEIF MARK:굴복각인 == 3
				WSTR:(K++) = 「에, 가슴?」
				WSTR:(K++) = 「알았어, 아프게 하지 마…」
			ELSE
				KSTR:(K++) = 「에, 가슴? 주물러도 될 리가 없잖아」
				WSTR:(K++) = 「자기 가슴이나 주무르고 있으시지」
			ENDIF
			CFLAG:306 = 1
		;二回目以降
		ELSE
			IF 陥落( ) > 0 && (CFLAG:306 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"
					IF ABL:종족 == 0 && RAND:2 == 0
						;巨乳or爆乳〇学生
						IF (BUST(TARGET) > 3)
							KSTR:(K++) = 「아직 어린애인데도 이렇게나 커다란 %CSTR:일인칭%의 가슴」
							KSTR:(K++) = 「%CSTR:이인칭% 마음대로 해도 좋아……%ハート()%」
						ELSE
							KSTR:(K++) = 「아직 크진 않지만, %CSTR:일인칭%의 가슴 마음대로 해도 좋아…」
						ENDIF
					ELSE
