						;精液が溜まっているか
						IF TCVAR:TARGET:101  > 0
							KSTR:(K++) = 「아… 흘러넘쳐 버렸어」
							IF RAND:3 == 0
								KSTR:(K++) = 「흘린 만큼 다시 넣어주지 않으면 곤란해%ハート()%」
							ELSEIF RAND:2 == 0
								KSTR:(K++) = 「어린애 상대로 이렇게나 사정하다니 구제불능 변태네♪」
							ELSE
								KSTR:(K++) = 「얼마나 사정한 거야, 다 들어갈 리가 없잖아%ハート()%」
							ENDIF
							WSTR:(K++) = 불평을 늘어놓는 %CALLNAME%이지만 본심이 아니라는 건 명백하다
						ELSE
							IF RAND:2 == 0
								IF TALENT:처녀
									KSTR:(K++) = 「처녀막까지 다 보여지고 있네♪」
								ELSE
									KSTR:(K++) = 「하아, 하앙…… 전부 보여지고 있네…♪」
								ENDIF
								WSTR:(K++) =  %CALLNAME%은(는) 수치심이 가져다주는 쾌감에 황홀해하고 있다.
								KSTR:(K++) = 「벌써 질척질척해애… 어서 자지를 원한다고 옴찔거리고 있어어… 앗, 하앙!」
								WSTR:(K++) =  삽입당했을 때를 상상한 것일까, %CALLNAME%의 음순이 퓻 하고 작게 애액을 뿜어냈다.
							ELSE
								KSTR:(K++) = 「자 봐봐…」
								IF TALENT:처녀
									KSTR:(K++) = 「%CSTR:일인칭%의 야한 구멍이, 처음인 자지를, 어서 원하고 있어어%ハート()%」
								ELSE
									KSTR:(K++) = 「%CSTR:일인칭%의 야한 구멍이 자지를 원하고 있어어%ハート()%」
								ENDIF
								KSTR:(K++) = 재촉하듯 허리를 흔드는 %CALLNAME%의 움직임에 맞추어 질 입구도 요염하게 꿈틀거리고 있다
							ENDIF
						ENDIF
					;服従、隷属	
					ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
							IF RAND:3 == 0
								KSTR:(K++) = 「네, 여-기♪」
								KSTR:(K++) = 「보여지는 것만으로도 젖어버리는, %CSTR:일인칭%의 변태 보지」
								WSTR:(K++) = 「%CSTR:이인칭%이(가) 잔뜩 『교육』해줄 필요가 있겠어%ハート()%」
							ELSE
								KSTR:(K++) = 「자 봐, 어린애 보지의 개장이야」
								KSTR:(K++) = 「넣든 때리든 뭐든 해도 좋으니까 얼른♪」
								KSTR:(K++) = 재촉하듯 허리를 흔드는 %CALLNAME%의 움직임에 맞추어 질 입구도 요염하게 꿈틀거리고 있다
							ENDIF
					ENDIF
					CFLAG:309 = 4
				ENDIF
				;屈服刻印Lv3
				IF MARK:굴복각인 == 3 && (CFLAG:309 < 2 || FLAG:7 == 2) && !口上有無確認(0)
					KSTR:(K++) = 「응, 싫어… 빤히 쳐다보고 있어…… 아아… 싫어」
					IF RAND:2 == 0
						KSTR:(K++) = 수치심에 떨면서도, 그러나 %CALLNAME%은(는) 저항하지 않고 젖은 은밀한 부위를 벌려 보여주었다.
					ELSE
						KSTR:(K++) = 수치심에 떨면서도 %CALLNAME%은(는) 무의식중에 스스로 허리를 내밀고 있다.
					ENDIF
					CFLAG:309 = 3
				ENDIF
				;それ以外
				IF (CFLAG:309 || FLAG:7 == 2) && !口上有無確認(0)
					IF RAND:2 == 0
						KSTR:(K++) = 「으으… 부끄러워……」
					ELSE
						KSTR:(K++) = 「으으… 이런 짓을 시키다니」
						WSTR:(K++) = 「언젠가 복수해줄 테니까……」
					ENDIF
					CFLAG:309 = 2
				ENDIF
			ENDIF
		ENDIF
