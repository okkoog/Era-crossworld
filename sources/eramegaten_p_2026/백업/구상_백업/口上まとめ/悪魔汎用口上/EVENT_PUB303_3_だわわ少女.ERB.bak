						KSTR:(K++) = 「%CSTR:이인칭%의 얼굴을 보고, 가득 『사랑받고 있다』는 게 느껴져…%ハート()%」
						WSTR:(K++) = %CALLNAME%은(는) 행복한 듯 %CALLNAME:MASTER%에게 미소 짓더니 천천히 허리를 움직이기 시작했다.
						WSTR:(K++) = 「응, 응, 아, 아… %CSTR:일인칭%도… 앗, 하앙… 사랑해… 앗! 앗! …좋아… 앗… 앙!」
					ELSE
						KSTR:(K++) = 「%CSTR:일인칭%의 안… %CSTR:이인칭%의 자지로 가득 차 있어… 앗, 앗」
						WSTR:(K++) = %CALLNAME%은(는) 기쁜 듯 자신의 하복부를 쓰다듬고 있다.
						WSTR:(K++) = 「기쁘고, 행복하고, 기분 좋아서, %CSTR:일인칭%, 녹아버릴 것 같아…… 더, 더 잔뜩 느끼게 해줘어%ハート()%」
						IF 体格差() > 1
							WSTR:(K++) = %CALLNAME%은(는) 유열과 환희의 눈물을 흘리며 격렬하게 허리를 흔드는 %CALLNAME:MASTER%의 공세를 받아내고 있다……
						ELSE
							WSTR:(K++) = 유열과 환희의 눈물을 흘리며 %CALLNAME%은(는) 격렬하게 허리를 흔들고 있다……
						ENDIF
					ENDIF
				;淫乱、娼婦	
				ELSEIF 陥落( ) > 0 && RESULTS == "음란"
					IF RAND:3 == 0
						WSTR:(K++) = 「보지로 섹스하는 거, 너~무 됴아%ハート()%」
						KSTR:(K++) = 「앙! 앙! 조아…… %CSTR:일인칭%, 좋아, 조아아%ハート()%」
						WSTR:(K++) = %CALLNAME%은(는) 스스로 허리를 격렬하게 움직이며 쓰나미 같은 유열에 몸을 내맡기고 있다.
						WSTR:(K++) = 혀가 꼬인 본능 그대로의 교성을 방 안에 울려 퍼뜨리고 있었다.
					ELSEIF RAND:2 == 0
						KSTR:(K++) = 「좋아! 좋아아!! 섹스! 섹스으!! 기분 좋아아!!」
						WSTR:(K++) = 격렬하게 허리를 마구 흔들며 %CALLNAME%은(는) 쾌락의 바다에 빠져들고 있다.
						WSTR:(K++) = 「하앙! 하앙! 자지, 됴아아!! 더어! 더 %CSTR:일인칭%을(를) 범해줘어어! 으아앙!!」
						WSTR:(K++) = 자신의 말이 스스로 흥분을 더욱 부추기는 것인지, %CALLNAME%의 꿀단지가 빨아들이듯 꼬옥 조여들었다.
					ELSE
						KSTR:(K++) = 「에헤헤… %CSTR:이인칭%…… 가-득 기분 좋게 해줄게……%ハート()%」
						WSTR:(K++) = %CALLNAME%은(는) 허리를 요염하게 돌리며 질벽이 애원하듯 음란하게 꿈틀거린다.
						WSTR:(K++) = 「아, 하앙… 아하아%ハート()% 자 봐아… 정-액 잔뜩… %CSTR:일인칭%한테 내보내줘어. 잔뜩 줘어%ハート()%」
					ENDIF
				;服従、隷属	
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					IF RAND:3 == 0
						WSTR:(K++) = 「%CSTR:일인칭%의 보지, 잔뜩 써줘%ハート()%」
					ELSEIF RAND:2 == 0
						KSTR:(K++) = 「%CSTR:이인칭%에게 보지 섹스 받고」
						WSTR:(K++) = 「%CSTR:일인칭%은(는) 정말 행복해%ハート()%」
					ELSE
						KSTR:(K++) = 「보지 조교 대단해애」
						WSTR:(K++) = 「야한 조교 당하는 거 엄청 기분 좋아아」
					ENDIF
				ENDIF
				CFLAG:332 = 4
			ENDIF
			;屈服刻印Lv3
			IF MARK:굴복각인 == 3 && (CFLAG:332 < 2 || FLAG:7 == 2) && !口上有無確認(0)
				KSTR:(K++) = 「앗… 핫, 응아앗♪」
				IF RAND:2 == 0
					WSTR:(K++) = 「기… 기분 좋아… 아… 앗♪」
				ELSE
					WSTR:(K++) = 「더는, 안 돼… 안 된다구우… 읏♪」
				ENDIF
				CFLAG:332 = 3
			ENDIF
			;それ以外
			IF (CFLAG:332 || FLAG:7 == 2) && !口上有無確認(0)
				IF RAND:2 == 0
					WSTR:(K++) = 「윽, 앗, 난폭하게 굴면 용서 안 할 거야, 앗」
				ELSE
					WSTR:(K++) = 「이, 이쪽 보지 마…」
					WSTR:(K++) = 「%CSTR:이인칭% 얼굴 따위 보고 싶지 않아……」
				ENDIF
				CFLAG:332 = 2
			ENDIF
		ENDIF
