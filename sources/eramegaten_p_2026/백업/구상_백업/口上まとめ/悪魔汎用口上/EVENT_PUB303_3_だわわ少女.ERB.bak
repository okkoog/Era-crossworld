					IF 体格差() > 1
						KSTR:(K++) = 「큭…」
						KSTR:(K++) = %CALLNAME%에게 스스로 페니스를 물게 했지만, %CALLNAME%의 허리가 크기와 쾌락 때문에 멈출 것 같았기에 엉덩이를 잡고 허리를 쳐올려 비틀어 찔러넣었다.
						WSTR:(K++) = 페니스는 뿌리 끝까지 들어가지 못하고 70% 정도밖에 안 들어갔지만, 비좁은 질의 조임으로 체중을 실어도 안정되어 있다.
						WSTR:(K++) = 끝부분이 꼬들꼬들한 자궁경부에 닿아 기분 좋다. %CALLNAME%은(는) 끊임없이 자궁구를 자극받아 쾌락과 고통이 뒤섞이고 있다.
					ENDIF
					K:1 = RAND:3
					IF K:1 == 0
						KSTR:(K++) = 「응, 쪽, 냠… 응, 으응, 앗, 하앙… 쪽… 냠, 으응…」
						WSTR:(K++) = %CALLNAME%은(는) 이어진 채 %CALLNAME:PLAYER%의 위로 덮쳐오며 정열적으로 혀를 얽어왔다.
						KSTR:(K++) = 「으응… 푸하아… 좋아해, %CSTR:이인칭% 너무 좋아해… 앗, 앙… 아아, 좋아아, 기분 좋아… 응, 앙」
						WSTR:(K++) = 촉촉하게 젖은 눈동자를 %CALLNAME:MASTER%의 얼굴에서 떼지 않은 채, %CALLNAME%은(는) 천천히 허리를 비틀며 쾌락에 빠져들었다……
					ELSEIF K:1 == 1
						KSTR:(K++) = 「앗! 앙! 앙! 조, 좋아아, 기분 좋아아…! 앗♪ 앗♪」
						WSTR:(K++) = 쾌락의 파도를 견디지 못한 %CALLNAME%은(는) 상체를 힘없이 쓰러뜨리며 %CALLNAME:PLAYER%의 가슴 위에 몸을 맡긴다.
						KSTR:(K++) = 「응, 흣, 앗! 앙, 앙, 앙! 앗! 안 대앳, 이제 안 대애앳! 아앗, 아아아!」
						KSTR:(K++) = %CALLNAME:PLAYER%의 격렬한 쳐올림에 연약하게 저항하면서,
						WSTR:(K++) = 그런데도 %CALLNAME%의 \@体格差() > 1 ? 질은 꿈틀거리고 # 허리는 제멋대로 격렬히 흔들리며\@ 극상의 쾌락을 이끌어내는 것을 멈추려 하지 않았다……
					ELSE
						KSTR:(K++) = 「이 모습, %CSTR:이인칭%을(를) 범하려는 것 같아서 흥분되는걸… 후후후%ハート()%」
						IF 体格差() > 1
							WSTR:(K++) = %CALLNAME%은(는) 즐거운 듯한 미소를 띠더니 크게 허리를 위아래로 움직이기 시작했다.
							KSTR:(K++) = 「햐앙! 햐앙! 햐아앙!!」
							KSTR:(K++) = 「어, 때, 조그마한 %CSTR:일인칭%에게 범해지는 기분은%ハート()% 햐앙! 하앙%ハート()%」
							WSTR:(K++) = 시츄에이션에 취한 %CALLNAME%은(는), 한층 더 크게 허리를 흔들기 시작했다.
						ELSE
							WSTR:(K++) = %CALLNAME%은(는) 즐거운 듯한 미소를 띠더니 격렬하게 허리를 흔들기 시작했다.
							KSTR:(K++) = 「앙! 앙! 앙! 어때 %CSTR:이인칭%, %CSTR:일인칭%에게 범해지는 기분은! 햐앙! 하앙!」
							WSTR:(K++) = 시츄에이션에 취해 있는 %CALLNAME%은(는), 더욱 강하게 허리를 흔들고 있다.
						ENDIF
					ENDIF
				;淫乱、娼婦	
				ELSEIF 陥落( ) > 0 && RESULTS == "음란"
					;相手が主導権を持っていて、前回コマンドも騎乗位の場合
					IF PREVCOM == 66 && TEQUIP:주도권 == 1
						KSTR:(K++) = 「자, 자」
						WSTR:(K++) = 「점점 더 정-액 쥐어짜줄게♪」
					ELSEIF RAND:4 == 0
						KSTR:(K++) = 「이런 자지에 꼬챙이처럼 꿰뚫리면」
						KSTR:(K++) = 「야한 몸이 되어버리는 건 어쩔 수 없네%ハート()%」
						WSTR:(K++) = %CALLNAME%은(는) 질 속의 페니스를 음미하듯 허리를 꿈틀거리더니 서서히 허리를 흔들기 시작했다.
					ELSEIF RAND:3 == 0
						KSTR:(K++) = 「그럼, %CSTR:일인칭%이(가) 넣을게…… 아아아, 하아, 전부 들어가 버렸어%ハート()%」
						WSTR:(K++) = %CALLNAME%은(는) 질 속의 페니스를 음미하듯 허리를 꿈틀거리더니 서서히 허리를 흔들기 시작했다.
						KSTR:(K++) = 「조, 좋아아… 기분 좋아아…… 하아, 하앙, 하앙%ハート()%」
						KSTR:(K++) = 「저기, 기분 좋아?」
						WSTR:(K++) = %CALLNAME:MASTER%은(는) 대답 대신 아래에서부터 강하게 허리를 쳐올렸다.
						WSTR:(K++) = 「꺄앙! 기뻐♪ 더, 더어! 앙♪ 아앙♪」
					ELSEIF RAND:2 == 0
						KSTR:(K++) = 「앙, 앙%ハート()% 앙, 핫, 앗! 앙%ハート()%」
						WSTR:(K++) = %CALLNAME%은(는) %CALLNAME:PLAYER%의 가슴에 손을 얹고 정신없이 허리를 흔들고 있다.
						KSTR:(K++) = 「앗! 앗! 앗! 좋아…%ハート()% 보지 기분 좋아아%ハート()% 더어♪ 더어어♪ 히아앙!!」
						WSTR:(K++) = 침을 흘리며 열병에 들뜬 듯 눈동자를 풀면서 %CALLNAME%은(는) 더욱 격렬하게 허리를 부딪치기 시작했다……
					ELSE
						KSTR:(K++) = 「아하♪ %CALLNAME:PLAYER%의 범해지는 얼굴, 엄청 귀여워…%ハート()%」
						KSTR:(K++) = 「아하앙! …%CSTR:이인칭%의 자지… 커져 있어…♪」
						WSTR:(K++) = 「%CSTR:일인칭%한테 범해져서 기뻐?」
						KSTR:(K++) = 「시간을 들여서 듬뿍 해줄게…%ハート()%」
						WSTR:(K++) = 「귀여워해줘, 사랑해줘, %CSTR:일인칭%의 것이야… 꺅♪ 앗, 하앙! 하아앙!!」
					ENDIF
				;服従、隷属	
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					KSTR:(K++) = 「응, 으앗, 아아, 기분 좋아%ハート()%」
					WSTR:(K++) = 「응훗, %CSTR:이인칭%은(는) 어때? 아, 앗, 기분 좋아?」
				ENDIF
				CFLAG:338 = 4
			ENDIF
			;屈服刻印Lv3
			IF MARK:굴복각인 == 3 && (CFLAG:338 < 2 || FLAG:7 == 2) && !口上有無確認(0)
				KSTR:(K++) = 「응, 앙, 앙, 하앙… 왠지 %CSTR:일인칭%이(가)… 하앙…」
				KSTR:(K++) = 「덮치는 것 같잖아… 읏, 앗♪」
				WSTR:(K++) = %CALLNAME%은(는) 스스로 허리를 꿈틀거리며 솔직하게 쾌락을 받아들이고 있다……
				CFLAG:338 = 3
			ENDIF
			;それ以外
			IF (CFLAG:338 || FLAG:7 == 2) && !口上有無確認(0)
				KSTR:(K++) = 「하아, 으응, 아, 여기 조금 기분 좋아…」
				WSTR:(K++) = %CALLNAME%은(는) 어색한 움직임으로 자신이 기분 좋은 곳을 찾고 있는 모양이다.
				CFLAG:338 = 2
			ENDIF
		ENDIF

