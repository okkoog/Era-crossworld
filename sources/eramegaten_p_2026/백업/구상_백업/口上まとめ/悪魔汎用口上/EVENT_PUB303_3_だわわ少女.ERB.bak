;			KSTR:(K++) = ┃%"",72,LEFT%┃
;			WSTR:(K++) = ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

@KOJO_BATTLE_EVENT_PUB303_3, ARG, ARG:1, ARG:2
;■台詞の行数を増やしたいときは
;			LOCALS:10 = 一行目
;			LOCALS:11 = 二行目
;			LOCALS:12 = 三行目
;			LOCALS:13 = 四行目
;			LOCALS:14 = 五行目
;と増やしていく
;SIF ARG < 0 && NO:ARG != X1
;	RETURN 0
VARSET LOCALS

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		LOCALS:10 = 
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			LOCALS:10 = 
		;それ以外
		ELSE
			LOCALS:10 = 
		ENDIF
	;被召喚時
	CASE 3
			LOCALS:10 = 
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			LOCALS:10 = 
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				LOCALS:10 = 
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			LOCALS:10 = 
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			LOCALS:10 = 
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			LOCALS:10 = 
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			LOCALS:10 = 
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			LOCALS:10 = 
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			LOCALS:10 = 
		;無効
		ELSEIF ARG:2 == 0
			LOCALS:10 = 
		;吸収
		ELSEIF ARG:2 < 0
			LOCALS:10 = 
		ENDIF
	;反射された
	CASE 15
			LOCALS:10 = 
	;反射した
	CASE 16
			LOCALS:10 = 
	;回避された
	CASE 17
			LOCALS:10 = 
	;回避した
	CASE 18
			LOCALS:10 = 
	;反撃スキル発動した
	CASE 20
			LOCALS:10 = 
	;バトルに勝利した
	CASE 90
			LOCALS:10 = 
	;レベルアップした
	CASE 91
			LOCALS:10 = 
	;逃走に成功した
	CASE 92
			LOCALS:10 = 
	;逃走に失敗した
	CASE 93
			LOCALS:10 = 
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			LOCALS:10 = 
		ELSE
			LOCALS:10 = 
		ENDIF
	;バックアタックを受けた
	CASE 95
		IF 現HP割合(ARG) < 25
			;瀕死
			LOCALS:10 = 
		ELSE
			LOCALS:10 = 
		ENDIF
	;敵の先制攻撃を受けた
	CASE 96
		IF 現HP割合(ARG) < 25
			;瀕死
			LOCALS:10 = 
		ELSE
			LOCALS:10 = 
		ENDIF
ENDSELECT
SIF !(LOCALS:10 == "")
	CALL MESSAGE_B2(CALLNAME:ARG,0, LOCALS:10, LOCALS:11, LOCALS:12, LOCALS:13, LOCALS:14)


@KOJO_BATTLE_MESSAGE_PUB303_3,ARG,ARG:1 = 0
;■台詞の行数を増やしたいときは
;			LOCALS:10 = 一行目
;			LOCALS:11 = 二行目
;			LOCALS:12 = 三行目
;			LOCALS:13 = 四行目
;			LOCALS:14 = 五行目
;と増やしていく
VARSET LOCALS
;使用したスキルの名前をLOCALSに代入
CALL GET_SKILL_PROP, "SKILL_NAME", CFLAG:ARG:입력행동, ARG
LOCALS = %RESULTS%
;FLAG:ARG:타겟

;崩壊してる場合は口上表示しないようにもできる
;SIF TALENT:ARG:9
;	RETURN 0

CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
;コメントアウトしやすいように
IF 1 == 0
;-------------------------------------------------
;状態異常時
;-------------------------------------------------
;魅了時
ELSEIF CFLAG:ARG:상태이상 == GET_STATE_NUM("CHARM")
	;行動不能（ムラムラしている）
	IF CFLAG:ARG:입력행동 == 2314
		LOCALS:10 = 
	ELSE
		LOCALS:10 = 
	ENDIF
;混乱時
ELSEIF CFLAG:ARG:상태이상 == GET_STATE_NUM("PANIC")
	;금전뿌리기
	IF CFLAG:ARG:입력행동 == 2315
		LOCALS:10 = 
	;行動不能（ぼんやりしている）
	ELSEIF CFLAG:ARG:입력행동 == 2314
		LOCALS:10 = 
	ELSE
		LOCALS:10 = 
	ENDIF
;-------------------------------------------------
;特定スキル
;-------------------------------------------------
;これは通常攻撃
ELSEIF CFLAG:ARG:입력행동 == 0
	LOCALS:10 = 
;ELSEIF CFLAG:ARG:입력행동 == (スキル番号)
;	LOCALS:10 = 
;섹시댄스
ELSEIF CFLAG:ARG:입력행동 == 1212
	LOCALS:10 = 
;캔디보이스
ELSEIF CFLAG:ARG:입력행동 == 1213
	LOCALS:10 = 
;파이널누드
ELSEIF CFLAG:ARG:입력행동 == 1214
	LOCALS:10 = 
;-------------------------------------------------
;銃攻撃（特殊弾丸含む）
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,2101, 2200)
	;GUN
	IF CFLAG:ARG:입력행동 == 2101
		LOCALS:10 = 
	;その他（特殊弾丸）
	ELSE
		LOCALS:10 = 
	ENDIF
;-------------------------------------------------
;基本行動
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,2301, 2400)
	;ＣＨＡＮＧＥ
	IF CFLAG:ARG:입력행동 == 2301
		LOCALS:10 = 
	ELSE
		LOCALS:10 = 
	ENDIF
;-------------------------------------------------
;アイテム
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,3001, 3500)
	LOCALS:10 = 
;-------------------------------------------------
;リンケージ
;-------------------------------------------------
ELSEIF RANGE(CFLAG:ARG:입력행동,4000, 5000)
	;메시아라이저
	IF CFLAG:ARG:입력행동 == 4160
		LOCALS:10 = 
	;Lヒートライザ
	ELSEIF CFLAG:ARG:입력행동 == 4200
		LOCALS:10 = 
	;사망유희
	ELSEIF CFLAG:ARG:입력행동 == 4800
		LOCALS:10 = 
	ELSE
		LOCALS:10 = 
	ENDIF
;-------------------------------------------------
;汎用スキル
;　喋らない場合もある
;-------------------------------------------------
;검격
ELSEIF RANGE(CFLAG:ARG:입력행동,1, 32) || RANGE(CFLAG:ARG:입력행동,37, 99)
	IF RAND:3 == 0
		LOCALS:10 = 두 동강이야
	ELSEIF RAND:2 == 0
		LOCALS:10 = 갈기갈기 썰어줄게
	ENDIF
;비구
ELSEIF RANGE(CFLAG:ARG:입력행동,101, 130) || RANGE(CFLAG:ARG:입력행동,134, 199)
	IF RAND:3 == 0
		LOCALS:10 = 이 거리라면 빗나가지 않아
	ELSEIF RAND:2 == 0
		LOCALS:10 = 벌집으로 만들어줄게
	ENDIF
;타격
ELSEIF RANGE(CFLAG:ARG:입력행동,201, 226) || RANGE(CFLAG:ARG:입력행동,229, 230) || RANGE(CFLAG:ARG:입력행동,235, 299)
	IF RAND:3 == 0
		LOCALS:10 = 일격필살! 이야
	ELSEIF RAND:2 == 0
		LOCALS:10 = 묵사발로 만들어줄게
	ENDIF
;전술
ELSEIF RANGE(CFLAG:ARG:입력행동,301, 337) || RANGE(CFLAG:ARG:입력행동,344, 399)
	;噛み付き系
	IF RANGE(CFLAG:ARG:입력행동,321, 326)
		IF RAND:3 == 0
			LOCALS:10 = 맛있으려나
		ELSEIF RAND:2 == 0
			LOCALS:10 = 씹어 으스러뜨려 줄게
		ENDIF
	;その他
	ELSE
		IF RAND:2 == 0
			LOCALS:10 = 
		ELSE
			LOCALS:10 = 
		ENDIF
	ENDIF
;회복
ELSEIF RANGE(CFLAG:ARG:입력행동,401, 499)
	;全体回復
	IF CFLAG:ARG:타겟 > 6
		LOCALS:10 = 전원 회복시키겠어
	;リカーム、サマリカーム
	ELSEIF RANGE(CFLAG:ARG:입력행동,417, 418)
		LOCALS:10 = 쓰러져 있을 틈 따윈 안 줄 거야
	ELSE
		LOCALS:10 = 회복시켜줄게
	ENDIF
;지원
ELSEIF RANGE(CFLAG:ARG:입력행동,501, 599)
	;強化系
	IF RANGE(CFLAG:ARG:입력행동,501, 505) || CFLAG:ARG:입력행동 == 558
