;-------------------------------------------------
;輪姦時の口上
;CASE 0 内は必ず通るようになっており
;RETURNで0を返すと、この後通常の輪姦行動を出します
;CFLAGは使っていません
;COMF201_輪姦内でLOCALを使っているので使いません
;-------------------------------------------------
@KOJO_MESSAGE_RINKAN_PUB303_3, ARG:1 , ARG:2
CALL 口上変数初期化

SELECTCASE ARG:1
	CASE 0
	;CASE 0はオリジナル輪姦口上
	;C:一回あたりの帰宅人数、D：興奮度増加(及び減少)
	;CとDはオリジナル輪姦口上内のみ使う
	;C += 、D += を使う
		IF ARG:2 == 1
		;ハードON
		
		ELSE
		;ハードOFF
		
		ENDIF
	;ハード系
	;胸を踏まれる（巨乳・爆乳のみ）
	CASE 1
		IF (陥落( ) > 0) && FLAG:7 == 2
			;恋慕、親愛
			IF 陥落( ) > 0 && RESULTS == "연모"
				WSTR:(K++) = 
			;淫乱、娼婦	
			ELSEIF 陥落( ) > 0 && RESULTS == "음란"
				WSTR:(K++) = 
			;服従、隷属	
			ELSEIF 陥落( ) > 0 && RESULTS == "복종"
				WSTR:(K++) = 
			ENDIF
			;陥落済み共通
			IF KSTR:0 == ""
				WSTR:(K++) = 
			ENDIF
		ENDIF
		;屈服刻印Lv3
		IF MARK:굴복각인 == 3 && FLAG:7 == 2 && KSTR:0 == ""
			WSTR:(K++) = 
		ENDIF
		;それ以外
		IF FLAG:7 == 2 && KSTR:0 == ""
			WSTR:(K++) =
		ENDIF
	;頭を踏まれる
	CASE 2
	
	;暴力を振るわれる
	CASE 3
	
	;タバコの根性焼き
	;興奮度が低く、反抗的、気丈、プライド高い、生意気、抵抗を持っている
	CASE 4
	
	;地面に垂れた精液舐めとらせる
	;マゾっ気３以上
	CASE 5
	
	;体に落書きをされて犯される
	CASE 6
	
	;尻突き上げてバックから犯されつつ、頭を踏んづけられて屈辱で涙目状態
	CASE 7
	
	;通常系
	;淫乱系で目の前に棒並べられて、どれが欲しいか選ばせるとか（淫乱・娼婦のみ）
	CASE 8
	
	;巨乳以上のキャラだと「その乳は飾りか？遊ばせてるんじゃねえ」とか罵られパイズリする（巨乳・爆乳のみ）
	CASE 9
	
	;挿れられるのだけは回避しようと必死に口と手で群がるチンポにご奉仕する（恋幕・親愛のみ）
	CASE 10
	
	;;両穴突かれながら無理やり笑顔とピースサインとらされて記念撮影
	CASE 11
	
	;;輸姦後の後始末描写で、本人精液でどろどろにされてるのに周囲の男達の肉棒を舌で掃除させられてる
	CASE 12
	
	;中に出されても即座にほかの人に交代
	CASE 13
	
	;一斉射精で精液まみれ
	CASE 14
	
	;;両穴突かれて同時射精
	CASE 15
	
	;기승위+両脇コキ
	CASE 16
	
	;;입+マンコ
	CASE 17
	
ENDSELECT

CALL 口上変数表示
;口上がなければ別の口上を呼び出す
IF RESULT == 0
	TRYCCALLFORM KOJO_MESSAGE_RINKAN_ZZZ
	CATCH
	ENDCATCH
	
ENDIF
;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG関係（X1をキャラ番号に置換）
;パラメータ変化などをトリガーにした口上　CFLAG 221～260を使用
;-------------------------------------------------
;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_A（X1をキャラ番号に置換）
;調教者の射精をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_A_PUB303_3
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_A
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_A_PY1_PUB303_3
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_A_PY1_PUB303_3
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;調教者の射精時のテキスト
;-------------------------------------------------
CALL 口上変数初期化
LOCAL = 0;사정량
;-------------------------------------------------
;射精箇所変更時のテキスト　有効時はここで関数終了
;-------------------------------------------------


IF CFLAG:106
	LOCAL = 1
	K_CALL:K = PALAM_MESSAGE_A
	IF 1 == 0
	;머리카락
	ELSEIF CFLAG:106 == 1				
		IF (陥落( ) > 0) && (CFLAG:221 < 3 || FLAG:7 == 2)
			;恋慕、親愛	
			IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"	
				WSTR:(K++) = 
				CFLAG:221= 4
			;淫乱、娼婦	
			ELSEIF 陥落( ) > 0 && RESULTS == "음란"	
				WSTR:(K++) = 
				CFLAG:221= 3
			;服従、隷属	
			ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
				WSTR:(K++) = 
				CFLAG:221= 3
			ENDIF	
			;陥落済み共通	
			IF !口上有無確認(0)
				WSTR:(K++) = 
				CFLAG:221= 3
			ENDIF	
		ENDIF		
		;屈服刻印Lv3		
		IF MARK:굴복각인 == 3 && (CFLAG:221 < 2 || FLAG:7 == 2) && !口上有無確認(0)
			WSTR:(K++) = 	
			CFLAG:221= 2	
		ENDIF		
		;それ以外		
		IF (CFLAG:221 < 1 || FLAG:7 == 2) && !口上有無確認(0)
			WSTR:(K++) =
			CFLAG:221= 1	
		ENDIF		
	;顔
	ELSEIF CFLAG:106 == 2				
		IF (陥落( ) > 0) && (CFLAG:222 < 3 || FLAG:7 == 2)
			;恋慕、親愛	
			IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"	
				KSTR:(K++) = 「우후후…… 얼굴에 잔뜩 마킹당해 버렸네%ハート()%」
				WSTR:(K++) = %CALLNAME%은(는) 미소 지으며 정액의 냄새와 맛을 즐기고 있다.
				CFLAG:222= 4
			;淫乱、娼婦	
			ELSEIF 陥落( ) > 0 && RESULTS == "음란"	
				;外出中
				IF CFLAG:396
					IF RAND:2 == 0
						KSTR:(K++) = 「얼굴에 정액을 뿌려놓고 어떻게 돌아가게 하려는 거야?」
					ELSE
						KSTR:(K++) = 「얼굴에 정액을 묻힌 채로 돌려보낼 셈이야?」
						KSTR:(K++) = 「다른 사람이 보고 정액인 걸 눈치채면 큰일이겠네♪」
					ENDIF
				ELSE
					;衣服で眼鏡を装備している
					IF RAND:2 == 0 && TEQUIP:91== 1103
						WSTR:(K++) = 「평소보다 기세 좋게 잔뜩 나왔네」
						KSTR:(K++) = 「안경에 정액 뿌리고 흥분했어?」
						NSTR:(K++) = 안경에 묻은 정액을
					ELSE
						KSTR:(K++) = 「정액 냄새로 사레들릴 것 같아♪」
						NSTR:(K++) = 손가락으로 얼굴에 묻은 정액을 닦아내더니,
					ENDIF
				ENDIF
				WSTR:(K++) = %CALLNAME%은(는) 미소 지으며 정액의 냄새와 맛을 즐기고 있다.
				CFLAG:222= 3
			;服従、隷属	
			ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
				KSTR:(K++) = 「정액으로 얼굴이 더럽혀졌네♪」
				WSTR:(K++) = %CALLNAME%은(는) 얼굴을 더럽힌 정액의 향기를 즐기고 있다.
				CFLAG:222= 3
			ENDIF	
