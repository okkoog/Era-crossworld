;-------------------------------------------------
;49,착유기
;-------------------------------------------------
	CASE 49
		K_CALL:K = TRAIN_MESSAGE
		;装備時
		IF TEQUIP:17
			;初めて
			IF CFLAG:331 == 0
				IF RAND:2 == 0
					KSTR:(K++) = 「이거 소풍 때 갔던 목장에서 봤어」
				ELSE
					KSTR:(K++) = 「이거 TV에서 본 적 있어」
				ENDIF
				KSTR:(K++) = 　
				;陥落している場合
				IF 陥落( ) > 0 
					KSTR:(K++) = 「이런 기계 따윈 쓰지 말고」
					WSTR:(K++) = 「직접 빨면 될 텐데…」
				ELSE
					KSTR:(K++) = 「저기, 어린애한테서 젖 같은 걸 짜내서 어쩌자는 거야?」
					WSTR:(K++) = %CALLNAME%은(는) 미심쩍은 눈으로 이쪽을 노려보고 있다…
				ENDIF
				CFLAG:331 = 1
			ELSE
				IF 陥落( ) > 0 && (CFLAG:331 < 3 || FLAG:7 == 2)
					;恋慕、親愛
					IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"
						KSTR:(K++) = 「%CSTR:이인칭%은, %CSTR:일인칭%의 가슴이 갖고 싶어?」
						KSTR:(K++) = 　
						IF TALENT:임신 && RAND:3 == 0
							KSTR:(K++) = 「안 돼, 이건 아기 마실 거라구♪」
						ELSEIF RAND:2 == 0
							KSTR:(K++) = 「하아…, 어쩔 수 없네에…%ハート()%」
						ELSE
							KSTR:(K++) = 「%CSTR:이인칭%은 아기 버릇이 안 빠졌네%ハート()%」
						ENDIF
					;淫乱、娼婦	
					ELSEIF 陥落( ) > 0 && RESULTS == "음란"
						IF RAND:2 == 0
							KSTR:(K++) = 「어린애한테서 나온 젖을 모으다니 %CSTR:이인칭%은(는) 진짜 변태야♪」
						ELSE
							KSTR:(K++) = 「직접 빨면서 해도 좋아♪」
						ENDIF
					;服従、隷属	
					ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
						IF RAND:2 == 0
							KSTR:(K++) = 「나중에 %CSTR:일인칭%의 젖 드셔주세요, %CSTR:이인칭%」
						ELSE
							KSTR:(K++) = 「기계로 젖을 짜내다니 %CSTR:일인칭%, 젖소가 된 것 같아」
							WSTR:(K++) = 「정말이지~~♪」
						ENDIF
					ENDIF
					;陥落済み共通
					IF !口上有無確認(0)
						KSTR:(K++) = 
					ENDIF
					CFLAG:331 = 4
				ENDIF
				;屈服刻印Lv3
				IF MARK:굴복각인 == 3 && (CFLAG:331 < 2 || FLAG:7 == 2) && !口上有無確認(0)
					KSTR:(K++) = 
					CFLAG:331 = 3
				ENDIF
				;それ以外
				IF (CFLAG:331 || FLAG:7 == 2) && !口上有無確認(0)
							KSTR:(K++) = 「젖이 나올 때 가슴이 기분 좋아지지만」
							KSTR:(K++) = 「이건 몸이 그렇게 만들어져 있어서 그런 거야」
					CFLAG:331 = 2
				ENDIF
			ENDIF
		;해제
		ELSE
			;屈服刻印Lv3
			IF MARK:굴복각인 == 3 && !口上有無確認(0)
				KSTR:(K++) =
			ENDIF
			;それ以外
			IF !口上有無確認(0)
				KSTR:(K++) =
			ENDIF
		ENDIF
