						WSTR:(K++) = %CALLNAME%의 시선은 %CALLNAME:MASTER%의 가랑이에 고정되어 있다
					ELSE
						KSTR:(K++) = 「꼴려왔어?」
					ENDIF
				;服従、隷属	
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					KSTR:(K++) = 
				ENDIF
				;陥落済み共通
