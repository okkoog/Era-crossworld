;124,더블펠라
;-------------------------------------------------
	CASE 124
		K_CALL:K = TRAIN_MESSAGE
		;初めて
		IF CFLAG:366 == 0
			;シングルフェラも初めて
			IF CFLAG:345 == 0
				;陥落済み
				IF 陥落(TARGET,PLAYER) > 0 && FLAG:7 == 2
					WSTR:(K++) = 「그걸 입에 물면 되는 거지」
					WSTR:(K++) = 「처음이지만, %CALLNAME:ASSI%의 것을 참고해서 해볼게」
				ELSE
					KSTR:(K++) = 「그걸 입에!? 무슨 생각인 거야?」
					WSTR:(K++) = 도망치려는 %CALLNAME%을(를) 두 사람이 붙잡아 누르고 입 안에 페니스를 쑤셔 넣었다
					WSTR:(K++) = 「이상한 맛이야……」
				ENDIF
			ELSE
				WSTR:(K++) = 「둘이서 하는 거야?」
				;陥落済み
				IF  陥落(TARGET,PLAYER) > 0 && FLAG:7 == 2
					WSTR:(K++) = 「응, 기대에 부응하도록 힘낼게」
				ELSE
					KSTR:(K++) = 「%CALLNAME:ASSI%에게 맡기고 %CSTR:일인칭%은 아무것도 안 해도 되겠네?」
					WSTR:(K++) = 도망치려는 %CALLNAME%의 머리를 붙잡고 사타구니로 내리눌렀다
				ENDIF
			ENDIF
			CFLAG:366 = 1
		ELSE
			IF 陥落( ) > 0 && (CFLAG:366 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"
					;調教相手も助手のバエルも妻の場合
					IF TALENT:아내 && 助手確認([[キャラ:바엘]]) && TALENT:ASSI:아내 && CFLAG:800 == 3
						IF RAND:2 == 0
							KSTR:(K++) = 「안 돼, %CSTR:이인칭%의 정액은 전부 %CSTR:일인칭%의 것이야」
							KSTR:(K++) = 「너 따위한텐 안 줄 거야」
							WSTR:(K++) = 지지 않겠다는 듯 %CALLNAME:MASTER%의 페니스에 매달리는 소녀
							WSTR:(K++) = 『지면 안 된데이』
							KSTR:(K++) = 『니한테는 새로운 마왕을 낳아줘야겠데이』
							WSTR:(K++) = 소녀는 페니스를 문 채 끄덕이고 있다
						ELSE
							KSTR:(K++) = 「%CALLNAME:ASSI% 따위보다 %CSTR:일인칭%의 입이 더 기분 좋지?」
							WSTR:(K++) = %CALLNAME%의 말에 자극받아 %CALLNAME:ASSI%의 혀놀림이 격렬해졌다
							KSTR:(K++) = 「아, 안 돼, %CSTR:이인칭%을(를) 기분 좋게 해주는 건 색시의 일인걸」
							WSTR:(K++) = 두 사람은 경쟁하듯 %CALLNAME:MASTER%의 페니스에 봉사하고 있다…
						ENDIF
					ELSE
						IF RAND:2 == 0
							WSTR:(K++) = 「안 돼. %CSTR:이인칭%의 정-액은 전부 %CSTR:일인칭%의 것이니까」
						ELSE
							KSTR:(K++) = 「%CSTR:일인칭%(와)과 %CALLNAME:ASSI%의 혀, 기분 좋아?」
							WSTR:(K++) = 「더~욱 기분 좋게 해줄게%ハート()%」
						ENDIF
					ENDIF
				;淫乱、娼婦	
				ELSEIF 陥落( ) > 0 && RESULTS == "음란"
					;助手が嫁
					IF TALENT:ASSI:아내
						IF RAND:2 == 0
							WSTR:(K++) = 「%CALLNAME:ASSI%한테는 미안하지만, %CSTR:이인칭%의 정-액, %CSTR:일인칭%이(가) 전부 마셔버릴 거야♪」
							WSTR:(K++) = 「있지, %CSTR:이인칭%, 괜찮지?」
						ELSE
							KSTR:(K++) = 「%CALLNAME:ASSI% 따위보다 %CSTR:일인칭% 쪽이 더 잘하지?」
							WSTR:(K++) = %CALLNAME%의 말에 자극받아 %CALLNAME:ASSI%의 혀놀림이 격렬해졌다
							WSTR:(K++) = 「%CSTR:일인칭%도 지지 않을 거야♪」
						ENDIF
					ELSE
						IF RAND:2 == 0
							KSTR:(K++) = 「어디에 싸도 좋아」
							WSTR:(K++) = 「둘이서 전부 마셔줄게%ハート()%」
						ELSE
							WSTR:(K++) = 「%CSTR:일인칭%과(와) %CALLNAME:ASSI%의 혀, 기분 좋아?」
							WSTR:(K++) = 「하지만, 아직 정-액 내보내면 안 돼」
							WSTR:(K++) = 「참는 편이 더 기분 좋게 사정할 수 있어♪」
						ENDIF
					ENDIF
				;服従、隷属	
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					IF RAND:2 == 0
						WSTR:(K++) = 「%CSTR:일인칭%도 %CALLNAME:ASSI%한테 지지 않을 만큼 봉사할게」
						WSTR:(K++) = 「그러니까, 가~득 기분 좋아져서 정-액 내보내줘%ハート()%」
					ELSE
						WSTR:(K++) = 「%CSTR:이인칭%, 우리들의 봉사는 어때?」
						WSTR:(K++) = 「불만이면 말해줘. 더 격렬한 짓이라도 할 테니까%ハート()%」
					ENDIF
				ENDIF
				CFLAG:366 = 4
			ENDIF
			;屈服刻印Lv3
			IF MARK:굴복각인 == 3 && (CFLAG:366 < 2 || FLAG:7 == 2) && !口上有無確認(0)
				IF RAND:2 == 0
					WSTR:(K++) = 「핥고 있기만 하면 돼?」
					WSTR:(K++) = 「모처럼 둘이 있는데……」
				ELSE
					WSTR:(K++) = 「%CSTR:일인칭%도 더 힘낼게」
					WSTR:(K++) = 「그러니까, %CALLNAME:ASSI%처럼, 그……」
				ENDIF
				CFLAG:366 = 3
			ENDIF
			;それ以外
			IF (CFLAG:366 || FLAG:7 == 2) && !口上有無確認(0)
				IF RAND:2 == 0
					WSTR:(K++) = 「%CSTR:일인칭%도 해야 해?」
				ELSE
					KSTR:(K++) = 「어째서 둘이서 할 필요가 있는 거야?」
					WSTR:(K++) = %CALLNAME%은(는) 불만을 털어놓으면서도 봉사하고 있다
				ENDIF
				CFLAG:366 = 2
			ENDIF
		ENDIF
		;助手口上呼び出し関数
		;一緒に気持ちよくしようというセリフ
		;		K_CALL:K = KOJO_MESSAGE_ASSIPAIR_COM_1
		;私のほうが気持ちよくしてるというセリフ
