					ELSEIF 陥落( ) > 0 && RESULTS == "음란"	
						KSTR:(K++) = 「아, 하아…… 정액… 기분 좋아아……%ハート()%」
						WSTR:(K++) = %CALLNAME%의 질 내부는 탐욕스럽게 정액을 삼키며, 아직 더 원하듯 음란하게 꿈틀거리며 육봉을 자극한다.
						WSTR:(K++) = 「더어…… 더 정액 줘어…… 더 범해줘어%ハート()%」
						CFLAG:239= 3
					;服従、隷属	
					ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
						IF RAND:2 == 0
							WSTR:(K++) = 「아, 하아……」
							WSTR:(K++) = 「보지에 사정해줘서, %CSTR:일인칭%, 기뻐……」
						ELSE
							WSTR:(K++) = 「앗, 뜨거운 게……」
							WSTR:(K++) = 「보지를 사용해주셔서 감사합니다」
						ENDIF
						CFLAG:239= 3
					ENDIF
				ENDIF
				;屈服刻印Lv3
				IF MARK:굴복각인 == 3 && (CFLAG:239 < 2 || FLAG:7 == 2) && !口上有無確認(0)
					KSTR:(K++) = 「아, 아앙! %CSTR:일인칭%의 안에! 울컥울컥 나오고 있어!」
					WSTR:(K++) = %CALLNAME%은(는) 몸을 떨며 사정을 받아내고 있다. 그 얼굴은 발정기의 암컷과 다를 바가 없었다.
					CFLAG:239= 2
				ENDIF
				;それ以外
				IF (CFLAG:239 < 1 || FLAG:7 == 2) && !口上有無確認(0)
					IF RAND:2 == 0
						WSTR:(K++) = 「아! 아아! 뜨거운 게 오고 있어! 싫어어어!」
					ELSE
						KSTR:(K++) = 「이런 짓을 하고……」
						WSTR:(K++) = 「용서 안 해…… 절대로 용서 안 할 거야!」
					ENDIF
					CFLAG:239= 1
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------
;逆レイプで射精させた
;-------------------------------------------------
IF SELECTCOM == 64 && TFLAG:10 > 0
	LOCAL = TFLAG:10
	K_CALL:K = PALAM_MESSAGE_A		
	;大量射精					
	IF TFLAG:10 > 1
		IF (陥落( ) > 0) && (CFLAG:240 < 3 || FLAG:7 == 2)
			;恋慕、親愛	
			IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"	
				WSTR:(K++) = 
				CFLAG:240= 4
			;淫乱、娼婦	
			ELSEIF 陥落( ) > 0 && RESULTS == "음란"	
				WSTR:(K++) = 
				CFLAG:240= 3
			;服従、隷属	
			ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
				WSTR:(K++) = 
				CFLAG:240= 3
			ENDIF	
			;陥落済み共通	
			IF !口上有無確認(0)
				WSTR:(K++) = 
				CFLAG:240= 3
			ENDIF	
		ENDIF		
		;屈服刻印Lv3		
		IF MARK:굴복각인 == 3 && (CFLAG:240 < 2 || FLAG:7 == 2) && !口上有無確認(0)
			WSTR:(K++) = 	
			CFLAG:240= 2	
		ENDIF		
		;それ以外		
		IF (CFLAG:240 < 1 || FLAG:7 == 2) && !口上有無確認(0)
			WSTR:(K++) = 	
			CFLAG:240= 1	
		ENDIF		
	ENDIF	
	;通常					
	IF !口上有無確認(0)
		IF (陥落( ) > 0) && (CFLAG:240 < 3 || FLAG:7 == 2)
			;恋慕、親愛	
			IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"	
				WSTR:(K++) = 
				CFLAG:240= 4
			;淫乱、娼婦	
			ELSEIF 陥落( ) > 0 && RESULTS == "음란"	
				WSTR:(K++) = 
				CFLAG:240= 3
			;服従、隷属	
			ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
				WSTR:(K++) = 
				CFLAG:240= 3
			ENDIF	
			;陥落済み共通	
			IF !口上有無確認(0)
				WSTR:(K++) = 
				CFLAG:240= 3
			ENDIF	
		ENDIF		
		;屈服刻印Lv3		
		IF MARK:굴복각인 == 3 && (CFLAG:240 < 2 || FLAG:7 == 2) && !口上有無確認(0)
			WSTR:(K++) = 	
			CFLAG:240= 2	
		ENDIF		
		;それ以外		
		IF (CFLAG:240 < 1 || FLAG:7 == 2) && !口上有無確認(0)
			WSTR:(K++) =
			CFLAG:240= 1	
		ENDIF		
	ENDIF	
ENDIF
;-------------------------------------------------
;射精共通
;-------------------------------------------------
	IF !口上有無確認(0) && LOCAL > 0
		IF (陥落( ) > 0) && (CFLAG:240 < 3 || FLAG:7 == 2)
			;恋慕、親愛	
			IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"	
				WSTR:(K++) = 
				CFLAG:240= 4
			;淫乱、娼婦	
			ELSEIF 陥落( ) > 0 && RESULTS == "음란"	
				WSTR:(K++) = 
				CFLAG:240= 3
			;服従、隷属	
			ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
				WSTR:(K++) = 
				CFLAG:240= 3
			ENDIF	
			;陥落済み共通	
			IF !口上有無確認(0)
				WSTR:(K++) = 
				CFLAG:240= 3
			ENDIF	
		ENDIF		
		;屈服刻印Lv3		
		IF MARK:굴복각인 == 3 && (CFLAG:240 < 2 || FLAG:7 == 2) && !口上有無確認(0)
			WSTR:(K++) = 	
			CFLAG:240= 2	
		ENDIF		
		;それ以外		
		IF (CFLAG:240 < 1 || FLAG:7 == 2) && !口上有無確認(0)
			WSTR:(K++) =
			CFLAG:240= 1	
		ENDIF		
	ENDIF	

CALL 口上変数表示
;口上がなければ別の口上を呼び出す
IF RESULT == 0
	TRYCCALLFORM KOJO_MESSAGE_PALAMCNG_A_ZZZ
	CATCH
		CALL PALAM_MESSAGE_A
	ENDCATCH
	
ENDIF

;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_E（X1をキャラ番号に置換）
;触手の射精をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_E_PUB303_3
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_E
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_E_PY1_PUB303_3
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_E_PY1_PUB303_3
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;触手の射精時のテキスト
;-------------------------------------------------
CALL 口上変数初期化
;-------------------------------------------------
;촉수가사정
;-------------------------------------------------
IF TFLAG:15 >0
	K_CALL:K = PALAM_MESSAGE_E
	IF (陥落( ) > 0) && (CFLAG:241 < 3 || FLAG:7 == 2)
		;恋慕、親愛	
		IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"	
			WSTR:(K++) = 
			CFLAG:241= 4
		;淫乱、娼婦	
		ELSEIF 陥落( ) > 0 && RESULTS == "음란"	
			WSTR:(K++) = 
			CFLAG:241= 3
		;服従、隷属	
		ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
			WSTR:(K++) = 
			CFLAG:241= 3
		ENDIF	
		;陥落済み共通	
		IF !口上有無確認(0)
			WSTR:(K++) = 
			CFLAG:241= 3
		ENDIF	
	ENDIF		
	;屈服刻印Lv3		
	IF MARK:굴복각인 == 3 && (CFLAG:241 < 2 || FLAG:7 == 2) && !口上有無確認(0)
		WSTR:(K++) = 	
		CFLAG:241= 2	
	ENDIF		
	;それ以外		
	IF (CFLAG:241 < 1 || FLAG:7 == 2) && !口上有無確認(0)
		WSTR:(K++) =
		CFLAG:241= 1	
	ENDIF		
ENDIF

CALL 口上変数表示
IF RESULT == 0
	TRYCCALLFORM KOJO_MESSAGE_COM_ZZZ
	CATCH
		CALL PALAM_MESSAGE_E
	ENDCATCH
	
ENDIF
;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_B関係（X1をキャラ番号に置換）
;奴隷の絶頂をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_B_PUB303_3
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_B
	RETURN 0
ENDIF
;想定外の口上だとスキップ(これ消したらバグる)
IF SELECTCOM < 0 || SELECTCOM > 700
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_B_PY1_PUB303_3
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_B_PY1_PUB303_3
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;奴隷の絶頂時のテキスト
;-------------------------------------------------
CALL 口上変数初期化
;-------------------------------------------------
;初めてC絶頂
;-------------------------------------------------
IF NOWEX:0 > 0 && CFLAG:242 == 0
	;陥落済み
	IF 陥落() == 0
		KSTR:(K++) = 「싫어, 무, 뭐야 이거어! 아아아아아!」
	ELSE
		KSTR:(K++) = 「햐! 아, 아아아! 무, 뭐야 이거어! 아아아아아!」
	ENDIF
	WSTR:(K++) = %CALLNAME%은(는) 처음 겪는 감각에 곤혹스러워하며 %CALLNAME:MASTER%에게 꼭 매달려 떨었다.
	CFLAG:242 = 1
ENDIF

;-------------------------------------------------
;初めてV絶頂
;-------------------------------------------------
IF NOWEX:1 > 0 && CFLAG:243 == 0
	;恋慕、親愛
	IF (TALENT:연모 || TALENT:친애)
		WSTR:(K++) = 「아아! 아아아아!」
		KSTR:(K++) = 「뭐야 이거, %CSTR:이인칭%, 뭔가 오고 있어」
		KSTR:(K++) = 「이거, 기분 좋아서 머리가 이상해져 버려!」
		KSTR:(K++) = 「안 돼, 안 돼애~!!」
		WSTR:(K++) = %CALLNAME%은(는) 처음 느끼는 여자로서의 절정에 머릿속이 새하얘지며 몸을 경련시키고 있다.
	;淫乱、娼婦、服従、隷属
	ELSEIF (TALENT:음란 || TALENT:복종 || TALENT:창부 || TALENT:예속)
		KSTR:(K++) = 「아앙! 아아아아!」
		KSTR:(K++) = 「뭐야 이거, 보, 보지! 보지 망가져! 망가져 버려! 으아아아아!」
		WSTR:(K++) = %CALLNAME%은(는) 여자로서 처음 맛본 절정에 머릿속이 새하얘지며 몸을 경련시켰다.
		WSTR:(K++) = %CALLNAME:MASTER%에게 매달려, 눈물을 흘리며 몸을 떨고 있다.
	ELSE
		KSTR:(K++) = 「아앙! 아아아아!」
		KSTR:(K++) = 「뭐야 이거… 뱃속에서…… 시, 싫어어어어어!!」
		WSTR:(K++) = %CALLNAME%은(는) 미지의 감각에 눈물을 흘리며 비명을 지르고 있다.
	ENDIF
	CFLAG:243 = 1
ENDIF

;-------------------------------------------------
;初めてA絶頂
;-------------------------------------------------
IF NOWEX:2 > 0 && CFLAG:244 == 0
	;陥落済み
	IF 陥落() == 0
		KSTR:(K++) = 「엉덩이, 엉덩이 속이, 찌릿찌릿해!」
		KSTR:(K++) = 「엉덩이, 엉덩이로 가버려, 아아아앗!」
		WSTR:(K++) = 배설 기관을 통한 절정이라는 이제껏 없던 경험에 %CALLNAME%은(는) 몸을 경련하며 유열에 젖어들고 있다.
	ELSE
		KSTR:(K++) = 「시, 싫어! 엉덩이가!」
		KSTR:(K++) = 「엉덩이가 기분 좋다니 말도 안 돼! 아아아아아!」
		WSTR:(K++) = %CALLNAME%은(는) 애널로 맞이한 첫 절정에 수치심으로 얼굴을 새빨갛게 물들이면서도 유열에 몸을 경련시키고 있다.
	ENDIF
	CFLAG:244 = 1
ENDIF

;-------------------------------------------------
;初めてB絶頂
;-------------------------------------------------
IF NOWEX:3 > 0 && CFLAG:245 == 0
	;陥落済み
	IF 陥落() == 0
		KSTR:(K++) = 「아! 아아! 가슴 좋아!」
		KSTR:(K++) = 「와버려, 와버린다구!」
		WSTR:(K++) = %CALLNAME%은(는) 가슴으로 맞이한 첫 절정에 몸을 한계까지 뒤로 젖히며 떨었다.
	ELSE
		KSTR:(K++) = 「아! 아아! 가슴!」
		KSTR:(K++) = 「안 돼, 안 돼애애애!」
		WSTR:(K++) = %CALLNAME%은(는) 가슴으로 맞이한 첫 절정에 저항하지 못하고 몸을 한계까지 뒤로 젖히며 떨었다.
	ENDIF
	CFLAG:245 = 1
ENDIF

;-------------------------------------------------
;절정
;-------------------------------------------------
;強絶頂以上
IF TFLAG:29 > 1
	;陥落済み
	IF 陥落() > 0 && FLAG:7 == 2
		IF RAND:4 == 0
			WSTR:(K++) = 「가, 가버려! %CSTR:일인칭%, 가버릴 것 같아! 아아아아아!!」
			WSTR:(K++) = 「엄청나, %CSTR:일인칭%, 가버릴 것 같아! 아아아아아!!」
		ELSEIF RAND:3 == 1
			KSTR:(K++) = 「앗♪ 앗♪」
			WSTR:(K++) = 「가버…! 흐아아! 아아아아아!!」
		ELSEIF RAND:2 == 0
			KSTR:(K++) = 「엄청 기분 좋아, %CSTR:이인칭%!」
			WSTR:(K++) = 「하앙! 하앙! 히아아!! 아아아앗!! ……윽! ……으읏!!」
		ELSE
			;調教対象が悪魔か
			IF ABL:종족 > 0 && ABL:PLAYER:종족 == 0
				KSTR:(K++) = 「앙♪ 앙♪」
				WSTR:(K++) = 「인간 상대로 하는 섹스, 굉장해애!」
			ELSE
				WSTR:(K++) = 「대다내, %CSTR:이인칭%! 기분 좋아서 이상해져버릴 것 같아!」
				WSTR:(K++) = 「인간이랑 계약한 거 정답이었네♪」
			ENDIF
		ENDIF
	;屈服刻印Lv3
	ELSEIF MARK:굴복각인 == 3 && FLAG:7 == 2
		IF RAND:2 == 0
			KSTR:(K++) = 「시, 렁! 아앙! 아아아아아아아!!」
			WSTR:(K++) = 「이상해져, 이런 거 너무 기분 좋아서 이상해져버려어♪」
		ELSE
			KSTR:(K++) = 「패배로 칠 테니까!」
			WSTR:(K++) = 「패배해도 좋으니까 이대로 기분 좋게 해줘어!」
		ENDIF
	;それ以外
	ELSEIF FLAG:7 == 2
		;羞恥プレイ中
		IF RAND:4 == 0 && TEQUIP:30
			KSTR:(K++) = 「%CSTR:일인칭%의 부끄러운 곳, 보이지 마」
			KSTR:(K++) = 「%CSTR:일인칭%이(가) 느끼며 가버리는 모습, 보이지 마」
			WSTR:(K++) = 「히, 아아아아!!」
		ELSEIF RAND:3 == 0
			KSTR:(K++) = 「히, 아아아아!!」
			WSTR:(K++) = 「싫어! 정신없이 절정하는 모습, 보지 마!」
		ELSEIF RAND:2 == 0
			KSTR:(K++) = 「안 돼, 가버리면 안 되는데!」
			WSTR:(K++) = 「싫어! 앗, 아앙%ハート()% 가버렷, 가버리게 돼%ハート()%」
		ELSE
			KSTR:(K++) = 「싫어! 싫어어! 히, 아아아아!!」
			WSTR:(K++) = 「이런 건 안 돼! 반칙이야!!」
		ENDIF
	ENDIF
	CFLAG:246= 1
ELSEIF TFLAG:29 > 0
	;陥落済み
	IF 陥落() > 0 && FLAG:7 == 2
		IF RAND:4 == 0
			WSTR:(K++) = 「가, 가버려! %CSTR:일인칭%, 가버릴 것 같아! 아아아아아!!」
		ELSEIF RAND:3 == 1
			WSTR:(K++) = 「앗, 앗! 가버…! 흐아아! 아아아아아!!」
		ELSEIF RAND:2 == 0
			WSTR:(K++) = 「하앙! 하앙! 히아아!! 아아아앗!! ……윽! ……으읏!!」
		ELSE
			;調教対象が悪魔か
			IF ABL:종족 > 0 && ABL:PLAYER:종족 == 0
				KSTR:(K++) = 「앙! 앙!」
				WSTR:(K++) = 「인간 상대로 하는 섹스, 굉장해애!」
			ELSE
				WSTR:(K++) = 「대다내, %CSTR:이인칭%! 기분 좋아서 이상해져버릴 것 같아!」
			ENDIF
		ENDIF
	;屈服刻印Lv3
	ELSEIF MARK:굴복각인 == 3 && FLAG:7 == 2
		IF RAND:2 == 0
			WSTR:(K++) = 「싫, 아! 하앙! 아아아아아아아!!」
		ELSE
			KSTR:(K++) = 「앗! 아앙!」
			WSTR:(K++) = 「기분 좋은 거에 져버릴 것 같아!」
		ENDIF
	;それ以外
	ELSEIF FLAG:7 == 2
		;羞恥プレイ中
		IF RAND:4 == 0 && TEQUIP:30
			KSTR:(K++) = 「싫어! 싫어어!」
			KSTR:(K++) = 「%CSTR:일인칭%의 부끄러운 곳, 보이지 마」
			WSTR:(K++) = 「히, 아아아아!!」
		ELSEIF RAND:3 == 0
			KSTR:(K++) = 「히, 아아아아!!」
			WSTR:(K++) = 「싫어! 부끄러운 곳 보지 마!」
		ELSEIF RAND:2 == 0
			KSTR:(K++) = 「안 돼, 가버리면 안 되는데!」
			WSTR:(K++) = 「싫어! 앗, 아앙%ハート()%」
		ELSE
			WSTR:(K++) = 「싫어! 싫어엇! 히, 아아아아!!」
		ENDIF
	ENDIF
	CFLAG:246= 1
ENDIF

;-------------------------------------------------
;사정
;-------------------------------------------------
;射精している
SIF 口上有無確認(0) && K > 0
	CALL WSTR書き込み,K - 1
LOCAL = K

IF TFLAG:10 > 0				
	IF (陥落( ) > 0) && (CFLAG:247 < 3 || FLAG:7 == 2)
		;恋慕、親愛	
		IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"	
			WSTR:(K++) = 
			CFLAG:247= 4
		;淫乱、娼婦	
		ELSEIF 陥落( ) > 0 && RESULTS == "음란"	
			WSTR:(K++) = 
			CFLAG:247= 3
		;服従、隷属	
		ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
			WSTR:(K++) = 
			CFLAG:247= 3
		ENDIF	
		;陥落済み共通	
		IF !口上有無確認(LOCAL)
			WSTR:(K++) = 
			CFLAG:247= 3
		ENDIF	
	ENDIF		
	;屈服刻印Lv3		
	IF MARK:굴복각인 == 3 && (CFLAG:247 < 2 || FLAG:7 == 2) && !口上有無確認(LOCAL)
		WSTR:(K++) = 	
		CFLAG:247= 2
	ENDIF		
	;それ以外		
	IF (CFLAG:247 < 1 || FLAG:7 == 2) && !口上有無確認(LOCAL)
		WSTR:(K++) =
		CFLAG:247= 1
	ENDIF		
ENDIF

;-------------------------------------------------
;분유
;-------------------------------------------------
SIF 口上有無確認(0) && K > 0
	CALL WSTR書き込み,K - 1
LOCAL = K

;噴乳している
IF TFLAG:11 > 0
	WSTR:(K++) = 「아…… 나와버렸어……」
	IF (陥落( ) > 0) && (CFLAG:248 < 3 || FLAG:7 == 2)
		;恋慕、親愛	
		IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"	
			WSTR:(K++) = 
			CFLAG:248= 4
		;淫乱、娼婦	
		ELSEIF 陥落( ) > 0 && RESULTS == "음란"	
			WSTR:(K++) = 
			CFLAG:248= 3
		;服従、隷属	
		ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
			WSTR:(K++) = 
			CFLAG:248= 3
		ENDIF	
		;陥落済み共通
		IF !口上有無確認(LOCAL)
			IF RAND:3 == 0
				IF TALENT:임신
					WSTR:(K++) = 「아직 어린애지만, 아기가 생겨버렸으니 어쩔 수 없네」
				ELSE
					WSTR:(K++) = 「이런 몸이 되어버리면 원래대로 못 돌아가잖아♪」
				ENDIF
			ELSEIF RAND:2 == 0
				WSTR:(K++) = 「부끄럽지만 기분 좋아서 버릇이 되어버릴 것 같아%ハート()%」
			ELSE
				WSTR:(K++) = 「부끄럽지만…… %CSTR:이인칭%이라면 보고 있어도 좋아%ハート()%」
			ENDIF
			CFLAG:248= 3
		ENDIF
	;屈服刻印Lv3
	ELSEIF MARK:굴복각인 == 3 && (CFLAG:248 < 2 || FLAG:7 == 2) && !口上有無確認(LOCAL)
		CFLAG:248= 2
	;それ以外
	ELSEIF (CFLAG:248 < 1 || FLAG:7 == 2) && !口上有無確認(LOCAL)
		IF RAND:2 == 0
			WSTR:(K++) = 「이런 몸, 이제 싫어……」
		ELSE
			WSTR:(K++) = 「어린애라 젖이 나오면 안 되는데, %CSTR:이인칭% 탓에……」
			WSTR:(K++) = 「용서 못 해……」
		ENDIF
		CFLAG:248= 1
	ENDIF
ENDIF

;-------------------------------------------------
;방뇨
;-------------------------------------------------
;放尿している
SIF 口上有無確認(0) && K > 0
	CALL WSTR書き込み,K - 1
LOCAL = K

IF TFLAG:29 > 0 && (TEQUIP:27 || TALENT:57)		
	IF (陥落( ) > 0) && (CFLAG:249 < 3 || FLAG:7 == 2)
		;恋慕、親愛	
		IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"	
			IF RAND:2 == 0
				WSTR:(K++) = 「부끄럽지만…… 기분 좋아서 버릇이 되어버릴 것 같아%ハート()%」
			ELSE
				WSTR:(K++) = 「부끄럽지만……」
				WSTR:(K++) = 「%CSTR:이인칭%이라면…… 보고 있어도 좋아%ハート()%」
			ENDIF
			CFLAG:249= 4
		;淫乱、娼婦	
		ELSEIF 陥落( ) > 0 && RESULTS == "음란"	
			IF RAND:2 == 0
				WSTR:(K++) = 「이런 꼴을 보고 싱글벙글 웃다니」
				WSTR:(K++) = 「%CSTR:이인칭%도 참 대단한 변태야%ハート()%」
			ELSE
				WSTR:(K++) = 「보여지면서 오줌 누는 거 기분 좋아%ハート()%」
			ENDIF
			CFLAG:249= 3
		;服従、隷属	
		ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
			IF RAND:2 == 0
				KSTR:(K++) = 「미안해, %CSTR:이인칭%」
				WSTR:(K++) = 「하지만, 참을 수 없었는걸」
			ELSE
				WSTR:(K++) = 「나중에 청소할 테니까 용서해주세요……」
			ENDIF
			CFLAG:249= 3
		ENDIF	
		;陥落済み共通	
		IF !口上有無確認(LOCAL)
			WSTR:(K++) = 
			CFLAG:249= 3
		ENDIF	
	;屈服刻印Lv3
	ELSEIF MARK:굴복각인 == 3 && (CFLAG:249 < 2 || FLAG:7 == 2) && !口上有無確認(LOCAL)
		WSTR:(K++) = 「안 돼, 보지 마!」
		KSTR:(K++) = 
		KSTR:(K++) = 
		WSTR:(K++) = 「부끄러운데 멈추지 않아……」
		CFLAG:249= 2
	;それ以外
	ELSEIF (CFLAG:249 < 1 || FLAG:7 == 2) && !口上有無確認(LOCAL)
		WSTR:(K++) = 「이런 꼴을 보고 싱글벙글 웃다니」
		WSTR:(K++) = 「%CSTR:이인칭%도 참 대단한 변태야」
		CFLAG:249= 1
	ENDIF
ENDIF

CALL 口上変数表示
;口上がなければ別の口上を呼び出す
IF RESULT == 0
	TRYCCALLFORM KOJO_MESSAGE_PALAMCNG_B_ZZZ
	CATCH
		CALL PALAM_MESSAGE_B
	ENDCATCH
ENDIF


;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_C関係（X1をキャラ番号に置換）
;調教後の変化をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_C_PUB303_3
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_C
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_C_PY1_PUB303_3
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_C_PY1_PUB303_3
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;調教後のテキスト
;-------------------------------------------------
;-------------------------------------------------
;処女喪失(処女のみ)
;-------------------------------------------------
CALL 口上変数初期化

IF TFLAG:3 > 0
	K_CALL:K = PALAM_MESSAGE_C
	;---008 EDIT START---
	;주인에의한처녀상실
	IF TFLAG:20
		;陥落素質チェック
		IF TALENT:연모 || TALENT:친애

			IF RAND:4 == 0
				KSTR:(K++) = 「기뻐…… %CSTR:이인칭%이(가) 처음을 가져가 줘서……」
				WSTR:(K++) = 침대에 남은 처녀의 흔적을 바라보며, %CALLNAME%은(는) 행복한 표정으로 %CALLNAME:MASTER%을(를) 올려다보았다.
				IF 体格差() > 1
					WSTR:(K++) = 「엄청 아파서 몸이 반으로 쪼개지는 줄 알았지만……」
					WSTR:(K++) = 「지금은 너~무 행복해%ハート()%」
					WSTR:(K++) = 「저기 %CSTR:이인칭%, 절대로 떨어지지 마……」
				ELSEIF ABL:종족 == 0
					WSTR:(K++) = 「아팠지만……」
					WSTR:(K++) = 「%CSTR:일인칭%, 너~무 행복해%ハート()%」
					WSTR:(K++) = 「이걸로 반 애들한테 자랑할 수 있겠어♪」
				ELSE
					WSTR:(K++) = 「%CSTR:일인칭%은(는) 악마고 %CSTR:이인칭%은(는) 인간이니까」
					WSTR:(K++) = 「이런 짓, 절대 무리라고 생각했어」
					WSTR:(K++) = 「그러니까 절대로 놓지 말아줘……」
				ENDIF
			ELSEIF RAND:3 == 0
				WSTR:(K++) = 「%CSTR:이인칭%은(는) %CSTR:일인칭%의 처음을 가져갔으니까」
				WSTR:(K++) = 「책임지고 %CSTR:일인칭%을(를) 행복하게 해줄 의무가 있다구%ハート()%」
			ELSEIF RAND:2 == 0
				KSTR:(K++) = 「%CSTR:이인칭%에게 처음을 빼앗겨버렸어……%ハート()%」
				WSTR:(K++) = 가랑이에서 순결의 증표를 흘리며 %CALLNAME%은(는) 기쁜 듯 미소 짓는다.
				WSTR:(K++) = 「이제 완전히 %CSTR:일인칭%은(는) %CSTR:이인칭%의 것이네」
				WSTR:(K++) = 「왠지 기뻐……%ハート()%」
			ELSE
				IF ABL:종족 == 0
					WSTR:(K++) = 「미성년자라 결혼은 못 하지만」
					WSTR:(K++) = 「크면 결혼이야%ハート()%」
				ELSE
					WSTR:(K++) = 「알고 있어-?」
					WSTR:(K++) = 「악마들 사이에선 처음을 빼앗은 상대한테 평생 봉사해야 한다는 규칙이 있어」
					KSTR:(K++) = 　
					WSTR:(K++) = 「농담이야♪」
					WSTR:(K++) = 「하지만 %CSTR:이인칭%은(는) %CSTR:일인칭%의 처음을 가져갔으니까 책임져줘야겠어」
				ENDIF
				WSTR:(K++) = 「절대적인 약속이야%ハート()%」
			ENDIF
		ELSEIF TALENT:음란 || TALENT:창부
			IF RAND:5 && TEQUIP:비디오카메라 == 1
				KSTR:(K++) = 「이 비디오, 부모님이 보면 기절할 일이네♪」
			ELSEIF RAND:4 == 0 && ABL:종족 == 0
				KSTR:(K++) = 「이걸로 반 친구들한테 무시당하지 않게 됐어♪」
			ELSEIF RAND:3 == 0 && ABL:종족 != 0
				KSTR:(K++) = 「인간 상대로 첫 섹스라니 %CSTR:일인칭% 정도뿐일 거야」
			ELSEIF RAND:2 == 0
				WSTR:(K++) = 「이걸로 귀찮은 것도 사라졌으니 마음껏 할 수 있겠어♪」
				KSTR:(K++) = 「일단 백인 베기부터 목표로 할 거야」
			ELSE
				KSTR:(K++) = 「조금 아팠지만 기분 좋았어♪」
			ENDIF
			WSTR:(K++) = 사타구니에서 흘러나오는 순결의 증표를 바라보며 %CALLNAME%은(는) 기쁜 듯 미소지었다.
		ELSEIF TALENT:복종 || TALENT:예속
			IF RAND:2 == 0
				WSTR:(K++) = 「조금 아팠지만, %CSTR:이인칭%이(가) 기뻐해준다면 나도 기뻐」
				WSTR:(K++) = 「어땠어, 즐거웠어?」
			ELSE
				KSTR:(K++) = 「%CSTR:일인칭%의 처음을 가져가 주셔서 감사해요」
				WSTR:(K++) = 「어른 여자로 만들어줘서 %CSTR:일인칭%, 행복해」
			ENDIF
		ELSE
			;屈服刻印Lv3
			IF MARK:굴복각인 == 3
				IF RAND:2 == 0
					WSTR:(K++) = 「%CSTR:일인칭%의 처음……」
				ELSE
					WSTR:(K++) = 「처음도 %CALLNAME:MASTER%한테 빼앗겨버렸어……」
				ENDIF
				WSTR:(K++) = （이제 항복하는 길밖에 없는 거야?）
				WSTR:(K++) = 가랑이에서 순결의 증표를 흘리며 %CALLNAME%은(는) 멍하니 있다.
			ELSE
				IF RAND:4 == 0
					KSTR:(K++) = 「절대로 용서 안 해……」
					NSTR:(K++) = 이쪽을 노려보며
				ELSEIF RAND:3 == 0
					KSTR:(K++) = 「이런 처녀 상실, 말도 안 돼……」
				ELSEIF RAND:2 == 0
					KSTR:(K++) = 「거짓말…… %CSTR:일인칭%의 처음이……」
				ELSE
					KSTR:(K++) = 「이제 집에 보내줘……」
				ENDIF
				WSTR:(K++) = 가랑이에서 순결의 증표를 흘리며 %CALLNAME%은(는) 눈물을 글썽이고 있다.
			ENDIF
		ENDIF
	;それ以外の時に処女喪失(主人による道具系調教含む)
	ELSE
		;恋慕、親愛	
		IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"	
			KSTR:(K++) = 「첫 상대는 %CSTR:이인칭%(으)로 정해뒀었는데……」
			WSTR:(K++) = 가랑이에서 순결의 증표를 흘리며 %CALLNAME%은(는) 슬픈 표정을 짓고 있다.
			KSTR:(K++) = 「그치만 %CSTR:일인칭%, %CSTR:이인칭%을(를) 좋아하는걸」
			WSTR:(K++) = 「그러니까 버리지 마」
		;淫乱、娼婦	
		ELSEIF 陥落( ) > 0 && RESULTS == "음란"
			IF RAND:5 && TEQUIP:비디오카메라 == 1
				KSTR:(K++) = 「이 비디오, 부모님이 보면 기절할 일이네♪」
			ELSEIF RAND:4 == 0 && ABL:종족 == 0
				KSTR:(K++) = 「이걸로 반 친구들한테 무시당하지 않게 됐어♪」
			ELSEIF RAND:3 == 0 && ABL:종족 != 0
				KSTR:(K++) = 「인간 상대로 첫 섹스라니 %CSTR:일인칭% 정도뿐일 거야」
			ELSEIF RAND:2 == 0
				WSTR:(K++) = 「이걸로 귀찮은 것도 사라졌으니 마음껏 할 수 있겠어♪」
				KSTR:(K++) = 「일단 백인 베기부터 목표로 할 거야」
			ELSE
				KSTR:(K++) = 「조금 아팠지만 기분 좋았어♪」
			ENDIF
			WSTR:(K++) = 사타구니에서 흘러나오는 순결의 증표를 바라보며 %CALLNAME%은(는) 기쁜 듯 미소지었다.
		;服従、隷属	
		ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
			IF RAND:2 == 0
				WSTR:(K++) = 「조금 아팠지만, %CSTR:이인칭%이(가) 기뻐해준다면 나도 기뻐」
				WSTR:(K++) = 「어땠어, 즐거웠어?」
			ELSE
				KSTR:(K++) = 「%CSTR:일인칭%의 처음을 가져가 주셔서 감사해요」
				WSTR:(K++) = 「어른 여자로 만들어줘서 %CSTR:일인칭%, 행복해」
			ENDIF
		;屈服刻印Lv3
		ELSEIF MARK:굴복각인 == 3
			IF RAND:2 == 0
				WSTR:(K++) = 「%CSTR:일인칭%의 처음……」
			ELSE
				WSTR:(K++) = 「처음도 %CALLNAME:MASTER%한테 빼앗겨버렸어……」
			ENDIF
			WSTR:(K++) = （이제 항복하는 길밖에 없는 거야?）
			WSTR:(K++) = 가랑이에서 순결의 증표를 흘리며 %CALLNAME%은(는) 멍하니 있다.
		;それ以外
		ELSE
			IF RAND:4 == 0
				KSTR:(K++) = 「절대로 용서 안 해……」
				NSTR:(K++) = 이쪽을 노려보며
			ELSEIF RAND:3 == 0
				KSTR:(K++) = 「이런 처녀 상실, 말도 안 돼……」
			ELSEIF RAND:2 == 0
				KSTR:(K++) = 「거짓말…… %CSTR:일인칭%의 처음이……」
			ELSE
				KSTR:(K++) = 「이제 집에 보내줘……」
			ENDIF
			WSTR:(K++) = 가랑이에서 순결의 증표를 흘리며 %CALLNAME%은(는) 눈물을 글썽이고 있다.
		ENDIF
	ENDIF
	;---008 EDIT END---
ENDIF

