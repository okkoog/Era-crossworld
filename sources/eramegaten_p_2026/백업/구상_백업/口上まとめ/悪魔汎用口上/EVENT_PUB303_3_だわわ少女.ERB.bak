;-------------------------------------------------
;闘技場敗北時口上集（X1をキャラ番号に置換する） 基本的に見るとゲームオーバーなのでフラグは使わない事に
;-------------------------------------------------
@KOJO_MESSAGE_LOSE_COLOSSEUM_PUB303_3
CALL 口上変数初期化
SELECTCASE TFLAG:투기장패배
		;-------------------------------------------------
		;オニ＆蔦
		;-------------------------------------------------
	CASE 1
			K_CALL:K = MESSAGE_LOSE_COLOSSEUM
			;恋慕、親愛
			IF TALENT:3 || TALENT:6
				WSTR:(K++) = 
			;淫乱、娼婦
			ELSEIF TALENT:4 || TALENT:7
				WSTR:(K++) = 
			;服従、隷属
			ELSEIF TALENT:5 || TALENT:8
				WSTR:(K++) = 
			ENDIF
			;その他
			IF !口上有無確認(0)
				WSTR:(K++) = 
			ENDIF
ENDSELECT
CALL 口上変数表示
;口上がなければ別の口上を呼び出す
IF RESULT == 0
	TRYCCALLFORM KOJO_MESSAGE_LOSE_COLOSSEUM_ZZZ
	CATCH
		CALL MESSAGE_LOSE_COLOSSEUM
	ENDCATCH
ENDIF


