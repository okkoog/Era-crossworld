	CASE 68
			K_CALL:K = EVENT_MESSAGE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8)
				;恋慕、親愛	
				IF (TALENT:3 || TALENT:6)
					IF RAND:4 == 0 && HAVE_PENIS() && TALENT:MASTER:임신 == 0
						KSTR:(K++) = 「자는 사이에 아이 만들기 시작해버렸어%ハート()%」
					ELSEIF RAND:3 == 0
						KSTR:(K++) = 「아침부터 사랑을 나눠서 정말 행복해%ハート()%」
					ELSEIF RAND:2 == 0
						KSTR:(K++) = 「%CSTR:이인칭%의 가랑이, 아침부터 질척질척해%ハート()%」
						WSTR:(K++) = 「원인은 %CSTR:일인칭%이지만」
						KSTR:(K++) = 「그치만, %CSTR:이인칭%의 귀여운 자는 얼굴을 보고 있으니 꼴려버렸는걸」
						WSTR:(K++) = 「어쩔 수 없네%ハート()%」
					ELSE
						KSTR:(K++) = 「자면서 느끼고 있는 얼굴, 귀여웠어%ハート()%」
					ENDIF
				;淫乱、娼婦	
				ELSEIF (TALENT:4 || TALENT:7)
					IF HAVE_PENIS()
						IF RAND:3 == 0
							KSTR:(K++) = 「모닝 발기가 안 가라앉아서 상대해주고 있는 거야」
							WSTR:(K++) = 「이대로 점심때까지 해버릴까♪」
						ELSEIF RAND:2 == 0
							KSTR:(K++) = 「아침 첫 정액, 듬뿍 낼 테니까 받아줘♪」
						ELSE
							KSTR:(K++) = 「후우~」
							WSTR:(K++) = 「잔뜩 사정했더니 아침부터 허리가 가볍네♪」
						ENDIF
					ELSE
						IF RAND:2 == 0
							KSTR:(K++) = 「저기, %CSTR:일인칭%한테 고추 자라나게 해보지 않을래?」
							WSTR:(K++) = 「진짜 고추로 울려줄게♪」
						ELSEIF RAND:2 == 0
							KSTR:(K++) = 「어때? 진짜 자지가 아니어도 기분 좋았지♪」
						ELSE
							KSTR:(K++) = 「후우~」
							WSTR:(K++) = 「허리를 너무 흔들어서 아침부터 허리가 가볍네♪」
						ENDIF
					ENDIF
				;服従、隷属	
				ELSEIF (TALENT:5 || TALENT:8)
					IF RAND:2 == 0 && HAVE_PENIS() && TALENT:MASTER:임신 == 0
						KSTR:(K++) = 「%CSTR:이인칭%을(를) 임신시키면 어떤 벌이 주어질까 생각하면」
						KSTR:(K++) = 「발기가 가라앉질 않네♪」
						WSTR:(K++) = %CALLNAME%은(는) 기대하는 듯한 눈으로 이쪽을 바라보고 있다
					ELSE
						KSTR:(K++) = 「아침부터 주인님을 레이프해버리는 노예는」
						KSTR:(K++) = 「역시 벌을 받아도 어쩔 수 없겠네♪」
						WSTR:(K++) = %CALLNAME%은(는) 기대하는 듯한 눈으로 이쪽을 바라보고 있다
					ENDIF
				ENDIF	
				;陥落済み共通	
				IF !口上有無確認(0)
					WSTR:(K++) =
				ENDIF	
			ENDIF

