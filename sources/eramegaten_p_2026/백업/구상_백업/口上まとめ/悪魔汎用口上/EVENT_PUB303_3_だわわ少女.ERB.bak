IF TFLAG:8 > 0
	;ABL:정액중독　ABL:ASSI:정액중독
	K_CALL:K = PALAM_MESSAGE_C
	;ダブルフェラ後助手とザーメンキス　条件:調教対象か助手が精液中毒持ち
	IF TFLAG:8 >= 2
		;陥落済み
		IF 陥落()
			WSTR:(K++) =
		ENDIF
		;従順Lv3
		IF ABL:0 >= 3 && !口上有無確認(0)
			WSTR:(K++) = 
		ENDIF
		;共通	
		IF !口上有無確認(0)
			WSTR:(K++) =
		ENDIF	
	ENDIF
	;ダブルフェラで助手とお掃除フェラ
