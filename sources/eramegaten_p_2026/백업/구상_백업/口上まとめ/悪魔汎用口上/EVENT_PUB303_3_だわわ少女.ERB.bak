;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_D関係（X1をキャラ番号に置換）
;パラメータ変化をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_D_PUB303_3
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_D
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_D_PY1_PUB303_3
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_D_PY1_PUB303_3
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;パラメータ変化時のテキスト
;-------------------------------------------------
CALL 口上変数初期化
;-------------------------------------------------
;初めて潤滑がLV3超えた
;-------------------------------------------------
P = PALAM:4 + CUP:4
IF P > PALAMLV:4 && CFLAG:250 == 0
	K_CALL:K = PALAM_MESSAGE_D
	;ローションを使った場合
	IF SELECTCOM == 180
		WSTR:(K++) = 「이런 이상한 걸 바르고선…… 미끌미끌해……」
	;それ以外
	ELSE
		IF RAND:2 == 0
			WSTR:(K++) = 「저, 젖지 않았거든!」
			WSTR:(K++) = 「이건 땀…… 땀이라구! 만지니까 땀 흘린 거란 말이야!」
		ELSE
			KSTR:(K++) = (어떡하지…… 기분 좋아서 젖어오고 있어……）
			WSTR:(K++) = %CALLNAME%은(는) 상기된 얼굴로 자신의 비밀스러운 부위를 바라보고 있다.
		ENDIF
	ENDIF
	CFLAG:250 = 1
ENDIF

;-------------------------------------------------
;初めて欲情がLV2超えた
;-------------------------------------------------
P = PALAM:6 + CUP:6
IF P > PALAMLV:3 && CFLAG:251 == 0
	K_CALL:K = PALAM_MESSAGE_D
	;媚薬を使った場合
	IF SELECTCOM == 181
		;屈服刻印Lv3以下　か　反発刻印Lv3　の場合
		IF MARK:굴복각인 < 3 || MARK:3 == 3
			KSTR:(K++) = 「아까 먹은 약 때문에 몸이 뜨거워……」
			WSTR:(K++) = %CALLNAME%은(는) 이쪽을 노려보고 있다
		ELSE
			WSTR:(K++) = 「아까 먹은 약 때문에 몸이 뜨거워……」
		ENDIF
	;それ以外
	ELSE
		WSTR:(K++) =  %CALLNAME%의 얼굴은 발그레 붉어져 있다
		IF RAND:2 == 0
			KSTR:(K++) = 「아니야……」
			WSTR:(K++) = 「이건 더워서 빨개진 것뿐이야」
		ELSE
			WSTR:(K++) = （심장이 쿵쾅거리고 온몸이 뜨거워져서……）
			WSTR:(K++) = （%CSTR:일인칭%의 몸, 어떻게 되어가는 거야?）
		ENDIF
	ENDIF
	CFLAG:251 = 1
ENDIF

;-------------------------------------------------
;初めて屈服がLV3超えた
;-------------------------------------------------
P = PALAM:7 + CUP:7
IF P > PALAMLV:3 && CFLAG:252 == 0
	K_CALL:K = PALAM_MESSAGE_D
	IF RAND:3 == 0
		WSTR:(K++) = （%CSTR:일인칭%, %CSTR:이인칭%한테 져버렸어……）
	ELSEIF RAND:2 == 0
		WSTR:(K++) = （이 사람한테는 거역할 수 없어……）
	ELSE
		WSTR:(K++) = 「%CSTR:일인칭%의 패배야」
	ENDIF
	CFLAG:252 = 1
ENDIF

;-------------------------------------------------
;初めて恭順がLV3超えた
;-------------------------------------------------
P = PALAM:5 + CUP:5
IF P > PALAMLV:3 && CFLAG:253 == 0
	K_CALL:K = PALAM_MESSAGE_D
	;陥落済み
	IF 陥落( ) > 0
		WSTR:(K++) = 「역시 %CSTR:이인칭%과(와) 함께 있으면 진정돼……」
	;それ以外
	ELSE
		KSTR:(K++) = 「%CSTR:이인칭%(와)과라면 함께 있어도……」
		KSTR:(K++) = 「！」
		WSTR:(K++) = 「아, 아무것도 아니야, 혼잣말이라구!」
	ENDIF
	CFLAG:253 = 1
ENDIF

;-------------------------------------------------
;初めて恐怖がLV3超えた
;-------------------------------------------------
P = PALAM:11 + CUP:11
IF P > PALAMLV:3 && CFLAG:254 == 0
	K_CALL:K = PALAM_MESSAGE_D
	;陥落済み
	IF 陥落( ) > 0
		WSTR:(K++) = 「왜 그런 짓을 하는 거야? 이상하잖아!」
	;それ以外
	ELSE
		WSTR:(K++) = 「용서해줘! %CSTR:일인칭%이(가) 잘못했어!」
	ENDIF
	CFLAG:254 = 1
ENDIF

CALL 口上変数表示
IF RESULT == 0
	TRYCCALLFORM KOJO_MESSAGE_PALAMCNG_D_ZZZ
	CATCH
		CALL PALAM_MESSAGE_D
	ENDCATCH
ENDIF

;-------------------------------------------------
;@KOJO_MESSAGE_MARKCNG関係（X1をキャラ番号に置換）
;刻印変動をトリガーにした口上
;刻印変動後に口上を発動します
;-------------------------------------------------
@KOJO_MESSAGE_MARKCNG_PUB303_3
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL MARK_MESSAGE
	RETURN 0
ENDIF

CALL 口上変数初期化
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_MARKCNG_PY1_PUB303_3
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_MARKCNG_PY1_PUB303_3
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;苦痛刻印Lv3
;-------------------------------------------------
LOCAL = K
IF TFLAG:22 == 3
	K_CALL:K = MARK_MESSAGE_A	
	;恋慕、親愛	
	IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"	
		WSTR:(K++) = 「아파, 아프다구!」
		WSTR:(K++) = （어라? 왠지 좀 좋을지도♪）
	;淫乱、娼婦	
	ELSEIF 陥落( ) > 0 && RESULTS == "음란"	
		KSTR:(K++) = (앗…）
		WSTR:(K++) = （아픈 것도 기분 좋을지도♪）
	;服従、隷属	
	ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
		WSTR:(K++) = 「아프지만……」
		WSTR:(K++) = 「기뻐, %CSTR:이인칭%♪」
	ENDIF
	;共通
	IF !口上有無確認(LOCAL)
		WSTR:(K++) = 
	ENDIF		
	SIF !口上有無確認(LOCAL)
		CALL MARK_MESSAGE_A
ENDIF
;-------------------------------------------------
;快楽刻印Lv3
;-------------------------------------------------

LOCAL = K
IF TFLAG:23 == 3
	K_CALL:K = MARK_MESSAGE_P
	;恋慕、親愛	
	IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"	
		WSTR:(K++) = （%CSTR:이인칭%, 좋아, 너무 좋아……）
		KSTR:(K++) = (더 계속 안아줬으면 좋겠어…… %CSTR:이인칭%(와)과 가득 야한 짓 하고 싶어%ハート()%）
		WSTR:(K++) = %CALLNAME%은(는) 뺨을 붉게 물들이며 촉촉해진 눈동자를 %CALLNAME:MASTER%에게 향하고 있었다.
	;服従、隷属	
	ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
		KSTR:(K++) = (%CSTR:일인칭%을(를) 괴롭힐 뿐만 아니라 이렇게 기분 좋게 해주다니, %CSTR:이인칭%이(가) 더 좋아져 버리잖아）
		WSTR:(K++) = %CALLNAME%은(는) 도취된 표정으로 행복한 듯한 눈동자를 %CALLNAME:MASTER%에게 향하고 있었다.
	ELSE
		IF RAND:3 == 0
			WSTR:(K++) = 「아하아…… 좋아, 기분 좋은 거 너무 좋아%ハート()%」
			KSTR:(K++) = 「%CSTR:일인칭%, 이제 야한 생각밖에 안 들어……%ハート()%」
		ELSEIF RAND:2 == 0
			WSTR:(K++) = （기분 좋아……）
			KSTR:(K++) = (이제 %CSTR:일인칭%, 이 기분 좋음을 잊을 수 없어……）
		ELSE
			WSTR:(K++) = 「이렇게 기분 좋은 건 처음이야」
			KSTR:(K++) = 「더 많이 해주면, %CSTR:일인칭%……」
		ENDIF
		WSTR:(K++) = %CALLNAME%은(는) 멍하니 상기된 얼굴로 %CALLNAME:MASTER%을(를) 바라보고 있었다.
	ENDIF
	;共通
	IF !口上有無確認(LOCAL)
		WSTR:(K++) = 
	ENDIF		
	SIF !口上有無確認(LOCAL)
		CALL MARK_MESSAGE_P
ENDIF

;-------------------------------------------------
;屈服刻印Lv3
;-------------------------------------------------
LOCAL = K
IF TFLAG:24 == 13 || TFLAG:24 == 23 || TFLAG:24 == 33
	K_CALL:K = MARK_MESSAGE_S
	;快楽による屈服
	IF TFLAG:24 == 13
		IF RAND:2 == 0 && ABL:종족 == 0
			;人間の場合
			KSTR:(K++) = 「이렇게 기분 좋은 거, 학교에선 안 가르쳐줬는걸♪」
			KSTR:(K++) = 「그…… 더 많이 가르쳐줬으면 좋겠는데?」
			WSTR:(K++) = %CALLNAME%은(는) 욕정이 남아있는 눈빛으로 더한 조교를 요구하고 있다.
		ELSE
			KSTR:(K++) = (기분 좋은 거 좋아…… 더 엉망진창으로 만들어줬으면 좋겠어）
			KSTR:(K++) = (뭐든지 말 들을 테니까 기분 좋게 해줬으면 좋겠어）
			WSTR:(K++) = %CALLNAME%은(는) 힘없이 누운 채 욕정이 남아있는 눈빛으로 %CALLNAME:MASTER%을(를) 올려다보았다.
		ENDIF
	;恐怖と苦痛による屈服
	ELSEIF TFLAG:24 == 23
		IF RAND:2 == 0
			KSTR:(K++) = (%CSTR:이인칭%에게 거역하면 안 되는 거구나…）
			WSTR:(K++) = %CALLNAME%은(는) 힘없이 누운 채 공허한 눈빛을 천장으로 향하고 있다……
		ELSE
			WSTR:(K++) = 「미안해, 미안해!」
			KSTR:(K++) = 「아픈 거, 이제 싫어」
			KSTR:(K++) = 「%CSTR:일인칭%, 시키는 대로 할게!」
			;WSTR:(K++) = %CALLNAME%は床に頭を擦りつけて屈服の姿勢を示した……
		ENDIF
	;屈服と恭順による屈服
	ELSEIF TFLAG:24 == 33
		IF RAND:2 == 0 && ABL:종족 != 0
			;悪魔の場合
			KSTR:(K++) = (악마인데도 인간 따위에게 져버렸어……）
		ELSE
			KSTR:(K++) = (이제 %CSTR:일인칭% 안 돼…… %CSTR:이인칭%에게서 떨어질 수 없어……）
		ENDIF
		WSTR:(K++) = %CALLNAME%은(는) 힘없이 누운 채 공허한 눈빛을 천장으로 향하고 있다……
	ENDIF
	SIF !口上有無確認(LOCAL)
		CALL MARK_MESSAGE_S
ENDIF

;-------------------------------------------------
;反発刻印Lv3
;-------------------------------------------------
LOCAL = K
IF TFLAG:21 == 3
	K_CALL:K = MARK_MESSAGE_R
	;陥落済み
	IF 陥落( ) > 0
		;恋慕、親愛	
		IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"	
			IF RAND:2 == 0
				WSTR:(K++) = 「이런 거…… 믿을 수 없어!」
			ELSE
				WSTR:(K++) = 「아무리 %CSTR:이인칭%이라도 그건 안 돼!」
			ENDIF
		;淫乱、娼婦	
		ELSEIF 陥落( ) > 0 && RESULTS == "음란"	
			WSTR:(K++) = 「그건 기분 좋지 않으니까 싫어」
		;服従、隷属	
		ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"	
			WSTR:(K++) = 「아무리 %CSTR:이인칭%이라도 이건 너무해!」
		ENDIF	
		;陥落済み共通	
		IF !口上有無確認(LOCAL)
			WSTR:(K++) = 
		ENDIF	
	ENDIF
	;それ以外
	IF !口上有無確認(LOCAL)
		WSTR:(K++) = 
	ENDIF
	SIF !口上有無確認(LOCAL)
		CALL MARK_MESSAGE_R
ENDIF

CALL 口上変数表示
IF RESULT == 0
	TRYCCALLFORM KOJO_MESSAGE_MARKCNG_ZZZ
	CATCH
	ENDCATCH
	
ENDIF
;-------------------------------------------------
;イベント口上集（X1をキャラ番号に置換する） CFLAG 261～299を使用
;-------------------------------------------------
@KOJO_MESSAGE_EVENT_PUB303_3

;--------------------------------------------------
;特定主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_EVENT_PY1_PUB303_3
;	RETURN 0
;ENDIF


CALL 口上変数初期化

SELECTCASE TFLAG:13
;　　1:朝フェラ
;　　2:朝パイズリ
;　　3:朝騎乗位
;　　4:調教後レズプレイ
;　　5:調教後セックス
