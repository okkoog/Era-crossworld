;-------------------------------------------------
;eraMegaten専用口上テンプレート
;X1とX2をキャラ番号に置換し、Y1を助手のキャラ番号に置換してください
;ただし、キャラ番号が一桁のキャラの場合、X1,Y1は1、X2は01のように変えてください
;そしてコマンド内の適当な条件の下のPRINTFORMWの後ろに半角スペースを置いてセリフを追加してください
;口上を追加しないコマンドは無記入でも構いませんが、CFLAG:XXXの頭に『;』をつけてコメントアウトすると尚良いでしょう
;エキストラ構文など、コメントアウトされている構文を使う際には、『;』を外してコメントアウトを解除する必要があります
;最後にread meにも目を通しておくことをお勧めします
;-------------------------------------------------

;-------------------------------------------------
;汎用口上の作成に使用する場合は、X1→キャラ番号ではなく、
;PUB303_3→PUB会話タイプ番号　へと変換してご使用ください
;-------------------------------------------------
;ライセンスについて
;	・基本項目(許可する項目を"○"に、許可しない項目を"×"に変更してください。)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1| ○ | 処理上のバグ修正              |
;	+----+----+-------------------------------+
;	|   2| ○ | 口上の誤字・脱字の修正        |
;	+----+----+-------------------------------+
;	|   3| ○ | 口上まとめへの収録            |
;	+----+----+-------------------------------+
;	|   4| ○ | 口上の新規追加                |
;	+----+----+-------------------------------+
;	|   5| ○ | 既存口上の改変                |
;	+----+----+-------------------------------+
;	|   6| ○ | 改変した口上の自由な再配布    |
;	+----+----+-------------------------------+
;	|   7| ○ | 口上内容の転載                |
;	+----+----+-------------------------------+

;--------------------------------------------------
;口上内で使うローカルCFLAG
;--------------------------------------------------
;800	バエルフラグ

;810	初期乳サイズ	初回口上時にBUST()関数で取得する
;811	前回乳サイズ	調教開始時にBUST()関数で取得する


;--------------------------------------------------
;口上セレクト機能：口上説明
;--------------------------------------------------
;この関数のコメントアウトを外すと、口上の選択時に選択肢として候補にあがります
;既に口上のあるキャラや会話タイプの別版の口上を作成する時に利用してください
;その際、この関数を含めたこのファイル内の関数名すべてに_任意の1-49(汎用口上なら1-9)の数字を加えてください
;例： EVENTTRAIN_PUB303_3 → EVENTTRAIN_PUB303_3_12
;--------------------------------------------------
@セレクト口上説明_PUB303_3,ARG = 0

K:1 = 0

;口上セレクトできるかの判定
;素質によってプラスマイナスして、最終値が＋２以上なら口上がセレクトできる

;プラス要素
SIF TALENT:반항적
	K:1 += 2
SIF TALENT:꿋꿋함
	K:1 += 4
SIF TALENT:건방짐
	K:1 += 3
SIF TALENT:츤데레
	K:1 += 1
SIF TALENT:프라이드높음
	K:1 += 3
SIF TALENT:MASTER:남자 && TALENT:남성혐오
	K:1 += 2
SIF TALENT:MASTER:남자 == 0 && TALENT:여성혐오
	K:1 += 1

;マイナス要素
SIF TALENT:겁쟁이
	K:1 -= 5
SIF TALENT:솔직함
	K:1 -= 5
SIF TALENT:얌전함
	K:1 -= 5
SIF TALENT:프라이드낮음
	K:1 -= 5
SIF TALENT:무관심
	K:1 -= 5
SIF TALENT:감정결핍
	K:1 -= 5
SIF TALENT:비관적
	K:1 -= 5
SIF TALENT:약점
	K:1 -= 5
SIF TALENT:헌신적
	K:1 -= 5
SIF TALENT:모성
	K:1 -= 5

SIF K:1 < 1
	RETURN -1
SIF ARG == 1
	RETURN 0
;口上名
PRINTFORML 범용 여성・다와와 소녀 구상
PRINTFORML 　구상 설명문 　어미가 『~야』『~인걸』인 살짝 콧대 높은 소녀

;--------------------------------------------------
;EVENTTRAIN関係（X1をキャラ番号に置換）
;調教開始時のセリフ CFLAG 201～219を使用
;--------------------------------------------------
@EVENTTRAIN_PUB303_3
CALL 口上変数初期化
;--------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;--------------------------------------------------
;IF CFLAG:220 == 0
;	PRINTL 処女モードに移行しますか？
;	PRINTL [0] はい
;	PRINTL [1] いいえ
;	$INPUT_LOOP
;	INPUT
;	IF RESULT == 0
;		WSTR:(K++) = ―処女モードに素質、能力を変更します―
;		TALENT:TARGET:0 = 1
;		ABL:TARGET:4 = 0
;		EXP:TARGET:0 = 0
;	ELSEIF RESULT == 1
;		WSTR:(K++) = ―通常モードで調教を開始します―
;	ELSE
;		GOTO INPUT_LOOP
;	ENDIF
;	CFLAG:220 = 1
;ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL EVENTTRAIN_PY1_PUB303_3
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL EVENTTRAIN_PY1_PUB303_3
;		RETURN 0
;	ENDIF
;ENDIF
;--------------------------------------------------
;簡易助手口上の発動時に初調教時口上をスキップ（Y1を助手のキャラ番号にする）
;複数人いる際には、SIF NO:ASSI == Y1 || NO:ASSI == Z1と追加していく
;--------------------------------------------------
;IF CFLAG:201 == 0 && ASSI > 0
;	SIF NO:ASSI == Y1
;		CFLAG:201 =1
;ENDIF
;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時に乳サイズを取得する
SIF CFLAG:201 == 0
	CFLAG:810 = BUST(TARGET)
	CFLAG:811 = BUST(TARGET)

;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	PRINTFORMW 「%CSTR:이인칭%, 무슨 볼일이야?」
	PRINTFORMW 「……에? 조교?」
	;人間キャラの場合
	IF ABL:종족 == 0
		IF RAND:2 == 0
			PRINTFORMW 「흥, 애 상대로나 큰소리치다니 못난 어른이야」
			IF TALENT:처녀
				PRINTFORMW 강한 척하는 %CALLNAME%을(를) 어떻게 함락시킬까……
			ELSE
				PRINTFORML 「게다가 %CSTR:일인칭%, 이미 경험했으니까」
				PRINTFORMW 「처녀 상실로 멘탈을 꺾는다니 무의미해」
				PRINTFORMW 여유를 부리는 %CALLNAME%을(를) 어떻게 함락시킬까……
			ENDIF
		ELSE
			PRINTFORMW 「어린애를 납치해서 조교라니 구제불능 변태야」
			IF TALENT:처녀
				PRINTFORML 　
				PRINTFORML 「하아……」
				PRINTFORMW 「이걸로 처녀와도 작별인가……」
			ELSE
				PRINTFORMW (틈을 봐서 도망쳐줄 테니까……)
			ENDIF
		ENDIF
	;悪魔の場合
	ELSE
		IF RAND:2 == 0
			PRINTFORML 「흥, 작다고 해도 이래 봬도 악마야」
			PRINTFORML 「만만하게 봐도 곤란해」
			PRINTFORMW 계약으로 묶여 있음에도 강한 척하는 %CALLNAME%을(를) 어떻게 함락시킬까……
		ELSE
			PRINTFORMW 「인간 여자한테 상대가 안 돼서」
			PRINTFORMW 「그렇다고 어린애를 덮칠 용기도 없어」
			PRINTFORMW 「그래서 계약해서 거역할 수 없는 작은 악마를 덮치는 거지」
			PRINTFORMW 「그런 거지」
			IF TALENT:처녀
				PRINTFORML 　
				PRINTFORMW 「뭐, 해보면 알겠지」
			ELSE
				PRINTFORMW 「안됐지만」
				PRINTFORMW 「%CSTR:일인칭%, 이미 경험했는걸」
				PRINTFORML 「何？」
				PRINTFORMW 「악마와 인간을 똑같이 생각하면 곤란해」
			ENDIF
		ENDIF
	ENDIF
	CFLAG:201 = 1
	GOTO 表示
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:굴복각인 == 1
	PRINTFORMW 「%CSTR:이인칭% 따위에게 굴복하지 않을 거야」
	CFLAG:201 = 2
	GOTO 表示
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:굴복각인 == 2
	PRINTFORML 「오늘은 뭘 할 셈이야?」
	PRINTFORMW 오늘은 꽤나 얌전하다
	PRINTFORML 「어차피 저항해도 안 된다면 날뛰어봤자 체력 낭비야」
	PRINTFORMW %CALLNAME%도 제법 이해한 모양이다
	CFLAG:201 = 3
	GOTO 表示
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:굴복각인 == 3 && 陥落()> 0
	IF RAND:2 == 0
		PRINTFORML 「오늘은 뭘 할 셈이야?」
		PRINTFORMW 요전과 조금 모습이 다른 것 같다
		PRINTFORMW 「조금이라면……」
		PRINTFORML 「저번보다 야한 짓을 해도 용서해줄게」
	ELSE
		PRINTFORML 「자, %CSTR:일인칭%을(를) 원하잖아」
		PRINTFORMW 요전과 조금 모습이 다른 것 같다
		PRINTFORMW 「어차피 거역할 수도 없고」
		PRINTFORML 「게다가 %CSTR:이인칭%에게 이런저런 짓 당하는 거, 나쁘지 않아……」
	ENDIF
	PRINTFORMW %CALLNAME%은(는) 얼굴을 붉히며 중얼거렸다
	CFLAG:201 = 4
	GOTO 表示
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		IF CFLAG:미조교함락 == 1
			;調教せずに恋慕をつけた場合
			IF RAND:2 == 0
				PRINTFORML 「준비라면 다 됐어」
				PRINTFORMW 전투 준비가 완벽한 %CALLNAME%에게 앞으로 행할 것을 설명했다.
				PRINTFORML 　
				PRINTFORMW 「……엣?」
				PRINTFORMW 「뭐, 뭐어……」
				PRINTFORML 「싸울 때 감싸주거나 하니까」
				PRINTFORMW 「특별히 허락해줄게」
			ELSE
				PRINTFORMW 「%CSTR:일인칭%을(를) 원하다니……」
				PRINTFORMW 「정말 곤란한 사람이야」
				PRINTFORML 　
				PRINTFORMW 「그치만」
				PRINTFORMW 「%CSTR:이인칭%(와)과 함께라면 앞으로 뭐든지 할 수 있어」
				PRINTFORMW 「응, 조교라도……」
			ENDIF
		ELSE
			PRINTFORML 「아……」
			PRINTFORMW 불러낸 %CALLNAME%의 눈동자가 촉촉해져 있다. 아무래도 감정이 고조된 모양이다.
			IF RAND:2 == 0
				PRINTFORMW 「%CSTR:일인칭%……」
				PRINTFORMW 「%CSTR:이인칭%이(가), 좋아진 모양이야」
				PRINTFORMW 「그러니까…… %CSTR:이인칭%이(가) 바라는 거라면 뭐든지 해줄게%ハート()%」
			ELSE
				IF ABL:종족 == 0
					PRINTFORMW 「법으로는 아직 결혼 못 한다는 건 당연히 알고 있지만」
				ELSE
					PRINTFORMW 「%CSTR:일인칭%이(가) 악마이고 %CSTR:이인칭%이라도」
				ENDIF
				PRINTFORML 「연애는 자유야」
				PRINTFORMW 「그러니까 %CSTR:일인칭%은(는) %CSTR:이인칭%을(를) 따라갈 거야」
				PRINTFORML 　
				PRINTFORML 「『안 돼』라고 해도 안 놓아줄 거야%ハート()%」
				PRINTFORMW %CALLNAME%은(는) %CALLNAME:MASTER%의 팔에 매달렸다
			ENDIF
		ENDIF
	;음란
	ELSEIF TALENT:4
		;ランダム奴隷キャラの場合
		IF ABL:종족 == 0 && CFLAG:이벤트가입 == 3
			IF RAND:2 == 0
				PRINTFORML 「%CSTR:이인칭%에게 보지를 보여진 때부터」
				PRINTFORMW 「이렇게 될 운명이었던 거야♪」
				PRINTFORMW 「앞으로는 언제든 원할 때 보여줄게」
				PRINTFORMW 「물론 보는 것뿐만이 아니라, 말이지%ハート()%」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「섹스를 아주 좋아하는 몸이 되어버렸잖아」
				PRINTFORMW 「그치만 그런 눅눅한 곳에 있는 것보단 낫네」
				PRINTFORMW 「그러니까 좋은 거 하자♪」
			ENDIF
		ELSE
			IF RAND:2 == 0
				PRINTFORMW %CALLNAME%을(를) 불러내자, %CALLNAME:MASTER%의 가슴으로 뛰어들어왔다.
				PRINTFORML 「%CSTR:이인칭%의 조교 탓에」
				IF ABL:종족 == 0
					PRINTFORML 「어린아이인데도 이렇게 야한 몸이 되어버렸어」
				ELSE
					PRINTFORML 「이렇게 야한 악마가 되어버렸잖아」
				ENDIF
				PRINTFORMW 「그러니까……」
				PRINTFORMW 「%CSTR:이인칭%에겐 채-임지고 책임져달라고 할 거야♪」
			ELSE
				PRINTFORML 「기다렸어」
				PRINTFORMW %CALLNAME%의 방 문을 열자 방은 음란한 냄새로 가득 차 있었다
				PRINTFORML 
				PRINTFORMW 「자……」
				PRINTFORML 「%CSTR:일인칭%의 준비는 다 됐어♪」
				PRINTFORMW %CALLNAME%은(는) 다리를 벌리더니 음란한 냄새를 풍기는 음순을 드러냈다
			ENDIF
		ENDIF
	;복종
	ELSEIF TALENT:5
		;ランダム奴隷キャラの場合
		IF RAND:2 && ABL:종족 == 0 && CFLAG:이벤트가입 == 3
			PRINTFORMW 「%CSTR:일인칭%, 지금까지 잘못 생각했어」
			PRINTFORMW 「그런 눅눅한 곳에서 구해준 데다 조교까지 해주고……」
			PRINTFORML 「그러니까 앞으로도 %CSTR:일인칭%을(를) 길들여 줬으면 해」
			PRINTFORMW %CALLNAME%은(는) 그 자리에 엎드려 절을 했다
		ELSE
			PRINTFORML 「%CSTR:이인칭%……」
			PRINTFORMW 불러낸 %CALLNAME%은(는) 어딘가 멍한 눈동자로 연신 가랑이를 비벼대고 있다
			PRINTFORMW 「%CSTR:일인칭%, %CSTR:이인칭%의 조교 없인 살아갈 수 없게 돼서……」
			PRINTFORMW 「여기에 불려온 것만으로도 왠지 몸이 뜨거워져서 두근두근거려」
			PRINTFORMW 「……이런 야한 %CSTR:일인칭%에게 가득 야한 벌을 내려줬으면 해, %CSTR:이인칭%」
		ENDIF
	ENDIF
	CFLAG:201 = 5
	GOTO 表示
ENDIF

;-------------------------------------------------
;簡易助手口上（Y1を助手のキャラ番号に置換、X1をキャラ番号に変更する) CFLAG203
;掛け合いをするキャラを増やす場合は、構文をコピー＆ペーストをして、CFLAGの数を204、205と増やす
;-------------------------------------------------
;助手の有無をチェック（いない場合は二回目以降へ飛ぶ）
IF ASSI < 0 
	CALL EVENTTRAIN_SECOND_PUB303_3
;助手
;ELSEIF NO:ASSI == Y1
	;初めて
;	IF CFLAG:203 == 0
		;陥落済み＋陥落時初口上が発生済み
;		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && CFLAG:201 >= 5
;			WSTR:(K++) = 
		;それ以外
;		ELSE
;			KSTR:(K++) = 
;		ENDIF
;		CFLAG:203 = 1
	;二回目以降
;	ELSEIF CFLAG:203 < 2 || FLAG:7 ==2
		;陥落済み
;		IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
;			WSTR:(K++) = 
		;それ以外
;		ELSE
;			KSTR:(K++) = 
;		ENDIF
;		CFLAG:203 = 2
;	ENDIF
;口上のある助手が居ない場合は、通常の二回目以降の口上へ飛ぶ
ELSE
	CALL EVENTTRAIN_SECOND_PUB303_3
ENDIF


;-------------------------------------------------
;調教開始時（2回目以降、X1をキャラ番号に変更する）
;-------------------------------------------------
$表示
CALL 口上変数表示
@EVENTTRAIN_SECOND_PUB303_3
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
	;奴隷が経験豊富なのに、あなたが童貞の場合
	IF RAND:3 == 0 && EXP:성교경험 == 50 && EXP:PLAYER:삽입경험 == 0
		WSTR:(K++) = 「%CSTR:이인칭%의 조교는 영 꽝이야」
		KSTR:(K++) = 「뭐, 동정이라면 어쩔 수 없지」
