				KSTR:(K++) = 「거긴 여자아이의 소중한 곳이니까 이상한 짓 하면 용서 안 해」
			ELSE
				KSTR:(K++) = 「남한테 만져지는 건 뭔가 느낌이 달라…」
			ENDIF
			CFLAG:442 = 1
		ELSE
			IF 陥落( ) > 0 && (CFLAG:442 < 3 || FLAG:7 == 2)
				;恋慕、親愛
				IF 陥落(TARGET,PLAYER) > 0 && RESULTS == "연모"
					IF RAND:2 == 0
						KSTR:(K++) =  「햐앙! 아앙! 거긴 안 돼!」
						KSTR:(K++) =  「콩알 안 돼애! 새하얗게 되어버려어! 히야아! 아아앙!」
						WSTR:(K++) =   %CALLNAME%은(는) 몸을 부들부들 경련시키며 혀가 꼬인 교성을 계속해서 내지르고 있다
					ELSE
						KSTR:(K++) =  「그런, 애태우다니 너무해애%ハート()%」
					ENDIF
				;淫乱、娼婦	
				ELSEIF 陥落( ) > 0 && RESULTS == "음란"
					IF RAND:2 == 0
						KSTR:(K++) =  「히익! 아햔!! 콩알♪」
						KSTR:(K++) =  「콩알, 너무 기분 좋아아아아%ハート()%」
						KSTR:(K++) =  「햐앙♪ 햐앙♪ 아아앙♪ 아아아아아아%ハート(2)%」
					ELSE
						KSTR:(K++) =  「안 돼, 그런 야한 손가락으로 만져지면, %CSTR:일인칭%%ハート()%」
						KSTR:(K++) =  %CALLNAME%은(는) %CALLNAME:PLAYER%의 팔을 잡더니, 자신이 기분 좋은 곳을 애무할 수 있도록 손의 위치를 조절하고 있다
					ENDIF
				;服従、隷属	
				ELSEIF 陥落(TARGET,PLAYER) > 0 && RESULTS == "복종"
					IF RAND:2 == 0
						KSTR:(K++) =  「히아아아아아! 만져지기만 하는 건 참을 수 없어!」
						KSTR:(K++) =  「%CSTR:이인칭%! 더, 더 문질문질해줘어♪」
					ELSE
						KSTR:(K++) =  「이, 이제 한계야……」
						KSTR:(K++) =  「%CSTR:이인칭%, 클리토리스로 가도 되나요, 되나요?!」
					ENDIF
				ENDIF
				CFLAG:442 = 4
			ENDIF
			;従順Lv3以上
			IF ABL:0 >= 3 && (CFLAG:442 < 2 || FLAG:7 == 2) && !口上有無確認(0)
				KSTR:(K++) = 「아, 안 돼」
				KSTR:(K++) = 「찌, 찌릿찌릿해서 날아가 버려, 날아가 버린다구웃!」
				CFLAG:442 = 3
			ENDIF
			;それ以外
			IF (CFLAG:442 || FLAG:7 == 2) && !口上有無確認(0)
				IF RAND:2 == 0
					KSTR:(K++) =  「더러운 손으로 만지지 말았으면 좋겠어」
					KSTR:(K++) =  「아, 앗, 앗, 하앙!」
					WSTR:(K++) =  말로는 싫어해도 몸은 솔직한 모양이다. 어린아이는 솔직한 게 최고다
				ELSE
					KSTR:(K++) =  「기, 기분 따위 안 좋아……」
					KSTR:(K++) =  %CALLNAME%은(는) 강한 척 말하고 있지만, 때때로 몸을 흠칫 떨고 있다…
				ENDIF
				CFLAG:442 = 2
			ENDIF
		ENDIF

