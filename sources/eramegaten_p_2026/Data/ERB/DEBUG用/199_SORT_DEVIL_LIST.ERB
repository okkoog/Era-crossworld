@DEBUG_DEVIL_PROP_LINE , L_CHARA
#DIM DYNAMIC L_CHARA
PRINTFORM {L_CHARA,4} 
PRINTFORM \@ CSVCSTR(L_CHARA,GETNUM(CSTR,"종족명"),0) != "" ? %CSVCSTR(L_CHARA,GETNUM(CSTR,"종족명"),0),10,LEFT% # %STR:(CSVABL(L_CHARA,GETNUM(ABL,"종족"),0)),10,LEFT%\@　
PRINTFORM %CSVCALLNAME(L_CHARA,0),20,LEFT%　
PRINTFORM \@ CSVTALENT(L_CHARA,GETNUM(TALENT,"비전투원"),0) ? 비전투원 # LV{CSVBASE(L_CHARA,GETNUM(BASE,"LV"),0),6} \@　
PRINTFORM %SUBSTRING(GET_ALI1(CSVABL(L_CHARA,GETNUM(ABL,"속성LD"),0)),0,1)%/%SUBSTRING(GET_ALI2(CSVABL(L_CHARA,GETNUM(ABL,"속성LC"),0)),0,1)%　
PRINTFORM \@ CSVTALENT(L_CHARA,GETNUM(TALENT,"남자"),0) ? ♂ # ♀ \@　
;SIF 
PRINTFORM 戦利品1：%CSVABL(L_CHARA,GETNUM(ABL,"아이템1"),0) ? ITEMNAME:CSVABL(L_CHARA,GETNUM(ABL,"아이템1"),0)# "없음"%　
PRINTFORM 戦利品2：%CSVABL(L_CHARA,GETNUM(ABL,"아이템2"),0) ? ITEMNAME:CSVABL(L_CHARA,GETNUM(ABL,"아이템2"),0)# "없음"%　
PRINTFORM 戦利品3：%CSVABL(L_CHARA,GETNUM(ABL,"아이템3"),0) ? ITEMNAME:CSVABL(L_CHARA,GETNUM(ABL,"아이템3"),0)# "없음"%　
PRINTFORM コーディング：%CSVABL(L_CHARA,GETNUM(ABL,"코딩"),0) ? ITEMNAME:CSVABL(L_CHARA,GETNUM(ABL,"코딩"),0)# "없음"%　
PRINTFORM 受胎アイテム：%CSVABL(L_CHARA,GETNUM(ABL,"수태아이템"),0) ? ITEMNAME:CSVABL(L_CHARA,GETNUM(ABL,"수태아이템"),0)# "없음"%　
PRINTFORM 解説：%CSVCSTR(L_CHARA,GETNUM(CSTR,"해설1"),0) != "" ? "あり" # "없음"%　
VARS 合体
SIF CSVCFLAG(L_CHARA,GETNUM(CFLAG,"특수합체만"),0)
	合体 += "특수합체만　"
SIF CSVCFLAG(L_CHARA,GETNUM(CFLAG,"합체조건있음"),0)
	合体 += "합체조건있음　"
SIF CSVCFLAG(L_CHARA,GETNUM(CFLAG,"전서소환불가"),0)
	合体 += "전서소환불가　"
PRINTFORM 備考：%合体 != "" ? 合体 # "없음"%　