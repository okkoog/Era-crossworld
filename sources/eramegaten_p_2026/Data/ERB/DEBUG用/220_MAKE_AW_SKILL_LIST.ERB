@SHOPCOMABLE_220
IF IS_DEBUG
	RESULTS = 각성스킬관련
	RESULT:1 = 6
	RETURN 1
ENDIF
RETURN -1

@SHOP_COM_220, ARG
#DIM LCOUNT,2
#DIM L_LINE
#DIMS L_EXPLAIN, 10
#DIMS SHOW_LINE
#DIM LINENUM
#DIM L_RESULT
PRINTFORML [0] AW_SKILL_NAME_TABLE出力
PRINTFORML [1] 説明文列挙
PRINTFORML [2] WIKI用一覧出力
PRINTFORML [3] スプレッドシート用一覧出力
CALL INPUTINT, 0, 1, 2, 3
L_RESULT = RESULT
SELECTCASE L_RESULT
	CASE 0
		CLEARLINE LINECOUNT
		PRINTFORML ;-------------------------------
		PRINTFORML ;AW_SKILL_NAME_TABLE.ERBはデバッグコマンド[220]を利用して作成されています
		PRINTFORML ;-------------------------------
		PRINTFORML @GET_AW_SKILL_NAME, ARG
		PRINTFORML #FUNCTIONS
		PRINTFORML SELECTCASE ARG
		FOR LCOUNT, 0, CSVCHARANUM
			TRYCCALLFORM SKILL_NAME_AW_{LCOUNT}
				PRINTFORML %"	"%CASE {LCOUNT}
				PRINTFORML %"		"%RETURNF "%RESULTS%"
			CATCH
			ENDCATCH
		NEXT
		PRINTFORML ENDSELECT
		PRINTL 
		PRINTFORML @GET_AW_SKILL_NUM, ARGS
		PRINTFORML #FUNCTION
		PRINTFORML SELECTCASE ARGS
		FOR LCOUNT, 0, CSVCHARANUM
			TRYCCALLFORM SKILL_NAME_AW_{LCOUNT}
				PRINTFORML %"	"%CASE "%RESULTS%"
				PRINTFORML %"		"%RETURNF {LCOUNT}
			CATCH
			ENDCATCH
		NEXT
		PRINTFORML ENDSELECT
		WAIT
	CASE 1
		L_LINE = LINECOUNT
		DRAWLINE
		FOR LCOUNT, 0, CSVCHARANUM
			TRYCCALLFORM SKILL_NAME_AW_{LCOUNT}, -1
				PRINTFORML [{LCOUNT}] %RESULTS%
				CALLFORM SKILL_EXPLAIN_AW_{LCOUNT}, -1
				PRINTL 
				DRAWLINE
				IF LINECOUNT > L_LINE + 45
					WAIT
					FOR LCOUNT:1, 0, 10
						PRINTL 
					NEXT
					DRAWLINE
					L_LINE = LINECOUNT
				ENDIF
			CATCH
			ENDCATCH
		NEXT
		WAIT
	CASE 2, 3
		CLEARLINE LINECOUNT
		PRINTFORML //このページはゲーム内のデバッグコマンド [220] 覚醒スキル関連から自動出力したものを利用して作成しています。
		PRINTFORML //更新する際はShinEraTenseiをデバッグモードで起動して、上記のコマンドから出力したものを貼り付けてください
		PRINTFORML 悪魔が固有で持つ特別なスキル
		PRINTFORML 所持する悪魔を陥落させるか、仲魔強化で忠誠度5000を消費することで習得させられる。
		PRINTFORML 継承やスキルカード化はできないが、所持する悪魔をイケニエ合体に使うことで任意の悪魔に移植することができる。
		PRINTFORML ただしその場合も同時に持てる覚醒スキルはひとつに限定されており、すでにもっているスキルがある場合、入れ替える必要がある。
		PRINTFORML
		PRINTFORML Ver%TOSTR(GAMEBASE_VERSION / 1000, "000")%.%TOSTR(GAMEBASE_VERSION % 1000, "000")%
		PRINTFORML |No|所持者名|スキル名|해설|
		FOR LCOUNT, 0, CSVCHARANUM
			TRYCCALLFORM SKILL_NAME_AW_{LCOUNT}, -1
				L_LINE = LINECOUNT
				VARSET L_EXPLAIN
				CALLFORM SKILL_EXPLAIN_AW_{LCOUNT}, -1
				LINENUM = LINECOUNT - L_LINE
				IF L_RESULT == 2
					SHOW_LINE = |{LCOUNT,4}|\[\[%CSVCALLNAME(LCOUNT)%\]\]|%RESULTS%|
					FOR LCOUNT:1, 0, LINECOUNT - L_LINE
						SIF LCOUNT:1
							SHOW_LINE += "~~"
						SHOW_LINE += HTML_TOPLAINTEXT(HTML_GETPRINTEDSTR(LINECOUNT - L_LINE - LCOUNT:1 - 1))
					NEXT
				ELSE
					SHOW_LINE = |{LCOUNT,4}|%CSVCALLNAME(LCOUNT)%|%RESULTS%|
					FOR LCOUNT:1, 0, LINECOUNT - L_LINE
						IF LCOUNT:1
							SHOW_LINE += "&CHAR(10)&"
						ELSE
							SHOW_LINE += "="
						ENDIF
						SHOW_LINE += "\"" + HTML_TOPLAINTEXT(HTML_GETPRINTEDSTR(LINECOUNT - L_LINE - LCOUNT:1 - 1)) + "\""
					NEXT
				ENDIF
				SHOW_LINE += "|"
				CLEARLINE LINECOUNT - L_LINE
				HTML_PRINT "<nobr>" + SHOW_LINE + "</nobr>"
			CATCH
			ENDCATCH
		NEXT
		WAIT
ENDSELECT
