

@SHOPCOMABLE_191
[IF_DEBUG]
	RESULTS = 능력시산
	RETURN 1
[ENDIF]
IF FLAG:DEBUG
	RESULTS = 능력시산
	RETURN 1
ENDIF
RETURN -1

@SHOP_COM_191, ARG
#DIM DYNAMIC L_DIFFICULT
#DIM DYNAMIC L_ENEMY_NO
#DIM DYNAMIC L_LV
#DIM DYNAMIC L_ENEMY
#DIM DYNAMIC IS_BOSS
PRINTL 시산할 악마 번호를 입력해 주십시오
PRINTL [0] 돌아간다
INPUT
SIF RESULT == 0
	RETURN 0
IF  EXISTCSV(RESULT, 0)
	L_ENEMY_NO = RESULT
ELSE
	PRINTL 해당 번호의 캐릭터는 존재하지 않습니다
	RESTART
ENDIF
PRINTL 시산할 난이도를 선택해 주십시오
PRINTL [1]EASY [2]NORMAL [3]H
PRINTL [4]M    [5]L      [6]悪
CALL INPUTINT,1,2,3,4,5,6
L_DIFFICULT = RESULT
PRINTL レベルを入力してください
PRINTL 0の場合はCSVで定義されたレベルになります
CALL INPUT_MANY,  0, 999
L_LV = RESULT == 0 ? CSVBASE(L_ENEMY_NO, GETNUM(BASE, "LV")) # RESULT
PRINTL ボスにしますか？
CALL INPUT_YN
IS_BOSS = !RESULT
CALL SET_ENEMY,9,L_ENEMY_NO,L_LV,0,IS_BOSS
L_ENEMY = CHARANUM - 1
CALL SET_ENEMY_BASE_STAT, L_ENEMY, L_LV, , , , , , , L_DIFFICULT
CALL SHOP_COM_301, , L_ENEMY
CALL キャラ削除, L_ENEMY
RESTART