

@SHOPCOMABLE_192
[IF_DEBUG]
	RESULTS = 노예추가
	RETURN 1
[ENDIF]
IF FLAG:DEBUG
	RESULTS = 노예추가
	RETURN 1
ENDIF
RETURN -1

@SHOP_COM_192, ARG
#DIM DYNAMIC LCOUNT, 3
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_SKILL
PRINTL 노예로 삼을 캐릭터 번호나 식별명을 입력해 주십시오

INPUTS

IF ISNUMERIC(RESULTS) && EXISTCSV(TOINT(RESULTS), 0)
	CALL ADD_NEW_COMPANION,TOINT(RESULTS),0,0
	;デバッグ用に戦闘参加出来るように変更
	CALL SET_TALENT_PARTY_JOINABLE, (RESULT:1), "参加可能"
ELSEIF GET_識別番号(RESULTS) >= 0
	CALL ADD_NEW_COMPANION,GET_識別番号(RESULTS),0,0
	;デバッグ用に戦闘参加出来るように変更
	CALL SET_TALENT_PARTY_JOINABLE, (RESULT:1), "参加可能"
ELSE
	VARI L_LIST_ABLE, 100000
	FOR LCOUNT, 0, CSVCHARANUM
		SIF !EXISTCSV(LCOUNT)
			CONTINUE
		SIF !STRCOUNT(GET_識別名(LCOUNT), RESULTS)
			CONTINUE
		L_LIST_ABLE:LCOUNT = 1
		PRINTFORML [{LCOUNT, 4}] %GET_識別名(LCOUNT)%
	NEXT
	;キャラ登録なし
	IF MAXARRAY(L_LIST_ABLE) == 0
		PRINTW 해당 캐릭터는 존재하지 않습니다
		RETURN 0
	ELSE
		CALL INPUT_ARRAY, L_LIST_ABLE
		CALL ADD_NEW_COMPANION,RESULT,0,0
		;デバッグ用に戦闘参加出来るように変更
		CALL SET_TALENT_PARTY_JOINABLE, (RESULT:1), "参加可能"
	ENDIF
ENDIF
L_CHARA = RESULT:1
DRAWLINE
PRINTFORML 名前:%CALLNAME:L_CHARA%
PRINTFORML LV  :{BASE:L_CHARA:LV,2}
PRINTFORML 종족:%GET_RACE(ABL:L_CHARA:종족)%
FOR LCOUNT:2, 0, 2
	SIF LCOUNT:2 && ABL:L_CHARA:초기변신악마스킬1 == 0
		BREAK
	FOR LCOUNT:1, 0, 2
		DRAWLINE
		IF LCOUNT:1 == 0
			IF LCOUNT:2
				PRINTL 변신 악마 스킬
			ELSE
				PRINTL 初期スキル
			ENDIF
		ELSE
			SIF LCOUNT:2
				PRINT 変身悪魔
			PRINTL 습득스킬
		ENDIF
		FOR LCOUNT, 1, 21
			IF LCOUNT:1 == 0
				IF LCOUNT:2 == 0
					L_SKILL = ABL:L_CHARA:@"스킬{LCOUNT}"
				ELSE
					L_SKILL = ABL:L_CHARA:@"초기변신악마스킬{LCOUNT}"
				ENDIF
			ELSE
				IF LCOUNT:2 == 0
					L_SKILL = ABL:L_CHARA:@"습득스킬{LCOUNT}"
				ELSE
					L_SKILL = ABL:L_CHARA:@"초기변신악마습득스킬{LCOUNT}"
				ENDIF
			ENDIF
			SIF !L_SKILL
				CONTINUE
			CALL GET_SKILL_PROP("SKILL_NAME", L_SKILL, L_CHARA)
			PRINTFORM %RESULTS, 32, LEFT%
			CALL GET_SKILL_PROP("SKILL_RANK", L_SKILL, L_CHARA)
			PRINTFORM Rank:{RESULT,2}　　　
			IF LCOUNT:1
				IF LCOUNT:2 == 0
					PRINTFORM 습득LV:{ABL:L_CHARA:@"습득LV{LCOUNT}", 2}
				ELSE
					PRINTFORM 습득LV:{ABL:L_CHARA:@"초기변신악마습득LV{LCOUNT}", 2}
				ENDIF
			ENDIF
			PRINTL 
		NEXT
	NEXT
NEXT
WAIT