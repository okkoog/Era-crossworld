@SHOPCOMABLE_223
IF IS_DEBUG
	RESULTS = 캐릭터아이콘출력
	RESULT:1 = 6
	RETURN 1
ENDIF
RETURN -1

@SHOP_COM_223, ARG
#DIM LCOUNT
#DIM COUNT_SHOW
RESULT = 0
WHILE RESULT != 999
	CLEARLINE LINECOUNT
	FOR LCOUNT, 0, RACENUM
		SIF GET_RACE(LCOUNT) == ""
			CONTINUE
		PRINTFORM [{LCOUNT,3}] %GET_RACE(LCOUNT), 32, LEFT%
		SIF COUNT_SHOW % 3 == 2
			PRINTL 
		COUNT_SHOW++
	NEXT
	SIF !LINEISEMPTY()
		PRINTL 
	FOR LCOUNT, 0, EXTRA_TITLENUM
		SIF EXTRA_TITLE:LCOUNT == ""
			CONTINUE
		PRINTFORM [{LCOUNT + RACENUM, 3}] %EXTRA_TITLE:LCOUNT, 32, LEFT%
		SIF COUNT_SHOW % 3 == 2
			PRINTL 
		COUNT_SHOW++
	NEXT
	SIF !LINEISEMPTY()
		PRINTL 
	PRINTL [999] 돌아간다
	INPUT
	SELECTCASE RESULT
		CASE 0 TO RACENUM - 1
			CALL PRINT_FACE_TEST, RESULT
		CASE RACENUM TO RACENUM + EXTRA_TITLENUM - 1
			CALL PRINT_FACE_TEST, , RESULT - RACENUM
		CASE 999
			RETURN 0
	ENDSELECT
WEND

@PRINT_FACE_TEST, L_RACE = -1, L_EXTRA = -1
#DIM DYNAMIC LCOUNT, 3
#DIM DYNAMIC L_RACE
#DIM DYNAMIC L_EXTRA
#DIM DYNAMIC L_SKILL
#DIM DYNAMIC L_SUCCESSION
#DIMS DYNAMIC L_SHOWLINE, 4
#DIM DYNAMIC IMG_NO
SETCOLOR　0x000000
;黒背景かどうかをみるのが多いんだから白背景が正解…なはず？
SETBGCOLOR 0xFFFFFFF
;SETBGCOLOR 0x00FF00
FOR LCOUNT, 0, CSVCHARANUM
	SIF !EXISTCSV(LCOUNT)
		CONTINUE
	IF L_RACE >= 0
		SIF CSVCFLAG(LCOUNT, GETNUM(CFLAG, "EXTRA출전")) > 0
			CONTINUE
		SIF CSVABL(LCOUNT, GETNUM(ABL, "종족")) != L_RACE
			CONTINUE
	ELSE
		SIF CSVCFLAG(LCOUNT, GETNUM(CFLAG, "EXTRA출전")) != L_EXTRA
			CONTINUE
	ENDIF
	SIF !IS_TRYMAKE_FACE:LCOUNT
		CALL 顔グラ追加, LCOUNT
	VARS ICON_TABLE, 4
	ICON_TABLE '= "FACE", "FACE_TS", "FACE_EX", "FACE_UNIQUE"
	VARI COUNT_SHOW
	VARS L_SPLITE_NAME
	DRAWLINE
	PRINTFORML [{LCOUNT}] %CSVNICKNAME(LCOUNT)%
	FOR LCOUNT:1, 0, VARSIZE("ICON_TABLE")
		FOR LCOUNT:2, 0, ICONNUM
			L_SPLITE_NAME '= GET_識別名(LCOUNT) + "_" + ICON_TABLE:(LCOUNT:1) + "_" + TOSTR(LCOUNT:2)
			SIF !SPRITECREATED(L_SPLITE_NAME)
				CONTINUE
			L_SHOWLINE += @"<div xpos = '{COUNT_SHOW * 300}'>" + @"<img src = '%L_SPLITE_NAME%' height = '300'>" + "</div>"
			COUNT_SHOW += 1
		NEXT
	NEXT
	IF COUNT_SHOW
		HTML_PRINT L_SHOWLINE
		PRINTL 
		PRINTL 
		COUNT_SHOW = 0
		VARSET L_SHOWLINE
	ENDIF
NEXT
WAIT
RESETCOLOR
RESETBGCOLOR