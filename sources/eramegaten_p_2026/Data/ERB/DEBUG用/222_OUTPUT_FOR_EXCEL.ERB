@SHOPCOMABLE_222
IF IS_DEBUG
	RESULTS = 엑셀용데이터출력
	RESULT:1 = 6
	RETURN 1
ENDIF
RETURN -1

@SHOP_COM_222, ARG
#DIM LCOUNT, 4
RESULT = 0
WHILE RESULT != 99
	CLEARLINE LINECOUNT
	PRINTL [0 ] 스킬
	PRINTL [99] 돌아간다
	INPUT
	SELECTCASE RESULT
		CASE 0
			CALL OUTPUT_SKILL_FOR_EXCEL
		CASE 99
			RETURN 0
	ENDSELECT
WEND
@OUTPUT_SKILL_FOR_EXCEL
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_TYPE
#DIM DYNAMIC L_SKILL
#DIM DYNAMIC L_SUCCESSION
#DIMS DYNAMIC SHOWLINE
WHILE RESULT != 99
	CLEARLINE LINECOUNT
	FOR LCOUNT, 0, SUCCESSIONNUM + 2
		IF LCOUNT == 22
			PRINTFORM [{LCOUNT, 2}] 自動　　
		ELSEIF LCOUNT == SUCCESSIONNUM
			PRINTFORM [{LCOUNT, 2}] 系統外　
		ELSE
			PRINTFORM [{LCOUNT, 2}] %GET_SUCCESSION(LCOUNT)%　　
		ENDIF
		SIF LCOUNT % 4 == 3
			PRINTL 
	NEXT
	SIF !LINEISEMPTY()
		PRINTL 
	INPUT
	CLEARLINE LINECOUNT
	SELECTCASE RESULT
		CASE IS < SUCCESSIONNUM + 2
			L_SUCCESSION = RESULT
			VARI TEMP_GAMEBASE_VERSION = GAMEBASE_VERSION / 1000000
			PRINTFORM %TOSTR(TEMP_GAMEBASE_VERSION / 100 / 100, "0")%.%TOSTR(TEMP_GAMEBASE_VERSION / 100 % 100, "0")%.%TOSTR(TEMP_GAMEBASE_VERSION % 100 % 100, "0")%
			GETTIME
			PRINTFORML |%SUBSTRING(RESULTS, 0, 10)%
			U = -1
			PRINTFORML NO|명칭|相性|ランク|継承|継承制限|コスト|威力|ヒット数|期待値|HIT|CRT|対象|バステ付着|해설
			VARI L_SELECT_TYPE = RESULT
			FOR L_SKILL, 1, SKILLNUM
				SHOWLINE '= ""
				RESULT = 0
				SIF INRANGE(L_SKILL, 2100, 2199)
					CONTINUE
				SIF INRANGE(L_SKILL, 2301, 2399)
					CONTINUE
				SIF INRANGE(L_SKILL, 3900, 3920)
					CONTINUE
				SIF INRANGE(L_SKILL, MIN_ITEMSKILLNUM, MAX_ITEMSKILLNUM)
					CONTINUE
				SIF INRANGE(L_SKILL, MIN_LINKAGENUM, MAX_LINKAGENUM)
					CONTINUE
				CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILL, -1
				IF L_SUCCESSION == SUCCESSIONNUM
					SIF INRANGE(RESULT, 0, SUCCESSIONNUM - 1) || RESULT == 22
						CONTINUE
				ELSE
					SIF L_SUCCESSION != RESULT
						CONTINUE
				ENDIF
				RESULT = -1
				CALL GET_SKILL_PROP, "SKILL_TYPE", L_SKILL, -1
				L_TYPE = RESULT
				CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, -1
				SIF RESULTS == ""
					CONTINUE
				SHOWLINE += @"{L_SKILL}" + "|"
				SHOWLINE += "=" + "CHAR(10)&" + "\"" + RESULTS + "\"" + "&CHAR(10)"
				SHOWLINE += @"|%GET_TYPE(L_TYPE)%"

				CALL GET_SKILL_PROP, "SKILL_RANK", L_SKILL
				VARI L_RANK = RESULT
				IF RESULT == -1
					SHOWLINE += @"|-"
				ELSE
					SHOWLINE += @"|{RESULT}"
				ENDIF
				IF L_SUCCESSION == 22
					SHOWLINE += @"|自動"
				ELSEIF L_SUCCESSION == 21
					SHOWLINE += @"|系統外"
				ELSEIF INRANGE(L_SUCCESSION, 0, SUCCESSIONNUM)
					SHOWLINE += @"|%GET_SUCCESSION(L_SUCCESSION)%"
				ELSE
					SHOWLINE += @"|系統外"
				ENDIF
				RESULT = 0
				CALL GET_SKILL_PROP, "味方専用", L_SKILL, -1
				IF RESULT
					SHOWLINE += @"|味方専用"
				ELSE
					CALL GET_SKILL_PROP, "敵専用", L_SKILL, -1
					IF RESULT
						SHOWLINE += @"|敵専用"
					ELSE
						CALL GET_SKILL_PROP, "ロール専用", L_SKILL, -1
						IF RESULT
							SHOWLINE += @"|%RESULTS%"
						ELSE
							CALL GET_SKILL_PROP, "継承不能", L_SKILL, -1
							IF RESULT == 2
								SHOWLINE += @"|継承不能+"
							ELSEIF RESULT == 1
								SHOWLINE += @"|継承不能"
							ELSE
								IF !INRANGE(L_RANK, 1, 15)
									SHOWLINE += @"|継承不能"
								ELSE
									IF L_SUCCESSION == 22 || INRANGE(L_SUCCESSION, 0, SUCCESSIONNUM)
										SHOWLINE += @"|一般"
									ELSE
										SHOWLINE += @"|継承不能"
									ENDIF
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				RESULT = 0
				CALL GET_SKILL_PROP, "SKILL_COST", L_SKILL, -1
				SHOWLINE += @"|{RESULT}"
				RESULT = 0
				CALL GET_SKILL_PROP, "SKILL_POWER", L_SKILL,-1
				VARI L_POWER = RESULT
				SHOWLINE += @"|{RESULT}　"
				VARI POWER_MULTI = 0
				IF GROUPMATCH(L_SKILL, [[스킬:백열찌르기]], [[스킬:천열찌르기]])
					SHOWLINE += @"|2~7"
					POWER_MULTI = 450
				ELSE
					RESULT = 1
					CALL GET_SKILL_PROP, "SKILL_MAXATTACKNUMBER", L_SKILL, -1
					VARI L_MAXHITNUM = RESULT
					RESULT = 1
					CALL GET_SKILL_PROP, "SKILL_MINATTACKNUMBER", L_SKILL, -1
					VARI L_MINHITNUM = RESULT
					RESULT = 0
					CALL GET_SKILL_PROP, "SKILL_MAXATK_PER", L_SKILL, -1
					VARI MAXATK_PER = RESULT
					SHOWLINE += "|"
					IF L_MAXHITNUM == L_MINHITNUM
						SHOWLINE += @"{L_MAXHITNUM}"
					ELSE
						SHOWLINE += @"{L_MINHITNUM} ~ {L_MAXHITNUM}"
					ENDIF
					POWER_MULTI = L_MINHITNUM
					IF MAXATK_PER
						SHOWLINE += @"({MAXATK_PER})"
						POWER_MULTI += MAXATK_PER
					ELSE
						POWER_MULTI += L_MAXHITNUM
					ENDIF
					POWER_MULTI = POWER_MULTI * 100 / 2
				ENDIF
				SHOWLINE += @"|{POWER_MULTI * L_POWER / 100}"
				RESULT = 0
				TRYCALL GET_SKILL_PROP, "SKILL_HITRATE", L_SKILL, -1
				SHOWLINE += @"|{RESULT}　"
				RESULT = 0
				CALL GET_SKILL_PROP, "SKILL_CRITICAL_RATE", L_SKILL,-1
				IF RESULT == 0
					SHOWLINE += @"|{RESULT}"
				ELSE
					SHOWLINE += @"|5"
				ENDIF
				
				RESULT = 0
				CALL GET_SKILL_PROP, "SKILL_SPREAD", L_SKILL,-1
				IF RESULT
					SHOWLINE += @"|拡散{RESULT}"
				ELSE
					CALL GET_SKILL_PROP, "SKILL_SPHERE", L_SKILL,-1
					VARI L_SPHERE = RESULT
					CALL GET_SKILL_PROP, "SKILL_TARGET", L_SKILL, -1
					SELECTCASE RESULT
						CASE 1
							SHOWLINE += "|=" + "\"" + @"적"
							SHOWLINE += GET_SPHERE(RESULT, 1)
							SHOWLINE += "\""
							CALL GET_SKILL_PROP, "SKILL_RAND_TARGET", L_SKILL, -1
							SIF RESULT
								SHOWLINE += "&CHAR(10)&" + "\"" + "ランダム" + "\""
							CALL GET_SKILL_PROP, "SKILL_SPREAD", L_SKILL, -1
							SIF RESULT
								SHOWLINE +="&CHAR(10)&" + "\"" + @"拡散[{RESULT}]" + "\""
						CASE 2
							SHOWLINE += @"|味方"
							SHOWLINE += GET_SPHERE(RESULT, 1)
						CASE 3
							SHOWLINE += @"|敵味方"
						CASE 4
							SHOWLINE += @"|特殊"
						CASE 5
							SHOWLINE += @"|自身"
						CASEELSE
							SHOWLINE += "|"
					ENDSELECT
					RESULT = 0
					CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_STATE", L_SKILL, -1
					VARI L_ADD_STATE = RESULT
					RESULT = 0
					CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_BASE_RATE", L_SKILL, -1
					VARI L_ADD_STATE_RATE = RESULT
					RESULT = 0
					CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_TYPE", L_SKILL, -1
					VARI L_ADD_TYPE = RESULT
					RESULT = 0
					CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_MAX_RATE", L_SKILL, -1
					VARI L_ADD_MAX_RATE = RESULT
					IF L_ADD_STATE_RATE
						SHOWLINE += "|="
						SHOWLINE += "\"" + GET_STATE(L_ADD_STATE) + "\"" + "&CHAR(10)&" 
						SHOWLINE += "\"" + GET_TYPE(L_ADD_TYPE) + "\"" + "&CHAR(10)&" 
						SHOWLINE += "\"" + @"{L_ADD_STATE_RATE} ~ {L_ADD_MAX_RATE}" + "%"+ "\"" 
					ELSE
						SHOWLINE += @"|"
					ENDIF
					CALL GET_SKILL_EXPLAIN_TOOLTIP, L_SKILL, , , "表計算出力"
					SHOWLINE += @"|= %RESULTS%"
				ENDIF
				HTML_PRINT "<nobr>" + SHOWLINE + "</nobr>"
			NEXT
			WAIT
		CASE 99
			RETURN 0
	ENDSELECT
WEND