


@SHOPCOMABLE_188
[IF_DEBUG]
	RESULTS = 던전용ERH작성
	RETURN 1
[ENDIF]
IF FLAG:DEBUG
	RESULTS = 던전용ERH작성
	RETURN 1
ENDIF
RETURN -1

@SHOP_COM_188, ARG
#LOCALSIZE 5
CLEARLINE LINECOUNT
FOR LOCAL , 0 , DUNGEONNUM
	SELECTCASE GET_DUNGEON_NAME(LOCAL, 1)
		CASE "타르타로스"
			PRINTFORML #DIM SAVEDATA ダンジョン%TOSTR(LOCAL , "00")% , 22 , 30 , 30
		CASE "名称未定義"
			PRINTFORML #DIM SAVEDATA ダンジョン%TOSTR(LOCAL , "00")% , 1 , 1 , 1
		CASEELSE
			LOCAL:2 = 0 , 0 , 0
			FOR FLAG:현M , 0 , 100
				FLAG:최대X = 0
				FLAG:최대Y = 0
				CALLFORM MAKE_FLOOR_{LOCAL}
				LOCAL:2 = MAX(FLAG:최대X , LOCAL:2)
				LOCAL:3 = MAX(FLAG:최대Y , LOCAL:3)
				SIF (FLAG:최대X + FLAG:최대Y) > 2
					LOCAL:4 = FLAG:현M
			NEXT
			PRINTFORML #DIM SAVEDATA ダンジョン%TOSTR(LOCAL , "00")% , {LOCAL:4+1} , {LOCAL:2} , {LOCAL:3}
	ENDSELECT
NEXT
WAIT

