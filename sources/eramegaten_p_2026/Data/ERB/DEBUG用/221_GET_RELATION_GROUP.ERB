@SHOPCOMABLE_221
IF IS_DEBUG
	RESULTS = 상성그룹관련
	RESULT:1 = 6
	RETURN 1
ENDIF
RETURN -1

@SHOP_COM_221, ARG
#DIM LCOUNT, 4
#DIM L_CNT
#DIMS TEMPS, 3
#DIMS NAME_LIST, 200
#DIMS L_NAME, CSVCHARANUM
#DIM CNT_GROUP
#DIMS RELATION_GROUP, 5
#DIM TEMP_NO
$START
CNT_GROUP = 0
VARSET NAME_LIST
FOR LCOUNT, 0, CSVCHARANUM
	SIF !EXISTCSV(LCOUNT)
		CONTINUE
	L_NAME:LCOUNT = %CSVCALLNAME(LCOUNT)%
	TEMPS = %CSVCSTR(LCOUNT, GETNUM(CSTR, "상성그룹"))%
	IF TEMPS != ""
		FOR LCOUNT:1, 0, STRCOUNT(TEMPS, "_") + 1
			TEMPS:1 = %AUTO_SPLIT(TEMPS, "_", LCOUNT:1)%
			SIF FINDELEMENT(NAME_LIST, ESCAPE(TEMPS:1), , , 1) >= 0
				CONTINUE
			NAME_LIST:CNT_GROUP = %TEMPS:1%
			PRINTFORM [{CNT_GROUP, 2}] %TEMPS:1, 18, LEFT%
			SIF CNT_GROUP % 5 == 4
				PRINTL 
			CNT_GROUP++
		NEXT
	ENDIF
NEXT
PRINTL [999] 돌아간다
INPUT
IF INRANGE(RESULT, 0, FINDELEMENT(NAME_LIST, "", , , 1) - 1)
	L_CNT = 0
	TEMPS = %NAME_LIST:RESULT%
	PRINTFORML [0] 所属確認　[1] 個別設定の確認 [999] 돌아간다
	INPUT
	DRAWLINE
	PRINTFORML %TEMPS%
	DRAWLINE
	SELECTCASE RESULT
		CASE 0
			FOR LCOUNT, 0, CSVCHARANUM
				SIF !EXISTCSV(LCOUNT)
					CONTINUE
				SIF !COUNT_SPLIT(CSVCSTR(LCOUNT, GETNUM(CSTR, "상성그룹")), "_", ESCAPE(TEMPS))
					CONTINUE
				PRINTFORM [{LCOUNT, 4}] %CSVCALLNAME(LCOUNT), 24, LEFT%
				SIF L_CNT % 3 == 2
					PRINTL 
				L_CNT++
			NEXT
			WAIT
		CASE 1
			FOR LCOUNT, 0, CSVCHARANUM
				SIF !EXISTCSV(LCOUNT)
					CONTINUE
				SIF !COUNT_SPLIT(CSVCSTR(LCOUNT, GETNUM(CSTR, "상성그룹")), "_", ESCAPE(TEMPS))
					CONTINUE
				PRINTFORML [{LCOUNT, 4}] %CSVCALLNAME(LCOUNT), 24, LEFT%
				FOR LCOUNT:1, 0, 5
					TEMPS:1 = %CSVCSTR(LCOUNT, GETNUM(CSTR, "相性_" + AUTO_SPLIT("最高/抜群/良好/不良/最悪", "/", LCOUNT:1)))%
					VARSET RELATION_GROUP
					FOR LCOUNT:2, 0, STRCOUNT(CSVCSTR(LCOUNT, GETNUM(CSTR, "상성그룹")), "_") + 1
						CALLFORMF GET_RELATION_GROUP, -1, -1, AUTO_SPLIT(CSVCSTR(LCOUNT, GETNUM(CSTR, "상성그룹")), "_", LCOUNT:2), 1
						FOR LCOUNT:3, 0, 5
							RELATION_GROUP:(LCOUNT:3) = %ADD_SPLIT(RELATION_GROUP:(LCOUNT:3), "_", RESULTS_F:(LCOUNT:3))%
						NEXT
					NEXT
					SIF TEMPS:1 == ""
						CONTINUE
					FOR LCOUNT:2, 0, STRCOUNT(TEMPS:1, "_") + 1
						IF LCOUNT:2
							PRINT _
						ELSE
							PRINTFORM %"相性_" + AUTO_SPLIT("最高/抜群/良好/不良/最悪", "/", LCOUNT:1)%:
						ENDIF
						TEMPS:2 = %AUTO_SPLIT(TEMPS:1, "_", LCOUNT:2)%
						IF !COUNT_SPLIT(RESULTS_F:(LCOUNT:1), "_", TEMPS:2)
							TEMP_NO = FINDELEMENT(L_NAME, TEMPS:2, , , 1)
							IF TEMP_NO >= 0
								SIF !COUNT_SPLIT(RESULTS_F:(LCOUNT:1), "_", "【" + CSVCSTR(TEMP_NO, GETNUM(CSTR, "상성그룹")) + "】")
									SETCOLOR COLOR("red")
							ELSE
								SETCOLOR COLOR("red")
							ENDIF
						ENDIF
						PRINTFORM %TEMPS:2%
						RESETCOLOR
					NEXT
					PRINTL 
				NEXT
				PRINTL 
			NEXT
			WAIT
	ENDSELECT
ELSEIF RESULT == 999
	RETURN 0
ENDIF
GOTO START