

@SHOPCOMABLE_698
RESULT:1 = 6
IF IS_DEBUG
	RESULTS = 딸캐릭터작성테스트
	RETURN 1
ENDIF
RETURN -1

@SHOP_COM_698, ARG
#DIM L_MOTHER
#DIM L_FATHER
#DIM L_FATHER_NO
CUSTOMDRAWLINE =
FLAG:출산기능ONOFF = 1
TALENT:0:금단의지식 = 1
FLAG:임신기능 = 1
;キャラリストを表示
;CALL INPUT_CHARA_LIST("母親を選んでください", "CASTING_SHOPCOM_202")
{
CALL INPUT_CHARA_LIST
	, "FUNC_PROPSET_LIST"
	, "母親を選んでください"
	, "CASTING_SHOPCOM_698" 
	, "SHOW_ADD_UP_FUNCTION"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
SIF RESULT == 1000
	RETURN 0
L_MOTHER = RESULT
L_FATHER = -1
L_FATHER_NO = -1
PRINTL [0] 생성 완료된 캐릭터에서 부친을 지정
PRINTL [1] 노역 고객을 부친으로 한다
PRINTL [2] 촉수를 부친으로 한다
PRINTL [3] 信者を父親にする
PRINTL [4] CSV指定
CALL INPUTINT, 0, 1, 2, 4
SELECTCASE RESULT
	CASE 0
		;キャラリストを表示
		;CALL INPUT_CHARA_LIST("父親を選んでください", "CASTING_SHOPCOM_202")
		{
		CALL INPUT_CHARA_LIST
			, "FUNC_PROPSET_LIST_BATTLE"
			, "父親を選んでください"
			, "CASTING_SHOPCOM_698" 
			, "SHOW_ADD_UP_FUNCTION"
			, "SHOW_ADD_DOWN_FUNCTION"
			, "ADD_SELECT_FUNCTION"
			, "L_CANCELS"
			, "FUNC_CUSTOM_TITLE"
			, "FUNC_CUSTOM_COLOR"
			, -1
		}
		SIF RESULT == 1000
			RETURN 0
		L_FATHER = RESULT
		CFLAG:L_MOTHER:부친의고유번호부모 = CFLAG:L_FATHER:캐릭터고유번호
	CASE 1
		CFLAG:L_MOTHER:임신시부친판정 = 4
	CASE 2
		CFLAG:L_MOTHER:임신시부친판정 = 5
	CASE 3
		CFLAG:L_MOTHER:노역플래그 = 10
		CFLAG:L_MOTHER:임신시부친판정 = 6
	CASE 4
		$LOOP
		INPUT		
		IF  EXISTCSV(RESULT, 0)
			L_FATHER_NO = RESULT
		ELSE
			PRINTL その番号のキャラは存在しません
			GOTO LOOP
		ENDIF
ENDSELECT
IF L_FATHER_NO >= 0
	CALL SET_FETUS_STATUS, L_MOTHER, -1, L_FATHER_NO
ELSE
	CALL SET_FETUS_STATUS, L_MOTHER, L_FATHER
ENDIF
TALENT:L_MOTHER:임신 = 1

PRINTL このままキャラクター生成をしますか？
CALL INPUT_YN
SIF RESULT
	RETURN 1
CALL MAKE_DAUGHTER, L_MOTHER
RESTART
@CASTING_SHOPCOM_698(ARG)
RETURN 1
