@SHOPCOMABLE_193
[IF_DEBUG]
	RESULTS = 스킬분포작성
	RETURN 1
[ENDIF]
IF FLAG:DEBUG
	RESULTS = 스킬분포작성
	RETURN 1
ENDIF
RETURN -1

@SHOP_COM_193, ARG
#DIM IS_CHARA_CHECK
#DIM CSV_NO
#DIM L_SKILL
#DIM IS_SHOW_LIST_MODE
#DIM SHOW_LIST, 100
;LOCAL スキル番号回し
;LOCAL:1 キャラクタ番号回し
;LOCAL:2 スキル検索用
IS_CHARA_CHECK = 0
PRINT [0]남자 [1]女　[2]両方　[3]キャラを表示しない [4] 指定リスト
CALL INPUTINT,0,1,2,3,4
LOCAL:4 = RESULT
IF LOCAL:4 != 4
	PRINTL [0]スキルをすべて表示 [1]表示するスキル番号を決める [2] キャラNOからチェック
	CALL INPUTINT,0,1,2
ENDIF
IF RESULT == 0
	LOCAL:6 = 1
	LOCAL:7 = 3000
ELSEIF RESULT == 2
	IS_CHARA_CHECK = 1
	INPUT
	CSV_NO = RESULT
	LOCAL:6 = 0
	LOCAL:7 = 40
	GOTO START
ELSE
	IF RESULT != 4
		PRINTL 開始するスキル番号入力
		INPUT
		IF RESULT < 1
			PRINTL 番号入力が少ないので最初からにします
			LOCAL:6 = 1
		ELSEIF RESULT > 2999
			PRINTL 番号入力が多いので終わりの直前からにします
			LOCAL:6 = 2999
		ELSEIF RESULT > 1 && RESULT < 3000
			LOCAL:6 = RESULT
		ELSE
			PRINTL 番号入力が不正なので最初からにします
			LOCAL:6 = 1
		ENDIF
		PRINTL 終了するスキル番号入力
		INPUT
		IF RESULT <= LOCAL:6
			PRINTL 番号入力が少ないので初めの直後に変えます
			LOCAL:7 = LOCAL:6 + 1
		ELSEIF RESULT > 3000
			PRINTL 番号入力が多いので最後までにします
			LOCAL:7 = 3000
		ELSEIF RESULT > 1 && RESULT < 3000
			LOCAL:7 = RESULT
		ELSE
			PRINTL 番号入力が不正なので最後までにします
			LOCAL:7 = 3000
		ENDIF
		IS_SHOW_LIST_MODE = 0
		PRINTL [0]一気に表示する [1]4相性ごとに止まる
		CALL INPUTINT,0,1
		LOCAL:5 = RESULT
	ELSE
		LOCAL:6 = 0
		LOCAL:7 = 100
		IS_SHOW_LIST_MODE = 1
		LOCAL = 0
		;SHOW_LIST:(LOCAL++) = [[스킬:]]
		;SHOW_LIST:(LOCAL++) = [[스킬:]]
		;SHOW_LIST:(LOCAL++) = [[스킬:]]
		;SHOW_LIST:(LOCAL++) = [[스킬:]]
		;SHOW_LIST:(LOCAL++) = [[스킬:]]
		;SHOW_LIST:(LOCAL++) = [[스킬:]]
		;SHOW_LIST:(LOCAL++) = [[스킬:]]
		;SHOW_LIST:(LOCAL++) = [[스킬:]]
		;SHOW_LIST:(LOCAL++) = [[스킬:]]
		;SHOW_LIST:(LOCAL++) = [[스킬:]]
		;SHOW_LIST:(LOCAL++) = [[스킬:]]
		;SHOW_LIST:(LOCAL++) = [[스킬:]]
		;SHOW_LIST:(LOCAL++) = [[스킬:]]
	ENDIF
ENDIF

$START
CLEARLINE 5000
PRINTFORML ;-------------------------------
VARI TEMP_GAMEBASE_VERSION = GAMEBASE_VERSION
TEMP_GAMEBASE_VERSION = TEMP_GAMEBASE_VERSION  / 1000 / 1000
PRINTFORML ;%GAMEBASE_TITLE% %TOSTR(TEMP_GAMEBASE_VERSION / 100 / 100, "0")%.%TOSTR(TEMP_GAMEBASE_VERSION / 100 % 100, "0")%.%TOSTR(TEMP_GAMEBASE_VERSION % 100 % 100, "0")%
GETTIME
PRINTFORML ;%RESULTS%
PRINTFORML ;-------------------------------
PRINTFORML ;-------------------------------
PRINTFORML ;この資料は資料フォルダ内にある
PRINTFORML ;SORT_DISTRIBUTION.ERBを利用して作成されています
PRINTFORML ;何か追加する際はコピペするのではなく、
PRINTFORML ;SORT_DISTRIBUTION.ERBを利用して出力してください
PRINTFORML ;-------------------------------

FOR LOCAL,LOCAL:6,LOCAL:7
	IF IS_CHARA_CHECK
		IF LOCAL < 20
			L_SKILL = CSVABL(CSV_NO, GETNUM(ABL, @"스킬{LOCAL + 1}"))
		ELSE
			L_SKILL = CSVABL(CSV_NO, GETNUM(ABL, @"습득스킬{LOCAL - 20 + 1}"))
		ENDIF
	ELSE
		IF IS_SHOW_LIST_MODE
			L_SKILL = SHOW_LIST:LOCAL
			SIF L_SKILL == 0
				BREAK
		ELSE
			L_SKILL = LOCAL
		ENDIF
	ENDIF
	SIF LOCAL == 2101
		LOCAL = 2400
	CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, -1
	SIF RESULTS == ""
		CONTINUE
	VARS L_SKILLNAME
	L_SKILLNAME '= RESULTS
	;ランク0か、継承タイプ23のスキルは無視
	CALL GET_SKILL_PROP, "SKILL_RANK", L_SKILL, -1
	SIF RESULT == 0
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILL, -1
	SIF RESULT == 23
		CONTINUE
	IF IS_CHARA_CHECK
		SIF LOCAL >= 20
			PRINTFORML %CSVCALLNAME(CSV_NO)%　습득:{CSVABL(CSV_NO, GETNUM(ABL, @"습득LV{LOCAL - 20 + 1}"))}
	ENDIF
	PRINTFORML [{L_SKILL}] %L_SKILLNAME%
	;========================================================================
	;性能を記述
	;========================================================================
	CALL GET_SKILL_PROP, "SKILL_RANK", L_SKILL, -1		
	PRINTFORM ランク:{RESULT,2}　
	RESULT = 0
	TRYCALL GET_SKILL_PROP, "SKILL_HITRATE", L_SKILL, -1
	PRINTFORM 명중:{RESULT,4}　
	RESULT = 0
	CALL GET_SKILL_PROP, "SKILL_POWER", L_SKILL, -1
	PRINTFORM 威力:{RESULT,4}　
	RESULT = 0
	CALL GET_SKILL_COST, L_SKILL
	PRINTFORML %RESULTS%

	RESULT = -1
	CALL GET_SKILL_PROP, "SKILL_TYPE", L_SKILL, -1
	PRINTFORM 相性:%GET_TYPE(RESULT), 6%　

	CALL GET_SKILL_PROP, "SKILL_DECIDE_TYPE", L_SKILL, -1
	PRINTFORM \@RESULT == 1 ? EX # MA\@　
	CALL GET_SKILL_TARGET_STR, L_SKILL, -1
	PRINTFORM 範囲:%RESULTS, 8, LEFT%

	CALL GET_SKILL_PROP, "SKILL_EFECT", L_SKILL, -1
	PRINTFORM 種別:%GET_SKILL_EFFECT(RESULT), 12, LEFT%

	CALL GET_SKILL_PROP, "SKILL_MINATTACKNUMBER", L_SKILL,-1
	VARI MINATK_NUMBER = RESULT
	CALL GET_SKILL_PROP, "SKILL_MAXATTACKNUMBER", L_SKILL,-1
	VARI MAXATK_NUMBER = RESULT
	IF MINATK_NUMBER == MAXATK_NUMBER
		PRINTFORM 공격횟수:{MINATK_NUMBER}
	ELSE
		PRINTFORM 공격횟수:{MINATK_NUMBER}～{MAXATK_NUMBER}
		CALL GET_SKILL_PROP, "SKILL_MAXATK_PER", L_SKILL,-1
		VARI MAXATK_PER = RESULT
		SIF MAXATK_PER != MAXATK_NUMBER
			PRINTFORM 　1体当たり{RESULT}HITまで
	ENDIF
	PRINTL
	
	CALL GET_SKILL_PROP, "SKILL_EXPLAIN", L_SKILL, -1
	PRINTL 
	IF LOCAL:4 != 3
		FOR LOCAL:1,1,CSVCHARANUM
			SIF EXISTCSV(LOCAL:1,0) == 0
				CONTINUE
			SIF CSVTALENT(LOCAL:1,GETNUM(TALENT,"남자"),0) == LOCAL:4
				CONTINUE
			LOCAL:3 = -1
			FOR LOCAL:2,1,FLAG:스킬수+1
				SIF CSVABL(LOCAL:1,GETNUM(ABL,"스킬"+ TOSTR(LOCAL:2)),0) == L_SKILL
					LOCAL:3 = 0
				SIF LOCAL:3 > -1
					BREAK
			NEXT
			FOR LOCAL:2,1,21
				SIF CSVABL(LOCAL:1,GETNUM(ABL,"습득스킬"+ TOSTR(LOCAL:2)),0) == L_SKILL
					LOCAL:3 = CSVABL(LOCAL:1,GETNUM(ABL,"습득LV"+ TOSTR(LOCAL:2)),0)
				SIF LOCAL:3 > -1
					BREAK
			NEXT
			IF LOCAL:3 == 0
				PRINTFORML 　　　[{LOCAL:1,4}] %CSVCALLNAME(LOCAL:1,0),20,LEFT% LV{CSVBASE(LOCAL:1,GETNUM(BASE,"LV"),0)}　　　初期習得
			ELSEIF LOCAL:3 > 0
				PRINTFORML 　　　[{LOCAL:1,4}] %CSVCALLNAME(LOCAL:1,0),20,LEFT% LV{CSVBASE(LOCAL:1,GETNUM(BASE,"LV"),0)}　　　습득LV:{LOCAL:3}
			ENDIF
		NEXT
	ENDIF
	PRINTL
	IF LOCAL % 400 == 0 && LOCAL:5 == 1
		PRINTW
	ENDIF
	SIF IS_CHARA_CHECK
		WAIT
NEXT
WAIT





