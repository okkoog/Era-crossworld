

@SHOPCOMABLE_190
[IF_DEBUG]
	RESULTS = 능력치합계체크
	RETURN 1
[ENDIF]
IF FLAG:DEBUG
	RESULTS = 능력치합계체크
	RETURN 1
ENDIF
RETURN -1

@SHOP_COM_190, ARG
#DIM 合計 , 1
PRINTL
CLEARLINE LINECOUNT
FOR LOCAL , 1 , CSVCHARANUM
	合計 = 0
	SIF !EXISTCSV(LOCAL , 0)
		CONTINUE	
	SIF CSVTALENT(LOCAL, GETNUM(TALENT, "비전투원"))
		CONTINUE
	SIF GROUPMATCH(GET_RACE(CSVABL(LOCAL, GETNUM(ABL, "종족"))), "링크전용", "페르소나전용", "보스전용")
		CONTINUE
	FOR LOCAL:1 , 1 , 7
		合計 += CSVBASE(LOCAL , GETNUM(BASE , "LV") + LOCAL:1 , 0)
	NEXT
	IF ABS(合計 - 18 - CSVBASE(LOCAL , GETNUM(BASE , "LV"), 0) * 3 /2) > 5
		DRAWLINE
		PRINTFORML [{LOCAL,4}] %CSVNAME(LOCAL,0)%
		PRINTFORML LV　　:{CSVBASE(LOCAL , GETNUM(BASE , "LV"), 0)}
		PRINTFORML 基準値:{18 + CSVBASE(LOCAL , GETNUM(BASE , "LV"), 0) * 3 /2} / 合計:{合計}
		IF 合計 > 18 + CSVBASE(LOCAL , GETNUM(BASE , "LV"), 0) * 3 /2
			CALL PRINT_COLOR, @"超過　:{合計 - (18 + CSVBASE(LOCAL , GETNUM(BASE , "LV"), 0) * 3 /2)}", COLOR("red")
		ELSE
			CALL PRINT_COLOR, @"不足　: - {(18 + CSVBASE(LOCAL , GETNUM(BASE , "LV"), 0) * 3 /2) - 合計}", COLOR("p-green")
		ENDIF
		PRINTL 
	ENDIF
NEXT
WAIT