	PRINTFORML SELECTCASE ARG
	FOR LCOUNT, 0, SKILLNUM
		TRYCCALLFORM SKILL_NAME_{LCOUNT}, -1
			PRINTFORML タブ変換CASE {LCOUNT}
			PRINTFORML タブ変換タブ変換RETURNF \"%RESULTS%\"
		CATCH
		ENDCATCH
	NEXT
	PRINTFORML タブ変換CASEELSE
	PRINTFORML タブ変換タブ変換RETURNF "スキル未定義"
	PRINTFORML ENDSELECT
	PRINTFORML 
	WAIT
ENDIF

