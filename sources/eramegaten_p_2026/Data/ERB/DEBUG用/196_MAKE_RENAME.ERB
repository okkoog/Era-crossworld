	PRINTFORML SELECTCASE ARGS
	FOR LCOUNT, 0, SKILLNUM
		TRYCCALLFORM SKILL_NAME_{LCOUNT}, -1
			PRINTFORML タブ変換CASE \"%RESULTS%\"
			PRINTFORML タブ変換タブ変換RETURNF {LCOUNT}
		CATCH
		ENDCATCH
	NEXT
	PRINTFORML タブ変換CASEELSE
	PRINTFORML タブ変換タブ変換RETURNF -1
	PRINTFORML ENDSELECT
	PRINTFORML 
	PRINTFORML ;==================================================================
	PRINTFORML ;スキル番号からスキル名称を取得。Rename作成の時に出力される内容から作る
