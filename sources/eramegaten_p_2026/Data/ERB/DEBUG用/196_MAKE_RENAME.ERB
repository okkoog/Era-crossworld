		CASE 2801
			LOCALS = 幻想郷2
		CASE 2951
			LOCALS = 악마사냥꾼
		CASE 2959
			LOCALS = 型月
		CASE 2988
			LOCALS = 魔法少女
		CASE 3001
			LOCALS = 使用アイテム
		CASE 3501
			LOCALS = 外部作品スキル
		CASE 3901
			LOCALS = 전용기
		CASE 3920
			LOCALS = 自動効果2
		CASE 4000 TO 4839
			SIF LOCAL == 4000
				LOCALS = リンケージ
			IF (LOCAL+1) % 40 == 0
				LOCALS = %GET_SUCCESSION((LOCAL-4000 + 1)/40)%
				LOCAL:1 = 1
			ENDIF
		CASE 4840
			LOCALS = ＧＵＮ
			LOCAL:1 = 1
		CASE 4940
			LOCALS = 外部作品
			LOCAL:1 = 1
	ENDSELECT
	IF LOCALS != ""
		SIF !LOCAL:1
			PRINTFORML ;-------------------------------
		PRINTFORML ;%LOCALS%
		SIF !LOCAL:1
			PRINTFORML ;-------------------------------
	ENDIF
	SIF RESULTS != ""
		PRINTFORML {LOCAL} , 스킬:%RESULTS%
NEXT
