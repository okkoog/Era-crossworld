L_BLANKNUM = 0
FOR LOCAL, 1, SKILLNUM
	;オリジナルスキル除外
	SIF LOCAL >= 3900 && LOCAL <= 3903
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_NAME", LOCAL, -1
	IF RESULTS != ""
		IF L_BLANKNUM > 0
			IF L_BLANKNUM == 1
				PRINTFORML ;{LOCAL-1} , 空き番号
			ELSE
				PRINTFORML ;{LOCAL-L_BLANKNUM}～{LOCAL-1} , 空き番号
			ENDIF
			L_BLANKNUM = 0
		ENDIF
		SELECTCASE LOCAL
			CASE 2305
				RESULTS = ＤＵＭＭＹ
		ENDSELECT
	ELSE
		RESULTS = 
		L_BLANKNUM++
	ENDIF
	LOCALS = 
	LOCAL:1 = 0
	SELECTCASE LOCAL
		CASE IS < 2100
			SIF LOCAL % 100 == 1
				LOCALS = %GET_SUCCESSION(LOCAL/100)%
		CASE 2101
			LOCALS = ＧＵＮ
		CASE 2301
			LOCALS = 基本行動
		CASE 2401
			LOCALS = 자동효과
		CASE 2501
			LOCALS = 敵専用
		CASE 2601
			LOCALS = 幻想郷
		CASE 2701
