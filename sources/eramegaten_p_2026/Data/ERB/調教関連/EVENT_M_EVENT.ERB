;-------------------------------------------
;イベント口上テキスト
;-------------------------------------------
;朝フェラ/커닐링구스
@EVENT_MESSAGE_1
IF HAVE_PENIS(MASTER)
	;フェラ
	SELECTCASE RAND:7
		CASE 0
			PRINTFORML 아침、%CALLNAME:B%의 펠라로 눈을 떴다
			PRINTFORMW %조사처리(CALLNAME:B,"는")% 정액이 달라붙은 얼굴로 아침의 인사를 해 왔다
		CASE 1
			PRINTFORML 눈을 뜨면、아침 해 속에서 %조사처리(CALLNAME:B,"가")% 열심히 펠라치오를 하고 있었다。
			PRINTFORML 입안 가득 물고는 치켜보며 %CALLNAME:MASTER%에게 싱긋 미소 짓자、
			PRINTFORMW 그대로 사정시키려고 더욱 행위에 열의를 담아 갔다…
		CASE 2
			PRINTFORML 아침、부드러운 감촉에 눈을 뜨자、%조사처리(CALLNAME:B,"가")% %CALLNAME:MASTER%의 페니스를 핥아대고 있었다。
			PRINTFORMW 혀를 쉴 새 없이 훑으며、정액을 목구멍 깊숙이 삼킬 때까지 페니스를 즐기고 있었다…
		CASE 3
			PRINTFORML 아침이 아직 이른 시간에、깨달아 보니 알몸의 %조사처리(CALLNAME:B,"가")% %CALLNAME:MASTER%의 페니스를 입에 물고 있었다。
			PRINTFORML 눈을 뜬 %조사처리(CALLNAME:MASTER,"와")% 올려다보는 눈길로 눈을 마주치자、
			PRINTFORMW 그대로 보여주듯 음란한 혀놀림으로 발기한 페니스에 봉사해 갔다…
		CASE 4
			PRINTFORML 아침에 눈을 뜨면、%조사처리(CALLNAME:B,"가")% %CALLNAME:MASTER%의 발기한 페니스를 소리를 내며 입에 물고 있었다。
			PRINTFORMW 타액을 휘감고、구석구석까지 청소하는 것 같은 봉사를 열심히 하고 있었다…
		CASE 5
			PRINTFORML 아침、%CALLNAME:B%의 펠라로 잠을 깨었다。
			PRINTFORMW 아무래도 잠들어 있던 %CALLNAME:MASTER%의 반응을 보고、혀놀림을 연구하고 있던 것 같다…
		CASE 6
			PRINTFORML 아침이 되어 눈을 뜨자、%CALLNAME:MASTER%의 가랑이에 %조사처리(CALLNAME:B,"가")% 얼굴을 묻고 있었다…
			PRINTFORMW 사랑스럽다는 듯이 페니스에 입을 맞추고、입안에 받아들일 때까지 봉사해 갔다…
	ENDSELECT
ELSE
	;커닐링구스
	SELECTCASE RAND:9
		CASE 0
			PRINTFORML 아침、%MASTER는% %CALLNAME:B%의 커닐링구스로 눈을 떴다
			PRINTFORMW %조사처리(CALLNAME:B,"는")% 애액을 핥아먹으며 아침의 인사를 했다
		CASE 1
			PRINTFORML 아침、눈을 뜨자 %조사처리(CALLNAME:B,"가")% %CALLNAME:MASTER%의 가랑이에 얼굴을 묻고 핥고 있었다…
			PRINTFORML 놀란 %CALLNAME:MASTER%에도 아랑곳하지 않고 %조사처리(CALLNAME:B,"는")% %CALLNAME:MASTER%의 음부를 괴롭혀 갔고、
			PRINTFORMW 몸을 활처럼 뒤로 젖혀 절정할 때까지 격렬한 구음은 계속되었다…
		CASE 2
			PRINTFORML 아침에 눈을 뜨자、%조사처리(CALLNAME:B,"가")% %CALLNAME:MASTER%에게 커닐링구스하고 있었다…
			PRINTFORMW 부드러운 혀놀림의 정중한 봉사에、%MASTER는% 몸을 맡겼다…
		CASE 3
			PRINTFORML 아침、%CALLNAME:B%의 커닐링구스에 눈을 떴다。
			PRINTFORML 이미 오랫동안 계속되고 있었는지、달아오른 %CALLNAME:MASTER%의 몸의 안쪽이
			PRINTFORMW 질퍽거리는 애액으로 흘러넘치고 있는 것을 느끼고 있었다…
		CASE 4
			PRINTFORML 아침、자고 있던 %MASTER는% %CALLNAME:B%의 기색으로 눈을 떴다。
			PRINTFORMW %조사처리(CALLNAME:B,"는")% 숨을 죽이면서도 흥분한 모습으로、%CALLNAME:MASTER%의 속옷을 비켜놓아 핥고 있었다…
		CASE 5
			PRINTFORML 아침의 밝은 햇볕 속에서、%조사처리(CALLNAME:B,"는")% %CALLNAME:MASTER%의 가랑이에 얼굴을 묻고 있었다。
			PRINTFORMW 실룩실룩 움직이는 음부의 구석구석까지 가까이서 관찰하면서、맛보듯이 비육을 핥고 있었다…
		CASE 6
			PRINTFORML 아침이 되어 %조사처리(CALLNAME:MASTER,"가")% 눈을 뜨자、%CALLNAME:MASTER%의 몸을 %조사처리(CALLNAME:B,"가")% 열심히 봉사하고 있었다。
			PRINTFORML 잠에서 막 깬 나른한 분위기 속에서、몸 안쪽부터 녹아내리듯 쾌락에 잠겨가고
			PRINTFORMW 이윽고、%MASTER는% 다리를 크게 벌리고 좀 더 격렬하게 해달라고 조르고 있었다…
		CASE 7
			PRINTFORML 아침、%조사처리(CALLNAME:MASTER,"가")% 눈을 뜨니 다리가 M자로 벌어져 %CALLNAME:B%에게 핥아지고 있었다…
			PRINTFORML 민감한 부분을 혀로 계속 자극받는 동안에、%MASTER는% 어느덧
			PRINTFORMW 양손으로 %CALLNAME:B%의 머리를 가랑이에 살며시 누르고서、더욱 행위를 요구하고 있었다…
		CASE 8
			PRINTFORML 아침이 오니 %조사처리(CALLNAME:B,"가")% 자고 있던 %CALLNAME:MASTER%의 가랑이에 묻혀 핥아 올리고 있었다.
			PRINTFORML %CALLNAME:MASTER%의 의사와는 관계없이 음란하게 움직이는 비육을 %조사처리(CALLNAME:B,"는")% 정성스럽게 핥아가고、
			PRINTFORMW %MASTER는% 움찔움찔 몸을 비틀면서、쾌락을 느끼고 있다…
	ENDSELECT
ENDIF

;朝パイズリ
@EVENT_MESSAGE_2
;貧乳の場合
IF TALENT:빈유
	PRINTFORML 아침、눈을 뜨자마자 하복부에 위화감이 있는 것을 눈치챘다
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 눈치채지 않게 눈을 돌리자、%조사처리(CALLNAME:B,"가")% 가슴으로 페니스를 비비고 있었다
			PRINTFORMW 아무래도 파이즈리의 연습을 하고 있는 것 같다……
		CASE 1
			PRINTFORMW %조사처리(CALLNAME:B,"가")% 뜨거운 시선으로 발기한 페니스를 유두에 비벼대고 있다…
		CASE 2
			PRINTFORMW %조사처리(CALLNAME:B,"가")% 눈을 감고 달콤한 한숨을 토해내면서、발기한 페니스를 갖다 대어 유두를 만지작거리고 있었다…
	ENDSELECT
;巨乳、爆乳、魔乳の場合
ELSEIF TALENT:거유 || TALENT:폭유 || TALENT:마유
	PRINTFORML 아침、눈을 뜨자마자 하복부에 위화감이 있는 것을 눈치챘다
	SELECTCASE RAND:5
		CASE 0
			PRINTFORMW 눈을 돌리니 %조사처리(CALLNAME:B,"가")% 커다란 가슴으로 페니스를 끼우고、훑어 올리고 있다
		CASE 1
			PRINTFORMW 한계 직전까지 문질러진 페니스가 %CALLNAME:B%의 부드럽고 큰 가슴에 감싸지고 있다…
		CASE 2
			PRINTFORMW %조사처리(CALLNAME:B,"가")% 중량감이 있는 가슴에 페니스를 끼우고、천천히 훑고 있다…
		CASE 3
			PRINTFORMW %조사처리(CALLNAME:B,"는")% %CALLNAME:MASTER%의 페니스를 가슴으로 감싸、스스로도 쾌감을 얻으면서 상냥하게 봉사하고 있다…
		CASE 4
			PRINTFORML 일어난 %조사처리(CALLNAME:MASTER,"를")% 눈치챈 %조사처리(CALLNAME:B,"는")% 손을 멈추고、생긋 아침 인사를 했다.
			PRINTFORMW 그리고 다시 열심히 큰 가슴으로 %CALLNAME:MASTER%의 발기한 페니스를 감싸고 상냥하게 훑기 시작했다…
	ENDSELECT
;それ以外
ELSE
	PRINTFORML 아침、눈을 뜨자마자 하복부에 위화감이 있는 것을 눈치챘다
	SELECTCASE RAND:5
		CASE 0
			PRINTFORMW 눈을 돌려보니 %조사처리(CALLNAME:B,"가")% 가슴으로 페니스를 훑어 올려、나온 정액을 빨고 있다
		CASE 1
			PRINTFORMW 넋을 잃은 얼굴을 하고 %조사처리(CALLNAME:B,"가")% 가슴에 페니스를 끼워、상냥하게 움직이고 있다…
		CASE 2
			PRINTFORMW %조사처리(CALLNAME:B,"가")% 작고 달콤한 한숨을 토해내면서、%CALLNAME:MASTER%의 페니스를 열심히 파이즈리하고 있다…
		CASE 3
			PRINTFORML %CALLNAME:MASTER%의 페니스는 %CALLNAME:B%의 타액으로 매끄럽게 돼、그 유방에 끼워지고 있었다。
			PRINTFORMW 헌신적인 봉사에 %조사처리(CALLNAME:MASTER,"가")% 절정에 이르자、열띤 얼굴을 하고 정액을 핥아、자기 자신의 피부에 발라갔다…
		CASE 4
			PRINTFORMW 살펴보니 %조사처리(CALLNAME:B,"가")% %CALLNAME:MASTER%의 페니스를 끼우고、크게 몸을 사용해 위아래로 자극하고 있다…
	ENDSELECT
ENDIF

;朝騎乗位/貝合わせ
@EVENT_MESSAGE_3
IF HAVE_PENIS(MASTER)
	;기승위
	SELECTCASE RAND:9
		CASE 0
			PRINTFORML 아침에 일어나보니 허리의 근처에 중량감을 느꼈다
			PRINTFORMW 눈을 돌려보니 %조사처리(CALLNAME:B,"가")% 위에 올라타 헐떡이고 있었다……
		CASE 1
			PRINTFORML 따듯한 감촉에 눈을 뜨니  아침 햇살 속에서 %조사처리(CALLNAME:B,"가")% 위에 올라타 있다
			PRINTFORMW 질 깊숙이까지 페니스를 받아들이고 침을 늘어뜨리며 열중하여 쾌락을 탐내고 있다…
		CASE 2
			PRINTFORML 아침、중량감을 느껴 눈을 떠보니 %조사처리(CALLNAME:B,"가")% 위에 올라타 헐떡이고 있었다
			PRINTFORML %CALLNAME:MASTER%의 정자를 체내에 받아들이는 것만을 생각하며、
			PRINTFORMW 페니스를 질로 꽉 물듯이 받아들이고、요염하게 허리를 흔들고 있다…
		CASE 3
			PRINTFORML 아침、중량감을 느껴 눈을 떠보니 %조사처리(CALLNAME:B,"가")% %CALLNAME:MASTER%의 허리에 올라타 연결되고 있었다…
			PRINTFORMW 정욕에 사로잡힌 표정으로 끊임 없이 질내에 페니스를 꽉 누르고 있다…
		CASE 4
			PRINTFORML 아침 눈을 떠보니 %조사처리(CALLNAME:B,"가")% 기승위로 %조사처리(CALLNAME:MASTER,"와")% 연결되고 있었다…
			PRINTFORML 사정의 순간을 가장 안쪽에서 맞이할 수 있도록 조금씩 허리를 꽉 눌러
			PRINTFORMW 넋을 잃은 얼굴로 그 순간을 기다리고 있다…
		CASE 5
			PRINTFORML 아침이 되어 눈을 뜨니 기승위의 자세로 %조사처리(CALLNAME:B,"가")% %CALLNAME:MASTER%의 위에서 헐떡이고 있었다。
			PRINTFORML 눈을 뜨고 멍하니 올려다보는 %조사처리(CALLNAME:MASTER,"를")% 눈치챘는지
			PRINTFORML %조사처리(CALLNAME:B,"는")% 연결된 채로 몸을 기대어 입맞춤을 해 왔다.
			PRINTFORMW 탐내듯이 혀를 휘감으면서 허리를 요염하게 움직여 계속 몸을 섞고 있었다…
		CASE 6
			PRINTFORML 아침、잠에서 깨니 하반신이 녹아내릴 듯한 쾌감에 감싸지고 있었다.
			PRINTFORML %조사처리(CALLNAME:B,"가")% 기승위로 %CALLNAME:MASTER%의 위에 올라타、허리를 전후로 흔들면서 달게 헐떡이고 있었다…
			PRINTFORML 이미 한계에 가까워진 %조사처리(CALLNAME:MASTER,"가")% 질내에 기세 좋게 사정하자、
			PRINTFORMW 수정에의 기대로 눈을 글썽거리며、허리를 보다 강하게 꽉 눌러왔다…
		CASE 7
			PRINTFORML 아침、잠에서 깨어난 %CALLNAME:MASTER%의 위로、%조사처리(CALLNAME:B,"가")% 기승위로 올라타 있다…
			PRINTFORML 윤택한 애액으로 젖은 질은 %CALLNAME:MASTER%의 발기한 페니스를 감싸고、
			PRINTFORMW 농후한 교배를 요구하며 질벽을 요염하게 꿈틀대며 사정을 유혹하고 있다…
		CASE 8
			PRINTFORML 아침、%MASTER는% 위에 올라타 기승위로 몸부림치는 %CALLNAME:B% 때문에 잠에서 깼다.
			PRINTFORML 자다 일어나 어안이 벙벙한 %조사처리(CALLNAME:MASTER,"를")% 열정적으로 응시하면서,
			PRINTFORMW 안쪽에 닿을 때까지 깊숙이 받아들이고 격렬하게 전후로 허리를 움직여 쾌락을 탐내고 있다…
	ENDSELECT
ELSE
	;貝合わせ
	SELECTCASE RAND:4
		CASE 0
			PRINTFORML %조사처리(CALLNAME:MASTER,"가")% 아침에 일어나보니 이상한 자세가 된 것을 느꼈다
			PRINTFORMW 눈을 돌려보니 %조사처리(CALLNAME:B,"가")% %CALLNAME:MASTER%의 한쪽 발을 들어 올리고、그 틈새에 몸을 밀어 넣어、비소끼리 서로 스치게 해 헐떡이고 있다……
		CASE 1
			PRINTFORML 몸이 흔들리는 바람에、%MASTER는% 잠으로부터 눈을 뜨고
			PRINTFORMW 시선을 돌려보니 %조사처리(CALLNAME:B,"가")% %CALLNAME:MASTER%의 다리를 크게 벌리고、비육을 비비어 맞추고 달게 헐떡이고 있다…
		CASE 2
			PRINTFORML 아침이 되어 %조사처리(CALLNAME:MASTER,"가")% 눈을 떠보니 %조사처리(CALLNAME:B,"가")% %조사처리(CALLNAME:MASTER,"와")% 비소를 서로 접하게 하고 있었다.
			PRINTFORMW 색정에 탁해진 눈으로、%조사처리(CALLNAME:MASTER,"를")% 끊임없이 요구하고 있다…
		CASE 3
			PRINTFORML 아침、%조사처리(CALLNAME:MASTER,"가")% 눈을 떠보니、%조사처리(CALLNAME:B,"가")% %CALLNAME:MASTER%의 비소에 스스로를 꽉 눌러 헐떡이고 있었다.
			PRINTFORMW 애액으로 젖은 채 열기를 띤 두 명의 음부가、아침 해에 비추어져 음란하게 겹쳐있다…
	ENDSELECT
ENDIF

;朝騎乗位A
@EVENT_MESSAGE_24
	SELECTCASE RAND:6
		CASE 0
			PRINTFORML 아침에 일어나 보니 허리의 근처에 중량감을 느꼇다
			PRINTFORMW 눈을 돌려보니 %조사처리(CALLNAME:B,"가")% 항문으로 페니스를 받아들이면서 위에 올라타 헐떡이고 있다……
		CASE 1
			PRINTFORML 아침에 눈을 떠보니、%조사처리(CALLNAME:B,"가")% %CALLNAME:MASTER% 위에서 헐떡이고 있었다。
			PRINTFORMW %CALLNAME:MASTER%의 페니스를 뒤구멍에 받아들여、스스로 장내를 후벼 파며 기쁜 표정을 짓고 있다…
		CASE 2
			PRINTFORML 아침、%MASTER는% 페니스가 조여지는 감촉 때문에 일어났다。
			PRINTFORML 멍하니 눈을 열어보니、%조사처리(CALLNAME:B,"가")% 항문으로 %CALLNAME:MASTER%의 페니스를 받아들이며、올라타고 있다…
			PRINTFORMW %조사처리(CALLNAME:B,"는")% 눈을 뜬 %CALLNAME:MASTER%에게 입맞춤을 하면서、음란한 얼굴로 허리를 흔들며 쾌감을 탐내갔다…
		CASE 3
			PRINTFORML 아침、%MASTER는% 몸에 중량감을 느끼고 눈을 떴다。
			PRINTFORML 기승위의 자세로、애널에 %CALLNAME:MASTER%의 페니스를 받아들인 %조사처리(CALLNAME:B,"가")% 눈앞에서 할딱이고 있다…
