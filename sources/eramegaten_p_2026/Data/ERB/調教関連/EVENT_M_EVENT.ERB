				CASE 2
					PRINTL 큰 환호성으로 화답했다
				CASEELSE
					PRINTL 큰 박수로 화답했다
			ENDSELECT
		ELSE
			PRINT 노랫소리에 모인 청중들은
			SELECTCASE RAND:3
				CASE 1
					PRINTL 아낌없는 돈으로 화답했다
				CASE 2
					PRINTL 큰 환호성으로 화답했다
				CASEELSE
					PRINTL 큰 박수로 화답했다
			ENDSELECT
		ENDIF
		SELECTCASE RAND:3
			CASE 1
