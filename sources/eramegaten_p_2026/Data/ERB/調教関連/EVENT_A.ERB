;EVENT_A.ERB、EVENT_ABILITY、能力や素質の変化イベント
@EVENTCHECK_ABL
IF TARGET >= 0
	CALL EVENTCHECK_T, TARGET
	CALL END_TRAIN_CHARASELL, TARGET
ENDIF
SIF MASTER >= 0
	CALL EVENTCHECK_M
SIF ASSI >= 0
	CALL EVENTCHECK_A
IF FLAG:주인함락기능
	SIF MASTER > -1
		CALL 主人陥落
ENDIF
IF FLAG:ＮＴＲ기능
	SIF TARGET > -1
		CALL NTR_CHECK,TARGET
	SIF ASSI > -1
		CALL NTR_CHECK,ASSI
ENDIF

;割五鈷杵彫りの指輪の処理で使用します
SIF TARGET > -1 && (CFLAG:MASTER:그외 == 1130 || CFLAG:MASTER:그외2 == 1130 || CFLAG:MASTER:그외3 == 1130)
	CALL CHECK_LEVEL_UP , TARGET
;---------------------------------------------------------
;陥落素質
;---------------------------------------------------------
@EVENTCHECK_T, L_CHARA
#DIM DYNAMIC L_CHARA
#DIM LCOUNT
#DIMS GET_TALENTS
#DIMS LOST_TALENTS
#DIM STOCK_LINE
STOCK_LINE = LINECOUNT
GET_TALENTS = 
LOST_TALENTS = 

IF 陥落(L_CHARA) < 1 && TALENT:L_CHARA:붕괴 == 0 && (FLAG:ＮＴＲ기능 == 0 || FAVORITE_1(L_CHARA) == MASTER)
	;恋慕：従順、奉仕精神3以上+屈服刻印Lv3+反発刻印Lv0+奉仕快楽経験200以上+依存度1000以上+異常経験2未満
	IF ABL:L_CHARA:순종 >= 3 && ABL:L_CHARA:봉사정신 >= 3 && MARK:L_CHARA:굴복각인 == 3 && MARK:L_CHARA:반발각인 == 0 && EXP:L_CHARA:봉사쾌락경험 >= 200 && CFLAG:L_CHARA:의존도 >= 1000 && (EXP:L_CHARA:이상경험 - CFLAG:L_CHARA:초기이상경험) < 2
		GET_TALENTS = %ADD_SPLIT(GET_TALENTS , "/", "연모")%
		CALL SET_陥落素質, L_CHARA, "연모"
		PRINTFORMW %CALLNAME:L_CHARA%의 이쪽을 바라보는 눈빛이 이상하다
		PRINTFORML %조사처리(CALLNAME:L_CHARA,"는")% %CALLNAME:MASTER%와의 행위에 기쁨을 느끼고 있는 것 같다
		PRINTFORMW %조사처리(NAME:L_CHARA,"는")%【연모】를 얻었다
		SIF ABL:L_CHARA:종족 != 0 && !TALENT:L_CHARA:비전투원
			CALL CHECK_LEVEL_UP , L_CHARA
	;淫乱：欲望3以上+CVAB感覚合計10以上+快楽刻印Lv3+屈服刻印Lv3+反発刻印Lv0+絶頂経験50以上+異常経験3以上or異常経験1以上+レズ経験もしくはＢＬ経験1000以上orレズ経験もしくはＢＬ経験2000以上
	ELSEIF ABL:L_CHARA:욕망 >= 3 && ABL:L_CHARA:Ｃ감각+ABL:L_CHARA:Ｖ감각+ABL:L_CHARA:Ａ감각+ABL:L_CHARA:Ｂ감각 >= 10 && MARK:L_CHARA:쾌락각인 == 3 && MARK:L_CHARA:굴복각인 == 3 && MARK:L_CHARA:반발각인 == 0 && EXP:L_CHARA:절정경험 >= 50
		IF EXP:L_CHARA:이상경험 >= 3 || (EXP:L_CHARA:이상경험 >= 1 && (EXP:L_CHARA:레즈경험 >= 1000 || EXP:L_CHARA:ＢＬ경험 >= 1000))
			PRINTFORMW %CALLNAME:L_CHARA%의 이쪽을 바라보는 눈빛이 이상하다
			PRINTFORML %조사처리(CALLNAME:L_CHARA,"는")% %CALLNAME:MASTER%에게 주어지는 쾌락에 빠져 있는 것 같다
			PRINTFORMW %조사처리(NAME:L_CHARA,"는")%【음란】을 얻었다
			CALL SET_陥落素質, L_CHARA, "음란"
			GET_TALENTS = %ADD_SPLIT(GET_TALENTS , "/", "음란")%
			IF TALENT:L_CHARA:천사
				PRINTFORMW %조사처리(NAME:L_CHARA,"는")% 성욕에 빠진 탓에【타천사】로 타락해버렸다
				TALENT:L_CHARA:천사 = 0
				TALENT:L_CHARA:타천사 = 1
				GET_TALENTS = %ADD_SPLIT(GET_TALENTS , "/", "타천사")%
				LOST_TALENTS = %ADD_SPLIT(LOST_TALENTS, "/", "천사")%
				IF TALENT:L_CHARA:억압
					IF TALENT:L_CHARA:해방 == 0
						PRINTFORMW %조사처리(NAME:L_CHARA,"는")%【억압】을 잃고、【해방】을 얻었다
						TALENT:L_CHARA:억압 = 0
						TALENT:L_CHARA:해방 = 1
						GET_TALENTS = %ADD_SPLIT(GET_TALENTS , "/", "해방")%
					ELSE
						PRINTFORMW %조사처리(NAME:L_CHARA,"는")%【억압】을 잃었다
						TALENT:L_CHARA:억압 = 0
					ENDIF
					LOST_TALENTS = %ADD_SPLIT(LOST_TALENTS, "/", "억압")%
				ENDIF
			ENDIF
			CALL 陥落人数加算, L_CHARA, "음란"
			SIF ABL:L_CHARA:종족 != 0 && !TALENT:L_CHARA:비전투원
				CALL CHECK_LEVEL_UP , L_CHARA
		ENDIF
	;服従：従順、マゾっ気3以上+CAVB感覚10未満+屈服刻印Lv3+反発刻印Lv0+고통쾌락경험+緊縛経験200以上+의존도-1000以下+異常経験2以上
	ELSEIF ABL:L_CHARA:순종 >= 3 && ABL:L_CHARA:마조끼 >= 3 && ABL:L_CHARA:Ｃ감각+ABL:L_CHARA:Ｖ감각+ABL:L_CHARA:Ａ감각+ABL:L_CHARA:Ｂ감각 < 10 && MARK:L_CHARA:굴복각인 == 3 && MARK:L_CHARA:반발각인 == 0 && EXP:L_CHARA:고통쾌락경험+EXP:L_CHARA:긴박경험 >= 200 && -CFLAG:L_CHARA:의존도 >= 1000 && EXP:L_CHARA:이상경험 >= 2
		PRINTFORMW %CALLNAME:L_CHARA%의 이쪽을 바라보는 눈빛이 이상하다
		PRINTFORML %조사처리(CALLNAME:L_CHARA,"는")% %CALLNAME:MASTER%에게 마음이 완전히 굴복한 것 같다
		PRINTFORMW %조사처리(NAME:L_CHARA,"는")%【복종】을 얻었다
		CALL SET_陥落素質, L_CHARA, "복종"
		GET_TALENTS = %ADD_SPLIT(GET_TALENTS , "/", "복종")%
		IF TALENT:L_CHARA:천사
			PRINTFORMW %조사처리(NAME:L_CHARA,"는")% 몸도 마음도 %CALLNAME:MASTER%의 노예가 된 탓에、【타천사】로 타락해버렸다
			TALENT:L_CHARA:천사 = 0
			TALENT:L_CHARA:타천사 = 1
			GET_TALENTS = %ADD_SPLIT(GET_TALENTS , "/", "타천사")%
			LOST_TALENTS = %ADD_SPLIT(LOST_TALENTS, "/", "천사")%
			IF TALENT:L_CHARA:억압
				IF TALENT:L_CHARA:해방 == 0
					PRINTFORMW %조사처리(NAME:L_CHARA,"는")%【억압】을 잃고、【해방】을 얻었다
					TALENT:L_CHARA:억압 = 0
					TALENT:L_CHARA:해방 = 1
					GET_TALENTS = %ADD_SPLIT(GET_TALENTS , "/", "해방")%
				ELSE
					PRINTFORMW %조사처리(NAME:L_CHARA,"는")%【억압】을 잃었다
					TALENT:L_CHARA:억압 = 0
				ENDIF
				LOST_TALENTS = %ADD_SPLIT(LOST_TALENTS, "/", "억압")%
			ENDIF
		ENDIF
		SIF ABL:L_CHARA:종족 != 0 && !TALENT:L_CHARA:비전투원
			CALL CHECK_LEVEL_UP , L_CHARA
	ENDIF
ENDIF
IF 陥落(L_CHARA) < 2 && TALENT:L_CHARA:붕괴 == 0 && (FLAG:ＮＴＲ기능 == 0 || FAVORITE_1(L_CHARA) == MASTER)
	;친애:恋慕、従順、奉仕精神5以上+反発刻印Lv0+愛情経験200以上+奉仕快楽経験400以上+依存度3000以上+異常経験5未満
	IF TALENT:L_CHARA:연모 && ABL:L_CHARA:순종 >= 5 && ABL:L_CHARA:봉사정신 >= 5 && MARK:L_CHARA:반발각인 == 0 && EXP:L_CHARA:애정경험 >= 200 && EXP:L_CHARA:봉사쾌락경험 >= 400 && CFLAG:L_CHARA:의존도 >= 3000 && (EXP:L_CHARA:이상경험 - CFLAG:L_CHARA:초기이상경험) < 5
		PRINTFORMW %CALLNAME:L_CHARA%의 이쪽을 바라보는 눈빛이 이상하다
		PRINTFORML %조사처리(CALLNAME:L_CHARA,"는")% 몸도 마음도 %CALLNAME:MASTER%에게 의존하고 있는 것 같다
		PRINTFORMW %NAME:L_CHARA%의【연모】는【친애】가 되었다
		CALL SET_陥落素質, L_CHARA, "친애"
		GET_TALENTS = %ADD_SPLIT(GET_TALENTS , "/", "친애")%
		LOST_TALENTS = %ADD_SPLIT(LOST_TALENTS, "/", "연모")%
		;NTR時の戦闘参加不可能解除用
		IF FLAG:ＮＴＲ기능 != 0
			IF TALENT:L_CHARA:즉각함락 == 1
				TALENT:L_CHARA:즉각함락 = 0
				PRINTFORMW %조사처리(CALLNAME:L_CHARA,"는")% 【즉각함락】을 잃었다
				LOST_TALENTS = %ADD_SPLIT(LOST_TALENTS, "/", "즉각함락")%
			ENDIF
			;上司イベント
			IF CFLAG:L_CHARA:상사이벤트진행도 >= 9
				PRINTFORML %조사처리(CALLNAME:L_CHARA,"는")% 간부인 남자와의 계약을 파기했다
				;戦闘員だった場合は非戦闘員が外れる
				;非戦闘員素質付与の悪用防止措置。
				IF TALENT:L_CHARA:반역
					CALL SET_TALENT_PARTY_JOINABLE, L_CHARA, "参加可能"
					PRINTFORML %조사처리(CALLNAME:L_CHARA,"를")% 파티에 편입할 수 있게 되었습니다
				ENDIF
				CFLAG:L_CHARA:노역플래그 = 0
				CFLAG:L_CHARA:매각가능 = 1
				PRINTFORML %조사처리(CALLNAME:L_CHARA,"는")% 노역에 종사할 수 있게 되었습니다
				PRINTFORML %조사처리(CALLNAME:L_CHARA,"를")% 매각할 수 있게 되었습니다
				CFLAG:L_CHARA:상사이벤트진행도 = 0
			ENDIF
		ENDIF
	;娼婦：淫乱、欲望5以上+CVAB感覚合計20以上+反発刻印Lv0+絶頂経験200以上+異常経験6以上or異常経験4以上+レズ経験もしくはＢＬ経験2000以上or異常経験3以上+レズ経験もしくはＢＬ経験3000以上
	ELSEIF TALENT:L_CHARA:음란 && ABL:L_CHARA:욕망 >= 5 && ABL:L_CHARA:Ｃ감각+ABL:L_CHARA:Ｖ감각+ABL:L_CHARA:Ａ감각+ABL:L_CHARA:Ｂ감각 >= 20 && MARK:L_CHARA:반발각인 == 0 && EXP:L_CHARA:절정경험 >= 200
		IF EXP:L_CHARA:이상경험 >= 6 || (EXP:L_CHARA:이상경험 >= 4 && (EXP:L_CHARA:레즈경험 >= 2000 || EXP:L_CHARA:ＢＬ경험 >= 2000)) || (EXP:L_CHARA:이상경험 >= 3 && (EXP:L_CHARA:레즈경험 >= 3000 || EXP:L_CHARA:ＢＬ경험 >= 3000))
			PRINTFORMW %CALLNAME:L_CHARA%의 이쪽을 바라보는 눈빛이 이상하다
			PRINTFORML %조사처리(CALLNAME:L_CHARA,"는")% 몸도 마음도 %CALLNAME:MASTER%에게 주어지는 쾌락에 의존하고 있는 것 같다
			PRINTFORMW %NAME:L_CHARA%의【음란】은【창부】가 되었다
			GET_TALENTS = %ADD_SPLIT(GET_TALENTS , "/", "창부")%
			LOST_TALENTS = %ADD_SPLIT(LOST_TALENTS, "/", "음란")%
			CALL SET_陥落素質, L_CHARA, "창부"
		ENDIF
	;隷属：服従、従順、マゾっ気5以上+CAVB感覚15未満+反発刻印Lv0+고통쾌락경험+緊縛経験500以上+의존도-3000以下+レズ経験もしくはＢＬ経験1500未満+異常経験5以上
	ELSEIF TALENT:L_CHARA:복종 && ABL:L_CHARA:순종 >= 5 && ABL:L_CHARA:마조끼 >= 5 && ABL:L_CHARA:Ｃ감각+ABL:L_CHARA:Ｖ감각+ABL:L_CHARA:Ａ감각+ABL:L_CHARA:Ｂ감각 < 15 && MARK:L_CHARA:반발각인 == 0 && EXP:L_CHARA:고통쾌락경험+EXP:L_CHARA:긴박경험 >= 500 && -CFLAG:L_CHARA:의존도 >= 3000 && EXP:L_CHARA:이상경험 >= 5
		PRINTFORMW %CALLNAME:L_CHARA%의 이쪽을 바라보는 눈빛이 이상하다
		PRINTFORML %조사처리(CALLNAME:L_CHARA,"는")% 몸도 마음도 %CALLNAME:MASTER%의 노예가 된 것 같다
		PRINTFORMW %NAME:L_CHARA%의【복종】은【예속】이 되었다
		GET_TALENTS = %ADD_SPLIT(GET_TALENTS , "/", "예속")%
		LOST_TALENTS = %ADD_SPLIT(LOST_TALENTS, "/", "복종")%
		CALL SET_陥落素質, L_CHARA, "예속"
	ENDIF
ENDIF

IF CFLAG:L_CHARA:피조교횟수 > 0
	;九条ななみでなければ調教で信頼を喪失する。
	IF TALENT:L_CHARA:신뢰 || TALENT:L_CHARA:동료
		;九条ななみは処女である限り信頼を維持する。
		IF L_CHARA == GETCHARA([[キャラ:나나미]]) && CFLAG:L_CHARA:801 == 4
			PRINTFORMW 이번에도 처녀를 지켜냈다. 나나미의 신뢰는 유지되고 있다
		ELSE
			SETCOLOR 0xff0033
			IF TALENT:L_CHARA:연모
				PRINTFORMW 조교를 받은것으로 인해、%조사처리(NAME:L_CHARA,"는")% %NAME:MASTER%에의 애정이 우정을 넘어버렸다
			ELSEIF GET_VALUE_TALENT_JOINABLE(L_CHARA) == 1
				PRINTFORMW 조교를 받은것으로 인해、%조사처리(NAME:L_CHARA,"는")% %NAME:MASTER%에의 우정이 깨지고、전투에 참가하지 않게 되었습니다
				CALL SET_TALENT_PARTY_JOINABLE, TARGET, "参加不可能"
				SIF CPOS(L_CHARA) > 0
					CALL REMOVE_POSITION,CPOS(L_CHARA)
			ELSE
				PRINTFORMW 조교를 받은것으로 인해、%조사처리(NAME:L_CHARA,"는")% %NAME:MASTER%의 노예임을 재확인한 것 같다
			ENDIF
			IF TALENT:L_CHARA:신뢰
				PRINTFORMW %조사처리(NAME:L_CHARA,"는")%【신뢰】를 잃었다
				LOST_TALENTS = %ADD_SPLIT(LOST_TALENTS, "/", "신뢰")%
			ENDIF
			IF TALENT:L_CHARA:동료
				PRINTFORMW %조사처리(NAME:L_CHARA,"는")%【동료】를 잃었다
				LOST_TALENTS = %ADD_SPLIT(LOST_TALENTS, "/", "동료")%
			ENDIF
			TALENT:L_CHARA:신뢰 = 0
			TALENT:L_CHARA:동료 = 0
			CALL 陥落人数加算, TARGET, "연모"
			RESETCOLOR
		ENDIF
	ELSE
		IF GET_VALUE_TALENT_JOINABLE(L_CHARA) == 0 && !TALENT:L_CHARA:반역 && !TALENT:L_CHARA:비전투원 && !TALENT:L_CHARA:전력상실
			IF ABL:L_CHARA:순종 >= 3 || ABL:L_CHARA:욕망 >= 3
				SETCOLOR COLOR("FRIEND")
				IF ABL:L_CHARA:욕망 >= 3
					PRINTFORMW %조사처리(CALLNAME:L_CHARA,"는")% 쾌락에 빠져, 당신에게 저항할 마음을 잃은 것 같다…
				ELSE
					PRINTFORMW %조사처리(CALLNAME:L_CHARA,"는")% 마음이 꺾여, 당신에게 따를 생각이 든 것 같다…
				ENDIF
				PRINTFORMW %조사처리(CALLNAME:L_CHARA,"는")% 【반발】을 잃었다。
				PRINTFORMW %조사처리(CALLNAME:L_CHARA,"을")% 전투에 참가시킬 수 있게 되었다。
				RESETCOLOR
				CALL SET_TALENT_PARTY_JOINABLE, L_CHARA, "参加可能"
			ENDIF
		ENDIF
	ENDIF
ENDIF
;---------------------------------------------------------
;その他奴隷の素質および能力
;---------------------------------------------------------
;特殊性感素質、一つしか取得はできない（重複した場合は上から優先）
;自慰狂い：Ｃ感覚４以上、調教自慰経験２５０以上、絶頂経験１５０以上
