		PRINTFORMW 100인 함락 보너스！　불굴의투지를 획득할 수 있습니다！
		SETBIT FLAG:주인획득스킬, 51
		CALL LEARN_SKILL, MASTER, [[스킬:불굴의투지]]
	ENDIF
	FOR L_COUNT, 0, CSVCHARANUM
		SIF !EXISTCSV(L_COUNT, 0)
			CONTINUE
		;信頼陥落系を含むように修正
		SIF GET_陥落履歴_陥落強度(L_COUNT) > 0
			LOCAL:CSVABL(L_COUNT, GETNUM(ABL, "종족"), 0)++
	NEXT
	FOR L_COUNT, 0 ,49
		IF MASTER_SKILL(L_COUNT) >= 0 && !GETBIT(FLAG:주인획득스킬, L_COUNT) && LOCAL:L_COUNT >= 5
			CALL GET_SKILL_PROP, "SKILL_NAME", MASTER_SKILL(L_COUNT), MASTER
			PRINTFORMW %조사처리(STR:L_COUNT,"를")% 일정 수 함락시킨 것으로 보너스 발생！
			PRINTFORMW 【%RESULTS%】%조사만처리(RESULTS,"를")% 획득할 수 있습니다！
			SETBIT FLAG:주인획득스킬, L_COUNT
			CALL LEARN_SKILL, MASTER, MASTER_SKILL(L_COUNT)
		ENDIF
	NEXT
ENDIF

