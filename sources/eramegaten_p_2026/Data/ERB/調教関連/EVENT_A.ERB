;==========================================================
;@陥落人数加算
;신뢰<>恋慕の乗り入れの間で人数が変動する処理に対処にするために加算時に変動を折り込む
;またこの過程で加入時点での陥落素質持ちが混ざると破綻するのを防ぐために取得履歴を個別でもたせる
;
;ARG 	加算する際の履歴を持つキャラ登録番号
;ARGS 	加算する系統
;==========================================================
@陥落人数加算, ARG, ARGS
#DIM LCOUNT
#DIMS CONST L_ROUTE = "未陥落", "연모", "음란", "복종", "신뢰"
IF CFLAG:ARG:함락인수가산완료
	FLAG:@"%L_ROUTE:(CFLAG:ARG:함락인수가산완료)%인수" -= 1
	FLAG:@"이번주회%L_ROUTE:(CFLAG:ARG:함락인수가산완료)%인수" -= 1
ENDIF
FLAG:@"%ARGS%인수" += 1
FLAG:@"이번주회%ARGS%인수" += 1
CFLAG:ARG:함락인수가산완료 = FINDELEMENT(L_ROUTE, ARGS)
;---- EDIT 011 ADD END ---------------------------