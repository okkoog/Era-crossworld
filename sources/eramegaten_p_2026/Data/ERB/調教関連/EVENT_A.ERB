;---------------------------------------------
;素質の変動があった場合のイベント
;崩壊の場合、呼び出しタイミングが変わるので関数化
;---------------------------------------------
@EVENT_CHANGE_TRAIN_TALENT, ARG, ARGS, ARGS:1
#DIM LCOUNT, 2
#DIM L_SKILL
#DIMS SKILL_NAME, 2
IF CSTR:ARG:롤 == "悪魔" && (COUNT_SPLIT(ARGS, "/", "연모") || COUNT_SPLIT(ARGS, "/", "음란")  || COUNT_SPLIT(ARGS, "/", "복종"))
	CALL GET_AW_SKILLNUM_BY_CSV, ARG
	L_SKILL = RESULT
	TRYCCALLFORM SKILL_NAME_AW_{L_SKILL}, ARG
		SKILL_NAME = %RESULTS%
		IF ABL:ARG:각성스킬
			IF ABL:ARG:각성스킬 != L_SKILL && HAVE_SKILL(ARG, SKILL_NUM_F("각성스킬"))
				PRINTFORMW %ARG는% 새로운 스킬을 각성했다！
				PRINTFORMW 하지만、각성스킬은 하나만 소지할 수 있다…
				DRAWLINE
				PRINTFORML □%SKILL_NAME%
				DRAWLINE
				U = ARG
				CALLFORM SKILL_EXPLAIN_AW_{L_SKILL}
				PRINTL 
				PRINTL 
				DRAWLINE
				CALLFORM SKILL_NAME_AW_{ABL:ARG:각성스킬}, ARG
				SKILL_NAME:1 = %RESULTS%
				PRINTFORML □%SKILL_NAME:1%
				DRAWLINE
				CALLFORM SKILL_EXPLAIN_AW_{ABL:ARG:각성스킬}
				PRINTL 
				PRINTL 
				DRAWLINE
				PRINTFORML [0] %조사처리(SKILL_NAME,"을")% 취득한다
				PRINTFORML [1] %조사처리(SKILL_NAME:1,"을")% 남긴다
				CALL INPUTINT, 0, 1
				IF RESULT
					PRINTFORMW %조사처리(SKILL_NAME,"을")% 취득하지 않았다。
				ELSE
					PRINTFORMW %조사처리(SKILL_NAME,"을")% 새롭게 취득했다。
					ABL:ARG:각성스킬 = L_SKILL
				ENDIF
			ENDIF
		ELSE
			PRINTFORMW %ARG는% 새로운 스킬을 각성했다！
			ABL:ARG:각성스킬 = L_SKILL
			SIF !HAVE_SKILL(ARG, SKILL_NUM_F("각성스킬"))
				CALL LEARN_SKILL, ARG, SKILL_NUM_F("각성스킬")
		ENDIF
	CATCH
	ENDCATCH
ENDIF
;キャラ固有
