;==========================================================
;@처녀상실
; 처녀/再生処女を喪失する。
;<引数>
;	ARG  - 처녀/再生処女を失うキャラのキャラ登録番号
;<戻り値>
;	なし
;==========================================================
@처녀상실, ARG = -1
;ARGがキャラ登録番号の範囲の場合何もせず戻る
SIF ARG < 0 && ARG >= CHARANUM
	RETURN

;처녀상실플래그
IF TALENT:ARG:처녀 == 1
	TALENT:ARG:처녀 = 0
	CFLAG:ARG:처녀상실플래그 = 1
ENDIF
;재생처녀상실플래그
IF TALENT:ARG:재생처녀 == 1
	TALENT:ARG:재생처녀 = 0
	CFLAG:ARG:재생처녀상실플래그 = 1
ENDIF

;==========================================================
;@処女喪失イベント
; 처녀/再生処女を喪失する。
;<引数>
;	ARG  - 처녀/再生処女を失ったキャラのキャラ登録番号
;	ARGS - 処女喪失の状況
;<戻り値>
;	なし
;==========================================================
@処女喪失イベント, ARG = -1, ARGS = ""
;ARGがキャラ登録番号の範囲の場合何もせず戻る
SIF ARG < 0 && ARG >= CHARANUM
	RETURN

IF CFLAG:ARG:처녀상실플래그
	CFLAG:ARG:처녀상실플래그 = 0
	PRINTL 처녀상실
	SETCOLOR COLOR("red")
	IF ARGS == ""
		PRINTL 이상경험　처녀상실 + 2
	ELSE
		PRINTFORML 이상경험　처녀상실(%ARGS%) + 2
	ENDIF
RESETCOLOR
	EXP:ARG:이상경험 += 2
ELSEIF CFLAG:ARG:재생처녀상실플래그
	CFLAG:ARG:재생처녀상실플래그 = 0
	PRINTL 재생처녀상실
ENDIF

