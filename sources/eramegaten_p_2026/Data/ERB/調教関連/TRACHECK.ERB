;-------------------------------------------------
;強精神薬による絶頂キャンセル
;-------------------------------------------------
@ECST_CANCEL, ARG

;SOURCE.ERBの絶頂処理を流用

C = 0
V = 0
A = 0
B = 0

;絶頂Ｃ
IF CUP:ARG:0 + PALAM:ARG:쾌Ｃ >= PALAMLV:4 * 5
	C = 5
	CDOWN:ARG:0 = (PALAMLV:4 * 5 - 1000)
;	PRINTL 究極絶頂Ｃキャンセル
ELSEIF CUP:ARG:0 + PALAM:ARG:쾌Ｃ >= PALAMLV:4 * 4
	C = 4
	CDOWN:ARG:0 = (PALAMLV:4 * 4 - 1000)
;	PRINTL 最強絶頂Ｃキャンセル
ELSEIF CUP:ARG:0 + PALAM:ARG:쾌Ｃ >= PALAMLV:4 * 3
	C = 3
	CDOWN:ARG:0 = (PALAMLV:4 * 3 - 1000)
;	PRINTL 超強絶頂Ｃキャンセル
ELSEIF CUP:ARG:0 + PALAM:ARG:쾌Ｃ >= PALAMLV:4 * 2
	C = 2
	CDOWN:ARG:0 = (PALAMLV:4 * 2 - 1000)
;	PRINTL 強絶頂Ｃキャンセル
ELSEIF CUP:ARG:0 + PALAM:ARG:쾌Ｃ >= PALAMLV:4
	C = 1
	PALAM:ARG:쾌Ｃ = 5000
	CUP:ARG:0 = 0
;	PRINTL 絶頂Ｃキャンセル
ENDIF
;CDOWN:ARG:1で下げても絶頂以上なら
;その値-1になるように調整（10000で絶頂なら9999）
SIF CUP:ARG:0 + PALAM:ARG:쾌Ｃ - CDOWN:ARG:0 >= PALAMLV:4
	CDOWN:ARG:0 = CUP:ARG:0 + PALAM:ARG:쾌Ｃ - PALAMLV:4 + 1

;絶頂Ｖ
IF CUP:ARG:1 + PALAM:ARG:쾌Ｖ >= PALAMLV:4 * 5
	V = 5
	CDOWN:ARG:1 = (PALAMLV:4 * 5 - 1000)
;	PRINTL 究極絶頂Ｖキャンセル
ELSEIF CUP:ARG:1 + PALAM:ARG:쾌Ｖ >= PALAMLV:4 * 4
	V = 4
	CDOWN:ARG:1 = (PALAMLV:4 * 4 - 1000)
;	PRINTL 最強絶頂Ｖキャンセル
ELSEIF CUP:ARG:1 + PALAM:ARG:쾌Ｖ >= PALAMLV:4 * 3
	V = 3
	CDOWN:ARG:1 = (PALAMLV:4 * 3 - 1000)
;	PRINTL 超強絶頂Ｖキャンセル
ELSEIF CUP:ARG:1 + PALAM:ARG:쾌Ｖ >= PALAMLV:4 * 2
	V = 2
	CDOWN:ARG:1 = (PALAMLV:4 * 2 - 1000)
;	PRINTL 強絶頂Ｖキャンセル
ELSEIF CUP:ARG:1 + PALAM:ARG:쾌Ｖ >= PALAMLV:4
	V = 1
	CDOWN:ARG:1 = (PALAMLV:4 - 1000)
;	PRINTL 絶頂Ｖキャンセル
ENDIF
;CDOWN:ARG:1で下げても絶頂以上なら
