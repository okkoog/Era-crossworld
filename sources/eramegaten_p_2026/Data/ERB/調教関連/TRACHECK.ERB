		TFLAG:25 = 1
	ENDIF
ELSEIF A >= 6000 && MARK:굴복각인 <= 2
	TFLAG:24 = 23
	;感情乏しいの場合は屈服刻印による従順アップはなし
	IF ABL:순종 <= 1 && TALENT:감정결핍 == 0
		TFLAG:25 = 1
	ENDIF
ENDIF


A = CUP:TARGET:5 + CUP:TARGET:7

;恭順と屈服によるLvUPは30番+取得した屈服刻印のレベルのTFLAGを与える
