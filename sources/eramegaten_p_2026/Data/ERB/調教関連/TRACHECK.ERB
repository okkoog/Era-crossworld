	ENDIF
ENDIF


A = CUP:TARGET:10 + CUP:TARGET:11

;苦痛と恐怖によるLvUPは20番+取得した屈服刻印のレベルのTFLAGを与える
IF A >= 1000 && A < 2400 && MARK:굴복각인 <= 0
	TFLAG:24 = 21
ELSEIF A >= 2400 && A < 6000 && MARK:굴복각인 <= 1
