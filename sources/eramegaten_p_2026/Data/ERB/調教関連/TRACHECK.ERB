;-------------------------------------------------
;強精神薬の副作用
;-------------------------------------------------
@REACT_DRUG, ARG
;仕様説明：
;@ECST_CANCELでEX:11～EX:14に記録してきた絶頂回数を解放します。
;パッチ詰め合わせではTFLAG:44～TFLAG:47を代わりに使用。内訳は
;TFLAG:44 = EX:11(Ｃ絶頂処理)の代わり、TFLAG:45 = EX:12(Ｖ絶頂処理)の代わり、
;TFLAG:46 = EX:13(Ａ絶頂処理)の代わり、TFLAG:47 = EX:14(Ｂ絶頂処理)の代わり
;記録してきた絶頂回数１回につき、該当する部位の快ソース（UP:0,1,2,3）を２倍にします。
;１回のコマンドでひとつの部位につき１回ずつこの倍化処理を行い、
;EX:11～EX:14の合計が０になったとき、反動が解除されます。
;-------------------------------------------------
;快Ｃの処理
IF TFLAG:44 > 0 && CUP:ARG:0 > 0
	CUP:ARG:0 *= 2
	TFLAG:44 -= 1
ENDIF
;快Ｖの処理
IF TFLAG:45 > 0 && CUP:ARG:1 > 0
	CUP:ARG:1 *= 2
	TFLAG:45 -= 1
ENDIF
;快Ａの処理
IF TFLAG:46 > 0 && CUP:ARG:2 > 0
	CUP:ARG:2 *= 2
	TFLAG:46 -= 1
ENDIF
;快Ｂの処理
IF TFLAG:47 > 0 && CUP:ARG:3 > 0
	CUP:ARG:3 *= 2
	TFLAG:47 -= 1
ENDIF
;反動の終了チェック
SIF TFLAG:44 + TFLAG:45 + TFLAG:46 + TFLAG:47 == 0
	TEQUIP:강정신약 = 0

RETURN 1


;-------------------------------------------------
;調教対象の射精チェック
;-------------------------------------------------
@TARGET_EJAC_CHECK
#DIM 獲得ソース量 , 3 , 6
SIF HAVE_PENIS(TARGET) == 0
	RETURN 0

A = CUP:TARGET:0 + CUP:TARGET:1 + CUP:TARGET:2 + CUP:TARGET:3

;자제심
SIF TALENT:TARGET:자제심
	A /= 2

;쾌감에솔직
SIF TALENT:TARGET:쾌감에솔직
	TIMES A , 1.20

;快感の否定（淫乱、娼婦で無効）
SIF TALENT:TARGET:쾌감을부정 && (TALENT:TARGET:음란 == 0 && TALENT:TARGET:창부 == 0)
	TIMES A , 0.80

;미약
SIF TEQUIP:TARGET:미약
	A *= 2

;이뇨제
SIF TEQUIP:TARGET:이뇨제
	A /= 2

;;射精の再装填期間中は射精ゲージの増加は20分の1に
;SIF CFLAG:TARGET:射精ゲージ再装填 > 0
;	A /= 20

;;射精の限界が来ている場合は、射精ゲージの増加はしない
;IF CFLAG:TARGET:射精残数の保存 == 0
;	A = 0
;	BASE:TARGET:사정 = 0
;ENDIF

BASE:TARGET:사정 += A
;調教画面での変動量表示用にDOWNBASEにマイナスの値を代入
DOWNBASE:TARGET:사정 = -A 

;ターゲットTCVAR:射精処理追加
;射精ゲージ最大値に対する現在の射精の値で射精量を決定
TCVAR:TARGET:사정 =BASE:TARGET:사정 / MAXBASE:TARGET:사정

;---- EDIT 008 MOD START -------------------------
;共通化できる部分を個別の条件から切り出して共通化
;S = BASE:사정
;---- EDIT 009 MOD START -------------------------
;古い記述が残っていると読みづらくなりそうなので、以前の射精量に応じたIF分岐は削除します。（同じ結果が得られる構文にしています）
;-------------------------------------------------
EJAC = MAXBASE:TARGET:사정
;射精フラグが立っていたら射精の処理へ。
;リボンを結んでいると射精処理は絶対スキップする。
IF TEQUIP:리본 == 0 && TCVAR:TARGET:사정 > 0
	;計算用に射精量を改めて定義（最大で射精ゲージの5倍溜まってる事による5）
	TCVAR:TARGET:사정량 =  LIMIT(TCVAR:TARGET:사정 , 0 , 5)
	
	;獲得ソースを決定
	;射精経験が多い程ソースは少なくなり、射精量が2以上であればソースは多くなる。
	IF TCVAR:TARGET:사정량 > 1
		;大量射精時のそれぞれのソースの獲得量を定義する。
		;噴乳経験レベル0,1,2,3,4,5以上の値を代入する
		;露出のソース
		獲得ソース量:0:0 = 10000 , 5000 , 3000 , 1500 , 1000 , 500
		;屈従のソース
		獲得ソース量:1:0 = 5000 , 3000 , 1500 , 800 , 500 , 300
		;不潔のソース
		獲得ソース量:2:0 = 2000 , 1500 , 1000 , 700 , 400 , 0
	ELSE
		;通常射精時のそれぞれのソースの獲得量を定義する。
		;射精経験レベル0,1,2,3,4,5以上の値を代入する
		;露出のソース
		獲得ソース量:0:0 = 5000 , 2500 , 800 , 800 , 400 , 200
		;屈従のソース
		獲得ソース量:1:0 = 2500 , 2000 , 800 , 600 , 400 , 250
		;不潔のソース
		獲得ソース量:2:0 = 900 , 700 , 500 , 350 , 200 , 0
	ENDIF
	;実際のソースを獲得
	SOURCE:TARGET:노출 += 獲得ソース量:0:GETEXPLV(EXP:TARGET:사정경험 , 5)
	SOURCE:TARGET:굴종 += 獲得ソース量:1:GETEXPLV(EXP:TARGET:사정경험 , 5)
	SOURCE:TARGET:불결 += 獲得ソース量:2:GETEXPLV(EXP:TARGET:사정경험 , 5) / (1+9*IS_MALE(TARGET))
	;射精による不潔のソースはオトコであれば1/10になる

