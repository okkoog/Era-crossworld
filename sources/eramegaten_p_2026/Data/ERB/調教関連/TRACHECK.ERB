;-------------------------------------------------
;고통각인
;-------------------------------------------------
IF CUP:TARGET:10 >= 2000 && CUP:TARGET:10 < 4000 && MARK:고통각인 <= 0
	TFLAG:22 = 1
ELSEIF CUP:TARGET:10 >= 4000 && CUP:TARGET:10 < 8000 && MARK:고통각인 <= 1
	TFLAG:22 = 2
	;気丈・感情乏しいの場合は苦痛刻印による従順アップはなし
	IF ABL:순종 == 0 && TALENT:꿋꿋함 == 0 && TALENT:감정결핍 == 0
		TFLAG:25 = 1
	ENDIF
ELSEIF CUP:TARGET:10 >= 8000 && MARK:고통각인 <= 2
	TFLAG:22 = 3
	;気丈・感情乏しいの場合は苦痛刻印による従順アップはなし
