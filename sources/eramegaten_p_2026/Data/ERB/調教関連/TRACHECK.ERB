;挿入継続処理追加
;----------------------------------------------------------------------------------------------------------------------
;頭文字から一物はP、指はFの方で

;縛られている状態や、三角木馬騎乗中
;縛ったまま犯すコマンドが存在するのに加えて、そうした行為が挿入解除に変化するケースが思い当たらないため縄を条件から排除(20260617)
;IF TEQUIP:TARGET:오나홀 || TEQUIP:TARGET:밧줄 || TEQUIP:TARGET:촉수 || TEQUIP:TARGET:삼각목마
IF TEQUIP:TARGET:오나홀 || TEQUIP:TARGET:촉수 || TEQUIP:TARGET:삼각목마
	CALL REMOVE_P_INSERT_V_TARGET
	CALL REMOVE_P_INSERT_A_TARGET
	CALL REMOVE_P_INSERT_V_PLAYER
	CALL REMOVE_P_INSERT_A_PLAYER
	CALL REMOVE_F_INSERT_V_TARGET
	CALL REMOVE_F_INSERT_A_TARGET
ENDIF

;IF TEQUIP:PLAYER:오나홀 || TEQUIP:PLAYER:밧줄 || TEQUIP:PLAYER:촉수 || TEQUIP:PLAYER:삼각목마
IF TEQUIP:PLAYER:오나홀 || TEQUIP:PLAYER:촉수 || TEQUIP:PLAYER:삼각목마
	CALL REMOVE_P_INSERT_V_PLAYER
	CALL REMOVE_P_INSERT_A_PLAYER
ENDIF

