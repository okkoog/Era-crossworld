;処女喪失時の処理
;-------------------------------------------------
@LOST_VIRGIN
IF TALENT:처녀 && TFLAG:19
	PRINTW 처녀상실
	;처녀상실플래그(今回のコマンド)
	TFLAG:3 = 1
	;처녀상실플래그(今回の調教)
