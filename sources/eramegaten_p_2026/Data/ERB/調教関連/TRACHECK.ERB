;-------------------------------------------------
;噴乳チェック(ARG:行為者、ARG:1被行為者)
;-------------------------------------------------
@MILK_CHECK, ARG, ARG:1
#DIM 変数A
#DIM 変数B
#DIM 獲得ソース量 , 3 , 6
SIF TALENT:ARG:모유체질 == 0
	RETURN 0

変数A = CUP:ARG:0 / 5 + CUP:ARG:1 / 5 + CUP:ARG:2 / 5 + CUP:ARG:3 * 3

;자제심
SIF TALENT:ARG:자제심
	変数A /= 2

;쾌감에솔직
SIF TALENT:ARG:쾌감에솔직
	TIMES 変数A , 1.20

;快感の否定（淫乱、娼婦で無効）
SIF TALENT:ARG:쾌감을부정 && IS_BITCHY(ARG) == 0
	TIMES 変数A , 0.80

;B鈍感;鈍感と敏感の番号ミス修正＆なぜか敏感を計算していなかったので追加
SIF TALENT:ARG:Ｂ둔감
	TIMES 変数A , 0.80

;B敏感
SIF TALENT:ARG:Ｂ민감
	TIMES 変数A , 1.20

;미약
SIF TEQUIP:ARG:미약
	変数A *= 2

;이뇨제
SIF TEQUIP:ARG:이뇨제
	変数A /= 2

;調教者が幼児退行
SIF TALENT:(ARG:1):유아／유아퇴행
	TIMES 変数A , 1.20

;調教者が幼稚
SIF TALENT:(ARG:1):유치
	TIMES 変数A , 1.20

;빈유
SIF TALENT:ARG:빈유
	TIMES 変数A , 0.75

;절벽;なぜか絶壁を計算していなかったので追加
SIF TALENT:ARG:절벽
	TIMES 変数A , 0.50

;噴乳中毒のレベルを見る
IF ABL:ARG:분유중독== 0
	TIMES 変数A , 1.00
ELSEIF ABL:ARG:분유중독 == 1
	TIMES 変数A , 1.05
ELSEIF ABL:ARG:분유중독 == 2
	TIMES 変数A , 1.10
ELSEIF ABL:ARG:분유중독 == 3
	TIMES 変数A , 1.20
ELSEIF ABL:ARG:분유중독 == 4
	TIMES 変数A , 1.30
ELSEIF ABL:ARG:분유중독 == 5
	TIMES 変数A , 1.50
ELSE
	変数A = 変数A * ABL:ARG:분유중독 * 30 / 100
ENDIF

;ここで毎ターン500加算されていたのを修正
変数A = 変数A / 2
BASE:ARG:모유 += 変数A
;調教画面での変動量表示用にDOWNBASEにマイナスの値を代入
DOWNBASE:ARG:모유 = -変数A 

;母乳最大値に対する現在の母乳の値で噴乳量を決定（最大5）
変数B = MIN(BASE:ARG:모유 / MAXBASE:ARG:모유 , 5)

;噴乳量が1以上なら噴乳処理
;古い記述が残っていると読みづらくなりそうなので、以前の噴乳量に応じたIF分岐は削除します。（同じ結果が得られる構文にしています）
IF 変数B > 0
	;消耗する体力と気力をDOWNBASEへ
	;大量射精以上だと消耗が大きい
	IF 変数B > 1
		DOWNBASE:ARG:체력 += 20
		DOWNBASE:ARG:기력 += 100
	ELSE
		DOWNBASE:ARG:기력 += 40
	ENDIF

	;獲得ソースを決定
	;噴乳経験が多い程ソースは少なくなり、噴乳量が2以上であればソースは多くなる。
	IF 変数B > 1
		;大量噴乳時のそれぞれのソースの獲得量を定義する。
		;噴乳経験レベル0,1,2,3,4,5以上の値を代入する
		;露出のソース
		獲得ソース量:0:0 = 10000 , 5000 , 3000 , 1500 , 1000 , 500
		;屈従のソース
		獲得ソース量:1:0 = 5000 , 3000 , 1500 , 800 , 500 , 300
		;不潔のソース
		獲得ソース量:2:0 = 2000 , 1500 , 1000 , 700 , 400 , 0
	ELSE
		;通常噴乳時のそれぞれのソースの獲得量を定義する。
		;噴乳経験レベル0,1,2,3,4,5以上の値を代入する
		;露出のソース
		獲得ソース量:0:0 = 5000 , 2500 , 800 , 800 , 400 , 200
		;屈従のソース
		獲得ソース量:1:0 = 2500 , 2000 , 800 , 600 , 400 , 250
		;不潔のソース
		獲得ソース量:2:0 = 900 , 700 , 500 , 350 , 200 , 0
	ENDIF
	;実際のソースを獲得
	SOURCE:ARG:노출 += 獲得ソース量:0:GETEXPLV(EXP:ARG:분유경험 , 5)
	SOURCE:ARG:굴종 += 獲得ソース量:1:GETEXPLV(EXP:ARG:분유경험 , 5)
	SOURCE:ARG:불결 += 獲得ソース量:2:GETEXPLV(EXP:ARG:분유경험 , 5)
	
	;噴乳経験の獲得
	SIF EXP:ARG:분유경험 == 0
		CALL ADDS_ABNORMAL_EXP("噴乳", ARG)
	CALL ADDS_EXP("분유경험", 変数B , ARG)

	;Ｂに母乳汚れを追加
	STAIN:ARG:가슴 |= 16

	;噴乳量に合わせてBASEを減算。まだ最大値を超えているなら最大値-1を上限にする。
	BASE:ARG:모유 -= MAXBASE:ARG:모유*変数B
	SIF BASE:ARG:모유 >= MAXBASE:ARG:모유
		BASE:ARG:모유 = MAXBASE:ARG:모유-1

	;誰が噴乳したかチェック＆搾乳機による母乳収集処理
	IF ARG == MASTER
		TFLAG:주인이분유 += 変数B
		;搾乳器で母乳が集められているかチェック
		SIF TEQUIP:ARG:착유기
			TFLAG:주인이착유중 += 変数B
	ELSEIF  ARG == ASSI
		TFLAG:조수가분유 += 変数B
		;搾乳器で母乳が集められているかチェック
		SIF TEQUIP:ARG:착유기
			TFLAG:조수가착유중 += 変数B
	ELSE
		TFLAG:조교대상이분유 += 変数B
		;搾乳器で母乳が集められているかチェック
		SIF TEQUIP:ARG:착유기
			TFLAG:착유중 += 変数B
	ENDIF
	;絶頂管理キャラ変数に、噴乳量を加算
	NOWEX:ARG:분유 += 変数B
	EX:ARG:분유 += 変数B

	;マグネタイト吸収処理
	IF CFLAG:ARG:ＭＡＧ비피흡수 == 0 && 変数B > 0
		LOCAL = 2 * BASE:(ARG:1):LV * 変数B * 20 * (5+MAX(ABL:(ARG:1):순종,ABL:(ARG:1):욕망,ABL:(ARG:1):기교))/5
		CALL DRAIN_MAG,ARG,LOCAL,ARG:1
	ENDIF
ENDIF

