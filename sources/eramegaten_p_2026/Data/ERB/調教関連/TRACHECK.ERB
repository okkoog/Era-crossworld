	;	TIMES SOURCE:TARGET:아픔 , 0.90
	;	TIMES SOURCE:TARGET:반감 , 0.90
	;ENDIF
	
	;主人による処女喪失チェック
	IF TFLAG:20
		;陥落素質のチェック
		IF TALENT:TARGET:연모
			;貞操観念チェック
			IF TALENT:TARGET:정조관념
				TIMES SOURCE:TARGET:정애 , 1.50
				TIMES SOURCE:TARGET:반감 , 7.50
			ELSEIF TALENT:TARGET:정조관결여
				TFLAG:반발각인의회피 = 2
				TIMES SOURCE:TARGET:정애 , 1.00
			ELSE
				TFLAG:반발각인의회피 = 2
				TIMES SOURCE:TARGET:정애 , 2.50
			ENDIF
			;正常位または対面座位であった場合に愛情経験追加
			IF SELECTCOM == 60 || SELECTCOM == 68
				CALL ADDS_EXP("애정경험", 10, TARGET)
			ENDIF
		ELSEIF TALENT:TARGET:친애
			;貞操観念チェック
			IF TALENT:TARGET:정조관념
				IF TALENT:TARGET:아내
					TFLAG:반발각인의회피 = 2
					TIMES SOURCE:TARGET:정애 , 20.00
				ELSE
					TIMES SOURCE:TARGET:정애 , 3.00
					TIMES SOURCE:TARGET:반감 , 5.00
				ENDIF
			ELSEIF TALENT:TARGET:정조관결여
				TFLAG:반발각인의회피 = 2
				TIMES SOURCE:TARGET:정애 , 2.00
			ELSE
				TFLAG:반발각인의회피 = 2
				TIMES SOURCE:TARGET:정애 , 5.00
			ENDIF
			;正常位または対面座位であった場合に愛情経験追加
			IF SELECTCOM == 60 || SELECTCOM == 68
				CALL ADDS_EXP("애정경험", 10, TARGET)
			ENDIF
		ELSEIF TALENT:TARGET:음란 || TALENT:TARGET:창부
			TFLAG:반발각인의회피 = 2
			;騎乗位であった場合にボーナス
			IF SELECTCOM == 66
				TIMES SOURCE:TARGET:정애 , 2.00
			ENDIF
		ELSEIF TALENT:TARGET:복종 || TALENT:TARGET:예속
			TFLAG:반발각인의회피 = 2
			;特になし
