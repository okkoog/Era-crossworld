;ビデオの重複使用を処理するために、予め値段の加算を行っておく
@PRICE_VIDEO
#DIM ビデオ価格 = 0
#DIM ビデオ奉仕 = 0
#DIM ビデオ被虐 = 0
#DIM ビデオ肛虐 = 0
#DIM ビデオ倍率
#DIM 雑変数
#DIM LCOUNT

TFLAG:비디오타이틀용 = 0
;---- EDIT 007 MOD START -----------------
FOR LCOUNT, 0, TFLAG:70
	雑変数 = LCOUNT + 110
	;디버그용
	;PRINTFORML {LCOUNT+1, 2}回目 {TCVAR:雑変数, 3}番
	;コマンド番号はTrain.CSVに書いてある
	
	;COM:愛撫を見る
	IF TCVAR:雑変数 == 0
		ビデオ価格 += 50
	;COM:クンニを見る
	ELSEIF TCVAR:雑変数 == 1
		ビデオ価格 += 50
	;COM:フェラするを見る
	ELSEIF TCVAR:雑変数 == 2
		ビデオ価格 += 200
	;COM:指挿入れを見る
	ELSEIF TCVAR:雑変数 == 3
		ビデオ価格 += 150
	;COM:アナル舐めを見る
	ELSEIF TCVAR:雑変数 == 4
		ビデオ価格 += 100
		ビデオ肛虐 += 1
	;COM:アナル愛撫を見る
	ELSEIF TCVAR:雑変数 == 5
		ビデオ価格 += 100
		ビデオ肛虐 += 1
	;COM:胸揉みを見る
	ELSEIF TCVAR:雑変数 == 6
		ビデオ価格 += 120
