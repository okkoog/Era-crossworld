	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
IF RESULT == 1000
	RETURN 0
ENDIF

IF RESULT != 999
	VARSET Q, -1
	Q:0 = RESULT
	LOCAL:2 = 1
ELSE
	;間違い対策として念押し確認
	PRINTL 현재 노역중인 모든 캐릭터의 노역을 그만두게 합니다。
	PRINTL 정말로 괜찮겠습니까？
	CALL INPUT_YN
	SIF RESULT == 1
		;キャラ一覧に戻る。
		RESTART
	LOCAL:2 = FINDELEMENT(Q, -1)
ENDIF

FOR LCOUNT, 0, LOCAL:2
	PRINTFORMW %CALLNAME:(Q:LCOUNT)%의 노역을 해제했습니다
	CFLAG:(Q:LCOUNT):노역플래그 = 0
	;CFLAG:(Q:LCOUNT):노역점포 = 0
	IF CFLAG:(Q:LCOUNT):극장출연순서 != 0
		DE:(49+(CFLAG:(Q:LCOUNT):극장출연순서)):(CFLAG:(Q:LCOUNT):노역점포-1) = -1
		DE:(59+(CFLAG:(Q:LCOUNT):극장출연순서)):(CFLAG:(Q:LCOUNT):노역점포-1) = -1
		CFLAG:(Q:LCOUNT):극장출연순서 = 0
		CFLAG:(Q:LCOUNT):노역점포 = 0
	ENDIF
NEXT

RESTART

