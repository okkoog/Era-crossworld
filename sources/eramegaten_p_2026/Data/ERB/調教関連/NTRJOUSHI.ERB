;상사내습
@NTRJOUSHI
#LOCALSIZE 4
#DIM ＮＴＲリスト, 500
#DIM LCOUNT
VARSET ＮＴＲリスト, -1
LOCAL:1 = 0
;呼び出しの計算用
LOCAL:2 = 0
;上司が前日来ていたかどうかの判定用
LOCAL:3 = 0
IF GETBIT(FLAG:ＮＴＲ기능 , 63)
	FOR LCOUNT, 0, CHARANUM
		;女を渡した場合の翌日
		IF CFLAG:LCOUNT:상사내습 > 0
			;上司が前日来ていたかどうか
			SIF CFLAG:LCOUNT:상사내습 == 2
				LOCAL:3 = 1
			CALL NTR_JOUSHI_2(LCOUNT)
		ENDIF
	NEXT
	;CFLAG:上司イベント進行度が7以上のキャラがいる場合
	;20％の確率で呼び出される
	LOCAL:2 = FLAG:상사내습률 - 30
	LOCAL:2 = LIMIT(LOCAL:2 , 0, 30)
	IF RAND:100 < 20 + LOCAL:2
		FOR LOCAL,1,CHARANUM
			SIF TALENT:LOCAL:임신 || TALENT:LOCAL:육아중
				CONTINUE
			SIF IS_RENTING(LOCAL)
				CONTINUE
			;専有奴隷の首輪系装備時は弾く
			SIF IS_ANTI_NTR_CLOTHES(LOCAL) == 1
				CONTINUE
			SIF CFLAG:LOCAL:상사이벤트진행도 < 7
				CONTINUE
			SIF CFLAG:LOCAL:상사이벤트진행도 == 10
				CONTINUE
			ＮＴＲリスト:(LOCAL:1) = LOCAL
			LOCAL:1 ++
		NEXT
		SIF LOCAL:1 == 0
			RETURN 0
		LOCAL = ＮＴＲリスト:(RAND:(LOCAL:1))
		SIF LOCAL < 1 && LOCAL >= CHARANUM
			RETURN 0
		;CFLAG:上司来襲が２の場合は呼び出しに分岐
		CFLAG:LOCAL:상사내습 = 2
		CALL DEACTIVATE_FRIEND_CHARA, LOCAL
		
		SIF CPOS(LOCAL) > 0
			CALL REMOVE_POSITION,CPOS(LOCAL)
		SETCOLOR COLOR("RED")
		IF CFLAG:LOCAL:상사이벤트진행도 >= 13
			PRINTFORMW %CALLNAME:LOCAL%은(는) 어딘가로 나간 모양이다
