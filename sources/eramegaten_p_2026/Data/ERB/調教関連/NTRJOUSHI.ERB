;--------
;상사내습
;--------
@JOUSHI_RAISYUU
#LOCALSIZE 7
#DIM リスト, 500
;CFLAG:上司来襲持ち用
#DIM 上司リスト, 500
VARSET リスト, -1
VARSET 上司リスト, -1
LOCAL:1 = 0
LOCAL:5 = 0
LOCAL:6 = 0
FOR LOCAL,1,CHARANUM
	LOCAL:2 = 0
	SIF CFLAG:LOCAL:이자리에없는플래그 == 1
		CONTINUE
	SIF CFLAG:LOCAL:전투이외불능
		RETURN 0
	;労役中はダメ
	SIF IS_RENTING(LOCAL)
		RETURN 0
	SIF TALENT:LOCAL:ＮＴＲ
		CONTINUE
	SIF !(TALENT:LOCAL:연모 || TALENT:LOCAL:친애)
		CONTINUE
	SIF TALENT:LOCAL:임신 || TALENT:LOCAL:육아중
		CONTINUE
	;専有奴隷の首輪系装備時は弾く
	SIF IS_ANTI_NTR_CLOTHES(LOCAL) == 1
		CONTINUE
	SIF TALENT:LOCAL:남자
		CONTINUE
	SIF TALENT:LOCAL:매력
		LOCAL:2 += 10
	SIF TALENT:LOCAL:거유 || TALENT:LOCAL:폭유
		LOCAL:2 += 30
	SIF TALENT:LOCAL:마유
		LOCAL:2 += 40
	SIF TALENT:LOCAL:아내
		LOCAL:2 += 30
	;背徳の指輪系装備時は弾く
	SIF IS_ANTI_NTR_CLOTHES(LOCAL) == -1
		LOCAL:2 += 50
	SIF (위험일(LOCAL)) > 0
		LOCAL:2 += 40

	IF CFLAG:LOCAL:상사이벤트진행도 > 0
		上司リスト:(LOCAL:6) = LOCAL
		LOCAL:5 = 1
		LOCAL:6 ++
	ELSEIF RAND:100 < 10 + LOCAL:2
		リスト:(LOCAL:1) = LOCAL
		LOCAL:1 ++
	ENDIF
NEXT
;LOCAL:1 == 0の場合、女要求率０
SIF LOCAL:1 == 0 && LOCAL:6 == 0
	GOTO YOUKYUUNASHI
;上司の餌食決定＞LOCAL
;CFLAG:上司イベント進行度がある場合は優先
$LOOP_JOUSHILIST
IF LOCAL:5 == 1
	LOCAL = 上司リスト:(RAND:(LOCAL:6))
ELSE
	LOCAL = リスト:(RAND:(LOCAL:1))
ENDIF
;ありえないと思うけど念のため。LOCALがキャラ登録番号の範囲外の場合なにもしない。
;CFLAG:上司イベント進行度持ちがいる場合はループする
IF LOCAL < 1 && LOCAL >= CHARANUM
	SIF LOCAL:5 == 1
		GOTO LOOP_JOUSHILIST
	RETURN 0
ENDIF
;女要求率
LOCAL:2 = 100
;要求金額倍率
LOCAL:3 = 0
;要求額
LOCAL:4 = 0

;金のみ（所持額の３分の一）か、金（所持額の半分）か彼女かの分岐
;どちらかの所持金が目標金額の半分を超えると、選択肢に恋慕持ちの人間の女が加わる率が+40％
SIF MONEY > (GET_PAYMENT_FOR_NEXT_RANK() / 2) || (MONEY:1 * 50) > (GET_PAYMENT_FOR_NEXT_RANK() / 2)
	LOCAL:2 += 40
;以下の素質が有ると+30％
SIF TALENT:LOCAL:매력 || TALENT:LOCAL:거유 || TALENT:LOCAL:폭유 || TALENT:LOCAL:마유 || TALENT:LOCAL:아내
	LOCAL:2 += 30
;危険日は+40％
SIF (위험일(LOCAL)) > 0
	LOCAL:2 += 40
;要求金額倍率（選択肢）決定
IF RAND:100 < LOCAL:2
	LOCAL:3 = 2
ELSE
	LOCAL:3 = 5
ENDIF
;LOCAL:1 == 0の場合、女要求率０
$YOUKYUUNASHI
SIF LOCAL:1 == 0 && LOCAL:6 == 0
	LOCAL:3 = 5
;魔貨（換金した値）が￥の2倍より多い場合は魔貨要求
;最低要求額は￥１０万（2000魔貨）
;金も女も無い様な所には来ない
IF (MONEY:1 * 50) > MONEY * 2
	LOCAL:4 = MONEY:1 / LOCAL:3
	IF LOCAL:4 < 2000
		LOCAL:4 = 2000
		LOCAL:3 = 1
		SIF LOCAL:1 == 0
			RETURN 1
	ENDIF
ELSE
	LOCAL:4 = MONEY / LOCAL:3
	IF LOCAL:4 < 100000
		LOCAL:4 = 100000
		LOCAL:3 = 1
		SIF LOCAL:1 == 0
			RETURN 1
	ENDIF
ENDIF
;CFLAG:LOCAL:上司イベント進行度が6の場合は最終段階へ
IF LOCAL:5 > 0
	IF CFLAG:LOCAL:상사이벤트진행도 == 10
		LOCAL:3 = 10
	ENDIF
ENDIF
IF LOCAL:3 == 10
	PRINTFORML 
	PRINTFORML 
	PRINTFORMW 팬텀 소사이어티 간부 남자가 찾아왔다
	PRINTFORML 
	PRINTFORML 『요전에 네놈이 조직의 정보를 외부에 유출하고 있다는 정보가 들어와서 말이지』
	PRINTFORML 『네놈을 좋지 않게 보는 녀석들이 처리하라고 입을 모으기 시작했단 말이다』
	PRINTFORML 『나도 이런 하찮은 일로 우수한 장기말을 잃고 싶지 않으니, 무마 작업을 맡아주지』
	LOCAL:4 = MONEY
	TIMES LOCAL:4,0.9
	LOCAL:4 = LIMIT(LOCAL:4 , 1000000, LOCAL:4)
	PRINTFORM 『뭐, ￥
	SETCOLOR COLOR("RED")
	PRINTFORM ￥{LOCAL:4}
	RESETCOLOR
	PRINTFORMW 정도면 충분하겠지만, 뭐 금액이 금액이니』
	PRINTFORM 『없다면… 
	SETCOLOR COLOR("dark-pink")
	PRINTFORM %CALLNAME:LOCAL%
	RESETCOLOR
	PRINTFORMW 을(를) 조수로서 빌려볼까』
ELSE
	PRINTFORML 
	PRINTFORML 
	PRINTFORMW 팬텀 소사이어티 간부 남자가 찾아왔다
	PRINTFORML 
	PRINTFORML 『흥, 여전히 거슬리는 면상이로군』
	PRINTFORMW 『급히 재계 인사를 대접하게 되어서 말이지, 네놈도 협력해 줘야겠다』
	PRINTFORML 
	IF (MONEY:1 * 50) > MONEY * 2
		PRINTFORM 『
		SETCOLOR COLOR("RED")
		PRINTFORM {LOCAL:4} 마카
		RESETCOLOR
		PRINTFORMW 정도 융통해 주실까』
	ELSE
		PRINTFORM 『
		SETCOLOR COLOR("RED")
		PRINTFORM ￥{LOCAL:4}
		RESETCOLOR
		PRINTFORMW 정도 융통해 주실까』
	ENDIF
	IF LOCAL:3 < 5
		PRINTFORML 『무리라면, 그렇군…』
		PRINTFORMW 남자의 시선이 %CALLNAME:MASTER%의 뒤를 향한다
		PRINTFORML 
		;目をつけられた場合
		IF CFLAG:LOCAL:상사이벤트진행도 > 0
			PRINTFORM 『대신 
			SETCOLOR COLOR("dark-pink")
			PRINTFORM %CALLNAME:LOCAL%
			RESETCOLOR
			PRINTFORML 을(를) 맡겨 주실까』
			PRINTFORMW 『지난번에 호평이었거든, 큭큭큭』
		;通常
		ELSE
			PRINTFORML 『대신 그 여자를 맡겨 주실까』
			PRINTFORM 히죽거리며 웃음을 띄우고, 
			SETCOLOR COLOR("dark-pink")
			PRINTFORM %CALLNAME:LOCAL%
			RESETCOLOR
			PRINTFORML 을(를) 핥듯이 바라보고 있다
			PRINTFORML 
			PRINTFORML 『그 미모라면 꽤나 쓸모가 있겠군, 크크큭』
		ENDIF
	ENDIF
ENDIF
PRINTFORML 
IF LOCAL:3 == 2 || LOCAL:3 == 10
	PRINTFORM 어떻게 하겠습니까?　　　소지금:￥{MONEY}　　{MONEY:1}마카　　　
	PRINTFORM %CALLNAME:LOCAL%　
	IF (위험일(LOCAL)) == 2
		SETCOLOR 0xCC33FF
		CALL HEARTB
		PRINTFORM 발정중
		CALL HEARTB
		RESETCOLOR
	ELSEIF (위험일(LOCAL)) == 1
		SETCOLOR 0xCC33FF
		CALL HEARTB
		PRINTFORM 위험일
		CALL HEARTB
		RESETCOLOR
	ELSE
		PRINTFORM 
	ENDIF
	PRINTFORMW 
ELSE
	PRINTFORMW 어떻게 하겠습니까?　　　소지금:￥{MONEY}　　{MONEY:1}마카
ENDIF

IF LOCAL:3 == 10
	IF MONEY < 1000000
		CALL INPUT_SELECT(2, "여자를 맡긴다")
	ELSE
		CALL INPUT_SELECT(1, "지불한다",2, "여자를 맡긴다")
	ENDIF
ELSEIF LOCAL:3 == 2
	CALL INPUT_SELECT(1, "지불한다",2, "여자를 맡긴다", 3, "거절한다")
ELSEIF LOCAL:3 == 1
	CALL INPUT_SELECT(2, "여자를 맡긴다", 3, "거절한다")
ELSE
	CALL INPUT_SELECT(1, "지불한다", 3, "거절한다")
ENDIF
SELECTCASE RESULT
	CASE 1
		IF (MONEY:1 * 50) > MONEY * 2
			MONEY:1 -= LOCAL:4
			PRINTFORMW {LOCAL:4} 마카를 지불했다
		ELSE
			MONEY -= LOCAL:4
			PRINTFORMW ￥{LOCAL:4}을(를) 지불했다
		ENDIF
		IF LOCAL:3 == 10
			PRINTFORML 『오오, 확실히 받았다』
			PRINTFORML 『뒷일은 내게 맡겨둬라』
			PRINTFORMW 남자는 입금을 확인하자 빠른 걸음으로 떠나갔다
			FLAG:상사내습률 = 0
			CFLAG:LOCAL:상사이벤트진행도 = 0
		ELSE
			PRINTFORML 
			PRINTFORML 『제법 말귀가 잘 통하는 녀석이군』
			PRINTFORML 『앞으로도 네놈 나름대로 조직에 도움이 되도록』
			PRINTFORMW 남자는 깔아보며 내뱉고는 떠나갔다
			FLAG:상사내습률 = FLAG:상사내습률 / 3
				;10％の確率で上司のターゲットから外れる
			IF RAND:100 < 10 && LOCAL:3 == 2 && CFLAG:LOCAL:상사이벤트진행도 > 0
				PRINTFORMW %CALLNAME:LOCAL%은(는) %CALLNAME:MASTER%에게 살며시 안기며 위로하고 있다
				CFLAG:LOCAL:상사이벤트진행도 = 0
			ENDIF
				;CFLAG:上司イベント進行度がある場合は10％の確率で3段階目に移行する
			IF RAND:100 < 10 && LOCAL:3 == 2 && CFLAG:LOCAL:상사이벤트진행도 < 7
				PRINTFORMW %CALLNAME:LOCAL%은(는) %CALLNAME:MASTER%을(를) 걱정스럽게 바라보고 있다
				PRINTFORMW 그리고, 간부 남자에게 은밀히 건네받은 메모를 꽉 쥐었다…
				CFLAG:LOCAL:상사이벤트진행도 = 7
			ENDIF
		ENDIF
	CASE 2
		IF LOCAL:3 == 10
			PRINTFORML 
			PRINTFORML 『그런가, 그럼 맡아두도록 하지… 조수로서 말이다』
			PRINTFORML 『사태 수습에는 하룻밤이면 충분하겠지』
			PRINTFORML 『그럼 이만… 기대하고 있어라』
			PRINTFORMW %CALLNAME:LOCAL%은(는) 슬픈 표정으로 남자에게 끌려갔다
		ELSEIF CFLAG:LOCAL:상사이벤트진행도 > 3 && CFLAG:LOCAL:상사이벤트진행도 <= 6
			PRINTFORML 
			PRINTFORMW %CALLNAME:MASTER%이(가) %CALLNAME:LOCAL%을(를) 맡기겠다고 하자, 남자는 씩 입꼬리를 올렸다
			PRINTFORML 『크큭, 그럼 맡아두도록 하지』
			PRINTFORML 『뭐, 내일 아침까지는 돌려보내 주마』
			PRINTFORMW 『그건 그렇고…』
			IF TALENT:LOCAL:거유 || TALENT:LOCAL:폭유 || TALENT:LOCAL:마유
				PRINTFORML 남자는 %CALLNAME:LOCAL%의 등 뒤로 돌아가더니
				PRINTFORML 풍만한 가슴을 마구 주무르며 %CALLNAME:LOCAL%의 가랑이에 손을 뻗어 애무하기 시작했다…
				PRINTFORML 남자의 격렬한 손놀림에 %CALLNAME:LOCAL%은(는) 허리에 힘이 풀려 다리가 금방이라도 무너질 듯 떨리고 있다
				PRINTFORMW 『하하하핫, 여전히 음란한 몸이군… 이 정도면 이번 거래처도 만족하겠어』
			ELSE
				PRINTFORML 남자는 %CALLNAME:LOCAL%을(를) 끌어안고 %CALLNAME:LOCAL%의 입술에 키스하면서
				PRINTFORML %CALLNAME:LOCAL%의 가랑이를 희롱하기 시작했다…
				PRINTFORML %CALLNAME:LOCAL%은(는) 남자의 노련한 손놀림에 농락당해 황홀해진 얼굴로 남자의 입술을 빨아대고 있다
				PRINTFORMW 『크큭, 여전히 감도 좋은 몸이군… 이 정도면 이번 거래처도 만족하겠어』
			ENDIF
			PRINTFORML 
			PRINTFORMW %CALLNAME:LOCAL%은(는) 쾌락으로 풀려버린 몸을 질질 끌리며 남자에게 데려가졌다
		ELSEIF CFLAG:LOCAL:상사이벤트진행도 > 6
				;セックス系
			IF RAND:2 == 0
				PRINTFORML 
				PRINTFORMW %CALLNAME:MASTER%이(가) %CALLNAME:LOCAL%을(를) 맡기겠다고 하자, 남자는 씩 입꼬리를 올렸다
				PRINTFORML 『크큭, 그럼 맡아두도록 하지』
				PRINTFORML 『뭐, 내일 아침까지는 돌려보내 주마』
				PRINTFORMW 『그건 그렇고…』
				IF TALENT:LOCAL:거유 || TALENT:LOCAL:폭유 || TALENT:LOCAL:마유
					PRINTFORML 남자는 %CALLNAME:LOCAL%의 등 뒤로 돌아가 지퍼를 내리고 페니스를 꺼내더니
					PRINTFORML %CALLNAME:LOCAL%의 풍만한 가슴을 주무르며 %CALLNAME:LOCAL%의 속옷을 젖히고 질 내로 삽입했다
					PRINTFORML %CALLNAME:LOCAL%은(는) 갑작스러운 충격에 눈을 굴리며 헐떡이고 있다
					PRINTFORMW 『하하핫, 여전히 기막힌 구멍이군, 그쪽에서 안달하는 것도 이해가 가』
					PRINTFORMW 
					PRINTFORMW %CALLNAME:LOCAL%은(는) 남자에게 뒤에서 꿰뚫리며 풍만한 가슴을 크게 흔들며 풀어진 표정을 짓고 있다
					PRINTFORMW 남자가 한층 더 강하게 찌르자 %CALLNAME:LOCAL%이(가) 환희의 비명을 질렀고, 남자와 %CALLNAME:LOCAL%의 결합부에서 대량의 정액이 흘러넘쳤다…
					PRINTFORMW 『이런, 너무 기분이 좋아서 그만 안에 싸버렸군』
					PRINTFORMW 『뭐, 딱히 임신시켜도 상관없겠지…?』
					PRINTFORML 
					PRINTFORMW 
					PRINTFORMW 『크크큭, 좀 더 맛보고 싶지만 슬슬 가봐야겠군』

;						PRINTFORMW 『クククッ、どうやら%CALLNAME:LOCAL%クンはあまりに気持ち良くて腰を抜かしてしまったようだな』
;						PRINTFORMW 『私がこのまま今日の会場まで連れて行ってやるとするよ』
				ELSE
					PRINTFORML 남자는 %CALLNAME:LOCAL%을(를) 끌어안아 입술을 빼앗더니 지퍼를 내리고 페니스를 꺼내 %CALLNAME:LOCAL%의 비부에 대고
					PRINTFORML 키스로 멍해진 %CALLNAME:LOCAL%의 비부를 아래에서 단숨에 찔러 올렸다
					PRINTFORMW %CALLNAME:LOCAL%은(는) 남자에게 들려 안긴 채 범해지며 소리도 나오지 않는 비명을 지르고 있다
					PRINTFORMW 『역시 %CALLNAME:LOCAL% 군의 몸은 매력적이란 말이지, 그만 네놈 앞에서 덮쳐버렸군』
					PRINTFORMW 
					PRINTFORMW %CALLNAME:LOCAL%은(는) 떨어지지 않도록 남자의 허리에 다리를 감으며 남자와 열렬한 키스를 나누고 있다
					PRINTFORMW 남자는 몇 번 격렬하게 찔러 올린 뒤, %CALLNAME:LOCAL%을(를) 강하게 껴안고 그 자세 그대로 사정하기 시작했다
					PRINTFORMW %CALLNAME:LOCAL% 역시 남자의 목에 팔을 두르고 허리에 감은 다리에 힘을 주었다
					PRINTFORMW 여운에 젖은 %CALLNAME:LOCAL%과 남자의 결합부에서 대량의 정액이 흘러내려 바닥에 하얀 웅덩이를 만들고 있다
					PRINTFORML 
					PRINTFORMW 
					PRINTFORMW 『크크큭, 좀 더 맛보고 싶지만 슬슬 가봐야겠군』

;						PRINTFORMW 『クククッ、どうやら%CALLNAME:LOCAL%クンはあまりに気持ち良くて腰を抜かしてしまったみたいでな』
;						PRINTFORMW 『私がこのまま今日の会場まで連れて行ってやるとするよ』
				ENDIF
				PRINTFORML 
				PRINTFORMW 흐트러진 옷차림을 능숙한 솜씨로 정돈하더니, %CALLNAME:LOCAL%은(는) %CALLNAME:MASTER%을(를) 거들떠보지도 않고 남자를 따라 방을 나갔다

;					PRINTFORMW %CALLNAME:LOCAL%は男と恋人のように交わったまま連れられていった
				;奉仕系
			ELSE
				PRINTFORML 
				PRINTFORMW %CALLNAME:MASTER%이(가) %CALLNAME:LOCAL%을(를) 맡기겠다고 하자, 남자는 씩 입꼬리를 올렸다
				PRINTFORML 『크큭, 그럼 맡아두도록 하지』
				PRINTFORMW 『뭐, 내일 아침까지는 돌려보내 주마』
				PRINTFORML 
				PRINTFORMW 『그건 그렇고…』
				PRINTFORML 『%CALLNAME:LOCAL% 군의 실력은 녹슬지 않았겠지?』
				PRINTFORML 『크큭, 중요한 접대다… 실수라도 있으면 곤란하지…』
				PRINTFORMW 능청스러운 말과 함께 남자가 %CALLNAME:LOCAL%의 몸을 핥듯이 쳐다본다
				PRINTFORML 
				IF RAND:2 == 0 && (TALENT:LOCAL:거유 || TALENT:LOCAL:폭유 || TALENT:LOCAL:마유)
					PRINTFORMW 그것만으로 의도를 눈치챈 %CALLNAME:LOCAL%은(는) 남자의 앞에 무릎 꿇더니 익숙한 손놀림으로 페니스를 꺼내 물기 시작했다
					PRINTFORML 『하핫, 미안하군, %CALLNAME:LOCAL% 군』
					PRINTFORMW 『오오… 이 혀놀림, 그쪽에서 푹 빠지는 것도 무리가 아니야』
					PRINTFORML 
					PRINTFORMW %CALLNAME:LOCAL%은(는) 입으로 봉사를 계속하며 가슴을 헤치더니 당연하다는 듯이 남자의 물건을 가슴 사이에 끼웠다
