	IF  GROUPMATCH(1, GET_STAIN("페니스", "愛液", TARGET), GET_STAIN("페니스", "모유", TARGET), GET_STAIN("페니스", "精液", TARGET), GET_STAIN("페니스", "破瓜の血", TARGET)) > 2
		PRINT 갖가지 체액으로 뒤덮힌 
	ELSEIF GET_STAIN("페니스", "愛液", TARGET)
		PRINT 애액투성이의 
	ELSEIF GET_STAIN("손", "精液", TARGET)
		PRINT 정액으로 질퍽질퍽하게 된 
	;セックス系を直前にしていないなら乱数分岐
	ELSEIF RAND:3 == 0
		PRINT 불끈 선 
	ELSEIF RAND:2 == 0 && TEQUIP:카테터 == 0
