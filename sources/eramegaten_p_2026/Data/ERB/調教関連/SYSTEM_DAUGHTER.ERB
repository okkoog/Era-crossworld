		ENDIF
		CFLAG:초기속옷（상） = GET_CLOTHESNUM(RAND_SPLIT("마이크로브라/브래지어/스포츠브라/레이스달린브래지어", "/"))
		CFLAG:초기속옷（하） = GET_CLOTHESNUM(RAND_SPLIT("스패츠/팬티/레이스달린팬티/줄무늬팬티", "/"))
		CFLAG:초기양말 = GET_CLOTHESNUM(RAND_SPLIT("양말/하이삭스/니삭스/가터스타킹", "/"))
		CFLAG:초기신발 = GET_CLOTHESNUM(RAND_SPLIT("펌프스/부츠/슈즈/샌들", "/"))
