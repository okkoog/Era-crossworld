		CFLAG:초기하의 = GET_CLOTHESNUM(RAND_SPLIT("미니스커트/숏팬츠/바지", "/"))
		CFLAG:초기속옷（상） = GET_CLOTHESNUM(RAND_SPLIT("마이크로브라/브래지어/스포츠브라/더미", "/"))
		CFLAG:초기속옷（하） = GET_CLOTHESNUM(RAND_SPLIT("트렁크스/팬티/레이스달린팬티", "/"))
		CFLAG:초기양말 = GET_CLOTHESNUM(RAND_SPLIT("양말/하이삭스/더미", "/"))
		CFLAG:초기신발 = GET_CLOTHESNUM(RAND_SPLIT("스니커/부츠/슈즈/가죽구두", "/"))
		CFLAG:초기겉옷 = GET_CLOTHESNUM(RAND_SPLIT("볼레로/후드집업/베스트/더미", "/"))
	;女
	ELSE
		CFLAG:초기모자 = GET_CLOTHESNUM(RAND_SPLIT("리본/모자/카츄샤/더미", "/"))
		IF RAND:2
			CFLAG:전신복 = GET_CLOTHESNUM(RAND_SPLIT("나가기/원피스/드레스/로브", "/"))
		ELSE
			CFLAG:초기옷 = GET_CLOTHESNUM(RAND_SPLIT("겉옷/세일러복/블라우스/탱크탑/캐미솔/터틀넥/T셔츠", "/"))
