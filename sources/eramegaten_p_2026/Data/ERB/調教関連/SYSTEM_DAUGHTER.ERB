;-------------------------------------------------------------
;初期変身悪魔の設定
;1.両親のいずれかが悪魔ならその悪魔になる
;2.両親のいずれかの初期リンク悪魔が設定されているのならその悪魔になる
;3.ランダム発現
;-------------------------------------------------------------
LINK_DEVIL_NUM = -1
IF GET_ROLE_PROP("CAN_USE_TRANS", TARGET)
	LINK_DEVIL_NO = -1
	FOR LCOUNT, 0, 2
		TRYCCALLFORM ROLE_HEREDITY_IS_TRANS_ABLE_%CSTR:롤%, FETUS_PALENT_NO:PALENT:LCOUNT
			SIF !RESULT
				CONTINUE
			CFLAG:초기링크악마 = FETUS_PALENT_NO:PALENT:LCOUNT
			BREAK
		CATCH
		ENDCATCH
	NEXT
	IF CFLAG:초기링크악마 <= 0
		;両方の場合は先に判定するほうで決まるのでどちらが先化かランダムにする
		TEMP = RAND:100 < 70 ? MAIN_PALENT # SUB_PALENT
		FOR LCOUNT, 0, 2
			SIF FETUS_初期リンク悪魔:PALENT:(LCOUNT ? !TEMP # TEMP) <= 0
				CONTINUE
			TRYCCALLFORM ROLE_HEREDITY_IS_TRANS_ABLE_%CSTR:롤%, FETUS_初期リンク悪魔:PALENT:LCOUNT
				SIF !RESULT
					CONTINUE
				CFLAG:초기링크악마 = FETUS_初期リンク悪魔:PALENT:LCOUNT
			CATCH
			ENDCATCH
		NEXT
	ENDIF
	;ここまでで決まっていなかったらマスター用のリンク悪魔からアライトメントが一致するものをあてる
	WHILE CFLAG:초기링크악마 <= 0 || !EXISTCSV(CFLAG:초기링크악마)
		LINK_DEVIL_NUM = RAND:50
		SIF !IS_ABLE_MASTER_LINK_DEVIL(LINK_DEVIL_NUM, TARGET)
			CONTINUE
		CALL SET_VAR_MASTER_LINK_DEVIL, LINK_DEVIL_NUM, LINK_DEVIL_NO, LINK_DEVIL_SKILL, LINK_DEVIL_LEARN, LINK_DEVIL_LEARN_LV, LINK_DEVIL_EXPLAIN
		SIF ABL:속성LC != CSVABL(LINK_DEVIL_NO, GETNUM(ABL, "속성LC"))
			CONTINUE
		SIF ABL:속성LD != CSVABL(LINK_DEVIL_NO, GETNUM(ABL, "속성LD"))
			CONTINUE
		CFLAG:초기링크악마 = LINK_DEVIL_NO
	WEND
	ABL:초기링크악마공격상성 = CSVABL(CFLAG:초기링크악마, GETNUM(ABL, "초기링크악마공격상성"))
	ABL:초기링크악마최저공격횟수 = CSVABL(CFLAG:초기링크악마, GETNUM(ABL, "초기링크악마최저공격횟수"))
	ABL:초기링크악마최대공격횟수 = CSVABL(CFLAG:초기링크악마, GETNUM(ABL, "초기링크악마최대공격횟수"))
	ABL:초기링크악마사거리 = CSVABL(CFLAG:초기링크악마, GETNUM(ABL, "초기링크악마사거리"))
	ABL:초기링크악마공격범위 = CSVABL(CFLAG:초기링크악마, GETNUM(ABL, "초기링크악마공격범위"))
	ABL:초기링크악마추가효과 = CSVABL(CFLAG:초기링크악마, GETNUM(ABL, "초기링크악마추가효과"))
	ABL:초기링크악마추가효과상성 = CSVABL(CFLAG:초기링크악마, GETNUM(ABL, "초기링크악마추가효과상성"))
	ABL:초기링크악마추가효과명중률 = CSVABL(CFLAG:초기링크악마, GETNUM(ABL, "초기링크악마추가효과명중률"))
	ABL:초기링크악마추가효과최대명중률 = CSVABL(CFLAG:초기링크악마, GETNUM(ABL, "초기링크악마추가효과최대명중률"))
ENDIF

;-------------------------------------------------
;体力・気力の設定
;~2000:1づつ、2000~10000, 0.25づつ,10000~0.1づつの傾斜で親の数値を取る
;7:3であわせてから、0.8 ~ 1.2倍
;-------------------------------------------------
TEMP = MIN(FETUS_体力:PALENT:MAIN_PALENT,2000)
TEMP += LIMIT(FETUS_体力:PALENT:MAIN_PALENT - 2000, 0, 8000) / 4 
TEMP += MAX(FETUS_体力:PALENT:MAIN_PALENT - 10000, 0) / 10
TEMP:1 = LIMIT(FETUS_体力:PALENT:SUB_PALENT, 600, 2000)
TEMP:1 += LIMIT(FETUS_体力:PALENT:SUB_PALENT - 2000, 0, 8000) / 4 
TEMP:1 += MAX(FETUS_体力:PALENT:SUB_PALENT - 10000, 0) / 10
MAXBASE:체력 = (TEMP * 70  + TEMP:1 * 30) * RAND(80, 121) / 100 / 100
;下二桁の切り捨て処理
MAXBASE:체력 = MAX(MAXBASE:체력 / 100, 10) * 100

TEMP = MIN(FETUS_気力:PALENT:MAIN_PALENT,2000)
TEMP += LIMIT(FETUS_気力:PALENT:MAIN_PALENT - 2000, 0, 8000) / 4 
TEMP += MAX(FETUS_気力:PALENT:MAIN_PALENT - 10000, 0) / 10
TEMP:1 = LIMIT(FETUS_気力:PALENT:SUB_PALENT, 600, 2000)
TEMP:1 += LIMIT(FETUS_気力:PALENT:SUB_PALENT - 2000, 0, 8000) / 4 
TEMP:1 += MAX(FETUS_気力:PALENT:SUB_PALENT - 10000, 0) / 10
MAXBASE:기력 = (TEMP * 70  + TEMP:1 * 30) * RAND(80, 121) / 100 / 100
MAXBASE:기력 = MAX(MAXBASE:기력 / 100, 10) * 100

BASE:체력 = MAXBASE:체력
BASE:기력 = MAXBASE:기력

;-------------------------------------------------
;基本ステータスの設定
;-------------------------------------------------
BASE:LV = 1
BASE:ＥＸＰ = 0
BASE:TARGET:ＭＡＧ = 0

BASE:TARGET:충성도 = LIMIT((FETUS_忠誠度:PALENT:MAIN_PALENT * 3 + FETUS_忠誠度:PALENT:SUB_PALENT * 2) / 10, FETUS_従順:PALENT:MAIN_PALENT * 70 + FETUS_従順:PALENT:SUB_PALENT * 30, FETUS_従順:PALENT:MAIN_PALENT * 350 + FETUS_従順:PALENT:SUB_PALENT * 150)
CALL CONTROL_LOYALTY, TARGET, FETUS_忠誠度:PALENT:MAIN_PALENT * 3

FOR LCOUNT, 1, BASESTATUSNUM
	BASE:GET_BASESTATUS(LCOUNT) = 3
NEXT

;-------------------------------------------------
;MAG強化引継ぎ
;似ている方の親の30%　似ていない方の親20%、教育者の10%
;-------------------------------------------------
FOR LCOUNT, 1, BASESTATUSNUM
	CFLAG:(GET_BASESTATUS(LCOUNT) + "강화횟수") += TOINT(AUTO_SPLIT(FETUS_MAG強化:PALENT:MAIN_PALENT, "/", LCOUNT -1)) * 3
	CFLAG:(GET_BASESTATUS(LCOUNT) + "강화횟수") += TOINT(AUTO_SPLIT(FETUS_MAG強化:PALENT:SUB_PALENT, "/", LCOUNT -1)) * 2
	;教育がONのときは育ての親が教育者となっている
	SIF CFLAG:PALENT:딸교육 > 0
		CFLAG:(GET_BASESTATUS(LCOUNT) + "강화횟수") += CFLAG:PALENT:(GET_BASESTATUS(LCOUNT) + "강화횟수")
	CFLAG:(GET_BASESTATUS(LCOUNT) + "강화횟수") /= 10
	CFLAG:능력강화횟수 += CFLAG:(GET_BASESTATUS(LCOUNT) + "강화횟수")
NEXT

;-------------------------------------------------
;防御相性の決定
;-------------------------------------------------
VARSET APPARENT_TYPE, 100
VARSET INAPPARENT_TYPE, 100

IF ABL:종족 != GET_RACE_NUM("인간")
	;両親の数値を70%と30%の確率で潜在と顕在に振り分けていく
	;反射は数値の扱いの関係で一旦-100になおす
	FOR LCOUNT, 0, TYPENUM - 1
		APPARENT_TYPE:LCOUNT = TOINT(AUTO_SPLIT(FETUS_防御相性:PALENT:MAIN_PALENT, "/", LCOUNT))
		APPARENT_TYPE:LCOUNT = APPARENT_TYPE:LCOUNT == 999 ? -100 # APPARENT_TYPE:LCOUNT
		INAPPARENT_TYPE:LCOUNT = TOINT(AUTO_SPLIT(FETUS_防御相性:PALENT:SUB_PALENT, "/", LCOUNT))
		INAPPARENT_TYPE:LCOUNT = INAPPARENT_TYPE:LCOUNT == 999 ? -100 # INAPPARENT_TYPE:LCOUNT
		SIF RAND:100 < 70
			SWAP APPARENT_TYPE:LCOUNT, INAPPARENT_TYPE:LCOUNT
	NEXT

	;最大で5回、相性の変化が入る。100％の相性は変化しないし、弱点と耐性が入れ替わることもない
	FOR LCOUNT, 0, 5
		TEMP = RAND:(TYPENUM - 1)
		SELECTCASE RAND:100
			CASE IS < 5
				APPARENT_TYPE:TEMP -= (APPARENT_TYPE:TEMP-100) * 100 / 100
			CASE IS < 25
				APPARENT_TYPE:TEMP -= (APPARENT_TYPE:TEMP-100) * 50 / 100
			CASE IS < 45
				APPARENT_TYPE:TEMP += (APPARENT_TYPE:TEMP-100) * 50 / 100
			CASE IS < 50
				APPARENT_TYPE:TEMP += (APPARENT_TYPE:TEMP-100) * 100 / 100
		ENDSELECT
	NEXT

	COUNT_HAVE_WEAK = 0
	COUNT_HAVE_RESIST = 0
	;範囲外の数値をまるめつつ、無効以上・弱点の数をカウント
	FOR LCOUNT, 0, TYPENUM-1
		IF CHECK_WEAKNESS(APPARENT_TYPE:LCOUNT) > 0
			COUNT_HAVE_WEAK++
		ELSEIF CHECK_WEAKNESS(APPARENT_TYPE:LCOUNT) < -1
			COUNT_HAVE_RESIST++
		ENDIF
		SELECTCASE APPARENT_TYPE:LCOUNT
			CASE IS > 999
				APPARENT_TYPE:LCOUNT = 995
			CASE IS < -99
				APPARENT_TYPE:LCOUNT = 999
			CASE 101 TO 104
				APPARENT_TYPE:LCOUNT = 105
		ENDSELECT
	NEXT

	;弱点が（無効以上の1.5倍）個以下の場合、2～4個になるまで発現していない親の弱点を追加
	;潜在弱点の最低値が100以下になったら付与しきったとみなす
	WHILE COUNT_HAVE_WEAK < LIMIT(COUNT_HAVE_RESIST * 150 / 100, 2, 4)
		TEMP = RAND:(TYPENUM -1)
		;付与できる潜在弱点がある
		IF MINARRAY(INAPPARENT_TYPE) > 100
			IF CHECK_WEAKNESS(INAPPARENT_TYPE:TEMP) > 0
				;通常以下
				SIF CHECK_WEAKNESS(APPARENT_TYPE:TEMP) <= 0
					APPARENT_TYPE:TEMP = INAPPARENT_TYPE:TEMP
				;使った潜在耐性は100にしておく
				INAPPARENT_TYPE:TEMP = 100
			ENDIF
		;潜在弱点が足りない場合はランダムで発現させる
		ELSE
			SIF CHECK_WEAKNESS(APPARENT_TYPE:TEMP) > 0
				CONTINUE
			APPARENT_TYPE:TEMP = 100 + 25 * RAND(1, 5)
		ENDIF
		;弱点・耐性数のチェック
		COUNT_HAVE_WEAK = 0
		COUNT_HAVE_RESIST = 0
		FOR LCOUNT, 0, TYPENUM -1
			SIF CHECK_WEAKNESS(APPARENT_TYPE:LCOUNT) > 0
				COUNT_HAVE_WEAK++
			SIF CHECK_WEAKNESS(APPARENT_TYPE:LCOUNT) < -1
				COUNT_HAVE_RESIST++
		NEXT
	WEND

	FOR LCOUNT, 0, TYPENUM
		;端数処理
		APPARENT_TYPE:TEMP = APPARENT_TYPE:TEMP / 5 * 5
		BASE:GET_TYPE(LCOUNT) = APPARENT_TYPE:LCOUNT
	NEXT
	;万能は100確定
	BASE:만능 = 100
ELSE
	;人間の場合、似ている親が人間なら相性を引きうつす
	;---- EDIT 035 MOD START -------------------------
	IF FETUS_PALENT_RACE:PALENT:MAIN_PALENT == GET_RACE_NUM("인간")
	;---- EDIT 035 MOD END ---------------------------
		FOR LCOUNT, 0, TYPENUM
			BASE:GET_TYPE(LCOUNT) = TOINT(AUTO_SPLIT(FETUS_防御相性:PALENT:MAIN_PALENT, "/", LCOUNT))
		NEXT
	;違うのなら人間デフォに
	ELSE
		FOR LCOUNT, 0, TYPENUM
			BASE:GET_TYPE(LCOUNT) = 100
			BASE:파마 = 0
		NEXT
	ENDIF
ENDIF

;-------------------------------------------------
;バステ耐性の決定　70％で似ている親から、30％で似てない親から受け継ぐ
;-------------------------------------------------
FOR LCOUNT, 0, BADSTATENUM
	IF RAND:100 >= 30
		BASE:GET_STATE(LCOUNT) = TOINT(AUTO_SPLIT(FETUS_バステ耐性:PALENT:MAIN_PALENT, "/", LCOUNT))
	ELSE
		BASE:GET_STATE(LCOUNT) = TOINT(AUTO_SPLIT(FETUS_バステ耐性:PALENT:SUB_PALENT, "/", LCOUNT))
	ENDIF
NEXT

;-------------------------------------------------
;継承素質の継承
;似た親が65% 似てない親が25% ランダム発現が10%
;-------------------------------------------------
;引継ぎ保証用のストック
FOR LCOUNT, GETNUM(TALENT, "검격"), GETNUM(TALENT, "만능") + 1
	SELECTCASE RAND:100
		CASE IS < 65
			SIF COUNT_SPLIT(FETUS_TALENT:PALENT:MAIN_PALENT, "/", @"%TALENTNAME:LCOUNT%_\\d*") > 0
				TALENT:LCOUNT = 1
		CASE IS < 90
			SIF COUNT_SPLIT(FETUS_TALENT:PALENT:SUB_PALENT, "/", @"%TALENTNAME:LCOUNT%_\\d*") > 0
				TALENT:LCOUNT = 1
		CASEELSE
			TALENT:LCOUNT = 1
	ENDSELECT
NEXT

;-------------------------------------------------
;肉体部位・特徴などの継承
;-------------------------------------------------
;肉体部位の継承 似ている方の親のは確定、似ていない方は1/3の確率で追加判定
FOR LCOUNT, GETNUM(TALENT, "머리"), GETNUM(TALENT, "검격")
	SIF COUNT_SPLIT(FETUS_TALENT:PALENT:MAIN_PALENT, "/", @"%TALENTNAME:LCOUNT%_\\d*") > 0
		TALENT:LCOUNT = 1
	SIF COUNT_SPLIT(FETUS_TALENT:PALENT:SUB_PALENT, "/", @"%TALENTNAME:LCOUNT%_\\d*") > 0 && !RAND:3
		TALENT:LCOUNT = 1
NEXT

;-------------------------------------------------
;容姿の継承
;-------------------------------------------------
BASE:신장 = FETUS_MOTHER_FOUR_SIZE:PALENT:0
BASE:바스트 = FETUS_MOTHER_FOUR_SIZE:PALENT:1
BASE:웨스트 = FETUS_MOTHER_FOUR_SIZE:PALENT:2
BASE:힙사이즈 = FETUS_MOTHER_FOUR_SIZE:PALENT:3
FETUS_MOTHER_FOUR_SIZE:PALENT:0 = BASE:(PALENT:0):신장 > 0 && BASE:(PALENT:0):바스트 > 0 && BASE:(PALENT:0):웨스트 > 0 && BASE:(PALENT:0):힙사이즈 > 0
IF IS_LOOKSLIKE_MALE(TARGET)
	IF BASE:신장 > 0
		BASE:신장 = BASE:신장 - 10 + RAND(15)
		SIF BASE:신장 < 165 && !TALENT:유아체형
			BASE:신장 = 165 + RAND(10)
	ENDIF
ELSE
	IF MINARRAY(FETUS_MOTHER_FOUR_SIZE:PALENT:0) > 0
		BASE:신장 = BASE:신장 - 10 + RAND(15)
		SIF BASE:신장 < 150 && !TALENT:유아체형
			BASE:신장 = 150 + RAND(5)
		BASE:바스트 = MIN(BASE:바스트 , BASE:신장 * 3 / 5) - 5 + RAND(9)
		BASE:웨스트 = BASE:웨스트 - 3 + RAND(7)
		BASE:힙사이즈 = BASE:힙사이즈 - 5 + RAND(9)
	ENDIF
ENDIF

;体重とウェストの計算
CALL CALC_TAIJU, TARGET
CALL DEFINITE_KOSINIKU, TARGET

;-------------------------------------------------
;スキル継承
;TABLE 0:最終結果　,1:1~3(初期スキル),　2:4~7 3:7~10, 4:11～15, 5:継承不能, 6:자동효과
;
;
;-------------------------------------------------
;隔世遺伝用にデータ保存と付与
FOR LCOUNT, 0, 2
	SIF FETUS_SKILL:PALENT:LCOUNT != ""
		CHILD_PALENTS_SKILL:0 = %ADD_SPLIT(CHILD_PALENTS_SKILL:0, "/", FETUS_SKILL:PALENT:LCOUNT)%
NEXT

VARSET SKILL_TABLE
VARSET TRANS_SKILL_TABLE
;---- EDIT 033 ADD START -------------------------
VARSET INAPPARENT_SKILL_TABLE
VARSET INAPPARENT_TRANS_SKILL_TABLE
;---- EDIT 033 ADD END ---------------------------

;ランクの取得(スキル使用能力あるいはスキルチェンジ能力、達人と異能者持ちデビルシフター両方を拾おうとするとこうなる)
CAN_USE_SKILL_RANK:0 = MAX(GET_ROLE_PROP("CAN_USE_SKILL", TARGET, , "通常形態"), GET_SKILL_CHANGEABLE_RANK(TARGET, "通常形態"))
;変身できる場合
IF GET_ROLE_PROP("CAN_USE_TRANS", TARGET)
	CAN_USE_SKILL_RANK:1 = MAX(GET_ROLE_PROP("CAN_USE_SKILL", TARGET, , "変身形態"), GET_SKILL_CHANGEABLE_RANK(TARGET, "変身形態"))
ELSE
	CAN_USE_SKILL_RANK:1 = 0
ENDIF

;配列わけ
FOR LCOUNT:2, 0, 2 + (CFLAG:PALENT:딸교육 == 1)
	FOR LCOUNT:1, 0, 2
		FOR IS_TRANS, 0, 2
			;人間形態同士→変身形態同士を先にチェックして、そのあと余ったスキルで逆パターンをチェック
			IF !LCOUNT:1
				IF IS_TRANS
					IS_SET_TO_TRANS = 1
				ELSE
					IS_SET_TO_TRANS = 0
				ENDIF
			ELSE
				IF IS_TRANS
					IS_SET_TO_TRANS = 0
				ELSE
					IS_SET_TO_TRANS = 1
				ENDIF
			ENDIF
			;セット先が変身の場合、変身出来ないなら終わる
			SIF IS_SET_TO_TRANS && !GET_ROLE_PROP("CAN_USE_TRANS", TARGET)
				CONTINUE
			;遺伝スキルのプールが空から終わる
			SIF FETUS_SKILL:PALENT:IS_TRANS == ""
				CONTINUE
			FOR LCOUNT, LCOUNT:2 == 2 ? 4 # STRCOUNT(FETUS_SKILL:PALENT:IS_TRANS, "/"), -1, -1
				;教育者は所持スキルをランダムに4回を2周
				IF LCOUNT:2 == 2
					SIF TALENT:PALENT:페르소나구사자
						CONTINUE
					SIF GET_ROLE_PROP("CAN_USE_MANTRA", PALENT, ,\@IS_TRANS ? 変身形態 # 通常形態\@)
						CONTINUE
					IF IS_TRANS
						L_SKILLS = {ABL:PALENT:RAND(GETNUM(ABL, "초기변신악마스킬1"), GETNUM(ABL, "초기변신악마스킬1") + GET_ROLE_PROP("CHANGEABLE_SKILLCOUNT", PALENT, , "変身形態") + 1)}
					ELSE
						L_SKILLS = {ABL:PALENT:RAND(GETNUM(ABL, "스킬1"), GETNUM(ABL, "스킬1") + GET_ROLE_PROP("CHANGEABLE_SKILLCOUNT", PALENT, , "通常形態") + 1)}
					ENDIF
				ELSE
					L_SKILLS = %AUTO_SPLIT(FETUS_SKILL:PALENT:IS_TRANS, "/", LCOUNT)%
				ENDIF
				;削除用に置換前の名称をとっておく
				L_SKILLS:1 = %L_SKILLS%

				;CSTR専用スキルは現状では除外
				SIF TOINT(L_SKILLS) == 0 || IS_PU_SKILLNUM(TOINT(L_SKILLS))
					CONTINUE
				TABLE_RANK = 0
				CALL GETS_SKILL_PROP, "ロール専用", L_SKILLS, -1
				IF RESULT
					IF !STRCOUNT(GETS_ROLE_PROP("CAN_USE_SPECIAL_SKILL", TARGET, TRANS_MODE), RESULTS)
						;置換スキルがあるなら置き換える
						CALL GETS_SKILL_PROP, "置換スキル", L_SKILLS, -1
						IF RESULT
							TEMP = RESULT
							L_SKILLS:1 = %L_SKILLS%
							L_SKILLS = {TEMP}
						ELSE
							CONTINUE
						ENDIF
					ENDIF
				ENDIF
				CALL GETS_SKILL_PROP, "継承不能", L_SKILLS, -1
				;教育者は継承不能スキルを扱えない
				IF RESULT
					IF RESULT > 1 || (LCOUNT:2 == 2 && RESULT > 0)
						;置換スキルがあるなら置き換える
						CALL GETS_SKILL_PROP, "置換スキル", L_SKILLS, -1
						IF RESULT
							FETUS_SKILL:PALENT:IS_TRANS = %DEL_SPLIT(FETUS_SKILL:PALENT:IS_TRANS, "/", L_SKILLS)%
							L_SKILLS = {RESULT}
						ELSE
							CONTINUE
						ENDIF
					ENDIF
					TABLE_RANK = 5
				ELSE
					CALL GETS_SKILL_PROP, "SKILL_EFECT", L_SKILLS, -1
					IF GET_SKILL_EFFECT(RESULT) == "자동효과"
						TABLE_RANK = 6
					ELSE
						CALL GETS_SKILL_PROP, "SKILL_RANK", L_SKILLS, -1
						SIF LCOUNT:2 == 2 && !INRANGE(RESULT, 1, 15)
							CONTINUE
						SELECTCASE RESULT
							CASE 1 TO 3
								TABLE_RANK = 1
							CASE 4 TO 7
								TABLE_RANK = 2
							CASE 7 TO 10
								TABLE_RANK = 3
							CASE 11 TO 15
								TABLE_RANK = 4
							CASEELSE
								TABLE_RANK = 5
						ENDSELECT
					ENDIF
				ENDIF
				;一周目で自動効果以外は継承素質チェック
				;二周目は継承素質不問だがすでに2個入ってる場所には入れない
				IF TABLE_RANK != 6
					;スキル使用能力がない場合は自動効果以外弾く
					SIF CAN_USE_SKILL_RANK:IS_SET_TO_TRANS < 2
						CONTINUE
					;一周目は素質をチェックを行い、二周目では省く
					IF LCOUNT:2 == 0
						CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", TOINT(L_SKILLS), TARGET
						;範囲外=素質存在なし
						SIF !INRANGE(RESULT, 0, SUCCESSIONNUM - 1)
							CONTINUE
						IF !IS_SET_TO_TRANS
							SIF !TALENT:GET_SUCCESSION(RESULT)
								CONTINUE
						ELSE
							SIF !CSVTALENT(CFLAG:초기링크악마, GETNUM(TALENT, GET_SUCCESSION(RESULT)))
								CONTINUE
						ENDIF
					ENDIF
				ENDIF
				;ここまで抜けてきたらテーブルにしまう
				IF !IS_SET_TO_TRANS
					;2周目は潜在テーブルに入れる
					IF LCOUNT:2
						SIF COUNT_SPLIT(INAPPARENT_SKILL_TABLE:TABLE_RANK, "/", L_SKILLS)
							CONTINUE
						INAPPARENT_SKILL_TABLE:TABLE_RANK = %ADD_SPLIT(INAPPARENT_SKILL_TABLE:TABLE_RANK, "/", L_SKILLS)%
						;PRINTFORMW INAPPARENT_SKILL_TABLE:{TABLE_RANK} = %INAPPARENT_SKILL_TABLE:TABLE_RANK%
					ELSE
						SIF COUNT_SPLIT(SKILL_TABLE:TABLE_RANK, "/", L_SKILLS)
							CONTINUE
						SKILL_TABLE:TABLE_RANK = %ADD_SPLIT(SKILL_TABLE:TABLE_RANK, "/", L_SKILLS)%
						;PRINTFORMW SKILL_TABLE:{TABLE_RANK} = %SKILL_TABLE:TABLE_RANK%
					ENDIF
				ELSE
					IF LCOUNT:2
						SIF COUNT_SPLIT(INAPPARENT_TRANS_SKILL_TABLE:TABLE_RANK, "/", L_SKILLS)
							CONTINUE
						INAPPARENT_TRANS_SKILL_TABLE:TABLE_RANK = %ADD_SPLIT(INAPPARENT_TRANS_SKILL_TABLE:TABLE_RANK, "/", L_SKILLS)%
					ELSE
						SIF COUNT_SPLIT(TRANS_SKILL_TABLE:TABLE_RANK, "/", L_SKILLS)
							CONTINUE
						TRANS_SKILL_TABLE:TABLE_RANK = %ADD_SPLIT(TRANS_SKILL_TABLE:TABLE_RANK, "/", L_SKILLS)%
					ENDIF
				ENDIF
				;しまったスキルは削除する
				IF LCOUNT:2 < 2
					WHILE COUNT_SPLIT(FETUS_SKILL:PALENT:IS_TRANS, "/", L_SKILLS:1)
						FETUS_SKILL:PALENT:IS_TRANS = %DEL_SPLIT(FETUS_SKILL:PALENT:IS_TRANS, "/", L_SKILLS:1)%
					WEND
				ENDIF
				;PRINTFORMW FETUS_SKILL:PALENT:IS_TRANS = %FETUS_SKILL:PALENT:IS_TRANS%
			NEXT
		NEXT
	NEXT
NEXT

;-------------------------------------------------
;初期スキルのテーブル追加
;-------------------------------------------------
;初期スキルテーブルの中身に基本スキルを追加する
IF CAN_USE_SKILL_RANK:0 > 1
	FOR LCOUNT, 0, SUCCESSIONNUM - 1
		SIF !TALENT:GET_SUCCESSION(LCOUNT)
			CONTINUE
		TEMP = SKILL_NUM_F(AUTO_SPLIT("산바람/싱글샷/숏잽/할퀴기/디아/라쿠・카쟈/테트라쟈/아기/부흐/지오/잔/포이즈마/해피루마/한마/무드/마그나/아쿠아/갈/그라이/기가", "/", LCOUNT))
		SIF COUNT_SPLIT(SKILL_TABLE:1, "/", TOSTR(TEMP))
			CONTINUE
		SKILL_TABLE:1 = %ADD_SPLIT(SKILL_TABLE:1, "/", TOSTR(TEMP))%
	NEXT
ENDIF
;初期スキルテーブルの中身に基本スキルを追加する
IF CAN_USE_SKILL_RANK:1 > 1
	FOR LCOUNT, 0, SUCCESSIONNUM - 1
		SIF !CSVTALENT(CFLAG:초기링크악마, GETNUM(TALENT, GET_SUCCESSION(LCOUNT)))
			CONTINUE
		TEMP = SKILL_NUM_F(AUTO_SPLIT("산바람/싱글샷/숏잽/할퀴기/디아/라쿠・카쟈/테트라쟈/아기/부흐/지오/잔/포이즈마/해피루마/한마/무드/마그나/아쿠아/갈/그라이/기가", "/", LCOUNT))
		SIF COUNT_SPLIT(TRANS_SKILL_TABLE:1, "/", TOSTR(TEMP))
			CONTINUE
		TRANS_SKILL_TABLE:1 = %ADD_SPLIT(TRANS_SKILL_TABLE:1, "/", TOSTR(TEMP))%
	NEXT
ENDIF

;-------------------------------------------------
;習得スキルの確定
;各レベル帯に顕在潜在の順に最大2個(初期スキルは4個)までランダムに詰めていく
;-------------------------------------------------
FOR LCOUNT:1, 0, 2
	FOR TABLE_RANK, 1, VARSIZE("SKILL_TABLE")
		FOR LCOUNT, 0, TABLE_RANK == 1 ? 4 # 2
			IF !LCOUNT:1
				SIF SKILL_TABLE:TABLE_RANK == ""
					BREAK
				TEMPS = %RAND_SPLIT(SKILL_TABLE:TABLE_RANK, "/")%
				SKILL_TABLE:TABLE_RANK = %DEL_SPLIT(SKILL_TABLE:TABLE_RANK, "/", TEMPS)%
			ELSE
				SIF INAPPARENT_SKILL_TABLE:TABLE_RANK == ""
					BREAK
				TEMPS = %RAND_SPLIT(INAPPARENT_SKILL_TABLE:TABLE_RANK, "/")%
				INAPPARENT_SKILL_TABLE:TABLE_RANK = %DEL_SPLIT(INAPPARENT_SKILL_TABLE:TABLE_RANK, "/", TEMPS)%
			ENDIF
			SKILL_TABLE:0 = %ADD_SPLIT(SKILL_TABLE:0, "/", TEMPS)%
		NEXT
	NEXT
NEXT
;テーブルの余りをまとめる
FOR TABLE_RANK, 2, VARSIZE("SKILL_TABLE")
	SIF SKILL_TABLE:TABLE_RANK  != ""
		SKILL_TABLE:1 = %ADD_SPLIT(SKILL_TABLE:1, "/", SKILL_TABLE:TABLE_RANK)%
	SIF INAPPARENT_SKILL_TABLE:TABLE_RANK  != ""
		INAPPARENT_SKILL_TABLE:1 = %ADD_SPLIT(INAPPARENT_SKILL_TABLE:1, "/", INAPPARENT_SKILL_TABLE:TABLE_RANK)%
NEXT

IF SKILL_TABLE:0 != ""
	FOR LCOUNT, 0, STRCOUNT(SKILL_TABLE:0, "/") + 1
		L_SKILLS = %AUTO_SPLIT(SKILL_TABLE:0, "/", LCOUNT)%
		CALL GETS_SKILL_PROP, "SKILL_RANK",L_SKILLS, -1
		IF INRANGE(RESULT, 1, 3)
			CALL SET_LEARN_SKILL, TARGET, L_SKILLS, 1, "通常形態"
		ELSE
			SIF !INRANGE(RESULT, 1, 15)
				RESULT = 15
			CALL SET_LEARN_SKILL, TARGET, L_SKILLS, RESULT * 4, "通常形態"
		ENDIF
	NEXT
ENDIF

;習得スキルに余りがある場合、残ったスキルで埋める
FOR LCOUNT, 0, 2
	WHILE FINDELEMENT(ABL:TARGET:0, 0, GETNUM(ABL, "스킬1"), GETNUM(ABL, "스킬20")) >= 0
		IF !LCOUNT
			SIF SKILL_TABLE:1 == ""
				BREAK
			L_SKILLS = %RAND_SPLIT(SKILL_TABLE:1, "/")%
			SKILL_TABLE:1 = %DEL_SPLIT(SKILL_TABLE:1, "/", L_SKILLS)%
		ELSE
			SIF INAPPARENT_SKILL_TABLE:1 == ""
				BREAK
			L_SKILLS = %RAND_SPLIT(INAPPARENT_SKILL_TABLE:1, "/")%
			INAPPARENT_SKILL_TABLE:1 = %DEL_SPLIT(INAPPARENT_SKILL_TABLE:1, "/", L_SKILLS)%
			;非潜在スキルの穴埋めは1/2の確率
			SIF RAND:2
				CONTINUE
		ENDIF
		CALL GETS_SKILL_PROP, "SKILL_RANK", L_SKILLS
		IF INRANGE(RESULT, 1, 3)
			CALL SET_LEARN_SKILL, TARGET, L_SKILLS, 1, "通常形態"
		ELSE
			SIF !INRANGE(RESULT, 1, 15)
				RESULT = 15
			CALL SET_LEARN_SKILL, TARGET, L_SKILLS, RESULT * 4, "通常形態"
		ENDIF
	WEND
NEXT

IF CAN_USE_SKILL_RANK:1
	FOR LCOUNT:1, 0, 2
		FOR TABLE_RANK, 1, VARSIZE("SKILL_TABLE")
			FOR LCOUNT, 0, 4
				IF !LCOUNT:1
					SIF TRANS_SKILL_TABLE:TABLE_RANK == ""
						BREAK
					TEMPS = %RAND_SPLIT(TRANS_SKILL_TABLE:TABLE_RANK, "/")%
					TRANS_SKILL_TABLE:TABLE_RANK = %DEL_SPLIT(TRANS_SKILL_TABLE:TABLE_RANK, "/", TEMPS)%
				ELSE
					SIF INAPPARENT_TRANS_SKILL_TABLE:TABLE_RANK == ""
						BREAK
					TEMPS = %RAND_SPLIT(INAPPARENT_TRANS_SKILL_TABLE:TABLE_RANK, "/")%
					INAPPARENT_TRANS_SKILL_TABLE:TABLE_RANK = %DEL_SPLIT(INAPPARENT_TRANS_SKILL_TABLE:TABLE_RANK, "/", TEMPS)%
				ENDIF
				TRANS_SKILL_TABLE:0 = %ADD_SPLIT(TRANS_SKILL_TABLE:0, "/", TEMPS)%
			NEXT
		NEXT
	NEXT
	;---- EDIT 033 MOD START -------------------------
	;テーブルの余りをまとめる
	FOR TABLE_RANK, 2, VARSIZE("SKILL_TABLE")
		SIF TRANS_SKILL_TABLE:TABLE_RANK  != ""
			TRANS_SKILL_TABLE:1 = %ADD_SPLIT(TRANS_SKILL_TABLE:1, "/", TRANS_SKILL_TABLE:TABLE_RANK)%
		SIF INAPPARENT_TRANS_SKILL_TABLE:TABLE_RANK  != ""
			INAPPARENT_TRANS_SKILL_TABLE:1 = %ADD_SPLIT(INAPPARENT_TRANS_SKILL_TABLE:1, "/", INAPPARENT_TRANS_SKILL_TABLE:TABLE_RANK)%
	NEXT
	;---- EDIT 033 MOD END ---------------------------
	IF TRANS_SKILL_TABLE:0 != ""
		FOR LCOUNT, 0, STRCOUNT(TRANS_SKILL_TABLE:0, "/") + 1
			L_SKILLS = %AUTO_SPLIT(TRANS_SKILL_TABLE:0, "/", LCOUNT)%
			CALL GETS_SKILL_PROP, "SKILL_RANK",L_SKILLS
			IF INRANGE(RESULT, 1, 3)
				CALL SET_LEARN_SKILL, TARGET, L_SKILLS, 1, "変身形態"
			ELSE
				SIF !INRANGE(RESULT, 1, 15)
					RESULT = 15
				CALL SET_LEARN_SKILL, TARGET, L_SKILLS, RESULT * 4, "変身形態"
			ENDIF
		NEXT
	ENDIF

	;習得スキルに余りがある場合、残ったスキルで埋める
	FOR LCOUNT, 0, 2
		WHILE FINDELEMENT(ABL, 0, GETNUM(ABL, "초기변신악마스킬1"), GETNUM(ABL, "초기변신악마스킬20")) >= 0
			IF !LCOUNT
				SIF TRANS_SKILL_TABLE:1 == ""
					BREAK
				L_SKILLS = %AUTO_SPLIT(TRANS_SKILL_TABLE:1, "/", 0)%
				TRANS_SKILL_TABLE:1 = %DEL_SPLIT(TRANS_SKILL_TABLE:1, "/", L_SKILLS)%
			ELSE
				SIF INAPPARENT_TRANS_SKILL_TABLE:1 == ""
					BREAK
				;---- EDIT 033 MOD START -------------------------
				L_SKILLS = %AUTO_SPLIT(INAPPARENT_TRANS_SKILL_TABLE:1, "/", 0)%
				INAPPARENT_TRANS_SKILL_TABLE:1 = %DEL_SPLIT(INAPPARENT_SKILL_TABLE:1, "/", L_SKILLS)%
				SIF RAND:2
					CONTINUE
				;---- EDIT 033 MOD END ---------------------------
			ENDIF
			CALL GETS_SKILL_PROP, "SKILL_RANK",L_SKILLS
			IF INRANGE(RESULT, 1, 3)
				CALL SET_LEARN_SKILL, TARGET, L_SKILLS, 1, "変身形態"
			ELSE
				SIF !INRANGE(RESULT, 1, 15)
					RESULT = 15
				CALL SET_LEARN_SKILL, TARGET, L_SKILLS, RESULT * 4, "変身形態"
			ENDIF
		WEND
	NEXT
ENDIF
;整列作業
FOR IS_TRANS, 0, 2
	SIF IS_TRANS && CAN_USE_SKILL_RANK:1 == 0
		BREAK
	TEMPS = \@IS_TRANS ? 초기변신악마 # \@
	FOR LCOUNT, 1, 21
		IF ABL:@"%TEMPS%습득스킬{LCOUNT}"
			ABL:@"%TEMPS%습득스킬{LCOUNT}" += ABL:@"%TEMPS%습득LV{LCOUNT}" * POWER(10, 7)
		ELSE
			ABL:@"%TEMPS%습득스킬{LCOUNT}" = POWER(10, 12)
		ENDIF
	NEXT
	ARRAYSORT ABL:TARGET:0, FORWARD, GETNUM(ABL, @"%TEMPS%습득스킬1"), 20

	FOR LCOUNT, 1, 21
		IF ABL:@"%TEMPS%습득스킬{LCOUNT}" == POWER(10, 12)
			ABL:@"%TEMPS%습득스킬{LCOUNT}" = 0
		ELSE
			ABL:@"%TEMPS%습득LV{LCOUNT}" = ABL:@"%TEMPS%습득스킬{LCOUNT}" / POWER(10, 7)
			ABL:@"%TEMPS%습득스킬{LCOUNT}" = ABL:@"%TEMPS%습득스킬{LCOUNT}" % POWER(10, 7)
		ENDIF
	NEXT

	;レベルをずらす
	FOR LCOUNT, 2, 21
		SIF ABL:@"%TEMPS%습득LV{LCOUNT}" == 0
			BREAK
		SIF ABL:@"%TEMPS%습득LV{LCOUNT}" <= ABL:@"%TEMPS%습득LV{LCOUNT - 1}"
			ABL:@"%TEMPS%습득LV{LCOUNT}" = ABL:@"%TEMPS%습득LV{LCOUNT - 1}" + RAND(1, 4)
	NEXT
	;FOR LCOUNT, 1, 21
	;	PRINTFORML ABL:%TEMPS%습득스킬{LCOUNT} = %SKILL_NAME_F(ABL:@"%TEMPS%습득스킬{LCOUNT}")% Lv{ABL:@"%TEMPS%습득LV{LCOUNT}"}
	;NEXT
	;WAIT
NEXT

;習得スキルが3個以上ある素質は開花し、一つも継承されていない素質は消える
VARSET HAVE_SKILL_BY_SUCCESSION
FOR LCOUNT, 1, CHARA_SKILLCOUNT(TARGET, "通常形態") + 1
	SIF !ABL:@"스킬{LCOUNT}"
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", ABL:@"스킬{LCOUNT}", TARGET
	SIF !INRANGE(RESULT, 0, SUCCESSIONNUM)
		CONTINUE
	HAVE_SKILL_BY_SUCCESSION:RESULT++
NEXT

FOR LCOUNT, 1, 21
	SIF !ABL:@"습득스킬{LCOUNT}"
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", ABL:@"습득스킬{LCOUNT}", TARGET
	SIF !INRANGE(RESULT, 0, SUCCESSIONNUM)
		CONTINUE
	HAVE_SKILL_BY_SUCCESSION:RESULT++
NEXT

FOR LCOUNT, 0, SUCCESSIONNUM
	SIF HAVE_SKILL_BY_SUCCESSION:LCOUNT >= 3
		TALENT:GET_SUCCESSION(LCOUNT) = 1
	SIF HAVE_SKILL_BY_SUCCESSION:LCOUNT == 0
		TALENT:GET_SUCCESSION(LCOUNT) = 0
NEXT

