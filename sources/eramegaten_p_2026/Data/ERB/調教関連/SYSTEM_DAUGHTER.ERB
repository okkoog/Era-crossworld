;========================================================
;子供のキャラクター生成
;母親(あるいは育ての親)に格納しておいたフラグからキャラをランダム生成する
;
;FLAGの付与は妊娠時に
;ERB\調教関連\EVENT_P.ERBの@SET_FETUS_STATUS関数で行う
;========================================================
@MAKE_DAUGHTER, PALENT
#DIM DYNAMIC STOCK_TARGET
#DIM DYNAMIC TEMP, 2
#DIMS DYNAMIC TEMPS
#DIM DYNAMIC LCOUNT, 3
#DIM DYNAMIC PALENT;親　胎児のフラグの格納元のキャラ
#DIM DYNAMIC L_MOTHER
#DIM DYNAMIC L_FATHER
#DIMS DYNAMIC CHILD_SEX
#DIMS DYNAMIC TEMP_SEX, 2
#DIM DYNAMIC IS_MAKE_CHARA
#DIM DYNAMIC MAIN_PALENT
#DIM DYNAMIC SUB_PALENT
#DIM DYNAMIC COUNT_HAVE_WEAK
#DIM DYNAMIC COUNT_HAVE_RESIST
#DIM DYNAMIC APPARENT_TYPE, TYPENUM
#DIM DYNAMIC INAPPARENT_TYPE, TYPENUM
#DIM DYNAMIC CAN_USE_SKILL_RANK, 2
#DIM DYNAMIC LINK_DEVIL_NUM
#DIM DYNAMIC LINK_DEVIL_NO
#DIM DYNAMIC LINK_DEVIL_SKILL, HAVEABLE_SKILLNUM
#DIM DYNAMIC LINK_DEVIL_LEARN, HAVEABLE_SKILLNUM
#DIM DYNAMIC LINK_DEVIL_LEARN_LV, HAVEABLE_SKILLNUM
#DIM DYNAMIC LINK_DEVIL_SUCCESSION, SUCCESSIONNUM
#DIM DYNAMIC LINK_DEVIL_MANTRA, 5
#DIMS DYNAMIC LINK_DEVIL_EXPLAIN, 2
#DIMS DYNAMIC L_TALENTS
#DIM DYNAMIC L_TALENT_LV
#DIM DYNAMIC L_LV_FIXED, 50
#DIMS DYNAMIC L_TALENTS_FIXED, 50
#DIMS DYNAMIC SETED_TALENT
#DIMS DYNAMIC TO_END
#DIM DYNAMIC L_SKILL
#DIMS DYNAMIC L_SKILLS, 2
#DIM DYNAMIC TABLE_RANK
#DIMS DYNAMIC SKILL_TABLE, 7
#DIMS DYNAMIC TRANS_SKILL_TABLE, 7
#DIMS DYNAMIC INAPPARENT_SKILL_TABLE, 7
#DIMS DYNAMIC INAPPARENT_TRANS_SKILL_TABLE, 7
#DIM DYNAMIC IS_TRANS
#DIMS DYNAMIC TRANS_MODE
#DIM DYNAMIC IS_SET_TO_TRANS
#DIM DYNAMIC HAVE_SKILL_BY_SUCCESSION, SUCCESSIONNUM
;急成長するか、それは娘か息子かなどを判定します。

;-------------------------------------------------------------
;両親の出産履歴を追加
;-------------------------------------------------------------
;ARGはPALENTの登録番号
TFLAG:600 = 0
IF CFLAG:PALENT:딸교육
	IF MONEY <= 50000
		CFLAG:PALENT:딸교육 = 0
	ELSE
		MONEY -= 50000
	ENDIF
ENDIF
L_MOTHER = FINDCHARA_ID(CFLAG:PALENT:딸의친부모고유번호부모)
IF CFLAG:PALENT:부친의고유번호부모 >= 0
	L_FATHER = FINDCHARA_ID(CFLAG:PALENT:부친의고유번호부모)
ELSE
	L_FATHER = CFLAG:PALENT:부친의고유번호부모
ENDIF
;変身を解除しておく
SIF CFLAG:PALENT:딸교육
	CALLFORM TRANS_DEVIL, PALENT, , "変身解除"
;産んだ子供の数をサーチした産みの親に追加
SIF L_MOTHER != -1
	CFLAG:L_MOTHER:몇번째아이까지낳았는가 += 1
SIF L_FATHER >= 0
	CFLAG:L_FATHER:몇번째아이까지낳았는가 += 1

;-------------------------------------------------------------
;性別の決定
;-------------------------------------------------------------
;両親の性別を取得
FOR LCOUNT, 0, 2
	IF COUNT_SPLIT(FETUS_TALENT:PALENT:LCOUNT, "/", "오토코노코" + "_\\d*")
		TEMP_SEX:LCOUNT = 오토코노코
	ELSEIF COUNT_SPLIT(FETUS_TALENT:PALENT:LCOUNT, "/", "남자" + "_\\d*")
		TEMP_SEX:LCOUNT = 男
	ELSEIF COUNT_SPLIT(FETUS_TALENT:PALENT:LCOUNT, "/", "후타나리" + "_\\d*")
		TEMP_SEX:LCOUNT = 후타나리
	ELSE
		TEMP_SEX:LCOUNT = 女
	ENDIF
NEXT

;両親が同性ならそのまま、そうでないならどちらか
IF TEMP_SEX:0 == TEMP_SEX:1
	CHILD_SEX = %TEMP_SEX:0%
ELSE
	CHILD_SEX = %TEMP_SEX:(RAND:2)%
	;10%でばける
	IF CHILD_SEX == "男" && !RAND:10
		CHILD_SEX = 오토코노코
	ELSEIF CHILD_SEX == "女" && !RAND:10
		CHILD_SEX = 후타나리
	ELSEIF CHILD_SEX == "오토코노코" && !RAND:10
		CHILD_SEX = 男
	ELSEIF CHILD_SEX == "후타나리" && !RAND:10
		CHILD_SEX = 女
	ENDIF
ENDIF

;-------------------------------------------------------------
;成長後の選択
;-------------------------------------------------------------
IS_MAKE_CHARA = 0
IF CFLAG:PALENT:딸의친부모캐릭터번호부모 != -1 && TALENT:MASTER:금단의지식 && CHARANUM < MAX_PLAYER_CHARA
	IF CHILD_SEX == "女" || CHILD_SEX == "후타나리"
		PRINTFORML %CALLNAME:PALENT%이(가) 키우던 딸이 급격히 성장하여, 조교할 수 있을 정도가 되었습니다.
	ELSE
		PRINTFORML %CALLNAME:PALENT%이(가) 키우던 아들이 급격히 성장하여, 조교할 수 있을 정도가 되었습니다.
	ENDIF
	PRINTFORMW 조교하겠습니까?
	CALL INPUT_YN
	SIF !RESULT
		IS_MAKE_CHARA = 1
ENDIF

;キャラ作成しない場合は仕送りだけ追加して終わる
IF !IS_MAKE_CHARA
	CALL SON_BIRTH, PALENT, L_MOTHER
	RETURN 0
ENDIF

;-------------------------------------------------------------
;キャラ生成
;-------------------------------------------------------------
;ベースキャラはあなたの子供かどうかで変わる
IF GROUPMATCH(MASTER, L_MOTHER, L_FATHER)
	CALL ADD_NEW_COMPANION, [[キャラ:당신의딸]],500
ELSE
	CALL ADD_NEW_COMPANION, [[キャラ:노예의딸]],500
ENDIF
STOCK_TARGET = TARGET
TARGET = RESULT:1
CALL CLEAR_ROLE_TALENT, TARGET

;-------------------------------------------------------------
;誕生関係のフラグ登録
;-------------------------------------------------------------
CFLAG:딸의생일 = CFLAG:PALENT:출산일
CFLAG:딸의양부모캐릭터번호딸 = NO:PALENT

;---- EDIT 038 MOD START -------------------------
IF L_MOTHER >= 0
	CFLAG:딸의친부모캐릭터번호딸 = NO:L_MOTHER
	CFLAG:딸이어머니의몇번째아이인가딸 = CFLAG:L_MOTHER:몇번째아이까지낳았는가
	CFLAG:딸의세대딸 = CFLAG:L_MOTHER:딸의세대딸+ 1
ENDIF
CFLAG:딸의부친고유번호딸 = CFLAG:PALENT:부친의고유번호부모
CFLAG:딸의부친캐릭터번호딸 = CFLAG:PALENT:임신확정후의부친판정
;---- EDIT 038 MOD END ---------------------------
SIF L_FATHER >= 0
	CFLAG:딸이아버지의몇번째아이인가딸 = CFLAG:L_FATHER:몇번째아이까지낳았는가
CFLAG:딸의양부모고유번호딸 = CFLAG:PALENT:캐릭터고유번호

;---- EDIT 034 MOD START -------------------------
;CFLAG:딸의친부모고유번호딸 = CFLAG:L_MOTHER:캐릭터고유번호
CFLAG:딸의친부모고유번호딸 = CFLAG:PALENT:딸의친부모고유번호부모
;---- EDIT 034 MOD END ---------------------------
;-------------------------------------------------
;似ている親の選定
;成長に偏りをつける
;-------------------------------------------------
MAIN_PALENT = RAND:2
SUB_PALENT = !MAIN_PALENT
IF L_MOTHER >= 0
	PRINTFORM %조사처리(CALLNAME:L_MOTHER, "와")% 
ELSE
	IF FETUS_母親名称:PALENT:0 != ""
		PRINTFORM %조사처리(FETUS_母親名称:PALENT:0, "와")% 
	ELSE
		PRINTFORM 이제는 없는 누군가와 
	ENDIF
ENDIF
IF CSTR:PALENT:부친명칭 != ""
	PRINTFORM %CSTR:PALENT:부친명칭%
ELSE
	IF L_FATHER >= 0
		PRINTFORM %CALLNAME:L_FATHER%
	ELSE
		PRINTFORM 누군가
	ENDIF
ENDIF
PRINTFORML 의 아이

;---- EDIT 037 DEL START -------------------------
;あとでまとめて処理されているので
;-------------------------------------------------------------
;性別の確定
;-------------------------------------------------------------
;SELECTCASE CHILD_SEX
;	CASE "男"
;		TALENT:남자 = 1
;	CASE "오토코노코"
;		TALENT:남자 = 1
;		TALENT:오토코노코 = 1
;ENDSELECT
;---- EDIT 037 DEL END ---------------------------
;-------------------------------------------------------------
;ロール・種族の確定
;-------------------------------------------------------------
CSTR:롤 = %RAND_SPLIT(FETUS_ROLE:PALENT:0, "/")%
;ロールのキーとなる素質を呼び出す
RESULTS = 
CALLFORM ROLE_HEREDITY_MAIN_TALENT_%CSTR:롤%
IF RESULTS != ""
	FOR LCOUNT, 0, STRCOUNT(RESULTS, "/") + 1
		TEMPS = %AUTO_SPLIT(RESULTS, "/", LCOUNT)%
		TALENT:AUTO_SPLIT(TEMPS, "_", 0) = TOINT(AUTO_SPLIT(TEMPS, "_", 1))
	NEXT
ENDIF
;半魔などはロールが決まるまでは決まらないのでここで決める
IF FETUS_RACE:PALENT:0 == "未決定"
	CALLFORM ROLE_HEREDITY_ABL_RACE_%CSTR:롤%
	ABL:종족 = RESULT
ELSE
	ABL:종족 = TOINT(RAND_SPLIT(FETUS_RACE:PALENT:0, "/"))
ENDIF

;-------------------------------------------------
;攻撃タイプなどの決定
;-------------------------------------------------
ABL:회화타입 = TOINT(AUTO_SPLIT(FETUS_BTL_ABL:PALENT:MAIN_PALENT, "/", 0))
IF !GET_ROLE_PROP("CAN_USE_EQUIP", TARGET, , "通常形態")
	ABL:공격상성 = TOINT(AUTO_SPLIT(FETUS_BTL_ABL:PALENT:MAIN_PALENT, "/", 1))
	ABL:최저공격횟수 = TOINT(AUTO_SPLIT(FETUS_BTL_ABL:PALENT:MAIN_PALENT, "/", 2))
	ABL:최대공격횟수 = TOINT(AUTO_SPLIT(FETUS_BTL_ABL:PALENT:MAIN_PALENT, "/", 3))
	ABL:사거리 = TOINT(AUTO_SPLIT(FETUS_BTL_ABL:PALENT:MAIN_PALENT, "/", 4))
	ABL:공격범위 = TOINT(AUTO_SPLIT(FETUS_BTL_ABL:PALENT:MAIN_PALENT, "/", 5))
	ABL:추가효과 = TOINT(AUTO_SPLIT(FETUS_BTL_ABL:PALENT:MAIN_PALENT, "/", 6))
	ABL:추가효과상성 = TOINT(AUTO_SPLIT(FETUS_BTL_ABL:PALENT:MAIN_PALENT, "/", 7))
	ABL:추가효과명중률 = TOINT(AUTO_SPLIT(FETUS_BTL_ABL:PALENT:MAIN_PALENT, "/", 8))
	ABL:추가효과최대명중률 = TOINT(AUTO_SPLIT(FETUS_BTL_ABL:PALENT:MAIN_PALENT, "/", 9))
ENDIF

;-------------------------------------------------
;戦闘素質の決定
;-------------------------------------------------
CALL SET_ROLE_CP, TARGET
;固定素質の付与
FOR IS_TRANS, 0, 1 + GET_ROLE_PROP("CAN_USE_TRANS", TARGET)
	CALL SET_FIXED_BTL_TALENT, TARGET, TRANS_MODE, L_LV_FIXED, L_TALENTS_FIXED
	IF IS_TRANS
		TRANS_MODE = 変身形態
	ELSE
		TRANS_MODE = 通常形態
	ENDIF
	WHILE 1
		;保存されているテーブルからランダムで取る
		TEMPS = %RAND_SPLIT(FETUS_SUB_BTL_TALENT:PALENT:IS_TRANS, "/")%
		;取った素質はテーブルから消す
		FETUS_SUB_BTL_TALENT:PALENT:IS_TRANS = %DEL_SPLIT(FETUS_SUB_BTL_TALENT:PALENT:IS_TRANS, "/", TEMPS)%
		;素質付与
		IF TEMPS != ""
			L_TALENTS = %AUTO_SPLIT(TEMPS, "_", 0)%
			L_TALENT_LV = MAX(TOINT(AUTO_SPLIT(TEMPS, "_", 1)), 1)
			;固定素質はセットに関与させない
			SIF MATCH(L_TALENTS_FIXED, L_TALENTS)
				CONTINUE
			SIF !GET_ROLE_PROP("CAN_USE_" + L_TALENTS, TARGET, , TRANS_MODE)
				CONTINUE
			SIF !COUNT_SPLIT(SETED_TALENT, "/", L_TALENTS)
				SETED_TALENT = %ADD_SPLIT(SETED_TALENT, "/", L_TALENTS)%
			;---- EDIT 031 MOD START -------------------------
			CALL SET_BTL_TALENT_LV, L_TALENTS, TARGET, MAX(GET_BTL_TALENT_LV(L_TALENTS, TARGET, TRANS_MODE), L_TALENT_LV), TRANS_MODE
			;---- EDIT 031 MOD END ---------------------------
			;前提となる素質がある場合は一緒につける
			TRYCCALLFORM SUB_ROLE_PREREQUISITE_BTL_TALENT_%L_TALENTS%
				SIF RESULT
					CALL SET_BTL_TALENT_LV, RESULTS, TARGET, MAX(GET_BTL_TALENT_LV(RESULTS, TARGET, TRANS_MODE), RESULT), TRANS_MODE
			CATCH
			ENDCATCH
		ELSE
			;つける素質がなくなっていて、CPが制限内なら終わる
			SIF GET_ROLE_CP(TARGET, TRANS_MODE) >= 0
				BREAK
		ENDIF

		;コストチェック
		CALL SET_ROLE_CP, TARGET
		;コストがオーバーしている場合はセットされた素質のいずれかのレベルを下げる
		IF GET_ROLE_CP(TARGET, TRANS_MODE) < 0
			L_TALENTS = %RAND_SPLIT(SETED_TALENT, "/")%
			IF !GET_BTL_TALENT_LV(L_TALENTS, TARGET, TRANS_MODE)
				SETED_TALENT = %DEL_SPLIT(SETED_TALENT, "/", L_TALENTS)%
				;前提条件のあるものがそれをみたせているかをチェック
				FOR LCOUNT:1, 0, SUB_ROLENUM
					TRYCCALLFORM SUB_ROLE_PREREQUISITE_BTL_TALENT_%GET_SUB_ROLE_NAME(LCOUNT:1)%
						;前提を満たせなくなっているのを確認できたら消す
						SIF RESULT > 0 && GET_BTL_TALENT_LV(L_TALENTS, TARGET, TRANS_MODE) < RESULT
								CALL SET_BTL_TALENT_LV, RESULTS, TARGET, 0, TRANS_MODE
					CATCH
					ENDCATCH
				NEXT
				FETUS_SUB_BTL_TALENT:PALENT:IS_TRANS = %DEL_SPLIT(FETUS_SUB_BTL_TALENT:PALENT:IS_TRANS, "/", TEMPS)%
			ENDIF
			;レベルを1減らす。ただし、サマナーLv2等、取得されない設定されているものは飛ばして落とす
			DO
				CALL SET_BTL_TALENT_LV, L_TALENTS, TARGET, MAX(GET_BTL_TALENT_LV(L_TALENTS, TARGET, TRANS_MODE) - 1, 0), TRANS_MODE
			LOOP  GET_SUB_ROLE_PROP("COST", L_TALENTS, , , GET_BTL_TALENT_LV(L_TALENTS, TARGET, TRANS_MODE)) < 0
			;コストを再設定
			CALL SET_ROLE_CP, TARGET
		ENDIF
		;CPの空がある程度多い場合は終わらずに続ける
		SIF INRANGE(GET_ROLE_CP(TARGET, TRANS_MODE), 0, 7)
			BREAK
	WEND
