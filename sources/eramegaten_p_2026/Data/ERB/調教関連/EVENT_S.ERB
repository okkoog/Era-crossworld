;-------------------------------------------------
;日付が変わった時のイベント
;-------------------------------------------------
@EVENT_NEXTDAY
$INPUT_LOOP
;不思議の根持ちで精液経験が300以上で生える
IF TARGET >= 0 
	IF TALENT:TARGET:이상한뿌리 == 1 && EXP:TARGET:정액경험 >= 300 && TALENT:TARGET:후타나리 == 0 && !IS_MALE(TARGET)
		DRAWLINE
		PRINTFORML ……아무래도 [이상한뿌리]의 효과가 나타날 것 같다
		PRINTFORMW %TARGET을% [후타나리]로 만듭니까？
		PRINTL [0] - 한다
		PRINTL [1] - 하지 않는다
		INPUT
		IF RESULT == 0
			PRINTFORML %NAME:TARGET%의 [이상한뿌리]는 [후타나리]가 되었다
			TALENT:후타나리 = 1
		ELSEIF RESULT == 1
			PRINTFORML %조사처리(NAME:TARGET,"은")% [이상한뿌리]를 잃었다
		ELSE
			GOTO INPUT_LOOP
		ENDIF
		DRAWLINE
		WAIT
		TALENT:TARGET:이상한뿌리 = 0
	ENDIF
ENDIF

$INPUT_LOOP_2
;具現持ちでレズ経験2500以上で生える
IF TARGET >= 0 
	IF TALENT:TARGET:구현 == 1 && EXP:TARGET:레즈경험 >= 2500 && TALENT:후타나리 == 0 && !IS_MALE(TARGET)
		DRAWLINE
		PRINTFORML ……아무래도 [구현]의 효과가 나타날 것 같다
		PRINTFORML %TARGET을% [후타나리]로 만듭니까？
		PRINTL [0] - 한다
		PRINTL [1] - 하지 않는다
		INPUT
		IF RESULT == 0
			PRINTFORML %조사처리(NAME:TARGET,"은")% [구현]에 의한 [후타나리]가 되었다
			TALENT:후타나리 = 1
		ELSEIF RESULT == 1
			PRINTFORML %조사처리(NAME:TARGET,"은")% [구현]을 잃었다
		ELSE
			GOTO INPUT_LOOP_2
		ENDIF
		DRAWLINE
		WAIT
		TALENT:TARGET:구현 = 0
	ENDIF
ENDIF

;放尿経験３０以上でおもらし癖がつく
IF TARGET >= 0 
	IF TALENT:오줌싸개버릇 == 0
		IF (TALENT:TARGET:유치 && EXP:TARGET:방뇨경험 >= 10) || (TALENT:TARGET:유치 == 0 && EXP:TARGET:방뇨경험 >= 30)
			PRINTFORMW (음… 뭐지 이건?)
			PRINTFORM %TARGET은% 
			SIF TALENT:TARGET:유치 && EXP:TARGET:방뇨경험 >= 10
			PRINTFORM 이부자리에 오줌을 
			SIF TALENT:TARGET:유치 == 0 && EXP:TARGET:방뇨경험 >= 30 
			PRINTFORM 실수를 
			PRINTFORMW 해버린 것 같다……
			PRINTFORMW %TARGET은% [오줌싸개버릇]이 생겼다
			TALENT:TARGET:오줌싸개버릇 = 1
		ENDIF
	ENDIF
ENDIF



IF TARGET >= 0 && TALENT:TARGET:유아／유아퇴행 == 0
	;反発刻印３があり、かつ幼稚である時に
	IF TALENT:TARGET:유치 && MARK:반발각인 == 3
		;欲望が5かつ従順が5かつマゾっ気が5かつ異常経験が７以上になる
		SIF ABL:TARGET:1 >= 5 && ABL:TARGET:0 >= 5 && ABL:TARGET:9 >= 5 && EXP:TARGET:이상경험 >= 7
			CALL EVENT_YOUJI
	;反発刻印３があり、かつ幼稚がない時
	ELSEIF TALENT:TARGET:유치 == 0 && MARK:반발각인 == 3
		;欲望が5かつ従順が5かつマゾっ気が5かつ異常経験が９以上に加え露出５とおもらし癖がある
		SIF ABL:TARGET:1 >= 5 && ABL:TARGET:0 >= 5 && ABL:TARGET:9 >= 5 && ABL:TARGET:8 >= 5 && EXP:TARGET:이상경험 >= 9 && TALENT:오줌싸개버릇 == 1
			CALL EVENT_YOUJI
	ENDIF

	;実装したいけどしてない部分を予定関数だけ書いてコメントアウト
	;	IF FLAG:(精液ボテ腹) == 1
	;		IF EQUIP:TARGET:(バイブ付きパンツ各種) == 0
				;暫定措置として、固定で100ml流出
				;追加流出として子宮の現在容量/最大容量で流出量が減る
				;(0除算を除算するため1%は固定で減少、最大で20%)。
				;ふたごちゃんパッチ：ここに置いておくと「ターゲットになってるひとり」のしか減らないので、下に移動
	;		ENDIF
	;	ENDIF
ENDIF


;浮気癖：浮気経験５０以上＆放置日数２０以上
;子宮内精液の減算
FOR LOCAL, 0, CHARANUM
	IF LOCAL != MASTER && TALENT:LOCAL:바람기 == 0 && EXP:LOCAL:바람경험 >= 30 && CFLAG:LOCAL:방치일수 >= 20
		PRINTFORMW %조사처리(CALLNAME:LOCAL, "는")% 불장난에 빠져 있는 모양이다
		SETCOLOR COLOR("赤")
		PRINTFORMW %조사처리(NAME:LOCAL, "은")% 【바람기】를 얻었다
		RESETCOLOR
		PRINTL 　
		DRAWLINE
		TALENT:LOCAL:바람기 = 1
	ENDIF
	;子宮現在容量が減少する処理
	IF CFLAG:LOCAL:자궁현재용량 <= 0
		
	ELSEIF CFLAG:LOCAL:자궁현재용량 <= 100
		CFLAG:LOCAL:자궁현재용량 = 0
	ELSE
		;一日の終了時、大幅に減る
		;ぽってぽてになってるのはそりゃあぶりゅぶりゅ出るわな。
		SELECTCASE CFLAG:LOCAL:자궁현재용량
			CASE IS <= 5000
				CFLAG:LOCAL:자궁현재용량 -= CFLAG:LOCAL:자궁현재용량 / 2
			CASE IS >= 20000
				CFLAG:LOCAL:자궁현재용량 -= CFLAG:LOCAL:자궁현재용량 / 4
			CASEELSE
				CFLAG:LOCAL:자궁현재용량 -= CFLAG:LOCAL:자궁현재용량 / 3
		ENDSELECT
		;固定で100は減る
		CFLAG:LOCAL:자궁현재용량 -= 100
	ENDIF
	SIF CFLAG:LOCAL:자궁현재용량 < 1
		CFLAG:LOCAL:자궁현재용량 = 0
NEXT

SIF FLAG:미조교시함락
	CALL ENAMORED_CHECK

