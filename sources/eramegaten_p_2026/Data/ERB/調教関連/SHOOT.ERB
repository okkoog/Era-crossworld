		IF IS_MALE(TARGET)
			SELECTCASE TRAINNAME:SELECTCOM
				CASE "역강간", "정상위시킨다", "후배위시킨다", "기승위한다", "조수를범하게한다"
					;中出し
					;달성＋1000
					SOURCE:TARGET:달성 += 1000 * (TCVAR:TARGET:사정량)/2
					SOURCE:TARGET:정애 += 250 * (TCVAR:TARGET:사정량)/2
					IF 위험일() == -2
						SOURCE:TARGET:달성 += 1000 * (TCVAR:TARGET:사정량)/2
						SOURCE:TARGET:욕정 += 1000 * (TCVAR:TARGET:사정량)/2
						CFLAG:PLAYER:노예의질내사정에의한임신판정 += TCVAR:TARGET:사정량
					ENDIF
				CASE "애널정상위시킨다", "애널후배위시킨다", "애널기승위한다"
					;アナル中出し
					;달성＋750
					SOURCE:TARGET:달성 += 750 * (TCVAR:TARGET:사정량)/2
					SOURCE:TARGET:일탈 += 750 * (TCVAR:TARGET:사정량)/2
					IF 위험일() == -2 && TALENT:PLAYER:오토코노코
						SOURCE:TARGET:달성 += 1000 * (TCVAR:TARGET:사정량)/2
						SOURCE:TARGET:욕정 += 1000 * (TCVAR:TARGET:사정량)/2
						CFLAG:PLAYER:노예의질내사정에의한임신판정 += TCVAR:TARGET:사정량
					ENDIF
				CASE "펠라한다"
					;입
					;달성＋500
					SOURCE:TARGET:달성 += 250 * (TCVAR:TARGET:사정량)/2
					SOURCE:TARGET:욕정 += 750 * (TCVAR:TARGET:사정량)/2
				CASE "수음한다", "파이즈리한다"
					;입
					;달성＋500
					SOURCE:TARGET:달성 += 500 * (TCVAR:TARGET:사정량)/2
					SOURCE:TARGET:욕정 += 500 * (TCVAR:TARGET:사정량)/2
			ENDSELECT
		ENDIF
	ENDIF
