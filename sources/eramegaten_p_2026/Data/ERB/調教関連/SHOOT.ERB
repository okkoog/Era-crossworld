@SAMEN_SHOOT_CONDOM,ARG,ARG:1

;コンドームに精液溜まる（主人:1、助手:2、奴隷:3）
IF ARG == MASTER
	CFLAG:(ARG:1):사용후콘돔판정 = 1
ELSEIF ARG == ASSI
	CFLAG:(ARG:1):사용후콘돔판정 = 2
ELSEIF ARG == TARGET
	CFLAG:(ARG:1):사용후콘돔판정 = 3
ENDIF
SIF ARG == PLAYER && ARG:1 == TARGET
	CFLAG:붓카케장소판별플래그 = 9
;---------------------------------------------------------
;精液経験の増加とMAG
;---------------------------------------------------------
@SAMEN_SHOOT_OLD,ARG,ARG:1,ARG:2,ARG:3 = 1
CALL ADDS_EXP("정액경험", ARG:3*TCVAR:ARG:사정, TARGET)
;ＭＡＧ吸収処理
IF CFLAG:ARG:ＭＡＧ비피흡수 == 0 && ARG:1 >= 0
	LOCAL:2 = ARG:2 * MAXBASE:(ARG:1):LV * TCVAR:ARG:사정 * (5+MAX(ABL:(ARG:1):순종, ABL:(ARG:1):욕망, ABL:(ARG:1):기교))/5
	CALL DRAIN_MAG,ARG,LOCAL:2,ARG:1
ENDIF

;---------------------------------------------------------
;射精共通処理(ソースの増加のみ)
;---------------------------------------------------------
@SAMEN_SHOOT_CALC,ARG,ARG:1
#DIM 中毒ソース , 2
;射精時の共通処理


;射精時に中毒充足のソースを追加
;通常射精時
SIF TCVAR:ARG:사정 == 1
	中毒ソース = 200
;大量射精時
SIF TCVAR:ARG:사정 == 2
	中毒ソース = 500
;超大量射精時
SIF TCVAR:ARG:사정 == 3
	中毒ソース = 700
;最強射精時
SIF TCVAR:ARG:사정 == 4
	中毒ソース = 1000
;究極射精時
SIF TCVAR:ARG:사정 == 5
	中毒ソース = 1500

IF TCVAR:ARG:사정 > 0
	;精液中毒を見る
	SELECTCASE ABL:16
	CASE 0
		TIMES 中毒ソース , 0.00
	CASE 1
		TIMES 中毒ソース , 0.05
	CASE 2
		TIMES 中毒ソース , 0.30
	CASE 3
		TIMES 中毒ソース , 0.60
	CASE 4
		TIMES 中毒ソース , 0.90
	CASE 5
		TIMES 中毒ソース , 1.20
	CASE 6
		TIMES 中毒ソース , 1.50
	CASE 7
		TIMES 中毒ソース , 1.80
	CASE 8
		TIMES 中毒ソース , 2.30
	CASE 9
		TIMES 中毒ソース , 3.00
	CASE 10
		TIMES 中毒ソース , 5.00
	CASEELSE
		中毒ソース = 中毒ソース * (ABL:16 * 2 - 13 + (ABL:16 - 10) / 2)
	ENDSELECT
ENDIF

SOURCE:(ARG:1):중독충족 += 中毒ソース



;-------------------------------------------------
;中出しソースの計算
;-------------------------------------------------
@SAMEN_SHOOT_SOURCE,ARG,ARG:1
#DIM 達成ソース , 1
#DIM 反感ソース , 1
#DIM 恐れソース , 1
達成ソース = 0
反感ソース = 0
恐れソース = 0

;中出ししてもらった相手が好きな人だと達成にボーナス
IF 연모(ARG:1 , ARG) || 친애(ARG:1 , ARG)
	SOURCE:(ARG:1):달성 += 1500
ELSE
	IF 위험일(ARG:1) == 1
		SOURCE:(ARG:1):무서움 += 2500
		SOURCE:(ARG:1):반감 += 1000
	ELSEIF 위험일(ARG:1) > 1
		SOURCE:(ARG:1):반감 += 125
	ELSE
		SOURCE:(ARG:1):무서움 += 1500
		SOURCE:(ARG:1):반감 += 500
	ENDIF
ENDIF

;陥落素質が無い場合反感追加
IF !陥落(ARG:1)
	SOURCE:(ARG:1):반감 += 1000
	SIF 위험일(ARG:1) > 1
		SOURCE:(ARG:1):반감 -= 750
ENDIF

