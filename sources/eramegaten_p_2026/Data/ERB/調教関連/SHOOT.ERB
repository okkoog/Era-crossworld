;--------------------------------------
;精液を子宮内にいれる関数
;--------------------------------------
@SET_SAMEN_INTO_UTERUS, 出した = -1, 出された = -1
#DIM DYNAMIC 出した
#DIM DYNAMIC 出された
#DIM DYNAMIC AMOUNT_OF_SAMEN

;---- EDIT 010 DEL START -------------------------
;SIF TCVAR:出した:사정부위 == 1
;	RETURN 0
;ザーメンを子宮で受けられない条件を排除する
;男で膣だし…はこれないはずだけど一応
;SIF (TCVAR:出した:사정부위 == 1 && IS_MALE(出した))
;	RETURN 0
;アナルだしで中田氏扱いされるのは男の娘だけ
;SIF (TCVAR:出した:사정부위 == 2 && IS_MALE(出した) && !IS_LOOKSLIKE_MALE(出した))
;	RETURN 0
;---- EDIT 010 DEL END -------------------------
;---- EDIT 010 MOD START -------------------------
;膣内射精以外かつ男の娘へのアナル中出しでもない
IF TCVAR:出した:사정부위 != 1
	SIF !(TCVAR:出した:사정부위 == 2 && IS_MALE(出された) && !IS_LOOKSLIKE_MALE(出された))
		RETURN 0
ENDIF
;ザーメンを子宮で受けられない条件を排除する
;男で膣だし…はこれないはずだけど一応
SIF (TCVAR:出した:사정부위 == 1 && IS_MALE(出された))
	RETURN 0
;---- EDIT 010 MOD END -------------------------
SIF TEQUIP:出した:콘돔
	RETURN 0
SIF CFLAG:出された:자궁내피임결계
	RETURN 0
SIF !TCVAR:出した:사정량
	RETURN 0
SELECTCASE TCVAR:出した:사정량
	CASE 1
		CFLAG:出された:자궁현재용량 += 5
	CASE 2
		CFLAG:出された:자궁현재용량 += 10
	CASE 3
		CFLAG:出された:자궁현재용량 += 25
	CASE 4
		CFLAG:出された:자궁현재용량 += 50
	CASE 5
		;---- EDIT 012 MOD START -------------------------
		;せっかくなのでRANDを追加し、大量に注ぎ込めるように
		IF FLAG:쌍둥이플래그 > 0
			;射精側の絶倫（固定値100）、射精経験/2000によって最大値が雑めに増加
			;ただし+1900＝合計2000まで
			;あとで使うのでAMOUNT_OF_SAMENに保存
			;20240423	あとのほうはRANDこみで代入してるんであとでは使われてないと思われる
			AMOUNT_OF_SAMEN = 100 + RAND:(MIN(1900 , (TALENT:절륜 * 100 + (EXP:사정경험 / 2000) + 1)))
			CFLAG:出された:자궁현재용량 += AMOUNT_OF_SAMEN
		ELSE
			CFLAG:出された:자궁현재용량 += 100
		ENDIF
		;---- EDIT 012 MOD END ---------------------------
ENDSELECT

CALL 子宮最大容量初期設定, 出された

;子宮の拡張処理
;ふたごちゃんフラグオフの場合通常処理
IF FLAG:쌍둥이플래그 == 0
	;子宮の最大容量増加の処置（暫定）
	;一部素質で増加量ブーストかけるのも手なのかもしれない。
	IF CFLAG:出された:자궁현재용량 > CFLAG:出された:자궁최대용량
		IF CFLAG:出された:자궁최대용량 <= 5000
			CFLAG:出された:자궁최대용량 += CFLAG:出された:자궁현재용량 / 20 + 1
		ELSEIF CFLAG:出された:자궁최대용량 >= 20000
			CFLAG:出された:자궁최대용량 = 20000
		ELSE
			SELECTCASE TCVAR:TARGET:사정
				CASE 1
					CFLAG:出された:자궁최대용량 += 1
				CASE 2
					CFLAG:出された:자궁최대용량 += 4
				CASE 3
					CFLAG:出された:자궁최대용량 += 9
				CASE 4
					CFLAG:出された:자궁최대용량 += 16
				CASE 5
					CFLAG:出された:자궁최대용량 += 25
			ENDSELECT
		ENDIF
	ENDIF
;ふたごちゃんフラグがオンの場合、子宮容量を拡張する（二重の意味で）
ELSE
	;=====================
	;●子宮容量計算
	;=====================
	;現実的に言うと、非妊娠時の子宮は潰れており（中に誰もいないのだから当然）、
	;容積は2mlほど。妊娠時はこれが4000ml～5000ml程度になるらしい。
	;柔軟性は実際極めて高いようなので、（栓をされながら注ぎ込まれた場合として）普通体格で50ml程度を基準とする。
	;通常、射精は2-5ml程度。上記射精強度ごとの値で通常射精は+5とあるので、体積はそれを基準とする。
	;現実だと子宮口に阻まれて大半の精子はまず子宮内に入れないのだが、まあエロファンタジーエロファンタジー。
	;ボッテボテに精液ボテるの大好きなので成長も大きめにしたが、それはそれとして成長しすぎると
	;多胎率を上げるのが大変になるので最大値の成長は手加減する
	;未設定の場合
	;デバッグ
	DEBUGPRINTFORML %CALLNAME:出された%자궁현재용량{CFLAG:出された:자궁현재용량}
	DEBUGPRINTFORML %CALLNAME:出された%자궁최대용량{CFLAG:出された:자궁최대용량}
	;満タンにされた場合、拡張する
	IF CFLAG:出された:자궁현재용량 > CFLAG:出された:자궁최대용량
		;射精強度関数「TCVAR:TARGET:사정」の数値に基づき、増加値を決定する
		;射精量を1/4にした値に、[임신하기쉬움]で1.5倍、[출산경험]でさらにドン、の補正
		;ただし、まぁ、射精した量の半分は超えない程度に
		DEBUGPRINTFORML 가득 찼다
		SELECTCASE TCVAR:TARGET:사정량
			CASE 1
				AMOUNT_OF_SAMEN = MIN(3, 2 * ( TALENT:出された:임신하기쉬움 * 5 / 10 +1) * (EXP:出された:출산경험 / 10 + 1))
			CASE 2
				AMOUNT_OF_SAMEN = MIN(5, 3 * (TALENT:出された:임신하기쉬움 * 5 / 10 +1) * (EXP:出された:출산경험 / 10 + 1))
			CASE 3
				AMOUNT_OF_SAMEN = MIN(12, 6 * (TALENT:出された:임신하기쉬움 * 5 / 10 +1) * (EXP:出された:출산경험 / 10 + 1))
			CASE 4
				AMOUNT_OF_SAMEN = MIN(25, 12 * (TALENT:出された:임신하기쉬움 * 5 / 10 +1) * (EXP:出された:출산경험 / 10 + 1))
			CASE 5
				;あんまり子宮容量が成長しすぎると満タンにするのがキツくなるので、ここは手加減
				;射精量がランダムなので、ここは保存しておいた値を使う
				AMOUNT_OF_SAMEN = MIN(100, (AMOUNT_OF_SAMEN / 4 * (TALENT:出された:임신하기쉬움 * 5 / 10 +1) * (EXP:出された:출산경험 / 10 + 1)))
			CASEELSE
		ENDSELECT
		;おまじない
		SIF AMOUNT_OF_SAMEN < 1
			AMOUNT_OF_SAMEN = 1
		DEBUGPRINTFORML AMOUNT_OF_SAMENが{AMOUNT_OF_SAMEN}になった
		;5000mlまではいいペースで増える
		IF CFLAG:出された:자궁최대용량 <= 5000
			CFLAG:出された:자궁최대용량 += AMOUNT_OF_SAMEN + 1
		;10000mlまでは速度半減
		ELSEIF CFLAG:出された:자궁최대용량 <= 10000
			CFLAG:出された:자궁최대용량 += AMOUNT_OF_SAMEN / 2 + 1
		;20000までは速度3割
		ELSEIF CFLAG:出された:자궁최대용량 <= 20000
			CFLAG:出された:자궁최대용량 += AMOUNT_OF_SAMEN / 3 + 1
		;それ以上は25%
		ELSE
			CFLAG:出された:자궁최대용량 += AMOUNT_OF_SAMEN / 4 + 1
		ENDIF
		;最強射精が1回1000程度として、50回ぶち込めば満タンになる程度の容量でカンスト
		;単純に考えて一般的妊婦さんの10倍だぞ10倍
		;ただし現在容量は注ぎ込めば注ぎ込むだけ増えるので、「限界を超えて膨らみつつ、平常時はこれが限度」という感じ
		SIF CFLAG:出された:자궁최대용량 >= 50000
			CFLAG:出された:자궁최대용량 = 50000
		;デバッグ
		DEBUGPRINTFORML %CALLNAME:出された%자궁현재용량{CFLAG:出された:자궁현재용량}
		DEBUGPRINTFORML %CALLNAME:出された%자궁최대용량{CFLAG:出された:자궁최대용량}
		
		;ふたごちゃんパッチ環境下なら、現在容量が最大容量を超えていても、最大容量まで下がらない
		;※ステータス表示で「精液ボテ」と表示する。あと、多胎率が上昇する
	ENDIF
ENDIF
;子宮容量増加後でも抱えきれなければ現在容量は最大容量まで下がる。
CFLAG:出された:자궁현재용량 = MIN(CFLAG:出された:자궁현재용량, CFLAG:出された:자궁최대용량)

