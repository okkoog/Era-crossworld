;---------------------------------------------------------
;射精するかのチェック
;---------------------------------------------------------
;CALL予定箇所：SOURCE.ERB 844行目(調教対象射精チェックの直後)
;主人、助手についてこの関数を呼ぶ
;案としては、奴隷の射精チェックも此処に含めていいかもしれない
;その場合、奴隷の射精による奴隷のソースやDOWNBASEの増加はこの関数内に記述する
;---------------------------------------------------------
@EJAC_CHECK,ARG
#DIM 射精相手
;射精ゲージはとりあえずコマンド内に残っているものを使う
;もしくは調教対象射精と同様に快の合計から射精ゲージ上昇量を決めてもいいかもしれない
;その場合、例えばパイズリなら胸が大きい方が射精させやすくするなど、ここでの倍率に何らかのTFLAGでボーナスを与えていても良いかも
;でもそれならコマンド内で快をTIMESさせた方がいいか

;;射精限界が来ている場合は、射精ゲージは強制的に0にする
;IF CFLAG:ARG:射精残数の保存 == 0
;	BASE:ARG:사정 = 0
;ENDIF

IF BASE:ARG:사정 > MAXBASE:ARG:사정 * 5
	TCVAR:ARG:사정 = 5
ELSEIF BASE:ARG:사정 > MAXBASE:ARG:사정 * 4
	TCVAR:ARG:사정 = 4
ELSEIF BASE:ARG:사정 > MAXBASE:ARG:사정 * 3
	TCVAR:ARG:사정 = 3
ELSEIF BASE:ARG:사정 > MAXBASE:ARG:사정 * 2
	TCVAR:ARG:사정 = 2
ELSEIF BASE:ARG:사정 > MAXBASE:ARG:사정
	TCVAR:ARG:사정 = 1
ELSE
	TCVAR:ARG:사정 = 0
ENDIF
SIF TCVAR:ARG:사정 == 0 && ARG == PLAYER
	TFLAG:8 = 0
SIF TCVAR:ARG:사정 == 0
	RETURN 0

TCVAR:ARG:사정량 = TCVAR:ARG:사정
射精相手 = TCVAR:ARG:페니스사용대상
SIF 射精相手 == -1
	RETURN 0
IF 射精相手 % 10000 == TARGET || (射精相手 / 10000)-1 == TARGET
	射精相手 = TARGET
ELSE
	RETURN 0
ENDIF
;相手が調教対象であれば射精のソース加算
CALL SAMEN_SHOOT_CALC,ARG,TARGET

;相手が調教対象で、妊娠しておらず、ゴムを付けていないのであれば中田氏時のソース追加処理
SIF TALENT:(射精相手):임신 == 0 && 射精相手 == TARGET && (TCVAR:ARG:사정부위 == 1 || (TCVAR:ARG:사정부위 == 2 && TALENT:(射精相手):오토코노코)) && TEQUIP:ARG:콘돔 == 0
	CALL SAMEN_SHOOT_SOURCE,ARG,射精相手



;---------------------------------------------------------
;射精、及び射精箇所選択
;---------------------------------------------------------
;CALL予定箇所：SOURCE.ERB 2104-2105行目間
;TCVAR:射精が1以上のキャラについて、この関数を呼ぶ
;---------------------------------------------------------
;ARG = 射精するキャラ
;---------------------------------------------------------
@SAMEN_SHOOT,ARG
#DIM 射精相手
#LOCALSSIZE 1
#DIM LCOUNT

FONTREGULAR

;精液汚れの設定
;STAIN:P:2 |= 4
CALL SET_STAIN("페니스", "精液", ARG)
射精相手 = TCVAR:ARG:페니스사용대상
SIF TCVAR:ARG:페니스사용대상 >= 10000
	射精相手 = TCVAR:ARG:페니스사용대상 % 10000	

;射精箇所選択機能	
;(射精するのが調教対象でなく、射精相手が単体で、射精箇所選択がONであり、選択できないコマンドでないならば射精箇所選択処理)
IF ARG != TARGET && FLAG:사정전선택 == 9 && TFLAG:사정대상선택가능 != 0 && TCVAR:ARG:페니스사용대상 > -1 && TCVAR:ARG:페니스사용대상 < 10000
	PRINTFORMW %ARG의% 페니스는 한계까지 팽창하여, 이미 사정 직전이다……
	PRINTFORMW 　
	PRINTFORMW %CALLNAME:(TCVAR:ARG:페니스사용대상)%의 어디에 사정하겠습니까?
	PRINTL [0] 「머리카락」
	PRINTL [1] 「얼굴」
	PRINTL [2] 「가슴」
	PRINTL [3] 「배」
	PRINTL [4] 「겨드랑이」
	PRINTL [5] 「허벅지」
	PRINTL [6] 「갈라진 틈」
	PRINTL [7] 「엉덩이」
	IF TEQUIP:ARG:콘돔
		PRINTL [8] 「콘돔에 사정한다」
	ELSE
		PRINTL [8] 「그대로 사정한다」
	ENDIF
	CALL INPUTINT , 0 , 1 , 2 , 3 , 4 , 5 , 6 , 7 , 8
	LOCAL = RESULT
;ランダムにぶっかけ
ELSEIF ARG != TARGET && FLAG:사정전선택 == 10 && TFLAG:704 != 0 && TCVAR:ARG:페니스사용대상 > -1 && TCVAR:ARG:페니스사용대상 < 10000
	LOCAL = RAND:8
ELSE
	LOCAL = FLAG:사정전선택
ENDIF
SELECTCASE LOCAL
	CASE 0
		TCVAR:ARG:사정부위 = 6
		SIF ARG == PLAYER && TCVAR:ARG:페니스사용대상 == TARGET
			CFLAG:붓카케장소판별플래그 = 1
	CASE 1
		TCVAR:ARG:사정부위 = 7
		SIF ARG == PLAYER && TCVAR:ARG:페니스사용대상 == TARGET
			CFLAG:붓카케장소판별플래그 = 2
	CASE 2
		TCVAR:ARG:사정부위 = 5
		SIF ARG == PLAYER && TCVAR:ARG:페니스사용대상 == TARGET
			CFLAG:붓카케장소판별플래그 = 3
	CASE 3
		TCVAR:ARG:사정부위 = 8
		SIF ARG == PLAYER && TCVAR:ARG:페니스사용대상 == TARGET
			CFLAG:붓카케장소판별플래그 = 4
	CASE 4
		TCVAR:ARG:사정부위 = 9
		SIF ARG == PLAYER && TCVAR:ARG:페니스사용대상 == TARGET
			CFLAG:붓카케장소판별플래그 = 5
	CASE 5
		TCVAR:ARG:사정부위 = 10
		SIF ARG == PLAYER && TCVAR:ARG:페니스사용대상 == TARGET
			CFLAG:붓카케장소판별플래그 = 6
	CASE 6
		TCVAR:ARG:사정부위 = 11
		SIF ARG == PLAYER && TCVAR:ARG:페니스사용대상 == TARGET
			CFLAG:붓카케장소판별플래그 = 7
	CASE 7
		TCVAR:ARG:사정부위 = 12
		SIF ARG == PLAYER && TCVAR:ARG:페니스사용대상 == TARGET
			CFLAG:붓카케장소판별플래그 = 8
	CASE 8
		;TCVAR:ARG:사정부위 = 1
		SIF TEQUIP:ARG:콘돔 == 1
			TCVAR:ARG:사정부위 = 13
ENDSELECT

;射精表示
PRINTFORM \@ TCVAR:ARG:사정부위 == 1 ? 질내 # \@\@TCVAR:ARG:사정 == 5 ? 궁극 # \@\@TCVAR:ARG:사정 == 4 ? 최강 # \@\@TCVAR:ARG:사정 == 3 ? 초대량 # \@\@TCVAR:ARG:사정 == 2 ? 대량 #  \@사정
PRINT (
SELECTCASE ARG
	CASE MASTER
		PRINTFORM 주인
	CASE TARGET
		PRINTFORM %CALLNAME:TARGET%
	CASE ASSI
		PRINTFORM 조수
ENDSELECT
IF TCVAR:ARG:사정부위 == 1
	PRINT →
	SELECTCASE TCVAR:ARG:페니스사용대상
		CASE MASTER
			PRINTFORM 주인
		CASE TARGET
			PRINTFORM %CALLNAME:TARGET%
		CASE ASSI
			PRINTFORM 조수
	ENDSELECT
ELSEIF TCVAR:ARG:사정부위 == 2 && TALENT:(TCVAR:ARG:페니스사용대상):오토코노코
	PRINT →
	SELECTCASE TCVAR:ARG:페니스사용대상
		CASE MASTER
			PRINTFORM 주인
		CASE TARGET
			PRINTFORM %CALLNAME:TARGET%
		CASE ASSI
			PRINTFORM 조수
	ENDSELECT
ENDIF
PRINT )

PRINTL

FOR LOCAL , 0 , (TCVAR:ARG:페니스사용대상 >= 10000 ? 2 # 1)
	SIF LOCAL == 1
		射精相手 = TCVAR:ARG:페니스사용대상 / 10000 -1
	;射精処理
	SELECTCASE TCVAR:ARG:사정부위
		CASE -1
			;오나홀에사정
			SIF ARG == PLAYER
				TFLAG:16 = TCVAR:ARG:사정
		CASE 1 , 2
			;膣内射精 or ケツ射精
			CALL IN_VAGINA_CHECK,ARG,射精相手
			SIF ARG == PLAYER && 射精相手 == TARGET
				TFLAG:2 = TCVAR:ARG:사정
			SIF ASSI > -1 && ARG == MASTER && 射精相手 == ASSI
				TFLAG:7 = TCVAR:ARG:사정
		CASE 3
			;手に射精
			CALL SAMEN_SHOOT_OLD,ARG,射精相手,20
			;팬티훑기
			IF SELECTCOM == 197
				LOCALS = \@ CFLAG:속옷（하） ? 속옷（하） # 전신속옷 \@
				SETBIT STAIN:射精相手:LOCALS, 2
			;手に射精 ネギ持って手こきは,無茶かと
			ELSEIF TEQUIP:射精相手:손 == 401 || (RANGE(TEQUIP:射精相手:손, 404, 410) && TEQUIP:射精相手:손 != 408)
				SETBIT STAIN:射精相手:14, 2
			ENDIF
			;手が隠れていない or パンツ扱きでない時は手にも付着
			SIF !(TEQUIP:射精相手:손 == 401 || RANGE(TEQUIP:射精相手:손, 404, 407) || TEQUIP:射精相手:손 == 409 || SELECTCOM == 197)
				CALL SET_STAIN("손" , "精液" , 射精相手)
			SIF ARG == PLAYER && 射精相手 == TARGET
				TFLAG:1 = TCVAR:ARG:사정
		CASE 4
			;口に射精
			CALL SAMEN_SHOOT_OLD,ARG,射精相手,60,3
			CALL SET_STAIN("입" , "精液" , 射精相手)
			SIF ARG == PLAYER && 射精相手 == TARGET
				TFLAG:0 = TCVAR:ARG:사정
		CASE 5
			;胸に射精
			CALL SAMEN_SHOOT_OLD,ARG,射精相手,60,3
			;胸隠してると服に、見えてるなら肌に汚れ
			SIF (TEQUIP:射精相手:유방노출 > 0 || TEQUIP:射精相手:유방노출 > 0)
				SETBIT STAIN:射精相手:(TEQUIP:射精相手:유방노출 + 10), 2
			SIF (TEQUIP:射精相手:유방노출 == -1 && TEQUIP:射精相手:유방노출 == -1)
				CALL SET_STAIN("가슴" , "精液" , 射精相手)
			SIF ARG == PLAYER && 射精相手 == TARGET
				TFLAG:34 = TCVAR:ARG:사정
		CASE 6
			;髪に射精
			CALL SAMEN_SHOOT_OLD,ARG,射精相手,20
			CALL SET_STAIN("머리카락" , "精液" , 射精相手)
			;帽子があると帽子にも
			SIF TEQUIP:射精相手:모자 > 0
				SETBIT STAIN:射精相手:모자, 2
		CASE 7
			;顔に射精
			CALL SAMEN_SHOOT_OLD,ARG,射精相手,60,3
			CALL SET_STAIN("입" , "精液" , 射精相手)
			;眼鏡、眼帯、サングラスにも付着
			SIF (TEQUIP:射精相手:그외 == 1103 || TEQUIP:射精相手:그외 == 1114 || TEQUIP:射精相手:그외 == 1118)
				SETBIT STAIN:射精相手:그외, 2
			SIF ARG == PLAYER && 射精相手 == TARGET
				TFLAG:0 = TCVAR:ARG:사정
		CASE 8
			;腹に射精
			CALL SAMEN_SHOOT_OLD,ARG,射精相手,60,3
			;たくしあげ可能な上着か 下に全身下着の場合で分岐
			IF TEQUIP:배꼽노출 != -1
				TRYCCALLFORM CLOTHES_BREAST_{TEQUIP:射精相手:옷}
					IF !(RESULT & 8)
						SETBIT STAIN:射精相手:옷, 2
					ELSEIF TEQUIP:射精相手:전신속옷 > 0
						TRYCALLFORM CLOTHES_EXPOSE_{TEQUIP:射精相手:전신속옷},6
						SIF RESULT == 0
							SETBIT STAIN:射精相手:전신속옷, 2
					ENDIF
				CATCH
					IF TEQUIP:전신복 > 0 && TEQUIP:스커트걷어올림 >= 1
						IF TEQUIP:射精相手:전신속옷 > 0
							TRYCALLFORM CLOTHES_EXPOSE_{TEQUIP:射精相手:전신속옷},6
							SIF RESULT == 0
								SETBIT STAIN:射精相手:전신속옷, 2
						ENDIF
					ELSE
						SETBIT STAIN:射精相手:(TEQUIP:射精相手:배꼽노출 + 10), 2
					ENDIF
				ENDCATCH
			ENDIF
		CASE 9
			;腋に射精
			CALL SAMEN_SHOOT_OLD,ARG,射精相手,60,3
		CASE 10
			;太ももに射精
			CALL SAMEN_SHOOT_OLD,ARG,射精相手,60,3
			IF TEQUIP:射精相手:스커트걷어올림 <= 1 && TEQUIP:射精相手:다리노출 > 0
				SETBIT STAIN:射精相手:(TEQUIP:射精相手:다리노출 + 10), 2
			;スカートの下
			ELSEIF TEQUIP:射精相手:스커트걷어올림 > 1
				;신발→양말→전신속옷 の順で腿被覆チェック
				FOR LCOUNT, 0, 3
					TRYCALLFORM CLOTHES_EXPOSE_{TEQUIP:射精相手:(GET_CLOTHESNAME(9 - LCOUNT))},3
						IF RESULT == 0
							SETBIT STAIN:射精相手:(19 - LCOUNT), 2
							BREAK
						ENDIF
				NEXT
			ENDIF
		CASE 11
			;割れ目に射精
			CALL SAMEN_SHOOT_OLD,ARG,射精相手,100
			IF TEQUIP:射精相手:음순노출 == -1
				CALL SET_STAIN("바기나" , "精液" , 射精相手)
			ELSE
				SETBIT STAIN:射精相手:(TEQUIP:射精相手:음순노출 + 10), 2
			ENDIF
		CASE 12
			;尻に射精
			CALL SAMEN_SHOOT_OLD,ARG,射精相手,100
			IF TEQUIP:射精相手:둔부노출 == -1
				CALL SET_STAIN("애널" , "精液" , 射精相手)
			ELSE
				SETBIT STAIN:射精相手:(TEQUIP:射精相手:둔부노출 + 10), 2
			ENDIF
		CASE 13
			CALL SAMEN_SHOOT_CONDOM,ARG,射精相手
		CASE 14
			;空中に射精
			;풋잡
			SIF SELECTCOM == 85
				SETBIT STAIN:射精相手:(TEQUIP:射精相手:발노출 + 10), 2
			SIF ARG == PLAYER
				TFLAG:9 = TCVAR:ARG:사정
		CASEELSE
			CALL SAMEN_SHOOT_OLD,ARG,射精相手,5
			
		
	ENDSELECT
	;CALL SAMEN_SHOOT_CALC,ARG,射精相手
NEXT

SIF ARG == TARGET
	TFLAG:10 = TCVAR:ARG:사정


;経験加算
CALL ADDS_EXP("사정경험", TCVAR:ARG:사정, ARG)

;射精ゲージ減少
BASE:ARG:사정 -= MAXBASE:ARG:사정
SIF TCVAR:ARG:사정 == 2
	BASE:ARG:사정 -= MAXBASE:ARG:사정
SIF BASE:ARG:사정 >= MAXBASE:ARG:사정
	BASE:ARG:사정 = MAXBASE:ARG:사정 - 1

;;射精後は再装填の時間を設ける
;;通常射精時
;SIF TCVAR:ARG:사정 == 1
;	CFLAG:ARG:射精ゲージ再装填 = 3
;;大量射精時
;SIF TCVAR:ARG:사정 == 2
;	CFLAG:ARG:射精ゲージ再装填 = 5
;;超大量射精時
;SIF TCVAR:ARG:사정 == 3
;	CFLAG:ARG:射精ゲージ再装填 = 6
;;最強射精時
;SIF TCVAR:ARG:사정 == 4
;	CFLAG:ARG:射精ゲージ再装填 = 7
;;究極射精時
;SIF TCVAR:ARG:사정 == 5
;	CFLAG:ARG:射精ゲージ再装填 = 2
;CFLAG:ARG:射精残数の保存 -= 1

;;無限射精薬が有効なら再装填時間を0に
;SIF CFLAG:ARG:무한사정약플래그 > 0
;	CFLAG:ARG:射精ゲージ再装填 = 0

;コンドームは脱げる
TEQUIP:ARG:콘돔 = 0

;콘돔자동장착처리
IF (FLAG:콘돔자동장착처리 & 4)
	IF ITEM:콘돔 > 0
		ITEM:콘돔 -= 1
		TEQUIP:ARG:콘돔 = 1
	ENDIF
	IF ITEM:콘돔 == 0
		PRINT <콘돔이 다 떨어졌으므로, 자동 장착을 해제합니다>
		FLAG:콘돔자동장착처리 = 0
	ENDIF
ENDIF




;---------------------------------------------------------
;中出し・アナル射精処理
;---------------------------------------------------------
;ARG	出した側
;ARG:1	出された側
;@IN_VAGINA_CHECK,ARG,ARG:1
@IN_VAGINA_CHECK,出した,出された
#DIM DYNAMIC TEMP
#DIM DYNAMIC 出した
#DIM DYNAMIC 出された
#DIMS DYNAMIC 妊娠判定フラグ名
;---- EDIT 009 DEL START -------------------------
;바람꽃의이슬
;このタイミングで処理する意味がないので実際に数値を扱う場所に移動
