ENDIF
IF !HAVE_PENIS(TARGET) && !TALENT:TARGET:모유체질
	PRINTL 
ENDIF

SIF FLAG:화상표시설정_조교화면 > 0
	CALL SHOW_EQUIP_2
PRINTL
;---- EDIT 011 END -----------------------------
CALL SHOW_INFO_PALAM
PRINTL
PRINTFORML 조교자:%NAME:PLAYER%\@ ASSIPLAY == 1 ? (조수) # \@
MAXBASE:MASTER:사정 = 10000 / (TALENT:MASTER:절륜 + 1)
MAXBASE:MASTER:절정 = 10000 / (TALENT:MASTER:절륜 + 1)

SIF MAXBASE:사정 == 0
	MAXBASE:사정 = 10000
IF ASSI >= 0
	SIF MAXBASE:ASSI:사정 == 0
		MAXBASE:ASSI:사정 = 10000
ENDIF

PRINT MAG  
CALL PRINT_COLORBAR, GET_CHARA_STOCK_MAG(PLAYER), GET_CHARA_MAXMAG(PLAYER), 32, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("紫"), RESULT:1
PRINTFORML  ({GET_CHARA_STOCK_MAG(PLAYER),6}/{GET_CHARA_MAXMAG(PLAYER),6})
IF HAVE_PENIS(PLAYER)
	PRINT 사정 
	CALL PRINT_COLORBAR, BASE:PLAYER:사정, MAXBASE:PLAYER:사정, 32, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("黄"), RESULT:1
	PRINTFORM  ({BASE:PLAYER:사정,5}/{MAXBASE:PLAYER:사정,5})
	PRINTL
ENDIF
IF TALENT:PLAYER:모유체질
	MAXBASE:PLAYER:모유 = 10000 - TALENT:PLAYER:음유 * 5000
	PRINT 모유 
	CALL PRINT_COLORBAR, BASE:PLAYER:모유, MAXBASE:PLAYER:모유, 32, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("白"), RESULT:1
	PRINTFORML  ({BASE:PLAYER:모유,5}/{MAXBASE:PLAYER:모유,5})
ENDIF
CALL SHOW_INFO_PALAM, PLAYER
PRINTL 　

IF TEQUIP:촉수
	SIF MAXBASE:MASTER:뇨의 == 0
		MAXBASE:MASTER:뇨의 = 10000
	PRINT 촉수 
	;PRINT 射精（触手）
	CALL PRINT_COLORBAR, BASE:MASTER:뇨의, MAXBASE:MASTER:뇨의, 32, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("黄"), RESULT:1
	;BAR BASE:MASTER:뇨의,MAXBASE:MASTER:뇨의,32
	PRINTFORML  ({BASE:MASTER:뇨의}/{MAXBASE:MASTER:뇨의})
ENDIF


DRAWLINE

CALL SHOW_EQUIP_1

;旧処理ここまで
;ENDIF






@LIFE_BAR, ARG
PRINT 체력 
IF ARG == 0
	A = BASE:체력
	SIF BASE:체력 < 0
		A = 0
	;BAR A,MAXBASE:체력,32
	CALL PRINT_COLORBAR, A, MAXBASE:TARGET:체력, 32, UNICODE(0x2585), UNICODE(0x2585),  BARCOLORSET("赤"), RESULT:1
	;---- EDIT 009 MOD START ---------------------------
	PRINTFORML  ({A,5}/{MAXBASE:체력,5})
	;---- EDIT 009 MOD END -----------------------------
ELSE
	A = BASE:FINDCHARA_ID(TARGET:ARG):체력
	SIF BASE:FINDCHARA_ID(TARGET:ARG):체력 < 0
		A = 0
	CALL PRINT_COLORBAR, A, MAXBASE:FINDCHARA_ID(TARGET:ARG):체력, 32, UNICODE(0x2585) , TOSTR(BARCOLORSET("赤")), RESULT:1
	;BAR A,MAXBASE:FINDCHARA_ID(TARGET:ARG):체력,32
	;---- EDIT 009 MOD START ---------------------------
	PRINTFORML  ({A,5}/{MAXBASE:FINDCHARA_ID(TARGET:ARG):체력,5})
	;---- EDIT 009 MOD END -----------------------------
ENDIF
@STAIN_INFO
#DIM CHARA , 1
#DIM 表示 , 3
#DIM LCOUNT
#LOCALSIZE 2
REDRAW 0
LOCAL:1 = LINECOUNT
DRAWLINE

FOR LOCAL , 0 , 2 + (ASSI>0)
	IF LOCAL == 0
		CHARA = MASTER
	ELSEIF LOCAL == 1
		CHARA = TARGET
	ELSE
		CHARA = ASSI
	ENDIF
	IF 表示:LOCAL == 1
		PRINTFORML 【%CALLNAME:CHARA%의 더러움】[{LOCAL}]비표시
		FOR LCOUNT, 0, 22
			SIF LCOUNT == 2 && !HAVE_PENIS(CHARA)
				CONTINUE
			SIF LCOUNT == 3 && !HAVE_VAGINA(CHARA)
				CONTINUE
			SIF LCOUNT == 5 && !HAVE_TIT(CHARA)
				CONTINUE
			SIF LCOUNT == 6 && !HAVE_VAGINA(CHARA)
				CONTINUE
			SIF LCOUNT == 8
				LCOUNT = 10
			SIF RANGE(LCOUNT , 10 , 21) && !CFLAG:CHARA:GET_CLOTHESNAME(LCOUNT - 10)
				CONTINUE
			SELECTCASE LCOUNT
				CASE 2
					PRINT 　Ｐ：
				CASE 3
					PRINT 　Ｖ：
				CASE 4
					PRINT 　Ａ：
				CASE 5
					PRINT 　Ｂ：
				CASE 6
					PRINT 　질：
				CASE 10 TO 21
					CALLFORM CLOTHES_NAME_{CFLAG:CHARA:GET_CLOTHESNAME(LCOUNT - 10)}
					PRINTFORM 　%RESULTS%：
				CASEELSE
					PRINTFORM 　%STAINNAME:LCOUNT%：
			ENDSELECT
			SIF STAIN:CHARA:LCOUNT & 1
				PRINT <애액>
			SIF STAIN:CHARA:LCOUNT & 2
				PRINT <페니스>
			SIF STAIN:CHARA:LCOUNT & 4
				PRINT <정액>
			SIF STAIN:CHARA:LCOUNT & 8
				PRINT <애널>
			SIF STAIN:CHARA:LCOUNT & 16
				PRINT <모유>
			SIF STAIN:CHARA:LCOUNT & 32
				PRINT <점액>
			SIF STAIN:CHARA:LCOUNT & 64
				PRINT <파과혈>
			PRINTL 
		NEXT
	ELSE
		PRINTFORML 【%CALLNAME:CHARA%의 더러움】[{LOCAL}]표시
	ENDIF
	PRINTL
NEXT
PRINTL [100] 돌아간다
CALL INPUTINT , 0 , 1 , 2*(ASSI>0) , 100
IF RESULT == 100
	REDRAW 1
	RETURN 0
ELSE
	CLEARLINE LINECOUNT - LOCAL:1
	INVERTBIT 表示:RESULT , 0
	RESTART
ENDIF

