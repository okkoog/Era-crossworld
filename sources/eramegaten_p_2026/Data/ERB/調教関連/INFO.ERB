;--------------------------------------------
;@SHOW_STATUS
;調教画面において、調教対象と調教者の状態を記述する
;--------------------------------------------
@SHOW_STATUS
#LOCALSIZE 10
#LOCALSSIZE 20
#DIMS INFO_TRAIN , 11 ;調教対象＆調教者情報表示用変数。0行目にゲージの情報を入れる。
#DIMS SHOW_RECT , 8 ;ゲージ表示の管理用変数。最終的に全て合算＆改行を入れながらINFO_TRAINの0行目に入れ込む。
#DIM LCOUNT
#DIM 連続コマンド実行後
#DIM CHARA , 3
;新処理ここから------------------------------------
;オプションの余地
;とはいえ新表示と旧表示でそれぞれネスト作るのめんどくさいからGOTOで処理します。
SIF 調教画面旧表示==1
	GOTO 旧表示


;div化ここから------------------------------------

;-------------------------------------------------
;ステップ０：使用変数の初期化
;-------------------------------------------------
;情報表示領域とゲージ表示変数を初期化
;INFO_TRAINの0行目はゲージ管理に使います
VARSET INFO_TRAIN , ""

	;-------------------------------------------------
	;ステップ０―１：基本情報インフォメーションウィンドウ配置
	;-------------------------------------------------
	VARS BASE_INFO_WINDOW 
	BASE_INFO_WINDOW '= @"　{DAY}턴 째：조교 {FLAG:조교실행완료횟수}회차  소지금：￥%ADD_KMGT(MONEY)%<br>"
	BASE_INFO_WINDOW = <div xpos='2000' ypos='100' border_width='5' height='120' width='2500' padding='20' background_color='%TOSTR_HTML(GETBGCOLOR())%'>%BASE_INFO_WINDOW%</div>

;-------------------------------------------------
;ステップ１：調教対象の情報ウィンドウを作成
;-------------------------------------------------
VARS TARGET_WINDOW
CALL TRAININFO_CHARA_WINDOW , TARGET , "TARGET"
TARGET_WINDOW = <div xpos='100' ypos='270'>%RESULTS%</div>

;-------------------------------------------------
;ステップ２：TEQUIPなどの現在の状態の情報とアイコンのウィンドウを作成
;-------------------------------------------------

VARS TEQUIP_ICON_WINDOW = ""
CALL TRAININFO_TEQUIP_ICON_WINDOW , TARGET
TEQUIP_ICON_WINDOW = <div xpos='3600' ypos='270'>%RESULTS%</div>

;-------------------------------------------------
;ステップ３：調教者の情報ウィンドウを作成
;-------------------------------------------------
VARS PLAYER_WINDOW = ""
CALL TRAININFO_CHARA_WINDOW , PLAYER , "PLAYER"
PLAYER_WINDOW = <div xpos='4620' ypos='270'>%RESULTS%</div>

;-------------------------------------------------
;ステップＬ：全て表示
;-------------------------------------------------
;FOR LOCAL , 0 , 11
;	PRINTL 
;NEXT
INFO_TRAIN '= BASE_INFO_WINDOW + TARGET_WINDOW + TEQUIP_ICON_WINDOW + PLAYER_WINDOW
HTML_PRINT @"<div xpos='0' ypos='-{(NUM_COMLINE+16)*100}' width='{LINELENS()*50}' height='1500' background_color='%TOSTR_HTML(GETBGCOLOR())%'>%INFO_TRAIN%</div>"
;<div xpos='0' ypos='-{(NUM_COMLINE+4)*100+40}' width='{LINELENS()*50}' height='{(NUM_COMLINE+4)*100+250}' background_color='%TOSTR_HTML(GETBGCOLOR())%'>

;新処理ここで終わり---------------------------------
RETURN



;旧処理
$旧表示
DRAWLINE
VARS L_BLANK = "　　　　　　   "
VARS SHOW_LINE
SHOW_LINE '= " " + GET_FACE_BY_CHARA_AS_HTML(TARGET, 500, "調教")
IF ASSI >= 0
	L_BLANK += "　" * 6
	SHOW_LINE += GET_FACE_BY_CHARA_AS_HTML(ASSI, 500, "調教")
ENDIF
SHOW_LINE += " " * 2 + @"{DAY}일차"
IF TIME == 0
	SHOW_LINE += @"(아침)  소지금：￥{MONEY}"
ELSEIF TIME == 1
	SHOW_LINE += @"(낮)  소지금：￥{MONEY}"
ELSEIF TIME == 2
	SHOW_LINE += @"(저녁)  소지금：￥{MONEY}"
ELSE
	SHOW_LINE += @"(밤)  소지금：￥{MONEY}"
ENDIF
HTML_PRINT SHOW_LINE

PRINTS L_BLANK
CALL LIFE_BAR,0

PRINTS L_BLANK
PRINT 기력 
CALL PRINT_COLORBAR, MAX(BASE:TARGET:기력, 0), MAXBASE:TARGET:기력, 32, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("緑"), RESULT:1
PRINTFORML  ({MAX(BASE:TARGET:기력, 0),5}/{MAXBASE:기력,5})

PRINTS L_BLANK
PRINT MAG  
CALL PRINT_COLORBAR, GET_CHARA_STOCK_MAG(TARGET), GET_CHARA_MAXMAG(TARGET), 32, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("紫"), RESULT:1
PRINTFORML  ({GET_CHARA_STOCK_MAG(TARGET),5}/{GET_CHARA_MAXMAG(TARGET),5})

IF HAVE_PENIS(TARGET)
	PRINTS L_BLANK
	PRINT 사정 
	CALL PRINT_COLORBAR, BASE:TARGET:사정, MAXBASE:TARGET:사정, 32, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("黄"), RESULT:1
	PRINTFORM  ({BASE:사정,5}/{MAXBASE:사정,5})
	PRINTL
ENDIF
IF TALENT:TARGET:모유체질
	PRINTS L_BLANK
	MAXBASE:모유 = 10000 / (TALENT:TARGET:음유 + 1) 
	PRINT 모유 
