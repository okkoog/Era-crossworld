;====================================================================
;ＮＴＲ요바이
;====================================================================

@EVENT_NTR_SELF
#LOCALSIZE 1
#DIM LCOUNT
CUSTOMDRAWLINE =
LOCAL = 0
;キャラ登録数が1以下の時は引き返す
SIF CHARANUM <= 1
	RETURN 1
FOR LCOUNT, 0, CHARANUM
	;主人ならスキップ
	SIF LCOUNT == MASTER
		CONTINUE
	;対象がその場にいないなら除外
	SIF CFLAG:LCOUNT:이자리에없는플래그 == 1
		CONTINUE
	SIF CFLAG:LCOUNT:전투이외불능
		RETURN 0
	;レンタル中は除外
	SIF IS_RENTING(LCOUNT)
		CONTINUE
	;体力が500以下なら除外
	SIF BASE:LCOUNT:0 <= 500
		CONTINUE
	;最も好感度が高いキャラがＮＰＣでなければ除外
	SIF CFLAG:LCOUNT:함락캐릭터 > -1
		CONTINUE
	;トロは別イベント
	SIF CFLAG:LCOUNT:함락캐릭터 == -16
		CONTINUE
	;上司は別イベント
	SIF CFLAG:LCOUNT:함락캐릭터 == -20
		CONTINUE

	;ＮＴＲれてないかつ浮気心になってないキャラは除外
	IF TALENT:LCOUNT:ＮＴＲ == 0
		;淫乱度が最も高い好感度より高い場合はダメ
		SIF CFLAG:LCOUNT:음란도 >= ABS(FAVORITE(LCOUNT, (FAVORITE_1(LCOUNT))))
			CONTINUE
		;
		SIF !(FAVORITE_1_ID(LCOUNT) != CFLAG:LCOUNT:함락캐릭터 && ABS(FAVORITE(LCOUNT, (FAVORITE_1(LCOUNT)))) > ABS(FAVORITE_ID(LCOUNT , CFLAG:LCOUNT:함락캐릭터)) + 500)
			CONTINUE
	ELSE
		;淫ＮＴＲ以外は、陥落対象が最も好感度の高いキャラじゃないと行かない
		SIF TALENT:LCOUNT:ＮＴＲ != 2 && FAVORITE_1_ID(LCOUNT) != CFLAG:LCOUNT:함락캐릭터
			CONTINUE
	ENDIF
	CALL ＮＴＲ夜這い決定,LCOUNT
	LOCAL = 1
NEXT
SIF LOCAL > 0
	CUSTOMDRAWLINE =

@ＮＴＲ夜這い決定,ARG
;どの夜這いに進むか決定
IF TALENT:ARG:ＮＴＲ == 2 && CFLAG:ARG:음란도 >= ABS(FAVORITE(ARG, (FAVORITE_1(ARG))))
	;淫ＮＴＲ状態
	IF (EXP:ARG:변기경험 > 50) && RAND:2 == 0
		;公衆便所へ
		CFLAG:ARG:ＮＴＲ요바이 = 3
	ELSEIF (CFLAG:ARG:현ＮＴＲ진행도 >= 10 || CFLAG:ARG:음란도 >= 5000) && RAND:3 == 0
		;乱交パーティへ
		CFLAG:ARG:ＮＴＲ요바이 = 1
	ELSEIF (CFLAG:ARG:현ＮＴＲ진행도 >= 5 || CFLAG:ARG:음란도 >= 4000) && RAND:2 == 0
		;公園へ
		CFLAG:ARG:ＮＴＲ요바이 = 2
	ELSE
		;夜の街へ
		CFLAG:ARG:ＮＴＲ요바이 = 4
	ENDIF
ELSEIF (FAVORITE_1_ID(ARG) != CFLAG:ARG:함락캐릭터) && ABS(FAVORITE(ARG, (FAVORITE_1(ARG)))) > ABS(FAVORITE_ID(ARG , CFLAG:ARG:함락캐릭터)) + 500
	;最も好感度の高いキャラが陥落対象で無い場合、ＮＴＲ前逢引へ
	CFLAG:ARG:ＮＴＲ요바이 = 5
ELSEIF CFLAG:ARG:현ＮＴＲ진행도 == 1
	;ＮＴＲ後初の夜這い
	CFLAG:ARG:ＮＴＲ요바이 = 6
ELSE
	$LOOP_RAND
	LOCAL = RAND:6
	SELECTCASE LOCAL
		CASE 0
		;野外調教(散歩他) 12
			SIF (TALENT:ARG:ＮＴＲ != 3 && TALENT:ARG:ＮＴＲ != 6) || CFLAG:ARG:현ＮＴＲ진행도 < 6
				GOTO LOOP_RAND
			CFLAG:ARG:ＮＴＲ요바이 = 12
		CASE 1
		;デート 7
			CFLAG:ARG:ＮＴＲ요바이 = 7

		CASE 2
		;本番 8
			CFLAG:ARG:ＮＴＲ요바이 = 8
		CASE 3
		;オナニー見せ合い 9
			SIF (TALENT:ARG:ＮＴＲ != 3 && TALENT:ARG:ＮＴＲ != 6) && ABL:ARG:노출증 < 3 && ABL:ARG:자위중독 < 1
				GOTO LOOP_RAND
			CFLAG:ARG:ＮＴＲ요바이 = 9
		CASE 4
		;アナルセックス 10
			SIF (TALENT:ARG:ＮＴＲ != 3 && TALENT:ARG:ＮＴＲ != 6)
				GOTO LOOP_RAND
			CFLAG:ARG:ＮＴＲ요바이 = 10
		CASE 5
		;야외플레이 11
			SIF (TALENT:ARG:ＮＴＲ != 3 && TALENT:ARG:ＮＴＲ != 6) && ABL:ARG:노출증 < 4
				GOTO LOOP_RAND
			CFLAG:ARG:ＮＴＲ요바이 = 11

	ENDSELECT

ENDIF
CALLFORM NTR_SELF_{CFLAG:ARG:ＮＴＲ요바이},ARG
CALL 気絶処理,ARG

RETURN 1

;淫系
;乱交パーティ
@NTR_SELF_1,ARG
#LOCALSIZE 1
#DIM 回数
#DIM 精液量
#DIM Ｃ回数
#DIM Ｖ回数
#DIM Ｂ回数
#DIM 絶頂回数
#DIM 精液回数
#DIM 精飲回数
#DIM 性交回数
#DIM 질내사정횟수
#DIM キス回数
#DIM 펠라횟수
#DIM Ａ回数
#DIM Ａ性交回数
#DIM 絶頂ポイント
#DIM 精液残量

;NTRペナルティONの場合
IF FLAG:ＮＴＲ하드모드
	;回数・人数の算出
	;技巧人
	CFLAG:ARG:유혹인수 = ABL:ARG:기교 + RAND:(ABL:ARG:기교 + 1) + TALENT:ARG:매력 + TALENT:ARG:수수께끼의매력
	;各回数の算出
	IF TALENT:ARG:남자 == 0 || ABL:ARG:정액중독 || ABL:ARG:ＢＬ끼
		CFLAG:ARG:펠라횟수 = (ABL:ARG:욕망 + 6)/4 + (ABL:ARG:정액중독 + 1)/2 + ABL:ARG:봉사정신 / 3
	ELSE
		CFLAG:ARG:펠라횟수 = 0
	ENDIF
	IF TALENT:ARG:남자 == 0
		CFLAG:ARG:본방횟수 = (ABL:ARG:욕망 + 6)/4 + (ABL:ARG:섹스중독 + 1)/2 + ABL:ARG:Ｖ감각 / 3
		SIF HAVE_PENIS(ARG)
			CFLAG:ARG:삽입횟수 = (ABL:ARG:욕망 + 6)/4 + (ABL:ARG:섹스중독 + 1)/2 + ABL:ARG:Ｃ감각 / 3
	ELSE
		CFLAG:ARG:본방횟수 = 0
		CFLAG:ARG:삽입횟수 = (ABL:ARG:욕망 + 6)/4 + (ABL:ARG:섹스중독 + 1)/2 + ABL:ARG:Ｃ감각 / 3
	ENDIF
	CFLAG:ARG:애널횟수 = (ABL:ARG:욕망 + 6)/4 + (ABL:ARG:섹스중독 + 1)/2 + ABL:ARG:Ａ감각 / 3
	SIF TALENT:ARG:Ｖ민감 && TALENT:ARG:남자 == 0
		CFLAG:ARG:본방횟수 += 1
	SIF TALENT:ARG:Ａ민감
		CFLAG:ARG:애널횟수 += 1

	CFLAG:ARG:펠라횟수 *= CFLAG:ARG:유혹인수
	CFLAG:ARG:본방횟수 *= CFLAG:ARG:유혹인수
	CFLAG:ARG:애널횟수 *= CFLAG:ARG:유혹인수
	;口上呼び出し
	DRAWLINE
	SWAP TARGET , ARG
	TFLAG:13 = 51
	CALL KOJO_MESSAGE_EVENT
	SWAP TARGET , ARG

	VARSET TCVAR:ARG:0 , 0

	SIF TALENT:ARG:처녀
		CALL ADDS_ABNORMAL_EXP, "処女喪失（輪姦）", ARG
	TALENT:ARG:처녀 = 0
	TCVAR:ARG:획득Ｖ경험 = CFLAG:ARG:본방횟수
	TCVAR:ARG:획득Ａ경험 = CFLAG:ARG:애널횟수
	TCVAR:ARG:획득키스경험 = (1+RAND:3)*CFLAG:ARG:유혹인수
	SIF HAVE_PENIS(ARG)
		TCVAR:ARG:획득사정경험 = CFLAG:ARG:삽입횟수 * 2 + CFLAG:ARG:애널횟수/2 + CFLAG:ARG:본방횟수/2
	TCVAR:ARG:획득성교경험 = CFLAG:ARG:삽입횟수 + CFLAG:ARG:애널횟수 + CFLAG:ARG:본방횟수
	TCVAR:ARG:획득펠라경험 = CFLAG:ARG:펠라횟수
	TCVAR:ARG:획득정액경험 = CFLAG:ARG:펠라횟수 * 2 + CFLAG:ARG:애널횟수 * 2 + CFLAG:ARG:본방횟수 * 2
	TCVAR:ARG:획득절정경험 = CFLAG:ARG:본방횟수 + CFLAG:ARG:애널횟수 + CFLAG:ARG:삽입횟수
	TCVAR:ARG:획득질사경험 = CFLAG:ARG:본방횟수 * 2
	TCVAR:ARG:획득봉사쾌락경험 = (CFLAG:ARG:본방횟수 + CFLAG:ARG:애널횟수 + CFLAG:ARG:펠라횟수)/3
	TCVAR:ARG:획득바람경험 = 1
	;体力の消耗
	LOCAL = CFLAG:ARG:펠라횟수 * 5 + CFLAG:ARG:애널횟수 * 15 + CFLAG:ARG:본방횟수 * 10
	PRINTFORML 체력 - {LOCAL}
	BASE:ARG:체력 -= LOCAL
	CALL SHOW_ADD_EXP, ARG
	CFLAG:ARG:현ＮＴＲ진행도 += 1
	;浮気癖がある場合は淫乱度倍化
	IF TALENT:ARG:바람기
		CFLAG:ARG:음란도 += (LOCAL/10)*2
	ELSE
		CFLAG:ARG:음란도 += LOCAL/10
	ENDIF

ELSE
	;回数・人数の算出
	;3～5人
	;回数設定
	回数 = 3+RAND:3
	精液残量 = 回数*3

	Ｖ回数 = 回数 + RAND:(回数*3+1)
	펠라횟수 = 回数 + RAND:(回数*3+1)
	Ａ回数 = 回数 + RAND:(回数*3+1)
	;フェラ回数が1以上の場合
	IF 펠라횟수
		;必ず精液量を半分は残す
		精飲回数 = LIMIT(1+RAND:펠라횟수, 0, 精液残量/2)
		精液残量 -= 精飲回数
	ENDIF

	性交回数 = Ｖ回数
	;性交回数が1以上の場合
	SIF 性交回数
		질내사정횟수 = LIMIT(1+RAND:性交回数, 0, 精液残量)

	;フェラ回数か性交回数が１以上の場合は精液回数がカウントされる
	SIF (性交回数+펠라횟수) > 0
		精液回数 = 精飲回数 + 질내사정횟수

	キス回数 = RAND:(回数*3+1)

	;各回数の算出(1人3回)
	IF TALENT:ARG:남자 == 0 || ABL:ARG:정액중독 || ABL:ARG:ＢＬ끼
		CFLAG:ARG:펠라횟수 = 펠라횟수
	ELSE
		CFLAG:ARG:펠라횟수 = 0
	ENDIF
	IF TALENT:ARG:남자 == 0
		CFLAG:ARG:본방횟수 = Ｖ回数
		SIF HAVE_PENIS(ARG)
			CFLAG:ARG:삽입횟수 = Ｖ回数
	ELSE
		CFLAG:ARG:본방횟수 = 0
		CFLAG:ARG:삽입횟수 = Ｖ回数
	ENDIF
	CFLAG:ARG:애널횟수 = Ａ回数
	;絶頂回数計算
	絶頂回数 = 0
	IF Ｖ回数
		絶頂回数 += RAND:Ｖ回数
		SIF TALENT:ARG:Ｖ민감
			絶頂回数 += 回数
		SIF TALENT:ARG:Ｖ둔감
			絶頂回数 = LIMIT(絶頂回数-RAND:回数, 0, 絶頂回数)
	ENDIF
	IF Ａ回数
		絶頂回数 += RAND:Ａ回数
		SIF TALENT:ARG:Ａ민감
			絶頂回数 += 回数
		SIF TALENT:ARG:Ａ둔감
			絶頂回数 = LIMIT(絶頂回数-RAND:回数, 0, 絶頂回数)
	ENDIF

	;口上呼び出し
	DRAWLINE
	SWAP TARGET , ARG
	TFLAG:13 = 51
	CALL KOJO_MESSAGE_EVENT
	SWAP TARGET , ARG

	VARSET TCVAR:ARG:0 , 0

	SIF TALENT:ARG:처녀
		CALL ADDS_ABNORMAL_EXP, "処女喪失（輪姦）", ARG
	TALENT:ARG:처녀 = 0
	TCVAR:ARG:획득Ｖ경험 = CFLAG:ARG:본방횟수
	TCVAR:ARG:획득Ａ경험 = CFLAG:ARG:애널횟수
	TCVAR:ARG:획득키스경험 = キス回数
	SIF HAVE_PENIS(ARG)
		TCVAR:ARG:획득사정경험 = CFLAG:ARG:삽입횟수 * 2 + CFLAG:ARG:애널횟수/2 + CFLAG:ARG:본방횟수/2
	TCVAR:ARG:획득성교경험 = CFLAG:ARG:삽입횟수 + CFLAG:ARG:애널횟수 + CFLAG:ARG:본방횟수
	TCVAR:ARG:획득펠라경험 = CFLAG:ARG:펠라횟수
	TCVAR:ARG:획득정액경험 = 精液回数
	TCVAR:ARG:획득절정경험 = 絶頂回数
	TCVAR:ARG:획득질사경험 = 질내사정횟수
	TCVAR:ARG:획득봉사쾌락경험 = (CFLAG:ARG:본방횟수 + CFLAG:ARG:애널횟수 + CFLAG:ARG:펠라횟수)/3
	TCVAR:ARG:획득바람경험 = 1
	;体力の消耗
	LOCAL = CFLAG:ARG:펠라횟수 * 5 + CFLAG:ARG:애널횟수 * 15 + CFLAG:ARG:본방횟수 * 10
	PRINTFORML 체력 - {LOCAL}
	BASE:ARG:체력 -= LOCAL
	CALL SHOW_ADD_EXP, ARG
	CFLAG:ARG:현ＮＴＲ진행도 += 1
	;浮気癖がある場合は淫乱度倍化
	IF TALENT:ARG:바람기
		CFLAG:ARG:음란도 += (LOCAL/10)*2
	ELSE
		CFLAG:ARG:음란도 += LOCAL/10
	ENDIF

ENDIF

