		CFLAG:ARG:음란도 += LOCAL/10
	ENDIF

ELSE
	;回数・人数の算出
	;1人
	;回数設定
	回数 = 1
	精液残量 = 回数*3

	Ｖ回数 = 回数 + RAND:(回数*3+1)
	펠라횟수 = 回数 + RAND:(回数*3+1)
	Ａ回数 = 回数 + RAND:(回数*3+1)
	;フェラ回数が1以上の場合
	IF 펠라횟수
		;必ず精液量を半分は残す
		精飲回数 = LIMIT(1+RAND:펠라횟수, 0, 精液残量/2)
		精液残量 -= 精飲回数
	ENDIF

	性交回数 = Ｖ回数
	;性交回数が1以上の場合
	SIF 性交回数
		질내사정횟수 = LIMIT(1+RAND:性交回数, 0, 精液残量)

	;フェラ回数か性交回数が１以上の場合は精液回数がカウントされる
	SIF (性交回数+펠라횟수) > 0
		精液回数 = 精飲回数 + 질내사정횟수

	キス回数 = RAND:(回数*3+1)

	;各回数の算出(1人3回)
	IF TALENT:ARG:남자 == 0 || ABL:ARG:정액중독 || ABL:ARG:ＢＬ끼
		CFLAG:ARG:펠라횟수 = 펠라횟수
	ELSE
		CFLAG:ARG:펠라횟수 = 0
	ENDIF
	IF TALENT:ARG:남자 == 0
		CFLAG:ARG:본방횟수 = Ｖ回数
		SIF HAVE_PENIS(ARG)
			CFLAG:ARG:삽입횟수 = Ｖ回数
	ELSE
		CFLAG:ARG:본방횟수 = 0
		CFLAG:ARG:삽입횟수 = Ｖ回数
	ENDIF
	CFLAG:ARG:애널횟수 = Ａ回数
	;絶頂回数計算
	絶頂回数 = 0
	IF Ｖ回数
		絶頂回数 += RAND:Ｖ回数
		SIF TALENT:ARG:Ｖ민감
			絶頂回数 += 回数
		SIF TALENT:ARG:Ｖ둔감
			絶頂回数 = LIMIT(絶頂回数-RAND:回数, 0, 絶頂回数)
	ENDIF
	IF Ａ回数
		絶頂回数 += RAND:Ａ回数
		SIF TALENT:ARG:Ａ민감
			絶頂回数 += 回数
		SIF TALENT:ARG:Ａ둔감
			絶頂回数 = LIMIT(絶頂回数-RAND:回数, 0, 絶頂回数)
	ENDIF


	;口上呼び出し
	DRAWLINE
	SWAP TARGET , ARG
	TFLAG:13 = 54
	CALL KOJO_MESSAGE_EVENT
	SWAP TARGET , ARG

	VARSET TCVAR:ARG:0 , 0

	SIF TALENT:ARG:처녀
		PRINTFORML <처녀상실>
	TALENT:ARG:처녀 = 0
	TCVAR:ARG:획득Ｖ경험 = CFLAG:ARG:본방횟수
	TCVAR:ARG:획득Ａ경험 = CFLAG:ARG:애널횟수
	TCVAR:ARG:획득키스경험 = キス回数
	SIF HAVE_PENIS(ARG)
		TCVAR:ARG:획득사정경험 = CFLAG:ARG:삽입횟수 * 2 + CFLAG:ARG:애널횟수/2 + CFLAG:ARG:본방횟수/2
	TCVAR:ARG:획득성교경험 = CFLAG:ARG:삽입횟수 + CFLAG:ARG:애널횟수 + CFLAG:ARG:본방횟수
	TCVAR:ARG:획득펠라경험 = CFLAG:ARG:펠라횟수
	TCVAR:ARG:획득정액경험 = 精液回数
	TCVAR:ARG:획득절정경험 = 絶頂回数
	TCVAR:ARG:획득질사경험 = 질내사정횟수
	TCVAR:ARG:획득봉사쾌락경험 = (CFLAG:ARG:본방횟수 + CFLAG:ARG:애널횟수 + CFLAG:ARG:펠라횟수)/3
	TCVAR:ARG:획득바람경험 = 1
	;体力の消耗
	LOCAL = CFLAG:ARG:펠라횟수 * 5 + CFLAG:ARG:애널횟수 * 15 + CFLAG:ARG:본방횟수 * 10
	PRINTFORML 체력 - {LOCAL}
	BASE:ARG:체력 -= LOCAL
	CALL SHOW_ADD_EXP, ARG
	CFLAG:ARG:현ＮＴＲ진행도 += 1
	;浮気癖がある場合は淫乱度倍化
	IF TALENT:ARG:바람기
		CFLAG:ARG:음란도 += (LOCAL/10)*2
	ELSE
