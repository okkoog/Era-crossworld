@NTR_HOUMONNHANNBAI_SEX,ARG
;各回数の算出
IF TALENT:ARG:남자 == 0
	CFLAG:ARG:본방횟수 = 3 + RAND:11
	SIF HAVE_PENIS(ARG)
		CFLAG:ARG:삽입횟수 = (ABL:ARG:욕망 + 6)/4 + (ABL:ARG:섹스중독 + 1)/2 + ABL:ARG:Ｃ감각 / 3
ELSE
	CFLAG:ARG:본방횟수 = 0
	CFLAG:ARG:삽입횟수 = (ABL:ARG:욕망 + 6)/4 + (ABL:ARG:섹스중독 + 1)/2 + ABL:ARG:Ｃ감각 / 3
ENDIF
IF TALENT:ARG:남자 == 0 || ABL:ARG:정액중독 || ABL:ARG:ＢＬ끼
	CFLAG:ARG:펠라횟수 = 2 + RAND:5
ELSE
	CFLAG:ARG:펠라횟수 = 0
ENDIF
SIF TALENT:ARG:Ｖ민감 && TALENT:ARG:남자 == 0
	CFLAG:ARG:본방횟수 += 1

;처녀/再生処女喪失
CALL 처녀상실, ARG
CALL 処女喪失イベント, ARG

IF EXP:ARG:Ｖ확장경험 == 0 && EXP:ARG:Ａ확장경험 == 0
	CALL ADDS_ABNORMAL_EXP, "拡張初体験", ARG
	SETCOLOR COLOR("red")
	PRINTL 이상경험　확장첫경험 + 1
	RESETCOLOR
ENDIF
TCVAR:ARG:획득Ｖ경험 = CFLAG:ARG:본방횟수
TCVAR:ARG:획득Ｖ확장경험 = CFLAG:ARG:본방횟수
TCVAR:ARG:획득펠라경험 = CFLAG:ARG:펠라횟수
TCVAR:ARG:획득키스경험 = 3+RAND:10
SIF HAVE_PENIS(ARG)
	TCVAR:ARG:획득사정경험 = CFLAG:ARG:삽입횟수 * 2 + CFLAG:ARG:본방횟수/2
TCVAR:ARG:획득성교경험 = CFLAG:ARG:삽입횟수 + CFLAG:ARG:본방횟수
TCVAR:ARG:획득절정경험 = CFLAG:ARG:본방횟수 + CFLAG:ARG:삽입횟수
IF CFLAG:ARG:애ＮＴＲ진행도 == 2
	TCVAR:ARG:획득질사경험 = CFLAG:ARG:본방횟수 * 2
	TCVAR:ARG:획득정액경험 = CFLAG:ARG:펠라횟수 * 2 + CFLAG:ARG:본방횟수 * 2
	SIF CFLAG:ARG:108 == 0
		CFLAG:ARG:105 += CFLAG:ARG:본방횟수 * 2
ENDIF
TCVAR:ARG:획득봉사쾌락경험 = (CFLAG:ARG:본방횟수)/3
;浮気癖がある場合は淫乱度倍化
IF TALENT:ARG:바람기
	CFLAG:ARG:음란도+= ((TCVAR:ARG:획득절정경험 + TCVAR:ARG:획득질사경험) * 10)*2
ELSE
	CFLAG:ARG:음란도+= (TCVAR:ARG:획득절정경험 + TCVAR:ARG:획득질사경험) * 10
ENDIF
TCVAR:ARG:획득바람경험 = 1
CALL SHOW_ADD_EXP, ARG


