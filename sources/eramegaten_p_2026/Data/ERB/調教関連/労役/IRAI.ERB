;普通の霊能力者っぽい仕事をさせたいな～と思って作りました　いや、普通の霊能力者ってなんだろう
;陥落素質ついたキャラに仕事を任せて日数経過でゲージが増加、100%になったら仕事完了でお金と微量の経験値が入る仕様になっています
;最初は1日1回仕事完了で作ってましたがそれだと報酬を高額にした時にお金が稼げすぎるのと報酬額を減らしたら減らしたで「お小遣いレベルのお金で動かせる高レベル能力者ってなんか嫌」
;という理由で完了までに日数がかかる仕様にしました
;地の文が全然思いつかなくて今のところバリエーションがない

;==========================================================
;@IRAI
; 依頼を任せるキャラを選択
;<引数>
;	なし
;<戻り値>
;	なし
;==========================================================
@IRAI
#DIM 依頼キャラ
$IRAI_TOP
$PRINT_LIST
;CALL INPUT_CHARA_LIST("依頼を任せる相手を選んでください", "CASTING_IRAI", "", "", "")
{
CALL INPUT_CHARA_LIST
	, "FUNC_PROPSET_LIST"
	, "의뢰를 맡길 상대를 선택해주세요"
	, "CASTING_IRAI" 
	, "SHOW_ADD_UP_FUNCTION"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
IF RESULT == 1000
	RETURN 0
ENDIF

依頼キャラ = RESULT

$SELECT_LOOP

CALL CHOICE_IRAI, 依頼キャラ
SIF RESULT ==-1
	RETURN
CFLAG:依頼キャラ:노역커맨드용 = RESULT

DRAWLINE
;依頼を実行するか？
IF FLAG:노역실행확인생략설정 == 0
	PRINTFORML %CALLNAME:依頼キャラ%에게 일을 맡기겠습니까?
	CALL INPUT_YN,"일을 맡긴다","그만둔다"
ELSE
	;労役実行確認省略設定が有効な場合、実行確認は無条件で実行する(0)を設定
	RESULT = 0
ENDIF

IF RESULT == 0
	PRINTFORMW %CALLNAME:依頼キャラ%에게 일을 맡깁니다
	PRINTL 　
ELSE
	
ENDIF
	;キャラ選択に戻る
	GOTO IRAI_TOP
	
@CASTING_IRAI(ARG)
;非戦闘員不可
SIF TALENT:ARG:비전투원
	RETURN 0
;この場にいない不可
SIF CFLAG:ARG:이자리에없는플래그
	RETURN 0
SIF CFLAG:ARG:전투이외불능
	RETURN 0
;陥落素質のついたキャラのみ可能
SIF !(TALENT:ARG:3 || TALENT:ARG:4 || TALENT:ARG:5 || TALENT:ARG:6 || TALENT:ARG:7 || TALENT:ARG:8)
	RETURN 0
;他の労役中は不可
SIF CFLAG:ARG:노역플래그 > 0
	RETURN 0
SIF TALENT:ARG:반역
	RETURN 0
;戦闘参加不可能を除外
SIF GET_VALUE_TALENT_JOINABLE(ARG) == 0
	RETURN 0
SIF BASE:ARG:체력 < 500
	RETURN 0
RETURN 1

@CHOICE_IRAI(ARG)
PRINTFORML
PRINTFORML 의뢰의 내용을 선택해 주십시오
PRINTFORML
FOR (LOCAL:1), 1, 4
	IF LOCAL:1 == 1
	PRINTFORM [{LOCAL:1}]퇴치
	
	ELSEIF LOCAL:1 == 2
	PRINTFORM [{LOCAL:1}]수사
	
	ELSEIF LOCAL:1 == 3
	PRINTFORM [{LOCAL:1}]회수
	
	ENDIF

	PRINTL 
NEXT
PRINTL 

PRINTFORML [99]돌아간다

INPUT
IF RESULT == 99
	RETURN -1
ELSEIF RESULT == 1
	CFLAG:ARG:노역플래그 = 7
	CFLAG:ARG:노역진행도 = 0
	RETURN
ELSEIF RESULT == 2
	CFLAG:ARG:노역플래그 = 8
	CFLAG:ARG:노역진행도 = 0
	RETURN
ELSEIF RESULT == 3
	CFLAG:ARG:노역플래그 = 9
	CFLAG:ARG:노역진행도 = 0
	RETURN
ENDIF
;==========================================================
;@END_IRAI
; 依頼の進行度処理
;<引数>
;	ARG = 労役を行うキャラの登録番号
;<戻り値>
;	なし
;==========================================================

@END_IRAI,ARG

#DIM 仕事量 = 1
#DIM 報酬 = 0
#DIM 仕事経験値
#DIM 仕事難易度差


CUSTOMDRAWLINE ･

;退治依頼の場合
IF CFLAG:ARG:노역플래그 == 7
	;依頼の進行度をランダムで増加、最低保証値(800)+RAND値で長くても9日以内には終わる設定
	CFLAG:ARG:노역진행도 += (800 + RAND:1400)
	
	;依頼の進行度ごとに表示するテキストを変更
	IF CFLAG:ARG:노역진행도 < 1500
		PRINTFORML %CALLNAME:ARG%은(는) 일의 준비를 하고 있다
		CALL PRINT_COLORBAR, CFLAG:ARG:노역진행도, 13000, 25, UNICODE(0x2584), UNICODE(0x2584), 0X71B33C, 0XFFFFFF
		PRINTFORML  {(CFLAG:ARG:노역진행도 * 100) / 13000} ％
	ELSEIF CFLAG:ARG:노역진행도 < 13000
		PRINTFORML %CALLNAME:ARG%은(는) 일을 진행하고 있다
		CALL PRINT_COLORBAR, CFLAG:ARG:노역진행도, 13000, 25, UNICODE(0x2584), UNICODE(0x2584), 0X71B33C, 0XFFFFFF
		PRINTFORML  {(CFLAG:ARG:노역진행도 * 100) / 13000} ％
	;依頼の進行度が13000を超えた場合、依頼完了で完了時の処理を行う
	ELSE
		IF BASE:ARG:LV <20
			PRINTFORML %CALLNAME:ARG%은(는) 의뢰의 장소에 가, 악마를 퇴치했다
			報酬 = (200 + (RAND:200)) * (((BASE:ARG:힘 + BASE:ARG:마력 + BASE:ARG:내구 + BASE:ARG:속도)/4) + BASE:ARG:LV )
			仕事難易度差 = RAND:20 - BASE:ARG:LV
			仕事難易度差 = MAX(ABS(仕事難易度差), 1)
			仕事経験値 = 500 / 仕事難易度差
		ELSEIF BASE:ARG:LV >=20 && BASE:ARG:LV <40
			PRINTFORML %CALLNAME:ARG%은(는) 의뢰의 장소에 가, 악마 무리를 퇴치했다
			報酬 = (1100 + (RAND:500)) * (((BASE:ARG:힘 + BASE:ARG:마력 + BASE:ARG:내구 + BASE:ARG:속도)/4) + BASE:ARG:LV )
			仕事難易度差 = RAND:40 - BASE:ARG:LV
			仕事難易度差 = MAX(ABS(仕事難易度差), 1)
			仕事経験値 = 1500 / 仕事難易度差
		ELSE
			PRINTFORML %CALLNAME:ARG%은(는) 의뢰의 장소에 가, 이계의 주인을 퇴치했다
			報酬 = (2000 + (RAND:1000)) * (((BASE:ARG:힘 + BASE:ARG:마력 + BASE:ARG:내구 + BASE:ARG:속도)/4) + BASE:ARG:LV )
			仕事難易度差 = RAND:120 - BASE:ARG:LV
			仕事難易度差 = MAX(ABS(仕事難易度差), 1)
			仕事経験値 = 3000 / 仕事難易度差
		ENDIF
		CALL PRINT_COLORBAR, 13000, 13000, 25, UNICODE(0x2584), UNICODE(0x2584), 0X71B33C, 0XFFFFFF
		PRINTFORML  100 ％ 완료★
		CFLAG:ARG:노역진행도 = 0
		PRINTFORML {報酬}￥의 보수를 얻었다
		PRINTFORML {仕事経験値}의 경험치를 얻었다
		BASE:ARG:ＥＸＰ += 仕事経験値
		CALL CHECK_LEVEL_UP,ARG
	ENDIF
ENDIF

;捜査依頼の場合
IF CFLAG:ARG:노역플래그 == 8
	CFLAG:ARG:노역진행도 += (800 + RAND:1400)
	IF CFLAG:ARG:노역진행도 < 1500
		PRINTFORML %CALLNAME:ARG%은(는) 일의 준비를 하고 있다
		CALL PRINT_COLORBAR, CFLAG:ARG:노역진행도, 13000, 25, UNICODE(0x2584), UNICODE(0x2584), 0X71B33C, 0XFFFFFF
		PRINTFORML  {(CFLAG:ARG:노역진행도 * 100) / 13000} ％
	ELSEIF CFLAG:ARG:노역진행도 < 13000
		PRINTFORML %CALLNAME:ARG%은(는) 일을 진행하고 있다
		CALL PRINT_COLORBAR, CFLAG:ARG:노역진행도, 13000, 25, UNICODE(0x2584), UNICODE(0x2584), 0X71B33C, 0XFFFFFF
		PRINTFORML  {(CFLAG:ARG:노역진행도 * 100) / 13000} ％
	ELSEIF CFLAG:ARG:노역진행도 >= 13000
		IF BASE:ARG:LV <20
			PRINTFORML %CALLNAME:ARG%은(는) 의뢰의 장소에 가, 출현하는 악마의 종류를 조사했다
			報酬 = (200 + (RAND:200)) * (((BASE:ARG:지혜 + BASE:ARG:마력 + BASE:ARG:속도)/3) + BASE:ARG:LV )
			仕事難易度差 = RAND:20 - BASE:ARG:LV
			仕事難易度差 = MAX(ABS(仕事難易度差), 1)
			仕事経験値 = 500 / 仕事難易度差
		ELSEIF BASE:ARG:LV >=20 && BASE:ARG:LV <40
			PRINTFORML %CALLNAME:ARG%은(는) 의뢰의 장소에 가, 이변의 원인이 된 괴이를 특정했다
			報酬 = (1100 + (RAND:500)) * (((BASE:ARG:지혜 + BASE:ARG:마력 + BASE:ARG:속도)/3) + BASE:ARG:LV )
			仕事難易度差 = RAND:40 - BASE:ARG:LV
			仕事難易度差 = MAX(ABS(仕事難易度差), 1)
			仕事経験値 = 1500 / 仕事難易度差
		ELSE
			PRINTFORML %CALLNAME:ARG%은(는) 의뢰인에게서 받은 단서를 바탕으로, 이계에서 행방불명자를 발견했다
			報酬 = (2000 + (RAND:1000)) * (((BASE:ARG:지혜 + BASE:ARG:마력 + BASE:ARG:속도)/3) + BASE:ARG:LV )
			仕事難易度差 = RAND:120 - BASE:ARG:LV
			仕事難易度差 = MAX(ABS(仕事難易度差), 1)
			仕事経験値 = 3000 / 仕事難易度差
		ENDIF
		CALL PRINT_COLORBAR, 13000, 13000, 25, UNICODE(0x2584), UNICODE(0x2584), 0X71B33C, 0XFFFFFF
		PRINTFORML  100 ％ 완료★
		CFLAG:ARG:노역진행도 = 0
		PRINTFORML {報酬}￥의 보수를 얻었다
		PRINTFORML {仕事経験値}의 경험치를 얻었다
		BASE:ARG:ＥＸＰ += 仕事経験値
		CALL CHECK_LEVEL_UP,ARG
	ENDIF
ENDIF

;回収依頼の場合
IF CFLAG:ARG:노역플래그 == 9
	CFLAG:ARG:노역진행도 += (800 + RAND:1400)
	IF CFLAG:ARG:노역진행도 < 1500
		PRINTFORML %CALLNAME:ARG%은(는) 일의 준비를 하고 있다
		CALL PRINT_COLORBAR, CFLAG:ARG:노역진행도, 13000, 25, UNICODE(0x2584), UNICODE(0x2584), 0X71B33C, 0XFFFFFF
		PRINTFORML  {(CFLAG:ARG:노역진행도 * 100) / 13000} ％

	ELSEIF CFLAG:ARG:노역진행도 < 13000
		PRINTFORML %CALLNAME:ARG%은(는) 일을 진행하고 있다
		CALL PRINT_COLORBAR, CFLAG:ARG:노역진행도, 13000, 25, UNICODE(0x2584), UNICODE(0x2584), 0X71B33C, 0XFFFFFF
		PRINTFORML  {(CFLAG:ARG:노역진행도 * 100) / 13000} ％
	ELSEIF CFLAG:ARG:노역진행도 >= 13000
		IF BASE:ARG:LV <20
			PRINTFORML %CALLNAME:ARG%은(는) 의뢰의 장소에 가, 유물을 회수했다
			報酬 = (200 + (RAND:200)) * (((BASE:ARG:지혜 + BASE:ARG:마력 + BASE:ARG:운)/3) + BASE:ARG:LV )
			仕事難易度差 = RAND:20 - BASE:ARG:LV
			仕事難易度差 = MAX(ABS(仕事難易度差), 1)
			仕事経験値 = 500 / 仕事難易度差
		ELSEIF BASE:ARG:LV >=20 && BASE:ARG:LV <40
			PRINTFORML %CALLNAME:ARG%은(는) 의뢰의 장소에 가, 귀중한 촉매를 회수했다
			報酬 = (1100 + (RAND:500)) * (((BASE:ARG:지혜 + BASE:ARG:마력 + BASE:ARG:운)/3) + BASE:ARG:LV )
			仕事難易度差 = RAND:40 - BASE:ARG:LV
			仕事難易度差 = MAX(ABS(仕事難易度差), 1)
			仕事経験値 = 1500 / 仕事難易度差
		ELSE
			PRINTFORML %CALLNAME:ARG%은(는) 의뢰의 장소에 가, 귀중한 촉매를 회수했다
			報酬 = (2000 + (RAND:1000)) * (((BASE:ARG:지혜 + BASE:ARG:마력 + BASE:ARG:운)/3) + BASE:ARG:LV )
			仕事難易度差 = MAX(ABS(仕事難易度差), 1)
			仕事経験値 = 3000 / 仕事難易度差
		ENDIF
		CALL PRINT_COLORBAR, 13000, 13000, 25, UNICODE(0x2584), UNICODE(0x2584), 0X71B33C, 0XFFFFFF
		PRINTFORML  100 ％ 완료★
		CFLAG:ARG:노역진행도 = 0
		PRINTFORML {報酬}￥의 보수를 얻었다
		PRINTFORML {仕事経験値}의 경험치를 얻었다
		BASE:ARG:ＥＸＰ += 仕事経験値
		CALL CHECK_LEVEL_UP,ARG
	ENDIF
ENDIF

PRINTFORML %CALLNAME:ARG% 체력　:{BASE:ARG:체력,4}　→　{BASE:ARG:체력 - (仕事量 * 400)}

BASE:ARG:체력 -= (仕事量 * 400 )

PRINTFORML 

MONEY += 報酬
報酬 = 0

PRINTW

CALL 気絶処理,ARG

PRINTL
