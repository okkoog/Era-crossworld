@CLOTHES_MESSAGE, ARG, ARG:1, ARG:2
PRINTFORM %조사처리(GET_衣装名(CFLAG:(ARG:2):(GET_CLOTHESNAME(ARG))), "을")% 
IF ARG:1	;着る/着せる
	SELECTCASE ARG
		CASE 0, 4, 5, 11, 12, 13	;모자/손/속옷（상）/그외
			IF ARG:2 == PLAYER
				PRINTW 착용했다
			ELSE
				PRINTW 착용시켰다
			ENDIF
		CASE 1, 3, 7, 10	;옷/전신복/전신속옷/겉옷
			IF ARG:2 == PLAYER
				PRINTW 입었다
			ELSE
				PRINTW 입혔다
			ENDIF
		CASE 2, 6, 8, 9		;하의/속옷（하）/양말/신발
			IF ARG:2 == PLAYER
				PRINTW 입었다
			ELSE
				PRINTW 입혔다
			ENDIF
	ENDSELECT
;脱ぐ/脱がせる
ELSE
	;그외
	IF ARG == 11 || ARG == 12 || ARG == 13
		IF ARG:2 == PLAYER
			PRINTW 풀었다
		ELSE
			PRINTW 벗게 했다
		ENDIF
	;その他以外
	ELSE
		IF ARG:2 == PLAYER
			PRINTW 벗었다
		ELSE
			PRINTW 벗겼다
		ENDIF
	ENDIF
ENDIF

