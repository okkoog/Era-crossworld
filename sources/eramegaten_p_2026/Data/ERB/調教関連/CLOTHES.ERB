;選別
FOR LOCAL,1,1500
	;SIF ITEM:(6000+LOCAL) < 1 && CSVCFLAG(NO:ARG,40+GET_CLOTHES(GET_CLOTHESNAME(ARG:1)),0) != LOCAL && CFLAG:ARG:(60+GET_CLOTHES(GET_CLOTHESNAME(ARG:1))) != LOCAL
	SIF ITEM:(6000+LOCAL) < 1 && CSVCFLAG(NO:ARG,40+GET_CLOTHES(GET_CLOTHESNAME(LOCAL:4)),0) != LOCAL && CFLAG:ARG:(60+GET_CLOTHES(GET_CLOTHESNAME(LOCAL:4))) != LOCAL
		CONTINUE
	RESULT = 12
	TRYCALLFORM CLOTHES_PART_{LOCAL}
	;SIF RESULT != ARG:1
	SIF RESULT != (LOCAL:4)
		CONTINUE
	RESULT = 1
	TRYCALLFORM CLOTHES_PREREQUISITE_{LOCAL},ARG
	SIF RESULT == 0
		CONTINUE
	;アイテム名の長さを保存
	SIF STRLENS(GET_衣装名(LOCAL)) > LOCAL:3
		LOCAL:3 = STRLENS(GET_衣装名(LOCAL))
	G:(LOCAL:1) = LOCAL
	LOCAL:1 += 1
NEXT
;表示
IF LOCAL:1
	FOR LOCAL , 0 , LOCAL:1
		PRINTFORM [{G:LOCAL,4}] 
		IF G:LOCAL == CFLAG:ARG:GET_CLOTHESNAME(ARG:1)
			LOCAL:2 = GETCOLOR()
			SETCOLOR COLOR("PASTEL-BLUE")
			PRINTFORM %GET_衣装名(G:LOCAL),LOCAL:3,LEFT%
			SETCOLOR LOCAL:2
		ELSE
			PRINTFORM %GET_衣装名(G:LOCAL),LOCAL:3,LEFT%
		ENDIF
		SIF LOCAL % 3 == 2
			PRINTL
	NEXT
ENDIF
SIF !LINEISEMPTY()
	PRINTL
PRINTL
PRINTL [   0] 착용하지 않는다
DRAWLINE
PRINT [ 100] 돌아간다


$INPUT_LOOP
INPUT
IF RESULT == 0
	CFLAG:ARG:GET_CLOTHESNAME(ARG:1) = 0
ELSEIF RESULT == 100
	RETURN 0
ELSEIF MATCH(G,RESULT,0) > 0
	;SIF ARG:1 == 1 || ARG:1 == 2
	;	CFLAG:ARG:전신복 = 0
	;IF ARG:1 == 3
	;	CFLAG:ARG:옷 = 0
	;	CFLAG:ARG:하의 = 0
	;ENDIF
	SIF ARG:1 == 5 || ARG:1 == 6
		CFLAG:ARG:전신속옷 = 0
	IF ARG:1 == 7
		CFLAG:ARG:속옷（상） = 0
		CFLAG:ARG:속옷（하） = 0
	ENDIF
		
	CFLAG:ARG:GET_CLOTHESNAME(ARG:1) = RESULT
	SIF CFLAG:ARG:GET_CLOTHESNAME(ARG:1)
		CFLAG:ARG:23 |= POWER(2,ARG:1)
ELSE
	GOTO INPUT_LOOP
