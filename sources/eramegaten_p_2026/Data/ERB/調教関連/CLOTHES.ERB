RETURN 1

@CLOTHES_SETTING_USUALLY_A,ARG
#DIM DYNAMIC TEMPNUM
LOCAL:3 = RESULT, LINECOUNT
DO
	CLEARLINE LINECOUNT - LOCAL:4
	;LOCAL:1 = -1, -1
	;FOR LOCAL, ARG - 1, -1, -1
	;	IF CFLAG:LOCAL:이자리에없는플래그 !| CFLAG:LOCAL:필터링플래그
	;		LOCAL:1 = LOCAL	;前のキャラ
	;		BREAK
	;	ENDIF
	;NEXT
	;FOR LOCAL, ARG + 1, CHARANUM
	;	IF CFLAG:LOCAL:이자리에없는플래그 !| CFLAG:LOCAL:필터링플래그
	;		LOCAL:2 = LOCAL	;次のキャラ
	;		BREAK
	;	ENDIF
	;NEXT
	PRINTL 착의 변경을 원하는 부위를 선택해주세요
	PRINTL
	PRINTFORML □%NAME:ARG%의 복장
	DRAWLINE
	FOR LOCAL, 0, 14
		PRINTFORML [{LOCAL, 3}] %GET_CLOTHESNAME(LOCAL), 14, LEFT%: \@ CFLAG:ARG:GET_CLOTHESNAME(LOCAL) ? %CLOTHESNAMEF(ARG, LOCAL)% # \@
	NEXT
	DRAWLINE

	PRINTL [ 99] 착의설정을 초기화
	PRINTFORMLC \@ Q:1 >= 0 ? [107] 이전캐릭터 # %" " * 16% \@
	PRINTFORMLC [100] 돌아간다
	PRINTFORMLC \@ Q:1 >= 0 ? [109] 다음캐릭터 # %" " * 16% \@
	DO
		INPUT
		LOCAL = INRANGE(RESULT, 0, 13) || INRANGE(RESULT, 99, 100) || (RESULT == 107 && LOCAL:1 >= 0) || (RESULT == 109 && LOCAL:2 >= 0)
		SIF !LOCAL
			CLEARLINE 1
	LOOP !LOCAL
	LOCAL = RESULT
	SELECTCASE RESULT
		CASE 0 TO 13
			CALL CLOTHES_SETTING_PART, ARG, RESULT
		CASE 99
			CALL CLOTHES_INITIALIZE, ARG
			PRINTFORMW ＜%NAME:ARG%의 복장을 초기화 했습니다＞
		CASE 107
			TEMPNUM = FINDELEMENT(Q, ARG) - 1
			IF TEMPNUM < 0
				ARG = Q:(FINDELEMENT(Q, -1) - 1)
			ELSE
				ARG = Q:TEMPNUM
			ENDIF
		CASE 109
			TEMPNUM = FINDELEMENT(Q, ARG) + 1
			IF Q:TEMPNUM < 0
				ARG = Q:0
			ELSE
				ARG = Q:TEMPNUM
			ENDIF
	ENDSELECT
LOOP LOCAL != 100
RETURN LOCAL:3



@CLOTHES_SETTING_PART, ARG, ARG:1
