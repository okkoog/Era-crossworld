;	ENDIF
;NEXT
;FOR LCOUNT, 0, 12
;	IF TEQUIP:ARG:(GET_CLOTHESNAME(LCOUNT)) > 0
;		IF ARG == PLAYER
;			PRINTL [30] すべて脱ぐ
;		ELSE
;			PRINTL [30] すべて脱がす
;		ENDIF
;		BREAK
;	ENDIF
;NEXT
;FOR LCOUNT, 0, 12
;	IF TEQUIP:ARG:(GET_CLOTHESNAME(LCOUNT)) == 0 && CFLAG:ARG:(GET_CLOTHESNAME(LCOUNT))
;		IF ARG == PLAYER
;			PRINTL [40] すべて着る
;		ELSE
;			PRINTL [40] すべて着せる
;		ENDIF
;		BREAK
;	ENDIF
;NEXT
;SIF  (TEQUIP:ARG:가슴구조 & 1 || TEQUIP:ARG:가슴구조 & 2 || TEQUIP:ARG:가슴구조 & 4 || TEQUIP:ARG:가슴구조 & 8 || TEQUIP:ARG:가슴구조 & 16) 
;	LOCAL:1 = 1
;SIF TEQUIP:ARG:가슴구조 > 0 && LOCAL:1 && FLAG:SHOP커맨드 != [[ショップ:의상방]] && FLAG:SHOP커맨드 != [[ショップ:옵션]]
;	PRINTFORML [98]\@ TEQUIP:ARG:가슴앞열림 ? 胸をしまう # 胸を出す \@
;PRINTL [100]戻る
LINE:1 = LINECOUNT
$INPUT_LOOP
CLEARLINE LINECOUNT - LINE:1
INPUT
SIF RESULT == 999
	RETURN 0
LOCAL = RESULT % 100
LOCAL:1 = (RESULT) / 100
CHARA = -1
SIF LOCAL:1 == 0
	CHARA = ARG
SIF LOCAL:1 == 1
	CHARA = MASTER
SIF LOCAL:1 == 2
	CHARA = ASSI
SIF CHARA == -1
	GOTO START
;胸の開閉
;ELSEIF RESULT == 98 && TEQUIP:ARG:가슴구조 > 0 && LOCAL:1 && FLAG:SHOP커맨드 != [[ショップ:의상방]] && FLAG:SHOP커맨드 != [[ショップ:옵션]]
IF LOCAL == 98
	非表示:(LOCAL:1) = 0
ELSEIF LOCAL == 99 && RESULT > 0
	非表示:(LOCAL:1) = 1
ELSEIF (LOCAL == 60 || LOCAL == 61) && (TEQUIP:CHARA:가슴앞열림 == LOCAL % 10) && 胸開放可能:(LOCAL:1)
	INVERTBIT TEQUIP:CHARA:가슴앞열림 , 0
	TFLAG:13 = 44
	SWAP CHARA , TARGET
	CALL KOJO_MESSAGE_EVENT
	SWAP TARGET , CHARA
	口上チェック可 = 0
;股間の開閉
ELSEIF (LOCAL == 70 || LOCAL == 71) && (TEQUIP:CHARA:고간앞열림 == LOCAL % 10) && 股間開放可能:(LOCAL:1)
	INVERTBIT TEQUIP:CHARA:고간앞열림 , 0
	TFLAG:13 = 96
	SWAP CHARA , TARGET
	CALL KOJO_MESSAGE_EVENT
	SWAP TARGET , CHARA
	口上チェック可 = 0
	
	;EVENT_Mで設定していたVずらし中の状態をこちらで設定するように変更
	IF TEQUIP:CHARA:고간앞열림
		TEQUIP:CHARA:V비켜놓기중 = -1
		TEQUIP:CHARA:음순노출 = -1
		TEQUIP:CHARA:음순보임 = -1
	ELSEIF !TEQUIP:CHARA:고간앞열림
		TEQUIP:CHARA:V비켜놓기중 = 0
		TEQUIP:CHARA:음순노출 = 0
		TEQUIP:CHARA:음순보임 = 0
	ENDIF

;すべて脱がせる
ELSEIF LOCAL == 51
	FOR LCOUNT, 0, 14
		TEQUIP:CHARA:(GET_CLOTHESNAME(LCOUNT)) = 0
	NEXT
;すべて着せる
ELSEIF LOCAL == 50
	FOR LCOUNT, 0, 14
		TEQUIP:CHARA:(GET_CLOTHESNAME(LCOUNT)) = CFLAG:CHARA:(GET_CLOTHESNAME(LCOUNT))
	NEXT
;服を着せる場合
ELSEIF LOCAL < 20
	IF TEQUIP:CHARA:(GET_CLOTHESNAME(LOCAL)) == 0 && CFLAG:CHARA:(GET_CLOTHESNAME(LOCAL))
		IF LOCAL == 3
			TEQUIP:CHARA:옷 = 0
			TEQUIP:CHARA:하의 = 0
		ELSEIF LOCAL == 1 || LOCAL == 2
			TEQUIP:CHARA:전신복 = 0
		ELSEIF LOCAL == 5 || LOCAL == 6
			TEQUIP:CHARA:전신속옷 = 0
		ELSEIF LOCAL == 7
			TEQUIP:CHARA:속옷（상） = 0
			TEQUIP:CHARA:속옷（하） = 0
		ENDIF
		TEQUIP:CHARA:(GET_CLOTHESNAME(LOCAL)) = CFLAG:CHARA:(GET_CLOTHESNAME(LOCAL))
	ELSE
		GOTO INPUT_LOOP
	ENDIF
	;着せる処理の後にテキストを呼ぶ
	;--- 003 MOD ---
	TRYCCALLFORM CLOTHES_MESSAGE%口上関数末尾文字(CHARA)%, LOCAL, 1, CHARA
	CATCH
		CALL CLOTHES_MESSAGE,LOCAL,1,CHARA
	ENDCATCH
;服を脱がせる場合
ELSEIF LOCAL < 40
	LOCAL -= 20
	;着ていない場合は再入力
	SIF TEQUIP:CHARA:(GET_CLOTHESNAME(LOCAL)) == 0
		GOTO INPUT_LOOP
	;脱がせる処理の前にテキストを呼ぶ
	;--- 003 MOD ---
	TRYCCALLFORM CLOTHES_MESSAGE%口上関数末尾文字(CHARA)%, LOCAL, 0, CHARA
	CATCH
		CALL CLOTHES_MESSAGE,LOCAL, 0, CHARA
	ENDCATCH
	TEQUIP:CHARA:(GET_CLOTHESNAME(LOCAL)) = 0
ELSE
	GOTO INPUT_LOOP
ENDIF

CALL おっぱいオープンチェック(CHARA)
CALL CHECK_EXPOSE(CHARA)
CALL 股間構造チェック,CHARA
CALL 触覚チェック(CHARA)
CALL ずらしチェック(CHARA)
IF 口上チェック可
	SIF CHARA == TARGET
		LOCAL:1 = 0
	SIF CHARA == MASTER
		LOCAL:1 = 1
	SIF CHARA == ASSI
		LOCAL:1 = 2
	TFLAG:13 = 0
	IF 陰唇露出状態:(LOCAL:1) >= 0 && TEQUIP:CHARA:음순노출 == -1
		IF 乳房露出状態:(LOCAL:1) >= 0 && TEQUIP:CHARA:유방노출 == -1
			TFLAG:13 = 70+LOCAL:1
		ELSE
			TFLAG:13 = 73+LOCAL:1
		ENDIF
	ELSE
		SIF 乳房露出状態:(LOCAL:1) >= 0 && TEQUIP:CHARA:유방노출 == -1
			TFLAG:13 = 76+LOCAL:1
	ENDIF
	IF TFLAG:13
		SWAP CHARA , TARGET
		CALL KOJO_MESSAGE_EVENT
		SWAP TARGET , CHARA
	ENDIF
;	IF 陰唇露出状態:(LOCAL:1) == -1 && TEQUIP:CHARA:陰唇露出陰唇 >= 0
;		IF 乳房露出状態:(LOCAL:1) == -1 && TEQUIP:CHARA:유방노출 >= 0
;		ELSE
;		ENDIF
;	ELSE
;		IF 乳房露出状態:(LOCAL:1) == -1 && TEQUIP:CHARA:유방노출 >= 0
;		ENDIF
;	ENDIF
ENDIF
GOTO START
