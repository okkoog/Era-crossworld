;-------------------------------------------------
;着衣の状態によって、調教中のソースが若干変動する
;-------------------------------------------------
@EQUIP_CLOTHES
;着衣状態によるソースを付加（手以外の１箇所ごとに露出+5、未陥落時反感+5）
;EQUIPによる制御に変更するまで封印
;予定・胸とヴァギナが露出するような組み合わせだとさらに＋5
IF TEQUIP:다리노출 == -1		;다리노출
	SOURCE:노출 += 3
	SOURCE:반감 += 3 * !陥落()	;陥落時は反感を加算しない。以下同様
ENDIF
IF TEQUIP:배꼽노출 == -1		;배꼽노출
	SOURCE:노출 += 3
	SOURCE:반감 += 3 * !陥落()
ENDIF
IF TEQUIP:유방노출 == -1	;유방노출
	SOURCE:노출 += 3
	SOURCE:반감 += 3 * !陥落()
ENDIF
IF TEQUIP:유두노출 == -1	;유두노출。乳房は隠れているのに乳首が出てたら+6
	SOURCE:노출 += (10 + (6 * (TEQUIP:유방노출 != -1)))
	SOURCE:반감 += (10 + (6 * (TEQUIP:유방노출 != -1))) * !陥落()
ENDIF
IF TEQUIP:음순노출 == -1	;음순노출。脚は隠れているのに陰唇が出てたら+3、臍は隠れているのに陰唇が出てたら+3
	SOURCE:노출 += (10 + (3 * (TEQUIP:다리노출 != -1)) + (3 * (TEQUIP:배꼽노출 != -1)))
	SOURCE:반감 += (10 + (3 * (TEQUIP:다리노출 != -1)) + (3 * (TEQUIP:배꼽노출 != -1))) * !陥落()
ENDIF
IF TEQUIP:둔부노출 == -1	;둔부노출
	SOURCE:노출 += 10
	SOURCE:반감 += 10 * !陥落()
ENDIF
RETURN RESULT

