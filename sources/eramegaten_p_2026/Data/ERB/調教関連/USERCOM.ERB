;---------------------------------------------------
;調教コマンドリストの獲得処理
;---------------------------------------------------
;実行可能コマンドの取得用変数を初期化
VARSET Q, -1
;派生コマンド用の取得変数を初期化
VARSET R, -1
Z= 0
;CALLTRAIN時は表示しない
SIF TFLAG:CALLTRAIN
	RETURN 0
;コマンドを全てチェック
LOCAL:1 = -1
VARS L_LB_COLOR
L_LB_COLOR = %TOSTR_HTML(BGCOLOR("LIGHT-BLACK"))%
FOR LOCAL, 0, 1000
	;名前の長さが0の場合、ないものとみなす
	SIF STRLENS(TRAINNAME:LOCAL) == 0
		CONTINUE
	;派生コマンドは蹴る
	TRYCCALLFORM COMTYPE_{LOCAL}
		SIF RESULT == COMTYPE("派生系")
			CONTINUE
	CATCH
	ENDCATCH
	LOCAL:1++
	;COMABLEをチェック
	CALL COM_ABLE_COMMON_D, LOCAL
	SIF RESULT == 0
		CONTINUE
	;派生コマンドになるかどうかをチェック
	TRYCCALLFORM JUMP_COM{LOCAL}
		LOCAL:2 = RESULT >= 0 ? RESULT # LOCAL	
		;COMABLEをチェック
		CALL COM_ABLE_COMMON_D, LOCAL:2
		SIF RESULT == 0
			LOCAL:2 = LOCAL
	CATCH
		LOCAL:2 = LOCAL
	ENDCATCH
	;MENU配列に実行可能なコマンドを登録していく
	Q:(LOCAL:1) = LOCAL:2
	;フィルタ関係は派生前でチェックするので注意
	SIF GET_COM_FILTERING(LOCAL, TARGET)
		CONTINUE
		
	;---- EDIT 008 MOD START -------------------------
	;COMTYPE呼び出し
	LOCAL:3 = -1
	TRYCCALLFORM COMTYPE_{LOCAL}
		LOCAL:3 = RESULT
		SIF CFLAG:(170+RESULT) == 1
			CONTINUE
	CATCH
	ENDCATCH
	
	;なんの系統でもない調教コマンドは帰る
	SIF LOCAL:3 == -1
		CONTINUE
	
	;すでに表示されているコマンドがここまで来た場合は帰る
	SIF MATCH(R, LOCAL:2)
		CONTINUE
	;コマンド表示
	TRYCCALLFORM COMNAME{LOCAL:2}
		;その調教系統のCOMリストに放り込む。"_"で区切る。
		COMLIST_TYPE:(LOCAL:3):(COUNT_COMTYPE:(LOCAL:3)) = <button value='{LOCAL:1}' title='%RESULTS%'>[{LOCAL:1 , 3}]%ARRANGE_STRLENS(RESULTS , L_COMSTRLENS-6) , L_COMSTRLENS-6 , LEFT %</button>
		;PRINTFORMC %RESULTS%[{LOCAL:1,3}]
	CATCH
		LOCALS = %TRAINNAME:(LOCAL:2)%
		COMLIST_TYPE:(LOCAL:3):(COUNT_COMTYPE:(LOCAL:3)) = <button value='{LOCAL:1}' title='%LOCALS%'>[{LOCAL:1 , 3}]%ARRANGE_STRLENS(LOCALS, L_COMSTRLENS-6) , L_COMSTRLENS-6 , LEFT%</button>
		;PRINTFORMC %TRAINNAME:(LOCAL:2)%[{LOCAL:1,3}]
	ENDCATCH
	;口上などで次のコマンドに指定されている場合光る
	SIF MATCH(INDICATE_COM , LOCAL:2)
		COMLIST_TYPE:(LOCAL:3):(COUNT_COMTYPE:(LOCAL:3)) = <div background_color='%L_LB_COLOR%'><b>%COMLIST_TYPE:(LOCAL:3):(COUNT_COMTYPE:(LOCAL:3))%</b></div>
	;	COMLIST_TYPE:(LOCAL:3):(COUNT_COMTYPE:(LOCAL:3)) =<b><i><u><font color='%TOSTR_HTML(COLOR("パ赤"))%'>%COMLIST_TYPE:(LOCAL:3):(COUNT_COMTYPE:(LOCAL:3))%</font></b></i></u>
	COUNT_COMTYPE:(LOCAL:3)++
	;ここまできたら表示されたものとして登録される
	R:(LOCAL:1) = LOCAL:2
	;改行処理
	;CALL CHECK_NEWLINE
	
	;---- EDIT 008 MOD END -------------------------
NEXT

;---------------------------------------------------
;オプション系コマンドリストの獲得処理
;---------------------------------------------------
;USERCOM_LIST →表示されるオプション系コマンドのリスト
VARSET USERCOM_LIST , ""
VARSET TRAINMENU_LIST , ""
LOCAL:3 = 0
;[750]フィルターを全部イッパツで開閉するボタン
;いくつ閉じているかをカウント（※フラグが１で閉じる）（半分以上閉じてたら「開放」、そうでなければ閉じる）
FILTERCOUNT = 0
FOR LCOUNT, GETNUM(CFLAG , "애무계필터"), GETNUM(CFLAG , "애무계필터")+16
	SIF CFLAG:TARGET:LCOUNT > 0
		FILTERCOUNT += 1
NEXT
IF FILTERCOUNT > 8
	USERCOM_LIST:(LOCAL:3++) = <button value='750'>[750]전커맨드개방</button>
ELSE
	USERCOM_LIST:(LOCAL:3++) = <button value='750'>[750]전커맨드폐쇄</button>
ENDIF
USERCOM_LIST:(LOCAL:3++) = <button value='751'>[751]% 調教画面旧表示 == 0 ? "구" # "신"%조교화면표시</button>

IF !CFLAG:TARGET:옵션필터
	USERCOM_LIST:(LOCAL:3++) = <button value='800'>[800]이력표시</button>
	USERCOM_LIST:(LOCAL:3++) = <button value='801'>[801]더러움표시</button>
	USERCOM_LIST:(LOCAL:3++) = <button value='802'>[802]능력표시</button>
	USERCOM_LIST:(LOCAL:3++) = <button value='803'>[803]착의설정</button>
	USERCOM_LIST:(LOCAL:3++) = <button value='804'>[804]전원착의</button>
	USERCOM_LIST:(LOCAL:3++) = <button value='805'>[805]전원탈의</button>
	IF HAVE_PENIS(PLAYER) || HAVE_PENIS(TARGET)
		SIF ITEM:콘돔 > 0
			USERCOM_LIST:(LOCAL:3++) = <button value='806'>[806]콘돔설정</button>
		USERCOM_LIST:(LOCAL:3++) = <button value='807'>[807]자동사정대상변경설정</button>
	ENDIF
	USERCOM_LIST:(LOCAL:3++) = <button value='808'>[808]능력표시(%(ASSIPLAY ? "조수" # "마스터")%</button>
	SIF (!(CFLAG:초기주도권 || TALENT:쾌감을부정 || TALENT:저항 || TALENT:억압) && TALENT:남자 ) || ABL:순종 > 2
		USERCOM_LIST:(LOCAL:3++) = <button value='809'>[809]주도권을 % TEQUIP:주도권 ? "받는다" # "넘긴다" %</button>
	IF ASSI >= 0
		IF ASSIPLAY && TEQUIP:촉수 == 0
			USERCOM_LIST:(LOCAL:3++) = <button value='900'>[900]마스터와 교대</button>
		ELSEIF TEQUIP:촉수 == 0
			USERCOM_LIST:(LOCAL:3++) = <button value='900'>[900]조수와 교대</button>
		ENDIF
	ENDIF
	USERCOM_LIST:(LOCAL:3++) = <button value='902'>[902]ＭＡＧ흡수(%(CFLAG:TARGET:ＭＡＧ비피흡수 == 1) ? "OFF" # "ON"%)</button>
	USERCOM_LIST:(LOCAL:3++) = <button value='906'>[906]ＭＡＧ양도(%(CFLAG:PLAYER:ＭＡＧ비피흡수 == 1) ? "OFF" # "ON"%)</button>
	USERCOM_LIST:(LOCAL:3++) = <button value='907'>[907]커맨드 필터</button>

	USERCOM_LIST:(LOCAL:3++) = <button value='908'>[908]얼굴그래픽 설정</button>
	
	;調教メニュー登録周り
	;場所は決め打ち オプション表示位置次第
	IF GROUPMATCH(調教オプション表示位置 , "右" , "左") || 調教画面旧表示
		LOCAL:3 = NUM_COMLINE-5
	ELSE
		;上or下に表示する場合は新しい行にする
		IF LOCAL:3 % (L_RAW_OPTION) != 0
			LOCAL:3 += (L_RAW_OPTION) - (LOCAL:3 % (L_RAW_OPTION))
		ENDIF
	ENDIF

	USERCOM_LIST:(LOCAL:3++) = <button value='990'>[990]조교메뉴등록</button>
	;登録メニューごとに表示するかチェック
	VARI NUM_TRAIN_MENU = 0
	FOR LOCAL, 0, 5
		SIF GLOBALS:LOCAL == ""
			GLOBALS:LOCAL = 調教メニュー{LOCAL+1}
		SIF !GETBIT(CFLAG:TARGET:조교메뉴표시설정, LOCAL)
			CONTINUE
		;旧画面表示か否かで処理を変える
		IF 調教画面旧表示
			TRAINMENU_LIST:LOCAL = [{991+LOCAL}]%GLOBALS:LOCAL%
		ELSE
			USERCOM_LIST:(LOCAL:3) += @"<button value='{991+LOCAL}'><font color='%TOSTR_HTML(COLOR("パ緑"))%'>[{991+LOCAL}]%SUBSTRINGU("①②③④⑤" , LOCAL , 1)%</font></button>"
		ENDIF
		NUM_TRAIN_MENU++
		SIF NUM_TRAIN_MENU % 3 == 0
			LOCAL:3++
	NEXT
	FOR LOCAL, 0, 3
		LOCALS = %AUTO_SPLIT(CSTR:(71+LOCAL),"|",10)%
		SIF LOCALS == "" || !GETBIT(CFLAG:TARGET:조교메뉴표시설정, LOCAL+5)
			CONTINUE
		;旧画面表示か否かで処理を変える
		IF 調教画面旧表示
			TRAINMENU_LIST:LOCAL = [{996+LOCAL}]%LOCALS%
		ELSE
			USERCOM_LIST:(LOCAL:3) += @"<button value='{996+LOCAL}'><font color='%TOSTR_HTML(COLOR("パ緑"))%'>[{996+LOCAL}]%SUBSTRINGU("⑥⑦⑧" , LOCAL , 1)%</font></button>"
		ENDIF
		NUM_TRAIN_MENU++
		SIF NUM_TRAIN_MENU % 3 == 0
			LOCAL:3++
	NEXT
ENDIF

;必ず表示する固定位置のコマンド
IF GROUPMATCH(調教オプション表示位置 , "右" , "左") || 調教画面旧表示
	LOCAL:3 = NUM_COMLINE-1
ELSE
	;上or下に表示する場合は新しい行にする
	IF LOCAL:3 % (L_RAW_OPTION) != 0
		LOCAL:3 += (L_RAW_OPTION) - (LOCAL:3 % (L_RAW_OPTION))
	ENDIF
ENDIF

IF !調教画面旧表示
	USERCOM_LIST:(LOCAL:3++) = <button value='C'>[C]옵션위치변경  </button>
	USERCOM_LIST:(LOCAL:3++) = <button value='<'>[<]감</button>  %SET_COLOR_TAG("커맨드수" , "パ青" )%  <button value='>'>증[>]</button>
	USERCOM_LIST:(LOCAL:3++) = <button value='988'>[-]축소↑</button> %SET_COLOR_TAG("표시" , "パ緑")% <button value='989'>확대↓[+]</button>
ENDIF
USERCOM_LIST:(LOCAL:3++) = <button value='999'>[999]조교종료</button>

;上下表示にしている場合、ここでオプションウィンドウの行数を取得する。同時に、調教コマンドウィンドウの高さも取得。
IF GROUPMATCH(調教オプション表示位置 , "上" , "下") && !調教画面旧表示
	L_ウィンドウ内行数:1 = LOCAL:3 / L_RAW_OPTION + (LOCAL:3 % L_RAW_OPTION > 0)
	L_ウィンドウ内行数:0 -= L_ウィンドウ内行数:1
	;更に表示位置も調整
	IF 調教オプション表示位置 == "上"
		調教コマンドウィンドウ上端位置 = L_ウィンドウ内行数:1*100+40
		オプションコマンドウィンドウ上端位置 = 0
	ELSE
		調教コマンドウィンドウ上端位置 = 0
		オプションコマンドウィンドウ上端位置 = (L_ウィンドウ内行数:0 + 3) * 100 + 40
	ENDIF
ENDIF

;------------------------------------------
;調教コマンド履歴のチェック
;PREVCOMの実行可否を取る
;------------------------------------------
VARSET PREVCOMABLE
FOR LCOUNT, 0, VARSIZE("PREVCOMABLE")
	SIF PREVCOM:LCOUNT == -1
		BREAK
	;PLAYERが同じ場合はQ配列の内容から可否を取る
	IF PLAYER == PREVPLAYER:LCOUNT
		PREVCOMABLE:LCOUNT = MATCH(Q, PREVCOM:LCOUNT) > 0
	ELSE
		STOCK_前回の調教者 = TFLAG:전회조교자
		SIF PREVPLAYER:(LCOUNT+1) >= 0
			TFLAG:전회조교자 = PREVPLAYER:(LCOUNT+1)
		;違う場合はCOMABLEを走らせる
		CALL COM_ABLE_COMMON_D, PREVCOM:LCOUNT, PREVPLAYER:LCOUNT
		PREVCOMABLE:LCOUNT = RESULT
		TFLAG:전회조교자 = STOCK_前回の調教者
	ENDIF
NEXT

