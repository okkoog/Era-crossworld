;-----------------------------------------------------------------------
;〇　系統ごとに作られた調教コマンドリストを表示用変数へと格納する
;-----------------------------------------------------------------------
;×　フィルタされている系統の表示
;SETCOLOR COLOR("gray")
LOCAL:2=0 ;行管理用
LOCAL:3=0 ;行内の列管理用
VARS L_AQUA
VARS L_LG
L_AQUA = %TOSTR_HTML(COLOR("aqua"))%
L_LG = %TOSTR_HTML(COLOR("light-gray"))%
FOR LOCAL,0,16
	SELECTCASE LOCAL
		CASE 13,14
			CONTINUE
		CASEELSE
			IF CFLAG:TARGET:(CFLAGNAME:(170+LOCAL)) == 0
				;表示する場合、系統フィルタボタンを水色で系統フィルタ用リストに放り込む
				TYPELIST:(LOCAL:2) = <button value='{700+LoCAL}'><font color='%L_AQUA%'>[{700+LOCAL}]%SUBSTRING(CFLAGNAME:(170+LOCAL),,STRLENS(CFLAGNAME:(170+LOCAL))-4)%[-]</button></font>

				;そののち、リストを作成。
				IF COUNT_COMTYPE:LOCAL >= 1
					LOCAL:3 = 0
					FOR LOCAL:1 , 0 , COUNT_COMTYPE:LOCAL
						COMLIST:(LOCAL:2):(LOCAL:3) = %COMLIST_TYPE:(LOCAL):(LOCAL:1),%
						LOCAL:3 ++
						;最後であるか列の最大数になってたら改行
						IF LOCAL:1 == COUNT_COMTYPE:LOCAL -1
							;最後である場合は改行に加えて更にハイフンを代入して改行
							LOCAL:2++
							LOCAL:3=0
							;次の行が頁の頭だったらハイフンはキャンセル
							IF LOCAL:2 % NUM_COMLINE == 0
							ELSE
								COMLIST:(LOCAL:2):(LOCAL:3) '= "-"*(L_COMSTRLENS*L_RAW_COM+幅埋めLENS)
								LOCAL:2++
							ENDIF
						ELSEIF LOCAL:3 % (L_RAW_COM) == 0
							LOCAL:2++
							LOCAL:3=0
							;次の行がページの境目を跨ぎそうな場合かつページの頭でないのなら、系統ボタンを更におかわり
							SIF LOCAL:2 % NUM_COMLINE == 0
