;調教コマンドリスト・オプションコマンドリストの各サイズを取得

;1コマンドあたりの許容される長さ、項目数を取得。
L_RAW_COM = FLAG:조교커맨드의나열수
SELECTCASE 調教オプション表示位置
	CASE "右" , "左"
		;まず最初にオプションコマンドウィンドウの幅を取得しに行く。paddingは20を想定。
		L_WIDTH:1 = L_OPTIONSTRLENS * 50 + 20*2
		L_RAW_OPTION = 1
		;調教コマンドウィンドウとオプションコマンドウィンドウの高さを取得する。
		L_ウィンドウ内行数:0 = NUM_COMLINE , NUM_COMLINE + 3
		;次に画面の横幅から、調教コマンドのウィンドウ幅を取得しに行く。paddingは20を想定。
		L_WIDTH = LINELENS()*50 - L_WIDTH:1 - 160 + 20*2
		;調教コマンドのウィンドウ幅から、調教コマンドの文字数(半角)を取得
		L_COMSTRLENS = ((L_WIDTH-L_FILTERSTRLENS*50-100) / L_RAW_COM) / 50
		LCOUNT = 80
		調教コマンドウィンドウ左端位置 = (調教オプション表示位置 == "右"  ? LCOUNT # L_WIDTH:1 + LCOUNT)
		調教コマンドウィンドウ上端位置 = 0
		オプションコマンドウィンドウ左端位置 = (調教オプション表示位置 == "右"  ? L_WIDTH + LCOUNT # LCOUNT)
		オプションコマンドウィンドウ上端位置 = 0
	CASE "上" , "下"
		L_WIDTH = LINELENS()*50 - 160 + 20*2
		L_WIDTH:1 = L_WIDTH
		L_OPTIONSTRLENS = 26
		;調教コマンドウィンドウとオプションコマンドウィンドウの高さはこの時点では取得できない。
		L_ウィンドウ内行数:0 = NUM_COMLINE , -1
		;オプションを並べられる数を取得		
		L_RAW_OPTION = (L_WIDTH:1 / (L_OPTIONSTRLENS*50))
		;調教コマンドのウィンドウ幅から、調教コマンドの文字数(半角)を取得
		L_COMSTRLENS = ((L_WIDTH-L_FILTERSTRLENS*50-200) / L_RAW_COM) / 50
		調教コマンドウィンドウ左端位置 = 80
		;上端位置はこの時点では取得できないのでひとまず0
		調教コマンドウィンドウ上端位置 = 0
		オプションコマンドウィンドウ左端位置 = 80
		オプションコマンドウィンドウ上端位置 = 0
ENDSELECT
;幅に足りない分の長さを取得しておく
VARI 幅埋めLENS = 0
幅埋めLENS = ((L_WIDTH - L_FILTERSTRLENS*50 - 200 ) - (L_COMSTRLENS * 50 * L_RAW_COM) ) / 50

;余が出ていた場合は長すぎるはずなので-1
