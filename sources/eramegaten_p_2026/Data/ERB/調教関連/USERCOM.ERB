;#DIM L_RIGHTSTRLENS = 24 ;右側の文字数(半角)
#DIM DYNAMIC L_OPTIONSTRLENS = 24 ;オプションコマンド名の文字数(半角)
#DIM L_SEP , 2 ;区切り棒の位置
#DIM L_RAW_COM ;1行あたりの項目数=列数
