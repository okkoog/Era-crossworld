;-----------------------------------------------------
;@USERCOM_TRAIN , ARGS
;調教中の入力に対して反応を返す関数。
;調教についての行動決定の本体部分である。
;-----------------------------------------------------
@USERCOM_TRAIN , ARGS
#LOCALSIZE 2
#DIM LCOUNT
#DIM L_NUM
#DIM FILTERCOUNT
RESULTS = %ARGS%
RESULT = -999
SIF ISNUMERIC(RESULTS)
	RESULT = TOINT(ARGS)
;---- EDIT 008 MOD START -------------------------
;---- EDIT 005 ADD START -------------------------
IF INRANGE(RESULT, -99, -1)
	;RESULTをPREVCOMの配列に変換する
	L_NUM = RESULT * -1 -1
	;中身が入ってないなら通さない
	SIF PREVCOM:L_NUM == -1
		RETURN 0
	;PREVCOMABLE配列で成否を見る
	SIF !PREVCOMABLE:L_NUM
		RETURN 0
	;実行前にPLAYERを保存しつつ、一時的に差し替える
	TFLAG:PLAYER일시보존 = PLAYER
	PLAYER = PREVPLAYER:L_NUM
	ASSIPLAY = PLAYER == ASSI ? 1 # 0
	SELECTCOM = PREVCOM:L_NUM
;---- EDIT 005 ADD END ---------------------------
;オプションウィンドウ位置変更
ELSEIF RESULTS == "C" || RESULTS == "c"
	SELECTCASE 調教オプション表示位置
		CASE "右"
			調教オプション表示位置 = 左
		CASE "左"
			調教オプション表示位置 = 上
		CASE "上"
			調教オプション表示位置 = 下
		CASE "下"
			調教オプション表示位置 = 右
	ENDSELECT
	RETURN 1
;頁送り 1007なら戻って1009なら進んで再描画
ELSEIF (RESULT == 1007 && COMLIST_PAGE >= 1) || (RESULT == 1009 && COMLIST_PAGE < COMLIST_PAGE_MAX)
	COMLIST_PAGE += RESULT - 1008
	RETURN 1
;コマンド表示数増加
ELSEIF (RESULTS == "<" || RESULTS == ">" ) && 調教画面旧表示 == 0
	FLAG:조교커맨드의나열수 += (RESULTS == ">" ? 1 # -1)
	FLAG:조교커맨드의나열수 = LIMIT(FLAG:조교커맨드의나열수 , 3 , 10)
	RETURN 1
;コマンド範囲外なら戻る。
ELSEIF !INRANGE(RESULT, 0, 999)
	RETURN 0
;「愛撫系」などコマンド群を開放するコマンドの場合、入力ごとに反転
ELSEIF (RESULT >= 700 && RESULT <= 712) || RESULT == 715
	INVERTBIT CFLAG:TARGET:(RESULT + 170 - 700), 0
	RETURN 1
;「全コマンド開放」の場合
ELSEIF RESULT == 750
	;いくつ閉じているかをカウント（※フラグが１で閉じる）
	FILTERCOUNT = 0
	FOR LCOUNT, 170, 186
		SIF CFLAG:TARGET:LCOUNT > 0
			FILTERCOUNT += 1
	NEXT

	FOR LCOUNT, 170, 186
		;現在フィルタとして設定されてない部分は触らない
		IF LCOUNT == 183 || LCOUNT == 184
			CONTINUE
		;半分以上閉じてたら「開放」
		;（現状、「183、184」番のフィルタがないため「大半が開いてないと閉鎖は出てこない」仕様）
		ELSEIF FILTERCOUNT > 8
			CFLAG:TARGET:LCOUNT = 0
		;閉じてるのが半分以下なら「閉鎖」
		ELSE
			CFLAG:TARGET:LCOUNT = 1
		ENDIF
	NEXT
	;戻って再描画
	RETURN 1
;「新旧調教画面表示変更」の場合
ELSEIF RESULT == 751
	INVERTBIT 調教画面旧表示 , 0
	SAVEGLOBAL
	;戻って再描画
	RETURN 1
;「COMリスト縮小」の場合
ELSEIF GROUPMATCH(RESULTS , "988" , "-") && 調教画面旧表示==0
	NUM_COMLINE -= 1
	SIF NUM_COMLINE < 10
		NUM_COMLINE = 10
	SAVEGLOBAL
	;戻って再描画
	RETURN 1
;「COMリスト拡大」の場合
ELSEIF GROUPMATCH(RESULTS , "989" , "+") && 調教画面旧表示==0
	NUM_COMLINE += 1
	SIF NUM_COMLINE > 60
		NUM_COMLINE = 60
	SAVEGLOBAL
	;戻って再描画
	RETURN 1
;履歴表示
ELSEIF RESULT == 800
	CALL SHOW_EQUIP
	RETURN 1
;汚れ表示
ELSEIF RESULT == 801
	CALL STAIN_INFO
	RETURN 1
;能力表示
ELSEIF RESULT == 802
	CALL SHOW_CHARADATA,TARGET
	WAIT
	RETURN 1
;着衣設定
ELSEIF RESULT == 803
	CALL CLOTHES_CHANGE,TARGET
	RETURN 1
;全員全着衣
ELSEIF RESULT == 804
	;ターゲットとプレイヤーの服を全部着せる
	FOR LCOUNT, 0, 14
		TEQUIP:TARGET:(GET_CLOTHESNAME(LCOUNT)) = CFLAG:TARGET:(GET_CLOTHESNAME(LCOUNT))
		TEQUIP:MASTER:(GET_CLOTHESNAME(LCOUNT)) = CFLAG:MASTER:(GET_CLOTHESNAME(LCOUNT))
		SIF ASSI > 0
			TEQUIP:ASSI:(GET_CLOTHESNAME(LCOUNT)) = CFLAG:ASSI:(GET_CLOTHESNAME(LCOUNT))
	NEXT

	CALL おっぱいオープンチェック(TARGET)
	CALL CHECK_EXPOSE(TARGET)
	CALL 股間構造チェック(TARGET)
	CALL 触覚チェック(TARGET)
	CALL ずらしチェック(TARGET)

	CALL おっぱいオープンチェック(MASTER)
	CALL CHECK_EXPOSE(MASTER)
	CALL 股間構造チェック(MASTER)
	CALL 触覚チェック(MASTER)
	CALL ずらしチェック(MASTER)

	IF ASSI > 0
		CALL おっぱいオープンチェック(ASSI)
		CALL CHECK_EXPOSE(ASSI)
		CALL 股間構造チェック(ASSI)
		CALL 触覚チェック(ASSI)
		CALL ずらしチェック(ASSI)
	ENDIF

	;口上チェックは行わない（簡易コマンドであるため）

	RETURN 1
;全員全脱衣
ELSEIF RESULT == 805
	;ターゲットとプレイヤーの服を全部脱がす
	FOR LCOUNT, 0, 14
		TEQUIP:TARGET:(GET_CLOTHESNAME(LCOUNT)) = 0
		TEQUIP:MASTER:(GET_CLOTHESNAME(LCOUNT)) = 0
		SIF ASSI > 0
			TEQUIP:ASSI:(GET_CLOTHESNAME(LCOUNT)) = 0
	NEXT

	CALL おっぱいオープンチェック(TARGET)
	CALL CHECK_EXPOSE(TARGET)
	CALL 股間構造チェック(TARGET)
	CALL 触覚チェック(TARGET)
	CALL ずらしチェック(TARGET)

	CALL おっぱいオープンチェック(MASTER)
	CALL CHECK_EXPOSE(MASTER)
	CALL 股間構造チェック(MASTER)
	CALL 触覚チェック(MASTER)
	CALL ずらしチェック(MASTER)

	IF ASSI > 0
		CALL おっぱいオープンチェック(ASSI)
		CALL CHECK_EXPOSE(ASSI)
		CALL 股間構造チェック(ASSI)
		CALL 触覚チェック(ASSI)
		CALL ずらしチェック(ASSI)
	ENDIF

	;口上チェックは行わない（簡易コマンドであるため）

	RETURN 1

;コンドーム設定
ELSEIF RESULT == 806 && ( HAVE_PENIS(PLAYER) || HAVE_PENIS(TARGET) ) && ITEM:45 > 0
	;調教者と対象のどちらかにペニスがありコンドームがないとダメ
	CALL CONDOM_SETTING
	RETURN 1
;自動射精先変更
ELSEIF RESULT == 807 && ( HAVE_PENIS(PLAYER) || HAVE_PENIS(TARGET) )
	CALL SAMENPLACE_SETTING
	RETURN 1
;調教者能力表示
ELSEIF RESULT == 808
	CALL SHOW_CHARADATA,PLAYER
	WAIT
	RETURN 1
;主導権の受け渡し
ELSEIF RESULT == 809 && ((!(CFLAG:초기주도권 || TALENT:쾌감을부정 || TALENT:저항 || TALENT:억압) && TALENT:남자 ) || ABL:순종 > 2)
	INVERTBIT TEQUIP:주도권 , 0
	RETURN 1
;マスター/助手と交代
ELSEIF RESULT == 900 && ASSI > 0 && TEQUIP:25 == 0
	IF ASSIPLAY
		ASSIPLAY = 0
		PLAYER = MASTER
	ELSE
		ASSIPLAY = 1
		PLAYER = ASSI
	ENDIF
	RETURN 1
;MAG吸収ON/OFF
ELSEIF RESULT == 902
	IF CFLAG:ＭＡＧ비피흡수 == 0
		CFLAG:ＭＡＧ비피흡수 = 1
	ELSE
		CFLAG:ＭＡＧ비피흡수 = 0
	ENDIF
	RETURN 1
;MAG譲渡ON/OFF
ELSEIF RESULT == 906
	IF ASSIPLAY
		IF CFLAG:ASSI:ＭＡＧ비피흡수 == 0
			CFLAG:ASSI:ＭＡＧ비피흡수 = 1
		ELSE
			CFLAG:ASSI:ＭＡＧ비피흡수 = 0
		ENDIF
	ELSE
		IF CFLAG:MASTER:ＭＡＧ비피흡수 == 0
			CFLAG:MASTER:ＭＡＧ비피흡수 = 1
		ELSE
			CFLAG:MASTER:ＭＡＧ비피흡수 = 0
		ENDIF
	ENDIF
	RETURN 1

;コマンドフィルタ
ELSEIF RESULT == 907
	CALL COM_FILTER, TARGET
	RETURN 1
ELSEIF RESULT == 908
	CALL 顔グラ変更,TARGET
	RETURN 1
;---- EDIT 007 DEL START -------------------------
;ELSEIF RESULT == 909
;	INVERTBIT CFLAG:一時陥落素質変更 , 0
;	RETURN 1
;---- EDIT 007 DEL END ---------------------------
;調教メニュー関連：登録
ELSEIF RESULT == 990
	CALL COMSEQ_REGISTER
	RETURN 1
;調教メニュー関連：各種メニュー
ELSEIF RANGE(RESULT, 991, 998)
	CALL COMSEQ_TRAIN, RESULT - 991
	RETURN 1
;ELSEIF RESULT == 991 && FLAG:550 > 0
;	CALL COMSEQ_SHOW
;	RETURN 1
;ELSEIF RESULT == 992 && FLAG:550 > 0
;	CALL COMSEQ_TRAIN
;	RETURN 1

ELSEIF RESULT == 999
	;BEGIN AFTERTRAIN
	RETURN 999
ELSEIF Q:RESULT >= 0
	IF 調教画面旧表示 != 0
		PRINTL
		CUSTOMDRAWLINE "-"
		PRINTL
	ENDIF
	;強調表示用の変数INDICATE_COMを初期化
	;VARSET INDICATE_COM , -1
	;DOTRAIN Q:RESULT
	SELECTCOM:0 = Q:RESULT
	RETURN 1
ENDIF
RETURN 0

