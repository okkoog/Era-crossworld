;-------------------------------------------------
;夜自慰
;-------------------------------------------------
@SELF_NIGHT35
DRAWLINE

;욕망
IF ABL:B:욕망 <= 2
	A = 1
ELSEIF ABL:B:욕망 <= 4
	A = 2
ELSEIF ABL:B:욕망 <= 7
	A = 3
ELSEIF ABL:B:욕망 <= 10
	A = 4
ELSE
	A = 4 + (ABL:B:욕망 - 10) / 4
ENDIF

;노출증
IF ABL:B:노출증 <= 2
	A += 1
ELSEIF ABL:B:노출증 <= 4
	A += 2
ELSEIF ABL:B:노출증 <= 7
	A += 3
ELSEIF ABL:B:노출증 <= 10
	A += 4
ELSE
	A += 4 + (ABL:B:노출증 - 10) / 4
ENDIF

;자위중독
IF ABL:B:자위중독 <= 2
	A += 2
ELSEIF ABL:B:자위중독 <= 4
	A += 3
ELSEIF ABL:B:자위중독 <= 7
	A += 4
ELSEIF ABL:B:자위중독 <= 10
	A += 5
ELSE
	A += 5 + (ABL:B:자위중독 - 10) / 4
ENDIF

;자위하기쉬움
SIF TALENT:B:자위하기쉬움
	A += 2

;自慰狂い（Cだと重複するので他より弱く）
SIF TALENT:B:자위광
	A += 1

;CVAB判定
$LOOP_N_M
IF TALENT:B:남자
	R = RAND:3
ELSE
	R = RAND:4
ENDIF

IF R == 0
	;C判定
	;Ｃ감각
	IF ABL:B:Ｃ감각 <= 2
		A += 1
	ELSEIF ABL:B:Ｃ감각 <= 4
		A += 2
	ELSEIF ABL:B:Ｃ감각 <= 7
		A += 3
	ELSEIF ABL:B:Ｃ감각 <= 10
		A += 4
	ELSE
		A += 4 + (ABL:B:Ｃ감각 - 10) / 3
	ENDIF
	;자위광
	SIF TALENT:B:자위광
		A += 2
	;Ｃ민감
	SIF TALENT:B:Ｃ민감
		A += 1
	SIF A == 0
		A = 1
	IF HAVE_PENIS(B)
		CALL ADDS_EXP("사정경험", A/2, B)
		IF ABL:B:노출증 >= 5
			;BUKKAKE
			CALL ADDS_EXP("정액경험", A/2, E)
		ENDIF
	ENDIF
	GOTJUEL:B:쾌Ｃ += A*60
ELSEIF R == 1
	;A判定（A感覚2以上）
	IF  ABL:B:Ａ감각 >= 2
		;Ａ감각
		IF ABL:B:Ａ감각 <= 2
			A += 1
		ELSEIF ABL:B:Ａ감각 <= 4
			A += 2
		ELSEIF ABL:B:Ａ감각 <= 7
			A += 3
		ELSEIF ABL:B:Ａ감각 <= 10
			A += 4
		ELSE
			A += 4 + (ABL:B:Ａ감각 - 10) / 3
		ENDIF
		;애널광
		SIF TALENT:B:애널광
			A += 2
		;Ａ민감
		SIF TALENT:B:Ａ민감
			A += 1
		SIF A == 0
			A = 1
		CALL ADDS_EXP("Ａ경험", A/2, B)
		GOTJUEL:B:쾌Ａ += A*60
	ELSE
		GOTO LOOP_N_M
	ENDIF
ELSEIF R == 2
	;B判定
	;Ｂ감각
	IF ABL:B:Ｂ감각 <= 2
		A += 1
	ELSEIF ABL:B:Ｂ감각 <= 4
		A += 2
	ELSEIF ABL:B:Ｂ감각 <= 7
		A += 3
	ELSEIF ABL:B:Ｂ감각 <= 10
		A += 4
	ELSE
		A += 4 + (ABL:B:Ｂ감각 - 10) / 3
	ENDIF
	;음유
	SIF TALENT:B:음유
		A += 2
	;Ｂ민감
	SIF TALENT:B:Ｂ민감
		A += 1
	SIF A == 0
		A = 1
	IF TALENT:B:모유체질
		CALL ADDS_EXP("분유경험", A/2, B)
	ENDIF
	GOTJUEL:B:쾌Ｂ += A*60
ELSEIF R == 3
	;V判定（処女及び再生処女を持っていない）
	IF TALENT:B:처녀 == 0 && TALENT:B:재생처녀 == 0
		;Ｖ감각
		IF ABL:B:Ｖ감각 <= 2
			A += 1
		ELSEIF ABL:B:Ｖ감각 <= 4
			A += 2
		ELSEIF ABL:B:Ｖ감각 <= 7
			A += 3
		ELSEIF ABL:B:Ｖ감각 <= 10
			A += 4
		ELSE
			A += 4 + (ABL:B:Ｖ감각 - 10) / 3
		ENDIF
		;섹스광
		SIF TALENT:B:섹스광
			A += 2
		;Ｖ민감
		SIF TALENT:B:Ｖ민감
			A += 1
		SIF A == 0
			A = 1
		CALL ADDS_EXP("Ｖ경험", A/2, B)
		GOTJUEL:B:쾌Ｖ += A*60
	ELSE
		GOTO LOOP_N_M
	ENDIF
ENDIF

CALL ADDS_EXP("절정경험", A/4, B)
CALL ADDS_EXP("자위경험", A/2, B)
GOTJUEL:B:욕정 += A*50
GOTJUEL:B:굴복 += A*30
GOTJUEL:B:습득 += A*40
GOTJUEL:B:치정 += A*30
TFLAG:13 = 35
CALL KOJO_MESSAGE_EVENT
PRINTFORML ---%CALLNAME:B%---
CALL SHOW_ADD_EXP(B, "単純")
CALL SHOW_JUEL_CHECK, B
PRINTFORML ---%CALLNAME:E%---
CALL SHOW_ADD_EXP(E, "単純")
CALL SHOW_JUEL_CHECK, E
PRINTFORMW 행위가 끝나자, %조사처리(CALLNAME:B, "는")% 작게 한숨을 내쉬며 잠에 빠져들었다

DRAWLINE

RETURN 0

;-------------------------------------------------
;一緒に寝る
;-------------------------------------------------
@SELF_NIGHT36
DRAWLINE

;순종
IF ABL:B:순종 <= 6
	A = 3
ELSEIF ABL:B:순종 <= 8
	A = 4
ELSEIF ABL:B:순종 <= 10
	A = 5
ELSE
	A = 5 + (ABL:B:순종 - 10) / 4
ENDIF

;봉사정신
IF ABL:B:봉사정신 <= 6
	A += 4
ELSEIF ABL:B:봉사정신 <= 8
	A += 5
ELSEIF ABL:B:봉사정신 <= 10
	A += 6
ELSE
	A += 6 + (ABL:B:봉사정신 - 10) / 3
ENDIF

;친애
SIF TALENT:B:친애
	A += 1

;幼児／幼児退行または幼稚
SIF TALENT:B:유아／유아퇴행 || TALENT:B:유치
	A += 2

;妻または夫
SIF TALENT:B:아내 || TALENT:B:남편
	A += 1

;아이
SIF TALENT:B:아이
	A += 2

;우애
SIF TALENT:B:우애
	A += 1

SIF A == 0
	A = 1

CALL ADDS_EXP("애정경험", A/4, B)
CALL ADDS_EXP("애정경험", A/4, E)

;幼児／幼児退行または幼稚且つ対象が歌唱技能3以上
IF (TALENT:B:유아／유아퇴행 || TALENT:B:유치) && ABL:E:가창기능 >= 3
	CALL ADDS_EXP("가창경험", A/5, E)
ENDIF

GOTJUEL:B:복종 += A*100
TFLAG:13 = 36
CALL KOJO_MESSAGE_EVENT
PRINTFORML ---%CALLNAME:B%---
CALL SHOW_ADD_EXP(B, "単純")
CALL SHOW_JUEL_CHECK, B
PRINTFORML ---%CALLNAME:E%---
CALL SHOW_ADD_EXP(E, "単純")
CALL SHOW_JUEL_CHECK, E
IF TALENT:B:유아／유아퇴행 || TALENT:B:유치
	PRINTFORMW %조사처리(CALLNAME:B, "는")% 평온한 표정으로 새근새근 숨소리를 내며 자고 있다
ELSE
	PRINTFORMW %조사처리(CALLNAME:B, "는")% 작게 잘 자라는 인사를 건네고 잠에 빠져들었다
ENDIF

DRAWLINE

RETURN 0

