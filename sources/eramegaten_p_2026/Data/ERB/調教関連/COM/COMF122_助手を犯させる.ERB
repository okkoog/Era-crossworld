;-------------------------------------------------
;조수를범하게한다
;助手によるコマンド、及びレズプレイ、レベル4
;-------------------------------------------------
@ACT_COM122
PRINTL 조수를범하게한다

;-------------------------------------------------
;実行決定
;-------------------------------------------------
TSTR:0 = 조수를범하게한다
;CALL KOJO_MESSAGE_COM


;-------------------------------------------------
;射精ゲージチェック（ふたなりの場合）
;-------------------------------------------------
B = 2000

;ABL:調教者の技巧をみる
IF ABL:기교 == 0
	TIMES B , 1.00
ELSEIF ABL:기교 == 1
	TIMES B , 1.20
ELSEIF ABL:기교 == 2
	TIMES B , 1.40
ELSEIF ABL:기교 == 3
	TIMES B , 1.60
ELSEIF ABL:기교 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.00
ENDIF

;ABL:従順をみる
IF ABL:순종 == 0
	TIMES B , 0.80
ELSEIF ABL:순종 == 1
	TIMES B , 0.90
ELSEIF ABL:순종 == 2
	TIMES B , 1.00
ELSEIF ABL:순종 == 3
	TIMES B , 1.10
ELSEIF ABL:순종 == 4
	TIMES B , 1.20
ELSE
	TIMES B , 1.30
ENDIF

;ABL:奉仕精神をみる
IF ABL:봉사정신 == 0
	TIMES B , 0.50
ELSEIF ABL:봉사정신 == 1
	TIMES B , 0.80
ELSEIF ABL:봉사정신 == 2
	TIMES B , 1.20
ELSEIF ABL:봉사정신 == 3
	TIMES B , 1.50
ELSEIF ABL:봉사정신 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.40
ENDIF

;助手のABL:V感覚をみる
IF ABL:PLAYER:Ｖ감각 == 0
	TIMES B , 0.50
ELSEIF ABL:PLAYER:Ｖ감각 == 1
	TIMES B , 0.80
ELSEIF ABL:PLAYER:Ｖ감각 == 2
	TIMES B , 1.00
ELSEIF ABL:PLAYER:Ｖ감각 == 3
	TIMES B , 1.20
ELSEIF ABL:PLAYER:Ｖ감각 == 4
	TIMES B , 1.50
ELSE
	TIMES B , 2.00
ENDIF

;助手のEXP:Ｖ経験をみる
IF EXP:PLAYER:Ｖ경험 < EXPLV:1
	TIMES B , 0.20
ELSEIF EXP:PLAYER:Ｖ경험 < EXPLV:2
	TIMES B , 0.50
ELSEIF EXP:PLAYER:Ｖ경험 < EXPLV:3
	TIMES B , 0.80
ELSEIF EXP:PLAYER:Ｖ경험 < EXPLV:4
	TIMES B , 1.00
ELSEIF EXP:PLAYER:Ｖ경험 < EXPLV:5
	TIMES B , 1.20
ELSE
	TIMES B , 1.40
ENDIF

	LOCAL:99 = B
;プレイヤーのABL:Ｃ感覚をみる
IF ABL:PLAYER:Ｃ감각 == 0
	TIMES B , 1.00
ELSEIF ABL:PLAYER:Ｃ감각 == 1
	TIMES B , 1.50
ELSEIF ABL:PLAYER:Ｃ감각 == 2
	TIMES B , 2.00
ELSEIF ABL:PLAYER:Ｃ감각 == 3
	TIMES B , 2.50
ELSEIF ABL:PLAYER:Ｃ감각 == 4
	TIMES B , 3.50
ELSE
	TIMES B , 5.00
ENDIF

;;再装填処理中は射精ゲージは20分の1に
;IF CFLAG:PLAYER:射精ゲージ再装填 > 0
;	B /= 20
;	LOCAL:99 /= 20
;ENDIF

IF HAVE_PENIS(PLAYER)
	BASE:PLAYER:사정 += B
	TEQUIP:PLAYER:Ｖ삽입자 = TARGET
	TFLAG:삽입속행 = 1
ENDIF
SIF TALENT:PLAYER:남자 == 0
	BASE:PLAYER:99 += LOCAL:99

;射精先タイプの設定
TCVAR:PLAYER:페니스사용대상 = TARGET
TCVAR:PLAYER:사정부위 = 14
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 0

;調教者←→調教対象
TFLAG:28 = 3
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 50
DOWNBASE:TARGET:기력 += 150

SOURCE:TARGET:쾌Ｃ = 400
SOURCE:TARGET:성행위 = 500
SOURCE:TARGET:달성 = 400
SOURCE:TARGET:굴종 = 700
SOURCE:TARGET:일탈 = 500
SOURCE:TARGET:반감 = 500


;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 500

;助手が処女の場合、屈服逸脱が倍化し、従順が2になる。ただし一度きり
IF TALENT:PLAYER:처녀 == 1 && CFLAG:99 == 0
	TIMES SOURCE:TARGET:굴종 , 5.00
	TIMES SOURCE:TARGET:일탈 , 3.00
	SIF !IS_MALE(TARGET)
		CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", TARGET)
	SIF !IS_MALE(TARGET)
		CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", PLAYER)
	IF ABL:순종 < 2
		PRINTL ＜조수가 처녀＞
		PRINTFORML 그리고 %ABLNAME:0%이(가) 2가 되었다
		ABL:순종 = 2
	ENDIF
	CFLAG:99 = 1
ENDIF
CALL ADDS_EXP("Ｖ경험", 1, PLAYER)

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
IF HAVE_PENIS(TARGET)
	;奴隷のＰ⇔調教者のＶの汚れが移動
	CALL MOVE_STAIN("페니스", TARGET, "바기나", PLAYER)
ENDIF

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;성교경험
CALL ADDS_EXP("성교경험", 1, PLAYER)
;삽입경험
CALL ADDS_EXP("삽입경험", 1, TARGET)

;레즈경험
A = 10
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;近親相姦の場合異常経験付与
IF 近親チェック(TARGET , PLAYER)
	CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:0%）", TARGET)
	CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:1%）", PLAYER)
ENDIF

;依存度ベクトル
;P = PLAYER
IF GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:33 = 2
ELSEIF GET_RELATION(TARGET, PLAYER) < 100
	TFLAG:33 = 3
ELSE
	TFLAG:33 = 1
ENDIF

;依存度補正値(相性100↑かつ淫乱で2、娼婦で4）
;P = PLAYER
IF TALENT:음란 && GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:30 += 2
ELSEIF TALENT:창부 && GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:30 += 4
ENDIF


RETURN 1

;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
@COM_ORDER_122, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "욕망", 2, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "봉사정신", 4, ARG, ARG:1

CALL ADD_COM_ORDER, "MARK", "쾌락각인", 2, ARG, ARG:1

CALL ADD_COM_ORDER, "PALAM", "욕정", 2, ARG, ARG:1

CALL ADD_COM_ORDER, "TALENT", "부끄럼쟁이", -1, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "헌신적", 6, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "쾌감에솔직", 2, ARG, ARG:1
SIF !TALENT:ARG:음란 && !TALENT:ARG:창부
	CALL ADD_COM_ORDER, "TALENT", "쾌감을부정", -2, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "음란", 5, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "창부", 10, ARG, ARG:1

;助手が処女
SIF TALENT:PLAYER:처녀 == 1
	CALL ADD_COM_ORDER, "EXTRA", "助手が処女", -15, ARG, ARG:1

CALL ADD_COM_ORDER, "RELATION", , , ARG, ARG:1
;-------------------------------------------------
;実行値
;-------------------------------------------------
@COM_ORDER_NUM_122
RETURN 40

;===================================================
;調教タイプ
;===================================================
@COMTYPE_122
RETURN COMTYPE("助手・レズ系")



