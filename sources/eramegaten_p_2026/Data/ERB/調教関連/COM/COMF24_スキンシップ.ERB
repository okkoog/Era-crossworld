;-------------------------------------------------
;스킨쉽
;コミュニケーション系コマンド、レベル2
;-------------------------------------------------
@ACT_COM24

PRINTL 스킨쉽
TSTR:0 = 스킨쉽
;CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 25
DOWNBASE:TARGET:기력 += 25

SOURCE:TARGET:정애 = 500
SOURCE:TARGET:성행위 = 500
SOURCE:TARGET:일탈 = 100


;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;애정경험
IF (TALENT:연모 == 1 || TALENT:친애 == 1) && ASSIPLAY == 0
;	PRINTS EXPNAME:23
;	PRINTL +1
	CALL ADDS_EXP("애정경험", 1, TARGET)
;	PRINTFORML 애정경험(主人)＋１
	CALL ADDS_EXP("애정경험", 1, MASTER)
ENDIF

;依存度ベクトル
TFLAG:33 = 4

;依存度補正値(恋慕で1、親愛で2）
IF TALENT:연모 && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF TALENT:친애 && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF


RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_24
RETURN COMTYPE("コミュ系")

