;-------------------------------------------------
;기승유방자위
;セックス・愛撫系派生コマンド
;기승위→가슴자위
;なお、ほとんど同処理となるＡ騎乗乳房自慰もこのACTを用いる
;その際の両者の判別はSELECTCOMの番号を使用
;-------------------------------------------------
@ACT_COM505
;アナル騎乗乳房自慰の場合
SIF SELECTCOM == 512
	PRINT 애널
PRINTL 기승유방자위

;-------------------------------------------------
;実行決定
;-------------------------------------------------
IF SELECTCOM == 505
	TSTR:0 = 기승유방자위
ELSE
	TSTR:0 = 애널기승유방자위
ENDIF
;SELECTCOM = 505
;CALL KOJO_MESSAGE_COM

;派生元を見る
;騎乗位からの派生の場合
IF SELECTCOM == 505
;	TFLAG:40 = 1
	;V経験を伴うコマンドのフラグ(処女膜再生対応)
	TFLAG:19 = 1
	SIF ASSIPLAY == 0
		TFLAG:20 = 1
;騎乗位アナルからの派生の場合
;ELSEIF PREVCOM == 67 || SELECTCOM == 67
;	TFLAG:40 = 2
ENDIF

;実行者が奴隷であるフラグ
TFLAG:28 = 1
IF SELECTCOM == 505
	TEQUIP:TARGET:Ｖ삽입자 = PLAYER
ELSE
	TEQUIP:TARGET:Ａ삽입자 = PLAYER
ENDIF
TFLAG:삽입속행 = 1

;処女喪失時のテキスト用処理
SIF TFLAG:계속삽입 && PREVCOM == 66 && (TFLAG:전회조교자 == PLAYER) && TFLAG:31
	TFLAG:31 = 2
;-------------------------------------------------
;射精ゲージチェック
;-------------------------------------------------
B = 2000

;ABL:技巧をみる
IF ABL:기교 == 0
	TIMES B , 1.00
ELSEIF ABL:기교 == 1
	TIMES B , 1.10
ELSEIF ABL:기교 == 2
	TIMES B , 1.20
ELSEIF ABL:기교 == 3
	TIMES B , 1.30
ELSEIF ABL:기교 == 4
	TIMES B , 1.40
ELSE
	TIMES B , 1.50
ENDIF

;PALAM:윤활
IF PALAM:윤활 < PALAMLV:1
	TIMES B , 0.20
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES B , 0.50
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES B , 1.00
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES B , 1.20
ELSEIF PALAM:윤활 < PALAMLV:5
	TIMES B , 1.50
ELSE
	TIMES B , 2.00
ENDIF

;PALAM:욕정
IF PALAM:5 < PALAMLV:1
	TIMES B , 0.60
ELSEIF PALAM:5 < PALAMLV:2
	TIMES B , 0.80
ELSEIF PALAM:5 < PALAMLV:3
	TIMES B , 1.00
ELSEIF PALAM:5 < PALAMLV:4
	TIMES B , 1.20
ELSEIF PALAM:5 < PALAMLV:5
	TIMES B , 1.40
ELSE
	TIMES B , 1.70
ENDIF

;ABL:従順をみる
IF ABL:순종 == 0
	TIMES B , 0.80
ELSEIF ABL:순종 == 1
	TIMES B , 0.90
ELSEIF ABL:순종 == 2
	TIMES B , 1.00
ELSEIF ABL:순종 == 3
	TIMES B , 1.10
ELSEIF ABL:순종 == 4
	TIMES B , 1.20
ELSE
	TIMES B , 1.30
ENDIF

;ABL:欲望をみる
IF ABL:욕망 == 0
	TIMES B , 1.00
ELSEIF ABL:욕망 == 1
	TIMES B , 1.10
ELSEIF ABL:욕망 == 2
	TIMES B , 1.20
ELSEIF ABL:욕망 == 3
	TIMES B , 1.30
ELSEIF ABL:욕망 == 4
	TIMES B , 1.40
ELSE
	TIMES B , 1.50
ENDIF

;ABL:奉仕精神をみる
IF ABL:봉사정신 == 0
	TIMES B , 0.50
ELSEIF ABL:봉사정신 == 1
	TIMES B , 0.80
ELSEIF ABL:봉사정신 == 2
	TIMES B , 1.20
ELSEIF ABL:봉사정신 == 3
	TIMES B , 1.50
ELSEIF ABL:봉사정신 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.40
ENDIF

;プレイヤーのABL:Ｃ感覚をみる
IF ABL:PLAYER:Ｃ감각 == 0
	TIMES B , 1.00
ELSEIF ABL:PLAYER:Ｃ감각 == 1
	TIMES B , 1.50
ELSEIF ABL:PLAYER:Ｃ감각 == 2
	TIMES B , 2.00
ELSEIF ABL:PLAYER:Ｃ감각 == 3
	TIMES B , 2.50
ELSEIF ABL:PLAYER:Ｃ감각 == 4
	TIMES B , 3.50
ELSE
	TIMES B , 5.00
ENDIF

;騎乗位からの派生の場合
IF SELECTCOM == 505
	;EXP:Ｖ経験をみる
	;処女だと増える
	SIF EXP:Ｖ경험 < EXPLV:1
		TIMES B , 1.50
ENDIF

;;再装填処理中は射精ゲージは20分の1に
;SIF CFLAG:PLAYER:射精ゲージ再装填 > 0
;	B /= 20


SIF HAVE_PENIS(PLAYER)
	BASE:PLAYER:사정 += B

;調教者←→調教対象→調教対象
TFLAG:28 = 7
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 80
DOWNBASE:TARGET:기력 += 180

SOURCE:TARGET:쾌Ｂ = 100
SOURCE:TARGET:정애 = 300
SOURCE:TARGET:성행위 = 300
SOURCE:TARGET:달성 = 300
SOURCE:TARGET:중독충족 = 400
SOURCE:TARGET:노출 = 200
SOURCE:TARGET:일탈 = 700
SOURCE:TARGET:반감 = 900
;上のほうで計算した汚れデータ
SOURCE:TARGET:불결 = Y*10 + 60
;騎乗位からの派生の場合
IF SELECTCOM == 505
	SOURCE:TARGET:쾌Ｖ = 250
	SOURCE:TARGET:아픔 = 500
ENDIF
;騎乗位アナルからの派生の場合
IF SELECTCOM == 512
	SOURCE:TARGET:쾌Ａ = 250
	SOURCE:TARGET:아픔 = 800
	SOURCE:TARGET:일탈 += 100
ENDIF

;調教者に快Ｃ
SOURCE:PLAYER:쾌Ｃ = 450
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 900

;貞操観念持ちで恋慕、親愛持ち以外には常に反発のソースを追加する（セックス系のみ）
SIF TALENT:정조관념 && !IS_LOVER(TARGET) && SELECTCOM == 505
	SOURCE:TARGET:반감 += 1000

;処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:처녀 == 1 && SELECTCOM == 505
	SOURCE:TARGET:아픔 += 2000
	SOURCE:TARGET:반감 += 3000
ENDIF

;再生処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:재생처녀 == 1 && SELECTCOM == 505
	SOURCE:TARGET:아픔 += 500
	SOURCE:TARGET:반감 += 1000
ENDIF

;騎乗位からの派生の場合
IF SELECTCOM == 505
	;苦痛回りは新しく作ったやつにぶん投げ
	CALL CHINPO,TARGET,PLAYER,"V"
ENDIF

;騎乗位アナルからの派生の場合
IF SELECTCOM == 512
	;苦痛回りは新しく作ったやつにぶん投げ
	CALL CHINPO,TARGET,PLAYER,"A"
ENDIF

;中毒による中毒充足のソースは先に処理しておく
;セックス中毒を見る
IF ABL:섹스중독 == 0
	TIMES SOURCE:TARGET:중독충족 , 0.00
ELSEIF ABL:섹스중독 == 1
	TIMES SOURCE:TARGET:중독충족 , 0.30
ELSEIF ABL:섹스중독 == 2
	TIMES SOURCE:TARGET:중독충족 , 0.60
ELSEIF ABL:섹스중독 == 3
	TIMES SOURCE:TARGET:중독충족 , 0.90
ELSEIF ABL:섹스중독 == 4
	TIMES SOURCE:TARGET:중독충족 , 1.20
ELSEIF ABL:섹스중독 == 5
	TIMES SOURCE:TARGET:중독충족 , 1.50
ELSEIF ABL:섹스중독 == 6
	TIMES SOURCE:TARGET:중독충족 , 1.80
ELSEIF ABL:섹스중독 == 7
	TIMES SOURCE:TARGET:중독충족 , 2.10
ELSEIF ABL:섹스중독 == 8
	TIMES SOURCE:TARGET:중독충족 , 2.40
ELSEIF ABL:섹스중독 == 9
	TIMES SOURCE:TARGET:중독충족 , 3.00
ELSEIF ABL:섹스중독 >= 10
	TIMES SOURCE:TARGET:중독충족 , 5.00
ENDIF

;自慰中毒を見る
IF ABL:자위중독 == 0
	TIMES SOURCE:TARGET:중독충족 , 0.00
ELSEIF ABL:자위중독 == 1
	TIMES SOURCE:TARGET:중독충족 , 0.30
ELSEIF ABL:자위중독 == 2
	TIMES SOURCE:TARGET:중독충족 , 0.60
ELSEIF ABL:자위중독 == 3
	TIMES SOURCE:TARGET:중독충족 , 0.90
ELSEIF ABL:자위중독 == 4
	TIMES SOURCE:TARGET:중독충족 , 1.20
ELSEIF ABL:자위중독 == 5
	TIMES SOURCE:TARGET:중독충족 , 1.50
ELSEIF ABL:자위중독 == 6
	TIMES SOURCE:TARGET:중독충족 , 1.80
ELSEIF ABL:자위중독 == 7
	TIMES SOURCE:TARGET:중독충족 , 2.10
ELSEIF ABL:자위중독 == 8
	TIMES SOURCE:TARGET:중독충족 , 2.40
ELSEIF ABL:자위중독 == 9
	TIMES SOURCE:TARGET:중독충족 , 3.00
ELSEIF ABL:자위중독 >= 10
	TIMES SOURCE:TARGET:중독충족 , 5.00
ENDIF

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
;射精先タイプの設定
TCVAR:PLAYER:페니스사용대상 = TARGET
IF SELECTCOM == 512
	TCVAR:PLAYER:사정부위 = 2
ELSE
	TCVAR:PLAYER:사정부위 = 1
ENDIF
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 1

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;騎乗位からの派生の場合
IF SELECTCOM == 505
	;膣内に破瓜の血の汚れを付加
	SIF TALENT:처녀 == 1 || TALENT:재생처녀 == 1
		CALL SET_STAIN("질내", "破瓜の血", TARGET)
	;奴隷の膣内⇔調教者のＰの汚れが移動
	CALL MOVE_STAIN("질내", TARGET, "페니스", PLAYER)
ENDIF

;騎乗位アナルからの派生の場合
IF SELECTCOM == 512
	;奴隷のＡ⇔調教者のＰの汚れが移動
	CALL MOVE_STAIN("애널", TARGET, "페니스", PLAYER)
ENDIF

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;자위경험
;ビデオ撮影時は経験にプラス
IF TEQUIP:비디오카메라
	CALL ADDS_EXP("자위경험", 2, TARGET)
	CALL ADDS_EXP("조교자위경험", 2, TARGET)
ELSE
	CALL ADDS_EXP("자위경험", 1, TARGET)
	CALL ADDS_EXP("조교자위경험", 1, TARGET)
ENDIF

SIF TEQUIP:비디오카메라
	CALL ADDS_ABNORMAL_EXP("公開自慰", TARGET)
;騎乗位からの派生の場合
IF SELECTCOM == 505
	;이상경험
	SIF TALENT:처녀 == 1 && !IS_MALE(PLAYER)
		CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", TARGET)
	SIF TALENT:처녀 == 1
		CALL ADDS_ABNORMAL_EXP("処女喪失（騎乗位）", TARGET)
	
	;近親相姦の場合異常経験付与
	IF 近親チェック(TARGET , PLAYER)
		CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:0%）", TARGET)
		CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:1%）", PLAYER)
	ENDIF
	;V経験
	CALL ADDS_EXP("Ｖ경험", 1, TARGET)
ENDIF

;騎乗位アナルからの派生の場合
IF SELECTCOM == 512
	;A経験
	CALL ADDS_EXP("Ａ경험", 3, TARGET)
ENDIF

;성교경험
CALL ADDS_EXP("성교경험", 1, TARGET)

;삽입경험
CALL ADDS_EXP("삽입경험", 1, PLAYER)

;수간경험
IF (TALENT:PLAYER:짐승 || TALENT:PLAYER:새) && !(TALENT:TARGET:짐승 || TALENT:TARGET:새)
	CALL ADDS_EXP("수간경험", 1, TARGET)
ENDIF

;레즈경험
A = 10
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF


;애정경험
IF TALENT:연모 == 1 && ASSIPLAY == 0
	CALL ADDS_EXP("애정경험", 2, TARGET)
	CALL ADDS_EXP("애정경험", 1, MASTER)
ELSEIF TALENT:친애 == 1 && ASSIPLAY == 0
	CALL ADDS_EXP("애정경험", 4, TARGET)
	CALL ADDS_EXP("애정경험", 1, MASTER)
ENDIF

;依存度ベクトル
;騎乗位派生の場合
IF SELECTCOM == 505
	TFLAG:33 = 2
;騎乗位アナル派生の場合
ELSEIF SELECTCOM == 512
	TFLAG:33 = 3
ENDIF

;依存度補正値(恋慕で2、親愛で4）
IF TALENT:연모 && ASSIPLAY == 0 && TFLAG:33 == 2
	TFLAG:30 += 2
ELSEIF TALENT:친애 && ASSIPLAY == 0 && TFLAG:33 == 2
	TFLAG:30 += 4
ENDIF

;依存度補正値(服従で1、隷属で2）
IF TALENT:복종 && ASSIPLAY == 0 && TFLAG:33 == 3
	TFLAG:30 += 1
ELSEIF TALENT:예속 && ASSIPLAY == 0 && TFLAG:33 == 3
	TFLAG:30 += 2
ENDIF

;奉仕快楽フラグ
TFLAG:100 = 1

RETURN 1

;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
@COM_ORDER_505, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "욕망", 3, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", \@SELECTCOM == 505 ? Ｖ감각 # Ａ감각\@, 2, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "봉사정신", 4, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "섹스중독", 1, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "노출증", 4, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "자위중독", 3, ARG, ARG:1
CALL ADD_COM_ORDER, "MARK", "쾌락각인", 3, ARG, ARG:1
CALL ADD_COM_ORDER, "PALAM", "욕정", 3, ARG, ARG:1
SIF PALAM:ARG:윤활 < PALAMLV:3
	CALL ADD_COM_ORDER, "EXTRA", "潤滑不足", -5, ARG, ARG:1


CALL ADD_COM_ORDER, "TALENT", "자제심", -5, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "부끄럼쟁이", -5, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "부끄럼없음", 2, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "자위하기쉬움", 5, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "쾌감에솔직", 5, ARG, ARG:1

SIF !TALENT:ARG:음란 && !TALENT:ARG:창부
	CALL ADD_COM_ORDER, "TALENT", "쾌감을부정", -5, ARG, ARG:1
;男嫌い（恋慕、親愛で無効）
SIF HATE(ARG, ARG:1)
	CALL ADD_COM_ORDER, "TALENT", \@IS_MALE(PLAYER) ? 남성혐오 # 여성혐오 \@, -12, ARG, ARG:1
IF SELECTCOM == 505
	CALL ADD_COM_ORDER, "TALENT", "연모", 15, ARG, ARG:1
	CALL ADD_COM_ORDER, "TALENT", "친애", 20, ARG, ARG:1
	CALL ADD_COM_ORDER, "TALENT", "처녀", -40, ARG, ARG:1
	SIF !TALENT:ARG:처녀 && EXP:ARG:Ｖ경험 < EXPLV:2
		CALL ADD_COM_ORDER, "EXTRA", "Ｖ経験不足", -15, ARG, ARG:1
ELSE
	CALL ADD_COM_ORDER, "TALENT", "음란", 15, ARG, ARG:1
	CALL ADD_COM_ORDER, "TALENT", "창부", 20, ARG, ARG:1
	SIF EXP:ARG:Ａ경험 < EXPLV:2
		CALL ADD_COM_ORDER, "EXTRA", "Ａ経験不足", -30, ARG, ARG:1
ENDIF

CALL ADD_COM_ORDER, "TALENT", "후타나리", 4, ARG:1, ARG
CALL ADD_COM_ORDER, "STAIN", "페니스", 33, ARG, ARG:1
CALL ADD_COM_ORDER, "EXTRA", "미약", 6, ARG, ARG:1
CALL ADD_COM_ORDER, "RELATION", , , ARG, ARG:1
SIF TEQUIP:ARG:비디오카메라
	CALL ADD_COM_ORDER, "EXTRA", "비디오카메라", -10, ARG, ARG:1
SIF TEQUIP:ARG:착유기
	CALL ADD_COM_ORDER, "EXTRA", "착유", -5, ARG, ARG:1

;-------------------------------------------------
;実行値
;-------------------------------------------------
@COM_ORDER_NUM_505
RETURN 50
;===================================================
;調教タイプ
;===================================================
@COMTYPE_505
RETURN COMTYPE("派生系")


