;-------------------------------------------------
;확장벌룬
;ハードな調教コマンド、レベル4
;-------------------------------------------------
@COMNAME148
RESULTS = 확장벌룬
SIF TEQUIP:22
	RESULTS = 확장 풍선 해제
@ACT_COM148
;---- EDIT 002 触手系コマンドを修正 MOD START ----
;-------------------------------------------------
;特殊派生処理
;-------------------------------------------------
IF TEQUIP:25
	PRINTL 애널극태촉수
	TSTR:0 = 애널극태촉수
	SELECTCOM = 176
ELSE
	PRINTL 확장벌룬
	TSTR:0 = 확장벌룬
ENDIF
;---- EDIT 002 触手系コマンドを修正 MOD END   ----
;CALL KOJO_MESSAGE_COM

;着脱の処理
IF TEQUIP:22 == 0
	TEQUIP:22 = 1
ELSE
	TEQUIP:22 = 0
ENDIF

;調教者→調教対象
TFLAG:28 = 2
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 150
DOWNBASE:TARGET:기력 += 200

SOURCE:TARGET:도구쾌Ａ = 200
SOURCE:TARGET:아픔 = 800
SOURCE:TARGET:노출 = 300
SOURCE:TARGET:굴종 = 400
SOURCE:TARGET:일탈 = 700
SOURCE:TARGET:반감 = 700


;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 700

;Aへの苦痛は先に処理しておく
;EXP:Ａ経験をみる
IF EXP:Ａ경험 < EXPLV:1
	TIMES SOURCE:TARGET:아픔 , 3.00
	TIMES SOURCE:TARGET:반감 , 3.00
ELSEIF EXP:Ａ경험 < EXPLV:2
	TIMES SOURCE:TARGET:아픔 , 1.20
	TIMES SOURCE:TARGET:반감 , 2.00
ELSEIF EXP:Ａ경험 < EXPLV:3
	TIMES SOURCE:TARGET:아픔 , 0.80
	TIMES SOURCE:TARGET:반감 , 1.50
ELSEIF EXP:Ａ경험 < EXPLV:4
	TIMES SOURCE:TARGET:아픔 , 0.60
	TIMES SOURCE:TARGET:반감 , 1.20
ELSEIF EXP:Ａ경험 < EXPLV:5
	TIMES SOURCE:TARGET:아픔 , 0.40
ELSEIF EXP:Ａ경험 >= EXPLV:5
	TIMES SOURCE:TARGET:아픔 , 0.20
ENDIF

;PALAM:潤滑をみる
IF PALAM:윤활 < PALAMLV:1
	TIMES SOURCE:TARGET:아픔 , 1.20
	TIMES SOURCE:TARGET:반감 , 2.00
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES SOURCE:TARGET:아픔 , 1.00
	TIMES SOURCE:TARGET:반감 , 1.50
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES SOURCE:TARGET:아픔 , 0.60
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES SOURCE:TARGET:아픔 , 0.30
ELSEIF PALAM:윤활 >= PALAMLV:4
	TIMES SOURCE:TARGET:아픔 , 0.20
ENDIF


;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL ADDS_EXP("Ａ경험", 25, TARGET)
;PRINTL Ａ경험＋５

;IF EXP:52 == 0 && EXP:53 == 0 
;	EXP:50 += 1
;	PRINTL 이상경험＋１
;	CALL ADDS_ABNORMAL_EXP("拡張初体験", TARGET)
;ENDIF

CALL ADDS_EXP("Ａ확장경험", 1, TARGET)
;PRINTL Ａ확장경험＋1

A = 1
IF IS_LESBIAN(TARGET,PLAYER)
	PRINTFORML %EXPNAME:40%+{A}
	CALL ADDS_EXP("레즈경험", A, TARGET)
ELSEIF IS_GAY(TARGET,PLAYER)
	PRINTFORML %EXPNAME:41%+{A}
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
ENDIF

;依存度ベクトル
TFLAG:33 = 5

;依存度補正値(服従で1、隷属で2）
IF TALENT:복종 && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF TALENT:예속 && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF


RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM148
;확장벌룬

;---- EDIT 002 触手系コマンドを修正 MOD START ----
IF TEQUIP:25
	PRINTL ＜애널 극태촉수 중＞
ELSE
	PRINTL ＜확장 풍선 삽입 중＞
ENDIF
;---- EDIT 002 触手系コマンドを修正 MOD END   ----

DOWNBASE:TARGET:체력 += 75
DOWNBASE:TARGET:기력 += 100

SOURCE:TARGET:도구쾌Ａ += 100
SOURCE:TARGET:노출 += 150
SOURCE:TARGET:굴종 += 200
SOURCE:TARGET:일탈 += 350

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 350

;Aへの苦痛は先に処理しておく
;EXP:Ａ経験をみる
A = 400
B = 350
IF EXP:Ａ경험 < EXPLV:1
	TIMES A , 3.00
	TIMES B , 3.00
ELSEIF EXP:Ａ경험 < EXPLV:2
	TIMES A , 1.20
	TIMES B , 2.00
ELSEIF EXP:Ａ경험 < EXPLV:3
	TIMES A , 0.80
	TIMES B , 1.50
ELSEIF EXP:Ａ경험 < EXPLV:4
	TIMES A , 0.60
	TIMES B , 1.20
ELSEIF EXP:Ａ경험 < EXPLV:5
	TIMES A , 0.40
ELSEIF EXP:Ａ경험 >= EXPLV:5
	TIMES A , 0.20
ENDIF

;PALAM:潤滑をみる
IF PALAM:윤활 < PALAMLV:1
	TIMES A , 1.20
	TIMES B , 2.00
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES A , 1.00
	TIMES B , 1.50
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES A , 0.60
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES A , 0.30
ELSEIF PALAM:윤활 >= PALAMLV:4
	TIMES A , 0.20
ENDIF
SOURCE:TARGET:아픔 += A
SOURCE:TARGET:반감 += B

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL ADDS_EXP("Ａ경험", 3, TARGET)
;PRINTL Ａ경험＋３

CALL ADDS_EXP("Ａ확장경험", 1, TARGET)
;PRINTL Ａ확장경험＋1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_148
RETURN COMTYPE("ハード系")




