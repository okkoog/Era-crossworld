;-------------------------------------------------
;애널비즈
;道具使用コマンド、レベル3
;-------------------------------------------------
@COMNAME46
IF TEQUIP:애널비즈
	RESULTS = 애널비즈 해제
ELSE
	RESULTS = 애널비즈
ENDIF
@ACT_COM46
PRINTL 애널비즈
TSTR:0 = 애널비즈
;CALL KOJO_MESSAGE_COM

;着脱の処理
IF TEQUIP:15 == 0
	TEQUIP:15 = 1
ELSE
	TEQUIP:15 = 0
ENDIF

;調教者→調教対象
TFLAG:28 = 2
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 60
DOWNBASE:TARGET:기력 += 150

SOURCE:TARGET:도구쾌Ａ = 150
SOURCE:TARGET:아픔 = 200
SOURCE:TARGET:노출 = 50
SOURCE:TARGET:굴종 = 50
SOURCE:TARGET:일탈 = 60
SOURCE:TARGET:반감 = 80

;装着時は快Aは下がる
SIF TEQUIP:15 == 1
	TIMES SOURCE:TARGET:쾌Ａ , 0.80

;外す時は快Aは上がる
SIF TEQUIP:15 == 0
	TIMES SOURCE:TARGET:쾌Ａ , 3.00

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 70

;Aへの苦痛は先に処理しておく
;EXP:Ａ経験をみる
IF EXP:Ａ경험 < EXPLV:1
	TIMES SOURCE:TARGET:아픔 , 3.00
	TIMES SOURCE:TARGET:반감 , 3.00
ELSEIF EXP:Ａ경험 < EXPLV:2
	TIMES SOURCE:TARGET:아픔 , 1.20
	TIMES SOURCE:TARGET:반감 , 2.00
ELSEIF EXP:Ａ경험 < EXPLV:3
	TIMES SOURCE:TARGET:아픔 , 0.80
	TIMES SOURCE:TARGET:반감 , 1.50
ELSEIF EXP:Ａ경험 < EXPLV:4
	TIMES SOURCE:TARGET:아픔 , 0.60
	TIMES SOURCE:TARGET:반감 , 1.20
ELSEIF EXP:Ａ경험 < EXPLV:5
	TIMES SOURCE:TARGET:아픔 , 0.40
ELSEIF EXP:Ａ경험 >= EXPLV:5
	TIMES SOURCE:TARGET:아픔 , 0.20
ENDIF

;PALAM:潤滑をみる
IF PALAM:윤활 < PALAMLV:1
	TIMES SOURCE:TARGET:아픔 , 1.20
	TIMES SOURCE:TARGET:반감 , 2.00
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES SOURCE:TARGET:아픔 , 1.00
	TIMES SOURCE:TARGET:반감 , 1.50
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES SOURCE:TARGET:아픔 , 0.60
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES SOURCE:TARGET:아픔 , 0.30
ELSEIF PALAM:윤활 >= PALAMLV:4
	TIMES SOURCE:TARGET:아픔 , 0.20
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
IF TEQUIP:19 == 0
	CALL ADDS_EXP("Ａ경험", 1, TARGET)
	;PRINTL Ａ경험＋１
ELSEIF TEQUIP:19 == 1
	CALL ADDS_EXP("Ａ경험", 2, TARGET)
	;PRINTL Ａ경험＋２
ENDIF

A = 1
B = NO:PLAYER + 899
IF IS_LESBIAN(TARGET,PLAYER)
	PRINTFORML %EXPNAME:40%+{A}
	CALL ADDS_EXP("레즈경험", A, TARGET)
ELSEIF IS_GAY(TARGET,PLAYER)
	PRINTFORML %EXPNAME:41%+{A}
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
ENDIF

;依存度ベクトル
TFLAG:33 = 3


RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM46
;アナルビーズ挿入中

PRINTL ＜애널비즈 삽입 중＞

DOWNBASE:TARGET:체력 += 60
DOWNBASE:TARGET:기력 += 150

SOURCE:TARGET:도구쾌Ａ += 75
SOURCE:TARGET:노출 += 25
SOURCE:TARGET:굴종 += 25
SOURCE:TARGET:일탈 += 25

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 35

;Aへの苦痛は先に処理しておく
;EXP:Ａ経験をみる
A = 100
B = 25
IF EXP:Ａ경험 < EXPLV:1
	TIMES A , 3.00
	TIMES B , 3.00
ELSEIF EXP:Ａ경험 < EXPLV:2
	TIMES A , 1.20
	TIMES B , 2.00
ELSEIF EXP:Ａ경험 < EXPLV:3
	TIMES A , 0.80
	TIMES B , 1.50
ELSEIF EXP:Ａ경험 < EXPLV:4
	TIMES A , 0.60
	TIMES B , 1.20
ELSEIF EXP:Ａ경험 < EXPLV:5
	TIMES A , 0.40
ELSEIF EXP:Ａ경험 >= EXPLV:5
	TIMES A , 0.20
ENDIF

;PALAM:潤滑をみる
IF PALAM:윤활 < PALAMLV:1
	TIMES A , 1.20
	TIMES B , 2.00
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES A , 1.00
	TIMES B , 1.50
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES A , 0.60
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES A , 0.30
ELSEIF PALAM:윤활 >= PALAMLV:4
	TIMES A , 0.20
ENDIF
SOURCE:TARGET:아픔 += A
SOURCE:TARGET:반감 += B

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL ADDS_EXP("Ａ경험", 1, TARGET)
;PRINTL Ａ경험＋１


RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_46
RETURN COMTYPE("道具系")


