	TEQUIP:클리캡 = 0
	TEQUIP:오나홀 = 0
	TEQUIP:바이브 = 0
	TEQUIP:애널바이브 = 0
	TEQUIP:유두캡 = 0
	TEQUIP:착유기 = 0
	TEQUIP:밧줄 = 0
	;触手浣腸中ならまき散らす
	IF TEQUIP:관장기＋플러그 == 1
		;촉수관장
		CALL COM_COMMON,146
	ENDIF
;	TEQUIP:관장기＋플러그 = 0
	TEQUIP:확장벌룬 = 0
	TEQUIP:촉수구욕 = 0
