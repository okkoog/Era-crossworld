	TEQUIP:PLAYER:클리캡 = 0
	TEQUIP:PLAYER:오나홀 = 0
	TEQUIP:PLAYER:바이브 = 0
	TEQUIP:PLAYER:애널바이브 = 0
	TEQUIP:PLAYER:유두캡 = 0
	TEQUIP:PLAYER:착유기 = 0
