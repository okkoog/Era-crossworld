				CALL COM_COMMON,169
			ENDIF
		ELSE
			;未実行確認
			IF TEQUIP:클리캡 == 0
				;촉수클리자극
				CALL COM_COMMON,42
			ENDIF
		ENDIF
		
		IF TALENT:남자 == 0
			;未実行確認
			IF TEQUIP:바이브 == 0
				;촉수삽입
				CALL COM_COMMON,44
			ENDIF
		ENDIF
		
		;同じ個所が複数つくと解除できなくなる
		;尻が空いてるか
		IF !(TEQUIP:애널바이브 || TEQUIP:관장기＋플러그 || TEQUIP:확장벌룬)
			;애널촉수
			CALL COM_COMMON,45
		ENDIF
		
		;胸が空いてるか
		IF !(TEQUIP:유두캡 || TEQUIP:착유기)
			IF TALENT:모유체질
				;촉수착유
				CALL COM_COMMON,49
			ELSE
				;촉수유두자극
				CALL COM_COMMON,47
			ENDIF
		ENDIF
		
		;未実行確認
		IF TEQUIP:밧줄 == 0
			;촉수긴박
			CALL COM_COMMON,106
		ENDIF
		
		;未実行確認
		IF TEQUIP:촉수구욕 == 0
			;촉수구욕
			CALL COM_COMMON,168
		ENDIF
		
		;触手暴走フラグ初期化
		TFLAG:촉수폭주플래그 = 0
	ENDIF

	IF (FLAG:촉수레벨 + RAND:100) <= TEQUIP:촉수위험도 || TFLAG:촉수폭주시킨다플래그
	
		PRINTL 　
		PRINTW ･
		PRINTW ･
		PRINTW ･
		PRINTW !
		PRINTFORM 촉수는, %CALLNAME:TARGET%을(를) 덮치는 것만으로는 성에 차지 않는지 
		PRINTL 
		PRINTFORM %CALLNAME:PLAYER%에게 덤벼들었다
		PRINTL 
		PRINTW ･
		PRINTW ･
		PRINTW ･
		
		IF HAVE_PENIS(PLAYER)
		;IF !USE_CLI(PLAYER)
			;未実行確認
			IF TEQUIP:PLAYER:오나홀 == 0
				;촉수페니스자극시킨다
				CALL COM_COMMON,51
			ENDIF
		ELSE
			;未実行確認
			IF TEQUIP:PLAYER:클리캡 == 0
				;촉수클리자극시킨다
				CALL COM_COMMON,50
			ENDIF
		ENDIF
		
		IF TALENT:PLAYER:남자 == 0
			;未実行確認
			IF TEQUIP:PLAYER:바이브 == 0
				;촉수삽입시킨다
				CALL COM_COMMON,52
			ENDIF
		ENDIF
		
		;同じ個所が複数つくと解除できなくなる
		;尻が空いてるか
		IF !(TEQUIP:PLAYER:애널바이브 || TEQUIP:PLAYER:관장기＋플러그 || TEQUIP:PLAYER:확장벌룬)
			;애널촉수시킨다
			CALL COM_COMMON,53
		ENDIF
		
		;胸が空いてるか
		IF !(TEQUIP:PLAYER:유두캡 || TEQUIP:PLAYER:착유기)
			IF TALENT:PLAYER:모유체질
				;촉수착유시킨다
				CALL COM_COMMON,56
			ELSE
				;촉수유두자극시킨다
				CALL COM_COMMON,55
			ENDIF
		ENDIF
		
		
		;触手暴走させるフラグ初期化
		TFLAG:촉수폭주시킨다플래그 = 0
		;TEQUIP:촉수위험도 = LIMIT((FLAG:촉수레벨 - BASE:LV) * 10, 10, 80)
	ENDIF
	
	;他コマンドを呼び出したため退避した前回調教コマンドを付け直す
	;TSTR:0 = %ARGS:0%
	TSTR:0 = %LOCALS:0%

