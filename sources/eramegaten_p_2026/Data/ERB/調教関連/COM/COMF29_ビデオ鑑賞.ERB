;비디오감상
;コミュニケーション系コマンド、レベル4
;-------------------------------------------------
@ACT_COM29
PRINTL 비디오감상
TSTR:0 = 비디오감상
;CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 0
DOWNBASE:TARGET:기력 += 80

SOURCE:TARGET:무서움 = 1000
SOURCE:TARGET:복종 = 1000
SOURCE:TARGET:굴종 = 500
SOURCE:TARGET:일탈 = 200
SOURCE:TARGET:반감 = 200

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;依存度ベクトル
TFLAG:33 = 1

;依存度補正値
TFLAG:30 += 2

;ビデオ所持フラグを減らす
CFLAG:20 -= 1

RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_29
RETURN COMTYPE("コミュ系")

