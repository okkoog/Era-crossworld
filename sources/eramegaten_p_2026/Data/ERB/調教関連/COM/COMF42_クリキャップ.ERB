;-------------------------------------------------
;클리캡
;道具使用コマンド、レベル2
;-------------------------------------------------
@COMNAME42
IF TEQUIP:11 == 1
	RESULTS = 클리캡 해제
ELSE
	RESULTS = 클리캡
ENDIF
@ACT_COM42
;-------------------------------------------------
;特殊派生処理
;-------------------------------------------------
IF TEQUIP:25
	PRINTL 촉수클리자극
	TSTR:0 = 촉수클리자극
	SELECTCOM = 163
ELSE
	PRINTL 전동 클리캡
	TSTR:0 = 電動クリキャップ
ENDIF
;CALL KOJO_MESSAGE_COM

;着脱の処理
IF TEQUIP:11 == 0
	TEQUIP:11 = 1
ELSE
	TEQUIP:11 = 0
ENDIF

;調教者→調教対象
TFLAG:28 = 2
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 10
DOWNBASE:TARGET:기력 += 80

SOURCE:TARGET:도구쾌Ｃ = 200
SOURCE:TARGET:노출 = 20
SOURCE:TARGET:일탈 = 30
SOURCE:TARGET:반감 = 30


;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 30

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;触手クリ責めなら、触手体液がヴァギナに付く
SIF TEQUIP:25
	CALL SET_STAIN("바기나", "粘液", TARGET)

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
A = 1
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;触手召喚時、触手経験のリセットをする
;SIF TEQUIP:25 == 1
;	T = 0

;依存度ベクトル
TFLAG:33 = 1


RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM42
IF TEQUIP:25
	PRINTL ＜촉수클리괴롭힘 중＞
ELSE
	PRINTL ＜클리캡 장착 중＞
ENDIF


;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
DOWNBASE:TARGET:체력 += 5
DOWNBASE:TARGET:기력 += 20

SOURCE:TARGET:도구쾌Ｃ += 100
SOURCE:TARGET:노출 += 10
SOURCE:TARGET:일탈 += 15
SOURCE:TARGET:반감 += 15


;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;触手経験加算
SIF TEQUIP:25 == 1
	CALL ADDS_EXP("촉수경험", 1, TARGET)
	;T += 1


RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_42
RETURN COMTYPE("道具系")

