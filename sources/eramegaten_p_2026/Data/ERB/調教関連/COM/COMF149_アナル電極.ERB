;-------------------------------------------------
;애널전극
;ハードな調教コマンド、レベル4
;-------------------------------------------------
@COMNAME149
RESULTS = 애널전극
SIF TEQUIP:애널전극
	RESULTS = 애널 전극 해제
@ACT_COM149
PRINTL 애널전극
TSTR:0 = 애널전극
;CALL KOJO_MESSAGE_COM

;着脱の処理
IF TEQUIP:애널전극 == 0
	TEQUIP:애널전극 = 1
ELSE
	TEQUIP:애널전극 = 0
ENDIF

;調教者→調教対象
TFLAG:28 = 2
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 300
DOWNBASE:TARGET:기력 += 450

SOURCE:TARGET:도구쾌Ａ = 500
SOURCE:TARGET:아픔 = 1500
SOURCE:TARGET:노출 = 300
SOURCE:TARGET:굴종 = 800
SOURCE:TARGET:일탈 = 1200
SOURCE:TARGET:반감 = 1200

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 1200

;フィストなどのAへの大きな苦痛は先に処理しておく
;EXP:Ａ経験をみる
IF EXP:Ａ경험 < EXPLV:1
	TIMES SOURCE:TARGET:아픔 , 3.00
	TIMES SOURCE:TARGET:반감 , 4.00
ELSEIF EXP:Ａ경험 < EXPLV:2
	TIMES SOURCE:TARGET:아픔 , 2.50
	TIMES SOURCE:TARGET:반감 , 3.50
ELSEIF EXP:Ａ경험 < EXPLV:3
	TIMES SOURCE:TARGET:아픔 , 2.40
	TIMES SOURCE:TARGET:반감 , 3.00
ELSEIF EXP:Ａ경험 < EXPLV:4
	TIMES SOURCE:TARGET:아픔 , 2.00
	TIMES SOURCE:TARGET:반감 , 2.50
ELSEIF EXP:Ａ경험 < EXPLV:5
	TIMES SOURCE:TARGET:아픔 , 1.80
	TIMES SOURCE:TARGET:반감 , 2.00
ELSEIF EXP:Ａ경험 >= EXPLV:5
	TIMES SOURCE:TARGET:아픔 , 1.60
	TIMES SOURCE:TARGET:반감 , 1.50
ENDIF

;PALAM:潤滑をみる
IF PALAM:윤활 < PALAMLV:1
	TIMES SOURCE:TARGET:아픔 , 3.00
	TIMES SOURCE:TARGET:반감 , 2.00
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES SOURCE:TARGET:아픔 , 2.50
	TIMES SOURCE:TARGET:반감 , 1.50
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES SOURCE:TARGET:아픔 , 2.00
	TIMES SOURCE:TARGET:반감 , 1.20
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES SOURCE:TARGET:아픔 , 1.50
ELSEIF PALAM:윤활 >= PALAMLV:4
	TIMES SOURCE:TARGET:아픔 , 1.00
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;Ａ경험
CALL ADDS_EXP("Ａ경험", 25, TARGET)

;異常経験が5未満のとき、異常経験追加
;IF EXP:50 < 5
;	EXP:50 += 1
;	PRINTL 이상경험＋１
	CALL ADDS_ABNORMAL_EXP("電極", TARGET)
;ENDIF

;레즈경험
A = 1
IF IS_LESBIAN(TARGET,PLAYER)
	PRINTFORML %EXPNAME:40%+{A}
	CALL ADDS_EXP("레즈경험", A, TARGET)
ELSEIF IS_GAY(TARGET,PLAYER)
	PRINTFORML %EXPNAME:41%+{A}
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
ENDIF

;依存度ベクトル
TFLAG:33 = 5

;依存度補正値(服従で1、隷属で2）
IF TALENT:복종 && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF TALENT:예속 && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF


RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM149
;애널전극

PRINTL ＜애널 전극 삽입 중＞

DOWNBASE:TARGET:체력 += 200
DOWNBASE:TARGET:기력 += 250

SOURCE:TARGET:도구쾌Ａ += 250
SOURCE:TARGET:굴종 += 400
SOURCE:TARGET:일탈 += 600


;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 600

;フィストなどのAへの大きな苦痛は先に処理しておく
;EXP:Ａ経験をみる
A = 750
B = 600
IF EXP:Ａ경험 < EXPLV:1
	TIMES A , 3.00
	TIMES B , 4.00
ELSEIF EXP:Ａ경험 < EXPLV:2
	TIMES A , 2.50
	TIMES B , 3.50
ELSEIF EXP:Ａ경험 < EXPLV:3
	TIMES A , 2.40
	TIMES B , 3.00
ELSEIF EXP:Ａ경험 < EXPLV:4
	TIMES A , 2.00
	TIMES B , 2.50
ELSEIF EXP:Ａ경험 < EXPLV:5
	TIMES A , 1.80
	TIMES B , 2.00
ELSEIF EXP:Ａ경험 >= EXPLV:5
	TIMES A , 1.60
	TIMES B , 1.50
ENDIF

;PALAM:潤滑をみる
IF PALAM:윤활 < PALAMLV:1
	TIMES A , 3.00
	TIMES B , 2.00
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES A , 2.50
	TIMES B , 1.50
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES A , 2.00
	TIMES B , 1.20
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES A , 1.50
ELSEIF PALAM:윤활 >= PALAMLV:4
	TIMES A , 1.00
ENDIF
SOURCE:TARGET:아픔 += A
SOURCE:TARGET:반감 += B

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;Ａ경험
CALL ADDS_EXP("Ａ경험", 5, TARGET)


RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_149
RETURN COMTYPE("ハード系")




