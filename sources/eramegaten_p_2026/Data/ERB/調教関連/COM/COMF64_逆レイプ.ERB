;-------------------------------------------------
;역강간
;セックス系コマンド、レベル1
;-------------------------------------------------
@ACT_COM64
PRINTL 역강간

;-------------------------------------------------
;実行決定
;-------------------------------------------------

TSTR:0 = 역강간
;CALL KOJO_MESSAGE_COM

;調教者→調教対象
TFLAG:28 = 2
TEQUIP:PLAYER:Ｖ삽입자 = TARGET
TFLAG:삽입속행 = 1
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:기력 += 40
DOWNBASE:TARGET:기력 += 220

SOURCE:TARGET:쾌Ｃ = 400
SOURCE:TARGET:성행위 = 500
SOURCE:TARGET:굴종 = 1000
SOURCE:TARGET:일탈 = 500
SOURCE:TARGET:반감 = 500


;調教者に快Ｖ
SOURCE:PLAYER:쾌Ｖ = 400

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 700
	
;調教者が処女か再生処女（異常経験は一回のみ）
IF (TALENT:PLAYER:처녀 == 1 || TALENT:PLAYER:재생처녀 == 1)
	TIMES SOURCE:TARGET:노출 , 20.00
	TIMES SOURCE:TARGET:굴종 , 3.00
	PRINTFORM ＜%CALLNAME:PLAYER%은(는) 
	SIF TALENT:PLAYER:재생처녀 == 1
		PRINT 재생 
	PRINTL 처녀를 잃었습니다＞

	;異常経験追加
	SIF  !IS_MALE(TARGET)
		CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", TARGET)
ENDIF
;-------------------------------------------------
;射精チェック
;-------------------------------------------------

;射精先タイプの設定
TCVAR:TARGET:페니스사용대상 = PLAYER
TCVAR:TARGET:사정부위 = 1
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 0

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;膣内に破瓜の血の汚れを付加
SIF TALENT:PLAYER:처녀 == 1 || TALENT:PLAYER:재생처녀 == 1
	CALL SET_STAIN("질내", "破瓜の血", PLAYER)
;奴隷の膣内⇔調教者のＰの汚れが移動
CALL MOVE_STAIN("질내", TARGET, "페니스", PLAYER)

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;調教者のV経験
CALL ADDS_EXP("Ｖ경험", 1, PLAYER)

CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)
CALL ADDS_EXP("성교경험", 1, PLAYER)

;삽입경험
CALL ADDS_EXP("삽입경험", 1, TARGET)

;수간경험
IF (TALENT:PLAYER:짐승 || TALENT:PLAYER:새) && !(TALENT:TARGET:짐승 || TALENT:TARGET:새)
	CALL ADDS_EXP("수간경험", 1, TARGET)
ENDIF

;処女で同性の場合異常経験
IF TALENT:PLAYER:처녀
	SIF !IS_MALE(TARGET) 
		CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", TARGET)
	SIF !IS_MALE(TARGET)
		CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", PLAYER)
ENDIF
;近親相姦の場合異常経験付与
IF 近親チェック(TARGET , PLAYER)
	CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:0%）", TARGET)
	CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:1%）", PLAYER)
	
ENDIF
;레즈경험
A = 4
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;依存度ベクトル
TFLAG:33 = 1

;依存度補正値(主人かつ恋慕、淫乱、服従で1。親愛、娼婦、隷属で2）
IF (TALENT:연모 || TALENT:음란 || TALENT:5) && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF (TALENT:친애 || TALENT:창부 || TALENT:8) && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF

;奉仕快楽フラグ
TFLAG:100 = 1

RETURN 1
;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
@COM_ORDER_64, ARG, ARG:1
IF TEQUIP:ARG:밧줄
	CALL ADD_COM_ORDER, "判定無視", "긴박"
	RETURN 0
ENDIF
CALL ADD_COM_ORDER, "ABL", "욕망", 2, ARG, ARG:1
CALL ADD_COM_ORDER, "MARK", "쾌락각인", 2, ARG, ARG:1
CALL ADD_COM_ORDER, "PALAM", "욕정", 2, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "쾌감에솔직", 2, ARG, ARG:1
SIF !TALENT:ARG:음란 && !TALENT:ARG:창부
	CALL ADD_COM_ORDER, "TALENT", "쾌감을부정", -2, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "음란", 5, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "창부", 10, ARG, ARG:1
;調教者
CALL ADD_COM_ORDER, "TALENT", "처녀", -15, ARG:1, ARG
CALL ADD_COM_ORDER, "TALENT", "정조관념", -10, ARG:1, ARG
CALL ADD_COM_ORDER, "TALENT", "정조관결여", 5, ARG:1, ARG
CALL ADD_COM_ORDER, "ABL", "기교", 4, ARG:1, ARG
CALL ADD_COM_ORDER, "RELATION", , , ARG, ARG:1
;-------------------------------------------------
;実行値
;-------------------------------------------------
@COM_ORDER_NUM_64
RETURN 15
;===================================================
;調教タイプ
;===================================================
@COMTYPE_64
RETURN COMTYPE("ハード系")
