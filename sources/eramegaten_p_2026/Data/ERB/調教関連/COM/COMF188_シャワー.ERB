;-------------------------------------------------
;샤워
;特殊コマンド
;-------------------------------------------------
@ACT_COM188
PRINTL 샤워
TSTR:0 = 샤워
;CALL KOJO_MESSAGE_COM

;着脱の処理　装備時はソース、経験の加算は行わない
IF TEQUIP:32 == 1
	TEQUIP:32 = 0
ELSE
	TEQUIP:32 = 1
ENDIF

;依存度ベクトル
TFLAG:33 = 0


RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM188
;シャワー使用中

PRINTL ＜샤워 사용 중＞

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 0
DOWNBASE:TARGET:기력 += 10

SOURCE:TARGET:복종 += 100
SOURCE:TARGET:울굴 += 100
SOURCE:TARGET:반감 += 50

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;吸血鬼（流水の中では動けないため、いろいろ追加）
IF TALENT:132
	SOURCE:TARGET:무서움 += 200
	SOURCE:TARGET:굴종 += 200
	SOURCE:TARGET:불결 += 500
	SOURCE:TARGET:일탈 += 500
	SOURCE:TARGET:반감 += 500
ENDIF

;動物耳の場合（まぁ基本洗われるのは嫌と解釈）
IF TALENT:143
	SOURCE:TARGET:무서움 += 100
	SOURCE:TARGET:굴종 += 100
	SOURCE:TARGET:일탈 += 500
	SOURCE:TARGET:반감 += 500
ENDIF

;猫科の場合(超びびる。愛があれば無効)
IF (NO == [[キャラ:네코마타]] || NO == [[キャラ:바스테트]]) && 연모() == 0 && 친애() == 0
	SOURCE:TARGET:무서움 += 400
	SOURCE:TARGET:굴종 += 200
	SOURCE:TARGET:일탈 += 250
	SOURCE:TARGET:반감 += 500
	DOWNBASE:TARGET:체력 += 30
	DOWNBASE:TARGET:기력 += 50
ENDIF
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;シャワーで汚れは常にリセット
RESET_STAIN TARGET

;潤滑を1000減らす
IF PALAM:윤활 > 1000
	PALAM:윤활 -= 1000
ELSE
	PALAM:윤활 = 0
ENDIF

RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_188
RETURN COMTYPE("特殊コマンド系")


