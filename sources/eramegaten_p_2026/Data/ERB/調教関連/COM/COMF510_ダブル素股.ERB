;-------------------------------------------------
;더블스마타
;奉仕、レズ系派生コマンド
;-------------------------------------------------
@ACT_COM510
PRINTL 더블스마타

;-------------------------------------------------
;実行決定
;-------------------------------------------------
TSTR:0 = 더블스마타
;SELECTCOM = 510
;CALL KOJO_MESSAGE_COM

;実行者が奴隷であるフラグ
TFLAG:28 = 1

;-------------------------------------------------
;射精ゲージチェック
;-------------------------------------------------
B = 1400

;ABL:調教者の技巧をみる
IF ABL:기교 == 0
	TIMES B , 1.00
ELSEIF ABL:기교 == 1
	TIMES B , 1.20
ELSEIF ABL:기교 == 2
	TIMES B , 1.40
ELSEIF ABL:기교 == 3
	TIMES B , 1.60
ELSEIF ABL:기교 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.00
ENDIF

;ABL:助手の技巧をみる
IF ABL:ASSI:2 == 0
	TIMES B , 1.00
ELSEIF ABL:ASSI:2 == 1
	TIMES B , 1.20
ELSEIF ABL:ASSI:2 == 2
	TIMES B , 1.40
ELSEIF ABL:ASSI:2 == 3
	TIMES B , 1.60
ELSEIF ABL:ASSI:2 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.00
ENDIF

;ABL:従順をみる
IF ABL:순종 == 0
	TIMES B , 0.80
ELSEIF ABL:순종 == 1
	TIMES B , 0.90
ELSEIF ABL:순종 == 2
	TIMES B , 1.00
ELSEIF ABL:순종 == 3
	TIMES B , 1.10
ELSEIF ABL:순종 == 4
	TIMES B , 1.20
ELSE
	TIMES B , 1.30
ENDIF

;ABL:奉仕精神をみる
IF ABL:봉사정신 == 0
	TIMES B , 0.50
ELSEIF ABL:봉사정신 == 1
	TIMES B , 0.80
ELSEIF ABL:봉사정신 == 2
	TIMES B , 1.20
ELSEIF ABL:봉사정신 == 3
	TIMES B , 1.50
ELSEIF ABL:봉사정신 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.40
ENDIF

;プレイヤーのABL:Ｃ感覚をみる
IF ABL:PLAYER:Ｃ감각 == 0
	TIMES B , 1.00
ELSEIF ABL:PLAYER:Ｃ감각 == 1
	TIMES B , 1.50
ELSEIF ABL:PLAYER:Ｃ감각 == 2
	TIMES B , 2.00
ELSEIF ABL:PLAYER:Ｃ감각 == 3
	TIMES B , 2.50
ELSEIF ABL:PLAYER:Ｃ감각 == 4
	TIMES B , 3.50
ELSE
	TIMES B , 5.00
ENDIF

;;再装填処理中は射精ゲージは20分の1に
;SIF CFLAG:PLAYER:射精ゲージ再装填 > 0
;	B /= 20


SIF HAVE_PENIS(PLAYER)
	BASE:PLAYER:사정 += B

;調教者←調教対象
TFLAG:28 = 1
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 40
DOWNBASE:TARGET:기력 += 160

SOURCE:TARGET:쾌Ｃ = 170
SOURCE:TARGET:정애 = 100
SOURCE:TARGET:성행위 = 300
SOURCE:TARGET:달성 = 100
SOURCE:TARGET:굴종 = 600
SOURCE:TARGET:일탈 = 200
SOURCE:TARGET:반감 = 200

;上のほうで計算した汚れデータ
SOURCE:TARGET:불결 = Y*10 + 60

;調教者に快Ｃ
SOURCE:PLAYER:쾌Ｃ = 300
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 400

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
;射精先タイプの設定
TCVAR:PLAYER:페니스사용대상 = TARGET +(ASSI + 1) * 10000
TCVAR:PLAYER:사정부위 = 14
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 1
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;奴隷のＶ⇔調教者のＰの汚れが移動
CALL MOVE_STAIN("바기나", TARGET, "페니스", PLAYER)
;助手のＶ⇔調教者のＰの汚れが移動
CALL MOVE_STAIN("바기나", ASSI, "페니스", PLAYER)
;奴隷のＶ⇔助手のＶの汚れが移動
CALL MOVE_STAIN("바기나", TARGET, "바기나", ASSI)

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
A = 7
;레즈경험
IF IS_LESBIAN(TARGET,MASTER) && IS_LESBIAN(TARGET,ASSI) && IS_LESBIAN(MASTER,ASSI)
	A = 10
;	PRINTFORML %EXPNAME:40%+{A}
;	PRINTFORML %EXPNAME:40%(主人)+{A}
;	PRINTFORML %EXPNAME:40%(助手)+{A}
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, MASTER)
	CALL ADDS_EXP("레즈경험", A, ASSI)
ELSEIF IS_LESBIAN(TARGET,MASTER)
	A = 5
;	PRINTFORML %EXPNAME:40%+{A}
;	PRINTFORML %EXPNAME:40%(主人)+{A}
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, MASTER)
ELSEIF IS_LESBIAN(TARGET,ASSI)
	A = 5
;	PRINTFORML %EXPNAME:40%+{A}
;	PRINTFORML %EXPNAME:40%(助手)+{A}
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, ASSI)
ELSEIF IS_LESBIAN(MASTER,ASSI)
	A = 5
;	PRINTFORML %EXPNAME:40%(主人)+{A}
;	PRINTFORML %EXPNAME:40%(助手)+{A}
	CALL ADDS_EXP("레즈경험", A, MASTER)
	CALL ADDS_EXP("레즈경험", A, ASSI)
ENDIF

;ＢＬ경험
IF IS_GAY(TARGET,MASTER) && IS_GAY(TARGET,ASSI) && IS_GAY(MASTER,ASSI)
	A = 10
;	PRINTFORML %EXPNAME:41%+{A}
;	PRINTFORML %EXPNAME:41%(主人)+{A}
;	PRINTFORML %EXPNAME:41%(助手)+{A}
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, MASTER)
	CALL ADDS_EXP("ＢＬ경험", A, ASSI)
ELSEIF IS_GAY(TARGET,MASTER)
	A = 5
;	PRINTFORML %EXPNAME:41%+{A}
;	PRINTFORML %EXPNAME:41%(主人)+{A}
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, MASTER)
ELSEIF IS_GAY(TARGET,ASSI)
	A = 5
;	PRINTFORML %EXPNAME:41%+{A}
;	PRINTFORML %EXPNAME:41%(助手)+{A}
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, ASSI)
ELSEIF IS_GAY(MASTER,ASSI)
	A = 5
;	PRINTFORML %EXPNAME:41%(主人)+{A}
;	PRINTFORML %EXPNAME:41%(助手)+{A}
	CALL ADDS_EXP("ＢＬ경험", A, MASTER)
	CALL ADDS_EXP("ＢＬ경험", A, ASSI)
ENDIF

;依存度ベクトル
;P = PLAYER
IF GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:33 = 2
ELSEIF GET_RELATION(TARGET, PLAYER) < 100
	TFLAG:33 = 3
ELSE
	TFLAG:33 = 1
ENDIF

;依存度補正値(相性100↑かつ淫乱で2、娼婦で4）
;P = PLAYER
IF TALENT:음란 && GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:30 += 2
ELSEIF TALENT:창부 && GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:30 += 4
ENDIF

;奉仕快楽フラグ
TFLAG:100 = 1


RETURN 1
;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
@COM_ORDER_510, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "욕망", 2, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "봉사정신", 4, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "정액중독", 1, ARG, ARG:1
CALL ADD_COM_ORDER, "MARK", "쾌락각인", 2, ARG, ARG:1
CALL ADD_COM_ORDER, "PALAM", "욕정", 3, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "부끄럼쟁이", -1, ARG, ARG:1
SIF !TALENT:ARG:음란 && !TALENT:ARG:창부
	CALL ADD_COM_ORDER, "TALENT", "쾌감을부정", -3, ARG, ARG:1
;男嫌い（恋慕、親愛で無効）
SIF HATE(ARG, ARG:1)
	CALL ADD_COM_ORDER, "TALENT", \@IS_MALE(PLAYER) ? 남성혐오 # 여성혐오 \@, -7, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "연모", 3, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "친애", 6, ARG, ARG:1
;調教者がふたなり
CALL ADD_COM_ORDER, "TALENT", "후타나리", 8, ARG:1, ARG

CALL ADD_COM_ORDER, "EXTRA", "미약", 6, ARG, ARG:1
;素股では汚れの影響が少なめ
CALL ADD_COM_ORDER, "STAIN", "페니스", 33, ARG, ARG:1
CALL ADD_COM_ORDER, "RELATION", , , ARG, ARG:1
CALL ADD_COM_ORDER, "RELATION", , , ARG, SUBPLAYER()
;-------------------------------------------------
;実行値
;-------------------------------------------------
@COM_ORDER_NUM_510
RETURN 25
;===================================================
;調教タイプ
;===================================================
@COMTYPE_510
RETURN COMTYPE("派生系")


