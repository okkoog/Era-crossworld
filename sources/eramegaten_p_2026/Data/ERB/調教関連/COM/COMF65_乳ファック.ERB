;-------------------------------------------------
;젖성교
;セックス系コマンド、レベル1
;-------------------------------------------------
@ACT_COM65
PRINTL 젖성교

;-------------------------------------------------
;実行決定
;-------------------------------------------------
TSTR:0 = 젖성교
;CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;射精ゲージチェック
;-------------------------------------------------
B = 1500

;ABL:調教者の技巧をみる
IF ABL:PLAYER:기교 == 0
	TIMES B , 1.00
ELSEIF ABL:PLAYER:기교 == 1
	TIMES B , 1.20
ELSEIF ABL:PLAYER:기교 == 2
	TIMES B , 1.40
ELSEIF ABL:PLAYER:기교 == 3
	TIMES B , 1.60
ELSEIF ABL:PLAYER:기교 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.00
ENDIF

;ABL:従順をみる
IF ABL:순종 == 0
	TIMES B , 0.80
ELSEIF ABL:순종 == 1
	TIMES B , 0.90
ELSEIF ABL:순종 == 2
	TIMES B , 1.00
ELSEIF ABL:순종 == 3
	TIMES B , 1.10
ELSEIF ABL:순종 == 4
	TIMES B , 1.20
ELSE
	TIMES B , 1.30
ENDIF

;ABL:欲望をみる
IF ABL:욕망 == 0
	TIMES B , 1.00
ELSEIF ABL:욕망 == 1
	TIMES B , 1.10
ELSEIF ABL:욕망 == 2
	TIMES B , 1.20
ELSEIF ABL:욕망 == 3
	TIMES B , 1.30
ELSEIF ABL:욕망 == 4
	TIMES B , 1.40
ELSE
	TIMES B , 1.50
ENDIF

;PALAM:潤滑をみる
IF PALAM:윤활 < PALAMLV:1
	TIMES B , 0.60
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES B , 0.70
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES B , 0.80
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES B , 0.90
ELSEIF PALAM:윤활 >= PALAMLV:4
	TIMES B , 1.00
ENDIF

;調教対象のバストサイズを見る
;폭유
IF TALENT:112 || TALENT:마유
	TIMES B , 1.50
;거유
ELSEIF TALENT:111
	TIMES B , 1.20
;빈유
ELSEIF TALENT:109
	TIMES B , 0.90
;절벽
ELSEIF TALENT:110
	TIMES B , 0.70
ENDIF

;プレイヤーのABL:Ｃ感覚をみる
IF ABL:PLAYER:Ｃ감각 == 0
	TIMES B , 1.00
ELSEIF ABL:PLAYER:Ｃ감각 == 1
	TIMES B , 1.50
ELSEIF ABL:PLAYER:Ｃ감각 == 2
	TIMES B , 2.00
ELSEIF ABL:PLAYER:Ｃ감각 == 3
	TIMES B , 2.50
ELSEIF ABL:PLAYER:Ｃ감각 == 4
	TIMES B , 3.50
ELSE
	TIMES B , 5.00
ENDIF

;;再装填処理中は射精ゲージは20分の1に
;SIF CFLAG:PLAYER:射精ゲージ再装填 > 0
;	B /= 20


SIF HAVE_PENIS(PLAYER)
	BASE:PLAYER:사정 += B

;調教者→調教対象
TFLAG:28 = 2
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 60
DOWNBASE:TARGET:기력 += 100

SOURCE:TARGET:쾌Ｂ = 400
SOURCE:TARGET:정애 = 100
SOURCE:TARGET:아픔 = 400
SOURCE:TARGET:중독충족 = 150
SOURCE:TARGET:노출 = 40
SOURCE:TARGET:일탈 = 150
SOURCE:TARGET:반감 = 300

;上のほうで計算した汚れデータ
SOURCE:TARGET:불결 = Y*10 + 60

;調教者に快Ｃ
SOURCE:PLAYER:쾌Ｃ = 400
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 300

;中毒による中毒充足のソースは先に処理しておく
;セックス中毒を見る
IF ABL:섹스중독 == 0
	TIMES SOURCE:TARGET:중독충족 , 0.00
ELSEIF ABL:섹스중독 == 1
	TIMES SOURCE:TARGET:중독충족 , 0.30
ELSEIF ABL:섹스중독 == 2
	TIMES SOURCE:TARGET:중독충족 , 0.60
ELSEIF ABL:섹스중독 == 3
	TIMES SOURCE:TARGET:중독충족 , 0.90
ELSEIF ABL:섹스중독 == 4
	TIMES SOURCE:TARGET:중독충족 , 1.20
ELSEIF ABL:섹스중독 == 5
	TIMES SOURCE:TARGET:중독충족 , 1.50
ELSEIF ABL:섹스중독 == 6
	TIMES SOURCE:TARGET:중독충족 , 1.80
ELSEIF ABL:섹스중독 == 7
	TIMES SOURCE:TARGET:중독충족 , 2.10
ELSEIF ABL:섹스중독 == 8
	TIMES SOURCE:TARGET:중독충족 , 2.40
ELSEIF ABL:섹스중독 == 9
	TIMES SOURCE:TARGET:중독충족 , 3.00
ELSEIF ABL:섹스중독 >= 10
	TIMES SOURCE:TARGET:중독충족 , 5.00
ENDIF

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
;射精先タイプの設定
TCVAR:PLAYER:페니스사용대상 = TARGET
TCVAR:PLAYER:사정부위 = 5
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 1

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;奴隷の口⇔調教者のＰの汚れが移動
CALL MOVE_STAIN("입", TARGET, "페니스", PLAYER)
;奴隷のＢ⇔調教者のＰの汚れが移動
CALL MOVE_STAIN("가슴", TARGET, "페니스", PLAYER)

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:7+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:7+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;성교경험
CALL ADDS_EXP("성교경험", 1, TARGET)
;PRINTS EXPNAME:4;
;PRINTL +1
;수간경험
IF (TALENT:PLAYER:짐승 || TALENT:PLAYER:새) && !(TALENT:TARGET:짐승 || TALENT:TARGET:새)
	CALL ADDS_EXP("수간경험", 1, TARGET)
ENDIF


;레즈경험
A = 4
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;애정경험
IF TALENT:연모 == 1 && ASSIPLAY == 0
;	PRINTS EXPNAME:23
;	PRINTL +1
	CALL ADDS_EXP("애정경험", 1, TARGET)
;	PRINTFORML 애정경험(主人)＋１
	CALL ADDS_EXP("애정경험", 1, MASTER)
;	PRINTFORML 봉사쾌락경험(調教者) + 1
	CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)
ELSEIF TALENT:친애 == 1 && ASSIPLAY == 0
;	PRINTS EXPNAME:23
;	PRINTL +2
	CALL ADDS_EXP("애정경험", 4, TARGET)
;	PRINTFORML 애정경험(主人)＋１
	CALL ADDS_EXP("애정경험", 1, MASTER)
;	PRINTFORML 봉사쾌락경험(調教者) + 1
	CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)
ENDIF

;依存度ベクトル
TFLAG:33 = 1

;依存度補正値(主人かつ恋慕、淫乱、服従で1。親愛、娼婦、隷属で2）
IF (TALENT:연모 || TALENT:음란 || TALENT:5) && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF (TALENT:친애 || TALENT:창부 || TALENT:8) && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF


RETURN 1
;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
@COM_ORDER_65, ARG, ARG:1
IF TEQUIP:ARG:밧줄
	CALL ADD_COM_ORDER, "判定無視", "긴박"
	RETURN 0
ENDIF
CALL ADD_COM_ORDER, "ABL", "욕망", 3, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "Ｂ감각", 2, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "섹스중독", 1, ARG, ARG:1
CALL ADD_COM_ORDER, "MARK", "쾌락각인", 3, ARG, ARG:1
CALL ADD_COM_ORDER, "PALAM", "욕정", 3, ARG, ARG:1
;PALAM:潤滑（の不足）
SIF PALAM:ARG:윤활 < PALAMLV:3
	CALL ADD_COM_ORDER, "EXTRA", "潤滑不足", -5, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "부끄럼쟁이", -2, ARG, ARG:1
SIF !TALENT:ARG:음란 && !TALENT:ARG:창부
	CALL ADD_COM_ORDER, "TALENT", "쾌감을부정", -5, ARG, ARG:1
;男嫌い（恋慕、親愛で無効）
SIF HATE(ARG, ARG:1)
	CALL ADD_COM_ORDER, "TALENT", \@IS_MALE(PLAYER) ? 남성혐오 # 여성혐오 \@, -12, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "연모", 5, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "친애", 10, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "후타나리", 4, ARG:1, ARG
CALL ADD_COM_ORDER, "STAIN", "페니스", 100, ARG, ARG:1
CALL ADD_COM_ORDER, "EXTRA", "미약", 6, ARG, ARG:1
CALL ADD_COM_ORDER, "RELATION", , , ARG, ARG:1
;-------------------------------------------------
;実行値
;-------------------------------------------------
@COM_ORDER_NUM_65
RETURN 15
;===================================================
;調教タイプ
;===================================================
@COMTYPE_65
RETURN COMTYPE("ハード系")

