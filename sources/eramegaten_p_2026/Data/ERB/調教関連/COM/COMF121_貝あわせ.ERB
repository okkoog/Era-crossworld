;-------------------------------------------------
;조개맞대기
;助手によるコマンド、及びレズプレイ、レベル1
;-------------------------------------------------
@COMNAME121
RESULTS = 조개맞대기
SIF HAVE_PENIS(TARGET) && HAVE_PENIS(PLAYER)
	RESULTS = 투구 맞대기
@ACT_COM121
IF HAVE_PENIS(TARGET) && HAVE_PENIS(PLAYER)
	PRINTL 투구 맞대기
	TSTR:0 = 兜あわせ
ELSE
	PRINTL 조개맞대기
	TSTR:0 = 조개맞대기
ENDIF
;CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;絶頂ゲージチェック（ふたなりの場合）
;-------------------------------------------------
B = 1000

;ABL:調教者の技巧をみる
IF ABL:기교 == 0
	TIMES B , 1.00
ELSEIF ABL:기교 == 1
	TIMES B , 1.20
ELSEIF ABL:기교 == 2
	TIMES B , 1.40
ELSEIF ABL:기교 == 3
	TIMES B , 1.60
ELSEIF ABL:기교 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.00
ENDIF

;ABL:従順をみる
IF ABL:순종 == 0
	TIMES B , 0.80
ELSEIF ABL:순종 == 1
	TIMES B , 0.90
ELSEIF ABL:순종 == 2
	TIMES B , 1.00
ELSEIF ABL:순종 == 3
	TIMES B , 1.10
ELSEIF ABL:순종 == 4
	TIMES B , 1.20
ELSE
	TIMES B , 1.30
ENDIF

;ABL:奉仕精神をみる
IF ABL:봉사정신 == 0
	TIMES B , 0.50
ELSEIF ABL:봉사정신 == 1
	TIMES B , 0.80
ELSEIF ABL:봉사정신 == 2
	TIMES B , 1.20
ELSEIF ABL:봉사정신 == 3
	TIMES B , 1.50
ELSEIF ABL:봉사정신 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.40
ENDIF

;プレイヤーのABL:Ｃ感覚をみる
IF ABL:PLAYER:Ｃ감각 == 0
	TIMES B , 1.00
ELSEIF ABL:PLAYER:Ｃ감각 == 1
	TIMES B , 1.50
ELSEIF ABL:PLAYER:Ｃ감각 == 2
	TIMES B , 2.00
ELSEIF ABL:PLAYER:Ｃ감각 == 3
	TIMES B , 2.50
ELSEIF ABL:PLAYER:Ｃ감각 == 4
	TIMES B , 3.50
ELSE
	TIMES B , 5.00
ENDIF


;;再装填処理中は射精ゲージは20分の1に
;IF CFLAG:PLAYER:射精ゲージ再装填 > 0
;	B /= 20
;ENDIF

SIF !IS_MALE(PLAYER)
	BASE:PLAYER:99 += B

;調教者←→調教対象
TFLAG:28 = 3
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 30
DOWNBASE:TARGET:기력 += 90

SOURCE:TARGET:쾌Ｃ = 200
SOURCE:TARGET:성행위 = 200
SOURCE:TARGET:달성 = 100
SOURCE:TARGET:노출 = 50
SOURCE:TARGET:굴종 = 400
SOURCE:TARGET:일탈 = 400
SOURCE:TARGET:반감 = 400

;調教者にも同様の快Ｃ
SOURCE:PLAYER:쾌Ｃ = 200

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 400

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＶ⇔調教者のＶの汚れが移動
IF HAVE_PENIS(TARGET) && HAVE_PENIS(PLAYER)
	CALL MOVE_STAIN("페니스", TARGET, "페니스", PLAYER)
ELSE
	CALL MOVE_STAIN("바기나", TARGET, "바기나", PLAYER)
ENDIF

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:13+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:13+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
A = 8
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;依存度ベクトル
;P = PLAYER
IF GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:33 = 2
ELSEIF GET_RELATION(TARGET, PLAYER) < 100
	TFLAG:33 = 3
ELSE
	TFLAG:33 = 1
ENDIF

;依存度補正値(相性100↑かつ淫乱で2、娼婦で4）
;P = PLAYER
IF TALENT:음란 && GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:30 += 2
ELSEIF TALENT:창부 && GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:30 += 4
ENDIF


;	PRINTFORML 봉사쾌락경험(調教者) + 1
	CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)
TFLAG:100 = 1


RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_121
RETURN COMTYPE("助手・レズ系")



