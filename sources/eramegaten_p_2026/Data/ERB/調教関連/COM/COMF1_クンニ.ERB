;-------------------------------------------------
;커닐링구스
;愛撫系コマンド　レベル1
;-------------------------------------------------
@JUMP_COM1
;前回の調教がフェラチオかクンニ強制かシックスナインだとシックスナインに
SIF GROUPMATCH(PREVCOM, 81 , 120 , 501)
	RETURN 501
;前回の調教がパイズリかパイズリフェラか６９パイズリだと６９パイズリに
SIF GROUPMATCH(PREVCOM, 82 , 88, 508)
	RETURN 508
;羞恥プレイ中は岩清水に
SIF TEQUIP:30 == 1
	RETURN 502
RETURN -1
@ACT_COM1
PRINTL 커닐링구스
TSTR:0 = 커닐링구스
;CALL KOJO_MESSAGE_COM

;調教者→調教対象
TFLAG:28 = 2
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 5
DOWNBASE:TARGET:기력 += 50

SOURCE:TARGET:쾌Ｃ = 100
SOURCE:TARGET:액체 = 60
SOURCE:TARGET:노출 = 10
SOURCE:TARGET:일탈 = 15
SOURCE:TARGET:반감 = 15

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 20

;舌を使う調教では、調教者の舌使いによって、快感のソース増加
SIF TALENT:PLAYER:혀놀림
	TIMES SOURCE:TARGET:쾌Ｃ , 1.50

;猫舌では減少
SIF TALENT:PLAYER:54
	TIMES SOURCE:TARGET:쾌Ｃ , 0.75

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＶ⇔調教者の口の汚れが移動
CALL MOVE_STAIN("바기나", TARGET, "입", PLAYER)

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:4+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:4+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
A = 3
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;調教者が猫舌持ちの場合は、調教者に嗜虐快楽経験を追加
IF TALENT:PLAYER:54
	CALL ADDS_EXP("가학쾌락경험", 1, PLAYER)
ENDIF

;依存度ベクトル
TFLAG:33 = 1

RETURN 1


;===================================================
;調教タイプ
;===================================================
@COMTYPE_1
RETURN COMTYPE("愛撫系")