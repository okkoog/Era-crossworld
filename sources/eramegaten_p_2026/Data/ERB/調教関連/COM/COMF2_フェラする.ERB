;-------------------------------------------------
;펠라한다
;愛撫系コマンド、レベル1
;-------------------------------------------------
@JUMP_COM2
;-------------------------------------------------
;特殊派生処理
;-------------------------------------------------
;前回の調教がフェラチオかクンニ強制かシックスナインだとシックスナインに
SIF GROUPMATCH(PREVCOM, 81, 120, 501)
	RETURN 501
;前回の調教がパイズリかパイズリフェラか６９パイズリだと６９パイズリに
SIF GROUPMATCH(PREVCOM, 82, 88, 508)
	RETURN 508
RETURN -1
@ACT_COM2
PRINTL 펠라한다
TSTR:0 = 펠라한다
;CALL KOJO_MESSAGE_COM

;調教者→調教対象
TFLAG:28 = 2
TEQUIP:TARGET:입삽입자 = PLAYER
TCVAR:TARGET:페니스사용대상 = PLAYER
TCVAR:TARGET:사정부위 = 4
TFLAG:삽입속행 = 1
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
;消費体力、気力
DOWNBASE:TARGET:체력 += 10
DOWNBASE:TARGET:기력 += 80

SOURCE:TARGET:쾌Ｃ = 120
SOURCE:TARGET:노출 = 20
SOURCE:TARGET:일탈 = 20
SOURCE:TARGET:반감 = 20


;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 20

;調教者のTALENT:舌使いをみる
SIF TALENT:PLAYER:혀놀림
	TIMES SOURCE:TARGET:쾌Ｃ , 1.50

;調教者のTALENT:猫舌をみる
SIF TALENT:PLAYER:54
	TIMES SOURCE:TARGET:쾌Ｃ , 0.75


;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＰ⇔調教者の口の汚れが移動
CALL MOVE_STAIN("페니스", TARGET, "입", PLAYER)

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:5+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:5+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
A = 3
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;PRINTFORML 펠라경험(調教者) + 1
CALL ADDS_EXP("펠라경험", 1, PLAYER)

;調教者が猫舌持ちの場合は、調教者に嗜虐快楽経験を追加
IF TALENT:PLAYER:54
	CALL ADDS_EXP("가학쾌락경험", 1, PLAYER)
ENDIF

;依存度ベクトル
IF TALENT:PLAYER:140 == 1
	TFLAG:33 = 3
ELSE
	TFLAG:33 = 2
ENDIF

RETURN 1


;===================================================
;調教タイプ
;===================================================
@COMTYPE_2
RETURN COMTYPE("調教者奉仕系")
