;-------------------------------------------------
;애널바이브
;道具使用コマンド、レベル2
;-------------------------------------------------
@COMNAME45
IF TEQUIP:애널바이브
	RESULTS = 애널바이브 해제
ELSE
	RESULTS = 애널바이브
ENDIF
@ACT_COM45
;-------------------------------------------------
;特殊派生処理
;-------------------------------------------------
IF TEQUIP:25
	PRINTL 애널촉수
	TSTR:0 = 애널촉수
	SELECTCOM = 162
ELSE
	PRINTL 애널바이브
	TSTR:0 = 애널바이브
ENDIF
;CALL KOJO_MESSAGE_COM

;着脱の処理
IF TEQUIP:14 == 0
	TEQUIP:14 = 1
	;アナル触手は触手の汚れを追加
	IF TEQUIP:25
		CALL SET_STAIN("애널", "粘液", TARGET)
	ENDIF
ELSE
	TEQUIP:14 = 0
ENDIF
;調教者→調教対象
TFLAG:28 = 2
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 60
DOWNBASE:TARGET:기력 += 150

SOURCE:TARGET:도구쾌Ａ = 250
SOURCE:TARGET:노출 = 50
SOURCE:TARGET:굴종 = 50
SOURCE:TARGET:일탈 = 50

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 70

;Aへの苦痛は先に処理しておく
;EXP:Ａ経験をみる
IF EXP:Ａ경험 < EXPLV:1
	TIMES SOURCE:TARGET:아픔 , 3.00
	TIMES SOURCE:TARGET:반감 , 3.00
ELSEIF EXP:Ａ경험 < EXPLV:2
	TIMES SOURCE:TARGET:아픔 , 1.20
	TIMES SOURCE:TARGET:반감 , 2.00
ELSEIF EXP:Ａ경험 < EXPLV:3
	TIMES SOURCE:TARGET:아픔 , 0.80
	TIMES SOURCE:TARGET:반감 , 1.50
ELSEIF EXP:Ａ경험 < EXPLV:4
	TIMES SOURCE:TARGET:아픔 , 0.60
	TIMES SOURCE:TARGET:반감 , 1.20
ELSEIF EXP:Ａ경험 < EXPLV:5
	TIMES SOURCE:TARGET:아픔 , 0.40
ELSEIF EXP:Ａ경험 >= EXPLV:5
	TIMES SOURCE:TARGET:아픔 , 0.20
ENDIF

;PALAM:潤滑をみる
IF PALAM:윤활 < PALAMLV:1
	TIMES SOURCE:TARGET:아픔 , 1.20
	TIMES SOURCE:TARGET:반감 , 2.00
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES SOURCE:TARGET:아픔 , 1.00
	TIMES SOURCE:TARGET:반감 , 1.50
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES SOURCE:TARGET:아픔 , 0.60
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES SOURCE:TARGET:아픔 , 0.30
ELSEIF PALAM:윤활 >= PALAMLV:4
	TIMES SOURCE:TARGET:아픔 , 0.20
ENDIF

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;アナル触手なら、触手体液がアナルに付く
SIF TEQUIP:25
	CALL SET_STAIN("애널", "粘液", TARGET)

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;A経験
CALL ADDS_EXP("Ａ경험", 2, TARGET)
;PRINTL Ａ경험＋２

;레즈경험
A = 1
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;触手召喚時、触手経験のリセットをする
;SIF TEQUIP:25 == 1
;	T = 0

;依存度ベクトル
TFLAG:33 = 3


RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM45
;アナルバイブ挿入中
IF TEQUIP:25
	PRINTL ＜애널 촉수 삽입 중＞
ELSE
	PRINTL ＜애널바이브 삽입 중＞
ENDIF

DOWNBASE:TARGET:체력 += 30
DOWNBASE:TARGET:기력 += 80

SOURCE:TARGET:도구쾌Ａ += 125
SOURCE:TARGET:아픔 += 100
SOURCE:TARGET:노출 += 25
SOURCE:TARGET:일탈 += 25
SOURCE:TARGET:반감 += 40

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 35

;Aへの苦痛は先に処理しておく
;EXP:Ａ経験をみる
A = 100
B = 40
IF EXP:Ａ경험 < EXPLV:1
	TIMES A , 3.00
	TIMES B , 3.00
ELSEIF EXP:Ａ경험 < EXPLV:2
	TIMES A , 1.20
	TIMES B , 2.00
ELSEIF EXP:Ａ경험 < EXPLV:3
	TIMES A , 0.80
	TIMES B , 1.50
ELSEIF EXP:Ａ경험 < EXPLV:4
	TIMES A , 0.60
	TIMES B , 1.20
ELSEIF EXP:Ａ경험 < EXPLV:5
	TIMES A , 0.40
ELSEIF EXP:Ａ경험 >= EXPLV:5
	TIMES A , 0.20
ENDIF

;PALAM:潤滑をみる
IF PALAM:윤활 < PALAMLV:1
	TIMES A , 1.20
	TIMES B , 2.00
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES A , 1.00
	TIMES B , 1.50
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES A , 0.60
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES A , 0.30
ELSEIF PALAM:윤활 >= PALAMLV:4
	TIMES A , 0.20
ENDIF
SOURCE:TARGET:아픔 += A
SOURCE:TARGET:반감 += B

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;自慰実行時は経験＋１
IF SELECTCOM == 11
	CALL ADDS_EXP("Ａ경험", 2, TARGET)
	;PRINTL Ａ경험＋２
ELSE
	CALL ADDS_EXP("Ａ경험", 1, TARGET)
	;PRINTL Ａ경험＋１
ENDIF

;触手経験加算
SIF TEQUIP:25 == 1
	CALL ADDS_EXP("촉수경험", 1, TARGET)
;	T += 1


RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_45
RETURN COMTYPE("道具系")


