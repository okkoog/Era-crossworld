;-------------------------------------------------
;비디오카메라
;特殊コマンド
;-------------------------------------------------
@COMNAME183
RESULTS = 비디오카메라
SIF TEQUIP:비디오카메라
	RESULTS = 촬영 종료
@ACT_COM183
#DIM LCOUNT
#DIM ビデオ総撮影回数
#DIM ビデオ撮影内容
;カウントは10回とする
ビデオ総撮影回数 = 10

;撮影者の処理
$INPUT_LOOP
IF TEQUIP:비디오카메라 == 0 && ASSI >= 0
	PRINTL 촬영자를 선택해 주십시오. 도중 변경은 불가능합니다
	PRINTL （촬영자를 변경할 경우, 일단 촬영을 종료해 주십시오）
	PRINTL 
	PRINTFORML [0] %CALLNAME:MASTER%
	PRINTFORML [1] %CALLNAME:ASSI%
	PRINTFORML 
	INPUT
	IF RESULT == 0
		FLAG:촬영자 = 1
		PRINTFORML 촬영자는 %CALLNAME:MASTER%입니다
	ELSEIF RESULT == 1 && ASSI > 0
		FLAG:촬영자 = 2
		PRINTFORML 촬영자는 %CALLNAME:ASSI%입니다
	ELSE
		GOTO INPUT_LOOP
	ENDIF
ELSEIF TEQUIP:비디오카메라 == 0
	FLAG:촬영자 = 1
	PRINTFORML 촬영자는 %CALLNAME:MASTER%입니다
ENDIF


TSTR:0 = 비디오카메라
;CALL KOJO_MESSAGE_COM


;着脱の処理
IF TEQUIP:비디오카메라
;ビデオ撮影がされていれば終了させる
;テープは終了時に数を減らす、さらにこれまでの値段と経験を加算する
	TEQUIP:비디오카메라 = 0
	ITEM:비디오테이프 -= 1
	CALL PRICE_VIDEO
	PRINTW ★★★비디오 촬영을 종료합니다★★★
ELSE
;ビデオ撮影してなければ初期化して開始
;TODO 起動条件を作成する
	TEQUIP:비디오카메라 = 1
	TFLAG:70 = 0
	FOR LCOUNT, 0, ビデオ総撮影回数
		ビデオ撮影内容 = LCOUNT + 110
		TCVAR:ビデオ撮影内容 = -1
	NEXT
	PRINTW ★★★비디오 촬영을 시작합니다★★★
ENDIF

;依存度ベクトル
TFLAG:33 = 0


RETURN 1

;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM183
#DIM ビデオ総撮影回数
#DIM ビデオ撮影内容
#DIM 雑変数
;撮影開始時はカウントに入れない
IF TFLAG:70 == 0
	TFLAG:70 += 1
	RETURN 1
ENDIF

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 0
DOWNBASE:TARGET:기력 += 50

SOURCE:TARGET:무서움 += 1000
SOURCE:TARGET:일탈 += 400
SOURCE:TARGET:반감 += 700


;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 700

;苦痛を伴わないマゾっ気及びマゾの処理は先にしておく
;マゾっ気を見る
雑変数 = 1000
IF ABL:마조끼 == 0
	TIMES 雑変数 , 0.80
	SOURCE:TARGET:액체 += 0
	SOURCE:TARGET:욕정 += 0
ELSEIF ABL:마조끼 == 1
	TIMES 雑変数 , 1.00
	SOURCE:TARGET:액체 += 20
	SOURCE:TARGET:욕정 += 30
ELSEIF ABL:마조끼 == 2
	TIMES 雑変数 , 1.20
	SOURCE:TARGET:액체 += 40
	SOURCE:TARGET:욕정 += 70
ELSEIF ABL:마조끼 == 3
	TIMES 雑変数 , 1.40
	SOURCE:TARGET:액체 += 70
	SOURCE:TARGET:욕정 += 120
ELSEIF ABL:마조끼 == 4
	TIMES 雑変数 , 1.50
	SOURCE:TARGET:액체 += 110
	SOURCE:TARGET:욕정 += 180
ELSEIF ABL:마조끼 == 5
	TIMES 雑変数 , 1.70
	SOURCE:TARGET:액체 += 150
	SOURCE:TARGET:욕정 += 250
ELSEIF ABL:마조끼 == 6
	TIMES 雑変数 , 1.90
	SOURCE:TARGET:액체 += 200
	SOURCE:TARGET:욕정 += 300
ELSEIF ABL:마조끼 == 7
	TIMES 雑変数 , 2.10
	SOURCE:TARGET:액체 += 250
	SOURCE:TARGET:욕정 += 350
ELSEIF ABL:마조끼 == 8
	TIMES 雑変数 , 2.30
	SOURCE:TARGET:액체 += 300
	SOURCE:TARGET:욕정 += 400
ELSEIF ABL:마조끼 == 9
	TIMES 雑変数 , 2.50
	SOURCE:TARGET:액체 += 350
	SOURCE:TARGET:욕정 += 450
ELSEIF ABL:마조끼 >= 10
	TIMES 雑変数 , 3.00
	SOURCE:TARGET:액체 += 500
	SOURCE:TARGET:욕정 += 500
ENDIF
SOURCE:TARGET:노출 += 雑変数


;-------------------------------------------------
;経験の処理
;-------------------------------------------------
IF FLAG:촬영자 == 1
	CALL ADDS_EXP("촬영경험", 1, MASTER)
ELSEIF FLAG:촬영자 == 2
	CALL ADDS_EXP("촬영경험", 1, ASSI)
ENDIF
CALL ADDS_EXP("피사경험", 1, TARGET)
;依存度ベクトルを強制的に変更
SIF TFLAG:33 == 1 || TFLAG:33 == 2
	TFLAG:33 = 3

;依存度補正値(服従で1、隷属で2　強制変更なのでリセット）
IF TALENT:복종 && ASSIPLAY == 0
	TFLAG:30 = 1
ELSEIF TALENT:예속 && ASSIPLAY == 0
	TFLAG:30 = 2
ENDIF


;-------------------------------------------------
;ビデオの処理
;-------------------------------------------------
;カウントは10回とします
ビデオ総撮影回数 = 10

;テープ残量がなくなると強制的にEQUIPフラグを外す、さらにビデオの値段と経験の処理をする
IF TFLAG:70 <= 0 || TFLAG:70 >= ビデオ総撮影回数
	TEQUIP:비디오카메라 = 0
	ITEM:비디오테이프 -= 1
	;撮影内容の保存
	ビデオ撮影内容 = TFLAG:70 + 109
	IF TFLAG:90
		;特殊な場合
		;TFLAG:90によって記録される
		
		TCVAR:ビデオ撮影内容 = TFLAG:90
		;用が済んだTFLAG:90は初期化しておくか
		TFLAG:90 = 0
	ELSE
		TCVAR:ビデオ撮影内容 = SELECTCOM
	ENDIF
	TFLAG:70 += 1
	CALL PRICE_VIDEO
	PRINTL ＜테이프의 잔량이 다 떨어졌습니다. 비디오 촬영을 종료합니다＞
	RETURN 1
ELSE
	PRINTFORML ＜비디오 촬영 중 {TFLAG:70}/{ビデオ総撮影回数}＞
ENDIF

;撮影内容の保存
ビデオ撮影内容 = TFLAG:70 + 109
IF TFLAG:90
	TCVAR:ビデオ撮影内容 = TFLAG:90
	TFLAG:90 = 0
ELSE
	TCVAR:ビデオ撮影内容 = SELECTCOM
ENDIF
TFLAG:70 += 1

RETURN 1


;===================================================
;調教タイプ
;===================================================
@COMTYPE_183
RETURN COMTYPE("特殊コマンド系")


