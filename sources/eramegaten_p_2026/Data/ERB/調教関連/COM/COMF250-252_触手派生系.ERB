;-------------------------------------------------
;触手挿入からの派生コマンド
;-------------------------------------------------

;-------------------------------------------------
;촉수Ｖ피스톤
;-------------------------------------------------

@COMNAME250
;촉수Ｖ피스톤

IF TEQUIP:13 == 1
	RESULTS = 촉수Ｖ피스톤
ENDIF

@ACT_COM250
PRINTL 촉수Ｖ피스톤
TSTR:0 = 촉수Ｖ피스톤
SELECTCOM = 250
;CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力

DOWNBASE:TARGET:체력 += MAX(30, 60 - FLAG:촉수레벨)
DOWNBASE:TARGET:기력 += MAX(60, 120 - FLAG:촉수레벨)

SOURCE:TARGET:쾌Ｖ = 800
SOURCE:TARGET:정애 = 2000
SOURCE:TARGET:아픔 = 400
SOURCE:TARGET:굴종 = 7500
SOURCE:TARGET:중독충족 = 2000
SOURCE:TARGET:노출 = 1200
SOURCE:TARGET:액체 = 4000
SOURCE:TARGET:욕정 = 12000

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;触手経験は先に見ておく
IF EXP:촉수경험 < EXPLV:1
	TIMES DOWNBASE:TARGET:체력 , 1.20
	TIMES DOWNBASE:TARGET:기력 , 1.20
ELSEIF EXP:촉수경험 < EXPLV:2
	TIMES DOWNBASE:TARGET:체력 , 0.90
	TIMES DOWNBASE:TARGET:기력 , 0.90
ELSEIF EXP:촉수경험 < EXPLV:3
	TIMES DOWNBASE:TARGET:체력 , 0.80
	TIMES DOWNBASE:TARGET:기력 , 0.80
ELSEIF EXP:촉수경험 < EXPLV:4
	TIMES DOWNBASE:TARGET:체력 , 0.70
	TIMES DOWNBASE:TARGET:기력 , 0.70
ELSEIF EXP:촉수경험 < EXPLV:5
	TIMES DOWNBASE:TARGET:체력 , 0.60
	TIMES DOWNBASE:TARGET:기력 , 0.60
ELSE
	TIMES DOWNBASE:TARGET:체력 , 0.50
	TIMES DOWNBASE:TARGET:기력 , 0.50
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;自慰実行時は経験＋１
IF SELECTCOM == 11
	CALL ADDS_EXP("Ｖ경험", 2, TARGET)
ELSE
	CALL ADDS_EXP("Ｖ경험", 1, TARGET)
ENDIF

;触手経験加算
SIF TEQUIP:25 == 1
	CALL ADDS_EXP("촉수경험", 1, TARGET)
;	T += 1
CALL ADDS_EXP("Ｖ확장경험", 1, TARGET)
;PRINTL Ｖ확장경험＋1

RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_250
RETURN COMTYPE("触手系")

RETURN 1

