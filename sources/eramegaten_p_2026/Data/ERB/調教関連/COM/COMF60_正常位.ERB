;-------------------------------------------------
;정상위
;セックス系コマンド、レベル1
;-------------------------------------------------
@JUMP_COM60
;-------------------------------------------------
;特殊派生処理
;-------------------------------------------------
;前回の調教がフェラチオかイマラチオかアナルセックスか3Pのときは3Pへ
IF GROUPMATCH(PREVCOM, 81, 140, 62, 63, 500 ,513, 514) && TEQUIP:TARGET:Ｖ삽입자 != SUBPLAYER()
	IF TEQUIP:TARGET:Ａ삽입자 == SUBPLAYER()
		RETURN 500
	ELSEIF TEQUIP:TARGET:입삽입자 == SUBPLAYER()
		RETURN 513
	ENDIF
ENDIF
;前のプレイが正常位かつ調教者の技巧3以上の場合、挿入局所責めへ派生。
SIF PREVCOM == 60 && (ABL:PLAYER:기교 > 2)
	RETURN 506
RETURN -1
@ACT_COM60

PRINTL 정상위
;-------------------------------------------------
;実行決定
;-------------------------------------------------

TSTR:0 = 정상위
;CALL KOJO_MESSAGE_COM

;V経験を伴うコマンドのフラグ(処女膜再生対応)
TFLAG:19 = 1
SIF ASSIPLAY == 0
	TFLAG:20 = 1

;処女喪失時のテキスト用処理
SIF TFLAG:계속삽입 && (PREVCOM == 60 || PREVCOM == 61 || PREVCOM == 66 || PREVCOM == 68 || PREVCOM == 69) && (TFLAG:전회조교자 == PLAYER) && TFLAG:31
	TFLAG:31 = 2
;-------------------------------------------------
;射精ゲージチェック
;-------------------------------------------------
B = 1500

;ABL:調教者の技巧をみる
IF ABL:PLAYER:기교 == 0
	TIMES B , 1.00
ELSEIF ABL:PLAYER:기교 == 1
	TIMES B , 1.20
ELSEIF ABL:PLAYER:기교 == 2
	TIMES B , 1.40
ELSEIF ABL:PLAYER:기교 == 3
	TIMES B , 1.60
ELSEIF ABL:PLAYER:기교 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.00
ENDIF

;ABL:従順をみる
IF ABL:순종 == 0
	TIMES B , 0.80
ELSEIF ABL:순종 == 1
	TIMES B , 0.90
ELSEIF ABL:순종 == 2
	TIMES B , 1.00
ELSEIF ABL:순종 == 3
	TIMES B , 1.10
ELSEIF ABL:순종 == 4
	TIMES B , 1.20
ELSE
	TIMES B , 1.30
ENDIF

;ABL:欲望をみる
IF ABL:욕망 == 0
	TIMES B , 1.00
ELSEIF ABL:욕망 == 1
	TIMES B , 1.10
ELSEIF ABL:욕망 == 2
	TIMES B , 1.20
ELSEIF ABL:욕망 == 3
	TIMES B , 1.30
ELSEIF ABL:욕망 == 4
	TIMES B , 1.40
ELSE
	TIMES B , 1.50
ENDIF

;PALAM:潤滑をみる
IF PALAM:윤활 < PALAMLV:1
	TIMES B , 0.60
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES B , 0.80
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES B , 1.00
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES B , 1.20
ELSEIF PALAM:윤활 >= PALAMLV:4
	TIMES B , 1.40
ENDIF

;プレイヤーのABL:Ｃ感覚をみる
IF ABL:PLAYER:Ｃ감각 == 0
	TIMES B , 1.00
ELSEIF ABL:PLAYER:Ｃ감각 == 1
	TIMES B , 1.50
ELSEIF ABL:PLAYER:Ｃ감각 == 2
	TIMES B , 2.00
ELSEIF ABL:PLAYER:Ｃ감각 == 3
	TIMES B , 2.50
ELSEIF ABL:PLAYER:Ｃ감각 == 4
	TIMES B , 3.50
ELSE
	TIMES B , 5.00
ENDIF

;EXP:Ｖ経験をみる
;処女だと増える
SIF EXP:Ｖ경험 < EXPLV:1
	TIMES B , 1.50

;;再装填処理中は射精ゲージは20分の1に
;SIF CFLAG:PLAYER:射精ゲージ再装填 > 0
;	B /= 20


SIF HAVE_PENIS(PLAYER)
	BASE:PLAYER:사정 += B

;調教者←→調教対象
TFLAG:28 = 3
TEQUIP:TARGET:Ｖ삽입자 = PLAYER
TFLAG:삽입속행 = 1
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 50
DOWNBASE:TARGET:기력 += 100

SOURCE:TARGET:쾌Ｖ = 400
SOURCE:TARGET:정애 = 150
SOURCE:TARGET:아픔 = 500
SOURCE:TARGET:중독충족 = 200
SOURCE:TARGET:노출 = 50
SOURCE:TARGET:반감 = 300

;上のほうで計算した汚れデータ
SOURCE:TARGET:불결 = Y*10 + 60

;調教者に快Ｃ
SOURCE:PLAYER:쾌Ｃ = 400
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 300

;貞操観念持ちで恋慕、親愛持ち以外には常に反発のソースを追加する（セックス系のみ）
SIF TALENT:정조관념 && !IS_LOVER(TARGET)
	SOURCE:TARGET:반감 += 1000

;処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:처녀 == 1
	SOURCE:TARGET:아픔 += 2000
	SOURCE:TARGET:반감 += 3000
ENDIF

;再生処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:재생처녀 == 1
	SOURCE:TARGET:아픔 += 500
	SOURCE:TARGET:반감 += 1000
ENDIF

;苦痛回りは新しく作ったやつにぶん投げ
CALL CHINPO,TARGET,PLAYER,"V"

;中毒による中毒充足のソースは先に処理しておく
;セックス中毒を見る
IF ABL:섹스중독 == 0
	TIMES SOURCE:TARGET:중독충족 , 0.00
ELSEIF ABL:섹스중독 == 1
	TIMES SOURCE:TARGET:중독충족 , 0.30
ELSEIF ABL:섹스중독 == 2
	TIMES SOURCE:TARGET:중독충족 , 0.60
ELSEIF ABL:섹스중독 == 3
	TIMES SOURCE:TARGET:중독충족 , 0.90
ELSEIF ABL:섹스중독 == 4
	TIMES SOURCE:TARGET:중독충족 , 1.20
ELSEIF ABL:섹스중독 == 5
	TIMES SOURCE:TARGET:중독충족 , 1.50
ELSEIF ABL:섹스중독 == 6
	TIMES SOURCE:TARGET:중독충족 , 1.80
ELSEIF ABL:섹스중독 == 7
	TIMES SOURCE:TARGET:중독충족 , 2.10
ELSEIF ABL:섹스중독 == 8
	TIMES SOURCE:TARGET:중독충족 , 2.40
ELSEIF ABL:섹스중독 == 9
	TIMES SOURCE:TARGET:중독충족 , 3.00
ELSEIF ABL:섹스중독 >= 10
	TIMES SOURCE:TARGET:중독충족 , 5.00
ENDIF

;-------------------------------------------------
;射精チェック
;-------------------------------------------------

;射精先タイプの設定
TCVAR:PLAYER:페니스사용대상 = TARGET
TCVAR:PLAYER:사정부위 = 1
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 1
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;膣内に破瓜の血の汚れを付加
SIF TALENT:처녀 == 1 || TALENT:재생처녀 == 1
	CALL SET_STAIN("질내", "破瓜の血", TARGET)
;奴隷の膣内⇔調教者のＰの汚れが移動
CALL MOVE_STAIN("질내", TARGET, "페니스", PLAYER)

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;V経験
CALL ADDS_EXP("Ｖ경험", 1, TARGET)

;성교경험
CALL ADDS_EXP("성교경험", 1, TARGET)

;삽입경험
CALL ADDS_EXP("삽입경험", 1, PLAYER)

;수간경험
IF (TALENT:PLAYER:짐승 || TALENT:PLAYER:새) && !(TALENT:TARGET:짐승 || TALENT:TARGET:새)
	CALL ADDS_EXP("수간경험", 1, TARGET)
ENDIF

;処女で同性の場合異常経験
IF TALENT:TARGET:처녀
	SIF !IS_MALE(PLAYER) 
		CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", PLAYER)
	SIF !IS_MALE(PLAYER)
		CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", TARGET)
ENDIF

;近親相姦の場合異常経験付与
IF 近親チェック(TARGET , PLAYER)
	CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:0%）", TARGET)
	CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:1%）", PLAYER)
ENDIF

;助手が配偶者の場合異常経験付与
IF CSV配偶者(TARGET, ASSI)
	CALL ADDS_ABNORMAL_EXP( @"寝取られ", TARGET)
	CALL ADDS_ABNORMAL_EXP( @"寝取られ", ASSI)
ENDIF

;레즈경험
A = 4
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;애정경험
IF TALENT:연모 == 1 && ASSIPLAY == 0
	CALL ADDS_EXP("애정경험", 2, TARGET)
	CALL ADDS_EXP("애정경험", 1, MASTER)
	CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)
ELSEIF TALENT:친애 == 1 && ASSIPLAY == 0
	CALL ADDS_EXP("애정경험", 4, TARGET)
	CALL ADDS_EXP("애정경험", 1, MASTER)
	CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)
ENDIF

;依存度ベクトル
TFLAG:33 = 1

;依存度補正値(恋慕で1、親愛で2）
IF TALENT:연모 && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF TALENT:친애 && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF

RETURN 1
;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
@COM_ORDER_60, ARG, ARG:1
IF TEQUIP:ARG:밧줄
	CALL ADD_COM_ORDER, "判定無視", "긴박"
	RETURN 0
ENDIF
CALL ADD_COM_ORDER, "ABL", "욕망", 3, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "Ｖ감각", 2, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "섹스중독", 1, ARG, ARG:1
CALL ADD_COM_ORDER, "MARK", "쾌락각인", 3, ARG, ARG:1
;PALAM:潤滑（の不足）
SIF PALAM:ARG:윤활 < PALAMLV:3
	CALL ADD_COM_ORDER, "EXTRA", "潤滑不足", -5, ARG, ARG:1
CALL ADD_COM_ORDER, "PALAM", "욕정", 3, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "부끄럼쟁이", -2, ARG, ARG:1
SIF !TALENT:ARG:음란 && !TALENT:ARG:창부
	CALL ADD_COM_ORDER, "TALENT", "쾌감을부정", -5, ARG, ARG:1
;男嫌い（恋慕、親愛で無効）
SIF HATE(ARG, ARG:1)
	CALL ADD_COM_ORDER, "TALENT", \@IS_MALE(PLAYER) ? 남성혐오 # 여성혐오 \@, -12, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "연모", 15, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "친애", 20, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "처녀", -40, ARG, ARG:1
SIF !TALENT:ARG:처녀 && EXP:ARG:Ｖ경험 < EXPLV:2
	CALL ADD_COM_ORDER, "EXTRA", "Ｖ経験不足", -15, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "후타나리", 4, ARG:1, ARG
CALL ADD_COM_ORDER, "STAIN", "페니스", 100, ARG, ARG:1
CALL ADD_COM_ORDER, "EXTRA", "미약", 6, ARG, ARG:1
CALL ADD_COM_ORDER, "RELATION", , , ARG, ARG:1

;-------------------------------------------------
;実行値
;-------------------------------------------------
@COM_ORDER_NUM_60
RETURN 20
;===================================================
;調教タイプ
;===================================================
@COMTYPE_60
RETURN COMTYPE("Ｖ性交系")



