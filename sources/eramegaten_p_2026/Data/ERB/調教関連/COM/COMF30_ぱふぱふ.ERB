@CHECK_COM_ABLE30

;パイズリする実行判定
;某RPGだと男でもぱふぱふできたけど…流石にそれは…
SIF TALENT:110
	RETURN 0
SIF !USE_HAND(TARGET)
	RETURN 0
SIF !USE_BREAST(TARGET,0,8)
	RETURN 0
;触手調教中はダメ
SIF TEQUIP:25
	RETURN 0
RETURN 1

@ACT_COM30
PRINTL 파후파후
TSTR:0 = 파후파후
;CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 5
DOWNBASE:TARGET:기력 += 20

SOURCE:TARGET:복종 = 50
SOURCE:TARGET:3 = 100

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;依存度ベクトル
TFLAG:33 = 1

;依存度補正値
TFLAG:30 += 2

;애정경험
IF (TALENT:연모 == 1 || TALENT:친애 == 1) && ASSIPLAY == 0
;	PRINTS EXPNAME:23
;	PRINTL +1
	CALL ADDS_EXP("애정경험", 1, TARGET)
;	PRINTFORML 애정경험(主人)＋１
	CALL ADDS_EXP("애정경험", 1, MASTER)
ENDIF

RETURN 1

@MESSAGE_COM30
PRINTFORM %CALLNAME:TARGET%은(는) %CALLNAME:PLAYER%의 얼굴을 
IF TALENT:110 && RAND:3 == 0
	PRINT 풍만한 가슴
ELSEIF TALENT:112
	PRINT 너무 풍만할 정도의 가슴
ELSEIF TALENT:109
	PRINT 앙증맞은 가슴
ELSE
	PRINT 부드러운 가슴
ENDIF
IF (TALENT:110 || TALENT:112) && RAND:4 == 0
	PRINTFORMW 으로 감싸왔다…
ELSEIF TALENT:109
	PRINTFORMW 에 꽉 눌러왔다…
ELSE
	PRINTFORMW 의 골짜기로 끼워왔다…
ENDIF

