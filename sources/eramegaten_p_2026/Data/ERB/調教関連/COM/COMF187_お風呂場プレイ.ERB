;-------------------------------------------------
;목욕탕플레이
;特殊なコマンド
;-------------------------------------------------
@COMNAME187
RESULTS = 목욕탕플레이
SIF TEQUIP:31
	RESULTS = 목욕탕 플레이 종료
@ACT_COM187
PRINTL 목욕탕플레이
TSTR:0 = 목욕탕플레이
;CALL KOJO_MESSAGE_COM

;着脱の処理　終了時はソース、経験の加算は行わない
IF TEQUIP:31 == 1
	TEQUIP:31 = 0
	;シャワーも外す
	TEQUIP:32 = 0
	RETURN 1
ELSE
	TEQUIP:31 = 1
ENDIF

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 0
DOWNBASE:TARGET:기력 += 30

SOURCE:TARGET:무서움 = 100
SOURCE:TARGET:노출 = 200
SOURCE:TARGET:일탈 = 50
SOURCE:TARGET:반감 = 100


;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 50


;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;装備時に汚れをリセットする（風呂に来て汚れたままもどうかということで）
RESET_STAIN TARGET


;依存度ベクトル
TFLAG:33 = 2

RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM187
;목욕탕플레이

PRINTL ＜목욕탕플레이중＞

DOWNBASE:TARGET:체력 += 10
DOWNBASE:TARGET:기력 += 10

SOURCE:TARGET:무서움 += 50
SOURCE:TARGET:복종 += 100
SOURCE:TARGET:반감 += 50



RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_187
RETURN COMTYPE("特殊コマンド系")


