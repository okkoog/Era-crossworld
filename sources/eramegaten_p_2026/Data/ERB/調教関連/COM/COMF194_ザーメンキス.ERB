;-------------------------------------------------
;정액키스
;特殊コマンド
;-------------------------------------------------
@ACT_COM194
PRINTL 정액키스
TSTR:0 = 정액키스
;CALL KOJO_MESSAGE_COM


;汚れの計算
Y = 0
;愛液の汚れ
SIF GET_STAIN("페니스", "愛液", PLAYER)
	Y += 1
;精液の汚れ
SIF GET_STAIN("페니스", "精液", PLAYER)
	Y += 3
;アナルの汚れ
SIF GET_STAIN("페니스", "애널", PLAYER)
	Y += 7
SIF GET_STAIN("페니스", "粘液", PLAYER)
	Y += 15

SIF TALENT:악취둔감
	Y /= 3
SIF TALENT:악취민감
	Y *= 2

;調教者←→調教対象
TFLAG:28 = 3

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 0
DOWNBASE:TARGET:기력 += 80

SOURCE:TARGET:성행위 = 420
SOURCE:TARGET:달성 = 150
SOURCE:TARGET:굴종 = 1200
SOURCE:TARGET:일탈 = 500
SOURCE:TARGET:반감 = 500

;上のほうで計算した汚れデータ
SOURCE:TARGET:불결 = Y*40 + 100


;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 300
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;調教者の口の汚れと奴隷の口の汚れを処理
CALL MOVE_STAIN("입", TARGET, "입", PLAYER)
;S = STAIN:PLAYER:0
;STAIN:PLAYER:0 |= STAIN:TARGET:0
;STAIN:TARGET:0 |= S

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
A = 5
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF


;키스경험
CALL ADDS_EXP("키스경험", 1, TARGET)
CALL ADDS_EXP("키스경험", 1, PLAYER)

RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_194
RETURN COMTYPE("特殊コマンド系")


