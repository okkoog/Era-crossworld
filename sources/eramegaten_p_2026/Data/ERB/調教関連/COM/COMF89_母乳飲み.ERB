;-------------------------------------------------
;모유마시기
;奉仕系コマンド、レベル4
;-------------------------------------------------
@ACT_COM89
PRINTL 모유마시기
;-------------------------------------------------
;実行決定
;-------------------------------------------------
TSTR:0 = 모유마시기
;CALL KOJO_MESSAGE_COM

;調教者→調教対象
TFLAG:28 = 2
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 50
DOWNBASE:TARGET:기력 += 180

SOURCE:TARGET:정애 = 1000
SOURCE:TARGET:달성 = 1000
SOURCE:TARGET:복종 = 2000
SOURCE:TARGET:굴종 = 1800
SOURCE:TARGET:일탈 = 100
SOURCE:TARGET:반감 = 100


;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＢ⇔調教者の口の汚れが移動
CALL MOVE_STAIN("가슴", TARGET, "입", PLAYER)

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:5+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:5+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
A = 5
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;애정경험
IF (TALENT:연모 == 1 || TALENT:친애 == 1) && ASSIPLAY == 0
;	PRINTS EXPNAME:23
;	PRINTL +1
	CALL ADDS_EXP("애정경험", 1, TARGET)
;	PRINTFORML 애정경험(主人)＋１
	CALL ADDS_EXP("애정경험", 1, MASTER)
ENDIF

;依存度ベクトル
TFLAG:33 = 4

;依存度補正値(主人かつ恋慕で1、親愛で2）
IF TALENT:연모 && ASSIPLAY == 0
	TFLAG:30 += 2
ELSEIF TALENT:친애 && ASSIPLAY == 0
	TFLAG:30 += 4
ENDIF


RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_89
RETURN COMTYPE("奉仕系")
