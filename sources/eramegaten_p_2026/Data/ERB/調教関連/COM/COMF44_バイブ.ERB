;-------------------------------------------------
;바이브
;道具使用コマンド、レベル2
;-------------------------------------------------
@COMNAME44
IF TEQUIP:13
	RESULTS = 바이브 해제
ELSE
	RESULTS = 바이브
ENDIF
@ACT_COM44
;-------------------------------------------------
;特殊派生処理
;-------------------------------------------------
IF TEQUIP:25
	PRINTL 촉수삽입
	TSTR:0 = 촉수삽입
	SELECTCOM = 161
ELSE
	PRINTL 바이브
	TSTR:0 = 바이브
ENDIF
;CALL KOJO_MESSAGE_COM

;V経験を伴うコマンドのフラグ(処女膜再生対応)
TFLAG:19 = 1

;着脱の処理
IF TEQUIP:13 == 0
	TEQUIP:13 = 1
	;触手挿入は触手の汚れを追加
	IF TEQUIP:25
		CALL SET_STAIN("바기나", "粘液", TARGET)
	ENDIF
ELSE
	TEQUIP:13 = 0
ENDIF

;調教者→調教対象
TFLAG:28 = 2
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 30
DOWNBASE:TARGET:기력 += 100

SOURCE:TARGET:도구쾌Ｖ = 250
SOURCE:TARGET:아픔 = 50
SOURCE:TARGET:노출 = 20
SOURCE:TARGET:일탈 = 40
SOURCE:TARGET:반감 = 40


;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 40

;処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:처녀 == 1
	SOURCE:TARGET:아픔 += 2000
	SOURCE:TARGET:반감 += 3000
ENDIF

;再生処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:재생처녀 == 1
	SOURCE:TARGET:아픔 += 500
	SOURCE:TARGET:반감 += 1000
ENDIF

;Vへの苦痛は先に処理しておく
;EXP:Ｖ経験をみる（処女の反感は別途処理済みなので省略）
IF EXP:Ｖ경험 < EXPLV:1
	TIMES SOURCE:TARGET:아픔 , 2.50
ELSEIF EXP:Ｖ경험 < EXPLV:2
	TIMES SOURCE:TARGET:아픔 , 0.80
	TIMES SOURCE:TARGET:반감 , 1.20
ELSEIF EXP:Ｖ경험 < EXPLV:3
	TIMES SOURCE:TARGET:아픔 , 0.40
ELSEIF EXP:Ｖ경험 < EXPLV:4
	TIMES SOURCE:TARGET:아픔 , 0.10
ELSEIF EXP:Ｖ경험 < EXPLV:5
	TIMES SOURCE:TARGET:아픔 , 0.00
ELSEIF EXP:Ｖ경험 >= EXPLV:5
	TIMES SOURCE:TARGET:아픔 , 0.00
ENDIF

;PALAM:潤滑をみる
IF PALAM:윤활 < PALAMLV:1
	TIMES SOURCE:TARGET:아픔 , 1.20
	TIMES SOURCE:TARGET:반감 , 1.50
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES SOURCE:TARGET:아픔 , 0.70
	TIMES SOURCE:TARGET:반감 , 1.20
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES SOURCE:TARGET:아픔 , 0.40
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES SOURCE:TARGET:아픔 , 0.10
ELSEIF PALAM:윤활 >= PALAMLV:4
	TIMES SOURCE:TARGET:아픔 , 0.10
ENDIF


;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;触手挿入なら、触手体液が膣内に付く
SIF TEQUIP:25
	CALL SET_STAIN("질내", "粘液", TARGET)

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;V経験
CALL ADDS_EXP("Ｖ경험", 1, TARGET)

;이상경험
IF TALENT:처녀 == 1 && TEQUIP:25 == 1
;	EXP:50 += 2
;	PRINTFORML %EXPNAME:50%＋２
	CALL ADDS_ABNORMAL_EXP("処女喪失（触手）", TARGET)
ELSEIF TALENT:처녀 == 1
;	EXP:50 += 1
;	PRINTFORML %EXPNAME:50%＋１
	CALL ADDS_ABNORMAL_EXP("処女喪失（バイブ）", TARGET)
ENDIF

;레즈경험
A = 1
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;触手召喚時、触手経験のリセットをする
;SIF TEQUIP:25 == 1
;	T = 0

;依存度ベクトル
TFLAG:33 = 1


RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM44
;バイブ挿入中

;V経験を伴うコマンドのフラグ(処女膜再生対応)
TFLAG:19 = 1

IF TEQUIP:25
	PRINTL ＜촉수삽입 중＞
ELSE
	PRINTL ＜바이브 삽입 중＞
ENDIF

DOWNBASE:TARGET:체력 += 10
DOWNBASE:TARGET:기력 += 50

SOURCE:TARGET:도구쾌Ｖ += 125
SOURCE:TARGET:노출 += 10
SOURCE:TARGET:일탈 += 20

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 20

;Vへの苦痛は先に処理しておく
;EXP:Ｖ経験をみる（処女はありえない）
A = 25
B = 20
IF EXP:Ｖ경험 < EXPLV:2
	TIMES A , 0.80
	TIMES B , 1.20
ELSEIF EXP:Ｖ경험 < EXPLV:3
	TIMES A , 0.40
ELSEIF EXP:Ｖ경험 < EXPLV:4
	TIMES A , 0.10
ELSEIF EXP:Ｖ경험 < EXPLV:5
	TIMES A , 0.00
ELSEIF EXP:Ｖ경험 >= EXPLV:5
	TIMES A , 0.00
ENDIF

;PALAM:潤滑をみる
IF PALAM:윤활 < PALAMLV:1
	TIMES A , 1.20
	TIMES B , 1.50
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES A , 0.70
	TIMES B , 1.20
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES A , 0.40
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES A , 0.10
ELSEIF PALAM:윤활 >= PALAMLV:4
	TIMES A , 0.10
ENDIF
SOURCE:TARGET:아픔 += A
SOURCE:TARGET:반감 += B

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;自慰実行時は経験＋１
IF SELECTCOM == 11
	CALL ADDS_EXP("Ｖ경험", 2, TARGET)
ELSE
	CALL ADDS_EXP("Ｖ경험", 1, TARGET)
ENDIF

;触手経験加算
SIF TEQUIP:25 == 1
	CALL ADDS_EXP("촉수경험", 1, TARGET)
;	T += 1


RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_44
RETURN COMTYPE("道具系")


