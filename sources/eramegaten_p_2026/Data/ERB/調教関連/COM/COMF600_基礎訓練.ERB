;-------------------------------------------------
;기초훈련
;体力づくりとか戦闘訓練とか座学とか
;訓練経験100積んだ後に戦闘素質獲得コマンドを選ぶ流れ
;-------------------------------------------------
@ACT_COM600

PRINTL 기초훈련
TSTR:0 = 기초훈련
;CALL KOJO_MESSAGE_COM

;調教者→調教対象
TFLAG:28 = 2

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 10
DOWNBASE:TARGET:기력 += 50

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;野外だと効率よく訓練できる
IF TEQUIP:29
	CALL ADDS_EXP("훈련경험", 7, TARGET)
ELSE
	CALL ADDS_EXP("훈련경험", 1, TARGET)
ENDIF

;依存度ベクトル
TFLAG:33 = 2

RETURN 1

;===================================================
;調教タイプ
