;-------------------------------------------------
;가슴맞대기
;助手によるコマンド、及びレズプレイ、レベル1
;-------------------------------------------------
@ACT_COM126
PRINTL 가슴맞대기
TSTR:0 = 가슴맞대기
;CALL KOJO_MESSAGE_COM

;-------------------------------------------------
;絶頂ゲージチェック（ふたなりの場合）
;-------------------------------------------------
B = 1000

;ABL:調教者の技巧をみる
IF ABL:기교 == 0
	TIMES B , 1.00
ELSEIF ABL:기교 == 1
	TIMES B , 1.20
ELSEIF ABL:기교 == 2
	TIMES B , 1.40
ELSEIF ABL:기교 == 3
	TIMES B , 1.60
ELSEIF ABL:기교 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.00
ENDIF

;ABL:従順をみる
IF ABL:순종 == 0
	TIMES B , 0.80
ELSEIF ABL:순종 == 1
	TIMES B , 0.90
ELSEIF ABL:순종 == 2
	TIMES B , 1.00
ELSEIF ABL:순종 == 3
	TIMES B , 1.10
ELSEIF ABL:순종 == 4
	TIMES B , 1.20
ELSE
	TIMES B , 1.30
ENDIF

;ABL:奉仕精神をみる
IF ABL:봉사정신 == 0
	TIMES B , 0.50
ELSEIF ABL:봉사정신 == 1
	TIMES B , 0.80
ELSEIF ABL:봉사정신 == 2
	TIMES B , 1.20
ELSEIF ABL:봉사정신 == 3
	TIMES B , 1.50
ELSEIF ABL:봉사정신 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.40
ENDIF

;プレイヤーのABL:Ｂ感覚をみる
IF ABL:PLAYER:6 == 0
	TIMES B , 1.00
ELSEIF ABL:PLAYER:6 == 1
	TIMES B , 1.50
ELSEIF ABL:PLAYER:6 == 2
	TIMES B , 2.00
ELSEIF ABL:PLAYER:6 == 3
	TIMES B , 2.50
ELSEIF ABL:PLAYER:6 == 4
	TIMES B , 3.50
ELSE
	TIMES B , 5.00
ENDIF


;;再装填処理中は射精ゲージは20分の1に
;IF CFLAG:PLAYER:射精ゲージ再装填 > 0
;	B /= 20
;ENDIF

BASE:PLAYER:99 += B

;調教者←→調教対象
TFLAG:28 = 3
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 7
DOWNBASE:TARGET:기력 += 70

SOURCE:TARGET:쾌Ｂ = 200
SOURCE:TARGET:성행위 = 150
SOURCE:TARGET:노출 = 50
SOURCE:TARGET:불결 = 30
SOURCE:TARGET:일탈 = 100
SOURCE:TARGET:반감 = 200

;調教者にも同様の快Ｂ
SOURCE:PLAYER:쾌Ｂ = 200

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 100

;調教者が［幼児退行］
IF TALENT:PLAYER:150
	TIMES SOURCE:TARGET:쾌Ｂ , 1.20
	TIMES SOURCE:TARGET:성행위 , 1.20
ENDIF

;調教者が［유치］
IF TALENT:PLAYER:151
	TIMES SOURCE:TARGET:쾌Ｂ , 1.20
	TIMES SOURCE:TARGET:성행위 , 1.20
ENDIF

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＢ⇔調教者の指の汚れが移動
CALL MOVE_STAIN("가슴", TARGET, "손", PLAYER)
;奴隷の手⇔調教者のＢの汚れが移動
CALL MOVE_STAIN("손", TARGET, "가슴", PLAYER)
;奴隷の胸⇔調教者の胸の汚れが移動
CALL MOVE_STAIN("가슴", TARGET, "가슴", PLAYER)

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:3+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:3+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
A = 7
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;	PRINTFORML 봉사쾌락경험(調教者) + 1
	CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)
;依存度ベクトル
;P = PLAYER
IF GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:33 = 2
ELSEIF GET_RELATION(TARGET, PLAYER) < 100
	TFLAG:33 = 3
ELSE
	TFLAG:33 = 1
ENDIF

;依存度補正値(相性100↑かつ淫乱で2、娼婦で4）
;P = PLAYER
IF TALENT:음란 && GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:30 += 2
ELSEIF TALENT:창부 && GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:30 += 4
ENDIF

RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_126
RETURN COMTYPE("助手・レズ系")



