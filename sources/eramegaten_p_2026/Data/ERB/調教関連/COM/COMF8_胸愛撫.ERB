;-------------------------------------------------
;가슴애무
;愛撫系コマンド、レベル2
;-------------------------------------------------
@ACT_COM8
PRINTL 가슴애무
TSTR:0 = 가슴애무
;CALL KOJO_MESSAGE_COM

;調教者→調教対象
TFLAG:28 = 2
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 5
DOWNBASE:TARGET:기력 += 50

SOURCE:TARGET:쾌Ｂ = 100
SOURCE:TARGET:정애 = 50
SOURCE:TARGET:성행위 = 60
SOURCE:TARGET:노출 = 10
SOURCE:TARGET:불결 = 20
SOURCE:TARGET:반감 = 20


;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 20

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
IF TEQUIP:25
	;奴隷のＢに触手の汚れがつく
	CALL SET_STAIN("가슴", "破瓜の血", TARGET)
ELSE
	;奴隷の胸の汚れがなければ口をつかう（愛液と母乳よごれはＯＫ、汚れ無視か助手調教時は問題なし）
	;IF STAIN:TARGET:5 < 2 || STAIN:TARGET:5 == 16 || STAIN:TARGET:5 == 17 || ASSIPLAY == 1 || TALENT:MASTER:64 == 1
	IF !DIRTY("입", TARGET) && (ASSIPLAY || TALENT:MASTER:불결무시)
		;調教者のTALENT:舌使いをみる
		IF TALENT:PLAYER:혀놀림
			TIMES SOURCE:TARGET:일탈 , 1.40
			SOURCE:TARGET:울굴 += SOURCE:TARGET:일탈/20
		ENDIF
		;奴隷のＢ⇔調教者の口の汚れが移動
		CALL MOVE_STAIN("가슴", TARGET, "입", PLAYER)
	ENDIF
	;奴隷のＢ⇔調教者の指の汚れが移動
CALL MOVE_STAIN("가슴", TARGET, "손", PLAYER)
ENDIF

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:2+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:2+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
A = 5
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;依存度ベクトル
TFLAG:33 = 1


RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_8
RETURN COMTYPE("愛撫系")
