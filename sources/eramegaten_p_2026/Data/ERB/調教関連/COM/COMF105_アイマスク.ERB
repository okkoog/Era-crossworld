;-------------------------------------------------
;아이마스크
;SM系コマンド、レベル1
;-------------------------------------------------
@COMNAME105
RESULTS = 아이마스크
SIF TEQUIP:18
	RESULTS = 아이마스크 해제
@ACT_COM105
PRINTL 아이마스크
TSTR:0 = 아이마스크
;CALL KOJO_MESSAGE_COM

;着脱の処理
IF TEQUIP:18 == 0
	TEQUIP:18 = 1
ELSE
	TEQUIP:18 = 0
ENDIF

;調教者→調教対象
TFLAG:28 = 2
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 0
DOWNBASE:TARGET:기력 += 80

SOURCE:TARGET:무서움 = 700
SOURCE:TARGET:노출 = 100
SOURCE:TARGET:일탈 = 300
SOURCE:TARGET:반감 = 600

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;緊縛経験が高いと消費減少
IF EXP:51 < EXPLV:3
	TIMES DOWNBASE:TARGET:기력 , 1.00
ELSEIF EXP:51 < EXPLV:4
	TIMES DOWNBASE:TARGET:기력 , 0.90
ELSE
	TIMES DOWNBASE:TARGET:기력 , 0.70
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL ADDS_EXP("긴박경험", 2, TARGET)
;PRINTL 긴박경험＋２

A = 1
IF IS_LESBIAN(TARGET,PLAYER)
	PRINTFORML %EXPNAME:40%+{A}
	CALL ADDS_EXP("레즈경험", A, TARGET)
ELSEIF IS_GAY(TARGET,PLAYER)
	PRINTFORML %EXPNAME:41%+{A}
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
ENDIF

;依存度ベクトル
TFLAG:33 = 3

;依存度補正値(服従で1、隷属で2）
IF TALENT:복종 && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF TALENT:예속 && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF


RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM105
PRINTL ＜아이마스크 장착 중＞

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
DOWNBASE:TARGET:체력 += 0
DOWNBASE:TARGET:기력 += 40

SOURCE:TARGET:무서움 += 350
SOURCE:TARGET:노출 += 50
SOURCE:TARGET:일탈 += 150
SOURCE:TARGET:반감 += 300

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;緊縛経験が高いと消費減少
A = 40
IF EXP:51 < EXPLV:3
	TIMES A , 1.00
ELSEIF EXP:51 < EXPLV:4
	TIMES A , 0.90
ELSE
	TIMES A , 0.70
ENDIF
DOWNBASE:TARGET:기력 += A

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL ADDS_EXP("긴박경험", 1, TARGET)
;PRINTL 긴박경험＋１

RETURN 1

;===================================================
;調教タイプ
;===================================================
@COMTYPE_105
RETURN COMTYPE("ＳＭ系")


