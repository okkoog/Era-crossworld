;-------------------------------------------------
;더블펠라
;助手によるコマンド、及びレズプレイ、レベル2
;-------------------------------------------------
@ACT_COM124
PRINTL 더블펠라
;-------------------------------------------------
;実行決定
;-------------------------------------------------
TSTR:0 = 더블펠라
;CALL KOJO_MESSAGE_COM

;実行者が奴隷であるフラグ
TFLAG:28 = 1

;-------------------------------------------------
;射精ゲージチェック
;-------------------------------------------------
B = 1500

;ABL:調教者の技巧をみる
IF ABL:기교 == 0
	TIMES B , 1.00
ELSEIF ABL:기교 == 1
	TIMES B , 1.20
ELSEIF ABL:기교 == 2
	TIMES B , 1.40
ELSEIF ABL:기교 == 3
	TIMES B , 1.60
ELSEIF ABL:기교 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.00
ENDIF

;ABL:従順をみる
IF ABL:순종 == 0
	TIMES B , 0.80
ELSEIF ABL:순종 == 1
	TIMES B , 0.90
ELSEIF ABL:순종 == 2
	TIMES B , 1.00
ELSEIF ABL:순종 == 3
	TIMES B , 1.10
ELSEIF ABL:순종 == 4
	TIMES B , 1.20
ELSE
	TIMES B , 1.30
ENDIF

;ABL:奉仕精神をみる
IF ABL:봉사정신 == 0
	TIMES B , 0.50
ELSEIF ABL:봉사정신 == 1
	TIMES B , 0.80
ELSEIF ABL:봉사정신 == 2
	TIMES B , 1.20
ELSEIF ABL:봉사정신 == 3
	TIMES B , 1.50
ELSEIF ABL:봉사정신 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.40
ENDIF

;TALENT:舌使い、猫舌をみる
SIF TALENT:52 || TALENT:54
	TIMES B , 2.00

;助手のABL:技巧をみる
IF ABL:ASSI:2 >= 2
	TIMES B , 1.00
ELSEIF ABL:ASSI:2 == 3
	TIMES B , 1.20
ELSEIF ABL:ASSI:2 == 4
	TIMES B , 1.50
ELSE
	TIMES B , 1.80
ENDIF

;助手のTALENT:舌使い、猫舌をみる
SIF TALENT:ASSI:52 || TALENT:54
	TIMES B , 2.00

;プレイヤーのABL:Ｃ感覚をみる
IF ABL:MASTER:3 == 0
	TIMES B , 1.00
ELSEIF ABL:MASTER:3 == 1
	TIMES B , 1.50
ELSEIF ABL:MASTER:3 == 2
	TIMES B , 2.00
ELSEIF ABL:MASTER:3 == 3
	TIMES B , 2.50
ELSEIF ABL:MASTER:3 == 4
	TIMES B , 3.50
ELSE
	TIMES B , 5.00
ENDIF


SIF HAVE_PENIS(MASTER)
	BASE:MASTER:2 += B

;調教者←調教対象
TFLAG:28 = 1
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 10
DOWNBASE:TARGET:기력 += 100

SOURCE:TARGET:정애 = 100
SOURCE:TARGET:성행위 = 400
SOURCE:TARGET:달성 = 200
SOURCE:TARGET:굴종 = 600
SOURCE:TARGET:일탈 = 200
SOURCE:TARGET:반감 = 200

;上のほうで計算した汚れデータ
SOURCE:TARGET:불결 = Y*40 + 100

;調教者に快Ｃ
SOURCE:PLAYER:쾌Ｃ = 200
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 400

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
;射精先タイプの設定
TCVAR:MASTER:페니스사용대상 = TARGET + (ASSI+1)*10000
TCVAR:MASTER:사정부위 = 4
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 1

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷の口⇔調教者のＰの汚れが移動
CALL MOVE_STAIN("입", TARGET, "페니스", PLAYER)
;助手の口⇔調教者のＰの汚れが移動
CALL MOVE_STAIN("입", ASSI, "페니스", PLAYER)
;奴隷の口⇔助手の口の汚れが移動
CALL MOVE_STAIN("입", TARGET, "입", ASSI)

;奉仕精神ＬＶ２以上、技巧ＬＶ２以上なら汚れをなめ取る（ボールギャグ使用時は除く）
IF ABL:봉사정신 >= 2 && ABL:기교 >= 2 && TEQUIP:20 == 0
	TFLAG:청소펠라발생 = (4 | 512)
	TFLAG:8 = 2
ENDIF

;奴隷と助手が共に女性でどちらかが精液中毒を持っているとき、奴隷の口⇔助手の口の汚れが移動
;旧処理の時点で、奴隷の口から調教者のペニスに移動した汚れが、助手の口とふれることで、半分移動してしまっていたので
;無条件で移動するようにしてしまう
IF IS_LESBIAN(TARGET,ASSI) && (ABL:정액중독 >= 1 || ABL:ASSI:16 >= 1)
;	STAIN:TARGET:0 |= STAIN:ASSI:2
;	STAIN:ASSI:0 |= STAIN:TARGET:0
		TFLAG:8 = 3
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;PRINTFORML %EXPNAME:22%＋１
CALL ADDS_EXP("펠라경험", 1, TARGET)


A = 7

;マスターと奴隷のレズ
IF IS_LESBIAN(TARGET,MASTER)
;	PRINTFORML %EXPNAME:40%+{A}
;	PRINTFORML %EXPNAME:40%(主人)+{A}
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, MASTER)
ELSEIF IS_GAY(TARGET,MASTER)
;	PRINTFORML %EXPNAME:41%+{A}
;	PRINTFORML %EXPNAME:41%(主人)+{A}
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, MASTER)
ENDIF


;助手と奴隷のレズ
IF IS_LESBIAN(TARGET,ASSI)
	PRINTFORML %EXPNAME:40%+{A}
	PRINTFORML %EXPNAME:40%(조수)+{A}
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, ASSI)
ELSEIF IS_GAY(TARGET,ASSI)
	PRINTFORML %EXPNAME:41%+{A}
	PRINTFORML %EXPNAME:41%(조수)+{A}
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, ASSI)
ENDIF

;奴隷が猫舌持ちの場合は、調教者に嗜虐快楽経験を追加
IF TALENT:TARGET:54
	CALL ADDS_EXP("가학쾌락경험", 1, TARGET)
;	PRINTFORML %EXPNAME:32%＋１
ENDIF

;依存度ベクトル
;P = PLAYER
IF GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:33 = 2
ELSEIF GET_RELATION(TARGET, PLAYER) < 100
	TFLAG:33 = 3
ELSE
	TFLAG:33 = 1
ENDIF

;依存度補正値(相性100↑かつ淫乱で2、娼婦で4）
;P = PLAYER
IF TALENT:음란 && GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:30 += 2
ELSEIF TALENT:창부 && GET_RELATION(TARGET, PLAYER) > 100
	TFLAG:30 += 4
ENDIF


TFLAG:100 = 1


RETURN 1
;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
@COM_ORDER_124, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "욕망", 1, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "봉사정신", 4, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "정액중독", 3, ARG, ARG:1
CALL ADD_COM_ORDER, "MARK", "쾌락각인", 1, ARG, ARG:1
CALL ADD_COM_ORDER, "PALAM", "욕정", 1, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "부끄럼쟁이", -1, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "악취둔감", 1, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "악취민감", -3, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "헌신적", 6, ARG, ARG:1
SIF !TALENT:ARG:음란 && !TALENT:ARG:창부
	CALL ADD_COM_ORDER, "TALENT", "쾌감을부정", -1, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "음란", 5, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "창부", 10, ARG, ARG:1


;男嫌い（恋慕、親愛で無効）
SIF HATE(ARG, ARG:1)
	CALL ADD_COM_ORDER, "TALENT", \@IS_MALE(PLAYER) ? 남성혐오 # 여성혐오 \@, -12, ARG, ARG:1
;調教者がふたなり
CALL ADD_COM_ORDER, "TALENT", "후타나리", 8, ARG:1, ARG

CALL ADD_COM_ORDER, "STAIN", "페니스", 100, ARG, ARG:1

CALL ADD_COM_ORDER, "RELATION", , , ARG, ARG:1
CALL ADD_COM_ORDER, "RELATION", , , ARG, SUBPLAYER()

;-------------------------------------------------
;実行値
;-------------------------------------------------
@COM_ORDER_NUM_124
RETURN 34

;===================================================
;調教タイプ
;===================================================
@COMTYPE_124
RETURN COMTYPE("助手・レズ系")



