									TALENT:RESULT:페니스사이즈 = 2
								;短小(2)→並根(3)
								ELSEIF TALENT:RESULT:페니스사이즈 == 2
									PRINTFORMW ＜%CALLNAME:RESULT%의 페니스가 보통으로 커졌다＞
									TALENT:RESULT:페니스사이즈 = 3
								;巨根(4)→馬並
								ELSEIF TALENT:RESULT:페니스사이즈 == 4
									;小柄体型、小人体型
									IF TALENT:RESULT:유아체형 || TALENT:RESULT:소인체형
										PRINTFORMW ＜%CALLNAME:RESULT%의 페니스가 몸에 어울리지 않을 정도로 커졌다＞
									;それ以外
									ELSE
										PRINTFORMW ＜%CALLNAME:RESULT%의 페니스가 괄목할 만한 크기가 되었다＞
									ENDIF
									TALENT:RESULT:페니스사이즈 = 5
								;並根(3)→巨根(4) または 普通(0)→巨根(4)
								ELSE
									PRINTFORMW ＜%CALLNAME:RESULT%의 페니스가 커졌다＞
									TALENT:RESULT:페니스사이즈 = 4
								ENDIF
							CFLAG:RESULT:스트레스치 += 2
						CASE "축근제"
								;馬並(5)→巨根(4)
								IF TALENT:RESULT:페니스사이즈 == 5
									PRINTFORMW ＜%CALLNAME:RESULT%의 너무 큰 페니스가 한 단계 작아졌다＞
									TALENT:RESULT:페니스사이즈 = 4
								;巨根(4)→並根(3)
								ELSEIF TALENT:RESULT:페니스사이즈 == 4
									PRINTFORMW ＜%CALLNAME:RESULT%의 페니스가 남들만큼 작아졌다＞
									TALENT:RESULT:페니스사이즈 = 3
								;短小(2)→粗チン(1)
								ELSEIF TALENT:RESULT:페니스사이즈 == 2
									PRINTFORMW ＜%CALLNAME:RESULT%의 페니스가 극단적으로 작아졌다＞
									TALENT:RESULT:페니스사이즈 = 1
								;並根(3)→短小(2) または 普通(0)→短小(2)
								ELSE
									PRINTFORMW ＜%CALLNAME:RESULT%의 페니스가 작아졌다＞
									TALENT:RESULT:페니스사이즈 = 2
								ENDIF
							CFLAG:RESULT:스트레스치 += 2
						CASE "광근제"
								;無灯(0)→点灯(1)
								IF TALENT:RESULT:페니스발광도 == 0
									PRINTFORMW ＜%CALLNAME:RESULT%의 페니스가 빛나게 되었다＞
									TALENT:RESULT:페니스발광도 = 1
								;点灯(1)→ゲーミング(2)
								ELSEIF TALENT:RESULT:페니스발광도 == 1
									PRINTFORMW ＜%CALLNAME:RESULT%의 페니스가 칠색으로 빛나게 되었다＞
									TALENT:RESULT:페니스발광도 = 2
								;ゲーミング(2)→無灯(0)
								ELSE
									PRINTFORMW ＜%CALLNAME:RESULT%의 페니스는 빛나지 않게 되었다＞
									TALENT:RESULT:페니스발광도 = 0
								ENDIF
							CFLAG:RESULT:스트레스치 += 5
						CASE "우치데・해머"
							;体格素質を念のため削除
							TALENT:RESULT:거체 = 0
							TALENT:RESULT:큰체형 = 0
							TALENT:RESULT:유아체형 = 0
							;小人体型だった場合、小柄体型になる（あとは他の薬で大きくしてください）
							IF TALENT:RESULT:소인체형 == 0
								PRINTFORMW ＜%조사처리(CALLNAME:RESULT,"는")% 인형과 같은 사이즈가 되었다＞
								TALENT:RESULT:소인체형 = 1
							ELSE
								PRINTFORMW ＜%조사처리(CALLNAME:RESULT,"가")% 가 부쩍 커졌다（아직 작다）＞
								TALENT:RESULT:소인체형 = 0
								TALENT:RESULT:유아체형 = 1
							ENDIF
							CFLAG:RESULT:스트레스치 += 5
						CASE "쾌락근의비약"
							;1=マジカルチンポ 2=やわらかチンポ 3=やさしさチンポ になる
							LOCAL:1 = RESULT
							$INPUT_KAIRAKUKON
							PRINTL 이하 중 하나의 페니스로 만들 수 있습니다. 어떻게 하겠습니까?
							PRINTL [1] 매지컬 자지
							PRINTL [2] 부드러운 자지
							PRINTL [3] 다정한 자지
							PRINTL [0] 그만둔다
							INPUT
							PRINTFORML
							IF RESULT == 0
								RESTART
							ELSEIF RESULT == 1
								TALENT:(LOCAL:1):페니스타입 = 1
							ELSEIF RESULT == 2
								TALENT:(LOCAL:1):페니스타입 = 2
							ELSEIF RESULT == 3
								TALENT:(LOCAL:1):페니스타입 = 3
							ELSE
								GOTO INPUT_KAIRAKUKON
							ENDIF
							
							SIF (LOCAL:1) == MASTER
								PRINTFORM %MASTER는% 
							PRINTFORM 〔쾌락근의비약〕
							IF (LOCAL:1) == MASTER
								PRINTL 을 복용했다……
							ELSE
								PRINTFORM 을 %CALLNAME:(LOCAL:1)%에게\@(ABL:(LOCAL:1):순종 < 3) ? 억지로  # \@먹였다……
							ENDIF
							WAIT
							PRINTFORM %CALLNAME:(LOCAL:1)%의 페니스는 
							IF TALENT:(LOCAL:1):페니스타입 == 1
								PRINT 신비롭게도 
							ELSEIF TALENT:(LOCAL:1):페니스타입 == 2
								PRINT 부드럽고 
							ELSEIF TALENT:(LOCAL:1):페니스타입 == 3
								PRINT 상대를 배려하며 
							ENDIF
							PRINTFORMW 고통을 주지 않고 기분 좋은 섹스를 할 수 있게 되었다.
						CASE "고문근의비약"
							;-1=イボチンポ -2=トゲチンポ -3=真珠チンポ -4=マーラチンポ になる
							LOCAL:1 = RESULT
							$INPUT_GOUMONKON
							PRINTL 이하 중 하나의 페니스로 만들 수 있습니다. 어떻게 하겠습니까?
							PRINTL [1] 사마귀 자지
							PRINTL [2] 가시 자지
							PRINTL [3] 진주 자지
							PRINTL [4] 마라 자지
							PRINTL [0] 그만둔다
							INPUT
							PRINTFORML
							IF RESULT == 0
								RESTART
							ELSEIF RESULT == 1
								TALENT:(LOCAL:1):페니스타입 = -1
							ELSEIF RESULT == 2
								TALENT:(LOCAL:1):페니스타입 = -2
							ELSEIF RESULT == 3
								TALENT:(LOCAL:1):페니스타입 = -3
							ELSEIF RESULT == 4
								TALENT:(LOCAL:1):페니스타입 = -4
							ELSE
								GOTO INPUT_GOUMONKON
							ENDIF
							
							SIF (LOCAL:1) == MASTER
								PRINTFORM %MASTER는% 
							PRINTFORM 〔고문근의비약〕
							IF (LOCAL:1) == MASTER
								PRINTL 을 복용했다……
							ELSE
								PRINTFORM 을 %CALLNAME:(LOCAL:1)%에게\@(ABL:(LOCAL:1):순종 < 3) ? 억지로  # \@먹였다……
							ENDIF
							WAIT
							PRINTFORM %CALLNAME:(LOCAL:1)%의 페니스는 
							IF TALENT:(LOCAL:1):페니스타입 == -1
								PRINT 사마귀 모양 돌기가 돋아나 
							ELSEIF TALENT:(LOCAL:1):페니스타입 == -2
								PRINT 가시 모양 돌기가 돋아나 
							ELSEIF TALENT:(LOCAL:1):페니스타입 == -3
								PRINT 단단한 진주가 박혀 
							ELSEIF TALENT:(LOCAL:1):페니스타입 == -4
								PRINT 위풍당당하여 
							ENDIF
							PRINTFORMW 강한 고통을 주는 섹스를 할 수 있게 되었다.
						CASE "통상근의비약"
							TALENT:RESULT:페니스타입 = 0
							SIF RESULT == MASTER
								PRINTFORM %MASTER는% 
							PRINTFORM 〔통상근의비약〕
							IF RESULT == MASTER
								PRINTL 을 복용했다……
							ELSE
								PRINTFORM 을 %CALLNAME:RESULT%에게\@(ABL:RESULT:순종 < 3) ? 억지로  # \@먹였다……
							ENDIF
							WAIT
							PRINTFORM %CALLNAME:RESULT%의 페니스는 
							PRINTFORMW 남들과 다름없는 평범한 것이 되었다.
					ENDSELECT
					;忠誠度による崩壊防止措置を追加
					;崩壊防止措置
					IF CFLAG:RESULT:스트레스치 >= 100 && TALENT:RESULT:붕괴 == 0 && RESULT != MASTER
						IF 陥落(RESULT)
							IF (CFLAG:RESULT:스트레스치 -99) * 100 <= GET_CHARA_LOYALTY(RESULT)
								PRINTFORMW %조사처리(CALLNAME:RESULT,"는")% 심한 스트레스를 느끼고 있는 것 같다……
								PRINTFORMW %CALLNAME:RESULT%의 충성도가 {(CFLAG:RESULT:스트레스치 -99) * 100}감소했다
								CALL CONTROL_LOYALTY, RESULT, -(CFLAG:RESULT:스트레스치 -99) * 100
								CFLAG:RESULT:스트레스치 = 99
							ENDIF
						ELSE
							IF (CFLAG:RESULT:스트레스치 -99) * 500 <= GET_CHARA_LOYALTY(RESULT)
								PRINTFORMW %조사처리(CALLNAME:RESULT,"는")% 심한 스트레스를 느끼고 있는 것 같다……
								PRINTFORMW %CALLNAME:RESULT%의 충성도가 {(CFLAG:RESULT:스트레스치 -99) * 500}감소했다
								CALL CONTROL_LOYALTY, RESULT, -(CFLAG:RESULT:스트레스치 -99) * 500
								CFLAG:RESULT:스트레스치 = 99
							ENDIF
						ENDIF
					ENDIF
					SIF CFLAG:RESULT:스트레스치 >= 100 && TALENT:RESULT:붕괴 == 0 && RESULT != MASTER
						CALL COLLAPSE_MIND_ITEM, RESULT
					MONEY -= ITEMPRICE:LOCAL
					SIF MONEY >= ITEMPRICE:LOCAL
						GOTO USE_DRUG
					PRINTW ＜돈이 부족해졌습니다＞
			ENDSELECT
		ENDIF
ENDSELECT
