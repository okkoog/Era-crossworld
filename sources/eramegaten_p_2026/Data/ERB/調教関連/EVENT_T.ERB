@EVENTTRAIN_INIT
#DIM LCOUNT
#DIM L_CHARA

PLAYER:0 = MASTER
ASSIPLAY:0 = 0

;変動値記録用変数初期化
VARSET BASE変動値:0:0 , 0
VARSET PALAM変動値:0:0 , 0
VARSET PLV上昇済み:0:0 , 0
VARSET 絶頂変動値:0:0 , 0

;射精・母乳・尿意（触手射精）・絶頂をリセット
VARI L_CHARA
VARI L_SET , 3
L_SET:0 = TARGET , MASTER , ASSI
FOR LCOUNT , 0 , 2+(ASSI > -1)
	L_CHARA = L_SET:LCOUNT

	CALL INIT_BASE_FOR_TRAIN, L_CHARA

	;汚れリセット
	RESET_STAIN L_CHARA

	;BEGINで初期化していた物全てを初期化
	VARSET CUP:L_CHARA:0 , 0
	VARSET CDOWN:L_CHARA:0 , 0
	VARSET DOWNBASE:L_CHARA:0 , 0
	VARSET TCVAR:L_CHARA:0 , 0
	VARSET GOTJUEL:L_CHARA:0 , 0
	VARSET TEQUIP:L_CHARA:0 , 0
	VARSET EX:L_CHARA:0 , 0
	VARSET NOWEX:L_CHARA:0 , 0
	VARSET PALAM:L_CHARA:0 , 0
	VARSET SOURCE:L_CHARA:0 , 0
	
	;コンドーム射精フラグをリセット
	CFLAG:L_CHARA:사용후콘돔판정 = 0
NEXT

VARSET LOSEBASE , 0
VARSET UP , 0
VARSET DOWN , 0

;射精フラグ、処女喪失フラグなどをリセット
VARSET TFLAG, 0, 0, 200
;SELECTCOM・PREVCOM・INDICATE_COMの廃棄
VARSET SELECTCOM, -1
VARSET PREVCOM, -1
VARSET PREVPLAYER, -1
VARSET INDICATE_COM , -1
TFLAG:PLAYER일시보존 = -1

;コンドーム自動装着設定のリセット
FLAG:콘돔자동장착처리 = 0

;主導権を最初から握っているか
TEQUIP:MASTER:주도권 = 1
SIF ASSI >= 0
	TEQUIP:ASSI:주도권 = 1
IF CFLAG:TARGET:초기주도권 && ABL:TARGET:순종 < 3
	TEQUIP:TARGET:주도권 = 1
	TEQUIP:MASTER:주도권 = 0
	SIF ASSI >= 0
		TEQUIP:ASSI:주도권 = 0
ENDIF

;初調教時の処理
IF CFLAG:TARGET:피조교횟수 == 0
	;調教コマンド群を全開放
	FOR LCOUNT, 170, 186
		;現在フィルタとして設定されてない部分は触らない
		IF LCOUNT == 183 || LCOUNT == 184
			CONTINUE
		ENDIF
		;フィルタを全開放する
		CFLAG:TARGET:LCOUNT = 0
	NEXT
ENDIF

CFLAG:TARGET:피조교횟수 += 1
CFLAG:TARGET:최종훈련일 = DAY * 10 + TIME;EDIT 007 ADD

;EVENTTRAIN群を呼び出し

;CLOTHES.ERB中の調教時衣装イニシャライズへ
CALL EVENTTRAIN_CLOTHES
;EVENT_K.ERBの調教開始時口上呼び出し（＆口上セレクト設定）へ
CALL EVENTTRAIN_KOJO

;全口上が口上セレクト機能新仕様に変更されるまでの間
;変更を確認したら削除すること
CALL EVENTTRAIN_VERUP

;処理を調教後に移動
;戦闘参加不可能フラグの消去
;便利な関数が出来てたので早速利用
;NTRによる非戦闘員素質付与の悪用防止措置のため、NTRによる戦闘参加不可能フラグの場合は弾くように。
;IF !TALENT:TARGET:반역
;	SIF CFLAG:TARGET:매각가능 || 陥落(TARGET)
;		CALL SET_TALENT_PARTY_JOINABLE, TARGET, "参加可能"
;ENDIF

;---- EDIT 008 MOD START -------------------------
;調教コマンドリストのページ数を初期化
COMLIST_PAGE = 0
COMLIST_PAGE_MAX = 0
;---- EDIT 008 MOD END -------------------------

@INIT_BASE_FOR_TRAIN, L_CHARA
#DIM DYNAMIC L_CHARA
;射精セット
BASE:L_CHARA:사정 = 0
MAXBASE:L_CHARA:사정 = 10000*HAVE_PENIS(L_CHARA)
;絶頂セット
BASE:L_CHARA:절정 = 0
MAXBASE:L_CHARA:절정 = 10000

;絶倫時の処理
IF TALENT:L_CHARA:절륜 == 1
	TIMES MAXBASE:L_CHARA:사정 , 0.50
	TIMES MAXBASE:L_CHARA:절정 , 0.50
ENDIF

;母乳セット
BASE:L_CHARA:모유 = 0
MAXBASE:L_CHARA:모유 = 10000*TALENT:L_CHARA:모유체질/(1+TALENT:L_CHARA:음유)
;뇨의=触手ゲージセット
BASE:L_CHARA:뇨의 = 0
MAXBASE:L_CHARA:뇨의 = 10000*TALENT:L_CHARA:촉수사역술

@EVENTTURNEND
#DIM LCOUNT
IF ASSI > 0
	IF TALENT:ASSI:요호 && ITEM:미약 == 0
		PRINTW [요호]의 효과로 미약을 입수했습니다
		ITEM:미약 = 1
	ENDIF
ENDIF

FOR LCOUNT, 0, 100
	SIF ITEM:LCOUNT < 0
		ITEM:LCOUNT = 0
NEXT

RETURN 0

@ASSI_CHANGE
;[여우]かつ技巧LV5、Ｃ感覚LV5で処女
IF TALENT:ASSI:여우 && (ABL:ASSI:기교 >= 5 && ABL:ASSI:Ｃ감각 >= 5 && TALENT:ASSI:처녀)
	DRAWLINE
	PRINTFORML %조사처리(NAME:ASSI,"는")% [요호]가 되었다
	DRAWLINE
	WAIT
	TALENT:ASSI:여우 = 0
	TALENT:ASSI:요호 = 1
ENDIF

$INPUT_LOOP
;[이상한뿌리]かつＣ感覚LV5、精液中毒LV3以上
IF TALENT:ASSI:이상한뿌리 && (ABL:ASSI:Ｃ감각 >= 5 && ABL:ASSI:정액중독 >= 3) && TALENT:ASSI:후타나리 == 0 && !IS_MALE(ASSI)
	DRAWLINE
	PRINTFORML ……아무래도 [이상한뿌리]의 효과가 나타날 것 같다
	PRINTFORMW %ASSI를% [후타나리]로 만듭니까？
	PRINTL [0] - 한다
	PRINTL [1] - 하지 않는다
	INPUT
	IF RESULT == 0
		PRINTFORML %NAME:ASSI%의 [이상한뿌리]는 [후타나리]가 되었다
		TALENT:ASSI:후타나리 = 1
	ELSEIF RESULT == 1
		PRINTFORML %조사처리(NAME:ASSI,"는")% [이상한뿌리]를 잃었다
	ELSE
		GOTO INPUT_LOOP
	ENDIF
	DRAWLINE
	WAIT
	TALENT:ASSI:이상한뿌리 = 0
ENDIF

$INPUT_LOOP_2
;[구현]かつ欲望LV5かレズっ気LV4以上
IF TALENT:ASSI:구현 && (ABL:ASSI:욕망 >= 5 || ABL:ASSI:레즈끼 >= 4) && TALENT:ASSI:후타나리 == 0 && !IS_MALE(ASSI)
	DRAWLINE
	PRINTFORML ……아무래도 [구현]의 효과가 나타날 것 같다
	PRINTFORML %ASSI를% [후타나리]로 만듭니까？
	PRINTL [0] - 한다
	PRINTL [1] - 하지 않는다
	INPUT
	IF RESULT == 0
		PRINTFORML %조사처리(NAME:ASSI,"는")% [구현]에 의한 [후타나리]가 되었다
		TALENT:ASSI:후타나리 = 1
	ELSEIF RESULT == 1
		PRINTFORML %조사처리(NAME:ASSI,"는")% [구현]을 잃었다
	ELSE
		GOTO INPUT_LOOP_2
	ENDIF
	DRAWLINE
	WAIT
	TALENT:ASSI:구현 = 0
ENDIF

ISASSI:ASSI = 1

RETURN 0

@YOUJI
;調教者が幼稚
IF TALENT:PLAYER:유치
	PRINTFORMW %PLAYER가% 젖을 빠는 동안 %TARGET은% 모유가 나오게 되었다
	TALENT:모유체질 = 1
ENDIF


;調教で【붕괴】を得た場合のイベント
@COLLAPSE_MIND_TRAIN
;陥落持ちかどうかで必要忠誠度変化
IF 陥落(TARGET)
	IF (CFLAG:TARGET:스트레스치 -99) * 100 <= GET_CHARA_LOYALTY(TARGET)
		PRINTFORMW %CALLNAME은% 강한 스트레스를 느끼고 있는 것 같다……
		PRINTFORMW %CALLNAME%의 충성도가 {(CFLAG:TARGET:스트레스치 -99) * 100} 감소했다
		CALL CONTROL_LOYALTY, TARGET, -(CFLAG:TARGET:스트레스치 -99) * 100
		CFLAG:스트레스치 = 99
		RETURN 0
	ENDIF
ELSE
	IF (CFLAG:TARGET:스트레스치 -99) * 500 <= GET_CHARA_LOYALTY(TARGET)
		PRINTFORMW %CALLNAME은% 강한 스트레스를 느끼고 있는 것 같다……
		PRINTFORMW %CALLNAME%의 충성도가 {(CFLAG:TARGET:스트레스치 -99) * 500} 감소했다
		CALL CONTROL_LOYALTY, TARGET, -(CFLAG:TARGET:스트레스치 -99) * 500
		CFLAG:스트레스치 = 99
		RETURN 0
	ENDIF
ENDIF

PRINTFORMW %CALLNAME:TARGET%의 상태가 이상하다
PRINTFORMW 격렬한 조교의 영향으로、%CALLNAME:TARGET%의 정신에 이상이 생긴 것 같다
PRINTFORMW %조사처리(NAME:TARGET,"은")%【붕괴】해버렷다
TALENT:붕괴 = 1
IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
	PRINTFORM %TARGET은% [
	SIF TALENT:연모
		PRINT 연모
	SIF TALENT:음란
		PRINT 음란
	SIF TALENT:복종
		PRINT 복종
	SIF TALENT:친애
		PRINT 친애
	SIF TALENT:창부
		PRINT 창부
	SIF TALENT:예속
		PRINT 예속
	PRINTW ]을(를) 잃었다
	SIF TALENT:연모
		TALENT:연모 = 0
	SIF TALENT:음란
		TALENT:음란 = 0
	SIF TALENT:복종
		TALENT:복종 = 0
	SIF TALENT:친애
		TALENT:친애 = 0
	SIF TALENT:창부
		TALENT:창부 = 0
	SIF TALENT:예속
		TALENT:예속 = 0
ENDIF
CALL EVENT_CHANGE_TRAIN_TALENT, TARGET, "붕괴"

@EVENTEND_PERSONA
SIF TARGET > 0 && TALENT:TARGET:페르소나구사자
	CALL ISABLE_EVOLUTE_PERSONA, TARGET

@EVENTEND_TRAIN
PRINTL 조교를 종료했습니다

;調教したことがある
CALL SET_陥落履歴, NO:TARGET, "調教"

IF GET_VALUE_TALENT_JOINABLE(TARGET) == 1
	SETCOLOR 0xff0033
	PRINTFORMW 조교를 받은것으로 인해、%조사처리(NAME:TARGET,"은")%【신용】을 잃고、【반발】을 얻었다。
	PRINTFORMW %조사처리(NAME:TARGET,"은")% 전투에 참가시킬 수 없게 되었습니다
	CALL SET_TALENT_PARTY_JOINABLE, TARGET, "参加不可能"
	SIF CFLAG:포지션 > 0
		CALL REMOVE_POSITION,CFLAG:포지션
	RESETCOLOR
ENDIF
;修練中に戦闘参加不可能になった場合の修練中断処理
IF GET_VALUE_TALENT_JOINABLE(TARGET) == 0 && CFLAG:TARGET:노역플래그 == 6
	SETCOLOR 0xff0033
	PRINTFORMW 조교를 시작한 것으로 인해、%NAME:TARGET%의 수련을 중단시켰습니다
	CFLAG:TARGET:노역플래그 = 0
	RESETCOLOR
ENDIF
;非戦闘員が食堂で働いていて、労役の条件を満たさなくなったら労役解除
IF (ABL:TARGET:순종 + ABL:TARGET:봉사정신 + ABL:TARGET:요리기능 + TALENT:TARGET:연모*3 + TALENT:TARGET:친애*6) < 6 && TALENT:TARGET:비전투원 && CFLAG:TARGET:피조교횟수 && CFLAG:TARGET:노역플래그 == 1
	SETCOLOR 0xff0033
	PRINTFORMW 조교를 받은것으로 인해、%조사처리(NAME:TARGET,"은")% %NAME:MASTER%에의 신뢰를 잃고、노역하지 않게 되었습니다
	CFLAG:TARGET:노역플래그 = 0
	RESETCOLOR
ENDIF
;非戦闘員が戦闘員素質を持っていて、訓練経験を持っていれば非戦闘員が無くなる
IF TALENT:TARGET:비전투원 == 1 && EXP:TARGET:훈련경험 > 99 && (TALENT:TARGET:석세서 || TALENT:TARGET:데빌시프터 || TALENT:TARGET:이능자 || TALENT:TARGET:페르소나구사자 || TALENT:TARGET:도구지식 || TALENT:TARGET:아이템숙련 || TALENT:TARGET:건슬링거 || TALENT:TARGET:쿠즈노하 || TALENT:TARGET:식노 || TALENT:TARGET:달인)
	SETCOLOR 0x0099cc
	PRINTFORMW 충분한 전투경험을 쌓은것으로 인해、%조사처리(NAME:TARGET,"은")% 전투에 참가할 수 있게 되었다
	TALENT:TARGET:비전투원 = 0
	RESETCOLOR
	CALL CHECK_COMBATANTING,TARGET
ENDIF

;調教後行為のチェック
CALL SELF_CHECK

;搾乳した母乳の売却
CALL SELL_MILK

;調教時に録画したビデオを売却
CALL SELL_VIDEO

;調教時に撮影した写真を売却
CALL SELL_PICTURE

;何の珠を得られたか
CALL JUEL_CHECK

;否定の珠の打ち消しチェック
CALL DENIAL_CHECK

CALL CHANGE_ALI

;BEGIN ABLUP
;手動

;ストレス値の加算
CFLAG:TARGET:스트레스치 += 1
SIF MARK:TARGET:반발각인 > 2
	CFLAG:TARGET:스트레스치 += 1
;ストレス値100以上で崩壊を得る
SIF CFLAG:TARGET:스트레스치 >= 100 && TALENT:TARGET:붕괴 == 0
	CALL COLLAPSE_MIND_TRAIN

;--------------------------------------------------------
;調教の実行結果に関する@EVENTTURNEND群
;--------------------------------------------------------
@END_TRAIN_CHARASELL, L_CHARA
#DIM DYNAMIC L_CHARA
;売却や助手化が可能になったか
SIF L_CHARA < 0
	RETURN 0

SIF ABL:L_CHARA:순종+ABL:L_CHARA:욕망 < 6
	RETURN 0
SIF ABL:L_CHARA:순종 < 4 && ((TALENT:L_CHARA:반항적 && TALENT:L_CHARA:복종 == 0 && TALENT:L_CHARA:예속 == 0) || TALENT:L_CHARA:꿋꿋함)
	RETURN 0
SIF ABL:L_CHARA:욕망 < 4 && (TALENT:L_CHARA:자제심 || TALENT:L_CHARA:억압 || TALENT:L_CHARA:저항)
	RETURN 0
LOCAL = 0
SIF ABL:L_CHARA:기교 >= 2 && ABL:L_CHARA:봉사정신 >= 2
	LOCAL += 1
SIF ABL:L_CHARA:기교 >= 4 && ABL:L_CHARA:봉사정신 >= 4
	LOCAL += 1
SIF ABL:L_CHARA:노출증 >= 3 && ABL:L_CHARA:자위중독
	LOCAL += 1
SIF ABL:L_CHARA:마조끼 >= 3
	LOCAL += 1
SIF ABL:L_CHARA:Ｃ감각+ABL:L_CHARA:Ｖ감각+ABL:L_CHARA:Ａ감각+ABL:L_CHARA:Ｂ감각 >= 8
	LOCAL += 1
SIF ABL:L_CHARA:Ｃ감각+ABL:L_CHARA:Ｖ감각+ABL:L_CHARA:Ａ감각+ABL:L_CHARA:Ｂ감각 >= 13
	LOCAL += 1
SIF ABL:L_CHARA:순종 >= 4
	LOCAL += 1
SIF ABL:L_CHARA:욕망 >= 4
	LOCAL += 1
SIF ABL:L_CHARA:정액중독
	LOCAL += 1
SIF ABL:L_CHARA:수간중독
	LOCAL += 1
SIF ABL:L_CHARA:촉수중독
	LOCAL += 1
SIF ABL:L_CHARA:윤간중독
	LOCAL += 1
SIF ABL:L_CHARA:키스중독
	LOCAL += 1
SIF (ABL:L_CHARA:레즈끼 >= 3 && ABL:L_CHARA:레즈중독) || (ABL:L_CHARA:ＢＬ끼 >= 3 && ABL:L_CHARA:ＢＬ중독)
	LOCAL += 1
SIF ABL:L_CHARA:요리기능 >= 2 || ABL:L_CHARA:가창기능 >= 2
	LOCAL += 1
SIF MARK:L_CHARA:굴복각인 >= 3 && MARK:L_CHARA:쾌락각인 >= 3
	LOCAL += 1
SIF MARK:L_CHARA:굴복각인 >= 3 && MARK:L_CHARA:고통각인 >= 3
	LOCAL += 1

;IF GROUPMATCH(1,(ABL:L_CHARA:기교 >= 3 && ABL:L_CHARA:봉사정신 >= 3) , (ABL:L_CHARA:노출증 >= 3 && ABL:L_CHARA:자위중독) , ABL:L_CHARA:마조끼 >= 3 , ABL:L_CHARA:Ｃ감각+ABL:L_CHARA:4+ABL:L_CHARA:5+ABL:L_CHARA:6 >= 13 , ABL:L_CHARA:0 >= 5 , ABL:L_CHARA:1 >= 5) >= 2
IF LOCAL > MIN(6,CSVBASE(NO:L_CHARA,GETNUM(BASE,"LV"),0)/10 + (ABL:L_CHARA:종족 == 0))
	IF CFLAG:L_CHARA:매각가능 <= 0
		PRINTFORMW %조사처리(NAME:L_CHARA,"가")% 매각 가능해졌습니다
		CFLAG:L_CHARA:매각가능 = 1
	ENDIF
ELSE
	RETURN 0
ENDIF

IF ABL:L_CHARA:순종+ABL:L_CHARA:욕망+ABL:L_CHARA:기교+(IS_MALE(L_CHARA) ? ABL:L_CHARA:ＢＬ끼 # ABL:L_CHARA:레즈끼) >= 12 && !TALENT:L_CHARA:반역
	IF CFLAG:L_CHARA:매각가능 <= 1
		PRINTFORMW %조사처리(NAME:L_CHARA,"가")% 조수 가능해졌습니다
		CFLAG:L_CHARA:매각가능 = 2
	ENDIF
ENDIF

@JUEL_CHECK
#DIM LCOUNT

LOCAL = (EX:Ｃ절정 + EX:Ｖ절정 + EX:Ａ절정 + EX:Ｂ절정 + EX:분유 + EX:사정)*2
FOR LCOUNT, 0, 15
	IF PALAM:LCOUNT < PALAMLV:1
		G = 0
	ELSEIF PALAM:LCOUNT < PALAMLV:1*3
		G = 1
	ELSEIF PALAM:LCOUNT < PALAMLV:2
		G = 2
	ELSEIF PALAM:LCOUNT < PALAMLV:2*3
		G = 10
	ELSEIF PALAM:LCOUNT < PALAMLV:3
		G = 20
	ELSEIF PALAM:LCOUNT < PALAMLV:3*2
		G = 100
	ELSEIF PALAM:LCOUNT < PALAMLV:4
		G = 200
	ELSEIF PALAM:LCOUNT < PALAMLV:5
		G = 1000
	ELSEIF PALAM:LCOUNT < PALAMLV:6
		G = 2000
	ELSEIF PALAM:LCOUNT < PALAMLV:7
		G = 3000
	ELSEIF PALAM:LCOUNT < PALAMLV:8
		G = 5000
	ELSEIF PALAM:LCOUNT < PALAMLV:9
		G = 8000
	ELSEIF PALAM:LCOUNT < PALAMLV:10
		G = 12000
	ELSEIF PALAM:LCOUNT < PALAMLV:11
		G = 25000
	ELSEIF PALAM:LCOUNT < PALAMLV:12
		G = 40000
	ELSEIF PALAM:LCOUNT < PALAMLV:13
		G = 60000
	ELSEIF PALAM:LCOUNT < PALAMLV:14
		G = 100000
	ELSEIF PALAM:LCOUNT < PALAMLV:15
		G = 250000
	ELSEIF PALAM:LCOUNT < PALAMLV:16
		G = 500000
	ELSE
		G = 1000000
	ENDIF

	IF LCOUNT == 0
		GOTJUEL:LCOUNT = G + EX:Ｃ절정 * 1000
	ELSEIF LCOUNT == 1
		GOTJUEL:LCOUNT = G + EX:Ｖ절정 * 1000
	ELSEIF LCOUNT == 2
		GOTJUEL:LCOUNT = G + EX:Ａ절정 * 1000
	ELSEIF LCOUNT == 3
		GOTJUEL:LCOUNT = G + EX:Ｂ절정 * 1000
	ELSEIF LCOUNT < 12
		GOTJUEL:LCOUNT = G
		LOCAL += PALAMLV_F(TARGET,PALAMNAME:LCOUNT)*3
	ELSE
		GOTJUEL:부정 += G
	ENDIF
NEXT

