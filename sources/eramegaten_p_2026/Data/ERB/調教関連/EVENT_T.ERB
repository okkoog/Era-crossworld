	CFLAG:ARG:페르소나강화플래그 = 2
IF CFLAG:ARG:페르소나강화플래그 == 0 && 陥落(ARG) >= 1 && BASE:ARG:LV >= 30 && ABL:ARG:초기페르소나2
	CFLAG:ARG:페르소나강화플래그 = 1
	TFLAG:페르소나강화가능 = 2
