@口上セレクト設定
#DIM カウント , 1
#DIM リスト , 70
#LOCALSIZE 1
#LOCALSSIZE 1
VARSET リスト , -1
カウント = 0
FOR LOCAL , 0 , 70
	IF LOCAL < 50
		LOCALS = K{NO}
	ELSEIF LOCAL < 60
		LOCALS = PUB{ABL:회화타입}
	ELSE
		TRYCCALLFORM 特殊口上条件_SP{LOCAL - 60}
			SIF RESULT
				LOCALS = SP{LOCAL-60}
		CATCH
			CONTINUE
		ENDCATCH
	ENDIF
	SIF LOCAL % 50 != 0 && LOCAL < 60
		LOCALS += @"_{LOCAL%50}"
	TRYCCALLFORM セレクト口上説明_%LOCALS%, 1
		SIF RESULT == -1
			CONTINUE
		;[IF_DEBUG]
		;	PRINTFORML セレクト口上説明_%LOCALS%
		;[ENDIF]
		リスト:カウント = LOCAL
		カウント ++
	CATCH
	ENDCATCH
NEXT
;[IF_DEBUG]
;	PRINTFORML 口上は{カウント}個見つかりました
;	DRAWLINE
;[ENDIF]
IF カウント > 1 || MAXARRAY(リスト) >= 60
	DRAWLINE
	PRINTFORML 적용할 구상을 선택해주세요
	FOR LOCAL , 0 , カウント
		IF リスト:LOCAL < 50
			LOCALS = K{NO}
		ELSEIF リスト:LOCAL < 60
			LOCALS = PUB{ABL:회화타입}
		ELSE
			LOCALS = SP{リスト:LOCAL-60}
		ENDIF
		SIF リスト:LOCAL % 50 != 0 && リスト:LOCAL < 60
			LOCALS += @"_{リスト:LOCAL%50}"
		PRINTFORM [{リスト:LOCAL}]
		CALLFORM セレクト口上説明_%LOCALS%
		PRINTL 
		DRAWLINE
	NEXT
	PRINTL [99] 적용하지 않는다
	$INPUT_LOOP
	INPUT
	IF RESULT == 99
		CFLAG:구상셀렉트 = -1
	ELSEIF RESULT >= 0 && RESULT < 70 && MATCH(リスト , RESULT)
		CFLAG:구상셀렉트 = RESULT
	ELSE
		GOTO INPUT_LOOP
	ENDIF
ELSEIF カウント == 1
	CFLAG:구상셀렉트 = リスト:0
ELSE
	CFLAG:구상셀렉트 = 0
ENDIF

@口上呼び出し, ARGS , ARG = -1 , ARG:1 , ARG:2 , ARG:3, ARGS:1
#LOCALSSIZE 1
#DIM DYNAMIC STOCK_TARGET
#DIM DYNAMIC L_RESULT
STOCK_TARGET = TARGET
SIF ARG == -1
	ARG = TARGET
TARGET = ARG

LOCALS = %口上関数末尾文字(ARG)%
;人称の変数をセットする
CALL 人称定義, ARGS, ARG, ARG:1, ARG:2

;頭にKOJOがついているものは新仕様に対応した関数
IF ARGS == "BATTLE_EVENT" || ARGS == "ENEMY_BATTLE_EVENT"
	TRYCCALLFORM KOJO_%ARGS%%LOCALS% , ARG:1 , ARG:2 , ARG:3
		L_RESULT = 2
	CATCH
		TRYCCALLFORM %ARGS%%LOCALS% , ARG:1 , ARG:2 , ARG:3
			L_RESULT = 1
		CATCH
			;RPG口上はないがメイン口上があるという場合に汎用に落とさないようにする
			CALL 口上存在確認, ARG
			IF RESULT != 1
				TRYCCALLFORM KOJO_%ARGS%_PUB{ABL:ARG:회화타입} , ARG:1 , ARG:2 , ARG:3
					L_RESULT = 2
				CATCH
					TRYCCALLFORM %ARGS%_PUB{ABL:ARG:회화타입} , ARG:1 , ARG:2 , ARG:3
						L_RESULT = 1
					CATCH
						L_RESULT = 0
					ENDCATCH
				ENDCATCH
			ENDIF
		ENDCATCH
	ENDCATCH
ELSEIF ARGS == "KOJO_MESSAGE_RINKAN"
	TRYCCALLFORM %ARGS%%LOCALS%, ARG:1 , ARG:2
	CATCH
		TRYCCALLFORM %ARGS%_PUB{ABL:ARG:회화타입}, ARG:1 , ARG:2
		CATCH
			L_RESULT = 0
		ENDCATCH
	ENDCATCH
	L_RESULT = RESULT
;頭にKOJOがついているものは新仕様に対応した関数
ELSEIF ARGS == "BATTLE_MESSAGE" || ARGS == "BATTLE_BEFORE_ACT_MESSAGE"
	TRYCCALLFORM KOJO_%ARGS%%LOCALS% , ARG:1 , ARG:2
		L_RESULT = 2
	CATCH
		TRYCCALLFORM %ARGS%%LOCALS% , ARG:1 , ARG:2
			L_RESULT = 1
		CATCH
			;RPG口上はないがメイン口上があるという場合に汎用に落とさないようにする
			CALL 口上存在確認, ARG
			IF RESULT != 1
				TRYCCALLFORM KOJO_%ARGS%_PUB{ABL:ARG:회화타입} , ARG:1 , ARG:2
					L_RESULT = 2
				CATCH
					TRYCCALLFORM %ARGS%_PUB{ABL:ARG:회화타입} , ARG:1 , ARG:2
						L_RESULT = 1
					CATCH
						L_RESULT = 0
					ENDCATCH
				ENDCATCH
			ENDIF
		ENDCATCH
	ENDCATCH
ELSEIF ARGS == "KOJO_BATTLE_INPUT_COMMAND"
	TRYCCALLFORM %ARGS%%LOCALS%, ARG
		L_RESULT = 1
	CATCH
		;RPG口上はないがメイン口上があるという場合に汎用に落とさないようにする
		CALL 口上存在確認, ARG
		IF RESULT != 1
			TRYCCALLFORM %ARGS%_PUB{ABL:ARG:회화타입}, ARG
				L_RESULT = 1
			CATCH
				L_RESULT = 0
			ENDCATCH
		ENDIF
	ENDCATCH
ELSEIF ARGS == "ENEMY_BATTLE_MESSAGE" || ARGS == "ENEMY_BATTLE_BEFORE_ACT_MESSAGE"
	TRYCCALLFORM KOJO_%ARGS%%LOCALS%, ARG
		L_RESULT = 2
	CATCH
		TRYCCALLFORM %ARGS%%LOCALS%, ARG
			L_RESULT = 1
		CATCH
			L_RESULT = 0
		ENDCATCH
	ENDCATCH
ELSEIF ARGS == "DUNGEON_EVENT"
	TRYCCALLFORM %ARGS%_%ARGS:1%%LOCALS%
		L_RESULT = 1
	CATCH
		;RPG口上はないがメイン口上があるという場合に汎用に落とさないようにする
		CALL 口上存在確認, ARG
		IF RESULT != 1
			TRYCCALLFORM %ARGS%_%ARGS:1%_PUB{ABL:ARG:회화타입}
				L_RESULT = 1
			CATCH
				L_RESULT = 0
			ENDCATCH
		ENDIF
	ENDCATCH
ELSEIF ARGS == "存在"
	THROW 仕様変更に対応していない呼び出しが実施されてしまったのでエラー報告をお願いします。
;	CALL 口上存在確認, ARG
;	L_RESULT = RESULT
ELSEIF ARGS == "KOJO_BATTLE_NAVI"
	TRYCCALLFORM %ARGS%%LOCALS%
		L_RESULT = 1
	CATCH
		;ナビ口上はないがメイン口上があるという場合に汎用に落とさないようにする
		CALL 口上存在確認, ARG
		IF RESULT != 1
			CALL KOJO_BATTLE_NAVI_COMMON
			L_RESULT = 0
		ELSE
			TRYCCALLFORM %ARGS%_PUB{ABL:ARG:회화타입}
				L_RESULT = 1
			CATCH
				CALL KOJO_BATTLE_NAVI_COMMON
				L_RESULT = 0
			ENDCATCH
		ENDIF
	ENDCATCH
ELSEIF ARGS == "KOJO_MESSAGE_ENDING"
	TRYCCALLFORM %ARGS%%LOCALS%
		L_RESULT = RESULT
	CATCH
		TRYCCALLFORM %ARGS%_PUB{ABL:ARG:회화타입}
			L_RESULT = RESULT
		CATCH
			L_RESULT = 0
		ENDCATCH
	ENDCATCH
ELSE
	TRYCCALLFORM %ARGS%%LOCALS%
		L_RESULT = 1
	CATCH
		TRYCCALLFORM %ARGS%_PUB{ABL:ARG:회화타입}
			L_RESULT = 1
		CATCH
			L_RESULT = 0
		ENDCATCH
	ENDCATCH
ENDIF
TARGET = STOCK_TARGET
RETURN L_RESULT

@口上関数末尾文字 , ARG
#FUNCTIONS
#LOCALSSIZE 1
SIF ARG == -1
	ARG = TARGET
IF CFLAG:ARG:PT플래그 == 0
	IF CSTR:ARG:적구상명칭 != ""
		LOCALS = _%CSTR:ARG:적구상명칭%
	ELSE
		LOCALS = _K{NO:ARG}
	ENDIF
ELSEIF CFLAG:ARG:구상셀렉트 < 50
	LOCALS = _K{NO:ARG}
ELSEIF CFLAG:ARG:구상셀렉트 < 60
	LOCALS = _PUB{ABL:ARG:회화타입}
ELSE
	LOCALS = _SP{CFLAG:ARG:구상셀렉트 - 60}
ENDIF
SIF CFLAG:ARG:구상셀렉트 % 50 != 0 && CFLAG:ARG:구상셀렉트 < 60
	LOCALS += @"_{CFLAG:ARG:구상셀렉트%50}"
RETURNF LOCALS


@口上存在確認, ARG
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_RESULT
#DIM DYNAMIC STOCK_SELECTCOM
#DIM DYNAMIC STOCK_ASSI
#DIM DYNAMIC STOCK_TARGET
SIF ARG < 0
	RETURN 0
STOCK_SELECTCOM = SELECTCOM
STOCK_ASSI = ASSI
STOCK_TARGET = TARGET
SELECTCOM = 65535
ASSI = 0
TARGET = 0
SKIPDISP 1
FOR LCOUNT, 0, 10
	IF LCOUNT == 0
		TRYCCALLFORM KOJO_MESSAGE_COM_K{NO:ARG}
			L_RESULT = 1
			BREAK
		CATCH
		ENDCATCH
	ELSE
		TRYCCALLFORM KOJO_MESSAGE_COM_K{NO:ARG}_{LCOUNT}
			L_RESULT = 1
			BREAK
		CATCH
		ENDCATCH
	ENDIF
NEXT
IF L_RESULT == 0
	TRYCCALLFORM KOJO_MESSAGE_COM_PUB{ABL:ARG:회화타입}
		L_RESULT = 2
	CATCH
		L_RESULT = 0
	ENDCATCH
ENDIF
IF CFLAG:ARG:구상셀렉트 % 50 != 0 && CFLAG:ARG:구상셀렉트 < 60
	TRYCCALLFORM KOJO_MESSAGE_COM_K{NO:ARG}_{CFLAG:ARG:구상셀렉트%50}
		L_RESULT = 1
	CATCH
	ENDCATCH
ENDIF
SKIPDISP 0
SELECTCOM = STOCK_SELECTCOM
ASSI = STOCK_ASSI
TARGET = STOCK_TARGET
RETURN L_RESULT

@人称定義, ARGS, ARG, ARG:1, ARG:2
#DIM LCOUNT
#DIM L_CHARA
#DIMS CONST L_TABLE = "조교자", "조교대상", "조수", "타겟", "행동자", "핀치캐릭터"
#DIMS TEMPS
FOR LCOUNT, 0, VARSIZE("L_TABLE")
	TEMPS = %L_TABLE:LCOUNT%

	CSTR:ARG:(TEMPS + "이인칭") = 
	CSTR:ARG:(TEMPS + "삼인칭") = 
	RESULTS:0 = 
	RESULTS:1 = 

	SELECTCASE ARGS
		CASE "BATTLE_MESSAGE", "ENEMY_BATTLE_MESSAGE", "BATTLE_BOYCOTT_MESSAGE"
			SIF !GROUPMATCH(TEMPS, "타겟")
				CONTINUE
		CASE "BATTLE_EVENT", "ENEMY_BATTLE_EVENT"
			SIF !GROUPMATCH(TEMPS, "타겟", "행동자")
				CONTINUE
		CASE "KOJO_BATTLE_NAVI"
			SIF !GROUPMATCH(TEMPS, "핀치캐릭터")
				CONTINUE
		CASEELSE
			SIF !GROUPMATCH(TEMPS, "조교자", "조교대상", "조수")
				CONTINUE
	ENDSELECT

	SELECTCASE TEMPS
		CASE "조교자"
			L_CHARA = PLAYER
		CASE "조교대상"
			L_CHARA = TARGET
		CASE "조수"
			L_CHARA = ASSI
		CASE "핀치캐릭터"
			L_CHARA = TFLAG:핀치캐릭터
		CASE "행동자"
			L_CHARA = FLAG:행동순1
		CASE "타겟"
			IF GET_BATTLE_EVENT(TFLAG:전투이벤트) == "与ダメージ単体"
				L_CHARA = ARG:2
			ELSE
				IF INRANGE(CFLAG:ARG:타겟, 1, 16)
					L_CHARA = POS(CFLAG:ARG:타겟)
				ELSE
					CONTINUE
				ENDIF
			ENDIF
	ENDSELECT
	SIF L_CHARA < 0
		CONTINUE
	;2024/05/22		余計な_の除去と引数の修正（憶測ベース）
	TRYCCALLFORM 人称定義%口上関数末尾文字(ARG)%, L_CHARA, ARG, TEMPS
	CATCH
		IF L_CHARA == MASTER
			RESULTS:0 = %CSTR:ARG:이인칭%
			RESULTS:1 = %CSTR:ARG:이인칭%
		ELSE
			RESULTS:0 = %CALLNAME:L_CHARA%
			RESULTS:1 = %CALLNAME:L_CHARA%
		ENDIF
	ENDCATCH
	CSTR:ARG:(TEMPS + "이인칭") = %RESULTS:0%
	CSTR:ARG:(TEMPS + "삼인칭") = %RESULTS:1%
NEXT