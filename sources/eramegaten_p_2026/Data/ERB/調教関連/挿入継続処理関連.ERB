	;Aへの苦痛は先に処理しておく
	;EXP:Ａ経験をみる
	IF EXP:Ａ경험 < EXPLV:1
		TIMES LOCAL , 3.00
		TIMES LOCAL:1 , 3.00
	ELSEIF EXP:Ａ경험 < EXPLV:2
		TIMES LOCAL , 1.20
		TIMES LOCAL:1 , 2.00
	ELSEIF EXP:Ａ경험 < EXPLV:3
		TIMES LOCAL , 0.80
		TIMES LOCAL:1 , 1.50
	ELSEIF EXP:Ａ경험 < EXPLV:4
		TIMES LOCAL , 0.60
		TIMES LOCAL:1 , 1.20
	ELSEIF EXP:Ａ경험 < EXPLV:5
		TIMES LOCAL , 0.40
	ELSEIF EXP:Ａ경험 >= EXPLV:5
		TIMES LOCAL , 0.20
	ENDIF

	;PALAM:潤滑をみる
	IF PALAM:윤활 < PALAMLV:1
		TIMES LOCAL , 1.20
		TIMES LOCAL:1 , 2.00
	ELSEIF PALAM:윤활 < PALAMLV:2
		TIMES LOCAL , 1.00
		TIMES LOCAL:1 , 1.50
	ELSEIF PALAM:윤활 < PALAMLV:3
		TIMES LOCAL , 0.60
	ELSEIF PALAM:윤활 < PALAMLV:4
		TIMES LOCAL , 0.30
	ELSEIF PALAM:윤활 >= PALAMLV:4
		TIMES LOCAL , 0.20
	ENDIF

	SOURCE:TARGET:아픔 += LOCAL
	SOURCE:TARGET:반감 += LOCAL:1

	;-------------------------------------------------
	;汚れの処理
	;-------------------------------------------------
	IF TEQUIP:촉수
		;奴隷のＡに触手の汚れがつく
		CALL SET_STAIN("애널", "粘液", TARGET)
	ELSE
		;奴隷のＡ⇔調教者の指の汚れが移動
		CALL MOVE_STAIN("애널", TARGET, "손", PLAYER)
	ENDIF

	;-------------------------------------------------
	;吸精処理
	;-------------------------------------------------
	IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
		LOCAL = (RAND:3+1) * BASE:LV
		CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
	ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
		LOCAL = (RAND:3+1) * BASE:LV
		CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
	ENDIF

	;-------------------------------------------------
	;経験の処理
	;-------------------------------------------------
	CALL ADDS_EXP("Ａ경험", 1, TARGET)

	A = 2
	IF IS_LESBIAN(TARGET,PLAYER)
		CALL ADDS_EXP("레즈경험", A, TARGET)
		CALL ADDS_EXP("레즈경험", A, PLAYER)
	ELSEIF IS_GAY(TARGET,PLAYER)
		CALL ADDS_EXP("ＢＬ경험", A, TARGET)
		CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
	ENDIF

	;依存度ベクトル
	TFLAG:33 = 3
;---003 ADD START---
ELSEIF TEQUIP:TARGET:Ａ손가락삽입 > 1
	TEQUIP:TARGET:Ａ손가락삽입 = 1
;---003 ADD END---
ENDIF
PRINTFORML ＜%TARGET에게% 손가락 Ａ 삽입 중＞


;----------------------------------------------------------------------
@EQUIP_P_INSERT_V_PLAYER
;----------------------------------------------------------------------
IF TEQUIP:PLAYER:Ｖ섹스 > 0 && TEQUIP:PLAYER:Ｖ섹스 < 2
	;調教者←→調教対象
	TFLAG:28 = 3
	;-------------------------------------------------
	;ソースの計算
	;-------------------------------------------------
	LOSEBASE:체력 += 25
	LOSEBASE:기력 += 50


	IF TALENT:PLAYER:유아체형
		SOURCE:TARGET:쾌Ｃ = 150
		SOURCE:아픔 += 25
	ELSEIF TALENT:PLAYER:소인체형
		SOURCE:TARGET:쾌Ｃ = 250
		SOURCE:아픔 += 50
	ENDIF
	IF TALENT:큰체형
		SOURCE:TARGET:쾌Ｃ = 100
		SOURCE:아픔 += 25
	ELSEIF TALENT:거체
		SOURCE:TARGET:쾌Ｃ = 100
		SOURCE:아픔 += 50
	ENDIF

	SOURCE:TARGET:성행위 = 250
	SOURCE:TARGET:굴종 = 500
	SOURCE:TARGET:일탈 = 250
	IF IS_MALE(TARGET) && (TALENT:쾌감을부정 == 0 || ABL:욕망 > 2)
		SOURCE:TARGET:반감 += 25
	ELSE
		SOURCE:TARGET:반감 += 250
	ENDIF

	;調教者に快Ｖ
	SOURCE:PLAYER:쾌Ｖ += 200

	;-------------------------------------------------
	;射精チェック
	;-------------------------------------------------

	;射精先タイプの設定
	TCVAR:TARGET:페니스사용대상 = PLAYER
	TCVAR:TARGET:사정부위 = 1
	TFLAG:사정대상선택가능 = 0

	;-------------------------------------------------
	;汚れの処理
	;-------------------------------------------------
	;射精に関係なく行われる処理はここから
	;膣内に破瓜の血の汚れを付加
	SIF TALENT:PLAYER:처녀 == 1 || TALENT:PLAYER:재생처녀 == 1
		CALL SET_STAIN("질내", "破瓜の血", PLAYER)
	;奴隷の膣内⇔調教者のＰの汚れが移動
	CALL MOVE_STAIN("질내", TARGET, "페니스", PLAYER)

	;-------------------------------------------------
	;吸精処理
	;-------------------------------------------------
	IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
		LOCAL = (RAND:10+1) * BASE:LV
		CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
	ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
		LOCAL = (RAND:10+1) * BASE:LV
		CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
	ENDIF

	;-------------------------------------------------
	;経験の処理
	;-------------------------------------------------
	;調教者のV経験
	CALL ADDS_EXP("Ｖ경험", 1, PLAYER)

	CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)
	CALL ADDS_EXP("성교경험", 1, PLAYER)
	CALL ADDS_EXP("삽입경험", 1, TARGET)
	;수간경험
	IF (TALENT:TARGET:짐승 || TALENT:TARGET:새) && !(TALENT:PLAYER:짐승 || TALENT:PLAYER:새)
		CALL ADDS_EXP("수간경험", 1, PLAYER)
	ENDIF

	;処女で同性の場合異常経験
	IF TALENT:PLAYER:처녀 && !IS_MALE(TARGET)
		CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", TARGET)
		CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", PLAYER)
	ENDIF
	;近親相姦の場合異常経験付与
	IF 近親チェック(PLAYER , TARGET)
		CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:0%）", PLAYER)
		CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:1%）", TARGET)
	ENDIF
	;레즈경험
	A = 4
	IF IS_LESBIAN(TARGET,PLAYER)
		CALL ADDS_EXP("레즈경험", A, TARGET)
		CALL ADDS_EXP("레즈경험", A, PLAYER)
	ELSEIF IS_GAY(TARGET,PLAYER)
		CALL ADDS_EXP("ＢＬ경험", A, TARGET)
		CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
	ENDIF



	;依存度ベクトル
	TFLAG:33 = 1

	;依存度補正値(主人かつ恋慕、淫乱、服従で1。親愛、娼婦、隷属で2）
	IF (TALENT:연모 || TALENT:음란 || TALENT:복종) && ASSIPLAY == 0
		TFLAG:30 += 1
	ELSEIF (TALENT:친애 || TALENT:창부 || TALENT:예속) && ASSIPLAY == 0
		TFLAG:30 += 2
	ENDIF

	;奉仕快楽フラグ
	TFLAG:100 = 1
ENDIF
PRINTFORML ＜%조사처리(CALLNAME:TARGET, "로부터")% Ｖ 삽입 중＞


;----------------------------------------------------------------------
@EQUIP_P_INSERT_A_PLAYER
;----------------------------------------------------------------------
IF TEQUIP:PLAYER:Ａ섹스 > 0 && TEQUIP:PLAYER:Ａ섹스 < 2
	;調教者←→調教対象
	TFLAG:28 = 3

	B += 750
;	;再装填処理中は射精ゲージは20分の1に
;	SIF CFLAG:PLAYER:射精ゲージ再装填 > 0
;		B /= 20
	SIF HAVE_PENIS(PLAYER)
		BASE:PLAYER:사정 += B

	;調教対象→調教者
	TFLAG:28 = 1

	LOSEBASE:체력 += 20
	LOSEBASE:기력 += 80

	SOURCE:TARGET:쾌Ｃ += 300
	SOURCE:TARGET:성행위 += 250
	SOURCE:TARGET:복종 = 250
	SOURCE:TARGET:굴종 += 500
	IF IS_MALE(TARGET) && (TALENT:쾌감을부정 == 0 || ABL:욕망 > 2)
		SOURCE:TARGET:반감 = 25
	ELSE
		SOURCE:TARGET:반감 = 250
	ENDIF

	SOURCE:TARGET:불결 += 375

	;調教者に快Ａ
	SOURCE:PLAYER:쾌Ａ = 350

	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:억압 || TALENT:저항
		SOURCE:TARGET:울굴 += 350

	;-------------------------------------------------
	;射精チェック
	;-------------------------------------------------

	;射精先タイプの設定
	TCVAR:TARGET:페니스사용대상 = PLAYER
	TCVAR:TARGET:사정부위 = 2
	;射精先選択の可・不可
	TFLAG:사정대상선택가능 = 0


	;-------------------------------------------------
	;汚れの処理
	;-------------------------------------------------
	;射精に関係なく行われる処理はここから
	;調教者のＡ⇔奴隷のＰの汚れが移動
	CALL MOVE_STAIN("애널", PLAYER, "페니스", TARGET)

	;-------------------------------------------------
	;吸精処理
	;-------------------------------------------------
	IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
		LOCAL = (RAND:10+1) * BASE:LV
		CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
	ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
		LOCAL = (RAND:10+1) * BASE:LV
		CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
	ENDIF

	;-------------------------------------------------
	;経験の処理
	;-------------------------------------------------
	;調教者のＡ経験
	CALL ADDS_EXP("Ａ경험", 1, PLAYER)

	CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)
	CALL ADDS_EXP("성교경험", 1, PLAYER)
	CALL ADDS_EXP("삽입경험", 1, TARGET)
	;수간경험
	IF (TALENT:TARGET:짐승 || TALENT:TARGET:새) && !(TALENT:PLAYER:짐승 || TALENT:PLAYER:새)
		CALL ADDS_EXP("수간경험", 1, PLAYER)
	ENDIF
	;레즈경험
	A = 4
	IF IS_LESBIAN(TARGET,PLAYER)
		CALL ADDS_EXP("레즈경험", A, TARGET)
		CALL ADDS_EXP("레즈경험", A, PLAYER)
	ELSEIF IS_GAY(TARGET,PLAYER)
		CALL ADDS_EXP("ＢＬ경험", A, TARGET)
		CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
	ENDIF

	;依存度ベクトル
	TFLAG:33 = 3

	;依存度補正値(主人かつ恋慕、淫乱、服従で1。親愛、娼婦、隷属で2）
	IF (TALENT:연모 || TALENT:음란 || TALENT:복종) && ASSIPLAY == 0
		TFLAG:30 += 1
	ELSEIF (TALENT:친애 || TALENT:창부 || TALENT:예속) && ASSIPLAY == 0
		TFLAG:30 += 2
	ENDIF

	;奉仕快楽フラグ
	TFLAG:100 = 1

ENDIF
PRINTFORML ＜%조사처리(CALLNAME:TARGET, "로부터")% Ａ 삽입 중＞




