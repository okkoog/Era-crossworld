;-------------------------------------------------
;자위과시
;-------------------------------------------------
@CHECK_COM_ABLE127

;下半身下着をつけている、スカート以外の下半身上着を履いている、下の空いてない全身上着を着ているとダメ
SIF !USE_CLI(PLAYER) && !USE_PENIS(PLAYER) && !ITEM_PENIS(PLAYER)
	RETURN 0
RETURN 1

@ACT_COM127
;자위과시
;せっかくだから触手調教中は名前が変わるようにしてみた
IF TEQUIP:촉수
	PRINTL 촉수자위과시
	TSTR:0 = 촉수자위과시
ELSE
	PRINTL 자위과시
	TSTR:0 = 자위과시
ENDIF

;CALL KOJO_MESSAGE_COM
;-------------------------------------------------
;射精ゲージチェック
;-------------------------------------------------
B = 0

;プレイヤーの技巧をみる
IF ABL:PLAYER:기교 == 0
	B = 800
ELSEIF ABL:PLAYER:기교 == 1
	B = 1600
ELSEIF ABL:PLAYER:기교 == 2
	B = 2400
ELSEIF ABL:PLAYER:기교 == 3
	B = 3200
ELSEIF ABL:PLAYER:기교 == 4
	B = 4000
ELSE
	B = 2800 + (ABL:PLAYER:기교 * 400)
ENDIF

;プレイヤーのABL:Ｃ感覚をみる
IF ABL:PLAYER:Ｃ감각 == 0
	TIMES B , 1.00
ELSEIF ABL:PLAYER:Ｃ감각 == 1
	TIMES B , 1.50
ELSEIF ABL:PLAYER:Ｃ감각 == 2
	TIMES B , 2.00
ELSEIF ABL:PLAYER:Ｃ감각 == 3
	TIMES B , 2.50
ELSEIF ABL:PLAYER:Ｃ감각 == 4
	TIMES B , 3.50
ELSE
	TIMES B , 5.00
ENDIF

LOCAL:99 = B

;;再装填処理中は射精ゲージは20分の1に
;IF CFLAG:PLAYER:射精ゲージ再装填 > 0
;	B /= 20
;	LOCAL:99 /= 20
;ENDIF
SIF HAVE_PENIS(PLAYER)
	BASE:PLAYER:사정 += B

BASE:PLAYER:99 += LOCAL:99
;調教者→調教者
TFLAG:28 = 8
;-------------------------------------------------
;ソースの計算
;-------------------------------------------------
LOSEBASE:체력 += 5
LOSEBASE:기력 += 35

SOURCE:노출 = 200
SOURCE:불결 = 100
SOURCE:일탈 = 150
SOURCE:TARGET:반감 = 250

;-------------------------------------------------
;特殊ソース処理
;他のコマンドと性質がかなり違うのでほとんど特殊で定義する
;-------------------------------------------------
;PALAM:欲情をみる
SELECTCASE GETPALAMLV(TARGET, GETNUM(PALAM, "욕정"))
	CASE 0
		SOURCE:TARGET:욕정 = 0
	CASE 1
		SOURCE:TARGET:욕정 = 25
	CASE 2
		SOURCE:TARGET:욕정 = 50
	CASE 3
		SOURCE:TARGET:욕정 = 100
	CASE 4
		SOURCE:TARGET:욕정 = 200
	CASEELSE
		SOURCE:TARGET:욕정 = 400
ENDSELECT
SELECTCASE ABL:TARGET:노출증
	CASE 0
		SOURCE:TARGET:무서움 = 100
	TIMES SOURCE:욕정 , 0.00
	CASE 1
		SOURCE:TARGET:무서움 = 50
	TIMES SOURCE:욕정 , 0.40
	CASE 2
		SOURCE:TARGET:무서움 = 20
		TIMES SOURCE:욕정 , 0.60
	CASE 3
		SOURCE:TARGET:무서움 = 10
		TIMES SOURCE:욕정 , 0.75
	CASE 4
		SOURCE:TARGET:무서움 = 10
		TIMES SOURCE:욕정 , 0.90
	CASEELSE
		SOURCE:TARGET:무서움 = 0
		SOURCE:욕정 = SOURCE:욕정 * (100 + (ABL:노출증 - 5) * 10) / 100
ENDSELECT
;IF PALAM:욕정 < PALAMLV:1
;	SOURCE:욕정 = 25
;ELSEIF PALAM:욕정 < PALAMLV:2
;	SOURCE:욕정 = 50
;ELSEIF PALAM:욕정 < PALAMLV:3
;	SOURCE:욕정 = 100
;ELSEIF PALAM:욕정 < PALAMLV:4
;	SOURCE:욕정 = 200
;ELSE
;	SOURCE:욕정 = 400
;ENDIF
;ABL:自慰中毒をみる
IF ABL:자위중독 == 0
	SOURCE:성행위 = 25
	SOURCE:굴종 = 100
	TIMES SOURCE:불결 , 4.00
	TIMES SOURCE:욕정 , 1.00
ELSEIF ABL:자위중독 == 1
	SOURCE:성행위 = 50
	SOURCE:굴종 = 80
	TIMES SOURCE:불결 , 2.50
	TIMES SOURCE:욕정 , 1.05
ELSEIF ABL:자위중독 == 2
	SOURCE:성행위 = 75
	SOURCE:굴종 = 70
	TIMES SOURCE:불결 , 1.50
	TIMES SOURCE:욕정 , 1.10
ELSEIF ABL:자위중독 == 3
	SOURCE:성행위 = 100
	SOURCE:굴종 = 60
	TIMES SOURCE:불결 , 1.00
	TIMES SOURCE:욕정 , 1.20
ELSEIF ABL:자위중독 == 4
	SOURCE:성행위 = 125
	SOURCE:굴종 = 50
	TIMES SOURCE:불결 , 0.50
	TIMES SOURCE:욕정 , 1.35
ELSE
	SOURCE:성행위 = 90 + (ABL:자위중독 * 12)
	SOURCE:굴종 = 0
	TIMES SOURCE:불결 , 0.10
	SOURCE:욕정 = SOURCE:욕정 * (150 + (ABL:자위중독 - 5) * 10) / 100
ENDIF


;調教者に快Ｃ、快Ｂ
SOURCE:PLAYER:쾌Ｃ = 80
SOURCE:PLAYER:3 = 80
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 20

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
;射精先タイプの設定
TCVAR:PLAYER:페니스사용대상 = TARGET
TCVAR:PLAYER:사정부위 = 14
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 1

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;調教者の指⇔調教者のＰの汚れが移動
IF HAVE_PENIS(PLAYER)
	CALL MOVE_STAIN("손", PLAYER, "페니스", PLAYER)
;調教者の指⇔調教者のＶの汚れが移動
ELSE
	CALL MOVE_STAIN("바기나", PLAYER, "페니스", PLAYER)
ENDIF

;調教者がふたなり
;SIF TALENT:PLAYER:후타나리
;	SOURCE:굴종 /= 2

;자위경험
CALL ADDS_EXP("자위경험", 1, PLAYER)

;公開オナニー時は異常経験付加
IF TEQUIP:비디오카메라
	CALL ADDS_ABNORMAL_EXP("公開自慰", PLAYER)
ENDIF
RETURN 1
;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:7+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:7+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

@MESSAGE_COM127
IF TEQUIP:촉수
	IF TEQUIP:주도권
		PRINTFORMW %CALLNAME:PLAYER%은(는) 의사와는 상관없이 %CALLNAME:TARGET%의 눈앞에서 촉수에게 농락당했다…
	ELSE
		PRINTFORMW %CALLNAME:PLAYER%은(는) %CALLNAME:TARGET%에게 과시하듯이 촉수 자위를 행했다…
	ENDIF
ELSE
	IF TEQUIP:주도권
		PRINTFORMW %CALLNAME:PLAYER%은(는) %CALLNAME:TARGET%에게 명령받아 눈앞에서 자위를 행했다…
	ELSE
		PRINTFORMW %CALLNAME:PLAYER%은(는) %CALLNAME:TARGET%에게 과시하듯이 눈앞에서 자위를 행했다…
	ENDIF
ENDIF

;===================================================
;調教タイプ
;===================================================
@COMTYPE_127
RETURN COMTYPE("助手・レズ系")


