;-------------------------------------------------
;삽입전립선고문시킨다
;調教師奉仕系派生コマンド
;-------------------------------------------------

;-------------------------------------------------
;実行判定
;-------------------------------------------------
@CHECK_COM_ABLE520
;オトコ・男の娘じゃないとダメ
SIF HAVE_VAGINA(PLAYER)
	RETURN 0

;対象の技巧3未満はダメ
SIF ABL:TARGET:기교 < 3
	RETURN 0

SIF !PLAY_ANALSEX(TARGET,PLAYER)
	RETURN 0

RETURN 1

@ACT_COM520
PRINTL 삽입전립선고문시킨다
TSTR:0 = 삽입전립선고문시킨다
SELECTCOM = 520

;-------------------------------------------------
;実行決定
;-------------------------------------------------

;CALL KOJO_MESSAGE_COM

;調教者←→調教対象
TFLAG:28 = 3

;-------------------------------------------------
;射精ゲージチェック
;-------------------------------------------------
B = 1500


;ABL:調教対象の技巧をみる
IF ABL:TARGET:기교 == 0
	TIMES B , 1.00
ELSEIF ABL:TARGET:기교 == 1
	TIMES B , 1.20
ELSEIF ABL:TARGET:기교 == 2
	TIMES B , 1.40
ELSEIF ABL:TARGET:기교 == 3
	TIMES B , 1.60
ELSEIF ABL:TARGET:기교 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.00
ENDIF

;ABL:従順をみる
IF ABL:순종 == 0
	TIMES B , 0.80
ELSEIF ABL:순종 == 1
	TIMES B , 0.90
ELSEIF ABL:순종 == 2
	TIMES B , 1.00
ELSEIF ABL:순종 == 3
	TIMES B , 1.10
ELSEIF ABL:순종 == 4
	TIMES B , 1.20
ELSE
	TIMES B , 1.30
ENDIF

;ABL:欲望をみる
IF ABL:욕망 == 0
	TIMES B , 1.00
ELSEIF ABL:욕망 == 1
	TIMES B , 1.10
ELSEIF ABL:욕망 == 2
	TIMES B , 1.20
ELSEIF ABL:욕망 == 3
	TIMES B , 1.30
ELSEIF ABL:욕망 == 4
	TIMES B , 1.40
ELSE
	TIMES B , 1.50
ENDIF

;PALAM:潤滑をみる
IF PALAM:PLAYER:윤활 < PALAMLV:1
	TIMES B , 0.60
ELSEIF PALAM:PLAYER:윤활 < PALAMLV:2
	TIMES B , 0.80
ELSEIF PALAM:PLAYER:윤활 < PALAMLV:3
	TIMES B , 1.00
ELSEIF PALAM:PLAYER:윤활 < PALAMLV:4
	TIMES B , 1.20
ELSEIF PALAM:PLAYER:윤활 >= PALAMLV:4
	TIMES B , 1.40
ENDIF

;調教対象のABL:Ｃ感覚をみる
IF ABL:TARGET:Ｃ감각 == 0
	TIMES B , 1.00
ELSEIF ABL:TARGET:Ｃ감각 == 1
	TIMES B , 1.50
ELSEIF ABL:TARGET:Ｃ감각 == 2
	TIMES B , 2.00
ELSEIF ABL:TARGET:Ｃ감각 == 3
	TIMES B , 2.50
ELSEIF ABL:TARGET:Ｃ감각 == 4
	TIMES B , 3.50
ELSE
	TIMES B , 5.00
ENDIF

;再装填処理中は射精ゲージは20分の1に
SIF CFLAG:TARGET:9 > 0
	B /= 20


SIF HAVE_PENIS(TARGET)
	BASE:TARGET:2 += B

;調教対象→調教者
TFLAG:28 = 1

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 50
DOWNBASE:TARGET:기력 += 180

SOURCE:TARGET:쾌Ｃ = 600
SOURCE:TARGET:정애 = 200
SOURCE:TARGET:성행위 = 400
SOURCE:TARGET:굴종 = 600
SOURCE:TARGET:복종 = 500
SOURCE:TARGET:반감 = 500
SIF IS_MALE(TARGET) && (TALENT:쾌감을부정 == 0 || ABL:욕망 > 2) && !IS_LOOKSLIKE_MALE(PLAYER)
	SOURCE:TARGET:반감 /= 10
SOURCE:TARGET:불결 = 750
SOURCE:TARGET:일탈 = 1000

;調教者に快A
SOURCE:PLAYER:쾌Ａ = 700
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 500

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
;射精先タイプの設定
TCVAR:PLAYER:페니스사용대상 = TARGET
TCVAR:PLAYER:사정부위 = 14
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 0

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;調教者のＡ⇔奴隷のＰの汚れが移動
CALL MOVE_STAIN("애널", PLAYER, "페니스", TARGET)

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;調教者のＡ経験
CALL ADDS_EXP("Ａ경험", 1, PLAYER)

CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)
CALL ADDS_EXP("성교경험", 1, PLAYER)

;삽입경험
CALL ADDS_EXP("삽입경험", 1, TARGET)

;수간경험
IF (TALENT:TARGET:짐승 || TALENT:TARGET:새) && !(TALENT:PLAYER:짐승 || TALENT:PLAYER:새)
	CALL ADDS_EXP("수간경험", 1, PLAYER)
ENDIF
;레즈경험
A = 4
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
	
	
ENDIF

;依存度ベクトル
TFLAG:33 = 3

;依存度補正値(主人かつ恋慕、淫乱、服従で1。親愛、娼婦、隷属で2）
IF (TALENT:연모 || TALENT:음란 || TALENT:복종) && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF (TALENT:친애 || TALENT:창부 || TALENT:예속) && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF

;奉仕快楽フラグ
TFLAG:100 = 1

RETURN 1

