
@CHECK_COM_ABLE92
;正常位させる実行判定

;調教者のヴァギナが使えないとダメ
SIF !USE_VAGINA(PLAYER) 
	RETURN 0
	
;調教対象のペニスが使えないとダメ
SIF  !USE_PENIS(TARGET) && !USE_PBAND(TARGET)
	RETURN 0

;触手調教中はダメ
SIF TEQUIP:촉수
	RETURN 0

;縄・拘束中はダメ
SIF TEQUIP:밧줄
	RETURN 0

;三角木馬騎乗中はダメ
SIF TEQUIP:삼각목마
	RETURN 0

;お風呂場プレイ中はプレイマットが無いとダメ
IF TEQUIP:목욕탕
	SIF !EXIST_ITEM(20)
		RETURN 0
ENDIF

RETURN 1


@ACT_COM92
;정상위시킨다

PRINTL 정상위시킨다
TSTR:0 = 정상위시킨다

;-------------------------------------------------
;実行決定
;-------------------------------------------------
;CALL KOJO_MESSAGE_COM

;調教者←→調教対象
TFLAG:28 = 3
;-------------------------------------------------
;ソースの計算
;-------------------------------------------------
LOSEBASE:체력 += 50
LOSEBASE:기력 += 100

SOURCE:TARGET:쾌Ｃ = 400
IF TALENT:PLAYER:유아체형
	TIMES SOURCE:쾌Ｃ , 1.50
	SOURCE:아픔 += 50
ELSEIF TALENT:PLAYER:소인체형
	TIMES SOURCE:쾌Ｃ , 2.50
	SOURCE:아픔 += 100
ENDIF
IF TALENT:큰체형
	TIMES SOURCE:쾌Ｃ , 1.50
	SOURCE:아픔 += 50
ELSEIF TALENT:거체
	TIMES SOURCE:쾌Ｃ , 2.50
	SOURCE:아픔 += 100
ENDIF

SOURCE:TARGET:성행위 = 500
SOURCE:TARGET:굴종 = 1000
SOURCE:TARGET:복종 = 500
SOURCE:TARGET:반감 = 500
SIF IS_MALE(TARGET) && (TALENT:쾌감을부정 == 0 || ABL:욕망 > 2)
	SOURCE:TARGET:반감 /= 10

;調教者に快Ｖ
SOURCE:PLAYER:쾌Ｖ = 400

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 700

SIF (TALENT:PLAYER:처녀 == 1 || TALENT:PLAYER:재생처녀 == 1)
	TFLAG:31 = 1
	
;調教者が処女か再生処女（異常経験は一回のみ）
IF (TALENT:PLAYER:처녀 == 1 || TALENT:PLAYER:재생처녀 == 1)
	TIMES SOURCE:TARGET:노출 , 20.00
	TIMES SOURCE:TARGET:굴종 , 3.00
	PRINTFORM ＜%PLAYER는% 
	SIF TALENT:PLAYER:재생처녀 == 1
		PRINT 재생 
	PRINTL 처녀를 잃었습니다＞

	;異常経験追加
	SIF !IS_MALE(TARGET)
		CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", TARGET)
	SIF !IS_MALE(TARGET)
		CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", PLAYER)
ENDIF
;-------------------------------------------------
;射精チェック
;-------------------------------------------------

;射精先タイプの設定
TEQUIP:PLAYER:Ｖ삽입자 = TARGET
TCVAR:TARGET:페니스사용대상 = PLAYER
TCVAR:TARGET:사정부위 = 1
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 0

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;膣内に破瓜の血の汚れを付加
SIF TALENT:PLAYER:처녀 == 1 || TALENT:PLAYER:재생처녀 == 1
	CALL SET_STAIN("질내", "破瓜の血", PLAYER)
;奴隷の膣内⇔調教者のＰの汚れが移動
CALL MOVE_STAIN("질내", TARGET, "페니스", PLAYER)

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;調教者のV経験
CALL ADDS_EXP("Ｖ경험", 1, PLAYER)

CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)
CALL ADDS_EXP("성교경험", 1, PLAYER)

;삽입경험
CALL ADDS_EXP("삽입경험", 1, TARGET)

;수간경험
IF (TALENT:TARGET:짐승 || TALENT:TARGET:새) && !(TALENT:PLAYER:짐승 || TALENT:PLAYER:새)
	CALL ADDS_EXP("수간경험", 1, PLAYER)
ENDIF

;処女で同性の場合異常経験
IF TALENT:PLAYER:처녀 && !IS_MALE(TARGET)
	CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", TARGET)
	CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", PLAYER)
ENDIF
;近親相姦の場合異常経験付与
IF 近親チェック(PLAYER , TARGET)
	CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:0%）", PLAYER)
	CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:1%）", TARGET)
ENDIF
;레즈경험
A = 4
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF



;依存度ベクトル
TFLAG:33 = 1

;依存度補正値(主人かつ恋慕、淫乱、服従で1。親愛、娼婦、隷属で2）
IF (TALENT:연모 || TALENT:음란 || TALENT:복종) && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF (TALENT:친애 || TALENT:창부 || TALENT:예속) && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF

;奉仕快楽フラグ
TFLAG:100 = 1

RETURN 1

@MESSAGE_COM92
	IF TEQUIP:주도권
		PRINTFORM %TARGET은% %PLAYER를% \@TALENT:영맹 ? 난폭하게 #\@ 깔아뭉개고, 
		PRINTFORM \@GET_STAIN("바기나", "정액", PLAYER) ? 정액이 흘러넘치는 #\@\@ TALENT:PLAYER:유아체형 || TALENT:PLAYER:소인체형 ? 세로줄 # 비열\@에 페니스를 대고 
		;「TARGETが真性のサドか」「サドっ気持ちか」で分岐
		IF (TALENT:새드 || ABL:새드끼 >= 5 || TALENT:영맹) && RAND:3 == 0
			PRINT 귀두를 자궁구에 들이받듯이 
		ELSEIF TALENT:새드 || (ABL:새드끼 >= 4 && RAND:2 == 0)
			PRINTFORM %PLAYER를% 애태우듯 천천히 
		ELSEIF RAND:2 == 0
			PRINT 그대로 
		ENDIF
		;「TARGETが真性のサドか」「サドっ気持ちか」で分岐
		IF (TALENT:새드 || ABL:새드끼 >= 5 || TALENT:영맹) && RAND:3 == 0
			PRINT 찔러 넣고는, 
		ELSEIF ABL:새드끼 >= 3 && RAND:2 == 0
			PRINT 삽입하고는, 
		ELSE
			PRINT 밀어 넣고는, 
		ENDIF
		;恋慕で追加
		SIF (TALENT:연모 || TALENT:친애) && RAND:3 >= 1
			PRINTFORM %PLAYER에게% 키스하면서 
		;「TARGETが真性のサドか」「サドっ気持ちか」で分岐
		IF (TALENT:새드 || ABL:새드끼 >= 5 || TALENT:영맹) && RAND:3 == 0
			PRINTFORMW 귀두 턱으로 긁어내듯 %PLAYER의% 질내를 유린했다…
		ELSEIF TALENT:새드 || (ABL:새드끼 >= 3 && RAND:2 == 0) || TALENT:영맹
			PRINTFORMW 격렬하게 허리를 부딪쳤다…
		ELSE
			PRINTFORMW 천천히 허리를 앞뒤로 움직였다…
		ENDIF
	ELSE
		PRINTFORM %PLAYER는% %TARGET의% 앞에 드러눕더니 
		;調教者が淫乱
		IF ABL:PLAYER:욕망 > 3
			PRINTFORM 비열을 과시하듯 다리를 크게 벌리고, 
		ENDIF
		PRINTFORM 발기한 페니스를 
		SIF EXP:PLAYER:Ｖ경험 == 0
			PRINT 남자를 받아들인 적 없는 
		PRINTFORMW 자신의 바기나로 받아들였다…
	ENDIF
;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
@COM_ORDER_92, ARG, ARG:1
IF IS_LOOKSLIKE_MALE(ARG) && !IS_LOOKSLIKE_MALE(ARG:1) && TEQUIP:ARG:주도권
	CALL ADD_COM_ORDER, "判定無視", CALLNAME:ARG+"主導＋正常行為"
	RETURN 0
ENDIF
CALL ADD_COM_ORDER, "ABL", "욕망", 2, ARG, ARG:1
CALL ADD_COM_ORDER, "MARK", "쾌락각인", 2, ARG, ARG:1
CALL ADD_COM_ORDER, "PALAM", "욕정", 2, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "쾌감에솔직", 2, ARG, ARG:1
SIF !TALENT:ARG:음란 && !TALENT:ARG:창부
	CALL ADD_COM_ORDER, "TALENT", "쾌감을부정", -2, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "음란", 10, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "창부", 15, ARG, ARG:1
;オトコだと逆らいにくい
SIF IS_MALE(TARGET)
	CALL ADD_COM_ORDER, "EXTRA", "남자", 15, ARG, ARG:1
;調教者
CALL ADD_COM_ORDER, "TALENT", "처녀", -15, ARG:1, ARG
CALL ADD_COM_ORDER, "TALENT", "정조관념", -10, ARG:1, ARG
CALL ADD_COM_ORDER, "TALENT", "정조관결여", 5, ARG:1, ARG
CALL ADD_COM_ORDER, "ABL", "기교", 4, ARG:1, ARG
CALL ADD_COM_ORDER, "RELATION", , , ARG, ARG:1
;-------------------------------------------------
;実行値
;-------------------------------------------------
@COM_ORDER_NUM_92
RETURN 15
;===================================================
;調教タイプ
;===================================================
@COMTYPE_92
RETURN COMTYPE("調教者奉仕系")


