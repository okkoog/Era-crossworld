		TIMES SOURCE:TARGET:아픔 , 1.20
	ELSE
		TIMES SOURCE:TARGET:아픔 , 0.10
	ENDIF
ENDIF

IF TALENT:PLAYER:284 == 0
	SOURCE:TARGET:아픔 += 0
	TIMES SOURCE:TARGET:아픔 , 1.00
ELSEIF TALENT:PLAYER:284 > 0
	TIMES SOURCE:TARGET:쾌Ｖ , 1.10
	SOURCE:TARGET:아픔 += 0
	TIMES SOURCE:TARGET:아픔 , 0.10
ELSEIF TALENT:PLAYER:284 < 0
	SOURCE:TARGET:아픔 += 500
	TIMES SOURCE:TARGET:아픔 , 1.50
ENDIF

;中毒による中毒充足のソースは先に処理しておく
;セックス中毒を見る
IF ABL:섹스중독 == 0
	TIMES SOURCE:TARGET:중독충족 , 0.00
ELSEIF ABL:섹스중독 == 1
	TIMES SOURCE:TARGET:중독충족 , 0.30
ELSEIF ABL:섹스중독 == 2
	TIMES SOURCE:TARGET:중독충족 , 0.60
ELSEIF ABL:섹스중독 == 3
	TIMES SOURCE:TARGET:중독충족 , 0.90
ELSEIF ABL:섹스중독 == 4
	TIMES SOURCE:TARGET:중독충족 , 1.20
ELSEIF ABL:섹스중독 == 5
	TIMES SOURCE:TARGET:중독충족 , 1.50
ELSEIF ABL:섹스중독 == 6
	TIMES SOURCE:TARGET:중독충족 , 1.80
ELSEIF ABL:섹스중독 == 7
	TIMES SOURCE:TARGET:중독충족 , 2.10
ELSEIF ABL:섹스중독 == 8
	TIMES SOURCE:TARGET:중독충족 , 2.40
ELSEIF ABL:섹스중독 == 9
	TIMES SOURCE:TARGET:중독충족 , 3.00
ELSEIF ABL:섹스중독 >= 10
	TIMES SOURCE:TARGET:중독충족 , 5.00
ENDIF

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
;射精先タイプの設定
TCVAR:PLAYER:페니스사용대상 = TARGET
TCVAR:PLAYER:사정부위 = 1
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 1

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;膣内に破瓜の血の汚れを付加
SIF TALENT:처녀 == 1 || TALENT:재생처녀 == 1
	CALL SET_STAIN("질내", "破瓜の血", TARGET)
;奴隷の膣内⇔調教者のＰの汚れが移動
CALL MOVE_STAIN("질내", TARGET, "페니스", PLAYER)

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;Ｖ경험
CALL ADDS_EXP("Ｖ경험", 6, TARGET)

IF TALENT:처녀 == 1
	CALL ADDS_ABNORMAL_EXP("処女喪失（妖精オナホ）", TARGET)
	SIF !IS_MALE(PLAYER)
		CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", PLAYER)
	SIF !IS_MALE(PLAYER)
		CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", TARGET)
ENDIF

;近親相姦の場合異常経験付与
IF 近親チェック(TARGET , PLAYER)
	CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:0%）", TARGET)
	CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:1%）", PLAYER)
ENDIF

;助手が配偶者の場合異常経験付与
IF CSV配偶者(TARGET, ASSI)
	CALL ADDS_ABNORMAL_EXP( @"寝取られ", TARGET)
	CALL ADDS_ABNORMAL_EXP( @"寝取られ", ASSI)
ENDIF

CALL ADDS_EXP("Ｖ확장경험", 2, TARGET)

;성교경험
CALL ADDS_EXP("성교경험", 1, TARGET)

;삽입경험
CALL ADDS_EXP("삽입경험", 1, PLAYER)

;레즈경험
A = 4
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;애정경험
IF TALENT:연모 == 1 && ASSIPLAY == 0
	CALL ADDS_EXP("애정경험", 1, PLAYER)
	CALL ADDS_EXP("애정경험", 2, TARGET)
ELSEIF TALENT:친애 == 1 && ASSIPLAY == 0
	CALL ADDS_EXP("애정경험", 1, PLAYER)
	CALL ADDS_EXP("애정경험", 4, TARGET)
ENDIF

;依存度ベクトル
TFLAG:33 = 1

;依存度補正値(恋慕で1、親愛で2）
IF TALENT:연모 && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF TALENT:친애 && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF

RETURN 1


