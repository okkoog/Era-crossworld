@ACT_COM91
;파이즈리한다


PRINTL 파이즈리한다
TSTR:0 = 파이즈리한다


;CALL KOJO_MESSAGE_COM
;-------------------------------------------------
;射精ゲージチェック
;-------------------------------------------------
B = 1500

;ABL:調教者の技巧をみる
IF ABL:PLAYER:기교 == 0
	TIMES B , 1.00
ELSEIF ABL:PLAYER:기교 == 1
	TIMES B , 1.20
ELSEIF ABL:PLAYER:기교 == 2
	TIMES B , 1.40
ELSEIF ABL:PLAYER:기교 == 3
	TIMES B , 1.60
ELSEIF ABL:PLAYER:기교 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.00
ENDIF

;ABL:従順をみる
IF ABL:순종 == 0
	TIMES B , 0.80
ELSEIF ABL:순종 == 1
	TIMES B , 0.90
ELSEIF ABL:순종 == 2
	TIMES B , 1.00
ELSEIF ABL:순종 == 3
	TIMES B , 1.10
ELSEIF ABL:순종 == 4
	TIMES B , 1.20
ELSE
	TIMES B , 1.30
ENDIF

;ABL:欲望をみる
IF ABL:욕망 == 0
	TIMES B , 1.00
ELSEIF ABL:욕망 == 1
	TIMES B , 1.10
ELSEIF ABL:욕망 == 2
	TIMES B , 1.20
ELSEIF ABL:욕망 == 3
	TIMES B , 1.30
ELSEIF ABL:욕망 == 4
	TIMES B , 1.40
ELSE
	TIMES B , 1.50
ENDIF

;助手のABL:Ｂ感覚をみる
IF ABL:PLAYER:Ｂ감각 == 0
	TIMES B , 0.50
ELSEIF ABL:PLAYER:Ｂ감각 == 1
	TIMES B , 0.80
ELSEIF ABL:PLAYER:Ｂ감각 == 2
	TIMES B , 1.00
ELSEIF ABL:PLAYER:Ｂ감각 == 3
	TIMES B , 1.20
ELSEIF ABL:PLAYER:Ｂ감각 == 4
	TIMES B , 1.50
ELSE
	TIMES B , 2.00
ENDIF

	LOCAL:99 = B

;;再装填処理中は射精ゲージは20分の1に
;IF CFLAG:PLAYER:射精ゲージ再装填 > 0
;	B /= 20
;	LOCAL:99 /= 20
;ENDIF

	BASE:PLAYER:99 += LOCAL:99
;調教者→調教対象
TFLAG:28 = 2
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
LOSEBASE:체력 += 25
LOSEBASE:기력 += 100

SOURCE:TARGET:쾌Ｃ = 150
SOURCE:TARGET:노출 = 15
SOURCE:TARGET:일탈 = 15
SOURCE:TARGET:반감 = 20

;調教者に快Ｂ
SOURCE:PLAYER:3 = 150
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 20

;-------------------------------------------------
;射精チェック
;-------------------------------------------------

;射精先タイプの設定
TCVAR:TARGET:페니스사용대상 = PLAYER
TCVAR:TARGET:사정부위 = 5
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 0

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＰ⇔調教者のＢの汚れが移動
CALL MOVE_STAIN("페니스", TARGET, "가슴", PLAYER)

;PRINTFORML 봉사쾌락경험(調教者) + 1
;EXP:PLAYER:봉사쾌락경험 += 1
CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)

;依存度ベクトル
IF TALENT:PLAYER:140 == 1
	TFLAG:33 = 3
ELSE
	TFLAG:33 = 2
ENDIF

RETURN 1


