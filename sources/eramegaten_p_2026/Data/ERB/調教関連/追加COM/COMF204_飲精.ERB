;-------------------------------------------------
;정액먹기
;特殊コマンド
;-------------------------------------------------
@CHECK_COM_ABLE204
;野外プレイ中かつ野外プレイ拡張機能ありじゃないとダメ
SIF TEQUIP:29  == 0 || FLAG:46 == 0
	RETURN 0
;人が５人以上いないとダメ
SIF TEQUIP:46 < 5
	RETURN 0
;野次馬の興奮度が60以上ないとダメ
SIF TEQUIP:47 < 60
	RETURN 0
RETURN 1

;最初に表示
@ACT_COM204
;정액먹기
PRINTL 정액먹기
TSTR:0 = 정액먹기
;CALL KOJO_MESSAGE_COM
;CALL MESSAGE_COM204
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 0
DOWNBASE:TARGET:기력 += 100

SOURCE:TARGET:성행위 = 420
SOURCE:TARGET:달성 = 200
SOURCE:TARGET:굴종 = 650
SOURCE:TARGET:일탈 = 500
SOURCE:TARGET:반감 = 500

;上のほうで計算した汚れデータ
SOURCE:TARGET:불결 = Y*40 + 100

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 200

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷の口に汚れ移動
CALL SET_STAIN("입", "精液", TARGET)

;-------------------------------------------------
;経験の処理
;-------------------------------------------------

;-------------------------------------------------
;吸精処理
;野次馬の人数*500
;-------------------------------------------------
LOCAL = TEQUIP:46 * 500
CALL CONTROL_MAG,TARGET,LOCAL


RETURN 1

;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
@COM_ORDER_204, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "욕망", 2, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "봉사정신", 4, ARG, ARG:1
CALL ADD_COM_ORDER, "ABL", "정액중독", 3, ARG, ARG:1
CALL ADD_COM_ORDER, "MARK", "쾌락각인", 1, ARG, ARG:1
CALL ADD_COM_ORDER, "PALAM", "욕정", 1, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "악취둔감", 1, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "악취민감", -3, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "헌신적", 6, ARG, ARG:1
SIF !TALENT:ARG:음란 && !TALENT:ARG:창부
	CALL ADD_COM_ORDER, "TALENT", "쾌감을부정", -1, ARG, ARG:1
;男嫌い（淫乱、娼婦で無効）
SIF HATE(ARG, ARG:1)
	CALL ADD_COM_ORDER, "TALENT", \@IS_MALE(PLAYER) ? 남성혐오 # 여성혐오 \@, -12, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "음란", 5, ARG, ARG:1
CALL ADD_COM_ORDER, "TALENT", "창부", 10, ARG, ARG:1
;調教者がふたなり
;CALL ADD_COM_ORDER, "TALENT", "후타나리", 8, ARG:1, ARG
;CALL ADD_COM_ORDER, "STAIN", "페니스", 100, ARG, ARG:1
CALL ADD_COM_ORDER, "RELATION", , , ARG, ARG:1
;-------------------------------------------------
;実行値
;-------------------------------------------------
@COM_ORDER_NUM_204
RETURN 34

;-------------------------------------------------
;204,정액먹기
;-------------------------------------------------
@MESSAGE_COM204
PRINTFORML %CALLNAME:PLAYER%은(는), 구경꾼들을 부추겨 미리 준비해 둔 용기에 정액을 모으게 했다…
PRINTFORM %CALLNAME:TARGET%은(는) 
;野次馬が14人より多い
IF TEQUIP:46 > 14
	IF RAND:2 == 0
		PRINTL 눈앞에서 조끼에 부어진 대량의 정액을 천천히 마시기 시작했다…
	ELSE
		PRINTL 정액이 가득 채워진 페트병에 입을 대고, 조용히 시간을 들여 맛보기 시작했다…
	ENDIF
ELSE
	IF RAND:2 == 0
		PRINTL 정액이 찰랑찰랑 부어진 잔을 들고, 그대로 목을 울리며 꿀꺽꿀꺽 마시기 시작했다…
	ELSE
		PRINTL 백탁이 부어진 원컵을 집어 들고, 과시하듯이 마셔 간다…
	ENDIF
ENDIF
PRINT 주변의 구경꾼들은 
IF RAND:2 == 0
	PRINTFORMW 천박한 미소를 띠며, %CALLNAME:TARGET%이(가) 백탁액을 삼켜가는 광경을 바라보고 있다…
ELSE
	PRINTFORMW 때때로, 입안에 남은 수컷의 즙을 꼭꼭 씹게 하고 입을 벌리게 하여, 위에 정액을 삼켰는지 확인해 간다…
ENDIF

;===================================================
;調教タイプ
;===================================================
@COMTYPE_204
RETURN COMTYPE("特殊コマンド系")
