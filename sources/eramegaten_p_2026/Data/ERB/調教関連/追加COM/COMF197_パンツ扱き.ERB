;-------------------------------------------------
;팬티훑기
;-------------------------------------------------
@CHECK_COM_ABLE197
#LOCALSSIZE 1
;パンツ扱き実行判定
;手が使えないとだめ
SIF !USE_HAND(TARGET)
	RETURN 0

;調教者がペニス使えないとだめ
SIF !USE_PENIS(PLAYER)
	RETURN 0

;触手調教中はダメ
SIF TEQUIP:촉수
	RETURN 0
;お風呂場プレイ中はプレイマットが無いとダメ
IF TEQUIP:목욕탕
	SIF ITEM:20 == 0 && NOITEM == 0
		RETURN 0
ENDIF
;三角木馬騎乗中はダメ
SIF TEQUIP:삼각목마
	RETURN 0
	
;パンツor下半身下着を設定していて、かつ脱いでる状態でないとダメ
SIF !((CFLAG:속옷（하）&& !TEQUIP:속옷（하）) || (CFLAG:전신속옷 && !TEQUIP:전신속옷))
	RETURN 0

;一部の下着は不可
LOCALS = \@ CFLAG:속옷（하） ? 속옷（하） # 전신속옷 \@
;下に感触が伝わるような柔らか素材じゃないとダメ
TRYCCALLFORM CLOTHES_触覚_{CFLAG:LOCALS},0
	SIF !(RESULT & 2)
		RETURN 0
CATCH
	RETURN 0
ENDCATCH
 
SELECTCASE CFLAG:LOCALS
	CASE [[衣装:새끼줄]] , [[衣装:라비아피어스]], [[衣装:꼬리플러그]]
		RETURN 0
ENDSELECT
RETURN 1

@COMNAME197,ARG
#LOCALSSIZE 1
IF CFLAG:속옷（하）
	LOCALS = 속옷（하）
ELSEIF CFLAG:전신속옷
	LOCALS = 전신속옷
ELSE
	RETURN 0
ENDIF
SELECTCASE CFLAG:LOCALS
	CASE [[衣装:학교수영복]] , [[衣装:학교수영복（구멍뚫림）]]
		RESULTS = 스쿨수영복딸
	CASE [[衣装:슬링샷]], [[衣装:경주용수영복]] , [[衣装:경주용수영복（구멍뚫림）]]
		RESULTS = 수영복딸
	CASE [[衣装:스패츠]]
		RESULTS = 스패츠딸
	CASEELSE
		IF LOCALS == "전신속옷"
			RESULTS = 속옷딸
		ELSE
			RESULTS = 팬티훑기
		ENDIF
ENDSELECT

@ACT_COM197
#LOCALSSIZE 1
CALL COMNAME197
LOCALS = %RESULTS%
PRINTFORML %LOCALS%
;-------------------------------------------------
;実行決定
;-------------------------------------------------
TSTR:0 = %LOCALS%
;CALL KOJO_MESSAGE_COM

;調教対象→調教者
TFLAG:28 = 1

;-------------------------------------------------
;射精ゲージチェック
;-------------------------------------------------
B = 500

;ABL:調教者の技巧をみる
IF ABL:기교 == 0
	TIMES B , 1.00
ELSEIF ABL:기교 == 1
	TIMES B , 1.20
ELSEIF ABL:기교 == 2
	TIMES B , 1.40
ELSEIF ABL:기교 == 3
	TIMES B , 1.60
ELSEIF ABL:기교 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.00
ENDIF

;ABL:従順をみる
IF ABL:순종 == 0
	TIMES B , 0.80
ELSEIF ABL:순종 == 1
	TIMES B , 0.90
ELSEIF ABL:순종 == 2
	TIMES B , 1.00
ELSEIF ABL:순종 == 3
	TIMES B , 1.10
ELSEIF ABL:순종 == 4
	TIMES B , 1.20
ELSE
	TIMES B , 1.30
ENDIF

;ABL:奉仕精神をみる
IF ABL:봉사정신 == 0
	TIMES B , 0.50
ELSEIF ABL:봉사정신 == 1
	TIMES B , 0.80
ELSEIF ABL:봉사정신 == 2
	TIMES B , 1.20
ELSEIF ABL:봉사정신 == 3
	TIMES B , 1.50
ELSEIF ABL:봉사정신 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.40
ENDIF

;プレイヤーのABL:Ｃ感覚をみる
IF ABL:PLAYER:Ｃ감각 == 0
	TIMES B , 1.00
ELSEIF ABL:PLAYER:Ｃ감각 == 1
	TIMES B , 1.50
ELSEIF ABL:PLAYER:Ｃ감각 == 2
	TIMES B , 2.00
ELSEIF ABL:PLAYER:Ｃ감각 == 3
	TIMES B , 2.50
ELSEIF ABL:PLAYER:Ｃ감각 == 4
	TIMES B , 3.50
ELSE
	TIMES B , 5.00
ENDIF
IF CFLAG:속옷（하）
	LOCALS = 속옷（하）
ELSE
	LOCALS = 전신속옷
ENDIF
SELECTCASE CFLAG:LOCALS
	;すく水、スパッツだと効果ＵＰ
	CASE [[衣装:학교수영복]] , [[衣装:학교수영복（구멍뚫림）]] , [[衣装:스패츠]] , [[衣装:레오타드]] , [[衣装:레오타드（구멍뚫림）]]
		TIMES B , 1.20
ENDSELECT

;;再装填処理中は射精ゲージは20分の1に
;SIF CFLAG:PLAYER:射精ゲージ再装填 > 0
;	B /= 20


SIF HAVE_PENIS(PLAYER)
	BASE:PLAYER:사정 += B

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:TARGET:체력 += 15
DOWNBASE:TARGET:기력 += 150

SOURCE:TARGET:정애 = 80
SOURCE:TARGET:성행위 = 225
SOURCE:TARGET:달성 = 60
SOURCE:TARGET:굴종 = 300
SOURCE:TARGET:일탈 = 150
SOURCE:TARGET:반감 = 150

;上のほうで計算した汚れデータ
SOURCE:TARGET:불결 = Y*10 + 60

;調教者に快Ｃ
SOURCE:PLAYER:쾌Ｃ = 120
SELECTCASE CFLAG:LOCALS
	;すく水、スパッツだと効果ＵＰ
	CASE [[衣装:학교수영복]] , [[衣装:학교수영복（구멍뚫림）]] , [[衣装:스패츠]] , [[衣装:레오타드]] , [[衣装:레오타드（구멍뚫림）]]
		TIMES SOURCE:PLAYER:쾌Ｃ , 1.20
ENDSELECT

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 200

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
;射精先タイプの設定
TCVAR:PLAYER:페니스사용대상 = TARGET
TCVAR:PLAYER:사정부위 = 3
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 1

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;奴隷の指⇔調教者のＰの汚れが移動
CALL MOVE_STAIN("손", TARGET, "페니스", PLAYER)

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:2+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:2+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;레즈경험
A = 4
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;依存度ベクトル
TFLAG:33 = 1

;依存度補正値(主人かつ恋慕、淫乱、服従で1。親愛、娼婦、隷属で2）
IF (TALENT:연모 || TALENT:음란 || TALENT:복종) && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF (TALENT:친애 || TALENT:창부 || TALENT:예속) && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF

;奉仕快楽フラグ
TFLAG:100 = 1


RETURN 1

@MESSAGE_COM197
;前回と今回の調教者が同じで、前回の調教が正常位であり、抜かないフラグがある場合
PRINTFORM %TARGET은% 벗어둔 
SELECTCASE TSTR:0
	CASE "スク水扱き","水着扱き"
		PRINT 수영복
	CASE "スパッツ扱き"
		PRINT 스패츠
	CASEELSE
		PRINT 속옷
ENDSELECT
IF TEQUIP:주도권 || 陥落()
	PRINTFORM 으로 %PLAYER의% 페니스
	SIF (TALENT:연모 || TALENT:친애)
		PRINTFORM 를 상냥하게 
	PRINTFORM 감싸 안더니, 그 부드러운 천으로 
	SIF TALENT:새드
		PRINTFORM 애태우듯이 
	;카테터
		SIF TEQUIP:43
		PRINTFORMW 요도에 카테터가 삽입된 상태 그대로, 
	;요도플러그
		SIF TEQUIP:44
		PRINTFORMW 요도 플러그가 삽입된 상태 그대로, 
	PRINTFORMW 문질러 올리기 시작했다……
ELSE
	PRINTFORM 를 %PLAYER의% 페니스에 씌우더니, 
	SIF TALENT:새드
		PRINTFORM 애태우듯이 
	;카테터
		SIF TEQUIP:43
		PRINTFORMW 요도에 카테터가 삽입된 상태 그대로, 
	;요도플러그
		SIF TEQUIP:44
		PRINTFORMW 요도 플러그가 삽입된 상태 그대로, 
	PRINTFORMW 문질러 올리기 시작했다……
ENDIF
;-------------------------------------------------
;実行判定処理
;手淫と同じ
;-------------------------------------------------
@COM_ORDER_197, ARG, ARG:1
CALL COM_ORDER_80, ARG, ARG:1
;-------------------------------------------------
;実行値
;-------------------------------------------------
@COM_ORDER_NUM_197
RETURN 14

;===================================================
;調教タイプ
;===================================================
@COMTYPE_197
RETURN COMTYPE("奉仕系")

