;-------------------------------------------------
;클리캡쓴다
;道具使用コマンド、レベル2
;촉수클리자극시킨다
;-------------------------------------------------
@CHECK_COM_ABLE50

;触手調教中はダメ
SIF TEQUIP:촉수
	RETURN 0

;アイテムを持っているか、アイテムなし設定でないとダメ
SIF !EXIST_ITEM(2)
	RETURN 0

;解除はいつでも可能
SIF TEQUIP:PLAYER:11
	RETURN 1


;小人体型持ちは、双方が調教者と調教対象ならOK
;それ以外の場合は主人が禁断の知識持ちじゃないとダメ
SIF TALENT:PLAYER:142 && PLAYER != MASTER && TALENT:MASTER:144 == 0
	RETURN 0

SIF !USE_CLI(PLAYER)
	RETURN 0

;シャワー中はダメ
SIF TEQUIP:32
	RETURN 0
RETURN 1

@CHECK_COM_ABLE172

;촉수클리자극
SIF TEQUIP:촉수 == 0
	RETURN 0

;オトコだとダメ
SIF !HAVE_CLITORIS(PLAYER)
	RETURN 0
RETURN 1

@ACT_COM50
;-------------------------------------------------
;特殊派生処理
;-------------------------------------------------
IF TEQUIP:촉수
	PRINTL 촉수클리자극시킨다
	TSTR:0 = 촉수클리자극시킨다
	SELECTCOM = 172
ELSE
	PRINTL 전동클리캡쓴다
	TSTR:0 = 전동클리캡쓴다
ENDIF
;CALL KOJO_MESSAGE_COM

;着脱の処理
IF TEQUIP:PLAYER:11 == 0
	TEQUIP:PLAYER:11 = 1
ELSE
	TEQUIP:PLAYER:11 = 0
ENDIF

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:체력 += 10
LOSEBASE:기력 += 10

SOURCE:TARGET:정애 = 10
SOURCE:TARGET:노출 = 10
SOURCE:TARGET:일탈 = 10

SOURCE:PLAYER:도구쾌Ｃ = 200


;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;触手クリ責めなら、触手体液がヴァギナに付く
SIF TEQUIP:촉수
	STAIN:PLAYER:3 |= 32

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
A = 1
IF IS_LESBIAN(TARGET,PLAYER)
;	PRINTFORML %EXPNAME:40%+{A}
;	PRINTFORML %EXPNAME:40%(調教者)+{A}
;	EXP:40 += A
;	EXP:PLAYER:40 += A
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
;	PRINTFORML %EXPNAME:41%+{A}
;	PRINTFORML %EXPNAME:41%(調教者)+{A}
;	EXP:41 += A
;	EXP:PLAYER:41 += A
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
	
	
ENDIF

;触手召喚時、触手経験のリセットをする
;SIF TEQUIP:촉수 == 1
;	T = 0

;依存度ベクトル
TFLAG:33 = 1


RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM50
IF TEQUIP:촉수
	PRINTL ＜촉수클리괴롭힘 중(조교자)＞
ELSE
	PRINTL ＜클리캡 장착 중(조교자)＞
ENDIF


;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------

SOURCE:PLAYER:도구쾌Ｃ += 100


;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;触手経験加算
SIF TEQUIP:촉수 == 1
	CALL ADDS_EXP("촉수경험", 1, PLAYER)
;	T += 1


RETURN 1

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
;50,클리캡쓴다
;-------------------------------------------------
@MESSAGE_COM50
;装着時
IF TEQUIP:PLAYER:11
	PRINTFORMW %CALLNAME:PLAYER%은(는) 자신에게 전동 클리캡을 장착했다
;解除時
ELSE
	PRINTFORMW %CALLNAME:PLAYER%은(는) 전동 클리캡을 뺐다
ENDIF

;-------------------------------------------------
;172,촉수클리자극시킨다
;-------------------------------------------------
@MESSAGE_COM172
;装着時
IF TEQUIP:PLAYER:11
	PRINTFORM 잘게 갈라진 촉수가, %CALLNAME:PLAYER%의 
	PRINTFORMW 클리토리스를 괴롭히기 시작했다……
;解除時
ELSE
	PRINTFORMW 촉수는 %CALLNAME:PLAYER%의 클리 괴롭힘을 중단했다
ENDIF

;===================================================
;調教タイプ
;===================================================
@COMTYPE_50
RETURN COMTYPE("対調教者道具系")

