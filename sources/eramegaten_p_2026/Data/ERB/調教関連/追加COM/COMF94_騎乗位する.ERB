
@CHECK_COM_ABLE94
;騎乗位する実行判定

;調教者のヴァギナが使えないとダメ
SIF !USE_VAGINA(PLAYER) 
	RETURN 0
	
;調教対象のペニスが使えないとダメ
SIF  !USE_PENIS(TARGET) && !USE_PBAND(TARGET)
	RETURN 0

;触手調教中はダメ
SIF TEQUIP:촉수
	RETURN 0

;三角木馬騎乗中はダメ
SIF TEQUIP:삼각목마
	RETURN 0

;お風呂場プレイ中はプレイマットが無いとダメ
IF TEQUIP:목욕탕
	SIF !EXIST_ITEM(20)
		RETURN 0
ENDIF

RETURN 1

@ACT_COM94
;기승위한다
PRINTL 기승위한다
TSTR:0 = 기승위한다
;実行できない



;-------------------------------------------------
;実行決定
;-------------------------------------------------
;CALL KOJO_MESSAGE_COM

;調教者←→調教対象
TFLAG:28 = 3
;-------------------------------------------------
;ソースの計算
;-------------------------------------------------
LOSEBASE:체력 += 35
LOSEBASE:기력 += 140

SOURCE:TARGET:쾌Ｃ = 450
SOURCE:TARGET:성행위 = 500
SOURCE:TARGET:정애 = 1000
SOURCE:TARGET:일탈 = 500
SOURCE:TARGET:반감 = 500
SIF IS_MALE(TARGET) && (TALENT:쾌감을부정 == 0 || ABL:욕망 > 2)
	SOURCE:TARGET:반감 /= 10

;調教者に快Ｖ
SOURCE:PLAYER:쾌Ｖ = 500

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 700
	
SIF (TALENT:PLAYER:처녀 == 1 || TALENT:PLAYER:재생처녀 == 1)
	TFLAG:31 = 1
	
;調教者が処女か再生処女（異常経験は一回のみ）
IF (TALENT:PLAYER:처녀 == 1 || TALENT:PLAYER:재생처녀 == 1)
	TIMES SOURCE:TARGET:노출 , 20.00
	TIMES SOURCE:TARGET:굴종 , 3.00
	PRINTFORM ＜%PLAYER는% 
	SIF TALENT:PLAYER:재생처녀 == 1
		PRINT 재생 
	PRINTL 처녀를 잃었습니다＞

	;異常経験追加
	SIF  !IS_MALE(TARGET)
		CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", TARGET)
	SIF TALENT:PLAYER:처녀
		CALL ADDS_ABNORMAL_EXP("処女喪失（騎乗位）", PLAYER)
	SIF !IS_MALE(TARGET)
		CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", PLAYER)
ENDIF
;-------------------------------------------------
;射精チェック
;-------------------------------------------------

;射精先タイプの設定
TEQUIP:PLAYER:Ｖ삽입자 = TARGET
TCVAR:TARGET:페니스사용대상 = PLAYER
TCVAR:TARGET:사정부위 = 1
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 0

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;膣内に破瓜の血の汚れを付加
SIF TALENT:PLAYER:처녀 == 1 || TALENT:PLAYER:재생처녀 == 1
	CALL SET_STAIN("질내", "破瓜の血", PLAYER)
;奴隷の膣内⇔調教者のＰの汚れが移動
CALL MOVE_STAIN("질내", TARGET, "페니스", PLAYER)

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;調教者のV経験
CALL ADDS_EXP("Ｖ경험", 1, PLAYER)
CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)
CALL ADDS_EXP("성교경험", 1, PLAYER)

;삽입경험
CALL ADDS_EXP("삽입경험", 1, TARGET)

;수간경험
IF (TALENT:TARGET:짐승 || TALENT:TARGET:새) && !(TALENT:PLAYER:짐승 || TALENT:PLAYER:새)
	CALL ADDS_EXP("수간경험", 1, PLAYER)
	
ENDIF
;処女で同性の場合異常経験
IF TALENT:PLAYER:처녀 && !IS_MALE(TARGET)
	CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", TARGET)
	CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", PLAYER)
ENDIF
;近親相姦の場合異常経験付与
IF 近親チェック(PLAYER , TARGET)
	CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:0%）", PLAYER)
	CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:1%）", TARGET)
ENDIF
;레즈경험
A = 4
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;依存度ベクトル
TFLAG:33 = 1

;依存度補正値(主人かつ恋慕、淫乱、服従で1。親愛、娼婦、隷属で2）
IF (TALENT:연모 || TALENT:음란 || TALENT:복종) && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF (TALENT:친애 || TALENT:창부 || TALENT:예속) && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF


RETURN 1


@MESSAGE_COM94
IF TEQUIP:주도권
	PRINTFORM %TARGET은% %PLAYER에게% 자신의 몸 위에 올라타게 하더니, 
	;「TARGETが真性のサドか」「サドっ気持ちか」で分岐
	IF (TALENT:새드 || ABL:새드끼 == 5 || TALENT:영맹) && RAND:3 == 0
		PRINTFORM 잘록한 허리를 꽉 쥐고 %PLAYER의% 몸을 끌어당겨, 
	ELSEIF TALENT:새드 || (ABL:새드끼 >= 4 && RAND:2 == 0) || TALENT:영맹
		PRINTFORM 허리를 쥐고 %PLAYER의% 몸을 끌어당겨 
	ELSEIF RAND:2 == 0
		PRINTFORM 천천히 %PLAYER의% 몸을 끌어당겨 
	ENDIF
	;「TARGETが真性のサドか」「サドっ気持ちか」で分岐
	IF (TALENT:새드 || ABL:새드끼 == 5 || TALENT:영맹) && RAND:3 == 0
		PRINT 페니스로 꿰뚫듯 찔러 넣고, 
	ELSEIF ABL:새드끼 >= 3 && RAND:2 == 0
		PRINT 단숨에 허리를 내리누르게 하여, 
	ELSE
		PRINTFORM 페니스를 삽입시키더니, 
	ENDIF
	;恋慕で追加
	SIF (TALENT:연모 || TALENT:친애) && RAND:3 >= 1
		PRINTFORM %PLAYER의% 이름을 몇 번이고 외치며 
	;「TARGETが真性のサドか」「サドっ気持ちか」で分岐
	IF (TALENT:새드 || ABL:새드끼 == 5 || TALENT:영맹) && RAND:3 == 0
		PRINTFORMW 밑에서 격렬하게 %PLAYER의% 몸을 쳐올렸다…
	ELSEIF TALENT:새드 || (ABL:새드끼 >= 3 && RAND:2 == 0) || TALENT:영맹
		PRINTFORMW 스스로도 허리를 부딪쳐왔다…
	ELSE
		PRINTFORMW %PLAYER의% 질내를 만끽했다…
	ENDIF
ELSE
	PRINTFORM %PLAYER는% %TARGET을% 바로 눕히고는, 스스로 
	;プレイヤーが淫乱
	SIF TALENT:PLAYER:음란
		PRINTFORM 크게 다리를 벌려 
	PRINTFORM 비열에 페니스를 대고, 
	SIF EXP:PLAYER:Ｖ경험 == 0
		PRINT 아직 남자를 받아들인 적 없는 
	PRINTFORMW 바기나로 물어 삼켰다…
ENDIF

;===================================================
;調教タイプ
;===================================================
@COMTYPE_94
RETURN COMTYPE("調教者奉仕系")


