@CHECK_COM_ABLE97
;アナル騎乗位する実行判定

;調教者のアヌスが使えないとダメ
SIF !USE_ANUS(PLAYER)
	RETURN 0

;調教対象のペニスが使えないとダメ
SIF !USE_PENIS(TARGET) && !USE_PBAND(TARGET)
	RETURN 0

;触手調教中はダメ
SIF TEQUIP:촉수
	RETURN 0

;三角木馬騎乗中はダメ
SIF TEQUIP:삼각목마
	RETURN 0

;お風呂場プレイ中はプレイマットが無いとダメ
IF TEQUIP:목욕탕
	SIF !EXIST_ITEM(20)
		RETURN 0
ENDIF

RETURN 1

@JUMP_COM97
;-------------------------------------------------
;特殊派生処理
;-------------------------------------------------
;前のプレイがアナル騎乗位するかつ対象の技巧3以上の場合、挿入前立腺責めさせるへ派生
SIF PREVCOM == 97 && (ABL:TARGET:기교 > 2)
	RETURN 520
RETURN -1

@ACT_COM97
;애널기승위한다

PRINTL 애널기승위한다
TSTR:0 = 애널기승위한다
;実行できない



;-------------------------------------------------
;実行決定
;-------------------------------------------------
;CALL KOJO_MESSAGE_COM

;調教者←→調教対象
TFLAG:28 = 3

;-------------------------------------------------
;射精ゲージチェック　●付け足し
;-------------------------------------------------
B = 1500

;ABL:調教対象の技巧をみる
IF ABL:TARGET:기교 == 0
	TIMES B , 1.00
ELSEIF ABL:TARGET:기교 == 1
	TIMES B , 1.20
ELSEIF ABL:TARGET:기교 == 2
	TIMES B , 1.40
ELSEIF ABL:TARGET:기교 == 3
	TIMES B , 1.60
ELSEIF ABL:TARGET:기교 == 4
	TIMES B , 1.80
ELSE
	TIMES B , 2.00
ENDIF

;ABL:従順をみる
IF ABL:순종 == 0
	TIMES B , 0.80
ELSEIF ABL:순종 == 1
	TIMES B , 0.90
ELSEIF ABL:순종 == 2
	TIMES B , 1.00
ELSEIF ABL:순종 == 3
	TIMES B , 1.10
ELSEIF ABL:순종 == 4
	TIMES B , 1.20
ELSE
	TIMES B , 1.30
ENDIF

;ABL:欲望をみる
IF ABL:욕망 == 0
	TIMES B , 1.00
ELSEIF ABL:욕망 == 1
	TIMES B , 1.10
ELSEIF ABL:욕망 == 2
	TIMES B , 1.20
ELSEIF ABL:욕망 == 3
	TIMES B , 1.30
ELSEIF ABL:욕망 == 4
	TIMES B , 1.40
ELSE
	TIMES B , 1.50
ENDIF

;PALAM:潤滑をみる
IF PALAM:윤활 < PALAMLV:1
	TIMES B , 0.60
ELSEIF PALAM:윤활 < PALAMLV:2
	TIMES B , 0.80
ELSEIF PALAM:윤활 < PALAMLV:3
	TIMES B , 1.00
ELSEIF PALAM:윤활 < PALAMLV:4
	TIMES B , 1.20
ELSEIF PALAM:윤활 >= PALAMLV:4
	TIMES B , 1.40
ENDIF

;調教対象のABL:Ｃ感覚をみる
IF ABL:TARGET:Ｃ감각 == 0
	TIMES B , 1.00
ELSEIF ABL:TARGET:Ｃ감각 == 1
	TIMES B , 1.50
ELSEIF ABL:TARGET:Ｃ감각 == 2
	TIMES B , 2.00
ELSEIF ABL:TARGET:Ｃ감각 == 3
	TIMES B , 2.50
ELSEIF ABL:TARGET:Ｃ감각 == 4
	TIMES B , 3.50
ELSE
	TIMES B , 5.00
ENDIF

;;再装填処理中は射精ゲージは20分の1に
;SIF CFLAG:PLAYER:射精ゲージ再装填 > 0
;	B /= 20


SIF HAVE_PENIS(PLAYER)
	BASE:PLAYER:사정 += B

;調教対象→調教者
TFLAG:28 = 1
TEQUIP:PLAYER:Ａ삽입자 = TARGET
TFLAG:삽입속행 = 1

;-------------------------------------------------
;ソースの計算
;-------------------------------------------------
LOSEBASE:체력 += 50
LOSEBASE:기력 += 200

SOURCE:TARGET:쾌Ｃ = 450
SOURCE:TARGET:성행위 = 500
SOURCE:TARGET:정애 = 1000
SOURCE:TARGET:일탈 = 500
SOURCE:TARGET:불결 = 750
SOURCE:TARGET:반감 = 500
SIF IS_MALE(TARGET) && (TALENT:쾌감을부정 == 0 || ABL:욕망 > 2) && !IS_LOOKSLIKE_MALE(PLAYER)
	SOURCE:TARGET:반감 /= 10

;調教者に快Ａ
SOURCE:PLAYER:쾌Ａ = 400

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 700
;-------------------------------------------------
;射精チェック
;-------------------------------------------------

;射精先タイプの設定
TCVAR:TARGET:페니스사용대상 = PLAYER
TCVAR:TARGET:사정부위 = 2
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 0


;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;調教者のＡ⇔奴隷のＰの汚れが移動
CALL MOVE_STAIN("애널", PLAYER, "페니스", TARGET)

;-------------------------------------------------
;吸精処理
;-------------------------------------------------
IF CFLAG:PLAYER:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,PLAYER,LOCAL,TARGET
ELSEIF CFLAG:TARGET:ＭＡＧ비피흡수 == 0
	LOCAL = (RAND:10+1) * BASE:LV
	CALL DRAIN_MAG,TARGET,LOCAL,PLAYER
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;調教者のＡ経験
CALL ADDS_EXP("Ａ경험", 1, PLAYER)

CALL ADDS_EXP("봉사쾌락경험", 1, PLAYER)
CALL ADDS_EXP("성교경험", 1, PLAYER)
;수간경험
IF (TALENT:TARGET:짐승 || TALENT:TARGET:새) && !(TALENT:PLAYER:짐승 || TALENT:PLAYER:새)
	CALL ADDS_EXP("수간경험", 1, PLAYER)
ENDIF
;레즈경험
A = 4
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF

;依存度ベクトル
TFLAG:33 = 3

;依存度補正値(主人かつ恋慕、淫乱、服従で1。親愛、娼婦、隷属で2）
IF (TALENT:연모 || TALENT:음란 || TALENT:복종) && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF (TALENT:친애 || TALENT:창부 || TALENT:예속) && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF


RETURN 1


@MESSAGE_COM97
	;前回の調教がアナル騎乗位するであり、入れっぱなしの場合
	IF TEQUIP:주도권 && TEQUIP:PLAYER:Ａ섹스 && (PREVCOM == 97 || PREVCOM == 520)
		PRINTFORMW 아누스를 꿰뚫은 채 %TARGET은% %PLAYER의% 다리를 억누르고, 다시 움직이라고 명령했다……
	;同様に前回の調教がアナル正常位かアナル後背位の場合
	ELSEIF TEQUIP:주도권 && TEQUIP:PLAYER:Ａ섹스 && (PREVCOM == 95 || PREVCOM == 96)
		PRINTFORMW %TARGET은% 삽입한 채 %PLAYER를% 안아 올리고, 바로 누우며 밑에서 허리를 쳐올렸다……
	;同様に前回の調教がアナル対面座位かアナル背面座位の場合
	ELSEIF TEQUIP:주도권 && TEQUIP:PLAYER:Ａ섹스 && (PREVCOM == 902 || PREVCOM == 903)
		PRINTFORMW %TARGET은% 삽입한 채 바로 눕더니, %PLAYER를% 밑에서 허리로 쳐올렸다……	
	ELSEIF TEQUIP:주도권
		PRINTFORM %TARGET은% %PLAYER에게% 자신의 몸 위에 올라타게 하더니, 
		;「TARGETが真性のサドか」「サドっ気持ちか」で分岐
		IF (TALENT:새드 || ABL:새드끼 == 5 || TALENT:영맹) && RAND:3 == 0
			PRINTFORM 잘록한 허리를 꽉 쥐고 %PLAYER의% 몸을 끌어당겨, 
		ELSEIF TALENT:새드 || (ABL:새드끼 >= 4 && RAND:2 == 0) || TALENT:영맹
			PRINTFORM 허리를 쥐고 %PLAYER의% 몸을 끌어당겨 
		ELSEIF RAND:2 == 0
			PRINTFORM 천천히 %PLAYER의% 몸을 끌어당겨 
		ENDIF
		;「TARGETが真性のサドか」「サドっ気持ちか」で分岐
		IF (TALENT:새드 || ABL:새드끼 == 5 || TALENT:영맹) && RAND:3 == 0
			PRINT 페니스로 꿰뚫듯 찔러 넣고, 
		ELSEIF ABL:새드끼 >= 3 && RAND:2 == 0 || TALENT:영맹
			PRINT 단숨에 허리를 내리누르게 하여, 
		ELSE
			PRINTFORM 페니스를 삽입시키더니, 
		ENDIF
		;恋慕で追加
		SIF (TALENT:연모 || TALENT:친애) && RAND:3 >= 1
			PRINTFORM %PLAYER의% 이름을 몇 번이고 외치며 
		;「TARGETが真性のサドか」「サドっ気持ちか」で分岐
		IF (TALENT:새드 || ABL:새드끼 == 5 || TALENT:영맹) && RAND:3 == 0
			PRINTFORMW 밑에서 격렬하게 %PLAYER의% 몸을 쳐올렸다…
		ELSEIF TALENT:새드 || (ABL:새드끼 >= 3 && RAND:2 == 0) || TALENT:영맹
			PRINTFORMW 스스로도 허리를 부딪쳐왔다…
		ELSE
			PRINTFORMW %PLAYER의% 엉덩이 구멍을 만끽했다…
		ENDIF
	;前回の調教がアナル騎乗位するであり、抜かないフラグがある場合
	ELSEIF TEQUIP:PLAYER:Ａ섹스 && (PREVCOM == 97 || PREVCOM == 520)
		PRINTFORMW %PLAYER는% 삽입된 채인 물건을 조이며, 다시 허리를 움직이기 시작했다……
	;同様に前回の調教がアナル正常位かアナル後背位かアナル対面座位かアナル背面座位の場合
	ELSEIF TEQUIP:PLAYER:Ａ섹스 && (PREVCOM == 95 || PREVCOM == 96 || PREVCOM == 902 || PREVCOM == 903)
		PRINTFORMW %TARGET이% 삽입한 채 바로 드러눕자, %PLAYER는% 다시 허리를 움직이기 시작했다……
	ELSE
		PRINTFORM %PLAYER는% %TARGET을% 바로 눕히고는, 스스로 
		;プレイヤーが淫乱
		SIF ABL:PLAYER:욕망 > 3
			PRINTFORM 과시하듯 다리를 벌리더니, 
		SIF ABL:PLAYER:Ａ감각 > 3
			PRINT 아쉬운 듯 옴찔거리는 
		PRINTFORMW 아누스로 페니스를 물고, 허리를 흔들기 시작했다…
	ENDIF

;===================================================
;調教タイプ
;===================================================
@COMTYPE_97
RETURN COMTYPE("調教者奉仕系")


