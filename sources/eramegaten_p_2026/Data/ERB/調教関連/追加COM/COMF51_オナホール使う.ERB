;-------------------------------------------------
;오나홀쓴다
;道具使用コマンド、レベル2
;촉수페니스자극시킨다
;-------------------------------------------------
@CHECK_COM_ABLE51

;オナホール実行判定
;触手調教中はダメ
SIF TEQUIP:촉수
	RETURN 0

;解除はいつでも可能
SIF TEQUIP:PLAYER:12
	RETURN 1

;アイテムを持っているか、アイテムなし設定でないとダメ
SIF !EXIST_ITEM(3)
	RETURN 0


;小人体型持ちは、双方が調教者と調教対象ならOK
;それ以外の場合は主人が禁断の知識持ちじゃないとダメ
SIF TALENT:PLAYER:142 && PLAYER != MASTER && TALENT:MASTER:144 == 0
	RETURN 0

SIF !USE_PENIS(PLAYER)
	RETURN 0

;新妻プレイ中はダメ
SIF TEQUIP:33
	RETURN 0
RETURN 1

@CHECK_COM_ABLE175

;촉수페니스자극
SIF TEQUIP:촉수 == 0
	RETURN 0

;オトコかふたなりじゃないとダメ
SIF !HAVE_PENIS(PLAYER)
	RETURN 0
RETURN 1

@ACT_COM51
;-------------------------------------------------
;特殊派生処理
;-------------------------------------------------
IF TEQUIP:촉수
	PRINTL 촉수페니스자극시킨다
	TSTR:0 = 촉수페니스자극시킨다
	SELECTCOM = 175
ELSE
	PRINTL 오나홀쓴다
	TSTR:0 = 오나홀쓴다
ENDIF
;CALL KOJO_MESSAGE_COM

;着脱の処理
IF TEQUIP:PLAYER:12 == 0
	TEQUIP:PLAYER:12 = 1
ELSE
	TEQUIP:PLAYER:12 = 0
ENDIF

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:체력 += 10
LOSEBASE:기력 += 10

SOURCE:TARGET:정애 = 10
SOURCE:TARGET:노출 = 10
SOURCE:TARGET:일탈 = 10

SOURCE:PLAYER:도구쾌Ｃ = 200
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
;SIF TALENT:억압 || TALENT:저항
;	SOURCE:TARGET:울굴 += 30

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;触手ペニス責めなら、触手体液がペニスに付く
SIF TEQUIP:촉수
	CALL SET_STAIN("페니스", "粘液", PLAYER)

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
A = 1
IF IS_LESBIAN(TARGET,PLAYER)
;	PRINTFORML %EXPNAME:40%+{A}
;	PRINTFORML %EXPNAME:40%(調教者)+{A}
;	EXP:40 += A
;	EXP:PLAYER:40 += A
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
;	PRINTFORML %EXPNAME:41%+{A}
;	PRINTFORML %EXPNAME:41%(調教者)+{A}
;	EXP:41 += A
;	EXP:PLAYER:41 += A
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
	
	
ENDIF

;触手召喚時、触手経験のリセットをする
;SIF TEQUIP:촉수 == 1
;	T = 0

;依存度ベクトル
TFLAG:33 = 1


RETURN 1

;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM51
;オナホール装備中
IF TEQUIP:촉수
	PRINTL ＜촉수페니스괴롭힘 중(조교자)＞
ELSE
	PRINTL ＜오나홀 장착 중(조교자)＞
ENDIF
;-------------------------------------------------
;射精ゲージチェック
;-------------------------------------------------
B = 1500

;プレイヤーのABL:Ｃ感覚をみる
B *= 100 + ABL:PLAYER:Ｃ감각*((ABL:PLAYER:Ｃ감각+1)/2) * 25
B /= 100

;;再装填処理中は射精ゲージは20分の1に
;SIF CFLAG:PLAYER:射精ゲージ再装填 > 0
;	B /= 20
SIF HAVE_PENIS(PLAYER)
	BASE:PLAYER:사정 += B
;-------------------------------------------------
;射精チェック
;-------------------------------------------------
;射精先タイプの設定
TCVAR:PLAYER:페니스사용대상 = -1
TCVAR:PLAYER:사정부위 = -1
;射精先選択の可・不可
TFLAG:사정대상선택가능 = 0


;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------

SOURCE:PLAYER:도구쾌Ｃ += 100
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;触手経験加算
SIF TEQUIP:촉수 == 1
	CALL ADDS_EXP("촉수경험", 1, PLAYER)
;	T += 1


RETURN 1

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
;51,오나홀쓴다
;-------------------------------------------------
@MESSAGE_COM51
;装着時
IF TEQUIP:PLAYER:12
	PRINTFORMW %CALLNAME:PLAYER%은(는) 페니스를 오나홀에 삽입했다
;解除時
ELSE
	PRINTFORMW %CALLNAME:PLAYER%은(는) 오나홀을 뺐다
ENDIF

;-------------------------------------------------
;175,촉수페니스자극시킨다
;-------------------------------------------------
@MESSAGE_COM175
;装着時
IF TEQUIP:PLAYER:12
	PRINTFORM 음란하게 고깃주름을 꿈틀거리는 촉수가 %CALLNAME:PLAYER%의 
	;汚れ分岐
	IF  GROUPMATCH(1, GET_STAIN("페니스", "愛液", TARGET), GET_STAIN("페니스", "모유", TARGET), GET_STAIN("페니스", "精液", TARGET), GET_STAIN("페니스", "破瓜の血", TARGET)) > 2
		PRINT 온갖 체액으로 범벅이 된 
	ELSEIF GET_STAIN("페니스", "愛液", PLAYER)
		PRINT 애액으로 범벅이 된 
	ELSEIF GET_STAIN("손", "精液", PLAYER)
		PRINT 정액으로 끈적해진 
	;セックス系を直前にしていないなら乱数分岐
	ELSEIF RAND:3 == 0
		PRINT 바짝 발기한 
	ELSEIF TEQUIP:PLAYER:속옷（하） == 620
		PRINT 피어싱이 음란하게 빛나는 
	ELSE
		PRINT 
	ENDIF
	PRINTFORMW 페니스를 휘감고, 문지르기 시작했다
;解除時
ELSE
	PRINTFORMW 촉수는 %CALLNAME:PLAYER%의 페니스를 해방했다
ENDIF

;===================================================
;調教タイプ
;===================================================
@COMTYPE_51
RETURN COMTYPE("対調教者道具系")

