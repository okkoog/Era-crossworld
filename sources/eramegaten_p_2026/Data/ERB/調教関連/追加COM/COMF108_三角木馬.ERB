;-------------------------------------------------
;삼각목마
;-------------------------------------------------
@CHECK_COM_ABLE108
;解除はいつでも可能
SIF TEQUIP:TARGET:삼각목마
	RETURN 1
;縛ってないとダメ
SIF !TEQUIP:TARGET:밧줄
	RETURN 0
;服従か隷属でないとダメ
SIF !TALENT:TARGET:복종 && !TALENT:TARGET:예속
	RETURN 0
;調教者がサドっ気LV3以上かサド持ちでないとダメ
SIF ABL:PLAYER:새드끼 < 3 && TALENT:PLAYER:새드 == 0
	RETURN 0
SIF !EXIST_ITEM(27)
	RETURN 0
;Cがあいてないとダメ
SIF !USE_CLI(TARGET)
	RETURN 0
;Aがあいてないとダメ
SIF !USE_ANUS(TARGET)
	RETURN 0
;Vがあいてないとダメ
SIF !USE_VAGINA(TARGET)
	RETURN 0
;お風呂場プレイ中はダメ
SIF TEQUIP:목욕탕
	RETURN 0
;野外プレイ中はダメ
SIF TEQUIP:촉수
	RETURN 0
;触手調教中はダメ
SIF TEQUIP:촉수
	RETURN 0
RETURN 1

@ACT_COM108
PRINTL 삼각목마
TSTR:0 = 삼각목마
;CALL KOJO_MESSAGE_COM
INVERTBIT TEQUIP:삼각목마 , 0
DOWNBASE:TARGET:체력 += 400
DOWNBASE:TARGET:기력 += 600

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
SIF HAVE_VAGINA(TARGET)
	SOURCE:TARGET:도구쾌Ｖ = 300
SOURCE:TARGET:도구쾌Ａ = 300
SOURCE:TARGET:아픔 = 1500
SOURCE:TARGET:일탈 = 600
SOURCE:TARGET:노출 = 200
SOURCE:TARGET:반감 = 1500
SOURCE:TARGET:굴종 = 600
SOURCE:TARGET:무서움 = 600
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;苦痛のパラメータによる苦痛のソース増加は先に処理しておく
IF PALAM:10 < PALAMLV:1
	TIMES SOURCE:TARGET:아픔 , 1.00
ELSEIF PALAM:10 < PALAMLV:2
	TIMES SOURCE:TARGET:아픔 , 1.50
ELSEIF PALAM:10 < PALAMLV:3
	TIMES SOURCE:TARGET:아픔 , 2.00
ELSEIF PALAM:10 < PALAMLV:4
	TIMES SOURCE:TARGET:아픔 , 2.50
ELSEIF PALAM:10 >= PALAMLV:4
	TIMES SOURCE:TARGET:아픔 , 3.00
ENDIF
;再生処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:재생처녀 == 1
	SOURCE:TARGET:아픔 += 500
	SOURCE:TARGET:반감 += 1000
ENDIF

;V経験
IF HAVE_VAGINA(TARGET)
	CALL ADDS_EXP("Ｖ경험", 1, TARGET)
	TFLAG:V경험을수반하는커맨드 = 1
ENDIF
;A経験
CALL ADDS_EXP("Ａ경험", 1, TARGET)

;이상경험
SIF TALENT:TARGET:처녀 == 1
	CALL ADDS_ABNORMAL_EXP("処女喪失（三角木馬）", TARGET)

IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", 3, TARGET)
	CALL ADDS_EXP("레즈경험", 3, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", 3, TARGET)
	CALL ADDS_EXP("ＢＬ경험", 3, PLAYER)
ENDIF

;依存度ベクトル
TFLAG:33 = 5

;依存度補正値(服従で1、隷属で2）
IF TALENT:복종 && ASSIPLAY == 0
	TFLAG:30 += 1
ELSEIF TALENT:예속 && ASSIPLAY == 0
	TFLAG:30 += 2
ENDIF

TFLAG:28 = 5
RETURN 1

;-------------------------------------------------
;三角木馬乗馬中
;-------------------------------------------------
@EQUIP_COM108
PRINTL ＜삼각목마 탑승 중＞
DOWNBASE:TARGET:체력 += 250
DOWNBASE:TARGET:기력 += 300
SIF HAVE_VAGINA(TARGET)
	SOURCE:TARGET:도구쾌Ｖ += 300
SOURCE:TARGET:도구쾌Ａ += 300
SOURCE:TARGET:아픔 += 1500
SOURCE:TARGET:일탈 += 600
SOURCE:TARGET:노출 += 200
SOURCE:TARGET:반감 += 1500
SOURCE:TARGET:굴종 += 600
SOURCE:TARGET:무서움 += 600
;V経験
SIF TALENT:남자 == 0
	CALL ADDS_EXP("Ｖ경험", 1, TARGET)

;A経験
CALL ADDS_EXP("Ａ경험", 1, TARGET)

A = 1
IF IS_LESBIAN(TARGET,PLAYER)
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
ENDIF
;調教者→調教対象
TFLAG:28 = 2
RETURN 1

;--------------------------------------------------
;調教時メッセージ
;--------------------------------------------------
@MESSAGE_COM108
PRINTL 
;装着時
IF TEQUIP:TARGET:삼각목마
	PRINTFORM %CALLNAME:TARGET%을(를) 목마에 태우자, 
	IF ABL:마조끼 >= 5 || TALENT:마조
		PRINTL 비명인지 교성인지 알 수 없는 소리를 내질렀다……
	ELSE
		PRINTL 극심한 고통에 목멘 소리를 내질렀다……
	ENDIF
;解除時
ELSE
	PRINTFORM %CALLNAME:TARGET%을(를) 목마에서 내려주자, 
	IF ABL:마조끼 >= 5 || TALENT:마조
		PRINTL 조금 아쉬운 듯한 얼굴을 하고 있었다……
	ELSE
		PRINTL 안도한 듯한 표정을 지었다……
	ENDIF
ENDIF

;===================================================
;調教タイプ
;===================================================
@COMTYPE_108
RETURN COMTYPE("ハード系")

