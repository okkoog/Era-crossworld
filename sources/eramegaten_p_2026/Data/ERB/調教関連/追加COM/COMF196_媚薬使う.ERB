;-------------------------------------------------
;미약
;特殊コマンド
;-------------------------------------------------

@CHECK_COM_ABLE196

;媚薬実行判定
;アイテムを持っているか、アイテムなし設定か触手調教中でないとダメ
SIF !EXIST_ITEM(41) && TEQUIP:촉수 == 0
	RETURN 0

;薬毒耐性だとダメ
SIF TALENT:PLAYER:56
	RETURN 0
RETURN 1

@ACT_COM196
PRINTL 미약쓴다
TSTR:0 = 미약쓴다
;CALL KOJO_MESSAGE_COM

SIF TEQUIP:촉수 == 0
	ITEM:41 -= 1

TEQUIP:PLAYER:26 = 1

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:체력 += 10
LOSEBASE:기력 += 10

SOURCE:TARGET:정애 = 10
SOURCE:TARGET:노출 = 10
SOURCE:TARGET:일탈 = 10

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
A = 1
IF IS_LESBIAN(TARGET,PLAYER)
;	PRINTFORML %EXPNAME:40%+{A}
;	PRINTFORML %EXPNAME:40%(調教者)+{A}
;	EXP:40 += A
;	EXP:PLAYER:40 += A
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
;	PRINTFORML %EXPNAME:41%+{A}
;	PRINTFORML %EXPNAME:41%(調教者)+{A}
;	EXP:41 += A
;	EXP:PLAYER:41 += A
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
	
	
ENDIF

;依存度ベクトル
TFLAG:33 = 0


RETURN 1

@MESSAGE_COM196
;触手召喚中
IF TEQUIP:촉수
	PRINTFORML 최음 효과가 있는 액체가 촉수에서 배어나왔다
ELSE
	PRINTFORML %CALLNAME:PLAYER%은(는) 미약을 마셨다
ENDIF
PRINTFORMW %CALLNAME:PLAYER%은(는) 거친 숨을 내쉬며 피부를 붉히고 있다……

;===================================================
;調教タイプ
;===================================================
@COMTYPE_196
RETURN COMTYPE("対調教者道具系")

