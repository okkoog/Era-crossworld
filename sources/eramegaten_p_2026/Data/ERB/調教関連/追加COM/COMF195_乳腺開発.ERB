@CHECK_COM_ABLE195
;オトコだとダメ
SIF TALENT:남자
	RETURN 0
;母乳体質じゃダメ
SIF TALENT:모유체질
	RETURN 0
;調教者の技巧が4以上じゃないとダメ
SIF ABL:PLAYER:기교 < 4
	RETURN 0
;ニプルキャップ使用中は不可
SIF TEQUIP:16
	RETURN 0
;搾乳器使用中は不可
SIF TEQUIP:17
	RETURN 0
;乳房電極装着中はダメ
SIF TEQUIP:24
	RETURN 0
;縄使用中は不可
SIF TEQUIP:밧줄
	RETURN 0
;胸が露出してないとダメ
SIF TEQUIP:유방노출 != -1
	RETURN 0
;胸が露出してないとダメ
SIF TEQUIP:유두노출 != -1
	RETURN 0
;触手調教中はダメ
SIF TEQUIP:촉수
	RETURN 0
RETURN 1

;-------------------------------------------------
;유선개발
;特殊コマンド
;-------------------------------------------------
@ACT_COM195
PRINTL 유선개발
TSTR:0 = 유선개발
;-------------------------------------------------
;実行判定処理
;-------------------------------------------------

;-------------------------------------------------
;実行決定
;-------------------------------------------------
IF ABL:PLAYER:기교 >= 5 || ABL:순종 >= 5
	IF TALENT:Ｂ민감
		TFLAG:유선개발실패 = RAND:2
	ELSEIF TALENT:Ｂ둔감
		TFLAG:유선개발실패 = RAND:6
	ELSE
		TFLAG:유선개발실패 = RAND:4
	ENDIF
	SIF TALENT:음유 && A > 0
		TFLAG:유선개발실패 = RAND:2
ELSE
	TFLAG:유선개발실패 = RAND:8
ENDIF
SIF ITEM:14 && (TALENT:PLAYER:새드 || ABL:PLAYER:새드끼 > 2) && TFLAG:유선개발실패 > 0
	TFLAG:유선개발실패 -= 1

;CALL KOJO_MESSAGE_COM
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
;消費体力、気力
LOSEBASE:체력 += 500
LOSEBASE:기력 += 3000

IF ABL:PLAYER:기교 == 4
	SOURCE:아픔 = 5000
ELSEIF ABL:PLAYER:기교 >= 5
	SOURCE:아픔 = 2000
ENDIF

;ABL:従順をみる
IF ABL:순종 == 0
	SOURCE:일탈 = 10000
ELSEIF ABL:순종 == 1
	SOURCE:일탈 = 8000
ELSEIF ABL:순종 == 2
	SOURCE:일탈 = 6000
ELSEIF ABL:순종 == 3
	SOURCE:일탈 = 4000
ELSEIF ABL:순종 == 4
	SOURCE:일탈 = 2000
ELSE
	SOURCE:일탈 = 500
ENDIF

;음유
SIF TALENT:음유
	SOURCE:욕정 = 300

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------

IF TFLAG:유선개발실패 == 0 && TALENT:절벽 == 0
	TALENT:모유체질 = 1
	MAXBASE:모유 = 10000
;		PRINTL 이상경험＋1
;		EXP:50 += 1
	CALL ADDS_ABNORMAL_EXP("乳腺開発", TARGET)
ENDIF

IF TALENT:남자 == 0 && TALENT:PLAYER:남자 == 0
	PRINTFORML %EXPNAME:40%＋2
	EXP:40 += 2
ELSEIF TALENT:남자 && TALENT:PLAYER:남자
	PRINTFORML %EXPNAME:41%＋2
	EXP:41 += 2
ENDIF


RETURN 1

;--------------------------------------------------
;調教時メッセージ
;--------------------------------------------------
@MESSAGE_COM195

PRINTL 
PRINTFORM %CALLNAME:PLAYER%은(는) 
SIF ITEM:14 && (TALENT:PLAYER:새드 || ABL:PLAYER:새드끼 > 2)
	PRINTFORM %ITEMNAME:14%을(를) 사용해 
PRINTFORMW %CALLNAME:TARGET%의 유선을 개발하여, 모유가 나오도록 하려 했다
PRINTL 
IF TALENT:절벽
	PRINTFORML 하지만 %CALLNAME:TARGET%의 유선을 개발하기에는
	PRINTW 지금의 가슴 크기로는 조금 무리가 있는 모양이다……
ELSEIF TFLAG:유선개발실패 == 0
	PRINTFORMW 혈자리를 자극받는 동안 %CALLNAME:TARGET%의 유선에서 모유가 흘러나오게 되었다
ELSE
	PRINTFORMW 기교가 부족한 탓인지, %CALLNAME:TARGET%의 유선을 완전히 개발하지는 못했다……
ENDIF

;===================================================
;調教タイプ
;===================================================
@COMTYPE_195
RETURN COMTYPE("特殊コマンド系")



