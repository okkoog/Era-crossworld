;手淫実行判定
;オナホ着けている時は出来る
IF TEQUIP:12 > 0
	RETURN 1
ENDIF
SIF !USE_PENIS(TARGET,3)
	RETURN 0
SIF !USE_HAND(PLAYER)
	RETURN 0
;下半身下着をつけている、スカート以外の下半身上着を履いている、下の空いてない全身上着を着ているとダメ
SIF TEQUIP:음순노출 != -1
	RETURN 0
;触手調教中はダメ
SIF TEQUIP:촉수
	RETURN 0
;三角木馬騎乗中はダメ
SIF TEQUIP:삼각목마
	RETURN 0
RETURN 1

@ACT_COM90
;수음한다

IF TEQUIP:12
	PRINTL 오나홀대딸
	TSTR:0 = 오나홀대딸
ELSE
	PRINTL 수음한다
	TSTR:0 = 수음한다
ENDIF

;-------------------------------------------------
;実行決定
;-------------------------------------------------

;CALL KOJO_MESSAGE_COM
;調教者→調教対象
TFLAG:28 = 2
TCVAR:TARGET:페니스사용대상 = PLAYER
TCVAR:TARGET:사정부위 = 3
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
;消費体力、気力
LOSEBASE:체력 += 5
LOSEBASE:기력 += 50

SOURCE:TARGET:쾌Ｃ = 80
SOURCE:TARGET:노출 = 15
SOURCE:TARGET:일탈 = 15
SOURCE:TARGET:반감 = 20

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 20


;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;調教者の指⇔奴隷のＰの汚れが移動
IF HAVE_PENIS(TARGET)
	CALL MOVE_STAIN("손", TARGET, "페니스", PLAYER)
;奴隷の指⇔調教者のＶの汚れが移動
ELSE
	CALL MOVE_STAIN("손", TARGET, "바기나", PLAYER)
ENDIF

;調教者がふたなり
IF TALENT:PLAYER:후타나리
	SOURCE:TARGET:굴종 /= 2
ENDIF

;依存度ベクトル
IF TALENT:PLAYER:140 == 1
	TFLAG:33 = 3
ELSE
	TFLAG:33 = 2
ENDIF

RETURN 1


