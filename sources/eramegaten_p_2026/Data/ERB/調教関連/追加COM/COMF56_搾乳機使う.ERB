;-------------------------------------------------
;착유기쓴다
;道具使用コマンド、レベル3
;촉수착유시킨다
;-------------------------------------------------
@CHECK_COM_ABLE56

;搾乳器実行判定
;触手調教中はダメ
SIF TEQUIP:촉수
	RETURN 0

;解除はいつでも可能
SIF TEQUIP:PLAYER:17
	RETURN 1

;小人体型持ちは、双方が調教者と調教対象ならOK
;それ以外の場合は主人が禁断の知識持ちじゃないとダメ
SIF TALENT:PLAYER:소인체형 && PLAYER != MASTER && TALENT:MASTER:144 == 0
	RETURN 0

;アイテムを持っているか、アイテムなし設定でないとダメ
SIF !EXIST_ITEM(11)
	RETURN 0

;母乳体質でないと使えない
SIF TALENT:PLAYER:149 == 0
	RETURN 0

;上半身下着または上半身上着または全身上着をつけているとダメ
SIF TEQUIP:PLAYER:유두노출 != -1
	RETURN 0

SIF !USE_NIPLE(PLAYER)
	RETURN 0

;Ｂ感度2以下はダメ
SIF ABL:PLAYER:6 <= 2
	RETURN 0

;シャワー中はダメ
SIF TEQUIP:32
	RETURN 0

;新妻プレイ中はダメ
SIF TEQUIP:33
	RETURN 0
RETURN 1

@CHECK_COM_ABLE174

;촉수착유
SIF TEQUIP:촉수 == 0
	RETURN 0

;触手乳首責め中は不可
SIF TEQUIP:PLAYER:16
	RETURN 0

RETURN 1

@ACT_COM56

IF TEQUIP:촉수
	PRINTL 촉수착유시킨다
	TSTR:0 = 촉수착유시킨다
	SELECTCOM = 174
ELSE
	PRINTL 착유기쓴다
	TSTR:0 = 착유기쓴다
ENDIF
;CALL KOJO_MESSAGE_COM

;着脱の処理
IF TEQUIP:PLAYER:17 == 0
	TEQUIP:PLAYER:17 = 1
ELSE
	TEQUIP:PLAYER:17 = 0
ENDIF

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:체력 += 10
LOSEBASE:기력 += 10

SOURCE:TARGET:정애 = 10
SOURCE:TARGET:노출 = 10
SOURCE:TARGET:일탈 = 10

SOURCE:PLAYER:도구쾌Ｂ = 200


;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;触手搾乳なら、触手体液が胸に付く
SIF TEQUIP:촉수
	CALL SET_STAIN("가슴", "粘液", PLAYER)

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
A = 1
IF IS_LESBIAN(TARGET,PLAYER)
;	PRINTFORML %EXPNAME:40%+{A}
;	PRINTFORML %EXPNAME:40%(調教者)+{A}
;	EXP:40 += A
;	EXP:PLAYER:40 += A
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
;	PRINTFORML %EXPNAME:41%+{A}
;	PRINTFORML %EXPNAME:41%(調教者)+{A}
;	EXP:41 += A
;	EXP:PLAYER:41 += A
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
	
	
ENDIF

;触手召喚時、触手経験のリセットをする
;SIF TEQUIP:촉수 == 1
;	T = 0

;依存度ベクトル
TFLAG:33 = 0


RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM56
;搾乳器装備中
IF TEQUIP:촉수
	PRINTL ＜촉수착유 중(조교자)＞
ELSE
	PRINTL ＜착유기 장착 중(조교자)＞
ENDIF

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
SOURCE:PLAYER:도구쾌Ｂ += 100
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;触手経験加算
SIF TEQUIP:촉수 == 1
	CALL ADDS_EXP("촉수경험", 1, PLAYER)
;	T += 1


RETURN 1

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
;56,착유기쓴다
;-------------------------------------------------
@MESSAGE_COM56
;装着時
IF TEQUIP:PLAYER:17
	PRINTFORMW %CALLNAME:PLAYER%에게 착유기를 달았다
;解除時
ELSE
	PRINTFORMW %CALLNAME:PLAYER%에게서 착유기를 떼어냈다
ENDIF

;-------------------------------------------------
;174,촉수착유시킨다
;-------------------------------------------------
@MESSAGE_COM174
;装着時
IF TEQUIP:PLAYER:17
	PRINTFORM 빨판 형태의 촉수가 %CALLNAME:PLAYER%의 
	;유아체형＋貧乳、絶壁
	IF (TALENT:PLAYER:유아체형 && TALENT:PLAYER:빈유) || TALENT:PLAYER:절벽
		PRINT 겨우 부풀어 오른 정도의 
	;빈유
	ELSEIF TALENT:PLAYER:빈유
		PRINT 앙증맞은 
	;거유
	ELSEIF TALENT:PLAYER:111
		PRINT 손에서 넘쳐흐를 정도의 
	;폭유
	ELSEIF TALENT:PLAYER:112 || TALENT:PLAYER:마유
		PRINT 손으로 감당하지 못할 만큼 거대한 
	ENDIF
	PRINTFORML 가슴 끝의 
	PRINTFORMW 유두를 빨아들이기 시작했다
;解除時
ELSE
	PRINTFORMW 촉수는 %CALLNAME:PLAYER%의 유두를 해방했다
ENDIF

;===================================================
;調教タイプ
;===================================================
@COMTYPE_56
RETURN COMTYPE("対調教者道具系")

