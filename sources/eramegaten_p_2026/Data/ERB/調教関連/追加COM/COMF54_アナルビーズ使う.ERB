;-------------------------------------------------
;애널비즈쓴다
;道具使用コマンド、レベル3
;-------------------------------------------------
@CHECK_COM_ABLE54

;アナルビーズ実行判定
;触手調教中はダメ
SIF TEQUIP:촉수
	RETURN 0

;解除はいつでも可能
SIF TEQUIP:PLAYER:15
	RETURN 1
;小人体型持ちは、双方が調教者と調教対象ならOK
;それ以外の場合は主人が禁断の知識持ちじゃないとダメ
SIF TALENT:PLAYER:소인체형 && PLAYER != MASTER && TALENT:MASTER:144 == 0
	RETURN 0

;アイテムを持っているか、アイテムなし設定でないとダメ
SIF !EXIST_ITEM(6)
	RETURN 0

SIF !USE_ANUS(PLAYER)
	RETURN 0

;新妻プレイ中はダメ
SIF TEQUIP:33
	RETURN 0

RETURN 1

@ACT_COM54
PRINTL 애널비즈쓴다
TSTR:0 = 애널비즈쓴다
;CALL KOJO_MESSAGE_COM

;着脱の処理
IF TEQUIP:PLAYER:15 == 0
	TEQUIP:PLAYER:15 = 1
ELSE
	TEQUIP:PLAYER:15 = 0
ENDIF

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:체력 += 10
LOSEBASE:기력 += 10

SOURCE:TARGET:정애 = 10
SOURCE:TARGET:노출 = 10
SOURCE:TARGET:일탈 = 10

SOURCE:PLAYER:도구쾌Ａ = 150

;装着時は快Aは下がる
SIF TEQUIP:PLAYER:15 == 1
	TIMES SOURCE:PLAYER:쾌Ａ , 0.80

;外す時は快Aは上がる
SIF TEQUIP:PLAYER:15 == 0
	TIMES SOURCE:PLAYER:쾌Ａ , 3.00

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
IF TEQUIP:PLAYER:19 == 0
	;EXP:PLAYER:Ａ경험 += 1
	;PRINTL Ａ경험＋１(調教者)
	CALL ADDS_EXP("Ａ경험", 2, PLAYER)
ELSEIF TEQUIP:PLAYER:19 == 1
	;EXP:PLAYER:Ａ경험 += 2
	;PRINTL Ａ경험＋２(調教者)
	CALL ADDS_EXP("Ａ경험", 1, PLAYER)
ENDIF

A = 1
;B = NO:PLAYER + 899
IF IS_LESBIAN(TARGET,PLAYER)
	;PRINTFORML %EXPNAME:40%+{A}
	;EXP:40 += A
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
	;PRINTFORML %EXPNAME:41%+{A}
	;EXP:41 += A
ENDIF

;依存度ベクトル
TFLAG:33 = 0


RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM54
;アナルビーズ挿入中

PRINTL ＜애널비즈 삽입 중(조교자)＞

SOURCE:PLAYER:도구쾌Ａ += 75

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;EXP:PLAYER:Ａ경험 += 1
;PRINTL Ａ경험＋１(調教者)
CALL ADDS_EXP("Ａ경험", 1, PLAYER)


RETURN 1

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
;54,애널비즈쓴다
;-------------------------------------------------
@MESSAGE_COM54
;装着時
IF TEQUIP:PLAYER:15
	PRINTFORMW %CALLNAME:PLAYER%은(는) 국문으로 애널비즈를 하나씩 삼켜가게 했다……
;解除時
ELSE
	PRINTFORMW %CALLNAME:PLAYER%은(는) 항문에서 애널비즈를 힘차게 뽑아냈다……
ENDIF

;===================================================
;調教タイプ
;===================================================
@COMTYPE_54
RETURN COMTYPE("対調教者道具系")

