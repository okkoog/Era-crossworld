;-------------------------------------------------
;更新履歴
;-------------------------------------------------
;	MOD-NO	DATE		EDITOR
;	0								新規作成
;	1		2019/11/13	絹延		露出していない恋慕奴隷が恐怖や羞恥を感じないように

;ビット説明
;TEUIP:29
;廃ビル=1
;森林=2
;公園=4
;水辺=8

@ACT_COM184_B
;야외플레이(廃ビル)
;廃ビル補正：なし

PRINTL 야외플레이(폐빌딩)
TSTR:0 = 야외플레이(폐빌딩)

TEQUIP:29 |= 1

;口上→総括Ｍ→個別セルコム
;CALL KOJO_MESSAGE_COM

;---MOD-1	ADD
;---MOD-1	COMMENT		脚露出と臍露出は取り敢えずセーフ。一先ず雑に処理をスキップ。
IF TEQUIP:유방노출 && TEQUIP:유두노출 && TEQUIP:음순노출 && TEQUIP:둔부노출 && TEQUIP:음순보임 != -1 && TEQUIP:둔부보임 != -1 && (TALENT:연모 || TALENT:친애)
	RETURN 1
ENDIF
;---MOD-1	END
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:체력 += 0
LOSEBASE:기력 += 150
;8恐れ　13露出　17逸脱　18反感
SOURCE:TARGET:무서움 = 800
SOURCE:TARGET:노출 = 1300
SOURCE:TARGET:일탈 = 300
SOURCE:TARGET:반감 = 600

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 600

;廃ビル補正

;苦痛を伴わないマゾっ気及びマゾの処理は先にしておく
;マゾっ気を見る
;10液体　11欲情　13露出
IF ABL:9 == 0
	TIMES SOURCE:TARGET:노출 , 0.80
	SOURCE:TARGET:10 += 0
	SOURCE:TARGET:11 += 0
ELSEIF ABL:9 == 1
	TIMES SOURCE:TARGET:노출 , 1.00
	SOURCE:TARGET:10 += 20
	SOURCE:TARGET:11 += 30
ELSEIF ABL:9 == 2
	TIMES SOURCE:TARGET:노출 , 1.20
	SOURCE:TARGET:10 += 40
	SOURCE:TARGET:11 += 70
ELSEIF ABL:9 == 3
	TIMES SOURCE:TARGET:노출 , 1.40
	SOURCE:TARGET:10 += 70
	SOURCE:TARGET:11 += 120
ELSEIF ABL:9 == 4
	TIMES SOURCE:TARGET:노출 , 1.50
	SOURCE:TARGET:10 += 110
	SOURCE:TARGET:11 += 180
ELSEIF ABL:9 == 5
	TIMES SOURCE:TARGET:노출 , 1.70
	SOURCE:TARGET:10 += 150
	SOURCE:TARGET:11 += 250
ELSEIF ABL:9 == 6
	TIMES SOURCE:TARGET:노출 , 1.90
	SOURCE:TARGET:10 += 200
	SOURCE:TARGET:11 += 300
ELSEIF ABL:9 == 7
	TIMES SOURCE:TARGET:노출 , 2.10
	SOURCE:TARGET:10 += 250
	SOURCE:TARGET:11 += 350
ELSEIF ABL:9 == 8
	TIMES SOURCE:TARGET:노출 , 2.30
	SOURCE:TARGET:10 += 300
	SOURCE:TARGET:11 += 400
ELSEIF ABL:9 == 9
	TIMES SOURCE:TARGET:노출 , 2.50
	SOURCE:TARGET:10 += 350
	SOURCE:TARGET:11 += 450
ELSEIF ABL:9 >= 10
	TIMES SOURCE:TARGET:노출 , 3.00
	SOURCE:TARGET:10 += 500
	SOURCE:TARGET:11 += 500
ENDIF

;依存度ベクトル
TFLAG:33 = 3


RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM184_B
;야외플레이(廃ビル)

PRINTL ＜야외플레이중(폐빌딩)＞

;---MOD-1	ADD
;---MOD-1	COMMENT		脚露出と臍露出は取り敢えずセーフ。一先ず雑に処理をスキップ。
IF TEQUIP:유방노출 && TEQUIP:유두노출 && TEQUIP:음순노출 && TEQUIP:둔부노출 && TEQUIP:음순보임 != -1 && TEQUIP:둔부보임 != -1 && (TALENT:연모 || TALENT:친애)
	RETURN 1
ENDIF
;---MOD-1	END

LOSEBASE:체력 += 50
LOSEBASE:기력 += 100

;8恐れ　13露出　17逸脱　18反感
SOURCE:TARGET:무서움 += 1000
SOURCE:TARGET:일탈 += 1000
SOURCE:TARGET:반감 += 1000


;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:억압 || TALENT:저항
	SOURCE:TARGET:울굴 += 700


;苦痛を伴わないマゾっ気及びマゾの処理は先にしておく
;マゾっ気を見る
A = 2000

;廃ビル補正

;10液体　11欲情　13露出
IF ABL:9 == 0
	TIMES A , 0.80
	SOURCE:TARGET:10 += 0
	SOURCE:TARGET:11 += 0
ELSEIF ABL:9 == 1
	TIMES A , 1.00
	SOURCE:TARGET:10 += 20
	SOURCE:TARGET:11 += 30
ELSEIF ABL:9 == 2
	TIMES A , 1.20
	SOURCE:TARGET:10 += 40
	SOURCE:TARGET:11 += 70
ELSEIF ABL:9 == 3
	TIMES A , 1.40
	SOURCE:TARGET:10 += 70
	SOURCE:TARGET:11 += 120
ELSEIF ABL:9 == 4
	TIMES A , 1.50
	SOURCE:TARGET:10 += 110
	SOURCE:TARGET:11 += 180
ELSEIF ABL:9 == 5
	TIMES A , 1.70
	SOURCE:TARGET:10 += 150
	SOURCE:TARGET:11 += 250
ELSEIF ABL:9 == 6
	TIMES A , 1.90
	SOURCE:TARGET:10 += 200
	SOURCE:TARGET:11 += 300
ELSEIF ABL:9 == 7
	TIMES A , 2.10
	SOURCE:TARGET:10 += 250
	SOURCE:TARGET:11 += 350
ELSEIF ABL:9 == 8
	TIMES A , 2.30
	SOURCE:TARGET:10 += 300
	SOURCE:TARGET:11 += 400
ELSEIF ABL:9 == 9
	TIMES A , 2.50
	SOURCE:TARGET:10 += 350
	SOURCE:TARGET:11 += 450
ELSEIF ABL:9 >= 10
	TIMES A , 3.00
	SOURCE:TARGET:10 += 500
	SOURCE:TARGET:11 += 500
ENDIF
SOURCE:TARGET:노출 += A

;依存度ベクトルを強制的に変更
SIF TFLAG:33 == 1 || TFLAG:33 == 2
	TFLAG:33 = 3

;依存度補正値(服従で1、隷属で2　強制変更なのでリセット）
IF TALENT:복종 && ASSIPLAY == 0
	TFLAG:30 = 1
ELSEIF TALENT:예속 && ASSIPLAY == 0
	TFLAG:30 = 2
ENDIF


RETURN 1

