;-------------------------------------------------
;바이브쓴다
;道具使用コマンド、レベル2
;촉수삽입시킨다
;-------------------------------------------------
@CHECK_COM_ABLE52
;バイブ実行判定
;触手調教中はダメ
SIF TEQUIP:촉수
	RETURN 0

;解除はいつでも可能
SIF TEQUIP:PLAYER:13
	RETURN 1

;アイテムを持っているか、アイテムなし設定でないとダメ
SIF !EXIST_ITEM(4)
	RETURN 0

SIF !USE_VAGINA(PLAYER)
	RETURN 0

;調教対象が小人体型の場合は主人が禁断の知識持ちじゃないとダメ
;SIF TALENT:PLAYER:142 && (TALENT:MASTER:144 == 0 && EXP:Ｖ경험 > 10)
SIF TALENT:PLAYER:소인체형 && PLAYER != MASTER && TALENT:MASTER:144 == 0
	RETURN 0

;処女で、従順4以下・レズっ気4以下のASSIの場合バイブはできない（マゾならＯＫ）
IF TALENT:PLAYER:처녀 && ASSIPLAY
	SIF (ABL:ASSI:0 <= 4 || ABL:ASSI:11 <= 4) && TALENT:ASSI:84 == 0
		RETURN 0
ENDIF
;潤滑不足で、従順3以下・レズっ気3以下のASSIの場合バイブはできない（マゾならＯＫ）
IF PALAM:PLAYER:윤활 < PALAMLV:2 && ASSIPLAY
	SIF (ABL:ASSI:0 <= 3 || ABL:ASSI:11 <= 3) && TALENT:ASSI:84 == 0
		RETURN 0
ENDIF
RETURN 1

@CHECK_COM_ABLE170
;触手ヴァギナ
SIF TEQUIP:촉수 == 0
	RETURN 0

;オトコだとダメ
SIF !HAVE_VAGINA(PLAYER)
	RETURN 0
RETURN 1

@ACT_COM52
;-------------------------------------------------
;特殊派生処理
;-------------------------------------------------
IF TEQUIP:촉수
	PRINTL 촉수삽입시킨다
	TSTR:0 = 촉수삽입시킨다
	SELECTCOM = 170
ELSE
	PRINTL 바이브쓴다
	TSTR:0 = 바이브쓴다
ENDIF
;CALL KOJO_MESSAGE_COM

;着脱の処理
IF TEQUIP:PLAYER:13 == 0
	TEQUIP:PLAYER:13 = 1
ELSE
	TEQUIP:PLAYER:13 = 0
ENDIF

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
LOSEBASE:체력 += 10
LOSEBASE:기력 += 10

SOURCE:TARGET:정애 = 10
SOURCE:TARGET:노출 = 10
SOURCE:TARGET:일탈 = 10

SOURCE:PLAYER:도구쾌Ｖ = 250

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;触手挿入なら、触手体液が膣内に付く
IF TEQUIP:촉수
;	CALL SET_STAIN("바기나", "粘液", PLAYER)
	CALL SET_STAIN("질내", "粘液", PLAYER)
ENDIF
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;V経験
;EXP:PLAYER:Ｖ경험 += 1
;PRINTL Ｖ경험＋１
CALL ADDS_EXP("Ｖ경험", 1, PLAYER)

;SIF (TALENT:PLAYER:처녀 == 1 || TALENT:PLAYER:재생처녀 == 1)
;	TFLAG:31 = 1
	
;調教者が処女か再生処女（異常経験は一回のみ）
IF (TALENT:PLAYER:처녀 == 1 || TALENT:PLAYER:재생처녀 == 1)
	PRINTFORM ＜%PLAYER는% 
	SIF TALENT:PLAYER:재생처녀 == 1
		PRINT 재생 
	PRINTL 처녀를 잃었습니다＞
	;TALENT:PLAYER:처녀 = 0
	;TALENT:PLAYER:재생처녀 = 0

	;異常経験追加
	SIF  !IS_MALE(TARGET)
		CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", TARGET)
ENDIF

;이상경험
IF TALENT:PLAYER:처녀 == 1 && TEQUIP:촉수 == 1
;	EXP:PLAYER:50 += 2
;	PRINTFORML %EXPNAME:50%(調教者)＋２
	CALL ADDS_ABNORMAL_EXP("処女喪失（触手）", PLAYER)
ELSEIF TALENT:PLAYER:처녀 == 1
;	EXP:PLAYER:50 += 1
;	PRINTFORML %EXPNAME:50%(調教者)＋１
	CALL ADDS_ABNORMAL_EXP("処女喪失（バイブ）", PLAYER)
ENDIF

;레즈경험
A = 1
IF IS_LESBIAN(TARGET,PLAYER)
;	PRINTFORML %EXPNAME:40%+{A}
;	PRINTFORML %EXPNAME:40%(調教者)+{A}
;	EXP:40 += A
;	EXP:PLAYER:40 += A
	CALL ADDS_EXP("레즈경험", A, TARGET)
	CALL ADDS_EXP("레즈경험", A, PLAYER)
ELSEIF IS_GAY(TARGET,PLAYER)
;	PRINTFORML %EXPNAME:41%+{A}
;	PRINTFORML %EXPNAME:41%(調教者)+{A}
;	EXP:41 += A
;	EXP:PLAYER:41 += A
	CALL ADDS_EXP("ＢＬ경험", A, TARGET)
	CALL ADDS_EXP("ＢＬ경험", A, PLAYER)
	
	
ENDIF

;触手召喚時、触手経験のリセットをする
;SIF TEQUIP:촉수 == 1
;	T = 0

;依存度ベクトル
TFLAG:33 = 0


RETURN 1


;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM52
;バイブ挿入中

IF TEQUIP:촉수
	PRINTL ＜촉수삽입 중(조교자)＞
ELSE
	PRINTL ＜바이브 삽입 중(조교자)＞
ENDIF

SOURCE:PLAYER:도구쾌Ｖ += 125

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;自慰実行時は経験＋１
IF SELECTCOM == 11
;	EXP:PLAYER:Ｖ경험 += 2
;	PRINTL Ｖ경험＋２(調教者)
	CALL ADDS_EXP("Ｖ경험", 2, PLAYER)
ELSE
;	EXP:PLAYER:Ｖ경험 += 1
;	PRINTL Ｖ경험＋１(調教者)
	CALL ADDS_EXP("Ｖ경험", 1, PLAYER)
ENDIF

;触手経験加算
SIF TEQUIP:촉수 == 1
	CALL ADDS_EXP("촉수경험", 1, PLAYER)
;	T += 1


RETURN 1

;-------------------------------------------------
;調教時テキスト
;-------------------------------------------------
;52,바이브쓴다
;-------------------------------------------------
@MESSAGE_COM52
;装着時
IF TEQUIP:PLAYER:13
	PRINTFORM %PLAYER는% 
	;潤滑LV5以上でさらに追加
	SIF PALAM:PLAYER:윤활 >= PALAMLV:5
		PRINT 듬뿍 
	;潤滑LV3以上でさらに追加
	SIF PALAM:PLAYER:윤활 >= PALAMLV:3
		PRINT 점액을 머금은 
	;유아체형
	IF TALENT:PLAYER:유아체형
		PRINT 어린 갈라진 틈에 
	ELSE
		PRINT 비열에 
	ENDIF
	PRINTL 바이브의 끝부분을 대고 익숙해지게 해나간다……

	PRINTFORM %PLAYER는% 
	;처녀＋淫乱か娼婦
	IF TALENT:PLAYER:처녀 && (TALENT:PLAYER:음란 || TALENT:PLAYER:창부)
		PRINT 자신이 처녀라는 사실을 잊은 듯한 미소를 짓고
	;처녀＋음란
	ELSEIF TALENT:PLAYER:처녀 && TALENT:PLAYER:음란
		PRINT 처녀라는 사실도 아랑곳하지 않고 허리를 흔들며
	;처녀
	ELSEIF TALENT:PLAYER:처녀
		PRINT 덜덜 떨며, 상실의 공포에 긴장하고
	;Ｖ経験200以上＋淫乱か娼婦
	ELSEIF EXP:PLAYER:Ｖ경험 > 200 && (TALENT:PLAYER:음란 || TALENT:PLAYER:창부)
		PRINT 삽입에 대한 기대감만으로 덜덜 허리를 떨며 가버릴 것 같아
	;Ｖ経験150以上＋淫乱か娼婦
	ELSEIF EXP:PLAYER:Ｖ경험 > 150 && (TALENT:PLAYER:음란 || TALENT:PLAYER:창부)
		PRINTFORM 황홀하게 풀린 눈으로 바라보며, 스스로 음순을 비벼대고
	;Ｖ経験120以上＋淫乱か娼婦
	ELSEIF EXP:PLAYER:Ｖ경험 > 120 && (TALENT:PLAYER:음란 || TALENT:PLAYER:창부)
		PRINT 황홀한 표정으로 안달 난 듯 허리를 구불거리며
	;Ｖ経験70以上＋淫乱か娼婦
	ELSEIF EXP:PLAYER:Ｖ경험 > 70 && (TALENT:PLAYER:음란 || TALENT:PLAYER:창부)
		PRINTFORM 아쉬운 듯 눈망울을 적시며
	;Ｖ経験40以上
	ELSEIF EXP:PLAYER:Ｖ경험 > 40
		PRINT 바이브가 스치는 감촉에 도취된 한숨을 내쉬
	;Ｖ経験20以上
	ELSEIF EXP:PLAYER:Ｖ경험 > 20
		PRINT 바이브가 스치는 감촉에 몸을 비틀며 애액을 흘리고
	;それ以外
	ELSE
		PRINT 바이브가 스치는 감촉에 살주름을 옴찔거리
	ENDIF
	PRINTL 고 있다……
	PRINTFORM %PLAYER는% 
	;潤滑LV4以上
	SIF PALAM:PLAYER:윤활 >= PALAMLV:4
		PRINT 흠뻑 젖은 
	PRINTFORMW 성기에 바이브를 밀어 넣었다
;解除時
ELSE
	PRINTFORML %PLAYER는% 꿈틀거리는 바이브를 천천히 뽑아냈다
	IF EXP:PLAYER:Ｖ경험 > 20
		PRINTFORM %PLAYER는% 느슨해진 질구를 옴찔거리
	;それ以外
	ELSE
		PRINTFORM %PLAYER는% 안도하는 듯한 표정을 짓
	ENDIF
	PRINTW 고 있다……
ENDIF

;-------------------------------------------------
;170,촉수삽입시킨다
;-------------------------------------------------
@MESSAGE_COM170
IF TEQUIP:PLAYER:13
	PRINTFORM 자잘한 돌기로 뒤덮인 촉수가 %PLAYER의% 
	;처녀
	SIF TALENT:PLAYER:처녀
		PRINT 남자를 모르는 
	;유아체형
	IF TALENT:PLAYER:유아체형
		PRINT 어린 갈라진 틈
	ELSE
		PRINT 비열
	ENDIF
	PRINTFORMW 으로 파고들었다
ELSE
	PRINTFORMW 촉수가 %PLAYER의% 성기에서 뽑혀 나왔다
ENDIF

;===================================================
;調教タイプ
;===================================================
@COMTYPE_52
RETURN COMTYPE("対調教者道具系")

