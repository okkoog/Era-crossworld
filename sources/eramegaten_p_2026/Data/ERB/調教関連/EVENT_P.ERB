;EVENT_P、EVENT_PREGNANCY、妊娠関連のイベント

@SHOPCOMABLE_209
SIF !IS_USEABLE_SHOPCOM
	RETURN 0
LOCAL:1 = 0
FOR LOCAL,0,CHARANUM
	SIF (TALENT:LOCAL:임신 && CFLAG:LOCAL:출산예정일 - 2 <= DAY && LOCAL != MASTER) || TALENT:LOCAL:육아중 && LOCAL != MASTER
		LOCAL:1 += 1
NEXT
RESULT:1 = 2
IF LOCAL:1 > 0 && FLAG:출산기능ONOFF == 1
	RESULTS = 육아실
	RETURN 1
ELSE
	RESULTS = ？？？？？
	RETURN 0
ENDIF

@SHOP_COM_209, ARG
CALL CHILD_CARE_ROOM_SELECT
RETURN 1

;---------------------------------------------------------
;中田氏・妊娠フラグチェック
;中出しされた精子量に応じて確率処理
;---------------------------------------------------------
@IN_VAGINA
#LOCALSIZE 3
#LOCALSSIZE 1
#DIM L_MOTHER, 1
#DIM TEMP
;妊娠機能オフなら何もせずに帰る
;…と、あとでONにしたときに一斉妊娠かますんでここで妊娠判定リセット
IF FLAG:임신기능 == 0
	CALL CLEAR_PREGNANCY_DATERMINATION
	RETURN 0
ENDIF

;妊娠のチェックと胎児作成処理
FOR L_MOTHER, 0 , CHARANUM
	CALL PREGNANCY_CHECK,L_MOTHER
	SIF !RESULT
		CONTINUE
	CALL SET_PREGNANCY, L_MOTHER
NEXT

;---- EDIT 033 MOD START -------------------------
@SET_PREGNANCY, L_MOTHER, L_FATHER = -1, L_FATHER_NO = -1, L_FATHER_NAME
#DIM L_MOTHER
#DIM L_FATHER
#DIM L_FATHER_NO
#DIMS L_FATHER_NAME

;---- EDIT 034 MOD START -------------------------
;子供のフラグ処理
CALL SET_FETUS_STATUS, L_MOTHER, L_FATHER, L_FATHER_NO, L_FATHER_NAME
;---- EDIT 034 MOD END ---------------------------
;母親のフラグ処理
CALL CHANGE_N_STATUS, L_MOTHER
CALL ADD_STRESS_OF_PREGNANCY, L_MOTHER
;口上のよびだし
V = TARGET
TARGET = L_MOTHER

;---- EDIT 036 MOD START -------------------------
U = 0
W = -1
;助手が居たら助手を放り込んでおく
;助手が妊娠した場合は助手扱いしない
IF ASSI　!= L_MOTHER
	U = 1
	W = ASSI
ENDIF
;---- EDIT 036 MOD START -------------------------
;妊娠発覚時のイベント口上
TFLAG:13 = 11
CALL KOJO_MESSAGE_EVENT
TARGET = V
SIF U
	ASSI = W
;---- EDIT 033 MOD END ---------------------------
;========================================================
;母親のフラグと胎児のステータス設定
;PALENT:0 = 母親のキャラ登録番号
;PALENT:1 = 父親のキャラ登録番号(非登録キャラの場合はキャラ生成を行う)
;L_FATHER_NO = 父親のCSV番号を指定して作る場合
;L_FATHER_NAME = 父親の名称を指定して作る場合
;
;妊娠が確定した時点で母親に、子供の生成に必要な情報を全て持たせておく(父親の削除で齟齬がでるリスクを回避するため)
;この時点で子供のステータス算出をしてしまったほうが楽ではあるが、
;プレイ上はリロードで子供の選別をやるだろうし、それを封じるには妊娠関係の時差と確率がまぁきついので
;やや面倒だが、算出用の数値をとっておくのに留める
;========================================================
@SET_FETUS_STATUS, PALENT:0, PALENT:1 = -1, L_FATHER_NO = -1, L_FATHER_NAME
#DIM LCOUNT, 3
#DIM TEMP
#DIMS TEMPS
#DIMS L_SKILL
#DIMS CHILD_RACE
#DIMS CHILD_RACE_TYPE
#DIMS CHILD_ROLE
#DIM PALENT, 2
#DIMS PALENT_ROLE, 2
#DIM PALENT_RACE, 2
#DIMS PALENT_RACE_TYPE, 2
#DIMS TRANS_MODE
#DIMS SKILL_CATEGORY
#DIM L_FATHER
#DIM L_FATHER_NO
#DIMS L_FATHER_ROLE
#DIMS L_FATHER_NAME
;--------------------------------------------------------
;母親のフラグ設定
;父親が指定されていない場合は妊娠時の判定に従って取得あるいは生成する
;--------------------------------------------------------
CFLAG:(PALENT:0):딸의친부모고유번호부모 = CFLAG:(PALENT:0):캐릭터고유번호
SIF 위험일(PALENT:0) > 1
	CFLAG:(PALENT:0):발정임신 = 1
CFLAG:(PALENT:0):출산예정일 = DAY + 6
;TALENT:(PALENT:0):임신 = 1		;←ここで妊娠させると後の処理で引っかかる為コメントアウト
;受胎人数の設定
CALL SET_COUNT_OF_FETUS, PALENT:0

;--------------------------------------------------------
;父親の取得
;父親が指定されていない場合は妊娠時の判定に従って取得あるいは生成する
;--------------------------------------------------------
CSTR:PALENT:부친명칭 = 
;キャラが指定された状態で呼び出された
IF PALENT:1 >= 0
	L_FATHER = PALENT:1
ELSE
	;CSVNOも指定されていないのなら妊娠判定時に得た情報から親を決定する
	IF L_FATHER_NO < 0
		;結果チェック(妊娠していない場合はスルーされるはず)
		SELECTCASE CFLAG:PALENT:임신시부친판정
			;父親が主人
			CASE 1
				L_FATHER = MASTER
			;父親が助手
			CASE 2
				L_FATHER = ASSI
			;父親が奴隷
			CASE 3
				L_FATHER = TARGET
			;労役中の妊娠
			CASE 4
				;暫定父親が仲魔(0以上)の場合
				TEMP = CFLAG:PALENT:노역중질내사정에의한잠정부친
				IF TEMP > 0
					L_FATHER = TEMP
				;暫定父親が仲魔以外(-1未満)だった場合
				ELSEIF TEMP < -1
					;見世物小屋を探す
					IF SHOW_TENT_ACTNO(TEMP) != -1
						L_FATHER_NO = SHOW_TENT_ACTNO(TEMP)
						;---- EDIT 031 MOD START -------------------------
						SIF L_FATHER_NO == -1
							GOTO WORK_UNKONOWN_DEVIL
						;---- EDIT 031 MOD END ---------------------------
					;不明
					ELSE
						GOTO WORK_UNKNOWN_FATHER
					ENDIF
			;それ以外
				ELSE
					$WORK_UNKNOWN_FATHER
					SELECTCASE RAND:100
						;異能者はクラスから取る
						CASE IS < 25
							L_FATHER_NO = 0
							CSTR:PALENT:부친명칭 = 名も知らぬ異能者
							L_FATHER_ROLE = 異能者
						;비전투원
						CASE IS < 50
							L_FATHER_NO = 0
							L_FATHER_ROLE = 非戦闘員
							CSTR:PALENT:부친명칭 = 名も知らぬ一般人
						;その他ロールはロール情報からリストを作ってランダム抽選
						CASE IS < 75
							TEMPS = 
							FOR LCOUNT, 0, ROLENUM
								TRYCCALLFORM ROLE_NAME_{LCOUNT}
								CATCH
									CONTINUE
								ENDCATCH
								TRYCCALLFORM ROLE_HEREDITY_CAN_USE_RANDOM_FATHER_%RESULTS%
									TEMPS = %ADD_SPLIT(TEMPS, "/", RESULTS)%
								CATCH
								ENDCATCH
							NEXT
							L_FATHER_NO = 0
							L_FATHER_ROLE = %RAND_SPLIT(TEMPS, "/")%
							CSTR:PALENT:부친명칭 = 名も知らぬ%L_FATHER_ROLE%
						;悪魔
						CASEELSE
							$WORK_UNKONOWN_DEVIL
							WHILE 1
								L_FATHER_NO = RAND:1900 + 1
								SIF !EXISTCSV(L_FATHER_NO, 0)
									CONTINUE
								SIF !CSVABL(L_FATHER_NO, GETNUM(ABL, "종족"), 0)
									CONTINUE
								SIF CSVCFLAG(L_FATHER_NO, GETNUM(CFLAG, "특수합체만"), 0)
									CONTINUE
								SIF CSVCFLAG(L_FATHER_NO, GETNUM(CFLAG, "합체조건있음"), 0)
									CONTINUE
								SIF CSVCFLAG(L_FATHER_NO, GETNUM(CFLAG, "전서소환불가"), 0)
									CONTINUE
								SIF CSVCFLAG(L_FATHER_NO, GETNUM(CFLAG, "１체만"), 0)
									CONTINUE
								;---- EDIT P 001 MOD START -------------------------
								;解析できてない場合は帰る
								SIF ANALYSIS_RATE:L_FATHER_NO < ANALYSIS_COMPLETED
									CONTINUE
								;SIF !FLAG:(20000+L_FATHER_NO)
								;	CONTINUE
								;---- EDIT P 001 MOD END ---------------------------
								BREAK
							WEND
							L_FATHER_ROLE = 悪魔
							CSTR:PALENT:부친명칭 = 名も知らぬ悪魔
					ENDSELECT
				ENDIF
			;触手が親の場合は、両親が共に母親という扱いになる
			CASE 5
				L_FATHER = PALENT
			;信者が親
			CASE 6
				WHILE 1
					L_FATHER_NO = RAND:100 + 3101
					SIF !EXISTCSV(L_FATHER_NO, 0)
						CONTINUE
					SIF (CSVABL(L_FATHER_NO, GETNUM(ABL, "속성LC"), 0) == 1 && 店舗("종류",(CFLAG:PALENT:노역플래그 - 10)) == 14) || (CSVABL(L_FATHER_NO, GETNUM(ABL, "속성LC"), 0) == 3 && 店舗("종류",(CFLAG:PALENT:노역플래그 - 10)) == 13)
						CONTINUE
					SIF !CSVTALENT(L_FATHER_NO, GETNUM(TALENT, "남자"), 0)
						CONTINUE
					BREAK
				WEND
				
				SELECTCASE 店舗("종류",(CFLAG:PALENT:노역플래그 - 10))
					CASE 14
						CSTR:PALENT:부친명칭 = ガイア教の信者
					CASE 13
						CSTR:PALENT:부친명칭 = メシア教の信者
					CASE 15
						CSTR:PALENT:부친명칭 = 教会の信者
					CASEELSE
						CSTR:PALENT:부친명칭 = 信者
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
;父親もキャラが存在する場合
IF L_FATHER_NO < 0
	IF CFLAG:PALENT:임신시부친판정 == 5
		CSTR:PALENT:부친명칭 = 촉수
		CFLAG:PALENT:부친의고유번호부모 = -2
		CFLAG:PALENT:임신확정후의부친판정 = -2
	ELSE
		CSTR:PALENT:부친명칭 = %CALLNAME:L_FATHER%
		CFLAG:PALENT:부친의고유번호부모 = CFLAG:L_FATHER:캐릭터고유번호
		CFLAG:PALENT:임신확정후의부친판정 = NO:L_FATHER
	ENDIF
;父親を生成
ELSE
	ADDCHARA L_FATHER_NO
	L_FATHER = CHARANUM - 1
	CFLAG:PALENT:부친의고유번호부모 = -1
	CFLAG:PALENT:임신확정후의부친판정 = NO:L_FATHER
	SIF CSTR:PALENT:부친명칭 == ""
		CSTR:PALENT:부친명칭 = %CALLNAME:L_FATHER%
	;ロールが予め指定されっている場合はキーとなる素質を呼び出す
	IF L_FATHER_ROLE != ""
		CALL CLEAR_ROLE_TALENT, L_FATHER
		RESULTS = 
		CALLFORM ROLE_HEREDITY_MAIN_TALENT_%L_FATHER_ROLE%
		IF RESULTS != ""
			FOR LCOUNT, 0, STRCOUNT(RESULTS, "/") + 1
				TEMPS = %AUTO_SPLIT(RESULTS, "/", LCOUNT)%
				TALENT:L_FATHER:AUTO_SPLIT(TEMPS, "_", 0) = TOINT(AUTO_SPLIT(TEMPS, "_", 1))
			NEXT
		ENDIF
	ENDIF
	CALL SET_ROLE, L_FATHER
	CALL SET_BTL_TALENT_NEW, L_FATHER
	;遺伝用の性格の付与
	FOR LCOUNT, 201, 209
		SIF RAND:100 < 25
			TALENT:L_FATHER:LCOUNT = 1
	NEXT
	;素質
	FOR LCOUNT, 10, 137
		SIF !STRLENS(TALENTNAME:LCOUNT)
			CONTINUE
		SIF RAND:100 < 10
			TALENT:L_FATHER:LCOUNT = 1
	NEXT
ENDIF
;父親の名前が指定されていた場合はここで代入して上書きしてしまう
SIF L_FATHER_NAME != ""
	CSTR:PALENT:부친명칭 = %L_FATHER_NAME%
;変数の扱い方の都合で以降はPALENT関数にいれて扱う
PALENT:1 = L_FATHER

;---------------------------------------------------------
;種族区分の処理
;---------------------------------------------------------
;親のロールが設定されてない可能性があるので取得させておく
CALL SET_ROLE, PALENT:0
CALL SET_ROLE, PALENT:1

;種族区分を取得
FOR LCOUNT, 0, 2
	PALENT_RACE:LCOUNT = ABL:(PALENT:LCOUNT):종족
	TRYCCALLFORM ROLE_HEREDITY_RACE_TYPE_%CSTR:(PALENT:LCOUNT):롤%
		PALENT_RACE_TYPE:LCOUNT = %RESULTS%
	CATCH
		THROW %CSTR:(PALENT:LCOUNT):롤%の妊娠判定時の種族区分が未指定になっています！
	ENDCATCH
	;狂人は人間として扱う
	IF GET_RACE(ABL:(PALENT:LCOUNT):종족) == "광인"
		PALENT_RACE_TYPE:LCOUNT = 인간
		PALENT_RACE:LCOUNT = GET_RACE_NUM("인간")
	ENDIF
NEXT

;種族区分
;優先度
;이능자/悪魔 > 半魔/조마
;
;特殊な組み合わせ
;인간 × 悪魔 = 半魔
;悪魔 × 조마 = 괴이(悪魔)
CHILD_RACE = 
CHILD_ROLE = 
SELECTCASE 1
	;両親が同じ種族区分ならそのまま使う
	CASE PALENT_RACE_TYPE:0 == PALENT_RACE_TYPE:1
