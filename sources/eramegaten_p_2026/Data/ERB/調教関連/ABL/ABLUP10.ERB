PRINTS ABLNAME:10
PRINT 의 레벨이 
PRINTV ABL:10
PRINTW (이)가 되었습니다
GOTO ABLUP_LOOP

;サドっ気LVUP判定
@DECIDE_ABLUP10
;条件別にＯＫかダメかを記録する
I = 0
J = 0
;能力アップ可能なら1にする
Z = 0

IF ABL:10 == 0
	A = 100
	B = 5
ELSEIF ABL:10 == 1
	A = 500
	B = 10
ELSEIF ABL:10 == 2
	A = 1500
	B = 20
ELSEIF ABL:10 == 3
	A = 3000
	B = 50
ELSEIF ABL:10 == 4
	A = 5000
	B = 80
ELSEIF ABL:10 == 5
	A = 8000
	B = 100
ELSEIF ABL:10 == 6
	A = 12000
	B = 150
ELSEIF ABL:10 == 7
	A = 15000
	B = 200
ELSEIF ABL:10 == 8
	A = 25000
	B = 250
ELSEIF ABL:10 == 9
	A = 30000
	B = 350
ENDIF

;일선을넘지않음
IF TALENT:27 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && 陥落() < 2)
	TIMES A , 2.00
	TIMES B , 2.00
ENDIF
;새드
IF TALENT:83
	TIMES A , 0.50
	TIMES B , 0.50
ENDIF

;欲望がサドっ気＋１レベルでないといけない（陥落無し時＆恋慕親愛時）
IF TALENT:5 == 0 && TALENT:8 == 0
	IF ABL:1 < ABL:10+1
		;欲望が不足
		I |= 4
	ENDIF
;技巧がサドっ気＋１レベルでないといけない（服従隷属時）
ELSEIF TALENT:5 == 1 || TALENT:8 == 1
	IF ABL:2 < ABL:10+1
		;欲望が不足
		I |= 4
	ENDIF
ENDIF

;ＬＶ３から４、４から５に上げるときは異常経験必要（素質：[새드]なら無視できる）
IF ABL:10 == 3 && TALENT:83 == 0
	IF EXP:50 == 0
		;異常経験が不足
		I |= 2
	ENDIF
;ＬＶ４から５に上げるときは異常経験3以上必要（素質：[새드]なら無視できる）
ELSEIF ABL:10 == 4 && TALENT:83 == 0
	IF EXP:50 < 3
		;異常経験が不足
		I |= 2
	ENDIF
;ＬＶ８から９に上げるときは異常経験5以上必要（素質：[새드]なら無視できる）
ELSEIF ABL:10 == 8 && TALENT:83 == 0
	IF EXP:50 < 5
		;異常経験が不足
		I |= 2
	ENDIF
ENDIF

;欲情の珠で上げる
SIF JUEL:6 < A
	I |= 1
;嗜虐快楽経験が必要な場合
SIF EXP:32 < B
	I |= 2

SIF I == 0
	Z = 1

RETURN 1

