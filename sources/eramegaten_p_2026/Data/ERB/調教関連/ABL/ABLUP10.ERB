;サドっ気の可否
@ISABLUP10
;恋慕、親愛、服従、隷属はMAXLV10
IF ABL:10 >= 10
	RETURN 0
ELSEIF ABL:10 >= 5 && !陥落(TARGET) && TARGET != MASTER
	RETURN 0
ENDIF

CALL DECIDE_ABLUP10

IF Z == 0
	RETURN 0
ELSE
	RETURN 1
ENDIF


