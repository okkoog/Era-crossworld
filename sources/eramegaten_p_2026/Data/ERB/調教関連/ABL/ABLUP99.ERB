@DECIDE_ABLUP99
;条件別にＯＫかダメかを記録する
I = 0
;能力アップ可能なら1にする
Z = 0

IF MARK:3 == 1
	A = 1000
ELSEIF MARK:3 == 2
	A = 3000
ELSEIF MARK:3 == 3
	A = 5000
ENDIF

;反発刻印Lvと同じLvの屈服刻印が必要
SIF MARK:3 > MARK:2
	I |= 2

;反発刻印Lvと同じLvの従順が必要
SIF MARK:3 > ABL:0
	I |= 4

;屈服の珠で減らす
SIF JUEL:7 < A
	I |= 1

IF I == 0
	Z = 1
ENDIF

