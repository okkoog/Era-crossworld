;輪姦中毒の可否
@ISABLUP24
;恋慕、親愛、淫乱、娼婦はMAXLV10
IF ABL:24 >= 10
	RETURN 0
ELSEIF ABL:24 >= 5 && !陥落(TARGET) && TARGET != MASTER
	RETURN 0
ENDIF

CALL DECIDE_ABLUP24

IF Z == 0
	RETURN 0
ELSE
	RETURN 1
ENDIF

;윤간중독
@ABLUP24
$ABLUP_LOOP
DRAWLINE
;恋慕、親愛、淫乱、娼婦はMAXLV10
IF ABL:24 >= 10
	PRINTW 이미 MAX 입니다
	RETURN 0
ELSEIF ABL:24 >= 5 && !陥落(TARGET) && TARGET != MASTER
	PRINTW 이미 MAX 입니다
	RETURN 0
ENDIF

CALL DECIDE_ABLUP24

;ＬＶ１に上げるときは異常経験必要（素質：[중독되기쉬움]なら無視できる）
IF ABL:24 == 1 && TALENT:72 == 0
	PRINTS EXPNAME:50
	PRINTL 있음、그리고
;ＬＶ３から４に上げるときは異常経験2以上必要（素質：[중독되기쉬움]なら無視できる）
ELSEIF ABL:24 == 3 && TALENT:72 == 0
	PRINTS EXPNAME:50
	PRINTL 3이상、그리고
;ＬＶ４から５に上げるときは異常経験3以上必要（素質：[중독되기쉬움]なら無視できる）
ELSEIF ABL:24 == 4 && TALENT:72 == 0
	PRINTS EXPNAME:50
	PRINTL 5이상、그리고
;ＬＶ８から９に上げるときは異常経験7以上必要（素質：[중독되기쉬움]なら無視できる）
ELSEIF ABL:24 == 8 && TALENT:72 == 0
	PRINTS EXPNAME:50
	PRINTL 7이상、그리고
ENDIF

; 快Ｖの珠で上げる
PRINT [0] - 
PRINTS PALAMNAME:1
PRINT 의 구슬×
PRINTV B
PRINT 、
PRINTS PALAMNAME:6
PRINT 의 구슬×
PRINTV A
PRINT 、
PRINTS PALAMNAME:7
PRINT 의 구슬×
PRINTV A
PRINT 、
PRINTS EXPNAME:82
PRINTV C
PRINT 이상
PRINT ……

IF I == 0
	PRINT ＯＫ
ELSE
	SIF I & 1
		PRINT 구슬부족 
	SIF I & 2
		PRINT 경험부족 
	SIF I & 4
		PRINT 능력부족 
ENDIF
PRINTL 

;快Ａの珠で上げる
PRINT [1] - 
PRINTS PALAMNAME:2
PRINT 의 구슬×
PRINTV D
PRINT 、
PRINTS PALAMNAME:6
PRINT 의 구슬×
PRINTV A
PRINT 、
PRINTS PALAMNAME:7
PRINT 의 구슬×
PRINTV A
PRINT 、
PRINTS EXPNAME:82
PRINTV C
PRINT 이상
PRINT ……

IF J == 0
	PRINT ＯＫ
ELSE
	SIF J & 1
		PRINT 구슬부족 
	SIF J & 2
		PRINT 경험부족 
	SIF J & 4
		PRINT 능력부족 
ENDIF
PRINTL 

IF Z == 0
	WAIT
	RETURN
ENDIF

PRINTL [100] - 그만둔다
PRINTFORMLC   %" " * 42%
PRINTLC [200] - AUTO능력UP


INPUT
IF (RESULT < 0 || RESULT > 1) && RESULT != 100 && RESULT != 200
	RESTART
ELSEIF I != 0 && RESULT == 0
	PRINTL 조건을 만족하지 못했습니다
	RESTART
ELSEIF J != 0 && RESULT == 1
	PRINTL 조건을 만족하지 못했습니다
	RESTART
ELSEIF RESULT == 100
	RETURN 0
ELSEIF RESULT == 200
	CALL AUTOMAX, 24
	RETURN 0
ENDIF

ABL:24 += 1

IF RESULT == 0
	JUEL:1 -= B
	JUEL:6 -= A
	JUEL:7 -= A
ELSE
	JUEL:2 -= D
	JUEL:6 -= A
	JUEL:7 -= A
ENDIF

PRINTS ABLNAME:24
PRINT 의 레벨이 
PRINTV ABL:24
PRINTW (이)가 되었습니다
GOTO ABLUP_LOOP


;輪姦中毒LVUP判定
@DECIDE_ABLUP24
;条件別にＯＫかダメかを記録する
I = 0
J = 0
;能力アップ可能なら1にする
Z = 0

IF ABL:24 == 0
	A = 3000
	B = 10000
	C = 10
	D = 10000
ELSEIF ABL:24 == 1
	A = 8000
	B = 25000
	C = 15
	D = 25000
ELSEIF ABL:24 == 2
	A = 15000
	B = 50000
	C = 20
	D = 50000
ELSEIF ABL:24 == 3
	A = 30000
	B = 100000
	C = 25
	D = 100000
ELSEIF ABL:24 == 4
	A = 55000
	B = 300000
	C = 30
	D = 300000
ELSEIF ABL:24 == 5
	A = 60000
	B = 350000
	C = 35
	D = 350000
ELSEIF ABL:24 == 6
	A = 65000
	B = 400000
	C = 45
	D = 400000
ELSEIF ABL:24 == 7
	A = 70000
	B = 450000
	C = 60
	D = 450000
ELSEIF ABL:24 == 8
	A = 75000
	B = 500000
	C = 80
	D = 500000
ELSEIF ABL:24 == 9
	A = 80000
	B = 550000
	C = 100
	D = 550000
ENDIF

;일선을넘지않음
IF TALENT:27 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && 陥落() < 2)
	TIMES A , 2.00
	TIMES B , 2.00
	TIMES C , 2.00
	TIMES D , 2.00
ENDIF
;중독되기쉬움
IF TALENT:72
	TIMES A , 0.50
	TIMES B , 0.50
	TIMES C , 0.50
	TIMES D , 0.50
ENDIF

;ＬＶ１に上げるときは異常経験必要（素質：[중독되기쉬움]なら無視できる）
IF ABL:24 == 0 && TALENT:72 == 0
	IF EXP:50 == 0
		;異常経験が不足
		I |= 2
		J |= 2
	ENDIF
;ＬＶ３から４に上げるときは異常経験3以上必要（素質：[중독되기쉬움]なら無視できる）
ELSEIF ABL:24 == 3 && TALENT:72 == 0
	IF EXP:50 < 3
		;異常経験が不足
		I |= 2
		J |= 2
	ENDIF
;ＬＶ４から５に上げるときは異常経験5以上必要（素質：[중독되기쉬움]なら無視できる）
ELSEIF ABL:24 == 4 && TALENT:72 == 0
	IF EXP:50 < 5
		;異常経験が不足
		I |= 2
		J |= 2
	ENDIF
;ＬＶ８から９に上げるときは異常経験7以上必要（素質：[중독되기쉬움]なら無視できる）
ELSEIF ABL:24 == 8 && TALENT:72 == 0
	IF EXP:50 < 7
		;異常経験が不足
		I |= 2
		J |= 2
	ENDIF
ENDIF

;快Vの珠で上げる

SIF JUEL:1 < B
	I |= 1
;快Aの珠で上げる
SIF JUEL:2 < D
	J |= 1
;欲情の珠で上げる
IF JUEL:6 < A
	I |= 1
	J |= 1
ENDIF
;屈服の珠で上げる
IF JUEL:7 < A
	I |= 1
	J |= 1
ENDIF
;輪姦経験が必要
IF EXP:82 < C
	I |= 2
	J |= 2
ENDIF

IF I == 0 || J == 0
	Z = 1
ENDIF


