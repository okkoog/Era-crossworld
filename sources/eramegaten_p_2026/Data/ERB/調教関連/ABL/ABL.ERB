	RETURN 0
RESULT:1 = 2
RESULTS = 조교능력상승
RETURN 1

@SHOP_COM_205, ARG
#DIM DYNAMIC LCOUNT
CALL ABL_MANUAL_MENU
FOR LCOUNT, 0, CHARANUM
	SIF LCOUNT == MASTER
		CONTINUE
	CALL EVENTCHECK_T, LCOUNT
	CALL END_TRAIN_CHARASELL, LCOUNT
