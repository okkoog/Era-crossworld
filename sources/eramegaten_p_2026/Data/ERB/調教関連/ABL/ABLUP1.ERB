;欲望の可否
@ISABLUP1
;恋慕、親愛、淫乱、娼婦はMAXLV10
IF ABL:1 >= 10
	RETURN 0
ELSEIF ABL:1 >= 5 && !陥落(TARGET) && TARGET != MASTER
	RETURN 0
ENDIF

CALL DECIDE_ABLUP1

IF Z == 0
	RETURN 0
ELSE
	RETURN 1
ENDIF

;욕망
@ABLUP1
$ABLUP_LOOP
DRAWLINE
;恋慕、親愛、服従、隷属はMAXLV10
IF ABL:1 >= 10
	PRINTW 이미 MAX 입니다
	RETURN 0
ELSEIF ABL:1 >= 5 && !陥落(TARGET) && TARGET != MASTER
	PRINTW 이미 MAX 입니다
	RETURN 0
ENDIF

CALL DECIDE_ABLUP1

;ＬＶ４から５に上げるときは異常経験必要（素質：[쾌감에솔직][음란][창부]なら無視できる）
IF ABL:1 == 4 && TALENT:70 == 0 && TALENT:4 == 0 && TALENT:7 == 0
	PRINTS EXPNAME:50
	PRINTL 있음、그리고
;ＬＶ７から８に上げるときは異常経験3以上必要（素質：[쾌감에솔직][음란][창부]なら無視できる）
ELSEIF ABL:1 == 7 && TALENT:70 == 0 && TALENT:4 == 0 && TALENT:7 == 0
	PRINTS EXPNAME:50
	PRINTL 3이상、그리고
ENDIF

PRINT [0] - 
PRINTS PALAMNAME:6
PRINT 의 구슬×
PRINTV A
PRINT ……
IF I == 0
	PRINT ＯＫ
ELSE
	SIF I & 1
		PRINT 구슬부족 
	SIF I & 2
		PRINT 경험부족 
ENDIF
PRINTL 

IF Z == 0
	WAIT
	RETURN
ENDIF

PRINTLC [100] - 그만둔다
PRINTFORMLC   %" " * 42%
PRINTLC [200] - AUTO능력UP


INPUT
IF (RESULT < 0 || RESULT > 0) && RESULT != 100 && RESULT != 200
	RESTART
ELSEIF I != 0 && RESULT == 0
	PRINTL 조건을 만족하지 못했습니다
	RETURN 0
ELSEIF RESULT == 100
	RETURN 0
ELSEIF RESULT == 200
	CALL AUTOMAX, 1
	RETURN 0
ENDIF

ABL:1 += 1

IF RESULT == 0
	JUEL:6 -= A
ENDIF

PRINTS ABLNAME:1
PRINT 의 레벨이 
PRINTV ABL:1
PRINTW (이)가 되었습니다

CALL YOKUBO_UP_CHECK
GOTO ABLUP_LOOP
;欲望LvUP判定
@DECIDE_ABLUP1
;条件別にＯＫかダメかを記録する
I = 0
;能力アップ可能なら1にする
Z = 0

IF ABL:1 == 0
	A = 1
ELSEIF ABL:1 == 1
	A = 20
ELSEIF ABL:1 == 2
	A = 1000
ELSEIF ABL:1 == 3
	A = 8000
ELSEIF ABL:1 == 4
	A = 24000
ELSEIF ABL:1 == 5
	A = 30000
ELSEIF ABL:1 == 6
	A = 36000
ELSEIF ABL:1 == 7
	A = 45000
ELSEIF ABL:1 == 8
	A = 55000
ELSEIF ABL:1 == 9
	A = 70000
ENDIF

;일선을넘지않음
IF TALENT:27 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && 陥落() < 2)
	TIMES A , 2.00
ENDIF

;ＬＶ４から５に上げるときは異常経験必要（素質：[쾌감에솔직][음란][창부]なら無視できる）
IF ABL:1 == 4 && TALENT:70 == 0 && TALENT:4 == 0 && TALENT:7 == 0
	IF EXP:50 == 0
		;異常経験がない
		I |= 2
	ENDIF
;ＬＶ７から８に上げるときは異常経験3以上必要（素質：[쾌감에솔직][음란][창부]なら無視できる）
ELSEIF ABL:1 == 7 && TALENT:70 == 0 && TALENT:4 == 0 && TALENT:7 == 0
	IF EXP:50 < 3
		;異常経験が3未満
		I |= 2
	ENDIF
ENDIF

;0になった場合は1にする
SIF A == 0
	A = 1

;欲情の珠で上げる
SIF JUEL:6 < A
	I |= 1

IF I == 0
	Z = 1
ENDIF
RETURN 1

