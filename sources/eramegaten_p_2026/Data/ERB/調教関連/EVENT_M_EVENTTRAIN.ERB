@EVENTTRAIN_MESSAGE_CLOTHES
;オトコの場合は弾く。但し男の娘はスルー。
IF TALENT:남자 == 0 || TALENT:오토코노코
	;--------------------------------------------------------------------------------------
	;체육복＋블루머
	;--------------------------------------------------------------------------------------
	IF CFLAG:옷 == 103 && CFLAG:하의 == 211
		PRINTFORM 위아래가 체육복에 감싸인 %CALLNAME%의 
		IF TALENT:거유 || TALENT:폭유 || TALENT:마유
			PRINTFORM 고혹적인 육체는
		ELSEIF TALENT:유아체형 || TALENT:빈유 || TALENT:절벽
			PRINTFORM 어린 몸은
		ELSEIF TALENT:소인체형
			PRINTFORM 작은 몸은
		ELSE
			PRINTFORM 모습은
		ENDIF
		PRINTFORML 、실로 매력적이다。
		;下着（下）・全身下着なし
		SIF CFLAG:속옷（하） == 0 && CFLAG:전신속옷 == 0
			PRINTFORM 맨살 위에 입은 
		PRINTFORM 블루머에서 쭉 뻗어나온 
		;靴下系あり
		IF CFLAG:양말
			CALL CLOTHES_NAME,8,TARGET
			PRINTFORM 에 감싸인 
		ELSE
			PRINTFORM 노출된 
		ENDIF
		PRINTFORM 발
		IF (ABL:노출증 >= 3 && !TALENT:부끄럼쟁이) || TALENT:부끄럼없음
			PRINTFORMW 이、아낌없이 %CALLNAME:MASTER%의 시선에 노출되어 있다。
		ELSE
			PRINTFORMW 을、%CALLNAME은% 부끄러운 듯이 %CALLNAME:MASTER%의 시선에 드러내고 있다。
		ENDIF
	;--------------------------------------------------------------------------------------
	;체육복＆스패츠＆下衣なし
	;--------------------------------------------------------------------------------------
	ELSEIF CFLAG:옷 == 103 && CFLAG:속옷（하） == 616 && CFLAG:하의 == 0
		PRINTFORM 위아래로 체육복에 감싸인 %CALLNAME%의 
		IF TALENT:거유 || TALENT:폭유 || TALENT:마유
			PRINTFORM 매혹적인 육체는
		ELSEIF TALENT:유아체형 || TALENT:빈유 || TALENT:절벽
			PRINTFORM 어린 몸은
		ELSEIF TALENT:소인체형
			PRINTFORM 작은 몸은
		ELSE
			PRINTFORM 모습은
		ENDIF
		PRINTFORML 、실로 매력적이다。
		PRINTFORM 맨살 위에 입은 스패츠에 감싸인 하반신
		IF (ABL:노출증 >= 3 && !TALENT:부끄럼쟁이) || TALENT:부끄럼없음
			PRINTFORMW 이、아낌없이 %CALLNAME:MASTER%의 시선에 노출되어 있다。
		ELSE
			PRINTFORMW 을、%CALLNAME은% 부끄러운 듯이 %CALLNAME:MASTER%의 시선에 드러내고 있다。
		ENDIF
	;--------------------------------------------------------------------------------------
	;경기용유니폼
	;↑の差分。
	;ブルマ、スパッツ＆下衣なし＝バレー部とか陸上部とかのユニフォームをイメージ
	;언더스커트＆미니스커트＝テニスウェアとかゴルフウェアとかをイメージ
	;--------------------------------------------------------------------------------------
	ELSEIF CFLAG:옷 == 132  && ((CFLAG:속옷（하） == 616 && CFLAG:하의 == 0) || (CFLAG:하의 == 211) || (CFLAG:속옷（하） == 642 && CFLAG:하의 == 207))
		PRINTFORM 유니폼을 몸에 걸친 %CALLNAME%의
		IF TALENT:거유 || TALENT:폭유 || TALENT:마유
			PRINTFORM 고혹적인 육체
		ELSEIF TALENT:유아체형 || TALENT:빈유 || TALENT:절벽
			PRINTFORM 앳된 몸
		ELSEIF TALENT:소인체형
			PRINTFORM 작은 몸
		ELSE
			PRINTFORM 모습
		ENDIF
		PRINTFORML 은、실로 매력적이다。
		IF CFLAG:속옷（하） == 616 && CFLAG:하의 == 0
			;스패츠＆下衣なし
			PRINTFORM 맨살에 입은 스패츠로 감싸인 하반신
			IF (ABL:노출증 >= 3 && !TALENT:부끄럼쟁이) || TALENT:부끄럼없음
				PRINTFORMW 이、아낌없이 %CALLNAME:MASTER%의 시선에 드러나 있다。
			ELSE
				PRINTFORMW 을、%CALLNAME%는 부끄러운 듯 %CALLNAME:MASTER%의 시선에 드러내고 있다。
			ENDIF
		ELSEIF CFLAG:하의 == 211
			;블루머
			;下着（下）・全身下着なし
			SIF CFLAG:속옷（하） == 0 && CFLAG:전신속옷 == 0
				PRINTFORM 맨살에 입은 
			PRINTFORM 블루머에서 뻗은 
			;靴下系あり
			IF CFLAG:양말
				CALL CLOTHES_NAME,8,TARGET
				PRINTFORM 에 감싸인 
			ELSE
				PRINTFORM 드러난 
			ENDIF
			PRINTFORM 발
			IF (ABL:노출증 >= 3 && !TALENT:부끄럼쟁이) || TALENT:부끄럼없음
				PRINTFORMW 이、아낌없이 %CALLNAME:MASTER%의 시선에 드러나 있다。
			ELSE
				PRINTFORMW 을、%CALLNAME%는 부끄러운 듯 %CALLNAME:MASTER%의 시선에 드러내고 있다。
			ENDIF
		ELSEIF CFLAG:속옷（하） == 642 && CFLAG:하의 == 207
			;언더스커트＆미니스커트
			PRINTFORML 조금만 격하게 움직여도 속이 드러날 법한、
			PRINTFORM 그 아슬아슬한 미니스커트 차림
			IF (ABL:노출증 >= 3 && !TALENT:부끄럼쟁이) || TALENT:부끄럼없음
				PRINTFORMW 이 아낌없이 %CALLNAME:MASTER%의 시선에 드러나 있다。
			ELSE
				PRINTFORMW 을 %CALLNAME%는 부끄러운 듯 %CALLNAME:MASTER%의 시선에 드러내고 있다。
			ENDIF
		ENDIF
	;--------------------------------------------------------------------------------------
	;네코미미카츄샤＆네코마타수트(의상)＆육구글러브＆꼬리플러그＆肉球ぶーつ（自前の耳尻尾はスルー）
	;↓と合わせるため、プラグ部分は差分に変更
	;--------------------------------------------------------------------------------------
	ELSEIF CFLAG:모자 == 17 && CFLAG:전신복 == 321 && CFLAG:손 == 407 && CFLAG:신발 == 914
		PRINTFORML 고양이 분장을 한 %CALLNAME%의 모습은、실로 사랑스럽다。
		IF CFLAG:속옷（하） == 615
			PRINTFORM 그
			SIF TALENT:남자 == 0
				PRINTFORM 녀
			PRINTFORML 가 움직일 때마다 꼬리가 살랑살랑 흔들려、꽂힌 플러그가 %CALLNAME%에게
			IF ABL:Ａ감각 >= 5
				PRINTFORM 쾌감
			ELSEIF ABL:Ａ감각 >= 3 || TALENT:Ａ민감
				PRINTFORM 통증과도 비슷한 옅은 쾌감
			ELSE
				PRINTFORM 고통
			ENDIF
			PRINTFORMW 을 주고 있는 것 같다。
		ELSE
			;改行を入れる
			PRINTFORMW 　
		ENDIF
	;--------------------------------------------------------------------------------------
	;네코미미카츄샤　＆　キャットランジェリー上下　＆　服・下衣・全身服なし
	;↑の差分
	;肉球グローブ、ファーグローブ、肉球ぶーつ、キャットソックスにも対応
	;--------------------------------------------------------------------------------------
	ELSEIF CFLAG:모자 == 17 && CFLAG:속옷（상） == 531 && CFLAG:속옷（하）== 641 && CFLAG:옷 == 0 && CFLAG:하의 == 0 && CFLAG:전신복 == 0
		PRINTFORML 고양이 분장을 한 %CALLNAME%의 모습은、실로 사랑스럽다。
		IF CFLAG:손 == 407 || CFLAG:손 == 417 || CFLAG:신발 == 914 || CFLAG:양말 == 811 
			PRINTFORM 그
			IF CFLAG:손 == 407 || CFLAG:손 == 417
				PRINTFORM 복슬복슬한 양손
			ENDIF
			IF CFLAG:신발 == 914 || CFLAG:양말 == 811 
				SIF CFLAG:손 == 407 || CFLAG:손 == 417
					PRINTFORM 과
				PRINTFORM 따뜻해 보이는 양발
			ENDIF
			PRINTFORML 까지 어우러져、
			PRINTFORMW 그 모습이 마치 자신이 애완동물이라고 주장하는 듯하다。
		ELSE
			;改行を入れる
			PRINTFORMW 　
		ENDIF
	;--------------------------------------------------------------------------------------
	;上半身裸のサスペンダースカートのみ
	;--------------------------------------------------------------------------------------
	ELSEIF CFLAG:옷 == 0 && CFLAG:속옷（상） == 0 && CFLAG:전신속옷 == 0 && CFLAG:하의 == 213
		PRINTFORM 몸에 걸친 것이 스커트와、상반신을 간신히 가리는 얇은 멜빵뿐이라는 것에、%CALLNAME은% 
		IF (ABL:노출증 >= 5 && !TALENT:부끄럼쟁이) && ABL:욕망 >= 5
			PRINTFORM 수치와 쾌락을 느끼고
		ELSEIF (ABL:노출증 >= 3 && !TALENT:부끄럼쟁이) && (TALENT:부끄럼없음 || TALENT:정조관결여)
			PRINTFORM 약간 흥분해
		ELSE
			PRINTFORM 수치를 느끼고
		ENDIF
		PRINTFORML 있는 것 같다。
		PRINTFORM 가슴 끝을 간신히 가리고 있는 멜빵을、%CALLNAME%
		IF TALENT:절벽 || (TALENT:오토코노코 && TALENT:절벽)
			PRINTFORMW %조사만처리(CALLNAME,"는")% 자꾸 신경 쓰고 있다。
		ELSE
			PRINTFORM 의 가슴이
			SIF TALENT:거유 || TALENT:폭유 || TALENT:마유
				PRINTFORM 크게 
			SIF TALENT:빈유
				PRINTFORM 약간 
			PRINTFORMW 밀어 올리고 있다。
		ENDIF
	;--------------------------------------------------------------------------------------
	;上下ピアス＆服・下衣なし
	;--------------------------------------------------------------------------------------
	ELSEIF CFLAG:속옷（상） == [[衣装:니플피어스]] && CFLAG:속옷（하） == [[衣装:라비아피어스]] && CFLAG:옷 == 0 && CFLAG:하의 == 0 && CFLAG:전신복 == 0
		PRINTFORM 피어스로 장식된 나신을、%CALLNAME은% 
		IF (ABL:노출증 >= 5 && !TALENT:부끄럼쟁이) || (ABL:노출증 >= 3 && TALENT:부끄럼없음)
			PRINTFORML 아랑곳하지 않고 %CALLNAME:MASTER%의 시선에 노출시키고 있다。
		ELSEIF (ABL:노출증 >= 3 && !TALENT:부끄럼쟁이) || TALENT:부끄럼없음
			PRINTFORML 부끄러워하며 %CALLNAME:MASTER%의 시선에 노출시키고 있다。
		ELSE
			PRINTFORML %CALLNAME:MASTER%의 시선에서 필사적으로 숨기려 하고 있다。
		ENDIF
		PRINTFORM 가슴과 가랑이에서 피어스가 흔들릴 때마다、
		IF RAND:4 == 0 && (TALENT:복종 || TALENT:예속)
			PRINTFORMW 복종의 즐거움을 느끼고 있는 것 같다。
		ELSEIF RAND:4 == 1 && (TALENT:마조 || ABL:마조끼 >= 5)
			PRINTFORMW 피학의 즐거움을 느끼고 있는 것 같다。
		ELSEIF RAND:4 == 2 && (ABL:욕망 >= 5 || TALENT:음란 || TALENT:창부)
			PRINTFORMW 쾌감에 몸을 떨고 있다。
		ELSE
			PRINTFORMW 몸을 배배 꼬고 있다。
		ENDIF
	;--------------------------------------------------------------------------------------
	;네글리제　＆　服・下衣・全身服なし
	;ベビードールでも可とするように修正
	;--------------------------------------------------------------------------------------
	ELSEIF (CFLAG:속옷（상） == 506 || CFLAG:속옷（상） == 532 ) && CFLAG:옷 == 0 && CFLAG:하의 == 0 && CFLAG:전신복 == 0
		PRINTFORM 얇은 천 너머로 비쳐보이는 
		IF TALENT:절벽 || (TALENT:오토코노코 && TALENT:절벽)
			PRINTFORM 가슴과
		ELSEIF TALENT:거유 || TALENT:폭유 || TALENT:마유
			PRINTFORM 풍만한 젖가슴과 
		ELSE
			PRINTFORM 유방과 
		ENDIF
		;下半身下着あり（穴開きとか以外）
		IF (CFLAG:속옷（하） || CFLAG:전신속옷) && CFLAG:속옷（하） != 603 && CFLAG:속옷（하） != 615 && CFLAG:속옷（하） != [[衣装:라비아피어스]] && CFLAG:전신속옷 != 702 && CFLAG:전신속옷 != 705 && CFLAG:전신속옷 != 711 && CFLAG:전신속옷 != 714
			PRINTFORM 속옷 한 장뿐인 
		ELSE
			PRINTFORM 노출된 
		ENDIF
		PRINTFORM 가랑이를、%CALLNAME은% 
		IF (ABL:노출증 >= 5 && !TALENT:부끄럼쟁이) || (ABL:노출증 >= 3 && TALENT:부끄럼없음)
			PRINTFORMW 아낌없이 노출하고 있다。
		ELSEIF (ABL:노출증 >= 3 && !TALENT:부끄럼쟁이) || TALENT:부끄럼없음
			PRINTFORMW 부끄러워하며 노출하고 있다。
		ELSE
			PRINTFORMW 필사적으로 숨기고 있다。
		ENDIF
		;もう一行分くらい欲しいけど思いつかない
	;--------------------------------------------------------------------------------------
	;メイド服系＋ホワイトプリム＋가터스타킹
	;エプロンドレス、ヘッドドレスでも可とするように修正
	;--------------------------------------------------------------------------------------
	ELSEIF (CFLAG:전신복 == 308 || CFLAG:전신복 == 309 || CFLAG:전신복 == 307 ) && (CFLAG:모자 == 1 || CFLAG:모자 == 21 ) && CFLAG:양말 == 805
		PRINTFORM 메이드복을 입은 %CALLNAME은% 
		IF (ABL:순종 >= 3 || TALENT:헌신적 || TALENT:복종 || TALENT:예속) && MARK:3 != 3
			PRINTFORML 언제나와 같이 주인인 %CALLNAME:MASTER%에게 순종적이다。
			IF TALENT:소악마
				PRINTFORMW …분명 공손한 자세인데、놀리는 듯한 태도로 보이는 것은、기분 탓일까。
			ELSE
				PRINTFORMW …오늘의 조교는、기대할 만하다。
			ENDIF
		ELSE
			PRINTFORML 평소보다 순종적으로 보인다。
			PRINTFORMW …오늘의 조교는、기대할 만하다。
		ENDIF
	;--------------------------------------------------------------------------------------
	;윔플＋법의
	;--------------------------------------------------------------------------------------
	ELSEIF CFLAG:모자 == 54 && CFLAG:전신복 == 318
		PRINTFORM 수녀복 차림의 %CALLNAME%는、
		IF (ABL:순종 >= 3 || TALENT:헌신적 || TALENT:복종 || TALENT:예속) && MARK:3 != 3
			PRINTFORML %CALLNAME:MASTER%를 주인으로 삼아、경건하고 조신하게 섬기고 있는 듯한 모습이다。
			IF TALENT:소악마
				PRINTFORMW …공손해야 할 텐데、놀리는 듯한 태도로 보이는 것은、기분 탓일까。
			ELSE
				PRINTFORMW …오늘의 조교는、기대해도 좋을 듯하다。
			ENDIF
		ELSE
			PRINTFORML 왠지 경건해 보이는 모습이다。
			PRINTFORMW …오늘의 조교는、기대해도 좋을 듯하다。
		ENDIF
	;--------------------------------------------------------------------------------------
	;세일러복＋スカート（ロング・ミニ含む）
	;--------------------------------------------------------------------------------------
	;ELSEIF CFLAG:옷 == 102 && (CFLAG:하의 == 201 || CFLAG:하의 == 205 || CFLAG:하의 == 207)
	;
	;--------------------------------------------------------------------------------------
	;블라우스＋スカート（ロング・ミニ含む）＋블레이저교복
	;--------------------------------------------------------------------------------------
	;ELSEIF CFLAG:옷 == 107 && (CFLAG:하의 == 201 || CFLAG:하의 == 205 || CFLAG:하의 == 207) && CFLAG:겉옷 == 3
	;
	;--------------------------------------------------------------------------------------
	;リボンorカチューシャorヘアバンド＋メイド服orウェイター服orディアンドル
	;給仕系
	;--------------------------------------------------------------------------------------
	ELSEIF (CFLAG:모자 == 5 || CFLAG:모자 == 11 || CFLAG:모자 == 12 ) && (CFLAG:전신복 == 308 || CFLAG:전신복 == 344 || CFLAG:전신복 == 345 )
		IF CFLAG:전신복 == 344
			PRINTFORM 유니섹스한 
		ELSE
			PRINTFORM 사랑스러운 
		ENDIF
		PRINTFORM 급사복을 그
		IF TALENT:거유 || TALENT:폭유 || TALENT:마유
			PRINTFORM 육감적인 몸에 
		ELSEIF TALENT:유아체형 || TALENT:빈유 || TALENT:절벽
			PRINTFORM 앳된 몸에 
		ELSEIF TALENT:소인체형
			PRINTFORM 작은 몸에 
		ENDIF
		PRINTFORML 걸친 %CALLNAME%의 모습은、실로 매력적이다。
		PRINTFORMW 이대로 식당에서 일하게 해도、전혀 위화감이 없을 것이다。
	;--------------------------------------------------------------------------------------
	;토끼귀밴드＋바니수트＋ピンヒールorハイヒールorパンプスorミュール
	;バニーガール系(むしろなんで今までなかったのさ？)
	;--------------------------------------------------------------------------------------
	ELSEIF CFLAG:모자 == 4 && CFLAG:전신복 == 311 && (CFLAG:신발 == 906 || CFLAG:신발 == 907 || CFLAG:신발 == 910 || CFLAG:신발 == 911 )
		;バニー
		PRINTFORM 바니복을 그 
		IF TALENT:유아체형
			PRINTFORM 미성숙한 
		ELSEIF TALENT:소인체형
			PRINTFORM 작은 
		ELSEIF TALENT:거유 || TALENT:폭유 || TALENT:마유
			PRINTFORM 풍만한 
		ELSE
			PRINTFORM 지
		ENDIF
		PRINTFORML 체에 걸친 %CALLNAME%의 모습은、실로 선정적이다。
		IF TALENT:거유 || TALENT:폭유 || TALENT:마유
			PRINTFORMW 천을 밀어 올리는 가슴이 강조되어、색기가 감돌고 있다。
		ELSEIF TALENT:절벽
			PRINTFORM 가슴 부분은 금방이라도 흘러내릴 듯
			IF (ABL:노출증 >= 5 && !TALENT:부끄럼쟁이) || (ABL:노출증 >= 3 && TALENT:부끄럼없음)
				PRINTFORMW 하지만、본인은 딱히 신경 쓰지 않는다。
			ELSE
