	PRINTFORML %"ＭＡＧ",12,LEFT% {GET_CHARA_STOCK_MAG(ARG) - TCVAR:ARG:획득ＭＡＧ,16,RIGHT}      \@TCVAR:ARG:획득ＭＡＧ > 0 ? + # - \@{ABS(TCVAR:ARG:획득ＭＡＧ),16,RIGHT} = {GET_CHARA_STOCK_MAG(ARG),16,RIGHT}
TCVAR:ARG:획득ＭＡＧ = 0
