


@LVUP_AUTOIF2_DEFAULT(ARG)

SIF EXISTCSV(NO:ARG) == 0
	GOTO SET_BASE
;元非戦闘員暫定処理
SIF CSVTALENT(NO:ARG,GETNUM(TALENT,"비전투원"),0)
	GOTO SET_BASE
;ランダムキャラ暫定対応
SIF INRANGE(NO:ARG, 4901, 4912)
	GOTO SET_BASE

LOCAL:1 = CSVBASE(NO:ARG,GETNUM(BASE,"힘")) + CSVBASE(NO:ARG,GETNUM(BASE,"지혜")) + CSVBASE(NO:ARG,GETNUM(BASE,"마력")) + CSVBASE(NO:ARG,GETNUM(BASE,"내구")) + CSVBASE(NO:ARG,GETNUM(BASE,"속도")) + CSVBASE(NO:ARG,GETNUM(BASE,"운"))
SIF LOCAL:1 == 0
	GOTO SET_BASE
FOR LOCAL,0,6
	CFLAG:ARG:(GETNUM(CFLAG,"힘상승률")+LOCAL) = CSVBASE(NO:ARG,GETNUM(BASE,"힘")+LOCAL) * 100 / LOCAL:1
NEXT
;全てが同じ平坦タイプの場合は現在ステータスから反映
IF GROUPMATCH(CFLAG:ARG:힘상승률,CFLAG:ARG:지상승률,CFLAG:ARG:마상승률,CFLAG:ARG:내상승률,CFLAG:ARG:속상승률,CFLAG:ARG:운상승률) == 5
	$SET_BASE
	LOCAL:1 = MAX(SUMARRAY(BASE:ARG:0,GETNUM(BASE,"힘"),GETNUM(BASE,"운")+1), 1)
	FOR LOCAL,0,6
		CFLAG:ARG:(GETNUM(CFLAG,"힘상승률")+LOCAL) = BASE:ARG:(GETNUM(BASE,"힘")+LOCAL) * 100 / LOCAL:1
	NEXT
ENDIF

@PROPSET_LVUP_AUTOIF2
RESULTS '= "NO_NAME_AUTOIF2"

@SET_VAR_INFO_DATA_AUTOIF2_HEADER
INFO_HEADER += TOALIGNMENT("성장률", 16, "CENTER")

;@LISTVIEW_LVUP_AUTOIF2(ARG)
@GET_VAR_INFO_DATA_AUTOIF2, ARG
;IF FLAG:커스텀게임화면
;	RESULTS = [{ARG,2}] %CALLNAME:ARG,24,LEFT%
;ELSE
;	RESULTS = [{ARG,2}] %CALLNAME:ARG,16,LEFT%
;ENDIF
LOCAL:2 = SUMARRAY(CFLAG:ARG:0,GETNUM(CFLAG,"힘상승률"),GETNUM(CFLAG,"운상승률")+1)
IF LOCAL:2 == 0
	CALL LVUP_AUTOIF2_DEFAULT(ARG)
	LOCAL:2 = SUMARRAY(CFLAG:ARG:0,GETNUM(CFLAG,"힘상승률"),GETNUM(CFLAG,"운상승률")+1)
	LOCAL:2 = MAX(1,LOCAL:2)
ENDIF
FOR LOCAL:1,0,6
	LOCAL:3 = CFLAG:ARG:(GETNUM(CFLAG,"힘상승률")+LOCAL:1)
	LOCAL:4 = LOCAL:3 * 1000 / LOCAL:2
	LOCALS = {LOCAL:3,3}\({LOCAL:4/10,2}.{LOCAL:4%10}\%\)
	CALL SETCOLOR_AUTOIF2(LOCAL:4)
	RESULTS += SET_COLOR_TAG(@"%BASENAME:(GETNUM(BASE,"힘")+LOCAL:1),4,LEFT%%LOCALS,8%　", TOSTR(GETCOLOR()))
NEXT
RESETCOLOR
;PRINTL

@CASTING_LVUP_AUTOIF2(ARG)
SIF ARG < 0 || ARG >= CHARANUM
	RETURN 0
SIF TALENT:ARG:비전투원
	RETURN 0
SIF CFLAG:ARG:이자리에없는플래그 == 1
	RETURN 0
SIF CFLAG:ARG:필터링플래그
	RETURN 0
RETURN 1

@LVUP_AUTOIF2_SETUP
#DIM L_LINE
L_LINE = LINECOUNT

;CALL INPUT_CHARA_LIST("設定するキャラクターを選んでください", "CASTING_LVUP_AUTOIF2")

{
CALL INPUT_CHARA_LIST
	, "PROPSET_LVUP_AUTOIF2"
	, "설정할 캐릭터를 선택해 주십시오"
	, "CASTING_LVUP_AUTOIF2" 
	, "SHOW_ADD_UP_FUNCTION"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
LOCAL = RESULT

SIF LOCAL == 1000
	RETURN
CALL CASTING_LVUP_AUTOIF2(LOCAL)
IF RESULT
	CALL LVUP_AUTOIF2_CHARASET(LOCAL)
ENDIF

CLEARLINE LINECOUNT-L_LINE

RESTART

;能力比率が高い程色が濃くなる関数
@SETCOLOR_AUTOIF2(ARG)
IF ARG <= 100
	LOCAL = ARG * 3 / 2 + 5
	SETCOLOR 155,LOCAL,LOCAL
ELSEIF ARG <= 300
	LOCAL = 155+(ARG-100)/2
	SETCOLOR 155,155,LOCAL
ELSE
	LOCAL = 155+(ARG-300)/4
	SETCOLOR MIN(255,LOCAL),150,255
ENDIF

@SETCOLOR_AUTOIF2_改(ARG,ARG:1)
#LOCALSIZE 5
;ARG　キャラ番号
;ARG:1能力値(1　힘～)
SIF !GROUPMATCH(FLAG:레벨업시인터페이스설정, 3, 4) || ARG < 0 || CFLAG:ARG:PT플래그 < 1 || !(INRANGE(ARG:1, 1, 6))
	RETURN
LOCAL:2 = SUMARRAY(CFLAG:ARG:0,GETNUM(CFLAG,"힘상승률"),GETNUM(CFLAG,"운상승률")+1)
IF LOCAL:2 == 0
	CALL LVUP_AUTOIF2_DEFAULT(ARG)
	LOCAL:2 = SUMARRAY(CFLAG:ARG:0,GETNUM(CFLAG,"힘상승률"),GETNUM(CFLAG,"운상승률")+1)
	LOCAL:2 = MAX(1,LOCAL:2)
ENDIF
LOCAL:3 = CFLAG:ARG:(GETNUM(CFLAG,"힘상승률") - 1 + ARG:1)
LOCAL:4 = LOCAL:3 * 1000 / LOCAL:2
IF LOCAL:4 <= 100
	LOCAL = LOCAL:4 * 3 / 2 + 5
	SETCOLOR 155,LOCAL,LOCAL
ELSEIF LOCAL:4 <= 300
	LOCAL = 155+(LOCAL:4-100)/2
	SETCOLOR 155,155,LOCAL
ELSE
	LOCAL = 155+(LOCAL:4-300)/4
	SETCOLOR MIN(255,LOCAL),150,255
ENDIF

@SETCOLOR_AUTOIF2_F(ARG)
#FUNCTION
LOCAL:1 = GETCOLOR()
IF ARG <= 100
	LOCAL = ARG * 3 / 2 + 5
	SETCOLOR 155,LOCAL,LOCAL
ELSEIF ARG <= 300
	LOCAL = 155+(ARG-100)/2
	SETCOLOR 155,155,LOCAL
ELSE
	LOCAL = 155+(ARG-300)/4
	SETCOLOR MIN(255,LOCAL),150,255
ENDIF
LOCAL:2 = GETCOLOR()
SETCOLOR LOCAL:1
RETURNF LOCAL:2

@SETCOLOR_AUTOIF2_F改(ARG,ARG:1)
#FUNCTION
#LOCALSIZE 5
;ARG　キャラ番号
;ARG:1能力値(1　힘～)
SIF !GROUPMATCH(FLAG:레벨업시인터페이스설정, 3, 4) || ARG < 0 || CFLAG:ARG:PT플래그 < 1 || !(INRANGE(ARG:1, 1, 6))
	RETURNF GETCOLOR()
LOCAL:2 = SUMARRAY(CFLAG:ARG:0,GETNUM(CFLAG,"힘상승률"),GETNUM(CFLAG,"운상승률")+1)
SIF LOCAL:2 == 0
	RETURNF GETCOLOR()
LOCAL:3 = CFLAG:ARG:(GETNUM(CFLAG,"힘상승률") - 1 + ARG:1)
LOCAL:4 = LOCAL:3 * 1000 / LOCAL:2

LOCAL:1 = GETCOLOR()
IF LOCAL:4 <= 100
	LOCAL = LOCAL:4 * 3 / 2 + 5
	SETCOLOR 155,LOCAL,LOCAL
ELSEIF LOCAL:4 <= 300
	LOCAL = 155+(LOCAL:4-100)/2
	SETCOLOR 155,155,LOCAL
ELSE
	LOCAL = 155+(LOCAL:4-300)/4
	SETCOLOR MIN(255,LOCAL),150,255
ENDIF
LOCAL:2 = GETCOLOR()
SETCOLOR LOCAL:1
RETURNF LOCAL:2

@LVUP_AUTOIF2_CHARASET(ARG)
#DIM L_LINE
L_LINE = LINECOUNT

DRAWLINE
PRINTFORML %CALLNAME:ARG%의 능력 상승률을 변경합니다
PRINTL 상승률을 설정해 주십시오
DRAWLINE
LOCAL:2 = SUMARRAY(CFLAG:ARG:0,GETNUM(CFLAG,"힘상승률"),GETNUM(CFLAG,"운상승률")+1)
		IF LOCAL:2 == 0
			LOCAL:2 = 1
		ENDIF
FOR LOCAL:1,0,6
	LOCAL:3 = CFLAG:ARG:(GETNUM(CFLAG,"힘상승률")+LOCAL:1)
	LOCAL:4 = LOCAL:3 * 1000 / LOCAL:2
	CALL SETCOLOR_AUTOIF2(LOCAL:4)
	PRINTFORML [{LOCAL:1,2}] %CFLAGNAME:(GETNUM(CFLAG,"힘상승률")+LOCAL:1)%{LOCAL:3} \({LOCAL:4/10}.{LOCAL:4%10}\%\)
NEXT
RESETCOLOR
PRINTFORML [ 7] 프리셋을 사용한다
PRINTFORML [ 8] 디폴트로 되돌린다
PRINTFORML [ 9] 결정
ONEINPUT
LOCAL = RESULT
SELECTCASE RESULT
CASE 7
	FOR LOCAL,0,10
		CALL LVUP_AUTOIF2_PLIST(LOCAL)
		SIF !RESULT
			CONTINUE
		PRINTFORM [{LOCAL,2}] %RESULTS,16,LEFT%
		FOR LOCAL:1,0,6
			LOCAL:3 = RESULT:(LOCAL:1+1)
			LOCAL:4 = LOCAL:3 * 1000 / RESULT:7
			LOCALS = {LOCAL:3,3}\({LOCAL:4/10,2}.{LOCAL:4%10}\%\)
			CALL SETCOLOR_AUTOIF2(LOCAL:4)
			PRINTFORM %BASENAME:(GETNUM(BASE,"힘")+LOCAL:1),4,LEFT%%LOCALS,8%　　
		NEXT
		RESETCOLOR
		PRINTL
	NEXT
	PRINTL [99] 취소
	INPUT
	LOCAL = RESULT
	CALL LVUP_AUTOIF2_PLIST(LOCAL)
	IF RESULT
		FOR LOCAL,0,6
			CFLAG:ARG:(GETNUM(CFLAG,"힘상승률")+LOCAL) = RESULT:(LOCAL+1)
		NEXT
	ENDIF
CASE 0,1,2,3,4,5,6
	CALL INPUT_MANY(0,99)
	CFLAG:ARG:(GETNUM(CFLAG,"힘상승률")+LOCAL) = RESULT
	
CASE 8
	CALL LVUP_AUTOIF2_DEFAULT(ARG)
CASE 9
	RETURN
ENDSELECT
CLEARLINE LINECOUNT-L_LINE
RESTART

