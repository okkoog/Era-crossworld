CASE 0
	RESULTS = 물리 전투
	RESULT:1 = 25
	RESULT:2 = 10
	RESULT:3 = 5
	RESULT:4 = 25
	RESULT:5 = 20
	RESULT:6 = 15
CASE 1
	RESULTS = 마법 전투
	RESULT:1 = 5
	RESULT:2 = 30
	RESULT:3 = 25
	RESULT:4 = 20
	RESULT:5 = 15
	RESULT:6 = 5
CASE 2
	RESULTS = 거너
	RESULT:1 = 5
	RESULT:2 = 30
	RESULT:3 = 5
	RESULT:4 = 15
	RESULT:5 = 25
	RESULT:6 = 20
CASE 3
	RESULTS = 악마변신
	RESULT:1 = 4
	RESULT:2 = 12
	RESULT:3 = 4
	RESULT:4 = 4
	RESULT:5 = 4
	RESULT:6 = 72
CASE 4
	RESULTS = 밸런스
	RESULT:1 = 10
	RESULT:2 = 10
	RESULT:3 = 10
	RESULT:4 = 10
	RESULT:5 = 10
	RESULT:6 = 10
CASEELSE
