@SHOPCOMABLE_400
RESULTS = 옵션
RETURN 1

@SHOP_COM_400, ARG
#DIMS L_COM, 200, 3
#DIM L_HIDE, 5 = 1,1,1,1,1
VARSET L_COM
;項目作成
CALL OPTION_LISTUP(L_COM)
IF FLAG:DEBUG
	CALL OPTION_LISTUP_DEBUG(L_COM)
ELSE
	[IF_DEBUG]
		CALL OPTION_LISTUP_DEBUG(L_COM)
	[ENDIF]
ENDIF
;項目表示
REDRAW 0
CLEARLINE 100000
DRAWLINE
PRINTL 설정항목을 선택해주세요
PRINTL
CALL OPTION_PRINT_LIST(L_COM, L_HIDE)
IF FLAG:DEBUG
	CALL OPTION_PRINT_LIST_DEBUG(L_COM, L_HIDE:4)
ELSE
	[IF_DEBUG]
		CALL OPTION_PRINT_LIST_DEBUG(L_COM, L_HIDE:4)
	[ENDIF]
ENDIF
PRINTL
SETCOLOR COLOR("AQUA")

PRINTFORML %"  [997] - 강화 옵션의 설정 확인 ", 50, LEFT%
PRINTFORML %"  [998] - 글로벌 데이터에 저장 ", 50, LEFT%
PRINTFORML %"  [999] - 글로벌 데이터에서 불러오기 ", 50, LEFT%
RESETCOLOR
PRINTL
PRINTFORML %"  [100] - 돌아간다 ", 50, LEFT%
REDRAW 2
;入力
CALL OPTION_INPUT(L_COM)
SELECTCASE RESULT
	;[100]-戻る
	CASE -1
		RETURN
	CASE 997
		CALL EDIT_EXTRA_GAME_OPTION, "確認モード"
	CASE 998
		CALL OPTION_GSAVE
	CASE 999
		CALL OPTION_GLOAD
	;表示/非表示
	CASE 990 TO 994
		L_HIDE:(RESULT - 990) = !L_HIDE:(RESULT - 990)
	CASE 989
		VARSET L_HIDE, !SUMARRAY(L_HIDE)
	;範囲外は既に弾いている
	CASEELSE
		CALL OPTION_SETTINGS(L_COM, RESULT)
ENDSELECT
RESTART

