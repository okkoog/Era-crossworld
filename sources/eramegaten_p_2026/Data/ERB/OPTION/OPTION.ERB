CASE 3
	INVERTBIT FLAG:커스텀게임화면 , 0
	IF GETBIT(FLAG:커스텀게임화면, 0)
		FLAG:SHOP커맨드의나열수 = 5
		FLAG:조교커맨드의나열수 = 5
		FLAG:조교파라미터의나열수 = 5
	ELSE
		FLAG:SHOP커맨드의나열수 = 3
		FLAG:조교커맨드의나열수 = 3
		FLAG:조교파라미터의나열수 = 3
		CLEARBIT FLAG:커스텀게임화면, 1
	ENDIF
CASE 4
	INVERTBIT FLAG:커스텀게임화면 , 1
CASE 5
	INVERTBIT FLAG:능력치그래프설정 , 0
	SIF !GETBIT(FLAG:능력치그래프설정, 0)
		CLEARBIT FLAG:능력치그래프설정 , 1
CASE 6
	INVERTBIT FLAG:능력치그래프설정 , 1
CASE 7 TO 10
	;カラー設定
	LOCAL:1 = RESULT - 7
	CALL COLOR_SETTER, AUTO_SPLIT("기초_장비_강화_감소", "_", LOCAL:1), FLAG:@"능력치그래프컬러{LOCAL:1+1}", AUTO_SPLIT_INT("0xe0e0e0_0xF0E070_0x9090E8_0x777777", "_", LOCAL:1)
	FLAG:@"능력치그래프컬러{LOCAL:1+1}" = RESULT
CASE 90
	SETBIT FLAG:스테이터스화면타입, 0, 1, 2
CASE 91
	FLAG:스테이터스화면타입 = 0
CASEELSE
	CLEARLINE 1
	GOTO INPUT_LOOP
ENDSELECT
REDRAW 0
CLEARLINE LINECOUNT - LOCAL
RESTART

