			SELECTCASE RESULT
				CASE 0
					PRINTFORML 보존명을 입력해주세요。미입력 혹은 0으로 %LOCALS%로 설정됩니다
					PRINTFORML [0] %LOCALS% 로 한다
					INPUTS
					IF RESULTS == "" || RESULTS == "0"
						オプション設定保存領域名:(LOCAL:1) = %LOCALS%
					ELSE
						オプション設定保存領域名:(LOCAL:1) = %RESULTS%
					ENDIF
					CALL OPTION_STATE_SAVE(LOCAL:1)
					SAVEGLOBAL
					PRINTW 세이브했습니다
				CASE 1
					PRINTW 취소했습니다
			ENDSELECT
		ELSE
			PRINTFORML 보존명을 입력해주세요。미입력 혹은 0으로 %LOCALS%로 설정됩니다
			PRINTFORML [0] %LOCALS% 로 한다
			INPUTS
			IF RESULTS == "" || RESULTS == "0"
				オプション設定保存領域名:(LOCAL:1) = %LOCALS%
			ELSE
				オプション設定保存領域名:(LOCAL:1) = %RESULTS%
			ENDIF
			CALL OPTION_STATE_SAVE(LOCAL:1)
			SAVEGLOBAL
			PRINTW 세이브했습니다
		ENDIF
	CASE 5
