;=====================================
;[38]화상표시설정
;=====================================
@ICON_SET
#LOCALSIZE 1
#DIM L_FLAGNO, 6
#DIMS L_ITEM, 6
#DIMS L_SELECT, 4 = "없음", "あり、画像のないキャラは種族アイコン表示", "あり、画像のないキャラはオニマーク表示", "あり、全キャラにオニマーク表示"
REDRAW 0
;表示
DRAWLINE
PRINTL
PRINTL 개별 아이콘　　 / 모든 캐릭터 아이콘을 미사용(공백 표시) 또는 오니 아이콘으로 설정할 수 있습니다。
PRINTL 대체 화상　　　 / 고유 아이콘이 없을 경우에 사용할 아이콘 설정입니다
PRINTL 조교 화면　　　 / 조교 화면에서 화상을 사용할지에 대한 설정입니다
PRINTL 링크 악마　　　 / 링크한 악마로 변신할 때 아이콘을 링크 악마에 따를지에 대한 설정입니다。
;---- EDIT 047 ADD START -------------------------
PRINTFORM [0] %"개별 아이콘", 24, LEFT%
SELECTCASE G_OPT_USE_ICON
	CASE "使用"
		PRINTL [사용한다]
	CASE "사용안함"
		PRINTL [사용안함]
	CASE "鬼アイコン"
		PRINTL [오니 아이콘]
ENDSELECT
PRINTFORM [1] %"대체 화상", 24, LEFT%
SELECTCASE G_OPT_REPLACE_ICON
	CASE "種族アイコン"
		PRINTL [종족 아이콘]
	CASE "鬼アイコン"
		PRINTL [오니 아이콘]
ENDSELECT
PRINTFORM [2] %"조교 화면", 24, LEFT%
SELECTCASE G_OPT_NOT_USE_ICON_AT_TRAIN
	CASE 0
		PRINTL [사용한다]
	CASE 1
		PRINTL [사용안함]
ENDSELECT
PRINTFORM [3] %"링크 악마", 24, LEFT%
SELECTCASE G_OPT_USE_LINK_DEVIL_ICON
	CASE "リンク優先"
		PRINTL [링크 악마의 화상을 사용]
	CASE "リンク不使用"
		PRINTL [링크 악마의 화상을 사용안함]
	CASE "固有優先使用"
		PRINTL [화상이 없는 캐릭터는 링크 악마에 따름]
ENDSELECT

;---- EDIT 047 ADD END ---------------------------
PRINTL [100] - 돌아간다
INPUT
VARI TEMPNUM
SELECTCASE RESULT
	CASE 100
		RETURN
	CASE 0
		TEMPNUM = FINDELEMENT(G_OPT_USE_ICON_TABLE, G_OPT_USE_ICON, , , 1)
		IF TEMPNUM + 1 == VARSIZE("G_OPT_USE_ICON_TABLE")
			G_OPT_USE_ICON '= G_OPT_USE_ICON_TABLE:0
		ELSE
			G_OPT_USE_ICON '= G_OPT_USE_ICON_TABLE:(TEMPNUM + 1)
		ENDIF
	CASE 1
		TEMPNUM = FINDELEMENT(G_OPT_REPLACE_ICON_TABLE, G_OPT_REPLACE_ICON, , , 1)
		IF TEMPNUM + 1 == VARSIZE("G_OPT_REPLACE_ICON_TABLE")
			G_OPT_REPLACE_ICON '= G_OPT_REPLACE_ICON_TABLE:0
		ELSE
			G_OPT_REPLACE_ICON '= G_OPT_REPLACE_ICON_TABLE:(TEMPNUM + 1)
		ENDIF
	CASE 2
		G_OPT_NOT_USE_ICON_AT_TRAIN = !G_OPT_NOT_USE_ICON_AT_TRAIN
	CASE 3
		TEMPNUM = FINDELEMENT(G_OPT_USE_LINK_DEVIL_ICON_TABLE, G_OPT_USE_LINK_DEVIL_ICON, , , 1)
		IF TEMPNUM + 1 == VARSIZE("G_OPT_USE_LINK_DEVIL_ICON_TABLE")
			G_OPT_USE_LINK_DEVIL_ICON '= G_OPT_USE_LINK_DEVIL_ICON_TABLE:0
		ELSE
			G_OPT_USE_LINK_DEVIL_ICON '= G_OPT_USE_LINK_DEVIL_ICON_TABLE:(TEMPNUM + 1)
		ENDIF
	CASEELSE
ENDSELECT
SAVEGLOBAL
RESTART

