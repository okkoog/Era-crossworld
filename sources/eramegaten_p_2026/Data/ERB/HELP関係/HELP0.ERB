;調教典メニュー
;--------------------------------------------------
@DICTIONARY_MENU
DRAWLINE
PRINTL 어느 항목을 알아보시겠습니까？
PRINTL 알아보고 싶은 항목의 번호를 입력하거나、클릭해주세요。
DRAWLINE
SETCOLOR 0xff00ff
PRINTL 【조교】
RESETCOLOR
PRINTLC [ 1] 능력
PRINTLC [ 2] 각인
PRINTLC [ 3] 소질
PRINTLC [ 4] 경험
PRINTLC [ 5] 구슬
PRINTLC [ 6] 소스
PRINTLC [ 7] 조교아이템
PRINTLC [ 8] 체질변화약
PRINTLC [ 9] 조교커맨드의 설명
PRINTL [10] 이상경험의 획득 조건
SETCOLOR 0xffde86
PRINTL 【그외】
RESETCOLOR
PRINTLC [20] 스테이터스
PRINTLC [21] SHOP커맨드의 설명
PRINTLC [22] OPTION의 설명
PRINTLC [23] 그 외 수치
PRINTLC [24] END의 조건(스포일러)
PRINTLC [25] 스포일러 정보
PRINTL [26] 초심자의 추천
SETCOLOR 0x0099cc
PRINTL 【로그・이력・장부】
RESETCOLOR
PRINTLC [31] 미션 로그
PRINTLC [32] 함락 이력
PRINTLC [33] 장부 열람
PRINTL 
PRINTL [100]그만둔다
DRAWLINE
$INPUT_LOOP
INPUT
IF RESULT == 100
	RETURN 0
ELSEIF RESULT == 1
	;能力
	CALL DICTIONARY_ABL_MAIN
ELSEIF RESULT == 2
	;刻印
	CALL DICTIONARY_MARK_MAIN
ELSEIF RESULT == 3
	;素質
	CALL DICTIONARY_TALENT_MAIN
ELSEIF RESULT == 4
	;経験
	CALL DICTIONARY_EXP_MAIN
ELSEIF RESULT == 5
	;珠
	CALL DICTIONARY_JUEL_MAIN
ELSEIF RESULT == 6
	;ソース
	CALL DICTIONARY_SOURCE_MAIN
ELSEIF RESULT == 7
	;アイテム
	CALL DICTIONARY_ITEM_MAIN
ELSEIF RESULT == 8
	;体質変化薬
	CALL DICTIONARY_DRUG_MAIN
ELSEIF RESULT == 9
	;調教コマンドの説明
	CALL DICTIONARY_T_COMMAND_MAIN
ELSEIF RESULT == 10
	;異常経験の獲得条件
	CALL DICTIONARY_ABNORMAL_EXP_MAIN
ELSEIF RESULT == 20
	;ステータスの解説
	CALL DICTIONARY_STATUS_MAIN
ELSEIF RESULT == 21
	;SHOPコマンドの説明
	CALL DICTIONARY_SHOP_COMMAND
ELSEIF RESULT == 22
	;OPTIONの説明
	CALL DICTIONARY_CONFIG_MAIN
ELSEIF RESULT == 23
	;その他の数値
	CALL DICTIONARY_OTHER_MAIN
ELSEIF RESULT == 24
	;ENDの条件(ネタバレ)
	CALL DICTIONARY_END_NETABARE_MAIN
ELSEIF RESULT == 25
	;ネタばれ情報
	CALL DICTIONARY_NETABARE_MAIN
ELSEIF RESULT == 26
	;初心者Ｑ＆Ａ
	CALL DICTIONARY_EASY_QA
ELSEIF RESULT == 31
	;ミッションログ
	CALL DICTIONARY_MISSION_MAIN
ELSEIF RESULT == 32
	;陥落履歴
	CALL DICTIONARY_FALLED_MAIN
ELSEIF RESULT == 33
	;帳簿の閲覧
	CALL ACCOUNTING_BOOKS_MAIN
ELSE
	GOTO INPUT_LOOP
ENDIF
RESTART

