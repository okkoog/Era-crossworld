ENDIF
DRAWLINE
PRINTFORMLC \@(ページ数 <= 0) ? %" " * 18% # [1001]이전페이지\@
PRINTLC [1000]돌아간다
PRINTFORMLC \@(ページ数 >= 最大ページ数) ? %" " * 18% # [1009]뒤쪽페이지\@
$INPUT_LOOP
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1001 && ページ数 > 0
	ページ数 -= 1
	GOTO PRINT_LIST
ELSEIF RESULT == 1009 && ページ数 < 最大ページ数
	ページ数 += 1
	GOTO PRINT_LIST
ENDIF
SIF RESULT < 0 && RESULT >= (最大ページ数+1) * 10
	GOTO INPUT_LOOP
CALL DICTIONARY_STATUS_DATA,RESULT
GOTO PRINT_LIST

