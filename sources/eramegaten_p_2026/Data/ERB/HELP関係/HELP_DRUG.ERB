INPUT
SIF RESULT == 1000
	RETURN 0
SIF RESULT < 0 && RESULT >= 1000
	GOTO INPUT_LOOP
CALL DICTIONARY_DRUG_DATA,RESULT
GOTO PRINT_LIST
