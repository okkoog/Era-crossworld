@DICTIONARY_FALLED_MAIN
#DIM DYNAMIC PAGE
#DIM DYNAMIC RACE
#DIM DYNAMIC LINE
#DIMS CONST PRINT_TABLE = "연모", "친애", "음란", "창부", "복종", "예속", "신뢰", "동료", "처녀"
#DIM C_NO
#DIM L_COUNT, 3
#LOCALSIZE 1000
LINE = LINECOUNT
RACE = -1
PAGE = 0
$START
VARSET LOCAL, -1
CLEARLINE LINECOUNT
DRAWLINE
L_COUNT:1 = 0
;リスト登録
FOR L_COUNT, 0, CSVCHARANUM
	;一応CSVの存在で弾く
	SIF !EXISTCSV(L_COUNT, 0)
		CONTINUE
	;加入させたことがあるキャラのみ
	SIF !IS_CHARA_COMPANIONED:L_COUNT
		CONTINUE
	;種族が一致していない
	SIF RACE != CSVABL(L_COUNT, GETNUM(ABL, "종족"), 0)
		CONTINUE
	;魔人の娘も除外
	SIF L_COUNT == [[キャラ:당신]]
		CONTINUE
	SIF L_COUNT == [[キャラ:더미아나타]]
		CONTINUE
	SIF L_COUNT == [[キャラ:당신의딸]]
		CONTINUE
	SIF L_COUNT == [[キャラ:노예의딸]]
		CONTINUE
	LOCAL:(L_COUNT:1) = L_COUNT
	L_COUNT:1++
NEXT

IF RACE != 999
	;リスト表示
	FOR L_COUNT, 0 , 40
		C_NO = LOCAL:(PAGE * 40 + L_COUNT)
		IF C_NO >= 0
			SIF GET_陥落履歴_陥落強度(C_NO) > 0
				SETCOLOR COLOR("PINK")
			PRINTPLAINFORM [{C_NO,4}] %CSVCALLNAME(C_NO, 0), 20, LEFT%
			RESETCOLOR
			;処女履歴を後ろに表示させるため力技で解決
			FOR L_COUNT:1, 0, VARSIZE("PRINT_TABLE")
				IF GET_陥落履歴(C_NO, PRINT_TABLE:(L_COUNT:1))
					SETCOLOR COLOR("aqua")
				ELSE
					SETCOLOR COLOR("light-gray")
				ENDIF
				IF PRINT_TABLE:(L_COUNT:1) == "처녀"
					PRINT 처녀
				ELSE
					PRINTFORM %CHARATU(PRINT_TABLE:(L_COUNT:1), 0)%
				ENDIF
				RESETCOLOR
			NEXT
			PRINT 　　
		ELSE
			PRINTFORM %" "*53%
		ENDIF
		SIF L_COUNT % 2
			PRINTL 
	NEXT
ELSEIF RACE == 999
	;陥落数
	VARSET LOCAL
	FOR L_COUNT, 0, CSVCHARANUM
		SIF !EXISTCSV(L_COUNT, 0)
			CONTINUE
		SIF GET_陥落履歴_陥落強度(L_COUNT) > 0
			LOCAL:CSVABL(L_COUNT, GETNUM(ABL, "종족"), 0)++
	NEXT

	FOR L_COUNT, 0 ,74
		;とりあず除外
		SIF GROUPMATCH(STR:L_COUNT, "어령", "보스전용", "링크전용", "페르소나전용", "페르소나２", "음마", "")
			CONTINUE
		;調教可能な種族だけ表示
		PRINTFORML  %STR:L_COUNT,6,LEFT% : {LOCAL:L_COUNT,3} 체 함락
	NEXT
	VARSET LOCAL, -1
ENDIF

DRAWLINE
;とりあえず人間を含んだ一般種族のみ
L_COUNT:1 = 0
FOR L_COUNT, 0, 73
	SIF STR:L_COUNT == ""
		CONTINUE
	;とりあず除外
	SIF GROUPMATCH(STR:L_COUNT, "어령", "보스전용", "링크전용", "페르소나전용", "페르소나２", "음마", "")
		CONTINUE
	PRINTFORM [{L_COUNT,2}] %STR:L_COUNT,8,LEFT%
	SIF L_COUNT:1 % 6 == 5
		PRINTL 
	L_COUNT:1++
NEXT
PRINTFORM [73] %STR:73,8,LEFT%

PRINTFORM [999] 함락수

SIF !LINEISEMPTY()
	PRINTL 
DRAWLINE
IF PAGE > 0
	PRINTFORM %"[ 99] 이전페이지",30,LEFT%
ELSE
	PRINTFORM %"",30,LEFT%
ENDIF
PRINTFORM %"[100] 돌아간다",30,LEFT%
SIF LOCAL:((PAGE+1) * 40) >= 0
	PRINTFORM %"[101] 다음페이지",30,LEFT%
PRINTL 
INPUT
SIF RESULT == 99 && PAGE > 0
	PAGE--
SIF RESULT == 100
	RETURN 0
SIF RESULT == 101 && PAGE < 8 && LOCAL:((PAGE+1) * 40) >= 0
	PAGE++
IF RANGE(RESULT, 0, 74) && !GROUPMATCH(STR:L_COUNT, "어령", "보스전용", "링크전용", "페르소나전용", "페르소나２", "음마", "") && STR:RESULT != ""
	RACE = RESULT
	PAGE = 0
ENDIF
IF RESULT == 999
	RACE = RESULT
	PAGE = 0
ENDIF
GOTO START
