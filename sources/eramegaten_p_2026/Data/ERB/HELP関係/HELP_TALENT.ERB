		RESULTS = %ADD_SPLIT(RESULTS, UNICODE(0x000D), "원인이 해소될 때까지 전투에 참가시킬 수 없다。")%
	CASE "낙적"
		RESULTS = %ADD_SPLIT(RESULTS, UNICODE(0x000D), "누군가에게서 낙적한 존재")%
		RESULTS = %ADD_SPLIT(RESULTS, UNICODE(0x000D), "매각 시、항상 LV1로 계산되는 페널티가 걸린다")%
	CASEELSE
		TRYCCALLFORM SUB_ROLE_EXPLAIN_TOOLTIP_%ARGS%
		CATCH
			IF MATCH(TALENTNAME, ARGS, GETNUM(TALENT, "검격"), GETNUM(TALENT, "검격") + SUCCESSIONNUM)
				RESULTS = %ADD_SPLIT(RESULTS, UNICODE(0x000D), @"%ARGS% 계통에 속하는 스킬의 습득 코스트가 감소하고、스킬적성도 지녔다면 성능이 강화된다。")%
			ELSE
				RESULTS = %ADD_SPLIT(RESULTS, UNICODE(0x000D), "아직 해설이 작성되지 않았습니다。")%
			ENDIF
		ENDCATCH
ENDSELECT
IF ARG >= 0 && GET_SELLPRICE_TALENT(ARG, , 1) != 0
	RESULTS = %ADD_SPLIT(RESULTS, UNICODE(0x000D), "　")%
	IF RESULTS_F != ""
		RESULTS = %ADD_SPLIT(RESULTS, UNICODE(0x000D), "가격보정:" + RESULTS_F)%
	ELSE
		IF GET_SELLPRICE_TALENT(ARG, , 1) > 0
			RESULTS = %ADD_SPLIT(RESULTS, UNICODE(0x000D), @"가격보정:+{GET_SELLPRICE_TALENT(ARG, , 1)}")%
		ELSE
			RESULTS = %ADD_SPLIT(RESULTS, UNICODE(0x000D), @"가격보정:{GET_SELLPRICE_TALENT(ARG, , 1)}")%
		ENDIF
	ENDIF
ENDIF
RETURN RESULTS != "아직 해설이 작성되지 않았습니다。"