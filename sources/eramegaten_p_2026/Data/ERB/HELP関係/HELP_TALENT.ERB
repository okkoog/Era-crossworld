@DICTIONARY_TALENT_MAIN
#DIM ページ数
#DIM 最大ページ数
ページ数 = 0
最大ページ数 = 4
$PRINT_LIST
DRAWLINE
PRINTL 「소질」에 관한 해설입니다。
PRINTL 설명을 알고 싶은 소질의 번호를 입력하거나、클릭해주세요。
PRINTFORML  ＜page.{ページ数+1}/{最大ページ数+1}＞
DRAWLINE
;各ページを表示
FOR LOCAL:1, 0, 60
	LOCAL = LOCAL:1 + ページ数*60
	SIF TALENTNAME:LOCAL !=""
		PRINTFORMLC [{LOCAL, 3}]%TALENTNAME:LOCAL%
NEXT
PRINTL 
DRAWLINE
PRINTFORMLC \@(ページ数 <= 0) ? %" " * 16% # [1001]이전페이지\@
PRINTLC [1000]돌아간다
PRINTFORMLC \@(ページ数 >= 最大ページ数) ? %" " * 16% # [1009]다음페이지\@

$INPUT_LOOP
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1001 && ページ数 > 0
	ページ数 -= 1
	GOTO PRINT_LIST
ELSEIF RESULT == 1009 && ページ数 < 最大ページ数
	ページ数 += 1
	GOTO PRINT_LIST
ENDIF
SIF RESULT < 0 &&RESULT>=最大ページ数*60
	GOTO INPUT_LOOP
SIF TALENTNAME:RESULT==""
	GOTO INPUT_LOOP
CALL DICTIONARY_TALENT_DATA,RESULT
GOTO PRINT_LIST
;--------------------------------------------------
;素質解説
;--------------------------------------------------
