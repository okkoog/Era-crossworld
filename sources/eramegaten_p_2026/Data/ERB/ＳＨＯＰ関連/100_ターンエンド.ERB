		TARGET = LCOUNT
		CALL COLLAPSE_MIND_TRAIN
		TARGET = LOCAL
	ENDIF
NEXT
;NTRイベント呼び出し
IF FLAG:ＮＴＲ기능
	FOR LOCAL,1,CHARANUM
