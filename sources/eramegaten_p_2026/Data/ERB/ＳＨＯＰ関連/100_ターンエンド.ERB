@FHASEEND_HEALTH
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC HEAL_PHYSICAL
#DIM DYNAMIC EX_HEAL_PHYSICAL

;治療もちの人数カウント
FOR L_CHARA, 0, CHARANUM
	SIF !(L_CHARA == MASTER || 陥落(L_CHARA) || CFLAG:L_CHARA:매각가능 >= 2)
		CONTINUE
	IF TALENT:L_CHARA:치료
		IF EX_HEAL_PHYSICAL == 0
			EX_HEAL_PHYSICAL = 50
		ELSE
			EX_HEAL_PHYSICAL += 10
		ENDIF
	ENDIF
NEXT
;一応上限をきっておく
EX_HEAL_PHYSICAL = LIMIT(EX_HEAL_PHYSICAL, 0, 1000)

FOR L_CHARA, 0, CHARANUM
	CALL HEALTH_CHARA,L_CHARA
	;ストレス加算処理
	IF BASE:L_CHARA:1 < MAXBASE:L_CHARA:1
		;10*消費気力の割合上昇
		CFLAG:L_CHARA:스트레스치 += 10*(MAXBASE:L_CHARA:기력 - BASE:L_CHARA:기력) / MAXBASE:L_CHARA:기력 / (1+陥落(L_CHARA))
		;25*消費体力の割合上昇
		CFLAG:L_CHARA:스트레스치 += 20*(MAXBASE:L_CHARA:체력 - BASE:L_CHARA:체력) / MAXBASE:L_CHARA:체력 / (1+陥落(L_CHARA))
	ENDIF

	;恋慕ルートキャラは自分以外が調教対象だとストレスが加算
	SIF (TALENT:L_CHARA:연모 || TALENT:L_CHARA:친애) && TARGET != L_CHARA && TARGET > -1
		CFLAG:L_CHARA:스트레스치 += 陥落(L_CHARA)

	;気力の回復
	BASE:L_CHARA:기력 = MAXBASE:L_CHARA:기력

	;レンタル中のキャラは体力回復処理無し
	SIF IS_RENTING(L_CHARA)
		GOTO SKIP_HEAL

	;体力回復停止処理
	IF CFLAG:L_CHARA:체력회복정지플래그 > 0
		CFLAG:L_CHARA:체력회복정지플래그 -= 1
		GOTO SKIP_HEAL
	ENDIF

	IF FLAG:휴식플래그
		HEAL_PHYSICAL = MAXBASE:L_CHARA:체력 * 30 / 100
	ELSE
		;基本回復量は8%
		;ターンエンド回復は20%
		IF FLAG:턴이행시
			;労役中は回復量を低下させる。
			IF CFLAG:L_CHARA:노역플래그
				HEAL_PHYSICAL = MAXBASE:L_CHARA:체력 * 10 / 100
			ELSE
				HEAL_PHYSICAL = MAXBASE:L_CHARA:체력 * 20 / 100
			ENDIF
			;調教回数が残されたままターンエンドする場合はまとめて消化する
			HEAL_PHYSICAL += MAXBASE:L_CHARA:체력 * 30 * GET_TRAINABLE_NUM() / 100
		ELSE
			;調教以外のフェイズ送りが多数あるのでターゲット差別をオミット
			HEAL_PHYSICAL = MAXBASE:L_CHARA:체력 * 12 / 100
			;HEAL_PHYSICAL = MAXBASE:L_CHARA:체력 * 8 / 100
			;ターゲット以外は追加で回復する
			;SIF TARGET != L_CHARA
			;	HEAL_PHYSICAL += MAX(MAXBASE:L_CHARA:체력 * 4 / 100, 110)
		ENDIF
	ENDIF
	;体力の回復夜の調教後は夜の休みが入るので回復大きい）(昼の調教後は昼休憩を挟むので少し大きい)
	;IF TIME == 3
	;	;霊媒体質はここでＭＡＧが貯まる
	;	SIF TALENT:L_CHARA:영매체질
	;		CALL CONTROL_MAG , L_CHARA , (GET_CHARA_STOCK_MAG(L_CHARA)* 10 - !TALENT:L_CHARA:비전투원 * 9) / 100
	;	LOCAL = MAXBASE:L_CHARA:체력 / 5
	;ELSEIF TIME == 1
	;	LOCAL = MAXBASE:L_CHARA:체력 / 10
	;ELSE
	;	LOCAL = MAXBASE:L_CHARA:체력 / 15
	;ENDIF


	;回復早い、回復遅い、蓬莱人
	IF TALENT:L_CHARA:봉래인
		TIMES HEAL_PHYSICAL, 1.80
	ELSEIF TALENT:L_CHARA:회복빠름
		TIMES HEAL_PHYSICAL, 1.50
	ELSEIF TALENT:L_CHARA:회복느림
		TIMES HEAL_PHYSICAL, 0.75
	ENDIF

	;日光浴、月光浴、吸血鬼
	;IF TIME < 2
	;	SIF TALENT:L_CHARA:일광욕
	;		LOCAL += 100
	;ELSE
	;	SIF TALENT:L_CHARA:흡혈귀
	;		TIMES LOCAL , 1.50
	;	SIF TALENT:L_CHARA:월광욕
	;		LOCAL += 100
	;ENDIF

	;치료
	;IF ASSI >= 0
	;	SIF TALENT:ASSI:치료
	;		HEAL_PHYSICAL += 150
	;ENDIF

	;治療による体力回復を実行
	HEAL_PHYSICAL += EX_HEAL_PHYSICAL

	;休憩フラグ（休憩フラグが経っている、もしくは調教対象でない）
	;IF FLAG:휴식플래그 || TARGET != L_CHARA
	;	LOCAL += 100
	;ENDIF

	;ショップで休憩を選択時
	;IF FLAG:휴식플래그 >= 2
	;	TIMES LOCAL , 2.00
	;ENDIF

	BASE:L_CHARA:체력 += HEAL_PHYSICAL
	SIF BASE:L_CHARA:체력 > MAXBASE:L_CHARA:체력
		BASE:L_CHARA:체력 = MAXBASE:L_CHARA:체력

	$SKIP_HEAL

	;崩壊判定
	IF CFLAG:L_CHARA:스트레스치 >= 100 && TALENT:L_CHARA:붕괴 == 0 && L_CHARA != MASTER
		LOCAL = TARGET
		TARGET = L_CHARA
		CALL COLLAPSE_MIND_TRAIN
		TARGET = LOCAL
	ENDIF

	;ストレス回復処理
	SIF !CFLAG:L_CHARA:체력회복정지플래그
		CFLAG:L_CHARA:스트레스치 -= ((FLAG:휴식플래그 > 0) + 1)  * MAX(3,CFLAG:L_CHARA:스트레스치 / 8)

	;ストレス値が0未満の場合は0にする
	CFLAG:L_CHARA:스트레스치 = MAX(0,CFLAG:L_CHARA:스트레스치)
NEXT
