;労役の結果を呼び出し
FOR LOCAL,0,CHARANUM
	SIF CFLAG:LOCAL:이자리에없는플래그
		CONTINUE
	;---- EDIT 018 ADD -------------------------------
	CFLAG:LOCAL:교류끝플래그 = 0
	;レンタル
	;---- EDIT 001 MOD START -------------------------
	;ここはIS_RENTINGで見ちゃいけないので注意
	IF CFLAG:LOCAL:노역플래그 == 3
		;レンタル待機状態フラグがある場合はそれを折って実際にレンタルされた状態にする
		IF CFLAG:LOCAL:17
			CFLAG:LOCAL:17 = 0
			SIF CPOS(LOCAL) > 0
				CALL REMOVE_POSITION,CPOS(LOCAL)
			PRINTFORMW %CALLNAME:LOCAL%을(를) 렌탈처에 파견했다
		ELSE
			SIF IS_RENTING(LOCAL)
				CALL RETURN_SLAVE,LOCAL
		ENDIF
	ENDIF
	;식당
	SIF CFLAG:LOCAL:노역플래그 == 1
		CALL END_RESTRANT,LOCAL
	;売春
	SIF CFLAG:LOCAL:노역플래그 == 2
		CALL END_PROSTITUTION,LOCAL
	;道場
	SIF CFLAG:LOCAL:노역플래그 == 6
		CALL END_DOJO,LOCAL
	;依頼
	SIF CFLAG:LOCAL:노역플래그 == 7 || CFLAG:LOCAL:노역플래그 == 8 || CFLAG:LOCAL:노역플래그 == 9
		CALL END_IRAI,LOCAL
NEXT
;店舗経営
FOR LOCAL,0,10
	IF DE:0:LOCAL > 0
		CALL 店舗日報,LOCAL
	ENDIF
NEXT
FOR LCOUNT, 0, CHARANUM
	;体力500未満で店舗労役しているキャラは外す
	IF BASE:LCOUNT:체력 < 500 && CFLAG:LCOUNT:노역플래그 > 9 && CFLAG:LCOUNT:노역플래그 != 3
		CFLAG:LCOUNT:노역플래그 = 0
		IF CFLAG:LCOUNT:극장출연순서 != 0
			DE:(49+(CFLAG:LCOUNT:극장출연순서)):(CFLAG:LCOUNT:노역점포-1) = -1
			DE:(59+(CFLAG:LCOUNT:극장출연순서)):(CFLAG:LCOUNT:노역점포-1) = -1
			CFLAG:LCOUNT:노역플래그 = 0
			CFLAG:LCOUNT:극장출연순서 = 0
			CFLAG:LCOUNT:노역점포 = 0
		ENDIF
	ENDIF
	IF CFLAG:LCOUNT:10 >= 100 && TALENT:LCOUNT:붕괴 == 0 && LCOUNT != MASTER
