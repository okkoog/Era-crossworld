			ELSE
				CDFLAG:LOCAL:캐릭터간호감도:100 += CFLAG:LOCAL:방치일수*2
				SIF CDFLAG:LOCAL:캐릭터간호감도:100 > 0
					CDFLAG:LOCAL:캐릭터간호감도:100 = 0
			ENDIF
		ELSE
			CFLAG:LOCAL:방치일수 = 0
			CFLAG:LOCAL:신경썼다플래그 = 0
		ENDIF
		CALL NTR_CHECK , LOCAL , 1
	NEXT
