;2020/03/20　ガイアーズはあんまり変更なし。
;異能者スキルのコンセプトは小学生を参照
@RANDOMCHARA_4905, ARGS, ARG, ARG:1,ARGS:1
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "일인칭"
		IF TALENT:ARG:남자 == 1
			SELECTCASE RAND:4
				CASE 0
					RESULTS = 이몸
				CASE 1
					RESULTS = 나
				CASE 2
					RESULTS = 노부
				CASE 3
					RESULTS = 본인
			ENDSELECT
		ELSE
			SELECTCASE RAND:5
				CASE 0
					RESULTS = 나
				CASE 1
					RESULTS = 저
				CASE 2
					RESULTS = 소녀
				CASE 3
					RESULTS = 소첩
				CASE 4
					RESULTS = 첩
			ENDSELECT
		ENDIF
	CASE "이인칭"
		RESULTS = %CALLNAME:MASTER%
	CASE "체력"
		IF イベントフラグ:88:0 > 1
			RETURN RAND(1700, 3400)
		ELSE
			RETURN RAND(1200, 2400)
		ENDIF
	CASE "기력"
		IF イベントフラグ:88:0 > 1
			RETURN RAND(1300, 2500)
		ELSE
			RETURN RAND(800, 1500)
		ENDIF
	CASE "属性"
		RETURN RAND(50, 120), RAND(0, 85)
	CASE "종족"
		RETURN 0
	CASE "롤"
		;デビルシフター、モヒカン系、忍者系、破戒僧系で大別 非戦闘員は存在しない
		SELECTCASE RAND:100
			CASE IS < 30
				RESULTS = 데빌시프터
			CASE IS < 50
				RESULTS = 달인
				IF RAND:2 > 0
					RESULTS:1 = 석세서_1/공격의심득_3
				ELSE
					RESULTS:1 = 건슬링거_5/공격의심득_3
				ENDIF
			CASE IS < 70
				RESULTS = 이능자
			CASEELSE
				RESULTS = 서머너
		ENDSELECT
	;CASE "戦闘素質"
		;デビルシフター、モヒカン系、忍者系、破戒僧系で大別 非戦闘員は存在しない
		;SELECTCASE RAND:10
		;	CASE IS < 3
		;		RESULTS = 데빌시프터
		;		RESULTS:1 = 도구지식
		;		RETURN 1, 3
		;	CASE IS < 5
		;		RESULTS = 달인
		;		IF RAND:2 > 0
		;			RESULTS:1 = 석세서
		;		ELSE
		;			RESULTS:1 = 건슬링거
		;		ENDIF
		;		RETURN 1, 1
		;	CASE IS < 7
		;		RESULTS = 이능자
		;		RESULTS:1 = 도구지식
		;			;強化フラグがある場合、1/2で強化。道具知識を2に
		;			IF イベントフラグ:88:0 > 3 && RAND:2 > 0
		;				RETURN 1, 2
		;			ENDIF
		;		RETURN 1, 1
		;	CASEELSE
		;		RESULTS = 서머너
		;		RESULTS:1 = 이능자
		;		RETURN 1, 1
		;ENDSELECT
	CASE "초기페르소나"
		RETURN 0
	CASE "링크악마"
		RETURN 0
;		IF TALENT:ARG:데빌시프터 == 1
;			IF RAND:2 == 0
;				;1/2でランダムリンク
;				RETURN 0
;			ELSE
;				IF TALENT:ARG:남자 == 1
;					SELECTCASE RAND:5
;						CASE 0
;							RETURN [[キャラ:슬라임]]
;						CASE 1
;							RETURN [[キャラ:잭프로스트]]
;						CASE 2
;							RETURN [[キャラ:오니]]
;						CASE 3
;							RETURN [[キャラ:인큐버스]]
;						CASE 4
;							RETURN [[キャラ:이누가미]]
;					ENDSELECT
;				ELSE
;					SELECTCASE RAND:5
;						CASE 0
;							RETURN [[キャラ:보디코니언]]
;						CASE 1
;							RETURN [[キャラ:픽시]]
;						CASE 2
;							RETURN [[キャラ:유키죠로]]
;						CASE 3
;							RETURN [[キャラ:서큐버스]]
;						CASE 4
;							RETURN [[キャラ:네코마타]]
;					ENDSELECT
;				ENDIF
;			ENDIF
;		ELSE
;			RETURN 0
;		ENDIF
	CASE "初期ステータス比率"
		RETURN 10, 10, 8, 7, 7, 5
	CASE "스킬"
		IF TALENT:ARG:달인 == 1 && TALENT:ARG:이능자 == 0 && TALENT:ARG:석세서 == 1;ローレシアのヒャッハー
				RESULT = [[스킬:관통]]
				RESULT:1 = [[스킬:기합]]
				RESULT:2 = [[스킬:레볼루션]]
				RESULT:3 = [[스킬:타루카쟈오토]]
				RESULT:4 = [[스킬:이신의잔영]]
				RESULT:5 = [[스킬:기합부스터]]
				RESULT:6 = [[스킬:끝없는도발]]
				RESULT:7 = [[스킬:맹반격]]
				RESULT:8 = [[스킬:삼할의활천]]
				RESULT:9 = [[스킬:추격의심득]]
				RESULT:10 = [[스킬:데스카운터]]
				RESULT:11 = [[스킬:불굴의투지]]
				RETURN RESULT
		ELSEIF  TALENT:ARG:달인 == 1 && TALENT:ARG:이능자 == 0 && TALENT:ARG:건슬링거 == 5;伝承者の落ちこぼれヒャッハー
				RESULT = [[스킬:해피트리거]]
				RESULT:1 = [[스킬:나한장]]
				RESULT:2 = [[스킬:돌려차기]]
				RESULT:3 = [[스킬:파이어브레스]]
				RESULT:4 = [[스킬:독가스브레스]]
				RESULT:5 = [[스킬:아카샤아츠]]
				RESULT:6 = [[스킬:비공찌르기]]
				RESULT:7 = [[스킬:도발]]
				RESULT:8 = [[스킬:플레어샷]]
				RESULT:9 = [[스킬:삼할의활천]]
				RESULT:10 = [[스킬:모탈지하드]]
				RESULT:11 = [[스킬:뉴클리어미사일]]
				RETURN RESULT
		ELSEIF TALENT:ARG:이능자 == 5
			;ガイアーズスキル
			RESULT = [[스킬:독침]]
			RESULT:1 = [[스킬:마비침]]
			RESULT:2 = [[스킬:몽견침]]
			;異能者スキル
			;공격
			SELECTCASE RAND:5
				CASE 0
					RESULT:3 = [[스킬:번개찌르기]]
					RESULT:4 = [[스킬:베놈재퍼]]
					RESULT:5 = [[스킬:회전베기]]
					RESULT:6 = [[스킬:치유촉진(소)]]
				CASE 1
					RESULT:3  = [[스킬:돌격]]
					RESULT:4 = [[스킬:마구날뛰기]]
					RESULT:5 = [[스킬:돌려차기]]
					RESULT:6 = [[스킬:이악물기]]
				CASE 2
					RESULT:3 = [[스킬:테트라칸]]
					RESULT:4 = [[스킬:무드]]
					RESULT:5 = [[스킬:마하무드]]
					RESULT:6 = [[스킬:무드온]]
				CASE 3
					RESULT:3  = [[스킬:지오]]
					RESULT:4 = [[스킬:지온가]]
					RESULT:5 = [[스킬:지오다인]]
					RESULT:6 = [[스킬:마카라칸]]
				CASE 4
					RESULT:3  = [[스킬:잔]]
					RESULT:4 = [[스킬:잔마]]
					RESULT:5 = [[스킬:잔다인]]
					RESULT:6 = [[스킬:마카라칸]]
			ENDSELECT
			;カジャ系
			SELECTCASE RAND:4
				CASE 0
					RESULT:7 = [[스킬:타루・카쟈]]
					RESULT:8 = [[스킬:다크브레스]]
				CASE 1
					RESULT:7 = [[스킬:스쿠・카쟈]]
					RESULT:8 = [[스킬:도발]]
				CASE 2
					RESULT:7 = [[스킬:라쿠・카쟈]]
					RESULT:8 = [[스킬:파워브레스]]
				CASE 3
					RESULT:7 = [[스킬:사마・카쟈]]
					RESULT:8 = [[스킬:위협]]
			ENDSELECT
			;魔脈/コンセ
			IF RAND:2 > 0
				RESULT:9 = [[스킬:일할의마맥]]
			ELSE
				RESULT:9 = [[스킬:컨센트레이트]]
			ENDIF
			;만능
			RESULT:10 = [[스킬:메기도]]
			RESULT:11 = [[스킬:메기도라온]]
			;強化フラグが立っていると奥義的ななにかを覚えるように
			IF イベントフラグ:88:0 > 3
				RESULT:12 = [[스킬:지옥의인두]]
			ENDIF
			RETURN RESULT
		ENDIF	
	CASE "相性"
		SELECTCASE GET_TYPE(ARG:1)
			CASE "파마"
				RETURN 0
			CASEELSE
				RETURN 100
		ENDSELECT
	CASE "素質"
		RETURN GETNUM(TALENT, "광기"), GETNUM(TALENT, "발정가능"), GETNUM(TALENT, "해방"), GETNUM(TALENT, "바늘다루기"), GETNUM(TALENT, "바이"), GETNUM(TALENT, "악취둔감"), GETNUM(TALENT, "쾌감에솔직")
	CASE "除外素質"
		RETURN GETNUM(TALENT, "정조관념"), GETNUM(TALENT, "아픔에약함"), GETNUM(TALENT, "겁쟁이"),GETNUM(TALENT, "헌신적")
	;処女は特別 0はランダム(20%), 1なら処女, 2なら非処女
	CASE "처녀"
		IF RAND:5 == 0
			RETURN 1
		ELSE
			RETURN 2
		ENDIF
	;戻り値は0:ランダム 1:소인체형 2:유아체형 4:큰체형 5:거체
	CASE "体型"
		RETURN 0
	CASE "체형"
		RESULTS '= RANDOMCHARA_COMMON_HAIRSTYILE(ARG)
	CASE "アイコン区分"
		IF RAND:2
			RESULTS '= "성인"
		ELSE
			RESULTS '= "青年"
		ENDIF
	;戻り値は0:ランダム 1:절벽　2:빈유　3:並　4:거유　5:폭유
	CASE "가슴"
		RETURN 0
	;追加対応。戻り値は0:ランダム 1:小尻　2:並尻　3:巨尻　4:爆尻
	CASE "尻"
		RETURN 0
	;通常の人間と肉体部位が違う場合はここで直接代入してください
	CASE "肉体部位"
		RETURN 0
	CASE "ABL"
		SELECTCASE ABLNAME:(ARG:1)
			CASE "순종", "욕망", "기교"
				RETURN !RAND:3+!RAND:5
			CASE "Ｃ감각", "Ｖ감각", "Ｂ감각"
				RETURN !RAND:3
			CASE "마조끼", "노출증", "봉사정신"
				RETURN !RAND:5
			CASE "새드끼"
				RETURN !RAND:4 * !ABL:ARG:마조끼
			CASE "Ａ감각", "자위중독", "정액중독", "레즈끼", "ＢＬ끼", "섹스중독"
				RETURN !RAND:10
		ENDSELECT
	;EXPはABLが1以上ある場合、ある程度調整される(ただし、ABL0の時は調整が動かないので適当に初期値をきめてください)
	CASE "EXP"
		;全く手付かずの場合
		SIF !GROUPMATCH(1, !TALENT:ARG:처녀, ABL:ARG:Ｃ감각, ABL:ARG:Ｖ감각, ABL:ARG:Ａ감각, ABL:ARG:Ｂ감각, ABL:ARG:기교)
			RETURN 0
		SELECTCASE EXPNAME:(ARG:1)
			CASE "Ｖ경험"
				RETURN RAND(0, 20) * RAND:2
			CASE "Ａ경험"
				RETURN RAND(0, 20) * !RAND:5
			CASE "절정경험"
				RETURN RAND(0, 20) * RAND:2
			CASE "사정경험"
				RETURN RAND(0, 20) * RAND:2
			CASE "성교경험"
				RETURN 0
			CASE "질사경험"
				RETURN EXP:ARG:사정경험/2*EXP:ARG:성교경험 > 0
			CASE "자위경험"
				RETURN RAND(0, 20)
			CASE "조교자위경험"
				RETURN 0
			CASE "정액경험"
				RETURN RAND(0, 20) * RAND:2
			CASE "봉사쾌락경험"
				RETURN 0
			CASE "펠라경험"
				RETURN RAND(0, 10) * RAND:2
			CASE "애정경험"
				RETURN 0
			CASE "고통쾌락경험"
				RETURN RAND(0, 20) * !RAND:4
			CASE "방뇨경험"
				RETURN 0
			CASE "가학쾌락경험"
				RETURN RAND(0, 10) * !RAND:4
			CASE "야외노출경험"
				RETURN 0
			CASE "레즈경험"
				RETURN RAND(0, 20) * !RAND:4
			CASE "ＢＬ경험"
				RETURN RAND(0, 20) * !RAND:4
			CASE "이상경험"
				RETURN 0
			CASE "긴박경험"
				RETURN RAND(0, 10) * EXP:ARG:고통쾌락경험 > 0
		ENDSELECT
	CASE "모자"
		IF IS_MALE(ARG)
			SELECTCASE RAND:10
				CASE 0
					RETURN [[衣装:모자]]
				CASE 1
					RETURN [[衣装:카우보이모자]]
				CASE 2
					RETURN [[衣装:헬멧]]
				CASE 3
					RETURN [[衣装:삿갓]]
				CASE 4
					RETURN [[衣装:반다나]]
				CASE 5
					RETURN [[衣装:머리끈]]
				CASE 6
					RETURN [[衣装:에보시]]
				CASE 7
					RETURN [[衣装:헌팅캡]]
				CASEELSE
					RETURN 0
			ENDSELECT
		ELSE
			SELECTCASE RAND:10
				CASE 0
					RETURN [[衣装:모자]]
				CASE 1
					RETURN [[衣装:반다나]]
				CASE 2
					RETURN [[衣装:비녀]]
				CASE 3
					RETURN [[衣装:머리장식]]
				CASE 4
					RETURN [[衣装:후드]]
				CASE 5
					RETURN [[衣装:머리끈]]
				CASE 6
					RETURN [[衣装:네코미미카츄샤]]
				CASE 7
					RETURN [[衣装:머리핀]]
				CASEELSE
					RETURN 0
			ENDSELECT
		ENDIF
	CASE "옷"
		IF IS_MALE(ARG)
			SELECTCASE RAND:10
				CASE 0
					RETURN [[衣装:겉옷]]
				CASE 1
					RETURN [[衣装:탱크탑]]
				CASE 2
					RETURN [[衣装:언더셔츠]]
				CASE 3
					RETURN [[衣装:깃세운옷]]
				CASE 4
					RETURN [[衣装:카우보이셔츠]]
				CASEELSE
					RETURN 0
			ENDSELECT
		ELSE
			SELECTCASE RAND:10
				CASE 0
					RETURN [[衣装:기모노]]
				CASE 1
					RETURN [[衣装:유카타]]
				CASE 2
					RETURN [[衣装:고스로리옷（흑）]]
				CASE 3
					RETURN [[衣装:비키니탑]]
				CASE 4
					RETURN [[衣装:캐미솔]]
				CASE 6
					RETURN [[衣装:튜브탑]]
				CASEELSE
					RETURN 0
			ENDSELECT
		ENDIF
	CASE "하의"
		IF CFLAG:ARG:옷 == 0 && RAND:2 == 0
			;服がなければ5割で下衣もなし(後で全身服を設定)
			RETURN 0
		ELSEIF IS_MALE(ARG)
			SELECTCASE RAND:5
				CASE 0
					RETURN [[衣装:바지]]
				CASE 1
					RETURN [[衣装:하카마]]
				CASE 2
					RETURN [[衣装:레더팬츠]]
				CASE 3
					RETURN [[衣装:슬랙스]]
				CASE 4
					RETURN [[衣装:카고팬츠]]
			ENDSELECT
		ELSE
			IF CFLAG:ARG:옷 == [[衣装:기모노]] || CFLAG:ARG:옷 == [[衣装:유카타]]
				RETURN [[衣装:하카마]]
			ELSEIF CFLAG:ARG:옷 == [[衣装:고스로리옷（흑）]]
				SELECTCASE RAND:5
					CASE 0
						RETURN [[衣装:스커트]]
					CASE 1
						RETURN [[衣装:롱스커트]]
					CASE 2
						RETURN [[衣装:플리츠스커트]]
					CASE 3
						RETURN [[衣装:플레어스커트]]
					CASE 4
						RETURN [[衣装:미니스커트]]
				ENDSELECT
			ELSE
				SELECTCASE RAND:4
					CASE 0
						RETURN [[衣装:숏팬츠]]
					CASE 1
						RETURN [[衣装:핫팬츠]]
					CASE 2
						RETURN [[衣装:타이트미니스커트]]
					CASE 3
						RETURN [[衣装:비키니바텀]]
				ENDSELECT
			ENDIF
		ENDIF
	CASE "전신복"
		IF CFLAG:ARG:옷 == 0 && CFLAG:ARG:하의 == 0
			IF IS_MALE(ARG)
				SELECTCASE RAND:10
					CASE 0
						RETURN [[衣装:전신갑주]]
					CASE 1
						RETURN [[衣装:군복]]
					CASE 2
						RETURN [[衣装:민족의상]]
					CASE 3
						RETURN [[衣装:트라이브수트]]
					CASE 4
						RETURN [[衣装:도사복]]
					CASE 5
						RETURN [[衣装:도복]]
					CASE 6
						RETURN [[衣装:길리수트]]
					CASE 7
						RETURN [[衣装:사무에]]
					CASE 8
						RETURN [[衣装:죄수복]]
					CASE 9
						RETURN [[衣装:법의]]
				ENDSELECT
			ELSE
				SELECTCASE RAND:10
					CASE 0
						RETURN [[衣装:본디지수트]]
					CASE 1
						RETURN [[衣装:차이나드레스]]
					CASE 2
						RETURN [[衣装:군복]]
					CASE 3
						RETURN [[衣装:민족의상]]
					CASE 4
						RETURN [[衣装:도사복]]
					CASEELSE
						;女の場合、服及び全身服がない場合を含む(あとで全身下着を設定)
						RETURN 0
				ENDSELECT
			ENDIF
		ELSE
			RETURN 0
		ENDIF
	CASE "손"
		RETURN 0
	CASE "속옷（상）"
		IF IS_MALE(ARG)
			RETURN 0
		ELSEIF CFLAG:ARG:옷 == 0 && CFLAG:ARG:하의 == 0 && CFLAG:ARG:전신복 == 0
			;全身下着を設定するためなし
			RETURN 0
		ELSE
			SELECTCASE RAND:5
				CASE 0
					RETURN [[衣装:브래지어]]
				CASE 1
					RETURN [[衣装:브래지어(흑)]]
				CASE 2
					RETURN [[衣装:브래지어(적)]]
				CASE 3
					RETURN [[衣装:무명천]]
				CASE 4
					RETURN [[衣装:니플리스]]
			ENDSELECT
		ENDIF
	CASE "속옷（하）"
		IF IS_MALE(ARG)
			IF RAND:5
				RETURN [[衣装:트렁크스]]
			ELSE
				RETURN [[衣装:훈도시]]
			ENDIF
		ELSEIF CFLAG:ARG:옷 == 0 && CFLAG:ARG:하의 == 0 && CFLAG:ARG:전신복 == 0
			;全身下着を設定するためなし
			RETURN 0
		ELSE
			SELECTCASE RAND:6
				CASE 0
					RETURN [[衣装:팬티]]
				CASE 1
					RETURN [[衣装:팬티(흑)]]
				CASE 2
					RETURN [[衣装:팬티(적)]]
				CASE 3
					RETURN [[衣装:레이스달린팬티]]
				CASE 4
					RETURN [[衣装:스패츠]]
				CASE 5
					RETURN [[衣装:로우라이즈]]
			ENDSELECT
		ENDIF
	CASE "전신속옷"
		IF CFLAG:ARG:옷 == 0 && CFLAG:ARG:하의 == 0 && CFLAG:ARG:전신복 == 0
			SELECTCASE RAND:3
				CASE 0
					RETURN [[衣装:타이트보디수트]]
				CASE 1
					RETURN [[衣装:레오타드]]
				CASE 2
					RETURN [[衣装:고무수트]]
			ENDSELECT
		ELSE
			RETURN 0
		ENDIF
	CASE "양말"
		IF IS_MALE(ARG)
			RETURN [[衣装:양말]]
		ELSEIF CFLAG:ARG:옷 == 0 && CFLAG:ARG:하의 == 0 && CFLAG:ARG:전신복 == 0
			RETURN [[衣装:검은색타이즈]]
		ELSEIF CFLAG:ARG:옷 == [[衣装:기모노]] || CFLAG:ARG:옷 == [[衣装:유카타]]
			RETURN [[衣装:버선]]
		ELSE
			SELECTCASE RAND:6
				CASE 0
					RETURN [[衣装:하이삭스]]
				CASE 1
					RETURN [[衣装:니삭스]]
				CASE 2
					RETURN [[衣装:사이하이삭스]]
				CASE 3
					RETURN [[衣装:가터스타킹]]
				CASE 4
					RETURN [[衣装:팬티스타킹]]
				CASE 5
					RETURN [[衣装:검은색타이즈]]
			ENDSELECT
		ENDIF
	CASE "신발"
		IF IS_MALE(ARG)
			SELECTCASE RAND:5
				CASE 0
					RETURN [[衣装:게다]]
				CASE 1
					RETURN [[衣装:슈즈]]
				CASE 2
					RETURN [[衣装:부츠]]
				CASE 3
					RETURN [[衣装:스니커]]
				CASE 4
					RETURN [[衣装:가죽구두]]
			ENDSELECT
		ELSEIF CFLAG:ARG:양말 == [[衣装:버선]]
			RETURN [[衣装:짚신]]
		ELSE
			SELECTCASE RAND:5
				CASE 0
					RETURN [[衣装:부츠]]
				CASE 1
					RETURN [[衣装:하이부츠]]
				CASE 2
					RETURN [[衣装:숏부츠]]
				CASE 3
					RETURN [[衣装:하이힐]]
				CASE 4
					RETURN [[衣装:샌들]]
			ENDSELECT
		ENDIF
	CASE "겉옷"
		RETURN 0
	CASE "그외"
		SELECTCASE RAND:12
			CASE 0
				RETURN [[衣装:벨트]]
			CASE 1
				RETURN [[衣装:쵸커]]
			CASE 2
				RETURN [[衣装:안대]]
			CASE 3
				RETURN [[衣装:귀걸이]]
			CASE 4
				RETURN [[衣装:선글라스]]
			CASE 5
				RETURN [[衣装:홀스터]]
			CASE 6
				RETURN [[衣装:안경]]
			CASE 7
				RETURN [[衣装:회중시계]]
			CASE 8
				RETURN [[衣装:지포라이터]]
			CASE 9
				RETURN [[衣装:애독서]]
			CASE 10
				RETURN [[衣装:가면「여우」]]
			CASE 11
				RETURN [[衣装:헤드폰]]
		ENDSELECT
	;悪魔汎用使用しています0:ランダム 1:女_子供　2:女_少女　3:女_若者　4:女_大人　5:女_淑女　6:女_古風　7:男_若者　8:男_大人　9:獣_ケダモノ
	CASE "회화타입"
		SIF TALENT:ARG:광기 == 1 && TALENT:ARG:데빌시프터 == 1
				RETURN 9
		IF TALENT:ARG:남자 == 0
			SELECTCASE RAND:4
				CASE 0
					RETURN 2
				CASE 1
					RETURN 3
				CASE 2
					RETURN 4
				CASE 3
					RETURN 6
			ENDSELECT
		ELSE
			RETURN 0
		ENDIF
	CASE "名前"
		$SET_NAME
		IF TALENT:ARG:처녀 == 1
			RESULTS = 순결의 
		ELSEIF (TALENT:ARG:마유 == 1 || TALENT:ARG:폭유 == 1)
			RESULTS = 마유의 
		ELSEIF TALENT:ARG:거유 == 1
			RESULTS = 매혹의 
		ELSEIF TALENT:ARG:광기 == 1
			RESULTS = 광기의 
		ELSE
			RESULTS = 냉혹한 
		ENDIF
		IF CFLAG:ARG:전신복 != 0
			RESULTS += "대마인"
		ELSEIF CFLAG:ARG:옷 == [[衣装:고스로리옷（흑）]]
			RESULTS += "고스로리 님"
		ELSEIF TALENT:ARG:데빌시프터 == 1
			RESULTS += "가이어즈"
		ELSEIF TALENT:ARG:서머너
			RESULTS += "파계승"
		ELSEIF TALENT:ARG:이능자 == 5
			IF TALENT:ARG:남자 == 1
				RESULTS += "어쌔신"
			ELSE
				RESULTS += "쿠노이치"
			ENDIF
		ELSEIF TALENT:ARG:석세서 == 1
			IF TALENT:ARG:남자 == 1
				RESULTS += "무뢰한"
			ELSE
				RESULTS += "여두목"
			ENDIF
		ELSEIF TALENT:ARG:건슬링거 == 3
				RESULTS += "자칭 전승자"
		ELSE
			RESULTS += "가이아교도"
		ENDIF
	CASE "愛称"
		;이름과 같으므로 생략
		GOTO SET_NAME
	CASE "해설"
		RESULTS = 도쿄(TOKYO)를 중심으로 퍼져있는 신흥종교 가이아교의 신자。
		IF TALENT:ARG:데빌시프터
			RESULTS:1 = 악마의 힘을 너무 맹신한 나머지、스스로 악마가 되는 방법을 터득해버린 듯하다
		ELSEIF TALENT:ARG:석세서
			RESULTS:1 = 오직 힘만이 전부라 믿으며、어떤 규칙에도 얽매이지 않는 무법자이다
		ELSEIF TALENT:ARG:건슬링거
			RESULTS:1 = 일족 비전의 격투술을、일부만 계승한 권술가이다。
		ELSEIF TALENT:ARG:서머너
			RESULTS:1 = 악마로 전향한 전직 성직자이다
		ELSE
			RESULTS:1 = 암살을 생업으로 삼는 닌자 집단의 일원이며、가이아 교단의 암부를 지탱해 왔다
		ENDIF
		RESULTS:2 = 　
		RESULTS:3 = (이하 Wikipedia 발췌)
		RESULTS:4 = 가이아 교단은 질서나 계급에 얽매이지 않고、자연과 일체화하는 것을 중요시하고 있다
		RESULTS:5 = 차별도 구별도 없이、통제를 부정하고 모든 것과 공존하려 한다
		RESULTS:6 = 그 때문에 현실적이며 실리적이어서、힘없는 자에게서 가치를 찾지 않고 구원의 손길도 내밀지 않는다
		RESULTS:7 = 기본적으로 실력지상주의 단체로、자유는 있으나 질서는 존재하지 않는다
		RESULTS:8 = 악마의 존재를 용인하고 공생해 나가는 것을 생각하기에、메시아교와는 정면으로 대립하고 있다
		RESULTS:9 = 혼돈을 중시한다는 점에서 비롯된 것인지 야쿠자나 반사회적인 인물도 많으며、
		RESULTS:10 = 말투나 거동은 거칠고 난폭하며 폭력을 휘두르는 것에도 주저함이 없다
		RESULTS:11 = 교도 중에는 암살을 생업으로 삼는 자도 있다。
	;最後に呼び出すので何らかの調整が必要な場合はここで
	CASE "最終調整"
		RETURN 0
ENDSELECT
