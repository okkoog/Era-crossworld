;=========================================================
;ARGS = ランダムキャラ用のロール名
;
;ARGSのロールはランダムキャラの個別ファイルから持ってくる。
;このときの名称はゲーム全体のロール名と一致していなくてもかまわないので
;ある程度特殊な素質パターンがあるなら、定義名を作って対応されたし
;
;戻値
;RESULTS;0 = 通常形態の確定素質。ロール定義部分もここに
;RESULTS:1 = 変身形態の確定素質
;RESULTS:2 = 通常形態の選択素質
;RESULTS:3 = 変身形態の選択素質
;=========================================================
@DEFINE_RANDOM_CHARA_ROLE_TALENT, ARGS
VARSET RESULTS, "", 0, 4
SELECTCASE ARGS
	;非スキル系のロールは自由枠が多く、かつ戦闘力が保証されないので
	;ガンスリンガーかサクセサーか道具知識のいずれが取れている形を多くするように偏りをつけている
	CASE "候補者"
		SELECTCASE RAND:100
			CASE IS < 50
				RESULTS:0 += ""
				RESULTS:2 += "건슬링거_3/석세서_1/도구지식_3/아이템숙련_1/이능자_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3"
			CASE IS < 70
				RESULTS:0 += "건슬링거_3"
				RESULTS:2 += "도구지식_3/아이템숙련_1/이능자_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3"
			CASE IS < 90
				RESULTS:0 += "석세서_1/도구지식_3"
				RESULTS:2 += "아이템숙련_1/이능자_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3"
			CASEELSE
				RESULTS:0 += "도구지식_3/아이템숙련_1"
				RESULTS:2 += "건슬링거_3/석세서_1/도구지식_3/아이템숙련_1/이능자_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3"
		ENDSELECT
	CASE "エグゼクター"
		SELECTCASE RAND:100
			CASE IS < 50
				RESULTS:0 += "석세서_1/건슬링거_3/이능자_1"
			CASE IS < 75
				RESULTS:0 += "석세서_1/이능자_1"
				RESULTS:2 += "건슬링거_3/도구지식_3/아이템숙련_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3"
			CASEELSE
				RESULTS:0 += "건슬링거_3/이능자_1"
				RESULTS:2 += "석세서_1/도구지식_3/아이템숙련_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3"
		ENDSELECT
	CASE "서머너"
		SELECTCASE RAND:100
			CASE IS < 25
				RESULTS:0 += "서머너_5"
				RESULTS:2 += "건슬링거_3/석세서_1/도구지식_3/아이템숙련_1/이능자_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3"
			CASE IS < 50
				RESULTS:0 += "서머너_5/건슬링거_3"
				RESULTS:2 += "도구지식_3/아이템숙련_1/이능자_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3"
			CASE IS < 75
				RESULTS:0 += "서머너_5/석세서_1/도구지식_3"
				RESULTS:2 += "아이템숙련_1/이능자_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3"
			CASEELSE
				RESULTS:0 += "서머너_5/도구지식_3/아이템숙련_1"
				RESULTS:2 += "건슬링거_3/석세서_1/도구지식_3/아이템숙련_1/이능자_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3"
		ENDSELECT
	CASE "이능자"
		SELECTCASE RAND:100
			;素養抑制版
			CASE IS < 65
				RESULTS:0 += "이능자_5"
				RESULTS:2 += "건슬링거_2/석세서_1/도구지식_3/아이템숙련_1/서머너_3/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_2/방어의심득_3/바스테부스터_3/나락의마스크_3/마술의소양_2/신들의가호_3"
			;素養がつきやすい版
			CASE IS < 90
				RESULTS:0 += "이능자_5"
				RESULTS:2 += "건슬링거_2/석세서_1/도구지식_3/아이템숙련_1/서머너_3/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_2/방어의심득_3/바스테부스터_3/나락의마스크_3/마술의소양_5/신들의가호_3"
			;デフォルトパターンだが、抽選の仕様上すさまじく出づらいので直指定をいれてしまう
			CASE IS < 95
				RESULTS:0 += "이능자_5/마술의소양_5"
			CASEELSE
				RESULTS:0 += "이능자_5/도구지식_3"
				RESULTS:2 += "건슬링거_1/석세서_1/아이템숙련_1/서머너_3/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_1/방어의심득_3/바스테부스터_2/나락의마스크_2/마술의소양_2/신들의가호_2"
		ENDSELECT
	CASE "데빌시프터"
		RESULTS:0 += "데빌시프터_1"
		RESULTS:2 += "건슬링거_1/도구지식_3/서머너_3/이능자_1"
		RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_1/방어의심득_3/바스테부스터_2/나락의마스크_2"
	CASE "아웃사이더"
		SELECTCASE RAND:100
			CASE IS < 25 
				RESULTS:0 += "아웃사이더_1"
				IF RAND:2
					RESULTS:1 += "/건슬링거_3"
				ELSE
					RESULTS:1 += "/건슬링거_2"
				ENDIF
				RESULTS:2 += "석세서_1/도구지식_3/아이템숙련_1/서머너_3/이능자_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3"
			CASE IS < 50
				RESULTS:0 += "아웃사이더_1/석세서_1"
				RESULTS:2 += "건슬링거_1/도구지식_3/아이템숙련_1/서머너_3/이능자_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_1/방어의심득_3/바스테부스터_3/나락의마스크_2"
			CASE IS < 75
				RESULTS:0 += "아웃사이더_1/도구지식_3/아이템숙련_1"
				RESULTS:2 += "건슬링거_1/서머너_3/이능자_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_1/방어의심득_3/바스테부스터_3/나락의마스크_2"
			CASEELSE
				RESULTS:0 += "아웃사이더_1"
				RESULTS:2 += "건슬링거_3/석세서_1/도구지식_3/아이템숙련_1/서머너_3/이능자_1/영매체질_1"
				RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3"
		ENDSELECT
	CASE "魔法少女"
		RESULTS:0 += "아웃사이더_1/이능자_3"
		RESULTS:2 += "건슬링거_1/도구지식_3/서머너_3"
		RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_1/방어의심득_3/바스테부스터_2/나락의마스크_2/마술의소양_2/마도의재능_1"
	CASE "식노"
		RESULTS:0 += "식노_1"
		RESULTS:2 += "건슬링거_3/석세서_1/도구지식_3/아이템숙련_1/서머너_3/이능자_1/영매체질_1"
		RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3"
	CASE "페르소나구사자"
		IF RAND:2
			RESULTS:0 += "페르소나구사자_1"
		ELSE
			RESULTS:0 += "페르소나구사자_2"
		ENDIF
		RESULTS:2 += "건슬링거_2/석세서_1/도구지식_3/아이템숙련_1/서머너_3/영매체질_1"
		RESULTS:2 += "/" + "무도의마음가짐_3/공격의심득_3/방어의심득_3/바스테부스터_3/나락의마스크_3/신들의가호_3"
	CASE "アイドル"
		RESULTS:0 += "비전투원_1/영매체질_1"
	CASE "비전투원"
		RESULTS:0 += "비전투원_1"
	CASE "달인"
		RESULTS:0 += "달인_1"
ENDSELECT