;--------------------------------------
;ランダム悪魔リンク
;--------------------------------------
;シーアークの処理からパク…参考に作成
;悪魔リンクと言いつつペルソナにも使用
@RANDAM_LINKS, ARG
#DIM DYNAMIC 悪魔テーブル, 1000
#DIM DYNAMIC MAXLEVEL, 1
#DIM DYNAMIC BASE_MAXLEVEL
#DIM DYNAMIC TABLE_NUM, 1
#DIM DYNAMIC LCOUNT
VARSET 悪魔テーブル
LOCAL   = 0
LOCAL:1 = 0 ;レア悪魔数カウント

SELECTCASE RAND:10
	;6割でLv30以下
	CASE IS < 6
		MAXLEVEL = MIN(30, MAX_MASTER_LV)
	;3割でLv60以下
	CASE IS < 9
		MAXLEVEL = MIN(60, MAX_MASTER_LV)
	;1割でLv100以下(上限なし扱い)
	CASEELSE
		MAXLEVEL = MIN(100, MAX_MASTER_LV)
ENDSELECT

FOR LCOUNT, 1, 1800
	;CSVがあるか確認、なければ弾く
	SIF EXISTCSV(LCOUNT, 0) == 0
		CONTINUE
	;上限レベルを超える場合は除外
	SIF CSVBASE(LCOUNT, GETNUM(BASE, "LV")) > MAXLEVEL
		CONTINUE
	;女の場合、男を除外
	SIF TALENT:ARG:남자 == 0 && CSVTALENT(LCOUNT, GETNUM(TALENT, "남자")) != 0
		CONTINUE
	;男の場合、女を除外
	SIF TALENT:ARG:남자 == 1 && CSVTALENT(LCOUNT, GETNUM(TALENT, "남자")) != 1
		CONTINUE
	;特殊合体のみ、合体条件有り、全書召喚不可は弾く
	SIF CSVCFLAG(LCOUNT, GETNUM(CFLAG, "특수합체만"))
		CONTINUE
	SIF CSVCFLAG(LCOUNT, GETNUM(CFLAG, "합체조건있음"))
		CONTINUE
	SIF CSVCFLAG(LCOUNT, GETNUM(CFLAG, "전서소환불가"))
		CONTINUE
	SIF CSVCFLAG(LCOUNT, GETNUM(CFLAG, "링크불능"))
		CONTINUE
	;１体のみは弾く
	SIF CSVCFLAG(LCOUNT, GETNUM(CFLAG, "１체만"))
		CONTINUE
	;達人は弾いておく
	SIF CSVCFLAG(LCOUNT, GETNUM(TALENT, "달인"))
		CONTINUE
	;EXキャラの判定
	SIF !IS_PLAYABLE_EXTRA_CHARA(LCOUNT)
		CONTINUE
	;シーアークと共通の種族制限
	SIF SEA_ARCH_VALIDATE_RACE(CSVABL(LCOUNT, GETNUM(ABL, "종족"))) == 0
		CONTINUE
	;マシンをはじく
	SIF CSVABL(LCOUNT, GETNUM(ABL, "종족")) == GET_RACE_NUM("머신")
		CONTINUE
	悪魔テーブル:LOCAL = LCOUNT
	LOCAL ++
NEXT
;レア悪魔処理
;メガテン系イベント以外不許可の場合は出現させない
IF GET_USEABLE_EXTRA_TITLE() > 0
	FOR LCOUNT, 5000, 5049
		;CSVがあるか確認、なければ弾く
		SIF EXISTCSV(LCOUNT, 0) == 0
			CONTINUE
		;上限レベルを超える場合は除外
		SIF CSVBASE(LCOUNT, GETNUM(BASE, "LV")) > MAXLEVEL
			CONTINUE
		;女の場合、男を除外
		SIF TALENT:ARG:남자 == 0 && CSVTALENT(LCOUNT, GETNUM(TALENT, "남자")) != 0
			CONTINUE
		;男の場合、女を除外
		SIF TALENT:ARG:남자 == 1 && CSVTALENT(LCOUNT, GETNUM(TALENT, "남자")) != 1
			CONTINUE
		悪魔テーブル:LOCAL = LCOUNT
		LOCAL ++
		LOCAL:1 ++
	NEXT
ENDIF

;ランダムテーブルが10以下の場合にレア枠全てを消す
IF LOCAL < 11
	LOCAL -= LOCAL:1
	LOCAL:1 = 0
ENDIF

;ランダムテーブルない場合
IF LOCAL == 0 || LOCAL == LOCAL:1
	TABLE_NUM = 6
	悪魔テーブル:0 = [[キャラ:픽시]]
	悪魔テーブル:1 = [[キャラ:하피]]
	悪魔テーブル:2 = [[キャラ:아프사라스]]
	悪魔テーブル:3 = [[キャラ:노커]]
	悪魔テーブル:4 = [[キャラ:춍춍]]
	悪魔テーブル:5 = [[キャラ:아귀]]
	LOCAL:1 = 0
ELSE
	TABLE_NUM = LOCAL
ENDIF

;ランダムテーブルから算出して返却、レベルはＣＳＶのデータのまま
LOCAL = RAND:TABLE_NUM
RETURN 悪魔テーブル:LOCAL, CSVBASE(悪魔テーブル:LOCAL, GETNUM(BASE, "LV"))

