;-------------------------------------------
;ランダムキャラ作成
;引数はタイプ, LV, 性別
;-------------------------------------------
;2019/07/26　JK好き　魔乳に暫定対応
;2020/03/20　っとっとき　ランダム悪魔リンク対応。尻素質に対応。継承タイプもテキトーに付与させるように対応
;2020/09/05　っとっとき　一部の処理を別の処理からも使用できるように処理を分割
;2020/09/12　名無し　排他素質のチェック漏れ追記、不具合修正
;2021/01/05　名無し　ロール外の調整処理を追加
;2021/12/30　名無し　임신하기쉬움/しにくい 排他処理に追加
;2022/09/01　JK好き　ヤリチン用の処理を追加
@MAKE_RANDOM_CHARA, CHARA_NO = -1, L_LV = 5, ARG:2 = -1
#DIMS TEMPS
#DIM LCOUNT,2
#DIM CHARA, 1
#DIM CHARA_NO, 1
#DIM L_LV
#DIM TYPE, 1
#DIMS L_ROLE_TYPE
#DIMS FIXED_TALENT, 2
#DIMS L_TALENT_LIST, 2
#DIMS TALENT_TABLE
#DIM CNT_SUB_TALENTNUM
#DIMS TRANS_MODE
;fixme:何個スキルが返ってくるかわからなかったのでとりあえずそこそこ多くってことで100個ぐらい増やしとく　誰か、ルール作って最適化しといて
#DIM LSKILLS, 100
#LOCALSIZE 6
#LOCALSSIZE 2
VARSET RESULT
VARSET RESULTS
L_ROLE_TYPE = 未選択
;-------------------------
;キャラの決定
;-------------------------
WHILE !EXISTCSV(CHARA_NO, 0)
	CHARA_NO = RAND(4901, 4910)
WEND
;-------------------------
;キャラ追加
;-------------------------
CALL ADD_NEW_COMPANION, CHARA_NO, 200
;キャラが作成出来ない場合は帰る
SIF RESULT == 0
	RETURN 0
CHARA = RESULT:1
;デバッグ中は即戦闘参加出来るように変更
SIF IS_DEBUG
	CALL SET_TALENT_PARTY_JOINABLE, CHARA, "参加可能"
;-------------------------
;性別
;ランダムの場合、オトコ40%　男の娘4%　女55%　ふたなり1%
;-------------------------
IF ARG:2 >= 0
	SELECTCASE ARG:2
		CASE 1
			TALENT:CHARA:남자 = 1
		CASE 2
			TALENT:CHARA:남자 = 1
			TALENT:CHARA:오토코노코 = 1
		CASE 3
			TALENT:CHARA:후타나리 = 1
	ENDSELECT
ELSE
	SELECTCASE RAND:100
		CASE IS < 40
			TALENT:CHARA:남자 = 1
		CASE IS < 44
			TALENT:CHARA:남자 = 1
			TALENT:CHARA:오토코노코 = 1
		CASE IS < 45
			TALENT:CHARA:후타나리 = 1
	ENDSELECT
ENDIF

;-------------------------
;体力・気力
;-------------------------
CALLFORM RANDOMCHARA_{CHARA_NO}, "체력", CHARA, , L_ROLE_TYPE
BASE:CHARA:체력 = RESULT / 100 * 100
MAXBASE:CHARA:체력 = BASE:CHARA:체력
CALLFORM RANDOMCHARA_{CHARA_NO}, "기력", CHARA, , L_ROLE_TYPE
BASE:CHARA:기력 = RESULT / 100 * 100
MAXBASE:CHARA:기력 = BASE:CHARA:기력
;-------------------------
;属性
;-------------------------
CALLFORM RANDOMCHARA_{CHARA_NO}, "属性", CHARA, , L_ROLE_TYPE
CFLAG:CHARA:선악치 = RESULT
CFLAG:CHARA:질혼치 = RESULT:1
;-------------------------
;종족
;-------------------------
CALLFORM RANDOMCHARA_{CHARA_NO}, "종족", CHARA, , L_ROLE_TYPE
ABL:CHARA:종족 = RESULT
;-------------------------
;戦闘素質
;
;1.各個別ファイルから定義名と個別の確定素質を取ってくる
;2.定義名から確定素質とと選択素質を取得
;3.確定素質を付与して、ロールを確定
;4.選択素質を一旦すべて付与
;5.選択素質を5個以下になるになるように削除
;6.ランダムに選択素質のLvをひとつづつ削っていく
;7.キャパシティが許容範囲におさまったら終了
;-------------------------
VARSET RESULTS, "", 0, 2
CALLFORM RANDOMCHARA_{CHARA_NO}, "롤", CHARA, , L_ROLE_TYPE
L_ROLE_TYPE = %RESULTS%
;RESULTSがロール名、RESULTS:1は確定TALENT及びロールに関与しない素質
IF RESULTS:1 != ""
	FOR LCOUNT, 0, STRCOUNT(RESULTS:1, "/") + 1
		TEMPS = %AUTO_SPLIT(RESULTS:1, "/", LCOUNT)%
		TALENT:CHARA:AUTO_SPLIT(TEMPS, "_", 0) = MAX(TOINT(AUTO_SPLIT(TEMPS, "_", 1)), 1)
	NEXT
ENDIF
CALL DEFINE_RANDOM_CHARA_ROLE_TALENT, RESULTS
FIXED_TALENT:0 = %RESULTS%
FIXED_TALENT:1 = %RESULTS:1%
L_TALENT_LIST:0 = %RESULTS:2%
L_TALENT_LIST:1 = %RESULTS:3%
FOR LCOUNT:1, 0, 2
	IF LCOUNT:1 == 1
		SIF !GET_ROLE_PROP("CAN_USE_TRANS", CHARA)
			CONTINUE
		TRANS_MODE = 変身形態
	ELSE
		TRANS_MODE = 通常形態
	ENDIF
	;固定素質の登録
	FOR LCOUNT, 0, STRCOUNT(FIXED_TALENT:(LCOUNT:1), "/") + 1
		TEMPS = %AUTO_SPLIT(FIXED_TALENT:(LCOUNT:1), "/", LCOUNT)%
		SIF TEMPS == ""
			CONTINUE
		;サブ素質でないものが入る可能性があるので
		IF LCOUNT:1 == 0
			TALENT:CHARA:AUTO_SPLIT(TEMPS, "_", 0) = TOINT(AUTO_SPLIT(TEMPS, "_", 1))
		ELSE
			CALL SET_BTL_TALENT_LV, AUTO_SPLIT(TEMPS, "_", 0), CHARA, TOINT(AUTO_SPLIT(TEMPS, "_", 1)), TRANS_MODE
		ENDIF
	NEXT

	CALL SET_ROLE, CHARA

	;サブ素質の登録
	TALENT_TABLE = 
	CNT_SUB_TALENTNUM = 0
	FOR LCOUNT, 0, STRCOUNT(L_TALENT_LIST:(LCOUNT:1), "/") + 1
		TEMPS = %AUTO_SPLIT(L_TALENT_LIST:(LCOUNT:1), "/", LCOUNT)%
		SIF STRCOUNT(FIXED_TALENT:0, AUTO_SPLIT(TEMPS, "_", 0))
			CONTINUE
		CALL SET_BTL_TALENT_LV, AUTO_SPLIT(TEMPS, "_", 0), CHARA, TOINT(AUTO_SPLIT(TEMPS, "_", 1)), TRANS_MODE
		TALENT_TABLE += ("/" + AUTO_SPLIT(TEMPS, "_", 0)) * TOINT(AUTO_SPLIT(TEMPS, "_", 1))
		CNT_SUB_TALENTNUM++
	NEXT
	TALENT_TABLE = %SUBSTRING(TALENT_TABLE, 1)%

	;サブ素質が5個になるまで消す
	WHILE CNT_SUB_TALENTNUM > 5
		TEMPS = %RAND_SPLIT(L_TALENT_LIST:0, "/")%
		TEMPS = %AUTO_SPLIT(TEMPS, "_", 0)%
		SIF STRCOUNT(FIXED_TALENT:0, TEMPS)
			CONTINUE
		SIF !GET_BTL_TALENT_LV(TEMPS, CHARA, TRANS_MODE)
			CONTINUE
		CALL SET_BTL_TALENT_LV, TEMPS, CHARA, 0, TRANS_MODE
		CNT_SUB_TALENTNUM--
	WEND
	;道具知識が消えている場合は、アイテム習熟も消す
	SIF !GET_BTL_TALENT_LV("도구지식", CHARA, TRANS_MODE)
		CALL SET_BTL_TALENT_LV, "아이템숙련", CHARA, 0, TRANS_MODE
	;CPが足りるようにレベルを削る
	LCOUNT = 0
	WHILE LCOUNT < 10000
		LCOUNT++
		;道具知識が消えている場合は、アイテム習熟も消す
		SIF !GET_BTL_TALENT_LV("도구지식", CHARA, TRANS_MODE)
			CALL SET_BTL_TALENT_LV, "아이템숙련", CHARA, 0, TRANS_MODE
		CALL SET_ROLE_CP, CHARA
		SIF GET_ROLE_CP(CHARA, "通常形態") >= 0
			BREAK
		TEMPS = %RAND_SPLIT(TALENT_TABLE, "/")%
		SIF TEMPS == ""
			CONTINUE
		SIF !GET_BTL_TALENT_LV(TEMPS, CHARA)
			CONTINUE
		;レベルを1減らす。ただし、サマナーLv2等、取得されない設定されているものは飛ばして落とす
		DO
			CALL SET_BTL_TALENT_LV, TEMPS, CHARA, GET_BTL_TALENT_LV(TEMPS, CHARA, TRANS_MODE) - 1, TRANS_MODE
		LOOP  GET_SUB_ROLE_PROP("COST", TEMPS, , , GET_BTL_TALENT_LV(TEMPS, CHARA, TRANS_MODE)) < 0
	WEND
NEXT
;デフォルト素質チェック
CALL SET_BTL_TALENT_NEW, CHARA

;CALL ROLE_EXPLAIN_ABILITY, CHARA, , , "サブ"
;WAIT
;RESTART

;VARSET RESULTS
;CALLFORM RANDOMCHARA_{ARG}, "戦闘素質", CHARA
;LOCAL = 0
;WHILE RESULTS:LOCAL != ""
;	TALENT:CHARA:(RESULTS:LOCAL) = RESULT:LOCAL
;	LOCAL++
;WEND
;-------------------------
;ステータス
;-------------------------
BASE:CHARA:LV = L_LV
BASE:CHARA:ＥＸＰ = 0
;BASE:CHARA:ＥＸＰ = 5*(ARG:1-1)*(ARG:1+1)*(ARG:1)/3
;ステ合計基準値
LOCAL:1 = L_LV * 3 / 2 + 18
CALLFORM RANDOMCHARA_{CHARA_NO}, "初期ステータス比率", CHARA, , L_ROLE_TYPE
LOCAL:2 = SUMARRAY(RESULT, 0, 6)
LOCAL:3 = 0
FOR LOCAL, 0, 6
	BASE:CHARA:GET_BASESTATUS(LOCAL+1) = LOCAL:1 * RESULT:LOCAL / LOCAL:2
	LOCAL:3 += BASE:CHARA:GET_BASESTATUS(LOCAL+1)
NEXT
;切り捨てられたぶんをランダムに追加
WHILE LOCAL:1 > LOCAL:3
	BASE:CHARA:GET_BASESTATUS(RAND(1,7)) += 1
	LOCAL:3++
WEND
;一定回数でランダム移動
FOR LOCAL, 0, LOCAL:1 / 8
	LOCAL:2 = RAND(1,7)
	SIF BASE:CHARA:GET_BASESTATUS(LOCAL:2) <= 1
		CONTINUE
	BASE:CHARA:GET_BASESTATUS(RAND(1,7)) += 1
	BASE:CHARA:GET_BASESTATUS(LOCAL:2) -= 1
NEXT
;---------------------------------------------
;페르소나
;---------------------------------------------
IF TALENT:CHARA:페르소나구사자 >= 1
	CALLFORM RANDOMCHARA_{CHARA_NO}, "초기페르소나", CHARA, , L_ROLE_TYPE
	IF RESULT == 0
		CALLFORM RANDAM_LINKS, CHARA
		ABL:CHARA:초기페르소나 = RESULT
	ELSE
		ABL:CHARA:초기페르소나 = RESULT
	ENDIF
	;ABL:CHARA:스킬9 = [[스킬:P・체인지]]
	
	;1/2でP3以降のペルソナ使いに
	IF RAND:2 == 0
		TALENT:CHARA:페르소나구사자 = 2
	ELSE
		TALENT:CHARA:페르소나구사자 = 1
	ENDIF
ENDIF
;---------------------------------------------
;링크악마
;---------------------------------------------
;IF TALENT:CHARA:식노 == 1 || TALENT:CHARA:데빌시프터 == 1 || TALENT:CHARA:変身先対応 == 1 
IF GET_ROLE_PROP("CAN_USE_TRANS", CHARA)
	CALLFORM RANDOMCHARA_{CHARA_NO}, "링크악마", CHARA, , L_ROLE_TYPE
	IF RESULT == 0
		CALLFORM RANDAM_LINKS, CHARA
		CFLAG:CHARA:초기링크악마 = RESULT
	ELSE
		CFLAG:CHARA:초기링크악마 = RESULT
	ENDIF
	;リンク悪魔があるときのATTACK設定;後から変更も出来るしとりあえず無難な打撃相性に
	IF RESULT
		ABL:CHARA:초기링크악마공격상성 = 2
		ABL:CHARA:초기링크악마최저공격횟수 = 1
		ABL:CHARA:초기링크악마최대공격횟수 = 1
		ABL:CHARA:초기링크악마사거리 = 1
		ABL:CHARA:초기링크악마공격범위 = 1
	ENDIF
ENDIF
;-------------------------
;스킬
;LSKILLS配列にスキルを入れたのち
;覚えられるか見て落としこむ
;-------------------------
VARSET LSKILLS
VARSET RESULT
LOCAL:1 = 0
;ペルソナ使いはPチェンジ以外のスキルを得ない
IF !TALENT:CHARA:페르소나구사자
	;喰奴は下記スキルが入る
	IF TALENT:CHARA:식노
		LSKILLS = [[스킬:물고늘어지기]]
		LSKILLS:1 = [[스킬:씹어흩뿌리기]]
		LSKILLS:2 = [[스킬:대상제]]
		LSKILLS:3 = [[스킬:최후의만찬]]
		LOCAL:1 = 4
	ENDIF
	CALLFORM RANDOMCHARA_{CHARA_NO}, "스킬", CHARA, , L_ROLE_TYPE
	LOCAL = 0
	WHILE RESULT:LOCAL
		LSKILLS:(LOCAL:1) = RESULT:LOCAL
		LOCAL++
		LOCAL:1++
	WEND
	;変身できるロール
	;IF TALENT:CHARA:식노 || TALENT:CHARA:데빌시프터
	IF GET_ROLE_PROP("CAN_USE_TRANS", CHARA)
		FOR LOCAL, 1, FLAG:스킬수 + 1
			LOCAL:2 = CSVABL(CFLAG:CHARA:초기링크악마, GETNUM(ABL, @"스킬{LOCAL}"), 0)
			SIF !LOCAL:2
				CONTINUE
			CALL GET_SKILL_PROP, "敵専用", LOCAL:2, CHARA
			SIF RESULT
				CONTINUE
			LSKILLS:(LOCAL:1) = LOCAL:2
			LOCAL:1++
		NEXT
		FOR LOCAL, 1, 20
			LOCAL:2 = CSVABL(CFLAG:CHARA:초기링크악마, GETNUM(ABL, @"습득스킬{LOCAL}"), 0)
			SIF !LOCAL:2
				CONTINUE
			CALL GET_SKILL_PROP, "敵専用", LOCAL:2, CHARA
			SIF RESULT
				CONTINUE
			LSKILLS:(LOCAL:1) = LOCAL:2
			LOCAL:1++
		NEXT
	ENDIF
	;ランクの低い順に並べ替えていく
	IF LSKILLS:0 > 0
		FOR LOCAL, 0, FINDELEMENT(LSKILLS, 0)
			CALL GET_SKILL_PROP, "SKILL_RANK", LSKILLS:LOCAL, CHARA
			LSKILLS:LOCAL += RESULT * 100000
		NEXT
		ARRAYSORT LSKILLS:LOCAL, FORWARD, 0, FINDELEMENT(LSKILLS, 0)
		FOR LOCAL, 0, FINDELEMENT(LSKILLS, 0)
			LSKILLS:LOCAL %= 100000
		NEXT
	ENDIF
	FOR LOCAL, 0, 3
		IF LSKILLS:LOCAL
			LOCALS = \@CFLAG:CHARA:초기링크악마 ? 초기변신악마# \@스킬{LOCAL+1}
			ABL:CHARA:LOCALS = LSKILLS:LOCAL
		ENDIF
	NEXT
	LOCAL:1 = BASE:CHARA:LV+RAND:4
	FOR LOCAL, 0, 20
		IF LSKILLS:(LOCAL + 3)
			LOCALS = \@CFLAG:CHARA:초기링크악마 ? 초기변신악마# \@습득스킬{LOCAL+1}
			LOCALS:1 = \@CFLAG:CHARA:초기링크악마 ? 초기변신악마# \@습득LV{LOCAL+1}
			ABL:CHARA:LOCALS = LSKILLS:(LOCAL+3)
			CALL GET_SKILL_PROP, "SKILL_RANK", LSKILLS:(LOCAL+3), CHARA
			ABL:CHARA:(LOCALS:1) = MAX(RESULT * 4 + RAND:4, LOCAL:1 + RAND(1, 4))
			LOCAL:1 = ABL:CHARA:(LOCALS:1)
		ENDIF
	NEXT
ENDIF
;スキルの所持条件を確認して消す
CALL EXCLUDE_UNABLE_SKILL, CHARA

;-------------------------
;相性
;-------------------------
FOR LOCAL, 0, TYPENUM+1
	CALLFORM RANDOMCHARA_{CHARA_NO}, "相性", CHARA, LOCAL, L_ROLE_TYPE
	BASE:CHARA:GET_TYPE(LOCAL) = RESULT
NEXT
;-------------------------
;素質
;素質は優先テーブル内から3つとる
;-------------------------
VARSET RESULT
CALLFORM RANDOMCHARA_{CHARA_NO}, "素質", CHARA, , L_ROLE_TYPE
;優先されている数を調べる
LOCAL:1 = 1
FOR LOCAL, 0, 50
	SIF !RESULT:(LOCAL:1)
		CONTINUE
	LOCAL:1++
NEXT
FOR LOCAL, 0, LOCAL:1
	SWAP RESULT:LOCAL, RESULT:(RAND:(LOCAL:1))
NEXT
LOCAL:3 = 0
LOCAL:4 = 0
LOCAL:5 = 0
;優先を保存
FOR LOCAL, 0, 3
	SIF TALENTNAME:(RESULT:LOCAL) == ""
		CONTINUE
	SIF !RESULT:LOCAL
		CONTINUE
	LOCAL:(LOCAL+3) = RESULT:LOCAL
NEXT
VARSET RESULT
CALLFORM RANDOMCHARA_{CHARA_NO}, "除外素質", CHARA, , L_ROLE_TYPE
LOCAL:1 = 0
;素質はランダムで5%の確率で発現
FOR LOCAL, 10, 137
	;デフォルトでの除外素質
	SIF GROUPMATCH(TALENTNAME:LOCAL, "", "약점", "질투", "즉각함락", "자위광", "섹스광", "애널광", "음유", "창놈", "고양이혀", "망신", "여우", "요호", "수수께끼의매력", "흡혈귀", "새드", "마조", "미끼")
		CONTINUE
	;体型関係はここでは除外
	SIF GROUPMATCH(TALENTNAME:LOCAL, "유아체형", "큰체형", "거체", "빈유", "절벽", "거유", "폭유", "마유")
		CONTINUE
	SIF GROUPMATCH(TALENTNAME:LOCAL, "유생고정", "白肌", "褐色肌", "赤肌", "青肌", "小尻", "並尻", "巨尻", "爆尻", "魔尻")
		CONTINUE
	;優先は判定しない
	SIF GROUPMATCH(LOCAL, LOCAL:3, LOCAL:4, LOCAL:5)
		CONTINUE
	;除外素質
	SIF MATCH(RESULT, LOCAL)
		CONTINUE
	;ランダムキャラ4人目以降は25%で発現
	IF イベントフラグ:88:0 > 2
		TALENT:CHARA:LOCAL = RAND:100 > 75
	ELSE
		TALENT:CHARA:LOCAL = RAND:100 > 95
	ENDIF
	;発現素質数をカウント
	LOCAL:1++
NEXT

;この時点での発現素質を調整
;LOCAL:2 = RAND(3, 6)
;ランダムキャラ4人目以降は調整計算を変更
IF イベントフラグ:88:0 > 2
	SELECTCASE RAND:10
		CASE IS < 5
		;0~4
			LOCAL:2 = RAND(8, 13)
		CASE IS < 8
		;5~7
			LOCAL:2 = RAND(8, 18)
		CASEELSE
		;8,9
			LOCAL:2 = RAND(8, 31)
	ENDSELECT
ELSE
	SELECTCASE RAND:10
		;殆どの場合 発現素質を3～5個に減らす
		CASE IS < 7
		;0~6
			LOCAL:2 = RAND(3, 6)
		;20%　発現素質を3～10個に減らす
		CASE IS < 9
		;7,8
			LOCAL:2 = RAND(3, 11)
		;10%　フィーバー 3～25
		CASEELSE
			LOCAL:2 = RAND(3, 26)
	ENDSELECT
ENDIF
WHILE LOCAL:2 < MATCH(TALENT:CHARA:0, 1, 10, 137)
	LOCAL = RAND(10, 137)
	SIF !TALENT:CHARA:LOCAL
		CONTINUE
	TALENT:CHARA:LOCAL = 0
	LOCAL:1--
WEND
;退避しておいた優先素質をつける
FOR LOCAL, 3, 6
	SIF TALENTNAME:(LOCAL:LOCAL) == ""
		CONTINUE
	SIF !LOCAL:LOCAL
		CONTINUE
	TALENT:CHARA:(LOCAL:LOCAL) = 1
NEXT

;両立不能な素質を削っていく
CALLFORM RANDOMTALENT_COMPE_DELETE, CHARA

;(優先素質の関係で両刀・男嫌い・女嫌いは別途処理)
IF TALENT:CHARA:바이 && (TALENT:CHARA:남성혐오 || TALENT:CHARA:여성혐오)
	IF GROUPMATCH(TALENT:CHARA:바이, LOCAL:3, LOCAL:4, LOCAL:5)
		TALENT:CHARA:남성혐오 = 0
		TALENT:CHARA:여성혐오 = 0
	ELSEIF GROUPMATCH(TALENT:CHARA:남성혐오, LOCAL:3, LOCAL:4, LOCAL:5) || GROUPMATCH(TALENT:CHARA:여성혐오, LOCAL:3, LOCAL:4, LOCAL:5)
		TALENT:CHARA:바이 = 0
	ELSE
		IF RAND:2
			TALENT:CHARA:바이 = 0
		ELSE
			TALENT:CHARA:남성혐오 = 0
			TALENT:CHARA:여성혐오 = 0
		ENDIF
	ENDIF
ENDIF
;-------------------------
;素質共通処理
;-------------------------
;スキル習得に影響を与えない為にここに
;SIF !EXTRA強化("ランダムキャラ拡張") && TALENT:CHARA:달인 == 0
;	CALL ロール内フィルター ,CHARA
;-------------------
;계승타입
;-------------------
;スキルカードを付けやすくするため、継承タイプを後付けで設定
;それぞれ40%の確率で発現させる
;FOR LOCAL, 320, 342
;	TALENT:CHARA:LOCAL = RAND:100 >= 60
;NEXT
;気休めでランダムキャラ作成時、MAGを最大まで持たせておく
;BASE:CHARA:ＭＡＧ = MAXBASE:CHARA:ＭＡＧ

;-------------------
;처녀
;-------------------
CALLFORM RANDOMCHARA_{CHARA_NO}, "처녀", CHARA, , L_ROLE_TYPE
IF RESULT == 0
	TALENT:CHARA:처녀 = !RAND:5
ELSE
	TALENT:CHARA:처녀 = RESULT == 1 ? 1 # 0
ENDIF
;-------------------
;髪型・体型・胸・形質
;-------------------
RESULTS '= ""
CALL SET_RANDOM_CHARA_FACE, CHARA, L_ROLE_TYPE

