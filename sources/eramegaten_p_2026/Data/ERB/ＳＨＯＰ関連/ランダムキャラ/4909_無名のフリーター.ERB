						RESULTS:11 += "ネットで知り合った大学生たち"
					CASE 9
						RESULTS:11 += "老紳士とその愛犬"
				ENDSELECT
			ELSE
				SELECTCASE RAND:12
					CASE 0
						RESULTS:11 += "お父さん"
					CASE 1
						RESULTS:11 += "知らないおじさん"
					CASE 2
						RESULTS:11 += "近所のおじさん"
					CASE 3
						RESULTS:11 += "お兄ちゃん"
					CASE 4
						RESULTS:11 += "担任の先生"
					CASE 5
						RESULTS:11 += "同級生の男の子"
					CASE 6
						RESULTS:11 += "上級生の男の子"
					CASE 7
						RESULTS:11 += "弟"
					CASE 8
						RESULTS:11 += "ネットで知り合った大学生たち"
					CASE 9
						RESULTS:11 += "老紳士とその愛犬"
					CASE 10
						RESULTS:11 += "野獣のような先輩"
					CASE 11
						RESULTS:11 += "ツナギの似合ういい男"
				ENDSELECT
			ENDIF
			SELECTCASE RAND:5
				CASE 0
					RESULTS:11 += "にレイプされた"
				CASE 1
					RESULTS:11 += "にバックから犯された"
				CASE 2
					RESULTS:11 += "とラブラブエッチした"
				CASE 3
					RESULTS:11 += "に自分から捧げた"
				CASE 4
					RESULTS:11 += "に一回１万円でヤらせてあげた"
			ENDSELECT
		ENDIF
	;最後に呼び出すので何らかの調整が必要な場合はここで
	CASE "最終調整"
		RETURN 0
ENDSELECT
