;ARGは生成キャラの登録番号
;フリーターは非戦闘員オンリー。歌唱・料理・撮影等のなんらかの経験を積んでいるようにする
;レアキャラはなし。
@RANDOMCHARA_4909, ARGS, ARG, ARG:1,ARGS:1
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "일인칭"
		IF TALENT:ARG:남자 == 1
			RESULTS = 나
		ELSE
			RESULTS = 저
		ENDIF
	CASE "이인칭"
		RESULTS = %CALLNAME:MASTER%
	CASE "체력"
		IF イベントフラグ:88:0 > 1
			RETURN RAND(1300, 2800)
		ELSE
			RETURN RAND(800, 1800)
		ENDIF
	CASE "기력"
		IF イベントフラグ:88:0 > 1
			RETURN RAND(1300, 2800)
		ELSE
			RETURN RAND(800, 1800)
		ENDIF
	CASE "属性"
		RETURN RAND(100, 200), RAND(100, 200)
	CASE "종족"
		RETURN 0
	CASE "롤"
		RESULTS = 非戦闘員
	;CASE "戦闘素質"
	;	RESULTS = 비전투원
	;	RETURN 1
	;戻り値は0:ランダム それ以外は指定
	CASE "초기페르소나"
		RETURN 0
	;戻り値は0:ランダム それ以外は指定
	CASE "링크악마"
		RETURN 0
	;戻り値は0:ランダム それ以外は指定
	CASE "初期ステータス比率"
		RETURN 7, 7, 8, 7, 8, 10
	CASE "스킬"
		RETURN 0
	CASE "相性"
		IF  RAND:100 == 0
			;1%の確率でたけし化
			SELECTCASE GET_TYPE(ARG:1)
				CASEELSE
					RETURN 200
			ENDSELECT
		ELSE
			SELECTCASE GET_TYPE(ARG:1)
				CASE "파마"
					RETURN 0
				CASEELSE
					RETURN 100
			ENDSELECT
		ENDIF
	CASE "素質"
		RETURN GETNUM(TALENT, "아픔에약함")
	CASE "除外素質"
		RETURN GETNUM(TALENT, "바늘다루기"), GETNUM(TALENT, "조합지식")
	;処女は特別 0はランダム(20%), 1なら処女, 2なら非処女
	CASE "처녀"
		IF  RAND:5 == 0
			RETURN 2
		ELSE
			RETURN 1
		ENDIF
	CASE "체형"
		RESULTS '= RANDOMCHARA_COMMON_HAIRSTYILE(ARG)
