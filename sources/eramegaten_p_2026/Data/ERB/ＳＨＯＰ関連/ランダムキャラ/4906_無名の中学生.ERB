						RESULTS:11 = 　誘導尋問に騙されて、
					CASE 4
						RESULTS:11 = 　魅了魔法で発情させられて、
				ENDSELECT
				;1/3でNTR描写も足す
				IF RAND:3 == 0
					RESULTS:11 += "彼氏の目の前で"
				ENDIF
				SELECTCASE RAND:5
					CASE 0
						RESULTS:11 += "触手に凌辱された"
					CASE 1
