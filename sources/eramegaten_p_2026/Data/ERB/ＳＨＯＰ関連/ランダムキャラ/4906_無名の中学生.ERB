;ARGは生成キャラの登録番号
;中学生はサマナーか異能者かペルソナ使いと幅広い
;レアキャラも魔法少女、変身ヒーロー、アイドルとこちらも幅広いが、発現率は他より低め
;異能者スキルのコンセプトは小学生を参照
@RANDOMCHARA_4906, ARGS, ARG, ARG:1,ARGS:1
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "일인칭"
		IF TALENT:ARG:남자 == 1
			RESULTS = 나
		ELSE
			RESULTS = 나
		ENDIF
	CASE "이인칭"
		RESULTS = %CALLNAME:MASTER%
	CASE "체력"
		IF イベントフラグ:88:0 > 1
			RETURN RAND(1300, 2700)
		ELSE
			RETURN RAND(800, 1700)
		ENDIF
	CASE "기력"
		IF イベントフラグ:88:0 > 1
			RETURN RAND(1300, 2500)
		ELSE
			RETURN RAND(800, 1500)
		ENDIF
	CASE "属性"
		RETURN RAND(100, 200), RAND(100, 200)
	CASE "종족"
		RETURN 0
	CASE "롤"
		SELECTCASE RAND:100
			CASE IS < 5
				IF TALENT:ARG:남자 == 0
					RESULTS = 魔法少女
				ELSE
					RESULTS = 아웃사이더
				ENDIF
			CASE IS < 15
				RESULTS = 서머너
			CASE IS < 40
				RESULTS = 페르소나구사자
			CASE IS < 65
				RESULTS = 이능자
			CASEELSE
				RESULTS = 非戦闘員
				IF !RAND:10
					RESULTS = アイドル
					SELECTCASE RAND:5
						CASE 0
							;1/5でフレーバーとして天使を付与
							RESULTS:1 = %ADD_SPLIT(RESULTS:1, "/", "천사_1")%
						CASE 1
							;1/5で半フレーバーとして機械の乙女を付与
							RESULTS:1 = %ADD_SPLIT(RESULTS:1, "/", "기계의처녀_1")%
					ENDSELECT
				ENDIF
		ENDSELECT
;	CASE "戦闘素質"
;		;1/3で非戦闘員
;		IF RAND:3 == 0
;			RESULTS = 非戦闘員
;			;1/10でアイドル(영매체질)
;			IF RAND:10 == 0
;				RESULTS:1 = 영매체질
;				SELECTCASE RAND:5
;					CASE 0
;						;1/5でフレーバーとして天使を付与
;						RESULTS:2 = 천사
;						RETURN 1, 1, 1
;					CASE 1
;						;1/5で半フレーバーとして機械の乙女を付与
;						RESULTS:2 = 기계의처녀
;						RETURN 1, 1, 1
;					CASEELSE
;						;3/5で何もなし
;						RETURN 1, 1
;				ENDSELECT
;			ENDIF
;			RETURN 1
;		ENDIF
;		;1/15でレア枠
;		IF RAND:15 == 0
;			IF TALENT:ARG:남자 == 0
;				;女の場合、異能者シフター(魔法少女)
;				RESULTS = 이능자
;				RESULTS:1 = 아웃사이더
;			ELSE
;				;男の場合、喰奴(変身ヒーロー)
;				RESULTS = 식노
;				RESULTS:1 = 건슬링거
;			ENDIF
;			;強化フラグがある場合、1/2で道具知識3
;			IF イベントフラグ:88:0 > 3 && RAND:2 > 0
;				RESULTS:2 = 도구지식
;				RETURN 1, 1, 3
;			ENDIF
;			RETURN 1, 1
;		ENDIF
;		;それ以外はサマナーか異能者かペルソナ
;		;サマナーが多くてもアレなので、少し異能者・ペルソナを出やすくする
;		SELECTCASE RAND:100
;			CASE IS < 20
;				;純サマ
;				RESULTS = 서머너
;				;ガンスリとサクセサーはどちらかのみ
;				IF RAND:2 > 0
;					RESULTS:1 = 석세서
;				ELSE
;					RESULTS:1 = 건슬링거
;				ENDIF
;				RESULTS:2 = 도구지식
;				RETURN 5, 1, 3
;			CASE IS < 60
;				;페르소나구사자
;				RESULTS = 페르소나구사자
;				;強化フラグがある場合、1/2で道具知識1を追加
;				IF イベントフラグ:88:0 > 3 && RAND:2 > 0
;					RETURN 1, 1
;				ENDIF
;				RETURN 1
;			CASEELSE
;				RESULTS = 이능자
;				;純異能者(道具知識持ち)か異能者サマナー
;				IF RAND:2 > 0
;					RESULTS:1 = 서머너
;						;強化フラグがある場合、1/2で強化。サクセサーも付ける。
;						IF イベントフラグ:88:0 > 3 && RAND:2 > 0
;							IF EXTRA強化("ランダムキャラ拡張")
;								RESULTS:2 = 석세서
;								RETURN 1, 2, 1
;							ELSE
;								RESULTS:2 = 달인
;								RESULTS:3 = 석세서
;								RETURN  0, 1, 1, 1
;							ENDIF
;						ENDIF
;				ELSE
;					RESULTS:1 = 도구지식
;					;強化フラグがある場合、1/2で強化。道具知識を3に
;					IF イベントフラグ:88:0 > 3 && RAND:2 > 0
;						RETURN 1, 3
;					ENDIF
;				ENDIF
;				RETURN 1, 2
;		ENDSELECT
	;戻り値は0:ランダム それ以外は指定
	CASE "초기페르소나"
		RETURN 0
	;戻り値は0:ランダム それ以外は指定
	CASE "初期ステータス比率"
		RETURN 7, 7, 8, 7, 8, 10
	CASE "스킬"
		IF TALENT:ARG:달인 == 1 && TALENT:ARG:이능자 == 0 && TALENT:ARG:석세서 == 1;サクセサー達人サマナー
				RESULT = [[스킬:회전베기]]
				RESULT:1 = [[스킬:기합]]
				RESULT:2 = [[스킬:양팔찍기]]
				RESULT:3 = [[스킬:이악물기]]
				RESULT:4 = [[스킬:라쿤・다]]
				RESULT:5 = [[스킬:결단]]
				RESULT:6 = [[스킬:타루・카쟈]]
				RESULT:7 = [[스킬:기공(대)]]
				RESULT:8 = [[스킬:불굴의투지]]
				RESULT:9 = [[스킬:삼할의활천]]
				RESULT:10 = [[스킬:관통]]
				RESULT:11 = [[스킬:오의일섬]]
				RESULT:12 = [[스킬:삼할의마맥]]
				RESULT:13 = [[스킬:아공양단]]
				RETURN RESULT
		ELSEIF イベントフラグ:88:0 > 3 && TALENT:ARG:서머너 == 5 && TALENT:ARG:이능자 == 0
			;純サマ強化スキル
			;とりあえず自動スキルを山盛り
			RESULT = [[스킬:아이템숙련]]
			RESULT:1 = [[스킬:어드바이스]]
			RESULT:2 = [[스킬:이악물기]]
			RESULT:3 = [[스킬:추격의심득]]
			RESULT:4 = [[스킬:황천의회심]]
			RESULT:5 = [[스킬:정천의회심]]
			RESULT:6 = [[스킬:서드아이]]
			RESULT:7 = [[스킬:관통]]
			RETURN RESULT
		ELSEIF ARGS:1 == "アイドル"
			;アイドル用スキル
			;(使うには陥落させた上に戦闘素質を付けないといけないので、ぶっちゃけ使う人は物好きと思われる)
			;それっぽいスキル2つ
			SELECTCASE RAND:4
				CASE 0
					RESULT = [[스킬:해피스텝]]
				CASE 1
					RESULT = [[스킬:고양의노래]]
				CASE 2
					RESULT = [[스킬:던지는키스]]
				CASE 3
					RESULT = [[스킬:자장가]]
			ENDSELECT
			SELECTCASE RAND:4
				CASE 0
					RESULT:1 = [[스킬:용분의춤]]
				CASE 1
					RESULT:1 = [[스킬:천상의춤]]
				CASE 2
					RESULT:1 = [[스킬:마음의외침]]
				CASE 3
					RESULT:1 = [[스킬:마계의조사]]
			ENDSELECT
			;持ち歌(歌唱スキル)を2曲ずつ
			SELECTCASE RAND:4
				CASE 0
					RESULT:2 = [[스킬:Go-Round]]
				CASE 1
					RESULT:2 = [[스킬:Breakin’Through]]
				CASE 2
					RESULT:2 = [[스킬:MAZE OF LIFE]]
				CASE 3
					RESULT:2 = [[스킬:Time to Make History]]
			ENDSELECT
			SELECTCASE RAND:5
				CASE 0
					RESULT:3 = [[스킬:Burn my Dread]]
				CASE 1
					RESULT:3 = [[스킬:『너의눈은일만볼트』]]
				CASE 2
					RESULT:3 = [[스킬:『얼려버리는라인』]]
				CASE 3
					RESULT:3 = [[스킬:『봄버걸』]]
				CASE 4
					RESULT:3 = [[스킬:『불의전차』]]
			ENDSELECT
			IF GET_USEABLE_EXTRA_TITLE()
				;最近のアイドルは魔法少女も兼ねていたりするため、魔法少女スキルもオマケで1つ
				;パターンを増やし、幻想郷スキルも追加
				SELECTCASE RAND:6
					CASE 0
						RESULT:4 = [[스킬:침식하는검은날개]]
					CASE 1
						RESULT:4 = [[스킬:티로・피날레]]
					CASE 2
						RESULT:4 = [[스킬:나의세계]]
					CASE 3
						RESULT:4 = [[스킬:피니투라・프레차]]
					CASE 4
						RESULT:4 = [[스킬:스쿠왈타토레]]
					CASE 5
						RESULT:4 = [[스킬:롯소・판타즈마]]
				ENDSELECT
			ENDIF
			RETURN RESULT
		ENDIF 
		SIF !GET_ROLE_PROP("CAN_USE_SKILL", ARG)
			RETURN 0
		
		;異能者スキル
		;공격
		IF ARGS:1 == "이능자"
			SELECTCASE RAND:7
				CASE 0
					RESULT = [[스킬:아기]]
					RESULT:1 = [[스킬:아기라오]]
					RESULT:2 = [[스킬:아기다인]]
					RESULT:3 = [[스킬:데들리번]]
				CASE 1
					RESULT = [[스킬:마그나]]
					RESULT:1 = [[스킬:마그나스]]
					RESULT:2 = [[스킬:마그다인]]
					RESULT:3 = [[스킬:대지의분노]]
				CASE 2
					RESULT = [[스킬:아쿠아]]
					RESULT:1 = [[스킬:아쿠에스]]
					RESULT:2 = [[스킬:아쿠아다인]]
					RESULT:3 = [[스킬:아쿠아리타이드]]
				CASE 3
					RESULT = [[스킬:갈]]
					RESULT:1 = [[스킬:갈라]]
					RESULT:2 = [[스킬:갈다인]]
					RESULT:3 = [[스킬:선풍진]]
				CASE 4
					RESULT = [[스킬:코우하]]
					RESULT:1 = [[스킬:바이코우하]]
					RESULT:2 = [[스킬:마하코우하]]
					RESULT:3 = [[스킬:사마리캄]]
				CASE 5
					RESULT = [[스킬:회심의패기]]
					RESULT:1 = [[스킬:히트웨이브]]
					RESULT:2 = [[스킬:무사차]]
					RESULT:3 = [[스킬:산산조각베기]]
				CASE 6
					RESULT = [[스킬:회심의패기]]
					RESULT:1 = [[스킬:섬머솔트]]
					RESULT:2 = [[스킬:열진각]]
					RESULT:3 = [[스킬:맹돌진]]
			ENDSELECT
			;カジャ系
			SELECTCASE RAND:4
				CASE 0
					RESULT:4 = [[스킬:타루・카쟈]]
					RESULT:5 = [[스킬:다크브레스]]
				CASE 1
					RESULT:4 = [[스킬:스쿠・카쟈]]
					RESULT:5 = [[스킬:도발]]
				CASE 2
					RESULT:4 = [[스킬:라쿠・카쟈]]
					RESULT:5 = [[스킬:파워브레스]]
				CASE 3
					RESULT:4 = [[스킬:사마・카쟈]]
					RESULT:5 = [[스킬:위협]]
			ENDSELECT
			;魔脈/コンセ
			IF RAND:2 > 0
				RESULT:6 = [[스킬:일할의마맥]]
			ELSE
				RESULT:6 = [[스킬:컨센트레이트]]
			ENDIF
			;만능
			RESULT:7 = [[스킬:메기도]]
			RESULT:8 = [[스킬:메기도라온]]
			
			;強化
			IF イベントフラグ:88:0 > 3
				RESULT:9 = [[스킬:데・카쟈]]
				RESULT:10 = [[스킬:리캄드라]]
				IF TALENT:ARG:서머너 == 0
					;純異能者なら気功
					RESULT:11 = [[스킬:기공(소)]]
				ELSE
					;異能サマならコンセと魔脈を両方
					IF RESULT:6 == [[스킬:일할의마맥]]
						RESULT:11 = [[스킬:컨센트레이트]]
					ELSE
						RESULT:11 = [[스킬:일할의마맥]]
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		RETURN RESULT
	CASE "相性"
		SELECTCASE GET_TYPE(ARG:1)
			CASE "파마"
				RETURN 0
			CASEELSE
				RETURN 100
		ENDSELECT
	CASE "素質"
		RESULT = GETNUM(TALENT, "겁쟁이")
		RESULT:1 = GETNUM(TALENT, "아픔에약함")
		RESULT:2 = GETNUM(TALENT, "건방짐")
		RESULT:3 = GETNUM(TALENT, "호기심")
		RESULT:4 = GETNUM(TALENT, "솔직함")
		IF ARGS:1 == "アイドル"
			RESULT:5 = GETNUM(TALENT, "인기")
		ENDIF
		IF TALENT:ARG:천사 == 1
			;天使の場合、羽を付与
			RESULT:6 = GETNUM(TALENT, "날개")
		ELSEIF TALENT:ARG:기계의처녀 == 1 && RAND:3 == 0
			;機械の乙女の場合、1/3で動物耳を付与(ヘッドパーツとして付いている扱い)
			RESULT:6 = GETNUM(TALENT, "동물귀")
		ENDIF
		RETURN RESULT
	CASE "除外素質"
		RETURN GETNUM(TALENT, "바늘다루기"), GETNUM(TALENT, "조합지식")
	;処女は特別 0はランダム(20%), 1なら処女, 2なら非処女
	CASE "처녀"
		IF  RAND:5 == 0
			RETURN 2
		ELSE
			RETURN 1
		ENDIF
	CASE "체형"
		RESULTS '= RANDOMCHARA_COMMON_HAIRSTYILE(ARG)
	CASE "アイコン区分"
		RESULTS '= "소년"
	;戻り値は0:ランダム 1:소인체형 2:유아체형 4:큰체형 5:거체
	CASE "体型"
		;機械の乙女の場合、小人体型の分岐を追加
		IF TALENT:ARG:기계의처녀 == 1 && RAND:4 == 0
			RETURN 1
		ENDIF
		SELECTCASE RAND:10
			CASE IS < 5
				RETURN 2
			CASE IS < 8
				RETURN 3
			CASE IS < 9
				RETURN 4
		ENDSELECT
	;戻り値は0:ランダム 1:절벽　2:빈유　3:並　4:거유　5:폭유
	CASE "가슴"	
		IF TALENT:ARG:남자 == 0
			SELECTCASE RAND:10
				CASE IS < 6
					RETURN 2
				CASE IS < 8
					RETURN 3
				CASE IS < 9
					RETURN 1
				CASE IS < 10
					IF RAND:10 == 0
						RETURN 5
					ELSE
						RETURN 4
					ENDIF
			ENDSELECT
		ELSEIF TALENT:ARG:오토코노코 == 1
			SELECTCASE RAND:4
				CASE IS < 2
					RETURN 2
				CASE IS < 4
					RETURN 1
			ENDSELECT
		ELSE
			RETURN 1
		ENDIF
	;追加対応。戻り値は0:ランダム 1:小尻　2:並尻　3:巨尻　4:爆尻
	CASE "尻"
		RETURN 0
	;通常の人間と肉体部位が違う場合はここで直接代入してください
	CASE "肉体部位"
		RETURN 0
	CASE "ABL"
		SELECTCASE ABLNAME:(ARG:1)
			CASE "순종", "욕망", "기교"
				RETURN !RAND:3+!RAND:5
			CASE "Ｃ감각", "Ｖ감각", "Ｂ감각"
				RETURN !RAND:5
			CASE "마조끼", "노출증", "봉사정신"
				RETURN !RAND:10
			CASE "새드끼"
				RETURN !RAND:5 * !ABL:ARG:마조끼
			CASE "Ａ감각", "자위중독", "정액중독", "레즈끼", "ＢＬ끼", "섹스중독"
				RETURN !RAND:10
			CASE "가창기능"
				IF ARGS:1 == "アイドル"
					;アイドルの場合、歌唱技能を1以上保証
					RETURN RAND:5 + 1
				ELSE
					RETURN 0
				ENDIF
		ENDSELECT
	;EXPはABLが1以上ある場合、ある程度調整される(ただし、ABL0の時は調整が動かないので適当に初期値をきめてください)
	CASE "EXP"
		;全く手付かずの場合
		SIF !GROUPMATCH(1, !TALENT:ARG:처녀, ABL:ARG:Ｃ감각, ABL:ARG:Ｖ감각, ABL:ARG:Ａ감각, ABL:ARG:Ｂ감각, ABL:ARG:기교)
			RETURN 0
		SELECTCASE EXPNAME:(ARG:1)
			CASE "Ｖ경험"
				RETURN RAND(0, 20) * RAND:2
			CASE "Ａ경험"
				RETURN RAND(0, 20) * !RAND:5
			CASE "절정경험"
				RETURN RAND(0, 20) * RAND:2
			CASE "사정경험"
				RETURN RAND(0, 20) * RAND:2
			CASE "성교경험"
				RETURN 0
			CASE "질사경험"
				RETURN EXP:ARG:사정경험/2*EXP:ARG:성교경험 > 0
			CASE "자위경험"
				RETURN RAND(0, 20)
			CASE "조교자위경험"
				RETURN 0
			CASE "정액경험"
				RETURN RAND(0, 20) * RAND:2
			CASE "봉사쾌락경험"
				RETURN 0
			CASE "펠라경험"
				RETURN RAND(0, 10) * RAND:2
			CASE "애정경험"
				RETURN 0
			CASE "고통쾌락경험"
				RETURN RAND(0, 20) * !RAND:4
			CASE "방뇨경험"
				RETURN 0
			CASE "가학쾌락경험"
				RETURN RAND(0, 10) * !RAND:4
			CASE "야외노출경험"
				RETURN 0
			CASE "레즈경험"
				RETURN RAND(0, 20) * !RAND:4
			CASE "ＢＬ경험"
				RETURN RAND(0, 20) * !RAND:4
			CASE "이상경험"
				RETURN 0
			CASE "긴박경험"
				RETURN RAND(0, 10) * EXP:ARG:고통쾌락경험 > 0
			CASE "가창경험"
				IF ARGS:1 == "アイドル"
					;アイドルの場合はそれなりに歌唱経験を付ける
					RETURN (RAND(10, 20) * ABL:ARG:가창기능) + RAND:5
				ELSE
					RETURN 0
				ENDIF
		ENDSELECT
	CASE "모자"
		;動物耳がある場合はなし
		SIF TALENT:ARG:동물귀 == 0 
			RETURN 0
		;魔法少女の場合は服装もそれっぽくする
		IF ARGS:1 == "魔法少女"
			SELECTCASE RAND:10
				CASE 0
					RETURN [[衣装:화이트브림]]
				CASE 1
					RETURN [[衣装:너스캡]]
				CASE 2
					RETURN [[衣装:토끼귀밴드]]
				CASE 3
					RETURN [[衣装:리본]]
				CASE 4
					RETURN [[衣装:티아라]]
				CASE 5
