;前提条件が満たされていない場合の条件表示
@GOUSEI_前提条件表示, ID, GDS, GDN
#DIM DYNAMIC ID
#DIMS REF GDS, 0, 0
#DIM REF GDN, 0, 0

IF GDS:11:ID != ""
	CALL GOUSEI_CONDITION, GDS:11:ID
	PRINTFORML 합성조건：%RESULTS%
ENDIF


;合成可能かどうかの状態を更新する
@GOUSEI_UPDATE, GDS, GDN, IDMAX
#DIMS REF GDS, 0, 0
#DIM REF GDN, 0, 0
#DIM DYNAMIC IDMAX
#DIM DYNAMIC LCOUNT

FOR LCOUNT, 0, IDMAX
	IF GDS:10:LCOUNT != ""
		CALL TEST_GOUSEI_CONDITION(LCOUNT, GDS, GDN)
		GDN:11:LCOUNT = RESULT
	ENDIF
NEXT


;合成条件のテスト
;合成可能なら1、素材が不足なら0、前提条件が満たされていないなら-1
@TEST_GOUSEI_CONDITION, ID, GDS, GDN
#DIM ID
#DIMS REF GDS, 0, 0
#DIM REF GDN, 0, 0
#DIM LCOUNT

;前提条件チェック
IF GDS:11:ID != ""
	CALL GOUSEI_CONDITION, GDS:11:ID
	SIF !RESULT
		RETURN -1
ENDIF

;素材の所持数チェック
FOR LCOUNT, 0, 10
	SIF GDS:LCOUNT:ID == ""
		BREAK
	SIF GOUSEI_ITEM_HAVE_NUMBER(GDS:LCOUNT:ID) < MAX(GDN:LCOUNT:ID, 1)  ;素材必要数が0の場合でも1個は持っている必要がある
		RETURN 0
NEXT
RETURN 1


;条件文を処理してテスト結果と解説文を返す
;テストにパスしたら真、駄目なら偽を返す
;解説文はRESULTSに入れる
@GOUSEI_CONDITION, COND
#DIMS COND
#DIMS TEMPS, 10
#DIM LCOUNT
#DIM LCOUNT2
#DIM NUM
#DIMS 条件
#DIM 引数
#DIM 結果
#DIMS 解説文

結果 = 1
VARSET 解説文
SPLIT COND, ",", TEMPS
FOR LCOUNT, 0, RESULT / 2
	条件 '= TEMPS:(LCOUNT * 2)
	引数 = TOINT(TEMPS:(LCOUNT * 2 + 1))
	SIF LCOUNT != 0
		解説文 += "、"
	FOR LCOUNT2, 0, 4
		SELECTCASE LCOUNT2
		CASE 0
			;条件がTALENTの項目と一致したらそれで判定
			NUM = GETNUM(TALENT, 条件)
			IF NUM != -1
				解説文 += @"[%条件%]"
				SIF 引数 > 1
					解説文 += @"{引数} 이상
				結果 = 結果 && (TALENT:MASTER:NUM >= 引数)
				GOTO NEXTLOOP
			ENDIF
		CASE 1
			;条件がABLの項目と一致したらそれで判定
			NUM = GETNUM(ABL, 条件)
			IF NUM != -1
				解説文 += @"%条件% {引数} 이상"
				結果 = 結果 && (ABL:MASTER:NUM >= 引数)
				GOTO NEXTLOOP
			ENDIF
		CASE 2
			;アイテム名と解釈して所持個数を判定
			NUM = GETNUM(ITEM, 条件)
			IF NUM != -1
				解説文 += @"%条件% {引数}개 소지"
				結果 = 結果 && (ITEM:NUM >= 引数)
				GOTO NEXTLOOP
			ENDIF
		CASE 3
			;アイテム名でもなかったら関数指定と見なして呼び出す
			CALLFORM %条件%, 引数
			解説文 += RESULTS
			結果 = 結果 && RESULT
		CASEELSE
			THROW 아마도 편집 미스
		ENDSELECT
	NEXT
	$NEXTLOOP
NEXT
RESULTS '= 解説文
RETURN 結果




;アイテムを持っている数
@GOUSEI_ITEM_HAVE_NUMBER, アイテム
#FUNCTION
#DIMS アイテム
#DIM L_ITEMNUM
IF アイテム == "마카"
	RETURNF MONEY:1
ELSEIF アイテム == "￥"
	RETURNF MONEY
ELSE
	;---- EDIT 008 MOD START -------------------------
	IF GETNUM(ITEM, アイテム) < VARSIZE("COUNT_STOCK_ITEM")
		RETURNF ITEM:(アイテム) + COUNT_STOCK_ITEM:GETNUM(ITEM, アイテム)
	ELSE
		RETURNF ITEM:(アイテム)
	ENDIF
	;---- EDIT 008 MOD END ---------------------------
ENDIF

@GOUSEI_ITEM_CONSUME, アイテム, 個数
#DIMS アイテム
#DIM 個数
IF アイテム == "마카"
	MONEY:1 -= 個数
ELSEIF アイテム == "￥"
	MONEY -= 個数
ELSE
	ITEM:(アイテム) -= 個数
ENDIF



@GOUSEI_LOTTERY
#LOCALSIZE 1
IF MONEY:1 >= 200;EDIT 006 MOD
	PRINTFORML 복권을 뽑을 횟수를 입력해주세요。 (MAX {MIN(99,MONEY:1 / 100)})
	INPUT
	RESULT = MIN(RESULT, 99)
	IF RESULT < 1
		RETURN 0
	ELSEIF RESULT * 100 >= MONEY:1;EDIT 006 MOD
		LOCAL = MONEY:1 / 100
		MONEY:1 -= LOCAL * 100
		CALL GOUSEI_KUZI,LOCAL
	ELSE
		MONEY:1 -= RESULT * 100
		CALL GOUSEI_KUZI,RESULT
	ENDIF
ELSEIF MONEY:1 >= 100;EDIT 006 MOD
	CALL GOUSEI_KUZI,1
	MONEY:1 -= 100
ELSE
	PRINTW 마카가 부족합니다。
	RETURN 0
ENDIF
RETURN 1


@GOUSEI_KUZI,ARG
#DIM CONST ITEMID = 3204,3608,5203,1402,1010,1011,1012,1013,1014,1015,1029,1025,1026,1027,1104,1106,1108,1122,1124,1126,1128,1130,1132,1007,1050,1051,1052,1053,1041,1047,1100,1030,1008,1009,1007,1004,1031,1032,1033,1034,1035,1036,1040,1103,1105,1107,1109,1110,1111,1112,1120,1115,1116,1117,1118,5512,5521,41,40,5503,5504,5509,5510,5505,5506,5507,5508,5515,5500,5501,5502,5511,5513,5514,5516,5517,5518,5519,5520,1412
#DIM DYNAMIC L_ITEMNUM,80
#DIM DYNAMIC LCOUNT
#LOCALSIZE 1

VARSET L_ITEMNUM,0
LOCAL = 0
FOR LCOUNT,0,ARG
	LOCAL = RAND:100
	SELECTCASE LOCAL
		CASE IS < 5
			;5/100でレア装備
			LOCAL = RAND:3
			SELECTCASE LOCAL
				CASE 0
					;휴대용헤드폰
					L_ITEMNUM:0 += 1
				CASE 1
					;프로스트수트
					L_ITEMNUM:1 += 1
				CASEELSE
					;눈꽃
					L_ITEMNUM:2 += 1
			ENDSELECT
		CASE IS < 15
			;10/100 で装備箱
			L_ITEMNUM:3 += 1
		CASE IS < 65
			;50/100 で何かアイテム
			;25％で（＝総計10％で）レアアイテムを含むテーブル
			IF RAND:5 == 0
				LOCAL = RAND:76 + 4
			ELSE
				LOCAL = RAND:52 + 28
			ENDIF

			SELECTCASE LOCAL
				CASE 55 TO 57
					;万能弾、天魔の弾丸、媚薬
					L_ITEMNUM:LOCAL += 10
				CASE 58 TO 67
					;ローション、破魔呪殺、状態異常系弾丸
					L_ITEMNUM:LOCAL += 50
				CASE 68 TO 78
					;属性系弾丸
					L_ITEMNUM:LOCAL += 25
				CASEELSE
					;そのほか  x1
					L_ITEMNUM:LOCAL += 1
			ENDSELECT
		;10/100で 1 MORE!
		CASE IS < 75
			PRINTL 1 MORE！
			LCOUNT -= 2
		CASEELSE
			;25/100ではずれくじ
			L_ITEMNUM:79 += 1
	ENDSELECT
NEXT

WAIT
FOR LCOUNT,0,80
	IF L_ITEMNUM:LCOUNT > 0
		PRINTFORML %ITEMNAME:(ITEMID:LCOUNT)%ｘ{L_ITEMNUM:LCOUNT} %조사만처리(ITEMNAME:(ITEMID:LCOUNT),"가")% 당첨되었다！
		;---- EDIT 008 DEL START -------------------------
		;GET_ITEM自体に最大数の参照処理があるので
		;CALL CHECK_ITEMMAX,ITEMID:LCOUNT
		;SIF RESULT == 0
		;---- EDIT 008 DEL END ---------------------------
		CALL GET_ITEM,ITEMID:LCOUNT,L_ITEMNUM:LCOUNT
	ELSE
		CONTINUE
	ENDIF
NEXT
PRINTW

RETURN 0

;EDIT 010 MOD
@GOUSEI_MITAMA
#LOCALSIZE 1
IF ITEM:미타마의조각 >= 10
	PRINTFORML 제비를 뽑을 횟수를 입력해 주십시오. (MAX {MIN(99,ITEM:미타마의조각 / 10)})
	INPUT
	RESULT = MIN(RESULT, 99)
	IF RESULT < 1
		RETURN 0
	ELSEIF RESULT * 10 >= ITEM:미타마의조각
		LOCAL = ITEM:미타마의조각 / 10
		ITEM:미타마의조각 -= LOCAL * 10
		CALL GOUSEI_MKUZI,LOCAL
	ELSE
		ITEM:미타마의조각 -= RESULT * 10
		CALL GOUSEI_MKUZI,RESULT
	ENDIF
ELSEIF ITEM:미타마의조각 >= 10
	CALL GOUSEI_MKUZI,1
	ITEM:미타마의조각 -= 10
ELSE
	PRINTW 미타마의조각이 부족합니다。
	RETURN 0
ENDIF
RETURN 1

;EDIT 010 MOD
@GOUSEI_MKUZI,ARG
#DIM DYNAMIC ITEMID,24
#DIM DYNAMIC L_ITEMNUM,80
#DIM DYNAMIC LCOUNT
#LOCALSIZE 1
FOR LCOUNT,0,24
	ITEMID:LCOUNT = [[アイテム:어령즙・황]] + LCOUNT
NEXT

VARSET L_ITEMNUM,0
LOCAL = 0
FOR LCOUNT,0,ARG
	LOCAL = RAND:100
	SELECTCASE LOCAL
		CASE IS < 10
			;10/100で卦玉
			L_ITEMNUM:(16 + RAND:8) += 1
		CASE IS < 40
			;30/100 で魔晶石　2つ
			L_ITEMNUM:(8 + RAND:8) += 1
			L_ITEMNUM:(8 + RAND:8) += 1
		CASEELSE
			;60/100で御霊汁
			L_ITEMNUM:(0 + RAND:8) += 1
	ENDSELECT
NEXT

WAIT
FOR LCOUNT,0,80
	IF L_ITEMNUM:LCOUNT > 0
		PRINTFORML %ITEMNAME:(ITEMID:LCOUNT)% x {L_ITEMNUM:LCOUNT}에 당첨되었습니다!
		;---- EDIT 008 DEL START -------------------------
		;GET_ITEM自体に最大数の参照処理があるので
		;CALL CHECK_ITEMMAX,ITEMID:LCOUNT
		;SIF RESULT == 0
		;---- EDIT 008 DEL END ---------------------------
		CALL GET_ITEM,ITEMID:LCOUNT,L_ITEMNUM:LCOUNT
	ELSE
		CONTINUE
	ENDIF
NEXT
PRINTW

RETURN 0

@GOUSEI_EXEC, ID, GDS, GDN
#DIM DYNAMIC ID
#DIMS REF GDS, 0, 0
#DIM REF GDN, 0, 0
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC 素材
#DIMS DYNAMIC 非消費素材, 10
#DIM DYNAMIC 非消費素材数
#DIM DYNAMIC 個数
#DIM DYNAMIC 作成可能数
#DIM CONST 作成個数プリセット = 1, 2, 3, 4, 5, 10, 20, 50
#DIM DYNAMIC 作成回数

;所持数の空きチェック
CALL CHECK_ITEMMAX, GETNUM(ITEM, GDS:12:ID)
IF RESULT
	PRINTFORMW %GDS:12:ID%은(는) 더 이상 지닐 수 없습니다.
	RETURN 0
ENDIF
作成可能数 = 99
;素材表示
PRINTL 소비소재：
PRINTS "  "
FOR LCOUNT, 0, 10
	素材 '= GDS:LCOUNT:ID
	SIF 素材 == ""
		BREAK
	SIF LCOUNT != 0
		PRINTS ", "
	IF GDN:LCOUNT:ID == 0
		非消費素材:(非消費素材数++) '= 素材
	ELSE
		作成可能数 = MIN(GOUSEI_ITEM_HAVE_NUMBER(素材) / GDN:LCOUNT:ID, 作成可能数)
	ENDIF
	PRINTFORM %素材% {GDN:LCOUNT:ID}개 (소지수{GOUSEI_ITEM_HAVE_NUMBER(素材)})
NEXT
PRINTL
PRINTL
PRINTFORML 이상의 소재를 소비해【%GDS:12:ID%】%조사만처리(GDS:12:ID,"를")% 제작합니다。
IF 非消費素材数 != 0
	SETCOLOR COLOR("明桃色")
	PRINT ※
	FOR LCOUNT, 0, 非消費素材数
		SIF LCOUNT != 0
			PRINT 、
		PRINTFORM %非消費素材:LCOUNT%
	NEXT
	PRINTL 은(는) 소비되지 않습니다
ENDIF
IF GDS:13:ID != ""
	SETCOLOR COLOR("明桃色")
	PRINTFORML ※1개당 아이템 복수 단위가 작성될 가능성이 있습니다.
ELSEIF GDN:10:ID != 1
	SETCOLOR COLOR("明桃色")
	PRINTFORML ※1개당 아이템 {GDN:10:ID} 단위가 작성됩니다.
ENDIF
RESETCOLOR
PRINTL
;確認
PRINTL 작성할 개수를 지정해 주십시오 (직접 개수를 입력할 수도 있습니다):
PRINTS "[0]작성하지 않는다 "
FOR LCOUNT, 0, VARSIZE("作成個数プリセット")
	SIF 作成可能数 <= 作成個数プリセット:LCOUNT
		BREAK
	PRINTFORM  [{作成個数プリセット:LCOUNT,2}]
NEXT
PRINTFORM  [{作成可能数,2}]
PRINTPLAINFORM  -- (최대{作成可能数})
PRINTL
;入力
$INPUT_LOOP
INPUT
IF !INRANGE(RESULT, 0, 作成可能数)
	CLEARLINE 1
	REUSELASTLINE
	GOTO INPUT_LOOP
ENDIF
SIF RESULT == 0
	RETURN 0
作成回数 = RESULT

;素材消費
FOR LCOUNT, 0, 10
	素材 '= GDS:LCOUNT:ID
	SIF 素材 == ""
		BREAK
	SIF SUBSTRING(素材, 0, 1) == "*"
		CONTINUE
	CALL GOUSEI_ITEM_CONSUME, 素材, GDN:LCOUNT:ID * 作成回数
NEXT
;個数 = 合成個数
IF GDS:13:ID == ""
	個数 = GDN:10:ID * 作成回数
ELSE
	個数 = 0
	FOR LCOUNT, 0, 作成回数
		CALLFORM %GDS:13:ID%
		個数 += RESULT
	NEXT
ENDIF
SIF 個数 <= 0
	THROW 합성 결과의 개수 지정이 비정상입니다.({GDN:10:ID}/%GDS:13:ID%)
;入手
CALL GET_ITEMS, GDS:12:ID, 個数
PRINTFORMW %GDS:12:ID%을(를) {個数}개 작성했습니다.
RETURN 1



;合成項目登録用
;ITEM_GOUSEI2.ERBで使用
@GOUSEI_REG, GDS, GDN, ID, 結果, 素材, 条件="", 명칭=""
#DIMS REF GDS, 0, 0
#DIM REF GDN, 0, 0
#DIM ID
#DIMS 結果
#DIMS 素材
#DIMS 条件
#DIMS 명칭
#DIMS TEMPS, 20
#DIM LCOUNT

SIF GDS:10:ID != ""
	THROW 합성 항목 번호[{ID}]는 이미 정의되어 있습니다.(%GDS:10:ID% → %결과%)

;変数内容
;GDS:0～9:x   ;素材リスト1～10
;GDS:10:x     ;合成項目名
;GDS:11:x     ;前提条件
;GDS:12:x     ;結果アイテム
;GDS:13:x     ;合成個数取得関数（不要なら空文字列）
;GDN:0～9:x   ;素材必要数1～10
;GDN:10:x     ;合成個数（合成個数取得関数が設定された場合無効）
;GDN:11:x     ;合成可能状態（-1:条件未達、0:合成不可、1:合成可能）

SPLIT 結果, ",", TEMPS
GDS:12:ID '= TEMPS:0
IF RESULT == 1
	GDN:10:ID = 1
ELSEIF ISNUMERIC(TEMPS:1)
	GDN:10:ID = TOINT(TEMPS:1)
ELSE
	GDS:13:ID '= TEMPS:1
ENDIF

GDS:10:ID '= 명칭
SIF 명칭 == ""
	GDS:10:ID '= GDS:12:ID
GDS:11:ID '= 条件

SPLIT 素材, ",", TEMPS
SIF RESULT % 2 != 0
	THROW 합성 소재의 정의가 잘못되었습니다. 쉼표 오기 등을 확인해 주십시오.(%소재%)
SIF RESULT > 20
	THROW 설정된 필요 소재의 종류가 너무 많습니다. 10종류 이하로 해 주십시오.({RESULT})

FOR LCOUNT, 0, RESULT / 2
	GDS:LCOUNT:ID '= TEMPS:(LCOUNT * 2)
	GDN:LCOUNT:ID = TOINT(TEMPS:(LCOUNT * 2 + 1))
NEXT



