C = RESULT

VARSET DB
$ITEM_EXCHANGE

PRINTL 래그:
PRINTL 「그럼 뭐가 필요한지 골라 봐」
PRINTL
IF FLAG:아이템합성해금
	CALL RAG_SOZAI_EXCHANGE_表示(1,1420, "에메랄드", 1)
	CALL RAG_SOZAI_EXCHANGE_表示(2,1421, "아메지스트", 1)
	CALL RAG_SOZAI_EXCHANGE_表示(3,1422, "오팔", 1)
	CALL RAG_SOZAI_EXCHANGE_表示(4,1423, "가넷", 1)
	CALL RAG_SOZAI_EXCHANGE_表示(5,1424, "아쿠아마린", 1)
	CALL RAG_SOZAI_EXCHANGE_表示(6,1425, "오닉스", 1)
	CALL RAG_SOZAI_EXCHANGE_表示(7,1426, "터키석", 1)
	CALL RAG_SOZAI_EXCHANGE_表示(8,1427, "토파즈", 1)
	CALL RAG_SOZAI_EXCHANGE_表示(9,1428, "사파이어", 1)
	CALL RAG_SOZAI_EXCHANGE_表示(10,1429, "진주", 1)
	CALL RAG_SOZAI_EXCHANGE_表示(11,1430, "루비", 1)
	CALL RAG_SOZAI_EXCHANGE_表示(12,1431, "다이아몬드", 1)
ENDIF
IF イベントフラグ:33:1 == 4
	CALL RAG_SOZAI_EXCHANGE_表示(20,GETNUM(ITEM, "적색구슬・이위화"), "가넷", 3, "토파즈", 3, "루비", 3)
	CALL RAG_SOZAI_EXCHANGE_表示(21,GETNUM(ITEM, "청색구슬・태위택"), "오팔", 3, "아쿠아마린", 3, "사파이어", 3)
	CALL RAG_SOZAI_EXCHANGE_表示(22,GETNUM(ITEM, "황색구슬・진위뢰"), "아메지스트", 3, "터키석", 3, "진주", 3)
	CALL RAG_SOZAI_EXCHANGE_表示(23,GETNUM(ITEM, "녹색구슬・간위산"), "에메랄드", 3, "오닉스", 3, "다이아몬드", 3)
	CALL RAG_SOZAI_EXCHANGE_表示(24,GETNUM(ITEM, "갈색구슬・곤위지"), "가넷", 3, "오닉스", 3, "진주", 3)
	CALL RAG_SOZAI_EXCHANGE_表示(25,GETNUM(ITEM, "남색구슬・감위수"), "오팔", 3, "터키석", 3, "루비", 3)
	CALL RAG_SOZAI_EXCHANGE_表示(26,GETNUM(ITEM, "취색구슬・손위풍"), "에메랄드", 3, "토파즈", 3, "사파이어", 3)
	CALL RAG_SOZAI_EXCHANGE_表示(27,GETNUM(ITEM, "자색구슬・건위천"), "아메지스트", 3, "아쿠아마린", 3, "다이아몬드", 3)
ENDIF
PRINTL
PRINTFORM [999] 돌아간다　
PRINTFORML [1000] 가게를 나간다
INPUT
IF RESULT < 999 && DB:RESULT:0 > 0
	VARSET LOCAL
	VARSET LOCALS
	FOR LOCAL, 1, 28
		SIF DB:RESULT:LOCAL == 0
			CONTINUE
		LOCAL:LOCAL  = DB:RESULT:LOCAL / 100000
		A = DB:RESULT:LOCAL % 100000
		LOCALS:LOCAL = %ITEMNAME:A%
	NEXT
	LOCAL = DB:RESULT:0
	CALL RAG_SOZAI_EXCHANGE(LOCAL, LOCALS:1, LOCAL:1, LOCALS:2, LOCAL:2, LOCALS:3, LOCAL:3, LOCALS:4, LOCAL:4, LOCALS:5, LOCAL:5, LOCALS:6, LOCAL:6, LOCALS:7, LOCAL:7, LOCALS:8, LOCAL:8, LOCALS:9, LOCAL:9, LOCALS:10, LOCAL:10, LOCALS:11, LOCAL:11, LOCALS:12, LOCAL:12)
ENDIF
SELECTCASE RESULT
	CASE 999
		RETURN -1
	CASE 1000
		RETURN 0
ENDSELECT

GOTO ITEM_EXCHANGE

@RAG_SOZAI_EXCHANGE(ARG, ARGS:1, ARG:1, ARGS:2 = "", ARG:2 = 0, ARGS:3 = "", ARG:3 = 0, ARGS:4 = "", ARG:4 = 0, ARGS:5 = "", ARG:5 = 0, ARGS:6 = "", ARG:6 = 0, ARGS:7 = "", ARG:7 = 0, ARGS:8 = "", ARG:8 = 0, ARGS:9 = "", ARG:9 = 0, ARGS:10 = "", ARG:10 = 0, ARGS:11 = "", ARG:11 = 0, ARGS:12 = "", ARG:12 = 0)

#DIM 宝石種類, 13
#DIM 宝石必要数, 13
#DIM 宝石所持数, 13
#DIM 交換数, 1

VARSET 宝石種類,0
VARSET 宝石必要数,0
VARSET 宝石所持数,0

CALL CHECK_ITEMMAX , ARG
IF RESULT == 1
		PRINTL 래그:
		PRINTW 「더 이상 지닐 수 없잖아」
		RETURN 0
ENDIF

FOR LOCAL:2, 1, 13
	LOCAL:1 = 0
	FOR LOCAL, 1, 13
		SIF ARGS:LOCAL == ""
			CONTINUE
		RESULT = GETNUM(ITEM,ARGS:LOCAL)
		IF LOCAL:1 < RESULT
			LOCAL:1 = RESULT
			LOCAL:3 = LOCAL
		ENDIF
	NEXT
	SIF LOCAL:1 == 0
		BREAK
	IF LOCAL:1 > 0
		IF LOCAL:1 == 宝石種類:(LOCAL:2-1)
			LOCAL:2 --
			宝石必要数:(LOCAL:2) += ARG:(LOCAL:3)
			宝石所持数:(LOCAL:2) += ITEM:(ARGS:(LOCAL:3))
		ELSE
			宝石種類:(LOCAL:2) = LOCAL:1
			宝石必要数:(LOCAL:2) = ARG:(LOCAL:3)
			宝石所持数:(LOCAL:2) = ITEM:(ARGS:(LOCAL:3))
		ENDIF
		ARGS:(LOCAL:3) = ""
	ENDIF
NEXT
LOCAL:1 = 99
FOR LOCAL, 1, 13
	SIF 宝石種類:LOCAL == 0
		BREAK
	IF 宝石所持数:LOCAL < 宝石必要数:LOCAL
		PRINTL 래그:
		PRINTW 「보석이 부족하네」
		RETURN 0
	ENDIF
	SIF LOCAL:1 > (宝石所持数:LOCAL / 宝石必要数:LOCAL)
		LOCAL:1 = 宝石所持数:LOCAL / 宝石必要数:LOCAL
NEXT

CALL GET_ITEMMAX, ARG
SIF LOCAL:1 > (RESULT - ITEM:ARG)
	LOCAL:1 = RESULT - ITEM:ARG
$個数選択
PRINTL 래그:
PRINTFORML 「%ITEMNAME:ARG%을(를) 몇 개 갖고 싶은데?」(1~{LOCAL:1})
PRINTFORML ※수동 입력도 가능합니다
FOR LOCAL, 1, LOCAL:1 + 1
	SIF LOCAL == 31
		BREAK
	PRINT [
	PRINTFORM {LOCAL,2}
	PRINT ]
	SIF LOCAL % 10 == 0
		PRINTL
NEXT
PRINTL
PRINTL [ 0]그만둔다

INPUT
IF RESULT < 1
	RETURN 0
ELSEIF RESULT > LOCAL:1
	PRINTL 래그:
	PRINTFORML 「잠깐, 수량이 너무 많아」
	PRINTFORML
	PRINTFORML
	PRINTFORML
	GOTO 個数選択
ELSE
	交換数 = RESULT
ENDIF
PRINTL 래그:
PRINTFORML 「%ITEMNAME:ARG% {交換数}개와 교환이야. 괜찮아?」
FOR LOCAL, 1, 13
	SIF 宝石種類:LOCAL == 0
		BREAK
	PRINTFORML %ITEMNAME:(宝石種類:LOCAL),18,LEFT%　所持数:{宝石所持数:LOCAL,2} → {(宝石所持数:LOCAL-宝石必要数:LOCAL*交換数),2}
NEXT
CALL INPUT_YN("예", "아니오")
SIF RESULT == 1
	RETURN 0
	
	PRINTFORMW ＞%ITEMNAME:ARG%을(를) {交換数}개 손에 넣었다
	ITEM:ARG += 交換数
	FOR LOCAL, 1, 13
		SIF 宝石種類:LOCAL == 0
			BREAK
		ITEM:(宝石種類:LOCAL) -= 宝石必要数:LOCAL*交換数
	NEXT


@RAG_SOZAI_EXCHANGE_表示(ARG:13, ARG, ARGS:1, ARG:1, ARGS:2 = "", ARG:2 = 0, ARGS:3 = "", ARG:3 = 0, ARGS:4 = "", ARG:4 = 0, ARGS:5 = "", ARG:5 = 0, ARGS:6 = "", ARG:6 = 0, ARGS:7 = "", ARG:7 = 0, ARGS:8 = "", ARG:8 = 0, ARGS:9 = "", ARG:9 = 0, ARGS:10 = "", ARG:10 = 0, ARGS:11 = "", ARG:11 = 0, ARGS:12 = "", ARG:12 = 0)

#DIM 宝石種類, 13
#DIM 宝石必要数, 13
#DIM 宝石所持数, 13
#DIM LCOUNT

VARSET 宝石種類,0
VARSET 宝石必要数,0
VARSET 宝石所持数,0
LCOUNT = 0

;LOCAL = [[キャラ:%ARGS:0%]]

;PRINTFORM [{ARG:13,3}]
CALL SET_PICTURE , , , "消去"
CALL SET_PICTURE , @"[{ARG:13,3}]" , 0 , , LCOUNT
LCOUNT += 5

;PRINTFORM %ITEMNAME:ARG,26,LEFT%
CALL SET_PICTURE , @"%ITEMNAME:ARG,26,LEFT%" , 0 , , LCOUNT
LCOUNT += 26
DB:(ARG:13):0 = ARG

;PRINTFORM 所持数:{ITEM:ARG,3}　
CALL SET_PICTURE , @"所持数:{ITEM:ARG,3}　" , 0 , , LCOUNT
LCOUNT += 12

FOR LOCAL:2, 1, 13
	LOCAL:1 = 0
	FOR LOCAL, 1, 13
		SIF ARGS:LOCAL == ""
			CONTINUE
		RESULT = GETNUM(ITEM,ARGS:LOCAL)
		IF LOCAL:1 < RESULT
			LOCAL:1 = RESULT
			LOCAL:3 = LOCAL
		ENDIF
	NEXT
	SIF LOCAL:1 == 0
		BREAK
	IF LOCAL:1 > 0
		IF LOCAL:1 == 宝石種類:(LOCAL:2-1)
			LOCAL:2 --
			宝石必要数:(LOCAL:2) += ARG:(LOCAL:3)
			宝石所持数:(LOCAL:2) += ITEM:(ARGS:(LOCAL:3))
		ELSE
			宝石種類:(LOCAL:2) = LOCAL:1
			宝石必要数:(LOCAL:2) = ARG:(LOCAL:3)
			宝石所持数:(LOCAL:2) = ITEM:(ARGS:(LOCAL:3))
		ENDIF
		ARGS:(LOCAL:3) = ""
	ENDIF
NEXT
;PRINTFORM 必要な宝石:
CALL SET_PICTURE , "필요한 보석:" , 0 , , LCOUNT
LCOUNT += 11
LOCAL:3 = LCOUNT
LOCAL:4 = 0
FOR LOCAL, 1, 13
	SIF 宝石種類:LOCAL == 0
		BREAK
	IF LOCAL > 3 && LOCAL % 3 == 1
		LOCAL:4 ++
		LOCAL:3 = LCOUNT
		CALL SET_PICTURE , @"_[{ARG:13,3}],{C}_" , LOCAL:4 , , LOCAL:3 - 6
	ENDIF
	IF 宝石所持数:LOCAL >= 宝石必要数:LOCAL
		;SETCOLOR COLOR("水色")
		LOCAL:1 = COLOR("水色")
	ELSE
		;SETCOLOR COLOR("赤")
		LOCAL:1 = COLOR("赤")
	ENDIF
	;PRINTFORM %ITEMNAME:(宝石種類:LOCAL),18,LEFT%　({宝石所持数:LOCAL,2}/{宝石必要数:LOCAL,2})
	CALL SET_PICTURE , @"_%ITEMNAME:(宝石種類:LOCAL),14,LEFT%({宝石所持数:LOCAL,3}/{宝石必要数:LOCAL,3}) ,{LOCAL:1}_" , LOCAL:4 , , LOCAL:3
	LOCAL:3 += 24
	
	;RESETCOLOR
	DB:(ARG:13):LOCAL = 宝石種類:LOCAL
	DB:(ARG:13):LOCAL += 宝石必要数:LOCAL * 100000
NEXT
CALL SET_PICTURE ,  , 0 , "表示" , 1 + LOCAL:4
;PRINTFORML
