@RAG_SKILL_CARD
#LOCALSIZE 14
#LOCALSSIZE 13
#DIM SELL_EXTRA

GETBGCOLOR
C = RESULT

VARSET DB

;---- EDIT 004 MOD START -------------------------
;EX系カードはEXTRA出典の選出に依存させる。
IF GET_USEABLE_EXTRA_TITLE()
	PRINTL 어느 것으로 하겠습니까?
	CALL INPUT_YN, "통상", "EXTRA"
	SELL_EXTRA = RESULT
ELSE
	SELL_EXTRA = 0
ENDIF
$SKILL_CARD_EXCHANGE

PRINTL 래그:
PRINTL 「그럼 뭐가 필요한지 골라 봐」
PRINTL
IF SELL_EXTRA
    CALL RAG_SKILL_CARD_EXCHANGE_表示(1,GETNUM(ITEM, "스킬카드【풍파・카마이타치】"), "아메지스트", 5, "토파즈", 5,"오닉스", 5)
    CALL RAG_SKILL_CARD_EXCHANGE_表示(2,GETNUM(ITEM, "스킬카드【가재가르기】"), "에메랄드", 7, "가넷", 7)
ELSE
    CALL RAG_SKILL_CARD_EXCHANGE_表示(100,GETNUM(ITEM, "스킬카드【육체의악마】"), "루비", 10, "사파이어", 10,"오닉스", 10)
    CALL RAG_SKILL_CARD_EXCHANGE_表示(101,GETNUM(ITEM, "스킬카드【파사의광인】"), "다이아몬드", 10, "진주", 10, "아메지스트", 10)
    CALL RAG_SKILL_CARD_EXCHANGE_表示(102,GETNUM(ITEM, "스킬카드【갑옷관통】"), "토파즈", 7, "에메랄드", 7)
    CALL RAG_SKILL_CARD_EXCHANGE_表示(103,GETNUM(ITEM, "스킬카드【관통의일격】"), "터키석", 7, "아메지스트", 7)
    CALL RAG_SKILL_CARD_EXCHANGE_表示(104,GETNUM(ITEM, "스킬카드【수해의실】"), "아쿠아마린", 7, "오팔", 7,"토파즈", 7)
    CALL RAG_SKILL_CARD_EXCHANGE_表示(105,GETNUM(ITEM, "스킬카드【스카프런지】"), "오닉스", 7, "가넷", 7,"터키석", 7)
    CALL RAG_SKILL_CARD_EXCHANGE_表示(106,GETNUM(ITEM, "스킬카드【백발백중】"), "오팔", 2, "토파즈", 2,"아쿠아마린", 2)
    CALL RAG_SKILL_CARD_EXCHANGE_表示(107,GETNUM(ITEM, "스킬카드【천발천중】"), "오닉스", 7, "터키석", 7,"사파이어", 7)
    CALL RAG_SKILL_CARD_EXCHANGE_表示(108,GETNUM(ITEM, "스킬카드【결단】"), "에메랄드", 2, "오팔", 2,"가넷", 2)
ENDIF
    PRINTL
    PRINTFORM [999] 돌아간다　
    PRINTFORML [1000] 가게를 나간다
    INPUT
IF RESULT < 999 && DB:RESULT:0 > 0
	VARSET LOCAL
	VARSET LOCALS
	FOR LOCAL, 1, 13 
		SIF DB:RESULT:LOCAL == 0
			BREAK
		LOCAL:LOCAL  = DB:RESULT:LOCAL / 100000
		A = DB:RESULT:LOCAL % 100000
		LOCALS:LOCAL = %ITEMNAME:A%
	NEXT
	LOCAL = DB:RESULT:0
	CALL RAG_SKILL_CARD_EXCHANGE(LOCAL, LOCALS:1, LOCAL:1, LOCALS:2, LOCAL:2, LOCALS:3, LOCAL:3, LOCALS:4, LOCAL:4, LOCALS:5, LOCAL:5, LOCALS:6, LOCAL:6, LOCALS:7, LOCAL:7, LOCALS:8, LOCAL:8, LOCALS:9, LOCAL:9, LOCALS:10, LOCAL:10, LOCALS:11, LOCAL:11, LOCALS:12, LOCAL:12)
ENDIF
    SELECTCASE RESULT
    	CASE 999
    		RETURN -1
    	CASE 1000
    		RETURN 0
    ENDSELECT

GOTO SKILL_CARD_EXCHANGE
;---- EDIT 004 MOD END ---------------------------
@RAG_SKILL_CARD_EXCHANGE(ARG, ARGS:1, ARG:1, ARGS:2 = "", ARG:2 = 0, ARGS:3 = "", ARG:3 = 0, ARGS:4 = "", ARG:4 = 0, ARGS:5 = "", ARG:5 = 0, ARGS:6 = "", ARG:6 = 0, ARGS:7 = "", ARG:7 = 0, ARGS:8 = "", ARG:8 = 0, ARGS:9 = "", ARG:9 = 0, ARGS:10 = "", ARG:10 = 0, ARGS:11 = "", ARG:11 = 0, ARGS:12 = "", ARG:12 = 0)

#DIM 宝石種類, 13
#DIM 宝石必要数, 13
#DIM 宝石所持数, 13
#DIM 技番号, 1

VARSET 宝石種類,0
VARSET 宝石必要数,0
VARSET 宝石所持数,0

技番号 = ARG - 10000

CALL GET_SKILL_PROP, "SKILL_NAME", 技番号,-1
PRINTFORML %RESULTS%

CALL GET_SKILL_PROP, "SKILL_DECIDE_TYPE", 技番号, -1
IF RESULT == 1
	PRINT EXTRA   
ELSEIF RESULT == 2
	PRINT MAGIC   
ELSE
	PRINT PASSIVE 
ENDIF
IF RESULT == 2 || RESULT == 1
	CALL GET_SKILL_PROP, "SKILL_POWER", 技番号, -1
	PRINTFORM 威力：{RESULT,6,LEFT}
	
	CALL GET_SKILL_PROP, "SKILL_HITRATE", 技番号, -1
	PRINTFORML 命中：{RESULT,6,LEFT}
	
	CALL GET_SKILL_PROP, "SKILL_TYPE", 技番号,-1
	PRINTFORM %GET_TYPE(RESULT),8,LEFT%
	
	CALL GET_SKILL_PROP, "SKILL_COST", 技番号,-1
	PRINTFORM 消費：{RESULT,6,LEFT}
	
	CALL GET_SKILL_PROP, "SKILL_DAMAGETYPE", 技番号
	PRINT TYPE：
	IF RESULT == 1
		PRINTL 物理（力）
	ELSEIF RESULT == 2
		PRINTL 魔法（魔力）
	ELSE
		PRINTL 없음
	ENDIF
ELSE
	PRINTL 
ENDIF
CALL GET_SKILL_PROP, "SKILL_EXPLAIN", 技番号, -1
PRINTW

CALL CHECK_ITEMMAX , ARG
IF RESULT == 1
		PRINTL 래그:
		PRINTW 「더 이상 지닐 수 없잖아」
		RETURN 0
ENDIF

FOR LOCAL:2, 1, 13
	LOCAL:1 = 0
	FOR LOCAL, 1, 13
		SIF ARGS:LOCAL == ""
			CONTINUE
		RESULT = GETNUM(ITEM,ARGS:LOCAL)
		IF LOCAL:1 < RESULT
			LOCAL:1 = RESULT
			LOCAL:3 = LOCAL
		ENDIF
	NEXT
	SIF LOCAL:1 == 0
		BREAK
	IF LOCAL:1 > 0
		IF LOCAL:1 == 宝石種類:(LOCAL:2-1)
			LOCAL:2 --
			宝石必要数:(LOCAL:2) += ARG:(LOCAL:3)
			宝石所持数:(LOCAL:2) += ITEM:(ARGS:(LOCAL:3))
		ELSE
			宝石種類:(LOCAL:2) = LOCAL:1
			宝石必要数:(LOCAL:2) = ARG:(LOCAL:3)
			宝石所持数:(LOCAL:2) = ITEM:(ARGS:(LOCAL:3))
		ENDIF
		ARGS:(LOCAL:3) = ""
	ENDIF
NEXT
LOCAL:1 = 99
FOR LOCAL, 1, 13
	SIF 宝石種類:LOCAL == 0
		BREAK
	IF 宝石所持数:LOCAL < 宝石必要数:LOCAL
		PRINTL 래그:
		PRINTW 「보석이 부족하네」
		RETURN 0
	ENDIF
	SIF LOCAL:1 > (宝石所持数:LOCAL / 宝石必要数:LOCAL)
		LOCAL:1 = 宝石所持数:LOCAL / 宝石必要数:LOCAL
NEXT

PRINTL 래그:
PRINTFORML 「%ITEMNAME:ARG%(와)과 교환이야. 괜찮아?」
FOR LOCAL, 1, 13
	SIF 宝石種類:LOCAL == 0
		BREAK
	PRINTFORML %ITEMNAME:(宝石種類:LOCAL),18,LEFT%　所持数:{宝石所持数:LOCAL,2} → {(宝石所持数:LOCAL-宝石必要数:LOCAL),2}
NEXT
CALL INPUT_YN("예", "아니오")
SIF RESULT == 1
	RETURN 0
	
	PRINTFORMW ＞%ITEMNAME:ARG%을(를) 손에 넣었다
	ITEM:ARG += 1
	FOR LOCAL, 1, 13
		SIF 宝石種類:LOCAL == 0
			BREAK
		ITEM:(宝石種類:LOCAL) -= 宝石必要数:LOCAL
	NEXT


@RAG_SKILL_CARD_EXCHANGE_表示(ARG:13, ARG, ARGS:1, ARG:1, ARGS:2 = "", ARG:2 = 0, ARGS:3 = "", ARG:3 = 0, ARGS:4 = "", ARG:4 = 0, ARGS:5 = "", ARG:5 = 0, ARGS:6 = "", ARG:6 = 0, ARGS:7 = "", ARG:7 = 0, ARGS:8 = "", ARG:8 = 0, ARGS:9 = "", ARG:9 = 0, ARGS:10 = "", ARG:10 = 0, ARGS:11 = "", ARG:11 = 0, ARGS:12 = "", ARG:12 = 0)

#DIM 宝石種類, 13
#DIM 宝石必要数, 13
#DIM 宝石所持数, 13
#DIM LCOUNT

VARSET 宝石種類,0
VARSET 宝石必要数,0
VARSET 宝石所持数,0
LCOUNT = 0

;LOCAL = [[キャラ:%ARGS:0%]]

;PRINTFORM [{ARG:13,3}]
;---- EDIT 004 MOD START -------------------------
CALL SET_PICTURE , , , "消去"
CALL SET_PICTURE , @"[{ARG:13,3}] " , 0 , , LCOUNT
LCOUNT += 6

;PRINTFORM %ITEMNAME:ARG,34,LEFT%
;CALL SET_PICTURE , @"%ITEMNAME:ARG,34,LEFT%" , 0 , , LCOUNT
CALL SET_PICTURE , @"%SKILL_NAME_F(ARG - 10000), SKILLNAMELENS,LEFT%" , 0 , , LCOUNT
LCOUNT += SKILLNAMELENS
DB:(ARG:13):0 = ARG
;---- EDIT 004 MOD END ---------------------------
;PRINTFORM 所持数:{ITEM:ARG,3}　
CALL SET_PICTURE , @"所持数:{ITEM:ARG,3}　" , 0 , , LCOUNT
LCOUNT += 12

FOR LOCAL:2, 1, 13
	LOCAL:1 = 0
	FOR LOCAL, 1, 13
		SIF ARGS:LOCAL == ""
			CONTINUE
		RESULT = GETNUM(ITEM,ARGS:LOCAL)
		IF LOCAL:1 < RESULT
			LOCAL:1 = RESULT
			LOCAL:3 = LOCAL
		ENDIF
	NEXT
	SIF LOCAL:1 == 0
		BREAK
	IF LOCAL:1 > 0
		IF LOCAL:1 == 宝石種類:(LOCAL:2-1)
			LOCAL:2 --
			宝石必要数:(LOCAL:2) += ARG:(LOCAL:3)
			宝石所持数:(LOCAL:2) += ITEM:(ARGS:(LOCAL:3))
		ELSE
			宝石種類:(LOCAL:2) = LOCAL:1
			宝石必要数:(LOCAL:2) = ARG:(LOCAL:3)
			宝石所持数:(LOCAL:2) = ITEM:(ARGS:(LOCAL:3))
		ENDIF
		ARGS:(LOCAL:3) = ""
	ENDIF
NEXT
;PRINTFORM 必要な宝石:
CALL SET_PICTURE , "필요한 보석:" , 0 , , LCOUNT
LCOUNT += 11
LOCAL:3 = LCOUNT
LOCAL:4 = 0
FOR LOCAL, 1, 13
	SIF 宝石種類:LOCAL == 0
		BREAK
	IF LOCAL > 3 && LOCAL % 3 == 1
		LOCAL:4 ++
		LOCAL:3 = LCOUNT
		CALL SET_PICTURE , @"_[{ARG:13,3}],{C}_" , LOCAL:4 , , LOCAL:3 - 6
	ENDIF
	IF 宝石所持数:LOCAL >= 宝石必要数:LOCAL
		;SETCOLOR COLOR("水色")
		LOCAL:1 = COLOR("水色")
	ELSE
		;SETCOLOR COLOR("赤")
		LOCAL:1 = COLOR("赤")
	ENDIF
	;PRINTFORM %ITEMNAME:(宝石種類:LOCAL),18,LEFT%　({宝石所持数:LOCAL,2}/{宝石必要数:LOCAL,2})
	CALL SET_PICTURE , @"_%ITEMNAME:(宝石種類:LOCAL),14,LEFT%({宝石所持数:LOCAL,3}/{宝石必要数:LOCAL,3}) ,{LOCAL:1}_" , LOCAL:4 , , LOCAL:3
	LOCAL:3 += 24
	
	;RESETCOLOR
	DB:(ARG:13):LOCAL = 宝石種類:LOCAL
	DB:(ARG:13):LOCAL += 宝石必要数:LOCAL * 100000
NEXT
CALL SET_PICTURE ,  , 0 , "表示" , 1 + LOCAL:4
;PRINTFORML
