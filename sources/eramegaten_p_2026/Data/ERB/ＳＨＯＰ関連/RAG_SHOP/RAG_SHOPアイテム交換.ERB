@RAG_ITEM
#DIM CNT_SHOW_GOODS
#DIM CONST GODDSNAMELENS = 24
#DIM CONST RAGJUELNAMELENS = 16
#DIM DYNAMIC LCOUNT, 3
#DIM DYNAMIC L_LINE, 2
#DIM DYNAMIC L_SELECTNUM
#DIM DYNAMIC TEMP_RAGJUEL,RAGJUELNUM
#DIM DYNAMIC TEMP
#DIMS DYNAMIC TEMPS_RAGJUEL
#DIMS DYNAMIC TEMPS,2
#DIM DYNAMIC NEED_RAGJUEL, RAGJUELNUM
#DIMS DYNAMIC LISTHEADER
#DIMS DYNAMIC SHOWLINE
#DIM DYNAMIC SHOWLINENUM
#DIM DYNAMIC LISTNUM
#DIM DYNAMIC CNT_TRADE_GOODS, RAG_SHOP_USEITEM_VARNUM
#DIM DYNAMIC IS_TRADEABLE, RAG_SHOP_USEITEM_VARNUM
#DIM DYNAMIC IS_TRADEABLE_SINGLE, RAG_SHOP_USEITEM_VARNUM;購入可能可否を完全に単品で見る場合
#DIM DYNAMIC RAG_GOODS_NUM, RAG_SHOP_USEITEM_VARNUM
#DIMS DYNAMIC RAG_GOODS_NAME, RAG_SHOP_USEITEM_VARNUM
#DIM DYNAMIC RAG_GOODS_PRICE, RAG_SHOP_USEITEM_VARNUM, RAGJUEL_PRICE_MAX
#DIM DYNAMIC RAG_GOODS_ITEMNO, RAG_SHOP_USEITEM_VARNUM, 10
#DIMS DYNAMIC TEMP_GOODS_NAME
#DIM DYNAMIC TEMP_GOODS_PRICE, RAG_SHOP_USEITEM_VARNUM
#DIM DYNAMIC TEMP_GOODS_ITEMNO, RAG_SHOP_USEITEM_VARNUM
#DIM DYNAMIC GOODS_PAGE
VARSET RAG_GOODS_NUM, -1

CNT_SHOW_GOODS = GET_HEIGHTLENS() - 22
CUSTOMDRAWLINE =
LISTHEADER += TOALIGNMENT("交換数", 9, "CENTER")
LISTHEADER += " "
LISTHEADER += TOALIGNMENT("所持", 4, "CENTER")
LISTHEADER += "  No " + " "
LISTHEADER += "　"
LISTHEADER += TOALIGNMENT("명칭", GODDSNAMELENS, "CENTER")
LISTHEADER += " "
LISTHEADER += TOALIGNMENT("要求宝石", (RAGJUELNAMELENS + 1) * RAGJUEL_PRICE_MAX - 1, "CENTER")
LISTHEADER += " "
HTML_PRINT LISTHEADER
FOR LCOUNT, 0, RAG_SHOP_USEITEM_VARNUM
	VARSET TEMP_GOODS_PRICE
	VARSET TEMP_GOODS_ITEMNO
	TRYCCALLFORM SET_VAR_RAGTRADE_USEITEM_{LCOUNT}, TEMP_GOODS_NAME, TEMP_GOODS_PRICE, TEMP_GOODS_ITEMNO
		SIF !RESULT
			CONTINUE
		LISTNUM = FINDELEMENT(RAG_GOODS_NUM, -1)
		RAG_GOODS_NUM:LISTNUM = LCOUNT
		RAG_GOODS_NAME:LISTNUM '= TEMP_GOODS_NAME
		FOR LCOUNT:1, 0, RAGJUEL_PRICE_MAX
			RAG_GOODS_PRICE:LISTNUM:(LCOUNT:1) = TEMP_GOODS_PRICE:(LCOUNT:1)
		NEXT
		FOR LCOUNT:1, 0, 10
			RAG_GOODS_ITEMNO:LISTNUM:(LCOUNT:1) = TEMP_GOODS_ITEMNO:(LCOUNT:1)
		NEXT
	CATCH
		CONTINUE
	ENDCATCH
NEXT
L_LINE = LINECOUNT
$PRINT_START
REDRAW 0
CLEARLINE LINECOUNT - L_LINE
DRAWLINE
;----------------------------------------------------------------
;必要宝石数/購入可否の取得
;----------------------------------------------------------------
VARSET NEED_RAGJUEL
VARSET IS_TRADEABLE
;必要数の取得
FOR LCOUNT, 0, RAG_SHOP_USEITEM_VARNUM
	SIF RAG_GOODS_NUM:LCOUNT < 0
		CONTINUE
	FOR LCOUNT:1, 0, RAGJUEL_PRICE_MAX
		SIF !RAG_GOODS_PRICE:LCOUNT:(LCOUNT:1)
			CONTINUE
		TEMPS_RAGJUEL '= ITEMNAME:(RAG_GOODS_PRICE:LCOUNT:(LCOUNT:1))
		TEMP = FINDELEMENT(RAGJUEL_TABLE, TEMPS_RAGJUEL, , , 1)
		NEED_RAGJUEL:TEMP += CNT_TRADE_GOODS:LCOUNT
	NEXT
NEXT
;購入可否の判定
FOR LCOUNT, 0, RAG_SHOP_USEITEM_VARNUM
	SIF RAG_GOODS_NUM:LCOUNT < 0
		CONTINUE
	IS_TRADEABLE:LCOUNT = 1
	IS_TRADEABLE_SINGLE:LCOUNT = 1
	VARSET TEMP_RAGJUEL
	FOR LCOUNT:1, 0, RAGJUEL_PRICE_MAX
		SIF !RAG_GOODS_PRICE:LCOUNT:(LCOUNT:1)
			CONTINUE
		TEMPS_RAGJUEL '= ITEMNAME:(RAG_GOODS_PRICE:LCOUNT:(LCOUNT:1))
		TEMP = FINDELEMENT(RAGJUEL_TABLE, TEMPS_RAGJUEL, , , 1)
		TEMP_RAGJUEL:TEMP += 1
		SIF GETS_HAVE_ITEM_NUM(TEMPS_RAGJUEL) < NEED_RAGJUEL:TEMP + TEMP_RAGJUEL:TEMP
			IS_TRADEABLE:LCOUNT = 0
		
		TEMP = 0
		;重複する宝石の数を数える
		FOR LCOUNT:2, 0, RAGJUEL_PRICE_MAX
			SIF RAG_GOODS_PRICE:LCOUNT:(LCOUNT:1) == RAG_GOODS_PRICE:LCOUNT:(LCOUNT:2)
				TEMP++
		NEXT
		SIF GETS_HAVE_ITEM_NUM(TEMPS_RAGJUEL) < TEMP
			IS_TRADEABLE_SINGLE:LCOUNT = 0
	NEXT
	;所持数による判定
	IF !RAG_GOODS_PRICE:LCOUNT:1
		TEMP = RAG_GOODS_ITEMNO:LCOUNT:0
		CALL GET_ITEMMAX, TEMP
		SIF GET_HAVE_ITEM_NUM(TEMP) + 1 > RESULT
			IS_TRADEABLE_SINGLE:LCOUNT = 0
		SIF GET_HAVE_ITEM_NUM(TEMP) + CNT_TRADE_GOODS:LCOUNT + 1 > RESULT
			IS_TRADEABLE:LCOUNT = 0
	ENDIF
NEXT


FOR LCOUNT, 0, CNT_SHOW_GOODS
	LISTNUM = CNT_SHOW_GOODS * GOODS_PAGE + LCOUNT
	IF RAG_GOODS_NUM:LISTNUM >= 0
		;----------------------------------------------------------------
		;購入ボタン
		;----------------------------------------------------------------
		SHOWLINE = 
		TEMPS '= UNICODE(0x25c0) * 2
		IF CNT_TRADE_GOODS:LISTNUM > 0
			TEMPS '= SET_COLOR_TAG(TEMPS, "p-green")
		ELSE
			TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
		ENDIF
		TEMPS '= SET_BUTTON_TAG(TEMPS, "GOODS_PAGEDOWN," + TOSTR(LISTNUM))
		SHOWLINE += TEMPS
		SHOWLINE += " " + TOSTR(CNT_TRADE_GOODS:LISTNUM, "000") + " "
		TEMPS '= UNICODE(0x25B6) * 2
		IF IS_TRADEABLE:LISTNUM > 0
			TEMPS '= SET_COLOR_TAG(TEMPS, "p-green")
		ELSE
			TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
		ENDIF
		TEMPS '= SET_BUTTON_TAG(TEMPS, "GOODS_PAGEUP," + TOSTR(LISTNUM))
		SHOWLINE += TEMPS

		;----------------------------------------------------------------
		;所持数
		;----------------------------------------------------------------
		TEMPS '= " "
		IF !RAG_GOODS_ITEMNO:LISTNUM:1
			TEMPS += "x" + @"{GET_HAVE_ITEM_NUM(RAG_GOODS_ITEMNO:LISTNUM:0), 3}"
		ELSE
			TEMPS += " " * 4
		ENDIF
		;----------------------------------------------------------------
		;NO + 名前
		;----------------------------------------------------------------
		TEMPS += " "
		TEMPS += @"[{LISTNUM, 2}] "
		IF LISTNUM == L_SELECTNUM
			TEMPS += UNICODE(0x274F)
		ELSE
			TEMPS += "　"
		ENDIF
		TEMPS += TOALIGNMENT(RAG_GOODS_NAME:LISTNUM, GODDSNAMELENS, "LEFT")
		TEMPS += " "
		FOR LCOUNT:1, 0, RAGJUEL_PRICE_MAX
			IF RAG_GOODS_PRICE:LISTNUM:(LCOUNT:1)
				TEMPS_RAGJUEL '= ITEMNAME:(RAG_GOODS_PRICE:LISTNUM:(LCOUNT:1))
				TEMP = -1
				;重複する宝石の数を数える
				FOR LCOUNT:2, 0, RAGJUEL_PRICE_MAX
					SIF RAG_GOODS_PRICE:LISTNUM:(LCOUNT:1) == RAG_GOODS_PRICE:LISTNUM:(LCOUNT:2)
						TEMP++
				NEXT
				IF ITEM:TEMPS_RAGJUEL > NEED_RAGJUEL:FINDELEMENT(RAGJUEL_TABLE, TEMPS_RAGJUEL, , , 1) + TEMP
					TEMPS += SET_COLOR_TAG(TOALIGNMENT(TEMPS_RAGJUEL, RAGJUELNAMELENS, "LEFT"), "default")
				ELSE
					TEMPS += SET_COLOR_TAG(TOALIGNMENT(TEMPS_RAGJUEL, RAGJUELNAMELENS, "LEFT"), "dark-gray")
				ENDIF
			ELSE
				TEMPS += " " * RAGJUELNAMELENS
			ENDIF
			TEMPS += " "
		NEXT
		TEMPS '= SET_BUTTON_TAG(TEMPS, @"SELECT,{LISTNUM}")
		SHOWLINE += TEMPS
		HTML_PRINT SHOWLINE
	ELSE
		PRINTL 
	ENDIF
NEXT
IF RAG_GOODS_NUM:CNT_SHOW_GOODS >= 0
	SHOWLINE = 
	FOR LCOUNT, 0, RAG_SHOP_USEITEM_VARNUM / CNT_SHOW_GOODS
		SIF RAG_GOODS_NUM:(CNT_SHOW_GOODS * LCOUNT) < 0
			CONTINUE
		SIF LCOUNT
			SHOWLINE += " " * 5
		TEMPS '= SET_BUTTON_TAG(@"[{800 + LCOUNT}] Page.{LCOUNT + 1}", TOSTR(800 + LCOUNT))
		SIF GOODS_PAGE == LCOUNT
			TEMPS '= SET_COLOR_TAG(TEMPS, "p-green")
		SHOWLINE += TEMPS
	NEXT
	HTML_PRINT SHOWLINE
ENDIF
DRAWLINE
PRINTL □宝石
FOR LCOUNT:1, 0, 3
	SHOWLINE '= " " * 6
	FOR LCOUNT, 0, (RAGJUELNUM / 4 + 1)
		SIF LCOUNT:1 * 4 + LCOUNT > RAGJUELNUM
			CONTINUE
		TEMP_RAGJUEL = LCOUNT:1 * 4 + LCOUNT
		TEMPS_RAGJUEL '= RAGJUEL_TABLE:TEMP_RAGJUEL
		TEMPS '= ""
		TEMPS += TOALIGNMENT(TEMPS_RAGJUEL, RAGJUELNAMELENS, "LEFT") + ":"
		TEMPS += TOALIGNMENT(TOSTR(MIN(NEED_RAGJUEL:TEMP_RAGJUEL, 999)), 3, "RIGHT")
		TEMPS += "/"
		TEMPS += TOALIGNMENT(TOSTR(MIN(ITEM:TEMPS_RAGJUEL, 999)), 3, "RIGHT")
		SIF NEED_RAGJUEL:TEMP_RAGJUEL > 0
			TEMPS '= SET_COLOR_TAG(TEMPS, "p-green")
		SHOWLINE += TEMPS
		SHOWLINE += " " * 6
	NEXT
	HTML_PRINT SHOWLINE
NEXT
DRAWLINE
L_LINE:1 = LINECOUNT
SIF L_SELECTNUM >= 0
	CALL PRINT_RAG_USEITEM, L_SELECTNUM
WHILE LINECOUNT < L_LINE:1 + 7
	PRINTL 
WEND
CUSTOMDRAWLINE =
CALL PRINT_COLOR, "[900]  ＴＲＡＤＥ", MAXARRAY(CNT_TRADE_GOODS) ? COLOR("p-green") # COLOR("gray"), "L"
CALL PRINT_COLOR, "[998]  ＣＬＥＡＲ", MAXARRAY(CNT_TRADE_GOODS) ? COLOR("p-green") # COLOR("gray"), "L"
PRINTL [999]  ＣＡＮＣＥＬ
PRINTL [1000] 가게를 나간다
INPUTS
IF ISNUMERIC(RESULTS)
	RESULT = TOINT(RESULTS)
	SELECTCASE RESULT
		CASE 0 TO RAG_SHOP_USEITEM_VARNUM - 1
			L_SELECTNUM = RAG_GOODS_NUM:RESULT
			IF IS_TRADEABLE_SINGLE:L_SELECTNUM
				CLEARLINE 1
				DRAWLINE
				CALL PRINT_RAG_USEITEM, L_SELECTNUM
				GOTO SINGLE_CHOICE
			ENDIF
		CASE 800 TO 800 + RAG_SHOP_USEITEM_VARNUM / CNT_SHOW_GOODS - 1
			SIF RAG_GOODS_NUM:((RESULT - 800) * CNT_SHOW_GOODS) >= 0
				GOODS_PAGE = RESULT - 800
		CASE 900
			IF MAXARRAY(CNT_TRADE_GOODS) > 0
				FOR LCOUNT:1, 0, RAG_SHOP_USEITEM_VARNUM
					TEMP = 0
					FOR LCOUNT, 0, 10
						SIF !RAG_GOODS_ITEMNO:(LCOUNT:1):LCOUNT
							CONTINUE
						CALL CHECK_ITEMMAX, RAG_GOODS_ITEMNO:L_SELECTNUM:LCOUNT
						SIF !RESULT
							CONTINUE
						TEMP = 1
						BREAK
					NEXT
					SIF TEMP
						BREAK
				NEXT
				IF TEMP
					PRINTL 이런, 더 이상 지닐 수 없는 아이템이 있는데 그래도 괜찮아?
				ELSE
					PRINTL 정말로 교환해도 괜찮아?
				ENDIF
				CALL INPUT_YN
				IF !RESULT
					PRINTFORMW 아이템과 보석을 교환했다.
					FOR LCOUNT:1, 0, RAG_SHOP_USEITEM_VARNUM
						FOR LCOUNT, 0, RAGJUEL_PRICE_MAX
							SIF RAG_GOODS_PRICE:(LCOUNT:1):LCOUNT
								CALL GET_ITEM, RAG_GOODS_PRICE:(LCOUNT:1):LCOUNT, -CNT_TRADE_GOODS:(LCOUNT:1)
						NEXT
						FOR LCOUNT, 0, 10
							SIF RAG_GOODS_ITEMNO:(LCOUNT:1):LCOUNT
								CALL GET_ITEM, RAG_GOODS_ITEMNO:(LCOUNT:1):LCOUNT, CNT_TRADE_GOODS:(LCOUNT:1)
						NEXT
					NEXT
					VARSET CNT_TRADE_GOODS
				ELSE
					PRINTFORMW 그래. 그럼 느긋하게 골라 봐.
				ENDIF
			ENDIF
		CASE 998
			VARSET CNT_TRADE_GOODS
		CASE 999
			REDRAW 1
			RETURN -1
		CASE 1000
			REDRAW 1
			RETURN 0
	ENDSELECT
ELSE
	SELECTCASE AUTO_SPLIT(RESULTS, ",", 0)
		CASE "SELECT"
			RESULT = TOINT(AUTO_SPLIT(RESULTS, ",", 1))
			IF L_SELECTNUM == RESULT
				IF IS_TRADEABLE_SINGLE:L_SELECTNUM
					TEMPS:1 = 
					CLEARLINE 1
					$SINGLE_CHOICE
					DRAWLINE
					TEMPS = 
					FOR LCOUNT, 0, RAGJUEL_PRICE_MAX
						SIF !RAG_GOODS_PRICE:L_SELECTNUM:LCOUNT
							CONTINUE
						TEMPS_RAGJUEL '= ITEMNAME:(RAG_GOODS_PRICE:L_SELECTNUM:LCOUNT)
						SIF STRCOUNT(TEMPS, TEMPS_RAGJUEL)
							CONTINUE
						SIF TEMPS != ""
							TEMPS += "와(과) "
						TEMPS += TEMPS_RAGJUEL
					NEXT
					TEMP = 0
					FOR LCOUNT, 0, 10
						SIF !RAG_GOODS_ITEMNO:L_SELECTNUM:LCOUNT
							CONTINUE
						CALL CHECK_ITEMMAX, RAG_GOODS_ITEMNO:L_SELECTNUM:LCOUNT
						SIF !RESULT
							CONTINUE
						TEMP = 1
						BREAK
					NEXT
					IF TEMP
						PRINTFORML %RAG_GOODS_NAME:L_SELECTNUM%은(는) %TEMPS:1%이야.
						PRINTL 이런, 더 이상 지닐 수 없는 아이템이 있는데 그래도 괜찮아?
					ELSE
						PRINTFORML %RAG_GOODS_NAME:L_SELECTNUM%(이)라면 %TEMPS%(와)과 교환이야. 괜찮아?
					ENDIF
					CALL INPUT_YN
					CLEARLINE 1
					IF !RESULT
						PRINTFORMW %RAG_GOODS_NAME:L_SELECTNUM%을(를) 손에 넣었다.
						FOR LCOUNT, 0, RAGJUEL_PRICE_MAX
							SIF RAG_GOODS_PRICE:L_SELECTNUM:LCOUNT
								CALL GET_ITEM, RAG_GOODS_PRICE:L_SELECTNUM:LCOUNT, -1
						NEXT
						FOR LCOUNT, 0, 10
							SIF RAG_GOODS_ITEMNO:L_SELECTNUM:LCOUNT
								CALL GET_ITEM, RAG_GOODS_ITEMNO:L_SELECTNUM:LCOUNT, 1
						NEXT
					ELSE
						PRINTFORMW 그래. 그럼 다른 걸 골라 봐.
					ENDIF
				ENDIF
			ELSE
				L_SELECTNUM = RAG_GOODS_NUM:RESULT
			ENDIF
		CASE "GOODS_PAGEDOWN"
			RESULT = TOINT(AUTO_SPLIT(RESULTS, ",", 1))
			L_SELECTNUM = RAG_GOODS_NUM:RESULT
			SIF CNT_TRADE_GOODS:RESULT
				CNT_TRADE_GOODS:RESULT--
		CASE "GOODS_PAGEUP"
			RESULT = TOINT(AUTO_SPLIT(RESULTS, ",", 1))
			L_SELECTNUM = RAG_GOODS_NUM:RESULT
			SIF IS_TRADEABLE:RESULT
				CNT_TRADE_GOODS:RESULT++
	ENDSELECT
ENDIF
GOTO PRINT_START

@PRINT_RAG_USEITEM, L_SELECTNUM
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC TEMPS
#DIMS DYNAMIC SHOWLINE
#DIM DYNAMIC L_SELECTNUM
#DIM DYNAMIC L_ITEMNO
#DIMS DYNAMIC RAG_GOODS_NAME
#DIM DYNAMIC RAG_GOODS_PRICE, RAG_SHOP_USEITEM_VARNUM
#DIM DYNAMIC RAG_GOODS_ITEMNO, RAG_SHOP_USEITEM_VARNUM

CALLFORM SET_VAR_RAGTRADE_USEITEM_{L_SELECTNUM}, RAG_GOODS_NAME, RAG_GOODS_PRICE, RAG_GOODS_ITEMNO
PRINTFORML □%RAG_GOODS_NAME%
IF !RAG_GOODS_ITEMNO:1
	IF INRANGE(RAG_GOODS_ITEMNO:0, MIN_USEITEMNUM, MAX_USEITEMNUM)
		VARI TEMP_LINE = LINECOUNT
		CALL GET_SKILL_PROP, "SKILL_EXPLAIN", CONVERT_USEITEMNUM_TO_SKILLNUM(RAG_GOODS_ITEMNO:0), -1
		IF TEMP_LINE != LINECOUNT
			CALL GET_ITEMMAX, RAG_GOODS_ITEMNO:0
			IF RESULT:1 > 0
				PRINTL 
				PRINTFORML 携帯可能数:{RESULT:1}
				PRINTFORML 所持数　　:{GET_HAVE_ITEM_NUM(RAG_GOODS_ITEMNO:0)}
			ENDIF
		ELSE
			PRINTL 정보 없음
		ENDIF
	ELSE
		TRYCCALLFORM アイテム解説_{RAG_GOODS_ITEMNO:0}
			CALL GET_ITEMMAX, RAG_GOODS_ITEMNO:0
			PRINTL 
			PRINTFORML 最大所持数:{RESULT:1}
			PRINTFORML 所持数　　:{GET_HAVE_ITEM_NUM(RAG_GOODS_ITEMNO:0)}
		CATCH
			PRINTL 정보 없음
		ENDCATCH
	ENDIF
ELSE
	SHOWLINE = 
	FOR LCOUNT, 0, 10
		L_ITEMNO = RAG_GOODS_ITEMNO:LCOUNT
		SIF !L_ITEMNO
			CONTINUE
		CALL GET_SKILL_EXPLAIN_TOOLTIP, CONVERT_USEITEMNUM_TO_SKILLNUM(L_ITEMNO)
		TEMPS '= RESULTS
		CALL GET_ITEMMAX, L_ITEMNO
		SIF RESULT:1 > 0
			TEMPS += UNICODE(0x000D) + @"携帯可能数:{RESULT}"
		TEMPS += UNICODE(0x000D) + @"所持数　　:{GET_HAVE_ITEM_NUM(L_ITEMNO)}"
		SHOWLINE += SET_BUTTON_TAG(TOALIGNMENT("【" + ITEMNAME:L_ITEMNO + "】", 24, "LEFT"), ,TEMPS)
		IF LCOUNT % 3 == 2
			HTML_PRINT SHOWLINE
			SHOWLINE = 
		ENDIF
	NEXT
	SIF SHOWLINE != ""
		HTML_PRINT SHOWLINE
ENDIF


