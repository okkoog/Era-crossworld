				SHOW_LINE += @"<div xpos = '{100 + LCOUNT * L_WIDTH}' ypos = '0'>" + SET_BUTTON_TAG(RESULTS, TOSTR(LISTNO + 10)) + "</div>"
			ENDIF
		NEXT
		HTML_PRINT SHOW_LINE
		FOR LCOUNT:2, 0, L_HEIGHT / 100 + (L_HEIGHT % 100 > 0)
			PRINTFORML 
		NEXT
	NEXT
	PRINTL 
	CUSTOMDRAWLINE =
	VARSET SHOW_LINE
	FOR LCOUNT, 0, MAX_PAGE + 1
		IF LCOUNT == L_PAGE
			SHOW_LINE += SET_COLOR_TAG(SET_BUTTON_TAG(@"[{LCOUNT + 1}] Page.{LCOUNT + 1}", TOSTR(LCOUNT + 1)), "p-green")
		ELSE
			SHOW_LINE += SET_BUTTON_TAG(@"[{LCOUNT + 1}] Page.{LCOUNT + 1}", TOSTR(LCOUNT + 1))
		ENDIF
		SHOW_LINE += " " * 8
	NEXT
	HTML_PRINT SHOW_LINE
	CUSTOMDRAWLINE =
	HTML_PRINT SET_BUTTON_TAG("[9] 돌아간다", "9")
	INPUT
	SELECTCASE RESULT
		CASE 1 TO MAX_PAGE + 1
			L_PAGE = RESULT - 1
			CONTINUE
		CASE 10 TO VARSIZE("SALE_LIST") - 10
			LISTNO = RESULT - 10
		CASE 9
			PRINTL 래그:
			PRINTL 「오늘은 그만둘래?
			PRINTW  뭐 괜찮지만 필요해지면 또 와」
			REDRAW STOCK_REDRAW
			RETURN 1
		CASEELSE
			CONTINUE
	ENDSELECT
	;キャラが選択された
	VARI LINE_CHARA = LINECOUNT
	WHILE 1
		L_CHARA_NO = SALE_LIST:LISTNO
		SIF !L_CHARA_NO
			CONTINUE
		CALL ADD_NEW_COMPANION,  L_CHARA_NO, 0, , 1
		VARI SELECT_CHARA = CHARANUM - 1
		U = SELECT_CHARA
		CLEARLINE LINECOUNT - LINE_CHARA
		CUSTOMDRAWLINE =
		PRINTFORML %CALLNAME:U%
		CALLFORM SHOW_INFO_PAGE_{L_ST_PAGE}
		SIF L_ST_PAGE == 2
			CLEARLINE 1
		WHILE LINECOUNT < LINE_CHARA + 40
			PRINTL 
		WEND
		DELCHARA SELECT_CHARA

		CUSTOMDRAWLINE =
		HTML_PRINT SET_BUTTON_TAG("[7] 이전페이지", "7") + " " * 8 + SET_BUTTON_TAG("[8] 돌아간다", "8") + " " * 8 + SET_BUTTON_TAG("[9] 다음페이지", "9")
		HTML_PRINT SET_BUTTON_TAG("[-] 이전 캐릭터", "-") + " " * 8 + SET_BUTTON_TAG("[0] 결정", "0") + " " * 8 + SET_BUTTON_TAG("[+] 다음 캐릭터", "+")
		ONEINPUTS
		SELECTCASE RESULTS
			CASE "0"
				PRINTL 래그:
				PRINTL 「자, 이 아이를 줄게
				PRINTW  덤으로 다른 상품도 사 가 줘.」
				ITEM:라그티켓【Ev】 = 0
				CALL ADD_NEW_COMPANION_RAG, L_CHARA_NO
				REDRAW STOCK_REDRAW
				RETURN 1
			CASE "7"
				L_ST_PAGE = L_ST_PAGE == 1 ? 4 # L_ST_PAGE - 1
			CASE "8"
				BREAK
			CASE "9"
				L_ST_PAGE = L_ST_PAGE == 4 ? 1 # L_ST_PAGE + 1
			CASE "+"
				LISTNO++
				SIF SALE_LIST:LISTNO == 0
					LISTNO = 0
			CASE "-"
				SIF LISTNO-- == 0
					LISTNO = FINDELEMENT(SALE_LIST, 0) - 1
		ENDSELECT
	WEND
WEND

