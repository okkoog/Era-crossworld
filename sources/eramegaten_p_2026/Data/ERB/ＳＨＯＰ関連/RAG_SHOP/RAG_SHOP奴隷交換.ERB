		FOR LCOUNT, 0, COLUMNNUM
			LISTNO = LCOUNT:1 * 2 + LCOUNT + L_PAGE * ROWNUM * COLUMNNUM
			VARI L_HEIGHT = 800
			IF SALE_LIST:LISTNO > 0
