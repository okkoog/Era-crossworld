		RESULTS = %CSTR:(CHARANUM-1):롤%
	ENDCATCH
	L_RESULTS += @"<div xpos = '{L_HEIGHT + 150}' ypos = '150'>" + "    " + "롤:" + AUTO_SPLIT(RESULTS, "/", 0) + "</div>"
