					ONEINPUTS
					SELECTCASE RESULTS
						CASE "", "ENTER"
							DELCHARA SELECT_CHARA
							IS_RETURNED = 1
							GOTO RETURNED
						CASE "7"
							L_ST_PAGE = L_ST_PAGE == 1 ? 4 # L_ST_PAGE - 1
						CASE "9"
							L_ST_PAGE = L_ST_PAGE == 4 ? 1 # L_ST_PAGE + 1
					ENDSELECT
				WEND
			CASE "0"
				PRINTL 래그:
