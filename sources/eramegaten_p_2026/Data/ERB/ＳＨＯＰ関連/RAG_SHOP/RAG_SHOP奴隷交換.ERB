;--------------------------------------------------------------------------------------------
;ラグショップの奴隷販売(인간)の処理
;
;特に条件がいらない奴隷を追加する場合は以下の手順で商品を追加できます
;
;・CSVに「フラグ,라그숍판매,1」と記述する
;・フラグ,EXTRA출전,X
;		EXTRAキャラは上記のようにEXTRA出典フラグを追加してください。Xはフィルター番号に相当します。個別のフィルターがない場合は「98」を指定してください。
;
;なんらかの購入条件を指定したい場合は上記の処置に加えてファイル内の条件部分を参考にして処理を追加してください
;--------------------------------------------------------------------------------------------
;文字列から必要な宝石の種類と数を変数にいれる
@SET_VAR_NEED_JUEL, ARGS, NEED_JUEL, NEED_JUEL_NUM
#DIM LCOUNT
#DIM REF NEED_JUEL
#DIM REF NEED_JUEL_NUM
VARSET NEED_JUEL, 9999
VARSET NEED_JUEL_NUM
FOR LCOUNT, 0, STRCOUNT(ARGS, "/") + 1
	NEED_JUEL:LCOUNT = GETNUM(ITEM, AUTO_SPLIT(AUTO_SPLIT(ARGS, "/", LCOUNT), "_", 0))
	NEED_JUEL_NUM:LCOUNT = MAX(TOINT(AUTO_SPLIT(AUTO_SPLIT(ARGS, "/", LCOUNT), "_", 1)), 1)
NEXT

;宝石のID順にソート
ARRAYMSORT NEED_JUEL, NEED_JUEL_NUM
FOR LCOUNT, 0, VARSIZE("NEED_JUEL")
	SIF NEED_JUEL:LCOUNT == 9999
		NEED_JUEL:LCOUNT = 0
NEXT

@RAG_DOREI
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC TEMP
#DIM DYNAMIC L_LINE
#DIM DYNAMIC SELECTNUM, 2
#DIM DYNAMIC SELECT_CHARA
#DIM DYNAMIC SALE_LIST, RAG_SALELIST_SIZE
#DIM DYNAMIC IS_BUY_ABLE, RAG_SALELIST_SIZE
#DIMS DYNAMIC DISABLE_BUY_TEXT, RAG_SALELIST_SIZE
#DIM DYNAMIC SALE_CHARA_NO
#DIM DYNAMIC SALE_MODE
#DIM DYNAMIC NEED_JUEL, 3
#DIM DYNAMIC NEED_JUEL_NUM, 3
#DIM DYNAMIC L_ST_PAGE
#DIM DYNAMIC L_SALE_PAGE, 2
#DIM DYNAMIC STOCK_REDRAW
#DIM CONST SHOW_LINE_NUM = 31
#DIM CONST COLUMNNUM_CHARA = 8
#DIM CONST ROWNUM_CHARA = 5
#DIMS CONST JUEL_TABLE_1 = "에메랄드", "아메지스트", "오팔", "가넷"
#DIMS CONST JUEL_TABLE_2 = "오닉스", "아쿠아마린", "터키석", "토파즈"
#DIMS CONST JUEL_TABLE_3 = "사파이어", "진주", "루비", "다이아몬드"

PRINTL 래그:
PRINTL 「그럼 뭐가 필요한지 골라 봐」
PRINTW
L_LINE = LINECOUNT
SELECTNUM = 0, 0
SALE_MODE = 0
L_SALE_PAGE = 0, 0
L_ST_PAGE = 3
STOCK_REDRAW = CURRENTREDRAW()
REDRAW 0
$START
CLEARLINE LINECOUNT - L_LINE
VARSET DISABLE_BUY_TEXT
CALL MAKE_SALELIST_RAG_DOREI, SALE_LIST, \@SALE_MODE == 0 ? 通常 # EXTRA\@
;販売条件をヒントで出すパターン
FOR LCOUNT, 0, VARSIZE("SALE_LIST")
	;キャラ固有の条件
	SELECTCASE SALE_LIST:LCOUNT
		CASE [[キャラ:치키_＃FE]]
			SIF ABL:MASTER:가창기능 < 8
				DISABLE_BUY_TEXT:LCOUNT =  필요・가창기능 8 이상
		CASE [[キャラ:질_LT]]
			SIF BASE:MASTER:LV < 50
				DISABLE_BUY_TEXT:LCOUNT = 필요・전투 Lv50 이상
		CASE [[キャラ:리스]], [[キャラ:안젤라]], [[キャラ:샤를로트]], [[キャラ:티파]]
			SIF FLAG:조직공헌도 < 1500000
				DISABLE_BUY_TEXT:LCOUNT = 필요・납금 150만 이상
	ENDSELECT
NEXT
VARSET IS_BUY_ABLE
;買えるキャラが居ない場合は選択キャラを0に
IF MAXARRAY(SALE_LIST) == 0
	SELECTNUM:SALE_MODE = -1
ELSE
	;条件未達キャラを後ろにまわすようにソート
	FOR LCOUNT, FINDELEMENT(SALE_LIST, 0) - 1, 0, -1
		SIF DISABLE_BUY_TEXT:LCOUNT != ""
			CONTINUE
		SIF DISABLE_BUY_TEXT:(LCOUNT - 1) == ""
			CONTINUE
		SWAP DISABLE_BUY_TEXT:LCOUNT, DISABLE_BUY_TEXT:(LCOUNT - 1)
		SWAP SALE_LIST:LCOUNT, SALE_LIST:(LCOUNT - 1)
		LCOUNT = FINDELEMENT(SALE_LIST, 0)
	NEXT
ENDIF

FOR LCOUNT, 0, VARSIZE("SALE_LIST")
	SALE_CHARA_NO = SALE_LIST:LCOUNT
	IF SALE_CHARA_NO
		IS_BUY_ABLE:LCOUNT = 1
		;設定がない場合はレア・アンコ・コモンのうちのいずれかをひとつづつ
		;乱数をNOで固定
		RANDOMIZE SALE_CHARA_NO
		VARI COUNT_NEED_JUEL = 3
		;非戦闘員はアンコモンの宝石ひとつが代金となる
		SIF CSVTALENT(SALE_CHARA_NO, GETNUM(TALENT, "비전투원"))
			COUNT_NEED_JUEL = 1
		;ホロウエージェントはアンコモンの宝石ひとつが代金となる
		SIF CSVTALENT(SALE_CHARA_NO, GETNUM(TALENT, "할로우에이전트"))
			COUNT_NEED_JUEL = 1
		SELECTCASE COUNT_NEED_JUEL
			CASE 3
				NEED_JUEL:0 = GETNUM(ITEM, JUEL_TABLE_1:(RAND:VARSIZE("JUEL_TABLE_1")))
				NEED_JUEL:1 = GETNUM(ITEM, JUEL_TABLE_2:(RAND:VARSIZE("JUEL_TABLE_2")))
				NEED_JUEL:2 = GETNUM(ITEM, JUEL_TABLE_3:(RAND:VARSIZE("JUEL_TABLE_3")))
			CASE 2
				NEED_JUEL:0 = GETNUM(ITEM, JUEL_TABLE_1:(RAND:VARSIZE("JUEL_TABLE_1")))
				NEED_JUEL:1 = GETNUM(ITEM, JUEL_TABLE_2:(RAND:VARSIZE("JUEL_TABLE_2")))
				NEED_JUEL:2 = 0
			CASE 1
				NEED_JUEL:0 = GETNUM(ITEM, JUEL_TABLE_1:(RAND:VARSIZE("JUEL_TABLE_2")))
				NEED_JUEL:1 = 0
				NEED_JUEL:2 = 0
		ENDSELECT
		VARSET NEED_JUEL_NUM, 1
		;乱数の固定を解除
		RANDOMIZE GETMILLISECOND()
		;選択中キャラの代金はここでとっておく
		IF SELECTNUM >= 0 && LCOUNT == SELECTNUM:SALE_MODE
			ARRAYCOPY "NEED_JUEL", "SELECT_NEED_JUEL"
			ARRAYCOPY "NEED_JUEL_NUM", "SELECT_NEED_JUEL_NUM"
		ENDIF
		IF DISABLE_BUY_TEXT:LCOUNT == ""
			FOR LCOUNT:1, 0, 3
				SIF NEED_JUEL:(LCOUNT:1) == 0
					CONTINUE
				SIF ITEM:(NEED_JUEL:(LCOUNT:1)) >= NEED_JUEL_NUM:(LCOUNT:1)
					CONTINUE
				IS_BUY_ABLE:LCOUNT = 0
			NEXT
		ELSE
			IS_BUY_ABLE:LCOUNT = 0
		ENDIF
	ENDIF
NEXT
;一時的にキャラを作ってステータスを表示する
IF SELECTNUM:SALE_MODE >= 0
	CALL ADD_NEW_COMPANION, SALE_LIST:(SELECTNUM:SALE_MODE), 0, , 1, , CSVCFLAG(SALE_LIST:(SELECTNUM:SALE_MODE), GETNUM(CFLAG, "라그숍레벨"))
	SELECT_CHARA = CHARANUM - 1
	U = SELECT_CHARA
	CUSTOMDRAWLINE =
	PRINTFORML %CALLNAME:U%　　
	CALLFORM SHOW_INFO_PAGE_{L_ST_PAGE}
	SIF L_ST_PAGE == 2
		CLEARLINE 1
	DELCHARA SELECT_CHARA
ELSE
	SELECT_CHARA = -1
ENDIF
WHILE LINECOUNT < L_LINE + SHOW_LINE_NUM
	PRINTL 
WEND
CUSTOMDRAWLINE =
PRINTBUTTON "[1001] 이전페이지", 1001
PRINTFORM %" " * 8%
PRINTBUTTON "[1002] 다음페이지", 1002
PRINTFORM %" " * 8%
PRINTBUTTON "[Shift + En] 이전 캐릭터", -2
PRINTFORM %" " * 8%
PRINTBUTTON "[Enter] 다음 캐릭터", -3
PRINTL 
CUSTOMDRAWLINE =
VARI L_COLUMN
VARI L_ROW
FOR L_COLUMN, 0, COLUMNNUM_CHARA
	FOR L_ROW, 0, ROWNUM_CHARA
		LCOUNT = L_SALE_PAGE:SALE_MODE * COLUMNNUM_CHARA * ROWNUM_CHARA
		LCOUNT += L_COLUMN * ROWNUM_CHARA + L_ROW
		SALE_CHARA_NO = SALE_LIST:LCOUNT
		IF SALE_CHARA_NO
			IF DISABLE_BUY_TEXT:LCOUNT == ""
				IF IS_BUY_ABLE:LCOUNT
					CALL PRINT_COLOR, @"[{LCOUNT + 1, 3}] %CSVCALLNAME(SALE_LIST:LCOUNT), 26, LEFT%", LCOUNT == SELECTNUM:SALE_MODE ? COLOR("パ緑") # COLOR("DEF")
				ELSE
					CALL PRINT_COLOR, @"[{LCOUNT + 1, 3}] %CSVCALLNAME(SALE_LIST:LCOUNT), 26, LEFT%", LCOUNT == SELECTNUM:SALE_MODE ? COLOR("パ緑") # COLOR("gray")
				ENDIF
			ELSE
				CALL PRINT_COLOR, @"%DISABLE_BUY_TEXT:LCOUNT, 32, LEFT%", COLOR("gray")
			ENDIF
		ENDIF
	NEXT
	PRINTL 
NEXT
CUSTOMDRAWLINE =
IF GET_USEABLE_EXTRA_TITLE()
	CALL PRINT_COLOR, "[1010] 통상　　　　　 ", SALE_MODE == 0 ? COLOR("パ緑") # COLOR("DEF")
	CALL PRINT_COLOR, "[1011] EXTRA　　　　　", SALE_MODE == 1 ? COLOR("パ緑") # COLOR("DEF")
	PRINTL 
ENDIF
FOR LCOUNT, 0, 12
	SIF VARSIZE("SALE_LIST") == LCOUNT * COLUMNNUM_CHARA * ROWNUM_CHARA
		BREAK
	SIF LCOUNT > 0 && SALE_LIST:(LCOUNT * COLUMNNUM_CHARA * ROWNUM_CHARA) == 0
		CONTINUE
	CALL PRINT_COLOR, @"[{1020 + LCOUNT}] Page.{LCOUNT+1,2}　　　　", L_SALE_PAGE:SALE_MODE == LCOUNT ? COLOR("パ緑") # COLOR("DEF")
	SIF LCOUNT % 6 == 5
		PRINTL 
NEXT
SIF !LINEISEMPTY()
	PRINTL 
CUSTOMDRAWLINE =
;DRAWLINE
;PRINTLC [1001] 이전페이지
;PRINTLC 　　　　　　　　 
;PRINTLC [1002] 다음페이지
;PRINTL 
SIF !IS_BUY_ABLE:(SELECTNUM:SALE_MODE)
	SETCOLOR COLOR("gray")
PRINTLC [   0] 購入　　　
RESETCOLOR
PRINTLC [ 999] 돌아간다　　　
PRINTLC [1000] 가게를 나간다　
PRINTL 

INPUT -1
SELECTCASE RESULT
	CASE -1, -2, -3
		IF SELECTNUM:0 != -1
			IF RESULT == -2 || (RESULT == -1 && GETKEY(0x10))
				DO 
					SELECTNUM:SALE_MODE -= 1
					SIF SELECTNUM:SALE_MODE < 0
						SELECTNUM:SALE_MODE = FINDELEMENT(SALE_LIST, 0) - 1
				LOOP DISABLE_BUY_TEXT:(SELECTNUM:SALE_MODE) != ""
			ELSE
				SELECTNUM:SALE_MODE += 1
				SIF SELECTNUM:SALE_MODE == VARSIZE("SALE_LIST")
					SELECTNUM:SALE_MODE = 0
				SIF SALE_LIST:(SELECTNUM:SALE_MODE) == 0
					SELECTNUM:SALE_MODE = 0
				SIF DISABLE_BUY_TEXT:(SELECTNUM:SALE_MODE) != ""
					SELECTNUM:SALE_MODE = 0
			ENDIF
			L_SALE_PAGE:SALE_MODE = SELECTNUM:SALE_MODE / (COLUMNNUM_CHARA * ROWNUM_CHARA)
		ENDIF
	CASE 0
		IF IS_BUY_ABLE:(SELECTNUM:SALE_MODE)
			PRINTL 래그:
			PRINTFORML 「%CSVCALLNAME(SALE_LIST:(SELECTNUM:SALE_MODE),0)%(와)과 교환이야. 괜찮아?」
			FOR LCOUNT, 0, 3
				SIF !SELECT_NEED_JUEL:LCOUNT
					CONTINUE
				PRINTFORML %ITEMNAME:(SELECT_NEED_JUEL:LCOUNT),18,LEFT%　所持数:{ITEM:(SELECT_NEED_JUEL:LCOUNT),2} → {(ITEM:(SELECT_NEED_JUEL:LCOUNT)-SELECT_NEED_JUEL_NUM:LCOUNT),2}
			NEXT
			CALL INPUT_YN("예", "아니오")
			SIF RESULT == 1
				RETURN 0
			CALL ADD_NEW_COMPANION_RAG, SALE_LIST:(SELECTNUM:SALE_MODE)
			REDRAW STOCK_REDRAW
			RETURN -1
		ENDIF
	CASE 999
		REDRAW STOCK_REDRAW
		RETURN -1
	CASE 1000
		REDRAW STOCK_REDRAW
		RETURN 0
	CASE 1001
		L_ST_PAGE = L_ST_PAGE == 1 ? 4 # L_ST_PAGE - 1
	CASE 1002
		L_ST_PAGE = L_ST_PAGE == 4 ? 1 # L_ST_PAGE + 1
	CASE 1010
		SALE_MODE = 0
	CASE 1011
		SIF GET_USEABLE_EXTRA_TITLE()
			SALE_MODE = 1
	CASE 1020 TO 1039
		SIF SALE_LIST:((RESULT - 1020) * 10) > 0
			L_SALE_PAGE:SALE_MODE = RESULT - 1020
	CASEELSE
		IF INRANGE(RESULT, 1, VARSIZE("SALE_LIST") + 1)
			SIF SALE_LIST:(RESULT - 1)
				SELECTNUM:SALE_MODE = RESULT - 1
		ENDIF
ENDSELECT
GOTO START

@MAKE_SALELIST_RAG_DOREI, SALE_LIST, SALE_MODE = "통상"
#DIM REF SALE_LIST
#DIMS DYNAMIC SALE_MODE
#DIM DYNAMIC SALE_LIST_EX, RAG_SALELIST_SIZE
#DIM DYNAMIC SALE_LIST_EX_KEY, RAG_SALELIST_SIZE
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC TEMP
VARSET SALE_LIST
FOR LCOUNT, 1, CSVCHARANUM
	SIF !EXISTCSV(LCOUNT)
		CONTINUE
	SIF !CSVCFLAG(LCOUNT, GETNUM(CFLAG, "라그숍판매"))
		CONTINUE
	IF !CSVCFLAG(LCOUNT, GETNUM(CFLAG, "라그숍재고무제한"))
		;すでに販売したキャラは省く
		SIF RAG_SHOP_CHARA_SOLD:LCOUNT
			CONTINUE
	ENDIF
	SIF !CAN_ADD_NEW_COMPANION(LCOUNT)
		CONTINUE
	IF CSVCFLAG(LCOUNT, GETNUM(CFLAG, "라그숍레벨")) > 0
		SIF MAX(BASE:MASTER:LV, 5) < CSVCFLAG(LCOUNT, GETNUM(CFLAG, "라그숍레벨"))
			CONTINUE
	ELSE
		SIF MAX(BASE:MASTER:LV, 5) < CSVBASE(LCOUNT, GETNUM(BASE, "LV"))
			CONTINUE
	ENDIF
	;通常モード
	IF SALE_MODE == "통상"
		SIF CSVCFLAG(LCOUNT, GETNUM(CFLAG, "EXTRA출전")) > 0
			CONTINUE
	;EXTRA表示
	ELSE
		IF SALE_MODE == "EXTRA"
			;0以下は非EXキャラ
			SIF CSVCFLAG(LCOUNT, GETNUM(CFLAG, "EXTRA출전")) <= 0
				CONTINUE
		ENDIF
		SIF !GET_USEABLE_EXTRA_TITLE(CSVCFLAG(LCOUNT,(GETNUM(CFLAG,"EXTRA출전"))))
			CONTINUE
	ENDIF
	IF SALE_MODE == "SALE_EVENT"
		SIF !INRANGE(CSVCFLAG(LCOUNT,(GETNUM(CFLAG,"캐릭터구현일"))), SHOP_EV_2_TAKE_DAY_START(), SHOP_EV_2_TAKE_DAY_END())
			CONTINUE
	ENDIF
	;キャラ固有の条件
	SELECTCASE LCOUNT
		CASE [[キャラ:한나_DR]], [[キャラ:영구인형_DR]]
			SIF !GETBIT(FLAG:발견ED2, 14)
				CONTINUE
		CASE [[キャラ:렌코]], [[キャラ:메리_환상향]], [[キャラ:아큐]]
			SIF !HAVE_INSTALLSOFT("동방구문사기")
				CONTINUE
		CASE [[キャラ:루코토]]
			SIF !HAVE_INSTALLSOFT("요악단의역사")
				CONTINUE
	ENDSELECT
	IF SALE_MODE != "EXTRA"
		SELECTCASE LCOUNT	
			CASE [[キャラ:치키_＃FE]]
				SIF ABL:MASTER:가창기능 < 8
					CONTINUE
			CASE [[キャラ:질_LT]]
				SIF BASE:MASTER:LV < 50
					CONTINUE
			CASE [[キャラ:리스]], [[キャラ:안젤라]], [[キャラ:샤를로트]], [[キャラ:티파]]
				SIF FLAG:조직공헌도 < 1500000
					CONTINUE
		ENDSELECT
	ENDIF
	TEMP = FINDELEMENT(SALE_LIST, 0)
	SELECTCASE CSVCFLAG(LCOUNT, GETNUM(CFLAG, "EXTRA출전"))
		CASE -1, -2
			SALE_LIST:TEMP = LCOUNT
		CASE 97
			SALE_LIST:TEMP = LCOUNT + 100 * 1000000
		;その他作品は別テーブルに入れてタイトル名でソートをかける
		CASE 98
			TEMP = FINDELEMENT(SALE_LIST_EX, 0)
			;KEYはタイトルの頭3文字をUNICODEに変換して取る
			SALE_LIST_EX_KEY:TEMP = ENCODETOUNI(CSVCSTR(LCOUNT, GETNUM(CSTR, "등장작품타이틀")), 0) * 2P32 + ENCODETOUNI(CSVCSTR(LCOUNT, GETNUM(CSTR, "등장작품타이틀")), 1) * 2P16 + ENCODETOUNI(CSVCSTR(LCOUNT, GETNUM(CSTR, "등장작품타이틀")), 2)
			SALE_LIST_EX:TEMP = LCOUNT
		CASEELSE
			SALE_LIST:TEMP = LCOUNT + CSVCFLAG(LCOUNT, GETNUM(CFLAG, "EXTRA출전")) * 1000000
	ENDSELECT
NEXT
ARRAYSORT SALE_LIST, FORWARD, 0, FINDELEMENT(SALE_LIST, 0)
FOR LCOUNT, 0, VARSIZE("SALE_LIST")
	SALE_LIST:LCOUNT %= 1000000
NEXT
ARRAYMSORT SALE_LIST_EX_KEY, SALE_LIST_EX
TEMP = FINDELEMENT(SALE_LIST, 0)
FOR LCOUNT, 0, FINDELEMENT(SALE_LIST_EX, 0)
	SALE_LIST:(TEMP + LCOUNT) = SALE_LIST_EX:LCOUNT
NEXT
@RAG_SPECIAL_TICKET_INV
#DIM DYNAMIC SALE_LIST, RAG_SALELIST_SIZE
#DIM DYNAMIC CHARA_LIST, 3, 100
#DIMS DYNAMIC SHOW_LINE
#DIM DYNAMIC LCOUNT, 5
#DIM DYNAMIC L_CHARA_NO, 3
#DIM DYNAMIC LISTNO
#DIM DYNAMIC L_LINE
#DIM DYNAMIC L_HEIGHT
#DIM DYNAMIC L_CNT, 3
#DIM DYNAMIC L_ST_PAGE = 3
#DIM DYNAMIC STOCK_REDRAW
IF MAX_PLAYER_CHARA - CHARANUM < 3
	PRINTL 래그:
	PRINTL 「노예를 줘도 둘 장소가 없는 모양이네.
	PRINTW  제대로 준비하고 다시 와 줘」
	RETURN 0
ENDIF

CALL MAKE_SALELIST_RAG_DOREI, SALE_LIST, "INV"
IF FINDELEMENT(SALE_LIST, 0) < 15
	PRINTL 래그:
	PRINTL 「지금은 상품이 적어서 티켓을 쓸 수 없어.
	PRINTW  또 상품이 늘어나면 와 줘」
	RETURN 0
ENDIF

PRINTL 래그:
PRINTL 「지금 주력 사업은 이 노예 판매야.
PRINTW  원래라면 보석을 받겠지만, 이번엔 공짜로 3명 줄게」
PRINTL 
PRINTL 래그:
PRINTL 「다만, 누굴 받을지는 랜덤이야.
PRINTW  확실히 원하는 아이가 있다면 보석을 가져와 줘」
PRINTL 
PRINTL 래그:
PRINTW 「그럼, 누구를 데려갈지 정해 봐」
FOR LCOUNT, 0, 10
	PRINTL 
NEXT
STOCK_REDRAW = CURRENTREDRAW()
REDRAW 0
L_LINE = LINECOUNT
WHILE 1
	CALL SHUFFLE_ARRAY_INT, SALE_LIST, 0, FINDELEMENT(SALE_LIST, 0) -1
	FOR LCOUNT, 0, FINDELEMENT(SALE_LIST, 0)
		CHARA_LIST:(LCOUNT % 3):(LCOUNT / 3) = SALE_LIST:LCOUNT
	NEXT
	VARSET LCOUNT
	VARI IS_RETURNED
	$RETURNED
	DO 
		IF !IS_RETURNED
			SIF CHARA_LIST:0:(++LCOUNT) == 0
				LCOUNT = 0
			SIF CHARA_LIST:1:(++LCOUNT:1) == 0
				LCOUNT:1 = 0
			SIF CHARA_LIST:2:(++LCOUNT:2) == 0
				LCOUNT:2 = 0
		ENDIF
		CLEARLINE LINECOUNT - L_LINE
		DRAWLINE
		PRINTL 　입수 캐릭터 추첨
		DRAWLINE
		L_HEIGHT = 800
		VARS L_BORDER_COLOR
		FOR LISTNO, 0, 3
			L_CHARA_NO:LISTNO = CHARA_LIST:LISTNO:(LCOUNT:LISTNO)
			CALL MAKE_RAG_DOREI_BUNNER, CHARA_LIST:LISTNO:(LCOUNT:LISTNO), LISTNO, L_HEIGHT
			HTML_PRINT "<div xpos = '100' ypos = '0'>" + SET_BUTTON_TAG(RESULTS, TOFULL(TOSTR(LISTNO + 1))) + "</div>"
			FOR LCOUNT:3, 0, 8
				PRINTFORML 
			NEXT
		NEXT
		CUSTOMDRAWLINE =
		HTML_PRINT SET_BUTTON_TAG("[SPACE / 우클릭] 새로고침", "SPACE")
		HTML_PRINT SET_BUTTON_TAG("[0] 결정", TOFULL("0"))
		IF IS_RETURNED
			RESULT = 0
		ELSE
			INPUTMOUSEKEY 20
		ENDIF
	LOOP RESULT == 4
	IS_RETURNED = 0
	VARI LINE_SELECT = LINECOUNT
	DO
		DO
			CLEARLINE LINECOUNT - LINE_SELECT
			INPUTMOUSEKEY
			;マウスクリック
			IF RESULT:0 == 1
				;左クリック
				IF RESULT:1 == 0x100000
					RESULTS '= TOHALF(RESULTS:5)
				;右クリック
				ELSE
					RESULTS '= "SPACE"
				ENDIF
			ELSE
				RESULTS '= CONVERT_KEYCORD_TO_STR(RESULT:1)
			ENDIF
		LOOP RESULTS == ""
		SELECTCASE RESULTS
			CASE "1", "2", "3"
				RESULT = TOINT(RESULTS) - 1
				CALL ADD_NEW_COMPANION,  CHARA_LIST:RESULT:(LCOUNT:RESULT), 0, , 1
				VARI SELECT_CHARA = CHARANUM - 1
				U = SELECT_CHARA
				VARI LINE_CHARA = LINECOUNT
				WHILE 1
					CLEARLINE LINECOUNT - LINE_CHARA
					CUSTOMDRAWLINE =
					PRINTFORML %CALLNAME:U%
