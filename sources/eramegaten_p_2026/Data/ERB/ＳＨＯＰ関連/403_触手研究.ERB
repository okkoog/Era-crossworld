	S = (CSVBASE((NO:LOCAL),GETNUM(BASE,"LV"),0) < 13 ? 100 # 0 ) + CSVBASE((NO:LOCAL),GETNUM(BASE,"LV"),0) * (5+MAX(5,CSVBASE((NO:LOCAL),GETNUM(BASE,"LV"),0)/2)) * 5
