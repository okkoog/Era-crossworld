@SHOPCOMABLE_403
SIF !IS_USEABLE_SHOPCOM
	RETURN 0
SIF !FLAG:촉수신사각성
	RETURN 0
RESULT:1 = 4
IF (FLAG:촉수에너지 > 0 || FLAG:촉수레벨 > 0)
	RESULTS = 촉수연구
	RETURN 1
ELSE
	RESULTS = ？？？？
	RETURN 0
ENDIF

@SHOP_COM_403, ARG
DRAWLINE
PRINTFORML 현재 촉수 레벨 LV{FLAG:촉수레벨}　에너지 {FLAG:촉수에너지}F입니다
DRAWLINE

$PRINT_LABO
PRINTL 무엇을 하겠습니까?
IF FLAG:촉수레벨 > 0
	PRINTL [0] 触手強化
ELSE
	PRINTL [0] 強化触手作成
ENDIF
;SIF FLAG:촉수레벨 > 0
;	PRINTL [1] ＭＡＧ譲渡
SIF CHARANUM > 1
	PRINTL [99] 触手生贄
PRINTL [100]그만둔다
$INPUT_LOOP
INPUT
IF RESULT == 0
	CALL TENTACLE_LABORATORY_LVUP
;ELSEIF RESULT == 1 && FLAG:촉수레벨 > 0
;	CALL TENTACLE_LABORATORY_MAG
ELSEIF RESULT == 99 && CHARANUM > 1
	CALL TENTACLE_LABORATORY_SACRIFICE
ELSEIF RESULT == 100
	RETURN 0
ELSE
	GOTO INPUT_LOOP
ENDIF

@TENTACLE_LABORATORY_LVUP
LOCAL:0 = FLAG:촉수레벨

PRINTFORML 현재 촉수 레벨:{FLAG:촉수레벨}　현재 촉수 에너지:{FLAG:촉수에너지}F

SIF FLAG:촉수에너지 < 20*(FLAG:촉수레벨+2)*(FLAG:촉수레벨+3)
	SETCOLOR 0x404040
PRINTFORML   [ 1] +1 / {20*(FLAG:촉수레벨+2)*(FLAG:촉수레벨+3),7,RIGHT}

LOCAL:1 = 0
LOCAL:2 = 0
FOR LOCAL:5,0,2
	FOR LOCAL:6,0,5
		LOCAL:2 += 20*(FLAG:촉수레벨+2)*(FLAG:촉수레벨+3)
		LOCAL:0 += 100
	NEXT
	SIF LOCAL:1
		BREAK
	LOCAL:1 += LOCAL:2
NEXT

SIF FLAG:촉수에너지 < LOCAL:1
	SETCOLOR 0x404040
PRINTFORML   [ 2] +5 / {LOCAL:1,7,RIGHT}

SIF FLAG:촉수에너지 < LOCAL:2
	SETCOLOR 0x404040
PRINTFORML   [ 3]+10 / {LOCAL:2,7,RIGHT}
RESETCOLOR
PRINTL [0]돌아간다
$INPUT_LOOP_T
INPUT
VARI TEMP_LV = FLAG:촉수레벨
IF RESULT == 0
	RETURN 0
ELSEIF RESULT == 1
	IF FLAG:촉수에너지 < 20*(FLAG:촉수레벨+2)*(FLAG:촉수레벨+3)
		PRINTW 촉수 에너지가 부족합니다
		GOTO INPUT_LOOP_T
	ENDIF
	FLAG:촉수에너지,-= 20*(FLAG:촉수레벨+2)*(FLAG:촉수레벨+3)
	FLAG:촉수레벨 += 1
ELSEIF RESULT == 2
	IF FLAG:촉수에너지 < LOCAL:1
		PRINTW 촉수 에너지가 부족합니다
		GOTO INPUT_LOOP_T
	ENDIF
	FLAG:촉수에너지 -= LOCAL:1
	FLAG:촉수레벨 += 5
ELSEIF RESULT == 3
	IF FLAG:촉수에너지 < LOCAL:2
		PRINTW 촉수 에너지가 부족합니다
		GOTO INPUT_LOOP_T
	ENDIF
	FLAG:촉수에너지 -= LOCAL:2
	FLAG:촉수레벨 += 10
ELSE
	GOTO INPUT_LOOP_T
ENDIF
PRINTFORMW 현재 촉수 레벨이 {FLAG:촉수레벨}(이)가 되었습니다
;初回は説明文を出す
IF TEMP_LV == 0
	PRINTFORMW 동료마 강화에서 촉수 에너지를 주입하여, MAG를 취득시킬 수 있게 되었습니다.
	PRINTFORMW 앞으로 촉수 레벨을 상승시킴으로써 촉수 에너지의 MAG 변환 효율을 향상시킬 수 있습니다.
ENDIF
RESTART

@TENTACLE_LABORATORY_MAG, L_CHARA
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_LINE
CALL MAG_ENHANCE_INFO_CHARA, L_CHARA
PRINTFORML 얼마나 에너지를 주겠습니까?　＜에너지 {FLAG:촉수에너지}F　촉수 레벨 보정 {TENTACLE_LABORATORY_MAG_RATE()}배＞
L_LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - L_LINE
CALL PRINT_SPACE_ENHANCE
PRINTL 
CALL INPUT_MANY, 0, MIN((GET_CHARA_MAXMAG(L_CHARA) - GET_CHARA_STOCK_MAG(L_CHARA)) / TENTACLE_LABORATORY_MAG_RATE(), FLAG:촉수에너지), , , "TENTACLE_MAG_INPUT_SIDE", , , (L_LINE - LINECOUNT) * 100
VARI AMOUNT_ENERGY
AMOUNT_ENERGY = RESULT
VARI AMOUNT_MAG
AMOUNT_MAG = AMOUNT_ENERGY * TENTACLE_LABORATORY_MAG_RATE()
IF RESULT > 0
	CALL INPUT_YN_POPUP, , , @"에너지 {AMOUNT_ENERGY}F (MAG {AMOUNT_MAG})을(를) %CALLNAME:L_CHARA%에게 주겠습니까?"
	IF RESULT == 0
		FLAG:촉수에너지 -= AMOUNT_ENERGY
		CALL CONTROL_MAG, L_CHARA, AMOUNT_MAG
		CALL MESSAGE_POPUP, @"%CALLNAME:L_CHARA%은(는) {AMOUNT_MAG}의 MAG를 얻었다."
	ELSE
		GOTO START
	ENDIF
ENDIF
RETURN 1

@TENTACLE_LABORATORY_MAG_RATE
#FUNCTION
RETURNF MIN(10, (FLAG:촉수레벨 +50) / 50)

@TENTACLE_MAG_INPUT_SIDE, INPUT_NUM, L_PRICE
#DIM DYNAMIC INPUT_NUM
#DIM DYNAMIC L_PRICE
#DIM DYNAMIC L_MAG_SPACE
#DIM DYNAMIC NEED_EN
#DIMS DYNAMIC TEMPS
L_MAG_SPACE = MAXBASE:U:ＭＡＧ - BASE:U:ＭＡＧ
NEED_EN = L_MAG_SPACE / TENTACLE_LABORATORY_MAG_RATE()
TEMPS '= SET_BUTTON_TAG(@"[100％補充] {NEED_EN}F > {L_MAG_SPACE}MAG", TOSTR(NEED_EN))
SIF FLAG:촉수에너지 < NEED_EN
	TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
RESULTS += TEMPS
L_MAG_SPACE = (MAXBASE:U:ＭＡＧ / 2) - BASE:U:ＭＡＧ
NEED_EN = L_MAG_SPACE / TENTACLE_LABORATORY_MAG_RATE()
IF NEED_EN > 0
	TEMPS '= "<br>" + SET_BUTTON_TAG(@"[50％補充 ] {NEED_EN}F > {NEED_EN * TENTACLE_LABORATORY_MAG_RATE()}MAG", TOSTR(NEED_EN))
	SIF FLAG:촉수에너지 < NEED_EN
		TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
	RESULTS += TEMPS
ENDIF
L_MAG_SPACE = (MAXBASE:U:ＭＡＧ / 4) - BASE:U:ＭＡＧ
NEED_EN = L_MAG_SPACE / TENTACLE_LABORATORY_MAG_RATE()
IF NEED_EN > 0
	TEMPS '= "<br>" + SET_BUTTON_TAG(@"[25％補充 ] {NEED_EN}F > {NEED_EN * TENTACLE_LABORATORY_MAG_RATE()}MAG", TOSTR(NEED_EN))
	SIF FLAG:촉수에너지 < NEED_EN
		TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
	RESULTS += TEMPS
ENDIF

