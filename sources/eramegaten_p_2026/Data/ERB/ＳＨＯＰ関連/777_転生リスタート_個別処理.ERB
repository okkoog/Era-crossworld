;=================================================================
;指定キャラのステータスを主に引き継ぎ用に初期化する
;;引き継いだキャラのレベルを人間なら5、悪魔なら1にして能力をＣＳＶから読み込んでからレベルに合わせて増減、習得スキルをＣＳＶから再読み込み。引継ぎフラグに応じて素質や能力変更
;ARG:0 キャラの登録番号
;RESULT 真:成功 偽:失敗
;=================================================================
;2021/04/10	NEO			受胎アイテム取得状況をリセットできるよう変更
;2021/04/26 軽木		「周回で喰奴を引き継いだ場合、無条件で習得状況が引き継がれる」ように
;2021/09/05 JK好き		引き継いだキャラの体力回復・ストレス回復・気絶解除処理を追加
;2022/01/03 JK好き		引き継いだキャラの専用技の覚えなおし処理を追加
;2022/05/26 Collared	陥落合体の処理追加
;2022/03/02 しゃけ		アーミヤの引継ぎ処理を追加、スルトの引継ぎ処理に誤りがあったのを修正
;2022/09/01 JK好き		引き継いだキャラのヤリチンリセット処理を追加
;2023/05/26 P			未調教陥落と陥落人数加算済みフラグのリセット処理を追加
;2024/02/23 P			引継ぎの際にリンク悪魔解除に対する一部の処理が正しく実行されていなかった不具合を修正
;2024/04/07 P			引き継ぎキャラの装備のセットを関数化	
;2024/11/04 テツ		引き継ぎ時の能力計算を調整
;=================================================================
@SHOP_NEWGAME_INITCHARA, ARG
#DIM LCOUNT
#DIM DYNAMIC STATUS_CHECK, 7
#DIM DYNAMIC STATUS_BASE, 7
LOCAL = ARG
;体力回復
BASE:LOCAL:체력 = MAXBASE:LOCAL:체력
CFLAG:LOCAL:체력회복정지플래그 = 0
CFLAG:LOCAL:스트레스치 = 0

IF TALENT:LOCAL:비전투원
	;非戦闘員はステータスの初期化だけを行う
	BASE:LOCAL:LV = 1
	FOR LCOUNT,1,7
		;非戦闘員の各能力値は0
		BASE:LOCAL:GET_BASESTATUS(LCOUNT) = 0
		CFLAG:LOCAL:("향사용횟수_" + GET_BASESTATUS(LCOUNT)) = 0
	NEXT
ELSE
	;LVを先に初期化。人間はLv5、他はLv1
	IF ABL:LOCAL:종족 == 0
		BASE:LOCAL:LV = 5
	ELSE
		BASE:LOCAL:LV = 1
	ENDIF
	;元が非戦闘員またはランダムキャラならキャラのベースステータスを基準値に
	IF CSVTALENT(NO:LOCAL,GETNUM(TALENT,"비전투원"),0) == 1 || IS_RANDOMCHARA(LOCAL)
		FOR LCOUNT,0,7
			STATUS_BASE:LCOUNT = BASE:LOCAL:GET_BASESTATUS(LCOUNT)
		NEXT
		;能力値の上昇量を計算、各能力1は最低保証するためその分の6を引く
		LOCAL:1 = 18 + (BASE:LOCAL:LV * 3 / 2) - 6
	;元が非戦闘員またはランダムキャラ以外ならCSVのステータスを基準値に
	ELSE
		FOR LCOUNT,0,7
			STATUS_BASE:LCOUNT = CSVBASE(NO:LOCAL,GETNUM(BASE,GET_BASESTATUS(LCOUNT)),0)
		NEXT
		;能力値の上昇量を計算、各能力1は最低保証するためその分の6を引く
		LOCAL:1 = SUMARRAY(STATUS_BASE, 1, 7) - (STATUS_BASE:0 * 3 / 2) + (BASE:LOCAL:LV * 3 / 2) - 6
	ENDIF
	FOR LCOUNT,1,7
		;ステータスを初期化
		BASE:LOCAL:GET_BASESTATUS(LCOUNT) = 1
		CFLAG:LOCAL:("향사용횟수_" + GET_BASESTATUS(LCOUNT)) = 0
		;基準値から優先度を算出
		STATUS_CHECK:LCOUNT = STATUS_BASE:LCOUNT * 100
	NEXT
	FOR LCOUNT, 0, LOCAL:1
		;最も優先度が高い能力を上昇させる
		LOCAL:2 = FINDELEMENT(STATUS_CHECK, MAXARRAY(STATUS_CHECK, 1, 7), 1, 7)
		BASE:LOCAL:GET_BASESTATUS(LOCAL:2) += 1
		;上昇した能力の優先度を再計算
		STATUS_CHECK:(LOCAL:2) = STATUS_BASE:(LOCAL:2) * 100 / BASE:LOCAL:GET_BASESTATUS(LOCAL:2)
	NEXT
ENDIF

BASE:LOCAL:ＥＸＰ = 5*(BASE:LOCAL:LV-1)*(BASE:LOCAL:LV+1)*(BASE:LOCAL:LV)/3
BASE:LOCAL:ＭＡＧ = 0
CFLAG:LOCAL:초기LV = BASE:LOCAL:LV
;CFLAG:LOCAL:초기LV = 1

	;敵専用スキルを削除
FOR LOCAL:3,1,FLAG:이능자스킬수+1
