@GET_称号名_NUM, ARGS
#FUNCTION
#DIM DYNAMIC LCOUNT
IF 称号名:0 == ""
	FOR LCOUNT, 0, 称号数
		称号名:LCOUNT '= GET_称号名(LCOUNT)
	NEXT
ENDIF
RETURNF FINDELEMENT(称号名, ARGS, 0, 称号数, 1)