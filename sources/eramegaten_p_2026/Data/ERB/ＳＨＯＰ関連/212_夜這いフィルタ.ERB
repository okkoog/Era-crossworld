;夜這い可能なキャラを管理する

@SHOPCOMABLE_212
SIF !IS_USEABLE_SHOPCOM
	RETURN 0
RESULT:1 = 2
RESULTS = 요바이필터
;一応、マスターしかいないときは除外
SIF CHARANUM < 2
	RETURN 0
RETURN 1

@SHOP_COM_212, ARG
;#LOCALSIZE 1
#DIM DYNAMIC L_LINE
REDRAW 0
L_LINE = LINECOUNT
;CALL INPUT_CHARA_LIST("夜這い設定を変更するキャラを選んでください", "CASTING_SELF", "", "", "GENDERCONTROL_SELF_SELECT")
{
CALL INPUT_CHARA_LIST
	, "CASTING_SELF_調教/育成情報/"
	, "요바이설정을 바꿀 캐릭터를 선택해주세요"
	, "CASTING_SELF" 
	, "SHOW_ADD_UP_FUNCTION"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "GENDERCONTROL_SELF_SELECT"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "YOBAI_CUSTOM_COLOR"
	, -1
}
IF RESULT == 1000
	REDRAW 1
	;VARSET LOCAL
	RETURN 0
ELSEIF RESULT <= CHARANUM
	INVERTBIT CFLAG:RESULT:요바이불허가 , 0
	;CLEARLINE 1
ENDIF
CLEARLINE LINECOUNT - L_LINE
;CLEARLINE 1 + 3 + 2 + ( (P+1*20) <= A ? 20 # A - P*20 )
RESTART

;================================================================
;夜這い制限可能なキャラの条件
;================================================================
@CASTING_SELF(ARG)
;主人公は除外
SIF ARG == MASTER
	RETURN 0
;いないキャラを除外
SIF CFLAG:ARG:이자리에없는플래그 == 1
	RETURN 0
SIF CFLAG:ARG:전투이외불능
	RETURN 0
RETURN 1

@YOBAI_CUSTOM_COLOR, ARG, ARGS
SIF CFLAG:ARG:요바이불허가
	RETURN COLOR("dark-gray")
RETURN GETDEFCOLOR()

@CASTING_SELF_調教
RESULTS '= "NO_NAME_LV_ALI_SEX_POS_体力_気力_STRESS_LOYALTY_FALLTALENT_WORK_CONDITION_KOJO_夜這い許可"

@SET_VAR_INFO_DATA_夜這い許可_HEADER
INFO_HEADER += SET_BUTTON_TAG("요바이허가", "SORT,요바이허가")

@GET_VAR_INFO_DATA_夜這い許可, ARG
IF CFLAG:ARG:요바이불허가
	RESULTS '= TOALIGNMENT("[×]", 10, "CENTER")
ELSE
	RESULTS '= TOALIGNMENT("[○]", 10, "CENTER")
ENDIF

@GET_INFO_SORT_KEY_夜這い許可, ARG, ARGS
RETURN !CFLAG:ARG:요바이불허가

;================================================================
;性別毎に一括変更出来るボタン;INPUT_CHARA_LISTの都合で1500～1600番にしないと上手くいかない
;================================================================
@GENDERCONTROL_SELF_SELECT, ARG
SELECTCASE ARG
	CASE -1
		PRINTL
		PRINT [1500]모든동료마　ON/OFF
		PRINT 　[1501]순수여성　ON/OFF　
		PRINT 　[1502]순수남성　ON/OFF　
		PRINT 　[1503]후타나리　ON/OFF　
		PRINT 　[1504]오토코노코　ON/OFF
		PRINTL
	CASE 1500 TO 1504
		CALL COLLECT_SELF_SELECT(RESULT - 1500)
		RETURN ARG, -1
ENDSELECT
RETURN ARG , 1

;================================================================
;性別毎に一括変更実行部分
;================================================================
@COLLECT_SELF_SELECT, ARG
#DIM LCOUNT
#LOCALSIZE 1
FOR LCOUNT, 1, CHARANUM
	IF ARG == 0
		IF GETBIT(LOCAL, ARG)
			CLEARBIT CFLAG:LCOUNT:요바이불허가 , 0
		ELSE
			SETBIT CFLAG:LCOUNT:요바이불허가 , 0
		ENDIF
	ELSEIF ARG == 1 && TALENT:LCOUNT:남자 == 0 && TALENT:LCOUNT:후타나리 == 0
		INVERTBIT CFLAG:LCOUNT:요바이불허가 , 0
;		IF GETBIT(LOCAL, ARG)
;			CLEARBIT CFLAG:LCOUNT:요바이불허가 , 0
;		ELSE
;			SETBIT CFLAG:LCOUNT:요바이불허가 , 0
;		ENDIF
	ELSEIF ARG == 2 && TALENT:LCOUNT:남자 == 1 && TALENT:LCOUNT:오토코노코 == 0
		INVERTBIT CFLAG:LCOUNT:요바이불허가 , 0
	ELSEIF ARG == 3 && TALENT:LCOUNT:후타나리 == 1
		INVERTBIT CFLAG:LCOUNT:요바이불허가 , 0
	ELSEIF ARG == 4 && TALENT:LCOUNT:남자 == 1 && TALENT:LCOUNT:오토코노코 == 1
		INVERTBIT CFLAG:LCOUNT:요바이불허가 , 0
	ENDIF
NEXT
INVERTBIT LOCAL , ARG
CLEARLINE 1
