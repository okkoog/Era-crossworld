;====================================================
;머리색 CFLAG:35に指定
;====================================================
@NAME_CHANGE_머리색, ARG
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC INPUT_ABLE, 100
#DIMS CONST COLOR_TABLE = "미설정", "흑색", "갈색", "금색", "은색", "적색", "청색", "녹색", "핑크", "보라색", "백색", "밤색", "연보라", "자주색", "플래티넘", "애쉬브라운", "오렌지"
#DIM CSV髪の色
IF GROUPMATCH(CSTR:ARG:체형, "", "미설정", "스킨헤드")
	PRINTW 먼저 헤어스타일을 변경해 주십시오
	RESULTS = 미설정
ELSE
	IF CSTR:ARG:머리색 == ""
		PRINTFORM %NAME:ARG%의 머리색은 미설정 상태입니다
	ELSE
		PRINTFORM %NAME:ARG%의 머리색은 「%CSTR:ARG:머리색%」(으)로 설정되어 있습니다
	ENDIF
	PRINTFORML 새로운 머리색을 정해 주십시오
	FOR LCOUNT, 0, VARSIZE("COLOR_TABLE")
		SIF COLOR_TABLE:LCOUNT == ""
			CONTINUE
		PRINTFORML [{LCOUNT, 2}] %COLOR_TABLE:LCOUNT%
		INPUT_ABLE:LCOUNT = 1
	NEXT
	IF CSVCSTR(NO:ARG, GETNUM(CSTR, "머리색")) != ""
		INPUT_ABLE:80 = 1
		PRINTFORML [80] %CSVCSTR(NO:ARG, GETNUM(CSTR, "머리색"))%(초기 머리색)
	ENDIF
	INPUT_ABLE:90 = 1
	PRINTFORML [90] 원하는 머리색을 입력한다
	INPUT_ABLE:99 = 1
	PRINTFORML [99] 변경하지 않는다
	CALL INPUT_ARRAY, INPUT_ABLE
	SELECTCASE RESULT
		CASE 0
			CSTR:ARG:머리색 '= ""
			RESULTS = 미설정
		CASE IS < 20
			CSTR:ARG:머리색 '= COLOR_TABLE:RESULT
			RESULTS '= COLOR_TABLE:RESULT
		CASE 80
			RESULTS '= CSVCSTR(NO:ARG, GETNUM(CSTR, "머리색"))
			CSTR:ARG:머리색 '= RESULTS
		CASE 90
			PRINTFORML 원하는 머리색을 입력해 주십시오
			INPUTS
			IF RESULTS == "미설정" || RESULTS == ""
				CSTR:ARG:머리색 '= ""
				RESULTS = 미설정
			ELSE
				CSTR:ARG:머리색 '= RESULTS
			ENDIF
		CASE 99
			RESULTS '= "설정 안 함"
	ENDSELECT
ENDIF

