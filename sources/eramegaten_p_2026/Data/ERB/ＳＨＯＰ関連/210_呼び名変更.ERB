	;念のため
	;==============
	;ARGは念のため真っ先に保存しておく
	;ARGがゼロで入ってきたら、RESULTSに文字列を入れない（単なる実績システムとして使用できる）
	IS_INTO_RESULTS = ARG
	;ARG:1がゼロで入ってきたら、お知らせを表示しない（こっそり解放もできる）
	IS_NOTICE = ARG:1
	;ARG:2が１で入ってきたら、既に取得した称号の「～～の称号を取得しました」を強制的に再表示
	IS_RE_DISPLAY = ARG:2

