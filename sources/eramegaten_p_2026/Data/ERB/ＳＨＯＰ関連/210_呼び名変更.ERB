#DIM PAGENUM
#DIM NAMENUM_START
#DIM NAMENUM_END

	;ちょっと行を分ける
	CUSTOMDRAWLINE =

	;称号の初期値は「????」
	VARSET RESULTS,"????"

	;称号のチェック
	;RESULTSに突っ込む＆お知らせ表示モード
	CALL GLOBAL_NICKNAME_CHECK, 1, 1

	;デフォでは称号１のリストを表示な
