;====================================================
;スリーサイズ BASE:25～27に設定
;160センチで以下の範囲
;B:71-120
;W:48-93
;H:72-100
;====================================================
@NAME_CHANGE_스리사이즈, ARG
#DIM CSVバスト
#DIM CSVウエスト
#DIM CSVヒップ
CSVBASE NO:ARG, 25
CSVバスト = RESULT
CSVBASE NO:ARG, 26
CSVウエスト = RESULT
CSVBASE NO:ARG, 27
CSVヒップ = RESULT

IF TALENT:ARG:남자 && !TALENT:ARG:오토코노코
	PRINTL ？？「…가자, 곧 여기도 부해에 가라앉는다」
	RESULTS = 설정 안 함
ELSEIF BASE:ARG:신장 == 0
	PRINTW 먼저 신장을 정해 주십시오
	RESULTS = 설정 안 함
ELSE
	PRINTFORML [0] 전부 직접 입력한다
	PRINTFORML [1] 전부 자동 설정한다
	PRINTFORML [9] 돌아간다
	INPUT
	IF RESULT == 9
		;
	ELSEIF RESULT == 1
		CALL SET_INFO_BODYSIZE, ARG, ""
	ELSE
		IF BASE:ARG:바스트 == 0 || BASE:ARG:웨스트 == 0 || BASE:ARG:힙사이즈 == 0
			PRINTFORML %NAME:ARG%의 쓰리사이즈를 설정합니다
		ELSE
			PRINTFORML %NAME:ARG%의 현재 쓰리사이즈는 다음과 같습니다
			CALL SHOW_INFO_BODYSIZE(ARG)
		ENDIF
		$INPUT_B
		PRINTFORML 바스트 값을 설정해 주십시오({BASE:ARG:신장 * 4 / 9}-{BASE:ARG:신장 * 3 / 4})
		PRINTFORML 
		SIF BASE:ARG:바스트 > 0
			PRINTFORML [0] 미설정으로 한다
		SIF CSVバスト > 0
			PRINTFORML [{CSVバスト}] 초기치로 되돌린다({CSVバスト} cm)
		PRINTFORML [{BASE:ARG:바스트}] 변경하지 않는다({BASE:ARG:바스트} cm)
		INPUT
		IF BASE:ARG:바스트 > 0 && BASE:ARG:바스트 == RESULT
			;변경하지 않는다
		ELSEIF RESULT == 0
			;未設定に戻す
			BASE:ARG:바스트 = RESULT
		ELSEIF RESULT < BASE:ARG:신장 * 4 / 9 || RESULT > BASE:ARG:신장 * 3 / 4
			PRINTL 부적절한 값입니다
			GOTO INPUT_B
		ELSE
			BASE:ARG:바스트 = RESULT
		ENDIF
		$INPUT_W
		PRINTFORML 웨이스트 값을 설정해 주십시오({BASE:ARG:신장 * 3 / 10}-{BASE:ARG:신장 / 2})
		PRINTFORML 
		SIF BASE:ARG:웨스트 > 0
			PRINTFORML [0] 미설정으로 한다
		SIF CSVウエスト > 0
			PRINTFORML [{CSVウエスト}] 초기치로 되돌린다({CSVウエスト} cm)
		PRINTFORML [{BASE:ARG:웨스트}] 변경하지 않는다({BASE:ARG:웨스트} cm)
		INPUT
		IF BASE:ARG:웨스트 > 0 && BASE:ARG:웨스트 == RESULT
			;변경하지 않는다
		ELSEIF RESULT == 0
			;未設定に戻す
			BASE:ARG:웨스트 = RESULT
		ELSEIF RESULT < BASE:ARG:신장 * 3 / 10 || RESULT > BASE:ARG:신장 * 7 / 12
			PRINTL 부적절한 값입니다
			GOTO INPUT_W
		ELSE
			BASE:ARG:웨스트 = RESULT
		ENDIF
		$INPUT_H
		PRINTFORML 힙 값을 설정해 주십시오({BASE:ARG:신장 * 9 / 20}-{BASE:ARG:신장 * 3 / 5})
		PRINTFORML 
		SIF BASE:ARG:힙사이즈 > 0
			PRINTFORML [0] 미설정으로 한다
		SIF CSVウエスト > 0
			PRINTFORML [{CSVヒップ}] 초기치로 되돌린다({CSVヒップ} cm)
		PRINTFORML [{BASE:ARG:힙사이즈}] 변경하지 않는다({BASE:ARG:힙사이즈} cm)
		INPUT
		IF BASE:ARG:힙사이즈 > 0 && BASE:ARG:힙사이즈 == RESULT
			;변경하지 않는다
		ELSEIF RESULT == 0
			;未設定に戻す
			BASE:ARG:힙사이즈 = RESULT
		ELSEIF RESULT < BASE:ARG:신장 * 9 / 20 || RESULT > BASE:ARG:신장 * 5 / 8
			PRINTL 부적절한 값입니다
			GOTO INPUT_H
		ELSE
			BASE:ARG:힙사이즈 = RESULT
		ENDIF
	ENDIF
ENDIF
