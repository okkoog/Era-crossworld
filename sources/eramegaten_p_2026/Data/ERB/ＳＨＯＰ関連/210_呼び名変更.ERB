DO
	INPUT
	LOCAL = INRANGE(RESULT, 0, 20) !| GROUPMATCH(RESULT, 99, 100)
	SIF LOCAL
		CLEARLINE 1
LOOP LOCAL
IF RESULT != 100
	IF RESULT == 99
		VARSET CSTR:ARG:0, "", GETNUM(CSTR, "해설3"), GETNUM(CSTR, "해설20") + 1
	ELSEIF RESULT
		PRINTFORML {RESULT}행에 삽입할 문자열을 입력해 주십시오.
		INPUTS
		CSTR:ARG:(29 + RESULT) '= RESULTS
