	NAMENUM_START = PAGENUM * 64
	NAMENUM_END   = 64 + PAGENUM * 64

	FOR LOCAL, NAMENUM_START, NAMENUM_END
		PRINTFORMLC [{LOCAL,2}]%RESULTS:LOCAL%
;		SIF LOCAL%3 == 2
;			PRINTL
	NEXT
	PRINTL
	DRAWLINE

	;ページの表示切替用
	PRINTFORMLC [1007] 이전페이지
	PRINTFORMLC [1008] 변경하지 않고 돌아간다
	PRINTFORMLC [1009] 다음페이지

	;いんぷっと
	INPUT

	IF 0
	;ページ送り
	ELSEIF RESULT == 1007
		PAGENUM -= 1
		;称号管理番号を増やしたらここのPAGENUM=Xを増やす
		SIF PAGENUM < 0
			PAGENUM = 3
		GOTO PAGE_CHANGE
	ELSEIF RESULT == 1009
		PAGENUM += 1
		;称号管理番号を増やしたらここのSIF PAGENUM > Xを増やす
		SIF PAGENUM > 3
			PAGENUM = 0
		GOTO PAGE_CHANGE
	;変更せず戻る
	;RESULTが1008の時
	ELSEIF RESULT == 1008
		CSTR:ARG:종족명 = %종족명(ARG)%
	;ページ送り以外の範囲外を選んだら再表示
	;称号管理番号を増やしたらここの「RESULT > XXX」を増やす
	ELSEIF RESULT < 0 || RESULT > 255
		GOTO PAGE_CHANGE
	;称号が「????」だった場合弾いていた……けど、まあいいかあ
;	ELSEIF EQUALCHECK_STR(RESULTS:RESULT,"????")
