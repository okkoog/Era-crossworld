SIF CHARANUM < 2
	RETURN 0
RETURN 1

@SHOP_COM_302, ARG
;CALL INPUT_CHARA_LIST("필터링 설정을 변경하고 싶은 캐릭터를 선택해주세요", "CASTING_SHOP_COM_302")
{
CALL INPUT_CHARA_LIST
	, "PROPSET_CHARA_FILTERING_TRAIN/PROPSET_CHARA_FILTERING_BATTLE/育成情報/基本ステータス/防御相性1/防御相性2"
	, "필터링 설정을 변경하고 싶은 캐릭터를 선택해주세요"
	, "CASTING_SHOP_COM_302" 
	, "SHOW_ADD_UP_FUNCTION"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "INFO_CHARA_FILTERING_CUSTOM_COLOR"
	, -1
}
IF RESULT == 1000
	;FOR LOCAL, 0, CHARANUM - 1
	;	IF CFLAG:LOCAL:필터링플래그
	;		FOR LOCAL:1, LOCAL, CHARANUM
	;			SIF CFLAG:(LOCAL:1):필터링플래그
	;				CONTINUE
	;			SIF TARGET == LOCAL:1
	;				TARGET = LOCAL
	;			SWAPCHARA LOCAL, LOCAL:1
	;			BREAK
	;		NEXT
	;	ENDIF
	;NEXT
	;ポジションに齟齬が発生するので、FLAG側を初期化＋CFLAG側から読み込み
	CALL REFRESH_POS
	RETURN 0
ENDIF
INVERTBIT CFLAG:RESULT:필터링플래그,0
IF CFLAG:RESULT:필터링플래그
	;ターゲットから外す
	FOR LOCAL, 0, 4
		IF LOCAL == 0
			SIF TARGET == RESULT
				TARGET = -1
			SIF ASSI == RESULT
				ASSI = -1
		ENDIF
		SIF TARGET:LOCAL == CFLAG:RESULT:캐릭터고유번호
			TARGET:LOCAL = -1
		SIF ASSI:LOCAL == CFLAG:RESULT:캐릭터고유번호 && LOCAL < 3
			ASSI:LOCAL -= 1
	NEXT
ENDIF
;ポジションからも外す
SIF CPOS(RESULT)
	CALL REMOVE_POSITION(CPOS(RESULT))
RESTART

@CASTING_SHOP_COM_302(ARG)
;主人公は除外
SIF ARG == 0
	RETURN 0
;仕事中のキャラも面倒なことになりそうだし、基本的にフィルターかけるとは思えないので除外
SIF CFLAG:ARG:노역플래그
	RETURN 0
;いないキャラも除外
SIF CFLAG:ARG:이자리에없는플래그 == 1
	RETURN 0
SIF CFLAG:ARG:전투이외불능
	RETURN 0
RETURN 1

