
@SHOPCOMABLE_207
SIF !IS_USEABLE_SHOPCOM
	RETURN 0
LOCAL:1 = 0
LOCAL:2 = 0
FOR LOCAL,0,CHARANUM
	SIF LOCAL == MASTER
		CONTINUE
	IF 陥落(LOCAL) == 2
		LOCAL:1 += 1
	ELSEIF 陥落(LOCAL) == 3
		LOCAL:2 = 1
	ENDIF
NEXT
RESULT:1 = 2
IF LOCAL:1 > 0  && MONEY > 1000000
	RESULTS = 계약
	RETURN 1
ELSEIF LOCAL:2 == 1
	RESULTS = 계약
	RETURN 0
ELSE
	RESULTS = ？？？？？
	RETURN 0
ENDIF

@SHOP_COM_207, ARG
CUSTOMDRAWLINE =
PRINTL 노예와 특별한 계약을 맺습니다
PRINTL 계약을 맺은 캐릭터는 통상적인 악마합체나 조마・마정장비 작성의 소재로 삼을 수 없게 됩니다.
DRAWLINE
LOCAL:1 = 0
LOCAL:2 = 0
LOCAL:3 = 0
LOCAL:4 = 0
FOR LOCAL,0,CHARANUM
	SIF LOCAL == MASTER
		CONTINUE
	SIF TALENT:LOCAL:친애 && !TALENT:LOCAL:아내 && !TALENT:LOCAL:남편
		LOCAL:1 += 1
	SIF TALENT:LOCAL:창부 && !TALENT:LOCAL:음마
		LOCAL:2 += 1
	SIF TALENT:LOCAL:예속 && !TALENT:LOCAL:노리개
		LOCAL:3 += 1
	SIF TALENT:LOCAL:동료 && !TALENT:LOCAL:맹우
		LOCAL:4 += 1
NEXT

SIF LOCAL:1 && MONEY > 1000000
	PRINTL [1] 결혼한다 (100만엔)
SIF LOCAL:2 && MONEY > 1000000
	PRINTL [2] 음마로 만든다 (100만엔)
SIF LOCAL:3 && MONEY > 1000000
	PRINTL [3] 목걸이를 선물한다 (100만엔)
SIF LOCAL:4 && MONEY > 1000000
	PRINTL [4] 맹우로 맹세한다 (100만엔)
;PRINTL [4] 使い魔にする (50万￥)
DRAWLINE
PRINTL [0] 돌아간다

$INPUT_LOOP
INPUT

IF RESULT == 0
	RETURN 0
ELSEIF ((RESULT == 1 && LOCAL:1) || (RESULT == 2 && LOCAL:2) || (RESULT == 3 && LOCAL:3) || (RESULT == 4 && LOCAL:4)) && MONEY > 1000000
	CALL CONTRACT,RESULT
ELSE
	GOTO INPUT_LOOP
ENDIF
IF RESULT == 1
	RETURN 0
ELSE
	RESTART
ENDIF


@CONTRACT,ARG
#DIMS DYNAMIC L_MESSAGE
Z = ARG
SELECTCASE ARG
	CASE 1
		L_MESSAGE = 結婚したいキャラを選んでください
	CASE 2
		L_MESSAGE = 淫魔に堕としたいキャラを選んでください
	CASE 3
		L_MESSAGE = 首輪を贈りたいキャラを選んでください
	CASEELSE
		L_MESSAGE = 誓いを交わしたいキャラを選んでください
ENDSELECT
{
CALL INPUT_CHARA_LIST
	, "FUNC_PROPSET_LIST"
	, L_MESSAGE
	, "CASTING_CONTRACT" 
	, "SHOW_ADD_UP_FUNCTION"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
IF RESULT == 1000
	RETURN 0
ENDIF
PRINTL
PRINTW ………
PRINTW ……
PRINTW …
PRINTL


LOCAL = RESULT
IF ARG == 1
	CALL SET_契約素質, LOCAL, "妻・夫"
	MONEY -= 1000000
	TFLAG:13 = 40
	LOCAL:1 = TARGET
	TARGET = LOCAL
	CALL KOJO_MESSAGE_EVENT
	TARGET = LOCAL:1
	;==============================================================
	RETURN 1
ELSEIF ARG == 2
	MONEY -= 1000000
	CALL SET_契約素質, LOCAL, "음마"
	TFLAG:13 = 41
	LOCAL:1 = TARGET
	TARGET = LOCAL
	CALL KOJO_MESSAGE_EVENT
	TARGET = LOCAL:1
	RETURN 1
ELSEIF ARG == 3
	MONEY -= 1000000
	CALL SET_契約素質, LOCAL, "노리개"
	TFLAG:13 = 42
	LOCAL:1 = TARGET
	TARGET = LOCAL
	CALL KOJO_MESSAGE_EVENT
	TARGET = LOCAL:1
	RETURN 1
ELSEIF ARG == 4
	MONEY -= 1000000
	CALL SET_契約素質, LOCAL, "맹우"
	TFLAG:13 = 92
	LOCAL:1 = TARGET
	TARGET = LOCAL
	CALL KOJO_MESSAGE_EVENT
	TARGET = LOCAL:1
	SIF TARGET == LOCAL
		TARGET = -1
	IF TALENT:LOCAL:연모
		PRINTFORMW %NAME:LOCAL%은(는) 【연모】를 잃었다
		TALENT:LOCAL:연모 = 0
	ENDIF
	
	RETURN 1
ENDIF


@CASTING_CONTRACT(ARG)
SIF ARG == MASTER
	RETURN 0
SIF TALENT:ARG:아내 || TALENT:ARG:남편 || TALENT:ARG:음마 || TALENT:ARG:노리개 || TALENT:ARG:맹우
	RETURN 0
SIF Z == 1 && TALENT:ARG:친애 == 0
	RETURN 0
SIF Z == 2 && TALENT:ARG:창부 == 0
	RETURN 0
SIF Z == 3 && TALENT:ARG:예속 == 0
	RETURN 0
SIF Z == 4 && TALENT:ARG:동료 == 0
	RETURN 0
SIF CFLAG:ARG:이자리에없는플래그 == 1
	RETURN 0
SIF CFLAG:ARG:전투이외불능
	RETURN 0
;労役中はダメ
SIF IS_RENTING(ARG)
	RETURN 0
SIF CFLAG:ARG:필터링플래그
	RETURN 0
RETURN 1
