@SHOPCOMABLE_123
RETURN 0

@SHOP_COM_123, ARG
#DIM LCOUNT
CUSTOMDRAWLINE =
PRINTL 마네킹：
PRINTL 「어서와。우리 가게에 있는 것은、아름다운 옷 뿐。지금이라면 특별히、키스마크와 함께 팔아줄 수 있어」
DRAWLINE
PRINTL
PRINTL
DRAWLINE
FOR LCOUNT, 0, 12
	PRINTL
NEXT
DRAWLINE
PRINTL
TWAIT 2000,0
CLEARLINE 19
$START
PRINTL 「어때？ 아름다운 옷만 가득하지？ 어느것이든 평범한 사람이 입기에는 아까운 물건이라고？」
DRAWLINE
PRINTFORML 현재 {MONEY:1}마카 있습니다。
PRINTL 무엇과 교환하시겠습니다？
DRAWLINE

FOR LOCAL,0,12
	PRINTFORML [{LOCAL}] %GET_CLOTHESNAME(LOCAL)%
NEXT
DRAWLINE
PRINTL [100] 그만둔다


$INPUT_LOOP
INPUT
IF RESULT == 100
	CUSTOMDRAWLINE =
	PRINTL 마네킹：
	PRINTL 「당신은 좀 더 센스를 익힐 필요가 있겠네。다음에 천천히 설명해 줄께。그럼 안녕」
	DRAWLINE
	PRINTL
	PRINTL
	DRAWLINE
	FOR LCOUNT, 0, 12
		PRINTL
	NEXT
	DRAWLINE
	PRINTL
	TWAIT 2000,0
	RETURN 0
ELSEIF RESULT >= 0 && RESULT < 12
	LOCAL = RESULT
	CALL MAKE_CLOTHESLIST,RESULT
	LOCAL:1 = RESULT
ELSE
	GOTO INPUT_LOOP
ENDIF
P = 0
$PRINT_LIST
DRAWLINE
CALL PRINT_EXCHANGEITEMLIST,LOCAL:1
$INPUT_LOOP2
INPUT
LOCAL:2 = RESULT
IF RESULT == 0
	CUSTOMDRAWLINE =
	PRINTL 마네킹：
	GOTO START
ELSEIF RESULT == 7 && P > 0
	P -= 1
	GOTO PRINT_LIST
ELSEIF RESULT == 9 && P < LOCAL:1/20
	P += 1
	GOTO PRINT_LIST
ELSEIF MATCH(アイテムリスト,RESULT,0)> 0
	DRAWLINE
	IF MONEY:1 < ITEMPRICE:(LOCAL:2)
		PRINTW 마카가 부족합니다
		GOTO PRINT_LIST
	ELSE
		PRINTFORMW %조사처리(ITEMNAME:(LOCAL:2), "을")%를 구입했습니다
		MONEY:1 -= (ITEMPRICE:(LOCAL:2))
		ITEM:(LOCAL:2) += 1
		CALL MAKE_CLOTHESLIST,LOCAL
		LOCAL:1 = RESULT
		GOTO PRINT_LIST
	ENDIF
ELSE
	GOTO INPUT_LOOP2
ENDIF
GOTO PRINT_LIST


@MAKE_CLOTHESLIST,ARG
VARSET アイテムリスト,-1
LOCAL:1 = 0
	FOR LOCAL,6001,VARSIZE("ITEM")
		SIF ITEMPRICE:LOCAL == 0
			CONTINUE
		SIF ITEM:LOCAL > 0
			CONTINUE
		RESULT = 12
		TRYCCALLFORM CLOTHES_PART_{LOCAL-6000}
			IF RESULT == ARG
				アイテムリスト:(LOCAL:1) = LOCAL
				LOCAL:1 += 1
			ENDIF
		CATCH
		ENDCATCH
	NEXT
RETURN LOCAL:1