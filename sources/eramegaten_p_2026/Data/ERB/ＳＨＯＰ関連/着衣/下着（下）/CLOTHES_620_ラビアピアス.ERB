
@CLOTHES_NAME_620
RESULTS = 라비아피어스

;露出部位
@CLOTHES_EXPOSE_620,ARG
;ARG = 露出する部位
;1 = 팔노출 2 = 발노출 3 = 다리노출 4 = 유방노출 5 = 유두노출 6 = ヘソ露出 7 = 음순노출 8 = 둔부노출


SELECTCASE ARG
	CASE 0
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

;装備部位
@CLOTHES_PART_620
RETURN 6

;服の前が開くか
;1 開けられる、2 開きっぱなし
@CLOTHES_OPENFRONT_620
RETURN 0

;股間の構造
;1 = ズボン、2 = ビキニタイプ、3 = スカート、4 = 穴開き、5 前開き、6 開閉可能
@CLOTHES_CROTCH_620
RETURN 4

;衣装の属性
@CLOTHES_TAG_620
#FUNCTION
RESULTS_F = 

;装備時の調教効果
@CLOTHES_SOURCE_620,ARG
IF FLAG:SHOP커맨드 == 0
	SOURCE:ARG:아픔 += 25
	IF ARG == TARGET
		DOWNBASE:ARG:0 += 10
		DOWNBASE:ARG:1 += 10
	ENDIF
	IF SOURCE:ARG:쾌Ｃ > 0
		TIMES SOURCE:ARG:쾌Ｃ , 1.20
		IF ARG == TARGET
			TIMES DOWNBASE:ARG:0 , 1.30
			TIMES DOWNBASE:ARG:1 , 1.10
		ENDIF
	ENDIF
ELSE

ENDIF

;装備時の経験追加
@CLOTHES_EXP_620,ARG
IF FLAG:SHOP커맨드 == 0
	SIF ARG == -1
		RETURN 0
	PRINTFORML <라비아 피어싱 착용 중>\@ ARG == MASTER ? (主人) #\@\@ ARG == ASSI ? (助手) #\@
	IF TCVAR:ARG:획득고통쾌락경험
		TCVAR:ARG:획득고통쾌락경험 += MAX(TCVAR:ARG:획득고통쾌락경험*140/100 , 1)
		SIF ARG == TARGET
			TIMES DOWNBASE:ARG:1 , 1.10
	ENDIF
ELSE

ENDIF

;装備するための条件
@CLOTHES_PREREQUISITE_620,ARG
SIF IS_MALE(ARG)
	RETURN 0
SIF ARG == MASTER
	RETURN 1
SIF MARK:ARG:고통각인 < 3
	RETURN 0
SIF ABL:ARG:순종 >= 4
	RETURN 1
SIF ABL:ARG:마조끼 >= 3
	RETURN 1
RETURN 0

@CLOTHES_PRICE_620
RETURN 1500
