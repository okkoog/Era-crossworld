@CLOTHES_NAME_712
RESULTS = 새끼줄

;露出部位
@CLOTHES_EXPOSE_712,ARG
;ARG = 露出する部位
;1 = 팔노출 2 = 발노출 3 = 다리노출 4 = 유방노출 5 = 유두노출 6 = ヘソ露出 7 = 음순노출 8 = 둔부노출
SELECTCASE ARG
	CASE 0
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

;装備部位
@CLOTHES_PART_712
RETURN 7

;服の前が開くか
;1 開けられる、2 開きっぱなし
@CLOTHES_OPENFRONT_712
RETURN 0

;胸の構造
; 0:開けられない 1:ボタン式 2:チャック式 4:上からこんにちは 8:たくしあげてこんにちは 16:和服など、合わせる衣装 32:前から差し込めそうな穴 64:口元-胸元間にペニス入るスペース（ビット演算）
@CLOTHES_BREAST_712
RETURN 12

;股間の構造
;1 = ズボン、2 = ビキニタイプ、3 = スカート、4 = 穴開き、5 前開き、6 開閉可能
@CLOTHES_CROTCH_712
RETURN 2

;衣装の属性
@CLOTHES_TAG_712
#FUNCTION
RESULTS_F = 

;装備時の調教効果
@CLOTHES_SOURCE_712,ARG = -1
SOURCE:ARG:아픔 += 100
RETURN 0

;装備時の経験追加
@CLOTHES_EXP_712,ARG = -1
IF FLAG:SHOP커맨드 == 0
	SIF ARG == -1
		RETURN 0
	PRINTFORML <荒縄着用中>\@ ARG == MASTER ? (主人) #\@\@ ARG == ASSI ? (助手) #\@
	CALL ADDS_EXP("긴박경험", 1, ARG)
	IF ARG == TARGET
		DOWNBASE:ARG:1 += 25
		DOWNBASE:ARG:0 += 25
	ENDIF

	IF TCVAR:ARG:획득고통쾌락경험
		TCVAR:ARG:획득고통쾌락경험 += MAX(TCVAR:ARG:획득고통쾌락경험*140/100 , 1)
		SIF ARG == TARGET
			TIMES DOWNBASE:ARG:1 , 1.10
	ENDIF
ELSE

ENDIF

;装備するための条件
@CLOTHES_PREREQUISITE_712,ARG
SIF ABL:ARG:순종 >= 3
	RETURN 1
SIF ARG == MASTER
	RETURN 1
RETURN 0

@CLOTHES_PRICE_712
RETURN 1000
