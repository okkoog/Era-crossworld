
@CLOTHES_NAME_702
RESULTS = 타이즈（구멍뚫림）

;露出部位
@CLOTHES_EXPOSE_702,ARG
;ARG = 露出する部位
;1 = 팔노출 2 = 발노출 3 = 다리노출 4 = 유방노출 5 = 유두노출 6 = ヘソ露出 7 = 음순노출 8 = 둔부노출


SELECTCASE ARG
	CASE 1,2,3,4,6
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

