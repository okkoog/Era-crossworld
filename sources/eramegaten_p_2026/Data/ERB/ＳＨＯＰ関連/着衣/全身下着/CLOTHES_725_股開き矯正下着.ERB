@CLOTHES_NAME_725
RESULTS = 개각교정속옷
;股ホックの付いた矯正下着
;将来的には通常の矯正下着と並べて、体型素質とかスリーサイズ関連に補正を付けたい…

;露出部位
@CLOTHES_EXPOSE_725,ARG
;ARG = 露出する部位
;1 = 팔노출 2 = 발노출 3 = 다리노출 4 = 유방노출 5 = 유두노출 6 = ヘソ露出 7 = 음순노출 8 = 둔부노출
SELECTCASE ARG
	CASE 4,5,6,7,8
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

;装備部位
@CLOTHES_PART_725
RETURN 7

;服の前が開くか
;1 開けられる、2 開きっぱなし
@CLOTHES_OPENFRONT_725
RETURN 0

;胸の構造
; 0:開けられない 1:ボタン式 2:チャック式 4:上からこんにちは 8:たくしあげてこんにちは 16:和服など、合わせる衣装 32:前から差し込めそうな穴 64:口元-胸元間にペニス入るスペース（ビット演算）
@CLOTHES_BREAST_725
RETURN 4
;胸の構造なので、ここでは関係なし

;股間の構造
;1 = ズボン、2 = ビキニタイプ、3 = スカート、4 = 穴開き、5 前開き、6 開閉可能
@CLOTHES_CROTCH_725
RETURN 2
;ボタン式・開閉可を表現したいけど対応する値が分からないので、暫定でビキニ構造に

;衣装の属性
@CLOTHES_TAG_725
#FUNCTION
RESULTS_F = 

;装備時の調教効果
@CLOTHES_SOURCE_725,ARG = -1
RETURN 0

;装備時の経験追加
@CLOTHES_EXP_725,ARG = -1
RETURN 0

@CLOTHES_PRICE_725
RETURN 2000
;値は穴開き系に準じて矯正下着の倍

;触覚
;1 = スルー 2 = 上から伝わる 4 = 潜り込ませられる
;ARG 0 = Ｃ 1 = Ｖ 2 = Ａ 3 = 乳首 4 = 乳房
@CLOTHES_触覚_725,ARG
SELECTCASE ARG
	CASE 0,3,4
		RETURN 6
ENDSELECT
