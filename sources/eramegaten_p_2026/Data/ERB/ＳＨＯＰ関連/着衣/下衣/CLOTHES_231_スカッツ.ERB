;ズボンとスカートを組み合わせたような服
@CLOTHES_NAME_231
RESULTS = 스커츠

;露出部位
@CLOTHES_EXPOSE_231,ARG
;ARG = 露出する部位
;1 = 팔노출 2 = 발노출 3 = 다리노출 4 = 유방노출 5 = 유두노출 6 = ヘソ露出 7 = 음순노출 8 = 둔부노출
SELECTCASE ARG
	CASE 2,3,7,8
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

;装備部位
@CLOTHES_PART_231
RETURN 2

;服の前が開くか
;1 開けられる、2 開きっぱなし
@CLOTHES_OPENFRONT_231
RETURN 0

;股間の構造
;1 = ズボン、2 = ビキニタイプ、3 = スカート、4 = 穴開き、5 前開き、6 開閉可能
@CLOTHES_CROTCH_231
RETURN 1

;衣装の属性
@CLOTHES_TAG_231
#FUNCTION
RESULTS_F = 

;装備時の調教効果
@CLOTHES_SOURCE_231,ARG = -1
RETURN 0

;装備時の経験追加
@CLOTHES_EXP_231,ARG = -1
		RETURN 0

@CLOTHES_PRICE_231
RETURN 50

;触覚
;1 = スルー 2 = 上から伝わる 4 = 潜り込ませられる
;ARG 0 = Ｃ 1 = Ｖ 2 = Ａ 3 = 乳首 4 = 乳房
@CLOTHES_触覚_231,ARG
SELECTCASE ARG
	CASE 0 TO 2
		RETURN 4
ENDSELECT
