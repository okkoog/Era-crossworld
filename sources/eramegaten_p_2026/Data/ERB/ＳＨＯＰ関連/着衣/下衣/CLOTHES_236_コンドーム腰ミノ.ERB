;「배덕의반지」と同効果の着衣

@CLOTHES_NAME_236
RESULTS = 콘돔허리미노

;露出部位
@CLOTHES_EXPOSE_236,ARG
;ARG = 露出する部位
;1 = 팔노출 2 = 발노출 3 = 다리노출 4 = 유방노출 5 = 유두노출 6 = ヘソ露出 7 = 음순노출 8 = 둔부노출
SELECTCASE ARG
	CASE 0
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

;装備部位
@CLOTHES_PART_236
RETURN 2

;服の前が開くか
;1 開けられる、2 開きっぱなし
@CLOTHES_OPENFRONT_236
RETURN 0

;股間の構造
;1 = ズボン、2 = ビキニタイプ、3 = スカート、4 = 穴開き、5 前開き、6 開閉可能
@CLOTHES_CROTCH_236
RETURN 4

;衣装の属性
@CLOTHES_TAG_236
#FUNCTION
RESULTS_F = 

;スカートのタイプ
;1 = 具チラ 2 = ミニ 3 = 通常 4 = ロング 5 = タイト
@CLOTHES_SKIRT_236
RETURN 1

;装備時の調教効果
@CLOTHES_SOURCE_236,ARG = -1
RETURN 0

;装備時の経験追加
@CLOTHES_EXP_236,ARG = -1
		RETURN 0

@CLOTHES_PRICE_236
RETURN 100
