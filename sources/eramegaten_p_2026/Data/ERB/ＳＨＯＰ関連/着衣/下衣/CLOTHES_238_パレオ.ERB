@CLOTHES_NAME_238
RESULTS = 파레오(水着)
;巻き付けスカート状の水着
;元はタヒチの衣装だが、近年は定番の水着として定着
;(水着とセット着用の想定
;下着用として用意したが、分類的には普通に下衣(스커트)だよなって思って移動)

;露出部位
@CLOTHES_EXPOSE_238,ARG
;ARG = 露出する部位
;1 = 팔노출 2 = 발노출 3 = 다리노출 4 = 유방노출 5 = 유두노출 6 = ヘソ露出 7 = 음순노출 8 = 둔부노출
SELECTCASE ARG
	CASE 7,8
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

;装備部位
@CLOTHES_PART_238
RETURN 2

;服の前が開くか
;1 開けられる、2 開きっぱなし
@CLOTHES_OPENFRONT_238
RETURN 0

;股間の構造
;1 = ズボン、2 = ビキニタイプ、3 = スカート、4 = 穴開き、5 前開き、6 開閉可能
@CLOTHES_CROTCH_238
RETURN 3

;衣装の属性
@CLOTHES_TAG_238
#FUNCTION
RESULTS_F = 水着

;スカートのタイプ
;1 = 具チラ 2 = ミニ 3 = 通常 4 = ロング 5 = タイト
@CLOTHES_SKIRT_238
RETURN 3

;装備時の調教効果
@CLOTHES_SOURCE_238,ARG = -1
RETURN 0

;装備時の経験追加
@CLOTHES_EXP_238,ARG = -1
RETURN 0

@CLOTHES_PRICE_238
RETURN 200

