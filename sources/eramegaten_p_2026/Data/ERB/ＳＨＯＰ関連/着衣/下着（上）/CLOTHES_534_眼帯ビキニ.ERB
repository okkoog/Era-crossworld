@CLOTHES_NAME_534
RESULTS = 안대비키니
;眼帯っぽい形状のビキニ
;正直マイクロビキニと被るが、まぁええか…

;露出部位
@CLOTHES_EXPOSE_534,ARG
;ARG = 露出する部位
;1 = 팔노출 2 = 발노출 3 = 다리노출 4 = 유방노출 5 = 유두노출 6 = ヘソ露出 7 = 음순노출 8 = 둔부노출
SELECTCASE ARG
	CASE 5
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

;装備部位
@CLOTHES_PART_534
RETURN 5

;服の前が開くか
;1 開けられる、2 開きっぱなし
@CLOTHES_OPENFRONT_534
RETURN 0

;가슴구조
; 0 開けられない 1 ボタン式 2 チャック式 4 上からこんにちは 8 たくしあげてこんにちは 16 和服など、合わせる衣装 32 前から差し込めそうな穴 64 口元-胸元間にペニス入るスペース（ビット演算）
@CLOTHES_BREAST_534
RETURN 12

;股間の構造
;1 = ズボン、2 = ビキニタイプ、3 = スカート、4 = 穴開き、5 前開き、6 開閉可能
@CLOTHES_CROTCH_534
RETURN 0

;衣装の属性
@CLOTHES_TAG_534
#FUNCTION
RESULTS_F = 水着

;装備時の調教効果
@CLOTHES_SOURCE_534,ARG = -1
RETURN 0

;装備時の経験追加
@CLOTHES_EXP_534,ARG = -1
RETURN 0

@CLOTHES_PRICE_534
RETURN 1000

;触覚
;1 = スルー 2 = 上から伝わる 4 = 潜り込ませられる
;ARG 0 = Ｃ 1 = Ｖ 2 = Ａ 3 = 乳首 4 = 乳房
@CLOTHES_触覚_534,ARG
SELECTCASE ARG
	CASE 3,4
		RETURN 6
ENDSELECT
