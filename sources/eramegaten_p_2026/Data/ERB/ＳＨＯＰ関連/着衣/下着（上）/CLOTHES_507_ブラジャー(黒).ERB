@CLOTHES_NAME_507
RESULTS = 브래지어(흑)

;露出部位
@CLOTHES_EXPOSE_507,ARG
;ARG = 露出する部位
;1 = 팔노출 2 = 발노출 3 = 다리노출 4 = 유방노출 5 = 유두노출 6 = ヘソ露出 7 = 음순노출 8 = 둔부노출
SELECTCASE ARG
	CASE 4,5
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

;装備部位
@CLOTHES_PART_507
RETURN 5

;服の前が開くか
;1 開けられる、2 開きっぱなし
@CLOTHES_OPENFRONT_507
RETURN 0

;胸の構造
; 0:開けられない 1:ボタン式 2:チャック式 4:上からこんにちは 8:たくしあげてこんにちは 16:和服など、合わせる衣装 32:前から差し込めそうな穴 64:口元-胸元間にペニス入るスペース（ビット演算）
@CLOTHES_BREAST_507
RETURN 12

;股間の構造
;1 = ズボン、2 = ビキニタイプ、3 = スカート、4 = 穴開き、5 前開き、6 開閉可能
@CLOTHES_CROTCH_507
RETURN 0

