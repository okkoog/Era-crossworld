@CLOTHES_NAME_351
RESULTS = 아라비안・하렘
;文字通りアラビアのハーレム衣装
;アラビア風の踊り子の服とかそっちをイメージした方が分かりやすい？

;露出部位
@CLOTHES_EXPOSE_351,ARG
;ARG = 露出する部位
;1 = 팔노출 2 = 발노출 3 = 다리노출 4 = 유방노출 5 = 유두노출 6 = ヘソ露出 7 = 음순노출 8 = 둔부노출
SELECTCASE ARG
	CASE 4,5,7,8
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

;装備部位
@CLOTHES_PART_351
RETURN 3

;服の前が開くか
;1 開けられる、2 開きっぱなし
@CLOTHES_OPENFRONT_351
RETURN 0

;股間の構造
;1 = ズボン、2 = ビキニタイプ、3 = スカート、4 = 穴開き、5 前開き、6 開閉可能
@CLOTHES_CROTCH_351
RETURN 1

;衣装の属性
@CLOTHES_TAG_351
#FUNCTION
RESULTS_F = 

;スカートのタイプ
;1 = 具チラ 2 = ミニ 3 = 通常 4 = ロング 5 = タイト
@CLOTHES_SKIRT_351
RETURN 4

;装備時の調教効果
@CLOTHES_SOURCE_351,ARG = -1
RETURN 0

;装備時の経験追加
@CLOTHES_EXP_351,ARG = -1
RETURN 0

@CLOTHES_PRICE_351
RETURN 1000

;触覚
;1 = スルー 2 = 上から伝わる 4 = 潜り込ませられる
;ARG 0 = Ｃ 1 = Ｖ 2 = Ａ 3 = 乳首 4 = 乳房
@CLOTHES_触覚_351,ARG
SELECTCASE ARG
	CASE 3,4
		RETURN 2
ENDSELECT
