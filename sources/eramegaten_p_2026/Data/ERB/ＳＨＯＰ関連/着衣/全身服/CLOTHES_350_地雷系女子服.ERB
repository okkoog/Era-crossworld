@CLOTHES_NAME_350
RESULTS = 지뢰계 여자옷, 핑크와 검정이 기본(다크 계열)

;露出部位
@CLOTHES_EXPOSE_350,ARG
;露出抑えめ、あくまでカワイイ重視
;ARG = 露出する部位
;1 = 팔노출 2 = 발노출 3 = 다리노출 4 = 유방노출 5 = 유두노출 6 = ヘソ露出 7 = 음순노출 8 = 둔부노출
SELECTCASE ARG
	CASE 3,4,5,6
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

;装備部位
@CLOTHES_PART_350
RETURN 3

;服の前が開くか
;1 開けられる、2 開きっぱなし
@CLOTHES_OPENFRONT_350
RETURN 1

;가슴구조
;ボタンタイプを想定
; 0 開けられない 1 ボタン式 2 チャック式 4 上からこんにちは 8 たくしあげてこんにちは 16 和服など、合わせる衣装 32 前から差し込めそうな穴 64 口元-胸元間にペニス入るスペース（ビット演算）
@CLOTHES_BREAST_350
RETURN 1
;股間の構造
;1 = ズボン、2 = ビキニタイプ、3 = スカート、4 = 穴開き、5 前開き、6 開閉可能
@CLOTHES_CROTCH_350
RETURN 3

;衣装の属性
@CLOTHES_TAG_350
#FUNCTION
RESULTS_F = 
;スカートのタイプ
;膝上スカートを想定
;1 = 具チラ 2 = ミニ 3 = 通常 4 = ロング 5 = タイト
@CLOTHES_SKIRT_350
RETURN 2

;装備時の調教効果
@CLOTHES_SOURCE_350,ARG = -1
RETURN 0

;装備時の経験追加
@CLOTHES_EXP_350,ARG = -1
		RETURN 0

@CLOTHES_PRICE_350
RETURN 250

;触覚
;1 = スルー 2 = 上から伝わる 4 = 潜り込ませられる
;ARG 0 = Ｃ 1 = Ｖ 2 = Ａ 3 = 乳首 4 = 乳房
@CLOTHES_触覚_350,ARG
SELECTCASE ARG
	CASE 3,4
		RETURN 2
ENDSELECT