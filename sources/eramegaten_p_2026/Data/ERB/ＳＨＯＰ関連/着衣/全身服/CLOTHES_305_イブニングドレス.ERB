
@CLOTHES_NAME_305
RESULTS = 이브닝드레스(V넥)

;露出部位
@CLOTHES_EXPOSE_305,ARG
;ARG = 露出する部位
;1 = 팔노출 2 = 발노출 3 = 다리노출 4 = 유방노출 5 = 유두노출 6 = ヘソ露出 7 = 음순노출 8 = 둔부노출
SELECTCASE ARG
	CASE 3,5,6
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

;装備部位
@CLOTHES_PART_305
RETURN 3

;服の前が開くか
;1 開けられる、2 開きっぱなし
@CLOTHES_OPENFRONT_305
RETURN 1
;가슴구조
; 0 開けられない 1 ボタン式 2 チャック式 4 上からこんにちは 8 たくしあげてこんにちは 16 和服など、合わせる衣装 32 前から差し込めそうな穴 64 口元-胸元間にペニス入るスペース（ビット演算）
@CLOTHES_BREAST_305
RETURN 4

;股間の構造
;1 = ズボン、2 = ビキニタイプ、3 = スカート、4 = 穴開き、5 前開き、6 開閉可能
@CLOTHES_CROTCH_305
RETURN 3

;衣装の属性
@CLOTHES_TAG_305
#FUNCTION
RESULTS_F = 
;スカートのタイプ
;1 = 具チラ 2 = ミニ 3 = 通常 4 = ロング 5 = タイト
@CLOTHES_SKIRT_305
RETURN 4

;装備時の調教効果
@CLOTHES_SOURCE_305,ARG = -1
RETURN 0

;装備時の経験追加
@CLOTHES_EXP_305,ARG = -1
		RETURN 0

@CLOTHES_PRICE_305
RETURN 200

;触覚
;1 = スルー 2 = 上から伝わる 4 = 潜り込ませられる
;ARG 0 = Ｃ 1 = Ｖ 2 = Ａ 3 = 乳首 4 = 乳房
@CLOTHES_触覚_305,ARG
SELECTCASE ARG
	CASE 3,4
		RETURN 2
ENDSELECT
