@EVENTSHOP
#PRI
#DIM LCOUNT
;FOR LOCAL,0,CHARANUM
;	CALL SYNC_STATUS,LOCAL
;NEXT
;---- EDIT 034 DEL START -------------------------
;FLAG:윈도우메시지스킵 = 0
;---- EDIT 034 DEL END ---------------------------
;DELDATA SAVEDATA_NUM_FOR_CONTINUE;EDIT 031 ADD
IF FLAG:SHOP커맨드 == [[ショップ:탐색]]
	;画像データを取り直す
	CALL RPG画像追加
	;フロアデータを作り直す
	CALL MAKE_FLOOR, FLAG:현던전
	CALL DUNGEON_ATTACK
	;---- EDIT 041 ADD START -------------------------
	CALL FINALIZE_DUNGEON
	SIF FLAG:던전내조교 == 1
		RETURN 0
	;---- EDIT 041 ADD END ---------------------------
	IF FLAG:전생리스타트예약
		FLAG:SHOP커맨드 = [[ショップ:환생리스타트]]
		CALL SHOP_COM_[[ショップ:환생리스타트]], , "強制ニューゲーム"
		RETURN 0
	ENDIF
	;BEGIN TURNEND
ELSE
	DELDATA SAVEDATA_NUM_FOR_CONTINUE
ENDIF

FOR LOCAL,0,CHARANUM
	SIF CFLAG:LOCAL:악마변신 == 1
		CALL TRANS_DEVIL , LOCAL , 0
NEXT

FLAG:SHOP커맨드 = 0
;---- EDIT 037 ADD START -------------------------
FLAG:튜토리얼진행중 = 0
FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0
FLAG:RESULT스킵 = 0
;---- EDIT 037 ADD END ---------------------------
;---- EDIT 038 ADD START -------------------------
FLAG:소환불능 = 0
IF CMATCH(CFLAG:0:게스트가입플래그, 1)
	DRAWLINE
	PRINTFORML 어떤 이유로 게스트 가입 플래그가 세워져 있는 캐릭터가 존재합니다
	PRINTFORML 직전의 공략 던전이나 공략 이벤트 등의 정보를 첨부하여 버그 보고를 부탁드립니다。
	PRINTL 
	PRINTFORML 캐릭터 소지 수({CHARANUM})
	PRINTFORML 이상 플래그 소지자
	FOR LCOUNT, 0, CHARANUM
		SIF !CFLAG:LCOUNT:게스트가입플래그
			CONTINUE
		PRINTFORML [{LCOUNT, 3}] %CALLNAME:LCOUNT%
		CFLAG:LCOUNT:게스트가입플래그 = 0
	NEXT
	PRINTL 
	PRINTL [9]를 입력하면 진행합니다
	DRAWLINE
	DO
		ONEINPUTS
		CLEARLINE 1
	LOOP RESULTS != "9"
ENDIF
;---- EDIT 038 ADD END ---------------------------
;-------------------------------------------------
;売り物やショップコマンド表示
;EVENTSHOPの実行終了後やロードやショップへRETURNしてくると実行される
;∴セーブデータ互換などはここで行うと良い
;訂正：@EVENTLOADの方が利便性が高い
;-------------------------------------------------

@SHOW_SHOP
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CATEGORY
#DIM DYNAMIC コマンドストック,8,100
#DIMS DYNAMIC コマンドストック名,8,100
#DIMS DYNAMIC コマンドストック解説文,8,100
#DIM DYNAMIC コマンド可能,8,100
;---- FONT LEAK GUARD START -------------------------
SETFONT
;---- FONT LEAK GUARD END ---------------------------
;---- EDIT 034 ADD START -------------------------
FLAG:윈도우메시지스킵 = 0
;---- EDIT 034 ADD END ---------------------------

;---- EDIT 035 ADD START -------------------------
;-------------------------------------------------
;使用アイテムをストックから移動させる。
;-------------------------------------------------
CALL MOVE_STOCK_ITEM

VARI STOCK_STOCKSIZE
STOCK_STOCKSIZE = GET_STOCKSIZE()
VARI STOCK_LV = FLAG:조직공헌LV
;---- EDIT 035 ADD END ---------------------------
;貢献度ランクの確認とセット
IF GET_PAYMENT_RANK() > FLAG:조직공헌LV
	FLAG:조직공헌LV = GET_PAYMENT_RANK()
	SIF FLAG:조직공헌LV < 16
		CALL MESSAGE_B, 3, @"%CALLNAME:MASTER%의 공헌과 활약이 평가되어、", "새로운 장비품의 구입이 허가되었습니다。", @"필요레벨{FLAG:조직공헌LV * 5 + 5}까지의 장비가 정크숍에 진열됩니다。"
	MONEY:2 = GET_PAYMENT_FOR_NEXT_RANK()
ENDIF
FLAG:최대조직공헌LV = MAX(FLAG:조직공헌LV, FLAG:최대조직공헌LV)

;---- EDIT P 002 ADD START -------------------------
IF !ADD_TRAINABLE_1 && FLAG:조직공헌LV > 4
	ADD_TRAINABLE_1 = 1
	SIF STOCK_LV < FLAG:조직공헌LV
		CALL MESSAGE_B, 3, @"%CALLNAME:MASTER%의 공헌과 활약이 평가되어、", @"시설이 강화되었습니다。", "조교실행가능횟수가 늘어났습니다。"
ENDIF
IF !ADD_TRAINABLE_2 && FLAG:조직공헌LV > 11
	ADD_TRAINABLE_2 = 1
	SIF STOCK_LV < FLAG:조직공헌LV
		CALL MESSAGE_B, 3, @"%CALLNAME:MASTER%의 공헌과 활약이 평가되어、", @"시설이 강화되었습니다。", "조교실행가능횟수가 늘어났습니다。"
ENDIF
IF !ADD_DUNGEON_CHANGEABLE_1 && FLAG:조직공헌LV > 8
	ADD_DUNGEON_CHANGEABLE_1 = 1
	SIF STOCK_LV < FLAG:조직공헌LV
		CALL MESSAGE_B, 3, @"%CALLNAME:MASTER%의 공헌과 활약이 평가되어、", @"%CALLNAME:MASTER%의 터미널이 개량되었습니다。", "탐색장소변경가능횟수가 늘어났습니다。"
ENDIF
IF !ADD_DUNGEON_CHANGEABLE_2 && FLAG:조직공헌LV > 15
	ADD_DUNGEON_CHANGEABLE_2 = 1
	SIF STOCK_LV < FLAG:조직공헌LV
		CALL MESSAGE_B, 3, @"%CALLNAME:MASTER%의 공헌과 활약이 평가되어、", @"%CALLNAME:MASTER%의 터미널이 개량되었습니다。", "탐색장소변경가능횟수가 늘어났습니다。"
ENDIF
IF GET_STOCKSIZE() > STOCK_STOCKSIZE
	CALL MESSAGE_B, 3, @"%CALLNAME:MASTER%의 공헌과 활약이 평가되어、", "귀중한 ＣＯＭＰ의 강화 파츠가 보내져 왔습니다。", @"이로 인해 동료마를 스톡해 둘 수 있는 영역이 확장되었습니다。"
ENDIF
MONEY:2 = GET_PAYMENT_FOR_NEXT_RANK()
;---- EDIT P 002 ADD END ---------------------------
;---- EDIT 023 ADD START ---------------------------
;---- EDIT P 005 MOD START -------------------------
;---------------------------------------------------
;各種イベントの出現告知
;---------------------------------------------------
FOR LCOUNT, 1, DUNGEONNUM
	SIF ANNOUNCE_DUNGEON_APPEARED:LCOUNT
		CONTINUE
	IF IS_USEABLE_SHOPCOM
		TRYCCALLFORM PREREQUISITE_DUNGEON_{LCOUNT}
			SIF RESULT
				ANNOUNCE_DUNGEON_APPEARED:LCOUNT = 1
		CATCH
		ENDCATCH
	ENDIF
NEXT

FOR LCOUNT, 1, COLOSSEUMNUM
	SIF ANNOUNCE_COLOSSEUM_APPEARED:LCOUNT
		CONTINUE
	IF IS_USEABLE_SHOPCOM
		TRYCCALLFORM PLAYABLE_COLOSSEUM_{LCOUNT}
			SIF RESULT
				ANNOUNCE_COLOSSEUM_APPEARED:LCOUNT = 1
		CATCH
		ENDCATCH
	ENDIF
NEXT

FOR LCOUNT, 1, REQUESTNUM
	SIF ANNOUNCE_REQUEST_APPEARED:LCOUNT
		CONTINUE
	IF IS_USEABLE_SHOPCOM || LCOUNT == [[依頼:ＣＯＭＰ장인의도움]]
		TRYCCALLFORM PLAYABLE_REQUEST_{LCOUNT}
			SIF RESULT
				ANNOUNCE_REQUEST_APPEARED:LCOUNT = 1
		CATCH
		ENDCATCH
	ENDIF
NEXT

FOR LCOUNT, 1, EVENTNUM
	SIF ANNOUNCE_EVENT_APPEARED:LCOUNT
		CONTINUE
	IF IS_USEABLE_SHOPCOM || LCOUNT == [[이벤트:이상한손님]]
		TRYCCALLFORM PLAYABLE_EVENT_{LCOUNT}
			SIF RESULT
				ANNOUNCE_EVENT_APPEARED:LCOUNT = 1
		CATCH
		ENDCATCH
	ENDIF
NEXT
VARI SUM_ANNOUNCE = MATCH(ANNOUNCE_DUNGEON_APPEARED, 1) + MATCH(ANNOUNCE_COLOSSEUM_APPEARED, 1) + MATCH(ANNOUNCE_REQUEST_APPEARED, 1) + MATCH(ANNOUNCE_EVENT_APPEARED, 1)
IF SUM_ANNOUNCE > 4
	SIF MATCH(ANNOUNCE_DUNGEON_APPEARED, 1) > 0
		CALL MESSAGE_B(1, @"{MATCH(ANNOUNCE_DUNGEON_APPEARED, 1)}곳의 던전이 출현！")
	SIF MATCH(ANNOUNCE_COLOSSEUM_APPEARED, 1) > 0
		CALL MESSAGE_B(1, @"{MATCH(ANNOUNCE_COLOSSEUM_APPEARED, 1)}건의 투기장이 출현！")
	SIF MATCH(ANNOUNCE_REQUEST_APPEARED, 1) > 0
		CALL MESSAGE_B(1, @"{MATCH(ANNOUNCE_REQUEST_APPEARED, 1)}건의 이벤트가 출현！")
	SIF MATCH(ANNOUNCE_EVENT_APPEARED, 1) > 0
		CALL MESSAGE_B(1, @"{MATCH(ANNOUNCE_EVENT_APPEARED, 1)}건의 의뢰가 들어왔습니다。")
ENDIF
IF SUM_ANNOUNCE > 0
	FOR LCOUNT, 1, DUNGEONNUM
		SIF ANNOUNCE_DUNGEON_APPEARED:LCOUNT != 1
			CONTINUE
		ANNOUNCE_DUNGEON_APPEARED:LCOUNT = 2
		IF SUM_ANNOUNCE < 5
			CALL MESSAGE_B(1, @"던전【%GET_DUNGEON_NAME_KR(LCOUNT)%】%조사만처리(GET_DUNGEON_NAME_KR(LCOUNT),"이")% 출현！")
		ENDIF
	NEXT

	FOR LCOUNT, 1, COLOSSEUMNUM
		SIF ANNOUNCE_COLOSSEUM_APPEARED:LCOUNT != 1
			CONTINUE
		ANNOUNCE_COLOSSEUM_APPEARED:LCOUNT = 2
		IF SUM_ANNOUNCE < 5
			CALLFORM PLAYABLE_COLOSSEUM_{LCOUNT}
			CALL MESSAGE_B(1, @"투기장【%RESULTS%】%조사만처리(RESULTS,"이")% 출현！")
		ENDIF
	NEXT

	FOR LCOUNT, 1, REQUESTNUM
		SIF ANNOUNCE_REQUEST_APPEARED:LCOUNT != 1
			CONTINUE
		ANNOUNCE_REQUEST_APPEARED:LCOUNT = 2
		IF SUM_ANNOUNCE < 5
			CALLFORM PLAYABLE_REQUEST_{LCOUNT}
			CALL MESSAGE_B(1, @"의뢰【%RESULTS%】%조사만처리(RESULTS,"이")% 출현！")
		ENDIF
	NEXT

	FOR LCOUNT, 1, EVENTNUM
		SIF ANNOUNCE_EVENT_APPEARED:LCOUNT != 1
			CONTINUE
		ANNOUNCE_EVENT_APPEARED:LCOUNT = 2
		IF SUM_ANNOUNCE < 5
			CALLFORM PLAYABLE_EVENT_{LCOUNT}
			CALL MESSAGE_B(1, @"이벤트【%RESULTS%】%조사만처리(RESULTS,"이")% 출현！")
		ENDIF
	NEXT
ENDIF
;---- EDIT P 005 MOD END ---------------------------
;---- EDIT 023 ADD END   ---------------------------
;---- EDIT 005 ADD END   -------------------------
;---- EDIT 013 ADD START ---------------------------
;スキルゲージFリセット
FOR LOCAL,0,CHARANUM
	;EDIT 043
	;FOR LOCAL:1, 1, 51
	;	CFLAG:LOCAL:("스킬게이지F"+TOSTR(LOCAL:1)) = 0
	;NEXT
	CALL SKILLGAGE_ALL_CLEAR, LOCAL, 0
	;---- EDIT 022 ADD END   ---------------------------
	VARSET CFLAG:LOCAL:0, 0, 2200, 3000;EDIT 029 ADD
	;---- EDIT 028 ADD START ---------------------------

	;---- EDIT 030 ADD START ---------------------------
	VARSET C_COMMANDER_SKILL_CT:LOCAL:0
	VARSET C_ASSIST_SKILL_CT:LOCAL:0
	;---- EDIT 030 ADD END -----------------------------

	VARSET RPG_CFLAG_DUNGEON:LOCAL:0
	VARSET RPG_CSTR_DUNGEON:LOCAL:0
	VARSET ROLE_CFLAG_DUNGEON:LOCAL:0
	VARSET ROLE_CSTR_DUNGEON:LOCAL:0
	;---- EDIT 028 ADD END   ---------------------------
NEXT
;---- EDIT P 003 ADD START -------------------------
;マガツヒゲージのリセット
VARSET MAGATSUHI_GAGE_FRIEND
VARSET MAGASTUHI_GAGE_ENEMY
;---- EDIT P 003 ADD END ---------------------------

;---- EDIT 013 ADD END   ---------------------------
;---- EDIT 018 ADD START ---------------------------
CALL SKILL_TIMING,"INITIALIZE"
;---- EDIT 018 ADD END   ---------------------------
;---- EDIT 015 ADD START ---------------------------
;行動順リセット
FOR LOCAL, 0, 16
	LOCALS = 행동순{LOCAL+1}
	FLAG:LOCALS = -1
NEXT
;---- EDIT 015 ADD END   ---------------------------
CUSTOMDRAWLINE =
LOCAL:1 = 0
LOCAL:2 = 0
LOCAL:3 = 0
LOCAL:4 = 0
LOCAL:5 = 0
LOCAL:6 = 0
LOCAL:7 = 0
LOCAL:8 = 0
VARSET コマンドストック , 0
;---- EDIT 025 MOD SHOPコマンド変数変更 START ------
;戦闘用のフラグも折っておく
VARSET TFLAG, 0, 100, 800
VARSET SHOP_ABLE
;---- EDIT 025 MOD SHOPコマンド変数変更 END --------
SIF FLAG:대기표시위치 == 0 && FLAG:대기이용설정 < 2
	CALL SHOW_SUB_TARGET
;ショップ画面の描写
CALL SHOW_SHOP_INFO

FOR LOCAL, 100, 1000
	RESULTS = 
	RESULT:1 = 0
	TRYCCALLFORM SHOPCOMABLE_{LOCAL}
		IF RESULT > -1
			IF RESULTS != ""
				IF RESULT:1 < 1
					SIF LOCAL < 180
						RESULT:1 = 5
					SIF LOCAL >= 180 && 200 > LOCAL
						RESULT:1 = 6
					SIF LOCAL >= 200
						RESULT:1 = 7
				ENDIF
				IF RESULT > 0
					SHOP_ABLE:LOCAL = 1
				ENDIF
				コマンドストック:(RESULT:1):(LOCAL:(RESULT:1)) = LOCAL
				コマンドストック名:(RESULT:1):(LOCAL:(RESULT:1)) = %RESULTS%
				LOCAL:(RESULT:1) ++
			ENDIF
		ENDIF
	CATCH
		
	ENDCATCH
NEXT

VARI L_CNT
VARS TEMPS
VARS SHOW_LINE
FOR L_CATEGORY, 1, 8
	SIF コマンドストック:L_CATEGORY:0 == 0
		CONTINUE
	SELECTCASE L_CATEGORY
		CASE 1
			SETCOLOR 0xffaa11
			PRINTFORML 【RPG・진행】
		CASE 2
			SETCOLOR 0xff00ff
