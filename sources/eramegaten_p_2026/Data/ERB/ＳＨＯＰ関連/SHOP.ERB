		ENDIF
	ELSEIF TALENT:ARG:임신
		L_RESULTS += SET_COLOR_TAG("임신중", "#CC33FF")
	ELSE
		L_RESULTS += "　　　"
	ENDIF
ELSE
	IF ARG != MASTER && CHECK_CHILD_CARE(ARG) && FLAG:출산기능ONOFF
		L_RESULTS += "［육아실］"
	ELSEIF ARG == MASTER && CHECK_CHILD_CARE(ARG) && FLAG:출산기능ONOFF && !GROUPMATCH(위험일(ARG), -2, 2, 3)
		L_RESULTS += "［육아실］"
	ELSEIF GROUPMATCH(위험일(ARG), -2, 1, 2, 3)
		IF TALENT:ARG:임신 && 위험일(ARG) == 1
			L_RESULTS += "（임신중）"
		ELSE
			L_RESULTS += " " + HEARTB_HTML(0xCC33FF)
			IF 위험일(ARG) == 1
				L_RESULTS += SET_COLOR_TAG("위험일", "#CC33FF")
			ELSE
				L_RESULTS += SET_COLOR_TAG("발정중", "#CC33FF")
			ENDIF
			L_RESULTS += HEARTB_HTML(0xCC33FF)
		ENDIF
	ELSEIF TALENT:ARG:임신
		L_RESULTS += "（임신중）"
	ELSE
		L_RESULTS += "　　　　　"
	ENDIF
ENDIF
RETURNF L_RESULTS
