;この時点で5,000円以上なら(所持金-5,000)×0.7
繰越所持金 = TABLE_CALC2(繰越所持金, 5000, 70)
;この時点で10,000円以上なら(所持金-10,000)×0.6
繰越所持金 = TABLE_CALC2(繰越所持金, 10000, 60)
;この時点で25,000円以上なら(所持金-25,000)×0.5
繰越所持金 = TABLE_CALC2(繰越所持金, 25000, 50)
;この時点で50,000円以上なら(所持金-50,000)×0.25
繰越所持金 = TABLE_CALC2(繰越所持金, 50000, 25)
;この時点で100,000円以上なら(所持金-100,000)×0.1
繰越所持金 = TABLE_CALC2(繰越所持金, 100000, 10)
MONEY = 繰越所持金
;ＥＤ発見と称号発見毎に+2000の初期所持金
;周回するたびに+500の初期所持金
;ただし周回ボーナスの最高額は100万までとする(そこまで周回を重ねるのも困難な話だが)
;3500円保障
MONEY += 1000 + 2000 * (ＥＤ発見数 + 称号発見数 + 1)
MONEY += MIN(500 * FLAG:주회횟수, 1000000)

;マッカ
;魔貨：基本的に所持金と同じ処理(20, 50, 100, 200, 500, 1000, 2000で倍率変更)
繰越マッカ = MONEY:1 / 100
繰越マッカ = TABLE_CALC2(繰越マッカ, 20, 90)
繰越マッカ = TABLE_CALC2(繰越マッカ, 50, 80)
繰越マッカ = TABLE_CALC2(繰越マッカ, 100, 70)
繰越マッカ = TABLE_CALC2(繰越マッカ, 200, 60)
繰越マッカ = TABLE_CALC2(繰越マッカ, 500, 50)
繰越マッカ = TABLE_CALC2(繰越マッカ, 1000, 25)
繰越マッカ = TABLE_CALC2(繰越マッカ, 2000, 10)
MONEY:1 = 繰越マッカ
;ＥＤ発見と称号発見毎に+25の初期所持魔貨
;周回するごとに発見ＥＤ×周回数×5の初期所持魔貨
;ただし周回ボーナスの最高額は100万までとする(そこまで周回を重ねるのも困難な話だが)
MONEY:1 += 25 * (ＥＤ発見数 + 称号発見数)
