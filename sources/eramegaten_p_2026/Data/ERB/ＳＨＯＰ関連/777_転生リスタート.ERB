@CHECK_ED_POINT(ARGS)
#FUNCTION
SELECTCASE ARGS
CASE "調教アイテム引き継ぎ","消費アイテム引き継ぎ","特殊アイテム入手","ＣＯＭＰ容量増加1", "조직공헌LV"
	RETURNF 1
CASE "素材アイテム引き継ぎ"
	RETURNF 2
CASE "武具アイテム引き継ぎ","防具アイテム引き継ぎ"
	RETURNF 3
CASE "インストールソフト引き継ぎ", "スキルエミュレータ引き継ぎ","ＣＯＭＰ容量増加2"
	RETURNF 4
CASE "魔晶武器引き継ぎ","経験値引き継ぎ"
	RETURNF 5
CASE "受胎アイテムリセット"
	RETURNF 10
CASE "ＣＯＭＰ容量増加3"
	RETURNF 16
ENDSELECT
RETURNF 666

