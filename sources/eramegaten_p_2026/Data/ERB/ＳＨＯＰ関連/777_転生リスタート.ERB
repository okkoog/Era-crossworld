@NEWGAME_BONUS
#DIM LCOUNT, 2
#DIM L_LINE
#DIMS SHOW_LINE
#DIMS L_TITLE
#DIM L_SELECT
REDRAW 0
L_LINE = LINECOUNT
L_SELECT = -1
$BONUS_TOP
RESETCOLOR
DRAWLINE
;PRINTFORML 引き継ぐ要素を選択してください
PRINTFORML 획득할 보너스를 선택해주세요
PRINTFORML 현재 EP(Ending Point)를 {COUNT_ENDING_POINT()}점 소유중입니다
;PRINTFORML 選択中の要素を引き継ぐには{REQUIRE_ENDING_POINT()}ポイント必要です
PRINTFORML 선택중인 보너스를 획득하려면 {REQUIRE_ENDING_POINT()}포인트 필요합니다
IF GET_UNUSE_ENDING_BONUS() < 0
	PRINTFORML 필요한 EP가 부족합니다
ELSEIF GET_UNUSE_ENDING_BONUS() > 0
	PRINTFORML 남은 EP는 {GET_UNUSE_ENDING_BONUS()*6}개의 향이 됩니다。
ELSE
	PRINTL 
ENDIF
DRAWLINE
IF L_SELECT < 0
	FOR LCOUNT, 0, 6
		PRINTL 
	NEXT
ELSE
	PRINTFORML □%GETBIT_BONUS_NAME_KR(L_SELECT)%
	FOR LCOUNT, 0, 5
		PRINTFORML %" " * 2 + RESULTS_F:(LCOUNT + 2)%
	NEXT
ENDIF
;SETCOLOR COLOR("RED")
;PRINTFORML ※条件に依らず引き継がれる／引き継がれないアイテムもあります
RESETCOLOR
DRAWLINE
FOR LCOUNT,0,64
	SIF GETBIT_BONUS_NAME(LCOUNT) == "NONE"
		CONTINUE
	SHOW_LINE = [{LCOUNT, 2}] %GETBIT_BONUS_NAME_KR(LCOUNT),30,LEFT%\({CHECK_ED_POINT(GETBIT_BONUS_NAME(LCOUNT)), 2}EP\)　
	L_TITLE = 
	FOR LCOUNT:1, 2, 2 + 5 + 1
		SIF RESULTS_F:(LCOUNT:1) == ""
			CONTINUE
		SIF L_TITLE != ""
			L_TITLE += UNICODE(0x000D)
		L_TITLE += RESULTS_F:(LCOUNT:1)
	NEXT
	;LOCALS = %GETBIT_BONUS_NAME(LOCAL),12,LEFT%\({CHECK_ED_POINT(GETBIT_BONUS_NAME(LOCAL))}EP\)
	IF GETBIT(FLAG:주회보너스,LCOUNT)
		SHOW_LINE += RESULTS_F
		SHOW_LINE = %SET_COLOR_TAG(SHOW_LINE, "aqua")%
		;SETCOLOR COLOR("AQUA")
		;PRINTFORML [{LOCAL,2}] %LOCALS,20,LEFT% 引き継ぐ
	ELSE
		SHOW_LINE += RESULTS_F:1
		;PRINTFORML [{LOCAL,2}] %LOCALS,20,LEFT% 引き継がない
	ENDIF
	SHOW_LINE = %SET_BUTTON_TAG(SHOW_LINE, TOSTR(LCOUNT), L_TITLE)%
	HTML_PRINT SHOW_LINE
	;RESETCOLOR
NEXT
PRINTFORML [98] 리셋
IF COUNT_ENDING_POINT()-REQUIRE_ENDING_POINT() < 0
	PRINTFORML [99] EP가 부족합니다
ELSE
	PRINTFORML [99] 설정완료
ENDIF
$INPUT_LOOP
INPUT
IF RESULT == 99 && COUNT_ENDING_POINT()-REQUIRE_ENDING_POINT() >= 0
	REDRAW 0
	RETURN
ELSEIF RESULT == 98
	FLAG:주회보너스 = 0
ELSEIF GETBIT_BONUS_NAME(RESULT) != "NONE"
	L_SELECT = RESULT
	INVERTBIT FLAG:주회보너스,RESULT
ENDIF
CLEARLINE LINECOUNT-L_LINE
GOTO BONUS_TOP
