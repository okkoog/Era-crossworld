;ボーナスが付くもの
;主人初期能力、初期ＣＯＭＰ容量、初期所持金、初期店人気
;=================================================================


@SHOPCOMABLE_777
RESULT:1 = 7
RESULTS = 환생리스타트
SIF FLAG:게임모드 == 9 || DAY > 50
	RETURN 1
RETURN 0
;---- EDIT 068 MOD START -------------------------
@SHOP_COM_777, ARG, ARGS
IF ARGS == "強制ニューゲーム"
	RESULT = 0
ELSE
	PRINTFORML 극히 일부 데이터를 인계하여, 새롭게 게임을 시작하겠습니까?
	PRINTL [0]시작한다 [1]그만둔다
	$INPUT_LOOP
	INPUT
ENDIF
IF RESULT == 1
	RETURN 0
ELSEIF RESULT == 0
	CALL START_NEWGAME
	RETURN 1
ELSE
	GOTO INPUT_LOOP
ENDIF
;---- EDIT 068 MOD END ---------------------------

;=================================================================
;引継ぎ処理
;=================================================================
@START_NEWGAME
#DIM LCOUNT
#DIM L_CHARA
#DIM DYNAMIC ＥＤ発見数
#DIM DYNAMIC 称号発見数
#DIM DYNAMIC ステータスボーナス
#DIM DYNAMIC 最大ステータスボーナス
#DIM DYNAMIC 繰越所持金
#DIM DYNAMIC 繰越マッカ
#DIM TEMP
;---- EDIT 068 ADD START -------------------------
FLAG:전생리스타트예약 = 0
;---- EDIT 068 ADD END ---------------------------
ＥＤ発見数 = COUNT_ENDING_POINT()
称号発見数 = COUNT_TITLE_POINT()

;周回回数を+1
SIF FLAG:게임모드 == 9
	FLAG:주회횟수 += 1
FLAG:경험ED수 = 0
FOR LOCAL,0,64
	SIF GETBIT(FLAG:발견ED , LOCAL)
		FLAG:경험ED수 ++
NEXT
FOR LOCAL,0,64
	SIF GETBIT(FLAG:발견ED2 , LOCAL)
		FLAG:경험ED수 ++
NEXT
FOR LOCAL,0,64
	SIF GETBIT(FLAG:발견ED3 , LOCAL)
		FLAG:경험ED수 ++
NEXT

PRINTL 주회 보너스를 설정하시겠습니까？
IF REQUIRE_ENDING_POINT()
	PRINTFORML [0] 설정을 변경한다 (현재 EP:{REQUIRE_ENDING_POINT()}/{COUNT_ENDING_POINT()}사용)
	PRINTFORML [1] 변경하지 않는다
ELSE
	PRINTFORML [0] 설정한다 (현재 EP:{COUNT_ENDING_POINT()})
	PRINTFORML [1] 설정하지 않는다
ENDIF
$LOOP_BONUS
INPUT
SELECTCASE RESULT
CASE 0
	CALL NEWGAME_BONUS
CASE 1
CASEELSE
	CLEARLINE 1
	GOTO LOOP_BONUS
ENDSELECT


;-----------------------------------------------------------------
;引き継がないものを初期化
;主人以外のキャラを削除
;-----------------------------------------------------------------
;先に、削除しないキャラを選択することも出来る。

;---- EDIT 067 MOD START -------------------------
;全員の装備を外す
;なんらかの理由でいないキャラは除外
FOR L_CHARA,0,CHARANUM
	SIF CFLAG:L_CHARA:이자리에없는플래그
		CONTINUE
	;装備解除はキャラ削除でも引き継ぎキャラ個別処理でも実行するため、ここでは省略
	;CALL 全装備解除(L_CHARA)
	;ペルソナをすべて剥がす
	IF TALENT:L_CHARA:페르소나구사자
		;ペルソナはがし
		FOR LCOUNT, 1, 3
			IF EQUIP:L_CHARA:@"소지페르소나{LCOUNT}"
				CALL PERSONA_UNEQUIPMENT(L_CHARA, EQUIP:L_CHARA:@"소지페르소나{LCOUNT}")
			ENDIF
		NEXT
	ENDIF
NEXT
;---- EDIT 067 MOD END ---------------------------

CALL SELECT_YOME

FOR LOCAL,CHARANUM-1,0,-1
	SIF CFLAG:LOCAL:인계플래그 == 0
		CALL キャラ削除(LOCAL)
NEXT
CALL REFRESH_POS

;引き継いだキャラのレベルを人間なら5、悪魔なら1にして能力をＣＳＶから読み込んでからレベルに合わせて増減、習得スキルをＣＳＶから再読み込み。引継ぎフラグに応じて素質や能力変更
FOR LOCAL,1,CHARANUM
	CFLAG:LOCAL:인계횟수 += 1
	CALL SET_TALENT_PARTY_JOINABLE, LOCAL, "参加可能"
	CALL SHOP_NEWGAME_INITCHARA, LOCAL
NEXT
