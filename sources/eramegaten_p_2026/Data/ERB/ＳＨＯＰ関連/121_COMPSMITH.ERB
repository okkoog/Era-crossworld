DRAWLINE
PRINTFORML {LIMIT_PRICE}마카까지의 에뮬레이터를 무상으로 받을 수 있습니다
DRAWLINE

;---------------------------------------------------
;販売リストの作成
;---------------------------------------------------
VARSET SELL_LIST
VARSET BUY_UNABLE

FOR LCOUNT, 0, SKILL_EMULATOR_NUM
	;名称未定義は弾く
	SIF GET_SKILL_EMULATOR_NAME(LCOUNT) == ""
		CONTINUE
	;所持しているエミュレータは省く
	SIF HAVE_SKILL_EMULATOR:LCOUNT
		CONTINUE
	;販売条件チェック
	TRYCCALLFORM SKILL_EMULATOR_SELLABLE_{LCOUNT}
		SIF !RESULT
			CONTINUE
	CATCH
		CONTINUE
	ENDCATCH
	CALLFORM SKILL_EMULATOR_PRICE_{LCOUNT}
	;指定金額を超えている場合は外す
	SIF RESULT > LIMIT_PRICE
		CONTINUE
	;販売にリストに登録
	SELL_LIST:FINDELEMENT(SELL_LIST, 0) = LCOUNT
NEXT

;---------------------------------------------------
;商品の表示
;---------------------------------------------------
LCOUNT:2 = 0
FOR LCOUNT, 0, SHOWNUM
	LISTNUM = LCOUNT + L_PAGE * SHOWNUM
	L_EMU = SELL_LIST:LISTNUM
	SIF !L_EMU
		CONTINUE
	;カラーセット
	IF L_EMU == SELECT_EMU
		L_COLOR = %TOSTR_HTML(COLOR("aqua"))%
	ELSE
		L_COLOR = %TOSTR_HTML(GETDEFCOLOR())%
	ENDIF
	CALLFORM SKILL_EMULATOR_PRICE_{L_EMU}
	L_PRICE = RESULT
	L_PRICES = {L_PRICE, 7} 마카
	VARSET RESULTS, "", 0, 11
	L_TITLE = 
	CALL SET_VAR_SKILL_EMULATOR_EXPLAIN, L_EMU, L_TITLE;EDIT 002 ADD
	CALLFORM SKILL_EMULATOR_EXPLAIN_{L_EMU}
	;長過ぎる場合の代替テキスト
	SIF RESULTS:10 != ""
		RESULTS = %RESULTS:10%
	SHOW_LINE = <button value = '{LISTNUM + 100 }' title = '%L_TITLE%'><font color = '%L_COLOR%'>
	SHOW_LINE += @"[{LISTNUM + 100}] %GET_SKILL_EMULATOR_NAME(L_EMU), 28, LEFT%" + L_PRICES
	SHOW_LINE += "</font>" + "</button>"
	SHOW_LINE += "　　　" + @"<font color = '%L_COLOR%'>" + RESULTS + "</font>"
	HTML_PRINT SHOW_LINE
NEXT
WHILE LINECOUNT < L_LINE + SHOWNUM + 3
	PRINTFORML 
WEND

;ページ部分の表示
PRINTL 
IF SELL_LIST:SHOWNUM
	FOR LCOUNT, 0, 5
		SIF !SELL_LIST:(LCOUNT * SHOWNUM)
			CONTINUE
		CALL PRINT_COLOR, @"[{10 + LCOUNT}] Page.{LCOUNT}　　　" , LCOUNT == L_PAGE ? COLOR("aqua") # GETDEFCOLOR()
	NEXT
ENDIF
PRINTL 
DRAWLINE
SHOW_LINE = 
L_LINE:1 = LINECOUNT
IF SELECT_EMU > 0
	PRINTFORML %GET_SKILL_EMULATOR_NAME(SELECT_EMU)%
	CALL SET_VAR_SKILL_EMULATOR_EXPLAIN, SELECT_EMU, L_TITLE
	CALL PRINTFORM_LF, L_TITLE
ENDIF
WHILE LINECOUNT < L_LINE:1 + 6
	PRINTFORML 
WEND
HTML_PRINT SHOW_LINE
L_LINE:2 = LINECOUNT
CALL PRINT_COLOR, "[ 0] 교환한다", SELECT_EMU > 0 ? GETDEFCOLOR() # COLOR("DARK-GRAY")
PRINTL 　　　[ 9] 돌아간다　　　　　　
INPUT
SELECTCASE RESULT
	CASE 0
		IF SELECT_EMU > 0
			CALL ADD_SKILL_EMULATOR, SELECT_EMU
			CLEARLINE LINECOUNT - L_LINE:1
			PRINTFORML 토템메모리와 스킬에뮬레이터를 교환했습니다。
			ITEM:토템메모리 -= 1
			COUNT_TRADE_TOTEM_MEMORY++
			WHILE LINECOUNT < L_LINE:2
				PRINTL 
			WEND
			PRINTFORM [0] 교환한다
			PRINTW 　　　[9] 돌아간다
			RETURN 1
		ENDIF
	CASE 9
		REDRAW L_REDRAW
		RETURN 0
	;ページの切り替え
	CASE 10 TO 10 + ((VARSIZE("SELL_LIST") -1) / SHOWNUM)
		RESULT -= 10
		SIF SELL_LIST:(RESULT * SHOWNUM) >= 0
			L_PAGE = RESULT
	CASE 100 TO 100 + VARSIZE("SELL_LIST")
		RESULT -= 100
		IF SELL_LIST:RESULT >= 0
			IF SELL_LIST:RESULT == SELECT_EMU
				CLEARLINE LINECOUNT - L_LINE:1
				PRINTFORML %조사처리(GET_SKILL_EMULATOR_NAME(SELECT_EMU),"와")% 교환합니까？
				PRINTL [0] 네
				PRINTL [9] 아니오
				WHILE LINECOUNT < L_LINE:2 + 2
					PRINTL 
				WEND
				CALL INPUTINT, 0, 1, 9
				IF RESULT == 0
					CALL ADD_SKILL_EMULATOR, SELECT_EMU
					CLEARLINE LINECOUNT - L_LINE:1
					PRINTFORML %조사처리(GET_SKILL_EMULATOR_NAME(SELECT_EMU),"와")% 교환했습니다。
					ITEM:토템메모리 -= 1
					COUNT_TRADE_TOTEM_MEMORY++
					SELECT_EMU = -1
					WHILE LINECOUNT < L_LINE:2
						PRINTL 
					WEND
					PRINTFORM [0] 교환한다
					PRINTW 　　　[9] 돌아간다
					RETURN 1
				ENDIF
			ELSE
				SELECT_EMU = SELL_LIST:RESULT
			ENDIF
		ENDIF
ENDSELECT
GOTO START

