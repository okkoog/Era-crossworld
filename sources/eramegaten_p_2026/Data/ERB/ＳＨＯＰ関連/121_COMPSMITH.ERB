@SHOPCOMABLE_121
RETURN 0

@SHOP_COM_121, ARG
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_LINE
IF !IS_VISITED_COMP_SMITH
	CALL FIRST_IN_COMP_SMITH
ENDIF
L_LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - L_LINE
DRAWLINE
PRINTFORM ＣＯＭＰ ＳＭＩＴＨ 　　　　ＣＯＭＰ용량:{GET_COMPSIZE()}　　　　마카:{MONEY:1}
SIF COUNT_TRADE_TOTEM_MEMORY < 4
	PRINTFORM 　　　　　토템메모리:{ITEM:토템메모리}
PRINTL 
DRAWLINE
VARI MES_LINE = LINECOUNT
FOR LCOUNT, 0, 7
	PRINTL 
NEXT
DRAWLINE
PRINTBUTTON "[1] 인스톨소프트와 교환", "1"
PRINTL 
PRINTBUTTON "[2] 스킬에뮬레이터와 교환", "2"
PRINTL 
PRINTBUTTON @"[3] ＣＯＭＰ 용량 확장 (필요 마카：{GET_COST_FOR_COMP_SIZEUP()})", "3_MOUSE"
PRINTL 
PRINTBUTTON "[4] 인스톨소프트 셋업", "4"
PRINTL 
PRINTBUTTON "[5] 스킬에뮬레이터 셋업", "5"
PRINTL 
IF COUNT_TRADE_TOTEM_MEMORY < 4
	SIF ITEM:토템메모리 == 0
		SETCOLOR COLOR("gray")
	PRINTBUTTON "[6] 토템메모리와 인스톨소프트를 교환", "6"
	PRINTL 
	PRINTBUTTON "[7] 토템메모리와 스킬에뮬레이터를 교환", "7"
	PRINTL 
	PRINTBUTTON "[8] 토템메모리와 교환해 ＣＯＭＰ 용량을 확장", "8_MOUSE"
	PRINTL 
	RESETCOLOR
ENDIF
DRAWLINE
CALL GET_TALK_BY_ADDRESS, "타타라짱", "tataratang", "어서와_오늘은 무슨일이야？"
HTML_PRINT SET_BUTTON_TAG("[0] 돌아간다", "0") + @"<div display = 'absolute-leftbottom' xpos = '60' ypos = '{(MES_LINE - LINECOUNT - 1) * 100}'>" + RESULTS + "</div>"
$INPUT_LOOP
ONEINPUTS
VARI L_RESULT
L_RESULT = TOINT(AUTO_SPLIT(RESULTS, "_", 0))
VARI IS_MOUSE
IS_MOUSE = AUTO_SPLIT(RESULTS, "_", 1) == "MOUSE"
CLEARLINE 2
SIF ITEM:토템메모리 <= 0 && INRANGE(L_RESULT, 6, 8)
	GOTO START
SELECTCASE L_RESULT
	CASE 0
		CALL GET_TALK_BY_ADDRESS, "타타라짱", "tataratang", "COMP를 좀 손보고 싶어졌다! 싶으면 언제든 다시 오라구"
		HTML_PRINT SET_BUTTON_TAG("[0] 돌아간다", "0") + @"<div display = 'absolute-leftbottom' xpos = '60' ypos = '{(MES_LINE - LINECOUNT - 1) * 100}'>" + RESULTS + "</div>"
		WAIT
		RETURN 0
	CASE 1
		CALL GET_TALK_BY_ADDRESS, "타타라짱", "tataratang", "좋아, COMP에 추가하고 싶은 소프트를 골라봐"
		HTML_PRINT SET_BUTTON_TAG("[0] 돌아간다", "0") + @"<div display = 'absolute-leftbottom' xpos = '60' ypos = '{(MES_LINE - LINECOUNT - 1) * 100}'>" + RESULTS + "</div>"
		WAIT
		CLEARLINE 1
		CALL EXCHANGE_SOFT
	CASE 2
		IF GET_SUMMONER_MLV() < 3
			CALL GET_TALK_BY_ADDRESS, "타타라짱", "tataratang", "에뮬레이터를 추가하는 건 상관없지만_파티에 서머너 기능이 Lv3 이상인 녀석이 없으면_의미 없으니까 조심하라구?"
		ELSE
			CALL GET_TALK_BY_ADDRESS, "타타라짱", "tataratang", "원하는 에뮬레이터를 골라봐"
		ENDIF
		HTML_PRINT SET_BUTTON_TAG("[0] 돌아간다", "0") + @"<div display = 'absolute-leftbottom' xpos = '60' ypos = '{(MES_LINE - LINECOUNT - 1) * 100}'>" + RESULTS + "</div>"
		WAIT
		CLEARLINE 1
		CALL EXCHANGE_SKILL_EMULATOR
	CASE 3, 8
		IF L_RESULT == 3 && GET_COST_FOR_COMP_SIZEUP() > MONEY:1
			CALL GET_TALK_BY_ADDRESS, "타타라짱", "tataratang", "마카가 부족하잖아_공교롭게도 난 헐값에 넘기지 않는 주의라서 말이지._미안하지만 대금을 제대로 마련해와 줘"
			HTML_PRINT SET_BUTTON_TAG("[0] 돌아간다", "0") + @"<div display = 'absolute-leftbottom' xpos = '60' ypos = '{(MES_LINE - LINECOUNT - 1) * 100}'>" + RESULTS + "</div>"
			WAIT
			CLEARLINE 1
		ELSE
			IF L_RESULT == 3
				CALL GET_TALK_BY_ADDRESS, "타타라짱", "tataratang", @"{GET_COST_FOR_COMP_SIZEUP()} 마카를 받을 텐데,_정말 용량을 늘려도 괜찮겠어?"
			ELSE
				CALL GET_TALK_BY_ADDRESS, "타타라짱", "tataratang", @"토템메모리 1개와 교환인데,_정말 용량을 늘려도 괜찮겠어?"
			ENDIF
			VARS L_MES
			IF IS_MOUSE
				L_MES '= SET_BUTTON_TAG("[0] 돌아간다", "0")
				HTML_PRINT L_MES + @"<div display = 'absolute-leftbottom' xpos = '60' ypos = '{(MES_LINE - LINECOUNT - 1) * 100}'>" + RESULTS + "</div>"
				CALL INPUT_YN_POPUP
			ELSE
				L_MES '= SET_BUTTON_TAG("[0] 예", "0") + "　" + SET_BUTTON_TAG("[1] 아니오", "1")
				HTML_PRINT L_MES + @"<div display = 'absolute-leftbottom' xpos = '60' ypos = '{(MES_LINE - LINECOUNT - 1) * 100}'>" + RESULTS + "</div>"
				ONEINPUT
				CLEARLINE 1
			ENDIF
			CLEARLINE 1
			IF RESULT == 0
				IF L_RESULT == 3
					MONEY:1 -= GET_COST_FOR_COMP_SIZEUP()
				ELSE
					COUNT_TRADE_TOTEM_MEMORY += 1
					ITEM:토템메모리 -= 1
				ENDIF
				FLAG:마카에의한Ｃ용량증가 += 1
				CALL GET_TALK_BY_ADDRESS, "타타라짱", "tataratang", "오케이_잠깐만 기다려봐…"
				HTML_PRINT L_MES + @"<div display = 'absolute-leftbottom' xpos = '60' ypos = '{(MES_LINE - LINECOUNT - 1) * 100}'>" + RESULTS + "</div>"
				WAIT
				CLEARLINE 1
				CALL GET_TALK_BY_ADDRESS, "", "BLANK_IMG", "＞COMP의 용량이 증가했다!"
				HTML_PRINT L_MES + @"<div display = 'absolute-leftbottom' xpos = '60' ypos = '{(MES_LINE - LINECOUNT - 1) * 100}'>" + RESULTS + "</div>"
				WAIT
				CLEARLINE 1
				HTML_PRINT L_MES + @"<div display = 'absolute-leftbottom' xpos = '60' ypos = '{(MES_LINE - LINECOUNT - 1) * 100}'>" + RESULTS + "</div>"
				WAIT
			ELSE
				CALL GET_TALK_BY_ADDRESS, "타타라짱", "tataratang", "그래? 아직 무슨 볼일 있어?"
				HTML_PRINT L_MES + @"<div display = 'absolute-leftbottom' xpos = '60' ypos = '{(MES_LINE - LINECOUNT - 1) * 100}'>" + RESULTS + "</div>"
				WAIT
			ENDIF
		ENDIF
	CASE 4
		CALL SETUP_SOFT
	CASE 5
		CALL EQUIP_SKILL_EMULATOR_MAIN_UI
	CASE 6
		CALL TAKE_FREE_INSTALLSOFT, COUNT_TRADE_TOTEM_MEMORY ? 1000 # 200
	CASE 7
		CALL TAKE_FREE_SKILL_EMULATOR, COUNT_TRADE_TOTEM_MEMORY ? 1000 # 200
	CASEELSE
		GOTO INPUT_LOOP
ENDSELECT
IF COUNT_TRADE_TOTEM_MEMORY == 4
	CALL FINISHED_EVENT_IN_COMP_SMITH
ENDIF
GOTO START

@GET_COST_FOR_COMP_SIZEUP, ARG = -1
#FUNCTION 
SIF ARG == -1
	ARG = FLAG:마카에의한Ｃ용량증가 + 1
RETURNF SQRT(POWER(ARG, 3)) * 100

@EXCHANGE_SOFT
#DIM LCOUNT, 3
#DIM L_LINE,3
#DIMS TEMPS
#DIM SELL_LIST, 60
#DIM BUY_UNABLE, 60
#DIM BUY_LIST, 60
#DIM SELECT_BUYNUM
#DIM SELECT_SOFT
#DIMS SELECT_TYPE
#DIMS L_TEXT
#DIMS L_BUTTON
#DIMS L_TITLE
#DIM L_PRICE
#DIM L_PRICE_SUM
#DIMS L_PRICES
#DIMS SHOW_LINE
#DIM CONST SHOWNUM = 20
#DIM L_SOFT
#DIM L_PAGE
#DIMS L_COLOR
#DIM LISTNUM
#DIM L_REDRAW
#DIMS BEGINNER_TIPS, 7

L_REDRAW = CURRENTREDRAW()
REDRAW 0

VARSET BUY_LIST, -1
VARSET BEGINNER_TIPS
L_LINE = LINECOUNT
SIF SELECT_TYPE == ""
	SELECT_TYPE = 탐색보조
SELECT_BUYNUM = -1
SELECT_SOFT = -1
L_PAGE = 0
$START
CLEARLINE LINECOUNT - L_LINE
DRAWLINE
PRINTFORML 인스톨소프트
DRAWLINE
VARSET SELL_LIST, -1
VARSET BUY_UNABLE, -1
IF SELECT_TYPE == "Ｐ・Ｓ추천"
	SELL_LIST:0 = GET_INSTALLSOFT_NUM("하쿠타로우")
	BEGINNER_TIPS:0 = 백어택은 최악의 경우 아무것도 못하고 전멸당할 수도 있는 위험이 있다./그것을 막는 것은 이 업계에서 살아가는 데 있어 거의 필수라고 해도 과언이 아니다./물론 백어택 따위 신경 쓰지 않을 정도로 강해진다면 필요 없어지겠지만…
	SELL_LIST:1 = GET_INSTALLSOFT_NUM("ＤＤＭ")
	BEGINNER_TIPS:1 = 한 번 거점으로 돌아갈 필요는 있지만 합체용 소재 악마를 대량으로 준비할 수 있게 된다./전력 확충을 위한 선택지가 크게 늘어나므로 도입을 강력히 권장한다.
	SELL_LIST:2 = GET_INSTALLSOFT_NUM("DDS-DUO")
	BEGINNER_TIPS:2 = 악마를 유연하게 운용할 수 있게 해주는 대단히 강력한 소프트./어느 정도 쓸 만한 동료마의 수가 필요하지만, 성능은 보증되어 있다.
	SELL_LIST:3 = GET_INSTALLSOFT_NUM("백어퍼")
	BEGINNER_TIPS:3 = 대단히 비용은 무겁지만 시간과 노력의 손실을 최소한으로 줄일 수 있다./도입에 따른 부담은 크지만 리턴은 충분할 것이다.
	SELL_LIST:4 = GET_INSTALLSOFT_NUM("화이트앨범")
	BEGINNER_TIPS:4 = 주로 소재가 되는 악마의 성장에 유용한 소프트./성장한 악마가 가져오는 스킬이 전력 확충에 도움이 될 것이다.
	SELL_LIST:5 = GET_INSTALLSOFT_NUM("하모나이저")
	BEGINNER_TIPS:5 = 용량 소비가 크고, 악마를 운용하는 데는 문제가 따르지만 전력의 강화 폭은 크다./악마보다 인간을 메인으로 부린다면 유력한 소프트라고 할 수 있다.
	SELL_LIST:6 = GET_INSTALLSOFT_NUM("デビルチェンバー")
	BEGINNER_TIPS:6 = 갓 입문한 초보 서머너를 위한 소프트./빈약한 COMP라도 많은 인스톨소프트를 도입하기 쉬워진다.
ELSE
	FOR LCOUNT, 0, INSTALLSOFTNUM
		;名称未定義は弾く
		SIF GET_INSTALLSOFT_NAME(LCOUNT) == ""
			CONTINUE
		;タイプチェック
		TRYCCALLFORM INSTALLSOFT_TYPE_{LCOUNT}
			SIF RESULTS != SELECT_TYPE
				CONTINUE
		CATCH
		ENDCATCH
		;販売条件チェック
		TRYCCALLFORM INSTALLSOFT_SELLABLE_{LCOUNT}
			SIF !RESULT
				CONTINUE
		CATCH
			CONTINUE
		ENDCATCH
		;販売にリストに登録
		SELL_LIST:FINDELEMENT(SELL_LIST, -1) = LCOUNT
	NEXT
ENDIF

;---------------------------------------------------
;代金の取得
;---------------------------------------------------
L_PRICE_SUM = 0
LCOUNT = 0
WHILE BUY_LIST:LCOUNT >= 0
	;---- EDIT 018 ADD START -------------------------
	;持ってるソフトは価格に加算しない
	IF !HAVE_INSTALLSOFT:(BUY_LIST:LCOUNT)
		CALLFORM INSTALLSOFT_PRICE_{BUY_LIST:LCOUNT}
		L_PRICE_SUM += RESULT
	ENDIF
	LCOUNT++
	;---- EDIT 018 ADD END ---------------------------
WEND
;---------------------------------------------------
;商品の表示
;---------------------------------------------------
LCOUNT:2 = 0
FOR LCOUNT, 0, SHOWNUM
	LISTNUM = LCOUNT + L_PAGE * SHOWNUM
	L_SOFT = SELL_LIST:LISTNUM
	SIF L_SOFT < 0
		CONTINUE
	;デフォルトカラーセット
	L_COLOR = %TOSTR_HTML(GETDEFCOLOR())%
	;所持しているソフト
	IF HAVE_INSTALLSOFT:L_SOFT
		BUY_UNABLE:FINDELEMENT(BUY_UNABLE, -1) = L_SOFT
		L_COLOR = %TOSTR_HTML(COLOR("DARK-GRAY"))%
		L_PRICES = 　　취득완료
	ELSE
		CALLFORM INSTALLSOFT_PRICE_{L_SOFT}
		L_PRICE = RESULT
		;購入予定リストに入っている場合
		IF FINDELEMENT(BUY_LIST, L_SOFT) >= 0
			L_COLOR = %TOSTR_HTML(L_SOFT == SELECT_SOFT ? COLOR("aqua") # COLOR("パ緑"))%
		ELSE
			IF MONEY:1 < L_PRICE + L_PRICE_SUM
				BUY_UNABLE:FINDELEMENT(BUY_UNABLE, -1) = L_SOFT
				L_COLOR = %TOSTR_HTML(COLOR("DARK-GRAY"))%
			ENDIF
		ENDIF
		L_PRICES = {L_PRICE, 7} 마카
	ENDIF
	CALL SET_VAR_INSTALLSOFT_EXPLAIN, L_SOFT, L_TITLE
	RESULTS:10 = 
	CALLFORM INSTALLSOFT_EXPLAIN_{L_SOFT}
	;長過ぎる場合の代替テキスト
	SIF RESULTS:10 != ""
		RESULTS = %RESULTS:10% 
	SHOW_LINE = <button value = '{LISTNUM + 100 }' title = '%L_TITLE%'><font color = '%L_COLOR%'>
	SHOW_LINE += @"[{LISTNUM + 100}] %GET_INSTALLSOFT_NAME(L_SOFT), 24, LEFT%" + L_PRICES
	SHOW_LINE += "</font>" + "</button>"
	SHOW_LINE += "　　　" + @"<font color = '%L_COLOR%'>" + RESULTS + "</font>"
	HTML_PRINT SHOW_LINE
	IF SELECT_TYPE == "Ｐ・Ｓ추천"
		FOR LCOUNT:1, 0, 3
			HTML_PRINT @"<font color = '%L_COLOR%'>" + " " * 48 + AUTO_SPLIT(BEGINNER_TIPS:(LCOUNT:2), "/", LCOUNT:1) + "</font>"
		NEXT
		LCOUNT:2++
	ENDIF
NEXT
WHILE LINECOUNT < L_LINE + SHOWNUM + 3
	PRINTFORML 
WEND
PRINTL 
IF SELL_LIST:SHOWNUM >= 0
	FOR LCOUNT, 0, 3
		SIF SELL_LIST:(LCOUNT * SHOWNUM) == -1
			CONTINUE
		CALL PRINT_COLOR, @"[{10 + LCOUNT}] Page.{LCOUNT}　　　" , LCOUNT == L_PAGE ? COLOR("aqua") # GETDEFCOLOR()
	NEXT
ENDIF
PRINTL 
DRAWLINE
L_LINE:1 = LINECOUNT
IF SELECT_SOFT >= 0
	PRINTFORML %GET_INSTALLSOFT_NAME(SELECT_SOFT)%
	CALL SET_VAR_INSTALLSOFT_EXPLAIN, SELECT_SOFT, L_TITLE
	CALL PRINTFORM_LF, L_TITLE
ENDIF
WHILE LINECOUNT < L_LINE:1 + 6
	PRINTFORML 
WEND
DRAWLINE
SHOW_LINE = 
FOR LCOUNT, 0, VARSIZE("INSTALLSOFTTYPE") + 1
	TEMPS = \@LCOUNT == VARSIZE("INSTALLSOFTTYPE") ? Ｐ・Ｓ추천 # %INSTALLSOFTTYPE:LCOUNT%\@
	SIF TEMPS == "컨버터"
		CONTINUE
	L_COLOR = %TOSTR_HTML(SELECT_TYPE == TEMPS ? COLOR("aqua") # GETDEFCOLOR())%
	SHOW_LINE += @"<font color = '%L_COLOR%'>" + @"<button value = '{50 + LCOUNT}'>"
	SHOW_LINE += @"[{50 + LCOUNT}] %TEMPS%　　　"
	SHOW_LINE += "</button>" + "</font>"
NEXT
HTML_PRINT SHOW_LINE
CUSTOMDRAWLINE =
PRINTFORML 【소지마카:{MONEY:1}】 / 【필요마카{L_PRICE_SUM}】
CUSTOMDRAWLINE =
L_LINE:2 = LINECOUNT
CALL PRINT_COLOR, "[ 0] 구입한다", L_PRICE_SUM > 0 && MONEY:1 >= L_PRICE_SUM ? GETDEFCOLOR() # COLOR("DARK-GRAY")
PRINTL 　　　[ 9] 돌아간다　　　　　　※ALTKEY・마우스 사이드 버튼을 누른 채 클릭하면 한 번에 여러 개 구매 가능합니다。
INPUT
SELECTCASE RESULT
	CASE 0
		IF L_PRICE_SUM > 0 && MONEY:1 >= L_PRICE_SUM
			MONEY:1 -= L_PRICE_SUM
			LCOUNT = 0
			WHILE BUY_LIST:LCOUNT >= 0
				CALL GET_INSTALLSOFT, BUY_LIST:LCOUNT
				LCOUNT++
			WEND
			SELECT_BUYNUM = RESULT
			VARSET BUY_LIST, -1
			BUY_LIST:FINDELEMENT(BUY_LIST, -1) = SELECT_SOFT
			CLEARLINE LINECOUNT - L_LINE:1
			PRINTFORML 인스톨소프트를 구입했습니다。
			WHILE LINECOUNT < L_LINE:2
				PRINTL 
			WEND
			PRINTFORM [0] 구입한다
			PRINTW 　　　[9] 돌아간다　　　　　　※ALTKEY・마우스 사이드 버튼을 누른 채 클릭하면 한 번에 여러 개 구매 가능합니다。
		ENDIF
	CASE 9
		REDRAW L_REDRAW
		RETURN 0
	CASE 10 TO 10 + ((VARSIZE("SELL_LIST") -1) / SHOWNUM)
		RESULT -= 10
		SIF SELL_LIST:(RESULT * SHOWNUM) >= 0
			L_PAGE = RESULT
	;表示区分変更
	CASE 50 TO 50 + VARSIZE("INSTALLSOFTTYPE") + 1
		RESULT -= 50
		IF RESULT == VARSIZE("INSTALLSOFTTYPE")
			SELECT_TYPE = Ｐ・Ｓ추천
		ELSE
			SIF INSTALLSOFTTYPE:RESULT == "컨버터"
				GOTO START
			SELECT_TYPE = %INSTALLSOFTTYPE:RESULT%
		ENDIF
		L_PAGE = 0
		SELECT_BUYNUM = -1
		SELECT_SOFT = -1
		VARSET BUY_LIST, -1
	CASE 100 TO 100 + VARSIZE("SELL_LIST")
		RESULT -= 100
		IF SELL_LIST:RESULT >= 0
			;ALT or マウスサイドキー
			;---- EDIT 020 ADD START -------------------------
			;IF (GETKEY(0x12) || GETKEY(0x05)) && !HAVE_INSTALLSOFT:RESULT
			IF (GETKEY(0x12) || GETKEY(0x05)) && !HAVE_INSTALLSOFT:(SELL_LIST:RESULT)
			;---- EDIT 020 MOD END ---------------------------
				IF FINDELEMENT(BUY_LIST, SELL_LIST:RESULT) >= 0
					BUY_LIST:FINDELEMENT(BUY_LIST, SELL_LIST:RESULT) = -1;EDIT 018 MOD
				ELSE
					SIF FINDELEMENT(BUY_UNABLE, SELL_LIST:RESULT) < 0
						BUY_LIST:FINDELEMENT(BUY_LIST, -1) = SELL_LIST:RESULT
				ENDIF
			ELSE
				IF SELL_LIST:RESULT == SELECT_SOFT && FINDELEMENT(BUY_LIST, SELECT_SOFT) >= 0
					IF L_PRICE_SUM > 0 && L_PRICE_SUM <= MONEY:1 && !HAVE_INSTALLSOFT:SELECT_SOFT
						CLEARLINE LINECOUNT - L_LINE:1
						PRINTFORML %GET_INSTALLSOFT_NAME(SELECT_SOFT)%을(를) 구입하겠습니까？
						PRINTL [0] 네
						PRINTL [1] 아니오
						WHILE LINECOUNT < L_LINE:2
							PRINTL 
						WEND
						PRINTL 
						CALL INPUTINT, 0, 1
						IF RESULT == 0
							MONEY:1 -= L_PRICE_SUM
							CALL GET_INSTALLSOFT, SELECT_SOFT
							CLEARLINE LINECOUNT - L_LINE:1
							PRINTFORML %GET_INSTALLSOFT_NAME(SELECT_SOFT)%을(를) 구입했습니다。
							SELECT_BUYNUM = -1
							SELECT_SOFT = -1
							VARSET BUY_LIST, -1
							WHILE LINECOUNT < L_LINE:2
								PRINTL 
							WEND
							PRINTFORM [0] 구입한다
							PRINTW 　　　[9] 돌아간다　　　　　　※ALTKEY・마우스 사이드 버튼을 누른 채 클릭하면 한 번에 여러 개 구매 가능합니다。
						ENDIF
					ENDIF
				ELSE
					SELECT_BUYNUM = RESULT
					SELECT_SOFT = SELL_LIST:SELECT_BUYNUM
					VARSET BUY_LIST, -1
					BUY_LIST:FINDELEMENT(BUY_LIST, -1) = SELECT_SOFT
				ENDIF
			ENDIF
		ENDIF
ENDSELECT
GOTO START

@TAKE_FREE_INSTALLSOFT, LIMIT_PRICE
#DIM DYNAMIC LCOUNT, 3
#DIM DYNAMIC LIMIT_PRICE
#DIM DYNAMIC L_LINE, 3
#DIMS SHOW_LINE
#DIM CONST SHOWNUM = 20
#DIM DYNAMIC LISTNUM
#DIMS L_TEXT
#DIMS L_BUTTON
#DIMS L_TITLE
#DIM DYNAMIC L_REDRAW
#DIM SELECT_SOFT
#DIM DYNAMIC L_SOFT
#DIM DYNAMIC L_PAGE
#DIMS DYNAMIC L_COLOR
#DIM DYNAMIC L_PRICE
#DIMS DYNAMIC L_PRICES
#DIM DYNAMIC SELL_LIST, 60

L_REDRAW = CURRENTREDRAW()
REDRAW 0

L_LINE = LINECOUNT
SELECT_SOFT = -1
L_PAGE = 0
$START
CLEARLINE LINECOUNT - L_LINE
VARSET SELL_LIST, -1
FOR LCOUNT, 0, INSTALLSOFTNUM
	;名称未定義は弾く
	SIF GET_INSTALLSOFT_NAME(LCOUNT) == ""
		CONTINUE
	;持っているソフトは弾く
	SIF HAVE_INSTALLSOFT:LCOUNT
		CONTINUE
	;販売条件チェック
	TRYCCALLFORM INSTALLSOFT_SELLABLE_{LCOUNT}
		SIF !RESULT
			CONTINUE
	CATCH
		CONTINUE
	ENDCATCH
	CALLFORM INSTALLSOFT_PRICE_{LCOUNT}
	;指定金額を超えている場合は外す
	SIF RESULT > LIMIT_PRICE
		CONTINUE
	;販売にリストに登録
	SELL_LIST:FINDELEMENT(SELL_LIST, -1) = LCOUNT
NEXT
;---------------------------------------------------
;商品の表示
;---------------------------------------------------
DRAWLINE
PRINTFORML {LIMIT_PRICE}마카까지의 인스톨소프트를 무상으로 받을 수 있습니다
DRAWLINE
LCOUNT:2 = 0
FOR LCOUNT, 0, SHOWNUM
	LISTNUM = LCOUNT + L_PAGE * SHOWNUM
	L_SOFT = SELL_LIST:LISTNUM
	SIF L_SOFT < 0
		CONTINUE
	;カラーセット
	IF L_SOFT == SELECT_SOFT
		L_COLOR = %TOSTR_HTML(COLOR("aqua"))%
	ELSE
		L_COLOR = %TOSTR_HTML(GETDEFCOLOR())%
	ENDIF
	CALLFORM INSTALLSOFT_PRICE_{L_SOFT}
	L_PRICE = RESULT
	L_PRICES = {L_PRICE, 7} 마카

	CALL SET_VAR_INSTALLSOFT_EXPLAIN, L_SOFT, L_TITLE
	RESULTS:10 = 
	CALLFORM INSTALLSOFT_EXPLAIN_{L_SOFT}
	;長過ぎる場合の代替テキスト
	SIF RESULTS:10 != ""
		RESULTS = %RESULTS:10% 
	SHOW_LINE = <button value = '{LISTNUM + 100}' title = '%L_TITLE%'><font color = '%L_COLOR%'>
	SHOW_LINE += @"[{LISTNUM + 100}] %GET_INSTALLSOFT_NAME(L_SOFT), 24, LEFT%" + L_PRICES
	SHOW_LINE += "</font>" + "</button>"
	SHOW_LINE += "　　　" + @"<font color = '%L_COLOR%'>" + RESULTS + "</font>"
	HTML_PRINT SHOW_LINE
NEXT
WHILE LINECOUNT < L_LINE + SHOWNUM + 3
	PRINTFORML 
WEND
PRINTL 
IF SELL_LIST:SHOWNUM >= 0
	FOR LCOUNT, 0, 3
		SIF SELL_LIST:(LCOUNT * SHOWNUM) == -1
			CONTINUE
		CALL PRINT_COLOR, @"[{10 + LCOUNT}] Page.{LCOUNT}　　　" , LCOUNT == L_PAGE ? COLOR("aqua") # GETDEFCOLOR()
	NEXT
ENDIF
PRINTL 
DRAWLINE
L_LINE:1 = LINECOUNT
IF SELECT_SOFT >= 0
	PRINTFORML %GET_INSTALLSOFT_NAME(SELECT_SOFT)%
	CALL SET_VAR_INSTALLSOFT_EXPLAIN, SELECT_SOFT, L_TITLE
	CALL PRINTFORM_LF, L_TITLE
ENDIF
WHILE LINECOUNT < L_LINE:1 + 6
	PRINTFORML 
WEND
DRAWLINE
CALL PRINT_COLOR, "[ 0] 교환한다", SELECT_SOFT >= 0 ? GETDEFCOLOR() # COLOR("DARK-GRAY")
PRINTL 　　　[ 9] 돌아간다
L_LINE:2 = LINECOUNT
INPUT
SELECTCASE RESULT
	CASE 0
		IF SELECT_SOFT > 0
			CALL GET_INSTALLSOFT, SELECT_SOFT
			CLEARLINE LINECOUNT - L_LINE:1
			PRINTFORML 토템메모리와 인스톨소프트를 교환했습니다。
			ITEM:토템메모리 -= 1
			COUNT_TRADE_TOTEM_MEMORY++
			WHILE LINECOUNT < L_LINE:2
				PRINTL 
			WEND
			PRINTFORM [0] 교환한다
			PRINTW 　　　[9] 돌아간다
			RETURN 1
		ENDIF
	CASE 9
		REDRAW L_REDRAW
		RETURN 0
	CASE 10 TO 10 + ((VARSIZE("SELL_LIST") -1) / SHOWNUM)
		RESULT -= 10
		SIF SELL_LIST:(RESULT * SHOWNUM) >= 0
			L_PAGE = RESULT
	CASE 100 TO 100 + VARSIZE("SELL_LIST")
		RESULT -= 100
		IF SELL_LIST:RESULT >= 0
			IF SELL_LIST:RESULT == SELECT_SOFT
				CLEARLINE LINECOUNT - L_LINE:1
				PRINTFORML %조사처리(GET_INSTALLSOFT_NAME(SELECT_SOFT),"와")% 교환합니까？
				PRINTL [0] 네
				PRINTL [1] 아니오
				WHILE LINECOUNT < L_LINE:2
					PRINTL 
				WEND
				CALL INPUTINT, 0, 1
				IF RESULT == 0
					CALL GET_INSTALLSOFT, SELECT_SOFT
					CLEARLINE LINECOUNT - L_LINE:1
					PRINTFORML %조사처리(GET_INSTALLSOFT_NAME(SELECT_SOFT),"와")% 교환했습니다。
					ITEM:토템메모리 -= 1
					COUNT_TRADE_TOTEM_MEMORY++
					SELECT_SOFT = -1
					WHILE LINECOUNT < L_LINE:2
						PRINTL 
					WEND
					PRINTFORM [0] 교환한다
					PRINTW 　　　[9] 돌아간다
					RETURN 1
				ENDIF
			ELSE
				SELECT_SOFT = SELL_LIST:RESULT
			ENDIF
		ENDIF
ENDSELECT
GOTO START

@TAKE_FREE_SKILL_EMULATOR, LIMIT_PRICE
#DIM DYNAMIC LIMIT_PRICE
#DIM DYNAMIC LCOUNT, 3
#DIM DYNAMIC L_LINE,3
#DIM DYNAMIC L_REDRAW
#DIMS DYNAMIC TEMPS
#DIM DYNAMIC SELL_LIST, 100
#DIM DYNAMIC BUY_UNABLE, 100
#DIM DYNAMIC BUY_LIST, 100
#DIM DYNAMIC SELECT_BUYNUM
#DIM DYNAMIC SELECT_EMU
#DIMS DYNAMIC SELECT_TYPE
#DIMS DYNAMIC L_TEXT
#DIMS DYNAMIC L_BUTTON
#DIMS DYNAMIC L_TITLE
#DIM DYNAMIC L_PRICE
#DIM DYNAMIC L_PRICE_SUM
#DIMS DYNAMIC L_PRICES
#DIMS DYNAMIC SHOW_LINE
#DIM CONST SHOWNUM = 20
#DIM DYNAMIC L_EMU
