FOR LOCAL, MIN_USEITEMNUM, MAX_USEITEMNUM
	;購入できない
	IF rOnSales:LOCAL != 1
		CONTINUE
	ENDIF
	rDisplays:aTypeNo:(lPoint) = LOCAL
	lPoint ++
