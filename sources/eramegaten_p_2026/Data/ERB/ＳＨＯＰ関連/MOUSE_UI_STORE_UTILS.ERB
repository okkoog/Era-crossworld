@MouseUIStore_Add_ToCart(rCart, aSelectedType, aSelectedItem, aItemNo, aUnit, aMode)
#DIM REF rCart, 0, 0
#DIM aSelectedType
#DIM aSelectedItem
#DIM aItemNo
#DIM aUnit
#DIMS aMode
SELECTCASE aMode
	CASE "BUY"
		rCart:aSelectedType:aSelectedItem = LIMIT(rCart:aSelectedType:aSelectedItem + aUnit, 0, MouseUIStore_ItemMaxPosses:aItemNo - GET_HAVE_ITEM_NUM(aItemNo, 1, 1))
	CASE "TRADEIN", "SELL"
		rCart:aSelectedType:aSelectedItem = LIMIT(rCart:aSelectedType:aSelectedItem + aUnit, 0, GET_HAVE_ITEM_NUM(aItemNo, 1, 1))
	CASEELSE
		THROW 
ENDSELECT

;-------------------------------------------------
;各種通貨
;-------------------------------------------------
@MouseUIStore_Add_Money(aName, aVal)
#DIMS aName
#DIM aVal
SIF aVal <= 0
	THROW {aVal}은(는) 유효하지 않은 획득 금액입니다.
SELECTCASE aName
	CASE "YEN"
		MONEY:0 += aVal
	CASE "MACCA"
		MONEY:1 += aVal
	CASE "COIN"
		MONEY:3 += aVal
	CASE "JP"
		MONEY:4 += aVal
	CASE "MAG"
		CALL CONTROL_MAG, MASTER, aVal
	CASE "TICKET"
		ITEM:행복티켓 += aVal
	CASEELSE
		THROW %aName%은(는) 알 수 없는 통화명입니다.
ENDSELECT

;-------------------------------------------------
@MouseUIStore_Remove_Money(aName, aVal)
#DIMS aName
#DIM aVal
SIF aVal <= 0
	THROW {aVal}은(는) 유효하지 않은 소실 금액입니다.
LOCAL = MAX(0, aVal - MouseUIStore_CurMoney(aName))
SELECTCASE aName
	CASE "YEN"
		MONEY:0 = MAX(0, MONEY:0 - aVal)
	CASE "MACCA"
		MONEY:1 = MAX(0, MONEY:1 - aVal)
	CASE "COIN"
		MONEY:3 = MAX(0, MONEY:3 - aVal)
	CASE "JP"
		MONEY:4 = MAX(0, MONEY:4 - aVal)
	CASE "MAG"
		CALL CONTROL_MAG, MASTER, -aVal
	CASE "TICKET"
		ITEM:행복티켓 = MAX(0, ITEM:행복티켓 - aVal)
	CASEELSE
		THROW %aName%은(는) 알 수 없는 통화명입니다.
ENDSELECT
;支払いきれなかった場合は残額を返す
RETURN LOCAL
