;-------------------------------------------------
;アイテム存在リスト
;-------------------------------------------------
@MouseUIStore_Exsits_Items()
#LOCALSIZE 1
#DIM lInitialized
SIF lInitialized
	RETURN 0
lInitialized = 1
;era系アイテム
FOR LOCAL, 0, 200
	IF !ITEMPRICE:LOCAL
		CONTINUE
	ENDIF
	MouseUIStore_ItemExsits:LOCAL = ITEMPRICE:LOCAL
NEXT
VARSET MouseUIStore_ItemMaxPosses, 1, 0, 200
VARSET MouseUIStore_ItemMaxPosses, 999, 40, 60
;RPGアイテム
FOR LOCAL, MIN_USEITEMNUM, MAX_USEITEMNUM
	IF !ITEMPRICE:LOCAL
		CONTINUE
	ENDIF
	MouseUIStore_ItemExsits:LOCAL = ITEMPRICE:LOCAL
	CALL GET_ITEMMAX, LOCAL, 1
	MouseUIStore_ItemMaxPosses:LOCAL = RESULT
NEXT
;RPG装備
FOR LOCAL, MIN_EQUIPNUM, MAX_EQUIPNUM
	;カスタムアイテムは購入/売却リスト生成の度にチェックするため別
	IF 魔晶装備(LOCAL) || 改造装備(LOCAL)
		CONTINUE
	ENDIF
	TRYCCALLFORM 装備箇所_{LOCAL}
		MouseUIStore_RPGEquipParts:LOCAL = RESULT
		MouseUIStore_ItemExsits:LOCAL = ITEMPRICE:LOCAL
		CALL GET_ITEMMAX, LOCAL, 1
		MouseUIStore_ItemMaxPosses:LOCAL = RESULT
	CATCH
	ENDCATCH
NEXT
;-------------------------------------------------
;カスタム系存在チェック
;持ってない場合存在しないものとして扱う
;-------------------------------------------------
@MouseUIStore_Exsits_CustomItem()
#LOCALSIZE 1
FOR LOCAL, MIN_EQUIPNUM, MAX_EQUIPNUM
	IF 魔晶装備(LOCAL)
		IF ITEM:LOCAL
			MouseUIStore_ItemExsits:LOCAL = ITEMPRICE:LOCAL
			MouseUIStore_RPGEquipParts:LOCAL = EQ_装備箇所_魔晶装備(LOCAL)
		ELSE
			MouseUIStore_ItemExsits:LOCAL = 0
			MouseUIStore_RPGEquipParts:LOCAL = 0
		ENDIF
	ENDIF
	IF 改造装備(LOCAL)
		IF ITEM:LOCAL
			CALLFORM 装備箇所_{LOCAL}
			MouseUIStore_RPGEquipParts:LOCAL = RESULT
			MouseUIStore_ItemExsits:LOCAL = ITEMPRICE:LOCAL
		ELSE
			MouseUIStore_ItemExsits:LOCAL = 0
			MouseUIStore_RPGEquipParts:LOCAL = 0
		ENDIF
	ENDIF
NEXT

;-------------------------------------------------
;アイテム売却リスト
;円で売るべきものをリストアップ
;NOTE:道具購入条件系の関数は現時点で購入できるかどうかしかわからない
;-------------------------------------------------
@MouseUIStore_Set_Value()
VARSET MouseUIStore_ItemValues
FOR LOCAL, MIN_USEITEMNUM, MAX_USEITEMNUM
	IF ITEMPRICE:LOCAL <= 1 || !MouseUIStore_ItemExsits:LOCAL
		CONTINUE
	ENDIF
	TRYCCALLFORM 道具購入条件_{LOCAL + 2000}
		IF RESULT > 0
			CONTINUE
		ENDIF
	CATCH
	ENDCATCH
	MouseUIStore_ItemValues:LOCAL = ITEMPRICE:LOCAL / 2
NEXT
;換金可能素材
FOR LOCAL, 1420, 1433
	MouseUIStore_ItemValues = ITEMPRICE:LOCAL / 2
NEXT
;装備
FOR LOCAL, MIN_EQUIPNUM, MAX_EQUIPNUM
	IF ITEMPRICE:LOCAL <= 1 || !MouseUIStore_ItemExsits:LOCAL
		CONTINUE
	ENDIF
	TRYCCALLFORM 購入条件_{LOCAL}
		IF RESULT > 0
			CONTINUE
		ENDIF
	CATCH
	ENDCATCH
	CALL EQ_売却価格, LOCAL
	MouseUIStore_ItemValues:LOCAL = RESULT
	
	;MouseUIStore_ItemValues:LOCAL = ITEMPRICE:LOCAL
NEXT

;-------------------------------------------------
;円での購入可否リスト
;-------------------------------------------------
@MouseUIStore_Yen_OnSales(rOnSales)
#LOCALSIZE 1
#DIM REF rOnSales, 0
VARSET rOnSales
;era系アイテム
FOR LOCAL, 0, 200
	IF !MouseUIStore_ItemExsits:LOCAL
		CONTINUE
	ENDIF
	;労役系
	IF LOCAL >= 100 && LOCAL < 110
		CONTINUE
	ENDIF
	rOnSales:LOCAL = TRAINITEM_SALEABLE(LOCAL)
NEXT
;RPGアイテム
FOR LOCAL, MIN_USEITEMNUM, MAX_USEITEMNUM
	IF !MouseUIStore_ItemExsits:LOCAL
		CONTINUE
	ENDIF
	TRYCCALLFORM 道具購入条件_{LOCAL+2000}
		rOnSales:LOCAL = RESULT
	CATCH
	ENDCATCH
NEXT
;RPG装備
FOR LOCAL, MIN_EQUIPNUM, MAX_EQUIPNUM
	IF !MouseUIStore_ItemExsits:LOCAL
		CONTINUE
	ENDIF
	TRYCCALLFORM 購入条件_{LOCAL}
		rOnSales:LOCAL = RESULT
	CATCH
	ENDCATCH
NEXT

