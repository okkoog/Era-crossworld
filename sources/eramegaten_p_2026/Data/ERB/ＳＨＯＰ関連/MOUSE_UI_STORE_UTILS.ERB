;-------------------------------------------------
;ソート記号
;-------------------------------------------------
@MouseUIStore_Sorts_CondSymbol(aSymbol)
#FUNCTION
#DIMS aSymbol
{
	#DIMS lSymbols = "INo", "Pri", "Pss"
	, "ELv", "STy", "GTy", "FAb", "GPw", "GHt", "GMg", "GSp", "ATy", "Mul", "Rng", "Sph", "AAd"
	, "IEf", "ISp", "ITy", "IAd"
	, "BPw", "BHt", "BTy", "BAd", "BLv" , "ILv"
}
{
	#DIMS lNames = "番号", "価格", "所持数"
	, "必要レベル", "剣タイプ", "銃タイプ", "戦闘能力修正", "총공격", "총명중", "특수탄창", "속도보정", "공격상성", "공격횟수", "사거리", "공격범위", "추가효과"
	, "I_SKILL_EFECT", "I_SKILL_SPHERE", "I_SKILL_TYPE", "I_SKILL_ADDTIONAL_STATE"
	, "B_SKILL_POWER", "B_SKILL_HITRATE", "B_SKILL_TYPE", "B_SKILL_ADDTIONAL_STATE", "B_弾レベル" , "I_アイテム使用能力レベル"
}
#DIM found
;220816 入力が正規表現ととられないようエスケープさせておくよう修正
found = FINDELEMENT(lSymbols, ESCAPE(aSymbol), , , 1)
IF found >= 0
	RESULTS '= lNames:found
	RETURNF 1
ENDIF
RETURNF 0

;-------------------------------------------------
;昇順ソート
;-------------------------------------------------
@MouseUIStore_Sorts(r2dDisplays, r2DCart, aTypeNo, aUserNo, aCond, aCondNum)
#LOCALSIZE 1
#DIM REF r2dDisplays, 0, 0
#DIM REF r2DCart, 0, 0
#DIM aTypeNo
#DIM aUserNo
#DIMS aCond
#DIM aCondNum
#DIM lMax, 2
#DIM DYNAMIC lBucket_No, 20000
#DIM DYNAMIC lBucket_Cart, 20000
#DIM DYNAMIC lBucketNum, 2
#DIM DYNAMIC lCond, 10, 1000
#DIM DYNAMIC lCount, 20000 ;-10000 ~ 10000
#DIM DYNAMIC lOffset, 20000 ;-10000 ~ 10000
#DIM DYNAMIC lPoint
#DIM DYNAMIC lskill
VARSIZE r2dDisplays
lMax:0 = RESULT:0, RESULT:1
SELECTCASE MouseUIStore_ItemType(aTypeNo)
	CASE "調教アイテム"
		RETURN 0
	CASE "アイテム"
		lBucketNum:0 = MIN_USEITEMNUM, MAX_USEITEMNUM
	CASEELSE
		lBucketNum:0 = MIN_EQUIPNUM, MAX_EQUIPNUM
ENDSELECT
;まずItemNoでソート、ダブらないので単純なバケットソートで安定する
FOR LOCAL, 0, lMax:1
	IF !r2dDisplays:aTypeNo:LOCAL
		BREAK
	ENDIF
	lBucket_No:(r2dDisplays:aTypeNo:LOCAL) = r2dDisplays:aTypeNo:LOCAL
	lBucket_Cart:(r2dDisplays:aTypeNo:LOCAL) = r2DCart:aTypeNo:LOCAL
NEXT
FOR LOCAL, lBucketNum:0, lBucketNum:1
	IF lBucket_No:LOCAL
		r2dDisplays:aTypeNo:lPoint = lBucket_No:LOCAL
		r2DCart:aTypeNo:lPoint = lBucket_Cart:LOCAL
		lPoint ++
	ENDIF
NEXT
;係数ソート
SELECTCASE aCond
	;上でソート済み
	CASE "番号"
		RETURN 1
	;変数を直接見る
	CASE "所持数"
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			lCond:aTypeNo:LOCAL = GET_HAVE_ITEM_NUM(r2dDisplays:aTypeNo:LOCAL, 1, 1) % 10000
			lCount:(GET_HAVE_ITEM_NUM(r2dDisplays:aTypeNo:LOCAL, 1, 1) % 10000) ++
		NEXT
	;桁が多いので基底ソート
	CASE "価格"
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			lCond:aTypeNo:LOCAL = ITEMPRICE:(r2dDisplays:aTypeNo:LOCAL) % 10000
			lCount:(ITEMPRICE:(r2dDisplays:aTypeNo:LOCAL) % 10000) ++
		NEXT
		CALL MouseUIStore_Sorts_Sort(r2dDisplays, r2DCart, aTypeNo, lCond, lCount, lOffset, lMax)
		VARSET lCond
		VARSET lCount
		VARSET lOffset
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			lCond:aTypeNo:LOCAL = ITEMPRICE:(r2dDisplays:aTypeNo:LOCAL) % 100000000 / 10000
			lCount:(ITEMPRICE:(r2dDisplays:aTypeNo:LOCAL) % 100000000 / 10000) ++
		NEXT
		CALL MouseUIStore_Sorts_Sort(r2dDisplays, r2DCart, aTypeNo, lCond, lCount, lOffset, lMax)
		VARSET lCond
		VARSET lCount
		VARSET lOffset
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			;1兆以上は見ない
			lCond:aTypeNo:LOCAL = ITEMPRICE:(r2dDisplays:aTypeNo:LOCAL) % 1000000000000 / 100000000
			lCount:(ITEMPRICE:(r2dDisplays:aTypeNo:LOCAL) % 1000000000000 / 100000000) ++
		NEXT
	;最低と最大で基底ソート
	CASE "공격횟수"
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			RESULT = 0
			TRYCALLFORM 最低攻撃回数_{r2dDisplays:aTypeNo:LOCAL}, aUserNo
			lCond:aTypeNo:LOCAL = RESULT + 10000
			lCount:(RESULT + 10000) ++
		NEXT
		CALL MouseUIStore_Sorts_Sort(r2dDisplays, r2DCart, aTypeNo, lCond, lCount, lOffset, lMax)
		VARSET lCond
		VARSET lCount
		VARSET lOffset
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			RESULT = 0
			TRYCALLFORM 最大攻撃回数_{r2dDisplays:aTypeNo:LOCAL}, aUserNo
			lCond:aTypeNo:LOCAL = RESULT + 10000
			lCount:(RESULT + 10000) ++
		NEXT
	;引数不要
	CASE "必要レベル", "剣タイプ", "銃タイプ", "속도보정"
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			RESULT = 0
			TRYCALLFORM %aCond%_{r2dDisplays:aTypeNo:LOCAL}
			lCond:aTypeNo:LOCAL = RESULT + 10000
			lCount:(RESULT + 10000) ++
		NEXT
	;引数は装備者番号
	CASE "공격상성", "사거리", "공격범위", "추가효과", "총공격", "총명중", "특수탄창"
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			RESULT = 0
			TRYCALLFORM %aCond%_{r2dDisplays:aTypeNo:LOCAL}, aUserNo
			lCond:aTypeNo:LOCAL = RESULT + 10000
			lCount:(RESULT + 10000) ++
		NEXT
	;戻り値を引数指定、装備者番号
	CASE "戦闘能力修正", "防御相性"
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			RESULT = 0
			TRYCALLFORM %aCond%_{r2dDisplays:aTypeNo:LOCAL}, aCondNum, aUserNo
			lCond:aTypeNo:LOCAL = RESULT + 10000
			lCount:(RESULT + 10000) ++
		NEXT
	;スキル系
	;引数なし
	CASE "I_SKILL_EFECT"
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			CALLFORM %SUBSTRING(aCond, 2, )%_{r2dDisplays:aTypeNo:LOCAL + 2000}
			lCond:aTypeNo:LOCAL = RESULT + 10000
			lCount:(RESULT + 10000) ++
		NEXT
	;引数は装備者番号
	CASE "I_SKILL_SPHERE", "I_SKILL_TYPE", "I_SKILL_ADDTIONAL_STATE"
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			RESULT = 0
			TRYCALLFORM %SUBSTRING(aCond, 2, )%_{r2dDisplays:aTypeNo:LOCAL + 2000}, aUserNo
			lCond:aTypeNo:LOCAL = RESULT + 10000
			lCount:(RESULT + 10000) ++
		NEXT
	;탄환
	CASE "B_SKILL_POWER", "B_SKILL_HITRATE", "B_SKILL_TYPE", "B_SKILL_ADDTIONAL_STATE"
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			CALLFORM 銃スキル_{r2dDisplays:aTypeNo:LOCAL}
			lskill = RESULT
			RESULT = 0
			TRYCALLFORM %SUBSTRING(aCond, 2, )%_{lskill}, aUserNo
			RESULT = 100 - RESULT
			lCond:aTypeNo:LOCAL = RESULT + 10000
			lCount:(RESULT + 10000) ++
		NEXT
	CASE "B_弾レベル"
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			CALLFORM %SUBSTRING(aCond, 2, )%_{r2dDisplays:aTypeNo:LOCAL}
			lCond:aTypeNo:LOCAL = RESULT + 10000
			lCount:(RESULT + 10000) ++
		NEXT
	CASE "I_アイテム使用能力レベル"
		FOR LOCAL, 0, lMax:1
			IF !r2dDisplays:aTypeNo:LOCAL
				BREAK
			ENDIF
			RESULT = 0
			TRYCALLFORM %SUBSTRING(aCond, 2, )%_{CONVERT_USEITEMNUM_TO_SKILLNUM(r2dDisplays:aTypeNo:LOCAL)}
			lCond:aTypeNo:LOCAL = RESULT + 10000
			lCount:(RESULT + 10000) ++
		NEXT
	CASEELSE
		THROW %aCond%은(는) 알 수 없는 정렬 조건입니다.
ENDSELECT
CALL MouseUIStore_Sorts_Sort(r2dDisplays, r2DCart, aTypeNo, lCond, lCount, lOffset, lMax)

