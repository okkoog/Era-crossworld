;-------------------------------------------------
;防具
;-------------------------------------------------
@MouseUIStore_ITEMDATA_防具(rData, rDataS, aItemNo, aUserNo=-1, aTypeColor)
#LOCALSIZE 1
#DIM REF rData, 0
#DIMS REF rDataS, 0
#DIM aItemNo
#DIM aUserNo
#DIMS aTypeColor
VARSET rData
VARSET rDataS
CALL MouseUIStore_ITEMDATA_EquipCommon(rData, rDataS, aItemNo, aUserNo)
;攻撃、命中、防御、回避、魔法威力、魔法効果
FOR LOCAL, 0, 6
	TRYCCALLFORM 戦闘能力修正_{aItemNo}, LOCAL, aUserNo
		rData:(3 + LOCAL) = RESULT
		rDataS:(3 + LOCAL) = {RESULT}
	CATCH
		rDataS:(3 + LOCAL) = "0"
	ENDCATCH
NEXT
FOR LOCAL, 0, 18
	TRYCCALLFORM 防御相性_{aItemNo}, LOCAL, aUserNo
		rData:(11 + LOCAL) = RESULT
		rDataS:(11 + LOCAL) '= MouseUIStore_TypeResistName(RESULT)
		IF RESULT == 100
			rDataS:(10) += MouseUIStore_TypeResistMark(100)
		ELSE
			SELECTCASE aTypeColor
				CASE "TYPE"
					rDataS:(10) += MouseUIStore_HtmlColor(MouseUIStore_TypeResistMark(RESULT), MouseUIStore_TypeNoColor(LOCAL))
				CASE "EFFECT"
					rDataS:(10) += MouseUIStore_HtmlColor(MouseUIStore_TypeResistMark(RESULT), MouseUIStore_ResistColor(RESULT))
				CASEELSE
					THROW %aTypeColor%은(는) 알 수 없는 표시 지정입니다
				ENDSELECT
		ENDIF
	CATCH
		rDataS:(11 + LOCAL) '= MouseUIStore_TypeResistName(100)
		rDataS:(10) += MouseUIStore_TypeResistMark(100)
	ENDCATCH
NEXT
FOR LOCAL, 0, 21
	TRYCCALLFORM バステ耐性_{aItemNo}, LOCAL, aUserNo
		IF RESULT
			rDataS:29 += " " + GET_STATE_KANJI(LOCAL) + MouseUIStore_StateResist_ToName(RESULT) + " "
		ENDIF
	CATCH
	ENDCATCH
NEXT
;-------------------------------------------------
@MouseUIStore_ITEMDATA_EquipCommon(rData, rDataS, aItemNo, aUserNo)
#LOCALSIZE 1
#DIM REF rData, 0
#DIMS REF rDataS, 0
#DIM aItemNo
#DIM aUserNo
;ITEMNo
rData:(0) = aItemNo
IF INRANGE(aItemNo, 3703, 3710) || aItemNo == 2556
	rDataS:(0) '= TOFULL(装備の名称(aItemNo))
ELSE
	rDataS:(0) '= 装備の名称(aItemNo, aUserNo)
ENDIF
;条件
IF aUserNo < 0
	rDataS:(1) '= "？"
ELSE
	RESULT = 0
	TRYCALLFORM 装備箇所_{aItemNo}
	CALL EQ_装備可能確認, aUserNo, aItemNo, RESULT
	rData:(1) = RESULT
	IF RESULT
		rDataS:(1) '= MouseUIStore_HtmlColorS("✔", "OK")
	ELSE
		rDataS:(1) '= MouseUIStore_HtmlColorS("✖", "NG")
	ENDIF
ENDIF

CALL EQ_必要レベル取得, aUserNo, aItemNo
rData:(30) = RESULT
rDataS:(30) = {RESULT}

;-------------------------------------------------
;탄환
;-------------------------------------------------
@MouseUIStore_ITEMDATA_탄환(rData, rDataS, aItemNo, aUserNo)
#LOCALSIZE 1
#DIM REF rData, 0
#DIMS REF rDataS, 0
#DIM aItemNo
#DIM aUserNo
#DIM lSkillNo
VARSET rData
VARSET rDataS
;アイテム情報
rData:(0) = aItemNo
rDataS:(0) '= ITEMNAME:aItemNo
;対応スキル
CALLFORM 銃スキル_{aItemNo}
lSkillNo = RESULT
;条件
IF aUserNo < 0
	rDataS:(1) '= "？"
ELSE
	RESULT = 0
	TRYCALLFORM 装備箇所_{aItemNo}
	CALL EQ_装備可能確認, aUserNo, aItemNo, RESULT
	rData:(1) = RESULT
	IF RESULT
		rDataS:(1) '= MouseUIStore_HtmlColorS("✔", "OK")
	ELSE
		rDataS:(1) '= MouseUIStore_HtmlColorS("✖", "NG")
	ENDIF
ENDIF
;スキル情報
CALL GET_SKILL_PROP, "SKILL_POWER", lSkillNo, aUserNo
rData:(2) = RESULT
rDataS:(2) = {RESULT}
CALL GET_SKILL_PROP, "SKILL_HITRATE", lSkillNo, aUserNo
rData:(3) = RESULT
rDataS:(3) = {RESULT}
CALL GET_SKILL_PROP, "SKILL_TYPE", lSkillNo, aUserNo
rData:(4) = RESULT
rDataS:(4) '= MouseUIStore_TypeName(RESULT)
CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_STATE", lSkillNo, aUserNo
IF RESULT
	rData:(5) = RESULT
	rDataS:(5) '= " " * 2 + MouseUIStore_State(RESULT)
ENDIF
CALLFORM 弾レベル_{aItemNo}
rData:(6) = RESULT
rDataS:(6) = Lv{RESULT}

;-------------------------------------------------
;アイテム
;-------------------------------------------------
@MouseUIStore_ITEMDATA_アイテム(rData, rDataS, aItemNo, aUserNo)
#LOCALSIZE 1
#DIM REF rData, 0
#DIMS REF rDataS, 0
#DIM aItemNo
#DIM aUserNo
#DIM lSkillNo
VARSET rData
VARSET rDataS
lSkillNo = aItemNo + 2000
;アイテム情報
rData:(0) = aItemNo
rDataS:(0) '= ITEMNAME:aItemNo
;

CALL GET_SKILL_PROP, "SKILL_TARGET", lSkillNo, aUserNo
IF RESULT == 6
	rData:(1) = 1
	rDataS:(1) '= "자신"
ELSE
	CALL GET_SKILL_PROP, "SKILL_SPHERE", lSkillNo, aUserNo
	IF RESULT > 0
		rData:(1) = RESULT
		rDataS:(1) '= GET_SPHERE(RESULT, 1)
	ENDIF
ENDIF
CALL GET_SKILL_PROP, "SKILL_EFECT", lSkillNo, aUserNo
rData:(2) = RESULT
rDataS:(2) '= MouseUIStore_EffectTypeName(RESULT)

IF rData:(2) == 1 || rData:(2) == 3
	CALL GET_SKILL_PROP, "SKILL_TYPE", lSkillNo, -1
	rData:(3) = RESULT
	rDataS:(3) '= MouseUIStore_TypeName(RESULT)
ELSE
	;攻撃・状態異常以外の場合は表示しない
	rData:(3) = 0
	rDataS:(3) '= " " * 4
ENDIF
RESULT = 0
CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_STATE", lSkillNo, aUserNo
IF RESULT
	rData:(4) = RESULT
	rDataS:(4) '= MouseUIStore_State(RESULT)
;GOODの場合は表示しない
ELSE
	rData:(4) = 0
	rDataS:(4) '= " " * 6
ENDIF
TRYCCALLFORM アイテム使用能力レベル_{aItemNo + 2000}
	rData:(5) = RESULT
	IF RESULT == 0
		;必要レベル無しなら非表示
		rDataS:(5) '= " " * 4
	ELSE
		rDataS:(5) = Lv{RESULT}
	ENDIF
CATCH
	rData:(5) = 0
	rDataS:(5) '= " " * 4
ENDCATCH

