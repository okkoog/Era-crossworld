;-------------------------------------------------
@MouseUIStore_TradeIn_RPGItems(rTradeIn, aTypeNo)
#LOCALSIZE 1
#DIM REF rTradeIn, 0, 0
#DIM aTypeNo
#DIM lPoint
VARSET lPoint
FOR LOCAL, MIN_USEITEMNUM, MAX_USEITEMNUM
	;非存在
	IF !MouseUIStore_ItemExsits:LOCAL
		CONTINUE
	ENDIF
	;売るようなものじゃない
	IF ITEMPRICE:LOCAL == 1
		CONTINUE
	ENDIF
	;貴重品
	IF MouseUIStore_ItemValues:LOCAL
		CONTINUE
	ENDIF
	;所持していない
	IF ITEM:LOCAL <= 0
		CONTINUE
	ENDIF
	rTradeIn:aTypeNo:(lPoint) = LOCAL
	lPoint ++
NEXT

;-------------------------------------------------
@MouseUIStore_TradeIn_RPGEquips(rTradeIn, aTypeNo, aItemType)
#LOCALSIZE 1
#DIM REF rTradeIn, 0, 0
#DIM aTypeNo
#DIMS aItemType
#DIM lPoint
VARSET lPoint
FOR LOCAL, MIN_EQUIPNUM, MAX_EQUIPNUM
	;非存在
	IF !MouseUIStore_ItemExsits:LOCAL
		CONTINUE
	ENDIF
	;売るようなものじゃない
	IF ITEMPRICE:LOCAL == 1 || 魔晶装備(LOCAL)
		CONTINUE
	ENDIF
	;貴重品
	IF MouseUIStore_ItemValues:LOCAL
		CONTINUE
	ENDIF
	;部位が違う
	IF MouseUIStore_ItemType(MouseUIStore_RPGEquipParts:LOCAL) != aItemType
		CONTINUE
	ENDIF
	;所持していない
	IF ITEM:LOCAL <= 0
		CONTINUE
	ENDIF
	rTradeIn:aTypeNo:(lPoint) = LOCAL
	lPoint ++
NEXT

