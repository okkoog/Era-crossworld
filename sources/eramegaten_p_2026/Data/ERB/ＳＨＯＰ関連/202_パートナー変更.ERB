@SHOPCOMABLE_202
#DIM DYNAMIC LCOUNT
SIF !IS_USEABLE_SHOPCOM
	RETURN 0
RESULT:1 = 2
RESULTS = 파트너변경
FOR LCOUNT,1,CHARANUM
	SIF LCOUNT == TARGET
		CONTINUE
	SIF !PARTNER_ABLE(LCOUNT)
		CONTINUE
	RETURN 1
NEXT
RETURN 0

@PARTNER_ABLE, ARG
#FUNCTION
;主人は除外
SIF ARG == MASTER
	RETURNF 0
;労役中キャラは除外
SIF IS_RENTING(ARG)
	RETURNF 0
SIF CHECK_CHILD_CARE(ARG)
	RETURNF 0
SIF TALENT:ARG:맹우
	RETURNF 0
;失踪中などこの場にいないなら除外
SIF CFLAG:ARG:이자리에없는플래그
	RETURNF 0
SIF CFLAG:ARG:전투이외불능
	RETURNF 0
RETURNF 1


@SHOP_COM_202, ARG
PRINTL
CUSTOMDRAWLINE =
