				ENDIF
				GOTO PRINT_LIST
			ENDIF
		ENDIF
	ELSE
		IF MONEY < ITEMPRICE:(L_ITEMNO)
			PRINTW 돈이 부족합니다
			GOTO PRINT_LIST
		ELSE
			;---- EDIT 011 MOD START -------------------------
			PRINTFORML 몇 개 구입하시겠습니까？ (현재 {GET_HAVE_ITEM_NUM(L_ITEMNO)}개 소지)
			CALL INPUT_MANY(0,MIN(MONEY/ITEMPRICE:(L_ITEMNO),MAX_HAVEABLE - GET_HAVE_ITEM_NUM(L_ITEMNO)))
			;---- EDIT 011 MOD END ---------------------------
			IF RESULT == 0
				GOTO PRINT_LIST
			ELSE
				MONEY -= (RESULT * ITEMPRICE:(L_ITEMNO))
				IF RESULT == 1
					PRINTFORMW ＜%ITEMNAME:(L_ITEMNO)%을(를) 구입했습니다＞
				ELSE
					PRINTFORMW ＜%ITEMNAME:(L_ITEMNO)%을(를) {RESULT}개 구입했습니다＞
				ENDIF
				CALL GET_ITEM,L_ITEMNO,RESULT
				IF GETBIT(FLAG:정크숍설정,0) && LOCAL < 7 && 比較者 > -1 && 比較者 < CHARANUM
					RESULT = 0
					TRYCALLFORM 装備条件_{L_ITEMNO},比較者
					IF RESULT > 0
