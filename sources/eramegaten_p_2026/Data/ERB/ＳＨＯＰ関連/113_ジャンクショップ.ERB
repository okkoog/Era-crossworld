@MAKE_SALERPGITEMLIST,ARG
VARSET アイテムリスト,-1
LOCAL:1 = 0
IF ARG < 8
	FOR LOCAL,MIN_EQUIPNUM,MAX_EQUIPNUM
		SIF ITEMPRICE:LOCAL <= 1
			CONTINUE
		RESULT = 12
		IF 魔晶装備(LOCAL)
			LOCAL:2 = EQ_GETID_魔晶装備(LOCAL)
			TRYCALLFORM 装備箇所_魔晶装備,LOCAL:2
			IF RESULT == ARG && ITEM:LOCAL > 0
				アイテムリスト:(LOCAL:1) = LOCAL
				LOCAL:1 += 1
			ENDIF
		ELSE
			TRYCALLFORM 装備箇所_{LOCAL}
			IF RESULT == ARG && ITEM:LOCAL > 0
				アイテムリスト:(LOCAL:1) = LOCAL
				LOCAL:1 += 1
			ENDIF
		ENDIF
	NEXT
ELSE
	FOR LOCAL,MIN_USEITEMNUM,MAX_USEITEMNUM
		SIF ITEMPRICE:LOCAL <= 1
			CONTINUE
		IF ITEM:LOCAL > 0
			アイテムリスト:(LOCAL:1) = LOCAL
			LOCAL:1 += 1
		ENDIF
	NEXT
	FOR LOCAL,MIN_MATERIAL,MAX_MATERIAL
		SIF ITEMPRICE:LOCAL <= 1
			CONTINUE
		IF ITEM:LOCAL > 0
			アイテムリスト:(LOCAL:1) = LOCAL
			LOCAL:1 += 1
		ENDIF
	NEXT
ENDIF
RETURN LOCAL:1

