		SIF FLAG:스킬속성표시설정 == 1
			CALL SKILL_EXPLAIN_PERFORMANCE, L_ITEMNO + 2000, -1
		CALL GET_SKILL_PROP, "SKILL_EXPLAIN", L_ITEMNO+2000, -1
		DRAWLINE
