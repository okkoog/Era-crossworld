;ショップコマンドの使用可否を格納する変数。旧TFLAG100~999と同様の役割を果たす
;TFLAGが他の用途に用いられている場合バッティングすることがあったので新造。
#DIM SHOP_ABLE, 1000

#DIM SAVEDATA IS_VISITED_SHOP
#DIM SAVEDATA IS_VISITED_COMP_SMITH
#DIM SAVEDATA IS_VISITED_YOYO_CASTLE

#DIM SAVEDATA IS_USEABLE_SHOP
#DIM SAVEDATA IS_USEABLE_EVENT
#DIM SAVEDATA IS_USEABLE_SHOPCOM
#DIM SAVEDATA IS_USEABLE_RAGSHOP
#DIM SAVEDATA IS_USEABLE_RAG_SUBSCRIPTION
#DIM SAVEDATA USE_DAY_RAG_SUBSCRIPTION

#DIM SAVEDATA FLAG_REQ_6_TUTORIAL
#DIM SAVEDATA IS_TOTEM_MEMORY_TAKEN, 4
#DIM SAVEDATA COUNT_TRADE_TOTEM_MEMORY

#DIM CONST DUNGEONNUM = 150
#DIM CONST COLOSSEUMNUM = 150
#DIM CONST REQUESTNUM = 200
#DIM CONST EVENTNUM = 250

#DIM SAVEDATA ダンジョンフラグ , DUNGEONNUM , 101
#DIM SAVEDATA イベントフラグ , EVENTNUM , 20
#DIM SAVEDATA 依頼フラグ , REQUESTNUM , 20
#DIM SAVEDATA 闘技場フラグ , COLOSSEUMNUM , 20

#DIM SAVEDATA ANNOUNCE_DUNGEON_APPEARED, DUNGEONNUM
#DIM SAVEDATA ANNOUNCE_COLOSSEUM_APPEARED, COLOSSEUMNUM
#DIM SAVEDATA ANNOUNCE_REQUEST_APPEARED, REQUESTNUM
#DIM SAVEDATA ANNOUNCE_EVENT_APPEARED, EVENTNUM

#DIM SAVEDATA セーブデータID, 1

#DIMS SAVEDATA DUNGEON_IS_FILTERED, DUNGEONNUM

