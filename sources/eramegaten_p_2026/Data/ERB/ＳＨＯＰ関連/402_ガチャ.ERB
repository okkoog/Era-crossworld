				IF RESULT
					LOCAL = RESULT:1
					SIF FLAG:DEBUG
						PRINTFORM {LOCAL, 5}
					TALENT:LOCAL:가챠 = 1
					;SIF FLAG:(20000+NO:LOCAL) < 100
