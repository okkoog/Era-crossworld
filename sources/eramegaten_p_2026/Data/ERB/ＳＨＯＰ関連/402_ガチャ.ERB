;=================================================
;みんな大好きガチャ処理　(ARG=1は悪魔確定でARG=2でＲ以上確定。　ARG:3=ピックアップ内容)
;=================================================
@GACHA_ONCE(ARG = -1, ARG:3 = -1)
LOCAL = 0
	IF ARG == 1
		LOCAL = RAND:2000000
	ELSEIF ARG == 2
		LOCAL = RAND:3000000
		IF LOCAL >= 1500000
			LOCAL += 5000000
		ELSEIF LOCAL >= 500000 && LOCAL < 1500000
			LOCAL += 2000000
		ENDIF
	ELSEIF ARG == 777
		LOCAL = RAND:100000
	ELSE
		LOCAL = RAND:10000000
	ENDIF
	;　１％　……ＳＲ……　{FLAG:가챠레벨설정+1}～{FLAG:가챠레벨설정+10}LVの「悪魔」
	IF   LOCAL < 100000
		IF !(LOCAL % 4)
			CALL GACHA_SEARCH_DEVIL, FLAG:가챠레벨설정+1, FLAG:가챠레벨설정+10, ARG:3
			IF RESULT > 0
				CALL ADD_NEW_COMPANION ,RESULT ,0 ,0
				IF RESULT
					LOCAL = RESULT:1
					SIF FLAG:DEBUG
						PRINTFORM {LOCAL, 5}
					TALENT:LOCAL:가챠 = 1
					;SIF FLAG:(20000+NO:LOCAL) < 100
					;	FLAG:(20000+NO:LOCAL) = 100
					SETCOLOR 0x00EEEE
					PRINTFORM [ＳＲ悪魔]
					RESETCOLOR
					PRINTFORML %종족명(LOCAL)% %CALLNAME:LOCAL%
					RETURN 0
				ENDIF
			ENDIF
		ENDIF
		CALL GACHA_SEARCH_DEVIL, FLAG:가챠레벨설정+6, FLAG:가챠레벨설정+10, 0
		IF RESULT > 0
			CALL ADD_NEW_COMPANION ,RESULT ,0 ,0
			IF RESULT
				LOCAL = RESULT:1
				SIF FLAG:DEBUG
					PRINTFORM {LOCAL, 5}
				TALENT:LOCAL:가챠 = 1
				;SIF FLAG:(20000+NO:LOCAL) < 100
				;	FLAG:(20000+NO:LOCAL) = 100
				SETCOLOR 0x00EEEE
				PRINTFORM [ＳＲ悪魔]
				RESETCOLOR
				PRINTFORML %종족명(LOCAL)% %CALLNAME:LOCAL%
				RETURN 0
			ENDIF
			;失敗した場合は次に回す（仲間枠飽和とかも含む）
		ENDIF
	ENDIF

	;　４％　……　Ｒ……　{MAX(FLAG:가챠레벨설정/2,5)}～{FLAG:가챠레벨설정+5}LV以下の「悪魔」
	IF   LOCAL < 500000
		IF !(LOCAL % 4)
			CALL GACHA_SEARCH_DEVIL, MAX(FLAG:가챠레벨설정/2,5), FLAG:가챠레벨설정+5, ARG:3
			IF RESULT > 0
				CALL ADD_NEW_COMPANION ,RESULT ,0 ,0
				IF RESULT
					LOCAL = RESULT:1
					SIF FLAG:DEBUG
						PRINTFORM {RESULT:1, 5}
					TALENT:LOCAL:가챠 = 1
					;SIF FLAG:(20000+NO:LOCAL) < 100
					;	FLAG:(20000+NO:LOCAL) = 100
					SETCOLOR 0xEEEE00
					PRINTFORM [　Ｒ悪魔]
					RESETCOLOR
					PRINTFORML %종족명(LOCAL)% %CALLNAME:LOCAL%
					RETURN 0
				ENDIF
			ENDIF
		ENDIF
		CALL GACHA_SEARCH_DEVIL, MAX(FLAG:가챠레벨설정/2,5), FLAG:가챠레벨설정+5, 0
		IF RESULT > 0
			CALL ADD_NEW_COMPANION ,RESULT ,0 ,0
			IF RESULT
				LOCAL = RESULT:1
				SIF FLAG:DEBUG
					PRINTFORM {LOCAL, 5}
				TALENT:LOCAL:가챠 = 1
				;SIF FLAG:(20000+NO:LOCAL) < 100
				;	FLAG:(20000+NO:LOCAL) = 100
				SETCOLOR 0xEEEE00
				PRINTFORM [　Ｒ悪魔]
				RESETCOLOR
				PRINTFORML %종족명(LOCAL)% %CALLNAME:LOCAL%
				RETURN 0
			ENDIF
			;失敗した場合は次に回す（仲間枠飽和とかも含む）
		ENDIF
	ENDIF

	;１５％　……　Ｎ……　{MAX(FLAG:가챠레벨설정/2,5)}LV以下の「悪魔」
	IF  LOCAL < 2000000
		IF !(LOCAL % 4)
			CALL GACHA_SEARCH_DEVIL, 1, MAX(FLAG:가챠레벨설정/2,5), ARG:3
			IF RESULT > 0
