;=================================================
;対象悪魔サーチ(ARG:1=下限レベル、ARG:2=上限レベル、ARG:3=ピックアップ内容)
;帰す値は仲魔になった悪魔の番地またはアイテムNO、失敗したら-1帰す
;ピックアップ内容は、XYZZZZZZ　Y=1でZ番の素質、Y=5でアライメント(1:Light、2:Law、3:C、4:Dark)を見る
;ただしXが1の時はYの条件がそれではない時を見る
;=================================================
@GACHA_SEARCH_DEVIL, ARG:1=1, ARG:2=5, ARG:3 = -1

;LOCAL:1番が選出された悪魔のNO
LOCAL:1 = -1
;LOCAL:2番が候補になった悪魔の総数
LOCAL:2 = 0
;LOCAL:3番が候補になった悪魔のRAND抽選用
LOCAL:3 = 0
;LOCAL:4番はピックアップの真偽チェック
LOCAL:4 = 0
;LOCAL:6はFORループ用
LOCAL:6 = 0

FOR LOCAL:6, 0, 1800
	SIF !EXISTCSV(LOCAL:6, 0)
		CONTINUE
	IF ARG:3 > 0
		SIF !CSVTALENT(LOCAL:6, (ARG:3 % 1000000), 0)
			CONTINUE
	ENDIF
	SIF CSVCFLAG(LOCAL:6,(GETNUM(CFLAG,"전서소환불가")),0) == 1
		CONTINUE
	SIF CSVCFLAG(LOCAL:6,(GETNUM(CFLAG,"합체조건있음")),0) == 1
		CONTINUE
	SIF CSVCFLAG(LOCAL:6,(GETNUM(CFLAG,"특수합체만")),0) == 1
		CONTINUE
	SIF CSVABL(LOCAL:6, GETNUM(ABL, "종족")) <= 0
		CONTINUE
	SIF CSVABL(LOCAL:6, GETNUM(ABL, "종족")) >= 45
		CONTINUE
	SIF CSVBASE(LOCAL:6,(GETNUM(BASE, "LV")),0) < ARG:1
		CONTINUE
	SIF CSVBASE(LOCAL:6,(GETNUM(BASE, "LV")),0) > ARG:2
		CONTINUE

	;こっからピックアップ検出
	IF ARG:3 > 0
		;LOCAL:4が0なら真の時、1なら偽の時スルー出来る。
		LOCAL:4 = ARG:3 / 10000000
		;1は素質
		IF (ARG:3 % 10000000) / 1000000 == 1
			SIF CSVTALENT(LOCAL:6, (ARG:3 % 1000000) , 0) && LOCAL:4 == 0
				CONTINUE
			SIF !CSVTALENT(LOCAL:6, (ARG:3 % 1000000) , 0) && LOCAL:4 == 1
				CONTINUE

		;5はアライメント
		ELSEIF (ARG:3 % 10000000) / 1000000 == 5
			;余り1はライト
			SIF (ARG:3 % 1000000) == 1 && CSVABL(LOCAL:6, GETNUM(ABL, "속성LD")) == 1 && LOCAL:4 == 0
				CONTINUE
			SIF (ARG:3 % 1000000) == 1 && !(CSVABL(LOCAL:6, GETNUM(ABL, "속성LD")) == 1) && LOCAL:4 == 1
				CONTINUE
			;余り2はロウ
			SIF (ARG:3 % 1000000) == 2 && CSVABL(LOCAL:6, GETNUM(ABL, "속성LC")) == 3 && LOCAL:4 == 0
				CONTINUE
			SIF (ARG:3 % 1000000) == 2 && !(CSVABL(LOCAL:6, GETNUM(ABL, "속성LC")) == 3) && LOCAL:4 == 1
				CONTINUE
			;余り3はカオス
			SIF (ARG:3 % 1000000) == 3 && CSVABL(LOCAL:6, GETNUM(ABL, "속성LC")) == 3 && LOCAL:4 == 0
				CONTINUE
			SIF (ARG:3 % 1000000) == 3 && !(CSVABL(LOCAL:6, GETNUM(ABL, "속성LC")) == 3) && LOCAL:4 == 1
				CONTINUE
			;余り4はダーク
			SIF (ARG:3 % 1000000) == 4 && CSVABL(LOCAL:6, GETNUM(ABL, "속성LD")) == 1 && LOCAL:4 == 0
				CONTINUE
			SIF (ARG:3 % 1000000) == 4 && !(CSVABL(LOCAL:6, GETNUM(ABL, "속성LD")) == 1) && LOCAL:4 == 1
				CONTINUE
		ENDIF

	ENDIF

	LOCAL:2++
	;ここまで通ったなら抽選チャンス
	IF LOCAL:1 < 0
		;これが初めてならそのまま入力
		LOCAL:1 = LOCAL:6
	ELSE
		LOCAL:3 = RAND:(LOCAL:2 * 100)
		SIF LOCAL:3 >= 100
			CONTINUE
		LOCAL:1 = LOCAL:6
	ENDIF
NEXT

;ガチャ失敗を返す
SIF LOCAL:1 <= 0
	RETURN -1

;ここまで来たら成功なのでキャラ番号を返す
RETURN LOCAL:1

;=================================================
;対象アイテムサーチ(ARG:1=金額上限、ARG:3=マニーか魔貨か)
;帰す値はアイテムNO、失敗したら-1帰す
;ARG:3は0で￥、1で魔貨
;ただしXが1の時はYの条件がそれではない時を見る
;=================================================
@GACHA_SEARCH_ITEM, ARG:1=25, ARG:3 = 0


;LOCAL:1番が選出されたアイテムのNO
LOCAL:1 = -1
;LOCAL:2番が選出された総数
LOCAL:2 = 0
;LOCAL:3番が候補になったアイテムのRAND抽選用
LOCAL:3 = 0
;LOCAL:4番は0:￥か1:魔貨か。
LOCAL:4 = ARG:3
;LOCAL:5番はARG:1の記録
LOCAL:5 = ARG:1
;SIF LOCAL:5 < 15
;	LOCAL:5 = 15
;SIF LOCAL:5 < 75 && LOCAL:4 == 0
;	LOCAL:5 = 75
;LOCAL:6はFORループ用
LOCAL:6 = 0

;３分の１で装備、３分の２で消耗品。
LOCAL:3 = RAND:9999
IF (LOCAL:3 % 3) == 0
	;FOR LOCAL:6,2000,VARSIZE("ITEM") EDIT 002 MOD
	FOR LOCAL:6, MIN_EQUIPNUM, MAX_EQUIPNUM
		SIF ITEMPRICE:(LOCAL:6) < 10 || ITEMPRICE:(LOCAL:6) > LOCAL:5
			CONTINUE
		RESULT = 0
		IF LOCAL:4 == 0
			TRYCALLFORM 購入条件_{LOCAL:6}
			SIF RESULT == 0
				CONTINUE
		ELSE
			TRYCALLFORM EQUIP_EXCHANGE_{LOCAL:6}
			SIF RESULT == 0
				CONTINUE
		ENDIF
		RESULT = 12
		TRYCALLFORM 装備箇所_{(LOCAL:6)}
		SIF RESULT < 0 && RESULT > 7
			CONTINUE

		LOCAL:2++
		;ここまで通ったなら抽選チャンス
		IF LOCAL:1 < 0
			;これが初めてならそのまま入力
			LOCAL:1 = LOCAL:6
		ELSE
			LOCAL:3 = RAND:(LOCAL:2 * 100)
			SIF LOCAL:3 >= 100
				CONTINUE
			LOCAL:1 = LOCAL:6
		ENDIF
	NEXT
ELSE
	;FOR LOCAL:6,1000,2000 EDIT 002 MOD
	FOR LOCAL:6, MIN_USEITEMNUM, MAX_USEITEMNUM
		SIF ITEMPRICE:(LOCAL:6) < 10 || ITEMPRICE:(LOCAL:6) > LOCAL:5
			CONTINUE
		RESULT = 0
		IF LOCAL:4 == 0
			TRYCALLFORM 道具購入条件_{LOCAL:6 +2000}
			SIF RESULT == 0
				CONTINUE
		ELSE
			TRYCALLFORM ITEM_EXCHANGE_{LOCAL:6 +2000}
			SIF RESULT == 0	
				CONTINUE
		ENDIF

		LOCAL:2++
		;ここまで通ったなら抽選チャンス
		IF LOCAL:1 < 0
			;これが初めてならそのまま入力
			LOCAL:1 = LOCAL:6
		ELSE
			LOCAL:3 = RAND:(LOCAL:2 * 100)
			SIF LOCAL:3 >= 100
				CONTINUE
			LOCAL:1 = LOCAL:6
		ENDIF
	NEXT
ENDIF

;ガチャ失敗を返す
SIF LOCAL:1 <= 0
	RETURN -1

;ここまで来たら成功なのでアイテム番号を返す
RETURN LOCAL:1
