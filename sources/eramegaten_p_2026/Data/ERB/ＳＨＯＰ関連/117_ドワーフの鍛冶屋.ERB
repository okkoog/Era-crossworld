@戦闘能力修正_改造装備, ARG, ARG:1, ARG:2 = -1
#LOCALSIZE 1
CALLFORM 戦闘能力修正_{ベース装備番号:ARG}, ARG:1, ARG:2
LOCAL = RESULT
SELECTCASE ARG
	CASE 0 TO 9
		SELECTCASE ARG:1
			CASE 0, 1, 4
				LOCAL += プラス数:0
			CASE 5
				LOCAL += プラス数:0 / 2
		ENDSELECT
		LOCAL += 能力値強化:ARG:(ARG:1) * 10
	CASE 10 TO 19
		LOCAL += 能力値強化:ARG:(ARG:1) * 10
	CASE 20 TO 59
		SELECTCASE ARG:1
		CASE 2, 3
			LOCAL += プラス数:ARG
		CASE 5
			LOCAL += プラス数:ARG / 2
		ENDSELECT
		LOCAL += 能力値強化:ARG:(ARG:1) * 5
ENDSELECT
RETURN LOCAL

@防御相性_改造装備,ARG, ARG:1, ARG:2 = -1
#LOCALSIZE 2
CALLFORM 防御相性_{ベース装備番号:ARG}, ARG:1, ARG:2
LOCAL = RESULT
SELECTCASE ARG
	CASE 20 TO 59
		SIF LOCAL == 100
			RETURN LOCAL
		SIF ARG:1 > 16
			RETURN LOCAL
		IF LOCAL > 0 && LOCAL != 999 && 属性耐性強化:ARG:(ARG:1)
			LOCAL:1 = 0
			SIF LOCAL > 100
				LOCAL:1 = 100
			LOCAL = MAX(LOCAL:1, LOCAL - 属性耐性強化:ARG:(ARG:1) * 20)
		ENDIF
ENDSELECT
RETURN LOCAL

