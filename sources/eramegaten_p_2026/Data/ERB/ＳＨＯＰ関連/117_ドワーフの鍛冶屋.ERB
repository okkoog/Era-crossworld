IF 軽量化数(ARG)
	CALLFORM 装備条件_{ベース装備番号:ARG}, ARG:1
	LOCAL = RESULT
	SIF LOCAL > 0
		GOTO END
	LOCAL:10 = ABL:(ARG:1):속성LD
	LOCAL:11 = ABL:(ARG:1):속성LC
	;LOCAL:12 = TALENT:(ARG:1):남자

	$LP
	IF 装備アライメント軽量化:ARG > 0
		FOR LOCAL:1, 0, 9
			ABL:(ARG:1):속성LD = LOCAL:1 / 3 + 1
			ABL:(ARG:1):속성LC = LOCAL:1 % 3 + 1
			TRYCCALLFORM 装備条件_{ベース装備番号:ARG}, ARG:1
				LOCAL = RESULT
				SIF LOCAL > 0
					GOTO END2
			CATCH
				GOTO END2
			ENDCATCH
		NEXT
	ELSE
		TRYCCALLFORM 装備条件_{ベース装備番号:ARG}, ARG:1
			LOCAL = RESULT
			SIF LOCAL > 0
				GOTO END2
		CATCH
			GOTO END2
		ENDCATCH
	ENDIF
	;IF 装備男女軽量化:ARG > 0 && LOCAL == 0 && TALENT:(ARG:1):남자 == LOCAL:12
	;	TALENT:(ARG:1):남자 = !TALENT:(ARG:1):남자
	;	GOTO LP
	;ENDIF
	$END2
	ABL:(ARG:1):속성LD = LOCAL:10
	ABL:(ARG:1):속성LC = LOCAL:11
	;TALENT:(ARG:1):남자 = LOCAL:12
	$END
	RETURN LOCAL
ENDIF
