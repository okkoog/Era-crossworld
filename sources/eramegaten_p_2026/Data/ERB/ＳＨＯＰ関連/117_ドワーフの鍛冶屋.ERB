@SHOPCOMABLE_117
SIF !IS_USEABLE_SHOPCOM
	RETURN 0
IF 鍛冶屋見直し == 0
	FOR LOCAL,0,60
		FOR LOCAL:1,0,8
			能力値強化:LOCAL:(LOCAL:1) = 能力値強化:LOCAL:(LOCAL:1) / 10
		NEXT
		FOR LOCAL:1,0,7
			パラメータ強化:LOCAL:(LOCAL:1) = パラメータ強化:LOCAL:(LOCAL:1) / 4
		NEXT
		FOR LOCAL:1,0,17
			属性耐性強化:LOCAL:(LOCAL:1) = 属性耐性強化:LOCAL:(LOCAL:1) / 35
		NEXT
		FOR LOCAL:1,0,21
			バステ耐性強化:LOCAL:(LOCAL:1) = バステ耐性強化:LOCAL:(LOCAL:1) / 50
		NEXT
		
	NEXT
	鍛冶屋見直し = 1
ENDIF
IF 鍛冶屋見直し < 2
	FOR LOCAL,0,60
		강화횟수:LOCAL += 装備軽量化:LOCAL
	NEXT
	鍛冶屋見直し = 2
ENDIF
IF 鍛冶屋見直し < 3
	FOR LOCAL,0,60
		SIF ベース装備番号:LOCAL < 1
			CONTINUE
		CALL プラス上限,ベース装備番号:LOCAL
		IF プラス数:LOCAL > RESULT
			プラス数:LOCAL = RESULT
			PRINTFORMW %改造装備名称(LOCAL)%의 플러스 상한이 변경되었습니다
		ENDIF
		
		LOCAL:2 = 0
		FOR LOCAL:1,0,6
			LOCAL:2 += 能力値強化:LOCAL:(LOCAL:1)
			能力値強化:LOCAL:(LOCAL:1) = 0
		NEXT
		IF LOCAL:2 > 0
			강화횟수:LOCAL -= LOCAL:2
			RESULT = 1
			TRYCALLFORM 必要レベル_{改造装備アイテムナンバー(LOCAL)}
			RESULT = MIN(MAX(1,RESULT),99)
			MONEY += RESULT * 500 * LOCAL:2 * 3 / 2
			PRINTFORML %改造装備名称(LOCAL)%의 사양 변경으로 인해 능력치 강화가 사라져
			PRINTFORMW ￥{RESULT * 500 * LOCAL:2 * 3 / 2}을(를) 획득했습니다.
		ENDIF
		
		LOCAL:2 = 0
		FOR LOCAL:1,1,7
			IF パラメータ強化:LOCAL:(LOCAL:1) > 10
				LOCAL:2 += パラメータ強化:LOCAL:(LOCAL:1) - 10
				パラメータ強化:LOCAL:(LOCAL:1) = 10
			ENDIF
		NEXT
		IF LOCAL:2 > 0
			강화횟수:LOCAL -= LOCAL:2
			RESULT = 1
			TRYCALLFORM 必要レベル_{改造装備アイテムナンバー(LOCAL)}
			RESULT = MIN(MAX(1,RESULT),99)
			MONEY += RESULT * 500 * LOCAL:2 * 11 / 10
			PRINTFORML %改造装備名称(LOCAL)%의 패러미터 강화 사양 변경으로 인해
			PRINTFORMW ￥{RESULT * 500 * LOCAL:2 * 11 / 10}을(를) 획득했습니다.
		ENDIF
	NEXT
	鍛冶屋見直し = 3
ENDIF
;------ ADD 002 -------
FOR LOCAL,0,60
	IF ベース装備番号:LOCAL > 0 && ITEM:(改造装備アイテムナンバー(LOCAL)) < 1 && EQUIPMENT_COUNT(改造装備アイテムナンバー(LOCAL)) < 1
		PRINTFORMW %改造装備名称(LOCAL)%을(를) 분실했으므로 개조를 해제합니다.
		CALL 改造装備解除,LOCAL
	ENDIF
	;---- EDIT 008 ADD START -------------------------
	IF ベース装備番号:LOCAL > 0 && ITEMNAME:(ベース装備番号:LOCAL) == ""
		PRINTFORMW %改造装備名称(LOCAL)%의 원본 아이템이 소거되었으므로 개조를 해제합니다.
		CALL 改造装備解除,LOCAL
		LOCAL:2 = 改造装備アイテムナンバー(LOCAL)
		IF ITEM:(LOCAL:2) > 0
			ITEM:(LOCAL:2) = 0
		ELSE
			FOR LOCAL, 0, 8
				FOR LOCAL:1, 0, CHARANUM
					IF EQUIP:(LOCAL:1):GET_EQUIP(LOCAL) == LOCAL:2
						EQUIP:(LOCAL:1):GET_EQUIP(LOCAL) = 0
						BREAK
					ENDIF
				NEXT
			NEXT
		ENDIF
	ENDIF
	;---- EDIT 008 ADD END ---------------------------
NEXT

RESULT:1 = 1
SIF !FLAG:드워프대장장이해금
	RETURN 0
IF イベントフラグ:33:1 == 4 || FLAG:DEBUG
	RESULTS = 드워프의대장간
	RETURN 1
ELSE
	RESULTS = ？？？？？
	RETURN 0
ENDIF

