@BTL_TRAINING_UP_FUNCTION
PRINTFORML 훈련할 동료마를 선택해주세요。
PRINTFORML 선택된 동료마는 ＥＸＰ와 ＭＡＧ를 획득합니다。
PRINTFORML 획득량은 지금까지의 %CALLNAME:MASTER%의 전투경험과 %CALLNAME:MASTER%와의 ALI등에 의한 상성에 따라 결정됩니다。
PRINTFORM 훈련을 실행하면 조교가능횟수가 1회 소모됩니다。
SIF A > リスト表示数()
	PRINTFORM ＜page.{P + 1}/{A / リスト表示数() + 1}＞
PRINTL

@SHOP_COM_215, ARG
#DIM DYNAMIC L_GET_EXP
#DIM DYNAMIC L_GET_MAG
#DIM DYNAMIC L_FRIEND
#DIM DYNAMIC TEMP_EXP
#DIM DYNAMIC CNT_LVUP
CALL INPUT_CHARA_LIST("", "", "CASTING_BTL_TRAINING", "BTL_TRAINING_UP_FUNCTION")
SIF RESULT == 1000
	RETURN 0
L_FRIEND = RESULT

;6人割でEXPは1/6 MAGは1/20が基準として20匹撃破相当の経験値と50匹相当のMAGを与える
L_GET_MAG = GET_BASE_ENEMY_MAG( , FLAG:누적기준LV, GET_RACE_NUM("요정")) * 50 / 20
L_GET_MAG = L_GET_MAG * GET_RELATION(L_FRIEND, MASTER) / 100
IF GET_ROLE_PROP("NEXT_EXP", L_FRIEND) < 0
	L_GET_EXP = 0
	PRINTFORML %CALLNAME:L_FRIEND%에게 {L_GET_MAG}MAG를 획득하게 됩니다。
ELSE
	L_GET_EXP = GET_BASE_ENEMY_EXP( , FLAG:누적기준LV, GET_RACE_NUM("요정")) * 20 / 6
	;相性補正。原則的にはALIなので50％～150％の間
	L_GET_EXP = L_GET_EXP * GET_RELATION(L_FRIEND, MASTER) / 100

	TEMP_EXP = MIN(BASE:L_FRIEND:ＥＸＰ + L_GET_EXP, BASE:MASTER:ＥＸＰ)

	;マスターのEXPは越えられない
	L_GET_EXP = TEMP_EXP - BASE:L_FRIEND:ＥＸＰ
	CNT_LVUP = 0
	WHILE TEMP_EXP >= GET_NEXT_EXP(L_FRIEND, BASE:L_FRIEND:LV + CNT_LVUP)
		CNT_LVUP += 1
	WEND
	IF !CNT_LVUP
		IF L_GET_EXP <= 0
			PRINTFORMW %CALLNAME:MASTER%의 전투경험이 부족하여 EXP를 얻지 못하고、{L_GET_MAG}MAG만을 획득하게 됩니다。
		ELSE
			PRINTFORML %CALLNAME:L_FRIEND%에게 {L_GET_EXP}EXP와 {L_GET_MAG}MAG를 획득하게 됩니다。
		ENDIF
	ELSE
		PRINTFORML %CALLNAME:L_FRIEND%의 LV이 {CNT_LVUP}상승하고、추가로{L_GET_MAG}MAG를 획득하게 됩니다。
	ENDIF
ENDIF
PRINTFORML 전투훈련을 실행하시겠습니까？
PRINTL [0] 네
PRINTL [1] 아니오
CALL INPUTINT, 0, 1
SIF RESULT == 1
	RESTART
BASE:L_FRIEND:ＥＸＰ = TEMP_EXP
CALL CHECK_LEVEL_UP, L_FRIEND
CALL CONTROL_MAG, L_FRIEND, L_GET_MAG
FLAG:조교실행완료횟수 += 1
BEGIN TURNEND

