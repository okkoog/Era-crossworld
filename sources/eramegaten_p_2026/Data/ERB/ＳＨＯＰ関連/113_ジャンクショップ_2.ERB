;=================================================
;   sub _RPG_SHOP_SET_CONSTANT
;=================================================
;   RPG SHOP:定数設定
;-------------------------------------------------
;   RPG SHOP内で共通使用する定数を設定する
;-------------------------------------------------
; Input:
;  ARG:0				画面モード(1:纏め買い(小size) 2:纏め買い(大size))
;  ARG:1				通貨(0:￥ 1:魔貨 그외:0で処理)
; Output:
;  C					配列:定数(C100番台)
;-------------------------------------------------
@_RPG_SHOP_SET_CONSTANT,ARG:0,ARG:1

;set:C100番台(定数Constant)
;C:100;ページ単位の表示数
;C:101;MAX:装備・弾丸購入可能数
;MIN_USEITEMNUM;MIN:アイテム番号
;MAX_USEITEMNUM;MAX:アイテム番号
;C:104;コマンド:購入
C:100 = 9
C:101 = 999
C:104 = 100

;C:110;画面モード(1:小size 2:大size)
;※大小が逆転している。注意！
IF ARG:0 == 1
	C:110 = 2
ELSE
	C:110 = 1
ENDIF

;C:111;通貨(0:￥ 1:魔貨)
IF ARG:1 == 1
	C:111 = 1
ELSE
	C:111 = 0
ENDIF


;=================================================
;   sub _RPG_ITEMLIST_MAKE_NOMAL
;=================================================
;   購入可能アイテム設定:通常
;-------------------------------------------------
;   アイテムの内、購入条件を満たす
;   値段1以上のアイテムを諸変数に設定する
;-------------------------------------------------
; Input:
;  ARG					アイテムカテゴリ
; Output:
;  RESULT				アイテム数
;  アイテムリスト		配列:アイテム番号
;  ITEMSALES			配列:アイテム値段
;-------------------------------------------------
@_RPG_ITEMLIST_MAKE_NOMAL,ARG
#LOCALSIZE 3
VARSET アイテムリスト,-1
VARSET ITEMSALES,0
LOCAL:1 = 0

;8未満は装備品・弾薬
IF ARG < 8
	FOR LOCAL,MAX_USEITEMNUM,VARSIZE("ITEM")
		SIF ITEMPRICE:LOCAL == 0
			CONTINUE
		RESULT = 12
		TRYCCALLFORM 装備箇所_{LOCAL}
			IF RESULT == ARG
				TRYCCALLFORM 購入条件_{LOCAL}
					IF RESULT == 1
						アイテムリスト:(LOCAL:1) = LOCAL
						LOCAL:1 += 1
					ENDIF
				CATCH
					CONTINUE
				ENDCATCH
			ENDIF
		CATCH
		ENDCATCH
	NEXT
;上記以外はアイテム
ELSE
	FOR LOCAL,MIN_USEITEMNUM,MAX_USEITEMNUM
		SIF ITEMPRICE:LOCAL == 0
			CONTINUE
		TRYCCALLFORM 道具購入条件_{LOCAL+2000}
			IF RESULT == 1
				アイテムリスト:(LOCAL:1) = LOCAL
				LOCAL:1 += 1
			ENDIF
		CATCH
			CONTINUE
		ENDCATCH
	NEXT
ENDIF
;価格の登録
FOR LOCAL , 0 , FINDELEMENT(アイテムリスト , -1)
	ITEMSALES:(アイテムリスト:LOCAL) = ITEMPRICE:(アイテムリスト:LOCAL)
NEXT
CALL EQUIP_SORT
RETURN LOCAL:1

;=================================================
;   sub _RPG_ITEMLIST_MAKE_EXCHANGE
;=================================================
;   購入可能アイテム設定:交換
;-------------------------------------------------
;   アイテムの内、購入条件を満たす
;   値段1以上のアイテムを諸変数に設定する
;-------------------------------------------------
; Input:
;  ARG					アイテムカテゴリ
; Output:
;  RESULT				アイテム数
;  アイテムリスト		配列:アイテム番号
;  ITEMSALES			配列:アイテム値段
;-------------------------------------------------
@_RPG_ITEMLIST_MAKE_EXCHANGE,ARG
#LOCALSIZE 3
VARSET アイテムリスト,-1
VARSET ITEMSALES,0
LOCAL:1 = 0

;8未満は装備品・弾薬
IF ARG < 8
	FOR LOCAL,MAX_USEITEMNUM,VARSIZE("ITEM")
		SIF ITEMPRICE:LOCAL == 0
			CONTINUE
		RESULT = 12
		TRYCCALLFORM 装備箇所_{LOCAL}
			IF RESULT == ARG
				RESULT = 0
				TRYCALLFORM EQUIP_EXCHANGE_{LOCAL}
				SIF RESULT == 0
					CONTINUE
				アイテムリスト:(LOCAL:1) = LOCAL
				LOCAL:1 += 1
			ENDIF
		CATCH
		ENDCATCH
	NEXT
;上記以外はアイテム
ELSE
	FOR LOCAL,MIN_USEITEMNUM,MAX_USEITEMNUM
		SIF ITEMPRICE:LOCAL == 0
			CONTINUE
		RESULT = 0
		TRYCALLFORM ITEM_EXCHANGE_{LOCAL+2000}
		SIF RESULT == 0
			CONTINUE
		アイテムリスト:(LOCAL:1) = LOCAL
		LOCAL:1 += 1
	NEXT
ENDIF
;価格の登録
FOR LOCAL , 0 , FINDELEMENT(アイテムリスト , -1)
	ITEMSALES:(アイテムリスト:LOCAL) = ITEMPRICE:(アイテムリスト:LOCAL)
NEXT
CALL EQUIP_SORT
RETURN LOCAL:1


