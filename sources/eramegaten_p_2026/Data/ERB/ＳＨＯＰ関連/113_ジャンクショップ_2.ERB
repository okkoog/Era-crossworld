;=================================================
;   sub RPG_SHOP_NOMAL
;=================================================
;   アイテム購入:通常
;-------------------------------------------------
;   汎用SHOP画面
;   SHOPモードにより、品揃えと通貨(￥と魔貨)が自動決定される
;-------------------------------------------------
; Input:
;  ARG:0				画面モード(1:纏め買い(大size) 2:纏め買い(小size))
;  ARG:1				SHOPモード(0:ジャンクSHOP 1:마카교환)
;-------------------------------------------------
@RPG_SHOP_NOMAL,ARG:0,ARG:1

;通貨設定(SHOPモードで分岐)
IF  ARG:1 == 1
	LOCAL = 1
ELSE
	LOCAL = 0
ENDIF

;RPG SHOP:定数設定
CALL _RPG_SHOP_SET_CONSTANT,ARG:0,LOCAL

IF C:111 == 1
	PRINTFORML 현재 {MONEY:1}마카 있습니다。
	PRINTL 무엇과 교환하시겠습니다？
ELSE
	PRINTFORML 무엇을 구입하시겠습니까？		소지금 ￥{MONEY} \@!FLAG:정크포인트미사용 ? 정크포인트 JP{MONEY:4} # \@
ENDIF
DRAWLINE
FOR LOCAL,0,8
	PRINTFORML [{LOCAL}] %GET_EQUIP(LOCAL)%
NEXT
PRINTL [8] 아이템
PRINTL [99]정렬조건 변겅
PRINTL [100] 돌아간다
PRINTL 
PRINTL [999] 가게를 나간다 

$INPUT_LOOP
INPUT

IF RESULT == 100
	;戻る
	RETURN -1
ELSEIF RESULT == 999
	;店を出る
	RETURN 0
ELSEIF RESULT == 99
	;ソート条件変更
	CALL CHANGE_CONDITION_EQUIP_SORT
	RESTART
ELSEIF RESULT >= 0 && RESULT < 9
	;武器防具アイテム購入
	LOCAL = RESULT

	IF C:111 == 1
		CALL _RPG_ITEMLIST_MAKE_EXCHANGE,RESULT
	ELSE
		CALL _RPG_ITEMLIST_MAKE_NOMAL,RESULT
	ENDIF

	;アイテム数保持
	LOCAL:1 = RESULT
ELSE
	GOTO INPUT_LOOP
ENDIF

;アイテム購入:受付
CALL RPG_SHOP_COUNTER,LOCAL:1

RESTART

;=================================================
;   sub RPG_SHOP_DUNGEON
;=================================================
;   アイテム購入:ダンジョン
;-------------------------------------------------
;   ダンジョンSHOP画面
;   商品名と商品価格をsetする事で、販売画面を出力する
;-------------------------------------------------
; Input:
;  ARG:0				SHOPモード(0:￥取引 1:마카교환)
;  ARGS:1～19			商品名
;  ARG:1～19			商品価格
; Output:
;  RESULT				結果(0:正常終了 1:画面モード変更(通常) )
;-------------------------------------------------
@RPG_SHOP_DUNGEON(ARG:0, ARGS:1, ARG:1, ARGS:2, ARG:2 , ARGS:3, ARG:3, ARGS:4, ARG:4, ARGS:5, ARG:5, ARGS:6, ARG:6, ARGS:7, ARG:7, ARGS:8, ARG:8, ARGS:9, ARG:9, ARGS:10, ARG:10, ARGS:11, ARG:11, ARGS:12, ARG:12, ARGS:13, ARG:13, ARGS:14, ARG:14, ARGS:15, ARG:15, ARGS:16, ARG:16, ARGS:17, ARG:17, ARGS:18, ARG:18, ARGS:19, ARG:19)
#LOCALSIZE 5
;LOCAL:3;画面モード(1:纏め買い(小size) 2:纏め買い(大size))
LOCAL:3 = 2
;LOCAL:4 アイテムの数え上げ

;通貨設定(SHOPモードで分岐)
IF ARG:0 == 1
	LOCAL = 1
ELSE
	LOCAL = 0
ENDIF

;画面モード:初回訪問時
;CALL RPG_SHOP_SCREENMODE_DEFAULT

$RESTART

;RPG SHOP:定数設定
CALL _RPG_SHOP_SET_CONSTANT,LOCAL:3,LOCAL

;アイテムリスト:作成
VARSET アイテムリスト,-1
VARSET ITEMSALES,0
LOCAL:1 = 0
LOCAL:4   = 1
E = 0
WHILE 1
	;CHK:アイテム
	IF STRLENS(ARGS:(LOCAL:4)) != 0
		LOCAL:2 = GETNUM(ITEM, ARGS:(LOCAL:4))
		;エラーの場合
		IF LOCAL:2 == -1
			PRINTFORML 【ERR!】아이템'%ARGS:(LOCAL:4)%'은(는) ITEM.csv에 존재하지 않으므로, 판매 목록에서 제외됩니다.
			E += 1
		ELSE
			アイテムリスト:(LOCAL:1) = LOCAL:2
			ITEMSALES:(LOCAL:2) = ARG:(LOCAL:4) ? ARG:(LOCAL:4) # ITEMPRICE:(LOCAL:2)
			LOCAL:1 += 1
		ENDIF
	ELSE
		BREAK
	ENDIF
	LOCAL:4 += 1
WEND

IF E
	PRINTL 함수 『@RPG_SHOP_DUNGEON』에서 에러를 감지했습니다.
	PRINTL 인수 또는 csv, 또는 처리에 문제가 없는지 관리자에게 문의해 주십시오.
	PRINTL (에러가 발생한 아이템은 판매 대상에서 제외되었습니다.)
ENDIF

;画面判定
IF FLAG:SHOP화면모드설정 == 0
	RETURN 1
ELSE
	;アイテム購入:受付
	CALL RPG_SHOP_COUNTER,LOCAL:1,1
	IF RESULT == 1
		;画面モード切り替え
		LOCAL:3 = FLAG:SHOP화면모드설정
		GOTO RESTART
	ENDIF
ENDIF

RETURN 0

