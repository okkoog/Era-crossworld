;  Z					配列:購入数
;-------------------------------------------------
@_RPG_ITEMLIST_PRINT,ARG,
#DIM LCOUNT
;通貨設定
;LOCALS:0;通貨単位
;LOCALS:1;通貨文字(先頭付加)
;LOCALS:2;通貨文字(末尾付加)
;LOCALS:50;取引名称
IF C:111 == 1
	LOCALS:0 = 마카
	LOCALS:1 = 
	LOCALS:2 = 마카
	LOCALS:50 = 교환
ELSE
	LOCALS:0 = 금액
	LOCALS:1 = ￥
	LOCALS:2 = 
	LOCALS:50 = 구입
