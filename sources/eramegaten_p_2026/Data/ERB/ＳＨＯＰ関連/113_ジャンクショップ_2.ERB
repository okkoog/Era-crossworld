;   sub RPG_SHOP_SCREENMODE_CHANGE
;=================================================
;   画面モード:変更
;-------------------------------------------------
; Input:
;  M:0
;-------------------------------------------------
@RPG_SHOP_SCREENMODE_CHANGE
;画面モード変更
;IF M:0 == 0
;	M:0 = 2
;ELSEIF M:0 == 2
;	M:0 = 1
;ELSE
;	M:0 = 0
;ENDIF

;フラグがふたつ絡んでるのでちょっとめんどくさい
