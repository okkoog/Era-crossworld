	PRINT ITEM_NO |      아이템명     | 
	PRINTFORM %LOCALS:0% | 
	PRINTL 소지수/최대수 ||================== 입력 폼 ==================|| 구입수 | 구입비용
ELSE
	PRINT         아이템명     | 
	PRINTFORM  %LOCALS:0%  | 
	PRINTL 소지수 ||=========== 입력 폼 ==========|| 구입수 | 구입비용
ENDIF

FOR LOCAL,P*LOCAL:10,MIN(P*LOCAL:10+LOCAL:10,ARG)

	;取得:アイテム所持最大数
	CALL _GET_RPG_ITEM_NUM_MAX,アイテムリスト:(LOCAL)
	LOCAL:3 = RESULT

	;Head
	IF C:110 == 1
		PRINTFORM [{LOCAL+1000}] | %ITEMNAME:(アイテムリスト:LOCAL),20,LEFT% |
	ELSE
		LOCALS:20 = [{LOCAL+1000}]%ITEMNAME:(アイテムリスト:LOCAL)%
		STRLENS LOCALS:20
		LOCAL:20 = RESULT
		IF LOCAL:20 > 22
			SUBSTRING LOCALS:20,0,20
			LOCALS:20 = %RESULTS%..
		ENDIF
		PRINTFORM %LOCALS:20,22,LEFT% |
	ENDIF
	;---- EDIT 011 MOD START -------------------------
	PRINTFORM %LOCALS:1 + TOSTR(ITEMSALES:(アイテムリスト:LOCAL)) + LOCALS:2,10 % | 
	PRINTFORM %TOSTR(GET_HAVE_ITEM_NUM(アイテムリスト:LOCAL)),3 %
	;PRINTFORM %TOSTR(ITEM:(アイテムリスト:LOCAL)),3 %
	;---- EDIT 011 MOD END ---------------------------
	
	SIF C:110 == 1
		PRINTFORM /%TOSTR(LOCAL:3),3 %
	PRINTFORM  || 

	;FORM
	PRINTFORM [{(LOCAL:2+1)*10 +1}] +10 
	SIF C:110 == 1
		PRINTFORM [{(LOCAL:2+1)*10 +2}] +5 
	PRINTFORM [{(LOCAL:2+1)*10 +3}] +1 
	PRINTFORM [{(LOCAL:2+1)*10 +4}] -1 
	SIF C:110 == 1
		PRINTFORM [{(LOCAL:2+1)*10 +5}] -5 
	PRINTFORM [{(LOCAL:2+1)*10 +6}] -10 
	PRINT || 

	;購入数
	LOCAL:4 = Z:(アイテムリスト:LOCAL)
	PRINTFORM %TOSTR(LOCAL:4),3 %개 |
	PRINTFORM %LOCALS:1 + TOSTR(ITEMSALES:(アイテムリスト:LOCAL) * LOCAL:4) + LOCALS:2,10 %

	PRINTL 

	LOCAL:1 += 1
	LOCAL:2 += 1
NEXT

;合計行
LOCAL:1 = 0
LOCAL:2 = 0
FOR LCOUNT, 0, ARG

	LOCAL:4 = Z:(アイテムリスト:LCOUNT)
	;全件加算
	LOCAL:1 += LOCAL:4
	LOCAL:2 += ITEMSALES:(アイテムリスト:LCOUNT) * LOCAL:4


NEXT

PRINTFORML 총 %LOCALS:50% 아이템 수 {LOCAL:1}개
IF C:111 == 1
	PRINTFORML 총 %LOCALS:50% 비용 {LOCAL:2}마카
ELSE
	PRINTFORML 총 %LOCALS:50% 비용 ￥{LOCAL:2}
ENDIF
PRINTL
PRINTFORML [{C:104}]일괄 %LOCALS:50%하기

DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 13% # [7]이전페이지\@
PRINTLC [0]돌아간다 [1]정렬 조건 변경
PRINTFORMLC \@(P >= (ARG-1) / C:100) ? %" " * 13% # [9]다음페이지\@

;=================================================
;   sub _GET_RPG_ITEM_NUM_MAX
;=================================================
;   取得:アイテム所持最大数
;-------------------------------------------------
; Input:
;  ARG					アイテムID
;  C					配列:定数(100番台)
; Output:
;  RESULT				アイテム所持最大数
;-------------------------------------------------
@_GET_RPG_ITEM_NUM_MAX,ARG

LOCAL:3 = 0

;CHK:装備品・弾丸
TRYCCALLFORM 装備箇所_{ARG}

	;7:탄환
	IF RESULT == 7
		LOCAL:3 = C:101
	;弾丸以外は装備品
	ELSE
		LOCAL:3 = C:101
	ENDIF
	
;CHK:上記以外はアイテム
CATCH
	CALL GET_ITEMMAX, ARG
	LOCAL:3 = RESULT

ENDCATCH
RETURN LOCAL:3

;=================================================
;   sub _GET_RPG_ITEM_EXP
;=================================================
;   取得:アイテム説明
;-------------------------------------------------
; Input:
;  ARG					アイテムID
;-------------------------------------------------
@_GET_RPG_ITEM_EXP,ARG

;CHK:装備品・弾丸
TRYCCALLFORM 装備箇所_{ARG}

	;7:탄환
	IF RESULT == 7
		CALLFORM 装備解説_{ARG}

	;弾丸以外は装備品
	ELSE
		CALL 装備説明,ARG
	ENDIF

;CHK:上記以外はアイテム
CATCH

	PRINTFORML %ITEMNAME:(ARG),20,LEFT%
	SIF FLAG:스킬속성표시설정 == 1
		CALL SKILL_EXPLAIN_PERFORMANCE, ARG + MAX_USEITEMNUM, -1
	CALL GET_SKILL_PROP, "SKILL_EXPLAIN", ARG+2000, -1
	DRAWLINE

ENDCATCH
WAIT

;=================================================
;   sub _EXE_RPG_ITEM_BUY
;=================================================
;   実行:アイテム購入
;-------------------------------------------------
; Input:
;  ARG					アイテム数
;  アイテムリスト		配列:アイテム番号
;  DE					配列:購入数
;  C					配列:定数(100番台)
;-------------------------------------------------
@_EXE_RPG_ITEM_BUY,ARG
#DIM LCOUNT
;通貨設定
;LOCALS:50;取引名称
IF C:111 == 1
	LOCALS:50 = 交換
ELSE
	LOCALS:50 = 購入
ENDIF
;合計
LOCAL:1 = 0
LOCAL:2 = 0

;CHK:ERR
FOR LCOUNT, 0, ARG

	LOCAL:4 = Z:(アイテムリスト:LCOUNT)
	;全件加算
	LOCAL:1 += LOCAL:4
	LOCAL:2 += ITEMSALES:(アイテムリスト:LCOUNT) * LOCAL:4

NEXT

IF LOCAL:2 == 0
	PRINTW 아이템이 선택되지 않았습니다.
	RETURN
ELSE

	IF C:111 == 1 && MONEY:1 < LOCAL:2
		PRINTFORMW 마카가 부족합니다 (%LOCALS:50% 비용 {LOCAL:2}마카 / 소지 마카 {MONEY:1})
		RETURN
	ELSEIF  C:111 == 0 && (MONEY + MONEY:4) < LOCAL:2 && !FLAG:정크포인트미사용
		PRINTFORMW 돈이 부족합니다 (%LOCALS:50% 비용 ￥{LOCAL:2} / 소지금 ￥{MONEY} / JP{MONEY:4})
		RETURN
	ELSEIF  C:111 == 0 && (MONEY + MONEY:4) < LOCAL:2
		PRINTFORMW 돈이 부족합니다 (%LOCALS:50% 비용 ￥{LOCAL:2} / 소지금 ￥{MONEY})
		RETURN
	ENDIF
ENDIF

LOCAL:1 = 0
LOCAL:2 = 0
LOCAL:10 = MONEY
FOR LCOUNT, 0, ARG

	LOCAL:4 = Z:(アイテムリスト:LCOUNT)
	SIF LOCAL:4 == 0
		CONTINUE

	;全件加算
	LOCAL:1 += LOCAL:4
	LOCAL:3 = ITEMSALES:(アイテムリスト:LCOUNT) * LOCAL:4
	LOCAL:2 += LOCAL:3
	PRINTFORM %LOCALS:50% 아이템：%ITEMNAME:(アイテムリスト:LCOUNT),20,LEFT% | 
	PRINTFORM %LOCALS:50% 개수： %TOSTR(LOCAL:4),3 %개 | 
	IF C:111 == 1
		PRINTFORML 비용 {LOCAL:3}마카
	ELSE
		PRINTFORML 금액 ￥{LOCAL:3}
	ENDIF

	;取引処理
	Z:(アイテムリスト:LCOUNT) = 0
	IF !FLAG:정크포인트미사용
		IF C:111 == 1
			MONEY:1 -= LOCAL:3
			MONEY:4 += LOCAL:3 * 2
		ELSE
			;MONEY:0 -= LOCAL:3
			MONEY:4 -= LOCAL:3
			IF MONEY:4 < 0
				MONEY:0 += MONEY:4
				MONEY:4 = 0
			ENDIF
		ENDIF
	ELSE
		Z:(アイテムリスト:LCOUNT) = 0
		IF C:111 == 1
			MONEY:1 -= LOCAL:3
			MONEY:4 += LOCAL:3 * 2
		ELSE
			MONEY:0 -= LOCAL:3
		ENDIF
	ENDIF
	CALL GET_ITEM,アイテムリスト:LCOUNT,LOCAL:4
	;---- EDIT 011 ADD START -------------------------
	CALL MOVE_STOCK_ITEM, アイテムリスト:LCOUNT
	;---- EDIT 011 ADD END ---------------------------
NEXT

PRINTFORML 총 %LOCALS:50% 아이템 수 {LOCAL:1}개
IF C:111 == 1
	PRINTFORML 총 %LOCALS:50% 비용 {LOCAL:2}마카
ELSE
	PRINTFORML 총 %LOCALS:50% 비용 ￥{LOCAL:2}
ENDIF
PRINTFORML 위와 같이 %LOCALS:50%했습니다.
IF LOCAL:10 - MONEY > 1000
	ITEM:361 += (LOCAL:10 - MONEY)/1000
	PRINTFORML {(LOCAL:10 - MONEY)/1000}개의 행복티켓을 손에 넣었다
ENDIF
WAIT
