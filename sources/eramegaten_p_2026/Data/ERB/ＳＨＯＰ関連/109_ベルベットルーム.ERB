@SHOPCOMABLE_109
SIF !IS_USEABLE_SHOPCOM
	RETURN 0
RESULT:1 = 1
RESULTS = 벨벳룸
;すでに鍵を持っているかイベント『タルタロス踏破指令』『깊은안개속의스튜디오』のどちらかを起こしているかセブンスがらみのフラグを立てている
IF ITEM:계약자의열쇠 || イベントフラグ:9:0  || イベントフラグ:12:0 || STRFLAG_EV("ベルベットルーム使用可能", , [[이벤트:페르소나]])
	RETURN 1
;女神異聞録ペルソナのイベントでペルソナ使いを仲間にしている
ELSEIF ダンジョンフラグ:10:10 == 1 || ダンジョンフラグ:10:10 == 2 || 依頼フラグ:[[依頼:구출의뢰1]]:0 == 1
	RETURN 1
;---- EDIT 025 MOD -------------------------
;ペルソナ5のキャラが仲間になるイベントを見ている
ELSEIF ダンジョンフラグ:13:1 > 0
	RETURN 1
;
ELSEIF !イベントフラグ:5:0
	FOR LOCAL, 0, CHARANUM
		SIF !TALENT:LOCAL:페르소나구사자
			CONTINUE
		;---- EDIT 019 MOD START -------------------------
		;---- EDIT 025 MOD -------------------------
		IF (GET_VALUE_TALENT_JOINABLE(LOCAL) > 0 && CFLAG:LOCAL:매각가능) || CFLAG:LOCAL:인계횟수
		;---- EDIT 019 MOD END   -------------------------
			RESULTS = 페르소나
			RETURN 1
		ENDIF
	NEXT
;デバッグフラグが立っているときは条件なし
ELSEIF FLAG:DEBUG
	RETURN 1
ENDIF
RETURN 0

@SHOP_COM_109, ARG
	CUSTOMDRAWLINE =
	CALL VELVET_ROOM

@VELVET_ROOM
	;時間城内の台詞をイベントフラグで差し替える　フラグを立てる
	イベントフラグ:5:2 = 1
	IF イベントフラグ:5:0 == 0
		IF FLAG:SHOP커맨드 == [[ショップ:벨벳룸]]
			PRINTFORMW 정크숍과 사교의관이 있는 구획을、특별한 목적 없이、어슬렁거리며 걷다 보니、
			PRINTFORMW 골목에 낯선 새파색 문이 서 있는 것이 눈에 들어왔다…
		ELSEIF FLAG:SHOP커맨드 == [[ショップ:탐색]]
			PRINTFORMW 장소에 어울리지 않는 새파란 나비가 날고 있는 것이 눈에 들어왔다…
		ENDIF
		PRINTFORMW 환각인가 싶어、눈을 비벼보지만、아무래도 그런 건 아닌 모양이다。
		SIF STRFLAG_EV("ベルベットルーム使用可能", , [[이벤트:페르소나]])
