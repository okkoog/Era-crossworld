		DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("스킬3") = [[스킬:고천열풍탄]]
		DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("습득스킬1") = [[스킬:메기도라]]
		DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("습득LV1") = MAX(BASE:MASTER:LV+1,82)
		DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("습득스킬2") = [[스킬:마카카쟈오토]]
		DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("습득LV2") = MAX(BASE:MASTER:LV+2,83)
		DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("습득스킬3") = 2991; 구제의손
		DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("습득LV3") = MAX(BASE:MASTER:LV+3,84)
		DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("습득스킬4") = [[스킬:만마의난무]]
		DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("습득LV4") = MAX(BASE:MASTER:LV+4,85)
		DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("陥落") = 1
