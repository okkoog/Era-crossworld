;===============================
;ペルソナステータス上昇率設定
;===============================
@PERSONA_PARAM_DIST_SETUP
#DIM CONST ESCAPE_COMMAND = 999
#DIM CONST RESET_TO_DEFAULT_COMMAND = 8
#DIM CONST CONFIRM_COMMAND = 9
#DIM PERSONANO
#DIM PMASTER
#DIM PERSONA_CSV
#DIM L_LINE
#DIM 上昇率, 6

PRINTL 그럼、설정할 페르소나를 선택해주세요
PRINTL 

CALL PERSONA_LIST(0,1)
PRINTFORML [{ESCAPE_COMMAND}] 돌아간다
DO
	INPUT
	SIF RESULT == ESCAPE_COMMAND
		RETURN 0
LOOP !(RANGE(RESULT, 1, 100) && Q:RESULT != -1)

PERSONANO = Q:RESULT
PMASTER = FINDCHARA_ID(DITEMTYPE:PERSONANO:페르소나("ペルソナ所持者"))
L_LINE = LINECOUNT

DRAWLINE
PRINTFORML %CSVNAME(DITEMTYPE:PERSONANO:페르소나("NO"),0)%(소지자:%\@PMASTER >= 0 ? %CALLNAME:PMASTER% # %"없음"%\@%)의 능력상승률을 변경합니다
PRINTL 상승률을 설정해주세요
DRAWLINE

REPEAT 6
	上昇率:COUNT = DITEMTYPE:PERSONANO:(페르소나("힘상승률")+COUNT)
REND
REPEAT 6
	LOCAL = 上昇率:COUNT * 1000 / SUMARRAY(上昇率,0,6)
	CALL SETCOLOR_AUTOIF2(LOCAL)
	PRINTFORML [{COUNT,2}] %SUBSTRINGU(BASENAME:(GETNUM(BASE,"힘")+COUNT),0,1)%　　{上昇率:COUNT} \({LOCAL/10}.{LOCAL%10}\%\)
REND
RESETCOLOR
PRINTFORML [{RESET_TO_DEFAULT_COMMAND,2}] 초기값으로 되돌린다
PRINTFORML [{CONFIRM_COMMAND,2}] 결정
ONEINPUT
LOCAL = RESULT
SELECTCASE RESULT
CASE 0,1,2,3,4,5,6
	CALL INPUT_MANY(0,99)
	DITEMTYPE:PERSONANO:(페르소나("힘상승률")+LOCAL) = RESULT
	
CASE RESET_TO_DEFAULT_COMMAND
	CALL PERSONA_PARAM_DIST_INIT(PERSONANO)
CASE CONFIRM_COMMAND
	RETURN
ENDSELECT
CLEARLINE LINECOUNT-L_LINE
RESTART


;===============================
;ペルソナステータス上昇率初期化
;===============================
@PERSONA_PARAM_DIST_INIT,PERSONANO
#DIM PERSONANO
#DIM PERSONA_CSV

VARSET LOCAL
PERSONA_CSV = DITEMTYPE:PERSONANO:페르소나("NO")
REPEAT 6
	LOCAL:COUNT = CSVBASE(PERSONA_CSV,GETNUM(BASE,"힘")+COUNT)
REND
;すべてが0だった場合全部に１足して最低限の確率を確保するとともに0で割ることを回避
IF !(SUMARRAY(LOCAL,0,6))
	REPEAT 6
		LOCAL:COUNT++
	REND
ENDIF
REPEAT 6
	DITEMTYPE:PERSONANO:(페르소나("힘상승률")+COUNT) = LOCAL:COUNT
REND
