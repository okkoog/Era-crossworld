	$INPUT_LOOP2
	PRINTL 사용가능한 스킬카드
	;継承部位考えると、キャラ造らずに処理通すのはちょっと無理そげ
	ADDCHARA DITEMTYPE:ARG:페르소나("NO")
	IF ARG >= 50
		CALLF STRFLAG_EV("初期ペルソナスキル習得", 1, [[이벤트:페르소나]])
	ELSE
		CALLF STRFLAG_EV("初期ペルソナスキル習得", -1, [[이벤트:페르소나]])
	ENDIF
	CALL SHOW_LEARN_SKILL, CHARANUM - 1
	LOCAL = RESULT
	LOCAL:5 = 2
	;素質がない場合2倍になる
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", LOCAL
	SIF TALENT:(CHARANUM - 1):GET_SUCCESSION(RESULT)
		LOCAL:5 = 1
	;ここでキャラ削除
	;CALL キャラ削除, CHARANUM - 1
	DELCHARA CHARANUM -1
	FOR LOCAL:2 ,1, 9
		LOCALS = 스킬{LOCAL:2}
		IF LOCAL && DITEMTYPE:ARG:페르소나(LOCALS) == LOCAL
			CALL GET_SKILL_PROP, "SKILL_NAME", LOCAL
			PRINTFORMW 「%CSVNAME(DITEMTYPE:ARG:페르소나("NO"),0)%은(는) 【%RESULTS%】을(를) 이미 배우고 있군요」
			RESTART
		ENDIF
	NEXT
	RESULT = LOCAL
	SIF RESULT == 0
		RETURN 0

	;ELSEIF RESULT >= 0 && RESULT < 10 && RESULT < LOCAL && GETBIT(LOCAL:5, RESULT + 1)
		;覚えさせるスキル
		LOCAL = RESULT
		LOCAL:3 = RESULT
		CALL GET_SKILL_PROP, "SKILL_RANK", LOCAL, -1
		;必要なEXP
		LOCAL:4 = (RESULT * 20 + 100 + MAX(RESULT * 50 - DITEMTYPE:ARG:페르소나("LV") * 10, 0)) * LOCAL:5 / 2
		CALL GET_SKILL_PROP, "SKILL_NAME", LOCAL
		LOCALS:1 = %RESULTS%
		PRINTFORML %RESULTS%을(를) 습득하기 위해서는 EXP {LOCAL:4}이(가) 필요합니다
		IF LOCAL:4 > DITEMTYPE:ARG:페르소나("EXP")
			PRINTFORMW EXP가 부족합니다
			RETURN 0
		ENDIF
		PRINTFORML 스킬을 습득시키시겠습니까？(현EXP {DITEMTYPE:ARG:페르소나("EXP")})
		CALL INPUT_YN
		IF RESULT
			PRINTFORMW 스킬 습득을 그만두었습니다
			RETURN 0
		ENDIF
		
		;スキルがすべて埋まっているかチェック
		SKILL_COUNT = 0
		FOR LOCAL:2, 1, 9
			LOCALS = 스킬{LOCAL:2}
			IF DITEMTYPE:ARG:페르소나(LOCALS)
				SKILL_COUNT +=1
			ENDIF
		NEXT
		
		;スキルが埋まってる
		;IF DITEMTYPE:ARG:페르소나("스킬8")
		IF SKILL_COUNT == 8
			DRAWLINE
			PRINTL 「이런, 스킬이 가득 찼군요」
			PRINTW 「그렇다면 잊게 할 스킬을 골라 주십시오」
			LINE = LINECOUNT
			$CHOICE
			CLEARLINE LINECOUNT - LINE
			FOR LOCAL:2 ,1, 9
				LOCALS = 스킬{LOCAL:2}
				IF DITEMTYPE:ARG:페르소나(LOCALS)
					CALL GET_SKILL_PROP, "SKILL_NAME", DITEMTYPE:ARG:페르소나(LOCALS)
					IF GETBIT(DITEMTYPE:ARG:페르소나("스킬잠금설정"),LOCAL:2)
						SETCOLOR COLOR("黄色")
						PRINTFORM 　LOCK%RESULTS,20,LEFT%
					ELSE
						PRINTFORM 　[{LOCAL:2}]%RESULTS,20,LEFT%
					ENDIF
					RESETCOLOR
				ENDIF
				SIF LOCAL:2 % 4 == 0
					PRINTL 
			NEXT
			PRINTL [100] 돌아간다 [200]스킬잠금설정
			$INPUT_LOOP3
			INPUT
			IF RESULT == 100
				RETURN
			ELSEIF RESULT == 200
				CALL SKILL_ROCK_SETTING_P, ARG
				GOTO CHOICE
			ELSEIF RESULT > 0 && RESULT < 9 && !GETBIT(DITEMTYPE:ARG:페르소나("스킬잠금설정"),RESULT)
				LOCAL:2 = RESULT
			ELSE
				CLEARLINE 1
				GOTO INPUT_LOOP3
			ENDIF
		ELSE
			LOCAL:2 = 0
			DO 
				LOCAL:2++
				LOCALS = 스킬{LOCAL:2}
			LOOP DITEMTYPE:ARG:페르소나(LOCALS)
		ENDIF
		LOCALS = 스킬{LOCAL:2}
		DITEMTYPE:ARG:페르소나(LOCALS) = LOCAL
		CALL SP_SKILL_CHECK,LOCAL
		SIF RESULT > 0
			SETBIT DITEMTYPE:ARG:페르소나("스킬잠금설정"),LOCAL:2
		DITEMTYPE:ARG:페르소나("EXP") -= LOCAL:4
		ITEM:(10000+LOCAL) -= 1
		PRINTFORMW %CSVNAME(DITEMTYPE:ARG:페르소나("NO"),0)%에게 %LOCALS:1%을(를) 습득시켰습니다
	;ELSE
	;	GOTO INPUT_LOOP2
	;ENDIF

