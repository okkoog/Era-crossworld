@GET_CP_PERSONA, ARG, ARG:1
	;ARG 悪魔のNO
	;ARG:1 ペルソナのNO
	LOCAL:1 = 15
	FOR LOCAL, 0, TYPENUM
		SELECTCASE CSVBASE(ARG, GETNUM(BASE, GET_TYPE(LOCAL)), 0)
			CASE 999
				LOCAL:1 += 25
			CASE IS < 0
				LOCAL:1 += 25
			CASE 0
				LOCAL:1 += 20
			CASE IS > 199
				LOCAL:1 -= 20
			CASE IS > 100
				LOCAL:1 -= 10
			CASE IS <= 50
				LOCAL:1 += 10
			CASE IS < 100
				LOCAL:1 += 5
		ENDSELECT
	NEXT
	DITEMTYPE:(ARG:1):페르소나("CP") = MAX(1,LOCAL:1) + CSVCFLAG(ARG, GETNUM(CFLAG, "ＣＰ보정"), 0)
;---- EDIT 001 ADD END -------------------------

