	LOCAL:2 = 0
	FOR LOCAL, 0, CHARANUM
		SIF CFLAG:LOCAL:페르소나강화플래그 % 2 == 1
			LOCAL:2 = 1
	NEXT
	SIF LOCAL:2
		PRINTL [7] 특수한 소환을 행한다
