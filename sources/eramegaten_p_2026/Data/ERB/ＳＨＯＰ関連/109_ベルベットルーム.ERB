				CALL LEARN_SKILL_P, ARG, DITEMTYPE:ARG:페르소나(("습득스킬"+TOSTR(LOCAL)))
				DITEMTYPE:ARG:페르소나(("습득스킬"+TOSTR(LOCAL))) = 0
				DITEMTYPE:ARG:페르소나(("습득LV"+TOSTR(LOCAL))) = 0
			ENDIF
		ENDIF
