							DITEMTYPE:PERSONA:(페르소나("힘")+LOCAL:3) -= 1
							LOCAL:4 += 1
						ENDIF
					NEXT
					IF LOCAL:4
						PRINTFORMW 強化可能回数 + {LOCAL:4}
						DITEMTYPE:PERSONA:페르소나("強化可能回数") += LOCAL:4
						ITEM:ALL마이너스카드 -= 1
					ELSE
						PRINTFORMW %CSVNAME(DITEMTYPE:PERSONA:페르소나("NO"), 0)%의 능력은 이 이상 낮출 수 없습니다
					ENDIF
				ENDIF
		ENDSELECT
		GOTO UP_STATUS
	ELSEIF RESULT == 2
		CALL ADD_SKILL_PERSONA, PERSONA
	ELSEIF RESULT == 3
		$EXPCARD
		FOR LOCAL, 0, 5
			LOCAL:1 = LOCAL+GETNUM(ITEM,"신아의카드") 
			PRINTFORML [{LOCAL}] %ITEMNAME:(LOCAL:1)%(EXP:{ITEMPRICE:(LOCAL:1),3})　{ITEM:(LOCAL:1),2}枚
		NEXT
		DRAWLINE
		PRINTL [9] 돌아간다
		CALL INPUTINT(0, 1, 2, 3, 4, 9)
		IF RESULT < 5
			LOCAL = RESULT+GETNUM(ITEM,"신아의카드")
			IF !ITEM:(LOCAL)
				PRINTW 카드가 없는것 같군요
				GOTO EXPCARD
			ENDIF
			ITEM:(LOCAL) -= 1
			DITEMTYPE:PERSONA:페르소나("EXP") += ITEMPRICE:LOCAL
			SIF DITEMTYPE:PERSONA:페르소나("EXP") > 1000
				DITEMTYPE:PERSONA:페르소나("EXP") = 1000
		ENDIF
	;---- EDIT 001 ADD START -------------------------
	;耐性強化
	ELSEIF RESULT == 4
		;何故、ペルソナ装備者を簡単に割り出せる様にしないのか？？？
		CALL PERSONA_ENHANCE_DEFTYPE, PERSONA, PMASTER
	ELSEIF RESULT == 8
		CLEARLINE LINECOUNT - LINE
		RESTART
	ENDIF
	;---- EDIT 001 ADD END -------------------------
	;元々のランクを記録
	LOCAL = DITEMTYPE:PERSONA:페르소나("ランク")
	LOCAL:1 = 0
	WHILE 1
		LOCAL:1 += 1
		IF DITEMTYPE:PERSONA:페르소나("EXP") < LOCAL:1 * LOCAL:1 * 10
			DITEMTYPE:PERSONA:페르소나("ランク") = LOCAL:1 - 1
			BREAK
		ENDIF
	WEND
	;ランク変化
	SIF DITEMTYPE:PERSONA:페르소나("ランク") != LOCAL && PERSONA < 50
		PRINTFORMW %CSVCALLNAME(DITEMTYPE:PERSONA:페르소나("NO"), 0)%의 랭크가 {DITEMTYPE:PERSONA:페르소나("ランク")}(이)가 되었습니다
	GOTO START_POWERUP


@EVENT_LEVELUP_P, ARG
	FOR LOCAL,1,21
		IF DITEMTYPE:ARG:페르소나(("습득스킬"+TOSTR(LOCAL))) > 0
