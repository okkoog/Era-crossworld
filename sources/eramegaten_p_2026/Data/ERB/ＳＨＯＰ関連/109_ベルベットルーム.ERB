	DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("ランク") = 10
	DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("EXP") = 1000

	FOR LOCAL,1, 11
		IF DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("NO") == DITEMTYPE:페르소나(@"ペルソナ{LOCAL}"):페르소나("NO")
			PRINTFORMW 이런, %CSVCALLNAME(DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("NO"), 0)%은(는) 이미 소환되어 있군요
			FOR LOCAL, 0, 100
				DITEMTYPE:페르소나("ゲストペルソナ1"):LOCAL = 0
			NEXT
			RETURN 0
		ENDIF
	NEXT
	;----------------------------------
	;ステータス決定
	;----------------------------------
;	DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("LV") = BASE:MASTER:LV
	FOR LOCAL, 1, 7
		LOCAL:LOCAL = CSVBASE(DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("NO"), GETNUM(BASE, GET_BASESTATUS(LOCAL)),0)
	NEXT
	LOCAL:7 = 100 * (BASE:MASTER:LV * 3 / 2 + 18) / SUMARRAY(LOCAL, 1, 7)
	FOR LOCAL, 1, 7
		LOCAL:LOCAL = LOCAL:LOCAL * LOCAL:7 / 100
	NEXT
	WHILE SUMARRAY(LOCAL, 1, 7) < BASE:MASTER:LV * 3 / 2 + 18
		LOCAL:(LOCAL%6+1) += 1
		LOCAL++
	WEND
	FOR LOCAL, 1, 7
		DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나(GET_BASESTATUS(LOCAL)) = LOCAL:LOCAL
	NEXT
	;---- EDIT 001 ADD START -------------------------
	;ペルソナに相性を持たせる
	CALL GET_CP_PERSONA, DITEMTYPE:페르소나("ゲストペルソナ1"):페르소나("NO"), 페르소나("ゲストペルソナ1")
	;---- EDIT 002 ADD START -------------------------
	;CALL ADJUST_MAKE_PSTATUS(페르소나("ゲストペルソナ1"))
	PRINTFORMW 흠, %ITEMNAME:ARG%을(를) 사용하여 페르소나를 불러낼 경우, 이러한 능력의 페르소나가 태어나는 모양이군요
	CALL PERSONA_STATUS(페르소나("ゲストペルソナ1"))
	PRINTL 정말로 소환해도 괜찮겠습니까?
	CALL INPUT_YN
	SIF RESULT == 1
		RETURN 0
	FOR LOCAL, 0, 100
		DITEMTYPE:(ARG:1):LOCAL = DITEMTYPE:페르소나("ゲストペルソナ1"):LOCAL
		DITEMTYPE:페르소나("ゲストペルソナ1"):LOCAL = 0
	NEXT
	ITEM:ARG = -1
	PRINTFORMW %CSVCALLNAME((DITEMTYPE:(ARG:1):페르소나("NO")),0)%을(를) 소환했습니다
	DITEMTYPE:(ARG:1):페르소나("ペルソナ所持者") = -1

@EVOLUTE_PERSONA
	PRINTFORMW 「이런, 당신들에게 힘을 빌려주겠다며 호소해 오는 페르소나가 있군요」
	PRINTFORMW 「페르소나와 페르소나 구사자, 그 사이를 이어주는 도움을 드리도록 하지요」
	CALL PERSONA_MASTER_LIST(1)
	SIF RESULT < 0 || NO:RESULT < 0
		RETURN
	LOCAL = RESULT
	LOCAL:1 = ABL:LOCAL:초기페르소나
	ABL:LOCAL:초기페르소나 = CFLAG:LOCAL:페르소나강화플래그 == 1 ? ABL:LOCAL:초기페르소나2 # ABL:LOCAL:초기페르소나3
	;口上があれば、口上を呼び出し
	TRYCCALLFORM EVOLUTE_PERSONA_K{NO:RESULT}(LOCAL)
	CATCH
		PRINTFORMW %CALLNAME:LOCAL%의 %CSVNAME(LOCAL:1,0)%이(가) %CSVNAME(ABL:LOCAL:초기페르소나,0)%(으)로 변화했다
	ENDCATCH
	;強化フラグをふやす
	CFLAG:LOCAL:페르소나강화플래그 += 1
	CALL SYNC_STATUS, LOCAL

@PERSONA_STATUS_CHECK
	#DIM PERSONA, 1
	#DIM NUM, 1
	VARSET LOCAL
;---- EDIT 025 MOD -------------------------
	CALL PERSONA_LIST,1
	PRINTFORML [100] 돌아간다
	$INPUT_LOOP
	INPUT
	SIF RESULT == 100
		RETURN -1
	IF Q:RESULT == -1
		CLEARLINE 1
		GOTO INPUT_LOOP
	ENDIF
	NUM = RESULT
	$PRINT_STATUS
	PERSONA = Q:NUM
	CALL PERSONA_STATUS(PERSONA)
	IF (Q:(NUM-1) == -1) && (NUM <= 10 || Q:1 == -1)
		PRINTFORMLC %" " * 16%
	ELSE
		PRINTFORMLC [101]이전페르소나
	ENDIF
	PRINTFORMLC   [102]리스트로 돌아간다
	IF (Q:(NUM+1) == -1) && (NUM > 10 || Q:11 == -1)
		PRINTFORMLC %" " * 16%
	ELSE
		PRINTFORMLC [103]다음페르소나
	ENDIF
	PRINTFORMLC   [104]해설을 본다
	IF DITEMTYPE:PERSONA:페르소나("스킬1")
		PRINTL 
		PRINTFORMLC [105]스킬 정렬
	ENDIF
	$INPUT_LOOP5
	INPUT
	IF RANGE(RESULT, 1, 8)
		SIF DITEMTYPE:PERSONA:(페르소나("스킬1") + RESULT - 1) == 0
			GOTO INPUT_LOOP5
		SIF FLAG:스킬속성표시설정 == 1
			CALL SKILL_EXPLAIN_PERFORMANCE, DITEMTYPE:PERSONA:(페르소나("스킬1") + RESULT - 1), -1
		VARI TEMP_LINE = LINECOUNT
		CALL GET_SKILL_PROP, "SKILL_EXPLAIN", DITEMTYPE:PERSONA:(페르소나("스킬1") + RESULT - 1), -1
		IF TEMP_LINE != LINECOUNT
			WAIT
			GOTO PRINT_STATUS
		ELSE
			GOTO INPUT_LOOP5
		ENDIF
	ELSEIF RESULT == 100
		RETURN -1
	ELSEIF RESULT == 101
		IF Q:(NUM-1) == -1
			IF NUM == 11
				FOR LOCAL, 10, 0, -1
					SIF Q:LOCAL == -1
						CONTINUE
					NUM = LOCAL
					BREAK
				NEXT
			ENDIF
		ELSE
			NUM--
		ENDIF
		GOTO PRINT_STATUS
	ELSEIF RESULT == 102
		RESTART
	ELSEIF RESULT == 103
		IF Q:(NUM+1) >= 0
			NUM++
		ELSE
			SIF NUM < 11 && Q:11 >= 0
				NUM = 11
		ENDIF
		GOTO PRINT_STATUS
	ELSEIF RESULT == 104
		FOR LOCAL, GETNUM(CSTR, "해설1"), GETNUM(CSTR, "해설20") + 1
			PRINTFORML %CSVCSTR(DITEMTYPE:PERSONA:페르소나("NO"), LOCAL, 0)%
		NEXT
		WAIT
		GOTO PRINT_STATUS
	ELSEIF RESULT == 105 && DITEMTYPE:PERSONA:페르소나("스킬1")
		$INPUT_LOOP_SKILLCHANGE
		DRAWLINE
		PRINTL 첫 번째 스킬을 선택해주세요
		IF GETBIT (FLAG:커스텀게임화면,1)
			PRINTL
			FOR LOCAL:3, 0, FLAG:스킬수
				LOCALS:2 = 스킬{LOCAL:3+1}
				IF DITEMTYPE:PERSONA:페르소나(LOCALS:2)
					CALL GET_SKILL_PROP, "SKILL_NAME", DITEMTYPE:PERSONA:페르소나(LOCALS:2)
					PRINTFORM 　[{LOCAL:3+1}]%RESULTS,38,LEFT%
				ENDIF
				SIF LOCAL:3 % 2 == 1
					PRINTL
			NEXT
		DRAWLINE
		PRINTL 　　[9] 캔슬
		ELSE
			FOR LOCAL:3, 0, FLAG:스킬수
				LOCALS:2 = 스킬{LOCAL:3+1}
				IF DITEMTYPE:PERSONA:페르소나(LOCALS:2)
					CALL GET_SKILL_PROP, "SKILL_NAME", DITEMTYPE:PERSONA:페르소나(LOCALS:2),
					PRINTFORM 　[{LOCAL:3+1}]%RESULTS,20,LEFT%
				ENDIF
				SIF LOCAL:3 % 4 == 3
					PRINTL
			NEXT
		PRINTL 　[9] 캔슬
		ENDIF
		INPUT
		SIF RESULT == 9
			GOTO PRINT_STATUS
		SIF RESULT < 0 || RESULT > 9
			GOTO INPUT_LOOP_SKILLCHANGE
		LOCALS = 스킬{RESULT}
		SIF DITEMTYPE:PERSONA:페르소나(LOCALS) <= 0
			GOTO INPUT_LOOP_SKILLCHANGE
		DRAWLINE
		PRINTFORML 두 번째 스킬을 선택해주세요
		IF GETBIT (FLAG:커스텀게임화면,1)
			PRINTL
			FOR LOCAL:3, 0, FLAG:스킬수
				LOCALS:2 = 스킬{LOCAL:3+1}
				SIF DITEMTYPE:PERSONA:페르소나(LOCALS) == DITEMTYPE:PERSONA:페르소나(LOCALS:2)
					SETCOLOR 102,255,255
				IF DITEMTYPE:PERSONA:페르소나(LOCALS:2)
					CALL GET_SKILL_PROP, "SKILL_NAME", DITEMTYPE:PERSONA:페르소나(LOCALS:2),U
					PRINTFORM 　[{LOCAL:3+1}]%RESULTS,38,LEFT%
				ENDIF
				RESETCOLOR
				SIF LOCAL:3 % 2 == 1
					PRINTL
			NEXT
		DRAWLINE
		PRINTL 　　[9] 캔슬
		ELSE
			FOR LOCAL:3, 0, FLAG:스킬수
				LOCALS:2 = 스킬{LOCAL:3+1}
				SIF DITEMTYPE:PERSONA:페르소나(LOCALS) == DITEMTYPE:PERSONA:페르소나(LOCALS:2)
					SETCOLOR 102,255,255
				IF DITEMTYPE:PERSONA:페르소나(LOCALS:2)
					CALL GET_SKILL_PROP, "SKILL_NAME", DITEMTYPE:PERSONA:페르소나(LOCALS:2),U
					PRINTFORM 　[{LOCAL:3+1}]%RESULTS,20,LEFT%
				ENDIF
				RESETCOLOR
				SIF LOCAL:3 % 4 == 3
					PRINTL
			NEXT
		PRINTL 　[9] 캔슬
		ENDIF
		INPUT
		SIF RESULT == 9
			GOTO PRINT_STATUS
		SIF RESULT < 0 || RESULT > 9
			GOTO INPUT_LOOP_SKILLCHANGE
		LOCALS:1 = 스킬{RESULT}
		SIF DITEMTYPE:PERSONA:페르소나(LOCALS:1) <= 0
			GOTO INPUT_LOOP_SKILLCHANGE
		SWAP DITEMTYPE:PERSONA:페르소나(LOCALS), DITEMTYPE:PERSONA:페르소나(LOCALS:1)
		IF GETBIT(DITEMTYPE:PERSONA:페르소나("스킬잠금설정"),페르소나(LOCALS) - 10) != GETBIT(DITEMTYPE:PERSONA:페르소나("스킬잠금설정"),페르소나(LOCALS:1) - 10)
			INVERTBIT DITEMTYPE:PERSONA:페르소나("스킬잠금설정"),페르소나(LOCALS) - 10
			INVERTBIT DITEMTYPE:PERSONA:페르소나("스킬잠금설정"),페르소나(LOCALS:1) - 10
		ENDIF
		GOTO PRINT_STATUS
	ELSE
		GOTO INPUT_LOOP5
	ENDIF

@PERSONA_STATUS(ARG)
	#LOCALSIZE 5
	#LOCALSSIZE 1
	LOCAL = DITEMTYPE:ARG:페르소나("NO")
	DRAWLINE
	CSVABL LOCAL, GETNUM(ABL, "종족") , 0
	CSVCSTR LOCAL, GETNUM(CSTR, "종족명"), 0
	IF STRLENS(RESULTS)
		PRINTFORM 종족:%RESULTS%　　
	ELSE
		PRINTFORM 종족:%STR:RESULT%　　
	ENDIF
	CSVCALLNAME LOCAL,0
	PRINTFORM %RESULTS%　　
	SIF ARG < 50
		PRINTFORM 충성도:%AUTO_SPLIT("◯/◎/☆/★", "/", DITEMTYPE:ARG:페르소나("陥落"))%　　
	PRINTFORM 소지자:\@DITEMTYPE:ARG:페르소나("ペルソナ所持者") >= 0 ? %CALLNAME:FINDCHARA_ID(DITEMTYPE:ARG:페르소나("ペルソナ所持者"))% # 없음\@

	PRINTL 
	DRAWLINE
	PRINTFORM 　　LV{DITEMTYPE:ARG:페르소나("LV"),3}({DITEMTYPE:ARG:페르소나("LV"),3})　　　
	PRINTFORM Rank{DITEMTYPE:ARG:페르소나("ランク"),2}　　　Exp {DITEMTYPE:ARG:페르소나("EXP"),4}/{LIMIT(DITEMTYPE:ARG:페르소나("ランク") + 1, 0, 10) *LIMIT(DITEMTYPE:ARG:페르소나("ランク") + 1, 0, 10) * 10,4}　　　
	IF ARG >= 50 && CSVABL(NO:FINDCHARA_ID(DITEMTYPE:ARG:페르소나("ペルソナ所持者")), GETNUM(ABL, "초기페르소나"), 0) > 0
		PRINTFORM %GET_ALI1(CSVABL(NO:FINDCHARA_ID(DITEMTYPE:ARG:페르소나("ペルソナ所持者")), GETNUM(ABL,"속성LD"), 0)),7%/
		PRINTFORML %GET_ALI2(CSVABL(NO:FINDCHARA_ID(DITEMTYPE:ARG:페르소나("ペルソナ所持者")), GETNUM(ABL,"속성LC"), 0)),7%
	ELSE
		PRINTFORM %GET_ALI1(DITEMTYPE:ARG:페르소나("속성LD")),7%/
		PRINTFORML %GET_ALI2(DITEMTYPE:ARG:페르소나("속성LC")),7%
	ENDIF
	DRAWLINE
	;LVによるStatus補正
	;表示詐欺なので注意
	FOR LOCAL:1 , 1, 7
		;補正後がLOCAL:3
		;補正前がLOCAL:4
		LOCAL:3 = DITEMTYPE:ARG:(페르소나("LV")+LOCAL:1) * PRANK_COLLECTION_VALUE(-1, ARG) / 100
		LOCAL:4 = DITEMTYPE:ARG:(페르소나("LV")+LOCAL:1) * 75 / 100
		PRINTFORM %GET_BASESTATUS(LOCAL:1),4%{LOCAL:3,3}({LOCAL:4,3})　
		FOR LOCAL:2, 0, 100, 2
			SETCOLOR 0xe0e0e0
			SIF LOCAL:4 <= LOCAL:2
				SETCOLOR 0x9090E8
			SIF LOCAL:3 <= LOCAL:2
				SETCOLOR COLOR("gray") 
			IF LOCAL:3 > LOCAL:2 || LOCAL:4 > LOCAL:2
				PRINTFORM %UNICODE(0x258B)%
			ELSE
				PRINT  
			ENDIF
		NEXT
		PRINTL 
		RESETCOLOR
	NEXT
	DRAWLINE
	PRINTL 전투상성
	;---- EDIT 001 ADD START -------------------------
	;相性をペルソナからとって表示するように
	FOR LOCAL:1, 0, TYPENUM
		LOCALS = %GET_TYPE(LOCAL:1)%
		IF DITEMTYPE:ARG:페르소나("변경상성1") - 1 == LOCAL:1
			LOCAL:2 = DITEMTYPE:ARG:페르소나("변경상성치1")
		ELSE
			LOCAL:2 = CSVBASE(DITEMTYPE:ARG:페르소나("NO"), GETNUM(BASE, LOCALS), 0)
		ENDIF
		CALL SET_AISYOU_COLOR, LOCAL:2
		PRINTFORM %LOCALS%\@LOCAL:2 < 0 ? 흡 # 　\@
		PRINTFORM \@ LOCAL:2 != 999 ? {ABS(LOCAL:2),4}％ # %" " *2%반사 \@　
		;PRINTFORM {ABS(MAXBASE:ARG:(GET_TYPE(LOCAL)),4}％
		SIF LOCAL:1 % 6 == 5
			PRINTL
	NEXT
	;---- EDIT 001 ADD END -------------------------
	RESETCOLOR
	DRAWLINE
	IF GETBIT (FLAG:커스텀게임화면,1)
		FOR LOCAL:1, 0, FLAG:스킬수
			SIF DITEMTYPE:ARG:(페르소나("스킬1") + LOCAL:1) == 0
				CONTINUE
			CALL GET_SKILL_PROP, "SKILL_NAME", DITEMTYPE:ARG:(페르소나("스킬1") + LOCAL:1)
			PRINTFORM 　[{LOCAL:1+1}]%RESULTS,38,LEFT%
			SIF LOCAL:1 == 2 || LOCAL:1 == 5 || LOCAL:1 == 8
				PRINTL
		NEXT
	ELSE
		FOR LOCAL:1, 0, FLAG:스킬수
			SIF DITEMTYPE:ARG:(페르소나("스킬1") + LOCAL:1) == 0
				CONTINUE
			CALL GET_SKILL_PROP, "SKILL_NAME", DITEMTYPE:ARG:(페르소나("스킬1") + LOCAL:1)
			PRINTFORM 　[{LOCAL:1+1}]%RESULTS,20,LEFT%
			SIF LOCAL:1 % 4 == 3
				PRINTL
		NEXT
	ENDIF
	;---- EDIT 025 ADD START -------------------------
	LOCAL:2 = 0
	LOCAL:3 = 0
	FOR LOCAL:1, 1, 21
		LOCALS = 습득LV{LOCAL:1}
		IF DITEMTYPE:ARG:페르소나("LV") < DITEMTYPE:ARG:페르소나(LOCALS) && DITEMTYPE:ARG:페르소나(LOCALS) > 0 && (LOCAL:2 == 0 || LOCAL:3 > DITEMTYPE:ARG:페르소나(LOCALS))
			LOCAL:2 = LOCAL:1
			LOCAL:3 = DITEMTYPE:ARG:페르소나(LOCALS)
		ENDIF
	NEXT
	IF LOCAL:2 > 0
		SETCOLOR 0x666666
		CALL GET_SKILL_PROP, "SKILL_NAME", DITEMTYPE:ARG:(페르소나("습득스킬1") + LOCAL:2 -1)
		PRINTFORML 　NEXT[%RESULTS,20,LEFT%]　습득LV {DITEMTYPE:ARG:(페르소나("습득LV1") + LOCAL:2 -1)}
		RESETCOLOR
	ENDIF
	;---- EDIT 025 ADD END -------------------------
	SIF LINEISEMPTY() == 0
		PRINTL
	DRAWLINE
	RETURN ARG

@SHOW_PERSONA_MASTER_STATUS(ARG, ARG:1)
#LOCALSIZE 3
#DIM DYNAMIC STAT, 4
	;引数はペルソナ使いと変更後のペルソナ
	;現在のペルソナを記憶し、ペルソナを一時的に付け替える
	LOCAL:2 = EQUIP:ARG:장비페르소나
	EQUIP:ARG:장비페르소나 = ARG:1
	;ステータス一致
	CALL SYNC_STATUS, ARG
	;ステータス呼び出し
	;装備の表記を避けたかったのでそこだけ削りました
	U = ARG
	PRINTFORML %STR:(ABL:ARG:80)%　　%CALLNAME:U%　　
	;1行目にレベル・属性を表示
	CALL PRINT_BASE_STATUS,ARG
	;2行目にHP・忠誠度を表示

	PRINTFORML ＨＰ[{BASE:ARG:ＨＰ,4}/{MAXBASE:ARG:ＨＰ,4}]　　　　　충성도:{GET_CHARA_LOYALTY(ARG),6}　　ＭＡＧ:{GET_CHARA_STOCK_MAG(ARG),6}


	;3行目にＭＰ・ＥＸＰを表示
	PRINTFORM ＭＰ[{BASE:ARG:ＭＰ,4}/
	PRINTFORML {MAXBASE:ARG:ＭＰ,4}]　　　　　ＥＸＰ：{BASE:ARG:ＥＸＰ,8}/{MAXBASE:ARG:ＥＸＰ,8}　　ＣＰ:{MAXBASE:ARG:CP,3}
	;4行目に通常攻撃の性能を表示
	PRINTFORM 통상공격：%GET_TYPE(ABL:ARG:공격상성),6,LEFT%　{ABL:ARG:최저공격횟수,2}-{ABL:ARG:최대공격횟수,2}회　사거리
	IF ABL:ARG:사거리 == 1
		PRINT Ｓ
	ELSEIF ABL:ARG:사거리 == 2
		PRINT Ｍ
	ELSEIF ABL:ARG:사거리 == 3
		PRINT Ｌ
	ENDIF
	PRINTFORML  %GET_SPHERE(ABL:ARG:공격범위),4,LEFT%
	IF ABL:ARG:추가효과 > 0
		PRINTFORML 　　　　추가효과：%GET_STATE(ABL:ARG:추가효과),6,LEFT%　추가효과상성：%GET_TYPE(ABL:ARG:추가효과상성)%
	ENDIF

	;人間ならばここに銃攻撃の性能と銃攻撃力・銃命中を2行つかって表示
	IF EQUIP:ARG:총 > 0
		DRAWLINE
		PRINTFORML 총：공격력 {MAXBASE:ARG:총공격,4} 명중 {MAXBASE:ARG:총명중}
		CALLFORM 最低攻撃回数_{EQUIP:ARG:총},ARG
		PRINTFORM 공격횟수 {RESULT,2}-
		CALLFORM 最大攻撃回数_{EQUIP:ARG:총},ARG
		PRINTFORM {RESULT,2}
		CALLFORM 射程_{EQUIP:ARG:총},ARG
		PRINTFORM 　　사정：
		IF RESULT == 1
			PRINT Ｓ
		ELSEIF RESULT == 2
			PRINT Ｍ
		ELSEIF RESULT == 3
			PRINT Ｌ
		ENDIF
		CALLFORM 攻撃範囲_{EQUIP:ARG:총},ARG
		PRINTFORM 　　%GET_SPHERE(RESULT),4,LEFT%
		PRINTL
	ENDIF
	DRAWLINE
	CALL 能力値グラフカラーチェック
	;5～10行目に基本能力値と戦闘能力値を表示
	;棒グラフを表示する処理を追加しました。
	;ステ2Pにつき、1個の*があらわれ,最大で50個（ステ100）まで増え続ける
	;ついでに調教や装備やペルソナの補正なんか加算されてるぶんは水色、減算されてるぶんは灰色になります。
	FOR LOCAL:1, 0, 6
		PRINTFORM %GET_BASESTATUS(LOCAL:1+1),4%{MAXBASE:ARG:(GET_BASESTATUS(LOCAL:1+1)),4}({BASE:ARG:(GET_BASESTATUS(LOCAL:1+1)),4})　
		;SHOW_STATUS_WINDOW.ERB
		CALL CALC_BASESTASUS_BAR_PROP, ARG, LOCAL:1+1, 100, 50
		ARRAYCOPY "RESULT", "STAT"
		FOR LOCAL, 0, 4
			CALL PRINT_COLOR, UNICODE(0x258B) * MAX(STAT:(LOCAL), 0), FLAG:@"능력치그래프컬러{LOCAL+1}"
		NEXT
		PRINTS " " * (50 - SUMARRAY(STAT))
		PRINTFORM %GET_BATTLESTATUS(LOCAL:1),8,LEFT%
		PRINTFORML {MAXBASE:ARG:(GET_BATTLESTATUS(LOCAL:1)),5} 
	NEXT
	DRAWLINE

	;11、12行目に被攻撃相性と継承可能表示
	PRINTL 전투상성
	FOR LOCAL,0,FLAG:상성수
			CALL SET_AISYOU_COLOR, MAXBASE:ARG:(GET_TYPE(LOCAL))
			PRINTFORM %GET_TYPE(LOCAL) %\@(MAXBASE:ARG:(GET_TYPE(LOCAL)) < 0) ? 흡 # 　\@
			PRINTFORM \@ ((MAXBASE:ARG:(GET_TYPE(LOCAL)) != 999)) ? {ABS(MAXBASE:ARG:(GET_TYPE(LOCAL))),4}％ # %" " *2%반사 \@　
			;PRINTFORM {ABS(MAXBASE:ARG:(GET_TYPE(LOCAL)),4}％
		SIF LOCAL % 6 == 5
			PRINTL
	NEXT
	RESETCOLOR
	DRAWLINE
	CALL PRINT_SKILL

	EQUIP:ARG:100 = LOCAL:2
	;ステータス復帰
	CALL SYNC_STATUS, ARG

@CHANGE_PERSONA(ARG)
	;ARGは付け替えるキャラの登録番号
	DRAWLINE
	IF イベントフラグ:5:0 == 3
		PRINTFORMW 강마시킬 페르소나를 선택해주십시오
	ELSE
		PRINTFORMW 강마시킬 페르소나를 선택해주세요
	ENDIF
	DRAWLINE
	$INPUT_LOOP1
	FOR LOCAL, 0, 3
		LOCALS = 소지페르소나{LOCAL+1}
		IF EQUIP:ARG:LOCALS
			PRINTFORM [{LOCAL}]
			IF EQUIP:ARG:장비페르소나 == EQUIP:ARG:LOCALS
				PRINT *
			ELSE
				PRINT  
			ENDIF
			PRINTSL CSVNAME(DITEMTYPE:(EQUIP:ARG:(LOCALS)):페르소나("NO"),0)
		ELSE
			BREAK
		ENDIF
	NEXT
	IF ABL:ARG:초기페르소나 > 0
		PRINT [9]

		IF EQUIP:ARG:장비페르소나
			PRINT  
		ELSE
			PRINT *
		ENDIF
		PRINTFORML %CSVNAME(ABL:ARG:초기페르소나,0)%
	ENDIF
	PRINTL [99] 스테이터스를 확인한다
	PRINTL [100] 돌아간다
	$INPUT_LOOP
	INPUT
	IF RESULT >= 0 && RESULT <= LOCAL
		LOCALS = 소지페르소나{RESULT+1}
		;変更前と変更後でペルソナが一致している
		IF EQUIP:ARG:LOCALS == EQUIP:ARG:장비페르소나
			IF イベントフラグ:5:0 == 3
				PRINTFORMW 이런, 그 페르소나는 이미 강마되어 있군요
			ELSE
				PRINTFORMW 그 페르소나는 이미 강마되어 있습니다
			ENDIF
			GOTO INPUT_LOOP1
		ELSE
			;ペルソナを装備
			EQUIP:ARG:장비페르소나 = EQUIP:ARG:LOCALS
			PRINTFORM %CSVNAME(DITEMTYPE:(EQUIP:ARG:장비페르소나):페르소나("NO"),0)%
			IF イベントフラグ:5:0 == 3
				PRINTFORMW 을(를) 강마하셨습니다
			ELSE
				PRINTFORMW 을(를) 강마했습니다
			ENDIF
		ENDIF
	ELSEIF RESULT == 9
		SIF ABL:ARG:초기페르소나 == 0
			GOTO INPUT_LOOP
		IF EQUIP:ARG:장비페르소나 == 0
			IF イベントフラグ:5:0 == 3
				PRINTFORMW 이런, 그 페르소나는 이미 강마되어 있군요
			ELSE
				PRINTFORMW 그 페르소나는 이미 강마되어 있습니다
			ENDIF
			GOTO INPUT_LOOP1
		ENDIF
		DITEMTYPE:(EQUIP:ARG:장비페르소나):페르소나("装備状態") = -1
		EQUIP:ARG:장비페르소나 = 0
		EQUIP:ARG:전회페르소나 = 0
		CALL SYNC_STATUS,ARG
		PRINTFORM %CSVNAME(ABL:ARG:초기페르소나,0)%
		IF イベントフラグ:5:0 == 3
			PRINTFORMW 을(를) 강마하셨습니다
		ELSE
			PRINTFORMW 을(를) 강마했습니다
		ENDIF
		RETURN 0
	ELSEIF RESULT == 99
		LOCAL = 0
		$INPUT_LOOP2
		FOR LOCAL:1, 1, 4
			LOCALS = 소지페르소나{LOCAL:1}
			IF EQUIP:ARG:LOCALS
				PRINTFORM [{LOCAL:1 - 1}]
				IF EQUIP:ARG:장비페르소나 == EQUIP:ARG:LOCALS
					PRINT *
				ELSE
					PRINT  
				ENDIF
				PRINTFORML %CSVNAME(DITEMTYPE:(EQUIP:ARG:LOCALS):페르소나("NO"),0)% (페르소나만)
			ELSE
				BREAK
			ENDIF
		NEXT
		FOR LOCAL:1, 1, 4
			LOCALS = 소지페르소나{LOCAL:1}
			IF EQUIP:ARG:LOCALS
				PRINTFORM [{LOCAL:1+2}]
				IF EQUIP:ARG:장비페르소나 == EQUIP:ARG:LOCALS
					PRINT *
				ELSE
					PRINT  
				ENDIF
				PRINTFORML %CSVNAME(DITEMTYPE:(EQUIP:ARG:LOCALS):페르소나("NO"),0)%(페르소나구사자＋페르소나)
			ELSE
				BREAK
			ENDIF
		NEXT
		IF ABL:ARG:초기페르소나
			PRINT [8]
			IF EQUIP:ARG:장비페르소나
				PRINT  
			ELSE
				PRINT *
			ENDIF
			PRINTFORML %CSVNAME(ABL:ARG:초기페르소나,0)%(페르소나)
			PRINT [9]
			IF EQUIP:ARG:장비페르소나
				PRINT  
			ELSE
				PRINT *
			ENDIF
			PRINTFORML %CSVNAME(ABL:ARG:초기페르소나,0)%(페르소나구사자＋페르소나)
		ENDIF
		PRINTL [100] 돌아간다
		$INPUT_LOOP3
		INPUT
		IF (RESULT >= 0 && RESULT <= LOCAL:1 - 1) || (RESULT >= 3 && RESULT <= LOCAL:1+2) || ((RESULT == 8 || RESULT == 9) && ABL:ARG:초기페르소나)
			IF RESULT < 3 
				CALL PERSONA_STATUS(EQUIP:ARG:(GETNUM(EQUIP, "소지페르소나1") + RESULT))
			ELSEIF RESULT == 8 && ABL:ARG:초기페르소나
				CALL PERSONA_STATUS(CFLAG:ARG:초기페르소나넘버)
			ELSE
				IF RESULT == 9 && ABL:ARG:초기페르소나
					LOCAL = 0
				ELSE
					LOCAL = EQUIP:ARG:(RESULT + GETNUM(EQUIP, "소지페르소나1") - 3)
				ENDIF
				CALL SHOW_PERSONA_MASTER_STATUS(ARG, LOCAL)
			ENDIF
			GOTO INPUT_LOOP2
		ELSEIF RESULT == 100
			RESTART
		ELSE
			GOTO INPUT_LOOP3
		ENDIF
	ELSEIF RESULT == 100
		RETURN 0
	ELSE
		GOTO INPUT_LOOP
	ENDIF
	;能力の同期化
	CALL SYNC_STATUS,ARG
	;装備状態フラグの更新
	DITEMTYPE:(EQUIP:ARG:장비페르소나):페르소나("装備状態") = -2
	DITEMTYPE:(EQUIP:ARG:전회페르소나):페르소나("装備状態") = -1
	;前回装備ペルソナとして今回のペルソナを記録
	EQUIP:ARG:전회페르소나 = EQUIP:ARG:장비페르소나

@CHANGE_EQUIP_PERSONA, L_CHARA, L_PERSONA
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PERSONA
#DIM DYNAMIC L_PERSONA_NO
IF L_PERSONA == "초기페르소나"
	L_PERSONA_NO = CFLAG:L_CHARA:초기페르소나넘버
	SIF EQUIP:L_CHARA:장비페르소나 == 0
		RETURN 0
	EQUIP:L_CHARA:장비페르소나 = 0
ELSE
	L_PERSONA_NO = EQUIP:L_CHARA:L_PERSONA
	SIF L_PERSONA_NO == EQUIP:L_CHARA:장비페르소나
		RETURN 0
	EQUIP:L_CHARA:장비페르소나 = L_PERSONA_NO
ENDIF
CALL SYNC_STATUS,L_CHARA
;装備状態フラグの更新
DITEMTYPE:(EQUIP:L_CHARA:장비페르소나):페르소나("装備状態") = -2
DITEMTYPE:(EQUIP:L_CHARA:전회페르소나):페르소나("装備状態") = -1
;前回装備ペルソナとして今回のペルソナを記録
EQUIP:L_CHARA:전회페르소나 = EQUIP:L_CHARA:장비페르소나

@PERSONA_EQUIP
	#LOCALSIZE 300
	VARSET LOCAL
	CALL PERSONA_MASTER_LIST
	LOCAL = RESULT
	SIF RESULT == -1
		RETURN -1
	DRAWLINE
	PRINTFORML %CALLNAME:LOCAL%이(가) 현재 소지 중인 페르소나
	FOR LOCAL:1, 1, 4
		LOCALS = 소지페르소나{LOCAL:1}
		IF EQUIP:LOCAL:LOCALS
			IF EQUIP:LOCAL:장비페르소나 == EQUIP:LOCAL:LOCALS
				PRINT *
			ELSE
				PRINT  
			ENDIF
			PRINTSL CSVNAME(DITEMTYPE:(EQUIP:LOCAL:LOCALS):페르소나("NO"),0)
			LOCAL:5 += 1
		ELSE
			BREAK
		ENDIF
	NEXT
	DRAWLINE

	PRINTFORML %CALLNAME:LOCAL%에게 소지시킬 페르소나를 골라 주십시오
	FOR LOCAL:1, 1, 12
		IF DITEMTYPE:(LOCAL:1):0 == 0
			CONTINUE
		ELSEIF DITEMTYPE:(LOCAL:1):페르소나("装備状態") > 0
			PRINTFORML [{LOCAL:4}] %CSVNAME(DITEMTYPE:(LOCAL:1):페르소나("NO"),0)%
			LOCAL:(LOCAL:4 + 10) = LOCAL:1
			LOCAL:4 += 1
		ENDIF
	NEXT
	PRINTL [100] 돌아간다
	$INPUT_LOOP2
	INPUT
	IF RESULT == 100
		RETURN 0
	ELSEIF RESULT < 100 && RESULT >= 0 && LOCAL:(RESULT + 10)
		LOCAL:6 = RESULT
		CALL SHOW_PERSONA_MASTER_STATUS(LOCAL, LOCAL:(LOCAL:6 + 10))
		CSVNAME DITEMTYPE:(LOCAL:(LOCAL:6 + 10)):페르소나("NO"), 0
		PRINTFORML %RESULTS%을(를) %CALLNAME:LOCAL%에게 강마시킬 경우, 위와 같은 스탯이 됩니다
		PRINTFORMW 정말로 건네주어도 괜찮겠습니까? 
		
		CALL INPUT_YN,"Yes","No",2

		IF RESULT == 1
			RETURN 0
		ENDIF

		;3個所持してる場合は入れ替えるペルソナを選ぶ
		IF LOCAL:5 == 2
			;新しく所持させるペルソナ
			LOCAL:2 = LOCAL:(LOCAL:6 + 10)
			PRINTFORML 교체할 페르소나를 골라 주십시오
			FOR LOCAL:1, 0, 2
				LOCALS = 소지페르소나{LOCAL:1 + 1}
				IF EQUIP:LOCAL:LOCALS == EQUIP:LOCAL:장비페르소나
					PRINT *
				ELSE
					PRINT  
				ENDIF
				PRINTFORML [{LOCAL:1}] %CSVNAME(DITEMTYPE:(EQUIP:LOCAL:LOCALS):1, 0)%
			NEXT
			PRINTL [100] 돌아간다
		ELSE
			EQUIP:LOCAL:(LOCAL:5 + GETNUM(EQUIP, "소지페르소나1")) = LOCAL:(LOCAL:6 + 10)
			DITEMTYPE:(LOCAL:(LOCAL:6 + 10)):페르소나("装備状態") = -1
			DITEMTYPE:(LOCAL:(LOCAL:6 + 10)):페르소나("ペルソナ所持者") = CFLAG:LOCAL:캐릭터고유번호
			RETURN 0
		ENDIF
	ELSE
		GOTO INPUT_LOOP2
	ENDIF
	$INPUT_LOOP3
	INPUT
	IF RESULT <= LOCAL:1 && RESULT >= 0
		LOCALS = 소지페르소나{RESULT + 1}
		;外れたペルソナはストックへ
		DITEMTYPE:(EQUIP:LOCAL:LOCALS):페르소나("装備状態") = 1
		DITEMTYPE:(EQUIP:LOCAL:LOCALS):페르소나("ペルソナ所持者") = -1
		;ペルソナを入れ替える
		EQUIP:LOCAL:LOCALS = LOCAL:2
		;つけたペルソナは所持中に
		DITEMTYPE:(LOCAL:2):페르소나("装備状態") = -1
		DITEMTYPE:(LOCAL:2):페르소나("ペルソナ所持者") = CFLAG:LOCAL:캐릭터고유번호
		;現在装備してるペルソナと入れ替える場合
		IF EQUIP:LOCAL:LOCALS == EQUIP:LOCAL:장비페르소나
			EQUIP:LOCAL:장비페르소나 = 0
			;能力の同期化
			CALL SYNC_STATUS, LOCAL
		ENDIF
	ELSEIF RESULT == 100
		RETURN 0
	ELSE
		GOTO INPUT_LOOP3
	ENDIF
@PERSONA_UNEQUIPMENT(ARG, ARG:1)
	;ARG 페르소나구사자
	;ARG:1　外すペルソナ
	IF EQUIP:ARG:장비페르소나 == ARG:1
		EQUIP:ARG:장비페르소나 = 0
		EQUIP:ARG:전회페르소나 = 0
	ENDIF
	FOR LOCAL, 1, 4
		IF EQUIP:ARG:("소지페르소나"+TOSTR(LOCAL)) == ARG:1
			EQUIP:ARG:("소지페르소나"+TOSTR(LOCAL)) = 0
			LOCAL:1 = LOCAL
			BREAK
		ENDIF
	NEXT
	DITEMTYPE:(ARG:1):페르소나("装備状態") = 1
	DITEMTYPE:(ARG:1):페르소나("ペルソナ所持者") = -1
	;番号をずらす
	FOR LOCAL, LOCAL:1, 3
		EQUIP:ARG:("소지페르소나"+TOSTR(LOCAL)) = EQUIP:ARG:("소지페르소나"+TOSTR(LOCAL+1))
	NEXT
	EQUIP:ARG:소지페르소나3 = 0
	CALL SYNC_STATUS,ARG

@DEL_PERSONA
	#DIM 帰還アイテム
	PRINTFORML 기억의 바다로 되돌릴 페르소나를 골라 주십시오
	;LOCAL:10~19に削除候補ペルソナを格納
	FOR LOCAL, 1, 12
		IF DITEMTYPE:LOCAL:0 == 0
			BREAK
		ELSE
			PRINTFORM [{LOCAL-1}] %CSVNAME(DITEMTYPE:LOCAL:페르소나("NO"), 0)%
			IF DITEMTYPE:LOCAL:페르소나("装備状態") == -1
				PRINTFORML (소지중)
			ELSEIF DITEMTYPE:LOCAL:페르소나("装備状態") == -2
				PRINTFORML (강마중)
			ELSE
				PRINTL 
			ENDIF
		ENDIF
	NEXT
	PRINTFORML [100] 돌아간다
	$INPUT_LOOP2
	INPUT
	IF  RESULT == 100
		RETURN 0
	ELSEIF RESULT > 10 || RESULT < 0
		GOTO INPUT_LOOP2
	ELSEIF DITEMTYPE:(RESULT+1):페르소나("装備状態")
		;LOCAL:2は削除するペルソナ番号
		LOCAL:2 = RESULT + 1
		IF DITEMTYPE:(LOCAL:2):페르소나("ランク") >= 5
			PRINTFORML 일깨워졌던 오래된 마음의 형태
			PRINTFORML %CSVNAME(DITEMTYPE:(LOCAL:2):페르소나("NO"),0)%을(를) 해방할 때가
			PRINTFORMW 찾아온 것입니까…
			PRINTFORML 그렇다면 함께 싸웠던, 그 또 다른 마음을
			PRINTFORML 카드로 바꾸어,
			PRINTFORMW 당신에게 돌려드리도록 하지요…
			CALL MAKE_PERSONA_SKILLCARD(LOCAL:2)
			SIF RESULT == -1
				RETURN 0
		ENDIF
		;ここで名前をとっておく
		PRINTFORMW %CSVNAME(DITEMTYPE:(LOCAL:2):페르소나("NO"), 0)%을(를) 보편적 무의식의 바다로 되돌려 보냈습니다

		;帰還アイテム入手処理
		IF DITEMTYPE:(LOCAL:2):페르소나("ランク") >= 10 && DITEMTYPE:(LOCAL:2):페르소나("陥落") > 0
			;DITEMTYPEに新しくペルソナ("帰還アイテム")を作りたくないのでCSVからの読み込みオンリーにする
			帰還アイテム = CSVABL(DITEMTYPE:(LOCAL:2):페르소나("NO"), GETNUM(ABL, "수태아이템"), 0)
			;一つでも所持してるなら無効
			IF 帰還アイテム > 0 && ITEM:帰還アイテム == 0
				PRINTFORMW ＞%ITEMNAME:(帰還アイテム)%을(를) 손에 넣었다
				ITEM:帰還アイテム = 1
			ENDIF
		ENDIF

		CALL DEL_PERSONA2, LOCAL:2

		IF DITEMTYPE:(LOCAL:2):페르소나("ペルソナ所持者") == -1
			PRINTL 강마 중이던 페르소나를 귀환시켰으므로
			PRINTW 강마하고 있던 페르소나 구사자는 자동으로 초기 페르소나를 강마하므로 주의하시기를
		ENDIF
		DRAWLINE
	ELSE
		GOTO INPUT_LOOP2
	ENDIF

@DEL_PERSONA2, ARG
	;装備されている場合は外す処理
	IF DITEMTYPE:ARG:페르소나("装備状態") < 0
		LOCAL = FINDCHARA_ID(DITEMTYPE:ARG:페르소나("ペルソナ所持者"))
		SIF LOCAL >= 0
			CALL PERSONA_UNEQUIPMENT(LOCAL, ARG)
	ENDIF
	FOR LOCAL, 0, CHARANUM
		SIF TALENT:LOCAL:페르소나구사자 == 0
			CONTINUE
		;EQUIP:100~104で削除するペルソナより番号が大きいものは-1
		FOR LOCAL:1, GETNUM(EQUIP, "장비페르소나"), GETNUM(EQUIP, "전회페르소나") + 1
			SIF EQUIP:LOCAL:(LOCAL:1) > ARG
				EQUIP:LOCAL:(LOCAL:1) -= 1
		NEXT
	NEXT
	;ペルソナ削除作業
	FOR LOCAL, ARG,10
		FOR LOCAL:1, 0, 100
			DITEMTYPE:LOCAL:(LOCAL:1) = DITEMTYPE:(LOCAL+1):(LOCAL:1)
		NEXT
	NEXT
	FOR LOCAL:1, 0, 100
		DITEMTYPE:10:(LOCAL:1) = 0
	NEXT

@REMOVE_PERSONA, ARG
#DIM LCOUNT
;ペルソナ使いの場合はペルソナをひっぺがし、つくっていた初期ペルソナを消す
FOR LCOUNT, 1, 4
	LOCALS = 소지페르소나{LCOUNT}
	IF EQUIP:ARG:LOCALS
		DITEMTYPE:(EQUIP:ARG:LOCALS):페르소나("装備状態") = 1
		DITEMTYPE:(EQUIP:ARG:LOCALS):페르소나("ペルソナ所持者") = -1
	ENDIF
NEXT
IF CFLAG:ARG:초기페르소나넘버
	FOR LCOUNT, 0, 100
		DITEMTYPE:(CFLAG:ARG:초기페르소나넘버):LCOUNT = 0
	NEXT
ENDIF
CFLAG:ARG:초기페르소나넘버 = 0
ABL:ARG:초기페르소나 = 0
;スキルをクリア
FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
	ABL:ARG:@"스킬{LCOUNT}" = 0
NEXT

