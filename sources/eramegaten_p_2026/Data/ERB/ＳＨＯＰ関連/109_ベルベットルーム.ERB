;LOCAL:1 = 11
PERSONA_INDEX = 11
FOR LOCAL, 0, CHARANUM
	SIF TALENT:LOCAL:페르소나구사자 == 0
		CONTINUE
	IF !SHOW_HIDDEN
		SIF CFLAG:LOCAL:필터링플래그
			CONTINUE
		SIF GET_VALUE_TALENT_JOINABLE(LOCAL) == 0
			CONTINUE
		SIF CFLAG:LOCAL:이자리에없는플래그 == 1
			CONTINUE
		SIF CFLAG:LOCAL:전투이외불능
			CONTINUE
;---- EDIT 025 MOD ステータス確認時、戦えないキャラのペルソナも見れるように(赤色になる)-------------------------
	ELSEIF SHOW_HIDDEN
		SIF CFLAG:LOCAL:필터링플래그
			SETCOLOR COLOR("red")
		SIF GET_VALUE_TALENT_JOINABLE(LOCAL) == 0
			SETCOLOR COLOR("red")
		SIF CFLAG:LOCAL:이자리에없는플래그 == 1
			SETCOLOR COLOR("red")
	ENDIF
	SELECTCASE SHOW_PARAM_SETTING
		CASE 1
			PRINTFORML [{PERSONA_INDEX,2}] %CSVNAME(DITEMTYPE:(CFLAG:LOCAL:초기페르소나넘버):페르소나("NO"),0),20,LEFT%　LV:{DITEMTYPE:(CFLAG:LOCAL:초기페르소나넘버):페르소나("LV"),3}　소지자:%CALLNAME:LOCAL,20,LEFT%
			LOCAL:1 = 0
			REPEAT 6
				LOCAL:1 += DITEMTYPE:(CFLAG:LOCAL:초기페르소나넘버):(페르소나("힘상승률")+COUNT)
			REND
			IF LOCAL:1 == 0
				CALL PERSONA_PARAM_DIST_INIT(CFLAG:LOCAL:초기페르소나넘버)
				REPEAT 6
					LOCAL:1 += DITEMTYPE:(CFLAG:LOCAL:초기페르소나넘버):(페르소나("힘상승률")+COUNT)
				REND
				LOCAL:1 = MAX(1,LOCAL:1)
			ENDIF
			REPEAT 6
				LOCAL:2 = DITEMTYPE:(CFLAG:LOCAL:초기페르소나넘버):(페르소나("힘상승률")+COUNT)
				LOCAL:3 = LOCAL:2 * 1000 / LOCAL:1
				LOCALS = {LOCAL:2,3}\({LOCAL:3/10,2}.{LOCAL:3%10}\%\)
				CALL SETCOLOR_AUTOIF2(LOCAL:3)
				PRINTFORM %SUBSTRINGU(BASENAME:(GETNUM(BASE,"힘")+COUNT),0,1)%%LOCALS%　　
			REND
			RESETCOLOR
			PRINTL
		CASEELSE
			PRINTFORML [{PERSONA_INDEX,2}] %CSVNAME(DITEMTYPE:(CFLAG:LOCAL:초기페르소나넘버):페르소나("NO"),0),20,LEFT%　LV:{DITEMTYPE:(CFLAG:LOCAL:초기페르소나넘버):페르소나("LV"),3}　EXP:{DITEMTYPE:(CFLAG:LOCAL:초기페르소나넘버):페르소나("EXP"),4}　소지자:%CALLNAME:LOCAL,20,LEFT%
	ENDSELECT
	Q:PERSONA_INDEX = CFLAG:LOCAL:초기페르소나넘버
	PERSONA_INDEX++ 
	RESETCOLOR
NEXT
