		FLAG:마카환율1 = 30
		FLAG:마카환율2 = 10+RAND:51
		FLAG:마카환율3 = 10+RAND:51
	ENDIF
	L_RATE = FLAG:마카환율1
ELSE
	L_RATE = 50
ENDIF
PRINTFORML 얼마나 마카를 ￥으로 교환하시겠습니까？(1마카＝￥{L_RATE})
CALL INPUT_MANY, 0, MONEY:1, , , "EXCHANGE_MONEY_INPUT_SIDEBUTTON", "EXCHANGE_MONEY_INPUT_TEXT", L_RATE
IF RESULT == 0
	RETURN 0
ELSE
	PRINTFORMW {RESULT}마카를 ￥{RESULT*L_RATE}으로 교환했습니다。
	MONEY += RESULT*L_RATE
	MONEY:1 -= RESULT
ENDIF

