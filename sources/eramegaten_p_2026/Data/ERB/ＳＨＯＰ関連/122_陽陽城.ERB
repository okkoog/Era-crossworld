	IF MONEY:1 < ITEMPRICE:(LOCAL:2)
		PRINTW 마카가 부족합니다
		GOTO PRINT_LIST
	ELSE
		PRINTFORML 몇 개 구입하시겠습니까？ (현재 {ITEM:(LOCAL:2)}개 소지)
		;---- EDIT 021 MOD START -------------------------
		CALL INPUT_MANY, 0, MIN(MONEY:1/ITEMPRICE:(LOCAL:2), LOCAL:3 - ITEM:(LOCAL:2)), , , , "EXCHANGE_ITEM_INPUT_TEXT", ITEMPRICE:(LOCAL:2)
		;---- EDIT 021 MOD END ---------------------------
		IF RESULT == 0
			GOTO PRINT_LIST
		ELSE
			MONEY:1 -= (RESULT * ITEMPRICE:(LOCAL:2))
			IF RESULT == 1
				PRINTFORMW ＜%ITEMNAME:(LOCAL:2)%을 구입했습니다＞
			ELSE
				PRINTFORMW ＜%ITEMNAME:(LOCAL:2)%을(를) {RESULT}개 구입했습니다＞
			ENDIF
			CALL GET_ITEM,LOCAL:2,RESULT
			IF GETBIT(FLAG:정크숍설정,0) && LOCAL < 7 && 比較者 > -1 && 比較者 < CHARANUM
				RESULT = 0
				TRYCALLFORM 装備条件_{LOCAL:2},比較者
				IF RESULT > 0
					PRINTFORMW %CALLNAME:比較者%에게 장착하시겠습니까？　[0]네　[1]아니오
					INPUT
					SIF RESULT == 0
						CALL 装備変更 , 比較者 , LOCAL , LOCAL:2
				ENDIF
			ENDIF
			GOTO PRINT_LIST
		ENDIF
	ENDIF
ELSE
	GOTO INPUT_LOOP2
ENDIF
GOTO PRINT_LIST

