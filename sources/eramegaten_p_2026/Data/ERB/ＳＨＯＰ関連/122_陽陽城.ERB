@MAKE_EXCHANGEITEMLIST,ARG
VARSET アイテムリスト,-1
LOCAL:1 = 0
IF ARG < 8
	;FOR LOCAL,2000,VARSIZE("ITEM") EDIT MOD 019
	FOR LOCAL, MIN_EQUIPNUM, MAX_EQUIPNUM
		SIF ITEMPRICE:LOCAL == 0
			CONTINUE
		RESULT = 12
		TRYCCALLFORM 装備箇所_{LOCAL}
			IF RESULT == ARG
				RESULT = 0
				TRYCALLFORM EQUIP_EXCHANGE_{LOCAL}
				SIF RESULT == 0
					CONTINUE
				アイテムリスト:(LOCAL:1) = LOCAL
				LOCAL:1 += 1
			ENDIF
		CATCH
		ENDCATCH
	NEXT
ELSE
	;FOR LOCAL,1001,2000EDIT MOD 019
	FOR LOCAL, MIN_USEITEMNUM, MAX_USEITEMNUM
		SIF ITEMPRICE:LOCAL == 0
			CONTINUE
		RESULT = 0
		TRYCALLFORM ITEM_EXCHANGE_{LOCAL+2000}
		SIF RESULT == 0
			CONTINUE
		アイテムリスト:(LOCAL:1) = LOCAL
		LOCAL:1 += 1
	NEXT
ENDIF
RETURN LOCAL:1

