	ELSEIF LOCAL == 7
		CALLFORM 装備解説_{LOCAL:2}
		PRINTL
		LOCAL:3 = 999
		IF ITEM:(LOCAL:2) >= 999
			PRINTW 더 이상 가질 수 없습니다
			GOTO PRINT_LIST
		ENDIF
	ELSE
		CALL GET_ITEMMAX, LOCAL:2
		LOCAL:3 = RESULT
		PRINTFORML %ITEMNAME:(LOCAL:2),20,LEFT%   所持数：{ITEM:(LOCAL:2)}/{LOCAL:3}
		SIF FLAG:스킬속성표시설정 == 1
			CALL SKILL_EXPLAIN_PERFORMANCE, LOCAL:2 + 2000, -1
		CALL GET_SKILL_PROP, "SKILL_EXPLAIN", LOCAL:2+2000, -1
		DRAWLINE
		IF ITEM:(LOCAL:2) >= LOCAL:3
			PRINTW 더 이상 가질 수 없습니다
