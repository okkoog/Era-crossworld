;アイテムの生成個数を算出する関数
;高級傷薬2-5
@GOUSEI_高級傷薬_NUM
RESULT = 2
SIF (RAND:100 < (ABL:MASTER:기교 * 10))
	RESULT += 1
SIF ((BASE:MASTER:운 / BASE:MASTER:LV * 8) > 1) && (RAND:100 < (ABL:MASTER:기교 * 10))
	RESULT += 1
SIF ((BASE:MASTER:운 / BASE:MASTER:LV * 4) > 1) && (RAND:100 < (ABL:MASTER:기교 * 10))
	RESULT += 1
RETURN RESULT

;メディカルキット2-5
@GOUSEI_メディカルキット_NUM
CALL GOUSEI_高級傷薬_NUM
RETURN RESULT

;宝玉1-4
@GOUSEI_宝玉_NUM
CALL GOUSEI_高級傷薬_NUM
RETURN RESULT - 1




