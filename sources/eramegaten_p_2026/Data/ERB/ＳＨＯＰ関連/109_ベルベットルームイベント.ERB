
@VELVET_ROOM_EVENT
#DIM CHARA

;シックスが非奴隷ルートで仲魔になり、パーティー内にいる
CHARA = FINDCHARA(NO,[[キャラ:식스]])
IF CHARA > -1 && FINDCHARA_B([[キャラ:식스]]) == 2 && ダンジョンフラグ:92:18 == 1
	PRINTFORMW 「호오, 참으로 훌륭한 분을 모셔오셨군요」
	PRINTFORMW 이고르는 %CALLNAME:CHARA%에게 강한 흥미를 보인 듯하다…
	PRINTFORMW 「빙의된 것… 아니, 수호령이라 불러야 할까요」
	PRINTFORMW 「그를 비호하려는 강한 무언가가 깃들어 있는 듯합니다」
	PRINTFORMW 「원하신다면, 그 힘을 페르소나라는 형태로 강림시키는 것도 가능합니다만… 어찌하시겠습니까」
	PRINTFORMW %CALLNAME:CHARA%을(를) 페르소나 구사자로서…
	CALL INPUT_YN("각성시킨다","각성시키지 않는다")
	IF RESULT == 0

		ダンジョンフラグ:92:18 = 2
		PRINTFORMW %CALLNAME:CHARA%에게 쏟아지는 빛이 소녀의 모습으로 변한다
		PRINTFORMW VR 호러 하우스에서 만났던 악마의 모습이다, 하지만 그 표정은 온화함으로 가득 차 있었다
		PRINTFORMW 과거 %CALLNAME:CHARA%이(가) 사랑했고, 그리고 잃어버렸던 누나의 본래 모습인 것이리라
		PRINTL
		PRINTFORMW ＞%CALLNAME:CHARA%의 과거를 극복해낸 마음이 힘으로 변한다…
		PRINTL
		;PRINTFORMW %CALLNAME:CHARA%の[道具知識Lv3]は[道具知識Lv1]になった
		PRINTFORMW %CALLNAME:CHARA%은(는) [건슬링거Lv3]에서 [건슬링거Lv1]이 되었다
		PRINTFORMW %CALLNAME:CHARA%은(는) [페르소나구사자]를 얻었다
		PRINTL
		PRINTFORMW 「역시, \@ IS_MALE(CHARA) ? 그 # 그녀 \@에게는 비장된 힘이 있었군요… 훌륭합니다」
		PRINTFORMW 「앞으로는 페르소나 구사자로서 당신의 힘이 되어주겠지요」
		CFLAG:CHARA:이벤트가입 = 1
		CALLFORM SET_BTL_TALENT_{NO:CHARA}, CHARA, 1
	ELSE
		ダンジョンフラグ:92:18 = 3
		PRINTFORMW 「그러십니까… 대단히 결례를 범했군요」
	ENDIF
	PRINTFORMW 「그럼, 용건을 여쭈어볼까요」
	RETURN 1
ENDIF


RETURN 0