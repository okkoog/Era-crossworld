
@SIAWASE_TICKET
#DIM RARE_TABLE, 100;シークレットのテーブル。100枚以上はいりそうなら拡張してください
#DIM RARE_NUM, 6;各ランク毎のシークレットの数
#DIM LCOUNT, 2
#DIM GET_CARD
;シークレットのテーブル作成
VARSET RARE_TABLE
VARSET RARE_NUM
FOR LCOUNT, 100, 600
	SIF SIAWASE_TICKET_RARE_TABLE(LCOUNT) < 0
		CONTINUE
	RARE_TABLE:RARE_NUM = SIAWASE_TICKET_RARE_TABLE(LCOUNT)
	RARE_NUM++
	FOR LCOUNT:1, LCOUNT / 100, VARSIZE("RARE_NUM")
		RARE_NUM:(LCOUNT:1)++
	NEXT
NEXT
LOCAL:11 = LINECOUNT
$LP
CLEARLINE LINECOUNT - LOCAL:11
VARSET RESULTS
VARSET X

PRINTFORML 무엇과 교환하시겠습니까？		행복티켓 {ITEM:361}장
DRAWLINE
CALL TICKET_EXCHANGE_表示,1,"스킬카드 상자 LV1",5
SIF FLAG:조직공헌LV >= 2
	CALL TICKET_EXCHANGE_表示,2,"스킬카드 상자 LV2",15
SIF FLAG:조직공헌LV >= 5
	CALL TICKET_EXCHANGE_表示,3,"스킬카드 상자 LV3",35
SIF FLAG:조직공헌LV >= 9
	CALL TICKET_EXCHANGE_表示,4,"스킬카드 상자 LV4",90
SIF FLAG:조직공헌LV >= 13
	CALL TICKET_EXCHANGE_表示,5,"스킬카드 상자 LV5",190
CALL TICKET_EXCHANGE_表示,6,"Ｐ성장카드 상자",80



PRINTL 
PRINTL [1000] 행복티켓이란？
PRINTL [1001] 스킬카드 상자 라인업
CUSTOMDRAWLINE =
PRINTL [99] 돌아간다 [100] 가게를 나간다
INPUT
IF RESULT == 99
	VARSET RESULTS
	RETURN -1
ELSEIF RESULT == 100
	VARSET RESULTS
	RETURN 0
ELSEIF RESULT == 1000
	PRINTL 점주：
	PRINTW 「우리 가게에서 물건을 사면 주는 티켓이다」
	PRINTW 「￥1000 이상 사 주면 얹어 주지」
	PRINTW 「단, JP로는 안 줘　티켓을 원하면 ￥으로 물건을 사라고」
	GOTO LP
ELSEIF RESULT == 1001
	FOR LOCAL:1,1,6
		CALL SKILL_STOCK_AD,LOCAL:1 * 3 - 2,LOCAL:1 * 3
		PRINTFORML 스킬카드 상자 LV{LOCAL:1}
		FOR LOCAL, 0 ,A
			CALL GET_SKILL_PROP, "SKILL_NAME", D:LOCAL,-1
			PRINTFORM %RESULTS,22%
			SIF LOCAL % 3 == 2
				PRINTL
		NEXT
		SETCOLOR 0xffff00
		PRINTFORML %@"시크릿 {RARE_NUM:(LOCAL:1)}종",22%
		RESETCOLOR
		PRINTL
		PRINTW
	NEXT
	GOTO LP
ENDIF
SIF RESULT > 999
	GOTO LP
SIF X:RESULT < 1 || ITEM:361 < X:RESULT
	GOTO LP
LOCAL = RESULT
PRINTFORML {X:LOCAL}장을 사용해 %RESULTS:LOCAL%와(과) 교환하시겠습니까？
PRINTL [0] 네 [1] 아니오
INPUT
SIF RESULT == 1
	GOTO LP
$ONEMORE
ITEM:361 -= X:LOCAL

IF LOCAL == 6
	SELECTCASE RAND:100
		CASE IS < 1
			LOCAL:1 = 219
		CASE IS < 4
			LOCAL:1 = 218
		CASE IS < 10
			LOCAL:1 = 217
		CASE IS < 20
			LOCAL:1 = 216
		CASEELSE
			LOCAL:1 = 215
	ENDSELECT
	CALL GET_ITEMS(ITEMNAME:(LOCAL:1),1)
	PRINTFORML %조사처리(ITEMNAME:(LOCAL:1),"를")% 입수했다
ELSE
	;D配列に取得可能カードリストを作成。Aがリスト内のカード枚数
	CALL SKILL_STOCK_AD, TOINT(AUTO_SPLIT("0/1/4/7/10/13", "/", LOCAL)), TOINT(AUTO_SPLIT("0/3/6/9/12/15", "/", LOCAL))
	;ランク1~4のシークレットは同ランクのシークレットをそのまま配列に加える
	IF LOCAL < 5
		FOR LCOUNT, RARE_NUM:(LOCAL-1), RARE_NUM:LOCAL
			D:(A++) = RARE_TABLE:LCOUNT
		NEXT
	ENDIF
	GET_CARD = -1
	
	;ランク5は1/総数の確率でシークレット
	IF LOCAL == 5 && !RAND:A
		GET_CARD = RARE_TABLE:RAND(RARE_NUM:4, RARE_NUM:5)
	;さらに1/総数の確率で下位のシークレットカード
	ELSEIF LOCAL > 1 && RARE_NUM:(LOCAL -1) && !RAND:A
		GET_CARD = RARE_TABLE:RAND(0, RARE_NUM:(LOCAL - 1))
	ELSE
		;テーブル判定
		GET_CARD = D:(RAND:A)
	ENDIF
	;入手カードがシークレット配列に入ってるならシークレット
	SIF MATCH(RARE_TABLE, GET_CARD)
		PRINTFORML 시크릿！
	PRINTFORML %ITEMNAME:(10000 + GET_CARD)%을(를) 손에 넣었다
	CALL GET_ITEM, 10000 + GET_CARD, 1
ENDIF

IF ITEM:361 >= X:LOCAL
	PRINTFORML [0]그만둔다　[1]한 번 더（남은 티켓 {ITEM:361}장）
	ONEINPUT
	SIF RESULT == 1
		GOTO ONEMORE
ELSE
	PRINTFORMW
ENDIF
GOTO LP

@TICKET_EXCHANGE_表示,ARG,ARGS,ARG:1
;ARG	クリック番号
;ARGS	名前
;ARG:1	使用チケット数

;Xの配列に使用チケット数を入れる
;RESULTSの配列に使名前を入れる
SIF ITEM:361 < ARG:1
	SETCOLOR COLOR("赤")
PRINTFORM [{ARG,2}]
PRINTFORM %ARGS,20%　
PRINTFORML 　{ARG:1}枚
RESETCOLOR
X:ARG = ARG:1
RESULTS:ARG = %ARGS%

@SKILL_STOCK_AD,ARG = 1,ARG:1 = 15,ARG:2 = 1,ARG:3 = 2500
;ARG:0　最低ランク　　　初期値1
;ARG:1　最大ランク　　　初期値15
;ARG:2　開始スキル番号　初期値1
;ARG:3　終了スキル番号　初期値2500
;Dの配列にスキル番号を入れていき
;A:0にDに入ったスキル数を入れる
SIF ARG:3 > 3900
	ARG:3 = 3900
VARSET D
A = 0
FOR LOCAL, ARG:2 ,ARG:3
	;총～システム系はスキップ
	SIF LOCAL >= 2101 && LOCAL < 2400
		CONTINUE
	;装備知識はスキップ
	SIF LOCAL >= 2438 && LOCAL < 2443
		CONTINUE
	;ガードキル、ブレイクはスキップ
	SIF LOCAL == 30 || LOCAL == 128 || LOCAL == 227 || LOCAL == 338 || LOCAL == 732 || LOCAL == 831 || LOCAL == 932
		CONTINUE
	SIF LOCAL == 1031 || LOCAL == 1133 || LOCAL == 1231 || LOCAL == 1331 || LOCAL == 1431 || LOCAL == 1531 || LOCAL == 1631 || LOCAL == 1731 || LOCAL == 1831 || LOCAL == 1931
		CONTINUE
	SIF LOCAL == 31 || LOCAL == 129 || LOCAL == 228 || LOCAL == 339 || LOCAL == 733 || LOCAL == 832 || LOCAL == 933
		CONTINUE
	SIF LOCAL == 1032 || LOCAL == 1134 || LOCAL == 1232 || LOCAL == 1332 || LOCAL == 1432 || LOCAL == 1532 || LOCAL == 1632 || LOCAL == 1732 || LOCAL == 1832 || LOCAL == 1932
		CONTINUE
	;民族学、アイテム習熟はスキップ
	SIF LOCAL == 2431 || LOCAL == 2430
		CONTINUE
	;英雄スキルはスキップ（継承可能だけど英雄からしか取れないやつ）
	SIF LOCAL == 55 || LOCAL == 564 || LOCAL == 2048 || LOCAL == 2012 || LOCAL == 222 || LOCAL == 39 || LOCAL == 56 || LOCAL == 617 || LOCAL == 57 || LOCAL == 241 || LOCAL == 356 || LOCAL == 146
		CONTINUE
	;ボススキルはスキップ（継承可能だけどボスからしか取れないやつ）
	SIF LOCAL == 2019 || LOCAL == 2070 || LOCAL == 2018
		CONTINUE
	;アイテム系はスキップ
	SIF LOCAL >= 3001 && LOCAL < 3401
		CONTINUE
	
	;継承タイプによる判定
	RESULT = 0
	CALL GET_SKILL_PROP, "敵専用", LOCAL, -1
	SIF RESULT
		CONTINUE
	;ロール指定スキルチェック
	CALL GET_SKILL_PROP, "ロール専用", LOCAL
	SIF RESULT
		CONTINUE	
	;まず継承不能スキルかチェック
	CALL GET_SKILL_PROP, "継承不能", LOCAL, -1
	IF RESULT
		CONTINUE
	ELSE
		CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", LOCAL, -1
		SIF RESULT < 0 || 22 < RESULT
			CONTINUE
	ENDIF
	CALL GET_SKILL_PROP, "SKILL_RANK", LOCAL, -1
	SIF RESULT <= 0 || RESULT > 15
		CONTINUE
	SIF RESULT < ARG || RESULT > ARG:1
		CONTINUE
	RESULT = 0
	TRYCALLFORM SKILL_IS_DEMERIT_{LOCAL}
	SIF RESULT
		CONTINUE
	D:A = LOCAL
	A++
NEXT

