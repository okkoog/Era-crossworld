@SUB_TARGET_ABLE, ARG
CALL SHOPCOMABLE_201
LOCAL = FINDCHARA_TIMEID(TARGET:ARG)
IF LOCAL >= 0
	SIF !PARTNER_ABLE(LOCAL)
		TARGET:ARG = -1
	LOCAL = TARGET:ARG ? LOCAL # -1
ENDIF
IF LOCAL == -1
	;---- EDIT 002 ADD START -------------------------
	;キャラがいなかった場合も、-1を代入
	TARGET:ARG = -1
	;---- EDIT 002 ADD END ---------------------------
	RESULTS = T{ARG}:EMPTY
ENDIF
RETURN RESULT

