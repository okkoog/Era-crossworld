		FOR LOCAL:1, 0, 10
			SIF CFLAG:LOCAL:그룹포지션 == LOCAL:1
				T:(LOCAL:1) = LOCAL
		NEXT
		人数 += 1
	ENDIF
NEXT

FOR ループ用, 0, 10
	CAST = T:ループ用
	SIF CAST < 0
		CONTINUE
	CALL ESTIMATE_CHECK, ARG, 人数, 1, CAST
	IF RESULT == -1
		PRINTFORMW %CALLNAME:CAST%의 이윤을 기대할 수 없기 때문에, 콘서트를 중지합니다
		RETURN 0
	ELSE
	ENDIF
NEXT

$QUESTION_OF_GROUP_LIVE
VARSET 実行可能回数
;次に連続で何回できるか調べる
FOR LOCAL, 0, 10
	CAST = T:LOCAL
	SIF CAST < 0
		CONTINUE
	SELECTCASE LOCAL
	CASE 0
		体力値保管:LOCAL = BASE:CAST:체력
		WHILE 体力値保管:LOCAL > 500
			体力値保管:LOCAL -= 体力値保管:LOCAL / 2
			実行可能回数:LOCAL += 1
		WEND
	CASE 1 TO 2
		体力値保管:LOCAL = BASE:CAST:체력
		WHILE 体力値保管:LOCAL > 500
			体力値保管:LOCAL -= 体力値保管:LOCAL / 3
			実行可能回数:LOCAL += 1
		WEND
	CASE 3 TO 5
		体力値保管:LOCAL = BASE:CAST:체력
		WHILE 体力値保管:LOCAL > 500
			体力値保管:LOCAL -= 体力値保管:LOCAL / 4
			実行可能回数:LOCAL += 1
		WEND
	CASE 6 TO 9
		体力値保管:LOCAL = BASE:CAST:체력
		WHILE 体力値保管:LOCAL > 500
			体力値保管:LOCAL -= 体力値保管:LOCAL / 5
			実行可能回数:LOCAL += 1
		WEND
	ENDSELECT
NEXT
実行回数 = 0
FOR LOCAL, 0, 10
	IF 実行可能回数:LOCAL == 0
	ELSE
		IF 実行回数 == 0
			実行回数 = 実行可能回数:LOCAL
		ELSEIF 実行可能回数:LOCAL < 実行回数
			;一番小さい実行可能回数を拾うこと
			実行回数 = 実行可能回数:LOCAL
		ENDIF
	ENDIF
NEXT

PRINTFORML %グループ名前:ARG%의 콘서트를 실행하겠습니까?
PRINTL [0] 실행한다
SIF 実行回数 > 1
	PRINTFORML [1] 체력이 닿는 한 실행한다（{実行回数}회 실시）
PRINTL [2] 시산 확인（인원수만큼 출력됩니다）
PRINTL [3] 그만둔다
CALL INPUTINT, 0, 1, 2, 3
IF RESULT == 3
	RETURN 0
ELSEIF RESULT == 2
	FOR ループ用, 0, 10
		CAST = T:ループ用
		SIF CAST < 0
			CONTINUE
		CALL ESTIMATE_CHECK, ARG, 人数, 0, CAST
		IF RESULT > 0
			試算合計 += RESULT
		ENDIF
	NEXT
	PRINTL 
	PRINTFORMW 합계 시산：{試算合計}
	DRAWLINE
	GOTO QUESTION_OF_GROUP_LIVE
ELSEIF RESULT == 0
	実行回数 = 1
ENDIF
PRINTFORML %グループ名前:ARG%의 콘서트를 실행합니다.
LOCAL = 0
FOR ループ用, 0, 10
	CAST = T:ループ用
	SIF CAST < 0
		CONTINUE
	LOCAL += ABL:CAST:가창기능
NEXT
;ライブ判定とかグループ人気の上昇値は平均値を参照したい
平均歌唱技能 = LOCAL / 人数

FOR ループ用, 0, 実行回数
	FOR LOCAL, 0, 10
		;この段階でTは初期化されてないので利用できる
		CAST = T:LOCAL
		SIF CAST < 0
			CONTINUE
		CALL ESTIMATE_CHECK, ARG, 人数, 1, CAST
		;こっちにもメモ残し。
		;RESULT:1 = メンバーが全員人気だと1を、それ以外は0を返す
		;RESULT:2 = メンバー全員とLD・LC軸が一致したら1を、一人でもLD・LC軸が不一致なら-1を返す
		;評判判定
		SELECTCASE 平均歌唱技能
		CASE 0
			;成功率20%
			IF RAND:5 == 0
				F = 1
				Z = S
				TIMES Z, 0.05
				S += Z
			ELSE
				F = 0
				Z = S
				TIMES Z, 0.05
				S -= Z
			ENDIF
		CASE 1 TO 3
			;成功率33%
			IF RAND:3 == 0
				F = 1
				Z = S
				TIMES Z, 0.05
				S += Z
			ELSE
				F = 0
				Z = S
				TIMES Z, 0.05
				S -= Z
			ENDIF
		CASE 4 TO 8
			;成功率50%
			IF RAND:2 == 0
				F = 1
				Z = S
				TIMES Z, 0.05
				S += Z
			ELSE
				F = 0
				Z = S
				TIMES Z, 0.05
				S -= Z
			ENDIF
		CASE 10
			;「平均値」が10なので通常より上手くいきやすくてもいいでしょ
			;成功率90%
			IF RAND:10 == 0
				F = 0
				Z = S
				TIMES Z, 0.05
				S -= Z
			ELSE
				F = 1
				Z = S
				TIMES Z, 0.05
				S += Z
			ENDIF
		CASEELSE
			;成功率80%
			IF RAND:5 == 0
				F = 0
				Z = S
				TIMES Z, 0.05
				S -= Z
			ELSE
				F = 1
				Z = S
				TIMES Z, 0.05
				S += Z
			ENDIF
		ENDSELECT
		;F = 1ならライブは成功している
		SIF F == 1
			成功回数 += 1
		
		;流石に一回でいいでしょ？
		IF ループ用 == 0
			LOCAL:1 = TARGET
			TARGET = CAST
			TFLAG:13 = 98
			CALL KOJO_MESSAGE_EVENT
			;KOJO_MESSAGE_EVENT内で MATCH(T,GETCHARA(○○)) > 0 を使うと誰かがいたときに口上を変化させることができる
			TARGET = LOCAL:1
		ENDIF
		
		;ここからいろいろ取得する処理
		;LOCALに現在のポジションが入っているので、ポジション0は特に人気変動を大きく……とかも出来る
		;人数:1～10の範囲を取る/LOCAL:0～9の範囲を取る
		
		;体力の減算
		SELECTCASE LOCAL
		CASE 0
			;ポジション0は現体力の1/2引く
			BASE:CAST:체력 -= BASE:CAST:체력 / 2
		CASE 1 TO 2
			;施設なしでもやれる範囲は現体力の1/3引く
			BASE:CAST:체력 -= BASE:CAST:체력 / 3
		CASE 3 TO 5
			;ライブハウスでやれる範囲は現体力の1/4引く
			BASE:CAST:체력 -= BASE:CAST:체력 / 4
		CASE 6 TO 9
			;大劇場でやれる範囲は現体力の1/5引く
			BASE:CAST:체력 -= BASE:CAST:체력 / 5
		ENDSELECT
		
		;R：取得習得の珠
		;Q：取得歌唱経験
		;難しいことは分からないのでとりあえずコンサートと合わせる
		SELECTCASE ABL:CAST:가창기능
		CASE 0
			R = 8
			Q = 0
		CASE 1
			R = 50
			Q = 1
		CASE 2
			R = 300
			Q = 2
		CASE 3
			R = 900
			Q = 3
		CASE 4
			R = 2400
			Q = 5
		CASE 5
			R = 3000
			Q = 8
		CASE 6
			R = 3500
			Q = 12
		CASE 7
			R = 4000
			Q = 16
		CASE 8
			R = 4500
			Q = 20
		CASE 9
			R = 5000
			Q = 24
		CASE 10
			R = 6000
			Q = 30
		ENDSELECT
		;習得の珠/歌唱経験もポジションによって変更じゃー
		SELECTCASE LOCAL
		CASE 0
			;ポジション0は手を付けない
		CASE 1 TO 2
			IF RESULT:1 == 1 && RESULT:2 == 1
				;全員人気かつアライメント統一済みなら
			ELSEIF RESULT:1 == 1
				;全員人気なら
				TIMES R, 0.80
				TIMES Q, 0.80
			ELSE
				;施設なしでもやれる範囲は0.8倍
				TIMES R, 0.80
				TIMES Q, 0.80
			ENDIF
		CASE 3 TO 5
			IF RESULT:1 == 1 && RESULT:2 == 1
				;全員人気かつアライメント統一済みなら
			ELSEIF RESULT:1 == 1
				;全員人気なら
				TIMES R, 0.80
				TIMES Q, 0.80
			ELSE
				;ライブハウスでやれる範囲は0.5倍
				TIMES R, 0.50
				TIMES Q, 0.50
			ENDIF
		CASE 6 TO 9
			IF RESULT:1 == 1 && RESULT:2 == 1
				;全員人気かつアライメント統一済みなら
			ELSEIF RESULT:1 == 1
				;全員人気なら
				TIMES R, 0.50
				TIMES Q, 0.50
			ELSE
				;大劇場でやれる範囲は0.3倍
				TIMES R, 0.30
				TIMES Q, 0.30
			ENDIF
		ENDSELECT
		
		;せっかくグループだし増やしてもいい気がするなー
		EXP:CAST:라이브경험 += 1
		;変動配列シリーズは0～9に対応ポジションの変動値を保存
		変動_ライブ経験:LOCAL += 1
		;愛情経験は恋慕ルートのみ
		;ここはポジションごとにいじらなくていいでしょ……
		LOCAL:1 = 0
		IF TALENT:CAST:아내 || TALENT:CAST:남편
			LOCAL:1 = RAND:15 + 1
			EXP:CAST:애정경험 += LOCAL:1
			変動_愛情経験:LOCAL += LOCAL:1
		ELSEIF TALENT:CAST:친애
			LOCAL:1 = RAND:10 + 1
			EXP:CAST:애정경험 += LOCAL:1
			変動_愛情経験:LOCAL += LOCAL:1
		ELSEIF TALENT:CAST:연모
			LOCAL:1 = RAND:10 + 1
			EXP:CAST:애정경험 += LOCAL:1
			変動_愛情経験:LOCAL += LOCAL:1
		ENDIF
		;信頼系陥落時は歌唱経験獲得量1.5倍～2.5倍に
		IF TALENT:CAST:맹우
			TIMES Q, 2.50
		ELSEIF TALENT:CAST:동료
			TIMES Q, 2.00
		ELSEIF TALENT:CAST:신뢰
			TIMES Q, 1.50
		ENDIF
		
		;一人で歌う訳ではないのでストレス減らさないのも手か？
		SIF CFLAG:CAST:스트레스치 > 0
			CFLAG:CAST:스트레스치 -= 1
		EXP:CAST:가창경험 += MAX(1 , Q)
		変動_歌唱経験:LOCAL += MAX(1 , Q)
		JUEL:CAST:습득 += R
		変動_習得の珠:LOCAL += R
		
		;G：取得人気
		;個人のアイドル人気の加算（編成人数が少ないほど増える）
		;ソロコンサートよりは絶対少なくなる
		G = (1 + RAND:(1 + ABL:CAST:가창기능)) * (F + 1)
		SELECTCASE 人数
		CASE 2 TO 3
			;施設なしでもやれる範囲は0.8倍
			TIMES G, 0.80
		CASE 4 TO 6
			TIMES G, 0.60
		CASE 7 TO 10
			TIMES G, 0.30
		CASEELSE
		ENDSELECT
		SELECTCASE LOCAL
		CASE 0
			;ポジション0は手を付けない
		CASE 1 TO 2
			IF RESULT:1 == 1 && RESULT:2 == 1
				;全員人気かつアライメント統一済みなら
			ELSEIF RESULT:1 == 1
				;全員人気なら
				TIMES G, 0.80
			ELSE
				;施設なしでもやれる範囲は0.8倍
				TIMES G, 0.80
			ENDIF
		CASE 3 TO 5
			IF RESULT:1 == 1 && RESULT:2 == 1
				;全員人気かつアライメント統一済みなら
			ELSEIF RESULT:1 == 1
				;全員人気なら
				TIMES G, 0.80
			ELSE
				;ライブハウスでやれる範囲は0.5倍
				TIMES G, 0.50
			ENDIF
		CASE 6 TO 9
			IF RESULT:1 == 1 && RESULT:2 == 1
				;全員人気かつアライメント統一済みなら
			ELSEIF RESULT:1 == 1
				;全員人気なら
				TIMES G, 0.50
			ELSE
				;大劇場でやれる範囲は0.3倍
				TIMES G, 0.30
			ENDIF
		CASEELSE
		ENDSELECT
		IF F == 1
			IF ITEM:무도관
				G += 2
			ELSEIF ITEM:라이브하우스
				G += 1
			ENDIF
			CFLAG:CAST:아이돌인기 += G
			変動_アイドル人気:LOCAL += G
		ELSE
			CFLAG:CAST:아이돌인기 -= G
			変動_アイドル人気:LOCAL -= G
		ENDIF
		
		;グループ人気。単純にこうすると実施した人数分グループ人気が上がってしまうので考えないとアカン
		G = (1 + RAND:(1 + 平均歌唱技能)) * (F + 1)
		SELECTCASE 人数
		CASE 2 TO 3
			;施設なしでもやれる規模は0.8倍
			TIMES G, 0.80
		CASE 4 TO 6
			;ライブハウスでやれる規模は手を付けない
		CASE 7 TO 10
			;大劇場でやれる規模は1.15倍
			TIMES G, 1.15
		CASEELSE
		ENDSELECT
		IF F == 1
			IF ITEM:무도관
				G += 2
			ELSEIF ITEM:라이브하우스
				G += 1
			ENDIF
			グループ人気:ARG += G
			変動_グループ人気 += G
		ELSE
			グループ人気:ARG -= G
			変動_グループ人気 -= G
		ENDIF
		
		;取得MAG　せっかくだし盛っていいかもね
		LOCAL:1 = 0
		LOCAL:1 = (G * 100 + (R + D))
		;大劇場は100％吸収
		IF ITEM:무도관
		;ライブハウスは50％吸収
		ELSEIF ITEM:라이브하우스
			LOCAL:1 = LOCAL:1 / 2
		;路上ライブは10％吸収
		ELSE
			LOCAL:1 = LOCAL:1 / 10
		ENDIF
		CALL CONTROL_MAG, CAST, LOCAL:1
		変動_マグネタイト:LOCAL += LOCAL:1
		;グループ熟練度の加算（編成人数が少ないほど増える）
		SELECTCASE 人数
		CASE 2 TO 3
			グループ熟練度:ARG += 4
			変動_熟練度 += 5
		CASE 4 TO 6
			グループ熟練度:ARG += 2
			変動_熟練度 += 2
		CASE 7 TO 10
			グループ熟練度:ARG += 1
			変動_熟練度 += 1
		CASEELSE
		ENDSELECT
		
		MONEY += S
		変動_金 += S
		;専用のFLAGとか作んなきゃダメですかね……
		CALL 帳簿閲覧_労役, CAST, S, 0, 6
	NEXT
NEXT
;集団ライブ終了後の個人パラメータの変動表示
FOR LOCAL, 0, 10
	CAST = T:LOCAL
	SIF CAST < 0
		CONTINUE
