			PRINTL 　그룹 인기에 따른 집객력……있음
	ENDIF
;小人気
ELSEIF グループ人気:ARG > 499
	IF S > 2999
		IF ARG:2 == 0
				SETCOLOR 0xff0033
				PRINTL ※집객이 한계에 도달했습니다, 그룹 인기를 더 올려야 합니다
				PRINTFORML 다음 목표치……1000p
				RESETCOLOR
		ENDIF
		S = 3000
	ELSE
		SIF ARG:2 == 0
			PRINTL 　그룹 인기에 따른 집객력……소
	ENDIF
;人気習得以前
ELSE
	IF S > 1999
		IF ARG:2 == 0
			SETCOLOR 0xff0033
			PRINTL ※집객이 한계에 도달했습니다, 그룹 인기를 더 올려야 합니다
			PRINTFORML 다음 목표치……500p
			RESETCOLOR
		ENDIF
		S = 2000
	ELSE
		SIF ARG:2 == 0
			PRINTL 　그룹 인기에 따른 집객력……없음
	ENDIF
ENDIF
;難易度処理
;EASY
IF FLAG:조교난이도 == 1
	IF ARG:2 == 0
		PRINTL 
		PRINTL 난이도:EASY ×120％
	ENDIF
	TIMES S , 1.20
;NORMAL
ELSEIF FLAG:조교난이도 == 2
	;これ要らなくない？
	;TIMES S , 1.00
;HARD
ELSEIF FLAG:조교난이도 == 3
	IF ARG:2 == 0
		PRINTL 
		PRINTL 난이도:HARD ×80％
	ENDIF
	TIMES S , 0.80
ENDIF
IF ARG:2 == 0
	PRINTL 
	SETCOLOR 0x33ffcc
	PRINTFORML 시산 결과：{S}
	RESETCOLOR
	PRINTW 〈다음으로〉
	DRAWLINE
ENDIF
IF S <= 0
	試算判定 = -1
ELSEIF S > 0
	試算判定 = S
ENDIF
RESULT:1 = 人気記録
RESULT:2 = ALIGN記録
;一人でも利潤が見込めなかったら-1返す
RETURN 試算判定

@GROUP_HELP
$TOP_OF_GROUP_HELP
PRINTL 어느 항목에 대해 알아보겠습니까?
PRINTL [ 1] 그룹 편성에 대해
PRINTL [ 2] 그룹 확인에 대해
PRINTL [ 3] 편성 보너스에 대해
PRINTL [ 4] 집단 라이브와 콘서트의 차이점에 대해
DRAWLINE
PRINTL [100]- 돌아간다
