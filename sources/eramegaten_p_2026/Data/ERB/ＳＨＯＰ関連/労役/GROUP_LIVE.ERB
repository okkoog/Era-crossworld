GOTO TOP_OF_GROUP_RENAME

@GROUP_NAME_CHECK
;名前ブランクなグループがないかチェックするだけの関数
FOR LOCAL, 1, 4
	IF グループ名前:LOCAL == ""
		;なんかとっても回りくどいことをしている気がする！
		LOCALS = グループ
		LOCALS += TOSTR(LOCAL)
		グループ名前:LOCAL = %LOCALS%
	ENDIF
NEXT

@GROUP_CHECK
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM ループ用
#DIMS 名簿, 10
$TOP_OF_GROUP_CHECK
VARSET 名簿
CALL GROUP_NAME_CHECK
PRINTL 어느 그룹을 확인하시겠습니까？
PRINTFORML [1]  - %グループ名前:1%
PRINTFORML [2]  - %グループ名前:2%
PRINTFORML [3]  - %グループ名前:3%
DRAWLINE
PRINTL [100]- 돌아간다
$INPUT_LOOP
CALL INPUTINT, 1, 2, 3, 100
SELECTCASE RESULT
CASE 1 TO 3
CASE 100
	RETURN 0
CASEELSE
	CLEARLINE 1
	GOTO INPUT_LOOP
ENDSELECT
PRINTFORML 그룹명 　%グループ名前:RESULT%
FOR ループ用, 0, CHARANUM
	IF CFLAG:ループ用:소속그룹 == RESULT
		LOCAL = CFLAG:ループ用:그룹포지션
		名簿:LOCAL = %CALLNAME:ループ用%
	ENDIF
NEXT
FOR ループ用, 0, 10
	IF 名簿:ループ用 == ""
		PRINTFORML 포지션{ループ用}　－－－－－－－－
	ELSE
		;CALLNAMEだし8文字もあれば十分だと思うが
		PRINTFORML 포지션{ループ用}　%名簿:ループ用, 8, LEFT%
	ENDIF
NEXT
PRINTL 
PRINTFORML 그룹 인기　　　　　　：{グループ人気:RESULT, 10}
PRINTFORML 그룹 수입　　　　　　：{グループ収入:RESULT, 10}
SIF グループ特殊編成値:RESULT > 300
	グループ特殊編成値:RESULT = 300
PRINTFORML 현재의 그룹 특수편성치：{グループ特殊編成値:RESULT, 3}
SIF グループ熟練度:RESULT > 300
	グループ熟練度:RESULT = 300
PRINTFORML 현재의 그룹 숙련도　　：{グループ熟練度:RESULT, 3}
SIF グループ相性値:RESULT > 300
	グループ相性値:RESULT = 300
PRINTFORML 현재의 그룹 상성치　　：{グループ相性値:RESULT, 3}
LOCAL = グループ特殊編成値:RESULT + グループ熟練度:RESULT + グループ相性値:RESULT
SELECTCASE LOCAL
CASE 50 TO 149
	PRINTFORML 편성보너스　발동중（효과：소）
CASE 150 TO 299
	PRINTFORML 편성보너스　발동중（효과：중）
CASE IS > 299
	PRINTFORML 편성보너스　발동중（효과：대）
CASEELSE
	PRINTFORML 편성보너스　없음
ENDSELECT
DRAWLINE
GOTO TOP_OF_GROUP_CHECK

@LIVE_EXECUTABLE_CHECK, ARG
#LOCALSSIZE 1
#DIM ループ用
#DIM 人数
#DIM 体力なし
;ARG:0 = 実行可能な確認するグループ番号
SIF ARG == 0
	RETURN 0
人数 = 0
体力なし = 0
FOR ループ用, 0, CHARANUM
	IF CFLAG:ループ用:소속그룹 == ARG
		人数 += 1
		SIF BASE:ループ用:체력 <= 500
			体力なし += 1
	ENDIF
NEXT
SIF 体力なし > 0
	RETURN -1
SIF 人数 > 1
	RETURN 1
RETURN 0

@LIVE_EXECUTION
#DIM ループ用
#DIM 結果保存, 4
$TOP_OF_LIVE_EXECUTION
PRINTL 어느 그룹으로 실행하겠습니까?
FOR ループ用, 1, 4
	CALL LIVE_EXECUTABLE_CHECK, ループ用
	結果保存:ループ用 = RESULT
	;特に15文字の理由はない！
	IF 結果保存:ループ用 == 1
		PRINTFORML [{ループ用}]  - %グループ名前:ループ用, 30, LEFT%
	ELSEIF 結果保存:ループ用 == -1
		PRINTFORML [-]  - %グループ名前:ループ用, 30, LEFT%　※체력 부족인 멤버가 있어 실행할 수 없습니다
	ELSE
		PRINTFORML [-]  - %グループ名前:ループ用, 30, LEFT%　※멤버 부족으로 실행할 수 없습니다. 최소 2명 이상 편성해 주십시오
	ENDIF
NEXT
DRAWLINE
PRINTL [100]- 돌아간다
$INPUT_LOOP
CALL INPUTINT, 1, 2, 3, 100
IF RESULT == 100
	RETURN 0
ELSEIF 結果保存:RESULT
	CALL LIVE_START, RESULT
	SIF RESULT
