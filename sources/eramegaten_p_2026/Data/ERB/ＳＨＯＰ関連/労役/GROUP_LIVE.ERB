@GROUP_LIVE
#LOCALSIZE 2
$TOP_OF_GROUP_LIVE
;---- EDIT P 002 ADD START -------------------------
DRAWLINE
PRINTFORML 아무 그룹의 라이브가 끝난 뒤 이 화면을 벗어나면
PRINTFORML 조교가능횟수를 1회 소모하고、또한 다음 턴까지 콘서트와 라이브를 개최할 수 없게 되므로 주의해주세요
PRINTFORML 라이브에서 노래할 그룹을 선택해주세요　
DRAWLINE
;---- EDIT P 002 ADD END ---------------------------
CALL GROUP_NAME_CHECK
FOR LOCAL, 1, 4
	PRINTFORM {LOCAL}. %グループ名前:LOCAL, 30, LEFT%　인기：{グループ人気:LOCAL, 10}　
	SIF グループ特殊編成値:LOCAL > 300
		グループ特殊編成値:LOCAL = 300
	SIF グループ熟練度:LOCAL > 300
		グループ熟練度:LOCAL = 300
	SIF グループ相性値:LOCAL > 300
		グループ相性値:LOCAL = 300
	LOCAL:1 = グループ特殊編成値:LOCAL + グループ熟練度:LOCAL + グループ相性値:LOCAL
	SELECTCASE LOCAL:1
	CASE 50 TO 149
		PRINTL 편성보너스　발동중（효과：소）
	CASE 150 TO 299
		PRINTL 편성보너스　발동중（효과：중）
	CASE IS > 299
		PRINTL 편성보너스　발동중（효과：대）
	CASEELSE
		PRINTL 편성보너스　없음
	ENDSELECT
NEXT
;---- EDIT P 001 MOD START -------------------------
PRINTL [0]  - 라이브실행
;---- EDIT P 001 MOD END ---------------------------…
PRINTL [1]  - 그룹 편성
PRINTL [2]  - 그룹 확인
PRINTL [3]  - 그룹명 변경
PRINTL [4]  - HELP
DRAWLINE
PRINTL [100]- 돌아간다
$INPUT_LOOP
CALL INPUTINT, 0, 1, 2, 3, 4, 100
IF RESULT == 100
	;---- EDIT P 002 MOD START -------------------------
	IF コンサート実行日 == DAY
		FLAG:조교실행완료횟수++
		RETURN 1
	ELSE
		RETURN 0
	ENDIF
	;---- EDIT P 002 MOD END ---------------------------
ELSEIF RESULT == 0
	CALL LIVE_EXECUTION
ELSEIF RESULT == 1
	CALL GROUP_SELECTION
ELSEIF RESULT == 2
	CALL GROUP_CHECK
ELSEIF RESULT == 3
	CALL GROUP_RENAME
ELSEIF RESULT == 4
	CALL GROUP_HELP
ELSE
	CLEARLINE 1
	GOTO INPUT_LOOP
ENDIF
DRAWLINE
GOTO TOP_OF_GROUP_LIVE

@GROUP_SELECTION
#LOCALSSIZE 1
$TOP_OF_GROUP_SELECTION
CALL GROUP_NAME_CHECK
PRINTL 어느 그룹을 편성하시겠습니까？
PRINTFORML [1]  - %グループ名前:1%
PRINTFORML [2]  - %グループ名前:2%
PRINTFORML [3]  - %グループ名前:3%
DRAWLINE
PRINTL [100]- 돌아간다
$INPUT_LOOP
CALL INPUTINT, 1, 2, 3, 100
IF RESULT == 100
	RETURN 0
ELSEIF RESULT == 1
	CALL GROUP_MEMBER_SELECTION, 1
ELSEIF RESULT == 2
	CALL GROUP_MEMBER_SELECTION, 2
ELSEIF RESULT == 3
	CALL GROUP_MEMBER_SELECTION, 3
ELSE
	CLEARLINE 1
	GOTO INPUT_LOOP
ENDIF
DRAWLINE
GOTO TOP_OF_GROUP_SELECTION

@GROUP_MEMBER_SELECTION, ARG
;ARG:0 = 変更するグループ番号
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM CAST
#DIM N_PEOPLE
#DIM ループ用
#DIM 重複チェック
#DIM 確認番号1
#DIM 確認番号2
SIF ARG == 0
	RETURN 0
REDRAW 0
VARSET T, -2
FOR LOCAL, 0, CHARANUM
	IF CFLAG:LOCAL:소속그룹 == ARG
		FOR LOCAL:1, 0, 10
			SIF CFLAG:LOCAL:그룹포지션 == LOCAL:1
				T:(LOCAL:1) = LOCAL
		NEXT
	ENDIF
NEXT
$RET
DRAWLINE
LOCALS = %グループ名前:ARG%
PRINTFORML %LOCALS%에 편성할 멤버를 골라주십시오
IF ITEM:라이브하우스 == 1 || ITEM:무도관 == 1
ELSE
	IF ITEM:라이브하우스 == 0
		PRINTL 라이브 하우스를 구입하면 6명까지 편성할 수 있게 됩니다
	ELSEIF ITEM:무도관 == 0
		PRINTL 대극장을 구입하면 10명까지 편성할 수 있게 됩니다
	ENDIF
ENDIF
DRAWLINE
PRINTFORML [0]\@ T:0 >= 0 ? %CALLNAME:(T:0),20,LEFT%　[10]제외 # ＜없음＞ \@
PRINTFORML [1]\@ T:1 >= 0 ? %CALLNAME:(T:1),20,LEFT%　[11]제외 # ＜없음＞ \@
PRINTFORML [2]\@ T:2 >= 0 ? %CALLNAME:(T:2),20,LEFT%　[12]제외 # ＜없음＞ \@
IF ITEM:라이브하우스 == 1 || ITEM:무도관 == 1
	PRINTFORML [3]\@ T:3 >= 0 ? %CALLNAME:(T:3),20,LEFT%　[13]제외 # ＜없음＞ \@
	PRINTFORML [4]\@ T:4 >= 0 ? %CALLNAME:(T:4),20,LEFT%　[14]제외 # ＜없음＞ \@
	PRINTFORML [5]\@ T:5 >= 0 ? %CALLNAME:(T:5),20,LEFT%　[15]제외 # ＜없음＞ \@
ENDIF
IF ITEM:무도관 == 1
	PRINTFORML [6]\@ T:6 >= 0 ? %CALLNAME:(T:6),20,LEFT%　[16]제외 # ＜없음＞ \@
	PRINTFORML [7]\@ T:7 >= 0 ? %CALLNAME:(T:7),20,LEFT%　[17]제외 # ＜없음＞ \@
	PRINTFORML [8]\@ T:8 >= 0 ? %CALLNAME:(T:8),20,LEFT%　[18]제외 # ＜없음＞ \@
	PRINTFORML [9]\@ T:9 >= 0 ? %CALLNAME:(T:9),20,LEFT%　[19]제외 # ＜없음＞ \@
ENDIF
N_PEOPLE = 0
重複チェック = 0
FOR LOCAL, 0, 10
	SIF T:LOCAL < 0
		CONTINUE
	N_PEOPLE ++
	確認番号1 = T:LOCAL
	FOR LOCAL:1, 0, 10
		確認番号2 = T:(LOCAL:1)
		SIF 確認番号2 < 0 || LOCAL == LOCAL:1
			CONTINUE
		;確認番号1, 2にはそれぞれポジション0～9の生成番号が入る
		;これがLOCAL != LOCAL:1の時限定で一致する→同じ番号の人がいるということ
		SIF 確認番号1 == 確認番号2
			重複チェック = 1
	NEXT
NEXT
グループ相性値:ARG = 0
FOR LOCAL, 0, 10
	SIF T:LOCAL < 0
		CONTINUE
	確認番号1 = T:LOCAL
	FOR LOCAL:1, 0, 10
		確認番号2 = T:(LOCAL:1)
		SIF 確認番号2 < 0 || LOCAL == LOCAL:1
			CONTINUE
		;アライメントでの加算はライブでやってるのでこっちでは見ない。
		;本当はキャラ相性値を見たかったんだけど反映されてないみたい？
		グループ相性値:ARG += (GET_RELATION(確認番号1, 確認番号2, 0) - 100) / N_PEOPLE
	NEXT
NEXT
SIF グループ相性値:ARG > 300
	グループ相性値:ARG = 300
PRINTFORML 현재의 그룹 상성치：{グループ相性値:ARG, 3}

;詳細はGROUP_SPECIAL_BONUS.ERBを参照のこと
CALL GROUP_SPECIAL_BONUS, ARG

DRAWLINE
SIF 重複チェック > 0
	PRINTL ※경고　같은 멤버가 2회 이상 등록되어 있습니다
IF N_PEOPLE > 1 && 重複チェック == 0
	PRINT [2000]편성 결정
ELSE
	PRINT 　　　　　　　
ENDIF
IF N_PEOPLE > 0
	PRINT [3000]편성 전체 해제
ELSE
	PRINT 　　　　　　　　
ENDIF
PRINTL [1000]돌아간다
INPUT
IF RESULT == 1000
	VARSET T, -2
	RETURN 0
ELSEIF RESULT == 3000
	VARSET T, -2
	GOTO RET
ELSEIF RESULT >= 0 && RESULT < 10
	LOCAL = RESULT
	;LOCALS = 誰を設定しますか？
	;CALL INPUT_CHARA_LIST(LOCALS, "CASTING_GROUP_LIVE")
	{
	CALL INPUT_CHARA_LIST
		, "FUNC_PROPSET_LIST"
		, "누구를 설정하시겠습니까？"
		, "CASTING_GROUP_LIVE" 
		, "SHOW_ADD_UP_FUNCTION"
		, "SHOW_ADD_DOWN_FUNCTION"
		, "ADD_SELECT_FUNCTION"
		, "L_CANCELS"
		, "FUNC_CUSTOM_TITLE"
		, "FUNC_CUSTOM_COLOR"
		, -1
	}
	REDRAW 1
	SIF RESULT != 1000
		T:LOCAL = RESULT
	GOTO RET
ELSEIF RESULT >= 10 && RESULT < 20
	T:(RESULT - 10) = -2
	GOTO RET
ELSEIF RESULT == 2000 && N_PEOPLE > 1
	DRAWLINE
	;ここで既に別のグループに入ってないかチェック
	重複チェック = 0
	FOR ループ用, 0, 10
		CAST = T:ループ用
		;いない番号ならパス
		SIF CAST < 0
			CONTINUE
		;ARGにはグループ番号が入ってるので、0でもなくARGでもない＝別のグループにいる扱いのはず
		SIF CFLAG:CAST:소속그룹 != ARG && CFLAG:CAST:소속그룹 != 0
			重複チェック += 1
	NEXT
	PRINTL 이 멤버로 결정하겠습니까?
	SIF 重複チェック > 0
		PRINTL ※다른 그룹에 소속된 멤버가 포함되어 있습니다. 결정하면 소속이 덮어쓰기됩니다.
	SIF グループ熟練度:ARG > 0
		PRINTL ※그룹 숙련도가 리셋됩니다.
	DRAWLINE
	CALL INPUT_YN
	SIF RESULT == 1
		GOTO RET
ELSE
	CLEARLINE 1
	GOTO RET
ENDIF

;メンバーが変わるかもなので選択したグループを一回解散する
FOR LOCAL, 0, CHARANUM
	SIF CFLAG:LOCAL:소속그룹 == ARG
		;ポジションまで初期化してないけど出ないから関係ないでしょ
		CFLAG:LOCAL:소속그룹 = 0
NEXT
FOR ループ用, 0, 10
	CAST = T:ループ用
	;いない番号ならパス
	SIF CAST < 0
		CONTINUE
	;ARGにはグループ番号が入ってるはず
	CFLAG:CAST:소속그룹 = ARG
	;いつの日かポジション効果を作る誰かのために
	CFLAG:CAST:그룹포지션 = ループ用
NEXT
;熟練度をリセット（熟練度じゃなくて人気の方がいいか？）
グループ熟練度:ARG = 0
VARSET T

@CASTING_GROUP_LIVE(ARG)
#DIM 実行可能カウント
;合同ライブの条件はコンサートと一緒でいいでしょ
;体力を見るのだけは消した
実行可能カウント = 0

SIF TALENT:ARG:반역
	RETURN 0
SIF CFLAG:ARG:이자리에없는플래그 == 1
	RETURN 0
SIF CFLAG:ARG:전투이외불능
	RETURN 0
	
;あなた以外は隷属以外の陥落が必要
IF ARG != MASTER 
	SIF !(TALENT:ARG:연모 || TALENT:ARG:친애 || TALENT:ARG:음란 || TALENT:ARG:창부 || TALENT:ARG:신뢰 || TALENT:ARG:동료)
		RETURN 0
	
	;以下実行判定
	IF ABL:ARG:가창기능 > 4
		実行可能カウント += 3
	ELSEIF ABL:ARG:가창기능 > 2
		実行可能カウント += 2
	ELSEIF ABL:ARG:가창기능 > 0
		実行可能カウント += 1
	ENDIF
	
	IF EXP:ARG:가창경험 > 199
		実行可能カウント += 3
	ELSEIF EXP:ARG:가창경험 > 99
		実行可能カウント += 2
	ELSEIF EXP:ARG:가창경험 > 49
		実行可能カウント += 1
	ENDIF
	
	IF EXP:ARG:라이브경험 > 99
		実行可能カウント += 3
	ELSEIF EXP:ARG:라이브경험 > 49
		実行可能カウント += 2
	ELSEIF EXP:ARG:라이브경험 > 19
		実行可能カウント += 1
	ENDIF
	
	SIF TALENT:ARG:습득빠름
		実行可能カウント += 1
	SIF TALENT:ARG:눈에띄고싶어함
		実行可能カウント += 1
	SIF TALENT:ARG:프라이드높음
		実行可能カウント += 1
	SIF TALENT:ARG:매력
		実行可能カウント += 2
	SIF TALENT:ARG:인기
		実行可能カウント += 2
	
	;信頼陥落は優遇（調教できないので）
	SIF TALENT:ARG:신뢰
		実行可能カウント += 1
	SIF TALENT:ARG:동료
		実行可能カウント += 2
	SIF TALENT:ARG:맹우
		実行可能カウント += 1
	
	;技巧はおおざっぱに
	SIF ABL:ARG:기교 > 2
		実行可能カウント += 1
	;露出癖もおおざっぱに
	SIF ABL:ARG:노출증 > 2
		実行可能カウント += 1
	
	;実行可能カウントが5以上で可能
	SIF 実行可能カウント < 5
		RETURN 0
ENDIF
RETURN 1

@GROUP_RENAME
#LOCALSSIZE 1
#DIM グループ番号
$TOP_OF_GROUP_RENAME
CALL GROUP_NAME_CHECK
PRINTL 어느 그룹명을 변경하시겠습니까？
PRINTFORML [1]  - %グループ名前:1%
PRINTFORML [2]  - %グループ名前:2%
PRINTFORML [3]  - %グループ名前:3%
DRAWLINE
PRINTL [100]- 돌아간다
$INPUT_LOOP
CALL INPUTINT, 1, 2, 3, 100
SELECTCASE RESULT
CASE 1 TO 3
CASE 100
	RETURN 0
CASEELSE
	CLEARLINE 1
	GOTO INPUT_LOOP
ENDSELECT
グループ番号 = RESULT
$INPUT_NAME
PRINTFORML 그룹 {グループ番号}의 이름을 입력해 주십시오
INPUTS
グループ名前:グループ番号 = %RESULTS%
PRINTFORML 그룹 {グループ番号}：%RESULTS%
