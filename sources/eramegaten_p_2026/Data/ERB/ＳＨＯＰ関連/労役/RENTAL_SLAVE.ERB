					CDFLAG:ARG:캐릭터간호감도:(91) -= LOCAL
				ENDIF

			ELSEIF CFLAG:ARG:예ＮＴＲ진행도 > 0 
				CFLAG:ARG:음란도+= 30 + CFLAG:ARG:현ＮＴＲ진행도*10
				LOCAL = ((E+F+G)*100+B*60)/MAX(1,ABL:ARG:순종/2) * (2-CFLAG:ARG:신경썼다플래그) + CFLAG:ARG:방치일수*10
				PRINTFORML %CALLNAME:ARG%에게 본 적 없는 몸짓이 늘어난 듯하다……
				IF RAND:2 == 0
					CDFLAG:ARG:캐릭터간호감도:(92) += LOCAL
				ELSE
					CDFLAG:ARG:캐릭터간호감도:(91) -= LOCAL
				ENDIF

			ENDIF
			;子宮現在容量加算
			IF TALENT:ARG:오토코노코
				CFLAG:(ARG):자궁현재용량 += LOCAL * 15
			ELSEIF !IS_MALE(ARG)
				CFLAG:(ARG):자궁현재용량 += LOCAL * 15
			ENDIF
		ELSE
			PRINTFORML %CALLNAME:ARG%에게 딱히 변한 기색은 없는 듯하다
		ENDIF

	ENDIF


	PRINTFORML
ENDIF
$SKIP_NTR

;最後に金額の加算,特殊レンタルの場合は0なので飛ばす
IF V > 0
	PRINTFORMW %CALLNAME:ARG%의 렌탈액으로 {V} 마카를 얻었습니다
	MONEY:1 += V
	CALL 帳簿閲覧_労役, ARG, V, 0, 4

ENDIF

;フラグのリセット
CFLAG:ARG:노역플래그 = 0
CFLAG:ARG:13 = 0
CFLAG:ARG:14 = 0
CFLAG:ARG:15 = 0

CALL 気絶処理,ARG

CFLAG:ARG:노역플래그 = 0

RETURN 1

;対象が実際に貸しだされているかどうか
@IS_RENTING, ARG
#FUNCTION
SIF CFLAG:ARG:노역플래그 != 3
	RETURNF 0
;レンタル期間が0
SIF !CFLAG:ARG:13
	RETURNF 0
;レンタル予定フラグたっている状態
SIF CFLAG:ARG:17
	RETURNF 0
RETURNF 1