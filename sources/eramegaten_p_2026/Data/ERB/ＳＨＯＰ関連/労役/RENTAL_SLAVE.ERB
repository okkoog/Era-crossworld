;;;初期は1日と3日のみ。総レンタル日数が5日以上で5日、10日以上で10日が開放
;;;隷属は全開放
;;;@param 対象 キャラ番号 非負でCHARANUM未満の整数以外を渡すとエラー落ちする
;;;@param レンタル日数 1,3,5,10以外は0を返す
;;;@return 対象キャラがレンタル日数だけレンタル可能なとき1 そうでないとき0を返す
;011 @RENTAL_SLAVEから処理を関数化
@CAN_RENTAL_SLAVE_DAY(対象, レンタル日数)
#FUNCTION
#DIM 対象
#DIM レンタル日数
SELECTCASE レンタル日数
	CASE 1
		SIF BASE:対象:체력 > 500
			RETURNF 1
	CASE 3
		SIF BASE:対象:체력 > 800
			RETURNF 1
	CASE 5
		SIF BASE:対象:체력 > 1000 && (CFLAG:対象:렌탈된총일수 >= 5 || TALENT:対象:예속)
			RETURNF 1
	CASE 10
		SIF BASE:対象:체력 > 1500 && (CFLAG:対象:렌탈된총일수 >= 10 || TALENT:対象:예속)
			RETURNF 1
	CASEELSE
ENDSELECT
RETURNF 0

;最長日数算出関数, 書いたはいいが不要だったが一時保存
[SKIPSTART]
SELECTCASE BASE:対象:체력
	CASE IS < 500
		最長レンタル日数 = 0
	CASE 500 TO 799
		最長レンタル日数 = 1
	CASE 800 TO 999
		最長レンタル日数 = 3
	CASE 1000 TO 1499
		最長レンタル日数 = 5
	CASE IS >= 1500
		最長レンタル日数 = 10
	CASEELSE
		最長レンタル日数 = 0
ENDSELECT

SIF CFLAG:対象:렌탈된총일수 >= 10 || TALENT:対象:예속
	RETURNF 最長レンタル日数
SIF CFLAG:対象:렌탈된총일수 >= 5
	RETURNF MIN(最長レンタル日数, 5)
RETURNF MIN(最長レンタル日数, 3)
[SKIPEND]

;;;レンタル金額の計算と表示
;;;ABLによる기초치に対してTALENTや難易度などで補正倍率を掛ける
;;;@param 対象 キャラ番号 非負でCHARANUM未満の整数以外を渡すとエラー落ちする
;;;@param レンタル日数 非負整数 1,3,5,10のいずれかを想定
;;;@return 最終的なレンタル価格(魔貨)
;011 @RENTAL_SLAVEから処理を関数化
@PRINT_RENTAL_SLAVE_PRICE(対象, レンタル日数)
#DIM 対象
#DIM レンタル日数
#DIM 項別価格
#DIM 価格
#DIM 項別倍率
#DIM 合計倍率
#DIM 能力
#DIM 素質
価格 = 0

PRINTL 렌탈 가격 사정
PRINTL =============================

;ABLによる기초치計算
;18番のセックス中毒までみる
;対象となるABLは最大で半角12文字
FOR 能力, 0, 19
	項別価格 = RENTAL_SLAVE_PRICE_ABL(対象, ABLNAME:能力)
	IF 項別価格 > 0
		PRINTFORML     %ABLNAME:能力, 12%{ABL:対象:能力, 2}LV ＋{項別価格}마카
	ELSEIF 項別価格 < 0
		PRINTFORML     %ABLNAME:能力, 12%{ABL:対象:能力, 2}LV －{項別価格}마카
	ENDIF
	価格 += 項別価格
NEXT
PRINTL -----------------------------
PRINTFORML           기초치 {価格, 7}마카
PRINTL =============================

;TALENTによる기초치計算
;149版の母乳体質までみる
;対象となるTALENTは最大で半角12文字
合計倍率 = 100
FOR 素質, 0, 150
	項別倍率 = RENTAL_SLAVE_PRICE_TALENT(対象, TALENTNAME:素質)
	IF 項別倍率 > 0
		PRINTFORML     %TALENTNAME:素質, 12%   ＋{項別倍率, 3}％
	ELSEIF 項別倍率 < 0
		PRINTFORML     %TALENTNAME:素質, 12%   －{-項別倍率, 3}％
	ENDIF
	合計倍率 += 項別倍率
NEXT
PRINTL -----------------------------
PRINTFORML     기초 보정倍率 {合計倍率, 7}％
PRINTL =============================

;붕괴,광기,妊娠は補正率全体に負の補正をかける（従順によって、80％まで回復）
IF TALENT:対象:붕괴 || TALENT:対象:광기 || TALENT:対象:임신; || 1;EDIT MOD 012
	SETCOLOR COLOR("赤")
	項別倍率 = ABL:対象:순종 * 10
	IF TALENT:対象:붕괴
		PRINT     붕괴
	ELSEIF TALENT:対象:광기
		PRINT     광기
	ELSEIF TALENT:対象:임신; || 1
		PRINT     임신
	ENDIF
	PRINTFORML 패널티  x{項別倍率, 2}%
	合計倍率 = 合計倍率 * 項別倍率/100
	RESETCOLOR
ENDIF

;長期間のレンタルほど1日あたりの価格が上昇
;日数と掛けるとそれぞれ0.6, 3, 5.4, 11倍の補正がかかる
SELECTCASE レンタル日数
	CASE 1
		項別倍率 = 60
	CASE 3
		項別倍率 = 100
	CASE 5
		項別倍率 = 108
	CASE 10
		項別倍率 = 110
	CASEELSE
		項別倍率 = 100
ENDSELECT
PRINTFORML         일수 보정   ×{項別倍率, 3}％
PRINTFORML     렌탈 일수    x{レンタル日数, 2}일
合計倍率 = 合計倍率 * 項別倍率/100 * レンタル日数

;コンドームの場合は、レンタル額にペナルティ補正がかかる
;SIF D/B == 500
;	TIMES S , 0.80

;조교난이도 = 1でEASY、2でNORMAL、3でHARD
IF FLAG:조교난이도 == 1
	項別倍率 = 120
ELSEIF FLAG:조교난이도 == 3
	項別倍率 = 80
ENDIF
PRINTFORML       난이도 보정   ×{項別倍率, 3}％
合計倍率 = 合計倍率 * 項別倍率/100

;011 コメントなく2倍になっていたけどどういう名目なんだろうか
項別倍率 = 200
PRINTFORML     밸런스 정수   x{項別倍率, 3}%
合計倍率 = 合計倍率 * 項別倍率/100

IF CFLAG:対象:인계횟수 > 0 && FLAG:게임모드 < 9 && 合計倍率 > 0 && DAY < 51; || 1;EDIT MOD 012
	SELECTCASE FLAG:주회횟수
		CASE 1, 2
			項別倍率 = 5
		CASE 3 TO 5
			項別倍率 = 10
		CASE 6 TO 8
			項別倍率 = 20
		CASE 9 TO 11
			項別倍率 = 35
		CASEELSE
			項別倍率 = 50
	ENDSELECT
	PRINTFORML 인계 캐릭터 보정   x{項別倍率, 3}%
	合計倍率 = 合計倍率 * 項別倍率/100
ENDIF

PRINTL -----------------------------
PRINTFORML         최종 보정  ×{合計倍率, 4}％
PRINTL =============================
価格 = 価格 * 合計倍率/100
FONTBOLD
PRINTFORML   렌탈 가격 {価格, 4} 마카
FONTREGULAR
PRINTL =============================

RETURN 価格


;;;ABLによるレンタル価格の기초치計算
;;;@param 対象 キャラ番号 非負でCHARANUM未満の整数
;;;@param s能力: 計算したい対象の該当ABLNAME 文字列型であるので注意 空文字列含め存在しない能力名には0を返す
;;;@return 対象のs能力による価格
;011 @RENTAL_SLAVEから処理を関数化
@RENTAL_SLAVE_PRICE_ABL(対象, s能力)
#FUNCTION
#DIM 対象
#DIMS s能力
SELECTCASE s能力
	CASE "순종"
		SELECTCASE ABL:対象:s能力
			CASE 0
				RETURNF 1
			CASE 1, 2
				RETURNF 2
			CASE 3, 4
				RETURNF 3
			CASE 5 TO 9
				RETURNF ABL:対象:s能力 - 1
			CASEELSE
				RETURNF 10
		ENDSELECT
	CASE "욕망"
		SELECTCASE ABL:対象:s能力
			CASE 0
				RETURNF 0
			CASE 1, 2
				RETURNF 1
			CASE 3, 4
				RETURNF 2
			CASE 5 TO 9
				RETURNF ABL:対象:s能力 - 2
			CASEELSE
				RETURNF 8
		ENDSELECT
	CASE "기교"
		SELECTCASE ABL:対象:s能力
			CASE 0
				RETURNF 0
			CASE 1, 2, 3
				RETURNF 1
			CASE 4, 5
				RETURNF 2
			CASE 6, 7
				RETURNF 3
			CASEELSE
				RETURNF ABL:対象:s能力 - 4
		ENDSELECT
	CASE "Ｃ감각", "Ｖ감각", "Ａ감각", "Ｂ감각"
		SELECTCASE ABL:対象:s能力
			CASE 0
				RETURNF 0
			CASE 1, 2, 3
				RETURNF 1
			CASE 4, 5
				RETURNF 2
			CASE 6, 7
				RETURNF 3
			CASE 8, 9
				RETURNF 4
			CASEELSE
				RETURNF 5
		ENDSELECT
	CASE "봉사정신"
		SELECTCASE ABL:対象:s能力
			CASE 0, 1, 2
				RETURNF ABL:対象:s能力
			CASE 3, 4
				RETURNF ABL:対象:s能力 - 1
			CASEELSE
				RETURNF ABL:対象:s能力 - 2
		ENDSELECT
	CASE "노출증"
		SELECTCASE ABL:対象:s能力
			CASE 0
				RETURNF 0
			CASE 1, 2, 3
				RETURNF 1
			CASE 4, 5
				RETURNF 2
			CASE 6, 7
				RETURNF 3
			CASE 8, 9
				RETURNF 4
			CASEELSE
				RETURNF 5
		ENDSELECT
	CASE "마조끼"
		SELECTCASE ABL:対象:s能力
			CASE 0 TO 4
				RETURNF ABL:対象:s能力
			CASE 5
				RETURNF 4
			CASE 6 TO 9
				RETURNF 5
			CASEELSE
				RETURNF 6
		ENDSELECT
	CASE "새드끼"
		SELECTCASE ABL:対象:s能力
			CASE 0
				RETURNF 0
			CASE 1, 2, 3
				RETURNF 1
			CASE 4, 5
				RETURNF 2
			CASE 6, 7
				RETURNF 3
			CASE 8, 9
				RETURNF 4
			CASEELSE
				RETURNF 5
		ENDSELECT
	CASE "정액중독"
		SELECTCASE ABL:対象:s能力
			CASE 0
				RETURNF 0
			CASE 1, 2
				RETURNF 1
			CASE 3, 4
				RETURNF 2
			CASE 5
				RETURNF 3
			CASEELSE
				RETURNF ABL:対象:s能力 - 3
		ENDSELECT
	CASE "섹스중독"
		SELECTCASE ABL:対象:s能力
			CASE 0, 1, 2
				RETURNF ABL:対象:s能力
			CASE 3, 4
				RETURNF ABL:対象:s能力 - 1
			CASE 5 TO 8
				RETURNF ABL:対象:s能力 - 2
			CASEELSE
				RETURNF ABL:対象:s能力 - 3
		ENDSELECT
ENDSELECT
RETURNF 0

;;;TALENTによるレンタル価格の기초 보정値計算
;;;@param 対象 キャラ番号 非負でCHARANUM未満の整数
;;;@param s素質: 計算したい対象の該当TALENTNAME 文字列型であるので注意 空文字列には0を返す 存在しない素質名の場合エラー落ちする
;;;@return 対象のs素質による補正倍率
;011 @RENTAL_SLAVEから処理を関数化
@RENTAL_SLAVE_PRICE_TALENT(対象, s素質)
#FUNCTION
