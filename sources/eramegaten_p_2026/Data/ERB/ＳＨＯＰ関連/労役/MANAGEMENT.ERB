VARSET Q, -1
A = 0
FOR LCOUNT, 0, CHARANUM
	SIF CFLAG:LCOUNT:노역플래그 != 10+ARG
		CONTINUE
	Q:A = LCOUNT
	A += 1
NEXT
LOCAL:2 = A

$PRINT_LIST
DRAWLINE
PRINTFORML 이용 방법을 변경할 변기를 골라 주십시오　＜page.{P + 1}＞
DRAWLINE
PRINTFORML 　　　　　　　　　　　　　　　　 펠라　본방　애널 질내사정 동성손님 수간
FOR LCOUNT, 0, リスト表示数()
	LOCAL = Q:(LCOUNT + P * リスト表示数())
	SIF LOCAL < 0 || CFLAG:LOCAL:이자리에없는플래그 == 1
		CONTINUE
	CALL ARRANGE_SETCOLOR, LOCAL

	CALL ARRANGE_TARGETSIGN, LOCAL

	CALL ARRANGE_CHARALIST, LOCAL
	CALL ARRANGE_FALLTALENT, LOCAL
	CALL ARRANGE_SEX, LOCAL
	
	CALL 是非色分け(LOCAL, 8)
	PRINTFORM 　-　\@ CFLAG:LOCAL:개별성적서비스 & 8 ? Ｏ # Ｘ \@
	
	CALL 是非色分け(LOCAL, 16)
	PRINTFORM 　-　\@ CFLAG:LOCAL:개별성적서비스 & 16 ? Ｏ # Ｘ \@
	
	CALL 是非色分け(LOCAL, 32)
	PRINTFORM 　-　\@ CFLAG:LOCAL:개별성적서비스 & 32 ? Ｏ # Ｘ \@
	
	CALL 是非色分け(LOCAL, 64)
	PRINTFORM 　-　\@ CFLAG:LOCAL:개별성적서비스 & 64 ? Ｏ # Ｘ \@
		
	CALL 是非色分け(LOCAL, 128)
	PRINTFORM 　-　\@ CFLAG:LOCAL:개별성적서비스 & 128 ? Ｏ # Ｘ \@

	CALL 是非色分け(LOCAL, 256)
	PRINTFORM 　-　\@ CFLAG:LOCAL:개별성적서비스 & 256 ? Ｏ # Ｘ \@

	RESETCOLOR
	IF TALENT:LOCAL:처녀 == 1
		SETCOLOR COLOR("pink")
		PRINTFORM 　　%ハート()%
		PRINTFORM 처녀
		PRINTFORML %ハート()%
	ENDIF
		PRINTL 
NEXT
RESETCOLOR
DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 16% # [1007]이전페이지\@
PRINTLC [1000]돌아간다
PRINTFORMLC \@(P >= (LOCAL:2 - 1) / リスト表示数()) ? %" " * 16% # [1009]다음페이지\@

$INPUT_LOOP_1
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1007
	IF P > 0
		P -= 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT == 1009
	LOCAL = (LOCAL:2 - 1) / リスト表示数()
	IF P < LOCAL
		P += 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT < 0 || RESULT >= CHARANUM || MATCH(Q,RESULT) == 0
	GOTO INPUT_LOOP_1
ENDIF

LOCAL:1 = RESULT


$CHANGE_COMMODITY
		;リストの何人目かをLOCALに保存
		LOCAL:4 = FINDELEMENT(Q, LOCAL:1)
		PRINTFORML 현재 %CALLNAME:(LOCAL:1)%의 기본 가격은 다음과 같습니다. 변경할 이용 방법을 골라 주십시오

		CALL 是非色分け(LOCAL:1, 8)
		PRINTFORML [1] 펠라치오: \@ CFLAG:(LOCAL:1):개별성적서비스 & 8 ? 있음 # 없음 \@
		LOCALS:1 = 펠라치오
		CALL 是非色分け(LOCAL:1, 16)
		IF TALENT:(LOCAL:1):처녀
			PRINTFORM [2] 본방: \@ CFLAG:(LOCAL:1):개별성적서비스 & 16 ? 있음 # 없음 \@
			SETCOLOR COLOR("pink")
