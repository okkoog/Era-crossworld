;========================================================
;店舗経営
;========================================================
@MANAGEMENT
CUSTOMDRAWLINE =
FOR LOCAL,0,10
	PRINTFORM [{LOCAL}] - 
	IF 店舗("종류",LOCAL) > 0
		PRINTFORML  %SAVESTR:(20+LOCAL)%
	ELSE
		SETCOLOR 0x909090
		PRINTFORML 점포 개설
		RESETCOLOR
	ENDIF
NEXT
DRAWLINE
PRINTL [10] 돌아간다
$INPUT_LOOP
INPUT
IF RESULT == 10
	RETURN 0
ELSEIF RESULT < 0 || RESULT > 9
	GOTO INPUT_LOOP
ENDIF
LOCAL = RESULT
IF 店舗("종류",LOCAL) > 0
	CALL MANAGEMENT_MAIN,LOCAL
ELSE
	CALL MANAGEMENT_MAKE,LOCAL
ENDIF

RESTART

;========================================================
;店舗設営
;========================================================
@MANAGEMENT_MAKE,ARG
CUSTOMDRAWLINE ･
PRINTFORML 어느 점포를 건설하겠습니까?　(소지금: ￥{MONEY})
DRAWLINE
PRINTL [10] - 공중변소 (￥50000)
PRINTL [11] - 스트립 극장 (￥25000)
PRINTL [12] - 서커스 천막 (￥25000)
;教会追加
PRINTL [13] - 메시아 교단 (￥50000)
PRINTL [14] - 가이아 교단 (￥50000)
PRINTL [15] - 교회 (￥75000)
;
DRAWLINE
PRINTL [0]  - 그만둔다
$INPUT_LOOP
INPUT
LOCAL = RESULT
SELECTCASE LOCAL
	CASE 0
		RETURN 0
	CASE 10
		LOCAL:1 = 50000
	CASE 11
		LOCAL:1 = 25000
	CASE 12
		LOCAL:1 = 25000
;教会追加
	CASE 13
		LOCAL:1 = 50000
	CASE 14
		LOCAL:1 = 50000
	CASE 15
		LOCAL:1 = 75000
;
	CASEELSE
		GOTO INPUT_LOOP
ENDSELECT
SIF MONEY < LOCAL:1
	GOTO INPUT_LOOP
PRINTFORML 건설에는 ￥{LOCAL:1}이(가) 필요합니다. 정말로 건설하겠습니까?
CALL INPUT_YN,"YES","NO"
IF RESULT == 1
	RESTART
ENDIF

CALL 店舗演算("종류",ARG,LOCAL,"=")
;建設作業
SELECTCASE LOCAL
	CASE 10
		CALL 店舗演算("규모",ARG,10,"=")
		CALL 店舗演算("접객고용",ARG,2,"=")
		CALL 店舗演算("펠라가격",ARG,1,"=")
		CALL 店舗演算("본방가격",ARG,2,"=")
		CALL 店舗演算("애널가격",ARG,2,"=")
		CALL 店舗演算("질내사정가격",ARG,4,"=")
		CALL 店舗演算("처녀가격",ARG,10,"=")
		CALL 店舗演算("성적서비스",ARG,120,"=")
		LOCALS = 공중변소
	CASE 11
		CALL 店舗演算("규모",ARG,1,"=")
		LOCALS = ストリップ劇場
	CASE 12
		CALL 店舗演算("규모",ARG,1,"=")
		CALL 店舗演算("접객고용",ARG,1,"=")
		LOCALS = 見世物小屋
	CASE 13
		CALL 店舗演算("규모",ARG,1,"=")
		CALL 店舗演算("접객고용",ARG,2,"=")
		LOCALS = メシア教会
	CASE 14
		CALL 店舗演算("규모",ARG,1,"=")
		CALL 店舗演算("접객고용",ARG,2,"=")
		LOCALS = ガイア教会
	CASE 15
		CALL 店舗演算("규모",ARG,1,"=")
		CALL 店舗演算("접객고용",ARG,2,"=")
		LOCALS = 教会
ENDSELECT
MONEY -= LOCAL:1

PRINTL
$CHANGE_NAME
PRINTFORML 점포 이름은 「%LOCALS%」(으)로 하겠습니까?
CALL INPUT_YN,"이대로","변경한다"
IF RESULT == 1
	PRINTL 점포의 명칭을 입력해 주십시오
	INPUTS
	LOCALS = %RESULTS%
	GOTO CHANGE_NAME
ENDIF
SAVESTR:(20+ARG) = %LOCALS%
PRINTFORML 축하드립니다. %SAVESTR:(20+ARG)%이(가) 개점했습니다.
RETURN 0

;========================================================
;店舗経営メイン画面
;========================================================
@MANAGEMENT_MAIN,ARG
CUSTOMDRAWLINE =
;EDIT004 ADD START -------------------------------
VAR_店舗番号 = ARG
;EDIT004 ADD END   -------------------------------
;ステータス表示
CALL SHOW_STATUS_MANAGEMENT,ARG

PRINTFORML 소지금：￥{MONEY}

CALL PRINT_COMMAND_MANAGEMENT,ARG

$INPUT_LOOP
INPUT
IF RESULT == 100
	RETURN 0
ELSEIF RESULT < 0 || RESULT > 100
	GOTO INPUT_LOOP
ELSEIF C:RESULT == -1
	GOTO INPUT_LOOP
ENDIF
IF 店舗("종류",ARG) <= 10
	SELECTCASE RESULT
		CASE 0
			;配置
			CALL ARRANGE_MANAGEMENT,ARG
		CASE 1
			;人数拡張
			CALL EXTEND_MEMBER_MANAGEMENT,ARG
		CASE 2
			;規模拡張
			CALL EXTEND_MANAGEMENT,ARG
		CASE 3
			;価格設定
			CALL ARRANGE_PRICE_MANAGEMENT,ARG
		CASE 4
			;商品設定
			CALL ARRANGE_COMMODITY_MANAGEMENT,ARG
		CASE 5
			;広告
			CALL ADVERTISEMENT_MANAGEMENT,ARG
		CASE 6
			;報告方法の選択
			SELECTCASE FLAG:공중변소보고설정
				CASE 0
					FLAG:공중변소보고설정 = 1
				CASE 1
					FLAG:공중변소보고설정 = 2
				CASE 2
					FLAG:공중변소보고설정 = 0
			ENDSELECT
		CASE 10
			;料金個別設定（便所、娼館）
			CALL ARRANGE_CHARA_PRICE_MANAGEMENT,ARG
		CASE 11
			;利用方法個別設定（便所、娼館）
			CALL ARRANGE_CHARA_COMMODITY_MANAGEMENT,ARG
		CASE 99
			CALL 店舗売却,ARG
			IF RESULT == 1
				CLEARBIT FLAG:공중변소보고설정, ARG
				RETURN 0
			ENDIF
	ENDSELECT
ELSEIF 店舗("종류",ARG) == 11
	SELECTCASE RESULT
		CASE 0
			;出演者変更
			CALL ARRANGE_MANAGEMENT_STRIP_THEATER,ARG
		CASE 1
			;規模拡張
			CALL EXTEND_MANAGEMENT_STRIP_THEATER,ARG
		CASE 2
			;広告
			CALL ADVERTISEMENT_MANAGEMENT,ARG
		CASE 3
			INVERTBIT FLAG:스트립극장보고설정, ARG
		CASE 99
			CALL 店舗売却,ARG
			IF RESULT == 1
				CLEARBIT FLAG:스트립극장보고설정, ARG
				RETURN 0
			ENDIF
	ENDSELECT
ELSEIF 店舗("종류",ARG) == 12
	SELECTCASE RESULT
		CASE 0
			;出演者変更
			CALL ARRANGE_MANAGEMENT, VAR_店舗番号
		CASE 1
			;レンタル悪魔
			CALL SHOW_TENT_RENTALDEVIL
		CASE 2
			;規模拡張
			CALL EXTEND_MANAGEMENT_SHOW_TENT
		CASE 3
			;広告
			CALL ADVERTISEMENT_MANAGEMENT, VAR_店舗番号
		CASE 4
			INVERTBIT VAR_店舗リザルト, VAR_店舗番号
		;#;CASE 5
		;#;	INVERTBIT VAR_店舗リザルト, VAR_店舗番号+10
		CASE 99
			CALL 店舗売却,ARG
			IF RESULT == 1
				CLEARBIT VAR_店舗リザルト, VAR_店舗番号
				FOR LOCAL,0,5
					レンタル悪魔:ARG:LOCAL = 0
				NEXT
				RETURN 0
			ENDIF
	ENDSELECT
;教会、まとめようと思ったけど個別に何かするときの為に分けておく
ELSEIF 店舗("종류",ARG) == 13
	SELECTCASE RESULT
		CASE 0
			;配置
			CALL ARRANGE_MANAGEMENT,ARG
		CASE 1
			;人数拡張
			CALL EXTEND_MEMBER_MANAGEMENT,ARG
		CASE 2
			CALL EXTEND_MANAGEMENT_教会, ARG
		CASE 3
			CALL 教会_敬拝値_交換, ARG
		CASE 11
			;利用方法個別設定
			CALL ARRANGE_CHARA_COMMODITY_MANAGEMENT_教会,ARG
		CASE 99
			CALL 店舗売却,ARG
			IF RESULT == 1
				RETURN 0
			ENDIF
	ENDSELECT
ELSEIF 店舗("종류",ARG) == 14
	SELECTCASE RESULT
		CASE 0
			;配置
			CALL ARRANGE_MANAGEMENT,ARG
		CASE 1
			;人数拡張
			CALL EXTEND_MEMBER_MANAGEMENT,ARG
		CASE 2
			CALL EXTEND_MANAGEMENT_教会, ARG
		CASE 3
			CALL 教会_敬拝値_交換, ARG
		CASE 11
			;利用方法個別設定
			CALL ARRANGE_CHARA_COMMODITY_MANAGEMENT_教会,ARG
		CASE 99
			CALL 店舗売却,ARG
			IF RESULT == 1
				RETURN 0
			ENDIF
	ENDSELECT
ELSEIF 店舗("종류",ARG) == 15
	SELECTCASE RESULT
		CASE 0
			;配置
			CALL ARRANGE_MANAGEMENT,ARG
		CASE 1
			;人数拡張
			CALL EXTEND_MEMBER_MANAGEMENT,ARG
		CASE 2
			CALL EXTEND_MANAGEMENT_教会, ARG
		CASE 3
			CALL 教会_敬拝値_交換, ARG
		CASE 11
			;利用方法個別設定
			CALL ARRANGE_CHARA_COMMODITY_MANAGEMENT_教会,ARG
		CASE 99
			CALL 店舗売却,ARG
			IF RESULT == 1
				RETURN 0
			ENDIF
	ENDSELECT
ENDIF

RESTART

;========================================================
;配置
;========================================================
@ARRANGE_MANAGEMENT,ARG,ARG:1
#DIM LCOUNT
P = 0
CUSTOMDRAWLINE = 
$INPUT_LOOP_2
;表示させるキャラを抽出（Q:*に表示するキャラの登録番号、LOCAL:2に人数）
VARSET Q, -1
A = 0
FOR LCOUNT, 0, CHARANUM
	SIF WORKABLE(ARG,LCOUNT) == 0
		CONTINUE
	;SIF CFLAG:LCOUNT:노역플래그 != 0 && CFLAG:LCOUNT:노역플래그 != 10+ARG
	SIF CFLAG:LCOUNT:노역플래그 != 0 && CFLAG:LCOUNT:노역플래그 != 10+ARG
		CONTINUE
	SIF CFLAG:LCOUNT:이자리에없는플래그 == 1
		CONTINUE
	SIF CFLAG:LCOUNT:필터링플래그
		CONTINUE
	SIF CFLAG:LCOUNT:전투이외불능
		CONTINUE

	Q:A = LCOUNT
	A += 1
NEXT
LOCAL:2 = A

$PRINT_LIST
DRAWLINE
SELECTCASE 店舗("종류",ARG)
	CASE 13, 14, 15
		PRINTFORM 이 교회에서 봉사시키고 싶다
	CASEELSE
		PRINTFORM 이 점포에서 노역시키고 싶다
ENDSELECT
PRINTFORML /제외할 캐릭터를 골라 주십시오　현재 {접객인수(ARG)}/{店舗("접객고용",ARG)}명 ＜page.{P + 1}＞
DRAWLINE
CALL MANAGEMENT_CHARALIST,ARG,0
DRAWLINE
PRINTFORMLC \@(P <= 0) ? %" " * 16% # [1007]이전페이지\@
PRINTLC [1000]돌아간다
PRINTFORMLC \@(P >= (LOCAL:2 - 1) / リスト表示数()) ? %" " * 16% # [1009]다음페이지\@

$INPUT_LOOP_1
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1007
	IF P > 0
		P -= 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT == 1009
	LOCAL = (LOCAL:2 - 1) / リスト表示数()
	IF P < LOCAL
		P += 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT < 0 || RESULT >= CHARANUM || MATCH(Q,RESULT) == 0
	GOTO INPUT_LOOP_1
ENDIF

;労役切り替え
IF CFLAG:RESULT:노역플래그 == 10+ARG
	CFLAG:RESULT:노역플래그 = 0
ELSEIF 접객인수(ARG) < 店舗("접객고용",ARG)
	SELECTCASE 店舗("종류",ARG)
	CASE 10
		CFLAG:RESULT:노역플래그 = 10+ARG
		CFLAG:RESULT:펠라가격= 店舗("펠라가격",ARG)
		CFLAG:RESULT:본방가격= 店舗("본방가격",ARG)
		CFLAG:RESULT:질내사정가격= 店舗("질내사정가격",ARG)
		CFLAG:RESULT:애널가격= 店舗("애널가격",ARG)
		CFLAG:RESULT:처녀가격= 店舗("처녀가격",ARG)
		CFLAG:RESULT:종사내용 = 1
		CFLAG:RESULT:개별성적서비스 = 店舗("성적서비스",ARG)
	CASE 12
		CFLAG:RESULT:노역플래그 = 10+ARG
		CFLAG:RESULT:종사내용 = 1
	CASE 13, 14, 15
		CFLAG:RESULT:노역플래그 = 10+ARG
		CFLAG:RESULT:종사내용 = 1
		CFLAG:RESULT:개별성적서비스 = 1
	ENDSELECT
ELSE
	GOTO INPUT_LOOP_1
ENDIF
GOTO INPUT_LOOP_2

;========================================================
;雇用可能人数拡張
;========================================================
@EXTEND_MEMBER_MANAGEMENT,ARG
IF 店舗("종류",ARG) == 10
	PRINTFORML 현재 이 화장실에 설치할 수 있는 변기의 수는 {店舗("접객고용",ARG)}명입니다.　　소지금:￥{MONEY}
ELSEIF 店舗("종류",ARG) == 13 || 店舗("종류",ARG) == 14 || 店舗("종류",ARG) == 15
	PRINTFORML 현재 이 교회에 상주할 수 있는 인원수는 {店舗("접객고용",ARG)}명입니다.　　소지금:￥{MONEY}
ELSE
	PRINTFORML 현재 이 점포에 배치할 수 있는 접객 담당은 {店舗("접객고용",ARG)}명입니다.
ENDIF

;---- EDIT 002 MOD START ---------
;雇用人数の拡張を一気に行えるようにしてみる。
;現在の雇用人数を取得
LOCAL:1 = 店舗("접객고용",ARG)

PRINTL
IF 店舗("종류",ARG) == 10
	PRINT 변기의 수를
ELSE
	PRINT 인원수를
ENDIF
PRINTL 얼마나 늘릴지 선택해 주십시오.
PRINTL 직접 입력하여 늘릴 수를 지정할 수도 있습니다.
PRINTL 0을 입력하면 확장을 중지합니다.
PRINTL
PRINTFORML [1]  - 1명 늘린다  (￥{規模拡張金額(LOCAL:1,1,0)})
PRINTFORML [5]  - 5명 늘린다  (￥{規模拡張金額(LOCAL:1,5,0)})
PRINTFORML [10] - 10명 늘린다 (￥{規模拡張金額(LOCAL:1,10,0)})
PRINTL [0]  - 확장하지 않는다

INPUT

LOCAL:2 = RESULT

PRINTL

IF LOCAL:2 == 0
	PRINTL 확장을 중지합니다.
	RETURN 0
ELSE
	LOCAL = 規模拡張金額(LOCAL:1,LOCAL:2,0)
	PRINTFORM {LOCAL:2}명 늘리기 위해서는 ￥{LOCAL}이(가) 필요합니다
	IF MONEY < LOCAL
		PRINTL 하지만 자금이 부족합니다.
		RETURN 0
	ENDIF
	PRINTL 。
ENDIF

PRINTL 확장하겠습니까?
CALL INPUT_YN,"YES","NO"
SIF RESULT == 1
	RETURN 0
CALL 店舗演算("접객고용",ARG,LOCAL:2,"+")
;---- EDIT 002 MOD END -----------
MONEY -= LOCAL

