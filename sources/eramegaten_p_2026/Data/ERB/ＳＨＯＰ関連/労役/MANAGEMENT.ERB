		LOCALS:6 = 獣姦
		RESETCOLOR
		
		DRAWLINE
		PRINTFORMLC \@(LOCAL:4 > 0) ? [1001]이전캐릭터 # %" " * 16%\@
		PRINTLC [0] 돌아간다
		PRINTFORMLC \@(LOCAL:4 < A - 1) ? [1003]다음캐릭터 # %" " * 16%\@
		CALL INPUTINT,0,1,2,3,4,5,6,1001,1003
		IF RESULT == 0
			GOTO INPUT_LOOP_2
		ELSEIF RESULT == 1001 && LOCAL:4 > 0
			LOCAL:4 -= 1
			LOCAL:1 = Q:(LOCAL:4)
			GOTO CHANGE_COMMODITY
		ELSEIF RESULT == 1003 && LOCAL:4 < A - 1
			LOCAL:4 += 1
