;========================================================
;価格設定
;========================================================
@ARRANGE_PRICE_MANAGEMENT,ARG
SELECTCASE [[店舗:종류]]:ARG
	CASE 10
		PRINTFORML 현재 상품의 기본 가격은 다음과 같습니다. 변경할 상품을 골라 주십시오
		PRINTFORML [1] 펠라치오: {店舗("펠라가격",ARG)} 마카
		LOCALS:1 = 펠라치오
		PRINTFORML [2] 본방      ：{店舗("본방가격",ARG)} 마카
		LOCALS:2 = 本番
		PRINTFORML [3] 애널    ：{店舗("애널가격",ARG)} 마카
		LOCALS:3 = 애널
		PRINTFORML [4] 질내사정: {店舗("질내사정가격",ARG)} 마카
		LOCALS:4 = 中出し
		PRINTFORML [5] 처녀      ：{店舗("처녀가격",ARG)} 마카
		LOCALS:5 = 처녀
		DRAWLINE
		PRINTL [0] 돌아간다 [9]가격을 전원에게 반영
		CALL INPUTINT,0,1,2,3,4,5,9
		IF RESULT == 0
			RETURN 0
		ELSEIF RESULT == 9
			FOR LOCAL , 0 ,CHARANUM
				IF CFLAG:LOCAL:노역플래그 % 10 == ARG
					CFLAG:LOCAL:펠라가격= 店舗("펠라가격",ARG)
					CFLAG:LOCAL:본방가격= 店舗("본방가격",ARG)
