#DIM LCOUNT

;LOCAL配列初期化
VARSET LOCAL,0
CFLAG:ARG:펠라횟수 = 0
CFLAG:ARG:본방횟수 = 0
CFLAG:ARG:애널횟수 = 0
CFLAG:ARG:질내사정횟수 = 0
CFLAG:ARG:수음횟수 = 0
;優しい娼館顧客）
IF ARG:1 == -4
	CFLAG:ARG:질내사정횟수 = 1
	CFLAG:ARG:본방횟수 = 1
	LOCAL:1 = 3 + RAND:5
	LOCAL:2 = LOCAL:1 + RAND:(LOCAL:1)
	TCVAR:ARG:획득키스경험 = 3
	TCVAR:ARG:획득바람경험 = 1

;鬼畜な娼館顧客
ELSEIF ARG:1 == -5
	CFLAG:ARG:질내사정횟수 = 2
	CFLAG:ARG:본방횟수 = 2
	LOCAL:1 = 6 + RAND:10
	LOCAL:2 = LOCAL:1 + RAND:(LOCAL:1)
	TCVAR:ARG:획득윤간경험 = 1
ENDIF


FOR LCOUNT , 0 , LOCAL:2
	IF RAND:100 < 60
		IF HAVE_PENIS(ARG) && HAVE_VAGINA(ARG)
			CFLAG:ARG:본방횟수 += 1
			CFLAG:ARG:수음횟수 += 1
		ELSEIF HAVE_PENIS(ARG)
			CFLAG:ARG:애널횟수 += 1
			CFLAG:ARG:수음횟수 += 1
		ELSE
			CFLAG:ARG:본방횟수 += 1
		ENDIF
	ELSEIF RAND:100 < 50
		IF HAVE_PENIS(ARG)
			CFLAG:ARG:수음횟수 += 1
		ELSE
			CFLAG:ARG:펠라횟수 += 1
		ENDIF
	ELSE
		IF HAVE_PENIS(ARG) && HAVE_VAGINA(ARG)
			CFLAG:ARG:애널횟수 += 1
			CFLAG:ARG:수음횟수 += 1
		ELSEIF HAVE_PENIS(ARG)
			CFLAG:ARG:애널횟수 += 1
			CFLAG:ARG:수음횟수 += 1
		ELSE
			CFLAG:ARG:애널횟수 += 1
		ENDIF
	ENDIF
	;キス経験処理：適当にランダムで
	SIF RAND:2 == 0
		TCVAR:ARG:획득키스경험 += 1

NEXT
CFLAG:ARG:질내사정횟수 +=LIMIT(RAND:(1+CFLAG:ARG:본방횟수) , 0, LOCAL:1)

;獲得経験
TCVAR:ARG:획득펠라경험 = CFLAG:ARG:펠라횟수
TCVAR:ARG:획득봉사쾌락경험 = CFLAG:ARG:펠라횟수
TCVAR:ARG:획득Ｖ경험 = CFLAG:ARG:본방횟수
TCVAR:ARG:획득Ａ경험 = CFLAG:ARG:애널횟수
TCVAR:ARG:획득성교경험 = CFLAG:ARG:본방횟수 + CFLAG:ARG:애널횟수
TCVAR:ARG:획득질사경험 = CFLAG:ARG:질내사정횟수
TCVAR:ARG:획득정액경험 = LOCAL:1
SIF CFLAG:ARG:수음횟수 > 0
	TCVAR:ARG:획득사정경험 = RAND:(CFLAG:ARG:수음횟수)
SIF TCVAR:ARG:획득성교경험 + TCVAR:ARG:획득사정경험 > 0
	TCVAR:ARG:획득절정경험 = RAND:(TCVAR:ARG:획득성교경험 + TCVAR:ARG:획득사정경험)

;処女喪失処理
IF TALENT:ARG:처녀
	CALL ADDS_ABNORMAL_EXP, "処女喪失（輪姦）", ARG
	SETCOLOR COLOR("red")
	IF ARG:1 == -5
		PRINTFORML 【＋２】   처녀상실(윤간)
	ELSE
		PRINTFORML 【＋２】   처녀상실(ＮＴＲ)
	ENDIF
	RESETCOLOR
	TALENT:ARG:처녀 = 0
ELSEIF TALENT:ARG:재생처녀
	PRINTFORML 재생처녀상실
	TALENT:ARG:재생처녀 = 0
ENDIF

LOCAL:3 = TCVAR:ARG:획득정액경험 * 5 + (TCVAR:ARG:획득절정경험 + TCVAR:ARG:획득질사경험) * 10 + CFLAG:ARG:방치일수
LOCAL:4 = CFLAG:ARG:본방횟수 + CFLAG:ARG:애널횟수 + TCVAR:ARG:획득절정경험 * 10
LOCAL:5 = CFLAG:ARG:질내사정횟수 * 5 + TCVAR:ARG:획득절정경험 * 7

;ＮＴＲ客の設定処理
SELECTCASE FLAG:ＮＴＲ손님의설정
	CASE  0
		TIMES LOCAL:3 , 1.00
		TIMES LOCAL:4 , 1.00
		TIMES LOCAL:5 , 1.00
	CASE  1
		TIMES LOCAL:3 , 2.00
		TIMES LOCAL:4 , 2.00
		TIMES LOCAL:5 , 2.00
	CASE  2
		TIMES LOCAL:3 , 5.00
		TIMES LOCAL:4 , 5.00
		TIMES LOCAL:5 , 5.00
ENDSELECT




;好感度
IF ARG:1 == -4
	CDFLAG:ARG:캐릭터간호감도:(96) += LOCAL:3
ELSEIF ARG:1 == -5
	CDFLAG:ARG:캐릭터간호감도:(95) -= LOCAL:3
ENDIF

;淫乱度上昇
;浮気癖がある場合は淫乱度倍化
IF TALENT:ARG:바람기
	CFLAG:ARG:음란도 += LOCAL:4*2 + 1
ELSE
	CFLAG:ARG:음란도 += LOCAL:4 + 1
ENDIF

;子宮現在容量加算
IF TALENT:ARG:오토코노코
	CFLAG:(ARG):자궁현재용량 += LOCAL:5 * 2
ELSEIF !IS_MALE(ARG)
	CFLAG:(ARG):자궁현재용량 += LOCAL:5 * 2
ENDIF

;好感度減少処理
CALL NTR_SHOOT , ARG , ARG:1 , LOCAL:5

;妊娠用
SIF CFLAG:ARG:자궁내피임결계 == 0
	CFLAG:ARG:고객의질내사정에의한임신판정 += TCVAR:ARG:획득질사경험*2

CALL SHOW_ADD_EXP, ARG

