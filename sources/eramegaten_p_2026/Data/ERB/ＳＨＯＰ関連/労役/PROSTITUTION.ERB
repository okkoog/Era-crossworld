;娼館で働かせる
;奴隷を一日だけ娼館に貸して働かせます。客の数だけ収益が上がるため、欲望やレズが重要視されます

;==========================================================
;@PROSTITUTION
; 宿屋(창관)で働かせる奴隷を選択する。
;<引数>
;	なし
;<戻り値>
;	なし
;==========================================================
@PROSTITUTION
#LOCALSIZE 5
$PROSTITUTION_TOP
;使用する変数の初期化
A = 0
B = 0
C = 0
D = 0
;LOCAL   = 選択したキャラ
;LOCAL:1 = 単価
;LOCAL:2 = 売春可能人数
;LOCAL:3 = 一括売春用カウンタ
;LOCAL:4 = 労役確認結果
;LOCAL配列初期化
VARSET LOCAL,0
$PRINT_LIST
;CALL INPUT_CHARA_LIST("売春させる奴隷を選択してください", "CASTING_PROSTITUTION", "PROSTITUTION_POPULARITY", "", "MODECHANGE_PROSTITUTION")
{
CALL INPUT_CHARA_LIST
	, "FUNC_PROPSET_LIST"
	, "매춘시킬 노예를 선택해주세요"
	, "CASTING_PROSTITUTION" 
	, "PROSTITUTION_POPULARITY"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "MODECHANGE_PROSTITUTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
IF RESULT == 1000
	RETURN 0
ENDIF

IF RESULT == 999
	;一括選択できない状態のためINPUT_LOOP_1に戻る
	SIF FLAG:노역실행확인생략설정 == 0 || FINDELEMENT(Q, -1) < 2
		GOTO PRINT_LIST
	;一応確認
	PRINTL 현재 매춘 가능한 모든 노예를 매춘시킵니다。
	PRINTL 괜찮겠습니까？
	CALL INPUT_YN
	SIF RESULT == 1
		;キャラ一覧に戻る。
		GOTO PRINT_LIST
	;一括労役フラグON
	LOCAL:3 = 1
	LOCAL = Q:(LOCAL:3-1)
	LOCAL:2 = FINDELEMENT(Q, -1)
ELSE
	LOCAL = RESULT
ENDIF

$SELECT_LOOP

;単価を計算。
DRAWLINE

CALL SALARY_PROSTITUTION,LOCAL,1
LOCAL:1 = RESULT

IF LOCAL:1 > 0
	;労役実行確認省略設定が有効な場合、表示後WAITしないようにする。
	IF FLAG:노역실행확인생략설정 == 0
		PRINTFORMW 매춘 하루 당 {LOCAL:1}마카 정도가 기대됩니다
	ELSE
		PRINTFORML 매춘 하루 당 {LOCAL:1}마카 정도가 기대됩니다
	ENDIF
ELSE
	PRINTFORMW 매춘가격이 0마카를 밑돌았기 때문에、중지했습니다
	IF FLAG:노역실행확인생략설정 == 1
		IF LOCAL:3 > 0 && LOCAL:3 < LOCAL:2
			;LOCAL:3が0より大きく(一括選択)、LOCAL:3がLOCAL:2未満(まだ全員の労役従事が終わってない)場合
			;次のキャラの労役従事
			LOCAL:3 += 1
			LOCAL = Q:(LOCAL:3-1)

			GOTO SELECT_LOOP
		ELSE
			;労役実行確認省略設定が有効な場合、関数の頭に戻る
			GOTO PROSTITUTION_TOP
		ENDIF
	ENDIF
	RETURN 0
ENDIF

;娼館コマンドを実行するか？
IF FLAG:노역실행확인생략설정 == 0
	PRINTFORML 오늘 하루、%CALLNAME:LOCAL%에게 매춘을 시키시겠습니까？
	CALL INPUT_YN,"매춘시킨다","그만둔다"
	LOCAL:4 = RESULT
ELSE
	;労役実行確認省略設定が有効な場合、実行確認は無条件で実行する(0)を設定
	LOCAL:4 = 0
ENDIF

IF LOCAL:4 == 0
	PRINTFORML 다음 날까지 %CALLNAME:LOCAL%에게 손님을 받게 합니다
	;イベント口上
	T = TARGET
	TARGET = LOCAL
	TFLAG:13 = 16
	;未調教陥落フラグを折る
	CFLAG:피조교횟수 += 1
	CALL KOJO_MESSAGE_EVENT
	TARGET = T
	;SIF LOCAL == TARGET
	;	TARGET = -1
	;SIF LOCAL == ASSI
	;	ASSI = -1
	;SIF CPOS(LOCAL) > 0
	;	CALL REMOVE_POSITION,CPOS(LOCAL)
	CFLAG:LOCAL:노역플래그 = 2
	CFLAG:LOCAL:노역단가 = LOCAL:1
	PRINTL 
	IF FLAG:노역실행확인생략설정 == 1
		IF LOCAL:3 > 0 && LOCAL:3 < LOCAL:2
			;LOCAL:3が0より大きく(一括選択)、LOCAL:3がLOCAL:2未満(まだ全員の労役従事が終わってない)場合
			;次のキャラの労役従事
			LOCAL:3 += 1
			LOCAL = Q:(LOCAL:3-1)

			GOTO SELECT_LOOP
		ELSE
			;労役実行確認省略設定が有効な場合、関数の頭に戻る
			GOTO PROSTITUTION_TOP
		ENDIF
	ENDIF
ELSE
	RESTART
ENDIF

@CASTING_PROSTITUTION(ARG)
SIF CFLAG:ARG:노역플래그 > 0
	RETURN 0
SIF TALENT:ARG:반역
	RETURN 0
SIF ARG != MASTER && (ABL:ARG:욕망 + ABL:ARG:기교 + ABL:ARG:노출증 + TALENT:ARG:음란*3 + TALENT:ARG:창부*3) < 7
	RETURN 0
SIF BASE:ARG:체력 <= 500
	RETURN 0
SIF CFLAG:ARG:이자리에없는플래그 == 1
	RETURN 0
SIF CFLAG:ARG:전투이외불능
	RETURN 0
SIF TALENT:ARG:맹우
	RETURN 0
RETURN 1

@PROSTITUTION_POPULARITY
PRINT 매춘시킬 노예를 선택해주세요　　　
IF ITEM:창관 
	PRINTFORM 창관인기:{FLAG:매춘인기, 4, RIGHT}
ELSEIF ITEM:여관
	PRINTFORM 여관인기:{FLAG:매춘인기, 4, RIGHT}
ENDIF
PRINTFORML 

@MODECHANGE_PROSTITUTION, ARG
SELECTCASE ARG
	CASE -1
		;労役実行確認省略オプションが有効な場合にのみ選択肢を表示する。
		SIF FLAG:노역실행확인생략설정 == 1 && FINDELEMENT(Q, -1) >= 2
			PRINTL [999] 매춘 가능한 모든 노예를 매춘시킨다
	CASE 999
		RETURN ARG , 0
ENDSELECT
RETURN ARG , 1

;==========================================================
;@END_PROSTITUTION
; 宿屋(창관)での労役日報処理
;<引数>
;	ARG = 労役を行うキャラの登録番号
;<戻り値>
;	なし
;==========================================================
@END_PROSTITUTION,ARG
#LOCALSIZE 25
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 客入り
#DIM DYNAMIC Ｖプレイ回数
#DIM DYNAMIC Ａプレイ回数
;LOCAL:1  = 作業用領域
;LOCAL:10 = 客入り
;LOCAL:9  = 計算用
;LOCAL:8  = 顧客満足度
;LOCAL:7  = 評価
;LOCAL:6  = 合計プレイ回数
;LOCAL:11 = セックス系プレイ頻度(回数)
;LOCAL:12 = 奉仕系プレイ頻度(回数)
;LOCAL:13 = ＳＭ系プレイ頻度(回数)
;LOCAL:14 = 同性愛(レズ、ＢＬ)系プレイ頻度(回数)
;LOCAL:16 = プレイ頻度合計(割合計算用)
;LOCAL:20 = Ｖ／Ａプレイ回数差計算用
;LOCAL:21 = Ｖプレイ回数
;LOCAL:22 = Ａプレイ回数
;LOCAL:23 = 処女喪失による珠加算補正

;LOCAL配列初期化
VARSET LOCAL,0

;最初に労役単価を再計算
CALL SALARY_PROSTITUTION,ARG,0
CFLAG:ARG:노역단가 = RESULT

CUSTOMDRAWLINE ･


;娼婦の人気に応じて客が来ます
;初めての場合は店の人気に依存
IF EXP:ARG:매춘경험 == 0
	LOCAL:8 = 100
	SIF ITEM:여관 || ITEM:창관
		LOCAL:8 = FLAG:매춘인기 + 40
	LOCAL = 0
	LOCAL:9 = 0
	WHILE LOCAL:8 > 100 * (POWER(4 , LOCAL)-1) / 3
		LOCAL:9 += (MIN(LOCAL:8 , 100 * (POWER(4 , LOCAL+1) - 1) / 3) - 100 * (POWER(4 , LOCAL) -1) / 3) / (10 * (POWER(4,LOCAL)))
		LOCAL ++
	WEND
	IF LOCAL:9
		FOR LCOUNT, 0, LOCAL:9
			客入り += RAND:2
		NEXT
	ENDIF
ELSE
	LOCAL = 0
	LOCAL:9 = 0
	WHILE CFLAG:ARG:매춘인기 > 100 * (POWER(2 , LOCAL)-1) / 3
		LOCAL:9 += (MIN(CFLAG:ARG:매춘인기 , 100 * (POWER(2 , LOCAL+1) - 1) / 3) - 100 * (POWER(2 , LOCAL) -1) / 3) / (10 * (POWER(2,LOCAL)))
		LOCAL ++
	WEND
	IF LOCAL:9
		FOR LCOUNT, 0, LOCAL:9
			客入り += RAND:2
		NEXT
	ENDIF
ENDIF
;店に人気に応じて客が来ます
LOCAL:8 = 100
SIF ITEM:여관 || ITEM:창관
	LOCAL:8 = FLAG:매춘인기
LOCAL = 0
LOCAL:9 = 0
WHILE LOCAL:8 > 100 * (POWER(4 , LOCAL)-1) / 3
	LOCAL:9 += (MIN(LOCAL:8 , 100 * (POWER(4 , LOCAL+1) - 1) / 3) - 100 * (POWER(4 , LOCAL) -1) / 3) / (10 * (POWER(4,LOCAL)))
	LOCAL ++
WEND
IF 客入り
	FOR LCOUNT, 0, LOCAL:9
		客入り += RAND:2
	NEXT
ENDIF


客入り = TABLE_CALC2(客入り, 5, 95)
客入り = TABLE_CALC2(客入り, 10, 90)
客入り = TABLE_CALC2(客入り, 25, 80)
客入り = TABLE_CALC2(客入り, 30, 10)


;最低一人は来る
SIF 客入り < 1
	客入り = 1

;満足度判定
;ランダムで40を追加します。売春経験に応じて期待値は上昇します。
IF EXP:ARG:매춘경험 > 30000
	LOCAL:8 = 60
ELSEIF EXP:ARG:매춘경험 > 10000
	LOCAL:8 = RAND:31 + 30
ELSEIF EXP:ARG:매춘경험 > 5000
	LOCAL:8 = RAND:36 + 25
ELSEIF EXP:ARG:매춘경험 > 3000
	LOCAL:8 = RAND:41 + 20
ELSEIF EXP:ARG:매춘경험 > 1000
	LOCAL:8 = RAND:46 + 15
ELSEIF EXP:ARG:매춘경험 > 500
	LOCAL:8 = RAND:51 + 10
ELSEIF EXP:ARG:매춘경험 > 100
	LOCAL:8 = RAND:56 + 5
ELSE
	LOCAL:8 = RAND:61
ENDIF

;欲望をチェックする。欲望が相手の欲望を上回るかどうか。成功なら欲望レベルの２倍、失敗なら１倍入ります。
;CBVA売春では、相手の欲望の最大値が4です。
LOCAL:9 = RAND:9
IF LOCAL:9 <= ABL:ARG:욕망
	LOCAL:8 += ABL:ARG:욕망
	LOCAL:8 += ABL:ARG:욕망
ELSE
	LOCAL:8 += ABL:ARG:욕망
ENDIF

;相手からの行動が発生します。相手の技巧がこちらの欲望以下の場合、不満そうな表情が出る可能性があります。
;相手の技巧＋こちらの従順の２倍＞こちらの欲望＋２なら、問題なく行為を露出癖と奉仕精神を加える事が出来ます。
;足りない場合は加えられません。
LOCAL:9 = RAND:5
LOCAL:9 += ABL:ARG:순종
LOCAL:9 += ABL:ARG:순종
LOCAL:9 -= 2

IF LOCAL:9 >= ABL:ARG:기교
	LOCAL:8 += ABL:ARG:봉사정신
	LOCAL:8 += ABL:ARG:노출증
ENDIF

;ここまでで最大120％

;従順が3LVないと、著しく微妙になります
IF ABL:ARG:순종 < 3 && ARG != MASTER
	LOCAL:8 /= 2
ENDIF

;この時点でのLOCAL:8が満足度

;総プレイ回数を計算
LOCAL:6 = 0
FOR LCOUNT, 0, 客入り
	;客一人当たり、１＋０～満足度/10回プレイしていく
	LOCAL:6 += 1 + (RAND:(LOCAL:8/10+1))
NEXT

;LOCAL:11 ~ 15 セックス系　～同性愛系の割合、16 = 割合合計

;素質、能力に応じて行為の比率の決定(各素質は持ってれば1が入っている）
;セックス系、基本的に大きい。AV感覚、処女、再生処女、セックス中毒、セックス狂、尻穴狂い
;オトコが無い場合のみＶでの回数を加算する
LOCAL:11 = 0
SIF TALENT:ARG:남자 == 0
	LOCAL:11 = ABL:ARG:Ｖ감각+TALENT:ARG:처녀*7+TALENT:ARG:재생처녀*3+TALENT:ARG:섹스광*5
LOCAL:11 += ABL:ARG:Ａ감각+ABL:ARG:섹스중독+TALENT:ARG:애널광*5

;奉仕系、奉仕精神と精液中毒が高く、献身的
LOCAL:12 = ABL:ARG:봉사정신+ABL:ARG:정액중독+TALENT:ARG:헌신적*5

;SM系、|새드끼-마조끼|の数値が大きい、倒錯的、サド、マゾ、体力大目
;マゾ傾向
IF ABL:ARG:마조끼 >= ABL:ARG:새드끼
	LOCAL:13 = ABL:ARG:마조끼-ABL:ARG:새드끼+TALENT:ARG:마조*10+TALENT:ARG:도착적*5
;サド傾向
ELSEIF ABL:ARG:새드끼 > ABL:ARG:마조끼
	LOCAL:13 = ABL:ARG:새드끼-ABL:ARG:마조끼+TALENT:ARG:새드*10+TALENT:ARG:도착적*5
;同値
ELSE
	LOCAL:13 = ABL:ARG:마조끼+TALENT:ARG:도착적*5
ENDIF
;5未満は0にする
SIF LOCAL:13 < 5
	LOCAL:13 = 0

;レズ系、レズっ気、レズ中毒、両刀、男性の場合はＢＬっ気とＢＬ中毒
LOCAL:14 = ABL:ARG:레즈끼+ABL:ARG:레즈중독*2+TALENT:ARG:바이*5+ABL:ARG:ＢＬ끼+ABL:ARG:ＢＬ중독*2
;5未満は0にする
SIF LOCAL:14 < 5
	LOCAL:14 = 0

;高頻度プレイ(売春口上分岐)判定用の値を設定
;1:セックス系、2:奉仕系、3:ＳＭ系、4:同性愛(レズ、ＢＬ)系
CFLAG:ARG:창관에서플레이빈도판정 = 1
SIF LOCAL:(10+CFLAG:ARG:창관에서플레이빈도판정) < LOCAL:12
	CFLAG:ARG:창관에서플레이빈도판정 = 2
SIF LOCAL:(10+CFLAG:ARG:창관에서플레이빈도판정) < LOCAL:13
	CFLAG:ARG:창관에서플레이빈도판정 = 3
SIF LOCAL:(10+CFLAG:ARG:창관에서플레이빈도판정) < LOCAL:14
	CFLAG:ARG:창관에서플레이빈도판정 = 4

LOCAL:16 = MAX(1,LOCAL:11 + LOCAL:12 + LOCAL:13 + LOCAL:14)

;それぞれの系統のプレイ回数を算出してLOCAL:11 ～ 14に入れる
LOCAL:11 = LOCAL:6 * LOCAL:11 / LOCAL:16
LOCAL:12 = LOCAL:6 * LOCAL:12 / LOCAL:16
LOCAL:13 = LOCAL:6 * LOCAL:13 / LOCAL:16
LOCAL:14 = LOCAL:6 * LOCAL:14 / LOCAL:16

SIF LOCAL:11 + LOCAL:12 + LOCAL:13 + LOCAL:14 == 0
	LOCAL:(11+RAND:4) = LOCAL:6

;売春時の口上表示
LOCAL:1 = TARGET
TARGET = ARG
TFLAG:13 = 63
CALL KOJO_MESSAGE_EVENT
TARGET = LOCAL:1
PRINTFORML %CALLNAME:ARG%의 매춘결과：

;体力の減少基本値
LOSEBASE:체력 = LOCAL:6*25
;ストレス値の付加
SIF ARG != MASTER
	CFLAG:ARG:스트레스치 += 2

LOCAL:23 = 0
IF LOCAL:11 > 0
	;VとAのプレイ差
	;オトコはAのみ
	IF TALENT:ARG:남자
		LOCAL:20 = ABL:ARG:Ａ감각
		Ｖプレイ回数 = 0
		Ａプレイ回数 = LOCAL:11
	ELSEIF ABL:ARG:Ｖ감각 > ABL:ARG:Ａ감각
		LOCAL:20 = ABL:ARG:Ｖ감각-ABL:ARG:Ａ감각
		Ｖプレイ回数 = LOCAL:11/2+LOCAL:20
		Ａプレイ回数 = LOCAL:11-Ｖプレイ回数
	ELSE
		LOCAL:20 = ABL:ARG:Ａ감각-ABL:ARG:Ｖ감각
		Ｖプレイ回数 = LOCAL:11/2-LOCAL:20
		Ａプレイ回数 = LOCAL:11-Ｖプレイ回数
	ENDIF
	;奴隷が処女の場合
	IF TALENT:ARG:처녀
		Ｖプレイ回数 += LOCAL:20/2
		Ａプレイ回数 -= LOCAL:20/2
		SIF Ｖプレイ回数 > 0
			LOCAL:23 = 20
	ENDIF
	SIF Ｖプレイ回数 < 0
		Ｖプレイ回数 = 0
	SIF Ａプレイ回数 < 0
		Ａプレイ回数 = 0
	EXP:ARG:Ｖ경험 += Ｖプレイ回数
	EXP:ARG:Ａ경험 += Ａプレイ回数
	EXP:ARG:절정경험 += LOCAL:11/3
	;ふたなりかオトコ
	SIF TALENT:ARG:후타나리 || TALENT:ARG:남자
		EXP:ARG:사정경험 += LOCAL:11/3
	;男の娘はケツマンコで妊娠
	SIF TALENT:ARG:오토코노코 && CFLAG:ARG:자궁내피임결계 == 0
		CFLAG:ARG:고객의질내사정에의한임신판정 += Ａプレイ回数
	EXP:ARG:성교경험 += Ｖプレイ回数 + Ａプレイ回数
	;질사경험
	IF CFLAG:ARG:자궁내피임결계 == 0
		EXP:ARG:질사경험 += Ｖプレイ回数
		CFLAG:ARG:고객의질내사정에의한임신판정 += Ｖプレイ回数
	ENDIF
	JUEL:ARG:쾌Ｖ += Ｖプレイ回数*50
	JUEL:ARG:쾌Ａ += Ａプレイ回数*50
	JUEL:ARG:욕정 += LOCAL:11*30
	JUEL:ARG:습득 += LOCAL:11*50
	SIF ARG != MASTER
