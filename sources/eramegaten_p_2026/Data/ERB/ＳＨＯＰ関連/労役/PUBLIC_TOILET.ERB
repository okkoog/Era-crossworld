@便器誘惑度(CHARA, F_NTR)
#FUNCTION
#DIM CHARA
#DIM L_誘惑度
#DIM F_NTR

;ふつう全裸なので服装は無し
L_誘惑度 = 50

;従順で追加
L_誘惑度 += ABL:CHARA:순종 * 4
;奉仕精神で追加
L_誘惑度 += ABL:CHARA:봉사정신 * 3
;精液中毒で追加
L_誘惑度 += ABL:CHARA:정액중독 * 5
;発情で追加
SIF 위험일(CHARA) > 1
	L_誘惑度 += 10
;PALAM・屈服で追加
L_誘惑度 += PALAMLV_F(CHARA, "굴복")*3
;PALAM・欲望で追加
L_誘惑度 += PALAMLV_F(CHARA, "욕정")*1
;PALAM・潤滑で追加
L_誘惑度 += PALAMLV_F(CHARA, "윤활")*1


;淫乱・娼婦で追加
SIF TALENT:CHARA:음란
	TIMES L_誘惑度 , 1.30
SIF TALENT:CHARA:창부
	TIMES L_誘惑度 , 1.60

;服従・隷属で追加
SIF TALENT:CHARA:복종
	TIMES L_誘惑度 , 2.00
SIF TALENT:CHARA:예속
	TIMES L_誘惑度 , 2.50

;NTRチェック
IF F_NTR
	IF F_NTR >= 3
		SIF TALENT:CHARA:연모
			TIMES L_誘惑度 , 2.00
		SIF TALENT:CHARA:친애
			TIMES L_誘惑度 , 5.00
	ELSE
		SIF TALENT:CHARA:연모
			TIMES L_誘惑度 , 0.50
		SIF TALENT:CHARA:친애
			TIMES L_誘惑度 , 0.20
	ENDIF
ENDIF

SIF CFLAG:CHARA:인계횟수 && FLAG:게임모드 != 9 && DAY < 51
	L_誘惑度 = L_誘惑度 * DAY / 100



RETURNF L_誘惑度

