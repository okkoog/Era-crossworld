		;EXP:CHARA:변기경험 += CFLAG:CHARA:변기사용예정인수
		;EXP:CHARA:펠라경험 += CFLAG:CHARA:펠라횟수
		;EXP:CHARA:Ｖ경험 += CFLAG:CHARA:본방횟수
		;EXP:CHARA:Ａ경험 += CFLAG:CHARA:애널횟수
		;---- EDIT 013 MOD END ---------------------------
