;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;公衆便所に必要な処理置き場
@MANAGEMENT_PUBLIC_TOILET, ARG
;カウンタ類
#DIM POT
#DIM CHARA
#DIM USER
#DIM DISPOSE

;その他ローカル変数
#DIM 便器_設置数
#DIM 便器_嬢目当ての客
#DIM 便器_集まった客
#DIM 便器_店内の客

#DIM 便器_客溢れフラグ
#DIM 便器_客毎口回数
#DIM 便器_客毎Ｖ回数
#DIM 便器_客毎膣内射精回数
#DIM 便器_客毎Ａ回数
#DIM 便器_満足度
#DIM 便器_変動計算用
#DIM 便器_総売上
#DIM 便器_成功度集計

#DIM 便器_使われた便器数
#DIM 便器_NTR客フラグ
#DIM 便器_誘惑度保存
#DIM 便器_マネジメント数



便器_集まった客 = 0
便器_店内の客 = 0
便器_客溢れフラグ= 0
便器_総売上 = 0
便器_成功度集計 = 0
便器_使われた便器数 = 0


;-----------------------------
;便器準備
;-----------------------------
;便器を数えつつ、「C」に便器のキャラ番号を格納
VARSET C , -1
便器_設置数 = 0
FOR CHARA,0, CHARANUM
	IF CFLAG:CHARA:노역플래그 == 10 + ARG
		C:便器_設置数 = CHARA
		便器_設置数 += 1
	ENDIF
NEXT
;設置してなければ終了
IF 便器_設置数 == 0
	PRINTW 육변기를 한 명도 설치하지 않았기 때문에, 이용자는 아무도 오지 않았다
	GOTO TOILET_END
ENDIF

;-----------------------------
;便器へ客を並べる
;-----------------------------
;便器嬢の集客力
便器_嬢目当ての客 = 0
FOR POT, 0, 便器_設置数
	CHARA = C:POT
	;使用予定人数　人気の 約1/25
	CFLAG:CHARA:변기사용예정인수 = CFLAG:CHARA:변기인기 * (80 + RAND:11) / 2125
	便器_嬢目当ての客 += CFLAG:CHARA:변기사용예정인수
NEXT
便器_集まった客 = 便器_嬢目当ての客

;予約で埋まったかな？
IF 便器_集まった客 > 店舗("규모", ARG)
	;店に入れないから帰る
	便器_店内の客 = 0
	FOR POT, 0, 便器_設置数
		CHARA = C:POT
		CFLAG:CHARA:변기사용예정인수 = CFLAG:CHARA:변기사용예정인수 * 店舗("규모", ARG) / 便器_集まった客
		便器_店内の客 += CFLAG:CHARA:변기사용예정인수
	NEXT
ELSE
	便器_店内の客 = 便器_集まった客
ENDIF

;店舗の集客力　(店舗人気＋선전효과)の約1/10
便器_集まった客 += MAX(1 + RAND:3, (店舗("인기", ARG) + 店舗("선전효과", ARG)) * (80 + RAND:11) / 850)

;便所せまいよ再チェック
IF 便器_集まった客 > 店舗("규모", ARG)
	便器_店内の客 = 店舗("규모", ARG)
	便器_客溢れフラグ= 1
ELSE
	便器_店内の客 = 便器_集まった客
ENDIF
;(C:便器_設置数)に看板便器を記録
C:便器_設置数 = 看板便器(ARG)
;フリーのお客をランダムに割り振る
IF 便器_店内の客 > 便器_嬢目当ての客
	FOR USER, 0, 便器_店内の客 - 便器_嬢目当ての客
		;看板便器は2倍の抽選機会
		CHARA = C:(RAND:(便器_設置数 + 1))
		CFLAG:CHARA:변기사용예정인수 += 1
	NEXT
ENDIF


;-----------------------------
;便器毎の計算
;-----------------------------
FOR POT, 0, 便器_設置数
	CHARA = C:POT

	;未調教陥落フラグを折る
	CFLAG:CHARA:피조교횟수  += 1

	;信じてたのに！
	IF TALENT:CHARA:신뢰 || TALENT:CHARA:동료
		SETCOLOR 0xff0033
		IF TALENT:CHARA:연모
			PRINTFORMW 조교를 받은 것으로 인해, %NAME:CHARA%은(는) %NAME:MASTER%에 대한 애욕이 우정을 웃돌아버렸다
		ELSEIF GET_VALUE_TALENT_JOINABLE(CHARA) == 1
			PRINTFORMW 조교를 받은 것으로 인해, %NAME:CHARA%은(는) %NAME:MASTER%에 대한 우정이 무너져, 전투에 참가하지 않게 되었습니다
			CALL SET_TALENT_PARTY_JOINABLE, CHARA, "参加不可能"
			SIF CFLAG:CHARA:포지션 > 0
				CALL REMOVE_POSITION,CFLAG:포지션
		ELSE
			PRINTFORMW 조교를 받은 것으로 인해, %NAME:CHARA%은(는) %NAME:MASTER%의 노예임을 재인식한 것 같다
		ENDIF
		SIF TALENT:CHARA:신뢰
			PRINTFORMW %NAME:CHARA%은(는) 【신뢰】를 잃었다
		SIF TALENT:CHARA:동료
			PRINTFORMW %NAME:CHARA%은(는) 【동료】를 잃었다
		TALENT:CHARA:신뢰 = 0
		TALENT:CHARA:동료 = 0
		RESETCOLOR
	ENDIF
	IF GET_VALUE_TALENT_JOINABLE(CHARA) == 1 && CHARA != MASTER
		SETCOLOR 0xff0033
		PRINTFORMW 공중육변기가 됨으로써, %NAME:CHARA%은(는) %NAME:MASTER%에 대한 신뢰를 잃고, 전투에 참가하지 않게 되었습니다
		CALL SET_TALENT_PARTY_JOINABLE, CHARA, "参加不可能"
		SIF CFLAG:CHARA:포지션 > 0
			CALL REMOVE_POSITION, CFLAG:CHARA:포지션
		RESETCOLOR
	ENDIF

	;ローション塗ります
	PALAM:CHARA:윤활 = 1000

	;念のため
	CFLAG:CHARA:펠라횟수 = 0
	CFLAG:CHARA:본방횟수 = 0
	CFLAG:CHARA:애널횟수 = 0
	CFLAG:CHARA:질내사정횟수 = 0

	便器_満足度 = 0
	便器_NTR客フラグ = 0
	便器_マネジメント数 = 0

	;-----------------------------
	;客毎の計算
	;-----------------------------
	FOR USER, 0, CFLAG:CHARA:변기사용예정인수
		;-----------------------------
		;フェラ
		;-----------------------------
		便器_客毎口回数 = 0
		IF CFLAG:CHARA:개별성적서비스& 8
			便器_誘惑度保存 = 便器誘惑度(CHARA, 便器_NTR客フラグ)
			FOR DISPOSE, 0, 1 + (便器_誘惑度保存 + RAND:便器_誘惑度保存) / 20
				IF 便器_誘惑度保存 / 2 + RAND:便器_誘惑度保存 >= CFLAG:CHARA:펠라가격 * (40 + 便器_客毎口回数 * 60)
					;とりあえず回数増える
					CFLAG:CHARA:펠라횟수 += 1
					便器_客毎口回数 += 1
				ELSE
					BREAK
				ENDIF
			NEXT
			;フェラのソースをまとめて追加
			SOURCE:CHARA:정애 = 100 * 便器_客毎口回数
			SOURCE:CHARA:성행위 = 300 * 便器_客毎口回数
			SOURCE:CHARA:달성 = 150 * 便器_客毎口回数
			SOURCE:CHARA:굴종 = 700 * 便器_客毎口回数
			SOURCE:CHARA:일탈 = 200 * 便器_客毎口回数
			SOURCE:CHARA:반감 = 200 * 便器_客毎口回数
			CALL SOURCE_MANAGEMENT_CHECK, CHARA
			CALL CUP_MANAGEMENT_T, CHARA
			IF 便器_客毎口回数
				便器_マネジメント数 += 1
				CALL フェラ_便器_MANAGEMENT, CHARA
				便器_満足度 += RESULT
			ENDIF
		ENDIF
		;-----------------------------
		;Ｖ
		;-----------------------------
		便器_客毎Ｖ回数 = 0
		便器_客毎膣内射精回数 = 0
		IF TALENT:CHARA:남자 == 0 && CFLAG:CHARA:개별성적서비스 & 16
			便器_誘惑度保存 = 便器誘惑度(CHARA, 便器_NTR客フラグ)
			CALL 本番_便器_MANAGEMENT_SOURCE, CHARA
			FOR DISPOSE, 0, 1 + (便器_誘惑度保存 + RAND:便器_誘惑度保存) / 20
				IF 便器_誘惑度保存 / 2 + RAND:便器_誘惑度保存 >= CFLAG:CHARA:본방가격 * (20 + 便器_客毎Ｖ回数 * 30) + TALENT:CHARA:처녀 * (CFLAG:CHARA:처녀가격 - 25) + TALENT:CHARA:재생처녀 * (CFLAG:CHARA:처녀가격 * 2 - 5)
					CALL 本番_便器_MANAGEMENT_FOR, CHARA
					;キス経験処理：適当にランダムで
					SIF RAND:4 == 0
						TCVAR:CHARA:획득키스경험 += 1
					便器_客毎Ｖ回数 += 1
					;卵子
					IF CFLAG:CHARA:개별성적서비스& 64
						IF 便器_誘惑度保存 / 2 + RAND:便器_誘惑度保存 >= CFLAG:CHARA:질내사정가격 * (1 + 便器_客毎膣内射精回数 * 6)
							;とりあえず回数増える
							CFLAG:CHARA:질내사정횟수 += 1
							SIF TALENT:CHARA:임신 == 0
								CALL SAMEN_SHOOT_SOURCE_MANAGEMENT, CHARA
							便器_客毎膣内射精回数 += 1
						ENDIF
					ENDIF
				ELSE
					BREAK
				ENDIF
			NEXT
			;本番のソースの残りを追加
			SOURCE:CHARA:정애 += 150 * 便器_客毎Ｖ回数
			SOURCE:CHARA:중독충족 += 150 * 便器_客毎Ｖ回数
			SOURCE:CHARA:노출 += 70 * 便器_客毎Ｖ回数
			SOURCE:CHARA:반감 += 300 * 便器_客毎Ｖ回数
			;セックス中毒を見る
			IF ABL:CHARA:섹스중독 == 1
				TIMES SOURCE:CHARA:중독충족 , 0.00
			ELSEIF ABL:CHARA:섹스중독 == 2
				TIMES SOURCE:CHARA:중독충족 , 0.30
			ELSEIF ABL:CHARA:섹스중독 == 3
				TIMES SOURCE:CHARA:중독충족 , 0.60
			ELSEIF ABL:CHARA:섹스중독 == 4
				TIMES SOURCE:CHARA:중독충족 , 0.90
			ELSEIF ABL:CHARA:섹스중독 == 5
				TIMES SOURCE:CHARA:중독충족 , 1.20
			ELSEIF ABL:CHARA:섹스중독 == 6
				TIMES SOURCE:CHARA:중독충족 , 1.50
			ELSEIF ABL:CHARA:섹스중독 == 7
				TIMES SOURCE:CHARA:중독충족 , 1.80
			ELSEIF ABL:CHARA:섹스중독 == 8
				TIMES SOURCE:CHARA:중독충족 , 2.30
			ELSEIF ABL:CHARA:섹스중독 == 9
				TIMES SOURCE:CHARA:중독충족 , 3.00
			ELSEIF ABL:CHARA:섹스중독 >= 10
				TIMES SOURCE:CHARA:중독충족 , 5.00
			ENDIF
			CALL SOURCE_MANAGEMENT_CHECK, CHARA
			CALL CUP_MANAGEMENT_T, CHARA
			IF 便器_客毎Ｖ回数
				便器_マネジメント数 += 1
				CALL 本番_便器_MANAGEMENT, CHARA
				便器_満足度 += RESULT
			ENDIF
			IF 便器_客毎膣内射精回数
				便器_マネジメント数 += 1
				CALL 中出し_便器_MANAGEMENT, CHARA
				便器_満足度 += RESULT
				DEBUGPRINTFORML 中出し満足度{RESULT}
				CFLAG:(ARG):자궁현재용량 += RESULT / 10
			ENDIF
		ENDIF
		;-----------------------------
		;Ａ
		;-----------------------------
		便器_客毎Ａ回数 = 0
		IF CFLAG:CHARA:개별성적서비스 & 32
			便器_誘惑度保存 = 便器誘惑度(CHARA, 便器_NTR客フラグ)
			CALL アナル_便器_MANAGEMENT_SOURCE, CHARA
			FOR DISPOSE, 0, 1 + (便器_誘惑度保存 + RAND:便器_誘惑度保存) / 20
				IF 便器_誘惑度保存 / 2 + RAND:便器_誘惑度保存 >= CFLAG:CHARA:애널가격 * (20 + 便器_客毎Ａ回数 * 30)
					CALL アナル_便器_MANAGEMENT_FOR, CHARA
					;キス経験処理：適当にランダムで
					SIF RAND:4 == 0
						TCVAR:CHARA:획득키스경험 += 1
					便器_客毎Ａ回数 += 1
				ELSE
					BREAK
				ENDIF
			NEXT
			;アナルのソースの残りを追加
			SOURCE:CHARA:정애 += 100 * 便器_客毎Ａ回数
			SOURCE:CHARA:중독충족 += 200 * 便器_客毎Ａ回数
			SOURCE:CHARA:노출 += 60 * 便器_客毎Ａ回数
			SOURCE:CHARA:일탈 += 200 * 便器_客毎Ａ回数
			SOURCE:CHARA:반감 += 500 * 便器_客毎Ａ回数
			;セックス中毒を見る
			IF ABL:CHARA:섹스중독 == 1
				TIMES SOURCE:CHARA:중독충족 , 0.00
			ELSEIF ABL:CHARA:섹스중독 == 2
				TIMES SOURCE:CHARA:중독충족 , 0.30
			ELSEIF ABL:CHARA:섹스중독 == 3
				TIMES SOURCE:CHARA:중독충족 , 0.60
			ELSEIF ABL:CHARA:섹스중독 == 4
				TIMES SOURCE:CHARA:중독충족 , 0.90
			ELSEIF ABL:CHARA:섹스중독 == 5
				TIMES SOURCE:CHARA:중독충족 , 1.20
			ELSEIF ABL:CHARA:섹스중독 == 6
				TIMES SOURCE:CHARA:중독충족 , 1.50
			ELSEIF ABL:CHARA:섹스중독 == 7
				TIMES SOURCE:CHARA:중독충족 , 1.80
			ELSEIF ABL:CHARA:섹스중독 == 8
				TIMES SOURCE:CHARA:중독충족 , 2.30
			ELSEIF ABL:CHARA:섹스중독 == 9
				TIMES SOURCE:CHARA:중독충족 , 3.00
			ELSEIF ABL:CHARA:섹스중독 >= 10
				TIMES SOURCE:CHARA:중독충족 , 5.00
			ENDIF
			CALL SOURCE_MANAGEMENT_CHECK, CHARA
			CALL CUP_MANAGEMENT_T, CHARA
			IF 便器_客毎Ａ回数
				便器_マネジメント数 += 1
				CALL アナル_便器_MANAGEMENT, CHARA
				便器_満足度 += RESULT
			ENDIF
		ENDIF

		SIF BASE:CHARA:체력 <= (CFLAG:CHARA:펠라횟수 * 10 + CFLAG:CHARA:본방횟수 * 15 + CFLAG:CHARA:애널횟수 * 25 + CFLAG:CHARA:질내사정횟수 * 5)
			BREAK

	NEXT
	;客毎の計算ここまで

	;-----------------------------
	;集計
	;-----------------------------
	;妊娠用
	IF CFLAG:CHARA:자궁내피임결계 == 0
		SIF TALENT:CHARA:남자 == 0
			CFLAG:CHARA:고객의질내사정에의한임신판정 += CFLAG:CHARA:질내사정횟수
		SIF TALENT:CHARA:남자 && TALENT:CHARA:오토코노코
			CFLAG:CHARA:고객의질내사정에의한임신판정 += CFLAG:CHARA:애널횟수
	ENDIF


	;使われた
	IF 便器_マネジメント数
		;成功度
		CFLAG:CHARA:노역성공도 = 便器_満足度 / 便器_マネジメント数
		便器_使われた便器数 += 1
		便器_成功度集計 += CFLAG:CHARA:노역성공도

		;メッセージ表示
		CALL WORK_MESSAGE_TOILET, CHARA

		PRINTFORML %CALLNAME:CHARA%의 노역 결과

		SIF CFLAG:CHARA:변기사용예정인수
			PRINTFORML 이용해 준 인원수：{CFLAG:CHARA:변기사용예정인수}명　　성공도　{CFLAG:CHARA:노역성공도}％

		CFLAG:CHARA:개별매상 += CFLAG:CHARA:펠라횟수 * CFLAG:CHARA:펠라가격
		CFLAG:CHARA:개별매상 += CFLAG:CHARA:본방횟수 * CFLAG:CHARA:본방가격
		CFLAG:CHARA:개별매상 += CFLAG:CHARA:애널횟수 * CFLAG:CHARA:애널가격
		CFLAG:CHARA:개별매상 += CFLAG:CHARA:질내사정횟수 * CFLAG:CHARA:질내사정가격

		;回数の表示
		IF FLAG:공중변소보고설정 < 2
			PRINTL
			SIF TCVAR:CHARA:획득키스경험
				PRINTFORM 키스　{TCVAR:CHARA:획득키스경험}회　　
			SIF CFLAG:CHARA:펠라횟수
				PRINTFORM 펠라　{CFLAG:CHARA:펠라횟수}회　　
			SIF CFLAG:CHARA:본방횟수
				PRINTFORM 본방　　{CFLAG:CHARA:본방횟수}회　　
			SIF CFLAG:CHARA:애널횟수
				PRINTFORM 애널　{CFLAG:CHARA:애널횟수}회　　
			SIF CFLAG:CHARA:질내사정횟수
				PRINTFORM 질내사정　{CFLAG:CHARA:질내사정횟수}회　　
			PRINTL
		ENDIF
		;---- EDIT 013 MOD START -------------------------
		;経験の増加
		CALL ADDS_EXP("변기경험", CFLAG:CHARA:변기사용예정인수, CHARA)
		CALL ADDS_EXP("펠라경험", CFLAG:CHARA:펠라횟수, CHARA)
		CALL ADDS_EXP("Ｖ경험", CFLAG:CHARA:본방횟수, CHARA)
