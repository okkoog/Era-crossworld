			SIF CFLAG:CHARA:변기사용예정인수
				PRINTFORM 변기경험 + {CFLAG:CHARA:변기사용예정인수}　　
			SIF TCVAR:CHARA:획득키스경험
				PRINTFORM 키스경험 + {TCVAR:CHARA:획득키스경험}　　
			SIF CFLAG:CHARA:펠라횟수
				PRINTFORM 펠라경험 + {CFLAG:CHARA:펠라횟수}　　
			SIF CFLAG:CHARA:본방횟수
				PRINTFORM Ｖ경험 + {CFLAG:CHARA:본방횟수}　　
			SIF CFLAG:CHARA:애널횟수
				PRINTFORM Ａ경험 + {CFLAG:CHARA:애널횟수}　　
		ENDIF

		IF CFLAG:CHARA:자궁내피임결계 == 0
			;EXP:CHARA:질사경험 += CFLAG:CHARA:질내사정횟수
			SIF CFLAG:CHARA:질내사정횟수 && FLAG:공중변소보고설정 < 2
				PRINTFORM 질사경험 + {CFLAG:CHARA:질내사정횟수}　　
			CALL ADDS_EXP("질사경험", CFLAG:CHARA:질내사정횟수, CHARA)

		ELSEIF CFLAG:CHARA:질내사정횟수 && FLAG:공중변소보고설정 < 2
			PRINTFORM <피임결계>
		ENDIF
		SIF !LINEISEMPTY()
			PRINTL 
		;---- EDIT 013 MOD START -------------------------
		CALL ADDS_EXP("성교경험", CFLAG:CHARA:애널횟수 + CFLAG:CHARA:본방횟수, CHARA)
		CALL ADDS_EXP("정액경험", CFLAG:CHARA:질내사정횟수 + CFLAG:CHARA:펠라횟수 + CFLAG:CHARA:본방횟수 + CFLAG:CHARA:애널횟수, CHARA)
		CALL ADDS_EXP("절정경험", EX:CHARA:0 + EX:CHARA:1 + EX:CHARA:2 + EX:CHARA:3, CHARA)
		;EXP:CHARA:키스경험 += TCVAR:CHARA:획득키스경험
		;TCVAR:CHARA:획득키스경험 = 0
		;EXP:CHARA:성교경험 += CFLAG:CHARA:애널횟수 + CFLAG:CHARA:본방횟수
		;EXP:CHARA:정액경험 += CFLAG:CHARA:질내사정횟수 + CFLAG:CHARA:펠라횟수 + CFLAG:CHARA:본방횟수 + CFLAG:CHARA:애널횟수
		;EXP:CHARA:절정경험 += EX:CHARA:0 + EX:CHARA:1 + EX:CHARA:2 + EX:CHARA:3
		;---- EDIT 013 MOD END ---------------------------
		;レズ、獣姦の場合はココに入る
		IF CFLAG:CHARA:14 == 1 && TALENT:CHARA:남자 == 0
			TCVAR:CHARA:획득레즈경험 += CFLAG:CHARA:애널횟수 + CFLAG:CHARA:본방횟수 + CFLAG:CHARA:펠라횟수
		ELSEIF CFLAG:CHARA:14 == 2
			;---- EDIT 013 MOD START -------------------------
			;;獣姦初体験の場合ここで異常経験付与
			;IF EXP:CHARA:수간경험 == 0
			;	CALL ADDS_ABNORMAL_EXP, "獣姦", CHARA
	;			CALL SHOW_ABNORMAL_EXP, CHARA
			;ENDIF
			TCVAR:CHARA:획득수간경험 += CFLAG:CHARA:애널횟수 + CFLAG:CHARA:본방횟수 + CFLAG:CHARA:펠라횟수
			;---- EDIT 013 MOD END ---------------------------
		ENDIF
		;レズ、獣姦フラグをリセット
		CFLAG:CHARA:14 = 0
		;---- EDIT 013 DEL START -------------------------
		;---- EDIT 012 ADD START -------------------------
		;EXP:CHARA:수간경험 += TCVAR:CHARA:획득수간경험
		;EXP:CHARA:레즈경험 += TCVAR:CHARA:획득레즈경험
		;---- EDIT 012 ADD END ---------------------------
		;---- EDIT 013 DEL END ---------------------------
		;---- EDIT 013 MOD START -------------------------
		;처녀/再生処女喪失時のメッセージ表示および異常経験加算
		IF CFLAG:CHARA:처녀상실플래그
			;CFLAG:CHARA:처녀상실플래그 = 0
			;TALENT:CHARA:처녀 = 0
			CALL ADDS_ABNORMAL_EXP, "処女喪失（便器）" , CHARA
	;		CALL SHOW_ABNORMAL_EXP, CHARA
		ENDIF
		;---- EDIT 013 MOD END ---------------------------
		SIF !LINEISEMPTY()
			PRINTL 

		IF FLAG:공중변소보고설정 < 2
			SIF CFLAG:CHARA:애널횟수 + CFLAG:CHARA:본방횟수
				PRINTFORM 성교경험 + {CFLAG:CHARA:애널횟수 + CFLAG:CHARA:본방횟수}　　
			SIF CFLAG:CHARA:질내사정횟수 + CFLAG:CHARA:펠라횟수 + CFLAG:CHARA:본방횟수 + CFLAG:CHARA:애널횟수
				PRINTFORM 정액경험 + {CFLAG:CHARA:질내사정횟수 + CFLAG:CHARA:펠라횟수 + CFLAG:CHARA:본방횟수 + CFLAG:CHARA:애널횟수}　　
			SIF EX:CHARA:0 + EX:CHARA:1 + EX:CHARA:2 + EX:CHARA:3
				PRINTFORM 절정경험 + {EX:CHARA:0 + EX:CHARA:1 + EX:CHARA:2 + EX:CHARA:3}
			SIF TCVAR:CHARA:획득레즈경험
				PRINTFORM 　레즈경험 + {TCVAR:CHARA:획득레즈경험}
			SIF TCVAR:CHARA:획득수간경험
				PRINTFORM 　수간경험 + {TCVAR:CHARA:획득수간경험}
			PRINTL
		ENDIF

		;珠の増加
		CALL JUEL_CHECK_TOILET, CHARA

		;처녀/再生処女を喪失した場合、処女価格を個別売り上げに加算
		SIF CFLAG:CHARA:처녀상실플래그 || CFLAG:CHARA:재생처녀상실플래그
			CFLAG:CHARA:개별매상 += CFLAG:CHARA:처녀가격
		;---- EDIT 013 ADD START -------------------------
		CFLAG:CHARA:처녀상실플래그 = 0
		CFLAG:CHARA:재생처녀상실플래그 = 0
		;---- EDIT 013 ADD END ---------------------------		
		;MAG増加処理
		便器_変動計算用 = CFLAG:CHARA:펠라횟수 * 2 + CFLAG:CHARA:본방횟수 / 2 + CFLAG:CHARA:애널횟수 * 4 + CFLAG:CHARA:질내사정횟수 * 6
		便器_変動計算用 *= MAXBASE:CHARA:LV / 5 + 1  
		便器_変動計算用 *= 1 + (CHARA == MASTER) + MAX(0, TALENT:CHARA:영매체질 * 9 - !TALENT:CHARA:비전투원 * 4)
		PRINTFORML ＭＡＧ + {便器_変動計算用}
		CALL CONTROL_MAG, CHARA, 便器_変動計算用

		;体力の消費
		便器_変動計算用 = CFLAG:CHARA:펠라횟수 * 10 + CFLAG:CHARA:본방횟수 * 15 + CFLAG:CHARA:애널횟수 * 25 + CFLAG:CHARA:질내사정횟수 * 5
		PRINTFORML 체력 - {便器_変動計算用}
		BASE:CHARA:체력 -= 便器_変動計算用

		;ストレス増加
		IF CHARA != MASTER
			便器_変動計算用 = CFLAG:CHARA:펠라횟수 + CFLAG:CHARA:본방횟수 * 2 + CFLAG:CHARA:애널횟수 * 2 + CFLAG:CHARA:질내사정횟수 * 5
			便器_変動計算用 *= MAX(0, 3  - 陥落(CHARA) * 2)
			便器_変動計算用 /= 1 + ABL:CHARA:순종 + ABL:CHARA:욕망 + ABL:CHARA:봉사정신 +  ABL:CHARA:마조끼
			CFLAG:CHARA:스트레스증가치 = 便器_変動計算用
			PRINTFORML 스트레스 + {便器_変動計算用}
			CFLAG:CHARA:스트레스치 += 便器_変動計算用
		ENDIF

		;非戦闘員は経験値獲得
		IF TALENT:CHARA:비전투원
			便器_変動計算用 = CFLAG:CHARA:개별매상 * (1 + BASE:CHARA:LV / 5)
			PRINTFORML EXP： +{便器_変動計算用}
			BASE:CHARA:ＥＸＰ += 便器_変動計算用
			;レベルアップ判定
			CALL CHECK_LEVEL_UP, CHARA
		ENDIF

		;ペルソナ使いは装着中のペルソナの経験値獲得
		IF TALENT:CHARA:페르소나구사자
			CALL INCREASE_PERSONA_EXP, CHARA, CFLAG:CHARA:개별매상 / 10, -1 ,1
			IF RESULT > 0
				;新ペルソナ処理
				IF BATTLE_SETTING_IS_PERSONA_NEW_FUNCTION()

				;旧ペルソナ処理
				ELSE
					PRINTFORML 페르소나【\@EQUIP:CHARA:장비페르소나 ? %CSVNAME(DITEMTYPE:(EQUIP:CHARA:장비페르소나):페르소나("NO"), 0)% # %CSVNAME(ABL:CHARA:초기페르소나, 0)%\@】　EXP：+{RESULT}
				ENDIF
			ENDIF
		ENDIF

		;人気増減
		IF CFLAG:CHARA:노역성공도 < 30
			PRINTFORML 인기 {CFLAG:CHARA:변기인기} - {6 - CFLAG:CHARA:노역성공도 / 5}
		ELSE
			PRINTFORML 인기 {CFLAG:CHARA:변기인기} + {CFLAG:CHARA:노역성공도 / 5 - 6}
		ENDIF

		CFLAG:CHARA:변기인기 += CFLAG:CHARA:노역성공도/5 - 6
		IF CFLAG:CHARA:인계횟수 && FLAG:게임모드 < 9 && DAY < 51
			PRINTFORML 인계 캐릭터：매출 × 0.01
			CFLAG:CHARA:개별매상 = MAX(CFLAG:CHARA:개별매상/100,1)
		ENDIF
		PRINTFORML 매출：{CFLAG:CHARA:개별매상}
		CALL 帳簿閲覧_労役, CHARA, CFLAG:CHARA:개별매상, CFLAG:CHARA:변기사용예정인수, 3

		便器_総売上 += CFLAG:CHARA:개별매상
		SIF CHARA == MASTER
			CALL EVENTCHECK_M

		CALL 公衆便所ＮＴＲ, CHARA
		;---- EDIT 013 MOD START -------------------------
		CALL SHOW_ADD_EXP, CHARA, "없음"
		;---- EDIT 013 MOD END ---------------------------
		CALL SHOW_ABNORMAL_EXP, CHARA
		CALL 気絶処理, CHARA
		SIF RESULT == 0
			PRINTW


	;使われなかった
	ELSE
		;成功度-1
		CFLAG:CHARA:노역성공도 = -1

		PRINTFORML %CALLNAME:CHARA%은(는) 아무에게도 이용되지 않았다.

		;客がつかなかった場合の
		;ソース
		便器_変動計算用 = MAX(1, CFLAG:CHARA:변기사용예정인수)
		SOURCE:CHARA:굴종 = 700 * 便器_変動計算用
		SOURCE:CHARA:노출 = 70 * 便器_変動計算用
		SOURCE:CHARA:일탈 = 200 * 便器_変動計算用
		SOURCE:CHARA:반감 = 200 * 便器_変動計算用 * (TALENT:CHARA:처녀 ? 3 # 1)
		CALL SOURCE_MANAGEMENT_CHECK, CHARA
		CALL CUP_MANAGEMENT_T, CHARA

		;珠の増加
		CALL JUEL_CHECK_TOILET, CHARA

		;ストレス増加
		IF CHARA != MASTER
			便器_変動計算用 = 2
			便器_変動計算用 *= MAX(0, 3  - 陥落(CHARA) * 2)
			便器_変動計算用 /= 1 + ABL:CHARA:순종 + ABL:CHARA:욕망 + ABL:CHARA:봉사정신 +  ABL:CHARA:마조끼
			CFLAG:CHARA:스트레스증가치 = 便器_変動計算用
			PRINTFORML 스트레스 + {便器_変動計算用}
			CFLAG:CHARA:스트레스치 += 便器_変動計算用
		ENDIF
	ENDIF

	;主人の属性値変動
	CALL INCREASE_LD, -3
	CALL SYNC_STATUS, MASTER

	DRAWLINE
NEXT
