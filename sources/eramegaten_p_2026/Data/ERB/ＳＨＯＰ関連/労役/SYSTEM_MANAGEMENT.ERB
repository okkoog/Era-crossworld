		C:0 = 1
		PRINTL [0]  - 변기 설치
		C:1 = 1
		PRINTL [1]  - 변기 설치 가능 수 확장
		C:2 = 1
		PRINTL [2]  - 점포 규모 확장
		C:3 = 1
		PRINTL [3]  - 기본 이용료 설정
		C:4 = 1
		PRINTL [4]  - 기본 이용 방법 설정
		C:5 = 1
		PRINTL [5]  - 광고를 낸다
		C:6 = 1
		PRINT [6]  - 현재 수지 보고 방법　-　
