		C:1 = 1
		PRINTL [1]  - 렌탈 악마
		C:2 = 1
		PRINTL [2]  - 시설 확장
		C:3 = 1
		PRINTL [3]  - 광고를 낸다
		C:4 = 1
		PRINTFORML [4]  - \@GETBIT(VAR_店舗リザルト,ARG) ? 상세 보고로 변경 # 간이 보고로 변경\@
		;#;C:5 = 1
