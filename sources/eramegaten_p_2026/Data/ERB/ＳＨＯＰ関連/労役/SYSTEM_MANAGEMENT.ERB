;========================================================
;配置キャラリスト
;========================================================
@MANAGEMENT_CHARALIST,ARG,ARG:1
#DIM LCOUNT
FOR LCOUNT, 0, リスト表示数()
	LOCAL = Q:(LCOUNT + P * リスト表示数())
	SIF LOCAL < 0
		CONTINUE
	SIF CFLAG:LOCAL:이자리에없는플래그 == 1
		CONTINUE
	SIF CFLAG:LOCAL:전투이외불능
		RETURN 0
	SIF ARG:1 == 0 && 접객인수(ARG) >= [[店舗:접객고용]]:ARG
		SETCOLOR 0x404040
	;色セット
	SIF CFLAG:LOCAL:노역플래그 == 10+ARG
		SETCOLOR 0x33ffcc
	CALL ARRANGE_TARGETSIGN, LOCAL
	CALL ARRANGE_CHARALIST, LOCAL
	CALL ARRANGE_CHARALIFE, LOCAL
	CALL ARRANGE_FALLTALENT, LOCAL
	CALL ARRANGE_SEX, LOCAL
	CALL PRINT_ALIGNMENT(LOCAL,1,0)
	;---- EDIT 006 MOD START -------------------------
	CALL 口上存在確認, LOCAL
	;CALL 口上呼び出し , "存在" , LOCAL
	;---- EDIT 006 MOD END ---------------------------
	IF RESULT == 1
		PRINT 　전
	ELSEIF RESULT == 2
		PRINT 　범
	ELSE
		PRINT 　―
	ENDIF
	;EDIT002 MOD START ------------------------------
	;SIF ARG:1 == 0 && 접객인수(ARG) >= [[店舗:접객고용]]:ARG
	SIF CFLAG:LOCAL:노역플래그 == 10+ARG
	;EDIT002 MOD END   ------------------------------
		PRINT 　○
	PRINTL
	RESETCOLOR
NEXT
PRINTL ○: 이 점포에서 노역 중인 캐릭터를 나타냅니다

RESETCOLOR

;========================================================
;店舗に出る条件
;========================================================
@WORKABLE(ARG,ARG:1)
#FUNCTION
SELECTCASE [[店舗:종류]]:ARG
	CASE 0
		RETURNF 1

	CASE 10
		;盟友だとできない
		SIF TALENT:(ARG:1):맹우
			RETURNF 0
		;縛り上げるだけなので、条件は無い
		RETURNF 1
	CASE 11
		;主人は無理をする
		SIF ARG:1 == MASTER
			RETURNF 1
		;信頼陥落はダメ
		SIF TALENT:(ARG:1):신뢰 || TALENT:(ARG:1):동료
			RETURNF 0
		;露出癖がないと無理
		SIF ABL:(ARG:1):노출증 <= 0
			RETURNF 0
		;売却可能じゃないと無理
		SIF CFLAG:(ARG:1):매각가능 == 0
			RETURNF 0
		RETURNF 1
	CASE 12
		;主人以外
		SIF ARG:1 == MASTER
			RETURNF 0
		;信頼陥落はダメ
		SIF TALENT:(ARG:1):신뢰 || TALENT:(ARG:1):동료
			RETURNF 0
		SIF IS_LOOKSLIKE_MALE(ARG:1) == 0
			RETURNF 1
		;オトコはヤる気がないとダメ
		SIF 陥落(ARG:1)
			RETURNF 1
	;教会
	CASE 13, 14, 15
		;信頼陥落はダメ
		SIF TALENT:(ARG:1):신뢰 || TALENT:(ARG:1):동료
			RETURNF 0
		;男はダメ
		SIF IS_MALE(ARG:1)
			RETURNF 0
		;陥落していないとダメ
		SIF 陥落(ARG:1) == 0
			RETURNF 0
		RETURNF 1

ENDSELECT
RETURNF 0



;===========================================================
;変数関係
;=========================================================
@店舗(ARGS,ARG)
#FUNCTION
LOCAL = 店舗項目(ARGS)
IF LOCAL < 0
	PRINTFORML 에러가 발생하여 0을 반환합니다. %ARGS%라는 항목은 없습니다
	RETURNF 0
ENDIF
RETURNF DE:LOCAL:ARG

@店舗演算(ARGS,ARG,ARG:1,ARGS:1)
LOCAL = 店舗項目(ARGS)
IF LOCAL < 0
	PRINTFORML 에러가 발생하여 0을 반환합니다. %ARGS%라는 항목은 없으므로 연산할 수 없습니다.
	RETURN 0
ENDIF
SELECTCASE ARGS:1
	CASE "="
		DE:LOCAL:ARG = ARG:1
	CASE "+"
		DE:LOCAL:ARG += ARG:1
	CASE "-"
		DE:LOCAL:ARG -= ARG:1
	CASE "*"
		DE:LOCAL:ARG *= ARG:1
	CASE "/"
		DE:LOCAL:ARG /= ARG:1
	CASE "%"
		DE:LOCAL:ARG %= ARG:1
ENDSELECT

@店舗項目(ARGS)
#FUNCTION
SIF LOCALS == ""
	SPLIT "종류_교복_상품_인기_선전효과_요리완성도_요리인기_규모_접객고용_ダミー_키친고용_ダミー_성적서비스_만지기가격_애무가격_펠라가격_본방가격_애널가격_질내사정가격_처녀가격_ダミー_ダミー_요리가격_술가격_음료가격_유지비_명칭_요리기대도_술기대도_음료기대도_성적기대도_교복스커트_교복속옷_교복가슴_교복음구_난교플래그_ダミー_ダミー_ダミー_ダミー_ダミー_ダミー_ダミー_ダミー_ダミー_ダミー_ダミー_선전플래그_役者１_役者２_役者３_役者４_役者５_役者６_役者７_役者８_役者９_役者１０_演目１_演目２_演目３_演目４_演目５_演目６_演目７_演目８_演目９_演目１０" , "_" , LOCALS
RETURNF FINDELEMENT(LOCALS , ARGS)


;===========================================================
; 한국어 호환 래퍼: @점포, @점포연산, @점포항목
;===========================================================
@점포(ARGS, ARG)
#FUNCTION
RETURNF 店舗(ARGS, ARG)

@점포연산(ARGS, ARG, ARG:1, ARGS:1)
CALL 店舗演算, ARGS, ARG, ARG:1, ARGS:1
RETURN RESULT

@점포항목(ARGS)
#FUNCTION
RETURNF 店舗項目(ARGS)
