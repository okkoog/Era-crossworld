;========================================================
;店舗情報
;========================================================
@SHOW_STATUS_MANAGEMENT,ARG
;１行目に名前
PRINTFORM %SAVESTR:(20+ARG),20,LEFT%
SELECTCASE 店舗("종류", ARG)
	CASE 10
		PRINTFORML 　점포 종류: 공중변소
		;3行目には規模と雇用人数
		PRINTFORML 최대 이용자 수/일:{店舗("규모",ARG),4}명　변기 설치 수：{접객인수(ARG),2}/{店舗("접객고용",ARG),2}개
		;4行目には人気と宣伝効果
		PRINTFORML 인기　　　　　 :{店舗("인기",ARG),5} 　　홍보 효과：{店舗("선전효과",ARG),5}　　\@ 看板便器(ARG) > -1 ? 간판 변기:%CALLNAME:看板便器(ARG)% # \@
		;5行目には維持費
		;※変更点ここから※
		SIF [[店舗:선전플래그]]:ARG == 0
			PRINTFORML 현재 선전 매체: 없음
		SIF [[店舗:선전플래그]]:ARG == 1
			PRINTFORML 현재 선전 매체: 전단지 배포
		SIF [[店舗:선전플래그]]:ARG == 2
			PRINTFORML 현재 선전 매체: 라디오 광고
		SIF [[店舗:선전플래그]]:ARG == 3
			PRINTFORML 현재 선전 매체: 패러다임 X
		SIF [[店舗:선전플래그]]:ARG == 4
			PRINTFORML 현재 선전 매체: 비행선 선전
		SIF [[店舗:선전플래그]]:ARG >= 1000000
			PRINTFORML 현재 선전 매체: 대대적인 선전　비용: {[[店舗:선전플래그]]:ARG}
		;※変更点ここまで※
		PRINTFORML 하루 유지비: ￥{ 500 + 店舗("규모",ARG) * 50 + 접객인수(ARG) * 200}
		PRINTL
		;6行目には基本の価格
		PRINTL 【상품 기본 가격】
		PRINTFORML 펠라치오:{店舗("펠라가격",ARG),3} 마카　　　본방:{店舗("본방가격",ARG),3} 마카　　　애널:{店舗("애널가격",ARG),3} 마카　　　질내사정:{店舗("질내사정가격",ARG),3} 마카
	CASE 11
		PRINTFORML 　점포 종류: 스트립 극장
		PRINTFORML 최대 집객 수/일:{店舗("규모",ARG) * 100,4}명　최대 배우 수：{店舗("규모",ARG),2}명
		PRINTFORML 선전 효과: {店舗("선전효과",ARG),5}　하루 유지비: ￥{店舗("규모",ARG) * 500}
	CASE 12
		PRINTFORML 　점포 종류: 구경거리 천막
		PRINTFORML 노예 배치 가능 수: {店舗("규모",ARG),2}명 + 렌탈 10체
		PRINTFORML 선전 효과: {店舗("선전효과",ARG),5}　하루 유지비: ￥{SHOW_TENT_維持費(ARG)}\@ SHOW_TENT_RENTAL_COST(ARG) ? + 렌탈료 {SHOW_TENT_RENTAL_COST(ARG)} 마카 # \@
	;教会
	CASE 13
		PRINTFORML 　점포 종류: 메시아 교단
		PRINTFORML 상주 인원수：{접객인수(ARG),2}/{店舗("접객고용",ARG),2}명
	CASE 14
		PRINTFORML 　점포 종류: 가이아 교단
		PRINTFORML 상주 인원수：{접객인수(ARG),2}/{店舗("접객고용",ARG),2}명
	CASE 15
		PRINTFORML 　점포 종류: 교회
		PRINTFORML 상주 인원수：{접객인수(ARG),2}/{店舗("접객고용",ARG),2}명
	;
ENDSELECT
CUSTOMDRAWLINE ･

