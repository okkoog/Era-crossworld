	RETURNF [[キャラ:슬라임]]
CASE -3
	RETURNF [[キャラ:오크]]
CASE -4
	RETURNF [[キャラ:이누가미]]
CASE -5
	RETURNF [[キャラ:바포멧트]]
CASE -6
	RETURNF [[キャラ:케르베로스]]
CASEELSE
	RETURNF -1
ENDSELECT

