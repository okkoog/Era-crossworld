		SIF L_CHARA >= 0 && IS_LOOKSLIKE_MALE(L_CHARA)
			RETURNF 0
		RETURNF 10
	CASE "魔尻"
		SIF L_CHARA >= 0 && IS_LOOKSLIKE_MALE(L_CHARA)
			RETURNF 0
		RETURNF 10
;特殊
	CASE "흡혈귀"
		RETURNF 10
	CASE "동물귀"
		RETURNF 10
	CASE "소인체형"
		RETURNF 10
	CASE "인기"
		RETURNF 30
;迷ったけどコメントアウト。性的素質は乱交ライブで頑張ってもらおう
;	CASE "임신"
;		RETURNF 30
;	CASE "모성"
;		RETURNF 60
ENDSELECT

