@PRINT_CONCERT_PRICE_BY_ABL, L_CHARA, L_MODE = "PRINT"
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC TEMP_VAR
#DIM DYNAMIC SUM_PRICE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_MODE
FOR LCOUNT, 0, TRAINABLNUM
	TEMP_VAR = GET_CONCERT_PRICE_BY_ABL(LCOUNT, , L_CHARA)
	SIF !TEMP_VAR
		CONTINUE
	SUM_PRICE += TEMP_VAR
	IF L_MODE != "NOPRINT"
		PRINTFORM 　%ABLNAME:LCOUNT,12,LEFT%
		PRINTFORM {ABL:L_CHARA:LCOUNT, 3}Lv
		PRINTFORM %" "%
		IF TEMP_VAR > 0
			PRINT ＋
		ELSE
			PRINT －
		ENDIF
		PRINTFORML {ABS(TEMP_VAR), 3}％
	ENDIF
NEXT
RETURN SUM_PRICE

@PRINT_CONCERT_PRICE_BY_TALENT, L_CHARA, L_MODE = "PRINT"
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC TEMP_VAR
#DIM DYNAMIC SUM_PRICE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_MODE
FOR LCOUNT, 0, TRAINTALENTNUM
	TEMP_VAR = GET_CONCERT_PRICE_BY_TALENT(LCOUNT, L_CHARA)
	SIF !TEMP_VAR
		CONTINUE
	SUM_PRICE += TEMP_VAR
	IF L_MODE != "NOPRINT"
		PRINTFORM 　%TALENTNAME:LCOUNT, 18, LEFT%
		IF TEMP_VAR > 0
			PRINT ＋
		ELSE
			PRINT －
		ENDIF
		PRINTFORML {ABS(TEMP_VAR),3}％
	ENDIF
NEXT
RETURN SUM_PRICE