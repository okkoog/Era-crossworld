@NTR_CONCERT_SEX, 対象, 人数
#DIM 対象
#DIM 人数

LOCAL:1 = 2 + RAND:3
PRINTFORML Ｖ경험 ＋{LOCAL:1 * 人数}
EXP:対象:Ｖ경험 += LOCAL:1 * 人数
PRINTFORML Ａ경험 ＋{(LOCAL:1 / 2) * 人数}
EXP:対象:Ａ경험 += (LOCAL:1 / 2) * 人数
PRINTFORML 키스경험 ＋{LOCAL:1 * 人数}
EXP:対象:키스경험 += LOCAL:1 * 人数
PRINTFORML 성교경험 ＋{(LOCAL:1 + LOCAL:1 / 2) * 人数}
EXP:対象:성교경험 += (LOCAL:1 + LOCAL:1 / 2) * 人数
PRINTFORML 절정경험 ＋{((LOCAL:1 + LOCAL:1 / 2) / 3) * 人数}
EXP:対象:절정경험 += ((LOCAL:1 + LOCAL:1 / 2) / 3) * 人数
PRINTFORML 질사경험 ＋{LOCAL:1 * 人数}
EXP:対象:질사경험 += LOCAL:1 * 人数
PRINTFORML 펠라경험 ＋{(LOCAL:1 / 2) * 人数}
EXP:対象:펠라경험 += (LOCAL:1 / 2) * 人数
PRINTFORMW 정액경험 ＋{(LOCAL:1 * 2) * 人数}
EXP:対象:정액경험 += (LOCAL:1 * 2) * 人数
IF 人数 == 5
	PRINTFORMW 피사경험 ＋{(LOCAL:1 * 2)}
	EXP:対象:피사경험 += (LOCAL:1 * 2)
ENDIF
PRINTFORML 

;처녀/再生処女喪失
IF TALENT:対象:처녀
	CALL ADDS_ABNORMAL_EXP, "処女喪失（強姦）", 対象
	CALL 처녀상실, 対象
ENDIF

CDFLAG:対象:캐릭터간호감도:(100+FAVORITE_1_ID(対象)) += CDFLAG:対象:캐릭터간호감도:(86)
