;CONSERT.ERB　コンサートを開いてチケットなどを売る労役コマンド
;奴隷の歌唱力だけでなく、奴隷の能力が高いとフェロモンで売り上げが上がる
;やはり、基本的には厳しい

;コンサート条件
@CASTING_CONCERT(ARG)
#DIM 実行可能カウント
実行可能カウント = 0
SIF TALENT:ARG:반역
	RETURN 0
SIF CFLAG:ARG:이자리에없는플래그 == 1
	RETURN 0
SIF CFLAG:ARG:전투이외불능
	RETURN 0
	
;あなた以外は隷属以外の陥落が必要
IF ARG != MASTER 
	SIF !(TALENT:ARG:연모 || TALENT:ARG:친애 || TALENT:ARG:음란 || TALENT:ARG:창부 || TALENT:ARG:신뢰 || TALENT:ARG:동료)
		RETURN 0
	
	;以下実行判定
	IF ABL:ARG:가창기능 > 4
		実行可能カウント += 3
	ELSEIF ABL:ARG:가창기능 > 2
		実行可能カウント += 2
	ELSEIF ABL:ARG:가창기능 > 0
		実行可能カウント += 1
	ENDIF
	
	IF EXP:ARG:가창경험 > 199
		実行可能カウント += 3
	ELSEIF EXP:ARG:가창경험 > 99
		実行可能カウント += 2
	ELSEIF EXP:ARG:가창경험 > 49
		実行可能カウント += 1
	ENDIF
	
	IF EXP:ARG:라이브경험 > 99
		実行可能カウント += 3
	ELSEIF EXP:ARG:라이브경험 > 49
		実行可能カウント += 2
	ELSEIF EXP:ARG:라이브경험 > 19
		実行可能カウント += 1
	ENDIF
	
	SIF TALENT:ARG:습득빠름
		実行可能カウント += 1
	SIF TALENT:ARG:눈에띄고싶어함
		実行可能カウント += 1
	SIF TALENT:ARG:프라이드높음
		実行可能カウント += 1
	SIF TALENT:ARG:매력
		実行可能カウント += 2
	SIF TALENT:ARG:인기
		実行可能カウント += 2
	
	;信頼陥落は優遇（調教できないので）
	SIF TALENT:ARG:신뢰
		実行可能カウント += 1
	SIF TALENT:ARG:동료
		実行可能カウント += 2
	SIF TALENT:ARG:맹우
		実行可能カウント += 1
	
	;技巧はおおざっぱに
	SIF ABL:ARG:기교 > 2
		実行可能カウント += 1
	;露出癖もおおざっぱに
	SIF ABL:ARG:노출증 > 2
		実行可能カウント += 1
	
	;実行可能カウントが5以上で可能
	SIF 実行可能カウント < 5
		RETURN 0
ENDIF
SIF BASE:ARG:체력 < 500
	RETURN 0
RETURN 1

