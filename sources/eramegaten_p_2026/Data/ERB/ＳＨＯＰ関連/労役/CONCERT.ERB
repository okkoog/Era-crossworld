S = 0
V = 0
C = 0
D = 0
G = 0

;コンサートで歌う奴隷を選択
;CALL INPUT_CHARA_LIST("コンサートで歌う奴隷を選択してください", "CASTING_CONCERT")
{
CALL INPUT_CHARA_LIST
	, "PROPSET_CONCERT"
	, "콘서트에서 노래할 노예를 선택해주세요"
	, "CASTING_CONCERT" 
	, "CONCERT_UP_FUNCTION"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
IF RESULT == 1000
	;---- EDIT P 001 MOD START -------------------------
	;SIF FLAG:휴식플래그 == 1
	IF コンサート実行日 == DAY
		FLAG:조교실행완료횟수++
		RETURN 1
	ENDIF
	RETURN 0
	;---- EDIT P 001 MOD END ---------------------------
ENDIF
対象 = RESULT
;FLAG:조교실행완료횟수++
PRINTL 【기본값산출】
;奴隷の歌唱技能と歌唱経験のレベルによって値段の基礎値が上昇
IF ABL:対象:가창기능 == 0
	S += 0
ELSEIF ABL:対象:가창기능 == 1
	S += 60
ELSEIF ABL:対象:가창기능 == 2
	S += 100
ELSEIF ABL:対象:가창기능 == 3
	S += 150
ELSEIF ABL:対象:가창기능 == 4
	S += 210
ELSEIF ABL:対象:가창기능 == 5
	S += 280
ELSEIF ABL:対象:가창기능 == 6
	S += 360
ELSEIF ABL:対象:가창기능 == 7
	S += 450
ELSEIF ABL:対象:가창기능 == 8
	S += 550
ELSEIF ABL:対象:가창기능 == 9
	S += 660
ELSE
	S += 780
ENDIF
SIF S
	PRINTFORML 　%ABLNAME:14%{ABL:対象:가창기능}LV ＋ {S}

IF EXP:対象:가창경험 < 25
	D += 1
ELSEIF EXP:対象:가창경험 < 50
	D += 20
ELSEIF EXP:対象:가창경험 < 75
	D += 80
ELSEIF EXP:対象:가창경험 < 150
	D += 160
ELSEIF EXP:対象:가창경험 < 250
	D += 250
ELSE
	D += 400
ENDIF
PRINTFORML 　%EXPNAME:64%{EXP:対象:가창경험} ＋{D}

;ライブ経験はx2したのち加算。250（500）で頭打ちに
IF EXP:対象:라이브경험 < 250
	D += EXP:対象:라이브경험 * 2
	PRINTFORML 　%EXPNAME:74%{EXP:対象:라이브경험} ＋ {EXP:対象:라이브경험 * 2}
ELSE
	D += 500
	PRINTFORML 　%EXPNAME:74%{EXP:対象:라이브경험} ＋ 500
ENDIF

SETCOLOR 0x33ffcc
PRINTFORML 기초치：{S+D}p
RESETCOLOR

PRINTL

S += D

PRINTL 【배율 산출】
V = 100
CALL PRINT_CONCERT_PRICE_BY_ABL, 対象
V += RESULT
CALL PRINT_CONCERT_PRICE_BY_TALENT, 対象
V += RESULT

