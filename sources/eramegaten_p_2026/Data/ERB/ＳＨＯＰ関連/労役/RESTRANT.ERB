;==========================================================
@CORRECT_DIFFICULTY, ARG, ARG:1 = 0
#LOCALSIZE 1
LOCAL = ARG
;EASY
IF FLAG:조교난이도 == 1
	SIF ARG:1
		PRINTFORML 난이도:EASY ×120％
	TIMES LOCAL , 1.20
;NORMAL
ELSEIF FLAG:조교난이도 == 2
	TIMES LOCAL , 1.00
;HARD
ELSEIF FLAG:조교난이도 == 3
	SIF ARG:1
		PRINTFORML 난이도:HARD ×80％
