;
;==========================================================
;@MANAGEMENT_STRIP_THEATER
; ストリップ劇場の一日の活動報告処理
;<引数>
;	ARG - 店舗番号
;<戻り値>
;	なし
;==========================================================
@MANAGEMENT_STRIP_THEATER,ARG
#LOCALSIZE 5
#DIM GUEST, 1
#DIM ACTOR, 1
#DIM DIFFICULTY, 1
#DIM ACT, 10
#DIM REWARD,1
#DIM EXCITE, 1
#DIM SUCCESS, 1
#DIM PLAY_TOTAL, 1
#DIM LCOUNT
;変数の初期化
VARSET ACT, -1
VARSET LOCAL, 0
;LOCAL:12 = 0
GUEST = 0
;LOCAL:3 = 0
;FOR LCOUNT, 0, CHARANUM
;演者のリスト作成 及び　基本の観客数の設定
FOR LOCAL, 0 , CHARANUM
	IF CFLAG:LOCAL:노역점포 == ARG+1
		SIF CFLAG:LOCAL:이자리에없는플래그
			CONTINUE
		SIF CFLAG:LOCAL:전투이외불능
			CONTINUE
		ACT:(CFLAG:LOCAL:극장출연순서-1) = LOCAL
		;基本観客数
		GUEST += CFLAG:LOCAL:극장인기/20 + 1
	ENDIF
NEXT
;演者がいない場合はここで終了
IF MATCH(ACT, -1) == 10
	PRINTFORML 
	PRINTFORML 오늘은 휴연입니다
	PRINTFORML 유지비 ￥{店舗("규모",ARG) * 500}
	MONEY -= 店舗("규모",ARG) * 500
	PRINTL 
	RETURN 0
ENDIF
;NEXT
;IF ACTOR_TOTAL > 0
GUEST /= 10
;客数の範囲は10～규모*100
GUEST = LIMIT(GUEST, 10, 店舗("규모",ARG) * 100)
;SIF GUEST <= 10
;	GUEST = 10
;SIF GUEST >= 店舗("규모",ARG) * 100
;	GUEST = 店舗("규모",ARG) * 100
;ENDIF
;客興奮度
EXCITE = 10
;おひねり金額
REWARD = 0
FOR LOCAL, 0, 店舗("규모",ARG)
	;一応異常値は蹴る
	SIF ACT:LOCAL < 0
		CONTINUE
	;現在の演者を設定
	ACTOR = ACT:LOCAL
	SKIPDISP GETBIT(FLAG:스트립극장보고설정, ARG)
	PRINTL
	DRAWLINE
	PRINTFORM 　상연종목 {LOCAL+1}　%CALLNAME:ACTOR% 관객 {GUEST}명
	PRINTFORML
	;----------------------------
	;メッセージの表示
	;----------------------------
	LOCAL:1 = TARGET
	TARGET = ACTOR
	TFLAG:13 = 43
	CALL EVENT_MESSAGE_STRIP, ARG , GUEST
	CALL KOJO_MESSAGE_EVENT
	SKIPDISP GETBIT(FLAG:스트립극장보고설정, ARG)
	TARGET = LOCAL:1
	;-------------------------
	;難易度設定
	;-------------------------
	;基本値
	;ストリップ
	IF CFLAG:ACTOR:극장상연목록 == 0
		DIFFICULTY = 12
	;ポールダンス
	ELSEIF CFLAG:ACTOR:극장상연목록 == 1
		DIFFICULTY = 18
	;オナニーショー
	ELSE
		DIFFICULTY = 24
	ENDIF
	;ABLによる難易度修正
	DIFFICULTY -= ABL:ACTOR:욕망
	DIFFICULTY -= ABL:ACTOR:노출증
	DIFFICULTY -= ABL:ACTOR:마조끼
	;TALENTによる難易度修正
	SIF TALENT:ACTOR:연모
		DIFFICULTY += 2
	SIF TALENT:ACTOR:음란
		DIFFICULTY -= 2
	SIF TALENT:ACTOR:복종
		DIFFICULTY -= 1
	SIF TALENT:ACTOR:친애
		DIFFICULTY += 4
	SIF TALENT:ACTOR:창부
		DIFFICULTY -= 4
	SIF TALENT:ACTOR:예속
		DIFFICULTY -= 2
	SIF TALENT:ACTOR:붕괴
		DIFFICULTY += 10
	SIF TALENT:ACTOR:프라이드높음
		DIFFICULTY += 1
	SIF TALENT:ACTOR:프라이드낮음
		DIFFICULTY -= 1
	SIF TALENT:ACTOR:보수적
		DIFFICULTY += 1
	SIF TALENT:ACTOR:호기심
		DIFFICULTY -= 1
	SIF TALENT:ACTOR:일선을넘지않음
		DIFFICULTY += 2
	SIF TALENT:ACTOR:눈에띄고싶어함
		DIFFICULTY -= 1
	SIF TALENT:ACTOR:정조관념
		DIFFICULTY += 2
	SIF TALENT:ACTOR:정조관결여
		DIFFICULTY -= 2
	SIF TALENT:ACTOR:부끄럼쟁이
		DIFFICULTY += 1
	SIF TALENT:ACTOR:부끄럼없음
		DIFFICULTY -= 1
	SIF DIFFICULTY < 0
		DIFFICULTY = 0
	;-------------------------
	;成功判定
	;最大10回判定で、失敗あるいは大失敗が出るまで連続して試行(回数はPLAY_TOTALに取得)
	;試行中は客の興奮度(EXCITE)/人数(GUEST)/報酬(REWARD)が変動する
	;また、演目の成功度をSUCCESSに取得する
	;-------------------------
	;上演回数
	PLAY_TOTAL = 0
	;成功度
	SUCCESS = 0
	DRAWLINE
	DO
		PLAY_TOTAL++
		;成功判定Ａ
		LOCAL:1 = RAND:6 + 1
		;成功判定Ｂ
		LOCAL:2 = RAND:6 + 1
		PRINTFORML 성공 판정 {PLAY_TOTAL}회차　관객 {GUEST}명
		PRINTFORM 난이도:{DIFFICULTY} 판정:{LOCAL:1} + {LOCAL:2}
		IF LOCAL:1 + LOCAL:2 == 12  || LOCAL:1 + LOCAL:2 - DIFFICULTY >= 5
			PRINTL 　<<대성공>>
			GUEST += RAND:5 + 16
			SIF GUEST >= 店舗("규모",ARG) * 100
				GUEST = 店舗("규모",ARG) * 100
			EXCITE += RAND:30
			SIF EXCITE >=  100
				EXCITE =  100
			SUCCESS += RAND:10+1
			IF CFLAG:ACTOR:인계횟수 && FLAG:게임모드 < 9 && DAY < 51
				REWARD += MAX(0,RAND:(GUEST*EXCITE*LIMIT(CFLAG:ACTOR:극장인기/20+100, 100, 500)/(10000 * 店舗("규모",ARG))+1)/100)
			ELSE
				REWARD += RAND:(GUEST*EXCITE*LIMIT(CFLAG:ACTOR:극장인기/20+100, 100, 500)/(10000 * 店舗("규모",ARG))+1)
			ENDIF
		ELSEIF LOCAL:1 + LOCAL:2 == 2  || LOCAL:1 + LOCAL:2 - DIFFICULTY <= -5
			PRINTL 　<<대실패>>
			GUEST -= RAND:5 + 6
			SIF GUEST <= 0
				GUEST = 1
			EXCITE -= RAND:20
			SIF EXCITE <= 0
				EXCITE = 1
			SUCCESS -= RAND:5+1
			BREAK
		ELSEIF LOCAL:1 + LOCAL:2 - DIFFICULTY >= 0
			PRINTL 　<<성공>>
			GUEST += RAND:10 + 1
			SIF GUEST >= 店舗("규모",ARG) * 100
				GUEST = 店舗("규모",ARG) * 100
			EXCITE += RAND:20
			SIF EXCITE >=  100
				EXCITE =  100
			SUCCESS += RAND:5+1
			IF CFLAG:ACTOR:인계횟수 && FLAG:게임모드 < 9 && DAY < 51
				REWARD += MAX(0,RAND:(GUEST*EXCITE*LIMIT(CFLAG:ACTOR:극장인기/40+50, 50, 250)/(10000 * 店舗("규모",ARG))+1)/100)
			ELSE
				REWARD += RAND:(GUEST*EXCITE*LIMIT(CFLAG:ACTOR:극장인기/40+50, 50, 250)/(10000 * 店舗("규모",ARG))+1)
			ENDIF
		ELSE
			PRINTL 　<<실패>>
			GUEST -= RAND:5 + 1
			SIF GUEST <= 0
				GUEST = 1
			EXCITE -= RAND:10
			SIF EXCITE <= 0
				EXCITE = 1
			SUCCESS -= RAND:3+1
			BREAK
		ENDIF
		DIFFICULTY ++
	LOOP PLAY_TOTAL < 10

	CALL 帳簿閲覧_労役, ACTOR, GUEST, 0, 5

;	IF FLAG:스트립극장보고설정
;		NOSKIP
;			PRINTFORML 상연종목[{LOCAL+1}] %CALLNAME:ACTOR,16, LEFT% 관객:{GUEST,3}명 체력({BASE:ACTOR:체력,5} - {LOCAL:3 * (100 + PLAY_TOTAL), 4} = {BASE:ACTOR:체력-LOCAL:3 * (100 + PLAY_TOTAL), 5})
;		ENDNOSKIP
;	ENDIF
	;----------------------------
	;体力の消費とストレスの加算
	;LOCAL:3は否定の珠の加算にも用いる
	;上演回数(PLAY_TOTAL)に比例する
	;----------------------------
	DRAWLINE
	;ストリップ
	IF CFLAG:ACTOR:극장상연목록 == 0
		LOCAL:3 = 3
	;ポールダンス
	ELSEIF CFLAG:ACTOR:극장상연목록 == 1
		LOCAL:3 = 5
	;オナニーショー
	ELSE
		LOCAL:3 = 7
	ENDIF
	PRINTFORML 체력　　　　　{BASE:ACTOR:체력,10}   - {LOCAL:3 * (100 + PLAY_TOTAL), 6}    = {BASE:ACTOR:체력-LOCAL:3 * (100 + PLAY_TOTAL), 10}
	BASE:ACTOR:체력 -= LOCAL:3 * (100 + PLAY_TOTAL)
	IF ACTOR != MASTER
		PRINTFORML 스트레스　　　{CFLAG:ACTOR:스트레스치,10}   + {LOCAL:3, 6}    = {CFLAG:ACTOR:스트레스치+LOCAL:3, 10}
		CFLAG:ACTOR:스트레스치 += LOCAL:3
	ENDIF

	IF FLAG:스트립극장보고설정
		NOSKIP
			PRINTFORML 상연종목[{LOCAL+1}] %CALLNAME:ACTOR,16, LEFT% 관객:{GUEST,3}명 체력({BASE:ACTOR:체력,5} - {LOCAL:3 * (100 + PLAY_TOTAL), 4} = {BASE:ACTOR:체력-LOCAL:3 * (100 + PLAY_TOTAL), 5})
		ENDNOSKIP
	ENDIF

	;------------------------------
	;経験と球追加
	;PLAY_TOTAL 上演回数
	;EXCITE 客の興奮度
	;GUEST 客の人数
	;LOCAL:1 欲情の珠獲得数
	;LOCAL:2 恥情の珠獲得数
	;------------------------------
	PRINTFORML 야외노출경험　{EXP:ACTOR:야외노출경험,10}   + {PLAY_TOTAL,6}    = {EXP:ACTOR:야외노출경험+PLAY_TOTAL,10}
;	TCVAR:ACTOR:획득야외노출경험
	EXP:ACTOR:야외노출경험 += PLAY_TOTAL
	IF CFLAG:ACTOR:극장상연목록 == 2
		PRINTFORML 자위경험　　　{EXP:ACTOR:자위경험,10}   + {PLAY_TOTAL,6}    = {EXP:ACTOR:자위경험+PLAY_TOTAL,10}
;		TCVAR:ACTOR:획득자위경험
		EXP:ACTOR:자위경험 += PLAY_TOTAL
	ENDIF
	SELECTCASE CFLAG:ACTOR:극장상연목록
		CASE 0
			LOCAL:1 = GUEST*(PLAY_TOTAL)*ABL:ACTOR:욕망*(100+EXCITE)/100
			LOCAL:2 = GUEST*(PLAY_TOTAL)*ABL:ACTOR:노출증*(100+EXCITE)/100
		CASE 1
			LOCAL:1 = GUEST*(PLAY_TOTAL)*ABL:ACTOR:욕망*2*(100+EXCITE)/100
			LOCAL:2 = GUEST*(PLAY_TOTAL)*ABL:ACTOR:노출증*2*(100+EXCITE)/100
		CASE 2
			LOCAL:1 = GUEST*(PLAY_TOTAL)*ABL:ACTOR:욕망*3/2*(100+EXCITE)/100
			LOCAL:2 = GUEST*(PLAY_TOTAL)*ABL:ACTOR:노출증*3/2*(100+EXCITE)/100
	ENDSELECT
	PRINTFORML 욕정의 구슬　　{JUEL:ACTOR:욕정,10}   + {LOCAL:1,6}    = {JUEL:ACTOR:욕정+LOCAL:1,10}
	PRINTFORML 수치의 구슬　　{JUEL:ACTOR:치정,10}   + {LOCAL:2,6}    = {JUEL:ACTOR:치정+LOCAL:2,10}
	JUEL:ACTOR:욕정 += LOCAL:1
	JUEL:ACTOR:치정 += LOCAL:2
	IF ACTOR != MASTER && GUEST*LOCAL:3/MAX(ABL:ACTOR:노출증, 1)
		PRINTFORML 부정의 구슬　　{JUEL:ACTOR:100,10}   + {GUEST*LOCAL:3/MAX(ABL:ACTOR:노출증, 1),6}    = {JUEL:ACTOR:100+GUEST*LOCAL:3/MAX(ABL:ACTOR:노출증, 1),10}
		JUEL:ACTOR:100 += GUEST*LOCAL:3/MAX(ABL:ACTOR:노출증, 1)
	ENDIF
	PRINTFORMW 극장인기　　　{CFLAG:ACTOR:극장인기, 10}   \@SUCCESS >=0 ? + # - \@ {ABS(SUCCESS), 6}    = {CFLAG:ACTOR:극장인기+SUCCESS, 10}
	CFLAG:ACTOR:극장인기 += SUCCESS
	;経験と球追加ここまで
;	CALL SHOW_ADD_EXP, ACTOR

;ＮＴＲ進行
	IF GETBIT(FLAG:ＮＴＲ기능 , 5)
	;전속노예의목걸이
	;→22/06/07：同効果の服を増やして関数にしたので修正
		IF IS_ANTI_NTR_CLOTHES(ACTOR) == 1
			GOTO SKIP_NTR
		ENDIF
		v = 0
		SIF TALENT:ACTOR:ＮＴＲ == 2
			x = 30
		SIF CFLAG:ACTOR:현ＮＴＲ진행도 > 10
			x = 30
		SIF TALENT:ACTOR:겁쟁이 || TALENT:ACTOR:얌전함 || TALENT:ACTOR:거유 || TALENT:ACTOR:폭유
			z += 10
		SIF TALENT:ACTOR:인기
			z += 10
		y = CFLAG:ACTOR:방치일수
		SIF y > 20
			y = 20
		SIF IS_ANTI_NTR_CLOTHES(ACTOR) == -1
			PRINTFORMW %CALLNAME:ACTOR%은(는) 뭐라 말할 수 없는 달콤한 향기를 풍기고 있다……

		IF RAND:2 == 0
			CDFLAG:ACTOR:캐릭터간호감도:(89) +=(ABL:ACTOR:욕망 + ABL:ACTOR:노출증 + ABL:ACTOR:섹스중독 + ABL:ACTOR:자위중독) * (2-CFLAG:ACTOR:신경썼다플래그) + CFLAG:ACTOR:방치일수*10
		ELSE
			CDFLAG:ACTOR:캐릭터간호감도:(88) -=(ABL:ACTOR:욕망 + ABL:ACTOR:노출증 + ABL:ACTOR:섹스중독 + ABL:ACTOR:자위중독) * (2-CFLAG:ACTOR:신경썼다플래그) + CFLAG:ACTOR:방치일수*10
		ENDIF
		CFLAG:ACTOR:음란도 += GUEST / 2
		IF RAND:100 < 10 + y + x || RAND:100 < x || IS_ANTI_NTR_CLOTHES(ACTOR) == -1 || TALENT:ACTOR:즉각함락 == 1
			IF TALENT:ACTOR:ＮＴＲ == 2
				PRINTFORML %CALLNAME:ACTOR%은(는) 양아치들에게 말을 걸렸다……
			ELSE
				PRINTFORML %CALLNAME:ACTOR%은(는) 극장의 팬에게 말을 걸렸다……	
			ENDIF
			PRINTFORML ・
			PRINTFORML ・・
			PRINTFORMW ・・・

			IF RAND:2 == 0
				CDFLAG:ACTOR:캐릭터간호감도:(89) +=(ABL:ACTOR:욕망 + ABL:ACTOR:노출증 + ABL:ACTOR:섹스중독 + ABL:ACTOR:자위중독) * (2-CFLAG:ACTOR:신경썼다플래그) + CFLAG:ACTOR:방치일수*10
			ELSE
				CDFLAG:ACTOR:캐릭터간호감도:(88) -=(ABL:ACTOR:욕망 + ABL:ACTOR:노출증 + ABL:ACTOR:섹스중독 + ABL:ACTOR:자위중독) * (2-CFLAG:ACTOR:신경썼다플래그) + CFLAG:ACTOR:방치일수*10
			ENDIF
			CFLAG:ACTOR:음란도 += GUEST / 2

			IF RAND:100 < 10 + y + x - 10 || TALENT:ACTOR:ＮＴＲ == 2 || IS_ANTI_NTR_CLOTHES(ACTOR) == -1 || TALENT:ACTOR:즉각함락 == 1

				CFLAG:ACTOR:음란도 +=  CFLAG:ACTOR:현ＮＴＲ진행도 * 10 + EXCITE * 5

				IF CFLAG:ACTOR:음ＮＴＲ진행도 == 0
					CFLAG:ACTOR:음ＮＴＲ진행도 ++
					PRINTFORMW %CALLNAME:ACTOR%은(는) 흥분한 극장의 팬에게 뒷골목으로 끌려 들어갔다……

				ELSEIF RAND:120 < 10 + z + x + y - 10 || TALENT:ACTOR:ＮＴＲ == 2 || IS_ANTI_NTR_CLOTHES(ACTOR) == -1 || TALENT:ACTOR:즉각함락 == 1
					CFLAG:ACTOR:음란도 += ( CFLAG:ACTOR:현ＮＴＲ진행도 * 10 + EXCITE * 5)*2
					w = 1
					IF TALENT:ACTOR:ＮＴＲ == 2
						PRINTFORMW %CALLNAME:ACTOR%은(는) 양아치들에게 맨션의 한 방으로 끌려 들어갔다……
					ELSE
						PRINTFORMW %CALLNAME:ACTOR%이(가) 극장의 팬에게 안내된 곳에는 여러 남자가 기다리고 있었다……
					ENDIF

					IF CFLAG:ACTOR:음ＮＴＲ진행도 < 2 && ! TALENT:ACTOR:ＮＴＲ == 2
						CFLAG:ACTOR:음ＮＴＲ진행도 = 2
					ENDIF
					IF CFLAG:ACTOR:자궁내피임결계 == 1
						IF RAND:100 < CFLAG:ACTOR:현ＮＴＲ진행도 * 5
							CFLAG:ACTOR:자궁내피임결계 -= 1
							PRINTFORML %CALLNAME:ACTOR%의 자궁 내 피임 결계가 남자 중 한 명에게 해제되어 버린 것 같다……
						ENDIF
					ENDIF
					IF RAND:100 < CFLAG:ACTOR:현ＮＴＲ진행도 * 5
						IF CFLAG:ACTOR:배란유발제 == 0
							CFLAG:ACTOR:배란유발제 += 1
							PRINTFORML %CALLNAME:ACTOR%은(는) 남자 중 한 명에게 배란유발제를 강제로 먹여졌다……
						ENDIF
					ENDIF
					IF w == 1
						v = x + y + z
						SIF v > 40
							v = 32
						w = 0
					ENDIF
					IF TALENT:ACTOR:ＮＴＲ == 2
						PRINTFORMW %CALLNAME:ACTOR%은(는) 양아치들에게 장난감을 다루듯이 범해졌다……
						PRINTFORMW 양아치들은 %CALLNAME:ACTOR%이(가) 질내사정당하고 있는 모습을 촬영하여, 음란 비디오로 유출한 것 같다
					ELSE
						PRINTFORMW %CALLNAME:ACTOR%은(는) 주위를 둘러싼 남자들에게 윤간당했다……
						PRINTFORMW 윤간당하고 있는 %CALLNAME:ACTOR%의 생생한 모습이 카메라에 촬영되고 있다……
					ENDIF
					TCVAR:ACTOR:획득피사경험 +=((EXCITE/10 + v) + 1) + ((EXCITE/15 + v/2) + 1)

				ELSE
					PRINTFORMW %CALLNAME:ACTOR%은(는) 흥분한 극장의 팬에게 뒷골목에서 강간당했다……
				ENDIF

