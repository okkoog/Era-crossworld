				ELSEIF CFLAG:ACTOR:자궁내피임결계
					PRINTFORML <피임결계>
				ENDIF
				TCVAR:ACTOR:획득정액경험 += ((EXCITE/10 + v) + 1) + ((EXCITE/15 + v/2) + (EXCITE/12 + v) + 1+ 1)
				TCVAR:ACTOR:획득펠라경험 += (EXCITE/10 + v)/2+1

				TCVAR:ACTOR:획득윤간경험 += 1
