;--------------------------------------------------
;イベントフラグ
;1 = Data\ERB\RPG\개별이벤트\EVENT_K5711_九角天童_個別イベント.ERBで強化
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:텐도]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
IF ARG:2 == 1
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:텐도]], ARG, ARG:2

@SET_LEARN_SKILL_[[キャラ:텐도]], ARG, ARG:1
#DIM LCOUNT
IF ARG:1 == 1
	CALL SET_SKILL, ARG, "鬼道閃"
	CALL SET_SKILL, ARG, "乱れ緋牡丹"
	CALL SET_SKILL, ARG, "外法・真邪炎招来"
	CALL SET_SKILL, ARG, "外法・真邪水招来"
	CALL SET_SKILL, ARG, "外法・真邪風招来"
	CALL SET_SKILL, ARG, "外法・真邪雷招来"
	CALL SET_SKILL, ARG, "外法・真邪土招来"
	CALL SET_SKILL, ARG, "外法・邪力憑来"
	CALL SET_SKILL, ARG, "불굴의투지"
	CALL SET_SKILL, ARG, "外法・終ノ印"
	CALL SET_SKILL, ARG, "外法印・残虐"
	CALL SET_SKILL, ARG, "外法印・暴虐"
ENDIF
