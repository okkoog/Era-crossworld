;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:맘몬]], L_CHARA, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("マンモン_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("マンモン_FACE_TS_0")
			RETURNF ""
		SIF !SPRITECREATED("マンモン_FACE_TS_1")
			RETURNF ""
		SIF !SPRITECREATED("マンモン_FACE_TS_2")
			RETURNF ""
		SIF !SPRITECREATED("マンモン_FACE_TS_3")
			RETURNF ""
		SIF !SPRITECREATED("マンモン_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("マンモン_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("マンモン_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("マンモン_FACE_EX_3")
			RETURNF ""
		SIF !SPRITECREATED("マンモン_FACE_EX_4")
			RETURNF ""
		SIF !SPRITECREATED("マンモン_FACE_EX_5")
			RETURNF ""
		SIF !SPRITECREATED("マンモン_FACE_EX_6")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = マンモン_FACE_0
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:맘몬]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		IF IS_LOOKSLIKE_MALE(L_CHARA)
			SELECTCASE L_SITUATION
				CASE "調教"
					RESULTS_F = マンモン_FACE_0
			ENDSELECT
		ELSE
			SELECTCASE L_SITUATION
				CASE "調教"
					RESULTS_F = マンモン_FACE_EX_6
				CASEELSE
					SELECTCASE L_SITUATION:1
						;HAPPY、PANICの時
						CASE "HAPPY", "PANIC"
							RESULTS_F = マンモン_FACE_EX_0
						;SLEEPの時
						CASE "SLEEP"
							RESULTS_F = マンモン_FACE_EX_1
						;STONEの時
						CASE "STONE"
							RESULTS_F = マンモン_FACE_EX_2
						;DYINGの時
						CASE "DYING"
							RESULTS_F = マンモン_FACE_EX_3
						;DYINGでの色相変換を回避させるための指定
							RESULT_F:1 = 1
						;BINDやBOMBの時（ペンパトラで解除可能）
						CASE "BIND", "BOMB"
							RESULTS_F = マンモン_FACE_EX_4
						;それ以外の状態異常の時（ペンパトラで解除不能）
						CASE "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "POISON", "CLOSE", "SLIP", "FREEZE", "SHOCK"
							RESULTS_F = マンモン_FACE_EX_5
						;通常時
						CASEELSE
							IF 陥落(L_CHARA)
								SELECTCASE RESULTS
									CASE "연모"
										RESULTS_F = マンモン_FACE_TS_1
									CASE "음란"
										RESULTS_F = マンモン_FACE_TS_2
									CASE "복종"
										RESULTS_F = マンモン_FACE_TS_3
								ENDSELECT
							ELSE
								;未陥落
								RESULTS_F = マンモン_FACE_TS_0
							ENDIF
					ENDSELECT
			ENDSELECT
		ENDIF
ENDSELECT