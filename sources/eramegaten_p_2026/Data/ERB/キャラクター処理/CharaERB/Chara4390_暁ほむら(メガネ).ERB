;--------------------------------------------------
;ARG:0	キャラ登録番号
;レベルアップ時のイベント
@EVENT_LEVELUP_[[キャラ:호무라_U-U]], ARG, ARG:1
#DIM IS_TALENT_CHANGE
#DIMS L_BTL_TALENT
IS_TALENT_CHANGE = 0
IF BASE:ARG:LV >= 13 && !GET_RPG_CFLAG_EV(ARG, "道具知識Lv2習得済み")
	;SIF TALENT:ARG:도구지식 > 0
		CALL SET_RPG_CFLAG_EV, ARG, "道具知識Lv2習得済み", 1
	IF TALENT:ARG:도구지식 == 1
		PRINTFORMW %CALLNAME:ARG%의 도구지식이 Lv2로 성장했다!
		TALENT:ARG:도구지식 = 2
		IS_TALENT_CHANGE = 1
	ENDIF
ENDIF
IF BASE:ARG:LV >= 34 && !GET_RPG_CFLAG_EV(ARG, "道具知識Lv3習得済み")
	;SIF TALENT:ARG:도구지식 > 0
		CALL SET_RPG_CFLAG_EV, ARG, "道具知識Lv3習得済み", 1
	IF INRANGE(TALENT:ARG:도구지식, 1, 2)
		PRINTFORMW %CALLNAME:ARG%의 도구지식이 Lv3로 성장했다!
		TALENT:ARG:도구지식 = 3
		IS_TALENT_CHANGE = 1
	ENDIF
ENDIF
IF BASE:ARG:LV >= 15 && !GET_RPG_CFLAG_EV(ARG, "ガンスリンガーLv1習得済み")
	;SIF TALENT:ARG:건슬링거 > 0
		CALL SET_RPG_CFLAG_EV, ARG, "ガンスリンガーLv1習得済み", 1
	IF TALENT:ARG:건슬링거 == 0
		PRINTFORMW %CALLNAME:ARG%은(는) 거너 Lv1을 습득했다!
		TALENT:ARG:건슬링거 = 1
		IS_TALENT_CHANGE = 1
	ENDIF
ENDIF
IF BASE:ARG:LV >= 35 && !GET_RPG_CFLAG_EV(ARG, "ガンスリンガーLv2習得済み")
	;SIF TALENT:ARG:건슬링거 > 0
		CALL SET_RPG_CFLAG_EV, ARG, "ガンスリンガーLv2習得済み", 1
	IF TALENT:ARG:건슬링거 == 1
		PRINTFORMW %CALLNAME:ARG%의 거너가 Lv2로 성장했다!
		TALENT:ARG:건슬링거 = 2
		IS_TALENT_CHANGE = 1
	ENDIF
ENDIF
IF BASE:ARG:LV >= 55 && !GET_RPG_CFLAG_EV(ARG, "ガンスリンガーLv3習得済み")
	;SIF TALENT:ARG:건슬링거 > 0
		CALL SET_RPG_CFLAG_EV, ARG, "ガンスリンガーLv3習得済み", 1
	IF INRANGE(TALENT:ARG:건슬링거, 1, 2)
		PRINTFORMW %CALLNAME:ARG%의 거너가 Lv3로 성장했다!
		TALENT:ARG:건슬링거 = 3
		IS_TALENT_CHANGE = 1
	ENDIF
ENDIF
;건슬링거+道具知識に対して+20まで枠を得る
IF IS_TALENT_CHANGE
	TALENT:ARG:커패시티확대 = MAX(GET_SUB_ROLE_PROP("COST", "건슬링거", ARG, "通常形態") + GET_SUB_ROLE_PROP("COST", "도구지식", ARG, "通常形態") - 20, 0)
	CALL SET_ROLE_CP, ARG
	IF GET_ROLE_CP(ARG, "通常形態") < 0
		DRAWLINE
		PRINTFORML %CALLNAME:ARG%의 소질 코스트가 커패시티 상한을 초과했습니다.
		PRINTFORMW 남길 소질을 선택해 주십시오.
		DRAWLINE
		CALL SET_VAR_HAVE_SUB_ROLE, ARG, "通常形態", L_BTL_TALENT
		;サブ素質を設定
		CALL ENHANCE_ROLE, ARG, "通常形態", L_BTL_TALENT, , "戻る不可"
	ENDIF
	;CALL SET_ROLE_CP, ARG
	;TALENT:ARG:커패시티확대 = -(40 - GET_ROLE_CP(ARG))
ENDIF
;--------------------------------------------------
;キャラクター独自変数名称定義関数
;-------------------------------------------------
@RPG_CFLAG_NAME_[[キャラ:호무라_U-U]], ARGS, ARG
#FUNCTIONS
SELECTCASE ARGS
	;---------------------------------------------
	;RPG_CFLAG_EV
	;周回時にリセットされる数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 道具知識Lv2習得済み
			CASE 1
				RESULTS = 道具知識Lv3習得済み
			CASE 2
				RESULTS = ガンスリンガーLv1習得済み
			CASE 3
				RESULTS = ガンスリンガーLv2習得済み
			CASE 4
				RESULTS = ガンスリンガーLv3習得済み
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_EV
	;周回時にリセットされる文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CFLAG_TAKEOVER
	;周回時にリセットされない数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_TAKEOVER
	;周回時にリセットされない文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 戦闘素質設定
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる数値型変数です
	;スキルゲージHとほぼ互換です。基本的にはゲージHが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "RPG_CFLAG_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる文字列型変数です
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "RPG_CSTR_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる数値型変数
	;スキルゲージFとほぼ互換です。基本的にはゲージFが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "RPG_CFLAG_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる文字列型変数
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "RPG_CSTR_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
ENDSELECT
RETURNF RESULTS
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:호무라_U-U]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ほむら_U-U_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("ほむら_U-U_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("ほむら_U-U_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("ほむら_U-U_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("ほむら_U-U_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("ほむら_U-U_FACE_EX_3")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = ほむら_U-U_FACE_1
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:호무라_U-U]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ほむら_U-U_FACE_2
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ほむら_U-U_FACE_EX_0
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = ほむら_U-U_FACE_EX_1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = ほむら_U-U_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = ほむら_U-U_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = ほむら_U-U_FACE_1
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT