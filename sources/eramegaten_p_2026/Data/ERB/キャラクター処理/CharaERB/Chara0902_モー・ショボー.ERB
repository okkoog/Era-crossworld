;--------------------------------------------------
;イベントフラグ
;1 = ダマナーの店で購入
;2 = 新宿で加入
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:모・쇼보]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:모・쇼보]], ARG, ARG:2
IF ARG:2 == 1
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:모・쇼보]], ARG, ARG:2

@SHOP_NEWGAME_INITCHARA_[[キャラ:모・쇼보]], ARG
CALL SET_LEARN_SKILL_[[キャラ:모・쇼보]], ARG, CFLAG:ARG:이벤트가입

;Data\ERB\RPG\이벤트\EVENT_102(など）_炎・氷\EVENT_102_2_コオリノハテニ.ERB
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:모・쇼보]], ARG, ARG:1
#DIM DYNAMIC LCOUNT
SELECTCASE ARG:1
	CASE 2
		TALENT:ARG:츤데레 = 1
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:모・쇼보]], ARG, ARG:1
#DIM LCOUNT
IF ARG:1 == 2
	CALL SET_LEARN_SKILL, ARG, "갈라", 1
	CALL SET_LEARN_SKILL, ARG, "잔마", 1
	CALL SET_LEARN_SKILL, ARG, "디아라마", 1
	CALL SET_LEARN_SKILL, ARG, "기공(중)", 1
	CALL SET_LEARN_SKILL, ARG, "리캄", 25
	CALL SET_LEARN_SKILL, ARG, "메・디아라한", 50
	CALL SET_LEARN_SKILL, ARG, "리캄드라", 50
	CALL SET_LEARN_SKILL, ARG, "파이널누드", 50
ENDIF
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:모・쇼보]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("モー・ショボー_FACE_10")
			RETURNF ""
		SIF !SPRITECREATED("モー・ショボー_FACE_11")
			RETURNF ""
		SIF !SPRITECREATED("モー・ショボー_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("モー・ショボー_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("モー・ショボー_FACE_EX_2")
			RETURNF ""	
		RESULTS_F = デフォルト
		RESULTS_F:1 = モー・ショボー_FACE_10
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:모・쇼보]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = モー・ショボー_FACE_11
			CASEELSE
				SELECTCASE GET_STATE(CFLAG:L_CHARA:상태이상)
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = モー・ショボー_FACE_EX_0
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = モー・ショボー_FACE_EX_1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = モー・ショボー_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = モー・ショボー_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = モー・ショボー_FACE_10
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT