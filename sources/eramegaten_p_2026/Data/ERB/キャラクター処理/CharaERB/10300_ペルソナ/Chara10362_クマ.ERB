;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:곰]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("クマ_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_3")
			RETURNF ""
		RESULTS_F = 外側中身
		CALLF DISPOSE_SPRITE_FORCE_F, TEMP_GID_START, "クマ_外側中身"
		GCREATE TEMP_GID_START, 360, 360
		GDRAWSPRITE TEMP_GID_START, "クマ_FACE_1", 0, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START, "クマ_FACE_4", 180, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START, "クマ_FACE_EX_0", 0, 180, 180, 180
		GDRAWSPRITE TEMP_GID_START, "クマ_FACE_EX_2", 180, 180, 180, 180
		SPRITECREATE "クマ_外側中身", TEMP_GID_START
		RESULTS_F:2 = クマ_外側中身
		RESULTS_F:1 = クマ_FACE_1
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("クマ_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_6")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_3")
			RETURNF ""
		RESULTS_F = 外側女装
		CALLF DISPOSE_SPRITE_FORCE_F, TEMP_GID_START+1, "クマ_外側女装"
		GCREATE TEMP_GID_START+1, 360, 360
		GDRAWSPRITE TEMP_GID_START+1, "クマ_FACE_1", 0, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START+1, "クマ_FACE_6", 180, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START+1, "クマ_FACE_EX_0", 0, 180, 180, 180
		GDRAWSPRITE TEMP_GID_START+1, "クマ_FACE_EX_2", 180, 180, 180, 180
		SPRITECREATE "クマ_外側女装", TEMP_GID_START+1
		RESULTS_F:2 = クマ_外側女装
		RESULTS_F:1 = クマ_FACE_1
	CASE 2
		;画像チェック
		SIF !SPRITECREATED("クマ_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_3")
			RETURNF ""
		RESULTS_F = 外側
		CALLF DISPOSE_SPRITE_FORCE_F, TEMP_GID_START+2, "クマ_外側"
		GCREATE TEMP_GID_START+2, 360, 360
		GDRAWSPRITE TEMP_GID_START+2, "クマ_FACE_1", 0, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START+2, "クマ_FACE_2", 180, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START+2, "クマ_FACE_EX_0", 0, 180, 180, 180
		GDRAWSPRITE TEMP_GID_START+2, "クマ_FACE_EX_2", 180, 180, 180, 180
		SPRITECREATE "クマ_外側", TEMP_GID_START+2
		RESULTS_F:2 = クマ_外側
		RESULTS_F:1 = クマ_FACE_1
	CASE 3
		;画像チェック
		SIF !SPRITECREATED("クマ_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_4")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_5")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_6")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_7")
			RETURNF ""
		RESULTS_F = 中身
		CALLF DISPOSE_SPRITE_FORCE_F, TEMP_GID_START+3, "クマ_中身"
		GCREATE TEMP_GID_START+3, 360, 360
		GDRAWSPRITE TEMP_GID_START+3, "クマ_FACE_3", 0, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START+3, "クマ_FACE_4", 180, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START+3, "クマ_FACE_EX_4", 0, 180, 180, 180
		GDRAWSPRITE TEMP_GID_START+3, "クマ_FACE_EX_6", 180, 180, 180, 180
		SPRITECREATE "クマ_中身", TEMP_GID_START+3
		RESULTS_F:2 = クマ_中身
		RESULTS_F:1 = クマ_FACE_3
	CASE 4
		;画像チェック
		SIF !SPRITECREATED("クマ_FACE_5")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_6")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_8")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_9")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_10")
			RETURNF ""
		SIF !SPRITECREATED("クマ_FACE_EX_11")
			RETURNF ""
		RESULTS_F = 女装
		CALLF DISPOSE_SPRITE_FORCE_F, TEMP_GID_START+4, "クマ_女装"
		GCREATE TEMP_GID_START+4, 360, 360
		GDRAWSPRITE TEMP_GID_START+4, "クマ_FACE_5", 0, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START+4, "クマ_FACE_6", 180, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START+4, "クマ_FACE_EX_8", 0, 180, 180, 180
		GDRAWSPRITE TEMP_GID_START+4, "クマ_FACE_EX_10", 180, 180, 180, 180
		SPRITECREATE "クマ_女装", TEMP_GID_START+4
		RESULTS_F:2 = クマ_女装
		RESULTS_F:1 = クマ_FACE_5
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:곰]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "外側中身"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = クマ_FACE_4
			CASEELSE
				SELECTCASE GET_STATE(CFLAG:L_CHARA:상태이상)
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = クマ_FACE_EX_0
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = クマ_FACE_EX_1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = クマ_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = クマ_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = クマ_FACE_1
				ENDSELECT
		ENDSELECT
	CASE "外側女装"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = クマ_FACE_6
			CASEELSE
				SELECTCASE GET_STATE(CFLAG:L_CHARA:상태이상)
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = クマ_FACE_EX_0
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = クマ_FACE_EX_1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = クマ_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = クマ_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = クマ_FACE_1
				ENDSELECT
		ENDSELECT
	CASE "外側"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = クマ_FACE_2
			CASEELSE
				SELECTCASE GET_STATE(CFLAG:L_CHARA:상태이상)
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = クマ_FACE_EX_0
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = クマ_FACE_EX_1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = クマ_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = クマ_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = クマ_FACE_1
				ENDSELECT
		ENDSELECT
	CASE "中身"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = クマ_FACE_4
			CASEELSE
				SELECTCASE GET_STATE(CFLAG:L_CHARA:상태이상)
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = クマ_FACE_EX_4
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = クマ_FACE_EX_5
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = クマ_FACE_EX_6
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = クマ_FACE_EX_7
					;通常時
					CASEELSE
						RESULTS_F = クマ_FACE_3
				ENDSELECT
		ENDSELECT
	CASE "女装"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = クマ_FACE_6
			CASEELSE
				SELECTCASE GET_STATE(CFLAG:L_CHARA:상태이상)
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = クマ_FACE_EX_8
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = クマ_FACE_EX_9
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = クマ_FACE_EX_10
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = クマ_FACE_EX_11
					;通常時
					CASEELSE
						RESULTS_F = クマ_FACE_5
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT