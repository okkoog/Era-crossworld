;--------------------------------------------------
;イベントフラグ
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:P4주인공]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
DO
	PRINTL P4 주인공의 이름을 결정해 주십시오
	PRINTL [1] 나루카미 유우   [2] 세타 소우지  [3] 직접 결정한다
	CALL INPUTINT,1,2,3
	SELECTCASE RESULT
		CASE 1
			NAME:ARG = 鳴上 悠
			CALLNAME:ARG = 悠
		CASE 2
			NAME:ARG = 瀬多 総司
			CALLNAME:ARG = 総司
		CASE 3
			PRINTL P4 주인공의 이름을 입력해 주십시오
			INPUTS
			NAME:ARG = %RESULTS%
			PRINTL P4 주인공의 애칭을 입력해 주십시오
			INPUTS
			CALLNAME:ARG = %RESULTS%
	ENDSELECT
	PRINTFORML 名前　%NAME:ARG%
	PRINTFORML 愛称　%CALLNAME:ARG%
	PRINTL 이걸로 괜찮으시겠습니까？
	CALL INPUT_YN
LOOP RESULT == 1
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:P4주인공]], L_CHARA, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("P4主人公_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("P4主人公_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("P4主人公_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("P4主人公_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("P4主人公_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("P4主人公_FACE_EX_3")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = P4主人公_FACE_1
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:P4주인공]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = P4主人公_FACE_2
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = P4主人公_FACE_EX_0
					;CHARMになった時
					CASE "CHARM"
						RESULTS_F = P4主人公_FACE_EX_1
					;SLEEPになった時
					CASE "SLEEP"
						RESULTS_F = P4主人公_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = P4主人公_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = P4主人公_FACE_1
				ENDSELECT
				;HPが25%未満だとDYINGまでこれに固定する
				IF 現HP割合(L_CHARA) < 25
					RESULTS_F = P4主人公_FACE_EX_0
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT