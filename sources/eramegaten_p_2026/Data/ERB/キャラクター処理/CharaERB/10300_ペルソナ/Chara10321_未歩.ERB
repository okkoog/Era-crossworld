;--------------------------------------------------
;イベントフラグ
;0 = 加入
;1 = ロリコンプロデューサーの噂
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:미호]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:미호]], ARG, ARG:2

;Data\ERB\RPG\依頼\REQUEST_4_ペルソナ2\G5A_MUSESコンサート.ERB
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:미호]], ARG, ARG:1
#DIM DYNAMIC LCOUNT
SELECTCASE ARG:1
	CASE 0
	CASE 1
		TALENT:ARG:처녀 = 0
		ABL:ARG:Ｃ감각 = 2
		ABL:ARG:Ｖ감각 = 3
		ABL:ARG:Ａ감각 = 2
		ABL:ARG:Ｂ감각 = 3
		ABL:ARG:욕망 = 3
		ABL:ARG:기교 = 3
		ABL:ARG:봉사정신 = 2
		ABL:ARG:노출증 = 3
		ABL:ARG:마조끼 = 1
		ABL:ARG:새드끼 = 3
		ABL:ARG:레즈끼 = 3
		ABL:ARG:레즈중독 = 1
		ABL:ARG:자위중독 = 1
		ABL:ARG:정액중독 = 1
		EXP:ARG:Ｖ경험 = 20
		EXP:ARG:Ａ경험 = 15
		EXP:ARG:절정경험 = 35
		EXP:ARG:성교경험 = 20
		EXP:ARG:자위경험 = 30
		EXP:ARG:고통쾌락경험 = 5
		EXP:ARG:가학쾌락경험 = 15
		EXP:ARG:조교자위경험 = 30
		EXP:ARG:긴박경험 = 5
		EXP:ARG:레즈경험 = 50
		EXP:ARG:정액경험 = 50
		EXP:ARG:봉사쾌락경험 = 15
		EXP:ARG:펠라경험 = 40
		EXP:ARG:이상경험 = 2
ENDSELECT
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:미호]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("未歩_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("未歩_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("未歩_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("未歩_FACE_EX_1")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = 未歩_FACE_1
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:미호]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = 未歩_FACE_2
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = 未歩_FACE_EX_0
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = 未歩_FACE_EX_1
					;通常時
					CASEELSE
						RESULTS_F = 未歩_FACE_1
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT