@SKILL_EXPLAIN_CHARA_[[キャラ:메티스]],ARG
;PRINTL オルギア改
;PRINTL コマンド選択においてＯＲＧＹを選択すると発動。発動時、自身のバッドステータスを解除する。
;PRINTL 数ターンの間、使用者の戦闘能力が向上する代わりに行動を選択できなくなる。
;;PRINTL 効果中はスキルを使用する際の消費コストが通常より少なくなる。
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:메티스]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("メティス_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("メティス_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("メティス_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("メティス_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("メティス_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("メティス_FACE_EX_3")
			RETURNF ""
		SIF !SPRITECREATED("メティス_FACE_EX_4")
			RETURNF ""
		RESULTS_F = 一番
		RESULTS_F:1 = メティス_FACE_1
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:메티스]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "一番"
		SELECTCASE L_SITUATION
			CASE "調教"
					RESULTS_F = メティス_FACE_2
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = メティス_FACE_EX_0
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = メティス_FACE_EX_1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = メティス_FACE_EX_2
					;混乱にされた時
					CASE "PANIC"
						RESULTS_F = メティス_FACE_EX_3
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "SHOCK", "HAPPY"
						RESULTS_F = メティス_FACE_EX_4
					;通常時
					CASEELSE
						RESULTS_F = メティス_FACE_1
				ENDSELECT
				;HPが25%未満だとDYINGまでこれに固定する
				IF 現HP割合(L_CHARA) < 25
					RESULTS_F = メティス_FACE_EX_0
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT