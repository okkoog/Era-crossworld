@ACTION_CHARA_[[キャラ:메티스]],ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;====================================================
;戦闘中の特定のタイミングにおける処理の記述
;====================================================
@SKILL_BATTLE_START_CHARA_[[キャラ:메티스]], ARG, ARG:1
#DIM L_CHARA
SIF GET_RPG_CFLAG_DUNGEON(ARG, "ORGY_AUTO_ENABLE") != 1
	RETURN 0
FOR COUNT, 7, 17
	L_CHARA = POS(COUNT)
	SIF L_CHARA < 0
		CONTINUE
	SIF CFLAG:L_CHARA:보스플래그
		RETURN 0
NEXT
PRINTL ＯＲＧＹ－ＡＵＴＯ：有効
PRINTL 해제하겠습니까?
PRINTL [0] 아니오
PRINTL [1] 예
ONEINPUTS 0
IF RESULTS == "1"
	CALL SET_RPG_CFLAG_DUNGEON, ARG, "ORGY_AUTO_ENABLE", 0
	RETURN 0
ELSE
	CALL INPUT_COM_14556, ARG
	RETURN 0
ENDIF

