@INPUT_COM_14556,ARG
#DIM STOCK_TARGET
#DIM STOCK_ACTION
STOCK_TARGET = TARGET
STOCK_ACTION = CFLAG:ARG:입력행동
TARGET = ARG
CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "オルギア改")

CALL INPUT_COM_ORGY, ARG
SETCOLOR COLOR("FRIEND")
CALL VARSET_KOJO_RPG_FLAG
CALL BATTLE_EVENT_ACT, ARG
CALL PRINT_KOJO_RPG_MESSAGE
RESETCOLOR

TARGET = STOCK_TARGET
CFLAG:ARG:입력행동 = STOCK_ACTION
RETURN 1
