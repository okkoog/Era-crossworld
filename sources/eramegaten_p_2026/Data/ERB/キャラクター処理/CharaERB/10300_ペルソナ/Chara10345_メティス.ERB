;====================================================
;トリガー発動条件
;====================================================
@SKILL_TRIGGER_ACTIONABLE_CHARA_[[キャラ:메티스]],ARG,ARG:1
#DIM SKILL_NUM
#DIM L_COST
#DIM L_COST_TYPE
SIF CFLAG:ARG:상태이상 != GET_STATE_NUM("ORGY")
	RETURN 0
SIF CFLAG:ARG:입력행동 == -1
	RETURN 0
SIF ARG != FLAG:행동순1
	RETURN 0
SIF GET_RPG_CFLAG_BTL(ARG, "REGEN_ONCE") != 1
	RETURN 0
CALL SET_RPG_CFLAG_BTL, ARG, "REGEN_ONCE", 0

RETURN 0
;↑1行を消す
;ゲームバランスへの影響が大きそうなので到達不能部分にお楽しみ要素を置いておく
;ACTIONに行くと表示が出てしまうのでここでひっそりと行う
SKILL_NUM = CFLAG:ARG:입력행동
CALL GET_SKILL_PROP, "SKILL_COSTTYPE", SKILL_NUM, ARG
L_COST_TYPE = RESULT
IF L_COST_TYPE > 1
	CALL GET_SKILL_COST, SKILL_NUM, ARG
	L_COST = RESULT
	SELECTCASE GET_SKILL_COST_TYPE(L_COST_TYPE)
		;HP消費スキルって今ある？
		;CASE "HP"
		CASE "MP"
			;原作メティスのオルギア（無限にスキル使い放題）
			;L_COST = L_COST

			;これぐらいなら許される？
			L_COST = (L_COST*(30 + 10*LIMIT(陥落(ARG), 0, 3)))/100

			;気功との組み合わせを警戒
			;ペルソナ交代とか装備スキルとかあるから対策になってない
			;SIF HAVE_SKILL(ARG, [[스킬:기공(소)]]) || HAVE_SKILL(ARG, [[스킬:기공(중)]]) || HAVE_SKILL(ARG, [[스킬:기공(대)]])
			;	L_COST = LIMIT(L_COST - 4, 0, L_COST/2)
			CALL VAR_MP, ARG, L_COST
			;ダンジョン内欲情値に変換してみたり
			;SIF FLAG:무후후전개
			;	CFLAG:ARG:던전내발정용욕정치 += L_COST * (20 + RAND:10)
		;ターンコストを還元って何
		;CASE "TURN"
	ENDSELECT
ENDIF
RETURN 0

