;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:타츠야]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("達哉_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_TS_0")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_TS_1")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_EX_3")
			RETURNF ""
		RESULTS_F = TS短髪
		CALLF DISPOSE_SPRITE_FORCE_F, TEMP_GID_START, "達哉TS短髪"
		GCREATE TEMP_GID_START, 360, 360
		GDRAWSPRITE TEMP_GID_START, "達哉_FACE_2", 0, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START, "達哉_FACE_3", 180, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START, "達哉_FACE_TS_0", 0, 180, 180, 180
		GDRAWSPRITE TEMP_GID_START, "達哉_FACE_TS_1", 180, 180, 180, 180
		SPRITECREATE "達哉TS短髪", TEMP_GID_START
		RESULTS_F:2 = 達哉TS短髪
		RESULTS_F:1 = 達哉_FACE_2
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("達哉_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_TS_2")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_TS_3")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_EX_4")
			RETURNF ""
		SIF !SPRITECREATED("達哉_FACE_EX_5")
			RETURNF ""
		RESULTS_F = TS長髪
		CALLF DISPOSE_SPRITE_FORCE_F, TEMP_GID_START+1, "達哉TS長髪"
		GCREATE TEMP_GID_START+1, 360, 360
		GDRAWSPRITE TEMP_GID_START+1, "達哉_FACE_2", 0, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START+1, "達哉_FACE_3", 180, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START+1, "達哉_FACE_TS_2", 0, 180, 180, 180
		GDRAWSPRITE TEMP_GID_START+1, "達哉_FACE_TS_3", 180, 180, 180, 180
		SPRITECREATE "達哉TS長髪", TEMP_GID_START+1
		RESULTS_F:2 = 達哉TS長髪
		RESULTS_F:1 = 達哉_FACE_2
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:타츠야]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "TS短髪"
		IF IS_LOOKSLIKE_MALE(L_CHARA)
			SELECTCASE L_SITUATION
				CASE "調教"
					RESULTS_F = 達哉_FACE_3
				CASEELSE
					SELECTCASE L_SITUATION:1
						;戦闘不能になった時
						CASE "DYING"
							RESULTS_F = 達哉_FACE_EX_0
						;上記以外の状態異常の時
						CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
							RESULTS_F = 達哉_FACE_EX_1
						;通常時
						CASEELSE
							RESULTS_F = 達哉_FACE_2
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE L_SITUATION
				CASE "調教"
					RESULTS_F = 達哉_FACE_TS_1
				CASEELSE
					SELECTCASE L_SITUATION:1
						;戦闘不能になった時
						CASE "DYING"
							RESULTS_F = 達哉_FACE_EX_2
						;上記以外の状態異常の時
						CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
							RESULTS_F = 達哉_FACE_EX_3
						;通常時
						CASEELSE
							RESULTS_F = 達哉_FACE_TS_0
					ENDSELECT
			ENDSELECT
		ENDIF
	CASE "TS長髪"
		IF IS_LOOKSLIKE_MALE(L_CHARA)
			SELECTCASE L_SITUATION
				CASE "調教"
					RESULTS_F = 達哉_FACE_3
				CASEELSE
					SELECTCASE L_SITUATION:1
						;戦闘不能になった時
						CASE "DYING"
							RESULTS_F = 達哉_FACE_EX_0
						;上記以外の状態異常の時
						CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
							RESULTS_F = 達哉_FACE_EX_1
						;通常時
						CASEELSE
							RESULTS_F = 達哉_FACE_2
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE L_SITUATION
				CASE "調教"
					RESULTS_F = 達哉_FACE_TS_3
				CASEELSE
					SELECTCASE L_SITUATION:1
						;戦闘不能になった時
						CASE "DYING"
							RESULTS_F = 達哉_FACE_EX_4
						;上記以外の状態異常の時
						CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
							RESULTS_F = 達哉_FACE_EX_5
						;通常時
						CASEELSE
							RESULTS_F = 達哉_FACE_TS_2
					ENDSELECT
			ENDSELECT
		ENDIF
	CASEELSE
ENDSELECT