;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:리세]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("りせ_FACE_8")
			RETURNF ""
		SIF !SPRITECREATED("りせ_FACE_9")
			RETURNF ""
		SIF !SPRITECREATED("りせ_FACE_10")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = りせ_FACE_8
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:리세]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = りせ_FACE_9
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = りせ_FACE_9
				ELSEIF L_SITUATION:1 == "DYING"
					RESULTS_F = りせ_FACE_10
					;DYINGでの色相変換を回避させるための指定
					RESULT_F:1 = 1
				ELSE
					RESULTS_F = りせ_FACE_8
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT
