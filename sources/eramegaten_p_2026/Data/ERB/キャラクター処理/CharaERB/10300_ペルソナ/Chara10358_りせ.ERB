@EVENT_CHANGE_TRAIN_TALENT_[[キャラ:리세]], ARG, ARGS, ARGS:1 = "GET"
;陥落時にスキルエミュレータの販売を追加する
IF GROUPMATCH(ARGS, "연모", "음란", "복종") && TALENT:ARG:페르소나구사자 > 0
	CALL SET_STR_TURNEND_EV, "入荷告知", "告知文", ADD_SPLIT(GET_STR_TURNEND_EV("入荷告知", "告知文"), "/", @"＞魔貨交換に新しいスキルエミュレータ【원기의노래】と【치어링】が追加されたようだ…_{DAY+1}_りせ")
	CALL LEARN_SKILL_P, CFLAG:ARG:초기페르소나넘버, SKILL_NUM_F("원기의노래")
	CALL LEARN_SKILL_P, CFLAG:ARG:초기페르소나넘버, SKILL_NUM_F("치어링")
ENDIF

 
@ADD_NEW_COMPANION_[[キャラ:리세]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:리세]], ARG, ARG:2

;イベント加入1  りせ非戦闘員可処理
;イベント加入2  監視塔依頼経由
;イベント加入3  両方
@SET_BASE_[[キャラ:리세]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		TALENT:ARG:비전투원 = 1
	CASE 2, 3
		TALENT:ARG:처녀 = 1
		TALENT:ARG:Ｃ민감 = 1
		TALENT:ARG:Ｖ민감 = 1
		TALENT:ARG:Ａ민감 = 1
		TALENT:ARG:거유 = 0
		TALENT:ARG:폭유 = 1
		ABL:ARG:Ｃ감각 = 3
		ABL:ARG:Ａ감각 = 2
		ABL:ARG:Ｂ감각 = 4
		ABL:ARG:순종 = 2
		ABL:ARG:욕망 = 3
		ABL:ARG:노출증 = 3
		ABL:ARG:마조끼 = 3
		ABL:ARG:자위중독 = 1
		EXP:ARG:절정경험 = (DAY)*1
		EXP:ARG:Ａ경험 = (DAY-3)*10
		EXP:ARG:고통쾌락경험 = (DAY-3)*5
		EXP:ARG:방뇨경험 = (DAY-3)*5
		EXP:ARG:긴박경험 = (DAY-3)*10
		EXP:ARG:이상경험 = 2
		SIF ARG:1 == 3
			TALENT:ARG:비전투원 = 1
ENDSELECT

