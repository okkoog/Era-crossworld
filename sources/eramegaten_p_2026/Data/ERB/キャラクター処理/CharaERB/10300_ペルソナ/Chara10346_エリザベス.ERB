;--------------------------------------------------
;イベントフラグ
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:엘리자베스]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_SKILL_[[キャラ:엘리자베스]], ARG, ARG:2

@SET_SKILL_[[キャラ:엘리자베스]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 0
		VARI L_PERSONA = CFLAG:ARG:초기페르소나넘버
		DITEMTYPE:L_PERSONA:페르소나("LV") = 50
		DITEMTYPE:L_PERSONA:페르소나("힘") = 16
		DITEMTYPE:L_PERSONA:페르소나("지혜") = 16
		DITEMTYPE:L_PERSONA:페르소나("마력") = 16
		DITEMTYPE:L_PERSONA:페르소나("내구") = 16
		DITEMTYPE:L_PERSONA:페르소나("속도") = 16
		DITEMTYPE:L_PERSONA:페르소나("운") = 16
		DITEMTYPE:L_PERSONA:페르소나("스킬1") = [[스킬:디아라마]]
		DITEMTYPE:L_PERSONA:페르소나("스킬2") = [[스킬:방전]]
		DITEMTYPE:L_PERSONA:페르소나("스킬3") = [[스킬:해피스텝]]
		DITEMTYPE:L_PERSONA:페르소나("스킬4") = [[스킬:메・디아라마]]
		DITEMTYPE:L_PERSONA:페르소나("스킬5") = [[스킬:암리타]]
		DITEMTYPE:L_PERSONA:페르소나("습득스킬1") = [[스킬:메기도라온]]
		DITEMTYPE:L_PERSONA:페르소나("습득LV1") = 60
ENDSELECT
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:엘리자베스]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("エリザベス_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("エリザベス_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("エリザベス_FACE_4")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = エリザベス_FACE_2
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:엘리자베스]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = エリザベス_FACE_3
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = エリザベス_FACE_3
				ELSEIF L_SITUATION:1 == "DYING"
					RESULTS_F = エリザベス_FACE_4
					;DYINGでの色相変換を回避させるための指定
					RESULT_F:1 = 1
				ELSE
					RESULTS_F = エリザベス_FACE_2
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT