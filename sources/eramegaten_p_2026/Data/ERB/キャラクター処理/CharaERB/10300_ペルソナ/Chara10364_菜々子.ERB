;--------------------------------------------------
;イベントフラグ
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:나나코]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:나나코]], ARG, ARG:2

@SET_BASE_[[キャラ:나나코]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 2
		TALENT:ARG:붕괴 = 1
		TALENT:ARG:처녀 = 0
		
		EXP:ARG:Ｖ경험 += 1
		EXP:ARG:Ａ경험 += 1
		EXP:ARG:펠라경험 += 1
		EXP:ARG:윤간경험 += 3
		
		EXP:ARG:정액경험 += 3
		EXP:ARG:질사경험 += 1
		EXP:ARG:성교경험 += 2
		EXP:ARG:촉수경험 += 2
		
		MARK:ARG:고통각인 = 3
		CALL ADDS_ABNORMAL_EXP, "処女喪失（輪姦）", ARG
		CALL ADDS_ABNORMAL_EXP, "触手初体験", ARG
		CALL ADDS_ABNORMAL_EXP, "苦痛刻印LV3", ARG
		CALL ADDS_ABNORMAL_EXP, "拡張初体験", ARG
		CALL SHOW_ABNORMAL_EXP , ARG, 0			
ENDSELECT
;-------------------------------------------------
@SET_BTL_TALENT_[[キャラ:나나코]], ARG, ARG:1
IF ARG:1 == 1
    CALL CHANGE_ROLE, ARG, "페르소나구사자_1"
    ABL:ARG:초기페르소나 = [[キャラ:무라사키노우에_페르소나]]
    ABL:ARG:초기페르소나2 = [[キャラ:키비츠히코노미코토_페르소나]]
    ABL:ARG:초기페르소나3 = [[キャラ:오오카무즈미_페르소나]]
ENDIF
