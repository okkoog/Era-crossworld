;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:안]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("杏_FACE_5")
			RETURNF ""
		SIF !SPRITECREATED("杏_FACE_7")
			RETURNF ""
		SIF !SPRITECREATED("杏_FACE_8")
			RETURNF ""
		RESULTS_F = 가면
		RESULTS_F:1 = 杏_FACE_5
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("杏_FACE_6")
			RETURNF ""
		SIF !SPRITECREATED("杏_FACE_7")
			RETURNF ""
		SIF !SPRITECREATED("杏_FACE_9")
			RETURNF ""
		RESULTS_F = 私服
		RESULTS_F:1 = 杏_FACE_6
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:안]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "가면"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = 杏_FACE_7
			CASEELSE
				IF L_SITUATION:1 == "DYING"
					RESULTS_F = 杏_FACE_8
					;DYINGでの色相変換を回避させるための指定
					RESULT_F:1 = 1
				ELSE
					RESULTS_F = 杏_FACE_5
				ENDIF
		ENDSELECT
	CASE "私服"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = 杏_FACE_7
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = 杏_FACE_7
				ELSEIF L_SITUATION:1 == "DYING"
					RESULTS_F = 杏_FACE_9
					;DYINGでの色相変換を回避させるための指定
					RESULT_F:1 = 1
				ELSE
					RESULTS_F = 杏_FACE_6
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT