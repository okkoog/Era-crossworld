@ROLE_EXPLAIN_ADD_PAGE_[[キャラ:은랑]], ARG
RETURN 1

;ARG:1 = 表示ページ
@ROLE_EXPLAIN_[[キャラ:은랑]], ARG, ARG:1
#DIM LCOUNT
IF ARG:1 == 1
	PRINTFORML 星魂
	PRINTL 
	FOR LCOUNT, 1, 7
		IF GET_RPG_CFLAG_TAKEOVER(ARG, "星魂") >= LCOUNT
			SELECTCASE LCOUNT
				CASE 1
					PRINTFORML 　１　社会工学
					PRINTFORML 　　　　필살기 사용 후 적에게 걸려 있는 디버프 항목마다 EP를 7 회복한다. 최대 5회.
				CASE 2
					PRINTFORML 　2단계　봇넷
					PRINTFORML 　　　　전투 개시 시 적의 BS 부착률 +8.
				CASE 3
					PRINTFORML 　3단계　페이로드
					PRINTFORML 　　　　『수정을 허가하시겠습니까?』의 위력 1.1배. 전용 스킬에 의한 디버프량 1.5배.
				CASE 4
					PRINTFORML 　4단계　바운스 공격
					PRINTFORML 　　　　필살기 사용 후 적에게 걸려 있는 디버프 항목마다 1회 만능 상성으로 추격을 가한다. 최대 5회.
				CASE 5
					PRINTFORML 　5단계　무차별 대입 공격
					PRINTFORML 　　　　『｜시스템 경고｜』『｜계정이 정지되었습니다｜』의 위력 1.1배.
				CASE 6
					PRINTFORML 　6단계　오버레이 네트워크
					PRINTFORML 　　　　적에게 걸려 있는 디버프 항목마다 그 적에 대한 데미지 +20％. 최대 100％.
			ENDSELECT
		ELSE
			PRINTFORML 　%TOFULL(TOSTR(LCOUNT))%　？？？？
			PRINTFORML 　　　　？？？？？？？？？？？？？？？？？
		ENDIF
	NEXT
ENDIF
RETURN 1

