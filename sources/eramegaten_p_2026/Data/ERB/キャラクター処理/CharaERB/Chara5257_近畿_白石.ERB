;--------------------------------------------------
;イベントフラグ
;1 = 陥落加入(男)
;2 = 陥落加入(女)
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:시라이시_킨키]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:시라이시_킨키]], ARG, ARG:2

;Data\ERB\RPG\依頼\REQUEST_95_近畿霊務局\REQUEST_95_26_神社ルート７.ERB
@SET_BASE_[[キャラ:시라이시_킨키]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
	 	CFLAG:ARG:피조교횟수 = 1
		CFLAG:ARG:의존도 = 1000
		MARK:ARG:굴복각인 = 3
		TALENT:ARG:즉각함락 = 1
		ABL:ARG:순종 = 3
		EXP:ARG:애정경험 += 15
		EXP:ARG:Ｖ경험 += 3
		ABL:ARG:Ｖ감각 = 1
		TALENT:ARG:처녀 = 0
		EXP:ARG:키스경험 = 10
		EXP:ARG:절정경험 = 5
		EXP:ARG:성교경험 = 1
		EXP:ARG:질사경험 = 3
		EXP:ARG:정액경험 = 3
		EXP:ARG:펠라경험 = 1
		CALL SET_陥落素質, ARG, "연모"
	CASE 2
		;竿なしの場合。処女のまま全身くまなくprprされたイメージで。
		CFLAG:ARG:의존도 = 1000
		MARK:ARG:굴복각인 = 3
		TALENT:ARG:즉각함락 = 1
		ABL:ARG:순종 = 3
		EXP:ARG:애정경험 += 15
		EXP:ARG:키스경험 = 10
		ABL:ARG:Ｃ감각 = 3
		ABL:ARG:Ｂ감각 = 3
		ABL:ARG:Ａ감각 = 1
		EXP:ARG:Ａ경험 += 5
		EXP:ARG:레즈경험 += 3
		EXP:ARG:절정경험 = 5
		EXP:ARG:성교경험 = 1
		CALL SET_陥落素質, ARG, "연모"
ENDSELECT