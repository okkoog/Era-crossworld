;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:쟌느・얼터]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_EX_1")
			RETURNF ""	
		RESULTS_F = 一臨
		RESULTS_F:1 = ジャンヌ・オルタ_FACE_1
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_5")
			RETURNF ""
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_6")
			RETURNF ""
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_EX_3")
			RETURNF ""	
		RESULTS_F = 三臨
		RESULTS_F:1 = ジャンヌ・オルタ_FACE_4
	CASE 2
		;画像チェック
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_7")
			RETURNF ""
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_8")
			RETURNF ""
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_9")
			RETURNF ""
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_EX_4")
			RETURNF ""
		SIF !SPRITECREATED("ジャンヌ・オルタ_FACE_EX_5")
			RETURNF ""	
		RESULTS_F = 신주쿠
		RESULTS_F:1 = ジャンヌ・オルタ_FACE_7
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:쟌느・얼터]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "一臨"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ジャンヌ・オルタ_FACE_2
			CASEELSE
				SELECTCASE L_SITUATION:1
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = ジャンヌ・オルタ_FACE_2
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ジャンヌ・オルタ_FACE_3
						RESULT_F:1 = 1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = ジャンヌ・オルタ_FACE_EX_0
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = ジャンヌ・オルタ_FACE_EX_1
					;通常時
					CASEELSE
						RESULTS_F = ジャンヌ・オルタ_FACE_1
				ENDSELECT
		ENDSELECT
	CASE "三臨"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ジャンヌ・オルタ_FACE_5
			CASEELSE
				SELECTCASE L_SITUATION:1
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = ジャンヌ・オルタ_FACE_5
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ジャンヌ・オルタ_FACE_6
						RESULT_F:1 = 1
					;睡眠にされた時
					CASE "SLEEP"
						RESULTS_F = ジャンヌ・オルタ_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = ジャンヌ・オルタ_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = ジャンヌ・オルタ_FACE_4
				ENDSELECT
		ENDSELECT
	CASE "신주쿠"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ジャンヌ・オルタ_FACE_8
			CASEELSE
				SELECTCASE L_SITUATION:1
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = ジャンヌ・オルタ_FACE_8
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ジャンヌ・オルタ_FACE_9
						RESULT_F:1 = 1
					;睡眠にされた時
					CASE "SLEEP"
						RESULTS_F = ジャンヌ・オルタ_FACE_EX_4
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = ジャンヌ・オルタ_FACE_EX_5
					;通常時
					CASEELSE
						RESULTS_F = ジャンヌ・オルタ_FACE_7
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT