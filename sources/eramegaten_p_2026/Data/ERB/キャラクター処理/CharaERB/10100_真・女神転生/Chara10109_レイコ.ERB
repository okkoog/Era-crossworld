;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:레이코]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:레이코]], ARG, ARG:2
CALL SET_BTL_TALENT_[[キャラ:레이코]], ARG, ARG:2
CALL SET_LEARN_SKILL_[[キャラ:레이코]], ARG, ARG:2

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:레이코]], ARG, ARG:1
IF ARG:1 == 1 
	CALL SET_TALENT_PARTY_JOINABLE, ARG, "参加可能"
	TALENT:ARG:매혹 = 1
ENDIF

@SET_BTL_TALENT_[[キャラ:레이코]], ARG, ARG:1
IF ARG:1 == 1
	CALL CHANGE_ROLE, ARG, "이능자_5/도구지식_3/마술의소양_2", , "인간", "サブ素質引継ぎなし"
ENDIF

@SET_LEARN_SKILL_[[キャラ:레이코]], ARG, ARG:1
IF ARG:1 == 2
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	CALL SET_LEARN_SKILL, ARG, "코우하", 6
	CALL SET_LEARN_SKILL, ARG, "파트라", 6
	CALL SET_LEARN_SKILL, ARG, "메・디아", 10
	CALL SET_LEARN_SKILL, ARG, "바이쳐・더스트", 10
	CALL SET_LEARN_SKILL, ARG, "지옥떨구기", 14
	CALL SET_LEARN_SKILL, ARG, "리캄", 20
	CALL SET_LEARN_SKILL, ARG, "얼음의난무", 26
	CALL SET_LEARN_SKILL, ARG, "부흐다인", 36
	CALL SET_LEARN_SKILL, ARG, "델타포스", 44
	CALL SET_LEARN_SKILL, ARG, "메・디아라한", 50
	CALL SET_LEARN_SKILL, ARG, "암리타", 56
	CALL SET_LEARN_SKILL, ARG, "티타노마키아", 62
	CALL SET_LEARN_SKILL, ARG, "너버스엣지", 66
	CALL SET_LEARN_SKILL, ARG, "극한동결", 72 
ENDIF
