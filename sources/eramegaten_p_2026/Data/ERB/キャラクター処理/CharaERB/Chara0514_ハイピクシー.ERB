;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:하이픽시]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ハイピクシー_FACE_8")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_9")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_3")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = ハイピクシー_FACE_8
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("ハイピクシー_FACE_10")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_11")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_4")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_5")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_6")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_7")
			RETURNF ""
		RESULTS_F = ライドウ
		RESULTS_F:1 = ハイピクシー_FACE_10
	CASE 2
		;画像チェック
		SIF !SPRITECREATED("ハイピクシー_FACE_12")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_13")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_8")
			RETURNF ""
		RESULTS_F = ピクシー
		RESULTS_F:1 = ハイピクシー_FACE_12
	CASE 3
		;画像チェック
		SIF !SPRITECREATED("ハイピクシー_FACE_14")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_15")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_9")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_10")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_11")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_12")
			RETURNF ""
		RESULTS_F = SHピクシー
		RESULTS_F:1 = ハイピクシー_FACE_14
	CASE 4
		;画像チェック
		SIF !SPRITECREATED("ハイピクシー_FACE_16")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_17")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_13")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_14")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_15")
			RETURNF ""
		SIF !SPRITECREATED("ハイピクシー_FACE_EX_16")
			RETURNF ""
		RESULTS_F = DSピクシー
		RESULTS_F:1 = ハイピクシー_FACE_16
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:하이픽시]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ハイピクシー_FACE_9
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ハイピクシー_FACE_EX_0
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = ハイピクシー_FACE_EX_1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = ハイピクシー_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = ハイピクシー_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = ハイピクシー_FACE_8
				ENDSELECT
		ENDSELECT
	CASE "ライドウ"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ハイピクシー_FACE_11
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ハイピクシー_FACE_EX_4
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = ハイピクシー_FACE_EX_5
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = ハイピクシー_FACE_EX_6
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = ハイピクシー_FACE_EX_7
					;通常時
					CASEELSE
						RESULTS_F = ハイピクシー_FACE_10
				ENDSELECT
		ENDSELECT
	CASE "ピクシー"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ハイピクシー_FACE_13
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ハイピクシー_FACE_EX_8
						;DYINGでの色相変換を回避させるための指定
						RESULT_F:1 = 1
					;通常時
					CASEELSE
						RESULTS_F = ハイピクシー_FACE_12
				ENDSELECT
		ENDSELECT
	CASE "SHピクシー"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ハイピクシー_FACE_15
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ハイピクシー_FACE_EX_9
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = ハイピクシー_FACE_EX_10
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = ハイピクシー_FACE_EX_11
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = ハイピクシー_FACE_EX_12
					;通常時
					CASEELSE
						RESULTS_F = ハイピクシー_FACE_14
				ENDSELECT
		ENDSELECT
	CASE "DSピクシー"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ハイピクシー_FACE_17
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ハイピクシー_FACE_EX_13
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = ハイピクシー_FACE_EX_14
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = ハイピクシー_FACE_EX_15
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = ハイピクシー_FACE_EX_16
					;通常時
					CASEELSE
						RESULTS_F = ハイピクシー_FACE_16
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT
