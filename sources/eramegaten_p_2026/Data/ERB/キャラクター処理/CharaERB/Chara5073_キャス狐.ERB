;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:캐스여우]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("キャス狐_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("キャス狐_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("キャス狐_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("キャス狐_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("キャス狐_FACE_EX_1")
			RETURNF ""
		RESULTS_F = 一臨
		RESULTS_F:1 = キャス狐_FACE_2
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("キャス狐_FACE_7")
			RETURNF ""
		SIF !SPRITECREATED("キャス狐_FACE_8")
			RETURNF ""
		SIF !SPRITECREATED("キャス狐_FACE_9")
			RETURNF ""
		SIF !SPRITECREATED("キャス狐_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("キャス狐_FACE_EX_3")
			RETURNF ""
		RESULTS_F = 三臨
		RESULTS_F:1 = キャス狐_FACE_7
	CASE 2
		;画像チェック
		SIF !SPRITECREATED("キャス狐_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("キャス狐_FACE_1")
			RETURNF ""
		RESULTS_F = 旧画像
		RESULTS_F:1 = キャス狐_FACE_0
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:캐스여우]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "一臨"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = キャス狐_FACE_3
			CASEELSE
				SELECTCASE L_SITUATION:1
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = キャス狐_FACE_3
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = キャス狐_FACE_4
						RESULT_F:1 = 1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = キャス狐_FACE_EX_0
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = キャス狐_FACE_EX_1
					;通常時
					CASEELSE
						RESULTS_F = キャス狐_FACE_2
				ENDSELECT
		ENDSELECT
	CASE "三臨"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = キャス狐_FACE_8
			CASEELSE
				SELECTCASE L_SITUATION:1
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = キャス狐_FACE_8
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = キャス狐_FACE_9
						RESULT_F:1 = 1
					;睡眠にされた時
					CASE "SLEEP"
						RESULTS_F = キャス狐_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = キャス狐_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = キャス狐_FACE_7
				ENDSELECT
		ENDSELECT
	CASE "旧画像"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = キャス狐_FACE_1
			CASEELSE
				SELECTCASE L_SITUATION:1
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = キャス狐_FACE_1
					;通常時
					CASEELSE
						RESULTS_F = キャス狐_FACE_0
					ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT