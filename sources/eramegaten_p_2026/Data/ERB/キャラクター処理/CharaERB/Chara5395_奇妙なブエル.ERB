;キャラクター独自変数名称定義関数
;-------------------------------------------------
@RPG_CFLAG_NAME_[[キャラ:비묘한부에르]], ARGS, ARG
#FUNCTIONS
SELECTCASE ARGS
	;---------------------------------------------
	;RPG_CFLAG_EV
	;周回時にリセットされる数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_EV
	;周回時にリセットされる文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CFLAG_TAKEOVER
	;周回時にリセットされない数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 命の星座
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_TAKEOVER
	;周回時にリセットされない文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる数値型変数です
	;スキルゲージHとほぼ互換です。基本的にはゲージHが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "RPG_CFLAG_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = 元素スキル再使用可能ターン
			CASE 1
				RESULTS = 元素爆発再使用可能ターン
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる文字列型変数です
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "RPG_CSTR_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる数値型変数
	;スキルゲージFとほぼ互換です。基本的にはゲージFが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "RPG_CFLAG_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる文字列型変数
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "RPG_CSTR_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
ENDSELECT
RETURNF RESULTS

