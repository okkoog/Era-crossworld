		TALENT:ARG:꼬리 = 1
		
		;무인
		ABL:ARG:회화타입 = 311
		
		;メガインテリメガネを産む！
		ABL:ARG:수태아이템 = 5022
		
		CSTR:ARG:11 = 私
		CSTR:ARG:12 = お前
		
		;마왕→魔獣へ
		CSTR:ARG:종족명 = 마수
		
		CSTR:ARG:타이틀 = 巨根の牝牛
		CSTR:ARG:43 = この個体は、真上水紀の身体を母体として召喚された特別な悪魔である。
		
		CSTR:ARG:45 = イレギュラーな召喚により、身体や精神に変調があるものの、その能力は通常の個体より高い。
		CSTR:ARG:46 = ただし、その分、気位や凶暴さもこちらの方が上であり、扱いは慎重に行う必要がある。
		
		NAME:ARG = ミズキ
		CALLNAME:ARG = ミズキ
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:미노타우로스]], ARG, ARG:1
#DIM LCOUNT
;ミズキ
IF ARG:1 == 1
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	FOR LCOUNT, 1, 21
		SIF CSVABL(NO:ARG, GETNUM(ABL, @"스킬{LCOUNT}")) == 0
			CONTINUE
		CALL SET_LEARN_SKILL, ARG, TOSTR(CSVABL(NO:ARG, GETNUM(ABL, @"스킬{LCOUNT}"))), 1
	NEXT
	FOR LCOUNT, 1, 21
		SIF CSVABL(NO:ARG, GETNUM(ABL, @"습득스킬{LCOUNT}")) == 0
			CONTINUE
		CALL SET_LEARN_SKILL, ARG, TOSTR(CSVABL(NO:ARG, GETNUM(ABL, @"습득스킬{LCOUNT}"))), CSVABL(NO:ARG, GETNUM(ABL, @"습득LV{LCOUNT}"))	
	NEXT
	CALL SET_LEARN_SKILL, ARG, "길로틴블레이드", 60
	CALL SET_LEARN_SKILL, ARG, "이할의활천", 65
	CALL SET_LEARN_SKILL, ARG, "육탄", 70
ENDIF

