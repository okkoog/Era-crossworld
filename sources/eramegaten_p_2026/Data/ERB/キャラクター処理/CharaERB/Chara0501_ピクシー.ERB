;4,7,11は漫画版(鳩の戦記・魔神転生)の固有ピクシーのアイコンっぽいんで汎用からは外しておく
@SET_ENEMY_[[キャラ:픽시]], L_CHARA
#DIM DYNAMIC L_CHARA
#DIM CONST FACE_TABLE = 0, 1, 2, 17, 20, 21, 22, 23, 26, 28
#DIM DYNAMIC L_FACE
CALL 顔グラ追加, NO:L_CHARA
L_FACE = FACE_TABLE:(RAND:VARSIZE("FACE_TABLE"))
SIF !SPRITECREATED(@"ピクシー_FACE_{L_FACE}")
	L_FACE = 0
CSTR:L_CHARA:基本アイコンファイルネーム '= @"ピクシー_FACE_{L_FACE}"
CSTR:L_CHARA:調教アイコンファイルネーム '= @"ピクシー_FACE_{L_FACE}"
SELECTCASE L_FACE
	CASE 0, 22, 28
		CALL 初期衣装セット, L_CHARA, "후드", "원피스", "장갑", "브래지어", "팬티", "사이하이삭스", "부츠", "머플러"
	CASE 1, 2, 20, 23
		CALL 初期衣装セット, L_CHARA, "레오타드", "엘보글러브", "사이하이삭스", "뮬"
	CASE 17, 21, 26
		CALL 初期衣装セット, L_CHARA, "터틀넥", "장갑", "슬랙스", "브래지어", "팬티","부츠"
		ABL:L_CHARA:회화타입 = 304
ENDSELECT

