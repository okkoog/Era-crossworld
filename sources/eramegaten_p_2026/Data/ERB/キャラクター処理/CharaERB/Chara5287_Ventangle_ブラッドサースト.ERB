;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:블러드서스트]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ブラッドサースト_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("ブラッドサースト_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("ブラッドサースト_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("ブラッドサースト_FACE_TS_0")
			RETURNF ""
		RESULTS_F = デフォルト
		IF IS_MALE(L_CHARA)
			RESULTS_F:1 = ブラッドサースト_FACE_TS_0
		ELSE
			RESULTS_F:1 = ブラッドサースト_FACE_0
		ENDIF
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:블러드서스트]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		IF IS_MALE(L_CHARA)
			RESULTS_F = ブラッドサースト_FACE_TS_0
		ELSE
			SELECTCASE L_SITUATION
				CASE "調教"
					RESULTS_F = ブラッドサースト_FACE_1
				CASEELSE
					IF IS_BADSTATE(L_CHARA, "CHARM")
						RESULTS_F = ブラッドサースト_FACE_1
					ELSE
						RESULTS_F = ブラッドサースト_FACE_0
					ENDIF
			ENDSELECT
		ENDIF
	CASEELSE
ENDSELECT