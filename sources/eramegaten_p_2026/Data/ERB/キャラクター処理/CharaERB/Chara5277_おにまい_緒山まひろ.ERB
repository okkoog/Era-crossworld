;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:마히로]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("まひろ_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("まひろ_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("まひろ_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("まひろ_FACE_5")
			RETURNF ""
		RESULTS_F = 레오타드
		RESULTS_F:1 = まひろ_FACE_4
	CASE 1
		SIF !SPRITECREATED("まひろ_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("まひろ_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("まひろ_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("まひろ_FACE_3")
			RETURNF ""
		RESULTS_F = ジッパー
		RESULTS_F:1 = まひろ_FACE_2
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:마히로]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "레오타드"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = まひろ_FACE_1
			CASEELSE
				IF CFLAG:L_CHARA:악마변신
					RESULTS_F = まひろ_FACE_4
					IF IS_BADSTATE(L_CHARA, "CHARM")
						RESULTS_F = まひろ_FACE_5
					ENDIF
				ELSEIF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = まひろ_FACE_1
				ELSE
					RESULTS_F = まひろ_FACE_0
				ENDIF
		ENDSELECT
	CASE "ジッパー"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = まひろ_FACE_1
			CASEELSE
				IF CFLAG:L_CHARA:악마변신
					RESULTS_F = まひろ_FACE_2
					IF IS_BADSTATE(L_CHARA, "CHARM")
						RESULTS_F = まひろ_FACE_3
					ENDIF
				ELSEIF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = まひろ_FACE_1
				ELSE
					RESULTS_F = まひろ_FACE_0
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT