@EVENT_CHANGE_TRAIN_TALENT_[[キャラ:마히로]], ARG, ARGS, ARGS:1 = "GET"
IF GROUPMATCH(ARGS, "연모", "음란", "복종") && !IS_MALE(ARG) && TALENT:ARG:캐릭터고유소질1 > 0
	TALENT:ARG:캐릭터고유소질1 = 0
	TALENT:ARG:캐릭터고유소질2 = 1
	CSTR:ARG:캐릭터고유소질정의2 '= "おしまい/体質/お兄ちゃんはおしまい！"
	PRINTFORMW %NAME:ARG%의 【오빠】는 【끝】이 되었다
ENDIF
