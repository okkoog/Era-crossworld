;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:빈센트]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ヴィンセント_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("ヴィンセント_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("ヴィンセント_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("ヴィンセント_FACE_5")
			RETURNF ""
		SIF !SPRITECREATED("ヴィンセント_FACE_6")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = ヴィンセント_FACE_2
	CASEELSE
		RESULTS_F = 
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:빈센트]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ヴィンセント_FACE_3
			CASEELSE
				SELECTCASE L_SITUATION:1
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = ヴィンセント_FACE_3
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ヴィンセント_FACE_5
						RESULT_F:1 = 1
					;睡眠にされた時
					CASE "SLEEP"
						RESULTS_F = ヴィンセント_FACE_6
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = ヴィンセント_FACE_4
					;通常時
					CASEELSE
						RESULTS_F = ヴィンセント_FACE_2
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT
