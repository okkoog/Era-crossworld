;TYPE(공격상성)は変動要素が激しいので特定相性の変換を行う場合は継承タイプから見ること
@COVERT_SKILL_ATTACKTYPE_CHARA_[[キャラ:라비안_시니시스타1]], L_SKILLS, L_CHARA
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_SKILLS
CALL GETS_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILLS, L_CHARA
SIF RESULT == GET_SUCCESSION_NUM("검격")
	RETURN GET_攻撃タイプ_NUM("魔法")
RETURN 0

@SKILL_ADD_TYPE_IN_CALK_CHARA_[[キャラ:라비안_시니시스타1]], L_SKILLS, L_CHARA, IS_BADSTATE = 0, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_SKILLS
#DIM DYNAMIC IS_BADSTATE
#DIM REF L_TYPE
CALL GETS_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILLS, L_CHARA
SIF RESULT == GET_SUCCESSION_NUM("검격")
	RETURN GET_TYPE_NUM("파마")
RETURN -1

