;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:마리_블루아카]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("マリー_ブルアカ_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("マリー_ブルアカ_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("マリー_ブルアカ_FACE_2")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = マリー_ブルアカ_FACE_0
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("マリー_ブルアカ_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("マリー_ブルアカ_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("マリー_ブルアカ_FACE_5")
			RETURNF ""
		RESULTS_F = 체육복
		RESULTS_F:1 = マリー_ブルアカ_FACE_3
	CASE 2
		;画像チェック
		SIF !SPRITECREATED("マリー_ブルアカ_FACE_6")
			RETURNF ""
		SIF !SPRITECREATED("マリー_ブルアカ_FACE_7")
			RETURNF ""
		SIF !SPRITECREATED("マリー_ブルアカ_FACE_8")
			RETURNF ""
		RESULTS_F = アイドル
		RESULTS_F:1 = マリー_ブルアカ_FACE_6
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:마리_블루아카]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = マリー_ブルアカ_FACE_1
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = マリー_ブルアカ_FACE_1
				ELSEIF L_SITUATION:1 == "DYING"
					RESULTS_F = マリー_ブルアカ_FACE_2
					;DYINGでの色相変換を回避させるための指定
					RESULT_F:1 = 1
				ELSE
					RESULTS_F = マリー_ブルアカ_FACE_0
				ENDIF
		ENDSELECT
	CASE "체육복"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = マリー_ブルアカ_FACE_4
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = マリー_ブルアカ_FACE_4
				ELSEIF L_SITUATION:1 == "DYING"
					RESULTS_F = マリー_ブルアカ_FACE_5
					;DYINGでの色相変換を回避させるための指定
					RESULT_F:1 = 1
				ELSE
					RESULTS_F = マリー_ブルアカ_FACE_3
				ENDIF
		ENDSELECT
	CASE "アイドル"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = マリー_ブルアカ_FACE_7
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = マリー_ブルアカ_FACE_7
				ELSEIF L_SITUATION:1 == "DYING"
					RESULTS_F = マリー_ブルアカ_FACE_8
					;DYINGでの色相変換を回避させるための指定
					RESULT_F:1 = 1
				ELSE
					RESULTS_F = マリー_ブルアカ_FACE_6
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT