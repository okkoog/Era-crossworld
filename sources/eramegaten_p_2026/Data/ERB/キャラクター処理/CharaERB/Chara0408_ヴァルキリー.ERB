;--------------------------------------------------
;イベントフラグ
;1 = エノク(ダンジョン:コオリノハテで加入する個体)
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:발키리]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:발키리]], ARG, ARG:2
IF ARG:2 == 1
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:발키리]], ARG, ARG:2

@SHOP_NEWGAME_INITCHARA_[[キャラ:발키리]], ARG
CALL SET_LEARN_SKILL_[[キャラ:발키리]], ARG, CFLAG:ARG:이벤트가입

;Data\ERB\RPG\闘技場\CLOSSEUM_30_デスマッチ.ERB
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:발키리]], ARG, ARG:1
#DIM DYNAMIC LCOUNT
SELECTCASE ARG:1
	CASE 1
		TALENT:ARG:교활 = 1

		TALENT:ARG:전격 = 1
		TALENT:ARG:빙결 = 0
		BASE:ARG:전격 = 50
		BASE:ARG:빙결 = 100
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:발키리]], ARG, ARG:1
#DIM LCOUNT
IF ARG:1 == 1
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	CALL SET_LEARN_SKILL, ARG, "번개찌르기", 1
	CALL SET_LEARN_SKILL, ARG, "자벨린레인", 1
	CALL SET_LEARN_SKILL, ARG, "지오다인", 1
	CALL SET_LEARN_SKILL, ARG, "맹반격", 1

	CALL SET_LEARN_SKILL, ARG, "난심의일도",57
	CALL SET_LEARN_SKILL, ARG, "라쿠카쟈오토",58
	CALL SET_LEARN_SKILL, ARG, "스쿠카쟈오토", 60
	CALL SET_LEARN_SKILL, ARG, "테트라칸", 61
ENDIF