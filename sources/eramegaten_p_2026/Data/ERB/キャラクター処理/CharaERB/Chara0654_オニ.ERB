	CALL CLEAR_ALL_LEARN_SKILL, ARG
	CALL SET_LEARN_SKILL, ARG, "메・디아", 1
	CALL SET_LEARN_SKILL, ARG, "데・카쟈", 16
	CALL SET_LEARN_SKILL, ARG, "라쿠・카쟈", 18
