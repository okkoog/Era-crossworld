;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:창조주_X2]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:창조주_X2]], ARG, ARG:2
CALL SET_BTL_TALENT_[[キャラ:창조주_X2]], ARG, ARG:2

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:창조주_X2]], ARG, ARG:1
IF ARG:1 == 0
	NAME:ARG = アキュラ(X2)
	CALLNAME:ARG = アキュラ(X2)
	;そのままだとフラットすぎるので多少上げ下げ
	BASE:ARG:검격 = 50
	MAXBASE:ARG:검격 = 50
	BASE:ARG:타격 = 0
	MAXBASE:ARG:타격 = 0
	BASE:ARG:전술 = 0
	MAXBASE:ARG:전술 = 0
	BASE:ARG:파마 = 150
	MAXBASE:ARG:파마 = 150
	BASE:ARG:지변 = 150
	MAXBASE:ARG:지변 = 150
	BASE:ARG:중력 = 150
	MAXBASE:ARG:중력 = 150
	CSTR:ARG:44 = 彼が今際の際に遺した後悔を核として、マグネタイトで構築された肉体を持つ。
	CSTR:ARG:45 = 言ってしまえば気力一つで動いているような状態であり、いつ消え去ってもおかしくなかった。
	CSTR:ARG:46 = %CALLNAME:MASTER%によって魂をドリー・カドモンへ封入されたことで、
	CSTR:ARG:47 = 彼は悪魔として新生したのである。
ENDIF
@SET_BTL_TALENT_[[キャラ:창조주_X2]], ARG, ARG:1
IF ARG:1 == 0
	TALENT:ARG:달인 = 1
	TALENT:ARG:공격의심득 = 0
	TALENT:ARG:무도의마음가짐 = 3
	TALENT:ARG:방어의심득 = 3
	TALENT:ARG:바이탈부스터 = 3
ENDIF

;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:창조주_X2]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("創造主_X2_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("創造主_X2_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("創造主_X2_FACE_EX_0")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = 創造主_X2_FACE_0
	CASEELSE
		RESULTS_F = 
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:창조주_X2]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "FACE_EX_0"
				RESULTS_F '= "創造主_X2_FACE_EX_0"
			CASE "FACE_1"
				RESULTS_F '= "創造主_X2_FACE_1"
			CASEELSE
				RESULTS_F '= "創造主_X2_FACE_0"
		ENDSELECT
	CASEELSE
ENDSELECT
