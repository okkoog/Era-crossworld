;-----------------------------------------------------
;セット関数
;SET_RPG_CFLAG_XX のXXの部分にEV・TAKEOVER、BTL, DUNGEONをいれて変数指定
;ARG = キャラ番号
;ARGS = フラグ名
;ARG:1 = 計算に使う数値　デフォルトでは代入
;ARGS:1 = "=, +=, -=, *=, /="  左の文字列を指定することで四則演算をさせられます
;
;式中関数版を通過しているのはデバッグコンソールから直接操作をするためです
;SET_RPG_CFLAG_EV_F(TARGET, "test")のように使ってください
;-----------------------------------------------------
@SET_RPG_CFLAG_EV, ARG, ARGS, ARG:1, ARGS:1 = "SET"
CALLFORMF SET_RPG_CFLAG_EV_F, ARG, ARGS, ARG:1, ARGS:1

@SET_RPG_CFLAG_EV_F, ARG, ARGS, ARG:1, ARGS:1 = "SET"
#FUNCTION
CALLFORMF SET_RPG_CFLAG_F, ARG, ARGS, ARG:1, "RPG_CFLAG_EV", ARGS:1

;-----------------------------------------------------
@SET_RPG_CFLAG_TAKEOVER, ARG, ARGS, ARG:1, ARGS:1 = "SET"
CALLFORMF SET_RPG_CFLAG_TAKEOVER_F, ARG, ARGS, ARG:1, ARGS:1

@SET_RPG_CFLAG_TAKEOVER_F, ARG, ARGS, ARG:1, ARGS:1 = "SET"
#FUNCTION
CALLFORMF SET_RPG_CFLAG_F, ARG, ARGS, ARG:1, "RPG_CFLAG_TAKEOVER", ARGS:1

;-----------------------------------------------------
@SET_RPG_CFLAG_BTL, ARG, ARGS, ARG:1, ARGS:1 = "SET"
CALLFORMF SET_RPG_CFLAG_BTL_F, ARG, ARGS, ARG:1, ARGS:1

@SET_RPG_CFLAG_BTL_F, ARG, ARGS, ARG:1, ARGS:1 = "SET"
#FUNCTION
CALLFORMF SET_RPG_CFLAG_F, ARG, ARGS, ARG:1, "RPG_CFLAG_BTL", ARGS:1

;-----------------------------------------------------
@SET_RPG_CFLAG_DUNGEON, ARG, ARGS, ARG:1, ARGS:1 = "SET"
CALLFORMF SET_RPG_CFLAG_DUNGEON_F, ARG, ARGS, ARG:1, ARGS:1

@SET_RPG_CFLAG_DUNGEON_F, ARG, ARGS, ARG:1, ARGS:1 = "SET"
#FUNCTION
CALLFORMF SET_RPG_CFLAG_F, ARG, ARGS, ARG:1, "RPG_CFLAG_DUNGEON", ARGS:1

;-----------------------------------------------------
;本体
;-----------------------------------------------------
@SET_RPG_CFLAG_F, ARG, ARGS, ARG:1, ARGS:1, ARGS:2 = "SET"
#FUNCTION
#DIM LCOUNT
#DIMS STOCK_RESULTS
SIF !EXISTFUNCTION(@"RPG_CFLAG_NAME_{NO:ARG}")
	RETURNF 0
STOCK_RESULTS '= RESULTS
FOR LCOUNT, 0, VARSIZE(ARGS:1)
	CALLFORMF RPG_CFLAG_NAME_{NO:ARG}, ARGS:1, LCOUNT
	SIF RESULTS != ARGS
		CONTINUE
	RESULTS '= STOCK_RESULTS
	SELECTCASE ARGS:1
		CASE "RPG_CFLAG_EV"
			SELECTCASE ARGS:2
				CASE "SET", "="
					RPG_CFLAG_EV:ARG:LCOUNT = ARG:1
				CASE "ADD", "+", "+="
					RPG_CFLAG_EV:ARG:LCOUNT += ARG:1
				CASE "SUB", "SUBTRACITON", "-", "-="
					RPG_CFLAG_EV:ARG:LCOUNT -= ARG:1
				CASE "MUL", "MULTI", "*", "*="
					RPG_CFLAG_EV:ARG:LCOUNT *= ARG:1
				CASE "DIV", "DIVISION", "/", "/="
					RPG_CFLAG_EV:ARG:LCOUNT /= ARG:1
			ENDSELECT
		CASE "RPG_CFLAG_TAKEOVER"
			SELECTCASE ARGS:2
				CASE "SET", "="
					RPG_CFLAG_TAKEOVER:ARG:LCOUNT = ARG:1
				CASE "ADD", "+", "+="
					RPG_CFLAG_TAKEOVER:ARG:LCOUNT += ARG:1
				CASE "SUB", "SUBTRACITON", "-", "-="
					ROLE_CFLAG_TAKEOVER:ARG:LCOUNT -= ARG:1
				CASE "MUL", "MULTI", "*", "*="
					RPG_CFLAG_TAKEOVER:ARG:LCOUNT *= ARG:1
				CASE "DIV", "DIVISION", "/", "/="
					RPG_CFLAG_TAKEOVER:ARG:LCOUNT /= ARG:1
			ENDSELECT
		CASE "RPG_CFLAG_BTL"
			SELECTCASE ARGS:2
				CASE "SET", "="
					RPG_CFLAG_BTL:ARG:LCOUNT = ARG:1
				CASE "ADD", "+", "+="
					RPG_CFLAG_BTL:ARG:LCOUNT += ARG:1
				CASE "SUB", "SUBTRACITON", "-", "-="
					RPG_CFLAG_BTL:ARG:LCOUNT -= ARG:1
				CASE "MUL", "MULTI", "*", "*="
					RPG_CFLAG_BTL:ARG:LCOUNT *= ARG:1
				CASE "DIV", "DIVISION", "/", "/="
					RPG_CFLAG_BTL:ARG:LCOUNT /= ARG:1
			ENDSELECT
		CASE "RPG_CFLAG_DUNGEON"
			SELECTCASE ARGS:2
				CASE "SET", "="
					RPG_CFLAG_DUNGEON:ARG:LCOUNT = ARG:1
				CASE "ADD", "+", "+="
					RPG_CFLAG_DUNGEON:ARG:LCOUNT += ARG:1
				CASE "SUB", "SUBTRACITON", "-", "-="
					RPG_CFLAG_DUNGEON:ARG:LCOUNT -= ARG:1
				CASE "MUL", "MULTI", "*", "*="
					RPG_CFLAG_DUNGEON:ARG:LCOUNT *= ARG:1
				CASE "DIV", "DIVISION", "/", "/="
					RPG_CFLAG_DUNGEON:ARG:LCOUNT /= ARG:1
			ENDSELECT
	ENDSELECT
	RETURNF 1
NEXT

RETURNF 0


