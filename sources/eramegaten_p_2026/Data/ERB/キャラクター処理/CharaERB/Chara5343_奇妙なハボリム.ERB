;
;	Module		:Chara5343_奇妙なハボリム.ERB
;	Facility	:ERB上から独自の変更をキャラクターに与える
;				:与えられる補正自体はスキルでパッシブの補正として持たさられるものなので原理的にはスキル枠を消費しないスキル
;				;あるいはスキル削除が通用しないスキルとなる。あえて排除しない場合、ペルソナ・リンク悪魔として利用しているときにも呼ばれるのに注意
;
;	Licence		:ライセンスフリー。
;
;	Modification Data:
;
;	Edit	Date			Author				Reason
;	001		2025/01/03		Schrott				新規作成
;	Comment
;	
;	仕様書：
;	通常攻撃「命を紡ぐ炎」：
;		モード『古名開放』中は「通常攻撃：双駆輪」となり、火炎属性によるダメージになる。
;	元素スキル「名を称える刻」：
;		このスキルのゲージをキーに、元素スキルの挙動を変化。
;		モード『神名開放』：敵単体に火炎属性攻撃を行い、自分の攻撃に対し火炎属性で追撃を行う。
;		モード『古名開放』：敵単体に火炎属性攻撃を行い、自分の通常攻撃を『火炎属性によるより強力な攻撃』に変更する。
;		持続時間４ターン。
;		星座１：攻撃アップ
;		星座２：攻撃対象の防御をダウン
;		星座５：ダメージ量アップ
;		星座６：追撃ヒット数２回、古名開放攻撃アップ、持続ターンアップ
;	元素爆発「天を焦がす刻」：
;		敵１列に火炎属性攻撃。仲間全体の攻撃を１段階上げる。
;		更に自身のダメージ量アップバフを獲得する。効果時間４ターン
;		星座２：攻撃アップ
;		星座３：攻撃アップ
;		星座４：ダメージアップバフ強化
;		星座６：攻撃アップ
;	獲得後、ガチャを回すことでのみ手に入る『命の星座』によるパッシブ強化効果を獲得する。
;	命の星座
;	１重　「夜の主の授記」
;	　　　元素スキル『名を称える刻』を発動した際、自身の攻撃力を１段階アップさせる。

;	２重　「灰燼の代償」
;	　　　元素スキル『名を称える刻』を発動した際、攻撃対象の防御力を１段階ダウンさせる
;	　　　また、モード『古名開放』及び元素爆発『天を焦がす刻』のダメージ量アップ。
;
;	３重　「燃え盛る太陽」
;	　　　元素爆発『天を焦がす刻』のダメージ量アップ。

;	４重　「指導者の覚悟」
;	　　　元素爆発『天を焦がす刻』の、自身のダメージ量アップバフを強化する。

;	５重　「真実の意味」
;	　　　元素スキル『名を称える刻』のダメージ量アップ

;	６重　「『人の名』開放」
;	　　　元素スキル『名を称える刻』に対し、以下の効果を追加する。
;	　　　モード『神名開放』の追撃のヒット数が２回になる。
;	　　　モード『古名開放』の攻撃力が上がる。
;	　　　両方のモードにおいて、持続ターンが２ターン伸びる。
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;--------------------------------------------------
;キャラクター独自変数名称定義関数
;-------------------------------------------------
@RPG_CFLAG_NAME_[[キャラ:기묘한하보림]], ARGS, ARG
#FUNCTIONS
SELECTCASE ARGS
	;---------------------------------------------
	;RPG_CFLAG_EV
	;周回時にリセットされる数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_EV
	;周回時にリセットされる文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CFLAG_TAKEOVER
	;周回時にリセットされない数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 命の星座
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_TAKEOVER
	;周回時にリセットされない文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる数値型変数です
	;スキルゲージHとほぼ互換です。基本的にはゲージHが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "RPG_CFLAG_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = 元素スキル再使用可能ターン
			CASE 1
				RESULTS = 元素爆発再使用可能ターン
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる文字列型変数です
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "RPG_CSTR_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる数値型変数
	;スキルゲージFとほぼ互換です。基本的にはゲージFが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "RPG_CFLAG_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる文字列型変数
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "RPG_CSTR_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
ENDSELECT
RETURNF RESULTS

