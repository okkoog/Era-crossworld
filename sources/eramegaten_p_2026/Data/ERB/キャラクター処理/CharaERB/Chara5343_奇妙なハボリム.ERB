;	固有スキルを起動することで顔グラが変化する。
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:기묘한하보림]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("奇妙なハボリム_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("奇妙なハボリム_FACE_EX_0")
			RETURNF ""
		RESULTS_F = 諸火武装変身
		;アイコン設定時の表示に使うアイコン
		RESULTS_F:1 = 奇妙なハボリム_FACE_0
	CASEELSE
		RETURNF ""
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:기묘한하보림]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "諸火武装変身"
		IF TFLAG:전투중 && SKILLGAGE_D_GET(L_CHARA, [[스킬:전용기2]])
			RESULTS_F = 奇妙なハボリム_FACE_EX_0
		ELSE
			RESULTS_F = 奇妙なハボリム_FACE_0
		ENDIF
	CASEELSE
ENDSELECT
