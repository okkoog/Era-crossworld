;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:브리게이드_X2]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:브리게이드_X2]], ARG, ARG:2

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:브리게이드_X2]], ARG, ARG:1
IF ARG:1 == 0
	NAME:ARG = ブリガド
	CALLNAME:ARG = ブリガド
	;機械から悪魔になったため電撃弱点を通常に、神経と呪殺を耐性に
	BASE:ARG:전격 = 100
	MAXBASE:ARG:전격 = 100
	BASE:ARG:신경 = 50
	MAXBASE:ARG:신경 = 50
	BASE:ARG:주살 = 50
	MAXBASE:ARG:주살 = 50
	CFLAG:ARG:초기옷 = 0
	CFLAG:ARG:옷 = 0
	TEQUIP:ARG:옷 = 0
	CFLAG:ARG:초기하의 = [[衣装:하프팬츠]]
	CFLAG:ARG:하의 = [[衣装:하프팬츠]]
	TEQUIP:ARG:하의 = [[衣装:하프팬츠]]
	CFLAG:ARG:초기전신복 = [[衣装:군복]]
	CFLAG:ARG:전신복 = [[衣装:군복]]
	TEQUIP:ARG:전신복 = [[衣装:군복]]
	CFLAG:ARG:초기속옷（하） = [[衣装:브리프]]
	CFLAG:ARG:속옷（하） = [[衣装:브리프]]
	TEQUIP:ARG:속옷（하） = [[衣装:브리프]]
	CFLAG:ARG:초기신발 = [[衣装:가죽구두]]
	CFLAG:ARG:신발 = [[衣装:가죽구두]]
	TEQUIP:ARG:신발 = [[衣装:가죽구두]]
	CSTR:ARG:45 = 躯体を構成するＰｉｘをドリー・カドモンに封じられたことで、悪魔として受肉することとなった。
	CSTR:ARG:46 = 突然%CALLNAME:MASTER%によって拉致されたも同然の経緯であり、
	CSTR:ARG:47 = %CALLNAME:MASTER%のことを上官と認める気は到底ないようだ。
ENDIF

;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:브리게이드_X2]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ブリガド_X2_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("ブリガド_X2_FACE_EX_0")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = ブリガド_X2_FACE_0
	CASEELSE
		RESULTS_F = 
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:브리게이드_X2]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "마스크"
				RESULTS_F '= "ブリガド_X2_FACE_EX_0"
			CASEELSE
				RESULTS_F '= "ブリガド_X2_FACE_0"
		ENDSELECT
	CASEELSE
ENDSELECT
