;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:아리안나]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("アリアンナ_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("アリアンナ_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("アリアンナ_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("アリアンナ_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("アリアンナ_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("アリアンナ_FACE_EX_3")
			RETURNF ""
		RESULTS_F = 新型
		RESULTS_F:1 = アリアンナ_FACE_0
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("アリアンナ_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("アリアンナ_FACE_3")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = アリアンナ_FACE_2
	CASEELSE
		RESULTS_F = 
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:아리안나]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "新型"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = アリアンナ_FACE_1
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = アリアンナ_FACE_EX_0
					;CHARMになった時
					CASE "CHARM"
						RESULTS_F = アリアンナ_FACE_EX_1
					;SLEEPになった時
					CASE "SLEEP"
						RESULTS_F = アリアンナ_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = アリアンナ_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = アリアンナ_FACE_0
				ENDSELECT
				;HPが25%未満だとDYINGまでこれに固定する
				IF 現HP割合(L_CHARA) < 25
					RESULTS_F = アリアンナ_FACE_EX_0
				ENDIF
		ENDSELECT
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = アリアンナ_FACE_3
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = アリアンナ_FACE_3
				ELSE
					RESULTS_F = アリアンナ_FACE_2
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT
