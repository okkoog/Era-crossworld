;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:로키]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_CONCEPTION_[[キャラ:로키]], ARG, ARG:2
IF ARG:2 == 1
	;ある程度戦力にしやすくするためにMAG強化を与える
	CALL SET_ENHANCE_BASE_FOR_NEW_CHARA, ARG, 50
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:로키]], ARG, CFLAG:ARG:이벤트가입

@SHOP_NEWGAME_INITCHARA_[[キャラ:로키]], ARG
CALL SET_CONCEPTION_[[キャラ:로키]], ARG, CFLAG:ARG:이벤트가입

;ERB\RPG\ダンジョンアタック\ダンジョンデータ\DUNGEON_5_大魔宮\EVENT5_大魔宮.ERB@SET_BASE_[[キャラ:로키]], ARG, ARG:1
@SET_CONCEPTION_[[キャラ:로키]], ARG, ARG:1
#DIM LCOUNT
IF ARG:1 == 1
	ABL:ARG:수태아이템 = [[스킬:니플헤임]] + 10000
ENDIF

@SET_LEARN_SKILL_[[キャラ:로키]], ARG, ARG:1
#DIM LCOUNT
IF ARG:1 == 1
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	CALL SET_LEARN_SKILL, ARG, "부흐다인", 1
	CALL SET_LEARN_SKILL, ARG, "마하・부흐라", 1
	CALL SET_LEARN_SKILL, ARG, "메기도", 1
	CALL SET_LEARN_SKILL, ARG, "진・전문내성", 1

	CALL SET_LEARN_SKILL, ARG, "트라프리", 42
	CALL SET_LEARN_SKILL, ARG, "도발",45
	CALL SET_LEARN_SKILL, ARG, "추격의심득", 50
	CALL SET_LEARN_SKILL, ARG, "삼할의마맥", 55
	CALL SET_LEARN_SKILL, ARG, "부흐바리온", 60
	CALL SET_LEARN_SKILL, ARG, "니플헤임",65
	CALL SET_LEARN_SKILL, ARG, "외법의유혹",68
	CALL SET_LEARN_SKILL, ARG, "메기도라온",70
ENDIF

