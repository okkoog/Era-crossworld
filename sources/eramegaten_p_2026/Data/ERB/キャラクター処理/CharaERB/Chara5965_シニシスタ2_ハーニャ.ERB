@EVENT_CHANGE_TRAIN_TALENT_[[キャラ:하냐_시니시스타2]], ARG, ARGS, ARGS:1 = "GET"
IF GROUPMATCH(ARGS, "연모", "음란", "복종") && ARGS:1 == "GET" || GROUPMATCH(ARGS, "신뢰") && ARGS:1 == "LOST"
	IF ARGS == "연모"
		PRINTFORMW %CALLNAME:ARG%은(는) %CALLNAME:MASTER%의 아이를 배기를 바라기 시작한 것 같다.
	ELSE
		PRINTFORMW %CALLNAME:ARG%은(는) %CALLNAME:MASTER%의 아이를 배는 것을 받아들인 것 같다.
	ENDIF
	PRINTFORMW %CALLNAME:ARG%의 『불임의 가호』가 소실되었습니다.
	CFLAG:ARG:임신불능 = 0
	TALENT:ARG:캐릭터고유소질 = 0
ENDIF
