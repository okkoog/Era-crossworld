;====================================================
;トリガー発動条件
;
;詳しい仕様については資料フォルダの解説を参照してください
;====================================================
@SKILL_TRIGGER_ACTIONABLE_CHARA_[[キャラ:제레]],ARG,ARG:1
#DIM CHASE_T
CHASE_T = SKILLGAGE_H_GET(ARG,PU_SKILLNUM_GET(ARG,"乱れ蝶"))
SIF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"乱れ蝶")) < 1
	RETURN 0
;自分自身の攻撃では発動しない
SIF FLAG:행동순1 == ARG
	RETURN 0
;行動者と味方同士でなければ死
SIF !IS_FRIEND(FLAG:행동순1, ARG)
	RETURN 0
;対象と敵同士でなければ死
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
;ダメージ与えてないなら死
SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "HIT")
	RETURN 0
;チェイス対象でないとNG
SIF ARG:1 != CHASE_T
	RETURN 0
RETURN 1, CPOS(ARG:1)
