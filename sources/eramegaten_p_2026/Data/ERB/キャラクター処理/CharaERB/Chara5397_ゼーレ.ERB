;ARG:1 = 表示ページ
@ROLE_EXPLAIN_[[キャラ:제레]], ARG, ARG:1
#DIM LCOUNT
IF ARG:1 == 1
	PRINTFORML 星魂
	PRINTL 
	FOR LCOUNT, 1, 7
		IF GET_RPG_CFLAG_TAKEOVER(ARG, "星魂") >= LCOUNT
			SELECTCASE LCOUNT
				CASE 1
					PRINTFORML 　１　斬尽
					PRINTFORML 　　　　전용 기술의 크리티컬률 +15％.
				CASE 2
					PRINTFORML 　２　蝶舞
					PRINTFORML 　　　　환인의 속도 보정이 2회까지 누적될 수 있게 된다.
				CASE 3
					PRINTFORML 　３　繚乱
					PRINTFORML 　　　　환인의 위력 1.1배. 선제공격 성패와 관계없이 환신이 발동한다.
				CASE 4
					PRINTFORML 　４　掠影
					PRINTFORML 　　　　적을 쓰러뜨렸을 경우 EP를 15 회복한다.
				CASE 5
					PRINTFORML 　５　鋒鋭
					PRINTFORML 　　　　『어지러운 나비』『강습』의 위력 1.1배.
				CASE 6
					PRINTFORML 　６　離析
					PRINTFORML 　　　　필살기를 발동한 턴 동안 같은 적에게 아군이 공격하면 만능 상성으로 저위력 추격을 1회 가한다.
			ENDSELECT
		ELSE
			PRINTFORML 　%TOFULL(TOSTR(LCOUNT))%　？？？？
			PRINTFORML 　　　　？？？？？？？？？？？？？？？？？
		ENDIF
	NEXT
ENDIF
RETURN 1

