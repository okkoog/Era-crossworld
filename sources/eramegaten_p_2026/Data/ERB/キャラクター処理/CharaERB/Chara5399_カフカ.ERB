@ROLE_EXPLAIN_[[キャラ:카프카]], ARG, ARG:1
#DIM LCOUNT
IF ARG:1 == 1
	PRINTFORML 星魂
	PRINTL 
	FOR LCOUNT, 1, 7
		IF GET_RPG_CFLAG_TAKEOVER(ARG, "星魂") >= LCOUNT
			SELECTCASE LCOUNT
				CASE 1
					PRINTFORML 　1단계　무궁하게 움직여라! 무궁하게
					PRINTFORML 　　　　『상냥함도 잔혹함이 될 수 있어』 공격 후, 2턴간 대상이 상태이상일 때 받는 데미지 +30％.
				CASE 2
					PRINTFORML 　2단계　광상곡의 흐느낌
					PRINTFORML 　　　　아군 전체의 상태이상 적에 대한 데미지 +25％.
				CASE 3
					PRINTFORML 　3단계　즉흥 연주의 찬미
					PRINTFORML 　　　　『달빛이 어루만지는 연면함』『끝없는 밤의 소란』의 위력 +1.1배.
				CASE 4
					PRINTFORML 　4단계　이 서창을
					PRINTFORML 　　　　카프카가 EP를 회복할 때 최종 회복량을 1.4배로 한다.
				CASE 5
					PRINTFORML 　5단계　오늘 밤만의 소나타
					PRINTFORML 　　　　『비극 끝의 트릴』『상냥함도 잔혹함이 될 수 있어』의 위력 +1.1배.
				CASE 6
					PRINTFORML 　6단계　조용히 회전하라
					PRINTFORML 　　　　『달빛이 어루만지는 연면함』『비극 끝의 트릴』의 추격 위력이 상승한다.
			ENDSELECT
		ELSE
			PRINTFORML 　%TOFULL(TOSTR(LCOUNT))%　？？？？
			PRINTFORML 　　　　？？？？？？？？？？？？？？？？？
		ENDIF
	NEXT
ENDIF
