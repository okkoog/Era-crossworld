			ENDSELECT
		ELSE
			PRINTFORML 　%TOFULL(TOSTR(LCOUNT))%重　？？？？
			PRINTFORML 　　　　？？？？？？？？？？？？？？？？？
		ENDIF
	NEXT
ENDIF
RETURN 1
