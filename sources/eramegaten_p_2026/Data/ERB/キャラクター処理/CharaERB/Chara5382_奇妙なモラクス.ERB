;
;	Edit	Date			Author				Reason
;	001		2023/02/22		Schrott				新規作成
;
;	Comment
;	獲得後、ガチャを回すことでのみ手に入る『命の星座』によるパッシブ強化効果を獲得する。
;	命の星座
;	１重　岩、天下の骨なり
;		元素スキル『地心』の攻撃範囲を２段階拡散に拡大する。
;	２重　石、玉の揺りかご
;		元素爆発『天星』発動時、味方全体に、奇妙なモラクスのHPの２０％を基準としたHPバリアを付与する。
;	３重　圭璋、闇の中で輝く
;		元素スキル『地心』のダメージ量アップ。
;	４重　黄玉、破れぬ堅さ
;		元素爆発『天星』の石化付与の基本確率をアップ。
;	５重　璧、天理を守る
;		元素爆発『天星』のダメージ量アップ。
;	６重　金、天地の恵み
;		元素爆発『天星』でHPバリアを付与する際の耐久値を２０％から３３％にアップ。
;	
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;--------------------------------------------------
;キャラクター独自変数名称定義関数
;-------------------------------------------------
@RPG_CFLAG_NAME_[[キャラ:기묘한모라쿠스]], ARGS, ARG
#FUNCTIONS
SELECTCASE ARGS
	;---------------------------------------------
	;RPG_CFLAG_EV
	;周回時にリセットされる数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_EV
	;周回時にリセットされる文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CFLAG_TAKEOVER
	;周回時にリセットされない数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 命の星座
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_TAKEOVER
	;周回時にリセットされない文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる数値型変数です
	;スキルゲージHとほぼ互換です。基本的にはゲージHが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "RPG_CFLAG_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = 元素スキル再使用可能ターン
			CASE 1
				RESULTS = 元素爆発再使用可能ターン
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる文字列型変数です
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "RPG_CSTR_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる数値型変数
	;スキルゲージFとほぼ互換です。基本的にはゲージFが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "RPG_CFLAG_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる文字列型変数
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "RPG_CSTR_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
ENDSELECT
RETURNF RESULTS


