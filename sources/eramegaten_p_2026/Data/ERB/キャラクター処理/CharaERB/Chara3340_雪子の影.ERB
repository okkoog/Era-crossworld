;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:유키코의그림자]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:유키코의그림자]], ARG, ARG:2

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:유키코의그림자]], ARG, ARG:1
IF ARG:1 == 1 || ARG:1 == 2
	MARK:ARG:굴복각인 = 3
	IF ARG:1 == 1
		TALENT:ARG:새 = 0
		TALENT:ARG:모피 = 0
		TALENT:ARG:인간화 = 1
		TALENT:ARG:머리 = 1
		TALENT:ARG:눈 = 1
		TALENT:ARG:입 = 1
		TALENT:ARG:팔 = 1
		TALENT:ARG:갈퀴발 = 1
		TALENT:ARG:거체 = 0
		
		TALENT:ARG:솔직함 = 1
		TALENT:ARG:일선을넘지않음 = 0
		TALENT:ARG:억압 = 0
		
		;半魔にしてみっか？
		;ABL:ARG:종족 = 36
		CSTR:ARG:종족명 = シャドウ
		;CALL CLEAR_ROLE_TALENT, ARG
		;CALL CHANGE_ROLE, ARG, ""
		CALL CHANGE_ROLE, ARG, "", , "반마인", "サブ素質引継ぎなし"


		CALL SET_TALENT_PARTY_JOINABLE, ARG, "신용"
		EQUIP:ARG:검 = 2093;生得武器（カギ爪）
		
		CSTR:ARG:타이틀 = 桃羽根の美少女
		
		NAME:ARG = 天城 雪子
		CALLNAME:ARG = 雪子
		
		CSTR:ARG:40 = 本来なら、調伏され、雪子のペルソナと成るべき存在であったが、
		CSTR:ARG:41 = あなたの介入により、逆にオリジナルを呑み込んでしまった。
		
		CSTR:ARG:43 = “雪子”は、今や、自由である。
		CSTR:ARG:44 = 何物にも縛られず、他人を踏みにじり、わがままの限りを尽くす。
		CSTR:ARG:45 = その姿は、吐き気がするほど邪悪であったが、同時に、誰よりも美しかった。
	ELSE
		TALENT:ARG:솔직함 = 1
		TALENT:ARG:일선을넘지않음 = 0
		TALENT:ARG:억압 = 0
		
		;とりあえず脱がす
		CFLAG:ARG:모자 = 0
		CFLAG:ARG:옷 = 0
		CFLAG:ARG:속옷（상） = 0
		CFLAG:ARG:속옷（하） = 0
		CFLAG:ARG:양말 = 0
		CFLAG:ARG:신발 = 0
	ENDIF
ENDIF

