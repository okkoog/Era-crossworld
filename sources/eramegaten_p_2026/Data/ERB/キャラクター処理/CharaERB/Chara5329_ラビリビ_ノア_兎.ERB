;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:노아_라비리비]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ノア_兎_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("ノア_兎_FACE_EX_0")
			RETURNF ""
		RESULTS_F = 亡兎回帰変身
		;アイコン設定時の表示に使うアイコン
		RESULTS_F:1 = ノア_兎_FACE_0
	CASEELSE
		RETURNF ""
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:노아_라비리비]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "亡兎回帰変身"
		IF TFLAG:전투중 && SKILLGAGE_D_GET(L_CHARA, [[스킬:『망토회귀』]])
			RESULTS_F = ノア_兎_FACE_EX_0
		ELSE
			RESULTS_F = ノア_兎_FACE_0
		ENDIF
	CASEELSE
ENDSELECT
