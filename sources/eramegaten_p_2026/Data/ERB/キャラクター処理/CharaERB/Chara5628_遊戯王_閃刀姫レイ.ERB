;--------------------------------------------------
;キャラクター独自変数名称定義関数
;-------------------------------------------------
@RPG_CFLAG_NAME_[[キャラ:섬도희레이]], ARGS, ARG
#FUNCTIONS
SELECTCASE ARGS
	;---------------------------------------------
	;RPG_CSTR_TAKEOVER
	;周回時にリセットされない文字列型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS '= "閃刀カウンター"
			CASE 1
				RESULTS '= "ハーキュリーベース"
			CASE 2
				RESULTS '= "エリアゼロ"
		ENDSELECT
	CASE "RPG_CSTR_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS '= "セメタリー"
		ENDSELECT
ENDSELECT
RETURNF RESULTS

