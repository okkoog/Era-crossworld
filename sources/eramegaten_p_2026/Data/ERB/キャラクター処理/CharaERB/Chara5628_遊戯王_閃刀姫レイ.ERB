@INPUT_COM_リンク召喚_レイ, L_CHARA, L_TARGET
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_TARGET
SIF IS_BADSTATE(L_TARGET, "DYING")
	RETURN 0
VARI STOCK_POS = CPOS(L_CHARA)
CALL REMOVE_POSITION, CPOS(L_CHARA)
CALL INSERT_POSITION, STOCK_POS, L_TARGET

HTML_PRINT_ISLAND  @"<div xpos = '0' ypos = '0' width = '{CLIENTWIDTH()}px' height = '{CLIENTHEIGHT()}px' display = 'absolute-lefttop' background_color = '%TOSTR_HTML(GETBGCOLOR())%'>" + "</div>"
TWAIT 200, 1
HTML_PRINT_ISLAND_CLEAR

SETCOLOR COLOR("FRIEND")
CALL BATTLE_EVENT, "被召喚", L_TARGET, L_TARGET
RESETCOLOR

FOR LCOUNT, 0, VARSIZE("KAJA_TABLE")
	SIF CFLAG:L_CHARA:(KAJA_TABLE:LCOUNT + "강화") == 0
		CONTINUE
	CFLAG:L_TARGET:(KAJA_TABLE:LCOUNT + "강화") = CFLAG:L_CHARA:(KAJA_TABLE:LCOUNT + "강화")
	CFLAG:L_CHARA:(KAJA_TABLE:LCOUNT + "강화") = 0
NEXT

;交代時効果
CALL SKILL_ACTION_AT_SWITCHING, L_CHARA, L_TARGET
;入場時の処理
CALL SET_BATTLE_ENTER_FLAG, L_TARGET
CALL SKILL_TIMING, "BATTLE_ENTER"
CFLAG:L_TARGET:입장플래그 = 0
TFLAG:SUMMON실행완료횟수++

RETURN -2, L_TARGET

