@ENHANCE_[[キャラ:섬도희레이]]_リンク体作成, L_CHARA, TRANS_MODE
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC LCOUNT, 2
#DIMS DYNAMIC TRANS_MODE
#DIMS DYNAMIC SHOWLINE
#DIM DYNAMIC LINE
#DIM DYNAMIC CNT_SUMMONED
#DIM CONST LINK_TABLE = [[キャラ:섬도희카가리]], [[キャラ:섬도희시즈쿠]], [[キャラ:섬도희하야테]], [[キャラ:섬도희카이나]]
#DIM DYNAMIC INPUT_KEY_ARRAY, 10
#DIM DYNAMIC NEED_MAG
#DIM CONST NEED_MAG_TABLE = 10000, 50000, 100000, 250000
LINE = LINECOUNT
WHILE 1
	CNT_SUMMONED = 0
	FOR LCOUNT, 0, 4
		CNT_SUMMONED += (GETCHARA(LINK_TABLE:LCOUNT) >= 0)
	NEXT
	NEED_MAG = NEED_MAG_TABLE:CNT_SUMMONED
	CLEARLINE LINECOUNT - LINE
	CALL MAG_ENHANCE_INFO_CHARA, L_CHARA
	PRINTFORML MAG를 소비하여 %CALLNAME:L_CHARA%의 링크체를 제작할 수 있습니다.
	PRINTFORML 必要ＭＡＧ:{NEED_MAG}
	DRAWLINE
	FOR LCOUNT, 0, 4
		SIF GETCHARA(LINK_TABLE:LCOUNT) >= 0
			CONTINUE
		SHOWLINE '= ""
		;枠1
		SHOWLINE += @"<div xpos = '0' ypos = '0' border_width = '2px' width = '{600 + 100}' height = '{600 + 100}'>"
		SHOWLINE += @"<div xpos = '50' ypos = '50'>" + GET_FACE_BY_CSV_AS_HTML(LINK_TABLE:LCOUNT, , 600) + "</div>"
		;枠2
		SHOWLINE += @"<div xpos = '{600 + 100}' ypos = '0' border_width = '2px' width = '2300' height = '{600 + 100}'>" + "</div>"
		SHOWLINE += @"<div xpos = '{600 + 150}' ypos = '50'>" + @"[{LCOUNT+1}] " + CSVCALLNAME(LINK_TABLE:LCOUNT) + "</div>"
		VARS TEMPS
		VARI COUNT_SUCCESSION
		FOR LCOUNT:1, GETNUM(TALENT, "검격"), GETNUM(TALENT, "검격") + SUCCESSIONNUM
			SIF !CSVTALENT(LINK_TABLE:LCOUNT, LCOUNT:1)
				CONTINUE
			TEMPS += "[" + TALENTNAME:(LCOUNT:1) + "]" + " "
			SIF COUNT_SUCCESSION++ % 4 == 3
				TEMPS += "<br>" + " " * 11
		NEXT
		SHOWLINE += @"<div xpos = '{600 + 150}' ypos = '150'>" + TEMPS + "</div>"
		SHOWLINE '= SET_BUTTON_TAG(SHOWLINE, TOSTR(LCOUNT + 1))
		INPUT_KEY_ARRAY:(LCOUNT + 1) = 1
		HTML_PRINT SHOWLINE
		FOR LCOUNT:1, 0, 6
			PRINTL 
		NEXT
	NEXT
	DRAWLINE
	INPUT_KEY_ARRAY:0 = 1
	PRINTL [0] 돌아간다
	WHILE LINECOUNT < LINE + GET_HEIGHTLENS()
		PRINTL 
	WEND
	CALL INPUT_ARRAY, INPUT_KEY_ARRAY
	IF RESULT == 0
		RETURN 1
	ELSE
		VARI L_RESULT = RESULT - 1
		CALL ADD_NEW_COMPANION, LINK_TABLE:L_RESULT, 0, 0, 1, , BASE:L_CHARA:LV
		VARI SELECT_CHARA = CHARANUM - 1
		U = SELECT_CHARA
		VARI L_ST_PAGE = 2
		WHILE 1
			CLEARLINE LINECOUNT - LINE
			CUSTOMDRAWLINE =
			PRINTFORML %CALLNAME:U%
			CALLFORM SHOW_INFO_PAGE_{L_ST_PAGE}
			SIF L_ST_PAGE == 2
				CLEARLINE 1
			WHILE LINECOUNT < LINE + GET_HEIGHTLENS() - 3
				PRINTL 
			WEND
			CUSTOMDRAWLINE =
			HTML_PRINT SET_BUTTON_TAG("[7] 이전페이지", "7") + " " * 8 + SET_BUTTON_TAG("[8] 戻る", "8") + " " * 8 + SET_BUTTON_TAG("[9] 다음페이지", "9")
			HTML_PRINT " " * 22 + SET_BUTTON_TAG("[0] 결정", "0")
			CALL INPUTINT, 0, 7, 8, 9
			CLEARLINE 1
			SELECTCASE RESULT
				CASE 0
					IF NEED_MAG > GET_CHARA_STOCK_MAG(L_CHARA)
						CALL MESSAGE_POPUP, @"召喚に必要なＭＡＧを所持していない…"
					ELSE
						CALL MESSAGE_POPUP, @"%CALLNAME:SELECT_CHARA%を召喚した！"
						CFLAG:L_CHARA:@"링크캐릭터실제가입시간{L_RESULT}" = CFLAG:SELECT_CHARA:실제가입시간
						CFLAG:SELECT_CHARA:피링크캐릭터실제가입시간 = CFLAG:L_CHARA:실제가입시간
						CFLAG:SELECT_CHARA:전투이외불능 = 1
						CFLAG:SELECT_CHARA:MAG링크 = 1
						CFLAG:SELECT_CHARA:레벨링크 = 1
						CFLAG:SELECT_CHARA:충성도링크 = 1
						CFLAG:SELECT_CHARA:함락링크 = 1
						BASE:SELECT_CHARA:ＥＸＰ = 0
						CALL LINK_陥落素質, L_CHARA
						;レベル同期
						CALL CHECK_LEVEL_UP, L_CHARA
						
						;悪魔解析度が100未満なら100に。
						ANALYSIS_RATE:(NO:SELECT_CHARA) = ANALYSIS_COMPLETED
						SETBIT IS_CHARA_COMPANIONED:(NO:SELECT_CHARA), CFLAG:SELECT_CHARA:이벤트가입 < 0 ? 0 # CFLAG:SELECT_CHARA:이벤트가입
						
						CALL CONTROL_MAG, L_CHARA, -NEED_MAG
						RETURN 1
					ENDIF
				CASE 7
					L_ST_PAGE = L_ST_PAGE == 1 ? 4 # L_ST_PAGE - 1
				CASE 8
					CALL キャラ削除, SELECT_CHARA
					BREAK
				CASE 9
					L_ST_PAGE = L_ST_PAGE == 4 ? 1 # L_ST_PAGE + 1
			ENDSELECT
		WEND
	ENDIF
WEND
RETURN 1

@ROLE_EXPLAIN_[[キャラ:섬도희레이]], ARG, ARG:1
PRINTL □링크 소환
PRINTL 　동료마 강화로 링크체를 제작할 수 있다.
