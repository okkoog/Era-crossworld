;====================================================
;独自の削除処理
;本体を消すときにリンク体をまとめて削除する
;====================================================
@キャラ削除_CHARA_[[キャラ:섬도희레이]], L_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC STOCK_TIMEID
#DIM DYNAMIC DEL_CHARA
STOCK_TIMEID = CFLAG:L_CHARA:실제가입시간
FOR LCOUNT, 0, LINKCHARANUM
	DEL_CHARA = FINDCHARA_LINK(L_CHARA, LCOUNT)
	SIF DEL_CHARA < 0
		CONTINUE
	CALL キャラ削除, DEL_CHARA
	L_CHARA = FINDCHARA_TIMEID(STOCK_TIMEID)
	LCOUNT = 0
NEXT

;====================================================
;追加コマンド
;====================================================
@INPUT_COM_NAME_CHARA_[[キャラ:섬도희레이]], L_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC BUTTON_NUM
#DIMS DYNAMIC L_BUTTON
#DIMS DYNAMIC TEMPS
#DIMS DYNAMIC COMMAND_LIST_TABLE = "リンク召喚_レイ_0", "リンク召喚_レイ_1", "リンク召喚_レイ_2", "リンク召喚_レイ_3"
#DIMS DYNAMIC L_TITLE
BUTTON_NUM = FINDELEMENT(COMMAND_LIST_P, "", 1, , 1)
COMMAND_LIST_SHOWNAME:0 '= SET_COLOR_TAG("[-] Ｌ-ＳＵＭＭＯＮ", "デフォルト")
COMMAND_LIST_CATEGORY:0 = 2
FOR LCOUNT, 0, VARSIZE("COMMAND_LIST_TABLE")
	COMMAND_LIST_NAME:LCOUNT '= COMMAND_LIST_TABLE:LCOUNT
	COMMAND_LIST_UNABLE:LCOUNT = 1
	SIF FINDCHARA_LINK(L_CHARA, LCOUNT) < 0
		CONTINUE
	SIF !IS_JOINABLE_BATTLE(FINDCHARA_LINK(L_CHARA, LCOUNT))
		CONTINUE
	L_BUTTON '= @"[{BUTTON_NUM + LCOUNT, 2}] " + CALLNAME:FINDCHARA_LINK(L_CHARA, LCOUNT)
	L_TITLE '= @"召喚可能回数:[{COUNT_SUMMONABLE()}/{COUNT_SUMMONABLE_MAX()}]"
	IF CFLAG:L_CHARA:소속ＣＯＭＰ == -1
		L_BUTTON '= SET_COLOR_TAG(L_BUTTON, "gray")
		L_TITLE '= @"%CALLNAME:L_CHARA%がＣＯＭＰにはいれない"
	ELSEIF IS_BADSTATE(FINDCHARA_LINK(L_CHARA, LCOUNT), "DYING") || !COUNT_SUMMONABLE()
		L_BUTTON '= SET_COLOR_TAG(L_BUTTON, "gray")
		COMMAND_LIST_UNABLE:LCOUNT = 1
		SIF IS_BADSTATE(FINDCHARA_LINK(L_CHARA, LCOUNT), "DYING")
			L_TITLE '= "戦闘不能"
	ELSE
		COMMAND_LIST_UNABLE:LCOUNT = 0
	ENDIF
	L_BUTTON '= SET_BUTTON_TAG(L_BUTTON, TOSTR(BUTTON_NUM + LCOUNT), L_TITLE)
	COMMAND_LIST_SHOWNAME:0 += "<br>" + "　　" + L_BUTTON
NEXT
RETURN 2

