;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:루시아_마두라의날개]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_5")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_6")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_7")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_8")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_9")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_10")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_11")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("ルシア_マドゥーラの翼_FACE_EX_3")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = ルシア_マドゥーラの翼_FACE_0
	CASEELSE
		RESULTS_F = 
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:루시아_마두라의날개]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			;調教中
			CASE "調教"
				CALLF 陥落(L_CHARA)
				SELECTCASE RESULTS
					;陥落済み
					CASE "연모"
						RESULTS_F = ルシア_マドゥーラの翼_FACE_9
					CASE "음란"
						RESULTS_F = ルシア_マドゥーラの翼_FACE_10
					CASE "복종"
						RESULTS_F = ルシア_マドゥーラの翼_FACE_8
					CASE "신뢰"
						RESULTS_F = ルシア_マドゥーラの翼_FACE_6
					;陥落前
					CASEELSE
						;屈服刻印が3
						IF MARK:L_CHARA:굴복각인 > 2
							RESULTS_F = ルシア_マドゥーラの翼_FACE_7
						;従順か欲望が1以上
						ELSEIF ABL:L_CHARA:순종 > 0 || ABL:L_CHARA:욕망 > 0
							RESULTS_F = ルシア_マドゥーラの翼_FACE_4
						;それ以外
						ELSE
							RESULTS_F = ルシア_マドゥーラの翼_FACE_6
						ENDIF
				ENDSELECT
				;欲情値が一定以上の場合、エロ顔に
				IF PALAM:L_CHARA:욕정 >= PALAMLV:4
					RESULTS_F = ルシア_マドゥーラの翼_FACE_11
				ENDIF
			;調教以外
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ルシア_マドゥーラの翼_FACE_EX_0
					;CHARM・PANIC・HAPPYになった時
					CASE "CHARM", "PANIC", "HAPPY"
						RESULTS_F = ルシア_マドゥーラの翼_FACE_EX_1
					;SLEEPになった時
					CASE "SLEEP"
						RESULTS_F = ルシア_マドゥーラの翼_FACE_EX_2
					;STONEになった時
					CASE "STONE"
						RESULTS_F = ルシア_マドゥーラの翼_FACE_EX_3
					;上記以外の状態異常の時
					CASE "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "SHOCK"
						RESULTS_F = ルシア_マドゥーラの翼_FACE_EX_4
					;通常時
					CASEELSE
						;HPが25%未満から死ぬまで
						IF 現HP割合(L_CHARA) < 25
							RESULTS_F = ルシア_マドゥーラの翼_FACE_EX_4
						;HPが50％未満
						ELSEIF 現HP割合(L_CHARA) < 50
							RESULTS_F = ルシア_マドゥーラの翼_FACE_3
						;HPが75％未満
						ELSEIF 現HP割合(L_CHARA) < 75
							RESULTS_F = ルシア_マドゥーラの翼_FACE_1
						ELSE
							RESULTS_F = ルシア_マドゥーラの翼_FACE_0
						ENDIF
				ENDSELECT
				
		ENDSELECT
	CASEELSE
ENDSELECT
