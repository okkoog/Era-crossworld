	CALL INPUT_YN, , , 0
	IF RESULT == 0
		PRINTFORMW 트리쉬의 소질을 조정판으로 했습니다.
		CALL SET_RPG_CSTR_TAKEOVER, ARG, "戦闘素質設定", "調整版"
