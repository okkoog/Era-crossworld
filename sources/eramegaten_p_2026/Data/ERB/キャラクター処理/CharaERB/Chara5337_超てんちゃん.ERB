@DEFINE_FACE_PATTERN_CHARA_[[キャラ:초텐짱]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("超てんちゃん_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("超てんちゃん_FACE_2")
			RETURNF ""

		IF !SPRITECREATED("超てんちゃん_デフォルト")
			;アイコン設定時の表示に使うアイコン
			VARI GID, 3
			GID = GET_FREE_TEMP_GID()
			GCREATE GID, 180, 180
			GID:1 = GET_FREE_TEMP_GID()
			GCREATE GID:1, 180, 180
			GID:2 = GET_FREE_TEMP_GID()
			GCREATE GID:2, 180, 180

			GDRAWSPRITE GID:1, "超てんちゃん_FACE_2", 0, 0, 180, 180
			GDRAWSPRITE GID:2, "超てんちゃん_FACE_0", 0, 0, 180, 180

			GDRAWG GID, GID:1,  0, 0, 90, 180,  70, 0, 90, 180
			GDRAWG GID, GID:2, 90, 0, 180, 180,  0, 0, 180, 180
			
			SPRITECREATE "超てんちゃん_デフォルト", GID
			TEMP_GID_SPRITENAME:FINDELEMENT(TEMP_GID_SPRITENAME, "", , , 1) '= "超てんちゃん_デフォルト"
		ENDIF
		RESULTS_F = デフォルト
		RESULTS_F:1 = 超てんちゃん_デフォルト
	CASE 1
		SIF L_CHARA < 0
			RETURNF ""
		SIF !GET_RPG_CFLAG_TAKEOVER(L_CHARA, "アイコン追加1")
			RETURNF ""
		SIF !SPRITECREATED("超てんちゃん_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("超てんちゃん_FACE_6")
			RETURNF ""
		SIF !SPRITECREATED("超てんちゃん_FACE_7")
			RETURNF ""
		SIF !SPRITECREATED("超てんちゃん_FACE_8")
			RETURNF ""

		IF !SPRITECREATED("超てんちゃん_追加パターン1")
			;アイコン設定時の表示に使うアイコン
			VARI GID, 3
			GID = GET_FREE_TEMP_GID()
			GCREATE GID, 180, 180
			GID:1 = GET_FREE_TEMP_GID()
			GCREATE GID:1, 180, 180
			GID:2 = GET_FREE_TEMP_GID()
			GCREATE GID:2, 180, 180

			GDRAWSPRITE GID:1, "超てんちゃん_FACE_2", 0, 0, 180, 180
			CALLF 陥落(L_CHARA)
			SELECTCASE RESULTS
				CASE "연모"
					GDRAWSPRITE GID:2, "超てんちゃん_FACE_6", 0, 0, 180, 180
				CASE "음란"
					GDRAWSPRITE GID:2, "超てんちゃん_FACE_7", 0, 0, 180, 180
				CASE "복종"
					GDRAWSPRITE GID:2, "超てんちゃん_FACE_8", 0, 0, 180, 180
				CASEELSE
					GDRAWSPRITE GID:2, "超てんちゃん_FACE_0", 0, 0, 180, 180
			ENDSELECT
			GDRAWG GID, GID:1,  0, 0,  90, 180, 70, 0,  90, 180
			GDRAWG GID, GID:2, 90, 0, 180, 180,  0, 0, 180, 180

			SPRITECREATE "超てんちゃん_追加パターン1", GID
			TEMP_GID_SPRITENAME:FINDELEMENT(TEMP_GID_SPRITENAME, "", , , 1) '= "超てんちゃん_追加パターン1"
		ENDIF
		RESULTS_F = 追加パターン1
		RESULTS_F:1 = 超てんちゃん_追加パターン1
	CASE 2
		SIF L_CHARA < 0
			RETURNF ""
		SIF !GET_RPG_CFLAG_TAKEOVER(L_CHARA, "アイコン追加2")
			RETURNF ""
		SIF !SPRITECREATED("超てんちゃん_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("超てんちゃん_FACE_9")
			RETURNF ""
		SIF !SPRITECREATED("超てんちゃん_FACE_10")
			RETURNF ""
		IF !SPRITECREATED("超てんちゃん_追加パターン2")
			;アイコン設定時の表示に使うアイコン
			VARI GID, 3
			GID = GET_FREE_TEMP_GID()
			GCREATE GID, 180, 180
			GID:1 = GET_FREE_TEMP_GID()
			GCREATE GID:1, 180, 180
			GID:2 = GET_FREE_TEMP_GID()
			GCREATE GID:2, 180, 180

			GDRAWSPRITE GID:1, "超てんちゃん_FACE_2", 0, 0, 180, 180
			GDRAWSPRITE GID:2, "超てんちゃん_FACE_9", 0, 0, 180, 180
			GDRAWG GID, GID:1,  0, 0,  90, 180,  70, 0,  90, 180
			GDRAWG GID, GID:2, 90, 0, 180, 180,  50, 0, 180, 180
			
			SPRITECREATE "超てんちゃん_追加パターン2", GID
			TEMP_GID_SPRITENAME:FINDELEMENT(TEMP_GID_SPRITENAME, "", , , 1) '= "超てんちゃん_追加パターン3"
		ENDIF
		RESULTS_F = 追加パターン2
		RESULTS_F:1 = 超てんちゃん_追加パターン2
	CASE 3
		SIF L_CHARA < 0
			RETURNF ""
		SIF !GET_RPG_CFLAG_TAKEOVER(L_CHARA, "アイコン追加3")
			RETURNF ""
		SIF !SPRITECREATED("超てんちゃん_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("超てんちゃん_FACE_11")
			RETURNF ""
		IF !SPRITECREATED("超てんちゃん_追加パターン3")
			;アイコン設定時の表示に使うアイコン
			VARI GID, 3
			GID = GET_FREE_TEMP_GID()
			GCREATE GID, 180, 180
			GID:1 = GET_FREE_TEMP_GID()
			GCREATE GID:1, 180, 180
			GID:2 = GET_FREE_TEMP_GID()
			GCREATE GID:2, 180, 180

			GDRAWSPRITE GID:1, "超てんちゃん_FACE_2", 0, 0, 180, 180
			GDRAWSPRITE GID:2, "超てんちゃん_FACE_11", 0, 0, 180, 180
			GDRAWG GID, GID:1,  0, 0,  90, 180,  70, 0,  90, 180
			GDRAWG GID, GID:2, 90, 0, 180, 180,  50, 0, 180, 180
			
			SPRITECREATE "超てんちゃん_追加パターン3", GID
			TEMP_GID_SPRITENAME:FINDELEMENT(TEMP_GID_SPRITENAME, "", , , 1) '= "超てんちゃん_追加パターン3"
		ENDIF
		RESULTS_F = 追加パターン3
		RESULTS_F:1 = 超てんちゃん_追加パターン3
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:초텐짱]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		IF TFLAG:전투중
			RESULTS_F = 超てんちゃん_FACE_2
		ELSE
			RESULTS_F = 超てんちゃん_FACE_0
		ENDIF
	CASE "追加パターン1"
		IF TFLAG:전투중
			RESULTS_F = 超てんちゃん_FACE_2
		ELSE
			CALLF 陥落(L_CHARA)
			SELECTCASE RESULTS
				CASE "연모"
					RESULTS_F = 超てんちゃん_FACE_6
				CASE "음란"
					RESULTS_F = 超てんちゃん_FACE_7
				CASE "복종"
					RESULTS_F = 超てんちゃん_FACE_8
				CASEELSE
					RESULTS_F = 超てんちゃん_FACE_0
			ENDSELECT
		ENDIF
	CASE "追加パターン2"
		IF TFLAG:전투중
			RESULTS_F = 超てんちゃん_FACE_2
		ELSE
			SELECTCASE L_SITUATION
				CASE "調教"
					RESULTS_F = 超てんちゃん_FACE_10
				CASEELSE
					RESULTS_F = 超てんちゃん_FACE_9
			ENDSELECT
		ENDIF
	CASE "追加パターン3"
		IF TFLAG:전투중
			RESULTS_F = 超てんちゃん_FACE_2
		ELSE
			RESULTS_F = 超てんちゃん_FACE_11
		ENDIF
	CASEELSE
ENDSELECT

