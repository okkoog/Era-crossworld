CALL PRINT_SUPER_ANGEL_HAISIN, "超天使", L_ANGEL_COMMENT, L_COMMENT, -2
FOR LCOUNT, CFLAG:ARG:PT플래그 ? 1 # 7, CFLAG:ARG:PT플래그 ? 7 # 17
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	;自分自身は死ぬ。(自傷ダメージだけだと最大HP超過状態やバリアでしなないことがあるので確実に殺す)
	IF POS(LCOUNT)  == ARG
		CALL PRINT_HIT_MESSAGE, ARG, "DYING", "NON"
		CALL DEAD_CHARA, ARG, ARG
	ELSE
		CALL ATTACK_SINGLE,ARG, POS(LCOUNT),SKILL_NUM
	ENDIF
NEXT

