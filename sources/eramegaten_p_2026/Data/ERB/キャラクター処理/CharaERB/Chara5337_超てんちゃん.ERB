;キャラクター独自変数名称定義関数
;-------------------------------------------------
@RPG_CFLAG_NAME_[[キャラ:초텐짱]], ARGS, ARG
#FUNCTIONS
SELECTCASE ARGS
	;---------------------------------------------
	;RPG_CFLAG_EV
	;周回時にリセットされる数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_EV
	;周回時にリセットされる文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = てんちゃんパラダイム回答
				;パラダムイベントでの回答。
				;いい服、程々の金額、パジャマ、着こなし、爆買い
			CASE 1
				RESULTS = てんちゃんフィグ前回答
				;フィグ戦前での回答。
				;好きかも、天使、野球選手
			CASE 2
				RESULTS = てんちゃんフィグ後回答
				;フィグ戦後での回答。
				;組織、物理、配信
			CASE 3
				RESULTS = てんちゃんトゥルー回答１
				;フィグ戦後・トゥルールートでの回答。
				;本物、配信者、エンジェル
			CASE 4
				RESULTS = てんちゃんトゥルー回答２
				;PRINTFORML [0]承認欲求こそ自己への愛、あなたを愛するあなたのために飛べ！
				;PRINTFORML [1]あなたに救われた人があなたを生かす、オタクたちがあなたの羽根になる
				;PRINTFORML [2]サイコーの歌声、サイコーのトーク、そして泣く子も黙るサイコーの顔面
				;自己愛、羽根、顔面
				
		ENDSELECT
	;---------------------------------------------
	;RPG_CFLAG_TAKEOVER
	;周回時にリセットされない数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				;イベントクリア後の強化用フラグ
				RESULTS = てんちゃん強化１
			CASE 1
				RESULTS = アイコン追加1
			CASE 2
				RESULTS = アイコン追加2
			CASE 3
				RESULTS = アイコン追加3
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_TAKEOVER
	;周回時にリセットされない文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる数値型変数です
	;スキルゲージHとほぼ互換です。基本的にはゲージHが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "RPG_CFLAG_BTL"
		SELECTCASE ARG
			CASE 0
;				RESULTS = 元素スキル再使用可能ターン
			CASE 1
;				RESULTS = 元素爆発再使用可能ターン
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる文字列型変数です
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "RPG_CSTR_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる数値型変数
	;スキルゲージFとほぼ互換です。基本的にはゲージFが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "RPG_CFLAG_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = 스트레스치
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる文字列型変数
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "RPG_CSTR_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
ENDSELECT
RETURNF RESULTS

