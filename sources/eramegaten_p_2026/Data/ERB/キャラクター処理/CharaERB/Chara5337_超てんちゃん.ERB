@DEFINE_UNABLE_ICON_[[キャラ:초텐짱]], L_CHARA, L_SPRITENAME
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_SPRITENAME
SELECTCASE L_SPRITENAME
	CASE "超てんちゃん_FACE_6", "超てんちゃん_FACE_7", "超てんちゃん_FACE_8"
		RETURN !GET_RPG_CFLAG_TAKEOVER(L_CHARA, "アイコン追加1")
	CASE "超てんちゃん_FACE_9", "超てんちゃん_FACE_10"
		RETURN !GET_RPG_CFLAG_TAKEOVER(L_CHARA, "アイコン追加2")
	CASE "超てんちゃん_FACE_11"
		RETURN !GET_RPG_CFLAG_TAKEOVER(L_CHARA, "アイコン追加3")
	;20250711時点で未使用		
	CASE "超てんちゃん_FACE_3", "超てんちゃん_FACE_4", "超てんちゃん_FACE_5"
		RETURN 1
ENDSELECT
