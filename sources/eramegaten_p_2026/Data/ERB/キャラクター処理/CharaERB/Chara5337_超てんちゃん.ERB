;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<[[キャラ:초텐짱]]>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_CHARA_[[キャラ:초텐짱]],ARG,ARG:1
#DIM SKILL_NUM
#LOCALSIZE 1
#DIM L_T
#DIM L_CHARA
#DIM L_GP
#DIM L_GP_LIMIT
#DIM L_COLOR
#DIM TEMP_CHARA
#DIM MULTI_BY_STRESS
;上限に到達している場合はリターン
SIF GET_RPG_CFLAG_DUNGEON(ARG, "스트레스치") >= 10000
	RETURN 0
L_GP = 0
;ストレスが２０上がるごとに上昇量が強烈に上がる。POWERは前者の数値を後者で累乗する。
;0-18 -38 -58  -78  -98
;   1 / 4 / 9 / 16 / 25
;ゲーム内ストレスからの独立用仮組みとして２０を代入

MULTI_BY_STRESS = 20
;POWER(CFLAG:ARG:스트레스치 / 20 + 1, 2)

IF ARG == ARG:1
	;行動するたびに10
	L_GP += 10
ELSE
	;行動者が陥落している
	IF 陥落(ARG, ARG:1)
		RESULT = 0
		CALL GET_SKILL_PROP, "SKILL_T_RESERVE", CFLAG:(ARG:1):입력행동, ARG:1
		IF RESULT
			L_CHARA = CFLAG:(ARG:1):타겟
			IF L_CHARA == ARG
				L_GP -= 10
			ELSE
				SIF L_CHARA != ARG:1
					L_GP+= 20
			ENDIF
		ELSE
			IF INRANGE(CFLAG:(ARG:1):타겟, 1, 6)
				L_CHARA = POS(CFLAG:(ARG:1):타겟)
				IF L_CHARA == ARG
					L_GP -= 10
				ELSE
					SIF L_CHARA != ARG:1
						L_GP+= 20
				ENDIF
			ELSE
				SIF INRANGE(CFLAG:(ARG:1):타겟, 17, 19)
					L_GP += 10
			ENDIF
		ENDIF
	ENDIF
ENDIF

;専用技１を使うと更に上昇する
SIF IS_PU_SKILL_入力行動(ARG, "INTERNET_OVERDOSE")
	L_GP += 10
;専用技２を使うと消滅する
SIF IS_PU_SKILL_入力行動(ARG, "おくすりをパキる")
	L_GP -= 20000


;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える。増加量は最大体力に対するダメージ割合％分の数値。
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += MAX(100 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ, 2)
L_GP *= MULTI_BY_STRESS
CALL SET_RPG_CFLAG_DUNGEON, ARG, "스트레스치", LIMIT(L_GP + GET_RPG_CFLAG_DUNGEON(ARG, "스트레스치"), 0, 10000)
IF GET_RPG_CFLAG_DUNGEON(ARG, "스트레스치") == 10000
	RESULTS = ＢＵＲＳＴ！
	RESULT:1 = L_COLOR
ELSE
	RESULTS:2 = +{L_GP / 100}.{L_GP % 100 / 10}{L_GP % 10}\% <<스트레스치>>　現在値：{GET_RPG_CFLAG_DUNGEON(ARG, "스트레스치") / 100}％
ENDIF
RESULTS:1 = %" "%
RETURN L_GP


