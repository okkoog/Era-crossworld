;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:아리오크]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:아리오크]], ARG, ARG:2
IF ARG:2 == 1
	;ある程度戦力にしやすくするためにMAG強化を与える
	CALL SET_ENHANCE_BASE_FOR_NEW_CHARA, ARG, 50
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:아리오크]], ARG, ARG:2
CALL LEARN_SKILL_TO_NOW_LEVEL, ARG

;ERB\RPG\이벤트\EVENT_102(など）_炎・氷\EVENT_102_5_ホノオノハテニ.ERB
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:아리오크]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		CSTR:ARG:피부색 = 青
		;アリオク様はほぼそのまま（素のレベルが67だし……）
		;その分、調教素質を盛る
		TALENT:ARG:처녀 = 1
		TALENT:ARG:폭유 = 1
		TALENT:ARG:거유 = 0
		TALENT:ARG:爆尻 = 1
		TALENT:ARG:포동포동 = 2
		
		TALENT:ARG:저항 = 1
		TALENT:ARG:건방짐 = 1
		TALENT:ARG:반항적 = 1
		TALENT:ARG:보수적 = 1
		TALENT:ARG:츤데레 = 1
		TALENT:ARG:젖기쉬움 = 1
		TALENT:ARG:Ｂ둔감 = 0
		TALENT:ARG:Ｃ민감 = 1
		TALENT:ARG:Ｂ민감 = 1
		
		EXP:ARG:Ｖ경험 = 0
		
		;무인
		ABL:ARG:회화타입 = 311
		
		;メガインテリメガネを産む！
		ABL:ARG:수태아이템 = 5022
		
		CSTR:ARG:타이틀 = 巨大女性器
		CSTR:ARG:36 = この個体は、真上水紀の身体を母体として召喚された特別な悪魔である。
		
		CSTR:ARG:38 = 大量のマグネタイトと、女の『無念』によって召喚された彼女は、
		CSTR:ARG:39 = しかし、そんな自分を打ちのめした“あなた”に惹かれ、仲魔となった。
		CSTR:ARG:40 = ……己の依り代となった矮小な女など、既に頭に無い様子である。
		
		NAME:ARG = ミズキ・アリオク
		CALLNAME:ARG = ミズキ・アリオク
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:아리오크]], ARG, ARG:1
#DIM LCOUNT
;ミズキ
IF ARG:1 == 1
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	FOR LCOUNT, 1, 21
		SIF CSVABL(NO:ARG, GETNUM(ABL, @"스킬{LCOUNT}")) == 0
			CONTINUE
		CALL SET_LEARN_SKILL, ARG, TOSTR(CSVABL(NO:ARG, GETNUM(ABL, @"스킬{LCOUNT}"))), 1
	NEXT
	FOR LCOUNT, 1, 21
		SIF CSVABL(NO:ARG, GETNUM(ABL, @"습득스킬{LCOUNT}")) == 0
			CONTINUE
		CALL SET_LEARN_SKILL, ARG, TOSTR(CSVABL(NO:ARG, GETNUM(ABL, @"습득스킬{LCOUNT}"))), CSVABL(NO:ARG, GETNUM(ABL, @"습득LV{LCOUNT}"))	
	NEXT
	;取得スキルを増やしてみよう
	CALL SET_LEARN_SKILL, ARG, "텐타라후", 75
	CALL SET_LEARN_SKILL, ARG, "베어먹기", 79
	CALL SET_LEARN_SKILL, ARG, "삼할의활천", 82
ENDIF

