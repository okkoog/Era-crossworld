;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:디오니소스]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:디오니소스]], ARG, ARG:2
IF ARG:2 == 1
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:디오니소스]], ARG, ARG:2

;1	単発イベント8
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:디오니소스]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		NAME:ARG = 『観客』ﾃﾞｨｵﾆｭｿｽ
		CALLNAME:ARG = 『観客』ﾃﾞｨｵﾆｭｿｽ
		;基準値115.5
		BASE:ARG:LV = 65
		BASE:ARG:힘 = 9
		BASE:ARG:지혜 = 26
		BASE:ARG:마력 = 32
		BASE:ARG:내구 = 10
		BASE:ARG:속도 = 14
		BASE:ARG:운 = 25
		
		CSTR:ARG:이인칭 = 支配人
		
		CFLAG:ARG:매각불가플래그 = 1
		CFLAG:ARG:합체소재사용금지 = 1
			
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:디오니소스]], ARG, ARG:1
IF ARG:1 == 1
	;加入が手間なのでそれなりに盛る
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	CALL SET_LEARN_SKILL, ARG, "이할의마맥"
	CALL SET_LEARN_SKILL, ARG, "절세의육체"
	CALL SET_LEARN_SKILL, ARG, "마하・라기온"
	CALL SET_LEARN_SKILL, ARG, "마하・지온가"
	CALL SET_LEARN_SKILL, ARG, "용분의춤"
	CALL SET_LEARN_SKILL, ARG, "브레인버스트"
	CALL SET_LEARN_SKILL, ARG, "칠색연옥파"
	CALL SET_LEARN_SKILL, ARG, "정신이상무효"
ENDIF
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:디오니소스]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		IF L_CHARA >= 0 && CFLAG:L_CHARA:이벤트가입 == 1
			RESULTS_F = 観客
			;アイコン設定時の表示に使うアイコン
			RESULTS_F:1 = ディオニュソス_FACE_EX_0
		ENDIF
	CASEELSE
		RESULTS_F = 
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:디오니소스]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "観客"
		RESULTS_F = ディオニュソス_FACE_EX_0
	CASEELSE
ENDSELECT
