;--------------------------------------------------
;イベントフラグ
;0 = 通常加入(使用箇所なし)
;1 = 이벤트가입
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:Ｑ・데미난디]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:Ｑ・데미난디]], ARG, ARG:2

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:Ｑ・데미난디]], ARG, ARG:1
#DIM L_DAY
IF ARG:1 == 1
	L_DAY = MAX(DAY - STRFLAG_NUM_REQ("依頼を受けた日" , , , , 13), 35)

	ABL:ARG:순종 = 3
	ABL:ARG:욕망 = 3
	ABL:ARG:Ｖ감각 = 3
	ABL:ARG:Ｂ감각 = 1
	ABL:ARG:정액중독 = 3
	ABL:ARG:섹스중독 = 3
	ABL:ARG:분유중독 = 1
	ABL:ARG:수간중독 = 3

	;ダーク
	ABL:ARG:속성LD = 3
	;カオス
	ABL:ARG:속성LC = 3
	CFLAG:ARG:질혼치 = -256
	CFLAG:ARG:선악치 = -256
	
	;コンセプトはやけくそ（どうせ狂気付いてるし）
	EXP:ARG:Ｖ경험 = 30 + (13 * L_DAY)
	EXP:ARG:절정경험 = 11 + (6 * L_DAY)
	EXP:ARG:성교경험 = 45 + (11 * L_DAY)
	EXP:ARG:질사경험 = 45 + (9 * L_DAY)
	EXP:ARG:정액경험 = 61 + (23 * L_DAY)
	EXP:ARG:펠라경험 = 11 + (17 * L_DAY)
	;途中から奉仕とかどうでもよくなってるし控えめに
	EXP:ARG:봉사쾌락경험 = 61 + (L_DAY / 2)
	;同上
	EXP:ARG:키스경험 = 11 + (L_DAY)
	;自慰もする必要ないし……
	EXP:ARG:자위경험 = 10

	EXP:ARG:Ｖ확장경험 = 0 + (4 * L_DAY)
	EXP:ARG:수간경험 = 0 + (21 * L_DAY)
	EXP:ARG:윤간경험 = 3 + (21 * L_DAY)
	EXP:ARG:분유경험 = 0 + (13 * L_DAY)

	;出産だけは日数ごとに加速度的に増えていく
	EXP:ARG:출산경험 = 0 + (((L_DAY - 34)) * L_DAY)
	
	CALL ADDS_ABNORMAL_EXP("獣姦", ARG)
	CALL ADDS_ABNORMAL_EXP("噴乳", ARG)
	CALL ADDS_ABNORMAL_EXP("処女喪失（輪姦）", ARG)
	CALL SHOW_ABNORMAL_EXP , ARG, 0
	
	;これをセットすると恋慕と異常経験を両立できると聞いた
	CFLAG:ARG:초기이상경험 = EXP:ARG:이상경험
	
	MARK:ARG:쾌락각인 = 3
	MARK:ARG:굴복각인 = 3
ENDIF
