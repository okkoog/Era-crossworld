;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:케르베로스]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ケルベロス_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("ケルベロス_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("ケルベロス_FACE_3")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = ケルベロス_FACE_1
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:케르베로스]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ケルベロス_FACE_2
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = ケルベロス_FACE_2
				ELSEIF L_SITUATION:1 == "DYING"
					RESULTS_F = ケルベロス_FACE_3
					;DYINGでの色相変換を回避させるための指定
					RESULT_F:1 = 1
				ELSE
					RESULTS_F = ケルベロス_FACE_1
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT