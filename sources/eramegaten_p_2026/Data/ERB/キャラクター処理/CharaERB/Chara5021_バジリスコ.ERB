;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:바실리스크]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		IF PU_SKILLGAGE_H_GET(L_CHARA, "奇忌溢る石呪宴") > 0
			RETURNF "バジリスコ_FACE_1"
		ELSE
			RETURNF "バジリスコ_FACE_0"
		ENDIF
	CASEELSE
ENDSELECT

