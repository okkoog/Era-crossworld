;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:바실리스크]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:바실리스크]], ARG, ARG:2
CALL CLEAR_ALL_SKILL, ARG
CALL CLEAR_LEARNED_SKILL_ALL, ARG
CALL SET_LEARN_SKILL_[[キャラ:바실리스크]], ARG, ARG:2
CALL LEARN_SKILL_TO_NOW_LEVEL, ARG

@SHOP_NEWGAME_INITCHARA_[[キャラ:바실리스크]], ARG
;引継ぎフラグはこの後初期化されるので別途保存
CALL SET_RPG_CFLAG_EV, ARG, "陥落素質引継ぎ", (CFLAG:ARG:인계플래그 == 1)

@ROLE_DECIDE_[[キャラ:바실리스크]], ARG
;全書閲覧
SIF CFLAG:ARG:이벤트가입 == -1
	RETURN 0
IF GETBIT(CFLAG:ARG:이벤트가입, 2)
	;ロール説明を覆い隠す
	CSTR:ARG:롤설명1 = 虹蜥蜴/世にも珍しい虹色のトカゲ。/悪魔と人間、どちらの要素も持ちながらどちらにもなりきれない玉虫色の存在。/その曖昧さは周囲に合わせて自身の在り方を塗り替える力を発現させた。
	;アウトサイダーの場合
	SIF GET_RPG_CFLAG_TAKEOVER(ARG, "進化先選択") == 3
		CSTR:ARG:롤설명2 '= CSTR:ARG:롤설명1
	RETURN 0
ELSEIF GETBIT(CFLAG:ARG:이벤트가입, 1)
	CSTR:ARG:롤설명1 = ペトラマンサー/ペトラマンシー（石化術）の使い手。/石化させるだけに留まらず、解除や傀儡化など石化に関する術全般に長ける。/半面、力は弱く石化が効かない相手には無力である。
	;スキル枠8の異能者ライクなロールということで舞台少女を間借り
	CSTR:ARG:롤 = 舞台少女
	RETURN 1
ELSE
	RETURN 0
ENDIF

;ARG:1はイベントフラグ　
@SET_BASE_[[キャラ:바실리스크]], ARG, ARG:1
#DIM 進化先
#DIM LCOUNT
;全書閲覧、加入時処理に対応

ARG:1 = MAX(ARG:1, 1)
IF GETBIT(ARG:1, 0)
	;加入時のリセット処理。引継ぎ時のリセット（実装未定）にも対応できるように
	CFLAG:ARG:이벤트가입 = 0b1
	;悪魔系ロールに進化する時だけ尾が付く
	TALENT:ARG:꼬리 = 0
	;受胎アイテムは虹蜥蜴に進化後のみ
	ABL:ARG:수태아이템 = 0
	CSTR:ARG:타이틀 = 謎の着ぐるみ
	CSTR:ARG:종족명 = 邪龍？
	CSTR:ARG:롤설명1 '= ""
	CSTR:ARG:롤설명2 '= ""
	VARSET CSTR:ARG:0, "", 33, 49
	CALL CHANGE_ROLE, ARG, , , "용왕", "サブ素質引継ぎなし"
	;初期相性をセット
	FOR LCOUNT, 0, TYPENUM+1
		BASE:ARG:GET_TYPE(LCOUNT) = CSVBASE([[キャラ:바실리스크]], GETNUM(BASE, "검격")+LCOUNT)
	NEXT
	;未選択時-1、選択時0から4
	CALL SET_RPG_CFLAG_TAKEOVER, ARG, "進化先選択", -1
ENDIF
IF GETBIT(ARG:1, 1)
	SETBIT CFLAG:ARG:이벤트가입, 1
	;仕様変更により必要性がなくなったけど、せっかくだから何かしら変更したい
	;CP7
	CALL CHANGE_ROLE, ARG, "바스테부스터_2", , "인간", "サブ素質引継ぎなし"
	;後の強化幅を確保するために弱体化
	CALL SET_BTL_TALENT_LV, "마술의소양", ARG, 3
	
	CSTR:ARG:34 = 自分そっくりの人間の身体に憑りつき、以来人間を自称している。
	CSTR:ARG:종족명 = 인간？
	;人間の初期相性をセット
	FOR LCOUNT, 0, TYPENUM+1
		BASE:ARG:GET_TYPE(LCOUNT) = CSVBASE([[キャラ:당신]], GETNUM(BASE, "검격")+LCOUNT)
	NEXT
	;初期装備（カフェ店員のもの。バニーカフェ……）
	CALL GET_ITEMS, "아이언바니", 1
	CALL GET_ITEMS, "하이레그아머", 1
	CALL GET_ITEMS, "섹시힐", 1
	CALL 装備変更, ARG, GET_EQUIPNUM("머리"), GETNUM(ITEM, "아이언바니");4980
	CALL 装備変更, ARG, GET_EQUIPNUM("몸통"), GETNUM(ITEM, "하이레그아머");1600　セット装備のバトルレオタードは高価なので代替品
	CALL 装備変更, ARG, GET_EQUIPNUM("발"), GETNUM(ITEM, "섹시힐");50*70
ENDIF
IF GETBIT(ARG:1, 2)
	SETBIT CFLAG:ARG:이벤트가입, 2
	CSTR:ARG:34 '= CSVCSTR([[キャラ:바실리스크]], 34)
	
	CSTR:ARG:36 '= CSVCSTR([[キャラ:바실리스크]], 36)
	CSTR:ARG:37 '= CSVCSTR([[キャラ:바실리스크]], 37)
	CSTR:ARG:종족명 '= CSVCSTR([[キャラ:바실리스크]], GETNUM(CSTR, "종족명"))
	;レベルに応じて性能変化する胴防具（当初は専用装備で実装しようとしたものの、装備条件が70レベル以上で固定だったため方針変更）
	ABL:ARG:수태아이템 = GETNUM(ITEM, "비단벌레색도마뱀인형옷")
	進化先 = GET_RPG_CFLAG_TAKEOVER(ARG, "進化先選択")
	;悪魔系ロールは尾を付ける
	SIF 進化先 == 1 || 進化先 == 4
		TALENT:ARG:꼬리 = 1
	;アウトサイダー化するとき
	IF 進化先 == 3
		;スキルに関するデータを変身形態に移す
		CALL CLEAR_ALL_SKILL, ARG, "変身形態"
		CALL CLEAR_ALL_LEARN_SKILL, ARG, "変身形態"
		CALL CLEAR_LEARNED_SKILL_ALL, ARG, "変身形態"
		SWAP C_LEARNED_SKILLS:ARG:1, C_LEARNED_SKILLS:ARG:0
		SWAP CFLAG:ARG:악마변신스킬잠금설정, CFLAG:ARG:스킬잠금설정
		FOR LCOUNT, 1, 21
			SWAP ABL:ARG:@"초기변신악마스킬{LCOUNT}", ABL:ARG:@"스킬{LCOUNT}"
			SWAP ABL:ARG:@"초기변신악마습득스킬{LCOUNT}", ABL:ARG:@"습득스킬{LCOUNT}"
			SWAP ABL:ARG:@"초기변신악마습득LV{LCOUNT}", ABL:ARG:@"습득LV{LCOUNT}"
		NEXT
	ENDIF
	;この際いろいろ見直し
	SELECTCASE 進化先
		CASE 0
			;이능자
			;CP20
			CALL CHANGE_ROLE, ARG, "이능자_5/마술의소양_3/바스테부스터_2", , "인간", "サブ素質引継ぎなし"
		CASE 1
			;悪魔
			;CP17
			CALL CHANGE_ROLE, ARG, "마도의재능_1/인트부스터_2", , "용왕", "サブ素質引継ぎなし"
		CASE 2
			;候補者
			;CP44
			CALL CHANGE_ROLE, ARG, "이능자_1/도구지식_3/아이템숙련_1/바스테부스터_2/인트부스터_2", , "인간", "サブ素質引継ぎなし"
		CASE 3
			;아웃사이더
			;CP27/10
			CALL CHANGE_ROLE, ARG, "아웃사이더/건슬링거_2/바스테부스터_2", "마도의재능_1", "인간", "サブ素質引継ぎなし"
		CASEELSE
			;変異種
			;CP50
			CALL CHANGE_ROLE, ARG, "달인/데빌암즈/스킬적성_3/건슬링거_2", , "반마인", "サブ素質引継ぎなし"
	ENDSELECT
	;装備相性の影響を受ける場合
	IF GET_ROLE_PROP("CAN_USE_EQUIP_TYPE", ARG, , "通常形態")
		;人間の初期相性をセット
		FOR LCOUNT, 0, TYPENUM+1
			BASE:ARG:GET_TYPE(LCOUNT) = CSVBASE([[キャラ:당신]], GETNUM(BASE, "검격")+LCOUNT)
		NEXT
	ELSE
		;初期相性をセット
		FOR LCOUNT, 0, TYPENUM+1
			BASE:ARG:GET_TYPE(LCOUNT) = CSVBASE([[キャラ:바실리스크]], GETNUM(BASE, "검격")+LCOUNT)
		NEXT
	ENDIF
	;装備を外す
	CALL 全装備解除, ARG
	;装備可能なロールなら初期装備
	SIF GET_ROLE_PROP("CAN_USE_EQUIP", ARG, "通常形態")
		CALL DO_EQUIP_FOR_NEWGAME, ARG
	
	;アウトサイダーの場合
	IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
		;万事解決
		CFLAG:ARG:초기링크악마 = [[キャラ:바실리스크]]
		ABL:ARG:초기링크악마공격상성 = CSVABL([[キャラ:바실리스크]], GETNUM(ABL, "공격상성"))
		ABL:ARG:초기링크악마최저공격횟수 = CSVABL([[キャラ:바실리스크]], GETNUM(ABL, "최저공격횟수"))
		ABL:ARG:초기링크악마최대공격횟수 = CSVABL([[キャラ:바실리스크]], GETNUM(ABL, "최대공격횟수"))
		ABL:ARG:초기링크악마사거리 = CSVABL([[キャラ:바실리스크]], GETNUM(ABL, "사거리"))
		ABL:ARG:초기링크악마공격범위 = CSVABL([[キャラ:바실리스크]], GETNUM(ABL, "공격범위"))
		;ABL:ARG:초기링크악마추가효과 = ABL:ARG:추가효과
		;ABL:ARG:초기링크악마추가효과상성 = ABL:ARG:추가효과상성
		;ABL:ARG:초기링크악마추가효과명중률 = ABL:ARG:추가효과명중률
		;ABL:ARG:초기링크악마추가효과최대명중률 = ABL:ARG:추가효과최대명중률
	ENDIF
ENDIF

@SET_LEARN_SKILL_[[キャラ:바실리스크]], ARG, ARG:1
#DIMS 形態
#DIM LCOUNT
形態 '= GET_ROLE_PROP("CAN_USE_TRANS", ARG) ? "変身形態" # "通常形態"
;全書閲覧、加入時処理に対応
ARG:1 = MAX(ARG:1, 1)
IF GETBIT(ARG:1, 0)
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	FOR LCOUNT, 1, 21
		SIF CSVABL(NO:ARG, GETNUM(ABL, @"스킬{LCOUNT}")) == 0
			CONTINUE
		CALL SET_LEARN_SKILL, ARG, TOSTR(CSVABL(NO:ARG, GETNUM(ABL, @"스킬{LCOUNT}"))), 1, 形態
	NEXT
	FOR LCOUNT, 1, 21
		SIF CSVABL(NO:ARG, GETNUM(ABL, @"습득스킬{LCOUNT}")) == 0
			CONTINUE
		CALL SET_LEARN_SKILL, ARG, TOSTR(CSVABL(NO:ARG, GETNUM(ABL, @"습득스킬{LCOUNT}"))), CSVABL(NO:ARG, GETNUM(ABL, @"습득LV{LCOUNT}")), 形態
	NEXT
ENDIF
IF GETBIT(ARG:1, 1)
	CALL SET_LEARN_SKILL, ARG, "CSTR専用スキル/奇忌溢る石呪宴", 1, 形態
	SIF HAVE_PU_SKILL(ARG, "奇忌溢る石呪宴", , 形態)
		SETBIT CFLAG:ARG:@"\@形態=="変身形態" ? 악마변신 # \@스킬잠금설정", HAVE_PU_SKILL(ARG, "奇忌溢る石呪宴", 1, 形態)
	CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:사마카쟈오토]]), 45, 形態
ENDIF
IF GETBIT(ARG:1, 2)
	SELECTCASE GET_RPG_CFLAG_TAKEOVER(ARG, "進化先選択")
		CASE 2
			;スキル使用不可ロールなので自動効果だけ覚えるようにする
			CALL CLEAR_ALL_LEARN_SKILL, ARG
			CALL SET_LEARN_SKILL_[[キャラ:바실리스크]], ARG, 0b10
			CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:이악물기]]), 39, 形態
			CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:스쿠카쟈오토]]), 47, 形態
			CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:아이템숙련]]), 56, 形態
			;石化させる手段が乏しいので後で何か追加するかも
			RETURN
		CASE 3
			CALL SET_LEARN_SKILL, ARG, "CSTR専用スキル/奇忌溢る石呪宴", 1, "通常形態"
			SIF HAVE_PU_SKILL(ARG, "奇忌溢る石呪宴")
				SETBIT CFLAG:ARG:스킬잠금설정, HAVE_PU_SKILL(ARG, "奇忌溢る石呪宴", 1)
			CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:사마카쟈오토]]), 45, "通常形態"
		CASEELSE
	ENDSELECT
	;イベント未消化の場合
	SIF !IS_LEARNED_SKILL(ARG, "奇忌溢る石呪宴", 形態)
		CALL SET_LEARN_SKILL_[[キャラ:바실리스크]], ARG, 0b10
	CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:무거운공기]]), 1, 形態
	CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:이블아이]]), 38, 形態
	CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:이악물기]]), 39, 形態
	CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:마하에이하]]), 43, 形態
	CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:텐타라후]]), 46, 形態
	CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:스쿠카쟈오토]]), 47, 形態
	CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:마하・마그다인]]), 51, 形態
	CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:마하에이가온]]), 53, 形態
	CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:주살가드킬]]), 61, 形態
	SIF GET_RPG_CFLAG_TAKEOVER(ARG, "進化先選択") < 3
		RETURN
	CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:신경이상무효]]), 67, 形態
	CALL SET_LEARN_SKILL, ARG, TOSTR([[스킬:명계의문]]), 71, 形態
ENDIF
