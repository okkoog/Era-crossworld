;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:코린_젠존제]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_LEARNED_SKILL_[[キャラ:코린_젠존제]], ARG, ARG:2
CALL SET_ROLE_CSTR_TAKEOVER, ARG, "音動機名称", "ハウスキーパー"

@SET_LEARNED_SKILL_[[キャラ:코린_젠존제]], ARG, ARG:1
CALL SET_LEARNED_SKILL, ARG, "裂傷反応", "通常形態"
CALL SET_LEARNED_SKILL, ARG, "見習いメイド", "通常形態"
CALL SET_LEARNED_SKILL, ARG, "特殊勤務メイド", "通常形態"
CALL SET_LEARNED_SKILL, ARG, "戦場ではお傍に", "通常形態"
CALL SET_LEARNED_SKILL, ARG, "塵も積もれば", "通常形態"
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:코린_젠존제]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("カリン_ゼンゼロ_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("カリン_ゼンゼロ_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("カリン_ゼンゼロ_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("カリン_ゼンゼロ_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("カリン_ゼンゼロ_FACE_EX_1")
			RETURNF ""	
		RESULTS_F = デフォルト
		RESULTS_F:1 = カリン_ゼンゼロ_FACE_0
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:코린_젠존제]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = カリン_ゼンゼロ_FACE_1
			CASEELSE
				SELECTCASE L_SITUATION:1
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = カリン_ゼンゼロ_FACE_1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = カリン_ゼンゼロ_FACE_2
						RESULT_F:1 = 1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = カリン_ゼンゼロ_FACE_EX_0
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = カリン_ゼンゼロ_FACE_EX_1
					;通常時
					CASEELSE
						RESULTS_F = カリン_ゼンゼロ_FACE_0
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT