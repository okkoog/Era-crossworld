@SKILL_BATTLE_END_CHARA_[[キャラ:섬도희카가리]], ARG, ARG:1
#DIM DYNAMIC STOCK_POS
SIF CPOS(ARG) == 0
	RETURN 0
SIF FINDCHARA_TIMEID(CFLAG:ARG:피링크캐릭터실제가입시간) < 0
	RETURN 0
STOCK_POS = CPOS(ARG)
CALL REMOVE_POSITION, CPOS(ARG)
CALL INSERT_POSITION, STOCK_POS, FINDCHARA_TIMEID(CFLAG:ARG:피링크캐릭터실제가입시간)
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:섬도희카가리]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("閃刀姫カガリ_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("閃刀姫カガリ_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("閃刀姫カガリ_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("閃刀姫カガリ_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("閃刀姫カガリ_FACE_EX_3")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = 閃刀姫カガリ_FACE_0
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:섬도희카가리]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F =閃刀姫カガリ_FACE_0
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F =閃刀姫カガリ_FACE_EX_0
					;CHARMになった時
					CASE "CHARM"
						RESULTS_F =閃刀姫カガリ_FACE_EX_1
					;SLEEPになった時
					CASE "SLEEP"
						RESULTS_F =閃刀姫カガリ_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F =閃刀姫カガリ_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F =閃刀姫カガリ_FACE_0
				ENDSELECT
				;HPが25%未満だとDYINGまでこれに固定する
				IF 現HP割合(L_CHARA) < 25
					RESULTS_F =閃刀姫カガリ_FACE_EX_0
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT
