@INPUT_COM_NAME_CHARA_[[キャラ:섬도희카가리]], L_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC BUTTON_NUM
#DIMS DYNAMIC L_BUTTON, LINKCHARANUM
#DIMS DYNAMIC TEMPS
#DIMS DYNAMIC COMMAND_LIST_TABLE = "リンク召喚_レイ本体", "リンク召喚_レイリンク体_0", "リンク召喚_レイリンク体_1", "リンク召喚_レイリンク体_2", "リンク召喚_レイリンク体_3"
#DIMS DYNAMIC L_TITLE
#DIM DYNAMIC L_TARGET
BUTTON_NUM = FINDELEMENT(COMMAND_LIST_P, "", 1, , 1)
COMMAND_LIST_SHOWNAME:0 '= SET_COLOR_TAG("[-] Ｌ-ＳＵＭＭＯＮ", "デフォルト")
COMMAND_LIST_CATEGORY:0 = 2
FOR LCOUNT, 0, VARSIZE("COMMAND_LIST_TABLE")
	COMMAND_LIST_NAME:LCOUNT '= COMMAND_LIST_TABLE:LCOUNT
	COMMAND_LIST_UNABLE:LCOUNT = 1
	IF LCOUNT == 0
		L_TARGET = FINDCHARA_TIMEID(CFLAG:L_CHARA:피링크캐릭터실제가입시간)
	ELSE
		L_TARGET = FINDCHARA_LINK(FINDCHARA_TIMEID(CFLAG:L_CHARA:피링크캐릭터실제가입시간), LCOUNT - 1)
	ENDIF
	SIF L_TARGET < 0
		CONTINUE
	SIF L_CHARA == L_TARGET
		CONTINUE
	SIF !IS_JOINABLE_BATTLE(L_TARGET)
		CONTINUE
	L_BUTTON:LCOUNT '= @"[{BUTTON_NUM + LCOUNT, 2}] " + CALLNAME:L_TARGET
	L_TITLE '= @"召喚可能回数:[{COUNT_SUMMONABLE()}/{COUNT_SUMMONABLE_MAX()}]"
	IF IS_BADSTATE(L_TARGET, "DYING") || !COUNT_SUMMONABLE()
		L_BUTTON:LCOUNT '= SET_COLOR_TAG(L_BUTTON:LCOUNT, "gray")
		SIF IS_BADSTATE(L_TARGET, "DYING")
			L_TITLE '= "戦闘不能"
	ELSE
		COMMAND_LIST_UNABLE:LCOUNT = 0
	ENDIF
	L_BUTTON:LCOUNT '= SET_BUTTON_TAG(L_BUTTON:LCOUNT, TOSTR(BUTTON_NUM + LCOUNT), L_TITLE)
	COMMAND_LIST_SHOWNAME:0 += "<br>" + "　　" + L_BUTTON:LCOUNT
NEXT
RETURN 2

