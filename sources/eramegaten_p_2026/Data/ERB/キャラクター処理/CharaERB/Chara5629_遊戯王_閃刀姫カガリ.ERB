;--------------------------------------------------
;MAG強化回数
;レイと同じ回数まで強化できる
;-------------------------------------------------
@MAG_CALC_ENHANCE_BASE_CHARA_[[キャラ:섬도희카가리]], ARG, ARG:1, ARG:2
#FUNCTION
#DIM DYNAMIC L_REI
#DIM DYNAMIC COUNT_ENHANCEABLE
L_REI = FINDCHARA_TIMEID(CFLAG:ARG:피링크캐릭터실제가입시간)
IF L_REI < 0
	RESULT_F = -1
	RETURNF -1
ENDIF
RESULTS_F '= "　" + CALLNAME:L_REI + "の能力を強化した回数に応じて強化できる。"
COUNT_ENHANCEABLE = CFLAG:L_REI:능력강화횟수
SIF CFLAG:L_REI:베어내기플래그
	COUNT_ENHANCEABLE = MIN(COUNT_ENHANCEABLE, BASE:L_REI:LV * 3/ 2 + 18)
CFLAG:ARG:능력강화횟수 = MAX(CFLAG:ARG:능력강화횟수, COUNT_ENHANCEABLE)
IF COUNT_FREE_MAG_ENHANCE_BASE(ARG) > ARG:1
	RESULT_F = 0
	RETURNF 0
ENDIF
RESULT_F = -1
RETURNF -1

@SKILL_PASSIVE_BTL_EFFECT_CHARA_[[キャラ:섬도희카가리]], ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			IF L_ダメージタイプ == "物理"
				SIF GET_RPG_CFLAG_BTL(FINDCHARA_TIMEID(CFLAG:L_P:피링크캐릭터실제가입시간), "ハーキュリーベース") > FLAG:경과턴수
					RETURN 50
			ENDIF
	ENDSELECT
ENDIF
RETURN 0

