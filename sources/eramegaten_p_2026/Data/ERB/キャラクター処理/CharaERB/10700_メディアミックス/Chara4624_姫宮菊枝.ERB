		EXP:ARG:펠라경험 = 11 + (17 * 日付計算)
		EXP:ARG:자위경험 += 10
		EXP:ARG:봉사쾌락경험 += 300
		EXP:ARG:윤간경험 = 3 + (21 * 日付計算)
		EXP:ARG:수간경험 = 0 + (21 * 日付計算)
		CALL ADDS_ABNORMAL_EXP("処女喪失（輪姦）", ARG)
		CALL ADDS_ABNORMAL_EXP("獣姦", ARG)
		CALL ADDS_ABNORMAL_EXP("処女喪失（輪姦）", ARG)
		CALL SHOW_ABNORMAL_EXP , ARG, 0
		CFLAG:(ARG):초기이상경험 = EXP:(ARG):이상경험
		IF ARG:1 == 5
			TALENT:(RESULT:1):임신하기어려움 = 1
			IF PREGNANCY_ABLE(ARG)
				CALL CHANGE_N_STATUS, ARG, "NOMES"
				SELECTCASE RAND:100
					CASE IS < 50
						CALL SET_FETUS_STATUS, ARG, -1, [[キャラ:데미난디]]
					CASE IS < 70
						CALL SET_FETUS_STATUS, ARG, -1, [[キャラ:템플나이트]]
					CASE IS < 90
						CALL SET_FETUS_STATUS, ARG, -1, [[キャラ:부쳐]]
					CASEELSE
						CALL SET_FETUS_STATUS, ARG, -1, [[キャラ:어뎁트]]
				ENDSELECT
			ENDIF
			TALENT:ARG:붕괴 = 1
			CFLAG:ARG:초기이상경험 = EXP:ARG:이상경험
		ENDIF
ENDSELECT
