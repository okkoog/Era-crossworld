		CALL SET_LEARN_SKILL, ARG, "파라라・웨이브", 50
		CALL SET_LEARN_SKILL, ARG, "방전", 52
		CALL SET_LEARN_SKILL, ARG, "텐타라후", 55
		CALL SET_LEARN_SKILL, ARG, "뉴클리어미사일", 60
ENDSELECT

;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:카야]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
IF L_CHARA >= 0
	SELECTCASE L_NO
		CASE 0
			;画像チェック
			SIF !SPRITECREATED("伽耶_FACE_0")
				RETURNF ""
			;画像チェック
			SIF !SPRITECREATED("伽耶_FACE_EX_0")
				RETURNF ""
			SIF !SPRITECREATED("伽耶_FACE_EX_2")
				RETURNF ""
			SIF !SPRITECREATED("伽耶_FACE_EX_3")
				RETURNF ""
			SIF !SPRITECREATED("伽耶_FACE_EX_4")
				RETURNF ""
			RESULTS_F = 伽耶変身
			;アイコン設定時の表示に使うアイコン
			SELECTCASE CSTR:L_CHARA:종족명
				CASE "기계의처녀"
					RESULTS_F:1 = 伽耶_FACE_EX_0
				CASE "야마"
					RESULTS_F:1 = 伽耶_FACE_EX_2
				CASE "흉조"
					RESULTS_F:1 = 伽耶_FACE_EX_3
				CASE "지령"
					RESULTS_F:1 = 伽耶_FACE_EX_4
				CASEELSE
					RESULTS_F:1 = 伽耶_FACE_0
			ENDSELECT
		CASE 1, 2, 3
			SIF CSTR:L_CHARA:종족명 != "기계의처녀"
				RETURNF ""
			SELECTCASE L_NO
				CASE 1
					SIF !SPRITECREATED("伽耶_FACE_EX_1")
						RETURNF ""
					RESULTS_F = 伽耶変身_ゴーレム差分1
					RESULTS_F:1 = 伽耶_FACE_EX_1
				CASE 2
					SIF !SPRITECREATED("伽耶_FACE_EX_5")
						RETURNF ""
					RESULTS_F = 伽耶変身_ゴーレム差分2
					RESULTS_F:1 = 伽耶_FACE_EX_5
				CASE 3
					SIF !SPRITECREATED("伽耶_FACE_EX_6")
						RETURNF ""
					RESULTS_F = 伽耶変身_ゴーレム差分3
					RESULTS_F:1 = 伽耶_FACE_EX_6
			ENDSELECT
		CASEELSE
			RETURNF ""
	ENDSELECT
ENDIF
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:카야]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "伽耶変身"
		SELECTCASE CSTR:L_CHARA:종족명
			CASE "기계의처녀"
				RESULTS_F = 伽耶_FACE_EX_0
			CASE "야마"
				RESULTS_F = 伽耶_FACE_EX_2
			CASE "흉조"
				RESULTS_F = 伽耶_FACE_EX_3
			CASE "지령"
				RESULTS_F = 伽耶_FACE_EX_4
			CASEELSE
				RESULTS_F = 伽耶_FACE_0
		ENDSELECT
	CASE "伽耶変身_ゴーレム差分1"
		RESULTS_F = 伽耶_FACE_EX_1
	CASE "伽耶変身_ゴーレム差分2"
		RESULTS_F = 伽耶_FACE_EX_5
	CASE "伽耶変身_ゴーレム差分3"
		RESULTS_F = 伽耶_FACE_EX_6
	CASEELSE
ENDSELECT
