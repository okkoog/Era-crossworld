;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:쇼고]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:쇼고]], ARG, ARG:2
IF ARG:2 == 1
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:쇼고]], ARG, ARG:2
CALL LEARN_SKILL_TO_NOW_LEVEL, ARG

;1	ERB\RPG\ダンジョンアタック\ダンジョンデータ\DUNGEON8_警視庁.ERB
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:쇼고]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		;ステータス基準値は72だが、ここで入手した場合はちょっと多め（+7）に
		;そしてプレミア感()を出すため威嚇を挑発に差し替えてみる
		CALL SET_TALENT_PARTY_JOINABLE, ARG, "신용"
		BASE:ARG:LV = 36
		BASE:ARG:힘 = 4
		BASE:ARG:지혜 = 14
		BASE:ARG:마력 = 3
		BASE:ARG:내구 = 19
		BASE:ARG:속도 = 29
		BASE:ARG:운 = 8
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:쇼고]], ARG, ARG:1
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_SKILL
SELECTCASE ARG:1
	;オリジナル版のテーブルの威嚇が挑発に差し替えられる
	CASE 1
		CALL CLEAR_ALL_LEARN_SKILL, ARG
		FOR LCOUNT, 1, 21
			SIF CSVABL(NO:ARG, GETNUM(ABL, @"스킬{LCOUNT}")) == 0
				CONTINUE
			CALL SET_LEARN_SKILL, ARG, TOSTR(CSVABL(NO:ARG, GETNUM(ABL, @"스킬{LCOUNT}"))), 1
		NEXT
		FOR LCOUNT, 1, 21
			L_SKILL = CSVABL(NO:ARG, GETNUM(ABL, @"습득스킬{LCOUNT}"))
			SIF L_SKILL == 0
				CONTINUE
			IF L_SKILL == [[스킬:위협]]
				CALL SET_LEARN_SKILL, ARG, "도발", CSVABL(NO:ARG, GETNUM(ABL, @"습득LV{LCOUNT}"))
			ELSEIF IS_PU_SKILLNUM(L_SKILL)
				CALL SET_LEARN_SKILL, ARG, "CSTR専用スキル/" + CSVCSTR(NO:ARG, GETNUM(CSTR, @"전용기{L_SKILL - [[스킬:전용기1]] + 1}")), CSVABL(NO:ARG, GETNUM(ABL, @"습득LV{LCOUNT}"))
			ELSE
				CALL SET_LEARN_SKILL, ARG, TOSTR(L_SKILL), CSVABL(NO:ARG, GETNUM(ABL, @"습득LV{LCOUNT}"))
			ENDIF
		NEXT
ENDSELECT

