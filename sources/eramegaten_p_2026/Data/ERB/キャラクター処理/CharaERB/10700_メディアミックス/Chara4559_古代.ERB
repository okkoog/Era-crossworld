@DEFINE_FACE_PATTERN_CHARA_[[キャラ:코시로]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("古代_FACE_17")
			RETURNF ""
		SIF !SPRITECREATED("古代_FACE_18")
			RETURNF ""
		SIF !SPRITECREATED("古代_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("古代_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("古代_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("古代_FACE_EX_3")
			RETURNF ""
		SIF !SPRITECREATED("古代_FACE_EX_4")
			RETURNF ""
		SIF !SPRITECREATED("古代_FACE_EX_5")
			RETURNF ""
		SIF !SPRITECREATED("古代_FACE_EX_6")
			RETURNF ""
		SIF !SPRITECREATED("古代_FACE_EX_7")
			RETURNF ""
		SIF !SPRITECREATED("古代_FACE_EX_8")
			RETURNF ""
		SIF !SPRITECREATED("古代_FACE_EX_9")
			RETURNF ""
		SIF !SPRITECREATED("古代_FACE_EX_10")
			RETURNF ""
		SIF !SPRITECREATED("古代_FACE_EX_11")
			RETURNF ""
		RESULTS_F = 1
		RESULTS_F:1 = 古代_FACE_17
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:코시로]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "1"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = 古代_FACE_18
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = 古代_FACE_EX_0
					;CHARMになった時
					CASE "CHARM"
						RESULTS_F = 古代_FACE_EX_1
					;SLEEPになった時
					CASE "SLEEP"
						RESULTS_F = 古代_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = 古代_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = 古代_FACE_17
				ENDSELECT
				IF CFLAG:L_CHARA:악마변신
					VARI LINK_DEVIL = FINDCHARA_LINK(L_CHARA)
					SELECTCASE LINK_DEVIL >= 0 ? NO:LINK_DEVIL # CFLAG:L_CHARA:초기링크악마
						CASE [[キャラ:아리안로드]]
							SELECTCASE L_SITUATION:1
								;戦闘不能になった時
								CASE "DYING"
									RESULTS_F = 古代_FACE_EX_8
								CASEELSE
									RESULTS_F = 古代_FACE_EX_4
								ENDSELECT
						CASE [[キャラ:토르]],[[キャラ:토르_진노코시로]]
							SELECTCASE L_SITUATION:1
								;戦闘不能になった時
								CASE "DYING"
									RESULTS_F = 古代_FACE_EX_9
								CASEELSE
									RESULTS_F = 古代_FACE_EX_5
								ENDSELECT
						CASE [[キャラ:체르노보그]]
							SELECTCASE L_SITUATION:1
								;戦闘不能になった時
								CASE "DYING"
									RESULTS_F = 古代_FACE_EX_10
								CASEELSE
									RESULTS_F = 古代_FACE_EX_6
								ENDSELECT
						CASE [[キャラ:가장새로운신_링크전용]]
							SELECTCASE L_SITUATION:1
								;戦闘不能になった時
								CASE "DYING"
									RESULTS_F = 古代_FACE_EX_11
								CASEELSE
									RESULTS_F = 古代_FACE_EX_7
								ENDSELECT
					ENDSELECT
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT