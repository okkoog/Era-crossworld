@RPG_CFLAG_NAME_[[キャラ:아인]], ARGS, ARG
#FUNCTIONS
SELECTCASE ARGS
	;---------------------------------------------
	;RPG_CFLAG_EV
	;周回時にリセットされる数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_EV
	;周回時にリセットされる文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CFLAG_TAKEOVER
	;周回時にリセットされない数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 互換処理
		ENDSELECT
