;
;	Module		:Chara4628_石嶺摩耶.ERB
;	Facility	:ERB上から独自の変更をキャラクターに与える
;				:与えられる補正自体はスキルでパッシブの補正として持たさられるものなので原理的にはスキル枠を消費しないスキル
;				;あるいはスキル削除が通用しないスキルとなる。あえて排除しない場合、ペルソナ・リンク悪魔として利用しているときにも呼ばれるのに注意
;
;	Licence		:ライセンスフリー。
;
;	Modification Data:
;
;	Edit	Date			Author					Reason
;	001		2024/05/16		P(bazzile)				新規作成
;	Comment
;	イベントで非戦闘員を喪失した場合、イベントでの選択によって顔グラが変化する。
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:마야_NT]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:마야_NT]], ARG, ARG:2
CALL SET_LEARN_SKILL_[[キャラ:마야_NT]], ARG, ARG:2

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:마야_NT]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1, 2
		CALL SET_LINK_DEVIL, ARG, [[キャラ:이참・나_링크전용]], "攻撃性能"
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:마야_NT]], ARG, ARG:1
#DIM DYNAMIC BASE_LEARN_LV
SELECTCASE ARG:1
	CASE 2
		BASE_LEARN_LV = MAX(BASE:ARG:LV, 40)
		CALL SET_LEARN_SKILL, ARG, "그라다인", BASE_LEARN_LV + 1, "変身形態"
		CALL SET_LEARN_SKILL, ARG, "마하・그라다인", BASE_LEARN_LV + 1, "変身形態"
		CALL SET_LEARN_SKILL, ARG, "어둠의심판", BASE_LEARN_LV + 2, "変身形態"
		CALL SET_LEARN_SKILL, ARG, "암리타", BASE_LEARN_LV + 3, "変身形態"
		CALL SET_LEARN_SKILL, ARG, "스리스티", BASE_LEARN_LV + 8, "変身形態"
ENDSELECT
