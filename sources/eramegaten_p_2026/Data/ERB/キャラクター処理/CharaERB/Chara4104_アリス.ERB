;--------------------------------------------------
;イベントフラグ
;1 = 이벤트가입
;2 = 奴隷ごっこ
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:앨리스]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:앨리스]], ARG, ARG:2

@SET_BASE_[[キャラ:앨리스]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		;ある程度戦力にしやすくするためにMAG強化を与える
		CALL SET_ENHANCE_BASE_FOR_NEW_CHARA, ARG, 50
	CASE 2
		CALL SET_ENHANCE_BASE_FOR_NEW_CHARA, ARG, 50
		ABL:ARG:새드끼 = 1
		EXP:ARG:가학쾌락경험  = 201
		TALENT:ARG:도착적 = 1
		ABL:ARG:기교 = 1
		ABL:ARG:새드끼 = 1
ENDSELECT

@EVENT_CHANGE_TRAIN_TALENT_[[キャラ:앨리스]], ARG, ARGS, ARGS:1 = "GET"
;陥落時にスキルを追加
IF GROUPMATCH(ARGS, "연모", "음란", "복종")
	CALL LEARN_SKILL, ARG, [[스킬:놀아줄래？]]
ENDIF
