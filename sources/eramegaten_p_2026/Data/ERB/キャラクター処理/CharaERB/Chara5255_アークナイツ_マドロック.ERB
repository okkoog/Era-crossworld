;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:머드락]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("マドロック_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("マドロック_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("マドロック_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("マドロック_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("マドロック_FACE_EX_1")
			RETURNF ""	
		RESULTS_F = デフォルト
		RESULTS_F:1 = マドロック_FACE_0
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("マドロック_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("マドロック_FACE_4")
			RETURNF ""
		RESULTS_F = 旧画像
		RESULTS_F:1 = マドロック_FACE_3
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:머드락]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = マドロック_FACE_1
			CASEELSE
				SELECTCASE L_SITUATION:1
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = マドロック_FACE_1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = マドロック_FACE_2
						RESULT_F:1 = 1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = マドロック_FACE_EX_0
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = マドロック_FACE_EX_1
					;通常時
					CASEELSE
						RESULTS_F = マドロック_FACE_0
				ENDSELECT
		ENDSELECT
	CASE "旧画像"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = マドロック_FACE_4
			CASEELSE
				SELECTCASE L_SITUATION:1
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = マドロック_FACE_4
					;通常時
					CASEELSE
						RESULTS_F = マドロック_FACE_3
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_CHARA_[[キャラ:머드락]], ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
;自分が防御側
ELSE
	SELECTCASE ARGS
		CASE "被回復量補正"
			SIF L_P == L_ACTOR
				RETURN 0
			RETURN 1, 0
	ENDSELECT
ENDIF
RETURN 0