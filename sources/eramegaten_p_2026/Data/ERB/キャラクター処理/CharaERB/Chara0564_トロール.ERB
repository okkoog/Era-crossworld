;--------------------------------------------------
;イベントフラグ
;1 = 六本木大歓楽街加入
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:트롤]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
IF ARG:2 == 1
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:트롤]], ARG, ARG:2

@SET_LEARN_SKILL_[[キャラ:트롤]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		CALL SET_LEARN_SKILL, ARG, "클로즈디", 1
		CALL SET_LEARN_SKILL, ARG, "부흐", 1
		CALL SET_LEARN_SKILL, ARG, "돌격", 1
		CALL SET_LEARN_SKILL, ARG, "디아", 12
		CALL SET_LEARN_SKILL, ARG, "라이트마", 14
		CALL SET_LEARN_SKILL, ARG, "일할의활천", 16
ENDSELECT
