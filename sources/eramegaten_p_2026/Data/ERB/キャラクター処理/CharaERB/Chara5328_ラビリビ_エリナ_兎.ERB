;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:에리나_라비리비]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:에리나_라비리비]], ARG, ARG:2
CALL SET_BTL_TALENT_[[キャラ:에리나_라비리비]], ARG, ARG:2
CALL SET_LEARN_SKILL_[[キャラ:에리나_라비리비]], ARG, ARG:2

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:에리나_라비리비]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		CALL SET_ENHANCE_BASE_FOR_NEW_CHARA, ARG, 50
		ABL:ARG:스킬1 = [[스킬:리본・부스트]]
		ABL:ARG:스킬2 = [[스킬:섬머솔트]]
		ABL:ARG:스킬3 = [[스킬:관통의일격]]
		ABL:ARG:스킬4 = [[스킬:달밤의떡찧기]]
		ABL:ARG:스킬5 = [[스킬:기합]]
		ABL:ARG:스킬6 = [[스킬:이악물기]]
		ABL:ARG:스킬7 = [[스킬:삼할의활천]]
		ABL:ARG:스킬8 = [[스킬:삼할의마맥]]
		CSTR:ARG:40 = ShinEraTensei内では、前衛でのタイマンに適したフィジカルと、リボンの魔法による補助が特徴。
		CSTR:ARG:41 = このエリナは相棒のリボンと共に全ての戦いを生き残り、『忘れられた少女』とも戦い抜いた、いわば『最高のウサギ』である。
	CASE 2
		CSTR:ARG:41 = ただし、このエリナは黒幕によって人間化したばかりであり、何の装備も技能もなくリボンと出会ってもいないただのウサミミ少女である。
		MARK:ARG:반발각인 = 2
		MARK:ARG:반발각인의취득내역 = 2
		;Lv55以降で習得する小回り・切り札級スキルを削除。2周目以降は……いいよもう。
		ABL:ARG:습득스킬11 = 0
		ABL:ARG:습득스킬12 = 0
		ABL:ARG:습득스킬13 = 0
		ABL:ARG:습득스킬14 = 0
		ABL:ARG:습득스킬15 = 0
		ABL:ARG:습득LV11 = 0
		ABL:ARG:습득LV12 = 0
		ABL:ARG:습득LV13 = 0
		ABL:ARG:습득LV14 = 0
		ABL:ARG:습득LV15 = 0
ENDSELECT

@SET_BTL_TALENT_[[キャラ:에리나_라비리비]], ARG, ARG:1
IF ARG:1 == 1
	CALL CHANGE_ROLE, ARG, "이능자_5"
	;CALL CLEAR_ROLE_TALENT, ARG
	;TALENT:ARG:비전투원 = 0
	;TALENT:ARG:이능자 = 5
ENDIF
@SET_LEARN_SKILL_[[キャラ:에리나_라비리비]], ARG, ARG:1
IF ARG:1 == 1
	CALL SET_LEARN_SKILL, ARG, "리본・부스트", 30
ENDIF
