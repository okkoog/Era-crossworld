@SET_BASE_[[キャラ:카렌_무대소녀]], ARG, ARG:1
IF ARG:1 == 1
	CFLAG:ARG:이벤트가입 = 1
	CFLAG:ARG:초기링크악마 = [[キャラ:킹・아서]]
	ABL:ARG:초기링크악마공격상성 = CSVABL(CFLAG:ARG:초기링크악마, GETNUM(ABL, "공격상성"))

	CSTR:ARG:롤설명2 = 톱스타/사랑하는 벗과 함께 살아가기 위해、모든 것을 바란 붉은 별。/설령、「당신」을、남김없이 불태워버린다 할지라도。
ENDIF

@SET_BTL_TALENT_[[キャラ:카렌_무대소녀]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		CALL CHANGE_ROLE, ARG, "무대소녀_1/톱스타_1", "공격의심득_3/마술의소양_2"
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:카렌_무대소녀]], ARG, ARG:1
IF ARG:1 == 1
	CALL SET_LEARN_SKILL, ARG, "기절의참격", 1, "変身形態", "メッセージ表示"
	CALL SET_LEARN_SKILL, ARG, "기합", 1, "変身形態", "メッセージ表示"
	CALL SET_LEARN_SKILL, ARG, "러브・하트", 1, "変身形態", "メッセージ表示"
	CALL SET_LEARN_SKILL, ARG, "메・디아라한", 1, "変身形態", "メッセージ表示"
	CALL SET_LEARN_SKILL, ARG, "라쿠・카쟈", 1, "変身形態", "メッセージ表示"
	CALL SET_LEARN_SKILL, ARG, "라쿠카쟈오토", 1, "変身形態", "メッセージ表示"
	CALL SET_LEARN_SKILL, ARG, "불굴의투지", 1, "変身形態", "メッセージ表示"
	CALL SET_LEARN_SKILL, ARG, "기공(소)", 1, "変身形態", "メッセージ表示"
ENDIF

;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:카렌_무대소녀]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("華恋_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("華恋_FACE_EX_0")
			RETURNF ""
		RESULTS_F = デフォルト
		CALLF DISPOSE_SPRITE_FORCE_F, TEMP_GID_START, "華恋_デフォルト"
		;アイコン設定時の表示に使うアイコン
		IF L_CHARA >= 0 && CSTR:L_CHARA:롤 == "舞台少女_トップスタァ"
			GCREATE TEMP_GID_START, 360, 360
			GDRAWSPRITE TEMP_GID_START, "華恋_FACE_1", 0, 0, 180, 180
			GDRAWSPRITE TEMP_GID_START, "華恋_FACE_2", 180, 0, 180, 180
			GDRAWSPRITE TEMP_GID_START, "華恋_FACE_0", 0, 180, 180, 180
			GDRAWSPRITE TEMP_GID_START, "華恋_FACE_EX_0", 180, 180, 180, 180
			SPRITECREATE "華恋_デフォルト", TEMP_GID_START
		ELSE
			GCREATE TEMP_GID_START, 360, 360
			GDRAWSPRITE TEMP_GID_START, "華恋_FACE_1", 0, 0, 180, 180
			GDRAWSPRITE TEMP_GID_START, "華恋_FACE_2", 180, 0, 180, 180
			GDRAWSPRITE TEMP_GID_START, "華恋_FACE_0", 0, 180, 180, 180
			SPRITECREATE "華恋_デフォルト", TEMP_GID_START
		ENDIF
		RESULTS_F:2 = 華恋_デフォルト
		RESULTS_F:1 = 華恋_FACE_1
		RETURNF ""
	CASE 1
		RESULTS_F = アナザー
		GDISPOSE TEMP_GID_START + 1
		GCREATEFROMFILE TEMP_GID_START + 1, GET_ICON_FOLDER_NAME(NO:L_CHARA, "キャラ画像") + "\\" + "華恋_FACE_4" + ".png"
		GDISPOSE TEMP_GID_START + 2
		GCREATEFROMFILE TEMP_GID_START + 2, GET_ICON_FOLDER_NAME(NO:L_CHARA, "キャラ画像") + "\\" +"華恋_FACE_5" + ".png"

		CALLF DISPOSE_SPRITE_FORCE_F, TEMP_GID_START+3, "華恋_アナザー"
		GCREATE TEMP_GID_START + 3, 180, 180
		GDRAWG TEMP_GID_START + 3, TEMP_GID_START + 1, 0, 0, 180, 180, 0, 0, 180, 180
		GDRAWG TEMP_GID_START + 3, TEMP_GID_START + 2, 90, 0, 180, 180, 0, 0, 180, 180
		SPRITECREATE "華恋_アナザー", TEMP_GID_START + 3
		RESULTS_F:1 = 華恋_アナザー
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:카렌_무대소녀]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "戦闘口上"
				RESULTS_F = 華恋_FACE_1
			CASE "調教"
				RESULTS_F = 華恋_FACE_2
			CASEELSE
				IF STRCOUNT(CSTR:L_CHARA:롤, "舞台少女") && GET_ROLE_CFLAG_DUNGEON(L_CHARA, "클라이맥스레뷰지속시간")
					IF CFLAG:L_CHARA:악마변신
						RESULTS_F = 華恋_FACE_EX_2
					ELSE
						RESULTS_F = 華恋_FACE_EX_1
					ENDIF
				ELSE
					IF CFLAG:L_CHARA:악마변신
						RESULTS_F = 華恋_FACE_EX_0
					ELSE
						RESULTS_F = 華恋_FACE_0
					ENDIF
				ENDIF
		ENDSELECT
	CASE "アナザー"
		IF L_SITUATION == "調教"
			RESULTS_F = 華恋_FACE_5
		ELSE
			RESULTS_F = 華恋_FACE_4
		ENDIF
	CASEELSE
ENDSELECT

