;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:링고]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:링고]], ARG, ARG:2

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:링고]], ARG, ARG:1
#DIM DYNAMIC LCOUNT
SELECTCASE ARG:1
	CASE 1
		;妊娠イベント追加分
		MARK:ARG:굴복각인 = 3;妊娠までしたんだから当然
		MARK:ARG:쾌락각인 = 3;同上
		TALENT:ARG:약점 = 1;不貞に対する後ろめたさ的な、奥様に対する弱み
		;上記の経験分を2倍に
		EXP:ARG:Ｖ경험 += 20
		EXP:ARG:Ａ경험 += 7
		EXP:ARG:절정경험 += 40
		EXP:ARG:성교경험 += 20
		EXP:ARG:질사경험 += 20
		EXP:ARG:정액경험 += 20
		EXP:ARG:봉사쾌락경험 += 40
		EXP:ARG:고통쾌락경험 += 10
		;その他追加
		EXP:ARG:애정경험 += 150;元々8割堕ちてたけど、一連の流れでさらに駄目押し
		
		IF 六本木娼婦フラグ予備1:17 > 0
			;妊娠中
			CALL SET_PREGNANCY, ARG, MASTER
		ENDIF
		IF 六本木娼婦フラグ予備2:17 > 0
			;出産済み
			TALENT:ARG:모성 = 1;出産済みなので			
			;出産経験、及び、口上イベントの隠し子数に加算
			EXP:ARG:출산경험 = 六本木娼婦フラグ予備2:17
			CFLAG:ARG:송금해주는인수부모 += 六本木娼婦フラグ予備2:17
		ENDIF
ENDSELECT