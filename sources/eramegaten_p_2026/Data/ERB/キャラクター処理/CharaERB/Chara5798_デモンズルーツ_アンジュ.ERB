;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:앙쥬_DR]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("アンジュ_DR_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("アンジュ_DR_FACE_1")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = アンジュ_DR_FACE_0
	CASEELSE
		RETURNF ""
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:앙쥬_DR]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		IF L_SITUATION == "赤面"
			RESULTS_F = アンジュ_DR_FACE_1
		ELSE
			SELECTCASE L_SITUATION
				CASE "調教", "赤面"
					RESULTS_F = アンジュ_DR_FACE_1
				CASEELSE
					IF IS_BADSTATE(L_CHARA, "CHARM")
						RESULTS_F = アンジュ_DR_FACE_1
					ELSE
						RESULTS_F = アンジュ_DR_FACE_0
					ENDIF
			ENDSELECT
		ENDIF
	CASEELSE
ENDSELECT