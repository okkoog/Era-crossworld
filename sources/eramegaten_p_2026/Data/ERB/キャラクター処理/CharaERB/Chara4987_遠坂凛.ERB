;--------------------------------------------------
;ERB\RPG\이벤트\EVENT_98_Fate\EVENT98_BASE.ERBで加入時に分岐
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:린Fate]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
IF ARG:2 == 1 || ARG:2 == 2
	CALL SET_BASE_[[キャラ:린Fate]], ARG, ARG:2
	CALL SET_BTL_TALENT_[[キャラ:린Fate]], ARG, ARG:2
	CALL SET_LEARN_SKILL_[[キャラ:린Fate]], ARG, ARG:2
ENDIF

@SHOP_NEWGAME_INITCHARA_[[キャラ:린Fate]], ARG
CALL SET_LEARN_SKILL_[[キャラ:린Fate]], ARG, CFLAG:ARG:이벤트가입

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:린Fate]], ARG, ARG:1
IF ARG:1 == 1 || ARG:1 == 2
	CALL SET_TALENT_PARTY_JOINABLE, ARG, "신용"
	IF ARG:1 == 1
		BASE:ARG:LV  = 80
		BASE:ARG:힘 = 15
		BASE:ARG:지혜 = 33
		BASE:ARG:마력 = 39
		BASE:ARG:내구 = 17
		BASE:ARG:속도 = 22
		BASE:ARG:운 = 12

		CALL SET_LINK_DEVIL, ARG, [[キャラ:에레쉬키갈]], "攻撃性能"
		;CFLAG:ARG:초기링크악마 = [[キャラ:에레쉬키갈]]
	ELSEIF ARG:1 == 2
		BASE:ARG:LV  = 80
		BASE:ARG:힘 = 15
		BASE:ARG:지혜 = 33
		BASE:ARG:마력 = 39
		BASE:ARG:내구 = 17
		BASE:ARG:속도 = 22
		BASE:ARG:운 = 12
		
		CALL SET_LINK_DEVIL, ARG, [[キャラ:이슈타르]], "攻撃性能"
		;CFLAG:ARG:초기링크악마 = [[キャラ:이슈타르]]
	ENDIF
ENDIF
@SET_BTL_TALENT_[[キャラ:린Fate]], ARG, ARG:1
IF ARG:1 == 1 || ARG:1 == 2
	CALL CHANGE_ROLE, ARG, "아웃사이더_1/이능자_3/도구지식_1"
	;CALL CLEAR_ROLE_TALENT, ARG
	;TALENT:ARG:아웃사이더 = 1
	;TALENT:ARG:이능자 = 3
	;TALENT:ARG:도구지식 = 1
ENDIF

@SET_LEARN_SKILL_[[キャラ:린Fate]], ARG, ARG:1
IF ARG:1 == 1
	CALL SET_LEARN_SKILL, ARG, "어둠의심판", 1, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "포그브레스", 1, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "메・디아라한", 1, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "영봉을밟고끌어안는명부의풀무", 1, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "파이널누드", 71, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "마하・마그바리온", 72, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "침묵의기도", 74, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "다크브레스", 76, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "명계의문", 78, "変身形態"
ELSEIF ARG:1 == 2
	CALL SET_LEARN_SKILL, ARG, "마하・잔다인", 1, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "사마리캄", 1, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "메・디아라한", 1, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "산맥을뒤흔드는샛별의장작", 1, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "파이널누드", 71, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "마하・지오다인", 72, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "침묵의기도", 74, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "천상의춤", 76, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "림도라온", 78, "変身形態"
ENDIF
