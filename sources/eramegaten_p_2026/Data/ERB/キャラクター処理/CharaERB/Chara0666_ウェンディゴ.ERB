;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:웬디고]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:웬디고]], ARG, ARG:2
IF ARG:2 == 1
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:웬디고]], ARG, ARG:2
CALL LEARN_SKILL_TO_NOW_LEVEL, ARG

;Data\ERB\RPG\ダンジョンアタック\ダンジョンデータ\DUNGEON8_警視庁.ERB
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:웬디고]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		;妖鬼ミズキ　弟がウェンディゴと縁があったので……	
		CALL ＴＳ処理, ARG, 3
		TALENT:ARG:우둔 = 0
		TALENT:ARG:해방 = 0
		
		;通常個体より魔重視に
		SWAP BASE:ARG:힘, BASE:ARG:마력

		TALENT:ARG:처녀 = 1
		TALENT:ARG:Ｃ민감 = 1
		TALENT:ARG:Ｂ민감 = 1
		TALENT:ARG:프라이드높음 = 1
		TALENT:ARG:일선을넘지않음 = 1
		TALENT:ARG:억압 = 1
		TALENT:ARG:불결무시 = 1
		TALENT:ARG:헌신적 = 1
		TALENT:ARG:절벽 = 1
		TALENT:ARG:바이 = 1
		TALENT:ARG:아픔에강함 = 1
		TALENT:ARG:현명 = 1
		
		;무인
		ABL:ARG:회화타입 = 311
		
		;メガインテリメガネを産む！
		ABL:ARG:수태아이템 = GETNUM(ITEM, "메가인텔리안경")
		
		CSTR:ARG:11 = 俺
		CSTR:ARG:12 = マスター
		
		CSTR:ARG:타이틀 = 女野蛮人
		CSTR:ARG:36 = この個体は、真上水紀の身体を母体として召喚された特別な悪魔である。
		
		CSTR:ARG:38 = この魔都で召喚されるものは、知恵や魔力が低い個体が大半であるが、
		CSTR:ARG:39 = 彼女は魔法を得意とし、高い知性を持っている。
		
		NAME:ARG = ミズキ
		CALLNAME:ARG = ミズキ
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:웬디고]], ARG, ARG:1
#DIM LCOUNT
;ミズキ
IF ARG:1 == 1
	CALL CLEAR_ALL_LEARN_SKILL, ARG

	CALL SET_LEARN_SKILL, ARG, "절묘타", 1
	CALL SET_LEARN_SKILL, ARG, "얼음의난무", 1
	CALL SET_LEARN_SKILL, ARG, "독가스브레스", 1
	CALL SET_LEARN_SKILL, ARG, "포그브레스", 1

	CALL SET_LEARN_SKILL, ARG, "무거운한숨", 46
	CALL SET_LEARN_SKILL, ARG, "부흐다인", 47
	CALL SET_LEARN_SKILL, ARG, "마구날뛰기", 49
	CALL SET_LEARN_SKILL, ARG, "마하・부흐다인", 51
ENDIF

