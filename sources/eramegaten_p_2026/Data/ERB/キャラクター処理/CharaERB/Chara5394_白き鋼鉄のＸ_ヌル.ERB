;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:널_X2]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ヌル_X2_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("ヌル_X2_FACE_EX_0")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = ヌル_X2_FACE_0
	CASEELSE
		RESULTS_F = 
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:널_X2]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "FACE_EX_0"
				RESULTS_F '= "ヌル_X2_FACE_EX_0"
			CASEELSE
				RESULTS_F '= "ヌル_X2_FACE_0"
		ENDSELECT
	CASEELSE
ENDSELECT
