;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:청룡]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
IF ARG:2 == 1
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:청룡]], ARG, ARG:2
CALL SET_BASE_[[キャラ:청룡]], ARG, ARG:2

@SET_BASE_[[キャラ:청룡]], ARG, ARG:1
#DIM DYNAMIC LCOUNT
IF ARG:1 == 1
	NAME:ARG = セイリュウゾンビ
	CALLNAME:ARG = セイリュウゾンビ
	ABL:ARG:종족 = 11
	CSTR:ARG:종족명 = 屍鬼
	TALENT:ARG:악취민감 = 0
	TALENT:ARG:좀비 = 1
	BASE:ARG:검격 = 125
	BASE:ARG:화염 = 250
	BASE:ARG:파마 = 400
	CFLAG:ARG:선악치 = 0
	CFLAG:ARG:질혼치 = 0
	; プロフィール消去
	FOR LCOUNT,30,49
		CSTR:LOCAL:LCOUNT '= ""
	NEXT
ENDIF

@SET_LEARN_SKILL_[[キャラ:청룡]], ARG, ARG:1
#DIM LCOUNT
;セイリュウゾンビ
IF ARG:1 == 1
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	CALL SET_LEARN_SKILL, ARG, "부흐라", 15
	CALL SET_LEARN_SKILL, ARG, "아이스브레스", 1
	CALL SET_LEARN_SKILL, ARG, "아이시클", 20
	FOR LCOUNT, 1, 21
		SIF CSVABL(NO:ARG, GETNUM(ABL, @"습득스킬{LCOUNT}")) == 0
			CONTINUE
		CALL SET_LEARN_SKILL, ARG, TOSTR(CSVABL(NO:ARG, GETNUM(ABL, @"습득스킬{LCOUNT}"))), CSVABL(NO:ARG, GETNUM(ABL, @"습득LV{LCOUNT}"))	
	NEXT
ENDIF

