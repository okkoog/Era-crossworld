;--------------------------------------------------
;ERB\RPG\개별이벤트\EVENT_K5604_島村卯月_個別イベント.ERBで素質変更
;--------------------------------------------------
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:우즈키]], ARG, ARG:1
IF ARG:1 == 1 
	CFLAG:ARG:초기링크악마 = [[キャラ:사이버스터]]
	ABL:ARG:초기링크악마사거리 = 1
	ABL:ARG:초기링크악마공격범위 = 1
	ABL:ARG:초기링크악마최저공격횟수 = 1
	ABL:ARG:초기링크악마최대공격횟수 = 1
	CSTR:ARG:클래스설명1 = パイロット/大型の兵器などに搭乗して戦う。
	CSTR:ARG:클래스설명2 = パイロット/大型の兵器などに搭乗して戦う。
ENDIF

@SET_BTL_TALENT_[[キャラ:우즈키]], ARG, ARG:1
IF ARG:1 == 1
	CALL CLEAR_ROLE_TALENT, ARG
	CALL CHANGE_ROLE, ARG, "아웃사이더_1/석세서_1"
	;TALENT:ARG:석세서 = 1
	;TALENT:ARG:아웃사이더 = 1
ENDIF

@SET_LEARN_SKILL_[[キャラ:우즈키]], ARG, ARG:1
IF ARG:1 == 1
	CALL CLEAR_ALL_LEARN_SKILL, ARG, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "어둠의심판", 1, "変身形態", "変身形態"
	CALL SET_LEARN_SKILL, ARG, "소닉붐", 1, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "이단찌르기", 1, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "산바람", 1, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "참철파", 1, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "안개베기", 21, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "스쿠・카쟈", 28, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "히트웨이브", 35, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "사이플래시", 42, "変身形態"
	CALL SET_LEARN_SKILL, ARG, "아카식버스터", 56, "変身形態"
ENDIF
