;--------------------------------------------------
;イベントフラグ
;1 = 小夜子(依頼:白き刃の後継者で加入する個体)
;2 = 変わった悪魔の売買で入手する個体
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:엔젤]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:엔젤]], ARG, ARG:2
CALL SET_LEARN_SKILL_[[キャラ:엔젤]], ARG, ARG:2

;Data\ERB\RPG\依頼\REQUEST_36_白き刃の後継者.ERB
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:엔젤]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		NAME:ARG = 天羽御夜子
		CALLNAME:ARG = 御夜子

		BASE:ARG:LV = 16
		BASE:ARG:힘 = 3
		BASE:ARG:지혜 = 13 
		BASE:ARG:마력 = 11
		BASE:ARG:내구 = 5
		BASE:ARG:속도 = 5
		BASE:ARG:운 = 5

		ABL:ARG:변이 = [[キャラ:버쳐]]
		ABL:ARG:변이레벨 = 38
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:엔젤]], ARG, ARG:1
#DIM LCOUNT
IF ARG:1 == 1
	CALL SET_LEARN_SKILL, ARG, "갈", 1
ENDIF
