;--------------------------------------------------
;イベントフラグ
;1 = 夢子(依頼:白き刃の後継者で加入する個体)
;2 = 変わった悪魔の売買で加入するリリムがランクアップした場合
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:소악마리림]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:소악마리림]], ARG, ARG:2
IF ARG:2 == 1
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:소악마리림]], ARG, ARG:2

;Data\ERB\RPG\依頼\REQUEST_36_白き刃の後継者.ERB
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:소악마리림]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		NAME:ARG = 姫百合夢子
		CALLNAME:ARG = 夢子
		ABL:ARG:변이 = [[キャラ:서큐버스]]
		ABL:ARG:변이레벨 = 39
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:소악마리림]], ARG, ARG:1
#DIM LCOUNT
IF ARG:1 == 1
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	CALL SET_LEARN_SKILL, ARG, "부흐", 1
	CALL SET_LEARN_SKILL, ARG, "마하・부흐", 1
	CALL SET_LEARN_SKILL, ARG, "자장가", 1
	CALL SET_LEARN_SKILL, ARG, "매혹물어뜯기", 1
	CALL SET_LEARN_SKILL, ARG, "데・카쟈", 18
	CALL SET_LEARN_SKILL, ARG, "영면의유혹", 22
ENDIF
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:소악마리림]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("小悪魔リリム_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("小悪魔リリム_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("小悪魔リリム_FACE_3")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = 小悪魔リリム_FACE_1
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("小悪魔リリム_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("小悪魔リリム_FACE_5")
			RETURNF ""
		SIF !SPRITECREATED("小悪魔リリム_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("小悪魔リリム_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("小悪魔リリム_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("小悪魔リリム_FACE_EX_3")
			RETURNF ""
		RESULTS_F = 旧リリム
		RESULTS_F:1 = 小悪魔リリム_FACE_4
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:소악마리림]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = 小悪魔リリム_FACE_2
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = 小悪魔リリム_FACE_2
				ELSEIF L_SITUATION:1 == "DYING"
					RESULTS_F = 小悪魔リリム_FACE_3
					;DYINGでの色相変換を回避させるための指定
					RESULT_F:1 = 1
				ELSE
					RESULTS_F = 小悪魔リリム_FACE_1
				ENDIF
		ENDSELECT
	CASE "旧リリム"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = 小悪魔リリム_FACE_5
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = 小悪魔リリム_FACE_EX_0
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = 小悪魔リリム_FACE_EX_1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = 小悪魔リリム_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = 小悪魔リリム_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = 小悪魔リリム_FACE_4
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT