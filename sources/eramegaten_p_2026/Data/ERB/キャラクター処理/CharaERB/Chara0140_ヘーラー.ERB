;--------------------------------------------------
;イベントフラグ
;1 = イベント通常加入
;2 = イベント凌辱加入
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:헤라]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:헤라]], ARG, ARG:2

@SET_BASE_[[キャラ:헤라]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		;ある程度戦力にしやすくするためにMAG強化を与える
		CALL SET_ENHANCE_BASE_FOR_NEW_CHARA, ARG, 50
		ABL:ARG:순종 = 2
		ABL:ARG:봉사정신 = 2
		MARK:ARG:굴복각인 = 2
	CASE 2
		;ある程度戦力にしやすくするためにMAG強化を与える
		CALL SET_ENHANCE_BASE_FOR_NEW_CHARA, ARG, 50
		MARK:ARG:반발각인 = 3
		;反発取得履歴も３に
		MARK:ARG:4 = 3
		ABL:ARG:Ｃ감각 = 2
		ABL:ARG:Ｂ감각 = 2
		ABL:ARG:Ｖ감각 = 2
		ABL:ARG:Ａ감각 = 2
		EXP:ARG:절정경험 = 70
		EXP:ARG:Ｖ경험 = 50
		EXP:ARG:Ａ경험 = 20
ENDSELECT
