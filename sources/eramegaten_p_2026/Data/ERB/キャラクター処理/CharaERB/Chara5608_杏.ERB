;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:후타바 안즈]], ARG, ARG:1
IF ARG:1 == 2 || ARG:1 == 3
	CFLAG:ARG:초기링크악마 = [[キャラ:벨페고르]]
	ABL:ARG:초기링크악마공격상성 = 2
	ABL:ARG:초기링크악마사거리 = 1
	ABL:ARG:초기링크악마공격범위 = 1
	ABL:ARG:초기링크악마최저공격횟수 = 1
	ABL:ARG:초기링크악마최대공격횟수 = 1
ENDIF

@SET_BTL_TALENT_[[キャラ:후타바 안즈]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 0
		CALL CHANGE_ROLE, ARG, "비전투원_1", , , "サブ素質引継ぎなし"
	CASE 1
		CALL CHANGE_ROLE, ARG, "이능자_5", , , "サブ素質引継ぎなし"
	CASE 2
		CALL CHANGE_ROLE, ARG, "아웃사이더_1/이능자_3", , , "サブ素質引継ぎなし"
	CASE 3
		CALL CHANGE_ROLE, ARG, "아웃사이더_1/이능자_3/마도의재능_3", , , "サブ素質引継ぎなし"

		;CALL CLEAR_ROLE_TALENT, ARG
		;TALENT:ARG:아웃사이더 = 1
		;TALENT:ARG:이능자 = 3
		;TALENT:ARG:마도의재능 = 3
		CALL SYNC_STATUS, ARG
ENDSELECT
@SET_LEARN_SKILL_[[キャラ:후타바 안즈]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 0
		CALL CLEAR_ALL_LEARN_SKILL, ARG
	CASE 1
		CALL SET_LEARN_SKILL, ARG, "부흐", 1, "通常形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "트라프리", 1, "通常形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "타루・카쟈", 8, "通常形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "부흐라", 13, "通常形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "마카・카쟈", 16, "通常形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "토라에스트", 20, "通常形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "타룬・다", 23, "通常形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "마칸・다", 26, "通常形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "데・카쟈", 35, "通常形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "어드바이스", 40, "通常形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "추격의심득", 45, "通常形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "컨센트레이트", 58, "通常形態", "メッセージ表示"
	CASE 2, 3
		CALL SET_LEARN_SKILL, ARG, "얼음의난무", 1, "変身形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "회오리", 30, "変身形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "헬즈아이", 62, "変身形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "영면의유혹", 63, "変身形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "마하・부흐다인", 65, "変身形態", "メッセージ表示"
		CALL SET_LEARN_SKILL, ARG, "유혹의안개", 68, "変身形態", "メッセージ表示"
ENDSELECT
