;-------------------------------------------------
;キャラクター独自変数名称定義関数
;5951の部分にキャラのNOをいれます
;
;キャラクター独自変数は名称が定義されていないキャラクター(NO)の参照と代入で落ちる仕組みになっているので
;NOが確定している状況(個別イベント内・SKILL_CHANGE関数通過後、専用技内…など)で利用してください。
;-------------------------------------------------
@RPG_CFLAG_NAME_[[キャラ:나이트레인_리브라]], ARGS, ARG
#FUNCTIONS
SELECTCASE ARGS	;---------------------------------------------
	;RPG_CSTR_TAKEOVER
	;戦闘開始毎にリセットされる数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS '= "取引テーブル作成ターン"
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる文字列型変数です
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "RPG_CSTR_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = 取引内容0
			CASE 1
				RESULTS = 取引内容1
			CASE 2
				RESULTS = 取引内容2
		ENDSELECT
ENDSELECT
RETURNF RESULTS