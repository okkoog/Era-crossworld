;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:제퓨티_베이커리작전]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ジェフティ_パン屋作戦_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("ジェフティ_パン屋作戦_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("ジェフティ_パン屋作戦_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("ジェフティ_パン屋作戦_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("ジェフティ_パン屋作戦_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("ジェフティ_パン屋作戦_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("ジェフティ_パン屋作戦_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("ジェフティ_パン屋作戦_FACE_EX_3")
			RETURNF ""
		RESULTS_F = 1
		RESULTS_F:1 = ジェフティ_パン屋作戦_FACE_1
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:제퓨티_베이커리작전]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "1"
		SELECTCASE L_SITUATION
			CASE "調教"
				CALLF 陥落(L_CHARA)
				IF RESULTS == "연모" || RESULTS == "신뢰"
					RESULTS_F = ジェフティ_パン屋作戦_FACE_4
				ELSE
					RESULTS_F = ジェフティ_パン屋作戦_FACE_2
				ENDIF
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ジェフティ_パン屋作戦_FACE_EX_0
					;CHARMになった時
					CASE "CHARM"
						RESULTS_F = ジェフティ_パン屋作戦_FACE_EX_1
					;SLEEPになった時
					CASE "SLEEP"
						RESULTS_F = ジェフティ_パン屋作戦_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = ジェフティ_パン屋作戦_FACE_EX_3
					;通常時
					CASEELSE
						CALLF 陥落(L_CHARA)
						IF RESULTS == "연모" || RESULTS == "신뢰"
							RESULTS_F = ジェフティ_パン屋作戦_FACE_3
						ELSE
							RESULTS_F = ジェフティ_パン屋作戦_FACE_1
						ENDIF
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT