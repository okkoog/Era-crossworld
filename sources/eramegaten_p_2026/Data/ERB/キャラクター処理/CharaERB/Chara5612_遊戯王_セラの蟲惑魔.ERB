;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:세라의충혹마]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("セラの蟲惑魔_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("セラの蟲惑魔_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("セラの蟲惑魔_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("セラの蟲惑魔_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("セラの蟲惑魔_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("セラの蟲惑魔_FACE_EX_3")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = セラの蟲惑魔_FACE_0
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:세라의충혹마]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = セラの蟲惑魔_FACE_1
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = セラの蟲惑魔_FACE_EX_0
					;CHARMになった時
					CASE "CHARM"
						RESULTS_F = セラの蟲惑魔_FACE_EX_1
					;SLEEPになった時
					CASE "SLEEP"
						RESULTS_F = セラの蟲惑魔_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = セラの蟲惑魔_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = セラの蟲惑魔_FACE_0
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT