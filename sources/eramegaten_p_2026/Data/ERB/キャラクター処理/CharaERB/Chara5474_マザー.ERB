;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:마더_X2]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:마더_X2]], ARG, ARG:2

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:마더_X2]], ARG, ARG:1
IF ARG:1 == 0
	NAME:ARG = マザー
	CALLNAME:ARG = マザー
	;人間大サイズになりました
	TALENT:ARG:거체 = 0
	CSTR:ARG:43 = シナリオでも示された通り、彼女はＲｏＲｏの平行同位体。
	CSTR:ARG:44 = 高度に構築されたＡＩは限りなく人間に近い精神を構成しており、
	CSTR:ARG:45 = ついには「魂」と呼び得るものを所持するまでに至る。
	CSTR:ARG:46 = ……そして%CALLNAME:MASTER%によって魂をドリー・カドモンへ封入されたことで、
	CSTR:ARG:47 = 彼女は悪魔として新生したのである。
ENDIF

;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:마더_X2]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("マザー_X2_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("マザー_X2_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("マザー_X2_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("マザー_X2_FACE_EX_2")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = マザー_X2_FACE_0
	CASEELSE
		RESULTS_F = 
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:마더_X2]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "FACE_EX_2"
				RESULTS_F '= "マザー_X2_FACE_EX_2"
			CASE "FACE_EX_1"
				RESULTS_F '= "マザー_X2_FACE_EX_1"
			CASE "FACE_EX_0"
				RESULTS_F '= "マザー_X2_FACE_EX_0"
			CASEELSE
				RESULTS_F '= "マザー_X2_FACE_0"
		ENDSELECT
	CASEELSE
ENDSELECT
