;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:메두사_Fate]], L_CHARA, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("メドゥーサ_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("メドゥーサ_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("メドゥーサ_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("メドゥーサ_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("メドゥーサ_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("メドゥーサ_FACE_EX_3")
			RETURNF ""
		RESULTS_F = 안경
		RESULTS_F:1 = メドゥーサ_FACE_1
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("メドゥーサ_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("メドゥーサ_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("メドゥーサ_FACE_EX_4")
			RETURNF ""
		SIF !SPRITECREATED("メドゥーサ_FACE_EX_5")
			RETURNF ""
		SIF !SPRITECREATED("メドゥーサ_FACE_EX_6")
			RETURNF ""
		SIF !SPRITECREATED("メドゥーサ_FACE_EX_7")
			RETURNF ""
		RESULTS_F = 안대
		RESULTS_F:1 = メドゥーサ_FACE_3
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:메두사_Fate]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "안경"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = メドゥーサ_FACE_2
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = メドゥーサ_FACE_EX_0
					;CHARMになった時
					CASE "CHARM"
						RESULTS_F = メドゥーサ_FACE_EX_1
					;SLEEPになった時
					CASE "SLEEP"
						RESULTS_F = メドゥーサ_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = メドゥーサ_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = メドゥーサ_FACE_1
				ENDSELECT
				;HPが25%未満だとDYINGまでこれに固定する
				IF 現HP割合(L_CHARA) < 25
					RESULTS_F = メドゥーサ_FACE_EX_0
				ENDIF
		ENDSELECT
	CASE "안대"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = メドゥーサ_FACE_4
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = メドゥーサ_FACE_EX_4
					;CHARMになった時
					CASE "CHARM"
						RESULTS_F = メドゥーサ_FACE_EX_5
					;SLEEPになった時
					CASE "SLEEP"
						RESULTS_F = メドゥーサ_FACE_EX_6
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = メドゥーサ_FACE_EX_7
					;通常時
					CASEELSE
						RESULTS_F = メドゥーサ_FACE_3
				ENDSELECT
				;HPが25%未満だとDYINGまでこれに固定する
				IF 現HP割合(L_CHARA) < 25
					RESULTS_F = メドゥーサ_FACE_EX_4
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT