;--------------------------------------------------
;イベントフラグ
;1 = 強者募集
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:스핑크스]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:스핑크스]], ARG, ARG:2
CALL SET_SKILL_[[キャラ:스핑크스]], ARG, ARG:2

@SET_BASE_[[キャラ:스핑크스]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		TALENT:ARG:호기심 = 0
		TALENT:ARG:보수적 = 1
		TALENT:ARG:비관적 = 0

		CALL 初期衣装セット, ARG, "마이크로브라", "G스트링"

		;ある程度戦力にしやすくするためにMAG強化を与える
		CALL SET_ENHANCE_BASE_FOR_NEW_CHARA, ARG, 50
ENDSELECT
@SET_SKILL_[[キャラ:스핑크스]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		CALL SET_LEARN_SKILL, ARG, "그라이바", 1
		CALL SET_LEARN_SKILL, ARG, "중력의벽", 1
ENDSELECT