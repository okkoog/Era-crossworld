;--------------------------------------------------
;イベントフラグ
;1 = 精神世界加入
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:이자・벨]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:이자・벨]], ARG, ARG:2
IF ARG:2 == 1
	;ある程度戦力にしやすくするためにMAG強化を与える
	CALL SET_ENHANCE_BASE_FOR_NEW_CHARA, ARG, 50
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:이자・벨]], ARG, ARG:2

@SHOP_NEWGAME_INITCHARA_[[キャラ:이자・벨]], ARG
CALL SET_LEARN_SKILL_[[キャラ:이자・벨]], ARG, CFLAG:ARG:이벤트가입

;Data\ERB\RPG\ダンジョンアタック\ダンジョンデータ\DUNGEON4_精神世界\DUNGEON4_精神世界_EVENT.ERB
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:이자・벨]], ARG, ARG:1
#DIM DYNAMIC LCOUNT
SELECTCASE ARG:1
	CASE 1
		ABL:ARG:수태아이템 = GETNUM(ITEM, "스킬카드【작열의꽃】")
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:이자・벨]], ARG, ARG:1
#DIM LCOUNT
IF ARG:1 == 1
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	CALL SET_LEARN_SKILL, ARG, "작열의꽃", 1
	CALL SET_LEARN_SKILL, ARG, "무드온", 1
	CALL SET_LEARN_SKILL, ARG, "마하・라기온", 1

	CALL SET_LEARN_SKILL, ARG, "컨센트레이트", 36
	CALL SET_LEARN_SKILL, ARG, "프레이라", 38
	CALL SET_LEARN_SKILL, ARG, "아기다인", 42
	CALL SET_LEARN_SKILL, ARG, "기공(중)", 45
	CALL SET_LEARN_SKILL, ARG, "프레이다인",48
	CALL SET_LEARN_SKILL, ARG, "무드다인",50
	CALL SET_LEARN_SKILL, ARG, "만마의난무",55
ENDIF