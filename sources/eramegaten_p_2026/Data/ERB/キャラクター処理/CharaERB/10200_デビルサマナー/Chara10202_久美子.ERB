;--------------------------------------------------
;ERB\RPG\ダンジョンアタック\ダンジョンデータ\DUNGEON85_古墳迷宮.ERBで加入時に分岐
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:쿠미코]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
IF ARG:2 == 1
	CALL SET_BASE_[[キャラ:쿠미코]], ARG, ARG:2
	CALL SET_BTL_TALENT_[[キャラ:쿠미코]], ARG, ARG:2
	CALL SET_SKILL_[[キャラ:쿠미코]], ARG, ARG:2
	CALL SET_LEARN_SKILL_[[キャラ:쿠미코]], ARG, ARG:2
ENDIF

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:쿠미코]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1 
		NAME:ARG = イナルナ姫
		CALLNAME:ARG = イナルナ姫

		;素質を変更（心がへし折れてるのでまあそんな感じに）
		;久美子の素質をイナルナっぽく変更し、心をへし折る
		ABL:ARG:순종 = 3
		ABL:ARG:Ｃ감각 = 1
		ABL:ARG:Ｖ감각 = 2
		ABL:ARG:Ａ감각 = 1
		ABL:ARG:Ｂ감각 = 1
		ABL:ARG:노출증 = 1
		ABL:ARG:마조끼 = 2
		ABL:ARG:정액중독 = 1
		MARK:ARG:고통각인 = 3
		MARK:ARG:반발각인 = 3
		MARK:ARG:4 = 3
		TALENT:ARG:처녀 = 0
		;心へし折りセット
		TALENT:ARG:겁쟁이 = 1
		TALENT:ARG:프라이드낮음 = 1
		TALENT:ARG:비관적 = 1
		TALENT:ARG:아픔에약함 = 1
		TALENT:ARG:약점 = 1
		TALENT:ARG:巨尻 = 1 ;動画で見てみたらいいケツしてたので

		EXP:ARG:Ｖ경험 = 20
		EXP:ARG:Ａ경험 = 10
		EXP:ARG:절정경험 = 5
		EXP:ARG:성교경험 = 20
		EXP:ARG:질사경험 = 10
		EXP:ARG:자위경험 = 5
		EXP:ARG:조교자위경험 = 5
