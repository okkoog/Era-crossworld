;--------------------------------------------------
;イベントフラグ
;1 = 軽度
;2 = 軽度2
;3 = 性奴隷
;4 = 壊れた性奴隷
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:토모코]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
SIF ARG:2 > 0
	CALL SET_RPG_CFLAG_TAKEOVER, ARG, "凌辱進行度", ダンジョンフラグ:(FLAG:현던전):0
CALL SET_BASE_[[キャラ:토모코]], ARG, ARG:2

@SET_BASE_[[キャラ:토모코]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		ABL:ARG:회화타입 = 301
		IF GET_RPG_CFLAG_TAKEOVER(ARG, "凌辱進行度") > 18
		;トモコの映像・初フェラ
			EXP:ARG:자위경험 += 20
			EXP:ARG:절정경험 += 3
			EXP:ARG:펠라경험 += 1
			EXP:ARG:피사경험 += 10
			CALL ADDS_ABNORMAL_EXP("公開自慰", ARG)
		ELSEIF GET_RPG_CFLAG_TAKEOVER(ARG, "凌辱進行度") > 16
		;トモコの映像・初絶頂と初くぱぁ
			EXP:ARG:자위경험 += 15
			EXP:ARG:절정경험 += 1
			EXP:ARG:피사경험 += 5
			CALL ADDS_ABNORMAL_EXP("公開自慰", ARG)
		ELSEIF GET_RPG_CFLAG_TAKEOVER(ARG, "凌辱進行度") > 14
		;トモコの映像・初クンニ
			EXP:ARG:자위경험 += 10
			EXP:ARG:피사경험 += 3
			CALL ADDS_ABNORMAL_EXP("公開自慰", ARG)
		ELSEIF GET_RPG_CFLAG_TAKEOVER(ARG, "凌辱進行度") > 12
		;トモコの映像・オナニー実演
			EXP:ARG:자위경험 += 5
			EXP:ARG:피사경험 += 1
			CALL ADDS_ABNORMAL_EXP("公開自慰", ARG)
		ELSE
		;トモコの会話・オナニー告白
			EXP:ARG:자위경험 += 3
			EXP:ARG:절정경험 += 1
		ENDIF
	CASE 2
		ABL:ARG:회화타입 = 301
		;破瓜寸前
		ABL:ARG:Ｃ감각 += 1
		EXP:ARG:자위경험 += 20
		EXP:ARG:절정경험 += 10
		EXP:ARG:정액경험 += 5
		EXP:ARG:봉사쾌락경험 += 5
		EXP:ARG:펠라경험 += 5
		EXP:ARG:피사경험 += 15
		CALL ADDS_ABNORMAL_EXP("公開自慰", ARG)
		CALL SHOW_ABNORMAL_EXP , ARG, 0
	CASE 3
		TALENT:ARG:처녀 = 0
		ABL:ARG:회화타입 = 301
		;スナッピーが破瓜
		ABL:ARG:Ｃ감각 += 1
		EXP:ARG:자위경험 += 20
		EXP:ARG:Ｖ경험 += 1
		EXP:ARG:키스경험 += 1
		EXP:ARG:절정경험 += 10
		EXP:ARG:성교경험 += 1
		EXP:ARG:정액경험 += 10
		EXP:ARG:봉사쾌락경험 += 5
		EXP:ARG:펠라경험 += 5
		EXP:ARG:피사경험 += 20
		EXP:ARG:Ｖ확장경험 += 1
		CALL ADDS_ABNORMAL_EXP, "拡張初体験", ARG
		CALL ADDS_ABNORMAL_EXP, "処女喪失（撮影）" , ARG
		CALL ADDS_ABNORMAL_EXP("公開自慰", ARG)
		CALL SHOW_ABNORMAL_EXP , ARG, 0
	CASE 4
		TALENT:ARG:음란 = 1
		TALENT:ARG:처녀 = 0
		ABL:ARG:회화타입 = 301
		;スナッピーが種付け
		ABL:ARG:Ｃ감각 += 2
		ABL:ARG:Ｖ감각 += 1
		ABL:ARG:Ｂ감각 += 1
		ABL:ARG:기교 += 1
		EXP:ARG:Ｖ경험 += 20
		EXP:ARG:키스경험 += 10
		EXP:ARG:자위경험 += 30
		EXP:ARG:절정경험 += 30
		EXP:ARG:성교경험 += 30
		EXP:ARG:질사경험 += 20
		EXP:ARG:정액경험 += 40
		EXP:ARG:봉사쾌락경험 += 20
		EXP:ARG:펠라경험 += 20
		EXP:ARG:고통쾌락경험 += 10
		EXP:ARG:피사경험 += 50
		EXP:ARG:Ｖ확장경험 += 15
		IF GET_RPG_CFLAG_TAKEOVER(ARG, "凌辱進行度") > 23
			ABL:ARG:Ａ감각 += 1
			EXP:ARG:Ａ경험 += 10
			EXP:ARG:Ａ확장경험 += 10
		ENDIF
		CALL ADDS_ABNORMAL_EXP, "拡張初体験", ARG
		CALL ADDS_ABNORMAL_EXP, "処女喪失（撮影）" , ARG
		CALL ADDS_ABNORMAL_EXP("公開自慰", ARG)
		CALL SHOW_ABNORMAL_EXP , ARG, 0
	CASE 5
		TALENT:ARG:붕괴 = 1
		TALENT:ARG:음란 = 1
		TALENT:ARG:처녀 = 0
		TALENT:ARG:유아／유아퇴행 = 1
		ABL:ARG:회화타입 = 301
		;ガキ輪姦で種付け
		ABL:ARG:Ｃ감각 += 2
		ABL:ARG:Ｖ감각 += 2
		ABL:ARG:Ａ감각 += 2
		ABL:ARG:Ｂ감각 += 2
		ABL:ARG:기교 += 2
		EXP:ARG:자위경험 += 40
		EXP:ARG:Ｖ경험 += 100
		EXP:ARG:키스경험 += 50
		EXP:ARG:Ａ경험 += 50
		EXP:ARG:절정경험 += 100
		EXP:ARG:성교경험 += 150
		EXP:ARG:질사경험 += 100
		EXP:ARG:정액경험 += 200
		EXP:ARG:봉사쾌락경험 += 100
		EXP:ARG:펠라경험 += 100
		EXP:ARG:고통쾌락경험 += 50
		EXP:ARG:Ｖ확장경험 += 75
		EXP:ARG:Ａ확장경험 += 50
		EXP:ARG:피사경험 += 150
		CALL ADDS_ABNORMAL_EXP, "拡張初体験", ARG
		CALL ADDS_ABNORMAL_EXP, "処女喪失（撮影）" , ARG
		CALL ADDS_ABNORMAL_EXP("公開自慰", ARG)
		CALL SHOW_ABNORMAL_EXP , ARG, 0
ENDSELECT
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:토모코]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("トモコ_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("トモコ_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("トモコ_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("トモコ_FACE_EX_1")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = トモコ_FACE_1
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:토모코]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = トモコ_FACE_2
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = トモコ_FACE_EX_0
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = トモコ_FACE_EX_1
					;通常時
					CASEELSE
						RESULTS_F = トモコ_FACE_1
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT

