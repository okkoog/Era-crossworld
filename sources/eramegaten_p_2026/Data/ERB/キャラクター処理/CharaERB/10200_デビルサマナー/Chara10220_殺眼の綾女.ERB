;--------------------------------------------------
;ERB\RPG\EVENT\新凪ちゃんイベント……下のERBで加入時に分岐
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:살안의아야메]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
	IF ARG:2 != -1
		CALL SET_BASE_[[キャラ:살안의아야메]], ARG, ARG:2
;特に操作する事項ないのでコメントアウト
;		CALL SET_BTL_TALENT_[[キャラ:살안의아야메]], ARG, ARG:2
;		CALL SET_LEARN_SKILL_[[キャラ:살안의아야메]], ARG, ARG:2
	ENDIF

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:살안의아야메]], ARG, ARG:1
#DIM 綾女イベフラ
	綾女イベフラ = ARG:1

	IF 0
	;凪仲間ルートで加入
	ELSEIF 綾女イベフラ == 1
		;仲間にならない
	;凪敵対ルートで加入
	ELSEIF 綾女イベフラ == 2
		;戦闘参加不可能状態で加入
		CALL SET_TALENT_PARTY_JOINABLE, ARG, "参加不可能"
		MARK:LOCAL:반발각인 = 3
		MARK:LOCAL:4 = 3

		;CSV上綾女は装備を着用していない
		;（敗北してお持ち帰りで、装備を破壊されてる……ということにさせてくれ）

		;こちらはCSV上の初期レベル、50で加入
		;50までのスキルを覚えた扱いにしておく
		;初期スキルはCSVの方で設定済み
		FOR LOCAL:1, 1, 21
			IF ABL:LOCAL:("습득LV"+TOSTR(LOCAL:1)) <= BASE:LOCAL:LV
				ABL:LOCAL:("습득스킬"+TOSTR(LOCAL:1)) = 0
				ABL:LOCAL:("습득LV"+TOSTR(LOCAL:1)) = 0
			ENDIF
		NEXT

	;凪奴隷ルートで加入
	ELSEIF 綾女イベフラ == 3
		;仲間にならない
	ELSE
		;4でニンジャとして加入する可能性、ややある
	ENDIF

@SET_BTL_TALENT_[[キャラ:살안의아야메]], ARG, ARG:1
#DIM 綾女イベフラ
	綾女イベフラ = ARG:1

	IF 0
	;凪仲間ルートで加入
	ELSEIF 綾女イベフラ == 1
		;仲間にならない
	;凪敵対ルートで加入
	ELSEIF 綾女イベフラ == 2
		;このルートで特定の選択肢を取った場合のみ仲間になる
		;変更事項はない
	;凪奴隷ルートで加入
	ELSEIF 綾女イベフラ == 3
		;仲間にならない
	ELSE
		;4でニンジャとして加入する可能性、ややある
	ENDIF



@SET_LEARN_SKILL_[[キャラ:살안의아야메]], ARG, ARG:1
#DIM 綾女イベフラ
	綾女イベフラ = ARG:1

	IF 0
	;凪仲間ルートで加入
	ELSEIF 綾女イベフラ == 1
	;凪敵対ルートで加入
	ELSEIF 綾女イベフラ == 2
	;凪奴隷ルートで加入
	ELSEIF 綾女イベフラ == 3
	ELSE
		;4でニンジャとして加入する可能性、ややある
	ENDIF



