;
;	Module		:Chara4768_凪.ERB
;	Facility	:ERB上から独自の変更をキャラクターに与える
;				:与えられる補正自体はスキルでパッシブの補正として持たさられるものなので原理的にはスキル枠を消費しないスキル
;				;あるいはスキル削除が通用しないスキルとなる。あえて排除しない場合、ペルソナ・リンク悪魔として利用しているときにも呼ばれるのに注意
;
;	Licence		:ライセンスフリー。
;
;	Modification Data:
;
;	Edit	Date			Author					Reason
;	001		2023/05/15		NEO						新規作成
;	002		2025/05/29		epizo					画像パターン設定
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;--------------------------------------------------
;ERB\RPG\EVENT\新凪ちゃんイベント……下のERBで加入時に分岐
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:나기]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
	IF ARG:2 != -1
		CALL SET_BASE_[[キャラ:나기]], ARG, ARG:2
		CALL SET_BTL_TALENT_[[キャラ:나기]], ARG, ARG:2
		CALL SET_LEARN_SKILL_[[キャラ:나기]], ARG, ARG:2
	ENDIF

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:나기]], ARG, ARG:1
#DIM 凪NO
#DIM 凪イベフラ
	凪NO = ARG
	凪イベフラ = ARG:1

	IF 0
	;仲間ルートで加入
	ELSEIF 凪イベフラ == 1
		;TALENT,BASE,EXPなどの変動はなし
		;調教を受けたら戦闘に参加しなくなる状態で加入
		CALL SET_TALENT_PARTY_JOINABLE, 凪NO, "신용"
	;敵対ルートで加入
	;大きく変動
	;このあたり、きちんと調べて後で自分がもしかしたら使うかもな感じのメモということで、色々やる
	ELSEIF 凪イベフラ == 2
		;===================================
		;●関連フラグ
		;===================================
		;このあたりに関わるフラグはこの辺り。
		;イベントフラグ:41:3
		;　　凪が犯された回数。0-5の値を取る。
		;　　　0：一回も犯していない
		;　　　1-4：1-4回犯した
		;　　　5：発狂凪を撃破した
		;イベントフラグ:41:6
		;　　綾女の状況。1-5の値を取る。
		;　　　1：一矢報いられたが殺害した
		;　　　2：殺害した
		;　　　3：放置して帰った（5になるならこのルートしかありえない）
		;　　　4：綾女を持ち帰った
		;　　　5：ラストで綾女を挑発し戦闘した
		

		;===================================
		;●イベント加入部分
		;===================================
		;戦闘参加不可能かどうか、イベント加入したか……とか、そのへん

		;戦闘参加不可能についてメモ
		;　-1：調教を受けたら戦闘参加が不可能になる
		;　 0：調教を受けても戦闘参加が可能
		;　 1：戦闘参加不可能
		;　 2：上司NTRとかで戦闘参加しなくなった状態

		;綾女が生きている場合（かつ、綾女と一緒に捕らえてない場合）は戦闘参加可能（調教してもOK)で加入
		;綾女と一緒に捕まえた場合は犯した回数に応じる
		IF イベントフラグ:41:6 == 3
			CALL SET_TALENT_PARTY_JOINABLE, 凪NO, "参加可能"
		;犯した回数が1-3回だと、屈服しきってないので戦闘に参加してくれない
		ELSEIF イベントフラグ:41:3 >= 1 && イベントフラグ:41:3 <= 3
			CALL SET_TALENT_PARTY_JOINABLE, 凪NO, "参加不可能"
		;一回も犯してない、または、4回以上犯した場合は、戦闘に参加してくれる
		ELSE
			CALL SET_TALENT_PARTY_JOINABLE, 凪NO, "参加可能"
		ENDIF

		;이벤트가입
		;いつか誰かが口上書くときのため、「敵対ルートで加入した」……というフラグを立てておく（仲間ルートでは「１」）
		;このフラグそのものにあまり意味はない。口上などで使用するためのもの。
		;これについては加入時に弄ってるので、ここでは弄らない
;		CFLAG:凪NO:이벤트가입 = 2

		;受胎アイテムの設定
		;스킬카드【요시츠네등장】
		;こっちのルートでは設定しない。仲間ルートエンディング報酬のひとつ。
;		ABL:凪NO:수태아이템 = 10000 + [[스킬:요시츠네등장]]


		;===================================
		;●刻印部分
		;===================================

		;屈服刻印３は確定
		MARK:凪NO:굴복각인 = 3

		;その他刻印
		IF イベントフラグ:41:3 == 0
			;ゼロ回で刻印は付かないですわねぇ
		;3回以下、かつ綾女が死んでいるかお持ち帰りされている
		ELSEIF イベントフラグ:41:3 <= 3 && イベントフラグ:41:6 != 3
			;当然っちゃ当然だが反発刻印３
			MARK:凪NO:반발각인 = 3

			;反発取得履歴（MARK:4）も３にする
			MARK:凪NO:4 = 3

			;あえて１を付ける。かわいいね。ちょっと気持ちよかったんだね。みたいな。
			MARK:凪NO:쾌락각인 = 1
		;4回以上
		ELSE
			;反発取得履歴（MARK:4）を３。つまり反発刻印が後からつかない（「既に反発刻印３が付いてそれを消した」のと同じ状態）
			MARK:凪NO:4 = 3
			MARK:凪NO:쾌락각인 = 3
		ENDIF


		;===================================
		;●陥落部分
		;===================================
		;犯した回数が0回の場合、未調教恋慕で加入
		;または綾女が生存、かつ綾女ごとお持ち帰りでない場合、恋慕だったことにして加入
		;※イベフラ:41:6 == 3→「EV41-2-5.刑務所で綾女を放置した」
		;　イベフラ41:6が3だと綾女が登場する、綾女と戦うことができるが、そうするとフラグが５に変化する
		IF (イベントフラグ:41:3 == 0 || イベントフラグ:41:6 == 3) && イベントフラグ:41:6 != 5
			CFLAG:凪NO:피조교횟수 = イベントフラグ:41:3
			SIF CFLAG:凪NO:피조교횟수 > 0
				CALL SET_陥落履歴, [[キャラ:나기]],"調教"
			CALL SET_陥落素質, 凪NO, "연모"
			;犯してた場合は処女を奪ったフラグも立てる
			SIF イベントフラグ:41:3 > 0 && イベントフラグ:41:6 == 3
				CALL SET_陥落履歴, [[キャラ:나기]],"처녀"
			;의존도。恋慕は1000からなので、……まあ1000くらいはあるじゃろ……ということで1000に
			CFLAG:凪NO:의존도 = 1000
		;犯した回数が3回以下の場合
		ELSEIF イベントフラグ:41:3 <= 3
			;屈服3止まり。つまりここではなんもしない
			;……あ、「調教したことがあって、処女を奪ったことがある」は必要だな。
			CALL SET_陥落履歴, [[キャラ:나기]],"調教"
			CALL SET_陥落履歴, [[キャラ:나기]],"처녀"

			;의존도。
			;服従は-1000から。
			CFLAG:凪NO:2 = -1000

		;犯した回数が4回の場合、服従状態で加入
		ELSEIF イベントフラグ:41:3 == 4
			CALL SET_陥落素質, 凪NO, "복종"
			CALL SET_陥落履歴, [[キャラ:나기]],"調教"
			CALL SET_陥落履歴, [[キャラ:나기]],"처녀"
			;의존도。
			;服従は-1000から。まあ2000くらいまでぶっちぎっていいかぁ……
			CFLAG:凪NO:의존도 = -2000
		;犯した回数が5回の場合（＝発狂状態の凪ちゃんを撃破した場合）隷属状態で加入
		ELSEIF イベントフラグ:41:3 == 5
			CALL SET_陥落素質, 凪NO, "예속"
			CALL SET_陥落履歴, [[キャラ:나기]],"調教"
			CALL SET_陥落履歴, [[キャラ:나기]],"처녀"
			;의존도。
			;隷属は-3000から。
			CFLAG:凪NO:2 = -3000
		ENDIF


		;===================================
		;●秩混・善悪部分
		;===================================
		;メモ：秩序混沌/善悪について
		;LC、LD軸は、0-255の値を取る
		;LC＝秩混値、LD＝善悪値は下記の通り。
		; 171以上＝1：L/L
		;  85以上＝2：N/N
		;それ以外＝3：C/D
		;善行の石などは、62ほど性格を変化させる。
		;/
		;凪ちゃんのCSV上のアライメントはNewtral-Law
		;ただ、コドクノマレビトの凪ちゃんはとてもいい子なので、Light-Newtralを基本とする

		;犯した回数が3回以下の場合、または綾女が生きてる場合
		IF イベントフラグ:41:3 <= 3 || イベントフラグ:41:6 == 3
			CFLAG:凪NO:선악치 = 200
			CFLAG:凪NO:질혼치 = 128
			ABL:凪NO:속성LD = 1
			ABL:凪NO:속성LC = 2
		;犯した回数が4回、または発狂凪を撃破した場合
		ELSE
			;D-Cに変更
			;心がへしおれて自分勝手になっている　でもすぐN-Nには戻れる数値　かわいいね
			CFLAG:凪NO:선악치 = 84
			CFLAG:凪NO:질혼치 = 84
			ABL:凪NO:속성LD = 3
			ABL:凪NO:속성LC = 3
		ENDIF


		;===================================
		;●素質/TALENT部分+이상경험
		;===================================

		;念のため処女をセット、後で散ります
		TALENT:凪NO:처녀   = 1

		;あと、なんか変なのに目覚めちゃうのは確定
		TALENT:凪NO:도착적 = 1

		;犯した回数が1回以上の場合：処女を失うのとその関連
		IF イベントフラグ:41:3 >= 1
			TALENT:凪NO:처녀 = 0

			;処女奪取人数カウント
			FLAG:처녀탈취인수 += 1

			;異常経験の付与
			;なお、異常経験を与える構文について。
			;引数は「ADDS_ABNORMAL_EXP("与える異常経験", 付与する対象)」となっている。
			;具体的にどうなのかはここでは書かない。「@ADDS_ABNORMAL_EXP」でGrepしてほしい。

			;とりあえず強姦で奪ったのは確定
			CALL ADDS_ABNORMAL_EXP("処女喪失（強姦）", 凪NO)

			;あなたが女性であれば同性に奪った奪われたと異常経験を付与
			IF !IS_MALE(MASTER)
				CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", 凪NO)
				CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", MASTER)
			ENDIF
		ENDIF

		;3回以上犯していると凪ちゃんの心が折れる
		IF イベントフラグ:41:3 >= 3
			TALENT:凪NO:저항   = 0
			TALENT:凪NO:비관적 = 1
			TALENT:凪NO:약점   = 1
		ENDIF

		;3回以上犯していると凪ちゃんの乳尻が成長する
		IF イベントフラグ:41:3 >= 3
			TALENT:凪NO:거유   = 1
			TALENT:凪NO:巨尻   = 1
		ENDIF

		;発狂凪ちゃん撃破ボーナス
		IF イベントフラグ:41:3 == 5
			TALENT:凪NO:해방         = 1
			TALENT:凪NO:오줌싸개버릇   = 1
			TALENT:凪NO:마조         = 1
			TALENT:凪NO:일선을넘지않음 = 0
			;さすがにこれはカットしておくね
;			TALENT:凪NO:광기   = 1
		ENDIF



		;===================================
		;●能力/ABL部分
		;===================================
		;いずれにおいても技巧は上がらない

		;犯した回数が0回の場合
		IF イベントフラグ:41:3 == 0
			;かなり従順な状態で、ちょっとマゾ入った感じで加入してくれる
			;あと自分でオナってたのでC感覚が増える（たぶんクリ派だよきっと）
			ABL:凪NO:순종     = 4
			ABL:凪NO:욕망     = 2
			ABL:凪NO:마조끼 = 1
			ABL:凪NO:Ｃ감각   = 1
			ABL:凪NO:봉사정신 = 1
		;犯した回数が1回の場合
		ELSEIF イベントフラグ:41:3 == 1
			ABL:凪NO:Ｃ감각   = 1
			ABL:凪NO:Ｖ감각   = 1
			ABL:凪NO:Ａ감각   = 1
			ABL:凪NO:Ｂ감각   = 1
			ABL:凪NO:순종     = 1
			ABL:凪NO:욕망     = 1
			ABL:凪NO:노출증   = 1
			ABL:凪NO:마조끼 = 1
		;犯した回数が2回の場合
		ELSEIF イベントフラグ:41:3 == 2
			ABL:凪NO:Ｃ감각   = 2
			ABL:凪NO:Ｖ감각   = 2
			ABL:凪NO:Ａ감각   = 2
			ABL:凪NO:Ｂ감각   = 2
			ABL:凪NO:순종     = 2
			ABL:凪NO:욕망     = 2
			ABL:凪NO:노출증   = 2
			ABL:凪NO:마조끼 = 2
		;犯した回数が3回の場合
		ELSEIF イベントフラグ:41:3 == 3
			;「복종」の条件を満たせるよう、ちょっとだけ感度の上昇を抑える（条件が「10未満」なのでギリギリ）
			ABL:凪NO:Ｃ감각   = 3
			ABL:凪NO:Ｖ감각   = 2
			ABL:凪NO:Ａ감각   = 2
			ABL:凪NO:Ｂ감각   = 2
			ABL:凪NO:순종     = 3
			ABL:凪NO:욕망     = 3
			ABL:凪NO:노출증   = 2
			ABL:凪NO:마조끼 = 2
		;犯した回数が4回の場合
		;服従状態で加入
		ELSEIF イベントフラグ:41:3 == 4
			;「예속」の条件を満たせるよう、感度合計は15未満
			ABL:凪NO:Ｃ감각   = 3
			ABL:凪NO:Ｖ감각   = 3
			ABL:凪NO:Ａ감각   = 3
			ABL:凪NO:Ｂ감각   = 3
			ABL:凪NO:순종     = 3
			ABL:凪NO:욕망     = 3
			ABL:凪NO:노출증   = 3
			ABL:凪NO:마조끼 = 3
			ABL:凪NO:봉사정신 = 3
		;犯した回数が5回の場合
		;隷属状態で加入
		ELSEIF イベントフラグ:41:3 == 5
			;既に隷属なのでガッと上げる
			;売ったら高そう（こなみ）
			ABL:凪NO:Ｃ감각   = 5
			ABL:凪NO:Ｖ감각   = 4
			ABL:凪NO:Ａ감각   = 5
			ABL:凪NO:Ｂ감각   = 4
			ABL:凪NO:순종     = 5
			ABL:凪NO:욕망     = 3
			ABL:凪NO:노출증   = 4
			ABL:凪NO:마조끼 = 5
			ABL:凪NO:봉사정신 = 3
		ENDIF

		;あなたが女だと、レズっ気も上昇
		IF !IS_MALE(MASTER)
			ABL:凪NO:레즈끼 = 2
		ENDIF


		;===================================
		;●経験/EXP部分
		;===================================
		;あなたが男女で分岐
		;元パッチ男女分岐なかったんだよなァ……

		;自慰経験増やすのは確定　すけべ
		;こことは関係ないが、eratohoの映姫様の「자위경험　２」がメチャクチャえっちで興奮したの覚えてる
		EXP:凪NO:자위경험     = 15

		;犯した回数が0回の場合
		IF イベントフラグ:41:3 == 0
			;経験は増えない
		;犯した回数が1回の場合
		ELSEIF イベントフラグ:41:3 == 1
			;経験を増やします
			EXP:凪NO:Ｖ경험        = 10
			EXP:凪NO:Ａ경험        = 20
			EXP:凪NO:절정경험      = 5
			EXP:凪NO:키스경험      = 5
			EXP:凪NO:고통쾌락경험  = 10

			;あなたがちんぽを持ってる
			IF HAVE_PENIS(MASTER)
				EXP:凪NO:질사경험  = 5
				EXP:凪NO:성교경험  = 5
				EXP:凪NO:정액경험  = 10
				EXP:凪NO:펠라경험 = 10
			ELSE
				EXP:凪NO:레즈경험  = 10
			ENDIF
		;犯した回数が2回の場合
		ELSEIF イベントフラグ:41:3 == 2
			;経験を増やします
			EXP:凪NO:Ｖ경험         = 20
			EXP:凪NO:Ａ경험         = 30
			EXP:凪NO:절정경험       = 15
			EXP:凪NO:키스경험       = 10
			EXP:凪NO:고통쾌락경험   = 20
			EXP:凪NO:봉사쾌락경험   = 10

			;あなたがちんぽを持ってる
			IF HAVE_PENIS(MASTER)
				EXP:凪NO:질사경험   = 10
				EXP:凪NO:성교경험   = 10
				EXP:凪NO:정액경험   = 20
				EXP:凪NO:펠라경험 = 20
			ELSE
				EXP:凪NO:레즈경험   = 20
			ENDIF

		;犯した回数が3回の場合
		ELSEIF イベントフラグ:41:3 == 3
			;経験を増やします
			EXP:凪NO:Ｖ경험         = 30
			EXP:凪NO:Ａ경험         = 40
			EXP:凪NO:절정경험       = 35
			EXP:凪NO:키스경험       = 20
			EXP:凪NO:고통쾌락경험   = 50
			EXP:凪NO:봉사쾌락경험   = 20

			;あなたがちんぽを持ってる
			IF HAVE_PENIS(MASTER)
				EXP:凪NO:질사경험   = 20
				EXP:凪NO:성교경험   = 20
				EXP:凪NO:정액경험   = 30
				EXP:凪NO:펠라경험 = 30
			ELSE
				EXP:凪NO:레즈경험   = 50
			ENDIF

		;犯した回数が4回の場合
		ELSEIF イベントフラグ:41:3 == 4
			;経験を増やします
			EXP:凪NO:Ｖ경험         = 40
			EXP:凪NO:Ａ경험         = 50
			EXP:凪NO:절정경험       = 60
			EXP:凪NO:키스경험       = 30
			EXP:凪NO:고통쾌락경험   = 100
			EXP:凪NO:봉사쾌락경험   = 50

			;あなたがちんぽを持ってる
			IF HAVE_PENIS(MASTER)
				EXP:凪NO:질사경험   = 30
				EXP:凪NO:성교경험   = 30
				EXP:凪NO:정액경험   = 40
				EXP:凪NO:펠라경험 = 40
			ELSE
				EXP:凪NO:레즈경험   = 100
			ENDIF

		;犯した回数が5回：発狂凪撃破後の場合
		ELSEIF イベントフラグ:41:3 == 5
			;経験を増やします
			EXP:凪NO:Ｖ경험         = 50
			EXP:凪NO:Ａ경험         = 60
			EXP:凪NO:절정경험       = 80
			EXP:凪NO:키스경험       = 50
			EXP:凪NO:고통쾌락경험   = 200
			EXP:凪NO:봉사쾌락경험   = 100

			;あなたがちんぽを持ってる
			IF HAVE_PENIS(MASTER)
				EXP:凪NO:질사경험   = 30
				EXP:凪NO:성교경험   = 30
				EXP:凪NO:정액경험   = 40
				EXP:凪NO:펠라경험 = 40
			ELSE
				EXP:凪NO:레즈경험   = 100
			ENDIF
		ENDIF
	;奴隷ルートで加入
	ELSEIF 凪イベフラ == 3
		;戦闘参加不可能状態で加入
		CALL SET_TALENT_PARTY_JOINABLE, 凪NO, "参加不可能"
	ELSE
		;4でニンジャとして加入する可能性、ややある
	ENDIF

@SET_BTL_TALENT_[[キャラ:나기]], ARG, ARG:1
#DIM 凪NO
#DIM 凪イベフラ
#DIM LCOUNT
	凪NO = ARG
	凪イベフラ = ARG:1

	IF 0
	;仲間ルートで加入
	ELSEIF 凪イベフラ == 1
	;敵対ルートで加入
	ELSEIF 凪イベフラ == 2

		;===================================
		;●戦闘関連部分
		;===================================
		;Lv80、純物理型として参戦
		;実質的にエンド報酬なので超高レベルでの加入、売ったら高そう
		;凪ちゃんの基礎能力は以下の通り
		;/
		;基礎,힘,4
		;基礎,지혜,6
		;基礎,마력,5
		;基礎,내구,4
		;基礎,속도,7
		;基礎,운,3
		;/
		;Lv5の合計パラは25.5プラマイ5くらい
		;合計29なのでやや優秀
		;でも魔力のほうが高いんだなァという感はややある

		;Lv80＝138プラマイ5くらい。
		;一応剣撃メインなので前衛型として、足は速めとして、シフト先ヨシツネよりはマンチ構成にはならないようややフラット気味にして
		;各ステ３は基本値として、Lv5のステから引いて、初期ステの成長比率を、比率１を確保しつつ大雑把に割り出して、前衛向け調整して……
		;120を「2.5：2：1.5：2：3：1」くらいで分配してチョチョイと調整して……
		;出来上がったのがこちらです
		BASE:凪NO:LV   = 80
		BASE:凪NO:힘   = 28
		BASE:凪NO:지혜 = 19
		BASE:凪NO:마력 = 16
		BASE:凪NO:내구 = 24
		BASE:凪NO:속도 = 38
		BASE:凪NO:운   = 13
		
		;現在経験値をセット
		;「5*(Lv-1)*LV*(Lv+1）/3」が人間の「現在レベルになる」経験値（悪魔はコレに「*5/4」する）
		;経験値が「5*(Lv)*(LV+1)*(Lv+2）/3」になると次のレベルになるわけだな
		BASE:凪NO:ＥＸＰ = 5*(BASE:凪NO:LV - 1)*(BASE:凪NO:LV)*(BASE:凪NO:LV + 1)/3

		;スキルセット
		;人間状態のスキル。
		;通常の凪ちゃんは覚えない「使い勝手のいい強スキル」も含みの強力なラインナップ
		;異能者なので12枠まで

		;「既にLv80までのスキルは習得した」ものとしておく
		;そのための「LvUPで覚えられるすべてのスキルをもう習得しましたよ」という処理
		;LvUPでスキルを習得すると、「覚えるスキル」と「その習得レベル」をゼロにする処理が走る
		;（周回時引継ぎを実行すると、CSVから再度スキルを習得するようになる）
		CALL CLEAR_ALL_SKILL, 凪NO
		CALL CLEAR_ALL_LEARN_SKILL, 凪NO

		;自力習得可能なスキルを全て習得済みスキルに入れる
		FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
			CALL SET_LEARNED_SKILL, 凪NO, TOSTR(CSVABL([[キャラ:나기]], GETNUM(ABL, @"스킬{LCOUNT}"))), "通常形態"
			CALL SET_LEARNED_SKILL, 凪NO, TOSTR(CSVABL([[キャラ:나기]], GETNUM(ABL, @"습득스킬{LCOUNT}"))), "通常形態"
		NEXT
		
		CALL SET_LEARN_SKILL, 凪NO, "작열거가"
		CALL SET_LEARN_SKILL, 凪NO, "파사의광인"
		CALL SET_LEARN_SKILL, 凪NO, "허공참파"
		CALL SET_LEARN_SKILL, 凪NO, "충의의참격"
		CALL SET_LEARN_SKILL, 凪NO, "기합"
		CALL SET_LEARN_SKILL, 凪NO, "요정후레옴"
		CALL SET_LEARN_SKILL, 凪NO, "오바리욘포효"
		CALL SET_LEARN_SKILL, 凪NO, "발진오보로구루마"
		CALL SET_LEARN_SKILL, 凪NO, "요시츠네등장"
		CALL SET_LEARN_SKILL, 凪NO, "삼할의마맥"
		CALL SET_LEARN_SKILL, 凪NO, "추격의심득"
		CALL SET_LEARN_SKILL, 凪NO, "필사적인공부"

		;FOR LOCAL:1, 1, 21
		;	IF ABL:LOCAL:("습득LV"+TOSTR(LOCAL:1)) <= BASE:LOCAL:LV
		;		ABL:LOCAL:("습득스킬"+TOSTR(LOCAL:1)) = 0
		;		ABL:LOCAL:("습득LV"+TOSTR(LOCAL:1)) = 0
		;	ENDIF
		;NEXT
;
		;ABL:凪NO:스킬1  = [[스킬:작열거가]]
		;ABL:凪NO:스킬2  = [[스킬:파사의광인]]
		;ABL:凪NO:스킬3  = [[스킬:허공참파]]
		;ABL:凪NO:스킬4  = [[스킬:충의의참격]]
		;ABL:凪NO:스킬5  = [[스킬:기합]]
		;ABL:凪NO:스킬6  = [[스킬:요정후레옴]]
		;ABL:凪NO:스킬7  = [[스킬:오바리욘포효]]
		;ABL:凪NO:스킬8  = [[스킬:발진오보로구루마]]
		;ABL:凪NO:스킬9  = [[스킬:요시츠네등장]]
		;ABL:凪NO:스킬10 = [[스킬:삼할의마맥]]
		;ABL:凪NO:스킬11 = [[스킬:추격의심득]]
		;ABL:凪NO:스킬12 = [[스킬:필사적인공부]]


		;発狂凪ちゃん撃破後
		IF イベントフラグ:41:3 == 5
			;専用リンク先、「ヨシツネ(凪)」のデビルシフターとして加入する
			;なお、こっちのルートで凪を加入させた後で、表ルート……凪仲間ルートを通ると、
			;「異能シフターサマナー、人間側も強力なスキルを習得」
			;……って感じになっちゃうのだが、周回プレイが必要なので、これはもう想定内というか、考慮外というか。
			CALL CHANGE_ROLE, 凪NO, "아웃사이더_1/이능자_3"
			;CFLAG:凪NO:초기링크악마 = [[キャラ:요시츠네_나기]]
			CFLAG:凪NO:초기링크악마 = [[キャラ:요시츠네_나기]]
			ABL:凪NO:초기링크악마사거리 = 3
			ABL:凪NO:초기링크악마공격범위 = 1
			ABL:凪NO:초기링크악마최저공격횟수 = 1
			ABL:凪NO:초기링크악마최대공격횟수 = 1
		ENDIF


		CALL SYNC_STATUS, ARG
	;奴隷ルートで加入
	ELSEIF 凪イベフラ == 3
		;아무것도안한다
	ELSE
		;4でニンジャとして加入する可能性、ややある
	ENDIF



@SET_LEARN_SKILL_[[キャラ:나기]], ARG, ARG:1
#DIM 凪イベフラ
	凪イベフラ = ARG:1

