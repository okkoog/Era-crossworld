#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("凪_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("凪_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("凪_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("凪_FACE_EX_1")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = 凪_FACE_1
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:나기]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = 凪_FACE_2
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = 凪_FACE_EX_0
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = 凪_FACE_EX_1
					;通常時
					CASEELSE
						RESULTS_F = 凪_FACE_1
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT