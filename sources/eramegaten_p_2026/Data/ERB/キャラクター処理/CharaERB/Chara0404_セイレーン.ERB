;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:세이렌]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_RPG_CFLAG_TAKEOVER, ARG, "救出日", DAY
CALL SET_BASE_[[キャラ:세이렌]], ARG, ARG:2
IF ARG:2 == 1
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:세이렌]], ARG, ARG:2

;1	単発イベント6
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:세이렌]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		NAME:ARG = Vo・セイレーン
		CALLNAME:ARG = Vo・セイレーン
		;歌唱技能付与しておかないと思い込みの激しいアホの子みたいになってしまうので
		ABL:ARG:가창기능 = 5
		EXP:ARG:가창경험 = 200
		EXP:ARG:라이브경험 = 100
		
		;こっちは素の能力値も向上させておく
		BASE:ARG:LV = 45
		BASE:ARG:힘 = 10
		BASE:ARG:지혜 = 17
		BASE:ARG:마력 = 35
		BASE:ARG:내구 = 5
		BASE:ARG:속도 = 15
		BASE:ARG:운 = 3

		TALENT:ARG:갈퀴 = 1
		
		TALENT:ARG:광기 = 0
		TALENT:ARG:감정결핍 = 0
		
		TALENT:ARG:츤데레 = 1
		TALENT:ARG:프라이드높음 = 1
		TALENT:ARG:눈에띄고싶어함 = 1
		TALENT:ARG:습득빠름 = 1
		TALENT:ARG:빈유 = 1
		TALENT:ARG:小尻 = 1
		TALENT:ARG:슬렌더 = 1
		
		ABL:ARG:순종 = 0
		ABL:ARG:욕망 = 1
		
		CSTR:ARG:일인칭 = あたし
		CSTR:ARG:이인칭 = 支配人
		
		CFLAG:ARG:매각불가플래그 = 1
		CFLAG:ARG:합체소재사용금지 = 1
		
		;---- EDIT 002 DEL START -------------------------
		;ここで『劇場憑きの悪魔』であることを定義
		;CFLAG:ARG:998 = 1
		;---- EDIT 002 DEL END ---------------------------
		
		CSTR:ARG:41 = この個体はあなたの劇場に憑いた悪魔である。存在するだけで収入を上昇させる。
		CSTR:ARG:42 = 我が非常に強いため、売却・合体は不可能である。
	CASE 2
		TALENT:ARG:처녀 = 1
		;淫紋ついてるイメージ。お手軽だが淫乱確定。狂気持ちやしまあええやろ……
		TALENT:ARG:Ｃ민감 = 1
		TALENT:ARG:Ｖ민감 = 1
		TALENT:ARG:Ｂ민감 = 1
		TALENT:ARG:Ａ민감 = 1
		TALENT:ARG:거유 = 1
		ABL:ARG:Ｃ감각 = 4
		ABL:ARG:Ａ감각 = 4
		ABL:ARG:Ｂ감각 = 4
		ABL:ARG:순종 = 2
		ABL:ARG:욕망 = 3
		ABL:ARG:노출증 = 3
		ABL:ARG:마조끼 = 3
		ABL:ARG:자위중독 = 1
		
		VARI L_DAY
		L_DAY = GET_RPG_CFLAG_TAKEOVER(ARG, "救出日")
		EXP:ARG:절정경험 = (L_DAY)*1
		EXP:ARG:Ａ경험 = (L_DAY)*10
		EXP:ARG:고통쾌락경험 = (L_DAY)*5
		EXP:ARG:방뇨경험 = (L_DAY)*5
		EXP:ARG:긴박경험 = (L_DAY)*10
		EXP:ARG:이상경험 = 2
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:세이렌]], ARG, ARG:1
IF ARG:1 == 1
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	CALL SET_LEARN_SKILL, ARG, "스펠그룸", 1
	CALL SET_LEARN_SKILL, ARG, "마음의외침", 1
	CALL SET_LEARN_SKILL, ARG, "브레인버스트", 1
	CALL SET_LEARN_SKILL, ARG, "정신가드킬", 1
	CALL SET_LEARN_SKILL, ARG, "최면파", 1
ENDIF

;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:세이렌]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		IF L_CHARA >= 0 && CFLAG:L_CHARA:이벤트가입 == 1
			RESULTS_F = ヴォーカリスト
			;アイコン設定時の表示に使うアイコン
			RESULTS_F:1 = セイレーン_FACE_EX_0
		ENDIF
	CASEELSE
		RESULTS_F = 
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:세이렌]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "ヴォーカリスト"
		RESULTS_F = セイレーン_FACE_EX_0
	CASEELSE
ENDSELECT
