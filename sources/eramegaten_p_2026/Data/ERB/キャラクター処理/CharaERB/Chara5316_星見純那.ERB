@SET_BASE_[[キャラ:쥰나]], ARG, ARG:1
IF ARG:1 == 1
	CFLAG:ARG:이벤트가입 = 1
	CFLAG:ARG:초기링크악마 = [[キャラ:영웅로빈후드]]
	ABL:ARG:초기링크악마공격상성 = CSVABL(CFLAG:ARG:초기링크악마, GETNUM(ABL, "공격상성"))
	
	CSTR:ARG:롤설명2 = 톱스타/우러러보던 소녀는 이제 없다。무대는 바로 이곳이다、비취의 별。/설령、「당신」을、남김없이 불태워버린다 할지라도。
ENDIF

@SET_BTL_TALENT_[[キャラ:쥰나]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		CALL CHANGE_ROLE, ARG, "무대소녀_1/톱스타_1", "공격의심득_3/마술의소양_2"
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:쥰나]], ARG, ARG:1
