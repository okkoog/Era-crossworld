	CALL SET_LEARN_SKILL, ARG, "기합", 1, "変身形態", "メッセージ表示"
	CALL SET_LEARN_SKILL, ARG, "전광석화", 1, "変身形態", "メッセージ表示"
	CALL SET_LEARN_SKILL, ARG, "스쿠・카쟈", 1, "変身形態", "メッセージ表示"
	CALL SET_LEARN_SKILL, ARG, "플래시봄", 1, "変身形態", "メッセージ表示"
	CALL SET_LEARN_SKILL, ARG, "테트라칸", 1, "変身形態", "メッセージ表示"
	CALL SET_LEARN_SKILL, ARG, "트라프리", 1, "変身形態", "メッセージ表示"
	CALL SET_LEARN_SKILL, ARG, "닷지카운터", 1, "変身形態", "メッセージ表示"
ENDIF
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:쥰나]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("純那_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("純那_FACE_EX_0")
			RETURNF ""
		RESULTS_F = デフォルト
		CALLF DISPOSE_SPRITE_FORCE_F, TEMP_GID_START, "純那_デフォルト"
		;アイコン設定時の表示に使うアイコン
		IF L_CHARA >= 0 && CSTR:L_CHARA:롤 == "舞台少女_トップスタァ"
			GCREATE TEMP_GID_START, 360, 360
			GDRAWSPRITE TEMP_GID_START, "純那_FACE_2", 0, 0, 180, 180
			GDRAWSPRITE TEMP_GID_START, "純那_FACE_3", 180, 0, 180, 180
			GDRAWSPRITE TEMP_GID_START, "純那_FACE_0", 0, 180, 180, 180
			GDRAWSPRITE TEMP_GID_START, "純那_FACE_EX_0", 180, 180, 180, 180
			SPRITECREATE "純那_デフォルト", TEMP_GID_START
		ELSE
			GCREATE TEMP_GID_START, 360, 360
			GDRAWSPRITE TEMP_GID_START, "純那_FACE_2", 0, 0, 180, 180
			GDRAWSPRITE TEMP_GID_START, "純那_FACE_3", 180, 0, 180, 180
			GDRAWSPRITE TEMP_GID_START, "純那_FACE_0", 0, 180, 180, 180
			SPRITECREATE "純那_デフォルト", TEMP_GID_START
		ENDIF
		RESULTS_F:2 = 純那_デフォルト
		RESULTS_F:1 = 純那_FACE_1
	CASEELSE
		RETURNF ""
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:쥰나]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "戦闘口上"
				RESULTS_F = 純那_FACE_2
			CASE "調教"
				RESULTS_F = 純那_FACE_3
			CASEELSE
				IF STRCOUNT(CSTR:L_CHARA:롤, "舞台少女") && GET_ROLE_CFLAG_DUNGEON(L_CHARA, "클라이맥스레뷰지속시간")
					IF CFLAG:L_CHARA:악마변신
						RESULTS_F = 純那_FACE_EX_2
					ELSE
						RESULTS_F = 純那_FACE_EX_1
					ENDIF
				ELSE
					IF CFLAG:L_CHARA:악마변신
						RESULTS_F = 純那_FACE_EX_0
					ELSE
						RESULTS_F = 純那_FACE_0
					ENDIF
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT
