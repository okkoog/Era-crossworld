;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:동기다크서머너]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("同期のダーク서머너_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("同期のダーク서머너_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("同期のダーク서머너_FACE_2")
			RETURNF ""
		RESULTS_F = デフォルト
		;アイコン設定時の表示に使うアイコン
		RESULTS_F:1 = 同期のダーク서머너_FACE_0
	CASEELSE
		RETURNF ""
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:동기다크서머너]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		IF L_SITUATION != ""
			RESULTS_F '= FACE_PATTERN_同期のダーク서머너_デフォルト(L_SITUATION:1)
			SIF RESULTS_F != ""
				RETURNF ""
		ENDIF
		RESULTS_F '= FACE_PATTERN_同期のダーク서머너_デフォルト("ノーマル")
		SELECTCASE L_SITUATION:1
			CASE "HAPPY"
				RESULTS_F '= FACE_PATTERN_同期のダーク서머너_デフォルト("笑顔")
			CASE "CHARM"
				RESULTS_F '= FACE_PATTERN_同期のダーク서머너_デフォルト("赤面")
		ENDSELECT
		IF TFLAG:전투이벤트 > 0 && L_CHARA == TARGET
			SELECTCASE GET_BATTLE_EVENT(TFLAG:전투이벤트)
				CASE "COOP発動", "戦闘勝利", "レベルアップ"
					RESULTS_F '= FACE_PATTERN_同期のダーク서머너_デフォルト("笑顔")
			ENDSELECT
		ENDIF
	CASEELSE
		RETURNF ""
ENDSELECT

;--------------------------------------------------
;名勝指定呼び出しをするための関数
;-------------------------------------------------
@FACE_PATTERN_同期のダーク서머너_デフォルト, ARGS
#FUNCTIONS
SELECTCASE ARGS
	CASE "ノーマル"
		RETURNF "同期のダーク서머너_FACE_0"
	CASE "笑顔"
		RETURNF "同期のダーク서머너_FACE_1"
	CASE "赤面"
		RETURNF "同期のダーク서머너_FACE_2"
ENDSELECT
