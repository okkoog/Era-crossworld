	CASE "魔型新式管使い"
		ABL:ARG:종족 = 0
		CALL CHANGE_ROLE, ARG, "달인_1/도구지식_3/공격의심득_3", , , "サブ素質引継ぎなし/デフォルト素質なし"
	CASEELSE
		CALL CHANGE_ROLE, ARG, "서머너_5", , , "サブ素質引継ぎなし/デフォルト素質なし"
ENDSELECT

