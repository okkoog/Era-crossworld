@SAVE_SKILL_[[キャラ:동기다크서머너]], ARG, ARGS
#DIM LCOUNT
#DIMS STOCK_SKILL
;手持ちをスキルを取得し、保存フラグに入れる
STOCK_SKILL = 
FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
	SIF LCOUNT > 1
		STOCK_SKILL += "/"
	STOCK_SKILL += CONVERT_SKILLNUM_TO_STR(ARG, ABL:ARG:@"스킬{LCOUNT}")
NEXT
CALL SET_RPG_CSTR_TAKEOVER, ARG, ARGS + "스킬", STOCK_SKILL
CALL CLEAR_ALL_SKILL, ARG
;---- EDIT 002 ADD START -------------------------
CALL CLEAR_ALL_LEARN_SKILL, ARG
CALL CLEAR_LEARNED_SKILL_ALL, ARG
;---- EDIT 002 ADD END ---------------------------

;変更に際してCSTRにスキルを記録しておいて入れ替え、その後習得スキルの処理を走らせる
@SET_SKILL_[[キャラ:동기다크서머너]], ARG, ARGS
#DIM LCOUNT
#DIMS L_SKILL
;保存フラグからスキルを呼び出す
L_SKILL = %GET_RPG_CSTR_TAKEOVER(ARG, CSTR:ARG:종족명 + "스킬")%
IF L_SKILL != ""
	FOR LCOUNT, 0, HAVEABLE_SKILLNUM
		SIF AUTO_SPLIT(L_SKILL, "/", LCOUNT) == "0"
			CONTINUE
		IF ISNUMERIC(AUTO_SPLIT(L_SKILL, "/", LCOUNT))
			CALL SET_SKILL, ARG, SKILL_NAME_F(TOINT(AUTO_SPLIT(L_SKILL, "/", LCOUNT)))
		ELSE
			CALL SET_SKILL, ARG, AUTO_SPLIT(L_SKILL, "/", LCOUNT)
		ENDIF
	NEXT
ENDIF

CALL SET_LEARN_SKILL_[[キャラ:동기다크서머너]], ARG

