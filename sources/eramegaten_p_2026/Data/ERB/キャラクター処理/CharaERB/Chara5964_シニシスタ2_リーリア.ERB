@EVENT_CHANGE_TRAIN_TALENT_[[キャラ:리리아_시니시스타2]], ARG, ARGS, ARGS:1 = "GET"
IF (GROUPMATCH(ARGS, "연모", "음란", "복종") && ARGS:1 == "GET" || (GROUPMATCH(ARGS, "신뢰", "동료") && ARGS:1 == "LOST")) && TALENT:ARG:캐릭터고유소질 > 0
	SELECTCASE ARGS
		CASE "연모", "친애"
			PRINTFORMW %CALLNAME:ARG%은(는) %CALLNAME:MASTER%의 아이를 배기를 바라기 시작한 것 같다.
		CASEELSE
			PRINTFORMW %CALLNAME:ARG%은(는) %CALLNAME:MASTER%의 아이를 배는 것을 받아들인 것 같다.
	ENDSELECT
	PRINTFORMW %CALLNAME:ARG%의 『불임의 가호』가 소실되었습니다.
	CFLAG:ARG:임신불능 = 0
	TALENT:ARG:캐릭터고유소질 = 0
ENDIF
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:리리아_시니시스타2]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("リーリア_シニシスタ2_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("リーリア_シニシスタ2_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("リーリア_シニシスタ2_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("リーリア_シニシスタ2_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("リーリア_シニシスタ2_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("リーリア_シニシスタ2_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("リーリア_シニシスタ2_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("リーリア_シニシスタ2_FACE_EX_3")
			RETURNF ""
		RESULTS_F = 1
		RESULTS_F:1 = リーリア_シニシスタ2_FACE_1
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:리리아_시니시스타2]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "1"
		SELECTCASE L_SITUATION
			CASE "調教"
				CALLF 陥落(L_CHARA)
				IF RESULTS == "연모" || RESULTS == "신뢰"
					RESULTS_F = リーリア_シニシスタ2_FACE_4
				ELSE
					RESULTS_F = リーリア_シニシスタ2_FACE_2
				ENDIF
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = リーリア_シニシスタ2_FACE_EX_0
					;CHARMになった時
					CASE "CHARM"
						RESULTS_F = リーリア_シニシスタ2_FACE_EX_1
					;SLEEPになった時
					CASE "SLEEP"
						RESULTS_F = リーリア_シニシスタ2_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = リーリア_シニシスタ2_FACE_EX_3
					;通常時
					CASEELSE
						CALLF 陥落(L_CHARA)
						IF RESULTS == "연모" || RESULTS == "신뢰"
							RESULTS_F = リーリア_シニシスタ2_FACE_3
						ELSE
							RESULTS_F = リーリア_シニシスタ2_FACE_1
						ENDIF
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT