;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:빨강세이버]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("赤セイバー_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("赤セイバー_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("赤セイバー_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("赤セイバー_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("赤セイバー_FACE_EX_1")
			RETURNF ""	
		RESULTS_F = 一臨
		RESULTS_F:1 = 赤セイバー_FACE_1
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("赤セイバー_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("赤セイバー_FACE_5")
			RETURNF ""
		SIF !SPRITECREATED("赤セイバー_FACE_6")
			RETURNF ""
		SIF !SPRITECREATED("赤セイバー_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("赤セイバー_FACE_EX_3")
			RETURNF ""	
		RESULTS_F = 三臨
		RESULTS_F:1 = 赤セイバー_FACE_4
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:빨강세이버]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "一臨"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = 赤セイバー_FACE_2
			CASEELSE
				SELECTCASE L_SITUATION:1
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = 赤セイバー_FACE_2
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = 赤セイバー_FACE_3
						RESULT_F:1 = 1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = 赤セイバー_FACE_EX_0
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = 赤セイバー_FACE_EX_1
					;通常時
					CASEELSE
						RESULTS_F = 赤セイバー_FACE_1
				ENDSELECT
		ENDSELECT
	CASE "三臨"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = 赤セイバー_FACE_5
			CASEELSE
				SELECTCASE L_SITUATION:1
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = 赤セイバー_FACE_5
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = 赤セイバー_FACE_6
						RESULT_F:1 = 1
					;睡眠にされた時
					CASE "SLEEP"
						RESULTS_F = 赤セイバー_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = 赤セイバー_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = 赤セイバー_FACE_4
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT