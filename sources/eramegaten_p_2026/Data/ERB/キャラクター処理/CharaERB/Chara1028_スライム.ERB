;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:슬라임]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:슬라임]], ARG, ARG:2
CALL LEARN_SKILL_TO_NOW_LEVEL, ARG

;ERB\RPG\이벤트\EVENT_102(など）_炎・氷\EVENT_102_5_ホノオノハテニ.ERB
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:슬라임]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		BASE:ARG:LV = 40
		MAXBASE:ARG:LV = 40
		
		;基準値78+10　ちょっと強めで
		BASE:ARG:힘 = 28
		BASE:ARG:지혜 = 1
		BASE:ARG:마력 = 10
		BASE:ARG:내구 = 30
		BASE:ARG:속도 = 18
		BASE:ARG:운 = 1
		;あえてオトコを外さない
		TALENT:ARG:젖기쉬움 = 1
		TALENT:ARG:Ｃ민감 = 1
		TALENT:ARG:Ｂ민감 = 1
		TALENT:ARG:절륜 = 1
		TALENT:ARG:거체 = 1
		TALENT:ARG:회복빠름 = 1
		
		;メガインテリメガネを産む！
		ABL:ARG:수태아이템 = 5022
		
		CSTR:ARG:타이틀 = 巨大スライム
		CSTR:ARG:37 = この個体は、真上水紀の身体を母体として召喚された特別な悪魔である。
		
		CSTR:ARG:39 = 豊富なマグネタイトによって生成されたこの個体は、他よりもやや身体が大きい。
		CSTR:ARG:40 = 母体の知能も、ある程度引き継いでいるようだが、それは決して良いことではないようだ。
		CSTR:ARG:41 = 今も“これ”は、発作的に真上水紀の記憶を思い出し、おぞましい声で蠢き続けている。
		
		NAME:ARG = ミズキ・スライム
		CALLNAME:ARG = ミズキ・スライム
		
		CSTR:ARG:11 = ワダジ
		CSTR:ARG:12 = アナダ
ENDSELECT

