;-------------------------------------------------
;キャラクター独自変数名称定義関数
;XXXXの部分にキャラのNOをいれます
;
;キャラクター独自変数は名称が定義されていないキャラクター(NO)の参照と代入で落ちる仕組みになっているので
;NOが確定している状況(個別イベント内・SKILL_CHANGE関数通過後、専用技内…など)で利用してください。
;-------------------------------------------------
@RPG_CFLAG_NAME_XXXX, ARGS, ARG
#FUNCTIONS
SELECTCASE ARGS
	;---------------------------------------------
	;RPG_CFLAG_EV
	;周回時にリセットされる数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = フラグ名をここにいれる
			CASE 1
				RESULTS = CASE 「X」の「X」の部分がフラグの番号になります
			CASE 2
				RESULTS = 以下はありそうな命名
			CASE 3
				RESULTS = キャライベント進行段階
			CASE 4
				RESULTS = 専用スキル強化済み
			CASE 5
				;スキル使用時にDAYを代入。DAYとこれが一致してるとスキルを使用不能にする
				;リセットされないのでこういう使い方も可能
				RESULTS = 専用スキルの使用日
			CASE 6
				RESULTS = CASE 7　CASE 8というようにふやしていってください
			CASE 7
				RESULTS = test1
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_EV
	;周回時にリセットされる文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_EV"
		SELECTCASE ARG
			CASE 0
				;いくつかの選択肢のなかのひとつの状態を示すようなフラグは文字列で扱うとわかりやすいと思います
				RESULTS = 現在の職業
			CASE 1
				RESULTS = 攻略ルート名
			CASE 2
				RESULTS = AUTO_SPLITを活用して配列型のように扱うのももちろんです
			CASE 3
				RESULTS = 詳しくはAUTO_SPLIT関数を見て…ですが、詳しい人に聞かないと難しいかもしれません
			CASE 4
				RESULTS = test2
		ENDSELECT
	;---------------------------------------------
	;RPG_CFLAG_TAKEOVER
	;周回時にリセットされない数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				;周回後も持ち越したいフラグというとまぁこんな感じでしょうか
				RESULTS = 友好ルート攻略済み
			CASE 1
				RESULTS = 敵対ルート攻略済み
			CASE 2
				RESULTS = 隠しスキル解放済み
			CASE 3
				RESULTS = test3
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_TAKEOVER
	;周回時にリセットされない文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
			CASE 1
				RESULTS = 
			CASE 2
				RESULTS = 
			CASE 3
				RESULTS = test4
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる数値型変数です
	;スキルゲージHとほぼ互換です。基本的にはゲージHが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
