;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:제네]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ジェネ_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("ジェネ_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("ジェネ_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("ジェネ_FACE_3")
			RETURNF ""	
		SIF !SPRITECREATED("ジェネ_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("ジェネ_FACE_5")
			RETURNF ""
		SIF !SPRITECREATED("ジェネ_FACE_6")
			RETURNF ""
		SIF !SPRITECREATED("ジェネ_FACE_7")
			RETURNF ""
		SIF !SPRITECREATED("ジェネ_FACE_8")
			RETURNF ""
		SIF !SPRITECREATED("ジェネ_FACE_9")
			RETURNF ""
		SIF !SPRITECREATED("ジェネ_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("ジェネ_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("ジェネ_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("ジェネ_FACE_EX_3")
			RETURNF ""
		SIF !SPRITECREATED("ジェネ_FACE_EX_4")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = ジェネ_FACE_6
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:제네]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ジェネ_FACE_9
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ジェネ_FACE_EX_0
					;魅了、混乱、ハッピーにされた時
					CASE "CHARM", "PANIC", "HAPPY"
						RESULTS_F = ジェネ_FACE_EX_1
					;石化にされた時
					CASE "STONE"
						RESULTS_F = ジェネ_FACE_EX_2
					;眠りにされた時
					CASE "SLEEP"
						RESULTS_F = ジェネ_FACE_EX_3
					;上記以外の状態異常の時
					CASE "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "SHOCK", 
						RESULTS_F = ジェネ_FACE_EX_4
					;通常時
					CASEELSE
						RESULTS_F = ジェネ_FACE_6
				ENDSELECT
		ENDSELECT
	CASEELSE
ENDSELECT