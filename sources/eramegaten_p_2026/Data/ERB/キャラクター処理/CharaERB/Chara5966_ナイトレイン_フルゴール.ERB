;TYPE(공격상성)は変動要素が激しいので特定相性の変換を行う場合は継承タイプから見ること

@SKILL_ADD_TYPE_IN_CALK_CHARA_[[キャラ:나이트레인_풀고르]], L_SKILLS, L_CHARA, IS_BADSTATE = 0, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_SKILLS
#DIM DYNAMIC IS_BADSTATE
#DIM REF L_TYPE
CALL GETS_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILLS, L_CHARA
SIF RESULT == GET_SUCCESSION_NUM("검격")
	RETURN GET_TYPE_NUM("파마")
SIF RESULT == GET_SUCCESSION_NUM("비구")
	RETURN GET_TYPE_NUM("파마")
RETURN -1

;ARG:1 = 表示ページ
@ROLE_EXPLAIN_[[キャラ:나이트레인_풀고르]], ARG, ARG:1
IF ARG:1 == 0
	PRINTFORML □상야의 힘
	PRINTFORML 　검격・비구 계통 스킬의 공격 상성에 【파마】가 추가된다.
ENDIF
