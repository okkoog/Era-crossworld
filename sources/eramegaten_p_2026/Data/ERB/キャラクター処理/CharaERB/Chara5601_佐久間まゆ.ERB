;--------------------------------------------------
;ERB\RPG\依頼\REQUEST_80_シンデレラガール\盲目的な少女.ERBで加入時に分岐
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:마유]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
IF ARG:2 == 1
	CALL SET_BASE_[[キャラ:마유]], ARG, ARG:2
	CALL SET_BTL_TALENT_[[キャラ:마유]], ARG, ARG:2
ENDIF

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:마유]], ARG, ARG:1
IF ARG:1 == 1
	TALENT:ARG:처녀 = 0
	EXP:ARG:Ｖ경험 += 80
	EXP:ARG:Ａ경험 += 70
	EXP:ARG:성교경험 += 100
	EXP:ARG:고통쾌락경험 += 80
	EXP:ARG:펠라경험 += 25
	EXP:ARG:정액경험 += 45
	EXP:ARG:질사경험 += 20
	EXP:ARG:절정경험 += 25
	ABL:ARG:Ｃ감각 += 1
	ABL:ARG:Ｂ감각 += 1
	ABL:ARG:Ｖ감각 += 1
	ABL:ARG:Ａ감각 += 1
	EXP:ARG:이상경험 += 3
	MARK:ARG:고통각인 = 3
	CALL ADDS_ABNORMAL_EXP("処女喪失（輪姦）", ARG)
	CALL ADDS_ABNORMAL_EXP("苦痛刻印LV3", ARG)
ENDIF

@SET_BTL_TALENT_[[キャラ:마유]], ARG, ARG:1
IF ARG:1 == 1
	CFLAG:ARG:초기링크악마 = [[キャラ:미야스도코로]]
	ABL:ARG:초기링크악마공격상성 = 0
	ABL:ARG:초기링크악마최저공격횟수 = 1
	ABL:ARG:초기링크악마최대공격횟수 = 1
	ABL:ARG:초기링크악마사거리 = 1
	ABL:ARG:초기링크악마공격범위 = 1
	CALL CHANGE_ROLE, ARG, "데빌시프터_1", , , "サブ素質引継ぎなし"
ENDIF

