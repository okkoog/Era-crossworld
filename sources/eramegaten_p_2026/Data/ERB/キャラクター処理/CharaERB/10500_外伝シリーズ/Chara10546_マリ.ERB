;特殊な周回引き継ぎ条件
;達人マリは陥落で判定をクリアするのが不可能なので代替条件を設定
@SELECT_YOME_[[キャラ:마리]], ARG
IF CFLAG:ARG:이벤트가입 == 5
	SIF GET_CHARA_LOYALTY(ARG) >= 10000
		RETURN 1
	RETURN 0
ELSE
	RETURN -1
ENDIF

