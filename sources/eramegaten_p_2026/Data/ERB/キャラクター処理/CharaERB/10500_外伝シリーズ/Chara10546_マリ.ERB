@SET_BTL_TALENT_[[キャラ:마리]], ARG, ARG:1
IF ARG:1 == 5
	;達人はスキルの処理で問題がでるので先に初期スキルを消しておく
	CALL CLEAR_ALL_SKILL, ARG
	CALL CHANGE_ROLE, ARG, "달인_1/공격의심득_3", , , "サブ素質引継ぎなし"
	;CALL CLEAR_ROLE_TALENT, ARG
	;;戦闘素質：達人を付ける、サマナーを消す
	;TALENT:ARG:달인 = 1
	;TALENT:ARG:공격의심득 = 3
	;TALENT:ARG:도술 = 1
ENDIF

@SET_LEARN_SKILL_[[キャラ:마리]], ARG, ARG:1
IF ARG:1 == 5
	;スキルを設定する
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	CALL SET_LEARN_SKILL, ARG, "양팔찍기", 1
