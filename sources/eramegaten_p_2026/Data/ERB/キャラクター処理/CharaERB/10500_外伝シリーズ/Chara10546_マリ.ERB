		GDRAWSPRITE TEMP_GID_START, "マリ_FACE_8", 180, 0, 180, 180
		GDRAWSPRITE TEMP_GID_START, "マリ_FACE_10", 0, 180, 180, 180
		GDRAWSPRITE TEMP_GID_START, "マリ_FACE_12", 180, 180, 180, 180
		SPRITECREATE "マリ新型", TEMP_GID_START
		RESULTS_F:2 = マリ新型
		RESULTS_F:1 = マリ_FACE_6
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("マリ_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("マリ_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("マリ_FACE_5")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = マリ_FACE_3
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:마리]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "新型"
		SELECTCASE L_SITUATION
			CASE "調教"
				CALLF 陥落(L_CHARA)
				IF RESULTS == "연모"
					RESULTS_F = マリ_FACE_9
				ELSEIF RESULTS == "음란"
					RESULTS_F = マリ_FACE_11
				ELSEIF RESULTS == "복종"
					RESULTS_F = マリ_FACE_13
				ELSEIF RESULTS == "신뢰"
					RESULTS_F = マリ_FACE_9
				ELSE
					RESULTS_F = マリ_FACE_7
				ENDIF
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = マリ_FACE_EX_0
					;魅了にされた時
					CASE "CHARM"
						RESULTS_F = マリ_FACE_EX_1
					;睡眠にされた時
					CASE "SLEEP" 
						RESULTS_F = マリ_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = マリ_FACE_EX_3
					;通常時
				CASEELSE
					CALLF 陥落(L_CHARA)
					IF RESULTS == "연모"
						RESULTS_F = マリ_FACE_8
					ELSEIF RESULTS == "음란"
						RESULTS_F = マリ_FACE_10
					ELSEIF RESULTS == "복종"
						RESULTS_F = マリ_FACE_12
					ELSEIF RESULTS == "신뢰"
						RESULTS_F = マリ_FACE_8
					ELSE
						RESULTS_F = マリ_FACE_6
					ENDIF
				ENDSELECT
				;HPが25%未満だとDYINGまでこれに固定する
				IF 現HP割合(L_CHARA) < 25
					RESULTS_F = マリ_FACE_EX_0
				ENDIF
		ENDSELECT
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = マリ_FACE_4
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = マリ_FACE_4
				ELSEIF L_SITUATION:1 == "DYING"
					RESULTS_F = マリ_FACE_5
					;DYINGでの色相変換を回避させるための指定
					RESULT_F:1 = 1
				ELSE
					RESULTS_F = マリ_FACE_3
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT