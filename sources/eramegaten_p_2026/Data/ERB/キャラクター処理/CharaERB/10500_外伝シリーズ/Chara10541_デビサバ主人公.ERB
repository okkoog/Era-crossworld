;--------------------------------------------------
;イベントフラグ
;0 = コボルト
;1 = ピクシー
;2 = カブソ
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:데빌서바주인공]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:데빌서바주인공]], ARG, ARG:2
CALL SET_SKILL_[[キャラ:데빌서바주인공]], ARG, ARG:2

@SET_BASE_[[キャラ:데빌서바주인공]], ARG, ARG:1
SELECTCASE RESULT
	CASE 0
		TALENT:ARG:검격 = 1
		TALENT:ARG:타격 = 1
		TALENT:ARG:전술 = 1
		TALENT:ARG:지원 = 1

		BASE:ARG:힘 = 6
		BASE:ARG:지혜 = 3
		BASE:ARG:마력 = 3
		BASE:ARG:내구 = 5
		BASE:ARG:속도 = 4
		BASE:ARG:운 = 4
	CASE 1
		TALENT:ARG:전격 = 1
		TALENT:ARG:회복 = 1

		BASE:ARG:힘 = 3
		BASE:ARG:지혜 = 5
		BASE:ARG:마력 = 4
		BASE:ARG:내구 = 3
		BASE:ARG:속도 = 6
		BASE:ARG:운 = 4
	CASE 2
		TALENT:ARG:화염 = 1
		TALENT:ARG:충격 = 1
		TALENT:ARG:만능 = 1
		BASE:ARG:힘 = 3
		BASE:ARG:지혜 = 5
		BASE:ARG:마력 = 5
		BASE:ARG:내구 = 3
		BASE:ARG:속도 = 5
		BASE:ARG:운 = 4
ENDSELECT
