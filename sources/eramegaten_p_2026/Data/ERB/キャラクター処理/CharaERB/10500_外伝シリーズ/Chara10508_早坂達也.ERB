;--------------------------------------------------
;イベントフラグ
;1 = TS加入
;2 = TS加入かつ襲われた場合
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:하야사카]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:하야사카]], ARG, ARG:2

;種族の変化はオミット
;スキル・継承素質および耐性の追加が定義されていない関係でまともな
@SET_BASE_[[キャラ:하야사카]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1, 2
		CALL ＴＳ処理, ARG, 5
		TALENT:ARG:동물귀 = 1
		TALENT:ARG:꼬리 = 1
		TALENT:ARG:갈퀴 = 1
		TALENT:ARG:팔 = 0
		TALENT:ARG:발 = 0
		TALENT:ARG:갈퀴발 = 1
		CALL ADDS_ABNORMAL_EXP , "ＴＳ" , ARG
		CALL SHOW_ABNORMAL_EXP , ARG, 0
		EXP:ARG:ＴＳ경험 += 1
		IF ARG:1 == 2
			TALENT:ARG:처녀 = 0
			EXP:ARG:Ｖ경험 = 20
			EXP:ARG:절정경험 = 25
			EXP:ARG:성교경험 = 110
			EXP:ARG:레즈경험 = 50
		ENDIF
ENDSELECT
