;--------------------------------------------------
;ERB\RPG\EVENT\新ドペ子ちゃんイベント……下のERBで加入時に分岐
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:『미라이』]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
	IF ARG:2 != -1
		CALL SET_BASE_[[キャラ:『미라이』]], ARG, ARG:2
		CALL SET_BTL_TALENT_[[キャラ:『미라이』]], ARG, ARG:2
		CALL SET_LEARN_SKILL_[[キャラ:『미라이』]], ARG, ARG:2
	ENDIF

;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:『미라이』]], ARG, ARG:1
#DIM ドペ子NO
#DIM ドペ子イベフラ
	ドペ子NO = ARG
	ドペ子イベフラ = ARG:1

	IF 0
	;「미지에대한탐구」で加入
	ELSEIF ドペ子イベフラ == 1
		;TALENT,BASE,EXPなどの変動はなし
		CALL SET_TALENT_PARTY_JOINABLE, ドペ子NO, "参加可能"
	;漫画版刹那ルートで加入
	ELSEIF ドペ子イベフラ == 2
		;===================================
		;●関連フラグ
		;===================================
		;特になし

		;===================================
		;●刻印・能力部分
		;===================================
		;屈服刻印２
		MARK:ドペ子NO:굴복각인 = 2
		;反発刻印１
		MARK:ドペ子NO:반발각인 = 1
		;反発取得履歴（MARK:4）も１にする
		MARK:ドペ子NO:4 = 1

		ABL:ドペ子NO:순종     = 3
		ABL:ドペ子NO:마조끼 = 1
		ABL:ドペ子NO:Ｃ감각   = 1
		ABL:ドペ子NO:Ｂ감각   = 1
		ABL:ドペ子NO:봉사정신 = 1

		;あなたが女だと、レズっ気も上昇
		IF !IS_MALE(MASTER)
			ABL:ドペ子NO:레즈끼 = 1
		ENDIF
	ENDIF

@SET_BTL_TALENT_[[キャラ:『미라이』]], ARG, ARG:1
#DIM ドペ子NO
#DIM ドペ子イベフラ
#DIM LCOUNT
	ドペ子NO = ARG
	ドペ子イベフラ = ARG:1

	IF 0
	;「미지에대한탐구」で加入
	ELSEIF ドペ子イベフラ == 1
		;아무것도안한다
	;漫画版刹那ルートで加入
	ELSEIF ドペ子イベフラ == 2
		;아무것도안한다
	ELSE
	ENDIF



@SET_LEARN_SKILL_[[キャラ:『미라이』]], ARG, ARG:1
#DIM ドペ子イベフラ
	ドペ子イベフラ = ARG:1

	IF 0
	;「미지에대한탐구」で加入
	ELSEIF ドペ子イベフラ == 1
		;아무것도안한다
	;漫画版刹那ルートで加入
	ELSEIF ドペ子イベフラ == 2
		;아무것도안한다
	ELSE
	ENDIF


