;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:로나우도]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ロナウド_FACE_3")
			RETURNF ""
		SIF !SPRITECREATED("ロナウド_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("ロナウド_FACE_EX_0")
			RETURNF ""
		SIF !SPRITECREATED("ロナウド_FACE_EX_1")
			RETURNF ""
		SIF !SPRITECREATED("ロナウド_FACE_EX_2")
			RETURNF ""
		SIF !SPRITECREATED("ロナウド_FACE_EX_3")
			RETURNF ""
		RESULTS_F = 新型
		RESULTS_F:1 = ロナウド_FACE_3
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("ロナウド_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("ロナウド_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("ロナウド_FACE_2")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = ロナウド_FACE_0
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:로나우도]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "新型"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ロナウド_FACE_4
			CASEELSE
				SELECTCASE L_SITUATION:1
					;戦闘不能になった時
					CASE "DYING"
						RESULTS_F = ロナウド_FACE_EX_0
					;CHARMになった時
					CASE "CHARM"
						RESULTS_F = ロナウド_FACE_EX_1
					;SLEEPになった時
					CASE "SLEEP"
						RESULTS_F = ロナウド_FACE_EX_2
					;上記以外の状態異常の時
					CASE "STONE", "FLY", "PALYZE", "BRAND", "CURSE", "FLAME", "BOMB", "POISON", "CLOSE", "BIND", "SLIP", "FREEZE", "PANIC", "SHOCK", "HAPPY"
						RESULTS_F = ロナウド_FACE_EX_3
					;通常時
					CASEELSE
						RESULTS_F = ロナウド_FACE_3
				ENDSELECT
				;HPが25%未満だとDYINGまでこれに固定する
				IF 現HP割合(L_CHARA) < 25
					RESULTS_F = ロナウド_FACE_EX_0
				ENDIF
		ENDSELECT
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ロナウド_FACE_1
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = ロナウド_FACE_1
				ELSEIF L_SITUATION:1 == "DYING"
					RESULTS_F = ロナウド_FACE_2
					;DYINGでの色相変換を回避させるための指定
					RESULT_F:1 = 1
				ELSE
					RESULTS_F = ロナウド_FACE_0
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT