;--------------------------------------------------
;キャラクター独自変数名称定義関数
;-------------------------------------------------
@RPG_CFLAG_NAME_[[キャラ:쇼우지]], ARGS, ARG
#FUNCTIONS
SELECTCASE ARGS
	;---------------------------------------------
	;RPG_CFLAG_TAKEOVER
	;周回時にリセットされない数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 救出時ボス撃破
		ENDSELECT
ENDSELECT
RETURNF RESULTS