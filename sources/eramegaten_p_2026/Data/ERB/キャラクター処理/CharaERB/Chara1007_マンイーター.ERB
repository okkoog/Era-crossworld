;--------------------------------------------------
;イベントフラグ
;1 = 六本木大歓楽街で加入する個体
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:맨이터]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:맨이터]], ARG, ARG:2
IF ARG:2 == 1
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:맨이터]], ARG, ARG:2

@SHOP_NEWGAME_INITCHARA_[[キャラ:맨이터]], ARG
CALL SET_LEARN_SKILL_[[キャラ:맨이터]], ARG, CFLAG:ARG:이벤트가입

;Data\ERB\RPG\ダンジョンアタック\ダンジョンデータ\DUNGEON31_六本木大歓楽街\DUNGEON31_六本木大歓楽街.ERB
;ARG:1はイベントフラグ
@SET_BASE_[[キャラ:맨이터]], ARG, ARG:1
#DIM DYNAMIC LCOUNT
SELECTCASE ARG:1
	CASE 1
		EXP:ARG:레즈경험 = EXPLV:5
		EXP:ARG:이상경험 += 1
		ABL:ARG:욕망 = 3
		TALENT:ARG:회복빠름 = 1
		TALENT:ARG:눈에띄고싶어함 = 1
		TALENT:ARG:바이 = 1
		CALLF SET_ALL_FACE_NEW, ARG, D31_FACE("マンイーター", 1)
		CSTR:ARG:해설6 = このマンイーターは六本木の歓楽街でナンパしたもの。
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:맨이터]], ARG, ARG:1
#DIM LCOUNT
IF ARG:1 == 1
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	CALL SET_LEARN_SKILL, ARG, "지옥찌르기", 1
	CALL SET_LEARN_SKILL, ARG, "일할의마맥", 1
	CALL SET_LEARN_SKILL, ARG, "독할퀴기", 10
	CALL SET_LEARN_SKILL, ARG, "돌려차기", 15
	CALL SET_LEARN_SKILL, ARG, "섹시댄스", 28
	CALL SET_LEARN_SKILL, ARG, "던지는키스", 30
	CALL SET_LEARN_SKILL, ARG, "이할의활천", 32
ENDIF
;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:맨이터]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN

SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("マンイーター_FACE_4")
			RETURNF ""
		SIF !SPRITECREATED("マンイーター_FACE_5")
			RETURNF ""
		SIF !SPRITECREATED("マンイーター_FACE_6")
			RETURNF ""
		RESULTS_F = デフォルト
		RESULTS_F:1 = マンイーター_FACE_4
	CASEELSE
		RESULTS_F = 
ENDSELECT
;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:맨이터]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "デフォルト"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = マンイーター_FACE_5
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = マンイーター_FACE_5
				ELSEIF L_SITUATION:1 == "DYING"
					RESULTS_F = マンイーター_FACE_6
					;DYINGでの色相変換を回避させるための指定
					RESULT_F:1 = 1
				ELSE
					RESULTS_F = マンイーター_FACE_4
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT