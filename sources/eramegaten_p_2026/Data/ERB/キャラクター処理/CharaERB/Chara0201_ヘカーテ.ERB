;--------------------------------------------------
;--------------------------------------------------
;ARG:0	キャラ登録番号
;以下は元のADD_NEW_COMPANIONの引数を引き継ぐ
;ARG:1 충성도
;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
@ADD_NEW_COMPANION_[[キャラ:헤카테]], ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
CALL SET_BASE_[[キャラ:헤카테]], ARG, ARG:2
IF ARG:2 == 1
	;ある程度戦力にしやすくするためにMAG強化を与える
	CALL SET_ENHANCE_BASE_FOR_NEW_CHARA, ARG, 50
	;スキル初期化
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_LEARNED_SKILL_ALL, ARG
ENDIF
CALL SET_LEARN_SKILL_[[キャラ:헤카테]], ARG, ARG:2

;ERB\RPG\ダンジョンアタック\ダンジョンデータ\DUNGEON_5_大魔宮\EVENT5_大魔宮.ERB
@SET_BASE_[[キャラ:헤카테]], ARG, ARG:1
SELECTCASE ARG:1
	CASE 1
		BASE:ARG:LV += 3
		BASE:ARG:마력 += 3
		BASE:ARG:지혜 += 2
ENDSELECT

@SET_LEARN_SKILL_[[キャラ:헤카테]], ARG, ARG:1
#DIM LCOUNT
;대마궁
IF ARG:1 == 1
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	FOR LCOUNT, 1, 21
		SIF CSVABL(NO:ARG, GETNUM(ABL, @"스킬{LCOUNT}")) == 0
			CONTINUE
		CALL SET_LEARN_SKILL, ARG, TOSTR(CSVABL(NO:ARG, GETNUM(ABL, @"스킬{LCOUNT}"))), 1
	NEXT
	CALL SET_LEARN_SKILL, ARG, "부흐다인", 1
	CALL SET_LEARN_SKILL, ARG, "마그다인", 1
	CALL SET_LEARN_SKILL, ARG, "만월의여왕", 1
	CALL SET_LEARN_SKILL, ARG, "마린카린", 1
	CALL SET_LEARN_SKILL, ARG, "시바브", 1
	FOR LCOUNT, 1, 21
		SIF CSVABL(NO:ARG, GETNUM(ABL, @"습득스킬{LCOUNT}")) == 0
			CONTINUE
		SIF HAVE_SKILL(ARG, CSVABL(NO:ARG, GETNUM(ABL, @"습득스킬{LCOUNT}")))
			CONTINUE
		CALL SET_LEARN_SKILL, ARG, TOSTR(CSVABL(NO:ARG, GETNUM(ABL, @"습득스킬{LCOUNT}"))), CSVABL(NO:ARG, GETNUM(ABL, @"습득LV{LCOUNT}")) + 3
	NEXT
ENDIF

