;--------------------------------------------------
;顔グラのパターン名を定義する関数
;--------------------------------------------------
@DEFINE_FACE_PATTERN_CHARA_[[キャラ:도마우스]], L_CHARA = -1, L_NO
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_NO
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_NO
	CASE 0
		;画像チェック
		SIF !SPRITECREATED("ドーマウス_FACE_0")
			RETURNF ""
		SIF !SPRITECREATED("ドーマウス_FACE_1")
			RETURNF ""
		SIF !SPRITECREATED("ドーマウス_FACE_EX_0")
			RETURNF ""
		RESULTS_F = 新
			RESULTS_F:1 = ドーマウス_FACE_0
	CASE 1
		;画像チェック
		SIF !SPRITECREATED("ドーマウス_FACE_2")
			RETURNF ""
		SIF !SPRITECREATED("ドーマウス_FACE_3")
			RETURNF ""
		RESULTS_F = 旧版
		RESULTS_F:1 = ドーマウス_FACE_2
	CASEELSE
		RESULTS_F = 
ENDSELECT

;--------------------------------------------------
;顔グラを指定する関数
;画像のアドレスはRESOURCEフォルダをみてください
;--------------------------------------------------
@FACE_PATTERN_CHARA_[[キャラ:도마우스]], L_CHARA, L_PATTERN, L_SITUATION, L_SITUATION:1
#FUNCTIONS
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_PATTERN
#DIMS DYNAMIC L_SITUATION, 2
SIF L_PATTERN == ""
	L_PATTERN = %CSTR:L_CHARA:아이콘패턴%
SELECTCASE L_PATTERN
	CASE "新"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ドーマウス_FACE_1
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = ドーマウス_FACE_1
				ELSEIF L_SITUATION:1 == "DYING"
					RESULTS_F = ドーマウス_FACE_EX_0
					;DYINGでの色相変換を回避させるための指定
					RESULT_F:1 = 1
				ELSE
					RESULTS_F = ドーマウス_FACE_0
				ENDIF
		ENDSELECT
	CASE "旧版"
		SELECTCASE L_SITUATION
			CASE "調教"
				RESULTS_F = ドーマウス_FACE_3
			CASEELSE
				IF IS_BADSTATE(L_CHARA, "CHARM")
					RESULTS_F = ドーマウス_FACE_3
				ELSE
					RESULTS_F = ドーマウス_FACE_2
				ENDIF
		ENDSELECT
	CASEELSE
ENDSELECT
