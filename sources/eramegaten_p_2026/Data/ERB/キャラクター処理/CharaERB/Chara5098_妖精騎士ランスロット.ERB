;スキル習得時に各スキル枠にも保存する関数
;FIX_CHARA_TRANS_SKILL関数を真似たやつ
@EVENT_LEVELUP_[[キャラ:ＦＫ・랜슬롯]], ARG, ARG:1
#DIM LCOUNT
#DIMS L_SKILLS,20

IF HAVE_PU_SKILL(ARG,"ランサー")
	IF GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ") == 0
		;騎士形態で新しいスキルを覚えた場合、そのスキルをスキル（騎士形態）に追加して保存する
		FOR LCOUNT,0,CHARA_SKILLCOUNT(ARG)
			L_SKILLS:LCOUNT = TOSTR(ABL:ARG:@"스킬{LCOUNT + 1}")
		NEXT
		CALL SET_RPG_CSTR_TAKEOVER(ARG,"スキル（騎士形態）",STRJOIN(L_SKILLS,"/",0,CHARA_SKILLCOUNT(ARG)))
	ELSEIF GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ") == 1
		;竜骸形態で新しいスキルを覚えた場合、そのスキルをスキル（竜骸形態）に追加して保存する
		FOR LCOUNT,0,CHARA_SKILLCOUNT(ARG)
			L_SKILLS:LCOUNT = TOSTR(ABL:ARG:@"스킬{LCOUNT + 1}")
		NEXT
		CALL SET_RPG_CSTR_TAKEOVER(ARG,"スキル（竜骸形態）",STRJOIN(L_SKILLS,"/",0,CHARA_SKILLCOUNT(ARG)))
	ENDIF
ENDIF

