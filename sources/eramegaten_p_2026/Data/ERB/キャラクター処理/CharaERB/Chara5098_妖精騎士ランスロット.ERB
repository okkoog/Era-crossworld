;-------------------------------------------------
;キャラクター独自変数名称定義関数
;5098の部分にキャラのNOをいれます
;
;キャラクター独自変数は名称が定義されていないキャラクター(NO)の参照と代入で落ちる仕組みになっているので
;NOが確定している状況(個別イベント内・SKILL_CHANGE関数通過後、専用技内…など)で利用してください。
;-------------------------------------------------
@RPG_CFLAG_NAME_[[キャラ:ＦＫ・랜슬롯]], ARGS, ARG
#FUNCTIONS
SELECTCASE ARGS
	;---------------------------------------------
	;RPG_CFLAG_EV
	;周回時にリセットされる数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_EV
	;周回時にリセットされる文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_EV"
		SELECTCASE ARG
			CASE 0
				;いくつかの選択肢のなかのひとつの状態を示すようなフラグは文字列で扱うとわかりやすいと思います
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CFLAG_TAKEOVER
	;周回時にリセットされない数値型変数です
	;---------------------------------------------
	CASE "RPG_CFLAG_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 形態換装フラグ
			CASE 1
				RESULTS = 宝具再臨（ランサー）
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_TAKEOVER
	;周回時にリセットされない文字列型変数です
	;---------------------------------------------
	CASE "RPG_CSTR_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = スキル（騎士形態）
			CASE 1
				RESULTS = スキル（竜骸形態）
			CASE 2
				RESULTS = スキル（水着形態）
			CASE 3
				RESULTS = 各形態時の名前
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる数値型変数です
	;スキルゲージHとほぼ互換です。基本的にはゲージHが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "RPG_CFLAG_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_BTL
	;戦闘開始毎にリセットされる文字列型変数です
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "RPG_CSTR_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる数値型変数
	;スキルゲージFとほぼ互換です。基本的にはゲージFが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "RPG_CFLAG_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;RPG_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる文字列型変数
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "RPG_CSTR_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
ENDSELECT
RETURNF RESULTS

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_CHARA_[[キャラ:ＦＫ・랜슬롯]], ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM L_NUM

VARSET L_NUM

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		CASE "ダメージ補正加算"
			IF HAVE_PU_SKILL(L_P,"ランサー")
				;合致した素質で攻撃した場合、ダメージが9％増加（陣地作成 Ｂ＋）
				L_NUM += 相性素質チェック_F(L_P,GET_SUCCESSION_NUM(L_相性名)) ? 9 # 0
			ELSEIF HAVE_PU_SKILL(L_P,"ルーラー")
				;合致した素質で攻撃した場合、ダメージが11％増加（騎乗 Ａ＋）
				L_NUM += 相性素質チェック_F(L_P,GET_SUCCESSION_NUM(L_相性名)) ? 11 # 0
				;クリティカル時、対象が人間としてカウントされる場合は与えるダメージが12％増加する（妖精騎士 Ｃ）
				;メモ：必要性が出てきたらちゃんとした人属性関数を用意する
				L_NUM += L_CRT && IS_HUMAN(L_TARGET) ? 12 # 0
			ENDIF
			RETURN L_NUM
		CASE "クリティカル補正A"
			IF HAVE_PU_SKILL(L_P,"ルーラー")
				;クリティカル補正が11％増加（騎乗 Ａ＋）
				L_NUM += 11
			ENDIF
			RETURN L_NUM
	ENDSELECT
ENDIF
RETURN 0

;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_CHARA_[[キャラ:ＦＫ・랜슬롯]], ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	CASE "상태이상"
		;DYING以外のバステに18％の耐性付与（対魔力 Ｂ）
		SIF ARGS != "DYING"
			RETURN -18
ENDSELECT

RETURN 0

;ARG = キャラ登録番号
;ARG:1 = 使用スキル番号
;ARG:2 = 効果付与の場合の付与者
@SKILL_COST_CHANGE_CHARA_[[キャラ:ＦＫ・랜슬롯]], ARG, ARG:1, ARG:2
SIF HAVE_PU_SKILL(ARG,"ランサー") && GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ") == 1
	RETURN -20

;NPゲージ獲得量の補正
;RESULT:0 = 獲得量への倍率補正
;RESULT:1 = 獲得固定値
@NP_CHARGE_CHARA_[[キャラ:ＦＫ・랜슬롯]],ARG,GIVE_SKILL_CHARA
#DIM L_NUM,2
#DIM GIVE_SKILL_CHARA
VARSET L_NUM,0
IF HAVE_PU_SKILL(ARG,"ランサー")
	;NP獲得量が9％増加する（陣地作成 Ｂ＋）
	L_NUM:0 += 9
ELSEIF HAVE_PU_SKILL(ARG,"ルーラー")
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION", CFLAG:ARG:입력행동, ARG
	;合致する素質ならNP獲得量が11％増加する（騎乗 Ａ＋）
	L_NUM:0 += 相性素質チェック_F(ARG, RESULT) ? 11 # 0
ENDIF
RETURN L_NUM:0,L_NUM:1

