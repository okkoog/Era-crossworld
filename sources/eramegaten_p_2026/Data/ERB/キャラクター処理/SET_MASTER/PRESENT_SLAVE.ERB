;最初に奴隷を受け取る処理
;男でも女でも追加できるように独立

;LOCAL 受け取った奴隷の番号 0で受け取りなし
;LOCAL:1 が 1:受け取った奴隷が男 2:受け取った奴隷が女


@PRESENT_SLAVE, ARG
#LOCALSIZE 2
LOCAL = 0
LOCAL:1 = 0
;マヨーネ様の詳細な説明が入るほう
IF ARG == 1
	$SELECT_FIRSTCOMPANION1
	PRINTL [0] 남자
	PRINTL [1] 여자
	PRINTL [2] 필요없다
	CALL INPUTINT,0,1,2
	SELECTCASE RESULT
		CASE 0
			PRINTL [0] 교활하고 빈틈없는 불량 소년
			PRINTL [1] 텐션 높은 남자 고교생
			PRINTL [2] 피네건을 원한다
			PRINTL [3] 역시 다른 성별
			CALL INPUTINT,0,1,2,3
			SELECTCASE RESULT
				CASE 0
					PRINTFORML 마요네：
					PRINTFORML 「이쪽은 지원 마법에 뛰어난 이능자랍니다.
					PRINTFORML 　악마가 우호의 증표로서 헌상해 온 녀석입니다만, 무슨 인과인지 마계에서 난동을 부린 끝에 붙잡힌 모양이에요.
					PRINTFORML 　자존심만 센 어린애를 길들이는 게 취향이신가요？」
					CALL INPUT_YN,"Yes","No"
					IF RESULT == 0
						CALL ADD_NEW_COMPANION,[[キャラ:챠린코Ｃ]],500
						FLAG:초기파트너 = [[キャラ:챠린코Ｃ]]
						LOCAL = GETCHARA([[キャラ:챠린코Ｃ]])
						LOCAL:1 = 1
						PRINTFORML 「악마조차 애를 먹는, 천방지축 개구쟁이 꼬맹이랍니다.
						PRINTFORML 　후후후, 부디 부서지지 않도록 노력해 보세요」
						PRINTFORML 
						PRINTFORMW ＞차린코Ｃ（차린코 찰리）를 손에 넣었다
					ELSE
						GOTO SELECT_FIRSTCOMPANION1
					ENDIF
				CASE 1
					PRINTFORML 마요네：
					PRINTFORML 「이쪽은 드물게도 페르소나 구사자랍니다.
					PRINTFORML 　이계에 떨어져 있던 것 같은데, 제법 쓸 만하고 흥미로운 녀석이에요.
					PRINTFORML 　도련님을 길들이는 게 취향이신가요？」
					CALL INPUT_YN,"Yes","No"
					IF RESULT == 0
						CALL ADD_NEW_COMPANION,[[キャラ:브라운]],500
						FLAG:초기파트너 = [[キャラ:브라운]]
						LOCAL = GETCHARA([[キャラ:브라운]])
						LOCAL:1 = 1
						PRINTFORMW 「페르소나 구사자, 당신이 다룰 수 있을까요?
						PRINTFORMW 　후후후, 부디 망가뜨리지 않도록 조심하시길」
						PRINTFORML 
						PRINTFORMW ＞브라운 을 손에 넣었다
					ELSE
						GOTO SELECT_FIRSTCOMPANION1
					ENDIF
				CASE 2
					PRINTFORML 마요네：
					PRINTFORML 「……당신, 수염 페티시나 뭐 그런 건가요?
					PRINTFORML 　확실히, 저것도 일단은, 남자이긴 합니다만……」
					PRINTFORML 
					PRINTFORMW 어지간히 취향이 나쁘다고 생각한 것일까. 마요네는 명백히 질려 하고 있다.
					PRINTFORML 
					PRINTFORML 마요네：
					PRINTFORML 「당신의 취향은 제쳐두고, 저건 당신 따위의 손에 감당될 상대가 아니랍니다.
					PRINTFORML 　대신 이 아이에게라도, 끔찍하게 고약한 취향을 마음껏 쏟아내 보시지요」
					PRINTFORML 
					PRINTFORML ＞조마의 소체, 도리・카드몬을 받겠습니까？
					CALL INPUT_YN,"Yes","No"
					IF RESULT == 0
						PRINTFORMW ＞조마의 소체, 도리・카드몬을 받았다
						ITEM:도리・카드몬 += 1
						イベントフラグ:1:0 = 1
						CFLAG:MASTER:스트레스치 = 1
					ELSE
						GOTO SELECT_FIRSTCOMPANION1
					ENDIF
				CASE 3
					GOTO SELECT_FIRSTCOMPANION1
			ENDSELECT
		CASE 1
			PRINTL [0] 솔직하고 밝은 １５세 넷아이돌
			PRINTL [1] 포용력있는 ２３세 양호교사(거유)
			PRINTL [2] 마요네를 원한다
			PRINTL [3] 역시 다른 성별
			CALL INPUTINT,0,1,2,3
			SELECTCASE RESULT
				CASE 0
					PRINTFORML 마요네：
					PRINTFORML 「이 아이는 어리석게도 각성한 이능으로 정의의 편 놀이를 하고 있었답니다.
					PRINTFORML 　우연히 발견해 주워왔습니다만, 너무나도 사랑스러운 나머지 망가뜨려 버릴까 생각하고 있었습니다만……
					PRINTFORML 　어리고 납작한 꼬맹이가 취향이신가요？」
					CALL INPUT_YN,"Yes","No"
					IF RESULT == 0
						CALL ADD_NEW_COMPANION,[[キャラ:도리]],500
						FLAG:초기파트너 = [[キャラ:도리]]
						LOCAL = GETCHARA([[キャラ:도리]])
						LOCAL:1 = 2
						PRINTFORML 「후후후, 부디 망가뜨리지 않도록 조심하시길」
						PRINTL
						PRINTFORMW ＞코마키 미도리 를 손에 넣었다
					ELSE
						GOTO SELECT_FIRSTCOMPANION1
					ENDIF
				CASE 1
					PRINTFORML 마요네：
					PRINTFORML 「포용력을 기대한다면 관두시는 게 좋을 거예요, 이 아이는 이미 무언가를 떠안고 있답니다.
					PRINTFORML 　약해 빠진 주제에 조직에 접근해 나를 이용하려 들었기에, 비참한 돼지로 만들어버릴까 생각했습니다만……
					PRINTFORML 　가슴에 군살을 잔뜩 채워 넣은 여자가 취향이신가요？」
					CALL INPUT_YN,"Yes","No"
					IF RESULT == 0
						CALL ADD_NEW_COMPANION,[[キャラ:마리]],500
						FLAG:초기파트너 = [[キャラ:마리]]
						LOCAL = GETCHARA([[キャラ:마리]])
						LOCAL:1 = 2
						PRINTFORMW 「후후후, 부디 망가뜨리지 않도록 조심하시길」
						PRINTL
						PRINTFORMW ＞모치즈키 마리 를 손에 넣었다
					ELSE
						GOTO SELECT_FIRSTCOMPANION1
					ENDIF
				CASE 2
					PRINTFORML 마요네：
					IF TALENT:MASTER:복종
						PRINTFORMW 「천박한 육변기 분제에 내가 갖고 싶다는 건가요？」
					ELSE
						PRINTFORMW 「어머, 내가 갖고 싶으신 건가요？」
					ENDIF
					CALL INPUT_YN,"Yes","No"
					IF RESULT == 0
						IF TALENT:MASTER:복종
							PRINTFORML 마요네：
							PRINTFORMW 「……후후, 후후후후, 하하하하하！」
							PRINTL
							PRINTFORMW 마요네는 한바탕 웃은 뒤, 난데없이 둔기로 %CALLNAME:MASTER%을(를) 후려쳤다.
							PRINTFORMW 이마에서 피를 흘리며 쓰러진 %CALLNAME:MASTER%의 등을 짓밟으며, 마요네는 태연하게 말을 이어간다.
							PRINTL
							PRINTFORML 마요네：
							PRINTFORMW 「미약 중독으로 형편 좋은 환각이라도 보고 있었던 모양이네.
							PRINTFORMW 　아니면, 다리를 벌리고 목숨을 구걸하면 언제든 봐줄 거라 생각한 걸까?
							PRINTFORMW 　어느 쪽이든, 잠꼬대는 자기 전에, 사랑의 밀어는 검열삭제를 한 뒤에나 지껄이렴.
							PRINTFORMW 　응석 부리는 목소리로 애무를 조를 틈이 있으면 총을 쥐어. 임무를 완수하는 거야」
							PRINTL
							PRINTFORMW 마요네는 피 묻은 둔기를 바닥에 내던졌다.
							PRINTFORMW 그 둔기는 재질을 알 수 없는 인형이었다. 섬뜩하게 일그러진 입가가 %CALLNAME:MASTER%의 피로 더럽혀져 있다.
							PRINTL
							PRINTFORML 마요네：
							PRINTFORMW 「……실례, 의미도 없이 때려버렸네요. 주살 마법에도 조예가 깊거늘.
							PRINTFORMW 　사과의 표시는 아니지만, 그곳에 떨어진 인형, 당신에게 드리죠.
							PRINTFORMW 　육변기가 장난감으로 쓰기엔 아깝습니다만, 싸울 의지가 아직 남아 있다면 좋은 무기가 될 거예요」
						ELSE
							PRINTFORML 마요네：
							PRINTFORML 「날 원해주는 건 기쁩니다만…… 후후후, 당신에겐 나를 길들일 수 없답니다.
							PRINTFORML 　만약 나와 피네건보다 강한 존재가 된다면 생각해 드리죠.
							PRINTFORMW 　그때까지, 이거에게라도 정욕을 부딪혀 보시지요」
						ENDIF
						PRINTL
						PRINTFORMW ＞조마의 소체, 도리・카드몬을 받았다
						ITEM:도리・카드몬 += 1
						イベントフラグ:1:0 = 1
						CFLAG:MASTER:스트레스치 = 1
					ELSE
						GOTO SELECT_FIRSTCOMPANION1
					ENDIF
				CASE 3
					GOTO SELECT_FIRSTCOMPANION1
			ENDSELECT
		CASE 2
			PRINTFORML 마요네：
			PRINTFORML 「어머, 그래요? 아쉽네요.
			PRINTFORML 　당신의 연습 상대로는 딱이라고 생각했는데.
			PRINTFORMW 　어쩔 수 없네요. 대신 이걸 주겠어요」
			PRINTFORML 
			CALL GET_ITEMS, "운의향", 1
			PRINTFORMW ＞운의 향을 손에 넣었다
			;PRINTFORMW 150魔貨を受け取った
			;MONEY:1 += 150
	ENDSELECT

	PRINTL 
	PRINTFORML 마요네：
	PRINTFORML 「그럼 난 이만.
	PRINTFORMW 　당신이 살아남을 수 있기를 기도해 드리죠, 후후후」
	PRINTL 
	PRINTFORMW 마요네는 떠났다.
	PRINTL 
	IF LOCAL > 0
		PRINTFORML 그럼, 그\@ LOCAL:1 == 1 ? 를 # 녀를 \@ 어떻게 할까……
		CALL INPUT_YN("노예로 취급한다","전력으로 취급한다")
		IF RESULT == 0
			PRINTFORML %CALLNAME:MASTER%은(는), 받은 노예를 노예 방에 처넣었다.
		ELSE
			PRINTFORML %CALLNAME:MASTER%은(는) 눈앞의 "노예"에게,
			PRINTFORML 자신이 사정이 있어 팬텀을 따르고 있으며
				PRINTW 얌전히 자신의 일을 도와준다면, 지금 당장은 아니더라도 돌려보내 주지 못할 것도 없다고 말했다.
			PRINTL 
			PRINTFORMW 그야말로 신빙성과 설득력이 결여된 이야기이긴 했으나, 그\@ LOCAL:1 == 1 ?  # 녀 \@도 \@ LOCAL:1 == 1 ? 처단당하는 # 노리개가 되는 \@ 것보다는…이라며 마지못해 납득한 모양이다.
			CALL SET_TALENT_PARTY_JOINABLE, LOCAL, "신용"
			IF !FLAG:주회횟수
				;戦力化を選んだ場合、装備をつけ、PTメンバーに入れる
				CALL GET_ITEMS, "어택나이프", 1
				CALL GET_ITEMS, "헤드기어", 1
				CALL GET_ITEMS, "서바이벌베스트", 1
				CALL GET_ITEMS, "레더글러브", 1
				CALL GET_ITEMS, "레더부츠", 1

				CALL 装備変更, LOCAL, GET_EQUIPNUM("검"), GETNUM(ITEM, "어택나이프")
				CALL 装備変更, LOCAL, GET_EQUIPNUM("머리"), GETNUM(ITEM, "헤드기어")
				CALL 装備変更, LOCAL, GET_EQUIPNUM("몸통"), GETNUM(ITEM, "서바이벌베스트")
				CALL 装備変更, LOCAL, GET_EQUIPNUM("팔"), GETNUM(ITEM, "레더글러브")
				CALL 装備変更, LOCAL, GET_EQUIPNUM("발"), GETNUM(ITEM, "레더부츠")
				CALL INSERT_POSITION, 1, LOCAL
			ENDIF
		ENDIF
	ENDIF

;入らないほう
ELSE
	$SELECT_FIRSTCOMPANION2
	PRINTL
	PRINTW 처음에 획득할 노예를 선택해 주십시오.
	PRINTL [0] 남자
	PRINTL [1] 여자
	PRINTL [2] 필요없다
	CALL INPUTINT,0,1,2
	SELECTCASE RESULT
		CASE 0
			PRINTL [0] 교활하고 빈틈없는 불량 소년
			PRINTL [1] 텐션 높은 남자 고교생
			PRINTL [2] 피네건을 원한다
			PRINTL [3] 역시 다른 성별
			CALL INPUTINT,0,1,2,3
			SELECTCASE RESULT
				CASE 0
					CALL ADD_NEW_COMPANION,[[キャラ:챠린코Ｃ]],500
					FLAG:초기파트너 = [[キャラ:챠린코Ｃ]]
					LOCAL = GETCHARA([[キャラ:챠린코Ｃ]])
					LOCAL:1 = 1
					PRINTFORMW ＞구로이 신지 를 손에 넣었다
				CASE 1
					CALL ADD_NEW_COMPANION,[[キャラ:브라운]],500
					FLAG:초기파트너 = [[キャラ:브라운]]
					LOCAL = GETCHARA([[キャラ:브라운]])
					LOCAL:1 = 1
					PRINTFORMW ＞우에스기 히데히코 를 손에 넣었다
				CASE 2
					PRINTFORMW ＞피네건 대신 조마의 소체, 도리・카드몬을 받았다
					ITEM:도리・카드몬 += 1
					イベントフラグ:1:0 = 1
				CASE 3
					GOTO SELECT_FIRSTCOMPANION2
			ENDSELECT
		CASE 1
			PRINTL [0] 솔직하고 밝은 １５세 넷아이돌
			PRINTL [1] 포용력있는 ２３세 양호교사(거유)
			PRINTL [2] 미스터리한 분위기의 상사
			PRINTL [3] 역시 다른 성별
			CALL INPUTINT,0,1,2,3
			SELECTCASE RESULT
				CASE 0
					CALL ADD_NEW_COMPANION,[[キャラ:도리]],500
					FLAG:초기파트너 = [[キャラ:도리]]
					LOCAL = GETCHARA([[キャラ:도리]])
					LOCAL:1 = 2
					PRINTFORMW ＞코마키 미도리 를 손에 넣었다
				CASE 1
					CALL ADD_NEW_COMPANION,[[キャラ:마리]],500
					FLAG:초기파트너 = [[キャラ:마리]]
					LOCAL = GETCHARA([[キャラ:마리]])
					LOCAL:1 = 2
					PRINTFORMW ＞모치즈키 마리 를 손에 넣었다
				CASE 2
					PRINTFORMW ＞상사 대신 조마의 소체・도리・카드몬을 받았다
					ITEM:도리・카드몬 += 1
					イベントフラグ:1:0 = 1
				CASE 3
					GOTO SELECT_FIRSTCOMPANION2
			ENDSELECT
		CASE 2
			CALL GET_ITEMS, "운의향", 1
			PRINTFORMW ＞마요네가 서비스로 준 운의 향을 받았다
			;PRINTFORMW 準備資金として追加で150魔貨を受け取った。
			;MONEY:1 += 150
	ENDSELECT

	IF LOCAL > 0
		PRINTFORML 받은 노예를 전력으로 삼겠습니까？
		CALL INPUT_YN("네","아니오")
		IF RESULT == 0
			PRINTFORML 그\@ LOCAL:1 == 1 ?  # 녀 \@는 \@ LOCAL:1 == 1 ? 처단당하는 # 노리개가 되는 \@ 것보다는…이라며 마지못해 승낙했다
			CALL SET_TALENT_PARTY_JOINABLE, LOCAL, "신용"
			IF !FLAG:주회횟수
				;戦力化を選んだ場合、装備をつけ、PTメンバーに入れる
				CALL GET_ITEMS, "어택나이프", 1
				CALL GET_ITEMS, "헤드기어", 1
				CALL GET_ITEMS, "서바이벌베스트", 1
				CALL GET_ITEMS, "레더글러브", 1
				CALL GET_ITEMS, "레더부츠", 1
				CALL 装備変更, LOCAL, GET_EQUIPNUM("검"), GETNUM(ITEM, "어택나이프")
				CALL 装備変更, LOCAL, GET_EQUIPNUM("머리"), GETNUM(ITEM, "헤드기어")
				CALL 装備変更, LOCAL, GET_EQUIPNUM("몸통"), GETNUM(ITEM, "서바이벌베스트")
				CALL 装備変更, LOCAL, GET_EQUIPNUM("팔"), GETNUM(ITEM, "레더글러브")
				CALL 装備変更, LOCAL, GET_EQUIPNUM("발"), GETNUM(ITEM, "레더부츠")
				CALL INSERT_POSITION, 1, LOCAL
			ENDIF
		ELSE
			PRINTFORML 받은 노예를 노예 방에 처넣었습니다
		ENDIF
	ENDIF
ENDIF

@PRESENT_PIXIE
#DIM L_CHARA
#DIM 退避
#DIM 引き継ぎ
#DIMS 종족
종족 = ピクシー
RESULT = 0
;一旦悪魔をキャラ登録
IF FINDCHARA_B([[キャラ:하이픽시]],2) >= 0 && CFLAG:MASTER:동정 == 2
	;経験豊富な初期ハイピクシーを引き継いで経験豊富なピクシーを指定していた場合、加入はしない
	종족 = ハイピクシー
ELSEIF FINDCHARA_B([[キャラ:하이픽시]],1) >= 0
	;処女加入した初期ハイピクシーを引き継いで処女ピクシーを指定していた場合も加入しない
	종족 = ハイピクシー
ELSEIF CFLAG:MASTER:동정 == 2
	CALL ADD_NEW_COMPANION,[[キャラ:픽시]],200,2
ELSE
	CALL ADD_NEW_COMPANION,[[キャラ:픽시]],200,1
ENDIF
L_CHARA = RESULT:1
引き継ぎ = (RESULT == 0)
;MASTERと相性を持たせる
CALL ADD_RELATION, L_CHARA, MASTER,150
;指定悪魔を全書登録してるかチェック。
IF STRFLAG_NUM_CPD_FIND("NO", NO:L_CHARA) > -1
	;（ハイ）ピクシーを悪魔全書に登録されているステータスにするか否か
	PRINTFORMW %CALLNAME:L_CHARA%을(를) 악마전서에 등록되어 있는 능력과 소질로 변경하겠습니까？
	CALL INPUT_YN,"Yes","No"
	IF RESULT == 0
		;一旦コピーを作ってそこに全書の効果を適用して様子見
		ADDCOPYCHARA L_CHARA
		退避 = L_CHARA
		L_CHARA = CHARANUM-1
		;全書登録されている悪魔で、全書登録データを閲覧する場合、登録情報を参照
		CALL STRFLAG_NUM_CPD(L_CHARA,"REFER")
		;初期化する能力を記述
		CFLAG:L_CHARA:초기LV = BASE:L_CHARA:LV
		BASE:L_CHARA:ＥＸＰ = BASE:L_CHARA:LV* (BASE:L_CHARA:LV+1) * (BASE:L_CHARA:LV-1) * 5 /3

		CFLAG:L_CHARA:능력강화횟수 = 0
		FOR LOCAL,0,6
			CFLAG:L_CHARA:(GET_BASESTATUS(LOCAL) + "강화횟수") = 0
		NEXT
		CALL SYNC_STATUS, L_CHARA
		CALL HEALTH_CHARA, L_CHARA
		
		;基本能力値合計が18 + Lv * 1.5 + 5 + 264 ( = Lv * 1.5 + 287)より大きい場合、不可
		LOCAL:4 += MAX(0, BASE:L_CHARA:힘 + BASE:L_CHARA:지혜 + BASE:L_CHARA:마력 + BASE:L_CHARA:내구 + BASE:L_CHARA:속도 + BASE:L_CHARA:운 - BASE:L_CHARA:LV * 3 / 2 - 287) * 100000 / POWER(2, FLAG:전투난이도-1)
		IF LOCAL:4 >= 100000
			PRINTW 레벨에 비해 능력치가 너무 높습니다. 악마전서의 내용을 적용하지 않습니다.
			DELCHARA L_CHARA
			L_CHARA = 退避
			GOTO 通常ピクシー加入処理
		;悪魔のレベル>主人のレベルだった場合も不可
		ELSEIF BASE:L_CHARA:LV > (BASE:MASTER:LV + FLAG:경험ED수)
			PRINTW 주인의 레벨을 넘는 악마로 만들 수는 없으므로, 악마전서의 내용을 적용하지 않습니다.
			DELCHARA L_CHARA
			L_CHARA = 退避
			GOTO 通常ピクシー加入処理
		ELSE
			;問題が無ければ、コピーしたピクシーを元々のピクシーの位置に入れ替えて、入れ替え後にキャラクター削除。
			SWAPCHARA 退避 , L_CHARA
			DELCHARA L_CHARA
			L_CHARA = 退避
		ENDIF
		;引継ぎキャラでない場合は二人称を専用設定して親し気に呼び掛けて来る
		IF 引き継ぎ == 0 && CALLNAME:MASTER != "당신"
			IF TALENT:MASTER:남자 == 0 || TALENT:MASTER:오토코노코
				CSTR:L_CHARA:이인칭 = %CALLNAME:MASTER%쨩
			ELSE
				CSTR:L_CHARA:이인칭 = %CALLNAME:MASTER%군
			ENDIF
		ENDIF
	ELSE
		GOTO 通常ピクシー加入処理
	ENDIF
ELSE
	$通常ピクシー加入処理
	IF CFLAG:MASTER:동정 == 2
		;経験豊富なピクシーの能力設定
		;周回で引き継いだキャラである場合は引き継いだ能力と比較して高い分だけ
		TALENT:L_CHARA:처녀 = 0
		ABL:L_CHARA:순종 = MAX(2,ABL:L_CHARA:순종)
		ABL:L_CHARA:욕망 = MAX(3,ABL:L_CHARA:욕망)
		ABL:L_CHARA:기교 = MAX(3,ABL:L_CHARA:기교)
		ABL:L_CHARA:Ｃ감각 = MAX(3,ABL:L_CHARA:Ｃ감각)
		ABL:L_CHARA:Ｖ감각 = MAX(3,ABL:L_CHARA:Ｖ감각)
		ABL:L_CHARA:Ｂ감각 = MAX(3,ABL:L_CHARA:Ｂ감각)
		ABL:L_CHARA:봉사정신 = MAX(2,ABL:L_CHARA:봉사정신)
		ABL:L_CHARA:노출증 = MAX(1,ABL:L_CHARA:노출증)
		ABL:L_CHARA:마조끼 = MAX(3,ABL:L_CHARA:마조끼)
		ABL:L_CHARA:새드끼 = MAX(1,ABL:L_CHARA:새드끼)
		ABL:L_CHARA:자위중독 = MAX(1,ABL:L_CHARA:자위중독)
		ABL:L_CHARA:섹스중독 = MAX(2,ABL:L_CHARA:섹스중독)
		EXP:L_CHARA:Ｖ경험 = MAX(92 , EXP:L_CHARA:Ｖ경험)
		EXP:L_CHARA:절정경험 = MAX(12 , EXP:L_CHARA:절정경험)
		EXP:L_CHARA:성교경험 = MAX(57 , EXP:L_CHARA:성교경험)
		EXP:L_CHARA:질사경험 = MAX(18 , EXP:L_CHARA:질사경험)
		EXP:L_CHARA:키스경험 = MAX(11 , EXP:L_CHARA:키스경험)
		EXP:L_CHARA:자위경험 = MAX(12 , EXP:L_CHARA:자위경험)
		EXP:L_CHARA:조교자위경험 = MAX(20 , EXP:L_CHARA:조교자위경험)
		EXP:L_CHARA:정액경험 = MAX(27 , EXP:L_CHARA:정액경험)
		EXP:L_CHARA:봉사쾌락경험 = MAX(100 , EXP:L_CHARA:봉사쾌락경험)
		EXP:L_CHARA:펠라경험 = MAX(19 , EXP:L_CHARA:펠라경험)
		EXP:L_CHARA:고통쾌락경험 = MAX(34 , EXP:L_CHARA:고통쾌락경험)
		EXP:L_CHARA:가학쾌락경험 = MAX(5 , EXP:L_CHARA:가학쾌락경험)
		EXP:L_CHARA:이상경험 = MAX(1 , EXP:L_CHARA:이상경험)
		EXP:L_CHARA:Ｖ확장경험 = MAX(2 , EXP:L_CHARA:Ｖ확장경험)
		EXP:L_CHARA:조교경험 = MAX(66 , EXP:L_CHARA:조교경험)
	ENDIF
	;引継ぎキャラでない場合は二人称を専用設定して親し気に呼び掛けて来る
	IF 引き継ぎ == 0 && CALLNAME:MASTER != "당신"
		IF TALENT:MASTER:남자 == 0 || TALENT:MASTER:오토코노코
			CSTR:L_CHARA:이인칭 = %CALLNAME:MASTER%쨩
		ELSE
			CSTR:L_CHARA:이인칭 = %CALLNAME:MASTER%군
		ENDIF
	ENDIF
	;初期状態での安定度が低すぎるのでレベルをあげつつステ優遇を入れる
	;---- EDIT 062 ADD START -------------------------
	BASE:L_CHARA:LV += 2
	ABL:L_CHARA:습득LV1 += 2
	ABL:L_CHARA:습득LV2 += 2
	ABL:L_CHARA:습득스킬2 = [[스킬:손이많이가네！]]
	ABL:L_CHARA:수태아이템 = GETNUM(ITEM, "스킬카드【손이많이가네！】")
	ABL:L_CHARA:변이레벨 += 2
	BASE:L_CHARA:마력 += 1
	BASE:L_CHARA:지혜 += 1
	BASE:L_CHARA:내구 += 3
	BASE:L_CHARA:속도 += 1
	IF ABL:L_CHARA:스킬3 == 0
		CALL SET_LEARN_SKILL, L_CHARA, "아기", 1
		;最初からポズムディを覚えさせる
		ABL:L_CHARA:습득스킬4 = 0
		ABL:L_CHARA:습득LV4 = 0
		CALL SET_LEARN_SKILL, L_CHARA, "포즈무디", 1
		;ABL:L_CHARA:스킬3 = [[스킬:아기]]
	ENDIF
	;---- EDIT 062 ADD END ---------------------------
ENDIF
