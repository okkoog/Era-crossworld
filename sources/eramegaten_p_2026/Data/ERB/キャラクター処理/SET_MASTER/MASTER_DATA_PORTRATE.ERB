;========================================================================
;初期写せ身(합일신)
;========================================================================
;--------------------------------------------------
;マスター用写せ身の名称定義関数
;--------------------------------------------------
@GET_MASTER_PORTRAIT_NAME, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		;回復・支援・水撃
		RETURNF "ヘケト"
	CASE 2
		;剣撃・飛具・回復
		RETURNF "テンセンニャンニャン"
	CASE 3
		;打撃・氷結
		RETURNF "キングフロスト"
	CASE 4
		;剣撃・火炎・破魔
		RETURNF "アークエンジェル"
	CASE 5
		;回復・電撃・水撃
		RETURNF "アプサラス"
	CASE 6
		;打撃・精神・地変
		RETURNF "ノッカー"
	CASE 7
		;火炎・万能
		RETURNF "ヴィーヴル"
	CASE 8
		;戦技・火炎
		RETURNF "オルトロス"
	CASE 9
		;回復・火炎・核熱
		RETURNF "アンズー"
	CASE 10
		;衝撃・神経
		RETURNF "オバリヨン"
	CASE 11
		;打撃・戦技・破魔・回復
		RETURNF "ヒトコトヌシ"
	CASE 12
		;剣撃・電撃・回復・支援・破魔
		RETURNF "ネコショウグン"
	CASE 13
		;支援・精神・呪殺・重力
		RETURNF "イシュタム"
	CASE 14
		;支援・火炎・疾風
		RETURNF "オロバス"
ENDSELECT

;--------------------------------------------------
;写せ身の名前から番号を返す
;--------------------------------------------------
@GET_MASTER_PORTRAIT_NUM, ARGS
#FUNCTION
#DIM LCOUNT
#DIMS L_NAMELIST, 30
IF L_NAMELIST == ""
	FOR LCOUNT, 0, 30
		L_NAMELIST:0 = %GET_MASTER_LINK_DEVIL_NAME(LCOUNT)%
	NEXT
ENDIF
SIF ARGS == ""
	RETURNF -1
RETURNF FINDELEMENT(L_NAMELIST, ARGS)

;--------------------------------------------------
;マスター用写せ身のNO定義関数
;--------------------------------------------------
@GET_MASTER_PORTRAIT_NO, ARGS
#FUNCTION
SELECTCASE ARGS
	CASE "ヘケト"
		RETURNF [[キャラ:헤케트]]
	CASE "テンセンニャンニャン"
		RETURNF [[キャラ:천선낭랑]]
	CASE "キングフロスト"
		RETURNF [[キャラ:킹프로스트]]
	CASE "アークエンジェル"
		RETURNF [[キャラ:아크엔젤]]
	CASE "アプサラス"
		RETURNF [[キャラ:아프사라스]]
	CASE "ノッカー"
		RETURNF [[キャラ:노커]]
	CASE "ヴィーヴル"
		RETURNF [[キャラ:뷔브르]]
	CASE "オルトロス"
		RETURNF [[キャラ:오르트로스]]
	CASE "アンズー"
		RETURNF [[キャラ:안주]]
	CASE "オバリヨン"
		RETURNF [[キャラ:오바리욘]]
	CASE "ヒトコトヌシ"
		RETURNF [[キャラ:히토코토누시]]
	CASE "ネコショウグン"
		RETURNF [[キャラ:네코쇼군]]
	CASE "イシュタム"
		RETURNF [[キャラ:익스타브]]
	CASE "オロバス"
		RETURNF [[キャラ:오로바스]]
ENDSELECT


