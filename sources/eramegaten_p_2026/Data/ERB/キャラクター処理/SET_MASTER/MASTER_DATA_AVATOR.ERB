;========================================================================
;링크악마(喰奴用)
;========================================================================
;------------------------------------
;マスター用の初期変身悪魔の名称定義関数
;ARG = 初期変身悪魔の番号
;------------------------------------
@GET_MASTER_AVATAR_NAME, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		RETURNF "バアル"
	CASE 2
		RETURNF "スラオシャ"
	CASE 3
		RETURNF "マーラ"
	CASE 4
		RETURNF "アモン"
	CASE 5
		RETURNF "ベヒモス"
	CASE 11
		RETURNF "イシュタル"
	CASE 12
		RETURNF "ヴァルキリー"
	CASE 13
		RETURNF "女神マーラ"
	CASE 14
		RETURNF "セイレーン"
	CASE 15
		RETURNF "レヴィアタン"
ENDSELECT

;------------------------------------
;リンク悪魔の名前から番号を返す
;------------------------------------
@GET_MASTER_AVATAR_NUM, ARGS
#FUNCTION
#DIM LCOUNT
#DIMS L_NAMELIST, 30
IF L_NAMELIST == ""
	FOR LCOUNT, 0, 30
		L_NAMELIST:0 = %GET_MASTER_AVATAR_NAME(LCOUNT)%
	NEXT
ENDIF
SIF ARGS == ""
	RETURNF -1
RETURNF FINDELEMENT(L_NAMELIST, ARGS)

;------------------------------------
;マスター用の初期変身悪魔の使用可否取得関数
;ARG   = 初期変身悪魔の番号
;ARG:1 = 判定するキャラの登録番号
;------------------------------------
@IS_ABLE_MASTER_AVATAR, ARG, ARG:1
#FUNCTION
SELECTCASE GET_MASTER_AVATAR_NAME(ARG)
	CASE "バアル"
		SIF !IS_MALE(ARG:1)
			RETURNF 0
		RETURNF 1
	CASE "スラオシャ"
		SIF !IS_MALE(ARG:1)
			RETURNF 0
		RETURNF 1
	CASE "マーラ"
		SIF !IS_MALE(ARG:1)
			RETURNF 0
		RETURNF 1
	CASE "アモン"
		SIF !IS_MALE(ARG:1)
			RETURNF 0
		RETURNF 1
	CASE "ベヒモス"
		SIF !IS_MALE(ARG:1)
			RETURNF 0
		RETURNF 1
	CASE  "イシュタル"
		SIF IS_MALE(ARG:1)
			RETURNF 0
		RETURNF 1
	CASE  "ヴァルキリー"
		SIF IS_MALE(ARG:1)
			RETURNF 0
		RETURNF 1
	CASE  "女神マーラ"
		SIF IS_MALE(ARG:1)
			RETURNF 0
		RETURNF 1
	CASE  "セイレーン"
		SIF IS_MALE(ARG:1)
			RETURNF 0
		RETURNF 1
	CASE  "レヴィアタン"
		SIF IS_MALE(ARG:1)
			RETURNF 0
		RETURNF 1
ENDSELECT
