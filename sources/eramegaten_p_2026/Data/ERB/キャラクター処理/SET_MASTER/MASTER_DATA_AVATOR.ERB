#DIM REF LINK_DEVIL_NO
#DIM REF LINK_DEVIL_SKILL
#DIM REF LINK_DEVIL_LEARN
#DIM REF LINK_DEVIL_LEARN_LV
#DIMS REF LINK_DEVIL_EXPLAIN
#DIM REF LINK_DEVIL_MANTRA

VARSET LINK_DEVIL_MANTRA
VARSET LINK_DEVIL_EXPLAIN

CALL SET_VAR_AVATAR_SKILL, ARG, LINK_DEVIL_SKILL, LINK_DEVIL_LEARN, LINK_DEVIL_LEARN_LV

SELECTCASE GET_MASTER_AVATAR_NAME(ARG)
	CASE "バアル"
		LINK_DEVIL_NO = [[キャラ:바알_링크전용]]
		LINK_DEVIL_EXPLAIN:0 = 『主』の意。ベール、ベルとも。ウガリット神話の嵐と慈雨の神。
		LINK_DEVIL_EXPLAIN:1 = 唯一神に貶められた後、ベルゼブブやバエルといった高位の悪魔へと派生した。
		
		LINK_DEVIL_MANTRA = 1, 16
	CASE "スラオシャ"
		LINK_DEVIL_NO = [[キャラ:스라오샤_링크전용]]
		LINK_DEVIL_EXPLAIN:0 = ゾロアスター教の善神ヤザタの一柱。『聴取』の意。神の耳としての役割を持つ。
		LINK_DEVIL_EXPLAIN:1 = 日没と共に地上へ降り立ち、神の敵対者らと戦いを繰り広げるという。
		
		LINK_DEVIL_MANTRA = 1, 5
	CASE "マーラ"
		LINK_DEVIL_NO = [[キャラ:마라_링크전용]]
		LINK_DEVIL_EXPLAIN:0 = 名の意味は『殺すもの』。またの名をマーラ・パーピーヤス、カーマ・マーラ。
		LINK_DEVIL_EXPLAIN:1 = 元来死の女神であったとも。
		
		LINK_DEVIL_MANTRA = 1, 2
	CASE "アモン"
		LINK_DEVIL_NO = [[キャラ:아몬_링크전용]]
		LINK_DEVIL_EXPLAIN:0 = 솔로몬 72악마 중 하나이자 서열 ７番、40の軍団を率いる地獄の大侯爵。
