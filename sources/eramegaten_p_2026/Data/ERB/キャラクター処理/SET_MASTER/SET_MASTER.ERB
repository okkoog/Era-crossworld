;========================================================================
;主人をキャラメイク
;========================================================================
@SET_MASTER
LOCAL = CHARANUM - 1
CFLAG:LOCAL:본체버전정보 = GAMEBASE_VERSION
CALL SET_MASTER_BASIC
$SET_MAJORING
CALL SET_MASTER_MAJORING
CALL SET_MASTER_NAME
CALL SET_MASTER_TALENTCHECK

;========================================================================
;主人の基本的な性別・体格等の設定
;========================================================================
@SET_MASTER_BASIC
SIF FLAG:주회횟수 > 0
	CALL SET_MASTER_TALENT_R
CALL SET_MASTER_SEX
CALL SET_MASTER_FRAME
CALL SET_MASTER_INVERT
CALL SET_MASTER_SEXLIFE
CALL SET_MASTER_BUST
CALL SET_MASTER_HIP
CALL SET_MASTER_WAIST



PRINTL 성적인 경험을 상세히 설정하겠습니까？
CALL INPUT_YN,"Yes","No"
IF RESULT == 0
	;ITEM:5051 = 1
	CALL SET_MASTER_ORALSEX
	CALL SET_MASTER_ANALSEX
	CALL SET_MASTER_MORETALENT
	CALL SET_MASTER_SLAVERY
ENDIF

ABL:MASTER:순종 = MIN(ABL:MASTER:순종, 10)
ABL:MASTER:욕망 = MIN(ABL:MASTER:욕망, 10)
ABL:MASTER:기교 = MIN(ABL:MASTER:기교, 10)
ABL:MASTER:Ｖ감각 = MIN(ABL:MASTER:Ｖ감각, 10)
ABL:MASTER:Ａ감각 = MIN(ABL:MASTER:Ａ감각, 10)
ABL:MASTER:봉사정신 = MIN(ABL:MASTER:봉사정신, 10)
ABL:MASTER:마조끼 = MIN(ABL:MASTER:마조끼, 10)
ABL:MASTER:정액중독 = MIN(ABL:MASTER:정액중독, 10)
ABL:MASTER:섹스중독 = MIN(ABL:MASTER:섹스중독, 10)
CALL MASTER_HUKUSO
CALL CLOTHES_INITIALIZE,MASTER


;========================================================================
;主人の素質リセット
;========================================================================
@SET_MASTER_TALENT_R
PRINTL 데모나이즈・당신합체 등으로 변화한 소질을 재설정하시겠습니까？
PRINTL [0]리셋하지 않는다
PRINTL [1]일반 인간의 육체로 돌아간다
PRINTL [2]당신은 실은 개입니다
PRINTL [3]당신은 여우입니다
PRINTL [4]고양이입니다
PRINTL [5]고양이는 있습니다
CALL INPUTINT,0,1,2,3,4,5

SELECTCASE RESULT
	;リセットしない
	CASE 0
		PRINTL
		RETURN
	;素質をリセットして真っ当?な人間に
	CASE 1
		;サマナーから達人までの戦闘素質と非人型素質をCSV参照してリセット
		FOR LOCAL,0,343
			TALENT:MASTER:(LOCAL) = CSVTALENT(NO:MASTER,LOCAL,0)
		NEXT
		CFLAG:MASTER:1201 = 0
	;素質をリセットして犬に
	CASE 2
		FOR LOCAL,0,343
			TALENT:MASTER:(LOCAL) = 0
		NEXT
		CFLAG:MASTER:1201 = 0
		TALENT:MASTER:동물귀 = 1
		TALENT:MASTER:짐승 = 1
		TALENT:MASTER:발정가능 = 1
		TALENT:MASTER:머리 = 1
		TALENT:MASTER:눈 = 1
		TALENT:MASTER:입 = 1
		TALENT:MASTER:갈퀴 = 1
		TALENT:MASTER:발 = 1
		TALENT:MASTER:꼬리 = 1
		TALENT:MASTER:모피 = 1
	;素質をリセットして狐に
	CASE 3
		FOR LOCAL,0,343
			TALENT:MASTER:(LOCAL) = 0
		NEXT
		CFLAG:MASTER:1201 = 0
		TALENT:MASTER:짐승 = 1
		TALENT:MASTER:여우 = 1
		TALENT:MASTER:발정가능 = 1
		TALENT:MASTER:머리 = 1
		TALENT:MASTER:눈 = 1
		TALENT:MASTER:입 = 1
		TALENT:MASTER:갈퀴 = 1
		TALENT:MASTER:발 = 1
		TALENT:MASTER:꼬리 = 1
		TALENT:MASTER:모피 = 1
	;素質をリセットして猫に
	CASE 4
		FOR LOCAL,0,343
			TALENT:MASTER:(LOCAL) = 0
		NEXT
		CFLAG:MASTER:1201 = 0
		TALENT:MASTER:짐승 = 1
		TALENT:MASTER:고양이혀 = 1
		TALENT:MASTER:발정가능 = 1
		TALENT:MASTER:머리 = 1
		TALENT:MASTER:눈 = 1
		TALENT:MASTER:입 = 1
		TALENT:MASTER:갈퀴 = 1
		TALENT:MASTER:발 = 1
		TALENT:MASTER:꼬리 = 1
		TALENT:MASTER:모피 = 1
	;素質をリセットして不定形に
	CASE 5
		FOR LOCAL,0,343
			TALENT:MASTER:(LOCAL) = 0
		NEXT
		CFLAG:MASTER:1201 = 0
		TALENT:MASTER:부정형 = 1
		TALENT:MASTER:고양이혀 = 1
		TALENT:MASTER:발정가능 = 1
		TALENT:MASTER:머리 = 1
		TALENT:MASTER:눈 = 1
		TALENT:MASTER:입 = 1
		TALENT:MASTER:갈퀴 = 1
		TALENT:MASTER:발 = 1
		TALENT:MASTER:꼬리 = 1
		TALENT:MASTER:모피 = 1
		TALENT:MASTER:촉수 = 1
ENDSELECT


;========================================================================
;主人の性別設定
;========================================================================
@SET_MASTER_SEX
;虹色のキャンディ用処理
IF TALENT:MASTER:남자
	CFLAG:MASTER:원오토코노코 = TALENT:MASTER:오토코노코
	;男の娘あなたは胸サイズ自由に設定できるので保存。男の娘から♂に変えて虹飴のケースは考えてない。
	SIF TALENT:MASTER:오토코노코
		CFLAG:MASTER:원가슴사이즈 = BUST(MASTER)	
ELSE
	CFLAG:MASTER:원처녀 = TALENT:MASTER:처녀
	CFLAG:MASTER:원후타나리 = TALENT:MASTER:후타나리
	;CFLAG:MASTER:원Ｖ민감 = TALENT:MASTER:Ｖ민감
	;CFLAG:MASTER:원Ｖ둔감 = TALENT:MASTER:Ｖ둔감
	CFLAG:MASTER:원Ｖ감각 = ABL:MASTER:Ｖ감각
	CFLAG:MASTER:원가슴사이즈 = BUST(MASTER)
ENDIF

;周回プレイ用処理
CALL SET_初期衣装, "모자" , -1
CALL SET_初期衣装, "옷" , -1
CALL SET_初期衣装, "하의" , -1
CALL SET_初期衣装, "전신복" , -1
CALL SET_初期衣装, "손" , -1
CALL SET_初期衣装, "속옷（상）" , -1
CALL SET_初期衣装, "속옷（하）" , -1
CALL SET_初期衣装, "전신속옷" , -1
CALL SET_初期衣装, "양말" , -1
CALL SET_初期衣装, "신발" , -1
CALL SET_初期衣装, "겉옷" , -1
CALL SET_初期衣装, "그외" , -1

PRINTL 당신의 성별은？
PRINTLC [0]♂
PRINTLC [1]♀
PRINTLC [2]오토코노코
PRINTLC [3]후타나리
PRINTL 
;ババアジジイ系を、外見年齢問わずの長生き処理に移設。従来通り、幼生固定なり新フラグを設けるなりで判別できるはず
CALL INPUTINT,0,1,2,3
SELECTCASE RESULT
	CASE 0
		TALENT:MASTER:처녀 = 0
		TALENT:MASTER:남자 = 1
		TALENT:MASTER:후타나리 = 0
		TALENT:MASTER:오토코노코 = 0
		TALENT:MASTER:절벽 = 1
		MAXBASE:MASTER:사정 = 10000
		MAXBASE:MASTER:절정 = 10000
		ABL:MASTER:Ｖ감각 = 0
		CALL 初期衣装セット, MASTER,"겉옷", "바지", "트렁크스", "양말", "부츠"
		PRINTW 성별：♂로 시작합니다
	CASE 1
		TALENT:MASTER:처녀 = 0
		TALENT:MASTER:남자 = 0
		TALENT:MASTER:후타나리 = 0
		TALENT:MASTER:오토코노코 = 0
		MAXBASE:MASTER:사정 = 10000
		MAXBASE:MASTER:절정 = 10000
		CALL 初期衣装セット, MASTER,"블라우스","스커트","브래지어","팬티","양말","부츠"
		PRINTW 성별：♀로 시작합니다
	CASE 2
		TALENT:MASTER:남자 = 1
		TALENT:MASTER:오토코노코 = 1
		TALENT:MASTER:후타나리 = 0
		MAXBASE:MASTER:사정 = 10000
		MAXBASE:MASTER:절정 = 10000
		ABL:MASTER:Ｖ감각 = 0
		CALL 初期衣装セット, MASTER,"겉옷", "바지", "트렁크스", "양말", "부츠"
		PRINTW [오토코노코]로 시작합니다
	CASE 3
		TALENT:MASTER:남자 = 0
		TALENT:MASTER:후타나리 = 1
		TALENT:MASTER:오토코노코 = 0
		MAXBASE:MASTER:사정 = 10000
		MAXBASE:MASTER:절정 = 10000
		CALL 初期衣装セット, MASTER,"블라우스", "스커트", "브래지어", "팬티", "양말", "부츠"
		PRINTW [후타나리]로 시작합니다
ENDSELECT

;虹色のキャンディ用処理
IF TALENT:MASTER:남자
	;CFLAG:MASTER:원성별 = 1
	CFLAG:MASTER:원오토코노코 = 0
ELSE
	;CFLAG:MASTER:원성별 = 0
	CFLAG:MASTER:원처녀 = 0
	CFLAG:MASTER:원후타나리 = 0
	;CFLAG:MASTER:원Ｖ민감 = 0
	;CFLAG:MASTER:원Ｖ둔감 = 0
	CFLAG:MASTER:원Ｖ감각 = 0
	SIF !CFLAG:MASTER:원오토코노코
		CFLAG:MASTER:원가슴사이즈 = 1
ENDIF

CALL CLOTHES_INITIALIZE,MASTER
IF FLAG:주회횟수 == 0
