@SET_MASTER_SLAVERY
PRINTL 팬텀・소사이어티에서의 위치는？
PRINTL [0]경력이 깨끗한 신참 서머너
PRINTL [1]성욕 처리 담당이던 시절이 있다
PRINTL [2]정액 변소로부터 스타트
CALL INPUTINT,0,1,2
FLAG:주인출신 = RESULT
IF RESULT == 0
	PRINTL
	RETURN
ENDIF
LOCAL = EXP:MASTER:성교경험 - EXP:MASTER:Ｖ경험
EXP:MASTER:펠라경험 += MIN(100,EXP:MASTER:펠라경험*RESULT*5)
EXP:MASTER:Ａ경험 += MIN(100,EXP:MASTER:Ａ경험*RESULT*5)
EXP:MASTER:이상경험 = RESULT*2
MARK:MASTER:쾌락각인 = 2
MARK:MASTER:굴복각인 = RESULT+1
ABL:MASTER:기교 += 1
ABL:MASTER:욕망 += 1
ABL:MASTER:마조끼 += MAX(0, RESULT - 1)
IF TALENT:MASTER:남자 == 0
	EXP:MASTER:Ｖ경험 += MIN(100,EXP:MASTER:Ｖ경험*RESULT*5)
	EXP:MASTER:질사경험 += EXP:MASTER:Ｖ경험 * 2
ENDIF
EXP:MASTER:성교경험 += EXP:MASTER:Ｖ경험 + EXP:MASTER:Ａ경험 + LOCAL
EXP:MASTER:정액경험 += EXP:MASTER:질사경험 + (EXP:MASTER:Ａ경험+EXP:MASTER:펠라경험)*2
TALENT:MASTER:복종 = (RESULT == 2)
IF TALENT:MASTER:복종
	TALENT:MASTER:음란 = 0
	TALENT:MASTER:창부 = 0
ENDIF
PRINTL
RETURN

