;========================================================================
;悪魔クラス(반마인/데모노이드)
;========================================================================
;--------------------------------------------------
;悪魔クラスの定義関数
;--------------------------------------------------
@GET_DEVIL_CLASS_NAME, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		RETURNF "지모신"
	CASE 2
		RETURNF "여신"
	CASE 3
		RETURNF "마왕"
	CASE 4
		RETURNF "천사"
	CASE 5
		RETURNF "요마"
	CASE 6
		RETURNF "요정"
	CASE 7
		RETURNF "요귀"
	CASE 8
		RETURNF "용왕"
	CASE 9
		RETURNF "마수"
	CASE 10
		RETURNF "요조"
	CASE 11
		RETURNF "외도"
	CASE 12
		RETURNF "귀신"
	CASE 13
		RETURNF "마신"
	CASE 14
		RETURNF "사신"
	CASE 15
		RETURNF "타천사"
	CASE 16
		RETURNF "聖獣"
	CASE 17
		RETURNF "凶鳥"
	CASE 18
		RETURNF "屍鬼"
	CASE 19
		RETURNF "夜魔"
	CASE 20
		RETURNF "머신"
ENDSELECT
;--------------------------------------------------
;悪魔クラスの名前から番号を返す
;--------------------------------------------------
@GET_DEVIL_CLASS_NUM, ARGS
#FUNCTION
#DIM LCOUNT
#DIMS L_NAMELIST, 30
IF L_NAMELIST == ""
	FOR LCOUNT, 0, 30
		L_NAMELIST:0 = %GET_DEVIL_CLASS_NAME(LCOUNT)%
	NEXT
ENDIF
SIF ARGS == ""
	RETURNF -1
RETURNF FINDELEMENT(L_NAMELIST, ARGS)

;--------------------------------------
;クラスの選択条件
;0のときは選べない
;また、選択画面では戻り値の小さい順に並ぶ(いちおう大種族毎に並べる形にしてます)
;--------------------------------------
@IS_ABLE_DEVIL_CLASS, ARG
#FUNCTION
SELECTCASE GET_DEVIL_CLASS_NAME(ARG)
	CASE "지모신"
		RETURNF 11
	CASE "여신"
		RETURNF 1
	CASE "마왕"
		RETURNF 24
	CASE "천사"
		RETURNF 31
	CASE "요마"
		RETURNF 21
	CASE "요정"
		RETURNF 22
	CASE "요귀"
		RETURNF 71
	CASE "용왕"
		RETURNF 41
	CASE "마수"
		RETURNF 61
	CASE "요조"
		RETURNF 51
	CASE "외도"
		RETURNF 91
	CASE "귀신"
		RETURNF 12
	CASE "마신"
		RETURNF 2
	CASE "사신"
		RETURNF 13
	CASE "타천사"
		RETURNF 32
	CASE "聖獣"
		RETURNF 62
	CASE "凶鳥"
		RETURNF 52
	CASE "屍鬼"
		RETURNF 81
	CASE "夜魔"
		RETURNF 23
	CASE "머신"
		RETURNF 101
ENDSELECT
RETURNF 0
