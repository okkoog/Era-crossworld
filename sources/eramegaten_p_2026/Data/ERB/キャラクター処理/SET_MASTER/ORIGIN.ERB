@GET_GIFT, ARG, ARG:3
CALL CHECK_ITEMMAX, ARG
IF RESULT == 0
	PRINTFORMW %조사처리(ITEMNAME:ARG,"를")% {ARG:3}개 손에 넣었다.
	CALL GET_ITEM, ARG, ARG:3
	RETURN 1
ELSE
	PRINTFORMW %조사처리(ITEMNAME:ARG,"를")% {ARG:3}개 얻었지만、다 가지고 갈 수 없었다
	RETURN 0
ENDIF

