@SET_初期衣装, ARGS, ARG, ARG:1 = 0
#DIM DYNAMIC LCOUNT
IF ARGS == "그외" && CFLAG:(ARG:1):초기그외 > 0
	FOR LCOUNT, 2, 4
		SIF CFLAG:(ARG:1):@"초기그외{LCOUNT}" > 0
			CONTINUE
		CFLAG:(ARG:1):@"초기그외{LCOUNT}" = ARG
		BREAK
	NEXT
ELSE
	CFLAG:(ARG:1):ARGS = ARG
	CFLAG:(ARG:1):@"초기%ARGS%" = ARG
ENDIF

