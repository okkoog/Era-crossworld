;========================================================================
;人間クラス(이능자)
;========================================================================
;--------------------------------------------------
;クラスの定義関数
;--------------------------------------------------
@GET_TECHNIC_NAME, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		RETURNF "羅漢"
	CASE 2
		RETURNF "剣聖"
	CASE 3
		RETURNF "ドラグーン"
	CASE 4
		RETURNF "アデプト"
	CASE 5
		RETURNF "サイマスター"
	CASE 6
		RETURNF "使徒"
	CASE 7
		RETURNF "陰陽師"
	CASE 8
		RETURNF "黄金の髪"
	CASE 9
		RETURNF "エンプレス"
	CASE 10
		RETURNF "ディーヴァ"
ENDSELECT

;--------------------------------------------------
;クラスの名前から番号を返す
;--------------------------------------------------
@GET_TECHNIC_NUM, ARGS
#FUNCTION
#DIM LCOUNT
#DIMS L_NAMELIST, 30
IF L_NAMELIST == ""
	FOR LCOUNT, 0, 30
		L_NAMELIST:0 = %GET_TECHNIC_NAME(LCOUNT)%
	NEXT
ENDIF
SIF ARGS == ""
	RETURNF -1
RETURNF FINDELEMENT(L_NAMELIST, ARGS)

;--------------------------------------
;クラスの選択条件
;0のときは選べない
;また、選択画面では戻り値の小さい順に並ぶ(いちおう大種族毎に並べる形にしてます)
;--------------------------------------
@IS_ABLE_TECHNIC, ARG
#FUNCTION
SIF IS_DEBUG && GET_TECHNIC_NAME(ARG) != ""
	RETURNF 1
SELECTCASE GET_TECHNIC_NAME(ARG)
	CASE "羅漢"
		RETURNF FLAG:경험ED수 > 0
	CASE "剣聖"
		RETURNF FLAG:경험ED수 > 1
	CASE "ドラグーン"
		RETURNF FLAG:경험ED수 > 2
	CASE "アデプト"
		RETURNF FLAG:경험ED수 > 3
	CASE "サイマスター"
		RETURNF FLAG:경험ED수 > 4
	CASE "使徒"
		RETURNF FLAG:경험ED수 > 5
	CASE "陰陽師"
		RETURNF FLAG:경험ED수 > 6
	CASE "黄金の髪"
		RETURNF FLAG:경험ED수 > 7
	CASE "エンプレス"
		RETURNF FLAG:경험ED수 > 8
	CASE "ディーヴァ"
		RETURNF FLAG:경험ED수 > 9
ENDSELECT

