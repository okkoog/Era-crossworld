;========================================================================
;人間クラス(이능자)
;========================================================================
;--------------------------------------------------
;クラスの定義関数
;--------------------------------------------------
@GET_CLASS_NAME, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		RETURNF "格闘家"
	CASE 2
		RETURNF "剣士"
	CASE 3
		RETURNF "番長"
	CASE 4
		RETURNF "魔術師"
	CASE 5
		RETURNF "超能力者"
	CASE 6
		RETURNF "巫女"
	CASE 7
		RETURNF "呪術師"
	CASE 8
		RETURNF "ウィッカ"
	CASE 9
		RETURNF "クイーン"
	CASE 10
		RETURNF "アイドル"
	CASE 11
		RETURNF "忍者"
	CASE 12
		RETURNF "武者"
	CASE 13
		RETURNF "拳士"
	CASE 14
		RETURNF "触手使い"
	CASE 15
		RETURNF "ディレッタント"
	CASE 16
		RETURNF "ガンファイター"
	CASE 17
		RETURNF "アームチェア・ディテクティブ"
	CASE 18
		RETURNF "探偵"
	CASE 19
		RETURNF "降霊士"
	CASE 20
		RETURNF "狼憑き"
ENDSELECT

;--------------------------------------------------
;クラスの名前から番号を返す
;--------------------------------------------------
@GET_CLASS_NUM, ARGS
#FUNCTION
#DIM LCOUNT
#DIMS L_NAMELIST, 30
IF L_NAMELIST == ""
	FOR LCOUNT, 0, 30
		L_NAMELIST:0 = %GET_CLASS_NAME(LCOUNT)%
	NEXT
ENDIF
SIF ARGS == ""
	RETURNF -1
RETURNF FINDELEMENT(L_NAMELIST, ARGS)

