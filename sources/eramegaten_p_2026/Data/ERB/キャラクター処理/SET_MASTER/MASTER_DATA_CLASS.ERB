;--------------------------------------------------
;人間クラスのスキル取得関数
;--------------------------------------------------
@SET_VAR_CLASS_SKILL, ARG, L_SKILL, L_LEARN, L_LEARN_LV, ARGS, L_CHARA
#DIM LCOUNT
#DIM L_CHARA
#DIM IS_LEARN
#DIM IS_UNABLE_SET_SKILL
#DIM L_SKILLNUM
#DIM REF L_SKILL
#DIM REF L_LEARN
#DIM REF L_LEARN_LV
SELECTCASE GET_CLASS_NAME(ARG)
	CASE "格闘家"
		L_SKILL:0 = SKILL_NUM_F("숏잽")

		L_LEARN:0 = SKILL_NUM_F("일할의활천")
		L_LEARN_LV:0 = 7
		L_LEARN:1 = SKILL_NUM_F("돌려차기")
		L_LEARN_LV:1 = 13
		L_LEARN:2 = SKILL_NUM_F("방어부수기")
		L_LEARN_LV:2 = 17
		L_LEARN:3 = SKILL_NUM_F("전광석화")
		L_LEARN_LV:3 = 23
		L_LEARN:4 = SKILL_NUM_F("물어-뜯기")
		L_LEARN_LV:4 = 27
		L_LEARN:5 = SKILL_NUM_F("추격의심득")
		L_LEARN_LV:5 = 33
		L_LEARN:6 = SKILL_NUM_F("오의방어부수기")
		L_LEARN_LV:6 = 37
		L_LEARN:7 = SKILL_NUM_F("신등거출팔백만격")
		L_LEARN_LV:7 = 45
	CASE "剣士"
		L_SKILL:0 = SKILL_NUM_F("일문자베기")

		L_LEARN:0 = SKILL_NUM_F("일할의활천")
