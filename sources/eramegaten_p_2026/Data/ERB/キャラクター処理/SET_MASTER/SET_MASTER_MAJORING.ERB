			L_TYPE:GET_TYPE_NUM("지변") = 150
			L_TYPE:GET_TYPE_NUM("중력") = 150
			L_TYPE:GET_TYPE_NUM("핵열") = 150
			FOR LCOUNT, 0, 5
				SWAP L_TYPE:GET_TYPE_NUM(RAND_SPLIT("질풍/지변/수격/중력/핵열", "/")), L_TYPE:GET_TYPE_NUM(RAND_SPLIT("질풍/지변/수격/중력/핵열", "/"))
			NEXT
		CASEELSE
			;2,3桁目がタイプ番号になってるかどうかを確認
			SIF !INRANGE(RESULT / 10, 0, TYPENUM - 1)
				CONTINUE
			;1桁目がタイプ値の設定範囲内か確認
			SIF !INRANGE(RESULT % 10, 0, VARSIZE("TYPE_VALUE"))
				CONTINUE
			;現在の状態をボタンをクリックした場合はリセット
			IF L_TYPE:(RESULT / 10) == TYPE_VALUE:(RESULT % 10)
				L_TYPE:(RESULT / 10) = 100
			ELSE
				L_TYPE:(RESULT / 10) = TYPE_VALUE:(RESULT % 10)
			ENDIF
	ENDSELECT
WEND
