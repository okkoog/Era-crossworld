			ELSE
				TEMPS += " " * L_RIGHT_WINDOW_LENS
			ENDIF
			SHOW_LINE:L_LINENUM += "│" + TEMPS + "│"
			L_LINENUM += 1
		NEXT
	NEXT
	SHOW_LINE:L_LINENUM += "│" + " " * L_RIGHT_WINDOW_LENS + "│"
ELSE
	FOR LCOUNT, 1, L_SHOWNUM + 1
		SHOW_LINE:LCOUNT += "│" + " " * L_RIGHT_WINDOW_LENS + "│"
	NEXT
ENDIF
