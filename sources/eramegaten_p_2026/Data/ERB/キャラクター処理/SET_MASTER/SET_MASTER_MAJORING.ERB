		SHOW_LINE:(L_LINENUM + 4) += "│"  + " " * 50 + "│"
		L_LINENUM += 5

		;-------------------------------------------
		;基本ステータス
		;-------------------------------------------
		SHOW_LINE:(L_LINENUM + 0) += "│"  + @"%"□" + "스테이터스", 50, LEFT%" + "│" 
		FOR LCOUNT, 0, (BASESTATUSNUM - 1) / 2 + (BASESTATUSNUM - 1) % 2
			L_LINENUM++
			SHOW_LINE:L_LINENUM += "│"
			FOR LCOUNT:1, 0, 2
				L_ST = LCOUNT * 2 + LCOUNT:1 + 1
				TEMP = DEVIL_CLASS_BASE_STATUS:L_ST
				;ステータスの加算
				BASE:MASTER:GET_BASESTATUS(L_ST) += TEMP
				TEMPS = 　%GET_BASESTATUS(L_ST), 4% {TEMP,2}
				TEMPS:1 = <font color = '%TOSTR_HTML(COLOR("パ緑"))%'>%" " + TEMP * UNICODE(0x258B)%</font>
				TEMPS:1 += " " * (25 - TEMP - 10)
				SHOW_LINE:L_LINENUM += TEMPS + TEMPS:1
			NEXT
			SHOW_LINE:L_LINENUM += "│"
		NEXT
		SHOW_LINE:(L_LINENUM + 1) += "│"  + " " * 50 + "│"

		;-------------------------------------------
		;継承素質
		;-------------------------------------------
		SHOW_LINE:(L_LINENUM + 2) += "│"  + @"%"□" + "계승소질", 50, LEFT%" + "│" 
		L_LINENUM += 3
		SHOW_LINE:L_LINENUM  += "│"
		TEMPS = 
		FOR LCOUNT, 0, VARSIZE("DEVIL_CLASS_SUCCESSION")
			SIF DEVIL_CLASS_SUCCESSION:LCOUNT < 0
				CONTINUE
			TEMPS += "【" + GET_SUCCESSION(DEVIL_CLASS_SUCCESSION:LCOUNT) + "】"
			TALENT:MASTER:GET_SUCCESSION(DEVIL_CLASS_SUCCESSION:LCOUNT) = 1
		NEXT
		SHOW_LINE:L_LINENUM += @"%TEMPS, 50, LEFT%" + "│"
		SHOW_LINE:(L_LINENUM + 1) += "│"  + " " * 50 + "│"
		L_LINENUM += 2
		
		;-------------------------------------------
		;所持・習得スキル
		;-------------------------------------------
		SHOW_LINE:(L_LINENUM + 0) += "│"  + @"%"□" + "스킬", 50, LEFT%" + "│"
		VARSET L_SKILL
		FOR LCOUNT, 0, 3
			L_SKILL:FINDELEMENT(L_SKILL, 0) = DEVIL_CLASS_SKILL:LCOUNT
		NEXT
		FOR LCOUNT, 0, HAVEABLE_SKILLNUM
			L_SKILL:FINDELEMENT(L_SKILL, 0) = DEVIL_CLASS_LEARN:LCOUNT
		NEXT
		FOR LCOUNT, 0, 14
			L_LINENUM++
			SHOW_LINE:L_LINENUM += "│"
			IF L_SKILL:LCOUNT
				TEMPS = %SKILL_NAME_F(L_SKILL:LCOUNT)%
				TEMPS:1 = %" " * (50 - STRLENS(TEMPS) - 4)%
				CALL GET_SKILL_EXPLAIN_TOOLTIP, L_SKILL:LCOUNT
				TEMPS = 【<button value = '' title = '%RESULTS%'>%TEMPS%</button>】
				SHOW_LINE:L_LINENUM += TEMPS + TEMPS:1
			ELSE
				SHOW_LINE:L_LINENUM += " " * 50
			ENDIF
			SHOW_LINE:L_LINENUM += "│"
		NEXT

		L_LINENUM += 1
		;-------------------------------------------
		;追加素質
		;-------------------------------------------
		SHOW_LINE:L_LINENUM += "│"  + @"%"□" + "추가소질", 50, LEFT%" + "│" 
		L_TALENT = %DEVIL_BTL_TALENT%
		VARSET L_TALENTS
		FOR LCOUNT, 0, 4
			TEMPS = %AUTO_SPLIT(L_TALENT, "/", LCOUNT)%
			TEMPS:1 = %AUTO_SPLIT(TEMPS, "_", 0)%
			TEMP:1 = GETNUM(TALENT, TEMPS:1);EDIT 50 ADD
			;ツールチップが取れるかどうかで戦闘素質かを判定する
			TRYCCALLFORM SUB_ROLE_EXPLAIN_TOOLTIP_%TEMPS:1%
				L_TITLE:LCOUNT = %RESULTS%

				L_TALENTS:LCOUNT = %TEMPS:1%
				L_COLOR = %TOSTR_HTML(GETDEFCOLOR())%
				CAN_ADD_TALENT += "/" + TEMPS
				SIF GET_SUB_ROLE_PROP("MAXLV", TEMPS:1) > 1
					TEMPS:1 = %TEMPS:1,12,LEFT% Lv{TOINT(AUTO_SPLIT(TEMPS, "_", 1))}
			CATCH
				;調教素質をセットする
				IF FINDELEMENT(TALENTNAME, TEMPS:1) > 0
					L_TALENTS:LCOUNT = %TEMPS:1%
					TALENT:MASTER:(TEMPS:1) = 1
					
					CALL GET_TALENT_EXPLAIN, , TEMPS:1 
					L_TITLE:LCOUNT = %RESULTS%
				ENDIF
			ENDCATCH
		NEXT
		FOR LCOUNT, 0, 4
			L_LINENUM++
			IF L_TALENTS:LCOUNT == ""
				SHOW_LINE:L_LINENUM += "│" + " " * 50 + "│"
			ELSE
				;余白の長さを確定しておく
				TEMP = 50 - STRLENS(HTML_TOPLAINTEXT(L_TALENTS:LCOUNT)) - 4
				L_TALENTS:LCOUNT '= SET_BUTTON_TAG("【"+ L_TALENTS:LCOUNT + "】", , L_TITLE:LCOUNT)
				L_TALENTS:LCOUNT '= SET_COLOR_TAG(L_TALENTS:LCOUNT, L_COLOR)
				SHOW_LINE:L_LINENUM += "│" + L_TALENTS:LCOUNT + " " * TEMP + "│"
			ENDIF
		NEXT
		
		FOR LCOUNT, L_LINENUM + 1, DEVIL_SHOWNUM
			SHOW_LINE:LCOUNT += "│"  + " " * 50 + "│"
		NEXT
	ELSE
		FOR LCOUNT, 0, DEVIL_SHOWNUM
			L_LINENUM++
			SHOW_LINE:L_LINENUM += "│"  + " " * 50 + "│"
		NEXT
	ENDIF
NEXT
SHOW_LINE:(DEVIL_SHOWNUM + 1) += ("└" + "─" * 25 + "┘") * 2
FOR LCOUNT, 0, DEVIL_SHOWNUM + 2
	HTML_PRINT SHOW_LINE:LCOUNT
NEXT

