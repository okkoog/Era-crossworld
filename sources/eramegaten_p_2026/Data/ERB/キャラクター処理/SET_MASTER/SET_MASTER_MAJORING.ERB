;--------------------------------------------
;2クラス複合型キャラメイクによるスキルのセット関数
;スキル関連の内容を配列にいれて送って使う
;ARG = セットするキャラクター
;SKILL		初期スキル
;LEARN		습득스킬
;LEARN_LV	習得レベル
;--------------------------------------------
@SET_MASTER_SKILL, ARG, ARGS = "通常形態", ARGS:1, ARG:1, ARGS:2, ARG:2
#DIM LCOUNT, 2
#DIM BLANK_NUM,2
#DIMS L_SKILLS
#DIM TEMP, 2
#DIM TEMP_SKILL
#DIM TEMP_LV
#DIM L_SKILL, 30
#DIM L_LEARN, HAVEABLE_SKILLNUM
#DIM L_LEARN_LV, HAVEABLE_SKILLNUM
#DIM SKILL_0, HAVEABLE_SKILLNUM
#DIM LEARN_0, HAVEABLE_SKILLNUM
#DIM LEARN_LV_0, HAVEABLE_SKILLNUM
#DIM SKILL_1, HAVEABLE_SKILLNUM
#DIM LEARN_1, HAVEABLE_SKILLNUM
#DIM LEARN_LV_1, HAVEABLE_SKILLNUM
VARSET L_SKILL
VARSET L_LEARN
VARSET L_LEARN_LV
VARSET SKILL_0
VARSET LEARN_0
VARSET LEARN_LV_0
VARSET SKILL_1
VARSET LEARN_1
VARSET LEARN_LV_1
CALL CLEAR_LEARNED_SKILL_ALL, ARG
FOR LCOUNT, 0, 2
	IF !LCOUNT
		TRYCALLFORM SET_VAR_%ARGS:(LCOUNT+1)%_SKILL, ARG:1,SKILL_0,LEARN_0,LEARN_LV_0
	ELSE
		TRYCALLFORM SET_VAR_%ARGS:(LCOUNT+1)%_SKILL, ARG:2,SKILL_1,LEARN_1,LEARN_LV_1
	ENDIF
NEXT
FOR LCOUNT:1, 0 , 2
	FOR LCOUNT, 0, HAVEABLE_SKILLNUM
		IF ARGS == "変身形態"
			BLANK_NUM = FINDELEMENT(ABL:ARG:0, 0, GETNUM(ABL, "초기변신악마스킬1"), GETNUM(ABL, @"초기변신악마스킬{CHARA_SKILLCOUNT(ARG)}"))
		ELSE
			BLANK_NUM = FINDELEMENT(ABL:ARG:0, 0, GETNUM(ABL, "스킬1"), GETNUM(ABL, @"스킬{CHARA_SKILLCOUNT(ARG)}"))
		ENDIF
		SIF BLANK_NUM < 0
			BREAK
		;重複チェック
		TEMP_SKILL = LCOUNT:1 ? SKILL_1:LCOUNT # SKILL_0:LCOUNT
		SIF FINDELEMENT(ABL:ARG:0, TEMP_SKILL, GETNUM(ABL, "스킬1"), GETNUM(ABL, @"스킬{CHARA_SKILLCOUNT(ARG)}")) >= 0
			CONTINUE
		ABL:ARG:BLANK_NUM = TEMP_SKILL
	NEXT
	;この関数に来る前に設定されているスキル、というかサバトマがあるのでスキルが確定したあとで入れる
	;---- EDIT 055 ADD START -------------------------
	;自力習得スキルとして初期スキルを登録
	FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
		IF ARGS == "変身形態"
			TEMP_SKILL = ABL:ARG:@"초기변신악마스킬{LCOUNT}"
		ELSE
			TEMP_SKILL = ABL:ARG:@"스킬{LCOUNT}"
		ENDIF
		SIF TEMP_SKILL
			CALL SET_LEARNED_SKILL, ARG, TOSTR(TEMP_SKILL), ARGS
	NEXT
	;---- EDIT 055 ADD END ---------------------------
NEXT
TEMP = 10000 * 10000
VARSET L_LEARN, TEMP
VARSET L_LEARN_LV, TEMP
FOR LCOUNT:1, 0, 2
	FOR LCOUNT, 0, HAVEABLE_SKILLNUM
		TEMP:1 = FINDELEMENT(L_LEARN, TEMP)
		SIF TEMP == -1
			BREAK
		TEMP_SKILL = LCOUNT:1 ? LEARN_1:LCOUNT # LEARN_0:LCOUNT
		TEMP_LV = LCOUNT:1 ? LEARN_LV_1:LCOUNT # LEARN_LV_0:LCOUNT
	
		;所持スキルとの重複チェック
		SIF FINDELEMENT(ABL:ARG:0, TEMP_SKILL, GETNUM(ABL, "스킬1"), GETNUM(ABL, @"스킬{CHARA_SKILLCOUNT(ARG)}")) >= 0
			CONTINUE
		
		;習得スキルの重複チェック
		IF MATCH(L_LEARN, TEMP_SKILL)
			L_LEARN_LV:FINDELEMENT(L_LEARN, TEMP_SKILL) = MIN(TEMP_LV, L_LEARN_LV:FINDELEMENT(L_LEARN, TEMP_SKILL))
		ELSE
			L_LEARN:(TEMP:1) = TEMP_SKILL
			L_LEARN_LV:(TEMP:1) = TEMP_LV
			;---- EDIT 055 DEL START -------------------------
			;自力習得スキルとして登録
			;CALL SET_LEARNED_SKILL, ARG, TOSTR(TEMP_SKILL)
			;---- EDIT 055 DEL END ---------------------------
		ENDIF
	NEXT
NEXT
ARRAYMSORT L_LEARN_LV, L_LEARN
IF ARGS == "変身形態"
	L_SKILLS = 초기변신악마습득
ELSE
	L_SKILLS = 습득
ENDIF
FOR LCOUNT, 0, 20
	ABL:ARG:@"%L_SKILLS%스킬{LCOUNT+1}" = L_LEARN:LCOUNT % 10000
	ABL:ARG:@"%L_SKILLS%LV{LCOUNT+1}" = L_LEARN_LV:LCOUNT % 10000
NEXT
;習得レベルをずらす
FOR LCOUNT, 1, 20
	SIF ABL:ARG:@"%L_SKILLS%LV{LCOUNT+1}" == 0
		CONTINUE
	SIF ABL:ARG:@"%L_SKILLS%LV{LCOUNT}" != ABL:ARG:@"%L_SKILLS%LV{LCOUNT+1}"
		CONTINUE
	ABL:ARG:@"%L_SKILLS%LV{LCOUNT+1}" += 2
NEXT

;========================================================================
;主人の耐性セット関数(반마인/悪魔人用)
;========================================================================
@SET_MASTER_DEF_TYPE
#DIM LCOUNT, 2
#DIM L_LINE
#DIM TEMP
#DIMS TEMPS
#DIMS SHOW_LINE
#DIMS L_COLOR
#DIM L_TYPE, TYPENUM + 1;設定中の相性値
#DIM CONST TYPE_VALUE = 150, 100, 75, 50, 0, -50, 999
#DIMS CONST TYPE_VALUES = "약점", "보통", "약내성", "강내성", "무효", "흡수", "반사"
#DIM COUNT_WEAK;弱点数
#DIM COUNT_BLOCK;無効以上の数
#DIM TYPE_STRENGTH;耐性の総合評価値
#DIM CONST TYPE_STRENGTH_VALUE = -3, 0, 1, 2, 3, 4, 4
#DIM CLEAR_RULE, 3

VARSET L_TYPE, 100

L_LINE = LINECOUNT
WHILE 1
	CLEARLINE LINECOUNT - L_LINE
	VARSET COUNT_WEAK
	VARSET COUNT_BLOCK
	VARSET TYPE_STRENGTH
	;------------------------------------------
	;耐性の査定
	;------------------------------------------
	FOR LCOUNT, 0, TYPENUM - 1
		TYPE_STRENGTH +=  TYPE_STRENGTH_VALUE:FINDELEMENT(TYPE_VALUE, L_TYPE:LCOUNT)
		SELECTCASE TYPE_VALUES:FINDELEMENT(TYPE_VALUE, L_TYPE:LCOUNT)
			CASE "약점"
				COUNT_WEAK++
			CASE "무효", "반사", "흡수"
				COUNT_BLOCK++
		ENDSELECT
	NEXT
	;条件1~3を満たしているかを取得
	CLEAR_RULE:0 = TYPE_STRENGTH <= 5
	CLEAR_RULE:1 = COUNT_WEAK >= 3
	CLEAR_RULE:2 = COUNT_BLOCK <= (COUNT_WEAK * 2 / 3)
	DRAWLINE
	PRINTFORML 방어상성을 설정해주세요。
	PRINTFORML 규칙①…상성의 이하 코스트 합계가 ５이하　일 것
	PRINTFORML 　약점(-3P)、가벼운내성(1P)、내성(2P)、무효(3P)、반사(4P)、흡수(4P)
	PRINTFORML 규칙②…약점의 수가 ３개 이상　일 것
	PRINTFORML 규칙③…무효・반사・흡수는 약점 수의 ２／３까지　일 것
	PRINTFORML 규칙④…만능 100％ 고정
	DRAWLINE
	CALL PRINT_COLOR, @"①상성코스트　：{TYPE_STRENGTH,3} (최대５까지)　　　　　　 …" + \@ CLEAR_RULE:0 ? ＯＫ # ＮＧ\@, CLEAR_RULE:0 ? GETDEFCOLOR() # COLOR("red"), "L"
	CALL PRINT_COLOR, @"②약점수　　　：{COUNT_WEAK,3} (최저３개이상)　　　　　 …" + \@ CLEAR_RULE:1 ? ＯＫ # ＮＧ\@, CLEAR_RULE:1 ? GETDEFCOLOR() # COLOR("red"), "L"
	CALL PRINT_COLOR, @"③무효내성수　：{COUNT_BLOCK,3}（지금의약점수는{COUNT_WEAK * 2 / 3}개까지） …" + \@ CLEAR_RULE:0 ? ＯＫ # ＮＧ\@, CLEAR_RULE:2 ? GETDEFCOLOR() # COLOR("red"), "L"

	SETCOLOR BGCOLOR("LIGHT-BLACK")
	PRINTFORM %UNICODE(0x000D) * 2%
	FOR LCOUNT, 0, (TYPENUM - 1)
		PRINTFORM %UNICODE(0x000D)%
		SIF LCOUNT % 2 == 0
			PRINTFORM %UNICODE(0x2588) * LINELENS()%
	NEXT
	PRINTL 
	RESETCOLOR
	DRAWLINE
	PRINTFORM 相性 　　　　　　\@IS_MOUSEUI ?  # 　\@
	FOR LCOUNT, 0, VARSIZE("TYPE_VALUE")
		IF IS_MOUSEUI
			PRINTFORM 　{TYPE_STRENGTH_VALUE:LCOUNT, 2}pt　　
		ELSE
			PRINTFORM 　　{TYPE_STRENGTH_VALUE:LCOUNT, 2}pt　　　
		ENDIF
	NEXT
	PRINTL 
	FOR LCOUNT, 0, TYPENUM - 1
		SHOW_LINE = %GET_TYPE(LCOUNT) + " "%
		L_COLOR = %TOSTR_HTML(COLOR(GET_WEAKNESS(L_TYPE:LCOUNT) + "컬러"))%
