@GET_MASTER_MAJORING, ARG = -1, ARG:1
#FUNCTIONS
ARG = ARG == -1 ? CFLAG:MASTER:당신의전공분야 # ARG
SELECTCASE ARG
	CASE 0
		RETURNF "없음"
	CASE 1
		RETURNF "데빌서머너"
	CASE 2
		RETURNF "페르소나구사자"
	CASE 3
		RETURNF "이능자"
	CASE 4
		SIF ARG:1
			RETURNF "관광객"
		RETURNF "일반인"
	CASE 5
		RETURNF "식노"
	CASE 6
		RETURNF "달인"
	CASE 7
		RETURNF "데빌헌터"
	CASE 8
		RETURNF "악마인"
	CASE 9
		RETURNF "타케시"
	CASE 10
		RETURNF "데빌시프터"
	CASE 11
		RETURNF "아웃사이더"
	CASE 12
		RETURNF "반마인"
	CASE 13
		RETURNF "MASTER의후손"
	;---- EDIT P 001 ADD START -------------------------
	CASE 14
		RETURNF "합일신"
	;---- EDIT P 001 ADD END ---------------------------
	CASEELSE
		RETURNF "전공분야의지정미스"
ENDSELECT

@GET_MASTER_MAJORING_NUM, ARGS
#FUNCTION
#DIM LCOUNT
#DIMS L_MASTER_MAJORING, 20
IF L_MASTER_MAJORING == ""
	FOR LCOUNT, 0, MASTER_MAJORING_NUM()
		L_MASTER_MAJORING:LCOUNT = %GET_MASTER_MAJORING(LCOUNT)%
	NEXT
ENDIF
RETURNF FINDELEMENT(L_MASTER_MAJORING, ARGS)

;専攻を選択できるかどうか
;RESULT = 表示順
@IS_ABLE_MASTER_MAJORING, ARG, STOCK_MASTER
#FUNCTION
#DIM STOCK_MASTER
SELECTCASE GET_MASTER_MAJORING(ARG)
	CASE "없음"
		RETURNF 0
	CASE "MASTER의후손"
		SIF !TALENT:STOCK_MASTER:마스터의혈통
			RETURNF 0
		RETURNF 1
	CASE "데빌서머너"
		RETURNF 2
	CASE "이능자"
		RETURNF 11
	CASE "달인"
		IF !IS_DEBUG
			SIF !FLAG:경험ED수
				RETURNF 0
		ENDIF
		RETURNF 12
	CASE "페르소나구사자"
		RETURNF 21
	CASE "식노"
		RETURNF 33
	CASE "데빌헌터"
		IF !IS_DEBUG
			SIF !FLAG:단테격파
				RETURNF 0
			;SIF FLAG:경험ED수 < 60 EDIT 047 MOD
			SIF FLAG:경험ED수 < 5
				RETURNF 0
		ENDIF
		RETURNF 43
	;---- EDIT P 001 ADD START -------------------------
	CASE "합일신"
		RETURNF 40
	;---- EDIT P 001 ADD END --------------------------
	CASE "반마인"
		RETURNF 41
	CASE "악마인"
		RETURNF 42
	CASE "데빌시프터"
		RETURNF 31
	CASE "아웃사이더"
		RETURNF 32
	CASE "일반인"
		RETURNF 91
	CASE "타케시"
		RETURNF 92
	CASE "전공분야의지정미스"
		RETURNF 0
ENDSELECT

