			L_LINENUM += 1
			SHOW_LINE:L_LINENUM += "│"  + @"%"□" + "습득스킬", L_RIGHT_WINDOW_LENS, LEFT%" + "│" 
		ENDIF
		L_LINENUM += 1
		FOR LCOUNT, 0, 3
			L_SKILL_NO = LCOUNT:1 == 0 ? L_SKILL:LCOUNT # L_LEARN:LCOUNT
