#DIM STOCK_MASTER
#DIM LCOUNT, 2
#DIM L_RESULT
#DIM TEMP
#DIMS TEMPS
#DIMS L_SKILLS
#DIM L_LINE
#DIM CONST L_SHOWNUM = 32
#DIMS SHOW_LINE, 34
#DIM L_LINENUM
#DIM SELECT_PERSONA
#DIM SELECT_ABLE, 61
#DIM PERSONA_NO, 2
#DIM PERSONA_SKILL, 8
#DIM PERSONA_LEARN, HAVEABLE_SKILLNUM
#DIM PERSONA_LEARN_LV, HAVEABLE_SKILLNUM
#DIM PERSONA_SUCCESSION, SUCCESSIONNUM
#DIM PERSONA_BASESTATUS, BASESTATUSNUM
#DIM PERSONA_TYPE, TYPENUM
#DIM PERSONA_ALI, 2
#DIMS PERSONA_EXPLAIN, 2
#DIM L_LV_FIXED, SUB_ROLENUM
#DIMS L_TALENTS_FIXED, SUB_ROLENUM
#DIM L_HAVE_SUCCESSIONNUM
L_LINE = LINECOUNT

VARSET SELECT_ABLE
;選択可能なペルソナの設定
FOR LCOUNT, 0, 50
	SIF !GET_MASTER_PERSONA_NO(LCOUNT)
		CONTINUE
	SIF FINDELEMENT(SELECT_ABLE, 0) == -1
		CONTINUE
	SELECT_ABLE:FINDELEMENT(SELECT_ABLE, 0) = LCOUNT
NEXT

;周回での持ち越しペルソナは51~60として配列に入れる
FOR LCOUNT, 1, 11
	SIF !DITEMTYPE:LCOUNT:페르소나("NO")
		CONTINUE
	SIF FINDELEMENT(SELECT_ABLE, 0) == -1
		CONTINUE
	SELECT_ABLE:FINDELEMENT(SELECT_ABLE, 0) = LCOUNT + 50
NEXT
SIF CFLAG:MASTER:초기페르소나넘버
	SELECT_ABLE:FINDELEMENT(SELECT_ABLE, 0) = 61
$START
CLEARLINE LINECOUNT - L_LINE

DRAWLINE
PRINTL 초기페르소나를 선택해주세요。
DRAWLINE

;-----------------------------------------------------
;左選択欄
;-----------------------------------------------------
SHOW_LINE:0 = %"┌" + "─" * 15 + "┐"%
FOR LCOUNT, 0, L_SHOWNUM
	L_LINENUM = LCOUNT + 1
	IF SELECT_ABLE:LCOUNT
		TEMPS = %GET_MASTER_PERSONA_NAME(SELECT_ABLE:LCOUNT)%
		SHOW_LINE:L_LINENUM = [{LCOUNT + 1, 2}] %TEMPS, 25, LEFT%
		SHOW_LINE:L_LINENUM = <font color = '%TOSTR_HTML(SELECT_PERSONA == SELECT_ABLE:LCOUNT ? COLOR("aqua") # GETDEFCOLOR())%'>%SHOW_LINE:L_LINENUM%</font>
		SHOW_LINE:L_LINENUM = <button value = '{LCOUNT + 1}'>%SHOW_LINE:L_LINENUM%</button>
	ELSE
		SHOW_LINE:L_LINENUM = %" " * 30%
	ENDIF
	SHOW_LINE:L_LINENUM = %"│" + SHOW_LINE:L_LINENUM + "│" %
NEXT
SHOW_LINE:(L_SHOWNUM + 1) = %"└" + "─" * 15 + "┘"%
;-----------------------------------------------------
;ペルソナ欄
;----------------------------------------------------―
SHOW_LINE:0 += "┌" + "─" * 40 + "┐"
L_LINENUM = 1
IF SELECT_PERSONA > 0
	CALL SET_VAR_MASTER_PERSONA, SELECT_PERSONA, PERSONA_NO, PERSONA_SKILL, PERSONA_LEARN, PERSONA_LEARN_LV, PERSONA_BASESTATUS, PERSONA_SUCCESSION, PERSONA_TYPE, PERSONA_ALI, PERSONA_EXPLAIN

	SHOW_LINE:(L_LINENUM + 0) += "│"  + @"%"□" + CSVCALLNAME(PERSONA_NO) + "(" + TOALIGNMENT(GET_ALI1(PERSONA_ALI:1),7,"RIGHT") + "/" + TOALIGNMENT(GET_ALI2(PERSONA_ALI:0),7,"RIGHT") + ")", 80, LEFT%" + "│"  
	SHOW_LINE:(L_LINENUM + 1) += "│"  + " " * 80 + "│"

	L_LINENUM += 2

	;ステータス表示
	SHOW_LINE:(L_LINENUM + 0) += "│"  + @"%"□" + "스테이터스", 80, LEFT%" + "│" 
	FOR LCOUNT:1, 0, 3
		L_LINENUM += 1
		SHOW_LINE:L_LINENUM += "│"
		FOR LCOUNT, 0, 2
			TEMP = LCOUNT * 2 + LCOUNT:1 + 1
			DEBUGPRINTFORML TEMP = {TEMP}
			SHOW_LINE:L_LINENUM += "　" + @"%GET_BASESTATUS(TEMP), 4%" + ":" + @"{MIN(PERSONA_BASESTATUS:TEMP, 30), 2}"
			SHOW_LINE:L_LINENUM += @"<font color = '%TOSTR_HTML(COLOR("パ緑"))%'>%" " + PERSONA_BASESTATUS:TEMP * UNICODE(0x258B)%</font>"
			SHOW_LINE:L_LINENUM += (40 - 10 - MIN(PERSONA_BASESTATUS:TEMP, 30)) * " "
		NEXT
		SHOW_LINE:L_LINENUM += "│"
	NEXT
	SHOW_LINE:(L_LINENUM + 1) += "│" + " " * 80 + "│"

	L_LINENUM += 2
	SHOW_LINE:(L_LINENUM + 0) += "│"  + @"%"□" + "상성", 80, LEFT%" + "│" 

	FOR LCOUNT, 0, TYPENUM / 6 + (TYPENUM % 6 > 0); (80 - 2 / 6) = 13
		L_LINENUM += 1
		SHOW_LINE:L_LINENUM += "│　"
		FOR LCOUNT:1, 0, 6
			IF LCOUNT * 6 + LCOUNT:1 < TYPENUM
				SHOW_LINE:L_LINENUM += GET_TYPE(LCOUNT * 6 + LCOUNT:1) + ":";6
				TEMP =  CSVBASE(PERSONA_NO, GETNUM(BASE,GET_TYPE(LCOUNT * 6 + LCOUNT:1)),0)
				SELECTCASE CHECK_WEAKNESS(TEMP)
					CASE 1
						TEMPS = %TOSTR_HTML(COLOR("aqua"))%
					CASE 0
						TEMPS = %TOSTR_HTML(COLOR("デフォルト"))%
					CASEELSE
						TEMPS = %TOSTR_HTML(COLOR("red"))%
				ENDSELECT
				SHOW_LINE:L_LINENUM += @"<font color = '%TEMPS%'>" + @"{TEMP,4}\%" + "</font>";5
				SHOW_LINE:L_LINENUM += " 　"
			ENDIF
		NEXT
		SHOW_LINE:L_LINENUM += "│"
	NEXT
	SHOW_LINE:(L_LINENUM + 1) += "│" + " " * 80 + "│"
	SHOW_LINE:(L_LINENUM + 2) += "│"  + @"%"□" + "계승소질", 80, LEFT%" + "│" 
	TEMPS = 
	FOR LCOUNT, 0, SUCCESSIONNUM
		SIF PERSONA_SUCCESSION:LCOUNT
			TEMPS += "【" + GET_SUCCESSION(LCOUNT) + "】　"
	NEXT
	SHOW_LINE:(L_LINENUM + 3) += "│" + @"%TEMPS, 80, LEFT%" + "│"
	SHOW_LINE:(L_LINENUM + 4) += "│" + " " * 80 + "│"
	SHOW_LINE:(L_LINENUM + 5) += "│"  + @"%"□" + "스킬", 80, LEFT%" + "│" 
	L_LINENUM += 5
	FOR LCOUNT, 0, GET_ROLE_PROP("SKILLCOUNT", , "ペルソナ使い", "通常形態") / 2 + GET_ROLE_PROP("SKILLCOUNT", , "ペルソナ使い", "通常形態") % 2
		L_LINENUM += 1
		TEMPS = 
		FOR LCOUNT:1, 0, 2
			IF PERSONA_SKILL:(LCOUNT * 2 + LCOUNT:1)
				L_SKILLS = %SKILL_NAME_F(PERSONA_SKILL:(LCOUNT * 2 + LCOUNT:1))%
				TEMP = 40 - STRLENS(L_SKILLS) - 4
				CALL GET_SKILL_EXPLAIN_TOOLTIP,  PERSONA_SKILL:(LCOUNT * 2 + LCOUNT:1)
				TEMPS += @"<button value = '' title = '%RESULTS%'>" + "【" + L_SKILLS + "】" + " " * TEMP + "</button>"
			ELSE
				TEMPS += " " * 40
			ENDIF
		NEXT
		;空行なら行をすすめない
		IF STRCOUNT(TEMPS, "【")
			SHOW_LINE:L_LINENUM += "│" + TEMPS + "│"
		ELSE
			L_LINENUM -= 1
		ENDIF
	NEXT
	SHOW_LINE:(L_LINENUM + 1) += "│" + " " * 80 + "│"
	SHOW_LINE:(L_LINENUM + 2) += "│"  + @"%"□" + "습득스킬", 80, LEFT%" + "│" 
	L_LINENUM += 2
	FOR LCOUNT, 0, HAVEABLE_SKILLNUM / 2 + HAVEABLE_SKILLNUM % 2
		L_LINENUM += 1
		TEMPS = 
		FOR LCOUNT:1, 0, 2
			IF PERSONA_LEARN:(LCOUNT * 2 + LCOUNT:1)
				L_SKILLS = %SKILL_NAME_F(PERSONA_LEARN:(LCOUNT * 2 + LCOUNT:1))%
				TEMP = 40 - STRLENS(L_SKILLS) - 4
				CALL GET_SKILL_EXPLAIN_TOOLTIP,  PERSONA_LEARN:(LCOUNT * 2 + LCOUNT:1)
				TEMPS += @"<button value = '' title = '%RESULTS%'>" + "【" + L_SKILLS + "】" + " " * TEMP + "</button>"
			ELSE
				TEMPS += " " * 40
			ENDIF
		NEXT
		SHOW_LINE:L_LINENUM += "│" + TEMPS + "│"
	NEXT
	FOR LCOUNT, L_LINENUM + 1, L_SHOWNUM + 1
		SHOW_LINE:LCOUNT += "│" + " " * 80 + "│"
	NEXT
ELSE
	FOR LCOUNT, 1, L_SHOWNUM + 1
		SHOW_LINE:LCOUNT += "│" + " " * 80 + "│"
	NEXT
ENDIF
SHOW_LINE:(L_SHOWNUM + 1) += "└" + "─" * 40 + "┘"
FOR LCOUNT, 0, L_SHOWNUM + 2
	HTML_PRINT SHOW_LINE:LCOUNT
NEXT
DRAWLINE
PRINTFORML 초기페르소나를 설정합니다。
PRINTFORML 페르소나구사자는 페르소나를 적절히 활용함으로써、다양한 스킬과 스테이터스를 이용해 전투할 수 있습니다。
PRINTFORML 페르소나는 나중에 작성하여、장비할 수 있지만 초기페르소나는 캐릭터 고유의 것으로、변경할 수 없습니다。
PRINTFORML 또한、장비페르소나와의 캐릭터상성은 초기페르소나의 얼라인먼트 속성과 어느 정도 일치하는지에 따라 결정됩니다。
PRINTL
PRINTL 페르소나 결정 후、인간시의 추가 서브소질 설정을 실행합니다。
PRINTL 
PRINTL 스킬에 마우스를 올리면 간단한 해설을 볼 수 있습니다。
DRAWLINE
CALL PRINT_COLOR, "[0] 결정", SELECT_PERSONA ? GETDEFCOLOR() # COLOR("DARK-GRAY")
PRINTFORML 　　　　[99] 돌아간다
INPUT
SIF RESULT == 99
	RETURN 0
IF RESULT == 0 && SELECT_PERSONA > 0
	L_RESULT = RESULT
	TALENT:MASTER:페르소나구사자 = 1
	ABL:MASTER:초기페르소나 = PERSONA_NO:0
	ABL:MASTER:초기페르소나2 = PERSONA_NO:1
	CFLAG:MASTER:당신의전공분야  = GET_MASTER_MAJORING_NUM("페르소나구사자")
	CFLAG:MASTER:당신의전공분야1 = SELECT_PERSONA
	CALL SYNC_STATUS, MASTER
	DRAWLINE
	PRINTL 서브소질을 선택해주세요。
	DRAWLINE
	CALL ENHANCE_ROLE, MASTER, , "스킬적성_3/도구지식_3/서머너_3/석세서/건슬링거_2"
	SIF !RESULT
		GOTO START
	DRAWLINE
	;ペルソナ番号の捜索
	IF CFLAG:MASTER:초기페르소나넘버 == 0
		CFLAG:MASTER:초기페르소나넘버 = 50
		WHILE 1
			SIF !DITEMTYPE:(CFLAG:MASTER:초기페르소나넘버):페르소나("装備状態")
				BREAK
			CFLAG:MASTER:초기페르소나넘버++
		WEND
	ENDIF

	;引き継ぎでないペルソナを指定する場合は一旦クリアーする。
	IF INRANGE(SELECT_PERSONA, 1, 50)
		FOR LCOUNT, 0, 100
			DITEMTYPE:(CFLAG:MASTER:초기페르소나넘버):LCOUNT = 0
		NEXT
	ENDIF
	DITEMTYPE:(CFLAG:MASTER:초기페르소나넘버):페르소나("NO") = PERSONA_NO:0
	FOR LCOUNT, 0, BASESTATUSNUM
		DITEMTYPE:(CFLAG:MASTER:초기페르소나넘버):페르소나(GET_BASESTATUS(LCOUNT)) = PERSONA_BASESTATUS:LCOUNT
	NEXT
	DITEMTYPE:(CFLAG:MASTER:초기페르소나넘버):페르소나("속성LC") = PERSONA_ALI:0
	DITEMTYPE:(CFLAG:MASTER:초기페르소나넘버):페르소나("속성LD") = PERSONA_ALI:1

	FOR LCOUNT, 0, VARSIZE("PERSONA_SKILL")
		DITEMTYPE:(CFLAG:MASTER:초기페르소나넘버):페르소나(@"스킬{LCOUNT+1}") = PERSONA_SKILL:LCOUNT
	NEXT
	;---- EDIT 002 MOD END ---------------------------
	FOR LCOUNT, 0, VARSIZE("PERSONA_LEARN")
		DITEMTYPE:(CFLAG:MASTER:초기페르소나넘버):페르소나(@"습득스킬{LCOUNT+1}") = PERSONA_LEARN:LCOUNT
		DITEMTYPE:(CFLAG:MASTER:초기페르소나넘버):페르소나(@"습득LV{LCOUNT+1}") = PERSONA_LEARN_LV:LCOUNT
	NEXT

	DITEMTYPE:(CFLAG:MASTER:초기페르소나넘버):페르소나("装備状態") = 3
	DITEMTYPE:(CFLAG:MASTER:초기페르소나넘버):페르소나("ペルソナ所持者") = CFLAG:MASTER:캐릭터고유번호
	RETURN 1
ELSE
	IF INRANGE(RESULT, 1, L_SHOWNUM + 1)
		RESULT--
		SIF SELECT_ABLE:RESULT > 0
			SELECT_PERSONA = SELECT_ABLE:RESULT
	ENDIF
ENDIF
GOTO START

;========================================================================
;主人の変身悪魔_デビルシフター
;========================================================================
@SET_MASTER_MAJORING_SHIFTER, STOCK_MASTER, ARGS = "데빌시프터"
#DIM STOCK_MASTER
#DIM LCOUNT, 2
#DIM TEMP
#DIMS TEMPS
#DIMS L_SKILLS
#DIM L_LINE
#DIM CONST L_SHOWNUM = 34
#DIMS SHOW_LINE, 36
#DIM L_LINENUM
#DIM SELECT_DEVIL
#DIM SELECT_ABLE, 34
#DIM LINK_DEVIL_NO
#DIM LINK_DEVIL_SKILL, HAVEABLE_SKILLNUM
#DIM LINK_DEVIL_LEARN, HAVEABLE_SKILLNUM
#DIM LINK_DEVIL_LEARN_LV, HAVEABLE_SKILLNUM
#DIM LINK_DEVIL_SUCCESSION, SUCCESSIONNUM
#DIM LINK_DEVIL_MANTRA, 5
#DIMS LINK_DEVIL_EXPLAIN, 2
#DIM L_BASE_ST, BASESTATUSNUM
#DIM L_LV_FIXED, SUB_ROLENUM
#DIMS L_TALENTS_FIXED, SUB_ROLENUM

L_LINE = LINECOUNT

SELECT_DEVIL = 0
VARSET SELECT_ABLE:LCOUNT, 0
FOR LCOUNT, 0, VARSIZE("SELECT_ABLE")
	SELECTCASE ARGS
		CASE "데빌시프터", "아웃사이더"
			SIF IS_ABLE_MASTER_LINK_DEVIL(LCOUNT, MASTER)
				SELECT_ABLE:FINDELEMENT(SELECT_ABLE, 0) = LCOUNT
		CASE "식노"
			SIF IS_ABLE_MASTER_AVATAR(LCOUNT, MASTER)
				SELECT_ABLE:FINDELEMENT(SELECT_ABLE, 0) = LCOUNT
	ENDSELECT
NEXT
$START
CLEARLINE LINECOUNT - L_LINE

DRAWLINE
PRINTL 변신할 악마를 선택해주세요。
DRAWLINE

;-----------------------------------------------------
;左選択欄
;-----------------------------------------------------
SHOW_LINE:0 = %"┌" + "DEVIL " + "─" * 9 + "┐"%
FOR LCOUNT, 0, L_SHOWNUM
	L_LINENUM = LCOUNT + 1
	IF SELECT_ABLE:LCOUNT
		SELECTCASE ARGS
			CASE "데빌시프터", "아웃사이더"
				TEMPS = %GET_MASTER_LINK_DEVIL_NAME(SELECT_ABLE:LCOUNT)%
			CASE "식노"
				TEMPS = %GET_MASTER_AVATAR_NAME(SELECT_ABLE:LCOUNT)%
				SIF TEMPS == "女神マーラ"
					TEMPS = マーラ
		ENDSELECT
		SHOW_LINE:L_LINENUM = [{LCOUNT + 1, 2}] %TEMPS, 19, LEFT%
		SHOW_LINE:L_LINENUM = <font color = '%TOSTR_HTML(SELECT_DEVIL == SELECT_ABLE:LCOUNT ? COLOR("aqua") # GETDEFCOLOR())%'>%SHOW_LINE:L_LINENUM%</font>
		SHOW_LINE:L_LINENUM = <button value = '{LCOUNT + 1}'>%SHOW_LINE:L_LINENUM%</button>
	ELSE
		SHOW_LINE:L_LINENUM = %" " * 24%
	ENDIF
	SHOW_LINE:L_LINENUM = %"│" + SHOW_LINE:L_LINENUM + "│" %
NEXT
SHOW_LINE:(L_SHOWNUM + 1) = %"└" + "─" * 12 + "┘"%

;-----------------------------------------------------
;悪魔欄
;----------------------------------------------------―
SHOW_LINE:0 += "┌" + "─" * 40 + "┐"
L_LINENUM = 1
IF SELECT_DEVIL > 0
	SELECTCASE ARGS
		CASE "데빌시프터", "아웃사이더"
			CALL SET_VAR_MASTER_LINK_DEVIL, SELECT_DEVIL, LINK_DEVIL_NO, LINK_DEVIL_SKILL, LINK_DEVIL_LEARN, LINK_DEVIL_LEARN_LV, LINK_DEVIL_EXPLAIN
		CASE "식노"
			CALL SET_VAR_MASTER_AVATAR, SELECT_DEVIL, LINK_DEVIL_NO, LINK_DEVIL_SKILL, LINK_DEVIL_LEARN, LINK_DEVIL_LEARN_LV, LINK_DEVIL_EXPLAIN, LINK_DEVIL_MANTRA
	ENDSELECT
	SHOW_LINE:(L_LINENUM + 0) += "│"  + @"%"□" + CSVNAME(LINK_DEVIL_NO), 80, LEFT%" + "│"  
	SHOW_LINE:(L_LINENUM + 1) += "│"  + @"%"　" +  LINK_DEVIL_EXPLAIN:0, 80, LEFT%" + "│" 
	SHOW_LINE:(L_LINENUM + 2) += "│"  + @"%"　" +  LINK_DEVIL_EXPLAIN:1, 80, LEFT%" + "│" 

	L_LINENUM += 3

	;ステータス比率は108レベル相当の数値に直した状態で提示する
	L_BASE_ST = 0
	FOR LCOUNT, 1, BASESTATUSNUM
		L_BASE_ST:LCOUNT = CSVBASE(LINK_DEVIL_NO, GETNUM(BASE,GET_BASESTATUS(LCOUNT)),0)
		L_BASE_ST += L_BASE_ST:LCOUNT
	NEXT
	FOR LCOUNT, 1, BASESTATUSNUM
		L_BASE_ST:LCOUNT = L_BASE_ST:LCOUNT * (18 + 108 * 3 / 2) / L_BASE_ST
	NEXT
	WHILE SUMARRAY(L_BASE_ST, 1, BASESTATUSNUM) != (18 + 108 * 3 / 2)
		IF SUMARRAY(L_BASE_ST, 1, BASESTATUSNUM) > (18 + 108 * 3 / 2)
			L_BASE_ST:FINDELEMENT(L_BASE_ST, MAXARRAY(L_BASE_ST, 1, BASESTATUSNUM)) -= 1
		ELSE
			L_BASE_ST:FINDELEMENT(L_BASE_ST, MINARRAY(L_BASE_ST, 1, BASESTATUSNUM)) += 1
		ENDIF
	WEND
	SHOW_LINE:(L_LINENUM + 0) += "│"  + @"%"□" + "스테이터스 비율", 80, LEFT%" + "│" 
	FOR LCOUNT, 1, BASESTATUSNUM
		L_LINENUM += 1
		SHOW_LINE:L_LINENUM += "│"
		SHOW_LINE:L_LINENUM += "　" + @"%GET_BASESTATUS(LCOUNT), 4%" + ":" + @"{MIN(L_BASE_ST:LCOUNT, 68), 2}"
		SHOW_LINE:L_LINENUM += @"<font color = '%TOSTR_HTML(COLOR("パ緑"))%'>%" " + L_BASE_ST:LCOUNT * UNICODE(0x258B)%</font>"
		SHOW_LINE:L_LINENUM += (80 - 10 - MIN(L_BASE_ST:LCOUNT, 68)) * " "
		SHOW_LINE:L_LINENUM += "│"
	NEXT
	SHOW_LINE:(L_LINENUM + 1) += "│" + " " * 80 + "│"

	L_LINENUM += 2
	SHOW_LINE:(L_LINENUM + 0) += "│"  + @"%"□" + "상성", 80, LEFT%" + "│" 

	FOR LCOUNT, 0, TYPENUM / 6 + (TYPENUM % 6 > 0); (80 - 2 / 6) = 13
		L_LINENUM += 1
		SHOW_LINE:L_LINENUM += "│　"
		FOR LCOUNT:1, 0, 6
			IF LCOUNT * 6 + LCOUNT:1 < TYPENUM
				SHOW_LINE:L_LINENUM += GET_TYPE(LCOUNT * 6 + LCOUNT:1) + ":";6
				TEMP =  CSVBASE(LINK_DEVIL_NO, GETNUM(BASE,GET_TYPE(LCOUNT * 6 + LCOUNT:1)),0)
				SELECTCASE CHECK_WEAKNESS(TEMP)
					CASE 1
						TEMPS = %TOSTR_HTML(COLOR("aqua"))%
					CASE 0
						TEMPS = %TOSTR_HTML(COLOR("デフォルト"))%
					CASEELSE
						TEMPS = %TOSTR_HTML(COLOR("red"))%
				ENDSELECT
				SHOW_LINE:L_LINENUM += @"<font color = '%TEMPS%'>" + @"{TEMP,4}\%" + "</font>";5
				SHOW_LINE:L_LINENUM += " 　"
			ELSE
			ENDIF
		NEXT
		SHOW_LINE:L_LINENUM += "│"
	NEXT
	SHOW_LINE:(L_LINENUM + 1) += "│" + " " * 80 + "│"

	FOR LCOUNT, 0, SUCCESSIONNUM
		LINK_DEVIL_SUCCESSION:LCOUNT = CSVTALENT(LINK_DEVIL_NO, GETNUM(TALENT, GET_SUCCESSION(LCOUNT)))
	NEXT
	SHOW_LINE:(L_LINENUM + 2) += "│"  + @"%"□" + "계승소질", 80, LEFT%" + "│" 
	TEMPS = 
	FOR LCOUNT, 0, SUCCESSIONNUM
		SIF LINK_DEVIL_SUCCESSION:LCOUNT
			TEMPS += "【" + GET_SUCCESSION(LCOUNT) + "】　"
	NEXT
	SHOW_LINE:(L_LINENUM + 3) += "│" + @"%TEMPS, 80, LEFT%" + "│"
	SHOW_LINE:(L_LINENUM + 4) += "│" + " " * 80 + "│"
	SHOW_LINE:(L_LINENUM + 5) += "│"  + @"%"□" + "스킬", 80, LEFT%" + "│" 
	L_LINENUM += 5
	FOR LCOUNT, 0, GET_ROLE_PROP("SKILLCOUNT", , ARGS, "変身形態") / 2 + GET_ROLE_PROP("SKILLCOUNT", , ARGS, "変身形態") % 2
		L_LINENUM += 1
		TEMPS = 
		FOR LCOUNT:1, 0, 2
			IF LINK_DEVIL_SKILL:(LCOUNT * 2 + LCOUNT:1)
