;========================================================================
;페르소나
;========================================================================
;--------------------------------------------------
;マスター用初期リンク悪魔の名称定義関数
;--------------------------------------------------
@GET_MASTER_PERSONA_NAME, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		RETURNF "隠　者　ハルワタート"
	CASE 2
		RETURNF "皇　帝　ヌアザ"
	CASE 3
		RETURNF "女教皇　ウシャス"
	CASE 4
		RETURNF "魔術師　マナナン"
	CASE 5
		RETURNF "愚　者　カンショウ"
	CASE 6
		RETURNF "戦　車　ゴズ"
	CASE 7
		RETURNF "剛　毅　ナーガラジャ"
	CASE 8
		RETURNF "　月　　ボルボ"
	CASE 9
		RETURNF "　塔　　ゼリー・マン"
	CASE 10
		RETURNF "サラスヴァティ"
	CASE 11
		RETURNF "スカアハ"
	CASE 12
		RETURNF "キクリヒメ"
	CASE 13
		RETURNF "エンジェル"
	CASE 14
		RETURNF "ジャックフロスト"
	CASE 15
		RETURNF "モコイ"
	CASE 16
		RETURNF "モー・ショボー"
	CASE 17
		RETURNF "ゾンビちゃん"
	CASE 18
		RETURNF "リリム"
	CASE 19
		RETURNF "マンイーター"
	CASE 51 TO 61
		IF ARG == 61 && CFLAG:MASTER:초기페르소나넘버
			ARG = CFLAG:MASTER:초기페르소나넘버
		ELSE
			ARG -= 50
		ENDIF
		RETURNF CSVNAME(DITEMTYPE:ARG:페르소나("NO"))
ENDSELECT

;--------------------------------------------------
;ペルソナの名前から番号を返す
;--------------------------------------------------
@GET_MASTER_PERSONA_NUM, ARGS
#FUNCTION
#DIM LCOUNT
#DIMS L_NAMELIST, 30
IF L_NAMELIST == ""
	FOR LCOUNT, 0, 30
		L_NAMELIST:0 = %GET_MASTER_LINK_DEVIL_NAME(LCOUNT)%
	NEXT
ENDIF
SIF ARGS == ""
	RETURNF -1
RETURNF FINDELEMENT(L_NAMELIST, ARGS)

;--------------------------------------------------
;マスター用初期リンク悪魔のNO定義関数
;--------------------------------------------------
@GET_MASTER_PERSONA_NO, ARG
#FUNCTION
RESULT_F = 0
IF INRANGE(ARG, 51, 61)
	IF ARG == 61 && CFLAG:MASTER:초기페르소나넘버
		ARG = CFLAG:MASTER:초기페르소나넘버
	ELSE
		ARG -= 50
	ENDIF
	RETURNF DITEMTYPE:ARG:페르소나("NO")
ELSE
	SELECTCASE GET_MASTER_PERSONA_NAME(ARG)
		CASE "隠　者　ハルワタート"
			RESULT_F = [[キャラ:티슈트리아_페르소나]]
			RETURNF [[キャラ:하우르바타트_페르소나]]
		CASE "皇　帝　ヌアザ"
			RESULT_F = [[キャラ:일다나_페르소나]]
			RETURNF [[キャラ:누아자_페르소나]]
		CASE "女教皇　ウシャス"
			RESULT_F = [[キャラ:마리지천_페르소나]]
			RETURNF [[キャラ:우샤스_페르소나]]
		CASE "魔術師　マナナン"
			RESULT_F = [[キャラ:노덴스_페르소나]]
			RETURNF [[キャラ:마나난_페르소나]]
		CASE "愚　者　カンショウ"
			RESULT_F = [[キャラ:간장　개_페르소나]]
			RETURNF [[キャラ:간장_페르소나]]
		CASE "戦　車　ゴズ"
			RESULT_F = [[キャラ:우두천왕_페르소나]]
			RETURNF [[キャラ:우두_페르소나]]
		CASE "剛　毅　ナーガラジャ"
			RESULT_F = [[キャラ:탁샤카_페르소나]]
			RETURNF [[キャラ:나가라쟈_페르소나]]
		CASE "　月　　ボルボ"
			RESULT_F = [[キャラ:헤카테_페르소나]]
			RETURNF [[キャラ:볼보_페르소나]]
		CASE "　塔　　ゼリー・マン"
			RESULT_F = [[キャラ:마라_페르소나]]
			RETURNF [[キャラ:젤리・맨_페르소나]]
		CASE "サラスヴァティ"
			RETURNF [[キャラ:사라스바티]]
		CASE "スカアハ"
			RETURNF [[キャラ:스카아하]]
		CASE "キクリヒメ"
			RETURNF [[キャラ:키쿠리히메]]
		CASE "エンジェル"
			RETURNF [[キャラ:엔젤]]
		CASE "ジャックフロスト"
			RETURNF  [[キャラ:잭프로스트]]
		CASE "モコイ"
			RETURNF [[キャラ:모코이]]
		CASE "モー・ショボー"
			RETURNF [[キャラ:모・쇼보]]
		CASE "ゾンビちゃん"
			RETURNF [[キャラ:좀비쨩]]
		CASE "リリム"
			RETURNF [[キャラ:리림]]
		CASE "マンイーター"
			RETURNF [[キャラ:맨이터]]
	ENDSELECT
ENDIF
