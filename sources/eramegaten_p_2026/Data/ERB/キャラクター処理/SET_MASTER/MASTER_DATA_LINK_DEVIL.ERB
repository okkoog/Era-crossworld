;========================================================================
;링크악마(데빌시프터/식노)
;========================================================================
;--------------------------------------------------
;マスター用初期リンク悪魔の名称定義関数
;--------------------------------------------------
@GET_MASTER_LINK_DEVIL_NAME, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		RETURNF "タナトス"
	CASE 2
		RETURNF "クルースニク"
	CASE 3
		RETURNF "クラマテング"
	CASE 4
		RETURNF "インキュバス"
	CASE 5
		RETURNF "ジャックランタン"
	CASE 6
		RETURNF "ククノチ"
	CASE 7
		RETURNF "ラクシャーサ"
	CASE 8
		RETURNF "フェニックス"
	CASE 9
		RETURNF "クシナダヒメ"
	CASE 11
		RETURNF "フォルトゥナ"
	CASE 12
		RETURNF "パラスアテナ"
	CASE 13
		RETURNF "デュラハン"
	CASE 14
		RETURNF "サキュバス"
	CASE 15
		RETURNF "ローレライ"
	CASE 16
		RETURNF "ユキジョロウ"
	CASE 17
		RETURNF "ブラックウィドウ"
	CASE 20
		RETURNF "オニ"
	CASE 21
		RETURNF "モムノフ"
ENDSELECT

;--------------------------------------------------
;リンク悪魔の名前から番号を返す
;--------------------------------------------------
@GET_MASTER_LINK_DEVIL_NUM, ARGS
#FUNCTION
#DIM LCOUNT
#DIMS L_NAMELIST, 30
IF L_NAMELIST == ""
	FOR LCOUNT, 0, 30
		L_NAMELIST:0 = %GET_MASTER_LINK_DEVIL_NAME(LCOUNT)%
	NEXT
ENDIF
SIF ARGS == ""
	RETURNF -1
RETURNF FINDELEMENT(L_NAMELIST, ARGS)

;--------------------------------------------------
;マスター用初期リンク悪魔の使用可否関数
;--------------------------------------------------
@IS_ABLE_MASTER_LINK_DEVIL, ARG, ARG:1
#FUNCTION
SELECTCASE GET_MASTER_LINK_DEVIL_NAME(ARG)
	CASE "タナトス"
		SIF !IS_MALE(ARG:1)
			RETURNF 0
		RETURNF 1
	CASE "クルースニク"
