;------------------------------------
;マスター用の初期変身悪魔の変数代入関数
;ARG = 初期変身悪魔の番号
;------------------------------------
@SET_VAR_MASTER_LINK_DEVIL, ARG, LINK_DEVIL_NO, LINK_DEVIL_SKILL, LINK_DEVIL_LEARN, LINK_DEVIL_LEARN_LV, LINK_DEVIL_EXPLAIN
#DIM REF LINK_DEVIL_NO
#DIM REF LINK_DEVIL_SKILL
#DIM REF LINK_DEVIL_LEARN
#DIM REF LINK_DEVIL_LEARN_LV
#DIMS REF LINK_DEVIL_EXPLAIN

VARSET LINK_DEVIL_SKILL
VARSET LINK_DEVIL_LEARN
VARSET LINK_DEVIL_LEARN_LV
VARSET LINK_DEVIL_EXPLAIN
CALL SET_VAR_LINK_DEVIL_SKILL, ARG, LINK_DEVIL_SKILL, LINK_DEVIL_LEARN, LINK_DEVIL_LEARN_LV
SELECTCASE GET_MASTER_LINK_DEVIL_NAME(ARG)
	CASE "タナトス"
		LINK_DEVIL_NO = [[キャラ:타나토스]]
		LINK_DEVIL_EXPLAIN = ギリシア神話の死神。寿命の尽きた人間のもとを訪れ、その魂を連れていく。
		
	CASE "クルースニク"
		LINK_DEVIL_NO = [[キャラ:크르스니크]]
		LINK_DEVIL_EXPLAIN = 光の加護を受けた善なる吸血鬼始末人。
		
	CASE "クラマテング"
		LINK_DEVIL_NO = [[キャラ:쿠라마텐구]]
		LINK_DEVIL_EXPLAIN = 牛若丸に武術と兵法を教え鍛えた大天狗。
		
	CASE "インキュバス"
		LINK_DEVIL_NO = [[キャラ:인큐버스]]
		LINK_DEVIL_EXPLAIN = 女性に淫らな行為を働いて堕落させる夢魔。
		
	CASE "ジャックランタン"
		LINK_DEVIL_NO = [[キャラ:잭랜턴]]
		LINK_DEVIL_EXPLAIN = ハロウィンのかぼちゃの灯火のお化け。
		
	CASE "ククノチ"
		LINK_DEVIL_NO = [[キャラ:쿠쿠노치]]
		LINK_DEVIL_EXPLAIN = イザナギとイザナミの間に生まれた樹木の神。
		
	CASE "ラクシャーサ"
		LINK_DEVIL_NO = [[キャラ:락샤사]]
		LINK_DEVIL_EXPLAIN = 月のない夜に出没する悪鬼。
		
	CASE "フェニックス"
		LINK_DEVIL_NO = [[キャラ:피닉스]]
		LINK_DEVIL_EXPLAIN = 永遠の時を生きるという伝説上の鳥。
		
	CASE "クシナダヒメ"
		LINK_DEVIL_NO = [[キャラ:쿠시나다히메]]
		LINK_DEVIL_EXPLAIN = スサノオの妻。豊饒の女神ともいわれている。
		
	CASE "フォルトゥナ"
		LINK_DEVIL_NO = [[キャラ:포르투나]]
		LINK_DEVIL_EXPLAIN = ローマ神話に伝えられる運命の女神。
		
	CASE "パラスアテナ"
		LINK_DEVIL_NO = [[キャラ:팔라스아테나]]
