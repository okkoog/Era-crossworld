@GET_INFO_SORT_KEY_BELONG, ARG, ARGS
IF GET_ROLE_PROP("CAN_PUT_IN_COMP", ARG)
	IF CFLAG:ARG:소속ＣＯＭＰ == -1
		RETURN 2
	ELSE
		RETURN 1
	ENDIF
ELSE
	IF INFO_CNT_SORT % 2
		RETURN 10
	ELSE
		RETURN 0
	ENDIF
ENDIF

