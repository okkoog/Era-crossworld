@SET_VAR_INFO_DATA_体力_HEADER
#DIM DYNAMIC L_STRLENS
#DIMS DYNAMIC TEMPS
L_STRLENS = MAX(4,STRLENS(TOSTR(MAXCARRAY(MAXBASE:0:체력))))
TEMPS '=  TOALIGNMENT("체력", L_STRLENS * 2 + 3, "CENTER")
INFO_HEADER += SET_BUTTON_TAG(TEMPS, "SORT,체력")

@GET_VAR_INFO_DATA_体力, ARG
#DIM DYNAMIC L_STRLENS
L_STRLENS = MAX(4,STRLENS(TOSTR(MAXCARRAY(MAXBASE:0:체력))))
RESULTS = ({BASE:ARG:체력, L_STRLENS}/{MAXBASE:ARG:체력, L_STRLENS}) 
@GET_INFO_SORT_KEY_体力, ARG, ARGS
RETURN BASE:ARG:체력

