;--------------------------------------------------------------------------------
;CONDITION
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_CONDITION_HEADER
INFO_HEADER += SET_BUTTON_TAG(TOALIGNMENT("상태", 8 , "CENTER"), "SORT,CONDITION")

@GET_VAR_INFO_DATA_CONDITION, ARG
IF CFLAG:ARG:PT플래그 > 0
	IF CHECK_CHILD_CARE(ARG) && FLAG:출산기능ONOFF
		RESULTS '= "육아실"
	ELSEIF TALENT:ARG:임신
		RESULTS '= "임신중"
	ELSE
		SELECTCASE 위험일(ARG)
			CASE 0, -1
				RESULTS '= " " * 6
			CASE 1
				RESULTS '= "위험일"
			CASEELSE
				RESULTS '= "발정중"
		ENDSELECT
	ENDIF
	IF 위험일(ARG) > 0
		RESULTS '= ハートＢ() + RESULTS + ハートＢ()
		INFO_COLOR = 0xCC33FF
	ELSE
		RESULTS '= " " + RESULTS + " "
	ENDIF
ELSE
	RESULTS '= " " * 8
ENDIF
@GET_INFO_SORT_KEY_CONDITION, ARG, ARGS
RESULT:1 = 1
IF INFO_CNT_SORT % 2
	IF CHECK_CHILD_CARE(ARG) && FLAG:출산기능ONOFF
		RETURN 20
	ELSEIF TALENT:ARG:임신
		RETURN 10
	ELSE
		RETURN 위험일(ARG)
	ENDIF
ELSE
	IF CHECK_CHILD_CARE(ARG) && FLAG:출산기능ONOFF
		RETURN 2
	ELSEIF TALENT:ARG:임신
		RETURN 1
	ELSE
		RETURN 위험일(ARG) * 10
	ENDIF
ENDIF

;--------------------------------------------------------------------------------
;WORK
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_WORK_HEADER
INFO_HEADER += SET_BUTTON_TAG(TOALIGNMENT("노역", 4, "CENTER"), "SORT,WORK")

@GET_VAR_INFO_DATA_WORK, ARG
SELECTCASE CFLAG:ARG:노역플래그
	CASE 1	;食堂で働く
		INFO_COLOR = COLOR("PASTEL-BLUE")
	CASE 2	;体を売る
		INFO_COLOR = COLOR("PASTEL-RED")
	CASE 3	;奴隷のレンタル
		INFO_COLOR = COLOR("PASTEL-PURPLE")
	CASE 4	;音楽活動
		INFO_COLOR = COLOR("PASTEL-GREEN")
	CASE 5	;乱交ライブ
		INFO_COLOR = COLOR("PASTEL-YELLOW")
	CASE 6	;道場
		INFO_COLOR = COLOR("WHITE")
	CASE 7	;退治依頼
		INFO_COLOR = 0xFF7F50
	CASE 8	;捜査依頼
		INFO_COLOR = 0xD2B48C
	CASE 9	;回収依頼
		INFO_COLOR = 0xF0E68C
	CASE 10 TO 19	;経営店舗
		SELECTCASE [[店舗:종류]]:(CFLAG:ARG:노역플래그-10)
			CASE 10	;공중변소
				INFO_COLOR = COLOR("PASTEL-BLUEGREEN")
			CASE 11	;ストリップ劇場
				INFO_COLOR = COLOR("PINK")
			CASE 12	;見せ物小屋
				INFO_COLOR = COLOR("DARK-PINK")
			CASE 13	;メシア教会
				INFO_COLOR = COLOR("AQUA")
			CASE 14	;ガイア教会
				INFO_COLOR = COLOR("RED")
			CASE 15	;教会
				INFO_COLOR = COLOR("LIGHT-GRAY")
			CASEELSE
				INFO_COLOR = COLOR("WHITE")
		ENDSELECT
	CASEELSE
		INFO_COLOR = COLOR("WHITE")
ENDSELECT
RESULTS '= GET_JOB_OMIT(CFLAG:ARG:노역플래그 > 9 ? [[店舗:종류]]:(CFLAG:ARG:노역플래그-10) # CFLAG:ARG:노역플래그)
@GET_INFO_SORT_KEY_WORK, ARG, ARGS
#DIM DYNAMIC TEMP
RESULT:1 = 1
IF CFLAG:ARG:노역플래그
	IF CFLAG:ARG:노역플래그 > 9
		TEMP = 9
	ELSE
		TEMP = CFLAG:ARG:노역플래그 - 1
	ENDIF
	TEMP = (9 - TEMP + INFO_CNT_SORT) % 10
	TEMP = (TEMP + 1) * 100
	SIF CFLAG:ARG:노역플래그 > 9
		TEMP += [[店舗:종류]]:(CFLAG:ARG:노역플래그-10)
	RETURN TEMP
ELSE
	RETURN 0
ENDIF

