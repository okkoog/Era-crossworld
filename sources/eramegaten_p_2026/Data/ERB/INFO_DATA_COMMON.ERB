
@GET_INFO_PROPSET, ARGS
SELECTCASE ARGS
	CASE "조교", "調教"
		RESULTS '= "NO_NAME_LV_ALI_SEX_POS_体力_気力_STRESS_LOYALTY_FALLTALENT_WORK_CONDITION_KOJO"
	CASE "전투", "戦闘"
		RESULTS '= "NO_NAME_LV_ALI_SEX_POS_HP_MP_SPD_BADSTATE_CP_MAGCOST_FALLTALENT"
	CASE "육성정보", "育成情報"
		RESULTS '= "NO_NAME_LV_ALI_SEX_POS_HP_MP_CP_LOYALTY_MAG_RACE"
	CASE "기본스테이터스", "기본스탯", "基本ステータス"
		RESULTS '= "NO_NAME_LV_ALI_SEX_POS_HP_MP_CP_BASESTATUS"
	CASE "방어상성1", "防御相性1"
		RESULTS '= "NO_NAME_LV_ALI_SEX_POS_HP_MP_CP_DEFTYPE1"
	CASE "방어상성2", "防御相性2"
		RESULTS '= "NO_NAME_LV_ALI_SEX_POS_HP_MP_CP_DEFTYPE2"
	CASEELSE
		CALLFORM %ARGS%
ENDSELECT

;--------------------------------------------------------------------------------
;基礎部分
;NO				キャラ登録番号
;NAME			キャラ名称
;SEX			性別
;FALLTALENT		陥落情報
;--------------------------------------------------------------------------------
;--------------------------------------------------------------------------------
;NO
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_NO_HEADER
INFO_HEADER += "　" + SET_BUTTON_TAG(TOALIGNMENT("No", 5, "CENTER"), "SORT,NO")

@GET_VAR_INFO_DATA_NO, ARG
LOCAL = EQUALCHECK_TURN(1,ARG == TARGET,ARG == ASSI,ISASSI:ARG == 1,CFLAG:ARG:매각가능 == 2)
RESULTS = %AUTO_SPLIT("　,☆,★,●,○",",",LOCAL)%
RESULTS += @"[{ARG,3}]"
IF TFLAG:전투중
	SIF CFLAG:ARG:PT플래그 == 0
		INFO_COLOR = 0x990000
	SIF (CFLAG:ARG:PT플래그 == 0 && CPOS(ARG) < 1) || CFLAG:ARG:피소환플래그
		INFO_COLOR = 0x404040
ENDIF

@GET_INFO_SORT_KEY_NO, ARG, ARGS
RETURN ARG
;--------------------------------------------------------------------------------
;NAME
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_NAME_HEADER
;UNICODEの配列だと漢字が安定しなさすぎるのでデバッグモード用にしておく
IF IS_DEBUG
	INFO_HEADER += SET_BUTTON_TAG(TOALIGNMENT("NAME", 18, "CENTER"), "SORT,NAME")
ELSE
	INFO_HEADER += SET_BUTTON_TAG(TOALIGNMENT("NAME", 18, "CENTER"), "SORT,NO")
ENDIF

@GET_VAR_INFO_DATA_NAME, ARG
RESULTS = %MAKE_INFO_DATA_NAME(CALLNAME:ARG)%
IF TFLAG:전투중
	SIF CFLAG:ARG:PT플래그 == 0
		INFO_COLOR = 0x990000
	SIF (CFLAG:ARG:PT플래그 == 0 && CPOS(ARG) < 1) || CFLAG:ARG:피소환플래그
		INFO_COLOR = 0x404040
ENDIF

@MAKE_INFO_DATA_NAME, L_NAME, L_ALIGNMENT = "LEFT"
#FUNCTIONS
#DIMS DYNAMIC L_NAME
#DIMS DYNAMIC L_ALIGNMENT
IF STRLENS(L_NAME) <= 18
	L_NAME '= TOALIGNMENT(L_NAME, 18, L_ALIGNMENT)
ELSE
	L_NAME '= SUBSTRING(L_NAME, 0, 16)
	SIF STRLENS(L_NAME) != 16
		L_NAME '= SUBSTRING(L_NAME, 0, 15) + "."
	L_NAME += ".."
ENDIF
RETURNF L_NAME

@GET_INFO_SORT_KEY_NAME, ARG, ARGS
;ソートのカウントをずらして昇順が先に来るようにする
SIF !INFO_CNT_SORT
	INFO_CNT_SORT = 1
RETURN ENCODETOUNI(CALLNAME:ARG)

;--------------------------------------------------------------------------------
;SEX
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_SEX_HEADER
INFO_HEADER += SET_BUTTON_TAG("SEX", "SORT,SEX")

@GET_VAR_INFO_DATA_SEX, ARG
IF TALENT:ARG:남자
	INFO_COLOR = 0x008B8B
ELSEIF TALENT:ARG:처녀 || TALENT:ARG:재생처녀
	INFO_COLOR = 0xCC0000
ELSE
	INFO_COLOR = 0x660022
ENDIF
IF TALENT:ARG:임신
	INFO_COLOR = 0xCC33FF
	RESULTS '= " 임"
ELSEIF TALENT:ARG:육아중
	INFO_COLOR = 0x00ffe0
	RESULTS '= " 육"
ELSEIF TALENT:ARG:부정형 || TALENT:ARG:이형 || TALENT:ARG:오토코노코 || TALENT:ARG:후타나리
	RESULTS '= " ？"
ELSE
	IF TALENT:ARG:남자
		RESULTS '= " ♂"
	ELSE
		RESULTS '= " ♀"
	ENDIF
ENDIF
@GET_INFO_SORT_KEY_SEX, ARG, ARGS
RESULT:1 = 1
IF TALENT:ARG:부정형 || TALENT:ARG:이형 || TALENT:ARG:오토코노코 || TALENT:ARG:후타나리
	RETURN INFO_CNT_SORT % 3
ELSE
	IF TALENT:ARG:남자
		RETURN (INFO_CNT_SORT + 1) % 3
	ELSE
		RETURN (INFO_CNT_SORT + 2) % 3
	ENDIF
ENDIF
RETURN ENCODETOUNI(CALLNAME:ARG)
;--------------------------------------------------------------------------------
;FALLTALENT(陥落情報)
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_FALLTALENT_HEADER
INFO_HEADER += SET_BUTTON_TAG(TOALIGNMENT("함락", 4, "CENTER"), "SORT,FALLTALENT")

@GET_VAR_INFO_DATA_FALLTALENT, ARG
#DIM DYNAMIC TEMP
TEMP = EQUALCHECK_TURN(1,TALENT:ARG:ＮＴＲ==1,TALENT:ARG:ＮＴＲ==2,TALENT:ARG:ＮＴＲ==3,TALENT:ARG:연모,TALENT:ARG:음란,TALENT:ARG:복종,TALENT:ARG:친애,TALENT:ARG:창부,TALENT:ARG:예속,TALENT:ARG:신뢰,TALENT:ARG:동료,TALENT:ARG:붕괴)
RESULTS '= TOALIGNMENT(AUTO_SPLIT("－,Ｎ,Ｎ,Ｎ,연모,음란,복종,친애,창부,예속,신뢰,동료,붕괴,",",",TEMP), 4, "CENTER")
@GET_INFO_SORT_KEY_FALLTALENT, ARG, ARGS
#DIM DYNAMIC TEMP,2
IF TALENT:ARG:ＮＴＲ
	TEMP = 1
ELSE
	IF 陥落(ARG)
		SELECTCASE RESULTS
			CASE "연모"
				TEMP = 5
			CASE "음란"
				TEMP = 4
			CASE "복종"
				TEMP = 3
			CASE "신뢰"
				TEMP = 2
		ENDSELECT
	ELSE
		TEMP = 0
	ENDIF
ENDIF
TEMP = ((TEMP + INFO_CNT_SORT) % 6) * 10 + 陥落(ARG)
RESULT:1 = 1
RETURN TEMP

;--------------------------------------------------------------------------------
;RPG要素
;LV					キャラクターのレベル
;POS				포지션
;STATE				バステ
;ALI				アライントメント
;HP
;MP
;CP
;충성도
;MAG		
;BASEONLYMAG		現在の所持MAGのみのMAG表示
;MAGCOST			召喚費用
;SPD				행동속도
;BASESTATUS			基本ステータス
;DEFTYPE1			防御相性前半
;DEFTYPE2			防御相性後半
;ANALYZE			解析度
;RACE				종족
;BELONG				所属COMP/サーバー
;--------------------------------------------------------------------------------
;--------------------------------------------------------------------------------
;LV
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_LV_HEADER
#DIMS DYNAMIC TEMPS
TEMPS '=  TOALIGNMENT("Lv", MAX(2, STRLENS(TOSTR(MAXCARRAY(BASE:0:LV)))), "CENTER")
INFO_HEADER += SET_BUTTON_TAG(TEMPS, "SORT,LV")

@GET_VAR_INFO_DATA_LV, ARG
RESULTS = {BASE:ARG:LV,MAX(2,STRLENS(TOSTR(MAXCARRAY(BASE:0:LV))))}
@GET_INFO_SORT_KEY_LV, ARG, ARGS
RETURN BASE:ARG:LV
;--------------------------------------------------------------------------------
;POS
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_POS_HEADER
INFO_HEADER += SET_BUTTON_TAG("POS", "SORT,POS")

@GET_VAR_INFO_DATA_POS, ARG
IF IS_JOINABLE_BATTLE(ARG)
	IF CFLAG:ARG:포지션
		RESULTS '= AUTO_SPLIT("   ,① ,② ,③ , ④, ⑤, ⑥,⑦ ,⑧ ,⑨ ,⑩ ,⑪ ,⑫ ,⑬ , ⑭, ⑮, ⑯, ⑰, ⑱, ⑲, ⑳",",",CFLAG:ARG:포지션)
	ELSE
		IF CFLAG:ARG:PT플래그
			RESULTS '= " ◯"
		ELSE
			RESULTS '= " " * 3
		ENDIF
	ENDIF
ELSE
	RESULTS '= " " * 3
ENDIF
IF TFLAG:전투중
	SIF CFLAG:ARG:PT플래그 == 0
		INFO_COLOR = 0x990000
	SIF (CFLAG:ARG:PT플래그 == 0 && CPOS(ARG) < 1) || CFLAG:ARG:피소환플래그
		INFO_COLOR = 0x404040
ENDIF
@GET_INFO_SORT_KEY_POS, ARG, ARGS
RESULT:1 = 1
SELECTCASE CFLAG:ARG:PT플래그
	CASE 2
		RETURN (7 - CPOS(ARG)) * 100
	CASE 1
		IF IS_JOINABLE_BATTLE(ARG)
			RETURN 50
		ELSE
			RETURN 2
		ENDIF
	CASE 0
		IF CPOS(ARG) > 0
			RETURN (50 - CPOS(ARG))
		ELSE
			RETURN 1
		ENDIF
ENDSELECT
;--------------------------------------------------------------------------------
;ALI
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_ALI_HEADER
INFO_HEADER += SET_BUTTON_TAG("ALI", "SORT,ALI")

@GET_VAR_INFO_DATA_ALI, ARG
IF INFO_COLOR_ALL
	RESULTS '= SUBSTRING(GET_ALI1(ABL:ARG:속성LD), 0, 1)
	RESULTS += "/"
	RESULTS += SUBSTRING(GET_ALI2(ABL:ARG:속성LC), 0, 1)
ELSE
	RESULTS '= SET_COLOR_TAG(SUBSTRING(GET_ALI1(ABL:ARG:속성LD), 0, 1), TOSTR(ALICOLOR(ABL:ARG:속성LD)))
	RESULTS += "/"
	RESULTS += SET_COLOR_TAG(SUBSTRING(GET_ALI2(ABL:ARG:속성LC), 0, 1), TOSTR(ALICOLOR(ABL:ARG:속성LC)))
ENDIF
@GET_INFO_SORT_KEY_ALI, ARG, ARGS
IF INFO_CNT_SORT % 4 > 1
	RETURN ABL:ARG:속성LD + ABL:ARG:속성LC * 10
ELSE
	RETURN ABL:ARG:속성LD * 10 + ABL:ARG:속성LC
ENDIF
;--------------------------------------------------------------------------------
;HP
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_HP_HEADER
#DIM DYNAMIC L_STRLENS
#DIMS DYNAMIC TEMPS
L_STRLENS = LIMIT(STRLENS(TOSTR(MAXCARRAY(MAXBASE:0:ＨＰ))), 4, 6)
TEMPS '=  TOALIGNMENT("HP", L_STRLENS * 2 + 3, "CENTER")
INFO_HEADER += SET_BUTTON_TAG(TEMPS, "SORT,HP")

@GET_VAR_INFO_DATA_HP, ARG
#DIM DYNAMIC L_STRLENS
L_STRLENS = LIMIT(STRLENS(TOSTR(MAXCARRAY(MAXBASE:0:ＨＰ))), 4, 6)
RESULTS = [%ADD_KMGT(BASE:ARG:ＨＰ,L_STRLENS)%/%ADD_KMGT(MAXBASE:ARG:ＨＰ,L_STRLENS)%] 
IF CFLAG:ARG:HP배리어
	INFO_COLOR = COLOR("パ緑")
ELSE
	;CHK:数値
	SELECTCASE 現HP割合(ARG) 
		;死亡
		CASE 0
			;赤(暗い赤)
			INFO_COLOR = COLOR("RED")
		;危険
		CASE IS < 25
			;赤(朱色?)
			INFO_COLOR = 0xcc6666
		;弱っている
		CASE IS < 50
			;黄色(オレンジ)
			INFO_COLOR = 0xffcc66
	ENDSELECT
ENDIF
@GET_INFO_SORT_KEY_HP, ARG, ARGS
RETURN BASE:ARG:ＨＰ


;--------------------------------------------------------------------------------
;MP
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_MP_HEADER
#DIM DYNAMIC L_STRLENS
#DIMS DYNAMIC TEMPS
L_STRLENS = LIMIT(STRLENS(TOSTR(MAXCARRAY(MAXBASE:0:ＭＰ))), 4, 6)
TEMPS '=  TOALIGNMENT("MP", L_STRLENS * 2 + 3, "CENTER")
INFO_HEADER += SET_BUTTON_TAG(TEMPS, "SORT,MP")

@GET_VAR_INFO_DATA_MP, ARG
#DIM DYNAMIC L_STRLENS
L_STRLENS = LIMIT(STRLENS(TOSTR(MAXCARRAY(MAXBASE:0:ＭＰ))), 4, 6)
IF MAXBASE:ARG:ＭＰ
	RESULTS = [%ADD_KMGT(BASE:ARG:ＭＰ, L_STRLENS)%/%ADD_KMGT(MAXBASE:ARG:ＭＰ, L_STRLENS)%]
	SELECTCASE 現MP割合(ARG) 
		;死亡
		CASE 0
			;赤(暗い赤)
			INFO_COLOR = COLOR("RED")
		;危険
		CASE IS < 25
			;赤(朱色?)
			INFO_COLOR = 0xcc6666
		;弱っている
		CASE IS < 50
			;黄色(オレンジ)
			INFO_COLOR = 0xffcc66
	ENDSELECT
ELSE
	RESULTS = %TOALIGNMENT("─", L_STRLENS * 2 + 3, "CENTER")%
ENDIF
@GET_INFO_SORT_KEY_MP, ARG, ARGS
RETURN BASE:ARG:ＭＰ

;--------------------------------------------------------------------------------
;SPD
