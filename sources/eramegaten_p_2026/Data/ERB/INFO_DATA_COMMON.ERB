;--------------------------------------------------------------------------------
;防御相性
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_BASESTATUS_HEADER
#DIM DYNAMIC LCOUNT
#DIM L_STRLENS
FOR LCOUNT, 1, BASESTATUSNUM
	INFO_HEADER += SET_BUTTON_TAG(TOALIGNMENT(GET_BASESTATUS(LCOUNT), 8, "CENTER"), @"SORT,BASESTATUS_%GET_BASESTATUS(LCOUNT)%")
	INFO_HEADER += INFO_SPACE
NEXT

@GET_VAR_INFO_DATA_BASESTATUS, ARG
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC TEMPS
RESULTS = 
FOR LCOUNT, 1, BASESTATUSNUM
	RESULTS += @"{MIN(MAXBASE:ARG:GET_BASESTATUS(LCOUNT), 999), 3}"
	RESULTS += "(" + @"{MIN(BASE:ARG:GET_BASESTATUS(LCOUNT), 999),3}" + ")"
	RESULTS += INFO_SPACE
NEXT

@GET_INFO_SORT_KEY_BASESTATUS, ARG, ARGS
RETURN MAXBASE:ARG:ARGS

;--------------------------------------------------------------------------------
;防御相性
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_DEFTYPE1_HEADER
CALL SET_VAR_INFO_DATA_DEFTYPE_HEADER, 0

@GET_VAR_INFO_DATA_DEFTYPE1, ARG
CALL GET_VAR_INFO_DATA_DEFTYPE, ARG, 0

@SET_VAR_INFO_DATA_DEFTYPE2_HEADER
CALL SET_VAR_INFO_DATA_DEFTYPE_HEADER, 1

@GET_VAR_INFO_DATA_DEFTYPE2, ARG
CALL GET_VAR_INFO_DATA_DEFTYPE, ARG, 1

@SET_VAR_INFO_DATA_DEFTYPE_HEADER, ARG
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_TYPENUM
#DIM L_STRLENS
FOR LCOUNT, 0, TYPENUM / 2
	;SIF LCOUNT
	;	INFO_HEADER += " "
	L_TYPENUM = LCOUNT + ARG * TYPENUM / 2
	INFO_HEADER += SET_BUTTON_TAG(TOALIGNMENT(GET_TYPE(L_TYPENUM), 6, "CENTER"), @"SORT,DEFTYPE,%GET_TYPE(L_TYPENUM)%")
NEXT

@GET_VAR_INFO_DATA_DEFTYPE, ARG, ARG:1
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_TYPENUM
#DIMS DYNAMIC TEMPS
RESULTS = 
FOR LCOUNT, 0, TYPENUM / 2
	SIF LCOUNT
		INFO_HEADER += " "
	L_TYPENUM = LCOUNT + ARG:1 * TYPENUM / 2
	SELECTCASE MAXBASE:ARG:GET_TYPE(L_TYPENUM)
		CASE 999
			TEMPS '= "반사"
		CASE 0
			TEMPS '= "무효"
		CASE IS < 0
			TEMPS '= TOSTR(MAXBASE:ARG:GET_TYPE(L_TYPENUM)) + "%"
		CASEELSE
			TEMPS '= TOSTR(ABS(MAXBASE:ARG:GET_TYPE(L_TYPENUM))) + "%"
	ENDSELECT
	TEMPS '= TOALIGNMENT(TEMPS, 6, "CENTER")		
	SIF !INFO_COLOR_ALL
		TEMPS '= SET_COLOR_TAG(TEMPS, GET_WEAKNESS(MAXBASE:ARG:(GET_TYPE(L_TYPENUM)))+"컬러")
	RESULTS += TEMPS
NEXT

@GET_INFO_SORT_KEY_DEFTYPE, ARG, ARGS
IF MAXBASE:ARG:ARGS == 999
	RETURN 1000000
ELSE
	RETURN 10000 - MAXBASE:ARG:ARGS
ENDIF

