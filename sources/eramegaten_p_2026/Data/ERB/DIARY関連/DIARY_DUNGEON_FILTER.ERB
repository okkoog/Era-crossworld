	;クリア済み
		RETURN 1
		;PRINTLC [ 2] 카루코자카고교
		;RESETCOLOR
	ELSE
	;出現しているが未クリア
		;PRINTLC [ 2] 카루코자카고교
	ENDIF
ELSE
;出現していない
	;SETCOLOR COLOR("gray")
	;PRINTLC [ 2] ???
	;RESETCOLOR
ENDIF

