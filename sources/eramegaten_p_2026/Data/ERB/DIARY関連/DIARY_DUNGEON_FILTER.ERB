;			IF LOCAL <= 63
;				CLEARBIT FLAG:217,(LOCAL)
;			ELSE
;				CLEARBIT FLAG:218,(LOCAL - 64)
;			ENDIF
;			LOCAL:99++
;		ENDIF
;	CATCH
;	ENDCATCH
;NEXT


