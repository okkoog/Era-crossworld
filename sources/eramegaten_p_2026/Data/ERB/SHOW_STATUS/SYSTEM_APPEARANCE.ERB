;-------------------------------------------------
;尻サイズ測定
;乳サイズ測定のほぼ丸々流用
;-------------------------------------------------
@CHECK_HIPSIZE, ARG
#DIM 変数S
#DIM 変数X
#DIM 変数Y
#DIM 変数Z
;Sは尻サイズ用変数、Xは尻補正値、Yはウェスト補正値、Zは身長補正値
変数X = ((((BASE:ARG:힙사이즈 * 100) - (BASE:ARG:신장 * 54)) * 100) / 250)
変数Y = ((((BASE:ARG:신장 * 38) - (BASE:ARG:웨스트 * 100)) * 100) / 342)
変数Z = ((((BASE:ARG:신장 * 100) - 15880) * 100) / 2300)
変数S = 変数X + 変数Y + 変数Z
変数S += 550
IF 変数S > 0
	;100未満を切り上げ
	変数S -= 変数S % 100
	変数S += 100
	;尻サイズ測定
	変数S = 変数S / 100
ENDIF

