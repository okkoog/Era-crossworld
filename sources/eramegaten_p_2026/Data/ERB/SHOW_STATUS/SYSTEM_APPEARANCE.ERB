@CHECK_CUPSIZE, ARG
#DIM TEMP
#DIM L_BUSTSIZE;胸の基準値	身長が低いほどカップサイズが大きく計算される
#DIM L_WAIST;ウェストの基準値　身長が低いほどカップサイズが大きく計算される
#DIM L_HEIGHT;身長の基準値
#DIM L_CUPSIZE;カップサイズの基準値
;妊娠中はMAXBASE:バストを判定に使う。ただし、未設定の可能性を考慮して最低でもBASEの値になるようにする
IF TALENT:ARG:임신 == 0 || (TALENT:ARG:육아중 && CFLAG:ARG:유모인가？ == 0)
	TEMP = BASE:ARG:바스트
ELSE
	TEMP = MAX(MAXBASE:ARG:바스트, BASE:ARG:바스트)
ENDIF
L_BUSTSIZE = ((((TEMP * 100) - (BASE:ARG:신장 * 54)) * 100) / 250)
L_WAIST = ((((BASE:ARG:신장 * 38) - (BASE:ARG:웨스트 * 100)) * 100) / 342)
L_HEIGHT = ((((BASE:ARG:신장 * 100) - 15880) * 100) / 2300)

;カップサイズ基準値は3種の基準値に基礎値550を加えて決定する
L_CUPSIZE = L_BUSTSIZE + L_WAIST + L_HEIGHT + 550

;カップサイズは基準値値の1/100(端数切り上げ)
CFLAG:ARG:컵수 = L_CUPSIZE / 100 + (L_CUPSIZE % 100 > 0)

;Sはカップサイズ用変数、Xはバスト補正値、Yはウェスト補正値、Zは身長補正値
;IF TALENT:ARG:임신 == 0 || (TALENT:ARG:육아중 && CFLAG:ARG:유모인가？ == 0)
;	X = ((((BASE:ARG:바스트 * 100) - (BASE:ARG:신장 * 54)) * 100) / 250)
;ELSE
;	X = ((((MAXBASE:ARG:바스트 * 100) - (BASE:ARG:신장 * 54)) * 100) / 250)
;ENDIF
;Y = ((((BASE:ARG:신장 * 38) - (BASE:ARG:웨스트 * 100)) * 100) / 342)
;妊娠時は妊娠発覚時のウェストから計算
;SIF TALENT:ARG:임신
;	Y = ((((BASE:ARG:신장 * 38) - (BASE:ARG:웨스트 * 100)) * 100) / 342)
	;Y = ((((BASE:ARG:신장 * 38) - ((BASE:ARG:웨스트 - (CFLAG:123 / 100)) * 100)) * 100) / 342)
	;↑のCFLAG:123が何の数字なのか不明なのでこの部分を仮で消す;後で分からなくなるから数字で書かないほうがいいよまじで
	;→たぶん別バリアントの名残と思われる。削除してしまってよさそうな気がする……ゾ……
;Z = ((((BASE:ARG:신장 * 100) - 15880) * 100) / 2300)
;S = X + Y + Z
