					ELSE
						L_TALENTNAME '= TALENTNAME:TEMP_TALENT
					ENDIF
			ENDSELECT
		ENDIF
		L_TALENTNAME '= "[" + L_TALENTNAME + "] " 
		MEMO_STR += STRLENS(L_TALENTNAME)
		IF MEMO_STR > LINELENS
