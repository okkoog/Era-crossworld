@SHOPCOMABLE_301
RESULT:1 = 3
RESULTS = 능력확인
RETURN CHARANUM > 0

@SHOP_COM_301, ARG, L_CHARA = -1
#LOCALSIZE 3
#DIM DYNAMIC L_CHARA
;P = 0
Z = 0
;表示させるキャラを抽出（Q:*に表示するキャラの登録番号、LOCAL:2に人数）
;CALL INPUT_CHARA_LIST("ステータスを表示させたいキャラを選んでください", "CASTING_SHOW_STATUS" , "UP_PRINT_SHOP_COM_301" , , "MODECHANGE_SHOP_COM_301", ,ARG)

;表示させるキャラを抽出（Q:*に表示するキャラの登録番号、LOCAL:2に人数）
{
CALL INPUT_CHARA_LIST
	, "조교/전투/육성정보/기본스탯/방어상성1/방어상성2"
	, "스테이터스를 표시하고 싶은 캐릭터를 선택해주세요"
	, "CASTING_SHOW_STATUS" 
	, "UP_PRINT_SHOP_COM_301"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "MODECHANGE_SHOP_COM_301"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, L_CHARA
}
;直表示が無限に続くので一度表示させて戻ってきた段階でフラグを折る
L_CHARA = -1
IF RESULT != 1000
	CALL SHOW_CHARADATA_PAGE(FLAG:SHOP커맨드 == [[ショップ:능력확인]] ? 1 # 2, RESULT:1)
	RESTART
ENDIF
RETURN 0

;---- EDIT 017 MOD START -------------------------
@CASTING_SHOW_STATUS(ARG:0)
;---- EDIT 027 MOD START -------------------------
;戦闘中は戦闘に参加できるキャラのみ
IF TFLAG:전투중 || (FLAG:SHOP커맨드 == [[ショップ:탐색]] && !SHOW_ST_HOME_MEMBER)
	SIF !IS_JOINABLE_BATTLE(ARG:0)
		RETURN 0
ENDIF
;---- EDIT 027 MOD END ---------------------------
;敵の場合は条件を追加
IF CFLAG:(ARG:0):PT플래그 == 0 && !IS_DEBUG
	SIF !CAN_SHOW_ENEMY_TYPE(ARG:0)
		RETURN 0
	;ボスはステータスを見れない
	SIF CFLAG:(ARG:0):보스플래그
		RETURN 0
ENDIF
;SIF FLAG:SHOP커맨드 == [[ショップ:탐색]] && (CFLAG:(ARG:0):소속ＣＯＭＰ == -1 || ABL:(ARG:0):종족 == 0) && CFLAG:(ARG:0):PT플래그 == 1
;	RETURN 0
;SIF IS_RENTING(ARG:0) && (FLAG:SHOP커맨드 != [[ショップ:능력확인]])
;	RETURN 0
SIF CFLAG:(ARG:0):이자리에없는플래그 == 1
	RETURN 0
SIF CFLAG:(ARG:0):필터링플래그
	RETURN 0
SIF Z == 1 && !陥落(ARG:0)
	RETURN 0
SIF Z == 2 && !CFLAG:(ARG:0):노역플래그
	RETURN 0
SIF Z == 3 && CFLAG:(ARG:0):매각가능 && !CFLAG:(ARG:0):매각불가플래그
	RETURN 0
RETURN 1

;単にステータスを見るだけでなく、戦闘のメイン画面での相性表示にもかかわる
@CAN_SHOW_ENEMY_TYPE, ARG
#FUNCTION
;解析度が不足している場合はステータスを見れない
;---- EDIT P 003 MOD START -------------------------
SIF ANALYSIS_RATE:(NO:ARG) < ANALYSIS_COMPLETED
	RETURNF 0
;SIF FLAG:(20000+NO:(ARG:0)) < 100
;	RETURNF 0
;---- EDIT P 003 MOD END ---------------------------
;---- EDIT 032 MOD START -------------------------
;SIF CFLAG:ARG:애널라이즈불가
SIF CFLAG:ARG:애널라이즈불가
	RETURNF 0
;---- EDIT 032 MOD END ---------------------------
;マインドシーカーの効果中は見れない
SIF SOFT_ON("마인드시커")
	RETURNF 0
;PTにサマナーあるいはハイアナライズの持ち主が必要
SIF (!NUM_SUMMONER(1) && !NUM_HAVESKILL([[스킬:하이・애널라이즈]]))
	RETURNF 0
RETURNF 1
;---- EDIT 017 MOD END ---------------------------

@UP_PRINT_SHOP_COM_301
PRINTFORML 스테이터스를 표시하고 싶은 캐릭터를 선택해주세요　\@ FINDELEMENT(Q, -1) > リスト表示数() ? ＜page.{P + 1}/{FINDELEMENT(Q, -1) / リスト表示数() + 1}＞ # \@
DRAWLINE
PRINTL 　　　☆:조교중 ★:조수 ○:조수가능 ●:원조수

@MODECHANGE_SHOP_COM_301 , ARG
SELECTCASE ARG
	CASE -1
		PRINTL 
		PRINTFORMLC [1010]전원
		PRINTFORMLC [1011]함락
		PRINTFORMLC [1012]노역중
		PRINTFORMLC [1013]매각불가
		;---- EDIT 027 ADD START -------------------------
		IF !TFLAG:전투중 && FLAG:SHOP커맨드 == [[ショップ:탐색]]
			IF SHOW_ST_HOME_MEMBER
				PRINTFORMLC [1014]대기 동료마 비표시
			ELSE
				PRINTFORMLC [1014]대기 동료마 표시
			ENDIF
		ENDIF
		;---- EDIT 027 ADD END ---------------------------
	CASE 1010 TO 1013
		Z = ARG - 1010
		RETURN ARG , -1
	;---- EDIT 027 ADD START -------------------------
	CASE 1014
		IF !TFLAG:전투중 && FLAG:SHOP커맨드 == [[ショップ:탐색]]
			SHOW_ST_HOME_MEMBER = !SHOW_ST_HOME_MEMBER
			RETURN ARG , -1
		ENDIF
	;---- EDIT 027 ADD END ---------------------------
ENDSELECT
RETURN ARG , 1


;-------------------------------------------------
;ステータス表示(各キャラごと)
;
;ARG:0 = 表示ページ
;ARG:1 = リストの登録キャラ数
;
;PAGE 1 = 調教ステータス
;PAGE:2 = RPGステータス
;PAGE:3 = キャラ解説
;PAGE:4 = MASTER:ゲーム履歴　SLAVE:NTR時の感情リスト
;-------------------------------------------------
@SHOW_CHARADATA_PAGE, ARG, ARG:1
#LOCALSIZE 6
#DIM LCNT
#DIM L_LINE, 4
#DIM L_RESULT
#DIM STOCK_REDRAW
#DIM STOCK_RESULT
#DIM LCOUNT
#DIMS ABLE_LIST
#DIM L_SKILL
#DIM LSKILLP,2
#DIM L_PAGE
#DIM PAGE_NUM
#DIM LIST_NO
#DIM LIST_NUM

L_PAGE = ARG							;ページ判別はL_PAGEで
U = RESULT								;表示するキャラ番号
LIST_NO = FINDELEMENT(Q, RESULT)		;リストの何人目かをLIST_NOに保存
LIST_NUM = ARG:1						;リストは何人分あるかをLIST_NUMに保存
L_LINE:1 = LINECOUNT					;現在の行数をL_LINE:1に保存、$PRINT_PAGEに戻るときにCLEARLINE LINECOUNT - L_LINE:1
SHOW_PAGE_MAXLINE = L_LINE:1 + SHOW_PAGE_MAXLINE_NUM
STOCK_REDRAW = CURRENTREDRAW()
STOCK_RESULT = RESULT
装備スキルページ = 0

REDRAW 2

$PRINT_PAGE
;---- EDIT 021 ADD START ---------------------------
;表示前にステータス同期を毎回行う
CALL SET_LEADER_SKILL
CALL SYNC_STATUS, U, "HPMP割合保持"
;---- EDIT 021 ADD END -----------------------------
CLEARLINE LINECOUNT - L_LINE:1
;味方でない場合、赤表示。またページ総数をへらす
IF CFLAG:U:PT플래그 == 0
	SETCOLOR 0x66EEEE
	PAGE_NUM = 3
	L_PAGE = MIN(L_PAGE, PAGE_NUM)
ELSE
	PAGE_NUM = 5
ENDIF
CUSTOMDRAWLINE =
CALL SHOW_INFO_NAME
CALLFORM SHOW_INFO_PAGE_{L_PAGE}
WHILE LINECOUNT < SHOW_PAGE_MAXLINE
	PRINTL 
WEND
RESETCOLOR
ABLE_LIST = /1007/1000/1009/

PRINTLC [1007]이전페이지
PRINTLC   [1000]리스트로 돌아간다
PRINTLC [1009]다음페이지
;PRINTFORMLC \@ L_PAGE == 4 ? %" " * 16% # [1009]다음페이지\@
;IF L_PAGE == 2 && (TALENT:U:데빌시프터 || TALENT:U:식노)
IF GROUPMATCH(L_PAGE, 2, 4) && GET_ROLE_PROP("CAN_USE_TRANS", U)
	ABLE_LIST += "1015/1016/"
	IF CFLAG:U:악마변신 == 0
		PRINTFORMLC [1015]악마변신
	ELSEIF CFLAG:U:악마변신 == 1
		PRINTFORMLC [1015]변신해제
	ENDIF
	;---- EDIT 012 ADD START -------------------------
	PRINTFORMLC [1016]자동변신
	;---- EDIT 012 ADD END   -------------------------
ENDIF
;顔グラ設定
IF L_PAGE == 3
	RESULT = 0
	ABLE_LIST += "1025/"
	PRINTFORMLC [1025]얼굴그래픽설정
	; -KR- CSTR동기화 추가
	ABLE_LIST += "1050/"
	PRINTFORMLC [1050]CSTR동기화
	;---- EDIT 030 MOD END ---------------------------
ENDIF
IF L_PAGE == 1 && MASTER != U
	IF GET_ROLE_PROP("CAN_USE_WEAPON_MASTERY", U)&& GROUPMATCH(FLAG:SHOP커맨드 , [[ショップ:셋업]] , [[ショップ:능력확인]])
		IF TALENT:U:도술 || TALENT:U:팬서 || TALENT:U:궁술 || TALENT:U:검술 || TALENT:U:창술 || TALENT:U:도끼술 || TALENT:U:채찍술 || TALENT:U:투척술 || TALENT:U:제사 || TALENT:U:봉술 || TALENT:U:마샬아츠
			ABLE_LIST += "1005/"
			PRINTFORMLC [1005]무기소질변경
		ENDIF
	ENDIF
ENDIF
PRINTL 
;PRINTFORMLC \@(LIST_NO == 0) ? %" " * 16% # [1001]이전캐릭터\@
ABLE_LIST += "1001/1003/"
PRINTFORMLC [1001]이전캐릭터
PRINTFORMLC   %" " * 18%
PRINTFORMLC [1003]다음캐릭터
;PRINTFORMLC \@(LIST_NO == LIST_NUM-1) ? %" " * 16% # [1003]다음캐릭터\@
IF L_PAGE == 3
	IF FLAG:화상에디트설정 == 0 && GETCONFIGS("描画インターフェース") != "WINAPI"
		ABLE_LIST += "1030/"
		PRINTFORMLC [1030]화상편집
	ENDIF
ENDIF
IF L_PAGE == 2 && !TFLAG:전투중
	RESULT = 0
	FOR LCOUNT, 0, CHARA_SKILLCOUNT(U)
		SIF !ABL:U:@"스킬{LCOUNT + 1}"
			CONTINUE
		RESULT = 1
	NEXT
	IF RESULT
		ABLE_LIST += "1020/"
		PRINTFORMLC [1020]스킬정렬교체
	ELSE
		PRINTFORMLC %" " * 16%
	ENDIF
ENDIF
IF L_PAGE == 2 && IS_DEBUG
	ABLE_LIST += "1040/"
	PRINTFORMLC [1040]레벨업
ENDIF
$INPUT_LOOP_2
INPUTS
;-------------------------------------------------
;範囲で指定しているものはRESULTSを変換する
;-------------------------------------------------
SELECTCASE L_PAGE
	CASE 2
		IF INRANGE(TOINT(RESULTS), 1, CHARA_SKILLCOUNT(U))
			IF ABL:U:@"스킬{TOINT(RESULTS)}"
				L_SKILL = ABL:U:@"스킬{TOINT(RESULTS)}"
				RESULTS = スキル解説
			ENDIF
		ENDIF
		IF INRANGE(TOINT(RESULTS), 21, 41)
			IF ABL:U:@"장비스킬{TOINT(RESULTS) - 20}"
				L_SKILL = ABL:U:@"장비스킬{TOINT(RESULTS) - 20}"
				RESULTS = スキル解説
			ENDIF
		ENDIF
		IF INRANGE(TOINT(RESULTS), 50, 56) && !TFLAG:전투중
			L_RESULT = TOINT(RESULTS) - 50
			RESULTS = 装備変更
		ENDIF
		;---- EDIT P 002 ADD START -------------------------
		IF INRANGE(TOINT(RESULTS), 60, 62) && !TFLAG:전투중
			L_RESULT = TOINT(RESULTS) - 60
			RESULTS = 神意変更
		ENDIF
		;---- EDIT P 002 ADD END ---------------------------
		;---- EDIT P 005 ADD START -------------------------
		;習得スキルリストの表示
		IF RESULTS == "19" && CFLAG:U:PT플래그 > 0
			CALL 習得予定スキルウィンドウ , U, RESULTS, "参照確認"
			SIF RESULT
				RESULTS = 習得スキル一覧
		ENDIF
		;---- EDIT P 005 ADD END ---------------------------
		;IF INRANGE(TOINT(RESULTS), 4000, 4999)
		;	L_RESULT = TOINT(RESULTS)
		;	RESULTS = リンケージ解説
		;ENDIF
	CASE 4
		IF INRANGE(TOINT(RESULTS), 2000, 2010)
			L_RESULT = TOINT(RESULTS) - 2000
			RESULTS = 特性解説ページ
		ENDIF
ENDSELECT
;数字以外の文字列をまず処理する
SELECTCASE L_PAGE
	CASE 2
		SELECTCASE RESULTS
			CASE "スキル解説"
				SIF FLAG:스킬속성표시설정 == 1
					CALL SKILL_EXPLAIN_PERFORMANCE, L_SKILL, U
				CALL GET_SKILL_PROP, "SKILL_EXPLAIN", L_SKILL, U
				WAIT
			CASE "装備変更"
				;---- EDIT 020 MOD START -------------------------に
				IF GET_ROLE_PROP("CAN_USE_EQUIP", U)
					$EQUIPMENT
					;---- EDIT 036 MOD START -------------------------
					CALL CASTING_EQUIPMENT, U
					IF RESULT
						IF GETBIT(FLAG:스테이터스화면타입, 2)
							CALL EQUIP_CHANGE, L_RESULT, U, 1
						ELSE
							CALL EQUIPMENT, U , L_RESULT
						ENDIF
						;ステータス参照用リスト作り直し
						VARSET Q , -1
						FOR LCOUNT, 0, CHARANUM
							CALL CASTING_SHOW_STATUS(LCOUNT)
							SIF RESULT
								Q:FINDELEMENT(Q, -1) = LCOUNT
						NEXT
						装備スキルページ = 0
					ENDIF
					;---- EDIT 036 MOD END ---------------------------
				ELSE
					;銃の場合、装備の処理に飛ばす
					IF L_RESULT == 1
						SIF GET_ROLE_PROP("CAN_EQUIP_GUN", U)
							GOTO EQUIPMENT
					ENDIF
					IF L_RESULT == 6
						SIF GET_ROLE_PROP("CAN_USE_PLUGIN", U)
							CALL CHANGE_PLUGIN_SOFT, U
					ENDIF
				ENDIF
				;---- EDIT 020 MOD END ---------------------------に
			;---- EDIT P 002 ADD START -------------------------
			CASE "神意変更"
				IF !TFLAG:전투중 && C_EQUIPED_KAMUI:U:L_RESULT != ""
					;仮実装で説明を出す
					VARSET RESULTS
					TRYCCALLFORM KAMUI_EXPLAIN_%C_EQUIPED_KAMUI:U:L_RESULT%
						FOR LCOUNT, 0, 5
							SIF RESULTS:LCOUNT == ""
