			MEMO_STR = STRLENS(L_TALENTNAME) + 7
		ENDIF
		IF L_TITLE == ""
			CALL GET_TALENT_EXPLAIN, TEMP_TALENT
			L_TITLE = %RESULTS%
		ENDIF
		L_TALENTNAME = <nonbutton title = '%L_TITLE%'>%L_TALENTNAME%</nonbutton>
		IF LCOUNT:1 >= 0
			SIF FLAG:이신합체표시 && U == CHARANUM - 1 && !CSVTALENT(NO:U, TEMP_TALENT, 0) && TALENTNAME:TEMP_TALENT != "스킬적성"
