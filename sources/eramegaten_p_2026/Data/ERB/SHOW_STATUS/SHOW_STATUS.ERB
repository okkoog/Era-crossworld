FOR LCOUNT, 1, VARSIZE("CNT_TALENT_CATEGORY")
	SIF !CNT_TALENT_CATEGORY:LCOUNT
		CONTINUE
	SHOW_LINE = 
	SIF FLAG:커스텀게임화면
		SHOW_LINE += "　　"
	SHOW_LINE += TALENT_CATEGORY:LCOUNT + "："
	MEMO_STR = STRLENS(SHOW_LINE)
	FOR LCOUNT:1, -NON_TALENT_FEATURE:LCOUNT, CNT_TALENT_CATEGORY:LCOUNT
		L_TITLE =
		;---- EDIT ADD 030 START ------------------------- 
		L_TALENTNAME = 
		;---- EDIT ADD 030 END ---------------------------
		IF LCOUNT:1 < 0
			SELECTCASE TALENT_CATEGORY:LCOUNT
				CASE "자질"
					SELECTCASE LCOUNT:1
						CASE -2
							SIF !GET_ROLE_PROP("CAN_USE_TRANS", U)
								CONTINUE
							L_TALENTNAME = %AUTO_SPLIT(GETS_ROLE_PROP("CAN_USE_TRANS", U), "/", 0)%
							L_TITLE = %AUTO_SPLIT(GETS_ROLE_PROP("CAN_USE_TRANS", U), "/", 1)%
						CASE -1
							SIF !GET_ROLE_PROP("CAN_USE_LINK", U)
								CONTINUE
							L_TALENTNAME = %AUTO_SPLIT(GETS_ROLE_PROP("CAN_USE_LINK", U), "/", 0)%
							L_TITLE = %AUTO_SPLIT(GETS_ROLE_PROP("CAN_USE_LINK", U), "/", 1)%
					ENDSELECT
			ENDSELECT
		ELSE
			TEMP_TALENT = HAVE_TALENT_LIST:LCOUNT:(LCOUNT:1)
			SELECTCASE TALENTNAME:TEMP_TALENT
				CASE "유아／유아퇴행"
					IF MARK:U:6 >= 1
						L_TALENTNAME = 幼児
					ELSE
						L_TALENTNAME = 幼児退行
					ENDIF
				CASE "소년／소녀"
					IF IS_MALE(U)
						L_TALENTNAME = 소년
					ELSE
						L_TALENTNAME = 소녀
					ENDIF
				CASE "마유"
					IF ABL:U:종족 == 1 || ABL:U:종족 == 2
						L_TALENTNAME = 神乳
					ELSEIF ABL:U:속성LC == 1 || ABL:U:속성LD == 1
						L_TALENTNAME = 聖乳
					ELSEIF ABL:U:속성LD == 3 || ABL:U:속성LC == 3
						L_TALENTNAME = 마유
					ELSE
						L_TALENTNAME = 超乳
					ENDIF
				CASE "魔尻"
					IF ABL:U:종족 == 1 || ABL:U:종족 == 2
						L_TALENTNAME =神尻 
					ELSEIF ABL:U:속성LC == 1 || ABL:U:속성LD == 1
						L_TALENTNAME = 聖尻
					ELSEIF ABL:U:속성LD == 3 || ABL:U:속성LC == 3
						L_TALENTNAME = 魔尻
					ELSE
						L_TALENTNAME = 超尻
					ENDIF
				CASE "포동포동"
					SELECTCASE TALENT:U:TEMP_TALENT
						CASE 1
							L_TALENTNAME = 포동포동
						CASE 2
							L_TALENTNAME = 肥満
					ENDSELECT
				;---- EDIT 031 MOD START -------------------------
				;光り方とタイプとサイズは同時に扱う, 
				CASE "페니스발광도"
					CONTINUE
				CASE "페니스타입"
					CONTINUE
				CASE "페니스사이즈"
					IF TALENT:U:페니스사이즈 == 0 && TALENT:U:페니스타입
						SELECTCASE TALENT:U:페니스발광도
							CASE 1
								L_TALENTNAME = 빛나는 고추
							CASE 2
								L_TALENTNAME = 게이밍 고추
						ENDSELECT
					ELSEIF TALENT:U:페니스사이즈 == 0
						IF TALENT:U:페니스발광도 == 1
							L_TALENTNAME += "빛나는 "
						ELSEIF TALENT:U:페니스발광도 == 2
							L_TALENTNAME += "게이밍 "
						ENDIF
						SELECTCASE TALENT:U:페니스타입
							CASE 1
								L_TALENTNAME += "매지컬 "
							CASE 2
								L_TALENTNAME += "부드러운 "
							CASE 3
								L_TALENTNAME += "다정한 "
							CASE -1
								L_TALENTNAME += "돌기달린 "
							CASE -2
								L_TALENTNAME += "가시달린 "
							CASE -3
								L_TALENTNAME += "진주박힌 "
							CASE -4
								L_TALENTNAME += "마라 "
							CASEELSE
								L_TALENTNAME += "보통 "
						ENDSELECT
						L_TALENTNAME += "고추"
					ELSEIF TALENT:U:페니스타입 == 0
						IF TALENT:U:페니스발광도 == 1
							L_TALENTNAME += "빛나는 "
						ELSEIF TALENT:U:페니스발광도 == 2
							L_TALENTNAME += "게이밍 "
						ENDIF
						SELECTCASE TALENT:U:페니스사이즈
							CASE 1
								L_TALENTNAME += "미성숙 "
							CASE 2
								L_TALENTNAME += "단소 "
							CASE 3
								L_TALENTNAME += "보통 "
							CASE 4
								L_TALENTNAME += "거근 "
							CASE 5
								L_TALENTNAME += "말자지 "
							CASEELSE
								L_TALENTNAME += "보통 "
						ENDSELECT
						L_TALENTNAME += "고추"
					ELSE
						IF TALENT:U:페니스발광도 == 1
							L_TALENTNAME += "빛나는 "
						ELSEIF TALENT:U:페니스발광도 == 2
							L_TALENTNAME += "게이밍 "
						ENDIF
						SELECTCASE TALENT:U:페니스타입
							CASE 1
								L_TALENTNAME += "매지컬 "
							CASE 2
								L_TALENTNAME += "부드러운 "
							CASE 3
								L_TALENTNAME += "다정한 "
							CASE -1
								L_TALENTNAME += "돌기달린 "
							CASE -2
								L_TALENTNAME += "가시달린 "
							CASE -3
								L_TALENTNAME += "진주박힌 "
							CASE -4
								L_TALENTNAME += "마라 "
							CASEELSE
								L_TALENTNAME += "보통 "
						ENDSELECT
						SELECTCASE TALENT:U:페니스사이즈
							CASE 1
								L_TALENTNAME += "미성숙 "
							CASE 2
								L_TALENTNAME += "단소 "
							CASE 3
								L_TALENTNAME += "보통 "
							CASE 4
								L_TALENTNAME += "거근 "
							CASE 5
								L_TALENTNAME += "말자지 "
							CASEELSE
								L_TALENTNAME += "보통 "
						ENDSELECT
						L_TALENTNAME += "고추"
					ENDIF
				;---- EDIT 031 MOD END ---------------------------
				CASE "ＮＴＲ"
					SELECTCASE TALENT:U:TEMP_TALENT
						CASE 1
							L_TALENTNAME = 애ＮＴＲ
						CASE 2
							L_TALENTNAME = 음ＮＴＲ
						CASE 3
							L_TALENTNAME = 예ＮＴＲ
					ENDSELECT
				CASE "전력상실"
					L_TALENTNAME '= SET_COLOR_TAG("전력상실", "red")
				CASEELSE
					IF GET_SUB_ROLE_NUM(TALENTNAME:TEMP_TALENT) >= 0
						L_TALENTNAME = %GETS_SUB_ROLE_PROP("NAME", TALENTNAME:TEMP_TALENT, U)%
					ELSEIF INRANGE(TEMP_TALENT, GETNUM(TALENT, "캐릭터고유소질"), GETNUM(TALENT, "캐릭터고유소질4"))
						VARS TEMPS, 10
						SPLIT CSTR:U:@"캐릭터고유소질정의{TEMP_TALENT - GETNUM(TALENT, "캐릭터고유소질")}", "/", TEMPS
