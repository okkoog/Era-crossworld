	CALL GET_TALENT_EXPLAIN, 139
	SHOW_LINE += @"<nonbutton title = '%RESULTS%'>" + @"[%TALENTNAME:139%]" + "</nonbutton>" 
ELSEIF TALENT:U:157
	CALL GET_TALENT_EXPLAIN, 157
	SHOW_LINE += @"<nonbutton title = '%RESULTS%'>" + @"[%TALENTNAME:157%]" + "</nonbutton>" 
ELSEIF TALENT:U:140
	CALL GET_TALENT_EXPLAIN, 140
