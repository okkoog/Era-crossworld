		CNT_TALENT_CATEGORY:TEMP++
	ENDIF
NEXT

FOR LCOUNT, 0, 600
	;身体的特徴・継承タイプなど
	SIF INRANGE(LCOUNT, 301, 400)
		CONTINUE
	;---- EDIT 020 ADD START -------------------------
	;戦闘資質(戦闘系の素質+武器素質)
	IF IS_ROLE_TALENT(LCOUNT) || INRANGE(LCOUNT, 250, 260)
		;サブロールは変身してるかどうかで結果が変わる
		IF GET_SUB_ROLE_NUM(TALENTNAME:LCOUNT) >= 0
			SIF !GET_BTL_TALENT_LV(TALENTNAME:LCOUNT, U)
				CONTINUE
		;武器素質
		ELSEIF INRANGE(LCOUNT, 250, 260)
			SIF TALENT:U:LCOUNT == 0
				CONTINUE
			SIF !GET_ROLE_PROP("CAN_USE_WEAPON_MASTERY", U)
				CONTINUE
		ELSE
			SIF TALENT:U:LCOUNT == 0
				CONTINUE
		ENDIF
		TEMP = FINDELEMENT(TALENT_CATEGORY, "자질")
		HAVE_TALENT_LIST:TEMP:(CNT_TALENT_CATEGORY:TEMP) = LCOUNT
		CNT_TALENT_CATEGORY:TEMP++
		;H:LCOUNT = 1
		;H = LCOUNT + 1
		;どちらにしろ打ち切る
		CONTINUE
	ENDIF
	;---- EDIT 020 ADD END ---------------------------
	SIF TALENT:U:LCOUNT == 0
		CONTINUE
	;設定されていない素質は弾く
	SIF STRLENS(TALENTNAME:LCOUNT) == 0
		CONTINUE
	SELECTCASE LCOUNT
		;表示させない素質
		CASE 213 TO 219, 301 TO 319
		;性別
		CASE 0, 1, 139, 140, 157
			TEMP = FINDELEMENT(TALENT_CATEGORY, "성별")
			;処女のみはC:LCOUNTを用いない
			;SIF LCOUNT
			;	C:LCOUNT = TALENT:U:LCOUNT
			;C = LCOUNT + 1
		;性格
		CASE 10 TO 39, 63, 70, 71, 80 TO 89, 141, 155, 201 TO 212
			TEMP = FINDELEMENT(TALENT_CATEGORY, "성격")
			;D:LCOUNT = TALENT:U:LCOUNT
			;D = LCOUNT + 1
		;体質
		CASE 40 TO 45, 56, 57, 60 TO 62, 72, 90, 91, 100 TO 114, 116 TO 134, 138, 142, 143, 149 TO 151, 159, 175, 176, 231, 281, 282, 284, 290, 291
			TEMP = FINDELEMENT(TALENT_CATEGORY, "체질")
			;E:LCOUNT = TALENT:U:LCOUNT
			;E = LCOUNT + 1
		;技能
		CASE 50 TO 55, 64, 92 TO 95, 135, 136, 144, 146, 152, 156, 158
			TEMP = FINDELEMENT(TALENT_CATEGORY, "기능")
			;F:LCOUNT = TALENT:U:LCOUNT
			;F = LCOUNT + 1
		;後天素質
		CASE 3 TO 9, 73 TO 79, 115, 145, 153, 154, 160, 161, 162 TO 165, 170 TO 174, 180 TO 182, 196 TO 199, 270 TO 273
			TEMP = FINDELEMENT(TALENT_CATEGORY, "후천")
		;陥落履歴
		CASE 270 TO 273
			TEMP = FINDELEMENT(TALENT_CATEGORY, "이력")
			;K:LCOUNT = TALENT:U:LCOUNT
			;K = LCOUNT + 1
		CASE GETNUM(TALENT, "캐릭터고유소질") TO GETNUM(TALENT, "캐릭터고유소질4")
			TEMP = FINDELEMENT(TALENT_CATEGORY, AUTO_SPLIT(CSTR:U:@"캐릭터고유소질정의{LCOUNT - GETNUM(TALENT, "캐릭터고유소질")}", "/", 1))
			SIF TEMP == -1
				TEMP = FINDELEMENT(TALENT_CATEGORY, "미분류")			
		;分類していない素質（これがあるのは望ましくない）
		CASEELSE
			TEMP = FINDELEMENT(TALENT_CATEGORY, "미분류")
			;Z:LCOUNT = TALENT:U:LCOUNT
			;Z = LCOUNT + 1
	ENDSELECT
	HAVE_TALENT_LIST:TEMP:(CNT_TALENT_CATEGORY:TEMP) = LCOUNT
	CNT_TALENT_CATEGORY:TEMP++
NEXT

;IF C
SHOW_LINE =
SIF FLAG:커스텀게임화면
	SHOW_LINE += "　　"
