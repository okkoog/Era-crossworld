		ADDED_REALATON =
		VARSET RELATION_TABLE
		VARS RELATION_RANK_TABLE, 5
		RELATION_RANK_TABLE '= "상성_최고", "상성_발군", "상성_양호", "상성_불량", "상성_최악"
		;個別指定をまず追加
		FOR LCOUNT, 0, 5
			RELATION_TABLE:LCOUNT '= CSVCSTR(NO:U, GETNUM(CSTR, RELATION_RANK_TABLE:LCOUNT))
			ADDED_REALATON = %ADD_SPLIT(ADDED_REALATON, "/", RELATION_TABLE:LCOUNT)%
		NEXT
		VARI L_CHARA
		FOR LCOUNT, 1, 21
			SIF !CFLAG:U:@"캐릭터상성{LCOUNT}"
				CONTINUE
			L_CHARA = FINDCHARA_TIMEID(CFLAG:U:@"캐릭터상성{LCOUNT}")
			;存在しないキャラを指定している場合はクリア
			IF L_CHARA < 0
				CFLAG:U:@"캐릭터상성{LCOUNT}" = 0
				CFLAG:U:@"캐릭터상성치{LCOUNT}" = 0
				CONTINUE
			ENDIF
			SELECTCASE CFLAG:U:@"캐릭터상성치{LCOUNT}"
				CASE IS >= 200
					RELATION_TABLE:0 = %ADD_SPLIT(RELATION_TABLE:0, "/", "『" + CALLNAME:L_CHARA + "』")%
				CASE IS >= 150
					RELATION_TABLE:1 = %ADD_SPLIT(RELATION_TABLE:1, "/", "『" + CALLNAME:L_CHARA + "』")%
				CASE IS > 100
					RELATION_TABLE:2 = %ADD_SPLIT(RELATION_TABLE:2, "/", "『" + CALLNAME:L_CHARA + "』")%
				CASE 100
					CONTINUE
				CASE IS >= 75
					RELATION_TABLE:3 = %ADD_SPLIT(RELATION_TABLE:3, "/", "『" + CALLNAME:L_CHARA + "』")%
				CASEELSE
					RELATION_TABLE:4 = %ADD_SPLIT(RELATION_TABLE:4, "/", "『" + CALLNAME:L_CHARA + "』")%
			ENDSELECT
		NEXT
		;配偶者を最高に入れる
		IF CSVCSTR(NO:U, GETNUM(CSTR, "배우자")) != ""
			FOR LCOUNT, 0, STRCOUNT(CSVCSTR(NO:U, GETNUM(CSTR, "배우자")), "/") + 1
				TEMPS = %AUTO_SPLIT(CSVCSTR(NO:U, GETNUM(CSTR, "배우자")), "/", LCOUNT)%
				SIF COUNT_SPLIT(ADDED_REALATON, "/", TEMPS)
					CONTINUE
				RELATION_TABLE:0 = %ADD_SPLIT(RELATION_TABLE:0, "/", TEMPS)%
				ADDED_REALATON = %ADD_SPLIT(ADDED_REALATON, "/", TEMPS)%
			NEXT
		ENDIF
		VARS RELATION_TYPE_TABLE, 6
		RELATION_TYPE_TABLE '= "近親判定_父", "近親判定_母", "近親判定_兄弟", "近親判定_姉妹", "近親判定_娘", "近親判定_息子"
		FOR LCOUNT:1, 0, 6
			IF CSVCSTR(NO:U, GETNUM(CSTR, RELATION_TYPE_TABLE:(LCOUNT:1))) != ""
				FOR LCOUNT, 0, STRCOUNT(CSVCSTR(NO:U, GETNUM(CSTR, RELATION_TYPE_TABLE:(LCOUNT:1))), "/") + 1
					TEMPS = %AUTO_SPLIT(CSVCSTR(NO:U, GETNUM(CSTR, RELATION_TYPE_TABLE:(LCOUNT:1))), "/", LCOUNT)%
					SIF COUNT_SPLIT(ADDED_REALATON, "/", TEMPS)
						CONTINUE
					RELATION_TABLE:1 = %ADD_SPLIT(RELATION_TABLE:1, "/", TEMPS)%
					ADDED_REALATON = %ADD_SPLIT(ADDED_REALATON, "/", TEMPS)%
				NEXT
			ENDIF
		NEXT
		VARSET GROUP_RELATION
		IF CSTR:U:상성그룹 != ""
			FOR LCOUNT, 0, STRCOUNT(CSTR:U:상성그룹 , "/") + 1
				CALLFORMF GET_RELATION_GROUP, , , RELATION_GROUP_KR(AUTO_SPLIT(CSTR:U:상성그룹 , "/", LCOUNT)), 1
				FOR LCOUNT:1, 0, 5
					GROUP_RELATION:(LCOUNT:1) = %ADD_SPLIT(GROUP_RELATION:(LCOUNT:1), "/", RESULTS_F:(LCOUNT:1))%
				NEXT
			NEXT
		ENDIF
		FOR LCOUNT:1, 0, 5
			IF GROUP_RELATION:(LCOUNT:1) != ""
				FOR LCOUNT, 0, STRCOUNT(GROUP_RELATION:(LCOUNT:1), "/") + 1
					TEMPS = %AUTO_SPLIT(GROUP_RELATION:(LCOUNT:1), "/", LCOUNT)%
					SIF COUNT_SPLIT(ADDED_REALATON, "/", TEMPS)
						CONTINUE
					RELATION_TABLE:(LCOUNT:1) = %ADD_SPLIT(RELATION_TABLE:(LCOUNT:1), "/", TEMPS)%
					ADDED_REALATON = %ADD_SPLIT(ADDED_REALATON, "/", TEMPS)%
				NEXT
			ENDIF
		NEXT
		FOR LCOUNT, 0, 5
			IS_SHOWED = 0
			SHOW_LINE = 상성 %AUTO_SPLIT("☆/◎/◯/△/✕", "/", LCOUNT)%　　 :
			SPLIT RELATION_TABLE:LCOUNT, "/", TEMPS
			FOR LCOUNT:1, 0, RESULT
				SIF TEMPS:(LCOUNT:1) == ""
					CONTINUE
				;自分自身を指定している場合は飛ばす
				SIF CSVCALLNAME(NO:U) == TEMPS:(LCOUNT:1)
					CONTINUE
				SIF IS_SHOWED
					SHOW_LINE += ","
				IS_SHOWED = 1
				;「_」がある場合の表示調整
				SIF STRCOUNT(TEMPS:(LCOUNT:1), "_")
					TEMPS:(LCOUNT:1) '= AUTO_SPLIT(TEMPS:(LCOUNT:1), "_", 0) + "(" + AUTO_SPLIT(TEMPS:(LCOUNT:1), "_", 1) +")"
				IF (STRLENS(HTML_TOPLAINTEXT(SHOW_LINE)) + STRLENS(HTML_TOPLAINTEXT(TEMPS:(LCOUNT:1)))) >= LINELENS()
					HTML_PRINT SHOW_LINE
					SHOW_LINE = %" " * 14%
				ENDIF
				SHOW_LINE += CALLNAME_KR(TEMPS:(LCOUNT:1))
			NEXT
			;表示内容がなかった場合は消す
			SIF IS_SHOWED
				HTML_PRINT SHOW_LINE
		NEXT
	ENDIF
ENDIF
RETURN RESULT

