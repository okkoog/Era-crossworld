ELSE
	SHOW_LINE += @"<nonbutton title = '여자이다'>" + @"[여자] " + "</nonbutton>"
ENDIF
;処女だけはTALENTで判断
IF TALENT:U:처녀
	CALL GET_TALENT_EXPLAIN, , "처녀"
	LOCALS '= @"<nonbutton title = '%RESULTS%'>" + @"[%TALENTNAME:0%]" + "</nonbutton>"	
	SIF FLAG:이신합체표시 && U == CHARANUM - 1 && !CSVTALENT(NO:U, GETNUM(TALENT, "처녀"), 0)
