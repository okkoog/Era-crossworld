;ブロック配置数を求める
@CALC_BASESTASUS_BAR_PROP, CHARA, STAT, MAXW, WNDSIZE, 
#DIM CHARA
#DIM STAT
#DIM MAXW
#DIM WNDSIZE
#DIMS STATS
#DIM VAL, 4
STATS '= GET_BASESTATUS(STAT)
VAL:0 = MIN(MIN(MAXBASE:CHARA:(STATS) , BASE:CHARA:(STATS)) * WNDSIZE / MAXW, WNDSIZE) ;WHITEブロック
CALL EQUIP_MODIFY_VALUE, CHARA, STAT
VAL:1 = MIN(MAX(RESULT, 0) * WNDSIZE / MAXW, WNDSIZE - VAL:0) ;YELLOWブロック
VAL:2 = MIN(MAX(MAXBASE:CHARA:(STATS) - (BASE:CHARA:(STATS) + VAL:1) , 0) * WNDSIZE / MAXW, WNDSIZE - (VAL:0 + VAL:1)) ;AQUAブロック
VAL:3 = MIN(MAX(BASE:CHARA:(STATS) - MAXBASE:CHARA:(STATS) , 0) * WNDSIZE / MAXW, WNDSIZE - (VAL:0 + VAL:1)) ;GRAYブロック
RETURN VAL:0, VAL:1, VAL:2, VAL:3

@EQUIP_MODIFY_VALUE, CHARA, BASENUM
#DIM CHARA
#DIM BASENUM
#DIM LCOUNT
#DIM ITEMNO
#DIM VAL
VAL = 0
FOR LCOUNT, 0, 7
	ITEMNO = EQUIP:CHARA:GET_EQUIP(LCOUNT)
	IF ITEMNO > 0
		IF 魔晶装備(ITEMNO)
			CALL 基本能力修正_魔晶装備, BASENUM, CHARA
		ELSE
			CALLFORM 基本能力修正_{ITEMNO}, BASENUM, CHARA
		ENDIF
		VAL += RESULT
	ENDIF
NEXT
RETURN VAL


