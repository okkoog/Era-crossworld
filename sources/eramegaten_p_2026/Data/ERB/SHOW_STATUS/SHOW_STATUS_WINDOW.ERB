			CALL SET_PICTURE , @"%LOCALS:1 , 10%　공격력 {MAXBASE:ARG:(LOCALS:2 + "공격"),5}　공격횟수：{공격횟수}-{공격횟수:1}" , ARG:1+1 , , ARG:2 + 2
