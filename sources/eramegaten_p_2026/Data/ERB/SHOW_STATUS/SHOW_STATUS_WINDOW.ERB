		L_RESULTS += 装備の名称(変更予定装備:(ARG:1),ARG) + @",{COLOR("パ緑")}"
	ELSEIF EQUIP:ARG:GET_EQUIP(ARG:1) == 0
		L_RESULTS += "ＥＭＰＴＹ,0x404040"
