;=======================================
;装備品ウィンドウ
;=======================================
@STATUS_WINDOW_EQUIP , L_CHARA , 行 , 表示行数 , IS_EQUIP_CHANGE
#DIM DYNAMIC 横幅
#DIM DYNAMIC 色
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_LINE
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC 行
#DIM DYNAMIC 表示行数
#DIM DYNAMIC IS_EQUIP_CHANGE
横幅 = 42
TRYCCALLFORM STATUS_WINDOW_EQUIP_ROLE_%CSTR:L_CHARA:롤% , L_CHARA , 行, 表示行数, 横幅, IS_EQUIP_CHANGE
CATCH
	IF IS_EQUIP_CHANGE
		CALL SET_PICTURE , @"┏RACE%"━" * 8%┳NAME%"━" * 8%┓" , 行 , , 表示行数
		CALL SET_PICTURE , @"┃%종족명(L_CHARA) , 20 , LEFT%┃%CALLNAME:L_CHARA , 20 , LEFT%┃" , 行 + 1 , , 表示行数
		CALL SET_PICTURE , @"┣%"━" * ((横幅-2)/4 )%┻%"━" * ((横幅-2)/4 )%┫" , 行 + 2 , , 表示行数
		行 += 2
	ELSE
		SIF GET_ROLE_PROP("CAN_USE_EQUIP", L_CHARA) || GET_ROLE_PROP("CAN_USE_PLUGIN", L_CHARA) || GET_ROLE_PROP("CAN_EQUIP_GUN", L_CHARA)
			CALL SET_PICTURE , @"┏%"━" * (横幅 / 2)%┓" , 行, , 表示行数
	ENDIF
	IF GET_ROLE_PROP("CAN_USE_EQUIP", L_CHARA)
		CALL SET_PICTURE , @"EQUIP " , 行 , , 表示行数 + 2
		FOR LOCAL , 1 , 9
			CALL SET_PICTURE , @"┃%" " * 横幅%┃" , 行+LOCAL , , 表示行数
		NEXT
		CALL SET_PICTURE , @"┗%"━" * (横幅 / 2)%┛" , 行+9 , , 表示行数
		FOR LOCAL , 0 , 7
			CALL SET_PICTURE , GET_STATUS_WINDOW_EQUIP_NAME(L_CHARA, LOCAL, IS_EQUIP_CHANGE), 行 + 1 + LOCAL , , 表示行数+2
		NEXT
		CALL SET_PICTURE , GET_STATUS_WINDOW_EQUIP_NAME(L_CHARA, GET_EQUIPNUM("탄환"), IS_EQUIP_CHANGE), 行 + 1 + LOCAL , , 表示行数+2
	ELSE
		L_LINE = 行
		;プラグインを使用可能
		IF GET_ROLE_PROP("CAN_USE_PLUGIN", L_CHARA)
			CALL SET_PICTURE , @"PLUGIN" , L_LINE, , 表示行数 + 2
			CALL SET_PICTURE , @"┃%" " * 横幅%┃" , L_LINE+1 , , 表示行数
			CALL SET_PICTURE , @"┗%"━" * (横幅 / 2)%┛" , L_LINE+2 , , 表示行数

			IF IS_EQUIP_CHANGE && 変更予定装備:6 > -1
				CALL SET_PICTURE , @"_[56][%PLUGINNAME(変更予定装備:6)%],{COLOR("パ緑")},,56_" , L_LINE+1 , , 表示行数 + 2
			ELSEIF EQUIP:L_CHARA:악세서리
				CALL SET_PICTURE , @"_[56][%PLUGINNAME(EQUIP:L_CHARA:악세서리)%],,,56_" , L_LINE+1 , , 表示行数 + 2
			ELSE
				CALL SET_PICTURE , @"_[56][----------],,,56" , L_LINE+1 , , 表示行数 + 2
			ENDIF
			L_LINE += 3
		ENDIF
		IF GET_ROLE_PROP("CAN_EQUIP_GUN", L_CHARA)
			CALL SET_PICTURE , @"┏%"━" * (横幅 / 2)%┓" , L_LINE , , 表示行数
			CALL SET_PICTURE , @"EQUIP " , L_LINE , , 表示行数 + 2
			CALL SET_PICTURE , @"┃%" " * 横幅%┃" , L_LINE + 1 , , 表示行数
			CALL SET_PICTURE , @"┃%" " * 横幅%┃" , L_LINE + 2 , , 表示行数
			CALL SET_PICTURE , @"┗%"━" * (横幅 / 2)%┛" , L_LINE+3 , , 表示行数

			CALL SET_PICTURE , GET_STATUS_WINDOW_EQUIP_NAME(L_CHARA, GET_EQUIPNUM("총"), IS_EQUIP_CHANGE), L_LINE + 1 , , 表示行数+2
			CALL SET_PICTURE , GET_STATUS_WINDOW_EQUIP_NAME(L_CHARA, GET_EQUIPNUM("탄환"), IS_EQUIP_CHANGE), L_LINE + 2 , , 表示行数+2

			L_LINE += 4
		ENDIF
		FOR LOCAL, L_LINE, 24
			CALL SET_PICTURE , @"%"　" * (横幅 / 2 + 2)%" , LOCAL , , 表示行数
		NEXT
	ENDIF
ENDCATCH

