;=======================================
;@STATUS_WINDOW_EQUIPDEVIL
;ペルソナ・変身悪魔ウィンドウ表示処理
; ■引数
;　　ARG   = 対象キャラ固定No
;　　ARG:1 = 横の位置
;　　ARG:2 = 
; ■戻り値
;　　なし
; ■ローカル変数
;　　LOCAL = 縦の位置
;　　横幅  = 表示枠横幅(固定値)
;=======================================
@STATUS_WINDOW_EQUIPDEVIL , ARG , ARG:1 , ARG:2
#DIM 横幅
#DIM DYNAMIC LCOUNT
#DIM TEMPS
LOCAL = ARG:1
横幅 = 42

;---- EDIT 006 ADD START -------------------------
IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	CALL SET_PICTURE , @"┏LINKED-DEVIL%"━" * (横幅 / 2 - 6)%┓" , LOCAL , , ARG:2
	CALL SET_PICTURE , @"┃%" " * (横幅)%┃" , LOCAL+1 , , ARG:2
	IF GET_ROLE_PROP("CAN_USE_LINK", ARG)
		IF CFLAG:ARG:링크캐릭터실제가입시간0 > 0
			CALL SET_PICTURE , @"[変更] %CALLNAME:FINDCHARA_LINK(ARG),20,LEFT% \@CFLAG:ARG:악마변신 ?変身中#リンク中\@,,,悪魔変更" , LOCAL+1 , , ARG:2 + 2
		ELSE
			CALL SET_PICTURE , @"[変更] %CSVCALLNAME(CFLAG:ARG:초기링크악마, 0),20,LEFT% \@CFLAG:ARG:악마변신 ?変身中#リンク中\@,,,悪魔変更" , LOCAL+1 , , ARG:2 + 2
		ENDIF
	ELSE
		IF GET_ROLE_PROP("CAN_USE_MANTRA", ARG) && FLAG:만트라개방도 && (SOFT_ON("삼히타") || FLAG:SHOP커맨드 == [[ショップ:셋업]] || FLAG:SHOP커맨드 == [[ショップ:능력확인]])
			CALL SET_PICTURE , @"[取得] %CSVCALLNAME(CFLAG:ARG:초기링크악마, 0),20,LEFT% \@CFLAG:ARG:악마변신 ?変身中#変身可\@,,,マントラ取得" , LOCAL+1 , , ARG:2 + 2
		ELSE
			CALL SET_PICTURE , @"[固定] %CSVCALLNAME(CFLAG:ARG:초기링크악마, 0),20,LEFT% \@CFLAG:ARG:악마변신 ?変身中#リンク中\@" , LOCAL+1 , , ARG:2 + 2
		ENDIF
	ENDIF
	CALL SET_PICTURE , @"┗%"━" * (横幅 / 2)%┛" , LOCAL+2 , , ARG:2
ENDIF
;---- EDIT 006 ADD END ---------------------------
IF TALENT:ARG:Aion식소환술
	CALL SET_PICTURE , @"┏EQUIPPED-DEVIL%"━" * (横幅 / 2 - 7)%┓" , LOCAL , , ARG:2
	CALL SET_PICTURE , @"┃%" " * (横幅)%┃" , LOCAL+1 , , ARG:2
	IF CFLAG:ARG:링크캐릭터실제가입시간0 > 0
		CALL SET_PICTURE , @"[変更] %CALLNAME:FINDCHARA_LINK(ARG),20,LEFT% セット中,,,悪魔変更" , LOCAL+1 , , ARG:2 + 2
	ELSEIF TALENT:ARG:Aion식소환술
		CALL SET_PICTURE , @"[変更] 仲魔をセットしていません,,,悪魔変更" , LOCAL+1 , , ARG:2 + 2
	ENDIF
	CALL SET_PICTURE , @"┗%"━" * (横幅 / 2)%┛" , LOCAL+2 , , ARG:2;EDIT 006 ADD
ENDIF
IF TALENT:ARG:페르소나구사자
	;IF TALENT:ARG:데빌시프터 || TALENT:ARG:식노 || TALENT:ARG:악마빙의자
	IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
		LOCAL += 2
		CALL SET_PICTURE , @"┣PERSONA %"━" * (横幅 / 2 - 4)%┫" , LOCAL , , ARG:2
	ELSE
		CALL SET_PICTURE , @"┏PERSONA %"━" * (横幅 / 2 - 4)%┓" , LOCAL , , ARG:2
	ENDIF
	CALL SET_PICTURE , @"┃%" " * (横幅)%┃" , LOCAL+1 , , ARG:2
	IF EQUIP:ARG:장비페르소나
		CALL SET_PICTURE , @"[変更] %CSVCALLNAME((DITEMTYPE:(EQUIP:ARG:장비페르소나):페르소나("NO")),0), 20, LEFT% 相性:%MARK_P_FITNESS(ARG)%,,,ペルソナ変更" , LOCAL+1 , , ARG:2 + 2
	ELSEIF !EQUIP:ARG:장비페르소나 && ABL:ARG:초기페르소나
		CALL SET_PICTURE , @"[変更] %CSVCALLNAME(ABL:ARG:초기페르소나,0), 20 , LEFT% 相性:%MARK_P_FITNESS(ARG)%,,,ペルソナ変更" , LOCAL+1 , , ARG:2 + 2
	ELSE
		CALL SET_PICTURE , @"[変更],,,ペルソナ変更" , LOCAL+1 , , ARG:2 + 2
	ENDIF
	CALL SET_PICTURE , @"┗%"━" * (横幅 / 2)%┛" , LOCAL+2 , , ARG:2;EDIT 006 ADD
ENDIF
;---- EDIT P 001 ADD START -------------------------
IF GET_ROLE_PROP("CAN_USE_PORTRAIT", ARG)
	CALL SET_PICTURE , @"┏PORTRAIT%"━" * (横幅 / 2 - 4)%┓" , LOCAL , , ARG:2
	CALL SET_PICTURE , @"┃%" " * (横幅)%┃" , LOCAL+1 , , ARG:2
	IF EQUIP:ARG:허물
		CALL SET_PICTURE , @"%CSVCALLNAME(EQUIP:ARG:허물),20,LEFT% セット中,,," , LOCAL+1 , , ARG:2 + 2
	ELSE
		CALL SET_PICTURE , @"------,,," , LOCAL+1 , , ARG:2 + 2
	ENDIF
	;---- EDIT P 002 ADD START -------------------------
	CALL SET_PICTURE , @"┗%"━" * (横幅 / 2)%┛" , LOCAL+2 , , ARG:2;EDIT 006 ADD
	CALL SET_PICTURE , @"┏KAMUI %"━" * (横幅 / 2 - 3)%┓" , LOCAL + 3, , ARG:2
	FOR LCOUNT, 0, 3
		CALL SET_PICTURE , @"┃%" " * (横幅)%┃" , LOCAL + 4 + LCOUNT, , ARG:2
		IF C_EQUIPED_KAMUI:ARG:LCOUNT != ""
			CALL SET_PICTURE , @"[{60 + LCOUNT}] %C_EQUIPED_KAMUI:ARG:LCOUNT,20,LEFT% ,,,{60 + LCOUNT}" , LOCAL + 4 + LCOUNT , , ARG:2 + 2
		ELSE
			CALL SET_PICTURE , @"------,,," , LOCAL + 4 + LCOUNT , , ARG:2 + 2
		ENDIF
	NEXT
	CALL SET_PICTURE , @"┗%"━" * (横幅 / 2)%┛" , LOCAL + 7 , , ARG:2;EDIT 006 ADD
	;---- EDIT P 002 ADD END ---------------------------
ENDIF
;---- EDIT P 001 ADD END ---------------------------

