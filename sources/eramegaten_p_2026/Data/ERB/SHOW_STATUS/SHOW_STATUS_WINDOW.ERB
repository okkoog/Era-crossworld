;=======================================
;習得予定スキル一覧機能表示(div前提)
;=======================================
@習得スキル一覧表示 , L_CHARA
#DIM DYNAMIC L_CHARA ;指定キャラ
#DIMS DYNAMIC L_LIST , 40
#DIMS DYNAMIC L_SKILLHEADER
#DIMS DYNAMIC L_SKILL
#DIMS DYNAMIC L_EXPLAIN
CLEARLINE 1
;まずクソでっけえ薄い黒画像を作って下敷きにする。
LOCALS = <div xpos='0' ypos='{-10000}' display='absolute-leftbottom'>%SET_BUTTON_TAG( 不可フィルタ( LINELENS *100 , 10000) , "-1")%</div>
;操作帯も作る
VARS 操作ガイド
;操作ガイド '= @"<div ypos='-100' width='{LINELENS*50}' background_color='%TOSTR_HTML(COLOR("DARK-GRAY"))%' display='absolute-leftbottom'><div xpos ='{LINELENS*50/2-(27*50/2)}'>[枠外クリック]or[Enter]戻る</div></div>"
VARS ウィンドウ
CALL 習得予定スキルウィンドウ , L_CHARA , L_LIST
;この時点でL_LISTには習得予定スキル1～20のレベル順ソートリストが入ってる
ウィンドウ '= RESULTS
ウィンドウ = <div xpos='{500}' ypos='-3350'  display='absolute-leftbottom'>%ウィンドウ%</div>
$INPUT_LOOP
HTML_PRINT_ISLAND LOCALS + 操作ガイド , 1
HTML_PRINT_ISLAND ウィンドウ , 2
INPUTS
IF ISNUMERIC(RESULTS) && INRANGE(TOINT(RESULTS) , 0 , VARSIZE("L_LIST") - 1) && L_LIST:TOINT(RESULTS) != ""
	CLEARLINE 1
	IF L_LIST:TOINT(RESULTS) == "변이"
		CALL 変異説明ウィンドウ, L_CHARA
	ELSE
		L_SKILLHEADER = \@CFLAG:L_CHARA:악마변신 ? 초기변신악마 # \@
		L_SKILL '= L_LIST:TOINT(RESULTS)
		;スキルの説明文を取得
		CALL スキル性能説明ウィンドウ , L_SKILL, L_CHARA
	ENDIF
	L_EXPLAIN '= RESULTS
	HTML_PRINT_ISLAND LOCALS + @"<div xpos='{(LINELENS*50/2-RESULT/2)}' ypos='{-1000-(RESULT:1 > 5 ? RESULT:1 - 5 # 0)*100}' display='absolute-leftbottom'>%L_EXPLAIN%</div>" , 3
	WAIT
	HTML_PRINT_ISLAND_CLEAR
	;CLEARLINE 2
	GOTO INPUT_LOOP
ELSE
	HTML_PRINT_ISLAND_CLEAR
	RETURN 1
ENDIF
GOTO INPUT_LOOP


