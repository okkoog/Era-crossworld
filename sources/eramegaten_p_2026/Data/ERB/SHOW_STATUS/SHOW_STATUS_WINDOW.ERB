@STATUS_WINDOW_SKILL , ARG , ARG:1 , ARG:2
#DIM LCOUNT
#DIM L_SKILL
#DIM L_LEARN
#DIM L_LEARN_LV
#DIM L_MUTATION_LV
#DIMS L_SKILLS
#DIM 横幅
#DIM 基準位置 , 2
#DIM CONST SHOW_SKILLLINENUM = 6
横幅 = 50
SIF GETBIT (FLAG:커스텀게임화면,1)
	横幅 = 82
;SHOW_SKILLLINENUM = CHARA_SKILLCOUNT(ARG) / 2 +  CHARA_SKILLCOUNT(ARG) % 2

CALL SET_PICTURE , @"┏SKILL %"━" * (横幅 / 2 -3)%┓" , ARG:1 , , ARG:2
FOR LCOUNT, 1, SHOW_SKILLLINENUM + 1
	CALL SET_PICTURE , @"┃%" " * 横幅%┃" , ARG:1 + LCOUNT , , ARG:2
NEXT
CALL SET_PICTURE , @"_┗%"━" * (横幅 / 2)%┛_" , ARG:1 + LCOUNT , , ARG:2

基準位置:0 = ARG:1 + 1
基準位置:1 = ARG:2 + 2
FOR LCOUNT, 1, SHOW_SKILLLINENUM * 2 + 1
	L_SKILL = ABL:ARG:@"스킬{LCOUNT}"
	;所持スキル数までを表示
	IF LCOUNT <= CHARA_SKILLCOUNT(ARG)
		IF L_SKILL
			;敵専用/システム・基本行動・銃攻撃/使用アイテム/リンケージはグレーで表示(전투중＆全書閲覧用)
			RESULT = 0
			CALL GET_SKILL_PROP, "敵専用", L_SKILL, ARG
			RESULT |= INRANGE(L_SKILL, 1, 2099) !| INRANGE(L_SKILL, 2400, 2999)
			CALL GET_SKILL_PROP, "SKILL_NAME", ABL:ARG:@"스킬{LCOUNT}", ARG
			SIF STRLENS(RESULTS) > SKILLNAMELENS:GETBIT(FLAG:커스텀게임화면,1) - 4
				RESULTS '= TOHALF(RESULTS)
			SIF STRLENS(RESULTS) > SKILLNAMELENS:GETBIT(FLAG:커스텀게임화면,1) - 4
				RESULTS '= SUBSTRING(RESULTS, 0, SKILLNAMELENS:GETBIT(FLAG:커스텀게임화면,1) - 6) + ".."
			CALL SET_PICTURE, @"_[{LCOUNT,2}]%RESULTS,20-LCOUNT/10,LEFT%,\@ RESULT ? 0x666666 # \@,,{LCOUNT}_", 基準位置:0 + (LCOUNT-1) / 2, , 基準位置:1 + (LCOUNT-1) % 2 * 横幅 /2
		ELSE
			;スキルが無い場合、通常の操作可能な枠ならEMPTYを出す
			SIF LCOUNT <= GET_ROLE_PROP("CHANGEABLE_SKILLCOUNT", ARG)
				CALL SET_PICTURE, @"_[{LCOUNT,2}]%"EMPTY",20-LCOUNT/10,LEFT%,\@ RESULT ? 0x666666 # \@,,{LCOUNT}_", 基準位置:0 + (LCOUNT-1) / 2, , 基準位置:1 + (LCOUNT-1) % 2 * 横幅 /2
		ENDIF
	ENDIF
NEXT
IF CFLAG:ARG:PT플래그 > 0
	L_SKILLS = \@CFLAG:ARG:악마변신 ? 초기변신악마 # \@
	L_LEARN = 0
	FOR LCOUNT,1, 21
		SIF !ABL:ARG:@"%L_SKILLS%습득스킬{LCOUNT}"
			CONTINUE
		SIF !ABL:ARG:@"%L_SKILLS%습득LV{LCOUNT}"
			CONTINUE
		IF L_LEARN == 0
			L_LEARN = ABL:ARG:@"%L_SKILLS%습득스킬{LCOUNT}"
			L_LEARN_LV = ABL:ARG:@"%L_SKILLS%습득LV{LCOUNT}"
		ELSE
			IF L_LEARN_LV > ABL:ARG:@"%L_SKILLS%습득LV{LCOUNT}"
				L_LEARN = ABL:ARG:@"%L_SKILLS%습득스킬{LCOUNT}"
				L_LEARN_LV = ABL:ARG:@"%L_SKILLS%습득LV{LCOUNT}"
			ENDIF
		ENDIF
	NEXT
	
	;---- EDIT P 004 ADD START -------------------------
	;習得スキルが残ってたら習得スキル開示ボタンを表示
	CALL 習得予定スキルウィンドウ , ARG , RESULTS, "参照確認"
	SIF RESULT
		CALL SET_PICTURE , "[19]◆습득예정스킬 목록표시◆,,,19_" , ARG:1 , , ARG:2 + 24
	;---- EDIT P 004 ADD END -------------------------
	;習得スキルの表示
