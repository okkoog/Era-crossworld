;スキル性能説明ウィンドウ(div前提)
;=======================================
@変異説明ウィンドウ , L_CHARA , L_WIDTH = -1 , L_HEIGHT = -1
#DIM L_CHARA
#DIMS L_EXPLAIN
#DIM L_WIDTH
#DIM L_HEIGHT


RESULTS = Lv:{CSVBASE(ABL:L_CHARA:변이, GETNUM(BASE,"LV"))}
RESULTS += "<br>" + @"%조사처리(CALLNAME:L_CHARA,"이")% Lv{ABL:L_CHARA:변이레벨} 이상이면서 마스터가 Lv{GET_NEED_TRANSFORM_MASTER_LV(L_CHARA)} 이상일 시、변이가능。"
;RESULTSに
DEBUGPRINTFORM %RESULTS%
SIF L_WIDTH == -1
	L_WIDTH = (3 * 50 +100 > 6000 ? 3 * 50 +100 # 6000 )
SIF L_HEIGHT == -1
	L_HEIGHT = 3 * 100
L_EXPLAIN '= HTML_DIV_WINDOW(L_WIDTH , L_HEIGHT , RESULTS)
;HTML_PRINT @"<div xpos=''{(LINELENS*50/2-5300/2)}' ypos='-800'>%L_EXPLAIN%</div>" , 1
RESULTS '= CSVCALLNAME(ABL:L_CHARA:변이)
L_EXPLAIN += @"<div xpos='-0' ypos='-200'>%HTML_DIV_WINDOW(MAX(1200, STRLENS(RESULTS) * 50 + 50) , 200 , RESULTS , )%</div>" 

RESULTS '= L_EXPLAIN
RETURN L_WIDTH , L_HEIGHT / 100 - 2
;=======================================
;習得予定スキルウィンドウ(div前提)
;=======================================
@習得予定スキルウィンドウ , L_CHARA , L_LIST, L_OPT
#DIM DYNAMIC L_CHARA ;指定キャラ
#DIMS DYNAMIC L_OPT
#DIMS DYNAMIC CONTENT_WINDOW = ""
#DIMS DYNAMIC L_SKILLNAME,40
#DIMS DYNAMIC L_ADDSTR, 40
#DIMS DYNAMIC L_TOOLTIP, 40
#DIMS REF L_LIST , 0 ;リスト内ののスキル名称を返すための変数
#DIM DYNAMIC L_LEARN_LV, 40
#DIM DYNAMIC L_SORT_KEY, 40
#DIM DYNAMIC L_MAXNAMELENS = 19
#DIMS DYNAMIC L_SKILLS
#DIM DYNAMIC L_COUNT
#DIM DYNAMIC L_TEMP
#DIM DYNAMIC IS_HAVE_AW_SKILL
#DIM DYNAMIC L_BUTTONNUM
;変身キャラの場合、悪魔変身していたら接頭辞に初期変身悪魔を追加。

L_SKILLS = \@CFLAG:L_CHARA:악마변신 ? 초기변신악마 # \@
VARSET L_SORT_KEY, 1000
;まず、指定されたキャラの習得スキルをレベル順に並べる
FOR L_COUNT , 1 , 21
	;習得レベルが設定されてないならスルー
	SIF !ABL:L_CHARA:@"%L_SKILLS%습득LV{L_COUNT}"
		CONTINUE
	SIF !ABL:L_CHARA:@"%L_SKILLS%습득스킬{L_COUNT}"
		CONTINUE
	SIF L_OPT == "参照確認"
		RETURN 1
	L_BUTTONNUM = FINDELEMENT(L_LIST, "", , , 1)
	L_LIST:(L_BUTTONNUM) '= CONVERT_SKILLNUM_TO_STR(L_CHARA, ABL:L_CHARA:@"%L_SKILLS%습득스킬{L_COUNT}")
	L_LEARN_LV:(L_BUTTONNUM) = ABL:L_CHARA:@"%L_SKILLS%습득LV{L_COUNT}"
NEXT
ARRAYMSORT L_LEARN_LV, L_LIST
;ここまででソートは出来たので、これを使ってウィンドウのコンテンツを作成

FOR L_COUNT,0, 20
	SIF L_LIST:L_COUNT == ""
		BREAK
	;スキル名を呼び出し
	CALL GETS_SKILL_PROP, "SKILL_NAME", L_LIST:L_COUNT, L_CHARA
	L_SKILLNAME:L_COUNT '= RESULTS
	L_ADDSTR:L_COUNT '= @" LV{L_LEARN_LV:L_COUNT,3}"
	L_MAXNAMELENS = MAX(L_MAXNAMELENS, STRLENS(L_SKILLNAME:L_COUNT))
	;スキル説明を呼び出して保存
	CALL GET_SKILL_EXPLAIN_TOOLTIP , , L_CHARA, L_LIST:L_COUNT
	L_TOOLTIP:L_COUNT '= RESULTS

NEXT

;MAG習得リストのチェック
CALL FIX_SPECIAL_LEARN_SKILL, L_CHARA
IF RESULT
	SIF L_OPT == "参照確認"
		RETURN 1
	VARS TEMP_SKILLS, 100
	SPLIT CSTR:L_CHARA:@"%L_SKILLS%MAG습득스킬리스트", "/", TEMP_SKILLS
	FOR L_COUNT, 0, RESULT
		L_BUTTONNUM = FINDELEMENT(L_LIST, "", , , 1)
		;スキル名を呼び出し
		CALL GETS_SKILL_PROP, "SKILL_NAME", TEMP_SKILLS:L_COUNT, L_CHARA
		L_SKILLNAME:L_BUTTONNUM '= RESULTS
		L_ADDSTR:L_BUTTONNUM '= "【MAG】"
		L_MAXNAMELENS = MAX(L_MAXNAMELENS, STRLENS(L_SKILLNAME:L_BUTTONNUM))
		;スキル説明を呼び出して保存
		CALL GET_SKILL_EXPLAIN_TOOLTIP , , L_CHARA, TEMP_SKILLS:L_COUNT
		L_TOOLTIP:L_BUTTONNUM '= RESULTS
		;スキル名と番号を記述
		L_LIST:L_BUTTONNUM '= TEMP_SKILLS:L_COUNT
	NEXT
ENDIF

;覚醒スキルを正式に所持しているかを見る
FOR L_COUNT, 1, 21
	SIF ABL:L_CHARA:@"%L_SKILLS%스킬{L_COUNT}" != [[스킬:각성스킬]]
		CONTINUE
	IS_HAVE_AW_SKILL = 1
	SIF L_OPT == "参照確認"
		RETURN 1
	BREAK
NEXT
IF !IS_HAVE_AW_SKILL
	CALL GET_AW_SKILLNUM_BY_CSV, L_CHARA
	VARI L_AW_SKILL = RESULT
	IF L_AW_SKILL > 0
		L_BUTTONNUM = FINDELEMENT(L_LIST, "", , , 1)
		L_LIST:L_BUTTONNUM '= "AW_" + TOSTR(L_AW_SKILL)
		CALLFORM SKILL_NAME_AW_{L_AW_SKILL}, L_CHARA
		L_SKILLNAME:L_BUTTONNUM '= RESULTS
		L_ADDSTR:L_BUTTONNUM '= "【각성】"
		L_MAXNAMELENS = MAX(L_MAXNAMELENS, STRLENS(L_SKILLNAME:L_BUTTONNUM))
		;スキル説明を呼び出して保存
		CALL GET_SKILL_EXPLAIN_TOOLTIP ,  , L_CHARA, "AW_" + TOSTR(L_AW_SKILL)
		L_TOOLTIP:L_BUTTONNUM '= RESULTS
	ENDIF
ENDIF

IF ABL:L_CHARA:변이 > 0 && ABL:L_CHARA:변이레벨 > 0
	SIF L_OPT == "参照確認"
		RETURN 1
	L_BUTTONNUM = FINDELEMENT(L_LIST, "", , , 1)
	L_LIST:L_BUTTONNUM '= "변이"
	L_SKILLNAME:L_BUTTONNUM '= CSVCALLNAME(ABL:L_CHARA:변이)
	L_ADDSTR:L_BUTTONNUM '= "【변이】"
	L_MAXNAMELENS = MAX(L_MAXNAMELENS, STRLENS(L_SKILLNAME:L_BUTTONNUM))
	;スキル説明を呼び出して保存
	L_TOOLTIP:L_BUTTONNUM '= @"변이Lv　　　　:{ABL:L_CHARA:변이레벨}" + UNICODE(0x000D) + @"필요만트라Lv:{GET_NEED_TRANSFORM_MASTER_LV(L_CHARA)}"
ENDIF

FOR L_COUNT,0, VARSIZE("L_LIST")
	SIF L_LIST:L_COUNT == ""
		BREAK
	LOCALS = [{L_COUNT,2}] %L_SKILLNAME:L_COUNT , L_MAXNAMELENS , LEFT% %L_ADDSTR:L_COUNT%
	;L_COUNT番目のボタンを生成し、ツールチップとして保存したスキルツールチップを記入
	LOCALS '= @"<div xpos='{ 36 * (L_COUNT%1) * 50 }' ypos='{(L_COUNT/1) * 100}'> %SET_BUTTON_TAG( LOCALS  , TOSTR(L_COUNT)  , L_TOOLTIP:L_COUNT)%</div>"
	;CONTENTに加える
	CONTENT_WINDOW += LOCALS
NEXT

;最後にDIVのウィンドウで囲んで完成
CONTENT_WINDOW += @"<div xpos='-40' ypos='-275'>%HTML_DIV_WINDOW(800 , 200 , "습득예정스킬" , )%</div>"
CONTENT_WINDOW '= HTML_DIV_WINDOW((L_MAXNAMELENS * 100 + 1700)/2 , MAX(1100*2, (FINDELEMENT(L_LIST, "", , , 1) + 1) * 100) , CONTENT_WINDOW , )


;RESULTSに作ったウィンドウを丸ごと返す
RESULTS '= CONTENT_WINDOW


