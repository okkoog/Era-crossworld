;-------------------------------------------------
;キャラ一覧表示処理
;-------------------------------------------------
@SHOW_CHARA_LIST, FUNC_CUSTOM_TITLE, FUNC_CUSTOM_COLOR, INFO_PAGE
#DIM LCOUNT, 2
#DIM INFO_CHARA
#DIMS SHOW_LINE
#DIMS FUNC_CUSTOM_TITLE
#DIMS FUNC_CUSTOM_COLOR;キャラごとの色指定を定義する関数を指定する
#DIMS DYNAMIC TEMPS
#DIMS DYNAMIC INFO_PAGE
#DIMS DYNAMIC INFO_DATA, 20
#DIM DYNAMIC CNT_INFO_DATA_NUM
SPLIT INFO_PAGE, "_", INFO_DATA
CNT_INFO_DATA_NUM = RESULT
INFO_HEADER = 
FOR LCOUNT, 0, CNT_INFO_DATA_NUM
	CALLFORM SET_VAR_INFO_DATA_%INFO_DATA:LCOUNT%_HEADER
	INFO_HEADER += INFO_SPACE
NEXT
HTML_PRINT INFO_HEADER
VARSET INFO_LINE
FOR LCOUNT, 0, CNT_INFO_DATA_NUM
	FOR LCOUNT:1, 0, リスト表示数()
		INFO_CHARA = Q:(LCOUNT:1 + P * リスト表示数())
		SIF INFO_CHARA < 0
			CONTINUE
		INFO_COLOR_ALL:(LCOUNT:1) = 0
		TRYCCALLFORM %FUNC_CUSTOM_COLOR%,INFO_CHARA
			SIF RESULT
				INFO_COLOR_ALL:(LCOUNT:1) = RESULT
		CATCH
		ENDCATCH
		INFO_COLOR = 0
		CALLFORM GET_VAR_INFO_DATA_%INFO_DATA:LCOUNT%, INFO_CHARA
		TEMPS '= RESULTS
		SIF !INFO_COLOR_ALL:(LCOUNT:1) && INFO_COLOR
			TEMPS '= SET_COLOR_TAG(TEMPS, TOSTR(INFO_COLOR))
		RESULT = 0
		RESULTS = 
		TRYCALLFORM %FUNC_CUSTOM_TITLE%, INFO_CHARA, INFO_DATA:LCOUNT
		;関数があって戻り値が真なら個別にボタンをつける
		IF RESULT
			IF RESULTS == ""
				TEMPS '= SET_BUTTON_TAG(TEMPS, TOSTR(INFO_CHARA))
			ELSE
				TEMPS '= SET_BUTTON_TAG(TEMPS, TOSTR(INFO_CHARA), RESULTS)
			ENDIF
		ENDIF
		INFO_LINE:(LCOUNT:1) += TEMPS + INFO_SPACE
	NEXT
NEXT
FOR LCOUNT, 0, リスト表示数()
	INFO_CHARA = Q:(LCOUNT + P * リスト表示数())
	SIF INFO_COLOR_ALL:LCOUNT
		INFO_LINE:LCOUNT '= SET_COLOR_TAG(INFO_LINE:LCOUNT, TOSTR(INFO_COLOR_ALL:LCOUNT))
	IF !STRCOUNT(INFO_LINE:LCOUNT, "<button") && INFO_CHARA >= 0
		TRYCCALLFORM %FUNC_CUSTOM_TITLE%, INFO_CHARA
			INFO_LINE:LCOUNT '= SET_BUTTON_TAG(INFO_LINE:LCOUNT, TOSTR(INFO_CHARA), RESULTS)
		CATCH
			INFO_LINE:LCOUNT '= SET_BUTTON_TAG(INFO_LINE:LCOUNT, TOSTR(INFO_CHARA))
		ENDCATCH
	ENDIF
	HTML_PRINT INFO_LINE:LCOUNT
NEXT
RETURN 0
;---- EDIT 057 MOD END ---------------------------
;-------------------------------------------------
;文字色の設定
;ARG	表示するキャラクター
;ARGS	関数で指定する場合
;-------------------------------------------------
@ARRANGE_SETCOLOR, ARG, ARGS
IF ARGS != ""
	CALLFORM %ARGS%, ARG
ELSE
	SIF CFLAG:ARG:PT플래그 == 0
		SETCOLOR 0x990000
	SIF (CFLAG:ARG:PT플래그 == 0 && CPOS(ARG) < 1) || CFLAG:ARG:피소환플래그
		SETCOLOR 0x404040
	IF FLAG:SHOP커맨드 == [[ショップ:캐릭터필터]] && CFLAG:ARG:필터링플래그
		SETCOLOR 0x404040
	ELSEIF FLAG:SHOP커맨드 == 1201 && 文字色変更 != 0
		SETCOLOR 文字色変更
	ELSEIF FLAG:SHOP커맨드 == [[ショップ:캐릭터필터]]
		RESETCOLOR
	ENDIF
ENDIF

