;========================================
;汚れセット関数
;ARGのARGSにARGS:1の汚れをつける
;========================================
@SET_STAIN(ARGS, ARGS:1, ARG = -99)
#LOCALSIZE 1
SIF ARG == -99
	ARG = TARGET
SELECTCASE ARGS
	CASE "口", "입"
		LOCAL = 0
	CASE "手", "손"
		LOCAL = 1
	CASE "ペニス", "페니스"
		LOCAL = 2
	CASE "ヴァギナ", "바기나"
		LOCAL = 3
	CASE "アナル", "애널"
		LOCAL = 4
	CASE "胸", "가슴"
		LOCAL = 5
	CASE "膣内", "질내"
		LOCAL = 6
	CASE "髪", "머리카락"
		LOCAL = 7
ENDSELECT
SELECTCASE ARGS:1
	CASE "愛液", "애액"
		SETBIT STAIN:ARG:LOCAL, 0
	CASE "ペニス", "페니스"
		SETBIT STAIN:ARG:LOCAL, 1
	CASE "精液", "정액"
		SETBIT STAIN:ARG:LOCAL, 2
	CASE "アナル", "애널"
		SETBIT STAIN:ARG:LOCAL, 3
	CASE "母乳", "모유"
		SETBIT STAIN:ARG:LOCAL, 4
	CASE "粘液", "점액"
		SETBIT STAIN:ARG:LOCAL, 5
	CASE "破瓜の血", "파과혈"
		SETBIT STAIN:ARG:LOCAL, 6
ENDSELECT