
;-------------------------------------------------
;	同一のイベント番号や依頼番号中で進行した際
;   MENU画面で次のタイトルが出る様、
;   それぞれの登録フラグをリセットする
;	それぞれのフラグがONの場合、クリアしてOFFに変更
;-------------------------------------------------
;出現フラグをリセット
@RESET_ANNOUNCE_FLAG, ARGS, ARG = -1
IF ARGS == ""
	SELECTCASE FLAG:SHOP커맨드
		CASE [[ショップ:탐색]]
			ARGS = 탐색
		CASE [[ショップ:콜로세움참가]]
			ARGS = 콜로세움참가
		CASE [[ショップ:의뢰청부]]
			ARGS = 의뢰청부
		CASE [[ショップ:이벤트]]
			ARGS = 이벤트
	ENDSELECT
ENDIF

SELECTCASE ARGS
	CASE "탐색"
		SIF ARG == -1
			ARG = FLAG:현던전
		ANNOUNCE_DUNGEON_APPEARED:ARG = 0
	CASE "콜로세움참가"
		SIF ARG == -1
			ARG = FLAG:진행중콜로세움
		ANNOUNCE_COLOSSEUM_APPEARED:ARG = 0
	CASE "의뢰청부"
		SIF ARG == -1
			ARG = FLAG:진행중의뢰
		ANNOUNCE_REQUEST_APPEARED:ARG = 0
	CASE "이벤트"
		SIF ARG == -1
			ARG = FLAG:진행중이벤트
		ANNOUNCE_EVENT_APPEARED:ARG = 0
ENDSELECT