@GET_HAIRSTYLE_NUM, HAIR_NAME
#FUNCTION
#DIMS DYNAMIC HAIR_NAME
SELECTCASE HAIR_NAME
	CASE "未設定"
		RETURNF 0
	CASE "ショートヘア", "スキンヘッド"
		RETURNF 1
	CASE "ショートボブ", "スポーツ刈り"
		RETURNF 2
	CASE "セミロング", "短髪"
		RETURNF 3
	CASE "ポニーテール", "モヒカン"
		RETURNF 4
	CASE "ツインテール", "ちょんまげ"
		RETURNF 5
	CASE "ストレートロング", "七三"
		RETURNF 6
	CASE "アップ", "ロン毛"
		RETURNF 7
	CASE "ゆるふわパーマ", "パンチパーマ"
		RETURNF 8
	CASE "ロングウェーブ", "みずら髪"
		RETURNF 9
	CASE "三つ編み", "弁髪"
		RETURNF 10
	CASE "ツーサイドアップ"
		RETURNF 11
	CASE "お団子"
		RETURNF 12
	CASE "和髪"
		RETURNF 13
ENDSELECT