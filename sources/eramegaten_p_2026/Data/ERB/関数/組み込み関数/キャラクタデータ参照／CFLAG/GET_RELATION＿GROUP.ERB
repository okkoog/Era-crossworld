	CASE "エリン"
		IF ARG:2
			L_良好 = 【エリン】
		ELSE
			SIF IS_RELATION_GROUP(ARG:1, "エリン")
				RETURNF 125
		ENDIF
	CASE "ジャックシリーズ"
		IF ARG:2
			L_最高 = 
			L_抜群 = キングフロスト
			L_良好 = 【ジャックシリーズ】
			L_不良 = 
			L_最悪 = 
		ELSE
			RESULTS_F:1 = キングフロスト
			RESULTS_F:2 = 【ジャックシリーズ】
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "キングフロスト"
				RETURNF 150
			SIF IS_RELATION_GROUP(ARG:1, "ジャックシリーズ")
				RETURNF 125
		ENDIF
	CASE "흡혈귀"
		IF ARG:2
			L_最高 = 
			L_抜群 = 
			L_良好 = 흡혈귀
			L_不良 = クルースニク
			L_最悪 = 
		ELSE
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "クルースニク"
				RETURNF 75
			SIF IS_RELATION_GROUP(ARG:1, "흡혈귀")
				RETURNF 125
		ENDIF
	;未定義は一律で同族のよしみをつける
	CASEELSE
		IF ARG:2
			L_良好 = 【%ARGS%】
		ELSE
			SIF IS_RELATION_GROUP(ARG:1, ARGS)
				RETURNF 125
		ENDIF
ENDSELECT
IF ARG:2
	RESULTS_F:0 = %L_最高%
	RESULTS_F:1 = %L_抜群%
	RESULTS_F:2 = %L_良好%
	RESULTS_F:3 = %L_不良%
	RESULTS_F:4 = %L_最悪%
	RETURNF MATCH(RESULTS_F, "", 0, 5) != 5
ELSE
	RETURNF 100
ENDIF

