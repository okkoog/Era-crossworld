		ENDIF
	CASE "猿"
		IF ARG:2
			L_最高 = 
			L_抜群 = 【猿】
			L_良好 = 
			L_不良 = 【犬】
			L_最悪 = 
		ELSE
			SIF IS_RELATION_GROUP(ARG:1, "猿")
				RETURNF 150
			SIF IS_RELATION_GROUP(ARG:1, "犬")
				RETURNF 75
		ENDIF
