;========================================
;相性判定関数
;TARGETのグループARGSにおけるARG:1（PLAYER）→ARG（TARGET）に対する相性を返す
;
;ARG:2 はグループ関係取得用
;========================================
@GET_RELATION_GROUP(ARG = -1, ARG:1 = -1 , ARGS, ARG:2 = 0)
#FUNCTION
#DIMS L_最高
#DIMS L_抜群
#DIMS L_良好
#DIMS L_不良
#DIMS L_最悪
VARSET RESULTS_F, "", 0, 5
L_最高 = 
L_抜群 = 
L_良好 = 
L_不良 = 
L_最悪 = 
SIF ARG == -1
	ARG = TARGET
SIF ARG:1 == -1
	ARG:1 = PLAYER
SELECTCASE ARGS
	CASE "高天原"
		IF ARG:2
			L_最高 = イザナミ/イザナギ/アマテラス
			L_抜群 = 【高天原】
			L_良好 = 
			L_不良 = 【豊葦原】
			L_最悪 = スサノオ
		ELSE
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "イザナミ"
				RETURNF 200
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "イザナギ"
				RETURNF 200
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "アマテラス"
				RETURNF 200
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "スサノオ"
				RETURNF 50
			SIF IS_RELATION_GROUP(ARG:1, "高天原")
				RETURNF 150
			SIF IS_RELATION_GROUP(ARG:1, "豊葦原")
				RETURNF 75
		ENDIF
	CASE "豊葦原"
		IF ARG:2
			L_最高 = イザナミ/イザナギ/スサノオ
			L_抜群 = 【豊葦原】
			L_良好 = 
			L_不良 = 【高天原】
			L_最悪 = アマテラス
		ELSE
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "イザナミ"
				RETURNF 200
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "イザナギ"
				RETURNF 200
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "スサノオ"
				RETURNF 200
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "アマテラス"
				RETURNF 50
			SIF IS_RELATION_GROUP(ARG:1, "豊葦原")
				RETURNF 150
			SIF IS_RELATION_GROUP(ARG:1, "高天原")
				RETURNF 75
		ENDIF
	CASE "ヘブライ天使"
		IF ARG:2
			L_最高 = YHVH
			L_抜群 = 【上位ヘブライ天使】/【聖(묵시록)】
			L_良好 = 【下位ヘブライ天使】/【メシア教】
			L_不良 = 【ソロモン72柱】/【魔(ヘブライ)】/【ガイア教】
			L_最悪 = ルシファー
		ELSE
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "YHVH"
				RETURNF 200
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "ルシファー"
				RETURNF 50
			IF IS_RELATION_GROUP(ARG:1, "ヘブライ天使")
				;天使は自分より上から抜群、下から良好
				IF CSVBASE(NO:ARG, GETNUM(BASE, "LV"), 0) < CSVBASE(NO:(ARG:1), GETNUM(BASE, "LV"), 0)
					RETURNF 150
				ELSE
					RETURNF 125
				ENDIF
			ENDIF
			;上司的存在になるはず…？
			SIF IS_RELATION_GROUP(ARG:1, "聖(묵시록)")
				RETURNF 150
			SIF IS_RELATION_GROUP(ARG:1, "魔(ヘブライ)")
				RETURNF 75
			SIF IS_RELATION_GROUP(ARG:1, "魔(묵시록)")
				RETURNF 75
			SIF IS_RELATION_GROUP(ARG:1, "ソロモン72柱")
				RETURNF 75
			SIF IS_RELATION_GROUP(ARG:1, "ガイア教")
				RETURNF 75
		ENDIF
	CASE "ソロモン72柱"
		IF ARG:2
			L_最高 = 
			L_抜群 = 
			L_良好 = 【ソロモン72柱】/【魔(ヘブライ)】/【魔/묵시록】
			L_不良 = 【ヘブライ天使】
			L_最悪 = YHVH
		ELSE
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "YHVH"
				RETURNF 50
			SIF IS_RELATION_GROUP(ARG:1, "魔(ヘブライ)")
				RETURNF 125
			SIF IS_RELATION_GROUP(ARG:1, "魔(묵시록)")
				RETURNF 125
			SIF IS_RELATION_GROUP(ARG:1, "ソロモン72柱")
				RETURNF 125
			SIF IS_RELATION_GROUP(ARG:1, "ヘブライ天使")
				RETURNF 75
		ENDIF
	CASE "魔(ヘブライ)"
		IF ARG:2
			L_最高 = 
			L_抜群 = 
			L_良好 = 【ソロモン72柱】/【魔(ヘブライ)】/【魔/묵시록】
			L_不良 = 【ヘブライ天使】
			L_最悪 = YHVH
		ELSE
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "YHVH"
				RETURNF 50
			SIF IS_RELATION_GROUP(ARG:1, "魔(ヘブライ)")
				RETURNF 125
			SIF IS_RELATION_GROUP(ARG:1, "魔(묵시록)")
				RETURNF 125
			SIF IS_RELATION_GROUP(ARG:1, "ソロモン72柱")
				RETURNF 125
			SIF IS_RELATION_GROUP(ARG:1, "ヘブライ天使")
				RETURNF 75
		ENDIF
	CASE "魔(묵시록)"
		IF ARG:2
			L_最高 = 
			L_抜群 = 
			L_良好 = 【ソロモン72柱】/【魔(ヘブライ)】/【魔/묵시록】
			L_不良 = 【ヘブライ天使】
			L_最悪 = YHVH
		ELSE
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "YHVH"
				RETURNF 50
			SIF IS_RELATION_GROUP(ARG:1, "魔(ヘブライ)")
				RETURNF 125
			SIF IS_RELATION_GROUP(ARG:1, "魔(묵시록)")
				RETURNF 125
			SIF IS_RELATION_GROUP(ARG:1, "ソロモン72柱")
				RETURNF 125
			SIF IS_RELATION_GROUP(ARG:1, "ヘブライ天使")
				RETURNF 75
		ENDIF

	;争い合うグループなので
	CASE "ベル神"
		IF ARG:2
			L_最高 = 
			L_抜群 = 
			L_良好 = 
			L_不良 = 
			L_最悪 = 【ベル神】
		ELSE
			;自分自身を弾いておく
			SIF NO:ARG == NO:(ARG:1)
