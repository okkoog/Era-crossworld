			L_良好 = 【メシア教】
			L_不良 = 【ソロモン72柱】/【魔(ヘブライ)】
			L_最悪 = 【ガイア教】
		ELSE
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "YHVH"
				RETURNF 200
			SIF IS_RELATION_GROUP(ARG:1, "ヘブライ天使")
				RETURNF 150
			SIF IS_RELATION_GROUP(ARG:1, "メシア教")
				RETURNF 125
			SIF IS_RELATION_GROUP(ARG:1, "魔(ヘブライ)")
				RETURNF 75
			SIF IS_RELATION_GROUP(ARG:1, "ソロモン72柱")
				RETURNF 75
			SIF IS_RELATION_GROUP(ARG:1, "ガイア教")
				RETURNF 50
		ENDIF
	CASE "ガイア教"
		IF ARG:2
			L_最高 = YHVH
			L_抜群 = 【ガイア教】
			L_良好 = 
			L_不良 = 【メシア教】
			L_最悪 = 【ヘブライ天使】
		ELSE
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "YHVH"
				RETURNF 50
			SIF IS_RELATION_GROUP(ARG:1, "ヘブライ天使")
				RETURNF 50
			SIF IS_RELATION_GROUP(ARG:1, "メシア教")
				RETURNF 75
			SIF IS_RELATION_GROUP(ARG:1, "ガイア教")
				RETURNF 150
		ENDIF
	CASE "アムシャ・スプンタ"
		IF ARG:2
			L_最高 = アフラマズダ
			L_抜群 = 【アムシャ・スプンタ】/ズルワーン
			L_良好 = ミトラス/ミトラ菩薩/ハールート/マールート
			L_不良 = 【ダエーワ】
			L_最悪 = アンリ・マンユ
		ELSE
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "アフラマズダ"
				RETURNF 200
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "ズルワーン")
				RETURNF 150
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "ミトラス", "ミトラ菩薩", "ハールート", "マールート")
				RETURNF 125
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "アンリ・マンユ")
				RETURNF 50
			SIF IS_RELATION_GROUP(ARG:1, "アムシャ・スプンタ")
				RETURNF 150
			SIF IS_RELATION_GROUP(ARG:1, "ダエーワ")
				RETURNF 75
		ENDIF
	CASE "ダエーワ"
		IF ARG:2
			L_最高 = アンリ・マンユ
			L_抜群 = ズルワーン/【ダエーワ】
			L_良好 = 
			L_不良 = ミトラス/ミトラ菩薩/ハールート/マールート/【アムシャ・スプンタ】
			L_最悪 = アフラマズダ
		ELSE
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "アンリ・マンユ")
				RETURNF 200
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "ズルワーン")
				RETURNF 150
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "ミトラス", "ミトラ菩薩", "ハールート", "マールート")
				RETURNF 75
			SIF IS_RELATION_GROUP(ARG:1, "ダエーワ")
				RETURNF 150
			SIF IS_RELATION_GROUP(ARG:1, "アムシャ・スプンタ")
				RETURNF 75
		ENDIF
	CASE "デーヴァ神族"
		IF ARG:2
			L_最高 = 
			L_抜群 = 
			L_良好 = 【デーヴァ神族】
			L_不良 = 【アスラ神族】/【ラクシャーサ族】
			L_最悪 = アスラおう/ヴィローシャナ/ラーヴァナ
		ELSE
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "")
				RETURNF 200
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "")
				RETURNF 150
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "", "", "", "")
				RETURNF 75
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "アスラおう", "ヴィローシャナ", "ラーヴァナ")
				RETURNF 50
			SIF IS_RELATION_GROUP(ARG:1, "デーヴァ神族")
				RETURNF 125
			SIF IS_RELATION_GROUP(ARG:1, "アスラ神族")
				RETURNF 75
			SIF IS_RELATION_GROUP(ARG:1, "ラクシャーサ族")
				RETURNF 75
		ENDIF
	CASE "アスラ神族"
		IF ARG:2
			L_最高 = アスラおう/ヴィローシャナ
			L_抜群 = アフラマズダ/【アスラ神族】
			L_良好 = 
			L_不良 = 【デーヴァ神族】
			L_最悪 = ヴィシュヌ/シヴァ/ブラフマー
		ELSE
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "アスラおう", "ヴィローシャナ")
				RETURNF 200
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "アフラマズダ")
				RETURNF 150
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "", "", "", "")
				RETURNF 75
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "ヴィシュヌ", "シヴァ", "ブラフマー")
				RETURNF 50
			SIF IS_RELATION_GROUP(ARG:1, "アスラ神族")
				RETURNF 150
			SIF IS_RELATION_GROUP(ARG:1, "デーヴァ神族")
				RETURNF 75
		ENDIF
	CASE "ラクシャーサ族"
		IF ARG:2
			L_最高 = ラーヴァナ
			L_抜群 = アフラマズダ/【アスラ神族】
			L_良好 = 
			L_不良 = 【デーヴァ神族】
			L_最悪 = ヴィシュヌ/シヴァ/ブラフマー
		ELSE
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "ラーヴァナ")
				RETURNF 200
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "", "", "", "")
				RETURNF 75
			SIF IS_RELATION_GROUP(ARG:1, "ラクシャーサ族")
				RETURNF 150
			SIF IS_RELATION_GROUP(ARG:1, "デーヴァ神族")
				RETURNF 75
		ENDIF
	CASE "ナーガ族"
		IF ARG:2
			L_最高 = 
			L_抜群 = コウモクテン/【ナーガ族】
			L_良好 = ドゥルガー/【仏】
			L_不良 = 
			L_最悪 = ガルーダ/ビシャモンテン
		ELSE
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "コウモクテン")
				RETURNF 150
			SIF GROUPMATCH(CSVCALLNAME(NO:(ARG:1), 0), "ビシャモンテン", "ガルーダ")
				RETURNF 50
			SIF IS_RELATION_GROUP(ARG:1, "ナーガ族")
				RETURNF 150
			SIF IS_RELATION_GROUP(ARG:1, "仏")
				RETURNF 125
		ENDIF

	CASE "アスガルド"
		IF ARG:2
			L_最高 = オーディン
			L_抜群 = 【アスガルド】
			L_良好 = 
			L_不良 = アングルボダ/【라그나로크】
			L_最悪 = ロキ
		ELSE
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "オーディン"
				RETURNF 200
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "アングルボダ"
				RETURNF 75
			SIF CSVCALLNAME(NO:(ARG:1), 0) == "ロキ"
				RETURNF 50
			SIF IS_RELATION_GROUP(ARG:1, "アスガルド")
				RETURNF 150
			SIF IS_RELATION_GROUP(ARG:1, "라그나로크")
				RETURNF 75
		ENDIF
	CASE "라그나로크"
