@GET_HAIRSTYLE_NAME, HAIR_NO, L_CHARA = -1, L_SEX = "女"
#FUNCTIONS
#DIM DYNAMIC HAIR_NO
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_SEX
IF L_CHARA >= 0
	IF IS_LOOKSLIKE_MALE(L_CHARA)
		L_SEX '= "男"
	ELSE
		L_SEX '= "女"
	ENDIF
ENDIF
IF L_SEX == "女"
	SELECTCASE HAIR_NO
		CASE 0
			RETURNF "未設定"
		CASE 1
			RETURNF "ショートヘア"
		CASE 2
			RETURNF "ショートボブ"
		CASE 3
			RETURNF "セミロング"
		CASE 4
			RETURNF "ポニーテール"
		CASE 5
			RETURNF "ツインテール"
		CASE 6
			RETURNF "ストレートロング"
		CASE 7
			RETURNF "アップ"
		CASE 8
			RETURNF "ゆるふわパーマ"
		CASE 9
			RETURNF "ロングウェーブ"
		CASE 10
			RETURNF "三つ編み"
		CASE 11
			RETURNF "ツーサイドアップ"
		CASE 12
			RETURNF "お団子"
		CASE 13
			RETURNF "和髪"
	ENDSELECT
ELSE
	SELECTCASE HAIR_NO
		CASE 0
			RETURNF "未設定"
		CASE 1
			RETURNF "スキンヘッド"
		CASE 2
			RETURNF "スポーツ刈り"
		CASE 3
			RETURNF "短髪"
		CASE 4
			RETURNF "モヒカン"
		CASE 5
			RETURNF "ちょんまげ"
		CASE 6
			RETURNF "七三"
		CASE 7
			RETURNF "ロン毛"
		CASE 8
			RETURNF "パンチパーマ"
		CASE 9
			RETURNF "みずら髪"
		CASE 10
			RETURNF "弁髪"
	ENDSELECT
ENDIF