;-------------------------------------------------
;@CSV種族名(ARG,ARG:1)
;定義されていないキャラ(NO:ARG)の種族名を返す
;-------------------------------------------------
@CSV種族名(ARG,ARG:1)
#FUNCTIONS
SIF CSVCSTR(ARG,GETNUM(CSTR,"종족명"),ARG:1) != ""
	RETURNF CSVCSTR(ARG,GETNUM(CSTR,"종족명"),ARG:1)
RETURNF STR:(CSVABL(ARG,GETNUM(ABL,"종족"),ARG:1))