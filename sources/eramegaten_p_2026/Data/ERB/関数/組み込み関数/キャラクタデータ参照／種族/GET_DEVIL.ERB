;-------------------------------------------------
;@GET_DEVIL
;ARGのキャラが悪魔かどうかを返す
;ARG:1で指定していた場合はNOを見る
;-------------------------------------------------
@GET_DEVIL, ARG, ARG:1 = -1
#FUNCTION
#DIM L_RACE
L_RACE = ARG:1 >= 0 ? CSVABL(ARG, GETNUM(ABL, "종족"), 0) # ABL:ARG:종족
;人間はのぞく
SIF L_RACE == 0
	RETURNF 0
;半魔人はのぞく
SIF L_RACE == 36
	RETURNF 0
;造魔はのぞく
SIF L_RACE == 45
	RETURNF 0
RETURNF 1