;-------------------------------------------------
;@종족명(ARG)
;種族名を判断して返す
;-------------------------------------------------
@종족명(ARG)
#FUNCTIONS
IF CSTR:ARG:롤 == "人修羅"
	SELECTCASE BASE:ARG:LV
		CASE IS < 20
			SELECTCASE GET_ALI2(ABL:ARG:속성LC)
				CASE "Law"
					RETURNF "神兵"
				CASE "Neutral"
					RETURNF "鬼衆"
				CASE "Chaos"
					RETURNF "魔徒"
			ENDSELECT
		CASE IS < 40
			SELECTCASE GET_ALI2(ABL:ARG:속성LC)
				CASE "Law"
					RETURNF "聖魔"
				CASE "Neutral"
					RETURNF "業鬼"
				CASE "Chaos"
					RETURNF "魔闘士"
			ENDSELECT
		CASE IS < 60
			SELECTCASE GET_ALI2(ABL:ARG:속성LC)
				CASE "Law"
					RETURNF "魔教皇"
				CASE "Neutral"
					RETURNF "修羅漢"
				CASE "Chaos"
					RETURNF "魔軍将"
			ENDSELECT
		CASE IS < 80
			SELECTCASE GET_ALI2(ABL:ARG:속성LC)
				CASE "Law"
					RETURNF "神霊"
				CASE "Neutral"
					RETURNF "修羅王"
				CASE "Chaos"
					RETURNF "魔帝"
			ENDSELECT
		CASEELSE
			RETURNF "混沌王"
	ENDSELECT
ELSE
	SIF CSTR:ARG:종족명 != ""
		RETURNF CSTR:ARG:종족명
	RETURNF STR:(ABL:ARG:종족)
ENDIF
