;-------------------------------------------------
;ダメージ割合把握関数
;ARGにターゲット、ARG:1にダメージを入れる
;-------------------------------------------------
@ダメージ割合(ARG, ARG:1)
#FUNCTION
RETURNF ARG:1 * 100 / MAXBASE:ARG:ＨＰ

;-------------------------------------------------
; 한국어 번역 구상용 호환 래퍼 함수
;-------------------------------------------------
@데미지비율(ARG, ARG:1)
#FUNCTION
RETURNF ダメージ割合(ARG, ARG:1)
