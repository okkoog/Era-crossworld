@顔グラ追加, cNUM, IS_SIMPLE
#DIM DYNAMIC cNUM
#DIM DYNAMIC IS_SIMPLE
RETURN 顔グラ追加_F(cNUM, IS_SIMPLE)

@顔グラ追加_F, cNUM, IS_SIMPLE
#FUNCTION
#DIM cNUM
#DIM DYNAMIC IS_SIMPLE
#DIM gID
#DIM LCOUNT, 2
#DIMS CONST フォルダ名 = "10_キャラ画像", "00_ユーザー追加アイコン"
#DIMS CONST アイコンタイプ = "FACE", "FACE_TS", "FACE_EX", "FACE_UNIQUE"
#DIMS DYNAMIC スプライト名
#DIMS DYNAMIC ファイルアドレス
#DIM DYNAMIC EXTRA_TITLE_NO
#DIMS L_SPRITENAME
RESULT_F:1 = 0
;WINAPIでは処理をしない
SIF GETCONFIGS("描画インターフェース") == "WINAPI"
	RETURNF 0
cNUM = GET_ICON_CSVNO(cNUM)
SIF !INRANGE(cNUM, 0, CSVCHARANUM)
	RETURNF 0
;履歴をつけてチェック回数を削減する
SIF IS_TRYMAKE_FACE:cNUM
	RETURNF 0
IS_TRYMAKE_FACE:cNUM = 1
FOR LCOUNT:1, 0, VARSIZE("フォルダ名")
	SELECTCASE フォルダ名:(LCOUNT:1)
		CASE "10_キャラ画像"
			FOR LCOUNT, 0, VARSIZE("アイコンタイプ")
				ファイルアドレス '= GET_ICON_FOLDER_NAME(cNUM, "キャラ画像")
				スプライト名 '= GET_識別名(cNUM) + "_" +アイコンタイプ:LCOUNT
				ファイルアドレス += "\\" + スプライト名
				CALLF 顔グラ追加_ファイル_F, cNUM, スプライト名, ファイルアドレス
				RESULT_F:1 += RESULT_F
				SIF IS_SIMPLE && LCOUNT == 1
					BREAK
			NEXT
		CASE "00_ユーザー追加アイコン"
			ファイルアドレス '= GET_ICON_FOLDER_NAME(cNUM, "ユーザー自作")
			ファイルアドレス += "\\" + "A" + TOSTR(cNUM)
			スプライト名 '= GET_識別名(cNUM) + "_" + "USER"
			CALLF 顔グラ追加_ファイル_F, cNUM, スプライト名, ファイルアドレス
			RESULT_F:1 += RESULT_F
	ENDSELECT
	SIF IS_SIMPLE
		BREAK
NEXT
RETURNF RESULT_F:1

@顔グラ追加_ファイル_F, cNUM, スプライト名, ファイルアドレス, IS_SIMPLE
#FUNCTION
#DIM DYNAMIC LCNT
#DIM DYNAMIC cNUM
#DIMS DYNAMIC スプライト名
#DIMS DYNAMIC ファイルアドレス
#DIM DYNAMIC gID
#DIMS DYNAMIC L_SPRITENAME
#DIM DYNAMIC IS_SIMPLE
RESULT_F = 0
FOR LCNT, 0, 100
	IF !IS_SIMPLE
		;除外用の画像がCSVで定義されていたら飛ばす
		SPRITECREATED  "EXCLUDE" + "_" + スプライト名 + "_" + TOSTR(LCNT)
		SIF RESULT
			CONTINUE
	ENDIF
	gID = FINDELEMENT(USED_CHARA_GID, 0)
	GDISPOSE gID
	SIF !GCREATEFROMFILE(gID, ファイルアドレス + "_" + TOSTR(LCNT) + ".png")
		CONTINUE
	;登録に成功したので使用済みにする
	USED_CHARA_GID:gID = 1

	L_SPRITENAME '= スプライト名 + "_" + TOSTR(LCNT)

	;ファイル名を登録する
	CHARA_GID_SPRITENAME:gID '= L_SPRITENAME

	SPRITEDISPOSE L_SPRITENAME
	;スプライト作成
	SPRITECREATE L_SPRITENAME, gID, 0, 0, MIN(GHEIGHT(gID), GWIDTH(gID)), MIN(GHEIGHT(gID), GWIDTH(gID))
	RESULT_F++
	;省力版では0番だけチェックしたら終わる
	SIF IS_SIMPLE
		BREAK
NEXT
RETURNF RESULT_F
@GET_ICON_FOLDER_NAME, cNUM, L_TYPE
#FUNCTIONS
#DIM DYNAMIC cNUM
#DIM DYNAMIC EXTRA_TITLE_NO
#DIMS DYNAMIC L_RESULTS
#DIMS DYNAMIC L_TYPE
SELECTCASE L_TYPE
	CASE "キャラ画像"
		L_RESULTS '= "10_キャラ画像"
		IF CSVCFLAG(cNUM, GETNUM(CFLAG, "작품코드"))
			L_RESULTS += "\\" + "01_人間"
			SELECTCASE CSVCFLAG(cNUM, GETNUM(CFLAG, "작품코드")) / 100
				CASE 1
					L_RESULTS += "\\" + "01_デジタル・デビル物語"
				CASE 2
					L_RESULTS += "\\" + "02_真・女神転生"
				CASE 3
					L_RESULTS += "\\" + "03_デビルサマナー"
				CASE 4
					L_RESULTS += "\\" + "04_ペルソナ"
				CASE 5
					L_RESULTS += "\\" + "05_外伝シリーズ"
				CASE 6
					L_RESULTS += "\\" + "06_その他メディア"
				CASE 9
					L_RESULTS += "\\" + "09_ShinEraTenseiオリジナル"
			ENDSELECT
		ELSE
			EXTRA_TITLE_NO = CSVCFLAG(cNUM, GETNUM(CFLAG, "EXTRA출전"))
			SIF EXTRA_TITLE_NO >= VARSIZE("EXTRA_TITLE")
				RETURNF ""
			L_RESULTS '= "10_キャラ画像"
			IF EXTRA_TITLE_NO <= 0
				IF CSVABL(cNUM, GETNUM(ABL, "종족")) > 0
					L_RESULTS += "\\" + "00_悪魔"
					;30番以前の種族はCSV番号の頭と種族番号がずれてる ;KR판 변경 : GET_RACE(CSVABL... >> GET_RACE_IMG(CSVABL
					IF CSVABL(cNUM, GETNUM(ABL, "종족")) < 30
						L_RESULTS += "\\" + TOSTR(CSVABL(cNUM, GETNUM(ABL, "종족")) -1,"0#") + "_" + GET_RACE_IMG(CSVABL(cNUM, GETNUM(ABL, "종족")))
					ELSE
						L_RESULTS += "\\" + TOSTR(CSVABL(cNUM, GETNUM(ABL, "종족")),"0#") + "_" + GET_RACE_IMG(CSVABL(cNUM, GETNUM(ABL, "종족")))
					ENDIF
				ELSE
					L_RESULTS += "\\" + "01_人間"
				ENDIF
			ELSE
				IF EXTRA_TITLE:EXTRA_TITLE_NO == "ユーザー投稿"
					L_RESULTS += "\\" + "03_ユーザー投稿"
				ELSE
					L_RESULTS += "\\" + "02_EX"
					IF EXTRA_TITLE:EXTRA_TITLE_NO == ""
						L_RESULTS += "\\" + "98_未分類"
					ELSE
						L_RESULTS += "\\" + TOSTR(EXTRA_TITLE_NO,"0#") + "_" + EXTRA_TITLE:EXTRA_TITLE_NO
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		L_RESULTS += "\\" + TOSTR(cNUM) + "_" + GET_識別名(cNUM)
	CASE "ユーザー自作"
		L_RESULTS '= "00_ユーザー追加アイコン"
ENDSELECT
RETURNF L_RESULTS

@RPG画像追加, L_SITUATION, L_NUM = -1
#DIMS DYNAMIC L_SITUATION
#DIM DYNAMIC L_NUM
IF L_SITUATION == ""
	SELECTCASE FLAG:SHOP커맨드
		CASE [[ショップ:탐색]]
			L_SITUATION = DUNGEON
		CASE [[ショップ:콜로세움참가]]
			L_SITUATION = COLOSSEUM
		CASE [[ショップ:이벤트]]
			L_SITUATION = EVENT
		CASE [[ショップ:의뢰청부]]
			L_SITUATION = REQUEST
	ENDSELECT
ENDIF
IF L_NUM == -1
	SELECTCASE L_SITUATION
		CASE "DUNGEON", "ダンジョン"
			L_NUM = FLAG:현던전
			L_SITUATION = DUNGEON
		CASE "COLOSSEUM", "コロシアム"
			L_NUM = FLAG:진행중콜로세움
			L_SITUATION = DUNGEON
		CASE "EVENT", "이벤트"
			L_NUM = FLAG:진행중이벤트
			L_SITUATION = EVENT
		CASE "REQUEST", "依頼"
			L_NUM = FLAG:진행중의뢰
			L_SITUATION = REQUEST
	ENDSELECT
ENDIF
VARI LCOUNT
VARI GID
VARS L_FILENAME
VARS L_SPRITENAME
FOR LCOUNT, 0, QUEST_GIDNUM
	GID = QUEST_GIDNUM_START + LCOUNT
	GDISPOSE GID
	L_FILENAME '= TOSTR(LCOUNT) + ".png"
	L_SPRITENAME '= "PICTURE_" + TOSTR(LCOUNT, "000")
	;名称定義関数がある場合は上書き
	IF EXISTFUNCTION(@"PICTURENAME_TABLE_%L_SITUATION%_{L_NUM}")
		RESULTS_F '= "", ""
		CALLFORMF PICTURENAME_TABLE_%L_SITUATION%_{L_NUM}, LCOUNT
		IF RESULTS_F != ""
			L_SPRITENAME '= RESULTS_F
			;スプライト名と画像名をかえる場合はRESULTS_F:1を使う
			IF RESULTS_F:1 == ""
				L_FILENAME '= RESULTS_F + ".png"
			ELSE
				L_FILENAME '= RESULTS_F:1 + ".png"
			ENDIF
		ENDIF
	ENDIF
	SELECTCASE L_SITUATION
		CASE "DUNGEON"
			L_FILENAME '= "20_ダンジョン画像" + "//" + TOSTR(L_NUM, "000") + "_" + GET_DUNGEON_NAME(L_NUM, 1) + "//"  + L_FILENAME
		CASE "COLOSSEUM"
			L_FILENAME '= "30_コロシアム画像" + "//" + TOSTR(L_NUM, "000") + "_" + GET_COLOSSEUM_NAME(L_NUM) + "//"  + L_FILENAME
		CASE "EVENT"
			L_FILENAME '= "40_イベント画像" + "//" + TOSTR(L_NUM, "000") + "_" + GET_EVENT_NAME(L_NUM) + "//"  + L_FILENAME
		CASE "REQUEST"
			L_FILENAME '= "50_依頼画像" + "//" + TOSTR(L_NUM, "000") + "_" + GET_REQUEST_NAME(L_NUM) + "//"  + L_FILENAME
	ENDSELECT
	IF GCREATEFROMFILE(GID, L_FILENAME)
		SPRITECREATE L_SPRITENAME, GID, 0, 0, GWIDTH(GID), GHEIGHT(GID)
		QUEST_GID_SPRITENAME '= L_SPRITENAME
	ENDIF
NEXT
SELECTCASE L_SITUATION
	CASE "DUNGEON", "ダンジョン"
		TRYCALLFORM ADD_PICTURE_DUNGEON_{L_NUM}
	CASE "COLOSSEUM", "コロシアム"
		TRYCALLFORM ADD_PICTURE_COLOSSEUM_{L_NUM}
	CASE "EVENT", "이벤트"
		TRYCALLFORM ADD_PICTURE_EVENT_{L_NUM}
	CASE "REQUEST", "依頼"
		TRYCALLFORM ADD_PICTURE_REQUEST_{L_NUM}
ENDSELECT

;"タイプ_性別_髪型_FACE_番号"となっている。
@ランダムキャラ_顔グラ追加_F, L_SPRITENAME
#FUNCTION
#DIMS DYNAMIC L_SPRITENAME
#DIM DYNAMIC gID
#DIMS DYNAMIC L_FILENAME
#DIMS DYNAMIC TEMPS, 4
;すでに作成されてる場合は成功したものとして返す
SIF SPRITECREATED(L_SPRITENAME)
	RETURNF 1
SPLIT L_SPRITENAME, "_", TEMPS
L_FILENAME '= "11_ランダムキャラ画像" + "//" + TEMPS:0 + "//" + TEMPS:1 + "//" + TEMPS:2 + "//" + L_SPRITENAME + ".png"

gID = FINDELEMENT(USED_CHARA_GID, 0)
GDISPOSE gID
SIF !GCREATEFROMFILE(gID, L_FILENAME)
	RETURNF 0
;登録に成功したので使用済みにする
USED_CHARA_GID:gID = 1
;ファイル名を登録する
CHARA_GID_SPRITENAME:gID '= L_SPRITENAME

SPRITEDISPOSE L_SPRITENAME
;スプライト作成
SPRITECREATE L_SPRITENAME, gID, 0, 0, MIN(GHEIGHT(gID), GWIDTH(gID)), MIN(GHEIGHT(gID), GWIDTH(gID))
RETURNF 1

@DISPOSE_GRAPHICS, ARGS
#DIM DYNAMIC LCOUNT
SELECTCASE ARGS
	CASE "CHARA"
		FOR LCOUNT, 2, CHARA_GIDNUM
			SIF !USED_CHARA_GID:LCOUNT
				BREAK
			SPRITEDISPOSE CHARA_GID_SPRITENAME:LCOUNT
			GDISPOSE LCOUNT
		NEXT
		VARSET IS_TRYMAKE_FACE
		VARSET USED_CHARA_GID
		VARSET CHARA_GID_SPRITENAME
	CASE "QUEST"
		FOR LCOUNT, 0, QUEST_GIDNUM
			SPRITEDISPOSE QUEST_GID_SPRITENAME:LCOUNT
			GDISPOSE QUEST_GIDNUM_START + LCOUNT
		NEXT
	CASE "TEMP"
		FOR LCOUNT, 0, VARSIZE("TEMP_GID_SPRITENAME")
			SIF TEMP_GID_SPRITENAME:LCOUNT == ""
				BREAK
			SPRITEDISPOSE TEMP_GID_SPRITENAME:LCOUNT
		NEXT
		FOR LCOUNT, 0, VARSIZE("USED_TEMP_GID")
			GDISPOSE TEMP_GID_START + LCOUNT
		NEXT
		VARSET USED_TEMP_GID
		VARSET USED_TEMP_GIDNAME
		VARSET TEMP_GID_SPRITENAME
ENDSELECT

