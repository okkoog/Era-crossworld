#DIMS CONST ICON_SITUATION = "基本", "悪魔変身", "調教"
#DIMS CONST G_OPT_USE_ICON_TABLE = "使用", "사용안함", "鬼アイコン"
#DIMS GLOBAL SAVEDATA G_OPT_USE_ICON												;アイコンを使うかどうか
#DIMS CONST	G_OPT_REPLACE_ICON_TABLE = "種族アイコン", "鬼アイコン"									
#DIMS GLOBAL SAVEDATA G_OPT_REPLACE_ICON											;アイコンがないときに種族アイコンと鬼マークどっちを使うか
#DIM GLOBAL SAVEDATA G_OPT_NOT_USE_ICON_AT_TRAIN									;調教でアイコンを使うかどうか
#DIMS CONST G_OPT_USE_LINK_DEVIL_ICON_TABLE = "リンク優先", "リンク不使用", "固有優先使用"
#DIMS GLOBAL SAVEDATA G_OPT_USE_LINK_DEVIL_ICON									;悪魔変身の際のアイコン設定
