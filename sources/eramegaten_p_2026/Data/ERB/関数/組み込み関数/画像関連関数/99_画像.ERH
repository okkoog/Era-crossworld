#DIM CONST ICONNUM = 100
#DIM CONST FACE_RACE_MARK_NUM = 998
#DIM CONST FACE_ONI_MARK_NUM = 999

#DIM CHARADATA C_TRYED_SET_FACE;キャラの顔アイコンのデフォルトセットがあったかどうか

;-----------------------------------------------------------
;画像エディット用
;-----------------------------------------------------------
#DIMS 画像エディット_上部選択項目文字列
#DIMS 画像エディット_パーツ文字列
#DIMS 画像エディット_パーツセット名 = "default"
#DIM 画像エディット_顔絵フラグ
#DIM 画像エディット_全要素装飾指定率 = 25
#DIM 画像エディット_全装飾装飾指定率 = 50
#DIMS 画像エディット_設定画面リスト = "全画面,基本,悪魔変身,調教"

; 初期表示するテンプレート
{
#DIMS 画像エディット_パーツ固定設定 = ""
+ "[前髪:なし][後髪:なし][頭部:なし][目瞳:なし][表情:なし][身体:なし]"
+ "[装飾0:なし][装飾1:なし][装飾2:なし][装飾3:固定][装飾4:固定][装飾5:固定][装飾6:固定][装飾7:固定][装飾8:固定][装飾9:固定]"
+ "[髪色:なし][瞳色:なし][肌色:なし][服色:なし][耳色:なし][尾色:なし]"
}
