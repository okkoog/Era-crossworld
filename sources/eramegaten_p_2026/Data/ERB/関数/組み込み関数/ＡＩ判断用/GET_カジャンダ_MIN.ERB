;====================================================
;状態異常の判定関数
;====================================================
@GET_カジャンダ_MIN, ARG
#FUNCTION
#DIM LCOUNT
#DIM L_RESULT
L_RESULT = 999
FOR LCOUNT, 0, VARSIZE("BASE_KAJA_TABLE")
	L_RESULT = MIN(CFLAG:ARG:(BASE_KAJA_TABLE:LCOUNT + "강화"), L_RESULT)
NEXT
RETURNF L_RESULT