;====================================================
;状態異常の判定関数
;====================================================
@GET_カジャンダ_SUM, ARG
#FUNCTION
#DIM LCOUNT
#DIM L_RESULT
L_RESULT = 0
FOR LCOUNT, 0, VARSIZE("BASE_KAJA_TABLE")
	L_RESULT += CFLAG:ARG:(BASE_KAJA_TABLE:LCOUNT + "강화")
NEXT
RETURNF L_RESULT