;====================================================
;ランダムな味方一人のキャラ登録番号を取得する
;====================================================
@GET_RANDOM_FRIEND
#FUNCTION
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_TABLE = 1, 2, 3, 4, 5, 6
FOR LCOUNT, 0, VARSIZE("L_TABLE")
	SWAP L_TABLE:(RAND:VARSIZE("L_TABLE")), L_TABLE:(RAND:VARSIZE("L_TABLE"))
NEXT
FOR LCOUNT, 0, VARSIZE("L_TABLE")
	SIF !IS_TARGET_ABLE(POS(L_TABLE:LCOUNT))
		CONTINUE
	RETURNF L_TABLE:LCOUNT
NEXT
RETURNF -1