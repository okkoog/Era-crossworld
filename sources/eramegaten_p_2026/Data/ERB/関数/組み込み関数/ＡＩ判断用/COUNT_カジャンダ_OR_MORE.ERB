;====================================================
;状態異常の判定関数
;====================================================
@COUNT_カジャンダ_OR_MORE, ARG, ARG:1
#FUNCTION
#DIM LCOUNT
#DIM L_RESULT
L_RESULT = 0
FOR LCOUNT, 0, VARSIZE("BASE_KAJA_TABLE")
	SIF CFLAG:ARG:(BASE_KAJA_TABLE:LCOUNT + "강화") >= ARG:1
		L_RESULT += 1
NEXT
RETURNF L_RESULT