;=================================================
;着衣に関するFUNCTION
;=================================================

@CLOTHESNAMEF(ARG = -99,ARG:1)
#FUNCTIONS
SIF ARG == -99
	ARG = TARGET
IF ARG:1 < 0 || ARG:1 > 13
	PRINTFORM %CALLNAME:ARG%의 의상명을 참조할 때 올바르지 않은 번호 {ARG:1}이(가) 의상 부위로 지정되었습니다
	PRINTFORM 의도치 않은 동작・버그일 가능성이 높으므로 보고를 부탁드립니다
	RETURNF "不正な衣装名"
ENDIF
RETURNF GET_衣装名(CFLAG:ARG:(GET_CLOTHESNAME(ARG:1)))

