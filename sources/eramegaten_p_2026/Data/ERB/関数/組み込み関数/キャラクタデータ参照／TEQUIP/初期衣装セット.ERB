;-------------------------------------------------
;キャラクターに指定した衣装をセットする
;-------------------------------------------------
@初期衣装セット, L_CHARA = -1,L_CLOTHESNAME:0, L_CLOTHESNAME:1, L_CLOTHESNAME:2, L_CLOTHESNAME:3, L_CLOTHESNAME:4, L_CLOTHESNAME:5, L_CLOTHESNAME:6, L_CLOTHESNAME:7, L_CLOTHESNAME:8, L_CLOTHESNAME:9, L_CLOTHESNAME:10, L_CLOTHESNAME:11, L_CLOTHESNAME:12, L_CLOTHESNAME:13
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_CLOTHESNAME, 14
#DIMS DYNAMIC TEQUIP_CLOTHES, 14
#DIMS L_CLOTH
SIF L_CHARA == -1
	L_CHARA = TARGET
;衣装をひっぺがす
FOR LCOUNT, 0, 14
	CFLAG:L_CHARA:GET_CLOTHESNAME(LCOUNT) = 0
	CFLAG:L_CHARA:("초기" + GET_CLOTHESNAME(LCOUNT)) = -1
	TEQUIP:L_CHARA:GET_CLOTHESNAME(LCOUNT) = 0
NEXT

;引数の衣装をセットしていく
FOR LCOUNT, 0, 14
	SIF L_CLOTHESNAME:LCOUNT == ""
		CONTINUE
	;部位を取得
	CALLFORM CLOTHES_PART_{GET_CLOTHESNUM(L_CLOTHESNAME:LCOUNT)}
	L_CLOTH '= GET_CLOTHESNAME(RESULT)
	IF L_CLOTH == "그외" 
		SIF CFLAG:L_CHARA:그외 != 0
			L_CLOTH = 그외2
		SIF CFLAG:L_CHARA:그외2 != 0
			L_CLOTH = 그외3
	ENDIF
	CFLAG:L_CHARA:L_CLOTH = GET_CLOTHESNUM(L_CLOTHESNAME:LCOUNT)
	CFLAG:L_CHARA:L_CLOTH = GET_CLOTHESNUM(L_CLOTHESNAME:LCOUNT)
	SIF FLAG:SHOP커맨드 == [[ショップ:조교한다]]
		TEQUIP:L_CHARA:L_CLOTH = GET_CLOTHESNUM(L_CLOTHESNAME:LCOUNT)
NEXT