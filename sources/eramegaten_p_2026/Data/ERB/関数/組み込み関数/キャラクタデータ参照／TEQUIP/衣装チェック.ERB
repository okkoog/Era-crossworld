;-------------------------------------------------
;キャラクターが指定した衣装をつけているかチェック
;-------------------------------------------------
@衣装チェック, L_CHARA = -1,L_CLOTHESNAME:0, L_CLOTHESNAME:1, L_CLOTHESNAME:2, L_CLOTHESNAME:3, L_CLOTHESNAME:4, L_CLOTHESNAME:5, L_CLOTHESNAME:6, L_CLOTHESNAME:7, L_CLOTHESNAME:8, L_CLOTHESNAME:9, L_CLOTHESNAME:10, L_CLOTHESNAME:11, L_CLOTHESNAME:12, L_CLOTHESNAME:13
#FUNCTION
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_CHARA				;キャラクター登録番号。省略した場合はTARGET
#DIMS DYNAMIC L_CLOTHESNAME, 14		;衣装名、部位は指定する必要なし。「/」でor部位内OR指定
#DIM IS_EXIST_CLOTH
#DIMS DYNAMIC L_SPLIT_CLOTHESNAME, 10
#DIMS DYNAMIC TEQUIP_CLOTHES, 14

#DIM L_CLOTH
SIF L_CHARA == -1
	L_CHARA = TARGET
;配列に現在の衣装を格納
FOR LCOUNT, 0, 14
	L_CLOTH = FLAG:SHOP커맨드 == [[ショップ:조교한다]] ? TEQUIP:L_CHARA:GET_CLOTHESNAME(LCOUNT) # CFLAG:L_CHARA:GET_CLOTHESNAME(LCOUNT)
	IF L_CLOTH == 0
		TEQUIP_CLOTHES:LCOUNT '= GET_CLOTHESNAME(LCOUNT) + "非着用"
		;2と3をまとめる
		SIF GROUPMATCH(GET_CLOTHESNAME(LCOUNT), "그외2", "그외3")
			TEQUIP_CLOTHES:LCOUNT '= "その他非着用"
	ELSE
		TEQUIP_CLOTHES:LCOUNT '= ITEMNAME:(6000 + L_CLOTH)
	ENDIF
NEXT

;引数の服装が配列にはいってなければアウト
FOR LCOUNT, 0, 14
	SIF L_CLOTHESNAME:LCOUNT == ""
		CONTINUE
	IS_EXIST_CLOTH = 0
	SPLIT L_CLOTHESNAME:LCOUNT, "/", L_SPLIT_CLOTHESNAME
	FOR LCOUNT:1, 0, RESULT
		SIF !MATCH(TEQUIP_CLOTHES, L_SPLIT_CLOTHESNAME:(LCOUNT:1))
			CONTINUE
		;その他は全スロットが開いている必要がある
		IF L_SPLIT_CLOTHESNAME:(LCOUNT:1) == "その他非着用"
			SIF MATCH(TEQUIP_CLOTHES, L_SPLIT_CLOTHESNAME:(LCOUNT:1)) < 3
				CONTINUE
		ENDIF
		IS_EXIST_CLOTH = 1
	NEXT
	SIF !IS_EXIST_CLOTH
		RETURNF 0
NEXT
RETURNF 1