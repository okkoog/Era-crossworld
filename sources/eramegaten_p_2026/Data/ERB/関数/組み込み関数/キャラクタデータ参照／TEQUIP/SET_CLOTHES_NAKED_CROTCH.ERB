;==================================================
;股間脱衣/노출
;ARG:1 脱衣オプション  1 服のみ脱衣(下着は残す)
;==================================================
@SET_CLOTHES_NAKED_CROTCH,ARG,ARG:1 = 0

IF TEQUIP:ARG:하의 != 0 
	;下衣がある場合、股間構造がズボンタイプなら脱がす
	TRYCCALLFORM CLOTHES_CROTCH_{TEQUIP:ARG:하의}
		SIF RESULT == 1
			TEQUIP:ARG:하의 = 0
	CATCH
	ENDCATCH
ENDIF
IF TEQUIP:ARG:전신복 != 0 
	;全身服がある場合、股間構造がズボンタイプなら脱がす
	TRYCCALLFORM CLOTHES_CROTCH_{TEQUIP:ARG:전신복}
		SIF RESULT == 1
			TEQUIP:ARG:전신복 = 0
	CATCH
	ENDCATCH
ENDIF
IF TEQUIP:ARG:겉옷 != 0 
	;上着がある場合、股間構造がズボンタイプなら脱がす
	TRYCCALLFORM CLOTHES_CROTCH_{TEQUIP:ARG:겉옷}
		SIF RESULT == 1
			TEQUIP:ARG:겉옷 = 0
	CATCH
	ENDCATCH
ENDIF
IF TEQUIP:ARG:양말 != 0 
	;靴下がある場合、股間構造がズボンタイプなら脱がす(多分パンストぐらいとは思うが)
	TRYCCALLFORM CLOTHES_CROTCH_{TEQUIP:ARG:양말}
		SIF RESULT == 1
			TEQUIP:ARG:양말 = 0
	CATCH
	ENDCATCH
ENDIF

IF ARG:1 == 0
	;一旦ここでチェック
	CALL ずらしチェック(ARG)
	CALL 股間構造チェック,ARG
	
	IF (TEQUIP:ARG:고간구조 & (1 + 2 + 4 + 8 + 16)) && TEQUIP:ARG:Ｖ비켜놓기가능
		;前開き可なら開ける
		INVERTBIT TEQUIP:ARG:고간앞열림 , 0
		;Vずらし中の状態も設定
		TEQUIP:ARG:V비켜놓기중 = -1
	ELSE
		;前開き不可の場合、脱がす
		CALL SET_CLOTHES_DROP_INNER, ARG, 2
	ENDIF
ENDIF

;再度チェック
CALL おっぱいオープンチェック(ARG)
CALL CHECK_EXPOSE(ARG)
CALL 股間構造チェック,ARG
CALL 触覚チェック(ARG)
CALL ずらしチェック(ARG)

