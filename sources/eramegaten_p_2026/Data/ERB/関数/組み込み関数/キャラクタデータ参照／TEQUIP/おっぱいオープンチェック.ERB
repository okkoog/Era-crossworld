;=================================================
;おっぱいオープンのチェック
;=================================================
@おっぱいオープンチェック,ARG
#DIM 衣装部位 , 1
#DIM オープン可否 , 14
#LOCALSIZE 1

VARSET オープン可否 , 0
TEQUIP:ARG:가슴구조 = 0
FOR 衣装部位 , 0 , 14
	RESULT = 0
	TRYCALLFORM CLOTHES_EXPOSE_{TEQUIP:ARG:GET_CLOTHESNAME(衣装部位)},4
	RESULT:1 = RESULT
	TRYCALLFORM CLOTHES_EXPOSE_{TEQUIP:ARG:GET_CLOTHESNAME(衣装部位)},5
	SIF RESULT == 1 && RESULT:1 == 1
		CONTINUE
	TRYCCALLFORM CLOTHES_BREAST_{TEQUIP:ARG:GET_CLOTHESNAME(衣装部位)}
		IF RESULT == 0
			TEQUIP:ARG:가슴앞열림 = 0
			RETURN 0
		ENDIF
		オープン可否:衣装部位 = RESULT
	CATCH
		TEQUIP:ARG:가슴앞열림 = 0
		RETURN 0
	ENDCATCH
NEXT
;그외→겉옷→전신복→옷→하의→모자→신발→전신속옷→손→양말→下着上下
IF オープン可否:10
	TEQUIP:ARG:가슴구조 = オープン可否:10
ELSEIF オープン可否:3
	TEQUIP:ARG:가슴구조 = オープン可否:3
ELSEIF オープン可否:1
	TEQUIP:ARG:가슴구조 = オープン可否:1
ELSEIF オープン可否:2
	TEQUIP:ARG:가슴구조 = オープン可否:2
ELSEIF オープン可否:0
	TEQUIP:ARG:가슴구조 = オープン可否:0
ELSEIF オープン可否:9
	TEQUIP:ARG:가슴구조 = オープン可否:9
ELSEIF オープン可否:7
	TEQUIP:ARG:가슴구조 = オープン可否:7
ELSEIF オープン可否:4
	TEQUIP:ARG:가슴구조 = オープン可否:4
ELSEIF オープン可否:8
	TEQUIP:ARG:가슴구조 = オープン可否:8
ELSEIF オープン可否:5
	TEQUIP:ARG:가슴구조 = オープン可否:5
ELSEIF オープン可否:6
	TEQUIP:ARG:가슴구조 = オープン可否:6
ENDIF

