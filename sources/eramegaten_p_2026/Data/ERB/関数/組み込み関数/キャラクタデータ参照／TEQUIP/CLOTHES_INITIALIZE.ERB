;==================================================
;着衣の初期化処理
;==================================================
@CLOTHES_INITIALIZE,ARG
#DIM LCOUNT
LOCAL = 1
FOR LCOUNT, 0, 14
	SELECTCASE CFLAG:ARG:("초기" + GET_CLOTHESNAME(LCOUNT))
		CASE -1
			CFLAG:ARG:(GET_CLOTHESNAME(LCOUNT)) = 0
		CASE 0
			CFLAG:ARG:(GET_CLOTHESNAME(LCOUNT)) = CSVCFLAG(NO:ARG, GETNUM(CFLAG, GET_CLOTHESNAME(LCOUNT)),0)
		CASEELSE
			CFLAG:ARG:(GET_CLOTHESNAME(LCOUNT)) = CFLAG:ARG:("초기" + GET_CLOTHESNAME(LCOUNT))
	ENDSELECT
	SIF CFLAG:ARG:(GET_CLOTHESNAME(LCOUNT)) < 0
		CFLAG:ARG:(GET_CLOTHESNAME(LCOUNT)) = 0
	SIF CFLAG:ARG:GET_CLOTHESNAME(LCOUNT)
		CFLAG:ARG:전회조교시의복장기록 |= LOCAL
	LOCAL *= 2
NEXT

