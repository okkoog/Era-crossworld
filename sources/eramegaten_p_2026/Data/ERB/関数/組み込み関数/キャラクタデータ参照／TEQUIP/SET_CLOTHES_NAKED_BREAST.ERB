;==================================================
;胸脱衣/노출
;ARG:1 脱衣オプション  1 服のみ脱衣(下着は残す)
;==================================================
@SET_CLOTHES_NAKED_BREAST,ARG,ARG:1 = 0

IF TEQUIP:ARG:옷 != 0 
	;服がある場合、胸構造が開けられないなら脱がす
	TRYCCALLFORM CLOTHES_BREAST_{TEQUIP:ARG:옷}
		SIF RESULT == 0
			TEQUIP:ARG:옷 = 0
	CATCH
	ENDCATCH
ENDIF
IF TEQUIP:ARG:전신복 != 0 
	;全身服がある場合、胸構造が開けられないなら脱がす
	TRYCCALLFORM CLOTHES_BREAST_{TEQUIP:ARG:전신복}
		SIF RESULT == 0
			TEQUIP:ARG:전신복 = 0
	CATCH
	ENDCATCH
ENDIF
IF TEQUIP:ARG:겉옷 != 0 
	;上着がある場合、胸構造が開けられないなら脱がす
	TRYCCALLFORM CLOTHES_BREAST_{TEQUIP:ARG:겉옷}
		SIF RESULT == 0
			TEQUIP:ARG:겉옷 = 0
	CATCH
	ENDCATCH
ENDIF

IF ARG:1 == 0
	;一旦ここでチェック
	CALL おっぱいオープンチェック(ARG)
	
	IF (TEQUIP:ARG:가슴구조 & (1 + 2 + 4 + 8 + 16))
		INVERTBIT TEQUIP:ARG:가슴앞열림 , 0;EDIT 002 MOD
	ELSE
		;前開き不可の場合、脱がす
		CALL SET_CLOTHES_DROP_INNER, ARG, 1
	ENDIF
ENDIF


CALL おっぱいオープンチェック(ARG)
CALL CHECK_EXPOSE(ARG)
CALL 股間構造チェック,ARG
CALL 触覚チェック(ARG)
CALL ずらしチェック(ARG)

