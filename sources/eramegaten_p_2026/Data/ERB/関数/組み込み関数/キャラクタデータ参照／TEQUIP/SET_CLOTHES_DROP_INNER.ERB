;==================================================
;脱衣処理
;下着(インナー)脱衣
;ARG:1 脱衣オプション 1 下着(上)のみ脱衣、2 下着(下)のみ脱衣
;==================================================
@SET_CLOTHES_DROP_INNER,ARG,ARG:1 = 0

SIF TEQUIP:ARG:속옷（상） != 0 && ARG:1 != 2
	TEQUIP:ARG:속옷（상） = 0
SIF TEQUIP:ARG:속옷（하） != 0 && ARG:1 != 1
	TEQUIP:ARG:속옷（하） = 0
SIF TEQUIP:ARG:전신속옷 != 0
	TEQUIP:ARG:전신속옷 = 0

;下半身を全て脱衣している場合、Vずらし中の状態もリセット
IF TEQUIP:ARG:전신복 == 0 && TEQUIP:ARG:하의 == 0 && TEQUIP:ARG:전신속옷 == 0 && TEQUIP:ARG:속옷（하） == 0
	SIF TEQUIP:ARG:V비켜놓기중 == -1
		TEQUIP:ARG:V비켜놓기중 = 0
ENDIF

CALL おっぱいオープンチェック(ARG)
CALL CHECK_EXPOSE(ARG)
CALL 股間構造チェック,ARG
CALL 触覚チェック(ARG)
CALL ずらしチェック(ARG)

