;-------------------------------------------------
;L_CHARAの衣装をL_CHARA:1にひきうつす
;-------------------------------------------------
@初期衣装コピー, L_CHARA, L_CHARA:1
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA, 2
FOR LCOUNT, 0, 14
	CFLAG:(L_CHARA:1):GET_CLOTHESNAME(LCOUNT) = CFLAG:(L_CHARA):GET_CLOTHESNAME(LCOUNT)
	CFLAG:(L_CHARA:1):("초기" + GET_CLOTHESNAME(LCOUNT)) = CFLAG:(L_CHARA):("초기" + GET_CLOTHESNAME(LCOUNT))
	TEQUIP:(L_CHARA:1):GET_CLOTHESNAME(LCOUNT) = TEQUIP:(L_CHARA):GET_CLOTHESNAME(LCOUNT)
NEXT
