;==================================================
;脱衣処理
;하의(ボトムズ)脱衣
;==================================================
@SET_CLOTHES_DROP_BOTTOMS,ARG

SIF TEQUIP:ARG:전신복 != 0
	TEQUIP:ARG:전신복 = 0 
SIF TEQUIP:ARG:하의 != 0
	TEQUIP:ARG:하의 = 0

;下半身を全て脱衣している場合、Vずらし中の状態もリセット
IF TEQUIP:ARG:전신복 == 0 && TEQUIP:ARG:하의 == 0 && TEQUIP:ARG:전신속옷 == 0 && TEQUIP:ARG:속옷（하） == 0
	SIF TEQUIP:ARG:V비켜놓기중 == -1
		TEQUIP:ARG:V비켜놓기중 = 0
ENDIF

CALL おっぱいオープンチェック(ARG)
CALL CHECK_EXPOSE(ARG)
CALL 股間構造チェック,ARG
CALL 触覚チェック(ARG)
CALL ずらしチェック(ARG)

