;着衣に関するFUNCTION
;=================================================

@GET_CLOTHESNAME(ARG)
#FUNCTIONS
IF ARG < 12
	RETURNF TEQUIPNAME:(GETNUM(TEQUIP,"모자")+ARG)
ELSE
	RETURNF TEQUIPNAME:(GETNUM(TEQUIP,"그외2")+(ARG-12))
ENDIF
