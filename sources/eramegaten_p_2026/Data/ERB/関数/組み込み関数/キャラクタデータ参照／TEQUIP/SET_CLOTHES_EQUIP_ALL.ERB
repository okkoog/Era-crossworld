;==================================================
;脱衣処理
;全て着衣
;==================================================
@SET_CLOTHES_EQUIP_ALL,ARG

FOR LOCAL, 0, 14
	TEQUIP:ARG:(GET_CLOTHESNAME(LOCAL)) = CFLAG:ARG:(GET_CLOTHESNAME(LOCAL))
NEXT

;Vずらし中だった場合、そちらもリセット
SIF TEQUIP:ARG:V비켜놓기중 == -1
	TEQUIP:ARG:V비켜놓기중 = 0

CALL おっぱいオープンチェック(ARG)
CALL CHECK_EXPOSE(ARG)
CALL 股間構造チェック,ARG
CALL 触覚チェック(ARG)
CALL ずらしチェック(ARG)

