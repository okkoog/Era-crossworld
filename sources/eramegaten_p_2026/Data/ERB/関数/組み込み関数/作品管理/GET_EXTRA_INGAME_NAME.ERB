;作品タイトルの定義関数
;ARG:1 = CSVNO指定でCSVから情報をとれる場合
;ARG:2 = 短縮表示
@GET_EXTRA_INGAME_NAME, ARG, ARG:1 = -1, ARG:2
#FUNCTIONS
SELECTCASE ARG
	CASE -2
		RETURNF "위전"
	CASE -1
		RETURNF "데빌칠드런"
	CASE 0
		RETURNF "여신전생 시리즈"
	CASE 1
		IF ARG:2
			RETURNF "슈퍼로봇대전"
		ELSE
			RETURNF "슈퍼로봇대전 시리즈"
		ENDIF
	CASE 2
		RETURNF "DemonParasite"
	CASE 3
		RETURNF "MeltyBlood"
	CASE 4
		RETURNF "FATE"
	CASE 5
		RETURNF "마도카☆마기카"
	CASE 6
		RETURNF "동방Project"
	CASE 7
		RETURNF "IdolMaster"
	CASE 8
		RETURNF "유☆희☆왕"
	CASE 9
		RETURNF "InternetMeme"
	CASE 10
		RETURNF "도시전설"
	CASE 11
		RETURNF "골동품수집"
	CASE 12
		RETURNF "치이카와"
	CASE 13
		IF ARG:2
			RETURNF "스타라이트"
		ELSE
			RETURNF "소녀 가극 레뷰 스타라이트"
		ENDIF
	CASE 14
		RETURNF "7thDragon"
	CASE 15
		RETURNF "Helltaker"
	CASE 16
		RETURNF "Rabi-Ribi"
	CASE 17
		RETURNF "아카츠키"
	CASE 18
		RETURNF "하얀 강철의 Ｘ"
	CASE 19
		RETURNF "아머드코어"
	CASE 20
		RETURNF "도쿄마인학원"
	CASE 21
		RETURNF "건퍼레이드마치"
	CASE 22
	CASE 23
		RETURNF "용철의 마르푸샤"
	CASE 24
		RETURNF "DemonsRoots"
	CASE 25
		RETURNF "NEEDY GIRL OVERDOSE"
	CASE 26
		RETURNF "대마인"
	CASE 97
		RETURNF "유저투고"
	CASEELSE
		IF ARG:1 >= 0
			IF CSVCSTR(ARG:1, GETNUM(CSTR, "등장작품타이틀")) == ""
				RETURNF "타이틀 미설정"
			ELSE
				RETURNF CSVCSTR(ARG:1, GETNUM(CSTR, "등장작품타이틀"))
			ENDIF
		ELSE
			RETURNF "EXTRA"
		ENDIF
ENDSELECT
