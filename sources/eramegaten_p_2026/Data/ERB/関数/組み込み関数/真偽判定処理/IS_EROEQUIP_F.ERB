;=====================================================================
;エロ装備しているかどうか判断
;=====================================================================
@IS_EROEQUIP_F,ARG = -1
#FUNCTION
SIF ARG == -1
	ARG = PLAYER
SIF EQUIP:ARG:몸통 == GETNUM(ITEM, "하이레그아머")
	RETURNF 1
SIF EQUIP:ARG:몸통 == GETNUM(ITEM, "창부의옷")
	RETURNF 1
SIF EQUIP:ARG:몸통 == GETNUM(ITEM, "배틀레오타드")
	RETURNF 1
SIF EQUIP:ARG:몸통 == GETNUM(ITEM, "무적의미니")
	RETURNF 1
SIF EQUIP:ARG:몸통 == GETNUM(ITEM, "스파이크브라")
	RETURNF 1
SIF EQUIP:ARG:몸통 == GETNUM(ITEM, "배틀캐미솔")
	RETURNF 1
SIF EQUIP:ARG:몸통 == GETNUM(ITEM, "하이레그이너")
	RETURNF 1
;SIF EQUIP:ARG:몸통 == GETNUM(ITEM, "")
;	RETURNF 1
RETURNF 0
