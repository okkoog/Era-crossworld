;----------------------------------------------------------
;@WEEKDAY(ARG)
;ARG番の曜日を返す
;----------------------------------------------------------
@WEEKDAY(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "日"
	CASE 1
		RETURNF "月"
	CASE 2
		RETURNF "火"
	CASE 3
		RETURNF "水"
	CASE 4
		RETURNF "木"
	CASE 5
		RETURNF "金"
	CASE 6
		RETURNF "土"
ENDSELECT
RETURNF "？"