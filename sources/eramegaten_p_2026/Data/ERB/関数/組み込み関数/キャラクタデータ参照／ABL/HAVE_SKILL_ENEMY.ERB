;===============================
;特定のスキルを習得しているかどうか
;ARG 対象のキャラ
;ARG:1 対象のスキル
;ARG:2 位置情報を返すかどうか
;==============================
@HAVE_SKILL_ENEMY(ARG,ARG:1,ARG:2 = 0)
#FUNCTION
#DIM L_T
#DIM LCOUNT
FOR LCOUNT, GET_POS_MIN(!CFLAG:ARG:PT플래그 ? 19 # 22), GET_POS_MIN(!CFLAG:ARG:PT플래그 ? 19 # 22) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	SIF !HAVE_SKILL(L_T, ARG:1)
		CONTINUE
	SIF ARG:2
		RESULT:1 = LCOUNT
	RETURNF 1
NEXT
RETURNF 0