;==========================================================
;特定のスキルを習得しているかどうか
;ARG 対象のキャラ
;ARG:1 対象のスキル
;==========================================================
@CHECK_SKILL(ARG,ARG:1)
#FUNCTION
;ARGがスキルARG:1を持っているかを参照する
;IF TALENT:ARG:이능자 || TALENT:ARG:달인 || TALENT:ARG:인수라
;	FOR LOCAL,1,FLAG:이능자스킬수+1
	LOCAL:1 = CHARA_SKILLCOUNT(ARG) + 1
	FOR LOCAL,1,LOCAL:1
		LOCALS = 스킬{LOCAL}
		SIF ABL:ARG:LOCALS == ARG:1
			RETURNF 1
	NEXT
;ELSE
;	FOR LOCAL,1,FLAG:스킬수+1
;		LOCALS = 스킬{LOCAL}
;		SIF ABL:ARG:LOCALS == ARG:1
;			RETURNF 1
;	NEXT
;ENDIF
RETURNF 0
