;-------------------------------------------------
;関数名:_SKILL_CHECK2
;概　要:スキルが条件に合うかチェックする内部関数
;引　数: ARG:0…調べるキャラの登録番号(並び順)
;　　　 ARGS:0…[省略可]相性(검격/비구/타격/전술/화염/빙결/전격/충격/신경/정신/파마/주살/지변/수격/질풍/중력/핵열/만능/사이코/자동효과)
;　　　 ARGS:1…[省略可]範囲(単体/一列/全体/敵味方全体/範囲) ※範囲=一列+全体
;　　　 ARGS:2…[省略可]効果(공격/회복/状態変化/特殊/状態回復)
;　　　 ARGS:3…[省略可]EXTRAかMAGICか(EXTRA/物理/MAGIC/魔法/OTHER/그외)
;　　　 ARGS:4…[省略可]追加状態異常(GOOD/HAPPY/SHOCK/PANIK/SLEEP/FREEZE/BIND/CLOSE/POISON/BOMB/CHARM/PALYZE/CURSE/FLY/STONE/DYING/ORGY/HEAT)
;　　　  ARG:3…[省略不可]技の威力(スキルの期待値で計算、0で威力不要、-で単発威力の数値未満を出す)
;　　　  ARG:1…[省略可]リンケージのスキル番号(リンケージ参加者のみ必要。発動者は不要)
;　　　  ARG:2…チェックするスキル番号
;　　　         省略された箇所は判定しない
;戻り値:真偽値(0か1)。該当するスキルがあれば真(1)、なければ偽(0)を返す
;備　考:内部関数(他所から使えません)
;-------------------------------------------------
@_SKILL_CHECK2(ARG:0 = -1, ARGS:0, ARGS:1, ARGS:2, ARGS:3, ARGS:4, ARG:3, ARG:1 = -1, ARG:2)
#LOCALSIZE 3
SIF !ARG:2
	RETURN 0

IF ARGS:3 != ""
	RESULT = -1
	CALL GET_SKILL_PROP, "SKILL_DECIDE_TYPE", ARG:2, ARG
	LOCAL:0 = ((ARGS:3 == "EXTRA" || ARGS:3 == "物理") && RESULT == 1) || ((ARGS:3 == "MAGIC" || ARGS:3 == "魔法") && RESULT == 2)
	LOCAL:0 |= (ARGS:3 == "OTHER" || ARGS:3 == "그외") && RESULT != 1 && RESULT != 2
	SIF !LOCAL:0
		RETURN 0
ENDIF

IF ARGS:0 != ""
	CALL GET_SKILL_PROP, "SKILL_TYPE", ARG:2, ARG:0
	SIF RESULT != GET_TYPE_NUM(ARGS:0)
		RETURN 0
ENDIF

IF ARGS:1 != ""
	RESULT = -1
	CALL GET_SKILL_PROP, "SKILL_SPHERE", ARG:2, ARG:0
	LOCAL:0 = (ARGS:1 == "단체" && RESULT == 1) || (ARGS:1 == "일렬" && RESULT == 2) || (ARGS:1 == "전체" && RESULT == 3) || (ARGS:1 == "세로열" && RESULT == 5)
	LOCAL:0 |= (ARGS:1 == "적아군전체" && RESULT == 4) || (ARGS:1 == "範囲" && (RESULT == 2 || RESULT == 3 || RESULT == 5))
	SIF !LOCAL:0
		RETURN 0
ENDIF

IF ARGS:2 != ""
	RESULT = -1
	CALL GET_SKILL_PROP, "SKILL_EFECT", ARG:2, ARG:0
	LOCAL:0 = (ARGS:2 == "공격" && RESULT == 1) || (ARGS:2 == "회복" && RESULT == 2) || (ARGS:2 == "상태변화" && RESULT == 3)
	LOCAL:0 |= (ARGS:2 == "특수" && RESULT == 4) || (ARGS:2 == "상태회복" && RESULT == 5)
	SIF !LOCAL:0
		RETURN 0
ENDIF

IF ARGS:4 != ""
	RESULT = -1
	CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_STATE", ARG:2, ARG:0
	SIF RESULT != GET_STATE_NUM(ARGS:4)
		RETURN 0
ENDIF


IF ARG:3 != 0
	RESULT = -1
	CALL GET_SKILL_PROP, "SKILL_POWER", ARG:2, ARG:0
	LOCAL:0 = RESULT;
	IF ARG:3 > 0
		LOCAL:1 = 0
		LOCAL:2 = -1
		;百烈突き、千烈突き
		IF ARG:2 == [[스킬:백열찌르기]] || ARG:2 == [[스킬:천열찌르기]]
			;최대공격횟수
			CALL GET_SKILL_PROP, "SKILL_MAXATTACKNUMBER", ARG:2, -1
			LOCAL:1 = RESULT;
			;一体辺りの最大ＨＩＴ数
			CALL GET_SKILL_PROP, "SKILL_MAXATK_PER", ARG:2, -1
			LOCAL:2 = RESULT;
			SIF LOCAL:2 > 0
				LOCAL:1 = LOCAL:2
			;　최저공격횟수
			CALL GET_SKILL_PROP, "SKILL_MINATTACKNUMBER", ARG:2, -1
		ELSE
			;최대공격횟수
			CALL GET_SKILL_PROP, "SKILL_MAXATTACKNUMBER", ARG:2, ARG:0
			LOCAL:1 = RESULT;
			;一体辺りの最大ＨＩＴ数
			CALL GET_SKILL_PROP, "SKILL_MAXATK_PER", ARG:2, ARG:0
			LOCAL:2 = RESULT;
			SIF LOCAL:2 > 0
				LOCAL:1 = LOCAL:2
			;　최저공격횟수
			CALL GET_SKILL_PROP, "SKILL_MINATTACKNUMBER", ARG:2, ARG:0
		ENDIF
		LOCAL:2 = RESULT;
		SIF 1 < LOCAL:1 + LOCAL:2
			LOCAL:0 = LOCAL:0 * (LOCAL:1 + LOCAL:2) / 2
			
		SIF LOCAL:0 < ARG:3
			RETURN 0
	ELSE
		ARG:3 = ARG:3 - ARG:3 - ARG:3
		SIF LOCAL:0 >= ARG:3
			RETURN 0
	ENDIF
ENDIF

CALL CHECK_ACTIONABLE(ARG:0, ARG:2)
SIF !RESULT
	RETURN 0

IF INRANGE(ARG:1, 4000, 4999)
	CALL GET_SKILL_PROP, "SKILL_SPECIAL_ACTIONABLE", ARG:1, ARG:0
	SIF !RESULT
		RETURN 0
ENDIF

RETURN 1
