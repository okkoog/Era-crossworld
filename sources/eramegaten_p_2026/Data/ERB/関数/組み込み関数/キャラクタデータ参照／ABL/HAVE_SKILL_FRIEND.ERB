;===============================
;特定のスキルを習得しているかどうか
;ARG 対象のキャラ
;ARG:1 対象のスキル
;ARG:2 健在かどうかを見る
;==============================
@HAVE_SKILL_FRIEND(ARG,ARG:1, ARG:2)
#FUNCTION
#DIM L_T
#DIM LCOUNT
FOR LCOUNT, GET_POS_MIN(!CFLAG:ARG:PT플래그 ? 22 # 19), GET_POS_MAX(!CFLAG:ARG:PT플래그 ? 22 # 19) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	SIF !HAVE_SKILL(L_T, ARG:1)
		CONTINUE
	IF ARG:2
		SIF !ACTIONABLE_CHARA_F(L_T)
			CONTINUE
	ENDIF
	RETURNF 1
NEXT
RETURNF 0

;===============================
;特定のスキルを習得しているかどうか
;ARG 対象のキャラ
;ARGS 対象のスキル
;ARG:1 健在かどうかを見る
;==============================
@HAVE_AW_SKILL_FRIEND(ARG, ARGS, ARG:1 = 0)
#FUNCTION
#DIM L_T
#DIM LCOUNT
FOR LCOUNT, GET_POS_MIN(!CFLAG:ARG:PT플래그 ? 22 # 19), GET_POS_MAX(!CFLAG:ARG:PT플래그 ? 22 # 19) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	SIF !HAVE_AW_SKILL(L_T, ARGS)
		CONTINUE
	IF ARG:1
		SIF !ACTIONABLE_CHARA_F(L_T)
			CONTINUE
	ENDIF
	RETURNF 1
NEXT
RETURNF 0