;-------------------------
;画面表示更新用関数
;ARGS
;	D/DUNGEON/ダンジョン	ダンジョンの一般的な画面表示
;	NONFLOORD				ダンジョンからMAP表示を抜いたもの
;								ARGS:1 入力した場合フロア名の代わりに表示
;								ARGS:2 入力した場合、MAPの代わりに表示
;								ARGS:3 ARGS:2を使う際の区切り文字
;								ARGS:4 ARGS:2を使う際のALIGNMENT
;	再利用					前回の引数を使って実行する
;-------------------------
@SHOW_PICTURE, ARGS, ARGS:1, ARGS:2, ARGS:3 = "/" , ARGS:4 = "LEFT"
#LOCALSIZE 1
#LOCALSSIZE 30
#DIM STOCK_REDRAW
#DIMS 前回ARGS, 4
STOCK_REDRAW = CURRENTREDRAW()
IF ARGS == "再利用" || ARGS == "再利用する"
	FOR LOCAL, 0, 4
		ARGS:LOCAL = %前回ARGS:LOCAL%
	NEXT
ELSE
	FOR LOCAL, 0, 4
		前回ARGS:LOCAL = %ARGS:LOCAL%
	NEXT
ENDIF
SELECTCASE ARGS
	CASE "D", "DUNGEON", "ダンジョン"
		REDRAW 0
		CLEARLINE FLAG:커맨드표시행수 - LINECOUNT
		CALL SHOW_FLOOR
		CALL SHOW_NOW_FORMATION_P,0,2,,"探索中"
		FLAG:커맨드표시행수 = LINECOUNT
		REDRAW STOCK_REDRAW
	CASE "WALK"
		CALL SHOW_FLOOR
		CALL SHOW_NOW_FORMATION_P,0,2,,"探索中"
	CASE "NONFLOORD"
		CUSTOMDRAWLINE =
		IF ARGS:1 == ""
			CALLFORM FLOORNAME_{FLAG:현던전}
		ELSE
			PRINTFORML %ARGS:1%
		ENDIF
		PRINTFORML   ￥{MONEY,8}    스톡 용량: {NUM_NAKAMA()}/{GET_STOCKSIZE()} 사용 중
		PRINTFORM MAG:{GET_CHARA_STOCK_MAG(MASTER),8}    
		IF FLAG:월령 != 0 && FLAG:월령 != 8
			PRINTFORML {FLAG:월령}/8 \@ FLAG:월령벡터 == 0 ? ＹＯＵＮＧ # ＯＬＤ \@ ＭＯＯＮ
		ELSE
			PRINTFORML \@ FLAG:월령 == 8 ? ＦＵＬＬ ＭＯＯＮ # ＮＥＷ ＭＯＯＮ\@
		ENDIF
		IF ARGS:2 == ""
			FOR LOCAL, 0, 18
			;FOR LOCAL, MAX(0, FLAG:현Y - 10 - MAX(0, ((FLAG:현Y+10)-FLAG:최대Y))), MIN(FLAG:현Y+10+MAX(0, 10-FLAG:현Y), FLAG:최대Y)
				PRINTL 
			NEXT
		ELSE
			SELECTCASE ARGS:4
				CASE "CENTER"
					ALIGNMENT CENTER
				CASE "RIGHT"
					ALIGNMENT RIGHT
				CASEELSE
					ALIGNMENT LEFT
			ENDSELECT
			SPLIT ARGS:2, ARGS:3, LOCALS 
			FOR LOCAL, 0, RESULT
				PRINTFORML %LOCALS:LOCAL%
			NEXT
			ALIGNMENT LEFT
		ENDIF
		CALL SHOW_NOW_FORMATION_P,0,2,,"探索中"
		FLAG:커맨드표시행수 = LINECOUNT
	CASE "blank"
		CUSTOMDRAWLINE =
		IF ARGS:1 == ""
			CALLFORM FLOORNAME_{FLAG:현던전}
		ELSE
			PRINTFORML %ARGS:1%
		ENDIF
		IF ARGS:2 == ""
			FOR LOCAL, 0, 18
			;FOR LOCAL, MAX(0, FLAG:현Y - 10 - MAX(0, ((FLAG:현Y+10)-FLAG:최대Y))), MIN(FLAG:현Y+10+MAX(0, 10-FLAG:현Y), FLAG:최대Y)
				PRINTL 
			NEXT
		ELSE
			SELECTCASE ARGS:4
				CASE "CENTER"
					ALIGNMENT CENTER
				CASE "RIGHT"
					ALIGNMENT RIGHT
				CASEELSE
					ALIGNMENT LEFT
			ENDSELECT
			SPLIT ARGS:2, ARGS:3, LOCALS 
			FOR LOCAL, 0, RESULT
				PRINTFORML %LOCALS:LOCAL%
			NEXT
			ALIGNMENT LEFT
		ENDIF
		FLAG:커맨드표시행수 = LINECOUNT
	CASE "EMPTY"
		REDRAW 0
		FOR LOCAL, 0, 50
			PRINTL 
		NEXT
		REDRAW 2
		TWAIT 500, 1
		CLEARLINE 50
	CASEELSE
		PRINTW 인수의 지정이 잘못되었습니다!
ENDSELECT
