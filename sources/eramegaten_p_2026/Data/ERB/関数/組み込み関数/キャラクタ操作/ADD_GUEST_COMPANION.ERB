;-------------------------------------------------
;@ADD_GUEST_COMPANION
;ゲストキャラを参戦させる関数
;
;RESULT = ゲストとして加入させたか(すでに引き継ぎキャラが存在している場合などは0を返す)
;RESULT:1 = ゲストのキャラクター登録番号(引き継ぎキャラであっても番号を返す)
;-------------------------------------------------
@ADD_GUEST_COMPANION, L_CHARA_NO, L_LOYALTY, L_LV
#DIM DYNAMIC L_CHARA_NO	;加入させるキャラ
#DIM DYNAMIC L_LOYALTY	;加入時の忠誠度
#DIM DYNAMIC L_LV		;加入時のレベル
#DIM DYNAMIC L_GUEST
;該当キャラがポジションに入っている場合は終わり
IF GETCHARA(L_CHARA_NO) >= 0
	IF CPOS(GETCHARA(L_CHARA_NO)) > 0
		RETURN 0, GETCHARA(L_CHARA_NO)
	ELSE
		CALL INSERT_POSITION, -1, GETCHARA(L_CHARA_NO)
		RETURN 0, GETCHARA(L_CHARA_NO)
	ENDIF
ELSE
	CALL ADD_NEW_COMPANION, L_CHARA_NO , L_LOYALTY, -2, , , L_LV
	L_GUEST = RESULT:1
	CFLAG:L_GUEST:게스트가입플래그 = 1
	CALL SET_TALENT_PARTY_JOINABLE, L_GUEST, "参加可能"
	CALL INSERT_POSITION, -1, L_GUEST
	RETURN 1, L_GUEST
ENDIF

;キャラ加入時の枠確認をして自動的に開けられない場合は空ける選択をさせる関数
@MAKE_BLANK_POSTION_FOR_ADDCHARA, L_ADDCHARA:0, L_ADDCHARA:1, L_ADDCHARA:2, L_ADDCHARA:3, L_ADDCHARA:4
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_ADDCHARA, 5
#DIM DYNAMIC NEED_BLANK_NUMBER
#DIM DYNAMIC COUNT_BLANK
NEED_BLANK_NUMBER = VARSIZE("L_ADDCHARA") - MATCH(L_ADDCHARA, 0)
;必要な空き数をチェック
FOR LCOUNT, 0, VARSIZE("L_ADDCHARA")
	SIF L_ADDCHARA:LCOUNT == 0
		CONTINUE
	SIF GETCHARA(L_ADDCHARA:LCOUNT) < 0
		CONTINUE
	SIF CPOS(GETCHARA(L_ADDCHARA:LCOUNT)) == 0
		CONTINUE
	NEED_BLANK_NUMBER--
NEXT
COUNT_BLANK = 6 - CMATCH(CFLAG:0:PT플래그, 2)
;空きポジションが足りているなら終わる
SIF NEED_BLANK_NUMBER <= COUNT_BLANK
	RETURN 0
;プレイヤーに選択して外させる
;話がややこしくなるのでいったん引継ぎゲストを抜く
FOR LCOUNT, 6, 0, -1
	SIF POS(LCOUNT) < 0
		CONTINUE
	SIF POS(LCOUNT) == 0
		CONTINUE
	SIF !MATCH(L_ADDCHARA, NO:POS(LCOUNT))
		CONTINUE
	CALL REMOVE_POSITION, LCOUNT
NEXT
CALL SETUP_REMOVE, VARSIZE("L_ADDCHARA") - MATCH(L_ADDCHARA, 0)