;-------------------------------------------------
;@キャラ削除　L_CHARAのキャラクターを削除し、変数の移動まで済ませる関数
;-------------------------------------------------
@キャラ削除, L_CHARA
#LOCALSIZE 2
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC STOCK_L_CHARA_TIMEID
#DIM DYNAMIC STOCK_PLAYER_TIMEID
#DIM DYNAMIC STOCK_TARGET_TIMEID
#DIM DYNAMIC STOCK_ASSI_TIMEID
#DIM DYNAMIC STOCK_NAVIGATOR_TIMEID

;番号移動に備えてストックしておく
STOCK_L_CHARA_TIMEID = CFLAG:L_CHARA:실제가입시간
SIF PLAYER >= 0
	STOCK_PLAYER_TIMEID = CFLAG:PLAYER:실제가입시간
SIF TARGET >= 0
	STOCK_TARGET_TIMEID = CFLAG:TARGET:실제가입시간
SIF ASSI >= 0
	STOCK_ASSI_TIMEID = CFLAG:ASSI:실제가입시간
SIF NAVIGATOR >= 0
	STOCK_NAVIGATOR_TIMEID = CFLAG:NAVIGATOR:실제가입시간

;キャラクター独自の削除処理
TRYCCALLFORM キャラ削除_CHARA_{NO:L_CHARA}, L_CHARA
	;番号ずれに対処しておく
	L_CHARA = FINDCHARA_TIMEID(STOCK_L_CHARA_TIMEID)
	SIF L_CHARA < 0
		RETURN 0
CATCH
ENDCATCH
;ペルソナ使いの場合はペルソナをひっぺがし、つくっていた初期ペルソナを消す
IF TALENT:L_CHARA:페르소나구사자
	FOR LOCAL, 1, 4
		LOCALS = 소지페르소나{LOCAL}
		IF EQUIP:L_CHARA:LOCALS
			DITEMTYPE:(EQUIP:L_CHARA:LOCALS):페르소나("装備状態") = 1
			DITEMTYPE:(EQUIP:L_CHARA:LOCALS):페르소나("ペルソナ所持者") = -1
		ENDIF
	NEXT
	IF CFLAG:L_CHARA:초기페르소나넘버
		FOR LOCAL, 0, 50
			DITEMTYPE:(CFLAG:L_CHARA:초기페르소나넘버):LOCAL = 0
		NEXT
	ENDIF
ENDIF

;デビルシフター関連
FOR LCOUNT, 0, LINKCHARANUM
	SIF FINDCHARA_LINK(L_CHARA, LCOUNT) >= 0
		CALL REMOVE_LINK_DEVIL, L_CHARA, LCOUNT
NEXT
SIF CFLAG:L_CHARA:피링크캐릭터실제가입시간 > 0
	CALL REMOVE_LINK_DEVIL, FINDCHARA_TIMEID(CFLAG:L_CHARA:피링크캐릭터실제가입시간), , L_CHARA

;親の数値の破棄
FOR LOCAL, 0, CHARANUM
	SIF CFLAG:LOCAL:딸의친부모고유번호딸 == CFLAG:L_CHARA:캐릭터고유번호
		CFLAG:LOCAL:딸의친부모고유번호딸 = -1
	SIF CFLAG:LOCAL:딸의부친고유번호딸 == CFLAG:L_CHARA:캐릭터고유번호
		CFLAG:LOCAL:딸의부친고유번호딸 = -1
	IF CFLAG:LOCAL:부친의고유번호부모 == CFLAG:L_CHARA:캐릭터고유번호
		CFLAG:LOCAL:부친의고유번호부모 = -1
		CFLAG:LOCAL:부친실종 = 1
	ENDIF
	FOR LCOUNT, 1, 21
		;キャラがいない場合、ここで削除
		SIF CFLAG:LOCAL:@"캐릭터상성{LCOUNT}" == 0
			CONTINUE
		IF FINDCHARA_TIMEID(CFLAG:LOCAL:@"캐릭터상성{LCOUNT}") < 0
			CFLAG:LOCAL:@"캐릭터상성{LCOUNT}" = 0
			CFLAG:LOCAL:@"캐릭터상성치{LCOUNT}" = 0
		ENDIF
	NEXT
NEXT
;好感度を削除
FOR LOCAL, 0, CHARANUM
	CDFLAG:(LOCAL):캐릭터간호감도:(CFLAG:L_CHARA:캐릭터고유번호+100) = 0
	CDFLAG:(LOCAL):캐릭터간함락소질:(CFLAG:L_CHARA:캐릭터고유번호+100) = 0
NEXT

CALL モブ画像_リセット, L_CHARA

SIF CFLAG:L_CHARA:포지션 > 0
	CALL REMOVE_POSITION, CFLAG:L_CHARA:포지션
;戦闘中のキャラ削除はリスト排除も行う
IF FINDELEMENT(BCHARA, L_CHARA) >= 0
	ARRAYREMOVE BCHARA, FINDELEMENT(BCHARA, L_CHARA), 1
	BCHARA:(VARSIZE("BCHARA") - 1) = -1
	BCHARANUM--
ENDIF
FOR LOCAL, 0, BCHARANUM
	SIF BCHARA:LOCAL > L_CHARA
		BCHARA:LOCAL--
NEXT
;予備ターゲットから外す
FOR LOCAL, 0, 10
	IF LOCAL == 0
		SIF TARGET == L_CHARA
			TARGET = -1
		SIF ASSI == L_CHARA
			ASSI = -1
	ENDIF
	SIF TARGET:LOCAL == CFLAG:L_CHARA:캐릭터고유번호
		TARGET:LOCAL = -1
NEXT
SIF NAVIGATOR == L_CHARA
	NAVIGATOR = -1
;装備解除処理
;仲魔のみ解除
IF CFLAG:L_CHARA:PT플래그 != 0 && !CFLAG:L_CHARA:게스트가입플래그
	FOR LOCAL, 0, 8
		CALL 装備解除, L_CHARA, GET_EQUIP(LOCAL), 1
;		IF EQUIP:ARG:GET_EQUIP(LOCAL) > 0
;			ITEM:(EQUIP:ARG:GET_EQUIP(LOCAL)) += 1
;			EQUIP:ARG:GET_EQUIP(LOCAL) = 0
;		ENDIF
	NEXT
ENDIF
ITEM:생득무기 = 0
CALL モブ画像_リセット(L_CHARA)

DELCHARA L_CHARA
PLAYER = FINDCHARA_TIMEID(STOCK_PLAYER_TIMEID)
TARGET = FINDCHARA_TIMEID(STOCK_TARGET_TIMEID)
ASSI = FINDCHARA_TIMEID(STOCK_ASSI_TIMEID)
NAVIGATOR = FINDCHARA_TIMEID(STOCK_NAVIGATOR_TIMEID)

;フォーメーション再読み込み
CALL REFRESH_POS