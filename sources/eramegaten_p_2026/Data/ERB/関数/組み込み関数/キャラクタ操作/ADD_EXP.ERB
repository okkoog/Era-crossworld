;========================================
;経験値入手関数　TCVARはそのまま使うとマジックボックス化するので
;あとはまぁラップかけとけば、あとで纏めて処理追加できるし
;========================================
@ADD_EXP, ARG, ARG:1, ARG:2 = -99
#LOCALSIZE 1
LOCAL = ARG:2 == -99 ? TARGET # ARG:2
IF LOCAL < 0
	PRINTL @ADD_EXP에서 지정된 캐릭터가 올바르지 않습니다
	PRINTW 이 부근의 로그를 첨부하여 개발 스레드에 버그 보고를 부탁드립니다
ENDIF
IF ARG < 0 || STRLENS(EXPNAME:ARG) == 0
	PRINTL @ADD_EXP에서 지정된 EXP가 올바르지 않습니다
	PRINTW 이 부근의 로그를 첨부하여 개발 스레드에 버그 보고를 부탁드립니다
ENDIF
;膣射経験加算時は同時に膣内精液量を加算する
SIF ARG == GETNUM(EXP, "질사경험")
	TCVAR:LOCAL:101 += ARG:1
TCVAR:LOCAL:ARG += ARG:1