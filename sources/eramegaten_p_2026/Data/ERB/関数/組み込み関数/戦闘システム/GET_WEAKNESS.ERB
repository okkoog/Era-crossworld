;====================================================
;=========================================
;ARG = 타겟
;=========================================
@GET_WEAKNESS(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 999
		RETURNF "반사"
	CASE IS < 0
		RETURNF "흡수"
	CASE 0
		RETURNF "무효"
	CASE IS < 100
		RETURNF "내성"
	CASE 100
		RETURNF "통상"
	CASE IS > 100
		RETURNF "약점"
ENDSELECT
