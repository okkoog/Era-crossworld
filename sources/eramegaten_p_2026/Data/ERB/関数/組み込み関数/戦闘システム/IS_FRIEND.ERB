;====================================================
;対象同士が互いに味方であるかを判定する
;
;ARG		対象のキャラ番号
;ARG:1		2人目の対象のキャラ番号
;RESULT		真偽値
;====================================================
@IS_FRIEND, ARG, ARG:1
#FUNCTION
SIF ARG < 0
	RETURNF 0
SIF ARG:1 < 0
	RETURNF 0
SIF CFLAG:ARG:PT플래그 > 0 && CFLAG:(ARG:1):PT플래그 <= 0
	RETURNF 0
SIF CFLAG:(ARG:1):PT플래그 > 0 && CFLAG:ARG:PT플래그 <= 0
	RETURNF 0
RETURNF 1
