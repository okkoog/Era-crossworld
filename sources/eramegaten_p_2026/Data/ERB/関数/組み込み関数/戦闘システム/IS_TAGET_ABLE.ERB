;====================================================
;対象が行動の対象にできるかの判定
;
;要するに死んでるかどうかと場にいるかどうかを判定する
;====================================================
@IS_TARGET_ABLE, ARG
#FUNCTION
SIF ARG < 0
	RETURNF 0
SIF CPOS(ARG) <= 0
	RETURNF 0
SIF CFLAG:ARG:상태이상 == GET_STATE_NUM("DYING")
	RETURNF 0
SIF CFLAG:ARG:공격대상제외_ACT
	RETURNF 0
SIF CFLAG:ARG:공격대상제외
	RETURNF 0
RETURNF 1

