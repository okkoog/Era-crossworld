;====================================================
;=========================================
;ターゲットのポジション最低値取得
;ARG = 타겟
;=========================================
@GET_POS_MIN(ARG)
#FUNCTION
;味方同士は0
SELECTCASE ARG
	;単体指定
	CASE 1 TO 16
		RETURNF ARG
	;味方前列・味方全体・敵味方全体
	CASE 17, 19, 23
		RETURNF 1
	;味方後列
	CASE 18
		RETURNF 4
	;敵前列・敵全体
	CASE 20, 22
		RETURNF 7
	;敵後列
	CASE 21
		RETURNF 12
	CASEELSE
		ARG = -1
		STR:ARG = 指定されたターゲットが異常な数値です。
ENDSELECT

;=========================================
;ターゲットのポジション最大値取得
;ARG = 타겟
;=========================================
@GET_POS_MAX(ARG)
#FUNCTION
;味方同士は0
SELECTCASE ARG
	;単体指定
	CASE 1 TO 16
		RETURNF ARG
	;味方前列
	CASE 17
		RETURNF 3
	;味方後列・味方全体
	CASE 18, 19
		RETURNF 6
	;敵前列
	CASE 20
		RETURNF 11
	;敵後列・敵全体・敵味方全体
	CASE 21, 22, 23
		RETURNF 16
	CASEELSE
		ARG = -1
		STR:ARG = 指定されたターゲットが異常な数値です。
ENDSELECT