;====================================================
;状態異常の判定関数
;====================================================
@IS_BADSTATE, ARG, ARGS
#FUNCTION
RETURNF GET_STATE(CFLAG:ARG:상태이상) == CONVERT_BADSTATE_NAME(ARGS)


@IS_BADSTATE_FRIEND, ARGS
#FUNCTION
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_RESULT
FOR LCOUNT, 1, 7
	SIF POS(LCOUNT) < 0
		CONTINUE
	SIF GET_STATE(CFLAG:POS(LCOUNT):상태이상) != CONVERT_BADSTATE_NAME(ARGS)
		CONTINUE
	L_RESULT += 1
NEXT
RETURNF L_RESULT
