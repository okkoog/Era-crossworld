;====================================================
;=========================================
;指定したキャラ同士の距離を取る
;戻り値
;0:味方同士
;1:前列同士
;2;前列対後列
;3:後列同士
;=========================================
@GET_BTL_RANGE(ARG, ARG:1)
#FUNCTION
;味方同士は0
SIF IS_FRIEND(ARG, ARG:1)
	RETURNF 0
RETURNF 1 + !IS_FRONT(ARG) +  !IS_FRONT(ARG:1)
