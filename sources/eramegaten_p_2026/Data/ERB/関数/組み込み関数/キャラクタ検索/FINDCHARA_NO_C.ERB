;-------------------------------------------------
;@FINDCHARA_NO_C(ARG)
;結婚してないARG番のキャラが仲魔にいるかを返す
;ARG:1 は判定から除くキャラ
;-------------------------------------------------
@FINDCHARA_NO_C(ARG, ARG:1 = -1)
#FUNCTION
FOR LOCAL,0,CHARANUM
	SIF LOCAL == ARG:1
		CONTINUE
	SIF CFLAG:LOCAL:PT플래그 == 0
		CONTINUE
	SIF NO:LOCAL == [[キャラ:당신의딸]] || NO:LOCAL == [[キャラ:노예의딸]] || NO:LOCAL == [[キャラ:조마]]
		CONTINUE
	SIF NO:LOCAL == ARG && 계약(LOCAL) == 0 && CFLAG:LOCAL:소속ＣＯＭＰ != -1
		RETURNF LOCAL
NEXT
RETURNF -1