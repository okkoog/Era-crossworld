;===============================
;サマナーLvの最大値
;ARG	1のときは行動不能かどうかを見ない
;===============================
@GET_SUMMONER_MLV(ARG = 0)
#FUNCTION
#DIM MAX_SLV
#DIM LCOUNT
#DIM CHARA
SIF FLAG:COMP사용불능
	RETURNF 0
MAX_SLV = 0
FOR LCOUNT,1,7
	CHARA = POS(LCOUNT)
	SIF CHARA < 0
		CONTINUE
	IF ARG == 0
		SIF !INPUTABLE_CHARA_F(CHARA)
			CONTINUE
	ENDIF
	MAX_SLV = MAX(GET_BTL_TALENT_LV("서머너", CHARA, "両形態"), MAX_SLV)
NEXT
RETURNF MAX_SLV