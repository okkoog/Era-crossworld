;===============================
;仲魔（悪魔）が消費しているCOMP容量
;==============================
@NUM_NAKAMA()
#FUNCTION
LOCAL:1 = 0
FOR LOCAL,0,CHARANUM
	SIF LOCAL == MASTER
		CONTINUE
	SIF !GET_ROLE_PROP("CAN_PUT_IN_COMP", LOCAL)
		CONTINUE
	;SIF ABL:LOCAL:종족 < 1 || ABL:LOCAL:종족 > 45
	;	CONTINUE
	;SIF CFLAG:LOCAL:용량미사용
	;	CONTINUE
	SIF CFLAG:LOCAL:소속ＣＯＭＰ == -1
		CONTINUE
	SIF CFLAG:LOCAL:PT플래그 == 0
		CONTINUE
	LOCAL:1 += 1
NEXT

;6以下のとき、デビルチェンバー装備中なら0に
;SIF LOCAL:1 <= 6 && SOFT_ON("デビルチェンバー")
;	LOCAL:1 = 0


RETURNF LOCAL:1


