;===============================
;COMPに仲魔が加入できる余裕があるかどうか判定
;==============================
@ストック空き容量()
;戻り値 仲魔が加入できる余裕があるなら1、仲間を加入させる余裕がないなら0、既に容量オーバーを起こしているなら-1
;		3種に分けてるのは、加入させてから容量オーバーしてるか判定してストレージ送りにする処理などでも使えるようにするため
#FUNCTION
LOCAL:1 = 0

IF GET_STOCKSIZE() > NUM_NAKAMA()
	RETURNF 1
ELSEIF GET_STOCKSIZE() == NUM_NAKAMA()
	RETURNF 0
ELSE
	RETURNF -1
ENDIF
