;===============================
;造魔の人数
;==============================
@NUM_ZOUMA, ARGS = "통상"
#FUNCTION
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_RESULT
FOR LCOUNT,0,CHARANUM
	SIF GET_RACE(ABL:LCOUNT:종족) != "조마"
		CONTINUE
	SIF CFLAG:LCOUNT:PT플래그 == 0
		CONTINUE
	SIF ARGS == "汎用のみ" && CSVCFLAG(NO:LCOUNT, GETNUM(CFLAG, "복수생성가능")) == 0
		CONTINUE
	L_RESULT += 1
NEXT
RETURNF L_RESULT