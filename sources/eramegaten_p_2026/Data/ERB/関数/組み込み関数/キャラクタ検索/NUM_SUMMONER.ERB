;===============================
;ＣＯＭＰを使用可能な人数
;===============================
@NUM_SUMMONER(ARG = 3)
#FUNCTION
#DIM NUM_S
#DIM LCOUNT
#DIM CHARA
;サマナーLvがARG以上の人数を返す
SIF FLAG:COMP사용불능
	RETURNF 0
NUM_S = 0
FOR LCOUNT,1,7
	CHARA = POS(LCOUNT)
	SIF CHARA < 0
		CONTINUE
	SIF GET_BTL_TALENT_LV("서머너", CHARA, "両形態") < ARG
		CONTINUE
	SIF !INPUTABLE_CHARA_F(CHARA)
		CONTINUE
	NUM_S++
NEXT
RETURNF NUM_S