;===============================
;サマナーLvの合計値
;===============================
@GET_SUMMONER_LV(ARG = 0)
#FUNCTION
#DIM SUM_SLV
#DIM LCOUNT
#DIM CHARA
SIF FLAG:COMP사용불능
	RETURNF 0
SUM_SLV = 0
FOR LCOUNT,1,7
	CHARA = POS(LCOUNT)
	SIF CHARA < 0
		CONTINUE
	SIF !INPUTABLE_CHARA_F(CHARA)
		CONTINUE
	SUM_SLV += GET_BTL_TALENT_LV("서머너", CHARA, "両形態")
NEXT
RETURNF SUM_SLV