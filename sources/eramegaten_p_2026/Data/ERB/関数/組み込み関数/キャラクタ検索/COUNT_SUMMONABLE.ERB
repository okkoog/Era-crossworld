;===============================
;SUMMONの実行可能回数
;===============================
@COUNT_SUMMONABLE, IS_COUNT_MAX
#FUNCTION
#DIM DYNAMIC IS_COUNT_MAX
#DIM DYNAMIC L_RESULT
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC CHARA
IF !IS_COUNT_MAX
	SIF FLAG:COMP사용불능
		RETURNF 0
	SIF FLAG:소환불능
		RETURNF 0
ENDIF
FOR LCOUNT,1,7
	CHARA = POS(LCOUNT)
	SIF CHARA < 0
		CONTINUE
	SIF !GET_ROLE_PROP("CAN_USE_SUMMON", CHARA, "両形態") && !GET_BTL_TALENT_LV("서머너", CHARA, "両形態")
		CONTINUE
	SIF !IS_COUNT_MAX && !INPUTABLE_CHARA_F(CHARA)
		CONTINUE
	L_RESULT += 1
NEXT
SIF SOFT_ON("DDS-DUO")
	L_RESULT += 1
L_RESULT += TFLAG:추가소환권

SIF !IS_COUNT_MAX
	L_RESULT -= TFLAG:SUMMON실행완료횟수
RETURNF L_RESULT

;===============================
;SUMMONの実行可能回数
;===============================
@COUNT_SUMMONABLE_MAX
#FUNCTION
RETURNF COUNT_SUMMONABLE(1)