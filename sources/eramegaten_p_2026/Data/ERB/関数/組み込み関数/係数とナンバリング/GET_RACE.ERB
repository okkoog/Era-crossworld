;-------------------------------------------------
;種族名を取得
;-------------------------------------------------
@GET_RACE(ARG)
#FUNCTIONS
RETURNF STR:(ARG-FINDELEMENT(STR,"인간"))

; KR판 전용 호환 함수
@GET_RACE_IMG(ARG)
#FUNCTIONS
#DIM DYNAMIC RACE

RACE = ARG - FINDELEMENT(STR, "인간")

SELECTCASE RACE
	CASE 0
		RETURNF "人間"
	CASE 1
		RETURNF "地母神"
	CASE 2
		RETURNF "女神"
	CASE 3
		RETURNF "魔王"
	CASE 4
		RETURNF "天使"
	CASE 5
		RETURNF "妖魔"
	CASE 6
		RETURNF "妖精"
	CASE 7
		RETURNF "妖鬼"
	CASE 8
		RETURNF "龍王"
	CASE 9
		RETURNF "魔獣"
	CASE 10
		RETURNF "妖鳥"
	CASE 11
		RETURNF "外道"
	CASE 12
		RETURNF "マシン"
	CASE 13
		RETURNF "精霊"
	CASE 14
		RETURNF "御霊"
	CASE 15
		RETURNF "鬼神"
	CASE 16
		RETURNF "魔神"
	CASE 17
		RETURNF "邪神"
	CASE 18
		RETURNF "堕天使"
	CASE 19
		RETURNF "女魔"

	CASE 30
		RETURNF "七星"
	CASE 31
		RETURNF "狂人"
	CASE 32
		RETURNF "怪異"
	CASE 33
		RETURNF "ボス専用"

	CASE 36
		RETURNF "半魔人"

	CASE 39
		RETURNF "リンク専用"
	CASE 40
		RETURNF "ペルソナ専用"
	CASE 41
		RETURNF "ペルソナ２"
	CASE 42
		RETURNF "魔人"
	CASE 43
		RETURNF "超人"
	CASE 44
		RETURNF "英雄"
	CASE 45
		RETURNF "造魔"
	CASE 46
		RETURNF "淫魔"

	CASE 73
		RETURNF "悪魔人"
ENDSELECT

RETURNF ""
