@GET_BATTLESTATUS(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "공격"
	CASE 1
		RETURNF "명중"
	CASE 2
		RETURNF "방어"
	CASE 3
		RETURNF "회피"
	CASE 4
		RETURNF "마법위력"
	CASE 5
		RETURNF "마법효과"
	CASE 6
		RETURNF "총공격"
	CASE 7
		RETURNF "총명중"
	CASE 8
		RETURNF "도구위력"
	CASE 9
		RETURNF "도구명중"
ENDSELECT
;能力名を取得
;RETURNF BASENAME:(GETNUM(BASE,"공격")+ARG)