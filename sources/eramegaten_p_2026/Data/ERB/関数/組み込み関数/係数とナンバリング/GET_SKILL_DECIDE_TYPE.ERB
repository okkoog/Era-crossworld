;=========================================
;SKILL_DECIDE_TYPEの番号から文字列を取得する
;=========================================
@GET_SKILL_DECIDE_TYPE, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "未指定"
	CASE 1
		RETURNF "EX"
	CASE 2
		RETURNF "MA"
	CASE 3
		RETURNF "CS"
	CASE 4
		RETURNF "AS"
	CASEELSE
		THROW @GET_SKILL_DECIDE_TYPE의 인수[{ARG}]은(는) 정의되어 있지 않은 수치입니다.
ENDSELECT