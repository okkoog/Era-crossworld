;=========================================
;ダメージタイプの番号から文字列を取得する
;=========================================
@GET_ダメージタイプ, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		RETURNF "物理"
	CASE 2
		RETURNF "魔法"
	CASEELSE
		RETURNF "不正な引数が与えられました"
ENDSELECT