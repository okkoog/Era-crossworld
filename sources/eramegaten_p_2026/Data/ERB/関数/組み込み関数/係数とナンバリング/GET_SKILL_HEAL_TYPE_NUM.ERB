;=========================================
;SKILL_HEAL_TYPEの番号から文字列を取得する
;=========================================
@GET_SKILL_HEAL_TYPE_NUM, ARGS
#FUNCTION
SELECTCASE ARGS
	CASE "通常", "통상"
		RETURNF 0
	CASE "割合", "비율"
		RETURNF 1
	CASE "固定", "고정"
		RETURNF 2
	CASEELSE
		THROW @GET_SKILL_HEAL_TYPE_NUM의 인수[%ARGS%]은(는) 정의되어 있지 않은 수치입니다.
ENDSELECT