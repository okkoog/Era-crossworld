;=========================================
;スキルの効果分類を文字列にして返す
;=========================================
@GET_SKILL_EFFECT, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "未指定"
	CASE 1
		RETURNF "공격"
	CASE 2
		RETURNF "회복"
	CASE 3
		RETURNF "상태변화"
	CASE 4
		RETURNF "특수"
	CASE 5
		RETURNF "상태회복"
	CASE 6
		RETURNF "자동효과"
	CASE 7
		RETURNF "파티효과"
	CASEELSE
		THROW @GET_SKILL_COST_TYPE의 인수[{ARG}]은(는) 정의되어 있지 않은 수치입니다.
ENDSELECT