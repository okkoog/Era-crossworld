;=========================================
;GET_攻撃タイプ_NUM
;=========================================
@GET_攻撃タイプ_NUM, ARGS
#FUNCTION
SELECTCASE ARGS
	CASE "物理", "물리"
		RETURNF 1
	CASE "魔法", "마법"
		RETURNF 2
	CASE "銃", "GUN", "ＧＵＮ", "총"
		RETURNF 3
	CASE "アイテム", "道具", "아이템", "도구"
		RETURNF 4
	CASE "割合", "割合ダメージ", "비율", "비율데미지"
		RETURNF 5
	CASE "固定", "固定ダメージ", "고정", "고정데미지"
		RETURNF 6
	CASE "LV", "レベル", "레벨"
		RETURNF 7
	CASEELSE
		RETURNF -1
ENDSELECT