;=========================================
;GET_ダメージタイプ_NUM
;=========================================
@GET_ダメージタイプ_NUM, ARGS
#FUNCTION
SELECTCASE ARGS
	CASE "物理", "물리"
		RETURNF 1
	CASE "魔法", "마법"
		RETURNF 2
	CASEELSE
		RETURNF -1
ENDSELECT