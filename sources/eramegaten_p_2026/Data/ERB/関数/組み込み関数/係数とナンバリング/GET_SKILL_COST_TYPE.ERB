;=========================================
;SKILL_COST_TYPEの番号から文字列を取得する
;=========================================
@GET_SKILL_COST_TYPE, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "未指定"
	CASE 1
		RETURNF "無消費"
	CASE 2
		RETURNF "HP"
	CASE 3
		RETURNF "MP"
	CASE 4
		RETURNF "TURN"
	CASE 5
		RETURNF "アイテム"
	CASEELSE
		THROW @GET_SKILL_COST_TYPE의 인수[{ARG}]은(는) 정의되어 있지 않은 문자열입니다.
ENDSELECT