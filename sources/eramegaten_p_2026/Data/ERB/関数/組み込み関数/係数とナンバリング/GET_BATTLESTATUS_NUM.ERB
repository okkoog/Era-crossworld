@GET_BATTLESTATUS_NUM(ARGS)
#FUNCTION
SELECTCASE ARGS
	CASE "攻撃", "공격"
		RETURNF 0
	CASE "命中", "명중"
		RETURNF 1
	CASE "防御", "방어"
		RETURNF 2
	CASE "回避", "회피"
		RETURNF 3
	CASE "魔法威力", "마법위력"
		RETURNF 4
	CASE "魔法効果", "마법효과"
		RETURNF 5
	CASE "銃攻撃", "총공격"
		RETURNF 6
	CASE "銃命中", "총명중"
		RETURNF 7
	CASE "道具威力", "도구위력"
		RETURNF 8
	CASE "道具命中", "도구명중"
		RETURNF 9
	CASEELSE
		RETURNF -1
ENDSELECT
;能力番号を取得
;RETURNF GETNUM(BASE,ARGS) - GETNUM(BASE,"공격")