;=========================================
;SKILL_COST_TYPEの番号から文字列を取得する
;=========================================
@GET_SKILL_EFFECT_NUM, ARGS
#FUNCTION
SELECTCASE ARGS
	CASE "未指定", "미지정"
		RETURNF 0
	CASE "攻撃", "공격"
		RETURNF 1
	CASE "回復", "회복"
		RETURNF 2
	CASE "状態変化", "상태변화"
		RETURNF 3
	CASE "特殊", "특수"
		RETURNF 4
	CASE "状態回復", "상태회복"
		RETURNF 5
	CASE "自動効果", "자동효과"
		RETURNF 6
	CASE "パーティ効果", "파티효과"
		RETURNF 7
	CASEELSE
		THROW @GET_SKILL_COST_TYPE_NUM의 인수[%ARGS%]은(는) 정의되어 있지 않은 문자열입니다.
ENDSELECT