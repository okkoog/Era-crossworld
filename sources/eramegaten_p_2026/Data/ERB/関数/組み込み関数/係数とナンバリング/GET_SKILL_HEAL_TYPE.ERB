;=========================================
;SKILL_HEAL_TYPEの番号から文字列を取得する
;=========================================
@GET_SKILL_HEAL_TYPE, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "통상"
	CASE 1
		RETURNF "割合"
	CASE 2
		RETURNF "固定"
	CASEELSE
		THROW @GET_SKILL_HEAL_TYPE의 인수[{ARG}]은(는) 정의되어 있지 않은 문자열입니다.
ENDSELECT