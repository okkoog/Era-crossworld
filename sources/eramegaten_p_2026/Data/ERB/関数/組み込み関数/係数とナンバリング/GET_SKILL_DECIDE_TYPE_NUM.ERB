;=========================================
;SKILL_DECIDE_TYPEの番号から文字列を取得する
;=========================================
@GET_SKILL_DECIDE_TYPE_NUM, ARGS
#FUNCTION
SELECTCASE ARGS
	CASE "未指定", "미지정"
		RETURNF 0
	CASE "EX"
		RETURNF 1
	CASE "MA"
		RETURNF 2
	CASE "CS"
		RETURNF 3
	CASE "AS"
		RETURNF 4
	CASEELSE
		THROW @GET_SKILL_DECIDE_TYPE의 인수[%ARGS%]은(는) 정의되어 있지 않은 문자열입니다.
ENDSELECT