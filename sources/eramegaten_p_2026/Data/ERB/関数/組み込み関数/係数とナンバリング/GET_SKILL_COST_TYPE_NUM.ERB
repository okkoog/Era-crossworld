;=========================================
;SKILL_COST_TYPEの番号から文字列を取得する
;=========================================
@GET_SKILL_COST_TYPE_NUM, ARGS
#FUNCTION
SELECTCASE ARGS
	CASE "未指定", "미지정"
		RETURNF 0
	CASE "無消費", "무소비"
		RETURNF 1
	CASE "HP"
		RETURNF 2
	CASE "MP"
		RETURNF 3
	CASE "TURN"
		RETURNF 4
	CASE "アイテム", "아이템"
		RETURNF 5
	CASEELSE
		THROW @GET_SKILL_COST_TYPE_NUM의 인수[%ARGS%]은(는) 정의되어 있지 않은 수치입니다.
ENDSELECT