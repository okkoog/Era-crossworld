;ARG:1 = 敵味方全体を短くしたい場合
@GET_SPHERE(ARG, ARG:1)
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		RETURNF "단체"
	CASE 2
		RETURNF "일렬"
	CASE 3
		RETURNF "전체"
	CASE 4
		IF ARG:1
			RETURNF "적아군"
		ELSE
			RETURNF "적아군전체"
		ENDIF
	CASE 5
		RETURNF "세로열"
	CASEELSE
		RETURNF "없음"
ENDSELECT
;#LOCALSSIZE 5
;SIF LOCALS == ""
;	SPLIT "_単体_一列_全体_敵味方全体","_",LOCALS
;RETURNF LOCALS:ARG
