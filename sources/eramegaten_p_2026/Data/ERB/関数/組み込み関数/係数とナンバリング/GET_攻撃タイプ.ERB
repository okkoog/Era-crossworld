;=========================================
;GET_攻撃タイプ
;=========================================
@GET_攻撃タイプ, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		RETURNF "物理"
	CASE 2
		RETURNF "魔法"
	CASE 3
		RETURNF "총"
	CASE 4
		RETURNF "アイテム"
	CASE 5
		RETURNF "割合"
	CASE 6
		RETURNF "固定"
	CASE 7
		RETURNF "LV"
	CASEELSE
		RETURNF "不正な引数が与えられました"
ENDSELECT
