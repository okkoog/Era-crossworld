;=================================================
;尻サイズFUNCTION
;-------------------------------------------------
;胸サイズFUNCTIONのBUST.ERBを参考に作成
;=================================================

;尻のサイズをチェックする関数
@HIP_SIZE, ARG = -1
#FUNCTION
SIF ARG == -1
	ARG = TARGET

SIF TALENT:ARG:小尻
	RETURNF 1
SIF TALENT:ARG:並尻
	RETURNF 2
SIF TALENT:ARG:巨尻
	RETURNF 3
SIF TALENT:ARG:爆尻
	RETURNF 4
SIF TALENT:ARG:魔尻
	RETURNF 5
RETURNF 2