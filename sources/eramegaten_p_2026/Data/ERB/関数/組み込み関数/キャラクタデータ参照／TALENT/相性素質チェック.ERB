;-------------------------------------------------
;   素質のチェック
;-------------------------------------------------
; Input:
;  L_CHARA				チェック対象者
;  L_SUCCESSION			소질번호
;  DISUSE_스킬적성	スキル適性の所持を無視できるか	1でできる
;  TRANS_MODE			形態の指定
;-------------------------------------------------
@相性素質チェック, L_CHARA, L_SUCCESSION, TRANS_MODE
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_SUCCESSION
#DIMS DYNAMIC TRANS_MODE
RETURN 相性素質チェック_F(L_CHARA, L_SUCCESSION, TRANS_MODE)

@相性素質チェック_F, L_CHARA, L_SUCCESSION, TRANS_MODE
#FUNCTION
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_SUCCESSION
#DIMS L_素質名
#DIMS TRANS_MODE
#DIMS SUCCESSION_REFERENCE
IF TRANS_MODE == ""
	IF CFLAG:L_CHARA:악마변신
		TRANS_MODE = 変身形態
	ELSE
		TRANS_MODE = 通常形態
	ENDIF
ENDIF
;スキル適性の所持を見るかどうかのオプション
SUCCESSION_REFERENCE = %GETS_ROLE_PROP("CAN_USE_스킬적성", L_CHARA, , TRANS_MODE)%
L_素質名 = %GET_SUCCESSION(L_SUCCESSION)%
IF SUCCESSION_REFERENCE == "通常"
	;初期ペルソナまたは初期リンク悪魔の素質チェック
	IF TALENT:L_CHARA:페르소나구사자 && ABL:L_CHARA:초기페르소나 > 0
		;SIF TALENT:(ABL:L_CHARA:초기페르소나 CFLAG:L_CHARA:초기페르소나넘버):L_素質名;PRINTFORM {LOCAL};LOCAL = ABL:L_CHARA:초기페르소나
		IF EXISTCSV((ABL:L_CHARA:초기페르소나), 0)
			SIF CSVTALENT((ABL:L_CHARA:초기페르소나),GETNUM(TALENT,L_素質名),0)
				RETURNF 1
		ENDIF
	ENDIF
	;本人の素質チェック
	SIF TALENT:L_CHARA:L_素質名
		RETURNF 1
ELSEIF STRCOUNT(SUCCESSION_REFERENCE, "リンク悪魔") || STRCOUNT(SUCCESSION_REFERENCE, "初期変身悪魔")
	IF STRCOUNT(SUCCESSION_REFERENCE, "リンク悪魔") && CFLAG:L_CHARA:링크캐릭터실제가입시간0 > 0
		SIF TALENT:FINDCHARA_LINK(L_CHARA):L_素質名
			RETURNF 1
	ENDIF
	IF STRCOUNT(SUCCESSION_REFERENCE, "初期変身悪魔")
		SIF CSVTALENT((CFLAG:L_CHARA:초기링크악마),GETNUM(TALENT,L_素質名),0)
			RETURNF 1
	ENDIF
	IF STRCOUNT(SUCCESSION_REFERENCE, "通常")
		SIF CSVTALENT((CFLAG:L_CHARA:초기링크악마),GETNUM(TALENT,L_素質名),0)
			RETURNF 1
	ENDIF
ELSE
	RETURNF 0
ENDIF
RETURNF 0
