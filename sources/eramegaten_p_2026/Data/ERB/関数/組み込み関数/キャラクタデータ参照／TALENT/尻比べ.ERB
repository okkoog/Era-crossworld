;=================================================
;尻比べFUNCTION
;-------------------------------------------------
;ARGのキャラを尻サイズと、ARG:1の尻サイズを比較
;値が大きいほど、ARGのキャラの方が大きい
;値が小さいほど、ARG:1のキャラの方が大きい
;=================================================

@尻比べ(ARG = -1, ARG:1 = -1)
#FUNCTION
LOCAL = 0

SIF ARG == -1
	ARG = TARGET
SIF ARG:1 == -1
	ARG:1 = MASTER

LOCAL = HIP_SIZE(ARG) - HIP_SIZE(ARG:1)

;TALENTでのヒップ差がなく、ヒップサイズの指定がある場合はそちらで比較
IF LOCAL == 0 && BASE:ARG:힙사이즈 != 0 && BASE:(ARG:1):힙사이즈 != 0
	IF BASE:ARG:힙사이즈 > BASE:(ARG:1):힙사이즈
		LOCAL = 1
	ELSEIF BASE:ARG:힙사이즈 < BASE:(ARG:1):힙사이즈
		LOCAL = -1
	ENDIF
ENDIF
RETURNF LOCAL
