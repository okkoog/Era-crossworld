			TIMES SOURCE:L_TARGET:아픔 , 1.00
		ELSEIF TALENT:L_PLAYER:284 > 0
			TIMES SOURCE:L_TARGET:쾌Ｖ , 1.10
			SOURCE:L_TARGET:아픔 += 0
