;ペニスサイズに応じてソースに補正をかける関数
;ARG   被挿入者
;ARG:1 挿入者
;ARGS コマンド種別。 現状では"V"と"A"
@CHINPO, ARG, ARG:1,ARGS
#DIM L_TARGET
#DIM L_PLAYER
L_TARGET = ARG
L_PLAYER = ARG:1

SELECTCASE ARGS
	CASE "V"
		;ペニスサイズに応じて快Ｖや苦痛に補正(0は並扱い)
		;ペニスサイズが小さい場合は情愛に補正し、大きい場合は拡張経験を(0は並扱い)
		IF TALENT:L_PLAYER:281 == 0
			TIMES SOURCE:L_TARGET:쾌Ｖ , 1.00
			TIMES SOURCE:L_TARGET:정애 , 1.00
		ELSEIF TALENT:L_PLAYER:281 == 1
			TIMES SOURCE:L_TARGET:쾌Ｖ , 0.80
			SOURCE:L_TARGET:정애 += 150
			TIMES SOURCE:L_TARGET:정애 , 2.00
		ELSEIF TALENT:L_PLAYER:281 == 2
			TIMES SOURCE:L_TARGET:쾌Ｖ , 0.90
			SOURCE:L_TARGET:정애 += 100
			TIMES SOURCE:L_TARGET:정애 , 1.50
		ELSEIF TALENT:L_PLAYER:281 == 3
			TIMES SOURCE:L_TARGET:쾌Ｖ , 1.00
			TIMES SOURCE:L_TARGET:정애 , 1.00
		ELSEIF TALENT:L_PLAYER:281 == 4
			TIMES SOURCE:L_TARGET:쾌Ｖ , 1.20
			SOURCE:L_TARGET:아픔 += 500
			CALL ADDS_EXP("Ｖ확장경험", 1, L_TARGET)
		ELSEIF TALENT:L_PLAYER:281 >= 5
			TIMES SOURCE:L_TARGET:쾌Ｖ , 1.50
			SOURCE:L_TARGET:아픔 += 1000
			CALL ADDS_EXP("Ｖ확장경험", 3, L_TARGET)
		ELSE
			TIMES SOURCE:L_TARGET:쾌Ｖ , 1.00
			TIMES SOURCE:L_TARGET:정애 , 1.00
		ENDIF
		
		;EXP:Ｖ経験をみる（処女の反感は別途処理済みなので省略）
		IF EXP:Ｖ경험 < EXPLV:1
			IF TALENT:L_PLAYER:281 == 0
				TIMES SOURCE:L_TARGET:아픔 , 2.50
			ELSEIF TALENT:L_PLAYER:281 == 1
				TIMES SOURCE:L_TARGET:아픔 , 0.50
				TIMES SOURCE:L_TARGET:반감 , 0.80
			ELSEIF TALENT:L_PLAYER:281 == 2
				TIMES SOURCE:L_TARGET:아픔 , 1.25
				TIMES SOURCE:L_TARGET:반감 , 0.90
			ELSEIF TALENT:L_PLAYER:281 == 3
				TIMES SOURCE:L_TARGET:아픔 , 2.50
			ELSEIF TALENT:L_PLAYER:281 == 4
				TIMES SOURCE:L_TARGET:아픔 , 3.75
			ELSEIF TALENT:L_PLAYER:281 >= 5
				TIMES SOURCE:L_TARGET:아픔 , 5.00
			ELSE
				TIMES SOURCE:L_TARGET:아픔 , 2.50
			ENDIF
		ELSEIF EXP:Ｖ경험 < EXPLV:2
			IF TALENT:L_PLAYER:281 == 0
				TIMES SOURCE:L_TARGET:아픔 , 0.80
				TIMES SOURCE:L_TARGET:반감 , 1.20
			ELSEIF TALENT:L_PLAYER:281 == 1
				TIMES SOURCE:L_TARGET:아픔 , 0.20
				TIMES SOURCE:L_TARGET:반감 , 0.80
			ELSEIF TALENT:L_PLAYER:281 == 2
				TIMES SOURCE:L_TARGET:아픔 , 0.40
				TIMES SOURCE:L_TARGET:반감 , 0.90
			ELSEIF TALENT:L_PLAYER:281 == 3
				TIMES SOURCE:L_TARGET:아픔 , 0.80
				TIMES SOURCE:L_TARGET:반감 , 1.20
			ELSEIF TALENT:L_PLAYER:281 == 4
				TIMES SOURCE:L_TARGET:아픔 , 3.00
				TIMES SOURCE:L_TARGET:반감 , 1.50
			ELSEIF TALENT:L_PLAYER:281 >= 5
				TIMES SOURCE:L_TARGET:아픔 , 4.00
				TIMES SOURCE:L_TARGET:반감 , 2.00
			ELSE
				TIMES SOURCE:L_TARGET:아픔 , 0.80
				TIMES SOURCE:L_TARGET:반감 , 1.20
			ENDIF
		ELSEIF EXP:Ｖ경험 < EXPLV:3
			IF TALENT:L_PLAYER:281 == 0
				TIMES SOURCE:L_TARGET:아픔 , 0.40
			ELSEIF TALENT:L_PLAYER:281 == 1
				TIMES SOURCE:L_TARGET:아픔 , 0.10
				TIMES SOURCE:L_TARGET:반감 , 0.70
			ELSEIF TALENT:L_PLAYER:281 == 2
