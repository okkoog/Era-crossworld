;====================================================
;=========================================
;ARG = 소질번호
;ARGS = 素質名称
;=========================================
@IS_ROLE_TALENT, ARG, ARGS
#FUNCTION
SIF ARGS == ""
	ARGS = %TALENTNAME:ARG%
SELECTCASE ARGS
	CASE "서머너"
		RETURNF 1
	CASEELSE
		SELECTCASE GETNUM(TALENT, ARGS)
			CASE 220 TO 249
				RETURNF 1
			CASE 261 TO 269
				RETURNF 1
			CASE 290 TO 300
				RETURNF 1
			CASE 400 TO 499
				RETURNF 1
		ENDSELECT
ENDSELECT