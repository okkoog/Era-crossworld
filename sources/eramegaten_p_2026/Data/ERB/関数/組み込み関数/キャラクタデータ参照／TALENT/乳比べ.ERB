;=================================================
;乳比べFUNCTION
;-------------------------------------------------
;ARGのキャラを乳サイズと、ARG:1の乳サイズを比較
;値が大きいほど、ARGのキャラの方が大きい
;値が小さいほど、ARG:1のキャラの方が大きい
;=================================================

@乳比べ(ARG = -1, ARG:1 = -1)
#FUNCTION
LOCAL = 0

SIF ARG == -1
	ARG = TARGET
SIF ARG:1 == -1
	ARG:1 = MASTER

LOCAL = BUST(ARG) - BUST(ARG:1)

;TALENTでのバスト差がなく、バストサイズの指定がある場合はそちらで比較
IF LOCAL == 0 && BASE:ARG:바스트 != 0 && BASE:(ARG:1):바스트 != 0
	IF BASE:ARG:바스트 > BASE:(ARG:1):바스트
		LOCAL = 1
	ELSEIF BASE:ARG:바스트 < BASE:(ARG:1):바스트
		LOCAL = -1
	ENDIF
ENDIF
RETURNF LOCAL
