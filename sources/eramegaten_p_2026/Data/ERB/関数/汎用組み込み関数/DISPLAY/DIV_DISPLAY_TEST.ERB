@TEST_DISPLAY
#DIMS L_デフォルト
#DIMS L_強調
#DIMS W_ピクシー , 6
L_デフォルト = border_width='1' background_color='#{GETBGCOLOR()}'
L_強調 = border_width='1' background_color='%TOSTR_HTML(COLOR("RED"))%'

VARI 時間計測 = GETTIME()

CALL CLEAR_DISPLAY
VARI DEF_XPOS = 300
VARI DEF_YPOS = -2400
VARI L_WIDTH = 2000
VARI L_HEIGHT = 500

VARI S_XPOS = DEF_XPOS + 2000
VARI S_YPOS = DEF_YPOS - 500
CALL SET_DISPLAY , S_XPOS , S_YPOS , "問いかけ" ,  HTML_DIV_WINDOW(2000 , 200 , "＞どのピクシーを連れて行きますか？" , "MESSAGE")
;@"<div width='2000' height='200' padding='50' %L_デフォルト%>どのピクシーを連れて行きますか？</div>"

VARS ピクシー画像 , 8
;ピクシー画像:0 '= "ライドウハイピク" , "ピクシーA" , "ピクシーB" , "ピクシーC" , "鳩ピク" , "魔ピクA" , "魔ピクB" , "カーンピクシー"
VARSET ピクシー画像 , 選択フィルタ()
VARS 説明文 , 8
説明文:0 = デビルサマナー葛葉ライドウ<br>　　　　　　対<br>　　　　アバドン王<br>　　　 のハイピクシー
説明文:1 = いつものピクシー
説明文:2 = 真・女神転生デビルサマナー<br>　　　　 のピクシー
説明文:3 = ぽてぽてピクシー
説明文:4 = 真・女神転生外典　鳩の戦記<br>　　　　 のピクシー
説明文:5 = コミカライズ版魔神転生　　<br>　　　のピクシー①
説明文:6 = コミカライズ版魔神転生　　<br>　　　のピクシー②
説明文:7 = 真・女神転生カーン　　<br>　　 のピクシー
FOR LOCAL , 0 , 8
	LOCALS = <div xpos='0' ypos='0' border_width='1' padding='10' width='410' height='410'><img src='%ピクシー画像:LOCAL%' height='400'></div>
	LOCALS += @"<div xpos='500' ypos='0'>%説明文:LOCAL%</div>"
	;LOCALS += SET_BUTTON_TAG( "<div xpos='-50' ypos='-50'>" + 透明選択フィルタ(L_WIDTH , L_HEIGHT) + "</div>" , TOSTR(LOCAL))
	LOCALS += SET_BUTTON_TAG( "<div xpos='-50' ypos='-50'>" + 点滅選択フィルタ(L_WIDTH , L_HEIGHT +LOCAL*100) + "</div>" , TOSTR(LOCAL))
	S_XPOS = DEF_XPOS+((LOCAL%3)*(L_WIDTH+100))
	S_YPOS = DEF_YPOS+((LOCAL/3)*(L_HEIGHT+275))
	;LOCALS = <div width='{L_WIDTH}' height='{L_HEIGHT}' padding='50' %L_デフォルト%>%LOCALS%</div>

	CALL SET_DISPLAY , S_XPOS , S_YPOS , @"ピクシーウィンドウ{LOCAL}" ,  HTML_DIV_WINDOW(L_WIDTH , L_HEIGHT , LOCALS , @"選択肢{LOCAL}" , 50)
	;CALL SET_DISPLAY , @"ピクシーウィンドウ{LOCAL}" , LOCALS
NEXT

$REFRESH
CLEARLINE 2
CALL SHOW_DISPLAY
;時間計測 = GETTIME() - 時間計測
;PRINTFORML {時間計測}
$INPUT_LOOP
INPUTS 
LOCAL = TOINT(RESULTS)
IF INRANGE(RESULT , 0 , 7)
	CLEARLINE 2
	;全てDEACTIVATE
	CALL DEACTIVATE_DISPLAY
	CALL ACTIVATE_DISPLAY , @"ピクシーウィンドウ{LOCAL}"
	CALL ACTIVATE_DISPLAY , "問いかけ"
	
	LOCALS = <div xpos='0' ypos='0' border_width='1' padding='10' width='510' height='510'><img src='%ピクシー画像:LOCAL%' height='500'></div>
	LOCALS += @"<div xpos='600' ypos='0'>%説明文:LOCAL%</div>"
	LOCALS += "<div xpos='600' ypos='600'>このピクシーでよろしいですか？</div>"
	LOCALS = %HTML_DIV_WINDOW(3000 , 800 , LOCALS , , 50)%
	;LOCALS = <div xpos='2600' ypos='-1500' width='3000' height='800' padding=50 %L_デフォルト%>%LOCALS%</div>
	CALL SET_DISPLAY , 2600 , -1500 , "問いかけ2" , LOCALS 
	CALL SET_DISPLAY , 5000 , -800 , "YN" , HTML_DIV_WINDOW(0 , 0 , "<button value='0'>[0]YES</button><br><button value='1'>[1]NO</button>" , , 50)
	;"YN" , @"<div xpos='5000' ypos='-800' padding = 50 %L_デフォルト%><button value='0'>[0]YES</button><br><button value='1'>[1]NO</button></div>"
	
	CALL SHOW_DISPLAY
	CALL INPUTINT , 0 , 1
	IF RESULT == 1
		CALL CLEAR_DISPLAY , "YN"
		CALL CLEAR_DISPLAY , "問いかけ2"
		CALL ACTIVATE_DISPLAY
		GOTO REFRESH
	ENDIF
ELSE
	SIF RESULTS != ""
		CLEARLINE 1
	GOTO INPUT_LOOP
ENDIF
RETURN 0

