#DIM CONST 最大ウィンドウ数 = 20

;ウィンドウの中身。
#DIMS DIV_DISPLAY , 最大ウィンドウ数
;ウィンドウ名(省略時は1から順番に数字IDを取らせる)
#DIMS NAME_DISPLAY , 最大ウィンドウ数

;ウィンドウのX・Y座標(省略時には0)
#DIM XPOS_DISPLAY , 最大ウィンドウ数
#DIM YPOS_DISPLAY , 最大ウィンドウ数

;ウィンドウの深度（指定が無ければウィンドウの宣言時には最小値+1を取得する）
#DIM DEPTH_DISPLAY , 最大ウィンドウ数
;ウィンドウのアクティブ状況（ウィンドウの宣言時には1である。0になると半透明画像を使ってグレーアウト表示、ボタンはnonbuttonとして表示される。）
#DIM ACTIVE_DISPLAY , 最大ウィンドウ数
#DIM BUTTON_OFF_DISPLAY , 最大ウィンドウ数

;以下は没案
;;ウィンドウの幅・高さ(省略時には0。)
;#DIM WIDTH_DISPLAY , 最大ウィンドウ数
;#DIM HIGHT_DISPLAY , 最大ウィンドウ数
;;ウィンドウのボーダー太さ(省略時には0)
;#DIM BORDER_DISPLAY , 最大ウィンドウ数
;;ウィンドウのボーダーライン色
;#DIMS BORDER_COLOR_DISPLAY , 最大ウィンドウ数
;;ウィンドウのpadding（オフセット）
;#DIM PADDING_DISPLAY , 最大ウィンドウ数
;;ウィンドウの背景色。省略は背景色
;#DIMS BGCOLOR_DISPLAY , 最大ウィンドウ数
;
;;ウィンドウ全体に設定するボタン
;#DIMS BUTTON_DISPLAY , 最大ウィンドウ数
;;ウィンドウ全体に設定するボタン時色。省略時はデフォルト。
;#DIMS BUTTON_COLOR_DISPLAY , 最大ウィンドウ数