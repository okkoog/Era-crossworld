;--------------------------
;スプライトから点滅アニメを作る
;--------------------------
@MAKE_ANIME_BLINKING, L_ANIMENAME, L_SPRITE, L_DELAY = 125, SUM_FRAMES = 8, LOOPNUM
#DIM DYNAMIC LCOUNT, 2
#DIMS DYNAMIC L_ANIMENAME	;作成するアニメのスプライト名
#DIMS DYNAMIC L_SPRITE		;作成元になるスプライト名
#DIM DYNAMIC L_DELAY		;各フレームの表示秒数(ms)
#DIM DYNAMIC SUM_FRAMES		;フレームの総数。実際は消えてから元に戻すまでやるので指定の2倍強のフレーム数となる
#DIM DYNAMIC LOOPNUM		;ループ回数を有限にして終端までいったらとまる用にする。省略した場合は無限にループする。
#DIM DYNAMIC FRAME_LIST,60
#DIM DYNAMIC TEMP_GID
;作成済み
SIF FINDELEMENT(TEMP_GID_SPRITENAME, L_ANIMENAME, , , 1) >= 0
	RETURN 0
;スプライトを登録
CALL PUSH_ARRAY_STR, TEMP_GID_SPRITENAME, L_ANIMENAME
SPRITEANIMECREATE L_ANIMENAME, SPRITEWIDTH(L_SPRITE), SPRITEHEIGHT(L_SPRITE)

FOR LCOUNT, 0, SUM_FRAMES + 1
	TEMP_GID = GET_FREE_TEMP_GID()
	FRAME_LIST:LCOUNT = TEMP_GID
	CALL CHANGE_COLOR_MATRIX, TEMP_GID, L_SPRITE, "透過", MAX(10000 - (10000 / SUM_FRAMES) * LCOUNT, 0)
NEXT
FOR LCOUNT:1, 0, MAX(LOOPNUM, 1)
	FOR LCOUNT, 0, SUM_FRAMES + 1
		SPRITEANIMEADDFRAME L_ANIMENAME, FRAME_LIST:LCOUNT, 0, 0, SPRITEWIDTH(L_SPRITE), SPRITEHEIGHT(L_SPRITE), 0, 0, L_DELAY
	NEXT
	FOR LCOUNT, SUM_FRAMES - 1, 0, -1
		SPRITEANIMEADDFRAME L_ANIMENAME, FRAME_LIST:LCOUNT, 0, 0, SPRITEWIDTH(L_SPRITE), SPRITEHEIGHT(L_SPRITE), 0, 0, L_DELAY
	NEXT
NEXT
SIF LOOPNUM > 0
	SPRITEANIMEADDFRAME L_ANIMENAME, FRAME_LIST:0, 0, 0, SPRITEWIDTH(L_SPRITE), SPRITEHEIGHT(L_SPRITE), 0, 0, 1000 * 60 * 60 * 24
