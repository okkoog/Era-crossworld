;--------------------------
;GID管理用
;--------------------------
#DIM CONST FILTER_GID = 1000000			;画像フィルタのGIDに加算する定数。100万。
#DIM CONST HASH_GID = 100000000			;画像のハッシュ値によるGIDの取得に使用する定数。1億。

;-----------------------
;ハッシュ画像管理用
;-----------------------
#DIM CONST 最大ハッシュ画像 = 1000000		;ハッシュを利用した画像の数。とりあえず最大で100万とする。
#DIMS G_ハッシュ名 , 最大ハッシュ画像		;ハッシュを利用して作成した画像を削除するために保存しておくハッシュ名
