@NPC画像 , ARGS = "" , L_WIDTH=600 , L_HEIGHT=600
#FUNCTIONS
#LOCALSSIZE 1
#LOCALSIZE 1
#DIM L_WIDTH
#DIM L_HEIGHT
LOCALS =
IF SPRITECREATED(@"%ARGS%_1") == 1
	FOR LOCAL , 0 , 4
		LOCALS += @"<div ypos='{LOCAL*(L_HEIGHT/4)}'><img src='%ARGS%_{LOCAL+1}' width='{L_WIDTH}' height='{L_HEIGHT/4}'></div>"
	NEXT
ELSE
	LOCALS =
ENDIF
RETURNF LOCALS