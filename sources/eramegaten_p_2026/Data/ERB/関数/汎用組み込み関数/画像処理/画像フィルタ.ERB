;ウィンドウなどにかぶせるための、非選択時は透明で、選択時は選択フィルタに変わるフィルタ画像
;基本的にボタンとして使用することを想定している。
@透明選択フィルタ , width = -1 , height = -1
#FUNCTIONS
#DIM DYNAMIC width
#DIM DYNAMIC height
RETURNF @"<img src='%透明フィルタ()%' srcb='%選択フィルタ()%' width='{width}' height='{height}'>"

;領域ボタン用の透明なフィルタ
;IDは100万飛んで1
@透明フィルタ , width = -1 , height = -1
#FUNCTIONS
#LOCALSIZE 1
#DIM DYNAMIC width
#DIM DYNAMIC height
#DIM DYNAMIC L_GID = FILTER_GID +1
IF LOCAL == 0
	GCREATE L_GID , 100 , 100
	GCLEAR L_GID , 0x00FFFFFF
	SPRITECREATE "CLEAR_FILTER" , L_GID 
	LOCAL ++
ENDIF
SIF width == -1 && height == -1
	RETURNF "CLEAR_FILTER"
RETURNF @"<img src='CLEAR_FILTER' width='{width}' height='{height}'>"


