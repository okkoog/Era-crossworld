;アニメーションスプライト版
@点滅選択フィルタ , width = 100 , height = 100
#FUNCTIONS
#LOCALSIZE 1
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC width
#DIM DYNAMIC height
#DIM DYNAMIC L_GID = FILTER_GID +10
IF LOCAL == 0
	SPRITEANIMECREATE "BLINK_FILTER" , 100 , 100
	FOR LCOUNT , 0 , 20
		GCREATE L_GID+LCOUNT , 100 , 100
		GCLEAR L_GID+LCOUNT , 透明度変更(100-(ABS(LCOUNT-11)*5) , 0x909090)
		GSETBRUSH L_GID+LCOUNT , 0xFFFFFFFF
		GSETFONT L_GID+LCOUNT , "ＭＳ 明朝" , 10 
		GDRAWTEXT L_GID+LCOUNT , TOSTR(LCOUNT) + "：" + TOSTR(100-(ABS(LCOUNT-11)*5)) + "％" , 20 , 20
		SPRITEANIMEADDFRAME "BLINK_FILTER" , L_GID+LCOUNT , 0 , 0 , 100 , 100 , 0 , 0 , 50
		SIF RESULT == 0
			THROW hogehoge
	NEXT
	LOCAL++
	SETANIMETIMER 1
ENDIF
RETURNF @"<img src='%透明フィルタ()%' srcb='BLINK_FILTER' width='{width}' height='{height}'>"
;RETURNF @"<img src='BLINK_FILTER' width='{width}' height='{height}'>"

@メッセージフェードフィルタ , L_透明度 , L_色 , width , height
#FUNCTIONS
#DIM DYNAMIC L_透明度
#DIM DYNAMIC L_色
#DIM DYNAMIC width
#DIM DYNAMIC height
#DIM DYNAMIC L_GID = FILTER_GID +30

GCREATE L_GID , 100 , 100
GCLEAR L_GID , 透明度変更(L_透明度 , L_色)
SPRITECREATE "MESSAGEFADE_FILTER" , L_GID 
SIF width == -1 && height == -1
	RETURNF "MESSAGEFADE_FILTER"
RETURNF @"<img src='MESSAGEFADE_FILTER' width='{width}' height='{height}'>"
