@画像ハッシュ値 , ハッシュ名
#FUNCTION
#DIMS ハッシュ名
RETURNF HASH_XXH32(ハッシュ名) + HASH_GID

@ハッシュ画像 , ハッシュ名 , width = 0 , height = 0
#FUNCTION
#DIMS ハッシュ名
#DIM width
#DIM height
IF GCREATED(画像ハッシュ値(ハッシュ名)) == 0
	GCREATE 画像ハッシュ値(ハッシュ名) , width , height
	SPRITECREATE ハッシュ名 , 画像ハッシュ値(ハッシュ名)
	RETURNF 0
ELSE
	RETURNF 1
ENDIF


@ハッシュ画像消去 , ハッシュ名 = ""
#DIMS ハッシュ名
GDISPOSE 画像ハッシュ値(ハッシュ名)
SPRITEDISPOSE ハッシュ名





