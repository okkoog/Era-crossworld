;
;@ADD_SPLIT
;ARGS   操作する文字列
;ARGS:1 ARGSを区切る文字列
;ARGS:2 追加する文字列
;※ARGSに空文字列が無い場合、追加を行わない
;================================================
@DEL_SPLIT(ARGS , ARGS:1 , ARGS:2 = "")
#FUNCTIONS
#DIM LOCALSNUM
#LOCALSSIZE 200
#LOCALSIZE 1
#DIM STOCK_RESULT
STOCK_RESULT = RESULT
VARSET LOCALS , ""
SPLIT ARGS , ARGS:1 , LOCALS
LOCALSNUM = RESULT
RESULT = STOCK_RESULT
;一致しているものがないならEND
IF FINDELEMENT(LOCALS, ARGS:2) < 0
	RESULT_F = 0
	RETURNF ARGS
ELSE
	;一致する要素を削除
	ARRAYREMOVE LOCALS, FINDELEMENT(LOCALS, ARGS:2), 1
ENDIF
ARGS = 
FOR LOCAL , 0 , LOCALSNUM - 1
	SIF LOCAL
		ARGS += ARGS:1
	ARGS += LOCALS:LOCAL
NEXT
RETURNF ARGS