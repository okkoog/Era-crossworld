;L_ARRAY = 対象の配列(INT型のみ)
;L_VAR = 配列に入れる文字列で複数まとめていれられる。
;
;※:空白を空き配列としてみるので0はPUSHできないので注意。
@PUSH_ARRAY_STR, L_ARRAY, L_VAR:0,  L_VAR:1,  L_VAR:2,  L_VAR:3,  L_VAR:4,  L_VAR:5,  L_VAR:6,  L_VAR:7,  L_VAR:8,  L_VAR:9
#DIMS REF L_ARRAY
#DIMS L_VAR, 10
#DIM DYNAMIC LCOUNT
FOR LCOUNT, 0, 10
	L_ARRAY:FINDELEMENT(L_ARRAY, "", , , 1) '= L_VAR:LCOUNT
NEXT