;L_ARRAY = 対象の配列(INT型のみ)
;L_VAR = 配列に入れる数値で複数まとめていれられる。
;
;※:0を空き配列としてみるので0はPUSHできないので注意。
@PUSH_ARRAY_INT, L_ARRAY, L_VAR:0,  L_VAR:1,  L_VAR:2,  L_VAR:3,  L_VAR:4,  L_VAR:5,  L_VAR:6,  L_VAR:7,  L_VAR:8,  L_VAR:9
#DIM REF L_ARRAY
#DIM LCOUNT
#DIM L_VAR, 10
FOR LCOUNT, 0, 10
	L_ARRAY:FINDELEMENT(L_ARRAY, 0) = L_VAR:LCOUNT
NEXT