;L_ARRAY = 対象の配列(INT型のみ)
;L_START = 配列の一部のみを扱いたい場合の起点
;L_END   = 配列の一部のみを扱いたい場合の終点
@SHUFFLE_ARRAY_INT, L_ARRAY, L_START = 0, L_END = -1
#DIM REF L_ARRAY
#DIM DYNAMIC L_START
#DIM DYNAMIC L_END
#DIM DYNAMIC LCOUNT
SIF L_END == -1
	L_END = VARSIZE("L_ARRAY")
FOR LCOUNT, L_START, L_END
	SWAP L_ARRAY:RAND(L_START, L_END), L_ARRAY:RAND(L_START, L_END)
NEXT

;STR型版
@SHUFFLE_ARRAY_STR, L_ARRAY, L_START = 0, L_END = -1
#DIMS REF L_ARRAY
#DIM DYNAMIC L_START
#DIM DYNAMIC L_END
#DIM DYNAMIC LCOUNT
SIF L_END == -1
	L_END = VARSIZE("L_ARRAY")
FOR LCOUNT, L_START, L_END
	SWAP L_ARRAY:RAND(L_START, L_END), L_ARRAY:RAND(L_START, L_END)
NEXT