#DIM CONST 最大メッセージウィンドウ数 = 10

#DIMS M_発言者名 , 最大メッセージウィンドウ数
#DIMS M_顔グラウィンドウ , 最大メッセージウィンドウ数
#DIMS M_メッセージ内容 , 最大メッセージウィンドウ数
#DIMS M_メッセージウィンドウ , 最大メッセージウィンドウ数

#DIM メッセージ_X , 最大メッセージウィンドウ数
#DIM CONST DEF_メッセージ_X = 50

#DIM メッセージ_Y , 最大メッセージウィンドウ数
#DIM CONST DEF_メッセージ_Y = -900

#DIM メッセージ_幅 , 最大メッセージウィンドウ数
#DIM CONST DEF_メッセージ_幅 = 3600

#DIM メッセージ_高さ , 最大メッセージウィンドウ数
#DIM CONST DEF_メッセージ_高さ = 800

#DIM メッセージ_枠太さ , 最大メッセージウィンドウ数
#DIM CONST DEF_メッセージ_枠太さ = 20

#DIM メッセージ_枠色 , 最大メッセージウィンドウ数
#DIM CONST DEF_メッセージ_枠色 = GETDEFCOLOR()

#DIM メッセージ_背景色 , 最大メッセージウィンドウ数
#DIM CONST DEF_メッセージ_背景色 = GETDEFBGCOLOR()

#DIMS メッセージ_区切文字 , 最大メッセージウィンドウ数
#DIMS CONST DEF_メッセージ_区切文字 = "<br>"

#DIMS メッセージ_表示タイプ , 最大メッセージウィンドウ数
#DIMS CONST DEF_メッセージ_表示タイプ = "TYPE"

#DIMS メッセージ_オプション , 最大メッセージウィンドウ数
#DIMS CONST DEF_メッセージ_オプション = "ログを残さない/ボタンを利用する/再利用しない"

#DIM メッセージ_フェード間隔 , 最大メッセージウィンドウ数
#DIM CONST DEF_メッセージ_フェード間隔 = 10

#DIM メッセージ_終色 , 最大メッセージウィンドウ数
#DIM CONST DEF_メッセージ_終色 = -1

#DIMS メッセージ_文字列体裁 , 最大メッセージウィンドウ数
#DIMS CONST DEF_メッセージ_文字列体裁 = "LEFT"


;--------------------------------------------------
;コンフィグ系
;ShinEraTenseiでは既に使用しているFLAGとGLOBALを使用するためコメントアウト
;--------------------------------------------------

;#DIM DIV_オート送り
;#DIM GLOBAL SAVEDATA DIV_メッセージ速度
;#DIM GLOBAL SAVEDATA DIV_オート時ウェイト
;#DIM GLOBAL SAVEDATA DIV_右クリック時ウェイト
;#DIM GLOBAL SAVEDATA DIV_メッセージアニメ利用
;					FLAG:자동넘기기
;							オート送りのONOFFを保存します
;					GLOBAL:メッセージ速度
;							メッセージ速度を保存します。表示は0.1秒ごとですがその際の表示されていく文字数はこの値と等しくなります
;					GLOBAL:オート時ウェイト
;							オート送り時、全メッセージ表示後の待機時間を保存します
;					GLOBAL:右クリック時ウェイト
;							右クリック時、全メッセージ表示後の待機時間を保存します
;					GLOBAL:メッセージアニメ利用
;							自動的にオプションに"/NOANIME"を追加します

;--------------------------------------------------
;INPUT_DIV_MESSAGE用
;--------------------------------------------------
#DIM CONST 最大選択肢数 = 10

#DIMS メッセージ_選択肢 , 最大選択肢数
#DIM メッセージ_選択不可 , 最大選択肢数
#DIM メッセージ_選択肢横並び数 = 1


;--------------------------------------------------
;ログ保存用
;--------------------------------------------------

#DIM CONST divメッセージログ保存数 = 500
#DIMS M_保存ログ , divメッセージログ保存数
#DIMS M_発言者ログ , divメッセージログ保存数
#DIMS M_メッセージ内容ログ , divメッセージログ保存数
#DIMS M_顔グラログ , divメッセージログ保存数





