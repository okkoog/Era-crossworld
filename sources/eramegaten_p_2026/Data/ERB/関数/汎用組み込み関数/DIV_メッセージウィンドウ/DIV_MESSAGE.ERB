;=====================================================
;	@INPUTMOUSEKEY_MESSAGE , ARG , ARGS
;	メッセージウィンドウ内でのユーザーの入力制御
;=====================================================

@INPUTMOUSEKEY_MESSAGE , BUTTON_COORD , BUTTON_VALUE , L_OPTION , IS_ANIME
#DIM REF BUTTON_COORD, 0, 0		;ボタンの座標定義
#DIMS REF BUTTON_VALUE, 0		;ボタンの中身
#DIMS DYNAMIC L_OPTION			;送られてきたオプション
#DIM DYNAMIC IS_ANIME			;メッセージアニメ中に呼び出されたどうか。これが否ならメッセージの終わりに呼ばれている。
RESULTS =
;+と*を入れようとする挙動を踏まえてSHIFTはループで逃がす
DO
	IF IS_ANIME && (MESSKIP() || FLAG:윈도우메시지스킵 || GLOBAL:メッセージ速度 == 0 )
		;アニメ中にスキップ設定状態で呼び出されたなら、1msで返す
		INPUTMOUSEKEY 5
	ELSEIF IS_ANIME
		;アニメ中に呼び出された場合はメッセージ速度依存
		INPUTMOUSEKEY 100 - (GLOBAL:メッセージ速度 - 1) * 5
	ELSEIF STRCOUNT(L_OPTION, "NOWAIT") || FLAG:윈도우메시지스킵
		;アニメ中でない場合、ウェイトしないモードであるなら、1msだけ待ってクリックしたものとして返す
		RETURN 1
		INPUTMOUSEKEY 1
		IF RESULT:0 == 4
			RETURN 1
		ENDIF
	ELSEIF FLAG:자동넘기기
		;アニメ中でなくオート送りオンなら設定したウェイト分待つ
		INPUTMOUSEKEY GLOBAL:オート時ウェイト
		IF RESULT:0 == 4
			RETURN 1
		ENDIF
	ELSE
		;オート送りオフなら入力するまで待つ
		INPUTMOUSEKEY 0
	ENDIF
LOOP CONVERT_KEYCORD_TO_STR(RESULT:1) == "SHIFT"
;INPUTMOUSEKEYの結果ごとに処理
VARI IS_CLICKED
IF RESULT:0 == 1
	;クリックした場合
	;クリックフラグをオン
	IS_CLICKED = 1
	SELECTCASE RESULT:1
		CASE 0x100000
			;クリック座標からRESULTSを取る
			CALL CONVERT_CLICK_TO_RESULTS_ABSOLUTE, BUTTON_COORD, BUTTON_VALUE
		CASE 0x200000
			;右クリックしていた場合はスキップボタンと同様
			RESULTS '= "*"
		CASE 0x400000
			;中クリック(ホイール押下)していた場合はコンフィグボタンと同様
			RESULTS '= "/"
	ENDSELECT
	;関数を呼び出してRESULT変わっちゃってるので再度。
	RESULT:0 = IS_CLICKED
;ホイールを動かした場合
ELSEIF RESULT:0 == 2
	;下に動かした場合はオートボタンと同様
	IF RESULT:1 < 0
		RESULTS '= "-"
	;上に動かした場合はログボタンと同様
	ELSEIF RESULT:1 > 0
		RESULTS '= "+"
	ENDIF
ELSEIF RESULT:0 == 3
	;キーボードを押していた
	RESULTS '= CONVERT_KEYCORD_TO_STR(RESULT:1)
	IF MATCH(BUTTON_VALUE , RESULTS)
		;指定されてるボタンと一致してたらそのまま返す
	ELSEIF RESULTS == "ESC"
		;エスケープボタンはスキップボタン扱い
		RESULTS '= "*"
	ELSE
		;指定されてるボタンに一致してないなら空文字列を入れて返す=ENTERとかと同様扱い
	ENDIF
ENDIF

;スキップ中はスキップボタン以外反応しない
IF IS_ANIME && (MESSKIP() || FLAG:윈도우메시지스킵 || GLOBAL:メッセージ速度 == 0 ) && RESULTS != "*"
	RETURN 1
ELSE
	;時間切れ(RESULT:0==4)の場合はそのままRESULTを返すだけでよいので省略
	RETURN RESULT:0 , RESULT:1 , RESULT:2 , RESULT:3 , RESULT:4 
ENDIF

;=====================================================
;	@CLEAR_MESSAGE , ARG
;	指定したメッセージウィンドウを削除し、座標やオプション等も初期化する
;	ARGを省略した場合、全てのメッセージウィンドウについて同様の処理を行う。
;	システム側で呼び出す場所：推奨
;			ダンジョンのイベント終了時/メインフローに戻って来た時
;			戦闘開始/ターン開始/ターン終了時など
;			ショップ画面に戻って来た時
;
;=====================================================
@CLEAR_MESSAGE , ARG = -1
#DIM DYNAMIC L_MIN = 0
#DIM DYNAMIC L_MAX = 最大メッセージウィンドウ数
IF INRANGE(ARG , 0 , 最大メッセージウィンドウ数 -1)
	CALL CLEAR_DISPLAY , @"メッセージウィンドウ{ARG}"
	CALL INITIALIZE_MESSAGE , ARG 
ELSE 
	FOR LOCAL , L_MIN , L_MAX
		CALL CLEAR_DISPLAY , @"メッセージウィンドウ{LOCAL}"
	NEXT
	CALL INITIALIZE_MESSAGE
	CALL CLEAR_DISPLAY , "メッセージGUI"
ENDIF

