;-------------------------------------------------
;数値型インプット関数@INPUT_ARRAY
;
;配列を送り、その配列番号が真になるように入力があったときのみその数値を返す
;
;ex:L_ARRAY:0, 1, 3が真で送られてきてるなら0と1と3の入力を通して、2の入力は通さない
;-------------------------------------------------
@INPUT_ARRAY, L_ARRAY
#DIM REF L_ARRAY
INPUT
SIF INRANGE(RESULT, 0, VARSIZE("L_ARRAY") - 1) && L_ARRAY:RESULT > 0
	RETURN RESULT
CLEARLINE 1
REUSELASTLINE 
RESTART