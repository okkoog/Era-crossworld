@CONVERT_YPOS_TOP_TO_BUTTOM, L_YPOS, L_BASE_YPOS = -99999
#FUNCTION
#DIM DYNAMIC L_YPOS		;基準点から下に進んだ数値
#DIM DYNAMIC L_BASE_YPOS;基準点
SIF L_BASE_YPOS == -99999
	L_BASE_YPOS = -GET_HEIGHTLENS() * 100
RETURNF L_YPOS + (L_BASE_YPOS + 100)

@CONVERT_YPOS_TOP_TO_BUTTOM_ISLAND, L_YPOS, L_BASE_YPOS = -99999
#FUNCTION
#DIM DYNAMIC L_YPOS
#DIM DYNAMIC L_BASE_YPOS
SIF L_BASE_YPOS == -99999
	L_BASE_YPOS = -GET_HEIGHTLENS() * 100
RETURNF L_YPOS + (L_BASE_YPOS + 200)