;-------------------------------------------------
;配列一致インプット関数@INPUTS_MATCH_ARRAY
;
;配列を送り、その配列の中に一致する内容をINPUTSした場合、そのRESULTSを返す
;IS_BLANK_ABLEが真でない場合、空文字列は弾くので注意
;
;ex:L_ARRAY:0 = A, L_ARRAY:1 = Qとなら、AとQの入力が通り、RESULTSにA・Qがはいってかえされる
;-------------------------------------------------
@INPUTS_MATCH_ARRAY, L_ARRAY, IS_BLANK_ABLE = 0
#DIMS REF L_ARRAY
#DIM DYNAMIC IS_BLANK_ABLE
INPUTS
IF IS_BLANK_ABLE == 1 || RESULTS != ""
	SIF MATCH(L_ARRAY, RESULTS)
		RETURN 1
	CLEARLINE 1
	REUSELASTLINE 
ENDIF
RESTART