;
;	Modification Data:
;
;	Edit	Date			Author					Reason
;	001		2024/05/16		P(bazzile)				新規作成
;	002		2024/05/31		P(bazzile)				テンキーの変換ミスを修正
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;======================================================

@CONVERT_KEYCORD_TO_STR, L_KEYCORD
#FUNCTIONS
#DIM DYNAMIC L_KEYCORD
SELECTCASE L_KEYCORD
	;0 - 9
	CASE 48 TO 57
		RETURNF TOSTR(L_KEYCORD - 48)
	;0 - 9 (テンキー)
	CASE 96 TO 105
		RETURNF TOSTR(L_KEYCORD - 96)
	;a - z
	CASE 65 TO 90
		RETURNF UNICODE(0x61 + L_KEYCORD - 65)
	;F1 - F9
	CASE 112 TO 130
		RETURNF "F" + TOSTR(L_KEYCORD - 111)
	CASE 192
		RETURNF "@"
	CASE 110
		RETURNF "."
	CASE 107
		RETURNF "+"
	CASE 109
		RETURNF "-"
	CASE 106
		RETURNF "*"
	CASE 111
		RETURNF "/"
	CASE 186
		RETURNF ":"
	CASE 187
		RETURNF ";"
	CASE 38
		RETURNF "↑"
	CASE 40
		RETURNF "↓"
	CASE 37
		RETURNF "←"
	CASE 39
		RETURNF "→"
	CASE 8
		RETURNF "BACKSPACE"
	CASE 20
		RETURNF "CAPSLOCK"
	CASE 12
		RETURNF "CLEAR"
	CASE 3
		RETURNF "CANCEL"
	CASE 17
		RETURNF "CTRL"
	CASE 46
		RETURNF "DEL"
	CASE 35
		RETURNF "END"
	CASE 13
		RETURNF "ENTER"
	CASE 27
		RETURNF "ESC"
	CASE 36
		RETURNF "HOME"
	CASE 162
		RETURNF "LCTRL"
	CASE 164
		RETURNF "LALT"
	CASE 160
		RETURNF "LSHIFT"
	CASE 1
		RETURNF "LWIN"
	CASE 18
		RETURNF "ALT"
	CASE 144
		RETURNF "NUMLOCK"
	CASE 34
		RETURNF "PAGEDOWN"
	CASE 33
		RETURNF "PAGEUP"
	CASE 163
		RETURNF "RCTRL"
	CASE 13
		RETURNF "RETURN"
	CASE 165
		RETURNF "RALT"
	CASE 161
		RETURNF "RSHIFT"
	CASE 92
		RETURNF "RWIN"
	CASE 145
		RETURNF "SCROLLLOCK"
	CASE 16
		RETURNF "SHIFT"
	CASE 44
		RETURNF "PRINTSCREEN"
	CASE 32
		RETURNF "SPACE"
	CASE 9
		RETURNF "TAB"
	CASEELSE
		RETURNF "ERROR"
ENDSELECT

