;@STRJOIN(REF_S , ARGS)
;解説：REF_Sの要素全てを、ARGSを挟みながら結合した文字列をRETURNFする。空文字列であれば結合しない。
;
;例： LOCALS = "hoge" , "hage" , "hige" , "mage" でVARSIZE(LOCALS)==4 の時、TEXTJOIN(NO , "\n")を参照すると、 "hoge\nhage\nhige\nmage"が返ってくる。
;
;----------------------------------------
;@STRJOIN(REF_STR , ARGS , L_START = 0 , L_END = -1 )
;#FUNCTIONS
;#DIMS REF REF_STR , 0
;#DIM DYNAMIC L_STR
;#DIM L_START
;#DIM L_END
;SIF L_END == -1
;    L_END = VARSIZE(REF_S) -1
;FOR LOCAL , L_START , L_END
;    SIF REF_STR:LOCAL == ""
;        CONTINUE
;	SIF LOCAL
;		L_STR += ARGS
;	L_STR += REF_STR:LOCAL
;NEXT
;RETURNF L_STR