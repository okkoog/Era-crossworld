;----------------------------------------------------------
;@BGCOLOR(ARGS)
;ARGS 	= 	色名
;ARG	=	前景色との反転指定
;
;RESULT_F = 前景色
;----------------------------------------------------------
@BGCOLOR, ARGS, ARG
#FUNCTION
SELECTCASE TOUPPER(ARGS)
	CASE "DEFAULT" , "DEF" , "デフォルト"
		RESULT_F = GETDEFBGCOLOR(), GETDEFCOLOR()
	CASE "RED", "赤"
		RESULT_F = 0xEB8686, 0x111111
	CASE "BLUE", "青"
		RESULT_F = 0x74AAFD, 0x111111
	CASE "GREEN", "緑"
		RESULT_F = 0x3d774e, 0xfffdfd
	CASE "明黒", "LIGHT-BLACK", "LIGHTBLACK"
		RESULT_F = 0x2F2A20, GETDEFCOLOR()
ENDSELECT
;RESULT_Fにメインでないほうを入れたいので反転指定がないときにひっくり返す
SIF !ARG
	SWAP RESULT_F, RESULT_F:1
RETURNF RESULT_F:1

@BGCOLOR_HTML, ARGS, ARG
#FUNCTIONS
RETURNF TOSTR_HTML(BGCOLOR(ARGS, ARG))