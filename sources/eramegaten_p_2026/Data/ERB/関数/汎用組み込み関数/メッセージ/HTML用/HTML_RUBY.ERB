;---------------------------------------------

;現状での実装として、ルビは全てそのまま縮小しただけの文章を出す
;余裕が出来たら本文の文字に割り振るような表示を考える

;---------------------------------------------
@HTML_RUBY , 本文 , ルビ , ルビサイズ = 75
#FUNCTIONS
#DIMS DYNAMIC 本文
#DIMS DYNAMIC ルビ
#DIM DYNAMIC ルビサイズ
#DIM DYNAMIC ルビ位置 , 2
#DIM 本文長さ
#DIM ルビ長さ

本文長さ=STRLENS(HTML_TOPLAINTEXT(本文)) * 50
ルビ長さ=STRLENS(HTML_TOPLAINTEXT(ルビ)) * 50 * ルビサイズ / 100

;x座標を割り出し
ルビ位置:0 = 本文長さ/2 - ルビ長さ/2
;y座標を割り出し
ルビ位置:1 = - ルビサイズ - 10

RETURNF @"<div xpos='{ルビ位置}' ypos='{ルビ位置:1}'><font size='{ルビサイズ}'>%ルビ%</font></div>" + 本文




