;----------------------------------------------------------
;@COLOR(ARGS)
;ARGS 	= 	色名
;ARGS:1 = 	VALUE
;ARGS:2	=	TITLE(ツールチップ)
;----------------------------------------------------------
@SET_BUTTON_TAG, ARGS, ARGS:1, ARGS:2
#FUNCTIONS
IF ARGS:1 != ""
	RETURNF @"<button value = '%ARGS:1%' title = '%ARGS:2%'>" + ARGS + "</button>"
ELSE
	RETURNF @"<nonbutton title = '%ARGS:2%'>" + ARGS + "</nonbutton>"
ENDIF


;ボタンタグを剥ぐ
@DEL_BUTTON_TAG, ARGS
#FUNCTIONS
RETURNF REPLACE(ARGS, "</?(non)?button.*?>", "")
