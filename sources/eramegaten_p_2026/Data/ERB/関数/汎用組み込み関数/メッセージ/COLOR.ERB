;----------------------------------------------------------
;@COLOR(ARGS)
;ARGS 	= 	色名
;ARG  	= 	BATTLE指定時のキャラ番号 / RAINBOWの番号
;ARG:1	=	BATTLE指定時の反転指定
;----------------------------------------------------------
@COLOR, ARGS, ARG = -1, ARG:1
#FUNCTION
#DIM DYNAMIC L_RESULT
#DIM DYNAMIC TEMP
SELECTCASE TOUPPER(ARGS)
	CASE "DEFAULT" , "DEF" , "デフォルト"
		RETURNF GETDEFCOLOR()
	CASE "紅"
		RETURNF 0xB815B8
	CASE "深紅"
		RETURNF 0xEF5445
	CASE "RED", "赤"
		RETURNF 0x990000
	CASE "P-RED", "PASTEL-RED", "パ赤"
		RETURNF 0xC07070
	CASE "P-BLUE", "PASTEL-BLUE", "パ青"
		RETURNF 0x7070C0
	CASE "P-GREEN", "PASTEL-GREEN", "パ緑"
		RETURNF 0x70C070
	CASE "PURPLE", "紫"
		RETURNF 0x9629cc
	CASE "P-PURPLE", "PASTEL-PURPLE", "パ紫"
		RETURNF 0xC070C0
	CASE "P-YELLOW", "PASTEL-YELLOW", "パ黄"
		RETURNF 0x505020
	CASE "P-BGREEN", "P-BLUEGREEN", "PASTEL-BLUEGREEN", "パ青緑"
		RETURNF 0x205050
	CASE "WHITE", "白"
		RETURNF 0xC0C0C0
	CASE "BLACK", "黒"
		RETURNF 0x000000
	CASE "暗水色"
		RETURNF 0xB0CCEF
	CASE "AQUA", "水色"
		RETURNF 0x66FFFF
	CASE "DARK-GRAY", "暗灰色"
		RETURNF 0x404040
	CASE "GRAY", "灰色"
		RETURNF 0x777777
	CASE "LIGHT-GRAY", "明灰色"
		RETURNF 0x909090
	CASE "DARK-PINK", "黒桃"
		RETURNF 0x990099
	CASE "ショッキングピンク"
		RETURNF 0xEF0EEF
	CASE "ピンク"
		RETURNF 0xEF857C
	CASE "PINK", "桃", "桃色"
		RETURNF 0xFF33FF
	CASE "ハートピンク", "明桃色"
		RETURNF 0xFFC0CB
	CASE "BROWN","茶色"
		RETURNF 0x90623C
	CASE "黄色","YELLOW","イエロー"
		RETURNF 0xEFD540
	CASE "暗黄色","DARK-YELLOW"
		RETURNF 0xC4C400
	CASE "明黄色","LIGHT-YELLOW","レモン","レモン色","レモンイエロー"
		RETURNF 0xFFFF00
	CASE "ライム", "LIME", "LIGHT-GREEN", "明緑色"
		RETURNF 0x5AFF19
	CASE "藍色"
		RETURNF 0x165E83
	CASE "FRIENDLY", "友好", "友好色", "友好水色"
		RETURNF 0x33ffcc
	CASE "WARNING", "警告", "警告色", "警告赤"
		RETURNF 0xff0033
	CASE "FRIEND", "味方水色"
		RETURNF 0x33ffcc
	CASE "ENEMY", "敵赤"
		RETURNF 0xff0033
	CASE "BATTLE", "BTL", "バトルカラー"
		IF (CFLAG:ARG:PT플래그 > 0 && !ARG:1) || (CFLAG:ARG:PT플래그 <= 0 && ARG:1)
			RETURNF 0x33ffcc
		ELSE
			RETURNF 0xff0033
		ENDIF
	CASE "NAVI", "NAVIGATOR", "ナビゲーター", "ナビ"
		SIF !OPT_NAVI_COLOR_MAIN
			RETURNF COLOR("FRIEND")
		RETURNF OPT_NAVI_COLOR_OTHER
	CASE "NAVI_MAIN", "NAVIGATOR_MAIN", "ナビゲーター_メイン画面", "ナビ_メイン画面"
		SIF !OPT_NAVI_COLOR_OTHER
			RETURNF GETCOLOR()
		RETURNF OPT_NAVI_COLOR_MAIN
	CASE "バフ"
		RETURNF 0x66FFFF
	CASE "デバフ"
		RETURNF 0x404040
	CASE "통상컬러"
		RETURNF FLAG:통상컬러 / 1000 / 1000 * 256 * 256 + FLAG:통상컬러 / 1000 % 1000 * 256 + FLAG:통상컬러 % 1000
	CASE "약점컬러"
		RETURNF FLAG:약점컬러 / 1000 / 1000 * 256 * 256 + FLAG:약점컬러 / 1000 % 1000 * 256 + FLAG:약점컬러 % 1000
	CASE "내성컬러"
		RETURNF FLAG:내성컬러 / 1000 / 1000 * 256 * 256 + FLAG:내성컬러 / 1000 % 1000 * 256 + FLAG:내성컬러 % 1000
	CASE "무효컬러"
		RETURNF FLAG:무효컬러 / 1000 / 1000 * 256 * 256 + FLAG:무효컬러 / 1000 % 1000 * 256 + FLAG:무효컬러 % 1000
	CASE "흡수컬러"
		RETURNF FLAG:흡수컬러 / 1000 / 1000 * 256 * 256 + FLAG:흡수컬러 / 1000 % 1000 * 256 + FLAG:흡수컬러 % 1000
	CASE "반사컬러"
		RETURNF FLAG:반사컬러 / 1000 / 1000 * 256 * 256 + FLAG:반사컬러 / 1000 % 1000 * 256 + FLAG:반사컬러 % 1000
	CASE "RAINBOW", "虹", "虹色"
		RETURNF GET_RAINBOW(ARG)
	CASE "ダンジョン内欲情ハート"
		TEMP = MIN(ARG == -1 ? ARG:1 # CFLAG:ARG:던전내발정용욕정치, 15000)
		IF ARG >= 0 && CFLAG:ARG:던전내발정
			RETURNF 0xff00ff
		ELSE
			L_RESULT = 0xff * TEMP / 15000 * 256 * 256
			L_RESULT += 0 * 256
			L_RESULT += 0xff * TEMP / 15000
			RETURNF L_RESULT
		ENDIF
	CASE "ダンジョン内欲情文字列"
		TEMP = MIN(ARG == -1 ? ARG:1 # CFLAG:ARG:던전내발정용욕정치, 15000)
		L_RESULT += (0x40 + (0xff - 0x40) * TEMP / 15000) * 256 * 256
		L_RESULT += (0x40 - (0x40 * TEMP / 15000)) * 256
		L_RESULT += (0x40 + (0xff - 0x40) * TEMP / 15000)
		RETURNF L_RESULT
	CASEELSE
		RETURNF -1
ENDSELECT

@PRINT_COLOR, ARGS, ARG, ARGS:1
#DIM L_TEMP
L_TEMP = GETCOLOR()
SETCOLOR ARG
PRINTS ARGS
SELECTCASE ARGS:1
	CASE "W", "w", "WAIT"
		PRINTW 
	CASE "L", "l"
		PRINTL 
ENDSELECT
SETCOLOR L_TEMP

@BTL_COLOR_TABLE
#FUNCTIONS
RETURNF "白/暗灰色/灰色/警告/赤/深紅/パ赤/黒桃/パ紫/藍色/パ青/水色/暗水色/パ緑/ライム/黄色/暗黄色/茶色"

@BTL_COLOR_TABLE_NUM
#FUNCTION
RETURNF STRCOUNT(BTL_COLOR_TABLE(), "/")

@SET_DEFAULT_USER_TILE_COLOR
#DIM DYNAMIC LCOUNT
FOR LCOUNT, 0, VARSIZE("DUNGEON_USER_TILE_COLOR")
	DUNGEON_USER_TILE_COLOR:LCOUNT = GET_DEFAULT_USER_TILE_COLOR(LCOUNT)
NEXT
SAVEGLOBAL

@GET_DEFAULT_USER_TILE_COLOR, ARG
#FUNCTION
SELECTCASE ARG
	CASE 0
		RETURNF 0
	CASE 1
		RETURNF COLOR("赤")
	CASE 2
		RETURNF COLOR("桃色")
	CASE 3
		RETURNF COLOR("パ紫")
	CASE 4
		RETURNF COLOR("パ緑")
	CASE 5
		RETURNF COLOR("ライム")
	CASE 6
		RETURNF COLOR("水色")
	CASE 7
		RETURNF COLOR("藍色")
	CASE 8
		RETURNF COLOR("茶色")
	CASE 9
		RETURNF COLOR("黄色")
	CASE 10
		RETURNF COLOR("灰色")
ENDSELECT
@TOSTR_HTML(ARG)
#FUNCTIONS
RETURNF "#" + TOSTR(ARG, "X6")