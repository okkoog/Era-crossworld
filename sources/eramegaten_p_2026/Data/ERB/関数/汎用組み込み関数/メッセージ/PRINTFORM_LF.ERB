;
;	Module		:PRINTFORM_LF
;	Facility	:改行コード込みの文字列をPRINTL を補って展開する関数
;
;	Licence		:ライセンスフリー。
;
;	Modification Data:
;
;	Edit	Date			Author					Reason
;	001		2022/12/10		P(bazzile)				新規作成
;
;	ARGS	 = 文字列
;	ARGS:1	 = WAITの指定(強制的にPRINTL状態で終わる)
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;======================================================
@PRINTFORM_LF, ARGS, ARGS:1
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC L_RESULTS, 10
SPLIT ARGS, UNICODE(0x000D), L_RESULTS
FOR LCOUNT, 0, RESULT
	PRINTFORML %L_RESULTS:LCOUNT%
NEXT
SIF GROUPMATCH(ARGS:1, "w", "W", "WAIT")
	WAIT