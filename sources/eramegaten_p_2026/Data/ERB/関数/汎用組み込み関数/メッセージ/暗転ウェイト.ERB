;----------------------------------------------------------
;@暗転ウェイト実行
;画面を一度クリアしてから0.1MSのWAIT処理をかける
;----------------------------------------------------------
@暗転ウェイト実行
#DIM DYNAMIC L_REDRAW
#DIM DYNAMIC L_LINE
L_LINE = LINECOUNT
L_REDRAW = CURRENTREDRAW()
WHILE LINECOUNT - L_LINE < 100
	PRINTL 
WEND
TWAIT 100, 0
REDRAW L_REDRAW
CLEARLINE L_LINE - LINECOUNT