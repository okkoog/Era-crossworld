;=================================================================
;그외(戦闘関連以外)設定スイッチに関する関数郡
; FLAG:그외설정스위치 にBIT値で設定を記録する
;  0 = 外見・スリーサイズ機能設定
;  1 = 魔貨レート変動機能設定
;  2 = ベルベットルームでのステータスアップ画面設定

;=================================================================

;-----------------------------------------------------------------
;@SETTING_IS_3SIZE
;外見・スリーサイズ機能を利用するか設定を返す
;　引数　なし
; 戻り値 0=設定が無効 1=設定が有効
;-----------------------------------------------------------------
@SETTING_IS_3SIZE
#FUNCTION
#LOCALSIZE  1
#LOCALSSIZE 1
	;設定が有効
	SIF GETBIT(FLAG:그외설정스위치, 0) == 1
		RETURNF 1
	;設定が無効
	RETURNF 0

;-----------------------------------------------------------------
;@SETTING_INVERT_3SIZE
;外見・スリーサイズ機能を利用するかの設定を行う、関数を呼び出すごとにON/OFF変更
;　引数　なし
; 戻り値 なし
;-----------------------------------------------------------------
@SETTING_INVERT_3SIZE
#LOCALSIZE  1
#LOCALSSIZE 1
	INVERTBIT FLAG:그외설정스위치, 0


;-----------------------------------------------------------------
;@SETTING_SET_3SIZE
;外見・スリーサイズ機能を利用するかの設定を行う
;　引数　ARG:0 0=設定が無効 1=設定が有効
; 戻り値 なし
;-----------------------------------------------------------------
@SETTING_SET_3SIZE, ARG
#LOCALSIZE  1
#LOCALSSIZE 1
	IF ARG == 0
		CLEARBIT FLAG:그외설정스위치, 0
	ELSE
		SETBIT FLAG:그외설정스위치, 0
	ENDIF

