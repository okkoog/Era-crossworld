;-------------------------------------------------
;特定の要素を数える関数@COUNT_ELEMENT / @COUNT_ELEMENTS
;  ARR : 配列
;  VAL : 検索内容
;  START : 検索開始位置
;  END : 検索終了位置+1
;配列ARRにVALが何個あるか数える
;COUNT_ELEMENTSは文字列版
;検索はFINDELEMENTを使っているので、文字列版の場合は正規表現も使える
;-------------------------------------------------
@COUNT_ELEMENT(ARR, VAL, START=0, END=-1)
#FUNCTION
#DIM REF ARR
#DIM VAL
#DIM START
#DIM END
#DIM LCOUNT
#DIM NUM
SIF END == -1
	END = VARSIZE("ARR")
NUM = 0
DO
	START = FINDELEMENT(ARR, VAL, START, END)
	SIF START == -1
		BREAK
	NUM++
	START++
LOOP 1
RETURNF NUM

@COUNT_ELEMENTS(ARR, VAL, START=0, END=-1)
#FUNCTION
#DIMS REF ARR
#DIMS VAL
#DIM START
#DIM END
#DIM LCOUNT
#DIM NUM
SIF END == -1
	END = VARSIZE("ARR")
NUM = 0
DO
	START = FINDELEMENT(ARR, VAL, START, END)
	SIF START == -1
		BREAK
	NUM++
	START++
LOOP 1
RETURNF NUM

