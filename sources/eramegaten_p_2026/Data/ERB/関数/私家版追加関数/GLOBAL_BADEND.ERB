;=================================================================
;BADエンドに関する関数群
;グローバル値にbitで記録する
;バッドエンド記録1　No.0～63用
;バッドエンド記録2　No.64～127用
;
;No. 0～　RPG系全滅エンドを想定(闘技場含む)
;No.30～　調教系バットエンドを想定
;No.40～　シナリオ上のバットエンドを想定
;No.50～　EXTRA系のバットエンドを想定
;
;バットエンドメッセージは以下みたいな感じで
;	PRINTW 
;	PRINTW 　　　　　　　　――  Bad Ending No.006 ( 全滅END -ソウルハッカーズ編- )
;	CALL GLOBAL_BADEND_SET(6)
;=================================================================


;-----------------------------------------------------------------
;@GLOBAL_BADEND_INIT
;BADエンド関係の変数値を初期化
;　引数、戻り値は特になし
;-----------------------------------------------------------------
@GLOBAL_BADEND_INIT
	GLOBAL:バッドエンド記録1 = 0
	GLOBAL:バッドエンド記録2 = 0
	SAVEGLOBAL
	RETURN 1

;-----------------------------------------------------------------
;@SHOPCOMABLE_700, @SHOP_COM_700
;BADエンド関係デバック用リセットSHOPメニュー(700)
;　引数、戻り値は特になし
;-----------------------------------------------------------------
@SHOPCOMABLE_700
	[IF_DEBUG]
		RESULTS = 배드엔딩 기록 리셋
		RETURN 1
	[ENDIF]
	IF FLAG:DEBUG
		RESULTS = 배드엔딩 기록 리셋
		RETURN 1
	ENDIF
	RETURN -1

@SHOP_COM_700, ARG
	CALL GLOBAL_BADEND_INIT
	PRINTL 배드엔딩 기록을 리셋했습니다

;-----------------------------------------------------------------
;@GLOBAL_BADEND_SET
;指定されたBADエンドNo.を記録する
;　ARG:0 記録するBADエンドのNo.
;　戻り値は特になし
;-----------------------------------------------------------------
@GLOBAL_BADEND_SET, ARG
	LOADGLOBAL
	
	IF ARG < 64
		SETBIT GLOBAL:バッドエンド記録1, ARG
	ELSE
		LOCAL = ARG - 64
		SETBIT GLOBAL:バッドエンド記録2, LOCAL
	ENDIF
	
	SAVEGLOBAL
	RETURN 1

;-----------------------------------------------------------------
;@GLOBAL_BADEND_GET
;指定されたBADエンドNo.が記録済か返す
;　ARG:0 記録済か判定するBADエンドのNo.
;　RESULT 真:記録済 偽:記録なし
;-----------------------------------------------------------------
@GLOBAL_BADEND_GET, ARG
	LOADGLOBAL

	IF ARG < 64
		LOCAL = GETBIT(GLOBAL:バッドエンド記録1, ARG)
	ELSE
		LOCAL = ARG - 64
		LOCAL = GETBIT(GLOBAL:バッドエンド記録2, LOCAL)
		LOCAL = LOCAL + 64
	ENDIF
	
	RETURN LOCAL


;-----------------------------------------------------------------
;@GLOBAL_BADEND_DISP_BADENDLIST
;BADエンドの一覧(No.とタイトル)を表示出力する
;　引数、戻り値は特になし
;-----------------------------------------------------------------
@GLOBAL_BADEND_DISP_BADENDLIST
	DRAWLINE
	PRINTL 발견 완료된 BAD엔딩
	DRAWLINE
	FOR LOCAL ,0, 127
		CALL GLOBAL_BADEND_GET(LOCAL)
		SIF RESULT == 0
			CONTINUE
