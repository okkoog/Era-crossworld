;-----------------------------------------------------------------------------
;ミリ秒→HH:MI:SS　に変換する関数
;-----------------------------------------------------------------------------
;引数
;	ARG_TIME:時間(ミリ秒)
;-----------------------------------------------------------------------------
;返り値
;	STAR_TIME(HH:MI:SS形式。例として引数のミリ秒が16時間42分15秒となる場合は16:42:15を返す)
;-----------------------------------------------------------------------------
@CHANGE_MS_TO_HHMISS, ARG_TIME
#FUNCTIONS
#LOCALSIZE  1
#LOCALSSIZE 1
;-------------
;変数定義
;-------------
#DIM ARG_TIME						;引数の時間(ミリ秒)
#DIMS STAR_TIME						;最終的に作成する文字列(HH:MI:SS形式)
#DIM TIME_HH						;時間(hour)
#DIM TIME_MI						;分
#DIM TIME_SS						;秒

;-------------
;変数の初期化
;-------------
STAR_TIME = 
TIME_HH = 0							;時間(hour)
TIME_MI = 0							;分
TIME_SS = 0							;秒


;-------------
;ここから本処理
;-------------
;最大表示を99時間60分60秒とする(100時間以上は上限越え)
IF ARG_TIME / 1000 / 60 / 60 >= 100
	RETURNF "99:59:59"
ENDIF

;時間(hour)、分、秒をそれぞれ取得する
TIME_HH = ARG_TIME / 1000 / 60 / 60		;時間(hour)を取得する
TIME_MI = (ARG_TIME / 1000 / 60) % 60	;分を取得する
TIME_SS = ((ARG_TIME / 1000) % 60) % 60	;秒を取得する

;最終的な文字列を作成する
;時間(hour)
IF TIME_HH < 10
	STAR_TIME += @"0{TIME_HH}"
ELSE
	STAR_TIME += @"{TIME_HH}"
ENDIF
STAR_TIME += ":"

;分
IF TIME_MI < 10
	STAR_TIME += @"0{TIME_MI}"
ELSE
	STAR_TIME += @"{TIME_MI}"
ENDIF
STAR_TIME += ":"

;秒
IF TIME_SS < 10
	STAR_TIME += @"0{TIME_SS}"
ELSE
	STAR_TIME += @"{TIME_SS}"
ENDIF

RETURNF STAR_TIME
