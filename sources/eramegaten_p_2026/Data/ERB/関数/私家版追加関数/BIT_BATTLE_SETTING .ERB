;=================================================================
;戦闘難易度関連設定スイッチに関する関数郡
; FLAG:전투난이도관련설정스위치 にBIT値で設定を記録する
;  0 = 素質関連設定
;  1 = バステ命中設定
;  2 = 1more関連設定
;  3 = 装備耐性・効果変更設定
;  4 = ペルソナ関係処理形式設定
;  5 = 装備知識関連設定
;  6 = 攻撃アイテムの威力計算設定
;  7 = 攻撃アイテムの命中計算設定
;=================================================================

;-----------------------------------------------------------------
;@BATTLE_SETTING_IS_TALENT
;戦闘時にキャラの素質がスキル等に影響を与えるかの設定を返す
;　引数　なし
; 戻り値 0=設定が無効 1=設定が有効
;-----------------------------------------------------------------
@BATTLE_SETTING_IS_TALENT
#FUNCTION
#LOCALSIZE  1
#LOCALSSIZE 1
	;設定が有効
	SIF GETBIT(FLAG:전투난이도관련설정스위치, 0) == 1
		RETURNF 1
	;設定が無効
	RETURNF 0

;-----------------------------------------------------------------
;@BATTLE_SETTING_INVERT_TALENT
;戦闘時にキャラの素質がスキル等に影響を与えるかの設定を行う、関数を呼び出すごとにON/OFF変更
;　引数　なし
; 戻り値 なし
;-----------------------------------------------------------------
@BATTLE_SETTING_INVERT_TALENT
#LOCALSIZE  1
#LOCALSSIZE 1
	INVERTBIT FLAG:전투난이도관련설정스위치, 0

;-----------------------------------------------------------------
;@BATTLE_SETTING_IS_BAD_STATUS
;戦闘時に特定のバステで必ず命中するかの設定を返す
;　引数　なし
; 戻り値 0=設定が無効 1=設定が有効
;-----------------------------------------------------------------
@BATTLE_SETTING_IS_BAD_STATUS
#FUNCTION
#LOCALSIZE  1
#LOCALSSIZE 1
	;設定が有効
	SIF GETBIT(FLAG:전투난이도관련설정스위치, 1) == 1
		RETURNF 1
	;設定が無効
	RETURNF 0

;-----------------------------------------------------------------
;@BATTLE_SETTING_INVERT_BAD_STATUS
;戦闘時に特定のバステで必ず命中するかの設定を行う、関数を呼び出すごとにON/OFF変更
;　引数　なし
; 戻り値 なし
;-----------------------------------------------------------------
@BATTLE_SETTING_INVERT_BAD_STATUS
#LOCALSIZE  1
#LOCALSSIZE 1
	INVERTBIT FLAG:전투난이도관련설정스위치, 1

;-----------------------------------------------------------------
;@BATTLE_SETTING_SET_BAD_STATUS
;戦闘時に特定のバステで必ず命中するかの設定を行う
;　引数　ARG:0 0=設定が無効 1=設定が有効
; 戻り値 なし
;-----------------------------------------------------------------
@BATTLE_SETTING_SET_BAD_STATUS, ARG
#LOCALSIZE  1
#LOCALSSIZE 1
	IF ARG == 0
		CLEARBIT FLAG:전투난이도관련설정스위치, 1
	ELSE
		SETBIT FLAG:전투난이도관련설정스위치, 1
	ENDIF

