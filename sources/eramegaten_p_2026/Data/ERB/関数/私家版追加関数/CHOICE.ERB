;-------------------------------------------------
;選択関数@CHOICE / @CHOICES
;  INDEX : 選択する値
;  ARG:0～19 : 数値
;ARG:INDEXを返すだけ
;複数の数値を値によって選択したいときにIF～ELSEIFをいっぱい作ったり
;いちいちリストを作りたくないというときに
;CHOICESは文字列版
;-------------------------------------------------
@CHOICE(INDEX, ARG:0 = -1, ARG:1 = -1, ARG:2 = -1, ARG:3 = -1, ARG:4 = -1, ARG:5 = -1, ARG:6 = -1, ARG:7 = -1, ARG:8 = -1, ARG:9 = -1, ARG:10 = -1, ARG:11 = -1, ARG:12 = -1, ARG:13 = -1, ARG:14 = -1, ARG:15 = -1, ARG:16 = -1, ARG:17 = -1, ARG:18 = -1, ARG:19 = -1)
#FUNCTION
#DIM INDEX
RETURNF ARG:INDEX

@CHOICES(INDEX, ARGS:0 = "", ARGS:1 = "", ARGS:2 = "", ARGS:3 = "", ARGS:4 = "", ARGS:5 = "", ARGS:6 = "", ARGS:7 = "", ARGS:8 = "", ARGS:9 = "", ARGS:10 = "", ARGS:11 = "", ARGS:12 = "", ARGS:13 = "", ARGS:14 = "", ARGS:15 = "", ARGS:16 = "", ARGS:17 = "", ARGS:18 = "", ARGS:19 = "")
#FUNCTIONS
#DIM INDEX
RETURNF ARGS:INDEX

