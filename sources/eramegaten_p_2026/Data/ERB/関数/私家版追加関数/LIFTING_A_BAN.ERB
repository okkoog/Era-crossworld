;-------------------------------------------------
;@LIFTING_A_BAN(解禁キャラ)
;合体解禁処理を統一するために作成
;プレイヤーに解禁されたことに気づいてもらう為でもあります
;そのためFORCEWAITを使っています
;誰でも自由に弄ってください
;-------------------------------------------------
@LIFTING_A_BAN, 解禁キャラ, L_OPT
#DIM 解禁キャラ
#DIMS L_OPT
;まずCSVが存在するか確認
IF !EXISTCSV(解禁キャラ)
	PRINTFORML {해금캐릭터}번의 CSV가 없습니다
	FORCEWAIT
	RETURN 0
ENDIF

;CSVにフラグ,합체조건있음,1が設定されているか確認
IF !CSVCFLAG(解禁キャラ, 1165)
	PRINTFORML {해금캐릭터}번에 CFLAG 합체조건있음은 설정되어 있지 않습니다
	FORCEWAIT
	RETURN 0
ENDIF

;すでに解禁されているかチェック
IF REMOVED_FUSION_LIMIT:解禁キャラ
	DEBUGPRINTFORML {解禁キャラ}番の合体はすでに解禁されています
	RETURN 0
ENDIF

;ここでようやく解禁
REMOVED_FUSION_LIMIT:解禁キャラ = 1
IF L_OPT == "NOMES"
	RETURN 0
ELSEIF L_OPT == "ウィンドウ"
	CALL MESSAGE_WINDOW_D, "", @"%CSVCALLNAME(解禁キャラ)%의 합체가 해금되었습니다。"
ELSE
	DRAWLINE
	PRINTFORML %CSVCALLNAME(解禁キャラ)%의 합체가 해금되었습니다。
	DRAWLINE
	FORCEWAIT
ENDIF
RETURN 0