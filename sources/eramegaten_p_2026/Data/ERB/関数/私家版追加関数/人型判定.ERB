;-------------------------------------------------
;인간/亜人判定関数
;自分用に作ったけど使いたかったらどうぞ
;
;更新履歴
; 001	2024/06/03	mid.k			新規作成
;-------------------------------------------------

@IS_HUMANOID, ARG
#FUNCTION
IF ABL:ARG:종족 == 0
	;인간
	RETURNF 4
ELSEIF MAX(TALENT:ARG:부정형, TALENT:ARG:새, TALENT:ARG:파충류, TALENT:ARG:물고기, TALENT:ARG:짐승, TALENT:ARG:이형) <= 0
	;人型悪魔
	IF MIN(TALENT:ARG:머리, TALENT:ARG:눈, TALENT:ARG:입, TALENT:ARG:팔, TALENT:ARG:발) <= 1
		;五体満足
		IF MAX(TALENT:ARG:갈퀴, TALENT:ARG:갈퀴발) <= 0
			;人型
			RETURNF 3
		ELSE
			;準人型
			RETURNF 2
		ENDIF
	ELSE
		;五体不満足
		RETURNF 1
	ENDIF
ELSE
	;それ以外
	RETURNF 0
ENDIF
