@SKILLGAGE_H_CALCULATION,ARG,ARG:1,ARG:2,ARGS = "+"
#LOCALSIZE 1
;ARG	キャラ番号
;ARG:1	スキル番号
;ARG:2	演算数
;ARGS	演算方法(=,+,-,*,/ デフォルトで+)
LOCAL = SKILLGAGE_NUM(ARG,ARG:1)
SIF LOCAL == 0
	THROW 소지하고 있지 않은 스킬의 게이지가 조작되려 했습니다! [캐릭터:%CALLNAME:ARG%] [스킬:{ARG:1}]
SELECTCASE ARGS
	CASE "="
		CFLAG:ARG:("스킬게이지H"+TOSTR(LOCAL)) = ARG:2
	CASE "+"
		CFLAG:ARG:("스킬게이지H"+TOSTR(LOCAL)) += ARG:2
	CASE "-"
		CFLAG:ARG:("스킬게이지H"+TOSTR(LOCAL)) -= ARG:2
	CASE "*"
		CFLAG:ARG:("스킬게이지H"+TOSTR(LOCAL)) *= ARG:2
	CASE "/"
		CFLAG:ARG:("스킬게이지H"+TOSTR(LOCAL)) /= ARG:2
	CASE "%"
		CFLAG:ARG:("스킬게이지H"+TOSTR(LOCAL)) %= ARG:2
ENDSELECT
RETURN RESULT

