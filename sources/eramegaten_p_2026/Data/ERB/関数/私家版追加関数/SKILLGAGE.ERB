;---- EDIT 004 ADD START -------------------------
;スキルゲージの定義数
@SG_NUM
#FUNCTION
RETURNF 50
;---- EDIT 004 ADD END ---------------------------

@SKILLGAGE_NUM,ARG,ARG:1
#FUNCTION
#LOCALSIZE 1
;ARG	キャラ番号
;ARG:1	スキル番号
LOCAL = HAVE_SKILL(ARG,ARG:1,1)
SIF LOCAL == 0
	RETURNF LOCAL
SIF LOCAL > 20
	LOCAL += 9
IF LOCAL < 13
	IF TALENT:ARG:페르소나구사자
		IF EQUIP:ARG:장비페르소나 == EQUIP:ARG:소지페르소나2
			LOCAL += 8
		ELSEIF EQUIP:ARG:장비페르소나 == EQUIP:ARG:소지페르소나3
			LOCAL += 16
		ENDIF
	ELSEIF CFLAG:ARG:악마변신 == 1
		LOCAL += 12
	ENDIF
ENDIF
RETURNF LOCAL

