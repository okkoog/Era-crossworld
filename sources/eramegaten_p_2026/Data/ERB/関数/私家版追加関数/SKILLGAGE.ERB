;-------- MOD 002 START ADD -------------------------------
@SKILLGAGE_SWAP,ARG,ARG:1,ARG:2
#LOCALSIZE 2
;ARG	スキルゲージ変える人
;ARG:1	スキゲ入替スキル1
;ARG:2	スキゲ入替スキル2
LOCAL = SKILLGAGE_NUM(ARG,ARG:1)
LOCAL:1 = SKILLGAGE_NUM(ARG,ARG:2)

CALL SKILLGAGE_DIRECT_SWAP,ARG,LOCAL,LOCAL:1

@SKILLGAGE_DIRECT_SWAP,ARG,ARG:1,ARG:2
;ARG	スキルゲージ変える人
;ARG:1	スキゲ入替場所1
;ARG:2	スキゲ入替場所2

SWAP CFLAG:ARG:("스킬게이지H"+TOSTR(ARG:1)),CFLAG:ARG:("스킬게이지H"+TOSTR(ARG:2))
SWAP CFLAG:ARG:("스킬게이지D"+TOSTR(ARG:1)),CFLAG:ARG:("스킬게이지D"+TOSTR(ARG:2))
SWAP CFLAG:ARG:("스킬게이지F"+TOSTR(ARG:1)),CFLAG:ARG:("스킬게이지F"+TOSTR(ARG:2))

@SKILLGAGE_CLEAR,ARG,ARG:1
#LOCALSIZE 1
;ARG	スキルゲージ変える人
;ARG:1	スキゲクリアスキル
LOCAL = SKILLGAGE_NUM(ARG,ARG:1)

CALL SKILLGAGE_DIRECT_CLEAR,ARG,LOCAL

@SKILLGAGE_DIRECT_CLEAR,ARG,ARG:1
;ARG	スキルゲージ変える人
;ARG:1	スキゲクリア場所

CFLAG:ARG:("스킬게이지H"+TOSTR(ARG:1)) = 0
CFLAG:ARG:("스킬게이지D"+TOSTR(ARG:1)) = 0
CFLAG:ARG:("스킬게이지F"+TOSTR(ARG:1)) = 0

;-------- MOD 002 END ADD -------------------------------
;---- EDIT 004 ADD START -------------------------
@SKILLGAGE_ALL_CLEAR,ARG,ARG:1 = 0
#DIM DYNAMIC L_COUNT
;ARG	スキルゲージ全クリアする人
;ARG:1	リセット方法　0=全部　1=Fを除く
VARSET CFLAG:ARG:0, 0, GETNUM(CFLAG, ("스킬게이지H1")), GETNUM(CFLAG, ("스킬게이지H1")) + SG_NUM()
VARSET CFLAG:ARG:0, 0, GETNUM(CFLAG, ("스킬게이지D1")), GETNUM(CFLAG, ("스킬게이지D1")) + SG_NUM()
SIF ARG:1 == 0
	VARSET CFLAG:ARG:0, 0, GETNUM(CFLAG, ("스킬게이지F1")), GETNUM(CFLAG, ("스킬게이지F1")) + SG_NUM()

@SKILLGAGE_D_ALL_DRIFTING,ARG
#DIM L_COUNT
;ARG	スキルゲージDを増減する人
FOR L_COUNT, GETNUM(CFLAG, "스킬게이지D1"), GETNUM(CFLAG, "스킬게이지D1") + SG_NUM()
	SIF CFLAG:ARG:L_COUNT > 0
		CFLAG:ARG:L_COUNT --
	SIF CFLAG:ARG:L_COUNT < 0
		CFLAG:ARG:L_COUNT ++
NEXT
;---- EDIT 004 ADD END ---------------------------

