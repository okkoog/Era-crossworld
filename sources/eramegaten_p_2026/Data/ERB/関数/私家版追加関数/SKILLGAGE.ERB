;-------- MOD 003 START ADD -------------------------------
@SKILLGAGE_CHARGE, L_CHARA, L_ACTOR
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_ACTOR
#DIMS DYNAMIC TEMP_SKILL
;#LOCALSIZE 2
;#LOCALSSIZE 1
;ARG	スキルゲージ溜める人
;ARG:1	現在の行動者
FOR LCOUNT, 0, TRYSKILLNUM(L_CHARA)
	;控えキャラが指定された場合は控えで使えるスキルかどうかを確認する
	TEMP_SKILL '= GET_TRYSKILL(L_CHARA, LCOUNT)
	IF !CPOS(L_CHARA)
		TRYCCALLFORM SKILLGAGE_CHARGE_USEABLE_RESERVE_%TEMP_SKILL%, L_CHARA
			SIF !RESULT
				CONTINUE
		CATCH
			CONTINUE
		ENDCATCH
	ENDIF
	RESULT = 0
	RESULT:1 = 0
	VARSET RESULTS, "", 0, 3
	TRYCCALLFORM SKILLGAGE_CHARGE_%TEMP_SKILL%, L_CHARA, L_ACTOR
		IF RESULT
			SIF TSTR:게이지메시지 != ""
				TSTR:게이지메시지 += ","
			IF STRFIND(RESULTS, "</font>") >= 0 || STRFIND(RESULTS, "</button>") >= 0
				TSTR:게이지메시지 += @"{L_CHARA}_:%RESULTS%_{RESULT:1}"
			ELSEIF RESULTS:2 == ""
				TSTR:게이지메시지 += @"{L_CHARA}_:"
				SIF RESULT > 0
					TSTR:게이지메시지 += "+"
				TSTR:게이지메시지 += @"%TOSTR(RESULT),5%%RESULTS:1%　<<%RESULTS%>>_{RESULT:1}"
			ELSE
				TSTR:게이지메시지 += @"{L_CHARA}_: %RESULTS:2%_{RESULT:1}"
			ENDIF
			TFLAG:게이지획득자이름 = MAX(STRLENS(CALLNAME:L_CHARA), TFLAG:게이지획득자이름)
		ENDIF
	CATCH
		CONTINUE
	ENDCATCH
NEXT

