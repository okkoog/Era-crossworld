;================================================================
;魔晶装備
;================================================================
@MAKE_MASHO
#DIM LCOUNT
FLAG:합체소재악마1 = -1
;LOCAL ループ用
;LOCAL:1 素材の登録番号
LOCAL:1 = -1
;LOCAL:2 悪魔の表示用変数
;LOCAL:3 合体結果の剣枠
;LOCAL:4 作成する魔晶装備の種類
;G 合体剣のフラグを管理する変数 20-25:バッドステータス村正用

$START_MAKE
LOCAL:6 = 0

;キャラリストを表示・選択
;CALL INPUT_CHARA_LIST("素体にする悪魔を選んでください","CASTING_MASHO")
{
CALL INPUT_CHARA_LIST
	, "PROPSET_FUSION"
	, "素体にする悪魔を選んでください"
	, "CASTING_MASHO" 
	, "SHOW_ADD_UP_FUNCTION"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
SIF RESULT == 1000
	RETURN 0
LOCAL:1 = RESULT


LOCAL:3 = -1
;空いている合体剣枠を参照
FOR LOCAL,0,50
	IF DC:LOCAL:49 == 0
		LOCAL:3 = LOCAL
		BREAK
	ENDIF
NEXT
IF LOCAL:3 == -1
	PRINTW 더 이상 합체검을 소지할 수 없습니다
	RETURN 0
ENDIF

;合体剣の種類を決める
;習得スキルによってGを設定
VARSET G,-1
G:0 = 1
FOR LOCAL,1,FLAG:스킬수+1
	LOCALS = 스킬{LOCAL}
	IF ABL:(LOCAL:1):LOCALS > 0
		RESULT = 0
		;相性による条件
		CALL GET_SKILL_PROP, "SKILL_TYPE", ABL:(LOCAL:1):LOCALS, LOCAL:1
		SIF RESULT < 0
			CONTINUE
		G:RESULT = 1
	ENDIF
NEXT
;剣撃以外の物理は無し
G:1 = -1
G:2 = -1
G:3 = -1


;神経・精神は特殊
G:8 = -1
G:9 = -1
FOR LOCAL,1,FLAG:스킬수+1
	LOCALS = 스킬{LOCAL}
	IF ABL:(LOCAL:1):LOCALS > 0
		RESULT = 0
		;相性による条件
		CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_STATE", ABL:(LOCAL:1):LOCALS,LOCAL:1
		SELECTCASE GET_STATE(RESULT)
			CASE "POISON"
				G:20 = 1
			CASE "SLEEP"
				G:21 = 1
			CASE "PANIC"
				G:22 = 1
			CASE "HAPPY"
				G:23 = 1
			CASE "BIND"
				G:24 = 1
			CASE "CHARM"
				G:25 = 1
		ENDSELECT
	ENDIF
NEXT

;剣のタイプを選択
$PRINT_TYPE
DRAWLINE
PRINTL 검의 공격상성을 선택해주세요
FOR LOCAL,0,TYPENUM
	SIF G:LOCAL > 0
		PRINTFORM [{LOCAL}] 【%GET_TYPE(LOCAL)%】
	SIF G:LOCAL > 0 && LOCAL == 5
		PRINT & FREEZE ２０％
	SIF G:LOCAL > 0 && LOCAL == 6
		PRINT & SHOCK ２０％
	SIF G:LOCAL > 0
		PRINTL
NEXT
SIF G:20 > 0
	PRINTL [20] 【검격】& POISON ２０％
SIF G:21 > 0
	PRINTL [21] 【검격】& SLEEP ２５％
SIF G:22 > 0
	PRINTL [22] 【검격】& PANIC ２５％
SIF G:23 > 0
	PRINTL [23] 【검격】& HAPPY ３５％
SIF G:24 > 0
	PRINTL [24] 【검격】& BIND ２５％
SIF G:25 > 0
	PRINTL [25] 【검격】& CHARM ２０％

DRAWLINE
PRINTL [100] 취소

$INPUT_TYPE
INPUT

IF RESULT == 100
	RESTART
ELSEIF G:RESULT > 0
	;DCにデータを入力
	;まずは名称と相性、追加効果を決めておく
	SELECTCASE RESULT
		CASE 0
			DC:(LOCAL:3):40 = RESULT
			DC:(LOCAL:3):49 = 1
		CASE 4,16
			DC:(LOCAL:3):40 = RESULT
			DC:(LOCAL:3):49 = 2
		CASE 5
			DC:(LOCAL:3):40 = RESULT
			DC:(LOCAL:3):49 = 3
			DC:(LOCAL:3):45 = GET_STATE_NUM("FREEZE")
			DC:(LOCAL:3):46 = 5
			DC:(LOCAL:3):47 = 20
			DC:(LOCAL:3):48 = 95
		CASE 6
			DC:(LOCAL:3):40 = RESULT
			DC:(LOCAL:3):49 = 4
			DC:(LOCAL:3):45 = GET_STATE_NUM("SHOCK")
			DC:(LOCAL:3):46 = 6
			DC:(LOCAL:3):47 = 20
			DC:(LOCAL:3):48 = 95
		CASE 7
			DC:(LOCAL:3):40 = RESULT
			DC:(LOCAL:3):49 = 5
		CASE 10,11
			DC:(LOCAL:3):40 = RESULT
			DC:(LOCAL:3):49 = RESULT
		CASE 12 TO 15
			DC:(LOCAL:3):40 = RESULT
			DC:(LOCAL:3):49 = RESULT - 6
		CASE 20
			DC:(LOCAL:3):40 = 0
			DC:(LOCAL:3):49 = 12
			DC:(LOCAL:3):45 = GET_STATE_NUM("POISON")
			DC:(LOCAL:3):46 = 8
			DC:(LOCAL:3):47 = 20
			DC:(LOCAL:3):48 = 95
		CASE 21
			DC:(LOCAL:3):40 = 0
			DC:(LOCAL:3):49 = 13
			DC:(LOCAL:3):45 = GET_STATE_NUM("SLEEP")
			DC:(LOCAL:3):46 = 9
			DC:(LOCAL:3):47 = 25
			DC:(LOCAL:3):48 = 95
		CASE 22
			DC:(LOCAL:3):40 = 0
			DC:(LOCAL:3):49 = 14
			DC:(LOCAL:3):45 = GET_STATE_NUM("PANIC")
			DC:(LOCAL:3):46 = 9
			DC:(LOCAL:3):47 = 25
			DC:(LOCAL:3):48 = 95
		CASE 23
			DC:(LOCAL:3):40 = 0
			DC:(LOCAL:3):49 = 15
			DC:(LOCAL:3):45 = GET_STATE_NUM("HAPPY")
			DC:(LOCAL:3):46 = 9
			DC:(LOCAL:3):47 = 35
			DC:(LOCAL:3):48 = 95
		CASE 24
			DC:(LOCAL:3):40 = 0
			DC:(LOCAL:3):49 = 16
			DC:(LOCAL:3):45 = GET_STATE_NUM("BIND")
			DC:(LOCAL:3):46 = 8
			DC:(LOCAL:3):47 = 25
			DC:(LOCAL:3):48 = 95
		CASE 25
			DC:(LOCAL:3):40 = 0
			DC:(LOCAL:3):49 = 17
			DC:(LOCAL:3):45 = GET_STATE_NUM("CHARM")
			DC:(LOCAL:3):46 = 9
			DC:(LOCAL:3):47 = 20
			DC:(LOCAL:3):48 = 95
		CASE 17
			DC:(LOCAL:3):40 = RESULT
			DC:(LOCAL:3):49 = 18
	ENDSELECT

	;攻撃回数を選択
	;単体攻撃＆速さ30以上で２回攻撃、50以上で３回攻撃を選択可
	;範囲が単体でない、または速さが30未満の場合は選択肢が出ない

	IF BASE:(LOCAL:1):속도 >= 30 && ABL:(LOCAL:1):공격범위 == 1
		;攻撃回数によってGを設定
		VARSET G,-1

		$PRINT_ATKTIMES
		DRAWLINE
		PRINTL 검의 공격 횟수를 선택해주세요
		IF BASE:(LOCAL:1):속도 >= 50
			PRINTL [1] 1회 공격
			G:1 = 1
			PRINTL [2] 2회 공격 (공격 90% 명중 70%)
			G:2 = 1
			PRINTL [3] 3회 공격 (공격 80% 명중 50%)
			G:3 = 1
		ELSE
			PRINTL [1] 1회 공격
			G:1 = 1
			PRINTL [2] 2회 공격 (공격 90% 명중 70%)
			G:2 = 1
		ENDIF
		DRAWLINE
		PRINTL [100] 취소

		$INPUT_ATKTIMES
		INPUT
	
		IF RESULT == 100
			RESTART
		ELSEIF G:RESULT > 0
			;DCに攻撃回数を入力。マイナス補正はあとで行う
			SELECTCASE RESULT
				CASE 1
					DC:(LOCAL:3):41 = 1
					DC:(LOCAL:3):42 = 1
				CASE 2
					DC:(LOCAL:3):41 = 2
					DC:(LOCAL:3):42 = 2
				CASE 3
					DC:(LOCAL:3):41 = 3
					DC:(LOCAL:3):42 = 3
			ENDSELECT
		ELSE
			CLEARLINE 1
			GOTO INPUT_ATKTIMES
		ENDIF
	ELSE
		DC:(LOCAL:3):41 = 1
		DC:(LOCAL:3):42 = 1
	ENDIF


	;基本能力値修正、戦闘能力値修正を決定
	;基本
	DC:(LOCAL:3):0 += (MIN(ABL:(LOCAL:1):순종 , 10) + MIN(ABL:(LOCAL:1):욕망 , 10) + MIN(ABL:(LOCAL:1):기교 , 10) +3)/6 *(BASE:(LOCAL:1):LV+20)/20
	DC:(LOCAL:3):1 += (MIN(ABL:(LOCAL:1):욕망 , 10)+1)/2 *(BASE:(LOCAL:1):LV+40)/40
	DC:(LOCAL:3):3 += (MIN(ABL:(LOCAL:1):욕망 , 10)+1)/2 *(BASE:(LOCAL:1):LV+40)/40
	DC:(LOCAL:3):6 += (MIN(ABL:(LOCAL:1):순종 , 10)+1)/2 *(BASE:(LOCAL:1):LV+40)/40
	DC:(LOCAL:3):4 += (MIN(ABL:(LOCAL:1):순종 , 10)+1)/2 *(BASE:(LOCAL:1):LV+40)/40
	DC:(LOCAL:3):2 += (MIN(ABL:(LOCAL:1):기교 , 10)+1)/2 *(BASE:(LOCAL:1):LV+40)/40
	DC:(LOCAL:3):5 += (MIN(ABL:(LOCAL:1):기교 , 10)+1)/2 *(BASE:(LOCAL:1):LV+40)/40
	;旧仕様：レベルによる調教効果補正
;	DC:(LOCAL:3):0 *= (BASE:(LOCAL:1):LV+20)/20
;	DC:(LOCAL:3):1 *= (BASE:(LOCAL:1):LV+40)/40
;	DC:(LOCAL:3):2 *= (BASE:(LOCAL:1):LV+40)/40
;	DC:(LOCAL:3):3 *= (BASE:(LOCAL:1):LV+40)/40
;	DC:(LOCAL:3):4 *= (BASE:(LOCAL:1):LV+40)/40
;	DC:(LOCAL:3):5 *= (BASE:(LOCAL:1):LV+40)/40
;	DC:(LOCAL:3):6 *= (BASE:(LOCAL:1):LV+40)/40

	;戦闘
	;旧仕様
	;DC:(LOCAL:3):10 = (MIN(BASE:(LOCAL:1):LV,80)+5+DC:(LOCAL:3):0*2)*3/2 + BASE:(LOCAL:1):힘*3/2 + BASE:(LOCAL:1):내구 / 2
	;DC:(LOCAL:3):11 = (MIN(BASE:(LOCAL:1):LV,80)+5+DC:(LOCAL:3):0*2) + BASE:(LOCAL:1):속도*3/2 + BASE:(LOCAL:1):운/2
	;DC:(LOCAL:3):14 = (MIN(BASE:(LOCAL:1):LV,80)+5+DC:(LOCAL:3):0*2)*3/2 + BASE:(LOCAL:1):마력*3/2 + BASE:(LOCAL:1):지혜 / 2
	;DC:(LOCAL:3):15 = (MIN(BASE:(LOCAL:1):LV,80)+5+DC:(LOCAL:3):0*2) + BASE:(LOCAL:1):지혜 + BASE:(LOCAL:1):운/2 + BASE:(LOCAL:1):마력/2
	;剣仕様に変更
	;TIMES DC:(LOCAL:3):10 , 1.00
	;DC:(LOCAL:3):11 += 10
	;TIMES DC:(LOCAL:3):14 , 0.80
	;TIMES DC:(LOCAL:3):15 , 0.40
	;旧仕様ここまで

	;武器性能見直し（基本性能底上げ＋調教依存度低下＋各パラメータの重みを均一化）
	;悪魔のレベル依存
	A:5 = 80;レベル最大値
	A = (MIN(BASE:(LOCAL:1):LV,A:5)+30)*3/2
	A:1 = A
	A:2 = A*2/3
	A:3 = A
	A:4 = A/3
	;悪魔の能力依存
	B:1 = (BASE:(LOCAL:1):힘*3/2 + BASE:(LOCAL:1):내구/2)*5/3
	B:2 = (BASE:(LOCAL:1):속도*3/2 + BASE:(LOCAL:1):운/2)*5/3
	B:3 = (BASE:(LOCAL:1):마력*3/2 + BASE:(LOCAL:1):지혜/2)*5/3
	B:4 = (BASE:(LOCAL:1):내구 + BASE:(LOCAL:1):운 + BASE:(LOCAL:1):지혜)*2/3
	;合算
	DC:(LOCAL:3):10 = A:1 + B:1
	DC:(LOCAL:3):11 = A:2 + B:2
	DC:(LOCAL:3):14 = A:3 + B:3
	DC:(LOCAL:3):15 = A:4 + B:4
	;非火力型武器が弱くなりすぎないよう、火力が低いとき性能を上げる補正
	D = A - (B:1 + B:3 + MAX(B:1,B:3)*2)/3
	IF D > 0
		D:1 = D/4
		D:2 = D/4
		D:3 = D/4
		D:4 = D/2
		DC:(LOCAL:3):10 += D:1
		DC:(LOCAL:3):11 += D:2
		DC:(LOCAL:3):14 += D:3
		DC:(LOCAL:3):15 += D:4
	ELSE
		D:1 = 0
		D:2 = 0
		D:3 = 0
		D:4 = 0
	ENDIF
	;忠誠度による加算
	S:5 = 30;最大値
	S = MIN(GET_CHARA_LOYALTY((LOCAL:1))/500,S:5)
	DC:(LOCAL:3):10 += S
	DC:(LOCAL:3):11 += S
	DC:(LOCAL:3):14 += S
	DC:(LOCAL:3):15 += S
	;攻撃形態は素材のものをコピー
;	DC:(LOCAL:3):41 = ABL:(LOCAL:1):최저공격횟수
;	DC:(LOCAL:3):41 = 1
;	DC:(LOCAL:3):42 = ABL:(LOCAL:1):최대공격횟수
;	DC:(LOCAL:3):42 = 1
	DC:(LOCAL:3):43 = ABL:(LOCAL:1):사거리
	DC:(LOCAL:3):44 = ABL:(LOCAL:1):공격범위

	;攻撃回数によって攻撃と命中に修正が入る
	SELECTCASE DC:(LOCAL:3):41
		CASE 2
			TIMES DC:(LOCAL:3):10 , 0.90
			TIMES DC:(LOCAL:3):11 , 0.70
		CASE 3
			TIMES DC:(LOCAL:3):10 , 0.80
			TIMES DC:(LOCAL:3):11 , 0.50
	ENDSELECT

	;;射程・攻撃範囲によって命中と攻撃に修正が入る
	;SELECTCASE DC:(LOCAL:3):43
	;	CASE 2
	;		TIMES DC:(LOCAL:3):11 , 0.8
	;	CASE 3
	;		TIMES DC:(LOCAL:3):11 , 0.6
	;ENDSELECT
	;単体は素材悪魔の陥落状態によって最大攻撃回数が増加
	;攻撃が列は90%、全体は60%
	SELECTCASE DC:(LOCAL:3):44
		CASE 1
			IF TALENT:(LOCAL:1):3 || TALENT:(LOCAL:1):4 || TALENT:(LOCAL:1):5 || TALENT:(LOCAL:1):180
				DC:(LOCAL:3):42 += 1
			ELSEIF TALENT:(LOCAL:1):6 || TALENT:(LOCAL:1):7 || TALENT:(LOCAL:1):8 || TALENT:(LOCAL:1):181
				DC:(LOCAL:3):42 += 2
			ELSE
			ENDIF
		CASE 2
			TIMES DC:(LOCAL:3):10 , 0.9
	;		TIMES DC:(LOCAL:3):10 , 0.7
	;		TIMES DC:(LOCAL:3):11 , 0.8
		CASE 3
			TIMES DC:(LOCAL:3):10 , 0.6
	;		TIMES DC:(LOCAL:3):10 , 0.4
	;		TIMES DC:(LOCAL:3):11 , 0.5
	ENDSELECT
	
	DC:(LOCAL:3):39 = GET_EQUIPNUM("검")
	
	;追加効果付きの剣は修正を加える
	SELECTCASE DC:(LOCAL:3):49
		CASE 3,4
			TIMES DC:(LOCAL:3):10 , 0.95
			TIMES DC:(LOCAL:3):11 , 0.95
		CASE 12 TO 17
			TIMES DC:(LOCAL:3):10 , 0.90
			TIMES DC:(LOCAL:3):11 , 0.90
	ENDSELECT
	;防御相性
	FOR LOCAL,0,TYPENUM
		DC:(LOCAL:3):(20+LOCAL) = 100
	NEXT
	SIF DC:(LOCAL:3):40 == 17
		TIMES DC:(LOCAL:3):10 , 0.75
	
ELSE
	CLEARLINE 1
	GOTO INPUT_TYPE
ENDIF

;合体結果の剣を表示
CALL 装備説明,(2450+LOCAL:3+450*DC:(LOCAL:3):39)
;どうしてこの性能になったかを少しわかりやすく
PRINTFORML 무기 성능 내역
PRINTFORM %"", 18, LEFT%
PRINTFORM %"공격", 10, RIGHT%
PRINTFORM %"명중", 10, RIGHT%
PRINTFORM %"마법위력", 12, RIGHT%
PRINTFORML %"마법효과", 10, RIGHT%

IF BASE:(LOCAL:1):LV >= 80
	PRINTFORM %"악마의 레벨(MAX)", 18, LEFT%
	;最大値なら水色にする
	SETCOLOR 0x66FFFF
ELSE
	PRINTFORM %"악마의 레벨", 18, LEFT%
ENDIF
PRINTFORM %@"{A:1}", 10, RIGHT%
PRINTFORM %@"{A:2}", 10, RIGHT%
PRINTFORM %@"{A:3}", 10, RIGHT%
PRINTFORML %@"{A:4}", 10, RIGHT%
RESETCOLOR

PRINTFORM %"악마의 능력", 18, LEFT%
PRINTFORM %@"{B:1+D:1}", 10, RIGHT%
PRINTFORM %@"{B:2+D:2}", 10, RIGHT%
PRINTFORM %@"{B:3+D:3}", 10, RIGHT%
PRINTFORML %@"{B:4+D:4}", 10, RIGHT%
;디버그용
;PRINTFORM %"バランス補正", 18, LEFT%
;PRINTFORM %@"{D:1}", 10, RIGHT%
;PRINTFORM %@"{D:2}", 10, RIGHT%
;PRINTFORM %@"{D:3}", 10, RIGHT%
;PRINTFORML %@"{D:4}", 10, RIGHT%

IF S == S:5
	PRINTFORM %"악마의 충성도(MAX)", 18, LEFT%
	;最大値なら水色にする
	SETCOLOR 0x66FFFF
ELSE
	PRINTFORM %"악마의 충성도", 18, LEFT%
ENDIF
PRINTFORM %@"{S}", 10, RIGHT%
PRINTFORM %@"{S}", 10, RIGHT%
PRINTFORM %@"{S}", 10, RIGHT%
PRINTFORML %@"{S}", 10, RIGHT%
RESETCOLOR

DRAWLINE
SELECTCASE DC:(LOCAL:3):41
	CASE 2
	PRINTFORM %"攻撃回数補正", 18, LEFT%
	PRINTFORM %@"x0.90", 10, RIGHT%
	PRINTFORML %@"x0.70", 10, RIGHT%
	CASE 3
	PRINTFORM %"攻撃回数補正", 18, LEFT%
	PRINTFORM %@"x0.80", 10, RIGHT%
	PRINTFORML %@"x0.50", 10, RIGHT%
	ENDSELECT

SELECTCASE DC:(LOCAL:3):44
	CASE 2
	PRINTFORM %"攻撃範囲補正", 18, LEFT%
	PRINTFORML %@"x0.90", 10, RIGHT%
	CASE 3
	PRINTFORM %"攻撃範囲補正", 18, LEFT%
	PRINTFORML %@"x0.60", 10, RIGHT%
	ENDSELECT

IF DC:(LOCAL:3):40 == 17
	PRINTFORM %"万能相性補正", 18, LEFT%
	PRINTFORML %@"x0.75", 10, RIGHT%
ENDIF

SELECTCASE DC:(LOCAL:3):49
	CASE 3,4
	PRINTFORM %"追加効果補正", 18, LEFT%
	PRINTFORM %@"x0.95", 10, RIGHT%
	PRINTFORML %@"x0.95", 10, RIGHT%
	CASE 12 TO 17
	PRINTFORM %"追加効果補正", 18, LEFT%
	PRINTFORM %@"x0.90", 10, RIGHT%
	PRINTFORML %@"x0.90", 10, RIGHT%
ENDSELECT

DRAWLINE
PRINTFORM %"結果", 18, LEFT%
PRINTFORM %@"{DC:(LOCAL:3):10}", 10, RIGHT%
PRINTFORM %@"{DC:(LOCAL:3):11}", 10, RIGHT%
PRINTFORM %@"{DC:(LOCAL:3):14}", 10, RIGHT%
PRINTFORML %@"{DC:(LOCAL:3):15}", 10, RIGHT%
DRAWLINE


;合体するかどうか　→　合体実行（実際には既に終わっている）
PRINT 이 검을 제작하시겠습니까?

CALL INPUT_YN,"Yes","No",2

SELECTCASE RESULT
	CASE 0
		ITEM:(2450+LOCAL:3+450*DC:(LOCAL:3):39) = 1
	CASE 1
		FOR LCOUNT, 0, 50
			DC:(LOCAL:3):LCOUNT = 0
		NEXT
		RESTART
ENDSELECT

PRINTFORMW %STR:(DC:(LOCAL:3):49+100)%을(를) 손에 넣었다

CALL FUSION_LETTER,LOCAL:1,1

;合体素材の悪魔を消去
CALL キャラ削除, LOCAL:1

ITEM:무명의도 -= 1

RETURN 0

GOTO START_MAKE


;==========================================================================
;魔晶装備を素材に戻す
;==========================================================================
@DEL_MASHO
PRINTFORML 어느 장비를 소재로 되돌리겠습니까?　＜page.{P + 1}＞
DRAWLINE
;持っているアイテムを表示
VARSET G,-1
FOR LOCAL,2000,VARSIZE("ITEM")
	IF 魔晶装備(LOCAL)
		IF ITEM:LOCAL > 0
			PRINTFORMLC [{LOCAL}]%EQ_GETNAME_魔晶装備(LOCAL-2450-450*((LOCAL-2000)/500))%
			G:LOCAL = 1
		ENDIF
	ELSE
	ENDIF
NEXT
PRINTL

$PRINT_LIST
DRAWLINE
PRINTL [1000] 돌아간다
$INPUT_LOOP_1
INPUT
IF RESULT == 1000
		RETURN 0
ELSEIF RESULT < 0 || RESULT >= VARSIZE("G")
	GOTO INPUT_LOOP_1
ELSEIF G:RESULT != 1
	GOTO INPUT_LOOP_1
ENDIF
LOCAL:2 = RESULT
CALL 装備説明,LOCAL:2

PRINTL 이 장비를 소재로 되돌리겠습니까?
PRINTL [0]Yes [1]No
$INPUT_LOOP2
INPUT
IF RESULT == 1
	RESTART
ELSEIF RESULT != 0
	GOTO INPUT_LOOP2
ENDIF


ITEM:무명의도 += 1

FOR LOCAL,0,99
	DC:(LOCAL:2-2450-450*((LOCAL:2-2000)/500)):LOCAL = 0
NEXT

ITEM:(LOCAL:2) -= 1


;================================================================
;材料にできる悪魔の条件
;================================================================
@CASTING_MASHO(ARG)
SIF ARG == MASTER
	RETURN 0
SIF !GET_ROLE_PROP("CAN_FUSION", ARG)
	RETURN 0
SIF 계약(ARG) > 0
	RETURN 0
SIF ABL:ARG:종족 == 0 || ABL:ARG:종족 > 44
	RETURN 0
SIF IS_RENTING(ARG)
	RETURN 0
SIF CFLAG:ARG:이자리에없는플래그 == 1
	RETURN 0
SIF CFLAG:ARG:합체소재사용금지
	RETURN 0
SIF EQUIP:ARG:검 != 0
	RETURN 0
SIF EQUIP:ARG:총 != 0
	RETURN 0
SIF EQUIP:ARG:머리 != 0
	RETURN 0
SIF EQUIP:ARG:몸통 != 0
	RETURN 0
SIF EQUIP:ARG:팔 != 0
	RETURN 0
SIF EQUIP:ARG:발 != 0
	RETURN 0
RETURN 1
