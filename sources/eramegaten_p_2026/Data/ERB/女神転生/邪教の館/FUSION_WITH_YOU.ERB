;あなた合体用処理を記述したファイルです


@FUSION_WITH_YOU
;MASTER　あなたの登録番号
;LOCAL:2　造魔、素材の登録番号
#DIM 完成品 , 1
#DIM TSフラグ
LOCAL:2 = -1
$START_FUSION

;これ表示する場面も必要もないよね？
;SIF LOCAL:2 > -1
;	PRINTFORML 生贄:%CALLNAME:(LOCAL:2)%

;CALL INPUT_CHARA_LIST("融合する悪魔を選んでください", "CASTING_FUSION_WITH_YOU", "UP_PRINT_FUSION_WITH_YOU")
{
CALL INPUT_CHARA_LIST
	, "FUNC_PROPSET_LIST"
	, "融合する悪魔を選んでください"
	, "CASTING_FUSION_WITH_YOU" 
	, "UP_PRINT_FUSION_WITH_YOU"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
IF RESULT == 1000
	RETURN 0
ENDIF
	TSフラグ = 0
	LOCAL:2 = RESULT
	
	完成品 = CHARANUM
	ADDCOPYCHARA MASTER
	LOCAL:7 = RESULT
	
	;取得する経験値を計算
	LOCAL:4 = CFLAG:(LOCAL:2):초기LV
	LOCAL:3 = BASE:(LOCAL:2):ＥＸＰ - 5*(LOCAL:4-1)*(LOCAL:4+1)*(LOCAL:4)/3
	;香で強化されている場合経験値にボーナス
	LOCAL:3 += MAX(0, BASE:(LOCAL:2):힘 + BASE:(LOCAL:2):지혜 + BASE:(LOCAL:2):마력 + BASE:(LOCAL:2):내구 + BASE:(LOCAL:2):속도 + BASE:(LOCAL:2):운 - 18 - MAXBASE:(LOCAL:2):LV * 3 / 2) * 100
	SIF BASE:MASTER:LV > LOCAL:4
		LOCAL:3 /= (BASE:MASTER:LV - LOCAL:4)/4+1
	SIF BASE:MASTER:LV < LOCAL:4
		LOCAL:3 *= POWER(2, MIN(( LOCAL:4 - BASE:MASTER:LV)/4,4))
	TIMES LOCAL:3 , 0.70
	;取得するＭＡＧを記録
	LOCAL:4 = GET_CHARA_STOCK_MAG(LOCAL:2)
	;素質の引継ぎチェック
	IF TALENT:(LOCAL:2):폭유 == 1
		TALENT:完成品:폭유 = 1
		TALENT:完成品:거유 = 0
		TALENT:完成品:빈유 = 0
		TALENT:完成品:절벽 = 0
	ELSEIF TALENT:(LOCAL:2):거유 == 1
		TALENT:完成品:폭유 = 0
		TALENT:完成品:거유 = 1
		TALENT:完成品:빈유 = 0
		TALENT:完成品:절벽 = 0
	ELSEIF TALENT:(LOCAL:2):빈유 == 1
		TALENT:完成品:폭유 = 0
		TALENT:完成品:거유 = 0
		TALENT:完成品:빈유 = 1
		TALENT:完成品:절벽 = 0
	ELSEIF TALENT:(LOCAL:2):절벽 == 1
		TALENT:完成品:폭유 = 0
		TALENT:完成品:거유 = 0
		TALENT:完成品:빈유 = 0
		TALENT:完成品:절벽 = 1
	ELSE
		TALENT:完成品:폭유 = 0
		TALENT:完成品:거유 = 0
		TALENT:完成品:빈유 = 0
		TALENT:完成品:절벽 = 0
	ENDIF
	IF (TALENT:完成品:남자 == 1 && TALENT:(LOCAL:2):남자 == 0) || (TALENT:完成品:남자 == 0 && TALENT:(LOCAL:2):남자 == 1) || TALENT:(LOCAL:2):후타나리 == 1
		TALENT:完成品:후타나리 = 1
		TALENT:完成品:오토코노코 = 0
		IF TALENT:完成品:남자 == 1 && TALENT:(LOCAL:2):남자 == 0
			TSフラグ = 1
			TALENT:完成品:남자 = 0
		ENDIF
	ENDIF
	SIF TALENT:(LOCAL:2):동물귀 == 1
		TALENT:完成品:동물귀 = 1
	SIF TALENT:(LOCAL:2):갈퀴 == 1
		TALENT:完成品:갈퀴 = 1
	SIF TALENT:(LOCAL:2):날개 == 1
		TALENT:完成品:날개 = 1
	SIF TALENT:(LOCAL:2):꼬리 == 1
		TALENT:完成品:꼬리 = 1
	SIF TALENT:(LOCAL:2):갈퀴발 == 1
		TALENT:完成品:갈퀴발 = 1
	IF TALENT:(LOCAL:2):물고기 == 1
		TALENT:完成品:물고기 = 1
		TALENT:完成品:꼬리 = 1
		TALENT:完成品:발 = 0
		;人魚になります…多分
	ENDIF
	SIF TALENT:(LOCAL:2):기계의처녀 == 1 || ABL:(LOCAL:2):종족 == 12
		TALENT:完成品:기계의처녀 = 1
		;実質クリス・ザ・カーとの合体時専用？一応種族:マシンとの合体時にも機械の乙女に変化するように設計したつもり…
	SIF TALENT:(LOCAL:2):부정형 == 1
		TALENT:完成品:부정형 = 1
	CALL SUCCESS_TALENT, 完成品, 完成品, LOCAL:2, LOCAL:10
	IF TSフラグ
		TALENT:完成品:처녀 = !EXP:(LOCAL:1):ＴＳ경험 || CFLAG:(LOCAL:1):원처녀
		ABL:完成品:Ｖ감각 = EXP:(LOCAL:1):ＴＳ경험 ? CFLAG:(LOCAL:1):원Ｖ감각 # 0
		CALL ADDS_ABNORMAL_EXP , "ＴＳ" , 完成品
		CALL SHOW_ABNORMAL_EXP , 完成品, 0
		EXP:完成品:ＴＳ경험 += 1
	ENDIF
	CUSTOMDRAWLINE =
	PRINTFORML %CALLNAME:MASTER% LV{MAXBASE:MASTER:LV}({BASE:MASTER:LV})
	PRINTFORML 　　　　ＥＸＰ:＋{MAX(LOCAL:3,0)}　　ＭＡＧ：＋{LOCAL:4}
	CUSTOMDRAWLINE =
	;合体結果のステータスを表示
	U = 完成品
	PRINTFORML %STR:(ABL:U:80)%　　%CALLNAME:U%　　
	CALL SHOW_INFO_PAGE_1
	CUSTOMDRAWLINE =
	
	
	;合体するかどうか　→　合体実行
	PRINTL 이상의 결과로 진행하시겠습니까?
	CALL INPUT_YN, "Yes", "No", 2

	IF RESULT == 1
		DELCHARA 完成品
		RESTART
	ENDIF
	
	DELCHARA 完成品
	
	
	;素質の引継ぎ
	CALL SUCCESS_TALENT, MASTER, MASTER, LOCAL:2, LOCAL:10
	
	;経験値加算
	BASE:MASTER:ＥＸＰ += LOCAL:3
	CALL CHECK_LEVEL_UP, MASTER
	;ＭＡＧ加算
	CALL CONTROL_MAG, MASTER, LOCAL:4
	
	;手紙システム
	CALL FUSION_LETTER_WITH_YOU, LOCAL:2
	
	SIF TSフラグ
		CALL ＴＳ処理,LOCAL:1
	
	IF TALENT:(LOCAL:2):폭유 == 1
		TALENT:MASTER:폭유 = 1
		TALENT:MASTER:거유 = 0
		TALENT:MASTER:빈유 = 0
		TALENT:MASTER:절벽 = 0
	ELSEIF TALENT:(LOCAL:2):거유 == 1
		TALENT:MASTER:폭유 = 0
		TALENT:MASTER:거유 = 1
		TALENT:MASTER:빈유 = 0
		TALENT:MASTER:절벽 = 0
	ELSEIF TALENT:(LOCAL:2):빈유 == 1
		TALENT:MASTER:폭유 = 0
		TALENT:MASTER:거유 = 0
		TALENT:MASTER:빈유 = 1
		TALENT:MASTER:절벽 = 0
	ELSEIF TALENT:(LOCAL:2):절벽 == 1
		TALENT:MASTER:폭유 = 0
		TALENT:MASTER:거유 = 0
		TALENT:MASTER:빈유 = 0
		TALENT:MASTER:절벽 = 1
	ELSE
		TALENT:MASTER:폭유 = 0
		TALENT:MASTER:거유 = 0
		TALENT:MASTER:빈유 = 0
		TALENT:MASTER:절벽 = 0
	ENDIF
	IF TSフラグ || (TALENT:(LOCAL:1):남자 == 0 && TALENT:(LOCAL:2):남자 == 1) || (TALENT:(LOCAL:1):후타나리 == 0 &&TALENT:(LOCAL:2):후타나리 == 1)
		PRINTFORML
		PRINTFORML %CALLNAME:MASTER%은(는) 후타나리가 되었다…
		IF TSフラグ
			PRINTFORM %CALLNAME:MASTER%은(는) 다시 태어난 몸으로
			IF EXP:MASTER:Ｖ경험 > 0
				PRINTFORM 오랜만의
			ELSE
				PRINTFORM 생애 첫
			ENDIF
			PRINTFORML 「여성」으로서의 쾌락을 마음껏 맛보았다…
			IF TALENT:MASTER:폭유 == 1 || TALENT:MASTER:거유 == 1
				PRINTFORML 하지만 이 몸, %CALLNAME:(LOCAL:2)%을(를) 닮아 가슴이 크다. 여성용 속옷이 필요하겠지.
				IF TALENT:MASTER:108 ;B敏感
					PRINTFORML 게다가 이 크기임에도 민감해서, 스치기만 해도 몸에 전류가 흐르는 것 같다.
				ENDIF
				IF TALENT:MASTER:폭유
					PRINTFORML 그건 그렇고 어깨가 무겁다. %CALLNAME:(LOCAL:2)%은(는) 평소 이런 걸 매달고 다녔던 건가.
				ENDIF
			ELSEIF TALENT:MASTER:빈유 == 1 || TALENT:MASTER:절벽 == 1
				IF TALENT:MASTER:108 ;B敏感
					PRINTFORML 가슴은 %CALLNAME:(LOCAL:2)%을(를) 닮아 작지만, 꽤나 민감하다. 속옷은 가능한 한 빨리 마련해야겠어…
				ELSE
					PRINTFORML 다행이라고 해야 할지, %CALLNAME:(LOCAL:2)%을(를) 닮아 가슴은 작다. 속옷 등은 나중으로 미뤄도 괜찮겠지.
				ENDIF
			ELSE
				PRINTFORM 다만, 이 몸은 그럭저럭 가슴이 있다.
				IF TALENT:MASTER:108 ;B敏感
					PRINTFORML 게다가 너무 민감해서, 옷이 스치기만 해도 무심코 몸이 젖혀져 버린다.
				ENDIF
				PRINTFORML 여성용 속옷을 준비하는 편이 좋을지도 모르겠다.
			ENDIF
		ELSE
			PRINTFORM %CALLNAME:MASTER%은(는) %CALLNAME:(LOCAL:2)%와(과) 하나가 된 몸으로
			IF EXP:MASTER:사정경험 > 0
				PRINTFORM 오랜만의
			ELSE
				PRINTFORM 생애 첫
				EXP:MASTER:사정경험 += 10
			ENDIF
			PRINTFORML 사정감을 숨이 턱에 찰 때까지 맛보았다…
			IF TALENT:MASTER:102 ;C敏感、全角半角の自信がないため数値入力
				IF EXP:MASTER:사정경험 > 0
					PRINTFORML 하지만 아무래도 이전보다 페니스의 기분이 훨씬 좋은 것 같다.
					PRINTFORML 악마에게서 얻은 부위이기 때문인지, 더욱 민감해진 것일까.
				ELSE
					PRINTFORML 하지만 페니스라는 것이 이 정도로 민감할 줄은 생각지도 못했다.
				ENDIF
				PRINTFORML 이건 여성용 속옷으로는 너무 조일 것 같다.
				PRINTFORML 이제 팬티는 입지 못할지도 모르겠다.
			ELSEIF TALENT:MASTER:크고아름다움
				PRINTFORML 하지만 %CALLNAME:(LOCAL:2)%의 페니스가 이렇게까지 컸던가.
				PRINTFORML 어쩐지 유난히 더 커진 것 같은 기분이 드는데…
				PRINTFORML 이건 이제 팬티는 못 입겠지. 아니, 바지도 위험하다.
			ELSE
				PRINTFORML 다만 이런 것이 달려 있어서야 이제 팬티는 입지 못할 것이다.
			ENDIF
		ENDIF
		PRINTFORM %CALLNAME:MASTER%은(는) 새로운 몸에서 뿜어져 나온
		SIF TALENT:MASTER:모유체질
			PRINTFORM 모유와
		SIF TALENT:MASTER:104
			PRINTFORM 애액과
		PRINTFORMW 정액으로 백탁된 방에서, 숨을 헐떡이며 그런 생각을 했다…
		TALENT:MASTER:후타나리 = 1
		TALENT:MASTER:오토코노코 = 0
		TALENT:MASTER:남자 = 0
		IF TSフラグ
			CFLAG:(LOCAL:1):현가슴사이즈 = BUST(LOCAL:1)
			CALL ADDS_ABNORMAL_EXP , "ＴＳ" , LOCAL:1
			CALL SHOW_ABNORMAL_EXP , LOCAL:1

			PRINTL ＴＳ경험 + 1
			EXP:(LOCAL:1):ＴＳ경험 += 1
		ENDIF
	ENDIF
	
	IF TALENT:(LOCAL:2):동물귀 == 1 && TALENT:MASTER:동물귀 == 0
		PRINTFORML
		TALENT:MASTER:동물귀 = 1
		PRINTFORM %CALLNAME:MASTER%의 귀는
		IF TALENT:(LOCAL:2):여우 == 1
			PRINTFORM %CALLNAME:(LOCAL:2)%을(를) 닮은 여우 같은
		ELSEIF CSTR:(LOCAL:2):상성그룹 == "猫"
			PRINTFORM %CALLNAME:(LOCAL:2)%을(를) 닮은 고양이에 가까운
		ELSEIF CSTR:(LOCAL:2):상성그룹 == "犬"
			PRINTFORM %CALLNAME:(LOCAL:2)%을(를) 닮은 개 같은
		ELSE
			PRINTFORM %CALLNAME:(LOCAL:2)%을(를) 쏙 빼닮은 동물의
		ENDIF
		PRINTFORML 형태로 변화했다.
		PRINTFORML 귀가 머리카락에 간지럽혀져 근질거린다… 익숙해질 때까지는 시간이 걸릴지도 모르겠다.
		PRINTFORMW 어쨌든 서둘러 모자라도 사 와야겠어.
	ENDIF
	IF TALENT:(LOCAL:2):갈퀴 == 1 && TALENT:MASTER:갈퀴 == 0
		PRINTFORML
		TALENT:MASTER:갈퀴 = 1
		PRINTFORML %CALLNAME:MASTER%의 손에서 갈고리발톱이 돋아났다.
		PRINTFORML 다행히 넣었다 뺐다 할 수 있는 것 같지만, 당분간은 멋대로 나오지 않도록 길들여야 할 것이다.
		PRINTFORMW 만약 COMP 조작 중에 멋대로 발톱이 튀어나오기라도 한다면, 생각만 해도 끔찍하다.
	ENDIF
	IF TALENT:(LOCAL:2):날개 == 1 && TALENT:MASTER:날개 == 0
		PRINTFORML
		TALENT:MASTER:날개 = 1
		PRINTFORM %CALLNAME:MASTER%의 등에서 %CALLNAME:(LOCAL:2)%
		IF TALENT:(LOCAL:2):천사 == 1
			PRINTFORM 을(를) 닮은 순백의
		ELSEIF TALENT:(LOCAL:2):타천사 == 1
			PRINTFORM 을(를) 닮은 칠흑의
		ELSEIF TALENT:(LOCAL:2):새 == 1
			PRINTFORM 과(와) 같은 새의
		ELSE
			PRINTFORM 의 것과 쏙 빼닮은
		ENDIF
		PRINTFORML 날개가 돋아났다.
		PRINTFORML 몇 번 시험해 보았지만, 아무래도 %CALLNAME:MASTER%이(가) 공중에 뜰 정도의 힘은 있는 모양이다.
		PRINTFORMW 다만 꽤 큰 날개라 숨기기는 어려울 것 같다. 망토라도 걸칠까…?
	ENDIF
	IF TALENT:(LOCAL:2):꼬리 == 1 && TALENT:MASTER:꼬리 == 0 && TALENT:(LOCAL:2):물고기 == 0
		PRINTFORML
		TALENT:MASTER:꼬리 = 1
		PRINTFORM %CALLNAME:MASTER%의 엉덩이골 윗부분에서
		IF TALENT:(LOCAL:2):여우 == 1
			PRINTFORM %CALLNAME:(LOCAL:2)%을(를) 닮은 여우 같은
		ELSEIF CSTR:(LOCAL:2):상성그룹 == "猫"
			PRINTFORM %CALLNAME:(LOCAL:2)%을(를) 닮은 고양이에 가까운
		ELSEIF CSTR:(LOCAL:2):상성그룹 == "犬"
			PRINTFORM %CALLNAME:(LOCAL:2)%을(를) 닮은 개 같은
		ELSEIF TALENT:(LOCAL:2):파충류 == 1
			PRINTFORM %CALLNAME:(LOCAL:2)%을(를) 닮은 도마뱀을 연상시키는
		ELSE
			PRINTFORM %CALLNAME:(LOCAL:2)%을(를) 쏙 빼닮은
		ENDIF
		PRINTFORML 꼬리가 돋아났다.
		PRINTFORML 아무래도 이쪽의 감정에 맞춰 제멋대로 움직여 버리는 모양이다.
		PRINTFORMW 조금 쑥스럽네…
	ENDIF
	IF TALENT:(LOCAL:2):물고기 == 1 && TALENT:MASTER:물고기 == 0
		PRINTFORML
		TALENT:MASTER:물고기 = 1
		TALENT:MASTER:꼬리 = 1
		TALENT:MASTER:발 = 0
		PRINTFORMW 놀랍게도 %CALLNAME:MASTER%의 다리가 물고기 꼬리가 되어 버렸다!
		PRINTFORML 다행히도 악마의 힘 덕분인지, 육상에서는 공중에 뜸으로써 이전과 똑같이 움직일 수 있었다.
		PRINTFORMW 하지만 이건… 앞으로 치마라도 입지 않으면 일상생활도 곤란할지 모르겠다…
	ENDIF
	IF TALENT:(LOCAL:2):갈퀴발 == 1 && TALENT:MASTER:갈퀴발 == 0 && TALENT:MASTER:물고기 == 0
		PRINTFORML
		TALENT:MASTER:갈퀴발 = 1
		PRINTFORM %CALLNAME:MASTER%의 발목 아래가
		IF TALENT:(LOCAL:2):짐승
			PRINTFORML 짐승 같은 형태가 되었다.
			PRINTFORML 육구가 지면을 딛는 감촉이 뭐라 말할 수 없이 기분 좋다…
		ELSE
			PRINTFORML 새 같은 형태가 되었다.
			PRINTFORML 발가락이 발목 뒤에 있다는 감각이 어쩐지 참 신기하다…
		ENDIF
		PRINTFORMW 우선 당분간은 동료마용 신발을 신어두기로 할까.
	ENDIF
	
	IF TALENT:(LOCAL:2):기계의처녀 == 1 || ABL:(LOCAL:2):종족 == 12
		;伽耶ちゃんもゴーレムと合体して機械の乙女になるし、多分マシンと合体したらなるよね…？
		;機械の乙女所持者の都合上女orふたなりだから問題はないはず
		;マシンが仲魔になる機会があるのか、が分からないので無駄になるかも…
		PRINTFORML
		TALENT:MASTER:기계의처녀 = 1
		PRINTFORML %CALLNAME:MASTER%의 신체는 기계화되었다…
		PRINTFORML 언뜻 봐서는 그렇게 보이지 않지만, 몸을 움직이면 미세한 진동이 느껴지고 관절이 구체 관절처럼 되어 있다.
		PRINTFORML 한편 몇 번이고 만져 확인해보았으나, 어째서인지 만져지는 감촉도, 안에서 기기가 움직이는 감촉도 모두 있다.
		PRINTFORML 생각해보면 %CALLNAME:(LOCAL:2)%은(는) 자신이 조교했었으니 그 정도는 느껴질 법도 하다.
		PRINTFORMW 그건 그렇고 모처럼 기계 몸이 되었으니, 아예 COMP를 내장해봐도 재미있을지 모르겠네…
	ENDIF
	IF TALENT:(LOCAL:2):부정형 == 1 && TALENT:MASTER:부정형 == 0
		PRINTFORML
		TALENT:MASTER:부정형 = 1
		PRINTFORMW ? 어쩐지 몸을 만지는 느낌에 위화감이 든다…
		PRINTFORMW 놀랍게도 %CALLNAME:MASTER%의 신체 일부는 %CALLNAME:(LOCAL:2)%처럼 녹아내려 있었다!
		PRINTFORML 기본적으로는 인간 형태를 유지하고 있으나, 부위에 따라서는 손가락으로 누르면 그대로 파묻혀 들어간다…
		PRINTFORML 아무래도 일부가 슬라임 형태의 육체로 변한 모양이다.
		PRINTFORML 하지만 이 몸, 무슨 일이라도 생기면 녹아내려 버리는 건 아닐까.
		PRINTFORMW %CALLNAME:MASTER%은(는) 이제 와서 새삼 %CALLNAME:(LOCAL:2)%의 고충을 헤아려보았다…
	ENDIF
	
	EXP:MASTER:85 += 1 ;あなた合体の回数を確認
	
	;合体素材の悪魔を消去
	CALL キャラ削除, LOCAL:2
	RETURN 0

