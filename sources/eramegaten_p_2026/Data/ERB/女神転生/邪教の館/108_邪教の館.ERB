@SHOPCOMABLE_108
SIF !IS_USEABLE_SHOPCOM
	RETURN 0
RESULT:1 = 1
RESULTS = 사교의관
RETURN 1

@SHOP_COM_108, ARG
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC SELECT_LIST, 100
#DIM DYNAMIC SELECT_UNABLE, 100
#DIM DYNAMIC SELECT_LIST_KEY, 100
VARSET SELECT_LIST
SELECT_LIST:0 '= "돌아간다"
SELECT_LIST:1 '= "２신합체"
SELECT_LIST:2 '= "３신합체"
SELECT_LIST:3 '= "특수합체"
SELECT_LIST:4 '= "제물합체"
SELECT_LIST:5 '= "조마제작"
SELECT_LIST:6 '= "조마강화합체"
SELECT_LIST:7 '= "조마초기화"
SELECT_LIST:8 '= "마정무구작성"
SELECT_LIST:9 '= "마정무구소재화"
SELECT_LIST:10 '= "스킬카드작성"
SELECT_LIST:11 '= "악마전서"
SELECT_LIST:12 '= "코딩실행"
SELECT_LIST:13 '= "변신악마변경"
SELECT_LIST:14 '= "악마스토리지"
SELECT_LIST:15 '= "당신합체"
SELECT_LIST:16 '= "시간성"
SELECT_LIST:98 '= "악마전서완전해방"
SELECT_LIST:99 '= "여기는 뭐야？"

VARI L_LINE = LINECOUNT
WHILE 1
	CLEARLINE LINECOUNT - L_LINE
	VARSET SELECT_UNABLE
	VARSET SELECT_LIST_KEY
	SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "２신합체")) = 1
	SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "３신합체")) = 1
	SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "특수합체")) = 1
	SIF ITEM:도리・카드몬
		SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "조마제작")) = 1
	SIF NUM_ZOUMA() > 0 && NUM_FUSIONABLE() > 0
		SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "조마강화합체")) = 1
	;メアリが居る場合は必要な造魔の数に+1
	SIF NUM_ZOUMA("汎用のみ") > 0
		SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "조마초기화")) = 1
	CUSTOMDRAWLINE =
	;メアリが居る場合は必要な造魔の数に+1
	SIF ITEM:무명의도 || SOFT_ON("마장의공방")
		SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "마정무구작성")) = 1
	FOR LOCAL,2000,VARSIZE("ITEM")
		SIF !魔晶装備(LOCAL)
			CONTINUE
		SIF !ITEM:LOCAL
			CONTINUE
		SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "마정무구소재화")) = 1
		BREAK
	NEXT
	SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "스킬카드작성")) = 1
	FLAG:합체소재악마1 = -1
	FOR LOCAL,0,CHARANUM
		CALL CASTING_FUSION_SACRIFICE, LOCAL
		SIF RESULT
			SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "제물합체")) = 1
		SIF TALENT:LOCAL:데빌시프터
			SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "변신악마변경")) = 1
	NEXT
	SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "악마전서")) = 1
	IF IS_CODING_ABLE()
		SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "코딩실행")) = 1
	ELSE
		SELECT_UNABLE:(FINDELEMENT(SELECT_LIST, "코딩실행")) = 1
	ENDIF
	SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "악마스토리지")) = 1
	SIF TALENT:MASTER:금단의지식
		SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "당신합체")) = 1
	SIF GETBIT(FLAG:발견ED, 30)
		SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "시간성")) = 1
	SIF IS_DEBUG
		SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "악마전서완전해방")) = 1
	SELECT_LIST_KEY:(FINDELEMENT(SELECT_LIST, "여기는 뭐야？")) = 1
	FOR LCOUNT, 1, VARSIZE("SELECT_LIST")
		SIF SELECT_UNABLE:LCOUNT
			CALL PRINT_COLOR, @"[{LCOUNT, 2}] %SELECT_LIST:LCOUNT%", COLOR("gray"), "L"
		SIF SELECT_LIST_KEY:LCOUNT
			PRINTFORML [{LCOUNT, 2}] %SELECT_LIST:LCOUNT%
	NEXT
	CUSTOMDRAWLINE =
	SELECT_LIST_KEY:0 = 1
	PRINTFORML [0] 돌아간다
	CALL INPUT_ARRAY, SELECT_LIST_KEY
	SELECTCASE SELECT_LIST:RESULT
		CASE "돌아간다"
			RETURN 0
		CASE "２신합체", "３신합체", "특수합체"
			IS_IN_FUSION = 1
			SELECTCASE SELECT_LIST:RESULT
				CASE "２신합체"
					CALL FUSION_NORMAL
				CASE "３신합체"
					CALL FUSION_NORMAL,3
				CASE "특수합체"
					CALL FUSION_SPECIAL
			ENDSELECT
			IS_IN_FUSION = 0
		CASE "조마제작"
			CALL MAKE_ZOUMA
		CASE "조마강화합체"
			CALL FUSION_ZOUMA
		CASE "조마초기화"
			CALL DEL_ZOUMA
		CASE "마정무구작성"
			PRINTL [ 1]마정검 작성
			PRINTL [ 2]마정지팡이 작성
			DRAWLINE
			PRINTL [0]돌아간다
			CALL INPUTINT, 0, 1, 2
			SELECTCASE RESULT
				CASE 1
					SIF SOFT_ON("마장의공방")
						CALL SELECT_MASHO2
					SIF !SOFT_ON("마장의공방")
						CALL MAKE_MASHO
				CASE 2
					CALL MAKE_MASHO_STAFF
			ENDSELECT
		CASE "마정무구소재화"
			CALL DEL_MASHO
		CASE "스킬카드작성"
			CALL MAKE_SKILLCARD
		CASE "변신악마변경"
			CALL CHANGE_LINK
		CASE "제물합체"
			CALL FUSION_SACRIFICE
		CASE "악마전서"
			CALL DEVIL_COMPENDIUM
		CASE "코딩실행"
			CALL CODING
		CASE "악마스토리지"
			CALL DEVIL_STORAGE
		CASE "당신합체"
			CALL FUSION_WITH_YOU
		CASE "시간성"
			IF GETBIT(FLAG:발견ED, 30)
				CALL CASTLE_OF_WATCH
			ELSE
				PRINTL 시간성 이사 예정지라고 적혀 있다……
				CALL SHOP_COM_108
			ENDIF
		CASE "악마전서완전해방"
			PRINTFORML 모든 악마전서를 100％로 합니다
			CALL INPUT_YN,"Yes","NO"
			IF RESULT == 0
				FOR LOCAL, 1, CSVCHARANUM
					IF EXISTCSV(LOCAL, 0)
						ANALYSIS_RATE:LOCAL = ANALYSIS_COMPLETED
						SETBIT IS_CHARA_COMPANIONED:LOCAL, 0
					ENDIF
				NEXT
			ENDIF
		CASE "여기는 뭐야？"
			CALL MIRKO
	ENDSELECT
WEND

