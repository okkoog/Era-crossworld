;================================================================
;悪魔全書予定地
;解析度:1 ～ 名称識別、会話可能 100 ～ アナライズ可能 1000～全書呼び出し可能
;=============================================================
;悪魔全書
;=============================================================
@DEVIL_COMPENDIUM
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC SHOW_CHARA_CSVNO
#DIM DYNAMIC SHOW_CHARA_NO
#DIM DYNAMIC L_LIST_PAGE
#DIM DYNAMIC L_CHARA_PAGE
#DIM DYNAMIC SELECT_RACE
#DIM DYNAMIC DEVIL_LIST, CSVCHARANUM
#DIM DYNAMIC IS_SHOWABLE, CSVCHARANUM 
#DIM DYNAMIC COUNTLIST
#DIM DYNAMIC SP_DEVIL_LIST, SP_FUSION_LISTNUM
#DIM DYNAMIC SP_DEVIL_LIST_KEY, SP_FUSION_LISTNUM
#DIM DYNAMIC HAVE_DEVIL_NO_LIST, MAX_PLAYER_CHARA
#DIM DYNAMIC HAVE_RACE_LIST, RACENUM
#DIM DYNAMIC HAVE_ZOUMA_MAXLV

CALL MAKE_SP_FUSION_LIST, COUNTLIST, SP_DEVIL_LIST, SP_DEVIL_LIST_KEY, HAVE_DEVIL_NO_LIST, HAVE_RACE_LIST, HAVE_ZOUMA_MAXLV
;LOCAL ループ用
;LOCAL:1 選択種族
;LOCAL:2 選択した悪魔
;LOCAL:3 召喚した悪魔の番号
;LOCAL:4 召喚費用
;LOCAL:5 召喚可能フラグ
;LOCAL:6 既に仲魔にいるか
;LOCAL:7 全書登録有無
;LOCAL:8 参照データ(0:オリジナル(CSV)データ、1:登録データ)
;LOCAL:9 CSVフラグ,１体のみであり、既に仲魔にいるか
;LOCAL:10
;LOCAL:20
;LOCAL:30 表示ページ番号
;C 閲覧可能な種族のリスト
;D 選択した種族のリスト
;LOCAL配列の初期化
VARSET LOCAL,0
DRAWLINE
PRINTL [1] 열람
PRINTL [2] ２신합체 역검색
PRINTL [3] ３신합체 역검색
PRINTL [4] 악마전서 등록
PRINTL [5] 소질 검색
PRINTL [6] 스킬 검색
PRINTL [7] 방어상성 검색
PRINTL [8] 얼라인먼트 검색
DRAWLINE
PRINTL [0] 돌아간다
$INPUT_LOOP
ONEINPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT == 2
	CALL REVERSE_LOOKUP_DEVIL, 2
	RESTART
ELSEIF RESULT == 3
	CALL REVERSE_LOOKUP_DEVIL, 3
	RESTART
ELSEIF RESULT == 4
	CALL REGISTRATION_COMPENDIUM
	RESTART
ELSEIF RESULT == 5
	CALL TALENT_LOOKUP_DEVIL
	RESTART
ELSEIF RESULT == 6
	CALL SKILL_LOOKUP_DEVIL
	RESTART
ELSEIF RESULT == 7
	CALL RESIST_LOOKUP_DEVIL
	RESTART
ELSEIF RESULT == 8
	CALL ALI_LOOKUP_DEVIL
	RESTART
ELSEIF RESULT > 8
	GOTO INPUT_LOOP
ENDIF

VARI COMPENDIUM_START_LINE = LINECOUNT	;行数
$COMPENDIUM_START
CUSTOMDRAWLINE ･

;リスト初期化
VARSET C, 0
FOR LCOUNT,1,17
	C:LCOUNT = 1
NEXT

;---- EDIT P 001 MOD START -------------------------
FOR LCOUNT,1,CSVCHARANUM
	IF EXISTCSV(LCOUNT,0)
		SIF (ANALYSIS_RATE:LCOUNT >= 0 || IS_CHARA_COMPANIONED:LCOUNT) && (CSVABL(LCOUNT,GETNUM(ABL,"종족"),0)) > -1
			C:(CSVABL(LCOUNT,GETNUM(ABL,"종족"),0)) = 1
	ENDIF
NEXT
;---- EDIT P 001 MOD END ---------------------------

;---- EDIT P 001 MOD START -------------------------
FOR LCOUNT, 0, RACENUM
	SIF !SHOW_ABLE_RACE_DEVIL_COMPENDIUM(LCOUNT)
		C:LCOUNT = 0
NEXT
;---- EDIT P 001 MOD END ---------------------------

PRINTL 어느 종족의 악마를 열람하시겠습니까？
FOR LCOUNT,1,99
	SIF C:LCOUNT != 1
		CONTINUE
	PRINTFORMLC [{LCOUNT,2}] %STR:LCOUNT,6,LEFT%
NEXT
PRINTL

DRAWLINE
PRINTL [0] 돌아간다

$INPUT_LOOP1
INPUT
SIF RESULT > 999
	GOTO INPUT_LOOP1
IF RESULT == 0
	RESTART
ELSEIF C:RESULT != 1
	GOTO INPUT_LOOP1
ENDIF

SELECT_RACE = RESULT

L_LIST_PAGE = 0								;	表示ページ
VARI L_STOCK_REDRAW = CURRENTREDRAW()	;REDRAW値
REDRAW 2
VARI L_START_LINE = LINECOUNT			;行数
$PRINT_LIST

;リストの作成
VARSET DEVIL_LIST, 0
VARI CHARA_NO
VARSET IS_SHOWABLE, -1
;先に見れるやつかどうかをとる
FOR CHARA_NO, 1, CSVCHARANUM
	SIF !EXISTCSV(CHARA_NO,0)
		CONTINUE
	SIF CSVABL(CHARA_NO,GETNUM(ABL,"종족"),0) != SELECT_RACE
		CONTINUE
	IF ANALYSIS_RATE:CHARA_NO > 0 || IS_CHARA_COMPANIONED:CHARA_NO
		IS_SHOWABLE:CHARA_NO = 1
	ELSE
		;特殊合体はヒントが見れる可能性がある
		IF IS_SHOWABLE_SPECIAL_FUSION_HINT(CHARA_NO)
			IS_SHOWABLE:CHARA_NO = 1
		ELSE
			IS_SHOWABLE:CHARA_NO = 0
		ENDIF
	ENDIF
NEXT
FOR CHARA_NO, 1, CSVCHARANUM
	SIF IS_SHOWABLE:CHARA_NO == -1
		CONTINUE
	;EXキャラの判定
	SIF !IS_PLAYABLE_EXTRA_CHARA(CHARA_NO)
		CONTINUE
	;99番は未実装悪魔の指定になるので飛ばす
	SIF CSVCFLAG(CHARA_NO, GETNUM(CFLAG,"EXTRA출전")) == 99
		CONTINUE
	;閲覧不能な場合はデビダス判定
	IF !IS_SHOWABLE:CHARA_NO
		;デビダスがない場合は終わり
		SIF !SOFT_ON("데비다스'XX")
			CONTINUE
	ENDIF
	;レベルの降順に並べるためにレベルと一緒に配列にいれる
	DEVIL_LIST:CHARA_NO = CSVBASE(CHARA_NO, GETNUM(BASE,"LV"),0) * 1000000 + CHARA_NO
NEXT
;ソート
ARRAYSORT DEVIL_LIST, BACK, 0
;レベルを抜く
FOR LCOUNT, 0, CSVCHARANUM
	DEVIL_LIST:LCOUNT %= 1000000
NEXT
VARI COUNT_LIST = FINDELEMENT(DEVIL_LIST, 0)	;閲覧可能数

CLEARLINE LINECOUNT - L_START_LINE
IS_ALREADY_EXIST = 0
;リストを表示
DRAWLINE
PRINTFORML □%STR:(SELECT_RACE)% (page.{L_LIST_PAGE + 1}/{COUNT_LIST / 2 / リスト表示数() + 1})
DRAWLINE
FOR LCOUNT, L_LIST_PAGE * 2 * リスト表示数(), MIN(COUNT_LIST, L_LIST_PAGE * 2 * リスト表示数() + リスト表示数())
	IF DEVIL_LIST:LCOUNT > 0
		CALL PRINTDEVIL_ELEMENT(DEVIL_LIST:LCOUNT, LCOUNT, SELECT_RACE)
		IF DEVIL_LIST:(LCOUNT + リスト表示数()) > 0
			PRINT 　
			CALL PRINTDEVIL_ELEMENT(DEVIL_LIST:(LCOUNT + リスト表示数()), LCOUNT + リスト表示数(), SELECT_RACE)
		ENDIF
	ENDIF
	PRINTL 
NEXT
SIF L_LIST_PAGE && (L_LIST_PAGE == COUNT_LIST / 2 / リスト表示数())
	PRINTFORM %"\n" * (リスト表示数() + 3 + L_START_LINE - LINECOUNT)%
DRAWLINE
PRINTFORMLC \@ L_LIST_PAGE > 0 ? [1007]이전페이지 # %" " * 16% \@
PRINTFORMLC [1000]돌아간다
PRINTFORMLC \@ L_LIST_PAGE < COUNT_LIST / 2 / リスト表示数() ? [1009]다음페이지 # %" " * 16% \@
$INPUT_LOOP2
INPUT
IF RESULT == 1000
	CLEARLINE LINECOUNT - COMPENDIUM_START_LINE
	REDRAW L_STOCK_REDRAW
	GOTO COMPENDIUM_START
ELSEIF RESULT == 1007 && L_LIST_PAGE > 0
	L_LIST_PAGE--
	GOTO PRINT_LIST
ELSEIF RESULT == 1009 && L_LIST_PAGE < COUNT_LIST / 2 / リスト表示数()
	L_LIST_PAGE++
	GOTO PRINT_LIST
ELSEIF INRANGE(RESULT, 0, VARSIZE("DEVIL_LIST") - 1) && DEVIL_LIST:RESULT > 0
	SHOW_CHARA_CSVNO = DEVIL_LIST:RESULT
	IF ANALYSIS_RATE:SHOW_CHARA_CSVNO < ANALYSIS_COMPLETED && !IS_CHARA_COMPANIONED:SHOW_CHARA_CSVNO
		;ヒントを見れる場合は通る
		IF !IS_SHOWABLE_SPECIAL_FUSION_HINT(SHOW_CHARA_CSVNO)
			CLEARLINE 1
			GOTO INPUT_LOOP2
		ENDIF
	ENDIF
ELSE
	CLEARLINE 1
	GOTO INPUT_LOOP2
;---- EDIT P 001 MOD END ---------------------------
ENDIF

SHOW_CHARA_NO = CHARANUM

;選んだ悪魔が既に仲魔である場合、後に渡すフラグを立てておく
VARI IS_ALREADY_EXIST = 0
VARI IS_HAVE_LIMIT = 0

IS_ALREADY_EXIST = FINDCHARA_NO_C(SHOW_CHARA_CSVNO) > -1
;一体のみ制限の確認
IF FINDCHARA_B(SHOW_CHARA_CSVNO) > -1
	;一体のみ制限
	SIF CSVCFLAG(SHOW_CHARA_CSVNO , GETNUM(CFLAG,"１체만"),0)
		IS_HAVE_LIMIT = 1
ENDIF
;最初は全書登録されているデータを表示するように
VARI SHOW_REGISTRATION_DATA = 1		;表示ページが登録データのほうかどうか
VARI IS_EXIST_REGISTRATION_DATA = 0	;登録されているデータがあるかどうか


$CHANGE_REFER_DATA
;一旦悪魔をキャラ登録
CALL ADD_NEW_COMPANION, SHOW_CHARA_CSVNO, 0, , 1
;名称が見れない状態できたときは名前を隠す
IF ANALYSIS_RATE:SHOW_CHARA_CSVNO < ANALYSIS_COMPLETED && !IS_CHARA_COMPANIONED:SHOW_CHARA_CSVNO
	CALLNAME:SHOW_CHARA_NO = ????
	NAME:SHOW_CHARA_NO = ????
ENDIF
;敵専用スキルを含めて一旦再設定
FOR LOCAL, 1, FLAG:스킬수 + 1
	LOCALS = 스킬{LOCAL}
	ABL:SHOW_CHARA_NO:LOCALS = CSVABL(SHOW_CHARA_CSVNO, GETNUM(ABL, LOCALS))
NEXT

;指定悪魔を全書登録してるかチェック
SIF STRFLAG_NUM_CPD_FIND("NO", NO:SHOW_CHARA_NO) > -1
	IS_EXIST_REGISTRATION_DATA = 1

;全書登録されている悪魔で、全書登録データを閲覧する場合、登録情報を参照
SIF IS_EXIST_REGISTRATION_DATA && SHOW_REGISTRATION_DATA
	CALL STRFLAG_NUM_CPD(SHOW_CHARA_NO,"REFER")
;覚醒スキルとデフォルトで登録されていない専用技を剥がす
FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
	SIF ABL:SHOW_CHARA_NO:@"스킬{LCOUNT}" == [[스킬:각성스킬]]
		ABL:SHOW_CHARA_NO:@"스킬{LCOUNT}" = 0
	SIF !IS_PU_SKILLNUM(ABL:SHOW_CHARA_NO:@"스킬{LCOUNT}")
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_NAME", ABL:SHOW_CHARA_NO:@"스킬{LCOUNT}", SHOW_CHARA_NO
	SIF RESULTS != ""
		CONTINUE
	ABL:SHOW_CHARA_NO:@"스킬{LCOUNT}" = 0
NEXT
;初期化する能力を記述
CFLAG:SHOW_CHARA_NO:초기LV = BASE:SHOW_CHARA_NO:LV
BASE:SHOW_CHARA_NO:ＥＸＰ = BASE:SHOW_CHARA_NO:LV* (BASE:SHOW_CHARA_NO:LV+1) * (BASE:SHOW_CHARA_NO:LV-1) * 5 /3

CFLAG:SHOW_CHARA_NO:능력강화횟수 = 0
FOR LOCAL,0,6
	CFLAG:SHOW_CHARA_NO:(GET_BASESTATUS(LOCAL) + "강화횟수") = 0
NEXT
CALL SYNC_STATUS,SHOW_CHARA_NO
CALL HEALTH_CHARA,SHOW_CHARA_NO

VARI PRINT_STATUS_LINE = LINECOUNT
L_CHARA_PAGE = 2
$PRINT_STATUS
CLEARLINE LINECOUNT - PRINT_STATUS_LINE
CUSTOMDRAWLINE =
U = SHOW_CHARA_NO
LOCALS = \@ CSTR:U:종족명 != "" ? %CSTR:U:종족명% # %STR:(ABL:U:종족)% \@
PRINTFORML %LOCALS%　　%NAME:U%　　
CALLFORM SHOW_INFO_PAGE_{L_CHARA_PAGE}

;特殊合体の条件を見れるなら追加表示
IF IS_SHOWABLE_SPECIAL_FUSION_HINT(SHOW_CHARA_CSVNO)
	VARSET RESULTS, "", 0, 3
	VARSET RESULT, 0, 0, 4
	CALLFORM FUSION_SPECIAL_{SHOW_CHARA_CSVNO}
	PRINTFORM 특수합체:
	FOR LCOUNT, 0, 3
		SIF RESULT:(LCOUNT + 1) == 0
			CONTINUE 
		IF RESULT:(LCOUNT + 1) > 0
			SIF LCOUNT
				PRINT ×
			IF RESULT:(LCOUNT + 1) == [[キャラ:조마]]
				PRINTFORM 【Lv{NEED_ZOUMA_LV_AT_SPECIAL_FUSION(SHOW_CHARA_CSVNO)}이상의 조마】
			ELSE
				PRINTFORM 【%CSV種族名(RESULT:(LCOUNT+1))% %CSVCALLNAME(RESULT:(LCOUNT+1))%】
			ENDIF
		ELSE
			PRINTFORM 【%GET_RACE(ABS(RESULT:(LCOUNT + 1)))%】
		ENDIF
	NEXT
	SIF !LINEISEMPTY()
		PRINTL 
	DRAWLINE
ENDIF

PRINTFORM %"\n" * MAX(0, 26 - LINECOUNT + PRINT_STATUS_LINE)%

;召喚費用を算出
VARI L_COST
L_COST = MAX(POWER(BASE:SHOW_CHARA_NO:LV,3),BASE:SHOW_CHARA_NO:LV*300, POWER(CSVBASE(SHOW_CHARA_CSVNO , GETNUM(BASE , "LV"),0) ,3) ,CSVBASE(SHOW_CHARA_CSVNO,GETNUM(BASE,"LV"),0) * 300)
;精霊は2.5倍
SIF SELECT_RACE ==GET_RACE_NUM("정령")
	TIMES L_COST , 2.50
;基本能力値合計が18 + Lv * 1.5 + 5 + 264 ( = Lv * 1.5 + 287)より大きい場合1ptにつき10万円追加
L_COST += MAX(0, BASE:SHOW_CHARA_NO:힘 + BASE:SHOW_CHARA_NO:지혜 + BASE:SHOW_CHARA_NO:마력 + BASE:SHOW_CHARA_NO:내구 + BASE:SHOW_CHARA_NO:속도 + BASE:SHOW_CHARA_NO:운 - BASE:SHOW_CHARA_NO:LV * 3 / 2 - 287) * 100000 / POWER(2, FLAG:전투난이도-1)

IF ANALYSIS_RATE:SHOW_CHARA_CSVNO > 0 || IS_CHARA_COMPANIONED:SHOW_CHARA_CSVNO
;FUSION.ERBからページ送り他を輸入
;FUSION.ERBからページ送り他を輸入

	;FUSION.ERBからページ送り他を輸入

	;ステータスの表示切替用
	PRINTFORMLC \@ L_CHARA_PAGE > 1 ? [1007]이전페이지 # %" " * 16% \@
	PRINTFORMLC                 
	PRINTFORMLC \@ L_CHARA_PAGE < 3 ? [1009]다음페이지 # %" " * 16% \@
ENDIF
PRINTL
PRINTL

VARI CAN_SUMMON	;召喚できるかどうか
CAN_SUMMON = 1
SIF CSVCFLAG(SHOW_CHARA_CSVNO,(GETNUM(CFLAG,"전서소환불가")),0) == 1
	CAN_SUMMON = 0
SIF CSVCFLAG(SHOW_CHARA_CSVNO,(GETNUM(CFLAG,"합체조건있음")),0) == 1 && REMOVED_FUSION_LIMIT:SHOW_CHARA_CSVNO == 0
	CAN_SUMMON = 0
SIF !IS_CHARA_COMPANIONED:SHOW_CHARA_CSVNO
	CAN_SUMMON = 0
SIF SELECT_RACE > 18
	CAN_SUMMON = 0

IF CAN_SUMMON
	SIF IS_ALREADY_EXIST == 1
		PRINT 이미 같은 동료마가 있지만、
	PRINTFORM 이 악마를 불러낼까요？（소환비용:￥{L_COST}) [0]Yes [9]No
ELSE
	PRINTFORM [9] 돌아간다
ENDIF

IF IS_EXIST_REGISTRATION_DATA
	PRINT  [10] 등록내용을 삭제한다
	PRINTFORM  [11] \@ SHOW_REGISTRATION_DATA ? 오리지널 # 등록 \@데이터를 참조한다
ENDIF
PRINTL

$INPUT_LOOP3
INPUTS
IF RESULTS == ""
	GOTO INPUT_LOOP3
ELSEIF !ISNUMERIC(RESULTS)
	CLEARLINE 1
	GOTO INPUT_LOOP3
ENDIF
RESULT = TOINT(RESULTS)
IF RESULT == 1007 && L_CHARA_PAGE > 1
	SIF ANALYSIS_RATE:SHOW_CHARA_CSVNO > 0 || IS_CHARA_COMPANIONED:SHOW_CHARA_CSVNO
		L_CHARA_PAGE--
	GOTO PRINT_STATUS
ELSEIF RESULT == 1009 && L_CHARA_PAGE < 3
	SIF ANALYSIS_RATE:SHOW_CHARA_CSVNO > 0 || IS_CHARA_COMPANIONED:SHOW_CHARA_CSVNO
		L_CHARA_PAGE++
	GOTO PRINT_STATUS
ELSEIF INRANGE(RESULT, 1, FLAG:스킬수)
	LOCALS = 스킬{RESULT}
	IF ABL:U:LOCALS > 0
		SIF FLAG:스킬속성표시설정 == 1
			CALL SKILL_EXPLAIN_PERFORMANCE, ABL:U:LOCALS, U
		CALL GET_SKILL_PROP, "SKILL_EXPLAIN", ABL:U:LOCALS, U
		WAIT
		GOTO PRINT_STATUS
	ELSE
		CLEARLINE 1
		GOTO INPUT_LOOP3
	ENDIF
ELSEIF RESULT == 9
	CALL キャラ削除, SHOW_CHARA_NO
	GOTO PRINT_LIST
ELSEIF RESULT == 10 && IS_EXIST_REGISTRATION_DATA
	CALL STRFLAG_NUM_CPD(SHOW_CHARA_NO,"CLEAR")
	PRINTFORML %LOCALS%%NAME:U%의 등록내용을 삭제했습니다
	CALL キャラ削除, SHOW_CHARA_NO
	GOTO PRINT_LIST
ELSEIF RESULT == 11 && IS_EXIST_REGISTRATION_DATA
	;表示内容(登録⇔オリジナル)切替
	INVERTBIT SHOW_REGISTRATION_DATA, 0
	CALL キャラ削除, SHOW_CHARA_NO
	GOTO CHANGE_REFER_DATA
ELSEIF RESULT == 19 && MAXARRAY(ABL:SHOW_CHARA_NO:0 , GETNUM(ABL , "습득LV1") , GETNUM( ABL , "습득LV20" ) +1 ) > 0
	CALL 習得スキル一覧表示 , SHOW_CHARA_NO
	GOTO PRINT_STATUS
ELSEIF RESULT == 0 && CAN_SUMMON == 1
ELSE
	CLEARLINE 1
	GOTO INPUT_LOOP3
ENDIF

;キャラ上限対策
IF CHARANUM > MAX_PLAYER_CHARA
	PRINTL ※캐릭터수가 상한에 도달했습니다
	PRINTW 캐릭터 가입처리를 취소합니다
	CALL キャラ削除, SHOW_CHARA_NO
	GOTO PRINT_LIST
ENDIF

IF IS_HAVE_LIMIT
	PRINTW 아쉽지만 이 악마는 ２마리 이상 동료마로 할 수 없습니다
	CALL キャラ削除, SHOW_CHARA_NO
	GOTO PRINT_LIST
ENDIF

;同じ仲魔がいる場合の除外をコメントアウト。代わりに自動ストレージ送りとします
;IF IS_ALREADY_EXIST == 1
;	PRINTW 同じ仲魔がいるようだな
;	CALL キャラ削除, SHOW_CHARA_NO
;	GOTO PRINT_LIST
;ENDIF

;悪魔のレベル>主人のレベルだった場合駄目
IF BASE:SHOW_CHARA_NO:LV > BASE:MASTER:LV || CSVBASE(SHOW_CHARA_CSVNO,GETNUM(BASE,"LV"),0) > BASE:MASTER:LV
	PRINTW 아쉽지만……네 레벨로는 다룰 수 없어
	CALL キャラ削除, SHOW_CHARA_NO
	GOTO PRINT_LIST
ENDIF

;---- EDIT 007 DEL START -------------------------
;ＣＯＭＰ容量が一杯
;IF FLAG:ＣＯＭＰ용량 < NUM_NAKAMA()+ソフト容量()
;	PRINTW ＣＯＭＰの空き容量が不足しているようだな
;	CALL キャラ削除, SHOW_CHARA_NO
;	GOTO PRINT_LIST
;ENDIF
;---- EDIT 007 DEL END ---------------------------

;足りなければ不可能
IF MONEY < L_COST
	PRINTW 자금이 부족한것 같군
	CALL キャラ削除, SHOW_CHARA_NO
	GOTO PRINT_LIST
ENDIF

;￥を消費
MONEY -= L_COST

;敵専用スキル等使えないスキルを削除
CALL EXCLUDE_UNABLE_SKILL, SHOW_CHARA_NO
