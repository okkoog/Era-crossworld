@INCREASE_ANALYZE, ARG, ARG:1
;ARG　増加させたい悪魔の登録番号
;ARG:1 増加させたい値LYSIS_COMPLETED
SIF NUM_HAVESKILL([[스킬:민속학]])
	ARG:1 *= 2
ANALYSIS_RATE:ARG = MIN(ANALYSIS_RATE:ARG + ARG:1, ANALYSIS_COMPLETED)
;FLAG:(20000+ARG) += ARG:1
;SIF FLAG:(20000+ARG) > 1000
;	FLAG:(20000+ARG) = 1000
;
;---- EDIT P 001 MOD END ---------------------------

@PRINTDEVIL_ELEMENT, L_CSVNO, L_LISTNUM, L_RACE
#DIM DYNAMIC L_CSVNO
#DIM DYNAMIC L_LISTNUM
#DIM DYNAMIC L_RACE
#DIM DYNAMIC L_COST
#LOCALSIZE 1
L_COST = MAX(POWER(CSVBASE(L_CSVNO, GETNUM(BASE, "LV")), 3), CSVBASE(L_CSVNO, GETNUM(BASE, "LV")) * 300)	;召喚費用を算出
SIF L_RACE == 13	;精霊は2.5倍
	TIMES L_COST , 2.50
SELECTCASE CSVCFLAG(L_CSVNO,(GETNUM(CFLAG,"EXTRA출전")),0)
	;メガテン出身EXTRA
	CASE IS < 0
		SETCOLOR COLOR("AQUA")
	;通常
	CASE 0
	;EXTRAフィルタ定義あり
	CASE IS < 98
		SETCOLOR COLOR("PASTEL-PURPLE")
	;EXTRAその他
	CASE 98
		SETCOLOR COLOR("PASTEL-GREEN")
ENDSELECT
IF (ANALYSIS_RATE:L_CSVNO < ANALYSIS_COMPLETED) && !IS_CHARA_COMPANIONED:L_CSVNO
	IF CSVCFLAG(L_CSVNO,(GETNUM(CFLAG,"EXTRA출전")),0)
		SETCOLOR COLOR("Light-gray")
	ELSE
		SETCOLOR COLOR("Dark-gray")
	ENDIF
ENDIF
SIF SOFT_ON("데비다스'XX") && CSVABL(L_CSVNO, GETNUM(ABL, "코딩"),0) && ITEM:(CSVABL(L_CSVNO, GETNUM(ABL, "코딩"),0)) == 0
	SETCOLOR COLOR("YELLOW")
IF ANALYSIS_RATE:L_CSVNO == 0 && !IS_CHARA_COMPANIONED:L_CSVNO
	IF IS_SHOWABLE_SPECIAL_FUSION_HINT(L_CSVNO)
		RESETCOLOR
		PRINTFORM [{L_LISTNUM, 3}] %"特殊合体悪魔", 27, LEFT%
	ELSE
		IF SOFT_ON("데비다스'XX")
			IF CSVCFLAG(L_CSVNO,(GETNUM(CFLAG,"EXTRA출전")),0)
				PRINTFORM [{L_LISTNUM, 3}] %"-（" + GET_EXTRA_INGAME_NAME(CSVCFLAG(L_CSVNO,(GETNUM(CFLAG,"EXTRA출전")),0), , 1) + "）-", 20, LEFT%?????　
			ELSE
				PRINTFORM [{L_LISTNUM, 3}] %"??????????", 20, LEFT%?????　
			ENDIF
		ENDIF
	ENDIF
ELSE
	VARS L_NAME
	L_NAME '= CSVCALLNAME(L_CSVNO)
	;特殊合体のみの悪魔は★をつける
	IF CSVCFLAG(L_CSVNO, GETNUM(CFLAG, "특수합체만"))
		SIF MATCH(SP_FUSION_LIST_DEVIL_NO, L_CSVNO)
			L_NAME '= "★" + L_NAME
	ENDIF
	PRINTFORM [{L_LISTNUM, 3}] %L_NAME, 20, LEFT%Lv{CSVBASE(L_CSVNO, GETNUM(BASE, "LV")), 3, RIGHT}　
ENDIF

IF CSVTALENT(L_CSVNO, GETNUM(TALENT, "남자"))
	PRINTS \@ CSVTALENT(L_CSVNO, GETNUM(TALENT, "오토코노코")) ? ？　 # ♂　 \@
ELSE
	PRINTS \@ CSVTALENT(L_CSVNO, GETNUM(TALENT, "후타나리")) ? 双　 # ♀　 \@
ENDIF
IF ANALYSIS_RATE:L_CSVNO < ANALYSIS_COMPLETED && !IS_CHARA_COMPANIONED:L_CSVNO
	PRINT  (상세불명) 
ELSEIF CSVCFLAG(L_CSVNO, GETNUM(CFLAG, "전서소환불가")) || (CSVCFLAG(L_CSVNO, GETNUM(CFLAG,"합체조건있음")) && !REMOVED_FUSION_LIMIT:L_CSVNO) || L_RACE > 18
	PRINT  (소환불가) 
ELSEIF !IS_CHARA_COMPANIONED:L_CSVNO
	PRINT  (미입수)   
ELSE
	;なんらかの事情で解析度が抜けてしまっていた場合にフォロー措置を入れる
	ANALYSIS_RATE:L_CSVNO = ANALYSIS_COMPLETED
	PRINTFORM ￥{L_COST, 10, RIGHT}
ENDIF
RESETCOLOR

@IS_SHOWABLE_SPECIAL_FUSION_HINT, CHARA_NO
#FUNCTION
#DIM DYNAMIC CHARA_NO
#DIM DYNAMIC LCOUNT
#DIM FUSION_LIST_NO
;合体条件を確認する
SIF CSVCFLAG(CHARA_NO,(GETNUM(CFLAG,"합체조건있음")),0) && !REMOVED_FUSION_LIMIT:CHARA_NO
	RETURNF 0
;特殊合体のみの場合にヒントをだす
SIF !CSVCFLAG(CHARA_NO,(GETNUM(CFLAG,"특수합체만")),0)
	RETURNF 0
;コンバータの指定があるときはソフトを持ってないとダメ
SIF CSVCFLAG(CHARA_NO,(GETNUM(CFLAG,"컨버터")),0) && !HAVE_INSTALLSOFT:CSVCFLAG(CHARA_NO,(GETNUM(CFLAG,"컨버터")),0)
	RETURNF 0
;特殊合体リストに載っている場合
FUSION_LIST_NO = FINDELEMENT(SP_FUSION_LIST_DEVIL_NO, CHARA_NO)
SIF FUSION_LIST_NO < 0
	RETURNF 0
;素材のうち一体でも仲魔にしたとことがあれば真
FOR LCOUNT, 0, 3
	SIF SP_FUSION_LIST_MATERIAL:FUSION_LIST_NO:LCOUNT == 0
		CONTINUE
	SIF !IS_CHARA_COMPANIONED:(SP_FUSION_LIST_MATERIAL:FUSION_LIST_NO:LCOUNT)
		CONTINUE
	IF RESULT:LCOUNT == [[キャラ:조마]]
		SIF NEED_ZOUMA_LV_AT_SPECIAL_FUSION(CHARA_NO) > MAX_MASTER_LV
			CONTINUE
	ENDIF
	RETURNF 1
NEXT
RETURNF 0


