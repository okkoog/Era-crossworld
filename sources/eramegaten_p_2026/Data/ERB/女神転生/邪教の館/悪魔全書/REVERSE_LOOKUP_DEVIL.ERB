;目標の悪魔ARGが合体(ARG:1, ARG:2, ARG:3)の結果指定したスキルを全て保有するかどうか判定
@スキル継承テスト, SKL, SNUM, ARG, ARG:1, ARG:2, ARG:3=-1
#FUNCTION
#DIM REF SKL
#DIM SNUM
#DIM SRC
#DIM LCOUNT
#DIM TEMP
#DIM SUCNUM
#DIM SUCLIST, 24
#DIM RANKLIST, 24
#DIM SLOT
#DIM BLANKNUM

VARSET SUCLIST
VARSET RANKLIST, 101
SUCNUM = 0
SLOT = GETNUM(ABL, "스킬1")
;継承スキルをリストアップする
FOR SRC, 1, (ARG:3 == -1 ? 3 # 4)
	FOR LCOUNT, 0, 8
		TEMP = CSVABL(ARG:SRC, SLOT+LCOUNT)
		SIF TEMP == 0
			BREAK
		IF IS_SUCCESS_SKILL(ARG, TEMP, COUNT_ELEMENT(SUCLIST, TEMP, 0, SUCNUM))
			SUCLIST:SUCNUM = TEMP
			RANKLIST:SUCNUM = 100 - ((Z:TEMP >> 4) & 0xf)  ;ランクは降順整列のため100からの減算にする
			SUCNUM++
		ENDIF
	NEXT
NEXT
;継承スキルをランクで降順に整列
ARRAYMSORT RANKLIST, SUCLIST
;継承先の空きスロットを数える
FOR LCOUNT, 0, 8
	SIF CSVABL(ARG, SLOT+LCOUNT) == 0
		BREAK
NEXT
BLANKNUM = MIN(8 - LCOUNT, SUCNUM)
;指定スキルが継承リストから見つからなかったら0を返す
FOR LCOUNT, 0, SNUM
	SIF !CHECK_SKILL_CSV(ARG, SKL:LCOUNT) && FINDELEMENT(SUCLIST, SKL:LCOUNT, 0, BLANKNUM) == -1
		RETURNF 0
NEXT
RETURNF 1

;キャラARGがスキルARG:1を持っているかどうか
@CHECK_SKILL_CSV(ARG, ARG:1)
#FUNCTION
#DIM LCOUNT
#DIM SLOT
#DIM SKL
SLOT = GETNUM(ABL, "스킬1")
FOR LCOUNT, 0, 8
	SKL = CSVABL(ARG, SLOT+LCOUNT)
	SIF SKL == 0
		BREAK
	SIF SKL == ARG:1
		RETURNF 1
NEXT
RETURNF 0


;スキルが対象の悪魔に継承できるかどうか
;邪教の館での合体のみを想定
@IS_SUCCESS_SKILL, DEST, SKL, SKLCNT
#FUNCTION
#DIM DEST
#DIM SKL
#DIM SKLCNT
#DIM LCOUNT
#DIM TEMP
SIF Z:SKL & 1
	RETURNF 0
SIF SKLCNT && (SKLCNT + 1) > ((Z:SKL >> 1) & 0xf)
	RETURNF 0
FOR LCOUNT, GETNUM(ABL, "스킬1"), GETNUM(ABL, "스킬9")
	TEMP = CSVABL(DEST, LCOUNT)
	IF TEMP == SKL
		SKLCNT++
		BREAK
	ENDIF
NEXT
SIF (SKLCNT + 1) > ((Z:SKL >> 1) & 0xf)
	RETURNF 0
RETURNF 1



;相反する素質がある素質なら真、無ければ偽を返す
;RESULT:1に相反する素質の番号、RESULTSにはその名前が入る
@IS_OPPOSITION_TALENT, TAL
#FUNCTION
#DIM TAL
;相反する素質を2個一組で交互に記述
#DIMS CONST NAMES = "프라이드높음", "프라이드낮음", "호기심", "보수적", "낙관적", "비관적", "정조관념", "정조관결여", "억압", "해방", "부끄럼쟁이", "부끄럼없음", "아픔에강함", "아픔에약함", "젖기쉬움", "젖기어려움", "임신하기쉬움", "임신하기어려움", "습득빠름", "습득느림", "악취민감", "악취둔감", "쾌감에솔직", "쾌감을부정", "Ｃ민감", "Ｃ둔감", "Ｖ민감", "Ｖ둔감", "Ａ민감", "Ａ둔감", "Ｂ민감", "Ｂ둔감"
#DIM OP, 50 = -99
#DIM TABLE, 200  ;継承可能な素質の番号は200以内に収まるはず
#DIM LCOUNT
;ルックアップテーブルを作成
IF OP:0 == -99
	VARSET OP, -1
	VARSET TABLE, -1
	FOR LCOUNT, 0, VARSIZE("NAMES")
		OP:LCOUNT = GETNUM(TALENT, NAMES:LCOUNT)
		TABLE:GETNUM(TALENT, NAMES:LCOUNT) = LCOUNT
	NEXT
ENDIF
SIF TAL >= 200 || TABLE:TAL == -1
	RETURNF 0
;指定された素質のテーブル上の位置が偶数なら奇数、奇数なら偶数が相反する素質（最下位ビットを反転させるだけでいい）
RESULT:1 = OP:(TABLE:TAL ^ 1)
RESULTS '= NAMES:(TABLE:TAL ^ 1)
RETURNF 1

;悪魔合体で継承され得る素質かどうかを判定
@IS_SUCCESS_TALENT, TAL
#FUNCTION
#DIM TAL
#DIMS CONST NAMES = "처녀", "겁쟁이", "꿋꿋함", "반항적", "솔직함", "얌전함", "건방짐", "츤데레", "자제심", "무관심", "감정결핍", "일선을넘지않음", "눈에띄고싶어함", "저항", "헌신적", "소악마", "광기", "유치", "바늘다루기", "약독내성", "오줌싸개버릇", "자위하기쉬움", "불결무시", "중독되기쉬움", "도착적", "바이", "남성혐오", "여성혐오", "매력", "매혹", "프라이드높음", "프라이드낮음", "호기심", "보수적", "낙관적", "비관적", "정조관념", "정조관결여", "억압", "해방", "부끄럼쟁이", "부끄럼없음", "아픔에강함", "아픔에약함", "젖기쉬움", "젖기어려움", "임신하기쉬움", "임신하기어려움", "습득빠름", "습득느림", "악취민감", "악취둔감", "쾌감에솔직", "쾌감을부정", "Ｃ민감", "Ｃ둔감", "Ｖ민감", "Ｖ둔감", "Ａ민감", "Ａ둔감", "Ｂ민감", "Ｂ둔감"
#DIM TABLE, 200 = -99
#DIM LCOUNT
IF TABLE:0 == -99
	TABLE:0 = 0
	FOR LCOUNT, 0, VARSIZE("NAMES")
		TABLE:GETNUM(TALENT, NAMES:LCOUNT) = 1
	NEXT
ENDIF
RETURNF TAL < 200 && TABLE:TAL


;素質選択処理
;選択状態に応じてCURSELの値を変更する
;CURSEL : [入出力]現在選択している素質リスト
;MAXSEL : CURSELの最大要素数
@INPUT_SELECT_TALENTS, CURSEL, MAXSEL
#DIM REF CURSEL, 0
#DIM DYNAMIC MAXSEL
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC SUCTAL, 160
#DIM DYNAMIC SEL, 160
#DIM DYNAMIC TNUM
#DIM DYNAMIC SELNUM
#DIM DYNAMIC NUM
#DIM DYNAMIC LN
#DIMS DYNAMIC TEMPS
#LOCALSIZE 1
FOR LCOUNT, 0, 160
	SIF IS_SUCCESS_TALENT(LCOUNT)
		SUCTAL:(TNUM++) = LCOUNT
NEXT
FOR LCOUNT, 0, TNUM
	IF FINDELEMENT(CURSEL, SUCTAL:(LCOUNT)) != -1
		SEL:LCOUNT = 1
		SELNUM++
	ENDIF
NEXT
PRINTL
REDRAW 0
LN = LINECOUNT
$INPUT_LOOP
CLEARLINE LINECOUNT - LN
FOR LCOUNT, 0, TNUM
	IF SEL:LCOUNT
		SETCOLOR COLOR("AQUA")
	ELSEIF SELNUM == MAXSEL
		SETCOLOR COLOR("灰色")
	ELSEIF IS_OPPOSITION_TALENT(SUCTAL:LCOUNT)
		LOCAL = FINDELEMENT(SUCTAL, RESULT:1)
		SIF LOCAL != -1 && SEL:LOCAL
			SETCOLOR COLOR("灰色")
	ENDIF
	TEMPS = [%TALENTNAME:(SUCTAL:LCOUNT)%]
	PRINTBUTTON @"%TEMPS,16,LEFT%", LCOUNT
	RESETCOLOR
NEXT
PRINTL
DRAWLINE
PRINTL [1000]결정  [1010]모든 선택 해제
INPUT
IF RESULT == 1000
	VARSET CURSEL, -1
	LOCAL = 0
	FOR LCOUNT, 0, TNUM
		SIF LOCAL == MAXSEL
			BREAK
		SIF SEL:LCOUNT
			CURSEL:(LOCAL++) = SUCTAL:LCOUNT
	NEXT
	REDRAW 1
	RETURN LOCAL
ELSEIF RESULT == 1010
	VARSET SEL
	SELNUM = 0
ELSEIF INRANGE(RESULT, 0, TNUM-1)
	NUM = RESULT
	SIF SELNUM == MAXSEL && !SEL:NUM
		GOTO INPUT_LOOP
	IF IS_OPPOSITION_TALENT(SUCTAL:NUM)
		LOCAL = FINDELEMENT(SUCTAL, RESULT:1)
		SIF LOCAL != -1 && SEL:LOCAL
			GOTO INPUT_LOOP
	ENDIF
	SEL:NUM = !SEL:NUM
	SELNUM += SEL:NUM ? 1 # -1
ENDIF
GOTO INPUT_LOOP



;スキル選択処理
;処理としては素質と同じ
@INPUT_SELECT_SKILLS, CURSEL, MAXSEL
#DIM REF CURSEL
#DIM DYNAMIC MAXSEL
#DIM DYNAMIC LN
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC SELNUM
#DIM DYNAMIC SKILL
#DIM DYNAMIC NUM

IF LN == 0
	REDRAW 0
	LN = LINECOUNT
	SELNUM = FINDELEMENT(CURSEL, -1)
	SIF SELNUM == -1
		SELNUM = MAXSEL
ENDIF

PRINTL 필터링할 스킬명 또는 스킬번호를 입력해주세요。（빈 문자열로 종료）
PRINTL 선택중인 스킬과 같은 이름이나 번호를 입력하면 선택이 해제됩니다。
PRINTBUTTON "[결정]", ""
PRINT     선택중：
FOR LCOUNT, 0, SELNUM
	PRINTBUTTON @"[%SKILL_NAME_F(CURSEL:LCOUNT)%]", CURSEL:LCOUNT
NEXT
PRINTL
REUSELASTLINE
INPUTS

IF RESULTS == ""
	REDRAW 1
	RETURN SELNUM
ENDIF

SKILL = ISNUMERIC(RESULTS) ? TOINT(RESULTS) # SKILL_NUM_F(RESULTS)

NUM = FINDELEMENT(CURSEL, SKILL)
IF NUM != -1
	IF NUM == MAXSEL - 1
		CURSEL:(MAXSEL - 1) = -1
	ELSE
		ARRAYSHIFT CURSEL, -1, -1, NUM, SELNUM - NUM
	ENDIF
	SELNUM--
ELSEIF SELNUM != MAXSEL
	CALL GET_SKILL_PROP, "SKILL_NAME", SKILL, -1
	SIF RESULTS != ""
		CURSEL:(SELNUM++) = SKILL
ENDIF

CLEARLINE (LINECOUNT - LN)
RESTART



;継承の判断に必要なデータを予め調べて変数Zに保存しておく
;最大スキル番号は2100で外部作品スキルは無視する
;データはビットフィールドで保存
;0x01 = 継承可能かどうか
;0xf0 = スキルランク
@MAKE_RLD_SKILL_SUCCESSION_TABLE
#DIM DYNAMIC LCOUNT
VARSET Z
FOR LCOUNT, 0, 2499
	SIF ITEMNAME:(10000+LCOUNT) == ""
		CONTINUE
	CALL GET_SKILL_PROP, "継承不能", LCOUNT
	Z:LCOUNT = RESULT

	IF !Z:LCOUNT
		CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", LCOUNT, -1
		;常に邪教の館扱い
		SIF !INRANGE(RESULT, 0, 22) ;|| (CSVTALENT(DEST, GET_SUCCESSION(RESULT)) == 0 && RESULT != 22 && 사교의관 == 0)
			Z:LCOUNT = 1
	ENDIF
	RESULT = 0
	CALL GET_SKILL_PROP, "SKILL_RANK", LCOUNT, -1
	Z:LCOUNT |= (RESULT << 4) & 0xf0
NEXT


;合体逆引き組み合わせを予め全てリストアップする
@MAKE_RLD_FUSION_RACE_TABLE, 合身数, FTABLE2, FTABLE2NUM, FTABLE3, FTABLE3NUM
#DIM DYNAMIC 合身数
#DIM REF FTABLE2, 0, 0, 0
#DIM REF FTABLE2NUM, 0
#DIM REF FTABLE3, 0, 0, 0
#DIM REF FTABLE3NUM, 0
#DIM DYNAMIC RES
#DIM DYNAMIC RACE1
#DIM DYNAMIC RACE2
#DIM DYNAMIC RACE3

IF 合身数 == 2
	FOR RACE1, 1, 12
		FOR RACE2, RACE1, 12
			IF RACE1 != RACE2
				RES = SEARCH_RACE(RACE1, RACE2)
				IF RES && RES != 13
					FTABLE2:RES:0:(FTABLE2NUM:RES) = RACE1
					FTABLE2:RES:1:(FTABLE2NUM:RES) = RACE2
					FTABLE2NUM:RES++
				ENDIF
			ENDIF
		NEXT
	NEXT
ELSEIF 合身数 == 3
	FOR RACE1, 1, 12
		FOR RACE2, RACE1, 12
			FOR RACE3, RACE2, 12
				RES = SEARCH_RACE(RACE1, RACE2, RACE3)
				IF RES && RES != 13
					FTABLE3:RES:0:(FTABLE3NUM:RES) = RACE1
					FTABLE3:RES:1:(FTABLE3NUM:RES) = RACE2
					FTABLE3:RES:2:(FTABLE3NUM:RES) = RACE3
					FTABLE3NUM:RES++
				ENDIF
			NEXT
		NEXT
	NEXT
ENDIF


;OUTPUT_DEVILの関数版
;元と同様、使用前にMAKE_RACE_LISTしておく必要がある
@OUTPUT_DEVIL_F, 基準LV, 加算値
#FUNCTION
#DIM 基準LV
#DIM 加算値
#DIM HI
#DIM LO
;テーブル登録の変更にあわせて、基準LVから開始し、一つ減らすのと増やすのを交互に実行し、最初に引っかかった番号を返すように
;条件のうち最大レベル
HI = 基準LV + 加算値
LO = HI
DO
	SIF D:HI >= 0
		RETURNF D:HI
	HI++
	;先にマイナス突入した場合はCONTINUEいれる
	SIF LO < 0
		CONTINUE
	SIF D:LO >= 0
		RETURNF D:LO
	LO--
;とりあえず、150レベル超えたら撃ち切って0を返すように
LOOP HI < 150
RETURNF 0


;RESULT_ELEMENT_FUSIONの関数版
;元と同様、使用前にMAKE_RACE_LISTしておく必要がある
@RESULT_ELEMENT_FUSION_F, DEVIL, ELEMENT
#FUNCTION
#DIM DEVIL
#DIM ELEMENT
#DIM ランク変化方向
#DIM LV

SELECTCASE CSVABL(DEVIL, GETNUM(ABL,"종족"),0)
	;地母神、女神、妖魔、妖鬼、龍王、鬼神、魔神
	CASE 1,2,5,7,8,15,16
		ランク変化方向 = 1
	;魔王、天使、妖精、魔獣、妖鳥、外道、邪神、堕天使
	CASE 3,4,6,9,10,11,17,18
		ランク変化方向 = -1
	;精霊合体非対応種族
	CASEELSE
		RETURNF 0
ENDSELECT

SELECTCASE ELEMENT
	;ウンディーネorサラマンダー
	CASE 1202, 1204, 1205
;		ランク変化方向 *= 1
	;シルフorノーム
	CASE 1201, 1203
		ランク変化方向 *= -1
	;精霊合体非対応精霊
	CASEELSE
		RETURNF 0
ENDSELECT

LV = CSVBASE(DEVIL, GETNUM(BASE, "LV"), 0)
DO
	LV += ランク変化方向
	SIF !INRANGE(LV, 0, 150)
		RETURNF 0
	SIF D:LV >= 0
		RETURNF D:LV
;		RETURNF D:LV, 0, ランク変化方向
LOOP 1



