ELSE
	;番号サーチ
	IF ARGS == "MAXNUM"
		RESULT_F = FINDELEMENT(REGISTRATIONS, "", , , 1)
	ELSE
		RESULT_F = FINDELEMENT(REGISTRATIONS, ARGS, , , 1)
	ENDIF
ENDIF

@GET_CPD_STRFLAG_NUM(ARGS)
#FUNCTION
CALLFORMF GET_CPD_STRFLAG(, ARGS)
RETURNF RESULT_F

@GET_CPD_SAVESTR_NUM(ARG,ARGS)
#FUNCTIONS
#LOCALSSIZE 100
;SAVESTR:ARGに記載されているARGSの値を返す

LOCAL = GET_CPD_STRFLAG_NUM(ARGS)
SIF ARG < 2000 || ARG >= 7000
	THROW "引数が異常です。{ARG}"
SIF SAVESTR:ARG == "" || LOCAL < 0 || LOCAL > 99
	RETURNF "登録されていません"

SPLIT SAVESTR:ARG, ",", LOCALS
RETURNF LOCALS:LOCAL

