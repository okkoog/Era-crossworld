@REGISTRATION_COMPENDIUM
;登録処理関数
;LOCAL:1 종족
;LOCAL:2 キャラ番号
;LOCAL:3 キャラ登録番号
;LOCAL:4 既存の全書データ呼び出し用キャラ登録番号
;LOCAL:5 キャラリストのページ送り用
;LOCAL:6 キャラ比較のページ送り用
;LOCAL:7 能力表示のページ送り用
;LOCAL:10 登録可否

;キャラリストを表示
;LOCAL:8 = FLAG:SHOP커맨드
;FLAG:SHOP커맨드 = 1201
;CALL INPUT_CHARA_LIST("悪魔全書に登録したい悪魔を選んでください", "CASTING_REGISTRATION_COMPENDIUM", "UP_PRINT_REGISTRATION_COMPENDIUM")
{
CALL INPUT_CHARA_LIST
	, "REGISTRATION_COMPENDIUM_戦闘/調教/育成情報/基本ステータス/防御相性1/防御相性2"
	, "악마전서에 등록하고 싶은 악마를 선택해주세요"
	, "CASTING_REGISTRATION_COMPENDIUM" 
	, "UP_PRINT_REGISTRATION_COMPENDIUM"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "REGISTRATION_COMPENDIUM_CUSTOM_COLOR"
	, -1
}

;FLAG:SHOP커맨드 = LOCAL:8
IF RESULT == 1000
	RETURN 0
ENDIF

;選択したキャラの能力を表示。

LOCAL:1 = ABL:RESULT:종족
LOCAL:2 = NO:RESULT
LOCAL:3 = RESULT
U = RESULT
LOCAL:7 = 2

;比較用のキャラ追加
LOCAL:4 = CHARANUM
;---- EDIT 000 XXX START -------------------------
CALL ADD_NEW_COMPANION,LOCAL:2,0,-1,1
;---- EDIT 000 XXX END ---------------------------
CALL STRFLAG_NUM_CPD(LOCAL:4,"REFER")
CALL SYNC_STATUS,LOCAL:4
CALL HEALTH_CHARA,LOCAL:4

$PRINT_STATUS
CUSTOMDRAWLINE =
PRINTFORML  \@ U != LOCAL:4 ? 전서 등록 내용 # %" " * 18% \@
LOCALS = \@ CSTR:U:종족명 != "" ? %CSTR:U:종족명% # %STR:(ABL:U:종족)% \@
PRINTFORML %LOCALS%　　%NAME:U%　　
TRYCCALLFORM SHOW_INFO_PAGE_{LOCAL:7}
CATCH
ENDCATCH


;ステータスの表示切替用
PRINTFORMLC \@ LOCAL:7 == 2 ? [1007]이전페이지 # %" " * 16% \@
PRINTFORMLC                 
PRINTFORMLC \@ LOCAL:7 == 1 ? [1009]다음페이지 # %" " * 16% \@
PRINTL 
PRINTFORMLC \@ U != LOCAL:4 && LOCAL:4 > -1 ? [1010]전서 등록 내용 # %" " * 18% \@
PRINTFORMLC \@ U != LOCAL:3 && LOCAL:4 > -1 ? [1011]현재 스테이터스 # %" " * 18% \@
PRINTL

;登録するかどうか
IF CSVCFLAG(LOCAL:2,(GETNUM(CFLAG,"전서소환불가")),0) == 1 || (CSVCFLAG(LOCAL:2,(GETNUM(CFLAG,"합체조건있음")),0) == 1 && REMOVED_FUSION_LIMIT:(LOCAL:2) == 0) || LOCAL:1 > 18
	PRINTFORML 이 악마는 악마전서에서 소환할 수 없기 때문에、등록할 수 없습니다
	PRINTFORML 　　　[9] 돌아간다
	LOCAL:10 = 0
ELSE
	PRINTL 향에 의한 강화도 등록되지만、대량으로 향을 사용한 경우、전서소환에 추가요금이 발생합니다
	PRINTFORM \@ U == LOCAL:3 ? 이 악마를 등록하시겠습니까？ # 이 내용으로 덮어쓰시겠습니까？ \@
	PRINTL [0]Yes [9]No
	LOCAL:10 = 1
ENDIF
$INPUT_LOOP
INPUT
IF RESULT == 1007 && LOCAL:7 == 2
	LOCAL:7 = 1
	GOTO PRINT_STATUS
ELSEIF RESULT == 1009 && LOCAL:7 == 1
	LOCAL:7 = 2
	GOTO PRINT_STATUS
ELSEIF RESULT == 1010 && U != LOCAL:4
	U = LOCAL:4
	GOTO PRINT_STATUS
ELSEIF RESULT == 1011 && U != LOCAL:3
	U = LOCAL:3
	GOTO PRINT_STATUS
ELSEIF RESULT == 19 && MAXARRAY(ABL:U:0 , GETNUM(ABL , "습득LV1") , GETNUM( ABL , "습득LV20" ) +1 ) > 0
	CALL 習得スキル一覧表示 , U
	GOTO PRINT_STATUS
ELSEIF RESULT <= FLAG:스킬수 && RESULT > 0
	LOCALS = 스킬{RESULT}
	IF ABL:U:LOCALS > 0
		SIF FLAG:스킬속성표시설정 == 1
			CALL SKILL_EXPLAIN_PERFORMANCE, ABL:U:LOCALS, U
		CALL GET_SKILL_PROP, "SKILL_EXPLAIN", ABL:U:LOCALS, U
		WAIT
		GOTO PRINT_STATUS
	ELSE
		GOTO INPUT_LOOP
	ENDIF
ELSEIF RESULT == 9
	DELCHARA LOCAL:4
	RESTART
ELSEIF RESULT == 0 && LOCAL:10 == 1
	DELCHARA LOCAL:4
ELSE
	GOTO INPUT_LOOP
ENDIF

CALL STRFLAG_NUM_CPD(LOCAL:3,"ADD")
RESTART

@STRFLAG_NUM_CPD,ARG = -1,ARGS
#LOCALSSIZE 200
#DIMS DYNAMIC L_LEARN, 30
#DIM DYNAMIC L_LEARN_LV, 30
VARSET LOCALS
;使用SAVESTR:2000～6999。埋まりきることはまず無いと思います
;ARGSがADDの場合、キャラ登録番号ARGのキャラの各種能力をSAVESTRに記載する。同じキャラ番号のが既にあるなら上書きする
;ARGSがREFERの場合、キャラ登録番号ARGのキャラ番号のSAVESTRがある場合それを参照してABL等に上書きする
;ARGSがCLEARの場合、最後のSAVESTRをキャラ登録番号ARGのSAVESTRに上書きして最後のを削除する。セーブデータ圧縮及び処理時間短縮のための処理
;ARGSがDIFFの場合、キャラ登録番号ARGのキャラ番号のSAVESTRがある場合、それと登録内容が同じになるか比較し、同じであれば0を、異なれば文字色変更に変更後の色を代入して返す

IF ARG < 0 || ARG >= CHARANUM
	THROW "登録番号が異常です"
	RETURN
ENDIF

LOCAL:5 = GET_CPD_STRFLAG_NUM("MAXNUM")

IF ARGS == "CLEAR"
	LOCAL = STRFLAG_NUM_CPD_FIND("NO",NO:ARG)
	SIF LOCAL == -1
		RETURN
	LOCAL:1 = STRFLAG_NUM_CPD_FIND("",-1) - 1
	SAVESTR:LOCAL = %SAVESTR:(LOCAL:1)%
	SAVESTR:(LOCAL:1) = 
ELSEIF ARGS == "ADD" || ARGS == "DIFF"
	LOCALS = {NO:ARG}
	VARS L_PROP
	FOR LOCAL:1,2,LOCAL:5
		L_PROP '= GET_CPD_STRFLAG(LOCAL:1)
		IF GETNUM(ABL,L_PROP) > 0
			IF STRFIND(L_PROP, "스킬") >= 0
				IF GROUPMATCH(ABL:ARG:L_PROP, 0, [[스킬:각성스킬]])
					LOCALS += "," + "0"
				ELSEIF IS_PU_SKILLNUM(ABL:ARG:L_PROP)
					LOCALS += "," + CONVERT_SKILLNUM_TO_STR(ARG, ABL:ARG:L_PROP)
				ELSE
					CALL GET_SKILL_PROP, "SKILL_NAME", ABL:ARG:L_PROP, -1
					IF RESULTS != ""
						LOCALS += "," + RESULTS
					ELSE
						LOCALS += "," + "0"
					ENDIF
				ENDIF
			ELSE
				LOCALS += "," + TOSTR(ABL:ARG:L_PROP)
			ENDIF
		ELSEIF GETNUM(ABL,L_PROP) > 0
			LOCALS += "," + TOSTR(ABL:ARG:L_PROP)
		ELSEIF GETNUM(BASE,L_PROP) > 0
			LOCALS += "," + TOSTR(BASE:ARG:L_PROP)
		ELSEIF GETNUM(CFLAG,L_PROP) > 0
			LOCALS += "," + TOSTR(CFLAG:ARG:L_PROP)
		ELSE
			LOCALS = %LOCALS%,想定外の動作です
		ENDIF
	NEXT
	;素質の書き込み
	FOR LOCAL:1 , 0 , 159
		SELECTCASE LOCAL:1
			CASE 0
				;처녀
				;CSVかARGのどっちかが処女なら処女で登録する
				IF TALENT:ARG:처녀 || CSVTALENT(NO:ARG , 0 , 0)
					LOCALS += "," + TALENTNAME:(LOCAL:1)
				;ARGが再生処女持ちであれば再生処女を追加する
				ELSEIF TALENT:ARG:재생처녀
					LOCALS += ",재생처녀"
				ENDIF
			CASE 1 , 3 TO 9 , 73 TO 77, 153 , 154
				;書き込まない素質
			CASE 145 , 155 , 83 , 84
				;CSVを参照する素質
				SIF CSVTALENT(NO:ARG , LOCAL:1 , 0)
					LOCALS += "," + TALENTNAME:(LOCAL:1)
			CASEELSE
				;CSVを参照する素質
				SIF TALENT:ARG:(LOCAL:1)
					LOCALS += "," + TALENTNAME:(LOCAL:1)
		ENDSELECT
	NEXT
	LOCAL = STRFLAG_NUM_CPD_FIND("NO",NO:ARG)
	IF ARGS == "ADD"
		SIF LOCAL == -1
			LOCAL = STRFLAG_NUM_CPD_FIND("",-1)
		SAVESTR:LOCAL = %NAME:ARG%,%LOCALS%
	ELSE
		IF CSVCFLAG(NO:ARG,(GETNUM(CFLAG,"전서소환불가")),0) == 1 || (CSVCFLAG(NO:ARG,(GETNUM(CFLAG,"합체조건있음")),0) == 1 && REMOVED_FUSION_LIMIT:(NO:ARG) == 0) || ABL:ARG:종족 > 18
			文字色変更 = 0
		ELSEIF LOCAL == -1
			文字色変更 = 0x00FFFF
		ELSEIF BASE:ARG:ＥＸＰ < TOINT(GET_CPD_SAVESTR_NUM(LOCAL,"ＥＸＰ"))
			文字色変更 = 0xDC143C
		ELSEIF LOCALS != SUBSTRING(SAVESTR:LOCAL,(STRFIND(SAVESTR:LOCAL,",")+1),-1)
			文字色変更 = 0x00FFFF
		;---- EDIT 004 ADD START -------------------------
		ELSE
			文字色変更 = 0
		;---- EDIT 004 ADD END ---------------------------
		ENDIF
	ENDIF
ELSEIF ARGS == "REFER"
	LOCAL = STRFLAG_NUM_CPD_FIND("NO",NO:ARG)
	SIF LOCAL == -1
		RETURN
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	SPLIT SAVESTR:LOCAL, ",", LOCALS
	VARS L_PROP
	VARI L_SKILL
	FOR LOCAL:1,2,LOCAL:5
		L_PROP '= GET_CPD_STRFLAG(LOCAL:1)
		IF GETNUM(ABL,L_PROP) > 0
			IF STRFIND(L_PROP, "습득스킬") >= 0
				CALL PUSH_ARRAY_STR, L_LEARN, LOCALS:(LOCAL:1)
			ELSEIF STRFIND(L_PROP, "습득LV") >= 0
				CALL PUSH_ARRAY_INT, L_LEARN_LV, TOINT(LOCALS:(LOCAL:1))
			ELSEIF STRFIND(L_PROP, "스킬") >= 0
				IF ISNUMERIC(LOCALS:(LOCAL:1))
					CALL GETS_SKILL_PROP, "SKILL_NAME", LOCALS:(LOCAL:1), -1
					IF RESULTS != ""
						ABL:ARG:L_PROP = TOINT(LOCALS:(LOCAL:1))
					ELSE
						ABL:ARG:L_PROP = 0
					ENDIF
				ELSEIF SKILL_NUM_F(LOCALS:(LOCAL:1)) >= 0
					CALL SET_SKILL, ARG, LOCALS:(LOCAL:1)
				ELSE
					CALL GETS_SKILL_PROP, "SKILL_NAME", LOCALS:(LOCAL:1), -1
					IF RESULTS != ""
						CALL SET_SKILL, ARG, LOCALS:(LOCAL:1)
					ELSE
						ABL:ARG:L_PROP = 0
					ENDIF
				ENDIF
			ELSE
				ABL:ARG:L_PROP = TOINT(LOCALS:(LOCAL:1))
			ENDIF
		ELSEIF GETNUM(BASE,L_PROP) > 0
			BASE:ARG:L_PROP = TOINT(LOCALS:(LOCAL:1))
		ELSEIF GETNUM(CFLAG,L_PROP) > 0
			CFLAG:ARG:L_PROP = TOINT(LOCALS:(LOCAL:1))
		ELSE
			THROW "想定外の動作が発生しました。{LOCAL:5}"
		ENDIF
	NEXT
	
	FOR LOCAL:1, 0, 20
		IF L_LEARN:(LOCAL:1) == "0"
			CONTINUE
		ELSEIF ISNUMERIC(L_LEARN:(LOCAL:1))
			CALL GETS_SKILL_PROP, "SKILL_NAME", L_LEARN:(LOCAL:1), -1
			SIF RESULTS == ""
				CONTINUE
			CALL SET_LEARN_SKILL, ARG, L_LEARN:(LOCAL:1), L_LEARN_LV:(LOCAL:1)
		ELSE
			IF SKILL_NUM_F(L_LEARN:(LOCAL:1)) >= 0
				CALL SET_LEARN_SKILL, ARG, L_LEARN:(LOCAL:1), L_LEARN_LV:(LOCAL:1)
			ELSE
				CALL GETS_SKILL_PROP, "SKILL_NAME", L_LEARN:(LOCAL:1), -1
				IF RESULTS != ""
					CALL SET_LEARN_SKILL, ARG, "CSTR専用スキル/" + L_LEARN:(LOCAL:1), L_LEARN_LV:(LOCAL:1)
				ELSE
					ABL:ARG:L_PROP = 0
				ENDIF
			ENDIF
		ENDIF
	NEXT
	;素質
	FOR LOCAL:1 , 0 , 159
		IF TALENTNAME:(LOCAL:1) != "" && +MATCH(LOCALS , TALENTNAME:(LOCAL:1))
			TALENT:ARG:(LOCAL:1) = 1
		ELSE
			TALENT:ARG:(LOCAL:1) = 0
		ENDIF
	NEXT
ENDIF

RETURN


@STRFLAG_NUM_CPD_FIND(ARGS,ARG)
#FUNCTION
#LOCALSSIZE 500
;ARGSがARGなSAVESTRを探し、そのSAVESTR番号を返す
;ARGが-1なら、空のSAVESTR番号で一番小さい番号を返す
FOR LOCAL,2000,7000
	IF SAVESTR:LOCAL == ""
		SIF ARG == -1
			RETURNF LOCAL
		RETURNF -1
	ENDIF
	SPLIT SAVESTR:LOCAL, ",", LOCALS
	SIF ARGS != "" && TOINT(LOCALS:(GET_CPD_STRFLAG_NUM(ARGS))) == ARG
		RETURNF LOCAL
NEXT

RETURNF -2

