;================================================================
;精霊合体検索
;================================================================

@RESULT_ELEMENT_FUSION, L_DEVIL, L_ELEMENT, L_CONVERTER, IS_MALE
#DIM DYNAMIC L_DEVIL
#DIM DYNAMIC L_ELEMENT
#DIM DYNAMIC L_CONVERTER
#DIM DYNAMIC IS_MALE
#DIM DYNAMIC L_RACE
#DIM DYNAMIC L_LV
#DIM DYNAMIC L_VECTOR
;引数：悪魔番号、精霊の悪魔番号
;戻り値：合体結果

;種族の取得
L_RACE = CSVABL(L_DEVIL,GETNUM(ABL,"종족"),0)

;性別指定種族は常に女性テーブルを使う
SIF GROUPMATCH(GET_RACE(L_RACE), "여신", "지모신", "귀신", "마신")
	IS_MALE = 0

;変化の方向を定義
SELECTCASE GET_RACE(L_RACE)
	CASE "지모신","여신","요마","요귀","용왕","귀신","마신"
		L_VECTOR = 1
	CASE "마왕","천사","요정","마수","요조","외도","사신","타천사"
		L_VECTOR = -1
	;精霊合体非対応種族
	CASEELSE
		RETURN 0
ENDSELECT
SELECTCASE L_ELEMENT
	;ウンディーネorサラマンダー
	CASE [[キャラ:운디네]], [[キャラ:뷔디네]],[[キャラ:살라만더]]
		L_VECTOR = L_VECTOR
	;シルフorノーム
	CASE [[キャラ:실프]], [[キャラ:놈]]
		L_VECTOR *= -1
	;精霊合体非対応精霊
	CASEELSE
		RETURN 0
ENDSELECT

L_LV = CSVBASE(L_DEVIL, GETNUM(BASE, "LV"),0)
IF IS_MALE
	WHILE INRANGE(L_LV, 1, 98)
		L_LV += L_VECTOR
		SIF FUSION_RACE_LIST_MALE:L_CONVERTER:L_RACE:L_LV > 0
			RETURN FUSION_RACE_LIST_MALE:L_CONVERTER:L_RACE:L_LV, L_VECTOR
	WEND
ELSE
	WHILE INRANGE(L_LV, 1, 98)
		L_LV += L_VECTOR
		SIF FUSION_RACE_LIST_FEMALE:L_CONVERTER:L_RACE:L_LV > 0
			RETURN FUSION_RACE_LIST_FEMALE:L_CONVERTER:L_RACE:L_LV, L_VECTOR
	WEND
ENDIF
RETURN 0

;================================================================
;合体事故
;================================================================
@FUSION_ACCIDENT,ARG,ARG:1,ARG:2,ARG:3 = -1,L_SUCCESS_LIST
#LOCALSIZE 5
#DIM カウント , 1
#DIM 作成種族 , 1
#DIM REF L_SUCCESS_LIST
#DIM DYNAMIC LCOUNT, 2
LOCAL:4 = 0
FOR カウント , 0 , 10
	;種族を決定
	$LOOP_RACE
	LOCAL:1 = RAND(1,19)
	;一部の種族を除外
	SIF GROUPMATCH(LOCAL:1 , 12 , 14)
		GOTO LOOP_RACE
	;神族・鬼神族の調整
	SIF GROUPMATCH(LOCAL:1 , 15 , 16) && TALENT:ARG:남자 == 0
		LOCAL:1 -= 14
	SIF GROUPMATCH(LOCAL:1 , 1 , 2) && TALENT:ARG:남자
		LOCAL:1 += 14
	;種族リスト作成
	CALL MAKE_RACE_LIST,LOCAL:1,TALENT:ARG:남자
	LOCAL:2 = D:LIMIT(RAND:21 + CSVBASE(NO:ARG , GETNUM(BASE,"LV") , 0) -15 , 1 , VARSIZE("D"))
	;事故結果の悪魔が合体素材悪魔と異なり、仲魔(未契約かつＣＯＭＰに居る)でない
	IF LOCAL:2 > 0 && NO:ARG != LOCAL:2 && (FINDCHARA_NO_C(LOCAL:2) == -1 || FLAG:SHOP커맨드 == [[ショップ:사교의관]])
		作成種族 = LOCAL:2
		SIF FINDCHARA_NO_C(LOCAL:2) > -1
			LOCAL:4 = 1
		BREAK
	ELSEIF カウント == 9
		作成種族 = [[キャラ:슬라임]]
	ENDIF
NEXT
LOCAL:3 = TALENT:ARG:남자
;作られるはずだったキャラを削除
CALL キャラ削除,ARG
;合体結果の悪魔をキャラ登録
IF ARG:3 < 1
	CALL ADD_NEW_COMPANION,作成種族,MAX(100 , (GET_CHARA_LOYALTY((ARG:1)) + GET_CHARA_LOYALTY((ARG:2)))/2), -1
ELSE
	CALL ADD_NEW_COMPANION,作成種族,MAX(100 , (GET_CHARA_LOYALTY((ARG:1)) + GET_CHARA_LOYALTY((ARG:2)) + GET_CHARA_LOYALTY((ARG:3)))/3), -1
ENDIF

;女体化処理
IF LOCAL:3 == 0 && 作成種族 == [[キャラ:슬라임]]
	TALENT:ARG:남자 = 0
	TALENT:ARG:팔 = 1
	TALENT:ARG:발 = 1
	TALENT:ARG:후타나리 = 1
ENDIF
;スキル継承
VARI L_SKILL
;選んでいたスキルをいれられるだけいれる
FOR LCOUNT, 1, CHARA_SKILLCOUNT(ARG)+1
	SIF ABL:ARG:@"스킬{LCOUNT}" > 0
		CONTINUE
	FOR LCOUNT:1, 0, VARSIZE("L_SUCCESS_LIST")
		SIF L_SUCCESS_LIST:(LCOUNT:1) == 0
			BREAK
		CALL GET_REPLACE_SKILL, L_SUCCESS_LIST:(LCOUNT:1), ARG
		L_SKILL = RESULT
		CALL IS_SUCCESSABLE_FUSION_SKILL, ARG, L_SKILL
		SIF !RESULT
			CONTINUE
		SIF MATCH(ABL:ARG:0, L_SKILL, GETNUM(ABL, "스킬1"), GETNUM(ABL, "스킬1") + CHARA_SKILLCOUNT(ARG))
			CONTINUE
		ABL:ARG:@"스킬{LCOUNT}" = L_SKILL
		BREAK
	NEXT
NEXT
;邪教の館扱いで素質継承
CALL FUSION_SUCCESS_BASE,ARG,ARG:1,ARG:2,ARG:3,1
SIF LOCAL:4 
	CFLAG:ARG:소속ＣＯＭＰ = -1
CALL SYNC_STATUS,ARG
RETURN 1



