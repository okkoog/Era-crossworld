;イケニエ合体用処理を記述したファイルです


@FUSION_SACRIFICE
#DIM DYNAMIC LCOUNT, 2
#DIMS DYNAMIC L_MESSAGE
#DIMS DYNAMIC ADDABLE_BTL_TALENT
#DIMS DYNAMIC TEMPS
#DIMS DYNAMIC L_BTL_TALENT
#DIMS DYNAMIC L_TALENT
#DIM DYNAMIC L_TALENT_LV
#DIMS CONST CHANGE_TABLE = "調教素質", "継承素質", "戦闘素質", "공격상성", "防御相性", "각성스킬"
#DIM CONST CHANGE_COST =			0,		10, 		10,			10, 		30, 		30
#DIM DYNAMIC IS_CHANGE_ABLE, 6
#DIM DYNAMIC L_LINE, 3
#DIM DYNAMIC SELECT_CHANGE
#DIMS DYNAMIC SHOWLINE, 2, 26
#DIM DYNAMIC LINENUM
#DIM DYNAMIC STOCK_CHARA
#DIM DYNAMIC STOCK_LOYALTY
#DIM DYNAMIC STOCK_REDRAW
#DIM DYNAMIC ADD_EXP
#DIM DYNAMIC ADD_MAG
;FLAG:合体素材悪魔1、FLAG:합체소재악마2　契約済みの造魔以外の悪魔、素材の登録番号
FLAG:합체소재악마1 = -1
FLAG:합체소재악마2 = -1
STOCK_REDRAW = CURRENTREDRAW()
REDRAW 0
$START_FUSION
;IF FLAG:합체소재악마1 > -1
;	CALL INPUT_CHARA_LIST("生贄に捧げる悪魔を選んでください", "CASTING_FUSION_SACRIFICE", "", "UP_PRINT_FUSION_SACRIFICE")
;ELSE
;	CALL INPUT_CHARA_LIST("生贄を与える悪魔を選んでください", "CASTING_FUSION_SACRIFICE", "", "UP_PRINT_FUSION_SACRIFICE")
;ENDIF
IF FLAG:합체소재악마1 > -1
	L_MESSAGE = 生贄に捧げる悪魔を選んでください
ELSE
	L_MESSAGE = 生贄を与える悪魔を選んでください
ENDIF
{
CALL INPUT_CHARA_LIST
	, "PROPSET_FUSION"
	, L_MESSAGE
	, "CASTING_FUSION_SACRIFICE" 
	, "UP_PRINT_FUSION_SACRIFICE"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
IF RESULT == 1000
	IF FLAG:합체소재악마1 > -1
		FLAG:합체소재악마1 = -1
		GOTO START_FUSION
	ELSE
		RETURN 0
	ENDIF
ENDIF

IF FLAG:합체소재악마1 > 0
	FLAG:합체소재악마2 = RESULT
	
	;取得する経験値を計算
	;LOCAL:4 = CFLAG:(FLAG:합체소재악마2):초기LV
	;ADD_EXP = BASE:(FLAG:합체소재악마2):ＥＸＰ - 5*(LOCAL:4-1)*(LOCAL:4+1)*(LOCAL:4)/3
	ADD_EXP = TOTAL_TAKE_EXP:(FLAG:합체소재악마2):0
	;香で強化されている場合経験値にボーナス
	ADD_EXP += MAX(0, BASE:(FLAG:합체소재악마2):힘 + BASE:(FLAG:합체소재악마2):지혜 + BASE:(FLAG:합체소재악마2):마력 + BASE:(FLAG:합체소재악마2):내구 + BASE:(FLAG:합체소재악마2):속도 + BASE:(FLAG:합체소재악마2):운 - 18 - MAXBASE:(FLAG:합체소재악마2):LV * 3 / 2) * 100
	SIF BASE:(FLAG:합체소재악마1):LV > CFLAG:(FLAG:합체소재악마2):초기LV
		ADD_EXP /= (BASE:(FLAG:합체소재악마1):LV - CFLAG:(FLAG:합체소재악마2):초기LV)/4+1
	SIF BASE:(FLAG:합체소재악마1):LV < CFLAG:(FLAG:합체소재악마2):초기LV
		ADD_EXP *= POWER(2, MIN((CFLAG:(FLAG:합체소재악마2):초기LV - BASE:(FLAG:합체소재악마1):LV)/4,4))
	TIMES ADD_EXP , 0.70
	ADD_EXP = LIMIT(ADD_EXP, 0, BASE:MASTER:ＥＸＰ)
	;取得するＭＡＧを記録
	ADD_MAG = GET_CHARA_STOCK_MAG(FLAG:합체소재악마2) + HIDDEN_MAG:(FLAG:합체소재악마2):0
	ADDABLE_BTL_TALENT =
	IF  CSTR:(FLAG:합체소재악마2):잠재전투소질 != ""
		FOR LCOUNT, 0, STRCOUNT(CSTR:(FLAG:합체소재악마2):잠재전투소질, "/") + 1
			TEMPS = %AUTO_SPLIT(CSTR:(FLAG:합체소재악마2):잠재전투소질, "/", LCOUNT)%
			L_TALENT = %AUTO_SPLIT(TEMPS, "_", 0)%
			;顕在化してるレベルまでしかみない
			L_TALENT_LV = MIN(TOINT(AUTO_SPLIT(TEMPS, "_", 1)), TALENT:(FLAG:합체소재악마2):L_TALENT)
			SIF TALENT:(FLAG:합체소재악마1):L_TALENT >= L_TALENT_LV
				CONTINUE
			ADDABLE_BTL_TALENT = %ADD_SPLIT(ADDABLE_BTL_TALENT, "/", TEMPS)%
		NEXT
	ENDIF

	ADDCOPYCHARA FLAG:합체소재악마1
	STOCK_CHARA = CHARANUM - 1
	STOCK_LOYALTY = GET_CHARA_LOYALTY((FLAG:합체소재악마2))
	L_LINE = LINECOUNT
	WHILE 1
		CLEARLINE LINECOUNT - L_LINE
		DRAWLINE
		PRINTFORML 제물 합체
		DRAWLINE
		VARSET SHOWLINE
		LINENUM = 0
		SHOWLINE:0:LINENUM = %CALLNAME:(FLAG:합체소재악마1)% Lv:{BASE:(FLAG:합체소재악마1):LV}
		SHOWLINE:1:LINENUM = %CALLNAME:(FLAG:합체소재악마2)% Lv:{BASE:(FLAG:합체소재악마2):LV}
		LINENUM += 2
		IS_CHANGE_ABLE:FINDELEMENT(CHANGE_TABLE, "調教素質") = 1

		SHOWLINE:0:LINENUM = □継承素質
		SHOWLINE:1:LINENUM = □継承素質
		LINENUM += 1

		IS_CHANGE_ABLE:FINDELEMENT(CHANGE_TABLE, "継承素質") = 0
		FOR LCOUNT, 0, SUCCESSIONNUM
			FOR LCOUNT:1, 0, 2
				IF LCOUNT % 7
					SHOWLINE:(LCOUNT:1):(LCOUNT / 7 + LINENUM) += " "
				ELSE
					SHOWLINE:(LCOUNT:1):(LCOUNT / 7 + LINENUM) += "　"
				ENDIF
				SHOWLINE:(LCOUNT:1):(LCOUNT / 7 + LINENUM) += SET_COLOR_TAG(GET_SUCCESSION(LCOUNT), \@TALENT:(FLAG:@"합체소재악마{LCOUNT:1 + 1}"):GET_SUCCESSION(LCOUNT) > 0 ? p-green # gray\@)
			NEXT
			SIF TALENT:(FLAG:합체소재악마1):GET_SUCCESSION(LCOUNT) != TALENT:(FLAG:합체소재악마2):GET_SUCCESSION(LCOUNT)
				IS_CHANGE_ABLE:FINDELEMENT(CHANGE_TABLE, "継承素質") = 1
		NEXT
		SIF GET_LOYALTY_POINT() < CHANGE_COST:FINDELEMENT(CHANGE_TABLE, "継承素質")
			IS_CHANGE_ABLE:FINDELEMENT(CHANGE_TABLE, "継承素質") = 0
		LINENUM += 4

		IF ADDABLE_BTL_TALENT != "" && GET_LOYALTY_POINT() >= CHANGE_COST:FINDELEMENT(CHANGE_TABLE, "戦闘素質")
			IS_CHANGE_ABLE:FINDELEMENT(CHANGE_TABLE, "戦闘素質") = 1
		ELSE
			IS_CHANGE_ABLE:FINDELEMENT(CHANGE_TABLE, "戦闘素質") = 0
		ENDIF

		SHOWLINE:0:LINENUM = □공격상성
		SHOWLINE:1:LINENUM = □공격상성
		LINENUM += 1
		IF ABL:(FLAG:합체소재악마1):공격상성 != ABL:(FLAG:합체소재악마2):공격상성 && GET_LOYALTY_POINT() >= CHANGE_COST:FINDELEMENT(CHANGE_TABLE, "공격상성")
			IS_CHANGE_ABLE:FINDELEMENT(CHANGE_TABLE, "공격상성") = 1
		ELSE
			IS_CHANGE_ABLE:FINDELEMENT(CHANGE_TABLE, "공격상성") = 0
		ENDIF
		FOR LCOUNT:1, 0, 2
			SHOWLINE:(LCOUNT:1):LINENUM += "　" + GET_TYPE(ABL:(FLAG:@"합체소재악마{LCOUNT:1 + 1}"):공격상성)
		NEXT
		LINENUM += 2

		SHOWLINE:0:LINENUM = □防御相性
		SHOWLINE:1:LINENUM = □防御相性
		LINENUM += 1
		IS_CHANGE_ABLE:FINDELEMENT(CHANGE_TABLE, "防御相性") = 0
		FOR LCOUNT, 0, TYPENUM
			FOR LCOUNT:1, 0, 2
				IF LCOUNT % 3
					SHOWLINE:(LCOUNT:1):(LCOUNT / 3 + LINENUM) += "　　"
				ELSE
					SHOWLINE:(LCOUNT:1):(LCOUNT / 3 + LINENUM) += "　"
				ENDIF
				SHOWLINE:(LCOUNT:1):(LCOUNT / 3 + LINENUM) += GET_TYPE(LCOUNT) + " " +GET_STR_OF_DEFTYPE_FOR_HTML(BASE:(FLAG:@"합체소재악마{LCOUNT:1 + 1}"):GET_TYPE(LCOUNT))
			NEXT
			SIF BASE:(FLAG:합체소재악마1):GET_TYPE(LCOUNT) != BASE:(FLAG:합체소재악마2):GET_TYPE(LCOUNT)
				IS_CHANGE_ABLE:FINDELEMENT(CHANGE_TABLE, "防御相性") = 1
		NEXT
		SIF GET_LOYALTY_POINT() < CHANGE_COST:FINDELEMENT(CHANGE_TABLE, "防御相性")
			IS_CHANGE_ABLE:FINDELEMENT(CHANGE_TABLE, "防御相性") = 0
		LINENUM += 7

		SHOWLINE:0:LINENUM = □각성스킬
		SHOWLINE:1:LINENUM = □각성스킬
		LINENUM += 1

		IF HAVE_SKILL(FLAG:합체소재악마2, SKILL_NUM_F("각성스킬")) && (ABL:(FLAG:합체소재악마1):각성스킬 != ABL:(FLAG:합체소재악마2):각성스킬) && GET_LOYALTY_POINT() >= CHANGE_COST:FINDELEMENT(CHANGE_TABLE, "각성스킬")
			IS_CHANGE_ABLE:FINDELEMENT(CHANGE_TABLE, "각성스킬") = 1
		ELSE
			IS_CHANGE_ABLE:FINDELEMENT(CHANGE_TABLE, "각성스킬") = 0
		ENDIF

		FOR LCOUNT:1, 0, 2
			IF HAVE_SKILL(FLAG:@"합체소재악마{LCOUNT:1+1}", SKILL_NUM_F("각성스킬"))
				CALLFORM SKILL_NAME_AW_{ABL:(FLAG:@"합체소재악마{LCOUNT:1+1}"):각성스킬}, FLAG:@"합체소재악마{LCOUNT:1+1}"
				SHOWLINE:(LCOUNT:1):LINENUM += "　" + RESULTS
			ELSE
				SHOWLINE:(LCOUNT:1):LINENUM += "　" + "未習得"
			ENDIF
		NEXT
		LINENUM += 2
		FOR LCOUNT:1, 0, VARSIZE("SHOWLINE", 1)
			{
			HTML_PRINT SHOWLINE:0:(LCOUNT:1)
						+ ((LINELENS() / 2 - 2) - STRLENS(HTML_TOPLAINTEXT(SHOWLINE:0:(LCOUNT:1)))) * " "
						+ "│"
						+ SHOWLINE:1:(LCOUNT:1)
			}
		NEXT
		CUSTOMDRAWLINE =
		L_LINE:1 = LINECOUNT
		PRINTFORML %CALLNAME:(FLAG:합체소재악마1)% LV{MAXBASE:(FLAG:합체소재악마1):LV}({BASE:(FLAG:합체소재악마1):LV})
		PRINTFORML 　　　　ＥＸＰ　 　　　:＋{ADD_EXP}
		PRINTFORML 　　　　ＭＡＧ　 　　　:＋{ADD_MAG}
		PRINTFORML 　　　　충성 포인트　 :{GET_LOYALTY_POINT()}
		CUSTOMDRAWLINE =
		PRINTFORML [0] 결정
		FOR LCOUNT, 0, VARSIZE("CHANGE_TABLE")
			IF IS_CHANGE_ABLE:LCOUNT
				RESETCOLOR
			ELSE
				SETCOLOR COLOR("gray")
			ENDIF
			PRINTFORM [{LCOUNT + 1}] %CHANGE_TABLE:LCOUNT% 변경
			IF CHANGE_TABLE:LCOUNT != "調教素質"
				PRINTFORM (필요 포인트:{CHANGE_COST:LCOUNT})
			ENDIF
			PRINTL 
		NEXT
		RESETCOLOR
		PRINTFORML [8] 리셋
		PRINTFORML [9] 취소
		L_LINE:2 = LINECOUNT
		ONEINPUT
		SIF RESULT == 0
			BREAK
		IF INRANGE(RESULT, 1, VARSIZE("CHANGE_TABLE") + 1) && IS_CHANGE_ABLE:(RESULT - 1)
			SELECT_CHANGE = RESULT - 1
			CLEARLINE LINECOUNT - L_LINE:1
			SELECTCASE CHANGE_TABLE:SELECT_CHANGE
				CASE "調教素質"
					;忠誠度による素質変更後、忠誠度を加算する
					CALL MAKE_TALENT, FLAG:합체소재악마1, GET_LOYALTY_POINT()
					CALL DECREASE_LOYALTY_POINT, RESULT
					;GET_CHARA_LOYALTY((FLAG:합체소재악마2)) =  MIN(GET_CHARA_LOYALTY((FLAG:합체소재악마2)), RESULT)
					;GET_CHARA_LOYALTY((FLAG:합체소재악마1)) += MIN(GET_CHARA_LOYALTY((FLAG:합체소재악마2)), RESULT)
				CASE "継承素質"
					PRINTL 계승 소질을 변경했습니다.
					CALL DECREASE_LOYALTY_POINT, CHANGE_COST:SELECT_CHANGE
					FOR LCOUNT, 0, SUCCESSIONNUM
						TALENT:(FLAG:합체소재악마1):GET_SUCCESSION(LCOUNT) = TALENT:(FLAG:합체소재악마2):GET_SUCCESSION(LCOUNT)
					NEXT
				CASE "戦闘素質"
					PRINTL 전투 소질을 변경했습니다.
					;戦闘素質の継承処理
					CALL DECREASE_LOYALTY_POINT, CHANGE_COST:SELECT_CHANGE
					;イケニエ合体では潜在素質への追加は行わない
					FOR LCOUNT, 0, STRCOUNT(ADDABLE_BTL_TALENT, "/") + 1
						TEMPS = %AUTO_SPLIT(ADDABLE_BTL_TALENT, "/", LCOUNT)%
						L_TALENT = %AUTO_SPLIT(TEMPS, "_", 0)%
						L_TALENT_LV = TOINT(AUTO_SPLIT(TEMPS, "_", 1))
						TALENT:(FLAG:합체소재악마1):L_TALENT = L_TALENT_LV
					NEXT
					CALL SET_ROLE_CP, FLAG:합체소재악마1
					IF GET_ROLE_CP(FLAG:합체소재악마1, "通常形態") < 0
						DRAWLINE
						PRINTFORML %CALLNAME:(FLAG:합체소재악마1)%의 소질 코스트가 수용량의 상한을 초과했습니다.
						PRINTFORMW 남길 소질을 선택해주세요.
						DRAWLINE
						CALL SET_VAR_HAVE_SUB_ROLE, FLAG:합체소재악마1, "通常形態", L_BTL_TALENT
						;サブ素質を設定
						CALL ENHANCE_ROLE, FLAG:합체소재악마1, "通常形態", L_BTL_TALENT, , "戻る不可"
					ENDIF
				CASE "공격상성"
					PRINTL 통상 공격의 상성을 변경했습니다.
					CALL DECREASE_LOYALTY_POINT, CHANGE_COST:SELECT_CHANGE
					FOR LCOUNT, 0, TYPENUM
						ABL:(FLAG:합체소재악마1):공격상성 = ABL:(FLAG:합체소재악마2):공격상성
					NEXT
				CASE "防御相性"
					PRINTL 방어 상성을 변경했습니다.
					CALL DECREASE_LOYALTY_POINT, CHANGE_COST:SELECT_CHANGE
					FOR LCOUNT, 0, TYPENUM
						BASE:(FLAG:합체소재악마1):GET_TYPE(LCOUNT) = BASE:(FLAG:합체소재악마2):GET_TYPE(LCOUNT)
					NEXT
				CASE "각성스킬"
					CALL DECREASE_LOYALTY_POINT, CHANGE_COST:SELECT_CHANGE
					IF HAVE_SKILL(FLAG:합체소재악마1, SKILL_NUM_F("각성스킬")) && ABL:(FLAG:합체소재악마1):각성스킬
						CALLFORM SKILL_NAME_AW_{ABL:(FLAG:합체소재악마1):각성스킬}, FLAG:합체소재악마1
						PRINTFORM %CALLNAME:(FLAG:합체소재악마1)%은(는) 【%RESULTS%】을(를) 잊고,
						CALLFORM SKILL_NAME_AW_{ABL:(FLAG:합체소재악마2):각성스킬}, FLAG:합체소재악마1
						PRINTFORML 【%RESULTS%】을(를) 습득했다.
						ABL:(FLAG:합체소재악마1):각성스킬 = ABL:(FLAG:합체소재악마2):각성스킬
					ELSE
						ABL:(FLAG:합체소재악마1):각성스킬 = ABL:(FLAG:합체소재악마2):각성스킬
						PRINTFORML %CALLNAME:(FLAG:합체소재악마1)%은(는) 새로운 스킬에 각성했다!
						CALL LEARN_SKILL, FLAG:합체소재악마1, SKILL_NUM_F("각성스킬")
					ENDIF
			ENDSELECT
			IF LINECOUNT != L_LINE:1
				WHILE LINECOUNT < L_LINE:2
					PRINTL
				WEND
				WAIT
			ENDIF
		ELSE
			IF RESULT == 8 || RESULT == 9
				COPYCHARA STOCK_CHARA, FLAG:합체소재악마1
				STOCK_CHARA = CHARANUM - 1
				BASE:(FLAG:합체소재악마2):충성도 = STOCK_LOYALTY
				IF RESULT == 9
					REDRAW STOCK_REDRAW
					DELCHARA STOCK_CHARA
					RESTART
				ENDIF
			ENDIF
		ENDIF
	WEND
	DELCHARA STOCK_CHARA

	;経験値加算
	BASE:(FLAG:합체소재악마1):ＥＸＰ += ADD_EXP
	CALL CHECK_LEVEL_UP, FLAG:합체소재악마1
	;ＭＡＧ加算
	
	CALL CONTROL_MAG, FLAG:합체소재악마1, ADD_MAG

	;手紙システム
	CALL FUSION_LETTER, FLAG:합체소재악마2,6
	
	;合体素材の悪魔を消去
	CALL キャラ削除, FLAG:합체소재악마2

	FLAG:합체소재악마1 = -1
	FLAG:합체소재악마2 = -1
	REDRAW STOCK_REDRAW
	RETURN 0
ELSE
	FLAG:합체소재악마1 = RESULT
ENDIF

GOTO START_FUSION

@CASTING_FUSION_SACRIFICE(ARG)
;素材は契約済みで無い、造魔以外の悪魔に限る
IF FLAG:합체소재악마1 > -1 
	SIF 계약(ARG) > 0
		RETURN 0
	SIF CFLAG:ARG:합체소재사용금지
		RETURN 0
ELSE
	SIF !계약(ARG)
		RETURN 0
ENDIF
;マスターはダメ
SIF ARG == MASTER
	RETURN 0
;合体が対応するロールであること
SIF !GET_ROLE_PROP("CAN_FUSION", ARG)
	RETURN 0
;造魔はレベル方式が違うので使えない
SIF GET_RACE(ABL:ARG:종족) == "조마"
	RETURN 0
SIF ARG == FLAG:합체소재악마1 || ARG == FLAG:합체소재악마2
	RETURN 0
SIF IS_RENTING(ARG)
	RETURN 0
SIF CFLAG:ARG:이자리에없는플래그 == 1
	RETURN 0
RETURN 1

@UP_PRINT_FUSION_SACRIFICE
SIF FLAG:합체소재악마1 > -1
	PRINTFORML 선택 악마:%CALLNAME:(FLAG:합체소재악마1)%
;これ表示する場面も必要もないよね？
;SIF FLAG:합체소재악마2 > -1
;	PRINTFORML 生贄:%CALLNAME:(FLAG:합체소재악마2)%

@GET_LOYALTY_POINT
#FUNCTION
RETURNF GET_CHARA_LOYALTY((FLAG:합체소재악마2)) / 200

@GET_LOYALTY_POINT_MAKE_ZOUMA, L_SOZAI
#FUNCTION
#DIM DYNAMIC L_SOZAI
RETURNF GET_CHARA_LOYALTY(L_SOZAI) * 3 / 200

@DECREASE_LOYALTY_POINT, ARG
CALL CONTROL_LOYALTY, (FLAG:합체소재악마2), -ARG * 200


