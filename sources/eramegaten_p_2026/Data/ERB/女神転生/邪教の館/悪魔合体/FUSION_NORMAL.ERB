@SET_VAR_INFO_DATA_FUSIONSPACE_HEADER
INFO_HEADER += " " * 6

@GET_VAR_INFO_DATA_FUSIONSPACE, ARG
RESULTS '= " " * 6

@INPUT_FUSION_LIST
#DIM DYNAMIC LCOUNT,2
#DIM DYNAMIC LINENUM
#DIM DYNAMIC LISTNUM
#DIM DYNAMIC LISTMAXNUM
#DIMS DYNAMIC L_TITLE
#DIMS DYNAMIC SHOW_LINE
#DIM DYNAMIC L_PAGE
#DIM DYNAMIC L_SELECT_DEVIL
#DIM DYNAMIC FUSION_NO
#DIM DYNAMIC FUSION_LV
#DIM DYNAMIC FUSION_LOYALTY
#DIM DYNAMIC IS_SPECIAL_FUSION
#DIM DYNAMIC IS_ELEMENTAL_FUSION
#DIMS DYNAMIC L_COLOR
#DIM DYNAMIC L_START_LINE
LISTMAXNUM = (FUSION_RESULT_LISTCOUNT - 1) / リスト表示数()
L_START_LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - L_START_LINE
DRAWLINE
PRINTFORM 합체시키고 싶은 악마를 선택해주세요　\@ FUSION_RESULT_LISTCOUNT > リスト表示数() ? ＜page.{L_PAGE + 1}/{LISTMAXNUM + 1}＞ # \@　%CALLNAME:MASTER% LV:{BASE:MASTER:LV,3} \@ FLAG:경험ED수 > 0 ? + 경험ED수:{FLAG:경험ED수,3} # \@
SIF FUSION_RESULT_LISTCOUNT == VARSIZE("FUSION_RESULT_LIST")
	CALL PRINT_COLOR, "　　　合体候補が多すぎまて表示しきれなくなっています！", COLOR("red")
PRINTL 
DRAWLINE
FOR LCOUNT, 0, リスト表示数()
	L_TITLE '= ""
	LISTNUM = LCOUNT + L_PAGE * リスト表示数()
	IF INRANGE(LISTNUM, 0, VARSIZE("FUSION_RESULT_LIST") - 1)
		IF FLAG:합체인수 == 2
			L_SELECT_DEVIL = FUSION_RESULT_LIST:LISTNUM:4
		ELSE
			L_SELECT_DEVIL = FUSION_RESULT_LIST:LISTNUM:5
		ENDIF
	ELSE
		L_SELECT_DEVIL = 0
	ENDIF
	IF L_SELECT_DEVIL > 0
		SHOW_LINE '= @"[{LISTNUM,3}]" + " "
		CALL GET_VAR_INFO_DATA_RACE, L_SELECT_DEVIL
		SHOW_LINE += RESULTS
		CALL GET_VAR_INFO_DATA_NAME, L_SELECT_DEVIL
		SHOW_LINE += RESULTS
		SHOW_LINE += "Lv" + @"{MIN(BASE:L_SELECT_DEVIL:LV), 3}"
		SHOW_LINE += "(" + TOALIGNMENT(TOSTR(MIN(CSVBASE(NO:L_SELECT_DEVIL, GETNUM(BASE, "LV")), 999)), 3, "RIGHT") + ")" + " "
		CALL GET_VAR_INFO_DATA_ALI, L_SELECT_DEVIL
		SHOW_LINE += RESULTS
		SHOW_LINE += " " * 6
		
		FUSION_NO = FUSION_RESULT_LIST:LISTNUM:0
		IF FUSION_NO > 0
			IS_SPECIAL_FUSION = FUSION_RESULT_LIST:LISTNUM:1
			IS_ELEMENTAL_FUSION = FUSION_RESULT_LIST:LISTNUM:2
			FUSION_LV = CSVBASE(FUSION_NO, GETNUM(BASE, "LV"))
			IF FLAG:합체인수 == 2
				FUSION_LOYALTY = (GET_CHARA_LOYALTY((FUSION_RESULT_LIST:LISTNUM:3)) + GET_CHARA_LOYALTY((FUSION_RESULT_LIST:LISTNUM:4))) / 2
			ELSE
				FUSION_LOYALTY = (GET_CHARA_LOYALTY((FUSION_RESULT_LIST:LISTNUM:3)) + GET_CHARA_LOYALTY((FUSION_RESULT_LIST:LISTNUM:4)) + GET_CHARA_LOYALTY((FUSION_RESULT_LIST:LISTNUM:5))) / 3
			ENDIF
			L_COLOR '= TOSTR_HTML(GETDEFCOLOR())
			
			IF SOFT_ON("스티븐") == 0
				;レベルは経験ED数分だけ緩和される
				VARI TEMP = FUSION_LV -(BASE:MASTER:LV + FLAG:경험ED수)
				;忠誠度による緩和はX^2 * 500の忠誠度が要求される
				SIF TEMP > 0 && FUSION_LOYALTY < POWER(TEMP , 2) * 500
					L_COLOR '= TOSTR_HTML(COLOR("gray"))
			ENDIF
			SIF IS_SPECIAL_FUSION
				L_COLOR '= TOSTR_HTML(COLOR("aqua"))

			IF IS_ELEMENTAL_FUSION == 1
				SHOW_LINE += SET_COLOR_TAG("↑", "0X66FFFF")
			ELSEIF IS_ELEMENTAL_FUSION == -1
				SHOW_LINE += SET_COLOR_TAG("↓", "0X990000")
			ELSE
				SHOW_LINE += SET_COLOR_TAG("：", L_COLOR)
			ENDIF
			VARS TEMPS
			IF STRLENS(CSV種族名(FUSION_NO,0)) > 8
				TEMPS '= SUBSTRING(CSV種族名(FUSION_NO,0), 0, 6) + ".."
				TEMPS '= TOALIGNMENT(TEMPS, 8, "CENTER")
			ELSE
				TEMPS '= TOALIGNMENT(CSV種族名(FUSION_NO,0), 8, "CENTER")
			ENDIF
			SHOW_LINE += SET_COLOR_TAG(TEMPS, L_COLOR) + " "

			SHOW_LINE += SET_COLOR_TAG(@"LV{FUSION_LV,2}", L_COLOR) + " "
			
			TEMPS '= SET_COLOR_TAG(SUBSTRING(GET_ALI1(CSVABL(FUSION_NO, GETNUM(ABL, "속성LD"))), 0, 1), TOSTR(ALICOLOR(CSVABL(FUSION_NO, GETNUM(ABL, "속성LD")))))
			TEMPS += "/"
			TEMPS += SET_COLOR_TAG(SUBSTRING(GET_ALI2(CSVABL(FUSION_NO, GETNUM(ABL, "속성LC"))), 0, 1), TOSTR(ALICOLOR(CSVABL(FUSION_NO, GETNUM(ABL, "속성LC")))))

			SHOW_LINE += TEMPS + " "

			;ハート用に1字削る
			IF SOFT_ON("크래프트다이어리") && GET_陥落履歴(FUSION_NO, "친애") && GET_陥落履歴(FUSION_NO, "창부") && GET_陥落履歴(FUSION_NO, "예속")
				TEMP = 18 - -1
			ELSE
				TEMP = 18
			ENDIF
			IF STRLENS(CSVCALLNAME(FUSION_NO,0)) <=  TEMP
				TEMPS = %CSVCALLNAME(FUSION_NO,0), TEMP, LEFT%
			ELSE
				TEMPS = %SUBSTRING(CSVCALLNAME(FUSION_NO,0), 0, TEMP - 2) + ".."%
			ENDIF
			SHOW_LINE += SET_COLOR_TAG(TEMPS, L_COLOR)

			IF SOFT_ON("크래프트다이어리") && GET_陥落履歴(FUSION_NO, "친애") && GET_陥落履歴(FUSION_NO, "창부") && GET_陥落履歴(FUSION_NO, "예속")
				SHOW_LINE += SET_COLOR_TAG(ハート(), "PINK")
			ENDIF
			SHOW_LINE += " "
			IF IS_CHARA_COMPANIONED:FUSION_NO 
				IF CMATCH(NO, FUSION_NO)
					TEMPS '= "소지중"
				ELSE
					TEMPS '= "가입완"
				ENDIF
			ELSE
				TEMPS '= "미가입"
				TEMPS '= SET_COLOR_TAG(TEMPS, "p-green")
			ENDIF
			SHOW_LINE += TEMPS
			L_TITLE = □%CSVCALLNAME(FUSION_NO)%
			L_TITLE += UNICODE(0x000D)
			VARI COUNT_SKILL
			VARI L_SKILL
			VARI COUNT_TEMP
			FOR COUNT_SKILL, 1, 21
				L_SKILL = CSVABL(FUSION_NO, GETNUM(ABL, @"스킬{COUNT_SKILL}"))
				SIF !L_SKILL
					CONTINUE
				CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, -1
				L_TITLE += @"[{COUNT_TEMP, 1}] %RESULTS, 18, LEFT%"
				SIF COUNT_TEMP % 4 == 3
					L_TITLE += UNICODE(0x000D)
				COUNT_TEMP++
			NEXT
			VARI L_CHARA
			FOR LCOUNT:1, 3, 6
				L_TITLE += UNICODE(0x000D)
				SIF COUNT_TEMP % 4 != 0
					L_TITLE += UNICODE(0x000D)
				COUNT_TEMP = 0
				L_CHARA = FUSION_RESULT_LIST:LISTNUM:(LCOUNT:1)
				SIF L_CHARA <= 0
					CONTINUE
				L_TITLE += "□" + CALLNAME:L_CHARA
				L_TITLE += UNICODE(0x000D)
				FOR COUNT_SKILL, 1, 21
					L_SKILL = ABL:L_CHARA:@"스킬{COUNT_SKILL}"
					SIF !L_SKILL
						CONTINUE
					CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, L_CHARA
					L_TITLE += @"[{COUNT_TEMP, 1}] %RESULTS, 18, LEFT%"
					SIF COUNT_TEMP % 4 == 3
						L_TITLE += UNICODE(0x000D)
					COUNT_TEMP++
				NEXT
			NEXT
		ELSE
			SHOW_LINE += "：×"
		ENDIF
	ELSE
		SHOW_LINE '= " "
	ENDIF

	SHOW_LINE '= SET_BUTTON_TAG(SHOW_LINE, TOSTR(LISTNUM), L_TITLE)
	HTML_PRINT SHOW_LINE
NEXT
