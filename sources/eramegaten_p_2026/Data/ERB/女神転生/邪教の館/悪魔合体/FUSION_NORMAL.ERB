;================================================================
;合体の悪魔を選択する際のポップアップ
;================================================================
@FUSION_CUSTOM_TITLE, ARG, ARGS
#DIMS L_RESULTS
#DIM LCOUNT
L_RESULTS = □소지스킬
L_RESULTS += UNICODE(0x000D)
FOR LCOUNT, 1, CHARA_SKILLCOUNT(ARG) + 1
	L_RESULTS += @"[{LCOUNT, 2}] " 
	IF ABL:ARG:@"스킬{LCOUNT}"
		CALL GET_SKILL_PROP, "SKILL_NAME", ABL:ARG:@"스킬{LCOUNT}", ARG
		L_RESULTS += RESULTS
	ELSE
		L_RESULTS += "EMPTY"
	ENDIF
	L_RESULTS += UNICODE(0x000D)
NEXT
RESULTS '= L_RESULTS
RETURN 0

;================================================================
;合体の悪魔を選択する際のポップアップ
;================================================================
@FUSION_MAIN_CUSTOM_TITLE, ARG, ARGS
#DIMS DYNAMIC L_RESULTS
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_SKILLNUM
#DIMS DYNAMIC L_SKILLNUMS
#DIM DYNAMIC CNT_HAVE_SKILL
IF ARGS == "FUSIONDEVIL"
	L_RESULTS = □소지스킬
	L_RESULTS += UNICODE(0x000D)
	FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
		L_SKILLNUM = CSVABL(FUSION_DEVIL_NO, GETNUM(ABL, @"스킬{LCOUNT}"))
		SIF !L_SKILLNUM
			CONTINUE
		IF IS_PU_SKILLNUM(L_SKILLNUM)
			L_SKILLNUMS '= CSVCSTR(FUSION_DEVIL_NO, GETNUM(CSTR, @"전용기{L_SKILLNUM - [[스킬:전용기1]] + 1}"))
		ELSE
			L_SKILLNUMS = {L_SKILLNUM}
		ENDIF
		RESULT = 0
		CALL GETS_SKILL_PROP, "敵専用", L_SKILLNUMS, -1
		SIF RESULT
			CONTINUE
		L_RESULTS += @"[{CNT_HAVE_SKILL+1, 2}] "
		CNT_HAVE_SKILL++
		CALL GETS_SKILL_PROP, "SKILL_NAME", L_SKILLNUMS, ARG
		L_RESULTS += RESULTS
		L_RESULTS += UNICODE(0x000D)
	NEXT
	RESULTS '= L_RESULTS
ELSE
	CALL FUSION_CUSTOM_TITLE, ARG, ARGS
ENDIF
RETURN 1

