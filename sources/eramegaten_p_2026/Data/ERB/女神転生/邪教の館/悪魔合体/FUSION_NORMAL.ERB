;================================================================
;２身合体
;================================================================
@FUSION_NORMAL, ARG = 2, ARG:1 = 0, ARG:2 = -1
;ARG:1 探索中フラグ、なおここが2なら悪魔合体ライトとする
;ARG:2 合体者。悪魔合体ライトで万が一自身を合体素材にするのを防ぐため。
#DIM DYNAMIC LLINE, 2
#DIM DYNAMIC LREDRAW
#DIM DYNAMIC LLOCK
#DIM DYNAMIC PCOUNT, 3
#DIM DYNAMIC SKILLCOLOR,1
#DIM DYNAMIC 素材 , 4
#DIM DYNAMIC 完成品 , 1
#DIM DYNAMIC レベル不足合体 , 1
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC LSOFT
#DIM CONST SHOW_LINE_NUM = 37
#DIMS DYNAMIC L_BTL_TALENT
#DIM DYNAMIC CNT_FREE_BASE_ENHANCE
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_SKILL
#DIM DYNAMIC L_SUCCESS_LIST, HAVEABLE_SKILLNUM
#DIMS DYNAMIC L_FUNC_PROPSET_LIST
#DIMS DYNAMIC L_FUNC_CUSTOM_TITLE
FLAG:작성예정악마 = -1
;---------------------------------------------------------------------
;インストールソフトの処理
;---------------------------------------------------------------------
;使用ソフトをリセット
USE_LIST_FUSION_SOFT = 
FOR LCOUNT, 0, INSTALLSOFTNUM
	TRYCCALLFORM INSTALLSOFT_TYPE_{LCOUNT}
		SIF !GROUPMATCH(RESULTS, "합체기능강화", "컨버터")
			CONTINUE
		;装備チェック
		SIF !EQUIP_INSTALLSOFT:LCOUNT
			CONTINUE
		;機能停止判定
		SIF INSTALLSOFT_DISABLE(LCOUNT)
			CONTINUE
		USE_LIST_FUSION_SOFT = %ADD_SPLIT(USE_LIST_FUSION_SOFT, "/", TOSTR(LCOUNT))%
	CATCH
		CONTINUE
	ENDCATCH
NEXT
;邪教の館の場合は履歴を呼び出す
IF FLAG:SHOP커맨드 == [[ショップ:사교의관]]
	IF STOCK_USE_LIST_FUSION_SOFT != ""
		FOR LCOUNT, 0, STRCOUNT(STOCK_USE_LIST_FUSION_SOFT, "/") + 1
			LSOFT = TOINT(AUTO_SPLIT(STOCK_USE_LIST_FUSION_SOFT, "/", LCOUNT))
			;一応所持チェック
			SIF !HAVE_INSTALLSOFT:LSOFT
				CONTINUE
			;すでにリスト入りさせられてるかを確認
			SIF COUNT_SPLIT(USE_LIST_FUSION_SOFT, "/", TOSTR(LSOFT))
				CONTINUE
			;除外リストに入っている
			SIF COUNT_SPLIT(EXCULDE_LIST_FUSION_SOFT, "/",TOSTR(LSOFT))
				CONTINUE
			;機能停止判定
			SIF INSTALLSOFT_DISABLE(LSOFT)
				CONTINUE
			USE_LIST_FUSION_SOFT = %ADD_SPLIT(USE_LIST_FUSION_SOFT, "/", TOSTR(LSOFT))%
		NEXT
	ENDIF
ENDIF
LREDRAW = LLOCK ? LREDRAW # CURRENTREDRAW()
SIF !LLOCK
	REDRAW 0
LLOCK = 1

;---------------------------------------------------------------------
;素材の指定
;---------------------------------------------------------------------
;素材:1、完成品　一体目と２体目の登録番号
素材:1 = -1
素材:2 = -1
素材:3 = -1
FLAG:합체인수 = ARG
$START_FUSION
FLAG:합체소재악마1 = 素材:1
FLAG:합체소재악마2 = 素材:2
;---- EDIT 044 ADD START -------------------------
SIF  (FLAG:합체소재악마1 >= 0 && FLAG:합체인수 == 2) || (FLAG:합체소재악마2 >= 0 && FLAG:합체인수 == 3)
	CALL MAKE_FUSION_RESULT_LIST
;---- EDIT 044 ADD END ---------------------------
LLINE = LINECOUNT
$PRINT_LIST
CLEARLINE LINECOUNT-LLINE
Z = ARG:1
;---- EDIT 044 MOD START -------------------------
;CALL INPUT_CHARA_LIST("합체시키고 싶은 악마를 선택해주세요", "CASTING_FUSION_NORMAL", "UP_PRINT_FUSION_NORMAL", "DOWN_PRINT_FUSION_NORMAL", "MODECHANGE_FUSION_NORMAL", , , "FUSION_CUSTOM_TITLE")
IF (FLAG:합체소재악마1 >= 0 && FLAG:합체인수 == 2) || (FLAG:합체소재악마2 >= 0 && FLAG:합체인수 == 3)
	CALL INPUT_FUSION_LIST
ELSE
	{
	CALL INPUT_CHARA_LIST
		, "PROPSET_FUSION"
		, "합체시키고 싶은 악마를 선택해주세요"
		, "CASTING_FUSION_NORMAL" 
		, "UP_PRINT_FUSION_NORMAL"
		, "DOWN_PRINT_FUSION_NORMAL"
		, "MODECHANGE_FUSION_NORMAL"
		, "돌아간다"
		, "FUSION_CUSTOM_TITLE"
		, "FUNC_CUSTOM_COLOR"
		, -1
	}
ENDIF
;---- EDIT 044 MOD END ---------------------------
IF RESULT == 1000
	IF 素材:2 > -1
		素材:2 = -1
		GOTO START_FUSION
	ELSEIF 素材:1 > -1
		素材:1 = -1
		GOTO START_FUSION
	ELSE
		REDRAW LREDRAW
		LLOCK = 0
		RETURN 0
	ENDIF
ELSEIF INRANGE(RESULT, 1500, 1500+INSTALLSOFTNUM)
	LSOFT = RESULT - 1500
	IF STRCOUNT("/" + USEABLE_LIST_FUSION_SOFT + "/" + USEABLE_LIST_CONVERT_SOFT + "/", "/" + TOSTR(LSOFT) + "/")
		IF STRCOUNT("/" + USE_LIST_FUSION_SOFT + "/", "/" + TOSTR(LSOFT) + "/")
			USE_LIST_FUSION_SOFT = %DEL_SPLIT(USE_LIST_FUSION_SOFT, "/", TOSTR(LSOFT))%
		ELSE
			SIF !INSTALLSOFT_DISABLE(LSOFT)
				USE_LIST_FUSION_SOFT = %ADD_SPLIT(USE_LIST_FUSION_SOFT, "/", TOSTR(LSOFT))%
		ENDIF
	ENDIF
	;邪教の館の場合は履歴を取る
	SIF FLAG:SHOP커맨드 == [[ショップ:사교의관]]
		STOCK_USE_LIST_FUSION_SOFT = %USE_LIST_FUSION_SOFT%
	GOTO START_FUSION
ELSEIF RESULT == 1011 || RESULT == 1012 || RESULT == 1013 || RESULT == 1014
	FLAG:이신합체시남녀표시 = RESULT - 1011
	GOTO START_FUSION
;ソフト設定
ELSEIF RESULT == 1020
	CALL SET_OPTION_FUSION_SOFT
	GOTO PRINT_LIST
ENDIF
;---- EDIT 033 MOD END ---------------------------
IF 素材:(FLAG:합체인수 - 1) <= 0
	IF 素材:2 > 0
		素材:3 = RESULT
	ELSEIF 素材:1 > 0
		素材:2 = RESULT
	ELSE
		素材:1 = RESULT
	ENDIF
ELSE
	素材:(FLAG:합체인수) = FUSION_RESULT_LIST:RESULT:(2 + FLAG:합체인수)
	完成品 = CHARANUM
	VARI FUSION_NO = FUSION_RESULT_LIST:RESULT:0
	FLAG:작성예정악마 = FUSION_NO
	;一旦合体結果の悪魔をキャラ登録
	CALL ADD_NEW_COMPANION,FUSION_NO, 100, , 1
	;なんらかの理由でキャラ登録できない場合
	IF RESULT == 0
		PRINTW 캐릭터 등록이 불가능하므로 합체 처리를 중단합니다
		REDRAW LREDRAW
		LLOCK = 0
		RETURN 0
	ENDIF
	CALL FUSION_SUCCESS_BASE, 完成品, 素材:1, 素材:2, 素材:3
	レベル不足合体 = RESULT
	CUSTOMDRAWLINE =
	;合体結果のステータスを表示
	U = 完成品
	;ステータス表示
	LOCAL:10 = 2
	LLINE:1 = LINECOUNT
	$PRINT_STATUS
	CLEARLINE LINECOUNT - LLINE:1
	PRINTFORM %종족명(U)%　　
	PRINTFORML %CALLNAME:U%　　
	RESETCOLOR
	FLAG:이신합체표시 = 1
	CALLFORM SHOW_INFO_PAGE_{LOCAL:10}
	IF LOCAL:10 == 2
		CALL SHOW_SUCCESS_SKILL, , 完成品, 素材:1, 素材:2, 素材:3
		SIF CFLAG:完成品:능력강화횟수 > 0
			PRINTFORML 무상능력강화횟수:{CFLAG:完成品:능력강화횟수}회
	ENDIF
	FLAG:이신합체표시 = 0
	PRINTFORM %"\n" * MAX(0, (ARG == 3 ? SHOW_LINE_NUM + 4 # SHOW_LINE_NUM) - LINECOUNT + LLINE:1)%
	CUSTOMDRAWLINE =
	CALL JUDGE_FUSION_MAKEABLE, 完成品, レベル不足合体
	IF !RESULT
		PRINTFORMW %RESULTS%
		DELCHARA 完成品
		RESTART
	ENDIF
	
	;ステータスの表示切替用
	PRINTFORMLC \@ LOCAL:10 == 2 ? [1007]이전페이지 # %" " * 16% \@
	PRINTFORMLC \@ U != 完成品 && FLAG:합체인수 == 3 && PRINTCPERLINE() < 4 ? [1012]합체후의악마 # %" " * 18% \@
	PRINTFORMLC \@ LOCAL:10 == 1 ? [1009]다음페이지 # %" " * 16% \@
	PRINTL 
	PRINTFORMLC \@ U != 素材:1 ? [1010]첫 번째 악마 # %" " * 18% \@
	PRINTFORMLC \@ U != 素材:2 ? [1011]두 번째 악마 # %" " * 18% \@
	SIF FLAG:합체인수 == 3
		PRINTFORMLC \@ U != 素材:3 ? [1013]세 번째 악마 # %" " * 18% \@
	SIF FLAG:합체인수 != 3 || PRINTCPERLINE() > 3
		PRINTFORMLC \@ U != 完成品 ? [1012]합체후의악마 # %" " * 18% \@
	PRINTL
	
	;合体するかどうか　→　合体実行（実際には既に終わっている）
	IF レベル不足合体
		PRINTL 레벨이 부족하지만、충성도를 소비해서 작성하시겠습니다？ [0]Yes [99]No
	ELSE
		PRINTL 이 악마로 괜찮으시겠습니다？ [0]Yes [99]No
	ENDIF
	$INPUT_LOOP
	INPUT
	IF RESULT == 1007 && LOCAL:10 == 2
		LOCAL:10 = 1
		GOTO PRINT_STATUS
	ELSEIF RESULT == 1009 && LOCAL:10 == 1
		LOCAL:10 = 2
		GOTO PRINT_STATUS
	ELSEIF RESULT == 1010 && U != 素材:1
		U = 素材:1
		GOTO PRINT_STATUS
	ELSEIF RESULT == 1011 && U != 素材:2
		U = 素材:2
		GOTO PRINT_STATUS
	ELSEIF RESULT == 1013 && U != 素材:3 && 素材:3 > 0
		U = 素材:3
		GOTO PRINT_STATUS
	ELSEIF RESULT == 1012 && U != 完成品
		U = 完成品
		GOTO PRINT_STATUS
	ELSEIF RESULT == 19 && MAXARRAY(ABL:U:0 , GETNUM(ABL , "습득LV1") , GETNUM( ABL , "습득LV20" ) +1 ) > 0
		CALL 習得スキル一覧表示 , U
		GOTO PRINT_STATUS
	;---- EDIT 046 MOD START -------------------------
	;ELSEIF RESULT <= 8 && RESULT > 0
	ELSEIF INRANGE(RESULT, 1, HAVEABLE_SKILLNUM * 4 + 1)
		L_CHARA = (RESULT -1) >= HAVEABLE_SKILLNUM ? 素材:((RESULT -1) / HAVEABLE_SKILLNUM) # 完成品
		IF L_CHARA >= 0
			L_SKILL = ABL:L_CHARA:@"스킬{RESULT % HAVEABLE_SKILLNUM}"
			IF L_SKILL > 0
				SIF FLAG:스킬속성표시설정 == 1
					CALL SKILL_EXPLAIN_PERFORMANCE, L_SKILL, L_CHARA
				CALL GET_SKILL_PROP, "SKILL_EXPLAIN", L_SKILL, L_CHARA
				WAIT
				GOTO PRINT_STATUS
			ELSE
				GOTO INPUT_LOOP
			ENDIF
		ELSE
			GOTO INPUT_LOOP
		ENDIF
	ELSEIF RESULT == 99
		DELCHARA 完成品
		素材:(FLAG:합체인수) = -1
		GOTO PRINT_LIST
	ELSEIF RESULT == 0
	ELSE
		GOTO INPUT_LOOP
	ENDIF
	CALL MAKE_FUSION_DEVIL, 完成品, 素材:1, 素材:2, 素材:3
	SIF !RESULT
		GOTO PRINT_STATUS	
	LLOCK = 0
	REDRAW LREDRAW
	RETURN 0
ENDIF
GOTO START_FUSION

@CASTING_FUSION_NORMAL, ARG, IS_SPECIAL_FUSION
#DIM DYNAMIC IS_SPECIAL_FUSION
#DIM DYNAMIC HAVE_DEVIL_NO_LIST, MAX_PLAYER_CHARA
SIF 계약(ARG) > 0
	RETURN 0
SIF ARG == MASTER
	RETURN 0
;探索中
IF TFLAG:전투중 || FLAG:SHOP커맨드 == [[ショップ:탐색]]
	SIF CFLAG:ARG:소속ＣＯＭＰ == -1 && CFLAG:ARG:PT플래그
		RETURN 0
ENDIF
SIF !CFLAG:ARG:PT플래그
	RETURN 0
SIF ARG == FLAG:합체소재악마1 || ARG == FLAG:합체소재악마2 || ARG == FLAG:합체소재악마3
	RETURN 0
SIF IS_RENTING(ARG)
	RETURN 0
SIF CFLAG:ARG:합체소재사용금지
	RETURN 0
SIF CFLAG:ARG:이자리에없는플래그 == 1
	RETURN 0
IF !IS_SPECIAL_FUSION
	SIF FLAG:이신합체시남녀표시 == 3 && !FLAG:악마가챠모드
		FLAG:이신합체시남녀표시 = 0
	SIF FLAG:이신합체시남녀표시 == 1 && TALENT:ARG:남자
		RETURN 0
	SIF FLAG:이신합체시남녀표시 == 2 && !TALENT:ARG:남자
		RETURN 0
	SIF FLAG:이신합체시남녀표시 == 3 && !TALENT:ARG:가챠
		RETURN 0
	;特殊合体のリスト作成では合体に使えないロールも通す
	SIF !GET_ROLE_PROP("CAN_FUSION", ARG)
		RETURN 0
ENDIF
RETURN 1

@UP_PRINT_FUSION_NORMAL
PRINTFORML 합체시키고 싶은 악마를 선택해주세요　\@ A > リスト表示数() ? ＜page.{P + 1}/{A / リスト表示数() + 1}＞ # \@　%CALLNAME:MASTER% LV:{BASE:MASTER:LV,3} \@ FLAG:경험ED수 > 0 ? + 경험ED수:{FLAG:경험ED수,3} # \@

@DOWN_PRINT_FUSION_NORMAL
IF FLAG:합체소재악마1 > -1
	PRINTL 
	PRINTFORML １번째:%CALLNAME:(FLAG:합체소재악마1)%
ENDIF
SIF FLAG:합체소재악마2 > -1
	PRINTFORML ２번째:%CALLNAME:(FLAG:합체소재악마2)%
;=====================================================
;合体関連ソフト設定
;=====================================================
@SET_OPTION_FUSION_SOFT
#DIM CONST SHOWNUM = 30
#DIMS SHOW_LINE
#DIM LCOUNT
#DIM L_LINE
#DIM TEMP_LINE
#DIM SELECT_SOFT
#DIMS SELECT_TYPE
#DIMS SELECT_LIST
#DIM L_SOFT
#DIMS L_TITLE
#DIMS TEMPS
#DIMS L_COLOR_TAG
SELECT_SOFT = -1
IF USEABLE_LIST_FUSION_SOFT != ""
	SELECT_TYPE = 합체기능강화
ELSE
	SELECT_TYPE = 컨버터
ENDIF
$START
CLEARLINE LINECOUNT - L_LINE
DRAWLINE
PRINTL 합체 관련 소프트 설정
PRINTL 소지 소프트의 표시・비표시를 설정할 수 있습니다。
DRAWLINE
SELECT_LIST = \@SELECT_TYPE == "합체기능강화" ? %USEABLE_LIST_FUSION_SOFT% # %USEABLE_LIST_CONVERT_SOFT%\@
TEMP_LINE = LINECOUNT
FOR L_SOFT, 0, INSTALLSOFTNUM
	;名称未定義は弾く
	SIF GET_INSTALLSOFT_NAME(L_SOFT) == ""
		CONTINUE
	;所持しているかチェック
	SIF !HAVE_INSTALLSOFT:L_SOFT
		CONTINUE
	CALLFORM INSTALLSOFT_TYPE_{L_SOFT}
	SIF SELECT_TYPE != RESULTS
		CONTINUE
	;L_SOFT = TOINT(AUTO_SPLIT(SELECT_LIST, "/", LCOUNT))
	TEMPS = [{L_SOFT,3}] %GET_INSTALLSOFT_NAME(L_SOFT), 24, LEFT%
	;1行テキストの取得
	RESULTS:10 = 
	CALLFORM INSTALLSOFT_EXPLAIN_{L_SOFT}
	;長過ぎる場合の代替テキスト
	SIF RESULTS:10 != ""
		RESULTS = %RESULTS:10%
	TEMPS '= TEMPS + "　　　" + RESULTS
	;色設定
	IF COUNT_SPLIT(EXCULDE_LIST_FUSION_SOFT, "/", TOSTR(L_SOFT))
		TEMPS =<font color = '%TOSTR_HTML(COLOR("DARK-GRAY"))%' bcolor = '%TOSTR_HTML(COLOR("BROWN"))%'>%TEMPS%</font>
	ELSE
		TEMPS = <font color = '%TOSTR_HTML(COLOR("デフォルト"))%'>%TEMPS%</font>
	ENDIF
	;解説文を取得
	CALL SET_VAR_INSTALLSOFT_EXPLAIN, L_SOFT, L_TITLE

	TEMPS = <button value = '{L_SOFT}' title = '%L_TITLE%'>%TEMPS%</button>

	HTML_PRINT TEMPS
NEXT
WHILE LINECOUNT < TEMP_LINE + SHOWNUM
	PRINTFORML 
WEND
DRAWLINE
SHOW_LINE = 
FOR LCOUNT, 0, 2
	TEMPS = %AUTO_SPLIT("합체기능강화/컨버터", "/", LCOUNT)%
	IF TEMPS == SELECT_TYPE
		L_COLOR_TAG = color = '%TOSTR_HTML(COLOR("aqua"))%'
	ELSE
		L_COLOR_TAG = color = '%TOSTR_HTML(GETDEFCOLOR())%'
	ENDIF
	SHOW_LINE += @"<font %L_COLOR_TAG%>" + @"<button value = '{50+LCOUNT}'>" + @"[{50+LCOUNT, 2}] %TEMPS%　　　"+"</button>" + "</font>"
NEXT
HTML_PRINT SHOW_LINE
DRAWLINE
TEMP_LINE = LINECOUNT
IF SELECT_SOFT >= 0
	PRINTFORML %GET_INSTALLSOFT_NAME(SELECT_SOFT)%
	CALL SET_VAR_INSTALLSOFT_EXPLAIN, SELECT_SOFT, L_TITLE
	CALL PRINTFORM_LF, L_TITLE
ENDIF
WHILE LINECOUNT < TEMP_LINE + 6
	PRINTFORML 
WEND
DRAWLINE
PRINTL [999] 돌아간다
INPUT
SELECTCASE RESULT
	CASE 999
		RETURN 0
	CASE 50 TO 51
		SELECTCASE RESULT
			CASE 50
				SELECT_TYPE = 합체기능강화
			CASE 51
				SELECT_TYPE = 컨버터
		ENDSELECT
	CASEELSE
		IF INRANGE(RESULT, 0, INSTALLSOFTNUM)
			SELECT_SOFT = RESULT
			IF COUNT_SPLIT(EXCULDE_LIST_FUSION_SOFT, "/", TOSTR(SELECT_SOFT))
				EXCULDE_LIST_FUSION_SOFT = %DEL_SPLIT(EXCULDE_LIST_FUSION_SOFT, "/", TOSTR(SELECT_SOFT))%
			ELSE
				EXCULDE_LIST_FUSION_SOFT = %ADD_SPLIT(EXCULDE_LIST_FUSION_SOFT, "/", TOSTR(SELECT_SOFT))%
			ENDIF
		ENDIF
ENDSELECT
GOTO START

;===================================================
;合体時の画面下部設定
;===================================================
@MODECHANGE_FUSION_NORMAL , ARG
#DIM LCOUNT
#DIM L_SOFT
#DIMS SHOW_LINE
#DIMS L_TITLE
#DIMS L_COLOR
#DIMS L_BCOLOR_TAG
#DIM CONST SHOW_SOFTLENS = 22
#DIMS TEMPS
#DIM SHOWNUM_IN_LINE
SELECTCASE ARG
	CASE -1
		PRINTL 
		SIF !FLAG:이신합체시남녀표시
			SETCOLOR COLOR("aqua")
		PRINTLC [1011]남녀전부
		RESETCOLOR
		SIF FLAG:이신합체시남녀표시 == 1
			SETCOLOR COLOR("aqua")
		PRINTLC [1012]여자만
		RESETCOLOR
		SIF FLAG:이신합체시남녀표시 == 2
			SETCOLOR COLOR("aqua")
		PRINTLC [1013]남자만
		RESETCOLOR
		;ガチャモード時
		IF FLAG:악마가챠모드 > 0
			SIF FLAG:이신합체시남녀표시 == 3
				SETCOLOR COLOR("aqua")
			PRINTLC [1014]가챠만
			RESETCOLOR
		ENDIF
		CALL PRINT_INSTALLSOFT_IN_FUSION
	CASE 1010 TO 1013
		RETURN ARG, 0
	CASE 1014
		SIF FLAG:악마가챠모드 > 0
			RETURN ARG, 0
	;合体関連ソフト設定
	CASE 1020
		RETURN ARG, 0
	CASE 1500 TO 1500 + INSTALLSOFTNUM
		RETURN ARG, 0
ENDSELECT
RETURN ARG , 1

@PRINT_INSTALLSOFT_IN_FUSION, IS_SHOW_CONVERTER = 1
#DIM DYNAMIC IS_SHOW_CONVERTER
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_SOFT
#DIMS DYNAMIC SHOW_LINE
#DIMS DYNAMIC L_TITLE
#DIMS DYNAMIC L_COLOR
#DIMS DYNAMIC L_BCOLOR_TAG
#DIM CONST SHOW_SOFTLENS = 22
#DIMS DYNAMIC TEMPS
#DIM DYNAMIC SHOWNUM_IN_LINE
;ソフト用のリスト作成
USEABLE_LIST_FUSION_SOFT =
USEABLE_LIST_CONVERT_SOFT =
FOR LCOUNT, 0, INSTALLSOFTNUM
	;名称未定義は弾く
	SIF GET_INSTALLSOFT_NAME(LCOUNT) == ""
		CONTINUE
	;除外リストに入っている
	SIF COUNT_SPLIT(EXCULDE_LIST_FUSION_SOFT, "/",TOSTR(LCOUNT))
		CONTINUE
	;---- EDIT 034 ADD START -------------------------
	SIF !HAVE_INSTALLSOFT:LCOUNT
		CONTINUE
	;---- EDIT 034 ADD END ---------------------------
	CALLFORM INSTALLSOFT_TYPE_{LCOUNT}
	IF RESULTS == "합체기능강화"
		SIF USEABLE_LIST_FUSION_SOFT != ""
			USEABLE_LIST_FUSION_SOFT += "/"
		USEABLE_LIST_FUSION_SOFT += TOSTR(LCOUNT)
	ENDIF
	IF RESULTS == "컨버터" && IS_SHOW_CONVERTER
