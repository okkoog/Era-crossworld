;下部の選択肢表示
;------------------------------------------------------------------------------
DRAWLINE
PRINTFORMLC \@ LISTMAXNUM ?[1006]이전페이지# [----] \@
PRINTFORMLC [1000]돌아간다
PRINTFORMLC \@ LISTMAXNUM ?[1007]다음페이지# [----] \@
CALL MODECHANGE_FUSION_NORMAL, -1
CALL DOWN_PRINT_FUSION_NORMAL
$INPUT_LOOP
INPUT
CLEARLINE 1
TRYCCALLFORM MODECHANGE_FUSION_NORMAL, RESULT
	IF !RESULT:1
		RETURN RESULT
	ENDIF
	SIF RESULT:1 == -1
		GOTO INPUT_LOOP
CATCH
ENDCATCH
SELECTCASE RESULT
	CASE 1000
		RETURN RESULT
	CASE 1006
		L_PAGE = L_PAGE <= 0 ? LISTMAXNUM # L_PAGE - 1
	CASE 1007
		L_PAGE = L_PAGE >= LISTMAXNUM ? 0 # L_PAGE + 1
	CASEELSE
		SIF INRANGE(RESULT, 0, FUSION_RESULT_LISTCOUNT - 1) && FUSION_RESULT_LIST:RESULT:0 > 0
			RETURN RESULT, FUSION_RESULT_LISTCOUNT
		GOTO INPUT_LOOP
ENDSELECT
