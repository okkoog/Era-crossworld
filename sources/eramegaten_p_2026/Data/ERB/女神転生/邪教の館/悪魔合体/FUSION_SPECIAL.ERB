;================================================================
;特殊合体の結果を出力するための関数群です
;================================================================
@FUSION_SPECIAL
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_LIST_NO
#DIM DYNAMIC L_DEVIL
#DIM DYNAMIC DEVIL_LIST, SP_FUSION_LISTNUM
#DIM DYNAMIC DEVIL_LIST_KEY, SP_FUSION_LISTNUM
#DIMS DYNAMIC SHOWLINE
#DIMS DYNAMIC TEMPS
#DIMS DYNAMIC BUTTON_ARRAY, 1000
#DIM DYNAMIC COUNTLIST
#DIM DYNAMIC HAVE_DEVIL_NO_LIST, MAX_PLAYER_CHARA
#DIM DYNAMIC HAVE_RACE_LIST, RACENUM
#DIM DYNAMIC HAVE_ZOUMA_MAXLV
#DIM DYNAMIC L_PAGE
#DIM DYNAMIC L_SHOWNUM
#DIM DYNAMIC L_LISTMAX
REDRAW 0
VARI L_LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - L_LINE
VARSET BUTTON_ARRAY

CALL MAKE_SP_FUSION_LIST, COUNTLIST, DEVIL_LIST, DEVIL_LIST_KEY, HAVE_DEVIL_NO_LIST, HAVE_RACE_LIST, HAVE_ZOUMA_MAXLV
L_SHOWNUM = GET_HEIGHTLENS() - 10
WHILE DEVIL_LIST:(L_SHOWNUM * (L_LISTMAX + 1)) >= 0
	L_LISTMAX++
WEND

DRAWLINE
PRINTFORML 작성하고 싶은 악마를 선택해주세요　　　%CALLNAME:MASTER% LV:{BASE:MASTER:LV,3} \@ FLAG:경험ED수 > 0 ? + 경험ED수:{FLAG:경험ED수,3} # \@
DRAWLINE
SHOWLINE '= ""
SHOWLINE += TOALIGNMENT("No", 5, "CENTER") + " "
SHOWLINE += TOALIGNMENT("Race", 12, "CENTER") + " "
SHOWLINE += TOALIGNMENT("Name", 18, "CENTER") + " "
SHOWLINE += TOALIGNMENT("Lv", 3, "CENTER") + " "
SHOWLINE += TOALIGNMENT("ALI", 3, "CENTER") + " "
SHOWLINE += TOALIGNMENT("Sex", 3, "CENTER") + "　"
SHOWLINE += TOALIGNMENT("소재1", 20, "CENTER") + "　"
SHOWLINE += TOALIGNMENT("소재2", 20, "CENTER") + "　"
SHOWLINE += TOALIGNMENT("소재3", 20, "CENTER") + "　"
HTML_PRINT SHOWLINE
VARI SELECT_LINE = LINECOUNT
FOR LCOUNT, 0, L_SHOWNUM
	VARI LISTNUM = L_SHOWNUM * L_PAGE + LCOUNT
	L_LIST_NO = DEVIL_LIST:LISTNUM
	SIF L_LIST_NO < 0
		CONTINUE
	L_DEVIL = SP_FUSION_LIST_DEVIL_NO:L_LIST_NO
	SHOWLINE '= @"[{LISTNUM+1, 3}]" + " "
	TEMPS '= TOALIGNMENT(CSV種族名(L_DEVIL,0), 12, "CENTER") + " "
	IF IS_CHARA_COMPANIONED:(L_DEVIL) || ANALYSIS_RATE:L_DEVIL
		TEMPS += MAKE_INFO_DATA_NAME(CSVCALLNAME(L_DEVIL), "CENTER")
		SIF !SP_FUSION_LIST_MAKEABLE:L_LIST_NO
			TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
	ELSE
		TEMPS += MAKE_INFO_DATA_NAME("？？？？", "CENTER")
		SIF SP_FUSION_LIST_MAKEABLE:L_LIST_NO
			TEMPS '= SET_COLOR_TAG(TEMPS, "p-green")
	ENDIF
	SHOWLINE += TEMPS + " "
	SHOWLINE += TOALIGNMENT(TOSTR(CSVBASE(L_DEVIL,GETNUM(BASE, "LV"))), 3, "CENTER") + " "

	SHOWLINE += SET_COLOR_TAG(SUBSTRING(GET_ALI1(CSVABL(L_DEVIL, GETNUM(ABL, "속성LD"))), 0, 1), TOSTR(ALICOLOR(CSVABL(L_DEVIL, GETNUM(ABL, "속성LD")))))
	SHOWLINE += "/"
	SHOWLINE += SET_COLOR_TAG(SUBSTRING(GET_ALI2(CSVABL(L_DEVIL, GETNUM(ABL, "속성LC"))), 0, 1), TOSTR(ALICOLOR(CSVABL(L_DEVIL, GETNUM(ABL, "속성LC")))))
	SHOWLINE += " "

	IF CSVTALENT(L_DEVIL, GETNUM(TALENT, "부정형")) || CSVTALENT(L_DEVIL, GETNUM(TALENT, "이형")) || CSVTALENT(L_DEVIL, GETNUM(TALENT, "오토코노코")) || CSVTALENT(L_DEVIL, GETNUM(TALENT, "후타나리"))
		SHOWLINE += " ？"
	ELSE
		IF CSVTALENT(L_DEVIL, GETNUM(TALENT, "남자"))
			SHOWLINE += SET_COLOR_TAG(" ♂", "0x008B8B")
		ELSE
			SHOWLINE += SET_COLOR_TAG(" ♀", "0x660022")
		ENDIF
	ENDIF
	SHOWLINE += "　"
	VARSET RESULT, 0, 0, 4
	VARSET RESULTS, "", 0, 4
	TRYCCALLFORM FUSION_SPECIAL_{L_DEVIL}
		FOR LCOUNT:1, 1, 4
			IF RESULT:(LCOUNT:1) > 0
				IF RESULT:(LCOUNT:1) == [[キャラ:조마]]
					TEMPS '= "[" + MAKE_INFO_DATA_NAME(@"Lv{NEED_ZOUMA_LV_AT_SPECIAL_FUSION(L_DEVIL)}以上の造魔", "CENTER") + "]"
					SIF NEED_ZOUMA_LV_AT_SPECIAL_FUSION(L_DEVIL) > HAVE_ZOUMA_MAXLV
						TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
				ELSE
					TEMPS '= "[" + MAKE_INFO_DATA_NAME(CSVCALLNAME(RESULT:(LCOUNT:1)), "CENTER") + "]"
					SIF !MATCH(HAVE_DEVIL_NO_LIST, RESULT:(LCOUNT:1))
						TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
				ENDIF
				SHOWLINE += TEMPS + "　"
			ELSEIF RESULT:(LCOUNT:1) < 0
				VARI TEMP = ABS(RESULT:(LCOUNT:1))
				TEMPS '= "[" + MAKE_INFO_DATA_NAME(GET_RACE(TEMP), "CENTER") + "]"
				SIF !HAVE_RACE_LIST:TEMP
					TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
				SHOWLINE += TEMPS + "　"
			ENDIF
		NEXT
	CATCH
	ENDCATCH

	SHOWLINE '= SET_BUTTON_TAG(SHOWLINE, TOSTR(LISTNUM+1))
	CALL PUSH_ARRAY_STR, BUTTON_ARRAY, TOSTR(LISTNUM+1)
	HTML_PRINT SHOWLINE
NEXT
WHILE LINECOUNT < SELECT_LINE + L_SHOWNUM
	PRINTL 
WEND
DRAWLINE
SHOWLINE '= SET_BUTTON_TAG("[-] 이전페이지", "-") + " " * 10
SHOWLINE += SET_BUTTON_TAG("[0] 돌아간다", "0") + " " * 16
SHOWLINE += SET_BUTTON_TAG("[+] 다음페이지", "+") + " " * 10
CALL PUSH_ARRAY_STR, BUTTON_ARRAY, "0", "-", "+"
HTML_PRINT SHOWLINE

CALL INPUTS_MATCH_ARRAY, BUTTON_ARRAY
SELECTCASE RESULTS
	CASE "0"
		REDRAW 1
		RETURN 0
	CASE "-"
		L_PAGE -= 1
		SIF L_PAGE < 0
			L_PAGE = L_LISTMAX
	CASE "+"
		L_PAGE += 1
		SIF L_PAGE > L_LISTMAX
			L_PAGE = 0
	CASEELSE
		L_LIST_NO = DEVIL_LIST:(TOINT(RESULTS) - 1)
		L_DEVIL = SP_FUSION_LIST_DEVIL_NO:L_LIST_NO
		CALL MAKE_SP_FUSION_DEVIL, L_LIST_NO, L_DEVIL, HAVE_DEVIL_NO_LIST, HAVE_RACE_LIST
		SIF RESULT
			RETURN 1
ENDSELECT
GOTO START

@MAKE_SP_FUSION_DEVIL, L_LIST_NO, L_DEVIL, HAVE_DEVIL_NO_LIST, HAVE_RACE_LIST
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_LIST_NO
#DIM DYNAMIC L_DEVIL
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC SP_素材, 3
#DIMS DYNAMIC SHOWLINE
#DIM REF HAVE_DEVIL_NO_LIST
#DIM REF HAVE_RACE_LIST
FLAG:합체소재악마1 = -1
FLAG:합체소재악마2 = -1
FLAG:합체소재악마3 = -1
FLAG:작성예정악마 = L_DEVIL
FLAG:합체결과악마 = -1

VARSET RESULT, 0, 0, 4
TRYCCALLFORM FUSION_SPECIAL_{L_DEVIL}
	FLAG:합체인수 = 3 - MATCH(RESULT, 0, 1, 4)
	SP_素材 = RESULT:1, RESULT:2, RESULT:3
CATCH
ENDCATCH
VARI PRINT_STATUS_LINE = LINECOUNT
VARI L_CHARA_PAGE = 2
WHILE 1
	CLEARLINE LINECOUNT - PRINT_STATUS_LINE
	SIF L_CHARA > 0
		CALL キャラ削除, L_CHARA
	;一旦悪魔をキャラ登録
	CALL ADD_NEW_COMPANION, L_DEVIL, 0, , 1 
	L_CHARA = RESULT:1
	FLAG:합체결과악마 = RESULT:1
	IF ANALYSIS_RATE:L_DEVIL < ANALYSIS_COMPLETED && !IS_CHARA_COMPANIONED:L_DEVIL
		CALLNAME:L_CHARA = ????
		NAME:L_CHARA = ????
	ENDIF
	CALL FUSION_SUCCESS_BASE, L_CHARA, FLAG:합체소재악마1, FLAG:합체소재악마2, FLAG:합체소재악마3
	U = L_CHARA
	IF GETBIT(FLAG:커스텀게임화면,0) || L_CHARA_PAGE == 1
		DRAWLINE
		PRINTFORML %종족명(L_CHARA)%　　%NAME:L_CHARA%　　
		DRAWLINE
	ELSE
		DRAWLINE
		PRINTFORML 특수합체
		DRAWLINE
		PRINTL 
	ENDIF
	FLAG:이신합체표시 = 1
	CALLFORM SHOW_INFO_PAGE_{L_CHARA_PAGE}
	FLAG:이신합체표시 = 0
	IF L_CHARA_PAGE == 2
		SIF CFLAG:L_CHARA:능력강화횟수 > 0
			PRINTFORML 무상능력강화횟수:{CFLAG:L_CHARA:능력강화횟수}회
		CALL SHOW_SUCCESS_SKILL, "逆引き合体", L_CHARA, FLAG:합체소재악마1, FLAG:합체소재악마2, FLAG:합체소재악마3, L_LIST_NO
		;DRAWLINEが1個多いので削る
		CLEARLINE 1
	ELSE
		VARS TEMPS
		FOR LCOUNT, 0, 3
			IF SP_素材:LCOUNT == 0
				PRINTL 
			ELSE
				IF SP_素材:LCOUNT > 0
					TEMPS '= CSVCALLNAME(SP_素材:LCOUNT)
				ELSE
					TEMPS '= GET_RACE(ABS(SP_素材:LCOUNT))
				ENDIF
				TEMPS '= @"[{900 + LCOUNT}] " + TEMPS
				IF SP_FUSION_LIST_MAKEABLE:L_LIST_NO
					HTML_PRINT SET_BUTTON_TAG(TEMPS, TOSTR(900 + LCOUNT))
				ELSE
					HTML_PRINT TEMPS
				ENDIF
			ENDIF
		NEXT
	ENDIF
	CALL PRINT_INSTALLSOFT_IN_FUSION, 0
	WHILE PRINT_STATUS_LINE + GET_HEIGHTLENS() - 4 > LINECOUNT
		PRINTL 
	WEND
	VARI CAN_FUSION = 0
	DRAWLINE
	SHOWLINE '= SET_BUTTON_TAG("[800] 조교스테이터스", "800")
	SHOWLINE += " " * 2
	SHOWLINE += SET_BUTTON_TAG("[801] 전투스테이터스", "801")
	HTML_PRINT SHOWLINE
	IF SP_FUSION_LIST_MAKEABLE:L_LIST_NO
		IF 3 - GROUPMATCH(-1, FLAG:합체소재악마1, FLAG:합체소재악마2, FLAG:합체소재악마3) == FLAG:합체인수
			SHOWLINE '= SET_BUTTON_TAG("[100] 작성한다", "100")
			CAN_FUSION = 1
		ELSE
			SHOWLINE '= SET_COLOR_TAG("[100] 작성한다", "gray")
		ENDIF
	ELSE
		SHOWLINE '= SET_COLOR_TAG("[ - ] 소재부족", "gray")
	ENDIF
	SHOWLINE += " " * 8
	SHOWLINE += SET_BUTTON_TAG("[999] 돌아간다", "999")
	HTML_PRINT SHOWLINE
	INPUT
	SELECTCASE RESULT
		CASE 100
			IF CAN_FUSION
				VARI レベル不足合体
				CALL JUDGE_FUSION_MAKEABLE, L_CHARA, レベル不足合体
				IF !RESULT
					PRINTFORMW %RESULTS%
					CONTINUE
				ELSE
					IF レベル不足合体
						PRINTL 레벨이 부족하지만、충성도를 소비해서 작성하시겠습니다？ [0] Yes [1] No
						CALL INPUTINT, 0, 1
						SIF RESULT
							CONTINUE
					ENDIF
					NAME:L_CHARA '= CSVNAME(NO:L_CHARA)
					CALLNAME:L_CHARA '= CSVCALLNAME(NO:L_CHARA)
					CALL MAKE_FUSION_DEVIL, L_CHARA, FLAG:합체소재악마1, FLAG:합체소재악마2, FLAG:합체소재악마3
					SIF RESULT == 0
						CONTINUE
					RETURN 1
				ENDIF
			ENDIF
		CASE 800
			L_CHARA_PAGE = 1
		CASE 801
			L_CHARA_PAGE = 2
		CASE 900, 901, 902
			IF SP_FUSION_LIST_MAKEABLE:L_LIST_NO
				VARI TEMP_NUM = RESULT - 900
				VARSET RESULTS, "", 0, 3
				VARSET RESULT, 0, 0, 4

				TRYCCALLFORM FUSION_SPECIAL_{L_DEVIL}
					SP_FUSION_MATERIAL = RESULT:(TEMP_NUM + 1)
					SIF SP_FUSION_MATERIAL == 0
						CONTINUE
					FLAG:@"합체소재악마{TEMP_NUM + 1}" = -1
					{
					CALL INPUT_CHARA_LIST
						, ""
						, "합체시키고 싶은 악마를 선택해주세요"
						, "CASTING_FUSION_SPECIAL" 
					}
					SIF RESULT == 1000
						CONTINUE
					FLAG:@"합체소재악마{TEMP_NUM + 1}" = RESULT
				CATCH
				ENDCATCH
				
			ENDIF
		CASE 19
			CALL 習得スキル一覧表示 , L_CHARA
		CASE 1 TO HAVEABLE_SKILLNUM * 4 + 1
			VARI L_SHOW_CHARA
			IF (RESULT - 1)  / HAVEABLE_SKILLNUM == 0
				L_SHOW_CHARA = L_CHARA
			ELSE
				L_SHOW_CHARA = FLAG:@"합체소재악마{(RESULT - 1)  / HAVEABLE_SKILLNUM}"
			ENDIF
			IF L_SHOW_CHARA >= 0
				VARI L_SKILL = ABL:L_SHOW_CHARA:@"스킬{RESULT % HAVEABLE_SKILLNUM}"
				IF L_SKILL > 0
					SIF FLAG:스킬속성표시설정 == 1
						CALL SKILL_EXPLAIN_PERFORMANCE, L_SKILL, L_SHOW_CHARA
					CALL GET_SKILL_PROP, "SKILL_EXPLAIN", L_SKILL, L_SHOW_CHARA
					WAIT
				ENDIF
			ENDIF
		;合体関連ソフト設定
		CASE 1020
			CALL SET_OPTION_FUSION_SOFT
		CASE 1500 TO 1500 + INSTALLSOFTNUM
			VARI LSOFT = RESULT - 1500
			IF STRCOUNT("/" + USEABLE_LIST_FUSION_SOFT + "/" + USEABLE_LIST_CONVERT_SOFT + "/", "/" + TOSTR(LSOFT) + "/")
				IF STRCOUNT("/" + USE_LIST_FUSION_SOFT + "/", "/" + TOSTR(LSOFT) + "/")
					USE_LIST_FUSION_SOFT = %DEL_SPLIT(USE_LIST_FUSION_SOFT, "/", TOSTR(LSOFT))%
				ELSE
					SIF !INSTALLSOFT_DISABLE(LSOFT)
						USE_LIST_FUSION_SOFT = %ADD_SPLIT(USE_LIST_FUSION_SOFT, "/", TOSTR(LSOFT))%
				ENDIF
			ENDIF
			;邪教の館の場合は履歴を取る
			SIF FLAG:SHOP커맨드 == [[ショップ:사교의관]]
				STOCK_USE_LIST_FUSION_SOFT = %USE_LIST_FUSION_SOFT%
		CASE 999
			CALL キャラ削除, L_CHARA
			RETURN 1
	ENDSELECT
WEND
@CASTING_FUSION_SPECIAL, ARG
SIF 계약(ARG) > 0
	RETURN 0
SIF ARG == MASTER
	RETURN 0
;探索中
IF TFLAG:전투중 || FLAG:SHOP커맨드 == [[ショップ:탐색]]
	SIF CFLAG:ARG:소속ＣＯＭＰ == -1 && CFLAG:ARG:PT플래그
		RETURN 0
ENDIF
SIF !CFLAG:ARG:PT플래그
	RETURN 0
SIF IS_RENTING(ARG)
	RETURN 0
SIF CFLAG:ARG:합체소재사용금지
	RETURN 0
SIF CFLAG:ARG:이자리에없는플래그 == 1
	RETURN 0
SIF GROUPMATCH(ARG, FLAG:합체소재악마1, FLAG:합체소재악마2, FLAG:합체소재악마3)
	RETURN 0
SIF ARG == FLAG:합체결과악마
	RETURN 0
IF SP_FUSION_MATERIAL > 0
	SIF NO:ARG != SP_FUSION_MATERIAL
		RETURN 0
	SIF SP_FUSION_MATERIAL == [[キャラ:조마]] && BASE:ARG:LV < NEED_ZOUMA_LV_AT_SPECIAL_FUSION(FLAG:작성예정악마)
		RETURN 0
ELSE
	SIF ABL:ARG:종족 != ABS(SP_FUSION_MATERIAL)
		RETURN 0
ENDIF
RETURN 1

;特殊合体のリストを作る
@MAKE_SP_FUSION_LIST, COUNTLIST, DEVIL_LIST, DEVIL_LIST_KEY, HAVE_DEVIL_NO_LIST, HAVE_RACE_LIST, HAVE_ZOUMA_MAXLV
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CSV_NO
#DIM DYNAMIC TEMP_EXTRA_NO
#DIM REF COUNTLIST
#DIM REF DEVIL_LIST
#DIM REF DEVIL_LIST_KEY
#DIM REF HAVE_DEVIL_NO_LIST
#DIM REF HAVE_RACE_LIST
#DIM REF HAVE_ZOUMA_MAXLV
FLAG:합체소재악마1 = -1
FLAG:합체소재악마2 = -1
FLAG:합체소재악마3 = -1

VARSET COUNTLIST
VARSET DEVIL_LIST
VARSET DEVIL_LIST_KEY
VARSET HAVE_DEVIL_NO_LIST
VARSET HAVE_RACE_LIST
VARSET HAVE_ZOUMA_MAXLV

;使えるNOと種族を収納する
FOR LCOUNT, 0, CHARANUM
	CALL CASTING_FUSION_NORMAL, LCOUNT, 1
	SIF !RESULT
		CONTINUE
	HAVE_DEVIL_NO_LIST:LCOUNT = NO:LCOUNT
	HAVE_RACE_LIST:(ABL:LCOUNT:종족) = 1
	SIF NO:LCOUNT == [[キャラ:조마]]
		HAVE_ZOUMA_MAXLV = MAX(BASE:LCOUNT:LV, HAVE_ZOUMA_MAXLV)
NEXT

VARSET SP_FUSION_LIST_MAKEABLE
VARSET SP_FUSION_LIST_DEVIL_NO
VARSET SP_FUSION_LIST_MATERIAL
FOR L_CSV_NO, 0, CSVCHARANUM
	SIF !EXISTCSV(L_CSV_NO)
		CONTINUE
	;合体条件を確認
	SIF CSVCFLAG(L_CSV_NO, GETNUM(CFLAG, "합체조건있음")) && !REMOVED_FUSION_LIMIT:L_CSV_NO
		CONTINUE
	;EX条件を確認
	SIF !IS_PLAYABLE_EXTRA_CHARA(L_CSV_NO)
		CONTINUE
	;コンバータの所持を確認
	SIF CSVCFLAG(L_CSV_NO,(GETNUM(CFLAG,"컨버터"))) && !HAVE_INSTALLSOFT:CSVCFLAG(L_CSV_NO,(GETNUM(CFLAG,"컨버터")))
		CONTINUE
	SP_FUSION_LIST_DEVIL_NO:COUNTLIST = 0
	VARSET RESULT, 0, 0, 4
	TRYCCALLFORM FUSION_SPECIAL_{L_CSV_NO}
		;情報の所持チェック
		;作成したことがあるか解析度を持っている
		SIF IS_CHARA_COMPANIONED:(L_CSV_NO) || ANALYSIS_RATE:L_CSV_NO
			SP_FUSION_LIST_DEVIL_NO:COUNTLIST = L_CSV_NO
		FOR LCOUNT, 1, 4
			SIF RESULT:LCOUNT <= 0
				CONTINUE
			;素材悪魔を所持したことがある
			IF IS_CHARA_COMPANIONED:(RESULT:LCOUNT)
				;造魔はマスターの到達レベルで制限をかける
				IF RESULT:LCOUNT == [[キャラ:조마]]
					SIF NEED_ZOUMA_LV_AT_SPECIAL_FUSION(L_CSV_NO) > MAX_MASTER_LV
						CONTINUE
				ENDIF
				SP_FUSION_LIST_DEVIL_NO:COUNTLIST = L_CSV_NO
			ENDIF
		NEXT
		;ここまで情報なしなら登録しない
		SIF !SP_FUSION_LIST_DEVIL_NO:COUNTLIST
			CONTINUE
		;素材の所持情報を確認
		SP_FUSION_LIST_MAKEABLE:COUNTLIST = 1
		FOR LCOUNT, 1, 4
			IF RESULT:LCOUNT > 0
				SP_FUSION_LIST_MATERIAL:COUNTLIST:(LCOUNT - 1) = RESULT:LCOUNT
				;素材悪魔を所持している
				SIF !MATCH(HAVE_DEVIL_NO_LIST, RESULT:LCOUNT)
					SP_FUSION_LIST_MAKEABLE:COUNTLIST = 0
				;造魔はレベル制限を見る
				SIF RESULT:LCOUNT == [[キャラ:조마]] && NEED_ZOUMA_LV_AT_SPECIAL_FUSION(L_CSV_NO) > HAVE_ZOUMA_MAXLV
					SP_FUSION_LIST_MAKEABLE:COUNTLIST = 0
			ELSEIF RESULT:LCOUNT < 0
				SIF !(HAVE_RACE_LIST:(-RESULT:LCOUNT))
					SP_FUSION_LIST_MAKEABLE:COUNTLIST = 0
			ELSE
				CONTINUE
			ENDIF
		NEXT
		COUNTLIST++
	CATCH
	ENDCATCH
NEXT
FOR LCOUNT, 0, SP_FUSION_LISTNUM
	IF SP_FUSION_LIST_DEVIL_NO:LCOUNT == 0
		DEVIL_LIST:LCOUNT = -1
		DEVIL_LIST_KEY:LCOUNT = 1000 * 1000 * 1000 * 1000
	ELSE
		DEVIL_LIST:LCOUNT = LCOUNT
		DEVIL_LIST_KEY:LCOUNT = CSVABL(SP_FUSION_LIST_DEVIL_NO:LCOUNT, GETNUM(ABL, "종족"))
		DEVIL_LIST_KEY:LCOUNT += (1000 - CSVBASE(SP_FUSION_LIST_DEVIL_NO:LCOUNT, GETNUM(BASE, "LV"))) * 1000
		DEVIL_LIST_KEY:LCOUNT += MAX(CSVCFLAG(SP_FUSION_LIST_DEVIL_NO:LCOUNT, GETNUM(CFLAG, "EXTRA출전")), 0) * 1000 * 1000
	ENDIF
NEXT
ARRAYMSORT DEVIL_LIST_KEY, DEVIL_LIST
RETURN COUNTLIST

@NEED_ZOUMA_LV_AT_SPECIAL_FUSION, L_NO
#FUNCTION
#DIM DYNAMIC L_NO
#DIM DYNAMIC NEED_LV
NEED_LV = CSVBASE(L_NO, GETNUM(BASE, "LV")) - 10
NEED_LV /= 10
NEED_LV *= 10
NEED_LV = MAX(NEED_LV, 1)
RETURNF NEED_LV