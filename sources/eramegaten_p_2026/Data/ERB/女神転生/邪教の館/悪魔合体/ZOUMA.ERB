;==========================================
;造魔のスキル継承チェック
;
;習得できない場合の代替スキルがあるならRESULTはそれで返す
;習得できるならスキル番号をそのまま返す
;==========================================
@IS_SUCCESSIONABLE_SKILL_ZOUMA, L_SKILL, ARG
#DIM L_SKILL
#DIM L_RESULT
L_RESULT = 1
;スキルがなかったら中断
SIF L_SKILL == 0
	L_RESULT = 0
;スキルがCSTR専用技だったら中断
SIF IS_PU_SKILLNUM(L_SKILL)
	L_RESULT = 0
;強度の高い継承不能
CALL GET_SKILL_PROP, "継承不能", L_SKILL, ARG
SIF RESULT == 2
	L_RESULT = 0
;---- EDIT 012 MOD START -------------------------
;敵専用/ロールチェック
CALL IS_SKILL_HAVEABLE, L_SKILL, ARG, "通常形態", "レベル習得時"
;---- EDIT 012 MOD END ---------------------------
SIF !RESULT
	L_RESULT = 0
;링크불능　固有のフラグ等を用いるスキルである可能性が高いので弾く
CALL GET_SKILL_PROP, "링크불능", L_SKILL, ARG
SIF RESULT
	L_RESULT = 0
IF L_RESULT == 0
	CALL GET_SKILL_PROP, "置換スキル", L_SKILL, ARG
	RETURN RESULT
ENDIF
RETURN L_SKILL
