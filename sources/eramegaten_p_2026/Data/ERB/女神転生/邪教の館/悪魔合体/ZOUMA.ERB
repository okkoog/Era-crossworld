	PRINTFORML \@ CFLAG:ARG:변경상성치1 < 0 ? 흡 # 　 \@\@ CFLAG:ARG:변경상성치1 != 999 ? {ABS(CFLAG:ARG:변경상성치1), 3}％ # %" "%반사 \@
	SETCOLOR LCOLOR
