@SHOW_ADD_INFO_ZOUMA, ARG
#DIM LCOUNT
#DIMS L_TALENT
#DIMS SHOW_LINE
SHOW_LINE = □資質：
FOR LCOUNT, 0, VARSIZE("TALENT")
	SIF GET_SUB_ROLE_NUM(TALENTNAME:LCOUNT) < 0
		CONTINUE
	SIF !TALENT:ARG:LCOUNT
		CONTINUE
	L_TALENT = [%GETS_SUB_ROLE_PROP("NAME", TALENTNAME:LCOUNT, ARG)%]
	CALL GET_TALENT_EXPLAIN, LCOUNT
	L_TALENT = <nonbutton title = '%RESULTS%'>%L_TALENT%</nonbutton>
	L_TALENT += " "
	IF (STRLENS(HTML_TOPLAINTEXT(SHOW_LINE)) + STRLENS(HTML_TOPLAINTEXT(L_TALENT))) > LINELENS
		HTML_PRINT SHOW_LINE
		SHOW_LINE = 　　　　
	ENDIF
	SHOW_LINE += L_TALENT
NEXT
SIF SHOW_LINE != ""
	HTML_PRINT SHOW_LINE
PRINTL 

DRAWLINE
SHOW_LINE = □継承：
FOR LCOUNT, 0, SUCCESSIONNUM
	L_TALENT = %GET_SUCCESSION(LCOUNT)%
	SIF !TALENT:ARG:L_TALENT
		CONTINUE
	CALL GET_TALENT_EXPLAIN, , L_TALENT
	L_TALENT = <nonbutton title = '%RESULTS%'>[%L_TALENT%]</nonbutton>
	L_TALENT += " "
	IF (STRLENS(HTML_TOPLAINTEXT(SHOW_LINE)) + STRLENS(HTML_TOPLAINTEXT(L_TALENT))) > LINELENS
		HTML_PRINT SHOW_LINE
		SHOW_LINE = 　　　　
	ENDIF
	SHOW_LINE += L_TALENT
NEXT
IF SHOW_LINE != ""
	IF SHOW_LINE == "□継承："
		PRINTL □계승: 없음
	ELSE
		HTML_PRINT SHOW_LINE
	ENDIF
ENDIF
PRINTL 
