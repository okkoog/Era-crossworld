;=====================================================
;素質継承チェック
;=====================================================
@SUCCESS_TALENT_CHECK,ARGS,ARGS:1 = "",ARG,ARG:1,ARG:2,ARG:3 = -1
#LOCALSIZE 3
;ARGS 継承チェックを行う素質
;ARGS:1 その相反する素質
LOCAL:1 = 0
IF TALENT:ARG:ARGS
	;ARGSを所持している場合
	;相反する素質が指定されていれば、持っている素材悪魔の数を数える
	IF ARGS:1 != ""
		FOR LOCAL , 1, 4
			SIF ARG:LOCAL < 0
				CONTINUE
			SIF TALENT:(ARG:LOCAL):(ARGS:1)
				LOCAL:1 ++
			SIF TALENT:(ARG:LOCAL):(ARGS)
				LOCAL:1 --
		NEXT
		;１Ｐ以上で打ち消し
		SIF LOCAL:1 >= 1
			TALENT:ARG:ARGS = 0
		;２Ｐ以上で相反する素質を継承
		SIF LOCAL:1 >= 2
			TALENT:ARG:(ARGS:1) = 1
	ELSE
		RETURN 0
	ENDIF
ELSEIF ARGS:1 != "" && TALENT:ARG:(ARGS:1)
	;ARGS:1を所持している場合
	;相反する素質が指定されていれば、持っている素材悪魔の数を数える
	FOR LOCAL , 1 , 4
		SIF ARG:LOCAL < 0
			CONTINUE
		SIF TALENT:(ARG:LOCAL):(ARGS)
			LOCAL:1 ++
		SIF TALENT:(ARG:LOCAL):(ARGS:1)
			LOCAL:1 --
	NEXT
		;１Ｐ以上で打ち消し
	SIF LOCAL:1 >= 1
		TALENT:ARG:(ARGS:1) = 0
		;２Ｐ以上で相反する素質を継承
	SIF LOCAL:1 >= 2
		TALENT:ARG:(ARGS) = 1
ELSE
	;どちらも持っていない場合
	;素質:ARGSを所持している素材悪魔を数える
	;相反する素質がある場合はその素質を持つ悪魔の数だけ減算
	FOR LOCAL , 1 , 4
		SIF ARG:LOCAL < 0
			CONTINUE
		SIF TALENT:(ARG:LOCAL):(ARGS)
			LOCAL:1 ++
		SIF ARGS:1 != "" && TALENT:(ARG:LOCAL):(ARGS:1)
			LOCAL:1 --
	NEXT
	;２Ｐ(相反する素質がある素質なら１Ｐ)以上で継承
	IF LOCAL:1 >= 2 || (ARGS:1 != "" && LOCAL:1 >= 1)
		TALENT:ARG:(ARGS) = 1
	;－１Ｐ以下なら相反する素質を継承
	ELSEIF LOCAL:1 <= -1
		TALENT:ARG:(ARGS:1) = 1
	ENDIF
ENDIF

;=====================================================
;戦闘素質の継承・発現処理
;=====================================================
@SUCCESS_BTL_TALENT, 完成品, 素材:0, 素材:1, 素材:2
#DIM LCOUNT, 2
#DIM L_CHARA
#DIMS TEMPS
#DIMS L_TALENT_LIST
#DIMS L_TALENTS
#DIMS CONST L_TALENT_TABLE = "파워부스터", "인트부스터", "매직부스터", "바이탈부스터", "스피드부스터", "럭부스터"
#DIM L_TALENT_LV
#DIM L_MAX_BASE_STAT
#DIM 完成品
#DIM 素材, 3
;-----------------------------------------------------
;完成品の発現素質を確認する
;CSV段階に記述がなかった場合はステータスブースト系が発現
;-----------------------------------------------------
SIF !SOFT_ON("메리크리스마스")
	RETURN 0
;---- EDIT 047 MOD START -------------------------
IF CSVCSTR(NO:完成品, GETNUM(CSTR, "잠재전투소질")) != ""
	L_TALENT_LIST = %CSVCSTR(NO:完成品, GETNUM(CSTR, "잠재전투소질"))%
	FOR LCOUNT, 0, STRCOUNT(L_TALENT_LIST, "/") + 1
		TEMPS = %AUTO_SPLIT(L_TALENT_LIST, "/", LCOUNT)%
		L_TALENTS = %AUTO_SPLIT(TEMPS, "_", 0)%
		SIF GET_ROLE_PROP(@"CAN_USE_%L_TALENTS%", 完成品) < 2
			CONTINUE
		L_TALENT_LV = MAX(TOINT(AUTO_SPLIT(TEMPS, "_", 1)), 1)
		TALENT:完成品:L_TALENTS = MAX(L_TALENT_LV, TALENT:完成品:L_TALENTS)
	NEXT
ELSE
	L_MAX_BASE_STAT = 0
	FOR LCOUNT, 1, BASESTATUSNUM
		SIF BASE:完成品:GET_BASESTATUS(LCOUNT) > L_MAX_BASE_STAT / 100
			L_MAX_BASE_STAT = BASE:完成品:GET_BASESTATUS(LCOUNT) * 100 + LCOUNT
	NEXT
	L_MAX_BASE_STAT %= 100
	L_TALENTS '= L_TALENT_TABLE:(L_MAX_BASE_STAT - 1)
	IF GET_ROLE_PROP(@"CAN_USE_%L_TALENTS%", 完成品) == 2
		L_TALENT_LV = 1 + (BASE:完成品:LV >= 30) + (BASE:完成品:LV >= 60)
		CSTR:完成品:잠재전투소질 = %L_TALENTS%_{L_TALENT_LV}
		TALENT:完成品:L_TALENTS = MAX(L_TALENT_LV, TALENT:完成品:L_TALENTS)
	ENDIF
ENDIF
FOR LCOUNT:1, 0, 3
	L_CHARA = 素材:(LCOUNT:1)
	SIF L_CHARA < 0
		CONTINUE
	SIF CSTR:L_CHARA:잠재전투소질 == ""
		CONTINUE
	L_TALENT_LIST = %CSTR:L_CHARA:잠재전투소질%
	FOR LCOUNT, 0, STRCOUNT(L_TALENT_LIST, "/") + 1
		TEMPS = %AUTO_SPLIT(L_TALENT_LIST, "/", LCOUNT)%
		L_TALENTS = %AUTO_SPLIT(TEMPS, "_", 0)%
		SIF GET_ROLE_PROP(@"CAN_USE_%L_TALENTS%", 完成品) < 2
			CONTINUE
		L_TALENT_LV = MAX(TOINT(AUTO_SPLIT(TEMPS, "_", 1)), 1)
		SIF TALENT:完成品:L_TALENTS >= L_TALENT_LV
			CONTINUE
		TALENT:完成品:L_TALENTS = L_TALENT_LV
		CALL ADD_潜在戦闘素質, 完成品, L_TALENTS, L_TALENT_LV
	NEXT
NEXT

;========================================
;潜在戦闘素質の追加関数
;既存のリストにより高いレベルのものが来た場合は置換する
;========================================
@ADD_潜在戦闘素質, L_CHARA, L_TALENT, L_TALENT_LV
#DIM LCOUNT
#DIM L_CHARA
#DIMS L_TALENT
#DIM L_TALENT_LV
#DIM TEMP
#DIMS TEMPS
#DIM TEMP_LV
TEMP = STRFIND(CSTR:L_CHARA:잠재전투소질, L_TALENT) >= 0
IF TEMP >= 0
	TEMP_LV = TOINT(SUBSTRING(CSTR:L_CHARA:잠재전투소질, TEMP + STRLENS(L_TALENT) + 1))
	SIF ISNUMERIC(SUBSTRING(CSTR:L_CHARA:잠재전투소질, TEMP + STRLENS(L_TALENT) + 2))
		TEMP_LV = TEMP_LV * 10 + TOINT(SUBSTRING(CSTR:L_CHARA:잠재전투소질, TEMP + STRLENS(L_TALENT) + 2))
	CSTR:L_CHARA:잠재전투소질 = %REPLACE(CSTR:L_CHARA:잠재전투소질, L_TALENT + "_\\d*/?", "")%
	CSTR:L_CHARA:잠재전투소질 = %ADD_SPLIT(CSTR:L_CHARA:잠재전투소질, "/", L_TALENT + "_" + TOSTR(MAX(TEMP_LV, L_TALENT_LV)))%
ELSE
	CSTR:L_CHARA:잠재전투소질 = %ADD_SPLIT(CSTR:L_CHARA:잠재전투소질, "/", L_TALENT + "_" + TOSTR(L_TALENT_LV))%
