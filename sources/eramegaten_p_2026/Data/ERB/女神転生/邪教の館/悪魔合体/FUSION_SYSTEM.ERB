ENDIF
FOR LCOUNT:1, 0, 3
	IF 素材:(LCOUNT:1) <= 0
		IF L_MODE == "逆引き合体"
			VARS TEMPS
			IF SP_素材:(LCOUNT:1) == 0
				PRINTL 
				PRINTL 
				PRINTL 
			ELSE
				IF SP_素材:(LCOUNT:1) > 0
					TEMPS '= CSVCALLNAME(SP_素材:(LCOUNT:1))
				ELSE
					TEMPS '= GET_RACE(ABS(SP_素材:(LCOUNT:1)))
				ENDIF
				TEMPS '= @"[{900 + LCOUNT:1}] " + TEMPS
				IF SP_FUSION_LIST_MAKEABLE:SP_FUSION_LISTNO
					HTML_PRINT SET_BUTTON_TAG(TEMPS, TOSTR(900 + LCOUNT:1))
				ELSE
					HTML_PRINT TEMPS
				ENDIF
				PRINTL 
				PRINTL 
			ENDIF
		ENDIF
		SIF GETBIT(FLAG:커스텀게임화면,1) == 0
			DRAWLINE
	ELSE
		IF L_MODE == "逆引き合体"
			PRINTBUTTON @"[{900 + LCOUNT:1}] " + TOALIGNMENT(CALLNAME:(素材:(LCOUNT:1)), 24, "LEFT"), 900 + LCOUNT:1
		ELSE
			PRINTFORM 소지스킬 %CHARATU("첫두세", LCOUNT:1)%번째:%CALLNAME:(素材:(LCOUNT:1)), 24, LEFT%
		ENDIF
		IF L_MODE == "継承スキル選択中"
			PRINT (
			PRINTFORM 소지ＭＡＧ:{GET_CHARA_STOCK_MAG(素材:(LCOUNT:1)), 10}
			PRINT 　　
			PRINTFORM 충성도:{GET_CHARA_LOYALTY((素材:(LCOUNT:1))), 7} 　추출가능:
			IF COUNT_ABLE_MAKE_SKILLCARD(素材:(LCOUNT:1)) == 100
				PRINT 99+ 
			ELSE
				PRINTFORM {COUNT_ABLE_MAKE_SKILLCARD(素材:(LCOUNT:1)),2}회
			ENDIF
			PRINT )
		ENDIF
		PRINTL 
		SHOW_LINE = 
		FOR LCOUNT,1,CHARA_SKILLCOUNT(素材:(LCOUNT:1)) + 1
			L_SKILL = ABL:(素材:(LCOUNT:1)):@"스킬{LCOUNT}"
			VARS L_VALUES
			IF L_MODE == "継承スキル選択中"
				L_VALUES '= TOSTR((LCOUNT:1 + 4) * HAVEABLE_SKILLNUM + LCOUNT)
			ELSE
				L_VALUES '= TOSTR((LCOUNT:1 + 1) * HAVEABLE_SKILLNUM + LCOUNT)
			ENDIF
			TEMPS = %@"　[%L_VALUES,3%] "%
			IF L_SKILL > 0
				;置換チェック
				CALL GET_REPLACE_SKILL, L_SKILL, 完成品
				L_SKILL = RESULT
				CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, 素材:(LCOUNT:1)
				TEMPS += @"%RESULTS, SKILLNAMELENS:GETBIT(FLAG:커스텀게임화면,1), LEFT%"
				;TEMPS = 　[{(LCOUNT:1 + 1) * HAVEABLE_SKILLNUM + LCOUNT,2}] %RESULTS, SKILLNAMELENS:GETBIT(FLAG:커스텀게임화면,1), LEFT%
				L_TITLE = スキルカード所持枚数:{ITEM:(10000 + L_SKILL)} \@ABLE_MAKESKILLCARD(L_SKILL) ? 複製:◯ # \@
				CALL GET_SKILL_EXPLAIN_TOOLTIP, L_SKILL, 素材:(LCOUNT:1)
				L_TITLE = %ADD_SPLIT(L_TITLE, UNICODE(0x000D) * 2, RESULTS)%
				TEMPS = %SET_BUTTON_TAG(TEMPS, L_VALUES, L_TITLE)%
				SKILLCOLOR = 0
				CALL IS_SUCCESSABLE_FUSION_SKILL, 完成品, L_SKILL
				IF RESULT
					;素材と完成品で共通しているスキルかどうか
					SIF HAVE_SKILL(完成品, L_SKILL)
						SETBIT SKILLCOLOR, 0
					;素材同士で共通しているスキルかどうか
					FOR LCOUNT:2, 0, 3
						SIF 素材:(LCOUNT:2) <= 0
							CONTINUE
						SIF HAVE_SKILL(素材:(LCOUNT:2), L_SKILL)
							SETBIT SKILLCOLOR, LCOUNT:2 + 1
					NEXT
					IF MATCH(FUSION_CSV_HAVESKILL, L_SKILL)
						;継承確定時でない場合はグレー
						IF L_MODE == "継承スキル選択中"
							TEMPS = %SET_COLOR_TAG(TEMPS, "gray")%
						ENDIF
					;完成品の初期スキルにない場合は着色
					ELSE
						;完成品に継承されているスキル
						IF GETBIT(SKILLCOLOR, 0)
							;素材が複数所持
							IF GETBIT(SKILLCOLOR, 1) + GETBIT(SKILLCOLOR, 2) + GETBIT(SKILLCOLOR, 3) > 1
								TEMPS = %SET_COLOR_TAG(TEMPS, "#ff69b4")%
								;SETCOLOR 0xff69b4
							ELSE
								SIF GETBIT(SKILLCOLOR, 1)
									TEMPS = %SET_COLOR_TAG(TEMPS, "aqua")%
								SIF GETBIT(SKILLCOLOR, 2)
									TEMPS = %SET_COLOR_TAG(TEMPS, "#00ff00")%
								SIF GETBIT(SKILLCOLOR, 3)
									TEMPS = %SET_COLOR_TAG(TEMPS, "yellow")%
							ENDIF
						ENDIF
					ENDIF
				ELSE
					;継承不能スキル
					TEMPS = %SET_COLOR_TAG(TEMPS, "gray")%
				ENDIF
			ELSE
				TEMPS += @"%"EMPTY", SKILLNAMELENS:GETBIT(FLAG:커스텀게임화면,1), LEFT%"
				TEMPS = %SET_COLOR_TAG(TEMPS, "gray")%
			ENDIF
			SHOW_LINE += TEMPS
			IF GETBIT(FLAG:커스텀게임화면,1)
				IF LCOUNT % 3 == 0
					HTML_PRINT SHOW_LINE
					SHOW_LINE = 
				ENDIF
			ELSE
				IF LCOUNT % 4 == 0
					HTML_PRINT SHOW_LINE
					SHOW_LINE = 
				ENDIF
			ENDIF
		NEXT
		SIF SHOW_LINE != ""
			HTML_PRINT SHOW_LINE
		SIF GETBIT(FLAG:커스텀게임화면,1) == 0
			DRAWLINE
	ENDIF
NEXT

;========================================
;継承スキル選択処理
;========================================
@SELECT_SUCCESS_SKILL, 完成品, 素材:0, 素材:1, 素材:2, L_SUCCESS_LIST
#DIM LCOUNT, 3
#DIM L_CHARA
#DIM L_SKILL,2
#DIMS L_SKILLNAME
#DIM L_LINE,2
#DIM 完成品
#DIM 素材, 3
#DIM TEMP
#DIMS TEMPS
#DIM HAVE_SKILLNUM
#DIMS SHOW_LINE
#DIM L_COLOR
#DIM L_SHOW_LIST, HAVEABLE_SKILLNUM * 4 + 1 + 1
#DIM REF L_SUCCESS_LIST
#DIM SKILL_DEL_ABLE
#DIM SKILL_MAKECARD_ABLE
#DIMS L_VALUE
#DIMS L_TITLE
#DIMS L_ADD_INFO
#DIM CONST SHOWNUM = 24
L_LINE = LINECOUNT
VARSET L_SUCCESS_LIST
$START
CLEARLINE LINECOUNT - L_LINE

VARSET L_SHOW_LIST
;リスト作成
FOR LCOUNT, 0, VARSIZE("FUSION_CSV_HAVESKILL")
	L_SHOW_LIST:FINDELEMENT(L_SHOW_LIST, 0) = FUSION_CSV_HAVESKILL:LCOUNT
NEXT
FOR LCOUNT, 0, VARSIZE("FUSION_SUCCESS_ABLE_LIST")
	SIF MATCH(L_SHOW_LIST, FUSION_SUCCESS_ABLE_LIST:LCOUNT)
		CONTINUE
	L_SHOW_LIST:FINDELEMENT(L_SHOW_LIST, 0) = FUSION_SUCCESS_ABLE_LIST:LCOUNT
NEXT
VARI CNT_SKILL
FOR LCOUNT, 1, CHARA_SKILLCOUNT(完成品) + 1
	ABL:完成品:@"스킬{LCOUNT}" = 0
NEXT
;継承候補が消えてたらリストからも抜く
FOR LCOUNT, 0, HAVEABLE_SKILLNUM
	SIF !MATCH(FUSION_SUCCESS_ABLE_LIST, L_SUCCESS_LIST:LCOUNT)
		L_SUCCESS_LIST:LCOUNT = 0
NEXT
FOR LCOUNT, 0, VARSIZE("L_SHOW_LIST")
	L_SKILL = L_SHOW_LIST:(LCOUNT)
	SIF !MATCH(FUSION_CSV_HAVESKILL, L_SKILL) && !MATCH(L_SUCCESS_LIST, L_SKILL)
		CONTINUE
	ABL:完成品:@"스킬{CNT_SKILL + 1}" = L_SKILL
	CNT_SKILL++
	SIF CNT_SKILL > CHARA_SKILLCOUNT(完成品)
		BREAK
NEXT
DRAWLINE
PRINTL □스킬계승/추출
DRAWLINE
VARSET HAVE_SKILLNUM
FOR LCOUNT, 0, SHOWNUM
	SHOW_LINE = 
	FOR LCOUNT:1, 0, 2
		SIF LCOUNT:1
			SHOW_LINE += " " * 4
		TEMPS = 
		L_SKILL = L_SHOW_LIST:(LCOUNT + LCOUNT:1 * SHOWNUM)
		L_VALUE = {LCOUNT + LCOUNT:1 * SHOWNUM + 1}
		L_TITLE '= ""
		IF L_SKILL > 0
			L_SKILL:1 = L_SKILL
			CALL GET_REPLACE_SKILL, L_SKILL, 完成品
			L_SKILL = RESULT
			L_ADD_INFO = 
			IF MATCH(FUSION_CSV_HAVESKILL, L_SKILL)
				L_TITLE = %ADD_SPLIT(CALLNAME:完成品, UNICODE(0x00D), L_TITLE)%
				CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, 完成品
				TEMPS = [◎] [%L_VALUE,2%] %SUBSTRING(RESULTS, 0, 23), 23, LEFT%
				L_ADD_INFO += " " * 26
				CALL GET_SKILL_EXPLAIN_TOOLTIP, L_SKILL, 完成品
				L_TITLE = %ADD_SPLIT(L_TITLE, UNICODE(0x000D) * 2, RESULTS)%
			ELSE
				CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILL, 完成品
				L_TITLE '= ""
				IF TALENT:完成品:GET_SUCCESSION(RESULT)
					L_ADD_INFO += SET_COLOR_TAG("素質:◯", "p-red")
					L_TITLE += "素質:◯"
				ELSE
					L_ADD_INFO += "素質:×"
					L_TITLE += "素質:×"
				ENDIF
				L_ADD_INFO += " "
				L_ADD_INFO += @"カード:{ITEM:(10000 + L_SKILL), 3} "
				IF ABLE_MAKESKILLCARD(L_SKILL)
					L_ADD_INFO += SET_COLOR_TAG("複製:◯", "p-red")
					L_TITLE += "複製:◯"
				ELSE
					L_ADD_INFO += "複製:×"
					L_TITLE += "複製:×"
				ENDIF
				FOR LCOUNT:2, 0, 3
					TEMP = HAVE_SKILL(素材:(LCOUNT:2), L_SKILL:1, 1)
					SIF TEMP == 0
						CONTINUE
					L_TITLE = %ADD_SPLIT(CALLNAME:(素材:(LCOUNT:2)), UNICODE(0x00D), L_TITLE)%
					CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, 素材:(LCOUNT:2)
					TEMPS += @"[%L_VALUE, 2%] %SUBSTRING(RESULTS, 0, 23), 23, LEFT%"
					IF HAVE_SKILL(完成品, L_SKILL:1)
						SELECTCASE LCOUNT:2
							CASE 0
								TEMPS = %SET_COLOR_TAG(TEMPS, "aqua")%
							CASE 1
								TEMPS = %SET_COLOR_TAG(TEMPS, "0x00ff00")%
							CASE 2
								TEMPS = %SET_COLOR_TAG(TEMPS, "yellow")%
						ENDSELECT
						TEMPS = %SET_COLOR_TAG("[◯]", "p-red")% %TEMPS%
					ELSE
						TEMPS = %SET_COLOR_TAG("[✕]", "gray")% %TEMPS%
					ENDIF
					CALL GET_SKILL_EXPLAIN_TOOLTIP, L_SKILL, 素材:(LCOUNT:2)
					L_TITLE = %ADD_SPLIT(L_TITLE, UNICODE(0x000D) * 2, RESULTS)%
					BREAK
				NEXT
			ENDIF
			TEMPS = %SET_BUTTON_TAG(TEMPS, L_VALUE, L_TITLE)%
			TEMPS += " " * 2 + L_ADD_INFO
			SHOW_LINE += TEMPS
		ELSE
			SHOW_LINE += " " * 64
		ENDIF
	NEXT
	HTML_PRINT SHOW_LINE
NEXT
DRAWLINE
CALL SHOW_SUCCESS_SKILL, "継承スキル選択中", 完成品, 素材:0, 素材:1, 素材:2
PRINTL [ 0] 결정　　　　　[999] 취소
INPUT
IF RESULT == 0
	IF MAXARRAY(L_SUCCESS_LIST) == 0
		PRINTFORML 스킬 계승을 실행하지 않았습니다만 이대로 합체를 마치겠습니까?
		CALL INPUT_YN
		SIF RESULT == 1
			GOTO START
	ENDIF		
	FOR LCOUNT, 1, CHARA_SKILLCOUNT(完成品) + 1
		CALL GET_REPLACE_SKILL, ABL:完成品:@"스킬{LCOUNT}", 完成品
		ABL:完成品:@"스킬{LCOUNT}" = RESULT
	NEXT
	RETURN 1
ENDIF
SIF RESULT == 999
	RETURN 0
IF INRANGE(RESULT, 1, FINDELEMENT(L_SHOW_LIST, 0))
	RESULT -= 1
	IF MATCH(L_SUCCESS_LIST, L_SHOW_LIST:RESULT)
		L_SUCCESS_LIST:FINDELEMENT(L_SUCCESS_LIST, L_SHOW_LIST:RESULT) = 0
	ELSE
		IF (VARSIZE("FUSION_CSV_HAVESKILL") - MATCH(FUSION_CSV_HAVESKILL, 0) + VARSIZE("L_SUCCESS_LIST") - MATCH(L_SUCCESS_LIST, 0)) < CHARA_SKILLCOUNT(完成品)
			L_SUCCESS_LIST:FINDELEMENT(L_SUCCESS_LIST, 0) = L_SHOW_LIST:RESULT
		ENDIF
	ENDIF
	GOTO START
ENDIF
;継承選択用の番号を抜く
RESULT -= HAVEABLE_SKILLNUM * 4
SIF !INRANGE(RESULT, 1, HAVEABLE_SKILLNUM * 3 + 1)
	GOTO START
L_CHARA = 素材:(((RESULT-1) / HAVEABLE_SKILLNUM))
SIF L_CHARA <= 0
	GOTO START
HAVE_SKILLNUM = RESULT % HAVEABLE_SKILLNUM
L_SKILL = ABL:L_CHARA:@"스킬{HAVE_SKILLNUM}"
SIF !L_SKILL
	GOTO START
CALL MAG_ENHANCE_INFO_CHARA, L_CHARA

CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, L_CHARA
L_SKILLNAME = %RESULTS%
DRAWLINE
PRINTFORML □%L_SKILLNAME%
DRAWLINE
SIF FLAG:스킬속성표시설정 == 1
	CALL SKILL_EXPLAIN_PERFORMANCE, L_SKILL, L_CHARA
CALL GET_SKILL_PROP, "SKILL_EXPLAIN", L_SKILL, L_CHARA
DRAWLINE
L_LINE:1 = LINECOUNT
$START2
CLEARLINE LINECOUNT - L_LINE:1
PRINTL [0] 취소

SKILL_DEL_ABLE = 0
SKILL_MAKECARD_ABLE = 0
IF !GET_ROLE_PROP("CAN_MAKE_SKILLCARD", L_CHARA)
	CALL PRINT_COLOR, "[1] スキル抽出不能", COLOR("gray"), "L"
ELSE
	;抽出可能か確認
	CALL IS_MAKEABLE_SKILLCARD, L_SKILL
	IF RESULT
		IF GET_LOYALTY_FOR_MAKE_SKILLCARD(L_CHARA, "必要") > GET_CHARA_LOYALTY(L_CHARA)
			CALL PRINT_COLOR, @"[1] 忠誠度不足", COLOR("gray"), "L"
		ELSE
			PRINTFORML [1] 스킬 추출(충성도:{GET_LOYALTY_FOR_MAKE_SKILLCARD(L_CHARA, "消費")} 소비)
			SKILL_MAKECARD_ABLE = 1
		ENDIF
	ELSE
		CALL PRINT_COLOR, "[2] 抽出不能スキル", COLOR("gray"), "L"
	ENDIF
ENDIF
CALL INPUTINT, 0, SKILL_MAKECARD_ABLE
CLEARLINE LINECOUNT - L_LINE:1
SELECTCASE RESULT
	CASE 0
		GOTO START
	CASE 1
		CLEARLINE LINECOUNT - L_LINE:1
		PRINTFORMW %CALLNAME:L_CHARA%에게서 %L_SKILLNAME%의 스킬카드를 추출했다.
		CALL GET_ITEM, 10000 + L_SKILL, 1
		CALL CONTROL_LOYALTY, L_CHARA, -GET_LOYALTY_FOR_MAKE_SKILLCARD(L_CHARA, "消費")
		CFLAG:L_CHARA:스킬추출횟수 += 1
ENDSELECT
CALL DEL_FRIEND_HAVE_SKILL, L_CHARA, , , HAVE_SKILLNUM
CALL SKILL_EQUIPTHEORY_DEL_SKILL, L_CHARA, L_SKILL
CALL SYNC_STATUS,L_CHARA
CALL HEALTH_CHARA,L_CHARA

;完成品のスキルを一旦差し戻して継承をやりなおす
FOR LCOUNT, 0, VARSIZE("FUSION_CSV_HAVESKILL")
	ABL:完成品:@"스킬{LCOUNT+1}" = FUSION_CSV_HAVESKILL:LCOUNT
NEXT
CALL SET_SUCCESS_SKILLLIST, 完成品, 素材:0, 素材:1, 素材:2, FLAG:SHOP커맨드 == [[ショップ:사교의관]]
GOTO START

;========================================
;手紙システム
;	ARG:1（0:通常合体　1:魔晶武具　2:スキルカード　3:造魔作成　4:造魔強化　5:造魔初期化 6:イケニエ）
;========================================
@FUSION_LETTER,ARG,ARG:1
PRINTL 편지가 있습니다。읽어봅니까？		
CALL INPUT_YN,"Yes","NO"
IF RESULT == 0
	TRYCCALLFORM FUSION_LETTER_MESSAGE_K{NO:ARG},ARG,ARG:1
	CATCH
		TRYCCALLFORM FUSION_LETTER_MESSAGE_PUB{ABL:(ARG):회화타입},ARG,ARG:1
		CATCH
			PRINTFORMW %CALLNAME:(ARG)%에게서 온 편지다.
			CALL FUSION_LETTER_MESSAGE_PUB,ARG,ARG:1
		ENDCATCH
	ENDCATCH
ENDIF

;=====================================================
;合体事故発生チェック
;ARG = ダンジョンかどうか
;=====================================================
@FUSION_ACCIDENT_CHECK, L_MATERIAL:0, L_MATERIAL:1, L_MATERIAL:2 = -1
#FUNCTION
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_RESULT
#DIM DYNAMIC L_MATERIAL, 3
;アルバートの効果中は発生しない
SIF SOFT_ON("알버트")
	RETURNF 0
; 合体事故確率初期値設定
L_RESULT = 1
; 月齢をチェックして、基本確率を算出
SELECTCASE FLAG:월령
	; 新月は1%
	CASE 0
		L_RESULT *= 1
	; 満月は4%
	CASE 8
		L_RESULT *= 4
	; その他は2%
	CASEELSE
		L_RESULT *= 2
ENDSELECT

FOR LCOUNT, 0, 3
	SIF L_MATERIAL:LCOUNT < 0
		CONTINUE
	;怪異を素材に使っている場合は事故率があがる。
	SIF GET_RACE(ABL:(L_MATERIAL:LCOUNT):종족) == "괴이"
		L_RESULT *= 3
NEXT
; 探索中なら3倍
SIF FLAG:SHOP커맨드 == [[ショップ:탐색]]
	L_RESULT = L_RESULT * 3
; コペルニクスで五倍
SIF SOFT_ON("코페르니쿠스")
	L_RESULT = L_RESULT * 5
DEBUGPRINTFORML 合体事故発生率:{L_RESULT}
IF L_RESULT == 0
	RETURNF 0
ELSEIF RAND:100 < L_RESULT
	RETURNF 1
ENDIF
RETURNF 0
