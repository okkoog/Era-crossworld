;========================================
;合体時の経験値継承処理
;========================================
@SUCCESS_BTL_EXP,ARG,ARG:1,ARG:2,ARG:3 = -1
#DIM DYNAMIC 経験値
#DIM DYNAMIC LCOUNT
FOR LCOUNT , 1, 4
	SIF ARG:LCOUNT < 0
		CONTINUE
	経験値 += TOTAL_TAKE_EXP:(ARG:LCOUNT):0
NEXT

SELECTCASE 3 - MATCH(ARG, -1, 1, 4)
	CASE 3
		TIMES 経験値, 0.5
	CASE 2
		TIMES 経験値, 0.7
	CASE 1
		TIMES 経験値, 1.0
ENDSELECT
IF FLAG:SHOP커맨드 != [[ショップ:사교의관]]
	BASE:ARG:ＥＸＰ += 経験値/2
ELSE
	BASE:ARG:ＥＸＰ += 経験値
ENDIF

;========================================
;MAGとMAGの強化値の引き継ぎ
;========================================
@SUCCESS_MAG_ENHANCE, 完成品, 素材:0, 素材:1, 素材:2
#DIM LCOUNT
#DIM 完成品
#DIM 素材, 3
#DIM L_HAVE_MAG
#DIM L_USE_ENHANCE_MAG
#DIM CNT_FREE_BASE_ENHANCE
;能力強化に使った分は引き継がれる
;ただ、MAGに還元して引き継がせると持ちきれないケースが発生するので
;強化使用分は無償でMAG強化をするのに使えるという形で還元させる
CNT_FREE_BASE_ENHANCE = 0
L_HAVE_MAG = 0
L_USE_ENHANCE_MAG = 0

;MAGの取得
FOR LCOUNT, 0, 3
	SIF 素材:LCOUNT <= 0
		CONTINUE
	L_HAVE_MAG += GET_CHARA_STOCK_MAG(素材:LCOUNT)
	L_HAVE_MAG += HIDDEN_MAG:(素材:LCOUNT):0
	L_USE_ENHANCE_MAG += CFLAG:(素材:LCOUNT):강화사용ＭＡＧ
NEXT

;手持ちMAGが完成品の所持上限を超えてしまう場合は強化の判定にまわす
IF GET_CHARA_MAXMAG(完成品) < L_HAVE_MAG
	L_USE_ENHANCE_MAG += L_HAVE_MAG - GET_CHARA_MAXMAG(完成品)
	L_HAVE_MAG = GET_CHARA_MAXMAG(完成品)
ENDIF

;ふれなくなるまでふらせる
WHILE L_USE_ENHANCE_MAG >= MAG_CALC_ENHANCE_BASE(完成品, CNT_FREE_BASE_ENHANCE)
	L_USE_ENHANCE_MAG -= MAG_CALC_ENHANCE_BASE(完成品, CNT_FREE_BASE_ENHANCE)
	CFLAG:(完成品):강화사용ＭＡＧ += MAG_CALC_ENHANCE_BASE(完成品, CNT_FREE_BASE_ENHANCE)
	CNT_FREE_BASE_ENHANCE++
WEND
;能力強化回数を確定。この回数が実際に振られてる数値より高い限り、必要コストが0になる。
CFLAG:完成品:능력강화횟수 = CNT_FREE_BASE_ENHANCE
;完成品の初期MAGは計算しておいた手持ちMAGの合計と強化MAGの余りになる
CALL CONTROL_MAG,完成品, L_HAVE_MAG + L_USE_ENHANCE_MAG

