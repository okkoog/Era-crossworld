;========================================
;継承のベース関数
;素質・戦闘素質・MAG・忠誠度を扱う。
;========================================
@FUSION_SUCCESS_BASE, 完成品, 素材:1, 素材:2, 素材:3, IS_ACCIDENT
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC IS_ACCIDENT
#DIM DYNAMIC FUSION_NO
#DIM DYNAMIC 素材 , 4
#DIM DYNAMIC 完成品 , 1
#DIM DYNAMIC レベル不足合体
FUSION_NO = NO:完成品

;スキル継承
CALL SET_SUCCESS_SKILLLIST,完成品,素材:1,素材:2,素材:3
;邪教の館なら更に素質も継承
SIF (FLAG:SHOP커맨드 == [[ショップ:사교의관]] || IS_ACCIDENT) && !SOFT_ON("뉴턴")
	CALL SUCCESS_TALENT,完成品,素材:1,素材:2,素材:3
;戦闘素質の継承と発現
CALL SUCCESS_BTL_TALENT,完成品,素材:1,素材:2,素材:3
;MAG強化の引継ぎ
CALL SUCCESS_MAG_ENHANCE,完成品,素材:1,素材:2,素材:3

;忠誠度を決定
BASE:完成品:충성도 = 0
FOR LCOUNT, 1, 4
	SIF 素材:LCOUNT < 0
		CONTINUE
	CALL CONTROL_LOYALTY, 完成品, GET_CHARA_LOYALTY((素材:LCOUNT)) / 2
NEXT
BASE:完成品:충성도 = MAX(GET_CHARA_LOYALTY(完成品), 100)

;----------------------------------------
;ガチャ素質の継承
;素材全てがガチャ産である場合のみガチャ素質を継承する
;----------------------------------------
TALENT:完成品:가챠 = 1
FOR LCOUNT, 1, 4
	SIF 素材:LCOUNT < 0
		CONTINUE
	SIF TALENT:(素材:LCOUNT):가챠
		CONTINUE
	TALENT:完成品:가챠 = 0
NEXT

;ラジエルの書装備中なら一部素質やランクアップ先を変化
SIF SOFT_ON("라지엘의서") && EXTRACHECK_DEVIL_CHILDREN(NO:完成品)
	CALL EXTRA_DEVIL_CHILDREN , 完成品
;ステータス強化
CALL SUCCESS_BTL_EXP,完成品,素材:1,素材:2,素材:3
CALL SYNC_STATUS,完成品
	
;表示用に忠誠度を変更しておく
レベル不足合体 = 0
IF (BASE:(完成品):LV > BASE:MASTER:LV) && (SOFT_ON("스티븐") == 0)
	IF GET_CHARA_LOYALTY(完成品) >= POWER(BASE:(完成品):LV - (BASE:MASTER:LV + FLAG:경험ED수) , 2)*500
		レベル不足合体 = 1
		CALL CONTROL_LOYALTY, 完成品, -(POWER(BASE:(完成品):LV - (BASE:MASTER:LV + FLAG:경험ED수) , 2)*500)
	ENDIF
ENDIF
RETURN レベル不足合体

;=====================================================
;スキル継承用にスキルをリスト化して登録する
;=====================================================
@SET_SUCCESS_SKILLLIST,ARG,ARG:1,ARG:2,ARG:3 = -1,ARG:4 = 0
#DIM LCOUNT, 2
#DIM CHARA , 1
#DIM カウント , 1
#DIM SKILL, 2
;ARG = 合体後悪魔
;ARG:1 = 合体前悪魔Ａ
;ARG:2 = 同Ｂ
;ARG:3 = 同Ｃ
;ARG:4 = 真の時、邪教の館での合体扱いとなる
;LOCAL = 継承スキル(仮)
;LOCAL:1 = 優先度
;LOCAL:3 = LOCALのスキルの優先度（保存用）
;LOCALS:1 = 継承するスキル枠

;継承を実行する前のスキルを記録しておく
VARSET FUSION_CSV_HAVESKILL
VARSET FUSION_SUCCESS_ABLE_LIST
FOR LCOUNT, 0, CHARA_SKILLCOUNT(ARG)
	FUSION_CSV_HAVESKILL:LCOUNT = ABL:ARG:@"스킬{LCOUNT + 1}"
NEXT
;スキルカードを使えないロールは継承できない(要するに達人ははじく)
SIF !GET_ROLE_PROP("CAN_USE_SKILLCARD", ARG)
	RETURN 0
FOR LCOUNT:1, 1, 4
	CHARA = ARG:(LCOUNT:1)
	SIF CHARA <= 0
		CONTINUE
	FOR LCOUNT, 0, CHARA_SKILLCOUNT(CHARA)
		SKILL = ABL:CHARA:@"스킬{LCOUNT+1}"
		SKILL:1 = SKILL
		CALL GET_REPLACE_SKILL, SKILL, CHARA
		SKILL = RESULT
		;ソート用NO
		SIF !SKILL
			CONTINUE
		;所持しているスキルは省く
		SIF MATCH(FUSION_CSV_HAVESKILL, SKILL)
			CONTINUE
		CALL IS_SUCCESSABLE_FUSION_SKILL, ARG, SKILL
		IF RESULT
			;ソート用に下一桁をあける
			;素質あり・継承部位ありの場合は無視できる場合でも優先度をあげる(ランクよりは優先されない)
			;条件無視スキルは判定しない
			;継承タイプ読み込み、ARGが継承できるタイプでなければ次へ
			CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", SKILL, ARG
			SIF !RANGE(RESULT, 0, 22)
				CONTINUE
			SKILL:1 += 1 * 100000 * 100
			;---- EDIT 039 MOD START -------------------------
			;継承部位を持っている場合は優先度をあげる
			CALL HAVE_SKILL_SUCCESSION_BODY, ARG, SKILL
			IF RESULT
				SKILL:1 += 1 * 100000 * 100
			ENDIF
			CALL GET_SKILL_PROP, "SKILL_RANK", SKILL, ARG
			SIF !RESULT
				CONTINUE
			;整列用にランクをいれる
			FUSION_SUCCESS_ABLE_LIST:FINDELEMENT(FUSION_SUCCESS_ABLE_LIST, 0) = SKILL:1 + RESULT * 100000
		ENDIF
	NEXT
NEXT
ARRAYSORT FUSION_SUCCESS_ABLE_LIST, BACK
;ソート用の数値をひっぺがす
FOR LCOUNT, 0, VARSIZE("FUSION_SUCCESS_ABLE_LIST")
	SIF !FUSION_SUCCESS_ABLE_LIST
		BREAK
	FUSION_SUCCESS_ABLE_LIST:LCOUNT %= 100000
NEXT

;========================================
;スキルごとの継承可能かどうかの確認関数
;========================================
@IS_SUCCESSABLE_FUSION_SKILL, L_CHARA, L_SKILL
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_SKILL
#DIM DYNAMIC L_SUCCESSION
CALL GET_SKILL_PROP, "継承不能", L_SKILL, L_CHARA
SIF RESULT
	RETURN 0
CALL GET_SKILL_PROP, "ロール専用", L_SKILL, L_CHARA
SIF RESULT
	RETURN 0
;継承タイプ読み込み、ARGが継承できるタイプでなければ次へ
CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILL, L_CHARA
L_SUCCESSION = RESULT
SIF !RANGE(L_SUCCESSION, 0, 22)
	RETURN 0
SELECTCASE GET_SKILL_CHANGEABLE_RANK(L_CHARA)
	CASE 1
		SIF L_SUCCESSION != 22
			RETURN 0
	CASE 2
		SIF !TALENT:L_CHARA:GET_SUCCESSION(L_SUCCESSION)
			RETURN 0
ENDSELECT

;---- EDIT 039 MOD START -------------------------
;ランクが正常範囲でないスキルは継承しない
CALL GET_SKILL_PROP, "SKILL_RANK",L_SKILL, L_CHARA
SIF !RANGE(RESULT, 1, 15)
	RETURN 0
RETURN 1

;========================================
;ABL引き継ぎ時に、そもそもそのレベルのABLが存在するかを調べる
;========================================
@ABL引き継ぎチェック(ARG,ARG:1,ARG:2 = -1)
#FUNCTION
LOCAL:1 = 0
IF ARG:2 < 1
	FOR LOCAL,0,26
		LOCAL:1 = MAX(ABL:ARG:LOCAL , ABL:(ARG:1):LOCAL , LOCAL:1)
	NEXT
ELSE
	FOR LOCAL,0,26
		LOCAL:1 = MAX(ABL:ARG:LOCAL , ABL:(ARG:1):LOCAL, ABL:(ARG:2):LOCAL , LOCAL:1)
	NEXT
ENDIF
RETURNF LOCAL:1

