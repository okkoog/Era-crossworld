			CASE 7
				RETURNF 10
			CASE 8
				RETURNF 50
			CASE 9
				RETURNF 500
			CASE 10
				RETURNF 5000
			CASE 11
				RETURNF 50000
			CASE 12,13,14
				RETURNF 100000
		ENDSELECT
	CASE 15
		SELECTCASE ARG:1
			CASE 0
				RETURNF 30
			CASE IS < 7
				RETURNF 0
			CASE 7
				RETURNF 3
			CASE 8
				RETURNF 30
			CASE 9
				RETURNF 100
			CASE 10
				RETURNF 1000
			CASE 11
				RETURNF 10000
			CASE 12,13,14,15
				RETURNF 100000
		ENDSELECT
	CASE 16
		SELECTCASE ARG:1
			CASE 0
				RETURNF 50
			CASE IS < 7
				RETURNF 0
			CASE 7
				RETURNF 3
			CASE 8
				RETURNF 20
			CASE 9
