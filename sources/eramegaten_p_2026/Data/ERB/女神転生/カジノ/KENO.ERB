			CASE 8
				RETURNF 100
			CASE 9
				RETURNF 1000
			CASE 10
				RETURNF 10000
			CASE 11,12,13
				RETURNF 100000
		ENDSELECT
	CASE 14
		SELECTCASE ARG:1
			CASE IS < 6
				RETURNF 0
			CASE 6
