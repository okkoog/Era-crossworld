		ENDSELECT
	CASE 9
		SELECTCASE ARG:1
			CASE IS < 5
				RETURNF 0
			CASE 5
				RETURNF 10
			CASE 6
				RETURNF 50
			CASE 7
				RETURNF 500
			CASE 8
				RETURNF 5000
			CASE 9
				RETURNF 50000
		ENDSELECT
	CASE 10
		SELECTCASE ARG:1
			CASE IS < 5
				RETURNF 0
			CASE 5
				RETURNF 5
			CASE 6
				RETURNF 20
			CASE 7
				RETURNF 200
			CASE 8
				RETURNF 2000
			CASE 9
				RETURNF 20000
			CASE 10
				RETURNF 100000
		ENDSELECT
	CASE 11
		SELECTCASE ARG:1
			CASE IS < 6
