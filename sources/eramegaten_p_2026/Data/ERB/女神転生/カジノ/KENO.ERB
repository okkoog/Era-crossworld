			CASE 8
				RETURNF 300
			CASE 9
				RETURNF 3000
			CASE 10
				RETURNF 30000
			CASE 11,12
				RETURNF 100000
		ENDSELECT
	CASE 13
		SELECTCASE ARG:1
			CASE IS < 6
				RETURNF 0
			CASE 6
				RETURNF 5
			CASE 7
