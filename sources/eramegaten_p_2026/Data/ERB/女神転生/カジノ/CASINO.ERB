@CASINO, ARG
#LOCALSIZE 10
#LOCALSSIZE 10
#DIMS DYNAMIC GIFT,20
#DIM DYNAMIC PRICE,20
#DIM DYNAMIC GIFT_DEVIL_NO
#DIM DYNAMIC SELECT_CHARA
#DIM DYNAMIC L_ST_PAGE
#DIM DYNAMIC L_LINE, 2
VARSET GIFT
VARSET PRICE
LOCAL = 0
;ARGでとりあえず店を識別できるようにしておく
;1:ムー大陸　2:ビエンの街 3:신주쿠
L_LINE:1 = LINECOUNT
SELECTCASE ARG
	CASE 1
		PRINTL 점장:
		PRINTL 「어서 오십시오. 무 대륙에 오신 것을 환영합니다」
		PRINTL 「코인 교환과 경품 교환은,
		PRINTL 　이쪽에서 도와드립니다. 뭐든 말씀해 주십시오」
	CASE 2 , 5
		PRINTL 마계인:
		PRINTL 「행운의 카지노에 오신 것을 환영합니다」
		PRINTL 「안쪽 캐셔에서 마카를 코인으로 바꿔 즐겨 주십시오」
	CASE 3
		PRINTL 악마:
		PRINTL 「행운의 카지노에 온 걸 환영한다」
		PRINTL 「안쪽 캐셔에서 마카를 코인으로 바꿀 수 있으니 마음껏 즐기라고」
	CASEELSE
ENDSELECT
WHILE LINECOUNT < L_LINE:1 + 6
	PRINTL 
WEND
WAIT
L_LINE:1 = LINECOUNT
$START
CLEARLINE LINECOUNT - L_LINE:1
PRINTL 
DRAWLINE
PRINTL ＞어떻게 하겠습니까?
CALL INPUT_SELECT(1, "게임을 한다", 2, "코인을 산다", 3, "코인을 경품과 교환한다", 9, "카지노를 나간다")
SELECTCASE RESULT
	CASE 1
		CALL INPUT_SELECT(1, "SLOT SUPER 27", 2, "POKER H&L", 3, "KENO", 4, "CODE BREAKER", 9, "이전으로 돌아간다")
		SELECTCASE RESULT
			CASE 1
				CALL SUPER_27
			CASE 2
				CALL POKER
			CASE 3
				CALL KENO
			CASE 4
				CALL NANDI, ARG
		ENDSELECT
	CASE 2
		IF ARG == 1 || ARG == 4
			PRINTL ＞코인 1장당 120엔입니다
			PRINTL ＞몇 장을 사겠습니까?
			PRINTFORML 소지금 {MONEY}엔　소지 코인 {MONEY:3}장
			CALL INPUT_MANY(0, MONEY/120)
			IF RESULT == 0
				PRINTW ＞코인을 사지 않았습니다
			ELSE
				MONEY:3 += RESULT
				MONEY -= RESULT*120
				PRINTFORML ＞{RESULT}장 구입했습니다
				PRINTFORMW ＞이제 %CALLNAME:MASTER%이(가) 소지한 코인은 {MONEY:3}장입니다
			ENDIF
		ELSEIF ARG == 5
			PRINTL ＞코인 1장당 1마카입니다
			PRINTL ＞몇 장을 사겠습니까?
			PRINTFORML 소지 마카 {MONEY:1}마카　소지 코인 {MONEY:3}장
