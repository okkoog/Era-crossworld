				PRICE:7 = 3000
				PRICE:8 = 500
				PRICE:9 = 500
				GIFT:10 = 챠크라드롭
				PRICE:10 = 500
				GIFT:11 = 솔빙오브
				PRICE:11 = 200
				GIFT:12 = 메탈카드
				PRICE:12 = 20
				SELECTCASE DAY % 7
					CASE 0
						GIFT:3 = 스킬카드【무드】
						GIFT:4 = 스킬카드【아기】
						GIFT:5 = 스킬카드【백발침】
						GIFT:6 = 스킬카드【해피루마】
						GIFT:7 = 스트렝스소스
						GIFT:8 = MAG인센스카드
						GIFT:9 = AGI마이너스카드
					CASE 1
						GIFT:3 = 스킬카드【프레이】
						GIFT:4 = 스킬카드【갈】
						GIFT:5 = 스킬카드【부흐】
						GIFT:6 = 스킬카드【일할의마맥】
						GIFT:7 = 인텔리전스소스
						GIFT:8 = VIT인센스카드
						GIFT:9 = LUC마이너스카드
					CASE 2
						GIFT:3 = 스킬카드【한마】
						GIFT:4 = 스킬카드【지오】
						GIFT:5 = 스킬카드【돌격】
						GIFT:6 = 스킬카드【디아】
						GIFT:7 = 매직소스
						GIFT:8 = AGI인센스카드
						GIFT:9 = STR마이너스카드
					CASE 3
						GIFT:3 = 스킬카드【메기도】
						GIFT:4 = ALL마이너스카드
						PRICE:3 = 2500
						PRICE:4 = 1000
					CASE 4
						GIFT:3 = 스킬카드【무드】
						GIFT:4 = 스킬카드【잔】
						GIFT:5 = 스킬카드【그라이】
						GIFT:6 = 스킬카드【마린카린】
						GIFT:7 = 바이탈리티소스
						GIFT:8 = LUC인센스카드
						GIFT:9 = INT마이너스카드
					CASE 5
						GIFT:3 = 스킬카드【프레이】
						GIFT:4 = 스킬카드【아쿠아】
						GIFT:5 = 스킬카드【산바람】
						GIFT:6 = 스킬카드【일할의활천】
						GIFT:7 = 어질리티소스
						GIFT:8 = STR인센스카드
						GIFT:9 = MAG마이너스카드
						PRICE:3 = 1500
					CASE 6
						GIFT:3 = 스킬카드【한마】
						GIFT:4 = 스킬카드【마그나】
						GIFT:5 = 스킬카드【할퀴기】
						GIFT:6 = 스킬카드【파트라】
						GIFT:7 = 인텔리전스소스
						GIFT:8 = INT인센스카드
						GIFT:9 = VIT마이너스카드
				ENDSELECT
				CALL DUNGEON_SHOP, 3, GIFT:1, PRICE:1, GIFT:2, PRICE:2 , GIFT:3, PRICE:3, GIFT:4, PRICE:4, GIFT:5, PRICE:5, GIFT:6, PRICE:6, GIFT:7, PRICE:7, GIFT:8, PRICE:8, GIFT:9, PRICE:9, GIFT:10, PRICE:10, GIFT:11, PRICE:11, GIFT:12, PRICE:12, GIFT:13, PRICE:13, GIFT:14, PRICE:14, GIFT:15, PRICE:15, GIFT:16, PRICE:16, GIFT:17, PRICE:17, GIFT:18, PRICE:18, GIFT:19, PRICE:19
			;ビエンの街
			CASE 2
				GIFT:1 = Ｋ프로스트로드
				PRICE:1 = 10000
				GIFT:2 = Ｋ프로스트가발
				PRICE:2 = 10000
				GIFT:3 = Ｋ프로스트망토
				PRICE:3 = 10000
				GIFT:4 = Ｋ프로스트미튼
				PRICE:4 = 10000
				GIFT:5 = Ｋ프로스트부츠
				PRICE:5 = 10000
				GIFT:6 = 항마장
				PRICE:6 = 5000
				GIFT:7 = 물반경
				PRICE:7 = 1000
				GIFT:8 = 마반경
				PRICE:8 = 1000
				GIFT:9 = 코어실드
				PRICE:9 = 500
				GIFT:10 = 챠크라드롭
				PRICE:10 = 500
				GIFT:11 = 디스가이즈굿즈
				PRICE:11 = 200
				GIFT:12 = 메탈카드
				PRICE:12 = 20
				CALL DUNGEON_SHOP, 3, GIFT:1, PRICE:1, GIFT:2, PRICE:2 , GIFT:3, PRICE:3, GIFT:4, PRICE:4, GIFT:5, PRICE:5, GIFT:6, PRICE:6, GIFT:7, PRICE:7, GIFT:8, PRICE:8, GIFT:9, PRICE:9, GIFT:10, PRICE:10, GIFT:11, PRICE:11, GIFT:12, PRICE:12, GIFT:13, PRICE:13, GIFT:14, PRICE:14, GIFT:15, PRICE:15, GIFT:16, PRICE:16, GIFT:17, PRICE:17, GIFT:18, PRICE:18, GIFT:19, PRICE:19
			CASE 3
				GIFT:1 = 궁기의투구
				PRICE:1 = 10000
				GIFT:2 = 궁기의갑옷
				PRICE:2 = 10000
				GIFT:3 = 궁기의토시
				PRICE:3 = 10000
				GIFT:4 = 궁기의구족
				PRICE:4 = 10000
				GIFT:5 = 초연의검
				PRICE:5 = 6000
				GIFT:6 = 사자의군선
				PRICE:6 = 3000
				GIFT:7 = 함광의검
				PRICE:7 = 1000
				GIFT:8 = 보옥륜
				PRICE:8 = 1000
				GIFT:9 = 코어실드
				PRICE:9 = 500
				GIFT:10 = 챠크라드롭
				PRICE:10 = 500
				GIFT:11 = 디스가이즈굿즈
				PRICE:11 = 200
				GIFT:12 = 메탈카드
				PRICE:12 = 20
				CALL DUNGEON_SHOP, 3, GIFT:1, PRICE:1, GIFT:2, PRICE:2 , GIFT:3, PRICE:3, GIFT:4, PRICE:4, GIFT:5, PRICE:5, GIFT:6, PRICE:6, GIFT:7, PRICE:7, GIFT:8, PRICE:8, GIFT:9, PRICE:9, GIFT:10, PRICE:10, GIFT:11, PRICE:11, GIFT:12, PRICE:12, GIFT:13, PRICE:13, GIFT:14, PRICE:14, GIFT:15, PRICE:15, GIFT:16, PRICE:16, GIFT:17, PRICE:17, GIFT:18, PRICE:18, GIFT:19, PRICE:19
			;原宿・ファイアーランド
			CASE 4 , 5
				IF ((CHARANUM + 1) == MAX_PLAYER_CHARA) || (FINDCHARA_B([[キャラ:토르]], 1) >= 0 && FINDCHARA_B([[キャラ:아레스]], 1) >= 0)
					RESULT = 2
				ELSE
					CALL INPUT_SELECT(1, "악마와 교환한다", 2, "아이템과 교환한다")
				ENDIF
				SELECTCASE RESULT
					CASE 1
						L_ST_PAGE = 1
						IF FINDCHARA_B([[キャラ:토르]], 1) < 0 && FINDCHARA_B([[キャラ:아레스]], 1) < 0
							CALL INPUT_SELECT(1, "토르 10000코인", 2, "아레스 10000코인", 9, "이전으로 돌아간다")
						ELSE
							IF FINDCHARA_B([[キャラ:토르]], 1) < 0
								CALL INPUT_SELECT(1, "토르 10000코인", 9, "이전으로 돌아간다")
							ELSE
								CALL INPUT_SELECT(2, "아레스 10000코인", 9, "이전으로 돌아간다")
							ENDIF
						ENDIF
						IF RESULT != 9
							GIFT_DEVIL_NO = RESULT == 1 ? [[キャラ:토르]] # [[キャラ:아레스]]
							CALL ADD_NEW_COMPANION, GIFT_DEVIL_NO , 1, 1
							SELECT_CHARA = CHARANUM - 1
							U = SELECT_CHARA
							L_LINE = LINECOUNT
							$SHOW_DEVIL_4
							CUSTOMDRAWLINE =
							PRINTFORML %CALLNAME:U%　　
							CALLFORM SHOW_INFO_PAGE_{L_ST_PAGE}
							DRAWLINE
							PRINTLC [1001] 이전페이지
							PRINTLC 　　　　　　　　 
							PRINTLC [1002] 다음페이지
							PRINTL 
							CUSTOMDRAWLINE =
							PRINTLC [   0] 구입　　　
							RESETCOLOR
							PRINTLC [ 999] 돌아간다　　　
							CALL INPUTINT, 0, 999, 1001, 1002
							SELECTCASE RESULT
								CASE 0
									IF MONEY:3 >= 10000
										PRINTFORMW ＞%CSVCALLNAME(GIFT_DEVIL_NO)%이(가) 동료마가 되었다!
									ELSE
										PRINTW ＞코인이 부족하다
										DELCHARA SELECT_CHARA
									ENDIF
								CASE 999
									DELCHARA SELECT_CHARA
								CASE 1001
									L_ST_PAGE = L_ST_PAGE == 1 ? 4 # L_ST_PAGE - 1
									GOTO SHOW_DEVIL_4
								CASE 1002
									L_ST_PAGE = L_ST_PAGE == 4 ? 1 # L_ST_PAGE + 1
									GOTO SHOW_DEVIL_4
							ENDSELECT
						ENDIF
					CASE 2
						GIFT:1 = 스킬카드【그라비티마인】
						GIFT:2 = 스킬카드【폭렬의손톱】
						VARSET PRICE,2000, 1, 3
						GIFT:3 = 스킬카드【소닉윙】
						GIFT:4 = 스킬카드【썬더볼트】
						VARSET PRICE,1500, 3, 5
						GIFT:5 = 스킬카드【스탠샷】
						GIFT:6 = 스킬카드【마이트버닝】
						GIFT:7 = 스킬카드【소닉붐】
						GIFT:8 = 스킬카드【어스브레이크】
						VARSET PRICE,1000, 5, 9
						GIFT:9 = 반혼향
						PRICE:9 = 600
						CALL DUNGEON_SHOP, 3, GIFT:1, PRICE:1, GIFT:2, PRICE:2 , GIFT:3, PRICE:3, GIFT:4, PRICE:4, GIFT:5, PRICE:5, GIFT:6, PRICE:6, GIFT:7, PRICE:7, GIFT:8, PRICE:8, GIFT:9, PRICE:9, GIFT:10, PRICE:10, GIFT:11, PRICE:11, GIFT:12, PRICE:12, GIFT:13, PRICE:13, GIFT:14, PRICE:14, GIFT:15, PRICE:15, GIFT:16, PRICE:16, GIFT:17, PRICE:17, GIFT:18, PRICE:18, GIFT:19, PRICE:19
				ENDSELECT
			CASEELSE
		ENDSELECT

	CASE 9
		SELECTCASE ARG
			CASE 1
				PRINTL 점장:
				PRINTW 「뭐, 이런저런 일도 있겠지만 또 놀러 오십시오」
				PRINTW 「나름대로 환영할 테니」
				DRAWLINE
			CASE 2 , 5
				PRINTL 마계인:
				PRINTW 「다음에 또 찾아주시길 기다리고 있겠습니다」
			CASE 3
				PRINTL 악마:
				PRINTW 「또 오라고. 헷헤헤」
			CASE 4
				PRINTL 「감사합니다」
			CASEELSE
				PRINTL ＞어떻게 하겠습니까?
		ENDSELECT
		RETURN 1
ENDSELECT
GOTO START

