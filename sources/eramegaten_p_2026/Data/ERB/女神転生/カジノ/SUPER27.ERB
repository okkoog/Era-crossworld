					ENDSELECT
					CALL MESSAGE_BL(1, "ＧＥＴ "+TOSTR(LOCAL:3)+"ＣＯＩＮＳ!!")
					FOR LOCAL:4, 1, 10
						PRINT  
						CALL SLOT_SYMBOL, SLOT:(LOCAL:4), 2 - (LOCAL:4 == LOCAL || LOCAL:4 == LOCAL:1 || LOCAL:4 == LOCAL:2)
						PRINT  
						SIF LOCAL:4 % 3 == 0
							PRINTL 
					NEXT
					;CHALLENGE権消失の判定
					FOR LOCAL:4, 0, 6
						SIF CHALLENGE:(LOCAL:4) >= 10
							CONTINUE
						SIF CHALLENGE:(LOCAL:4) != SLOT:LOCAL
							CONTINUE
						CHALLENGE:(LOCAL:4) += 10
