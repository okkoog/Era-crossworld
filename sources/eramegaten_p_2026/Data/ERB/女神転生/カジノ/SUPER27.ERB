VARSET LOCAL
;ライン作成 16周期*4でJP以外をふる
;REELに順番に振っていく
FOR LOCAL:2, 1, 4
	FOR LOCAL:1, 0, 4
		LOCAL:4 = RAND:4
		FOR LOCAL, 0, 16
			IF LOCAL:4 == 0
				SELECTCASE LOCAL
					;７　１００点
					CASE 0
						LOCAL:3 = 0
					;♀　５０点
					CASE 1
						LOCAL:3 = 1
					;♂　５０点
					CASE 2
						LOCAL:3 = 2
					;太陽　２０点
					CASE 3,4,5
						LOCAL:3 = 3
					;月　２０点
					CASE 6,7
						LOCAL:3 = 4
					;★　２０点
					CASE 8,9
						LOCAL:3 = 5
					;●　１０点
					CASE 10,11,12
						LOCAL:3 = 6
					;ダイア 5点
					CASE 13,14,15
						LOCAL:3 = 7
				ENDSELECT
			ELSEIF LOCAL:4 == 1
				SELECTCASE LOCAL
					;７　１００点
					CASE 0
						LOCAL:3 = 0
					;♀　５０点
					CASE 1,2
						LOCAL:3 = 1
					;♂　５０点
					CASE 3
						LOCAL:3 = 2
					;太陽　２０点
					CASE 4, 5
						LOCAL:3 = 3
					;月　２０点
					CASE 6, 7
						LOCAL:3 = 4
					;★　２０点
					CASE 8, 9, 10
						LOCAL:3 = 5
					;●　１０点
					CASE 10, 11, 12
						LOCAL:3 = 6
					;ダイア 5点
					CASE 13, 14, 15
						LOCAL:3 = 7
				ENDSELECT
			ELSEIF LOCAL:4 == 2
				SELECTCASE LOCAL
					;７　１００点
					CASE 0
						LOCAL:3 = 0
					;♀　５０点
					CASE 1
						LOCAL:3 = 1
					;♂　５０点
					CASE 2, 3
						LOCAL:3 = 2
					;太陽　２０点
					CASE 4, 5
						LOCAL:3 = 3
					;月　２０点
					CASE 6, 7, 8
						LOCAL:3 = 4
					;★　２０点
					CASE 10, 11
						LOCAL:3 = 5
					;●　１０点
					CASE 11, 12
						LOCAL:3 = 6
					;ダイア 5点
					CASE 13, 14, 15
						LOCAL:3 = 7
				ENDSELECT
			ELSE
				SELECTCASE LOCAL
					;７　１００点
					CASE -1
						LOCAL:3 = 0
					;♀　５０点
					CASE 0, 1
						LOCAL:3 = 1
					;♂　５０点
					CASE 2, 3
						LOCAL:3 = 2
					;太陽　２０点
					CASE 4, 5
						LOCAL:3 = 3
					;月　２０点
					CASE 6, 7
						LOCAL:3 = 4
					;★　２０点
					CASE 8, 9
						LOCAL:3 = 5
					;●　１０点
					CASE 10, 11, 12
						LOCAL:3 = 6
					;ダイア 5点
					CASE 13, 14, 15
						LOCAL:3 = 7
				ENDSELECT
			ENDIF
			SELECTCASE LOCAL:2
				CASE 1
					REEL1:(LOCAL + LOCAL:1 * 16) = LOCAL:3
				CASE 2
					REEL2:(LOCAL + LOCAL:1 * 16) = LOCAL:3
				CASE 3
					REEL3:(LOCAL + LOCAL:1 * 16) = LOCAL:3
			ENDSELECT
		NEXT
		;16個の中で入れ替え
		FOR LOCAL, LOCAL:1*16, LOCAL:1*16+16
			LOCAL:3 = RAND:16+LOCAL:1*16
			SELECTCASE LOCAL:2
				CASE 1
					SWAP REEL1:LOCAL, REEL1:(LOCAL:3)
				CASE 2
					SWAP REEL2:LOCAL, REEL2:(LOCAL:3)
				CASE 3
					SWAP REEL3:LOCAL, REEL3:(LOCAL:3)
			ENDSELECT
		NEXT
	NEXT
NEXT
