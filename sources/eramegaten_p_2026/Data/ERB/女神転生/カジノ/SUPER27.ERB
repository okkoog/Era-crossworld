			FOR LOCAL, 3, 10, 3
				IF GROUPMATCH(SLOT:LOCAL, SLOT:(LOCAL:1), SLOT:(LOCAL:2)) == 2
					LOCAL:4 = SLOT:LOCAL == 8 ? RAND:8 # SLOT:LOCAL
					SELECTCASE LOCAL:4
						CASE 0
							LOCAL:3 = 100
						CASE 1,2
							LOCAL:3 = 50
						CASE 3,4,5
							LOCAL:3 = 20
						CASE 6
							LOCAL:3 = 10
						CASE 7
