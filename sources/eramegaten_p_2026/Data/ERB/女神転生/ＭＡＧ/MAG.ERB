PRINTL

$INPUT_LOOP
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF INRANGE(RESULT, 1, 10)
	UP_VALUE = RESULT
	IF GET_CHARA_STOCK_MAG(ARG) < MAG_COST:0:(UP_VALUE - 1)
		IF TENTACLE_FLAG
			IF GET_CHARA_MAXMAG(ARG) < MAG_COST:0:(UP_VALUE - 1)
				PRINTW ＭＡＧ 상한이 부족합니다
				CLEARLINE 2
				GOTO INPUT_LOOP
			ENDIF
			TENTACLE_COST = ((MAG_COST:0:(UP_VALUE - 1) - GET_CHARA_STOCK_MAG(ARG)) + TENTACLE_RATE - 1) / TENTACLE_RATE
			IF FLAG:촉수에너지 < TENTACLE_COST
				PRINTW 에너지가 부족합니다
				CLEARLINE 2
				GOTO INPUT_LOOP
			ENDIF
			CALL CONTROL_MAG,ARG,TENTACLE_COST * TENTACLE_RATE
			FLAG:촉수에너지 -= TENTACLE_COST
		ELSE
			PRINTW ＭＡＧ가 부족합니다
			CLEARLINE 2
			GOTO INPUT_LOOP
		ENDIF
	ENDIF
	SIF BASE:ARG:체력 == MAXBASE:ARG:체력
		BASE:ARG:체력 += UP_VALUE * 100
	MAXBASE:ARG:체력 += UP_VALUE * 100
	CALL CONTROL_MAG,ARG,-MAG_COST:0:(UP_VALUE - 1)
	PRINTFORMW %NAME:ARG%의 체력이 {MAXBASE:ARG:체력}으로 되었습니다
ELSEIF INRANGE(RESULT, 11, 20)
	UP_VALUE = RESULT - 10
	IF GET_CHARA_STOCK_MAG(ARG) < MAG_COST:1:(UP_VALUE - 1)
		IF TENTACLE_FLAG
			IF GET_CHARA_MAXMAG(ARG) < MAG_COST:1:(UP_VALUE - 1)
				PRINTW ＭＡＧ 상한이 부족합니다
				CLEARLINE 2
				GOTO INPUT_LOOP
			ENDIF
			TENTACLE_COST = ((MAG_COST:1:(UP_VALUE - 1) - GET_CHARA_STOCK_MAG(ARG)) + TENTACLE_RATE - 1) / TENTACLE_RATE
			IF FLAG:촉수에너지 < TENTACLE_COST
				PRINTW 에너지가 부족합니다
				CLEARLINE 2
				GOTO INPUT_LOOP
			ENDIF
			CALL CONTROL_MAG,ARG,TENTACLE_COST * TENTACLE_RATE
			FLAG:촉수에너지 -= TENTACLE_COST
		ELSE
			PRINTW ＭＡＧ가 부족합니다
			CLEARLINE 2
			GOTO INPUT_LOOP
		ENDIF
	ENDIF
	SIF BASE:ARG:기력 == MAXBASE:ARG:기력
		BASE:ARG:기력 += UP_VALUE * 100
	MAXBASE:ARG:기력 += UP_VALUE * 100
	CALL CONTROL_MAG,ARG,-MAG_COST:1:(UP_VALUE - 1)
	PRINTFORMW %NAME:ARG%의 기력이 {MAXBASE:ARG:기력}으로 되었습니다
ELSEIF RESULT == 100 && TENTACLE_RATE > 0
	TENTACLE_FLAG = !TENTACLE_FLAG
ELSE
	CLEARLINE 1
	GOTO INPUT_LOOP
ENDIF
CLEARLINE LINECOUNT - LINE
RESTART

@MAG_GROWTH_COST, ARG, ARG:1, ARG:2
#FUNCTION
#DIM DYNAMIC COST
;ARG		対象キャラクター
;ARG:1		0=체력 1=기력
;ARG:2		上昇元の値
COST = POWER(ARG:2/100,2)*(5+ARG:2/500+ARG:2/3000*5)
SIF ARG == MASTER
	COST *= 2
SIF ARG:1 == 1
	COST *= 2
RETURNF COST

;---- EDIT 039 MOD START -------------------------
;---- EDIT 002 MOD START -------------------------
@ＭＡＧ強化ＣＰ補正(ARG)
#FUNCTION
RETURNF MIN((ABL:ARG:종족 == 36 ? 905 # 900+MAXBASE:ARG:CP), 1100)


@スキル変更可能確かめ(ARG)
#FUNCTION
;人間時のみだと　1
;変身後のみだと　2
;両方とも可だと　3　を返す
LOCAL:0 = 0
LOCAL:1 = 0

SIF (TALENT:ARG:이능자 || ABL:ARG:종족 != 0 || TALENT:ARG:아웃사이더) && !TALENT:ARG:달인 && !TALENT:ARG:페르소나구사자
	LOCAL:0 = 1
SIF TALENT:ARG:데빌시프터 || TALENT:ARG:식노 || TALENT:ARG:아웃사이더
	LOCAL:1 = 2

RETURNF LOCAL:0 + LOCAL:1

;ステータスアップの必要MAG取得
@MAG_CALC_ENHANCE_BASE, ARG, ARG:1, ARG:2 = 0
#FUNCTION
#DIM DYNAMIC L_VALUE
#DIM DYNAMIC L_STAT
IF EXISTFUNCTION(@"MAG_CALC_ENHANCE_BASE_CHARA_{NO:ARG}")
	RESULT_F = -1
	CALLFORMF MAG_CALC_ENHANCE_BASE_CHARA_{NO:ARG}, ARG, ARG:1, ARG:2
	RETURNF RESULT_F
;MASTERは無償回数がある時のみ
ELSEIF ARG == MASTER
	SIF COUNT_FREE_MAG_ENHANCE_BASE(ARG) > ARG:1
		RETURNF 0
	RETURNF -1
;係数0は独自がない場合は通らない
ELSEIF GET_ROLE_PROP("MAG_CALC_ENHANCE_BASE_VALUE", ARG) == 0
	RETURNF -1
ELSE
	;---- EDIT 033 ADD START -------------------------
	;直接指定
	IF ARG:2 > 0
		L_STAT = ARG:2
	ELSE
		;無償なら0
		SIF COUNT_FREE_MAG_ENHANCE_BASE(ARG) > ARG:1
			RETURNF 0
		L_STAT = CFLAG:ARG:능력강화횟수 + ARG:1
	ENDIF
	;---- EDIT 033 ADD END ---------------------------
	;L_VALUE = FLAG:전투난이도 > 3 ? 100 # 250
	L_VALUE = 250
	L_VALUE *= (L_STAT / 3 + 1)
	L_VALUE *= (L_STAT / 3 + 2)
	L_VALUE = L_VALUE * ＭＡＧ強化ＣＰ補正(ARG) / 1000
	L_VALUE = L_VALUE * ABS(GET_ROLE_PROP("MAG_CALC_ENHANCE_BASE_VALUE", ARG)) / 100
	L_VALUE = L_VALUE * ABS(GET_ROLE_PROP("MAG_CALC_ENHANCE_BASE_VALUE", ARG)) / 100
	RETURNF L_VALUE
ENDIF
;---- EDIT 033 ADD START -------------------------
;-------------------------------------------
;無償振りできる回数の計算
;実際に振ってある数値が能力回数に達するまでは無償で振れる
;-------------------------------------------
;---- EDIT 033 ADD END ---------------------------
@COUNT_FREE_MAG_ENHANCE_BASE, ARG
#FUNCTION
RETURNF MAX(CFLAG:ARG:능력강화횟수 - SUMARRAY(CFLAG:ARG:0, GETNUM(CFLAG, "힘강화횟수"), GETNUM(CFLAG, "운강화횟수")+1), 0)
;ARG = リストの登録者数
@SORT_MAG_ENHANCE, ARG
#DIM LCOUNT
FOR LCOUNT, 0, ARG
	SELECTCASE MAG_ENHANCE_SORT
		CASE 0
			ARRAYSORT Q, FORWARD, 0, ARG
			RETURN 0
		;MAG所持量
		CASE 1
			Q:LCOUNT += GET_CHARA_STOCK_MAG(Q:LCOUNT) * 1000
		;MAG所持割合
		CASE 2
			Q:LCOUNT += (GET_CHARA_STOCK_MAG(Q:LCOUNT) * 1000 / GET_CHARA_MAXMAG(Q:LCOUNT)) * 1000
		;LV
		CASE 3
			Q:LCOUNT += BASE:(Q:LCOUNT):LV * 1000
	ENDSELECT
NEXT

ARRAYSORT Q, BACK, 0, ARG

FOR LCOUNT, 0, ARG
	Q:LCOUNT %= 1000
NEXT
RETURN 0

@STATUS_RESET, ARG
#DIM DYNAMIC LINE, 3
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_RESULT
#DIM DYNAMIC SUM_BONUS_STAT
LINE = LINECOUNT
$START
VARSET SUM_BONUS_STAT
CLEARLINE LINECOUNT - LINE
CALL MAG_ENHANCE_INFO_CHARA, ARG
LINE:1 = LINECOUNT
PRINTFORML 리셋할 항목을 선택해주세요
PRINTFORML 필요 마카:1000　　　소지 마카:{MONEY:1}
PRINTFORML [0] 기본 스탯
PRINTFORML [1] ＭＡＧ 강화
CALL PRINT_SPACE_ENHANCE
DRAWLINE
PRINTL [9] 돌아간다
CALL INPUTINT, 9, 0, 1
L_RESULT = RESULT
SELECTCASE L_RESULT
	CASE 9
		RETURN 1
	CASE 0
		CLEARLINE LINECOUNT- LINE:1
		PRINTFORML 1000 마카를 소비하여 기본 스탯을 리셋하고
		PRINTFORML 다시 분배할 수 있습니다.
		PRINTFORML 정말로 리셋하시겠습니까?
		PRINTL [0] 네
		PRINTL [1] 아니오
		CALL PRINT_SPACE_ENHANCE
		DRAWLINE
		PRINTL [9] 돌아간다
		CALL INPUTINT, 0, 1
		CLEARLINE LINECOUNT- LINE:1
		IF RESULT == 0
			;標準値との差分をとりつつステータスを修正
			FOR LCOUNT, 1, 7
				;自由ふりに使えるポイントを計算する
				SUM_BONUS_STAT += BASE:ARG:GET_BASESTATUS(LCOUNT)
				SUM_BONUS_STAT -= 1
				;香で増えた分はひいておく
				SUM_BONUS_STAT -= CFLAG:ARG:@"향사용횟수_%GET_BASESTATUS(LCOUNT)%"
				;ステータスを1に下げ、香強化分を振り込む
				BASE:ARG:GET_BASESTATUS(LCOUNT) = 1
				BASE:ARG:GET_BASESTATUS(LCOUNT) += CFLAG:ARG:@"향사용횟수_%GET_BASESTATUS(LCOUNT)%"
			NEXT
			IF FLAG:레벨업시인터페이스설정 == 1
				CALLFORM STATUS_BONUS_1,ARG, MAX(SUM_BONUS_STAT, 0)
			ELSE
				CALLFORM STATUS_BONUS_0,ARG, MAX(SUM_BONUS_STAT, 0)
			ENDIF
			MONEY:1 -= 1000
		ENDIF
	CASE 1
		CLEARLINE LINECOUNT- LINE:1
		PRINTFORML 1000 마카를 소비하여 MAG 강화를 적용한 스탯을 리셋하고
		PRINTFORML 다시 분배할 수 있습니다.
		PRINTFORML 정말로 리셋하시겠습니까?
		PRINTL [0] 네
		PRINTL [1] 아니오
		CALL PRINT_SPACE_ENHANCE
		DRAWLINE
		PRINTL [9] 돌아간다
		CALL INPUTINT, 0, 1
		CLEARLINE LINECOUNT- LINE:1
		IF RESULT == 0
			;標準値との差分をとりつつステータスを修正
			FOR LCOUNT, 1, 7
				;自由ふりに使えるポイントを計算する
				SUM_BONUS_STAT += CFLAG:ARG:@"%GET_BASESTATUS(LCOUNT)%강화횟수"
				CFLAG:ARG:@"%GET_BASESTATUS(LCOUNT)%강화횟수" = 0
			NEXT
			MONEY:1 -= 1000
			PRINTFORML MAG 강화를 리셋했습니다.
			PRINTFORML 리셋한 능력치는 무상 강화가 가능한 포인트로 축적되므로
			PRINTFORML 다시 MAG 강화를 실행하여 유효화해주세요.
			CALL PRINT_SPACE_ENHANCE
			DRAWLINE
			PRINTW [9] 돌아간다
		ENDIF
ENDSELECT
IF MONEY:1 < 1000
	PRINTFORML 리셋에 필요한 마카가 부족합니다.
	PRINTFORMW 스탯 리셋을 종료합니다.
	RETURN 1
ENDIF
