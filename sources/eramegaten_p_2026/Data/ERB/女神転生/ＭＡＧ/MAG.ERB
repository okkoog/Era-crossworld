@MAG_LEARN_AWAKE_SKILL, ARG, ARG:1, ARGS
#DIM LCOUNT, 2
#DIM LINE, 1
#DIM IS_TRANS
#DIM L_SKILL
#DIMS SKILL_NAME

LINE = LINECOUNT
IS_TRANS = ARG:1

