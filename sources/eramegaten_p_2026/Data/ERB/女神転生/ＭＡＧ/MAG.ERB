	IF NEED_MACCA == 0
		ITEM:@"%L_STAT%의향" -= CNT_ENHANCE
	ELSE
		IF MONEY:1 >= NEED_MACCA
			MONEY:1 -= NEED_MACCA
			ITEM:@"%L_STAT%의향" = 0
		ELSE
			GOTO START
		ENDIF
	ENDIF
	BASE:ARG:L_STAT += CNT_ENHANCE
	CFLAG:ARG:@"향사용횟수_%L_STAT%" += CNT_ENHANCE
	PRINTFORML %CALLNAME:ARG%의 %조사처리(L_STAT,"이")% {CNT_ENHANCE} 올랐다！
	CALL SYNC_STATUS,ARG
	IF MAG_ENHANCE_LINE < 0
		WHILE LINECOUNT < LINE:2
			PRINTL 
		WEND
	ELSE
		CALL PRINT_SPACE_ENHANCE
	ENDIF
	DRAWLINE
	PRINTW [0] 돌아간다
ENDIF
