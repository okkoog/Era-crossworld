			IF HAVE_PU_SKILL(ARG, LEARN_SKILL:LISTNUM)
				REMEMBER_NOT_ABLE:LISTNUM = 1
				L_TITLE = 所持済み
			ENDIF
		ELSE
			IF HAVE_SKILL(ARG, TOINT(LEARN_SKILL:LISTNUM) )
				REMEMBER_NOT_ABLE:LISTNUM = 1
				L_TITLE = 所持済み
			ELSE
				L_TITLE = 
			ENDIF
		ENDIF
	ENDIF
	CALL GETS_SKILL_PROP, "SKILL_NAME", LEARN_SKILL:LISTNUM, ARG
	HTML_PRINT @"<button value = '{LISTNUM + 1}' title = '%L_TITLE%'>" + @"<font color = '%TOSTR_HTML(REMEMBER_NOT_ABLE:LISTNUM ? COLOR("DARK-GRAY") # GETDEFCOLOR())%'>" + @"[{LISTNUM + 1, 2}] %RESULTS, SKILLNAMELENS:1, LEFT%%TOSTR(L_COST:LISTNUM, "###,0") + "ＭＡＧ", 15%" +"</font>" + "</button>"
NEXT
WHILE LINECOUNT < LINE:1 + SHOWLINENUM + 1
	PRINTL 
WEND
RESETCOLOR
IF LEARN_SKILL:SHOWLINENUM != ""
	PRINTBUTTON "[-] 이전페이지", "-"
	PRINTFORM %" "* 5%Page.{L_PAGE}%" " * 5%
	PRINTBUTTON "[+] 다음페이지", "+"
	PRINTL 
ENDIF
CALL PRINT_SPACE_ENHANCE
DRAWLINE
PRINTL [0] 돌아간다
INPUTS
IF RESULTS == "-"
	L_PAGE = L_PAGE ? L_PAGE -1 # L_PAGE_MAX
	GOTO START
ENDIF
IF RESULTS == "+"
	L_PAGE = L_PAGE < L_PAGE_MAX ? L_PAGE + 1 # 0
	GOTO START
ENDIF
SIF RESULTS == "0"
	RETURN 0
;---- EDIT 031 MOD START -------------------------
;数値化
SIF !ISNUMERIC(RESULTS)
	GOTO START
LISTNUM = TOINT(RESULTS) - 1
;値域外
SIF !INRANGE(LISTNUM, 0, VARSIZE("LEARN_SKILL"))
	GOTO START
L_SKILLS = %LEARN_SKILL:LISTNUM%
$INPUT_LOOP
CLEARLINE LINECOUNT - LINE:1
