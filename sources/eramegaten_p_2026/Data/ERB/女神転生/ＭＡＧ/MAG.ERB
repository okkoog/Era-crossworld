#DIMS DYNAMIC L_SKILLS
#DIMS DYNAMIC CSTR_ELEMENT
#DIM DYNAMIC L_RANK, 100
#DIM DYNAMIC L_COST, 100
#DIM DYNAMIC REMEMBER_NOT_ABLE, 100
