CALL GETS_SKILL_PROP, "SKILL_NAME", L_SKILLS, ARG
SIF RESULTS == ""
	GOTO START
;---- EDIT 031 MOD END ---------------------------
PRINTFORML □%RESULTS%
PRINTFORML 스킬 랭크:{L_RANK:LISTNUM,2}
PRINTFORML 필요ＭＡＧ　:%TOSTR(L_COST:LISTNUM, "###,0"), 8%　
LINE:2 = LINECOUNT
;所持していない専用スキルは表示できないので削る
IF FLAG:스킬속성표시설정 == 1
	IF ISNUMERIC(L_SKILLS)
		CALL SKILL_EXPLAIN_PERFORMANCE, TOINT(L_SKILLS), ARG
	ELSE
		CSTR:ARG:비소지스킬 '= L_SKILLS
		CALL SKILL_EXPLAIN_PERFORMANCE, [[스킬:비소지스킬]], ARG
		CSTR:ARG:비소지스킬 '= ""
	ENDIF
ENDIF
CALL GETS_SKILL_PROP, "SKILL_EXPLAIN", L_SKILLS, ARG
WHILE LINECOUNT < LINE:2 + 3
	PRINTL 
WEND
DRAWLINE
PRINTFORML %CALLNAME:ARG,20,LEFT%(현재ＭＡＧ：%TOSTR(GET_CHARA_STOCK_MAG(ARG), "###,0")%)
IF REMEMBER_NOT_ABLE:LISTNUM
	PRINTFORML 습득할 수 없습니다。
ELSE
	PRINTL 습득하시겠습니까？
	PRINTBUTTON "[0] Yes" + " " * 20, 0
	PRINTL 
	PRINTBUTTON "[1] No" + " " * 20, 1
	PRINTL 
	CALL PRINT_SPACE_ENHANCE
	DRAWLINE
	PRINTL 
	INPUT
	SELECTCASE RESULT
		CASE 0
			CLEARLINE LINECOUNT - LINE:1
