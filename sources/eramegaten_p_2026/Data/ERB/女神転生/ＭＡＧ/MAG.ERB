@MAG_GROWTH,ARG
#DIM DYNAMIC MAG_COST, 2, 10
#DIM DYNAMIC COST_LENGTH, 2
#DIM DYNAMIC LINE
#DIM DYNAMIC L_COUNT
#DIM DYNAMIC UP_VALUE
#DIM DYNAMIC TENTACLE_RATE
