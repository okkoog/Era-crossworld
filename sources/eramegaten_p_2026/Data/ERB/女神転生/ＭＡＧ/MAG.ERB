FOR LCOUNT, 0, RESULT
	L_SKILLS '= LEARN_SKILL:LCOUNT
	SIF L_SKILLS == ""
		CONTINUE
	;ランク判定とコスト計算
	CALL GETS_SKILL_PROP, "SKILL_RANK", L_SKILLS, ARG
	L_RANK:LCOUNT = INRANGE(RESULT, 1, 15) ? RESULT # 15
	L_COST:LCOUNT = POWER(MIN(L_RANK:LCOUNT),3)*150 * ＭＡＧ強化ＣＰ補正(ARG) / 1000
NEXT
