;===================================================
;主に新規加入キャラにMAG強化を与える関数
;MAG強化の総量はLVごとの基準値に対する100分率で指定する
;===================================================
@SET_ENHANCE_BASE_FOR_NEW_CHARA, L_CHARA, L_AMOUNT = 50
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_AMOUNT
;基本ステータスの33%が最大値
VARI SUM_ADD_STAT = (BASE:L_CHARA:LV * 3 / 2 + 18) * L_AMOUNT / 100
VARI CSV_STAT, 7
;MAG強化が実施されている数だけひいていく。またCSV比率を取っておく
FOR LCOUNT, 1, BASESTATUSNUM
	SUM_ADD_STAT -= CFLAG:L_CHARA:(GET_BASESTATUS(LCOUNT) + "강화횟수")
	CSV_STAT:LCOUNT = CSVBASE(NO:L_CHARA, GETNUM(BASE, GET_BASESTATUS(LCOUNT)))
NEXT
SIF SUMARRAY(CSV_STAT) == 0
	VARSET CSV_STAT, 1, 1, BASESTATUSNUM
;CSVの比率にあわせて割り振っていく
IF SUM_ADD_STAT > 0
	VARI ADD_STAT, 7
	FOR LCOUNT, 1, BASESTATUSNUM
		ADD_STAT:LCOUNT = SUM_ADD_STAT * CSV_STAT:LCOUNT / SUMARRAY(CSV_STAT)
		ADD_STAT:LCOUNT = SUM_ADD_STAT * CSV_STAT:LCOUNT / SUMARRAY(CSV_STAT)
	NEXT
	;端数調整
	WHILE SUM_ADD_STAT != SUMARRAY(ADD_STAT)
		IF SUM_ADD_STAT > SUMARRAY(ADD_STAT)
			ADD_STAT:FINDELEMENT(ADD_STAT, MINARRAY(ADD_STAT, 1, BASESTATUSNUM), 1, BASESTATUSNUM) += 1
		ELSE
			ADD_STAT:FINDELEMENT(ADD_STAT, MAXARRAY(ADD_STAT, 1, BASESTATUSNUM), 1, BASESTATUSNUM) -= 1
		ENDIF
	WEND
	FOR LCOUNT, 1, BASESTATUSNUM
		CFLAG:L_CHARA:(GET_BASESTATUS(LCOUNT) + "강화횟수") += ADD_STAT:LCOUNT
	NEXT
ENDIF
CFLAG:L_CHARA:능력강화횟수 = 0
FOR LCOUNT, 1, BASESTATUSNUM
	CFLAG:L_CHARA:능력강화횟수 += CFLAG:L_CHARA:(GET_BASESTATUS(LCOUNT) + "강화횟수")
NEXT

