@MAG_LEARN_SPECIAL_SKILL, ARG, SELECT_TRANS
#DIM DYNAMIC LCOUNT, 2
#DIMS DYNAMIC SELECT_TRANS
#DIM DYNAMIC LINE, 3
#DIMS DYNAMIC L_MES
