		INPUT
		VARI L_RESULT = RESULT
		CLEARLINE LINECOUNT- LINE:1
		SIF !STRCOUNT(INPUT_ABLE, TOSTR(L_RESULT))
			GOTO INPUT_LOOP
		SELECTCASE L_RESULT
			CASE 0
				GOTO START
			CASEELSE
				CALL CONTROL_MAG, ARG, -必要ＭＡＧ:L_RESULT
				IF IS_TRANS
					IF L_RESULT == 5
						ABL:ARG:초기링크악마공격상성 = CSV_相性
					ELSE
						ABL:ARG:초기링크악마공격상성 = L_RESULT - 1
					ENDIF
				ELSE
					IF L_RESULT == 5
						ABL:ARG:공격상성= CSV_相性
					ELSE
						ABL:ARG:공격상성= L_RESULT - 1
					ENDIF
				ENDIF
				CLEARLINE LINECOUNT - LINE:1
				;---- EDIT 027 MOD START -------------------------
				PRINTFORML %CALLNAME:U%의 통상공격의 상성을 %조사처리(GET_TYPE(L_RESULT == 5 ? CSV_相性 # L_RESULT - 1),"로")% 변경했습니다
				;---- EDIT 027 MOD END ---------------------------
				CALL PRINT_SPACE_ENHANCE
				DRAWLINE
				PRINTL [0] 돌아간다
				WAIT
		ENDSELECT
		GOTO START
	CASE 4
		PRINTL 성능 설정을 초기화하시겠습니까？　（변경에 사용되는 ＭＡＧ는 반환되지 않습니다！）
		CALL PRINT_SPACE_ENHANCE
		CALL INPUT_YN
		SIF RESULT
			GOTO START
		IF IS_TRANS
			ABL:ARG:초기링크악마사거리 = CSVABL(CFLAG:ARG:초기링크악마, GETNUM(ABL, "사거리"), 0)
			ABL:ARG:초기링크악마공격범위 = CSVABL(CFLAG:ARG:초기링크악마, GETNUM(ABL, "공격범위"), 0)
			ABL:ARG:초기링크악마공격상성 = CSVABL(CFLAG:ARG:초기링크악마, GETNUM(ABL, "공격상성"), 0)
		ELSE
			ABL:ARG:사거리 = CSVABL(NO:ARG, GETNUM(ABL, "사거리"), 0)
			ABL:ARG:공격범위 = CSVABL(NO:ARG, GETNUM(ABL, "공격범위"), 0)
			ABL:ARG:공격상성 = CSVABL(NO:ARG, GETNUM(ABL, "공격상성"), 0)
