;===================================================
;ランクアップのツリー表示 & 必要MAG取得関数
;
;起点のスキルとスキルの持ち主を設定して呼び出したら再帰で自分を呼び出し続ける
;以下の配列を使うので注意
;D:各スキルのランクアップ候補を取得するのに使う
;E:最終的なランクアップ候補を格納
;F:各ランクアップ候補の必要MAGを格納
;
;ランクアップコストは基本的に1→4→10と1→10のように経路が違っても端数計算がずれるくらいの違いしかないのですが
;経由スキルに相性が違うものが混ざるなどで一部だけ補正がかかるような措置が入ると結果が大きく変わるので、
;いちおうそこらへんが発生することも見込んで1→4+4+10のように経由を含めて算出する形にしてあります
;===================================================
@SET_RANKUP_TREE, L_SKILL, ARG, IS_TRANS, L_TIER, L_NUM, L_COST
#DIM DYNAMIC L_SKILL, 2
#DIM DYNAMIC LCOUNT
#DIM IS_TRANS
#DIMS L_TRANS
#DIM DYNAMIC L_TIER;ツリー深度
#DIM L_BLANK;空白の個数
#DIM L_SHOWNUM;一行あたりの表示数
#DIM DYNAMIC L_COST;必要コスト
#DIM DYNAMIC L_NUM;何本目のツリーか
#DIM TEMP
L_SHOWNUM = LINELENS() / 26
L_TRANS = \@IS_TRANS ? 変身形態 # 通常形態\@
SIF L_TIER == L_SHOWNUM
	PRINTFORML 　→　
;深度が表示数を超えたら空白が必要になる
L_BLANK = L_TIER >= L_SHOWNUM ? L_TIER - 4 # L_TIER
SIF L_NUM > 1 || L_TIER == L_SHOWNUM
	PRINTFORM %" " * 20 * L_BLANK + " " * 6 * MAX(L_BLANK -1, 0)%
IF L_BLANK > 0
	IF L_TIER == L_SHOWNUM
		PRINTFORM 　　　
	ELSE
		PRINTFORM 　→　
	ENDIF
ENDIF
PRINTFORM %"[" + SKILL_NAME_F(L_SKILL) + "]", 20, LEFT%
FOR LCOUNT, 1, 10
	RESULT = 0
	CALL GET_SKILL_PROP, "SKILL_RANKUP", L_SKILL, ARG
	IF RESULT < LCOUNT
		SIF !LINEISEMPTY()
			PRINTL 
		BREAK
	ENDIF
	L_SKILL:1 = D:LCOUNT
	IF !GET_ROLE_PROP("CAN_USE_MANTRA", ARG, , L_TRANS) || !L_TIER
		CALL GET_SKILL_PROP, "SKILL_RANK", L_SKILL:1, ARG
		TEMP = POWER(RESULT,3)
		CALL GET_SKILL_PROP, "SKILL_RANK", L_SKILL, ARG
		TEMP -= POWER(RESULT,3)
		TEMP *= 200
		CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", D:LCOUNT, ARG
		SIF TALENT:ARG:GET_SUCCESSION(RESULT) == 0
			TEMP *= 2
		CALL HAVE_SKILL_SUCCESSION_BODY, ARG, D:LCOUNT
		SIF RESULT
			TEMP /= 2
		;喰奴はMAG量5倍
		SIF GET_ROLE_PROP("CAN_USE_MANTRA", ARG, , L_TRANS)
			TEMP *= 5
		TEMP = TEMP * ＭＡＧ強化ＣＰ補正(ARG) / 1000
		TEMP += L_COST
		SIF FINDELEMENT(E, L_SKILL:1) < 0
			E:FINDELEMENT(E, -1) = L_SKILL:1
		F:FINDELEMENT(E, L_SKILL:1) = MIN(TEMP, F:FINDELEMENT(E, L_SKILL:1))
	ENDIF
	CALL SET_RANKUP_TREE, L_SKILL:1, ARG, IS_TRANS, L_TIER + 1, LCOUNT, TEMP
NEXT

;===================================================
;スキル変異
;
;2022/12時点で未使用
;===================================================
@MAG_SKILL_MUTATION,ARG, ARG:1
#DIM LCOUNT, 2
#DIM LINE, 2
#DIMS L_MES
#DIM L_RESULT
#DIM L_SKILLCOUNT, 1
#DIM DEL_COST , 21
#DIM L_HAVE_SKILL, 21
#DIM ＣＰ보정, 1
#DIM IS_TRANS
#DIMS TRANS_MODE
#DIMS L_SKILL_TYPE
#DIM L_SKILL
#DIMS L_SKILLS
#DIM L_RANK
#DIM L_CNT
#DIM SKILL_RANK

IS_TRANS = ARG:1
;---- EDIT 044 ADD START -------------------------
TRANS_MODE = \@IS_TRANS ? 変身形態 # 通常形態\@
;---- EDIT 044 ADD END ---------------------------
L_SKILLCOUNT = CHANGEABLE_SKILLCOUNT(ARG, , \@IS_TRANS ? 変身形態 # 通常形態\@)

LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - LINE
CALL MAG_ENHANCE_INFO_CHARA, U
;---- EDIT 013 MOD START -------------------------
PRINTFORML □스킬 변이　　(현재 ＭＡＧ：%TOSTR(GET_CHARA_STOCK_MAG(ARG), "###,0")%)
;---- EDIT 013 MOD END -------------------------
DRAWLINE
PRINTL 어느 스킬을 변이시키겠습니까?
LINE:1 = LINECOUNT
IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	L_SKILL_TYPE = \@IS_TRANS ? 초기변신악마스킬 # 인간시스킬\@
ELSE
	L_SKILL_TYPE = 스킬
ENDIF
VARSET DEL_COST
VARSET L_HAVE_SKILL, -1
FOR LCOUNT, 0, L_SKILLCOUNT
	L_SKILL = ABL:ARG:@"%L_SKILL_TYPE%{LCOUNT}"
	IF L_SKILL > 0
		L_HAVE_SKILL:LCOUNT = L_SKILL
		;削除不能属性をチェック
		CALL GET_SKILL_PROP, "SKILL_DEL_UNABLE", L_SKILL, ARG
		SIF RESULT
			DEL_COST:(LCOUNT + 1) = -1
		;コスト計算
		IF DEL_COST:(LCOUNT + 1) >= 0
			CALL GET_SKILL_PROP, "SKILL_RANK",L_SKILL, ARG
			DEL_COST:(LCOUNT + 1) = POWER(RESULT,3) * 500
			;---- EDIT 044 MOD START -------------------------
			;喰奴はMAG量5倍
			SIF GET_ROLE_PROP("CAN_USE_MANTRA", ARG, , TRANS_MODE) == 2
				DEL_COST:(LCOUNT + 1) = 0
			;---- EDIT 044 MOD END ---------------------------
		ENDIF
		CALL PRINT_COLOR, @"　[{LCOUNT+1, 2}] %SKILL_NAME_F(L_SKILL),20,LEFT%", INRANGE(DEL_COST:(LCOUNT + 1), 1, GET_CHARA_STOCK_MAG(ARG))
		IF DEL_COST:(LCOUNT + 1) < 0
			PRINTFORML 변이 불가 스킬
		ELSE
			CALL PRINT_COLOR, @"必要ＭＡＧ:%TOSTR(DEL_COST:(LCOUNT + 1), "X.XXX"), 8%", INRANGE(DEL_COST:(LCOUNT + 1), 1, GET_CHARA_STOCK_MAG(ARG)), "L"
		ENDIF
	ENDIF
NEXT
CALL PRINT_SPACE_ENHANCE
DRAWLINE
PRINTL [0] 돌아간다

$INPUT_LOOP
INPUT
CLEARLINE LINECOUNT - LINE:1
L_RESULT = RESULT
IF L_RESULT == 0
	RETURN 0
ELSEIF !INRANGE(L_RESULT, 1, L_SKILLCOUNT)
	GOTO START
ELSEIF !DEL_COST:L_RESULT
	GOTO START
ELSEIF DEL_COST:L_RESULT == -1
	L_MES = 変異出来ないスキルです。
ELSEIF GET_CHARA_STOCK_MAG(ARG) < DEL_COST:L_RESULT
	L_MES = ＭＡＧ가 부족합니다
ELSE
	L_SKILLS = %L_SKILL_TYPE%{RESULT}
	L_SKILL = ABL:ARG:L_SKILLS
	
	;変異候補リスト作成
	VARSET D,-1
	CALL GET_SKILL_PROP, "SKILL_RANK", L_SKILL, ARG
	L_RANK = RESULT
	L_CNT = 0
	FOR LCOUNT,1,SKILLNUM
		RESULT = 0
		CALL GET_SKILL_PROP, "SKILL_RANK", LCOUNT, -1
		;変位可能ななランク内におさまっているか
		SIF !INRANGE(RESULT, 1, 15)
			CONTINUE
		;変異はスキルランク±1から選定される
		SIF !INRANGE(RESULT, L_RANK -1, L_RANK + 1)
			CONTINUE
		;所持しているスキルははじく
		SIF MATCH(L_HAVE_SKILL, LCOUNT)
			CONTINUE
		D:L_CNT = LCOUNT
		L_CNT++
	NEXT
	IF L_CNT == 0
		L_MES = ………失敗した
	ELSE
		CALL CONTROL_MAG,ARG, -DEL_COST:L_RESULT
		L_MES = %ARG는% %SKILL_NAME_F(L_SKILL)%を忘れ、
		L_SKILL = D:(RAND:L_CNT)
		ABL:ARG:L_SKILLS = L_SKILL
		;---- EDIT 044 MOD START -------------------------
		SIF GET_ROLE_PROP("CAN_USE_MANTRA", ARG, , TRANS_MODE) == 2
			CALL PUSH_LEARNED_MANTRA_SKILLLIST, ARG, L_SKILL
		;---- EDIT 044 MOD END ---------------------------
		L_MES += SKILL_NAME_F(L_SKILL) + "を습득했다！"
		;変身・リンク関係のスキルを所持スキルに反映
		CALL FIX_CHARA_TRANS_SKILL, ARG
		CALL SYNC_STATUS,ARG
		CALL HEALTH_CHARA,ARG
	ENDIF
ENDIF
PRINTFORML %L_MES%
CALL PRINT_SPACE_ENHANCE
DRAWLINE
PRINTW [0] 돌아간다
GOTO START

;===================================================
;スキル習得
;===================================================
@MAG_LEARN_SKILL, ARG, ARG:1, ARGS
#DIM LCOUNT, 2
#DIM LINE, 2
#DIMS L_MES
#DIM L_RESULT
#DIM L_SKILLCOUNT, 1
#DIM DEL_COST , 21
#DIM L_HAVE_SKILL, 21
#DIM ＣＰ보정, 1
#DIM IS_TRANS
#DIMS TRANS_MODE
#DIMS L_SKILL_TYPE
#DIM L_SKILL
#DIMS L_SKILLS
#DIM L_RANK
#DIM L_COST
#DIM L_CNT
#DIM CAN_LEARN_SUCCESSION, SUCCESSIONNUM
#DIM SKILL_RANK
#DIM SHOW_SUCCESSION
#DIM L_PAGE
#DIM L_PAGE_MAX
#DIM SHOWLINENUM

IS_TRANS = ARG:1
TRANS_MODE = \@IS_TRANS ? 変身形態 # 通常形態\@
L_SKILLCOUNT = GET_ROLE_PROP("CHANGEABLE_SKILLCOUNT", ARG, , TRANS_MODE)

LINE = LINECOUNT
L_PAGE = 0
SHOW_SUCCESSION = -1
$START
CLEARLINE LINECOUNT - LINE
CALL MAG_ENHANCE_INFO_CHARA, U, IS_TRANS
PRINTL □스킬 습득
LINE:1 = LINECOUNT
;---- EDIT 049 MOD START -------------------------
SHOWLINENUM = MAG_ENHANCE_LINE - LINE:1 -2 -5
IF SHOW_SUCCESSION >= 0
	CALL スキルカード在庫確認(SHOW_SUCCESSION, ARG, , IS_TRANS)
	IF RESULT
		L_PAGE_MAX = RESULT / (SHOWLINENUM * 3)
		FOR LCOUNT:1, 0, SHOWLINENUM
			FOR LCOUNT, 0, 3
				L_SKILL = HAVE_SKILLCARD_LIST:(LCOUNT:1 * 3 + LCOUNT + L_PAGE * SHOWLINENUM * 3)
				SIF !L_SKILL
					CONTINUE
				SIF !ITEM:(10000 + L_SKILL)
					CONTINUE
				;---- EDIT 044 MOD START -------------------------
				SIF CDFLAG:ARG:식노습득스킬:L_SKILL && GET_ROLE_PROP("CAN_USE_MANTRA", ARG, , TRANS_MODE) == 2
					SETCOLOR COLOR("DARK-GRAY")
				;---- EDIT 044 MOD END ---------------------------
				CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, ARG
				PRINTFORM [{L_SKILL, 4}] %RESULTS, 22, LEFT% × {ITEM:(10000 + L_SKILL), 3}　
				;---- EDIT 028 ADD START -------------------------
				RESETCOLOR
				;---- EDIT 028 ADD END ---------------------------
			NEXT
			PRINTFORML 
		NEXT
		DRAWLINE
		SIF !L_PAGE_MAX
			SETCOLOR COLOR("DARK-GRAY")
		PRINTFORM %" " * 20%
		PRINTBUTTON "[-] 이전페이지", "-"
		PRINTFORM %" " * 16%<Page.{L_PAGE}>%" " * 14%
		PRINTBUTTON "[+] 다음페이지", "+"
		RESETCOLOR
		SIF !LINEISEMPTY()
			PRINTL 
	ENDIF
ELSE
	CALL PRINT_SPACE_ENHANCE
	CLEARLINE 5
ENDIF
;---- EDIT 049 MOD END ---------------------------
DRAWLINE
CALL スキルカード在庫確認(, ARG, , IS_TRANS)
FOR LCOUNT, 0, 21
	SIF FLAG:SHOP커맨드 == [[ショップ:동료마강화]] && !相性素質チェック_F(ARG, LCOUNT, TRANS_MODE)
		SETCOLOR 0xDDDDDD
	SIF (FLAG:SHOP커맨드 == [[ショップ:벨벳룸]] || FLAG:SHOP커맨드 == [[ショップ:탐색]]) && !相性素質チェック_F(ARG, LCOUNT, TRANS_MODE)
		SETCOLOR STRFLAG_EV("初期ペルソナスキル習得", 0, [[이벤트:페르소나]]) ? 0xDDDDDD # 0x404040
	SIF !Z:LCOUNT	;使えるカードが無い系統は暗く表示
		SETCOLOR 0x606060
	;選択中の素質を表示
	SIF LCOUNT == SHOW_SUCCESSION
		SETCOLOR COLOR("aqua")
	PRINTBUTTON @"[%"s" + TOSTR(LCOUNT), 3%] %GET_SUCCESSION(LCOUNT)%", "s" + TOSTR(LCOUNT)
	IF GET_SKILL_CHANGEABLE_RANK(ARG, TRANS_MODE) == 2
		PRINTFORM 　\@ 相性素質チェック_F(ARG, LCOUNT, TRANS_MODE) ? ○ # × \@　
	ELSEIF GET_SKILL_CHANGEABLE_RANK(ARG, TRANS_MODE) == 1
		PRINTFORM 　×　
	ELSEIF FLAG:SHOP커맨드 == [[ショップ:동료마강화]]
		PRINTFORM 　\@ 相性素質チェック_F(ARG, LCOUNT, TRANS_MODE) ? ○ # △ \@　
	ELSEIF (FLAG:SHOP커맨드 == [[ショップ:벨벳룸]] || FLAG:SHOP커맨드 == [[ショップ:탐색]])
		IF STRFLAG_EV("初期ペルソナスキル習得", 0, [[이벤트:페르소나]])
			PRINTFORM 　\@ 相性素質チェック_F(ARG, LCOUNT, TRANS_MODE) ? ○ # △ \@　
		ELSE
			PRINTFORM 　\@ 相性素質チェック_F(ARG, LCOUNT, TRANS_MODE) ? ○ # × \@　
		ENDIF
	ELSE	
		PRINTFORM 　　
	ENDIF
	PRINT 　
	SIF LCOUNT % 6 == 5
		PRINTL 
	RESETCOLOR
NEXT
IF SHOW_SUCCESSION == 22
	SETCOLOR COLOR("aqua")
ELSE
	SETCOLOR Z:22 ? GETDEFCOLOR() # 0x606060
ENDIF
PRINTBUTTON "[s22] 자동효과　　", "s22"
IF SHOW_SUCCESSION == 23
	SETCOLOR COLOR("aqua")
ELSE
	SETCOLOR Z:23 ? GETDEFCOLOR() # 0x606060
ENDIF
PRINTBUTTON "[s23] 레어　　　", "s23"
SIF !LINEISEMPTY()
	PRINTL 
RESETCOLOR
DRAWLINE
PRINTL [0] 돌아간다
INPUTS
IF RESULTS == "-"
	L_PAGE = L_PAGE ? L_PAGE -1 # L_PAGE_MAX
	GOTO START
ENDIF
IF RESULTS == "+"
	L_PAGE = L_PAGE < L_PAGE_MAX ? L_PAGE + 1 # 0
	GOTO START
ENDIF
IF SUBSTRING(RESULTS, 0, 1) == "s"
	IF RESULTS == "s0"
		IF Z:0
			SHOW_SUCCESSION = 0
			L_PAGE = 0
		ENDIF
	ELSE
		RESULT = TOINT(SUBSTRING(RESULTS, 1))
		IF INRANGE(RESULT, 1, 23)
			IF Z:RESULT
				SHOW_SUCCESSION = RESULT
				L_PAGE = 0
			ENDIF
		ENDIF		
	ENDIF
	GOTO START
ENDIF
SIF RESULTS == "0"
	RETURN 0
L_SKILL = TOINT(RESULTS)
SIF L_SKILL <= 0
	GOTO START
SIF !MATCH(HAVE_SKILLCARD_LIST, L_SKILL)
	GOTO START
$INPUT_LOOP
CLEARLINE LINECOUNT - LINE:1
DRAWLINE

;コストを計算
CALL GET_SKILL_PROP, "SKILL_RANK", L_SKILL, ARG
L_RANK = RESULT
L_COST = POWER(RESULT,3)*150 * ＭＡＧ強化ＣＰ補正(ARG) / 1000
;---- EDIT 044 MOD START -------------------------
;喰奴はMAG量5倍
SIF GET_ROLE_PROP("CAN_USE_MANTRA", ARG, , TRANS_MODE) == 2
	L_COST *= 5
;---- EDIT 044 MOD END ---------------------------
CALL GET_SKILL_PROP, "継承不能", L_SKILL, ARG
SIF RESULT
	L_COST *= 3

CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILL, ARG
SIF TALENT:ARG:GET_SUCCESSION(RESULT) == 0
	L_COST *= 2
CALL HAVE_SKILL_SUCCESSION_BODY, ARG, L_SKILL
SIF RESULT
	L_COST /= 2

CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, ARG
PRINTFORML □%RESULTS%
SIF FLAG:스킬속성표시설정 == 1
	CALL SKILL_EXPLAIN_PERFORMANCE, L_SKILL, ARG
CALL GET_SKILL_PROP, "SKILL_EXPLAIN", L_SKILL, ARG
;---- EDIT 013 MOD START -------------------------
PRINTFORML 스킬 랭크:{L_RANK,2}
PRINTFORML 필요 ＭＡＧ　:%TOSTR(L_COST, "###,0"), 8%　
DRAWLINE
PRINTFORML %CALLNAME:ARG,20,LEFT%(현재ＭＡＧ：%TOSTR(GET_CHARA_STOCK_MAG(ARG), "###,0")%)
;---- EDIT 013 MOD END -------------------------
IF CDFLAG:ARG:식노습득스킬:L_SKILL && GET_ROLE_PROP("CAN_USE_MANTRA", ARG, , TRANS_MODE) == 2
	PRINTFORML 이미 습득한 스킬입니다.
ELSEIF L_COST > GET_CHARA_STOCK_MAG(ARG)
	PRINTFORML ＭＡＧ가 부족합니다
ELSE
	PRINTL 습득하시겠습니까？
	PRINTBUTTON "[0] Yes" + " " * 20, 0
	PRINTL 
	PRINTBUTTON "[1] No" + " " * 20, 1
	PRINTL 
	CALL PRINT_SPACE_ENHANCE
	DRAWLINE
	PRINTL 
	INPUT
	SELECTCASE RESULT
		CASE 0
			CLEARLINE LINECOUNT - LINE:1
			;ABL:ARG:ARGS = L_SKILL
			;喰奴は習得スキル追加
			;---- EDIT 028 MOD START -------------------------
			IF GET_ROLE_PROP("CHANGEABLE_SKILLCOUNT", ARG, , TRANS_MODE)
				IF GET_ROLE_PROP("CAN_USE_MANTRA", ARG, , TRANS_MODE) == 2
					CALL PUSH_LEARNED_MANTRA_SKILLLIST, ARG, L_SKILL
					;スキル欄に空きがあるならそのままセット
					SIF ARGS != ""
						CALL SET_FRIEND_HAVE_SKILL, ARG, L_SKILL, TRANS_MODE
				ELSE
					IF ARGS != ""
						CALL SET_FRIEND_HAVE_SKILL, ARG, L_SKILL, TRANS_MODE
					ELSE
						CALL LEARN_SKILL,ARG,L_SKILL,IS_TRANS, "習得スキル登録なし"
						SIF !RESULT
							RETURN 0
					ENDIF
				ENDIF
			ELSE
				CALL SET_FRIEND_HAVE_SKILL, ARG, L_SKILL, TRANS_MODE
			ENDIF 
			;---- EDIT 028 MOD END ---------------------------
			CALL CONTROL_MAG , ARG , -L_COST
			CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, ARG
			PRINTFORML %ARG는% %조사처리(RESULTS,"를")% 습득했다
			CALL PRINT_SPACE_ENHANCE
			DRAWLINE
			PRINTL 
			WAIT
			ITEM:(10000+L_SKILL) -= 1
			CALL SP_SKILL_CHECK,L_SKILL
			;特殊スキルだとスキルロック
			IF RESULT
				IF IS_TRANS
					SETBIT CFLAG:ARG:악마변신스킬잠금설정,HAVE_SKILL(ARG,L_SKILL,1)
				ELSE
					SETBIT CFLAG:ARG:스킬잠금설정,HAVE_SKILL(ARG,L_SKILL,1)
				ENDIF
			ENDIF
			;変身・リンク関係のスキルを所持スキルに反映
			;CALL FIX_CHARA_TRANS_SKILL, ARG
			CALL SYNC_STATUS,ARG
			CALL HEALTH_CHARA,ARG
			RETURN 1
		CASE 1
			GOTO START
		CASEELSE
			GOTO INPUT_LOOP
	ENDSELECT
ENDIF
CALL PRINT_SPACE_ENHANCE
DRAWLINE
PRINTW [0] 돌아간다
GOTO START

;---- EDIT 032 ADD START -------------------------
;===================================================
;スキル抽出
;===================================================
@MAG_MAKE_SKILLCARD, ARG, IS_TRANS
#DIM LINE, 3
#DIM LCOUNT
#DIM L_SKILL
#DIM L_RESULT
#DIM IS_TRANS
#DIMS TRANS_MODE
#DIMS L_SKILL_NAME
#DIM CAN_NOT_MAKE_SKILLCARD, HAVEABLE_SKILLNUM
TRANS_MODE = \@IS_TRANS ? 変身形態 # 通常形態\@
LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - LINE
CALL MAG_ENHANCE_INFO_CHARA, U, IS_TRANS
LINE:1 = LINECOUNT
PRINTFORML □스킬 추출　　　소비 충성도:{GET_LOYALTY_FOR_MAKE_SKILLCARD(ARG, "消費")} / 충성도:{GET_CHARA_LOYALTY(ARG)}
CALL MAKE_SKILLCARD_LIST, ARG, TRANS_MODE, CAN_NOT_MAKE_SKILLCARD
CALL PRINT_SPACE_ENHANCE
DRAWLINE
PRINTL [ 0] 돌아간다　[99] 스킬 잠금 설정
INPUT
L_RESULT = RESULT
SELECTCASE L_RESULT
	CASE 0
		RETURN 0
	CASE 99
		CALL SKILL_ROCK_SETTING, ARG, IS_TRANS
		GOTO START
ENDSELECT
SIF !INRANGE(RESULT, 1, HAVEABLE_SKILLNUM + 1)
	GOTO START
SIF CAN_NOT_MAKE_SKILLCARD:(L_RESULT - 1)
	GOTO START
IF TRANS_MODE == "変身形態"
	L_SKILL = ABL:ARG:@"초기변신악마스킬{L_RESULT}"
ELSE
	L_SKILL = ABL:ARG:@"스킬{L_RESULT}"
ENDIF
TRYCCALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, ARG
	L_SKILL_NAME = %RESULTS%
CATCH
	GOTO START
ENDCATCH
CLEARLINE LINECOUNT - LINE:1
PRINTFORML □%L_SKILL_NAME%
SIF FLAG:스킬속성표시설정 == 1
	CALL SKILL_EXPLAIN_PERFORMANCE, L_SKILL, ARG
CALL GET_SKILL_PROP, "SKILL_EXPLAIN", L_SKILL, ARG
PRINTL 
DRAWLINE
PRINTFORML %L_SKILL_NAME%을(를) 스킬카드로 추출합니다. 괜찮겠습니까?
PRINTBUTTON "[0] Yes" + " " * 20, 0
PRINTL 
PRINTBUTTON "[1] No" + " " * 20, 1
PRINTL 
CALL PRINT_SPACE_ENHANCE
DRAWLINE
PRINTL 
CALL INPUTINT, 0, 1
SELECTCASE RESULT
	CASE 0
		CLEARLINE LINECOUNT - LINE:1
		PRINTFORML %CALLNAME:ARG%에게서 %L_SKILL_NAME%의 스킬카드를 추출했다.
		CALL PRINT_SPACE_ENHANCE
		DRAWLINE
		PRINTL 
		WAIT
		CALL CONTROL_LOYALTY, ARG, -GET_LOYALTY_FOR_MAKE_SKILLCARD(ARG, "消費")
		CFLAG:ARG:스킬추출횟수 += 1
		CALL GET_ITEM, 10000 + L_SKILL, 1
		CALL DEL_FRIEND_HAVE_SKILL, ARG, , TRANS_MODE, L_RESULT
		SIF GET_CHARA_LOYALTY(ARG) > GET_LOYALTY_FOR_MAKE_SKILLCARD(ARG, "必要")
			GOTO START
		RETURN 1
	CASE 1
		GOTO START
ENDSELECT
;---- EDIT 032 ADD END ---------------------------
;===================================================
;スキル再習得
;===================================================
@MAG_REMEMBER_SKILL, ARG, ARG:1, ARGS
#DIM LCOUNT, 2
#DIM LINE, 3
#DIMS L_MES
#DIM L_RESULT
#DIM L_SKILLCOUNT, 1
#DIMS LEARNED_SKILL, 100
#DIM L_HAVE_SKILL, 21
#DIM IS_TRANS
#DIM L_SKILL
#DIMS L_SKILLS
#DIM L_RANK, 100
#DIM L_COST, 100
#DIM REMEMBER_NOT_ABLE, 100
#DIMS L_TITLE
#DIM L_CNT
#DIM CAN_LEARN_SUCCESSION, SUCCESSIONNUM
#DIM LISTNUM
#DIM L_PAGE
#DIM L_PAGE_MAX
#DIM SHOWLINENUM

IS_TRANS = ARG:1
L_SKILLCOUNT = CHANGEABLE_SKILLCOUNT(ARG, , \@IS_TRANS ? 変身形態 # 通常形態\@)

VARSET LEARNED_SKILL
FOR LCOUNT, 0, STRCOUNT(C_LEARNED_SKILLS:ARG:IS_TRANS, "/") + 1
	L_SKILLS = %AUTO_SPLIT(C_LEARNED_SKILLS:ARG:IS_TRANS, "/", LCOUNT)%
	SIF L_SKILLS == ""
		CONTINUE
	CALL GETS_SKILL_PROP, "敵専用", L_SKILLS, ARG
	SIF RESULT == 1
		CONTINUE
	CALL GETS_SKILL_PROP, "ロール専用", L_SKILLS, ARG
	IF RESULT == 1
		IF !COUNT_SPLIT(GETS_ROLE_PROP("CAN_USE_SPECIAL_SKILL", ARG), "/", RESULTS)
			CALL GETS_SKILL_PROP, "置換スキル", L_SKILLS, ARG
			SIF !RESULT
				CONTINUE
			L_SKILLS = {RESULT}
		ENDIF
	ENDIF
	;---- EDIT 035 MOD END ---------------------------
	;---- EDIT 027 ADD START -------------------------
	SIF L_SKILLS == "[[스킬:각성스킬]]"
		CONTINUE
	;---- EDIT 027 ADD END ---------------------------
	;いちおう重複チェック
	SIF MATCH(LEARNED_SKILL, L_SKILLS)
		CONTINUE
	LEARNED_SKILL:LCOUNT = %L_SKILLS%
	;ランク判定
	CALL GETS_SKILL_PROP, "SKILL_RANK", L_SKILLS, ARG
	L_RANK:LCOUNT = INRANGE(RESULT, 1, 15) ? RESULT # 15

	L_COST:LCOUNT = POWER(MIN(L_RANK:LCOUNT),3)*150 * ＭＡＧ強化ＣＰ補正(ARG) / 1000
	;コストは常に3倍(スキルカード習得より高くなる)
	L_COST:LCOUNT *= 3
NEXT
LINE = LINECOUNT
L_PAGE = 0
$START
CLEARLINE LINECOUNT - LINE
CALL MAG_ENHANCE_INFO_CHARA, U, IS_TRANS
PRINTL □스킬 재습득

LINE:1 = LINECOUNT
SHOWLINENUM = MAG_ENHANCE_LINE - LINE:1 - 1
L_PAGE_MAX = 0
;---- EDIT 051 MOD START -------------------------
WHILE LEARNED_SKILL:((L_PAGE_MAX + 1) * SHOWLINENUM) != ""
	L_PAGE_MAX++
WEND
;---- EDIT 051 MOD END ---------------------------

VARSET REMEMBER_NOT_ABLE
FOR LCOUNT, 0, SHOWLINENUM
	LISTNUM = LCOUNT + L_PAGE * SHOWLINENUM
	SIF LEARNED_SKILL:LISTNUM ==  ""
		CONTINUE
	IF L_COST:LISTNUM > GET_CHARA_STOCK_MAG(ARG)
		REMEMBER_NOT_ABLE:LISTNUM = 1
		L_TITLE = ＭＡＧ不足
	ELSE
		IF TOINT(LEARNED_SKILL:LISTNUM) == 0
			IF HAVE_PU_SKILL(ARG, LEARNED_SKILL:LISTNUM)
				REMEMBER_NOT_ABLE:LISTNUM = 1
				L_TITLE = 所持済み
			ENDIF
		ELSE
			IF HAVE_SKILL(ARG, TOINT(LEARNED_SKILL:LISTNUM) )
				REMEMBER_NOT_ABLE:LISTNUM = 1
				L_TITLE = 所持済み
			ELSE
				L_TITLE = 
			ENDIF
		ENDIF
	ENDIF
	CALL GETS_SKILL_PROP, "SKILL_NAME", LEARNED_SKILL:LISTNUM, ARG
	HTML_PRINT @"<button value = '{LISTNUM + 1}' title = '%L_TITLE%'>" + @"<font color = '%TOSTR_HTML(REMEMBER_NOT_ABLE:LISTNUM ? COLOR("DARK-GRAY") # GETDEFCOLOR())%'>" + @"[{LISTNUM + 1, 2}] %RESULTS, SKILLNAMELENS:1, LEFT%%TOSTR(L_COST:LISTNUM, "###,0") + "ＭＡＧ", 15%" +"</font>" + "</button>"
NEXT
WHILE LINECOUNT < LINE:1 + SHOWLINENUM + 1
	PRINTL 
WEND
RESETCOLOR
IF LEARNED_SKILL:SHOWLINENUM != ""
	PRINTBUTTON "[-] 이전페이지", "-"
	PRINTFORM %" "* 5%Page.{L_PAGE}%" " * 5%
	PRINTBUTTON "[+] 다음페이지", "+"
	PRINTL 
ENDIF
CALL PRINT_SPACE_ENHANCE
DRAWLINE
PRINTL [0] 돌아간다
INPUTS
IF RESULTS == "-"
	L_PAGE = L_PAGE ? L_PAGE -1 # L_PAGE_MAX
	GOTO START
ENDIF
IF RESULTS == "+"
	L_PAGE = L_PAGE < L_PAGE_MAX ? L_PAGE + 1 # 0
	GOTO START
ENDIF
SIF RESULTS == "0"
	RETURN 0
;---- EDIT 031 MOD START -------------------------
;数値化
SIF !ISNUMERIC(RESULTS)
	GOTO START
LISTNUM = TOINT(RESULTS) - 1
;値域外
;SIF !INRANGE(LISTNUM, 1, VARSIZE("LEARNED_SKILL"))
;---- EDIT 036 MOD START -------------------------
SIF !INRANGE(LISTNUM, 0, VARSIZE("LEARNED_SKILL"))
	GOTO START
;---- EDIT 036 MOD END ---------------------------
L_SKILLS = %LEARNED_SKILL:LISTNUM%
$INPUT_LOOP
CLEARLINE LINECOUNT - LINE:1
DRAWLINE

CALL GETS_SKILL_PROP, "SKILL_NAME", L_SKILLS, ARG
SIF RESULTS == ""
	GOTO START
;---- EDIT 031 MOD END ---------------------------
PRINTFORML □%RESULTS%
PRINTFORML 스킬 랭크:{L_RANK:LISTNUM,2}
PRINTFORML 필요ＭＡＧ　:%TOSTR(L_COST:LISTNUM, "###,0"), 8%　
LINE:2 = LINECOUNT
;所持していない専用スキルは表示できないので削る
IF FLAG:스킬속성표시설정 == 1
	IF ISNUMERIC(L_SKILLS)
		CALL SKILL_EXPLAIN_PERFORMANCE, TOINT(L_SKILLS), ARG
	ELSE
		CSTR:ARG:비소지스킬 '= L_SKILLS
		CALL SKILL_EXPLAIN_PERFORMANCE, [[스킬:비소지스킬]], ARG
		CSTR:ARG:비소지스킬 '= ""
	ENDIF
ENDIF
CALL GETS_SKILL_PROP, "SKILL_EXPLAIN", L_SKILLS, ARG
WHILE LINECOUNT < LINE:2 + 3
	PRINTL 
WEND
DRAWLINE
PRINTFORML %CALLNAME:ARG,20,LEFT%(현재ＭＡＧ：%TOSTR(GET_CHARA_STOCK_MAG(ARG), "###,0")%)
IF REMEMBER_NOT_ABLE:LISTNUM
	PRINTFORML 재습득할 수 없습니다。
ELSE
	PRINTL 습득하시겠습니까？
	PRINTBUTTON "[0] Yes" + " " * 20, 0
	PRINTL 
	PRINTBUTTON "[1] No" + " " * 20, 1
	PRINTL 
	CALL PRINT_SPACE_ENHANCE
	DRAWLINE
	PRINTL 
	INPUT
	SELECTCASE RESULT
		CASE 0
			CLEARLINE LINECOUNT - LINE:1
			IF TOINT(L_SKILLS) == 0 
				CALL LEARN_PU_SKILL, ARG, L_SKILLS, IS_TRANS, "NOMES"
			ELSE
				CALL LEARN_SKILL, ARG, TOINT(L_SKILLS), IS_TRANS, "NOMES"
			ENDIF
			SIF !RESULT
				RETURN 0
			CALL CONTROL_MAG , ARG , -L_COST:LISTNUM
			CALL GETS_SKILL_PROP, "SKILL_NAME", L_SKILLS, ARG
			PRINTFORML %ARG는% %조사처리(RESULTS,"를")% 습득했다
			CALL PRINT_SPACE_ENHANCE
			DRAWLINE
			PRINTL 
			WAIT
			;変身・リンク関係のスキルを所持スキルに反映
			CALL FIX_CHARA_TRANS_SKILL, ARG
			CALL SYNC_STATUS,ARG
			CALL HEALTH_CHARA,ARG
			RETURN 1
		CASE 1
			GOTO START
		CASEELSE
			GOTO INPUT_LOOP
	ENDSELECT
ENDIF
CALL PRINT_SPACE_ENHANCE
DRAWLINE
PRINTW [0] 돌아간다
GOTO START

;---- EDIT 038 ADD START -------------------------
@MAG_REPLACE_SKILL, ARG, SELECT_TRANS
#DIM LCOUNT, 2
#DIM LINE, 2
#DIM L_SKILL
#DIMS L_SKILLS
#DIMS L_SKILL_TYPE
#DIM L_SKILLCOUNT
#DIM LAST_CLICK
#DIM HAVE_SKILL_LIST, 100
#DIM HAVE_SKILL_DELNOTABLE, 100
#DIMS SKILL_LIST, 100
#DIM IS_TRANS
#DIMS SELECT_TRANS
#DIMS SHOW_LINE
#DIM TEMPNUM
#DIMS TEMPS
VARSET HAVE_SKILL_LIST
VARSET HAVE_SKILL_DELNOTABLE
VARSET SKILL_LIST
LAST_CLICK = 0

IS_TRANS = SELECT_TRANS == "変身形態"
L_SKILLCOUNT = GET_ROLE_PROP("CHANGEABLE_SKILLCOUNT", ARG, , SELECT_TRANS)
IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	L_SKILL_TYPE = \@IS_TRANS ? 초기변신악마스킬 # 인간시스킬\@
ELSE
	L_SKILL_TYPE = 스킬
ENDIF
;所持スキルを登録
FOR LCOUNT, 0, L_SKILLCOUNT
	L_SKILL = ABL:ARG:(L_SKILL_TYPE + TOSTR(LCOUNT + 1))
	IF IS_PU_SKILLNUM(L_SKILL)
		L_SKILLS = %CSTR:ARG:("전용기" + TOSTR(L_SKILL - [[스킬:전용기1]] + 1))%
	ELSE
		L_SKILLS = %TOSTR(L_SKILL)%
	ENDIF
	HAVE_SKILL_LIST:LCOUNT = 1
	SKILL_LIST:LCOUNT = %L_SKILLS%
	;削除不能属性
	CALL GETS_SKILL_PROP, "SKILL_DEL_UNABLE", L_SKILLS, ARG
	SIF RESULT
		HAVE_SKILL_DELNOTABLE:LCOUNT = 1
NEXT
FOR LCOUNT, 0, STRCOUNT(C_LEARNED_SKILLS:ARG:IS_TRANS, "/") + 1
	L_SKILLS = %AUTO_SPLIT(C_LEARNED_SKILLS:ARG:IS_TRANS, "/", LCOUNT)%
	SIF L_SKILLS == ""
		CONTINUE
	CALL GETS_SKILL_PROP, "敵専用", L_SKILLS, ARG
	SIF RESULT == 1
		CONTINUE
	CALL GETS_SKILL_PROP, "ロール専用", L_SKILLS, ARG
	IF RESULT == 1
		IF !COUNT_SPLIT(GETS_ROLE_PROP("CAN_USE_SPECIAL_SKILL", ARG, SELECT_TRANS), "/", RESULTS)
			CALL GETS_SKILL_PROP, "置換スキル", L_SKILLS, ARG
			SIF !RESULT
				CONTINUE
			L_SKILLS = {RESULT}
		ENDIF
	ENDIF
	SIF MATCH(SKILL_LIST, L_SKILLS)
		CONTINUE
	SKILL_LIST:FINDELEMENT(SKILL_LIST, "", , , 1) = %L_SKILLS%
NEXT
LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - LINE
CALL MAG_ENHANCE_INFO_CHARA, U, IS_TRANS
PRINTFORML □스킬 교체({MATCH(HAVE_SKILL_LIST, 1),2} / {L_SKILLCOUNT,2})
FOR LCOUNT:1, 0, 15
	SHOW_LINE = 
	FOR LCOUNT, 0, 3
		TEMPNUM = LCOUNT * 15 + LCOUNT:1
		SIF SKILL_LIST:TEMPNUM == ""
			BREAK
		IF ISNUMERIC(SKILL_LIST:TEMPNUM)
			CALL GETS_SKILL_PROP, "SKILL_NAME", SKILL_LIST:TEMPNUM, ARG
			TEMPS = [{TEMPNUM + 1, 2}] %RESULTS, SKILLNAMELENS, LEFT%
		ELSE
			TEMPS = [{TEMPNUM + 1, 2}] %SKILL_LIST:TEMPNUM, SKILLNAMELENS, LEFT%
		ENDIF
		CALL GET_SKILL_EXPLAIN_TOOLTIP, , ARG, SKILL_LIST:TEMPNUM
		TEMPS = %SET_BUTTON_TAG(TEMPS, TOSTR(TEMPNUM + 1), RESULTS)%
		SIF HAVE_SKILL_LIST:TEMPNUM
			TEMPS = %SET_COLOR_TAG(TEMPS, "aqua")%
		SHOW_LINE += TEMPS
		;---- EDIT 051 MOD START -------------------------
		IF HAVE_SKILL_DELNOTABLE:TEMPNUM
			SHOW_LINE += "<削除不能>"
		ELSE
			SHOW_LINE += " " * 10
		ENDIF
		;---- EDIT 051 MOD END ---------------------------
	NEXT
	HTML_PRINT SHOW_LINE
NEXT
DRAWLINE

L_SKILLS = %SKILL_LIST:LAST_CLICK%
IF ISNUMERIC(SKILL_LIST:LAST_CLICK)
	CALL GETS_SKILL_PROP, "SKILL_NAME", SKILL_LIST:LAST_CLICK, ARG
	TEMPS = %RESULTS%
ELSE
	TEMPS = %L_SKILLS%
ENDIF
PRINTFORML □%TEMPS%
LINE:1 = LINECOUNT
;高さ合わせが激烈に死ぬのでここではオミット
;SIF FLAG:스킬속성표시설정 == 1 && ISNUMERIC(L_SKILLS)
;	CALL SKILL_EXPLAIN_PERFORMANCE, TOINT(L_SKILLS), ARG
CALL GETS_SKILL_PROP, "SKILL_EXPLAIN", L_SKILLS, ARG
WHILE LINECOUNT < LINE:1 + 3
	PRINTL 
WEND
CALL PRINT_SPACE_ENHANCE
DRAWLINE
SIF MATCH(HAVE_SKILL_LIST, 1) != L_SKILLCOUNT
	SETCOLOR COLOR("gray")
PRINTL [0] 돌아간다
RESETCOLOR
INPUT
IF RESULT == 0 && MATCH(HAVE_SKILL_LIST, 1) == L_SKILLCOUNT
	SKIPDISP 1
	;一旦スキルをすべて消す
	FOR LCOUNT, 1, L_SKILLCOUNT + 1
		CALL DEL_FRIEND_HAVE_SKILL, ARG, , SELECT_TRANS, LCOUNT
	NEXT
	;全て習得させる
	FOR LCOUNT, 0, VARSIZE("SKILL_LIST")
		SIF !HAVE_SKILL_LIST:LCOUNT
			CONTINUE
		IF ISNUMERIC(SKILL_LIST:LCOUNT)
			CALL LEARN_SKILL, ARG, TOINT(SKILL_LIST:LCOUNT), IS_TRANS
		ELSE
			CALL LEARN_PU_SKILL, ARG, SKILL_LIST:LCOUNT, IS_TRANS
		ENDIF
	NEXT
	SKIPDISP 0
	RETURN 1
ELSE
	IF INRANGE(RESULT, 1, VARSIZE("SKILL_LIST") + 1)
		RESULT--
		LAST_CLICK = RESULT
		SIF SKILL_LIST:RESULT == ""
			GOTO START
		SIF HAVE_SKILL_DELNOTABLE:RESULT
			GOTO START
		HAVE_SKILL_LIST:RESULT = !HAVE_SKILL_LIST:RESULT

	ENDIF
ENDIF
GOTO START
;---- EDIT 038 ADD END ---------------------------
