;===================================================
;基本能力強化
;基本計算式
;250 * (n / 3 + 1) * (n / 3 + 2) * CP補正 * MASTER補正 * ロール補正
;
;n = 능력강화횟수
;CP補正 = 900 + MAXBASE:CP / 1000
;MASTER補正 = 100
;===================================================
@ENHANCE_BASE,ARG
#DIM DYNAMIC ＣＰ보정
#DIM DYNAMIC LINE, 3
#DIMS DYNAMIC L_MES
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_COST, 3
#DIM DYNAMIC INPUT_KEY, 100
LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - LINE
CALL MAG_ENHANCE_INFO_CHARA, U
LINE:1 = LINECOUNT

IF CFLAG:ARG:베어내기플래그 && !COUNT_FREE_MAG_ENHANCE_BASE(ARG)
	PRINTFORML 계승으로 인해 MAG 강화의 상한이 제한되어 있습니다.
	PRINTFORML 이로 인해 MAG 강화가 효과를 발휘하는 양이 LV에 따라 변화합니다.
	PRINTFORML 현재 LV에 따른 MAG 강화 횟수를 초과하는 강화 횟수를 잃는 것으로 제한을 해제할 수 있습니다.
	PRINTFORML 제한을 해제하시겠습니까?
	PRINTL 
	PRINTL [1] 해제한다
	PRINTL [0] 돌아간다
	;---- EDIT 025 ADD START -------------------------
	IF MAG_ENHANCE_LINE < 0
		LINE:2 = LINECOUNT
	ELSE
		CALL PRINT_SPACE_ENHANCE
	ENDIF
	DRAWLINE
	PRINTL [0] 돌아간다
	CALL INPUTINT, 0, 1
	IF RESULT == 1
		CFLAG:ARG:능력강화횟수 = BASE:ARG:LV * 3 / 2 + 18
		FOR LCOUNT, 1, BASESTATUSNUM
			CFLAG:ARG:(GET_BASESTATUS(LCOUNT) + "강화횟수") = 0
		NEXT
		L_MES = %NAME:ARG%のステータス制限が解除された！
		CFLAG:ARG:베어내기플래그 = 0
	ELSE
		RETURN 0
	ENDIF
ELSE
	VARSET INPUT_KEY
	INPUT_KEY:0 = 1
	;能力ＵＰに必要な値を計算
	L_COST = MAG_CALC_ENHANCE_BASE(ARG), 0, 0
	FOR LCOUNT, 0, 5
		L_COST:1 += MAG_CALC_ENHANCE_BASE(ARG, LCOUNT)
	NEXT
	FOR LCOUNT, 0, 10
		L_COST:2 += MAG_CALC_ENHANCE_BASE(ARG, LCOUNT)
	NEXT
	IF COUNT_FREE_MAG_ENHANCE_BASE(ARG)
		PRINTFORML 어느 능력을 강화하시겠습니까？　　({COUNT_FREE_MAG_ENHANCE_BASE(ARG)}회 까지 무상 강화 가능)
	ELSE
		IF L_COST < 0
			PRINTFORML 현재 가능한 강화 상한에 도달했습니다
		ELSE
			PRINTFORML 어느 능력을 강화하시겠습니까？　　(현재ＭＡＧ：%TOSTR(GET_CHARA_STOCK_MAG(ARG), "###,0")%)
		ENDIF
	ENDIF
	VARI L_BUTTON_NUM
	FOR LCOUNT:1, 0, 3
		PRINTFORM <%AUTO_SPLIT(" +1/ +5/+10", "/", LCOUNT:1)%> 
		SIF L_COST:(LCOUNT:1) >= 0
			PRINTFORM <필요ＭＡＧ:%TOSTR(L_COST:(LCOUNT:1), "###,0"), STRLENS(TOSTR(LOCAL:5, "###,0"))%>
		PRINTL 

		FOR LCOUNT,1,7
			L_BUTTON_NUM = LCOUNT + LCOUNT:1 * 10
			SETCOLOR COLOR("デフォルト")
			INPUT_KEY:L_BUTTON_NUM = 1
			SIF GET_CHARA_STOCK_MAG(ARG) < L_COST:(LCOUNT:1)
				INPUT_KEY:L_BUTTON_NUM = 0
			SIF L_COST:(LCOUNT:1) < 0
				INPUT_KEY:L_BUTTON_NUM = 0
			SIF INPUT_KEY:L_BUTTON_NUM == 0
				SETCOLOR COLOR("DARK-GRAY")
			PRINTFORML [{L_BUTTON_NUM, 2}] %GET_BASESTATUS(LCOUNT),5% {BASE:ARG:(GET_BASESTATUS(LCOUNT)),4} + {CFLAG:ARG:(GET_BASESTATUS(LCOUNT) + "강화횟수"),4}
			RESETCOLOR
		NEXT
	NEXT
	;---- EDIT 025 ADD START -------------------------
	IF MAG_ENHANCE_LINE < 0
		LINE:2 = LINECOUNT
	ELSE
		CALL PRINT_SPACE_ENHANCE
	ENDIF
	;---- EDIT 025 ADD END ---------------------------
	DRAWLINE
	PRINTL [0] 돌아간다
	CALL INPUT_ARRAY, INPUT_KEY
	IF RESULT == 0
		RETURN 0
	ELSE
		SELECTCASE RESULT / 10
			CASE 0
				IF GET_CHARA_STOCK_MAG(ARG) < L_COST:0
					L_MES = MAGが足りない！
				ELSE
					L_MES = %NAME:ARG%の%GET_BASESTATUS(RESULT % 10)%が1上がった
					CFLAG:ARG:(GET_BASESTATUS(RESULT % 10) + "강화횟수") += 1
					CALL CONTROL_MAG,ARG,-L_COST:0
					CFLAG:ARG:강화사용ＭＡＧ += L_COST:0
				ENDIF
			CASE 1
				IF GET_CHARA_STOCK_MAG(ARG) < L_COST:1
					L_MES = MAGが足りない！
				ELSE
					L_MES = %NAME:ARG%の%GET_BASESTATUS(RESULT % 10)%が5上がった
					CFLAG:ARG:(GET_BASESTATUS(RESULT % 10) + "강화횟수") += 5
					CALL CONTROL_MAG,ARG,-L_COST:1
					CFLAG:ARG:강화사용ＭＡＧ += L_COST:1
				ENDIF
			CASE 2
				IF GET_CHARA_STOCK_MAG(ARG) < L_COST:2
					L_MES = MAGが足りない！
				ELSE
					L_MES = %NAME:ARG%の%GET_BASESTATUS(RESULT % 10)%が10上がった
					CFLAG:ARG:(GET_BASESTATUS(RESULT % 10) + "강화횟수") += 10
					CALL CONTROL_MAG,ARG,-L_COST:2
					CFLAG:ARG:강화사용ＭＡＧ += L_COST:2
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
;能力強化回数は実際に振られてる数から取る
;強化回数だけ多い＝無償中はカウントが増えない
VARI STOCK_STAT_SUM = CFLAG:ARG:능력강화횟수
CFLAG:ARG:능력강화횟수 = MAX(SUMARRAY(CFLAG:ARG:0, GETNUM(CFLAG, "힘강화횟수"), GETNUM(CFLAG, "운강화횟수")+1), CFLAG:ARG:능력강화횟수)

CALL SYNC_STATUS,ARG
CLEARLINE LINECOUNT - LINE:1
PRINTFORML %L_MES%

VARI ADD_MASTER_STAT
ADD_MASTER_STAT = MIN(CFLAG:ARG:능력강화횟수 - STOCK_STAT_SUM, CFLAG:ARG:능력강화횟수 - CFLAG:MASTER:능력강화횟수)
IF ADD_MASTER_STAT > 0
	PRINTFORML 
	PRINTFORML 추가로 %CALLNAME:MASTER%의 능력 강화 횟수가 {ADD_MASTER_STAT}회 늘어났다.
	CFLAG:MASTER:능력강화횟수 += ADD_MASTER_STAT
ENDIF
;---- EDIT 025 ADD START -------------------------
IF MAG_ENHANCE_LINE < 0
	WHILE LINECOUNT < LINE:2
		PRINTL 
	WEND
ELSE
	CALL PRINT_SPACE_ENHANCE
ENDIF
;---- EDIT 025 ADD END ---------------------------
DRAWLINE
PRINTL [0] 돌아간다
WAIT
GOTO START
