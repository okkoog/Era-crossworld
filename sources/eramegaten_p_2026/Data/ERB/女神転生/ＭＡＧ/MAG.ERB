;체력(0)と気力(1)の+100～+1000までのコストを変数に保存
FOR L_COUNT,0,10
	MAG_COST:0:L_COUNT = MAG_GROWTH_COST(ARG, 0, MAXBASE:ARG:체력 + L_COUNT * 100)
	MAG_COST:1:L_COUNT = MAG_GROWTH_COST(ARG, 1, MAXBASE:ARG:기력 + L_COUNT * 100)
	IF L_COUNT != 0
		MAG_COST:0:L_COUNT += MAG_COST:0:(L_COUNT - 1)
		MAG_COST:1:L_COUNT += MAG_COST:1:(L_COUNT - 1)
	ENDIF
NEXT

;表示が崩れないように文字数を計算
COST_LENGTH:0 = MAX(7, STRLENS(TOSTR(MAG_COST:0:9, "###,0")))
COST_LENGTH:1 = MAX(7, STRLENS(TOSTR(MAG_COST:1:9, "###,0")))
PRINTFORML %@"체력 (현재의최대치:{MAXBASE:ARG:체력})", 20 + COST_LENGTH:0, LEFT%  기력 (현재의최대치:{MAXBASE:ARG:기력})

FOR L_COUNT,0,10
	;触手エネルギー使用可能時は使用する触手エネルギーを計算する
	SIF TENTACLE_FLAG
		TENTACLE_COST = ((MAG_COST:0:L_COUNT - GET_CHARA_STOCK_MAG(ARG)) + TENTACLE_RATE - 1) / TENTACLE_RATE
	;ＭＡＧが足りないかつ、触手エネルギーが使用不可・コストがＭＡＧ上限を上回る・触手エネルギー不足のいずれかで上昇不可能とする
	SIF GET_CHARA_STOCK_MAG(ARG) < MAG_COST:0:L_COUNT && (!TENTACLE_FLAG || GET_CHARA_MAXMAG(ARG) < MAG_COST:0:L_COUNT || FLAG:촉수에너지 < TENTACLE_COST)
