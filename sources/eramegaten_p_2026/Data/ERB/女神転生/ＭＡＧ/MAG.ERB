		ENDSELECT
		GOTO START
	CASE 2
		VARSET 必要ＭＡＧ
		;사거리
		;DRAWLINE;DEL 041
		INPUT_ABLE = 0
		必要ＭＡＧ:1 = 10, 500, 2500
		FOR LCOUNT, 1, 4
			;---- EDIT 025 ADD START -------------------------
