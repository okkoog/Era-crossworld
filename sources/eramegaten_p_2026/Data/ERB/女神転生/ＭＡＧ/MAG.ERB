PRINTBUTTON "[1] No" + " " * 20, 1
PRINTL 
CALL PRINT_SPACE_ENHANCE
DRAWLINE
PRINTL 
CALL INPUTINT, 0, 1
IF RESULT == 1
	RETURN 0
ELSE
	CLEARLINE LINECOUNT - LINE
	IF ARGS != ""
		PRINTFORML %ARG는% %조사처리(SKILL_NAME,"을")% 습득했다
		CALL PRINT_SPACE_ENHANCE
		DRAWLINE
		PRINTL 
		WAIT
		CALL CONTROL_LOYALTY, ARG, -5000
		CALL SET_FRIEND_HAVE_SKILL, ARG, SKILL_NUM_F("각성스킬"), \@IS_TRANS ? 変身形態 # 通常形態\@
		ABL:ARG:각성스킬 = L_SKILL
	ELSE
		VARI STOCK_覚醒スキル = ABL:ARG:각성스킬
		ABL:ARG:각성스킬 = L_SKILL
		CALL LEARN_SKILL, ARG, SKILL_NUM_F("각성스킬"),IS_TRANS
		IF RESULT
			CALL CONTROL_LOYALTY, ARG, -5000
		ELSE
			ABL:ARG:각성스킬 = STOCK_覚醒スキル
		ENDIF
	ENDIF
	RETURN 1
ENDIF
