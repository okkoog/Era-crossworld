@SHOPCOMABLE_111
SIF !IS_USEABLE_SHOPCOM
	RETURN 0
RESULT:1 = 1
RESULTS = 동료마강화
RETURN 1

@SHOP_COM_111, ARG
#LOCALSIZE 5
LOCAL:4 = RESULT
$INPUT_LOOP
;CALL INPUT_CHARA_LIST("ＭＡＧを使って強化するキャラを選んでください", "CASTING_SHOP_COM_111")
{
CALL INPUT_CHARA_LIST
	, "FUNC_PROPSET_LIST_BATTLE"
	, "MAG를 사용해 강화할 캐릭터를 선택해주세요"
	, "CASTING_SHOP_COM_111" 
	, "SHOW_ADD_UP_FUNCTION"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
IF RESULT != 1000
	CALL ENHANCE(RESULT, A)
	GOTO INPUT_LOOP
ENDIF
RETURN LOCAL:4

@CASTING_SHOP_COM_111(ARG)
SIF IS_RENTING(ARG) || CFLAG:ARG:이자리에없는플래그 || CFLAG:ARG:필터링플래그
	RETURN 0
RETURN 1

@MAG_ENHANCE_INFO_CHARA, ARG, ARG:1
#DIM LCOUNT
#DIM TEMP,2
#DIMS TEMPS
#DIMS L_COLOR			;色、HTML_PRINT想定なので文字列で保存
#DIM BASEBARLENS = 1600	;体力・気力・MAGのバーの長さ
#DIMS INFO_CHARA, 6		;キャラクター情報の中身
;------------------------------------------------------
;選択中のキャラの表示
;------------------------------------------------------
DRAWLINE
VARSET INFO_CHARA
IF G_OPT_USE_ICON == "사용안함"
	INFO_CHARA:0 += " " * 14
ELSE
	INFO_CHARA:0 += GET_FACE_BY_CHARA_AS_HTML(ARG, 600) +  " " * 2
ENDIF
FOR LCOUNT, 1, 6
	INFO_CHARA:LCOUNT += " " * 14
NEXT
;---- EDIT 032 MOD START -------------------------
INFO_CHARA:0 += @"%CALLNAME:ARG, 21, LEFT%"
IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	INFO_CHARA:0 += "형태　:"
	INFO_CHARA:0 += @"<font color = '%TOSTR_HTML(!ARG:1 ? COLOR("aqua") # color("デフォルト"))%'>"+ "<button value = '90'>" + "[90] 인간형태"  + "</button>" + "</font>　"
	INFO_CHARA:0 +=  @"<font color = '%TOSTR_HTML(ARG:1 ? COLOR("aqua") # color("デフォルト"))%'>" + "<button value = '91'>" + "[91] 변신형태"  + "</button>" + "</font>"
ELSE
	INFO_CHARA:0 += " " * 35
ENDIF
INFO_CHARA:1 += @"%"ＬＶ　:" + TOSTR(BASE:ARG:LV), 24 + 32, LEFT%"
VARS BASE_TABLE, 4
VARS COLOR_TABLE, 4
VARI STOCK_VALUE
VARI MAX_VALUE

BASE_TABLE '= "체력", "기력", "ＭＡＧ", "충성도"
COLOR_TABLE '= "赤", "緑", "紫", "青緑"

FOR LCOUNT, 0, 4
	TEMPS '= BASE_TABLE:LCOUNT
	L_COLOR '= COLOR_TABLE:LCOUNT
	SELECTCASE TEMPS
		CASE "ＭＡＧ"
			STOCK_VALUE = GET_CHARA_STOCK_MAG(ARG)
			MAX_VALUE = GET_CHARA_MAXMAG(ARG)
		CASEELSE
			STOCK_VALUE = BASE:ARG:TEMPS
			MAX_VALUE = MAXBASE:ARG:TEMPS
	ENDSELECT
	IF TEMPS != "충성도"
		TEMP = (STOCK_VALUE * BASEBARLENS / MAX_VALUE) + ((STOCK_VALUE * BASEBARLENS % MAX_VALUE) > 0) 
	ELSE
		TEMP = (MIN(STOCK_VALUE, 10000) * BASEBARLENS / 10000) + ((MIN(STOCK_VALUE, 10000) * BASEBARLENS % 10000) > 0) 
	ENDIF
	INFO_CHARA:(LCOUNT+2) += @"%MAG_T(TEMPS), 6, LEFT%:" 
	;バーの長さを0にしてしまうと正しく表示されなくなるので
	SIF TEMP > 0
		INFO_CHARA:(LCOUNT+2) += @"<shape type = 'rect' param = '0, 25, {TEMP}, 50' color = '%TOSTR_HTML(BARCOLORSET(L_COLOR))%'>"
	;バーセットから数値を取れない場合があるので
	CALLFORMF BARCOLORSET(L_COLOR)
	SIF BASEBARLENS - TEMP > 0
		INFO_CHARA:(LCOUNT+2) += @"<shape type = 'rect' param = '0, 25, {BASEBARLENS - TEMP}, 50' color = '%TOSTR_HTML(RESULT:1)%'>"
	IF TEMPS != "충성도"
		INFO_CHARA:(LCOUNT+2) += "(" + @"%ADD_KMGT(STOCK_VALUE, 9)%" + "/" + @"%ADD_KMGT(MAX_VALUE), 5%" + ")"
	ELSE
		INFO_CHARA:(LCOUNT+2) += "(" + @"%ADD_KMGT(STOCK_VALUE, 15)%" + ")"
	ENDIF
NEXT
;---- EDIT 032 MOD END ---------------------------

FOR LCOUNT, 0, 6
	TEMP = CFLAG:ARG:@"%GET_BASESTATUS(LCOUNT + 1)%강화횟수"
	TEMP:1 = BASE:ARG:GET_BASESTATUS(LCOUNT + 1)
	INFO_CHARA:LCOUNT += " " * 6 + @"%GET_BASESTATUS(LCOUNT + 1), 4, LEFT%" + "(" + @"{TEMP:1, 3}" + " + "  + @"{TEMP, 3}" + ")"
	TEMP = TEMP / 3 + (TEMP % 3 > 0)
	INFO_CHARA:LCOUNT += UNICODE(0x258B) * MIN(TEMP, 31)
	INFO_CHARA:LCOUNT += " " * MAX(31 - TEMP, 0)
NEXT
FOR LCOUNT, 0, 6
	HTML_PRINT INFO_CHARA:LCOUNT
NEXT
DRAWLINE
;-------------------------------------------------
;MAG強化
;
;ARG:0 = 強化するキャラの登録番号
;ARG:1 = リストの登録人数。リストはQ配列に入っている
;-------------------------------------------------
@ENHANCE(ARG, ARG:1)
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC TEMP
#DIMS DYNAMIC TEMPS
#DIM DYNAMIC STOCK_CHARA_ID		;なんらかの理由で登録番号がずれる可能性があるので保持しておく
#DIM DYNAMIC LINE				;行数の保持
#DIM DYNAMIC LIST_NO			;リストの何番目のキャラを表示しているか
#DIM DYNAMIC LIST_NUM			;リストの登録人数
#DIM DYNAMIC LIST_CHARA			;右リストの表示作成中のキャラ登録番号
#DIM DYNAMIC LIST_PAGE			;右リストのページ数
#DIMS DYNAMIC SHOW_LINE			;行の表示内容。HTML_PRINT出力用
#DIM DYNAMIC SHOW_NUM			;メイン部分の表示行数
#DIM DYNAMIC LVUP_COST
#DIM DYNAMIC 装備補正変更コスト
#DIMS DYNAMIC ABLE_LIST			;選択可能な選択肢をリストにして保存する
#DIMS DYNAMIC UNABLE_LIST		;選択不可能な選択肢をリストにして保存する。このリストのはいった選択肢はグレー表示で表示される。
#DIMS DYNAMIC BLANK_SKILL		;空きスキルの場所を記録する
#DIM DYNAMIC HAVE_SKILL_NUM		;所持スキル数
#DIM DYNAMIC AWAKE_SKILL
#DIM DYNAMIC STOCK_RESULT
#DIM DYNAMIC STOCK_REDRAW
#DIMS DYNAMIC SELECT_TRANS		;悪魔変身の状態　通常形態と変身形態の2種がはいる
#DIMS DYNAMIC SELECT_LIST, 45	;選択肢の定義
#DIMS DYNAMIC L_TITLE, 45		;ツールチップの内容
#DIMS DYNAMIC L_COLOR			;色、HTML_PRINT想定なので文字列で保存
#DIMS DYNAMIC SELECT_COMMENT, 45;選択肢に付随するコメント
#DIMS DYNAMIC SIDE_LIST, 35		;右リストの中身
#DIM CONST ROLE_SELECT_START = 30
#DIM CONST ROLE_SELECT_END = 40
#DIM CONST CHARA_SELECT_START = 40
#DIM CONST CHARA_SELECT_END = 45
STOCK_RESULT = RESULT
STOCK_REDRAW = CURRENTREDRAW()
REDRAW 0

STOCK_CHARA_ID = CFLAG:ARG:실제가입시간
;LIST_NUM = ARG:1

;---- EDIT P 001 MOD START -------------------------
;---- EDIT 039 MOD START -------------------------
;選択肢のリスト化
SELECT_LIST:1 = 基本能力強化
SELECT_LIST:2 = 香使用強化
SELECT_LIST:3 = ステータスリセット
SELECT_LIST:4 = スキルランクアップ
SELECT_LIST:5 = スキル消去
SELECT_LIST:6 = スキル抽出
SELECT_LIST:7 = スキル習得
SELECT_LIST:8 = スキル再習得
SELECT_LIST:9 = 覚醒スキル習得
SELECT_LIST:10 = 固有スキル習得
SELECT_LIST:11 = 写せ身の極意

SELECT_LIST:12 = 攻撃性能強化
SELECT_LIST:13 = 耐性強化
SELECT_LIST:14 = 神格習合

SELECT_LIST:15 = 体力気力強化

SELECT_LIST:16 = 造魔レベルアップ
SELECT_LIST:17 = スキルセット
SELECT_LIST:18 = ステータスセット
SELECT_LIST:19 = マントラ取得

SELECT_LIST:20 = 장비강화
SELECT_LIST:21 = 装備能力補正変更
SELECT_LIST:22 = 武器修練
SELECT_LIST:28 = 触手エネルギー注入
SELECT_LIST:29 = ＭＡＧ充填

;SELECT_LIST:30 ~ :ロール追加
;SELECT_LIST:40 ~ :キャラ追加
;---- EDIT 039 MOD END ---------------------------
;---- EDIT P 001 MOD END ---------------------------
SELECT_LIST:39 = 顔グラ変更

SHOW_NUM = VARSIZE("SIDE_LIST") - 2
;表示調整
FOR LCOUNT, 0, 60
	PRINTL 
NEXT
LINE = LINECOUNT
CALL TRANS_DEVIL, ARG, 0, "変身解除"
;---- EDIT 028 ADD START -------------------------
;最初に所持スキルを更新しておく
CALL FIX_CHARA_TRANS_SKILL, ARG
;---- EDIT 028 ADD END ---------------------------
$START

;キャラ登録番号がずれてないかチェック
SIF FINDCHARA_TIMEID(STOCK_CHARA_ID) < 0
	RETURN 0
ARG = FINDCHARA_TIMEID(STOCK_CHARA_ID)

;---- EDIT 040 ADD START -------------------------
;サイドのリストの表示用にキャラリストを作る(何らかの理由でキャラの増減が発生する場合も踏まえて毎回作り直す)
VARSET Q, -1
FOR LCOUNT, 0, CHARANUM
	CALL CASTING_SHOP_COM_111, LCOUNT
	SIF !RESULT
		CONTINUE
	Q:FINDELEMENT(Q, -1) = LCOUNT
NEXT
;リストの登録内容数
LIST_NUM = FINDELEMENT(Q, -1)
;---- EDIT 040 ADD END ---------------------------
;---- EDIT 043 ADD START -------------------------
;リストのソートを実行
CALL SORT_MAG_ENHANCE, LIST_NUM
;---- EDIT 043 ADD END ---------------------------

;ステータス同期
CALL SYNC_STATUS, ARG
CLEARLINE LINECOUNT - LINE

LIST_NO = FINDELEMENT(Q, ARG, 0, LIST_NUM)

;中身が空のときと悪魔変身が出来ないロールは通常形態に戻す
SIF !GET_ROLE_PROP("CAN_USE_TRANS", ARG) || SELECT_TRANS == ""
	SELECT_TRANS = 通常形態
VARSET SELECT_COMMENT

;スキル解説用にUにキャラ登録番号を入れておく
U = ARG
;------------------------------------------------------
;右サイドのキャラ表を作成
;変数に格納して実際の出力はあとなので先に処理できる
;------------------------------------------------------
VARSET SIDE_LIST
SIDE_LIST:0 = %"┏" + "━" * 22 + "┓"%
FOR LCOUNT, 1, SHOW_NUM + 1
	SIDE_LIST:LCOUNT = ┃
	IF (LCOUNT + LIST_PAGE * SHOW_NUM) <= LIST_NUM
		LIST_CHARA = Q:(LIST_PAGE * SHOW_NUM + LCOUNT - 1)
		L_COLOR = %TOSTR_HTML(LIST_CHARA == ARG ? COLOR("aqua") # COLOR("デフォルト"))%
		SIDE_LIST:LCOUNT += @"<button value = '{1000 + LCOUNT + LIST_PAGE * SHOW_NUM - 1}'>" + @"<font color = '%L_COLOR%'>" + @"[{1000 + LCOUNT + LIST_PAGE * SHOW_NUM - 1}] " + @"%S_NAME(LIST_CHARA, 18, 2), 20, LEFT%" + "</font></button>"
		SIDE_LIST:LCOUNT += " MAG:"
		;バーをくっつける
		VARI L_LENS
