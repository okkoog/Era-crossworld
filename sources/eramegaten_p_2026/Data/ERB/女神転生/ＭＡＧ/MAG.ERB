				CALL PRINT_SPACE_ENHANCE
				DRAWLINE
				PRINTL [0] 돌아간다
				WAIT
		ENDSELECT
		GOTO START
	CASE 3
		;相性
		INPUT_ABLE = 0
		IF IS_TRANS
			CSV_相性 = CSVABL(CFLAG:ARG:초기링크악마, GETNUM(ABL, "공격상성"), 0)
		ELSE
			CSV_相性 = CSVABL(NO:ARG, GETNUM(ABL, "공격상성"), 0)
		ENDIF
		;必要MAGの設定
		FOR LCOUNT, 1, 5
			必要ＭＡＧ:LCOUNT = 100 * 必要ＭＡＧ基本値 * 2
			;割引素質　いずれかがある場合、半額になる。というか正確にはいずれもないと２倍になる
			L_TALENT = %AUTO_SPLIT("무기/사격무기/팔_발/갈퀴_날개_갈퀴발_꼬리/", "/", LCOUNT -1)%
			IF IS_TRANS
				FOR LCOUNT:1, 0, STRCOUNT(L_TALENT, "_") + 1
					SIF !CSVTALENT(CFLAG:ARG:초기링크악마, GETNUM(TALENT, AUTO_SPLIT(L_TALENT, "_", LCOUNT:1 )))
						CONTINUE
					必要ＭＡＧ:LCOUNT /= 2
					BREAK
				NEXT
			ELSE
				FOR LCOUNT:1, 0, STRCOUNT(L_TALENT, "_") + 1
					SIF !TALENT:ARG:AUTO_SPLIT(L_TALENT, "_", LCOUNT:1)
						CONTINUE
					必要ＭＡＧ:LCOUNT /= 2
					BREAK
				NEXT
			ENDIF
		NEXT
