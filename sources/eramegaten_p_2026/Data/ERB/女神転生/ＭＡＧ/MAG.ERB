	RESETCOLOR
	SIF TENTACLE_FLAG
		TENTACLE_COST = ((MAG_COST:1:L_COUNT - GET_CHARA_STOCK_MAG(ARG)) + TENTACLE_RATE - 1) / TENTACLE_RATE
	SIF GET_CHARA_STOCK_MAG(ARG) < MAG_COST:1:L_COUNT && (!TENTACLE_FLAG || GET_CHARA_MAXMAG(ARG) < MAG_COST:1:L_COUNT || FLAG:촉수에너지 < TENTACLE_COST)
		SETCOLOR 0x404040
	PRINTFORML   [{L_COUNT+11,2}]%"+" + TOSTR(L_COUNT+1) + "00", 5% / %TOSTR(MAG_COST:1:L_COUNT, "###,0"),COST_LENGTH:1,RIGHT%MAG
	RESETCOLOR
NEXT

