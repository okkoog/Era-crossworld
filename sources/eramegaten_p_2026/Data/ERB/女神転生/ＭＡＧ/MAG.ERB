;スキルランクアップ
;===================================================
@MAG_SKILL_RANKUP,ARG,ARG:1
#DIM LCOUNT, 2
#DIM LINE, 2
#DIM L_RESULT
#DIM L_SKILLCOUNT, 1
#DIM 必要ＭＡＧ , 10
#DIM ＣＰ보정, 1
#DIM IS_TRANS
#DIMS TRANS_MODE
#DIM L_SHOWNUM
#DIMS L_SKILL_TYPE
#DIM L_SKILL, 5
#DIMS L_SKILLS
#DIM RANKUP_NUM, 21
#DIM SKILL_RANK

IS_TRANS = ARG:1
;---- EDIT 044 ADD START -------------------------
TRANS_MODE = \@IS_TRANS ? 変身形態 # 通常形態\@
;---- EDIT 044 ADD END ---------------------------
L_SKILLCOUNT = CHANGEABLE_SKILLCOUNT(ARG, , \@IS_TRANS ? 変身形態 # 通常形態\@)

LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - LINE
CALL MAG_ENHANCE_INFO_CHARA, U
;---- EDIT 013 MOD START -------------------------
PRINTFORML □스킬 랭크업　　(현재ＭＡＧ：%TOSTR(GET_CHARA_STOCK_MAG(ARG), "###,0")%)
;---- EDIT 013 MOD END -------------------------
DRAWLINE
LINE:1 = LINECOUNT
IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	L_SKILL_TYPE = \@IS_TRANS ? 초기변신악마스킬 # 인간시스킬\@
ELSE
	L_SKILL_TYPE = 스킬
ENDIF
VARSET RANKUP_NUM
FOR LCOUNT, 0, L_SKILLCOUNT
	L_SKILL = ABL:ARG:@"%L_SKILL_TYPE%{LCOUNT+1}"
	IF L_SKILL > 0
		RESULT = 0
		CALL GET_SKILL_PROP, "SKILL_RANKUP", L_SKILL, ARG
		RANKUP_NUM:(LCOUNT+1) = RESULT
		SIF RESULT == 0
			SETCOLOR 0x404040
		CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL,ARG
		PRINTFORM 　[{LCOUNT+1, 2}] %RESULTS, 20,LEFT%
		;---- EDIT 048 MOD START -------------------------
		IF RANKUP_NUM:(LCOUNT+1)
			PRINT 　>>>　
			FOR LCOUNT:1, 1, 1 + RANKUP_NUM:(LCOUNT+1)
				IF LOCAL:1 > 0 && LCOUNT:1 % 3 == 1
					PRINTL 
					PRINTFORM %" " * (2 + 4 + 1 + 20 + 2 + 3 + 2)%
				ENDIF
				PRINTFORM %"[" + SKILL_NAME_F(D:(LCOUNT:1)) + "]", 24,LEFT%
			NEXT
		ENDIF
		;---- EDIT 048 MOD END ---------------------------
		SIF !LINEISEMPTY()
			PRINTL 
		RESETCOLOR
	ENDIF
NEXT
CALL PRINT_SPACE_ENHANCE
DRAWLINE
PRINTL [0] 돌아간다

INPUT
L_RESULT = RESULT
$INPUT_LOOP
CLEARLINE LINECOUNT - LINE:1
IF L_RESULT == 0
	RETURN 0
ELSEIF L_RESULT < 1 || L_RESULT > L_SKILLCOUNT
	GOTO START
ELSEIF !RANKUP_NUM:L_RESULT
	PRINTL 랭크업할 수 없는 스킬입니다。
	CALL PRINT_SPACE_ENHANCE
	DRAWLINE
	PRINTW [0] 돌아간다
	GOTO START
ELSE
	VARSET D,-1
	L_SKILLS = %L_SKILL_TYPE%{L_RESULT}
	L_SKILL = ABL:ARG:L_SKILLS
	VARSET E, -1
	VARSET F, 100 * 100 * 100 * 100 * 100
	CALL SET_RANKUP_TREE, L_SKILL, ARG, IS_TRANS
	DRAWLINE
	LCOUNT = 0
	L_SHOWNUM = LINELENS() / 42
	WHILE E:LCOUNT >= 0
		SETCOLOR GET_CHARA_STOCK_MAG(ARG) < F:LCOUNT ? COLOR("DARK-GRAY") # GETDEFCOLOR()
		PRINTFORM [{LCOUNT+1, 2}] %SKILL_NAME_F(E:LCOUNT), 20, LEFT%%TOSTR(F:LCOUNT, "###,0"), 12%MAG　
		SIF LCOUNT % L_SHOWNUM == (L_SHOWNUM - 1)
			PRINTL 
		LCOUNT++
	WEND
	RESETCOLOR
	SIF !LINEISEMPTY()
		PRINTL 
	CALL PRINT_SPACE_ENHANCE
	DRAWLINE
	PRINTL [0] 돌아간다
	INPUT
	CLEARLINE LINECOUNT - LINE:1
	IF RESULT == 0
		GOTO START
	ELSEIF INRANGE(RESULT - 1,0, VARSIZE("E")) || E:RESULT > 0
		RESULT--
		L_SKILL = E:RESULT
		;---- EDIT 044 MOD START -------------------------
		IF CHECK_SKILL(ARG,L_SKILL) > 0 || (GET_ROLE_PROP("CAN_USE_MANTRA", ARG, , TRANS_MODE) == 2 && CDFLAG:ARG:식노습득스킬:L_SKILL)
			PRINTL 이미 습득한 스킬입니다。
			CALL PRINT_SPACE_ENHANCE
			DRAWLINE
			PRINTW [0] 돌아간다
			GOTO INPUT_LOOP
		ENDIF
		;---- EDIT 044 MOD END ---------------------------
		必要ＭＡＧ = F:RESULT
		IF GET_CHARA_STOCK_MAG(ARG) < 必要ＭＡＧ
			SIF F:RESULT == 100 * 100 * 100 * 100 * 100
				GOTO INPUT_LOOP
			PRINTL ＭＡＧ가 부족합니다
			CALL PRINT_SPACE_ENHANCE
			DRAWLINE
			PRINTW [0] 돌아간다
			GOTO INPUT_LOOP
		ENDIF
		CLEARLINE LINECOUNT - LINE:1
		SIF FLAG:스킬속성표시설정 == 1
			CALL SKILL_EXPLAIN_PERFORMANCE, L_SKILL, ARG
		CALL GET_SKILL_PROP, "SKILL_EXPLAIN", L_SKILL, ARG
		DRAWLINE
		PRINTL 괜찮겠습니까？
		PRINTFORML [0] Yes
		PRINTFORML [1] No
		CALL PRINT_SPACE_ENHANCE
		DRAWLINE
		PRINTL
		INPUT
		SELECTCASE RESULT
			CASE 0
				CLEARLINE LINECOUNT - LINE:1
				CALL CONTROL_MAG, ARG, -必要ＭＡＧ
				CALL GET_SKILL_PROP, "SKILL_NAME", ABL:ARG:L_SKILLS, ARG
				PRINTFORM %조사처리(NAME:ARG,"는")% 순간적인 번뜩임으로 %조사처리(RESULTS,"를")%
				;---- EDIT 044 MOD START -------------------------
				SIF GET_ROLE_PROP("CAN_USE_MANTRA", ARG, , TRANS_MODE) == 2
					CALL PUSH_LEARNED_MANTRA_SKILLLIST, ARG, L_SKILL
				;---- EDIT 044 MOD END ---------------------------
				CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, ARG
				PRINTFORML %조사처리(RESULTS,"로")% 랭크업시켰다！
				CALL PRINT_SPACE_ENHANCE
				DRAWLINE
				PRINTL 
				WAIT
				CALL DEL_FRIEND_HAVE_SKILL, ARG, , \@IS_TRANS ? 変身形態 # 通常形態\@, L_RESULT
				CALL SET_FRIEND_HAVE_SKILL, ARG, L_SKILL, \@IS_TRANS ? 変身形態 # 通常形態\@, L_RESULT
				CALL SYNC_STATUS,ARG
				CALL HEALTH_CHARA,ARG
			CASEELSE
				GOTO INPUT_LOOP
		ENDSELECT
	ELSE
		GOTO INPUT_LOOP
	ENDIF
ENDIF
