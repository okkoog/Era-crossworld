					CALL SYNC_STATUS, ARG
				ELSE
					PRINTFORML 필요 MAG가 부족합니다
					WHILE MAG_ENHANCE_LINE + 2 > LINECOUNT
						PRINTL 
					WEND
					WAIT
				ENDIF
			CASE "スキルセット"
				CALL SET_MANTRA_SKILL, ARG
			CASE "ステータスセット"
				CALL MANTRA_BASESTATUS, ARG
			CASE "マントラ取得"
				CALL DOWNLOAD_MANTRA, , ,ARG
			CASE "장비강화"
				CALL 장비강화 ,ARG
			CASE "装備能力補正変更"
				IF GET_CHARA_STOCK_MAG(ARG) >= 装備補正変更コスト
					CALL 装備能力補正変更 ,ARG
					SIF RESULT == 1
						CALL CONTROL_MAG, ARG, -装備補正変更コスト
				ELSE
					PRINTFORMW 필요 MAG가 부족합니다
				ENDIF
			CASE "武器修練"
				CALL 武器修練,ARG
			CASE "顔グラ変更"
				CALL 顔グラ変更,ARG
			CASE "ＭＡＧ充填"
				BASE:ARG:ＭＡＧ = MAXBASE:ARG:ＭＡＧ
			CASE "触手エネルギー注入"
				CALL TENTACLE_LABORATORY_MAG, ARG
			CASEELSE
				IF INRANGE(FINDELEMENT(SELECT_LIST, SELECT_LIST:TEMP, , , 0), ROLE_SELECT_START, ROLE_SELECT_END - 1)
					CALLFORM ENHANCE_%CSTR:ARG:롤%_%SELECT_LIST:TEMP%, ARG, SELECT_TRANS
				ENDIF
				IF INRANGE(FINDELEMENT(SELECT_LIST, SELECT_LIST:TEMP, , , 0), CHARA_SELECT_START, CHARA_SELECT_END - 1)
					CALLFORM ENHANCE_{NO:ARG}_%SELECT_LIST:TEMP%, ARG, SELECT_TRANS
				ENDIF
		ENDSELECT
ENDSELECT
GOTO START

