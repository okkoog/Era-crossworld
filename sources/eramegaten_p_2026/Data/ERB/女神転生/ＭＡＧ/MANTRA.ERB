@MANTRA_EXPLAIN
#LOCALSIZE 1
DRAWLINE
PRINTL 만트라 시스템 해설
DRAWLINE
PRINTL 식노는 만트라 시스템을 통해 강화할 수 있습니다
PRINTL 알고 싶은 정보를 선택해주세요
DRAWLINE
LOCAL = LINECOUNT
$START
CLEARLINE LINECOUNT - LOCAL
CALL INPUT_SELECT(1, "다운로드", 2, "만트라의 성장 방법", 3, "스킬 세트", 4, "헌트/웨이트 스킬", 5, "스탯 세트", 9, "해설 종료")
SELECTCASE RESULT
	CASE 1
		PRINTFORMW 만트라 다운로드는 MAG를 소비하여 실행할 수 있습니다
		PRINTFORMW 만트라 MAP 상에서 DL가능으로 표시된 만트라를 선택해주세요
		PRINTFORML 또한, 식노는 각자 특기 상성을 지니고 있으며,
		PRINTFORMW 해당 상성에 속하는 만트라는 MAG 소비가 감소합니다
		PRINTL 
		PRINTFORMW 또한, 식노는 무조건 DL가능 상태가 되지만
		PRINTFORMW 그 밖의 만트라는 인접한 만트라를 성장시켜
		PRINTFORMW MASTER해야 비로소 DL가능해집니다
	CASE 2
		PRINTFORMW 다운로드한 만트라는 세트하는 것이 가능해집니다
		PRINTFORMW 만트라는 다운로드 시 자동으로 세트되지만
		PRINTFORMW 중간에 변경하는 것도 가능합니다
		PRINTFORML 이때, 과거에 다운로드한 적이 있는 만트라는
		PRINTFORMW MAG를 지불하지 않고도 세트할 수 있습니다
		PRINTL 
		PRINTFORMW 만트라를 장비한 상태에서 적을 쓰러뜨리면 전투 종료 시
		PRINTFORMW 쓰러뜨린 적의 강함에 따라 AP(아트마 포인트)가 획득됩니다
		PRINTFORMW 그리고 만트라가 일정치의 AP를 획득하면 MASTER 상태가 됩니다
		PRINTL 
		PRINTFORMW 만트라가 MASTER 상태가 됨으로써
		PRINTFORMW 식노는 스킬과 스탯 포인트를 획득하며
		PRINTFORMW 스킬 세트와 스탯 세트에서 세트할 수 있게 됩니다
		PRINTL 
		PRINTFORMW 또한, 만트라 다운로드 시 표시되는 ★은 만트라의 랭크를 나타내며
		PRINTFORMW 이것이 많은 만트라일수록 성장시키기 위해 더 강한 적과 싸워야 합니다
	CASE 3
		PRINTFORMW 식노는 MASTER한 만트라가 내장된 스킬을 자유롭게 선택하여 세트할 수 있습니다
		PRINTFORMW 스킬 세트를 선택하여 스킬을 교체해주세요
	CASE 4
		PRINTW 식노에게는 전용 스킬군으로 헌트 스킬과 웨이트 스킬이 있습니다
		PRINTL 
		PRINTW 헌트 스킬은 적을 먹어치우기 위한 스킬로,
		PRINTW 위력이 낮은 대신 COOP에 의한 추가 피해가 크다는 특성을 지니고 있습니다
		PRINTW 또한 헌트 스킬로 적을 쓰러뜨렸을 경우, 만트라를 성장시키기 위한 AP가 증가합니다
		PRINTW 이 헌트 스킬을 사용함으로써 만트라를 효율적으로 성장시킬 수 있습니다
		PRINTL 
		PRINTW 웨이트 스킬은 일시적으로 식노의 능력을 변화시키는 스킬군입니다
		PRINTW 어태커 계통은 그 턴에 사용하는 헌트 스킬의 상성을 변화시킵니다
		PRINTW 이를 통해 헌트 스킬로 적의 약점을 찌를 수 있게 됩니다
		PRINTL 
		PRINTW 브레이크 계통은 그 턴 동안 지정한 상성의 공격을 무효화합니다
		PRINTW 마찬가지로 리플렉트 계통은 반사, 드레인 계통은 흡수합니다
		PRINTW 이 스킬들은 1턴 동안 여러 번 사용하면 소비 MP가 급격하게 증가하므로 주의해주세요
		PRINTL 
		PRINTW 또한 이 스킬들은 WAIT에서 사용하며, 턴을 소비하지 않습니다
	CASE 5
		PRINTW 만트라를 성장시키는 것으로 식노는 스탯 포인트를 획득할 수 있습니다
		PRINTW 식노는 이 포인트를 배분함으로써 변신 시의 스탯을 변화시킬 수 있습니다
		PRINTL 
		PRINTW 스탯의 증가가 아니라 변화라는 점에 주의해주세요
		PRINTW 식노는 인간 시의 스탯과 악마 시의 스탯을 별개로 가지고 있습니다
		PRINTW 이 중 통상의 레벨업이나 MAG 강화로 자유롭게 바꿀 수 있는 것은 인간 시의 스탯입니다
		PRINTL 
		PRINTW 악마 시의 스탯은 악마의 기본 스탯 비율에 맞춰,
		PRINTW 인간 시의 스탯 총합치를 배분한 것입니다
		PRINTW 스탯 포인트 배분은 이 악마의 기본 스탯을 변화시킴으로써
		PRINTW 결과적으로 인간 시의 스탯 총합치의 배분 비율을 변화시키는 구조입니다
		PRINTL 
		PRINTW 예를 들어 마력에 스탯 포인트를 투자했을 경우, 마력은 오르지만
		PRINTW 그 밖의 스탯은 조금씩 내려가게 됩니다
	CASE 9
		RETURN 0
ENDSELECT
GOTO START

@PUSH_LEARNED_MANTRA_SKILLLIST, L_CHARA, L_SKILL
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_SKILL
SIF !INRANGE(L_SKILL, 1, MANTRA_LEARN_ABLE_SKILLNUM)
	RETURN 0
SIF IS_PU_SKILLNUM(L_SKILL)
	RETURN 0
SIF L_SKILL == [[스킬:각성스킬]]
	RETURN 0
CDFLAG:L_CHARA:식노습득스킬:L_SKILL = 1
RETURN 1