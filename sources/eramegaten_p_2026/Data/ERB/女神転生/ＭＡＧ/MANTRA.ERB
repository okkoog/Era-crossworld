		;파사의광인
	;마신
	CASE 112
		RETURN 8, 1500000, POWER(10, GET_BASESTATUS_NUM("지혜")) * 2, [[스킬:메・디아라한]], [[스킬:암리타]], [[스킬:스리스티]], [[스킬:리프트마]]
		;메시아라이저/オートソーマ
	;雷神王
	CASE 113
	{
