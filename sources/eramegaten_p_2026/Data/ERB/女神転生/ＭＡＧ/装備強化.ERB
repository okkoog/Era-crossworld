			CONTINUE

		CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_STATE", ABL:素材悪魔:LOCALS, 素材悪魔
		SIF RESULT != 付与ステート
			CONTINUE
		CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_BASE_RATE",ABL:素材悪魔:LOCALS, 素材悪魔
		SELECTCASE RESULT
			CASE IS < 31
				スキル評価 = 1
