#DIM DYNAMIC FIRST_LINE
#DIM DYNAMIC SECOND_LINE
#DIM DYNAMIC 対象
#DIM DYNAMIC 装備番号
#DIM DYNAMIC 解除モード

対象 = ARG
装備番号 = ARG:1

