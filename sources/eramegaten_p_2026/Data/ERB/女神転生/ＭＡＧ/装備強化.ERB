	CLEARLINE LINECOUNT - FIRST_LINE
	GOTO START_B

@SHOW_CHARA_LIST_装備強化,ARGS,ARG,ARG:1
#LOCALSIZE 5
#DIMS DYNAMIC 指定
#DIM DYNAMIC 強化段階
#DIM DYNAMIC スキル相性
#DIM DYNAMIC スキル継承相性
#DIM DYNAMIC スキル評価, 3
#DIM DYNAMIC 確率表示
#DIM DYNAMIC LCOUNT,2
#DIM ページ数
#DIM 表示キャラ, MAX_PLAYER_CHARA

指定 = %ARGS%
強化段階 = ARG:1

LOCAL:3 = CURRENTREDRAW(), RESULT
SIF LOCAL:3 != 2
	REDRAW 2
ページ数 = 0
;表示させるキャラを抽出（表示キャラ:*に表示するキャラの登録番号、LOCAL:2に人数）
VARSET 表示キャラ, -1
LOCAL:2 = 0
IF 指定 == "공격상성"
	FOR LOCAL, 0, CHARANUM
		SIF ABL:LOCAL:종족 == 0 || ABL:LOCAL:종족 > 44
			CONTINUE
		SIF 強化段階 > BASE:LOCAL:LV
			CONTINUE
		SIF 계약(LOCAL) > 0
			CONTINUE
		SIF !(IS_RENTING(LOCAL) || CFLAG:LOCAL:이자리에없는플래그 || CFLAG:LOCAL:합체소재사용금지 || CFLAG:LOCAL:필터링플래그)
			表示キャラ:(LOCAL:2++) = LOCAL
	NEXT
ELSEIF 指定 == "추가효과"
	FOR LOCAL, 0, CHARANUM
		SIF ABL:LOCAL:종족 == 0 || ABL:LOCAL:종족 > 44
			CONTINUE
		SIF 強化段階 > BASE:LOCAL:LV
			CONTINUE
		SIF 계약(LOCAL) > 0
			CONTINUE
		CALL 所持スキル追加効果_強化用,LOCAL
		SIF GET_STATE(RESULT) == "GOOD" || GET_STATE(RESULT) == "BOMB" || GET_STATE(RESULT) == "STONE" || GET_STATE(RESULT) == "DYING" || GET_STATE(RESULT) == "FLY"
			CONTINUE
		SIF !(IS_RENTING(LOCAL) || CFLAG:LOCAL:이자리에없는플래그 || CFLAG:LOCAL:합체소재사용금지 || CFLAG:LOCAL:필터링플래그)
			表示キャラ:(LOCAL:2++) = LOCAL
	NEXT
ELSE
	FOR LOCAL, 0, CHARANUM
		SIF ABL:LOCAL:종족 != 0 || GET_VALUE_TALENT_JOINABLE(LOCAL) == 0
			CONTINUE
		SIF 계약(LOCAL) > 0
			CONTINUE
		SIF !(IS_RENTING(LOCAL) || CFLAG:LOCAL:이자리에없는플래그 || CFLAG:LOCAL:필터링플래그)
			表示キャラ:(LOCAL:2++) = LOCAL
	NEXT
ENDIF

LOCAL:1 = LINECOUNT
DO
	CLEARLINE LINECOUNT - LOCAL:1
	DRAWLINE
	PRINTFORML 캐릭터를 선택해주세요　＜page.{ページ数 + 1}/{(LOCAL:2 - 1) / リスト表示数() + 1}＞
	DRAWLINE
;	CALL SHOW_CHARA_LIST

FOR LCOUNT, 0, リスト表示数()
	文字色変更 = 0
	LOCAL = 表示キャラ:(LCOUNT + ページ数 * リスト表示数())
	SIF LOCAL < 0 || CFLAG:LOCAL:이자리에없는플래그 == 1
		CONTINUE
	
	CALL ARRANGE_SETCOLOR, LOCAL
	CALL ARRANGE_TARGETSIGN, LOCAL
	CALL ARRANGE_CHARALIST, LOCAL

	IF 指定 == "공격상성"
		CALL 適正相性_強化用, LOCAL
		PRINTFORM 　[%GET_TYPE(RESULT)%] 
		スキル相性 = RESULT
		スキル評価 = 0
		FOR LCOUNT:1, 1, FLAG:스킬수 + 1
			LOCALS = 스킬{LCOUNT:1}
			SIF ABL:LOCAL:LOCALS == 0
				CONTINUE
			CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", ABL:LOCAL:LOCALS, LOCAL
			スキル継承相性 = RESULT
			IF GET_SUCCESSION(スキル継承相性) == "レア"
				CALL GET_SKILL_PROP, "SKILL_EFECT", ABL:LOCAL:LOCALS, LOCAL
				SIF RESULT == 2 || RESULT == 5 || RESULT == 6
					CONTINUE
				CALL GET_SKILL_PROP, "SKILL_TYPE", ABL:LOCAL:LOCALS, LOCAL
				スキル継承相性 = GET_SUCCESSION_NUM(GET_TYPE(RESULT))
				SIF RESULT == -1
					CONTINUE
			ENDIF
				
			SIF GET_SUCCESSION(スキル継承相性) != GET_TYPE(スキル相性)
				CONTINUE
			CALL GET_SKILL_PROP, "SKILL_RANK", ABL:LOCAL:LOCALS, LOCAL
			SIF RESULT > 4
				スキル評価 += 1
			SIF RESULT > 9
				スキル評価 += 1
			スキル評価 += 1
		NEXT
		;PRINTFORM ({MIN (10 + (15 * 強化:2), 95)})    
		確率表示 = 5
		FOR LCOUNT:1, 0, スキル評価
			SELECTCASE LCOUNT:1
				CASE 0 TO 1
					確率表示 += 15
				CASE 2 TO 6
					確率表示 += 10
				CASE 7 TO 9
					確率表示 += 5
				CASEELSE
			ENDSELECT
		NEXT
		PRINTFORM ({確率表示, 3})  
	ELSEIF 指定 == "추가효과"
		CALL 所持スキル追加効果_強化用, LOCAL
		PRINTFORM 　[%GET_STATE(RESULT),6%] 
		スキル相性 = RESULT
		確率表示 = 0
		FOR LCOUNT:1, 1, FLAG:스킬수 + 1
			LOCALS = 스킬{LCOUNT:1}
			SIF ABL:LOCAL:LOCALS == 0
				CONTINUE
			CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_STATE", ABL:LOCAL:LOCALS, LOCAL
			SIF RESULT != スキル相性
				CONTINUE

			CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_BASE_RATE", ABL:LOCAL:LOCALS, LOCAL
			SELECTCASE RESULT
				CASE IS < 31
					スキル評価 = 1
				CASE IS < 50
					スキル評価 = 2
				CASEELSE
					スキル評価 = 3
			ENDSELECT
			
			CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_MAX_RATE", ABL:LOCAL:LOCALS, LOCAL
			SELECTCASE RESULT
				CASE IS < 71
					スキル評価:1 = 1
				CASE IS < 95
					スキル評価:1 = 2
				CASEELSE
					スキル評価:1 = 3
			ENDSELECT
			
			CALL GET_SKILL_PROP, "SKILL_RANK", ABL:LOCAL:LOCALS, LOCAL
			SELECTCASE RESULT
				CASE IS < 6
					スキル評価:2 = 1
				CASE IS < 11
					スキル評価:2 = 2
				CASEELSE
					スキル評価:2 = 3
			ENDSELECT
			確率表示 += (スキル評価 + スキル評価:1 + スキル評価:2) / 3
		NEXT
		PRINTFORM ({MIN (10 + (5 * 確率表示), 35), 3})    
	ENDIF

	PRINTFORM LV:{BASE:LOCAL:LV,3} 
	CALL ARRANGE_FALLTALENT, LOCAL
	CALL ARRANGE_SEX, LOCAL
	PRINTFORM 　충성도:{GET_CHARA_LOYALTY(LOCAL),8}
	PRINTFORM 　MAG:{GET_CHARA_STOCK_MAG(LOCAL),8}/{GET_CHARA_MAXMAG(LOCAL),8}
	RESETCOLOR

	PRINTL 
	RESETCOLOR
NEXT
RESETCOLOR

	PRINTFORM \@ ページ数 && ページ数 == (LOCAL:2 - 1) / リスト表示数() ? %"\n" * MAX(0, リスト表示数() + 3 + LOCAL:1 - LINECOUNT)% # \@
	DRAWLINE
	PRINTFORMLC \@ ページ数 > 0 ? [1007]이전페이지 # %" " * 16% \@
	PRINTLC [1000]돌아간다
	PRINTFORMLC \@ ページ数 < (LOCAL:2 - 1) / リスト表示数() ? [1009]다음페이지 # %" " * 16% \@
	DO
		INPUT
		LOCAL = RESULT == 1000 || (RESULT == 1007 && ページ数 > 0) || (RESULT == 1009 && ページ数 < (LOCAL:2 - 1) / リスト表示数())
		LOCAL |= MATCH(表示キャラ, RESULT, 0, LOCAL:2)
		SIF !LOCAL
			CLEARLINE 1
	LOOP !LOCAL
	LOCAL = RESULT
	SELECTCASE LOCAL
		CASE 0 TO CHARANUM - 1
			RETURN LOCAL
		CASE 1007
			ページ数--
		CASE 1009
			ページ数++
	ENDSELECT
LOOP LOCAL != 1000
SIF LOCAL:3 != 2
	REDRAW LOCAL:3
SIF LOCAL == 1000
	RETURN -1
RETURN LOCAL

