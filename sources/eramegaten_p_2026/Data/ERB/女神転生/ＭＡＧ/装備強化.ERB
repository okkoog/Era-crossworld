
;魔装術
;お気に入りの装備を最後まで使い続けたい人の為の機能

@장비강화, ARG, ARG:1 = -1
#DIM DYNAMIC FIRST_LINE
#DIM DYNAMIC SECOND_LINE
#DIM DYNAMIC THIRD_LINE
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC 対象
#DIM DYNAMIC 装備部位
#DIM DYNAMIC 装備番号
#DIMS DYNAMIC 装備名
#DIM DYNAMIC 指定
#DIM DYNAMIC 強化値
#DIM DYNAMIC 強化段階
#DIM DYNAMIC 強化不可
#DIM DYNAMIC 概念強化不可

#DIMS DYNAMIC 強化素材1
#DIMS DYNAMIC 強化素材10,2
#DIM DYNAMIC 強化素材個数1
#DIM DYNAMIC 強化素材個数10,2
#DIM DYNAMIC 強化段階_素材判別ループ
#DIM DYNAMIC 改造装備
#DIM DYNAMIC 消費ＭＡＧ, 2
#DIM DYNAMIC 消費Ｐ, 2
#DIM DYNAMIC 消費￥, 2
#DIMS DYNAMIC ボタン
#DIM DYNAMIC INPUT_RESULT

対象 = ARG
指定 = -1

$START_B
FIRST_LINE = LINECOUNT
DRAWLINE
PRINTFORML %CALLNAME:対象%
	CALL 装備強化_CSTR, "強化数", 対象
PRINTFORML □장비 강화 상태      강화 가능 수:{MAX(50 - RESULT)}
IF RESULT >= 50
	強化不可 = 1
	SIF RESULT >= 90
		概念強化不可 = 1
ELSE
	強化不可 = 0
ENDIF

CALL 装備強化_CSTR, "表示", 対象
DRAWLINE

$START_C
SECOND_LINE = LINECOUNT
RESETCOLOR
IF 指定 == -1
	SIF 概念強化不可 == 1
		SETCOLOR COLOR("gray")
	PRINTL [  0] 개념 강화
	IF CSTR:対象:장비강화 != ""
		PRINTL [  1] 능력 강화
		PRINTL [  2] 내성 강화
		SIF 強化不可 == 1
			SETCOLOR COLOR("gray")
		PRINTL [  3] 공격 상성 강화
		PRINTL [  4] 추가 효과 부여
			RESETCOLOR
		PRINTL [  8] 강화 해제
	ENDIF
	PRINTL [ 99] 취급설명서
	PRINTL [999] 그만둔다

	DO
		INPUT
		SELECTCASE RESULT
			CASE 0 TO 4, 8, 99, 999
				指定 = RESULT
				BREAK
			CASEELSE
			;	RESTART
		ENDSELECT
	LOOP 1
	SIF 概念強化不可 == 1 && 指定 < 8 && 指定 != 99 && 指定 != 999
		指定 = 10
	SIF 強化不可 == 1 && (2 < 指定 && 指定 < 8) && 指定 != 99 && 指定 != 999
		指定 = 10
ENDIF

$START_D
THIRD_LINE = LINECOUNT
DRAWLINE

SELECTCASE 指定
	CASE 0 TO 2
		CLEARLINE LINECOUNT - SECOND_LINE
		PRINTL 장비를 선택해주세요
		CALL SHOW_EQUIP_LIST_装備強化,対象
		IF RESULT == 48 || RESULT == 49
			IF RESULT == 48
				PRINTL 이 장비는 한 번 강화를 해제하지 않는 한 강화할 수 없습니다.
				PRINTW 또한, 강화 효과를 받을 수도 없습니다.
			ENDIF
			CLEARLINE LINECOUNT - FIRST_LINE
			指定 = -1
			GOTO START_B
		ENDIF
		装備部位 = RESULT
		装備番号 = EQUIP:対象:GET_EQUIP(RESULT)
		IF 改造装備(装備番号)
			装備名 = %改造装備名称(改造装備番号(装備番号))%
		ELSE
			装備名 = %ITEMNAME:装備番号%
		ENDIF
	CASE 3 TO 4
		装備部位 = GET_EQUIPNUM("검")
		装備番号 = EQUIP:対象:GET_EQUIP(装備部位)
	CASE 8

	CASE 10
		PRINTL 강화 가능 수를 초과했습니다
		PRINTW 불필요한 강화를 해제해주세요
			CLEARLINE LINECOUNT - FIRST_LINE
			指定 = -1
			GOTO START_B
	CASE 99
		
	CASE 999
;		CALL SYNC_STATUS,対象
;		;表示させるキャラをリセット（Q:*に表示するキャラの登録番号、LOCAL:2に人数）
;		VARSET Q, -1
;		A = 0
;		FOR LCOUNT, 0, CHARANUM
;			SIF !(IS_RENTING(LCOUNT) || CFLAG:LCOUNT:이자리에없는플래그 || CFLAG:LCOUNT:필터링플래그)
;				Q:(A++) = LCOUNT
;		NEXT
;		RETURN -1
		RETURN 0
ENDSELECT

IF 指定 != 9 && 指定 != 99
	CALL 装備強化_展開, 対象, 装備番号, "強化段階", "LV"
	強化段階 = RESULT
	IF 強化段階 == 1 && 指定 > 0 && 指定 != 8
		PRINTW 장비의 개념을 강화해주세요
		SIF 指定 == 3 || 指定 == 4
			指定 = -1
		CLEARLINE LINECOUNT - THIRD_LINE
		GOTO START_D
	ELSEIF 指定 == 0
		IF 強化段階 >= 99
			PRINTFORMW 더 이상은 강화할 수 없습니다
			CLEARLINE LINECOUNT - THIRD_LINE
			GOTO START_D
		ELSEIF 改造装備(装備番号)
			IF 強化段階 >= 2
				PRINTW 더 이상은 강화할 수 없습니다
				CLEARLINE LINECOUNT - THIRD_LINE
				GOTO START_D
			ELSE
				PRINTL 개조검을 강화할 경우, 일부 강화를 진행할 수 없습니다
				PRINTL
				PRINTL 능력 강화: 불가
				PRINTL 내성 강화: 불가
				PRINTL
				PRINTL 개념 강화를 실행하시겠습니까?
				PRINTL
				CALL INPUT_YN("예", "아니오", 2)
				IF RESULT == 1
					CLEARLINE LINECOUNT - THIRD_LINE
					GOTO START_D
				ENDIF
			ENDIF
		ELSEIF 強化段階 >= BASE:対象:LV
			PRINTFORMW 강화하기에는 %CALLNAME:対象%의 레벨이 부족합니다
			CLEARLINE LINECOUNT - THIRD_LINE
			GOTO START_D
		ENDIF
	ENDIF
ENDIF

SELECTCASE 指定
	CASE 0
		CLEARLINE LINECOUNT - SECOND_LINE
		$S_LIST
		DRAWLINE
		PRINTL □개념 강화
		DRAWLINE
		CALL 装備強化_展開, 対象, 装備番号, "強化段階", "LV"
		強化段階 = RESULT
		改造装備 = 改造装備(装備番号)
		PRINTFORML <%装備名%>  Lv:{強化段階}
		CALL MAKE_SALERPGITEMLIST,装備部位
		
		$PRINT_LIST
		IF 強化段階 < 99 
			DRAWLINE
			
			
			VARSET 強化素材1
			VARSET 強化素材10
			VARSET 強化素材個数1
			VARSET 強化素材個数10
			VARSET LCOUNT
			
			強化段階_素材判別ループ = 強化段階
			
			;消費ＭＡＧは１回強化の値段。消費ＭＡＧ:1は１０回強化の値段
			消費ＭＡＧ:1 = 0
			消費Ｐ:1 = 0
			消費￥:1 = 0
			FOR LCOUNT, 0, MIN(10, 99 - 強化段階)
				LOCAL = (MAX(1, 2 * (強化段階_素材判別ループ - 1) * 強化段階_素材判別ループ * (強化段階_素材判別ループ + 1)*2 ) + 1000)
				;そのままだと多すぎるので
				LOCAL /= 9
				LOCAL:1 = LOCAL * 11 / 100
				
				SELECTCASE 装備部位
					CASE GET_EQUIPNUM("머리")
						LOCAL /= 2
						LOCAL:1 /= 2
					CASE GET_EQUIPNUM("팔"), GET_EQUIPNUM("발")
						LOCAL /= 3
						LOCAL:1 /= 3
					CASEELSE
				ENDSELECT
				IF LCOUNT == 0
					消費ＭＡＧ = LOCAL
					消費Ｐ = LOCAL:1
					消費￥ = LOCAL / 10
				ENDIF
				消費ＭＡＧ:1 += LOCAL
				消費Ｐ:1 += LOCAL:1
				消費￥:1 += LOCAL / 10
				
				LOCAL = 0
				SELECTCASE 強化段階_素材判別ループ
					CASE 21 TO 30
						強化素材10:(LCOUNT:1) = 오팔
					CASE 31 TO 40
						強化素材10:(LCOUNT:1) = 에메랄드
					CASE 41 TO 50
						強化素材10:(LCOUNT:1) = 터키석
					CASE 51 TO 60
						強化素材10:(LCOUNT:1) = 토파즈
					CASE 61 TO 70
						強化素材10:(LCOUNT:1) = 사파이어
					CASE 71 TO 80
						強化素材10:(LCOUNT:1) = 진주
					CASE 81 TO 90
						強化素材10:(LCOUNT:1) = 루비
					CASE 91 TO 98
						強化素材10:(LCOUNT:1) = 다이아몬드
					CASEELSE
				ENDSELECT
				
				;宝石で交換できる合成素材の売却額が目安
				;ただし入手難度高めなので高めに見積もる
				;あと数が多過ぎても強化に使用しないと思うのでほどほどに
				;香一つが 30個+30個 というのも念頭に置く
				;	と考えていたけれど装備一つの強化に宝石を30個等の消費はかなり重く感じたので減らす
				SELECTCASE 強化素材10:(LCOUNT:1)
					CASE "다이아몬드"
						;20個
						;強化回数が他のレベルと違うのでLv91以上は個別に設定
						SELECTCASE 強化段階_素材判別ループ % 10
							CASE 1, 2
								LOCAL = 1
							CASE 3 TO 5
								LOCAL = 2
							CASE 6
								LOCAL = 3
							CASE 7
								LOCAL = 4
							CASE 8
								LOCAL = 5
							CASEELSE
						ENDSELECT
					CASE "진주", "루비"
						;20個
						SELECTCASE 強化段階_素材判別ループ % 10
							CASE 1 TO 4
								LOCAL = 1
							CASE 5 TO 7
								LOCAL = 2
							CASE 8 TO 9
								LOCAL = 3
							CASE 0
								LOCAL = 4
							CASEELSE
						ENDSELECT
					CASE "에메랄드", "터키석", "토파즈"
						;15個
						SELECTCASE 強化段階_素材判別ループ % 10
							CASE 1 TO 6
								LOCAL = 1
							CASE 7 TO 9
								LOCAL = 2
							CASE 0
								LOCAL = 3
							CASEELSE
						ENDSELECT
					CASE "오팔", "사파이어"
						;10個
						LOCAL = 1
				ENDSELECT
				
				;１回強化用
				IF LCOUNT == 0
					強化素材1 = %強化素材10:(LCOUNT:1)%
					SELECTCASE 装備部位
						CASE GET_EQUIPNUM("머리"), GET_EQUIPNUM("팔"), GET_EQUIPNUM("발")
							強化素材個数1 = 1
							SIF 強化段階 == 98
								強化素材個数1 += 2
						CASEELSE
							強化素材個数1 = LOCAL
					ENDSELECT
				ENDIF
				
				SELECTCASE 装備部位
					CASE GET_EQUIPNUM("머리"), GET_EQUIPNUM("팔"), GET_EQUIPNUM("발")
						強化素材個数10:(LCOUNT:1) += 1
						SIF 強化段階_素材判別ループ == 98
							強化素材個数10:(LCOUNT:1) += 2
					CASEELSE
						強化素材個数10:(LCOUNT:1) += LOCAL
				ENDSELECT
				
				強化段階_素材判別ループ++
				SIF 強化段階_素材判別ループ % 10 == 1
					LCOUNT:1 = 1
			NEXT
			
			IF GET_CHARA_STOCK_MAG(対象) >= 消費ＭＡＧ && MONEY >= 消費ＭＡＧ/10 && ((改造装備 != 1) || (改造装備 == 1 && 強化段階 < 2))
				ボタン = [ + 1] 소비 ＭＡＧ:{消費ＭＡＧ, 8} / {GET_CHARA_STOCK_MAG(対象)}　　소비 ￥:{消費￥, 8} / {MONEY}
				PRINTBUTTON ボタン, 11
			ELSE
				SETCOLOR COLOR("gray")
				PRINTPLAINFORM [ × ] 소비 ＭＡＧ:{消費ＭＡＧ, 8} / {GET_CHARA_STOCK_MAG(対象)}　　소비 ￥:{消費￥, 8} / {MONEY}
				RESETCOLOR
			ENDIF
			PRINTL
			
			IF GET_CHARA_STOCK_MAG(対象) >= 消費ＭＡＧ:1 && MONEY >= 消費ＭＡＧ:1/10 && 改造装備 != 1
				ボタン = [ +10] 소비 ＭＡＧ:{消費ＭＡＧ:1, 8} / {GET_CHARA_STOCK_MAG(対象)}　　소비 ￥:{消費￥:1, 8} / {MONEY}
				PRINTBUTTON ボタン, 12
			ELSE
				SETCOLOR COLOR("gray")
				PRINTPLAINFORM [ × ] 소비 ＭＡＧ:{消費ＭＡＧ:1, 8} / {GET_CHARA_STOCK_MAG(対象)}　　소비 ￥:{消費￥:1, 8} / {MONEY}
				RESETCOLOR
			ENDIF
			PRINTL
			
			IF 概念強化用ポイント > 消費Ｐ && ((改造装備 != 1) || (改造装備 == 1 && 強化段階 < 2))
				ボタン = [ + 1] 소비 포인트:{消費Ｐ, 8} / {概念強化用ポイント,8}
				PRINTBUTTON ボタン, 13
			ELSE
				SETCOLOR COLOR("gray")
				PRINTPLAINFORM [ × ] 소비 포인트:{消費Ｐ, 8} / {概念強化用ポイント,8}
				RESETCOLOR
			ENDIF
			PRINTL
			
			IF 概念強化用ポイント > 消費Ｐ:1 && 改造装備 != 1
				ボタン = [ +10] 소비 포인트:{消費Ｐ:1, 8} / {概念強化用ポイント,8}
				PRINTBUTTON ボタン, 14
			ELSE
				SETCOLOR COLOR("gray")
				PRINTPLAINFORM [ × ] 소비 포인트:{消費Ｐ:1, 8} / {概念強化用ポイント,8}
				RESETCOLOR
			ENDIF
			PRINTL
			
			IF 強化段階 > 20
				IF ITEM:強化素材1 >= 強化素材個数1 && ((改造装備 != 1) || (改造装備 == 1 && 強化段階 < 2))
					ボタン = [ + 1] 소비 보석  :%強化素材1, 12, RIGHT% × {強化素材個数1, 2, RIGHT} / {ITEM:強化素材1, 2, RIGHT}
					PRINTBUTTON ボタン, 15
				ELSE
					SETCOLOR COLOR("gray")
					PRINTPLAINFORM [ × ] 소비 보석  :%強化素材1, 12, RIGHT% × {強化素材個数1, 2, RIGHT} / {ITEM:強化素材1, 2, RIGHT}
					RESETCOLOR
				ENDIF
				PRINTL
				
				IF ITEM:強化素材10 >= 強化素材個数10 && 改造装備 != 1
					ボタン = [ +10] 소비 보석 1:%強化素材10, 12, RIGHT% × {強化素材個数10, 2, RIGHT} / {ITEM:強化素材10, 2, RIGHT}
					PRINTBUTTON ボタン, 16
				ELSE
					SETCOLOR COLOR("gray")
					PRINTPLAINFORM [ × ] 소비 보석 1:%強化素材10, 12, RIGHT% × {強化素材個数10, 2, RIGHT} / {ITEM:強化素材10, 2, RIGHT}
					RESETCOLOR
				ENDIF
				PRINTL
				IF 強化素材個数10:1 > 0 && 強化段階 < 91
					SIF ITEM:(強化素材10:1) < 強化素材個数10:1
						SETCOLOR COLOR("gray")
					PRINTFORML        소비 보석 2:%強化素材10:1, 12, RIGHT% × {強化素材個数10:1, 2, RIGHT} / {ITEM:(強化素材10:1), 2, RIGHT}
					RESETCOLOR
				ELSE
					PRINTL
				ENDIF
			ELSE
				;ボタン連打していたら解禁された時に列がズレてうっかり別のボタンを押してしまう事があるので空行を入れておく
				PRINTL
				SETCOLOR COLOR("gray")
				PRINTL [ × ] 소비 보석  : Lv21 이상부터 사용 가능
				RESETCOLOR
				PRINTL
			ENDIF
			
			;デバッグ用処理。
		;	IF FLAG:DEBUG
		;		PRINTL
		;		ボタン = [ + 1] デバッグ用処理：強化＋１
		;		PRINTBUTTON ボタン, 90
		;		PRINTL
		;		ボタン = [ +10] デバッグ用処理：強化＋１０
		;		PRINTBUTTON ボタン, 91
		;		PRINTL
		;	ENDIF
		ELSE
			CLEARLINE LINECOUNT - THIRD_LINE
			GOTO START_D
		ENDIF
		DRAWLINE
		PRINT [0]개념 강화로 돌아간다    
		PRINT [1]메뉴로 돌아간다
		INPUT
		INPUT_RESULT = RESULT
		
		SELECTCASE INPUT_RESULT
			CASE 0
				CLEARLINE LINECOUNT - THIRD_LINE
				GOTO START_D
			CASE 1
				CLEARLINE LINECOUNT - FIRST_LINE
				指定 = -1
				GOTO START_B
			CASE 11, 13, 15
				CALL 装備強化_展開, 対象, 装備番号, "強化段階", "NEXT"
				強化値 = RESULT + 1
				;CALL 装備強化_展開, 対象, 0, "強化段階", "保存強化値"
				;強化値 = 5 * (強化段階) * (強化段階+1) * (強化段階+2) / 3 + 1
				SELECTCASE INPUT_RESULT
					CASE 11
						CALL CONTROL_MAG, 対象, -消費ＭＡＧ
						MONEY -= 消費￥
					CASE 13
						概念強化用ポイント -= 消費Ｐ
					CASE 15
						ITEM:強化素材1 -= 強化素材個数1
					CASEELSE
						PRINTW 오류. 예상치 못한 동작이 발생했습니다
				ENDSELECT
			CASE 12, 14, 16
				CALL 装備強化_展開, 対象, 装備番号, "強化段階", "EXP"
				強化値 = 5 * (強化段階+9) * (強化段階+1+9) * (強化段階+2+9) / 3 + 1 - RESULT
				SELECTCASE INPUT_RESULT
					CASE 12
						CALL CONTROL_MAG, 対象, -消費ＭＡＧ:1
						MONEY -= 消費￥:1
					CASE 14
						概念強化用ポイント -= 消費Ｐ:1
					CASE 16
						ITEM:強化素材10 -= 強化素材個数10
						SIF 強化素材個数10:1 > 0
							ITEM:(強化素材10:1) -= 強化素材個数10:1
					CASEELSE
						PRINTW 오류. 예상치 못한 동작이 발생했습니다
				ENDSELECT
			;デバッグ用処理
		;	CASE 90
		;		IF FLAG:DEBUG
		;			CALL 装備強化_展開, 対象, 装備番号, "強化段階", "NEXT"
		;			強化値 = RESULT + 1
		;		ENDIF
		;	;デバッグ用処理
		;	CASE 91
		;		IF FLAG:DEBUG
		;			CALL 装備強化_展開, 対象, 装備番号, "強化段階", "EXP"
		;			強化値 = 5 * (強化段階+9) * (強化段階+1+9) * (強化段階+2+9) / 3 + 1 - RESULT
		;		ENDIF
			CASEELSE
				GOTO PRINT_LIST
		ENDSELECT
		SIF 改造装備(装備番号)
			CALL 装備強化_CSTR, "書き込み", 対象, 装備番号, "記録_改造装備ベース番号", "EXP", 強化値
		CALL 装備強化_CSTR, "書き込み", 対象, 装備番号, "強化段階", "EXP", 強化値
		CALL 装備強化_展開, 対象, 装備番号, "強化段階", "LV"
		IF 強化段階 < 2
			CALL 装備強化_展開, 対象, 装備番号, "強化段階", "NEXT"
			強化値 = RESULT + 1
			CALL 装備強化_CSTR, "書き込み", 対象, 装備番号, "強化段階", "EXP", 強化値
			CALL 装備強化_展開, 対象, 装備番号, "強化段階", "LV"
		ENDIF
