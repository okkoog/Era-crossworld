;---------------------------------------------------------------------------

FOR LCOUNT, 0, GUN_BATTLESTATUSNUM
	CALLFORM 戦闘能力修正_{装備番号}, LCOUNT, -1
	装備比較 = RESULT
	CALLFORM 戦闘能力修正_{装備番号}, LCOUNT, 対象
	装備比較:1 = RESULT
	
	IF 装備比較 != 装備比較:1
		性能変動判定 = 1
		BREAK
	ENDIF
NEXT

FOR LCOUNT,0,EQUIP_BATTLESTATUSNUM
	CALLFORM 戦闘能力修正_{装備番号}, LCOUNT, -1
	基礎能力:LCOUNT = RESULT
	基礎合計値 += RESULT
NEXT
IF 装備部位 == GET_EQUIPNUM("총")
	CALLFORM 銃攻撃_{装備番号}
	基礎能力:6 = RESULT
	CALLFORM 銃命中_{装備番号}
	基礎能力:7 = RESULT
	基礎合計値 += 基礎能力:6 + 基礎能力:7
ENDIF

FOR LCOUNT,0,EQUIP_BATTLESTATUSNUM +2
	CALL 装備強化_展開, 対象, 装備番号, "戦闘能力修正", GET_BATTLESTATUS(LCOUNT),-1, 1
	振り分け後:LCOUNT = RESULT
	振り分け済み += RESULT
NEXT

耐性無 = 0
;防具のみ
IF 装備部位 > 1 && 装備部位 < 6 && 性能変動判定 == 0
	SIF TALENT:対象:페르소나구사자
		耐性無 = 2
	IF 耐性無 < 2
		FOR LCOUNT, 0, TYPENUM
			CALLFORM 防御相性_{装備番号}, LCOUNT, 対象
			IF RESULT != 100
				耐性無 = 2
				BREAK
			ENDIF
		NEXT
	ENDIF
	IF 耐性無 < 2
		RESULT = 0
		FOR LCOUNT, 0, BADSTATENUM
			TRYCALLFORM バステ耐性_{装備番号}, LCOUNT, 対象
			IF RESULT != 0
				耐性無 = 2
				BREAK
			ENDIF
		NEXT
	ENDIF
	SIF 耐性無 == 0
		耐性無 = 1
ENDIF

CALL 装備強化_振り分け制限算出(装備番号, 装備部位, 強化段階)
ポイント = RESULT

SIF 基礎合計値 < 1
	基礎合計値 = 1
	
FOR LCOUNT, 0, EQUIP_BATTLESTATUSNUM +2
	基礎能力割合:LCOUNT = 基礎能力:LCOUNT *100 / 基礎合計値

	CALL 装備強化_振り分け制限算出, 装備番号, 装備部位, 99
	振り分け制限_最大:LCOUNT = RESULT * 基礎能力割合:LCOUNT / 100
	CALL 装備強化_振り分け限界, 99, 装備部位, GET_BATTLESTATUS(LCOUNT), 装備番号
	;割り振る事ができるポイントの最大値。基礎能力と振ったポイントの合計値ではない
	IF 振り分け制限_最大:LCOUNT + 基礎能力:LCOUNT > RESULT
		未配分:LCOUNT = 振り分け制限_最大:LCOUNT
		振り分け制限_最大:LCOUNT = RESULT - 基礎能力:LCOUNT + MIN(20, 振り分け制限_最大:LCOUNT/10)
		IF 振り分け制限_最大:LCOUNT > 0
			未配分:LCOUNT -= 振り分け制限_最大:LCOUNT
		ELSE
			未配分:LCOUNT = 0
		ENDIF
	ENDIF
	
	振り分け制限:LCOUNT = ポイント * 基礎能力割合:LCOUNT / 100
	CALL 装備強化_振り分け限界, 強化段階, 装備部位, GET_BATTLESTATUS(LCOUNT), 装備番号
	;こっちは現段階
	SIF 振り分け制限:LCOUNT + 基礎能力:LCOUNT > RESULT
		振り分け制限:LCOUNT = RESULT - 基礎能力:LCOUNT + MIN(20, 振り分け制限:LCOUNT/10)

;2022/05/01.陳腐化。半年くらい経って不具合が出ない場合に消す---------------------
	;自前の強化があるので魔装術での強化は控えめに
;	IF 性能変動判定 > 0
;		振り分け制限_最大:LCOUNT = 振り分け制限_最大:LCOUNT * 性能変動:LCOUNT / 100
;		振り分け制限:LCOUNT = 振り分け制限:LCOUNT * 性能変動:LCOUNT / 100
;	ENDIF
;--------------------------------------------------------------------------------
	
	;何かしらボーナスがないと耐性のない防具は装備しないだろうと思うので。+20%くらいがちょうど良い
	IF 耐性無 == 1
		振り分け制限_最大:LCOUNT += (基礎能力:LCOUNT + 振り分け制限_最大:LCOUNT) / 5
		振り分け制限:LCOUNT += (基礎能力:LCOUNT + 振り分け制限:LCOUNT) / 5
	ENDIF
	
	;デバッグ用表示
	;PRINTFORML %GET_BATTLESTATUS(LCOUNT), 8, LEFT%:{振り分け制限:LCOUNT}
NEXT

;性能が偏っている場合、対応する戦闘能力の強化にボーナスを付ける
;例えば攻撃に偏っているのであれば命中に、魔法威力に偏っていれば魔法効果にボーナスが付く
;振り分け制限の計算式的に偏った性能の装備が割を食っているので救済措置
;防具は不可。耐性無しや性能がゼロの部分へのボーナスがあるから強化が過剰になる
IF SUMARRAY(未配分, 0) > 0 && 装備部位 < 2
	IF 性能変動判定 > 0
		VARSET 未配分
	ELSE
		FOR LCOUNT, 0, GUN_BATTLESTATUSNUM
			IF 未配分:LCOUNT > 0
				IF LCOUNT % 2 == 0
					対応能力 = LCOUNT + 1
				ELSE
					対応能力 = LCOUNT - 1
				ENDIF
				
				SIF 対応能力 == GET_BATTLESTATUS_NUM("마법효과")
					未配分:LCOUNT = 未配分:LCOUNT * 4 / 7
				CALL 装備強化_振り分け限界, 99, 装備部位, GET_BATTLESTATUS(対応能力), 装備番号
				SIF 振り分け制限_最大:対応能力 + 基礎能力:対応能力 + 未配分:LCOUNT > RESULT + 20
					未配分:LCOUNT = RESULT + 20 - 振り分け制限_最大:対応能力 - 基礎能力:対応能力
				未配分:LCOUNT = 未配分:LCOUNT * (強化段階+1) / 100
				
			ELSE
				未配分:LCOUNT = 0
			ENDIF
		NEXT
		;↑のFOR文内で加算すると正確に計算されないのでここで加算
		FOR LCOUNT, 0, GUN_BATTLESTATUSNUM
			IF 未配分:LCOUNT > 0
				IF LCOUNT % 2 == 0
					対応能力 = LCOUNT + 1
				ELSE
					対応能力 = LCOUNT - 1
				ENDIF
				
				振り分け制限_最大:対応能力 += 未配分:LCOUNT
				振り分け制限:対応能力 += 未配分:LCOUNT
			ENDIF
		NEXT
	ENDIF
ELSE
	VARSET 未配分
ENDIF

振り分け制限合計_最大 = SUMARRAY(振り分け制限_最大, 0)
振り分け制限合計 = SUMARRAY(振り分け制限, 0)
ポイント -= 基礎合計値

;防具の元々の性能がゼロの部分に振り分けられるポイントの上限を設定
IF (ポイント - 振り分け制限合計) > 0 && 装備部位 != GET_EQUIPNUM("검") && 装備部位 != GET_EQUIPNUM("총")
	FOR LCOUNT,0,EQUIP_BATTLESTATUSNUM +2
		IF 基礎能力:LCOUNT == 0 && (LCOUNT >= 2 && LCOUNT <= 5)
			振り分け制限:LCOUNT += (ポイント - 振り分け制限合計) / 4
			振り分け制限合計 += 振り分け制限:LCOUNT
			振り分け制限合計_最大 += 振り分け制限:LCOUNT
		ENDIF
	NEXT
ENDIF

ポイント = 振り分け制限合計 * (50 + (強化段階 + 1) / 2) / 100

;全く強化できないのも寂しいので少しだけ強化できるように
SIF 振り分け制限合計_最大 < 15 && 性能変動判定 == 0
	ポイント = (強化段階 + 1) * 15 / 100

;改造装備は強化不可。鍛冶屋での強化だけで、魔装術での能力強化の上限近くになる為
SIF 改造装備(装備番号)
	ポイント = 0

ポイント -= 振り分け済み

FIRST_LINE = LINECOUNT
REDRAW 0
$S_LOOP

DRAWLINE
IF 改造装備(装備番号)
	PRINTFORM <%改造装備名称(改造装備番号(装備番号))%>
ELSE
	PRINTFORM <%ITEMNAME:装備番号%>
ENDIF
CALL 装備強化_展開, 対象, 装備番号, "強化段階", "保存LV"
IF 強化段階 == RESULT
	PRINTFORM   Lv:{強化段階,5,LEFT}
ELSE
	PRINTFORM   Lv:{強化段階} ({RESULT})
ENDIF
PRINTFORM    강화 가능 횟수:{50 - 強化数}
IF 50 - 強化数 == 0
	SETCOLOR COLOR("yellow")
	PRINT  [한계]
	RESETCOLOR
ENDIF
IF 性能変動判定 == 1
	SETCOLOR COLOR("yellow")
	IF 装備部位 == GET_EQUIPNUM("검") || 装備部位 == GET_EQUIPNUM("총")
		LCOUNT = 4
	ELSE
		LCOUNT = 2
	ENDIF
	PRINTFORM   [강화치 1/{LCOUNT}]
	RESETCOLOR
ENDIF

PRINTL
DRAWLINE
IF 改造装備(装備番号)
	PRINTFORML 강화 불가
ELSE
	PRINTFORML 남은 포인트:{ポイント}
ENDIF
DRAWLINE

選択肢 = 
FOR LCOUNT,0,EQUIP_BATTLESTATUSNUM +2
	IF 基礎能力:LCOUNT || 振り分け制限:LCOUNT
		変化量_Max:LCOUNT = LIMIT(振り分け制限:LCOUNT - 振り分け後:LCOUNT, 1, MAX(ポイント, 1))
		変化量_Min:LCOUNT = MAX(振り分け後:LCOUNT, 1) * -1
		PRINTFORM %GET_BATTLESTATUS(LCOUNT),8,LEFT%:{基礎能力:LCOUNT, 3} + {振り分け後:LCOUNT, 3} = {基礎能力:LCOUNT + 振り分け後:LCOUNT, 3}    
		CALL BUTTON_強化振り分け("[ +1]", 200+(LCOUNT*10), 振り分け後:LCOUNT, ポイント, 1, 振り分け制限:LCOUNT, 対象, 強化数)
		SIF RESULT != -1
			選択肢 += TOSTR( 200+(LCOUNT*10) ) + "/"
		CALL BUTTON_強化振り分け("[ -1]", 201+(LCOUNT*10), 振り分け後:LCOUNT, ポイント, -1, 振り分け制限:LCOUNT)
		SIF RESULT != -1
			選択肢 += TOSTR( 201+(LCOUNT*10) ) + "/"
		CALL BUTTON_強化振り分け("[+10]", 202+(LCOUNT*10), 振り分け後:LCOUNT, ポイント, 10, 振り分け制限:LCOUNT, 対象, 強化数)
		SIF RESULT != -1
			選択肢 += TOSTR( 202+(LCOUNT*10) ) + "/"
		CALL BUTTON_強化振り分け("[-10]", 203+(LCOUNT*10), 振り分け後:LCOUNT, ポイント, -10, 振り分け制限:LCOUNT)
		SIF RESULT != -1
			選択肢 += TOSTR( 203+(LCOUNT*10) ) + "/"
		CALL BUTTON_強化振り分け("[MAX]", 204+(LCOUNT*10), 振り分け後:LCOUNT, ポイント, 変化量_Max:LCOUNT, 振り分け制限:LCOUNT, 対象, 強化数)
		SIF RESULT != -1
			選択肢 += TOSTR( 204+(LCOUNT*10) ) + "/"
		CALL BUTTON_強化振り分け("[MIN]", 205+(LCOUNT*10), 振り分け後:LCOUNT, ポイント, 変化量_Min:LCOUNT, 振り分け制限:LCOUNT)
		SIF RESULT != -1
			選択肢 += TOSTR( 205+(LCOUNT*10) ) + "/"
		IF 振り分け後:LCOUNT >= 振り分け制限:LCOUNT
			SETCOLOR COLOR("AQUA")
			PRINT [한계]
			RESETCOLOR
		ENDIF
		PRINTL
	ENDIF
NEXT

DRAWLINE
PRINTFORML [  0] 결정
	選択肢 += "0/"
PRINTFORML [998] 포인트 다시 분배
	選択肢 += "998/"
PRINTFORML [999] 돌아간다
	選択肢 += "999/"
$INPUT_LOOP_1
;INPUT

	CALL 装備強化_INPUT_LIST,選択肢

IF RESULT == 999
	REDRAW 1
	RETURN 0
ELSEIF RESULT == 0
	REDRAW 1
	FOR LCOUNT,0,EQUIP_BATTLESTATUSNUM +2
		CALL 装備強化_CSTR, "書き込み", 対象, 装備番号, "能力強化", GET_BATTLESTATUS(LCOUNT), 振り分け後:LCOUNT
	NEXT
	CLEARLINE LINECOUNT - FIRST_LINE
	RETURN 0
ELSEIF RESULT == 998
	REDRAW 1
	PRINTFORML 포인트를 다시 분배하시겠습니까?
	CALL INPUT_YN,"네","아니오"
	IF RESULT == 0
		FOR LCOUNT,0,EQUIP_BATTLESTATUSNUM +2
			振り分け後:LCOUNT = 0
			CALL 装備強化_CSTR, "書き込み", 対象, 装備番号, "能力強化", GET_BATTLESTATUS(LCOUNT), 振り分け後:LCOUNT
		NEXT
		RESTART
	ELSEIF RESULT == 1
		CLEARLINE LINECOUNT - FIRST_LINE
		GOTO S_LOOP
	ENDIF
ELSEIF RESULT != -1
	選択能力 = (RESULT - 200) / 10
	選択強化 = (RESULT - 200) % 10
	SELECTCASE 選択強化
		CASE 0
			選択強化 = 1
		CASE 1
			選択強化 = -1
		CASE 2
			選択強化 = 10
		CASE 3
			選択強化 = -10
		CASE 4
			選択強化 = 変化量_Max:選択能力
		CASE 5
			選択強化 = 変化量_Min:選択能力
		CASEELSE
			CLEARLINE LINECOUNT - FIRST_LINE
			GOTO S_LOOP
	ENDSELECT
	IF !INRANGE(選択能力, 0, 8)
		CLEARLINE LINECOUNT - FIRST_LINE
		GOTO S_LOOP
	ENDIF
	SIF 振り分け後:選択能力 == 0
		強化数 += 1
	振り分け後:選択能力 += 選択強化
	SIF 振り分け後:選択能力 == 0
		強化数 -= 1
	ポイント -= 選択強化
ENDIF
CLEARLINE LINECOUNT - FIRST_LINE
GOTO S_LOOP

@装備強化_振り分け限界, ARG, ARG:1, ARGS, ARG:2 = -1
;ARG 強化段階レベル  ARG:1 部位  ARGS 能力
;実際はここで出した限界値にいくらか足した数値が上限になる
#DIM DYNAMIC 限界値
#DIM DYNAMIC 装備部位
#DIMS DYNAMIC 指定能力
#DIM DYNAMIC 装備番号
#DIM DYNAMIC 최저공격횟수
#DIM DYNAMIC 최대공격횟수
#DIM DYNAMIC 攻撃回数合計

限界値 = ARG
装備部位 = ARG:1
指定能力 = %ARGS%
装備番号 = ARG:2

SELECTCASE 装備部位
	CASE GET_EQUIPNUM("검")
		SELECTCASE 指定能力
			CASE "공격"
				TIMES 限界値, 3.5
				SIF 限界値 > 260
					限界値 = 260 + (限界値-260)/6
					
				CALLFORM 最低攻撃回数_{装備番号}
				최저공격횟수 = RESULT
				CALLFORM 最大攻撃回数_{装備番号}
				최대공격횟수 = RESULT
				攻撃回数合計 = 최저공격횟수 + 최대공격횟수
				;攻撃回数合計が奇数の場合でも正確に計算したいので、合計を10倍にして計算する
				SIF 攻撃回数合計 > 2
					限界値 = 限界値 * (攻撃回数合計 * 10 / 2 + 10) / (攻撃回数合計 * 10)
			CASE "명중"
				TIMES 限界値, 3.5
				SIF 限界値 > 250
					限界値 = 250 + (限界値-250)/6
			;	TIMES 限界値, 3.0
			;	SIF 限界値 > 220
			;		限界値 = 220 + (限界値-220)/6
			CASE "마법위력"
				TIMES 限界値, 3.5
				SIF 限界値 > 260
					限界値 = 260 + (限界値-260)/6
			CASE "마법효과"
			;	TIMES 限界値, 3.0
			;	SIF 限界値 > 200
			;		限界値 = 200 + (限界値-200)/6
;				TIMES 限界値, 2.0
;				SIF 限界値 > 140
;					限界値 = 140 + (限界値-140)/4
				限界値 = 限界値 * 7 / 4
				SIF 限界値 > 140
					限界値 = 140 + (限界値-140)/4
			CASEELSE
				TIMES 限界値, 1.0
		ENDSELECT
	CASE GET_EQUIPNUM("총")
		SELECTCASE 指定能力
			CASE "총공격"
				TIMES 限界値, 4.0
				SIF 限界値 > 260
					限界値 = 260 + (限界値-260) / 6
			CASE "총명중"
				TIMES 限界値, 3.5
				SIF 限界値 > 220
					限界値 = 220 + (限界値-220)/6
			CASEELSE
				TIMES 限界値, 0.5
		ENDSELECT
	CASE GET_EQUIPNUM("머리")
		SELECTCASE 指定能力
			CASE "방어"
				TIMES 限界値, 0.8
				SIF 限界値 > 40
					限界値 = 40 + (限界値-40)/4
			CASE "회피"
				TIMES 限界値, 0.5
				SIF 限界値 > 20
					限界値 = 20 + (限界値-20)/4
			CASE "마법효과"
				TIMES 限界値, 0.85
				SIF 限界値 > 55
					限界値 = 55 + (限界値-55)/4
			CASEELSE
				TIMES 限界値, 0.5
		ENDSELECT
	CASE GET_EQUIPNUM("몸통")
		SELECTCASE 指定能力
			CASE "방어"
				TIMES 限界値, 1.7
				SIF 限界値 > 100
					限界値 = 100 + (限界値-100)/6
			CASE "회피"
				TIMES 限界値, 0.9
				SIF 限界値 > 40
					限界値 = 40 + (限界値-40)/6
			CASE "마법효과"
				TIMES 限界値, 0.6
				SIF 限界値 > 40
					限界値 = 40 + (限界値-40)/6
			CASEELSE
				TIMES 限界値, 0.5
		ENDSELECT
	CASE GET_EQUIPNUM("팔")
		SELECTCASE 指定能力
			CASE "방어"
				TIMES 限界値, 0.9
				SIF 限界値 > 55
					限界値 = 55 + (限界値-55)/4
			CASE "회피"
				TIMES 限界値, 0.35
				SIF 限界値 > 20
					限界値 = 20 + (限界値-20)/4
			CASE "마법효과"
				TIMES 限界値, 0.3
				SIF 限界値 > 20
					限界値 = 20 + (限界値-20)/4
			CASEELSE
				TIMES 限界値 , 0.3
		ENDSELECT
	CASE GET_EQUIPNUM("발")
		SELECTCASE 指定能力
			CASE "방어"
				TIMES 限界値, 0.8
				SIF 限界値 > 45
					限界値 = 45 + (限界値-50)/4
			CASE "회피"
				TIMES 限界値, 1.0
				SIF 限界値 > 50
					限界値 = 50 + (限界値-50)/4
			CASE "마법효과"
				TIMES 限界値 , 0.7
				SIF 限界値 > 40
					限界値 = 40 + (限界値-40)/4
			CASEELSE
				TIMES 限界値, 0.5
		ENDSELECT
	CASEELSE
		限界値 = 0
ENDSELECT

RETURN 限界値

@装備強化_耐性強化,ARG,ARG:1
#DIM DYNAMIC FIRST_LINE
#DIM DYNAMIC SECOND_LINE
#DIM DYNAMIC 対象
#DIM DYNAMIC 装備番号
#DIM DYNAMIC 強化段階
#DIM DYNAMIC 耐性合計
#DIM DYNAMIC 弱点合計
#DIM DYNAMIC 現在値
#DIM DYNAMIC 基礎値
#DIM DYNAMIC 強化値
#DIMS DYNAMIC 相性
#DIM DYNAMIC 振り分け制限
#DIM DYNAMIC 選択強化
#DIM DYNAMIC ポイント
#DIM DYNAMIC 振り分け済み
#DIM DYNAMIC 振り分け後
#DIMS DYNAMIC 選択肢
#DIMS DYNAMIC 相性名
#DIM DYNAMIC 強化数 = 0
#DIM DYNAMIC 変化量_Max
#DIM DYNAMIC 変化量_Min
#DIM DYNAMIC LCOUNT,2

VARSET ポイント
VARSET 振り分け後
VARSET 振り分け制限
VARSET 振り分け済み
VARSET 耐性合計
VARSET 弱点合計

対象 = ARG
装備番号 = ARG:1

CALL 装備強化_CSTR, "強化数", 対象
強化数 = RESULT

FOR LCOUNT, 0, TYPENUM - 1
	CALLFORM 防御相性_{装備番号}, LCOUNT, 対象
	SELECTCASE RESULT
		CASE 999
			耐性合計 += 15 
		CASE IS < 0
			耐性合計 += 15 
		CASE 0
			耐性合計 += 10 
		CASE IS > 199
			弱点合計 += 45
		CASE IS > 149
			弱点合計 += 25
		CASE IS > 100
			弱点合計 += 15
		CASE IS <= 50
			耐性合計 += 5 
		CASE IS < 100
			耐性合計 += 3 
	ENDSELECT
NEXT

FIRST_LINE = LINECOUNT
REDRAW 0
	$START_3
	IF (弱点合計 + 耐性合計) == 0
		PRINTW 강화할 수 있는 내성이 없습니다
		RETURN
	ENDIF
	ポイント = (弱点合計 - 耐性合計) * 5 / 5
	CALL 装備強化_展開, 対象, 装備番号, "強化段階", "LV"
	強化段階 = RESULT
	ポイント += 強化段階 / 5 * 5 /2
	SIF 強化段階 == 99
		ポイント += 5

	;改造装備は強化不可。鍛冶屋と併用できるとゲームバランスが崩れそうなので
	SIF 改造装備(装備番号)
		ポイント = 0
		
	DRAWLINE
	;現在相性を表示
	PRINTL □전체 상성
	FOR LCOUNT, 0, TYPENUM - 1
		PRINTFORM %GET_TYPE(LCOUNT)% 
		現在値 = MAXBASE:対象:GET_TYPE(LCOUNT)
		CALL SET_AISYOU_COLOR(現在値)
		PRINTFORM \@ 現在値 < 0 ? 흡 # 　 \@
		PRINTFORM \@ 現在値 != 999 ? {ABS(現在値), 3}％ # %" "%반사 \@　
		PRINTFORM \@ LCOUNT % 6 == 5 ? \n # \@
		RESETCOLOR
	NEXT

	PRINTL
	DRAWLINE
	PRINTFORML □내성 강화  <%ITEMNAME:装備番号%>  (Lv：{強化段階})
	DRAWLINE
	PRINTL 어느 상성을 변경하시겠습니까?
	DRAWLINE
	PRINTFORM 강화 가능 횟수:{50 - 強化数}
	IF 50 - 強化数 == 0
		SETCOLOR COLOR("yellow")
		PRINT  [한계]
		RESETCOLOR
	ENDIF
	PRINTL
	DRAWLINE
	LCOUNT:1 = 0
	選択肢 = 
	FOR LCOUNT, 0, TYPENUM - 1
		CALLFORM 防御相性_{装備番号},LCOUNT,対象
		基礎値 = RESULT
		SIF 基礎値 == 100 ;|| 基礎値 <= 0 || 基礎値 == 999
			CONTINUE
		CALL 装備強化_展開, 対象, 装備番号, "防御相性", GET_TYPE(LCOUNT), RESULT
		ポイント -= 基礎値 - RESULT
		現在値 = RESULT
		IF 基礎値 <= 0 || 基礎値 == 999
			PRINTFORM [XX]%GET_TYPE(LCOUNT)%
		ELSE
			PRINTFORM [{LCOUNT, 2}]%GET_TYPE(LCOUNT)%
			選択肢 += TOSTR(LCOUNT) + "/"
		ENDIF
		相性名 =   
		SIF (RESULT - 基礎値) != 0
			相性名 = ◇
		PRINTFORM %相性名%
		RESETCOLOR
		CALL SET_AISYOU_COLOR(RESULT)
		PRINTFORM \@ 現在値 < 0 ? 흡 #    \@
		PRINTFORM \@ 現在値 != 999 ? {ABS(現在値), 3}％ # %" "%반사 \@  
		PRINTL
		RESETCOLOR
	NEXT
	PRINTL
	PRINTL [998] 포인트 다시 분배
	選択肢 += "998/"
	PRINTL [100] 돌아간다
	選択肢 += "100/"
	$INPUT_LOOP_3
	;INPUT
	CALL 装備強化_INPUT_LIST,選択肢
	IF RESULT == 100
		RETURN
	ELSEIF RESULT == 998
		REDRAW 1
		PRINTFORML 포인트를 다시 분배하시겠습니까?
		CALL INPUT_YN,"네","아니오"
		IF RESULT == 0
			FOR LCOUNT, 0, TYPENUM - 1
				CALLFORM 防御相性_{装備番号}, LCOUNT, 対象
				LCOUNT:1 = RESULT
				SIF LCOUNT:1 == 100 || LCOUNT:1 <= 0 || LCOUNT:1 == 999
					CONTINUE
				CALL 装備強化_展開, 対象, 装備番号, "防御相性", GET_TYPE(LCOUNT), RESULT
				IF (RESULT - LCOUNT:1) != 0
					CALL 装備強化_CSTR, "書き込み", 対象, 装備番号, "耐性強化", GET_TYPE(LCOUNT), 0
				ENDIF
			NEXT
		ENDIF
		CALL SYNC_STATUS,対象
		CLEARLINE LINECOUNT - FIRST_LINE
		GOTO START_3
	ELSEIF RESULT < 0 || RESULT >= TYPENUM-1
		GOTO INPUT_LOOP_3
	ENDIF
		相性 = %GET_TYPE(RESULT)%
		CALLFORM 防御相性_{装備番号},RESULT,対象
		基礎値 = RESULT
		CALL 装備強化_展開, 対象, 装備番号, "防御相性", 相性
		振り分け後 = RESULT
		;SIF 振り分け後 < 997
		;	振り分け後 = -振り分け後
		ポイント = ポイント/5*5
	DRAWLINE
SECOND_LINE = LINECOUNT
REDRAW 0
$START_2
	PRINTFORML %相性%의 방어상성을 어떻게 하시겠습니까?　보정치:{ポイント}
	PRINTL
	PRINTFORM %相性%:{基礎値, 3} - {振り分け後, 3} = 
	CALL SET_AISYOU_COLOR, 基礎値 - 振り分け後
	PRINTFORM {基礎値 - 振り分け後, 3}
	RESETCOLOR
	PRINTFORM     

	IF 基礎値 > 100 && 基礎値 < 999
		振り分け制限 = 基礎値 - 100
		SIF 振り分け制限 < 5
			振り分け制限 = 5
	ELSEIF 基礎値 < 100 && 基礎値 > 0
		振り分け制限 = 基礎値
	ELSE
		振り分け制限 = 0
	ENDIF
	選択肢 = 
	IF 基礎値 > 0 && 基礎値 < 999
		変化量_Max = LIMIT(振り分け制限 - 振り分け後, 5, MAX(ポイント, 5))
		変化量_Min = MAX(振り分け後, 5) * -1
		CALL BUTTON_強化振り分け("[ +5]", 101, 振り分け後, ポイント,   5, 振り分け制限, 対象, 強化数)
		SIF RESULT != -1
			選択肢 += TOSTR(101) + "/"
		CALL BUTTON_強化振り分け("[ -5]", 102, 振り分け後, ポイント,  -5, 振り分け制限)
		SIF RESULT != -1
			選択肢 += TOSTR(102) + "/"
		CALL BUTTON_強化振り分け("[+25]", 103, 振り分け後, ポイント,  25, 振り分け制限, 対象, 強化数)
		SIF RESULT != -1
			選択肢 += TOSTR(103) + "/"
		CALL BUTTON_強化振り分け("[-25]", 104, 振り分け後, ポイント, -25, 振り分け制限)
		SIF RESULT != -1
			選択肢 += TOSTR(104) + "/"
		CALL BUTTON_強化振り分け("[+50]", 105, 振り分け後, ポイント,  50, 振り分け制限, 対象, 強化数)
		SIF RESULT != -1
			選択肢 += TOSTR(105) + "/"
		CALL BUTTON_強化振り分け("[-50]", 106, 振り分け後, ポイント, -50, 振り分け制限)
		SIF RESULT != -1
			選択肢 += TOSTR(106) + "/"
		CALL BUTTON_強化振り分け("[MAX]", 107, 振り分け後, ポイント, 変化量_Max, 振り分け制限, 対象, 強化数)
		SIF RESULT != -1
			選択肢 += TOSTR(107) + "/"
		CALL BUTTON_強化振り分け("[MIN]", 108, 振り分け後, ポイント, 変化量_Min, 振り分け制限)
		SIF RESULT != -1
			選択肢 += TOSTR(108) + "/"
		IF 振り分け後 >= 振り分け制限
			SETCOLOR COLOR("AQUA")
			PRINT [한계]
			RESETCOLOR
		ENDIF
	ENDIF
	PRINTL

DRAWLINE
PRINTFORML [0] 결정
	選択肢 += "0/"
PRINTFORML [999] 돌아간다
	選択肢 += "999/"
$INPUT_LOOP_1
;INPUT

	CALL 装備強化_INPUT_LIST,選択肢

IF RESULT == 999
	CLEARLINE LINECOUNT - FIRST_LINE
	GOTO START_3
ELSEIF RESULT == 0
	REDRAW 1
	CALL 装備強化_CSTR, "書き込み", 対象, 装備番号, "耐性強化", 相性, 振り分け後
	CALL SYNC_STATUS,対象
	CLEARLINE LINECOUNT - FIRST_LINE
	GOTO START_3
ELSEIF INRANGE(RESULT, 101, 108)
	選択強化 = RESULT - 100
	SELECTCASE 選択強化
		CASE 0
			選択強化 = 0
			強化値 = 0
		CASE 1
			選択強化 = 5
			強化値 = 5
		CASE 2
			選択強化 = -5
			強化値 = -5
		CASE 3
			選択強化 = 25
			強化値 = 25
		CASE 4
			選択強化 = -25
			強化値 = -25
		CASE 5
			選択強化 = 50
			強化値 = 50
		CASE 6
			選択強化 = -50
			強化値 = -50
		CASE 7
			選択強化 = 変化量_Max
			強化値 = 変化量_Max
		CASE 8
			選択強化 = 変化量_Min
			強化値 = 変化量_Min
		CASEELSE
			GOTO INPUT_LOOP_3
	ENDSELECT
	SIF 振り分け後 == 0
		強化数 += 1
	振り分け後 += 強化値
	SIF 振り分け後 == 0
		強化数 -= 1
	ポイント -= 選択強化
ENDIF
CLEARLINE LINECOUNT - SECOND_LINE
GOTO START_2


@装備強化_攻撃相性,ARG,ARG:1
#DIM DYNAMIC FIRST_LINE
#DIM DYNAMIC SECOND_LINE
#DIM DYNAMIC 対象
#DIM DYNAMIC 装備番号
#DIM DYNAMIC 基礎値
#DIM DYNAMIC 素材悪魔
#DIMS DYNAMIC 付与相性
#DIM DYNAMIC 付与確率
#DIMS DYNAMIC 装備名
#DIM DYNAMIC 変化強度
#DIMS DYNAMIC スキル番地
#DIM DYNAMIC スキル継承相性
#DIM DYNAMIC SKILL_RANK
#DIM DYNAMIC LCOUNT

対象 = ARG
装備番号 = ARG:1

FIRST_LINE = LINECOUNT
$START_1

PRINTL □공격상성강화    (공격 시 일정 확률로 공격상성을 변화시킨다)
RESULT = 0
TRYCALLFORM 攻撃相性_{装備番号}
PRINTFORM   공격상성 [%GET_TYPE(RESULT),4%]
基礎値 = RESULT
CALL 装備強化_展開, 対象, 装備番号, "공격상성", "付与相性"
IF RESULT > -1
	PRINTFORM   ／  속성 부여 [%GET_TYPE(RESULT),4%]
	CALL 装備強化_展開, 対象, 装備番号, "공격상성", "付与確率"
	PRINTFORM   부여 확률 [{RESULT,2}]　
ENDIF
PRINTL
DRAWLINE

SECOND_LINE = LINECOUNT
$START_2

VARSET 変化強度

;キャラリストを表示・選択
CALL SHOW_CHARA_LIST_装備強化,"공격상성",対象
SIF RESULT == -1
	RETURN -1
素材悪魔 = RESULT
CALL 適正相性_強化用,RESULT
IF 基礎値 == RESULT
	PRINTW 본래의 상성과 동일합니다
	CLEARLINE LINECOUNT - SECOND_LINE
	GOTO START_2
ENDIF
DRAWLINE
PRINTFORML 마정변화:%CALLNAME:素材悪魔%
PRINTL

付与相性 = %GET_TYPE(RESULT)%

FOR LCOUNT, 1, FLAG:스킬수 + 1
	スキル番地 = 스킬{LCOUNT}
	SIF ABL:素材悪魔:スキル番地 == 0
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", ABL:素材悪魔:スキル番地, 素材悪魔
	スキル継承相性 = RESULT
	IF GET_SUCCESSION(スキル継承相性) == "レア"
		CALL GET_SKILL_PROP, "SKILL_EFECT", ABL:素材悪魔:スキル番地, 素材悪魔
		SIF RESULT == 2 || RESULT == 5 || RESULT == 6
			CONTINUE
		CALL GET_SKILL_PROP, "SKILL_TYPE", ABL:素材悪魔:スキル番地, 素材悪魔
		スキル継承相性 = GET_SUCCESSION_NUM(GET_TYPE(RESULT))
		SIF RESULT == -1
			CONTINUE
	ENDIF
	SIF GET_SUCCESSION(スキル継承相性) != 付与相性
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_RANK", ABL:素材悪魔:スキル番地, 素材悪魔
	SELECTCASE RESULT
		CASE IS >= 10
			変化強度 += 3
		CASE IS >= 5
			変化強度 += 2
		CASEELSE
			変化強度 += 1
	ENDSELECT
	SKILL_RANK = MIN(RESULT / 5 + 1, 3)
	CALL GET_SKILL_PROP, "SKILL_NAME", ABL:素材悪魔:スキル番地
	SETCOLOR COLOR("yellow")
	PRINTFORM %"★"*SKILL_RANK, 6, LEFT%
	RESETCOLOR
	PRINTFORML :%RESULTS%
NEXT

付与確率 = 5
FOR LCOUNT, 0, 変化強度
	SELECTCASE LCOUNT
		CASE 0 TO 1
			付与確率 += 15
		CASE 2 TO 6
			付与確率 += 10
		CASE 7 TO 9
			付与確率 += 5
		CASEELSE
	ENDSELECT
NEXT

PRINTL
PRINTFORM 변화 강도:
SETCOLOR COLOR("yellow")
PRINTFORM %"★" * MIN(変化強度, 10)%
RESETCOLOR

IF 変化強度 >= 10
	SETCOLOR COLOR("yellow")
	PRINT (MAX)
	RESETCOLOR
ELSE
	PRINTFORM ({変化強度})
ENDIF

PRINTL
DRAWLINE

IF 改造装備(装備番号)
	装備名 = %改造装備名称(改造装備番号(装備番号))%
ELSE
	装備名 = %ITEMNAME:装備番号%
ENDIF

PRINTFORML %装備名%에 [%付与相性%] 속성({付与確率, 3}%)을 부여하시겠습니까?
CALL INPUT_YN,"Yes","No",2
	IF RESULT == 1
		PRINTL
		CLEARLINE LINECOUNT - SECOND_LINE
		GOTO START_2
	ENDIF
CALL 装備強化_CSTR, "書き込み", 対象, 装備番号, "공격상성", 付与相性, 付与確率
CALL SYNC_STATUS,対象

PRINTFORMW %装備名%에 %CALLNAME:素材悪魔%이(가) 융합했다!

CALL FUSION_LETTER,素材悪魔,1
;合体素材の悪魔を消去
CALL キャラ削除, 素材悪魔
	RETURN -1


