	PRINTL 의 강화 상태를 전부 해제합니다
ELSEIF 解除モード == 2
	PRINTL 의 일부 강화를 해제합니다
ENDIF
CALL INPUT_YN,"네","아니오"
IF RESULT == 1
	CLEARLINE LINECOUNT - FIRST_LINE
	GOTO START_B
ENDIF

IF 改造装備(装備番号)
	PRINTFORM %改造装備名称(改造装備番号(装備番号))%
ELSE
	PRINTFORM %ITEMNAME:装備番号%
ENDIF
IF 解除モード == 1
	PRINTL 의 모든 강화를 해제
	CALL 装備強化_CSTR, "해제", 対象, 装備番号
ELSEIF 解除モード == 2
	PRINTL 의 일부 강화를 해제
	CALL 装備強化_CSTR, "解除：能力のみ", 対象, 装備番号
ENDIF
