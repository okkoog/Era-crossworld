PRINTL [ 2] 능력강화・내성강화만 해제
PRINTL [99] 그만둔다
DO
	INPUT
	SELECTCASE RESULT
		CASE 99
			RETURN -1
		CASE 1, 2
			CLEARLINE LINECOUNT - FIRST_LINE
			解除モード = RESULT
			BREAK
	ENDSELECT
LOOP 1

$START_B
IF 解除モード == 1
	PRINT 강화를 전부
ELSEIF 解除モード == 2
	PRINT 일부 강화를
ENDIF
PRINTL 해제할 장비를 선택해주세요
DRAWLINE
PRINTFORML %CALLNAME:対象%
PRINTL □장비 강화 상태
PRINTL ▼장비 중
RESULTS = 
CALL 装備強化_CSTR, "表示", 対象,0,"選択"
LOCALS = %RESULTS%
PRINTL ▼미장비
RESULTS = 
CALL 装備強化_CSTR, "表示：不装備", 対象,0,"選択"
LOCALS += RESULTS
PRINTL
PRINTL [9999] 그만둔다
LOCALS += "9999/"
;INPUT
CALL 装備強化_INPUT_LIST,LOCALS
SIF RESULT == 9999
	RETURN -1
LOCAL = RESULT
SIF RESULT == -1
	RETURN -1
	
装備番号 = LOCAL
	
IF 改造装備(装備番号)
	PRINTFORM %改造装備名称(改造装備番号(装備番号))%
ELSE
	PRINTFORM %ITEMNAME:装備番号%
ENDIF
