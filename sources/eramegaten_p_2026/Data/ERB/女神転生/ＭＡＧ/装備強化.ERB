;-------------------------------------------------
;   適正相性
;-------------------------------------------------
;  ARG:0 対象者　ARGS:0 指定
;1.所持しているスキルを見る
;2.習得スキルを見る。ただし一度習得したスキルは見ない（習得の際に0が入るようになっている）
;3.これまで見たスキルの相性と相性素質が同じならば適正相性フラグオン
;4.３の中で一番スキルのランクが高い相性を返す。
;  適正相性がない場合は所持しているスキルと習得スキルの中で一番ランクが高いスキルの相性を返す
;-------------------------------------------------
@適正相性_強化用,ARG,ARGS = ""
#DIM DYNAMIC 対象
#DIMS DYNAMIC 指定
#DIM DYNAMIC 所持相性,18
#DIM DYNAMIC 適正相性,18
#DIM DYNAMIC スキル相性
#DIM DYNAMIC 最高ランク,18
#DIM DYNAMIC LCOUNT, 4
対象 = ARG
指定 = %ARGS%
	VARSET 所持相性
	VARSET 適正相性
	VARSET 最高ランク
;	VARSET LOCAL
;	VARSET RESULT

;	DRAWLINE
	;所持スキル
	FOR LCOUNT, 1, FLAG:스킬수 + 1
		LOCALS = 스킬{LCOUNT}
		SIF ABL:対象:LOCALS == 0
			CONTINUE
		CALL GET_SKILL_PROP, "SKILL_ACTIONABLE_BATTLE", ABL:対象:LOCALS,対象
		SIF !RESULT
			CONTINUE
		CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", ABL:対象:LOCALS, 対象
		SIF RESULT == 4 || RESULT == 5 || RESULT == 6 || RESULT == 20 || RESULT == 22
			CONTINUE
		CALL GET_SKILL_PROP, "SKILL_TYPE", ABL:対象:LOCALS, 対象
		SIF RESULT < 0
			CONTINUE
		スキル相性 = RESULT
		所持相性:スキル相性 += 1
		CALL GET_SKILL_PROP, "SKILL_RANK", ABL:対象:LOCALS, 対象
		SIF 最高ランク:スキル相性 < RESULT
			最高ランク:スキル相性 = RESULT
	NEXT
;	PRINTL
	IF 指定 != "所持限定"
		;습득스킬
		FOR LCOUNT,1,21
			LOCALS = 습득스킬{LCOUNT}
			SIF ABL:対象:LOCALS == 0
				BREAK
			CALL GET_SKILL_PROP, "SKILL_ACTIONABLE_BATTLE", ABL:対象:LOCALS,対象
			SIF !RESULT
				CONTINUE
			CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", ABL:対象:LOCALS, 対象
			SIF RESULT == 4 || RESULT == 5 || RESULT == 6 || RESULT == 22
				CONTINUE
			CALL GET_SKILL_PROP, "SKILL_TYPE", ABL:対象:LOCALS, 対象
			SIF RESULT < 0
				CONTINUE
			スキル相性 = RESULT
			所持相性:スキル相性 += 1
			CALL GET_SKILL_PROP, "SKILL_RANK", ABL:対象:LOCALS, 対象
			SIF 最高ランク:スキル相性 < RESULT
				最高ランク:スキル相性 = RESULT
	;		SIF LCOUNT % 4 == 0
	;			PRINTL
		NEXT
	ENDIF
	IF CFLAG:対象:초기링크악마
		;初期スキル
		FOR LCOUNT, 1, FLAG:스킬수 + 1
			LOCALS = 초기변신악마스킬{LCOUNT}
			SIF ABL:対象:LOCALS == 0
				CONTINUE
			CALL GET_SKILL_PROP, "SKILL_ACTIONABLE_BATTLE", ABL:対象:LOCALS,対象
			SIF !RESULT
				CONTINUE
			CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", ABL:対象:LOCALS, 
			CALL GET_SKILL_PROP, "SKILL_TYPE", ABL:対象:LOCALS, 対象
			SIF RESULT < 0
				CONTINUE
			スキル相性 = RESULT
			所持相性:スキル相性 += 1
			CALL GET_SKILL_PROP, "SKILL_RANK", ABL:対象:LOCALS, 対象
			SIF 最高ランク:スキル相性 < RESULT
				最高ランク:スキル相性 = RESULT
		NEXT
		PRINTL
		IF 指定 != "所持スキル"
			;습득스킬
			FOR LCOUNT,1,21
				LOCALS = 초기변신악마습득스킬{LCOUNT}
	;			LOCALS:1 = 습득LV{LCOUNT}
	;			SIF BASE:LCOUNT:LV >= 초기변신악마습득LV{LCOUNT}
	;				CONTINUE
				SIF ABL:対象:LOCALS == 0
					BREAK
				CALL GET_SKILL_PROP, "SKILL_ACTIONABLE_BATTLE", ABL:対象:LOCALS,対象		
				SIF !RESULT
					CONTINUE
				CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", ABL:対象:LOCALS, 対象
				SIF RESULT == 4 || RESULT == 5 || RESULT == 6 || RESULT == 22
					CONTINUE
				CALL GET_SKILL_PROP, "SKILL_TYPE", ABL:対象:LOCALS, 対象
				SIF RESULT < 0
					CONTINUE
				スキル相性 = RESULT
				所持相性:スキル相性 += 1
				CALL GET_SKILL_PROP, "SKILL_RANK", ABL:対象:LOCALS, 対象
				SIF 最高ランク:スキル相性 < RESULT
					最高ランク:スキル相性 = RESULT
				SIF LCOUNT % 4 == 0
					PRINTL
			NEXT
		ENDIF
	ENDIF
;	PRINTW 
;	DRAWLINE

;	PRINTFORML □所持相性
	FOR LCOUNT, 0, TYPENUM - 1
		IF 所持相性:LCOUNT > 0
;			PRINTFORM %GET_TYPE(LCOUNT)% 
;			PRINTFORM = {所持相性:LCOUNT} 
			IF TALENT:対象:GET_TYPE(LCOUNT) 
;				PRINTFORM 適正　
				適正相性:LCOUNT = 1
			ELSE
;				PRINTFORM 　　　
			ENDIF
;			PRINTFORM \@ LCOUNT % 6 == 5 ? \n # \@
		ENDIF
	NEXT
;	PRINTW 
;	DRAWLINE

IF SUMARRAY(適正相性, 0, 18) == 1
	FOR LCOUNT, 0, TYPENUM - 1
		IF 適正相性:LCOUNT > 0
			VARSET 適正相性
			適正相性 = LCOUNT
			BREAK
		ENDIF
	NEXT
ELSEIF SUMARRAY(適正相性, 0, 18)
	FOR LCOUNT, 0, TYPENUM - 1
		IF 適正相性:LCOUNT > 0
			IF LCOUNT:3 == 最高ランク:LCOUNT
				SIF LCOUNT:2 > 所持相性:LCOUNT
					CONTINUE
			ENDIF
			IF 最高ランク:LCOUNT >= LCOUNT:3
				LCOUNT:1 = LCOUNT
				LCOUNT:2 = 所持相性:LCOUNT
				LCOUNT:3 = 最高ランク:LCOUNT 
			ENDIF
		ENDIF
	NEXT
	VARSET 適正相性
	適正相性 = LCOUNT:1
ELSE
	FOR LCOUNT, 0, TYPENUM - 1
		IF 所持相性:LCOUNT > 0
			IF LCOUNT:2 == 所持相性:LCOUNT
				SIF LCOUNT:3 > 最高ランク:LCOUNT
					CONTINUE
			ENDIF
			IF 所持相性:LCOUNT >= LCOUNT:2
				LCOUNT:1 = LCOUNT
				LCOUNT:2 = 所持相性:LCOUNT
				LCOUNT:3 = 最高ランク:LCOUNT 
			ENDIF
		ENDIF
	NEXT
	VARSET 適正相性
	適正相性 = LCOUNT:1
ENDIF
RETURN 適正相性

;-------------------------------------------------
;   所持ステータス追加効果
;-------------------------------------------------
;  ARG:0 対象者　ARGS:0 指定
;-------------------------------------------------
@所持スキル追加効果_強化用,ARG
#DIM DYNAMIC 対象
#DIMS DYNAMIC 指定
#DIM DYNAMIC 所持ステート,21
#DIM DYNAMIC 適正ステート
#DIM DYNAMIC 最高ランク,21
#DIM DYNAMIC 追加効果ステータス
#DIM DYNAMIC LCOUNT,4

対象 = ARG
VARSET 所持ステート
VARSET 適正ステート
VARSET 最高ランク

;所持スキル
FOR LCOUNT, 1, FLAG:스킬수 + 1
	LOCALS = 스킬{LCOUNT}
	SIF ABL:対象:LOCALS == 0
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_STATE", ABL:対象:LOCALS, 対象
	追加効果ステータス = RESULT
	SIF GET_STATE(追加効果ステータス) == "GOOD" || GET_STATE(追加効果ステータス) == "BOMB" || GET_STATE(追加効果ステータス) == "STONE" || GET_STATE(追加効果ステータス) == "DYING" || GET_STATE(追加効果ステータス) == "FLY"
		CONTINUE
	所持ステート:(追加効果ステータス) += 1
	CALL GET_SKILL_PROP, "SKILL_RANK", ABL:対象:LOCALS, 対象
	SIF 最高ランク:(追加効果ステータス) < RESULT
		最高ランク:(追加効果ステータス) = RESULT
NEXT
IF CFLAG:対象:초기링크악마
	;所持スキル
	FOR LCOUNT,1,12
		LOCALS = 초기변신악마스킬{LCOUNT}
		SIF ABL:対象:LOCALS == 0
			CONTINUE
		CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_STATE", ABL:対象:LOCALS, 対象
		追加効果ステータス = RESULT
		SIF GET_STATE(追加効果ステータス) == "GOOD" || GET_STATE(追加効果ステータス) == "BOMB" || GET_STATE(追加効果ステータス) == "STONE" || GET_STATE(追加効果ステータス) == "DYING" || GET_STATE(追加効果ステータス) == "FLY"
				CONTINUE
		所持ステート:追加効果ステータス += 1
		CALL GET_SKILL_PROP, "SKILL_RANK", ABL:対象:LOCALS, 対象
		SIF 最高ランク:(追加効果ステータス) < RESULT
			最高ランク:(追加効果ステータス) = RESULT
	NEXT
	PRINTL
ENDIF

IF SUMARRAY(所持ステート, 1, (BADSTATENUM)) == 1
	FOR LCOUNT, 1, BADSTATENUM
		IF 所持ステート:LCOUNT > 0
			VARSET 適正ステート
			適正ステート = LCOUNT
			BREAK
		ENDIF
	NEXT
ELSEIF SUMARRAY(所持ステート, 1, (BADSTATENUM)) > 0
	FOR LCOUNT, 1, BADSTATENUM
		IF 所持ステート:LCOUNT > 0
			IF LCOUNT:3 == 最高ランク:LCOUNT
				SIF LCOUNT:2 > 所持ステート:LCOUNT
					CONTINUE
			ENDIF
			IF 最高ランク:LCOUNT >= LCOUNT:3
				LCOUNT:1 = LCOUNT
				LCOUNT:2 = 所持ステート:LCOUNT
				LCOUNT:3 = 最高ランク:LCOUNT 
			ENDIF
		ENDIF
	NEXT
	VARSET 適正ステート
	適正ステート = LCOUNT:1
ELSE
	VARSET 適正ステート
	適正ステート = 0
ENDIF
RETURN 適正ステート

;====================================================
;장비강화
;====================================================
@装備強化_CSTR, ARGS, ARG, ARG:1, ARGS:1, ARGS:2, ARG:2 = -1
;ARG キャラ番号　ARG:1 装備番号　ARGS:1 分類　ARGS:2 指定　ARG:2 強化値
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC MEMO, 10
#DIMS DYNAMIC MEMOS, 11

#DIMS DYNAMIC 強化展開, 10
#DIMS DYNAMIC 装備番号
#DIMS DYNAMIC 分類
#DIMS DYNAMIC 指定
#DIM DYNAMIC 強化値
#DIMS DYNAMIC 選択肢

#DIMS DYNAMIC 記録_改造装備ベース
#DIMS DYNAMIC 対象_改造装備ベース
#DIM DYNAMIC 記録_改造装備ベース_番号
#DIM DYNAMIC 対象_改造装備ベース_番号
#DIM DYNAMIC 能力強化値
#DIM DYNAMIC ポイント

SIF ARG < 0
	RETURN
IF !FLAG:마정장비해금
	SIF ARGS != "全解除：能力のみ"
		RETURN
ENDIF

SELECTCASE ARGS
	CASE "強化数"
		SIF CSTR:ARG:장비강화 == ""
			RETURN 
		VARSET LOCALS
		;記録の分解
		SPLIT CSTR:ARG:장비강화, "/", LOCALS
		MEMO:9 = 0
		;記録は100まで
		FOR LCOUNT, 0, 100
			SIF LOCALS:LCOUNT == ""
				BREAK
			MEMO:9 += 1
		NEXT
		RETURN MEMO:9
	CASE "削除"
		SIF CSTR:ARG:장비강화 == ""
			RETURN
		VARSET LOCALS
		;分解
		SPLIT CSTR:ARG:장비강화, "/", LOCALS

		;指定記録
		IF MEMOS == ""
			MEMOS = %TOSTR(ARG:1)%
			MEMOS:1 = %ARGS:1%
		ENDIF
		MEMOS:9 = 

		;100まで
		FOR LCOUNT, 0, 100
			SIF LOCALS:LCOUNT == ""
				BREAK
			VARSET 強化展開
			SPLIT LOCALS:LCOUNT, ":", 強化展開
			装備番号 = %強化展開:0%
			;指定と同じものを
			IF MEMOS == 装備番号
				CONTINUE
			ELSE
				MEMOS:9 = %MEMOS:9%%LOCALS:LCOUNT%/
			ENDIF
		NEXT

		CSTR:ARG:장비강화 = %MEMOS:9%
	CASE "해제"
		SIF CSTR:ARG:장비강화 == ""
			RETURN
		VARSET LOCALS
		VARSET ポイント
		;分解
		SPLIT CSTR:ARG:장비강화, "/", LOCALS

		;指定記録
		IF MEMOS == ""
				MEMOS = %TOSTR(ARG:1)%
				MEMOS:1 = %ARGS:1%
		;		MEMOS:2 = %ARGS:2%
		;		MEMOS:3 = %TOSTR(ARG:2)%
		ENDIF
		MEMOS:9 = 

		;100まで
		FOR LCOUNT, 0, 100
			SIF LOCALS:LCOUNT == ""
				BREAK
			VARSET 強化展開
			SPLIT LOCALS:LCOUNT, ":", 強化展開
			装備番号 = %強化展開:0%
		;	分類 = %強化展開:1%
		;	指定 = %強化展開:2%
		;	強化値 = TOINT(強化展開:3)

			;指定と同じものを
			IF MEMOS == 装備番号
				IF ポイント == 0
					CALL 装備強化_展開, ARG, TOINT(装備番号), "強化段階", "LV"
					FOR LCOUNT:1, 1, RESULT
						ポイント += MAX(1, 2 * (LCOUNT:1 - 1) * LCOUNT:1 * (LCOUNT:1 + 1) * 2) + 1000
					NEXT
					;(強化に使った金銭+10%)/4
					;+10%はＭＡＧの分
					ポイント = ポイント / 9 * 11 / 100 / 4
					CALLFORM 装備箇所_{TOINT(装備番号)}
					SELECTCASE RESULT
						CASE GET_EQUIPNUM("머리")
							ポイント /= 2
						CASE GET_EQUIPNUM("팔"), GET_EQUIPNUM("발")
							ポイント /= 3
						CASEELSE
					ENDSELECT
					PRINTFORMW 이로써 개념강화에 사용할 수 있는 포인트를 {ポイント} 입수했습니다
					概念強化用ポイント += ポイント
				ENDIF
				CONTINUE
			ELSE
				MEMOS:9 = %MEMOS:9%%LOCALS:LCOUNT%/
			ENDIF
		NEXT

		CSTR:ARG:장비강화 = %MEMOS:9%
		;PRINTFORML 장비강화 = %CSTR:ARG:장비강화%
		
	CASE "全解除：能力のみ"
		SIF CSTR:ARG:장비강화 == ""
			RETURN
		VARSET LOCALS
		;分解
		SPLIT CSTR:ARG:장비강화, "/", LOCALS

		;指定記録
		IF MEMOS == ""
				MEMOS = %TOSTR(ARG:1)%
				MEMOS:1 = %ARGS:1%
		;		MEMOS:2 = %ARGS:2%
		;		MEMOS:3 = %TOSTR(ARG:2)%
		ENDIF
		MEMOS:9 = 

		;100まで
		FOR LCOUNT, 0, 100
			SIF LOCALS:LCOUNT == ""
				BREAK
			VARSET 強化展開
			SPLIT LOCALS:LCOUNT, ":", 強化展開
			装備番号 = %強化展開:0%
			分類 = %強化展開:1%
		;	指定 = %強化展開:2%
		;	強化値 = TOINT(強化展開:3)

			;指定
			IF (分類 == "能力強化" || 分類 == "耐性強化")
				CONTINUE
			ELSE
				MEMOS:9 = %MEMOS:9%%LOCALS:LCOUNT%/
			ENDIF
		NEXT

		CSTR:ARG:장비강화 = %MEMOS:9%
		;PRINTFORML 장비강화 = %CSTR:ARG:장비강화%
	
	CASE "解除：能力のみ"
		SIF CSTR:ARG:장비강화 == ""
			RETURN
		VARSET LOCALS
		;分解
		SPLIT CSTR:ARG:장비강화, "/", LOCALS

		;指定記録
		IF MEMOS == ""
				MEMOS = %TOSTR(ARG:1)%
				MEMOS:1 = %ARGS:1%
		;		MEMOS:2 = %ARGS:2%
		;		MEMOS:3 = %TOSTR(ARG:2)%
		ENDIF
		MEMOS:9 = 

		;100まで
		FOR LCOUNT, 0, 100
			SIF LOCALS:LCOUNT == ""
				BREAK
			VARSET 強化展開
			SPLIT LOCALS:LCOUNT, ":", 強化展開
			装備番号 = %強化展開:0%
			分類 = %強化展開:1%
		;	指定 = %強化展開:2%
		;	強化値 = TOINT(強化展開:3)

			;指定
			IF MEMOS == 装備番号 && (分類 == "能力強化" || 分類 == "耐性強化")
				CONTINUE
			ELSE
				MEMOS:9 = %MEMOS:9%%LOCALS:LCOUNT%/
			ENDIF
		NEXT

		CSTR:ARG:장비강화 = %MEMOS:9%
		;PRINTFORML 장비강화 = %CSTR:ARG:장비강화%

	CASE "書き込み"
		SIF ARG:2 == -1
			RETURN
		VARSET LOCALS
		;分解
		SPLIT CSTR:ARG:장비강화, "/", LOCALS
		;指定記録
		IF MEMOS == ""
				MEMOS = %TOSTR(ARG:1)%
				MEMOS:1 = %ARGS:1%
				MEMOS:2 = %ARGS:2%
				MEMOS:3 = %TOSTR(ARG:2)%
				SIF 改造装備(ARG:1)
					MEMOS:10 = %TOSTR(ベース装備番号:(改造装備番号(ARG:1)))%
		ENDIF
		MEMOS:9 = 
		記録_改造装備ベース = 

		;100まで
		FOR LCOUNT, 0, 100
			SIF LOCALS:LCOUNT == ""
				BREAK
			VARSET 強化展開
			SPLIT LOCALS:LCOUNT, ":", 強化展開
			装備番号 = %強化展開:0%
			分類 = %強化展開:1%
			指定 = %強化展開:2%
			SIF MEMOS:1 == "공격상성" || MEMOS:1 == "추가효과"
				指定 = %MEMOS:2%
			強化値 = TOINT(強化展開:3)
			SIF 改造装備(ARG:1)
				記録_改造装備ベース = %強化展開:4%

			;指定と同じものを
			;装備番号:分類:指定:強化値 となっている
			IF MEMOS != "" && MEMOS == 装備番号 && MEMOS:1 == 分類 && MEMOS:2 == 指定
				MEMO = ARG:2
				SIF 分類 == "強化段階" && ARG:2 != 0
					MEMO = 強化値 + ARG:2
				IF MEMO == 0 
					;MEMOS初期化
					MEMOS = 
					CONTINUE
				ENDIF
				;改造装備は装備番号が同じでもベース装備が違う事があるので
				IF MEMOS:10 != "" && MEMOS:10 == 記録_改造装備ベース
					LOCALS:LCOUNT = %MEMOS%:%MEMOS:1%:%MEMOS:2%:%TOSTR(MEMO)%:%MEMOS:10%
				ELSE
					LOCALS:LCOUNT = %MEMOS%:%MEMOS:1%:%MEMOS:2%:%TOSTR(MEMO)%
				ENDIF
				;MEMOSは初期化
				MEMOS = 
				;記録する文字列を再構築
				MEMOS:9 = %LOCALS:LCOUNT%/%MEMOS:9%
			ELSE
				MEMOS:9 = %MEMOS:9%%LOCALS:LCOUNT%/
			ENDIF
		NEXT

		;初ならMEMOSは入っている
		IF 改造装備(ARG:1) && MEMOS != "" && !(ARG:2 == 0)
			MEMOS:9 = %MEMOS%:%MEMOS:1%:%MEMOS:2%:%TOSTR(ARG:2)%:%MEMOS:10%/%MEMOS:9%
		ELSEIF MEMOS != "" && !(ARG:2 == 0)
			MEMOS:9 = %MEMOS%:%MEMOS:1%:%MEMOS:2%:%TOSTR(ARG:2)%/%MEMOS:9%
		ENDIF

		CSTR:ARG:장비강화 = %MEMOS:9%
		;PRINTFORML 장비강화 = %CSTR:ARG:장비강화%

	CASE "表示"
		SIF CSTR:ARG:장비강화 == ""
			RETURN
		FOR LOCAL:1 , 0 , 7
			RESULT = -1
			;いちおう装備でないものを落とす
			TRYCALLFORM 装備箇所_{EQUIP:ARG:GET_EQUIP(LOCAL:1)}
			SIF RESULT < 0
				BREAK
			;SIF EQUIP:ARG:GET_EQUIP(LOCAL:1) < 2000
			;	CONTINUE
			CALL 装備強化_展開, ARG, EQUIP:ARG:GET_EQUIP(LOCAL:1), "強化段階", "LV"
			強化値 = RESULT
			IF 強化値 > 1
				IF 改造装備(EQUIP:ARG:GET_EQUIP(LOCAL:1))
					CALL 装備強化_展開, ARG, EQUIP:ARG:GET_EQUIP(LOCAL:1), "記録_改造装備ベース番号", ""
					対象_改造装備ベース_番号 = ベース装備番号:(改造装備番号(EQUIP:ARG:GET_EQUIP(LOCAL:1)))
					LOCALS = ◇%改造装備名称(改造装備番号(EQUIP:ARG:GET_EQUIP(LOCAL:1))), 16, LEFT%
					SIF RESULT > 0 && 対象_改造装備ベース_番号 != RESULT
						LOCALS += "(強化不可)"
				ELSE
					LOCALS = ◇%ITEMNAME:(EQUIP:ARG:GET_EQUIP(LOCAL:1)),16,LEFT%
				ENDIF
				IF ARGS:1 == "選択"
				;	PRINTBUTTON LOCALS, EQUIP:ARG:GET_EQUIP(LOCAL:1)
					PRINTFORM [{EQUIP:ARG:GET_EQUIP(LOCAL:1)}]
					PRINTFORM   %LOCALS%
					PRINTFORML   Lv:{強化値}
					選択肢 += TOSTR(EQUIP:ARG:GET_EQUIP(LOCAL:1)) + "/"
				ELSE
				;	PRINTFORML ◇%ITEMNAME:(EQUIP:ARG:GET_EQUIP(LOCAL:1)),16,LEFT%　Lv:{強化値}
					PRINTFORML   %LOCALS%  Lv:{強化値}
				ENDIF
			ENDIF
			MEMO = 0
			MEMO:1 = 0
			MEMO:2 = 0
			MEMO:3 = 0

			CALL 装備強化_展開, ARG, EQUIP:ARG:GET_EQUIP(LOCAL:1), "공격상성", "付与相性"
			IF RESULT > -1
				SIF ARGS:1 == "選択"
					PRINT         
				PRINT   <공격상성>      
				PRINTFORM   속성 부여  %GET_TYPE(RESULT),4%    
				CALL 装備強化_展開, ARG, EQUIP:ARG:GET_EQUIP(LOCAL:1), "공격상성", "付与確率"
				PRINTFORM 부여 확률  {RESULT,2}%  
				PRINTL
			ENDIF
			CALL 装備強化_展開, ARG, EQUIP:ARG:GET_EQUIP(LOCAL:1), "추가효과", "상태이상"
			IF GET_STATE(RESULT) != "GOOD"
				SIF ARGS:1 == "選択"
					PRINT         
				PRINT   <추가효과>      
				PRINTFORM   %GET_STATE(RESULT),16,LEFT%  
				CALL 装備強化_展開, ARG, EQUIP:ARG:GET_EQUIP(LOCAL:1), "추가효과", "基本命中"
				PRINTFORM 부여 확률  {RESULT,2}%  
				PRINTL
			ENDIF

			FOR LOCAL,0,EQUIP_BATTLESTATUSNUM +2
				CALL 装備強化_展開, ARG, EQUIP:ARG:GET_EQUIP(LOCAL:1), "戦闘能力修正", GET_BATTLESTATUS(LOCAL)
				IF RESULT != 0
					IF MEMO:1 == 0
						SIF ARGS:1 == "選択"
							PRINT         
						PRINT   <능력강화>      
						MEMO:1 = 1
					ENDIF
					PRINTFORM   %GET_BATTLESTATUS(LOCAL),4,LEFT%  
					SIF RESULT < 0
						SETCOLOR 0xEE1010
					PRINTFORM {RESULT,4}  
					RESETCOLOR
				ENDIF
			NEXT
			SIF MEMO:1 != 0
				PRINTL
			FOR LOCAL,0,TYPENUM
				;SIF (TALENT:ARG:페르소나구사자 || ABL:ARG:종족 == 36)
				;	SETCOLOR COLOR("gray")
				CALL 装備強化_展開, ARG, EQUIP:ARG:GET_EQUIP(LOCAL:1), "防御相性", GET_TYPE(LOCAL)
				IF RESULT != 0
					IF MEMO:2 == 0
						SIF ARGS:1 == "選択"
							PRINT         
						PRINT   <내성강화>      
						MEMO:2 = 1
					ENDIF
					PRINTFORM   %GET_TYPE(LOCAL),4,LEFT%
					SETCOLOR COLOR("LIGHT-GRAY")
					IF RESULT == 999
						PRINT   반사  
					ELSE
						PRINTFORM  %\@(RESULT < 0) ? 吸 #   \@%{ABS(RESULT),3}  
					ENDIF
					RESETCOLOR
				ENDIF
			NEXT
			SIF MEMO:2 != 0
				PRINTL
		NEXT
		SIF ARGS:1 == "選択"
			RESULTS = %選択肢%

	CASE "表示：不装備"
		SIF CSTR:ARG:장비강화 == ""
			RETURN
		VARSET LOCALS
		;分解
		SPLIT CSTR:ARG:장비강화, "/", LOCALS
		MEMOS:9 = 
		;100まで
		FOR LCOUNT, 0, 100
			SIF LOCALS:LCOUNT == ""
				BREAK
			VARSET 強化展開
			SPLIT LOCALS:LCOUNT, ":", 強化展開
			装備番号 = %強化展開:0%
			分類 = %強化展開:1%
			指定 = %強化展開:2%
			強化値 = TOINT(強化展開:3)
			IF 改造装備(TOINT(装備番号))
				対象_改造装備ベース = %TOSTR(ベース装備番号:(改造装備番号(TOINT(装備番号))))%
				記録_改造装備ベース = %強化展開:4%
			ENDIF

			TRYCCALLFORM 装備箇所_%装備番号%
			CATCH
				CONTINUE
			ENDCATCH
			SIF EQUIP:ARG:GET_EQUIP(RESULT) == TOINT(装備番号)
				CONTINUE
			IF (装備番号 != "") && (分類 == "強化段階") && (指定 == "EXP") && (強化値 > 0)
				CALL 装備強化_展開, ARG, TOINT(装備番号), "強化段階", "LV"
				強化値 = RESULT
				IF 改造装備(TOINT(装備番号))
					MEMOS:0 = ◇%改造装備名称(改造装備番号(TOINT(装備番号))), 16, LEFT%
					SIF 記録_改造装備ベース != "" && 対象_改造装備ベース != 記録_改造装備ベース
						MEMOS:0 += "(強化不可)"
				ELSE
					MEMOS:0 = ◇%ITEMNAME:(TOINT(装備番号)),16,LEFT%
				ENDIF
				IF ARGS:1 == "選択"
				;	PRINTBUTTON MEMOS:0, TOINT(装備番号)
					PRINTFORM [{TOINT(装備番号)}]
					PRINTFORM   %MEMOS:0%
					PRINTFORML   Lv:{強化値}
					選択肢 += 装備番号 + "/"
				ELSE
					;PRINTFORML ◇%ITEMNAME:(TOINT(装備番号)),16,LEFT%  Lv:{強化値}
					PRINTFORML   %MEMOS:0%  Lv:{強化値}
				ENDIF
				MEMO:1 = 0
				MEMO:2 = 0

				CALL 装備強化_展開, ARG, TOINT(装備番号), "공격상성", "付与相性"
				IF RESULT > -1
					SIF ARGS:1 == "選択"
						PRINT         
					PRINT   <공격상성>      
					PRINTFORM   속성 부여  %GET_TYPE(RESULT),4%    
					CALL 装備強化_展開, ARG, TOINT(装備番号), "공격상성", "付与確率"
					PRINTFORM 부여 확률  {RESULT,2}%  
					PRINTL
				ENDIF
				CALL 装備強化_展開, ARG, TOINT(装備番号), "추가효과", "상태이상"
				IF GET_STATE(RESULT) != "GOOD"
					SIF ARGS:1 == "選択"
						PRINT         
					PRINT   <추가효과>      
					PRINTFORM   %GET_STATE(RESULT),16,LEFT%  
					CALL 装備強化_展開, ARG, TOINT(装備番号), "추가효과", "基本命中"
					PRINTFORM 부여 확률  {RESULT,2}%  
					PRINTL
				ENDIF

				FOR LOCAL,0,EQUIP_BATTLESTATUSNUM +2
					CALL 装備強化_展開, ARG, TOINT(装備番号), "戦闘能力修正", GET_BATTLESTATUS(LOCAL)
					IF RESULT != 0
						IF MEMO:1 == 0
							SIF ARGS:1 == "選択"
								PRINT         
							PRINT   <능력강화>      
							MEMO:1 = 1
						ENDIF
						PRINTFORM   %GET_BATTLESTATUS(LOCAL),4,LEFT%  
						SIF RESULT < 0
							SETCOLOR 0xEE1010
						PRINTFORM {RESULT,4}  
						RESETCOLOR
					ENDIF
				NEXT
				SIF MEMO:1 != 0
					PRINTL
				FOR LOCAL,0,TYPENUM
					CALL 装備強化_展開, ARG, TOINT(装備番号), "防御相性", GET_TYPE(LOCAL)
					IF RESULT != 0
						IF MEMO:2 == 0
							SIF ARGS:1 == "選択"
								PRINT         
							PRINT   <내성강화>      
							MEMO:2 = 1
						ENDIF
						PRINTFORM   %GET_TYPE(LOCAL),4,LEFT%
						SETCOLOR COLOR("LIGHT-GRAY")
						IF RESULT == 999
							PRINT   반사  
						ELSE
							PRINTFORM  %\@(RESULT < 0) ? 吸 #   \@%{ABS(RESULT),3}  
						ENDIF
						RESETCOLOR
					ENDIF
				NEXT
				SIF MEMO:2 != 0
					PRINTL
			ENDIF
		NEXT
		SIF ARGS:1 == "選択"
			RESULTS = %選択肢%

	CASE "解説表示"
		SIF CSTR:ARG:장비강화 == ""
			RETURN
		CALL 装備強化_展開, ARG, ARG:1, "強化段階", "LV"
		SIF RESULT <= 1
			RETURN
		強化値 = RESULT
		PRINTFORML   ◇ %ITEMNAME:(ARG:1),16,LEFT%  Lv:{強化値}

		;IF ARG:1 >= 2000 && ARG:1 < 2500
		RESULT = -1
		TRYCALLFORM 装備箇所_{ARG:1}
		IF GET_EQUIP(RESULT) == "검"
			CALL 装備強化_展開, ARG, ARG:1, "공격상성", "付与相性"
			IF RESULT > -1
				PRINT     <공격상성>  
				PRINTFORM   속성 부여  %GET_TYPE(RESULT),4%    
				CALL 装備強化_展開, ARG, ARG:1, "공격상성", "付与確率"
				PRINTFORM 부여 확률  {RESULT,2}%  
				PRINTL
			ENDIF
			CALL 装備強化_展開, ARG, ARG:1, "추가효과", "상태이상"
			IF GET_STATE(RESULT) != "GOOD"
				PRINT     <추가효과>  
				PRINTFORM   %GET_STATE(RESULT),16,LEFT%  
				CALL 装備強化_展開, ARG, ARG:1, "추가효과", "基本命中"
				PRINTFORM 부여 확률  {RESULT,2}%  
				PRINTL
			ENDIF
		ENDIF

		MEMO:1 = 0
		MEMO:2 = 0
		FOR LOCAL,0,EQUIP_BATTLESTATUSNUM +2
			CALL 装備強化_展開, ARG, ARG:1, "戦闘能力修正", GET_BATTLESTATUS(LOCAL)
			IF RESULT != 0
				能力強化値 = RESULT
				IF MEMO:1 == 0
					PRINT     <능력강화>
					MEMO:1 = 1
				ENDIF
				PRINTFORM   %GET_BATTLESTATUS(LOCAL),4,LEFT%
				SIF RESULT < 0
					SETCOLOR 0xEE1010
				PRINTFORM   {能力強化値,4}
				RESETCOLOR
			ENDIF
		NEXT
		SIF MEMO:1 != 0
			PRINTL
		FOR LOCAL,0,TYPENUM
			CALL 装備強化_展開, ARG, ARG:1, "防御相性", GET_TYPE(LOCAL)
			IF RESULT != 0
				IF MEMO:2 == 0
					PRINT     <내성강화>  
					MEMO:2 = 1
				ENDIF
				PRINTFORM   %GET_TYPE(LOCAL),4,LEFT%
				CALL SET_AISYOU_COLOR, RESULT
				IF RESULT == 999
					PRINT   반사  
				ELSE
					PRINTFORM  %\@(RESULT < 0) ? 吸 #   \@%{ABS(RESULT),3}  
				ENDIF
				RESETCOLOR
			ENDIF
		NEXT
		SIF MEMO:2 != 0
			PRINTL
ENDSELECT

@装備強化_展開, ARG, ARG:1, ARGS:1, ARGS:2, ARG:2 = -1, ARG:3 = -1
;ARG キャラ番号  ARG:1 装備番号  ARGS:1 分類  ARGS:2 指定  ARG:2 装備基本値(これにプラス)  ARG:3 例外フラグ
#DIM DYNAMIC LCOUNT, 3
#DIM DYNAMIC MEMO, 10
#DIMS DYNAMIC MEMOS, 10

#DIMS DYNAMIC 強化展開, 10
#DIM DYNAMIC キャラ番号
#DIMS DYNAMIC 装備番号
#DIM DYNAMIC 装備番号_INT
#DIM DYNAMIC 装備番号_ARRAY,100
#DIMS DYNAMIC 分類
#DIMS DYNAMIC 指定
#DIM DYNAMIC 強化値
#DIM DYNAMIC 能力強化値,10
;0 공격  1 명중  2 방어  3 회피  4 마법위력  5 마법효과

#DIM DYNAMIC 戦闘能力
#DIM DYNAMIC 装備基本値,2
#DIM DYNAMIC 性能変動,100
#DIM DYNAMIC 例外
;今のところ、能力強化のポイント割り振り時のみ

#DIMS DYNAMIC 記録_改造装備ベース
#DIMS DYNAMIC 対象_改造装備ベース

SIF ARG < 0
	RETURN ARG:2

IF !FLAG:마정장비해금
	SELECTCASE ARGS:1
		CASE "戦闘能力修正"
			SIF ARG:1 == 0
				RETURN
			SIF ARG:2 != -1
				RETURN ARG:2
			SIF ARG:2 == -1
				RETURN
		CASE "防御相性"
			SIF ARG:1 == 0
				RETURN 100
			SIF ARG:2 != -1
				RETURN ARG:2
			SIF ARG:2 == -1
				RETURN 100
		CASE "공격상성"
			RETURN
		CASE "추가효과"
			RETURN
	ENDSELECT
ELSE
	IF CSTR:ARG:장비강화 == "" && ARGS:1 != "強化段階"
		;追加効果がない場合は0を返す。でないと攻撃が正しく行われない
		;追加効果がない場合、ARGS:2が"상태이상"の時にARG:2は-1になる。このままだと追加効果がGOODと見なされない＝追加効果がある、と判断されてしまう
		;追加効果があって基本付与確率が0未満の場合、SKILL_TEMP.ERB内の処理で攻撃がスキップされるので0を返すようにする
		SIF ARGS:2 == "상태이상" && ARG:2 == -1
			RETURN 0
		RETURN ARG:2
	endif
	
	SELECTCASE ARGS:1
		CASE "戦闘能力修正"
			SIF ARG:1 == 0
				RETURN
		CASE "防御相性"
			SIF ARG:1 == 0
				RETURN 100
			SIF ARG:2 == 100
				RETURN 100
		CASE "공격상성"
			SIF ARG:1 == 0
				RETURN
		CASE "추가효과"
			SIF ARG:1 == 0
				RETURN
	ENDSELECT
ENDIF

;PRINTFORML {ARG}/{ARG:1}/%ARGS:1%/%ARGS:2%/{ARG:2}
キャラ番号 = ARG

SELECTCASE ARGS:1
	CASE "戦闘能力修正"
		戦闘能力 = ARG:2
		例外 = ARG:3
		
		SIF ARG:1 == 0
			RETURN 0
		SIF CSTR:キャラ番号:장비강화 == "" && 戦闘能力 != -1
			RETURN 戦闘能力
		SIF CSTR:キャラ番号:장비강화 == "" && 戦闘能力 == -1
			RETURN 0

		VARSET LOCALS
		;記録の分解
		SPLIT CSTR:キャラ番号:장비강화, "/", LOCALS

		;指定の記録
		IF MEMOS == ""
			MEMOS = %TOSTR(ARG:1)%
		;	MEMOS:1 = %ARGS:1%
			MEMOS:1 = 能力強化
			MEMOS:2 = %ARGS:2%
			MEMOS:3 = %TOSTR(戦闘能力)%
		ENDIF
		
		;100まで
		FOR LCOUNT, 0, 100
			SIF LOCALS:LCOUNT == ""
				BREAK
			VARSET 強化展開
			SPLIT LOCALS:LCOUNT, ":", 強化展開
			装備番号 = %強化展開:0%
			装備番号_INT = TOINT(装備番号)
			分類 = %強化展開:1%
			指定 = %強化展開:2%
			強化値 = TOINT(強化展開:3)
			
			IF MATCH(装備番号_ARRAY, 装備番号_INT, 0) == 0
				装備番号_ARRAY:(LCOUNT:2) = 装備番号_INT
				FOR LCOUNT:1, 0, GUN_BATTLESTATUSNUM
					CALLFORM 戦闘能力修正_{装備番号_INT}, LCOUNT:1, -1
					装備基本値 = RESULT
					CALLFORM 戦闘能力修正_{装備番号_INT}, LCOUNT:1, キャラ番号
					装備基本値:1 = RESULT
					
					IF 装備基本値 != 装備基本値:1
						性能変動:(LCOUNT:2) = 1
						BREAK
					ENDIF
				NEXT
				LCOUNT:2++
			ENDIF

			;指定と同じものを
			IF MEMOS != "" && MEMOS == 装備番号 && MEMOS:1 == 分類 && MEMOS:2 == 指定
				;装備番号:分類:指定:強化値 となっているので抜き出す
				SIF 改造装備(装備番号_INT)
					CONTINUE
					
				IF 性能変動:(FINDELEMENT(装備番号_ARRAY, 装備番号_INT, 0, 100, 1)) == 0 || 例外 == 1
					SIF 戦闘能力 == -1
						RETURN 強化値
					RETURN 戦闘能力 + 強化値
				ELSE
					CALLFORM 装備箇所_{装備番号_INT}
					IF RESULT == GET_EQUIPNUM("검") || RESULT == GET_EQUIPNUM("총")
						SIF 戦闘能力 == -1
							RETURN 強化値 / 4
						RETURN 戦闘能力 + 強化値 / 4
					ELSE
						SIF 戦闘能力 == -1
							RETURN 強化値 / 2
						RETURN 戦闘能力 + 強化値 / 2
					ENDIF
				ENDIF
			ENDIF
		NEXT
		SIF 戦闘能力 != -1
			RETURN 戦闘能力
		RETURN 0

	CASE "防御相性"
		SIF ARG:1 == 0
			RETURN 100
		SIF CSTR:キャラ番号:장비강화 == "" && ARG:2 != -1
			RETURN ARG:2
		SIF CSTR:キャラ番号:장비강화 == "" && ARG:2 == -1
			RETURN 100
		VARSET LOCALS
		;分解
		SPLIT CSTR:キャラ番号:장비강화, "/", LOCALS
		;指定の記録
		IF MEMOS == ""
				MEMOS = %TOSTR(ARG:1)%
			;	MEMOS:1 = %ARGS:1%
				MEMOS:1 = 耐性強化
				MEMOS:2 = %ARGS:2%
				MEMOS:3 = %TOSTR(ARG:2)%
		ENDIF
		
		;記録は100まで
		FOR LCOUNT, 0, 100
			SIF LOCALS:LCOUNT == ""
				BREAK
			VARSET 強化展開
			SPLIT LOCALS:LCOUNT, ":", 強化展開
			装備番号 = %強化展開:0%
			分類 = %強化展開:1%
			指定 = %強化展開:2%
			強化値 = TOINT(強化展開:3)

			;指定と同じものを
			IF MEMOS != "" && MEMOS == 装備番号 && MEMOS:1 == 分類 && MEMOS:2 == 指定
				SIF 改造装備(TOINT(装備番号))
					CONTINUE
				SIF 強化値 == 999
					RETURN 強化値
				SIF ARG:2 > 0 
					RETURN ARG:2 - 強化値
				RETURN 強化値
			ENDIF
		NEXT
				SIF ARG:2 != -1
					RETURN ARG:2
				RETURN 0

	CASE "공격상성"
	;ARG キャラ番号  ARG:1 装備番号  ARGS:1 分類  ARGS:2 指定  ARG:2 装備基本値
		SIF ARG:1 == 0
			RETURN 0
		VARSET LOCALS
		;分解
		SPLIT CSTR:キャラ番号:장비강화, "/", LOCALS
		;指定の記録
		IF MEMOS == ""
				MEMOS = %TOSTR(ARG:1)%
				MEMOS:1 = %ARGS:1%
				MEMOS:2 = %ARGS:2%
			;	指定 = %ARGS:2%
		ENDIF
		
		FOR LCOUNT, 0, 100
			SIF LOCALS:LCOUNT == ""
				BREAK
			VARSET 強化展開
			SPLIT LOCALS:LCOUNT, ":", 強化展開
			装備番号 = %強化展開:0%
			分類 = %強化展開:1%
			指定 = %強化展開:2%
			強化値 = TOINT(強化展開:3)

			;指定と同じものを
			IF MEMOS != "" && MEMOS == 装備番号 && MEMOS:1 == 分類 ;&& MEMOS:2 == 指定
				IF 改造装備(TOINT(装備番号))
					記録_改造装備ベース = %強化展開:4%
					対象_改造装備ベース = %TOSTR(ベース装備番号:(改造装備番号(TOINT(装備番号))))%
					SIF 記録_改造装備ベース != "" && 対象_改造装備ベース != 記録_改造装備ベース
						CONTINUE
				ENDIF
				IF MEMOS:2 == "付与相性"
					IF CFLAG:キャラ番号:악마변신
						RETURN -1
					ELSE
						RETURN GET_TYPE_NUM(指定)
					ENDIF
				ElSEIF MEMOS:2 == "付与確率"
					RETURN 強化値
				ElSEIF MEMOS:2 == "属性付与"
					IF 強化値 >= RAND:100
						RETURN 1
					ENDIF
					RETURN 0
				ENDIF
			ENDIF
		NEXT
		IF MEMOS:2 == "付与相性"
			RETURN -1
		ElSEIF MEMOS:2 == "付与確率"
			RETURN 0
		ENDIF
		SIF ARGS:2 != ""
			RETURN 0
		RETURN -1

	CASE "추가효과"
		;	FREEZE	20%
		;	SHOCK	20%
		;	POISON 	20%
		;	SLEEP 	25%
		;	PANIC 	25%
		;	HAPPY 	35%
		;	BIND 	25%
		;	CHARM 	20%
		SIF ARG:1 == 0
			RETURN 0
		VARSET LOCALS
		;分解
		SPLIT CSTR:キャラ番号:장비강화, "/", LOCALS
		;指定の記録
		IF MEMOS == ""
				MEMOS = %TOSTR(ARG:1)%
				MEMOS:1 = %ARGS:1%
			;	MEMOS:1 = 추가효과
				MEMOS:2 = %ARGS:2%
			;	指定 = %ARGS:2%
		ENDIF
		
		FOR LCOUNT, 0, 100
			SIF LOCALS:LCOUNT == ""
				BREAK
			VARSET 強化展開
			SPLIT LOCALS:LCOUNT, ":", 強化展開
			装備番号 = %強化展開:0%
			分類 = %強化展開:1%
			指定 = %強化展開:2%
			強化値 = TOINT(強化展開:3)

			;指定と同じものを
			IF MEMOS != "" && MEMOS == 装備番号 && MEMOS:1 == 分類 ;&& MEMOS:2 == 指定
				IF 改造装備(TOINT(装備番号))
					記録_改造装備ベース = %強化展開:4%
					対象_改造装備ベース = %TOSTR(ベース装備番号:(改造装備番号(TOINT(装備番号))))%
					SIF 記録_改造装備ベース != "" && 対象_改造装備ベース != 記録_改造装備ベース
						CONTINUE
				ENDIF
				IF MEMOS:2 == "상태이상"
					IF CFLAG:キャラ番号:악마변신
						RETURN GET_STATE_NUM("GOOD")
					ELSE
						RETURN GET_STATE_NUM(指定)
					ENDIF
				ElSEIF MEMOS:2 == "効果相性"
					IF 指定 == "FLAME"
						RETURN GET_TYPE_NUM("화염")
					ELSEIF 指定 == "FREEZE"
						RETURN GET_TYPE_NUM("빙결")
					ELSEIF 指定 == "SHOCK"
						RETURN GET_TYPE_NUM("전격")
					ELSEIF 指定 == "SLIP"
						RETURN GET_TYPE_NUM("충격")
					ELSEIF 指定 == "POISON" || 指定 == "BIND" || 指定 == "CLOSE" || 指定 == "PALYZE"
						RETURN GET_TYPE_NUM("신경")
					ELSEIF 指定 == "SLEEP" || 指定 == "PANIC" || 指定 == "HAPPY" || 指定 == "CHARM"
						RETURN GET_TYPE_NUM("정신")
					ELSEIF 指定 == "BRAND"
						RETURN GET_TYPE_NUM("파마")
					ELSEIF 指定 == "CURSE"
						RETURN GET_TYPE_NUM("주살")
					ENDIF
				ElSEIF MEMOS:2 == "基本命中"
					RETURN 強化値
				ElSEIF MEMOS:2 == "最大命中"
					RETURN 95
				ENDIF
			ENDIF
		NEXT
		SIF ARGS:2 != ""
			RETURN 0
		RETURN 0

	CASE "強化段階"
		SIF CSTR:キャラ番号:장비강화 == ""
			RETURN 1
		VARSET LOCALS
		;分解
		SPLIT CSTR:キャラ番号:장비강화, "/", LOCALS

		;指定記録
		IF MEMOS == ""
				MEMOS = %TOSTR(ARG:1)%
			;	MEMOS:1 = %ARGS:1%
				MEMOS:1 = 強化段階
				MEMOS:2 = %ARGS:2%
				MEMOS:3 = %TOSTR(ARG:2)%
		ENDIF
		;100まで
		FOR LCOUNT, 0, 100
			SIF LOCALS:LCOUNT == ""
				BREAK
			VARSET 強化展開
			SPLIT LOCALS:LCOUNT, ":", 強化展開
			装備番号 = %強化展開:0%
			分類 = %強化展開:1%
			指定 = %強化展開:2%
			強化値 = TOINT(強化展開:3)

			;指定と同じものを
			IF MEMOS != "" && MEMOS == 装備番号 && MEMOS:1 == 分類 ;&& MEMOS:2 == 指定
				SIF 指定 == "EXP" && MEMOS:2 == 指定
					RETURN 強化値
				SIF 指定 == "保存強化値" && MEMOS:2 == 指定
					RETURN 強化値
				IF MEMOS:2 == "LV" || MEMOS:2 == "NEXT" || MEMOS:2 == "保存LV"
					MEMO = 0
					MEMO:1 = 0
					WHILE 強化値 > MEMO:1
						MEMO += 1
						MEMO:1 = 5 * MEMO * (MEMO+1) * (MEMO+2) / 3
					;	PRINTFORML Lv：{MEMO}    NEXT:{MEMO:1}/EXP:{強化値}
						SIF MEMO >= 99
							BREAK
					WEND
					SIF MEMOS:2 == "LV"
						RETURN MIN(BASE:キャラ番号:LV, MEMO)
					SIF MEMOS:2 == "NEXT"
						RETURN MEMO:1 - 強化値
					SIF MEMOS:2 == "保存LV"
						RETURN MEMO
				ENDIF
			ENDIF
		NEXT
		RETURN 1
	CASE "記録_改造装備ベース番号"
		SIF CSTR:キャラ番号:장비강화 == ""
			RETURN 0
		VARSET LOCALS
		;分解
		SPLIT CSTR:キャラ番号:장비강화, "/", LOCALS

		;指定記録
		IF MEMOS == ""
			MEMOS = %TOSTR(ARG:1)%
			MEMOS:1 = 記録_改造装備ベース番号
		ENDIF

		FOR LCOUNT, 0, 100
			SIF LOCALS:LCOUNT == ""
				BREAK
			VARSET 強化展開
			SPLIT LOCALS:LCOUNT, ":", 強化展開
			装備番号 = %強化展開:0%
			分類 = %強化展開:1%
			記録_改造装備ベース = %強化展開:4%

			SIF MEMOS != "" && MEMOS == 装備番号 && MEMOS:1 == 分類 && 記録_改造装備ベース != ""
				RETURN TOINT(記録_改造装備ベース)
		NEXT
		RETURN 0
	CASEELSE
ENDSELECT

@装備強化_振り分け制限算出, ARG, ARG:1, ARG:2
;ARG 装備番号。ARGS:1 装備部位。ARG:2 強化段階
#DIM DYNAMIC 装備番号
#DIM DYNAMIC 装備部位
#DIM DYNAMIC ポイント
#DIM DYNAMIC 強化段階
#DIM DYNAMIC 攻撃回数合計
#DIM DYNAMIC RANDOMTARGET
#DIM DYNAMIC LCOUNT

装備番号 = ARG
装備部位 = ARG:1
強化段階 = ARG:2

IF 装備部位 == GET_EQUIPNUM("검")
	ポイント = 強化段階 * 7
	CALLFORM 攻撃範囲_{装備番号}
	LOCALS = %GET_SPHERE(RESULT)%
	IF LOCALS == "일렬"
		TIMES ポイント , 0.85
	ELSEIF LOCALS == "전체"
		TIMES ポイント , 0.75
	ENDIF
ELSEIF 装備部位 == GET_EQUIPNUM("총")
	CALLFORM 攻撃範囲_{装備番号}
	LOCALS = %GET_SPHERE(RESULT)%
	CALLFORM 最低攻撃回数_{装備番号}
	LOCAL = RESULT
	CALLFORM 最大攻撃回数_{装備番号}
	;LOCAL:1 = (LOCAL + RESULT) / 2
	攻撃回数合計 = LOCAL + RESULT
	TRYCCALLFORM GUN_RANDOMTARGET_{装備番号}
		RANDOMTARGET = 1
	CATCH
	ENDCATCH
	IF RANDOMTARGET == 1
		ポイント = 強化段階 * 6
	ELSEIF LOCALS == "단체"
		ポイント = 強化段階 * 6
	ELSEIF LOCALS == "일렬"
		ポイント = 強化段階 * 5
	ELSEIF LOCALS == "전체"
		ポイント = 強化段階 * 4
	ENDIF
	;SIF LOCAL:1 > 1
	;	ポイント = ポイント / (LOCAL:1 / 2) * 120 /100
	;攻撃回数合計が奇数の装備の計算の為にポイントと攻撃回数合計を10倍にする
	SIF 攻撃回数合計 > 2
		ポイント = ポイント * 10 / (攻撃回数合計 * 10 / 2) * 120 / 100
	CALLFORM 特殊弾倉_{装備番号}
	SIF RESULT > 2
		ポイント -= RESULT * 10
ELSEIF 装備部位 == GET_EQUIPNUM("머리")
	ポイント = 強化段階 * 14 / 10
ELSEIF 装備部位 == GET_EQUIPNUM("몸통")
	ポイント = 強化段階 * 2
ELSEIF 装備部位 == GET_EQUIPNUM("팔")
	ポイント = 強化段階 * 16 / 10
ELSEIF 装備部位 == GET_EQUIPNUM("발")
	ポイント = 強化段階 * 15 / 10
ELSE
	
ENDIF
RETURN ポイント

