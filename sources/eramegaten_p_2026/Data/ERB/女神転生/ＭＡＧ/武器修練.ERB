	PRINTFORML [ 3]무기소질형변경
PRINTL 
PRINTFORML [99]돌아간다
INPUT

SELECTCASE RESULT
	CASE 1
		DRAWLINE
		PRINTL □숙련도취득　★：초기소질
		FOR LOCAL, 1, 12
			PRINTFORML [{LOCAL, 2}]%GET_ARMS_TYPE(LOCAL), 8, LEFT%　숙련도:{CFLAG:ARG:(LOCAL + 1049),4} \@CSVTALENT(NO:ARG,(LOCAL + 249),0) ? ★#　\@
		NEXT
		PRINTL 
		PRINTFORML [99]돌아간다
		INPUT
		SIF RESULT > 0 && RESULT < 12
			CALL WEAPON_TRAINING,ARG,RESULT
	CASE 2
		CALL 武器素質付与,ARG
	CASE 3
		IF 武器素質数(ARG) > 0
			DRAWLINE
			PRINTL 무기소질형변경
			PRINTL 변경할 소질을 선택해주세요
			FOR LOCAL,1,12
				IF TALENT:ARG:(249 + LOCAL)
					PRINTFORML [{LOCAL,2}]%TALENTNAME:(249 + LOCAL),16,LEFT%　현재의 형:%WEAPON_TYPE_NAME(LOCAL,TALENT:ARG:(249 + LOCAL))%
				ENDIF
			NEXT
			PRINTL 
			PRINTFORML [99]돌아간다
			INPUT
			SIF RESULT > 0 && RESULT < 12 && TALENT:ARG:(249 + RESULT)
				CALL WEAPON_TYPE_CHANGE,ARG,RESULT
		ENDIF
