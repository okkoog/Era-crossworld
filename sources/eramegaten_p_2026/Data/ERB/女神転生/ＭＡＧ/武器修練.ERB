GOTO INPUT_LOOP

@武器素質付与,ARG
#DIM LCOUNT
#DIM DYNAMIC 変数A
;VARSET Q,0
IF (ARG == MASTER && 武器素質数(ARG) > 10) || (ARG > 0 && 武器素質数(ARG) > 1)
	PRINTW 이 이상은 소질을 가질 수 없습니다
	RETURN 0
ENDIF

PRINTL □무기소질부여
PRINTL 조건:숙련도 1000이상　당신 이외는 하나까지만
PRINT 현재:
FOR LCOUNT,0,11
	IF TALENT:ARG:(250 + LCOUNT)
		SIF 変数A > 0
			PRINT 、
		PRINTFORM %TALENTNAME:(250 + LCOUNT)%
		変数A += 1
	ENDIF
NEXT
IF 変数A > 0
	PRINTL 를 취득
ELSE
	PRINTL 소질없음
ENDIF
変数A = 0
FOR LCOUNT,0,11
	SIF TALENT:ARG:(250 + LCOUNT)
		CONTINUE
	IF CFLAG:ARG:(1050+LCOUNT) > 999 || CSVTALENT(NO:ARG,250 + LCOUNT,0)
		PRINTFORML [{LCOUNT, 2}]　%TALENTNAME:(250 + LCOUNT)%
		SETBIT 変数A, LCOUNT
	ENDIF
NEXT

IF 変数A == 0
	PRINTFORMW 조건을 만족하는 항목이 없습니다
	RETURN 0
ENDIF
PRINTFORML [20]　돌아간다
INPUT
SIF RESULT == 20
	RETURN 0
IF INRANGE(RESULT, 0, 10) && GETBIT(変数A, RESULT)
	PRINTFORML %TALENTNAME:(250 + RESULT)%을(를) 취득했다
	TALENT:ARG:(250 + RESULT) = 1
	IF MASTER != ARG
		FOR LOCAL, 0, 11
			IF LOCAL != RESULT && TALENT:ARG:(250 + LOCAL)
				PRINTFORML %TALENTNAME:(250 + LOCAL)%을(를) 잃었다
				TALENT:ARG:(250 + LOCAL) = 0
			ENDIF
		NEXT
	ENDIF
	PRINTFORMW 
ENDIF

@WEAPON_TRAINING,ARG,ARG:1
#LOCALSIZE 1
$INPUT_LOOP
IF TALENT:ARG:(249 + ARG:1) || CSVTALENT(NO:ARG,(249 + ARG:1),0)
	PRINTW 이미 소질을 가지고 있습니다
	CFLAG:ARG:(1049+ARG:1) = 1000
	RETURN 0
ENDIF
IF CFLAG:ARG:(1049+ARG:1) > 999
	PRINTW 숙련도가 1000 이상이 되었습니다
	CFLAG:ARG:(1049+ARG:1) = 1000
	RETURN 0
ENDIF
DRAWLINE
PRINTFORML □%GET_ARMS_TYPE(ARG:1)% 숙련도:{CFLAG:ARG:(1049+ARG:1)}
PRINTFORML [ 1] 수련
PRINTFORML [ 2] 습득의 구슬 변환
PRINTL 
PRINTFORML [99] 돌아간다
INPUT

SELECTCASE RESULT
	CASE 1
		CALL WEAPON_TRAINING2,ARG,ARG:1
	CASE 2
		DRAWLINE
		LOCAL = MIN(JUEL:ARG:습득/100, 1000 - CFLAG:ARG:(1049+ARG:1))
		PRINTFORML %GET_ARMS_TYPE(ARG:1)%의 숙련도를 얼마나 올리겠습니까?
		PRINTFORML ※ 습득의 구슬 100개당 숙련도 1
		PRINTFORML 습득의 구슬:{JUEL:ARG:습득}　({LOCAL}까지)　직접 입력 가능
		SIF LOCAL >= 1
			PRINTFORML [1]
		SIF LOCAL >= 5
			PRINTFORML [5]
		SIF LOCAL >= 10
			PRINTFORML [10]
		SIF LOCAL >= 50
			PRINTFORML [50]
		SIF LOCAL >= 100
			PRINTFORML [100]
		SIF !GROUPMATCH(LOCAL, 0, 1, 5, 10, 50, 100)
			PRINTFORML [{LOCAL}]
		PRINTFORML [0]
		INPUT
		IF RESULT > LOCAL
			PRINTFORML 수치가 너무 큽니다
		ELSEIF RESULT > 0
			LOCAL = RESULT
			PRINTFORML 습득의 구슬:{JUEL:ARG:습득,6}　→　{JUEL:ARG:습득 - (LOCAL*100)}
			PRINTFORML 숙련도　:{CFLAG:ARG:(1049+ARG:1),6}　→　{CFLAG:ARG:(1049+ARG:1) + LOCAL}
			PRINTFORML 괜찮겠습니까?
			CALL INPUT_YN,"네","아니오"
			IF RESULT == 0
				JUEL:ARG:습득 -= LOCAL*100
				CFLAG:ARG:(1049+ARG:1) += LOCAL
			ENDIF
		ENDIF
	CASE 99
		RETURN 0
ENDSELECT

GOTO INPUT_LOOP

@WEAPON_TRAINING2,ARG,ARG:1
#LOCALSIZE 2
#DIM DYNAMIC 教授役 = -1
#DIM 上昇量
#DIM 修練回数
$INPUT_LOOP
IF BASE:ARG:체력 <= 500
	PRINTW 체력이 부족하여 수련할 수 없습니다
	RETURN 0
ENDIF
IF CFLAG:ARG:(1049+ARG:1) > 999
	;PRINTW 숙련도가 1000 이상이 되었습니다
	;CFLAG:ARG:(1049+ARG:1) = 1000
	RETURN 0
ENDIF
IF 教授役 > -1
	IF BASE:教授役:체력 <= 250
		PRINTL 교수의 체력이 부족하여 지도할 수 없습니다
		教授役 = -1
	ENDIF
ENDIF
DRAWLINE
PRINTFORML □%GET_ARMS_TYPE(ARG:1)% 수련
PRINTFORML 숙련도:{CFLAG:ARG:(1049+ARG:1)}
PRINTFORML 체력　:{BASE:ARG:체력}
PRINTFORM [ 1] 교수 선택
PRINTFORM 　교수:
IF 教授役 > -1
	PRINTFORML %CALLNAME:教授役%
ELSE
	PRINTL 없음
ENDIF
PRINTFORML [ 2] 수련 실행　　　　체력 500 소비
PRINTFORML [ 3] 체력 500까지 수련 연속 실행
PRINTL 
PRINTFORML [99] 돌아간다
INPUT

SELECTCASE RESULT
	CASE 1
		CALL 教授選択,ARG:1
		教授役 = RESULT
	CASE 2
		上昇量 = 40 + RAND:21
		SIF 教授役 > -1
			TIMES 上昇量,1.50
		PRINTL □수련 실행
		PRINTFORML ○%CALLNAME:ARG%
		PRINTFORML 체력　:{BASE:ARG:체력,4}　→　{BASE:ARG:체력 - 500}
		PRINTFORML 숙련도:{CFLAG:ARG:(1049+ARG:1),4}　→　{MIN(CFLAG:ARG:(1049+ARG:1) + 上昇量, 1000)}
		BASE:ARG:체력 -= 500
		CFLAG:ARG:(1049+ARG:1) += 上昇量
		IF 教授役 > -1
			PRINTFORML ○%CALLNAME:教授役%
			PRINTFORML 체력　:{BASE:教授役:체력,4}　→　{BASE:教授役:체력 - 250}
			BASE:教授役:체력 -= 250
		ENDIF
		SIF CFLAG:ARG:(1049+ARG:1) > 1000
			CFLAG:ARG:(1049+ARG:1) = 1000
		PRINTW
	CASE 3
		上昇量 = 0
		修練回数 = (BASE:ARG:체력 - 1) / 500
		IF 教授役 > -1
			修練回数 = MIN((BASE:教授役:체력 - 1) / 250, 修練回数)
		ENDIF
		FOR LOCAL, 0, 修練回数
			LOCAL:1 = (40 + RAND:21)
			SIF 教授役 > -1
				TIMES LOCAL:1,1.50
			上昇量 += LOCAL:1
			IF CFLAG:ARG:(1049+ARG:1) + 上昇量 >= 1000
				修練回数 = LOCAL + 1
				BREAK
			ENDIF
		NEXT
		PRINTL □수련 실행
		PRINTFORML ○%CALLNAME:ARG%
		PRINTFORML 실행 수:{修練回数}
		PRINTFORML 체력　:{BASE:ARG:체력,4}　→　{BASE:ARG:체력 - (500 * 修練回数)}
		PRINTFORML 숙련도:{CFLAG:ARG:(1049+ARG:1),4}　→　{MIN(CFLAG:ARG:(1049+ARG:1) + 上昇量, 1000)}
		BASE:ARG:체력 -= (500 * 修練回数)
		CFLAG:ARG:(1049+ARG:1) += 上昇量
		SIF CFLAG:ARG:(1049+ARG:1) > 1000
			CFLAG:ARG:(1049+ARG:1) = 1000
		IF 教授役 > -1
			PRINTFORML ○%CALLNAME:教授役%
			PRINTFORML 체력　:{BASE:教授役:체력,4}　→　{BASE:教授役:체력 - (250 * 修練回数)}
			BASE:教授役:체력 -= (250 * 修練回数)
		ENDIF
		PRINTW
	CASE 99
		RETURN 0
ENDSELECT

GOTO INPUT_LOOP


@教授選択,ARG
#LOCALSIZE 1
#DIM DYNAMIC LCOUNT,MAX_PLAYER_CHARA
PRINTL □교수 선택
PRINTL 조건: 무기 소질 보유, 함락 또는 충성도 5000 이상 혹은 당신, 수련 1회당 체력 250 소비
;VARSET Q,0
FOR LOCAL,0,CHARANUM
	SIF CFLAG:LOCAL:PT플래그 == 0
		CONTINUE
	SIF CFLAG:LOCAL:이자리에없는플래그
		CONTINUE
	SIF IS_RENTING(LOCAL)
		CONTINUE
	SIF !TALENT:LOCAL:(249 + ARG)
		CONTINUE
	SIF !陥落(LOCAL) && GET_CHARA_LOYALTY(LOCAL) < 5000 && LOCAL != MASTER
		CONTINUE
	SIF BASE:LOCAL:체력 <= 250
		CONTINUE
	LCOUNT:LOCAL = 1
	PRINTFORML [{LOCAL,3}]　%CALLNAME:LOCAL%　체력　:{BASE:LOCAL:체력}
NEXT
PRINTFORML [999]　없음
INPUT
SIF RESULT == 999
	RETURN -1
SIF LCOUNT:RESULT == 1
	RETURN RESULT
RETURN -1

