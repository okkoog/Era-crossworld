@武器修練 ,ARG
#LOCALSIZE 1
FOR LOCAL,0,11
	IF TALENT:ARG:(250 + LOCAL)
		CFLAG:ARG:(1050 + LOCAL) = 1000
	ENDIF
NEXT
;IF (ARG == 0 && 武器素質数(ARG) > 10) || (ARG > 0 && 武器素質数(ARG) > 1)
;	PRINTW これ以上素質を持てません
;	RETURN 0
;ENDIF

$INPUT_LOOP
DRAWLINE
PRINTL □무기수련
PRINTFORML [ 1]숙련도취득
PRINTFORML [ 2]무기소질부여
