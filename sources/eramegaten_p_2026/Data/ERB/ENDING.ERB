;No.06ロリハーレムEND
;エンドをキャンセルしていないこと、納金が300万以上（幹部よりちょっと少ない）、問題行動は起こしていない
;※イベントフラグ:1:1 = マヨーネ様の警告を受けたかのフラグ( -1イベント消去 0未発生 1～2警告イベント発生 )
;かつ、以下のポイントが20ポイント以上になったら発生
;アリス、モーショボー、ナジャ、ユキンコ、……などロリキャラが上位陥落で+3ポイント
;（ただしひとり以上は必須）（また、例えば『ショボたん100人』でもメイン判定はひとりだけ）
;「小柄かつ女性」キャラが助手可能で+1、上位陥落ならさらに+1
;さらに小悪魔であれば+1
;およそ「メインとなるロリが4名」＋「陥落・助手ロリが4～5名」＝20ポイント越えという感じ
IF GETBIT(FLAG:취소된ED,6) == 0 && FLAG:조직공헌도 >= 3000000 && イベントフラグ:1:1 < 1
	;合計ポイントとして使用するためここで初期化
	LENDING_CONDITION = 0
	;必須キャラ数として使用するためここで初期化
	LENDING_CONDITION_1 = 0

	FOR LCOUNT, 0, CHARANUM
		;あなたは除外
		SIF LCOUNT == MASTER
			CONTINUE
		;男はダメ
		SIF TALENT:LCOUNT:남자
			CONTINUE
		;小柄/小人体型ではない場合はダメ
		SIF !(TALENT:LCOUNT:유아체형 || TALENT:LCOUNT:소인체형)
			CONTINUE
		;調教されていないキャラはダメ
		SIF CFLAG:LCOUNT:피조교횟수 <= 0
			CONTINUE
		;ポイント計算に使用するためここで初期化
		LENDING_CONDITION_2 = 0
		;上位陥落している場合
		IF 陥落(LCOUNT) >= 2
			;まず必須キャラをチェック、後で3ポイント分として計算する
			;他にもいたら加筆してほしい
			IF 0
			;アリス
			ELSEIF NO:LCOUNT == [[キャラ:앨리스]]
				LENDING_CONDITION += 1
			;ショボたん
			ELSEIF NO:LCOUNT == [[キャラ:모・쇼보]]
				LENDING_CONDITION += 1
			;ナジャ
			ELSEIF NO:LCOUNT == [[キャラ:나쟈]]
				LENDING_CONDITION += 1
			;ユキンコ
			ELSEIF NO:LCOUNT == [[キャラ:유킨코]]
				LENDING_CONDITION += 1
			;未来
			ELSEIF NO:LCOUNT == [[キャラ:미라이]]
				LENDING_CONDITION += 1
			;こだいちゃん
			ELSEIF NO:LCOUNT == [[キャラ:코시로]]
				LENDING_CONDITION += 1
			;ナナコン！！！！
			ELSEIF NO:LCOUNT == [[キャラ:나나코]]
				LENDING_CONDITION += 1
			;エリカ
			ELSEIF NO:LCOUNT == [[キャラ:에리카]]
				LENDING_CONDITION += 1
			;舞子
			ELSEIF NO:LCOUNT == [[キャラ:마이코]]
				LENDING_CONDITION += 1
			;子供（業が深い）
			ELSEIF TALENT:LCOUNT:아이
				LENDING_CONDITION += 1
			;必須キャラ以外の該当キャラの場合
			ELSE
				;基本は2ポイント加算
				LENDING_CONDITION_2 = 2
			ENDIF
		;上位陥落はしていないが陥落している、または助手可能である場合
		ELSEIF 陥落(LCOUNT) == 1 || CFLAG:LCOUNT:매각가능 == 2
			;基本は1ポイント加算
			LENDING_CONDITION_2 = 1
		ENDIF
		;必須キャラ条件を満たさないキャラのポイント加算処理
		IF LENDING_CONDITION_2 >= 1
			;小悪魔なら追加で+1
			SIF TALENT:LCOUNT:소악마
				LENDING_CONDITION_2 += 1
			;幼稚ならさらに+1
			SIF TALENT:LCOUNT:유치
				LENDING_CONDITION_2 += 1
			;最大3ポイントとして加算する
			LENDING_CONDITION_1 += MIN(3, LENDING_CONDITION_2)
		ENDIF

	NEXT
	;必須キャラが存在＋ロリキャラたちが一定以上
	IF LENDING_CONDITION > 0
		IF LENDING_CONDITION * 3 + LENDING_CONDITION_1 > 20 
			SETBIT FLAG:취소된ED,6
			CALL ENDING_NO06
			SIF RESULT == 1
				GOTO CONTINUE_1
		ENDIF
	ENDIF
	
ENDIF



