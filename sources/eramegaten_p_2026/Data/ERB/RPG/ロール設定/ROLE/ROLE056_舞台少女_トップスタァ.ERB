		RETURNF 0x5687e6
	CASE [[キャラ:마히루]]
		RESULT:1 = 0x4E6F66
		RETURNF 0x56b78e
	CASE [[キャラ:쥰나]]
		RESULT:1 = 0x768893
		RETURNF 0x8ac4ec
	CASE [[キャラ:후타바_무대소녀]]
		RESULT:1 = 0x4F4060
		RETURNF 0x815ca1
	CASE [[キャラ:카오루코]]
		RESULT:1 = 0x5F1432
		RETURNF 0xdc7b8c
	CASE [[キャラ:나나]]
		RESULT:1 = 0x645A32
		RETURNF 0xfdca57
