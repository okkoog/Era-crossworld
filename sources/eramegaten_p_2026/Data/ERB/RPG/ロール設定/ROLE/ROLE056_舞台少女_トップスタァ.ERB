;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_ROLE_舞台少女_トップスタァ,ARG,ARG:1
#LOCALSIZE 1
#DIM L_T
#DIM L_GP
L_GP = 0
SIF EQUIP:ARG:악세서리 != GETNUM(ITEM, "별의티아라")
	RETURN 0
;セットアップできているときは離脱
SIF GET_ROLE_CFLAG_DUNGEON(ARG, "키라메키게이지") == 100
	RETURN 0
SIF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간") > 0
	RETURN 0
;クライマックスアクト発動直後は-1にしてくるのでここで0にして離脱
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간") < 0
	CALL SET_ROLE_CFLAG_DUNGEON, ARG,  "클라이맥스레뷰지속시간" , 0
	RETURN 0
ENDIF
;自分の行動の場合
IF ARG == ARG:1
	;毎ターン＋10
	L_GP += 10
	
	;ダメージを受けた敵の数に応じてスキルゲージアップ
	FOR LOCAL, 0, BCHARANUM
		L_T = BCHARA:LOCAL
		SIF IS_FRIEND(ARG, L_T)
			CONTINUE
		SIF GET_CREC_ACT(ARG, L_T, "HIT")
			L_GP += 5
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 5
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 5
	NEXT
	
	;気合を入れても上がる
	SELECTCASE CFLAG:ARG:입력행동
		CASE [[스킬:기합]], [[스킬:컨센트레이트]]
			L_GP += 40
		CASE [[스킬:포효]], [[스킬:도발]], [[스킬:끝없는도발]]
			L_GP += 30
		CASEELSE
			
			;行動しているキャラが支援スキルをつかってないとダメ
			CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", CFLAG:ARG:입력행동, ARG
			SIF GET_SUCCESSION(RESULT) == "지원"
				L_GP += 30
	ENDSELECT
		
	;専用技をヒットさせていた場合さらに+30
	IF GET_CREC_ACT_SUM(ARG, "적", "HIT")
		SIF INRANGE(CFLAG:ARG:입력행동, SKILL_NUM_F("전용기1"), SKILL_NUM_F("전용기1") + PU_NUM())
			L_GP += 30
		SIF CFLAG:ARG:입력행동 == [[스킬:기절의참격]]
			L_GP += 30
		SIF CFLAG:ARG:입력행동 == [[스킬:재생의협주곡]]
			L_GP += 30
		SIF CFLAG:ARG:입력행동 == [[스킬:인어공주의연심]]
			L_GP += 30
		SIF CFLAG:ARG:입력행동 == [[스킬:맹독의협주곡]]
			L_GP += 30
		SIF CFLAG:ARG:입력행동 == [[스킬:분기의합주]]
			L_GP += 30
		SIF CFLAG:ARG:입력행동 == [[스킬:추토의참격]]
			L_GP += 30
		SIF CFLAG:ARG:입력행동 == [[스킬:질풍의상동곡]]
			L_GP += 30
	ENDIF
ELSE
	;行動者が味方
	IF IS_FRIEND(ARG, ARG:1)
		;呼応の斬撃をヒットさせていたら20獲得
		SIF IS_PU_SKILL_入力行動(ARG:1, "呼応の斬撃") && GET_CREC_ACT_SUM(ARG:1, "적", "HIT") > 0
			L_GP += 20
	ENDIF
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += MAX(60 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ, 2)
;スキルゲージが100以上だと100にする
CALL SET_ROLE_CFLAG_DUNGEON, ARG, "키라메키게이지", LIMIT(GET_ROLE_CFLAG_DUNGEON(ARG, "키라메키게이지") + L_GP, 0, 100)
IF GET_ROLE_CFLAG_DUNGEON(ARG, "키라메키게이지") < 100
	RESULTS = キラめき
ELSE
	RESULTS = ＣＬＩＭＡＸ ＲＥＶＵＥ ＲＥＡＤＹ
	RESULT:1 = 舞台少女カラー(ARG)
ENDIF
RESULTS:1 = \%
RETURN L_GP
