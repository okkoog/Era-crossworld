@ROLE_NAME_12
RESULTS = 半魔人_SP

;--------------------------------------------
;ロール表示名
;解説文でのロールの名称
;人間時/悪魔変身時
;ARG = キャラ番号(いちおう分岐用)
;CSTRでキャラ側からの指定も可能
