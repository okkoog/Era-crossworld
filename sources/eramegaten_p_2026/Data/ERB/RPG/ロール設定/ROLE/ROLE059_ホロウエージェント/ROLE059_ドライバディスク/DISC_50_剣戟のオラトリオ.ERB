@ZENZERO_DISC_NAME_50
RESULTS '= "剣戟のオラトリオ"

@ZENZERO_DISC_防御相性_剣戟のオラトリオ, L_CHARA, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TYPE
SELECTCASE L_TYPE
	CASE "검격"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "剣戟のオラトリオ") >= 2
			RETURN 0
		ELSE
			RETURN 50
		ENDIF
	CASE "비구", "타격", "전술"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "剣戟のオラトリオ") == 4
			RETURN 0
		ELSE
			RETURN 100
		ENDIF
	CASEELSE
		RETURN 100
ENDSELECT

@ZENZERO_DISC_EXPLAIN_剣戟のオラトリオ
RESULTS:0 '= "基本効果:剣撃耐性"
RESULTS:1 '= "２セット:剣撃無効"
RESULTS:2 '= "４セット:剣撃・飛具・打撃・戦技無効"