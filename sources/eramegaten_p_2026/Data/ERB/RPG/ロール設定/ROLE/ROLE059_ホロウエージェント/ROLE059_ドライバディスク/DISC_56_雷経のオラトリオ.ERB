@ZENZERO_DISC_NAME_56
RESULTS '= "雷経のオラトリオ"

@ZENZERO_DISC_防御相性_雷経のオラトリオ, L_CHARA, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TYPE
SELECTCASE L_TYPE
	CASE "전격"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "雷経のオラトリオ") >= 2
			RETURN 0
		ELSE
			RETURN 50
		ENDIF
	CASE "화염", "빙결", "충격"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "雷経のオラトリオ") == 4
			RETURN 0
		ELSE
			RETURN 100
		ENDIF
	CASEELSE
		RETURN 100
ENDSELECT

@ZENZERO_DISC_EXPLAIN_雷経のオラトリオ
RESULTS:0 '= "基本効果:電撃耐性"
RESULTS:1 '= "２セット:電撃無効"
RESULTS:2 '= "４セット:火炎・氷結・電撃・衝撃無効"