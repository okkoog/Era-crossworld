@ZENZERO_DISC_NAME_60
RESULTS '= "光塵のオラトリオ"

@ZENZERO_DISC_防御相性_光塵のオラトリオ, L_CHARA, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TYPE
SELECTCASE L_TYPE
	CASE "파마"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "光塵のオラトリオ") >= 2
			RETURN 0
		ELSE
			RETURN 50
		ENDIF
	CASE "신경", "정신", "주살"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "光塵のオラトリオ") == 4
			RETURN 0
		ELSE
			RETURN 100
		ENDIF
	CASEELSE
		RETURN 100
ENDSELECT

@ZENZERO_DISC_EXPLAIN_光塵のオラトリオ
RESULTS:0 '= "基本効果:破魔耐性"
RESULTS:1 '= "２セット:破魔無効"
RESULTS:2 '= "４セット:神経・精神・破魔・呪殺無効"