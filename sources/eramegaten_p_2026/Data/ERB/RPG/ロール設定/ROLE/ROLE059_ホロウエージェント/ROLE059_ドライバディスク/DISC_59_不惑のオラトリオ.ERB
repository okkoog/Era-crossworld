@ZENZERO_DISC_NAME_59
RESULTS '= "不惑のオラトリオ"

@ZENZERO_DISC_防御相性_不惑のオラトリオ, L_CHARA, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TYPE
SELECTCASE L_TYPE
	CASE "정신"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "不惑のオラトリオ") >= 2
			RETURN 0
		ELSE
			RETURN 50
		ENDIF
	CASE "신경", "파마", "주살"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "不惑のオラトリオ") == 4
			RETURN 0
		ELSE
			RETURN 100
		ENDIF
	CASEELSE
		RETURN 100
ENDSELECT

@ZENZERO_DISC_EXPLAIN_不惑のオラトリオ
RESULTS:0 '= "基本効果:精神耐性"
RESULTS:1 '= "２セット:精神無効"
RESULTS:2 '= "４セット:神経・精神・破魔・呪殺無効"