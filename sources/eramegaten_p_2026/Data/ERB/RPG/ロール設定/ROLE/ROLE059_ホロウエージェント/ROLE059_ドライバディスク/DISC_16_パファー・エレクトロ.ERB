@ZENZERO_DISC_NAME_16
RESULTS '= "パファー・エレクトロ"

@ZENZERO_DISC_EXPLAIN_パファー・エレクトロ
RESULTS:0 '= "基本効果:命中率・回避率上昇小％"
RESULTS:1 '= "２セット:命中率・回避率上昇中％"
RESULTS:2 '= "４セット:命中率・回避率上昇大％"

@SKILL_PASSIVE_BTL_EFFECT_DISC_ADD_パファー・エレクトロ, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_LINK
#DIM DYNAMIC L_RESULT
;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		CASE "追加命中強化"
			SELECTCASE MATCH(C_ZENZERO_DISC_NAME:L_P:0, "パファー・エレクトロ")
				CASE 4
					RETURN 4
				CASE 2,3
					RETURN 2
				CASE 1
					RETURN 1
			ENDSELECT
	ENDSELECT
;自分が防御側
ELSE
	SELECTCASE ARGS
		CASE "追加回避強化"
			SELECTCASE MATCH(C_ZENZERO_DISC_NAME:L_P:0, "パファー・エレクトロ")
				CASE 4
					RETURN 4
				CASE 2,3
					RETURN 2
				CASE 1
					RETURN 1
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 0