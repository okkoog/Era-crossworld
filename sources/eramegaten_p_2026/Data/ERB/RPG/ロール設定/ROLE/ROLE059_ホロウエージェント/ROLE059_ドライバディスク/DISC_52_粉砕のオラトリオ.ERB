@ZENZERO_DISC_NAME_52
RESULTS '= "粉砕のオラトリオ"

@ZENZERO_DISC_防御相性_粉砕のオラトリオ, L_CHARA, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TYPE
SELECTCASE L_TYPE
	CASE "타격"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "粉砕のオラトリオ") >= 2
			RETURN 0
		ELSE
			RETURN 50
		ENDIF
	CASE "검격", "비구", "전술"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "粉砕のオラトリオ") == 4
			RETURN 0
		ELSE
			RETURN 100
		ENDIF
	CASEELSE
		RETURN 100
ENDSELECT

@ZENZERO_DISC_EXPLAIN_粉砕のオラトリオ
RESULTS:0 '= "基本効果:打撃耐性"
RESULTS:1 '= "２セット:打撃無効"
RESULTS:2 '= "４セット:剣撃・飛具・打撃・戦技無効"