@ZENZERO_DISC_NAME_51
RESULTS '= "銃火のオラトリオ"

@ZENZERO_DISC_防御相性_銃火のオラトリオ, L_CHARA, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TYPE
SELECTCASE L_TYPE
	CASE "비구"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "銃火のオラトリオ") >= 2
			RETURN 0
		ELSE
			RETURN 50
		ENDIF
	CASE "검격", "타격", "전술"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "銃火のオラトリオ") == 4
			RETURN 0
		ELSE
			RETURN 100
		ENDIF
	CASEELSE
		RETURN 100
ENDSELECT

@ZENZERO_DISC_EXPLAIN_銃火のオラトリオ
RESULTS:0 '= "基本効果:飛具耐性"
RESULTS:1 '= "２セット:飛具無効"
RESULTS:2 '= "４セット:剣撃・飛具・打撃・戦技無効"