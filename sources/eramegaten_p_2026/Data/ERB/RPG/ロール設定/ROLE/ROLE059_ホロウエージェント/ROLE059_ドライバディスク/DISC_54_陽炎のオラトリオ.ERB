@ZENZERO_DISC_NAME_54
RESULTS '= "陽炎のオラトリオ"

@ZENZERO_DISC_防御相性_陽炎のオラトリオ, L_CHARA, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TYPE
SELECTCASE L_TYPE
	CASE "화염"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "陽炎のオラトリオ") >= 2
			RETURN 0
		ELSE
			RETURN 50
		ENDIF
	CASE "빙결", "전격", "충격"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "陽炎のオラトリオ") == 4
			RETURN 0
		ELSE
			RETURN 100
		ENDIF
	CASEELSE
		RETURN 100
ENDSELECT

@ZENZERO_DISC_EXPLAIN_陽炎のオラトリオ
RESULTS:0 '= "基本効果:火炎耐性"
RESULTS:1 '= "２セット:火炎無効"
RESULTS:2 '= "４セット:火炎・氷結・電撃・衝撃無効"