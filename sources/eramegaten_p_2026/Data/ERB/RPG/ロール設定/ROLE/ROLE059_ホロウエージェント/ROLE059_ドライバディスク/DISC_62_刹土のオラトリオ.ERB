@ZENZERO_DISC_NAME_62
RESULTS '= "刹土のオラトリオ"

@ZENZERO_DISC_防御相性_刹土のオラトリオ, L_CHARA, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TYPE
SELECTCASE L_TYPE
	CASE "지변"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "刹土のオラトリオ") >= 2
			RETURN 0
		ELSE
			RETURN 50
		ENDIF
	CASE "화염", "질풍", "수격"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "刹土のオラトリオ") == 4
			RETURN 0
		ELSE
			RETURN 100
		ENDIF
	CASEELSE
		RETURN 100
ENDSELECT

@ZENZERO_DISC_EXPLAIN_刹土のオラトリオ
RESULTS:0 '= "基本効果:地変耐性"
RESULTS:1 '= "２セット:地変無効"
RESULTS:2 '= "４セット:火炎・地変・水撃・疾風無効"