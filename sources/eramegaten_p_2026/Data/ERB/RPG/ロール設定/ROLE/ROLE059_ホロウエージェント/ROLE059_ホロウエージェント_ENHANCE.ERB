@ROLE_ENHANCE_ホロウエージェント, L_NO, L_CHARA, SELECT_TRANS
#DIM DYNAMIC L_NO
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC SELECT_TRANS
SELECTCASE L_NO
	CASE 0
		RESULTS '= "音動機改造"
		RETURN 1
	CASE 1
		RESULTS '= "ドライバディスク設定"
		RETURN 1
	CASEELSE
ENDSELECT

@ENHANCE_ホロウエージェント_音動機改造, L_CHARA, SELECT_TRANS
#DIM DYNAMIC L_NO
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC LCOUNT,2
#DIMS DYNAMIC SHOWLINE
#DIMS DYNAMIC TEMPS,2
#DIMS DYNAMIC SELECT_TRANS
#DIMS CONST CATEGORY_TABLE = "通常スキル", "特殊スキル", "支援スキル", "回避スキル"
#DIM DYNAMIC SELECT_CATEGORY = 0
#DIMS DYNAMIC SKILL_LIST, 20
#DIM DYNAMIC LINE, 3
#DIMS DYNAMIC L_SKILLS
#DIM DYNAMIC NEED_COST, 16
#DIM DYNAMIC MAX_RANK
#DIM DYNAMIC SELECT_RANK
#DIM DYNAMIC INPUT_ABLE, 1000
#DIMS DYNAMIC L_COLOR
LINE = LINECOUNT
MAX_RANK = LIMIT(BASE:L_CHARA:LV / 5 + 2, 1, 15)
;初期レベルのセット
CALL SET_ROLE_CFLAG_TAKEOVER, L_CHARA, "通常スキル" + "ランク", MAX(GET_ROLE_CFLAG_TAKEOVER(L_CHARA, "通常スキル" + "ランク"),1)
CALL SET_ROLE_CFLAG_TAKEOVER, L_CHARA, "特殊スキル" + "ランク", MAX(GET_ROLE_CFLAG_TAKEOVER(L_CHARA, "特殊スキル" + "ランク"),1)
CALL SET_ROLE_CFLAG_TAKEOVER, L_CHARA, "支援スキル" + "ランク", MAX(GET_ROLE_CFLAG_TAKEOVER(L_CHARA, "支援スキル" + "ランク"),1)
CALL SET_ROLE_CFLAG_TAKEOVER, L_CHARA, "回避スキル" + "ランク", MAX(GET_ROLE_CFLAG_TAKEOVER(L_CHARA, "回避スキル" + "ランク"),1)
SELECT_RANK = GET_ROLE_CFLAG_TAKEOVER(L_CHARA, "通常スキル" + "ランク")
$START
CLEARLINE LINECOUNT - LINE
CALL MAG_ENHANCE_INFO_CHARA, L_CHARA
SHOWLINE '= ""
FOR LCOUNT, 0, VARSIZE("CATEGORY_TABLE")
	IF LCOUNT == SELECT_CATEGORY
		L_COLOR '= "p-green"
	ELSE
		L_COLOR '= "default"
	ENDIF
	TEMPS '= @"[{LCOUNT + 1}] %CATEGORY_TABLE:LCOUNT%(Rank:{GET_ROLE_CFLAG_TAKEOVER(L_CHARA, CATEGORY_TABLE:LCOUNT + "ランク"),2})"
	TEMPS '= SET_COLOR_TAG(TEMPS, L_COLOR)
	TEMPS '= SET_BUTTON_TAG(TEMPS, TOSTR(LCOUNT + 1))
	SHOWLINE += TEMPS + "　　　　　"
	INPUT_ABLE:(LCOUNT + 1) = 1
NEXT
HTML_PRINT SHOWLINE
;---- EDIT 025 ADD END ---------------------------
DRAWLINE
VARI LINE_SHOWMAIN = LINECOUNT
;所持スキルを登録
VARSET SKILL_LIST
FOR LCOUNT, 0, CHARA_SKILLCOUNT(L_CHARA)
	SIF !ABL:L_CHARA:("스킬" + TOSTR(LCOUNT + 1))
		CONTINUE
	SKILL_LIST:FINDELEMENT(SKILL_LIST, "", , , 1) '= CONVERT_SKILLNUM_TO_STR(L_CHARA, ABL:L_CHARA:("스킬" + TOSTR(LCOUNT + 1)))
	RESULT = 0
NEXT
FOR LCOUNT, 0, STRCOUNT(C_LEARNED_SKILLS:L_CHARA:0, "/") + 1
	L_SKILLS = %AUTO_SPLIT(C_LEARNED_SKILLS:L_CHARA:0, "/", LCOUNT)%
	SIF L_SKILLS == ""
		CONTINUE
	SIF MATCH(SKILL_LIST, L_SKILLS)
		CONTINUE
	SKILL_LIST:FINDELEMENT(SKILL_LIST, "", , , 1) = %L_SKILLS%
NEXT
VARI NOW_RANK

SHOWLINE '= "<div xpos = '0' ypos = '0'>"
NOW_RANK = GET_ROLE_CFLAG_TAKEOVER(L_CHARA, CATEGORY_TABLE:SELECT_CATEGORY + "ランク")
FOR LCOUNT, 1, 16
	IF LCOUNT > MAX_RANK
		NEED_COST = -1
		CONTINUE
	ELSE
		NEED_COST:LCOUNT = MAX(0, POWER(LCOUNT, 3) - POWER(NOW_RANK, 3)) * 4 * 200
	ENDIF
	IF SELECT_RANK == LCOUNT
		L_COLOR '= "yellow"
	ELSEIF NOW_RANK == LCOUNT
		L_COLOR '= "p-green"
	ELSEIF NEED_COST:LCOUNT > GET_CHARA_STOCK_MAG(L_CHARA)
		L_COLOR '= "gray"
	ELSE
		L_COLOR '= "default"
		INPUT_ABLE:(LCOUNT + 10) = 1
		INPUT_ABLE:(LCOUNT + 910) = 1
	ENDIF
	TEMPS '= @"[{LCOUNT + 10}] RANK:{LCOUNT,2}　　　必要ＭＡＧ:{NEED_COST:LCOUNT, 8}"
	TEMPS '= SET_COLOR_TAG(TEMPS, L_COLOR)
	TEMPS '= SET_BUTTON_TAG(TEMPS, TOSTR(LCOUNT + 910))
	SIF LCOUNT > 1
		SHOWLINE += "<br>"
	SHOWLINE += TEMPS
NEXT
SHOWLINE += "</div>"
SHOWLINE += "<div xpos = '2000' ypos = '-50'>"
FOR LCOUNT, LINE_SHOWMAIN, MAG_ENHANCE_LINE - 5
	SIF LCOUNT > LINE_SHOWMAIN
		SHOWLINE += "<br>"
	SHOWLINE += "│"
NEXT
SHOWLINE += "</div>"
LCOUNT = -1, 0
DO 
	LCOUNT++
	CALL GETS_SKILL_PROP, "SKILL_TAG", SKILL_LIST:LCOUNT, L_CHARA
	SELECTCASE CATEGORY_TABLE:SELECT_CATEGORY
		CASE "通常スキル"
			SIF !GROUPMATCH(RESULTS, "ゼンゼロ通常スキル")
				CONTINUE
		CASE "特殊スキル"
			SIF !GROUPMATCH(RESULTS, "ゼンゼロ特殊スキル")
				CONTINUE
		CASE "支援スキル"
			SIF !GROUPMATCH(RESULTS, "ゼンゼロパリィ支援突撃", "ゼンゼロ回避支援突撃")
				CONTINUE
		CASE "回避スキル"
			SIF !GROUPMATCH(RESULTS, "ゼンゼロ回避反撃スキル", "ゼンゼロダッシュスキル")
				CONTINUE
	ENDSELECT
	CALL GETS_SKILL_PROP, "SKILL_NAME", SKILL_LIST:LCOUNT, L_CHARA
	TEMPS:1 '= RESULTS + "<br>"
	IF SELECT_RANK == NOW_RANK
		CALLFORM GET_SKILL_POWER_%SKILL_LIST:LCOUNT%, SELECT_RANK
		TEMPS '= @"威力:{RESULT ,3}"
		TEMPS += " " * 6 + " " * 4
		IF EXISTFUNCTION("GET_SKILL_COST" + SKILL_LIST:LCOUNT)
			CALLFORM GET_SKILL_COST_%SKILL_LIST:LCOUNT%, NOW_RANK
			TEMPS += @"消費ＭＰ:{RESULT ,2}"
		ENDIF
	ELSE
		CALLFORM GET_SKILL_POWER_%SKILL_LIST:LCOUNT%, NOW_RANK
		TEMPS '= @"威力:{RESULT ,3}"
		CALLFORM GET_SKILL_POWER_%SKILL_LIST:LCOUNT%, SELECT_RANK
		TEMPS += @" → {RESULT ,3}"
		TEMPS += " " * 4
		IF EXISTFUNCTION("GET_SKILL_COST" + SKILL_LIST:LCOUNT)
			CALLFORM GET_SKILL_COST_%SKILL_LIST:LCOUNT%, NOW_RANK
			TEMPS += @"消費ＭＰ:{RESULT ,2}"
			CALLFORM GET_SKILL_COST_%SKILL_LIST:LCOUNT%, SELECT_RANK
			TEMPS += @" → {RESULT ,2}"
		ENDIF
		TEMPS '= SET_COLOR_TAG(TEMPS, "aqua")
	ENDIF
	TEMPS:1 += TEMPS + "<br>"
	CALLFORM ENHANCE_SKILL_EXPLAIN_%SKILL_LIST:LCOUNT%, L_CHARA
	TEMPS:1 += RESULTS
	SHOWLINE += @"<div xpos = '2100' ypos = '{LCOUNT:1 * 700}' padding = '50' border_width = '2px' height = '600' width = '4500'>" + TEMPS:1 + "</div>"
	LCOUNT:1++
LOOP SKILL_LIST:LCOUNT != ""
HTML_PRINT SHOWLINE

IF MAG_ENHANCE_LINE < 0
	LINE:2 = LINECOUNT
ELSE
	CALL PRINT_SPACE_ENHANCE
ENDIF
CLEARLINE 6
DRAWLINE
PRINTL W-엔진을 개조하여 대응하는 스킬의 랭크를 변경할 수 있습니다。
PRINTL 각 스킬은 랭크에 따라 위력과 소비 코스트가 변화합니다。
PRINTL 또한、개조의 상한 랭크는 W-엔진 소유자의 레벨에 따라 결정됩니다。
PRINTL 
PRINTL 
DRAWLINE
INPUT_ABLE:0 = 1
INPUT_ABLE:9 = 1

TEMPS '= SET_BUTTON_TAG("[9] 개조한다", "9")
IF SELECT_RANK == NOW_RANK
	INPUT_ABLE:9 = 0
	TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
ELSE
	INPUT_ABLE:9 = 1
ENDIF
HTML_PRINT SET_BUTTON_TAG("[0] 돌아간다", "0") + "　　　　" + TEMPS
CALL INPUT_ARRAY, INPUT_ABLE
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 1 TO VARSIZE("CATEGORY_TABLE") + 1
		SELECT_CATEGORY = RESULT - 1
		SELECT_RANK = GET_ROLE_CFLAG_TAKEOVER(L_CHARA, CATEGORY_TABLE:SELECT_CATEGORY + "ランク")
	CASE 9, 11 TO 26, 911 TO 926
		CLEARLINE 1
		VARI L_RANK = (RESULT % 900) - 10
		VARI IS_CLICK = RESULT > 900
		IF (RESULT == 9 || (SELECT_RANK == RESULT - 910)) && SELECT_RANK != NOW_RANK
			IF RESULT != 9
				IF NEED_COST:SELECT_RANK > 0
					TEMPS = W-엔진을 {NEED_COST:SELECT_RANK} ＭＡＧ 소비하여、개조하시겠습니까？
				ELSE
					TEMPS = W-엔진을 개조하시겠습니까？
				ENDIF
				CALL INPUT_YN_POPUP, "예", "아니오", TEMPS
			ENDIF
			IF RESULT == 0 || !IS_CLICK
				CALL CONTROL_MAG, L_CHARA, -NEED_COST:SELECT_RANK
				CALL SET_ROLE_CFLAG_TAKEOVER, L_CHARA, CATEGORY_TABLE:SELECT_CATEGORY + "ランク", SELECT_RANK
				IF !IS_CLICK
					CLEARLINE 8
					DRAWLINE
					PRINTL W-엔진을 개조했습니다。
					PRINTL 
					PRINTL 
					PRINTL 
					PRINTL 
					DRAWLINE
					PRINTL [0] 돌아간다　　　　[9] 개조한다
					WAIT
				ENDIF
			ENDIF
		ELSE
			SELECT_RANK = L_RANK
		ENDIF
ENDSELECT
GOTO START


@ENHANCE_ホロウエージェント_ドライバディスク設定, L_CHARA, SELECT_TRANS
#DIM DYNAMIC L_NUM
#DIMS DYNAMIC L_NAME, 12
#DIM DYNAMIC L_STAT, 12, 6
#DIM DYNAMIC L_SKILL, 12
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC IS_DISC_CHOICE
#DIMS DYNAMIC SELECT_TRANS
#DIM DYNAMIC LCOUNT,2
#DIMS DYNAMIC SHOWLINE
#DIMS DYNAMIC LASTLINE
#DIMS DYNAMIC TEMPS,2
#DIM DYNAMIC LINE, 3
#DIM DYNAMIC INPUT_ABLE, 1000
#DIMS DYNAMIC L_COLOR
#DIM DYNAMIC NEED_STAT_ENHANCE_MAG
#DIM DYNAMIC NEED_LOTTERY_MAG
#DIM DYNAMIC L_SELECT, 2
LINE = LINECOUNT
;最低値を取っておく
CFLAG:L_CHARA:능력강화횟수 = MAX(CFLAG:L_CHARA:능력강화횟수, 4)

FOR LCOUNT, 0, 4
	L_NAME:LCOUNT '= C_ZENZERO_DISC_NAME:L_CHARA:LCOUNT
	L_SKILL:LCOUNT = C_ZENZERO_DISC_SKILL:L_CHARA:LCOUNT
	FOR LCOUNT:1, 0, 6
		L_STAT:LCOUNT:(LCOUNT:1) = C_ZENZERO_DISC_STAT:L_CHARA:LCOUNT:(LCOUNT:1)
	NEXT
NEXT

;初期レベルのセット
$START
VARSET INPUT_ABLE
NEED_STAT_ENHANCE_MAG = MAG_CALC_ENHANCE_BASE(L_CHARA, CFLAG:L_CHARA:능력강화횟수 + 4)
NEED_LOTTERY_MAG = LIMIT(POWER(CFLAG:L_CHARA:능력강화횟수 / 4, 2) * 11 + 100, 100, 10000)
FOR LCOUNT, 1, 7
	CFLAG:L_CHARA:(GET_BASESTATUS(LCOUNT) + "강화횟수") = 0
	FOR LCOUNT:1, 0, 4
		CFLAG:L_CHARA:(GET_BASESTATUS(LCOUNT) + "강화횟수") += C_ZENZERO_DISC_STAT:L_CHARA:(LCOUNT:1):(LCOUNT - 1)
	NEXT
NEXT
CLEARLINE LINECOUNT - LINE
CALL MAG_ENHANCE_INFO_CHARA, L_CHARA
SHOWLINE '= @" 生成ランク:{(CFLAG:L_CHARA:능력강화횟수 / 4)}" + "　　　　　　"
TEMPS '= SET_BUTTON_TAG("[1] ランク強化", "901")
IF GET_CHARA_STOCK_MAG(L_CHARA) >= NEED_STAT_ENHANCE_MAG && IS_DISC_CHOICE == 0
	INPUT_ABLE:1 = 1
	INPUT_ABLE:901 = 1
ELSE
	TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
ENDIF
SHOWLINE += TEMPS
SHOWLINE += @"　　<必要ＭＡＧ:{NEED_STAT_ENHANCE_MAG}>"
HTML_PRINT SHOWLINE
DRAWLINE
VARI LINE_SHOWMAIN = LINECOUNT
VARSET SHOWLINE

FOR LCOUNT, 0, 4
	IF L_SELECT == LCOUNT && IS_DISC_CHOICE
		L_COLOR '= "yellow"
	ELSE
		L_COLOR '= "default"
	ENDIF
	CALL MAKE_ZENZERO_DISK_BANNER, LCOUNT, L_NAME, L_STAT, L_SKILL, L_COLOR
	SHOWLINE += @"<div xpos = '50' ypos = '{LCOUNT * 750}'>" + RESULTS + "</div>"
	INPUT_ABLE:(LCOUNT + 10) = IS_DISC_CHOICE
NEXT

IF IS_DISC_CHOICE
	FOR LCOUNT:1, 1, 3
		FOR LCOUNT, 0, 4
			L_NUM = LCOUNT:1 * 4 + LCOUNT
			IF L_SELECT == L_NUM
				L_COLOR '= "yellow"
			ELSE
				L_COLOR '= "default"
			ENDIF
			CALL MAKE_ZENZERO_DISK_BANNER, L_NUM, L_NAME, L_STAT, L_SKILL, L_COLOR
			SHOWLINE += @"<div xpos = '{50 + 50 + 2150 * LCOUNT:1}' ypos = '{LCOUNT * 750}'>" + RESULTS + "</div>"
			INPUT_ABLE:(L_NUM + 10) = 1
		NEXT
	NEXT
ENDIF
SHOWLINE += "</div>"
SHOWLINE += "<div xpos = '2150' ypos = '-50'>"
FOR LCOUNT, LINE_SHOWMAIN, MAG_ENHANCE_LINE - 2
	SIF LCOUNT > LINE_SHOWMAIN
		SHOWLINE += "<br>"
	SHOWLINE += "│"
NEXT

SHOWLINE += "</div>"
HTML_PRINT SHOWLINE
IF MAG_ENHANCE_LINE < 0
	LINE:2 = LINECOUNT
ELSE
	CALL PRINT_SPACE_ENHANCE
ENDIF
CLEARLINE 3
DRAWLINE
IF IS_DISC_CHOICE
	PRINTL 왼쪽 4개가 장비품으로 남는 드라이브 디스크가 됩니다。
	PRINTL 드라이브 디스크는 같은 것을 복수 세트하여 세트 효과를 얻을 수 있습니다。
ELSE
	PRINTL 드라이브 디스크를 생성하여 캐릭터를 강화할 수 있습니다。
	PRINTL 드라이브 디스크에 세트되는 추가 스탯 및 추가 스킬은 생성 랭크에 따라 결정됩니다。
ENDIF
DRAWLINE
INPUT_ABLE:0 = 1
IF IS_DISC_CHOICE
	LASTLINE '= SET_BUTTON_TAG("[0] 확정", "0") 
ELSE
	LASTLINE '= SET_BUTTON_TAG("[0] 돌아간다", "0") 
ENDIF
TEMPS '= SET_BUTTON_TAG("[2] 디스크 생성", "2")
TEMPS += " " + @"<필요ＭＡＧ:{NEED_LOTTERY_MAG}>"
IF GET_CHARA_STOCK_MAG(L_CHARA) < NEED_LOTTERY_MAG
	INPUT_ABLE:2 = 0
	TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
ELSE
	INPUT_ABLE:2 = 1
ENDIF
LASTLINE += "　　　　　　　" + TEMPS 
TEMPS '= SET_BUTTON_TAG("[3] 디스크 생성 8연속", "3")
TEMPS += " " + @"<필요ＭＡＧ:{NEED_LOTTERY_MAG * 8}>"
IF GET_CHARA_STOCK_MAG(L_CHARA) < NEED_LOTTERY_MAG * 8
	INPUT_ABLE:3 = 0
	TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
ELSE
	INPUT_ABLE:3 = 1
ENDIF
LASTLINE += "　　　　　　　" + TEMPS
HTML_PRINT LASTLINE
CALL INPUT_ARRAY, INPUT_ABLE
CLEARLINE 1
VARI IS_CLICK = RESULT > 900
RESULT %= 900
SELECTCASE RESULT
	CASE 0
		IF IS_DISC_CHOICE
			IS_DISC_CHOICE = 0
			IF IS_CLICK
				CALL INPUT_YN_POPUP, "예", "아니오", "남은 드라이브 디스크를 폐기하고 생성을 종료하시겠습니까？"
				IF RESULT == 0
					HTML_PRINT_ISLAND  @"<div xpos = '0' ypos = '0' width = '{CLIENTWIDTH()}px' height = '{CLIENTHEIGHT()}px' display = 'absolute-lefttop' background_color = '%TOSTR_HTML(GETBGCOLOR())%'>" + "</div>"
					TWAIT 200, 1
					HTML_PRINT_ISLAND_CLEAR
				ENDIF
			ENDIF
		ELSE
			RETURN 0
		ENDIF
	CASE 1
		IF IS_CLICK
			CALL INPUT_YN_POPUP, "예", "아니오", "정말로 드라이브 디스크의 랭크를 상승시키겠습니까？"
		ELSE
			RESULT = 0
		ENDIF
		IF RESULT == 0
			CALL CONTROL_MAG, L_CHARA, -NEED_STAT_ENHANCE_MAG
			CFLAG:L_CHARA:능력강화횟수 += 4
			IF !IS_CLICK
				CLEARLINE 5
				DRAWLINE
				PRINTL 드라이브 디스크의 랭크가 상승했습니다。
				PRINTL 
				DRAWLINE
				HTML_PRINT LASTLINE
				WAIT
			ENDIF
		ENDIF
	CASE 2, 3
		HTML_PRINT_ISLAND  @"<div xpos = '0' ypos = '0' width = '{CLIENTWIDTH()}px' height = '{CLIENTHEIGHT()}px' display = 'absolute-lefttop' background_color = '%TOSTR_HTML(GETBGCOLOR())%'>" + "</div>"
		TWAIT 200, 1
		HTML_PRINT_ISLAND_CLEAR
		IS_DISC_CHOICE = 1
		L_SELECT = -1, -1
		IF RESULT == 2
			CALL CONTROL_MAG, L_CHARA, -NEED_LOTTERY_MAG
			CALL MAKE_ZENZERO_DISK, L_CHARA, 1, L_NAME, L_STAT, L_SKILL
		ELSE
			CALL CONTROL_MAG, L_CHARA, -NEED_LOTTERY_MAG * 8
			CALL MAKE_ZENZERO_DISK, L_CHARA, 8, L_NAME, L_STAT, L_SKILL
		ENDIF
	CASE 10 TO 22
		IF L_SELECT < 0
			L_SELECT = RESULT - 10
		ELSE
			L_SELECT:1 = RESULT - 10
			SWAP L_NAME:(L_SELECT:0), L_NAME:(L_SELECT:1)
			SWAP L_SKILL:(L_SELECT:0), L_SKILL:(L_SELECT:1)
			FOR LCOUNT, 0, 6
				SWAP L_STAT:(L_SELECT:0):LCOUNT, L_STAT:(L_SELECT:1):LCOUNT
			NEXT
			L_SELECT = -1, -1
			FOR LCOUNT, 0, 4
				C_ZENZERO_DISC_NAME:L_CHARA:LCOUNT '= L_NAME:LCOUNT
				C_ZENZERO_DISC_SKILL:L_CHARA:LCOUNT = L_SKILL:LCOUNT
				FOR LCOUNT:1, 0, 6
					C_ZENZERO_DISC_STAT:L_CHARA:LCOUNT:(LCOUNT:1) = L_STAT:LCOUNT:(LCOUNT:1)
				NEXT
			NEXT
		ENDIF
ENDSELECT
GOTO START

@MAKE_ZENZERO_DISK_BANNER, L_NUM, L_NAME, L_STAT, L_SKILL, L_COLOR
#DIM DYNAMIC LCOUNT, 2
#DIMS DYNAMIC L_RESULTS
#DIM DYNAMIC L_NUM
#DIMS REF L_NAME
#DIM REF L_STAT, 0, 0
#DIM REF L_SKILL
#DIMS DYNAMIC L_COLOR
IF L_NAME:L_NUM != ""
	L_RESULTS '= @"[{L_NUM + 10}]" + " " + L_NAME:L_NUM + "<br>"
	FOR LCOUNT, 0, 6
		SIF L_STAT:L_NUM:LCOUNT > 0
			L_RESULTS += TOALIGNMENT(GET_BASESTATUS(LCOUNT + 1), 4, "RIGHT") + "＋" + TOALIGNMENT(TOFULL(TOSTR(L_STAT:L_NUM:LCOUNT)), 8, "LEFT")
	NEXT
	L_RESULTS += "<br>"
	IF !L_SKILL:L_NUM
		L_RESULTS += "스킬　:なし"
	ELSE
		CALL GET_SKILL_PROP("SKILL_NAME", L_SKILL:L_NUM, -1)
		L_RESULTS += @"스킬　:【%RESULTS%】"
	ENDIF
	L_RESULTS += "<br>"
	CALLFORM ZENZERO_DISC_EXPLAIN_%L_NAME:L_NUM%
	L_RESULTS += RESULTS:0 + "<br>"
	L_RESULTS += RESULTS:1 + "<br>"
	L_RESULTS += RESULTS:2
ELSE
	L_RESULTS '= @"[{L_NUM + 10}] ＥＭＰＴＹ" + " " * 25 + ("<br>" + " " * 40) * 5
ENDIF
L_RESULTS '= SET_COLOR_TAG(L_RESULTS, L_COLOR)
L_RESULTS '= SET_BUTTON_TAG(L_RESULTS, TOSTR(L_NUM + 10))
L_RESULTS '= "<div xpos = '0' ypos = '0' border_width = '2px' height = '700' width = '2100' padding = '50'>" + L_RESULTS + "</div>"
RESULTS '= L_RESULTS
RETURN 1

@MAKE_ZENZERO_DISK, L_CHARA, MAKENUM, L_NAME, L_STAT, L_SKILL
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC LCOUNT, 2
#DIMS DYNAMIC L_RESULTS
#DIM DYNAMIC MAKENUM
#DIM DYNAMIC L_SKILL_TABLE, 200
#DIMS REF L_NAME
#DIM REF L_STAT, 0, 0
#DIM REF L_SKILL
#DIMS DYNAMIC L_NAME_TABLE, 200
#DIM DYNAMIC L_STAT_TABLE = 0, 1, 2, 3, 4, 5
#DIM DYNAMIC STAT_NUM
VARSET L_NAME, "", 4
FOR LCOUNT, 0, VARSIZE("L_NAME_TABLE")
	TRYCCALLFORM ZENZERO_DISC_NAME_{LCOUNT}
		L_NAME_TABLE:FINDELEMENT(L_NAME_TABLE, "", , , 1) '= RESULTS
	CATCH
	ENDCATCH
NEXT

CALL PUSH_ADD_SKILL_LIST, L_CHARA, L_SKILL_TABLE

FOR LCOUNT, 4, 4 + MAKENUM
	L_NAME:LCOUNT '= L_NAME_TABLE:(RAND:FINDELEMENT(L_NAME_TABLE, "", , , 1))
	L_SKILL:LCOUNT = L_SKILL_TABLE:(RAND:FINDELEMENT(L_SKILL_TABLE, 0))
	SELECTCASE RAND:100
		CASE IS < 25
			STAT_NUM = 1
		CASE IS < 75
			STAT_NUM = 2
		CASEELSE
			STAT_NUM = 3
	ENDSELECT
	FOR LCOUNT:1, 0, 6
		L_STAT:LCOUNT:(LCOUNT:1) = 0
	NEXT
	CALL SHUFFLE_ARRAY_INT, L_STAT_TABLE
	VARI TEMP_CNT = 0
	LCOUNT:1 = 0
	WHILE TEMP_CNT < CFLAG:L_CHARA:능력강화횟수 / 4
		L_STAT:LCOUNT:(L_STAT_TABLE:(LCOUNT:1)) += 1
		TEMP_CNT++
		SIF ++LCOUNT:1 == STAT_NUM
			LCOUNT:1 = 0
	WEND
NEXT

@PUSH_ADD_SKILL_LIST, L_CHARA, L_SKILL_TABLE
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM REF L_SKILL_TABLE
FOR LCOUNT, 0, SKILLNUM
	SIF LCOUNT == [[스킬:아이템숙련]]
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_NAME", LCOUNT, -1
	SIF RESULTS == ""
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", LCOUNT, -1
	SIF RESULT != GET_SUCCESSION_NUM("자동효과")
		CONTINUE
	CALL IS_MAKEABLE_SKILLCARD, LCOUNT
	SIF !RESULT
		CONTINUE
	CALL PUSH_ARRAY_INT, L_SKILL_TABLE, LCOUNT
NEXT
CALL PUSH_ARRAY_INT, L_SKILL_TABLE, [[스킬:디아]], [[스킬:디아라마]], [[스킬:디아라한]], [[스킬:메・디아]], [[스킬:메・디아라마]], [[스킬:메・디아라한]]
CALL PUSH_ARRAY_INT, L_SKILL_TABLE, [[스킬:파트라]], [[스킬:펨파트라]], [[스킬:암리타]], [[스킬:리캄]], [[스킬:사마리캄]]
CALL PUSH_ARRAY_INT, L_SKILL_TABLE, [[스킬:타루・카쟈]], [[스킬:마카・카쟈]], [[스킬:라쿠・카쟈]], [[스킬:스쿠・카쟈]], [[스킬:사마・카쟈]]
CALL PUSH_ARRAY_INT, L_SKILL_TABLE, [[스킬:타룬・다]], [[스킬:마칸・다]], [[스킬:라쿤・다]], [[스킬:스쿤・다]], [[스킬:사만・다]]

VARI L_RANK = LIMIT(CFLAG:L_CHARA:능력강화횟수 / 4 / 2 + 2, 3, 15)
FOR LCOUNT, FINDELEMENT(L_SKILL_TABLE, 0) - 1, -1, -1
	CALL GET_SKILL_PROP, "SKILL_RANK", L_SKILL_TABLE:LCOUNT, -1
	SIF INRANGE(RESULT, 1, L_RANK)
		CONTINUE
	ARRAYREMOVE L_SKILL_TABLE, LCOUNT, 1
NEXT
