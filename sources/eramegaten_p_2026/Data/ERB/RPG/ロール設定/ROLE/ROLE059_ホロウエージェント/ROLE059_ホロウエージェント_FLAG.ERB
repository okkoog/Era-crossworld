;--------------------------------------------------
;ロール独自変数名称定義関数
;-------------------------------------------------
@ROLE_CFLAG_NAME_ホロウエージェント, ARGS, ARG
#FUNCTIONS
SELECTCASE ARGS
	;---------------------------------------------
	;ROLE_CFLAG_EV
	;周回時にリセットされる数値型変数です
	;---------------------------------------------
	CASE "ROLE_CFLAG_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;ROLE_CSTR_EV
	;周回時にリセットされる文字列型変数です
	;---------------------------------------------
	CASE "ROLE_CSTR_EV"
		SELECTCASE ARG
			CASE 0
				RESULTS = 交代元キャラ
		ENDSELECT
	;---------------------------------------------
	;ROLE_CFLAG_TAKEOVER
	;周回時にリセットされない数値型変数です
	;---------------------------------------------
	CASE "ROLE_CFLAG_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 通常スキルランク
			CASE 1
				RESULTS = 特殊スキルランク
			CASE 2
				RESULTS = 支援スキルランク
			CASE 3
				RESULTS = 回避スキルランク
		ENDSELECT
	;---------------------------------------------
	;ROLE_CSTR_TAKEOVER
	;周回時にリセットされない文字列型変数です
	;---------------------------------------------
	CASE "ROLE_CSTR_TAKEOVER"
		SELECTCASE ARG
			CASE 0
				RESULTS = 音動機名称
		ENDSELECT
	;---------------------------------------------
	;ROLE_CSTR_BTL
	;戦闘開始毎にリセットされる数値型変数です
	;スキルゲージHとほぼ互換です。基本的にはゲージHが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "ROLE_CFLAG_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = パリィ確定相性
			CASE 1
				RESULTS = 回避確定相性
			CASE 2
				RESULTS = 突撃スキル発動者
			CASE 3
				RESULTS = 獲得デシベル値
			CASE 4
				RESULTS = 極限回避発動率
			CASE 5
				RESULTS = 極限回避発動
		ENDSELECT
	;---------------------------------------------
	;ROLE_CSTR_BTL
	;戦闘開始毎にリセットされる文字列型変数です
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "ROLE_CSTR_BTL"
		SELECTCASE ARG
			CASE 0
				RESULTS = 発動突撃スキル
		ENDSELECT
	;---------------------------------------------
	;ROLE_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる数値型変数
	;スキルゲージFとほぼ互換です。基本的にはゲージFが足りない時ようですが複数の種類のスキルから参照させる
	;というかゲージとしてつかってなくない？といった場合はこちらのほうがすっきりするかもしれません
	;--------------------------------------------
	CASE "ROLE_CFLAG_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = デシベル値
			CASE 1
				RESULTS = 
		ENDSELECT
	;---------------------------------------------
	;ROLE_CSTR_DUNGEON
	;ショップ画面に戻る度にリセットされる文字列型変数
	;文字列保存はスキル側にはないのであえて文字列をつかいたいなら
	;--------------------------------------------
	CASE "ROLE_CSTR_DUNGEON"
		SELECTCASE ARG
			CASE 0
				RESULTS = パリィ支援突撃0
			CASE 1
				RESULTS = パリィ支援突撃1
			CASE 2
				RESULTS = 回避支援突撃0
			CASE 3
				RESULTS = 回避支援突撃1
		ENDSELECT
ENDSELECT
RETURNF RESULTS

