@ZENZERO_DISC_NAME_64
RESULTS '= "風弦のオラトリオ"

@ZENZERO_DISC_防御相性_風弦のオラトリオ, L_CHARA, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TYPE
SELECTCASE L_TYPE
	CASE "질풍"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "風弦のオラトリオ") >= 2
			RETURN 0
		ELSE
			RETURN 50
		ENDIF
	CASE "화염", "지변", "수격"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "風弦のオラトリオ") == 4
			RETURN 0
		ELSE
			RETURN 100
		ENDIF
	CASEELSE
		RETURN 100
ENDSELECT

@ZENZERO_DISC_EXPLAIN_風弦のオラトリオ
RESULTS:0 '= "基本効果:疾風耐性"
RESULTS:1 '= "２セット:疾風無効"
RESULTS:2 '= "４セット:火炎・地変・水撃・疾風無効"