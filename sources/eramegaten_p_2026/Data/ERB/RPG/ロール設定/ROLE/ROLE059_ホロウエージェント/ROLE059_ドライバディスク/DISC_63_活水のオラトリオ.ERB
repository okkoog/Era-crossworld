@ZENZERO_DISC_NAME_63
RESULTS '= "活水のオラトリオ"

@ZENZERO_DISC_防御相性_活水のオラトリオ, L_CHARA, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TYPE
SELECTCASE L_TYPE
	CASE "수격"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "活水のオラトリオ") >= 2
			RETURN 0
		ELSE
			RETURN 50
		ENDIF
	CASE "화염", "지변", "질풍"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "活水のオラトリオ") == 4
			RETURN 0
		ELSE
			RETURN 100
		ENDIF
	CASEELSE
		RETURN 100
ENDSELECT

@ZENZERO_DISC_EXPLAIN_活水のオラトリオ
RESULTS:0 '= "基本効果:水撃耐性"
RESULTS:1 '= "２セット:水撃無効"
RESULTS:2 '= "４セット:火炎・地変・水撃・疾風無効"