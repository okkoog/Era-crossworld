@STATUS_WINDOW_EQUIP_ROLE_ホロウエージェント, L_CHARA, 行, 表示行数, 横幅, IS_EQUIP_CHANGE
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 行 
#DIM DYNAMIC 表示行数
#DIM DYNAMIC 横幅
#DIM DYNAMIC IS_EQUIP_CHANGE
行 += 3
CALL SET_PICTURE , @"┏%"━" * (横幅 / 2)%┓" , 行, , 表示行数
CALL SET_PICTURE , @"EQUIP " , 行 , , 表示行数 + 2
FOR LCOUNT , 1 , 6
	CALL SET_PICTURE , @"┃%" " * 横幅%┃" , 行+LCOUNT , , 表示行数
NEXT
CALL SET_PICTURE , @"┗%"━" * (横幅 / 2)%┛" , 行 + 6 , , 表示行数
CALL SET_PICTURE , "[ 音動機 ] " + GET_ROLE_CSTR_TAKEOVER(L_CHARA, "音動機名称"), 行 + 1, , 表示行数+2
FOR LCOUNT, 0, 4
	IF C_ZENZERO_DISC_NAME:L_CHARA:LCOUNT == ""
		CALL SET_PICTURE , "[ディスク] " + "ＥＭＰＴＹ", 行 + 2 + LCOUNT, , 表示行数+2
	ELSE
		CALL SET_PICTURE , "[ディスク] " + C_ZENZERO_DISC_NAME:L_CHARA:LCOUNT, 行 + 2 + LCOUNT, , 表示行数+2
	ENDIF
NEXT

@PRINT_EQUIP_ROLE_ホロウエージェント, L_CHARA, DISABLE_EQUIP_CHANGE
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC DISABLE_EQUIP_CHANGE
#DIM DYNAMIC LCOUNT
PRINTFORML [ W-엔진 ] %GET_ROLE_CSTR_TAKEOVER(L_CHARA, "音動機名称")%
FOR LCOUNT, 0, 4
	IF C_ZENZERO_DISC_NAME:L_CHARA:LCOUNT == ""
		PRINTFORML [디스크] ＥＭＰＴＹ
	ELSE
		PRINTFORML [디스크] %C_ZENZERO_DISC_NAME:L_CHARA:LCOUNT%
	ENDIF
NEXT
