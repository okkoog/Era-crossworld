ENDIF
PRINTFORMW %CALLNAME:L_CHARA%:+{L_PTS}pts <<데시벨 값>>

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_ROLE_ホロウエージェント, ARG, ARG:1
#LOCALSIZE 1
#LOCALSSIZE 1
;判定は一回
SIF ARG != ARG:1
	RETURN 0
SIF GET_ROLE_CSTR_BTL(ARG, "発動突撃スキル") == ""
	RETURN 0
RESULTS '= GET_ROLE_CSTR_BTL(ARG, "発動突撃スキル")
