@INPUT_COM_NAME_ROLE_ホロウエージェント, L_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC BUTTON_NUM
#DIMS DYNAMIC L_BUTTON, 2
BUTTON_NUM = FINDELEMENT(COMMAND_LIST_P, "", 1, , 1)
COMMAND_LIST_NAME:0 '= "シフトチェンジ_ホロウエージェント_0", "シフトチェンジ_ホロウエージェント_1"
COMMAND_LIST_SHOWNAME:0 = [-] ＳＨＩＦＴ
COMMAND_LIST_CATEGORY:0 = 2
FOR LCOUNT, 0, 2
	IF FINDCHARA_LINK(L_CHARA, LCOUNT) >= 0
		L_BUTTON:LCOUNT '= SET_BUTTON_TAG(@"[{BUTTON_NUM + LCOUNT}] " + CALLNAME:FINDCHARA_LINK(L_CHARA, LCOUNT), TOSTR(BUTTON_NUM + LCOUNT))
	ELSE
		L_BUTTON:LCOUNT '= SET_BUTTON_TAG(SET_COLOR_TAG(@"[{BUTTON_NUM + LCOUNT}] " + "ＥＭＰＴＹ", "gray"), TOSTR(BUTTON_NUM + LCOUNT))
		COMMAND_LIST_UNABLE:LCOUNT = 1
	ENDIF
	COMMAND_LIST_SHOWNAME:0 += "<br>" + "　　" + L_BUTTON:LCOUNT
NEXT
RETURN 2

@INPUT_COM_ABLE_シフトチェンジ_ホロウエージェント_0, ARG
SIF FINDCHARA_LINK(ARG, 0) < 0
	RETURN -1
RETURN 1

@INPUT_COM_シフトチェンジ_ホロウエージェント_0, ARG
CALL SHIFT_CHANGE_ホロウエージェント, ARG, 0
RETURN -2, RESULT:1

@INPUT_COM_シフトチェンジ_ホロウエージェント_1, ARG
CALL SHIFT_CHANGE_ホロウエージェント, ARG, 1
RETURN -2, RESULT:1

@SHIFT_CHANGE_ホロウエージェント, L_CHARA, L_CHANGE_CHARANO
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_CHANGE_CHARANO
#DIM DYNAMIC L_CHARA_CHANGED, 3
SIF FINDCHARA_LINK(L_CHARA, L_CHANGE_CHARANO) < 0
	RETURN 0

L_CHARA_CHANGED:0 = FINDCHARA_LINK(L_CHARA, L_CHANGE_CHARANO)
IF L_CHANGE_CHARANO == 0
	L_CHARA_CHANGED:1 = L_CHARA
	L_CHARA_CHANGED:2 = FINDCHARA_LINK(L_CHARA, 1)
ELSE
	L_CHARA_CHANGED:1 = FINDCHARA_LINK(L_CHARA, 0)
	L_CHARA_CHANGED:2 = L_CHARA
ENDIF

FOR LCOUNT, 0, 3
	SIF L_CHARA_CHANGED:LCOUNT < 0
		CONTINUE
	CALL REMOVE_LINK_DEVIL, L_CHARA_CHANGED:LCOUNT
	CALL SET_ROLE_CSTR_EV, L_CHARA_CHANGED:LCOUNT, "交代元キャラ", ""
NEXT

FOR LCOUNT, 0, 2
	IF L_CHARA_CHANGED:(LCOUNT + 1) >= 0
		CFLAG:(L_CHARA_CHANGED:0):@"링크캐릭터실제가입시간{LCOUNT}" = CFLAG:(L_CHARA_CHANGED:(LCOUNT + 1)):실제가입시간
		CFLAG:(L_CHARA_CHANGED:(LCOUNT + 1)):피링크캐릭터실제가입시간 = CFLAG:(L_CHARA_CHANGED:0):실제가입시간
	ENDIF
NEXT
IF MATCH(BCHARA, L_CHARA_CHANGED:0) == 0
	BCHARA:BCHARANUM = L_CHARA_CHANGED:0
	BCHARANUM += 1
ENDIF
VARI STOCK_POS
STOCK_POS = CPOS(L_CHARA)

;強化を引き写す
FOR LCOUNT, 0, VARSIZE("KAJA_TABLE")
	CFLAG:(L_CHARA_CHANGED:0):(KAJA_TABLE:LCOUNT + "강화") = CFLAG:L_CHARA:(KAJA_TABLE:LCOUNT + "강화")
NEXT

BASE:(L_CHARA_CHANGED:0):ＨＰ = MAXBASE:(L_CHARA_CHANGED:0):ＨＰ * BASE:L_CHARA:ＨＰ / MAXBASE:L_CHARA:ＨＰ
;端数補填
SIF (MAXBASE:(L_CHARA_CHANGED:0):ＨＰ * BASE:L_CHARA:ＨＰ) % MAXBASE:L_CHARA:ＨＰ
	BASE:(L_CHARA_CHANGED:0):ＨＰ = MIN(BASE:(L_CHARA_CHANGED:0):ＨＰ + 1, MAXBASE:(L_CHARA_CHANGED:0):ＨＰ)

;HPを同期する
;小数点以下を扱えない関係でそのままやると切り捨てが凄まじいことになるケースがあるので桁数を増やす
MAXBASE:(L_CHARA_CHANGED:0):ＨＰ *= POWER(10, 5)
VARI TEMP = (MAXBASE:(L_CHARA_CHANGED:0):ＨＰ * BASE:L_CHARA:ＨＰ % MAXBASE:L_CHARA:ＨＰ) > 0
BASE:(L_CHARA_CHANGED:0):ＨＰ = MAXBASE:(L_CHARA_CHANGED:0):ＨＰ * BASE:L_CHARA:ＨＰ / MAXBASE:L_CHARA:ＨＰ
BASE:(L_CHARA_CHANGED:0):ＨＰ /= POWER(10, 5)
MAXBASE:(L_CHARA_CHANGED:0):ＨＰ /= POWER(10, 5)
BASE:(L_CHARA_CHANGED:0):ＨＰ += TEMP

CALL REMOVE_POSITION, CPOS(L_CHARA)
CALL INSERT_POSITION, STOCK_POS, L_CHARA_CHANGED:0

HTML_PRINT_ISLAND  @"<div xpos = '0' ypos = '0' width = '{CLIENTWIDTH()}px' height = '{CLIENTHEIGHT()}px' display = 'absolute-lefttop' background_color = '%TOSTR_HTML(GETBGCOLOR())%'>" + "</div>"
TWAIT 200, 1
HTML_PRINT_ISLAND_CLEAR

CALL SET_ROLE_CSTR_EV, L_CHARA_CHANGED:0, "交代元キャラ", NICKNAME:L_CHARA
RETURN 1, L_CHARA_CHANGED:0

@LINKED_HP_ROLE_ホロウエージェント, L_CHARA
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_LEADER
IF CFLAG:L_CHARA:피링크캐릭터실제가입시간
	L_LEADER = FINDCHARA_TIMEID(CFLAG:L_CHARA:피링크캐릭터실제가입시간)
ELSE
	L_LEADER = L_CHARA
ENDIF
RETURN L_LEADER, FINDCHARA_LINK(L_LEADER, 0), FINDCHARA_LINK(L_LEADER, 1)

@ADD_SKILL_ROLE_ホロウエージェント, L_CHARA, L_SKILL_COUNT, TEMP_SKILL_LIST
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC LCOUNT
#DIM REF L_SKILL_COUNT
#DIM REF TEMP_SKILL_LIST
FOR LCOUNT, 0, 4
	SIF MATCH(TEMP_SKILL_LIST, C_ZENZERO_DISC_SKILL:L_CHARA:LCOUNT)
		CONTINUE
	ABL:L_CHARA:@"장비스킬{L_SKILL_COUNT+1}" = C_ZENZERO_DISC_SKILL:L_CHARA:LCOUNT
	CALL PUSH_ARRAY_INT, TEMP_SKILL_LIST, C_ZENZERO_DISC_SKILL:L_CHARA:LCOUNT
	L_SKILL_COUNT++
NEXT
RETURN 1

@SYNC_STAUS_ADD_ROLE_ホロウエージェント, L_CHARA
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_LINK_CHARA
#DIM DYNAMIC LCOUNT,2
#DIM DYNAMIC L_SKILL
#DIM DYNAMIC TEMP_PARRY_ATTACK_RANK
#DIM DYNAMIC TEMP_AVOID_ATTACK_RANK
VARSET C_ZENZERO_PARRY_RATE:L_CHARA:0:0
VARSET C_ZENZERO_PARRY_RATE:L_CHARA:1:0
CALL SET_ROLE_CSTR_DUNGEON, L_CHARA:0, "パリィ支援突撃0", ""
CALL SET_ROLE_CSTR_DUNGEON, L_CHARA:0, "パリィ支援突撃1", ""
CALL SET_ROLE_CSTR_DUNGEON, L_CHARA:0, "回避支援突撃0", ""
CALL SET_ROLE_CSTR_DUNGEON, L_CHARA:0, "回避支援突撃1", ""
FOR LCOUNT, 0, 2
	L_LINK_CHARA = FINDCHARA_LINK(L_CHARA, LCOUNT)
	SIF L_LINK_CHARA < 0
		CONTINUE
	FOR LCOUNT:1, 1, CHARA_SKILLCOUNT(L_LINK_CHARA) + 1
		L_SKILL = ABL:L_LINK_CHARA:@"스킬{LCOUNT:1}"
		SIF L_SKILL == 0
			CONTINUE
		CALL GET_SKILL_PROP, "SKILL_TAG", L_SKILL, L_LINK_CHARA
		SELECTCASE RESULTS
			CASE "ゼンゼロパリィ支援"
				TRYCALLFORM SKILL_ZENZERO_PARRY_RATE_%CONVERT_SKILLNUM_TO_STR(L_LINK_CHARA, L_SKILL)%, L_LINK_CHARA, L_CHARA, LCOUNT
			CASE "ゼンゼロパリィ支援突撃"
				TRYCCALLFORM SKILL_ZENZERO_PARRY_ATTACK_%CONVERT_SKILLNUM_TO_STR(L_LINK_CHARA, L_SKILL)%
					IF TEMP_PARRY_ATTACK_RANK < RESULT
						TEMP_PARRY_ATTACK_RANK = RESULT
						CALL SET_ROLE_CSTR_DUNGEON, L_CHARA, @"パリィ支援突撃{LCOUNT}", CONVERT_SKILLNUM_TO_STR(L_LINK_CHARA, L_SKILL)
					ENDIF
				CATCH
				ENDCATCH
			CASE "ゼンゼロ回避支援突撃"
				TRYCCALLFORM SKILL_ZENZERO_AVOID_ATTACK_%CONVERT_SKILLNUM_TO_STR(L_LINK_CHARA, L_SKILL)%
					IF TEMP_AVOID_ATTACK_RANK < RESULT
						TEMP_AVOID_ATTACK_RANK = RESULT
						CALL SET_ROLE_CSTR_DUNGEON, L_CHARA, @"回避支援突撃{LCOUNT}", CONVERT_SKILLNUM_TO_STR(L_LINK_CHARA, L_SKILL)
					ENDIF
				CATCH
				ENDCATCH
		ENDSELECT
	NEXT
	VARI L_TYPE
	VARI L_POWER
	SELECTCASE MATCH(C_ZENZERO_DISC_NAME:L_LINK_CHARA:0, "プロト・パンク")
		CASE 4
			L_POWER = 25
		CASE 2, 3
			L_POWER = 15
		CASE 1
			L_POWER = 5
		CASEELSE
			L_POWER = 0
	ENDSELECT
	FOR L_TYPE, 0, TYPENUM
		SIF C_ZENZERO_PARRY_RATE:L_CHARA:LCOUNT:L_TYPE > 0
			C_ZENZERO_PARRY_RATE:L_CHARA:LCOUNT:L_TYPE += L_POWER
	NEXT
NEXT
CALL SET_AVOID_POWER_ホロウエージェント, L_CHARA
RETURN 1


