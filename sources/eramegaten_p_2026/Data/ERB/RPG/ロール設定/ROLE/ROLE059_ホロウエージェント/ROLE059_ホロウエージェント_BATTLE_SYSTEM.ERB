@SKILL_EX_DISPLAY_ROLE_ホロウエージェント, ARG, ARGS
SIF HAVE_PU_SKILL(ARG, "塵も積もれば")
	RETURN 0
SIF HAVE_PU_SKILL(ARG, "月下遊猟")
	RETURN 0
RESULTS = 特:{GET_ROLE_CFLAG_DUNGEON(ARG,"デシベル値")}pts
RESULTS:1 = デシベル値
