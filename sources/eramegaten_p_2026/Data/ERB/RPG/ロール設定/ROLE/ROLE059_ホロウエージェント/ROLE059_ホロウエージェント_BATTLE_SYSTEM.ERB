@SKILLGAGE_CHARGE_ROLE_ホロウエージェント, L_CHARA, L_ACTOR
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_ACTOR
#DIMS DYNAMIC L_SKILL
#DIM DYNAMIC L_GP
;ゲージが上限に到達している場合は離脱
SIF GET_ROLE_CFLAG_DUNGEON(L_CHARA,"デシベル値") == 3000
	RETURN 0
;自分の行動の場合
IF L_CHARA == L_ACTOR
	L_SKILL '= CONVERT_SKILLNUM_TO_STR(L_CHARA, CFLAG:L_CHARA:입력행동)
	TRYCCALLFORM BASE_DECIBEL_PTS_%L_SKILL%, L_CHARA
		L_GP = RESULT
	CATCH
		L_GP = 100
	ENDCATCH
	;공격
	IF GET_CREC_ACT_SUM(L_CHARA, "적", "ATTACK")
		SIF !GET_CREC_ACT_SUM(L_CHARA, "적", "HIT")
			RETURN 0
		SIF GET_CREC_ACT_SUM(L_CHARA, "적", "WEAK")
			TIMES L_GP, 1.5
		SIF GET_CREC_ACT_SUM(L_CHARA, "적", "CRIT")
			TIMES L_GP, 1.5
	ENDIF
ELSE
	SIF GET_ROLE_CFLAG_BTL(L_CHARA, "パリィ確定相性") >= 0
		L_GP = 300
ENDIF
SELECTCASE MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "ショックスター・ディスコ")
	CASE 4
		TIMES L_GP, 2.50
	CASE 2,3
		TIMES L_GP, 1.75
	CASE 1
		TIMES L_GP, 1.25
ENDSELECT
SIF !L_GP
	RETURN 0
CALL ADD_DECIBEL_PTS, L_CHARA, L_GP
IF GET_ROLE_CFLAG_DUNGEON(L_CHARA,"デシベル値") == 3000
	RESULTS = ＭＡＸＩＭＵＭ
	RESULT:1 = COLOR("黄色")
ELSE
	RESULTS = デシベル値
	RESULTS:1 = pts
ENDIF
RETURN L_GP

@ADD_DECIBEL_PTS, L_CHARA, L_PTS
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_LEADER
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_PTS
#DIM DYNAMIC L_DECIBEL
#DIM DYNAMIC STOCK_PTS
;リーダーに入れた後、各メンバーに同期させる
IF CFLAG:L_CHARA:피링크캐릭터실제가입시간
	L_LEADER = FINDCHARA_TIMEID(CFLAG:L_CHARA:피링크캐릭터실제가입시간)
ELSE
	L_LEADER = L_CHARA
ENDIF
STOCK_PTS = GET_ROLE_CFLAG_DUNGEON(L_LEADER, "デシベル値")
L_DECIBEL = LIMIT(GET_ROLE_CFLAG_DUNGEON(L_LEADER, "デシベル値") + L_PTS, 0, 3000)
CALL SET_ROLE_CFLAG_DUNGEON, L_LEADER, "デシベル値", L_DECIBEL
FOR LCOUNT, 0, 2
	SIF FINDCHARA_LINK(L_LEADER, LCOUNT) < 0
		CONTINUE
	CALL SET_ROLE_CFLAG_DUNGEON, FINDCHARA_LINK(L_LEADER, LCOUNT), "デシベル値", L_DECIBEL
NEXT
RETURN L_DECIBEL - STOCK_PTS

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_ROLE_ホロウエージェント, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_LINK
#DIM DYNAMIC L_RESULT
;自分が攻撃側
IF L_P == L_ACTOR
;自分が防御側
ELSE
	SELECTCASE ARGS
		;防御時の相性を変化させる。枠としては壁やカーンなどと同じで、スキル耐性貫通スキルによって無効化される
		;※ただし耐性をあえて弱くする場合は無視されない
		;戻り値	RESULT=成否　RESULT:1 = 変化させる相性値　RESULTS = 상성변동요인
		CASE "相性変化"
			FOR LCOUNT, 0, 2
				IF FLAG:공격횟수 == 0
					IF C_ZENZERO_PARRY_RATE:L_P:LCOUNT:GET_TYPE_NUM(L_相性名) > RAND:100 && !IS_FRIEND(L_P, L_ACTOR)
						CALL SET_ROLE_CFLAG_BTL, L_P, "パリィ確定相性", GET_TYPE_NUM(L_相性名)
						RESULTS = パリィ
						IF GET_ROLE_CSTR_BTL(L_P, "発動突撃スキル") == ""
							CALL SET_ROLE_CFLAG_BTL, L_P, "突撃スキル発動者", FINDCHARA_LINK(L_P, LCOUNT)
							CALL SET_ROLE_CSTR_BTL, L_P, "発動突撃スキル", GET_ROLE_CSTR_DUNGEON(L_P, @"パリィ支援突撃{LCOUNT}")
						ENDIF
						RETURN 1, 0
					ENDIF
				ELSE
					IF GET_ROLE_CFLAG_BTL(L_P, "パリィ確定相性") == GET_TYPE_NUM(L_相性名)
						RESULTS = パリィ
						RETURN 1, 0
					ENDIF
				ENDIF
			NEXT
		CASE "追加回避強化"
			IF GET_ROLE_CFLAG_BTL(L_P, "極限回避発動率") > RAND:100
				CALL SET_ROLE_CFLAG_BTL, L_P, "極限回避発動", 1
				RESULTS = 極限回避
				IF GET_ROLE_CSTR_BTL(L_P, "発動突撃スキル") == ""
					L_LINK = -1
					SIF FINDCHARA_LINK(L_P, 0) >= 0 && ACTIONABLE_CHARA_F(FINDCHARA_LINK(L_P, 0)) && GET_ROLE_CSTR_DUNGEON(L_P, "回避支援突撃0") != ""
						L_LINK = 0
					IF FINDCHARA_LINK(L_P, 1) >= 0 && ACTIONABLE_CHARA_F(FINDCHARA_LINK(L_P, 1)) && GET_ROLE_CSTR_DUNGEON(L_P, "回避支援突撃1") != ""
						IF L_LINK == 0
							L_LINK = RAND:2
						ELSE
							L_LINK = 1
						ENDIF
					ENDIF
					IF L_LINK >= 0
						CALL SET_ROLE_CFLAG_BTL, L_P, "突撃スキル発動者", FINDCHARA_LINK(L_P, L_LINK)
						CALL SET_ROLE_CSTR_BTL, L_P, "発動突撃スキル", GET_ROLE_CSTR_DUNGEON(L_P, @"回避支援突撃{L_LINK}")
					ENDIF
				ENDIF
				RETURN 999
			ENDIF
	ENDSELECT
ENDIF
;加算できくやつだけしか扱えないので注意
FOR LCOUNT, 0, 4
	;最初にヒットしたやつだけみる
	SIF LCOUNT != FINDELEMENT(C_ZENZERO_DISC_NAME:L_P:0, C_ZENZERO_DISC_NAME:L_P:LCOUNT, , , 1)
		CONTINUE
	RESULT = 0, 0
	;返り値を加算するタイプ
	TRYCCALLFORM SKILL_PASSIVE_BTL_EFFECT_DISC_ADD_%C_ZENZERO_DISC_NAME:L_P:LCOUNT%, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
		L_RESULT += RESULT
	CATCH
	ENDCATCH
	RESULT = 0, 0
	;返り値を一発打ち切りにするタイプ
	TRYCCALLFORM SKILL_PASSIVE_BTL_EFFECT_DISC_ONCE_%C_ZENZERO_DISC_NAME:L_P:LCOUNT%, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
		SIF RESULT || RESULT:1
			RETURN RESULT
	CATCH
	ENDCATCH
NEXT
RETURN L_RESULT
;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_ROLE_ホロウエージェント, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_RESULT
#DIM DYNAMIC SKILL_NUM;スキル番号(専用技用)
#DIM DYNAMIC GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	CASE "HP補正"
		RESULTS = 乗算
		SELECTCASE MATCH(C_ZENZERO_DISC_NAME:ARG:0, "ソウル・ロック")
			CASE 4
				RETURN 75
			CASE 2, 3
				RETURN 30
			CASE 1
				RETURN 10
		ENDSELECT
	CASE "MP補正"
		RESULTS = 乗算
		SELECTCASE MATCH(C_ZENZERO_DISC_NAME:ARG:0, "スイング・ジャズ")
			CASE 4
				RETURN -40
			CASE 2, 3
				RETURN -55
			CASE 1
				RETURN -64
			CASE 0
				RETURN -70
		ENDSELECT
	;RESULT   = 変化があるかどうか(基準値が100だがこの項目が指定されていないと0で返してしまうので真偽判定の処理を追加している)
	;RESULT:1 = 耐性値。基準値が100なのに注意
	CASE "相性"
		L_RESULT = 100
		FOR LCOUNT, 0, 4
			TRYCCALLFORM ZENZERO_DISC_防御相性_%C_ZENZERO_DISC_NAME:ARG:LCOUNT%, ARG, ARGS:1
				L_RESULT = MIN(L_RESULT, RESULT)
			CATCH
			ENDCATCH
		NEXT
		SIF L_RESULT < 100
			RETURN 1, L_RESULT
		RETURN 0
ENDSELECT

RETURN 0
