@SKILL_TURNTOP_ROLE_ホロウエージェント, L_CHARA, ARG
#DIM DYNAMIC L_CHARA
CALL SET_AVOID_POWER_ホロウエージェント, L_CHARA

@SET_AVOID_POWER_ホロウエージェント, L_CHARA
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_POWER
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_LINK_CHARA
#DIM DYNAMIC L_SKILL
CALL SET_ROLE_CFLAG_BTL, L_CHARA, "極限回避発動率", 0
FOR LCOUNT, 1, CHARA_SKILLCOUNT(L_CHARA) + 1
	L_SKILL = ABL:L_CHARA:@"스킬{LCOUNT}"
	RESULT = 0
	TRYCCALLFORM ZENZERO_AVOID_POWER_%CONVERT_SKILLNUM_TO_STR(L_CHARA, L_SKILL)%, L_CHARA
		SIF RESULT > 0 && SKILLGAGE_D_GET(LCOUNT, L_SKILL) > 0
			CALL SET_ROLE_CFLAG_BTL, L_CHARA, "極限回避発動率", RESULT, "ADD"
	CATCH
	ENDCATCH
NEXT

FOR LCOUNT, 0, 2
	L_LINK_CHARA = FINDCHARA_LINK(L_CHARA, LCOUNT)
	SIF L_LINK_CHARA < 0
		CONTINUE
	FOR LCOUNT:1, 1, CHARA_SKILLCOUNT(L_LINK_CHARA) + 1
		L_SKILL = ABL:L_LINK_CHARA:@"스킬{LCOUNT:1}"
		SIF L_SKILL == 0
			CONTINUE
		CALL GET_SKILL_PROP, "SKILL_TAG", L_SKILL, L_LINK_CHARA
		IF RESULTS == "ゼンゼロ回避支援"
			CALLFORM ZENZERO_AVOID_POWER_%CONVERT_SKILLNUM_TO_STR(L_LINK_CHARA, L_SKILL)%, L_CHARA
			SELECTCASE MATCH(C_ZENZERO_DISC_NAME:L_LINK_CHARA:0, "プロト・パンク")
				CASE 4
					RESULT += 20
				CASE 2, 3
					RESULT += 10
				CASE 1
					RESULT += 5
			ENDSELECT
			CALL SET_ROLE_CFLAG_BTL, L_CHARA, "極限回避発動率", RESULT, "ADD"
		ENDIF
	NEXT
NEXT

