@ZENZERO_DISC_NAME_1
RESULTS '= "獣牙のヘヴィメタル"

@ZENZERO_DISC_EXPLAIN_獣牙のヘヴィメタル
RESULTS:0 '= "基本効果:剣撃・飛具・戦技の威力＋５％"
RESULTS:1 '= "２セット:剣撃・飛具・戦技の威力＋１５％"
RESULTS:2 '= "４セット:剣撃・飛具・戦技の威力＋３０％"

@SKILL_PASSIVE_BTL_EFFECT_DISC_ADD_獣牙のヘヴィメタル, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_LINK
#DIM DYNAMIC L_RESULT
;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		CASE "ダメージ補正加算"
			IF GROUPMATCH(L_相性名, "검격", "비구", "전술")
				SELECTCASE MATCH(C_ZENZERO_DISC_NAME:L_P:0, "獣牙のヘヴィメタル")
					CASE 4
						RETURN 30
					CASE 2, 3
						RETURN 15
					CASE 1
						RETURN 5
				ENDSELECT
			ENDIF
	ENDSELECT
;自分が防御側
ELSE
	SELECTCASE ARGS
	ENDSELECT
ENDIF
RETURN 0