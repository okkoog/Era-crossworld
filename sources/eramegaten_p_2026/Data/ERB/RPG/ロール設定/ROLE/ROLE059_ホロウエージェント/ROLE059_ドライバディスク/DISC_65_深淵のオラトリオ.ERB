@ZENZERO_DISC_NAME_65
RESULTS '= "深淵のオラトリオ"

@ZENZERO_DISC_防御相性_深淵のオラトリオ, L_CHARA, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TYPE
SELECTCASE L_TYPE
	CASE "중력"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "深淵のオラトリオ") >= 2
			RETURN 0
		ELSE
			RETURN 50
		ENDIF
	CASE "빙결", "전격", "핵열"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "深淵のオラトリオ") == 4
			RETURN 0
		ELSE
			RETURN 100
		ENDIF
	CASEELSE
		RETURN 100
ENDSELECT

@ZENZERO_DISC_EXPLAIN_深淵のオラトリオ
RESULTS:0 '= "基本効果:重力耐性"
RESULTS:1 '= "２セット:重力無効"
RESULTS:2 '= "４セット:氷結・電撃・重力・核熱無効"