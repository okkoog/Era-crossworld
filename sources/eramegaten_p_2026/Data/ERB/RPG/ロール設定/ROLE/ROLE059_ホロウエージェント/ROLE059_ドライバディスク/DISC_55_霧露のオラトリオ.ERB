@ZENZERO_DISC_NAME_55
RESULTS '= "霧露のオラトリオ"

@ZENZERO_DISC_防御相性_霧露のオラトリオ, L_CHARA, L_TYPE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TYPE
SELECTCASE L_TYPE
	CASE "빙결"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "霧露のオラトリオ") >= 2
			RETURN 0
		ELSE
			RETURN 50
		ENDIF
	CASE "화염", "전격", "충격"
		IF MATCH(C_ZENZERO_DISC_NAME:L_CHARA:0, "霧露のオラトリオ") == 4
			RETURN 0
		ELSE
			RETURN 100
		ENDIF
	CASEELSE
		RETURN 100
ENDSELECT

@ZENZERO_DISC_EXPLAIN_霧露のオラトリオ
RESULTS:0 '= "基本効果:氷結耐性"
RESULTS:1 '= "２セット:氷結無効"
RESULTS:2 '= "４セット:火炎・氷結・電撃・衝撃無効"