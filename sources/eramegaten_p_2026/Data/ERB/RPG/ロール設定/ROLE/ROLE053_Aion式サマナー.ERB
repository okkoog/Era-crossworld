;--------------------------------------------
;独自のリンク条件
;--------------------------------------------
@CASTING_LINK_DEVIL_Aion式サマナー, ARG
SIF CSTR:ARG:롤 != "悪魔"
	RETURN 0
;COMPに入れない場合は無理
SIF !GET_ROLE_PROP("CAN_PUT_IN_COMP", ARG)
	RETURN 0
;スキルが習得できない場合は無理
SIF !GET_ROLE_PROP("CHANGEABLE_SKILLCOUNT", ARG)
	RETURN 0
SIF CHARA_SKILLCOUNT(ARG) > 8
	RETURN 0
;探索・戦闘中は場にでてるストレージ悪魔はリンクできない。
IF GROUPMATCH(FLAG:SHOP커맨드, [[ショップ:탐색]],[[ショップ:콜로세움참가]],[[ショップ:이벤트]],[[ショップ:의뢰청부]])
	SIF CPOS(ARG:0) > 0 && CFLAG:(ARG:0):소속ＣＯＭＰ < 0
		RETURN 0
ENDIF
RETURN 1

;--------------------------------------------
;リンク先指定時の独自の上部リスト
;--------------------------------------------
@UP_PRINT_ACTION_2311_Aion式サマナー, ARG
PRINTFORM 누구를 ＣＯＭＰ에 세트할까？　
SIF A > リスト表示数()
	PRINTFORM ＜page.{P + 1}/{A / リスト表示数() + 1}＞
PRINTL
DRAWLINE

PRINTFORML 　　　[1001] 동료마를 ＣＯＭＰ에서 뺀다
RETURN 1

;--------------------------------------------
;リンク時のアクション
;リンク先を指定したタイミングで呼び出される
;
;Aion式サマナーはスキルを付け替える
;--------------------------------------------
@ROLE_LINK_ACT_Aion式サマナー, ARG
#DIM LCOUNT
#DIM TEMP
#DIMS TEMPS
#DIM TEMP_SKILL, 13;スキルの仮登録
#DIM LINKED_CHARA;リンクされているキャラの登録番号
#DIM LINKED_SKILL
#DIMS L_PU_SKILL, 13

VARSET TEMP_SKILL
VARSET L_PU_SKILL

;人間時のスキルをセット
;FOR LCOUNT, 1, 5
;	TEMP_SKILL:LCOUNT = ABL:ARG:@"인간시스킬{LCOUNT}"
;NEXT

;-1以外が返ってきたときは装備悪魔の設定
IF CFLAG:ARG:링크캐릭터실제가입시간0 > 0
	LINKED_CHARA = FINDCHARA_LINK(ARG)
	;PTにいる場合は外す
	SIF CPOS(LINKED_CHARA) > 0
		CALL REMOVE_POSITION, CPOS(LINKED_CHARA)
	;被変身フラグをつけて、PT選出などを防ぐ
	CFLAG:LINKED_CHARA:피변신플래그 = 1
	FOR LCOUNT, 5, FLAG:스킬수 + 5
		LINKED_SKILL = ABL:LINKED_CHARA:@"스킬{LCOUNT-4}"
		;リンク不能属性のスキルは除外
		RESULT = 0
		CALL GET_SKILL_PROP, "링크불능", LINKED_SKILL, LINKED_CHARA
		IF RESULT
			TEMP_SKILL:LCOUNT = 0
		ELSE
			;すでに持っているスキルは除外
			IF MATCH(TEMP_SKILL, LINKED_SKILL)
				TEMP_SKILL:LCOUNT = 0
				;専用技のチェック
				IF IS_PU_SKILLNUM(LINKED_SKILL)
					TEMPS = 전용기{LINKED_SKILL - [[스킬:전용기1]] + 1}
					;すでに持っている専用スキルは省く
					IF CSTR:ARG:TEMPS != CSTR:LINKED_CHARA:TEMPS
						TEMP_SKILL:LCOUNT = LINKED_SKILL
					ELSE
						TEMP_SKILL:LCOUNT = 0
					ENDIF
				ELSE
					TEMP_SKILL:LCOUNT = 0
				ENDIF
			ELSEIF LINKED_SKILL == [[스킬:각성스킬]]
				TEMP_SKILL:LCOUNT = 0
			ELSE
				TEMP_SKILL:LCOUNT = LINKED_SKILL
			ENDIF
		ENDIF
	NEXT
	;空き番号を詰める
	FOR LCOUNT, 12, 4, -1
		SIF TEMP_SKILL:LCOUNT == 0
			ARRAYREMOVE TEMP_SKILL, LCOUNT, 1
	NEXT
ENDIF
;仮登録していたスキルをセット
FOR LCOUNT, 5, 13
	ABL:ARG:@"스킬{LCOUNT}" = TEMP_SKILL:LCOUNT
NEXT

CALL SYNC_STATUS,ARG,"HPMP割合保持"

;入力行動をATTACK→GUN→GUARDの順に試行していく
CALL CHECK_ACTIONABLE,ARG,0
IF RESULT == 1
	CFLAG:(ARG):입력행동 = 0
	CALL RANDOM_TARGET,ARG,0
	CFLAG:(ARG):방어플래그 = 0
ELSE
	IF EQUIP:(ARG):총
		CALL CHECK_ACTIONABLE,ARG,2101
		IF RESULT == 1
			CFLAG:(ARG):입력행동 = 2101
			CFLAG:(ARG):방어플래그 = 0
			CALL RANDOM_TARGET,ARG,2101
		ELSE
			CFLAG:(ARG):입력행동 = -1
			CFLAG:(ARG):방어플래그 = 1
		ENDIF
	ELSE
		CFLAG:(ARG):입력행동 = -1
		CFLAG:(ARG):방어플래그 = 1
	ENDIF
ENDIF
RETURN 1

