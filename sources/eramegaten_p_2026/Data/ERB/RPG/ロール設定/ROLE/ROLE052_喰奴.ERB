;---------------------------------------------------------
;初期リンク悪魔にセット可能な条件
;ARG 対象のCSV番号
;---------------------------------------------------------
@ROLE_HEREDITY_IS_TRANS_ABLE_喰奴, ARG
SIF CSVTALENT(ARG, GETNUM(TALENT, "달인"))
	RETURN 0
SIF GROUPMATCH(GET_RACE(CSVABL(ARG, GETNUM(ABL, "종족"))), "인간", "조마", "반마인", "마인", "악마인")
	RETURN 0
RETURN 1

