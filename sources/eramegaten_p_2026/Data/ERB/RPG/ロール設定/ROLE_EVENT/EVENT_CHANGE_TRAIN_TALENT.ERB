;--------------------------------------------
;調教関係の素質習得時のイベント関数
;概ね、陥落素質と崩壊用
;
;キャラクター個別のものが存在する場合はロールまでは呼ばないので注意
;--------------------------------------------
@EVENT_CHANGE_TRAIN_TALENT_舞台少女, ARG, ARGS, ARGS:1
IF ARGS:1 == "GET" && GROUPMATCH(ARGS, "복종", "예속", "붕괴")
	;スキルをクリア
	CALL CLEAR_ALL_SKILL, ARG
	CALL CLEAR_ALL_LEARN_SKILL, ARG
	;戦闘素質をクリア
	CALL CLEAR_ROLE_TALENT, ARG
	CALL CHANGE_ROLE, ARG, "비전투원"
	
	;ただの人間に
	CSTR:ARG:종족명 = 인간
	ABL:ARG:종족 = 0
	SETCOLOR 0xff0033
	PRINT ＞무대소녀　
	PRINTS NAME:ARG
	PRINT 은(는)、
	IF TALENT:ARG:복종
		PRINT 【복종】
	ELSEIF TALENT:ARG:예속
		PRINT 【예속】
	ELSEIF TALENT:ARG:붕괴
		PRINT 【붕괴】
	ENDIF
	PRINTW 의 영향으로 반짝임을 잃고、비전투원이 되었다
	RESETCOLOR
ENDIF

@EVENT_CHANGE_TRAIN_TALENT_舞台少女_EX, ARG, ARGS, ARGS:1
CALL EVENT_CHANGE_TRAIN_TALENT_舞台少女, ARG, ARGS, ARGS:1

@EVENT_CHANGE_TRAIN_TALENT_舞台少女_トップスタァ, ARG, ARGS, ARGS:1
CALL EVENT_CHANGE_TRAIN_TALENT_舞台少女, ARG, ARGS, ARGS:1

@EVENT_CHANGE_TRAIN_TALENT_舞台少女_トップスタァ_EX, ARG, ARGS, ARGS:1
CALL EVENT_CHANGE_TRAIN_TALENT_舞台少女, ARG, ARGS, ARGS:1