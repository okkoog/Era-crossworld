@SUB_ROLE_TALENT_2, ARG
#FUNCTIONS
RESULTS_F = 석세서
RETURNF RESULTS_F

;----------------------------------------------
;表示用の名称変化
;----------------------------------------------
@SUB_ROLE_NAME_석세서, ARG = -1, ARGS, ARG:1
#FUNCTIONS
#DIM L_LV
RESULT_F = 0
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("석세서", ARG, ARGS) # ARG:1
IF L_LV > 0
	RESULTS_F = 석세서
ELSE
	RESULTS_F = 석세서
ENDIF
RETURNF RESULTS_F

;----------------------------------------------
;最大レベルの定義
;----------------------------------------------
@SUB_ROLE_MAXLV_석세서, ARG = -1, ARGS, ARG:1
#FUNCTION
RESULT_F = 1
RETURNF RESULT_F

;----------------------------------------------
;素質のコスト設定
;各キャラのコストは各メインロール毎にもつキャパシティ内に収める必要がある
;----------------------------------------------
@SUB_ROLE_COST_석세서, ARG = -1, ARGS, ARG:1
#FUNCTION
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("석세서", ARG, ARGS) # ARG:1
RESULT_F = L_LV > 0 ? 20 # 0
RETURNF RESULT_F

