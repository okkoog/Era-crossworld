;----------------------------------------------
;サブロール(追加素質)の設定
;----------------------------------------------
;----------------------------------------------
;トリガーになる素質名
;----------------------------------------------
@SUB_ROLE_TALENT_4, ARG
#FUNCTIONS
RESULTS_F = 아이템숙련
RETURNF RESULTS_F

;----------------------------------------------
;表示用の名称変化
;----------------------------------------------
@SUB_ROLE_NAME_아이템숙련, ARG = -1, ARGS, ARG:1
#FUNCTIONS
#DIM L_LV
RESULTS_F = 아이템숙련
RETURNF RESULTS_F

;----------------------------------------------
;最大レベルの定義
;----------------------------------------------
@SUB_ROLE_MAXLV_아이템숙련, ARG = -1, ARGS, ARG:1
#FUNCTION
RESULT_F = 1
RETURNF RESULT_F

;----------------------------------------------
;素質のコスト設定
;各キャラのコストは各メインロール毎にもつキャパシティ内に収める必要がある
;----------------------------------------------
@SUB_ROLE_COST_아이템숙련, ARG = -1, ARGS, ARG:1
#FUNCTION
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("아이템숙련", ARG, ARGS) # ARG:1
RESULT_F = L_LV > 0 ? 10 # 0
RETURNF RESULT_F

;----------------------------------------------
;素質の前提素質
;必要な素質がある場合、RESULTSにTALENT名称、RESULTにレベルをいれて返す
;----------------------------------------------
@SUB_ROLE_PREREQUISITE_BTL_TALENT_아이템숙련, ARG = -1, ARGS, ARG:1
RESULTS = 도구지식
RETURN 1

;----------------------------------------------
;説明文
;----------------------------------------------
@SUB_ROLE_EXPLAIN_아이템숙련, ARG = -1, ARGS, ARG:1
#DIM L_LV
IF ARG >= 0
	SIF !GET_BTL_TALENT_LV("아이템숙련", ARG, ARGS)
		RETURN 0
ENDIF	
