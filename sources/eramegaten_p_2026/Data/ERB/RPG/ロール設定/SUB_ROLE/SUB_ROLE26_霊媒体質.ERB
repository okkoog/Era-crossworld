;----------------------------------------------
;サブロール(追加素質)の設定
;----------------------------------------------
;----------------------------------------------
;トリガーになる素質名
;----------------------------------------------
@SUB_ROLE_TALENT_26, ARG
#FUNCTIONS
RESULTS_F = 영매체질
RETURNF RESULTS_F

;----------------------------------------------
;表示用の名称変化
;----------------------------------------------
@SUB_ROLE_NAME_영매체질, ARG = -1, ARGS, ARG:1
#FUNCTIONS
#DIM L_LV
RESULT_F = 0
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("영매체질", ARG, ARGS) # ARG:1
IF L_LV > 0
	RESULTS_F = 영매체질
ELSE
	RESULTS_F = 영매체질
ENDIF
RETURNF RESULTS_F

;----------------------------------------------
;最大レベルの定義
;----------------------------------------------
@SUB_ROLE_MAXLV_영매체질, ARG = -1, ARGS, ARG:1
#FUNCTION
RESULT_F = 1
RETURNF RESULT_F

;----------------------------------------------
;素質のコスト設定
;各キャラのコストは各メインロール毎にもつキャパシティ内に収める必要がある
;----------------------------------------------
@SUB_ROLE_COST_영매체질, ARG = -1, ARGS, ARG:1
#FUNCTION
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("영매체질", ARG, ARGS) # ARG:1
RESULT_F = L_LV > 0 ? 15 # 0
RETURNF RESULT_F

;----------------------------------------------
;説明文
;----------------------------------------------
@SUB_ROLE_EXPLAIN_영매체질, ARG = -1, ARGS, ARG:1
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("영매체질", ARG, ARGS) # ARG:1
SIF !L_LV
	RETURN 0
PRINTFORML □영매체질
PRINTFORML 　조교나 노역 등으로 인한 ＭＡＧ의 흡수량이 증가한다。또한 일차의 경과로 ＭＡＧ를 획득할 수도 있다。


