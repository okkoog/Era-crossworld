;----------------------------------------------
;サブロール(追加素質)の設定
;----------------------------------------------
;----------------------------------------------
;トリガーになる素質名
;----------------------------------------------
@SUB_ROLE_TALENT_5, ARG
#FUNCTIONS
RESULTS_F = 건슬링거
RETURNF RESULTS_F

;----------------------------------------------
;表示用の名称変化
;----------------------------------------------
@SUB_ROLE_NAME_건슬링거, ARG = -1, ARGS, ARG:1
#FUNCTIONS
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("건슬링거", ARG, ARGS) # ARG:1
IF L_LV > 0
	RESULTS_F = 건슬링거 Lv{L_Lv}
ELSE
	RESULTS_F = 건슬링거
ENDIF
RETURNF RESULTS_F

;----------------------------------------------
;最大レベルの定義
;----------------------------------------------
@SUB_ROLE_MAXLV_건슬링거, ARG = -1, ARGS, ARG:1
#FUNCTION
RESULT_F = 5
RETURNF RESULT_F

;----------------------------------------------
;素質のコスト設定
;各キャラのコストは各メインロール毎にもつキャパシティ内に収める必要がある
;----------------------------------------------
@SUB_ROLE_COST_건슬링거, ARG = -1, ARGS, ARG:1
#FUNCTION
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("건슬링거", ARG, ARGS) # ARG:1
SELECTCASE L_LV
	CASE 5
		RESULT_F = 100
	CASE 4
		RESULT_F = -1
	CASE 3
		RESULT_F = 30
	CASE 2
		RESULT_F = 20
	CASE 1
		RESULT_F = 10
	CASEELSE
		RESULT_F = 0
ENDSELECT
RETURNF RESULT_F

;----------------------------------------------
;説明文
;----------------------------------------------
@SUB_ROLE_EXPLAIN_건슬링거, ARG = -1, ARGS, ARG:1
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("건슬링거", ARG, ARGS) # ARG:1
SIF !L_LV
	RETURN 0
PRINTFORML □건슬링거 Lv{L_LV}
SELECTCASE L_LV
	;銃達人用(現状はダブルタップの条件となる)
	CASE 5
		PRINTFORML 　모든 특수탄과 고도의 기술이 필요한 총기에 더해 탁월한 사격기술을 구사할 수 있다。
		PRINTFORML 　총기를 장비하는 데 필요한 레벨이 5 낮아지며、필요한 스테이터스가 있는 경우에도 20\% 감소한다。
		PRINTFORML 　또한 사용에 전문지식이 필요한 강력한 총기와 특별한 사격기술을 사용할 수 있게 된다。
	CASE 4
		;未設定
	CASE 3
		PRINTFORML 　모든 특수탄과 고도의 기술이 필요한 총기를 사용할 수 있다。
		PRINTFORML 　총기를 장비하는 데 필요한 레벨이 5 낮아지며、필요한 스테이터스가 있는 경우에도 20\% 감소한다。
		PRINTFORML 　또한 사용에 전문지식이 필요한 강력한 총기를 사용할 수 있게 된다。
	CASE 2
		PRINTFORML 　대부분의 특수탄을 사용할 수 있다。
		PRINTFORML 　총기를 장비하는 데 필요한 레벨이 5 낮아지며、필요한 스테이터스가 있는 경우에도 20\% 감소한다。
	CASE 1
		PRINTFORML 　일부 특수탄을 사용할 수 있다。
		PRINTFORML 　총기를 장비하는 데 필요한 레벨이 5 낮아지며、필요한 스테이터스가 있는 경우에도 20\% 감소한다。
ENDSELECT


