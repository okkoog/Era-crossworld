;表示用の名称変化
;----------------------------------------------
@SUB_ROLE_NAME_커패시티확대, ARG = -1, ARGS, ARG:1
#FUNCTIONS
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("커패시티확대", ARG, ARGS) # ARG:1
IF L_LV > 0
	RESULTS_F = 커패시티확대 Lv{L_Lv}
ELSE
	RESULTS_F = 커패시티확대
ENDIF
RETURNF RESULTS_F

