;----------------------------------------------
;サブロール(追加素質)の設定
;----------------------------------------------
;----------------------------------------------
;トリガーになる素質名
;----------------------------------------------
@SUB_ROLE_TALENT_17, ARG
#FUNCTIONS
RESULTS_F = 신들의가호
RETURNF RESULTS_F

;----------------------------------------------
;表示用の名称変化
;----------------------------------------------
@SUB_ROLE_NAME_신들의가호, ARG = -1, ARGS, ARG:1
#FUNCTIONS
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("신들의가호", ARG, ARGS) # ARG:1
IF L_LV > 0
	RESULTS_F = 신들의가호 Lv{L_Lv}
ELSE
	RESULTS_F = 신들의가호
ENDIF
RETURNF RESULTS_F

;----------------------------------------------
;最大レベルの定義
;----------------------------------------------
@SUB_ROLE_MAXLV_신들의가호, ARG = -1, ARGS, ARG:1
#FUNCTION
RESULT_F = 5
RETURNF RESULT_F

;----------------------------------------------
;素質のコスト設定
;各キャラのコストは各メインロール毎にもつキャパシティ内に収める必要がある
;----------------------------------------------
@SUB_ROLE_COST_신들의가호, ARG = -1, ARGS, ARG:1
#FUNCTION
#DIM L_LV
RESULT_F = 0
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("신들의가호", ARG, ARGS) # ARG:1
SELECTCASE L_LV
	CASE 5
		RESULT_F = 25
	CASE 4
		RESULT_F = 20
	CASE 3
		RESULT_F = 15
	CASE 2
		RESULT_F = 10
	CASE 1
		RESULT_F = 5
	CASEELSE
		RESULT_F = 0
ENDSELECT
RETURNF RESULT_F

;----------------------------------------------
;説明文
;----------------------------------------------
@SUB_ROLE_EXPLAIN_신들의가호, ARG = -1, ARGS, ARG:1
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("신들의가호", ARG, ARGS) # ARG:1
PRINTFORML □신들의가호 Lv{L_LV}
PRINTFORML 　회복스킬에 의한 ＨＰ 회복량이 {MIN(L_LV * 25 + 25)}\% 증가한다。
PRINTFORML 　또한 ＨＰ 회복량 상한이 대상의 최대 ＨＰ의 {L_LV * 5}\% 증가한다。

