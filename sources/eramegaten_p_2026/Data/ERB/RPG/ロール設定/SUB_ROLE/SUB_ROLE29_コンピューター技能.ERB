@SUB_ROLE_PREREQUISITE_BTL_TALENT_컴퓨터기능, ARG = -1, ARGS, ARG:1
RESULTS = 서머너
RETURN 3

;----------------------------------------------
;説明文
;----------------------------------------------
@SUB_ROLE_EXPLAIN_컴퓨터기능, ARG = -1, ARGS, ARG:1
#DIM L_LV
;サマナーレベルがたりない場合は落とす
IF ARG >= 0
	SIF GET_BTL_TALENT_LV("서머너", ARG, ARGS) < 3
		RETURN 0
ENDIF
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("컴퓨터기능", ARG, ARGS) # ARG:1
IF L_LV > 0
	PRINTFORML □컴퓨터기능
	PRINTFORML 　사용 가능한 스킬에뮬레이터 수가 증가한다。
ENDIF


