;----------------------------------------------
;素質のコスト設定
;各キャラのコストは各メインロール毎にもつキャパシティ内に収める必要がある
;----------------------------------------------
@SUB_ROLE_COST_컴퓨터기능, ARG = -1, ARGS, ARG:1
#FUNCTION
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("컴퓨터기능", ARG, ARGS) # ARG:1
RESULT_F = L_LV > 0 ? 20 # 0
RETURNF RESULT_F

