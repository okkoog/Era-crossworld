;----------------------------------------------
;サブロール(追加素質)の設定
;----------------------------------------------
;----------------------------------------------
;トリガーになる素質名
;----------------------------------------------
@SUB_ROLE_TALENT_16, ARG
#FUNCTIONS
RESULTS_F = 나락의마스크
RETURNF RESULTS_F

;----------------------------------------------
;表示用の名称変化
;----------------------------------------------
@SUB_ROLE_NAME_나락의마스크, ARG = -1, ARGS, ARG:1
#FUNCTIONS
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("나락의마스크", ARG, ARGS) # ARG:1
IF L_LV > 0
	RESULTS_F = 나락의마스크 Lv{L_Lv}
ELSE
	RESULTS_F = 나락의마스크
ENDIF
RETURNF RESULTS_F

;----------------------------------------------
;最大レベルの定義
;----------------------------------------------
@SUB_ROLE_MAXLV_나락의마스크, ARG = -1, ARGS, ARG:1
#FUNCTION
RESULT_F = 5
RETURNF RESULT_F

;----------------------------------------------
;素質のコスト設定
;各キャラのコストは各メインロール毎にもつキャパシティ内に収める必要がある
;----------------------------------------------
@SUB_ROLE_COST_나락의마스크, ARG = -1, ARGS, ARG:1
#FUNCTION
#DIM L_LV
RESULT_F = 0
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("나락의마스크", ARG, ARGS) # ARG:1
SELECTCASE L_LV
	CASE 5
		RESULT_F = 25
	CASE 4
		RESULT_F = 20
	CASE 3
		RESULT_F = 15
	CASE 2
		RESULT_F = 10
	CASE 1
		RESULT_F = 5
	CASEELSE
		RESULT_F = 0
ENDSELECT
RETURNF RESULT_F

;----------------------------------------------
;説明文
;----------------------------------------------
@SUB_ROLE_EXPLAIN_나락의마스크, ARG = -1, ARGS, ARG:1
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("나락의마스크", ARG, ARGS) # ARG:1
PRINTFORML □나락의마스크 Lv{L_LV}
PRINTFORML 　자신에게 적용되는 최종적인 상태이상 부착률이 고정값으로 %AUTO_SPLIT("0/30/50/70/85/100", "/", L_LV)%\% 감산된다。

