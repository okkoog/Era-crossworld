;----------------------------------------------
;サブロール(追加素質)の設定
;----------------------------------------------
;----------------------------------------------
;トリガーになる素質名
;----------------------------------------------
@SUB_ROLE_TALENT_3, ARG
#FUNCTIONS
RESULTS_F = 도구지식
RETURNF RESULTS_F

;----------------------------------------------
;表示用の名称変化
;----------------------------------------------
@SUB_ROLE_NAME_도구지식, ARG = -1, ARGS, ARG:1
#FUNCTIONS
#DIM L_LV
L_LV = MIN(ARG >= 0 ?GET_BTL_TALENT_LV("도구지식", ARG, ARGS) # ARG:1, 3)
IF L_LV > 0
	RESULTS_F = 도구지식 Lv{L_LV}
ELSE
	RESULTS_F = 도구지식
ENDIF
RETURNF RESULTS_F

;----------------------------------------------
;最大レベルの定義
;----------------------------------------------
@SUB_ROLE_MAXLV_도구지식, ARG = -1, ARGS, ARG:1
#FUNCTION
RESULT_F = 3
RETURNF RESULT_F

;----------------------------------------------
;素質のコスト設定
;各キャラのコストは各メインロール毎にもつキャパシティ内に収める必要がある
;----------------------------------------------
@SUB_ROLE_COST_도구지식, ARG = -1, ARGS, ARG:1
#FUNCTION
#DIM L_LV
L_LV = ARG >= 0 ? GET_BTL_TALENT_LV("도구지식", ARG, ARGS) # ARG:1
SELECTCASE L_LV
	CASE 3
		RESULT_F = 10
	CASE 2
		RESULT_F = 6
	CASE 1
		RESULT_F = 3
	CASEELSE
		RESULT_F = 0
ENDSELECT
RETURNF RESULT_F

;----------------------------------------------
;説明文
;----------------------------------------------
@SUB_ROLE_EXPLAIN_도구지식, ARG = -1, ARGS, ARG:1
#DIM L_LV
SIF ARG >= 0 && !GET_ROLE_PROP("CAN_USE_도구지식", ARG)
	RETURN 0
L_LV = MIN(ARG >= 0 ? GET_BTL_TALENT_LV("도구지식", ARG, ARGS) # ARG:1, 3)
IF L_LV > 0
	PRINTFORML □도구지식 Lv{L_LV}
	SELECTCASE L_LV
		CASE IS >= 3
			PRINTFORML 　모든 아이템을 사용할 수 있다。
		CASE 2
			PRINTFORML 　일부를 제외한 고도의 아이템을 사용할 수 있다。
		CASEELSE
			PRINTFORML 　일부 아이템을 사용할 수 있다。
	ENDSELECT
ENDIF


;----------------------------------------------
;説明文2
;----------------------------------------------
@SUB_ROLE_EXPLAIN_TOOLTIP_도구지식, ARG = -1, ARG:1 = -1
RESULTS '=  "아이템을 사용할 수 있다。" + UNICODE(0x000D) + "레벨이 높아질수록 사용할 수 있는 아이템이 증가한다。"