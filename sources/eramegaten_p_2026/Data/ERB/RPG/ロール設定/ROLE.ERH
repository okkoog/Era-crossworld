#DIM CONST ROLENUM = 100

#DIM CONST SUB_ROLENUM = 30
#DIMS SUB_ROLENAME, SUB_ROLENUM
;-------------------------------------------------
;変身時の戦闘素質の保存場所
;-------------------------------------------------
#DIM CHARADATA SAVEDATA TRANS_BTL_TALENT, SUB_ROLENUM

;-------------------------------------------------
;コスト合計値の計算
;-------------------------------------------------
#DIM CHARADATA SAVEDATA ROLE_CP
#DIM CHARADATA SAVEDATA ROLE_CP_TRANS

;-------------------------------------------------
;ロール独自のフラグ
;-------------------------------------------------
#DIM CHARADATA SAVEDATA ROLE_CFLAG_EV, 20			;イベント用を想定。周回時にリセット
#DIMS CHARADATA SAVEDATA ROLE_CSTR_EV, 10			;イベント用を想定。周回時にリセット

#DIM CHARADATA SAVEDATA ROLE_CFLAG_TAKEOVER, 20	;イベント用を想定。周回してもリセットされない
#DIMS CHARADATA SAVEDATA ROLE_CSTR_TAKEOVER, 5	;イベント用を想定。周回してもリセットされない

#DIM CHARADATA ROLE_CFLAG_BTL, 20		;戦闘用を想定　戦闘開始時にリセット
#DIMS CHARADATA ROLE_CSTR_BTL, 5			;戦闘用を想定　戦闘開始時にリセット

#DIM CHARADATA SAVEDATA ROLE_CFLAG_DUNGEON, 20	;探索用を想定　ダンジョン探索終了 = SHOP画面でリセット
#DIMS CHARADATA SAVEDATA ROLE_CSTR_DUNGEON, 5		;探索用を想定　ダンジョン探索終了 = SHOP画面でリセット
