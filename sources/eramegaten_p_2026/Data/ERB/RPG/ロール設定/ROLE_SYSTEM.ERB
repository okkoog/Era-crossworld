	ABL:ARG:종족 = GET_RACE_NUM(ARGS:2)
;ここまでで新しいロールが決定できるので取得しなおす
CALL SET_ROLE, ARG
;-------------------------------
;ロール変更前に持っていたサブ素質を付与する
;-------------------------------
IF L_TALENT != ""
	SPLIT L_TALENT, "/", L_TALENTS
	FOR LCOUNT, 0, RESULT
		TEMP_TALENTNAME '= AUTO_SPLIT(L_TALENTS:LCOUNT, "_", 0)
		SIF TALENT:ARG:TEMP_TALENTNAME
			CONTINUE
		;---- EDIT 009 ADD START -------------------------
		;持てない素質をはじく
		SIF GET_SUB_ROLE_NUM(TEMP_TALENTNAME) >= 0 && !GET_ROLE_PROP(@"CAN_USE_%TEMP_TALENTNAME%", ARG, "通常形態")
			CONTINUE
		;---- EDIT 009 ADD END ---------------------------
		TALENT:ARG:TEMP_TALENTNAME = MAX(TOINT(AUTO_SPLIT(L_TALENTS:LCOUNT, "_", 1)), 1)
	NEXT
ENDIF
IF L_TRANS_TALENT != ""
	SPLIT L_TRANS_TALENT, "/", L_TALENTS
	FOR LCOUNT, 0, RESULT
		TEMP_TALENTNAME '= AUTO_SPLIT(L_TALENTS:LCOUNT, "_", 0)
		SIF TRANS_BTL_TALENT:ARG:GET_SUB_ROLE_NUM(TEMP_TALENTNAME)
			CONTINUE
		;---- EDIT 009 ADD START -------------------------
		SIF !GET_ROLE_PROP(@"CAN_USE_%TEMP_TALENTNAME%", ARG, "変身形態")
			CONTINUE
		;---- EDIT 009 ADD END ---------------------------
		TRANS_BTL_TALENT:ARG:GET_SUB_ROLE_NUM(TEMP_TALENTNAME) = MAX(TOINT(AUTO_SPLIT(L_TRANS_TALENT:LCOUNT, "_", 1)), 1)
	NEXT
ENDIF
;---- EDIT 009 MOD START -------------------------
;ロール変更後のデフォルト素質を付与する
SIF !STRCOUNT(ARGS:3, "デフォルト素質なし")
	CALL SET_BTL_TALENT_NEW, ARG
;---- EDIT 009 MOD END ---------------------------
;-------------------------------
;ここまでの状態でCPを計算して
;足りないなら、素質選択
;足りているのなら、変更前のロールのデフォルト素質の付与判定をする
;-------------------------------
CALL SET_ROLE_CP, ARG
IF GET_ROLE_CP(ARG, "通常形態") < 0 && !FLAG:CP제한무효화
	RESULTS '= ""
	TRYCALLFORM ROLE_DEFAULT_BTL_TALENT_%CSTR:ARG:롤%
	L_DEFAULT:0 '= RESULTS
	SIF L_TALENT != "" && L_DEFAULT:0 != ""
		L_TALENT += "/"
	L_TALENT += L_DEFAULT:0
	DRAWLINE
	PRINTL 남길 소질을 선택해 주십시오
	DRAWLINE
	CALL ENHANCE_ROLE, ARG, "通常形態", L_TALENT, , "戻る不可"
ELSE
	CALL SET_BTL_TALENT_DEFAULT, L_DEFAULT:0, ARG, "通常形態"
ENDIF
IF GET_ROLE_CP(ARG, "変身形態") < 0 && !FLAG:CP제한무효화
	RESULTS '= ""
	TRYCALLFORM ROLE_DEFAULT_BTL_TALENT_TRANS_%CSTR:ARG:롤%
	L_DEFAULT:1 '= RESULTS
	SIF L_TRANS_TALENT != "" && L_DEFAULT:1 != ""
		L_TRANS_TALENT += "/"
	L_TRANS_TALENT += L_DEFAULT:1
	DRAWLINE
	PRINTL 남길 소질을 선택해 주십시오
	DRAWLINE
	CALL ENHANCE_ROLE, ARG, "変身形態", L_TALENT, , "戻る不可"
ELSE
	CALL SET_BTL_TALENT_DEFAULT, L_DEFAULT:1, ARG, "変身形態"
ENDIF

;-------------------------------
;装備関係の処理
;-------------------------------
CALL FIX_ROLE_EQUIP, ARG

;-------------------------------
;スキル関係の処理
;-------------------------------
;この段階で確実に変身解除状態なので、人間時スキルを更新する
IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
		ABL:ARG:@"인간시스킬{LCOUNT}" = ABL:ARG:@"스킬{LCOUNT}"
	NEXT
ENDIF
;枠数を取得
CALL SET_CHARA_SKILLCOUNT, ARG
;---- EDIT 006 DEL START -------------------------　Fix内で除外処理を走らせるのでここのは削除
;ロール変更で使用不能になったスキルを除外する
;CALL EXCLUDE_UNABLE_SKILL, ARG, 1
;---- EDIT 006 DEL END ---------------------------
CALL FIX_ROLE_HAVESKILL, ARG
CALL FIX_CHARA_TRANS_SKILL, ARG

;-------------------------------
;素質の変更等で装備条件を満たせなくなった装備を確認する
;-------------------------------
@FIX_ROLE_EQUIP, ARG
#DIM LCOUNT
;サクセサーでなくなっていたら魔晶剣を外す
SIF 魔晶装備(EQUIP:ARG:검) && !GET_BTL_TALENT_LV("석세서", ARG, "両形態")
	CALL 装備変更, ARG, GET_EQUIPNUM("검"), 0
FOR LCOUNT, 0, 7
	SELECTCASE GET_EQUIP(LCOUNT)
		CASE "총"
			SIF GET_ROLE_PROP("CAN_USE_GUN", ARG, "両形態")
				CONTINUE
		CASE "악세서리"
			SIF GET_ROLE_PROP("CAN_USE_EQUIP", ARG, "両形態")
				CONTINUE
			SIF GET_ROLE_PROP("CAN_USE_PLUGIN", ARG, "両形態")
				CONTINUE
		CASEELSE
			SIF GET_ROLE_PROP("CAN_USE_EQUIP", ARG, "両形態")
				CONTINUE
	ENDSELECT
	;装備の使用条件を満たせなくなっていたら外す
	CALL 装備変更, ARG, LCOUNT, 0
NEXT

;-------------------------------
;素質の変更等で仕様条件を満たせなくなったスキルを確認する
;-------------------------------
@FIX_ROLE_HAVESKILL, ARG, ARGS = "枠数/スキル使用能力"
#DIM LCOUNT
#DIM STOCK_HAVESKILLNUM, 3
#DIM IS_TRANS
;悪魔変身していた場合は戻す
IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	IS_TRANS = CFLAG:ARG:악마변신
	CALL TRANS_DEVIL, ARG, ,"変身解除"
ENDIF

;---- EDIT 006 MOD START -------------------------
;還元前にスキルが除外されてしまうので処理順を変更
;還元処理
;スキル使用能力が低下していたり、枠数が足りないなどスキルを減らす必要がある場合。カード＋MAGで返す
CALL REDUCTION_SKILL_CHARA, ARG, ARGS
;ロールが条件として指定されているスキルなどを除外(所持スキルは適正化されているはずなのでここでは習得スキルの除外を行う)
CALL EXCLUDE_UNABLE_SKILL, ARG
;---- EDIT 006 MOD END ---------------------------

;変身出来ない場合は変身絡みのスキルをクリアー
IF !GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
		ABL:ARG:@"인간시스킬{LCOUNT}" = 0
		ABL:ARG:@"초기변신악마스킬{LCOUNT}" = 0
		ABL:ARG:@"초기변신악마습득스킬{LCOUNT}" = 0
		ABL:ARG:@"초기변신악마습득LV{LCOUNT}" = 0
	NEXT
ELSE
	;ここでもいちおう人間スキルを登録しておく
	FOR LCOUNT, 1, CHARA_SKILLCOUNT(ARG, "通常形態")
		ABL:ARG:@"인간시스킬{LCOUNT}" = ABL:ARG:@"스킬{LCOUNT}"
	NEXT
	;いちおう変身していたなら変身状態に
	SIF IS_TRANS
		CALL TRANS_DEVIL, ARG
ENDIF

;---- EDIT 006 MOD START ---------------------------
;人間時スキルでなく、スキルを操作する必要があったので修正
;---------------------------------------------------
;スキル所持数が減った場合などに、所持スキルをスキルカードとMAGにして還元して取得させる処理
;ARG 	対象のキャラ番号
;ARGS	還元判定の対象
;---------------------------------------------------
@REDUCTION_SKILL_CHARA, ARG, ARGS = "枠数/スキル使用能力"
#DIM LCOUNT, 3
#DIM L_RESULT
#DIM L_LINE
#DIM L_COLOR
#DIM L_SKILL, 2
#DIMS L_SKILLS
#DIM L_COST
#DIM L_DEL_SKILL, HAVEABLE_SKILLNUM * 2
#DIM L_REDUCTION_SKILL, HAVEABLE_SKILLNUM * 2
#DIM IS_DEL_SKILL
#DIM CNT_REDUCTION
#DIM MAG_REDUCTION
#DIM STOCK_HAVESKILLNUM, 3
#DIM L_SKILL_SUCCESSION
#DIMS TRANS_MODE
#DIM SELECT_SKILL, HAVEABLE_SKILLNUM
#DIM STOCK_REDRAW

STOCK_REDRAW = CURRENTREDRAW()
REDRAW 0

VARSET L_REDUCTION_SKILL
VARSET L_DEL_SKILL

FOR LCOUNT:2, 0, 1 + GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	IF LCOUNT:2 == 0
		TRANS_MODE = 通常形態
		IF GET_ROLE_PROP("CAN_USE_TRANS", ARG) && CFLAG:ARG:악마변신
			L_SKILLS = 인간시스킬
		ELSE
			L_SKILLS = 스킬
		ENDIF
	ELSE
		TRANS_MODE = 変身形態
		IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
			;初期変身悪魔に変身している場合
			IF CFLAG:ARG:악마변신 && CFLAG:ARG:링크캐릭터실제가입시간0 <= 0
				L_SKILLS = 스킬
			ELSE
				L_SKILLS = 초기변신악마스킬
			ENDIF
		ELSE
			BREAK
		ENDIF
	ENDIF
	;-------------------------------------------
	;所持不能になったスキルの還元・削除処理
	;最初に持てないスキルを自動的にすべて抜く
	;-------------------------------------------
	FOR LCOUNT, HAVEABLE_SKILLNUM, 0, -1
		L_SKILL = ABL:ARG:@"%L_SKILLS%{LCOUNT}"
		SIF !L_SKILL
			CONTINUE
		;削除不能スキルは対象外にする
		CALL GET_SKILL_PROP, "SKILL_DEL_UNABLE", L_SKILL, ARG
		SIF RESULT
			CONTINUE
		;最初に継承タイプをチェック
		SIF !STRCOUNT(ARGS, "スキル使用能力")
			CONTINUE
		CALL IS_SKILL_HAVEABLE, L_SKILL, ARG, TRANS_MODE
		IF !RESULT
			;置換スキルがあるなら置き換える
			CALL GET_SKILL_PROP, "置換スキル", L_SKILL, ARG
			IF RESULT
				L_SKILL:1 = RESULT
				IF !HAVE_SKILL(ARG, L_SKILL:1)
					CALL IS_SKILL_HAVEABLE, L_SKILL:1, ARG, TRANS_MODE
					IF RESULT
						ABL:ARG:@"%L_SKILLS%{LCOUNT}" = L_SKILL:1
						CALL PRINT_COLOR, @"使用条件を満たせなくなり、%CALLNAME:ARG%の%SKILL_NAME_F(L_SKILL)%が%SKILL_NAME_F(L_SKILL:1)%に置換された。", COLOR("red"), "W"
						CONTINUE
					ENDIF
				ENDIF
			ENDIF
		ELSE
			CONTINUE
		ENDIF
		;スキルを消す
		ABL:ARG:@"%L_SKILLS%{LCOUNT}" = 0
		;マントラの場合はカード還元をしない
		IF GET_ROLE_PROP("CAN_USE_MANTRA", ARG, ,TRANS_MODE)
			L_DEL_SKILL:FINDELEMENT(L_DEL_SKILL, 0) = L_SKILL
		;還元不能の削除フラグが立てられていたら削除リストに入れる
		ELSE
			;スキルカードにできるスキルかどうかを確認する
			CALL IS_MAKEABLE_SKILLCARD, L_SKILL
			IF RESULT
				L_REDUCTION_SKILL:FINDELEMENT(L_REDUCTION_SKILL, 0) = L_SKILL
			ELSE
				L_DEL_SKILL:FINDELEMENT(L_DEL_SKILL, 0) = L_SKILL
			ENDIF
		ENDIF
	NEXT
NEXT
MAG_REDUCTION = 0
FOR LCOUNT, 0, HAVEABLE_SKILLNUM
	L_SKILL = L_REDUCTION_SKILL:LCOUNT
	SIF !L_SKILL
		BREAK
	CALL GET_ITEM, 10000 + L_SKILL
	PRINTFORML %CALLNAME:ARG%의 소지 스킬이 %ITEMNAME:(10000 + L_SKILL)%(으)로서 환원되었다。
	CALL GET_ITEM, 10000 + L_SKILL, 1
	;コストを計算
	CALL GET_SKILL_PROP, "SKILL_RANK", L_SKILL, ARG
	L_COST = POWER(RESULT,3)*150 * ＭＡＧ強化ＣＰ補正(ARG) / 1000
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILL, ARG
	SIF TALENT:ARG:GET_SUCCESSION(RESULT) == 0
		L_COST *= 2
	MAG_REDUCTION += L_COST
NEXT
FOR LCOUNT, 0, HAVEABLE_SKILLNUM
	L_SKILL = L_DEL_SKILL:LCOUNT
	SIF !L_SKILL
		BREAK
	CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, ARG
	CALL PRINT_COLOR, @"%CALLNAME:ARG%의 %RESULTS%(을)를 잃어버렸다。", COLOR("red"), "L"
NEXT

SIF MAG_REDUCTION
	PRINTFORML 합계 {MAG_REDUCTION}의 ＭＡＧ가 환원되었다。
CALL CONTROL_MAG, ARG, MAG_REDUCTION

;空き番号を詰める
FOR LCOUNT, 1, HAVEABLE_SKILLNUM
	IF !ABL:ARG:@"%L_SKILLS%{LCOUNT}"&& ABL:ARG:@"%L_SKILLS%{LCOUNT+1}"
		SWAP ABL:ARG:@"%L_SKILLS%{LCOUNT}", ABL:ARG:@"%L_SKILLS%{LCOUNT + 1}"
		LCOUNT = 0
	ENDIF
NEXT

;人間時スキルなどを更新
;CALL FIX_CHARA_TRANS_SKILL, ARG

SIF L_REDUCTION_SKILL || L_DEL_SKILL
	FORCEWAIT

;スキル所持数を確認
VARSET STOCK_HAVESKILLNUM
FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
	STOCK_HAVESKILLNUM:0 += (ABL:ARG:@"스킬{LCOUNT}" > 0)
	STOCK_HAVESKILLNUM:1 += (ABL:ARG:@"초기변신악마스킬{LCOUNT}" > 0)
	STOCK_HAVESKILLNUM:2 += (ABL:ARG:@"인간시스킬{LCOUNT}" > 0)
NEXT

FOR LCOUNT:2, 0, 1 + GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	VARSET SELECT_SKILL
	IF LCOUNT:2 == 0
		TRANS_MODE = 通常形態
		IF GET_ROLE_PROP("CAN_USE_TRANS", ARG) && CFLAG:ARG:악마변신
			L_SKILLS = 인간시스킬
			CNT_REDUCTION = STOCK_HAVESKILLNUM:2 - CHARA_SKILLCOUNT(ARG, TRANS_MODE)
		ELSE
			L_SKILLS = 스킬
			CNT_REDUCTION = STOCK_HAVESKILLNUM:0 - CHARA_SKILLCOUNT(ARG, TRANS_MODE)
		ENDIF
	ELSE
		TRANS_MODE = 変身形態
		IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
			IF CFLAG:ARG:악마변신 && CFLAG:ARG:링크캐릭터실제가입시간0 <= 0
				L_SKILLS = 스킬
				CNT_REDUCTION = STOCK_HAVESKILLNUM:0 - CHARA_SKILLCOUNT(ARG, TRANS_MODE)
			ELSE
				L_SKILLS = 초기변신악마스킬
				CNT_REDUCTION = STOCK_HAVESKILLNUM:1 - CHARA_SKILLCOUNT(ARG, TRANS_MODE)
			ENDIF
		ELSE
			BREAK
		ENDIF
	ENDIF
	IF CNT_REDUCTION > 0
		CALL MESSAGE_B, 4, @"%CALLNAME:ARG%のスキル所持可能数が変わって持ちきれないスキルが出来ました。", "所持スキルから外すスキルを指定してください", "なお、外したスキルがスキルカードにできる場合はスキルカードを取得し", "さらに取得に必要なMAGが還元されまます。"
		L_LINE = LINECOUNT
		$START
		CLEARLINE LINECOUNT - L_LINE
		FOR LCOUNT, 0, HAVEABLE_SKILLNUM 
			L_SKILL = ABL:ARG:@"%L_SKILLS%{LCOUNT+1}"
			SIF L_SKILL == 0
				CONTINUE
			SETCOLOR SELECT_SKILL:LCOUNT ? COLOR("aqua") # COLOR("デフォルト")
			CALL GET_SKILL_PROP, "SKILL_DEL_UNABLE", L_SKILL, ARG
			L_RESULT = RESULT
			SIF L_RESULT
				SETCOLOR COLOR("gray")
			CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, ARG
			PRINTFORM [{LCOUNT}] %RESULTS, 36%
			SIF L_RESULT
				PRINTFORM 　　　삭제불능
			PRINTL 
			RESETCOLOR
		NEXT
		DRAWLINE
		PRINTFORML 【소지가능 스킬 수:{CHARA_SKILLCOUNT(ARG, TRANS_MODE)}】
		DRAWLINE
		CALL PRINT_COLOR, "[99] 결정", CNT_REDUCTION > MATCH(SELECT_SKILL, 1) ? COLOR("gray") # COLOR("デフォルト")
		INPUT
		SELECTCASE RESULT
			CASE 0 TO HAVEABLE_SKILLNUM
				L_RESULT = RESULT
				L_SKILL = ABL:ARG:@"%L_SKILLS%{L_RESULT+1}"
				IF L_SKILL
					CALL GET_SKILL_PROP, "SKILL_DEL_UNABLE", L_SKILL, ARG
					SIF !RESULT
						SELECT_SKILL:L_RESULT = !SELECT_SKILL:L_RESULT
				ENDIF
			CASE 99
				IF MATCH(SELECT_SKILL, 1) >= CNT_REDUCTION
					VARSET L_REDUCTION_SKILL
					VARSET L_DEL_SKILL
					MAG_REDUCTION = 0
					FOR LCOUNT, 0, HAVEABLE_SKILLNUM
						SIF !SELECT_SKILL:LCOUNT
							CONTINUE
						L_SKILL = ABL:ARG:@"%L_SKILLS%{LCOUNT+1}"
						IS_DEL_SKILL = 0
						RESULT = 0
						CALL GET_SKILL_PROP, "継承不能", L_SKILL, ARG
						SIF RESULT
							IS_DEL_SKILL = 1
						RESULT = 0
						CALL GET_SKILL_PROP, "SKILL_RANK", L_SKILL, ARG
						SIF !INRANGE(RESULT, 1, 15)
							IS_DEL_SKILL = 1
						CALL GETS_SKILL_PROP, "ロール専用", L_SKILLS, ARG
						IF RESULT
							SIF !STRCOUNT(GETS_ROLE_PROP("CAN_USE_SPECIAL_SKILL", ARG, TRANS_MODE), RESULTS)
								IS_DEL_SKILL = 1
						ENDIF
						;還元不能の削除フラグが立てられていたら削除リストに入れる
						IF IS_DEL_SKILL
							L_DEL_SKILL:FINDELEMENT(L_DEL_SKILL, 0) = L_SKILL
						ELSE
							L_REDUCTION_SKILL:FINDELEMENT(L_REDUCTION_SKILL, 0) = L_SKILL
						ENDIF
						ABL:ARG:@"%L_SKILLS%{LCOUNT+1}" = 0
					NEXT
					MAG_REDUCTION = 0
					FOR LCOUNT, 0, HAVEABLE_SKILLNUM
						L_SKILL = L_REDUCTION_SKILL:LCOUNT
						SIF !L_SKILL
							BREAK
						CALL GET_ITEM, 10000 + L_SKILL
						PRINTFORML %CALLNAME:ARG%의 소지 스킬이 %ITEMNAME:(10000 + L_SKILL)%(으)로서 환원되었다。
						CALL GET_ITEM, 10000 + L_SKILL, 1
						;コストを計算
						CALL GET_SKILL_PROP, "SKILL_RANK", L_SKILL, ARG
						L_COST = POWER(RESULT,3)*150 * ＭＡＧ強化ＣＰ補正(ARG) / 1000
						CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILL, ARG
						SIF TALENT:ARG:GET_SUCCESSION(RESULT) == 0
							L_COST *= 2
						MAG_REDUCTION += L_COST
					NEXT
					FOR LCOUNT, 0, HAVEABLE_SKILLNUM
						L_SKILL = L_DEL_SKILL:LCOUNT
						SIF !L_SKILL
							BREAK
						CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, ARG
						CALL PRINT_COLOR, @"%CALLNAME:ARG%의 %RESULTS%(을)를 잃어버렸다。", COLOR("red"), "L"
					NEXT

					SIF MAG_REDUCTION
						PRINTFORMW 합계 {MAG_REDUCTION}의 ＭＡＧ가 환원되었다。
					CALL CONTROL_MAG, ARG, MAG_REDUCTION

					;空き番号を詰める
					FOR LCOUNT, 1, HAVEABLE_SKILLNUM
						IF !ABL:ARG:@"%L_SKILLS%{LCOUNT}"&& ABL:ARG:@"%L_SKILLS%{LCOUNT+1}"
							SWAP ABL:ARG:@"%L_SKILLS%{LCOUNT}", ABL:ARG:@"%L_SKILLS%{LCOUNT + 1}"
							LCOUNT = 0
						ENDIF
					NEXT
					CONTINUE
				ENDIF
		ENDSELECT
		GOTO START
	ENDIF
NEXT
REDRAW STOCK_REDRAW
;---- EDIT 006 MOD END ---------------------------