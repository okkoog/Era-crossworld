;=========================================================
;定義
;=========================================================
;--------------------------------------------
;サブロールの名称リスト作成
;--------------------------------------------
@MAKE_SUB_ROLENAME_LIST
#FUNCTION
#DIM LCOUNT
;すでに作成済みなら終わる
SIF SUB_ROLENAME != ""
	RETURNF 0
FOR LCOUNT, 0, SUB_ROLENUM
	CALLFORMF SUB_ROLE_TALENT_{LCOUNT}
	SUB_ROLENAME:LCOUNT '= RESULTS_F
NEXT
RETURNF 1

;=======================================================
;ロールの決定
;
;ex:異能者・達人を持っていた場合は異能者→달인→複合達人の順にクリアーして、最終的に複合達人になる
;=======================================================
@SET_ROLE, ARG
CALL ROLE_DECIDE, ARG
CALL SET_CHARA_SKILLCOUNT, ARG;EDIT 004 ADD 

;=======================================================
;キャラクター生成時に設定されている戦闘素質をセットする
;=======================================================
@SET_BTL_TALENT_NEW, ARG
#DIM LCOUNT
#DIM L_LV, SUB_ROLENUM
#DIMS L_TALENTS, SUB_ROLENUM
#DIM L_LV_FIXED, SUB_ROLENUM
#DIMS L_TALENTS_FIXED, SUB_ROLENUM
#DIM L_COST
;固定素質の付与
CALL SET_FIXED_BTL_TALENT, ARG, "通常形態", L_LV_FIXED, L_TALENTS_FIXED
TRYCCALLFORM ROLE_DEFAULT_BTL_TALENT_%CSTR:ARG:롤%
	CALL SET_BTL_TALENT_DEFAULT, RESULTS, ARG, "通常形態"
CATCH
ENDCATCH

;変身しないロールはここで設定終わり
SIF !GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	RETURN 1
;変身時の固定素質の付与
;固定素質の付与
CALL SET_FIXED_BTL_TALENT, ARG, "変身形態", L_LV_FIXED, L_TALENTS_FIXED

;変身時のデフォルト素質の付与
IF CSTR:ARG:초기변신악마전투소질  != "EMPTY"
	IF CSTR:ARG:초기변신악마전투소질  == ""
		RESULTS = 
		TRYCALLFORM ROLE_DEFAULT_BTL_TALENT_TRANS_%CSTR:ARG:롤%
		SIF RESULTS == ""
			RETURN 0
		CSTR:ARG:초기변신악마전투소질 '= RESULTS
	ENDIF
	CALL SET_BTL_TALENT_DEFAULT, CSTR:ARG:초기변신악마전투소질, ARG, "変身形態"
ENDIF

;=======================================================
;デフォルト素質の付与
;=======================================================
@SET_BTL_TALENT_DEFAULT, ARGS, ARG, ARGS:1 = "通常形態"
#DIM LCOUNT
#DIM L_CAP;キャパシティー最大値
#DIM L_LV, SUB_ROLENUM
#DIMS L_TALENTS, SUB_ROLENUM
#DIM L_LV_FIXED, SUB_ROLENUM
#DIMS L_TALENTS_FIXED, SUB_ROLENUM
#DIM L_COST
SIF ARGS == ""
	RETURN 0
CALL SET_ROLE_CP, ARG
SPLIT ARGS, "/", L_TALENTS
IF ARGS:1 == "通常形態"
	L_CAP = GET_ROLE_CP(ARG, "通常形態")
	FOR LCOUNT, 0, RESULT
		L_LV:LCOUNT = TOINT(AUTO_SPLIT(L_TALENTS:LCOUNT, "_", 1))
		L_TALENTS:LCOUNT = %AUTO_SPLIT(L_TALENTS:LCOUNT, "_", 0)%
		;すでに持っていてそれがデフォルトよりレベルが低い場合はつけ直し判定
		IF TALENT:ARG:(L_TALENTS:LCOUNT) < L_LV:LCOUNT
			TALENT:ARG:(L_TALENTS:LCOUNT) = 0
			CALL SET_ROLE_CP, ARG
			L_CAP = GET_ROLE_CP(ARG, "通常形態")
		ELSE
			CONTINUE
		ENDIF
		;レベルをさげながらコストチェックをして付与していく
		WHILE L_LV:LCOUNT > 0
			L_COST = GET_SUB_ROLE_PROP("COST", L_TALENTS:LCOUNT, , , L_LV:LCOUNT)
			IF L_COST > 0 && L_CAP >= L_COST
				L_CAP -= L_COST
				TALENT:ARG:(L_TALENTS:LCOUNT) = L_LV:LCOUNT
				BREAK
			ENDIF
			L_LV:LCOUNT--
		WEND
	NEXT
ELSE
	L_CAP = GET_ROLE_CP(ARG, "変身形態")
	FOR LCOUNT, 0, RESULT
		L_LV:LCOUNT = TOINT(AUTO_SPLIT(L_TALENTS:LCOUNT, "_", 1))
		L_TALENTS:LCOUNT = %AUTO_SPLIT(L_TALENTS:LCOUNT, "_", 0)%
		;すでに持ってるならとばす
		IF TRANS_BTL_TALENT:ARG:GET_SUB_ROLE_NUM(L_TALENTS:LCOUNT) < L_LV:LCOUNT
			TRANS_BTL_TALENT:ARG:GET_SUB_ROLE_NUM(L_TALENTS:LCOUNT) = 0
			CALL SET_ROLE_CP, ARG
			L_CAP = GET_ROLE_CP(ARG, "変身形態")
		ELSE
			CONTINUE
		ENDIF
		;レベルをさげながらコストチェックをして付与していく
		WHILE L_LV:LCOUNT > 0
			RESULT_F = 0
			L_COST = GET_SUB_ROLE_PROP("COST", L_TALENTS:LCOUNT, , , L_LV:LCOUNT)
			IF L_COST > 0 && L_CAP >= L_COST
				L_CAP -= L_COST
				TRANS_BTL_TALENT:ARG:GET_SUB_ROLE_NUM(L_TALENTS:LCOUNT) = L_LV:LCOUNT
				BREAK
			ENDIF
			L_LV:LCOUNT--
		WEND
	NEXT
ENDIF
CALL SET_ROLE_CP, ARG

;----------------------------------------------------
;ロール固定素質の付与関数
;処理で使えるようにセット状況を変数に渡して返す
;----------------------------------------------------
@SET_FIXED_BTL_TALENT, ARG, ARGS, L_LV_FIXED, L_TALENTS_FIXED
#DIM LCOUNT
#DIM REF L_LV_FIXED
#DIMS REF L_TALENTS_FIXED
RESULTS = 
IF ARGS == "変身形態"
	TRYCCALLFORM ROLE_FIXED_BTL_TALENT_TRANS_%CSTR:ARG:롤%
		SPLIT RESULTS, "/", L_TALENTS_FIXED
		IF RESULTS != ""
			FOR LCOUNT, 0, RESULT
				L_LV_FIXED:LCOUNT = TOINT(AUTO_SPLIT(L_TALENTS_FIXED:LCOUNT, "_", 1))
				L_TALENTS_FIXED:LCOUNT = %AUTO_SPLIT(L_TALENTS_FIXED:LCOUNT, "_", 0)%
				TRANS_BTL_TALENT:ARG:GET_SUB_ROLE_NUM(L_TALENTS_FIXED:LCOUNT) = L_LV_FIXED:LCOUNT
			NEXT
		ENDIF
	CATCH
	ENDCATCH
ELSE
	TRYCCALLFORM ROLE_FIXED_BTL_TALENT_%CSTR:ARG:롤%
		SPLIT RESULTS, "/", L_TALENTS_FIXED
		IF RESULTS != ""
			FOR LCOUNT, 0, RESULT
				L_LV_FIXED:LCOUNT = TOINT(AUTO_SPLIT(L_TALENTS_FIXED:LCOUNT, "_", 1))
				L_TALENTS_FIXED:LCOUNT = %AUTO_SPLIT(L_TALENTS_FIXED:LCOUNT, "_", 0)%
				TALENT:ARG:(L_TALENTS_FIXED:LCOUNT) = L_LV_FIXED:LCOUNT
			NEXT
		ENDIF
	CATCH
	ENDCATCH
ENDIF
;---------------------------------------------------
;CAPACITYのセット関数
;---------------------------------------------------
@SET_ROLE_CP, ARG
#DIM LCOUNT
#DIMS L_TALENTS
#DIMS L_FIXED
ROLE_CP:ARG:0 = GET_ROLE_PROP("CAPACITY", ARG, , "通常形態")
RESULTS =
TRYCALLFORM ROLE_FIXED_BTL_TALENT_%CSTR:ARG:롤%
L_FIXED '= RESULTS
;所持している素質をキャパシティーからひいていく
FOR LCOUNT, 0, SUB_ROLENUM
	L_TALENTS = %GET_SUB_ROLE_NAME(LCOUNT)%
	SIF !GET_BTL_TALENT_LV(L_TALENTS, ARG, "通常形態")
		CONTINUE
	SIF STRCOUNT(L_FIXED, L_TALENTS + "_")
		CONTINUE
	ROLE_CP:ARG:0 -= GET_SUB_ROLE_PROP("COST", L_TALENTS, ARG, "通常形態")
NEXT

;変身しないロールはここで設定終わり
SIF !GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	RETURN 1

RESULTS =
TRYCALLFORM ROLE_FIXED_BTL_TALENT_TRANS_%CSTR:ARG:롤%
L_FIXED '= RESULTS
ROLE_CP_TRANS:ARG:0 = GET_ROLE_PROP("CAPACITY", ARG, , "変身形態")
;所持している素質をキャパシティーからひいていく
FOR LCOUNT, 0, SUB_ROLENUM
	L_TALENTS = %GET_SUB_ROLE_NAME(LCOUNT)%
	SIF !GET_BTL_TALENT_LV(L_TALENTS, ARG, "変身形態")
		CONTINUE
	SIF STRCOUNT(L_FIXED, L_TALENTS + "_")
		CONTINUE
	ROLE_CP_TRANS:ARG:0 -= GET_SUB_ROLE_PROP("COST", L_TALENTS, ARG, "変身形態")
NEXT

;---------------------------------------------------
;キャパシティ容量の確認関数
;---------------------------------------------------
@ROLE_CAPACITY, ARG = -1, ARGS, ARGS:1
#FUNCTION
RESULT_F = 0, 0
CALLFORMF ROLE_CAPACITY_%ARGS%, ARG
IF ARGS:1 == "変身形態"
	RESULT_F:1 += GET_BTL_TALENT_LV("커패시티확대", ARG, ARGS:1)
	RETURNF RESULT_F:1
ELSE
	RESULT_F += GET_BTL_TALENT_LV("커패시티확대", ARG, ARGS:1)
	RETURNF RESULT_F
ENDIF

;---- EDIT 003 ADD START -------------------------
;---------------------------------------------------
;SKILLを使えるかどうかの確認関数
;実際はGET_PROP関数からそのままこれを呼ぶので実際の利用はそちらからを推奨
;---------------------------------------------------
@ROLE_CAN_USE_SKILL, ARG = -1, ARGS, ARGS:1
#FUNCTION
;MPがないロールは常に不可能
CALLFORMF ROLE_HAVE_MP_%ARGS%, ARG
IF ARGS:1 == "変身形態"
	SIF !RESULT_F:1
		RETURNF 0
ELSE
	SIF !RESULT_F
		RETURNF 0
ENDIF
IF ARG >= 0
	;異能者が2以上なら使える
	IF GET_BTL_TALENT_LV("이능자", ARG, ARGS:1) > 1
		RESULT_F = 1, 1
		RETURNF 1
	ENDIF
ENDIF
CALLFORMF ROLE_CAN_USE_SKILL_%ARGS%, ARG
IF ARGS:1 == "変身形態"
	RETURNF RESULT_F:1
ELSE
	RETURNF RESULT_F
ENDIF
;---- EDIT 003 ADD END ---------------------------
;---------------------------------------------------
;装備を使えるかどうかの確認関数
;実際はGET_PROP関数からそのままこれを呼ぶので実際の利用はそちらからを推奨
;---------------------------------------------------
@CAN_USE_EQUIP, ARG = -1, ARGS, ARGS:1
#FUNCTION
IF ARG >= 0
	ARGS '= CSTR:ARG:롤
	SIF CFLAG:ARG:악마변신 && ARGS:1 == ""
		ARGS:1 = 変身形態
ENDIF
RESULT_F = 0, 0
CALLFORMF ROLE_CAN_USE_EQUIP_%ARGS%, ARG

;装備知識によって効果を得てる場合は2をかえさせる
IF SKILL_EQUIPTHEORY_IS_HAVE_SKILL(ARG)
	RESULT_F = RESULT_F == 1 ? 1 # 2
	RESULT_F:1 = RESULT_F:1 == 1 ? 1 # 2
ENDIF

IF ARGS:1 == "変身形態"
	RETURNF RESULT_F:1
ELSE
	RETURNF RESULT_F
ENDIF

;---------------------------------------------------
;装備を使えるかどうかの確認関数
;実際はGET_PROP関数からそのままこれを呼ぶので実際の利用はそちらからを推奨
;---------------------------------------------------
@CAN_USE_PLUGIN, ARG = -1, ARGS, ARGS:1
#FUNCTION
IF ARG >= 0
	;装備知識でアクセサリーが装備出来る場合はプラグインは使えなくなる
	IF SKILL_EQUIPTHEORY_IS_HAVE_SKILL(ARG); && BATTLE_SETTING_IS_EQUIPTHEORY() == 0
		RESULT_F = 0
		RETURNF 0
	ENDIF
	ARGS '= CSTR:ARG:롤
	SIF CFLAG:ARG:악마변신 && ARGS:1 == ""
		ARGS:1 = 変身形態
ENDIF
RESULT_F = 0, 0
CALLFORMF ROLE_CAN_USE_PLUGIN_%ARGS%, ARG
IF ARGS:1 == "変身形態"
	RETURNF RESULT_F:1
ELSE
	RETURNF RESULT_F
ENDIF

;---------------------------------------------------
;銃を装備できるかどうかの確認関数
;実際はGET_PROP関数からそのままこれを呼ぶので実際の利用はそちらからを推奨
;
;装備関数で弾かれた後に使うことを基本的に想定
;---------------------------------------------------
@CAN_EQUIP_GUN, ARG = -1, ARGS, ARGS:1
#FUNCTION
IF ARG >= 0
	;ガンスリンガー持ちは銃を装備できる
	IF GET_BTL_TALENT_LV("건슬링거", ARG, ARGS:1) > 0
		RESULT_F = 1
		RETURNF 1
	ENDIF
	;装備知識持ちは銃を装備できる
	IF SKILL_EQUIPTHEORY_IS_HAVE_SKILL(ARG)
		RESULT_F = 1
		RETURNF 1
	ENDIF
	ARGS '= CSTR:ARG:롤
	SIF CFLAG:ARG:악마변신 && ARGS:1 == ""
		ARGS:1 = 変身形態
ENDIF
RESULT_F = 0, 0
CALLFORMF ROLE_CAN_USE_EQUIP_%ARGS%, ARG
IF ARGS:1 == "変身形態"
	RETURNF RESULT_F:1
ELSE
	RETURNF RESULT_F
ENDIF

;---------------------------------------------------
;銃を撃てるかどうかの確認関数
;実際はGET_PROP関数からそのままこれを呼ぶので実際の利用はそちらからを推奨
;---------------------------------------------------
@CAN_USE_GUN, ARG = -1, ARGS, ARGS:1
#FUNCTION
RESULT_F = 0
SIF EQUIP:ARG:총 == 0
	RETURNF 0
SIF CAN_EQUIP_GUN(ARG, ARGS, ARGS:1)
	RETURNF 0
RESULT_F = 1
RETURNF RESULT_F

