;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_1615,ARG
RESULTS = 원더풀・아쿠에스

;　명중
@SKILL_HITRATE_1615, ARG
RETURN 100

;　威力
@SKILL_POWER_1615, ARG
SIF ARG < 0
	RETURN 225
SIF スキル属性表示中
	RETURN BASE:ARG:ＭＰ * 4 + 225
RETURN FLAG:확산플래그

;　최저공격횟수
@SKILL_MINATTACKNUMBER_1615,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1615,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1615, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1615,ARG
RETURN 1

;　相性
@SKILL_TYPE_1615,ARG
RETURN GET_TYPE_NUM("수격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1615
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_1615, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1615, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_1615,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1615,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_1615, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_1615
RETURN GET_SUCCESSION_NUM("수격")
@継承不能_1615
RETURN 1
;不可

;속도보정
@SKILL_SPEED_1615, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1615
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1615, ARG = -1
RETURN 0



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_1615, ARG, ARG:1, ARG:2

FLAG:확산플래그 = BASE:ARG:ＭＰ * 4 + 225

CALL ATTACK_SINGLE,ARG,POS(ARG:1),1615
BASE:ARG:ＭＰ = 0
FLAG:확산플래그 = 0



;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_1615, ARG
PRINTL 모든 마력을 담아、원더풀한 아쿠에스를 날리는 카나로아의 오의



;使用条件
@SKILL_SPECIAL_ACTIONABLE_1615,ARG
RETURN 1
;とくにない

