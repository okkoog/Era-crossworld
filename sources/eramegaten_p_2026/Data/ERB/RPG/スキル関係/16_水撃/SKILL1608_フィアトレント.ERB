;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_1608,ARG
IF SKILL_CHANGE(ARG, [[キャラ:니토리]])
	RESULTS = 水符｢ｳｫｰﾀｰｶｰﾍﾟｯﾄ｣
ELSE
	RESULTS = 피어트렌트
ENDIF

;　명중
@SKILL_HITRATE_1608, ARG
RETURN 95

;　威力
@SKILL_POWER_1608, ARG
RETURN 290

;　최저공격횟수
@SKILL_MINATTACKNUMBER_1608,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1608,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1608, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1608,ARG
RETURN 24

;　相性
@SKILL_TYPE_1608,ARG
RETURN GET_TYPE_NUM("수격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1608
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_1608, ARG
IF (ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:니토리]]) || ((FLAG:행동순1) > 0 && NO:(FLAG:행동순1) == [[キャラ:니토리]])
	RETURN 1
ELSE
	RETURN 2
ENDIF


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1608, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_1608,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1608,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_1608, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_1608
RETURN GET_SUCCESSION_NUM("수격")

;속도보정
@SKILL_SPEED_1608, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1608
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1608, ARG = -1
RETURN 10


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_1608,ARG
IF SKILL_CHANGE(ARG, [[キャラ:니토리]])
	RETURN 3
ELSE
	RETURN 5
ENDIF

;추가효과상성
@SKILL_ADDTIONAL_TYPE_1608,ARG
IF SKILL_CHANGE(ARG, [[キャラ:니토리]])
	RETURN 9
ELSE
	RETURN 13
ENDIF

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_1608,ARG
RETURN 15

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_1608,ARG
RETURN 30

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_1608, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,1608






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_1608, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:니토리]]
	PRINTL 격류의 물살로 적 전체를 휩쓸어 수격 상성의 물리 대 데미지＋저확률로 혼란。
	PRINTL 요귀　카와시로 니토리의 스펠카드。
ELSE
	PRINTL 적 전체에 수격 상성의 대 데미지를 주고、저확률로 동결시킨다
ENDIF



;使用条件
@SKILL_SPECIAL_ACTIONABLE_1608,ARG
RETURN 1
;とくにない

