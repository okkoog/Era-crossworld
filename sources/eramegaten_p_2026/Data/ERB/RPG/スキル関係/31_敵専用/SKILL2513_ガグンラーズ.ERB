;スキル名
@SKILL_NAME_2513,ARG
IF SKILL_CHANGE(ARG, [[キャラ:브라흐마]]) && CFLAG:ARG:보스플래그 && FLAG:현던전 == 13
	RESULTS = 이터널 제로
ELSEIF SKILL_CHANGE(ARG, [[キャラ:로우히어로]]) && CFLAG:ARG:보스플래그
	RESULTS = 라이트 핸드
ELSEIF SKILL_CHANGE(ARG, [[キャラ:카오스히어로]]) && CFLAG:ARG:보스플래그
	RESULTS = 레프트 핸드
ELSEIF SKILL_CHANGE(ARG, [[キャラ:미카엘]]) && CFLAG:ARG:보스플래그 && FLAG:현던전 == 96
	RESULTS = 신의 가호
ELSEIF SKILL_CHANGE(ARG, [[キャラ:카마조츠]]) && CFLAG:ARG:보스플래그 && FLAG:현던전 == 13
	RESULTS = 마계의 바람
ELSE
	RESULTS = 가군라즈
ENDIF

