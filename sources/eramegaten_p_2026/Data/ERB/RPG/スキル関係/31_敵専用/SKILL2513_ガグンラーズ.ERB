;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2513, ARG, ARG:1, ARG:2
#LOCALSIZE 3

IF SKILL_CHANGE(ARG, [[キャラ:브라흐마]]) && CFLAG:ARG:보스플래그 && FLAG:현던전 == 13
	FOR LOCAL,1,7
		SIF POS(LOCAL) < 0
			CONTINUE
		FOR LOCAL:1,0,6
			CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") = -16
		NEXT
	NEXT
	FOR LOCAL,0,6
		CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") = 32
	NEXT
	PRINTFORML 아군 전체의 전능력을 최대까지 내렸다！
	PRINTFORMW %CALLNAME:ARG%의 전능력이 최대까지 올랐다！
ELSEIF SKILL_CHANGE(ARG, [[キャラ:카오스히어로]]) && CFLAG:ARG:보스플래그
	FOR LOCAL,1,7
		SIF POS(LOCAL) < 0
			CONTINUE
		PRINTFORM 　　TARGET:[{LOCAL,2}] %CALLNAME:POS(LOCAL),20,LEFT%　>>>>>>　
		LOCAL:1 = BASE:POS(LOCAL):ＨＰ * 20/100
		PRINTFORML {LOCAL:1}데미지
		CALL VAR_HP, POS(LOCAL), -LOCAL:1, "食いしばり無効ダメージ", ARG
		FOR LOCAL:1,0,6
			CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") = MAX(-16, CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") - 4)
		NEXT
	NEXT
	PRINTFORMW 아군의 전능력을 내렸다！
ELSEIF SKILL_CHANGE(ARG, [[キャラ:로우히어로]]) && CFLAG:ARG:보스플래그
	FOR LOCAL,0,6
		CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") = MIN(32, CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") + 4)
	NEXT
	CALL SKILL_INVALID_WALL, ARG, ARG:1, "ARG", "단체", "NOMES"
	PRINTFORML %CALLNAME:ARG%의 전능력이 오르고、모든 공격을 무효화하게 되었다！
ELSEIF SKILL_CHANGE(ARG, [[キャラ:미카엘]]) && CFLAG:ARG:보스플래그 && FLAG:현던전 == 96
	FOR LOCAL,0,6
		CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") = MIN(32, CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") + 4)
	NEXT
	FOR LOCAL , 0 , TYPENUM
		CALL SKILL_WALL , ARG , GET_TYPE(LOCAL) , CPOS(ARG) , 1 , "非表示"
	NEXT
	PRINTFORML %CALLNAME:ARG%의 전능력이 오르고、전속성 무효화！
ELSEIF SKILL_CHANGE(ARG, [[キャラ:카마조츠]]) && CFLAG:ARG:보스플래그 && FLAG:현던전 == 13
	CALL ACTION_1032,ARG,19
	CALL ACTION_1732,ARG,19
ELSE
	CFLAG:ARG:크리티컬강화 = 8
	FOR LOCAL, 1, 7
		SIF !IS_TARGET_ABLE(POS(LOCAL))
			CONTINUE
		CFLAG:POS(LOCAL):검격무효화횟수 = 0
		CFLAG:POS(LOCAL):전격무효화횟수 = 0
		CFLAG:POS(LOCAL):물리반사플래그 = 0
		CFLAG:POS(LOCAL):마법반사플래그 = 0
		CFLAG:POS(LOCAL):수호의방패 = 0
		;CFLAG:POS(LOCAL):방어강화 = MAX(-16, CFLAG:POS(LOCAL):방어강화 - 4)
	NEXT
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어", -4, "範囲"
	;PRINTFORMW 味方の防御力が下がった！
ENDIF



