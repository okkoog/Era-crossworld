;セト専用
;非常に高いクリティカル率を誇る万能物理属性攻撃
;命中弱体の影響を倍受けるので、弱体しとこうという感じに

;スキル名
@SKILL_NAME_2574,ARG
RESULTS = 어게인스트페인

;　명중
@SKILL_HITRATE_2574, ARG
SIF ARG == -1
	RETURN 100
;通常のンダに加えて判定を受ける
SIF CFLAG:ARG:명중강화 < 0
	RETURN 100 * MAX(32, 64 + CFLAG:ARG:명중강화) / 64
RETURN 100
;　威力
@SKILL_POWER_2574, ARG
RETURN 500

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2574,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2574,ARG
RETURN 1

@SKILL_CRITICAL_RATE_2574, ARG
RETURN 60
;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2574, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2574,ARG
RETURN 0

;　相性
@SKILL_TYPE_2574,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2574
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2574, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2574, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2574,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2574,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2574, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입 継承不能
@SKILL_SUCCESSION_TYPE_2574
RETURN GET_SUCCESSION_NUM("만능")
;속도보정
@SKILL_SPEED_2574, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2574
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2574, ARG = -1
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2574,ARG
RETURN 0


;추가효과상성
@SKILL_ADDTIONAL_TYPE_2574,ARG
RETURN 0

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2574,ARG
RETURN 0

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2574,ARG
RETURN 0

@敵専用_2574
RETURN 1
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2574, ARG, ARG:1, ARG:2
CALL ATTACK_SINGLE, ARG, POS(ARG:1), 2574






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2574, ARG
PRINTL 적 １체에 만능 상성의 데미지를 준다
PRINTL 크리티컬률이 매우 높다



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2574,ARG
RETURN 1
;とくにない

