;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2573,ARG
RESULTS = 원초의암흑

;　명중
@SKILL_HITRATE_2573, ARG
RETURN 50+(FLAG:경과턴수*4)

;　威力
@SKILL_POWER_2573, ARG
RETURN 200+(FLAG:경과턴수*2)

;　クリティカル率
@SKILL_CRITICAL_RATE_2573, ARG
RETURN (FLAG:경과턴수)

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2573,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2573,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2573, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2573,ARG
RETURN 60

;　相性
@SKILL_TYPE_2573,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2573
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2573, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2573, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2573,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2573,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2573, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2573
RETURN GET_SUCCESSION_NUM("만능")

;속도보정
@SKILL_SPEED_2573, ARG = -1
RETURN 20

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2573
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2573, ARG = -1
RETURN 11

@敵専用_2573
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2573, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,2573

IF CFLAG:ARG:회피강화 > 1
	CFLAG:ARG:회피강화 /= 2
	PRINTFORMW %CALLNAME:ARG%의 회피력이 내렸다！
ENDIF
IF CFLAG:ARG:방어강화 > 1
	CFLAG:ARG:방어강화 /= 2
	PRINTFORMW %CALLNAME:ARG%의 방어력이 내렸다！
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2573, ARG
PRINTL 적 전체에 만능 상성의 대 데미지、경과 턴 수로 위력이 오른다。
PRINTL 단 사용 후는 방어력・회피력의 강화가 약해진다。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2573,ARG
RETURN 1
;とくにない

