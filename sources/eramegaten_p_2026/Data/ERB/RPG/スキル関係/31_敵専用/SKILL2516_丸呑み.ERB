;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2516, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)

PRINTFORM 　　TARGET:[{CPOS(LOCAL),2}] %CALLNAME:(LOCAL),20,LEFT%　>>>>>>　

CALL BTL_JUDG_HIT, ARG, LOCAL, 20, GET_TYPE_NUM("만능"), 1, 1
IF RESULT == 1 || CFLAG:LOCAL:상태이상 == GET_STATE_NUM("SLIP")
	CFLAG:ARG:HP흡수량 = BASE:LOCAL:ＨＰ / 2
	BASE:LOCAL:ＨＰ = 0
	PRINTL DYING
	CFLAG:LOCAL:상태이상 = GET_STATE_NUM("DYING")
	CALL DEAD_CHARA,LOCAL,ARG
ELSE
	;外した
	PRINTW MISS
ENDIF




