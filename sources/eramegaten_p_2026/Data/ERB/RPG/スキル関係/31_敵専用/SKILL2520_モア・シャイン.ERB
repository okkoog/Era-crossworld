;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2520, ARG, ARG:1, ARG:2
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ATTACK_FIELD,ARG,ARG:1,2520

	FOR LOCAL,1,7
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS < 0
			CONTINUE
		CFLAG:(FLAG:LOCALS):방어플래그 = 0
	NEXT
	PRINTW 아군의 방어태세를 해제했다！

