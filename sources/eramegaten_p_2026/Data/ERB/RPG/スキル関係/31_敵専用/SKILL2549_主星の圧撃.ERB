;-------------------------------------------------------------------------------
; [メモ]
; 敵専用対単体スキルなので強め。
; 当たれば必ずクリティカル。
;-------------------------------------------------------------------------------

;スキル名
@SKILL_NAME_2549,ARG
RESULTS = 주성의압격

;　명중
@SKILL_HITRATE_2549, ARG
RETURN 100

;　威力
@SKILL_POWER_2549, ARG
RETURN 400

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2549,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2549,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2549, ARG
RETURN GET_SKILL_COST_TYPE_NUM("HP")
;消費なし＝1

;　コストの量
@SKILL_COST_2549,ARG
RETURN 0

;　相性
@SKILL_TYPE_2549,ARG
RETURN GET_TYPE_NUM("타격")

@SKILL_CRITICAL_RATE_2549, ARG
RETURN 100

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2549
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2549, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2549, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2549,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2549,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2549, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2549
RETURN GET_SUCCESSION_NUM("타격")

;속도보정
@SKILL_SPEED_2549, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2549
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2549, ARG = -1
RETURN 23



@敵専用_2549
RETURN 1
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2549, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,2549






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2549, ARG
PRINTL 적 １체에 명중하면 반드시 크리티컬이 되는 물리공격을 행한다。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2549,ARG
RETURN 1
