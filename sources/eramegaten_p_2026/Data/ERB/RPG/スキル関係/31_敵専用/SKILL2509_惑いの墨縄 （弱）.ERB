;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2509, ARG, ARG:1, ARG:2
#LOCALSIZE 3


FOR LOCAL, 1, 7
	SIF POS(LOCAL) < 0
		CONTINUE
	SIF CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("DYING")
		CONTINUE
	IF RAND:2
		PRINTFORMW 　　TARGET:[{LOCAL,2}] %CALLNAME:POS(LOCAL),20,LEFT%　>>>>>>　BIND
		CFLAG:POS(LOCAL):상태이상 = GET_STATE_NUM("BIND")
		CFLAG:POS(LOCAL):상태이상경과턴수 = 0
	ELSE
		PRINTFORMW 　　TARGET:[{LOCAL,2}] %CALLNAME:POS(LOCAL),20,LEFT%　>>>>>>　Miss
	ENDIF
NEXT




