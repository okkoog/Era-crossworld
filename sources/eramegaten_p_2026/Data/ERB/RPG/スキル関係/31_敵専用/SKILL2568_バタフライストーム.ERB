;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2568,ARG
RESULTS = 버터플라이스톰

;　명중
@SKILL_HITRATE_2568, ARG
RETURN 100

;　威力
@SKILL_POWER_2568, ARG
RETURN 460

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2568,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2568,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2568, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2568,ARG
RETURN 1

;　相性
@SKILL_TYPE_2568,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2568
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2568, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2568, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2568,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2568,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2568, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2568
RETURN GET_SUCCESSION_NUM("만능")

;속도보정
@SKILL_SPEED_2568, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2568
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2568, ARG = -1
RETURN 10


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2568,ARG
A = RAND:4
IF A == 0
	RETURN GET_STATE_NUM("HAPPY")
ELSEIF A == 1
	RETURN GET_STATE_NUM("CHARM")
ELSEIF A == 2
	RETURN GET_STATE_NUM("SLEEP")
ELSE
	RETURN GET_STATE_NUM("PANIC")
ENDIF

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2568,ARG
RETURN 9

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2568,ARG
RETURN 40

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2568,ARG
RETURN 60

@敵専用_2568
RETURN 1
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2568, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,2568






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2568, ARG
PRINTL 적 전체에 특대 데미지+정신계 스테이터스 이상



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2568,ARG
RETURN 1
;とくにない

