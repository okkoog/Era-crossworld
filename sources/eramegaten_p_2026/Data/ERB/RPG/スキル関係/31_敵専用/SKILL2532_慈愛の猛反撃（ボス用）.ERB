;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;
;慈愛の猛反撃:自分以外の味方が攻撃を受けていたら反撃
;====================================================
@SKILL_COUNTER_ACTIONABLE_2532,ARG,ARG:1
#DIM L_T
#DIM ループ用
#DIM ぶん殴りスイッチ
ぶん殴りスイッチ = 0
FOR ループ用, 0, BCHARANUM
	L_T = BCHARA:ループ用
	SIF L_T < 0
		CONTINUE
	;自分自身は除外
	SIF ARG == L_T
		CONTINUE
	;ダメージを受けているのが敵ならパス
	SIF !IS_FRIEND(ARG, L_T)
		CONTINUE
	;SIF POS(ループ用) < 0 || POS(ループ用) == ARG
		;CONTINUE
	;誰かが攻撃をHITさせられていたら
	SIF GET_CREC_ACT(ARG:1, L_T, "HIT")
		RETURN 1, CPOS(ARG:1)
	;味方のうち誰かが被弾していたら反撃フラグを立てる
	;IF GETBIT(CFLAG:(POS(ループ用)):受けフラグ,18) || GETBIT(CFLAG:(POS(ループ用)):受けフラグ,19)
		;ぶん殴りスイッチ = 1
		;BREAK
	;ENDIF
NEXT
RETURN 0
;SIF ぶん殴りスイッチ < 1
;	RETURN 0
;SIF ARG:1 < 0 || GET_STATE(CFLAG:(ARG:1):상태이상) == "DYING"
;	RETURN 0
;RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_2532, ARG, ARG:1, ARG:2
TFLAG:필중 = 1
TFLAG:반사0데미지화 = 1
TFLAG:흡수0데미지화 = 1
CALL ATTACK_SINGLE, ARG, POS(ARG:1), 2532
TFLAG:필중 = 0
TFLAG:반사0데미지화 = 0
TFLAG:흡수0데미지화 = 0

