;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2546, ARG, ARG:1, ARG:2
#LOCALSIZE 2
;コストを支払う
;CALL VAR_MP,ARG,-30
FOR LOCAL,1, 17
	SIF POS(LOCAL) == -1
		CONTINUE
	SIF GET_STATE(CFLAG:POS(LOCAL):상태이상) == "DYING"
		CONTINUE
	FOR LOCAL:1, 0, TYPENUM+1
		CFLAG:POS(LOCAL):(GET_TYPE(LOCAL:1)+"무효화횟수") = IS_FRIEND(ARG, POS(LOCAL)) ? 3 # 0
		CFLAG:POS(LOCAL):(GET_TYPE(LOCAL:1)+"가드킬") = IS_FRIEND(ARG, POS(LOCAL)) ? 0 # 2
	NEXT
	PRINTFORML [{LOCAL}]%CALLNAME:POS(LOCAL),20% >>>>> \@IS_FRIEND(ARG, POS(LOCAL)) ? 모든 공격을 각각 ３회까지 무효화 # 2턴、모든 내성을 무효화\@
NEXT
WAIT
