;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2507, ARG, ARG:1, ARG:2
FOR LOCAL,1,7
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0 || FLAG:LOCALS == ARG
		CONTINUE
	SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
		CONTINUE
	RESULT = 0
	CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:(FLAG:LOCALS):입력행동, FLAG:LOCALS
	IF RESULT == 2 || RESULT == 5
		PRINTFORML 　　TARGET:[{CPOS(FLAG:LOCALS),2}] %CALLNAME:(FLAG:LOCALS),20,LEFT%　>>>>>>　회복 행동이 봉쇄되었다！
		CFLAG:(FLAG:LOCALS):입력행동 = -1
	ENDIF
NEXT



