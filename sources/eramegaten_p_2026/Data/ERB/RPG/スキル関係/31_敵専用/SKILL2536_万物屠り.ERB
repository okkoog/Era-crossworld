RETURN 1000

;　威力
@SKILL_POWER_2536, ARG
RETURN 250

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2536,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2536,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2536, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_2536,ARG
RETURN 30

;　相性
@SKILL_TYPE_2536,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2536
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2536, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　1物理 2魔法 3銃 4アイテム 5割合
@SKILL_ATTACKTYPE_2536, ARG
RETURN GET_攻撃タイプ_NUM("割合")

;ARG:5 割合計算　0-現在HP　1-最大HP　-1-現在HP(不殺)　-2-最大HP(不殺)
@SKILL_RATE_DAMAGETYPE_2536,ARG
RETURN 1

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2536, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2536,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2536,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2536, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2536
RETURN GET_SUCCESSION_NUM("만능")

;속도보정
@SKILL_SPEED_2536, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2536
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2536, ARG = -1
RETURN 23


;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_2536, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격/방어/마법위력/마법효과/명중/회피", -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2536, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG, ARG:1, 2536


;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2536, ARG
PRINTL 적 전체에 비율 데미지。
PRINTL 공격에 성공했을 경우、모든 스테이터스를 저하시킨다。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2536,ARG
RETURN 1
;とくにない

@敵専用_2536
RETURN 1

