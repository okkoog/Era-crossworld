;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2523, ARG, ARG:1, ARG:2
;CALL PAY_COST,ARG,2523



FOR LOCAL,1,7
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0
		CONTINUE
	SIF CFLAG:(FLAG:LOCALS):상태이상 != GET_STATE_NUM("BRAND")
		CONTINUE
	PRINTFORM 　　TARGET:[{LOCAL,2}] %CALLNAME:(FLAG:LOCALS),20,LEFT%　>>>>>>　
	BASE:(FLAG:LOCALS):ＨＰ = 0
	PRINTL DYING
	CFLAG:(FLAG:LOCALS):상태이상 = GET_STATE_NUM("DYING")
	CALL DEAD_CHARA,(FLAG:LOCALS),ARG



NEXT



;====================================================
;実行内容ここまで
