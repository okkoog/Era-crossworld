;-------------------------------------------------------------------------------
; [メモ]
; ライセンスフリー。
; 敵専用なので強め。
; 全体攻撃（必中）、消費ゼロ
;-------------------------------------------------------------------------------

;スキル名
@SKILL_NAME_2562,ARG
RESULTS = 독소방어

;　명중
@SKILL_HITRATE_2562, ARG
RETURN 9999

;　威力
@SKILL_POWER_2562, ARG
RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2562,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2562,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2562, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2562,ARG
RETURN 0

;　相性
@SKILL_TYPE_2562,ARG
RETURN GET_TYPE_NUM("신경")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2562
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2562, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2562, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2562,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2562,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2562, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2562
RETURN GET_SUCCESSION_NUM("신경")

;속도보정
@SKILL_SPEED_2562, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2562
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2562, ARG = -1
RETURN 0

@敵専用_2562
RETURN 1
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2562, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,2562

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_2562, ARG
PRINTL 적 전체에 독소로 중 데미지。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_2562,ARG
RETURN 1
;とくにない

