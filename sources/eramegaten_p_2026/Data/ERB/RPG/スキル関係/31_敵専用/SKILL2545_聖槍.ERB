;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2545, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
LOCAL:1 = BASE:LOCAL:ＨＰ
CALL ATTACK_SINGLE, ARG, LOCAL,2545
IF LOCAL:1 > BASE:LOCAL:ＨＰ && GET_STATE(CFLAG:LOCAL:상태이상) != "DYING"
	;IF TALENT:LOCAL:이능자 || TALENT:LOCAL:달인 || TALENT:LOCAL:페르소나구사자 || ABL:LOCAL:종족 > 0 || TALENT:ARG:쿠즈노하
	IF GET_ROLE_PROP("CAN_USE_SKILL", ARG, , "両形態")
		CFLAG:LOCAL:롱기누스 = 3
		PRINTFORMW 　　TARGET:[{ARG:1,2}] %CALLNAME:LOCAL,20,LEFT%　>>>>>>　이능력이 봉해졌다！
	ENDIF
ENDIF






