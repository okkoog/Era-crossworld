@ACTION_2533, ARG, ARG:1, ARG:2
#LOCALSIZE 3
#DIM L_P
#DIM L_T
#DIM L_DMG
#DIM L_CRT
#DIM L_相性値
SIF CFLAG:ARG:PT플래그 > 0
	RETURN 0
;2022/10/11 なるべく処理を本筋のものに寄せつつ、COOPの引き値ミスなどを修正
IF SKILL_CHANGE(ARG, [[キャラ:미카엘]]) && CFLAG:ARG:보스플래그 && FLAG:현던전 == 96
	L_T = POS(ARG:1)
	;LOCAL	ダメージ量
	;LOCAL:1クリティカルフラグ
	;LOCAL:2ターゲット
	;敵単体に50％の割合ダメージ(下限500)+필중+낙인　食いしばり無効
	PRINTFORM 　　TARGET:[{ARG:1,2}] %CALLNAME:L_T,20,LEFT%　>>>>>>　
	L_DMG = MAX(BASE:L_T:ＨＰ * 50/100,500)
	;気合状態で90%(下限900)
	SIF CFLAG:ARG:気合フラグ
		L_DMG = MAX(BASE:L_T:ＨＰ * 90/100,900)
	;物理クリティカル判定
	L_CRT = 0
	CALL BTL_JUDG_CRT, L_P, L_T, 5, 1, 1
	L_CRT = RESULT
	SIF L_CRT
		PRINT 《CRITICAL》
	PRINTFORM {L_DMG}데미지
	CALL VAR_HP, L_T, -L_DMG, "食いしばり無効ダメージ", ARG
	IF L_T > -1 && CFLAG:(ARG:1):상태이상 != GET_STATE_NUM("DYING")
		PRINT  & 
		CALL CALC_BADSTATE_MULTI, ARG, L_T, , GET_TYPE_NUM("파마"), GET_STATE_NUM("BRAND")
		L_相性値 = RESULT
		IF CHECK_WEAKNESS(L_相性値) < -1
			PRINT BLOCK
		ELSE
			CALL JUDG_BADSTATE, L_P, L_T, GET_STATE_NUM("BRAND"), GET_TYPE_NUM("파마"), L_相性値, 80, 100
			IF RESULT
				CALL SET_BAD_STATE, L_P, L_T, GET_STATE_NUM("BRAND")
			ELSE
				PRINT MISS
			ENDIF
		ENDIF
	ENDIF
	CALL BTL_CALC_DAMAGE_COOP(L_P, L_T, L_DMG, GET_TYPE_NUM("만능"), 1, L_CRT, 500)
	CFLAG:ARG:気合フラグ = 0
	WAIT
	;LOCAL	ダメージ量
	;LOCAL:1クリティカルフラグ
	;LOCAL:2ターゲット
	;敵単体に50％の割合ダメージ(下限500)+필중+낙인　食いしばり無効
	;PRINTFORM 　　TARGET:[{ARG:1,2}] %CALLNAME:POS(ARG:1),20,LEFT%　>>>>>>　
	;LOCAL = MAX(BASE:POS(ARG:1):ＨＰ * 50/100,500)
	;気合状態で90%(下限900)
	;SIF CFLAG:ARG:気合フラグ
	;	LOCAL = MAX(BASE:POS(ARG:1):ＨＰ * 90/100,900)
	;物理クリティカル判定
	;LOCAL:1 = 0
	;IF RAND:100 < 5 * (10 + MAXBASE:ARG:운)/(10 + MAXBASE:(ARG:1):운) * (CFLAG:ARG:크리티컬강화+8)/8/(((HAVE_SKILL(POS(ARG:1),[[스킬:코칭]]) > 0 + HAVE_SKILL(POS(ARG:1),[[스킬:서드아이]])>0))+1)*((HAVE_SKILL(ARG,[[스킬:어드바이스]])>0 + HAVE_SKILL(ARG,[[스킬:서드아이]])>0)+1) * (CFLAG:ARG:회심의패기플래그*20+CFLAG:ARG:크리티컬보정+100) / 100
	;	PRINT 《CRITICAL》 
	;	LOCAL:1 = 2
	;ENDIF
	;LOCAL:2 = POS(ARG:1)
	
	;PRINTFORM {LOCAL}데미지
	;CALL VAR_HP(LOCAL:2, -LOCAL, 0)
	;IF LOCAL:2 > -1 && CFLAG:(ARG:1):상태이상 != GET_STATE_NUM("DYING")
	;	PRINT  & 
	;	CALL ATTACK_BADSTATE, ARG, LOCAL:2, 20, 10, 80, 100
	;ENDIF
	;CALL BTL_CALC_DAMAGE_COOP(ARG:0, LOCAL:2, LOCAL, 17, 1, LOCAL:1, 500)
	;CALL BTL_CALC_DAMAGE_COOP(ARG:0, LOCAL:2, LOCAL:1, 17, 1, 4, 500)
	;CFLAG:ARG:気合フラグ = 0
	;WAIT
ENDIF




