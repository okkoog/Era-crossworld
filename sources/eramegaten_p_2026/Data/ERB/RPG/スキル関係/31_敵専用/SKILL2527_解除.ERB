@ACTION_2527, ARG, ARG:1, ARG:2
IF SKILL_CHANGE(ARG, [[キャラ:카마조츠]]) && CFLAG:ARG:보스플래그 && FLAG:현던전 == 13
				MAXBASE:ARG:검격 = 50
				MAXBASE:ARG:타격 = 999
				MAXBASE:ARG:비구 = 50
				MAXBASE:ARG:전술 = 100
				MAXBASE:ARG:화염 = 100
				MAXBASE:ARG:빙결 = 100
				MAXBASE:ARG:전격 = 120
				MAXBASE:ARG:충격 = 0
				MAXBASE:ARG:파마 = 120
				MAXBASE:ARG:주살 = 100
				MAXBASE:ARG:지변 = 0
				MAXBASE:ARG:질풍 = 0
				MAXBASE:ARG:수격 = 100
				MAXBASE:ARG:중력 = 120
				MAXBASE:ARG:핵열 = 100
				MAXBASE:ARG:만능 = 100
				MAXBASE:ARG:사이코 = 100
				BASE:ARG:검격 = 50
				BASE:ARG:비구 = 999
				BASE:ARG:타격 = 50
				BASE:ARG:전술 = 100
				BASE:ARG:화염 = 100
				BASE:ARG:빙결 = 100
				BASE:ARG:전격 = 120
				BASE:ARG:충격 = 0
				BASE:ARG:파마 = 120
				BASE:ARG:주살 = 100
				BASE:ARG:지변 = 0
				BASE:ARG:질풍 = 0
				BASE:ARG:수격 = 100
				BASE:ARG:중력 = 120
				BASE:ARG:핵열 = 100
				BASE:ARG:만능 = 100
				BASE:ARG:사이코 = 100
				CFLAG:ARG:물리피데미지보정 = 0
				CFLAG:ARG:마법피데미지보정 = 0
				CFLAG:ARG:지변피데미지보정 = 0
		CFLAG:ARG:크리티컬무효플래그 = 0
				
				CFLAG:ARG:1291 = 0
				;CFLAG:ARG:애널라이즈불가 = 0
				PRINTW ＞약점을 찔려 내성이 원래대로 돌아갔다
ELSEIF SKILL_CHANGE(ARG, [[キャラ:라후]]) && CFLAG:ARG:보스플래그 && FLAG:현던전 == 13
		LOCAL = POS(CFLAG:ARG:802)
		LOCAL:1 = MAXBASE:LOCAL:ＨＰ * 8/100
		LOCAL:2 = MAXBASE:LOCAL:ＭＰ * 4/100
	IF BASE:ARG:ＨＰ < 2 || (CFLAG:ARG:803 - BASE:ARG:ＨＰ) > CFLAG:ARG:804 || BASE:LOCAL:ＨＰ < 1 || CFLAG:ARG:804 == 0
				LOCAL = POS(CFLAG:ARG:802)
				SIF CFLAG:LOCAL:상태이상 == GET_STATE_NUM("HEAT")
					CFLAG:LOCAL:상태이상 = 0
				CFLAG:LOCAL:상태이상경과턴수 = 0
				CFLAG:LOCAL:회복불능플래그 = 0
				CFLAG:LOCAL:물리피데미지보정 = 0
				CFLAG:LOCAL:마법피데미지보정 = 0
				
				CFLAG:ARG:불사신플래그 = 0
				CFLAG:ARG:801 = FLAG:경과턴수 + 3
				CFLAG:ARG:802 = 0
				SIF CFLAG:ARG:입력행동 > -1
					CFLAG:ARG:입력행동 = 2512
				CALL RANDOM_TARGET,ARG,2512
				
				PRINTFORMW ＞%LOCAL은% 해제되었다
	ELSE
				CFLAG:LOCAL:상태이상 = GET_STATE_NUM("HEAT")
				CFLAG:LOCAL:상태이상경과턴수 = 0
				CFLAG:LOCAL:회복불능플래그 = 99
		PRINTFORML 　　TARGET:[{CPOS(LOCAL),2}] %CALLNAME:LOCAL ,20,LEFT%　>>>>>>　{LOCAL:1}
		PRINTFORML 　　TARGET:[{CPOS(LOCAL),2}] %CALLNAME:LOCAL ,20,LEFT%　>>>>>>　MP{LOCAL:2}
		CALL VAR_HP,LOCAL,-LOCAL:1,"食いしばり無効ダメージ"
		CALL VAR_MP,LOCAL,-LOCAL:2,"ダメージ"
		PRINTFORML 　ATTACKER:[{CPOS(ARG),2}] %CALLNAME:ARG ,20,LEFT%　>>>>>>　{LOCAL:1}회복
		PRINTFORMW 　ATTACKER:[{CPOS(ARG),2}] %CALLNAME:ARG ,20,LEFT%　>>>>>>　MP{LOCAL:2}회복
		CALL VAR_HP,ARG,LOCAL:1,"회복"
		CALL VAR_MP,ARG,LOCAL:2,"회복"
		SIF BASE:LOCAL:ＨＰ < 1
			RESTART
	ENDIF
ENDIF
PRINTL


