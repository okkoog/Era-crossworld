;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_2527,ARG,ARG:1
IF SKILL_CHANGE(ARG, [[キャラ:카마조츠]]) && CFLAG:ARG:보스플래그 && FLAG:현던전 == 13
	;SIF CFLAG:ARG:802 < 1 && CFLAG:(ARG:1):입력행동 == 1312
	;	CFLAG:ARG:802 = 1
	;SIF MAXBASE:ARG:파마 > 100
	;	RETURN 0
	;;SIF !GETBIT(CFLAG:ARG:受けフラグ,CFLAG:ARG:854 - CFLAG:ARG:850 + CFLAG:ARG:850/6)
	;;	RETURN 0
	;SIF !GETBIT(CFLAG:ARG:受けフラグ,22)
	;	RETURN 0
	SIF CFLAG:ARG:802 < 1 && CFLAG:ARG:입력행동 == [[스킬:세라픽로어]]
		CFLAG:ARG:802 = 1
	SIF MAXBASE:ARG:파마 > 100 || BASE:ARG:파마 > 100
		RETURN 0
	;弱点攻撃を受けてない場合は戻る
	SIF !GET_CREC_ACT(ARG:1, ARG, "WEAK")
		RETURN 0
ELSEIF SKILL_CHANGE(ARG, [[キャラ:라후]]) && CFLAG:ARG:보스플래그 && FLAG:현던전 == 13
	SIF CFLAG:ARG:802 < 1
		RETURN 0
	;SIF (CFLAG:ARG:803 - BASE:ARG:ＨＰ) > CFLAG:ARG:804
	;	RETURN 1
	;SIF BASE:ARG:ＨＰ < 1
	;	RETURN 1
	;RETURN 0
	LOCAL:3 = 0
	FOR LOCAL:2,0,10
		LOCALS = 포지션{LOCAL:2+7}
		SIF FLAG:LOCALS < 0
			CONTINUE
		SIF BASE:(FLAG:LOCALS):ＨＰ < 1
			CONTINUE
		LOCAL:3 ++
	NEXT
	SIF LOCAL:3 < 2
		CFLAG:ARG:804 = 0
ELSE
	RETURN 0
ENDIF
RETURN 1

