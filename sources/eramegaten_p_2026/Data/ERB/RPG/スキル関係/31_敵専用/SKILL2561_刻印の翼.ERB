;スキル名
@SKILL_NAME_2561,ARG
RESULTS = 각인의날개

;　명중
@SKILL_HITRATE_2561, ARG
RETURN 100

;　威力
@SKILL_POWER_2561, ARG
RETURN 200

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2561,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2561,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2561, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2561,ARG
RETURN 35

;　相性
@SKILL_TYPE_2561,ARG
RETURN GET_TYPE_NUM("신경")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2561
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2561, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2561, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2561,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2561,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2561, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2561
RETURN GET_SUCCESSION_NUM("신경")
;レア

;속도보정
@SKILL_SPEED_2561, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2561
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2561, ARG = -1
RETURN 23



;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2561,ARG
RETURN GET_STATE_NUM("PALYZE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2561,ARG
RETURN GET_TYPE_NUM("신경")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2561,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2561,ARG
RETURN 90


@敵専用_2561
RETURN 1
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2561, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,2561







