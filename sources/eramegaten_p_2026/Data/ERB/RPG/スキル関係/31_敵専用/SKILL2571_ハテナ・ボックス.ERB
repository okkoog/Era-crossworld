;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2571, ARG, ARG:1, ARG:2

;実行
; メッセージの表示
PRINTFORMW 　　상자에서 무언가가 튀어나왔다!

; LOCAL:2は驚いた人数。誰も驚かなかった時のメッセージ表示用
LOCAL:2 = 0

; ポジション1から6（味方側全体）だけループ
; 敵専用スキルなので味方が使う場合は考慮していない
FOR LOCAL, 1, 7
	
	; LOCALSにポジションにいるキャラを取得
	LOCALS = 포지션{LOCAL}
	LOCAL:1 = FLAG:LOCALS
	
	; 誰もいなかったらCONTINUE
	SIF LOCAL:1 < 0
		CONTINUE
	
	; いるのが悪魔の場合
	IF ABL:(LOCAL:1):종족 > 0 && CFLAG:(LOCAL:1):소속ＣＯＭＰ != -1
		
		; とりあえず原作設定として冷静な悪魔には効かない
		; （他にも回避条件つけるかもなので上と条件文わけた）
		
		; 冷静でなかった場合
		IF TALENT:(LOCAL:1):냉정 == 0
		
			; 右が確率、今は95%にとりあえず設定
			; 臆病持ってたら確率上昇とかでもいいかもしれませんね
			IF RAND:100 < 95
				
				; ポジションを外す（リターン同等処理）
				CALL REMOVE_POSITION, CFLAG:(LOCAL:1):포지션
				
				; メッセージの表示
				PRINTFORMW 　　%CALLNAME:(LOCAL:1)%은(는) 놀라서 COMP로 돌아가 버렸다!
				
				LOCAL:2 = LOCAL:2 + 1
			ENDIF
		ENDIF
	ENDIF
NEXT

; メッセージの表示
SIF LOCAL:2 == 0
	PRINTFORMW 　　아무도 놀라지 않았다…



