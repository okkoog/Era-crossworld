;ターゲット条件
@SKILL_IS_VALID_TARGET_409,ARG, ARG:1
SIF POS(ARG) < 0
	RETURN 0
CALL SKILL_CURE_STATE_409,(CFLAG:(POS(ARG)):상태이상)
RETURN RESULT

