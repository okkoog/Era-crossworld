;何のバッドステータスを治せるか
@SKILL_CURE_STATE_409,ARG
SELECTCASE GET_STATE(ARG)
	CASE "HAPPY","BIND","PANIC","SLEEP","BOMB"
		RETURN 1
	CASEELSE
		RETURN 0
ENDSELECT

