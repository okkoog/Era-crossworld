;使用条件
@SKILL_SPECIAL_ACTIONABLE_423, ARG
RETURN 1
;とくにない

;ターゲット条件
@SKILL_IS_VALID_TARGET_423, ARG, ARG:1
IF CFLAG:(ARG:1):PT플래그
	;魅了されているときは使わない
	IF IS_BADSTATE(ARG:1, "CHARM")
		RETURN 0
	ELSE
		;味方のときは基本的に有効度不問
		RETURN 1
	ENDIF
ELSE
	SIF POS(ARG) < 0
		RETURN 0
	CALL SKILL_CURE_STATE_423,(CFLAG:ARG:상태이상)
	RETURN RESULT
ENDIF

;控えに使えるか
@SKILL_T_RESERVE_423, ARG
RETURN 0

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_423,ARG
SELECTCASE GET_STATE(ARG)
	CASE "DYING"
		RETURN 1
	CASEELSE
		RETURN 0
ENDSELECT

