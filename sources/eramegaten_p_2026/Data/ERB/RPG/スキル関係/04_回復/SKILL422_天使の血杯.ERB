;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_422, ARG, ARG:1, ARG:2
#DIM LCOUNT
#DIM L_T
#DIM L_HEAL, 2
#DIM L_PT_NUM
L_PT_NUM = 0
;MP回復対象で効果量を配分するので人数を取得する
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	;自分自身は対象外
	SIF L_T == ARG
		CONTINUE
	;最大MPが0の味方も対象外
	SIF !MAXBASE:L_T:ＭＰ
		CONTINUE
	L_PT_NUM++
NEXT
;基本回復量
IF L_PT_NUM
	L_HEAL = MAXBASE:ARG:ＭＰ / 4 / L_PT_NUM
ELSE
	L_HEAL = 0
ENDIF
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	SIF !MAXBASE:L_T:ＭＰ
		CONTINUE
	IF L_T == ARG
		CALL PRINT_HIT_MESSAGE, L_T, @"{MAXBASE:ARG:ＭＰ / 4}의 ＭＰ를 분배했다", "L"
		CALL VAR_MP, L_T, -MAXBASE:ARG:ＭＰ / 4, "회복"
	ELSE
		L_HEAL:1 = MIN(L_HEAL + BASE:L_T:ＭＰ, MAXBASE:L_T:ＭＰ) - BASE:L_T:ＭＰ
		CALL PRINT_HIT_MESSAGE, L_T, @"{L_HEAL:1}회복", "L"
		CALL VAR_MP, L_T, L_HEAL:1, "회복"
	ENDIF
NEXT
WAIT

