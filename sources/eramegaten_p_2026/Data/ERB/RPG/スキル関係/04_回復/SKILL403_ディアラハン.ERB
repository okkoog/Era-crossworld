;ターゲット条件
@SKILL_IS_VALID_TARGET_403,ARG, ARG:1
RETURN 1

@SKILL_SELECTABLE_BY_AUTO_403,ARG
#DIM DYNAMIC LCOUNT
;敵の場合、ランダム選定にたいして制限を加える
;持っている敵がボスとして配置された際にAI制御なしだとあっさり壊れるので
IF !CFLAG:ARG:PT플래그
	FOR LCOUNT, 7, 17
		SIF POS(LCOUNT) < 0
			CONTINUE
		SIF !CFLAG:POS(LCOUNT):보스플래그
			CONTINUE
		RETURN 0
	NEXT
ENDIF
RETURN 1

