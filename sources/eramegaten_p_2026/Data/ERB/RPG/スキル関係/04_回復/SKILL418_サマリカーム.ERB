;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_418,ARG
RESULTS = 사마리캄

;　명중
@SKILL_HITRATE_418, ARG
RETURN 100

;　威力
@SKILL_POWER_418, ARG
RETURN 50

;　최저공격횟수
@SKILL_MINATTACKNUMBER_418,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_418,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_418, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_418,ARG
RETURN 24


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_418
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_418, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_418,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_418,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_418, ARG
RETURN GET_SKILL_EFFECT_NUM("상태회복")

;蘇生スキルであるか
@SKILL_IS_RESUSCITATION_418
RETURN 1


;계승타입
@SKILL_SUCCESSION_TYPE_418
RETURN GET_SUCCESSION_NUM("회복")

;속도보정
@SKILL_SPEED_418, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_418
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_418, ARG = -1
RETURN 11



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_418, ARG, ARG:1, ARG:2
;コスト支払い
;CALL PAY_COST,ARG,418

CALL SKILL_CURE_STATE_418,CFLAG:(ARG:1):상태이상
IF RESULT == 1
	PRINTFORMW %조사처리(CALLNAME:(ARG:1),"는")% 되살아났다
	CFLAG:(ARG:1):상태이상 = 0
	CFLAG:(ARG:1):상태이상경과턴수 = 0
	CALL VAR_HP,(ARG:1),MAXBASE:(ARG:1):ＨＰ
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_418,ARG,ARG:1,ARG:2
;コスト支払い
;CALL PAY_COST,ARG,418

CALL SKILL_CURE_STATE_418,CFLAG:(ARG:1):상태이상
IF RESULT == 1
	PRINTFORMW %조사처리(CALLNAME:(ARG:1),"는")% 되살아났다
	CFLAG:(ARG:1):상태이상 = 0
	CFLAG:(ARG:1):상태이상경과턴수 = 0
	CALL VAR_HP,(ARG:1),MAXBASE:(ARG:1):ＨＰ
ELSE
	PRINTW 효과가 없었다
ENDIF


;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_418, ARG
PRINTL 빈사의 아군 한 명을 ＨＰ최대로 부활시킨다。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_418,ARG
RETURN 1
;とくにない

;ターゲット条件
@SKILL_TARGETABLE_418,ARG, ARG:1
CALL SKILL_CURE_STATE_418,(CFLAG:(ARG:1):상태이상)
RETURN RESULT

;控えに使えるか
@SKILL_T_RESERVE_418, ARG
RETURN 1

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_418,ARG
SELECTCASE GET_STATE(ARG)
	CASE "DYING"
		RETURN 1
	CASEELSE
		RETURN 0
ENDSELECT

