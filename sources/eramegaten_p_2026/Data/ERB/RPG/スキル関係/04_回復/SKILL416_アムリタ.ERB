;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_416,ARG
IF SKILL_CHANGE(ARG, [[キャラ:T씨]])
	RESULTS = 본가의 매실주
ELSE
	RESULTS = 암리타
ENDIF



;　명중
@SKILL_HITRATE_416, ARG
RETURN 100

;　威力
@SKILL_POWER_416, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_416,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_416,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_416, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_416,ARG
RETURN 20


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_416
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_416, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_416,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_416,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_416, ARG
RETURN GET_SKILL_EFFECT_NUM("상태회복")


;계승타입
@SKILL_SUCCESSION_TYPE_416
RETURN GET_SUCCESSION_NUM("회복")

;속도보정
@SKILL_SPEED_416, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_416
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_416, ARG = -1
RETURN 10




;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_416, ARG, ARG:1, ARG:2
;コスト支払い
CALL CURE_STATE_FIELD,ARG,ARG:1,416

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_416,ARG,ARG:1,ARG:2
;コスト支払い
;CALL PAY_COST,ARG,416
CALL CURE_STATE_FIELD,ARG,ARG:1,416
WAIT

;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_416, ARG
PRINTL 아군 전체의 FLY,DYING,ORGY,HEAT 이외의 상태이상을 회복한다。

@SKILL_EXPLAIN_TOOLTIP_416, ARG
RESULTS = 아군 전체의 FLY,DYING,ORGY,HEAT 이외의 상태이상을 회복한다。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_416,ARG
RETURN 1
;とくにない

;ターゲット条件
@SKILL_IS_VALID_TARGET_416,ARG, ARG:1
SIF POS(ARG) < 0
	RETURN 0
CALL SKILL_CURE_STATE_416,(CFLAG:(POS(ARG)):상태이상)
RETURN RESULT

;控えに使えるか
@SKILL_T_RESERVE_416, ARG
RETURN 0

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_416,ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

