@SKILL_EXPLAIN_TOOLTIP_419, ARG
RESULTS = 사용자를 희생해、아군 전체의 ＨＰ와 모든 배드스테이터스를 전부 회복한다。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_419,ARG
RETURN 1
;とくにない

;ターゲット条件
@SKILL_IS_VALID_TARGET_419,ARG, ARG:1
IF CFLAG:(ARG:1):PT플래그
	;魅了されているときは使わない
	IF IS_BADSTATE(ARG:1, "CHARM")
		RETURN 0
	ELSE
		;味方のときは基本的に有効度不問
		RETURN 1
	ENDIF
ELSE
	SIF POS(ARG) < 0
		RETURN 0
	CALL SKILL_CURE_STATE_419,(CFLAG:POS(ARG):상태이상)
	RETURN RESULT
ENDIF

;控えに使えるか
@SKILL_T_RESERVE_419, ARG
RETURN 0

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_419,ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

