;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_419, ARG, ARG:1, ARG:2
#DIM DYNAMIC L_POS
#DIM DYNAMIC L_CHARA
FOR L_POS, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_CHARA = POS(L_POS)
	;使用者は除外
	SIF L_CHARA == ARG
		CONTINUE
	SIF L_CHARA < 0
		CONTINUE
	IF CFLAG:(L_CHARA):상태이상 == GET_STATE_NUM("DYING")
		CFLAG:(L_CHARA):상태이상 = 0
		CFLAG:(L_CHARA):상태이상경과턴수 = 0
		CALL VAR_HP,(L_CHARA),MAXBASE:(L_CHARA):ＨＰ
		PRINTFORML %조사처리(CALLNAME:(L_CHARA),"는")% 되살아났다
	ELSE
		CALL HEAL_SINGLE, ARG, L_CHARA, 419, 1
	ENDIF
NEXT
CALL DEAD_CHARA,ARG,ARG
WAIT

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_419,ARG,ARG:1,ARG:2
CALL ACTION_419, ARG, ARG:1

;====================================================
;実行内容ここまで
;====================================================


