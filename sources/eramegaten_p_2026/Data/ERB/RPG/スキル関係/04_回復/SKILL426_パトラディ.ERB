;デビチルよりパトラディ
;パトラの強化系でDYING以外の状態を回復する

;スキル名
@SKILL_NAME_426,ARG
RESULTS = 파트라디


;　명중
@SKILL_HITRATE_426, ARG
RETURN 100

;　威力
@SKILL_POWER_426, ARG
RETURN 50

;　최저공격횟수
@SKILL_MINATTACKNUMBER_426,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_426,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_426, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_426,ARG
RETURN 10


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_426
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_426, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_426,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_426,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_426, ARG
RETURN GET_SKILL_EFFECT_NUM("상태회복")


;계승타입
@SKILL_SUCCESSION_TYPE_426
RETURN GET_SUCCESSION_NUM("회복")

;속도보정
@SKILL_SPEED_426, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_426
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_426, ARG = -1
RETURN 6




;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_426, ARG, ARG:1, ARG:2
CALL CURE_STATE_SINGLE, ARG, POS(ARG:1), ARG:2

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_426,ARG,ARG:1,ARG:2
CALL CURE_STATE_SINGLE, ARG, POS(ARG:1), ARG:2

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_426, ARG
PRINTL 아군 한 명의 DYING이외의 상태이상을 회복한다。

@SKILL_EXPLAIN_TOOLTIP_426, ARG
RESULTS = 아군 한 명의 DYING이외의 상태이상을 회복한다。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_426,ARG
RETURN 1
;とくにない

;ターゲット条件
@SKILL_IS_VALID_TARGET_426,ARG, ARG:1
SIF POS(ARG) < 0
	RETURN 0
SIF CFLAG:POS(ARG):상태이상 == 0
	RETURN 0
CALL SKILL_CURE_STATE_426,(CFLAG:POS(ARG):상태이상)
RETURN RESULT

;控えに使えるか
@SKILL_T_RESERVE_426, ARG
RETURN 0

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_426,ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

