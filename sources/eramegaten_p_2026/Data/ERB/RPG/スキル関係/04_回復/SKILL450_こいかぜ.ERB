;何のバッドステータスを治せるか
;技能 0：HAPPY,CHARM
;技能 1：HAPPY,CHARM
;技能 2：HAPPY,CHARM,PANIC
;技能 3：HAPPY,CHARM,PANIC
;技能 4：HAPPY,CHARM,PANIC,SLEEP
;技能 5：HAPPY,CHARM,PANIC,SLEEP
;技能 6：HAPPY,CHARM,PANIC,SLEEP,CLOSE
;技能 7：HAPPY,CHARM,PANIC,SLEEP,CLOSE
;技能 8：HAPPY,CHARM,PANIC,SLEEP,CLOSE,PALYZE
;技能 9：HAPPY,CHARM,PANIC,SLEEP,CLOSE,PALYZE
;技能10：HAPPY,CHARM,PANIC,SLEEP,CLOSE,PALYZE,CURSE

@SKILL_CURE_STATE_450,ARG
;U＝使用者

IF ARG == -1
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","CHARM","PANIC","SLEEP","CLOSE","PALYZE","CURSE"
			RETURN 1
	ENDSELECT
ELSEIF ABL:ARG:가창기능 == 0
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","CHARM"
			RETURN 1
	ENDSELECT
ELSEIF ABL:ARG:가창기능 == 1
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","CHARM",
			RETURN 1
	ENDSELECT
ELSEIF ABL:ARG:가창기능 == 2
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","CHARM","PANIC"
			RETURN 1
	ENDSELECT
ELSEIF ABL:ARG:가창기능 == 3
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","CHARM","PANIC"
			RETURN 1
	ENDSELECT
ELSEIF ABL:ARG:가창기능 == 4
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","CHARM","PANIC","SLEEP"
			RETURN 1
	ENDSELECT
ELSEIF ABL:ARG:가창기능 == 5
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","CHARM","PANIC","SLEEP"
			RETURN 1
	ENDSELECT
ELSEIF ABL:ARG:가창기능 == 6
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","CHARM","PANIC","SLEEP","CLOSE"
			RETURN 1
	ENDSELECT
ELSEIF ABL:ARG:가창기능 == 7
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","CHARM","PANIC","SLEEP","CLOSE"
			RETURN 1
	ENDSELECT
ELSEIF ABL:ARG:가창기능 == 8
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","CHARM","PANIC","SLEEP","CLOSE","PALYZE"
			RETURN 1
	ENDSELECT
ELSEIF ABL:ARG:가창기능 == 9
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","CHARM","PANIC","SLEEP","CLOSE","PALYZE"
			RETURN 1
	ENDSELECT
ELSE
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","CHARM","PANIC","SLEEP","CLOSE","PALYZE","CURSE"
			RETURN 1
	ENDSELECT
ENDIF
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","CHARM"
			RETURN 1
	ENDSELECT

RETURN 0


