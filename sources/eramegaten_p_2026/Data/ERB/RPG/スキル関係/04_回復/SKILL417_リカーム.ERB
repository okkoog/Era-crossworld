;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_417, ARG, ARG:1, ARG:2
;コストを支払う
;CALL PAY_COST,ARG,417

CALL SKILL_CURE_STATE_417,CFLAG:(ARG:1):상태이상
IF RESULT == 1
	PRINTFORMW %조사처리(CALLNAME:(ARG:1),"는")% 되살아났다
	CFLAG:(ARG:1):상태이상 = 0
	CFLAG:(ARG:1):상태이상경과턴수 = 0
	CALL VAR_HP,(ARG:1),MAXBASE:(ARG:1):ＨＰ/4
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_417,ARG,ARG:1,ARG:2
;コスト支払い
;CALL PAY_COST,ARG,417

CALL SKILL_CURE_STATE_417,CFLAG:(ARG:1):상태이상
IF RESULT == 1
	PRINTFORMW %조사처리(CALLNAME:(ARG:1),"는")% 되살아났다
	CFLAG:(ARG:1):상태이상 = 0
	CFLAG:(ARG:1):상태이상경과턴수 = 0
	CALL VAR_HP,(ARG:1),MAXBASE:(ARG:1):ＨＰ/4
ELSE
	PRINTW 효과가 없었다
ENDIF


