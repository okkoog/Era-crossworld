RETURN 10




;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_428, ARG, ARG:1, ARG:2
;コスト支払い
CALL PAY_COST,ARG,428
IF ARG:1 == 19
	LOCAL:7 = 1
	LOCAL:8 = 7
ELSE
	LOCAL:7 = 7
	LOCAL:8 = 17
ENDIF
FOR LOCAL:9,LOCAL:7,LOCAL:8
	LOCALS = 포지션{LOCAL:9}
	SIF FLAG:LOCALS < 0
		CONTINUE
	LOCAL = FLAG:LOCALS
	CALL SKILL_CURE_STATE_428,CFLAG:LOCAL:상태이상
	IF RESULT == 1
		PRINTFORML 　　TARGET:[{LOCAL:9,2}] %CALLNAME:(LOCAL),20,LEFT%　>>>>>>　되살아났다
		CFLAG:LOCAL:상태이상 = 0
		CFLAG:LOCAL:상태이상경과턴수 = 0
		CALL VAR_HP,(LOCAL),MAXBASE:(LOCAL):ＨＰ/4
	ENDIF
NEXT
WAIT

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_428,ARG,ARG:1,ARG:2
;コスト支払い
CALL PAY_COST,ARG,428


FOR LOCAL:9,1,7
	LOCALS = 포지션{LOCAL:9}
	SIF FLAG:LOCALS < 0
		CONTINUE
	LOCAL = FLAG:LOCALS
	CALL SKILL_CURE_STATE_428,CFLAG:LOCAL:상태이상
	IF RESULT == 1
		PRINTFORML 　　TARGET:[{LOCAL:9,2}] %CALLNAME:(LOCAL),20,LEFT%　>>>>>>　되살아났다
		CFLAG:LOCAL:상태이상 = 0
		CFLAG:LOCAL:상태이상경과턴수 = 0
		CALL VAR_HP,(LOCAL),MAXBASE:(LOCAL):ＨＰ/4
	ENDIF
NEXT
WAIT

;====================================================
;実行内容ここまで
;====================================================


