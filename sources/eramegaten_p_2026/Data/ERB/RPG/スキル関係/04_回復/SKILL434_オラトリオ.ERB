;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_434, ARG, ARG:1, ARG:2
#DIM L_P
#DIM L_T
#DIM LCOUNT,2
#DIMS L_MES
L_P = ARG
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF L_T < 0
		CONTINUE
	SIF GET_STATE(CFLAG:L_T:상태이상) == "DYING"
		CONTINUE
	L_MES = 
	FOR LCOUNT:1,0,6
		IF CFLAG:L_T:(GET_BATTLESTATUS(LCOUNT:1) + "강화") < 0
			CFLAG:L_T:(GET_BATTLESTATUS(LCOUNT:1) + "강화") = 0
			L_MES = 능력저하해제
		ENDIF
	NEXT
	CALL HEAL_SINGLE, ARG, L_T, 434, 3, , L_MES
NEXT
WAIT

;====================================================
;実行内容ここまで
;====================================================

