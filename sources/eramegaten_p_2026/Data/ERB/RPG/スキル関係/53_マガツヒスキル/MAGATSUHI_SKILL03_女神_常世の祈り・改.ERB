RETURN GET_SKILL_COST_TYPE_NUM("無消費")

;　コストの量
@SKILL_COST_MAGATSUHI_常世の祈り・改,ARG
RETURN 0

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_MAGATSUHI_常世の祈り・改
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_MAGATSUHI_常世の祈り・改,ARG
RETURN GET_SKILL_TARGET_NUM("특수")

;　사거리
@SKILL_RANGE_MAGATSUHI_常世の祈り・改,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
