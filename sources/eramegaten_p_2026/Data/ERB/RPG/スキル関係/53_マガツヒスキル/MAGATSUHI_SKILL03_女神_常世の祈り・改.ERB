	RETURN 1
RETURN 0

@SKILL_QUICK_ACTION_MAGATSUHI_常世の祈り・改, ARG
RETURN 1

;　威力
@SKILL_POWER_MAGATSUHI_常世の祈り・改, ARG
RETURN 1000

;　ＨＰ2を支払うかＭＰ3を支払うか
