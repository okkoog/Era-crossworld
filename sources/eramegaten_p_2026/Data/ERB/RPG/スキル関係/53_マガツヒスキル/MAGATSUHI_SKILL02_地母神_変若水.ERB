;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_MAGATSUHI_変若水,ARG,ARG:1,ARG:2
#DIM DYNAMIC AMOUNT_HEAL_MP
#DIM DYNAMIC RATE_MAG
#DIM DYNAMIC NEED_MAG
;大気功が1あたり20でそれより悪い
RATE_MAG = MAXBASE:ARG:LV * 25
AMOUNT_HEAL_MP = MIN(MAXBASE:ARG:ＭＰ / 2, MAXBASE:ARG:ＭＰ - BASE:ARG:ＭＰ, GET_CHARA_STOCK_MAG(ARG) / RATE_MAG)
NEED_MAG = AMOUNT_HEAL_MP * RATE_MAG
CALL CONTROL_MAG, ARG, - NEED_MAG
CALL VAR_MP, ARG, AMOUNT_HEAL_MP, "회복"

CALL HEAL_SINGLE, ARG, ARG, [[스킬:마가츠히스킬]], 0, "", @"ＭＰ:{AMOUNT_HEAL_MP}회복 & ＭＡＧ:{NEED_MAG}소비"

;使用条件
@SKILL_SPECIAL_ACTIONABLE_MAGATSUHI_変若水,ARG
RETURN 1