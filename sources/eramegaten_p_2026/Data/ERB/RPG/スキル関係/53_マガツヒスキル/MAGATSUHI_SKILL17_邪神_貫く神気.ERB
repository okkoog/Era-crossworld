
;スキル名
@SKILL_NAME_MAGATSUHI_17,ARG
RESULTS = 貫く神気

@SKILL_NAME_MAGATSUHI_貫く神気,ARG
RESULTS = 꿰뚫는신기

@SKILL_COND_MAGATSUHI_貫く神気, ARG
SIF GET_RACE(ABL:ARG:종족) == "사신邪神"
	RETURN 1
RETURN 0

@SKILL_QUICK_ACTION_MAGATSUHI_貫く神気, ARG
RETURN 1

;　威力
@SKILL_POWER_MAGATSUHI_貫く神気, ARG
RETURN 0

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_MAGATSUHI_貫く神気, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")

;　コストの量
@SKILL_COST_MAGATSUHI_貫く神気,ARG
RETURN 0

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_MAGATSUHI_貫く神気
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_MAGATSUHI_貫く神気,ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　사거리
@SKILL_RANGE_MAGATSUHI_貫く神気,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_MAGATSUHI_貫く神気, ARG
RETURN GET_SPHERE_NUM("단체")

;계승타입
@SKILL_SUCCESSION_TYPE_MAGATSUHI_貫く神気
RETURN GET_SUCCESSION_NUM("검격")
;속도보정
@SKILL_SPEED_MAGATSUHI_貫く神気, ARG = -1
RETURN 0

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_MAGATSUHI_貫く神気,ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;　 説明文の表示
@SKILL_EXPLAIN_MAGATSUHI_貫く神気, ARG
PRINTL 사신邪神의 마가츠히스킬
PRINTL 다음 모든 공격이 한 번만、모든 상성의 내성을 관통하고、
PRINTL 추가로 １００％의 추가데미지가 발생하는 효과를 얻는다。
PRINTL 이 스킬은 턴을 소비하지 않고 즉시 발동한다。

@SKILL_EXPLAIN_TOOLTIP_MAGATSUHI_貫く神気, ARG
RESULTS = 다음 모든 공격이 모든 상성의 내성을 관통하고、
RESULTS:1 = 추가로 １００％의 추가데미지가 발생하는 효과를 얻는다。
RESULTS:2 = 이 스킬은 턴을 소비하지 않고 즉시 발동한다。

@SKILL_ACTIONABLE_BATTLE_MAGATSUHI_貫く神気, ARG
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_MAGATSUHI_貫く神気,ARG,ARG:1,ARG:2
CALL SET_C_BTL_EFFECT_SINGLE, ARG, ARG, "貫く神気", 0

;使用条件
@SKILL_SPECIAL_ACTIONABLE_MAGATSUHI_貫く神気,ARG
RETURN 1
