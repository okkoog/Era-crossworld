
;スキル名
@SKILL_NAME_MAGATSUHI_200,ARG
RESULTS = 妖精の遊戯

@SKILL_NAME_MAGATSUHI_妖精の遊戯,ARG
RESULTS = 요정의유희

@SKILL_COND_MAGATSUHI_妖精の遊戯, ARG
SIF GROUPMATCH(NO:ARG, [[キャラ:픽시]], [[キャラ:하이픽시]])
	RETURN 1
RETURN 0

@SKILL_QUICK_ACTION_MAGATSUHI_妖精の遊戯, ARG
RETURN 1

;　威力
@SKILL_POWER_MAGATSUHI_妖精の遊戯, ARG
RETURN 1000

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_MAGATSUHI_妖精の遊戯, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")

;　コストの量
@SKILL_COST_MAGATSUHI_妖精の遊戯,ARG
RETURN 0

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_MAGATSUHI_妖精の遊戯
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
@SKILL_HEAL_TYPE_MAGATSUHI_妖精の遊戯, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("割合")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_MAGATSUHI_妖精の遊戯,ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_MAGATSUHI_妖精の遊戯,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_MAGATSUHI_妖精の遊戯, ARG
RETURN GET_SPHERE_NUM("단체")

;계승타입
@SKILL_SUCCESSION_TYPE_MAGATSUHI_妖精の遊戯
RETURN GET_SUCCESSION_NUM("검격")
;속도보정
@SKILL_SPEED_MAGATSUHI_妖精の遊戯, ARG = -1
RETURN 0

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_MAGATSUHI_妖精の遊戯,ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;　 説明文の表示
@SKILL_EXPLAIN_MAGATSUHI_妖精の遊戯, ARG
PRINTL 픽시 종족의 마가츠히스킬
PRINTL 대상의 ＨＰ를 전부 회복하고、전능력을 상승시키며、
PRINTL 추가로 ３턴간、적에게 노려지기 쉬운 상태로 만든다。
PRINTL 이 스킬은 턴을 소비하지 않고 즉시 발동한다。
PRINTL 
PRINTL 필요동료마：【요정 픽시】【요정 하이픽시】

@SKILL_EXPLAIN_TOOLTIP_MAGATSUHI_妖精の遊戯, ARG
RESULTS:0 = 대상의 ＨＰ를 전부 회복하고、전능력을 상승시키며、
RESULTS:1 = 추가로 ３턴간、적에게 노려지기 쉬운 상태로 만든다。
RESULTS:2 = 이 스킬은 턴을 소비하지 않고 즉시 발동한다。

@SKILL_ACTIONABLE_BATTLE_MAGATSUHI_妖精の遊戯, ARG
RESULTS = 건재한「요정 픽시」와「요정 하이픽시」가 전투에 참가 가능한 상태여야 한다。
SIF !FIND_MAGATSUHI_GROUP_MEMBER([[キャラ:픽시]], [[キャラ:하이픽시]])
	RETURN 0
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_MAGATSUHI_妖精の遊戯,ARG,ARG:1,ARG:2
#DIM DYNAMIC L_CHARA
CALL HEAL_SINGLE, ARG, POS(ARG:1), [[스킬:마가츠히스킬]], 
CALL PRINT_HIT_MESSAGE, POS(ARG:1), "3턴간、적에게 노려지기 쉬워졌다！", "L"
CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "공격/방어/마법위력/마법효과/명중/회피", 8, "단체"

CFLAG:POS(ARG:1):피타겟비율변동지속턴수 = 3
CFLAG:POS(ARG:1):변동피타겟율 = 300

@SKILL_SPECIAL_ACTIONABLE_MAGATSUHI_妖精の遊戯,ARG
RETURN 1

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_MAGATSUHI_妖精の遊戯, ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT
