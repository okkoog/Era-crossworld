;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_MAGATSUHI_禍時：漲力,ARG,ARG:1,ARG:2
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_T
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	CALL PRINT_HIT_MESSAGE, L_T, "능력변화를 강화！", "L"
	CFLAG:L_T:장력 = 1
NEXT
WAIT
;使用条件
@SKILL_SPECIAL_ACTIONABLE_MAGATSUHI_禍時：漲力,ARG
RETURN 1