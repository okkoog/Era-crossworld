;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_MAGATSUHI_呪毒散布,ARG,ARG:1,ARG:2
#DIM DYNAMIC STOCK_BADSTATE, 17
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_BADSTATE_TABLE, 3
#DIM DYNAMIC TEMP_BADSTATE

;3個抜き取る
WHILE MATCH(L_BADSTATE_TABLE, 0)
	TEMP_BADSTATE = RAND(1, BADSTATENUM)
	;すでに選ばれたものは弾く
	SIF MATCH(L_BADSTATE_TABLE, TEMP_BADSTATE)
		CONTINUE
	;神経と精神以外は弾く
	SIF !(IS_BADSTATE_GROUP(TOSTR(TEMP_BADSTATE), "신경") || IS_BADSTATE_GROUP(TOSTR(TEMP_BADSTATE), "정신"))
		CONTINUE
	L_BADSTATE_TABLE:FINDELEMENT(L_BADSTATE_TABLE, 0)  = TEMP_BADSTATE
WEND

;優先度順に並び変える
FOR LCOUNT, 0, VARSIZE("L_BADSTATE_TABLE") - 1
	SIF BADSTATE_PRIORITY(L_BADSTATE_TABLE:LCOUNT) > BADSTATE_PRIORITY(L_BADSTATE_TABLE:(LCOUNT + 1))
		CONTINUE
	SWAP L_BADSTATE_TABLE:LCOUNT, L_BADSTATE_TABLE:(LCOUNT + 1)
	LCOUNT = -1
NEXT

VARI L_POS
VARI L_ENEMY
FOR L_POS, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_ENEMY = POS(L_POS)
	SIF !IS_TARGET_ABLE(L_ENEMY)
		CONTINUE
	STOCK_BADSTATE:L_POS = CFLAG:L_ENEMY:상태이상
	FOR LCOUNT, 0, VARSIZE("L_BADSTATE_TABLE")
		TFLAG:스킬용1 = L_BADSTATE_TABLE:LCOUNT
		IF IS_BADSTATE_GROUP(TOSTR(TFLAG:스킬용1), "신경")
			TFLAG:스킬용2 = GET_TYPE_NUM("신경")
		ELSE
			TFLAG:스킬용2 = GET_TYPE_NUM("정신")
		ENDIF
		IF LCOUNT
			SIF BADSTATE_PRIORITY(TFLAG:스킬용1) < BADSTATE_PRIORITY(CFLAG:L_ENEMY:상태이상)
				CONTINUE
		ENDIF
		CALL SINGLE_BADSTATE,ARG,L_ENEMY,[[스킬:마가츠히스킬]], 1
	NEXT
	SIF CFLAG:L_ENEMY:상태이상 != STOCK_BADSTATE:L_POS
		CALL SKILL_SET_カジャンダ, ARG, L_ENEMY, "공격/방어/마법위력/마법효과/명중/회피", -4, "단체", "NOWAIT"
NEXT
WAIT
;使用条件
@SKILL_SPECIAL_ACTIONABLE_MAGATSUHI_呪毒散布,ARG
RETURN 1