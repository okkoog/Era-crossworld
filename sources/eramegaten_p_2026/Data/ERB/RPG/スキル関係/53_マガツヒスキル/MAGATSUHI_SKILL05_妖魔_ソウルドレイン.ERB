@SKILL_TARGET_MAGATSUHI_ソウルドレイン,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_MAGATSUHI_ソウルドレイン,ARG
RETURN 3

