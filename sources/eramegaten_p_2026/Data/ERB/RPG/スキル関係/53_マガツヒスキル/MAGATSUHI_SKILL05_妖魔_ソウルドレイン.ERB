
;スキル名
@SKILL_NAME_MAGATSUHI_5,ARG
RESULTS = ソウルドレイン

@SKILL_NAME_MAGATSUHI_ソウルドレイン,ARG
RESULTS = 소울드레인

@SKILL_COND_MAGATSUHI_ソウルドレイン, ARG
SIF GET_RACE(ABL:ARG:종족) == "요마"
	RETURN 1
RETURN 0

;即時性
@SKILL_QUICK_ACTION_MAGATSUHI_ソウルドレイン, ARG
RETURN 0

;　명중
@SKILL_HITRATE_MAGATSUHI_ソウルドレイン, ARG
RETURN 100

;　威力
@SKILL_POWER_MAGATSUHI_ソウルドレイン, ARG
SIF ARG < 0
	RETURN 100
;아기～ラグナロクのダメージに沿う
SELECTCASE BASE:ARG:LV
	CASE IS < 15
		RETURN 140
	CASE IS < 35
		RETURN 235
	CASE IS < 55
		RETURN 330
	CASE IS < 65
		RETURN 410
	CASEELSE
		RETURN 500
ENDSELECT
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_MAGATSUHI_ソウルドレイン,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_MAGATSUHI_ソウルドレイン,ARG
RETURN 1

;必殺率
@SKILL_CRITICAL_RATE_MAGATSUHI_ソウルドレイン,ARG
RETURN 0

;　吸収率
@SKILL_HP_ABSORBER_MAGATSUHI_ソウルドレイン, ARG
RETURN 100

;　相性
@SKILL_TYPE_MAGATSUHI_ソウルドレイン,ARG
RETURN GET_TYPE_NUM("만능")

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_MAGATSUHI_ソウルドレイン, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")

;　コストの量
@SKILL_COST_MAGATSUHI_ソウルドレイン,ARG
RETURN 0

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_MAGATSUHI_ソウルドレイン
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_ATTACKTYPE_MAGATSUHI_ソウルドレイン, ARG
SIF ARG < 0
	RETURN 0
RETURN 1 + (MAXBASE:ARG:마법위력 > MAXBASE:ARG:공격)

