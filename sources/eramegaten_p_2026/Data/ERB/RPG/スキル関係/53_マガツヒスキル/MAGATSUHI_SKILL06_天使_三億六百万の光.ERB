;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_MAGATSUHI_三億六百万の光,ARG,ARG:1,ARG:2
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_T
#DIM DYNAMIC L_AMOUNT_HEAL
#DIM DYNAMIC RATE_MAG
#DIM DYNAMIC NEED_MAG
#DIM DYNAMIC IS_HEALED
;大気功が1あたり20でそれより悪い
RATE_MAG = MAXBASE:ARG:LV * 25
;
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	L_AMOUNT_HEAL = MIN(MAXBASE:L_T:ＭＰ * 15 / 100 + 5, MAXBASE:L_T:ＭＰ - BASE:L_T:ＭＰ, GET_CHARA_STOCK_MAG(L_T) / RATE_MAG)
	;回復できない場合はとばす
	SIF L_AMOUNT_HEAL <= 0
		CONTINUE
	NEED_MAG = L_AMOUNT_HEAL * RATE_MAG
	CALL CONTROL_MAG, L_T, - NEED_MAG
	CALL VAR_MP, L_T, L_AMOUNT_HEAL, "회복"
	CALL PRINT_HIT_MESSAGE, L_T, @"ＭＰ:{L_AMOUNT_HEAL}회복 & ＭＡＧ:{NEED_MAG}소비", "L"
	IS_HEALED += 1
NEXT
IF !IS_HEALED
	PRINTW ＞효과가 없었다……
ELSE
	WAIT
ENDIF

