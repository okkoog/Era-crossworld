
;スキル名
@SKILL_NAME_MAGATSUHI_201,ARG
RESULTS = 呪いの濁流

@SKILL_NAME_MAGATSUHI_呪いの濁流,ARG
RESULTS = 저주의탁류

@SKILL_COND_MAGATSUHI_呪いの濁流, ARG
SIF GROUPMATCH(NO:ARG, [[キャラ:앨리스]], [[キャラ:베리얼]], [[キャラ:네비로스]])
	RETURN 1
RETURN 0


;即時性
@SKILL_QUICK_ACTION_MAGATSUHI_呪いの濁流, ARG
RETURN 0

;　명중
@SKILL_HITRATE_MAGATSUHI_呪いの濁流, ARG
RETURN 100

;　威力
@SKILL_POWER_MAGATSUHI_呪いの濁流, ARG
SIF ARG < 0
	RETURN 100
SELECTCASE BASE:ARG:LV
	CASE IS < 15
		RETURN 100
	CASE IS < 35
		RETURN 200
	CASE IS < 55
		RETURN 280
	CASE IS < 65
		RETURN 340
	CASEELSE
		RETURN 420
ENDSELECT
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_MAGATSUHI_呪いの濁流,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_MAGATSUHI_呪いの濁流,ARG
RETURN 1

;必殺率
@SKILL_CRITICAL_RATE_MAGATSUHI_呪いの濁流,ARG
RETURN 0

;　吸収率
@SKILL_HP_ABSORBER_MAGATSUHI_呪いの濁流, ARG
RETURN 0

;　相性
@SKILL_TYPE_MAGATSUHI_呪いの濁流,ARG
RETURN GET_TYPE_NUM("주살")

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_MAGATSUHI_呪いの濁流, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")

;　コストの量
@SKILL_COST_MAGATSUHI_呪いの濁流,ARG
RETURN 0

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_MAGATSUHI_呪いの濁流
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_ATTACKTYPE_MAGATSUHI_呪いの濁流, ARG
SIF ARG < 0
	RETURN 0
RETURN 1 + (MAXBASE:ARG:마법위력 > MAXBASE:ARG:공격)

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_MAGATSUHI_呪いの濁流, ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_MAGATSUHI_呪いの濁流,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_MAGATSUHI_呪いの濁流,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_MAGATSUHI_呪いの濁流, ARG
RETURN GET_SPHERE_NUM("단체")

;계승타입
@SKILL_SUCCESSION_TYPE_MAGATSUHI_呪いの濁流
RETURN GET_SUCCESSION_NUM("검격")
;속도보정
@SKILL_SPEED_MAGATSUHI_呪いの濁流, ARG = -1
RETURN 0

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_MAGATSUHI_呪いの濁流,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_MAGATSUHI_呪いの濁流, ARG
RETURN GET_STATE_NUM("CURSE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_MAGATSUHI_呪いの濁流, ARG
RETURN GET_TYPE_NUM("주살")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_MAGATSUHI_呪いの濁流, ARG
RETURN 150

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_MAGATSUHI_呪いの濁流, ARG
RETURN 100

;　 説明文の表示
@SKILL_EXPLAIN_MAGATSUHI_呪いの濁流, ARG
PRINTL 앨리스와 친구들의 마가츠히스킬
PRINTL 적 전체에 모든 상성을 관통하는 대위력의 주살 상성의 마법데미지를 준다。
PRINTL 이 스킬의 위력은 레벨에 크게 의존한다。
PRINTL 공격 성공시에 공격력과 마법위력을 크게 냊추고、초고확률로 CURSE를 부착한다。
PRINTL 필요동료마：【마인 앨리스】와【마왕 베리얼】과【타천사 네비로스】


@SKILL_EXPLAIN_TOOLTIP_MAGATSUHI_呪いの濁流, ARG
RESULTS:0 = 적 전체에 모든 상성을 관통하는 대위력의 주살 상성의 마법데미지를 준다。
RESULTS:1 = 이 스킬의 위력은 레벨에 크게 의존한다。
RESULTS:2 = 공격 성공시에 공격력과 마법위력을 낮추고、초고확률로 CURSE를 부착한다。

@SKILL_ACTIONABLE_BATTLE_MAGATSUHI_呪いの濁流, ARG
RESULTS = 건재한「마인 앨리스」와「마왕 베리얼」과「타천사 네비로스」가 전투에 참가 가능한 상태여야 한다。
SIF !FIND_MAGATSUHI_GROUP_MEMBER([[キャラ:앨리스]], [[キャラ:베리얼]], [[キャラ:네비로스]])
	RETURN 0
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_MAGATSUHI_呪いの濁流,ARG,ARG:1,ARG:2
CALL ATTACK_TARGET, ARG, ARG:1, [[스킬:마가츠히스킬]]

;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_MAGATSUHI_呪いの濁流, ARG, ARG:1, ARG:2
#DIM DYNAMIC AMOUNT_DRAIN_MAG
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격_마법위력", -4, "短縮"

;使用条件
@SKILL_SPECIAL_ACTIONABLE_MAGATSUHI_呪いの濁流,ARG
RETURN 1
