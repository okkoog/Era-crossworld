
;スキル名
@SKILL_NAME_2863,ARG
RESULTS = 광시「광시조율」
SIF GETBIT (FLAG:커스텀게임화면,1)
	RESULTS = 광시「일루전 시커」

;　명중
@SKILL_HITRATE_2863, ARG
RETURN 100

;　威力
@SKILL_POWER_2863, ARG
RETURN 210

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2863,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2863,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2863, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2863,ARG
RETURN 10

;　相性
@SKILL_TYPE_2863,ARG
RETURN GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2863
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2863, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2863, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2863,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2863,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2863, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2863
RETURN GET_SUCCESSION_NUM("비구")

;속도보정
@SKILL_SPEED_2863, ARG = -1
RETURN 1


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2863
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2863, ARG = -1
RETURN 10


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2863,ARG
RETURN RAND:10 + 1


;추가효과상성
@SKILL_ADDTIONAL_TYPE_2863,ARG
RETURN GET_TYPE_NUM("정신")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2863,ARG
RETURN 40

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2863,ARG
RETURN 85

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2863, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,2863






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2863, ARG
PRINTL 광시조율(일루전 시커)
PRINTL 적 1체에 파장의 탄환을 날려 공격. 정신 상성의 무작위 상태이상을 부여한다.
PRINTL 幻魔　레이센 우동게인 이나바의 스펠카드



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2863,ARG
RETURN 1
;とくにない

