;スキル及び行動の実行
;====================================================
@ACTION_2904, ARG, ARG:1, ARG:2
#LOCALSIZE 5
;ARG:0…実行者のCHARA Num　ARG:1…対象のポジションNum
LOCAL = POS(ARG:1)
CALL ACTION_SKILL_ANALYZE, LOCAL, "念写成功!", "念写成功！", "念写失敗！"
CALL ATTACK_SINGLE,ARG,LOCAL,2904

