@SKILL_HITRATE_2904, ARG
RETURN 200

;　威力
@SKILL_POWER_2904, ARG
RETURN 110

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2904,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2904,ARG
RETURN 1

