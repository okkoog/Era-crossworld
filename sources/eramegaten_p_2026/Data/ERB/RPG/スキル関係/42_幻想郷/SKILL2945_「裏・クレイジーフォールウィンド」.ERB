;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2945,ARG
RESULTS = 「뒷・크레이지폴윈드」
SIF  GETBIT (FLAG:커스텀게임화면,1)
	RESULTS = 「이면·크레이지 폴 윈드」

;　명중
@SKILL_HITRATE_2945, ARG
RETURN 120

;　威力
@SKILL_POWER_2945, ARG
RETURN 290

;　クリティカル率
@SKILL_CRITICAL_RATE_2945, ARG
RETURN 20

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2945,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2945,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2945, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2945,ARG
RETURN 28

;　相性
@SKILL_TYPE_2945,ARG
RETURN GET_TYPE_NUM("충격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2945
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2945, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2945, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2945,ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2945,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2945, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2945
RETURN GET_SUCCESSION_NUM("충격")

;속도보정
@SKILL_SPEED_2945, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2945
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2945, ARG = -1
RETURN 15


@継承不能_2945
RETURN 1

;テンプレート用、追加効果シリーズ
@SKILL_ADDTIONAL_STATE_2945,ARG
RETURN GET_STATE_NUM("PANIC")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2945,ARG
RETURN GET_TYPE_NUM("충격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2945,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2945,ARG
RETURN 95

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2945, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,2945
;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2945, ARG
PRINTL 적 1열에 충격 속성으로 대위력의 물리 공격을 1회 행한다.
PRINTL 추가 효과: 약간 높은 명중률 충격 속성 혼란
PRINTL 아야에게 모으게 했던 가을의 마력을 사용한 흉악한 진공파 공격.
PRINTL 秘神　마타라 오키나의 스펠카드 (전용)


;使用条件
@SKILL_SPECIAL_ACTIONABLE_2945,ARG
RETURN 1
;とくにない

