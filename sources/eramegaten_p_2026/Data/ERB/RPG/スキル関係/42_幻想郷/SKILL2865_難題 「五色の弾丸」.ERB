;何のバッドステータスを治せるか
@SKILL_CURE_STATE_2865, ARG
SELECTCASE GET_STATE(ARG)
	CASE "GOOD", "DYING"
		RETURN 0
	CASEELSE
		SIF TFLAG:스킬용1 == 0
			RETURN 1
ENDSELECT

