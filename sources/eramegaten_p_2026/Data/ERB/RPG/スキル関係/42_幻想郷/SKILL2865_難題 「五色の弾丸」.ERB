;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2865, ARG, ARG:1, ARG:2
;ARG:0…実行者のCHARA Num　ARG:1…対象のポジションNum

;------------------------------------------------
; LOCAL:0 対象Chara Num
; LOCAL:1 効果種別
;	0.味方全員の状態異常を完治,		 20.00% 神宝「ブディストダイアモンド」
;	1.味方にタル・マカカジャ効果,	 20.00% 神宝「蓬莱の玉の枝」
;	2.味方全員のHPを大回復,			 20.00% 神宝「ライフスプリングインフィニティ」
;	3.デカジャ版泡沫の波紋,			 20.00% 神宝「ブリリアントドラゴンバレッタ」
;	4.味方全員に万能防御壁,			 10.00% 神宝「サラマンダーシールド」
;	5.何も起こらない,				 10.00% 供覧「月都万象展」
;	6.エラー,						 0%
; LOCAL:2 一時計算用
; LOCAL:7 カウンタ変数
; LOCAL:8 範囲Un
; LOCAL:9 範囲Up
;------------------------------------------------
; 初期化処理
;VARSET LOCAL, 0, 0, 10
;LOCAL:1 = RAND:10000
SELECTCASE RAND:10000
	CASE IS < 1000
		TFLAG:스킬용1 = 5
	CASE IS < 2000
		TFLAG:스킬용1 = 4
	CASE IS < 4000
		TFLAG:스킬용1 = 3
	CASE IS < 6000
		TFLAG:스킬용1 = 2
	CASE IS < 8000
		TFLAG:스킬용1 = 1
	CASE IS < 10000
		TFLAG:스킬용1 = 0
	CASEELSE
		; ここに来ることは無いはずだが……
		TFLAG:스킬용1 = 6
ENDSELECT
; 範囲設定
;IF CFLAG:ARG:PT플래그 == 0
;	LOCAL:8 = 7
;	LOCAL:9 = 17
;ELSE
;	LOCAL:8 = 1
;	LOCAL:9 = 7
;ENDIF

; オラクル本処理
;難題名表示
LOCALS = "ENPTY"
SELECTCASE TFLAG:스킬용1
	CASE 0
		LOCALS = 신보「불교 다이아몬드」
	CASE 1
		LOCALS = 신보「봉래의 옥가지」
	CASE 2
		LOCALS = 신보「라이프 스프링 인피니티」
	CASE 3
		LOCALS = 신보「브릴리언트 드래곤 바레트」
	CASE 4
		LOCALS = 신보「샐러맨더 실드」
	CASE 5
		LOCALS = 供覧「月都万象展」
ENDSELECT
CALL MESSAGE_B(1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)

;何も起こらない
IF TFLAG:스킬용1 == 5
	PRINTFORML %CALLNAME:ARG%은(는)　보물을　과시했다!
	PRINTFORMW …………놀랍게도 반듯하게 전시되어 있어 아무 일도 일어나지 않았다!
ELSEIF TFLAG:스킬용1 == 6
	PRINTFORMW 에러: 존재하지 않는 선택지 발생
ELSE
	SELECTCASE TFLAG:스킬용1
		CASE 0
			CALL CURE_STATE_FIELD,ARG, CFLAG:ARG:PT플래그 ? 19 # 22, 2865
		CASE 1
			CALL SKILL_SET_カジャンダ, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, "攻撃_魔法威力", 4, "範囲"
		CASE 2
			CALL HEAL_FIELD,ARG, CFLAG:ARG:PT플래그 ? 19 # 22, 2865
		CASE 3
			FOR LOCAL,1, 17
				SIF !IS_TARGET_ABLE(POS(LOCAL))
					CONTINUE
				FOR LOCAL:1, GETNUM(CFLAG,"공격강화"), GETNUM(CFLAG,"BS부착률강화")+1
					CFLAG:POS(LOCAL):(LOCAL:1) = MAX(0, CFLAG:POS(LOCAL):(LOCAL:1))
				NEXT
				CALL PRINT_HIT_MESSAGE, POS(LOCAL), "能力の低下が解除された！"
			NEXT
			WAIT
		CASE 4
			CALL SKILL_INVALID_WALL, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, "수호의방패", "範囲"
	ENDSELECT
ENDIF

