;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2629, ARG, ARG:1, ARG:2

IF ABL:ARG:순종 >= 10
	CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 12, "단체", "NOWAIT"
	CALL SKILL_SET_カジャンダ, ARG, ARG, "회피", 8, "단체", "NOWAIT"
	;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 12)
	;CFLAG:ARG:회피강화 = MIN(32, CFLAG:ARG:회피강화 + 8)
	;PRINTFORML %CALLNAME:ARG%の攻撃力と回避率が大幅に上がった！
ELSEIF ABL:ARG:순종 >= 7
	CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 8, "단체", "NOWAIT"
	CALL SKILL_SET_カジャンダ, ARG, ARG, "회피", 4, "단체", "NOWAIT"
	;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 8)
	;CFLAG:ARG:회피강화 = MIN(32, CFLAG:ARG:회피강화 + 4)
	;PRINTFORML %CALLNAME:ARG%の攻撃力と回避率が上がった！
ELSEIF ABL:ARG:순종 >= 4
	CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 8, "단체", "NOWAIT"
	;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 8)
	;PRINTFORML %CALLNAME:ARG%の攻撃力が上がった！
ELSE
	CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 4, "단체", "NOWAIT"
	;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 4)
	;PRINTFORML %CALLNAME:ARG%の攻撃力が上がった！
ENDIF
WAIT
