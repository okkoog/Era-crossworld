;スキル名
@SKILL_NAME_2615,ARG
RESULTS = 러브니들

;　명중
@SKILL_HITRATE_2615, ARG
RETURN 100

;　威力
@SKILL_POWER_2615, ARG 
SIF ARG == -1
	RETURN 280
IF TALENT:ARG:아내 || TALENT:ARG:남편
	RETURN 450
ELSEIF TALENT:ARG:친애
	RETURN 380
ELSEIF TALENT:ARG:연모
	RETURN 330
ELSE
	RETURN 280
ENDIF

