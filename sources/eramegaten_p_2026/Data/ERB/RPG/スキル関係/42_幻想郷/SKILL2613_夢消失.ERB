;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2613,ARG
SIF ARG < 0
	RETURN 0
SIF !INRANGE(CFLAG:ARG:타겟, 1, 16)
	RETURN 0
SIF POS(CFLAG:ARG:타겟) < 0
	RETURN 0
;相手が条件を満たしていない場合は-1を入れて返すことで判定や表記をそのまま飛ばす
SIF CFLAG:POS(CFLAG:ARG:타겟):상태이상 != GET_STATE_NUM("HAPPY")
	RETURN 0
RETURN GET_STATE_NUM("DYING")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2613,ARG
RETURN 8

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2613,ARG
