;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2907,ARG
RESULTS = 통령「통령요시카」

;　명중
@SKILL_HITRATE_2907, ARG
RETURN 100

;　威力
@SKILL_POWER_2907, ARG
RETURN 1000

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2907,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2907,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2907, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2907,ARG
RETURN 30


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2907
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2907, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2907, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_2907,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2907,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2907, ARG
RETURN GET_SKILL_EFFECT_NUM("회복")

@SKILL_HEAL_TYPE_2907, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("割合")

;계승타입
@SKILL_SUCCESSION_TYPE_2907
RETURN GET_SUCCESSION_NUM("지원")
;継承不可

@継承不能_2907
RETURN 1

;속도보정
@SKILL_SPEED_2907, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2907
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2907, ARG = -1
RETURN 13



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2907, ARG, ARG:1, ARG:2
IF NO:POS(ARG:1) == [[キャラ:요시카]]
	TFLAG:스킬용1 = 1
	CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "攻撃_魔法威力", 4, "短縮"
	CALL HEAL_SINGLE, ARG, POS(ARG:1), 2907, , , SUBSTRING(TSTR:스킬메시지추가효과, 3)
ELSE
	CALL HEAL_SINGLE, ARG, POS(ARG:1), 2907
ENDIF


;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_2907, ARG
PRINTL 사선이 사용하는 외법, 그 무시무시한 힘의 일편.
PRINTL 
PRINTL 아군 1명의 HP를 전회복한다.
PRINTL 추가로 효과의 대상이 미야코 요시카였을 경우, 추가로 이하의 효과가 발동한다.
PRINTL 「대상의 FLY, DYING, ORGY, HEAT 이외의 상태이상을 회복한다.」
PRINTL 「대상의 공격과 마법 위력을 상승시킨다.」
PRINTL 마왕　곽청아의 스펠카드 (계승 불가)

@SKILL_TARGETABLE_2907,ARG, ARG:1
RETURN 1 

;使用条件
@SKILL_SPECIAL_ACTIONABLE_2907,ARG
RETURN 1
;とくにない

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_2907,ARG
IF TFLAG:스킬용1
	SELECTCASE GET_STATE(ARG)
		CASE "FLY","GOOD","DYING","ORGY","HEAT"
			RETURN 0
		CASEELSE
			RETURN 1
	ENDSELECT
ENDIF