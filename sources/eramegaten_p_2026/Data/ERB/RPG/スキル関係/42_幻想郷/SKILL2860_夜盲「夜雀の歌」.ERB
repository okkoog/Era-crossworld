;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2860,ARG
RESULTS = 야맹「밤참새의노래」

;　명중
@SKILL_HITRATE_2860, ARG
RETURN 100

;　威力
@SKILL_POWER_2860, ARG
SIF ARG == -1
	RETURN 90
IF ABL:ARG:가창기능 == 0
	RETURN 90
ELSEIF ABL:ARG:가창기능 == 1
	RETURN 100
ELSEIF ABL:ARG:가창기능 == 2
	RETURN 120
ELSEIF ABL:ARG:가창기능 == 3
	RETURN 140
ELSEIF ABL:ARG:가창기능 == 4
	RETURN 160
ELSEIF ABL:ARG:가창기능 == 5
	RETURN 190
ELSEIF ABL:ARG:가창기능 == 6
	RETURN 210
ELSEIF ABL:ARG:가창기능 == 7
	RETURN 250
ELSEIF ABL:ARG:가창기능 == 8
	RETURN 290
ELSEIF ABL:ARG:가창기능 == 9
	RETURN 330
ELSE
	RETURN 390
ENDIF
RETURN 90

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2860,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2860,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2860, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2860,ARG
SIF ARG == -1
	RETURN 9
IF ABL:ARG:가창기능 == 0
	RETURN 9
ELSEIF ABL:ARG:가창기능 == 1
	RETURN 12
ELSEIF ABL:ARG:가창기능 == 2
	RETURN 15
ELSEIF ABL:ARG:가창기능 == 3
	RETURN 18
ELSEIF ABL:ARG:가창기능 == 4
	RETURN 23
ELSEIF ABL:ARG:가창기능 == 5
	RETURN 26
ELSEIF ABL:ARG:가창기능 == 6
	RETURN 29
ELSEIF ABL:ARG:가창기능 == 7
	RETURN 34
ELSEIF ABL:ARG:가창기능 == 8
	RETURN 38
ELSEIF ABL:ARG:가창기능 == 9
	RETURN 41
ELSE
	RETURN 45
ENDIF
RETURN 9

;　相性
@SKILL_TYPE_2860,ARG
RETURN GET_TYPE_NUM("충격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2860
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2860, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2860, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2860,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2860,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2860, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2860
RETURN GET_SUCCESSION_NUM("충격")

;속도보정
@SKILL_SPEED_2860, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2860
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2860, ARG = -1
RETURN 12


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2860,ARG
RETURN GET_STATE_NUM("CLOSE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2860,ARG
RETURN 8

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2860,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2860,ARG
RETURN 90
