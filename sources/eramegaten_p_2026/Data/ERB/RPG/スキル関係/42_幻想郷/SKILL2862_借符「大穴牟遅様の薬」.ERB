RESULTS = 차부「오오나무치님의약」


;　명중
@SKILL_HITRATE_2862, ARG
RETURN 100

;　威力
@SKILL_POWER_2862, ARG
RETURN 1000

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2862,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2862,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2862, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2862,ARG
RETURN 10


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2862
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2862, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2862, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_2862,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2862,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2862, ARG
RETURN GET_SKILL_EFFECT_NUM("회복")

@SKILL_HEAL_TYPE_2862, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("割合")



;계승타입
@SKILL_SUCCESSION_TYPE_2862
RETURN GET_SUCCESSION_NUM("회복")

;속도보정
@SKILL_SPEED_2862, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2862
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_2862, ARG = -1
RETURN 10




;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2862, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)

;支払い発生フラグ
LOCAL:1 = 0

;コスト支払い
;CALL VAR_MP,ARG,-15,0
IF MONEY >= 500 || CFLAG:ARG:PT플래그 == 0
	;회복
	CALL SKILL_CURE_STATE_2862,CFLAG:LOCAL:상태이상
	IF (MAXBASE:LOCAL:ＨＰ > BASE:LOCAL:ＨＰ) || RESULT
		CALL HEAL_SINGLE, ARG, POS(ARG:1), 2862
		IF CFLAG:ARG:PT플래그 > 0
			PRINTFORMW ￥{MAX(500, MONEY / 500)}이(가) 지갑에서 소멸했다…
			MONEY -= MAX(500, MONEY / 500)
		ENDIF
	ELSE
		CALL PRINT_HIT_MESSAGE, POS(ARG:1), "回復する必要がなかった！", "w"
	ENDIF
ELSE
	PRINTFORMW 　　인색한 배교자 놈 나가라!
ENDIF

;====================================================
;実行内容ここまで
;====================================================
;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_2862,ARG,ARG:1,ARG:2
LOCAL = POS(ARG:1)

;支払い発生フラグ
LOCAL:1 = 0

;コスト支払い
;CALL VAR_MP,ARG,-15,0
IF MONEY >= 500
	;회복
	CALL SKILL_CURE_STATE_2862,CFLAG:LOCAL:상태이상
	IF (MAXBASE:LOCAL:ＨＰ > BASE:LOCAL:ＨＰ) || RESULT
		LOCAL:1 = 1
		CALL HEAL_SINGLE, ARG, POS(ARG:1), 2862
	ENDIF
	;支払い
	IF LOCAL:1 == 1
		PRINTFORMW ￥{MAX(500, MONEY / 500)}이(가) 지갑에서 소멸해 있었다…
		MONEY -= MAX(500, MONEY / 500)
	ENDIF
	SIF LOCAL:1 == 0
		PRINTFORMW 　　TARGET:[{ARG:1,2}] %CALLNAME:(LOCAL),20,LEFT%　>>>>>>　회복할 필요가 없었다!
ELSE

PRINTFORMW 　　인색한 배교자 놈 나가라!

ENDIF


;====================================================
;実行内容ここまで
