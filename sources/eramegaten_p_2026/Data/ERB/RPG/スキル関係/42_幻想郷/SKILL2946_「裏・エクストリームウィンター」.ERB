@SKILL_NAME_2946,ARG
RESULTS = 「뒷・익스트림윈터」
SIF  GETBIT (FLAG:커스텀게임화면,1)
	RESULTS = 「이면·익스트림 윈터」

;　명중
@SKILL_HITRATE_2946, ARG
RETURN 98

;　威力
@SKILL_POWER_2946, ARG
RETURN 390

;　クリティカル率
@SKILL_CRITICAL_RATE_2946, ARG
RETURN 40

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2946,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2946,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2946, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2946,ARG
RETURN 20

;　相性
@SKILL_TYPE_2946,ARG
RETURN GET_TYPE_NUM("핵열")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2946
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2946, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2946, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2946,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2946,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2946, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2946
RETURN GET_SUCCESSION_NUM("핵열")

;속도보정
@SKILL_SPEED_2946, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2946
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2946, ARG = -1
RETURN 15


@継承不能_2946
RETURN 1

;テンプレート用、追加効果シリーズ
@SKILL_ADDTIONAL_STATE_2946,ARG
RETURN GET_STATE_NUM("FREEZE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2946,ARG
RETURN GET_TYPE_NUM("빙결")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2946,ARG
RETURN 45

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2946,ARG
RETURN 99

