;すでに集中フラグが立てられているのならランダム・リピートの選定から除く
@SKILL_SELECTABLE_BY_AUTO_2877, ARG
SIF CFLAG:ARG:집중플래그
	RETURN 0
RETURN 1
;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_2877,ARG,ARG:1
SIF !SKILLGAGE_D_GET(ARG, 2877)
	RETURN 0
;攻撃を受けている
SIF !GET_CREC_ACT(ARG:1, ARG, "ATTACK")
	RETURN 0
;反撃の対象は反撃してきたキャラ(ポジションで返す)
RETURN 1, CPOS(ARG:1)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2877, ARG, ARG:1, ARG:2
IF FLAG:카운터중
	TFLAG:반사0데미지화 = 1
	CALL ATTACK_SKILL, ARG, ARG:1, ARG:2
	TFLAG:반사0데미지화 = 0
ELSE
	CFLAG:ARG:집중플래그 = 1
	PRINTFORMW %CALLNAME:ARG%은(는) 결계를 전개하고 다음 공격에 대비해 집중하고 있다!
	CALL SKILLGAGE_D_SET, ARG, 2877, 1
ENDIF
