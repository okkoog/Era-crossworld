;何のバッドステータスを治せるか
;「お芋の焼けるいい匂いでハッとして」色々回復、お芋食べたくてCLOSE（沈黙、魔封、口封じ）も回復
@SKILL_CURE_STATE_2873,ARG
IF SKILL_CHANGE(ARG, [[キャラ:미노리코]]) &&  FINDCHARA_B([[キャラ:시즈하]]) == 2
	SELECTCASE GET_STATE(ARG)
		CASE "HAPPY","PANIC","SLEEP","CLOSE","CHARM"
			RETURN 1
		CASEELSE
			RETURN 0
	ENDSELECT
ELSE
	RETURN 0
ENDIF


