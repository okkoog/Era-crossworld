	RETURN 23
ELSEIF ABL:ARG:요리기능 == 5
	RETURN 26
ELSEIF ABL:ARG:요리기능 == 6
	RETURN 29
ELSEIF ABL:ARG:요리기능 == 7
	RETURN 34
ELSEIF ABL:ARG:요리기능 == 8
	RETURN 38
ELSEIF ABL:ARG:요리기능 == 9
	RETURN 41
ELSE
	RETURN 45
ENDIF
RETURN 9


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2873
