;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2810,ARG
RESULTS = 「퀸・오브・버블」

;　명중
@SKILL_HITRATE_2810, ARG
RETURN 120

;　威力
@SKILL_POWER_2810, ARG
SIF ARG == -1
	RETURN 250
IF TALENT:ARG:6
	RETURN 450
ELSEIF ABL:ARG:순종 <= 5
	RETURN 250
ELSEIF ABL:ARG:순종 <= 9
	RETURN 300
ELSE
	RETURN 400
ENDIF

;　クリティカル率
@SKILL_CRITICAL_RATE_2810, ARG
IF MONEY <= 100000
	RETURN 10
ELSEIF MONEY <= 500000
	RETURN 20 
ELSEIF MONEY <= 1000000
	RETURN 30
ELSE
	RETURN 50 
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2810,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2810,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2810, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_2810,ARG
RETURN 5

;　相性
@SKILL_TYPE_2810,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2810
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2810, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2810, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2810,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2810,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2810, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2810
RETURN GET_SUCCESSION_NUM("만능")
