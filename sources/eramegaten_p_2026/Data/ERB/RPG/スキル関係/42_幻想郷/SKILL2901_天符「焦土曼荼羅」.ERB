
;スキル名
@SKILL_NAME_2901,ARG
RESULTS = 천부「초토만타라」 

;　명중
;スペカなのでちょっぴり上位互換
@SKILL_HITRATE_2901, ARG
RETURN 95

;　威力
;仕様上,単体相手なら1~3回になるのでダイン相当の320
;上限HIT数に引っかからなければ単体あたりの期待値は240
;物理なのでクリティカルが出るため、もっと高くなる
@SKILL_POWER_2901, ARG
RETURN 170

;ランクが上がっているので最低を少し上昇
;敵総数の判定を全後列合計にできるという強みもあるので、総HIT数は割合増える
;최저공격횟수
@SKILL_MINATTACKNUMBER_2901,ARG
RETURN 3

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2901,ARG
RETURN 8

;一体辺りの最大ＨＩＴ数
@SKILL_MAXATK_PER_2901,ARG
RETURN 3

;一体辺りの最低ＨＩＴ数
@SKILL_MINATK_PER_2901,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2901, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
;物理・属性・擬似全体攻撃なので重い
@SKILL_COST_2901,ARG
RETURN 20

;　相性
@SKILL_TYPE_2901,ARG
RETURN GET_TYPE_NUM("화염")
;화염

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2901
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2901, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2901, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2901,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2901,ARG
RETURN GET_SPHERE_NUM("전체")

;スキルがランダム範囲かどうか
@SKILL_RAND_TARGET_2901,ARG
RETURN 1

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2901, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2901
RETURN GET_SUCCESSION_NUM("화염")
;화염

;속도보정
@SKILL_SPEED_2901, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2901
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2901, ARG = -1
RETURN 10

@SKILL_RANKUP_2901
;ランクアップなし
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2901, ARG, ARG:1, ARG:2
CALL ATTACK_RAND,ARG,ARG:1,2901






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2901, ARG
PRINTL 모든 존재를 불태워 버리는 불꽃. 그 광경은 극락정토의 풍경과 지옥의 아비규환을 가져온다.
PRINTL 불꽃으로 적 전체에 무작위 최대 8회 공격. 물리 속성.
PRINTL 聖獣　토라마루 쇼의 스펠카드



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2901,ARG
RETURN 1
;とくにない

