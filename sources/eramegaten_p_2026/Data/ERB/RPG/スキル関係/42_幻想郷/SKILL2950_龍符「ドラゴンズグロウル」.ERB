
;スキル名
@SKILL_NAME_2950,ARG
RESULTS = 용부「드래곤즈그로울」
SIF  GETBIT (FLAG:커스텀게임화면,1)
	RESULTS = 용부「드래곤즈 그라울」

;　명중
@SKILL_HITRATE_2950, ARG
RETURN 100

;　威力
@SKILL_POWER_2950, ARG
RETURN 280

;　クリティカル
@SKILL_CRITICAL_RATE_2950, ARG
RETURN 20

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2950,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2950,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2950, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2950,ARG
RETURN 15

;　複合相性 攻撃相性のうち、もっともダメージが高くなるものになる
@SKILL_TYPE_2950, ARG
RETURN GET_TYPE_NUM("타격"), GET_TYPE_NUM("핵열"), GET_TYPE_NUM("파마"), GET_TYPE_NUM("화염"), GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2950
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2950, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2950, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2950,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2950,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2950, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입,継承不能
@SKILL_SUCCESSION_TYPE_2950
RETURN GET_SUCCESSION_NUM("타격")

@継承不能_2950
RETURN 1

;속도보정
@SKILL_SPEED_2950, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2950
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2950, ARG = -1
RETURN 15


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2950,ARG
RETURN 0

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2950,ARG
RETURN 0

@SKILL_ADDTIONAL_BASE_RATE_2950,ARG
RETURN 0

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2950,ARG
RETURN 0
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2950, ARG, ARG:1, ARG:2
CALL ATTACK_SINGLE,ARG,POS(ARG:1),2950

