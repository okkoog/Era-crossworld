;スキル名
@SKILL_NAME_2607,ARG
RESULTS = Civilization of Magic

;　명중
@SKILL_HITRATE_2607, ARG
RETURN 180

;　威力
@SKILL_POWER_2607, ARG = -1
SIF ARG == -1
	RETURN 300
SELECTCASE BASE:ARG:ＨＰ * 100 / MAXBASE:ARG:ＨＰ
	CASE IS <= 1
		RETURN 900
	CASE IS < 5
		RETURN 650
	CASE IS < 20
		RETURN 500
	CASE IS < 50
		RETURN 400
	CASE IS < 70
		RETURN 350
	CASEELSE
		RETURN 300
ENDSELECT

