;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2908,ARG
RESULTS = 뇌시「가고지사이클론」
SIF  GETBIT (FLAG:커스텀게임화면,1)
	RESULTS = 뇌시「가고우지 사이클론」

;　명중
@SKILL_HITRATE_2908, ARG
RETURN 100

;　威力
;周辺の方が威力が高い
@SKILL_POWER_2908, ARG
SIF FLAG:확산플래그
	RETURN 300
RETURN 168

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2908,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2908,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2908, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2908,ARG
RETURN 18

;　相性
@SKILL_TYPE_2908,ARG
RETURN GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2908
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2908, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2908, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2908,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2908,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2908, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2908
RETURN GET_SUCCESSION_NUM("전격")

;속도보정
@SKILL_SPEED_2908, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2908
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2908, ARG = -1
RETURN 10


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2908,ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2908,ARG
RETURN 6

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2908,ARG
RETURN 20

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2908,ARG
RETURN 75

;拡散攻撃用追加処理
@SKILL_SPREAD_2908,ARG
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2908, ARG, ARG:1, ARG:2
CALL ATTACK_SPREAD,ARG,ARG:1,2908



;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2908, ARG
PRINTL 적을 쓰러뜨리는 뇌광의 폭풍우. (전격 상성, 위력: 중)
PRINTL 중심부보다 주변 쪽의 데미지가 크다.
PRINTL 悪霊　소가노 토지코의 스펠카드



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2908,ARG
RETURN 1
;とくにない

