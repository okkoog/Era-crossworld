@SKILL_RANK_2861, ARG = -1
RETURN 15


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2861, ARG, ARG:1, ARG:2
IF SKILL_CHANGE(ARG, [[キャラ:케이네_백택]])
	FLAG:확산플래그 = 0
	SIF ABL:POS(ARG:1):속성LD != 1
		FLAG:확산플래그 = 1
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),2861
		FLAG:확산플래그 = 1
ELSE
	CALL ATTACK_FIELD,ARG,ARG:1,2861
ENDIF



;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2861, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:케이네_백택]]
	PRINTL 적 1체에 핵열 속성으로 특대 위력의 물리 공격을 1회 행한다.
	PRINTL LD 성향이 라이트 속성인 상대를 공격했을 경우 준 데미지만큼 반동을 받는다.
	PRINTL 
	PRINTL 빛을 두르고 적에게 돌진해 뿔이 돋아난 엄청나게 아픈 박치기를 먹인다.
	PRINTL 교육자로서의 긍지는 나쁜 아이를 훈육할 때 최대한의 효과를 발휘한다.
	PRINTL 백택 카미시라사와 케이네의 스펠카드
ELSE
	PRINTL 적 1열에 핵열 속성으로 중위력의 마법 공격을 1회 행한다.
	PRINTL 
	PRINTL 빛을 두르고 적진에서 대난동을 부린다.
	PRINTL 요마　카미시라사와 케이네의 스펠카드
ENDIF


;使用条件
@SKILL_SPECIAL_ACTIONABLE_2861,ARG
