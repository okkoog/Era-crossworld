;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2869,ARG
RESULTS = 화부「환상향의개화」


;　명중
@SKILL_HITRATE_2869, ARG
RETURN 100

;　威力
@SKILL_POWER_2869, ARG
SIF ARG == -1
	RETURN 300
SELECTCASE FLAG:확산플래그
	CASE IS <= 5
		RETURN 800
	CASE IS < 10
		RETURN 460
	CASE IS < 20
		RETURN 360
	CASEELSE
		RETURN 300
ENDSELECT

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2869,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2869,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2869, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2869,ARG
RETURN 40

;　相性
@SKILL_TYPE_2869,ARG
RETURN GET_TYPE_NUM("만능")
;만능

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2869
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2869, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2869, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2869,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2869,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2869, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2869
RETURN GET_SUCCESSION_NUM("만능")
;継承不能

;속도보정
@SKILL_SPEED_2869, ARG = -1
RETURN 0

@継承不能_2869
RETURN 1

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2869
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2869, ARG = -1
RETURN 15



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2869, ARG, ARG:1, ARG:2
FLAG:확산플래그 = BASE:ARG:ＨＰ * 100 / MAXBASE:ARG:ＨＰ
CALL ATTACK_FIELD,ARG,ARG:1,2869
FLAG:확산플래그 = 0



;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2869, ARG
PRINTL 모든 존재를 날려버리는 최강의 마법의 조각.
PRINTL 적 전체에 만능 상성의 마법 공격. 위기에 빠지면 마지막 힘을 쥐어짜낸다.
PRINTL 요마　카자미 유카의 스펠카드 (계승 불가)



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2869,ARG
RETURN 1
;とくにない

