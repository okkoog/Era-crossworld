;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2871, ARG, ARG:1, ARG:2
FOR LOCAL, 1, 17
	SIF POS(LOCAL) < 0
		CONTINUE
	SIF GET_STATE(CFLAG:POS(LOCAL):상태이상) == "DYING"
		CONTINUE
	FLAG:확산플래그 = ABL:ARG:속성LC != ABL:POS(LOCAL):속성LC ? 1 # 0
	CALL ATTACK_SINGLE,ARG,POS(LOCAL),2871
NEXT
