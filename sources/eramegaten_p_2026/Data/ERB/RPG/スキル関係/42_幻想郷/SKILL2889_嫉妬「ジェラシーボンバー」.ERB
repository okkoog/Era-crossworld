;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2889, ARG, ARG:1, ARG:2
#LOCALSIZE 4

	LOCAL = POS(ARG:1)
	FLAG:확산플래그 = 0

	;倍率１：対象と自身のカジャンダを加算する
	;敵のカジャンダ段階が＋であるほど威力増
	;こちらのほうがダメージ影響が大きいのは「自分が恵まれていない状況より敵が恵まれている方が嫉妬パワーが出る」ため
	FOR LOCAL:1,0,6
		LOCAL:2 += CFLAG:LOCAL:(GET_BATTLESTATUS(LOCAL:1) + "강화")
	NEXT
	;最大33（威力倍率33加算）
	FLAG:확산플래그 += (6 + LOCAL:2) / 6

	;自身のカジャンダ段階がマイナスであるほど威力増
	FOR LOCAL:1,0,6
		LOCAL:2 += CFLAG:ARG:(GET_BATTLESTATUS(LOCAL:1) + "강화")
	NEXT
	;最低-15（威力倍率15加算）
	FLAG:확산플래그 -= (6 + LOCAL:2) / 6

	;倍率ボーナスが入って最大倍率50
	FLAG:확산플래그 += 2

	;倍率２：敵の素質、彼我の状態異常を見る
	;基礎倍率は30、最大40
	;魅力的だったり細かったり優しかったり頭がよかったり清らかだったりすると嫉妬のため威力上昇
	;相手のみが健康でも威力上昇
	;乳・尻サイズについては「自分より小さければスレンダーで嫉妬」「同じサイズなら形で嫉妬」「デカけりゃデカいで嫉妬」するため基礎倍率に含む
	;性別身長体格についても乳尻とだいたい同様（それ言ったら魅力が仮にないとしたら「魅力故の災難に巻き込まれなさそう」で嫉妬しそうだが）
	;一部味方限定と思われる素質もあるが、敵使用時の威力確保のためということで
	LOCAL:2 = 30
	LOCAL:2 += (TALENT:LOCAL:매력 * 2) +(TALENT:LOCAL:매혹 * 2) +(TALENT:LOCAL:수수께끼의매력 * 3) +(TALENT:LOCAL:인기 * 2) +(TALENT:LOCAL:미끼 * 2) +(TALENT:LOCAL:슬렌더) +(TALENT:LOCAL:소악마) +(TALENT:LOCAL:헌신적) +(TALENT:LOCAL:솔직함) +(TALENT:LOCAL:우애) +(TALENT:LOCAL:냉정) +(TALENT:LOCAL:현명) +(TALENT:LOCAL:천사)

	;敵がGOODかつ自身がGOOD以外
	SIF CFLAG:LOCAL:상태이상 == GET_STATE_NUM("GOOD") && CFLAG:ARG:상태이상 != GET_STATE_NUM("GOOD")
		LOCAL:2 += 3

	;最大倍率40
	SIF LOCAL:2 >= 40
		LOCAL:2 = 40 

	;50*30＝1500
	;50*40＝2000
	FLAG:확산플래그 *= LOCAL:2

	;最低威力：100
	SIF FLAG:확산플래그 < 100
		FLAG:확산플래그 = 100
	;最大威力：2000
	SIF FLAG:확산플래그 > 2000
		FLAG:확산플래그 = 2000

	;自身に[질투]がなければ最大威力は400
	SIF FLAG:확산플래그 > 400 && TALENT:ARG:질투 == 0
		FLAG:확산플래그 = 400


CALL ATTACK_SINGLE,ARG,LOCAL,2889
FLAG:확산플래그 = 0





