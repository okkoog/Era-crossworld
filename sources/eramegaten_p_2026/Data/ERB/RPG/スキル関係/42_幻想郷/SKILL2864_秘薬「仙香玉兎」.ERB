;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2864,ARG
RESULTS = 비약「선향옥토」

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2864
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2864, ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

;속도보정
@SKILL_SPEED_2864, ARG = -1
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_2864
RETURN GET_SUCCESSION_NUM("회복")

@継承不能_2864
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_2864, ARG = -1
RETURN 15
;変化不可


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2864, ARG, ARG:1, ARG:2
;コスト支払い
CALL CURE_STATE_SINGLE,ARG,POS(ARG:1),2864, , 0

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_2864,ARG,ARG:1
;自分自身の行動で判定
SIF ARG != FLAG:행동순1
	RETURN 0
;味方同士でなければNG
SIF !IS_FRIEND(FLAG:행동순1, ARG)
	RETURN 0
;単体対象でないとダメ
SIF !INRANGE(CFLAG:ARG:타겟, 1, 16)
	RETURN 0
;回復スキルでないとダメ
CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
SIF GET_SKILL_EFFECT(RESULT) != "회복"
	RETURN 0
;治療可能かどうかの判定
CALL SKILL_CURE_STATE_2864, CFLAG:(ARG:1):상태이상
SIF !RESULT
	RETURN 0
RETURN 1, CFLAG:ARG:타겟


;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_2864, ARG
PRINTL 자동: 상태이상에 걸린 아군을 향해 단체 회복 스킬을 사용했을 때 이하의 연동 효과가 발동한다.
PRINTL 　　　「대상의 FLY, DYING, ORGY, HEAT 이외의 상태이상을 회복한다.」
PRINTL 天津神　야고코로 에이린의 스펠카드 (계승 불가)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_2864,ARG
RETURN 1

@SKILL_ACTIONABLE_BATTLE_2864, ARG
RETURN 0



;何のバッドステータスを治せるか
@SKILL_CURE_STATE_2864, ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT
