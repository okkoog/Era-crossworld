;スキル名
@SKILL_NAME_2930,ARG
RESULTS = 토부「베리베리경단」
SIF  GETBIT (FLAG:커스텀게임화면,1)
	RESULTS = 토부「베리베리 경단」

;　명중
@SKILL_HITRATE_2930, ARG
RETURN 100

;　威力
@SKILL_POWER_2930, ARG
SIF ARG == -1
	RETURN 90
IF ABL:ARG:요리기능 >= 10
	RETURN 300
ELSEIF ABL:ARG:요리기능 >= 6
	RETURN 200
ELSEIF ABL:ARG:요리기능 >= 3
	RETURN 160
ELSE
	RETURN 90
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2930,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2930,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2930, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2930,ARG

SIF ARG == -1
	RETURN 10
IF ABL:ARG:요리기능 >= 10
	RETURN 45
ELSEIF ABL:ARG:요리기능 >= 6
	RETURN 34
ELSEIF ABL:ARG:요리기능 >= 3
	RETURN 23
ELSE
	RETURN 10
ENDIF


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2930
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2930, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2930, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_2930,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2930,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2930, ARG
RETURN GET_SKILL_EFFECT_NUM("회복")

@SKILL_HEAL_TYPE_2930, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("통상")


;계승타입
@SKILL_SUCCESSION_TYPE_2930
RETURN GET_SUCCESSION_NUM("회복")

;속도보정
@SKILL_SPEED_2930, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2930
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2930, ARG = -1
RETURN 10

@継承不能_2930
RETURN 1

@SKILL_RANKUP_2930
;ランクアップ先は0つ
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2930, ARG, ARG:1, ARG:2
#DIM LCOUNT
#DIM L_T
#DIMS L_EFFECT
SELECTCASE ABL:ARG:요리기능
	CASE IS >= 9
		L_EFFECT = 回避・防御・魔法効果
	CASE IS >= 6
		L_EFFECT = 防御・魔法効果
	CASE IS >= 3
		L_EFFECT = 방어
ENDSELECT
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	IF ARG == L_T
		CALL SKILL_SET_カジャンダ, ARG, L_T, "攻撃・魔法威力" + L_EFFECT, 4, "短縮", "NOMES"
		CALL HEAL_SINGLE, ARG, L_T, 2930, 1, , "↑ 攻撃・魔法威力・" + L_EFFECT
	ELSE
		CALL SKILL_SET_カジャンダ, ARG, L_T, L_EFFECT, 4, "短縮", "NOMES"
		CALL HEAL_SINGLE, ARG, L_T, 2930, 1, , "↑ " + L_EFFECT
	ENDIF
NEXT
WAIT
