;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2856, ARG, ARG:1, ARG:2
#LOCALSIZE 3
;コスト支払い
;CALL PAY_COST,ARG,2856
LOCAL = 0
LOCAL:1 = 0
LOCAL:2 = GET_TYPE_NUM("만능")

;味方であり、紫が自パーティにいるか
SIF CFLAG:ARG:PT플래그 != 0 && FINDCHARA_B([[キャラ:유카리_동방]]) == 2
	LOCAL:1 = 1
;実行


FOR LOCAL , 0 , TYPENUM
	;万能は防げない
	SIF LOCAL == LOCAL:2
		CONTINUE
	SIF CFLAG:ARG:@"%GET_TYPE(LOCAL)%무효화횟수" < 1
		CFLAG:ARG:@"%GET_TYPE(LOCAL)%무효화횟수" = 1
	SIF CFLAG:ARG:@"%GET_TYPE(LOCAL)%무효화횟수" < 2 && LOCAL:1
		CFLAG:ARG:@"%GET_TYPE(LOCAL)%무효화횟수" = 2
NEXT


PRINTFORMW  　　TARGET:[{ARG,2}] %CALLNAME:ARG,20,LEFT%　>>>>>>　모든 공격을 \@ LOCAL:1 ? 2회 # 1회 \@ 무효화!




