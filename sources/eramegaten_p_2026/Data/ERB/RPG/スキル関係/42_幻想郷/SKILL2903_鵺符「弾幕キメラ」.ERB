@SKILL_HITRATE_2903, ARG
RETURN 100

;　威力
@SKILL_POWER_2903, ARG
RETURN 370

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2903,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2903,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2903, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2903,ARG
RETURN 13

;　相性
@SKILL_TYPE_2903,ARG
SIF ARG < 0 || スキル属性表示中
	RETURN GET_TYPE_NUM("不定")
RETURN RAND:18
;만능

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2903
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2903, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2903, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2903,ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2903,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2903, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2903
RETURN GET_SUCCESSION_NUM("만능")

;속도보정
@SKILL_SPEED_2903, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2903
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2903, ARG = -1
RETURN 7


