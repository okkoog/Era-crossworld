@SKILL_HITRATE_2879, ARG
RETURN 100

;　威力
@SKILL_POWER_2879, ARG
RETURN 195

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2879,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2879,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2879, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2879,ARG
RETURN 15

;　相性
@SKILL_TYPE_2879,ARG
RETURN GET_TYPE_NUM("검격")
;검격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2879
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2879, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2879, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2879,ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2879,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2879, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2879
RETURN GET_SUCCESSION_NUM("검격")
;검격

;속도보정
@SKILL_SPEED_2879, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2879
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2879, ARG = -1
RETURN 15



;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2879,ARG
RETURN GET_STATE_NUM("CURSE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2879,ARG
RETURN GET_TYPE_NUM("주살")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2879,ARG
RETURN 25

;追加効果付与確率上限
