;スキル変化？用ランク
@SKILL_RANK_2854, ARG = -1
RETURN 14




;====================================================
;トリガー発動条件
;
;詳しい仕様については資料フォルダの解説を参照してください
;====================================================
@SKILL_TRIGGER_ACTIONABLE_2854,ARG,ARG:1
#DIM LCOUNT
;自分自身の行動でないと誘発しない
SIF ARG != FLAG:행동순1
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
SIF CFLAG:ARG:입력행동 != 2854
	RETURN 0
RETURN 1, CPOS(ARG)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2854, ARG, ARG:1, ARG:2
IF FLAG:총공격중
	CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", -4, "단체", , "攻撃力ダウン！"
ELSE
	CALL ATTACK_SKILL,ARG,ARG:1,2854
ENDIF
