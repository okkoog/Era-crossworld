;通常攻撃
;スキルのテンプレートになっています

;身体強化を得意とする聖白蓮のスペカ　自分にヒートライザ＋気合・集中同時懸け
;もっと無茶な、バカバカしいくらいの効果が欲しかったが脳みそが貧相すぎた。
;

;スキル名
@SKILL_NAME_2902,ARG
;使用者が白蓮でなく、敵であるときのネーム変更。凪イベで敵ボスが強力スキルとして使用するためのもの。
IF ARG > -1 &&  !SKILL_CHANGE(ARG, [[キャラ:바쿠렌]]) && CFLAG:ARG:PT플래그 == 0
	;ライドウシリーズの「全パラメータが3増加する」効果のスキルより
	RESULTS = 아그니 개안
ELSE
	RESULTS = 대마법「마신복송」
ENDIF

;　명중
@SKILL_HITRATE_2902, ARG
RETURN 100

;　威力
@SKILL_POWER_2902, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2902,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2902,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2902, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2902,ARG
RETURN 60


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2902
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2902, ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　사거리
@SKILL_RANGE_2902,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2902,ARG
RETURN GET_SPHERE_NUM("적아군전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2902, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")


;계승타입
@SKILL_SUCCESSION_TYPE_2902
RETURN GET_SUCCESSION_NUM("지원")

;속도보정
@SKILL_SPEED_2902, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2902
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2902, ARG = -1
RETURN 15

@継承不能_2902
RETURN 1
;継承不可


