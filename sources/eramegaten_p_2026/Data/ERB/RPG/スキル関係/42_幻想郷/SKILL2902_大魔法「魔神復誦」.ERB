;スキル及び行動の実行
;====================================================
@ACTION_2902, ARG, ARG:1, ARG:2
#LOCALSIZE 1
;コストを支払う
;CALL PAY_COST,ARG,2902

FOR LOCAL,0,6
	CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") = MIN(32, CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") + 4)
NEXT

CFLAG:ARG:気合フラグ = 1
CFLAG:ARG:집중플래그 = 1

PRINTFORMW 　　TARGET:[{ARG,2}] %CALLNAME:ARG,20,LEFT%　>>>>>>　모든 능력 상승, 일격필살의 자세!




