;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2929,ARG
RESULTS = 총부「루나틱건」

;　명중
@SKILL_HITRATE_2929, ARG
RETURN 140

;　威力
@SKILL_POWER_2929, ARG
RETURN 50

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2929,ARG
SIF ARG == -1
	RETURN 3
IF BASE:ARG:LV >= 49
	RETURN 10
ELSEIF BASE:ARG:LV >= 44
	RETURN 9
ELSEIF BASE:ARG:LV >= 39
	RETURN 8
ELSEIF BASE:ARG:LV >= 34
	RETURN 7
ELSEIF BASE:ARG:LV >= 29
	RETURN 6
ELSEIF BASE:ARG:LV >= 24
	RETURN 5
ELSEIF BASE:ARG:LV >= 19
	RETURN 4
ELSE
	RETURN 3
ENDIF


;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2929,ARG
SIF ARG == -1
	RETURN 3
IF BASE:ARG:LV >= 49
	RETURN 10
ELSEIF BASE:ARG:LV >= 44
	RETURN 9
ELSEIF BASE:ARG:LV >= 39
	RETURN 8
ELSEIF BASE:ARG:LV >= 34
	RETURN 7
ELSEIF BASE:ARG:LV >= 29
	RETURN 6
ELSEIF BASE:ARG:LV >= 24
	RETURN 5
ELSEIF BASE:ARG:LV >= 19
	RETURN 4
ELSE
	RETURN 3
ENDIF

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2929, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2929,ARG
RETURN 15

;　相性
@SKILL_TYPE_2929,ARG
RETURN GET_TYPE_NUM("비구")
;비구

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2929
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2929, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2929, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2929,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2929,ARG
RETURN GET_SPHERE_NUM("일렬")

;スキルがランダム範囲かどうか
@SKILL_RAND_TARGET_2929,ARG
RETURN 1

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2929, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2929
RETURN GET_SUCCESSION_NUM("비구")
;無し

;속도보정
@SKILL_SPEED_2929, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2929
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2929, ARG = -1
RETURN 15


@継承不能_2929
RETURN 1
