	RESULTS = 「반혼접」
;突然のラストワードが敵を襲う！
ELSEIF SKILLGAGE_H_GET(ARG, 2855) == 100
	RESULTS = 「西行寺無余涅槃」
;80以上で脅威(Lunatic)級
ELSEIF SKILLGAGE_H_GET(ARG, 2855) > 79
	RESULTS = 「反魂蝶 -八分咲-」
;50以上で難関(Hard)級
ELSEIF SKILLGAGE_H_GET(ARG, 2855) > 49
	RESULTS = 「反魂蝶 -伍分咲-」
;30以上で普通(Normal)級
