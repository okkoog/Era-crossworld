;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2894,ARG
RESULTS = 억제「슈퍼에고」
SIF  GETBIT (FLAG:커스텀게임화면,1)
	RESULTS = 억제「슈퍼에고」

;　명중
@SKILL_HITRATE_2894, ARG
RETURN 100

;　威力
@SKILL_POWER_2894, ARG
RETURN 150

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2894,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2894,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2894, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2894,ARG
RETURN 20

;　相性
@SKILL_TYPE_2894,ARG
RETURN GET_TYPE_NUM("신경")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2894
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2894, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2894, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2894,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2894,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2894, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2894
RETURN GET_SUCCESSION_NUM("신경")

;속도보정
@SKILL_SPEED_2894, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2894
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2894, ARG = -1
RETURN 12


@継承不能_2894
RETURN 1

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2894,ARG
RETURN 0

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2894,ARG
RETURN 17
;만능

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2894,ARG
RETURN 0

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2894,ARG
RETURN 0

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_2894,ARG,ARG:1
;自分の行動時に一回のみ
SIF FLAG:행동순1 != ARG
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
SIF CFLAG:ARG:입력행동 != 2894
	RETURN 0
RETURN 1, CFLAG:ARG:PT플래그 ? 19 # 22

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2894, ARG, ARG:1, ARG:2
IF FLAG:총공격중
	CALL CURE_STATE_FIELD, ARG, ARG:1, 2894
ELSE
	CALL ATTACK_FIELD, ARG, ARG:1, 2894
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2894, ARG
PRINTL 초자아가 적·아군의 본능을 억제한다.
PRINTL 적 전체에 신경 상성의 물리 공격을 행한다.
PRINTL 공격 후에 연동 효과가 발동한다. 「아군의 HAPPY, CLOSE, PANIC, CHARM을 해소한다.」
PRINTL 마왕　코메이지 코이시의 스펠카드 (계승 불가)



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2894,ARG
RETURN 1
;とくにない

;控えに使えるか
@SKILL_T_RESERVE_2894, ARG
RETURN 0

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_2894,ARG
SELECTCASE GET_STATE(ARG)
	CASE "HAPPY","CLOSE","PANIC","CHARM"
		RETURN 1
	CASEELSE
		RETURN 0
ENDSELECT

