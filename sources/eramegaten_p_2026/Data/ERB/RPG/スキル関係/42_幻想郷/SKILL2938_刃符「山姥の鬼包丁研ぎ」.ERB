;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2938,ARG
RESULTS = 인부「야만바의식칼갈기」

;　명중
@SKILL_HITRATE_2938, ARG
RETURN 100

;　威力
@SKILL_POWER_2938, ARG
RETURN 100

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2938,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2938,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2938, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2938,ARG
RETURN 18

;　相性
@SKILL_TYPE_2938,ARG
RETURN GET_TYPE_NUM("검격")
;검격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2938
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2938, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2938, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2938,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2938,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2938, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2938
RETURN GET_SUCCESSION_NUM("검격")
;검격

;속도보정
@SKILL_SPEED_2938, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2938
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2938, ARG = -1
RETURN 23


@継承不能_2938
RETURN 1
;不可


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2938, ARG, ARG:1, ARG:2
CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 8, "단체", "NOMES"
;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 8)

PRINTFORMW %CALLNAME:ARG%의 공격력이 대폭 상승!

CALL ATTACK_FIELD,ARG,ARG:1,2938

