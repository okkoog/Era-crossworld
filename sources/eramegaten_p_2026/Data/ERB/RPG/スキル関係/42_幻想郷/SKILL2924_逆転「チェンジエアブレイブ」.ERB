;スキル及び行動の実行
;====================================================
@ACTION_2924, ARG, ARG:1, ARG:2
#DIM LCOUNT, 2
FOR LCOUNT:1, 1, 17
	SIF !IS_TARGET_ABLE(POS(LCOUNT:1))
		CONTINUE
	FOR LCOUNT, 0, VARSIZE("KAJA_TABLE")
		CFLAG:POS(LCOUNT:1):(KAJA_TABLE:LCOUNT + "강화") = -ABS(CFLAG:POS(LCOUNT:1):(KAJA_TABLE:LCOUNT + "강화"))
	NEXT
	IF IS_FRIEND(ARG, POS(LCOUNT:1))
		CALL PRINT_HIT_MESSAGE, POS(LCOUNT:1), "能力強化が弱化に反転！"
	ELSE
		CALL SKILL_SET_カジャンダ, ARG, POS(LCOUNT:1), "攻撃_防御_命中_回避_魔法威力_魔法効果_クリティカル_BS付着率", -4, "단체", "NOMES"
		CALL PRINT_HIT_MESSAGE, POS(LCOUNT:1), "能力強化が弱化に反転！ & 全能力ダウン!"
	ENDIF
NEXT
WAIT
