;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2812,ARG
RESULTS = 빈부「미스찬스・스캐터」

;　명중
@SKILL_HITRATE_2812, ARG
RETURN 89

;　威力
@SKILL_POWER_2812, ARG
RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2812,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2812,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2812, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2812,ARG
RETURN 45

;　相性
@SKILL_TYPE_2812,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2812
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2812, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2812, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2812,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2812,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2812, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2812
RETURN GET_SUCCESSION_NUM("만능")

;속도보정
@SKILL_SPEED_2812, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2812
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2812, ARG = -1
RETURN 15

@継承不能_2812
RETURN 1
;特殊


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2812,ARG
A = RAND:4
IF A == 0
	RETURN GET_STATE_NUM("CURSE")
ELSEIF A == 1
	RETURN GET_STATE_NUM("CLOSE")
ELSEIF A == 2
	RETURN GET_STATE_NUM("POISON")
ELSE
	RETURN GET_STATE_NUM("DYING")
ENDIF

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2812,ARG
RETURN 11
;주살

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2812,ARG
RETURN 35

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2812,ARG
RETURN 100
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2812, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,2812






