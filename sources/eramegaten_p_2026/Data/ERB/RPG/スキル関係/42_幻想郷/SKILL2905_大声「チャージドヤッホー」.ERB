;210915	NEO		「反響」攻撃なので、壁があるとカキンカキン跳ね返って多段攻撃になるように変更
;				都合上カーンを常時貫通。反響状態だとかなり強力


;スキル名
@SKILL_NAME_2905,ARG
RESULTS = 대성「차지드야호」
SIF  GETBIT (FLAG:커스텀게임화면,1)
	RESULTS = 대성「차지드 야호」

;　명중
@SKILL_HITRATE_2905, ARG
RETURN 100

;　威力
@SKILL_POWER_2905, ARG
RETURN 210

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2905,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2905,ARG
SIF FLAG:확산플래그 == 1
	RETURN 3
RETURN 1


;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2905, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2905,ARG
RETURN 10

;　相性
@SKILL_TYPE_2905,ARG
RETURN GET_TYPE_NUM("충격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2905
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2905, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2905, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2905,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2905,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2905, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2905
RETURN GET_SUCCESSION_NUM("충격")

;속도보정
@SKILL_SPEED_2905, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2905
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2905, ARG = -1
RETURN 7


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2905, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)

	;おまじない
	LOCAL:1 = 0
	LOCAL:2 = 0

	;反射フラグを保存（テトラ・マカラを両方見る）
	;LOCAL:1 = CFLAG:POS(LOCAL):물리반사플래그
	;LOCAL:2 = CFLAG:POS(LOCAL):마법반사플래그

	LOCAL:1 = CFLAG:LOCAL:물리반사플래그
	LOCAL:2 = CFLAG:LOCAL:마법반사플래그
	;反射フラグが立っていたなら強化版に
	SIF LOCAL:1 > 0 || LOCAL:2 > 0 
		FLAG:확산플래그 = 1

	;カーンを無効化
	CFLAG:LOCAL:물리반사플래그 = 0
	CFLAG:LOCAL:마법반사플래그 = 0
	;CFLAG:LOCAL:물리반사플래그 = 0
	;CFLAG:LOCAL:마법반사플래그 = 0

	CALL ATTACK_SINGLE,ARG,LOCAL,2905

	;反射フラグを戻す
	CFLAG:LOCAL:물리반사플래그 = LOCAL:1
	CFLAG:LOCAL:마법반사플래그 = LOCAL:2
	;CFLAG:POS(LOCAL):물리반사플래그 = LOCAL:1
	;CFLAG:POS(LOCAL):마법반사플래그 = LOCAL:2




