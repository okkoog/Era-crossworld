;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2890,ARG
RESULTS = 삼보필살

;　명중
@SKILL_HITRATE_2890, ARG
RETURN 100

;　威力
@SKILL_POWER_2890, ARG
RETURN MAX(FLAG:확산플래그 - 10,1)

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2890,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2890,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2890, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2890,ARG
SIF ARG > -1
	RETURN MAX((MAXBASE:ARG:ＭＰ / 3),1)
RETURN 1

;　相性
@SKILL_TYPE_2890,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2890
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2890, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2890, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2890,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2890,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2890, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2890
RETURN GET_SUCCESSION_NUM("만능")
@継承不能_2890
RETURN 1
;不可

;속도보정
@SKILL_SPEED_2890, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2890
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2890, ARG = -1
RETURN 0



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2890, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
FLAG:확산플래그 = MAXBASE:ARG:ＭＰ *2 + 150
CALL ATTACK_SINGLE,ARG,LOCAL,2890
;BASE:ARG:ＭＰ = BASE:ARG:ＭＰ - (MAXBASE:ARG:ＭＰ / 3)

FLAG:확산플래그 = 0




;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2890, ARG
PRINTL 적 1체를 완전히 파괴하는 괴력난신의 극치. 물리 속성.
PRINTL MP의 1/3을 소비한다. 위력은 최대 MP에 의존.
PRINTL 闘鬼　호시구마 유기의 스펠카드 (계승 불가)



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2890,ARG
RETURN 1
;とくにない

