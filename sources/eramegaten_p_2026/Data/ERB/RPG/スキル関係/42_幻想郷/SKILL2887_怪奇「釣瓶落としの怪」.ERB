;210915	NEO		第一ターンにキスメが使用した場合大幅にパワーアップするよう変更、通常時にCT追加

;スキル名
@SKILL_NAME_2887,ARG
RESULTS = 괴기「두레박떨이의괴」

;　명중
@SKILL_HITRATE_2887, ARG
SIF FLAG:경과턴수 == 0 && SKILL_CHANGE(ARG, [[キャラ:키스메]])
	RETURN 150
RETURN 100

;　威力
@SKILL_POWER_2887, ARG
SIF FLAG:경과턴수 == 0 && SKILL_CHANGE(ARG, [[キャラ:키스메]])
	RETURN 420
RETURN 225

;　クリティカル率
@SKILL_CRITICAL_RATE_2887, ARG
SIF FLAG:경과턴수 == 0 && SKILL_CHANGE(ARG, [[キャラ:키스메]])
	RETURN 50
RETURN 10

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2887,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2887,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2887, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2887,ARG
RETURN 8

;　相性
@SKILL_TYPE_2887,ARG
RETURN GET_TYPE_NUM("화염")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2887
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2887, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2887, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2887,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2887,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2887, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2887
RETURN GET_SUCCESSION_NUM("화염")

;속도보정
@SKILL_SPEED_2887, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2887
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2887, ARG = -1
RETURN 7


