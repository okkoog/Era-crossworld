;スキル名
@SKILL_NAME_2857,ARG
RESULTS = 경부「색과공의경계」


;　명중
@SKILL_HITRATE_2857, ARG
RETURN 100

;　威力
@SKILL_POWER_2857, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2857,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2857,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2857, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2857,ARG
RETURN 30


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2857
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2857, ARG
RETURN GET_SKILL_TARGET_NUM("전투전체")

;　사거리
@SKILL_RANGE_2857,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2857,ARG
RETURN GET_SPHERE_NUM("적아군전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2857, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")


;계승타입
@SKILL_SUCCESSION_TYPE_2857
RETURN GET_SUCCESSION_NUM("지원")
;속도보정
@SKILL_SPEED_2857, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2857
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2857, ARG = -1
RETURN 10




;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2857, ARG, ARG:1, ARG:2
;コストを支払う
;CALL VAR_MP,ARG,-30
FOR LOCAL,1, 17
	SIF !IS_TARGET_ABLE(POS(LOCAL))
		CONTINUE
	FOR LOCAL:1, GETNUM(CFLAG,"공격강화"), GETNUM(CFLAG,"BS부착률강화")+1
		CFLAG:POS(LOCAL):(LOCAL:1) *= -1
		;IF CFLAG:POS(LOCAL):(LOCAL:1) > 0
		;	CFLAG:POS(LOCAL):(LOCAL:1) = MAX(-16, - ABS(CFLAG:POS(LOCAL):(LOCAL:1) ) )
		;ELSEIF CFLAG:POS(LOCAL):(LOCAL:1) < 0
		;	CFLAG:POS(LOCAL):(LOCAL:1) = MIN(32, ABS(CFLAG:POS(LOCAL):(LOCAL:1) ) )
		;ENDIF
	NEXT
NEXT

PRINTFORMW 양과 음의 경계를 뒤흔들어, 적·아군 전원의 강화와 약화가 뒤바뀌었다!






