	RESULTS = 소부「메를랑 해피 라이브」

;　명중
@SKILL_HITRATE_2851, ARG
RETURN 100

;　威力
@SKILL_POWER_2851, ARG
SIF ARG == -1
	RETURN 110
IF ABL:ARG:가창기능 == 0
	RETURN 110
ELSEIF ABL:ARG:가창기능 == 1
	RETURN 130
ELSEIF ABL:ARG:가창기능 == 2
	RETURN 150
ELSEIF ABL:ARG:가창기능 == 3
	RETURN 170
ELSEIF ABL:ARG:가창기능 == 4
	RETURN 190
ELSEIF ABL:ARG:가창기능 == 5
	RETURN 210
ELSEIF ABL:ARG:가창기능 == 6
	RETURN 240
ELSEIF ABL:ARG:가창기능 == 7
	RETURN 300
ELSEIF ABL:ARG:가창기능 == 8
	RETURN 350
ELSEIF ABL:ARG:가창기능 == 9
	RETURN 400
ELSE
	RETURN 430
ENDIF
RETURN 100

