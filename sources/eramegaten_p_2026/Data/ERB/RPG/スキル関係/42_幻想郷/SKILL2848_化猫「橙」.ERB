;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2848, ARG, ARG:1, ARG:2
#LOCALSIZE 1
;コストを支払う
;CALL PAY_COST,ARG,2848
IF CFLAG:ARG:PT플래그 == 0 || FINDCHARA_B([[キャラ:란]]) == 2
	FOR LOCAL,0,6
		CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") = MIN(32, CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") + 4)
	NEXT
	PRINTFORMW 　　TARGET:[{ARG,2}] %CALLNAME:ARG,20,LEFT%　>>>>>>　모든 능력이 올랐다!
ELSE
	FOR LOCAL,0,6
		CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") = MIN(32, CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") + 8)
	NEXT
	PRINTFORMW 　　TARGET:[{ARG,2}] %CALLNAME:ARG,20,LEFT%　>>>>>>　모든 능력이 대폭 올랐다!
ENDIF

