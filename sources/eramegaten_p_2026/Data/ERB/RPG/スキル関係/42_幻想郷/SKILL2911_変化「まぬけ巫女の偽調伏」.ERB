;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2911, ARG, ARG:1, ARG:2
;難題 「五色の弾丸」の処理を拝借
;ARG:0…実行者のCHARA Num　ARG:1…対象のポジションNum

;------------------------------------------------
; LOCAL:0 対象Chara Num
; LOCAL:1 効果種別
; LOCAL:8 範囲Un
; LOCAL:9 範囲Up
;------------------------------------------------
; 初期化処理
VARSET LOCAL, 0, 0, 10
LOCAL:1 = RAND:10000
SELECTCASE LOCAL:1
	CASE IS < 2000
		LOCAL:1 = 5
	CASE IS < 4000
		LOCAL:1 = 4
	CASE IS < 6000
		LOCAL:1 = 3
	CASE IS < 8000
		LOCAL:1 = 2
	CASE IS < 10000
		LOCAL:1 = 1
	CASEELSE
		; ここに来ることは無いはずだが……
		LOCAL:1 = 6
ENDSELECT
; 範囲設定
;IF CFLAG:ARG:PT플래그 == 0
;	LOCAL:8 = 1
;	LOCAL:9 = 7
;ELSE
;	LOCAL:8 = 7
;	LOCAL:9 = 17
;ENDIF

;難題名表示
LOCALS = "ENPTY"
SELECTCASE LOCAL:1
	CASE 1
		LOCALS = 변화「얼간이 무녀의 거짓 조복」
		FLAG:확산플래그 = 1
	CASE 2
		LOCALS = 「신사의 석가모니」
		FLAG:확산플래그 = 2
	CASE 3
		LOCALS = 「벤텐의 비파법사」
		FLAG:확산플래그 = 3
	CASE 4
		LOCALS = 「장난은 끝이다」
		FLAG:확산플래그 = 4
	CASE 5
		LOCALS = ＊우주기밀 누설! 즉시 처치하라＊
		FLAG:확산플래그 = 5
ENDSELECT
CALL MESSAGE_B(1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)
CALL ATTACK_FIELD,ARG,ARG:1, 2911






