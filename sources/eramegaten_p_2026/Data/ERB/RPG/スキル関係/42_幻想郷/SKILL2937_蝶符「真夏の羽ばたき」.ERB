;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2937,ARG
RESULTS = 접부「한여름의날갯짓」

;　명중
@SKILL_HITRATE_2937, ARG
RETURN 120


;　威力
;マハザン130マハザンマ210マハザンダイン305
@SKILL_POWER_2937, ARG
SIF ARG == -1
	RETURN 190
IF BASE:ARG:LV > 69
	RETURN 500
ELSEIF BASE:ARG:LV > 59
	RETURN 425
ELSEIF BASE:ARG:LV > 49
	RETURN 350
ELSEIF BASE:ARG:LV > 44
	RETURN 310
ELSEIF BASE:ARG:LV > 39
	RETURN 280
ELSEIF BASE:ARG:LV > 34
	RETURN 250
ELSEIF BASE:ARG:LV > 29
	RETURN 220
ELSE
	RETURN 190
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2937,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2937,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2937, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2937,ARG
SIF ARG == -1
	RETURN 20
IF BASE:ARG:LV > 69
	RETURN 50
ELSE
	RETURN 20
ENDIF

;　相性
@SKILL_TYPE_2937,ARG
RETURN GET_TYPE_NUM("충격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2937
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2937, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2937, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2937,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2937,ARG
SIF ARG == -1
	RETURN 2
IF BASE:ARG:LV > 44
	RETURN 3
ELSE
	RETURN 2
ENDIF

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2937, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2937
RETURN GET_SUCCESSION_NUM("충격")

;속도보정
@SKILL_SPEED_2937, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2937
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2937, ARG = -1
RETURN 10


@継承不能_2937
RETURN 1
;不可

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2937, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,2937






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2937, ARG
PRINTL 적 1열에 충격 속성으로 소위력의 마법 공격을 1회 행한다.
PRINTL 추가 효과: 레벨에 따라 위력 상승·전체화. 약간 높은 명중률.
PRINTL 강력한 날갯짓을 일으켜 충격파를 쏘아 적을 공격한다. 강해지면
PRINTL 머지않아 신의 영역까지 도달한다. 요정 이터니티 라바의 스펠카드. (전용)



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2937,ARG
RETURN 1
;とくにない

