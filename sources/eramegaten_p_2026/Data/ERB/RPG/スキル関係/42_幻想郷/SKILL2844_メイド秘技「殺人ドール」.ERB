;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2844,ARG
RESULTS = 메이드비기「살인인형」
SIF  GETBIT (FLAG:커스텀게임화면,1)
	RESULTS = 메이드 비기「살인 돌」

;　명중
@SKILL_HITRATE_2844, ARG
RETURN 110

;　威力
@SKILL_POWER_2844, ARG
SIF ARG == -1
	RETURN 110
IF ABL:ARG:요리기능 == 0
	RETURN 110
ELSEIF ABL:ARG:요리기능 == 1
	RETURN 130
ELSEIF ABL:ARG:요리기능 == 2
	RETURN 150
ELSEIF ABL:ARG:요리기능 == 3
	RETURN 170
ELSEIF ABL:ARG:요리기능 == 4
	RETURN 190
ELSEIF ABL:ARG:요리기능 == 5
	RETURN 210
ELSEIF ABL:ARG:요리기능 == 6
	RETURN 240
ELSEIF ABL:ARG:요리기능 == 7
	RETURN 300
ELSEIF ABL:ARG:요리기능 == 8
	RETURN 350
ELSEIF ABL:ARG:요리기능 == 9
	RETURN 400
ELSE
	RETURN 400
ENDIF
RETURN 110

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2844,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2844,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
