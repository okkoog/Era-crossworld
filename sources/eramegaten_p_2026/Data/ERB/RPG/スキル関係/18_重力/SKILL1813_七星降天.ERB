RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1813,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1813, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1813,ARG
RETURN 30

;　相性
@SKILL_TYPE_1813,ARG
RETURN GET_TYPE_NUM("중력")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1813
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_1813, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1813, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_1813,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1813,ARG
IF SKILL_CHANGE(ARG, [[キャラ:츠쿠요미]])
	RETURN 3
ELSE
	RETURN 1
ENDIF

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_1813, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_1813
RETURN GET_SUCCESSION_NUM("중력")

;속도보정
