;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1813
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1813, ARG = -1
RETURN 13





;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_1813, ARG, ARG:1, ARG:2
IF SKILL_CHANGE(ARG, [[キャラ:츠쿠요미]])
	CALL ATTACK_FIELD,ARG,ARG:1,1813
ELSE
	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,1813
ENDIF





;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_1813, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:츠쿠요미]]
	PRINTL 적 전체에 중력 상성의 특대 데미지
ELSE
	PRINTL 적 １체에 중력 상성의 특대 데미지
ENDIF




;使用条件
@SKILL_SPECIAL_ACTIONABLE_1813,ARG
RETURN 1
