;=====================================================
;●『나와라나의모든중마』
;=====================================================
;　サマナーあなたが、専用剣「쿠시나다노츠루기」を装備中の場合のみ使用可能な攻撃
;　「COMP内手持ちの悪魔数×MAG充足率」が威力になる（最低10～最大2500）。クリティカル率も数に依存。
;　装備さえできていれば使用条件は特にないが、大量のMAGを消費し、使用に堪える威力を出せるのは１、２回程度
;　/
;　あなたのスキルである都合上、CSTRスキルにはしない
;　命中、CTにも影響を与えようかと思ったけど変動するのは威力だけ
;　ゲージ技にしようかとも思ったけど連射できるのがイベント戦闘だけなので連射可能
;　（20体×60％でパなすと威力1200、次は威力600、その次はもう威力10）
;=====================================================

;スキル名
@SKILL_NAME_3967,ARG
	RESULTS = 나와라 나의 모든 중마

;　명중
@SKILL_HITRATE_3967, ARG
	;ただしシナリオイベント中は必中
	SIF SKILL_3967_FULLPOWER()
		RETURN 9999

	;通常時も高い
	RETURN 200

;　威力
@SKILL_POWER_3967, ARG
#DIM 手持ち悪魔数
#DIM MAG充足率
#DIM 威力値
	SIF ARG == -1
		RETURN 2500
	;悪魔の数チェック
	CALL SKILL_3967_DEVIL_CHECK
	手持ち悪魔数 = RESULT

	;MAG充足率はここでパーセントにしておく
	MAG充足率    = GET_CHARA_STOCK_MAG(ARG) * 100 / GET_CHARA_MAXMAG(ARG)

	;最低値の保証とカンストの設定
	;５体×80％＝威力400、という具合
	手持ち悪魔数 = LIMIT(手持ち悪魔数, 1,  50)
	MAG充足率    = LIMIT(MAG充足率,    1, 100)
	威力値       = 手持ち悪魔数 * MAG充足率

	;ただしシナリオイベント中は威力が大幅に上昇（悪魔の数を増した上で常時MAG100％扱い）
	SIF SKILL_3967_FULLPOWER()
		威力値       = (手持ち悪魔数 + 10) * 100

	;威力値は10～2500、腐っても万能相性全体物理攻撃だけどこれは腐りすぎだと思う
	威力値       = LIMIT(威力値, 10 ,2500)

	RETURN 威力値

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3967,ARG
	RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3967,ARG
	RETURN 1


;クリティカル率
@SKILL_CRITICAL_RATE_3967, ARG
	;シナリオイベント中は強化
	SIF SKILL_3967_FULLPOWER()
		RETURN 25

	RETURN 5

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3967, ARG
	;消費なし＝1、ただしスキル実行後MAGを大幅に消費する
	RETURN 1

;　コストの量
@SKILL_COST_3967,ARG
	;上述の通り、MAGを大量消費
	RETURN 0

;　複合相性
@SKILL_TYPE_3967,ARG
	RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3967
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")	;どちらでもない

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3967, ARG
	;物理攻撃
	RETURN 1

;攻撃タイプ(1:物理, 2:魔法, 3:총, 4:アイテム, 5:割合)
@SKILL_ATTACKTYPE_3967, ARG
	SIF ARG == -1
		RETURN 1
	;攻撃威力と銃攻撃威力の高いほうで計算を行う
	SIF MAXBASE:ARG:공격 >= MAXBASE:ARG:총공격
		RETURN 1
	;銃のほうが強かったら銃威力
	RETURN 3


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3967, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3967,ARG
	RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3967,ARG
	;敵全体
	RETURN 3

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_3967, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3967
	RETURN GET_SUCCESSION_NUM("만능")
	;継承不可

;속도보정
@SKILL_SPEED_3967, ARG = -1
	RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3967
	RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3967, ARG = -1
	RETURN 15

@継承不能_3967
	;継承不能な
	RETURN 2

@リンク不能_3967
RETURN 1

;追加効果ステータス
@SKILL_ADDTIONAL_STATE_3967,ARG
	RETURN 0

;추가효과상성
@SKILL_ADDTIONAL_TYPE_3967,ARG
	RETURN 0

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_3967,ARG
	RETURN 0

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_3967,ARG
	RETURN 0



;====================================================
;追加コマンド(一番下)
;====================================================
@INPUT_COM_NAME_3967,ARG
RESULTS = 出でよ、我が全ての仲魔
RESULTS:1 = 『나와라、나의 모든 중마』
RETURN 2

@INPUT_COM_ABLE_出でよ、我が全ての仲魔,ARG
RESULTS = 串蛇不在
SIF GETCHARA([[キャラ:쿠시나다]]) < 0
	RETURN -1
RETURN 1

;====================================================
;コマンド実行
;====================================================
@INPUT_COM_出でよ、我が全ての仲魔,ARG
#LOCALSIZE 1
	CALL CHECK_ACTIONABLE,ARG,3967
	SIF RESULT == 0
		RETURN 0
	CALL SELECT_SKILL_TARGET,3967,ARG
	SIF RESULT == -1
		RETURN -1
	CFLAG:(ARG):타겟 = RESULT
	CFLAG:(ARG):입력행동 = 3967
	CALL SET_REPEAT_CHARA, ARG
	CFLAG:ARG:타겟 = 22



	RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3967, ARG, ARG:1, ARG:2
;#DIM 元々の攻撃力
;#DIM 元々のタルカジャ
#DIM 減少MAG
;攻撃の実行
CALL ATTACK_FIELD, ARG, ARG:1, 3967

;MAGの消費
IF SKILL_3967_FULLPOWER()
	;シナリオイベント中は減らない
ELSE
	;MAGがガッポリ減る
	;基本は現在値から30％か50000MAGの多いほう
	CALL CONTROL_MAG, ARG, -MAX(GET_CHARA_STOCK_MAG(ARG) * 30 / 100, 50000)
ENDIF



