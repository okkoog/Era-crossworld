;====================================================



;　 説明文の表示
@SKILL_EXPLAIN_3967, ARG
	PRINTFORML 적 전체에 만능 상성의 물리데미지를 준다。
	PRINTFORML 검과 총으로 공격력을 비교해、높은 쪽을 사용해 공격한다。
	PRINTFORML 사용할 경우、%CALLNAME:MASTER%의 ＭＡＧ를 ＊크게＊ 소비한다。
	PRINTFORML ※쿠시나다히메가 동료마에 없을 경우、사용할 수 없다※
	PRINTFORML 　
	PRINTFORML 위력은 이하의 요소에 의존한다。
	PRINTFORML ・%CALLNAME:MASTER%의 ＭＡＧ 충족률
	PRINTFORML ・ＰＴ 내의 악마＋ＣＯＭＰ 내의 악마의 수
	PRINTFORML 　※서버 내의 악마는 카운트되지 않는다※
	PRINTFORML 　
	PRINTFORML 쿠시나다히메의 변형된 검인 쿠시나다노츠루기에서 ＭＡＧ를 받아、
	PRINTFORML %CALLNAME:MASTER%의 모든 동료마를 소환해、일제히 공격시킨다。
	IF イベントフラグ:41:0 == 5 && イベントフラグ:41:1 == 10 && イベントフラグ:41:12 == 3
		PRINTFORML 　
		PRINTFORML 【MAGNETITE MAX!!!】
	ENDIF


;使用条件
@SKILL_SPECIAL_ACTIONABLE_3967,ARG
	;サマナーLv5でなければ使用不能
	SIF TALENT:MASTER:서머너 < 5
		RETURN 0
	;くしなだのつるぎを装備していなければ不可……は、このスキルがそもそも装備に付与されたスキルになるからいいか。
;	SIF そうび（剣）：ますたー == くしなだのつるぎ
;		RETURN 0

	RETURN 1


@SKILL_3967_FULLPOWER
#FUNCTION
;クラリオンとの戦闘中のみﾌﾙﾊﾟﾜｰ！
SIF イベントフラグ:41:12 == 3 && イベントフラグ:41:0 == 5 && イベントフラグ:41:1 == 10
	RETURNF 1
;それ以外の時は変なことはしない
RETURNF 0


@SKILL_3967_DEVIL_CHECK
#DIM DYNAMIC 手持ち悪魔数
#DIM DYNAMIC LCOUNT
;●悪魔チェック
FOR LCOUNT, 0, BCHARANUM
	;「＠CASTING_CHOOSE_COMPANION」とほぼ同条件で弾く
	;つまり対象が召喚できるかなんだけど、ここでは非戦闘員も（悪魔なら）カウント
	;まあ非戦闘員悪魔はほぼいないと思うけど
	;
	;メンテナンス性を考慮して@CASTING_CHOOSE_COMPANIONを使うように変更(20250621)
	CALL CASTING_CHOOSE_COMPANION, LCOUNT
	SIF !RESULT
		CONTINUE
	手持ち悪魔数 += 1
NEXT	
RETURN 手持ち悪魔数
