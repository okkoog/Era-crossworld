RETURN 2

@INPUT_COM_ABLE_スパームボム,ARG
RETURN 1

;====================================================
;コマンド実行
;====================================================
@INPUT_COM_スパームボム,ARG
#DIM DYNAMIC L_USEABLE, 2
$INPUT_LOOP
;GOTO用のラベルを設定
PRINTFORML 봄에 의한 특수공격을 선택
CALL CHECK_ACTIONABLE,ARG,3965
IF RESULT
	PRINTL [1] 스펌봄
	L_USEABLE:0 = 1
ELSE
	HTML_PRINT SET_COLOR_TAG(SET_BUTTON_TAG("[1] 스펌봄", "1", RESULTS), "gray")
ENDIF
CALL CHECK_ACTIONABLE,ARG,3966
IF RESULT
	PRINTL [2] 스펌봄러시
	L_USEABLE:1 = 2
ELSE
	HTML_PRINT SET_COLOR_TAG(SET_BUTTON_TAG("[2] 스펌봄러시", "2", RESULTS), "gray")
ENDIF
DRAWLINE
PRINTL [0] ＣＡＮＣＥＬ
CALL INPUTINT(0,L_USEABLE:0, L_USEABLE:1)
;INPUTINTの時点で指定した値を選択した時にループが入るのでELSEは要らない
IF RESULT == 1
	CALL GET_SKILL_PROP, "SKILL_EXPLAIN", 3965, ARG
	CALL SELECT_SKILL_TARGET,3965,ARG
	SIF RESULT == -1
		GOTO INPUT_LOOP
	CFLAG:(ARG):타겟 = RESULT
	CFLAG:(ARG):입력행동 = 3965
	CALL SET_REPEAT_CHARA, ARG
	RETURN 1
ENDIF
IF RESULT == 2
	CALL GET_SKILL_PROP, "SKILL_EXPLAIN", 3966, ARG
	CALL SELECT_SKILL_TARGET,3966,ARG
	SIF RESULT == -1
		GOTO INPUT_LOOP
	CFLAG:(ARG):타겟 = RESULT
	CFLAG:(ARG):입력행동 = 3966
	CALL SET_REPEAT_CHARA, ARG
	RETURN 1
ENDIF
RETURN -1
