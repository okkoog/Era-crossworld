RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3968,ARG
RETURN 40

;　相性
@SKILL_TYPE_3968,ARG
SIF FLAG:공격횟수 == 1
	RETURN GET_TYPE_NUM("질풍")
RETURN GET_TYPE_NUM("주살")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3968
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

