;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3961, ARG, ARG:1, ARG:2
IF CFLAG:ARG:PT플래그 > 0
	IF GET_CHARA_STOCK_MAG((ARG)) < MAX(GET_CHARA_MAXMAG(ARG)/4,1)
		FLAG:촉수에너지 += (GET_CHARA_STOCK_MAG((ARG)))
		PRINTFORML %조사처리(CALLNAME:(ARG),"는")% 건넬 ＭＡＧ가 부족해 촉수에게 벌을 받았다！
		CFLAG:ARG:상태이상 = GET_STATE_NUM("HAPPY")
	ELSE
		FLAG:촉수에너지 += MAX(GET_CHARA_MAXMAG(ARG)/40,1)
		CALL ATTACK_FIELD,ARG,ARG:1,3961
		PRINTFORML %CALLNAME:ARG% >>>>> {MAX(GET_CHARA_MAXMAG(ARG)/4,1)} 소비 (나머지{GET_CHARA_STOCK_MAG(ARG)})
	ENDIF
	CALL CONTROL_MAG, ARG, -MAX(GET_CHARA_MAXMAG(ARG)/4,1)
ELSE
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3961, ARG
PRINTL 길러낸 촉수에게 대량의 MAG를 건네、적 전체에 전술 상성의 특대 데미지를 준다。
PRINTL 사용자의 MAG를 25% 소비하고、소비 MAG의 1할은 촉수에너지로 환원된다。촉수 레벨이 낮으면 성능을 발휘할 수 없다。
SIF ARG >= 0
	PRINTFORML %CALLNAME:ARG% 의 남은 MAG {GET_CHARA_STOCK_MAG(ARG)} 예상소비 {MAX(GET_CHARA_MAXMAG(ARG)/4,1) } 사용후 MAG {GET_CHARA_STOCK_MAG(ARG) - MAX(GET_CHARA_MAXMAG(ARG)/4,1)}



;使用条件
@SKILL_SPECIAL_ACTIONABLE_3961,ARG
RETURN 1
;とくにない