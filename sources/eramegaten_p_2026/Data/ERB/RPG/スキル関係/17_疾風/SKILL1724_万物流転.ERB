; 만물유전(マーガレット戦)

@SKILL_NAME_1724, ARG
RESULTS = 만물유전

;　명중
@SKILL_HITRATE_1724, ARG
RETURN 90

;　威力
@SKILL_POWER_1724, ARG
RETURN 500

;　최저공격횟수
@SKILL_MINATTACKNUMBER_1724, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1724, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1724, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1724, ARG
RETURN 28

;　相性
@SKILL_TYPE_1724, ARG
RETURN GET_TYPE_NUM("질풍")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1724
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;魔法
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_1724, ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1724, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_1724, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1724, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_1724, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_1724
RETURN GET_SUCCESSION_NUM("질풍")
;속도보정
@SKILL_SPEED_1724, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1724
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1724, ARG = -1
RETURN 12



