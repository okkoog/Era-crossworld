;達人あなた、とくにディーヴァ専用に作られたスキル。取扱注意

;スキル名
@SKILL_NAME_1737,ARG
RESULTS = 너의기억

;　명중
@SKILL_HITRATE_1737, ARG
RETURN 100

;　威力
@SKILL_POWER_1737, ARG
SIF ARG == -1
      RETURN 300
IF ABL:ARG:가창기능 == 0
      RETURN 300
ELSEIF ABL:ARG:가창기능 == 1
      RETURN 320
ELSEIF ABL:ARG:가창기능 == 2
      RETURN 340
ELSEIF ABL:ARG:가창기능 == 3
      RETURN 360
ELSEIF ABL:ARG:가창기능 == 4
      RETURN 380
ELSEIF ABL:ARG:가창기능 == 5
      RETURN 400
ELSEIF ABL:ARG:가창기능 == 6
      RETURN 420
ELSEIF ABL:ARG:가창기능 == 7
      RETURN 440
ELSEIF ABL:ARG:가창기능 == 8
      RETURN 460
ELSEIF ABL:ARG:가창기능 == 9
      RETURN 480
ELSE
      RETURN 500
ENDIF
      RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_1737,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1737,ARG
SIF ARG == -1
      RETURN 1
SIF FLAG:경험ED수 < 11
      RETURN 1
IF FLAG:경험ED수 == 11
      RETURN 1
ELSEIF FLAG:경험ED수 == 12
      RETURN 1
ELSEIF FLAG:경험ED수 == 13
      RETURN 1
ELSEIF FLAG:경험ED수 == 14
      RETURN 2
ELSEIF FLAG:경험ED수 == 15
      RETURN 2
ELSEIF FLAG:경험ED수 == 16
      RETURN 2
ELSEIF FLAG:경험ED수 == 17
      RETURN 3
ELSEIF FLAG:경험ED수 == 18
      RETURN 3
ELSEIF FLAG:경험ED수 == 19
      RETURN 3
ELSEIF FLAG:경험ED수 > 19
      RETURN 4
ENDIF
      RETURN 1
;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1737, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1737,ARG
RETURN 30

;　相性
@SKILL_TYPE_1737,ARG
RETURN GET_TYPE_NUM("질풍")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1737
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_1737, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1737, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_1737,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1737,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_1737, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_1737
RETURN GET_SUCCESSION_NUM("질풍")

;속도보정
@SKILL_SPEED_1737, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1737
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1737, ARG = -1
RETURN 22




;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_1737,ARG
A = RAND:11
IF A == 0
	RETURN GET_STATE_NUM("HAPPY")
ELSEIF A == 1
	RETURN GET_STATE_NUM("CHARM")
ELSEIF A == 2
	RETURN GET_STATE_NUM("PANIC")
ELSEIF A == 3
	RETURN GET_STATE_NUM("SLEEP")
ELSEIF A == 4
	RETURN GET_STATE_NUM("BIND")
ELSEIF A == 5
	RETURN GET_STATE_NUM("CLOSE")
ELSEIF A == 6
	RETURN GET_STATE_NUM("POISON")
ELSEIF A == 7
	RETURN GET_STATE_NUM("BOMB")
ELSEIF A == 8
	RETURN GET_STATE_NUM("PALYZE")
ELSEIF A == 9
	RETURN GET_STATE_NUM("SHOCK")
ELSE
	RETURN GET_STATE_NUM("FREEZE")
ENDIF
RETURN RAND:10 + 1

;추가효과상성
@SKILL_ADDTIONAL_TYPE_1737,ARG
IF A < 4
	RETURN GET_TYPE_NUM("정신")
ELSEIF A < 9
	RETURN GET_TYPE_NUM("신경")
ELSEIF A == 9
	RETURN GET_TYPE_NUM("전격")
ELSE
	RETURN GET_TYPE_NUM("빙결")
ENDIF
RETURN GET_TYPE_NUM("만능")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_1737,ARG
RETURN 90

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_1737,ARG
RETURN 95

