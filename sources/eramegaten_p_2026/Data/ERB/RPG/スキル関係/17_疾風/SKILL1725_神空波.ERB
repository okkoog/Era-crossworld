; 신공파(マーガレット戦)

@SKILL_NAME_1725, ARG
IF SKILL_CHANGE(ARG, [[キャラ:P1주인공]]) && ABL:GETCHARA([[キャラ:P1주인공]]):초기페르소나 == [[キャラ:진비슈누_페르소나]]
	RESULTS = 진공파
ELSE
	RESULTS = 신공파
ENDIF

;　명중
@SKILL_HITRATE_1725, ARG
RETURN 90

;　威力
@SKILL_POWER_1725, ARG
RETURN 480

;　최저공격횟수
@SKILL_MINATTACKNUMBER_1725, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1725, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1725, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1725, ARG
RETURN 45

;　相性
@SKILL_TYPE_1725, ARG
RETURN GET_TYPE_NUM("질풍")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1725
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;魔法
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_1725, ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1725, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_1725, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1725, ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_1725, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_1725
RETURN GET_SUCCESSION_NUM("질풍")
;속도보정
@SKILL_SPEED_1725, ARG = -1
RETURN 0

