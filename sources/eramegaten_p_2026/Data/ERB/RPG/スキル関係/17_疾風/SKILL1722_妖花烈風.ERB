;JOKER専用　ランダム状態異常つきガルダイン

;スキル名
@SKILL_NAME_1722,ARG
RESULTS = 요화열풍

;　명중
@SKILL_HITRATE_1722, ARG
RETURN 100

;　威力
@SKILL_POWER_1722, ARG
RETURN 324

;　최저공격횟수
@SKILL_MINATTACKNUMBER_1722,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1722,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1722, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1722,ARG
RETURN 15

;　相性
@SKILL_TYPE_1722,ARG
RETURN GET_TYPE_NUM("질풍")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1722
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_1722, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1722, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_1722,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1722,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_1722, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_1722
RETURN GET_SUCCESSION_NUM("질풍")
@継承不能_1722
RETURN 1
;질풍

;속도보정
@SKILL_SPEED_1722, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1722
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1722, ARG = -1
RETURN 10




;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_1722,ARG
RETURN RAND:10 + 1

;추가효과상성
@SKILL_ADDTIONAL_TYPE_1722,ARG
RETURN GET_TYPE_NUM("만능")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_1722,ARG
RETURN 60

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_1722,ARG
RETURN 95

