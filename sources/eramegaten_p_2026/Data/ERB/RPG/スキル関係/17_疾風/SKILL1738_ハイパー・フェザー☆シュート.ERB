;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_1738, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "ATK"
		;ノヴァサイザー式
		LOCAL = MIN(MAXBASE:ARG:속도, MAXBASE:ARG:마력)
		LOCAL = MAX(LOCAL, 1)
		LOCAL = LOCAL * 64 / (MAXBASE:ARG:속도 + MAXBASE:ARG:마력)
		RETURN CFLAG:ARG:마법위력강화 + LOCAL, 32
ENDSELECT
;====================================================
;スキル及び行動の実行
;====================================================
;ノヴァサイザー参考に速さをダメージに含める事で弓矢成分を入れる
@ACTION_1738, ARG, ARG:1, ARG:2
;0除算回避に+1をつける
;LOCAL = MIN(MAXBASE:ARG:속도, MAXBASE:ARG:마력)
;SIF LOCAL <= 0
;	LOCAL = 1
;LOCAL = LOCAL * 64 / (MAXBASE:ARG:속도+MAXBASE:ARG:마력)
;CFLAG:ARG:마법위력강화 += LOCAL
CALL ATTACK_SINGLE,ARG,POS(ARG:1),1738
