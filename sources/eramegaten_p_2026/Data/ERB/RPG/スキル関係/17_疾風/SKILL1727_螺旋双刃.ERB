;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_1727,ARG
RESULTS = 나선쌍인

;　명중
@SKILL_HITRATE_1727, ARG
RETURN 95

;　威力
@SKILL_POWER_1727, ARG
SIF FLAG:공격횟수 == 0
	RETURN 160
SIF FLAG:공격횟수 == 1
	RETURN 180

;　최저공격횟수
@SKILL_MINATTACKNUMBER_1727,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1727,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1727, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1727,ARG
RETURN 18

;　相性
@SKILL_TYPE_1727,ARG
RETURN GET_TYPE_NUM("질풍")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1727
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_1727, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1727, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_1727,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1727,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_1727, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_1727
RETURN GET_SUCCESSION_NUM("질풍")

@継承不能_1727
RETURN 1
;不可

;속도보정
@SKILL_SPEED_1727, ARG = -1
RETURN 10


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1727
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1727, ARG = -1
RETURN 0



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_1727, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,1727

