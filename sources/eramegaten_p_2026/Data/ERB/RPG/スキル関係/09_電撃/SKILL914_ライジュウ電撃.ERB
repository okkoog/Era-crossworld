@SKILL_HITRATE_914, ARG
RETURN 100

;　威力
@SKILL_POWER_914, ARG
RETURN 245

;　최저공격횟수
@SKILL_MINATTACKNUMBER_914,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_914,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_914, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_914,ARG
RETURN 9

;　相性
@SKILL_TYPE_914,ARG
RETURN GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_914
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_914, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_914, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_914,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_914,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_914, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_914
RETURN GET_SUCCESSION_NUM("전격")
@継承不能_914
RETURN 1
;不可

;속도보정
@SKILL_SPEED_914, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_914
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_914, ARG = -1
RETURN 0



