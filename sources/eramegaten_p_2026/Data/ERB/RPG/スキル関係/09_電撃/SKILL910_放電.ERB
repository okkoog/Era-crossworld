@SKILL_EFECT_910, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_910
RETURN GET_SUCCESSION_NUM("전격")

;속도보정
@SKILL_SPEED_910, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
