;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_910,ARG
IF SKILL_CHANGE(ARG, [[キャラ:미샤구지님]])
	RETURN GET_STATE_NUM("CHARM")
ELSE
	RETURN GET_STATE_NUM("SHOCK")
ENDIF

;추가효과상성
@SKILL_ADDTIONAL_TYPE_910,ARG
IF SKILL_CHANGE(ARG, [[キャラ:미샤구지님]])
	RETURN GET_TYPE_NUM("정신")
ELSE
	RETURN GET_TYPE_NUM("전격")
ENDIF

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_910,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_910,ARG
RETURN 95

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_910, ARG, ARG:1, ARG:2
CALL ATTACK_SKILL,ARG,ARG:1,ARG:2

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_910, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:미샤구지님]]
	PRINTL 적 전체에서 랜덤으로 １～５회 데미지＋매료。
	PRINTL 요염한 움직임과 함께 방출되는 미샤구지님의 필살 전격。
ELSE
	PRINTL 전격으로 적 전체에 랜덤으로 １～５회 데미지＋감전。
ENDIF

