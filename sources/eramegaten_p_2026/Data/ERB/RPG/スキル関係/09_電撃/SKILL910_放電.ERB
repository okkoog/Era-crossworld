;　コストの量
@SKILL_COST_910,ARG
RETURN 15

;　相性
@SKILL_TYPE_910,ARG
RETURN GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_910
