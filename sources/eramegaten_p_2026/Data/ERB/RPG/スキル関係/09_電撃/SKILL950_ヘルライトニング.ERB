;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_950, ARG
IF SKILL_CHANGE(ARG, [[キャラ:블레이드_X]])
	IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
		RESULTS = ｻﾝﾀﾞｰｻﾞﾝﾊﾞｰ・碧雷
	ELSE
		RESULTS = 선더 잔버
	ENDIF
ELSE
	RESULTS = 헬라이트닝
ENDIF

;　명중
@SKILL_HITRATE_950, ARG
RETURN 100

;　威力
@SKILL_POWER_950, ARG
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	SIF FLAG:확산플래그
		RETURN 175
	RETURN 235
ELSE
	SIF FLAG:확산플래그
		RETURN 85
	RETURN 190
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_950, ARG
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	RETURN 2
ELSE
	RETURN 1
ENDIF

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_950, ARG
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	RETURN 2
ELSE
	RETURN 1
ENDIF

