;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_941, ARG
;天堂真矢が使用する場合、ケラウノスに（悪魔変身前提）
IF SKILL_CHANGE(ARG, [[キャラ:마야_무대소녀]])
	RESULTS = 샘솟는 뇌정
ELSEIF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	RESULTS = ﾄｰﾙﾊﾝﾏｰ・碧雷
;それ以外
ELSE
	RESULTS = 토르해머
ENDIF

;　명중
@SKILL_HITRATE_941, ARG
RETURN 90

;　威力
@SKILL_POWER_941, ARG
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	RETURN 450
ELSE
	RETURN 320
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_941, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_941, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_941, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_941, ARG
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	RETURN 26
ELSE
	RETURN 17
ENDIF

;　相性
@SKILL_TYPE_941, ARG
RETURN GET_TYPE_NUM("전격")
;전격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_941
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_941, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_941, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_941, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_941, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_941, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_941
RETURN GET_SUCCESSION_NUM("전격")
;전격

;속도보정
@SKILL_SPEED_941, ARG = -1
