;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_941
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_941, ARG = -1
RETURN 9

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_941, ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_941, ARG
RETURN GET_TYPE_NUM("전격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_941, ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_941, ARG
RETURN 75

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_941, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE, ARG, LOCAL, 941

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_941, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:마야_무대소녀]]
	PRINTL 케라우노스에서 새어나온 번개가 사악한 것을 격멸한다。
	PRINTL 적 １체에 전격 상성의 물리공격으로 대 데미지＋감전。후열 사용 가능。
ELSE
	PRINTL 뇌신 토르의 망치와도 같은 일격。적 １체에 전격 상성의 물리공격으로 대 데미지＋감전。후열 사용 가능。
	IF ARG > 0 && ARG < CHARANUM && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
		SETCOLOR 0x14ffd7
		PRINTL 벽색의뇌정 장비중　위력강화
		RESETCOLOR
	ENDIF
ENDIF

;継承に必要な部位


