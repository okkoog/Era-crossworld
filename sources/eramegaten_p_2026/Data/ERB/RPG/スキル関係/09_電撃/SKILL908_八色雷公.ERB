;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_908, ARG = -1, ARG:1 = -1
;稲妻のレンズ装備中　気合状態で相性を貫通するようになる
SIF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정") && CFLAG:ARG:気合フラグ
	RETURN 4
;素質を持っていて気合状態の時、貫通になる。
SIF ARG < 0
	RETURN 0
SIF !相性素質チェック_F(ARG, GET_SUCCESSION_NUM("전격"))
	RETURN 0
SIF !CFLAG:ARG:気合フラグ
	RETURN 0
RETURN 4

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_908, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE, ARG, LOCAL, 908
;貫通が発生していたら気合フラグを消す
SIF STRFIND(TSTR:상성변동요인, "관통") >= 0
	CFLAG:ARG:気合フラグ = 0

;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_908, ARG
PRINTL 적 １체에 전격 상성의 초특대 데미지
IF ARG > 0 && ARG < CHARANUM && IS_CHARA_EQUIPED(ARG, "번개의렌즈")
	SETCOLOR 0x144ff4
	PRINTL 번개의렌즈 장비중　기합 상태에서 상성을 관통하게 된다
	RESETCOLOR
ELSE
	PRINTL 전격 소질에 더해 기합으로 모든 내성과 내성강화 효과를 관통하는 효과를 얻는다
ENDIF



;使用条件
@SKILL_SPECIAL_ACTIONABLE_908,ARG
RETURN 1
;とくにない

