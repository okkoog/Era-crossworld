;　コストの量
@SKILL_COST_330,ARG
RETURN 8

;　相性
@SKILL_TYPE_330,ARG
RETURN GET_TYPE_NUM("전술")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_330
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

