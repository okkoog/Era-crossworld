;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_308,ARG
RESULTS = 우두마두만력

;　명중
@SKILL_HITRATE_308, ARG
RETURN 90

;　威力
@SKILL_POWER_308, ARG
RETURN 145

;　최저공격횟수
@SKILL_MINATTACKNUMBER_308,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_308,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_308, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_308,ARG
RETURN 8

;　相性
@SKILL_TYPE_308,ARG
RETURN GET_TYPE_NUM("전술")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_308
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_308, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_308, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_308,ARG
RETURN 4

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_308,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_308, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_308
RETURN GET_SUCCESSION_NUM("전술")
@継承不能_308
RETURN 1
;不可

;속도보정
@SKILL_SPEED_308, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_308
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_308, ARG = -1
RETURN 0



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_308, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,308






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_308, ARG
PRINTL 투귀 고즈키・메즈키를 소환해 적 １체에 대 데미지。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_308,ARG
SIF TALENT:ARG:쿠즈노하
	RETURN 1
RETURN 0