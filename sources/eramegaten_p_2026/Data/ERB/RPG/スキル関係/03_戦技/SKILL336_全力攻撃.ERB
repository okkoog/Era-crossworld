;全力攻撃Ⅱ
;Ⅱまで再現するケレン味こそがShinEraTenseiではないかね？

;スキル名
@SKILL_NAME_336,ARG

IF SKILL_CHANGE(ARG, [[キャラ:사츠키]])
	RESULTS = 못다 이룬 꿈을 붙잡는 삿칭 암
ELSE
	RESULTS = 전력공격
ENDIF

;　명중
@SKILL_HITRATE_336, ARG
RETURN 60

;　威力
@SKILL_POWER_336, ARG
RETURN 420

;　최저공격횟수
@SKILL_MINATTACKNUMBER_336,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_336,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_336, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_336,ARG
RETURN 9

;　相性
@SKILL_TYPE_336,ARG
RETURN GET_TYPE_NUM("전술")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_336
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_336, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_336, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_336,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_336,ARG
RETURN GET_SPHERE_NUM("단체")
	
;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_336, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_336
RETURN GET_SUCCESSION_NUM("전술")

;속도보정
@SKILL_SPEED_336, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_336
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_336, ARG = -1
RETURN 11






;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_336, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,336





;====================================================
;実行内容ここまで
