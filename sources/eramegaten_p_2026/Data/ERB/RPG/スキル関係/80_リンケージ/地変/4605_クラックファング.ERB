

;スキル名
@SKILL_NAME_4605,ARG
RESULTS = 크랙팡
;　명중
@SKILL_HITRATE_4605, ARG
RETURN 100

;　威力
@SKILL_POWER_4605, ARG
SIF ARG == -1 || CFLAG:ARG:단독링케이지
	RETURN 345
;発動者と参加者の魔法威力の比率により、威力に補正がかかる
RETURN 345 * (MAXBASE:ARG:마법위력 * 2 + MAXBASE:(CFLAG:ARG:링케이지참가자1):마법위력 + MAXBASE:(CFLAG:ARG:링케이지참가자2):마법위력) / (MAXBASE:ARG:마법위력 * 4)
;　최저공격횟수
@SKILL_MINATTACKNUMBER_4605,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_4605,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_4605, ARG, ARG:1
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_4605, ARG
RETURN 10

;　相性
@SKILL_TYPE_4605,ARG
RETURN GET_TYPE_NUM("지변")
;　1EXTRAか2MAGICか

@SKILL_DECIDE_TYPE_4605
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_4605, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_4605, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_4605,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_4605,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_4605, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_4605
RETURN GET_SUCCESSION_NUM("계통없음")

;속도보정
@SKILL_SPEED_4605, ARG = -1
RETURN 20

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_4605
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_4605, ARG = -1
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4605, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD, ARG, ARG:1, 4605






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_4605, ARG
PRINTL 땅의 균열로 적 전체를 집어삼켜、대 데미지를 준다



;使用条件
@SKILL_SPECIAL_ACTIONABLE_4605,ARG
CALL CHECK_COST,ARG,4605
SIF RESULT == 0
	RETURN 0
RETURN 1
;とくにない


;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4605
RETURN 1

@参加人数_4605
RETURN 2

@参加条件表示_4605,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 지변계 마법
	CASE 2
		PRINTFORM 화염계 마법
	CASE 3
		PRINTFORM 마하・마그나스
ENDSELECT

@発動者条件_4605 , ARG
;マハ・マグナスを使えること
SIF HAVE_SKILL(ARG, [[스킬:마하・마그나스]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:마하・마그나스]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4605, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4605, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;地変相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "지변", , "공격", "魔法", 4605)
		RETURN RESULT
	CASE 2
		;火炎相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "화염", , "공격", "魔法", 4605)
		RETURN RESULT
ENDSELECT

@リンケージコストタイプ_4605, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
	CASE 2
		RETURN 3
ENDSELECT
@リンケージコスト_4605, ARG
SELECTCASE ARG
	CASE 1
		RETURN 7
	CASE 2
		RETURN 7
ENDSELECT
