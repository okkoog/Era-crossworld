@発動者条件_4600 , ARG
;地変相性の攻撃魔法スキルを使用可能なこと
CALL HAVE_SKILL_SEARCH(ARG, "지변", , "공격", "魔法")
RETURN RESULT


@参加者条件_4600, ARG , ARG:1
#LOCALSIZE 2
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4600, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;水撃相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "수격", , "공격", "魔法", 4600)
		RETURN RESULT
	CASE 2
		;火炎相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "화염", , "공격", "魔法", 4600)
		RETURN RESULT
ENDSELECT
@リンケージコストタイプ_4600, ARG
