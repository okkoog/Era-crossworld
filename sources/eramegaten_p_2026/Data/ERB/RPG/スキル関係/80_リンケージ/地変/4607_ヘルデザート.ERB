;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4607
RETURN 1

@参加人数_4607
RETURN 2

@参加条件表示_4607,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 지변계 마법
	CASE 2
		PRINTFORM 만능계 마법
	CASE 3
		PRINTFORM 대지의분노
ENDSELECT

@発動者条件_4607 , ARG
;大地の怒りを使えること
SIF HAVE_SKILL(ARG, [[스킬:대지의분노]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:대지의분노]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4607, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4607, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;地変相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "지변", , "공격", "魔法", 4607)
		RETURN RESULT
	CASE 2
		;万能相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "만능", , "공격", "魔法", 4607)
		RETURN RESULT
ENDSELECT

@リンケージコストタイプ_4607, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
	CASE 2
		RETURN 3
ENDSELECT
@リンケージコスト_4607, ARG
SELECTCASE ARG
	CASE 1
		RETURN 18
	CASE 2
		RETURN 18
ENDSELECT
