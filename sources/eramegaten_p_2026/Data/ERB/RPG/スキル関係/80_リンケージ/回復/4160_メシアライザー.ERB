;出てきてから終盤必須になってるこれですが、通常魔法として実装されてないし、リンケージとして実装
;メディアラハンと比べて消費でかくていまいちかなぁと思ったけど
;よく考えたら、主人公の行動消費とはいえ、スキル枠消費せずに、継承関係なく使わせられるんだから、まぁこのくらいはコスト払うべきという気分に
;高MP持ちで使うのもいいけど、MPあましがちな壁・物理系で使うのも美味しいかもしれない

;スキル名
@SKILL_NAME_4160,ARG
RESULTS = 메시아라이저

;　명중
@SKILL_HITRATE_4160, ARG
RETURN 100

;　威力
@SKILL_POWER_4160, ARG
RETURN 1000

;　최저공격횟수
@SKILL_MINATTACKNUMBER_4160,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_4160,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_4160, ARG, ARG:1
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_4160, ARG
RETURN 70


@SKILL_DECIDE_TYPE_4160
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_4160, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

@SKILL_HEAL_TYPE_4160, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("割合")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_4160, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_4160,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_4160,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_4160, ARG
RETURN GET_SKILL_EFFECT_NUM("회복")


;계승타입
@SKILL_SUCCESSION_TYPE_4160
RETURN GET_SUCCESSION_NUM("계통없음")

;속도보정
@SKILL_SPEED_4160, ARG = -1
RETURN 20

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_4160
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_4160, ARG = -1
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4160, ARG, ARG:1, ARG:2
CALL HEAL_FIELD, ARG, ARG:1, 430

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_4160, ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT
;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_4160, ARG
PRINTL 아군 전체의 HP회복을 행한다。사망 이외의 상태이상도 회복한다



;使用条件
@SKILL_SPECIAL_ACTIONABLE_4160,ARG
CALL CHECK_COST,ARG,4160
SIF RESULT == 0
	RETURN 0
RETURN 1
;とくにない


;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4160
RETURN 1

@参加人数_4160
RETURN 1

@参加条件表示_4160,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM %CALLNAME:MASTER%
	CASE 2
		PRINTFORM 【아내】or 【남편】
ENDSELECT

@発動者条件_4160 , ARG
;アギを使えること
SIF TALENT:ARG:아내 || TALENT:ARG:남편
	RETURN 1
RETURN 0


@参加者条件_4160, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4160, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		SIF ARG == MASTER
			RETURN 1
		RETURN 0
ENDSELECT

@リンケージコストタイプ_4160, ARG
SELECTCASE ARG
	CASE 1
		RETURN 2
ENDSELECT
@リンケージコスト_4160, ARG
SELECTCASE ARG
	CASE 1
		RETURN 0
ENDSELECT
