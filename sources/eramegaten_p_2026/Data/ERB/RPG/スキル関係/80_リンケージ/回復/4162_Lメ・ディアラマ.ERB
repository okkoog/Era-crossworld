@参加条件表示_4162,ARG
SELECTCASE ARG
	CASE 1, 2
		PRINTFORM 디아라마・디아라한
ENDSELECT

@発動者条件_4162 , ARG
IF CHECK_SKILL(ARG, [[스킬:디아라마]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:디아라마]]
	SIF RESULT
		RETURN 1
ENDIF
IF CHECK_SKILL(ARG, [[스킬:디아라한]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:디아라한]]
	SIF RESULT
		RETURN 1
ENDIF
RETURN 0


@参加者条件_4162, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4162, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1, 2
		IF CHECK_SKILL(ARG, [[스킬:디아라마]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:디아라마]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF CHECK_SKILL(ARG, [[스킬:디아라한]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:디아라한]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

