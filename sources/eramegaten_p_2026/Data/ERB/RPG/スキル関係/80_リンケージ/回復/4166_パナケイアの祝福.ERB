@参加人数_4166
RETURN 2

@参加条件表示_4166,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 리캄
	CASE 2
		PRINTFORM 디아
	CASE 3
		PRINTFORM 파트라
ENDSELECT

@発動者条件_4166 , ARG
IF CHECK_SKILL(ARG, [[스킬:파트라]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:파트라]]
	SIF RESULT
		RETURN 1
ENDIF
RETURN 0


@参加者条件_4166, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4166, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		IF CHECK_SKILL(ARG, [[스킬:리캄]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:리캄]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
	CASE 2
		IF CHECK_SKILL(ARG, [[스킬:디아]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:디아]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

