@発動者条件_4163 , ARG
;ディアラハンを使えること
SIF HAVE_SKILL(ARG, [[스킬:디아라한]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:디아라한]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4163, ARG , ARG:1
