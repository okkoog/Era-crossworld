	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4163, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1, 2
		;ディアラハンを使えること
		IF HAVE_SKILL(ARG, [[스킬:디아라한]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:디아라한]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

