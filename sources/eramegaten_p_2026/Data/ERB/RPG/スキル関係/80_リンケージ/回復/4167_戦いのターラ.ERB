;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4167, ARG, ARG:1, ARG:2
#DIM L_T
#DIM LCOUNT, 2
#DIMS L_ENHANCE
#DIMS L_ENHANCE_TABLE, 5
#DIM CURE_POWER
#DIM ENHANCE_POWER
#DIM ENHANCE_NUM
#DIMS L_MES
L_ENHANCE = "공격/방어/마법위력/마법효과/명중률_회피률
SPLIT L_ENHANCE, "/", L_ENHANCE_TABLE

IF CFLAG:ARG:PT플래그
	CURE_POWER = ABL:ARG:가창기능 + ABL:(CFLAG:ARG:링케이지참가자1):가창기능 + ((EXP:ARG:라이브경험 + EXP:(CFLAG:ARG:링케이지참가자1):라이브경험) / 100)
	ENHANCE_POWER = 1 + RAND:MAX(ABL:ARG:노출증 + ABL:(CFLAG:ARG:링케이지참가자1):노출증, 1) + ((EXP:ARG:라이브경험 + EXP:(CFLAG:ARG:링케이지참가자1):라이브경험) / 50)
ELSE
	CURE_POWER = 24
	ENHANCE_POWER = 16
ENDIF
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	SELECTCASE RAND:ENHANCE_POWER
		CASE IS > 8
			ENHANCE_NUM = 5
		CASE IS > 6
			ENHANCE_NUM = 4
		CASE IS > 4
			ENHANCE_NUM = 3
		CASEELSE
			ENHANCE_NUM = 2
	ENDSELECT
	FOR LCOUNT:1, 0, 5
		SWAP L_ENHANCE_TABLE:(LCOUNT:1), L_ENHANCE_TABLE:(RAND:5)
	NEXT
	L_ENHANCE = 
	FOR LCOUNT:1, 0, ENHANCE_NUM
		L_ENHANCE += L_ENHANCE_TABLE:(LCOUNT:1)
	NEXT
	TSTR:스킬메시지추가효과 = 
	CALL SKILL_SET_カジャンダ, ARG, L_T, L_ENHANCE, 4, "短縮"
	L_MES '= SUBSTRING(TSTR:스킬메시지추가효과, 3, -1)
	IF CURE_POWER > RAND:24
		CALL CURE_STATE_SINGLE,ARG, L_T, 4166, 0, 1, 1
		SIF RESULT
			L_MES += " & " + RESULTS
	ENDIF
	CALL PRINT_HIT_MESSAGE, L_T, L_MES, "L"
NEXT
WAIT

