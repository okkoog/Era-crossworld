	CALL CHECK_ACTIONABLE , ARG , [[스킬:하마온]]
	SIF RESULT
		RETURN 1
ENDIF
IF CHECK_SKILL(ARG, [[스킬:마한마온]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:마한마온]]
	SIF RESULT
		RETURN 1
ENDIF
RETURN 0


