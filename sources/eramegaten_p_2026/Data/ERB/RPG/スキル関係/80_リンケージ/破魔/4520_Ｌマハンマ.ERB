;=====================================================
@LINKAGE_4520
RETURN 1

@参加人数_4520
RETURN 1

@参加条件表示_4520,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 상태이상 회복마법
	CASE 2
		PRINTFORM 하마계 마법
ENDSELECT

@発動者条件_4520, ARG
FOR LOCAL, 1 , FLAG:스킬수+1
	SIF ABL:ARG:("스킬" + TOSTR(LOCAL)) == 0
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_DECIDE_TYPE", ABL:ARG:("스킬" + TOSTR(LOCAL)), ARG
	SIF RESULT != 2
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_TYPE", ABL:ARG:("스킬" + TOSTR(LOCAL)) , ARG
	SIF RESULT != GET_TYPE_NUM("파마")
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_EFECT", ABL:ARG:("스킬" + TOSTR(LOCAL)), ARG
	SIF RESULT != 3
		CONTINUE
	CALL CHECK_ACTIONABLE , ARG , ABL:ARG:("스킬" + TOSTR(LOCAL))
	SIF RESULT == 0
		CONTINUE
	RETURN 1
NEXT
RETURN 0

@参加者条件_4520, ARG , ARG:1
#LOCALSIZE 2
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4520, ARG:1
SIF RESULT == 0
	RETURN 0
;状態回復魔法スキルを使用可能なこと
CALL HAVE_SKILL_SEARCH(ARG, , , "상태회복", "魔法")
RETURN RESULT

