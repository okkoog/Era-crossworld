	CASE 1
		PRINTFORM 메・디아라한
	CASE 2
		PRINTFORM 마한마온
ENDSELECT

@発動者条件_4523 , ARG
IF CHECK_SKILL(ARG, [[스킬:마한마온]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:마한마온]]
	SIF RESULT
		RETURN 1
ENDIF
RETURN 0


@参加者条件_4523, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4523, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		IF CHECK_SKILL(ARG, [[스킬:메・디아라한]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:메・디아라한]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

