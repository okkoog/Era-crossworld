@参加条件表示_4001,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 주살계 마법
	CASE 2
		PRINTFORM 검격계 １체 물리
ENDSELECT

@発動者条件_4001 , ARG
;剣撃相性の単体物理攻撃スキルを使用可能なこと
CALL HAVE_SKILL_SEARCH(ARG, "검격", "단체", "공격", "物理")
RETURN RESULT


@参加者条件_4001, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4001, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;呪殺相性の魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "주살", , , "魔法", 4001)
		RETURN RESULT
ENDSELECT
