@LINKAGE_4002
RETURN 1

@参加人数_4002
RETURN 1

@参加条件表示_4002, ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 화염계 마법
	CASE 2
		PRINTFORM 검격계 범위 물리
ENDSELECT

@発動者条件_4002 , ARG
;剣撃相性の範囲物理攻撃スキルを使用可能なこと
CALL HAVE_SKILL_SEARCH(ARG, "검격", "範囲", "공격", "物理")
RETURN RESULT


@参加者条件_4002, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4002, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;火炎相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "화염", , "공격", "魔法", 4002)
		RETURN RESULT
ENDSELECT
@リンケージ能力参照者_4002, ARG
