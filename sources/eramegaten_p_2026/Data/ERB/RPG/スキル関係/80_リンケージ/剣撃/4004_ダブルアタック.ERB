;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4004, ARG, ARG:1, ARG:2
#DIM LCOUNT
LOCAL = POS(ARG:1)
LOCAL:1 = CFLAG:ARG:링케이지참가자1
CALL ATTACK_SINGLE,ARG,LOCAL,4004,0
;対象がまだ居るand死んでいない
IF POS(ARG:1) >= 0 && GET_STATE(CFLAG:POS(ARG:1):상태이상) != "DYING"
	CALL ATTACK_SINGLE,LOCAL:1,LOCAL,4004,0
;居ないならランダムターゲット
ELSE
	CALL RANDOM_TARGET, LOCAL:1, 4004
	;対象にとれる敵がいない
	SIF !RESULT
		RETURN 0
	SIF POS(CFLAG:(LOCAL:1):타겟) > 0
		CALL ATTACK_SINGLE,LOCAL:1,POS(CFLAG:(LOCAL:1):타겟),4004,0
ENDIF



