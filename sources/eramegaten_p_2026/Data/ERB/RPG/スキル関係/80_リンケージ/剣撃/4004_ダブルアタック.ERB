@LINKAGE_4004
RETURN 1

@参加人数_4004
RETURN 1

@参加条件表示_4004,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM %CALLNAME:MASTER%
	CASE 2
		PRINTFORM 【맹우】
ENDSELECT

@発動者条件_4004 , ARG
;アギを使えること
SIF TALENT:ARG:맹우
	RETURN 1
RETURN 0


@参加者条件_4004, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4004, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		SIF ARG == MASTER
			RETURN 1
		RETURN 0
ENDSELECT

