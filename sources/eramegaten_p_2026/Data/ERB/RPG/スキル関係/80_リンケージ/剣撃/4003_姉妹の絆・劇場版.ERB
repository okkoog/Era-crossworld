;リンケージ設定
;=====================================================
@LINKAGE_4003
RETURN 1

@参加人数_4003
RETURN 1

@参加条件表示_4003,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 암흑히스이권
	CASE 2
		PRINTFORM 발도오의・하정추성
ENDSELECT

@発動者条件_4003 , ARG
;발도오의・하정추성
SIF HAVE_SKILL(ARG, [[스킬:발도오의・하정추성]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:발도오의・하정추성]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4003, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4003, ARG:1
SIF RESULT == 0
	RETURN 0
;암흑히스이권
SIF HAVE_SKILL(ARG, [[스킬:암흑히스이권]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:암흑히스이권]]
SIF RESULT
	RETURN 1
RETURN 0

