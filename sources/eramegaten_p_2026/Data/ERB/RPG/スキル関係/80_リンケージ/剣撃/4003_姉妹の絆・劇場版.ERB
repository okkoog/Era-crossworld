

;スキル名
@SKILL_NAME_4003,ARG
RESULTS = 자매의정・극장판
;　명중
@SKILL_HITRATE_4003, ARG
RETURN 120

;　威力
@SKILL_POWER_4003, ARG
SIF ARG == -1 || CFLAG:ARG:단독링케이지
	RETURN 70
SIF FLAG:공격횟수 == 7
	RETURN 140 * (MAXBASE:ARG:공격 + MAXBASE:(CFLAG:ARG:링케이지참가자1):공격) / (MAXBASE:ARG:공격 * 2)
RETURN 70

;　최저공격횟수
@SKILL_MINATTACKNUMBER_4003,ARG
RETURN 6

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_4003,ARG
RETURN 8

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_4003, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_4003, ARG, ARG:1
	RETURN 20
;　相性
@SKILL_TYPE_4003,ARG
SIF FLAG:공격횟수 == 1
	RETURN GET_TYPE_NUM("타격")
SIF FLAG:공격횟수 == 3
	RETURN GET_TYPE_NUM("타격")
SIF FLAG:공격횟수 == 5
	RETURN GET_TYPE_NUM("타격")
SIF FLAG:공격횟수 == 7
	RETURN GET_TYPE_NUM("타격")
RETURN GET_TYPE_NUM("검격")

;高クリティカル
@SKILL_CRITICAL_RATE_4003, ARG
RETURN 10

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_4003
