;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4647
RETURN 1

@参加人数_4647
RETURN 2

@参加条件表示_4647,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 수격계 마법
	CASE 2
		PRINTFORM 만능계 마법
	CASE 3
		PRINTFORM 아쿠아리타이드
ENDSELECT

@発動者条件_4647 , ARG
;アクアリータイドを使えること
SIF HAVE_SKILL(ARG, [[스킬:아쿠아리타이드]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:아쿠아리타이드]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4647, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4647, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;水撃相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "수격", , "공격", "魔法", 4647)
		RETURN RESULT
	CASE 2
		;万能相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "만능", , "공격", "魔法", 4647)
		RETURN RESULT
ENDSELECT

