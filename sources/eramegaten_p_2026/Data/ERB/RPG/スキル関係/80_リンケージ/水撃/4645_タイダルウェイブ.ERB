RETURN 1
;とくにない


;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4645
RETURN 1

@参加人数_4645
RETURN 2

@参加条件表示_4645,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 수격계 마법
	CASE 2
		PRINTFORM 질풍계 마법
	CASE 3
		PRINTFORM 마하・아쿠에스
ENDSELECT

@発動者条件_4645 , ARG
;マハ・アクエスを使えること
SIF HAVE_SKILL(ARG, [[스킬:마하・아쿠에스]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:마하・아쿠에스]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4645, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4645, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;水撃相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "수격", , "공격", "魔法", 4645)
		RETURN RESULT
	CASE 2
		;疾風相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "질풍", , "공격", "魔法", 4645)
		RETURN RESULT
ENDSELECT

@リンケージコストタイプ_4645, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
	CASE 2
		RETURN 3
ENDSELECT
@リンケージコスト_4645, ARG
SELECTCASE ARG
	CASE 1
		RETURN 7
	CASE 2
		RETURN 7
ENDSELECT
