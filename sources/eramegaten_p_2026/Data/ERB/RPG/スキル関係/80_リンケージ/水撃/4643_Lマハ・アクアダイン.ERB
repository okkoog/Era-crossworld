;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4643
RETURN 1

@参加人数_4643
RETURN 1

@参加条件表示_4643,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 그라다인
	CASE 2
		PRINTFORM 아쿠아다인
ENDSELECT

@発動者条件_4643 , ARG
;アクアダインを使えること
SIF HAVE_SKILL(ARG, [[스킬:아쿠아다인]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:아쿠아다인]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4643, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4643, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;グラダインを使えること
		IF HAVE_SKILL(ARG, [[스킬:그라다인]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:그라다인]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

@リンケージコストタイプ_4643, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
ENDSELECT
@リンケージコスト_4643, ARG
SELECTCASE ARG
	CASE 1
		RETURN 12
ENDSELECT
