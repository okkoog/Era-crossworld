@発動者条件_4640 , ARG
;水撃相性の攻撃魔法スキルを使用可能なこと
CALL HAVE_SKILL_SEARCH(ARG, "수격", , "공격", "魔法")
RETURN RESULT


@参加者条件_4640, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4640, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;地変相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "지변", , "공격", "魔法", 4640)
		RETURN RESULT
	CASE 2
		;疾風相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "질풍", , "공격", "魔法", 4640)
		RETURN RESULT
ENDSELECT
@リンケージコストタイプ_4640, ARG
