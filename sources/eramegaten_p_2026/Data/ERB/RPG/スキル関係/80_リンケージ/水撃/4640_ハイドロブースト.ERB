

;スキル名
@SKILL_NAME_4640,ARG
RESULTS = 하이드로부스트

;　명중
@SKILL_HITRATE_4640, ARG
RETURN 100

;　威力
@SKILL_POWER_4640, ARG
#LOCALSIZE 1
;一人リンケージでだした場合は130
IF ARG == -1 || CFLAG:ARG:단독링케이지
	RETURN 400
ELSE
	;威力が参加者の能力によって変化する
	;増量する値は参加者二人の魔力＋지혜/2の合計で200が限度
	;アギダイン100だし、序盤からアギダイン相当は届くはず
	;とりあえずキャップいるかどうか悩むけど240
	;基礎威力80
	LOCAL = 300
	;参加者1
	LOCAL += MAXBASE:(CFLAG:ARG:링케이지참가자1):마력*3/2
	LOCAL += MAXBASE:(CFLAG:ARG:링케이지참가자1):지혜
	;参加者2
	LOCAL += MAXBASE:(CFLAG:ARG:링케이지참가자2):마력*3/2
	LOCAL += MAXBASE:(CFLAG:ARG:링케이지참가자2):지혜
	SIF LOCAL > 650
		LOCAL = 650
	RETURN LOCAL
ENDIF

