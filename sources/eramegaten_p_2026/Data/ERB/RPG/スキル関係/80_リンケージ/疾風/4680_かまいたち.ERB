	CASE 2
		RETURN 3
ENDSELECT
@リンケージコスト_4680, ARG
SELECTCASE ARG
	CASE 1
		RETURN BASE:MASTER:LV / 5 + 2
	CASE 2
		RETURN BASE:MASTER:LV / 5 + 2
ENDSELECT
