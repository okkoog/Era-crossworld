@参加条件表示_4680,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 화염계 마법
	CASE 2
		PRINTFORM 수격계 마법
	CASE 3
		PRINTFORM 질풍계 마법
ENDSELECT

@発動者条件_4680 , ARG
;疾風相性の攻撃魔法スキルを使用可能なこと
CALL HAVE_SKILL_SEARCH(ARG, "질풍", , "공격", "魔法")
RETURN RESULT


@参加者条件_4680, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4680, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;火炎相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "화염", , "공격", "魔法", 4680)
		RETURN RESULT
	CASE 2
		;水撃相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "수격", , "공격", "魔法", 4680)
		RETURN RESULT
ENDSELECT
@リンケージコストタイプ_4680, ARG
