@参加条件表示_4683,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 부흐다인
	CASE 2
		PRINTFORM 갈다인
ENDSELECT

@発動者条件_4683 , ARG
;ガルダインを使えること
SIF HAVE_SKILL(ARG, [[스킬:갈다인]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:갈다인]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4683, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4683, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;ブフダインを使えること
		IF HAVE_SKILL(ARG, [[스킬:부흐다인]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:부흐다인]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

