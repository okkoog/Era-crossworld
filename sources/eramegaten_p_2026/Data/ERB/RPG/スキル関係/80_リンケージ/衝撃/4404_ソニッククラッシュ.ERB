@ACTION_4404, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD, ARG, ARG:1, 4404






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_4404, ARG
PRINTL 초음속의 충격파로、적 전체를 날려버려、대 데미지를 준다



;使用条件
@SKILL_SPECIAL_ACTIONABLE_4404,ARG
CALL CHECK_COST,ARG,4404
SIF RESULT == 0
	RETURN 0
RETURN 1
;とくにない


;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4404
RETURN 1

@参加人数_4404
RETURN 2

@参加条件表示_4404,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 충격계 마법
	CASE 2
		PRINTFORM 중력계 마법
	CASE 3
		PRINTFORM 마하・잔마
ENDSELECT

@発動者条件_4404 , ARG
;マハ・ザンマを使えること
SIF HAVE_SKILL(ARG, [[스킬:마하・잔마]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:마하・잔마]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4404, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4404, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;衝撃相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "충격", , "공격", "魔法", 4404)
		RETURN RESULT
	CASE 2
		;重力相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "중력", , "공격", "魔法", 4404)
		RETURN RESULT
ENDSELECT

@リンケージコストタイプ_4404, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
	CASE 2
		RETURN 3
ENDSELECT
@リンケージコスト_4404, ARG
SELECTCASE ARG
	CASE 1
		RETURN 7
	CASE 2
		RETURN 7
ENDSELECT
