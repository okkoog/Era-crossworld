RETURN RESULT


@参加者条件_4407, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4407, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;衝撃相性の攻撃スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH2(ARG, "충격", "단체", "공격", , , 450, 4407)
		RETURN RESULT
ENDSELECT
