@参加条件表示_4854,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 천년의저주、마하에이하、에이가온、또는 메기도라온 중、하나
	CASE 2
		PRINTFORM 저주의탄환 * 4
ENDSELECT

@発動者条件_4854 , ARG
SIF EQUIP:ARG:총 == 0
	RETURN 0
SIF ITEM:5504 < 4
	RETURN 0
SIF !GET_BTL_TALENT_LV("건슬링거",  ARG)
	RETURN 0
TRYCALLFORM 特殊弾倉_{EQUIP:ARG:총},ARG
FOR LOCAL, 1, RESULT + 1
	LOCALS = 특수탄{LOCAL}
	SIF EQUIP:ARG:LOCALS == 5504
		RETURN 1
NEXT
RETURN 0


@参加者条件_4854, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4854, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;千年の呪怨を使えること
		IF HAVE_SKILL(ARG, [[스킬:천년의저주]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:천년의저주]]
			SIF RESULT
				RETURN 1
		ENDIF
		;マハエイハを使えること
		IF HAVE_SKILL(ARG, [[스킬:마하에이하]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마하에이하]]
			SIF RESULT
				RETURN 1
		ENDIF
		;エイガオンを使えること
		IF HAVE_SKILL(ARG, [[스킬:에이가온]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:에이가온]]
			SIF RESULT
				RETURN 1
		ENDIF
		;メギドラオンを使えること
		IF HAVE_SKILL(ARG, [[스킬:메기도라온]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:메기도라온]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

