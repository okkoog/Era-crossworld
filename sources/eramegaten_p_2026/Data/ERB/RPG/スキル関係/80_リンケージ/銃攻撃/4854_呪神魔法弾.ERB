;スキル及び行動の実行
;====================================================
@ACTION_4854, ARG, ARG:1, ARG:2
CALL GET_SKILL_PROP, "SKILL_SPHERE", 4854, ARG
IF RESULT == 1
	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,4854
ELSE
	RESULT = 0
	TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총}
	IF RESULT == 1
		CALL ATTACK_RAND,ARG,ARG:1,4854
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,4854
	ENDIF
	
ENDIF
