;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4855, ARG, ARG:1, ARG:2
#DIM L_CHARA,2
#DIM L_DAMAGE,2
#DIM L_POWER,2
#DIM L_COUNT
#LOCALSIZE 3

L_CHARA = ARG, CFLAG:ARG:링케이지참가자1
FOR L_COUNT,0,2
	LOCAL = L_CHARA:L_COUNT
	CALL BTL_CALC_BASE_DAMAGE(LOCAL, POS(ARG:1), 100, GET_ダメージタイプ_NUM("物理"), GET_攻撃タイプ_NUM("총"))
	L_DAMAGE:L_COUNT = RESULT
	L_POWER:L_COUNT = 100 * L_DAMAGE:L_COUNT / L_DAMAGE:0
	
	CALLFORM 最低攻撃回数_{EQUIP:LOCAL:총},LOCAL
	LOCAL:1 = RESULT
	CALLFORM 最大攻撃回数_{EQUIP:LOCAL:총},LOCAL
	LOCAL:2 = RESULT
	L_POWER:L_COUNT = L_POWER:L_COUNT * MAX(LOCAL:1 + LOCAL:2,2) / 2
	
	RESULT = 0
;	TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:LOCAL:총},LOCAL
	TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:LOCAL:총}
	IF RESULT == 0
		CALLFORM 攻撃範囲_{EQUIP:LOCAL:총},LOCAL
		IF RESULT > 2
			TIMES L_POWER:L_COUNT , 1.50
		ELSEIF RESULT == 2
			TIMES L_POWER:L_COUNT , 1.25
		ENDIF
	ENDIF
NEXT

FLAG:확산플래그 = (L_POWER:0 + L_POWER:1) * 115 / 100

CALL ATTACK_SINGLE,ARG,POS(ARG:1),4855

FLAG:확산플래그 = 0

