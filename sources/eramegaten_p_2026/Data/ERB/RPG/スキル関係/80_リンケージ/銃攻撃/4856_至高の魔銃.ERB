;デビサバ2の自動効果スキルをリンケージとして実装
;原作っぽく、万能属性で通常攻撃なスキルに変更

;スキル名
@SKILL_NAME_4856,ARG
RESULTS = 지고의마총

;　명중
@SKILL_HITRATE_4856, ARG
RETURN 120

;　威力
@SKILL_POWER_4856, ARG
RETURN 100

;　최저공격횟수
@SKILL_MINATTACKNUMBER_4856,ARG
SIF ARG < 0
	RETURN 0
CALLFORM 最低攻撃回数_{EQUIP:ARG:총},ARG
RETURN RESULT

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_4856,ARG
SIF ARG < 0
	RETURN 0
CALLFORM 最大攻撃回数_{EQUIP:ARG:총},ARG
RETURN RESULT

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_4856, ARG, ARG:1
RETURN GET_SKILL_COST_TYPE_NUM("HP")
;消費なし＝1

;　コストの量
@SKILL_COST_4856, ARG
RETURN 4

;　相性
@SKILL_TYPE_4856,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_4856
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_4856, ARG
RETURN GET_ダメージタイプ_NUM("物理")
@SKILL_ATTACKTYPE_4856, ARG
RETURN GET_攻撃タイプ_NUM("총")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_4856, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_4856,ARG
SIF ARG < 0
	RETURN 0
CALLFORM 射程_{EQUIP:ARG:총},ARG
RETURN RESULT

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_4856,ARG
SIF ARG < 0
	RETURN 0
CALLFORM 攻撃範囲_{EQUIP:ARG:총},ARG
RETURN RESULT

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_4856, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_4856
RETURN GET_SUCCESSION_NUM("계통없음")

;속도보정
@SKILL_SPEED_4856, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_4856
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_4856, ARG = -1
RETURN 0


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_4856,ARG
RETURN 0

;추가효과상성
@SKILL_ADDTIONAL_TYPE_4856,ARG
RETURN 0

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_4856,ARG
SIF ARG < 0
	RETURN 0
RETURN 0

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_4856,ARG
SIF ARG < 0
	RETURN 0
RETURN 0
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4856, ARG, ARG:1, ARG:2
CALL GET_SKILL_PROP, "SKILL_SPHERE", 4856, ARG
IF RESULT == 1
	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,4856
ELSE
	RESULT = 0
	TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총}
	IF RESULT == 1
		CALL ATTACK_RAND,ARG,ARG:1,4856
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,4856
	ENDIF
	
ENDIF






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_4856, ARG
PRINTL 온갖 방호를 꿰뚫는 힘을 얻은 총으로、적을 쏜다。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_4856,ARG
CALL CHECK_COST,ARG,4856
SIF RESULT == 0
	RETURN 0
RETURN 1
;とくにない


;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4856
RETURN 1

@参加人数_4856
RETURN 1

@参加条件表示_4856,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 메기도계 마법 ３종 중、하나
	CASE 2
		PRINTFORM 건슬링거
ENDSELECT

@発動者条件_4856 , ARG
SIF EQUIP:ARG:총 == 0
	RETURN 0
SIF !GET_BTL_TALENT_LV("건슬링거",  ARG)
	RETURN 0
RETURN 1


@参加者条件_4856, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4856, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;메기도
		IF HAVE_SKILL(ARG, [[스킬:메기도]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:메기도]]
			SIF RESULT
				RETURN 1
		ENDIF
		;메기도라
		IF HAVE_SKILL(ARG, [[스킬:메기도라]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:메기도라]]
			SIF RESULT
				RETURN 1
		ENDIF
		;메기도라온
		IF HAVE_SKILL(ARG, [[스킬:메기도라온]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:메기도라온]]
			SIF RESULT
				RETURN 1
		ENDIF
		
		RETURN 0
ENDSELECT

@リンケージコストタイプ_4856, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
ENDSELECT
@リンケージコスト_4856, ARG
SELECTCASE ARG
	CASE 1
		RETURN 5
ENDSELECT
