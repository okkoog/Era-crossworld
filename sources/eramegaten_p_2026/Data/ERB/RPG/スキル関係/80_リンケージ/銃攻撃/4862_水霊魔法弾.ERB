

;スキル名
@SKILL_NAME_4862,ARG
RESULTS = 수령마법탄

;　명중
@SKILL_HITRATE_4862, ARG
RETURN 150

;　威力
@SKILL_POWER_4862, ARG
SIF ARG == -1 || CFLAG:ARG:단독링케이지
	RETURN 100
RETURN 100 + MAXBASE:(CFLAG:ARG:링케이지참가자1):마력/2 + MAXBASE:(CFLAG:ARG:링케이지참가자1):지혜 / 4

;　최저공격횟수
;マシンガンというかランダムターゲット系は回数が1.5倍になる
@SKILL_MINATTACKNUMBER_4862,ARG
SIF ARG < 0
	RETURN 0
RESULT = 0
TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총}
IF RESULT == 1
	CALLFORM 最低攻撃回数_{EQUIP:ARG:총},ARG
	RETURN RESULT * 3 / 2
ELSE
	CALLFORM 最低攻撃回数_{EQUIP:ARG:총},ARG
	RETURN RESULT
ENDIF

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_4862,ARG
SIF ARG < 0
	RETURN 0
RESULT = 0
TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총}
IF RESULT == 1
	CALLFORM 最大攻撃回数_{EQUIP:ARG:총},ARG
	RETURN RESULT * 3 / 2
ELSE
	CALLFORM 最大攻撃回数_{EQUIP:ARG:총},ARG
	RETURN RESULT
ENDIF

