@LINKAGE_4862
RETURN 1

@参加人数_4862
RETURN 1

@参加条件表示_4862,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 부흐、마하・부흐、아쿠아、또는 마하・아쿠아 중、하나
	CASE 2
		PRINTFORM 운디네탄
ENDSELECT

@発動者条件_4862 , ARG
SIF EQUIP:ARG:총 == 0
	RETURN 0
SIF ITEM:5518 < 1
	RETURN 0
SIF !GET_BTL_TALENT_LV("건슬링거",  ARG)
	RETURN 0
TRYCALLFORM 特殊弾倉_{EQUIP:ARG:총},ARG
FOR LOCAL, 1, RESULT + 1
	LOCALS = 특수탄{LOCAL}
	SIF EQUIP:ARG:LOCALS == 5518
		RETURN 1
NEXT
RETURN 0


@参加者条件_4862, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4862, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;ブフかマハ・ブフを使えること
		IF HAVE_SKILL(ARG, [[스킬:부흐]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:부흐]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:마하・부흐]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마하・부흐]]
			SIF RESULT
				RETURN 1
		ENDIF
		;アクアかマハ・アクアを使えること
		IF HAVE_SKILL(ARG, [[스킬:아쿠아]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:아쿠아]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:마하・아쿠아]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마하・아쿠아]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

