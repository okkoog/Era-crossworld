;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4862, ARG, ARG:1, ARG:2
CALL GET_SKILL_PROP, "SKILL_SPHERE", 4862, ARG
IF RESULT == 1
	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,4862
ELSE
	RESULT = 0
	TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총}
	IF RESULT == 1
		CALL ATTACK_RAND,ARG,ARG:1,4862
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,4862
	ENDIF
	
ENDIF
