@発動者条件_4845 , ARG
SIF EQUIP:ARG:총 == 0
	RETURN 0
SIF ITEM:5513 < 4
	RETURN 0
SIF !GET_BTL_TALENT_LV("건슬링거",  ARG)
	RETURN 0
TRYCALLFORM 特殊弾倉_{EQUIP:ARG:총},ARG
FOR LOCAL, 1, RESULT + 1
	LOCALS = 특수탄{LOCAL}
	SIF EQUIP:ARG:LOCALS == 5513
		RETURN 1
NEXT
RETURN 0


@参加者条件_4845, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4845, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;ブフダインかマハ・ブフダインを使えること
		IF HAVE_SKILL(ARG, [[스킬:부흐다인]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:부흐다인]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:마하・부흐다인]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마하・부흐다인]]
			SIF RESULT
				RETURN 1
		ENDIF
		;アクアダインかマハ・アクダインを使えること
		IF HAVE_SKILL(ARG, [[스킬:아쿠아다인]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:아쿠아다인]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:마하・아쿠다인]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마하・아쿠다인]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

