;スキル及び行動の実行
;====================================================
@ACTION_4845, ARG, ARG:1, ARG:2
CALL GET_SKILL_PROP, "SKILL_SPHERE", 4845, ARG
IF RESULT == 1
	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,4845
ELSE
	RESULT = 0
	TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총}
	IF RESULT == 1
		CALL ATTACK_RAND,ARG,ARG:1,4845
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,4845
	ENDIF
	
ENDIF
