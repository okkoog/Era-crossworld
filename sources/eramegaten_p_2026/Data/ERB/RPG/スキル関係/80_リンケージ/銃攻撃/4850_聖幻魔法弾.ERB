

;スキル名
@SKILL_NAME_4850,ARG
RESULTS = 성환마법탄

;　명중
@SKILL_HITRATE_4850, ARG
RETURN 150

;　威力
@SKILL_POWER_4850, ARG
SIF ARG == -1 || CFLAG:ARG:단독링케이지
	RETURN 135
RETURN (90 + MAXBASE:(CFLAG:ARG:링케이지참가자1):마력/2 + MAXBASE:(CFLAG:ARG:링케이지참가자1):지혜 / 4) * 3 / 2

;　최저공격횟수
;マシンガンというかランダムターゲット系は回数が1.5倍になる
@SKILL_MINATTACKNUMBER_4850,ARG
SIF ARG < 0
	RETURN 0
RESULT = 0
TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총}
IF RESULT == 1
	CALLFORM 最低攻撃回数_{EQUIP:ARG:총},ARG
	RETURN RESULT * 3 / 2
ELSE
	CALLFORM 最低攻撃回数_{EQUIP:ARG:총},ARG
	RETURN RESULT
ENDIF

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_4850,ARG
SIF ARG < 0
	RETURN 0
RESULT = 0
TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총}
IF RESULT == 1
	CALLFORM 最大攻撃回数_{EQUIP:ARG:총},ARG
	RETURN RESULT * 3 / 2
ELSE
	CALLFORM 最大攻撃回数_{EQUIP:ARG:총},ARG
	RETURN RESULT
ENDIF
;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_4850, ARG, ARG:1
RETURN GET_SKILL_COST_TYPE_NUM("HP")
;消費なし＝1

;　コストの量
@SKILL_COST_4850, ARG
RETURN 7

;　相性
@SKILL_TYPE_4850,ARG
RETURN GET_TYPE_NUM("파마")
;　1EXTRAか2MAGICか

@SKILL_DECIDE_TYPE_4850
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_4850, ARG
RETURN GET_ダメージタイプ_NUM("物理")
@SKILL_ATTACKTYPE_4850, ARG
RETURN GET_攻撃タイプ_NUM("총")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_4850, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_4850,ARG
SIF ARG < 0
	RETURN 0
CALLFORM 射程_{EQUIP:ARG:총},ARG
RETURN RESULT

;　範囲　1単体　21列　3全体　4　敵味方全体
;　ランダムターゲットでない銃は範囲が一段階分強化される
@SKILL_SPHERE_4850,ARG
SIF ARG < 0
	RETURN 0
RESULT = 0
TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총}
IF RESULT == 1
	CALLFORM 攻撃範囲_{EQUIP:ARG:총},ARG
	RETURN RESULT
ELSE
	CALLFORM 攻撃範囲_{EQUIP:ARG:총},ARG
	RETURN LIMIT(RESULT + 1, 1, 3)
ENDIF
;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_4850, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_4850
RETURN GET_SUCCESSION_NUM("계통없음")

