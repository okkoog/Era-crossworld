;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4850
RETURN 1

@参加人数_4850
RETURN 1

@参加条件表示_4850,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 파마의뇌광、마한마온、바이코우하、메기도라 중、하나
	CASE 2
		PRINTFORM 성스러운탄환 * 2
ENDSELECT

@発動者条件_4850 , ARG
SIF EQUIP:ARG:총 == 0
	RETURN 0
SIF ITEM:5503 < 2
	RETURN 0
SIF !GET_BTL_TALENT_LV("건슬링거",  ARG)
	RETURN 0
TRYCALLFORM 特殊弾倉_{EQUIP:ARG:총},ARG
FOR LOCAL, 1, RESULT + 1
	LOCALS = 특수탄{LOCAL}
	SIF EQUIP:ARG:LOCALS == 5503
		RETURN 1
NEXT
RETURN 0


@参加者条件_4850, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4850, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;破魔の雷光を使えること
		IF HAVE_SKILL(ARG, [[스킬:파마의뇌광]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:파마의뇌광]]
			SIF RESULT
				RETURN 1
		ENDIF
		;マハンマオンを使えること
		IF HAVE_SKILL(ARG, [[스킬:마한마온]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마한마온]]
			SIF RESULT
				RETURN 1
		ENDIF
		;バイコウハを使えること
		IF HAVE_SKILL(ARG, [[스킬:바이코우하]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:바이코우하]]
			SIF RESULT
				RETURN 1
		ENDIF
		;メギドラを使えること
		IF HAVE_SKILL(ARG, [[스킬:메기도라]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:메기도라]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

