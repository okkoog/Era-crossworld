RETURN 0
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4850, ARG, ARG:1, ARG:2
CALL GET_SKILL_PROP, "SKILL_SPHERE", 4850, ARG
IF RESULT == 1
	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,4850
ELSE
	RESULT = 0
	TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총}
	IF RESULT == 1
		CALL ATTACK_RAND,ARG,ARG:1,4850
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,4850
	ENDIF
	
ENDIF
SIF CFLAG:ARG:PT플래그 > 0
	ITEM:5503 -= 2



