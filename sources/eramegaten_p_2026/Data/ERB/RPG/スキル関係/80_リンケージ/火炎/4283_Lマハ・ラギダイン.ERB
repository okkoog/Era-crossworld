@LINKAGE_4283
RETURN 1

@参加人数_4283
RETURN 1

@参加条件表示_4283,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 갈다인
	CASE 2
		PRINTFORM 아기다인
ENDSELECT

@発動者条件_4283 , ARG
;アギダインを使えること
SIF HAVE_SKILL(ARG, [[스킬:아기다인]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:아기다인]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4283, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4283, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;ガルダインを使えること
		IF HAVE_SKILL(ARG, [[스킬:갈다인]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:갈다인]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

