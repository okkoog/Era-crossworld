@参加条件表示_4281,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 갈계 １체 마법
	CASE 2
		PRINTFORM 아기계 １체 마법
ENDSELECT

@発動者条件_4281 , ARG
;アギ系単体魔法を使えること
IF HAVE_SKILL(ARG, [[스킬:아기]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:아기]]
	SIF RESULT
		RETURN 1
ENDIF
IF HAVE_SKILL(ARG, [[스킬:아기라오]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:아기라오]]
	SIF RESULT
		RETURN 1
ENDIF
IF HAVE_SKILL(ARG, [[스킬:아기다인]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:아기다인]]
	SIF RESULT
		RETURN 1
ENDIF
RETURN 0


@参加者条件_4281, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4281, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;ガル系単体魔法を使えること
		IF HAVE_SKILL(ARG, [[스킬:갈]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:갈]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:갈라]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:갈라]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:갈다인]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:갈다인]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

