;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4287
RETURN 1

@参加人数_4287
RETURN 2

@参加条件表示_4287,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 화염계 마법
	CASE 2
		PRINTFORM 만능계 마법
	CASE 3
		PRINTFORM 데들리번
ENDSELECT

@発動者条件_4287 , ARG
;デッドリーバーンを使えること
SIF HAVE_SKILL(ARG, [[스킬:데들리번]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:데들리번]]
SIF RESULT
	RETURN 1
RETURN 0

@参加者条件_4287, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4287, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;火炎相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "화염", , "공격", "魔法", 4287)
		RETURN RESULT
	CASE 2
		;万能相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "만능", , "공격", "魔法", 4287)
		RETURN RESULT
ENDSELECT

