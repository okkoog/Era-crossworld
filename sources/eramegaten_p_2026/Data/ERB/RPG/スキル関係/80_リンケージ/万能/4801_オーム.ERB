;=====================================================
@LINKAGE_4801
RETURN 1

@参加人数_4801
RETURN 2

@参加条件表示_4801, ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 스리스티
	CASE 2
		PRINTFORM 스티티
	CASE 3
		PRINTFORM 프라라야
ENDSELECT

@発動者条件_4801 , ARG
;プララヤを使えること
SIF HAVE_SKILL(ARG, 19) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , 19
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4801, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4801, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;スティティを使えること
		IF HAVE_SKILL(ARG, 421)
			CALL CHECK_ACTIONABLE , ARG , 421
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
	CASE 2
		;スリスティを使えること
		IF HAVE_SKILL(ARG, 423)
			CALL CHECK_ACTIONABLE , ARG , 423
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

@リンケージコストタイプ_4801, ARG
