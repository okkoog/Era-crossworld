;地母が真っ先に候補にあがったけど、トレードマークとっちゃうのもなぁということで、こっちに
;とりあえず,原作通り高クリティカル、低命中仕様で、相性は통상공격의 相性に依存
;ここまででわかるけど、当然魔法系は使いこなせないし
;圧倒的にサクセサーが使えるとでかいスキル
;まぁ、サクセサーは仕様的に残り二つの契約リンケージを発動すらできないので、いいかなぁという判断

;スキル名
@SKILL_NAME_4800,ARG
RESULTS = 사망유희

;　명중
@SKILL_HITRATE_4800, ARG
RETURN 70

;　威力
@SKILL_POWER_4800, ARG
RETURN 300 + MAXBASE:MASTER:힘 / 2

;　최저공격횟수
@SKILL_MINATTACKNUMBER_4800,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_4800,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_4800, ARG, ARG:1
RETURN GET_SKILL_COST_TYPE_NUM("HP")
;消費なし＝1

;　コストの量
@SKILL_COST_4800, ARG
RETURN 30

;　相性
@SKILL_TYPE_4800, ARG
SIF ARG < 0
	RETURN GET_TYPE_NUM("不定")
RETURN ABL:ARG:공격상성
;　1EXTRAか2MAGICか
;高クリティカル
@SKILL_CRITICAL_RATE_4800, ARG
RETURN 30
@SKILL_DECIDE_TYPE_4800
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_4800, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_4800, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_4800,ARG
RETURN 4

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_4800,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_4800, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_4800
RETURN GET_SUCCESSION_NUM("계통없음")

;속도보정
@SKILL_SPEED_4800, ARG = -1
RETURN 20

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_4800
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_4800, ARG = -1
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4800, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD, ARG, ARG:1, 4800

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_4800, ARG
PRINTL 적 전체를 후려친다



;使用条件
@SKILL_SPECIAL_ACTIONABLE_4800,ARG
CALL CHECK_COST,ARG,4800
SIF RESULT == 0
	RETURN 0
RETURN 1
;とくにない


;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4800
RETURN 1

@参加人数_4800
RETURN 1

@参加条件表示_4800, ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM %CALLNAME:MASTER%
	CASE 2
		PRINTFORM 【노리개】
ENDSELECT

@発動者条件_4800 , ARG
SIF TALENT:ARG:노리개
	RETURN 1
RETURN 0


@参加者条件_4800, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4800, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		SIF ARG == MASTER
			RETURN 1
		RETURN 0
ENDSELECT

@リンケージコストタイプ_4800, ARG
SELECTCASE ARG
	CASE 1
		RETURN 2
ENDSELECT
@リンケージコスト_4800, ARG
SELECTCASE ARG
	CASE 1
		RETURN 15
ENDSELECT
