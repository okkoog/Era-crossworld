@LINKAGE_4806
RETURN 1

@参加人数_4806
RETURN 1

@参加条件表示_4806,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 합계 위력 400 이상의 전체 물리공격 스킬
	CASE 2
		PRINTFORM 끝나는세계
ENDSELECT

@発動者条件_4806 , ARG
;終わる世界を使えること
SIF HAVE_SKILL(ARG, 2067) == 0;끝나는세계
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , 2067;끝나는세계
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4806, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4806, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;特大ダメージ物理全体攻撃スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH2(ARG, "검격", "전체", "공격", "物理", ,400,4806)
		SIF RESULT
			RETURN 1
		CALL HAVE_SKILL_SEARCH2(ARG, "타격", "전체", "공격", "物理", ,400,4806)
		SIF RESULT
			RETURN 1
		CALL HAVE_SKILL_SEARCH2(ARG, "비구", "전체", "공격", "物理", ,400,4806)
		SIF RESULT
			RETURN 1
		CALL HAVE_SKILL_SEARCH2(ARG, "전술", "전체", "공격", "物理", ,400,4806)
		RETURN RESULT
ENDSELECT

