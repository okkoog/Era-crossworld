;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_4806, ARG, ARG:1, ARG:2
#DIMS L_EFFECT
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
IF CFLAG:ARG:PT플래그
	SELECTCASE ABL:ARG:새드끼 + ABL:(CFLAG:ARG:링케이지참가자1):마조끼
		CASE IS > 15
			L_EFFECT = 공격_방어_마법위력_마법효과_명중_회피
		CASE IS > 7
			L_EFFECT = 방어_마법효과_명중_회피
		CASE IS > 3
			L_EFFECT = 방어_마법효과
		CASEELSE
			L_EFFECT = 방어
	ENDSELECT
ELSE
	L_EFFECT = 공격_방어_마법위력_마법효과_명중_회피
ENDIF
CALL SKILL_SET_カジャンダ, ARG, ARG:1, L_EFFECT, -4, "短縮"

