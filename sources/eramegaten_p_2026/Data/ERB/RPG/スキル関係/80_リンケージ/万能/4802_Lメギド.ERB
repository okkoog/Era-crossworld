RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_4802,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_4802, ARG, ARG:1
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_4802, ARG
RETURN 8

;　相性
@SKILL_TYPE_4802,ARG
RETURN GET_TYPE_NUM("만능")
