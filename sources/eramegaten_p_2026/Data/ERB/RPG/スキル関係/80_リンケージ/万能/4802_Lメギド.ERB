RETURN 100

;　威力
@SKILL_POWER_4802, ARG
SIF ARG == -1 || CFLAG:ARG:단독링케이지
	RETURN 240
;発動者と参加者の魔法威力の比率により、威力に補正がかかる
RETURN 240 * (MAXBASE:ARG:마법위력 * 2 + MAXBASE:(CFLAG:ARG:링케이지참가자1):마법위력 + MAXBASE:(CFLAG:ARG:링케이지참가자2):마법위력) / (MAXBASE:ARG:마법위력 * 4)
