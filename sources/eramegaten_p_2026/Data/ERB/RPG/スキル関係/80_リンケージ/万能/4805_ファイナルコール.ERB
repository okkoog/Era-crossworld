;サマナー強化計画？の為にキングライザー装備キャラにも使える様に
;長所：最大火力がえげつない。
;短所：蘇生が手間。削りに向かない。自爆スキル自体が不用品。とどめを刺したら相棒は経験値が貰えない。
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#


;スキル名
@SKILL_NAME_4805,ARG
RESULTS = 파이널콜

;　명중
@SKILL_HITRATE_4805, ARG = -1
;ガンスリンガー以外は十全に扱えない
SIF ARG == -1
	RETURN 100
SIF GET_BTL_TALENT_LV("건슬링거",  ARG)
	RETURN 110
RETURN 80

;　威力
;상대의 ライフ割合に応じて위력이 格段に上昇する
;アニメ版でマオー・ヘルの体の亀裂に対して放った事の再現
@SKILL_POWER_4805, ARG
;500 + 自爆者の耐力 * 5(最大999)
LOCAL = MIN( 999 , 400 + BASE:(CFLAG:ARG:링케이지참가자1):내구 * 5 + BASE:ARG:마력 * 2 + BASE:ARG:운*2 )


SELECTCASE ( BASE:(POS(CFLAG:ARG:타겟)):ＨＰ * 100 / MAXBASE:(POS(CFLAG:ARG:타겟)):ＨＰ ) - 1
CASE IS < 5
	TIMES LOCAL, 11.5
CASE IS < 10
	TIMES LOCAL, 6.81
CASE IS < 15
	TIMES LOCAL, 4.25
CASE IS < 20
	TIMES LOCAL, 2.83
;30-40%は1.5倍
CASE IS < 30
	TIMES LOCAL, 2.02
;30-40%は1.3倍
CASE IS < 40
	TIMES LOCAL, 1.56
CASE IS < 50
	TIMES LOCAL, 1.2
;50-70%で等倍
CASE IS < 70
;70-90%で0.8倍
CASE IS < 90
	TIMES LOCAL,0.8
;9割以上で半減
CASEELSE
	TIMES LOCAL,0.5
ENDSELECT
RETURN LOCAL
	

;　최저공격횟수
@SKILL_MINATTACKNUMBER_4805,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_4805,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_4805, ARG, ARG:1
RETURN GET_SKILL_COST_TYPE_NUM("HP")

;　コストの量
@SKILL_COST_4805, ARG
RETURN 30

;　相性
@SKILL_TYPE_4805, ARG
VARSET LOCAL
SIF ARG == -1
	RETURN GET_TYPE_NUM("만능")
SIF CFLAG:ARG:타겟 > 16 || CFLAG:ARG:타겟 < 1
	RETURN GET_TYPE_NUM("만능")
LOCAL = POS(CFLAG:ARG:타겟)
SIF LOCAL < 0
	RETURN GET_TYPE_NUM("만능")
LOCAL:1 = MAXBASE:LOCAL:만능 == 999 ? -999 # MAXBASE:LOCAL:만능
SIF CFLAG:LOCAL:만능무효화횟수
	LOCAL:1 = 0
LOCAL:2 = MAXBASE:LOCAL:비구 == 999 ? -999 # MAXBASE:LOCAL:비구
SIF CFLAG:LOCAL:비구무효화횟수
	LOCAL:2 = 0
RETURN LOCAL:1 > LOCAL:2 ? GET_TYPE_NUM("만능") # GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
;高クリティカル
@SKILL_CRITICAL_RATE_4805, ARG
RETURN 30

@SKILL_DECIDE_TYPE_4805
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_4805, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_4805, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_4805,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_4805,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_4805, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_4805
RETURN GET_SUCCESSION_NUM("만능")

;속도보정
@SKILL_SPEED_4805, ARG = -1
RETURN 20

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_4805
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_4805, ARG = -1
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4805, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
LOCAL:1 = CFLAG:ARG:링케이지참가자1
CALL ATTACK_SINGLE,ARG,LOCAL,4805
CALL DEAD_CHARA	 , LOCAL:1

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_4805, ARG
PRINTL COMP에 격납한 동료마의 모든 생명력을 맞바꿔 적 １체에 비구＋만능 상성 특대 데미지。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_4805,ARG
CALL CHECK_COST,ARG,4805
SIF RESULT == 0
	RETURN 0
RETURN 1
;とくにない


;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4805
RETURN 1

@参加人数_4805
RETURN 1

@参加条件表示_4805, ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 자폭 or 옥쇄파 or 바이널스트라이크
	CASE 2
		PRINTFORM 세츠나 or 미라이 or 킹라이저 장비
ENDSELECT

@発動者条件_4805 , ARG
IF GROUPMATCH(NO:ARG,[[キャラ:세츠나]],[[キャラ:미라이]])
	RETURN 1
;キングライザー装備した純サマナーでも可能(未実装)
ELSEIF EQUIP:ARG:악세서리 == GETNUM(ITEM, "킹라이저")
	RETURN 1
ENDIF
RETURN 0

@参加者条件_4805, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
;人間はダメ
SIF IS_HUMAN(ARG)
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4805, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;自爆系特技を使えること
		IF CHECK_SKILL(ARG, [[스킬:자폭]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:자폭]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF CHECK_SKILL(ARG, [[스킬:옥쇄파]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:옥쇄파]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF CHECK_SKILL(ARG, [[스킬:바이널스트라이크]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:바이널스트라이크]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

@リンケージコストタイプ_4805, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
ENDSELECT

;消費をHP15%→MP40に変更
;単体技だが人修羅の至高の魔弾が威力640で消費50なのでこの程度が妥当かと
@リンケージコスト_4805, ARG
SELECTCASE ARG
	CASE 1
		RETURN 40
ENDSELECT
