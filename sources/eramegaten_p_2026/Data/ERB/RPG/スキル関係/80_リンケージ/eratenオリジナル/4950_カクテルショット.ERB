;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_4950, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_4950
RETURN GET_SUCCESSION_NUM("파마")

;속도보정
@SKILL_SPEED_4950, ARG = -1
RETURN 20

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_4950
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_4950, ARG = -1
RETURN 0



;拡散攻撃用追加処理
@SKILL_SPREAD_4950,ARG
RETURN 1
;拡散距離:1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4950, ARG, ARG:1, ARG:2
IF CFLAG:ARG:PT플래그 > 0
	IF GET_CHARA_STOCK_MAG((ARG)) > MAX(GET_CHARA_MAXMAG(ARG)/20,1)
		IF GET_CHARA_STOCK_MAG(CFLAG:ARG) > MAX(GET_CHARA_MAXMAG(CFLAG:ARG:링케이지참가자1)/20,1)
			CALL ATTACK_SPREAD,ARG,ARG:1,4950
		ELSE
			PRINTL MAG가 부족해 실패했다！
		ENDIF
	ELSE
		PRINTL MAG가 부족해 실패했다！
	ENDIF
ELSE
	CALL ATTACK_SPREAD,ARG,ARG:1,4950
ENDIF

IF CFLAG:ARG:PT플래그 > 0
	IF GET_CHARA_STOCK_MAG((ARG)) < MAX(GET_CHARA_MAXMAG(ARG)/20,1)
		PRINTFORML %조사처리(CALLNAME:(ARG),"는")% ＭＡＧ가 부족해 맥이 풀렸다！
		CFLAG:ARG:상태이상 = GET_STATE_NUM("SLIP")
	ELSE
		PRINTFORML %CALLNAME:ARG% >>>>> {MAX(GET_CHARA_MAXMAG(ARG)/20,1)} 소비 (나머지{GET_CHARA_STOCK_MAG(ARG)})
	ENDIF
	CALL CONTROL_MAG, ARG, -GET_CHARA_STOCK_MAG(ARG)
	
	IF GET_CHARA_STOCK_MAG(CFLAG:ARG:링케이지참가자1) < MAX(GET_CHARA_MAXMAG(CFLAG:ARG:링케이지참가자1)/20,1)
		PRINTFORML %조사처리(CALLNAME:(CFLAG:ARG:링케이지참가자1),"는")% ＭＡＧ가 부족해 맥이 풀렸다！
		CFLAG:(CFLAG:ARG:링케이지참가자1):상태이상 = GET_STATE_NUM("SLIP")
	ELSE
		PRINTFORML %CALLNAME:(CFLAG:ARG:링케이지참가자1)% >>>>> {MAX(GET_CHARA_MAXMAG(CFLAG:ARG:링케이지참가자1)/20,1)} 소비 (남은 양 {BASE:(CFLAG:ARG:링케이지참가자1)})
	ENDIF
	CALL CONTROL_MAG, , -MAX(GET_CHARA_MAXMAG(CFLAG:ARG:링케이지참가자1)/20,1)
ELSE
ENDIF

