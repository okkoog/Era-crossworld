;スキル名
@SKILL_NAME_4950,ARG
RESULTS = 칵테일샷

;　명중
@SKILL_HITRATE_4950, ARG = -1
;ガンスリンガーは命中にボーナス
SIF ARG == -1
	RETURN 110
SIF GET_BTL_TALENT_LV("건슬링거",  ARG)
	RETURN 120
RETURN 80

;　威力
@SKILL_POWER_4950,ARG
;初期化
LOCAL = 0
LOCAL:1 = MIN((EXP:(ARG):사정경험 * 2) , 80)
SIF HAVE_PENIS(ARG) == 0
		LOCAL:1 = 0
IF FLAG:확산플래그
	LOCAL = (20 + LOCAL:1 + MIN((EXP:(CFLAG:ARG:링케이지참가자1):분유경험 / 20) + (ABL:(CFLAG:ARG:링케이지참가자1):분유중독 * 20) , 500) ) * 1/2
	RETURN LOCAL
ELSE
ENDIF

LOCAL = 20 + LOCAL:1 + MIN((EXP:(CFLAG:ARG:링케이지참가자1):분유경험 / 20) + (ABL:(CFLAG:ARG:링케이지참가자1):분유중독 * 20) , 500)
RETURN LOCAL

@SKILL_CALC_BATTTLE_STATUS_4950, ARGS, ARG, ARG:1
SIF ARG < 0
	RETURN 0
SELECTCASE ARGS
	CASE "ATK"
		;召喚予定キャラの攻と魔威のうち高いほう
		RETURN (MAXBASE:ARG:공격 + MAXBASE:ARG:마법위력 + MAXBASE:ARG:총공격) / 3 * 2
	CASE "DEF"
		RETURN 0
	CASE "HIT"
		RETURN 0
	CASE "AVOID"
		RETURN 0
ENDSELECT
;　최저공격횟수
@SKILL_MINATTACKNUMBER_4950,ARG
	RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_4950,ARG
	RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_4950, ARG, ARG:1
RETURN GET_SKILL_COST_TYPE_NUM("HP")

;　コストの量
@SKILL_COST_4950, ARG
RETURN 5

;　相性
@SKILL_TYPE_4950, ARG
