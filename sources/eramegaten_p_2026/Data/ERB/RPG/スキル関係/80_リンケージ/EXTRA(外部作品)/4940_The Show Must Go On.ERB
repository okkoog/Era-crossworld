@SKILL_TYPE_4940_舞台少女相性, 対象
#FUNCTIONS
#DIM 対象
SELECTCASE NO:対象
	CASE [[キャラ:카렌_무대소녀]]
		;花
		RETURNF "핵열"
	CASE [[キャラ:히카리]]
		;月
		RETURNF "정신"
	CASE [[キャラ:마히루]]
		;花……は被るので地属性で
		RETURNF "지변"
	CASE [[キャラ:쥰나]]
		;雪
		RETURNF "빙결"
	CASE [[キャラ:후타바_무대소녀]]
		;宙
		RETURNF "중력"
	CASE [[キャラ:카오루코]]
		;風
		RETURNF "질풍"
	CASE [[キャラ:나나]]
		;雲……雲ってなんだ？　達人なので微妙な属性に
		RETURNF "주살"
	CASE [[キャラ:마야_무대소녀]]
		;月　達人なので微妙な属性に
		RETURNF "파마"
	CASE [[キャラ:클로딘]]
