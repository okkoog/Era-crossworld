;コストの量
;005変更 相性関数の変更に合わせて相性数依存に変更
;;;相性数に応じてコスト上昇する
@SKILL_COST_4940, 発動者
#DIM 発動者
#DIM 発動相性数
#DIM CONST 最大相性数 = 4
#DIM チェック中相性
SIF 発動者 < 0 || スキル属性表示中
	RETURN 8

VARSET RESULT, -1
CALL SKILL_TYPE_4940(発動者)
発動相性数 = 1
;@SKILL_TYPE_4940は第四返り値まで第一相性で初期化するので第一相性と異なるかだけチェック
;万能属性付与時はバランス調整のため最重量コスト
FOR チェック中相性, 1, 最大相性数
	SIF RESULT:チェック中相性 != -1 && RESULT:チェック中相性 != RESULT:0
		発動相性数 ++
	IF RESULT:チェック中相性 == GET_TYPE_NUM("만능")
		発動相性数 = 最大相性数
		BREAK
	ENDIF
NEXT

SELECTCASE 発動相性数
	CASE 1
		RETURN 8
	CASE 2
		RETURN 12
	CASE 3
		RETURN 20
	CASE 4
		RETURN 30
	CASEELSE
		;005 ここに来ることはないが将来の拡張のために未調整だが設置
		RETURN 発動相性数 * 10 - 30;= 10*(発動相性数 - 3) + 20
ENDSELECT
