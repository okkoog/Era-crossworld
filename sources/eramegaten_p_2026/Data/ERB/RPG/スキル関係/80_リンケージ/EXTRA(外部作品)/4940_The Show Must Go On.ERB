	RETURN GET_TYPE_NUM("검격")

;;--- 004 START ---
;発動者で基本相性変更
;これは手持ちの武器で
SELECTCASE NO:発動者
	CASE [[キャラ:카렌_무대소녀]]
		VARSET スキル相性, "검격"
	CASE [[キャラ:히카리]]
		VARSET スキル相性, "검격"
	CASE [[キャラ:마히루]]
		VARSET スキル相性, "타격"
	CASE [[キャラ:쥰나]]
		VARSET スキル相性, "비구"
	CASE [[キャラ:후타바_무대소녀]]
		VARSET スキル相性, "검격"
	CASE [[キャラ:카오루코]]
		VARSET スキル相性, "검격"
	CASE [[キャラ:나나]]
		;でぇばは戦技で
		VARSET スキル相性, "전술"
	CASE [[キャラ:마야_무대소녀]]
		VARSET スキル相性, "검격"
	CASE [[キャラ:클로딘]]
		VARSET スキル相性, "검격"
	CASEELSE
		VARSET スキル相性, "검격"
ENDSELECT

;発動者がアイドル人気100以上（人気取得）で相性追加
;005変更 発動者の歌唱技能5以上で相性追加
IF ABL:発動者:가창기능 >= 5
	;発動者で追加相性変更
	スキル相性:1 '= SKILL_TYPE_4940_舞台少女相性(発動者)
ENDIF

;005追加 参加者も参照して相性追加
参加者 = CFLAG:発動者:링케이지참가자1
IF 参加者 >= 0 && ABL:参加者:가창기능 >= 5
	スキル相性:2 '= SKILL_TYPE_4940_舞台少女相性(参加者)
ENDIF

;発動者がアイドル人気200以上で万能追加
IF CFLAG:発動者:아이돌인기 >= 200
	スキル相性:3 = 만능
ENDIF
RETURN GET_TYPE_NUM(スキル相性), GET_TYPE_NUM(スキル相性:1), GET_TYPE_NUM(スキル相性:2), GET_TYPE_NUM(スキル相性:3)

