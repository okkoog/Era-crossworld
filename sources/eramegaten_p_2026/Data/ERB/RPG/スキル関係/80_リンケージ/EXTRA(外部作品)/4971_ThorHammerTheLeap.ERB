;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4971
RETURN 1

@参加人数_4971
RETURN 1

@参加条件表示_4971,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 【秋山凜子】
	CASE 2
		PRINTFORM 【미즈키 유키카제】＆ 뇌추＜토르해머＞ 습득 완료
ENDSELECT

@発動者条件_4971 , ARG
; ゆきかぜがトールハンマーを使える事
SIF NO:ARG != [[キャラ:유키카제]] 
	RETURN 0
SIF HAVE_SKILL(ARG, [[스킬:뇌추＜토르해머＞]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:뇌추＜토르해머＞]]
SIF RESULT
	RETURN 1
RETURN 0

@参加者条件_4971, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4971, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		SIF NO:ARG == [[キャラ:아키야마린코]]
			RETURN 1
		RETURN 0
ENDSELECT
@リンケージ能力参照者_4971, ARG
	SIF FLAG:공격횟수 == 1
		RETURN 1
	RETURN 0

@リンケージコストタイプ_4971, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
ENDSELECT
@リンケージコスト_4971, ARG
SELECTCASE ARG
	CASE 1
		RETURN 40
ENDSELECT
