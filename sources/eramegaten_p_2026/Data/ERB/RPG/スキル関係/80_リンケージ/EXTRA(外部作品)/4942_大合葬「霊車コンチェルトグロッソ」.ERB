@SKILL_HITRATE_4942, ARG
RETURN 100

;　威力
@SKILL_POWER_4942, ARG
#LOCALSIZE 2
SIF ARG == -1 || CFLAG:ARG:단독링케이지
	RETURN 550
IF ARG != -1
	LOCAL   =  MIN(ABL:ARG:가창기능 , ABL:(CFLAG:ARG:링케이지참가자1):가창기능 , ABL:(CFLAG:ARG:링케이지참가자2):가창기능)
	LOCAL:1 = 10 * (MAXBASE:ARG:마법위력 * 2 + MAXBASE:(CFLAG:ARG:링케이지참가자1):마법위력 + MAXBASE:(CFLAG:ARG:링케이지참가자2):마법위력) / (MAXBASE:ARG:마법위력 * 4)
ENDIF
IF      0== LOCAL
	RETURN  5  * LOCAL:1
ELSEIF  1 == LOCAL
	RETURN 55  * LOCAL:1
ELSEIF  2 == LOCAL
	RETURN 65  * LOCAL:1
ELSEIF  3 == LOCAL
	RETURN 85  * LOCAL:1
ELSEIF  4 == LOCAL
	RETURN 95  * LOCAL:1
ELSEIF  5 == LOCAL
	RETURN 105 * LOCAL:1
ELSEIF  6 == LOCAL
	RETURN 120 * LOCAL:1
ELSEIF  7 == LOCAL
	RETURN 150 * LOCAL:1
ELSEIF  8 == LOCAL
	RETURN 175 * LOCAL:1
ELSEIF  9 == LOCAL
	RETURN 200 * LOCAL:1
ELSEIF 10 == LOCAL
	RETURN 250 * LOCAL:1
ENDIF
RETURN 500
