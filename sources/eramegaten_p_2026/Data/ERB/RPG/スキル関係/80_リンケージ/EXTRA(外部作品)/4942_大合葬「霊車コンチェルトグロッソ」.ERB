ELSEIF LOCAL == 3
	RETURN 24
ELSEIF LOCAL == 4
	RETURN 34
ELSEIF LOCAL == 5
	RETURN 39
ELSEIF LOCAL == 6
	RETURN 43
ELSEIF LOCAL == 7
	RETURN 48
ELSEIF LOCAL == 8
	RETURN 58
ELSEIF LOCAL == 9
	RETURN 60
ELSE
	RETURN 62
ENDIF
RETURN 11
