;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4970
RETURN 1

@参加人数_4970
RETURN 1

@参加条件表示_4970,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 【이부키】＆ LV40 이상
	CASE 2
		PRINTFORM 【이로하】
ENDSELECT

@発動者条件_4970 , ARG
;イブキのレベル40以上じゃないとダメムリ
SIF BASE:ARG:LV < 40
	RETURN 0
SIF NO:ARG == [[キャラ:이부키]]
	RETURN 1
RETURN 0

@参加者条件_4970, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4970, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		SIF NO:ARG == [[キャラ:이로하]]
			RETURN 1
		RETURN 0
ENDSELECT
@リンケージ能力参照者_4970, ARG
	SIF FLAG:공격횟수 == 1
		RETURN 1
	RETURN 0

@リンケージコストタイプ_4970, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
ENDSELECT
@リンケージコスト_4970, ARG
SELECTCASE ARG
	CASE 1
		RETURN 40
ENDSELECT
