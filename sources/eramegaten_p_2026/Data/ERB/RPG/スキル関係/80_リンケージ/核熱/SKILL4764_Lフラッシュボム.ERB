@発動者条件_4764 , ARG
;核熱相性のスキルを使用可能なこと
CALL HAVE_SKILL_SEARCH(ARG, "핵열", , "공격", )
RETURN RESULT


@参加者条件_4764, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4764, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;破魔相性の魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "파마", "範囲", "공격", "魔法", 4764)
		SIF RESULT
			RETURN 1
		CALL HAVE_SKILL_SEARCH(ARG, "파마", "範囲", "상태변화", "魔法", 4764)
		SIF RESULT
			RETURN 1
ENDSELECT
