RETURN 1

@参加条件表示_4483,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 방어 or 마법효과 약화 지원스킬
	CASE 2
		PRINTFORM 범위 정신계 스킬
ENDSELECT

@発動者条件_4483 , ARG
CALL HAVE_SKILL_SEARCH(ARG, "정신", "範囲", "공격", )
SIF RESULT
	RETURN 1
CALL HAVE_SKILL_SEARCH(ARG, "정신", "範囲", "상태변화", )
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4483, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4483, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;攻撃or魔法威力弱化支援スキルを使えること
		IF HAVE_SKILL(ARG, 507);라쿤・다
			CALL CHECK_ACTIONABLE , ARG , 507;
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, 541);사만・다
			CALL CHECK_ACTIONABLE , ARG , 541;사만・다
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, 538);용해브레스
			CALL CHECK_ACTIONABLE , ARG , 538;용해브레스
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, 542);악마의위협
			CALL CHECK_ACTIONABLE , ARG , 542;악마의위협
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

