;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_4485,ARG
IF TFLAG:스킬용1
	SIF !INRANGE(CFLAG:ARG:타겟, 1, 16)
		RETURN 0
	SIF CFLAG:POS(CFLAG:ARG:타겟):상태이상 != GET_STATE_NUM("PANIC")
		RETURN 0
	RETURN GET_STATE_NUM("DYING")
ELSE
	RETURN GET_STATE_NUM("PANIC")
ENDIF
