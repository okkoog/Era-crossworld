	RETURN 1
RETURN 0


@参加者条件_4485, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4485, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1, 2
		IF HAVE_SKILL(ARG, [[스킬:텐타라후]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:텐타라후]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

