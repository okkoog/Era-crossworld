@LINKAGE_4484
RETURN 1

@参加人数_4484
RETURN 2

@参加条件表示_4484,ARG
SELECTCASE ARG
	CASE 1, 2, 3
		PRINTFORM 정신 상성의 범위 스킬
ENDSELECT

@発動者条件_4484 , ARG
;精神相性の範囲スキルを使用可能なこと
CALL HAVE_SKILL_SEARCH(ARG, "정신", "範囲", "공격", )
SIF RESULT
	RETURN 1
CALL HAVE_SKILL_SEARCH(ARG, "정신", "範囲", "상태변화", )
RETURN RESULT

@参加者条件_4484, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4484, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1, 2
		;精神相性の範囲スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "정신", "範囲", "공격", , 4484)
		SIF RESULT
			RETURN 1
		CALL HAVE_SKILL_SEARCH(ARG, "정신", "範囲", "상태변화", , 4484)
		RETURN RESULT
ENDSELECT

