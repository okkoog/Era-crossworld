@LINKAGE_4083
RETURN 1

@参加人数_4083
RETURN 1

@参加条件表示_4083,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 질풍계 마법
	CASE 2
		PRINTFORM 소닉펀치
ENDSELECT

@発動者条件_4083 , ARG
;ソニックパンチを使用可能なこと
SIF !HAVE_SKILL(ARG , [[스킬:소닉펀치]])
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:소닉펀치]]
SIF RESULT == 0
	RETURN 0
RETURN 1


@参加者条件_4083, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4083, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;疾風相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "질풍", , "공격", "魔法", 4083)
		RETURN RESULT
ENDSELECT
@リンケージ能力参照者_4083, ARG
