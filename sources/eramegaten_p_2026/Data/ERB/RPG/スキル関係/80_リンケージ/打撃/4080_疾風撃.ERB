@参加条件表示_4080,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 질풍계 마법
	CASE 2
		PRINTFORM 타격계 １체 물리
ENDSELECT

@発動者条件_4080 , ARG
;打撃相性の単体物理攻撃スキルを使用可能なこと
CALL HAVE_SKILL_SEARCH(ARG, "타격", "단체", "공격", "物理")
RETURN RESULT


@参加者条件_4080, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4080, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;疾風相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "질풍", , "공격", "魔法", 4080)
		RETURN RESULT
ENDSELECT
@リンケージ能力参照者_4080, ARG
