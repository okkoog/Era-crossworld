@LINKAGE_4560
RETURN 1

@参加人数_4560
RETURN 1

@参加条件表示_4560,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 상태이상 마법
	CASE 2
		PRINTFORM 무드계 마법
ENDSELECT

@発動者条件_4560, ARG
FOR LOCAL, 1 , FLAG:스킬수+1
	SIF ABL:ARG:("스킬" + TOSTR(LOCAL)) == 0
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_DECIDE_TYPE", ABL:ARG:("스킬" + TOSTR(LOCAL)), ARG
	SIF RESULT != 2
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_TYPE", ABL:ARG:("스킬" + TOSTR(LOCAL)), ARG
	SIF RESULT != GET_TYPE_NUM("주살")
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_EFECT", ABL:ARG:("스킬" + TOSTR(LOCAL)), ARG
	SIF RESULT != 3
		CONTINUE
	CALL CHECK_ACTIONABLE , ARG , ABL:ARG:("스킬" + TOSTR(LOCAL))
	SIF RESULT == 0
		CONTINUE
	RETURN 1
NEXT
RETURN 0

@参加者条件_4560, ARG , ARG:1
#LOCALSIZE 2
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4560, ARG:1
SIF RESULT == 0
	RETURN 0
;状態変化魔法スキルを使えること(DYINGは除く)
FOR LOCAL, 1, 42
	LOCAL = LOCAL == FLAG:스킬수 + 1 ? 21 # LOCAL
	LOCAL:1 = ABL:ARG:@"\@ LOCAL > 20 ? 장비 # \@스킬{LOCAL > 20 ? LOCAL - 20 # LOCAL}"
	SIF !LOCAL:1 && LOCAL > 20
		BREAK
	SIF !LOCAL:1
		CONTINUE
	;状態異常でないなら戻る
	CALL GET_SKILL_PROP, "SKILL_EFECT", LOCAL:1, ARG
	SIF RESULT != 3
		CONTINUE
	;魔法でないなら戻る
	CALL GET_SKILL_PROP, "SKILL_DECIDE_TYPE", LOCAL:1, ARG
	SIF RESULT != 2
		CONTINUE
	;即死は除外
	CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_STATE", LOCAL:1, ARG
	SIF RESULT == GET_STATE_NUM("DYING")
		CONTINUE
	CALL CHECK_ACTIONABLE , ARG , LOCAL:1
	SIF RESULT == 0
		CONTINUE
	RETURN 1
NEXT
RETURN 0
