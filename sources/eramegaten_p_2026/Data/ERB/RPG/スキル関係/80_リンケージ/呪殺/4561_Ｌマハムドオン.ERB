@LINKAGE_4561
RETURN 1

@参加人数_4561
RETURN 1

@参加条件表示_4561,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 상태이상 마법
	CASE 2
		PRINTFORM 무드온 or 마하무드온
ENDSELECT

@発動者条件_4561 , ARG
IF CHECK_SKILL(ARG, [[스킬:무드온]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:무드온]]
	SIF RESULT
		RETURN 1
ENDIF
IF CHECK_SKILL(ARG, [[스킬:마하무드온]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:마하무드온]]
	SIF RESULT
		RETURN 1
ENDIF
RETURN 0


@参加者条件_4561, ARG , ARG:1
#LOCALSIZE 2
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4561, ARG:1
SIF RESULT == 0
	RETURN 0
;状態変化魔法スキルを使えること(DYINGは除く)
FOR LOCAL, 1, 42
	LOCAL = LOCAL == FLAG:스킬수 + 1 ? 21 # LOCAL
	LOCAL:1 = ABL:ARG:@"\@ LOCAL > 20 ? 장비 # \@스킬{LOCAL > 20 ? LOCAL - 20 # LOCAL}"
	SIF !LOCAL:1 && LOCAL > 20
		BREAK
	SIF !LOCAL:1
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_DECIDE_TYPE", LOCAL:1, ARG
	SIF RESULT != 2
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_EFECT", LOCAL:1, ARG
	SIF RESULT != 3
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_STATE", LOCAL:1, ARG
	SIF RESULT == GET_STATE_NUM("DYING")
		CONTINUE
	CALL CHECK_ACTIONABLE , ARG , LOCAL:1
	SIF RESULT == 0
		CONTINUE
	RETURN 1
NEXT
RETURN 0
@リンケージコストタイプ_4561, ARG
