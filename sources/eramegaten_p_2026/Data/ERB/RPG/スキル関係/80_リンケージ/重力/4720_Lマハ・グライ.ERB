@LINKAGE_4720
RETURN 1

@参加人数_4720
RETURN 1

@参加条件表示_4720,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 잔계 １체 마법
	CASE 2
		PRINTFORM 그라이계 １체 마법
ENDSELECT

@発動者条件_4720 , ARG
;グライ系単体魔法を使えること
IF HAVE_SKILL(ARG, [[스킬:그라이]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:그라이]]
	SIF RESULT
		RETURN 1
ENDIF
IF HAVE_SKILL(ARG, [[스킬:그라이바]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:그라이바]]
	SIF RESULT
		RETURN 1
ENDIF
IF HAVE_SKILL(ARG, [[스킬:그라다인]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:그라다인]]
	SIF RESULT
		RETURN 1
ENDIF
RETURN 0


@参加者条件_4720, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4720, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;ザン系単体魔法を使えること
		IF HAVE_SKILL(ARG, [[스킬:잔]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:잔]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:잔마]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:잔마]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:잔다인]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:잔다인]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

@リンケージコストタイプ_4720, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
ENDSELECT
@リンケージコスト_4720, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
ENDSELECT
