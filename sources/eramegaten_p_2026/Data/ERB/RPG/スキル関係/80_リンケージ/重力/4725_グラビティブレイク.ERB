

;スキル名
@SKILL_NAME_4725,ARG
RESULTS = 그래비티브레이크
;　명중
@SKILL_HITRATE_4725, ARG
RETURN 90

;　威力
@SKILL_POWER_4725, ARG
SIF ARG == -1 || CFLAG:ARG:단독링케이지
	RETURN 480
;発動者と参加者の魔法威力の比率により、威力に補正がかかる
RETURN 480 * (MAXBASE:ARG:마법위력 * 2 + MAXBASE:(CFLAG:ARG:링케이지참가자1):마법위력 + MAXBASE:(CFLAG:ARG:링케이지참가자2):마법위력) / (MAXBASE:ARG:마법위력 * 4)
;　최저공격횟수
@SKILL_MINATTACKNUMBER_4725,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_4725,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_4725, ARG, ARG:1
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_4725, ARG
RETURN 16

;　相性
@SKILL_TYPE_4725,ARG
RETURN GET_TYPE_NUM("중력")
;　1EXTRAか2MAGICか

@SKILL_DECIDE_TYPE_4725
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_4725, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_4725, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_4725,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_4725,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_4725, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_4725
RETURN GET_SUCCESSION_NUM("계통없음")

;속도보정
@SKILL_SPEED_4725, ARG = -1
RETURN 20

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_4725
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_4725, ARG = -1
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4725, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD, ARG, ARG:1, 4725






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_4725, ARG
PRINTL 물질을 붕괴시키는 중력파를 부딪쳐、적 전체에 특대 데미지를 준다



;使用条件
@SKILL_SPECIAL_ACTIONABLE_4725,ARG
CALL CHECK_COST,ARG,4725
SIF RESULT == 0
	RETURN 0
RETURN 1
;とくにない


;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4725
RETURN 1

@参加人数_4725
RETURN 2

@参加条件表示_4725,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 중력계 마법
	CASE 2
		PRINTFORM 핵열계 마법
	CASE 3
		PRINTFORM 마하・그라다인
ENDSELECT

@発動者条件_4725 , ARG
;マハ・グラダインを使えること
SIF HAVE_SKILL(ARG, [[스킬:마하・그라다인]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:마하・그라다인]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4725, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4725, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;重力相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "중력", , "공격", "魔法", 4725)
		RETURN RESULT
	CASE 2
		;核熱相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "핵열", , "공격", "魔法", 4725)
		RETURN RESULT
ENDSELECT

@リンケージコストタイプ_4725, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
	CASE 2
		RETURN 3
ENDSELECT
@リンケージコスト_4725, ARG
SELECTCASE ARG
	CASE 1
		RETURN 12
	CASE 2
		RETURN 12
ENDSELECT
