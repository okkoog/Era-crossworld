@参加条件表示_4042,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 빙결계 마법
	CASE 2
		PRINTFORM 비구계 범위 물리
ENDSELECT

@発動者条件_4042 , ARG
;飛具相性の範囲物理攻撃スキルを使用可能なこと
CALL HAVE_SKILL_SEARCH(ARG, "비구", "範囲", "공격", "物理")
RETURN RESULT


@参加者条件_4042, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4042, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;氷結相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "빙결", , "공격", "魔法", 4042)
		RETURN RESULT
ENDSELECT
