@参加条件表示_4041,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 충격계 마법
	CASE 2
		PRINTFORM 비구계 １체 물리
ENDSELECT

@発動者条件_4041 , ARG
;飛具相性の単体物理攻撃スキルを使用可能なこと
CALL HAVE_SKILL_SEARCH(ARG, "비구", "단체", "공격", "物理")
RETURN RESULT


@参加者条件_4041, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4041, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;衝撃相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "충격", , "공격", "魔法", 4041)
		RETURN RESULT
ENDSELECT
@リンケージ能力参照者_4041, ARG
