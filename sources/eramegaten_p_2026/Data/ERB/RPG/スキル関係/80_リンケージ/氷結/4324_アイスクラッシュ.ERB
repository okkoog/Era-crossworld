;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4324
RETURN 1

@参加人数_4324
RETURN 2

@参加条件表示_4324,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 빙결계 마법
	CASE 2
		PRINTFORM 전격계 마법
	CASE 3
		PRINTFORM 마하・부흐라
ENDSELECT

@発動者条件_4324 , ARG
;マハ・ブフーラを使えること
SIF HAVE_SKILL(ARG, [[스킬:마하・부흐라]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:마하・부흐라]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4324, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4324, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;氷結相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "빙결", , "공격", "魔法", 4324)
		RETURN RESULT
	CASE 2
		;電撃相性の攻撃魔法スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "전격", , "공격", "魔法", 4324)
		RETURN RESULT
ENDSELECT

@リンケージコストタイプ_4324, ARG
SELECTCASE ARG
	CASE 1
		RETURN 3
	CASE 2
		RETURN 3
ENDSELECT
@リンケージコスト_4324, ARG
