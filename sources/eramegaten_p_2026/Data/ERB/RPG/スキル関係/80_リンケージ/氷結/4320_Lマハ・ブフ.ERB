@参加条件表示_4320,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 마그나계 １체 마법
	CASE 2
		PRINTFORM 부흐계 １체 마법
ENDSELECT

@発動者条件_4320 , ARG
;ブフ系単体魔法を使えること
IF HAVE_SKILL(ARG, [[스킬:부흐]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:부흐]]
	SIF RESULT
		RETURN 1
ENDIF
IF HAVE_SKILL(ARG, [[스킬:부흐라]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:부흐라]]
	SIF RESULT
		RETURN 1
ENDIF
IF HAVE_SKILL(ARG, [[스킬:부흐다인]])
	CALL CHECK_ACTIONABLE , ARG , [[스킬:부흐다인]]
	SIF RESULT
		RETURN 1
ENDIF
RETURN 0


@参加者条件_4320, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4320, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;マグナ系単体魔法を使えること
		IF HAVE_SKILL(ARG, [[스킬:마그나]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마그나]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:마그나스]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마그나스]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:마그다인]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마그다인]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

