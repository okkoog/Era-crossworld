@LINKAGE_4322
RETURN 1

@参加人数_4322
RETURN 1

@参加条件表示_4322,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 마그다인
	CASE 2
		PRINTFORM 부흐다인
ENDSELECT

@発動者条件_4322 , ARG
;ブフダインを使えること
SIF HAVE_SKILL(ARG, [[스킬:부흐다인]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:부흐다인]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4322, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4322, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;マグダインを使えること
		IF HAVE_SKILL(ARG, [[스킬:마그다인]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마그다인]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

