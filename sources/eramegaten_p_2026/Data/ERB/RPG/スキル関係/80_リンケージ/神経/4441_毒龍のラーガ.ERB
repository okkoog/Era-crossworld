;リンケージ設定
;=====================================================
@LINKAGE_4441
RETURN 1

@参加人数_4441
RETURN 1

@参加条件表示_4441,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 공격 or 마법위력 약화 지원 스킬
	CASE 2
		PRINTFORM 범위 신경계 스킬
ENDSELECT

@発動者条件_4441 , ARG
CALL HAVE_SKILL_SEARCH(ARG, "신경", "範囲", "공격", )
SIF RESULT
	RETURN 1
CALL HAVE_SKILL_SEARCH(ARG, "신경", "範囲", "상태변화", )
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4441, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4441, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;攻撃or魔法威力弱化支援スキルを使えること
		IF HAVE_SKILL(ARG, 506);타룬・다
			CALL CHECK_ACTIONABLE , ARG , 506;타룬・다
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, 556);마칸・다
			CALL CHECK_ACTIONABLE , ARG , 556;마칸・다
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, 514);포효
			CALL CHECK_ACTIONABLE , ARG , 514;포효
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, 557);악마의이갈이
			CALL CHECK_ACTIONABLE , ARG , 557;악마의이갈이
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

