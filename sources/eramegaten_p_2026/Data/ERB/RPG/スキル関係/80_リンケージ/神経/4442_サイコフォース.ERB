	RETURN 1
CALL HAVE_SKILL_SEARCH(ARG, "신경", "範囲", "상태변화", )
RETURN RESULT


@参加者条件_4442, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4442, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1, 2
		;神経相性の範囲スキルを使用可能なこと
		CALL HAVE_SKILL_SEARCH(ARG, "신경", "範囲", "공격", , 4484)
		SIF RESULT
			RETURN 1
		CALL HAVE_SKILL_SEARCH(ARG, "신경", "範囲", "상태변화", , 4484)
		RETURN RESULT
ENDSELECT
RETURN 0

