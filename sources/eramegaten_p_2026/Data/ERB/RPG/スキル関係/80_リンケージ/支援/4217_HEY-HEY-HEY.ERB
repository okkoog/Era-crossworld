;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4217
RETURN 1

@参加人数_4217
RETURN 1

@参加条件表示_4217,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 도발
	CASE 2
		PRINTFORM 끝없는도발
ENDSELECT

@発動者条件_4217 , ARG
;無限の挑発を使えること
SIF HAVE_SKILL(ARG, [[스킬:끝없는도발]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:끝없는도발]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4217, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4217, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;挑発を使えること
		IF HAVE_SKILL(ARG, [[스킬:도발]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:도발]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

@リンケージコストタイプ_4217, ARG
