;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4205
RETURN 1

@参加人数_4205
RETURN 3

@参加条件表示_4205,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 라쿠・카쟈、사마・카쟈
	CASE 2
		PRINTFORM 마카・카쟈
	CASE 3
		PRINTFORM 스쿠・카쟈
	CASE 4
		PRINTFORM 타루・카쟈
ENDSELECT

@発動者条件_4205 , ARG
;タル・カジャを使えること
SIF HAVE_SKILL(ARG, [[스킬:타루・카쟈]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:타루・카쟈]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4205, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4205, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;ラク・カジャ、サマ・カジャを使えること
		IF HAVE_SKILL(ARG, [[스킬:라쿠・카쟈]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:라쿠・카쟈]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:사마・카쟈]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:사마・카쟈]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
	CASE 2
		;マカ・カジャを使えること
		IF HAVE_SKILL(ARG, [[스킬:마카・카쟈]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마카・카쟈]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
	CASE 3
		;スク・カジャを使えること
		IF HAVE_SKILL(ARG, [[스킬:스쿠・카쟈]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:스쿠・카쟈]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

