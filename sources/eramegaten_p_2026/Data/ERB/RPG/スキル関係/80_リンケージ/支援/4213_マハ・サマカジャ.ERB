;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4213
RETURN 1

@参加人数_4213
RETURN 1

@参加条件表示_4213,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 사마・카쟈
	CASE 2
		PRINTFORM 자애의기도
ENDSELECT

@発動者条件_4213 , ARG
;慈愛の祈りを使えること
SIF HAVE_SKILL(ARG, [[스킬:자애의기도]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:자애의기도]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4213, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4213, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;サマ・カジャを使えること
		IF HAVE_SKILL(ARG, [[스킬:사마・카쟈]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:사마・카쟈]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

