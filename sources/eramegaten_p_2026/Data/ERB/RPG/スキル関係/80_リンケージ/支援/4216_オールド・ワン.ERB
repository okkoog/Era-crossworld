;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4216
RETURN 1

@参加人数_4216
RETURN 3

@参加条件表示_4216,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 라쿤・다、사만・다
	CASE 2
		PRINTFORM 마칸・다
	CASE 3
		PRINTFORM 스쿤・다
	CASE 4
		PRINTFORM 타룬・다
ENDSELECT

@発動者条件_4216 , ARG
;タル・ンダを使えること
SIF HAVE_SKILL(ARG, [[스킬:타룬・다]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:타룬・다]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4216, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4216, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;ラク・ンダ、サマ・ンダを使えること
		IF HAVE_SKILL(ARG, [[스킬:라쿤・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:라쿤・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:사만・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:사만・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
	CASE 2
		;マカ・ンダを使えること
		IF HAVE_SKILL(ARG, [[스킬:마칸・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마칸・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
	CASE 3
		;スク・ンダを使えること
		IF HAVE_SKILL(ARG, [[스킬:스쿤・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:스쿤・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

