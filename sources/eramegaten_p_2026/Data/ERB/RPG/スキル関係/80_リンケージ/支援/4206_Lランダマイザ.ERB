@発動者条件_4206 , ARG
;魔界の調べを使えること
SIF HAVE_SKILL(ARG, [[스킬:마계의조사]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:마계의조사]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4206, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4206, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;ンダ系魔法スキルを使えること
		IF HAVE_SKILL(ARG, [[스킬:타룬・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:타룬・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:라쿤・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:라쿤・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:스쿤・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:스쿤・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:사만・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:사만・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:마칸・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마칸・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
	CASE 2
		;ンダ系魔法スキルを使えること
		IF HAVE_SKILL(ARG, [[스킬:타룬・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:타룬・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:라쿤・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:라쿤・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:스쿤・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:스쿤・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:사만・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:사만・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		IF HAVE_SKILL(ARG, [[스킬:마칸・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:마칸・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

