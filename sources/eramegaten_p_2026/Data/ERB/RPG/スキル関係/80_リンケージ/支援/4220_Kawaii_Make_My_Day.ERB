	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4220, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		SIF NO:ARG == [[キャラ:미즈모토 유카리]]
			RETURN 1
		RETURN 0
	CASE 2
		SIF NO:ARG == [[キャラ:노리코_아이마스]]
