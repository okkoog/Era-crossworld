;スキル名
@SKILL_NAME_4200,ARG
RESULTS = Ｌ히트라이저

;　명중
@SKILL_HITRATE_4200, ARG
RETURN 100

;　威力
@SKILL_POWER_4200, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_4200,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_4200,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_4200, ARG, ARG:1
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_4200, ARG
RETURN 45


@SKILL_DECIDE_TYPE_4200
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_4200, ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　사거리
@SKILL_RANGE_4200,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_4200,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_4200, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")


;계승타입
@SKILL_SUCCESSION_TYPE_4200
RETURN GET_SUCCESSION_NUM("계통없음")

;속도보정
@SKILL_SPEED_4200, ARG = -1
RETURN 20

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_4200
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_4200, ARG = -1
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_4200, ARG, ARG:1, ARG:2
;#LOCALSIZE 1
CALL SKILL_SET_カジャンダ, ARG, ARG, "공격/마법위력/명중", 16, "단체"
;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 16)
;CFLAG:ARG:마법위력강화 = MIN(32, CFLAG:ARG:마법위력강화 + 16)
;CFLAG:ARG:명중강화 = MIN(32, CFLAG:ARG:명중강화 + 16)

;PRINTFORMW 　　TARGET:[{CPOS(ARG),2}] %CALLNAME:ARG,20,LEFT%　>>>>>>　攻撃、魔法威力、命中を超大幅に上がった！
;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_4200, ARG
PRINTL 자신의 공격、마법위력、명중을 초대폭 상승시킨다。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_4200,ARG
CALL CHECK_COST,ARG,4200
SIF RESULT == 0
	RETURN 0
RETURN 1
;とくにない


;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4200
RETURN 1

@参加人数_4200
RETURN 1

@参加条件表示_4200,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM %CALLNAME:MASTER%
	CASE 2
		PRINTFORM 【음마】
ENDSELECT

@発動者条件_4200 , ARG
SIF TALENT:ARG:음마
	RETURN 1
RETURN 0


@参加者条件_4200, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4200, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		SIF ARG == MASTER
			RETURN 1
		RETURN 0
ENDSELECT

@リンケージコストタイプ_4200, ARG
SELECTCASE ARG
	CASE 1
		RETURN 2
ENDSELECT
@リンケージコスト_4200, ARG
SELECTCASE ARG
	CASE 1
		RETURN 15
ENDSELECT
