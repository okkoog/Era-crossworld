;=====================================================
;リンケージ設定
;=====================================================
@LINKAGE_4209
RETURN 1

@参加人数_4209
RETURN 1

@参加条件表示_4209,ARG
SELECTCASE ARG
	CASE 1
		PRINTFORM 라쿤・다
	CASE 2
		PRINTFORM 마계의조사
ENDSELECT

@発動者条件_4209 , ARG
;魔界の調べを使えること
SIF HAVE_SKILL(ARG, [[스킬:마계의조사]]) == 0
	RETURN 0
CALL CHECK_ACTIONABLE , ARG , [[스킬:마계의조사]]
SIF RESULT
	RETURN 1
RETURN 0


@参加者条件_4209, ARG , ARG:1
SIF CPOS(ARG) < 1 || CPOS(ARG) > 6
	RETURN 0
CALL CHECK_COST_LINCAGE, ARG, 4209, ARG:1
SIF RESULT == 0
	RETURN 0
SELECTCASE ARG:1
	CASE 1
		;ラク・ンダを使えること
		IF HAVE_SKILL(ARG, [[스킬:라쿤・다]])
			CALL CHECK_ACTIONABLE , ARG , [[스킬:라쿤・다]]
			SIF RESULT
				RETURN 1
		ENDIF
		RETURN 0
ENDSELECT

