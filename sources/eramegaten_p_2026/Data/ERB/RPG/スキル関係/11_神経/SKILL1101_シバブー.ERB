;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_1101,ARG
;カレンが使用して対象が男なら基礎付与確率２倍
IF SKILL_CHANGE(ARG, [[キャラ:카렌]])
	IF INRANGE(CFLAG:ARG:타겟, 1, 17) && POS(CFLAG:ARG:타겟) >= 0
		SIF IS_MALE(POS(CFLAG:ARG:타겟))
			RETURN 80
	ENDIF
ENDIF
RETURN 40

