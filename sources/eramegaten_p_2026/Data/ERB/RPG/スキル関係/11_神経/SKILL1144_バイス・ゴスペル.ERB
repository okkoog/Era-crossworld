;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_1144, ARG, ARG:1, ARG:2
#LOCALSIZE 1
FOR LOCAL, CFLAG:ARG:PT플래그 ? 7 # 1, CFLAG:ARG:PT플래그 ? 17 # 7
	SIF POS(LOCAL) < 0
		CONTINUE
	CALL SINGLE_BADSTATE, ARG, POS(LOCAL), 1144
NEXT


