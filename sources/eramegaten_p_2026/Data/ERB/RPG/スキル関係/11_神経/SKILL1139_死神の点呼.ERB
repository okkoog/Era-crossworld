;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_1139,ARG
SIF ARG < 0
	RETURN 100
SIF !INRANGE(CFLAG:ARG:타겟, 1, 16)
	RETURN 0
SIF POS(CFLAG:ARG:타겟) < 0
	RETURN 0
;相手が条件を満たしていない場合は-1を入れて返すことで判定や表記をそのまま飛ばす
SIF !GROUPMATCH(CFLAG:POS(CFLAG:ARG:타겟):상태이상, GET_STATE_NUM("POISON"), GET_STATE_NUM("CLOSE"), GET_STATE_NUM("BIND"))
	RETURN -1
TFLAG:스킬용1++
RETURN 999

