;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1103
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1103, ARG = -1
RETURN 9

@継承不能_1103
RETURN 1


;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_1103, ARG = -1, ARG:1 = -1
RETURN 2

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_1103, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE, ARG, LOCAL, 1103

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_1103, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:야치요]]
	PRINTL 색향으로 적을 현혹시켜、무방비가 된 순간을 저격한다。
	PRINTL 적 １체에 신경 상성의 대 데미지＋무효 이하의 상성 관통。
ELSE
	PRINTL 고요하고 잔잔한 증오를 적에게 부딪친다
	PRINTL 적 １체에 신경 상성의 대 데미지＋무효 이하의 상성 관통
ENDIF


;使用条件
@SKILL_SPECIAL_ACTIONABLE_1103,ARG
RETURN 1
;とくにない

