;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_4101,ARG,ARG:1
;自分の行動のみ
SIF ARG != FLAG:행동순1
	RETURN 0
;攻撃対象が敵でないとダメ
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
SIF CFLAG:(ARG:1):방어플래그
	RETURN 0
SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "CRT/WEAK")
	RETURN 0
RETURN 1, CPOS(ARG:1)

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_AW_4101,ARG,ARG:1,ARG:2
CALL SINGLE_BADSTATE,ARG,POS(ARG:1),ARG:2