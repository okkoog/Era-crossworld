;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_4104,ARG,ARG:1,ARG:2

@SKILL_TURNEND_AW_4104, ARG
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC TEMPS
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_T
#DIM DYNAMIC L_HEAL, 2
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
SIF GET_カジャンダ_MIN(ARG) >= 0
	RETURN 0

CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬")
FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:PT플래그 ? 19 # 22), GET_POS_MAX(CFLAG:ARG:PT플래그 ? 19 # 22) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	SIF !MAXBASE:L_T:ＭＰ
		CONTINUE
	;とりあえず大気功と同じに
	L_HEAL = 10
	L_HEAL:1 = MIN(L_HEAL + BASE:L_T:ＭＰ, MAXBASE:L_T:ＭＰ) - BASE:L_T:ＭＰ
	CALL PRINT_HIT_MESSAGE, L_T, @"ＭＰ:{L_HEAL}회복", "L"
	CALL VAR_MP, L_T, L_HEAL:1, "회복"
NEXT
WAIT

;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_AW_4104, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	CASE "MP補正"
		RESULTS = 魔脈
		RETURN 30
ENDSELECT

RETURN 0

