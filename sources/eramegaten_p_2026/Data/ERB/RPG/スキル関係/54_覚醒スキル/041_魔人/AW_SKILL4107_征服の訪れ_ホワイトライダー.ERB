@SKILL_ACTIONABLE_BATTLE_AW_4107, ARG
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_4107,ARG,ARG:1,ARG:2

@SKILL_BATTLE_ENTER_AW_4107, ARG
#DIM LCOUNT
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;入場一回目のみ発動
SIF CFLAG:ARG:입장플래그 != 1
	RETURN 0
;自身の入場のみで発動
SIF TFLAG:입장캐릭터 >= 0 && TFLAG:입장캐릭터 != ARG
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬"), , , , "NOWAIT"
CALL SKILL_SET_カジャンダ, ARG, 23, "BS부착률", 4, "範囲"

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_AW_4107, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			SIF !IS_BADSTATE(L_TARGET, "GOOD")
				RETURN 20
	ENDSELECT
;自分が防御側
ELSE
ENDIF
RETURN 0
