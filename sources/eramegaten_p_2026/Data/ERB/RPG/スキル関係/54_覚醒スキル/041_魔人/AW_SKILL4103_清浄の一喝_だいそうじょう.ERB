;　 説明文の表示
@SKILL_EXPLAIN_AW_4103, ARG
PRINTL 마인 대승정의 각성 스킬
PRINTL 자동: 턴 종료 시 HAPPY, CHARM, PANIC, SLEEP 상태인 아군이 있을 경우, MP를 24 소비하여 연동 효과가 발동한다.
PRINTL 　　　「아군 전체의 FLY, DYING, ORGY, HEAT 이외의 상태이상을 회복하고, 능력 저하를 해제한다.」

@SKILL_ACTIONABLE_BATTLE_AW_4103, ARG
RETURN 0

@SKILL_TURNEND_AW_4103, ARG
#DIM DYNAMIC LCOUNT, 2
#DIMS DYNAMIC L_EFFECT
#DIM CONST L_COST = 24
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
SIF BASE:ARG:ＭＰ < L_COST
	RETURN 0
FOR LCOUNT, CFLAG:ARG:PT플래그 ? 1 # 7, CFLAG:ARG:PT플래그 ? 7 # 17
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	SIF !IS_BADSTATE_GROUP(GET_STATE(CFLAG:POS(LCOUNT):상태이상), "정신")
		CONTINUE
	CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬"), , , , "NOWAIT"
	FOR LCOUNT:1, CFLAG:ARG:PT플래그 ? 1 # 7, CFLAG:ARG:PT플래그 ? 7 # 17
		CALL CURE_STATE_SINGLE, ARG, POS(LCOUNT:1), SKILL_NUM_F("각성스킬"), 0, 0, 1
		IF RESULT
			L_EFFECT '= RESULTS
			CALL SKILL_能力低下解除, ARG, POS(LCOUNT:1), "短縮"
			SIF RESULT
				L_EFFECT += TSTR:스킬메시지추가효과
			CALL PRINT_HIT_MESSAGE, POS(LCOUNT:1), L_EFFECT, "L"
		ELSE
			CALL SKILL_能力低下解除, ARG, POS(LCOUNT:1), "단체", "NOWAIT"
		ENDIF
	NEXT
	CALL VAR_MP, ARG, -L_COST
	WAIT
	RETURN 0
NEXT

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_AW_4103, ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

