;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_4110,ARG,ARG:1,ARG:2
CALL FIELD_BADSTATE, ARG, ARG:1, ARG:2

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_4110,ARG,ARG:1
SIF ARG != ARG:1
	RETURN 0
SIF ARG != FLAG:행동순1
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", CFLAG:ARG:입력행동, ARG
SIF GET_SUCCESSION(RESULT) != "충격"
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
SIF GET_SKILL_EFFECT(RESULT) != "공격"
	RETURN 0
RETURN 1, CFLAG:ARG:PT플래그 ? 22 # 19

@SKILL_PASSIVE_PENETRATION_RANK_AW_4110, L_P, L_T, L_スキル, L_ダメージタイプ, L_攻撃タイプ, L_相性, GIVE_EFFECT_CHARA
#DIM DYNAMIC L_P;このスキルの所持者
#DIM DYNAMIC L_T;攻撃対象
#DIMS DYNAMIC L_スキル;スキルの所持者が敵に対して使用しているスキルの関数名称
#DIM DYNAMIC L_ダメージタイプ
#DIM DYNAMIC L_攻撃タイプ
#DIM DYNAMIC L_相性
#DIM DYNAMIC GIVE_EFFECT_CHARA;リーダースキル等他人からつけられている場合の提供者
SIF GET_TYPE(L_相性) == "충격"
	RETURN 0, 4
RETURN 0
;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_AW_4110, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			SIF !IS_BADSTATE(L_TARGET, "GOOD")
				RETURN 20
	ENDSELECT
;自分が防御側
ELSE
ENDIF
RETURN 0

