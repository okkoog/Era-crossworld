;スキル名
@SKILL_NAME_AW_625,ARG
RESULTS = 절세의 미

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_AW_625, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")

;　コストの量
@SKILL_COST_AW_625,ARG
RETURN 0

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_AW_625
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_AW_625, ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

;계승타입
@SKILL_SUCCESSION_TYPE_AW_625, ARG
RETURN GET_SUCCESSION_NUM("정신")

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_625, ARG, ARG:1, ARG:2
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격/방어", -4, "範囲"

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_625,ARG,ARG:1
#DIM LCOUNT
;自分自身の行動でないと誘発しない
SIF ARG != FLAG:행동순1
	RETURN 0
;判定は一回のみ
SIF ARG != ARG:1
	RETURN 0
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
SIF !(CFLAG:ARG:입력행동 == [[스킬:섹시댄스]] || CFLAG:ARG:입력행동 == [[스킬:파이널누드]])
	RETURN 0
RETURN 1, CFLAG:ARG:타겟

;効果を発揮するリーダースキル
@SKILL_GET_LEADER_SKILL_NAME_AW_625, ARG
RESULTS = 절세의 미

;　 説明文の表示
@SKILL_EXPLAIN_AW_625, ARG
PRINTL 귀녀 클레오파트라의 각성 스킬
PRINTL 자동: 이 스킬 소지자가 액티브 상태일 때, 아군은 CHARM에 강한 내성을 얻는다.
PRINTL 　　　이 스킬 소지자가 「섹시댄스」 혹은 「파이널누드」를 사용 후, 이하의 연동 효과가 발동한다.
PRINTL 　　　「효과 대상이 된 적의 공격력과 방어력을 저하시킨다.」

@SKILL_ACTIONABLE_BATTLE_AW_625, ARG
RETURN 0
