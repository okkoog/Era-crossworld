
;スキル名
@SKILL_NAME_AW_514,ARG
RESULTS = 축복의 치유

;　威力
@SKILL_POWER_AW_514, ARG
SIF ARG >= 0
	RETURN 160 + MIN(BASE:ARG:LV * 2, 160)
RETURN 160

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_AW_514, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_AW_514,ARG
RETURN 12

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_AW_514
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
@SKILL_HEAL_TYPE_AW_514, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("통상")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_AW_514,ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_AW_514,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_AW_514, ARG
RETURN GET_SPHERE_NUM("단체")

;계승타입
@SKILL_SUCCESSION_TYPE_AW_514, ARG
RETURN GET_SUCCESSION_NUM("회복")
;속도보정
@SKILL_SPEEDAW_514, ARG = -1
RETURN 0

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_AW_514,ARG
RETURN GET_SKILL_EFFECT_NUM("회복")

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_514,ARG,ARG:1,ARG:2
CALL SKILL_INVALID_WALL, ARG, POS(ARG:1), "성스러운가호", "短縮"
CALL HEAL_SINGLE,ARG, POS(ARG:1), SKILL_NUM_F("각성스킬"), , , TSTR:스킬메시지추가효과

;　 説明文の表示
@SKILL_EXPLAIN_AW_514, ARG
PRINTL 요정 하이픽시의 각성 스킬
PRINTL 아군 1체의 HP를 회복하고, FLY, DYING, ORGY, HEAT 이외의 상태이상을 회복한다.
PRINTL 추가로 1회만 배드 스테이트를 무효화하는 장벽을 부여한다.

@SKILL_EXPLAIN_TOOLTIP_AW_514, ARG
RESULTS:0 = 아군 1체의 HP를 회복하고, FLY, DYING, ORGY, HEAT 이외의 상태이상을 회복한다.
RESULTS:1 = 추가로 1회만 배드 스테이트를 무효화하는 장벽을 부여한다.

@SKILL_ACTIONABLE_BATTLE_AW_514, ARG
RETURN 1

;使用条件
@SKILL_SPECIAL_ACTIONABLE_AW_514,ARG
RETURN 1

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_AW_514,ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT
