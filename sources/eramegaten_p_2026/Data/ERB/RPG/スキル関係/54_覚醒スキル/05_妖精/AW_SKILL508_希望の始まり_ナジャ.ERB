;継承に必要な部位
@SKILL_SKILLEND_AW_508,ARG
#DIM LCOUNT
SIF !IS_BADSTATE(ARG, "DYING")
	RETURN 0
SIF SKILLGAGE_H_GET(ARG, [[스킬:각성스킬]])
	RETURN 0
SIF !GET_CREC_ACT(, ARG, "KILL")
	RETURN 0
CALL ACTION_AW_508, ARG, , [[스킬:각성스킬]]

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_508,ARG,ARG:1, ARG:2
#DIM LCOUNT
#DIM L_T
IF CFLAG:ARG:PT플래그 > 0
	SETCOLOR COLOR("FRIEND")
ELSE
	SETCOLOR COLOR("ENEMY")
ENDIF

CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬"), , , , "NOWAIT"
RESETCOLOR
FOR LCOUNT, CFLAG:(ARG):PT플래그 ? 1 # 7, CFLAG:(ARG):PT플래그 ? 7 # 17
	L_T = POS(LCOUNT)
	SIF L_T < 0
		CONTINUE
	;使用者は除外
	SIF L_T == ARG
		CONTINUE
	IF CFLAG:L_T:상태이상 == GET_STATE_NUM("DYING")
		CFLAG:L_T:상태이상 = 0
		CFLAG:L_T:상태이상경과턴수 = 0
		CALL VAR_HP,L_T,MAXBASE:L_T:ＨＰ
		PRINTFORML %CALLNAME:L_T%는 숨을 되찾았다
	ELSE
		CALL HEAL_SINGLE, ARG, L_T, ARG:2, 1
	ENDIF
NEXT
CALL SKILLGAGE_H_SET, ARG, [[스킬:각성스킬]], 1
WAIT

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_AW_508,ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT
