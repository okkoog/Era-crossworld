RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_528,ARG,ARG:1,ARG:2
CALL SKILLGAGE_H_SET, ARG, SKILL_NUM_F("각성스킬"), FLAG:경과턴수 + 2
PRINTFORMW ＞축복의 힘이 전장에 가득 찬다!

@SKILL_TURNEND_AW_528, ARG
#DIM L_T
#DIM LCOUNT
#DIMS TEMPS
SIF !SKILLGAGE_H_GET(ARG, SKILL_NUM_F("각성스킬"))
	RETURN 0
SIF FLAG:경과턴수 > SKILLGAGE_H_GET(ARG, SKILL_NUM_F("각성스킬"))
	RETURN 0
SETCOLOR COLOR("BATTLE", ARG)
CALL MESSAGE_B2, , 1, @"축복의 힘이 \@CFLAG:ARG:PT플래그?아군#적\@을 치유한다!"
RESETCOLOR
TEMPS = %RAND_SPLIT("공격/방어/마법위력/마법효과/명중률·회피율", "/")%
FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:PT플래그 ? 19 # 22), GET_POS_MAX(CFLAG:ARG:PT플래그 ? 19 # 22) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	CALL SKILL_SET_カジャンダ, ARG, L_T,  TEMPS, 4, "短縮","NOMES"
	CALL HEAL_SINGLE, ARG, L_T, SKILL_NUM_F("각성스킬"), 1, , "↑ " + TEMPS
NEXT
WAIT

@SKILL_TURNEND_USEABLE_RESERVE_AW_528,ARG
