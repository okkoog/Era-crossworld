;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_AW_512,ARG
RETURN 95


;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_AW_512, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "마법효과", BASE:ARG:LV >= 50 ? -8 # -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_512,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_AW_512,ARG
PRINTL 요정 잭프로스트의 각성 스킬
PRINTL 적 1체에 빙결 상성의 데미지를 주고, 일정 확률로 FREEZE를 부여한다.
PRINTL 공격이 성공했을 경우 대상의 마법효과를 저하시킨다.
PRINTL 이 스킬의 위력과 소비 코스트, 마법효과 저하량은 소지자의 레벨에 따라 증가한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_AW_512,ARG
RETURN 1
