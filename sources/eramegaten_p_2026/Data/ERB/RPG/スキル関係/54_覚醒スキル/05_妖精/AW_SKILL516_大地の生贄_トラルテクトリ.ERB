;継承に必要な部位
@SKILL_SKILLEND_AW_516,ARG
#DIM LCOUNT
SIF !IS_BADSTATE(ARG, "DYING")
	RETURN 0
SIF SKILLGAGE_H_GET(ARG, [[스킬:각성스킬]])
	RETURN 0
SIF !GET_CREC_ACT(, ARG, "KILL")
	RETURN 0
CALL ACTION_AW_516, ARG, , [[스킬:각성스킬]]

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_516,ARG,ARG:1, ARG:2
#DIM LCOUNT
IF CFLAG:ARG:PT플래그 > 0
	SETCOLOR COLOR("FRIEND")
ELSE
	SETCOLOR COLOR("ENEMY")
ENDIF

CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬"), , , , "NOWAIT"
RESETCOLOR

CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬"), , , , "NOWAIT"
CALL SKILL_SET_カジャンダ, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, "공격/방어/마법위력/명중/회피/마법효과", 4, "範囲", , "全能力↑ & 物理反射"
FOR LCOUNT, CFLAG:ARG:PT플래그 ? 1 # 7, CFLAG:ARG:PT플래그 ? 7 # 17
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	CFLAG:POS(LCOUNT):물리반사플래그 = 1
NEXT
CALL SKILLGAGE_H_SET, ARG, [[스킬:각성스킬]]
