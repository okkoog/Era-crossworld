;FLEEZEの判定が2回づつなのが強み
;威力/コストの成長は1~40 / 40~60 / 60~ 80で傾斜をつけておく
;最初はFLEEZE狙いスキルから威力も備えた上位スキルに変化するというコンセプト

;スキル名
@SKILL_NAME_AW_517,ARG
RESULTS = 마하 프로스톤

;　명중
@SKILL_HITRATE_AW_517, ARG
RETURN 100

;　威力
;マハブフ			威力:120		MP:7
;マハブフーラ		威力:200		MP:15
;マハブフダイン		威力:295		MP:26
;マハブフバリオン	威力:380		MP:36
;LV: 0				威力: 30 * 2	MP:4
;LV:40 				威力: 70 * 2	MP:8
;LV:60 				威力:110 * 2	MP:16
;LV:80 				威力:210 * 2	MP:40
@SKILL_POWER_AW_517, ARG
SIF ARG >= 0
	RETURN 30 + MIN(BASE:ARG:LV, 40) + LIMIT(BASE:ARG:LV - 40, 0, 20) * 2 + LIMIT(BASE:ARG:LV - 60, 0, 20) * 5
RETURN 30

;;クリティカル率
@SKILL_CRITICAL_RATE_AW_517, ARG
RETURN 0

;;　吸収率
;@SKILL_HP_ABSORBER_AW_517, ARG
;RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_AW_517,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_AW_517,ARG
RETURN 2

;;一体辺りの最大ＨＩＴ数
;;※ランダム攻撃系に使う
;@SKILL_MAXATK_PER_AW_517,ARG
;RETURN 1

;;一体辺りの最低ＨＩＴ数
;;※ランダム攻撃系に使う
;@SKILL_MINATK_PER_AW_517,ARG
;RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_AW_517, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_AW_517,ARG
SIF ARG >= 0
	RETURN 4 + MIN(BASE:ARG:LV, 40)* 1 / 10 + LIMIT(BASE:ARG:LV - 40, 0, 20) * 4 / 10 + LIMIT(BASE:ARG:LV - 60, 0, 20) * 12 / 10
RETURN 4

;　相性
;複合相性
@SKILL_TYPE_AW_517,ARG
RETURN GET_TYPE_NUM("빙결")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_AW_517
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_AW_517,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_AW_517,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_AW_517,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_AW_517,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_AW_517,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_AW_517, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_AW_517
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_AW_517,ARG
RETURN GET_STATE_NUM("FREEZE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_AW_517,ARG
RETURN 5

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_AW_517,ARG
RETURN 25

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_AW_517,ARG
RETURN 95

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_AW_517, ARG = -1, ARG:1 = -1
SIF ARG >= 0 && BASE:ARG:LV >= 80
	RETURN 4

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_517,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_AW_517,ARG
PRINTL 요정 쁘띠프로스트의 각성 스킬
PRINTL 적 1열에 빙결 상성의 데미지를 2회 주고, 일정 확률로 FREEZE를 부여한다.
PRINTL 이 스킬의 위력과 소비 코스트는 소지자의 레벨에 따라 크게 증가한다.
PRINTL 추가로 이 스킬 소지자의 레벨이 80 이상일 때, 적의 모든 빙결 내성을 무시하고 관통한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_AW_517,ARG
RETURN 1
