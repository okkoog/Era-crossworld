@SKILL_TURNSTART_AW_504, ARG
#DIM LCOUNT
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;戦闘中2回までしか発動しない
SIF SKILLGAGE_H_GET(ARG, SKILL_NUM_F("각성스킬")) >= 2
	RETURN 0
CALL SKILLGAGE_H_SET(ARG, SKILL_NUM_F("각성스킬"), SKILLGAGE_H_GET(ARG, SKILL_NUM_F("각성스킬")) + 1)
CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬"), , , , "NOWAIT"
CALL SET_C_BTL_EFFECT_FIELD, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, "バステ強耐性", 1
CALL SYNC_STATUS, ARG


;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_AW_504, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	CASE "MP補正"
		RESULTS = 魔脈
		RETURN 30
ENDSELECT

RETURN 0