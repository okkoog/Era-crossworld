@SKILL_TURNSTART_AW_501, ARG
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(MASTER)
	RETURN 0
SIF CFLAG:MASTER:입력행동 < 0
	RETURN 0
;発動率50%
SIF RAND:2
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:MASTER:입력행동
SIF GET_SKILL_EFFECT(RESULT) != "공격"
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_ATTACKTYPE", CFLAG:MASTER:입력행동
SELECTCASE GET_攻撃タイプ(RESULT)
	CASE "物理"
		SIF CFLAG:MASTER:타인기합플래그
			RETURN 0
		CALL PRINT_ACT_MESSAGE, ARG, , , , "작은 파트너"
		CALL PRINT_HIT_MESSAGE, MASTER, "다음 물리공격의 위력 상승！", "w"
		CFLAG:MASTER:타인기합플래그 = 1
	CASE "魔法"
		CALL PRINT_ACT_MESSAGE, ARG, , , , "작은 파트너"
		SIF CFLAG:MASTER:타인집중플래그
			RETURN 0
		CALL PRINT_HIT_MESSAGE, MASTER, "다음 마법공격의 위력 상승！", "w"
		CFLAG:MASTER:타인집중플래그 = 1
ENDSELECT
