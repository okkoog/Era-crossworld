;入場時に行う効果
@SKILL_BATTLE_ENTER_AW_501, ARG
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC L_EFFECT
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;入場一回目のみ発動
SIF CFLAG:ARG:입장플래그 != 1
	RETURN 0
;自身の入場のみで発動
SIF TFLAG:입장캐릭터 >= 0 && TFLAG:입장캐릭터 != ARG
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG, , , , "작은 파트너"
FOR LCOUNT, 0, VARSIZE("BASE_KAJA_TABLE")
	SIF CFLAG:MASTER:(BASE_KAJA_TABLE:LCOUNT + "강화") < 8
		L_EFFECT '= ADD_SPLIT(L_EFFECT, "/", BASE_KAJA_TABLE:LCOUNT)
NEXT
IF CPOS(MASTER) <= 0
	CALL PRINT_HIT_MESSAGE, ARG, "효과대상이 없다！"
ELSEIF L_EFFECT == "" || !IS_TARGET_ABLE(MASTER)
	CALL PRINT_HIT_MESSAGE, MASTER, "효과가 없었다！"
ELSE
	CALL SKILL_SET_カジャンダ, ARG, MASTER, L_EFFECT, 4, "단체"
ENDIF
;使用条件
@SKILL_SPECIAL_ACTIONABLE_AW_501,ARG
RETURN 1