;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_852,ARG,ARG:1
;すでに気合がかかってるときは効果がない
SIF CFLAG:ARG:気合フラグ
	RETURN 0
;攻撃対象が味方
SIF !IS_FRIEND(ARG, ARG:1)
	RETURN 0
;攻撃者が敵
SIF IS_FRIEND(ARG, FLAG:행동순1)
	RETURN 0
SIF CFLAG:(ARG:1):방어플래그
	RETURN 0
SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "CRT") && !GET_CREC_ACT(FLAG:행동순1, ARG:1, "WEAK")
	RETURN 0
RETURN 1, CPOS(ARG)

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_AW_852,ARG,ARG:1,ARG:2
PRINTFORMW %CALLNAME:ARG%는 힘을 모아 다음 공격에 대비했다!
CFLAG:ARG:気合フラグ = 1

@SKILL_PASSIVE_PENETRATION_RANK_AW_852, L_P, L_T, L_スキル, L_ダメージタイプ, L_攻撃タイプ, L_相性, GIVE_EFFECT_CHARA
#DIM DYNAMIC L_P;このスキルの所持者
#DIM DYNAMIC L_T;攻撃対象
#DIMS DYNAMIC L_スキル;スキルの所持者が敵に対して使用しているスキルの関数名称
#DIM DYNAMIC L_ダメージタイプ
#DIM DYNAMIC L_攻撃タイプ
#DIM DYNAMIC L_相性
#DIM DYNAMIC GIVE_EFFECT_CHARA;リーダースキル等他人からつけられている場合の提供者
IF GET_ダメージタイプ(L_ダメージタイプ) == "物理"
	SIF GET_TYPE(L_相性) == "전술" 
		RETURN 1
	SIF GET_TYPE(L_相性) == "화염"
		RETURN 1
ENDIF
RETURN 0