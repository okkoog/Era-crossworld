;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_860,ARG,ARG:1,ARG:2
#DIM L_P
#DIM L_T
#DIM LCOUNT,2
#DIMS L_MES
L_P = ARG
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	CALL SKILL_SET_カジャンダ, L_P, L_T, "防御_魔法効果", 4, "短縮", "NOMES"
	CALL HEAL_SINGLE, L_P, L_T, SKILL_NUM_F("각성스킬"), 1, , "↑ 방어·마법효과"
NEXT
WAIT

