;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_126, ARG, ARG:1, ARG:2
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC UP_TABLE = "공격", "방어", "마법효과", "마법위력", "命中率", "回避率"
#DIMS DYNAMIC DOWN_TABLE = "공격", "방어", "마법효과", "마법위력", "命中率", "回避率"
#DIMS DYNAMIC L_UP
#DIMS DYNAMIC L_DOWN
#DIM DYNAMIC L_NUM, 2
CALL SHUFFLE_ARRAY_STR, UP_TABLE
CALL SHUFFLE_ARRAY_STR, DOWN_TABLE
FOR LCOUNT, 0, RAND:4
	L_UP += UP_TABLE:LCOUNT
NEXT
FOR LCOUNT, 0, RAND:4
	L_DOWN += DOWN_TABLE:LCOUNT
NEXT
IF L_UP == "" && L_DOWN == ""
	PRINTFORML 아무 일도 일어나지 않았다…
ELSE
	SIF L_UP != ""
		CALL SKILL_SET_カジャンダ, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, L_UP, 4, "範囲", "NOWAIT"
	SIF L_DOWN != ""
		CALL SKILL_SET_カジャンダ, ARG, CFLAG:ARG:PT플래그 ? 22 # 19, L_DOWN, -4, "範囲", "NOWAIT"
ENDIF
WAIT
RETURN 1

