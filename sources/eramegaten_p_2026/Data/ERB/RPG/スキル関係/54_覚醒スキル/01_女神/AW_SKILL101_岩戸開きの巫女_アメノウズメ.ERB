;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_101,ARG,ARG:1
#DIM LCOUNT
;自分自身の行動では誘発しない
SIF ARG == FLAG:행동순1
	RETURN 0
;味方でないとダメ
SIF !IS_FRIEND(ARG, FLAG:행동순1)
	RETURN 0
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;行動しているキャラが回復スキルをつかってないとダメ
CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", CFLAG:(FLAG:행동순1):입력행동, FLAG:행동순1
SIF GET_SUCCESSION(RESULT) != "회복"
	RETURN 0

;ターン中に一回しか発動しない
SIF SKILLGAGE_H_GET(ARG, SKILL_NUM_F("각성스킬")) == FLAG:경과턴수 + 1
	RETURN 0
;PTメンバー全員のフラグを折ってしまう
FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:PT플래그 ? 19 # 22), GET_POS_MAX(CFLAG:ARG:PT플래그 ? 19 # 22) + 1
	SIF POS(LCOUNT) < 0
		CONTINUE
	SIF ABL:POS(LCOUNT):각성스킬 != 101
		CONTINUE
	SIF !HAVE_SKILL(POS(LCOUNT), SKILL_NUM_F("각성스킬"))
		CONTINUE
	CALL SKILLGAGE_H_SET, POS(LCOUNT), SKILL_NUM_F("각성스킬"), FLAG:경과턴수 + 1 
NEXT
RETURN 1, CFLAG:ARG:PT플래그 ? 19 # 22

