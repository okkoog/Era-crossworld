@SKILL_TURNEND_AW_119, ARG
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC IS_SHOWED
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
FOR LCOUNT, 1, 17
	L_CHARA = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_CHARA)
		CONTINUE
	SIF IS_FRIEND(ARG, L_CHARA)
		CONTINUE
	CALL SKILL_CURE_STATE_2756, CFLAG:L_CHARA:상태이상
	SIF !RESULT
		CONTINUE
	SIF !IS_SHOWED
		CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬"), , , , "NOWAIT"
	CALL SKILL_SET_カジャンダ, ARG, L_CHARA, "공격", -4, "단체", "NOWAIT"
	IS_SHOWED = 1
NEXT
SIF IS_SHOWED
	WAIT

