;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_132,ARG,ARG:1,ARG:2
#DIM LCOUNT, 2
#DIM L_T
#DIMS TEMPS

FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	TEMPS = 
	FOR LCOUNT:1, 0, VARSIZE("BASE_KAJA_TABLE")
		SIF CFLAG:L_T:(BASE_KAJA_TABLE:(LCOUNT:1) + "강화") <= 0
			CONTINUE
		TEMPS = %ADD_SPLIT(TEMPS, "_", BASE_KAJA_TABLE:(LCOUNT:1))%
	NEXT
	IF TEMPS != ""
		CALL SKILL_能力上昇解除, ARG, L_T, "단체", "NOMES"
		CALL SKILL_SET_カジャンダ, ARG, L_T,  TEMPS, -4, "短縮"
		CALL PRINT_HIT_MESSAGE, L_T, "能力上昇解除" + TSTR:스킬메시지추가효과
		TSTR:스킬메시지추가효과 = 
	ELSE
		CALL SKILL_能力上昇解除, ARG, L_T, "단체", "NOWAIT"
	ENDIF
NEXT
WAIT

