;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PASSIVE_PENETRATION_RANK_AW_1410, L_P, L_T, L_スキル, L_ダメージタイプ, L_攻撃タイプ, L_相性, GIVE_EFFECT_CHARA
#DIM DYNAMIC L_P;このスキルの所持者
#DIM DYNAMIC L_T;攻撃対象
#DIMS DYNAMIC L_スキル;スキルの所持者が敵に対して使用しているスキルの関数名称
#DIM DYNAMIC L_ダメージタイプ
#DIM DYNAMIC L_攻撃タイプ
#DIM DYNAMIC L_相性
#DIM DYNAMIC GIVE_EFFECT_CHARA;リーダースキル等他人からつけられている場合の提供者
SIF GET_TYPE(L_相性) == "파마"
	RETURN 0, 4

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_1410,ARG,ARG:1
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;判定は1回
SIF ARG != ARG:1
	RETURN 0
;味方同士でなければNG
SIF !IS_FRIEND(FLAG:행동순1, ARG)
	RETURN 0
SIF TFLAG:기합사용 && (CFLAG:(FLAG:행동순1):気合フラグ || CFLAG:(FLAG:행동순1):타인기합플래그)
	RETURN 1, CFLAG:ARG:PT플래그 ? 22 # 19
SIF TFLAG:집중사용 && (CFLAG:(FLAG:행동순1):집중플래그 || CFLAG:(FLAG:행동순1):타인집중플래그)
	RETURN 1, CFLAG:ARG:PT플래그 ? 22 # 19
RETURN 0

;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_AW_1410, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, RAND_SPLIT("공격/마법위력", "/"), -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_1410,ARG,ARG:1,ARG:2
CALL ATTACK_SKILL, ARG,ARG:1,ARG:2

;　説明文の表示
@SKILL_EXPLAIN_AW_1410,ARG
PRINTL 국진신 스쿠나히코나의 각성 스킬
PRINTL 자동: 파마 상성 공격이 적의 내성을 50%까지 무시하고 관통하는 효과를 얻는다.
PRINTL 　　　자신을 포함한 아군이 데미지를 증가시키는 차지 효과를 소비했을 때,
PRINTL 　　　이하의 연동 효과가 발동한다.
PRINTL 　　　「무작위 적 1체에 파마 상성의 소 마법 데미지를 준다. 이 공격이 성공했을 경우, 공격력 또는 마법위력을 저하시킨다.」

