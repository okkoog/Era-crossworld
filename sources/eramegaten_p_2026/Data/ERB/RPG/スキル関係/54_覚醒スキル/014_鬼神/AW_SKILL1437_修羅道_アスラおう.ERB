;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_1437,ARG,ARG:1
#DIM LCOUNT
;発動は一回のみ
SIF TFLAG:스킬트리거용1
	RETURN 0
;自分自身の行動でないと誘発しない
SIF ARG != FLAG:행동순1
	RETURN 0
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;味方への攻撃はダメ
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
;クリティカルできてないとダメ
SIF !GET_CREC_ACT(ARG, ARG:1, "CRT")
	RETURN 0
TFLAG:스킬트리거용1++
RETURN 1, CFLAG:ARG:PT플래그 ? 19 # 22

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_1437,ARG,ARG:1, ARG:2
CALL SKILL_SET_カジャンダ, ARG, ARG:1, RAND_SPLIT("공격/마법위력/攻撃_魔法威力", "/"), 4, "範囲"
