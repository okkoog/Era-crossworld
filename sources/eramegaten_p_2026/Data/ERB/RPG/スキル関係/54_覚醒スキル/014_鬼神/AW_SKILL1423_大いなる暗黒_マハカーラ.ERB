;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_1423,ARG,ARG:1
#DIM LCOUNT
;自分自身の行動でないと誘発しない
SIF ARG != FLAG:행동순1
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
;攻撃が成功している
SIF !GET_CREC_ACT(ARG, ,"HIT")
	RETURN 0
;火炎物理でないとダメ
SIF !GET_CREC_ACT(ARG, ,"物理", "화염")
	RETURN 0
RETURN 1, CFLAG:ARG:PT플래그 ? 22 # 19

