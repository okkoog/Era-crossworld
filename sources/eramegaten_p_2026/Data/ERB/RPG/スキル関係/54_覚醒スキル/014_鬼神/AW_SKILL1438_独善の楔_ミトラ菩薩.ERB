@SKILL_ACTIONABLE_BATTLE_AW_1438, ARG
RETURN 0

;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_AW_1438,ARG,ARG:1
;攻撃者が味方
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
SIF CFLAG:ARG:방어플래그
	RETURN 0
SIF !GET_CREC_ACT(ARG:1, ARG, "WEAK")
	RETURN 0
RETURN 1, CPOS(ARG)

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_AW_1438,ARG,ARG:1,ARG:2
CALL SKILL_SET_カジャンダ, ARG, ARG, "공격/방어/마법위력/마법효과/명중/회피", 4, "단체", , "弱点攻撃を受けて全ての能力があがった！"
