;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_1407,ARG,ARG:1,SKILL_NUM
#DIM LCOUNT
#DIM SKILL_NUM
#DIMS TARGET_LIST
#DIM L_TARGET
CFLAG:ARG:집중플래그 = 1
PRINTFORMW %CALLNAME:ARG%는 다음 공격에 대비해 집중하고 있다!

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_1407,ARG,ARG:1
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;味方同士でなければNG
SIF !IS_FRIEND(FLAG:행동순1, ARG)
	RETURN 0
;判定は1回
SIF ARG != ARG:1
	RETURN 0
;すでに集中がかかってるときは効果がない
SIF CFLAG:ARG:집중플래그
	RETURN 0
;ステート回復がトリガー
SIF !GET_CREC_ACT(FLAG:행동순1, , "CURE")
	RETURN 0
RETURN 1, -1

;　説明文の表示
