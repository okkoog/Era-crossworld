	RETURN 0, 4

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_1422,ARG,ARG:1,SKILL_NUM
#DIM LCOUNT
#DIM SKILL_NUM
#DIMS TARGET_LIST
#DIM L_TARGET
IF FLAG:총공격중
	PRINTFORMW %CALLNAME:ARG%는 힘을 모아 다음 공격에 대비했다!
	CFLAG:ARG:気合フラグ = 1
ELSE
	CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM
	IF GET_CREC_ACT(ARG, POS(ARG:1), "HIT")
		CALL PRINT_ACT_MESSAGE, ARG, , , , "약조신의 은덕"
		CALL CURE_STATE_FIELD, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, SKILL_NUM
		WAIT
	ENDIF
ENDIF
;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_1422,ARG,ARG:1
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;味方同士でなければNG
SIF !IS_FRIEND(FLAG:행동순1, ARG)
	RETURN 0
;判定は1回
SIF ARG != ARG:1
	RETURN 0
;すでに気合がかかってるときは効果がない
SIF CFLAG:ARG:気合フラグ
	RETURN 0
;ステート回復がトリガー
SIF !GET_CREC_ACT(FLAG:행동순1, , "CURE")
	RETURN 0
RETURN 1, -1

