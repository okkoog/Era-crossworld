;使用条件
@SKILL_SPECIAL_ACTIONABLE_AW_1422,ARG
SIF ARG >= 0 && GET_TOYOASIHARA_COUNT(ARG) > 3
	RETURN 1
RETURN 0

@SKILL_ACTIONABLE_BATTLE_AW_1422, ARG
;選択肢に出るかどうか
SIF ARG >= 0 && GET_TOYOASIHARA_COUNT(ARG) > 3
	RETURN 1
RETURN 0

@GET_TOYOASIHARA_COUNT, ARG
#FUNCTION
#DIM LCOUNT
#DIM L_CNT_TOYOASIHARA
L_CNT_TOYOASIHARA = 0
FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:PT플래그 ? 19 # 22), GET_POS_MAX(CFLAG:ARG:PT플래그 ? 19 # 22) + 1
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	SIF CSTR:POS(LCOUNT):상성그룹 != "豊葦原"
		CONTINUE
	L_CNT_TOYOASIHARA++
NEXT
RETURNF L_CNT_TOYOASIHARA

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_AW_1422,ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT
