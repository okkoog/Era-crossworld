;自分がONE･SONG･ミュージアムに有効なスキルを使用するか？(口上用)
;通常関数を呼び出すのでFUNCTION関数にするのは不可
@SKILL_O_S_MUSEUM_CHECK, L_T
#DIM L_T
#DIM USE_SKILL
USE_SKILL = CFLAG:L_T:입력행동

CALL GET_SKILL_PROP, "SKILL_EFECT", USE_SKILL, L_T
SIF RESULT != 1
	RETURN 0

VARSET RESULT
CALL GET_SKILL_PROP, "SKILL_TYPE", USE_SKILL, L_T
SIF !MATCH(RESULT, GET_TYPE_NUM("정신"))
	RETURN 0

RETURN SKILL_O_S_MUSEUM_ACT(L_T)

;味方がONE･SONG･ミュージアムを発動しているか確かめる(口上用)
@SKILL_O_S_MUSEUM_ACT, ARG
#FUNCTION
#DIM L_T
#DIM LCOUNT
FOR LCOUNT, GET_POS_MIN(!CFLAG:ARG:PT플래그 ? 22 # 19), GET_POS_MAX(!CFLAG:ARG:PT플래그 ? 22 # 19) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	SIF !HAVE_AW_SKILL(L_T, "ONE･SONG･ﾐｭｰｼﾞｱﾑ")
		CONTINUE
	SIF SKILLGAGE_D_GET(L_T, SKILL_NUM_F("각성스킬")) > 0
		RETURNF 5 - SKILLGAGE_D_GET(L_T, SKILL_NUM_F("각성스킬"))
NEXT
RETURNF 0


@O_S_MUSEUM_COOP_CHECK, L_T = -1, ARG = 0
#DIM L_T
#DIM L_OK
IF L_T >= 0
	IF L_OK > 0
		L_OK = 2
		RETURN SKILL_O_S_MUSEUM_ACT(L_T)
	ENDIF
ELSEIF L_OK < 1 && ARG == 1
	L_OK = 1
ELSEIF L_OK != 1 && ARG == 0
	L_OK = 0
ENDIF
RETURN 0
