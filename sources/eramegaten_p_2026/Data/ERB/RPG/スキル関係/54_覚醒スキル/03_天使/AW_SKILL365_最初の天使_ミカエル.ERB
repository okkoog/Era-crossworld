	RETURN 1
RETURN 0

@SKILL_TURNEND_AW_365, ARG
#DIM L_CHARA
#DIMS TEMPS
#DIM LCOUNT
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;ランダムで抽選した味方がヘブライ天使なら発動
TEMPS = "공격/방어/마법위력/마법효과/命中_回避"
FOR LCOUNT, MIN(GET_ANGEL_COUNT(ARG), 5), 5
	TEMPS = %DEL_SPLIT(TEMPS, "/", RAND_SPLIT(TEMPS, "/"))%
NEXT
SIF TEMPS == ""
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬")
CALL SKILL_SET_カジャンダ, ARG, ARG, TEMPS, 4, "단체"


