;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_366,ARG,ARG:1,SKILL_NUM
#DIM LCOUNT
#DIM SKILL_NUM
#DIMS TARGET_LIST
#DIM L_TARGET
IF FLAG:총공격중
	TARGET_LIST = 
	;死んでいる味方がいるかサーチ
	FOR LCOUNT, 0, CHARANUM
		SIF !IS_BADSTATE(LCOUNT, "DYING")
			CONTINUE
		SIF !IS_FRIEND(ARG, LCOUNT)
			CONTINUE
		SIF CPOS(LCOUNT) > 0
			CONTINUE
		SIF !IS_COMP内効果有効(LCOUNT)
			CONTINUE
		TARGET_LIST = %ADD_SPLIT(TARGET_LIST, "/", TOSTR(LCOUNT))%
	NEXT
	IF TARGET_LIST == ""
		PRINTW 대상이 없었다…
	ELSE
		L_TARGET = TOINT(RAND_SPLIT(TARGET_LIST, "/"))
		PRINTFORMW %CALLNAME:L_TARGET%는 숨을 되찾았다
		CFLAG:L_TARGET:상태이상 = 0
		CFLAG:L_TARGET:상태이상경과턴수 = 0
		CALL VAR_HP,L_TARGET,MAXBASE:L_TARGET:ＨＰ/2
	ENDIF
ELSE
	CALL ATTACK_RAND,ARG,ARG:1,SKILL_NUM
ENDIF
;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_366,ARG,ARG:1
#DIM LCOUNT
;自分以外ならNG
SIF FLAG:행동순1 != ARG
	RETURN 0
;判定は1回
SIF ARG != ARG:1
	RETURN 0
;攻撃のHITが存在しなければダメ
SIF !GET_CREC_ACT(FLAG:행동순1, , "HIT")
	RETURN 0
;アセンションを使ってないとダメ
SIF CFLAG:ARG:입력행동 != SKILL_NUM_F("각성스킬")
	RETURN 0
;死んでいる味方がいるかサーチ
FOR LCOUNT, 0, CHARANUM
	SIF !IS_BADSTATE(LCOUNT, "DYING")
		CONTINUE
	SIF !IS_FRIEND(ARG, LCOUNT)
		CONTINUE
	SIF CPOS(LCOUNT) > 0
		CONTINUE
	SIF !IS_COMP内効果有効(LCOUNT)
		CONTINUE
	RETURN 1, -1
NEXT

