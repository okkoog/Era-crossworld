@GET_ANGEL_COUNT, ARG
#FUNCTION
#DIM LCOUNT
#DIM L_CNT_ANGEL
L_CNT_ANGEL = 0
FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:PT플래그 ? 19 # 22), GET_POS_MAX(CFLAG:ARG:PT플래그 ? 19 # 22) + 1
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	SIF CSTR:POS(LCOUNT):상성그룹 != "ヘブライ天使"
		CONTINUE
	L_CNT_ANGEL++
NEXT
RETURNF L_CNT_ANGEL