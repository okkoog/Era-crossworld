@SKILL_ACTIONABLE_BATTLE_AW_458, ARG
RETURN 0

;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_458,ARG,ARG:1
;すでにすべて上昇している場合は発動しない
SIF TFLAG:획득EXP보정 >= 100 && TFLAG:드롭률보정 >= 100 && TFLAG:획득충성도보정 >= 100 && TFLAG:획득MAG보정 >= 400
	RETURN 0
;攻撃対象が味方
SIF !IS_FRIEND(ARG, ARG:1)
	RETURN 0
;攻撃者が敵
SIF IS_FRIEND(ARG, FLAG:행동순1)
	RETURN 0
SIF CFLAG:(ARG:1):방어플래그
	RETURN 0
SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "CRT") && !GET_CREC_ACT(FLAG:행동순1, ARG:1, "WEAK")
	RETURN 0
RETURN 1, CPOS(ARG)

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_AW_458,ARG,ARG:1,ARG:2
IF TFLAG:획득EXP보정 < 100 || TFLAG:드롭률보정 < 100 || TFLAG:획득충성도보정 < 100 || TFLAG:획득MAG보정 < 400
	WHILE 1
		SELECTCASE RAND:4
			CASE 3
				IF TFLAG:획득EXP보정 < 100
					PRINTFORMW ＞획득 경험치가 증가한다!
					TFLAG:획득EXP보정 = MAX(TFLAG:획득EXP보정, 100)
					RETURN 1
				ENDIF
			CASE 2
				IF TFLAG:드롭률보정 < 100
					PRINTFORMW ＞적이 아이템을 떨어뜨릴 확률이 올랐다!
					TFLAG:드롭률보정 = MAX(TFLAG:드롭률보정, 100)
					RETURN 1
				ENDIF
			CASE 1
				IF TFLAG:획득충성도보정 < 100
					PRINTFORMW ＞획득 충성도가 증가한다!
					TFLAG:획득충성도보정 = MAX(TFLAG:획득충성도보정, 100)
					RETURN 1
				ENDIF
			CASE 0
				IF TFLAG:획득MAG보정 < 400
					PRINTFORMW ＞획득 MAG가 증가한다!
					TFLAG:획득MAG보정 = MAX(TFLAG:획득MAG보정, 400)
					RETURN 1
				ENDIF
		ENDSELECT
	WEND
ENDIF
;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_AW_458, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	CASE "HP補正"
		RESULTS = 活泉
		RETURN 30
ENDSELECT

RETURN 0