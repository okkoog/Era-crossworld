;　 説明文の表示
@SKILL_EXPLAIN_AW_217, ARG
PRINTL 타천사 고모리의 각성 스킬
PRINTL 자동: 턴 종료 시마다 1회, 이 스킬 소지자가 건재할 때 연동 효과가 발동한다.
PRINTL 　　　「아군의 능력이 상승해 있는 스테이터스 중 어느 하나를 상승시킨다.」

@SKILL_ACTIONABLE_BATTLE_AW_217, ARG
RETURN 0

@SKILL_TURNEND_AW_217, ARG
#DIM LCOUNT, 2
#DIMS L_EFFECT
#DIM IS_USE_ABLE
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;ターン中に一回しか発動しない
SIF SKILLGAGE_H_GET(ARG, SKILL_NUM_F("각성스킬")) == FLAG:경과턴수 + 1
	RETURN 0
;PTメンバー全員のフラグを折ってしまう
FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:PT플래그 ? 19 # 22), GET_POS_MAX(CFLAG:ARG:PT플래그 ? 19 # 22) + 1
	SIF POS(LCOUNT) < 0
		CONTINUE
	SIF ABL:POS(LCOUNT):각성스킬 != 217
		CONTINUE
	SIF !HAVE_SKILL(POS(LCOUNT), SKILL_NUM_F("각성스킬"))
		CONTINUE
	CALL SKILLGAGE_H_SET, POS(LCOUNT), SKILL_NUM_F("각성스킬"), FLAG:경과턴수 + 1 
NEXT
IS_USE_ABLE = 0
FOR LCOUNT, CFLAG:ARG:PT플래그 ? 1 # 7, CFLAG:ARG:PT플래그 ? 7 # 17
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	FOR LCOUNT:1, 0, 6
		SIF CFLAG:POS(LCOUNT):(AUTO_SPLIT("공격/방어/마법위력/마법효과/명중/회피","/", LCOUNT:1) + "강화") <= 0
			CONTINUE
		IS_USE_ABLE = 1
		BREAK
	NEXT
NEXT
SIF !IS_USE_ABLE
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬"), , , , "NOWAIT"
FOR LCOUNT, CFLAG:ARG:PT플래그 ? 1 # 7, CFLAG:ARG:PT플래그 ? 7 # 17
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	L_EFFECT = 
	FOR LCOUNT:1, 0, 6
		SIF CFLAG:POS(LCOUNT):(AUTO_SPLIT("공격/방어/마법위력/마법효과/명중/회피","/", LCOUNT:1) + "강화") <= 0
			CONTINUE
		L_EFFECT = %ADD_SPLIT(L_EFFECT, "/", AUTO_SPLIT("공격/방어/마법위력/마법효과/명중/회피","/", LCOUNT:1))%
	NEXT
	SIF L_EFFECT == ""
		CONTINUE
	CALL SKILL_SET_カジャンダ, ARG, POS(LCOUNT), RAND_SPLIT(L_EFFECT, "/"), 4, "단체", "NOWAIT"
NEXT
WAIT