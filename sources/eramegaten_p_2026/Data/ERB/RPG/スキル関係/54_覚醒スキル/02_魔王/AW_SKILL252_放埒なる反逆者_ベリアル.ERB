;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_252,ARG,ARG:1, ARG:2

@SKILL_BATTLE_ENTER_AW_252, ARG
#DIM LCOUNT
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;自身の入場のみで発動
SIF TFLAG:입장캐릭터 >= 0 && TFLAG:입장캐릭터 != ARG
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬"), , , , "NOWAIT"
FOR LCOUNT, 1, 17
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	SIF POS(LCOUNT) == ARG
		CONTINUE
	CALL SKILL_SET_カジャンダ, ARG, POS(LCOUNT), "방어", -4, "단체", "NOWAIT"
NEXT
WAIT