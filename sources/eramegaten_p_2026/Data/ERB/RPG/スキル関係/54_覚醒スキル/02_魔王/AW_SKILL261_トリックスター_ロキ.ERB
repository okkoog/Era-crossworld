@SKILL_ACTIONABLE_BATTLE_AW_261, ARG
RETURN 0

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_261,ARG,ARG:1
#DIM LCOUNT
#DIM TABLE, 16
;自分自身の行動でないと誘発しない
SIF ARG != FLAG:행동순1
	RETURN 0
;一回しか判定しない
SIF TFLAG:스킬트리거용1
	RETURN 0
SIF !GET_CREC_ACT(ARG, ARG:1, "WEAK")
	RETURN 0
TFLAG:스킬트리거용1 = 1
SIF RAND:100 >= 20
	RETURN 0
;対象の捜索用の行動ができるキャラをリスト化し、シャッフル
FOR LCOUNT, 0, 16
	TABLE:LCOUNT = FLAG:@"행동순{LCOUNT+1}"
NEXT
FOR LCOUNT, 0, 16
	SWAP TABLE:(RAND:16), TABLE:(RAND:16)
NEXT
FOR LCOUNT, 0, 16
	SIF TABLE:LCOUNT < 0
		CONTINUE
	SIF !IS_TARGET_ABLE(TABLE:LCOUNT)
		CONTINUE
	;入力可能な状態じゃないとだめ
	SIF !ACTIONABLE_CHARA_F(TABLE:LCOUNT)
		CONTINUE
	SIF !IS_FRIEND(ARG, TABLE:LCOUNT)
		CONTINUE
	SIF CFLAG:(TABLE:LCOUNT):입력행동 == -1
		CONTINUE
	SIF ARG == TABLE:LCOUNT
		CONTINUE
	RETURN 1, CPOS(TABLE:LCOUNT)
NEXT
RETURN 0

@ACTION_AW_261,ARG,ARG:1,ARG:2
CALL PRINT_HIT_MESSAGE, POS(ARG:1), "連続行動！", "w"
CFLAG:POS(ARG:1):연속행동발생률 += 100

