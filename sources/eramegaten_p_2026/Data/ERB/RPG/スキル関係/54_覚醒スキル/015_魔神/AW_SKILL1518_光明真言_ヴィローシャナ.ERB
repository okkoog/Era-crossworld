@SKILL_TURNSTART_AW_1518, ARG
#DIM LCOUNT
#DIM COND_FRIEND
#DIM COND_ENEMY
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
COND_FRIEND = 0
COND_ENEMY = 0
FOR LCOUNT, 1, 17
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	IF IS_FRIEND(ARG, POS(LCOUNT))
		SIF GET_カジャンダ_MIN(POS(LCOUNT)) < 0
			COND_FRIEND = 1
	ELSE
		SIF GET_カジャンダ_MAX(POS(LCOUNT)) > 0
			COND_ENEMY = 1
	ENDIF
NEXT
SIF !COND_FRIEND
	RETURN 0
SIF !COND_ENEMY
	RETURN 0
;アクションの実行
CALL PRINT_ACT_MESSAGE, ARG, SKILL_NUM_F("각성스킬")
IF CFLAG:ARG:PT플래그
	CALL SKILL_能力低下解除, ARG, 19, "範囲", "PRINT/NOWAIT"
	CALL SKILL_能力上昇解除, ARG, 22, "範囲"
ELSE
	CALL SKILL_能力上昇解除, ARG, 22, "範囲", "PRINT/NOWAIT"
	CALL SKILL_能力低下解除, ARG, 19, "範囲"
ENDIF
RETURN 1

