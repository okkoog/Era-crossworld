;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_4312,ARG,ARG:1
;自分以外ならNG
SIF FLAG:행동순1 != ARG
	RETURN 0
SIF !GET_CREC_ACT(FLAG:행동순1, , "CRT")
	RETURN 0
;一回しか発動しない
SIF TFLAG:스킬트리거용1
	RETURN 0
TFLAG:스킬트리거용1 = 1
RETURN 1, CFLAG:ARG:PT플래그 ? 19 # 22

