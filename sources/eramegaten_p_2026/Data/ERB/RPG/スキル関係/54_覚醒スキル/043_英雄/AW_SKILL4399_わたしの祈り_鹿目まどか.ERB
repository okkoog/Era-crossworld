;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_4399,ARG,ARG:1, ARG:2

@SKILL_BATTLE_ENTER_AW_4399, ARG
#DIM DYNAMIC LCOUNT
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;入場一回目のみ発動
SIF CFLAG:ARG:입장플래그 != 1
	RETURN 0
;自身の入場のみで発動
SIF TFLAG:입장캐릭터 >= 0 && TFLAG:입장캐릭터 != ARG
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬"), , , , "NOWAIT"
CALL SET_C_BTL_EFFECT_FIELD, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, "バステ強耐性", 1, , , "NOPRINT"

FOR LCOUNT, CFLAG:ARG:PT플래그 ? 1 # 7, CFLAG:ARG:PT플래그 ? 7 # 17
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	CALL SKILL_SET_HPバリア, POS(LCOUNT), MAXBASE:POS(LCOUNT):ＨＰ / 2, "少女の祈り", "非表示"
	CALL PRINT_HIT_MESSAGE, POS(LCOUNT), "배드스테이트 강내성 & HP배리어"
NEXT
WAIT

;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_AW_4399, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	CASE "HP補正"
		RESULTS = 活泉
		RETURN 30
ENDSELECT