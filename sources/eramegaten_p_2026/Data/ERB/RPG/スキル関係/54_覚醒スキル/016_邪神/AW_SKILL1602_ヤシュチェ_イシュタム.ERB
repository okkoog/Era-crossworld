;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_AW_1602, ARG = -1, ARG:1 = -1
RETURN 4

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_1602,ARG,ARG:1
;場に出てる必要がある
SIF !CPOS(ARG)
	RETURN 0
;敵の攻撃時でなければNG
SIF IS_FRIEND(FLAG:행동순1, ARG)
	RETURN 0
;味方が攻撃を受けてなければダメ
SIF !IS_FRIEND(ARG, ARG:1)
	RETURN 0
;攻撃されているキャラが殺されている必要がある
SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "KILL")
	RETURN 0
;自身が行動可能でなければダメだが、自分自身が的に殺されている場合は判定が通るようになる
IF !IS_TARGET_ABLE(ARG)
	SIF !GET_CREC_ACT(FLAG:행동순1, ARG, "KILL")
		RETURN 0
ENDIF
RETURN 1, 100000 + CPOS(FLAG:행동순1)

;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_AW_1602, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격/마법위력/명중", -4, "短縮"

