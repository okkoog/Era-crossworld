;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_1007,ARG,ARG:1
#DIM LCOUNT
;味方の行動でないと誘発しない
SIF !IS_FRIEND(ARG, FLAG:행동순1)
	RETURN 0
;対象が敵でないと誘発しない
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
;攻撃が成功している
SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1,"BADSTATE", "HAPPY/CHARM/PANIC/SLEEP")
	RETURN 0
CALL SKILLGAGE_F_ADD, ARG, [[스킬:각성스킬]], 1
SIF SKILLGAGE_F_GET(ARG, [[스킬:각성스킬]]) > 1
	RETURN 0
RETURN 1, CFLAG:ARG:PT플래그 ? 22 # 19

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_1007,ARG,ARG:1, ARG:2
CALL SKILL_SET_カジャンダ, ARG, CFLAG:ARG:PT플래그 ? 22 # 19, "방어", -4 * SKILLGAGE_F_GET(ARG, [[스킬:각성스킬]]), "範囲"
CALL SKILLGAGE_F_SET, ARG, [[스킬:각성스킬]], 0