@SKILL_TURNSTART_AW_1016, ARG
#DIM LCOUNT
#DIM STOCK_ACT
#DIM STOCK_TARGET
#DIM STOCK_ACTOR
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;戦闘中1回までしか発動しない
SIF SKILLGAGE_H_GET(ARG, SKILL_NUM_F("각성스킬")) > 0
	RETURN 0
CALL SKILLGAGE_H_SET, ARG, SKILL_NUM_F("각성스킬"), 1
STOCK_ACT = CFLAG:ARG:입력행동
STOCK_TARGET = CFLAG:ARG:타겟

CFLAG:ARG:입력행동 = SKILL_NUM_F("각성스킬")
CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동

STOCK_ACTOR = FLAG:행동순1
FLAG:행동순1 = ARG

;アクションの実行
CALL PRINT_ACT_MESSAGE, FLAG:행동순1, CFLAG:(FLAG:행동순1):입력행동
CALL BATTLE_ACTSTART, ARG
CALL BATTLE_SKILLEND, ARG
CALL BATTLE_ACTEND, ARG
CFLAG:ARG:입력행동 = STOCK_ACT
CFLAG:ARG:타겟 = STOCK_TARGET
FLAG:행동순1 = STOCK_ACTOR
RETURN 1

;====================================================
;スキル及び行動の実行
