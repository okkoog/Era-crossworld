;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_AW_17,ARG,ARG:1
#DIM LCOUNT
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;味方同士でなければNG
SIF !IS_FRIEND(FLAG:행동순1, ARG)
	RETURN 0
;判定は1回
SIF ARG != ARG:1
	RETURN 0
;ステート回復がトリガー
SIF !GET_CREC_ACT(FLAG:행동순1, , "CURE")
	RETURN 0
RETURN 1, CFLAG:ARG:PT플래그 ? 19 # 22

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_17,ARG,ARG:1, ARG:2
#DIM LCOUNT
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	IF MAXBASE:POS(LCOUNT):마법위력 > MAXBASE:POS(LCOUNT):공격
		IF CFLAG:POS(LCOUNT):타인집중플래그 == 0
			CALL PRINT_HIT_MESSAGE, POS(LCOUNT), "다음 마법공격의 위력 상승！"
			CFLAG:POS(LCOUNT):타인집중플래그 = 1
		ELSE
			CALL PRINT_HIT_MESSAGE, POS(LCOUNT), "효과가 없었다。"
		ENDIF
	ELSE
		IF CFLAG:POS(LCOUNT):타인기합플래그 == 0
			CALL PRINT_HIT_MESSAGE, POS(LCOUNT), "다음 물리공격의 위력 상승！"
			CFLAG:POS(LCOUNT):타인기합플래그 = 1
		ELSE
			CALL PRINT_HIT_MESSAGE, POS(LCOUNT), "효과가 없었다。"
		ENDIF
	ENDIF
NEXT
WAIT

;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_AW_17, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	CASE "MP補正"
		RESULTS = 魔脈
		RETURN 30
ENDSELECT

RETURN 0