@SKILL_ACTIONABLE_BATTLE_AW_758, ARG
RETURN 0

;継承に必要な部位
@SKILL_TURNEND_AW_758, ARG
;死んでいる必要がある
SIF !IS_BADSTATE(ARG, "DYING")
	RETURN 0
;コスト計算
CALL CHECK_COST, ARG, [[스킬:각성스킬]]
SIF !RESULT
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬"), , , , "NOWAIT"

CFLAG:ARG:상태이상 = 0
CFLAG:ARG:상태이상경과턴수 = 0
CALL VAR_HP,ARG,MAXBASE:ARG:ＨＰ

CALL SKILL_SET_カジャンダ, ARG, ARG, "공격/방어/마법위력/명중/회피/마법효과", 8, "단체", , "復活 & 全能力↑↑"

;コスト支払い
CALL PAY_COST, ARG, [[스킬:각성스킬]]

@SKILL_SKILLEND_AW_758,ARG
#DIM LCOUNT
SIF !IS_BADSTATE(ARG, "DYING")
	RETURN 0
SIF !GET_CREC_ACT(, ARG, "KILL")
	RETURN 0
CALL ACTION_AW_758, ARG, , [[스킬:각성스킬]]

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_AW_758,ARG,ARG:1, ARG:2
#DIM LCOUNT
#DIM L_T
IF CFLAG:ARG:PT플래그 > 0
	SETCOLOR COLOR("FRIEND")
ELSE
	SETCOLOR COLOR("ENEMY")
ENDIF

CALL PRINT_ACT_MESSAGE, ARG,  SKILL_NUM_F("각성스킬"), , , , "NOWAIT"
RESETCOLOR
FOR LCOUNT, CFLAG:(ARG):PT플래그 ? 1 # 7, 7 ? 7 # 17
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	CALL SKILL_SET_HPバリア, L_T, MAXBASE:L_T:ＨＰ / 5, "バリア", "非表示"
	CALL HEAL_SINGLE, ARG, L_T, ARG:2, 1, ,"バリア"
NEXT
WAIT

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_AW_758,ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT
