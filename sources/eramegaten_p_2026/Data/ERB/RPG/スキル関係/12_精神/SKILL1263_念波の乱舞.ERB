;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_1263,ARG
RESULTS = 염파의난무

;　명중
@SKILL_HITRATE_1263, ARG
RETURN 90

;　威力
;仕様上,単体相手なら1~3回になるのでダイン相当の320
;上限HIT数に引っかからなければ単体あたりの期待値は240
@SKILL_POWER_1263, ARG
RETURN 160

;最低がここで渋いのは同ランクにあたるマハ系が最大5HITしかできないから
;敵総数の判定を全後列合計にできるという強みもあるので、ここで少し絞っといても総HIT数は割合稼げる…はず
;최저공격횟수
@SKILL_MINATTACKNUMBER_1263,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1263,ARG
RETURN 8

;一体辺りの最大ＨＩＴ数
@SKILL_MAXATK_PER_1263,ARG
RETURN 3

;一体辺りの最低ＨＩＴ数
@SKILL_MINATK_PER_1263,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1263, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1263,ARG
RETURN 18

;　相性
@SKILL_TYPE_1263,ARG
