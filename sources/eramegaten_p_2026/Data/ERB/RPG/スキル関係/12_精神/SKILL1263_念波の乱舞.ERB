@SKILL_ACTIONABLE_FIELD_1263
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1263, ARG = -1
RETURN 7

@SKILL_RANKUP_1263
;ランクアップなし
RETURN 0


