;元ファイナルヌード
; ランダムでアンコール(2回目)できたらな
;210301	NEO		専用スキルとは言えクッソ安い、安すぎるのでコストを増大
;221019	NEO		ARGなかったの修正してコスト計算のやり方修正
;				アンコールするなら消費1.5倍とか必要っすねホント
;				１年半くらいたった今だと「コスト下げつつ効果UP」はクソ強いからやめれ、という感じ

;スキル名
@SKILL_NAME_1261,ARG
RESULTS = Nocturne

;　명중
@SKILL_HITRATE_1261, ARG
RETURN 100

;　威力
@SKILL_POWER_1261, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_1261,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1261,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1261, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1261,ARG
#DIM SKILL1261_COST
	;デカジャが20、ファイナルヌードが18
	;まあデカジャがそもそもクッソ強いので抱き合わせると50程度は消費欲しいんですよね
	SKILL1261_COST = 65
	
	IF ARG == -1
		;なにもしない
	ELSE
		;最低値は45
		SKILL1261_COST -= ABL:ARG:가창기능 * 2
		SIF SKILL1261_COST < 45
			SKILL1261_COST = 45
	ENDIF

	RETURN SKILL1261_COST


;　相性
@SKILL_TYPE_1261,ARG
RETURN GET_TYPE_NUM("정신")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1261
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_1261, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1261, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_1261,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1261,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_1261, ARG
RETURN GET_SKILL_EFFECT_NUM("상태변화")


;계승타입
@SKILL_SUCCESSION_TYPE_1261
RETURN GET_SUCCESSION_NUM("정신")

@継承不能_1261
RETURN 1
;継承不能

;속도보정
@SKILL_SPEED_1261, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1261
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1261, ARG = -1
RETURN 12

;-----------------------------
;- 追加効果処理
;-----------------------------
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_1261,ARG
RETURN GET_STATE_NUM("PALYZE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_1261,ARG
RETURN GET_TYPE_NUM("정신")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_1261,ARG
#DIM SKILL1261_RATE
	SKILL1261_RATE = 45

	IF ARG == -1
		;なにもしない
	ELSE
		SKILL1261_RATE += ABL:ARG:가창기능 *2
	ENDIF
	
	RETURN SKILL1261_RATE

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_1261,ARG
RETURN 95

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_1261, ARG, ARG:1, ARG:2
#LOCALSIZE 4
;コストを支払う
;CALL VAR_MP,ARG,-20


IF ARG:1 == 19
	LOCAL:2 = 1
	LOCAL:3 = 7
ELSE
	LOCAL:2 = 7
	LOCAL:3 = 17
ENDIF

FOR LOCAL,LOCAL:2,LOCAL:3
	SIF POS(LOCAL) < 0
		CONTINUE
	FOR LOCAL:1,0,6
		CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") = MIN(0, CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화"))
	NEXT
NEXT
PRINTFORMW \@ CFLAG:ARG:PT플래그 ? 적 # 아군 \@의 긴장된 마음을 풀어주었다！

CALL FIELD_BADSTATE,ARG,ARG:1,1261
PRINTFORMW 회장에 쾌감의 떨림이 퍼져나간다！


