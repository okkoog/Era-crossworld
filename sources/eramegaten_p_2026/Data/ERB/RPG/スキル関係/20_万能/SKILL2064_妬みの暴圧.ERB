;질투의폭압
;セト用万能ロマっぽいもの
;最大威力1000ですが、通常のンダとは別に弱体がはいるので500まで落ちます
;まぁそれでも強いはずですが
;
;とりあえず、味方版の調整もおいておきますが
;基本的には敵専用です
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2064,ARG
RESULTS = 질투의폭압

;　명중
@SKILL_HITRATE_2064, ARG
RETURN 100

;　威力
@SKILL_POWER_2064, ARG
#LOCALSIZE 2
SIF ARG < 0
	RETURN 1
IF スキル属性表示中
	LOCAL:1 = FLAG:확산플래그
	FLAG:확산플래그 = 現HP割合(ARG)
ENDIF
IF CFLAG:ARG:보스플래그
	SELECTCASE FLAG:확산플래그	;基礎威力200
		CASE IS > 60	;HP60%以上　200 - 360
			LOCAL:0 = 200 + 400 * (100 - FLAG:확산플래그) / 100
		CASE IS > 20	;HP20%以上　440 - 680
			LOCAL:0 = 200 + 600 * (100 - FLAG:확산플래그) / 100
		CASEELSE		;HP20%以下　640 - 1000
			LOCAL:0 = 200 + 800 * (100 - FLAG:확산플래그) / 100
	ENDSELECT
	SIF CFLAG:ARG:마법위력강화 < 0
		LOCAL:0 = LOCAL:0 * MAX(32, 64 + CFLAG:ARG:마법위력강화) / 64	;ダメージ計算時とは別にンダの影響を受ける
ELSE
	SELECTCASE FLAG:확산플래그
		CASE IS > 75
			LOCAL:0 = 1 + 350 * (100 - FLAG:확산플래그) / 100
		CASE IS > 50
			LOCAL:0 = 1 + 450 * (100 - FLAG:확산플래그) / 100
		CASE IS > 5
			LOCAL:0 = 1 + 600 * (100 - FLAG:확산플래그) / 100
		CASEELSE
			LOCAL:0 = 1 + 750 * (100 - FLAG:확산플래그) / 100
	ENDSELECT
ENDIF
SIF スキル属性表示中
	FLAG:확산플래그 = LOCAL:1
RETURN LOCAL:0


