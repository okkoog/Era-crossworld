;アバチュボス勢に大人気スキル……まぁ味方ではまじつかわないんですがこれ
;スキル名
@SKILL_NAME_2066,ARG
RESULTS = 색즉시공

;　명중
@SKILL_HITRATE_2066, ARG
RETURN 100

;　威力
@SKILL_POWER_2066, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2066,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2066,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2066, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2066,ARG
RETURN 35

;　相性
@SKILL_TYPE_2066,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2066
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2066, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2066,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2066,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2066, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2066
RETURN GET_SUCCESSION_NUM("만능")

;속도보정
@SKILL_SPEED_2066, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2066
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2066, ARG = -1
RETURN 15

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2066,ARG
A = RAND:11
IF A == 0
	RETURN GET_STATE_NUM("HAPPY")
ELSEIF A == 1
	RETURN GET_STATE_NUM("CHARM")
ELSEIF A == 2
	RETURN GET_STATE_NUM("PANIC")
ELSEIF A == 3
	RETURN GET_STATE_NUM("SLEEP")
ELSEIF A == 4
	RETURN GET_STATE_NUM("BIND")
ELSEIF A == 5
	RETURN GET_STATE_NUM("CLOSE")
ELSEIF A == 6
	RETURN GET_STATE_NUM("POISON")
ELSEIF A == 7
	RETURN GET_STATE_NUM("BOMB")
ELSEIF A == 8
	RETURN GET_STATE_NUM("PALYZE")
ELSEIF A == 9
	RETURN GET_STATE_NUM("SHOCK")
ELSE
	RETURN GET_STATE_NUM("FREEZE")
ENDIF

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2066,ARG
SIF ARG >= 0 && CFLAG:ARG:보스플래그 > 0 && 0 == RAND:2
	RETURN 17
IF A < 4
	RETURN GET_TYPE_NUM("정신")
ELSEIF A < 9
	RETURN GET_TYPE_NUM("신경")
ELSEIF A == 9
	RETURN GET_TYPE_NUM("전격")
ELSE
	RETURN GET_TYPE_NUM("빙결")
ENDIF

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2066,ARG
RETURN 50

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2066,ARG
RETURN 95

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2066, ARG, ARG:1, ARG:2
#LOCALSIZE 1
FOR LOCAL, CFLAG:ARG:PT플래그 ? 7 # 1, CFLAG:ARG:PT플래그 ? 17 # 7
	SIF POS(LOCAL) < 0
		CONTINUE
	SIF GET_STATE(CFLAG:POS(LOCAL):상태이상) == "DYING"
		CONTINUE
	CALL SINGLE_BADSTATE, ARG, POS(LOCAL), 2066
NEXT





;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2066, ARG
PRINTL 적 전체에 만능 상성으로 랜덤으로 상태이상




