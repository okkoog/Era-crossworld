;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2055,ARG
RESULTS = 물고늘어지기

;　명중
@SKILL_HITRATE_2055, ARG
RETURN 90

;　威力
@SKILL_POWER_2055, ARG
RETURN 50

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2055,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2055,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2055, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2055,ARG
RETURN 2

;　相性
@SKILL_TYPE_2055,ARG
SIF ARG >= 0 && CFLAG:ARG:어택커 >= 0
	RETURN CFLAG:ARG:어택커
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2055
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2055, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2055, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2055,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2055,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2055, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_2055
RETURN GET_SUCCESSION_NUM("만능")

;속도보정
@SKILL_SPEED_2055, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2055
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2055, ARG = -1
RETURN 0




;ハントスキル倍率
@ハントスキル_2055
RETURN 150
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2055, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,2055






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2055, ARG
PRINTL 적 １체에 물고늘어져 공격하는 헌트스킬



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2055,ARG
SIF TALENT:ARG:식노
	RETURN 1
RETURN 0

