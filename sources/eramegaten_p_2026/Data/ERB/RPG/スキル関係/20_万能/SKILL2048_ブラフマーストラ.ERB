;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2048,ARG
RESULTS = 브라흐마스트라

;　명중
@SKILL_HITRATE_2048, ARG
SIF SKILL_CHANGE(ARG, [[キャラ:브라흐마]]) && CFLAG:ARG:보스플래그 && FLAG:현던전 == 13
	RETURN 150
RETURN 90

;　威力
@SKILL_POWER_2048, ARG
SIF SKILL_CHANGE(ARG, [[キャラ:브라흐마]]) && CFLAG:ARG:보스플래그 && FLAG:현던전 == 13
	RETURN 600 - (200 * FLAG:확산플래그)
SIF FLAG:확산플래그
	RETURN 900 / (2+FLAG:확산플래그)
RETURN 465

;高クリティカル
@SKILL_CRITICAL_RATE_2048, ARG
RETURN 25

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2048,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2048,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2048, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2048,ARG
RETURN 35

;　相性
@SKILL_TYPE_2048,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2048
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2048, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2048, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2048,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2048,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2048, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2048
RETURN GET_SUCCESSION_NUM("만능")

;속도보정
@SKILL_SPEED_2048, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2048
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2048, ARG = -1
RETURN 13



;拡散攻撃用追加処理
@SKILL_SPREAD_2048,ARG
RETURN 3
;拡散距離:1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2048, ARG, ARG:1, ARG:2
CALL ATTACK_SPREAD,ARG,ARG:1,2048



