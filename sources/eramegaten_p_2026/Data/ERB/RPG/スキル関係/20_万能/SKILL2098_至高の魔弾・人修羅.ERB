;悪魔用に新規作成
;スキル名
@SKILL_NAME_2098,ARG
RESULTS = 지고의마탄・인수라

;　명중
@SKILL_HITRATE_2098, ARG
SIF ARG == -1
	RETURN 150
SIF CFLAG:ARG:보스플래그
	RETURN 300
RETURN 150

;　威力
@SKILL_POWER_2098, ARG
SIF ARG == -1
	RETURN 640
SIF CFLAG:ARG:보스플래그
	RETURN 1280
RETURN 640

;クリティカル率
@SKILL_CRITICAL_RATE_2098, ARG
RETURN 10

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2098,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2098,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2098, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2098,ARG
RETURN 50

;　相性
@SKILL_TYPE_2098,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2098
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2098, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2098, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2098,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2098,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2098, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2098
RETURN GET_SUCCESSION_NUM("만능")

@継承不能_2098
RETURN 1

;속도보정
@SKILL_SPEED_2098, ARG = -1
RETURN 2


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2098
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2098, ARG = -1
RETURN 20

@SKILL_RANKUP_2098
;ランクアップ先は二つ
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2098, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,2098






