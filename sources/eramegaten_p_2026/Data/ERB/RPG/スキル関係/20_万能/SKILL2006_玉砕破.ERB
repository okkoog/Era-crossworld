;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2006,ARG
IF SKILL_CHANGE(ARG, [[キャラ:E졸다트]])
	RESULTS = Blitz bombe
ELSE
	RESULTS = 옥쇄파
ENDIF

;　명중
@SKILL_HITRATE_2006, ARG
RETURN 140

;　威力
@SKILL_POWER_2006, ARG
IF ARG >= 0 && HAVE_AW_SKILL(ARG, "悪しき鳥")
	RETURN 550
ELSE
	RETURN 500
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2006,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2006,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2006, ARG
SIF ARG >= 0 && HAVE_AW_SKILL(ARG, "悪しき鳥")
	RETURN 3
RETURN 1
;消費なし＝1

;　コストの量
@SKILL_COST_2006,ARG
SIF ARG >= 0 && HAVE_AW_SKILL(ARG, "悪しき鳥")
	RETURN 20
RETURN 5

;　相性
@SKILL_TYPE_2006,ARG
IF SKILL_CHANGE(ARG, [[キャラ:E졸다트]])
	RETURN 6
ELSE
	RETURN 17
ENDIF
;만능

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2006
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

@SKILL_ATTACKTYPE_2006, ARG
RETURN GET_攻撃タイプ_NUM("物理")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2006, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2006, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2006,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2006,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2006, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2006
RETURN GET_SUCCESSION_NUM("만능")
;속도보정
@SKILL_SPEED_2006, ARG = -1
RETURN -5

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2006
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2006, ARG = -1
RETURN 8


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2006, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,2006

IF HAVE_AW_SKILL(ARG, "悪しき鳥")
	CALL PRINT_HIT_MESSAGE, ARG, @"{MAXBASE:ARG:ＨＰ / 2}데미지", "W"
	CALL VAR_HP,ARG,-MAXBASE:ARG:ＨＰ / 2,"食いしばり無効ダメージ"
ELSE
	SIF CFLAG:ARG:상태이상 < GET_STATE_NUM("DYING")
		CALL VAR_HP,ARG,-MAXBASE:ARG:ＨＰ,"食いしばり無効ダメージ"
ENDIF


;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2006, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:E졸다트]]
PRINTL 전광기관을 통해 생명력을 변환해 목숨과 맞바꿔 적 전체에 전격 데미지
PRINTL 옥쇄파의 E졸다트 전용화 스킬
ELSE
PRINTL 목숨과 맞바꿔 적 전체에 만능 데미지。
ENDIF



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2006,ARG
RETURN 1
;とくにない

