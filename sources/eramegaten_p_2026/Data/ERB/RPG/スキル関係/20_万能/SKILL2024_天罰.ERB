;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2024, ARG, ARG:1, ARG:2
FOR LOCAL, 1, 17
	SIF POS(LOCAL) < 0 || GET_STATE(CFLAG:POS(LOCAL):상태이상) == "DYING"
		CONTINUE
	SIF ABL:ARG:속성LC == ABL:POS(LOCAL):속성LC
		CONTINUE
	CALL ATTACK_SINGLE,ARG,POS(LOCAL),2024
NEXT
