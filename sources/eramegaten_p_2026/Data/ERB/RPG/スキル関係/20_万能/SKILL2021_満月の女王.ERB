;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2021,ARG
RESULTS = 만월의여왕

;　명중
@SKILL_HITRATE_2021, ARG
RETURN 100

;　威力
@SKILL_POWER_2021, ARG = -1
;ボス版は威力調整をする
IF ARG >= 0 && CFLAG:ARG:보스플래그
	SELECTCASE FLAG:월령
		CASE 8
			RETURN 700
		CASE 1 TO 7
			RETURN 320
		CASEELSE
			RETURN 160
	ENDSELECT
ELSE
	SELECTCASE FLAG:월령
		CASE 8
			RETURN 410
		CASE 1 TO 7
			RETURN 130
		CASEELSE
			RETURN 1
	ENDSELECT
ENDIF
RETURN 1

