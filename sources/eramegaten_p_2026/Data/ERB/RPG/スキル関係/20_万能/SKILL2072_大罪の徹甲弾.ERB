;-------------------------------------------------------------------------------
; [メモ]
; Ｐ５だとイベント技だったので性能を大幅に捏造
; 攻撃の直前に対象のバフを全解除＋解除した種類に応じて威力上昇
; 基礎攻撃力５００（螺旋の蛇と同値）～最大値７４０
; 能動的に威力を上げられない分、人修羅至高の魔弾を超える威力に設定
; 使えるようになるまでローカパーラ_宇宙の卵までクリアして上位陥落しないとだし燃費も極悪なので許されるかと
;-------------------------------------------------------------------------------

;スキル名
@SKILL_NAME_2072,ARG
RESULTS = 대죄의철갑탄

;　명중
@SKILL_HITRATE_2072, ARG
RETURN 160

;　威力
@SKILL_POWER_2072, ARG
#LOCALSIZE 1
;解除したバフ一つにつき威力40上昇、全解除すると240上昇
LOCAL = 500 + (TFLAG:스킬용1 * 40)
RETURN LOCAL

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2072,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2072,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2072, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2072,ARG
;最大威力740かつ複合属性 素質補正で0.8倍されるので高めにしておこう
;参考：コストと威力
;コスト80帯:랜더마이저/라스타캔디/지하드/질투의폭압/四大召喚とか
;퓨프리레게돈(威力800):70/열조(威力800):42/슈퍼노바(威力800):35
RETURN 100

;　相性
@SKILL_TYPE_2072,ARG
RETURN GET_TYPE_NUM("만능"), GET_TYPE_NUM("주살"), GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2072
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2072, ARG
;明らかに実弾なんで
RETURN 1

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2072, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2072,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2072,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2072, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2072
RETURN GET_SUCCESSION_NUM("만능")

;속도보정
@SKILL_SPEED_2072, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2072
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2072, ARG = -1
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2072, ARG, ARG:1, ARG:2
#LOCALSIZE 1

;念のため初期化
TFLAG:스킬용1 = 0

FOR LOCAL,0,6
	IF CFLAG:POS(ARG:1):(GET_BATTLESTATUS(LOCAL) + "강화") > 0
		CFLAG:POS(ARG:1):(GET_BATTLESTATUS(LOCAL) + "강화") = 0
		TFLAG:스킬용1 += 1
	ENDIF
NEXT

LOCAL = POS(ARG:1)

;こうしないとターゲット選択の説明文表示でもこのメッセージが出ちゃうんすよ
CALL SKILL_TYPE_2072, ARG
SELECTCASE RESULT
	CASE 1
		PRINT 비구
	CASE 11
		PRINT 주살
	CASE 17
		PRINT 만능
ENDSELECT
PRINT 의 마탄이 
IF TFLAG:스킬용1 > 0
	PRINTL 적의 가호를 뚫어 파괴했다！
ELSE
	PRINTL 방출되었다！
ENDIF

CALL ATTACK_SINGLE,ARG,LOCAL,2072

TFLAG:스킬용1 = 0

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2072, ARG
PRINTL 위대한 타천사가 모은 칠대죄를 정련하여 만든、반역의 총탄。
PRINTL 모든 가호를 꿰뚫고、조물주조차도 뚫는다。
PRINTL 적 １체의 강화를 전부 해제하고、만능+비구+주살 상성의 특대 데미지를 준다。
PRINTL 해제한 강화가 많을수록 위력이 늘어난다。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2072,ARG
RETURN 1
;とくにない

