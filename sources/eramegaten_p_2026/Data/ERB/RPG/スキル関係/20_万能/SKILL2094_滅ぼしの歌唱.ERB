;20220204	NEO		本来は「ボンバーガール」のメガテンナイズスキルだが
;					入手が難しいわりにメギドラオンのほぼほぼ完全下位互換だったので相互互換くらいの強さに
;					（パッチで入手性を強化したが）
;					命中100→120に変更
;					消費を「가창기능×4+10」で「10～50」に変更
;					威力を「가창기능×30＋100」で、威力100～400
;					さらに「가창기능×5」％でさらに威力が上昇（+100）
;					ランダム性が高いが、メギドラオンが消費60全体攻撃威力420、こちらが消費50列攻撃威力450（期待値）で、ンまあ……

;スキル名
@SKILL_NAME_2094,ARG
RESULTS = 멸망의가창

;　명중
@SKILL_HITRATE_2094, ARG
RETURN 120

;　威力
@SKILL_POWER_2094, ARG
	SIF ARG == -1
		RETURN 100

	LOCAL = 100 + MIN((ABL:ARG:가창기능) * 30, 300)
	;가창기능×5％（最大50％）で威力が上昇
	SIF RAND:100 < MIN((ABL:ARG:가창기능) * 5, 50)
		LOCAL += 100

	RETURN LOCAL

	;おまじない
	RETURN 100

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2094,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2094,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2094, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2094,ARG
SIF ARG == -1
	RETURN 8

	;消費は10～50
	LOCAL = 10 + MIN((ABL:ARG:가창기능) * 4, 40)
	RETURN LOCAL

IF ABL:ARG:가창기능 == 0
	RETURN 8
ELSEIF ABL:ARG:가창기능 == 1
	RETURN 12
ELSEIF ABL:ARG:가창기능 == 2
	RETURN 15
ELSEIF ABL:ARG:가창기능 == 3
	RETURN 19
ELSEIF ABL:ARG:가창기능 == 4
	RETURN 23
ELSEIF ABL:ARG:가창기능 == 5
	RETURN 24
ELSEIF ABL:ARG:가창기능 == 6
	RETURN 29
ELSEIF ABL:ARG:가창기능 == 7
	RETURN 33
ELSEIF ABL:ARG:가창기능 == 8
	RETURN 39
ELSEIF ABL:ARG:가창기능 == 9
	RETURN 45
ELSE
	RETURN 51
ENDIF
RETURN 8

;　相性
@SKILL_TYPE_2094,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2094
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2094, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2094, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2094,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2094,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2094, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2094
RETURN GET_SUCCESSION_NUM("만능")

;속도보정
@SKILL_SPEED_2094, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2094
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2094, ARG = -1
RETURN 9


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2094, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,2094





