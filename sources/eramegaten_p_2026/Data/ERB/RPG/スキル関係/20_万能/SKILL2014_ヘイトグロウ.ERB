;　威力
@SKILL_POWER_2014, ARG
#LOCALSIZE 3
SIF ARG < 0 || スキル属性表示中
	RETURN 500
SIF CFLAG:ARG:타겟 == 19
	RETURN 500
SIF !INRANGE(CFLAG:ARG:타겟, 1, 16)
	RETURN 500
LOCAL = POS(CFLAG:ARG:타겟)
SIF LOCAL == -1
	RETURN 500
LOCAL:1 = MAXBASE:LOCAL:파마 == 999 ? -200 # MAXBASE:LOCAL:파마
;念のため
SIF LOCAL:1 == 0
	RETURN 500
	
LOCAL:2 = 500 - (LOCAL:1 * 5 / 2)
LOCAL:2 = LOCAL:2 < 10 ? 10 # LOCAL:2
RETURN LOCAL:2

