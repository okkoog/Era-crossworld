;　コストの量
@SKILL_COST_2028,ARG
RETURN 60

;　相性
@SKILL_TYPE_2028,ARG
SIF ARG < 0 || スキル属性表示中
	RETURN GET_TYPE_NUM("不定")
RETURN RAND:13 + 4
;ランダム

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2028
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2028, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2028, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2028,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2028,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2028, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2028
RETURN GET_SUCCESSION_NUM("만능")
@継承不能_2028
RETURN 1

