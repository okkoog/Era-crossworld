;002	2022/02/12		kamedakeisuke(ﾟдﾟ)			環境の変化に合わせ基礎威力を320から350へ上昇、説明文追記

;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2030,ARG
RESULTS = 시간의수레바퀴

;　명중
@SKILL_HITRATE_2030, ARG
RETURN 100

;　威力
@SKILL_POWER_2030, ARG
RETURN 350 * (8 + TFLAG:시간의수레바퀴) / 8

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2030,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2030,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2030, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2030,ARG
RETURN 60

;　相性
@SKILL_TYPE_2030,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2030
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2030, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2030, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2030,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2030,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2030, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2030
RETURN GET_SUCCESSION_NUM("만능")

@継承不能_2030
RETURN 1

;속도보정
@SKILL_SPEED_2030, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2030
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2030, ARG = -1
RETURN 15


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2030, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,2030
SIF TFLAG:시간의수레바퀴 < 8
	TFLAG:시간의수레바퀴 += 1

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2030, ARG
PRINTL 시간의 수레바퀴를 서서히 어긋내、적 전체에 만능 상성의 대～초특대 데미지
PRINTL 위력은『해당 전투중、【시간의수레바퀴】를 사용할 때』마다 상승한다



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2030,ARG
RETURN 1
;とくにない

