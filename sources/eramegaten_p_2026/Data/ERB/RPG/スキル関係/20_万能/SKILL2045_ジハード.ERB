;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_2045, ARG, ARG:1, ARG:2
#DIMS TEMPS, 2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
IF CFLAG:ARG:PT플래그
	TEMPS = %RAND_SPLIT("공격_방어_마법효과_마법위력_명중_회피", "_")%
	DO
		TEMPS:1 = %RAND_SPLIT("공격_방어_마법효과_마법위력_명중_회피", "_")%
	LOOP TEMPS == TEMPS:1
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, TEMPS + "_" + TEMPS:1, -4, "短縮"
ELSE
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격_방어_마법효과_마법위력_명중_회피", -4, "短縮"
ENDIF
