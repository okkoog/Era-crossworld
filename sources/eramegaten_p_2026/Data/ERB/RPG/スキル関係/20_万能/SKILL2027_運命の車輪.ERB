;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2027, ARG, ARG:1, ARG:2
;CALL PAY_COST, ARG, 2027
FOR LOCAL,1,17
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0 || FLAG:LOCALS == ARG || CFLAG:(FLAG:LOCALS):보스플래그
		CONTINUE
	SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
		CONTINUE
	RESULT = 0
	CALL GET_SKILL_PROP, "SKILL_DECIDE_TYPE", CFLAG:(FLAG:LOCALS):입력행동
	IF RESULT == 2
		PRINTFORM 　　TARGET:[{CPOS(FLAG:LOCALS),2}] %CALLNAME:(FLAG:LOCALS),20,LEFT%　>>>>>>　행동이 봉쇄되었다！
		CFLAG:(FLAG:LOCALS):입력행동 = -1
	ENDIF
NEXT



