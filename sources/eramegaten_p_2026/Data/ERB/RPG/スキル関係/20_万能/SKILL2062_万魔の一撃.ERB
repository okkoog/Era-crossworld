;-------------------------------------------------------------------------------
; [メモ]
; 物理依存の単体メギドラオン。威力は控えめ、その代わり高命中、ローコスト
; 螺旋の蛇と違って汎用スキル扱い。カード化や継承が可能。性能は下位互換
;-------------------------------------------------------------------------------

;スキル名
@SKILL_NAME_2062,ARG
RESULTS = 만마의일격


;　명중
@SKILL_HITRATE_2062, ARG
RETURN 100

;　威力
@SKILL_POWER_2062, ARG
RETURN 420

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2062,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2062,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2062, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2062,ARG
RETURN 34

;　相性
@SKILL_TYPE_2062,ARG
RETURN GET_TYPE_NUM("만능")


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2062
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2062, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2062, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2062,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2062,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2062, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2062
RETURN GET_SUCCESSION_NUM("만능")

;속도보정
@SKILL_SPEED_2062, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2062
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2062, ARG = -1
RETURN 13



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2062, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,2062





;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2062, ARG
PRINTL 적 １체에、모든 방호를 관통하는 신의 불꽃을 머금은 일격을 날린다
PRINTL 만능 상성의 특대 데미지。물리의존、후열 사용 가능



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2062,ARG
RETURN 1
;とくにない

