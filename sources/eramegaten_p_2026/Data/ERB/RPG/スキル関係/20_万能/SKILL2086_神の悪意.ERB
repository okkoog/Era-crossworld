;サマエル専用
;真3では万能属性で状態異常は対応した耐性があれば防げる。よくわからない。
;とりあえず追加効果相性を神経精神ランダムにしといた。
;ダメージないし追加効果付与率高い。ファイナルヌードと同じ。

;スキル名
@SKILL_NAME_2086,ARG
RESULTS = 신의악의

;　명중
@SKILL_HITRATE_2086, ARG
RETURN 100

;　威力
@SKILL_POWER_2086, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2086,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2086,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2086, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2086,ARG
RETURN 30

;　相性
@SKILL_TYPE_2086,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2086
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2086, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2086, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2086,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2086,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2086, ARG
RETURN GET_SKILL_EFFECT_NUM("상태변화")


;계승타입
@SKILL_SUCCESSION_TYPE_2086
RETURN GET_SUCCESSION_NUM("만능")
@継承不能_2086
RETURN 1
;不可

;속도보정
@SKILL_SPEED_2086, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2086
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2086, ARG = -1
RETURN 23
;変化不能

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2086,ARG
A = RAND:6
IF A == 0
	RETURN GET_STATE_NUM("CHARM")
ELSEIF A == 1
	RETURN GET_STATE_NUM("PANIC")
ELSEIF A == 2
	RETURN GET_STATE_NUM("SLEEP")
ELSEIF A == 3
	RETURN GET_STATE_NUM("BIND")
ELSEIF A == 4
	RETURN GET_STATE_NUM("CLOSE")
ELSE
	RETURN GET_STATE_NUM("PALYZE")
ENDIF

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2086,ARG
IF A < 3
	RETURN 9
ELSE
	RETURN 8
ENDIF
RETURN 8

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2086,ARG
RETURN 80

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2086,ARG
RETURN 95

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2086, ARG, ARG:1, ARG:2
CALL FIELD_BADSTATE,ARG,ARG:1,2086






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2086, ARG
PRINTL 적 전체에 랜덤한 상태이상을 부여한다





;使用条件
@SKILL_SPECIAL_ACTIONABLE_2086,ARG
RETURN 1
;とくにない

