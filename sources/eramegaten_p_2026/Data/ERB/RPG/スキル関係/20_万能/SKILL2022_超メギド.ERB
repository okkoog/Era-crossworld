;スキル名
@SKILL_NAME_2022,ARG
RESULTS = 초메기도

;　명중
@SKILL_HITRATE_2022, ARG
RETURN 100

;　威力
@SKILL_POWER_2022, ARG
SIF ARG < 0
	RETURN 70
SIF スキル属性表示中
	RETURN MAX(BASE:ARG:ＭＰ * 2 + 70, 1)
RETURN MAX(FLAG:확산플래그 - 10,1)

