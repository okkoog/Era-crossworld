;-------------------------------------------------
;COOP連動スキルの判定
;戻り値は発動率。また、COOP連動効果は常にひとつしか発動しない。
;-------------------------------------------------
@SKILL_JUDGE_EXTRA_COOP_5061, L_CHARA, L_OPT = "参加"
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_OPT;参加or発動
SIF L_OPT != "参加"
	RETURN 0
RETURN 25

@SKILL_ACTION_EXTRA_COOP_5061, L_CHARA
#DIM DYNAMIC L_CHARA
CALL ATTACK_SKILL, L_CHARA, 22, 5061


