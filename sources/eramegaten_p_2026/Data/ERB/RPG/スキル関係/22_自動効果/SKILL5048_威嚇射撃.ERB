@SKILL_TRIGGER_ACTIONABLE_5048, ARG, ARG:1
#DIM L_CNT
SIF !IS_FRIEND(ARG, ARG:1)
	RETURN 0
SIF GETS_ROLE_PROP("INSTALLSOFT_EFFECT_TYPE", ARG:1) != "悪魔"
	RETURN 0
SIF CFLAG:(ARG:1):방어플래그
	RETURN 0
;弱点ORクリティカル
SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "CRIT/WEAK")
	RETURN 0
;攻撃してきた相手を対象にする
RETURN 1, CPOS(FLAG:행동순1)
