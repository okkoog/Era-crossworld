;-------------------------------------------------
;COOP連動スキルの判定
;戻り値は発動率。また、COOP連動効果は常にひとつしか発動しない。
;-------------------------------------------------
@SKILL_JUDGE_EXTRA_COOP_5060, L_CHARA, L_OPT = "参加"
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_OPT;参加or発動
SIF L_OPT != "参加"
	RETURN 0
RETURN 100

@SKILL_ACTION_EXTRA_COOP_5060, L_CHARA
#DIM LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC MP_DAMAGE
#DIM DYNAMIC SUM_MP_DAMAGE
FOR LCOUNT, GET_POS_MIN(22), GET_POS_MAX(22) + 1
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	MP_DAMAGE = MIN(MAXBASE:POS(LCOUNT):ＭＰ * 5 / 100  * TFLAG:COOP위력 / 100, BASE:POS(LCOUNT):ＭＰ,9999)
	CALL PRINT_HIT_MESSAGE, POS(LCOUNT), @"ＭＰ:{MP_DAMAGE, 4}데미지"
	CALL VAR_MP, POS(LCOUNT), -MP_DAMAGE
	SUM_MP_DAMAGE += MP_DAMAGE
NEXT
;総吸収量の半分かつ上限が最大MPの5%
SUM_MP_DAMAGE = MIN(SUM_MP_DAMAGE / 2, MAXBASE:L_CHARA:ＭＰ * 5 / 100)
CALL PRINT_HIT_MESSAGE, L_CHARA, @"ＭＰ:{SUM_MP_DAMAGE, 4}회복"
CALL VAR_MP, L_CHARA, SUM_MP_DAMAGE
WAIT


