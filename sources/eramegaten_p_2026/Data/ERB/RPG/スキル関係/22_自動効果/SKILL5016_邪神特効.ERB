;===========================
;●種族特効シリーズ
;===========================
;メモについては5000.人間特効を参照のこと
;===========================

;スキル名
@SKILL_NAME_5016,ARG
	RESULTS = 사신특효

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_5016
	;どちらでもない
	RETURN 0

;　効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_5016, ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

;계승타입
@SKILL_SUCCESSION_TYPE_5016
	;継承タイプが23なら無条件で継承不可……のはず
	RETURN 23

;スキル変化？用ランク
@SKILL_RANK_5016, ARG = -1
	RETURN 15

@継承不能_5016
	;継承不可
	RETURN 1

@SKILL_RANKUP_5016
	;変化不可
	RETURN 0

;説明文の表示
@SKILL_EXPLAIN_5016, ARG
	PRINTL 자동：사신邪神에게 주는 데미지가 20％ 증가한다。

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_5016, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM TOTAL_DMG_B
;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			SIF !GROUPMATCH(GET_RACE(ABL:L_TARGET:종족), "사신")
				RETURN 0
			RESULTS = 種族特効
			RETURN 20
	ENDSELECT
ENDIF
@SKILL_ACTIONABLE_BATTLE_5016, ARG
	;自動スキルな
	RETURN 0

