;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_2485,ARG,ARG:1
;自分じゃなければNG
SIF FLAG:행동순1 != ARG
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
;クリティカルを受けているキャラを探す
SIF !GET_CREC_ACT(ARG, , "CRT")
	RETURN 0
;50%
SIF RAND:2
	RETURN 0
RETURN 1

