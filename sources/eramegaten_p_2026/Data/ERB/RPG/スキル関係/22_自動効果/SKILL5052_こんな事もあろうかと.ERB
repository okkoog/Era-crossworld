;変化不可


;　 説明文の表示
@SKILL_EXPLAIN_5052, ARG
PRINTL 자동：전투 중 ３회까지、전투 중에 아이템을 사용해 남은 개수가 ０이 될 경우 이하의 연동효과가 발동한다。
PRINTL 　　　「스톡을 １개 소비하고、보유 아이템을 １개 증가시킨다。」

@SKILL_ACTIONABLE_BATTLE_5052, ARG
RETURN 0

@継承不能_5052
RETURN 1



@ACTION_5052, ARG, ARG:1, ARG:2
PRINTFORMW %ARG는% 미리 챙겨온 아이템을 소지품에 더했다!
COUNT_STOCK_ITEM:SKILLGAGE_F_GET(ARG, 5052) -= 1
ITEM:SKILLGAGE_F_GET(ARG, 5052) += 1
CALL SKILLGAGE_H_ADD, ARG, 5052, 1

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_5052,ARG,ARG:1
#DIM DYNAMIC L_ITEMNUM
;自分の時だけ判定
SIF ARG != ARG:1
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_IS_ITEMSKILL", CFLAG:ARG:입력행동, ARG
SIF !RESULT
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_COSTTYPE", CFLAG:ARG:입력행동, ARG
SIF SKILLGAGE_H_GET(ARG, 5052) > 2
	RETURN 0
SIF RESULT != GET_SKILL_COST_TYPE_NUM("アイテム")
	RETURN 0
SIF ITEM:CONVERT_SKILLNUM_TO_USEITEMNUM(CFLAG:ARG:입력행동) > 0
	RETURN 0
SIF COUNT_STOCK_ITEM:CONVERT_SKILLNUM_TO_USEITEMNUM(CFLAG:ARG:입력행동) == 0
	RETURN 0
CALL SKILLGAGE_F_SET, ARG, 5052, CONVERT_SKILLNUM_TO_USEITEMNUM(CFLAG:ARG:입력행동)
RETURN 1, 23

;使用条件
@SKILL_SPECIAL_ACTIONABLE_5052,ARG
SIF SKILLGAGE_F_GET(ARG, 5052) <= 0
	RETURN 0
SIF COUNT_STOCK_ITEM:SKILLGAGE_F_GET(ARG, 5052) == 0
	RETURN 0
RETURN 1
