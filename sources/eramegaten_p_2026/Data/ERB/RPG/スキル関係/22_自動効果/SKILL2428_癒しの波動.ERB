@SKILL_BATTLE_END_2428, ARG
#DIM DYNAMIC LCOUNT
SIF IS_BADSTATE(ARG, "DYING")
	RETURN 0
FOR LCOUNT, 1, 7
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	CALL VAR_HP, POS(LCOUNT), MAX(MAXBASE:POS(LCOUNT):ＨＰ / 5, 1), "회복"
NEXT
