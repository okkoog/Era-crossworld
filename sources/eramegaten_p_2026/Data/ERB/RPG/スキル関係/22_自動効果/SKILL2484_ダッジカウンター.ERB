;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
;====================================================
@SKILL_COUNTER_ACTIONABLE_2484,ARG,ARG:1
;SIF !GETBIT(CFLAG:ARG:受けフラグ,18) && !GETBIT(CFLAG:ARG:受けフラグ,19)
;SIF !RECEIVE_CHECK(ARG,"物理") && !RECEIVE_CHECK(ARG,"魔法")
;攻撃を回避していたら
SIF !GET_CREC_ACT(ARG:1, ARG, "AVOID")
	RETURN 0
;攻撃に当たってしまっている場合は発動しない
SIF GET_CREC_ACT(ARG:1, ARG, "HIT/BLOCK/DRAIN")
	RETURN 0
;50%の確率
SIF !RAND:2
	RETURN 0
RETURN 1, CPOS(ARG:1)

