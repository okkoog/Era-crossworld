;SIF !RAND:2
;	RETURN 0
;RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_2484, ARG, ARG:1, ARG:2
TFLAG:필중 = 1
TFLAG:반사0데미지화 = 1
TFLAG:흡수0데미지화 = 1
CALL ATTACK_SINGLE, ARG, POS(ARG:1), 2484
TFLAG:필중 = 0
TFLAG:반사0데미지화 = 0
TFLAG:흡수0데미지화 = 0

