;基本ペルソナ使い及び達人専用
;スキル名
@SKILL_NAME_2450,ARG
IF SKILL_CHANGE(ARG, [[キャラ:링고_소울해커즈2]])
	RESULTS = 剣撃適性
ELSE
	RESULTS = 검격부스터
ENDIF

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2450, ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

;계승타입
@SKILL_SUCCESSION_TYPE_2450
RETURN GET_SUCCESSION_NUM("자동효과")

@継承不能_2450
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_2450, ARG = -1
RETURN 0

;　 説明文の表示
@SKILL_EXPLAIN_2450, ARG
PRINTL 자동：검격 속성으로 주는 데미지가 25% 증가한다。

@SKILL_ACTIONABLE_BATTLE_2450, ARG
RETURN 0

;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_2450, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	CASE "属性ブースタ"
		RESULTS '= "검격"
ENDSELECT