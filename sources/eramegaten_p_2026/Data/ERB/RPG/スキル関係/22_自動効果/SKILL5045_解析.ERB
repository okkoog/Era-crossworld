;戦闘開始時に行う処理
@SKILL_TURNTOP_5045, ARG
#DIM LCOUNT
#DIM L_ENEMY
#DIMS L_TABLE
#DIM L_RAND
#DIM L_VAR
#DIM L_DIFFICULTTY
SIF FLAG:경과턴수
	RETURN 0
SIF FLAG:악마해석률상승불가플래그
	RETURN 0
;発動率25%
;SIF RAND:100 > 24
;	RETURN 0
L_TABLE = 
;解析できる敵を確認してテーブルに入れる
FOR LCOUNT, 7, 17
	L_ENEMY = POS(LCOUNT)
	SIF L_ENEMY < 0
		CONTINUE
	SIF ANALYSIS_RATE:(NO:L_ENEMY) >= ANALYSIS_COMPLETED
		CONTINUE
	L_TABLE = %ADD_SPLIT(L_TABLE, "/", TOSTR(L_ENEMY))%
NEXT
SIF L_TABLE == ""
	RETURN 0
;メッセージを出して、解析開始
;性能自体はサマナーLv5のHiDASに準じる
CALL PRINT_ACT_MESSAGE, ARG, 5045

L_ENEMY = TOINT(RAND_SPLIT(L_TABLE, "/"))
CALL ACTION_SKILL_ANALYZE, L_ENEMY

;解析率の表示
;PRINTFORML Analyzed \@FLAG:(20000+NO:L_ENEMY) >= 1000 ? COMPLETE! # {FLAG:(20000+NO:L_ENEMY)/10}％ \@
;WAIT
@SKILL_ACTIONABLE_BATTLE_5045, ARG
RETURN 0
