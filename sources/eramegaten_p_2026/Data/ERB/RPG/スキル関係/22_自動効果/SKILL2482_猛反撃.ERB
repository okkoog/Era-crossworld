;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2482,ARG
RESULTS = 맹반격

;　명중
;9999は必中(絶対に回避されるフラグが立ってなければ命中する)
@SKILL_HITRATE_2482, ARG
RETURN 9999

;　威力
@SKILL_POWER_2482, ARG
RETURN 200

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2482,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2482,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2482, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_2482,ARG
RETURN 0

;　相性
@SKILL_TYPE_2482,ARG
SIF ARG < 0
	RETURN GET_TYPE_NUM("不定")
RETURN ABL:ARG:공격상성
;검격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2482
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2482, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2482, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2482,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2482,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2482, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2482
RETURN GET_SUCCESSION_NUM("자동효과")

;속도보정
@SKILL_SPEED_2482, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2482
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2482, ARG = -1
RETURN 8

@SKILL_RANKUP_2482
D:1 = 2483
;ランクアップ先は一つ
RETURN 1

;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
;====================================================
@SKILL_COUNTER_ACTIONABLE_2482,ARG,ARG:1
;SIF !RECEIVE_CHECK(ARG,"物理")
;	RETURN 0
;SIF ARG:1 < 0 || GET_STATE(CFLAG:(ARG:1):상태이상) == "DYING"
;	RETURN 0
;上位のカウンタースキルを持っている場合は発動しない
SIF HAVE_SKILL(ARG, [[스킬:데스카운터]])
	RETURN 0
;物理攻撃を受けている
SIF !GET_CREC_ACT(ARG:1, ARG, "物理")
	RETURN 0
;50%の確率で発動
SIF !RAND:2
	RETURN 0
;反撃の対象は反撃してきたキャラ(ポジションで返す)
RETURN 1, CPOS(ARG:1)
;RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_2482, ARG, ARG:1, ARG:2
TFLAG:필중 = 1
TFLAG:반사0데미지화 = 1
TFLAG:흡수0데미지화 = 1
CALL ATTACK_SINGLE, ARG, POS(ARG:1), 2482
TFLAG:필중 = 0
TFLAG:반사0데미지화 = 0
TFLAG:흡수0데미지화 = 0

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2482, ARG
PRINTL 물리공격에 대해 50%의 확률로 중 데미지로 반격을 행한다
PRINTL 상성은 통상공격에 의존한다


