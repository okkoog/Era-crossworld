;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_5502, ARG, ARG:1, ARG:2
TFLAG:소환공격스킬 = 5502
FLAG:소환공격중 = 1
FLAG:행동순1 = CFLAG:ARG:소환예정캐릭터
CALL PAY_COST, CFLAG:ARG:소환예정캐릭터, CFLAG:(CFLAG:ARG:소환예정캐릭터):입력행동
CALL CONTROL_MAG, ARG, -MAXBASE:(CFLAG:ARG:소환예정캐릭터):￥

;攻撃部分のメッセージを出す
CALL PRINT_ACT_MESSAGE, FLAG:행동순1, CFLAG:(FLAG:행동순1):입력행동
CALL SKILL_ACTION, CFLAG:(CFLAG:ARG:소환예정캐릭터):입력행동, CFLAG:ARG:소환예정캐릭터, CFLAG:(CFLAG:ARG:소환예정캐릭터):타겟
FLAG:행동순1 = ARG
TFLAG:소환공격스킬 = 0
FLAG:소환공격중 = 0
CFLAG:(CFLAG:ARG:소환예정캐릭터):피소환플래그 = 0
CFLAG:(CFLAG:ARG:소환예정캐릭터):소환자ID = -1
CFLAG:(ARG):소환예정캐릭터 = -1

@SKILL_T_RESERVE_5502, ARG
RETURN 1

@SELECT_TARGET_5502, ARG
#DIM SUMMON_DEVIL
#DIM L_LINE
L_LINE = LINECOUNT
$CHOOSE_COMPANION_LOOP
CLEARLINE LINECOUNT - L_LINE
CALL CHOOSE_COMPANION, "RPG/召喚攻撃", ARG
IF RESULT == 1000
	RETURN -1
ELSEIF CFLAG:RESULT:피소환플래그 && CFLAG:ARG:소환예정캐릭터 != RESULT
	PRINTW 다른 캐릭터에게 소환되려고 하고 있습니다。
	GOTO CHOOSE_COMPANION_LOOP
ELSE
	SUMMON_DEVIL = RESULT
	CFLAG:SUMMON_DEVIL:피소환플래그 = 1
	CFLAG:SUMMON_DEVIL:소환자ID = CFLAG:ARG:캐릭터고유번호
	CFLAG:ARG:소환예정캐릭터 = SUMMON_DEVIL

	CALL INPUT_COM_DO_SKILL, SUMMON_DEVIL, , "UNABLE_SKILL_クズノハセオリー"
	IF RESULT <= 0
		CFLAG:SUMMON_DEVIL:피소환플래그 = 0
		CFLAG:SUMMON_DEVIL:소환자ID = -1
		CFLAG:ARG:소환예정캐릭터 = -1
		GOTO CHOOSE_COMPANION_LOOP
	ELSE
		CFLAG:SUMMON_DEVIL:입력행동 = RESULT
		CFLAG:SUMMON_DEVIL:타겟 = RESULT:1
		RETURN SUMMON_DEVIL
	ENDIF
ENDIF


@UNABLE_SKILL_クズノハセオリー, ARG, ARG:1
CALL GET_SKILL_PROP, "SKILL_IS_SUMMON", ARG, ARG:1
IF RESULT
	RESULTS = 지정 불능 스킬
	RETURN 0
ENDIF
RETURN 1


;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_5502, ARG
PRINTFORML ＣＯＭＰ내의 동료마를 직접 불러내 스킬을 사용시킨다。
PRINTFORML 공격력 및 능력 변화는 동료마의 것을 참조한다。

@SKILL_EXPLAIN_TOOLTIP_5502, ARG = -1
CALL GET_CAST_SKILL_EMULATOR, 5502, ARG
IF ARG < 0
	RESULTS = 커맨드스킬:필요턴수%TOFULL(TOSTR(RESULT))%
ELSE
	IF RESULT <= 0
		RESULTS = 커맨드스킬:ＲＥＡＤＹ
	ELSE
		RESULTS = 커맨드스킬:필요턴수%TOFULL(TOSTR(RESULT))%
	ENDIF
ENDIF
RESULTS:1 = ＣＯＭＰ내의 동료마를 직접 불러내 스킬을 사용시킨다。
RESULTS:2 = 공격력 및 능력 변화는 동료마의 것을 참조한다。

@SKILL_BATTLE_MAIN_TOOLTIP_5502, ARG, ARG:1
CALL GET_CAST_SKILL_EMULATOR, ARG:1, ARG
RESULTS = □쿠즈노하학설
IF RESULT <= 0
	RESULTS:1 = 　READY
ELSE
	RESULTS:1 =　필요턴수:{RESULT}
ENDIF

@SKILL_EX_DISPLAY_5502, ARG, ARGS
CALL COMMANDER_SKILL_EX_DISPLAY, ARG, ARGS, 5502, "K-Theory"
RETURN RESULT

;実際に攻撃時のチェック
