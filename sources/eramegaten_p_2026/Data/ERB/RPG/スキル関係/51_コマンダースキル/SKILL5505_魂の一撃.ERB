;特殊な攻撃参照値
@SKILL_CALC_BATTTLE_STATUS_5505, ARGS, ARG, ARG:1
SIF ARG < 0
	RETURN 0
SIF CFLAG:ARG:소환예정캐릭터 < 0
	RETURN 0
SELECTCASE ARGS
	CASE "ATK"
		;召喚予定キャラの攻と魔威のうち高いほう
		RETURN MAX(MAXBASE:(CFLAG:ARG:소환예정캐릭터):공격, MAXBASE:(CFLAG:ARG:소환예정캐릭터):마법위력)
	CASE "DEF"
		RETURN 0
	CASE "HIT"
		RETURN 0
	CASE "AVOID"
		RETURN 0
ENDSELECT
