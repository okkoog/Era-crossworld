;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_5505, ARG, ARG:1, ARG:2
#DIM SUMMON_DEVIL
IF CFLAG:ARG:소환예정캐릭터 < 0
	PRINTFORMW 혼의일격에 실패했다！
ELSE
	CALL ATTACK_SKILL, ARG, SKILLGAGE_H_GET(ARG, 5505), 5505
	SIF CFLAG:(CFLAG:ARG:소환예정캐릭터):상태이상 < GET_STATE_NUM("DYING")
		CALL VAR_HP,(CFLAG:ARG:소환예정캐릭터),-MAXBASE:(CFLAG:ARG:소환예정캐릭터):ＨＰ,"食いしばり無効ダメージ"
ENDIF
CALL SKILLGAGE_H_SET, ARG, 5505, 0
CFLAG:(CFLAG:ARG:소환예정캐릭터):피소환플래그 = 0
CFLAG:(CFLAG:ARG:소환예정캐릭터):소환자ID = -1
CFLAG:(ARG):소환예정캐릭터 = -1

@SKILL_T_RESERVE_5505, ARG
SIF TFLAG:스킬용1 == 100
	RETURN 0
RETURN 1

@SELECT_TARGET_5505, ARG
#DIM SUMMON_DEVIL
#DIM L_LINE
L_LINE = LINECOUNT
$CHOOSE_COMPANION_LOOP
IF CFLAG:ARG:소환예정캐릭터 >= 0
	CFLAG:(CFLAG:(ARG):소환예정캐릭터):피소환플래그 = 0
	CFLAG:(CFLAG:(ARG):소환예정캐릭터):소환자ID = -1
	CFLAG:(CFLAG:(ARG):소환예정캐릭터):피소환플래그 = 0
	CFLAG:ARG:소환예정캐릭터 = -1
	CALL COMMAND_REPEAT, ARG
ENDIF
CLEARLINE LINECOUNT - L_LINE
CALL CHOOSE_COMPANION, "RPG/召喚攻撃", ARG
SUMMON_DEVIL = RESULT
IF RESULT == 1000
	RETURN -1
ELSEIF CFLAG:SUMMON_DEVIL:피소환플래그 && CFLAG:ARG:소환예정캐릭터 != SUMMON_DEVIL
	PRINTW 다른 캐릭터에게 소환되려고 하고 있습니다。
	GOTO CHOOSE_COMPANION_LOOP
ELSE
	CFLAG:ARG:소환예정캐릭터 = SUMMON_DEVIL
	CFLAG:SUMMON_DEVIL:피소환플래그 = 1
	CFLAG:SUMMON_DEVIL:소환자ID = CFLAG:ARG:캐릭터고유번호
	CFLAG:SUMMON_DEVIL:피소환플래그 = 1
	CALL SYNC_STATUS, SUMMON_DEVIL
	TFLAG:스킬용1 = 100
	CALL SELECT_SKILL_TARGET,5505,ARG
	TFLAG:스킬용1 = 0
	SIF RESULT == -1
		GOTO CHOOSE_COMPANION_LOOP
	
	CALL SKILLGAGE_H_SET, ARG, 5505, RESULT
	CFLAG:(ARG):입력행동 = 5505

	RETURN SUMMON_DEVIL
ENDIF

