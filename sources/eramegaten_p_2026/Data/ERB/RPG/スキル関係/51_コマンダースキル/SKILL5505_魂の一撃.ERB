;　相性
@SKILL_TYPE_5505,ARG
#DIM LCOUNT
SIF ARG == -1 || CFLAG:(ARG):소환예정캐릭터 == -1
	RETURN GET_TYPE_NUM("만능")
FOR LCOUNT, 0, TYPENUM
	SIF C_HAVE_SKILL_ATK_TYPE:(CFLAG:(ARG):소환예정캐릭터):LCOUNT
		RESULT:FINDELEMENT(RESULT, - 1) = LCOUNT
NEXT
RETURN RESULT

