;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_1339, ARG, ARG:1, ARG:2
IF ARG:1 == 19
	LOCAL:2 = 1
	LOCAL:3 = 7
ELSE
	LOCAL:2 = 7
	LOCAL:3 = 17
ENDIF

FOR LOCAL,LOCAL:2,LOCAL:3
	SIF POS(LOCAL) < 0
		CONTINUE
	FOR LOCAL:1,0,6
		CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") = MIN(0, CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화"))
	NEXT
NEXT
PRINTFORMW \@ CFLAG:ARG:PT플래그 > 0 ? 적 # 아군 \@의 강화된 능력이 돌아왔다！

