;バランスの都合上、バリオン系はダインからのランクアップ不可
;（汎用魔法ではあるのだが、開発時に想定していないランクのスキルなので、
;　リムドーラとザンダインを基準に、その間の準必殺スキル、として定義。入手難度もそれに準ずる。
;　燃費効率はあえて悪め。習得レベル帯はLv55～を想定。悪魔の場合はさらに相性素質も求めつつ、「こいつはもう強いウリがあるな」を除く）

;破魔呪殺は全体の威力水準が低いので環境に合わせた威力に
;（全体320でも汎用スキルとして異例の火力になるため扱いは慎重に）

;スキル名
@SKILL_NAME_1348,ARG
IF SKILL_CHANGE(ARG, [[キャラ:메데이아릴리]])
	RESULTS = 魔力弾連射
ELSE
	RESULTS = 마하코우바리온
ENDIF

;　명중
@SKILL_HITRATE_1348, ARG
RETURN 100

;　威力
@SKILL_POWER_1348, ARG
RETURN 320

;　최저공격횟수
@SKILL_MINATTACKNUMBER_1348,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1348,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1348, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1348,ARG
RETURN 32

;　相性
@SKILL_TYPE_1348,ARG
RETURN GET_TYPE_NUM("파마")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1348
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_1348, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1348, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_1348,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1348,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_1348, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_1348
RETURN GET_SUCCESSION_NUM("파마")

;속도보정
@SKILL_SPEED_1348, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1348
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1348, ARG = -1
RETURN 11



@SKILL_RANKUP_1348
;ランクアップ先は0
RETURN 0



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_1348, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,1348





;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_1348, ARG
PRINTL 성스러운 힘으로 적 전체를 공격한다。상성:파마　위력:대




;使用条件
@SKILL_SPECIAL_ACTIONABLE_1348,ARG
RETURN 1
;とくにない

