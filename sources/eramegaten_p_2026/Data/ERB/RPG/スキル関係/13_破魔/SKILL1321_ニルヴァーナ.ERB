;　コストの量
@SKILL_COST_1321,ARG
RETURN 17

;　相性
@SKILL_TYPE_1321,ARG
RETURN GET_TYPE_NUM("파마")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1321
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

