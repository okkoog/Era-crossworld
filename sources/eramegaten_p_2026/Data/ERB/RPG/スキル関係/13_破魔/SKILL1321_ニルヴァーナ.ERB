RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_1321
RETURN GET_SUCCESSION_NUM("파마")

;속도보정
@SKILL_SPEED_1321, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1321
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1321, ARG = -1
RETURN 12


