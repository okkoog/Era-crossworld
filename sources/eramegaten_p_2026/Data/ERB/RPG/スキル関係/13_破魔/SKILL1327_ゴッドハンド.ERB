	RESULTS = 파아ーーーー!!
ELSEIF SKILL_CHANGE(ARG, [[キャラ:아서]])
	RESULTS = 롱고미니아드
ELSE	
	RESULTS = 갓핸드
ENDIF

;　명중
@SKILL_HITRATE_1327, ARG
RETURN 100

;　威力
@SKILL_POWER_1327, ARG
IF SKILL_CHANGE(ARG, [[キャラ:T씨]])
	RETURN 350
ELSEIF SKILL_CHANGE(ARG,[[キャラ:아서]])
	RETURN 325
ELSE
	RETURN 295
ENDIF


