;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_1311, ARG, ARG:1, ARG:2
SIF CFLAG:ARG:PT플래그 == 2
	SETBIT TFLAG:알파블라스터, 0
SIF CFLAG:ARG:PT플래그 == 0
	SETBIT TFLAG:알파블라스터, 1

@SPECIAL_ACTION_1311
CALL MESSAGE_B(1, "알파블라스터")
FOR LOCAL,1,17
	SIF LOCAL < 7 && !GETBIT(TFLAG:알파블라스터, 1)
		CONTINUE
	SIF LOCAL >= 7 && !GETBIT(TFLAG:알파블라스터, 0)
		CONTINUE
	LOCALS = 포지션{LOCAL}
	SIF POS(LOCAL) < 0
		CONTINUE
	SIF GET_STATE(CFLAG:(POS(LOCAL)):상태이상) == "DYING"
		CONTINUE
	PRINTFORM 　　TARGET:[{CPOS(POS(LOCAL)),2}] %CALLNAME:(POS(LOCAL)),20,LEFT%　>>>>>>　
	IF CFLAG:POS(LOCAL):방어플래그
		PRINTW GUARD
	ELSEIF CFLAG:(POS(LOCAL)):보스플래그
		PRINTW BLOCK
	ELSE
		PRINTFORMW {(BASE:(POS(LOCAL)):ＨＰ)/2}데미지
		CALL VAR_HP,POS(LOCAL),-((BASE:(POS(LOCAL)):ＨＰ)/2),"食いしばり無効ダメージ"
	ENDIF
NEXT


