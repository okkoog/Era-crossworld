;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_3597, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "ATK"
		;ノヴァサイザー式
		LOCAL = MIN(MAXBASE:ARG:힘, MAXBASE:ARG:마력)
		LOCAL = MAX(LOCAL, 1)
		LOCAL = LOCAL * 64 / (MAXBASE:ARG:힘 + MAXBASE:ARG:마력)
		RETURN CFLAG:ARG:공격강화 + LOCAL, 32
ENDSELECT

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3597, ARG, ARG:1, ARG:2

;このへんノヴァサイザーから移植
;0除算回避に+1をつける
;LOCAL = MIN(MAXBASE:ARG:힘, MAXBASE:ARG:마력)
;SIF LOCAL <= 0
;	LOCAL = 1
;LOCAL = LOCAL * 64 / (MAXBASE:ARG:힘+MAXBASE:ARG:마력)
;CFLAG:ARG:공격강화 += LOCAL
;ここまで

;CR展開時
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	ALIGNMENT CENTER
	SETCOLOR 0xff8e48
	PRINTL 【ＣＬＩＭＡＸ　ＡＣＴ】
	RESETCOLOR
	ALIGNMENT LEFT

	;西條パワーアップイベント中かつボスが最終形態時のみ、ボスの不死フラグを剥がして攻撃
	IF GETBIT(イベントフラグ:93:19, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:클로딘]])
		CFLAG:(CHARANUM-1):불사신플래그 = 0
	ENDIF
	
	LOCAL:1 = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,(LOCAL:1),3597

	;西條パワーアップイベント中かつボスが最終形態時のみ、撃破時に敵が喋る
	IF GETBIT(イベントフラグ:93:19, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:클로딘]])

		;ボスのHPがぴったり1の場合、『すでに削り切ったけど、攻撃をミスってとどめを刺せていない』状況と見る
		IF BASE:(CHARANUM-1):ＨＰ == 1
			PRINTL
			SETCOLOR COLOR("FRIEND")
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"하르페 전개! 이 에너지의 여파로오오오오!!",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTL
			ALIGNMENT CENTER
			PRINTFORML ┏━━━━━━━━━━┓
			PRINTFORML ┃　　 　1more！　　　┃
			PRINTFORMW ┗━━━━━━━━━━┛
			RESETCOLOR
			ALIGNMENT LEFT
			
			;テイクツー
			CFLAG:(CHARANUM-1):불사신플래그 = 0
			TFLAG:필중 = 1
			;CFLAG:ARG:회심의패기플래그 = 1
			
			CALL ATTACK_SINGLE,ARG,(LOCAL:1),3597
			
		ENDIF
		
		;ボス撃破
		IF BASE:(CHARANUM-1):ＨＰ < 1
			ALIGNMENT CENTER
			SETCOLOR 0xffffff
			PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┃　　　　　　　이피클레스! 너는 지금……　　　　　　　┃
			PRINTL ┃　　　　　　　　세상의 누구보다, 아름다워!　　　　　　　┃
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTL 
			ALIGNMENT LEFT
			SETCOLOR 0xffffff
			PRINTL 　　　무대에서 살아가고 있어――
			SETCOLOR 0xff8e48
			PRINTL 　　　　　　　칼끝에 영광 깃들어라――!
			PRINTL
		ENDIF
	ELSE
		;クライマックスレヴュー終了。ゲージ取得をとめるために-1で送ってむこうで0にする
		CALL SET_ROLE_CFLAG_DUNGEON, ARG,  "클라이맥스레뷰지속시간" , -1
	ENDIF

	ALIGNMENT CENTER
	SETCOLOR 0xff8e48
	PRINTW 【ＣＬＩＭＡＸ　ＲＥＶＵＥ／ＦＩＮＩＳＨ】
	PRINTL
	RESETCOLOR
	ALIGNMENT LEFT
	;クライマックスレヴュー終了
	;CALL SET_ROLE_CFLAG_DUNGEON, ARG,  "클라이맥스레뷰지속시간" , 0

;それ以外
ELSE
	CALL ATTACK_FIELD,ARG,ARG:1,3597
ENDIF

