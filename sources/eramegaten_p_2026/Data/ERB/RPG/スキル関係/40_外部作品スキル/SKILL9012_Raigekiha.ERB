;뇌격파
;敵一体に電撃相性の中ダメージ　想定コスト5　想定威力240

;スキル名
@SKILL_NAME_9012,ARG
RESULTS = 뇌격파

;　명중
@SKILL_HITRATE_9012, ARG
;ライトニングシューター装備かつスキル「ﾗｲﾄﾆﾝｸﾞｼｭｰﾀｰ」を保持している場合、命中が120まで上昇
RETURN 100

@SKILL_POWER_9012, ARG
RETURN 80

;　최저공격횟수
@SKILL_MINATTACKNUMBER_9012,ARG
RETURN 3

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_9012,ARG
RETURN 3

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_9012, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_9012,ARG
RETURN 5

;　相性
@SKILL_TYPE_9012,ARG
RETURN GET_TYPE_NUM("전격")
;전격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_9012
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_9012, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_9012, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_9012,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_9012,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_9012, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_9012
RETURN GET_SUCCESSION_NUM("계통없음")

@継承不能_9012
RETURN 1

;속도보정
@SKILL_SPEED_9012, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_9012
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_9012, ARG = -1
RETURN 3



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_9012, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,9012






