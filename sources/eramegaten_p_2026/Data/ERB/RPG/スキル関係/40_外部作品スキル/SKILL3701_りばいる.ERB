;サマリカーム互換

;スキル名
@SKILL_NAME_3701,ARG
RESULTS = 리바이루


;　명중
@SKILL_HITRATE_3701, ARG
RETURN 100

;　威力
@SKILL_POWER_3701, ARG
RETURN 50

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3701,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3701,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3701, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3701,ARG
RETURN 24


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3701
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3701, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_3701,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3701,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3701, ARG
RETURN GET_SKILL_EFFECT_NUM("상태회복")

;蘇生スキルであるか
@SKILL_IS_RESUSCITATION_3701
RETURN 1


;계승타입
@SKILL_SUCCESSION_TYPE_3701
RETURN GET_SUCCESSION_NUM("회복")

;속도보정
@SKILL_SPEED_3701, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3701
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_3701, ARG = -1
RETURN 11



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3701, ARG, ARG:1, ARG:2
CALL SKILL_CURE_STATE_3701,CFLAG:(ARG:1):상태이상
IF RESULT == 1
	PRINTFORMW %CALLNAME:(ARG:1)%은(는) 숨을 되찾았다
	CFLAG:(ARG:1):상태이상 = 0
	CFLAG:(ARG:1):상태이상경과턴수 = 0
	CALL VAR_HP,(ARG:1),MAXBASE:(ARG:1):ＨＰ
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_3701,ARG,ARG:1,ARG:2
CALL SKILL_CURE_STATE_3701,CFLAG:(ARG:1):상태이상
IF RESULT == 1
	PRINTFORMW %CALLNAME:(ARG:1)%은(는) 숨을 되찾았다
	CFLAG:(ARG:1):상태이상 = 0
	CFLAG:(ARG:1):상태이상경과턴수 = 0
	CALL VAR_HP,(ARG:1),MAXBASE:(ARG:1):ＨＰ
ELSE
	PRINTW 효과가 없었다
ENDIF


;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_3701, ARG
PRINTL 빈사 상태인 아군 1명을 HP 최대로 부활시킨다.
PRINTL 속효성이 있는 약물. 숨겨두었던 재료로 조합해 그 자리에서 아군에게 처방한다.
PRINTL 본래는 지식이 있는 자만이 사용할 수 있다.



;使用条件
@SKILL_SPECIAL_ACTIONABLE_3701,ARG
RETURN 1
;とくにない

;ターゲット条件
@SKILL_TARGETABLE_3701,ARG, ARG:1
CALL SKILL_CURE_STATE_3701,(CFLAG:(ARG:1):상태이상)
RETURN RESULT

;控えに使えるか
@SKILL_T_RESERVE_3701, ARG
RETURN 1

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_3701,ARG
SELECTCASE GET_STATE(ARG)
	CASE "DYING"
		RETURN 1
	CASEELSE
		RETURN 0
ENDSELECT

