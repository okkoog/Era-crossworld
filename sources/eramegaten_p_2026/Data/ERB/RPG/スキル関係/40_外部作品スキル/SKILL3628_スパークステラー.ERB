;スキル名
@SKILL_NAME_3628, ARG
RESULTS = 스파크스텔라
IF FLAG:총공격중
	TSTR:스킬메시지행동자 = RoRo
	TFLAG:스킬행동자컬러 = 0x9933cd
ENDIF
;　명중
@SKILL_HITRATE_3628, ARG
RETURN 100

;　威力
@SKILL_POWER_3628, ARG
SIF ARG < 0
	RETURN 225
IF SKILLGAGE_D_GET(ARG, [[스킬:스파크스텔라]]) > 0
	IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "다크니스트리거Ｘ") && FLAG:총공격중
		;約1.25倍
		IF FLAG:확산플래그
			RETURN 85
		ELSE
			RETURN 115
		ENDIF
	ELSE
		IF FLAG:확산플래그
			RETURN 70
		ELSE
			RETURN 95
		ENDIF
	ENDIF
ELSE
	RETURN 225
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3628, ARG
SIF SKILLGAGE_D_GET(ARG, [[스킬:스파크스텔라]]) > 0
	RETURN 3
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3628, ARG
SIF SKILLGAGE_D_GET(ARG, [[스킬:스파크스텔라]]) > 0
	RETURN 3
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3628, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3628, ARG
SIF ARG < 0
	RETURN 12
;ダークネストリガー発動中はコスト1/3
SIF SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
	RETURN 4
RETURN 12

;　相性
@SKILL_TYPE_3628, ARG
RETURN GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3628
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3628, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3628, ARG
;ロック中の攻撃・ロック対象に強制
IF ARG >= 0 && NO:ARG == [[キャラ:아큐라_X]] && BLITZ_TARGET_JUDG(ARG) == 1
	RETURN 4
;非ロック中の攻撃・敵単体
ELSE
	RETURN 1
ENDIF

;　사거리
@SKILL_RANGE_3628, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3628, ARG
;ロック中の攻撃・ロック対象に強制
IF BLITZ_TARGET_JUDG(ARG) == 1
	RETURN 4
;非ロック中の攻撃・敵単体
ELSE
	RETURN 1
ENDIF

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3628, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_3628
RETURN GET_SUCCESSION_NUM("전격")

;속도보정
;スパークステラーは発動が音速い
@SKILL_SPEED_3628, ARG = -1
RETURN -3

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3628
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3628, ARG = -1
RETURN 23

@継承不能_3628
RETURN 1

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_3628, ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_3628, ARG
RETURN GET_TYPE_NUM("전격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_3628, ARG
RETURN 10

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_3628, ARG
RETURN 50

;拡散攻撃用追加処理
;ブレスなどの拡散攻撃に使う
@SKILL_SPREAD_3628, ARG
IF SKILLGAGE_D_GET(ARG, [[스킬:스파크스텔라]]) > 0
	RETURN 1
ELSE
	RETURN 0
ENDIF

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_3628, ARG, ARG:1
#DIM ROCK_H

;ダークネストリガー追撃条件共通
IF DTRIGGER_ABLE(ARG, "스파크스텔라")
	ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
	CALL SKILLGAGE_D_SET, ARG, [[스킬:스파크스텔라]], 1
	;200000をつけることで行動不能時にも追撃をするようになる
	RETURN 1, 200000 + 23
ENDIF
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3628, ARG, ARG:1, ARG:2
#DIM ROCK_H
#DIM 加算クードス

;ロック中かつロック対象が生存中なら強制的にロック対象へ攻撃
IF ARG:1 == 23 
	IF BLITZ_TARGET_JUDG(ARG) == 1
		SIF FLAG:총공격중
			TFLAG:반사후0데미지화 = 1
		ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
		CALL SKILLGAGE_D_SET, ARG, [[스킬:스파크스텔라]], 1
		CALL ATTACK_SPREAD, ARG, CPOS(ROCK_H), 3628
	ENDIF
ELSE
	CALL ATTACK_SINGLE, ARG, POS(ARG:1), 3628
ENDIF

;撃破数1につき20の基礎クードスを得る。(上限100)
加算クードス = MIN(GET_CREC_ACT_SUM(ARG, "적", "KILL"), 5) * 20
CALL SET_加算クードス, ARG, 加算クードス

;EXウェポン0番=스파크스텔라
SIF HAVE_SKILL(ARG, [[스킬:DARKNESS TRIGGER]])
	CALL SKILLGAGE_F_SET, ARG, [[스킬:DARKNESS TRIGGER]], 0
;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3628, ARG
PRINTL 뇌격을 다루는 셉티마·푸른 뇌정(암드 블루)을 재현한 EX 웨폰.
PRINTL HP를 소비하는 커맨드 「블리츠대쉬」에 의해 록이 걸린 적이 있을 경우 강제적으로 그 대상을 공격한다.
PRINTL 
PRINTL 공격 대상이 록온 상태인 경우… 적 단체와 그 주위에 전격 상성으로 3회 소 데미지를 준다.
PRINTL 공격 대상이 비록온 상태인 경우… 적 단체에 전격 상성으로 중 데미지를 준다.
PRINTL 어느 쪽이든 감전을 부여한다.
IF ARG > 0 && ARG < CHARANUM && IS_CHARA_EQUIPED(ARG, "다크니스트리거Ｘ") && SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
	SETCOLOR 0x9933cd
	PRINTL 다크니스 트리거 X 장비 중　다크니스 트리거에 의한 추격 시 데미지 상승
	RESETCOLOR
ENDIF
PRINTL ※이 스킬로 적을 쓰러뜨렸을 경우 1체당 쿠도스가 20 가산된다

;使用条件
@SKILL_SPECIAL_ACTIONABLE_3628, ARG
;타겟=23が入るのはロック中のみ
;かつ実行時にターゲットが死んだりするとダメ
SIF ARG > 0 && CFLAG:ARG:타겟 == 23 && BLITZ_TARGET_JUDG(ARG) != 1
	RETURN 0
RETURN 1

;継承に必要な部位

