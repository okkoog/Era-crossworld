;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_3551,ARG,ARG:1,ARG:2
;修羅
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	SIF ARG:2 >= -1
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "魔法威力_魔法効果", -4, "短縮"
	;PRINT  & 魔法威力、魔法効果低下
	;CFLAG:(ARG:1):마법위력강화 = MAX(-16, CFLAG:(ARG:1):마법위력강화 - 4)
	;CFLAG:(ARG:1):마법효과강화 = MAX(-16, CFLAG:(ARG:1):마법효과강화 - 4)
;羅刹
ELSE
ENDIF

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3551, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
;修羅
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	CALL ATTACK_SINGLE,ARG,LOCAL,3551
	;CALL RATE_ATTACK_SINGLE,ARG,LOCAL,3551,-1,400
;羅刹
ELSE
	;CALL RATE_ATTACK_SINGLE,ARG,LOCAL,3551,-1,300
	CALL ATTACK_SINGLE,ARG,LOCAL,3551
	TFLAG:스킬용1 = 1
	CALL ATTACK_SINGLE,ARG,LOCAL,3551
ENDIF



;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_3551, ARG
IF TFLAG:전투중 == 0 && ARG > -1 && HAVE_SKILL(ARG, [[스킬:분노폭발]])
	PRINTL 【修羅】
	PRINTL 적 1체에 20% 빙결 비율 데미지 + 긴박 + 마법 효과, 마법 위력 저하
	PRINTL 【羅刹】
	PRINTL 적 1체에 20% 빙결 비율 데미지 + 동결, 빙결 물리 데미지
ELSEIF ARG < 0 || SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	PRINTL 얼어붙은 손바닥 찌르기　상대를 얼려서 밀쳐낸다
	PRINTL 적 단체에 빙결 속성으로 대상의 현재 HP 20% 데미지(상한 400)를 준다. 명중이 낮다
	PRINTL 追加効果：BIND、魔法威力・魔法効果低下
ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
	PRINTL 얼어붙은 손바닥 부수기　상대를 얼려서 추격한다
	PRINTL 적 단체에 빙결 속성으로 대상의 현재 HP 20% 데미지(상한 300)를 주고 FREEZE 상태로 만든다. 명중이 낮다
	PRINTL 그 후, 빙결 속성으로 중위력의 물리 공격을 행한다
ENDIF




