;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3661,ARG
RESULTS = 입에서빔！

;　명중
@SKILL_HITRATE_3661, ARG
RETURN 140

;　威力
@SKILL_POWER_3661, ARG
RETURN 230

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3661,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3661,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3661, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_3661,ARG
RETURN 0

;　相性
@SKILL_TYPE_3661,ARG
RETURN GET_TYPE_NUM("핵열")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3661
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3661, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3661, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3661,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3661,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3661, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3661
RETURN GET_SUCCESSION_NUM("핵열")
;충격

;속도보정
@SKILL_SPEED_3661, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3661
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3661, ARG = -1
RETURN 9

@SKILL_RANKUP_3661
;ランクアップなし
RETURN 0



;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3661, ARG, ARG:1, ARG:2
CALL ATTACK_SINGLE, ARG, POS(ARG:1), 3661
CALL SKILLGAGE_H_ADD,ARG,3661,1
;ゲージHを利用して使用済み判定にする


;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3661, ARG
PRINTL 기합으로 물리법칙을 무시하고 팔에 든 퍼핏에서 열선을 조사해, 적 1체에 핵열 상성의 중 데미지.
PRINTL MP를 소비하지 않고 기습 효과도 있어 명중시키기 쉽지만, 기합을 넣는 것은 배틀 중 1회가 한도.
PRINTL 기계수 걸 다브라스 M2의 필살기. 요령만 익히면 팔이 있다면 누구든 다룰 수 있다.





;使用条件
@SKILL_SPECIAL_ACTIONABLE_3661,ARG
RESULTS = 사용 완료
SIF SKILLGAGE_H_GET(ARG,3661)
	RETURN 0
RETURN 1

