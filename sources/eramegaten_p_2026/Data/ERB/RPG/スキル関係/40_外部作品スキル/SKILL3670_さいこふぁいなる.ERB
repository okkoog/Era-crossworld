@SKILL_HITRATE_3670, ARG
RETURN 100

;　威力
@SKILL_POWER_3670, ARG
RETURN 490

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3670,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3670,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3670, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3670,ARG
RETURN 38

;　相性
@SKILL_TYPE_3670,ARG
RETURN GET_TYPE_NUM("충격")
;충격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3670
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3670, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3670, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3670,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3670,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3670, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3670
RETURN GET_SUCCESSION_NUM("충격")

;속도보정
@SKILL_SPEED_3670, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3670
RETURN 0

;スキル変化用ランク
@SKILL_RANK_3670, ARG = -1
RETURN 13

@SKILL_RANKUP_3670
;ランクアップ先はなし
RETURN 0


;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_3670, ARG = -1, ARG:1 = -1
RETURN 2

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3670, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,3670


;====================================================
;実行内容ここまで
;====================================================

