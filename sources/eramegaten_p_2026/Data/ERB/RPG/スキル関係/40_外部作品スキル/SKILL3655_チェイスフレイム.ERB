;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_3655, ARG, ARG:1, ARG:2
SIF ARG:2 < -1
	RETURN 0
;チェイス相手の番号をHに保存
CALL SKILLGAGE_H_SET, ARG, 3655 , ARG:1
;Dに効果ターン数を保存
;効果はこのターン(1ターン)のみ
CALL SKILLGAGE_D_SET, ARG, 3655, 1

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_3655,ARG,ARG:1
#DIM CHASE_T
;自分ならNG
SIF FLAG:행동순1 == ARG
	RETURN 0
;攻撃しているのが味方でないとNG
SIF !IS_FRIEND(FLAG:행동순1, ARG)
	RETURN 0
;SIF ARG == ARG:1
;	RETURN 0
;チェイス効果が無いとNG
SIF SKILLGAGE_D_GET(ARG,3655) < 1
	RETURN 0
CHASE_T = SKILLGAGE_H_GET(ARG,3655)
;チェイス対象でないとNG
SIF ARG:1 != CHASE_T
	RETURN 0
SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "HIT", "화염")
	RETURN 0
RETURN 1, CPOS(ARG:1)
;相手が死んでる、いないと
;SIF CHASE_T < 0 || GET_STATE(CFLAG:CHASE_T:상태이상) == "DYING"
;	RETURN 0
;回避されるとNG
;SIF !CFLAG:CHASE_T:회피실패
;	RETURN 0
;剣撃を受けてないとNG
;受けフラグについては、CFLAG.CSV、RECEIVE_SETを参照
;SIF !GETBIT(CFLAG:CHASE_T:受けフラグ,GET_TYPE_NUM("화염"))
;	RETURN 0
;チェイス相手の位置をターゲットに
;RESULT:1 = CPOS(CHASE_T)
;RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3655, ARG, ARG:1, ARG:2
#LOCALSIZE 4
IF SKILLGAGE_D_GET(ARG,3655) && ARG != FLAG:행동순1
	;追撃時
	;필중
	TFLAG:필중 = 1
	TFLAG:반사0데미지화 = 1
	CALL ATTACK_SINGLE, ARG, POS(ARG:1), 3655
	TFLAG:필중 = 0
	TFLAG:반사0데미지화 = 0
ELSE
	;通常時
	CALL ATTACK_SINGLE, ARG, POS(ARG:1),3655
ENDIF
;====================================================
;実行内容ここまで
;====================================================

