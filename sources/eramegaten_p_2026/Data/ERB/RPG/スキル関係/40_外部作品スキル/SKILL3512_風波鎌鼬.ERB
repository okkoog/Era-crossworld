;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3512,ARG
RESULTS = 풍파・카마이타치

;　명중
@SKILL_HITRATE_3512, ARG
RETURN 100

;　威力
@SKILL_POWER_3512, ARG
RETURN 150

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3512,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3512,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3512, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3512,ARG
RETURN 24

;　相性
@SKILL_TYPE_3512,ARG
SIF FLAG:공격횟수 == 1
	RETURN GET_TYPE_NUM("질풍")
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3512
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3512, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3512, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3512,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3512,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3512, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3512
RETURN GET_SUCCESSION_NUM("검격")

;속도보정
@SKILL_SPEED_3512, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3512
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3512, ARG = -1
RETURN 11


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3512, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,3512






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3512, ARG
PRINTL 적 １열에 검격+질풍의 ２회 공격

@継承部位_3512,ARG
RESULTS = 무기
RETURN 1

;使用条件
@SKILL_SPECIAL_ACTIONABLE_3512,ARG
RETURN 1
;とくにない

