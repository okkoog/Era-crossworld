;Burn my Dreadとほぼ同じ
;星見さんが使ったときだけ物理判定にしようとしたらそんな引数ねえよってエラー噴いた
;方法が分かんなかったのでとりあえず新規作成
;やり方教えてくれたら喜ぶ

;全くおんなじ物を作ってもリソースの無駄なのでちょいちょいアレンジ

;スキル名
@SKILL_NAME_3517,ARG
RESULTS = 자신만의별

;　명중
@SKILL_HITRATE_3517, ARG
RETURN 100

;　威力
@SKILL_POWER_3517, ARG
;星見さんはもっと曲線を極端に
;歌唱能力が足りないとコストだけが高いゴミスキルになる
SIF ARG == -1
      RETURN 1
IF ABL:ARG:가창기능 == 0
      RETURN 1
ELSEIF ABL:ARG:가창기능 == 1
      RETURN 40
ELSEIF ABL:ARG:가창기능 == 2
      RETURN 80
ELSEIF ABL:ARG:가창기능 == 3
      RETURN 120
ELSEIF ABL:ARG:가창기능 == 4
      RETURN 160
ELSEIF ABL:ARG:가창기능 == 5
      RETURN 200
ELSEIF ABL:ARG:가창기능 == 6
      RETURN 240
ELSEIF ABL:ARG:가창기능 == 7
      RETURN 280
ELSEIF ABL:ARG:가창기능 == 8
      RETURN 320
ELSEIF ABL:ARG:가창기능 == 9
      RETURN 370
ELSE
      RETURN 420
ENDIF
RETURN 1


;　최저공격횟수
@SKILL_MINATTACKNUMBER_3517,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3517,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3517, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3517,ARG
;最大火力がデカいので多め
RETURN 45

;　相性
@SKILL_TYPE_3517,ARG
RETURN GET_TYPE_NUM("정신")
;비구

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3517
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3517, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3517, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3517,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3517,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3517, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3517
RETURN GET_SUCCESSION_NUM("정신")
;비구

;속도보정
@SKILL_SPEED_3517, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3517
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3517, ARG = -1
RETURN 22


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_3517,ARG
RETURN GET_STATE_NUM("BOMB")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_3517,ARG
RETURN GET_TYPE_NUM("신경")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_3517,ARG
RETURN 25

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_3517,ARG
RETURN 60

@継承不能_3517
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3517, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,3517

