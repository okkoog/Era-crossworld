;拡散攻撃用追加処理
@SKILL_SPREAD_3549,ARG
IF ARG > -1
	;修羅
	SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
		RETURN 1
	;羅刹
	SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
		RETURN 0
ENDIF
RETURN 1

;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_3549,ARG,ARG:1,ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
;修羅
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	;PRINT  & 攻撃低下
	;CFLAG:(ARG:1):공격강화 = MAX(-16, CFLAG:(ARG:1):공격강화 - 4)
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격", -4, "短縮"
;羅刹
ELSE
ENDIF

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3549, ARG, ARG:1, ARG:2
;修羅
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	CALL ATTACK_SPREAD,ARG,ARG:1,3549
;羅刹
ELSE
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),3549
ENDIF



;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_3549, ARG
IF TFLAG:전투중 == 0 && ARG > -1 && HAVE_SKILL(ARG, [[스킬:분노폭발]])
	PRINTL 【修羅】
	PRINTL 적 1체와 인접 대상에 빙결 데미지 + FREEZE + 공격 저하
	PRINTL 【羅刹】
	PRINTL 적 1체에 빙결 4회 데미지 + PALYZE
ELSEIF ARG < 0 || SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	PRINTL 얼어붙은 활　얼음 조각을 포물선으로 던져 날아가 얼음 꽃이 피어나고 이 꽃으로 공격한다
	PRINTL 적 단체와 인접 대상에 빙결 속성 중위력 마법 공격을 행한다
	PRINTL 追加効果：FREEZE、攻撃低下
ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
	PRINTL 얼음 꽃　양 손바닥을 지면에 대어 얼음 꽃을 지면에서 만들어 내 그것을 수직 상승시키는 기술
	PRINTL 적 단체에 빙결 속성 소위력 마법 공격을 4회 행한다
	PRINTL 追加効果：PALYZE
ENDIF




;使用条件
@SKILL_SPECIAL_ACTIONABLE_3549,ARG
RETURN 1
