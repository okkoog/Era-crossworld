;
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3549,ARG
;修羅
;SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	RESULTS = 루푸시・쿠아레
;羅刹
SIF ARG > -1 && SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
	RESULTS = 콘루 논노

;　명중
@SKILL_HITRATE_3549, ARG
IF ARG > -1
	;修羅
	SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
		RETURN 100
	;羅刹
	SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
		RETURN 100
ENDIF
RETURN 100

;　威力
@SKILL_POWER_3549, ARG
IF ARG > -1
	;修羅
	SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
		RETURN 230
	;羅刹
	SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
		RETURN 100
ENDIF
RETURN 300

;　최저공격횟수
