;뇌총격
;敵単体とその周囲に拡散ダメージを与え、確率でSHOCKにする　想定コスト30　想定総合火力（単体）300＋拡散

;スキル名
@SKILL_NAME_9009,ARG
RESULTS = 뇌총격

;　명중
@SKILL_HITRATE_9009, ARG
;ライトニングシューター装備の場合、命中が100まで上昇
RETURN 70

@SKILL_POWER_9009, ARG
RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_9009,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_9009,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_9009, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_9009,ARG
;ライトニングシューターを装備している場合
IF ARG >= 0 && EQUIP:ARG:총 == GETNUM(ITEM, "라이트닝슈터")
	RETURN 30
ELSE
	RETURN 40
ENDIF

;　相性
@SKILL_TYPE_9009,ARG
RETURN GET_TYPE_NUM("전격")
;전격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_9009
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_9009, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_9009, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_9009,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_9009,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_9009, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_9009
RETURN GET_SUCCESSION_NUM("전격")

@継承不能_9009
RETURN 1
;不可

;속도보정
@SKILL_SPEED_9009, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_9009
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_9009, ARG = -1
RETURN 4


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_9009,ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_9009,ARG
RETURN GET_TYPE_NUM("전격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_9009,ARG
RETURN 20

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_9009,ARG
RETURN 30

;拡散攻撃用追加処理
@SKILL_SPREAD_9009,ARG
RETURN 1
;拡散距離:1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_9009, ARG, ARG:1, ARG:2
CALL ATTACK_SPREAD,ARG,ARG:1,9009



;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_9009, ARG
PRINTL 뇌둔 스킬
PRINTL 라이트닝 슈터에 술법을 수렴해 최대 출력으로 특대 뇌격탄을 날린다
PRINTL 적중한 대상과 그 주위에 데미지를 주고 확률로 SHOCK 상태로 만든다




;使用条件
@SKILL_SPECIAL_ACTIONABLE_9009,ARG
RETURN 1
;とくにない




