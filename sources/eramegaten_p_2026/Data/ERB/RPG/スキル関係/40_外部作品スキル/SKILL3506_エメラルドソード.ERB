;拡散攻撃用追加処理
@SKILL_SPREAD_3506,ARG
RETURN 1
;拡散距離:1

;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_3506, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "ATK"
		RETURN LIMIT(CFLAG:ARG:공격강화 + CFLAG:ARG:마법위력강화, -48, 64), 32
ENDSELECT

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3506, ARG, ARG:1, ARG:2

;LOCAL:0 = MAXBASE:ARG:공격
;LOCAL:1 = CFLAG:ARG:공격강화
;
;MAXBASE:ARG:공격 = MAXBASE:ARG:마법위력
;CFLAG:ARG:공격강화 += CFLAG:ARG:마법위력강화

CALL ATTACK_SPREAD,ARG,ARG:1,3506

;MAXBASE:ARG:공격 = LOCAL:0
;CFLAG:ARG:공격강화 = LOCAL:1

