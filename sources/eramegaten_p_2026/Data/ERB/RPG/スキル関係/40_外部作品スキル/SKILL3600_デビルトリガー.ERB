;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_3600,ARG,ARG:1
#LOCALSIZE 1
#DIM L_T
#DIM L_GP
;起動中は離脱
SIF SKILLGAGE_D_GET(ARG,3600) > 0
	RETURN 0
;ゲージが溜まっている時は離脱
SIF SKILLGAGE_F_GET(ARG,3600) == 100
	RETURN 0
L_GP = 0
;自分の行動の場合
IF ARG == ARG:1
	FOR LOCAL, 0, BCHARANUM
		L_T = BCHARA:LOCAL
		;味方はノーカン
		SIF IS_FRIEND(ARG, L_T)
			CONTINUE
		SIF GET_CREC_ACT(ARG, L_T, "HIT")
			L_GP += 3
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 2
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 2
	NEXT
	;挑発をしても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:도발]]
		L_GP += 7
	;無限の挑発しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:끝없는도발]]
		L_GP += 7

	;ダメージを受けた敵の数に応じてスキルゲージアップ
	;FOR LOCAL,0,CHARANUM
	;	SIF CFLAG:LOCAL:PT플래그 == CFLAG:ARG:PT플래그
	;		CONTINUE
	;	IF CFLAG:LOCAL:현데미지 > 0
	;		CALL SKILLGAGE_F_ADD,ARG,3600,3
	;	ELSE
	;		CONTINUE
	;	ENDIF
	;	;会心、弱点を出すとさらにアップ
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,21)
	;		CALL SKILLGAGE_F_ADD,ARG,3600,2
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,22)
	;		CALL SKILLGAGE_F_ADD,ARG,3600,2
	;NEXT
	;挑発をしても上がる
	;SIF CFLAG:ARG:입력행동 == 515
	;	CALL SKILLGAGE_F_ADD,ARG,3600,7
	;無限の挑発しても上がる
	;SIF CFLAG:ARG:입력행동 == [[스킬:끝없는도발]]
	;	CALL SKILLGAGE_F_ADD,ARG,3600,7
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;怒りゲージが増える
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += MAX(60 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ, 2)
;IF CFLAG:ARG:현데미지 > 0 || GETBIT(CFLAG:ARG:受けフラグ,18) || GETBIT(CFLAG:ARG:受けフラグ,19)
;	LOCAL = 60 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ
;	LOCAL = LOCAL < 2 ? 2 # LOCAL
;	CALL SKILLGAGE_F_ADD,ARG,3600,LOCAL
;ENDIF
;スキルゲージが100以上だと100にする
CALL SKILLGAGE_F_SET,ARG,3600,MIN(SKILLGAGE_F_GET(ARG,3600) + L_GP, 100)
IF SKILLGAGE_F_GET(ARG,3600) == 100
	RESULTS = Ｄ．Ｔ ＲＥＡＤＹ！！
	RESULT:1 = 0xdc143c
ELSE
	RESULTS = DEVIL TRIGGER
ENDIF
RESULTS:1 = \%
;スキルゲージが100以上だと100にする
;SIF SKILLGAGE_F_GET(ARG,3600) > 100
;	CALL SKILLGAGE_F_SET,ARG,3600,100
RETURN L_GP

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3600, ARG, ARG:1, ARG:2
#LOCALSIZE 4
IF SKILL_CHANGE(ARG, [[キャラ:단테]]) == 1 && SKILLGAGE_D_GET(ARG, 3600)
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),3600
ELSEIF SKILL_CHANGE(ARG, [[キャラ:트리쉬_DMC]]) == 1 && SKILLGAGE_D_GET(ARG, 3600)
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),3600
ELSEIF FINDCHARA_M(ARG,0,4998,4999) == 1 && SKILLGAGE_D_GET(ARG, 3600) && EQUIP:ARG:검 == 2370
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),3600
ELSEIF FINDCHARA_M(ARG,0,4998,4999) == 1 && SKILLGAGE_D_GET(ARG, 3600) && EQUIP:ARG:검 == 2371
	CALL ATTACK_FIELD,ARG,ARG:1,3600
ELSEIF FINDCHARA_M(ARG,0,4998,4999) == 1 && SKILLGAGE_D_GET(ARG, 3600) && EQUIP:ARG:검 != 2370 && EQUIP:ARG:검 != 2371
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),3600
ELSEIF SKILL_CHANGE(ARG, [[キャラ:버질]]) == 1 && SKILLGAGE_D_GET(ARG, 3600)
	CALL ATTACK_FIELD,ARG, ARG:1,3600
ELSE
	CALL SKILLGAGE_F_SET,ARG,3600,0
	CALL SKILLGAGE_D_SET,ARG,3600,5
	PRINTFORMW %ARG는% 데빌 트리거를 사용해 마인화했다!
ENDIF
