	ELSE
		RESULTS += HTML_RECT_BAR(SKILLGAGE_F_GET(ARG, 3600), 100, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("緑"), RESULT:1)
		RESULTS:1 = DT 게이지
	ENDIF
