;スキル名
@SKILL_NAME_3625, ARG
; 使用者指定なし
IF ARG == -1
	RESULTS = 블리츠대쉬
ELSE
	IF CFLAG:ARG:809 == 1
		RESULTS = 블리츠대쉬
	ELSE
		IF SKILL_CHANGE(ARG, [[キャラ:아큐라_X]]) && GET_RPG_CSTR_TAKEOVER(ARG, "モード") == "X2"
			;ロック中の攻撃
			IF BLITZ_TARGET_JUDG(ARG) == 1
				RESULTS = 록온 휠
			;非ロック中の攻撃
			ELSE
				RESULTS = 브레이크 휠
			ENDIF
		ELSE
			RESULTS = 디바이드
		ENDIF
	ENDIF
ENDIF

;　명중
@SKILL_HITRATE_3625, ARG
IF SKILL_CHANGE(ARG, [[キャラ:아큐라_X]]) && GET_RPG_CSTR_TAKEOVER(ARG, "モード") == "X2"
	;ロック中の攻撃
	IF BLITZ_TARGET_JUDG(ARG) == 1
		RETURN 150
	;非ロック中の攻撃
	ELSE
		RETURN 100
	ENDIF
ELSE
	RETURN 150
ENDIF

;　威力
@SKILL_POWER_3625, ARG
IF SKILL_CHANGE(ARG, [[キャラ:아큐라_X]]) && GET_RPG_CSTR_TAKEOVER(ARG, "モード") == "X2"
	;ロック中の攻撃
	IF BLITZ_TARGET_JUDG(ARG) == 1
		;攻撃回数期待値は(2+3+4+5)*0.25=3.5　なのでダメージ期待値は3.5*65=245
		;「これだけでも戦えなくはない」ぐらいのイメージ
		RETURN 70
	;非ロック中の攻撃
	ELSE
		;攻撃回数3　なのでダメージ期待値は3*100=300
		;X2はブレイクホイールで殴る接近戦仕様
		RETURN 100
	ENDIF
ELSE
	;ロック中の攻撃
	IF BLITZ_TARGET_JUDG(ARG) == 1
		;攻撃回数期待値は(2+3+4+5+6)*0.2=4　なのでダメージ期待値は4*65=260
		;「これだけでも戦えなくはない」ぐらいのイメージ
		RETURN 65
	;非ロック中の攻撃
	ELSE
		;攻撃回数期待値は(1+2+3+4+5)*0.2=3　なのでダメージ期待値は3*50=150
		;心許ないがロックして使うのが基本と思ってもらえれば
		RETURN 50
	ENDIF
ENDIF

;　クリティカル率
;　ヒット数多いのでクリティカルはしないさせない
;　-200でもたまにクリティカルしたのでこれで←0でいいんだってさ
;「ブレイクホイール」の場合だけクリティカルするように
@SKILL_CRITICAL_RATE_3625, ARG
IF SKILL_CHANGE(ARG, [[キャラ:아큐라_X]]) && GET_RPG_CSTR_TAKEOVER(ARG, "モード") == "X2"
	SIF BLITZ_TARGET_JUDG(ARG) != 1
		RETURN 5
	RETURN 0
ELSE
	RETURN 0
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3625, ARG
IF SKILL_CHANGE(ARG, [[キャラ:아큐라_X]]) && GET_RPG_CSTR_TAKEOVER(ARG, "モード") == "X2"
	;ロック中の攻撃
	IF BLITZ_TARGET_JUDG(ARG) == 1
		RETURN 2
	;非ロック中の攻撃
	ELSE
		RETURN 3
	ENDIF
ELSE
	;ロック中の攻撃
	IF BLITZ_TARGET_JUDG(ARG) == 1
		RETURN 2
	;非ロック中の攻撃
	ELSE
		RETURN 1
	ENDIF
ENDIF

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3625, ARG
IF SKILL_CHANGE(ARG, [[キャラ:아큐라_X]]) && GET_RPG_CSTR_TAKEOVER(ARG, "モード") == "X2"
	;ロック中の攻撃
	IF BLITZ_TARGET_JUDG(ARG) == 1
		RETURN 5
	;非ロック中の攻撃
	ELSE
		RETURN 3
	ENDIF
ELSE
	;ロック中の攻撃
	IF BLITZ_TARGET_JUDG(ARG) == 1
		RETURN 6
	;非ロック中の攻撃
	ELSE
		RETURN 5
	ENDIF
ENDIF

