;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_3543,ARG,ARG:1
#LOCALSIZE 2
#DIM L_T
#DIM L_GP
#DIM SKILL_NUM
SKILL_NUM = 3543
;スキルゲージDがある＝変身中の場合離脱
SIF SKILLGAGE_D_GET(ARG,SKILL_NUM) > 0
	RETURN 0
SIF SKILLGAGE_F_GET(ARG,SKILL_NUM) == 100
	RETURN 0
L_GP = 0
;自分の行動の場合
IF ARG == ARG:1
	FOR LOCAL, 0, BCHARANUM
		L_T = BCHARA:LOCAL
		SIF IS_FRIEND(ARG, L_T)
			CONTINUE
		SIF GET_CREC_ACT(ARG, L_T, "HIT")
			L_GP += 5
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 5
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 5
	NEXT
	;気合を入れても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:기합]]
		L_GP += 25
	;集中しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:컨센트레이트]]
		L_GP += 25
	;雄叫びしても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:포효]]
		L_GP += 25
	;挑発しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:도발]]
		L_GP += 25
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える
;IF CFLAG:ARG:현데미지 > 0 || GETBIT(CFLAG:ARG:受けフラグ,18) || GETBIT(CFLAG:ARG:受けフラグ,19)
IF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += MAX(60 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ, 2)
	;LOCAL = LOCAL < 2 ? 2 # LOCAL
	;CALL SKILLGAGE_F_ADD,ARG,SKILL_NUM,LOCAL
ENDIF
;スキルゲージが100以上だと100にする
CALL SKILLGAGE_F_SET,ARG, SKILL_NUM, MIN(SKILLGAGE_F_GET(ARG, SKILL_NUM) + L_GP, 100)
;SIF SKILLGAGE_F_GET(ARG,SKILL_NUM) > 100
;	CALL SKILLGAGE_F_SET,ARG,SKILL_NUM,100
IF SKILLGAGE_F_GET(ARG,SKILL_NUM) >= 30
	RESULTS = ＲＥＳＵＲＲＥＣＴＩＯＮ ＳＴＡＮＤＢＹ！
	RESULT:1 = 0xDD00DD
ELSE
	RESULTS = 魔力蓄積量
ENDIF
RESULTS:1 = \%
RETURN L_GP

