@DISPLAY_COMMAND_P_3543,ARG
IF SKILLGAGE_D_GET(ARG,3543) > 0
	RESULTS = 『망토회귀』:%TOFULL(TOSTR(SKILLGAGE_D_GET(ARG,3543)))%Ｔ
ELSE
	RESULTS = 魔力蓄積量:{SKILLGAGE_F_GET(ARG,3543),3}％
ENDIF
RETURN 3

@SKILL_EX_DISPLAY_3543, ARG, ARGS
IF SKILLGAGE_D_GET(ARG, 3543) > 0
	RESULTS += SET_COLOR_TAG(UNICODE(0x263D), "yellow")
	RESULTS += HTML_RECT_SPLIT_BAR(SKILLGAGE_D_GET(ARG, 3543), 10, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("赤"), RESULT:1)
	RESULTS:1 = 『망토회귀』
ELSE
	IF SKILLGAGE_F_GET(ARG, 3543) < 30
		RESULTS += SET_COLOR_TAG(UNICODE(0x263D), "gray")
	ELSE
		RESULTS += SET_COLOR_TAG(UNICODE(0x263D), "yellow")
	ENDIF
	RESULTS += HTML_RECT_BAR(SKILLGAGE_F_GET(ARG, 3543), 100, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("緑"), RESULT:1)
	RESULTS:1 = 魔力蓄積量
ENDIF
RETURN 1
