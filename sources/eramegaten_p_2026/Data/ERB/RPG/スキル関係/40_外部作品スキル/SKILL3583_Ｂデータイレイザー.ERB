;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3583,ARG
RESULTS = Ｂ데이터이레이저


;　명중
@SKILL_HITRATE_3583, ARG
RETURN 100

;　威力
@SKILL_POWER_3583, ARG
RETURN 160

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3583,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3583,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3583, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3583,ARG
RETURN 39


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3583
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


@SKILL_HEAL_TYPE_3583, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("통상")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3583, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_3583,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3583,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3583, ARG
RETURN GET_SKILL_EFFECT_NUM("회복")


;계승타입
@SKILL_SUCCESSION_TYPE_3583
RETURN GET_SUCCESSION_NUM("회복")

;속도보정
@SKILL_SPEED_3583, ARG = -1
RETURN 5

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3583
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_3583, ARG = -1
RETURN 15

@継承不能_3583
RETURN 1




;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3583, ARG, ARG:1, ARG:2
CALL HEAL_FIELD, ARG, ARG:1, 3583

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_3583,ARG,ARG:1,ARG:2
CALL HEAL_FIELD, ARG, ARG:1, 3583

;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_3583, ARG
PRINTL 아군 전체를 크게 회복한다.
PRINTL 지속되지 않는 배드 스테이터스를 회복한다



;使用条件
@SKILL_SPECIAL_ACTIONABLE_3583,ARG
RETURN 1
;とくにない

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_3583,ARG
SELECTCASE GET_STATE(ARG)
	CASE "PALYZE","CHARM","HAPPY","BIND","PANIC","SLEEP","BOMB","SHOCK","FREEZE","FLAME","SLIP","CLOSE"
		RETURN 1
	CASEELSE
		RETURN 0
ENDSELECT
