;スキル名
@SKILL_NAME_3634, ARG
RESULTS = 클로스랜서
IF FLAG:총공격중
	TSTR:스킬메시지행동자 = RoRo
	TFLAG:스킬행동자컬러 = 0x9933cd
ENDIF

;　명중
@SKILL_HITRATE_3634, ARG
RETURN 120

;　威力
@SKILL_POWER_3634, ARG
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "다크니스트리거Ｘ") && FLAG:총공격중
	;どちらも約1.25倍
	SIF FLAG:확산플래그 == 1
		RETURN 175
	RETURN 100
ELSE
	SIF FLAG:확산플래그 == 1
		RETURN 140
	RETURN 75
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3634, ARG
IF SKILLGAGE_D_GET(ARG, [[스킬:클로스랜서]]) > 0
	RETURN 2
ELSE
	RETURN 1
ENDIF

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3634, ARG
IF SKILLGAGE_D_GET(ARG, [[스킬:클로스랜서]]) > 0
	RETURN 2
ELSE
	RETURN 1
ENDIF

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3634, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3634, ARG
SIF ARG < 0
	RETURN 28
;ダークネストリガー発動中はコスト1/3
SIF SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
	RETURN 9
RETURN 28

;　相性
@SKILL_TYPE_3634, ARG
RETURN GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3634
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3634, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3634, ARG
;ロック中の攻撃・ロック対象に強制
IF ARG >= 0 && NO:ARG == [[キャラ:아큐라_X]] && BLITZ_TARGET_JUDG(ARG) == 1
	RETURN 4
;非ロック中の攻撃・敵単体
ELSE
	RETURN 1
ENDIF

;　사거리
@SKILL_RANGE_3634, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3634, ARG
;ロック中の攻撃・ロック対象に強制
IF BLITZ_TARGET_JUDG(ARG) == 1
	RETURN 4
;非ロック中の攻撃・敵単体
ELSE
	RETURN 1
ENDIF

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3634, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_3634
RETURN GET_SUCCESSION_NUM("비구")

;속도보정
@SKILL_SPEED_3634, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3634
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3634, ARG = -1
RETURN 23

@継承不能_3634
RETURN 1

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_3634, ARG
RETURN GET_STATE_NUM("BIND")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_3634, ARG
RETURN GET_TYPE_NUM("만능")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_3634, ARG
IF SKILLGAGE_D_GET(ARG, [[스킬:클로스랜서]]) > 0
	SIF FLAG:확산플래그 == 1
		RETURN 40
	RETURN 75
ELSE
	SIF FLAG:확산플래그 == 1
		RETURN 30
	RETURN 60
ENDIF

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_3634, ARG
SIF FLAG:확산플래그 == 1
	RETURN 60
IF SKILLGAGE_D_GET(ARG, [[스킬:클로스랜서]]) > 0
	RETURN 95
ELSE
	RETURN 80
ENDIF

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_3634, ARG, ARG:1
#DIM ROCK_H

;ダークネストリガー追撃条件共通
IF DTRIGGER_ABLE(ARG, "클로스랜서")
	ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
	CALL SKILLGAGE_D_SET, ARG, [[스킬:클로스랜서]], 1
	RETURN 1, 200000 + 23
ENDIF
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3634, ARG, ARG:1, ARG:2
#LOCALSIZE 1
#DIM ROCK_H
#DIM 加算クードス

SIF ARG < 0
	RETURN 0
;	CALL ATTACK_SINGLE, ARG, POS(ARG:1), 3634

FLAG:확산플래그 = 0
;ロック中かつロック対象が生存中なら強制的にロック対象へ攻撃
IF ARG:1 == 23 
	IF BLITZ_TARGET_JUDG(ARG) == 1
		SIF FLAG:총공격중
			TFLAG:반사후0데미지화 = 1
		ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
		SIF CFLAG:ROCK_H:보스플래그
			FLAG:확산플래그 = 1
		CALL SKILLGAGE_D_SET, ARG, [[스킬:클로스랜서]], 1
		CALL ATTACK_SINGLE, ARG, ROCK_H, 3634
	ENDIF
ELSE
	LOCAL = POS(ARG:1)
	SIF CFLAG:LOCAL:보스플래그
		FLAG:확산플래그 = 1
	CALL ATTACK_SINGLE, ARG, POS(ARG:1), 3634
ENDIF
FLAG:확산플래그 = 0


;撃破数1につき20の基礎クードスを得る。(上限20)
加算クードス = MIN(GET_CREC_ACT_SUM(ARG, "적", "KILL"), 1) * 20
CALL SET_加算クードス, ARG, 加算クードス

;EXウェポン6番=클로스랜서
SIF HAVE_SKILL(ARG, [[스킬:DARKNESS TRIGGER]])
	CALL SKILLGAGE_F_SET, ARG, [[스킬:DARKNESS TRIGGER]], 6
;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3634, ARG
PRINTL 벡터를 변화시키는 천을 생성하는 셉티마·편향천(벡터드 크로스)을 재현한 EX 웨폰.
PRINTL HP를 소비하는 커맨드 「블리츠대쉬」에 의해 록이 걸린 적이 있을 경우 강제적으로 그 대상을 공격한다.
PRINTL 
PRINTL 공격 대상이 록온 상태인 경우… 적 단체에 비구 상성으로 2회 극소 데미지를 준다.
PRINTL 공격 대상이 비록온 상태인 경우… 적 단체에 비구 상성으로 극소 데미지를 준다.
PRINTL 어느 쪽이든 긴박을 부여하지만 록온 상태일 때 성공률이 상승한다.
IF ARG > 0 && ARG < CHARANUM && IS_CHARA_EQUIPED(ARG, "다크니스트리거Ｘ") && SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
	SETCOLOR 0x9933cd
	PRINTL 다크니스 트리거 X 장비 중　다크니스 트리거에 의한 추격 시 데미지 상승
	RESETCOLOR
ENDIF
PRINTL ※단, 보스를 대상으로 할 경우 긴박 성공률은 저하되고 데미지가 상승한다.
PRINTL ※이 스킬로 적을 쓰러뜨렸을 경우 쿠도스가 20 가산된다

;使用条件
@SKILL_SPECIAL_ACTIONABLE_3634, ARG
;타겟=23が入るのはロック中のみ
;かつ実行時にターゲットが死んだりするとダメ
SIF ARG > 0 && CFLAG:ARG:타겟 == 23 && BLITZ_TARGET_JUDG(ARG) != 1
	RETURN 0
RETURN 1

;継承に必要な部位


