;
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3501,ARG
RESULTS = 가짜얼음검

;　명중
@SKILL_HITRATE_3501, ARG
RETURN 100

;　威力
@SKILL_POWER_3501, ARG
RETURN 290

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3501,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3501,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3501, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3501,ARG
RETURN 15

;　複合相性
@SKILL_TYPE_3501,ARG
RETURN GET_TYPE_NUM("빙결"), GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3501
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　攻撃タイプ
@SKILL_ATTACKTYPE_3501,ARG
RETURN GET_攻撃タイプ_NUM("魔法")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3501, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3501, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3501,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3501,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3501, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3501
RETURN GET_SUCCESSION_NUM("빙결")
;빙결

;속도보정
@SKILL_SPEED_3501, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3501
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3501, ARG = -1
RETURN 7





;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3501, ARG, ARG:1, ARG:2
CALL ATTACK_SINGLE,ARG,POS(ARG:1),3501

;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_3501, ARG
PRINTL 가짜얼음으로 만든 검으로 상대를 벤다　빙결+검격 상성
PRINTL 이 스킬은 마법위력으로 데미지를 계산한다



@継承不能_3501
RETURN 1

;使用条件
@SKILL_SPECIAL_ACTIONABLE_3501,ARG
RETURN 1
;とくにない

