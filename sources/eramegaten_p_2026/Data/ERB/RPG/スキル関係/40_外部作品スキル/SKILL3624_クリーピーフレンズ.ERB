				PRINTFORML ┏>CHARA━━━━━━━━━━┓　┏>ACT━━━━━━━━━━━━━━━━━━┓2
				PRINTFORM ┃[{CPOS(LOCAL),2}] ＵＮＫＮＯＷＮ　　　 ┃　┃
				PRINTFORML %"이어져있어",40,LEFT%┃
				PRINTFORMW ┗━━━━━━━━━━━━━┛　┗━━━━━━━━━━━━━━━━━━━━┛
				RESETCOLOR
				
				IF RAND:10 <= 7
					LOCAL:4 = 1
				ELSE
					LOCAL:4 = 2
				ENDIF
				LOCAL:3 = RAND(6,15)
				$CREEPYFRIENDS_02
				LOCAL:3 ++
				SIF LOCAL:3 == 17
					LOCAL:3 = 7
				IF POS(LOCAL:3) > 0 && GET_STATE(CFLAG:POS(LOCAL:3):상태이상) != "DYING"
					CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL:3), "BS부착률", 4, "단체"
					;CFLAG:POS(LOCAL:3):BS부착률강화 = MIN(4, CFLAG:POS(LOCAL:3):BS부착률강화 + 4)
					;PRINTFORMW 　　TARGET:[{LOCAL:3,2}] %CALLNAME:POS(LOCAL:3),20,LEFT%　>>>>>>　BS付着率が上がった！
				ELSE
					GOTO CREEPYFRIENDS_02
				ENDIF
				IF LOCAL:4 > 0
					LOCAL:4 --
					GOTO CREEPYFRIENDS_02
				ENDIF
			ELSE
				;ランダム1体に精神相性でPANIC
				;【ヨモスガラ・パーティ】特技名
				SETCOLOR 0x33ffcc
				PRINTFORML ┏>CHARA━━━━━━━━━━┓　┏>ACT━━━━━━━━━━━━━━━━━━┓1
				PRINTFORM ┃[{CPOS(LOCAL),2}] ＵＮＫＮＯＷＮ　　　 ┃　┃
				PRINTFORML %"함께놀자",40,LEFT%┃
				PRINTFORMW ┗━━━━━━━━━━━━━┛　┗━━━━━━━━━━━━━━━━━━━━┛
				RESETCOLOR
				LOCAL:3 = RAND(6,15)
				$CREEPYFRIENDS_01
				LOCAL:3 ++
				SIF LOCAL:3 == 17
					LOCAL:3 = 7
				IF POS(LOCAL:3) > 0 && GET_STATE(CFLAG:POS(LOCAL:3):상태이상) != "DYING"
					CALL SKILLGAGE_F_SET,ARG,3624,1
					CALL SINGLE_BADSTATE,ARG,POS(LOCAL:3),3624
					CALL SKILLGAGE_F_SET,ARG,3624,0
				ELSE
					GOTO CREEPYFRIENDS_01
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	PRINTL
	SIF RAND:100 <= 80
		LOCAL:10 --
	IF LOCAL:10 > 0
		GOTO CREEPYFRIENDS_REACT
	ENDIF
	RESETCOLOR
ELSE
	;ここから任意発動時の動作。活性化処理。
	;現在の死霊カウンターを取得
	LOCAL = SKILLGAGE_H_GET(ARG,3622)
	SELECTCASE LOCAL
	CASE 0
		PRINTFORM ＞발동할 수 있을 만큼 사령을 소환하지 않았다!
	CASE 1,2
		LOCAL:2 = 1
	CASE 3,4,5
		LOCAL:2 = 2
	CASE 6,7,8
		LOCAL:2 = 3
	CASE 9,10
		LOCAL:2 = 4
	ENDSELECT
	IF LOCAL != 0
		;Ｄゲージ(ターンが減るほど減少)は5に(残ターン管理)
		CALL SKILLGAGE_D_SET(ARG,3624,5)
		;ＨゲージはＣＰ累積量によって変動させる(レベル管理)
		CALL SKILLGAGE_H_SET(ARG,3624,(LOCAL:2))
		PRINTFORML ＞%CALLNAME:ARG%은(는) 마력을 해방하여, 주위의 사령들을 활성화시켰다!
	ENDIF
ENDIF
