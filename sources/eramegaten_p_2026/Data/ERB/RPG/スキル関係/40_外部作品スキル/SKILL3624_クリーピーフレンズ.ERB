	RETURN 9
CASE 4
	;ポイズンリリックB、POISONかBIND(神経相性)
	RETURN 8
CASE 5,6
	;コッチニオイデ、呪殺相性DYING(確率小)
	;ニガサナイヨ、呪殺相性DYING(確率中)
	RETURN 11
CASEELSE
	RETURN 0
ENDSELECT

