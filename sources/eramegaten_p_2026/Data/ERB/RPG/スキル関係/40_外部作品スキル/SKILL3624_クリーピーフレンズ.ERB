;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_3624,ARG,ARG:1
SIF !GET_CREC_ACT(ARG:1, ARG, "HIT")
	RETURN 0
;SIF !GETBIT(CFLAG:ARG:受けフラグ,18) && !GETBIT(CFLAG:ARG:受けフラグ,19)
;	RETURN 0
LOCAL:2=0
FOR LOCAL,7,17
	SIF POS(LOCAL)>0 && GET_STATE(CFLAG:(POS(LOCAL)):상태이상) != "DYING"
		LOCAL:2++
NEXT
SIF LOCAL:2 == 0
	RETURN 0
;戻り値の-1はシステム側のスキル名表示を省く
SIF RAND:10 < 5 && SKILLGAGE_D_GET(ARG,3624) > 0
	RETURN 1, 0, -1
RETURN 0
;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_3624,ARG,ARG:1
SIF ARG != FLAG:행동순1
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
SIF SKILLGAGE_D_GET(ARG,3624) <= 0 || SKILLGAGE_H_GET(ARG,3622) <= 0 
	;活性残ターンが残っていても死霊カウンターが乗ってないなら発動できない
	RETURN 0
IF CFLAG:ARG:입력행동 == 501 || CFLAG:ARG:입력행동 == 507 || CFLAG:ARG:입력행동 == 1423
;タルカジャ、ラクンダ、カースエピタフなら75%で発動
	SIF RAND:100 <= 75
		RETURN 1, -1
ELSEIF CFLAG:ARG:입력행동 == 3622 
;リビングデッド使用時は30%で発動。どんぶり勘定。
	SIF RAND:100 <= 30
		RETURN 1, -1
ENDIF
RETURN 0
