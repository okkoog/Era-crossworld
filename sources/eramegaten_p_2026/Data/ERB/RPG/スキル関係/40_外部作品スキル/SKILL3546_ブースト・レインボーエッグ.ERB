;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3546, ARG, ARG:1, ARG:2
#LOCALSIZE 4
IF ARG:1 == 22
	LOCAL:2 = 7
	LOCAL:3 = 17
ELSE
	LOCAL:2 = 1
	LOCAL:3 = 7
ENDIF

FOR LOCAL,LOCAL:2,LOCAL:3
	SIF POS(LOCAL) < 0
		CONTINUE
	FOR LOCAL:1,0,6
		CFLAG:POS(LOCAL):회심의패기플래그 = 1
		CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") = MAX(0, CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화"))
		CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") = MIN(32, CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") + 8)
	NEXT
NEXT
SETBIT TFLAG:실드브레이크,0
;SETBIT TFLAG:마카라브레이크,0

PRINTFORMW 　\@ CFLAG:ARG:PT플래그 == 0 ? 적 # 아군 \@의 능력 저하 해제, 전 능력이 대폭 상승하고 필중 상태!
PRINTFORMW 　1턴 동안, 적 사이드의 공격 무효화 상태를 억제!
CALL SKILLGAGE_F_ADD,ARG,3546,1



