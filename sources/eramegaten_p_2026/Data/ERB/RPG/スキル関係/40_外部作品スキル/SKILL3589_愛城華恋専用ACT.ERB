;　 説明文の表示
@SKILL_EXPLAIN_3589, ARG
#LOCALSIZE 1
IF CFLAG:(CHARANUM-1):PT플래그 || ARG < 0 || ARG >= CHARANUM
	PRINTL 【通常時】
	PRINTL 적 1열에 검격 상성의 대 데미지 + 감전
	PRINTL 
	PRINTL 【클라이맥스 레뷰 발동 시】
	PRINTL 무작위 대상에게 고크리티컬 『검격·중력·핵열』 복합 대 데미지 + 아군의 HP 전회복.
ELSE
	;CR展開時
	IF GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
		SETCOLOR 0xff0033
		PRINTL 【ＣＬＩＭＡＸ　ＡＣＴ】
		RESETCOLOR
		PRINTL 동료의 마음과 함께 시대를 일직선으로 달려나가는 킹 아서의 필살기.
		PRINTL 무작위 대상에게 고크리티컬 『검격·중력·핵열』 복합 대 데미지 + 아군의 HP 전회복.
		;愛城パワーアップイベント中かつボスが最終形態時のみ、撃ち放題
		IF GETBIT(イベントフラグ:93:11, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:카렌_무대소녀]])
			SETCOLOR 0xff0033
			PRINTL 혼신의 일격으로 이 레뷰에 결착을!
			RESETCOLOR
		;通常
		ELSE
			PRINTL 사용하면 클라이맥스 레뷰는 종료된다
		ENDIF
		
	;それ以外
	ELSE
		PRINTL 적 1열에 검격 상성의 대 데미지 + 감전
		PRINTL 클라이맥스 레뷰 발동 중에는 성능이 변화한다.
	ENDIF
ENDIF

