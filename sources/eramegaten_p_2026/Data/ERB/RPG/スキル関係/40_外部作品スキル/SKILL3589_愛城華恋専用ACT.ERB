;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3589, ARG, ARG:1, ARG:2
;CR展開時
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	ALIGNMENT CENTER
	SETCOLOR 0xff0033
	PRINTL 【ＣＬＩＭＡＸ　ＡＣＴ】
	RESETCOLOR
	ALIGNMENT LEFT

	;愛城パワーアップイベント中かつボスが最終形態時のみ、ボスの不死フラグを剥がして攻撃
	IF GETBIT(イベントフラグ:93:11, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:카렌_무대소녀]])
		CFLAG:(CHARANUM-1):불사신플래그 = 0
	ENDIF
	
	;何らかの事情によりターゲットが22未満だったら
	IF CFLAG:ARG:타겟 < 22
		;22（全体）をセット
		CFLAG:ARG:타겟 = 22
	ENDIF
	
	;ランダム攻撃処理
	LOCAL = 22
	CALL ATTACK_RAND, ARG, LOCAL, 3589, 1
	PRINTL 
	TFLAG:스킬용1 = 1
	CALL HEAL_FIELD, ARG, 19, 3589
	;愛城パワーアップイベント中かつボスが最終形態時のみ、撃破時に敵が喋る
	IF GETBIT(イベントフラグ:93:11, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:카렌_무대소녀]])
		
		;ボスのHPがぴったり1の場合、『すでに削り切ったけど、攻撃をミスってとどめを刺せていない』状況と見る
		IF BASE:(CHARANUM-1):ＨＰ == 1
			PRINTL
			SETCOLOR COLOR("FRIEND")
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"마지막 한 걸음, 부디 힘을 빌려줘, 모두들――!!",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTL
			ALIGNMENT CENTER
			PRINTFORML ┏━━━━━━━━━━┓
			PRINTFORML ┃　　 　1more！　　　┃
			PRINTFORMW ┗━━━━━━━━━━┛
			RESETCOLOR
			ALIGNMENT LEFT
			
			;テイクツー
			CFLAG:(CHARANUM-1):불사신플래그 = 0
			;CFLAG:ARG:회심의패기플래그 = 1
			TFLAG:필중 = 1
			CALL ATTACK_RAND, ARG, LOCAL, 3589, 1
			
		ENDIF
		
		;ボス撃破
		IF BASE:(CHARANUM-1):ＨＰ < 1
			ALIGNMENT CENTER
			PRINTL
			SETCOLOR 0x777777
			PRINTL The Star remembers it all.　　　　　별은 모든 것을 기억하고 있다
			FORCEWAIT
			PRINTL
			PRINTW When Fury was Passion.　　　　　　　그것은 격앙이 정열이었을 적
			PRINTW When Curse was Faith. 　　　　　　　그것은 주박이 신앙이었을 적
			PRINTW When Escape was Bravery.　　　　　　그것은 도피가 용기였을 적
			PRINTW When Jelousy was Affection. 　　　　그것은 질투가 애정이었을 적
			PRINTW When Despair was Hope.　　　　　　　그것은 절망이 희망이었을 적
			PRINTW When Arrogance was Pride. 　　　　　그것은 오만이 긍지였을 적
			PRINTL
			PRINTW And it shall be bestowed upon you.　가지도록 하렴
			PRINTW the Star which you　　　　　　　　　네가 바라던
			PRINTW have longed for　　　　　　　　　　 그 별을
			PRINTL
			SETCOLOR 0xfdca57
			PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┃　　　　　　　　　이어졌구나, 별의 인연　　　　　　　　　┃
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			FORCEWAIT
			PRINTL 
			ALIGNMENT LEFT
			SETCOLOR 0xff0033
			PRINTL ――내 소원이 이루어졌을 때는
			PRINTL 
			PRINTL 　　　　　믿고 있어줘!
			PRINTL 
			PRINTL 　　누구도 불행하게 만들지 않아!――
			PRINTL 
			RESETCOLOR
			
		ENDIF
	ELSE
		;クライマックスレヴュー終了。ゲージ取得をとめるために-1で送ってむこうで0にする
		CALL SET_ROLE_CFLAG_DUNGEON, ARG,  "클라이맥스레뷰지속시간" , -1
	ENDIF


	ALIGNMENT CENTER
	SETCOLOR 0xff0033
	PRINTW 【ＣＬＩＭＡＸ　ＲＥＶＵＥ／ＦＩＮＩＳＨ】
	PRINTL
	RESETCOLOR
	ALIGNMENT LEFT
;それ以外
ELSE
	;単体攻撃処理
	;LOCAL = POS(ARG:1)
	;CALL ATTACK_SINGLE,ARG,LOCAL,3589
	;やっぱ一列攻撃に
	CALL ATTACK_FIELD,ARG,ARG:1,3589
ENDIF









