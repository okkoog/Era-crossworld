;ディアラマに単体ラク・カジャのせ

;スキル名
@SKILL_NAME_3693,ARG
RESULTS = 오프마인드

;　명중
@SKILL_HITRATE_3693, ARG
RETURN 100

;　威力
@SKILL_POWER_3693, ARG
RETURN 200

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3693,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3693,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3693, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3693,ARG
RETURN 9


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3693
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3693, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_3693,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3693,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3693, ARG
RETURN GET_SKILL_EFFECT_NUM("회복")


;계승타입
@SKILL_SUCCESSION_TYPE_3693
RETURN GET_SUCCESSION_NUM("정신")
;精神（あえて）

;속도보정
@SKILL_SPEED_3693, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3693
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_3693, ARG = -1
RETURN 7


@SKILL_RANKUP_3693
;ランクアップはしない
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3693, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL HEAL_SINGLE,ARG,LOCAL,3693
CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "방어", 4, "단체"


;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_3693,ARG,ARG:1,ARG:2
LOCAL = POS(ARG:1)
CALL HEAL_SINGLE,ARG,LOCAL,3693

;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_3693, ARG
PRINTL 아군 1명을 크게 회복하고 전투 시에는 방어력도 1단계 올린다.
PRINTL 텔레파시로 대상의 정신에 간섭해 자기치유력과 감투정신을 강제로 일깨운다.

@SKILL_EXPLAIN_TOOLTIP_3693, ARG
RESULTS = 아군 1명을 크게 회복한다.



;使用条件
@SKILL_SPECIAL_ACTIONABLE_3693,ARG
RETURN 1
;とくにない

