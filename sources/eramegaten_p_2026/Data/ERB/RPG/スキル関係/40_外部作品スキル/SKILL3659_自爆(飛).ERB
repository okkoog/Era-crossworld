;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3659,ARG
IF SKILL_CHANGE(ARG, [[キャラ:비트볼]])
	RESULTS = 자폭
ELSE
	RESULTS = 자폭(비)
ENDIF

;　명중
@SKILL_HITRATE_3659, ARG
RETURN 300

;　威力
@SKILL_POWER_3659, ARG
RETURN 200

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3659,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3659,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3659, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_3659,ARG
RETURN 0

;　相性
@SKILL_TYPE_3659,ARG
RETURN GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3659
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3659, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3659, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3659,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3659,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3659, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3659
RETURN GET_SUCCESSION_NUM("비구")

;속도보정
@SKILL_SPEED_3659, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3659
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3659, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,3659

SIF CFLAG:ARG:상태이상 < GET_STATE_NUM("DYING")
	CALL VAR_HP,ARG,-BASE:ARG:ＨＰ,"食いしばり無効ダメージ"



;====================================================
;実行内容ここまで
;====================================================

