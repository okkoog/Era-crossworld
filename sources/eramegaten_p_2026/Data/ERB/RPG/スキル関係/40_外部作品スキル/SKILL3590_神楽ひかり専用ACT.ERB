;　 説明文の表示
@SKILL_EXPLAIN_3590, ARG
#LOCALSIZE 1
IF CFLAG:(CHARANUM-1):PT플래그 || ARG < 0 || ARG >= CHARANUM
	PRINTL 【通常時】
	PRINTL 적 전체에 핵열 상성의 대 데미지·방어력 저하 + 자신의 마법 위력을 상승시킨다
	PRINTL 
	PRINTL 【클라이맥스 레뷰 발동 시】
	PRINTL 적 전체에 『핵열·중력·파마』 복합 초특대 데미지 + 만능 상성 HAPPY
ELSE
	;CR展開時
	IF GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
		SETCOLOR 0x5687e6
		PRINTL 【ＣＬＩＭＡＸ　ＡＣＴ】
		RESETCOLOR
		PRINTL 별빛의 빛과 열로 모든 것을 쓸어버리는 아마테라스의 필살기.
		PRINTL 적 전체에 『핵열·중력·파마』 복합 초특대 데미지 + 만능 상성 HAPPY
		;神楽パワーアップイベント中かつボスが最終形態時のみ、撃ち放題
		IF GETBIT(イベントフラグ:93:12, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:히카리]])
			SETCOLOR 0x5687e6
			PRINTL 혼신의 일격으로 이 레뷰에 결착을!
			RESETCOLOR
		;通常
		ELSE
			PRINTL 사용하면 클라이맥스 레뷰는 종료된다
		ENDIF
		
	;それ以外
	ELSE
		PRINTL 적 전체에 핵열 상성의 대 데미지·방어력 저하 + 자신의 마법 위력을 상승시킨다
		PRINTL 클라이맥스 레뷰 발동 중에는 성능이 변화한다.
	ENDIF
ENDIF

