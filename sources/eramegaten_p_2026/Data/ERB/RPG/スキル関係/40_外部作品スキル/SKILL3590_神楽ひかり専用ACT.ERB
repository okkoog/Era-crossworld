;神楽ひかり（星の光のアマテラス）専用スキル

;---
;CAスキルは意図的に強力にする
;使用条件がイベント後半まで進行＆星のティアラをアクセサリー欄に装備＆キラめきチャージ完了時に１発だけ、なので。
;入手の際の代償もあるし、それに見合った性能に。

;通常スキルに使用条件は無し
;だけどこちらも使えるようになるタイミングは同じなので多少は盛る
;---

;クライマックスアクトは全体超特大＋HAPPY、まあ北斗の有情拳みたいなもんだよたぶん
;通常時は全体攻撃・自分魔法攻撃アップ・敵全体防御デバフ。強ない？？？（自問自答）　そのかわり消費重め、命中低め
;クライマックス・アクトは消費無し（そのかわり撃ったらクライマックスレヴュー終了

;Renameは『재생의협주곡』のほうで

;スキル名
@SKILL_NAME_3590,ARG
;CR展開時
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	RESULTS = 八咫鏡・天照毎
ELSE
	RESULTS = 재생의협주곡
ENDIF

;　명중
@SKILL_HITRATE_3590, ARG
;CR展開時
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	RETURN 125
ELSE
	RETURN 80
ENDIF

;高クリティカルではない
;@SKILL_CRITICAL_RATE_3590, ARG
;RETURN 20

;　威力
@SKILL_POWER_3590, ARG
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	RETURN 540
ELSE
	RETURN 340
ENDIF


;　최저공격횟수
@SKILL_MINATTACKNUMBER_3590,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3590,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3590, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3590,ARG
;CR展開時
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	;消費無し（代わりにゲージをゼロに）
	RETURN 0
ELSE
	RETURN 50
ENDIF

;　相性
@SKILL_TYPE_3590,ARG
#LOCALSSIZE 5
#LOCALSIZE 4
;核熱・重力・破魔のうち、最も効果のある相性で攻撃
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	RETURN GET_TYPE_NUM("핵열"), GET_TYPE_NUM("중력"), GET_TYPE_NUM("파마")
ELSE
	RETURN GET_TYPE_NUM("핵열")
ENDIF

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3590
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3590, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3590, ARG
