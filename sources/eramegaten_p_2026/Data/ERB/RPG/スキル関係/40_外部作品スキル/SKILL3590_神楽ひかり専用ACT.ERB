;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_3590, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
SIF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어", -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3590, ARG, ARG:1, ARG:2
#DIM やったかフラグ
;CR展開時
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	ALIGNMENT CENTER
	SETCOLOR 0x5687e6
	PRINTL 【ＣＬＩＭＡＸ　ＡＣＴ】
	RESETCOLOR
	ALIGNMENT LEFT

	;神楽パワーアップイベント中かつボスが最終形態時のみ、ボスの不死フラグを剥がして攻撃
	IF GETBIT(イベントフラグ:93:12, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:히카리]])
		CFLAG:(CHARANUM-1):불사신플래그 = 0
	ENDIF
	
	CALL ATTACK_FIELD,ARG,ARG:1,3590
	
	;神楽パワーアップイベント中かつボスが最終形態時のみ、撃破時に敵が喋る
	IF GETBIT(イベントフラグ:93:12, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:히카리]])
	
		;ボスのHPがぴったり1の場合、『すでに削り切ったけど、攻撃をミスってとどめを刺せていない』状況と見る
		IF BASE:(CHARANUM-1):ＨＰ == 1
			PRINTL
			SETCOLOR COLOR("FRIEND")
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"닿아라!!",72,LEFT%┃
			PRINTFORML ┃%"닿아라!!",72,LEFT%┃
			PRINTFORML ┃%"닿아라아아아아아아아아아아아아아아아아아앗!!",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTL
			ALIGNMENT CENTER
			PRINTFORML ┏━━━━━━━━━━┓
			PRINTFORML ┃　　 　1more！　　　┃
			PRINTFORMW ┗━━━━━━━━━━┛
			RESETCOLOR
			ALIGNMENT LEFT
			
			;テイクツー
			CFLAG:(CHARANUM-1):불사신플래그 = 0
			TFLAG:필중 = 1
			;CFLAG:ARG:회심의패기플래그 = 1
			
			CALL ATTACK_FIELD,ARG,ARG:1,3590
			
		ENDIF
		
		;ボス撃破
		IF BASE:(CHARANUM-1):ＨＰ < 1
			ALIGNMENT CENTER
			PRINTL
			PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┃　　　　　　　　　　　아름다운　빛　　　　　　　　　　　┃
			PRINTL ┃　　　　　　　　　　　그리운　빛　　　　　　　　　　　┃
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┃　　　　　　　　　빛의 별의, 아마테라스　　　　　　　　　┃
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┃　　　　　　우리가, 줄곧 바라왔던 별은――　　　　　　┃
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			FORCEWAIT
			PRINTL 
			ALIGNMENT LEFT
			SETCOLOR 0x5687e6
			PRINTL ――별《너》은 곁에 있었어
			PRINTL 　　　　줄곧 바라왔던　별은――
			PRINTL 
			RESETCOLOR
			
			;神楽ひかりの不死身フラグをリセット
			CFLAG:ARG:불사신플래그 = 0
			
		ENDIF
	ELSE
		;クライマックスレヴュー終了。ゲージ取得をとめるために-1で送ってむこうで0にする
		CALL SET_ROLE_CFLAG_DUNGEON, ARG,  "클라이맥스레뷰지속시간" , -1
	ENDIF

	ALIGNMENT CENTER
	SETCOLOR 0x5687e6
	PRINTW 【ＣＬＩＭＡＸ　ＲＥＶＵＥ／ＦＩＮＩＳＨ】
	PRINTL
	RESETCOLOR
	ALIGNMENT LEFT
;それ以外
ELSE
	
	;全体攻撃処理
	CALL ATTACK_FIELD,ARG,ARG:1,3590
	
	;;敵全体デバフ
	;IF CFLAG:(ARG):PT플래그 == 0
	;	LOCAL:1 = 1
	;	LOCAL:2 = 7
	;ELSE
	;	LOCAL:1 = 7
	;	LOCAL:2 = 17
	;ENDIF
	;FOR LOCAL,LOCAL:1,LOCAL:2
	;	SIF POS(LOCAL) < 0
	;		CONTINUE
	;	CFLAG:POS(LOCAL):방어강화 = MAX(-16, CFLAG:POS(LOCAL):방어강화 - 4)
	;NEXT
	;
	;;自己バフ
	;CFLAG:ARG:마법위력강화 = MIN(32, CFLAG:ARG:마법위력강화 + 4)
	
	;PRINTFORML \@ CFLAG:ARG:PT플래그 == 2 ? 敵 # 味方 \@の防御力を下げた！
	CALL SKILL_SET_カジャンダ, ARG, ARG, "마법위력", 4, "단체", "NOMES"
	PRINTFORMW %CALLNAME:ARG%의 마법 위력이 상승한다!

ENDIF









;====================================================
;実行内容ここまで
