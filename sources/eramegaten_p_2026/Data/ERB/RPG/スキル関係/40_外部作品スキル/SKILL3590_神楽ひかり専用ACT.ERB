;　사거리
@SKILL_RANGE_3590,ARG
;CR展開時
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	RETURN 3
ELSE
	RETURN 3
ENDIF

;　範囲　1単体　2列　3全体　4　敵味方全体
@SKILL_SPHERE_3590,ARG
;CR展開時
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	RETURN 3
ELSE
	RETURN 3
ENDIF

