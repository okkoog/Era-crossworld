;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_3554,ARG
;修羅
SIF !HAVE_SKILL(ARG, [[스킬:분노폭발]])
	RETURN 0
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0 && SKILLGAGE_H_GET(ARG,3554) > 0
	RESULTS '= "재염:" + SET_COLOR_TAG("●" * SKILLGAGE_H_GET(ARG,3554), "赤")
;羅刹
ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1 && SKILLGAGE_D_GET(ARG,3554) > 0
	RESULTS '= SET_COLOR_TAG(TOALIGNMENT("炎熱獄強化", COMMAND_P_LENS - 5, "LEFT") + TOSTR(SKILLGAGE_D_GET(ARG,3554)) + "Ｔ", "赤")
ENDIF
RETURN 3

;　 説明文の表示
@SKILL_EXPLAIN_3554, ARG
IF TFLAG:전투중 == 0
	PRINTL 【修羅】
	PRINTL 사용 시에 자신의 공격, 마법 위력이 상승하고 재염이 하나 쌓인다.
	PRINTL 자신의 공격으로 회심, 약점을 맞히면 재염이 하나 쌓인다.
	PRINTL 【羅刹】
	PRINTL 적 전체에 화염 비율 데미지 + 연소
	PRINTL 자신 또는 아군이 화염 또는 연소 효과의 공격을 행하고, 연소 상태인 적이 있으면 발동
	PRINTL 적 전체에 화염 비율 데미지
ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0 || TFLAG:전투중 == 0
	PRINTL 자신의 공격, 마법 위력이 상승하고 재염이 하나 쌓인다. 재염은 3개까지 모을 수 있다
	PRINTL 재염이 최대치면 실패한다
	PRINTL 트리거: 자신의 공격으로 회심, 약점을 맞히면 재염이 하나 쌓인다.
ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
	PRINTL 하늘을 우러러 포효하며 마그마 연못 같은 것을 만들어 낸다
	PRINTL 적 전체에 화염 속성으로 대상의 현재 HP 10% 데미지(상한 200)를 주고 FLAME을 부여한다
	PRINTL 트리거: 자신 또는 아군의 화염 공격이나 연소 공격 시, FLAME 상태인 적이 있으면 적 전체에 비율 데미지
	PRINTL FLAME 상태인 적에게 화염 속성으로 대상의 최대 HP 15% 데미지(상한 300)를 준다.
	PRINTL 그 외의 적에게 화염 속성으로 대상의 현재 HP 10% 데미지(상한 200)를 준다.
ENDIF


