;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_3554,ARG,ARG:1
;修羅
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	;自分じゃなければNG
	SIF FLAG:행동순1 != ARG
		RETURN 0
	;判定を一回にする
	SIF ARG != ARG:1
		RETURN 0
	;3まで
	SIF SKILLGAGE_H_GET(ARG,3554) >= 3
		RETURN 0
	;LOCAL:1 = 0
	;クリティカル又は弱点を受けているキャラを探す
	;死んでる可能性があるのでキャラ全体くまなく探す
	;FOR LOCAL,0,CHARANUM
	;	SIF CFLAG:LOCAL:PT플래그 == CFLAG:ARG:PT플래그
	;		CONTINUE
	;	SIF RECEIVE_CHECK(LOCAL,"会心") && LOCAL:1 != 41
	;		LOCAL:1 += 41
	;	SIF RECEIVE_CHECK(LOCAL,"약점") && LOCAL:1 != 40
	;		LOCAL:1 += 40
	;	SIF 100 < LOCAL:1
	;		BREAK
	;NEXT
	;LOCAL:1 /= 20
	;40%か80%
	;SIF RAND:5 < LOCAL:1
	;	RETURN 1
	;弱点で40%、クリティカルで40%で両方で80%
	SIF RAND:5 < (GET_CREC_ACT(ARG, -1, "CRT") * 2 + GET_CREC_ACT(ARG, -1, "WEAK") * 2)
		RETURN 1, CPOS(ARG:1)
	RETURN 0
;羅刹
ELSE
	;判定が通るのは1回
	SIF TFLAG:스킬트리거용1
		RETURN 0
	;自分の場合且つ、怒り奥義使用後
	SIF FLAG:행동순1 == ARG && SKILLGAGE_D_GET(ARG,3554) > 0
		GOTO GOKUEN
	SIF !IS_FRIEND(ARG, FLAG:행동순1)
		RETURN 0
	IF CFLAG:(ARG):PT플래그 == 0
		LOCAL:1 = 1
		LOCAL:2 = 7
	ELSE
		LOCAL:1 = 7
		LOCAL:2 = 17
	ENDIF
	;炎上状態の敵が居るか見る
	FOR LOCAL,LOCAL:1,LOCAL:2
		;SIF SKILLGAGE_D_GET(ARG,3554) > 0
		;	BREAK
		IF POS(LOCAL) > -1
			SIF CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("FLAME")
				BREAK
		ENDIF
		SIF LOCAL == LOCAL:2 - 1
			RETURN 0
	NEXT
	SIF !GET_CREC_ACT_SUM(FLAG:행동순1, "적", "HIT", "화염") && !GET_CREC_ACT_SUM(FLAG:행동순1, "적", "バステ", "FLAME")
		RETURN 0
	$GOKUEN
	TFLAG:스킬트리거용1++
	;RESULT:1 = 22
	SIF CFLAG:(ARG):PT플래그 == 0
		RETURN 1, 19
	RETURN 1, 22
ENDIF
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3554, ARG, ARG:1, ARG:2

;修羅
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	IF SKILLGAGE_H_GET(ARG,3554) >= 3
		PRINTL 실패했다!
		RETURN 0
	ENDIF
	PRINTFORM %CALLNAME:ARG%의 
	CALL SKILLGAGE_H_ADD,ARG,3554,1
	IF !FLAG:총공격중
		;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 4)
		;CFLAG:ARG:마법위력강화 = MIN(32, CFLAG:ARG:마법위력강화 + 4)
		CALL SKILL_SET_カジャンダ, ARG, ARG, "攻撃_魔法威力", 4, "단체", "NOMES"
		PRINT 공격·마법 위력이 상승하고, 
	ENDIF
	PRINTL 재염이 하나 늘었다.
	SIF SKILLGAGE_H_GET(ARG,3554) >= 3
		PRINTL 재염이 최대가 되었다.
	WAIT
;羅刹
ELSE
	IF !FLAG:총공격중
		SELECTCASE ARG:1
		CASE 1 TO 6,17,18
			ARG:1 = 19
		CASE 7 TO 16,20,21
			ARG:1 = 22
		CASE 23
			IF CFLAG:(ARG):PT플래그 == 0
				ARG:1 = 19
			ELSE
				ARG:1 = 22
			ENDIF
		ENDSELECT
		TFLAG:스킬용1 = 1
		CALL ATTACK_FIELD,ARG,ARG:1,3554
		;CALL RATE_ATTACK_FIELD,ARG,ARG:1,3554,-1,200 * (1 + (SKILLGAGE_D_GET(ARG,3554) > 0))
	ELSE
		IF ARG:1 == 19
			LOCAL:1 = 1
			LOCAL:2 = 7
		ELSE
			LOCAL:1 = 7
			LOCAL:2 = 17
		ENDIF
		;炎上状態の敵が居るか見る
		FOR LOCAL,LOCAL:1,LOCAL:2
			SIF POS(LOCAL) < 0
				CONTINUE
			SIF CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("DYING")
				CONTINUE
			TFLAG:스킬용2 = 1
			IF CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("FLAME")
				FLAG:확산플래그 = 1
				CALL ATTACK_SINGLE,ARG,POS(LOCAL),3554
				;CALL RATE_ATTACK_SINGLE,ARG,POS(LOCAL),3554,1,300 * (1 + (SKILLGAGE_D_GET(ARG,3554) > 0))
			ELSE
				CALL ATTACK_SINGLE,ARG,POS(LOCAL),3554
				;CALL RATE_ATTACK_SINGLE,ARG,POS(LOCAL),3554,-1,200 * (1 + (SKILLGAGE_D_GET(ARG,3554) > 0))
			ENDIF
			FLAG:확산플래그 = 0
		NEXT
	ENDIF
ENDIF


