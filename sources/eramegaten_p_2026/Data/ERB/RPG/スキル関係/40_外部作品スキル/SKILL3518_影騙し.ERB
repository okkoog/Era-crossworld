;
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3518,ARG
RESULTS = 그림자속임수

;　명중
@SKILL_HITRATE_3518, ARG
RETURN 100

;　威力
@SKILL_POWER_3518, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3518,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3518,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3518, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3518,ARG
RETURN 12

;　相性
@SKILL_TYPE_3518,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3518
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3518, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3518, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3518,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3518,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3518, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3518
RETURN GET_SUCCESSION_NUM("지원")
;속도보정
@SKILL_SPEED_3518, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3518
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3518, ARG = -1
RETURN 23





;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3518, ARG, ARG:1, ARG:2
#LOCALSIZE 1

LOCAL = POS(ARG:1)

CALL SKILL_SET_カジャンダ, ARG, ARG, "명중/회피", 4, "단체", "NOMES"
CALL SKILL_SET_カジャンダ, ARG, LOCAL, "명중/회피", -4, "단체", "NOMES"

PRINTFORML 　　TARGET:[{CPOS(ARG),2}] %CALLNAME:ARG,20,LEFT%　>>>>>>　명중・회피가 올랐다！
PRINTFORMW 　　TARGET:[{ARG:1,2}] %CALLNAME:LOCAL,20,LEFT%　>>>>>>　명중・회피가 내렸다！

;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_3518, ARG
PRINTL 자신의 가짜를 날리는 현혹기
PRINTL 자신의 명중・회피를 올리고、상대의 명중・회피를 낮춘다



;使用条件
@SKILL_SPECIAL_ACTIONABLE_3518,ARG
RETURN 1
;とくにない

