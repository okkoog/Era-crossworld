;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3609,ARG
RESULTS = 롤링블레이즈
SIF SKILL_CHANGE(ARG, [[キャラ:트리쉬_DMC]]) == 1
	RESULTS = 스파크

;　명중
@SKILL_HITRATE_3609, ARG
RETURN 100

;　威力
@SKILL_POWER_3609, ARG
RETURN 250

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3609,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3609,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3609, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_3609,ARG
RETURN 0

;　相性
@SKILL_TYPE_3609,ARG
SIF ARG < 0
	RETURN 0
IF SKILL_CHANGE(ARG, [[キャラ:트리쉬_DMC]]) == 1
	RETURN GET_TYPE_NUM("전격")
ELSE
	RETURN GET_TYPE_NUM("화염")
ENDIF

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3609
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3609, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3609, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3609,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3609,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3609, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3609
RETURN GET_SUCCESSION_NUM("자동효과")

;속도보정
@SKILL_SPEED_3609, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3609
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3609, ARG = -1
RETURN 0


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_3609,ARG
IF SKILL_CHANGE(ARG, [[キャラ:트리쉬_DMC]]) == 1
	RETURN GET_STATE_NUM("SHOCK")
ELSE
	RETURN GET_STATE_NUM("FLAME")
ENDIF


;추가효과상성
@SKILL_ADDTIONAL_TYPE_3609,ARG
IF SKILL_CHANGE(ARG, [[キャラ:트리쉬_DMC]]) == 1
	RETURN GET_TYPE_NUM("전격")
ELSE
	RETURN GET_TYPE_NUM("화염")
ENDIF

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_3609,ARG
RETURN 20

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_3609,ARG
RETURN 66
;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_3609,ARG,ARG:1
SIF !GET_CREC_ACT(ARG:1, ARG, "物理")
	RETURN 0
;SIF !GETBIT(CFLAG:ARG:受けフラグ,18)
;	RETURN 0
;SIF ARG:1 < 0 || GET_STATE(CFLAG:(ARG:1):상태이상) == "DYING"
;	RETURN 0
SIF !RAND:2
	RETURN 0
RETURN 1, CPOS(ARG:1)
;RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3609, ARG, ARG:1, ARG:2
TFLAG:필중 = 1
TFLAG:반사0데미지화 = 1
TFLAG:흡수0데미지화 = 1
CALL ATTACK_SINGLE, ARG, POS(ARG:1), 3609
TFLAG:필중 = 0
TFLAG:반사0데미지화 = 0
TFLAG:흡수0데미지화 = 0

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3609, ARG
IF SKILL_CHANGE(ARG, [[キャラ:트리쉬_DMC]])
	PRINTL 공격을 받으면 전격 상성의 대 데미지로 반격을 행한다
	PRINTL 피크리티컬률이 감소한다.
ELSE
	PRINTL 공격을 받으면 화염 상성의 대 데미지로 반격을 행한다
	PRINTL 피크리티컬률이 감소한다.
ENDIF


