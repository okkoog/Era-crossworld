;スキル名
@SKILL_NAME_3679,ARG
RESULTS = 점프


;　명중
@SKILL_HITRATE_3679, ARG
RETURN 100

;　威力
@SKILL_POWER_3679, ARG
RETURN 40

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3679,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3679,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3679, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3679,ARG
RETURN 6


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3679
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3679, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_3679,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3679,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3679, ARG
RETURN GET_SKILL_EFFECT_NUM("회복")


;계승타입
@SKILL_SUCCESSION_TYPE_3679
RETURN GET_SUCCESSION_NUM("지원")
;속도보정
@SKILL_SPEED_3679, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3679
SIF FLAG:탈출스킬금지
	RETURN 0
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_3679, ARG = -1
RETURN 5




;戦闘中に使用できるか
@SKILL_ACTIONABLE_BATTLE_3679, ARG
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3679, ARG, ARG:1, ARG:2


;====================================================
;実行内容ここまで
;====================================================




;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_3679,ARG,ARG:1,ARG:2
PRINTFORMW %CALLNAME:ARG%은(는) 파티를 데리고 롱 점프를 시도했다.
FLAG:탈출 = 1


;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_3679, ARG
PRINTL 던전에서 탈출한다.
PRINTL 파티 전체를 당신의 세이프하우스로 텔레포트시킨다.

@SKILL_EXPLAIN_TOOLTIP_3679, ARG
RESULTS = 던전에서 탈출한다.



;使用条件
@SKILL_SPECIAL_ACTIONABLE_3679,ARG
RESULTS = 脱出禁止
;脱出スキル禁止フラグ立ってたら使用できない
SIF FLAG:탈출스킬금지
	RETURN 0
RETURN 1

