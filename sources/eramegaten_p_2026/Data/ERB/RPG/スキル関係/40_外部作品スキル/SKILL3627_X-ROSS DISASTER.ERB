;スキル名
@SKILL_NAME_3627, ARG
IF SKILL_CHANGE(ARG, [[キャラ:아큐라_X]]) && CFLAG:ARG:800 >= 99
	RESULTS = STRIKE SAW
ELSEIF SKILL_CHANGE(ARG, [[キャラ:아큐라_X]]) && GET_RPG_CSTR_TAKEOVER(ARG, "モード") == "X2"
	RESULTS = XRoSS STROM
ELSEIF SKILL_CHANGE(ARG, [[キャラ:마더_X2]])
	RESULTS = ATTACK CODE:SS
ELSE
	RESULTS = X-ROSS DISASTER
ENDIF

;　명중
@SKILL_HITRATE_3627, ARG
RETURN 300

;　威力
@SKILL_POWER_3627, ARG
#DIM DIVA_F
#DIM DIVA_H
#DIM DKTG_H
SIF ARG < 0
	RETURN 300
SIF SKILL_CHANGE(ARG, [[キャラ:마더_X2]])
	RETURN 480
DIVA_F = SKILLGAGE_F_GET(ARG, [[스킬:SONG OF DIVA]])
DIVA_H = SKILLGAGE_H_GET(ARG, [[스킬:SONG OF DIVA]])
DKTG_H = SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]])
IF DKTG_H == 1
	RETURN 400
ELSEIF DIVA_F == 1 || DIVA_H == 1
	RETURN 480
ELSE
	RETURN 400
ENDIF

