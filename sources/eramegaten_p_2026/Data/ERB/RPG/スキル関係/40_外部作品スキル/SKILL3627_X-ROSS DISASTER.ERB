	SIF SKILLGAGE_D_GET(ARG, [[스킬:X-ROSS DISASTER]])
		RETURN 0
	RETURN 1
	;リキャストゲージが残っていると不可
	;クワッドカーズより拝借。サンキューシュロットニキ
