;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3627, ARG, ARG:1, ARG:2
#DIM ループ用
#DIM ボス殺したフラグ
#DIM ボス検索配列, 17

ボス殺したフラグ = 0
VARSET ボス検索配列, 0
IF CFLAG:ARG:PT플래그 > 0
	FOR ループ用, 7, 17
		LOCALS = 포지션{ループ用}
		SIF FLAG:LOCALS == -1
			CONTINUE
		SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
			CONTINUE
		;生きてるボスの位置を記録
		SIF CFLAG:(FLAG:LOCALS):보스플래그 == 1
			ボス検索配列:ループ用 = 1
	NEXT
ENDIF

CALL ATTACK_FIELD, ARG, ARG:1, 3627

IF CFLAG:ARG:PT플래그 > 0
	FOR ループ用, 7, 17
		;攻撃前に生きてたボスの場所じゃないなら飛ばすぞ
		SIF ボス検索配列:ループ用 == 0
			CONTINUE
		LOCALS = 포지션{ループ用}
		;この攻撃でボスが死んだら
		IF FLAG:LOCALS == -1
			ボス殺したフラグ += 1
		ELSEIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
			ボス殺したフラグ += 1
		ENDIF
	NEXT
ENDIF

IF ボス殺したフラグ > 0
	IF SKILL_CHANGE(ARG, [[キャラ:아큐라_X]]) && GET_RPG_CSTR_TAKEOVER(ARG, "モード") == "X2"
		PRINTFORMW X BREAK!!　Kudos + 500
	ELSE
		PRINTFORMW SP FINISH　Kudos + 500
	ENDIF
	SIF SKILLGAGE_F_GET(ARG, [[스킬:블리츠대쉬]]) == 0
		CALL SKILLGAGE_F_SET, ARG, [[스킬:블리츠대쉬]], 1
ENDIF

;時間で減少するDゲージに10をセット→やっぱ5に変更
;SIF CFLAG:ARG:PT플래그 > 0
	CALL SKILLGAGE_D_ADD, ARG, [[스킬:X-ROSS DISASTER]], 5

;クードス没収
SIF SKILLGAGE_F_GET(ARG, [[스킬:블리츠대쉬]]) > 0
	PRINTFORML ＞%CALLNAME:ARG%의 쿠도스가 리셋되었다!
SIF HAVE_SKILL(ARG, [[스킬:블리츠대쉬]])
	CALL SKILLGAGE_F_SET, ARG, [[스킬:블리츠대쉬]], 0
;モード・ディーヴァ終了（ブリッツダッシュ側で終了させてもいいんだが）
SIF HAVE_SKILL(ARG, [[스킬:SONG OF DIVA]])
	CALL SKILLGAGE_F_SET, ARG, [[스킬:SONG OF DIVA]], 0
IF SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
	;ダークネストリガー終了（もう使えない）
	CALL SKILLGAGE_H_SET, ARG, [[스킬:DARKNESS TRIGGER]], 2
	PRINTL ＞모드 다크니스 강제 종료!
ENDIF
;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3627, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:마더_X2]]
	PRINTL 마더의 SP 스킬.
	;ストライクソウのオマージュ
	PRINTL 춤추는 것은 나의 절조, 토멸할 것은 가치 없는 세계. 종언을 가져오는 무진의 절조.
	PRINTL 　
	PRINTL 적 전체에 만능 상성으로 대 데미지를 준다.
	PRINTL 단, 사용 후에는 쿠도스가 0이 되며 재사용까지 5턴의 쿨타임을 요한다.
ELSE
	PRINTL 아큐라와 RoRo의 SP 스킬.
	IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:아큐라_X]] && GET_RPG_CSTR_TAKEOVER(ARG, "モード") == "X2"
		PRINTL 모든 것을 찢어발기는 조류, 빛과 어둠은 눈 깜짝할 사이에 폭포처럼 달려나간다.
	ELSE
		PRINTL 굳건한 신념 아래 두 사람은 두 자루의 칼날이 되어 가열찬 춤을 연출한다.
	ENDIF
	PRINTL 　
	PRINTL 적 전체에 만능 상성으로 대 데미지를 준다.
	PRINTL 모드 디바 및 모드 어웨이크닝 발동 시 위력이 증가한다.
	PRINTL 단, 사용 후에는 쿠도스가 0이 되며 재사용까지 5턴의 쿨타임을 요한다.
ENDIF

;継承に必要な部位


;使用条件
@SKILL_SPECIAL_ACTIONABLE_3627, ARG
