	RETURN 3
;LV55以上　7回
IF BASE:ARG:LV > 54
	RETURN 7
;LV40以上　6回
ELSEIF BASE:ARG:LV > 39
	RETURN 6
;LV30以上　5回
ELSEIF BASE:ARG:LV > 29
	RETURN 5
;LV20以上　4回
ELSEIF BASE:ARG:LV > 19
	RETURN 4
;それ以外　3回
ELSE
	RETURN 3
ENDIF

