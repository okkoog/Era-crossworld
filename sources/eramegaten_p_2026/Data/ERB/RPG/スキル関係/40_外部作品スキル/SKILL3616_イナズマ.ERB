;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;
;自分の攻撃がヒットした敵に対して発動する
;
;元は攻撃元と同じ対象・範囲を狙うとなっていましたが、単体をすると落ちる仕様になっていたのと
;おそらく本当に作りたかった挙動はこちらなんじゃないかなということで条件を変えました。
;また、イナズマ起動ターンは追撃しない代わりに持続を1ターン延長しました(=使用ターンを含まずに3ターン)
;(2022/10/23 P)
;====================================================
@SKILL_TRIGGER_ACTIONABLE_3616,ARG,ARG:1
;自分じゃなければNG
SIF ARG != FLAG:행동순1
	RETURN 0
;対象が味方なら判定しない
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
;SIF ARG != ARG:1
;	RETURN 0
;ゲージがなければ不発
SIF !INRANGE(SKILLGAGE_D_GET(ARG,3616), 1, 3)
	RETURN 0
SIF !GET_CREC_ACT(ARG, ARG:1, "HIT")
	RETURN 0
RETURN 1, CPOS(ARG:1)
;CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
;SIF RESULT != 1 || CFLAG:ARG:타겟 < 1
