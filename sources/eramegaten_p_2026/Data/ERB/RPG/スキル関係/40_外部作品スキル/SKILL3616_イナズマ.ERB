;		RETURN 0
;	RESULT:1 = CFLAG:ARG:타겟
;ELSEIF CFLAG:ARG:타겟 < 20
;	RESULT:1 = 19
;ELSE
;	RESULT:1 = 22
;ENDIF
;RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3616, ARG, ARG:1, ARG:2
#LOCALSIZE 4
IF SKILLGAGE_D_GET(ARG,3616) == 0
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),3616,1
	CALL SKILLGAGE_D_SET,ARG,3616,4
	PRINTFORML ＞ 4턴 동안 전격에 의한 추격이 발동하게 되었다
ELSE
	IF FLAG:총공격중
		CALL ATTACK_SINGLE,ARG,POS(ARG:1),3616
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,3616
	ENDIF
ENDIF
;WAIT

;ハイボルテージのゲージが蓄積していればコンボ判定、
SIF SKILLGAGE_H_GET(ARG, 3617) == 1
	CALL SKILLGAGE_H_SET,ARG,3617,2


