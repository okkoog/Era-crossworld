;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3616,ARG
RESULTS = 이나즈마
SIF SKILLGAGE_D_GET(ARG, 3600)
	RESULTS = 이나즈마 2

;　명중
@SKILL_HITRATE_3616, ARG
RETURN 100

;　威力
@SKILL_POWER_3616, ARG
RETURN 100

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3616,ARG
IF ARG > -1
	IF SKILLGAGE_D_GET(ARG,3616) && SKILLGAGE_D_GET(ARG, 3600)
		RETURN 2
	ELSE
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3616,ARG
IF ARG > -1
	IF SKILLGAGE_D_GET(ARG,3616) && SKILLGAGE_D_GET(ARG, 3600)
		RETURN 2
	ELSE
		RETURN 1
	ENDIF
ENDIF
RETURN 1

