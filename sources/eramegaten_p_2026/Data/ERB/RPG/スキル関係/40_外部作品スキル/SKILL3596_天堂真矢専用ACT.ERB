;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3596,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3596, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3596,ARG
;CR展開時
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	;消費無し（代わりにゲージをゼロに）
	RETURN 0
ELSE
	RETURN 18
ENDIF

;　複合相性
@SKILL_TYPE_3596,ARG
;電撃・核熱・戦技のうち、最も効果のある相性で攻撃
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	RETURN GET_TYPE_NUM("전격"), GET_TYPE_NUM("핵열"), GET_TYPE_NUM("전술")
ELSE
	RETURN GET_TYPE_NUM("전격")
ENDIF

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3596
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
