;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_3596,ARG
SIF ARG < 0
	RETURN 0
SIF !INRANGE(CFLAG:ARG:타겟, 1, 16)
	RETURN 0
SIF POS(CFLAG:ARG:타겟) < 0
	RETURN 0
SIF !TFLAG:스킬용1
	RETURN 0
SIF CFLAG:POS(CFLAG:ARG:타겟):상태이상 != GET_STATE_NUM("SHOCK")
	RETURN 0
RETURN GET_STATE_NUM("DYING")


;추가효과상성
@SKILL_ADDTIONAL_TYPE_3596,ARG
RETURN GET_TYPE_NUM("만능")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_3596,ARG
SIF ARG < 0
	RETURN 0
SIF !INRANGE(CFLAG:ARG:타겟, 1, 16)
	RETURN 0
SIF POS(CFLAG:ARG:타겟) < 0
	RETURN 0
SIF !TFLAG:스킬용1
	RETURN 0
SIF CFLAG:POS(CFLAG:ARG:타겟):상태이상 != GET_STATE_NUM("SHOCK")
	RETURN 0
RETURN 999

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_3596,ARG
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3596, ARG, ARG:1, ARG:2
;CR展開時
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	ALIGNMENT CENTER
	SETCOLOR 0xffffff
	PRINTL 【ＣＬＩＭＡＸ　ＡＣＴ】
	RESETCOLOR
	ALIGNMENT LEFT

	;天堂真矢パワーアップイベント中かつボスが最終形態時のみ、ボスの不死フラグを剥がして攻撃
	IF GETBIT(イベントフラグ:93:18, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:마야_무대소녀]])
		CFLAG:(CHARANUM-1):불사신플래그 = 0
	ENDIF
	
	;デ・クンダ部分
	IF CFLAG:(ARG):PT플래그 == 0
		LOCAL:2 = 7
		LOCAL:3 = 17
	ELSE
		LOCAL:2 = 1
		LOCAL:3 = 7
	ENDIF

	FOR LOCAL,LOCAL:2,LOCAL:3
		SIF POS(LOCAL) < 0
			CONTINUE
		FOR LOCAL:1,0,6
			CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") = MAX(0, CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화"))
		NEXT
	NEXT
	PRINTFORML \@ CFLAG:ARG:PT플래그 > 0 ? 아군 # 적 \@의 약화가 날아갔다!
	
	;デ・カジャ部分
	IF CFLAG:(ARG):PT플래그 == 0
		LOCAL:2 = 1
		LOCAL:3 = 7
	ELSE
		LOCAL:2 = 7
		LOCAL:3 = 17
	ENDIF
	FOR LOCAL,LOCAL:2,LOCAL:3
		SIF POS(LOCAL) < 0
			CONTINUE
		FOR LOCAL:1,0,6
			CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") = MIN(0, CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화"))
		NEXT
	NEXT
	PRINTFORML \@ CFLAG:ARG:PT플래그 ? 적 # 아군 \@의 강화가 날아갔다!
	
	IF ARG:1 > 16
		CALL RANDOM_TARGET,ARG,3596
		ARG:1 = CFLAG:ARG:타겟
	ENDIF
	
	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,3596

	;天堂真矢パワーアップイベント中かつボスが最終形態時のみ、撃破時に天堂真矢が喋る
	IF GETBIT(イベントフラグ:93:18, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:마야_무대소녀]])
	
		;ボスのHPがぴったり1の場合、『すでに削り切ったけど、攻撃をミスってとどめを刺せていない』状況と見る
		IF BASE:(CHARANUM-1):ＨＰ == 1
			PRINTL
			SETCOLOR COLOR("FRIEND")
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"놓칠 것 같으냐아앗!!",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTL
			ALIGNMENT CENTER
			PRINTFORML ┏━━━━━━━━━━┓
			PRINTFORML ┃　　 　1more！　　　┃
			PRINTFORMW ┗━━━━━━━━━━┛
			RESETCOLOR
			ALIGNMENT LEFT
			
			;テイクツー
			CFLAG:(CHARANUM-1):불사신플래그 = 0
			TFLAG:필중 = 1
			;CFLAG:ARG:회심의패기플래그 = 1
			
			CALL ATTACK_SINGLE,ARG,LOCAL,3596
			
		ENDIF
		
		;ボス撃破
		IF BASE:(CHARANUM-1):ＨＰ < 1
			ALIGNMENT CENTER
			PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┃　　　　　　죽어버린 별이, 별자리를 이루었다……?　　　　　　┃
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┃　　　　　　사랑스러운 아스테리오스여, 나와 함께　　　　　┃
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┃　　　　　　　　　하늘의 빛은 모두 별……　　　　　　　　┃
			PRINTL ┃　　　　　　　　　별의 빛은, 전부, 사랑!　　　　　　　　　┃
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTL 
			ALIGNMENT LEFT
			SETCOLOR 0xffffff
			PRINTL 　　　――일어서라 Star Divine! 몇 번을 상처입더라도――
			PRINTL 
			SETCOLOR 0xcbc6cc
			PRINTL 　　　　　　　　――무대에서 살아가고 있어――
			PRINTL 
			SETCOLOR 0xffffff
			PRINTL 　　　　　　　　――칼끝에 영광 깃들어라!――
			PRINTL
			
		ENDIF
	ELSE
		;クライマックスレヴュー終了。ゲージ取得をとめるために-1で送ってむこうで0にする
		CALL SET_ROLE_CFLAG_DUNGEON, ARG,  "클라이맥스레뷰지속시간" , -1
	ENDIF

	ALIGNMENT CENTER
	SETCOLOR 0xffffff
	PRINTW 【ＣＬＩＭＡＸ　ＲＥＶＵＥ／ＦＩＮＩＳＨ】
	PRINTL
	RESETCOLOR
	ALIGNMENT LEFT
	;クライマックスレヴュー終了
	;CALL SET_ROLE_CFLAG_DUNGEON, ARG,  "클라이맥스레뷰지속시간" , 0

;それ以外
ELSE
	TFLAG:스킬용1 = 1
	CALL ATTACK_FIELD,ARG,ARG:1,3596
	
	;ナイスショート部分
	;IF CFLAG:(ARG):PT플래그 == 0
	;	LOCAL:7 = 1
	;	LOCAL:8 = 4
	;ELSE
	;	LOCAL:7 = 7
	;	LOCAL:8 = 12
	;ENDIF

	;FOR LOCAL,LOCAL:7,LOCAL:8
	;	LOCALS = 포지션{LOCAL}
	;	SIF FLAG:LOCALS < 0
	;		CONTINUE
	;	
	;	SIF CFLAG:(FLAG:LOCALS):상태이상 != GET_STATE_NUM("SHOCK")
	;		CONTINUE
	;	PRINTFORM 　　TARGET:[{LOCAL,2}] %CALLNAME:(FLAG:LOCALS),20,LEFT%　>>>>>>　
	;	CALL ATTACK_BADSTATE,ARG,FLAG:LOCALS,GET_STATE_NUM("DYING"),17,200,95
	;NEXT
	
ENDIF





;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3596, ARG
#LOCALSIZE 1
IF CFLAG:(CHARANUM-1):PT플래그 || ARG < 0 || ARG >= CHARANUM
	PRINTL 【通常時】
	PRINTL 적 일렬에 전기 상성의 대 데미지 + 감전 상태인 적을 즉사시킨다
	PRINTL 
	PRINTL 【클라이맥스 레뷰 발동 시】
	PRINTL 적 1체에 『전격·핵열·전기』 복합 초특대 데미지 + 모든 아군 약화 해제 + 모든 적 강화 해제
ELSE
	;CR展開時
	IF GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
		SETCOLOR 0xFFFFFF
		PRINTL 【ＣＬＩＭＡＸ　ＡＣＴ】
		RESETCOLOR
		PRINTL 하늘에 번뜩이는 뇌정으로 모든 것을 산산조각 내는 대주신 제우스의 필살기.
		PRINTL 적 1체에 『뇌격·핵열·전기』 복합 초특대 데미지 + 모든 아군의 약화를 해제하고 모든 적의 강화를 해제한다.
		;天堂真矢パワーアップイベント中かつボスが最終形態時のみ撃ち放題
		IF GETBIT(イベントフラグ:93:18, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:마야_무대소녀]])
			SETCOLOR 0xFFFFFF
			PRINTL 혼신의 일격으로 이 레뷰에 결착을!
			RESETCOLOR
		;通常
		ELSE
			PRINTL 사용하면 클라이맥스 레뷰는 종료된다
		ENDIF
	ELSE
		PRINTL 적 일렬에 전기 상성의 대 데미지 + 감전 상태인 적을 즉사시킨다
		PRINTL 클라이맥스 레뷰 발동 중에는 성능이 변화한다.
	ENDIF
ENDIF

