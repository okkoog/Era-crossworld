;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3651, ARG, ARG:1, ARG:2
#DIM L_P
#DIM L_T
#DIM LCOUNT
L_P = ARG
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	CALL SKILL_SET_カジャンダ, L_P, L_T, "命中_防御", 4, "短縮", "NOMES"
	CALL HEAL_SINGLE, L_P, L_T, 3651, 1, , "↑ 命中率・回避率"
NEXT
WAIT
