
;スキル名
@SKILL_NAME_3650,ARG
RESULTS = 이미트웨폰

;　명중
@SKILL_HITRATE_3650, ARG
RETURN 100

;　威力
@SKILL_POWER_3650, ARG
RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3650,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3650,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3650, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3650,ARG
RETURN 2

;　相性
@SKILL_TYPE_3650,ARG
SIF FLAG:확산플래그
	RETURN FLAG:확산플래그 - 1
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3650
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3650, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3650, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_3650,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3650,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3650, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3650
RETURN GET_SUCCESSION_NUM("검격")

;속도보정
@SKILL_SPEED_3650, ARG = -1
RETURN 10


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3650
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3650, ARG = -1
RETURN 8





;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3650, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
IF LOCAL < 0
	;指定した味方が死んでたら自分の属性をもってくる
	LOCAL = ARG
ENDIF
FLAG:확산플래그 = ABL:LOCAL:공격상성 + 1
IF CFLAG:(ARG):PT플래그 == 0
    LOCAL:1 = 19
ELSE
    LOCAL:1 = 22
ENDIF
CALL ATTACK_FIELD, ARG, LOCAL:1, 3650,1
;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3650, ARG
PRINTL 아군 1명의 공격 상성으로 적 전체에 대 데미지.



@継承不能_3650
RETURN 1

;使用条件
@SKILL_SPECIAL_ACTIONABLE_3650,ARG
RETURN 1
;とくにない




