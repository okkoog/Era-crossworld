;뇌격
;敵全体ランダムに6～8回の雷撃を放つ　想定コスト20　想定総合火力420～560

;スキル名
@SKILL_NAME_9008,ARG
RESULTS = 뇌격

;　명중
@SKILL_HITRATE_9008, ARG
;ライトニングシューター装備の場合、命中が100まで上昇
RETURN 70

@SKILL_POWER_9008, ARG
RETURN 70

;　최저공격횟수
@SKILL_MINATTACKNUMBER_9008,ARG
RETURN 6

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_9008,ARG
RETURN 8

;一体辺りの最大ＨＩＴ数
@SKILL_MAXATK_PER_9008,ARG
RETURN 5

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_9008, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_9008,ARG
;ライトニングシューターを装備している場合
IF ARG >= 0 && EQUIP:ARG:총 == GETNUM(ITEM, "라이트닝슈터")
	RETURN 20
ELSE
	RETURN 25
ENDIF

;　相性
@SKILL_TYPE_9008,ARG
RETURN GET_TYPE_NUM("전격")
;전격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_9008
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_9008, ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_9008, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_9008,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_9008,ARG
RETURN GET_SPHERE_NUM("전체")

;スキルがランダム範囲かどうか
@SKILL_RAND_TARGET_9008,ARG
RETURN 1

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_9008, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_9008
RETURN GET_SUCCESSION_NUM("전격")

@継承不能_9008
RETURN 1
;不可

;속도보정
@SKILL_SPEED_9008, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_9008
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_9008, ARG = -1
RETURN 15




;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_9008, ARG, ARG:1, ARG:2
CALL ATTACK_RAND,ARG,ARG:1,9008






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_9008, ARG
PRINTL 뇌둔 스킬
PRINTL 라이트닝 슈터를 난사해 강력한 번개를 꽂아 넣는다
PRINTL 적 전체 랜덤으로 6~8회의 뇌격을 날린다




;使用条件
@SKILL_SPECIAL_ACTIONABLE_9008,ARG
RETURN 1
;とくにない

