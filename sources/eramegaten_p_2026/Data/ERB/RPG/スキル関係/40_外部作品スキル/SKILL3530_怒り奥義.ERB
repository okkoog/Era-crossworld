@SKILL_NAME_3530,ARG
IF TFLAG:전투중 == 0
	RESULTS = 분노오의
ELSEIF SKILL_CHANGE(ARG,[[キャラ:나코루루]])
	;修羅
	IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
		RESULTS = 암베 야트로
		SIF SKILLGAGE_H_GET(ARG,3530) == 1
			RESULTS = ｴﾚﾙｼ・ｶﾑｲ・ﾘﾑｾ
		SIF SKILLGAGE_H_GET(ARG,3530) == 2
			RESULTS = 레라 오 카무이
	;羅刹
	ELSE
		RESULTS = 이메루 시키테
		SIF SKILLGAGE_H_GET(ARG,3530) == 1
			RESULTS = ﾇﾍﾟｷ・ﾚﾗ・ｼｷﾃ
		SIF SKILLGAGE_H_GET(ARG,3530) == 2
			RESULTS = ｱﾙ.ﾚﾀﾗ.ｶﾑｲﾌﾑ.ﾏｷﾘ
	ENDIF
ELSEIF SKILL_CHANGE(ARG,[[キャラ:리무루루]])
	RESULTS = 왓카 시쿠테
	;修羅
	IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
		SIF SKILLGAGE_H_GET(ARG,3530) == 1
			RESULTS = ﾙﾌﾟｼ・ｶﾑｲ・ｴﾑｼ
		SIF SKILLGAGE_H_GET(ARG,3530) == 2
			RESULTS = 아투이 시쿠테
	;羅刹
	ELSE
		SIF SKILLGAGE_H_GET(ARG,3530) == 1
			RESULTS = ﾙﾔﾝﾍ・ｺﾝﾙ・ﾉﾁｩ
		SIF SKILLGAGE_H_GET(ARG,3530) == 2
			RESULTS = 콘루스투포로
	ENDIF
ELSEIF SKILL_CHANGE(ARG,[[キャラ:카즈키]])
	RESULTS = 炎滅
	;修羅
	IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
		SIF SKILLGAGE_H_GET(ARG,3530) == 1
			RESULTS = 挟撃火達磨大突進
		SIF SKILLGAGE_H_GET(ARG,3530) == 2
			RESULTS = 極大災炎
	;羅刹
	ELSE
		SIF SKILLGAGE_H_GET(ARG,3530) == 1
			RESULTS = 炎邪覚醒
		SIF SKILLGAGE_H_GET(ARG,3530) == 2
			RESULTS = 三千大千世界全焦土
	ENDIF
ELSE
	RESULTS = 분노오의
ENDIF

