@ACTION_3530, ARG, ARG:1, ARG:2
#LOCALSIZE 5
#DIM STOCK,6
CALL SKILL_NAME_3530, ARG
TSTR:스킬용1 '= RESULTS
IF SKILL_CHANGE(ARG,[[キャラ:나코루루]])
	;STOCK:0 = MAXBASE:ARG:공격
	;STOCK:1 = CFLAG:ARG:공격강화
	;MAXBASE:ARG:공격 = MAXBASE:ARG:마법위력
	;CFLAG:ARG:공격강화 = CFLAG:ARG:마법위력강화
	;修羅
	IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
		IF SKILLGAGE_H_GET(ARG,3530) == 0
			CALL ATTACK_SPREAD,ARG,ARG:1,3530
		ELSEIF SKILLGAGE_H_GET(ARG,3530) > 0
			CALL ATTACK_FIELD,ARG,ARG:1,3530
			;PT判定
			IF CFLAG:(ARG):PT플래그 == 0
				LOCAL:1 = 1
				LOCAL:2 = 7
				LOCAL:3 = 7
				LOCAL:4 = 17
			ELSE
				LOCAL:1 = 7
				LOCAL:2 = 17
				LOCAL:3 = 1
				LOCAL:4 = 7
			ENDIF
			;敵
			FOR LOCAL,LOCAL:1,LOCAL:2
				SIF POS(LOCAL) < 0
					CONTINUE
				CFLAG:POS(LOCAL):공격강화 = MAX(-32, CFLAG:POS(LOCAL):공격강화 - 4)
				CFLAG:POS(LOCAL):마법위력강화 = MAX(-32, CFLAG:POS(LOCAL):마법위력강화 - 4)
			NEXT
			PRINTFORML \@ LOCAL:1 == 7 ? 적 # 아군 \@의 공격력, 마법 위력을 낮췄다!
			PRINTL 
			;味方
			FOR LOCAL,LOCAL:3,LOCAL:4
				SIF POS(LOCAL) < 0
					CONTINUE
				CFLAG:POS(LOCAL):방어강화 = MIN(32, CFLAG:POS(LOCAL):방어강화 + 4)
				CFLAG:POS(LOCAL):마법효과강화 = MIN(32, CFLAG:POS(LOCAL):마법효과강화 + 4)
			NEXT
			IF SKILLGAGE_H_GET(ARG,3530) == 2
				TFLAG:스킬용3 = 1
				CALL HEAL_FIELD, ARG, 19, 3530
			ENDIF
			PRINTFORMW %@"\@ LOCAL:3 == 1 ? 아군 # 적 \@의 방어력, 마법 효과가 올라갔다!"%
			CALL SKILLGAGE_D_SET,ARG,[[스킬:분노폭발]],0
		ENDIF
	;羅刹
	ELSE
		CALL ATTACK_SINGLE,ARG,POS(ARG:1),3530
		IF SKILLGAGE_H_GET(ARG,3530) == 0
			CFLAG:ARG:마법위력강화 = MIN(32, CFLAG:ARG:마법위력강화 + 4)
			PRINTFORMW %CALLNAME:ARG%의 마법 위력이 올라갔다!
		ELSE
			CALL SKILLGAGE_D_SET,ARG,[[스킬:분노폭발]],0
		ENDIF
	ENDIF
	;MAXBASE:ARG:공격 = STOCK:0
	;CFLAG:ARG:공격강화 = STOCK:1
ELSEIF SKILL_CHANGE(ARG,[[キャラ:리무루루]])
	IF SKILLGAGE_H_GET(ARG,3530) == 0
		CALL ATTACK_FIELD,ARG,ARG:1,3530
	;修羅
	ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
		SELECTCASE ARG:1
		CASE 1 TO 6,17,18,19
			LOCAL = 22
		CASE 7 TO 16,20,21,22
			LOCAL = 19
		CASEELSE
			IF INRANGE(CPOS(ARG), 1, 6)
				LOCAL = 19
			ELSE
				LOCAL = 22
			ENDIF
		ENDSELECT
		
		CALL ATTACK_FIELD,ARG,ARG:1,3530
		SIF SKILLGAGE_H_GET(ARG,3530) == 2
			CALL HEAL_FIELD,ARG,LOCAL,3530
		CALL SKILLGAGE_D_SET,ARG,[[스킬:분노폭발]],0
	;羅刹
	ELSE
		IF SKILLGAGE_H_GET(ARG,3530) == 1
			CALL ATTACK_RAND,ARG,ARG:1,3530
			CALL SKILLGAGE_D_SET,ARG,[[스킬:분노폭발]],0
		ELSEIF SKILLGAGE_H_GET(ARG,3530) == 2
			LOCAL = POS(ARG:1)
			TFLAG:스킬용1 = 1
			CALL ATTACK_SINGLE, ARG, LOCAL, 3530
			;CALL RATE_ATTACK_SINGLE,ARG,LOCAL,3530,-2,1800
			TFLAG:스킬용1 = 0
			STOCK:0 = MAXBASE:ARG:공격
			STOCK:1 = CFLAG:ARG:공격강화
			MAXBASE:ARG:공격 = MAXBASE:ARG:마법위력
			CFLAG:ARG:공격강화 = CFLAG:ARG:마법위력강화
			
			CALL ATTACK_SINGLE, ARG, LOCAL, 3530
			
			MAXBASE:ARG:공격 = STOCK:0
			CFLAG:ARG:공격강화 = STOCK:1
			SIF CFLAG:LOCAL:현데미지 > 0
				CALL SKILLGAGE_D_SET,ARG,[[스킬:분노폭발]],0
		ENDIF
	ENDIF
ELSEIF SKILL_CHANGE(ARG,[[キャラ:카즈키]])
	IF SKILLGAGE_H_GET(ARG,3530) == 0
		CALL ATTACK_SPREAD,ARG,ARG:1,3530
		IF BASE:ARG:ＨＰ > 0 && CFLAG:ARG:상태이상 != 15
			CFLAG:ARG:명중강화 = MIN(32, CFLAG:ARG:명중강화 + 4)
			CFLAG:ARG:회피강화 = MIN(32, CFLAG:ARG:회피강화 + 4)
			PRINTFORMW %CALLNAME:ARG%의 명중·회피가 올라갔다!
		ENDIF
	;修羅
	ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
		FLAG:확산플래그 = 0
		LOCAL = POS(ARG:1)
		IF SKILLGAGE_H_GET(ARG,3530) == 1
			CALL ATTACK_SINGLE,ARG,LOCAL,3530
			SIF CFLAG:LOCAL:현데미지 > 0
				CALL SKILLGAGE_D_SET,ARG,[[스킬:분노폭발]],0
		ELSEIF SKILLGAGE_H_GET(ARG,3530) == 2
			TFLAG:스킬용2 = 1
			CALL ATTACK_SINGLE, ARG, LOCAL, 3530
			;CALL RATE_ATTACK_SINGLE,ARG,LOCAL,3530,1,2000
			FOR LOCAL:1,0,6
				CFLAG:ARG:(GET_BATTLESTATUS(LOCAL:1) + "강화") = MAX(0, CFLAG:ARG:(GET_BATTLESTATUS(LOCAL:1) + "강화"))
			NEXT
			PRINTFORML %CALLNAME:ARG%의 저하된 능력이 돌아왔다!
			PRINT 더욱이
			IF HAVE_SKILL(ARG,[[스킬:재염]]) && SKILLGAGE_H_GET(ARG,[[스킬:재염]]) < 3
				CALL SKILLGAGE_H_SET,ARG,[[스킬:재염]],3
				PRINT 재염이 최대가 되어,
			ENDIF
			CFLAG:ARG:집중플래그 = 1
			CFLAG:ARG:気合フラグ = 1
			PRINTW 다음 물리 공격과 마법 공격의 위력이 상승했다!
			CALL SKILLGAGE_D_SET,ARG,[[스킬:분노폭발]],0
		ENDIF
	;羅刹
	ELSE
		IF SKILLGAGE_H_GET(ARG,3530) == 1
			CALL ATTACK_SPREAD,ARG,ARG:1,3530
		ELSEIF SKILLGAGE_H_GET(ARG,3530) == 2
			FLAG:확산플래그 = 0
			LOCAL = POS(ARG:1)
			TFLAG:스킬용1 = 1
			CALL ATTACK_SINGLE,ARG,LOCAL,3530
			;CALL RATE_ATTACK_SINGLE,ARG,LOCAL,3530,1,1800
			TFLAG:스킬용1 = 0
			SIF CFLAG:LOCAL:상태이상 != GET_STATE_NUM("DYING")
				CALL ATTACK_SINGLE,ARG,LOCAL,3530
		ENDIF
		IF HAVE_SKILL(ARG,[[스킬:재염]])
			CALL SKILLGAGE_D_SET,ARG,[[스킬:재염]],5
			PRINTW 5턴 동안, 염열옥의 데미지가 증가하고, 발생하기 쉬워졌다
		ENDIF
		CALL SKILLGAGE_D_SET,ARG,[[스킬:분노폭발]],0
	ENDIF
ENDIF
