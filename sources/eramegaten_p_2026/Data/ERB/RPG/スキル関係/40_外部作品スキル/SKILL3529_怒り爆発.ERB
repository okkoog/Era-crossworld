;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_3529,ARG,ARG:1
#LOCALSIZE 1
LOCAL = 0
;PRINTFORMW %NAME:ARG% {SKILLGAGE_H_GET(ARG,3529)} {SKILLGAGE_D_GET(ARG,3529)}
SIF SKILLGAGE_H_GET(ARG,3529) == 200
	RETURN 0
SIF SKILLGAGE_D_GET(ARG,3529) > 0
	RETURN 0
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;怒りゲージが増える
;IF CFLAG:ARG:현데미지 > 0 || GETBIT(CFLAG:ARG:受けフラグ,18) > 0 || GETBIT(CFLAG:ARG:受けフラグ,19) > 0
IF GET_CREC_ACT(ARG:1, ARG, "HIT")
	LOCAL = MAX(120 *  CFLAG:ARG:현데미지/ MAXBASE:ARG:ＨＰ,5)
	CALL SKILLGAGE_H_ADD,ARG,3529,LOCAL
	RESULTS = 분노
ENDIF
IF SKILLGAGE_H_GET(ARG,3529) > 100
	CALL SKILLGAGE_H_SET,ARG,3529,0
	CALL SKILLGAGE_D_SET,ARG,3529,5
	RESULTS:2 = %CALLNAME:ARG%は怒り状態になった！
	RESULT:1 = COLOR("red")
	;PRINTFORMW %CALLNAME:ARG%は怒り状態になった！
ENDIF
RESULTS:1 =\%
RETURN LOCAL

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3529, ARG, ARG:1, ARG:2

CALL SKILLGAGE_H_SET,ARG,3529,200
CALL SKILLGAGE_D_SET,ARG,3529,6
PRINTFORMW %CALLNAME:ARG%은(는) 분노 폭발했다!
;====================================================
;実行内容ここまで
;====================================================

;====================================================
;追加コマンド(一番下)
;====================================================
@INPUT_COM_NAME_3529,ARG
RESULTS = 剣質変化
RESULTS:1 = 剣質変化
RESULTS:2 = パ青緑
RETURN 2

@INPUT_COM_ABLE_剣質変化,ARG
RESULTS = 1턴째에만 실행 가능
SIF FLAG:경과턴수 > 0
	RETURN -1
RETURN 1

;====================================================
;コマンド実行
;====================================================
@INPUT_COM_剣質変化,ARG
CALL SKILLGAGE_F_INVERTBIT,ARG,3529,0
RETURN -1

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_3529,ARG
#DIMS DYNAMIC L_COLOR
L_COLOR = #ffdc00
SIF SKILLGAGE_D_GET(ARG,3529) > 0
	L_COLOR = #f8b856
IF SKILLGAGE_D_GET(ARG,3529) > 0 && SKILLGAGE_H_GET(ARG,3529) == 200
	RESULTS '= SET_COLOR_TAG("분노폭발　: " + TOFULL(TOSTR(SKILLGAGE_D_GET(ARG,3529))) + "Ｔ", L_COLOR)
ELSEIF SKILLGAGE_D_GET(ARG,3529) > 0
	RESULTS '= SET_COLOR_TAG("怒り状態　: " + TOFULL(TOSTR(SKILLGAGE_D_GET(ARG,3529))) + "Ｔ", L_COLOR)
ELSEIF SKILLGAGE_H_GET(ARG,3529) < 100
	RESULTS '= SET_COLOR_TAG("怒りゲージ: " + @"{SKILLGAGE_H_GET(ARG,3529), 3}" + "％", L_COLOR)
ENDIF
SIF RESULTS != ""
	RESULTS += "<br>"
IF SKILLGAGE_F_GET(ARG,3529) == 1
	RESULTS += "剣質　　　:" + SET_COLOR_TAG("羅刹", "藍色")
ELSE
	RESULTS += "剣質　　　:" + SET_COLOR_TAG("修羅", "赤")
ENDIF
RETURN 3

@SKILL_EX_DISPLAY_3529, ARG, ARGS
#DIM BARLENS
#DIM BAR_COLOR, 2
BARLENS = SKILL_EX_DISPLAY_LENS - 2
IF SKILLGAGE_F_GET(ARG,3529) == 1
	BAR_COLOR = BARCOLORSET("青"), RESULT:1
	RESULTS = %SET_COLOR_TAG("怒", "藍色")%
ELSE
	BAR_COLOR = BARCOLORSET("赤"), RESULT:1
	RESULTS = %SET_COLOR_TAG("怒", "赤")%
ENDIF
IF SKILLGAGE_H_GET(ARG,3529) == 200
	RESULTS += HTML_RECT_SPLIT_BAR(SKILLGAGE_D_GET(ARG, 3529), 6, BARLENS, BAR_COLOR, BAR_COLOR:1)
	RESULTS:1 = 분노폭발
ELSEIF SKILLGAGE_D_GET(ARG,3529) > 0
	RESULTS += HTML_RECT_SPLIT_BAR(SKILLGAGE_D_GET(ARG, 3529), 5, BARLENS, BAR_COLOR, BAR_COLOR:1)
	RESULTS:1 = 분노 상태
ELSE
	RESULTS += HTML_RECT_BAR(SKILLGAGE_H_GET(ARG, 3529), 100, BARLENS, BAR_COLOR, BAR_COLOR:1)
	RESULTS:1 = 분노 게이지
ENDIF
RETURN 1
;　 説明文の表示
@SKILL_EXPLAIN_3529, ARG
PRINTL 분노 게이지가 붙어 데미지를 입으면 쌓이고, 100까지 차면 자동적으로 5턴 분노 상태가 된다
PRINTL 사용하면 6턴 분노 폭발 상태가 되지만, 분노 게이지가 없어진다
PRINTL 최초 1턴째에만, 커맨드에서 검질 변화로 일부 스킬의 성능을 바꿀 수 있다


