;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3535, ARG, ARG:1, ARG:2
#DIM L_P
#DIM L_T
#DIM LCOUNT
L_P = ARG
;修羅
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
		L_T = POS(LCOUNT)
		SIF !IS_TARGET_ABLE(L_T)
			CONTINUE
		CALL SKILL_SET_カジャンダ, L_P, L_T, "防御_魔法効果", 4, "短縮", "NOMES"
		CALL HEAL_SINGLE, L_P, L_T, 3535, 1, , "↑ 防御・魔法効果"
	NEXT
	WAIT
	;IF ARG:1 == 22
	;	LOCAL:1 = 7
	;	LOCAL:2 = 17
	;ELSE
	;	LOCAL:1 = 1
	;	LOCAL:2 = 7
	;ENDIF
	;CALL HEAL_FIELD,ARG,ARG:1,3535,1
	;FOR LOCAL,LOCAL:1,LOCAL:2
	;	SIF POS(LOCAL) < 0
	;		CONTINUE
	;	CFLAG:POS(LOCAL):방어강화 = MIN(32, CFLAG:POS(LOCAL):방어강화 + 4)
	;	CFLAG:POS(LOCAL):마법효과강화 = MIN(32, CFLAG:POS(LOCAL):마법효과강화 + 4)
	;NEXT
	;PRINTFORML \@ LOCAL:1 == 7 ? 敵 # 味方 \@の防御力と魔法効果が上がった！
;羅刹
ELSE
	CFLAG:ARG:気合フラグ = 1
	CALL SKILL_SET_カジャンダ, L_P, L_T, "크리티컬", 4, "단체", "NOMES"
	;CFLAG:ARG:크리티컬강화 = MIN(8, CFLAG:ARG:크리티컬강화 + 4)
	PRINTFORMW %CALLNAME:ARG%은(는) 다음 물리 공격의 위력 상승 & 크리티컬률이 상승했다!
ENDIF


