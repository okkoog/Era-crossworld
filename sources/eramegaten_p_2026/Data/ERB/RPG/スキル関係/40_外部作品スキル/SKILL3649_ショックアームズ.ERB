@SKILL_SPEED_3649, ARG = -1
RETURN 10


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3649
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3649, ARG = -1
RETURN 8




;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_3649, ARG = -1, ARG:1 = -1
RETURN 4

;====================================================
;耐性変化スキルの貫通強度。こちらは突破したときはもともとの相性値を適用する
;1 - 耐性(1~99%)を無効にする。対応先も対応元も2022年10月時点ではない
;2 - 1に加えて、無効に対応する。壁や護符、無効化付与、ブレイク(ウェイトスキル)。
;3 - 2に加えて、吸収に対応する。ドレイン(ウェイトスキル)
;4 - 3に加えて、反射に対応する。カーン・ハイパーカウンタ・リフレクト(ウェイトスキル)
;====================================================
@SKILL_ADD_PENETRATION_RANK_3649, ARG
RETURN 4

;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_3649,ARG,ARG:1,ARG:2
SIF ARG:2 < -1
	RETURN 0
CALL SKILL_GUARD_KILL, ARG, "전격", CPOS(ARG:1), 2, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3649, ARG, ARG:1, ARG:2
CALL ATTACK_SINGLE, ARG, POS(ARG:1), 3649

;====================================================
;実行内容ここまで
;====================================================

