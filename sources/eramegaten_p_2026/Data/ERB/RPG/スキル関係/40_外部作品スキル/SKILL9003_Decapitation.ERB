;일도류・호접난무
;敵全体に中ダメージの斬撃を3回与え、ダメージ毎に低確率で即死効果を与える　コスト60　総合火力420

;スキル名
@SKILL_NAME_9003,ARG
RESULTS = 일도류・호접난무

;　명중
@SKILL_HITRATE_9003, ARG
RETURN 100

;　威力
@SKILL_POWER_9003, ARG
RETURN 140

;　최저공격횟수
@SKILL_MINATTACKNUMBER_9003,ARG
RETURN 3

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_9003,ARG
RETURN 3

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_9003, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_9003,ARG
RETURN 60

;　相性
@SKILL_TYPE_9003,ARG
RETURN GET_TYPE_NUM("검격")
;검격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_9003
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_9003, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_9003, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_9003,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_9003,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_9003, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_9003
RETURN GET_SUCCESSION_NUM("검격")
;不可

@継承不能_9003
RETURN 1
;特殊

;속도보정
@SKILL_SPEED_9003, ARG = -1
RETURN 3


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_9003
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_9003, ARG = -1
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_9003,ARG
RETURN GET_STATE_NUM("DYING")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_9003,ARG
RETURN 0

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_9003,ARG
RETURN 10

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_9003,ARG
RETURN 10


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_9003, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,9003






