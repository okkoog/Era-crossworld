;星をみるひと　ぶれいく系ESP
;これだけ効果はスターゲイザーを参考に。ピンチなほど強くなるタイプのアレ

;スキル名
@SKILL_NAME_3671,ARG = -1
IF ARG == -1
	RESULTS = 브레이크
ELSEIF BASE:ARG:LV < 10
	RESULTS = 브레이크 I
ELSEIF BASE:ARG:LV < 20
	RESULTS = 브레이크 II
ELSEIF BASE:ARG:LV < 30
	RESULTS = 브레이크 III
ELSEIF BASE:ARG:LV < 40
	RESULTS = 브레이크 IV
ELSEIF BASE:ARG:LV < 50
	RESULTS = 브레이크 V
ELSE
	RESULTS = 브레이크！
ENDIF


;　명중
@SKILL_HITRATE_3671, ARG
RETURN 100

;　威力
;　それぞれの段階で、ザン系基本魔法＋40～-20のレンジを基準にいいかんじに
@SKILL_POWER_3671, ARG
SIF ARG == -1
	RETURN 120
;LV10未満　ザン基準
IF BASE:ARG:LV < 10
	;25％以下なら威力＋40％のザン
	IF 現HP割合(ARG) < 25
		RETURN 180
	;50％以下なら威力＋20％のザン
	ELSEIF 現HP割合(ARG) < 50
		RETURN 160
	;50％以上のときは威力-40％のザン
	ELSE
		RETURN 100
	ENDIF
;LV20未満　ザンマより弱いぐらい
ELSEIF BASE:ARG:LV < 20
	;25％以下ならザンマ
	IF 現HP割合(ARG) < 25
		RETURN 235
	;50％以下なら-20％のザンマ
	ELSEIF 現HP割合(ARG) < 50
		RETURN 215
	;50％以上のときは威力-60％のザンマ
	ELSE
		RETURN 175
	ENDIF
;LV30未満　ザンマ基準
ELSEIF BASE:ARG:LV < 30
	;25％以下なら威力＋40％のザンマ
	IF 現HP割合(ARG) < 25
		RETURN 275
	;50％以下ならザンマ＋20％
	ELSEIF 現HP割合(ARG) < 50
		RETURN 255
	;50％以上のときは威力-40％のザンマ
	ELSE
		RETURN 185
	ENDIF
;LV40未満　ザンダイン基準
ELSEIF BASE:ARG:LV < 40
	;25％以下なら威力＋40％のザンダイン
	IF 現HP割合(ARG) < 25
		RETURN 370
	;50％以下なら＋20％のザンダイン
	ELSEIF 現HP割合(ARG) < 50
		RETURN 350
	;50％以上のときは威力-40％のザンダイン
	ELSE
		RETURN 290
	ENDIF
;LV50未満　ザンバリオンより弱いぐらい
ELSEIF BASE:ARG:LV < 50
	;25％以下ならザンダイン
	IF 現HP割合(ARG) < 25
		RETURN 410
	;50％以下なら-20％のザンダイン
	ELSEIF 現HP割合(ARG) < 50
		RETURN 390
	;50％以上のときは威力-60％のザンバリオン
	ELSE
		RETURN 350
	ENDIF
;LV50以上　ザンバリオン基準
ELSE
	;25％以下なら威力＋40％のザンバリオン
	IF 現HP割合(ARG) < 25
		RETURN 450
	;50％以下なら威力＋20％のザンバリオン
	ELSEIF 現HP割合(ARG) < 50
		RETURN 430
	;50％以上のときは威力-40％のザンバリオン
	ELSE
		RETURN 370
	ENDIF
ENDIF


;　최저공격횟수
@SKILL_MINATTACKNUMBER_3671,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3671,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3671, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3671,ARG
;LV10未満　ザン基準
IF ARG < 0 || BASE:ARG:LV < 10
	RETURN 4
;LV20未満　ザンマより安い
ELSEIF BASE:ARG:LV < 20
	RETURN 5
;LV30未満　ザンマ基準
ELSEIF BASE:ARG:LV < 30
	RETURN 6
;LV40未満　ザンダイン基準
ELSEIF BASE:ARG:LV < 40
	RETURN 12
;LV50未満　ザンバリオンより安い
ELSEIF BASE:ARG:LV < 50
	RETURN 20
;LV50以上　ザンバリオン基準
ELSE
	RETURN 22
ENDIF


;　相性
@SKILL_TYPE_3671,ARG
IF ARG >= 0 && 現HP割合(ARG) < 50
	;HP50％未満は万能が付く
	RETURN GET_TYPE_NUM("충격"), GET_TYPE_NUM("만능")
ELSE
	;それ以外は衝撃
	RETURN GET_TYPE_NUM("충격")
ENDIF

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3671
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3671, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3671, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3671,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3671,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3671, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3671
RETURN GET_SUCCESSION_NUM("충격")

;속도보정
@SKILL_SPEED_3671, ARG = -1
IF 現HP割合(ARG) < 25
	;HP25％未満は超高速発動
	RETURN 999
ELSE
	;それ以外はなし
	RETURN 0
ENDIF

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3671
RETURN 0

;スキル変化用ランク
@SKILL_RANK_3671, ARG = -1
RETURN 23

@SKILL_RANKUP_3671
;ランクアップ先はなし
RETURN 0



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3671, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,3671


;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3671, ARG
#LOCALSIZE 1
IF !TFLAG:전투중 || ARG < 0 || ARG >= CHARANUM
	PRINTL 적 1체에게 충격 상성의 소~특대 데미지.
	PRINTL 분노를 폭발시켜 날리는 미나미의 필살기.
	PRINTL ------------------------------------------
	PRINTL · 미나미의 LV이 10의 배수에 도달할 때마다 기본 성능이 상승한다 (상한 LV 50)
	PRINTL · 현재 HP가 50% 미만이면 위력이 1단계 상승하고 추가로 만능 상성이 복합된다.
	PRINTL · 현재 HP가 25% 미만이면 위력이 1단계 상승하고 추가로 초고속으로 발동한다.
ELSE
	;25％以下
	IF 現HP割合(U) < 25
		SETCOLOR 0x66ffff
		PRINTL 【HP 25% 미만: 미나미의 분노가 정점에 달했다!】
		RESETCOLOR
		PRINT 적 1체에게 충격·만능 복합상성의 
	;50％以下
	ELSEIF 現HP割合(U) < 50
		SETCOLOR 0x66ffff
		PRINTL 【HP 50% 미만: 분노 폭발!!】
		RESETCOLOR
		PRINT 적 1체에게 충격·만능 복합상성의 
	;50％以上
	ELSE
		SETCOLOR 0x990000
		PRINTL 【HP 50% 이상: 위력이 부족하다】
		RESETCOLOR
		PRINT 적 1체에게 충격 상성의 
	ENDIF
	
	;大中小の基準があいまいだけど、「今うて」「今うつな」がそこはかとなく察せるように、よっぽどじゃない限りは大中小を恣意的に使い分け
	;LV10未満　ザン基準
	IF BASE:ARG:LV < 10
		;25％以下なら威力＋40％のザン
		IF 現HP割合(U) < 25
			PRINT 中
		;50％以下なら威力＋20％のザン
		ELSEIF 現HP割合(U) < 50
			PRINT 小
		;50％以上のときは威力-40％のザン（通常攻撃と同じ威力）
		ELSE
			PRINT 通常
		ENDIF
	;LV20未満　ザンマより弱いぐらい
	ELSEIF BASE:ARG:LV < 20
		;25％以下ならザンマ
		IF 現HP割合(U) < 25
			PRINT 中
		;50％以下なら-20％のザンマ
		ELSEIF 現HP割合(U) < 50
			PRINT 中
		;50％以上のときは威力-60％のザンマ
		ELSE
			PRINT 小
		ENDIF
	;LV30未満　ザンマ基準
	ELSEIF BASE:ARG:LV < 30
		;25％以下なら威力＋40％のザンマ
		IF 現HP割合(U) < 25
			PRINT 大
		;50％以下ならザンマ＋20％
		ELSEIF 現HP割合(U) < 50
			PRINT 中
		;50％以上のときは威力-40％のザンマ
		ELSE
			PRINT 小
		ENDIF
	;LV40未満　ザンダイン基準
	ELSEIF BASE:ARG:LV < 40
		;25％以下なら威力＋40％のザンダイン
		IF 現HP割合(U) < 25
			PRINT 特大
		;50％以下なら＋20％のザンダイン
		ELSEIF 現HP割合(U) < 50
			PRINT 大
		;50％以上のときは威力-40％のザンダイン
		ELSE
			PRINT 中
		ENDIF
	;LV50未満　ザンバリオンより弱いぐらい
	ELSEIF BASE:ARG:LV < 50
		;25％以下ならザンダイン
		IF 現HP割合(U) < 25
			PRINT 特大
		;50％以下なら-20％のザンダイン
		ELSEIF 現HP割合(U) < 50
			PRINT 大
		;50％以上のときは威力-60％のザンバリオン
		ELSE
			PRINT 大
		ENDIF
	;LV50以上　ザンバリオン基準
	ELSE
		;25％以下なら威力＋40％のザンバリオン
		IF 現HP割合(U) < 25
			PRINT 特大
		;50％以下なら威力＋20％のザンバリオン
		ELSEIF 現HP割合(U) < 50
			PRINT 特大
		;50％以上のときは威力-40％のザンバリオン
		ELSE
			PRINT 大
		ENDIF
	ENDIF
	PRINT 데미지
	;25％以下
	SIF 現HP割合(U) < 25
		PRINT 。超高速発動
	PRINTL 。
	PRINTL 분노를 폭발시켜 날리는 미나미의 필살기.
		
ENDIF

