;やみのま　呪殺特大ダメージ＋魅了
;呪殺、『闇』、『暗黒』のスキル所持数に応じて威力増加

;スキル名
@SKILL_NAME_3598,ARG
RESULTS = 어둠에삼켜져라！

;　명중
@SKILL_HITRATE_3598, ARG
RETURN 100

@COUNT_DARK_SKILL_3598, ARG = -1
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_RESULT
SIF ARG < 0
	RETURN 0
FOR LCOUNT, 1, CHARA_SKILLCOUNT(ARG) + 1
	CALL GET_SKILL_PROP, "SKILL_NAME", ABL:ARG:@"스킬{LCOUNT}", ARG
	SIF STRFIND(RESULTS, "闇") >= 0
		L_RESULT += 1
	SIF STRFIND(RESULTS, "暗黒") >= 0
		L_RESULT += 1
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", ABL:ARG:@"스킬{LCOUNT}"
	SIF GET_SUCCESSION(RESULT) == "주살"
		L_RESULT += 1
NEXT
RETURN L_RESULT

;威力
@SKILL_POWER_3598, ARG
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 威力
CALL COUNT_DARK_SKILL_3598, ARG
RETURN 380 + RESULT * 10

