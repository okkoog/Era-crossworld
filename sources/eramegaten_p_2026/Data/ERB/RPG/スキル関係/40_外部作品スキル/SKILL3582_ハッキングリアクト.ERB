;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_3582,ARG,ARG:1
;自分の行動のときのみ判定
SIF FLAG:행동순1 != ARG
	RETURN 0
;判定は一回
SIF ARG != ARG:1
	RETURN 0
;ゲージがある時
SIF !SKILLGAGE_D_GET(ARG,3582)
	RETURN 0
;入力行動がハッキング系
SIF !GROUPMATCH(SKILL_NAME_F(CFLAG:ARG:입력행동), "배드인밸리드", "슬리프올", "매드스트라이프", "커스올", "아이스：TROY", "해킹원")
	RETURN 0
IF SKILL_NAME_F(CFLAG:ARG:입력행동) == "해킹원"
	IF CFLAG:ARG:PT플래그
		RETURN 1, CFLAG:ARG:타겟 < 12 ? 20 # 21
	ELSE
		RETURN 1, CFLAG:ARG:타겟 < 4 ? 17 # 18
	ENDIF
ELSE
	;ハッキングワン以外は50%判定
	SIF RAND:2
		RETURN 0
	RETURN 1, CFLAG:ARG:타겟
ENDIF

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3582, ARG, ARG:1, ARG:2
#LOCALSSIZE 1
#LOCALSIZE 1
;コストを支払う
;CALL PAY_COST,ARG,3582
;CFLAG:ARG:고유게이지D2 = 7
IF FLAG:총공격중
	CALL SKILL_ACTION, 3576 + RAND:5, ARG, ARG:1
ELSE
	CALL SKILLGAGE_D_SET,ARG,3582,7
	PRINTFORMW 7턴 동안 해킹 능력이 상승했다
ENDIF

