;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_3582,ARG
SIF SKILLGAGE_D_GET(ARG,3582) == 0
	RETURN 0
RESULTS = 해킹리액트:%TOFULL(TOSTR((SKILLGAGE_D_GET(ARG,3582))))%Ｔ
RETURN 3

@SKILL_EX_DISPLAY_3582, ARG, ARGS
RESULTS += SET_COLOR_TAG(UNICODE(0x2604), "yellow")
RESULTS += HTML_RECT_SPLIT_BAR(SKILLGAGE_D_GET(ARG, 3582), 7, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("緑"), RESULT:1)
RESULTS:1 = 해킹리액트
RETURN 1
;　 説明文の表示
@SKILL_EXPLAIN_3582, ARG
PRINTL 7턴 동안 자신의 데미지가 없는 해킹 공격을 강화한다
PRINTL 해킹 원이 반드시 성공하며 다른 해킹 공격이 발동한다
PRINTL 해킹 공격 발동 시 50% 확률로 다른 해킹 공격이 발동한다



