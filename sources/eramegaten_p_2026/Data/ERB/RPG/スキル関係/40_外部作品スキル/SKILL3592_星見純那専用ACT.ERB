	RETURN GET_TYPE_NUM("비구"), GET_TYPE_NUM("질풍"), GET_TYPE_NUM("핵열")
ELSE
	RETURN GET_TYPE_NUM("비구")
ENDIF
;　1EXTRAか2MAGICか
