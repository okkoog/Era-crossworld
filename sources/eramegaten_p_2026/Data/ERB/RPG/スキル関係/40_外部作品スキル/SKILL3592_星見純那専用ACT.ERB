IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	RETURN 640
ELSE
	RETURN 360
ENDIF


;　최저공격횟수
@SKILL_MINATTACKNUMBER_3592,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3592,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3592, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3592,ARG
