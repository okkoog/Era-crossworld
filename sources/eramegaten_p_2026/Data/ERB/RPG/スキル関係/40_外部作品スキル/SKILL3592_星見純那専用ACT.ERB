IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	;消費無し（代わりにゲージをゼロに）
	RETURN 0
ELSE
	RETURN 18
ENDIF

;　複合相性
@SKILL_TYPE_3592,ARG
;飛具・疾風・核熱のうち、最も効果のある相性で攻撃
