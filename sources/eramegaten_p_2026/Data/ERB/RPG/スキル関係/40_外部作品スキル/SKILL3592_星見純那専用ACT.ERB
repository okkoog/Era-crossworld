;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3592, ARG, ARG:1, ARG:2
;CR展開時
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	ALIGNMENT CENTER
	SETCOLOR 0x8ac4ec
	PRINTL 【ＣＬＩＭＡＸ　ＡＣＴ】
	RESETCOLOR
	ALIGNMENT LEFT

	;星見パワーアップイベント中かつボスが最終形態時のみ、ボスの不死フラグを剥がして攻撃
	IF GETBIT(イベントフラグ:93:13, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:쥰나]])
		CFLAG:(CHARANUM-1):불사신플래그 = 0
	ENDIF
	
	IF ARG:1 > 16
		CALL RANDOM_TARGET,ARG,3592
		ARG:1 = CFLAG:ARG:타겟
	ENDIF
	
	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,3592

	;星見パワーアップイベント中かつボスが最終形態時のみ、撃破時に敵が喋る
	IF GETBIT(イベントフラグ:93:13, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:쥰나]])
	
		;ボスのHPがぴったり1の場合、『すでに削り切ったけど、攻撃をミスってとどめを刺せていない』状況と見る
		IF BASE:(CHARANUM-1):ＨＰ == 1
			PRINTL
			SETCOLOR COLOR("FRIEND")
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"밀어붙인다!",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTL
			ALIGNMENT CENTER
			PRINTFORML ┏━━━━━━━━━━┓
			PRINTFORML ┃　　 　1more！　　　┃
			PRINTFORMW ┗━━━━━━━━━━┛
			RESETCOLOR
			ALIGNMENT LEFT
			
			;テイクツー
			CFLAG:(CHARANUM-1):불사신플래그 = 0
			TFLAG:필중 = 1
			;CFLAG:ARG:회심의패기플래그 = 1
			
			CALL ATTACK_SINGLE,ARG,LOCAL,3592
			
		ENDIF
	
		;ボス撃破
		IF BASE:(CHARANUM-1):ＨＰ < 1
			ALIGNMENT CENTER
			PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┃　　　　　　후…… 얼마나 아름다운 밤하늘인가　　　　　　┃
			PRINTL ┃　　별은, 브리튼의 아침노을은, 이미 너의 손안에――　　┃
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTL 
			ALIGNMENT LEFT
		ENDIF
	ELSE
		;クライマックスレヴュー終了。ゲージ取得をとめるために-1で送ってむこうで0にする
		CALL SET_ROLE_CFLAG_DUNGEON, ARG,  "클라이맥스레뷰지속시간" , -1
	ENDIF

	ALIGNMENT CENTER
	SETCOLOR 0x8ac4ec
	PRINTW 【ＣＬＩＭＡＸ　ＲＥＶＵＥ／ＦＩＮＩＳＨ】
	PRINTL
	RESETCOLOR
	ALIGNMENT LEFT
	;クライマックスレヴュー終了
	;CALL SET_ROLE_CFLAG_DUNGEON, ARG,  "클라이맥스레뷰지속시간" , 0

;それ以外
ELSE
	CALL ATTACK_FIELD,ARG,ARG:1,3592
ENDIF









;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3592, ARG
#LOCALSIZE 1
IF CFLAG:(CHARANUM-1):PT플래그 || ARG < 0 || ARG >= CHARANUM
	PRINTL 【通常時】
	PRINTL 적 일렬에 비구 상성의 대 데미지 + 독
	PRINTL 
	PRINTL 【클라이맥스 레뷰 발동 시】
	PRINTL 적 1체에 고크리티컬 『비구·질풍·핵열』 복합 초특대 데미지 + 만능 구속.
ELSE
	;CR展開時
	IF GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
		SETCOLOR 0x8ac4ec
		PRINTL 【ＣＬＩＭＡＸ　ＡＣＴ】
		RESETCOLOR
		PRINTL 소환한 숲속에 적을 가두고 치명적인 일격으로 산산조각 내는 로빈 후드의 필살기.
		PRINTL 적 1체에 고크리티컬 『비구·질풍·핵열』 복합 초특대 데미지 + 만능 구속.
		;星見パワーアップイベント中かつボスが最終形態時のみ、撃ち放題
		IF GETBIT(イベントフラグ:93:13, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:쥰나]])
			SETCOLOR 0x8ac4ec
			PRINTL 혼신의 일격으로 이 레뷰에 결착을!
			RESETCOLOR
		;通常
		ELSE
			PRINTL 사용하면 클라이맥스 레뷰는 종료된다
		ENDIF
	ELSE
		PRINTL 적 일렬에 비구 속성의 대 데미지 + 독
		PRINTL 클라이맥스 레뷰 발동 중에는 성능이 변화한다.
	ENDIF
ENDIF

