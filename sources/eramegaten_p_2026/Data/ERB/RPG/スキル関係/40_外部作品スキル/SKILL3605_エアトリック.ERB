;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_3605,ARG,ARG:1
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	RETURN 0
SIF !GET_CREC_ACT(ARG:1, ARG, "AVOID")
	RETURN 0
RETURN 1, CPOS(ARG:1)
;SIF !GETBIT(CFLAG:ARG:受けフラグ,18) && !GETBIT(CFLAG:ARG:受けフラグ,19)
;	RETURN 0
;SIF CFLAG:ARG:회피실패
;	RETURN 0
;SIF ARG:1 < 0 || GET_STATE(CFLAG:(ARG:1):상태이상) == "DYING"
;	RETURN 0
;RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3605, ARG, ARG:1, ARG:2
;#LOCALSIZE 4
LOCAL = POS(ARG:1)
TFLAG:필중 = 1
TFLAG:반사0데미지화 = 1
TFLAG:흡수0데미지화 = 1
CALL ATTACK_SINGLE, ARG, POS(ARG:1), 3605
;CALL DAMAGE_1, ARG, LOCAL, LOCAL:1, LOCAL:2, LOCAL:3
;PRINTL
IF SKILLGAGE_D_GET(ARG,[[스킬:환영검]]) && INRANGE(CPOS(LOCAL), 1, 16) && CFLAG:LOCAL:상태이상 != GET_STATE_NUM("DYING")
	CALL SKILLGAGE_H_SET,ARG,[[스킬:환영검]],1
	LOCAL = [[스킬:환영검]]
	CALL SKILL_ACTION, LOCAL, ARG, ARG:1
ENDIF
TFLAG:필중 = 0
TFLAG:반사0데미지화 = 0
TFLAG:흡수0데미지화 = 0
;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3605, ARG
PRINTL 물리 회피율이 상승하고, 공격을 회피하면 대 데미지로 반격을 행한다
PRINTL 상성은 통상 공격에 의존하며, 환영검을 사용 중이면 추가 추격을 행한다


