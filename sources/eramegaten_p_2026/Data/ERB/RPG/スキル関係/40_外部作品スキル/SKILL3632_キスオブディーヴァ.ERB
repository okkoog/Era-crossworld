;スキル名
@SKILL_NAME_3632, ARG
RESULTS = 키스오브디바
IF FLAG:총공격중
	TSTR:스킬메시지행동자 = RoRo
	TFLAG:스킬행동자컬러 = 0x9933cd
ENDIF

;　명중
@SKILL_HITRATE_3632, ARG
IF SKILLGAGE_D_GET(ARG, [[스킬:키스오브디바]]) > 0
	RETURN 120
ELSE
	RETURN 85
ENDIF

;　威力
@SKILL_POWER_3632, ARG
IF SKILLGAGE_D_GET(ARG, [[스킬:키스오브디바]]) > 0
	IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "다크니스트리거Ｘ") && FLAG:총공격중
		;約1.25倍
		RETURN 360
	ELSE
		RETURN 295
	ENDIF
ELSE
	RETURN 180
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3632, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3632, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3632, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3632, ARG
SIF ARG < 0
	RETURN 12
;ダークネストリガー発動中はコスト1/3
SIF SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
	RETURN 4
RETURN 12

;　相性
@SKILL_TYPE_3632, ARG
RETURN GET_TYPE_NUM("정신")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3632
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3632, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3632, ARG
;ロック中の攻撃・ロック対象に強制
IF ARG >= 0 && NO:ARG == [[キャラ:아큐라_X]] && BLITZ_TARGET_JUDG(ARG) == 1
	RETURN 4
;非ロック中の攻撃・敵単体
ELSE
	RETURN 1
ENDIF

;　사거리
@SKILL_RANGE_3632, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3632, ARG
;ロック中の攻撃・ロック対象に強制
IF BLITZ_TARGET_JUDG(ARG) == 1
	RETURN 4
;非ロック中の攻撃・敵単体
ELSE
	RETURN 1
ENDIF

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3632, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_3632
RETURN GET_SUCCESSION_NUM("정신")

;속도보정
@SKILL_SPEED_3632, ARG = -1
;ロック中の攻撃
IF BLITZ_TARGET_JUDG(ARG) == 1
	RETURN -5
;非ロック中の攻撃
ELSE
	RETURN 0
ENDIF

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3632
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3632, ARG = -1
RETURN 23

@継承不能_3632
RETURN 1

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_3632, ARG
RETURN GET_STATE_NUM("HAPPY")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_3632, ARG
RETURN GET_TYPE_NUM("정신")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_3632, ARG
IF SKILLGAGE_D_GET(ARG, [[스킬:키스오브디바]]) > 0
	RETURN 40
ELSE
	RETURN 30
ENDIF

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_3632, ARG
IF SKILLGAGE_D_GET(ARG, [[스킬:키스오브디바]]) > 0
	RETURN 90
ELSE
	RETURN 65
ENDIF

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_3632, ARG, ARG:1
#DIM ROCK_H

;ダークネストリガー追撃条件共通
IF DTRIGGER_ABLE(ARG, "키스오브디바")
	ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
	CALL SKILLGAGE_D_SET, ARG, [[스킬:키스오브디바]], 1
	;200000をつけることで行動不能時にも追撃をするようになる
	RETURN 1, 200000 + 23
ENDIF
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3632, ARG, ARG:1, ARG:2
#DIM ROCK_H
#DIM ループ用
#DIM 攻撃前敵カウント
#DIM 攻撃後敵カウント
#DIM 差分
#DIM 加算クードス

SIF ARG < 0
	RETURN 0
	;CALL ATTACK_SINGLE, ARG, POS(ARG:1), 3632

;ロック中かつロック対象が生存中なら強制的にロック対象へ攻撃
IF ARG:1 == 23
	IF BLITZ_TARGET_JUDG(ARG) == 1
		SIF FLAG:총공격중
			TFLAG:반사후0데미지화 = 1
		ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
		CALL SKILLGAGE_D_SET, ARG, [[스킬:키스오브디바]], 1
		CALL ATTACK_SINGLE, ARG, ROCK_H, 3632
	ENDIF
ELSE
	CALL ATTACK_SINGLE, ARG, POS(ARG:1), 3632
ENDIF

;撃破数1につき20の基礎クードスを得る。(上限20)
加算クードス = MIN(GET_CREC_ACT_SUM(ARG, "적", "KILL"), 1) * 20
CALL SET_加算クードス, ARG, 加算クードス

;EXウェポン4番=키스오브디바
SIF HAVE_SKILL(ARG, [[스킬:DARKNESS TRIGGER]])
	CALL SKILLGAGE_F_SET, ARG, [[스킬:DARKNESS TRIGGER]], 4
;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3632, ARG
PRINTL 분신을 만들어 내는 셉티마·분신(컴패니언)을 재현한 EX 웨폰.
PRINTL HP를 소비하는 커맨드 「블리츠대쉬」에 의해 록이 걸린 적이 있을 경우 강제적으로 그 대상을 공격한다.
PRINTL 
PRINTL 록온 상태인 경우… 적 단체에 정신 상성으로 대 데미지를 준다. 발동이 느리다.
PRINTL 비록온 상태인 경우… 적 단체에 정신 상성으로 소 데미지를 준다. 명중률이 낮다.
PRINTL 어느 쪽이든 행복을 부여하지만 록온 상태일 때 성공률이 상승한다.
IF ARG > 0 && ARG < CHARANUM && IS_CHARA_EQUIPED(ARG, "다크니스트리거Ｘ") && SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
	SETCOLOR 0x9933cd
	PRINTL 다크니스 트리거 X 장비 중　다크니스 트리거에 의한 추격 시 데미지 상승
	RESETCOLOR
ENDIF
PRINTL ※이 스킬로 적을 쓰러뜨렸을 경우 쿠도스가 20 가산된다

;使用条件
@SKILL_SPECIAL_ACTIONABLE_3632, ARG
;타겟=23が入るのはロック中のみ
;かつ実行時にターゲットが死んだりするとダメ
SIF ARG > 0 && CFLAG:ARG:타겟 == 23 && BLITZ_TARGET_JUDG(ARG) != 1
	RETURN 0
RETURN 1

;継承に必要な部位


