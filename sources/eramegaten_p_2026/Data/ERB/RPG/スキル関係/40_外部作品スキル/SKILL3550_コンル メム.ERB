;　 説明文の表示
@SKILL_EXPLAIN_3550, ARG
IF TFLAG:전투중 == 0 && ARG > -1 && HAVE_SKILL(ARG, [[스킬:분노폭발]])
	PRINTL 【修羅】
	PRINTL 적 일렬에 SLIP + 명중·회피 저하
	PRINTL 【羅刹】
	PRINTL 적 전체 랜덤으로 빙결 데미지 + FREEZE
ELSEIF ARG < 0 || SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	PRINTL 얼음 샘　상대의 발밑에 얼음을 만들어 자세를 무너뜨린다
	PRINTL 적 일렬을 빙결 속성 SLIP 상태로 만들고 명중·회피를 저하시킨다
ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
	PRINTL 얼음 안개　얼음 덩어리를 방출하여 적에게 닿기 전에 얼음을 깨뜨려 공격한다
	PRINTL 적 전체 랜덤으로 빙결 속성 소위력 마법 공격을 7회 행한다(1체당 최대 5회)
	PRINTL 追加効果：FREEZE
ENDIF




