RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3660
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3660, ARG = -1
RETURN 9

@SKILL_RANKUP_3660
;ランクアップなし
RETURN 0



;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3660, ARG, ARG:1, ARG:2
CALL SKILLGAGE_H_ADD,ARG,3660,1
;ゲージHを利用して使用済み判定にする


;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3660, ARG
PRINTL 기합으로 물리법칙을 무시하고 눈에서 미사일을 발사해, 폭풍으로 적 1열에 충격 상성의 중 데미지.
PRINTL MP를 소비하지 않지만 예비 동작이 뻔해서 회피당하기 쉬우며, 기합을 넣는 것도 배틀 중 1회가 한도.
PRINTL 기계수 걸 가라다 K7의 필살기. 요령만 익히면 눈이 있다면 누구든 다룰 수 있다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_3660,ARG
SIF SKILLGAGE_H_GET(ARG,3660)
	RETURN 0
RETURN 1

