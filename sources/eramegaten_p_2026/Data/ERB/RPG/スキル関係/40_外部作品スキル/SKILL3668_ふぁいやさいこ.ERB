;星をみるひと　ぶれいく系ESP
;衝撃火炎複合ダイン

;スキル名
@SKILL_NAME_3668,ARG
RESULTS = 파이어사이코

;　명중
@SKILL_HITRATE_3668, ARG
RETURN 100

;　威力
@SKILL_POWER_3668, ARG
RETURN 330

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3668,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3668,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3668, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3668,ARG
RETURN 20

;　相性
@SKILL_TYPE_3668,ARG
RETURN GET_TYPE_NUM("충격"), GET_TYPE_NUM("화염")
;複合相性

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3668
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3668, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3668, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3668,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3668,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3668, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3668
RETURN GET_SUCCESSION_NUM("충격")

;속도보정
@SKILL_SPEED_3668, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3668
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3668, ARG = -1
RETURN 8

@SKILL_RANKUP_3668
;ランクアップ先はなし
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3668, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,3668






;====================================================
;実行内容ここまで
;====================================================

