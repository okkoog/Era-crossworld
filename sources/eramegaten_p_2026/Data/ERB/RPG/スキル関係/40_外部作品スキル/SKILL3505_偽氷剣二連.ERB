;
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3505,ARG
RESULTS = 가짜얼음검이연참

;　명중
@SKILL_HITRATE_3505, ARG
RETURN 100

;　威力
@SKILL_POWER_3505, ARG
RETURN 230

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3505,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3505,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3505, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3505,ARG
RETURN 30

;　複合相性
@SKILL_TYPE_3505,ARG
RETURN GET_TYPE_NUM("빙결"), GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3505
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　攻撃タイプ
@SKILL_ATTACKTYPE_3505,ARG
RETURN GET_攻撃タイプ_NUM("魔法")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3505, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3505, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3505,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3505,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3505, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3505
RETURN GET_SUCCESSION_NUM("빙결")
;빙결

;속도보정
@SKILL_SPEED_3505, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3505
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3505, ARG = -1
RETURN 15





;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3505, ARG, ARG:1, ARG:2
;LOCAL:0 = MAXBASE:ARG:공격
;LOCAL:1 = CFLAG:ARG:공격강화
;
;MAXBASE:ARG:공격 = MAXBASE:ARG:마법위력
;CFLAG:ARG:공격강화 = CFLAG:ARG:마법위력강화

CALL ATTACK_SINGLE,ARG,POS(ARG:1),3505

;MAXBASE:ARG:공격 = LOCAL:0
;CFLAG:ARG:공격강화 = LOCAL:1

