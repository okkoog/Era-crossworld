;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3514, ARG, ARG:1, ARG:2

FOR LOCAL,1,17
	SIF POS(LOCAL) < 0 || CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("DYING")
		CONTINUE
	SIF POS(LOCAL) == ARG
		CONTINUE
	CALL ATTACK_SINGLE, ARG, POS(LOCAL),3514
NEXT







