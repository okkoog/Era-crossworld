;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_3547,ARG,ARG:1
;味方に対しては反撃しない
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
IF CFLAG:ARG:PT플래그 == 0
	;敵の場合は1000以上のダメージに反応
	SIF CFLAG:ARG:현데미지  < 1000
		RETURN 0
ELSE
	;味方の場合は最大HP1/10以上のダメージに反応
	SIF CFLAG:ARG:현데미지  < MAXBASE:ARG:ＨＰ / 10
		RETURN 0
ENDIF
SIF !GET_CREC_ACT(ARG:1, ARG, "HIT")
	RETURN 0
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3547, ARG, ARG:1, ARG:2
;使用者がエネミーサイドの場合プレイヤーサイド全体へ反撃、威力444必中即死基礎444限界88
IF  CFLAG:ARG:PT플래그 == 0
	SETCOLOR 0x33ffcc
	PRINTL 고위력 데미지에 미루의 마법 에너지가 반응했다!!
	RESETCOLOR
	FOR LOCAL,1,7
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0
		CONTINUE
	SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
		CONTINUE
	TFLAG:필중 = 1
	CALL ATTACK_SINGLE, ARG, FLAG:LOCALS, 3547
	TFLAG:필중 = 0
		;対象が死んでいたら改行して次への処理
		IF FLAG:LOCALS < 0 || GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
		PRINTL
		CONTINUE
		ELSE
			;左から順に、攻撃者、攻撃対象、バステ内容、バステ属性、基本付与率、限界付与率。
			;CALL ATTACK_BADSTATE,ARG,FLAG:LOCALS,GET_STATE_NUM("DYING"),11,444,88
			;レベル差あると機能していないようなので強引に５０％の確率で即死状態を付与＝耐性無視するように変更
			IF RAND:2 == 1
				SETCOLOR 0xFF0000
					PRINT ＋ Ｂｅ　Ｋｉｌｌｅｄ！！
				RESETCOLOR
				CFLAG:POS(LOCAL):상태이상 = GET_STATE_NUM("DYING")
				CALL DEAD_CHARA, POS(LOCAL),ARG
			ELSE
				PRINT ＋ Miss
			ENDIF
		ENDIF
	PRINTL
	NEXT
;使用者がプレイヤーサイドの場合エネミーサイド全体へ反撃
ELSE
	CALL ATTACK_FIELD,ARG,22,3547
ENDIF

