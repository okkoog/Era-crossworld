;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3684, ARG, ARG:1, ARG:2
;コスト支払い
;CALL VAR_MP,ARG,-45,0

IF ARG:1 == 19
	LOCAL:7 = 1
	LOCAL:8 = 7
ELSE
	LOCAL:7 = 7
	LOCAL:8 = 17
ENDIF

;実行
FOR LOCAL,LOCAL:7,LOCAL:8
	LOCALS = 포지션{LOCAL}
	IF FLAG:LOCALS > -1
		CFLAG:(FLAG:LOCALS):물리반사플래그 = 1
	ENDIF
NEXT
PRINTFORMW TARGET:\@ ARG:1 == 19  ? ENEMY # PARTY \@ >>>>>> 물리 공격을 반사!





