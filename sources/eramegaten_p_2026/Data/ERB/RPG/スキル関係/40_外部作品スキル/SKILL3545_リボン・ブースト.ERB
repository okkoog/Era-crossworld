			RESULTS:1 = 블루 스타
		CASE 3
			RESULTS += SET_COLOR_TAG(UNICODE(0x263D), "黄色")
			RESULTS += HTML_RECT_SPLIT_BAR(SKILLGAGE_D_GET(ARG, 3545), 10, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("黄"), RESULT:1)
			RESULTS:1 = 힐링 스태프
		CASE 4
