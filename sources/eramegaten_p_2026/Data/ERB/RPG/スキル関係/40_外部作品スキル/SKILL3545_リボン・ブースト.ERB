;一定ターン攻撃した対象に対し、『万能属性と対応属性の複合』で小威力の物理追撃を行う。
;====================================================
@SKILL_TRIGGER_ACTIONABLE_3545,ARG,ARG:1
;自分じゃなければNG
SIF FLAG:행동순1 != ARG
	RETURN 0
;一度のみの判定にする
SIF ARG != ARG:1
	RETURN 0
SIF SKILLGAGE_D_GET(ARG,3545) < 1
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
SIF RESULT != 1 || CFLAG:ARG:타겟 < 1
	RETURN 0
RETURN 1, CFLAG:ARG:타겟

