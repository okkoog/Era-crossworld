	ELSE
		RESULTS += SET_COLOR_TAG(UNICODE(0x263D), "黄色")
	ENDIF
	RESULTS += HTML_RECT_BAR(SKILLGAGE_F_GET(ARG, 3545), 100, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("緑"), RESULT:1)
	RESULTS:1 = 魔力蓄積量
ENDIF
RETURN 1
@SKILLGAGE_CHARGE_3545,ARG,ARG:1
#LOCALSIZE 1
#DIM L_T
#DIM L_GP
;スキルゲージDがある＝発動中の場合離脱
SIF SKILLGAGE_D_GET(ARG,3545) > 0
	RETURN 0
;ゲージが上限に到達している場合は離脱
SIF SKILLGAGE_F_GET(ARG,3545) == 100
	RETURN 0
L_GP = 0
;自分の行動の場合
IF ARG == ARG:1
	FOR LOCAL, 0, BCHARANUM
		L_T = BCHARA:LOCAL
		SIF IS_FRIEND(ARG, L_T)
			CONTINUE
		SIF GET_CREC_ACT(ARG, L_T, "HIT")
			L_GP += 5
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 5
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 5
	NEXT
	;気合を入れても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:기합]]
		L_GP += 15
	;集中しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:컨센트레이트]]
		L_GP += 15
	;雄叫びしても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:포효]]
		L_GP += 15
	;挑発しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:도발]]
		L_GP += 15
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += MAX(60 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ, 2)
;スキルゲージが100以上だと100にする
CALL SKILLGAGE_F_SET,ARG,3545,MIN(100, L_GP + SKILLGAGE_F_GET(ARG,3545))
;SIF SKILLGAGE_F_GET(ARG,3545) > 100
;	CALL SKILLGAGE_F_SET,ARG,3545,100
IF SKILLGAGE_F_GET(ARG,3545) == 100
	RESULTS = ＭＡＸ！
	RESULT:1 = COLOR("黄色")
ELSEIF SKILLGAGE_F_GET(ARG,3545) >= 50
	RESULTS = ＢＯＯＳＴ！
	RESULT:1 = COLOR("AQUA")
ELSE
	RESULTS = 魔力蓄積量
ENDIF
RESULTS:1 = \%
RETURN L_GP
