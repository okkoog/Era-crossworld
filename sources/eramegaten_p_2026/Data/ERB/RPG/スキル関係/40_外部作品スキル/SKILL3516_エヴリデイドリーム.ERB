@SKILL_ADDTIONAL_BASE_RATE_3516, ARG
;基本25、「陥落段階+1」倍で、最大100(上限に引っかかるが、ステ補正を受けてもなお高い数字になるように）
SIF ARG < 0
	RETURN 25

LOCAL = 25

;念のため：付与率向上はまゆ限定
SIF SKILL_CHANGE(ARG, [[キャラ:마유]])
	LOCAL = 25 * (1 + 陥落(ARG))

