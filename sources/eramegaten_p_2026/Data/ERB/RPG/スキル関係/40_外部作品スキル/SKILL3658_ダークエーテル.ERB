;MP回復
;レートを100MP消費＝50MP回復というひどいレートにする。MP回復がとんでもなく人権になりうるため。


;スキル名
@SKILL_NAME_3658,ARG
RESULTS = 다크에테르

;　명중
@SKILL_HITRATE_3658, ARG
RETURN 100

;　威力
@SKILL_POWER_3658, ARG
RETURN 50

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3658,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3658,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3658, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
;異能者による軽減がはいって91ぐらい
@SKILL_COST_3658,ARG
RETURN 130


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3658
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3658, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_3658,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3658,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3658, ARG
RETURN GET_SKILL_EFFECT_NUM("회복")


;계승타입
@SKILL_SUCCESSION_TYPE_3658
RETURN GET_SUCCESSION_NUM("회복")

;속도보정
@SKILL_SPEED_3658, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3658
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_3658, ARG = -1
RETURN 8


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3658, ARG, ARG:1, ARG:2
CALL VAR_MP, POS(ARG:1),50,"회복"
PRINTFORM 　　TARGET:[{ARG:1,2}] %CALLNAME:POS(ARG:1),20,LEFT%　>>>>>>　50MP回復
WAIT
;====================================================
;戦闘中以外での実行
;====================================================
;なんかこれだと文章でないので一回コメントアウト
@ACTION_FIELD_3658,ARG,ARG:1,ARG:2
CALL VAR_MP, POS(ARG:1),50,"회복"
;PRINTFORM 　　TARGET:[{ARG:1,2}] %CALLNAME:POS(ARG:1),20,LEFT%　>>>>>>　50MP回復
;WAIT
;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3658, ARG
PRINTL 아군 1명의 MP를 50 회복한다.



@継承不能_3658
RETURN 1

;使用条件
@SKILL_SPECIAL_ACTIONABLE_3658,ARG
RETURN 1
;とくにない

