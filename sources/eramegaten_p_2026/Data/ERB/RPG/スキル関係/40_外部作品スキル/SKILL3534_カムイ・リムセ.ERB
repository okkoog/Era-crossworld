;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_3534,ARG,ARG:1,ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
;修羅
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "마법위력", -4, "短縮"
	;IF CFLAG:(ARG:1):마법위력강화 > -16
	;	PRINT  & 魔法威力低下
	;	CFLAG:(ARG:1):마법위력강화 = MAX(-16, CFLAG:(ARG:1):마법위력강화 - 4)
	;ENDIF
;羅刹
ELSE
ENDIF
;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3534, ARG, ARG:1, ARG:2
#DIM STOCK,2

;STOCK:0 = MAXBASE:ARG:공격
;STOCK:1 = CFLAG:ARG:공격강화
;MAXBASE:ARG:공격 = MAXBASE:ARG:마법위력
;CFLAG:ARG:공격강화 = CFLAG:ARG:마법위력강화
;修羅
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	CALL ATTACK_FIELD,ARG,ARG:1,3534
;羅刹
ELSE
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),3534,1
	CALL SKILL_SET_カジャンダ, ARG, ARG, "명중/회피", 4, "단체"
	;CFLAG:ARG:명중강화 = MIN(32, CFLAG:ARG:명중강화 + 4)
	;CFLAG:ARG:회피강화 = MIN(32, CFLAG:ARG:회피강화 + 4)
	;PRINTFORMW %CALLNAME:ARG%の命中・回避が上がった！
ENDIF
;MAXBASE:ARG:공격 = STOCK:0
;CFLAG:ARG:공격강화 = STOCK:1


;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3534, ARG
IF TFLAG:전투중 == 0
	PRINTL 【修羅】
	PRINTL 적 전열에 파마 상성의 중 데미지 + 마법 위력 저하
	PRINTL 【羅刹】
	PRINTL 단체에 검격 + 충격 대 데미지 + 자신의 명중·회피 상승
ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0 || TFLAG:전투중 == 0
	PRINTL 신의 윤무. 적 전열에 파마 상성의 중 데미지 + 마법 위력을 저하시킨다.
	PRINTL 이 스킬은 마법 위력으로 데미지를 계산한다.
ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
	PRINTL 바람의 칼날. 단체에 검격 + 충격 대 데미지 + 자신의 명중·회피 상승한다
	PRINTL 이 스킬은 마법 위력으로 데미지를 계산한다.
ENDIF


