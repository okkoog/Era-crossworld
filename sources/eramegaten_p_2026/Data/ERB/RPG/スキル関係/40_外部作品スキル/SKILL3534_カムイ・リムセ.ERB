;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3534,ARG
;修羅
;SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	RESULTS = 카무이・림세
;羅刹
SIF ARG > -1 && SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
	RESULTS = 레라 무츠베

;　명중
@SKILL_HITRATE_3534, ARG
RETURN 100

;　威力
@SKILL_POWER_3534, ARG
IF ARG > -1
	;修羅
	SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
		RETURN 250
	;羅刹
	SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
		RETURN 350
ENDIF
RETURN 250

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3534,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3534,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3534, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_3534,ARG
IF ARG > -1
	;修羅
	SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
		RETURN 25
	;羅刹
	SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
		RETURN 25
ENDIF
RETURN 25

;　相性
@SKILL_TYPE_3534,ARG
#LOCALSSIZE 3
#LOCALSIZE 5
VARSET LOCALS
IF ARG > -1
	;修羅
	IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
		RETURN 10
	;羅刹
	ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
		RETURN GET_TYPE_NUM("검격"), GET_TYPE_NUM("충격")
		;LOCALS = 검격
		;LOCALS:1 = 충격
	ENDIF
ENDIF
RETURN GET_TYPE_NUM("검격")
