;뇌운
;敵全体に電撃属性の中ダメージ　想定コスト15　想定総合火力150

;スキル名
@SKILL_NAME_9013, ARG
RESULTS = 뇌운

;　명중
@SKILL_HITRATE_9013, ARG
;ライトニングシューター装備の場合、命中が100まで上昇
RETURN 70

@SKILL_POWER_9013, ARG
RETURN 150

;　최저공격횟수
@SKILL_MINATTACKNUMBER_9013, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_9013, ARG
