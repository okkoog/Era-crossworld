;　コストの量
@SKILL_COST_9013, ARG
;ライトニングシューターを装備している場合
IF ARG >= 0 && EQUIP:ARG:총 == GETNUM(ITEM, "라이트닝슈터")
	RETURN 15
ELSE
	RETURN 20
ENDIF

;　相性
@SKILL_TYPE_9013, ARG
RETURN GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_9013
