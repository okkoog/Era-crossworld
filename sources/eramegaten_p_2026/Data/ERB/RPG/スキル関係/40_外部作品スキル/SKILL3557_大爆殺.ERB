;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_3557,ARG,ARG:1
SIF FLAG:행동순2 < 0 && SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	CALL SKILLGAGE_H_SET(ARG,3557,MIN(SKILLGAGE_H_GET(ARG,[[스킬:재염]]),SKILLGAGE_F_GET(ARG,3557)))

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3557, ARG, ARG:1, ARG:2

;修羅
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),3557
	CALL SKILLGAGE_H_ADD(ARG,[[스킬:재염]],-SKILLGAGE_H_GET(ARG,3557))
;羅刹
ELSE
	CALL ATTACK_SPREAD,ARG,ARG:1,3557
ENDIF


;====================================================
;実行内容ここまで
;====================================================
;====================================================
;追加コマンド
;====================================================
@INPUT_COM_NAME_3557,ARG
RESULTS = 大爆殺
RESULTS:1 = 大爆殺災炎出力　{SKILLGAGE_F_GET(ARG, [[스킬:대폭살]])}
SELECTCASE SKILLGAGE_F_GET(ARG, [[스킬:대폭살]])
	CASE  3
		RESULTS:2 = 0xea5550
	CASE  2
		RESULTS:2 = 0xeb6a50
	CASE  1
		RESULTS:2 = 0xeb8350
	CASE  0
		RESULTS:2 = 0xebeb50
ENDSELECT
RETURN 0

@INPUT_COM_ABLE_大爆殺,ARG
SIF !HAVE_SKILL(ARG,[[스킬:재염]])
	RETURN 0
SIF !HAVE_SKILL(ARG,[[스킬:분노폭발]])
	RETURN 0
SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) != 0
	RETURN -1
RETURN 1

;====================================================
;コマンド実行
;====================================================
@INPUT_COM_大爆殺,ARG
LOCAL = SKILLGAGE_F_GET(ARG,3557)
CALL SKILLGAGE_F_SET(ARG,3557,(LOCAL + 1)%4)
CALL SKILLGAGE_H_SET(ARG,3557,MIN(SKILLGAGE_H_GET(ARG,[[스킬:재염]]),SKILLGAGE_F_GET(ARG,3557)))
RETURN -1

;　 説明文の表示
@SKILL_EXPLAIN_3557, ARG
IF TFLAG:전투중 == 0
	PRINTL 【修羅】
	PRINTL 적 단체에 화염 상성의 물리 데미지, 재염 사용으로 강화
	PRINTL 【羅刹】
	PRINTL 적 단체와 주위에 화염 + 타격 상성의 물리 데미지 + 연소
ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0 || TFLAG:전투중 == 0
	IF HAVE_SKILL(ARG,[[스킬:재염]])
		PRINTL 적 단체에 화염 속성의 물리 공격을 행한다.
		PRINTL 【재염·0】소위력의 공격을 행한다
		PRINTL 【재염·1】중위력의 공격을 행한다
		PRINTL 【재염·2】특대 위력의 공격을 행하며, 화염무효·내화염을 관통한다
		PRINTL 【재염·3】극대 위력의 공격을 행하며, 모든 내성과 내성강화 효과를 관통한다
	ELSE
		PRINTL 적 단체에 화염 속성의 소위력 물리 공격을 행한다. 코스트 소비 없음
	ENDIF
ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
	PRINTL 적 단체와 그 주위에 화염 + 타격 복합 속성의 대위력 물리 공격을 행한다
	PRINTL 追加効果：FLAME
ENDIF


