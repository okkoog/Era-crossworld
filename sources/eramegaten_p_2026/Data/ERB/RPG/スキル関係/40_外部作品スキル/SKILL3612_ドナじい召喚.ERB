;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3612, ARG, ARG:1, ARG:2
#DIM DYNAMIC LCOUNT
IF ABL:ARG:가창기능 > 9
	FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
		TSTR:스킬메시지추가효과 '= ""
		CALL SKILL_INVALID_WALL, ARG, POS(LCOUNT), "성스러운가호", "短縮"
		CALL HEAL_SINGLE,ARG,POS(LCOUNT),3612, 1, , TSTR:스킬메시지추가효과
	NEXT
	WAIT
ELSE
	CALL HEAL_FIELD,ARG,ARG:1,3612
ENDIF
