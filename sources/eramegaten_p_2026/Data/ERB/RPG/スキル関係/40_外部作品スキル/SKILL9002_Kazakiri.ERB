;일도류・바람베기
;敵1列に小ダメージの斬撃を2回与え、確率でバインドさせる　コスト10　総合火力130

;スキル名
@SKILL_NAME_9002,ARG
RESULTS = 일도류・바람베기

;　명중
@SKILL_HITRATE_9002, ARG
RETURN 120

;　威力
@SKILL_POWER_9002, ARG
RETURN 65

;　최저공격횟수
@SKILL_MINATTACKNUMBER_9002,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_9002,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_9002, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;MP

;　コストの量
@SKILL_COST_9002,ARG
RETURN 10

;　相性
@SKILL_TYPE_9002,ARG
RETURN GET_TYPE_NUM("검격")
;검격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_9002
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_9002, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_9002, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_9002,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_9002,ARG
RETURN GET_SPHERE_NUM("일렬")
;列

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_9002, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_9002
RETURN GET_SUCCESSION_NUM("검격")
;不可

@継承不能_9002
RETURN 1

;속도보정
@SKILL_SPEED_9002, ARG = -1
RETURN 4


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_9002
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_9002, ARG = -1
RETURN 5


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_9002,ARG
RETURN GET_STATE_NUM("BIND")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_9002,ARG
RETURN GET_TYPE_NUM("신경")

