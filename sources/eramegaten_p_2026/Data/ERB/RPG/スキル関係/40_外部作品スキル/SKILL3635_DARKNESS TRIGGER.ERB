;スキル名
@SKILL_NAME_3635, ARG
RESULTS = DARKNESS TRIGGER

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3635, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　威力
@SKILL_POWER_3635, ARG
RETURN 1000

;　コストの量
@SKILL_COST_3635, ARG
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "다크니스트리거Ｘ")
	RETURN 70
ELSE
	RETURN 50
ENDIF

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3635
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")
;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3635, ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

@SKILL_HEAL_TYPE_3635, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("割合")

;계승타입
@SKILL_SUCCESSION_TYPE_3635
RETURN GET_SUCCESSION_NUM("자동효과")

@継承不能_3635
RETURN 1
;不可

;スキル変化？用ランク
@SKILL_RANK_3635, ARG = -1
RETURN 23
;変化不可


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3635, ARG, ARG:1, ARG:2
CALL HEAL_SINGLE, ARG, ARG, 3635

;クードス没収
SIF SKILLGAGE_F_GET(ARG, [[스킬:블리츠대쉬]]) > 0
	PRINTFORML ＞%CALLNAME:ARG%의 쿠도스가 리셋되었다!
CALL SKILLGAGE_F_SET, ARG, [[스킬:블리츠대쉬]], 0
;モード・ディーヴァ終了（ブリッツダッシュ側で終了させてもいいんだが）
CALL SKILLGAGE_F_SET, ARG, [[스킬:SONG OF DIVA]], 0
;====================================================
;追加コマンド(一番下)
;====================================================

@INPUT_COM_NAME_3635,ARG
RESULTS = ダークネストリガー
RESULTS:1 = Ｄ-ＴＲＩＧＧＥＲ
RETURN 2

@INPUT_COM_ABLE_ダークネストリガー,ARG
RESULTS = 効果発動中
SIF SKILLGAGE_H_GET(ARG,3635)
	RETURN -1
CALL CHECK_COST,ARG,3635
SIF !RESULT
	RETURN -1
RESULTS = 모드 어웨이크닝
SIF HAVE_SKILL(ARG, [[스킬:SONG OF DIVA]]) && SKILLGAGE_H_GET(ARG, [[스킬:SONG OF DIVA]]) == 1
	RETURN -1
RETURN 1

;====================================================
;コマンド実行
;====================================================
@INPUT_COM_ダークネストリガー, ARG
#LOCALSIZE 1
#DIMS SKILL_USER
IF SKILLGAGE_H_GET(ARG, [[스킬:SONG OF DIVA]]) == 1
	PRINTW 모드 어웨이크닝 시에는 다크니스 트리거를 발동할 수 없습니다
	RETURN -1
ENDIF
CALL GET_SKILL_COST, 3635, ARG
PRINTFORML 다크니스 트리거를 사용하시겠습니까? (소비: {RESULT} MP)
IF SKILLGAGE_F_GET(ARG, [[스킬:SONG OF DIVA]]) == 1
	SETCOLOR 0x9933cd
	PRINTL 【경고】 다크니스 트리거 발동 중에는 모드 디바의 기능이 무효화됩니다.
	RESETCOLOR
ENDIF
CALL INPUT_YN
IF RESULT == 0
	LOCAL = CFLAG:ARG:입력행동
	CFLAG:ARG:입력행동 = 3635
	CALL PAY_COST, ARG, CFLAG:ARG:입력행동
	SKILL_USER = ＲｏＲｏ
	CALL PRINT_ACT_MESSAGE, ARG, 3625
	CALL SKILLGAGE_H_SET, ARG, [[스킬:DARKNESS TRIGGER]], 1
	PRINTFORML ＞동력 기관이 폭주한다! RoRo가 모드 다크니스로 변모했다!
	CALL BATTLE_EVENT_ACT, ARG
	CFLAG:ARG:입력행동 = LOCAL
	SIF SKILLGAGE_F_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 0
		CALL EXWEAPON_INITIALIZE, ARG
ENDIF
RETURN -1
;====================================================
;ターン終了時のロック判定
;====================================================
@TURNEND_DAMAGE_3635, ARG, ARG:1
#DIM ROCK_D
#DIM ROCK_H
#LOCALSIZE 1
ROCK_D = SKILLGAGE_D_GET(ARG, [[스킬:블리츠대쉬]])
;1桁は被弾回数,2桁以上はターゲットを割り当てるようにした
ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
IF BLITZ_TARGET_JUDG(ARG) == 1
ELSE
	;HPが最大HPの1/12以下なら1残るようにする
	IF BASE:(ARG):ＨＰ < MAXBASE:(ARG):ＨＰ/12
		LOCAL = BASE:(ARG):ＨＰ - 1
		PRINTFORML DARKNESS TRIGGER %CALLNAME:(ARG)% >>>>> 비록온 상태로 인해 RoRo가 덮쳐든다! { LOCAL } 데미지
		CALL VAR_HP, ARG, -LOCAL, "食いしばり無効ダメージ", ARG
	ELSE
		PRINTFORML DARKNESS TRIGGER %CALLNAME:(ARG)% >>>>> 비록온 상태로 인해 RoRo가 덮쳐든다! { MAX(MAXBASE:(ARG):ＨＰ/12,1) } 데미지
		CALL VAR_HP, ARG, -MAX(MAXBASE:(ARG):ＨＰ/12, 1), "食いしばり無効ダメージ", ARG
	ENDIF
ENDIF
