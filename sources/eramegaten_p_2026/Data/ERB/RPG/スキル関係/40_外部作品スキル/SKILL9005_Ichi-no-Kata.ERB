;일도류・제1형
;敵1体にクリティカルしやすい小ダメージの斬撃を5回与える　コスト20　総合火力150

;スキル名
@SKILL_NAME_9005,ARG
RESULTS = 일도류・제1형

;　명중
@SKILL_HITRATE_9005, ARG
RETURN 120

;　威力
@SKILL_POWER_9005, ARG
RETURN 30

;　クリティカル率
@SKILL_CRITICAL_RATE_9005,ARG
RETURN 10

;　최저공격횟수
@SKILL_MINATTACKNUMBER_9005,ARG
RETURN 5

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_9005,ARG
RETURN 5

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_9005, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_9005,ARG
RETURN 20

;　相性
@SKILL_TYPE_9005,ARG
RETURN GET_TYPE_NUM("검격")
;검격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_9005
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_9005, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_9005, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_9005,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_9005,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_9005, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_9005
RETURN GET_SUCCESSION_NUM("검격")
;不可

@継承不能_9005
RETURN 1

;속도보정
@SKILL_SPEED_9005, ARG = -1
RETURN 5


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_9005
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_9005, ARG = -1
RETURN 0



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_9005, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,9005






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_9005, ARG
PRINTL 일도류의 기본적인 자세, 그곳에서 내지르는 연속 베기
PRINTL 적 1체에 크리티컬하기 쉬운 소 데미지의 참격을 5회 가한다

;継承に必要な部位
@継承部位_9005,ARG
RESULTS = 무기
RETURN 1
;무기


;使用条件
@SKILL_SPECIAL_ACTIONABLE_9005,ARG
RETURN 1
;とくにない

