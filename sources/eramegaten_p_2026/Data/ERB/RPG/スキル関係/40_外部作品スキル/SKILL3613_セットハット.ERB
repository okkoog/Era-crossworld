;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_3613,ARG,ARG:1
#LOCALSIZE 2
#DIM 取得オーブ
#DIM L_T
取得オーブ = 0
;敵の行動の場合アウト
SIF CFLAG:(ARG:1):PT플래그 == 0
	RETURN
;自分の行動の場合
IF ARG == ARG:1
	FOR LOCAL,0,BCHARANUM
		L_T = BCHARA:LOCAL
		SIF CFLAG:L_T:PT플래그 == CFLAG:ARG:PT플래그
			CONTINUE
		;ダメージとレベルに応じてレッドストーン取得
		LOCAL:1 = MIN(MAXBASE:L_T:LV / 6,9) + 1
		SIF CFLAG:L_T:현데미지 > 0
			取得オーブ += MIN(CFLAG:L_T:현데미지,MAXBASE:L_T:ＨＰ) * LOCAL:1 / MAXBASE:L_T:ＨＰ
		SIF CFLAG:L_T:현데미지 > 100
			取得オーブ ++
	NEXT
ELSEIF SKILLGAGE_H_GET(ARG,3613) >= 0 && SKILLGAGE_D_GET(ARG,3613) > 0
	LOCAL = SKILLGAGE_H_GET(ARG,3613)
	IF CFLAG:LOCAL:PT플래그 != CFLAG:ARG:PT플래그
		;ダメージとレベルに応じてレッドストーン取得
		LOCAL:1 = MIN(MAXBASE:LOCAL:LV / 6,9) + 1
		SIF CFLAG:LOCAL:현데미지 > 0
			取得オーブ += MIN(CFLAG:LOCAL:현데미지,MAXBASE:LOCAL:ＨＰ) * LOCAL:1 / MAXBASE:LOCAL:ＨＰ
		SIF CFLAG:LOCAL:현데미지 > 100
			取得オーブ ++
	ENDIF
ENDIF
MONEY:99 += 取得オーブ
RESULTS = 
RESULTS:1 = 
RESULTS:2 = {取得オーブ}個のレッドオーブを得た！
RETURN 取得オーブ
;IF 取得オーブ
;	PRINTFORML レッドオーブ +{取得オーブ}
;	MONEY:99 += 取得オーブ
;ENDIF

