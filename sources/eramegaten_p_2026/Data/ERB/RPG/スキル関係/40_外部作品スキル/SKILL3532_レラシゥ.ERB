;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;
;修羅:自身と味方の通常攻撃後に発動し、敵前列に疾風相性の極小ダメージを与える
;====================================================
@SKILL_TRIGGER_ACTIONABLE_3532, ARG, ARG:1
;修羅
SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) != 0
	RETURN 0
;自分と攻撃しているキャラが味方同士である必要がある
SIF !IS_FRIEND(ARG, FLAG:행동순1)
	RETURN 0
;自分と判定対象が味方同士であってはならない(反射等で発生する)
SIF !IS_FRIEND(ARG, ARG:1)
	RETURN 0
SIF CFLAG:(FLAG:행동순1):입력행동 != 0
	RETURN 0
;1行動につき1回のみ
SIF TFLAG:스킬트리거용1++ > 0
	RETURN 0
IF CFLAG:ARG:PT플래그 > 0
	RETURN 1, 20
ELSE
	RETURN 1, 17
ENDIF
;RESULT:1 = 20
;SIF CFLAG:(ARG):PT플래그 == 0
;	RESULT:1 = 17
;RETURN 1

;====================================================
;カウンター発動条件
;ARG	:攻撃を受けている側(=このスキルを所持しているキャラ)のキャラ番号
;ARG:1	:上記に対して攻撃を仕掛けている側のキャラ番号
;RESULT :戻り値はカウンターの対象となるポジション番号。あるいは範囲なら20等で指定
;====================================================
@SKILL_COUNTER_ACTIONABLE_3532,ARG,ARG:1
;羅刹
SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) != 1
	RETURN 0
;攻撃を受けている
SIF !GET_CREC_ACT(ARG:1, ARG, "HIT")
	RETURN 0
;敵が前列にいないとだめ
SIF !IS_FRONT(ARG:1)
	RETURN 0
;1/2の確率で発動
SIF !RAND:2
	RETURN 0
RETURN 1, CPOS(ARG:1)
;SIF ARG:1 < 0 || GET_STATE(CFLAG:(ARG:1):상태이상) == "DYING"
;	RETURN 0
;SIF !GETBIT(CFLAG:ARG:受けフラグ,18) && !GETBIT(CFLAG:ARG:受けフラグ,19)
;	RETURN 0
;SIF !CFLAG:ARG:현데미지
;	RETURN 0
;SIF !RAND:2
;	RETURN 0
;SIF INRANGE(CPOS(ARG:1), 1, 3) || INRANGE(CPOS(ARG:1), 7, 11)
;	RETURN POS(ARG:1)
;RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3532, ARG, ARG:1, ARG:2
#DIM STOCK,2

;STOCK:0 = MAXBASE:ARG:공격
;STOCK:1 = CFLAG:ARG:공격강화
;MAXBASE:ARG:공격 = MAXBASE:ARG:마법위력
;CFLAG:ARG:공격강화 = CFLAG:ARG:마법위력강화
;修羅
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	CALL ATTACK_FIELD,ARG,ARG:1,3532
;羅刹
ELSE
	TFLAG:필중 = 1
	TFLAG:반사0데미지화 = 1
	TFLAG:흡수0데미지화 = 1
	CALL ATTACK_SINGLE, ARG, POS(ARG:1), 3532
	TFLAG:필중 = 0
	TFLAG:반사0데미지화 = 0
	TFLAG:흡수0데미지화 = 0
	PRINTL
ENDIF
;MAXBASE:ARG:공격 = STOCK:0
;CFLAG:ARG:공격강화 = STOCK:1

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3532, ARG
IF TFLAG:전투중 == 0
	PRINTL 【修羅】
	PRINTL 자신과 아군의 통상 공격 후에 발동하여 적 전열에 질풍 상성의 극소 데미지를 준다
	PRINTL 【羅刹】
	PRINTL 적이 전열에 있을 때, 데미지를 받으면 50% 확률로 전기 상성의 대 데미지로 반격한다
ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0 || TFLAG:전투중 == 0
	PRINTL 회오리바람. 자신과 아군의 통상 공격 후에 발동하여 적 전열에 질풍 상성의 소 데미지를 준다
	PRINTL 이 스킬은 마법 위력으로 데미지를 계산한다.
ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
	PRINTL 수호의 엄니. 적이 전열에 있을 때, 데미지를 받으면 50% 확률로 전기 상성의 대 데미지로 반격한다
	PRINTL 이 스킬은 마법 위력으로 데미지를 계산한다.
ENDIF


