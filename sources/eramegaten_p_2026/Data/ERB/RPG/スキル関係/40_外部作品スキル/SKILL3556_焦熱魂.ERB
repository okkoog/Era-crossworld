;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_3556,ARG,ARG:1
SIF FLAG:행동순2 < 0 && SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	CALL SKILLGAGE_H_SET(ARG,3556,MIN(SKILLGAGE_H_GET(ARG,[[스킬:재염]]),SKILLGAGE_F_GET(ARG,3556)))

;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_3556, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "ATK"
		SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0 && SKILLGAGE_H_GET(ARG,3556) > 1
			RETURN LIMIT(CFLAG:ARG:공격강화 + CFLAG:ARG:마법위력강화, -48, 64), 32
		RETURN 0
ENDSELECT

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_3556, ARG, ARG:1, ARG:2
#DIM STOCK,2

;修羅
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	;STOCK:0 = MAXBASE:ARG:마법위력
	;STOCK:1 = CFLAG:ARG:마법위력강화
	;MAXBASE:ARG:마법위력 = MAXBASE:ARG:공격
	;SIF SKILLGAGE_H_GET(ARG,3556) > 1
	;	CFLAG:ARG:마법위력강화 += CFLAG:ARG:공격강화
	CALL ATTACK_FIELD,ARG,ARG:1,3556
	;MAXBASE:ARG:마법위력 = STOCK:0
	;CFLAG:ARG:마법위력강화 = STOCK:1
	
	CALL SKILLGAGE_H_ADD(ARG,[[스킬:재염]],-SKILLGAGE_H_GET(ARG,3556))
;羅刹
ELSE
	CALL ATTACK_FIELD,ARG,ARG:1,3556
ENDIF

;====================================================
;追加コマンド(一番下)
;====================================================
@INPUT_COM_NAME_3556,ARG
RESULTS = 焦熱魂
RESULTS:1 = 焦熱魂災炎出力
SELECTCASE SKILLGAGE_F_GET(ARG, [[스킬:초열혼]])
	CASE  3
		RESULTS:2 = 0xea5550
	CASE  2
		RESULTS:2 = 0xeb6a50
	CASE  1
		RESULTS:2 = 0xeb8350
	CASE  0
		RESULTS:2 = 0xebeb50
ENDSELECT
RETURN 0

@INPUT_COM_ABLE_焦熱魂,ARG
SIF !HAVE_SKILL(ARG,[[스킬:재염]])
	RETURN 0
SIF !HAVE_SKILL(ARG,[[스킬:분노폭발]])
	RETURN 0
SIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) != 0
	RETURN -1
RETURN 1

;====================================================
;コマンド実行
;====================================================
@INPUT_COM_焦熱魂,ARG
#LOCALSIZE 2
LOCAL = SKILLGAGE_F_GET(ARG,3556)
LOCAL:1 = SKILLGAGE_H_GET(ARG,3556)
CALL SKILLGAGE_F_SET(ARG,3556,(LOCAL + 1)%4)
CALL SKILLGAGE_H_SET(ARG,3556,MIN(SKILLGAGE_H_GET(ARG,[[스킬:재염]]),SKILLGAGE_F_GET(ARG,3556)))
IF CFLAG:ARG:입력행동 == 3556 && (LOCAL/2 != SKILLGAGE_H_GET(ARG,3556)/2)
	CFLAG:ARG:입력행동 = -1
	CFLAG:ARG:타겟 = -1
ENDIF
RETURN -1

