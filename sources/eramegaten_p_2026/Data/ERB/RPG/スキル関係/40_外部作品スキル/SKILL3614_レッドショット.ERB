;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3614, ARG, ARG:1, ARG:2
SIF MONEY:99 < 30 && CFLAG:ARG:PT플래그 > 0
	RETURN 0
	
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,3614

SIF CFLAG:ARG:PT플래그 > 0
	MONEY:99 -= 30

