;逸刀流秘奥義・胡蝶獄門
;敵単体に高クリティカル、完全貫通付きの単発特大ダメージ　コスト90　総合火力600

;スキル名
@SKILL_NAME_9000,ARG
RESULTS = 일도류오의・호접옥문

;　명중
@SKILL_HITRATE_9000, ARG
RETURN 100

;　威力
@SKILL_POWER_9000, ARG
RETURN 600

@SKILL_CRITICAL_RATE_9000, ARG
RETURN 30

;　최저공격횟수
@SKILL_MINATTACKNUMBER_9000,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_9000,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_9000, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_9000,ARG
RETURN 90

;　相性
@SKILL_TYPE_9000,ARG
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_9000
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_9000, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_9000, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_9000,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_9000,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_9000, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_9000
RETURN GET_SUCCESSION_NUM("검격")
;不可
@継承不能_9000
RETURN 1

;속도보정
@SKILL_SPEED_9000, ARG = -1
RETURN 8


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_9000
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_9000, ARG = -1
RETURN 15



;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_9000, ARG = -1, ARG:1 = -1
RETURN 4

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_9000, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,9000






