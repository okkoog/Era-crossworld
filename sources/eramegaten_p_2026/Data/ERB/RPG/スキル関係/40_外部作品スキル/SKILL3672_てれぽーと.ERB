;星をみるひとたち用のスキル

;スキル名
@SKILL_NAME_3672,ARG
RESULTS = 텔레포트


;　명중
@SKILL_HITRATE_3672, ARG
RETURN 100

;　威力
@SKILL_POWER_3672, ARG
RETURN 40

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3672,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3672,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3672, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3672,ARG
RETURN 15


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3672
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3672, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_3672,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3672,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3672, ARG
RETURN GET_SKILL_EFFECT_NUM("회복")


;계승타입
@SKILL_SUCCESSION_TYPE_3672
RETURN GET_SUCCESSION_NUM("지원")
;속도보정
@SKILL_SPEED_3672, ARG = -1
RETURN 999

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3672
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3672, ARG = -1
RETURN 4




;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3672, ARG, ARG:1, ARG:2
;コスト支払い
;CALL PAY_COST,ARG,3672
FLAG:도주플래그 = 1


;====================================================
;実行内容ここまで
;====================================================




;　 説明文の表示
@SKILL_EXPLAIN_3672, ARG
PRINTL 전투에서 확실하게 도주한다. 초고속 발동.
PRINTL 파티 전체를 텔레포트시켜 그 자리에서 도주한다.
;原作だと「ふるてれぽーと」に該当するんですけど、本作のシステムでトラフーリ的なものを後半に回す必要がないので、迷った結果こんなかんじに。

@SKILL_EXPLAIN_TOOLTIP_3672, ARG
RESULTS = 전투에서 확실하게 도주한다.



;使用条件
@SKILL_SPECIAL_ACTIONABLE_3672,ARG
;脱出スキル禁止フラグ立ってたら使用できない
SIF FLAG:도주불가플래그
	RETURN 0
RETURN 1

