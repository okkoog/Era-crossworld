;인법・공둔의술
;パッシブ効果。回避率を上げ、回避に成功した際に確率で剣撃ガードブレイクを付与する

;スキル名
@SKILL_NAME_9001,ARG
RESULTS = 인법・공둔의술

;　명중
@SKILL_HITRATE_9001, ARG
RETURN 100

;　威力
@SKILL_POWER_9001, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_9001,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_9001,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_9001, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_9001,ARG
RETURN 0

;　相性
@SKILL_TYPE_9001,ARG
RETURN GET_TYPE_NUM("검격")
;검격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_9001
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_9001, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_9001,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_9001,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_9001, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")


;계승타입
@SKILL_SUCCESSION_TYPE_9001
RETURN GET_SUCCESSION_NUM("검격")
;不可

;속도보정
@SKILL_SPEED_9001, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_9001
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_9001, ARG = -1
RETURN 13



;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
;====================================================
@SKILL_COUNTER_ACTIONABLE_9001,ARG,ARG:1
;攻撃を回避していたら
SIF !GET_CREC_ACT(ARG:1, ARG, "AVOID")
	RETURN 0
;攻撃に当たってしまっている場合は発動しない
SIF GET_CREC_ACT(ARG:1, ARG, "HIT/BLOCK/DRAIN")
	RETURN 0
;50%の確率
SIF !RAND:2
	RETURN 0
RETURN 1, CPOS(ARG:1)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_9001, ARG, ARG:1, ARG:2

;対象が死んでる場合は終了
SIF POS(ARG:1) == -1 || CFLAG:POS(ARG:1):상태이상 == GET_STATE_NUM("DYING")
	RETURN
CALL SKILL_GUARD_KILL, ARG, "검격", ARG:1, 3

;====================================================
;ダメージ計算時の追加補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_9001, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;ステート名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
;自分が攻撃側
IF L_P == L_ACTOR
;自分は防御側
ELSE
	SELECTCASE ARGS
		;回避強化を計算する時、通常の数値に追加でこの数値が合算される
		;この補正を-999以上で指定した場合は回避不能、999で指定した場合は絶対回避となる
		CASE "追加回避強化"
			RETURN 4
	ENDSELECT
ENDIF
RETURN 0

