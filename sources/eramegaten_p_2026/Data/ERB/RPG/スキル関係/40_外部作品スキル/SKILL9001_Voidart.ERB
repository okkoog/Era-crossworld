PRINTL 회피율이 상승하고 회피에 성공했을 경우 확률로 검격 가드 브레이크를 부여한다


;とくにない

@継承不能_9001
RETURN 1

@SKILL_ACTIONABLE_BATTLE_9001,ARG
RETURN 0

;使用条件
@SKILL_SPECIAL_ACTIONABLE_9001,ARG
RETURN 0
