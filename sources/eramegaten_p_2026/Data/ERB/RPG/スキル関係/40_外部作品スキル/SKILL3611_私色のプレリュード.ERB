;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3611, ARG, ARG:1, ARG:2
SELECTCASE ABL:ARG:가창기능
	CASE 10
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "마법효과", 8, "範囲", "NOMES"
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "攻撃_魔法威力", 4, "範囲", "", "↑공격 & ↑마법위력 & ↑↑마법효과"
	CASE 6 TO 9
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "攻撃_魔法威力_魔法効果", 4, "範囲"
	CASEELSE
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "攻撃_魔法効果", 4, "範囲"
ENDSELECT
