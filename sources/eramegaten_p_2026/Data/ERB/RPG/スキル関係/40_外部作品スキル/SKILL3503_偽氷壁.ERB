;
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3503,ARG
RESULTS = 가짜얼음벽

;　명중
@SKILL_HITRATE_3503, ARG
RETURN 100

;　威力
@SKILL_POWER_3503, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3503,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3503,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3503, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3503,ARG
RETURN 7

;　相性
@SKILL_TYPE_3503,ARG
RETURN GET_TYPE_NUM("없음")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3503
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3503, ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　사거리
@SKILL_RANGE_3503,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3503,ARG
RETURN GET_SPHERE_NUM("적아군전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3503, ARG
RETURN GET_SKILL_EFFECT_NUM("상태변화")


;계승타입
@SKILL_SUCCESSION_TYPE_3503
RETURN GET_SUCCESSION_NUM("빙결")
;빙결

;속도보정
@SKILL_SPEED_3503, ARG = -1
RETURN 999

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3503
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3503, ARG = -1
RETURN 10





;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3503, ARG, ARG:1, ARG:2
CALL SKILL_INVALID_WALL, ARG, ARG:1, "ARG", "단체", "NOMES"
CFLAG:ARG:방어플래그 = 1
PRINTFORMW %ARG는% 가짜얼음으로 방패를 만들고 방어태세를 취했다




;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_3503, ARG
PRINTL 가짜얼음으로 방패를 만들어　한 번 만 공격을 무효화하고、방어테세가 된다
PRINTL 스킬의 발생이 상당히 빠르다

@継承不能_3503
RETURN 1



;使用条件
@SKILL_SPECIAL_ACTIONABLE_3503,ARG
RETURN 1
;とくにない

