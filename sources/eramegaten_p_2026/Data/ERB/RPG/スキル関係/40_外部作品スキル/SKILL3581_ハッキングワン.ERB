;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_3581,ARG,ARG:1
;自分の行動のときのみ判定
SIF FLAG:행동순1 != ARG
	RETURN 0
;判定は一回
SIF ARG != ARG:1
	RETURN 0
;ハッキングワン起動中
SIF !SKILLGAGE_D_GET(ARG, 3581)
	RETURN 0
;入力行動がハッキング系
SIF !GROUPMATCH(SKILL_NAME_F(CFLAG:ARG:입력행동), "배드인밸리드", "슬리프올", "매드스트라이프", "커스올", "아이스：TROY")
	RETURN 0
;対象のポジション確認
SIF	!CPOS(SKILLGAGE_H_GET(ARG, 3581))
	RETURN 0
CALL SKILLGAGE_F_SET, ARG, 3581, CFLAG:ARG:입력행동
RETURN 1, CPOS(SKILLGAGE_H_GET(ARG, 3581))

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3581, ARG, ARG:1, ARG:2
#LOCALSSIZE 1
#LOCALSIZE 2
#DIM HACKING_R
IF FLAG:총공격중
	CALL SKILL_ACTION, SKILLGAGE_F_GET(ARG,3581), ARG, ARG:1
ELSE
	CALL ATTACK_SKILL, ARG, ARG:1, 3581
ENDIF

@SKILL_DAMAGE_EFFECT_3581, ARG, ARG:1, ARG:2
#DIMS CONST EFFECT_TABLE = "공격", "방어", "命中・回避", "마법위력", "마법효과", 
#DIM DYNAMIC TEMP
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
TEMP = RAND:5
CALL SKILL_SET_カジャンダ, ARG, ARG:1, EFFECT_TABLE:TEMP, -4, "단체", "NOWAIT", @"ハッキング成功 & %EFFECT_TABLE:TEMP%低下"
CALL SKILLGAGE_H_SET,ARG,3581,ARG:1
CALL SKILLGAGE_D_SET,ARG,3581,6

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================


;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_3581,ARG
SIF SKILLGAGE_D_GET(ARG,3581) <= 0
	RETURN 0
SIF SKILLGAGE_H_GET(ARG,3581) <= 0
	RETURN 0
SIF !IS_TARGET_ABLE(SKILLGAGE_H_GET(ARG,3581))
	RETURN 0
RESULTS = Hack >>> [POS.{CPOS(SKILLGAGE_H_GET(ARG,3581))}]
RETURN 3

