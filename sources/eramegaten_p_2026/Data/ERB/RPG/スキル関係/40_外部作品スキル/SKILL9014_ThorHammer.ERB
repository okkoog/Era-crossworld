;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_9014, ARG
RETURN 70

;拡散攻撃用追加処理
@SKILL_SPREAD_9014,ARG
RETURN 1
;拡散距離:1

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_9014, ARG = -1, ARG:1 = -1
;ライトニングシューター装備中にクールタイムが０ならば全貫通　それ以外は普通の貫通
IF ARG >= 0 && EQUIP:ARG:총 == GETNUM(ITEM, "라이트닝슈터") && SKILLGAGE_D_GET(ARG,9014) == 0 
	RETURN 4
ELSE
	RETURN 0, 4
ENDIF
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_9014, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
;CALL ATTACK_SINGLE,ARG,LOCAL, 9014
CALL ATTACK_SPREAD,ARG,ARG:1, 9014

; ライトニングシューターのクールタイムをセット
IF ARG >= 0  && EQUIP:ARG:총 == GETNUM(ITEM, "라이트닝슈터") && SKILLGAGE_D_GET(ARG,9014) == 0
	;Dゲージ4。使用後3ターン、負担のかかったライトニングシューターのクールタイムを設ける。
	CALL SKILLGAGE_D_SET, ARG, 9014,4
ENDIF

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_9014,ARG
;ライトニングシューターを装備しているか
IF ARG >= 0 && EQUIP:ARG:총 == GETNUM(ITEM, "라이트닝슈터")
	;スタンバイ完了
	IF SKILLGAGE_D_GET(ARG,9014) == 0
		RESULTS '= SET_COLOR_TAG("雷銃冷却完了", "#ffef00")
	;NG
	ELSE
		RESULTS '= SET_COLOR_TAG(@"雷銃冷却中({SKILLGAGE_D_GET(ARG,9014)}Ｔ)", "#999999")
	ENDIF
	RETURN 3
ENDIF


