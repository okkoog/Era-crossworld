;토르해머
;敵単体に電撃属性の大ダメージ、確率でSHOCKにする　想定コスト60　想定総合火力500～600 + 火力120の拡散

;スキル名
@SKILL_NAME_9014, ARG
IF FLAG:행동순1 == ARG
	RESULTS = 雷鎚＜토르해머＞
ELSE
	RESULTS = 뇌추＜토르해머＞
ENDIF
;　명중
@SKILL_HITRATE_9014, ARG
;ライトニングシューター装備の場合、命中が100まで上昇
RETURN 60

@SKILL_POWER_9014, ARG
SIF FLAG:확산플래그 == 1
	RETURN 120
; ライトニングシューターのクールタイムが０の場合威力上昇
IF ARG >= 0 && EQUIP:ARG:총 == GETNUM(ITEM, "라이트닝슈터") && SKILLGAGE_D_GET(ARG,9014) == 0
	RETURN 600
ELSE
	RETURN 500
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_9014, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_9014, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_9014, ARG
