

;スキル名
@SKILL_NAME_3610,ARG
RESULTS = 메테오

;　명중
@SKILL_HITRATE_3610, ARG
RETURN 100

;　威力
@SKILL_POWER_3610, ARG
IF SKILLGAGE_D_GET(ARG, 3600) >= 3
	RETURN 600
ELSEIF SKILLGAGE_D_GET(ARG, 3600) > 0
	RETURN 500
ELSE
	RETURN 400
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3610,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3610,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3610, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3610,ARG
RETURN 40

;　相性
@SKILL_TYPE_3610,ARG
;화염
RETURN GET_TYPE_NUM("화염")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3610
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3610, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3610, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3610,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3610,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3610, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_3610,ARG
;화염
RETURN 7

;속도보정
@SKILL_SPEED_3610, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3610
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3610, ARG = -1
RETURN 0

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_3610, ARG = -1, ARG:1 = -1
SIF SKILLGAGE_D_GET(ARG, 3600) >= 3
	RETURN 4
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3610, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
IF SKILLGAGE_D_GET(ARG, 3600) >= 3
	CALL ATTACK_SINGLE,ARG,LOCAL,3610
	CALL SKILLGAGE_D_ADD(ARG,3600,-3)	
ELSEIF SKILLGAGE_D_GET(ARG, 3600) > 0
	CALL ATTACK_SINGLE,ARG,LOCAL,3610
	CALL SKILLGAGE_D_ADD(ARG,3600,-1)
ELSE
	CALL ATTACK_SINGLE,ARG,LOCAL,3610
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_3610, ARG
IF SKILLGAGE_D_GET(ARG, 3600) >= 3
	PRINTL 적 1체에 화염 속성의 초특대 데미지
	PRINTL 적의 모든 내성 및 내성강화 효과를 관통한다.
	PRINTL DT를 3 소비
ELSEIF SKILLGAGE_D_GET(ARG, 3600) > 0
	PRINTL 적 1체에 화염 속성의 초특대 데미지
	PRINTL DT를 1 소비
ELSE
	PRINTL 적 1체에 화염 속성의 특대 데미지
ENDIF



;使用条件
@SKILL_SPECIAL_ACTIONABLE_3610,ARG
SIF FINDCHARA_M(ARG,0,4998,4999) == 1
	RETURN 1
RETURN 0

