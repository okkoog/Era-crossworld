;　 説明文の表示
@SKILL_EXPLAIN_3591, ARG
#LOCALSIZE 1
IF CFLAG:(CHARANUM-1):PT플래그 || ARG < 0 || ARG >= CHARANUM
	PRINTL 【通常時】
	PRINTL 적 전체에 질풍 상성의 대 데미지 + SLEEP. 최종 위력은 마와 힘 수치가 가까울수록 상승한다
	PRINTL 
	PRINTL 【클라이맥스 레뷰 발동 시】
	PRINTL 적 1체에 『질풍·수격·정신』 복합 초특대 데미지. 최종 위력은 마와 힘 수치가 가까울수록 상승한다
ELSE
	;CR展開時
	IF GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
		SETCOLOR 0x56b78e
		PRINTL 【ＣＬＩＭＡＸ　ＡＣＴ】
		RESETCOLOR
		PRINTL 한낮에 꽃피는 단 하나의 별의 노래를 불러내는 에메랄드 프린세스의 필살기
		PRINTL 적 1체에 『질풍·수격·정신』 복합 초특대 데미지. 최종 위력은 마와 힘 수치가 가까울수록 상승한다
		;露崎パワーアップイベント中かつボスが最終形態時のみ撃ち放題
		IF GETBIT(イベントフラグ:93:14, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:마히루]])
			SETCOLOR 0x56b78e
			PRINTL 혼신의 일격으로 이 레뷰에 결착을!
			RESETCOLOR
		;通常
		ELSE
			PRINTL 사용하면 클라이맥스 레뷰는 종료된다
		ENDIF
	ELSE
		PRINTL 적 전체에 질풍 상성의 대 데미지 + SLEEP. 최종 위력은 마와 힘 수치가 가까울수록 상승한다
		PRINTL 클라이맥스 레뷰 발동 중에는 성능이 변화한다.
	ENDIF
ENDIF

