;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3552, ARG, ARG:1, ARG:2
;修羅
IF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	CALL ATTACK_FIELD,ARG,ARG:1,3552,1
	;IF CFLAG:(ARG):PT플래그 == 0
	;	LOCAL:1 = 7
	;	LOCAL:2 = 17
	;ELSE
	;	LOCAL:1 = 1
	;	LOCAL:2 = 7
	;ENDIF
	
	;FOR LOCAL,LOCAL:1,LOCAL:2
	;	SIF POS(LOCAL) < 0
	;		CONTINUE
	;	CFLAG:POS(LOCAL):마법효과강화 = MIN(32, CFLAG:POS(LOCAL):마법효과강화 + 4)
	;NEXT
	CALL SKILL_SET_カジャンダ, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, "마법효과", 4, "範囲", "NOMES"
	PRINTFORMW \@ CFLAG:ARG:PT플래그 == 0 ? 적 # 아군 \@의 마법 효과가 올라갔다!
;羅刹
ELSE
	CALL ATTACK_RAND,ARG,ARG:1,3552
ENDIF



;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_3552, ARG
IF TFLAG:전투중 == 0 && ARG > -1 && HAVE_SKILL(ARG, [[스킬:분노폭발]])
	PRINTL 【修羅】
	PRINTL 적 전열에 빙결 데미지 + 마봉 + 아군의 마법 효과 상승
	PRINTL 【羅刹】
	PRINTL 적 전열 랜덤으로 빙결 데미지 + 혼란
ELSEIF ARG < 0 || SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 0
	PRINTL 신의 거울　전방에 얼음 거울을 발생시키고 그 뒤에 얼음 창을 발생시킨다
	PRINTL 적 전열에 빙결 속성 중위력 마법 공격을 행하고 아군 전체의 마법 효과를 올린다
	PRINTL 追加効果：CLOSE
ELSEIF SKILLGAGE_F_GET(ARG,[[스킬:분노폭발]]) == 1
	PRINTL 눈보라의 창　얼음 결정으로 만들어 낸 무수한 창으로 적에게 공격을 행한다
	PRINTL 적 전열 랜덤으로 빙결 속성 소위력 마법 공격을 3~9회(1체당 최대 3회) 행한다
	PRINTL 追加効果：PANIC
ENDIF




