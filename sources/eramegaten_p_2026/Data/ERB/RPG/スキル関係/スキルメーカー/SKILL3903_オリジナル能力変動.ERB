;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3903,ARG
IF ARG == -1
	RESULTS = 오리지널능력변동
ELSE
	RESULTS = %CSTR:MASTER:199%
ENDIF
;　명중
@SKILL_HITRATE_3903, ARG
RETURN 100

;　威力
@SKILL_POWER_3903, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3903,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3903,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3903, ARG
SIF (イベントフラグ:45:17 == 2 && BASE:ARG:ＨＰ <= イベントフラグ:45:16) || (イベントフラグ:45:17 == 3 && BASE:ARG:ＭＰ <= イベントフラグ:45:16)  
	RETURN 2
RETURN 1
;RETURN イベントフラグ:45:1
;消費なし＝1

;　コストの量
@SKILL_COST_3903,ARG
SIF (イベントフラグ:45:17 == 2 && BASE:ARG:ＨＰ <= イベントフラグ:45:16) || (イベントフラグ:45:17 == 3 && BASE:ARG:ＭＰ <= イベントフラグ:45:16)  
	RETURN 9999
IF イベントフラグ:45:17 == 2
	BASE:ARG:ＨＰ -= イベントフラグ:45:16
ELSE
	BASE:ARG:ＭＰ -= イベントフラグ:45:16
ENDIF
RETURN 0
;RETURN イベントフラグ:45:16


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3903
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3903, ARG
RETURN イベントフラグ:45:13

;　사거리
@SKILL_RANGE_3903,ARG
RETURN イベントフラグ:45:0

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3903,ARG
RETURN イベントフラグ:45:15

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3903, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")


;계승타입
@SKILL_SUCCESSION_TYPE_3903
RETURN GET_SUCCESSION_NUM("검격")

;속도보정
@SKILL_SPEED_3903, ARG = -1
RETURN イベントフラグ:45:18


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3903
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3903, ARG = -1
RETURN 1



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3903, ARG, ARG:1, ARG:2
#DIM DYNAMIC 스킬수
#DIM DYNAMIC 単体範囲
#DIM DYNAMIC 回数
#LOCALSIZE 4

LOCALS = %CSTR:MASTER:198%
SIF LOCALS != ""
	PRINTFORML %CSTR:MASTER:198%

SIF イベントフラグ:45:14 == 3
	스킬수 = 7
SIF イベントフラグ:45:14 == 4
	스킬수 = 12

FOR LOCAL:3, 1, (스킬수+1)
	IF イベントフラグ:45:(LOCAL:3) == 3903
		;全体の場合
		IF INRANGE(ARG:1, 1, 16)
			LOCAL:1 = ARG:1
			LOCAL:2 = ARG:1 + 1
		ELSEIF ARG:1 == 17
			LOCAL:1 = 1
			LOCAL:2 = 4
		ELSEIF ARG:1 == 18
			LOCAL:1 = 4
			LOCAL:2 = 7
		ELSEIF ARG:1 == 19
			LOCAL:1 = 1
			LOCAL:2 = 7
		ELSEIF ARG:1 == 20
			LOCAL:1 = 7
			LOCAL:2 = 12
		ELSEIF ARG:1 == 21
			LOCAL:1 = 12
			LOCAL:2 = 17
		ELSEIF ARG:1 == 22
			LOCAL:1 = 7
			LOCAL:2 = 17
		ELSEIF ARG:1 == 23
			LOCAL:1 = 1
			LOCAL:2 = 17
		ELSE
			PRINTW ※타깃 값이 올바르지 않습니다
			RETURN
		ENDIF
;		イベントフラグ:45:19 = 1

		FOR LOCAL,LOCAL:1,LOCAL:2
			SIF !IS_TARGET_ABLE(POS(LOCAL))
				CONTINUE
			;SIF POS(LOCAL) < 0
			;	CONTINUE
			IF イベントフラグ:45:13 == 2
				SIF イベントフラグ:45:8 > 0
					CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "공격", イベントフラグ:45:8 * 4, "단체", "NOMES"
				SIF イベントフラグ:45:9 > 0
					CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "방어", イベントフラグ:45:9 * 4, "단체", "NOMES"
				SIF イベントフラグ:45:10 > 0
					CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "명중", イベントフラグ:45:10 * 4, "단체", "NOMES"
				SIF イベントフラグ:45:10 > 0
					CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "회피", イベントフラグ:45:10 * 4, "단체", "NOMES"
				SIF イベントフラグ:45:11 > 0
					CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "마법위력", イベントフラグ:45:11 * 4, "단체", "NOMES"
				SIF イベントフラグ:45:12 > 0
					CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "마법효과", イベントフラグ:45:12 * 4, "단체", "NOMES"

				;SIF イベントフラグ:45:8 > 0
				;	CFLAG:POS(LOCAL):공격강화 = MIN(32, CFLAG:POS(LOCAL):공격강화 + (イベントフラグ:45:8 * 4))
				;SIF イベントフラグ:45:9 > 0
				;	CFLAG:POS(LOCAL):방어강화 = MIN(32, CFLAG:POS(LOCAL):방어강화 + (イベントフラグ:45:9 * 4))
				;SIF イベントフラグ:45:10 > 0
				;	CFLAG:POS(LOCAL):명중강화 = MIN(32, CFLAG:POS(LOCAL):명중강화 + (イベントフラグ:45:10 * 4))
				;	CFLAG:POS(LOCAL):회피강화 = MIN(32, CFLAG:POS(LOCAL):회피강화 + (イベントフラグ:45:10 * 4))
				;SIF イベントフラグ:45:11 > 0
				;	CFLAG:POS(LOCAL):마법위력강화 = MIN(32, CFLAG:POS(LOCAL):마법위력강화 + (イベントフラグ:45:11 * 4))
				;SIF イベントフラグ:45:12 > 0
				;	CFLAG:POS(LOCAL):마법효과강화 = MIN(32, CFLAG:POS(LOCAL):마법효과강화 + (イベントフラグ:45:12 * 4))
			ELSE
				SIF イベントフラグ:45:8 < 0
					CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "공격", イベントフラグ:45:8 * 4, "단체", "NOMES"
				SIF イベントフラグ:45:9 < 0
					CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "방어", イベントフラグ:45:9 * 4, "단체", "NOMES"
				SIF イベントフラグ:45:10 < 0
					CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "명중", イベントフラグ:45:10 * 4, "단체", "NOMES"
				SIF イベントフラグ:45:10 < 0
					CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "회피", イベントフラグ:45:10 * 4, "단체", "NOMES"
				SIF イベントフラグ:45:11 < 0
					CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "마법위력", イベントフラグ:45:11 * 4, "단체", "NOMES"
				SIF イベントフラグ:45:12 < 0
					CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "마법효과", イベントフラグ:45:12 * 4, "단체", "NOMES"
				;SIF イベントフラグ:45:8 < 0
				;	CFLAG:POS(LOCAL):공격강화 =  MAX(-16, CFLAG:POS(LOCAL):공격강화 + (イベントフラグ:45:8 * 4))
				;SIF イベントフラグ:45:9 < 0
				;	CFLAG:POS(LOCAL):방어강화 =  MAX(-16, CFLAG:POS(LOCAL):방어강화 + (イベントフラグ:45:9 * 4))
				;SIF イベントフラグ:45:10 < 0
				;	CFLAG:POS(LOCAL):명중강화 =  MAX(-16, CFLAG:POS(LOCAL):명중강화 + (イベントフラグ:45:10 * 4))
				;	CFLAG:POS(LOCAL):회피강화 =  MAX(-16, CFLAG:POS(LOCAL):회피강화 + (イベントフラグ:45:10 * 4))
				;SIF イベントフラグ:45:11 < 0
				;	CFLAG:POS(LOCAL):마법위력강화 =  MAX(-16, CFLAG:POS(LOCAL):마법위력강화 + (イベントフラグ:45:11 * 4))
				;SIF イベントフラグ:45:12 < 0
				;	CFLAG:POS(LOCAL):마법효과강화 =  MAX(-16, CFLAG:POS(LOCAL):마법효과강화 + (イベントフラグ:45:12 * 4))
			ENDIF
		NEXT
		IF イベントフラグ:45:8 != 0 || イベントフラグ:45:9 != 0 || イベントフラグ:45:10 != 0 || イベントフラグ:45:11 != 0 || イベントフラグ:45:12 != 0
			PRINTFORM \@ イベントフラグ:45:13 == 1 ? 적 # 아군 \@ 
			SIF イベントフラグ:45:15 == 2
				PRINTFORM １열
			SIF イベントフラグ:45:15 == 1
				PRINTFORM １체
			PRINTFORM 의 
			IF イベントフラグ:45:8 != 0 && イベントフラグ:45:9 != 0 && イベントフラグ:45:10 != 0 && イベントフラグ:45:11 != 0 && イベントフラグ:45:12 != 0
				PRINT 전능력
			ELSE
				IF イベントフラグ:45:8 != 0
					PRINT 공격력
					IF イベントフラグ:45:9 != 0 || イベントフラグ:45:10 != 0 || イベントフラグ:45:11 != 0 || イベントフラグ:45:12 != 0
						PRINT 과 
					ENDIF
				ENDIF
				IF イベントフラグ:45:9 != 0
					PRINT 방어력
					IF イベントフラグ:45:10 != 0 || イベントフラグ:45:11 != 0 || イベントフラグ:45:12 != 0
						PRINT 과 
					ENDIF
				ENDIF
				IF イベントフラグ:45:10 != 0
					PRINT 명중률・회피율
					IF イベントフラグ:45:11 != 0 || イベントフラグ:45:12 != 0
						PRINT 과
					ENDIF
				ENDIF
				IF イベントフラグ:45:11 != 0
					PRINT 마법위력
					IF  イベントフラグ:45:12 != 0 
						PRINT 과 
					ENDIF
				ENDIF
				SIF イベントフラグ:45:12 != 0
					PRINT 마법효과
			ENDIF
			PRINTFORMW 이(가) \@ イベントフラグ:45:13 == 2 ? 올랐다 # 내렸다 \@！
		ENDIF
	ELSEIF イベントフラグ:45:(LOCAL:3) != 0
		IF イベントフラグ:45:13 == 1
			CALL GET_SKILL_PROP, "SKILL_TARGET", イベントフラグ:45:(LOCAL:3), MASTER
				IF RESULT == 2
					CALL GET_SKILL_PROP, "SKILL_SPHERE", イベントフラグ:45:(LOCAL:3), MASTER
					IF RESULT == 1
						SIF GET_STATE(CFLAG:(CPOS(ARG)):상태이상) != "DYING"
							CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,CPOS(ARG)
					ELSEIF RESULT == 2
						IF CPOS(ARG) < 4
							CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,17
						ELSE
							CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,18
						ENDIF
					ELSEIF RESULT == 3
						CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,19
					ELSEIF RESULT == 4
						CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,23
					ENDIF
				ELSEIF RESULT == 1
					CALL GET_SKILL_PROP, "SKILL_RANGE", イベントフラグ:45:(LOCAL:3), MASTER
					SIF RESULT < 3 && CPOS(ARG) > 3
						CONTINUE
					CALL GET_SKILL_PROP, "SKILL_SPHERE", イベントフラグ:45:(LOCAL:3), MASTER
					IF RESULT != 1 && RESULT == イベントフラグ:45:15
						CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,ARG:1
					ELSEIF RESULT == 1
						回数 = 0
						FOR 単体範囲, 7, 17
							SIF POS(単体範囲) == -1 || CFLAG:POS(単体範囲):상태이상 == GET_STATE_NUM("DYING")
								CONTINUE
							CALL GET_SKILL_PROP, "SKILL_EFECT", イベントフラグ:45:(LOCAL:3), MASTER
							IF RESULT == 1
								SIF POS(単体範囲) == -1 || CFLAG:POS(単体範囲):상태이상 == GET_STATE_NUM("DYING")
									CONTINUE
								SIF 回数 > 0
									CONTINUE
								CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,単体範囲
								回数 += 1
							ELSE
								SIF POS(単体範囲) == -1
									CONTINUE
								SIF 回数 > 0
									CONTINUE
								CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,単体範囲
								回数 += 1
							ENDIF
						NEXT
					ELSEIF RESULT == 2
						CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,20
					ELSEIF RESULT == 3
						CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,22
					ELSEIF RESULT == 4
						CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,23
					ELSE
						CONTINUE
					ENDIF
				ELSE
					CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,ARG:1
				ENDIF
		ELSEIF イベントフラグ:45:13 == 2
			CALL GET_SKILL_PROP, "SKILL_TARGET", イベントフラグ:45:(LOCAL:3), MASTER
			IF RESULT == 2
				CALL GET_SKILL_PROP, "SKILL_SPHERE", イベントフラグ:45:(LOCAL:3), MASTER
				IF RESULT == イベントフラグ:45:15
					CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,ARG:1
				ELSEIF RESULT == 1
					SIF GET_STATE(CFLAG:(CPOS(ARG)):상태이상) != "DYING"
						CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,CPOS(ARG)
				ELSEIF RESULT == 2
					IF CPOS(ARG) < 4
						CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,17
					ELSE
						CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,18
					ENDIF
				ELSEIF RESULT == 3
					CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,19
				ELSEIF RESULT == 4
					CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,23
				ELSE
					CONTINUE
				ENDIF
			ELSEIF RESULT == 1
				CALL GET_SKILL_PROP, "SKILL_RANGE", イベントフラグ:45:(LOCAL:3), MASTER
				SIF RESULT < 3 && CPOS(ARG) > 3
					CONTINUE
				CALL GET_SKILL_PROP, "SKILL_SPHERE", イベントフラグ:45:(LOCAL:3), MASTER
				IF RESULT == 1
					回数 = 0
					FOR 単体範囲, 7, 17
						SIF POS(単体範囲) == -1 || CFLAG:POS(単体範囲):상태이상 == GET_STATE_NUM("DYING")
							CONTINUE
						CALL GET_SKILL_PROP, "SKILL_EFECT", イベントフラグ:45:(LOCAL:3), MASTER
						IF RESULT == 1
							SIF POS(単体範囲) == -1 || CFLAG:POS(単体範囲):상태이상 == GET_STATE_NUM("DYING")
								CONTINUE
							SIF 回数 > 0
								CONTINUE
							CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,単体範囲
							回数 += 1
						ELSE
							SIF POS(単体範囲) == -1
								CONTINUE
							SIF 回数 > 0
								CONTINUE
							CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,単体範囲
							回数 += 1
						ENDIF
					NEXT
				ELSEIF RESULT == 2
					CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,20
				ELSEIF RESULT == 3
					CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,22
				ELSEIF RESULT == 4
					CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,23
				ELSE
					CONTINUE
				ENDIF
			ELSE
				CALL SKILL_ACTION, イベントフラグ:45:(LOCAL:3),ARG,ARG:1
			ENDIF
		ENDIF
	ENDIF
NEXT

