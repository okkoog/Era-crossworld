;　사거리
@SKILL_RANGE_3901,ARG
RETURN イベントフラグ:45:0

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3901,ARG
RETURN イベントフラグ:45:15

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3901, ARG
RETURN GET_SKILL_EFFECT_NUM("회복")

@SKILL_HEAL_TYPE_3901, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("통상")


;계승타입
@SKILL_SUCCESSION_TYPE_3901
RETURN GET_SUCCESSION_NUM("검격")

