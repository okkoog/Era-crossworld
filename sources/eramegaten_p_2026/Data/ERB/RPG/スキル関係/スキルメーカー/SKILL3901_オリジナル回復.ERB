;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3901,ARG
IF ARG == -1
	RESULTS = 오리지널회복
ELSE
	RESULTS = %CSTR:MASTER:199%
ENDIF

;　명중
@SKILL_HITRATE_3901, ARG
RETURN 100

;　威力
@SKILL_POWER_3901, ARG
RETURN イベントフラグ:45:12

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3901,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3901,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3901, ARG
SIF (イベントフラグ:45:17 == 2 && BASE:ARG:ＨＰ <= イベントフラグ:45:16) || (イベントフラグ:45:17 == 3 && BASE:ARG:ＭＰ <= イベントフラグ:45:16)  
	RETURN 2
RETURN 1
;RETURN イベントフラグ:45:1
;消費なし＝1

;　コストの量
@SKILL_COST_3901,ARG
SIF (イベントフラグ:45:17 == 2 && BASE:ARG:ＨＰ <= イベントフラグ:45:16) || (イベントフラグ:45:17 == 3 && BASE:ARG:ＭＰ <= イベントフラグ:45:16)  
	RETURN 9999
IF イベントフラグ:45:17 == 2
	BASE:ARG:ＨＰ -= イベントフラグ:45:16
ELSE
	BASE:ARG:ＭＰ -= イベントフラグ:45:16
ENDIF
RETURN 0
;RETURN イベントフラグ:45:16


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3901
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3901, ARG
RETURN イベントフラグ:45:13


