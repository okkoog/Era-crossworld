;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_3902,ARG
IF ARG == -1
	RESULTS = 오리지널상태이상
ELSE
	RESULTS = %CSTR:MASTER:199%
ENDIF
;　명중
@SKILL_HITRATE_3902, ARG
RETURN 100

;　威力
@SKILL_POWER_3902, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3902,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3902,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3902, ARG
SIF (イベントフラグ:45:17 == 2 && BASE:ARG:ＨＰ <= イベントフラグ:45:16) || (イベントフラグ:45:17 == 3 && BASE:ARG:ＭＰ <= イベントフラグ:45:16)  
	RETURN 2
RETURN 1
;RETURN イベントフラグ:45:1
;消費なし＝1

;　コストの量
@SKILL_COST_3902,ARG
SIF (イベントフラグ:45:17 == 2 && BASE:ARG:ＨＰ <= イベントフラグ:45:16) || (イベントフラグ:45:17 == 3 && BASE:ARG:ＭＰ <= イベントフラグ:45:16)  
	RETURN 9999
IF イベントフラグ:45:17 == 2
	BASE:ARG:ＨＰ -= イベントフラグ:45:16
ELSE
	BASE:ARG:ＭＰ -= イベントフラグ:45:16
ENDIF
RETURN 0
;RETURN イベントフラグ:45:16

;　相性
@SKILL_TYPE_3902,ARG
RETURN イベントフラグ:45:12

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3902
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3902, ARG
RETURN 1 + !INRANGE(イベントフラグ:45:12, GET_TYPE_NUM("검격"), GET_TYPE_NUM("전술"))

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3902, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3902,ARG
RETURN イベントフラグ:45:0

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3902,ARG
RETURN イベントフラグ:45:15

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3902, ARG
RETURN GET_SKILL_EFFECT_NUM("상태변화")


;계승타입
@SKILL_SUCCESSION_TYPE_3902
RETURN GET_SUCCESSION_NUM("검격")

;속도보정
@SKILL_SPEED_3902, ARG = -1
RETURN イベントフラグ:45:18


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3902
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_3902, ARG = -1
RETURN 1


