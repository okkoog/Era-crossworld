;추가효과상성
@SKILL_ADDTIONAL_TYPE_3902,ARG
RETURN イベントフラグ:45:12

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_3902,ARG
RETURN イベントフラグ:45:13

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_3902,ARG
RETURN イベントフラグ:45:13 + 50

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3902, ARG, ARG:1, ARG:2
#DIM DYNAMIC 単体範囲
#DIM DYNAMIC 回数
#LOCALSIZE 1

LOCALS = %CSTR:MASTER:198%
SIF LOCALS != ""
	PRINTFORML %CSTR:MASTER:198%
FOR LOCAL, 1, 11
	IF イベントフラグ:45:LOCAL == 3902
		IF イベントフラグ:45:15 == 1
			単体範囲 = POS(ARG:1)
			CALL SINGLE_BADSTATE,ARG,単体範囲,3902
		ELSE
			CALL FIELD_BADSTATE,ARG,ARG:1,3902
		ENDIF
	ELSEIF イベントフラグ:45:LOCAL > 0 && イベントフラグ:45:LOCAL != 3902
		CALL GET_SKILL_PROP, "SKILL_TARGET", イベントフラグ:45:LOCAL, MASTER
		IF RESULT == 2
			CALL GET_SKILL_PROP, "SKILL_SPHERE", イベントフラグ:45:LOCAL, MASTER
			IF RESULT == 1
				SIF GET_STATE(CFLAG:(CPOS(ARG)):상태이상) != "DYING"
					CALL SKILL_ACTION, イベントフラグ:45:LOCAL,ARG,CPOS(ARG)
			ELSEIF RESULT == 2
				IF CPOS(ARG) < 4
					CALL SKILL_ACTION, イベントフラグ:45:LOCAL,ARG,17
				ELSE
					CALL SKILL_ACTION, イベントフラグ:45:LOCAL,ARG,18
				ENDIF
			ELSEIF RESULT == 3
				CALL SKILL_ACTION, イベントフラグ:45:LOCAL,ARG,19
			ELSEIF RESULT == 4
				CALL SKILL_ACTION, イベントフラグ:45:LOCAL,ARG,23
			ENDIF
		ELSEIF RESULT == 1
			CALL GET_SKILL_PROP, "SKILL_RANGE", イベントフラグ:45:LOCAL, MASTER
			SIF RESULT < 3 && CPOS(ARG) > 3
				CONTINUE
			CALL GET_SKILL_PROP, "SKILL_SPHERE", イベントフラグ:45:LOCAL, MASTER
			IF RESULT != 1 && RESULT == イベントフラグ:45:15
				CALL SKILL_ACTION, イベントフラグ:45:LOCAL,ARG,ARG:1
			ELSEIF RESULT == 1
				回数 = 0
				FOR 単体範囲, 7, 17
					SIF POS(単体範囲) == -1 || CFLAG:POS(単体範囲):상태이상 == GET_STATE_NUM("DYING")
						CONTINUE
					CALL GET_SKILL_PROP, "SKILL_EFECT", イベントフラグ:45:LOCAL, MASTER
					IF RESULT == 1
						SIF POS(単体範囲) == -1 || CFLAG:POS(単体範囲):상태이상 == GET_STATE_NUM("DYING")
							CONTINUE
						SIF 回数 > 0
							CONTINUE
						CALL SKILL_ACTION, イベントフラグ:45:LOCAL,ARG,単体範囲
						回数 += 1
					ELSE
						SIF POS(単体範囲) == -1
							CONTINUE
						SIF 回数 > 0
							CONTINUE
						CALL SKILL_ACTION, イベントフラグ:45:LOCAL,ARG,単体範囲
						回数 += 1
					ENDIF
				NEXT
			ELSEIF RESULT == 2
				CALL SKILL_ACTION, イベントフラグ:45:LOCAL,ARG,20
			ELSEIF RESULT == 3
				CALL SKILL_ACTION, イベントフラグ:45:LOCAL,ARG,22
			ELSEIF RESULT == 4
				CALL SKILL_ACTION, イベントフラグ:45:LOCAL,ARG,23
			ELSE
				CONTINUE
			ENDIF
		ELSE
			CALL SKILL_ACTION, イベントフラグ:45:LOCAL,ARG,ARG:1
		ENDIF
	ENDIF
NEXT


