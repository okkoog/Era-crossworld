;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2986,ARG
RESULTS = 황홀로초대하는황금극장

;　명중
@SKILL_HITRATE_2986, ARG
RETURN 120

;　威力
@SKILL_POWER_2986, ARG
;最終戦フラグON
SIF イベントフラグ:98:1 > 10
	RETURN 350
RETURN 200

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2986,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2986,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2986, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2986,ARG
RETURN 40

;　相性
@SKILL_TYPE_2986,ARG
SIF FLAG:공격횟수 == 1
	RETURN GET_TYPE_NUM("핵열")
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2986
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
@継承不能_2986
RETURN 1

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2986, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2986, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2986,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2986,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2986, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2986
RETURN GET_SUCCESSION_NUM("검격")
;不可

;속도보정
@SKILL_SPEED_2986, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2986
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2986, ARG = -1
RETURN 15




