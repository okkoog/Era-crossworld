;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2974, ARG, ARG:1, ARG:2
#DIM ATK_TARGET
#DIM TARGET_GUTS

;メッセージ表示
;HP条件をチェックし、強化状態であったら「BLOOD HEAT!!」を表示する
CALL MELTY_BLOOD_IS_BLOOD_HEAT_HP_CONDITIONS(ARG)

;攻撃対象を変数に保存
ATK_TARGET = POS(ARG:1)

;転生批判準備
TARGET_GUTS = CFLAG:ATK_TARGET:이악물기플래그

;既に対象が食いしばってる場合、威力向上
SIF TARGET_GUTS == 1
	FLAG:확산플래그 = 1

CALL ATTACK_SINGLE, ARG, ATK_TARGET, 2974

;おまじない：生存チェック
IF ATK_TARGET < 0 || CFLAG:ATK_TARGET:상태이상 == GET_STATE_NUM("DYING")
	;敵が死んでたらなにもしない
;この攻撃で敵が食いしばった場合：あたり・もう一回、転生批判直撃タイム
;（食いしばりが発動した時点でヒットしてダメージ与えてはいるはずなのでヒット確認はしないよ）
;（不死身フラグはゲーム的な都合のことが多いので条件から外すよ）
ELSEIF TARGET_GUTS == 0 && TARGET_GUTS != CFLAG:ATK_TARGET:이악물기플래그
	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃%"제7성전은 불사자를 용서하지 않는다!",72,LEFT%┃
	PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;アナザーアークの「カルヴァリア・デスピア」（？）、正確には何て言ってるのか分からないので、ここでの名前には使用しない
	;（たぶんそう叫びながらドガガガガガしてる）
	PRINTFORML ┏>CHARA━━━━━━━━━━┓　┏>ACT━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃[{CPOS(ARG),2}] %CALLNAME:ARG,21,LEFT%┃　┃第七聖典・聖女埋葬　　　　　　　　　　　┃
	PRINTFORML ┗━━━━━━━━━━━━━┛　┗━━━━━━━━━━━━━━━━━━━━┛

	;威力特大向上、必中、確定クリティカル（ついでに万能も複合な）
	FLAG:확산플래그 = 2
	;スキル側の制御に変更
	;CFLAG:ARG:회심의패기플래그 = 1
	;CFLAG:ARG:회심확정플래그 = 1
	CALL ATTACK_SINGLE, ARG, ATK_TARGET, 2974
ENDIF



