;221013		NEO		説明文などを変更、名称変化と演出を追加
;					ブラッドヒートでの効果を「万能相性を複合、CT率上昇」に変更
;					「転生批判」のフレーバーから、「一回倒れたけど起き上がった」敵に大ダメージを与えるように変更
;					特に「この攻撃で倒れたけど起き上がった」場合……「転生批判直撃タイム」の場合、万能複合・必中・確定CT・威力３倍の超追撃が発動する
;					名称は下記の通り
;					　通常				：第七聖典・
;					　ブラッドヒート中	：第七聖典・断罪死
;					　対食いしばり		：第七聖典・原罪弾劾
;					　対食いしばりかつBH：第七聖典・原罪救済
;					　転生批判直撃タイム：第七聖典・聖女埋葬

;スキル名
@SKILL_NAME_2974,ARG
#DIM ATK_TARGET
;ARGがいない、戦闘中でない、行動時に表示するタイミングでない、なら通常のスキル名を返す
;あくまで「使用する瞬間に」この名前になる
IF ARG == -1 || TFLAG:전투중 == 0 || FLAG:행동순1 != ARG
	RESULTS = 제7성전
ELSE
	ATK_TARGET = POS(CFLAG:ARG:타겟)
	IF 0
		;敵が食いしばっている、ブラッドヒート状態である、によって名称変更
		;転生批判直撃タイムでは直接それっぽく表示するのでこっちには書かない
	;タゲいなかったら通常
	ELSEIF ATK_TARGET == -1
		RESULTS = 제7성전
	;ダブルならさらに名称変更（スキル欄ではこっちにはならんはず）
	ELSEIF 現HP割合(ARG) < 33 && CFLAG:ATK_TARGET:이악물기플래그 == 1
		RESULTS = 第七聖典・原罪救済
	;ブラッドヒート状態
	ELSEIF 現HP割合(ARG) < 33
		RESULTS = 第七聖典・断罪死
	;対食いしばり状態の敵
	ELSEIF CFLAG:ATK_TARGET:이악물기플래그 == 1
		RESULTS = 第七聖典・原罪弾劾
	ELSE
		RESULTS = 제7성전
	ENDIF
ENDIF

;　명중
@SKILL_HITRATE_2974, ARG
SIF FLAG:확산플래그 == 2
RETURN 999
RETURN 100

;　威力
@SKILL_POWER_2974, ARG
#DIM SKILL2974_POW

;基本威力500の超特大
;専用の単体スキル、剣撃破魔複合のMP消費50……なので、基礎威力このくらいでいいかなー……。
SKILL2974_POW = 500

SIF ARG == -1
	RETURN SKILL2974_POW

;転生批判直撃タイムだと*とても*威力向上（なんと3倍）
IF FLAG:확산플래그 == 2
	SKILL2974_POW *= 300
	SKILL2974_POW /= 100
;敵が既に食いしばっているなら威力向上(1.2倍）
ELSEIF FLAG:확산플래그 == 1
	SKILL2974_POW *= 120
	SKILL2974_POW /= 100
ENDIF

RETURN SKILL2974_POW


