SIF FLAG:확산플래그 == 2
	RETURN 999
;ブラッドヒート状態ならCT率上昇
IF 現HP割合(ARG) < 33
	RETURN 20
ELSE
	;明示的にデフォ値の５を返しておく
	RETURN 5
ENDIF

