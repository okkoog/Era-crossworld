;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2971, ARG, ARG:1, ARG:2
#DIMS ATK_TARGET_POS
#DIM LCOUNT
#DIM ATK_TARGET
#DIM ATK_TARGET_HP


	;メッセージ表示
	;HP条件をチェックし、強化状態であったら「BLOOD HEAT!!」を表示する
	CALL MELTY_BLOOD_IS_BLOOD_HEAT_HP_CONDITIONS(ARG)

	;敵味方全体対象
	FOR LCOUNT, 1, 17
		;ポジションを取得
		ATK_TARGET_POS = 포지션{LCOUNT}
		;対象とするポジションが死んでたりしたら戻る
		SIF FLAG:ATK_TARGET_POS < 0
			CONTINUE
		SIF GET_STATE(CFLAG:(FLAG:ATK_TARGET_POS):상태이상) == "DYING"
			CONTINUE
		ATK_TARGET = FLAG:ATK_TARGET_POS 
		CFLAG:ARG:타겟 = LCOUNT
		;攻撃前HPを保存
		ATK_TARGET_HP = BASE:(ATK_TARGET):ＨＰ

		;ブラッドヒートチェック
		;HPが33％未満かつ、敵への攻撃である場合、万能相性で行う
		;まず初期化
		FLAG:확산플래그 = 0
		IF 現HP割合(ARG) < 33
			;PTフラグが立ってなくて（敵で）、ポジション1-6（あなたチーム）への攻撃である場合
			IF CFLAG:ARG:PT플래그 < 1 && LCOUNT < 7
				FLAG:확산플래그 = 1
			;PTフラグが立ってて（味方で）、ポジション7-16（敵）への攻撃である場合
			ELSEIF CFLAG:ARG:PT플래그 > 0 && LCOUNT > 6
				FLAG:확산플래그 = 1
			ENDIF
		ENDIF
		
		;単体攻撃を行う
		CALL ATTACK_SINGLE, ARG, ATK_TARGET, 2971

		;対象とするポジションが死んでたりしたら戻る
		SIF FLAG:ATK_TARGET_POS < 0
			CONTINUE
		SIF GET_STATE(CFLAG:(FLAG:ATK_TARGET_POS):상태이상) == "DYING"
			CONTINUE
		;減ったHPを取得、それを半分にしてMPダメージにする
		ATK_TARGET_HP = MAX(0, ATK_TARGET_HP - BASE:(ATK_TARGET):ＨＰ)
		ATK_TARGET_HP /= 2
		BASE:(ATK_TARGET):ＭＰ -= ATK_TARGET_HP
		SIF BASE:(ATK_TARGET):ＭＰ < 0
			BASE:(ATK_TARGET):ＭＰ = 0
	NEXT
	CFLAG:ARG:타겟 = CFLAG:ARG:포지션 < 7 ? 22 # 19




