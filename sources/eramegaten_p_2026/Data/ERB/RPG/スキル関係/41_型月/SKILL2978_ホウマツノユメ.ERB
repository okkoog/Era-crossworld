;221013		NEO		説明文などを変更、名称変化と演出を追加、継承不能を追加
;					BLOODHEAT状態の場合、敵への状態異常付与を万能相性にし、付与率上昇効果を追加
;					まあ正直、消費50のわりには微妙……ということでMP消費を30に減少
;					単体攻撃スキルなら正直まだ高い

;スキル名
@SKILL_NAME_2978,ARG
	;デフォがアナザーアークの技名なので、ちょっと動きに困る→変更な
	;白レンも同じ技を専用技として習得するため、BH状態では名称変更

	;ARGがいない、戦闘中でない、行動時に表示するタイミングでない、なら通常のスキル名を返す
	;あくまで「使用する瞬間に」この名前になる
	IF ARG == -1 || TFLAG:전투중 == 0 || FLAG:행동순1 != ARG
		RESULTS = 포말의꿈
	ELSEIF 現HP割合(ARG) < 33 && SKILL_CHANGE(ARG, [[キャラ:하얀렌]])
		RESULTS = 호접지몽
	ELSEIF 現HP割合(ARG) < 33 && SKILL_CHANGE(ARG, [[キャラ:렌]])
		RESULTS = 포말의 꿈
	ELSE
		RESULTS = 포말의꿈
	ENDIF


;　명중
@SKILL_HITRATE_2978, ARG
RETURN 100

;　威力
@SKILL_POWER_2978, ARG
	IF ARG == -1
		RETURN 300
	ENDIF

	IF 現HP割合(ARG) < 33
		RETURN 400
	ELSE
		RETURN 300
	ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2978,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2978,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2978, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2978,ARG
RETURN 30

;　相性
@SKILL_TYPE_2978,ARG
RETURN GET_TYPE_NUM("전술")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2978
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2978, ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2978, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2978,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2978,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2978, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2978
RETURN GET_SUCCESSION_NUM("전술")
;不可

@継承不能_2978
RETURN 1

;속도보정
@SKILL_SPEED_2978, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2978
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2978, ARG = -1
RETURN 15


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2978,ARG
	RETURN GET_STATE_NUM("CHARM")
	;夢魔なのでSLEEPにしようかどうしようかというあたり、でもCHARMのほうが強いか～？

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2978,ARG
	IF ARG >= 0 && 現HP割合(ARG) < 33
		RETURN GET_TYPE_NUM("만능")
	ELSE
		RETURN GET_TYPE_NUM("정신")
	ENDIF

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2978,ARG
	;ブラッドヒート状態だと一気に倍！
	IF ARG >= 0 && 現HP割合(ARG) < 33
		RETURN 90
	ELSE
		RETURN 45
	ENDIF

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2978,ARG
	;ブラッドヒート状態なら100％付与がありえる
	IF ARG >= 0 && 現HP割合(ARG) < 33
		RETURN 100
	ELSE
		RETURN 90
	ENDIF


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2978, ARG, ARG:1, ARG:2

	;メッセージ表示
	;HP条件をチェックし、強化状態であったら「BLOOD HEAT!!」を表示する
	CALL MELTY_BLOOD_IS_BLOOD_HEAT_HP_CONDITIONS(ARG)

	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,2978


;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2978, ARG
PRINTL 적 단체에 전기 상성으로 대위력의 마법 공격을 행한다.
PRINTL 추가 효과: 정신 상성으로 CHARM 부여
PRINTL 사용자의 HP가 얼마 남지 않았을 경우 위력이 상승하고, 만능 상성으로 CHARM을 부여하며 상태이상 부여율이 대폭 상승한다.
PRINTL 　
PRINTL 빛의 구체를 쏘아 상대를 현혹·구속하고 그 안에서 데미지를 준다.
;白レンの場合はチョイ説明文変更
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:렌]]
	PRINTL 몽마 하얀 렌의 필살기
;そうでなければレンのスキル説明を表示
ELSE
	PRINTL 몽마 렌의 필살기
ENDIF




;使用条件
@SKILL_SPECIAL_ACTIONABLE_2978,ARG
RETURN 1

