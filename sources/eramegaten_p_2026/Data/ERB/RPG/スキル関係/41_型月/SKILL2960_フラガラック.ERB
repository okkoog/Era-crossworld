;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2960,ARG
RESULTS = 베어내는전신의검

;　명중
@SKILL_HITRATE_2960, ARG
RETURN 100

;　威力
@SKILL_POWER_2960, ARG
RETURN 500

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2960,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2960,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2960, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2960,ARG
RETURN 40

;　相性
@SKILL_TYPE_2960,ARG
RETURN GET_TYPE_NUM("만능")
;만능

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2960
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2960,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2960, ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　사거리
@SKILL_RANGE_2960,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2960,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2960, ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")


;계승타입
@SKILL_SUCCESSION_TYPE_2960
RETURN GET_SUCCESSION_NUM("자동효과")

;속도보정
@SKILL_SPEED_2960, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2960
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2960, ARG = -1
RETURN 0

;　クリティカル率
@SKILL_CRITICAL_RATE_2960,ARG
RETURN 30

;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
;====================================================
@SKILL_COUNTER_ACTIONABLE_2960,ARG,ARG:1
SIF SKILLGAGE_D_GET(ARG,2960) < 1
	RETURN 0
SIF !GET_CREC_ACT(ARG:1, ARG, "物理")
	RETURN 0
;SIF !GETBIT(CFLAG:ARG:受けフラグ,18)
;	RETURN 0
;SIF ARG:1 < 0 || GET_STATE(CFLAG:(ARG:1):상태이상) == "DYING"
;	RETURN 0
CALL SKILLGAGE_H_SET,ARG,2960,1
RETURN 1, CPOS(ARG:1)

;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_2960, ARG, ARG:1, ARG:2
#LOCALSIZE 4
IF SKILLGAGE_D_GET(ARG,2960) == 0
	CALL SKILLGAGE_D_SET,ARG,2960,3
	PRINTFORML 3턴 동안、반격: 「베어내는전신의검」이 발동하게 되었다!
ELSEIF SKILLGAGE_H_GET(ARG,2960) == 1
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),2960,1
ENDIF
WAIT

CALL SKILLGAGE_H_SET,ARG,2960,0

LOCAL = SKILLGAGE_F_GET(ARG,2960) + 1
CALL SKILLGAGE_F_SET,ARG,2960,LOCAL



;====================================================
;実行内容ここまで
;====================================================
;====================================================
;追加コマンド(一番下)
;====================================================
@INPUT_COM_NAME_2960,ARG
RESULTS = フラガラック
RESULTS:1 = 베어내는전신의검
RETURN 0

@INPUT_COM_ABLE_フラガラック,ARG
RESULTS = 効果発動中
SIF SKILLGAGE_D_GET(ARG,2960)
	RETURN -1
CALL CHECK_COST,ARG,2960
SIF !RESULT
	RETURN -1
RETURN 1

;====================================================
;コマンド実行
;====================================================
@INPUT_COM_12960,ARG
#LOCALSIZE 1
CALL GET_SKILL_COST,2960,ARG
PRINTFORML 베어내는 전신의 검을 사용하겠습니까? (소비MP　{RESULT})
CALL INPUT_YN
IF RESULT == 0
	LOCAL = CFLAG:ARG:입력행동
	CFLAG:ARG:입력행동 = 2960
	CALL PAY_COST, ARG, 2960
	CALL PRINT_ACT_MESSAGE, ARG, 2960
	CALL ACTION_2960,ARG
	CALL BATTLE_EVENT_ACT, ARG
	CFLAG:ARG:입력행동 = LOCAL
ENDIF
RETURN -1

;　 説明文の表示
@SKILL_EXPLAIN_2960, ARG
PRINTL 커맨드로 사용할 수 있으며, 발동하면 3턴간 만능 상성으로 반격이 발동한다
PRINTL 반격: 상대의 물리 공격에 대해 「베어내는전신의검」으로 반격을 행한다


;とくにない

@SKILL_ACTIONABLE_BATTLE_2960, ARG
RETURN 0

;使用条件
@SKILL_SPECIAL_ACTIONABLE_2960,ARG
SIF SKILLGAGE_F_GET(ARG,2960) > 5
	RETURN 0
RETURN 0
;とくにない
;====================================================
;[실행 브릿지] フラガラック
;====================================================
@INPUT_COM_フラガラック, ARG
CALL INPUT_COM_12960, ARG
RETURN RESULT
