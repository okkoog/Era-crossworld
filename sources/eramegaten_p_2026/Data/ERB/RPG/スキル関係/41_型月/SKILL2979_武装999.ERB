	RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2979,ARG
	IF ARG == -1
		RETURN 1
	ENDIF
	;ブラッドヒート状態だと攻撃回数＋１
	IF 現HP割合(ARG) < 33
		RETURN 2
	ELSE
		RETURN 1
	ENDIF

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2979,ARG
	IF ARG == -1
		RETURN 3
	ENDIF
	;ブラッドヒート状態だと攻撃回数＋１
	IF 現HP割合(ARG) < 33
		RETURN 4
	ELSE
		RETURN 3
	ENDIF

