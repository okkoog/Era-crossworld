;スキル名
@SKILL_NAME_2961, ARG
RESULTS = 산맥을뒤흔드는샛별의장작

;　명중
@SKILL_HITRATE_2961, ARG
RETURN 100

;　威力
@SKILL_POWER_2961, ARG
RETURN 500

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2961,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2961,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2961, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2961,ARG
RETURN 60

;　相性 衝撃、電撃、破魔、飛具複合
@SKILL_TYPE_2961,ARG
RETURN GET_TYPE_NUM("충격"), GET_TYPE_NUM("전격"), GET_TYPE_NUM("파마"), GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2961
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2961, ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2961, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2961,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2961,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2961, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_2961
RETURN GET_SUCCESSION_NUM("자동효과")

@継承不能_2961
