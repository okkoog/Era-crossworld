;スキル名
@SKILL_NAME_2973,ARG
	;ARGがいない、戦闘中でない、行動時に表示するタイミングでない、なら通常のスキル名を返す
	;あくまで「使用する瞬間に」この名前になる
	IF ARG == -1 || TFLAG:전투중 == 0 || FLAG:행동순1 != ARG
		RESULTS = 공상구현화
	;ブラッドヒート状態ならタイプルミナのラストアーク名称に変更
	ELSEIF 現HP割合(ARG) < 33
		RESULTS = 空想具現化・事象収納
	ELSE
		RESULTS = 공상구현화
	ENDIF

