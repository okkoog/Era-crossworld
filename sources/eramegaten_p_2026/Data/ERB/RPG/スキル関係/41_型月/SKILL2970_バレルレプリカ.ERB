;スキル名
@SKILL_NAME_2970,ARG
	;ARGがいない、戦闘中でない、行動時に表示するタイミングでない、なら通常のスキル名を返す
	;あくまで「使用する瞬間に」この名前になる
	IF ARG == -1 || TFLAG:전투중 == 0 || FLAG:행동순1 != ARG
		RESULTS = 배럴레플리카
	;ブラッドヒート状態ならラストアーク名称に変更
	;（まあ、わりと違う攻撃なのだけど……）
	ELSEIF 現HP割合(ARG) < 33
		RESULTS = ﾊﾞﾚﾙﾚﾌﾟﾘｶ・ｵﾍﾞﾘｽｸ
		SIF GETBIT (FLAG:커스텀게임화면,1)
			RESULTS = 배럴 레플리카·오벨리스크
	ELSE
		RESULTS = 배럴레플리카
	ENDIF

;　명중
@SKILL_HITRATE_2970, ARG
RETURN 100

;　威力
@SKILL_POWER_2970, ARG
SIF ARG == -1
	RETURN 400

IF 現HP割合(ARG) < 33
	SIF FLAG:확산플래그
		RETURN 400
	RETURN 600
ELSE
	SIF FLAG:확산플래그
		RETURN 250
	RETURN 400
ENDIF

@SKILL_CRITICAL_RATE_2970, ARG
RETURN 20

