;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2985,ARG
RESULTS = 약속된승리의검

;　명중
@SKILL_HITRATE_2985, ARG
RETURN 100

;　威力
@SKILL_POWER_2985, ARG
RETURN 600

@SKILL_CRITICAL_RATE_2985, ARG
;最終戦フラグON 　威力を上げるよりクリティカルで追撃を発生させてほしい
SIF イベントフラグ:98:1 > 10
	RETURN 30
RETURN 20

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2985,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2985,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2985, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_2985,ARG
RETURN 60

;　相性
@SKILL_TYPE_2985,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2985
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2985, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2985, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2985,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2985,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2985, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2985
RETURN GET_SUCCESSION_NUM("만능")
;不可
@継承不能_2985
RETURN 1

;속도보정
@SKILL_SPEED_2985, ARG = -1
RETURN -2


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2985
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2985, ARG = -1
RETURN 15

