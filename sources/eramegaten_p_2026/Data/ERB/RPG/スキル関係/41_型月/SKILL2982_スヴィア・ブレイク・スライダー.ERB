;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2982, ARG, ARG:1, ARG:2

	;メッセージ表示
	;HP条件をチェックし、強化状態であったら「BLOOD HEAT!!」を表示する
	CALL MELTY_BLOOD_IS_BLOOD_HEAT_HP_CONDITIONS(ARG)

	CALL ATTACK_RAND, ARG, ARG:1, 2982

	;おまじない：ブラッドヒート状態で青子が使用した場合のみ全体攻撃「スライダー」を追加
	IF 現HP割合(ARG) < 33 && SKILL_CHANGE(ARG, [[キャラ:아오코]])

		PRINTFORML ┏>CHARA━━━━━━━━━━┓　┏>ACT━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃[{CPOS(ARG),2}] %CALLNAME:ARG,21,LEFT%┃　┃슬라이더!　　　　　　　　　　　　　　┃
		PRINTFORML ┗━━━━━━━━━━━━━┛　┗━━━━━━━━━━━━━━━━━━━━┛
		;味方の場合
		IF CFLAG:(ARG):PT플래그 >= 1
			CALL ATTACK_FIELD, ARG, (22),2982
		ELSE
			CALL ATTACK_FIELD, ARG, (19),2982
		ENDIF
	ENDIF


