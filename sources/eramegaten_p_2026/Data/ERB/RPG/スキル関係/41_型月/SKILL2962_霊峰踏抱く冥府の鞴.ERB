;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_2962, ARG, ARG:1, ARG:2
#DIM SKILL_NUM
#DIM DYNAMIC LCOUNT
IF FLAG:총공격중
	FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
		SIF !IS_TARGET_ABLE(POS(LCOUNT))
			CONTINUE
		TSTR:스킬메시지추가효과 '= ""
		CALL SKILL_INVALID_WALL, ARG, POS(LCOUNT), "테트라쟈", "短縮"
		CALL SKILL_SET_カジャンダ, ARG, POS(LCOUNT), "방어", 4, "短縮"
		CALL PRINT_HIT_MESSAGE, POS(LCOUNT), TSTR:스킬메시지추가효과, "L"
	NEXT
	WAIT
ELSE
	CALL ATTACK_FIELD,ARG,ARG:1,2962
ENDIF


