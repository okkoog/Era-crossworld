;221013		NEO		説明文などを変更、名称変化と演出を追加、継承不能を追加
;					対象と自分が共に前列にいる場合、「密着状態だと投げに変化する」ように変更

;スキル名
@SKILL_NAME_2972,ARG
#DIM ATTACKER
#DIM ATK_TARGET
	;ARGがいない、戦闘中でない、行動時に表示するタイミングでない、なら通常のスキル名を返す
	;あくまで「使用する瞬間に」この名前になる
	IF ARG == -1 || TFLAG:전투중 == 0 || FLAG:행동순1 != ARG
		RESULTS = 적주：함발
	ELSE
		;投げ間合いチェック
		;ATTACKER   = CPOS(ARG)
		;ATK_TARGET = CFLAG:ARG:타겟
		;投げになる場合「掌握」とつける（メルブラでは名前変化はしないんだよなー）
		;IF (INRANGE(ATTACKER, 1, 3) && INRANGE(ATK_TARGET, 7, 11)) || (INRANGE(ATK_TARGET, 1, 3) && INRANGE(ATTACKER, 7, 11)) 
		IF IS_FRONT(ARG) && IS_FRONT(POS(CFLAG:ARG:타겟))
			TFLAG:스킬용1 = 1
			RESULTS = 赤主：檻髪（掌握）
		ELSE
			RESULTS = 적주：함발
		ENDIF
	ENDIF

;　명중
@SKILL_HITRATE_2972, ARG
	;投げ間合いだと高命中
	IF TFLAG:스킬용1 == 1
		RETURN 200
	ELSE
		RETURN 120
	ENDIF

;　威力
@SKILL_POWER_2972, ARG
#DIM SKILL2972_POW

	;基本からして500の超特大なの兄貴に威力分けてあげて？
	;→「投げ」条件追加につき基礎威力を450に減少
	;　ブラッドヒートだけで750まで向上してたのを、片方だと650or675、条件ふたつで最大975
	;　「投げ間合い（お互い前衛）」条件はかなりユルい条件だと思うが、魔法攻撃なので前衛に出るのはリスクあり
	;　HP条件は言わずもがな

	SKILL2972_POW = 450

	SIF ARG == -1
		RETURN SKILL2972_POW

	;ブラッドヒート状態だと威力向上
	SIF 現HP割合(ARG) < 33
		SKILL2972_POW += 200
	;投げ間合いだと威力向上（1.5倍）
	IF TFLAG:스킬용1
		SKILL2972_POW *= 150
		SKILL2972_POW /= 100
	ENDIF

	RETURN SKILL2972_POW

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2972,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2972,ARG
