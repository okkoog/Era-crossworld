;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2972, ARG, ARG:1, ARG:2
#DIM ATTACKER
#DIM ATK_TARGET

	;メッセージ表示
	;HP条件をチェックし、強化状態であったら「BLOOD HEAT!!」を表示する
	CALL MELTY_BLOOD_IS_BLOOD_HEAT_HP_CONDITIONS(ARG)

	;投げ間合いチェック
	;お互い前列にいる場合（射程１の距離にいる場合）、投げに変化し命中と威力が向上
	;まず初期化
	TFLAG:스킬용1 = 0
	;ATTACKER   = POS(ARG)
	;ATK_TARGET = POS(ARG:1)

	;攻撃者のポジションが1-3、対象のポジションが7-11（またはその逆）である場合……どちらも前列である場合、投げ間合いとする
	;SIF (INRANGE(ATTACKER, 1, 3) && INRANGE(ATK_TARGET, 7, 11)) || (INRANGE(ATK_TARGET, 1, 3) && INRANGE(ATTACKER, 7, 11)) 
	;	TFLAG:스킬용1 = 1

	SIF IS_FRONT(ARG) && IS_FRONT(POS(ARG:1))
		TFLAG:스킬용1 = 1
	;投げ間合いだとメッセージ表示
	IF TFLAG:스킬용1 == 1
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

		PRINTFORM ┃
		SETCOLOR COLOR("深紅")
		PRINTFORM % CALLNAME:ARG + "의 손톱이 먹잇감을 낚아챈다!",72,LEFT%
		RESETCOLOR
		PRINTFORML ┃
		PRINTFORML ┃%" " * 72%┃

		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF


	CALL ATTACK_SINGLE, ARG, ATK_TARGET, 2972






