;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_2977, ARG = -1, ARG:1 = -1
	;ブラッドヒートだと完全貫通
	SIF 現HP割合(ARG) < 33 && SKILL_CHANGE(ARG, [[キャラ:코하쿠]])
		RETURN 4

	RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2977, ARG, ARG:1, ARG:2
#LOCALSIZE 4
#DIM ATK_TARGET_START
#DIM ATK_TARGET_END
#DIM ATK_TARGET
#DIM LCOUNT
#DIM IS_PENETRATE
;LOCAL = POS(ARG:1)
;全体攻撃に修正
;CALL ATTACK_SINGLE,ARG,LOCAL,2977


	;メッセージ表示
	;HP条件をチェックし、強化状態であったら「BLOOD HEAT!!」を表示する
	CALL MELTY_BLOOD_IS_BLOOD_HEAT_HP_CONDITIONS(ARG)

	;おまじない：琥珀が使用した場合のみ貫通
	;ただし貫通処理そのものは「SKILL_PENETRATION_RANK_2977」で行うので、ここでは「貫通が必要か」のチェック
	IF 現HP割合(ARG) < 33 && SKILL_CHANGE(ARG, [[キャラ:코하쿠]])

		;付与処理終了後、誰かに貫通効果を付与してた場合メッセージ表示
		;→BHなら必ず表示とする
		IF RAND:2 == 0
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃코하쿠류 발도술 오의는 빈틈없는 2단 자세!　　　　　　　　　　　　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ELSE
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃내일로 내딛는 한 걸음이 발도술에 힘을 불어넣는다!　　　　　　　　　　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ENDIF
	ENDIF
	;HP33％以上だと↑の貫通処理を行わない
	CALL ATTACK_FIELD,ARG,ARG:1,2977

