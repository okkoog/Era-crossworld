;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2975, ARG, ARG:1, ARG:2
#DIM ATK_TARGET
#DIM 前HP
#DIM 後HP
#DIM ヴァイタルダメージ

	;メッセージ表示
	;HP条件をチェックし、強化状態であったら「BLOOD HEAT!!」を表示する
	CALL MELTY_BLOOD_IS_BLOOD_HEAT_HP_CONDITIONS(ARG)

	;攻撃対象を変数に保存
	ATK_TARGET = POS(ARG:1)

	;ヒット確認のために攻撃前後のHPを保存
	前HP = BASE:ATK_TARGET:ＨＰ
	CALL ATTACK_SINGLE, ARG, ATK_TARGET, 2975
	;一応生きてることを確認しつつ
	;「（タゲがマイナス１未満、または死亡状態である）の否定」＝「タゲが０より上かつ生きてる」、HPはとりあえず持ってるハズ
	SIF !(ATK_TARGET < 0 || CFLAG:ATK_TARGET:상태이상 == GET_STATE_NUM("DYING"))
		後HP = BASE:ATK_TARGET:ＨＰ

	;=============================
	;●HP補正削り
	;=============================
	;ヒットしていたら：ダメージ量の倍量、HP補正を削る
	;（ただし補正はゼロ未満にはならない）（最大HPゼロになったりはしないよ、ということ）
	;ヴァイタルソースを大きく削るフレーバー
	;減ったHP＝与えたダメージの２倍をHP補正から引く
	;HP10000＋HP補正5000のところに1000ダメージを与えたとすると、
	;　15000-1000＝14000、さらに補正をダメージ分の2倍ひいて「最大HPが13000になって」、HPが残り13000に補正される
	;=============================

	;〇ヒット確認
	IF 0
	;対象が存在してなかったり死んでたりした場合
	ELSEIF ATK_TARGET < 0 || CFLAG:ATK_TARGET:상태이상 == GET_STATE_NUM("DYING")
		;なにもしない
	;HPが減ってなかったり、むしろ吸収されたりした場合
	ELSEIF 後HP >= 前HP
		;なにもしない
		;吸収・反射・無効化された場合はここで弾ける
	;すでに何らかの理由でHP補正が0以下
	ELSEIF CFLAG:ATK_TARGET:ＨＰ보정 <= 0
		;なにもしない
	;ヒットした場合
	ELSE
		;〇与える最大HP削減ダメージを計算
		;　与ダメージの倍*乱数0.9～1.1
		;　ブラッドヒート……HP33％以下だとさらに削る（ダメージの３倍になる）
		IF 現HP割合(ARG) < 33
			ヴァイタルダメージ = (前HP - 後HP) * 3 * (RAND:200 + 900) / 1000
		ELSE
			ヴァイタルダメージ = (前HP - 後HP) * 2 * (RAND:200 + 900) / 1000
		ENDIF

		;ヴァイタルダメージがHP補正以上なら、HP補正と同値に補正（HP補正以上に削れないようにする）
		;残り補正が100、ヴァイタルダメージが200ならヴァイタルダメージを100にする
		SIF ヴァイタルダメージ > CFLAG:ATK_TARGET:ＨＰ보정
			ヴァイタルダメージ = CFLAG:ATK_TARGET:ＨＰ보정

		;〇ヴァイタルダメージが１以上
		;おまじないが過剰な気はする
		IF ヴァイタルダメージ > 0
			;HP補正をマイナス
			CFLAG:ATK_TARGET:ＨＰ보정 -= ヴァイタルダメージ
			;ステータスの再計算
			CALL SYNC_STATUS, ATK_TARGET

			;現在HPが最大HP以上だったら（750/500、とかになってたら）現在HPを最大HPと同じ値に切り捨てる
			SIF BASE:ATK_TARGET:ＨＰ > MAXBASE:ATK_TARGET:ＨＰ
				BASE:ATK_TARGET:ＨＰ = MAXBASE:ATK_TARGET:ＨＰ

			;〇HP補正が変動した場合のみ追加メッセージ
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
			IF 0
			ELSEIF RAND:3 == 0
				PRINTFORML ┃%"생명의 선이 절단되어 간다!",72,LEFT%┃
			ELSEIF RAND:2 == 0
				PRINTFORML ┃%"증대한 생명이 해체된다!",72,LEFT%┃
			ELSE
				PRINTFORML ┃%"그 생명은 확실한 죽음으로 향한다!",72,LEFT%┃
			ENDIF
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

			PRINTFORMW 　　TARGET:[{ATK_TARGET,2}] %CALLNAME:ATK_TARGET,20,LEFT%　>>>>>>　최대 HP {ヴァイタルダメージ} 감소
		ENDIF
	ENDIF




