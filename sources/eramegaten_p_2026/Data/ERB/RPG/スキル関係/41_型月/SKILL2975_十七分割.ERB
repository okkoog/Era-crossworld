;====================================================
;●メルブラ系共通関数
;====================================================
;「HEAT」「BLOOD HEAT！！」の表示
;基本はHP33%未満の時に強化、って条件なので、一発でチェックできる「MELTY_BLOOD_IS_BLOOD_HEAT_HP_CONDITIONS」を呼ぶ
;独自条件で判定してBLOOD HEAT!! 呼びたいなら「MELTY_BLOOD_DISPLAY_BLOOD_HEAT」のほうを使う
;再現するならゲージスキルのほうがよさそうなんだけどもねー
;====================================================

@MELTY_BLOOD_IS_BLOOD_HEAT_HP_CONDITIONS,ARG
	IF 現HP割合(ARG) < 33
		CALL MELTY_BLOOD_DISPLAY_BLOOD_HEAT(ARG)
	ELSE
		;こちらは平常時のものなのでとりあえず呼ばない
;		CALL MELTY_BLOOD_DISPLAY_HEAT(ARG)
	ENDIF

@MELTY_BLOOD_DISPLAY_BLOOD_HEAT,ARG
	;特定条件下の時「BLOODHEAT!!」を表示するための関数
	;型月（というかメルブラ系）共通
	;全員「HPが33%未満」という条件だが、後々変更がありえるため、ここではメッセージの表示だけにしておく
	;この表示関数だけでも呼べるように単独に切り分けておく
	PRINTFORML ┏>CHARA━━━━━━━━━━┓　┏>ACT━━━━━━━━━━━━━━━━━━┓
	PRINTFORM ┃[{CPOS(ARG),2}] %CALLNAME:ARG,21,LEFT%┃　┃
	SETCOLOR COLOR("深紅")
	PRINTFORM BLOOD HEAT！！
	RESETCOLOR
	PRINTFORML 　　　　　　　　　　　　　┃
	PRINTFORML ┗━━━━━━━━━━━━━┛　┗━━━━━━━━━━━━━━━━━━━━┛

