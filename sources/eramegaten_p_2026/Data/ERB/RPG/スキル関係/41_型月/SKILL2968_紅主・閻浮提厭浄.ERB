;スキル名
@SKILL_NAME_2968,ARG
	;ARGがいない、戦闘中でない、行動時に表示するタイミングでない、なら通常のスキル名を返す
	;あくまで「使用する瞬間に」この名前になる
	IF ARG == -1 || TFLAG:전투중 == 0 || FLAG:행동순1 != ARG
		RESULTS = 홍주・염부제염정
	ELSE
		IF 0
		;ブラッドヒート状態ならラストアーク名称に変更
		;（まあ、わりと違う攻撃なのだけど……）
		;ラストアーク側名称のほうが優先な
		ELSEIF 現HP割合(ARG) < 33
			RESULTS = 夜摩判決
		;タイマンチェック：タイマンなら投げ名称に
		;投げになる場合「掌握」とつける（メルブラでは名前変化はしないんだよなー）
		ELSEIF ENEMY_COUNT() == 1
			RESULTS = 홍주・염부제염정(掌握)
		ELSE
			RESULTS = 홍주・염부제염정
		ENDIF
	ENDIF

;　명중
@SKILL_HITRATE_2968, ARG
	IF ARG == -1
		RETURN 80
	;投げだと命中向上
	ELSEIF ENEMY_COUNT() == 1
		RETURN 120
	;投げでない場合ビミョーに命中不安
	ELSE
		RETURN 80
	ENDIF


;　威力
@SKILL_POWER_2968, ARG
#DIM SKILL2968_POW
	;単体対象とはいえダメージ量がデフォ600なのはヤバイわね！
	;「投げ」を追加したので基礎威力を500に減ずる

	SKILL2968_POW = 500

	SIF ARG == -1
		RETURN SKILL2968_POW

	;投げモード
	;敵が単体の場合のみ威力大幅上昇、単体攻撃に変化
	;消費60なので、威力700つっても「2回アギバリオン撃ったほうがコスパはいい」、そもそも物理型なのでMPがキツい
	SIF ENEMY_COUNT() == 1
		SKILL2968_POW += 200

	RETURN SKILL2968_POW



