IF ARG >= 0
	SELECTCASE BASE:ARG:LV
		CASE IS < 40
			RETURN GET_TYPE_NUM("화염"), GET_TYPE_NUM("전격")
		CASE IS < 60
			RETURN GET_TYPE_NUM("화염"), GET_TYPE_NUM("전격"), GET_TYPE_NUM("빙결")
		CASEELSE
			RETURN GET_TYPE_NUM("화염"), GET_TYPE_NUM("전격"), GET_TYPE_NUM("빙결"), GET_TYPE_NUM("질풍")
	ENDSELECT
ELSE
	RETURN GET_TYPE_NUM("화염")
ENDIF
