;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2959, ARG, ARG:1, ARG:2
IF CFLAG:ARG:PT플래그 > 0
	IF BASE:ARG:LV < 60
		MONEY -=  BASE:ARG:LV * 200
	ELSE
		MONEY -=  12000
	ENDIF
	SIF MONEY < 0
		MONEY = 0
ENDIF
PRINTFORMW %CALLNAME:ARG%은(는) 보석을 깨뜨려 마력을 개방했다!
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,2959






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2959, ARG
PRINTL 보석을 깨뜨려 복합 속성의 마력탄으로서 발사한다.




;使用条件
@SKILL_SPECIAL_ACTIONABLE_2959,ARG
IF CFLAG:ARG:PT플래그 > 0
	IF BASE:ARG:LV < 60
		SIF MONEY < BASE:ARG:LV * 200
			RETURN 0
	ELSE
		SIF MONEY < 12000
			RETURN 0
	ENDIF
ENDIF
RETURN 1
;金の有無、

