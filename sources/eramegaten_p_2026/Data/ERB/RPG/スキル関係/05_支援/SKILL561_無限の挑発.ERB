;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_561, ARG, ARG:1, ARG:2
#DIM LCOUNT
#DIM L_T
#DIM SKILL_POWER, 2
IF SKILL_CHANGE(ARG, [[キャラ:카오루코]]) && (EQUIP:ARG:악세서리 == GETNUM(ITEM, "별의티아라") && 大場ななの記憶:3:6 > 0)
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어/마법효과", -16, "範囲", "방어력과 마법효과를 ４단계 내렸다！"
ELSE
	FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
		L_T = POS(LCOUNT)
		SIF !IS_TARGET_ABLE(L_T)
			CONTINUE
		SKILL_POWER = TOINT(RAND_SPLIT("4/3/2/2/2/1/1/1", "/")), TOINT(RAND_SPLIT("4/3/2/2/2/1/1/1", "/"))
		CALL SKILL_SET_カジャンダ, ARG, L_T, "방어/마법효과", SKILL_POWER * -4, "단체", "NOPRINT"
		CALL SKILL_SET_カジャンダ, ARG, L_T, "공격/마법위력", SKILL_POWER:1 * 4, "단체", "NOWAIT", @"방어력과 마법효과가 %TOFULL(TOSTR(SKILL_POWER))%단계 내리고、공격력과 마법위력이 %TOFULL(TOSTR(SKILL_POWER:1))%단계 올랐다！"
	NEXT
	WAIT
ENDIF
