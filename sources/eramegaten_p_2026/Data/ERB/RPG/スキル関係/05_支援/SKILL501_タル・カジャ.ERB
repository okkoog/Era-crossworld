;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_501,ARG
;小梅発動時はナイトメアソングに
IF SKILL_CHANGE(ARG, [[キャラ:코우메]])
	RESULTS = 나이트메어 송
ELSE
	RESULTS = 타루・카쟈
ENDIF

;　명중
@SKILL_HITRATE_501, ARG
RETURN 100

;　威力
@SKILL_POWER_501, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_501,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_501,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_501, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_501,ARG
IF SKILL_CHANGE(ARG, [[キャラ:코우메]])
	RETURN 10
ELSE
	RETURN 12
ENDIF


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_501
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_501, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_501,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_501,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_501, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")


;계승타입
@SKILL_SUCCESSION_TYPE_501
RETURN GET_SUCCESSION_NUM("지원")

;속도보정
@SKILL_SPEED_501, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_501
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_501, ARG = -1
RETURN 5




;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_501, ARG, ARG:1, ARG:2
#DIM L_POWER
IF SKILL_CHANGE(ARG, [[キャラ:코우메]])
	L_POWER = ((SKILLGAGE_H_GET(ARG, 3622) / 5) + 1) * 4
	CALL SKILLGAGE_H_ADD,ARG,3622,-3
ELSE
	L_POWER = 4
ENDIF
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격", L_POWER, "範囲"

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================


;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_501, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:코우메]]
	PRINTL 아군의 공격력을 증가시킨다。증가량은 현재 자신의 사령 카운터의 양에 따라 변화한다。
	PRINTL 자신의 사령 카운터를 3 소비한다。
ELSEIF ARG >0 && ARG < CHARANUM && NO:ARG == ([[キャラ:아오이_마인학원]])
	PRINTL 지천사에게 기도를 올려、아군에게 샘솟는 힘을 부여한다。
	PRINTL 아군 전체의 공격력을 상승시킨다。
ELSE
	PRINTL 아군 전체의 공격력을 상승시킨다。
ENDIF


@SKILL_EXPLAIN_TOOLTIP_501, ARG
IF SKILL_CHANGE(ARG, [[キャラ:코우메]])
	RESULTS = 아군 전체의 공격력을 상승시킨다。
	RESULTS:1 = 자신의 사령 카운터를 3 소비한다。
ELSE
	RESULTS = 아군 전체의 공격력을 상승시킨다。
ENDIF



;使用条件
@SKILL_SPECIAL_ACTIONABLE_501,ARG
IF SKILL_CHANGE(ARG, [[キャラ:코우메]])
	RESULTS = 코스트 부족: 사령 카운터(3)
	;小梅が使用する場合は固有ゲージが3以上ないと発動できない。
	SIF SKILLGAGE_H_GET(ARG,3622) >= 3
		RETURN 1
	RETURN 0
ELSE	
	RETURN 1
	;とくにない
ENDIF
