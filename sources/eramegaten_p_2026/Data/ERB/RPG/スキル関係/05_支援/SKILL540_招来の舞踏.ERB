@SELECT_TARGET_540,ARG
#LOCALSIZE 1
	$CHOOSE_COMPANION_LOOP
	CALL CHOOSE_DEAD_COMPANION, "RPG/전투중", ARG
	IF RESULT == 1000
		RETURN -1
	ELSEIF CFLAG:RESULT:피소환플래그 && CFLAG:ARG:소환예정캐릭터 != RESULT
		PRINTW 다른 캐릭터에게 소환되려고 하고 있습니다。
		GOTO CHOOSE_COMPANION_LOOP
	ELSE
		;PRINTFORML {RESULT}
		LOCAL = RESULT
		;PRINTFORML {RESULT}
		CALL SHOW_NOW_FORMATION_P,0,2, 7
		PRINTL [0] ＣＡＮＣＥＬ
		PRINTL 어디에 불러낼까？
		CALL INPUTINT,0,1,2,3,4,5,6
		IF RESULT == 0
			GOTO CHOOSE_COMPANION_LOOP
		ELSE
			CFLAG:(ARG):소환예정캐릭터 = LOCAL
			CFLAG:(CFLAG:(ARG):소환예정캐릭터):피소환플래그 = 1
			CFLAG:(CFLAG:ARG:소환예정캐릭터):소환자ID = CFLAG:ARG:캐릭터고유번호
			CFLAG:(ARG):타겟 = RESULT
			CFLAG:(ARG):입력행동 = 540
			RETURN RESULT
		ENDIF
	ENDIF



