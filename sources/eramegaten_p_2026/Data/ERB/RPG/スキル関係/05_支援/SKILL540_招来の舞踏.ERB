;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_540, ARG, ARG:1, ARG:2
IF POS(ARG:1) > 0 && CFLAG:POS(ARG:1):소속ＣＯＭＰ == -1 && !(ARG:1 < 4 && POS(ARG:1+3) == -1)
	PRINTFORMW %조사처리(CALLNAME:POS(ARG:1),"는")% 송환할 수 없다！
ELSE
	IF IS_BADSTATE(CFLAG:ARG:소환예정캐릭터, "DYING")
		CFLAG:(CFLAG:ARG:소환예정캐릭터):상태이상 = 0
		CFLAG:(CFLAG:ARG:소환예정캐릭터):상태이상경과턴수 = 0
		CALL VAR_HP,CFLAG:ARG:소환예정캐릭터,MAXBASE:(CFLAG:ARG:소환예정캐릭터):ＨＰ
	ENDIF
	CALL INSERT_POSITION,ARG:1,CFLAG:ARG:소환예정캐릭터
ENDIF
IF CFLAG:(CFLAG:ARG:소환예정캐릭터):PT플래그 == 2
	PRINTFORMW %조사처리(CALLNAME:(CFLAG:ARG:소환예정캐릭터),"를")% 소환했다！
	IF CFLAG:(CFLAG:ARG:소환예정캐릭터):PT플래그 > 0 && ABL:(CFLAG:ARG:소환예정캐릭터):종족 != 0
		CALL CONTROL_MAG, ARG, -MAXBASE:(CFLAG:ARG:소환예정캐릭터):￥
	ENDIF
ELSE
	PRINTW 소환에 실패했다！
ENDIF


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_FIELD_540,ARG,ARG:1,ARG:2
#DIM DYNAMIC L_SWITCHING_CHARA
IF POS(ARG:1) > 0 && CFLAG:POS(ARG:1):소속ＣＯＭＰ == -1 && !(ARG:1 < 4 && POS(ARG:1+3) == -1)
	PRINTFORMW %조사처리(CALLNAME:POS(ARG:1),"는")% 송환할 수 없다！
ELSE
	IF IS_BADSTATE(CFLAG:ARG:소환예정캐릭터, "DYING")
		CFLAG:(CFLAG:ARG:소환예정캐릭터):상태이상 = 0
		CFLAG:(CFLAG:ARG:소환예정캐릭터):상태이상경과턴수 = 0
		CALL VAR_HP,CFLAG:ARG:소환예정캐릭터,MAXBASE:(CFLAG:ARG:소환예정캐릭터):ＨＰ
	ENDIF
	CALL INSERT_POSITION,ARG:1,CFLAG:ARG:소환예정캐릭터
	L_SWITCHING_CHARA = RESULT:1
ENDIF

;CALL INSERT_POSITION,ARG:1,CFLAG:ARG:소환예정캐릭터
IF CFLAG:(CFLAG:ARG:소환예정캐릭터):PT플래그 == 2
	PRINTFORMW %조사처리(CALLNAME:(CFLAG:ARG:소환예정캐릭터),"를")% 소환했다！
	IF CFLAG:(CFLAG:ARG:소환예정캐릭터):PT플래그 > 0 && ABL:(CFLAG:ARG:소환예정캐릭터):종족 != 0
		CALL CONTROL_MAG, ARG, -MAXBASE:(CFLAG:ARG:소환예정캐릭터):￥
	ENDIF
	;交代時効果
	CALL SKILL_ACTION_AT_SWITCHING, L_SWITCHING_CHARA, CFLAG:ARG:소환예정캐릭터
	;入場時の処理
	CALL SET_BATTLE_ENTER_FLAG, CFLAG:ARG:소환예정캐릭터
	CALL SKILL_TIMING, "BATTLE_ENTER"
	CFLAG:ARG:입장플래그 = 0
ELSE
	PRINTW 소환에 실패했다！
ENDIF



