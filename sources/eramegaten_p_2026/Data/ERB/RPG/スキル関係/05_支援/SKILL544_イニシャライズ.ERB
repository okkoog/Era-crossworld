;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_544, ARG, ARG:1, ARG:2
FOR LOCAL,1, 17
	SIF !IS_TARGET_ABLE(POS(LOCAL))
		CONTINUE
	FOR LOCAL:1, GETNUM(CFLAG,"공격강화"), GETNUM(CFLAG,"마법효과강화")+1
		CFLAG:POS(LOCAL):(LOCAL:1) = 0
	NEXT
	CALL PRINT_HIT_MESSAGE, POS(LOCAL), "능력 상승과 저하가 해제되었다！"
NEXT
