;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_531, ARG, ARG:1, ARG:2
CALL ACTION_SKILL_ANALYZE, POS(ARG:1)

;共通判定化。確実に成功し、相性が見れる状態まで持っていく
@ACTION_SKILL_ANALYZE, L_ENEMY, L_SUCCESS = "Analyzed Complete!", L_FAILED = "Error! Already Analyzed Completed!", L_FAILED:1 = "Error! Unknown Object!"
#DIM DYNAMIC L_ENEMY
#DIMS DYNAMIC L_SUCCESS
#DIMS DYNAMIC L_FAILED, 2
IF FLAG:악마해석률상승불가플래그 || SOFT_ON("마인드시커")
	PRINTFORMW %L_FAILED:1%
ELSE
	;アンノウンフラグをはがす
	IF CFLAG:L_ENEMY:언노운플래그 == 1
		CFLAG:L_ENEMY:언노운플래그 = 0
		IF NAME:L_ENEMY == "？？？？"
			NAME:L_ENEMY = %CSVNAME(NO:L_ENEMY,0)%
			CALLNAME:L_ENEMY = %CSVCALLNAME(NO:L_ENEMY,0)%
		ENDIF
		PRINTFORM ＝＞　%CALLNAME:(LOCAL)% 
		PRINTFORMW %L_SUCCESS%
	ELSE
		IF (ANALYSIS_RATE:(NO:L_ENEMY) >= ANALYSIS_COMPLETED)
			PRINTFORMW %L_FAILED:0%
		ELSE
			PRINTFORMW %L_SUCCESS%
		ENDIF
	ENDIF
	ANALYSIS_RATE:(NO:L_ENEMY) = ANALYSIS_COMPLETED
ENDIF

