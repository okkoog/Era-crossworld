;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_581, ARG, ARG:1, ARG:2
#DIM LCOUNT
#DIM L_T
#DIM SKILL_POWER, 2
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	SKILL_POWER = TOINT(RAND_SPLIT("4/3/2/2/2/1/1/1", "/")), TOINT(RAND_SPLIT("4/3/2/2/2/1/1/1", "/"))
	CALL SKILL_SET_カジャンダ, ARG, L_T, "공격/마법위력", SKILL_POWER * -4, "단체", "NOPRINT"
	CALL SKILL_SET_カジャンダ, ARG, L_T, "방어/마법효과", SKILL_POWER:1 * 4, "단체", "NOWAIT", @"공격력과 마법위력이 %TOFULL(TOSTR(SKILL_POWER))%단계 내리고、방어력과 마법효과가 %TOFULL(TOSTR(SKILL_POWER:1))%단계 올랐다！"
NEXT
WAIT

