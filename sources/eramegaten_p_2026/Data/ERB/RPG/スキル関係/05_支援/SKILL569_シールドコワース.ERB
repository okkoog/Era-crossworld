;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_569, ARG, ARG:1, ARG:2
#LOCALSIZE 4
;コストを支払う
;CALL PAY_COST,ARG,569
IF ARG:1 == 22
	LOCAL:1 = 7
	LOCAL:2 = 17
ELSE
	LOCAL:1 = 1
	LOCAL:2 = 7
ENDIF

FOR LOCAL,LOCAL:1,LOCAL:2
	SIF POS(LOCAL) < 0
		CONTINUE
	CFLAG:POS(LOCAL):수호의방패 = 0
	FOR LOCAL:3 , 0 , TYPENUM
		CFLAG:POS(LOCAL):@"%GET_TYPE(LOCAL:3)%무효화횟수" = 0
	NEXT
NEXT
PRINTFORMW TARGET:\@ ARG:1 == 22  ? ENEMY # PARTY \@ >>>>>> 무효화 상태를 해제！




