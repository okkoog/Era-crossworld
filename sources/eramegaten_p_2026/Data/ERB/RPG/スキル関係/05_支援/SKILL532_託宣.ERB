;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_532, ARG, ARG:1, ARG:2
#DIM LCOUNT
#DIM TEMP
;ARG:0…実行者のCHARA Num　ARG:1…対象のポジションNum
SELECTCASE RAND:10000
	CASE IS < 3000
		SELECTCASE RAND:100
			CASE IS < 80
				CALL HEAL_FIELD, ARG, 19, 532
			CASE IS < 95
				CALL HEAL_FIELD, ARG, 23, 532
			CASEELSE
				CALL HEAL_FIELD, ARG, 22, 532
		ENDSELECT
	CASE IS < 4500
		SELECTCASE RAND:100
			CASE IS < 80
				CALL FIELD_BADSTATE, ARG, 22, 532
			CASE IS < 95
				CALL FIELD_BADSTATE, ARG, 23, 532
			CASEELSE
				CALL FIELD_BADSTATE, ARG, 19, 532
		ENDSELECT
	CASE IS < 5500
		SELECTCASE RAND:100
			CASE IS < 80
				CALL SKILL_SET_カジャンダ, ARG, 19, "공격/방어/마법위력/마법효과/명중/회피", 8, "範囲"
			CASE IS < 95
				CALL SKILL_SET_カジャンダ, ARG, 23, "공격/방어/마법위력/마법효과/명중/회피", 8, "範囲"
			CASEELSE
				CALL SKILL_SET_カジャンダ, ARG, 22, "공격/방어/마법위력/마법효과/명중/회피", 8, "範囲"
		ENDSELECT
	CASE IS < 6000
		SELECTCASE RAND:100
			CASE IS < 80
				CALL SKILL_SET_カジャンダ, ARG, 22, "공격/방어/마법위력/마법효과/명중/회피", -8, "範囲"
			CASE IS < 95
				CALL SKILL_SET_カジャンダ, ARG, 23, "공격/방어/마법위력/마법효과/명중/회피", -8, "範囲"
			CASEELSE
				CALL SKILL_SET_カジャンダ, ARG, 19, "공격/방어/마법위력/마법효과/명중/회피", -8, "範囲"
		ENDSELECT
	CASE IS < 6500
		IF RAND:2
			CALL SKILL_SET_カジャンダ, ARG, 23, "공격/마법위력", 8, "範囲", "NOPRINT"
			CALL SKILL_SET_カジャンダ, ARG, 23, "방어/마법효과", -8, "範囲", , "공격력과 마법위력이 대폭으로 오르고、방어력과 마법효과가 대폭으로 내렸다！"
		ELSE
			CALL SKILL_SET_カジャンダ, ARG, 23, "공격/마법위력", -8, "範囲", "NOPRINT"
			CALL SKILL_SET_カジャンダ, ARG, 23, "방어/마법효과", 8, "範囲", , "공격력과 마법위력이 대폭으로 내리고、방어력과 마법효과가 대폭으로 올랐다！"
		ENDIF
	CASE IS < 7000
		SELECTCASE RAND:100
			CASE IS < 80
				TEMP = 22
			CASE IS < 95
				TEMP = 23
			CASEELSE
				TEMP = 19
		ENDSELECT
		FOR LCOUNT, GET_POS_MIN(TEMP), GET_POS_MAX(TEMP)
			SIF IS_TARGET_ABLE(POS(LCOUNT))
				CALL PRINT_HIT_MESSAGE, POS(LCOUNT), "전상성킬"
		NEXT
		FOR LCOUNT, 0, TYPENUM
			CALL SKILL_GUARD_KILL, ARG, GET_TYPE(LCOUNT), TEMP, 1, "非表示"
		NEXT
		WAIT
	CASE IS < 8000
		CALL SET_C_BTL_EFFECT_FIELD, ARG, 19, "MP消費無効"
	CASEELSE
		SELECTCASE RAND:4
			CASE 3
				PRINTFORMW ＞획득 경험치가 증가한다！
				TFLAG:획득EXP보정 = MAX(TFLAG:획득EXP보정, 100)
			CASE 2
				PRINTFORMW ＞적이 아이템을 떨어트리는 확률이 올랐다！
				TFLAG:드롭률보정 = MAX(TFLAG:드롭률보정, 100)
			CASE 1
				PRINTFORMW ＞획득 충성도가 증가한다！
				TFLAG:획득충성도보정 = MAX(TFLAG:획득충성도보정, 100)
			CASE 0
				PRINTFORMW ＞획득 ＭＡＧ가 증가한다！
				TFLAG:획득MAG보정 = MAX(TFLAG:획득MAG보정, 400)
		ENDSELECT
ENDSELECT
