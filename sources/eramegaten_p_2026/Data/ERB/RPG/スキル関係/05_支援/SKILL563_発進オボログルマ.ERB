;					Lv30～Lv59：消費24：ラクカジャ＋スクカジャ
;					Lv60～　　：消費35：「ラク・スクをデクンダして」＋ラクカジャ＋スクカジャ
;										（なので使うとラク・スク部分は最低でも＋１になる）（オボログルマにハコ乗りして爆走するので）
;					消費は通常のカジャが12、第一段階は「カジャ＋半カジャ」を１手で、ということで足して18、専用スキルであること、防御的であることから安めに
;					第二段階は二点強化カジャは消費30なのでそこからお安くして24
;					第三段階は一部デクンダと併用ということで、デクンダの消費20の半分を単純にプラス

;スキル名
@SKILL_NAME_563,ARG
	RESULTS = 발진오보로구루마

;　명중
@SKILL_HITRATE_563, ARG
	RETURN 100

;　威力
@SKILL_POWER_563, ARG
	RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_563,ARG
	RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_563,ARG
	RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_563, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_563,ARG
	IF 0
		;Lv1 ～Lv29：消費15：ラクカジャ＋スクカジャの回避部分だけ
		;Lv30～Lv59：消費24：ラクカジャ＋スクカジャ
		;Lv60～　　：消費35：「ラク・スクをデクンダして」＋ラクカジャ＋スクカジャ
	ELSEIF ARG < 0
		RETURN 15
	ELSEIF BASE:ARG:LV >= 60
		RETURN 35
	ELSEIF BASE:ARG:LV >= 30
		RETURN 24
	ELSE
		RETURN 15
	ENDIF


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_563
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_563, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_563,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_563,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_563, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")


;계승타입
@SKILL_SUCCESSION_TYPE_563
RETURN GET_SUCCESSION_NUM("지원")

;속도보정
@SKILL_SPEED_563, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_563
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_563, ARG = -1
RETURN 0




