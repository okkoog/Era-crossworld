@ACTION_563, ARG, ARG:1, ARG:2
#DIM LCOUNT
#DIM L_T
;Lv60以上の場合は先にデクンダをかける
IF BASE:ARG:LV >= 60
	FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
		L_T = POS(LCOUNT)
		SIF !IS_TARGET_ABLE(L_T)
			CONTINUE
		CFLAG:L_T:방어강화 = MAX(0, CFLAG:L_T:방어강화)
		CFLAG:L_T:명중강화 = MAX(0, CFLAG:L_T:명중강화)
		CFLAG:L_T:회피강화 = MAX(0, CFLAG:L_T:회피강화)
	NEXT
ENDIF
;Lv30以上で命中を追加
IF BASE:ARG:LV >= 30
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어/명중/회피", 4, "範囲"
ELSE
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어/회피", 4, "範囲"
ENDIF
