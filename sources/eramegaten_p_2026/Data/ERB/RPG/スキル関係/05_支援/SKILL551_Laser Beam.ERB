@ACTION_551, ARG, ARG:1, ARG:2
SELECTCASE ABL:ARG:가창기능
	CASE 10
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격/마법위력/명중", -8, "範囲"
	CASE IS > 6
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격/마법위력", -8, "範囲", "NOPRINT"
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "명중", -4, "範囲", , "공격과 마법위력이 대폭으로 내렸다！　추가로 명중률이 내렸다！"
	CASE IS > 3
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격/마법위력/명중", -4, "範囲"
	CASEELSE
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격/마법위력", -4, "範囲"
ENDSELECT
