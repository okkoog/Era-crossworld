;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_590, ARG, ARG:1, ARG:2
#LOCALSIZE 3
#DIM CAST_START
#DIM CAST_END
#DIM CAST_TARGET
#DIM TARGET_BUFF
#DIM BUFF_TEMP
;コストを支払う
;CALL PAY_COST,ARG,501

	IF CFLAG:(ARG):PT플래그 == 0
		CAST_START = 7
		CAST_END = 17
	ELSE
		CAST_START = 1
		CAST_END = 7
	ENDIF

	FOR CAST_TARGET, CAST_START, CAST_END
		SIF !IS_TARGET_ABLE(POS(CAST_TARGET))
			CONTINUE
		;通常のカジャンダ範囲まで見る
		FOR TARGET_BUFF, GETNUM(CFLAG,"공격강화"), GETNUM(CFLAG,"마법효과강화")+1
			;強弱をともに８段階にしたので難しいことを考える必要がなく
			CFLAG:POS(CAST_TARGET):TARGET_BUFF *= -1
			CALL PRINT_HIT_MESSAGE, POS(CAST_TARGET), "강화・약화가 반전했다！"
			;一時変数に保存
			;BUFF_TEMP = CFLAG:POS(CAST_TARGET):TARGET_BUFF
			;;カジャンダは内部的には１段階４なので、いったん÷4しておく
			;;（カジャンダの段階が奇数だと、「半分カジャ」が発生してしまうため）（まあ問題もないっちゃないのだが……）
			;;ちなみに変数は基本小数点を持てないので、+5は切り捨てが発生して-2になる
			;BUFF_TEMP /= 4
			;カジャ状態の場合、半分にしてひっくり返す（+5→+2.5、少数切り捨てで+2→-2）
			;IF BUFF_TEMP > 0
			;	BUFF_TEMP /= 2
			;	BUFF_TEMP *= -1
			;;ンダ状態の場合、倍にしてひっくり返す（-2→+4）
			;ELSE
			;	BUFF_TEMP *= 2
			;	BUFF_TEMP *= -1
			;ENDIF
			;;元に戻す
			;BUFF_TEMP *= 4
;
			;;-16～+32の範疇に収まるようにセット
			;CFLAG:POS(CAST_TARGET):TARGET_BUFF = LIMIT(BUFF_TEMP, -16, 32)
		NEXT
	NEXT
	WAIT
	;PRINTFORMW \@ CFLAG:ARG:PT플래그 == 0 ? 敵 # 味方 \@の強化・弱化が反転した！


