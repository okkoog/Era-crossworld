;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_570, ARG, ARG:1, ARG:2
#DIM LCOUNT
#DIM L_T
#DIM SKILL_POWER
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	;料理技能に応じて確率で大幅強化になる
	SKILL_POWER = 4 + ((CFLAG:ARG:PT플래그 ? ABL:ARG:요리기능 # 7) > RAND:11) * 4
	CALL SKILL_SET_カジャンダ, ARG, L_T, "명중/회피", SKILL_POWER, "단체", "NOWAIT"
NEXT
WAIT
