;　コストの量
@SKILL_COST_515,ARG
SIF ARG < 0
	RETURN 40
SIF NO:ARG == [[キャラ:단테]] || NO:ARG == [[キャラ:라이도우]] || NO:ARG == [[キャラ:버질]]
	RETURN 20
SIF (NO:ARG == [[キャラ:더미아나타]] || NO:ARG == [[キャラ:당신]]) && CFLAG:MASTER:당신의전공분야 == 7
	RETURN 30
RETURN 40

