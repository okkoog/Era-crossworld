;スキル及び行動の実行
;====================================================
@ACTION_526, ARG, ARG:1, ARG:2
;コストを支払う
;CALL VAR_MP,ARG,-30
FOR LOCAL,1, 17
	SIF POS(LOCAL) == -1
		CONTINUE
	FOR LOCAL:1, GETNUM(CFLAG,"공격강화"), GETNUM(CFLAG,"BS부착률강화")+1
		CFLAG:POS(LOCAL):(LOCAL:1) = 0
	NEXT
	CFLAG:POS(LOCAL):気合フラグ = 0
	CFLAG:POS(LOCAL):집중플래그 = 0
	CFLAG:POS(LOCAL):타인기합플래그 = 0
	CFLAG:POS(LOCAL):타인집중플래그 = 0
	FOR LOCAL:1, 0 ,19
		CFLAG:POS(LOCAL):(GET_TYPE(LOCAL:1)+ "무효화횟수") = 0
	NEXT
	CFLAG:POS(LOCAL):물리반사플래그 = 0
	CFLAG:POS(LOCAL):마법반사플래그 = 0
	CFLAG:POS(LOCAL):수호의방패 = 0
NEXT
PRINTFORMW 적 아군 모든 효과가 해제되었다！






