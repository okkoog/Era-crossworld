;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_565, ARG, ARG:1, ARG:2
#LOCALSIZE 3
;コストを支払う
;CALL PAY_COST,ARG,565
IF ARG:1 == 22
	LOCAL:1 = 7
	LOCAL:2 = 17
ELSE
	LOCAL:1 = 1
	LOCAL:2 = 7
ENDIF

FOR LOCAL,LOCAL:1,LOCAL:2
	SIF POS(LOCAL) < 0
		CONTINUE
	CFLAG:POS(LOCAL):물리반사플래그 = 0
NEXT
PRINTFORMW TARGET:\@ ARG:1 == 22  ? ENEMY # PARTY \@ >>>>>> 물리반사 상태를 해제！




