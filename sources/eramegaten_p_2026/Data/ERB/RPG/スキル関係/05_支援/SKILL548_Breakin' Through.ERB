@ACTION_548, ARG, ARG:1, ARG:2
SELECTCASE ABL:ARG:가창기능
	CASE 10
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어/마법효과/회피", -8, "範囲"
	CASE IS > 6
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어/마법효과", -8, "範囲", "NOPRINT"
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "회피", -4, "範囲", , "방어와 마법효과가 대폭으로 내렸다！　추가로 회피율이 내렸다！"
	CASE IS > 3
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어/마법효과/회피", -4, "範囲"
	CASEELSE
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어/마법효과", -4, "範囲"
ENDSELECT

