;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_507,ARG
IF SKILL_CHANGE(ARG, [[キャラ:코우메]])
	RESULTS = 호러 스크리모
ELSE
	RESULTS = 라쿤・다
ENDIF

;　명중
@SKILL_HITRATE_507, ARG
RETURN 100

;　威力
@SKILL_POWER_507, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_507,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_507,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_507, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_507,ARG
IF SKILL_CHANGE(ARG, [[キャラ:코우메]])
	RETURN 10
ELSE
	RETURN 12
ENDIF

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_507
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_507, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_507,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_507,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_507, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")


;계승타입
@SKILL_SUCCESSION_TYPE_507
RETURN GET_SUCCESSION_NUM("지원")

;속도보정
@SKILL_SPEED_507, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_507
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_507, ARG = -1
RETURN 6




;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_507, ARG, ARG:1, ARG:2
IF SKILL_CHANGE(ARG, [[キャラ:코우메]])
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어", -((SKILLGAGE_H_GET(ARG,3622)/5)+1)*4, "範囲"
	CALL SKILLGAGE_H_ADD,ARG,3622,-3
ELSE
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어", -4, "範囲"
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================


;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_507, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:코우메]]
	PRINTL 적의 방어력을 낮춘다。감소량은 현재 자신의 사령 카운터의 양에 따라 변화한다。
	PRINTL 자신의 사령 카운터를 3 소비한다。
ELSE
	PRINTL 적 전체의 방어력을 낮춘다。
ENDIF

@SKILL_EXPLAIN_TOOLTIP_507, ARG
IF SKILL_CHANGE(ARG, [[キャラ:코우메]])
	RESULTS = 적 전체의 방어력을 낮춘다。
	RESULTS:1 = 자신의 사령 카운터를 3 소비한다。
ELSE
	RESULTS = 적 전체의 방어력을 낮춘다。
ENDIF



;使用条件
@SKILL_SPECIAL_ACTIONABLE_507,ARG
IF SKILL_CHANGE(ARG, [[キャラ:코우메]])
;小梅が使用する場合は固有ゲージが3以上ないと発動できない。
	RESULTS = 코스트 부족: 사령 카운터(3)
	SIF SKILLGAGE_H_GET(ARG,3622) >= 3
		RETURN 1
	RETURN 0
ELSE	
	RETURN 1
;とくにない
ENDIF
