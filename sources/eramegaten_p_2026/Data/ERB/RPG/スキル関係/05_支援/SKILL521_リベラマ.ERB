;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_521,ARG,ARG:1,ARG:2
CALL SET_FLAG_ENCOUNT_RATE_CHANGE, ARG, "리베라마"
;IF FLAG:エンカウント率補正 != 100
;	PRINTFORMW %CALLNAME:ARG%はリベラマを唱えた。
;	FLAG:エンカウント率補正 = 100
;ELSE
;	PRINTFORMW %CALLNAME:ARG%はリベラマを解除した
;	FLAG:エンカウント率補正 = 0
;ENDIF

@SET_FLAG_ENCOUNT_RATE_CHANGE, ARG, ARGS
SELECTCASE ARGS
	CASE "리베라마", "집마의피리"
		IF FLAG:디스가이즈굿즈
			PRINTL 디스가이즈 굿즈의 효과를 해제하고、
			FLAG:디스가이즈굿즈 = 0
		ENDIF
		IF FLAG:리베라마
			IF FLAG:리베라마 == -1
				PRINTFORMW 집마의 피리 효과를 해제했다。
			ELSE
				PRINTFORMW 리베라마를 해제했다。
			ENDIF
		ELSE
			IF ARGS == "리베라마"
				PRINTFORMW %ARG는% 리베라마를 외쳤다。
				FLAG:리베라마 = (CFLAG:ARG:캐릭터고유번호 + 1)
			ELSE
				PRINTFORMW 집마의 피리를 사용했다。
				FLAG:리베라마 = -1
			ENDIF
		ENDIF
	CASE "디스가이즈굿즈"
		IF FLAG:리베라마
			IF FLAG:리베라마 == -1
				PRINTL 집마의 피리 효과를 해제하고 
			ELSE
				PRINTL 리베라마를 해제하고 
			ENDIF
			FLAG:리베라마 = 0
		ENDIF
		PRINTW 디스가이즈 굿즈를 사용했다。
		FLAG:디스가이즈굿즈 = 1
ENDSELECT
