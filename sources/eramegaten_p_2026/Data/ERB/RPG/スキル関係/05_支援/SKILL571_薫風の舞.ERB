;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_571, ARG, ARG:1, ARG:2
#DIM LCOUNT
#DIM L_T
#DIMS L_ENHANCE
#DIMS L_MES
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	L_ENHANCE = 마법위력/마법효과
	L_MES = 
	IF ABL:ARG:가창기능 > RAND:20
		L_ENHANCE += "/공격"
		L_MES '= "공격력과 "
	ENDIF
	IF ABL:ARG:가창기능 > RAND:20
		L_ENHANCE += "/방어"
		L_MES += "방어력과 "
	ENDIF
	L_MES += "마법위력과 마법효과"
	IF ABL:ARG:가창기능 > RAND:20
		L_MES += "가 올랐다！ 게다가 추가로 마법위력이 올랐다！"
		CALL SKILL_SET_カジャンダ, ARG, L_T, "마법위력", 4, "단체", "NOWAIT", L_MES
	ELSE
		CALL SKILL_SET_カジャンダ, ARG, L_T, L_ENHANCE, 4, "단체", "NOWAIT"
	ENDIF
NEXT
WAIT

