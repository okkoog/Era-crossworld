;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_821,ARG
RESULTS = 로마・그랜드

;　명중
@SKILL_HITRATE_821, ARG
RETURN 100

;　威力
@SKILL_POWER_821, ARG
#LOCALSIZE 2
SIF ARG < 0
	RETURN 1
IF スキル属性表示中
	LOCAL:1 = FLAG:확산플래그
	FLAG:확산플래그 = 現HP割合(ARG)
ENDIF
SELECTCASE FLAG:확산플래그
	CASE IS > 75
		LOCAL:0 = 1 + 225 * (100 - FLAG:확산플래그) / 100
	CASE IS > 50
		LOCAL:0 = 1 + 350 * (100 - FLAG:확산플래그) / 100
	CASE IS > 5
		LOCAL:0 = 1 + 500 * (100 - FLAG:확산플래그) / 100
	CASEELSE
		LOCAL:0 = 1 + 650 * (100 - FLAG:확산플래그) / 100
ENDSELECT
SIF スキル属性表示中
	FLAG:확산플래그 = LOCAL:1
RETURN LOCAL:0


