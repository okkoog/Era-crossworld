;---------------------------------
;ウェイトスキルは専用コマンドから実行させ
;そこでほとんど処理するので、個別の設定はほぼなしで
;---------------------------------
;スキル名
@SKILL_NAME_834,ARG
RESULTS = 빙결리플렉트
;　명중
@SKILL_HITRATE_834, ARG
RETURN 0

;　威力
@SKILL_POWER_834, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_834,ARG
RETURN 0

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_834,ARG
RETURN 0

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_834, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
;MAXMPの1%
@SKILL_COST_834,ARG
RETURN 2


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_834
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_834, ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　사거리
@SKILL_RANGE_834,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_834,ARG
RETURN GET_SPHERE_NUM("적아군전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_834, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;계승타입
@SKILL_SUCCESSION_TYPE_834
RETURN GET_SUCCESSION_NUM("빙결")
;継承不可

;속도보정
@SKILL_SPEED_834, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_834
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_834, ARG = -1
RETURN 0
;変化不可

@ウェイトスキル_834
RETURN 2
;戦闘中に使用できるか
@SKILL_ACTIONABLE_BATTLE_834, ARG
RETURN 0
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_834, ARG, ARG:1, ARG:2

;====================================================
;実行内容ここまで
;====================================================
;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_834,ARG,ARG:1,ARG:2
@SKILL_EXPLAIN_834, ARG
PRINTL １턴간、빙결 상성의 공격을 반사한다

;使用条件
@SKILL_SPECIAL_ACTIONABLE_834,ARG
RETURN 0

