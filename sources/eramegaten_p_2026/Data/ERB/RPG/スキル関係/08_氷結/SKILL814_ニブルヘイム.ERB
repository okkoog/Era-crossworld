;니플헤임
;ロキ・ヘル用の必殺技。リリーズジェイルとの差別化として、威力控えめで凍結率80%

;スキル名
@SKILL_NAME_814,ARG
RESULTS = 니플헤임

;　명중
@SKILL_HITRATE_814, ARG
RETURN 100

;　威力
@SKILL_POWER_814, ARG
#LOCALSIZE 2
IF SKILL_CHANGE(ARG, [[キャラ:미츠루]]) && BASE:ARG:LV >= 50 && EQUIP:ARG:장비페르소나 == 0 && DITEMTYPE:(CFLAG:ARG:초기페르소나넘버):페르소나("NO") == 3953
	RETURN 470
ELSE
	RETURN 395
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_814,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_814,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_814, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_814,ARG
;桐条美鶴Lv50以上。アルテミシア限定
IF SKILL_CHANGE(ARG, [[キャラ:미츠루]]) && BASE:ARG:LV >= 50 && EQUIP:ARG:장비페르소나 == 0 && DITEMTYPE:(CFLAG:ARG:초기페르소나넘버):페르소나("NO") == 3953
	RETURN 28
ELSE
	RETURN 42
ENDIF

;　相性
@SKILL_TYPE_814,ARG
RETURN GET_TYPE_NUM("빙결")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_814
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_814, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_814, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_814,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_814,ARG
;桐条美鶴Lv50以上。アルテミシア限定
IF SKILL_CHANGE(ARG, [[キャラ:미츠루]]) && BASE:ARG:LV >= 50 && EQUIP:ARG:장비페르소나 == 0 && DITEMTYPE:(CFLAG:ARG:초기페르소나넘버):페르소나("NO") == 3953
	RETURN 1
ELSE
	RETURN 3
ENDIF
;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_814, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_814
RETURN GET_SUCCESSION_NUM("빙결")
@継承不能_814
RETURN 1
;継承不能

;속도보정
@SKILL_SPEED_814, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_814
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_814, ARG = -1
RETURN 15




;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_814,ARG
;桐条美鶴Lv50以上。アルテミシア限定
IF SKILL_CHANGE(ARG, [[キャラ:미츠루]]) && BASE:ARG:LV >= 50 && EQUIP:ARG:장비페르소나 == 0 && DITEMTYPE:(CFLAG:ARG:초기페르소나넘버):페르소나("NO") == 3953
	SELECTCASE RAND:100
		CASE IS > 30
			RETURN GET_STATE_NUM("FREEZE")
		CASEELSE
			RETURN GET_STATE_NUM("DYING")
	ENDSELECT
ELSE
	RETURN GET_STATE_NUM("FREEZE")
ENDIF

;추가효과상성
@SKILL_ADDTIONAL_TYPE_814,ARG
RETURN GET_TYPE_NUM("빙결")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_814,ARG
RETURN 50

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_814,ARG
RETURN 95

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_814, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,814

;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_814, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:미츠루]] && BASE:ARG:LV >= 50 && EQUIP:ARG:장비페르소나 == 0 && DITEMTYPE:(CFLAG:ARG:초기페르소나넘버):페르소나("NO") == [[キャラ:아르테미시아_페르소나]]
	PRINTL 적 １체에 빙결 상성의 특대 데미지를 준다。일격필살로 상대를 처형한다。
ELSE
	PRINTL 적 전체에 빙결 상성의 대 데미지를 주고고확률로 동결시킨다、로키・헬의 비의。
ENDIF

;使用条件
@SKILL_SPECIAL_ACTIONABLE_814,ARG
RETURN 1
;とくにない

