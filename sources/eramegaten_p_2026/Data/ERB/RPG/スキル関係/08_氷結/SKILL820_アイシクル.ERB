;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_820,ARG
IF SKILL_CHANGE(ARG, [[キャラ:아키라_무대소녀]])
	RESULTS = 빙결의 스텝
ELSE
	RESULTS = 아이시클
ENDIF

;　명중
@SKILL_HITRATE_820, ARG
RETURN 100

;　威力
@SKILL_POWER_820, ARG
SIF FLAG:확산플래그
	RETURN 85
RETURN 190

;　최저공격횟수
@SKILL_MINATTACKNUMBER_820,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_820,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_820, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_820,ARG
RETURN 18

;　相性
@SKILL_TYPE_820,ARG
RETURN GET_TYPE_NUM("빙결")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_820
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_820, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_820, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_820,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_820,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_820, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_820
RETURN GET_SUCCESSION_NUM("빙결")

;속도보정
@SKILL_SPEED_820, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_820
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_820, ARG = -1
RETURN 4


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_820,ARG
RETURN GET_STATE_NUM("FREEZE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_820,ARG
RETURN 5

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_820,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_820,ARG
RETURN 95


;拡散攻撃用追加処理
@SKILL_SPREAD_820,ARG
RETURN 1
;拡散距離:1
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_820, ARG, ARG:1, ARG:2
CALL ATTACK_SPREAD,ARG,ARG:1,820


;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_820, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:아키라_무대소녀]]
	PRINTL 얼음을 휘감으며 적진에 뛰어든다
	PRINTL 대상과 그 주위에 빙결 상성의 물리 소 데미지+FREEZE。
ELSE
	PRINTL 고드름을 떨어뜨려、대상과 그 주위에 물리데미지FREEZE。
ENDIF


;使用条件
@SKILL_SPECIAL_ACTIONABLE_820,ARG
RETURN 1
;とくにない




