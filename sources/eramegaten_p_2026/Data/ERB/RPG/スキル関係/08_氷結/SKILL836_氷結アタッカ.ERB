;---------------------------------
;ウェイトスキルは専用コマンドから実行させ
;そこでほとんど処理するので、個別の設定はほぼなしで
;---------------------------------
;スキル名
@SKILL_NAME_836,ARG
RESULTS = 빙결어택커
;　명중
@SKILL_HITRATE_836, ARG
RETURN 0

;　威力
@SKILL_POWER_836, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_836,ARG
RETURN 0

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_836,ARG
RETURN 0

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_836, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
;MAXMPの1%
@SKILL_COST_836,ARG
RETURN 2


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_836
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_836, ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　사거리
@SKILL_RANGE_836,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_836,ARG
RETURN GET_SPHERE_NUM("적아군전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_836, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;계승타입
@SKILL_SUCCESSION_TYPE_836
RETURN GET_SUCCESSION_NUM("빙결")
;継承不可

;속도보정
@SKILL_SPEED_836, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_836
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_836, ARG = -1
RETURN 0
;変化不可

@ウェイトスキル_836
RETURN 4
;戦闘中に使用できるか
@SKILL_ACTIONABLE_BATTLE_836, ARG
RETURN 0
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_836, ARG, ARG:1, ARG:2

;====================================================
;実行内容ここまで
;====================================================
;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_836,ARG,ARG:1,ARG:2
@SKILL_EXPLAIN_836, ARG
PRINTL １턴간、헌트스킬의 상성을 빙결 상성으로 변경한다

;使用条件
;火炎ウェイトスキル使用中は無理
@SKILL_SPECIAL_ACTIONABLE_836,ARG
RETURN 0

