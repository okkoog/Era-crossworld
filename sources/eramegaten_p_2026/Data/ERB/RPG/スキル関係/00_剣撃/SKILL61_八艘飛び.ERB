;팔척뛰기, ペルソナヨシツネ専用
;20230601	NEO			凪ちゃんのクライマックスアクト化
;						ハッソウ・ビート：単体へ威力150＊８段攻撃、CTが高く、発動が*非常に*早い

;スキル名
@SKILL_NAME_61, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"真・ヨシツネ見参")
IF 0
;「真・ヨシツネ見参」展開時
ELSEIF SKILLGAGE_D_GET(ARG, SKILL_NUM)
	RESULTS = HASSO・BEAT
ELSEIF SKILL_CHANGE(ARG, [[キャラ:버서커]])
	RESULTS = 사살백두
ELSE
	RESULTS = 팔척뛰기
ENDIF
;　명중
@SKILL_HITRATE_61, ARG
RETURN 90

;　威力
@SKILL_POWER_61, ARG
#DIM SKILL_NUM
SIF ARG == -1
	RETURN 100
SKILL_NUM = PU_SKILLNUM_GET(ARG,"真・ヨシツネ見参")
IF 0
;「真・ヨシツネ見参」展開時
ELSEIF SKILLGAGE_D_GET(ARG, SKILL_NUM)
	RETURN 150
;ボス使用時のみ威力150
ELSEIF CFLAG:ARG:보스플래그
	RETURN 150
ELSE
	RETURN 100
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_61, ARG
RETURN 8

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_61, ARG
