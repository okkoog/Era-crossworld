;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_61
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_61, ARG = -1
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_61, ARG, ARG:1, ARG:2
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"真・ヨシツネ見参")
IF 0
;「真・ヨシツネ見参」展開時
ELSEIF SKILLGAGE_D_GET(ARG, SKILL_NUM)
	;凪が使用し、味方の場合
	IF SKILL_CHANGE(ARG, [[キャラ:나기]]) && CFLAG:(ARG):PT플래그 != 0
		;自身に攻撃・命中・CT強化をかけてから殴る
		CALL SKILL_SET_カジャンダ, ARG, ARG, "공격_명중", 8, "단체", "NOMES"
		CALL SKILL_SET_カジャンダ, ARG, ARG, "크리티컬", 4, "단체", "NOMES"
		;CFLAG:ARG:회피강화 = MIN(32, CFLAG:ARG:공격강화 + 8)
		;CFLAG:ARG:명중강화 = MIN(32, CFLAG:ARG:명중강화 + 8)
		;CFLAG:ARG:크리티컬강화 = MIN(8, CFLAG:ARG:크리티컬강화 + 4)
	ENDIF
	CALL ATTACK_RAND, ARG, ARG:1, 61
	;クライマックスアクｔ……真・ヨシツネ見参の終了
	CALL SKILLGAGE_D_SET, ARG, SKILL_NUM, -1

ELSEIF CFLAG:ARG:보스플래그
	CALL ATTACK_FIELD, ARG, ARG:1, 61
ELSE
	CALL ATTACK_RAND, ARG, ARG:1, 61
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_61, ARG
#DIM SKILL_NUM
;凪（真・ヨシツネ見参の場合）
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:나기]] 
	SKILL_NUM = PU_SKILLNUM_GET(ARG,"真・ヨシツネ見参")

	IF SKILLGAGE_D_GET(ARG, SKILL_NUM) > 0
		PRINTL 적 복수체에게 검격 상성으로 중 데미지 물리공격을 8회 행한다.
		PRINTL 공격 전에 자신에게 공격, 명중, 크리티컬률 강화를 부여한다.
		PRINTL 고크리티컬. 발생이 *매우* 빠르다.
		PRINTL  
		PRINTL 사용하면 『진·요시츠네 등장』이 종료된다.
	ELSE
		PRINTL 적 복수체에 검격 상성으로 소 데미지를 8회 준다
	ENDIF
ELSE
	PRINTL 적 복수체에 검격 상성으로 소 데미지를 8회 준다
ENDIF
;継承に必要な部位
@継承部位_61, ARG
RESULTS = 무기
