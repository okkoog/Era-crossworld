;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_9, ARG
;桐条美鶴Lv50以上。アルテミシア限定
IF SKILL_CHANGE(ARG, [[キャラ:미츠루]]) && BASE:ARG:LV >= 50 && EQUIP:ARG:장비페르소나 == 0 && DITEMTYPE:(CFLAG:ARG:초기페르소나넘버):페르소나("NO") == [[キャラ:아르테미시아_페르소나]]
	RESULTS = 꾸ㆍ드르와
ELSEIF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	RESULTS = 번개찌르기ㆍ벽뢰
ELSE
	RESULTS = 번개찌르기
ENDIF

;　명중
@SKILL_HITRATE_9, ARG
RETURN 100

;　威力
@SKILL_POWER_9, ARG
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	RETURN 280
ELSE
	RETURN 225
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_9, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_9, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_9, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_9, ARG
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	RETURN 9
ELSE
	RETURN 7
ENDIF

;　複合相性
@SKILL_TYPE_9, ARG
#LOCALSSIZE 3
#LOCALSIZE 4
IF ARG >= 0
	IF SKILL_CHANGE(ARG, [[キャラ:미츠루]]) && BASE:ARG:LV >= 50 && EQUIP:ARG:장비페르소나 == 0 && DITEMTYPE:(CFLAG:ARG:초기페르소나넘버):페르소나("NO") == [[キャラ:아르테미시아_페르소나]]
		;전격
		RETURN 6
	ELSEIF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
		RETURN GET_TYPE_NUM("검격"), GET_TYPE_NUM("전격")
	ENDIF
ENDIF
;검격
RETURN 0

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_9
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_9, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_9, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_9, ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_9, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_9, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_9
RETURN GET_SUCCESSION_NUM("검격")

;속도보정
@SKILL_SPEED_9, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_9
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_9, ARG = -1
RETURN 4

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_9, ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_9, ARG
RETURN 6

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_9, ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_9, ARG
RETURN 70

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_9, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE, ARG, LOCAL, 9






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_9, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:미츠루]]
	PRINTL 키리조 미츠루의 스킬。
	PRINTL 커맨드는 ←모은 뒤→+AorB。
	PRINTL 파고들어 적 １체를 검으로 찌르는 돌진기。
	;PRINTL 性能
	;PRINTL Aは発生が早く、Bは突進距離が長い。B及びSB版のみ発動時にレバーを←か→に入れっぱなしにすることによって突進距離を調節することができる。
	;PRINTL A版は小技から繋がるほど発生が早い。連続技や奇襲に使える。
	;PRINTL B版は発生が遅いがスライドダウンを発生させ、レバー←入力版はガードされても先端なら反撃を受けにくい。
	;PRINTL ボタンを押しっぱなしにすることで溜めることができ、最大溜めでダメージが上昇する。
	;PRINTL 相手を高めでヒットさせると特定状況では追撃することができる。『P4U2』では被フェイタルカウンター属性が付いている。
	;PRINTL SB版は発生がかなり早く、硬直もB版より短い。
	;PRINTL またB版と同じように空中ヒットさせると相手をスライドダウンさせるため、硬直の短さによって容易に追撃を行うことができる。単発ダメージはB版より低い。
	;PRINTL スーパーキャンセル対応。
ELSE
	PRINTL 손에 쥔 무기로 적 １체를 공격하고、감전시킨다。후열 사용 가능。
	IF ARG > 0 && ARG < CHARANUM && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
		SETCOLOR 0x14ffd7
		PRINTL 벽색의뇌정 장비중　위력강화／상성변경：검격＋전격
		RESETCOLOR
	ENDIF
ENDIF

;継承に必要な部位
@継承部位_9, ARG
RESULTS = 무기
RETURN 1
;무기


;使用条件
@SKILL_SPECIAL_ACTIONABLE_9, ARG
RETURN 1
;とくにない

