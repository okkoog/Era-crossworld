;　威力
@SKILL_POWER_78,  ARG = -1
SIF ARG == -1
	RETURN 450
SELECTCASE BASE:ARG:ＨＰ * 100 / MAXBASE:ARG:ＨＰ
	CASE IS <= 1
		RETURN 800
	CASE IS < 5
		RETURN 600
	CASE IS < 30
		RETURN 550
	CASE IS < 60
		RETURN 500
	CASE IS < 80
		RETURN 450
	CASEELSE
		RETURN 400
ENDSELECT

