;　コストの量
@SKILL_COST_71,ARG
RETURN 20

;　相性
@SKILL_TYPE_71,ARG
SIF FLAG:공격횟수 == 1
	RETURN GET_TYPE_NUM("파마")
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_71
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
