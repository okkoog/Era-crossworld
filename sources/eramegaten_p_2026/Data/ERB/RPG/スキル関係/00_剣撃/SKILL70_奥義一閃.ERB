;マサカドが使うスキルでもあるので威力以外の性能を高めに

;スキル名
@SKILL_NAME_70,ARG
RESULTS = 오의일섬

;
;　명중
@SKILL_HITRATE_70, ARG
RETURN 120

;　威力
@SKILL_POWER_70, ARG
RETURN 320

;クリティカル率
@SKILL_CRITICAL_RATE_70, ARG
SIF SKILLGAGE_H_GET(FLAG:행동순1,[[스킬:분노폭발]]) == 200 && SKILLGAGE_D_GET(FLAG:행동순1,[[스킬:분노폭발]]) > 0
	RETURN 50
RETURN 20

;　최저공격횟수
@SKILL_MINATTACKNUMBER_70,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_70,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_70, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_70,ARG
RETURN 30

;　相性
@SKILL_TYPE_70,ARG
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_70
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_70, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_70, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_70,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_70,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_70, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_70
RETURN GET_SUCCESSION_NUM("검격")

;@継承不能_70
;RETURN 1

;속도보정
@SKILL_SPEED_70, ARG = -1
RETURN 1


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_70
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_70, ARG = -1
RETURN 15

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_70,ARG
RETURN GET_STATE_NUM("DYING")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_70,ARG
RETURN 0

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_70,ARG
SIF SKILLGAGE_H_GET(ARG,[[스킬:분노폭발]]) == 200 && SKILLGAGE_D_GET(ARG,[[스킬:분노폭발]]) > 0
	RETURN 80
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_70,ARG
SIF SKILLGAGE_H_GET(ARG,[[스킬:분노폭발]]) == 200 && SKILLGAGE_D_GET(ARG,[[스킬:분노폭발]]) > 0
	RETURN 100
RETURN 90
;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_70, ARG = -1, ARG:1 = -1
SIF SKILLGAGE_H_GET(ARG,[[스킬:분노폭발]]) == 200 && SKILLGAGE_D_GET(ARG,[[스킬:분노폭발]]) > 0
	RETURN 2
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_70, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,70

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_70, ARG
PRINTL 적 전열에 검격 상성의 데미지를 주고、추가효과로 즉사시킨다。
SIF ARG >= 0 && ARG < CHARANUM && HAVE_SKILL(ARG, [[스킬:분노폭발]])
	PRINTL 분노폭발 상태에서 사용하면 CT율과 즉사율이 높아지고、검격내성과 검격무효를 관통하고、분노폭발 상태가 사라진다

;継承に必要な部位
@継承部位_70,ARG
RESULTS = 무기
RETURN 1

;使用条件
@SKILL_SPECIAL_ACTIONABLE_70,ARG
RETURN 1
