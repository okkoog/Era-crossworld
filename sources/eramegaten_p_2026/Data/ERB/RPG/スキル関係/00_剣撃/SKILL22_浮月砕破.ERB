;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_22, ARG, ARG:1, ARG:2
#LOCALSIZE 3
#DIM 生存数
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	TFLAG:스킬용1 = 0
	CALL ATTACK_FIELD, ARG, ARG:1, 22
	
	生存数 = 0
	IF CFLAG:ARG:포지션 < 7
		LOCAL:1 = 12
		LOCAL:2 = 17
	ELSE
		LOCAL:1 = 4
		LOCAL:2 = 7
	ENDIF
	;敵/味方後列の生存者をチェック
	FOR LOCAL, LOCAL:1, LOCAL:2
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS < 0
			CONTINUE
		SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
			CONTINUE
		生存数 += 1
	NEXT
	;生存者がいたら追撃します
	IF 生存数 > 0
		TFLAG:스킬용1 = 1
		PRINTW ＞사복검에서 뇌구가 발사되었다！
		IF CFLAG:ARG:포지션 < 7
			LOCAL = 21
		ELSE
			LOCAL = 18
		ENDIF
		CALL ATTACK_FIELD, ARG, LOCAL, 22
	ENDIF
	TFLAG:스킬용1 = 0

	CFLAG:ARG:타겟 = CFLAG:ARG:포지션 < 7 ? 20 # 17
ELSE
	CALL ATTACK_FIELD, ARG, ARG:1, 22
ENDIF





