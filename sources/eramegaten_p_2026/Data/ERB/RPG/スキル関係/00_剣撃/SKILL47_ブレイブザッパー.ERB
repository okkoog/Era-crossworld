;スキル名
@SKILL_NAME_47, ARG
IF SKILL_CHANGE(ARG, [[キャラ:빨강세이버]])
	RESULTS = 갈채는 우레와 같이
ELSEIF SKILL_CHANGE(ARG, [[キャラ:시온]])
	RESULTS = 에테라이트ㆍ에어
ELSEIF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	RESULTS = 브레이브재퍼ㆍ벽뢰
ELSE
	RESULTS = 브레이브재퍼
ENDIF

;　명중
@SKILL_HITRATE_47, ARG
RETURN 100

;　威力
@SKILL_POWER_47, ARG
IF SKILL_CHANGE(ARG, [[キャラ:빨강세이버]])
	RETURN 175
ELSE
	RETURN 550
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_47, ARG
IF SKILL_CHANGE(ARG, [[キャラ:빨강세이버]])
	RETURN 3
ELSE
	RETURN 1
ENDIF

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_47, ARG
IF SKILL_CHANGE(ARG, [[キャラ:빨강세이버]])
	RETURN 3
ELSE
	RETURN 1
ENDIF

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_47, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_47, ARG
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	RETURN 45
ELSE
	RETURN 30
ENDIF

;　複合相性
@SKILL_TYPE_47, ARG
IF ARG >= 0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	RETURN GET_TYPE_NUM("검격"), GET_TYPE_NUM("전격")
ELSE
	RETURN GET_TYPE_NUM("검격")
ENDIF

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_47
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_47, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_47, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_47, ARG
SIF SKILL_CHANGE(ARG, [[キャラ:쿠비키리바사라]])
	RETURN 2
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_47, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_47, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_47
RETURN GET_SUCCESSION_NUM("검격")

;속도보정
@SKILL_SPEED_47, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_47
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_47, ARG = -1
RETURN 13


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_47, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE, ARG, LOCAL, 47


;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_47, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:빨강세이버]]
	PRINTL 바리티누ㆍ브라우셀룬。
	PRINTL 대상을 몰아세워 위력을 더해 베어내리고、베어올리고、베어내리는 삼연격。
ELSE
	PRINTL 적 전열 １체에 검격 상성의 특대 데미지。
	IF ARG > 0 && ARG < CHARANUM && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
		SETCOLOR 0x14ffd7
		PRINTL 벽색의뇌정 장비중　상성변경：검격＋전격
		RESETCOLOR
	ENDIF
ENDIF

;継承に必要な部位
@継承部位_47, ARG
RESULTS = 무기
RETURN 1

;使用条件
@SKILL_SPECIAL_ACTIONABLE_47, ARG
RETURN 1
;とくにない
