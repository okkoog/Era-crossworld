@SKILL_NAME_15,ARG
IF SKILL_CHANGE(ARG, [[キャラ:시온]])
	RESULTS = 에테라이트ㆍ그랜드
ELSEIF SKILL_CHANGE(ARG, [[キャラ:이누가미_마인학원]])
	RESULTS = 베어가르기
ELSE
	RESULTS = 강절단
ENDIF

