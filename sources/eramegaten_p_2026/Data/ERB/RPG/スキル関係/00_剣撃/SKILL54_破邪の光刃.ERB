;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_54, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
SIF ARG:2 < -1
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, AUTO_SPLIT("공격_마법효과_마법위력_방어_명중회피", "_", RAND:5), -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_54, ARG, ARG:1, ARG:2
CALL ATTACK_RAND, ARG, ARG:1, 54

