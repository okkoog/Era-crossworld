;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_16,ARG
RESULTS = 천군의검

;　명중
@SKILL_HITRATE_16, ARG
RETURN 130

;　威力
@SKILL_POWER_16, ARG
SIF FLAG:공격횟수 == 1
	RETURN 180
RETURN 195

;　최저공격횟수
@SKILL_MINATTACKNUMBER_16,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_16,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_16, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_16,ARG
RETURN 12

;　相性
@SKILL_TYPE_16,ARG
SIF FLAG:공격횟수 == 1
	RETURN GET_TYPE_NUM("파마")
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_16
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_16, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_16, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_16,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_16,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_16, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_16
RETURN GET_SUCCESSION_NUM("검격")

@継承不能_16
RETURN 1

;속도보정
@SKILL_SPEED_16, ARG = -1
RETURN 3

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_16
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_16, ARG = -1
RETURN 6


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_16, ARG, ARG:1, ARG:2
CALL ATTACK_SINGLE,ARG,POS(ARG:1),16






