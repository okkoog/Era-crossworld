;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2,ARG
;古代ちゃんが使用する場合ヒートウェーブにマイナーチェンジ。射程が延びる。
IF SKILL_CHANGE(ARG, [[キャラ:코시로]])
	RESULTS = 히트웨이브
ELSEIF SKILL_CHANGE(ARG, [[キャラ:사이버스터]]) || SKILL_CHANGE(ARG, [[キャラ:우즈키]]) || FINDCHARA_M(ARG, [[キャラ:사이버스터]], [[キャラ:우즈키]])
	RESULTS = 척참격ㆍ언월
ELSE
	RESULTS = 히트웨이브
ENDIF

;　명중
@SKILL_HITRATE_2, ARG
RETURN 100

;　威力
@SKILL_POWER_2, ARG
IF SKILL_CHANGE(ARG, [[キャラ:사이버스터]]) || SKILL_CHANGE(ARG, [[キャラ:우즈키]]) 
	RETURN 172
ELSE
	RETURN 195
ENDIF

