RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_1439
RETURN GET_SUCCESSION_NUM("주살")

;속도보정
@SKILL_SPEED_1439, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1439
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1439, ARG = -1
RETURN 5


