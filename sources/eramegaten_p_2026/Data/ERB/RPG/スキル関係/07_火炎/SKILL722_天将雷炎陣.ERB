;炎＋電撃の2段に変更
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_722,ARG
RESULTS = 천장뇌담진

;　명중
@SKILL_HITRATE_722, ARG
RETURN 80

;　威力
;COOP取りやすく、追加効果もあるので若干威力低下
@SKILL_POWER_722, ARG
SIF FLAG:공격횟수 == 0
	RETURN 280
SIF FLAG:공격횟수 == 1
	RETURN 140

;　최저공격횟수
@SKILL_MINATTACKNUMBER_722,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_722,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_722, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_722,ARG
RETURN 45

;　相性
@SKILL_TYPE_722,ARG
SIF FLAG:공격횟수 == 0
	RETURN GET_TYPE_NUM("화염")
SIF FLAG:공격횟수 == 1
	RETURN GET_TYPE_NUM("전격")
;화염＋전격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_722
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_722, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_722, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_722,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_722,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_722, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_722
RETURN GET_SUCCESSION_NUM("화염")
@継承不能_722
RETURN 1
;継承不可

;속도보정
@SKILL_SPEED_722,ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_722
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_722, ARG = -1
RETURN 14


;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_722,ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_722,ARG
RETURN GET_TYPE_NUM("전격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_722,ARG
RETURN 15

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_722,ARG
RETURN 95
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_722, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1, 722





;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_722, ARG
PRINTL 적 전체에 화염＋전격의 데미지를 주고、감전시킨다



;使用条件
@SKILL_SPECIAL_ACTIONABLE_722,ARG
RETURN 1
;とくにない

