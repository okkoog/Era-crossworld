;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_717,ARG
IF SKILL_CHANGE(ARG, [[キャラ:메이팡]])
	RESULTS = 아우프 로단
ELSE
	RESULTS = 불꽃의난무
ENDIF

;　명중
@SKILL_HITRATE_717, ARG
RETURN 90

;　威力
;仕様上,単体相手なら1~3回になるのでダイン相当の320
;上限HIT数に引っかからなければ単体あたりの期待値は240
@SKILL_POWER_717, ARG
RETURN 160

;最低がここで渋いのは同ランクにあたるマハ系が最大5HITしかできないから
;敵総数の判定を全後列合計にできるという強みもあるので、ここで少し絞っといても総HIT数は割合稼げる…はず
;최저공격횟수
@SKILL_MINATTACKNUMBER_717,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_717,ARG
RETURN 8

;一体辺りの最大ＨＩＴ数
@SKILL_MAXATK_PER_717,ARG
RETURN 3

;一体辺りの最低ＨＩＴ数
@SKILL_MINATK_PER_717,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_717, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_717,ARG
RETURN 15

;　相性
@SKILL_TYPE_717,ARG
RETURN GET_TYPE_NUM("화염")
;화염

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_717
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_717, ARG
IF SKILL_CHANGE(ARG, [[キャラ:메이팡]]) 
	RETURN GET_ダメージタイプ_NUM("物理")
ELSE
	RETURN GET_ダメージタイプ_NUM("魔法")
ENDIF

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_717, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_717,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_717,ARG
RETURN GET_SPHERE_NUM("전체")

;スキルがランダム範囲かどうか
@SKILL_RAND_TARGET_717,ARG
