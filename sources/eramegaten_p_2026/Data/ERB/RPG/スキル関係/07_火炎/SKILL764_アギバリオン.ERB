;バランスの都合上、バリオン系はダインからのランクアップ不可
;（汎用魔法ではあるのだが、開発時に想定していないランクのスキルなので、
;　リムドーラとザンダインを基準に、その間の準必殺スキル、として定義。入手難度もそれに準ずる。
;　燃費効率はあえて悪め。習得レベル帯はLv55～を想定。悪魔の場合はさらに相性素質も求めつつ、「こいつはもう強いウリがあるな」を除く）

;スキル名
@SKILL_NAME_764,ARG
RESULTS = 아기바리온

;　명중
@SKILL_HITRATE_764, ARG
RETURN 100

;　威力
@SKILL_POWER_764, ARG
RETURN 410

;　최저공격횟수
@SKILL_MINATTACKNUMBER_764,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_764,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_764, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_764,ARG
RETURN 22

;　相性
@SKILL_TYPE_764,ARG
RETURN GET_TYPE_NUM("화염")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_764
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_764, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_764, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_764,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_764,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_764, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_764
RETURN GET_SUCCESSION_NUM("화염")

;속도보정
@SKILL_SPEED_764, ARG = -1
RETURN 0


