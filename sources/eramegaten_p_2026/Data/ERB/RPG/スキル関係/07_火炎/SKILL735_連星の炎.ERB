;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_735,ARG
RESULTS = 연성의불꽃

;　명중
@SKILL_HITRATE_735, ARG
RETURN 100

;　威力
@SKILL_POWER_735, ARG
RETURN 70

;　최저공격횟수
@SKILL_MINATTACKNUMBER_735,ARG = -1
#LOCALSIZE 4
SIF ARG == -1
	RETURN 1
LOCAL:1 = CFLAG:ARG:PT플래그 ? 7 # 1
LOCAL:2 = CFLAG:ARG:PT플래그 ? 17 # 7
LOCAL:3 = 0
FOR LOCAL, LOCAL:1, LOCAL:2
	SIF POS(LOCAL) == -1
		CONTINUE
	SIF GET_STATE(CFLAG:POS(LOCAL):상태이상) == "DYING"
		CONTINUE
	LOCAL:3 += 1
NEXT
RETURN LOCAL:3
;　최대공격횟수
@SKILL_MAXATTACKNUMBER_735,ARG = -1
#LOCALSIZE 4
SIF ARG == -1
	RETURN 21
LOCAL:1 = CFLAG:ARG:PT플래그 ? 7 # 1
LOCAL:2 = CFLAG:ARG:PT플래그 ? 17 # 7
LOCAL:3 = 1
FOR LOCAL, LOCAL:1, LOCAL:2
	SIF POS(LOCAL) == -1
		CONTINUE
	SIF GET_STATE(CFLAG:POS(LOCAL):상태이상) == "DYING"
		CONTINUE
	LOCAL:3 += 2
;	LOCAL:3 += 1
NEXT
RETURN LOCAL:3

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_735, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_735,ARG
