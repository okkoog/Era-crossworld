;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_713,ARG
RESULTS = 암흑광염난무

;　명중
@SKILL_HITRATE_713, ARG
RETURN 90

;　威力
@SKILL_POWER_713, ARG
SIF FLAG:공격횟수 == 0
	RETURN 115
SIF FLAG:공격횟수 == 1
	RETURN 100
SIF FLAG:공격횟수 == 2
	RETURN 80

;　최저공격횟수
@SKILL_MINATTACKNUMBER_713,ARG
RETURN 3

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_713,ARG
RETURN 3

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_713, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_713,ARG
RETURN 25

;　相性
@SKILL_TYPE_713,ARG
SIF FLAG:공격횟수 == 0
	RETURN GET_TYPE_NUM("검격")
SIF FLAG:공격횟수 == 1
	RETURN GET_TYPE_NUM("화염")
SIF FLAG:공격횟수 == 2
	RETURN GET_TYPE_NUM("주살")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_713
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_713, ARG
SIF FLAG:공격횟수 == 0
	RETURN 1
RETURN 2


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_713, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_713,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_713,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_713, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_713
RETURN GET_SUCCESSION_NUM("화염")
@継承不能_713
RETURN 1
;継承不可

;속도보정
@SKILL_SPEED_713, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_713
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_713, ARG = -1
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_713, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1, 713





;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_713, ARG
PRINTL 적 전체에 검격＋화염＋주살의 데미지를 준다。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_713,ARG
RETURN 1
;とくにない

