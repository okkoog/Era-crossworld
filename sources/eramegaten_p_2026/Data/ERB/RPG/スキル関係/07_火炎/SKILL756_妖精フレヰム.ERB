;20230331	NEO		凪専用スキル　高効率なアギラオ
;					凪のレベルに応じて強化される
;					エンディングを迎えていると、高威力の「物理威力で計算する魔法攻撃」になる
;20230422	NEO		うっかりミスの修正
;20230424	NEO		うっかりミスの修正（今度はコスト部分）

;スキル名
@SKILL_NAME_756,ARG
RESULTS = 요정후레옴

;　명중
@SKILL_HITRATE_756, ARG
RETURN 100

;　威力
@SKILL_POWER_756, ARG
	IF ARG < 0
		RETURN 200
	ELSEIF SKILL_CHANGE(ARG, [[キャラ:나기]])
		IF 0
		;コドクノマレビトエンドを見ている場合、常時最大威力で固定
		ELSEIF GETBIT(FLAG:발견ED, 27)
			RETURN 450
		ELSE
			;Lv60で最大威力
			LOCAL = MIN(300, BASE:ARG:LV * 5)
			LOCAL += 150
			RETURN LOCAL
		ENDIF
	ELSE
		RETURN 200
	ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_756,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_756,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_756, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_756,ARG
	IF ARG < 0
		RETURN 5
	ELSEIF SKILL_CHANGE(ARG, [[キャラ:나기]])
		IF 0
		;コドクノマレビトエンドを見ている場合、ちょっと安い状態で固定
		ELSEIF GETBIT(FLAG:발견ED, 27)
			RETURN 15
		ELSE
			;Lv60で最大消費
			LOCAL = MIN(15, BASE:ARG:LV / 4)
			LOCAL += 2
			RETURN LOCAL
		ENDIF
	ELSE
		RETURN 5
	ENDIF

;　相性
@SKILL_TYPE_756,ARG
RETURN GET_TYPE_NUM("화염")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_756
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　攻撃タイプ
@SKILL_ATTACKTYPE_756,ARG
IF SKILL_CHANGE(ARG, [[キャラ:나기]]) && GETBIT(FLAG:발견ED, 27)
	RETURN GET_攻撃タイプ_NUM("物理")
ELSE
	RETURN GET_攻撃タイプ_NUM("魔法")
ENDIF
	;	;コドクノマレビトエンドを見ている場合、物理威力で計算する
	;	
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_756, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_756, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_756,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_756,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_756, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_756
RETURN GET_SUCCESSION_NUM("화염")

;속도보정
@SKILL_SPEED_756, ARG = -1
RETURN 0


