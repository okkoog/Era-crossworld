;スキル名
@SKILL_NAME_743,ARG
IF SKILL_CHANGE(ARG, [[キャラ:리글]])
	RESULTS = 灯符「ﾌｧｲﾔﾌﾗｲﾌｪﾉﾒﾉﾝ」
ELSEIF SKILL_CHANGE(ARG, [[キャラ:스우]])
	RESULTS = 黒龍波
ELSE
	RESULTS = 염군의춤
ENDIF

