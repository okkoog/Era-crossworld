;　コストの量
@SKILL_COST_619,ARG
RETURN 12


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_619
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_619, ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　사거리
@SKILL_RANGE_619,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_619,ARG
RETURN GET_SPHERE_NUM("적아군전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_619, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")


;계승타입
@SKILL_SUCCESSION_TYPE_619
RETURN GET_SUCCESSION_NUM("방어")
;何でも

;속도보정
@SKILL_SPEED_619, ARG = -1
RETURN 200

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_619
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_619, ARG = -1
RETURN 3

@SKILL_RANKUP_619
