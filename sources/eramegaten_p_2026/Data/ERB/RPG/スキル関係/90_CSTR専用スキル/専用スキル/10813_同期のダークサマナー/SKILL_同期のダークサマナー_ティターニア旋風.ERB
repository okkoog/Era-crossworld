;専用スキル用のテンプレート
;「ティターニア旋風」を別の名前に置き換えてください

;アクティブスキルに必須なものはそのままにしており
;なくてもいいものはコメントアウトしております
;必要だと思ったらコメントアウトを外して設定してください
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_ティターニア旋風,ARG
RESULTS = 티타니아 선풍

;　명중
@SKILL_HITRATE_ティターニア旋風, ARG
RETURN 150

;　威力
@SKILL_POWER_ティターニア旋風, ARG
RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ティターニア旋風,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ティターニア旋風,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ティターニア旋風, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ティターニア旋風,ARG
RETURN 40

;　相性
@SKILL_TYPE_ティターニア旋風,ARG
RETURN GET_TYPE_NUM("충격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ティターニア旋風
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ティターニア旋風,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ティターニア旋風,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ティターニア旋風,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ティターニア旋風,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_ティターニア旋風,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_ティターニア旋風, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ティターニア旋風
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_ティターニア旋風,ARG
RETURN 19

;추가효과상성
@SKILL_ADDTIONAL_TYPE_ティターニア旋風,ARG
RETURN 7

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_ティターニア旋風,ARG
RETURN 15

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_ティターニア旋風,ARG
RETURN 50

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ティターニア旋風,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_ティターニア旋風,ARG
PRINTL 적 전체에게 충격 상성의 대 대미지. 확률로 넘어뜨린다.
PRINTL 요정 티타니아를 소환하여, 모든 것을 날려버리는 충격파를 발산해 넘어뜨린다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ティターニア旋風,ARG
RETURN 1


