;スキル名
@SKILL_NAME_ドリアード樹撃,ARG
RESULTS = 드라이어드 수격

;　명중
@SKILL_HITRATE_ドリアード樹撃, ARG
RETURN 100

;　威力
@SKILL_POWER_ドリアード樹撃, ARG
RETURN 250

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ドリアード樹撃,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ドリアード樹撃,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ドリアード樹撃, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ドリアード樹撃,ARG
RETURN 35

;　相性
@SKILL_TYPE_ドリアード樹撃,ARG
RETURN GET_TYPE_NUM("지변")
;지변

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ドリアード樹撃
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ドリアード樹撃,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ドリアード樹撃,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ドリアード樹撃,ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ドリアード樹撃,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_ドリアード樹撃,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")
;속도보정
@SKILL_SPEED_ドリアード樹撃, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ドリアード樹撃
RETURN 0


;====================================================
;ダメージ発動時
;====================================================
@SKILL_DAMAGE_EFFECT_ドリアード樹撃, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어", -4, "短縮"
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ドリアード樹撃,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)


;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_ドリアード樹撃,ARG
PRINTL 전열 1열에 지변 상성의 물리 대미지 + 방어력 저하. 후열 사용 가능.
PRINTL 요마 드리아드들을 소환하여, 적에게 거목을 떨어뜨린다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ドリアード樹撃,ARG
RETURN 1
