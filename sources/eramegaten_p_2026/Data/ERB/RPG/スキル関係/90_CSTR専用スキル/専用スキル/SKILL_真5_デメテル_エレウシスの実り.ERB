;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_エレウシスの実り,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM LCOUNT
#DIM L_T
#DIM エレウシスカウント
エレウシスカウント = PU_SKILLNUM_GET(ARG,"エレウシスの実り")
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF L_T < 0
		CONTINUE
	SIF IS_BADSTATE(L_T, "DYING")
		CONTINUE
	CFLAG:L_T:최대HP증가 = MAX(33, CFLAG:L_T:최대HP증가)
	;CFLAG:L_T:ＨＰ보정 = MAX(MAXBASE:L_T:ＨＰ / 3, CFLAG:L_T:ＨＰ보정)
	CALL SYNC_STATUS, L_T
NEXT
CALL HEAL_FIELD, ARG, ARG:1, SKILL_NUM, , , "最大HPアップ"

;　説明文の表示
@SKILL_EXPLAIN_エレウシスの実り,ARG
PRINTL 『엘레우시스의 결실』
PRINT 전투 종료 시까지 모든 아군의 HP 보정(최대 HP)을 33% 상승시키고 HP를 전회복한다.
;SETCOLOR 0xff0000
;		PRINTL 使用制限：１戦闘１回まで。
;RESETCOLOR
PRINTL 다른 『HP 보정을 부여하는 스킬』과의 중복은 불가.
PRINTL 33%보다 높은 HP 보정이 있을 경우 효과는 없다.
PRINTL 
PRINTL 그러모은 풍요의 힘을 구사하여 일시적으로 한계를 초월한 활력을 부여한다.
;PRINTL 与え過ぎると爆発するので、二度打ちしないようセーブしている……かもしれない。
PRINTL 여신 데메테르의 스킬 (CSTR 전용)

