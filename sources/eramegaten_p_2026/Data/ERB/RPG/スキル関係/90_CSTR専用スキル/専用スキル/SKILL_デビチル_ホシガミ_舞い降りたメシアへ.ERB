;====================================================
;○URAホシガミ専用スキル『舞い降りたメシアへ』
;====================================================
;原作パスワードから捏造
;氷結・電撃・破魔・万能の複合攻撃
;デクンダ・デカジャ効果も持つ、クレミの上位互換（消費除く）
;新世界へ至れ
;====================================================
;専用スキル用のテンプレート
;「専用技名」を別の名前に置き換えてください

;アクティブスキルに必須なものはそのままにしており
;なくてもいいものはコメントアウトしております
;必要だと思ったらコメントアウトを外して設定してください
;スキルのテンプレートになっています
;====================================================

;スキル名
@SKILL_NAME_舞い降りたメシアへ,ARG
RESULTS = 날아내린 메시아에게

;　명중
@SKILL_HITRATE_舞い降りたメシアへ, ARG
RETURN 150

;　威力
@SKILL_POWER_舞い降りたメシアへ, ARG
RETURN 400

;クリティカル率
;魔法なのでない
;@SKILL_CRITICAL_RATE_舞い降りたメシアへ, ARG
;RETURN 10

;　최저공격횟수
@SKILL_MINATTACKNUMBER_舞い降りたメシアへ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_舞い降りたメシアへ,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_舞い降りたメシアへ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
;敵専用だがアホコスト
@SKILL_COST_舞い降りたメシアへ,ARG
RETURN 120

;　相性
;複合相性
;氷結電撃破魔万能から最大ダメージ
@SKILL_TYPE_舞い降りたメシアへ,ARG
RETURN GET_TYPE_NUM("만능"), GET_TYPE_NUM("빙결"), GET_TYPE_NUM("파마"), GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_舞い降りたメシアへ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_舞い降りたメシアへ,ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_舞い降りたメシアへ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_舞い降りたメシアへ,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_舞い降りたメシアへ,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_舞い降りたメシアへ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
;@SKILL_SUCCESSION_TYPE_舞い降りたメシアへ
;RETURN 23
;검격

;속도보정
@SKILL_SPEED_舞い降りたメシアへ, ARG = -1
RETURN 10

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_舞い降りたメシアへ
RETURN 0

;没
;@SKILL_RANK_舞い降りたメシアへ, ARG = -1



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_舞い降りたメシアへ,ARG,ARG:1,SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;デクンダ効果
;攻撃と同時の効果なので対象を逆転
IF ARG:1 == 19
	LOCAL:2 = 7
	LOCAL:3 = 17
ELSE
	LOCAL:2 = 1
	LOCAL:3 = 7
ENDIF

FOR LOCAL,LOCAL:2,LOCAL:3
	SIF POS(LOCAL) < 0
		CONTINUE
	FOR LOCAL:1,0,6
		CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") = MAX(0, CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화"))
	NEXT
NEXT

PRINTFORMW \@ CFLAG:ARG:PT플래그 > 0 ? 아군 # 적 \@의 저하된 능력이 돌아왔다!

;デカジャ効果
IF ARG:1 == 19
	LOCAL:2 = 1
	LOCAL:3 = 7
ELSE
	LOCAL:2 = 7
	LOCAL:3 = 17
ENDIF

FOR LOCAL,LOCAL:2,LOCAL:3
	SIF POS(LOCAL) < 0
		CONTINUE
	FOR LOCAL:1,0,6
		CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") = MIN(0, CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화"))
	NEXT
NEXT
PRINTFORMW \@ CFLAG:ARG:PT플래그 ? 적 # 아군 \@의 강화된 능력이 돌아왔다!


;공격
IF CFLAG:ARG:포지션 < 7
	LOCAL:1 = 7
	LOCAL:2 = 17 
ELSE
	LOCAL:1 = 1
	LOCAL:2 = 7
ENDIF
FOR LOCAL, LOCAL:1, LOCAL:2
	LOCALS = 포지션{LOCAL}
	;#;PRINTFORML FLAG:LOCALS = {FLAG:LOCALS}
	SIF FLAG:LOCALS < 0
		CONTINUE
	SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
		CONTINUE
	CFLAG:ARG:타겟 = LOCAL
	CALL ATTACK_SINGLE, ARG, FLAG:LOCALS, SKILL_NUM
NEXT
CFLAG:ARG:타겟 = CFLAG:ARG:포지션 < 7 ? 22 # 19




;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_舞い降りたメシアへ,ARG
PRINTL 신세계를 맞이하기 위한 정화.
PRINTL 빙결, 전격, 파마, 만능 복합상성, 데카쟈·데쿤다 효과를 지닌 특대 위력 전체 공격.



;使用条件
@SKILL_SPECIAL_ACTIONABLE_舞い降りたメシアへ,ARG
RETURN 1
