;専用スキル用のテンプレート
;「タマモ殺生石」を別の名前に置き換えてください

;アクティブスキルに必須なものはそのままにしており
;なくてもいいものはコメントアウトしております
;必要だと思ったらコメントアウトを外して設定してください
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_タマモ殺生石,ARG
RESULTS = 타마모 살생석

;　명중
@SKILL_HITRATE_タマモ殺生石, ARG
RETURN 100

;　威力
@SKILL_POWER_タマモ殺生石, ARG
SIF FLAG:확산플래그
	RETURN 150
RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_タマモ殺生石,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_タマモ殺生石,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_タマモ殺生石, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_タマモ殺生石,ARG
RETURN 30

;　相性
@SKILL_TYPE_タマモ殺生石,ARG
RETURN GET_TYPE_NUM("만능")
;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_タマモ殺生石
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_タマモ殺生石,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_タマモ殺生石,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_タマモ殺生石,ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_タマモ殺生石,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_タマモ殺生石,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")
;속도보정
@SKILL_SPEED_タマモ殺生石, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_タマモ殺生石
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_タマモ殺生石,ARG
RETURN GET_STATE_NUM("POISON")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_タマモ殺生石,ARG
RETURN 8

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_タマモ殺生石,ARG
RETURN 40

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_タマモ殺生石,ARG
RETURN 70

;;拡散攻撃用追加処理
;;ブレスなどの拡散攻撃に使う
@SKILL_SPREAD_タマモ殺生石,ARG
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_タマモ殺生石,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM;		拡散攻撃

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_タマモ殺生石,ARG
PRINTL 대상과 그 주위에 만능 상성의 물리 대 대미지 + 독
PRINTL 마수 타마모를 소환하여, 살생석을 던져 오염시킨다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_タマモ殺生石,ARG
RETURN 1


