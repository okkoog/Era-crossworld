;RETURN 23
;검격

;속도보정
@SKILL_SPEED_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！
RETURN 0

;没
;@SKILL_RANK_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！, ARG = -1

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	RETURN 0

;추가효과상성
@SKILL_ADDTIONAL_TYPE_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	RETURN 0

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	RETURN 0

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG,ARG:1,SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM
;LOCAL = POS(ARG:1)

	;クラリオンの魔力が増大していく！
	;速度がちょっとづつ上昇
	CFLAG:ARG:속도보정 += 1
	;5％づつ　雪だるま式に　増えていく
	CFLAG:ARG:마법위력보정 += CFLAG:ARG:마법위력보정 / 20
	CFLAG:ARG:마법효과보정 += CFLAG:ARG:마법효과보정 / 20 
	CALL SYNC_STATUS,ARG

	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃클라리온의 마력이 증대해 간다!　　　　　　　　　　　　　┃
	PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	PRINTL 클라리온의 마력은 증대해 간다……!

;使用条件
@SKILL_SPECIAL_ACTIONABLE_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	RETURN 1
