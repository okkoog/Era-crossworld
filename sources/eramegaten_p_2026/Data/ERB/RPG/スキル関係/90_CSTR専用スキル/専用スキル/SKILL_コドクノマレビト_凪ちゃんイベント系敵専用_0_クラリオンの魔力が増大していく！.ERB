;====================================================
;○凪ちゃんイベントの敵専用スキル群
;====================================================
;====================================================
;00.「クラリオンの魔力が増大していく！」
;　ARG番のキャラクターの魔、知、速を永続的に上昇
;01～04.「～～신벌」
;　デッドリーバーン互換の特大威力全体攻撃
;　火炎、氷結、電撃、衝撃相性、付与状態異常はそれぞれの相性でのFLAME、FREEZE、SHOCK、SLIP
;05.「神　罰　大　光」
;　8-8回の全体RAND攻撃
;　火炎、氷結、電撃、衝撃、万能相性の複合
;　殺意満載の履行技
;06.「造物主の嘆き」
;　3-8回の全体RAND攻撃
;　飛具、打撃相性の複合
;　殺意はまあまあ低い
;07.「万物の障壁」
;　自身へすべての相性への壁を張る
;　中身はマハアナライズ(なおすぐマヨーネに割られる模様）
;====================================================

;スキル名
@SKILL_NAME_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	RESULTS = 클라리온의 마력이 증대해 간다!

;　명중
@SKILL_HITRATE_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！, ARG
	;おまじない
	RETURN 100

;　威力
@SKILL_POWER_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！, ARG
	RETURN 1

;クリティカル率
@SKILL_CRITICAL_RATE_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！, ARG
	;おまじない
	RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	;おまじない
	RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	;おまじない
	RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！, ARG
RETURN GET_SKILL_COST_TYPE_NUM("HP")
	;消費なし＝1

;　コストの量
@SKILL_COST_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	;敵専用スキル群なので消費極少
	RETURN 1

;　相性
@SKILL_TYPE_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	;自分対象のバフ
	RETURN 4

;　사거리
@SKILL_RANGE_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	;自分へのバフなので4
	RETURN 4

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_凪ちゃんイベント系_0_クラリオンの魔力が増大していく！,ARG
	;自分へのバフなので4
	RETURN 4

