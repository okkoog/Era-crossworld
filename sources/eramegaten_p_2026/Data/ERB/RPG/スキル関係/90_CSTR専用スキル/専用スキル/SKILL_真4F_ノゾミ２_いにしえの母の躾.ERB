;特殊な参照値
@SKILL_CALC_BATTTLE_STATUS_いにしえの母の躾, ARGS, ARG, ARG:1
SIF ARG < 0
	RETURN 0
SELECTCASE ARGS
	CASE "ATK"
		IF GET_ROLE_PROP("CAN_USE_GUN", ARG) && EQUIP:ARG:총
			RETURN MAXBASE:ARG:총공격
		ELSE
			RETURN MAXBASE:ARG:공격 / 2
		ENDIF
	CASE "HIT"
		IF GET_ROLE_PROP("CAN_USE_GUN", ARG) && EQUIP:ARG:총
			RETURN MAXBASE:ARG:총명중
		ELSE
			RETURN MAXBASE:ARG:명중
		ENDIF
ENDSELECT

