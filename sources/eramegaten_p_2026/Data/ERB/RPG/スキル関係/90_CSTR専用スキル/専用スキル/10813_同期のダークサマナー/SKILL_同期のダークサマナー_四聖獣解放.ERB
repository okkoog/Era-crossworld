;スキル名
@SKILL_NAME_四聖獣解放,ARG
RESULTS = 四聖獣解放

;　명중
@SKILL_HITRATE_四聖獣解放, ARG
RETURN 120

;　威力
@SKILL_POWER_四聖獣解放, ARG
RETURN 100

;　최저공격횟수
@SKILL_MINATTACKNUMBER_四聖獣解放,ARG
RETURN 4

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_四聖獣解放,ARG
RETURN 4

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_四聖獣解放, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_四聖獣解放,ARG
RETURN 45

;　相性
@SKILL_TYPE_四聖獣解放,ARG
RETURN GET_TYPE_NUM("만능")
;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_四聖獣解放
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_四聖獣解放,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_四聖獣解放,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_四聖獣解放,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_四聖獣解放,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_四聖獣解放,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_四聖獣解放, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_四聖獣解放
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_四聖獣解放,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_四聖獣解放,ARG
PRINTL 적 전체에게 만능 상성의 소 대미지를 4회 입힌다.
PRINTL 사성수를 동시 소환하여, 적진에 방출한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_四聖獣解放,ARG
RETURN 1
