;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_ドラゴンバイト,ARG,ARG:1
#LOCALSIZE 2
#DIM L_T
#DIM L_GP
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "ドラゴンバイト")
LOCAL:1 = SKILLGAGE_H_GET(ARG, SKILL_NUM)
L_GP = 0
;自分の行動の場合
IF ARG == ARG:1
	IF SKILLGAGE_H_GET(ARG, SKILL_NUM) > 99
		;本性顕現時はテンションをクリアーして終わる
		SIF IS_PU_SKILL_入力行動(ARG, "ドラゴンバイト") 
			CALL SKILLGAGE_H_SET, ARG, SKILL_NUM, 0
		RETURN 0
	ENDIF
	;毎ターン＋10
	L_GP += 10
	FOR LOCAL, 0, BCHARANUM
		L_T = BCHARA:LOCAL
		SIF IS_FRIEND(ARG,L_T)
			CONTINUE
		SIF GET_CREC_ACT(ARG, L_T, "HIT")
			L_GP += 10
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 10
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 10
	NEXT
	;ダメージを受けた敵の数に応じてスキルゲージアップ
	;FOR LOCAL,0,CHARANUM
	;	SIF CFLAG:LOCAL:PT플래그 == CFLAG:ARG:PT플래그
	;		CONTINUE
	;	IF CFLAG:LOCAL:현데미지 > 0
	;		CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),10
	;	ELSE
	;		CONTINUE
	;	ENDIF
	;	;会心、弱点を出すとさらにアップ
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,21)
	;		CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),10
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,22)
	;		CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),10
	;NEXT
	;気合を入れても上がる
	IF CFLAG:ARG:입력행동 == [[스킬:기합]]
		L_GP += 30
	;会心の覇気しても上がる
	ELSEIF CFLAG:ARG:입력행동 == [[스킬:회심의패기]]
		L_GP += 30
	;雄叫びしても上がる
	ELSEIF CFLAG:ARG:입력행동 == [[스킬:포효]]
		L_GP += 20
	ENDIF
	
	;気合を入れても上がる
	;IF CFLAG:ARG:입력행동 == 511
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
	;会心の覇気しても上がる
	;ELSEIF CFLAG:ARG:입력행동 == [[스킬:회심의패기]]
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
	;雄叫びしても上がる
	;ELSEIF CFLAG:ARG:입력행동 == 514
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),20
	;ENDIF
	
	;専用技を使った場合さらに+30
	SIF INRANGE(CFLAG:ARG:입력행동, SKILL_NUM_F("전용기1"), SKILL_NUM_F("전용기1") + PU_NUM())
		L_GP += 30
	;SIF CFLAG:ARG:입력행동 == [[스킬:전용기1]]
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
	;SIF CFLAG:ARG:입력행동 == [[스킬:전용기2]]
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
	;SIF CFLAG:ARG:입력행동 == [[스킬:전용기3]]
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
	;SIF CFLAG:ARG:입력행동 == [[스킬:전용기4]]
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
	;SIF CFLAG:ARG:입력행동 == [[스킬:전용기5]]
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
	;SIF CFLAG:ARG:입력행동 == [[스킬:전용기6]]
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
	;SIF CFLAG:ARG:입력행동 == [[스킬:전용기7]]
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
	;SIF CFLAG:ARG:입력행동 == [[스킬:전용기8]]
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
	;SIF CFLAG:ARG:입력행동 == [[스킬:전용기9]]
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
	;SIF CFLAG:ARG:입력행동 == [[스킬:전용기10]]
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
	;SIF CFLAG:ARG:입력행동 == [[스킬:전용기11]]
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
	;SIF CFLAG:ARG:입력행동 == [[스킬:전용기12]]
	;	CALL SKILLGAGE_H_ADD,ARG,PU_SKILLNUM_GET(ARG, "ドラゴンバイト"),30
ELSE
	;ゲージが上限なら終了
	SIF SKILLGAGE_H_GET(ARG, SKILL_NUM) > 99
		RETURN 0
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える
;IF CFLAG:ARG:현데미지 > 0 || GETBIT(CFLAG:ARG:受けフラグ,18) || GETBIT(CFLAG:ARG:受けフラグ,19)
IF GET_CREC_ACT(ARG:1, ARG, "HIT")
