;専用スキル用のテンプレート
;「イヌガミインヘルノ」を別の名前に置き換えてください

;アクティブスキルに必須なものはそのままにしており
;なくてもいいものはコメントアウトしております
;必要だと思ったらコメントアウトを外して設定してください
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_イヌガミインヘルノ,ARG
RESULTS = 이누가미 인페르노

;　명중
@SKILL_HITRATE_イヌガミインヘルノ, ARG
RETURN 100

;　威力
@SKILL_POWER_イヌガミインヘルノ, ARG
RETURN 400

;　최저공격횟수
@SKILL_MINATTACKNUMBER_イヌガミインヘルノ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_イヌガミインヘルノ,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_イヌガミインヘルノ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_イヌガミインヘルノ,ARG
RETURN 30

;　相性
@SKILL_TYPE_イヌガミインヘルノ,ARG
RETURN GET_TYPE_NUM("화염")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_イヌガミインヘルノ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_イヌガミインヘルノ,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_イヌガミインヘルノ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_イヌガミインヘルノ,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_イヌガミインヘルノ,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_イヌガミインヘルノ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_イヌガミインヘルノ, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_イヌガミインヘルノ
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_イヌガミインヘルノ,ARG
RETURN 18

;추가효과상성
@SKILL_ADDTIONAL_TYPE_イヌガミインヘルノ,ARG
RETURN 4

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_イヌガミインヘルノ,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_イヌガミインヘルノ,ARG
RETURN 95

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_イヌガミインヘルノ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_イヌガミインヘルノ,ARG
PRINTL 적 1체에게 화염 상성의 물리 특대 대미지 + 화염 상태
PRINTL 마수 이누가미를 소환하여, 강렬한 화염으로 적 1체를 구워버린다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_イヌガミインヘルノ,ARG
RETURN 1
