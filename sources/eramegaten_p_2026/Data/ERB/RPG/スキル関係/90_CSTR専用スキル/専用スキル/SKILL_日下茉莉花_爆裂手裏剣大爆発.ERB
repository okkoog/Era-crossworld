IF CFLAG:(CHARANUM-1):PT플래그 || ARG < 0 || ARG >= CHARANUM
	PRINTL 1회 출격당 3회까지 사용 가능
ELSE
	;残弾なし
	IF SKILLGAGE_F_GET(ARG, 爆裂手裏剣大爆発残弾) > 2
		PRINTL 残弾　0発　使用不能
	;残弾あり
	ELSE
		PRINT 残弾　
		LOCAL = 3 - SKILLGAGE_F_GET(ARG, 爆裂手裏剣大爆発残弾)
		PRINTV LOCAL
		PRINTL 発
	ENDIF
ENDIF

