;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ＯＲＧＹ－ＡＵＴＯ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;====================================================
;追加コマンド(一番下)
;====================================================
@SKILL_SPECIAL_COMMAND_ＯＲＧＹ－ＡＵＴＯ,ARG,LOCAL,SKILL_NUM
#DIM SKILL_NUM
#DIM MODIFIED_SKILL_NUM
#LOCALSIZE 1
MODIFIED_SKILL_NUM = 10000 + SKILL_NUM
REPEAT LOCAL
	SIF C:(COUNT+1) == MODIFIED_SKILL_NUM
		RETURN LOCAL
REND
C:COUNT = MODIFIED_SKILL_NUM
IF COUNT == LOCAL
	PRINTFORML [{LOCAL}] ＯＲＧＹ－ＡＵＴＯ
	LOCAL++
ENDIF
RETURN LOCAL

;====================================================
;コマンド実行
;====================================================
@INPUT_COM_ＯＲＧＹ－ＡＵＴＯ,ARG
PRINTL 평소대로 오르기아를 발동하는 것에 더해, 다음 이후 보스전 이외의 전투 개시 시에
PRINTL 자동적으로 오르기아를 발동하도록 설정합니다.
PRINTL 이 설정은 던전 탐색 종료까지 지속되지만 전투 개시 시에 해제할 수도 있습니다.
PRINTL 
PRINTL ORGY-AUTO를 설정합니다. 괜찮겠습니까?
PRINTL [0] 네
PRINTL [1] 아니오
ONEINPUTS 0
SIF RESULTS == "1"
	RETURN -1

CALL SET_RPG_CFLAG_DUNGEON, ARG, "ORGY_AUTO_ENABLE", 1

CALL INPUT_COM_14556, ARG
RETURN RESULT
;;-1 再びコマンド選択へ
;; 1 キャラ選択へ

;　説明文の表示
@SKILL_EXPLAIN_ＯＲＧＹ－ＡＵＴＯ,ARG
