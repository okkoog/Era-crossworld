;====================================================
;○フツオ専用スキル『真・神経弾』
;====================================================
;フツオと言えば。
;基本付与率500とかいうアホみたいな数字の強制睡眠
;万能相性だが火力自体はごく低い
;なお、「True・神経弾」ではなく「真・女神転生の神経弾」という意味の名前です
;====================================================
;専用スキル用のテンプレート
;「専用技名」を別の名前に置き換えてください

;アクティブスキルに必須なものはそのままにしており
;なくてもいいものはコメントアウトしております
;必要だと思ったらコメントアウトを外して設定してください
;スキルのテンプレートになっています
;====================================================

;スキル名
@SKILL_NAME_真・神経弾,ARG
RESULTS = 真・神経弾

;　명중
@SKILL_HITRATE_真・神経弾, ARG
RETURN 200

;　威力
@SKILL_POWER_真・神経弾, ARG
RETURN 50

;クリティカル率
@SKILL_CRITICAL_RATE_真・神経弾, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_真・神経弾,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_真・神経弾,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_真・神経弾, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_真・神経弾,ARG
RETURN 1

;　相性
@SKILL_TYPE_真・神経弾,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_真・神経弾
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_真・神経弾,ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_真・神経弾,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_真・神経弾,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_真・神経弾,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_真・神経弾,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
;@SKILL_SUCCESSION_TYPE_真・神経弾
;RETURN 23
;검격

;속도보정
@SKILL_SPEED_真・神経弾, ARG = -1
RETURN 10

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_真・神経弾
RETURN 0

;没
;@SKILL_RANK_真・神経弾, ARG = -1

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_真・神経弾,ARG
	RETURN GET_STATE_NUM("SLEEP")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_真・神経弾,ARG
RETURN 17

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_真・神経弾,ARG
RETURN 500

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_真・神経弾,ARG
RETURN 100


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_真・神経弾,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,SKILL_NUM


;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_真・神経弾,ARG
PRINTL 진·신경탄. 더 히어로가 사용하는 이형의 탄환.
PRINTL 방어를 꿰뚫고 신경을 미치게 해 혼도(기절)시킨다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_真・神経弾,ARG
RETURN 1
