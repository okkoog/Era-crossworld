;====================================================
;○フツオ専用スキル『ストラディバリ』
;====================================================
;原作最強武器
;本来は剣……あるいは打撃だと思うが、反射されると痛いし、そもそも「反射できると思うな」ということで万能相性
;確実にぶちころすために単体攻撃、まあ攻撃回数の都合でころせないことも多いが
;想定は「レベル100で耐力40程度の悪魔にフルヒットしたら即死」。
;====================================================
;専用スキル用のテンプレート
;「専用技名」を別の名前に置き換えてください

;アクティブスキルに必須なものはそのままにしており
;なくてもいいものはコメントアウトしております
;必要だと思ったらコメントアウトを外して設定してください
;スキルのテンプレートになっています
;====================================================

;スキル名
@SKILL_NAME_ストラディバリ,ARG
RESULTS = 스트라디바리

;　명중
@SKILL_HITRATE_ストラディバリ, ARG
RETURN 200

;　威力
@SKILL_POWER_ストラディバリ, ARG
RETURN 300

;クリティカル率
@SKILL_CRITICAL_RATE_ストラディバリ, ARG
RETURN 15

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ストラディバリ,ARG
RETURN 0

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ストラディバリ,ARG
RETURN 8

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ストラディバリ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("HP")
;消費なし＝1

;　コストの量
@SKILL_COST_ストラディバリ,ARG
RETURN 0

;　相性
@SKILL_TYPE_ストラディバリ,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ストラディバリ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ストラディバリ,ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ストラディバリ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ストラディバリ,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ストラディバリ,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ストラディバリ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
;@SKILL_SUCCESSION_TYPE_ストラディバリ
;RETURN 23
;검격

;속도보정
@SKILL_SPEED_ストラディバリ, ARG = -1
RETURN 10

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ストラディバリ
RETURN 0

;没
;@SKILL_RANK_ストラディバリ, ARG = -1



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ストラディバリ,ARG,ARG:1,SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE, ARG, LOCAL,SKILL_NUM


;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_ストラディバリ,ARG
;「デイビッド」に一番近い語感のストラディバリの愛称“Le Davidoff”をつけようかと思ったがやめとく。デイビットってどこから来たんだろう
PRINTL 스트라디바리. 더 히어로가 자랑하는 명기.
PRINTL 만능 상성, 단체 대상, 대위력의 최대 8회 공격.
;人殺しバイオリンである

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ストラディバリ,ARG
RETURN 1
