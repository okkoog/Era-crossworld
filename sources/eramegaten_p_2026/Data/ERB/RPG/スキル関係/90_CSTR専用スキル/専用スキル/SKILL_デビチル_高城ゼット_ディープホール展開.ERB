;====================================================
;○高城ゼット専用スキル『ディープホール展開』
;====================================================
;漫画版で天使を全滅させていた。
;ここでは極小展開として、呪殺/重力相性の敵味方全体攻撃として実装。
;まあ呪殺は塞ぐだろうが重力も全員塞ぐかというとやりにくいよねえ。
;その分威力はお高めで、「重力での即死」というちょっとおかしなことをする。
;====================================================
;専用スキル用のテンプレート
;「専用技名」を別の名前に置き換えてください

;アクティブスキルに必須なものはそのままにしており
;なくてもいいものはコメントアウトしております
;必要だと思ったらコメントアウトを外して設定してください
;スキルのテンプレートになっています
;====================================================

;スキル名
@SKILL_NAME_ディープホール展開,ARG
RESULTS = 딥 홀 전개

;　명중
@SKILL_HITRATE_ディープホール展開, ARG
	;周囲全体なので必中
	RETURN 999

;　威力
@SKILL_POWER_ディープホール展開, ARG
	;超特大級の威力
	RETURN 480

;クリティカル率
@SKILL_CRITICAL_RATE_ディープホール展開, ARG
	;魔法なので意味ない
	RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ディープホール展開,ARG
	RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ディープホール展開,ARG
	RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ディープホール展開, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ディープホール展開,ARG
	RETURN 50

;　相性
@SKILL_TYPE_ディープホール展開,ARG
	RETURN GET_TYPE_NUM("주살"), GET_TYPE_NUM("중력")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ディープホール展開
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ディープホール展開,ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ディープホール展開,ARG
RETURN GET_SKILL_TARGET_NUM("전투전체")

;　사거리
@SKILL_RANGE_ディープホール展開,ARG
	RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ディープホール展開,ARG
RETURN GET_SPHERE_NUM("적아군전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ディープホール展開,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
;@SKILL_SUCCESSION_TYPE_ディープホール展開
;RETURN 23
;검격

;속도보정
@SKILL_SPEED_ディープホール展開, ARG = -1
	;展開はドロドロとして遅い
	RETURN -10

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ディープホール展開
	RETURN 0

;没
;@SKILL_RANK_ディープホール展開, ARG = -1

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_ディープホール展開,ARG
	RETURN GET_STATE_NUM("DYING")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_ディープホール展開,ARG
	RETURN GET_TYPE_NUM("중력")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_ディープホール展開,ARG
	RETURN 15

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_ディープホール展開,ARG
	RETURN 50


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ディープホール展開,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM



;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_ディープホール展開,ARG
PRINTL 적과 아군 전체에 주살·중력 복합상성으로 초특대 위력의 마법 공격을 행한다.
PRINTL 공격은 필중하며 중력 상성의 즉사 부여 효과를 지닌다.
PRINTL  
PRINTL 타카기 제트――심연마왕 제블이 지닌 암흑을 주위에 방출하는 공격.



;使用条件
@SKILL_SPECIAL_ACTIONABLE_ディープホール展開,ARG
RETURN 1
