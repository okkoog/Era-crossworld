;スキル名
@SKILL_NAME_激昂,ARG
RESULTS = 激昂

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_激昂
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_激昂,ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_激昂,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_激昂,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_激昂,ARG
RETURN GET_SKILL_EFFECT_NUM("상태변화")

;スキル変化？用ランク
@SKILL_RANK_激昂, ARG = -1
RETURN 15

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_激昂
RETURN 0

;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_激昂,ARG,ARG:1
;攻撃者が味方
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
SIF CFLAG:ARG:방어플래그
	RETURN 0
SIF !GET_CREC_ACT(ARG:1, ARG, "WEAK")
	RETURN 0
RETURN 1, CPOS(ARG)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_激昂,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL SKILL_SET_カジャンダ, ARG, ARG, "공격/방어/마법위력/마법효과/명중/회피", 4, "단체", , "弱点攻撃を受けて全ての能力があがった！"

;　説明文の表示
@SKILL_EXPLAIN_激昂,ARG
PRINTL 자동: 자신이 적에게서 약점 공격을 받았을 때 이하의 연동 효과가 발동한다.
PRINTL 　　　「자신의 모든 능력을 상승시킨다.」

;使用条件
@SKILL_SPECIAL_ACTIONABLE_激昂,ARG
RETURN 0
