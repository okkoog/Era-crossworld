;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
;3588,クライマックスレヴュー展開からだいぶコピペな
;====================================================
@SKILLGAGE_CHARGE_真・ヨシツネ見参,ARG,ARG:1
#LOCALSIZE 2
#DIM LCOUNT
#DIM L_T
#DIM SKILL_NUM
#DIM L_GP
#DIM L_相性
#DIM L_物魔
SKILL_NUM = PU_SKILLNUM_GET(ARG,"真・ヨシツネ見参")
L_GP = 0
;MAXなら離脱
SIF SKILLGAGE_H_GET(ARG, SKILL_NUM) == 100
	RETURN 0
;Dゲージがある＝現在モード切替中なら離脱
SIF SKILLGAGE_D_GET(ARG, SKILL_NUM) == 100
	RETURN 0
;モード切替時専用技発動直後は-1にしてくるのでここで0にして離脱
IF SKILLGAGE_D_GET(ARG, SKILL_NUM) < 0
	CALL SKILLGAGE_D_SET,ARG,SKILL_NUM,0
	RETURN 0
;自分の行動の場合
ELSEIF ARG == ARG:1
	;行った攻撃の相性の取得を試みる
	CALL GET_SKILL_PROP, "SKILL_TYPE", CFLAG:ARG:입력행동, ARG
	L_相性 = RESULT

	;行った攻撃の物魔の取得を試みる
	CALL GET_SKILL_PROP, "SKILL_DAMAGETYPE", CFLAG:ARG:입력행동, ARG
	L_物魔 = RESULT
	
	FOR LCOUNT, 0, BCHARANUM
		L_T = BCHARA:LCOUNT
		;味方同士の攻撃では蓄積しない
		SIF IS_FRIEND(ARG, L_T)
			CONTINUE
		;攻撃をあてている必要がある
		SIF !GET_CREC_ACT(ARG, L_T, "HIT")
			CONTINUE
		;物理攻撃なら＋10
		SIF L_物魔 == 1
			L_GP += 10
		;剣撃相性なら＋５
		SIF L_相性 == GET_TYPE_NUM("검격")
			L_GP += 5
		;クリティカル、WEAKを取ったらさらに＋５
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 5
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 5
	NEXT
	;会心の覇気、気合、コンセ、スマイルチャージ、オバリヨン咆哮、発進オボログルマ、妖精フレヰムで15％上昇
	;長くなるので改行OKの記法で
	;ヨシツネ見参は物理剣撃なので↑でプラス
	{
	SIF GROUPMATCH(CFLAG:ARG:입력행동,
		[[스킬:회심의패기]],
		[[스킬:기합]],
		[[스킬:컨센트레이트]],
		[[스킬:스마일차지]],
		[[스킬:오바리욘포효]],
		[[스킬:발진오보로구루마]],
		[[스킬:요정후레옴]])
	}
		L_GP += 15
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += MAX(60 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ, 2)
;スキルゲージが100以上だと100にする
CALL SKILLGAGE_H_SET,ARG, SKILL_NUM, MIN(SKILLGAGE_H_GET(ARG, SKILL_NUM) + L_GP, 100)

;蓄積状態を返す
IF SKILLGAGE_H_GET(ARG, SKILL_NUM) == 100
	;原作だと凪ちゃんは別にヨシツネをうまく使役できてたわけではないので印象的なセリフとかはない
	RESULTS = 【지금 여기에 요시츠네 납시었도다】
	RESULT:1 = 0x33ffcc
ELSE
	;ヨシツネとしての純度を高め、真に迫る、ということで
	RESULTS = 純度
ENDIF
RESULTS:1 = \%
RETURN L_GP

