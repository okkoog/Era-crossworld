;スキル名
@SKILL_NAME_サンダーバード雷撃,ARG
RESULTS = 썬더버드 뇌격

;　명중
@SKILL_HITRATE_サンダーバード雷撃, ARG
RETURN 100

;　威力
@SKILL_POWER_サンダーバード雷撃, ARG
RETURN 250

;　최저공격횟수
@SKILL_MINATTACKNUMBER_サンダーバード雷撃,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_サンダーバード雷撃,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_サンダーバード雷撃, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_サンダーバード雷撃,ARG
RETURN 35

;　相性
@SKILL_TYPE_サンダーバード雷撃,ARG
RETURN GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_サンダーバード雷撃
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_サンダーバード雷撃,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_サンダーバード雷撃,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_サンダーバード雷撃,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_サンダーバード雷撃,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_サンダーバード雷撃,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_サンダーバード雷撃, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_サンダーバード雷撃
RETURN 0

@SKILL_ADDTIONAL_STATE_サンダーバード雷撃,ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_サンダーバード雷撃,ARG
RETURN 6

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_サンダーバード雷撃,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_サンダーバード雷撃,ARG
RETURN 95

;====================================================
;ダメージ発動時
;====================================================
@SKILL_DAMAGE_EFFECT_サンダーバード雷撃, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "명중/회피", -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_サンダーバード雷撃,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_サンダーバード雷撃,ARG
PRINTL 적 1열에 전격 마법 대미지 + 명중/회피 저하. 감전시킬 때도 있다.
PRINTL 선더버드를 소환하여, 가차 없는 뇌격을 쏟아부어 움직임을 둔하게 만든다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_サンダーバード雷撃,ARG
RETURN 1
