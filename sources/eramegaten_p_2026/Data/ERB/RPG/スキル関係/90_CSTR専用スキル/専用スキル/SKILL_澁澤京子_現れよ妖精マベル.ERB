;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_現れよ妖精マベル,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
;真名解放時
IF SKILLGAGE_H_GET(ARG,3904)
	;敵全体複合相性3回攻撃
	CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM

;それ以外
ELSE
	CALL HEAL_FIELD, ARG, ARG:1, SKILL_NUM
ENDIF

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_現れよ妖精マベル,ARG
#DIM USE_CHARA
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

