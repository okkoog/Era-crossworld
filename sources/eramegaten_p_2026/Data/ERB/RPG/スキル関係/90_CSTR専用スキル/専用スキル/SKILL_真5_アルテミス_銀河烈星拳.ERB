@SKILL_CRITICAL_RATE_銀河烈星拳, ARG
RETURN 3

;;　吸収率
;@SKILL_HP_ABSORBER_銀河烈星拳, ARG
;RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_銀河烈星拳,ARG
RETURN 15

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_銀河烈星拳,ARG
RETURN 15

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_銀河烈星拳, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_銀河烈星拳,ARG
RETURN 50

;　相性
;複合相性
@SKILL_TYPE_銀河烈星拳,ARG
RETURN GET_TYPE_NUM("비구"), GET_TYPE_NUM("타격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_銀河烈星拳
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_銀河烈星拳,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_銀河烈星拳,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_銀河烈星拳,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_銀河烈星拳,ARG
RETURN GET_SPHERE_NUM("전체")

;スキルがランダム範囲かどうか
@SKILL_RAND_TARGET_銀河烈星拳,ARG
RETURN 1

