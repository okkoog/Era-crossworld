@SKILL_EFECT_銀河烈星拳,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
;@SKILL_SUCCESSION_TYPE_銀河烈星拳
;RETURN 23
;검격

;속도보정
@SKILL_SPEED_銀河烈星拳, ARG = -1
RETURN -10

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_銀河烈星拳
RETURN 0

;没
;@SKILL_RANK_銀河烈星拳, ARG = -1


