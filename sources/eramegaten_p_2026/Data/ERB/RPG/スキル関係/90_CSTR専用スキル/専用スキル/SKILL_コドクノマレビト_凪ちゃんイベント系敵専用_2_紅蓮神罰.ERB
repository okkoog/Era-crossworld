;====================================================
;○凪ちゃんイベントの敵専用スキル群
;====================================================
;この場合の「紅蓮」は「紅蓮地獄」、「あまりの寒さに肌が裂けて血が花のように咲く」地獄のことを言う。
;====================================================

;スキル名
@SKILL_NAME_凪ちゃんイベント系_2_紅蓮神罰,ARG
	RESULTS = 紅蓮神罰

;　명중
@SKILL_HITRATE_凪ちゃんイベント系_2_紅蓮神罰, ARG
	RETURN 100

;　威力
@SKILL_POWER_凪ちゃんイベント系_2_紅蓮神罰, ARG
	RETURN 420

;クリティカル率
@SKILL_CRITICAL_RATE_凪ちゃんイベント系_2_紅蓮神罰, ARG
	;おまじない
	RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_凪ちゃんイベント系_2_紅蓮神罰,ARG
	RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_凪ちゃんイベント系_2_紅蓮神罰,ARG
	RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_凪ちゃんイベント系_2_紅蓮神罰, ARG
RETURN GET_SKILL_COST_TYPE_NUM("HP")

;　コストの量
@SKILL_COST_凪ちゃんイベント系_2_紅蓮神罰,ARG
	;敵専用スキル群なので消費極少
	RETURN 1

;　相性
@SKILL_TYPE_凪ちゃんイベント系_2_紅蓮神罰,ARG
	RETURN GET_TYPE_NUM("빙결")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_凪ちゃんイベント系_2_紅蓮神罰
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_凪ちゃんイベント系_2_紅蓮神罰,ARG
	;魔法
	RETURN 2

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_凪ちゃんイベント系_2_紅蓮神罰,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_凪ちゃんイベント系_2_紅蓮神罰,ARG
	RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_凪ちゃんイベント系_2_紅蓮神罰,ARG
	;敵全体攻撃
	RETURN 3

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_凪ちゃんイベント系_2_紅蓮神罰,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
;@SKILL_SUCCESSION_TYPE_凪ちゃんイベント系_2_紅蓮神罰,ARG
;RETURN 23
;검격

;속도보정
@SKILL_SPEED_凪ちゃんイベント系_2_紅蓮神罰, ARG = -1
	RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_凪ちゃんイベント系_2_紅蓮神罰
	RETURN 0

;没
;@SKILL_RANK_凪ちゃんイベント系_2_紅蓮神罰, ARG = -1

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_凪ちゃんイベント系_2_紅蓮神罰,ARG
	RETURN GET_STATE_NUM("FREEZE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_凪ちゃんイベント系_2_紅蓮神罰,ARG
	RETURN GET_TYPE_NUM("빙결")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_凪ちゃんイベント系_2_紅蓮神罰,ARG
	RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_凪ちゃんイベント系_2_紅蓮神罰,ARG
	RETURN 50

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_凪ちゃんイベント系_2_紅蓮神罰,ARG,ARG:1,SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM
	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_凪ちゃんイベント系_2_紅蓮神罰,ARG
	PRINTL 핏빛 꽃이 피어나는 신벌.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_凪ちゃんイベント系_2_紅蓮神罰,ARG
RETURN 1
