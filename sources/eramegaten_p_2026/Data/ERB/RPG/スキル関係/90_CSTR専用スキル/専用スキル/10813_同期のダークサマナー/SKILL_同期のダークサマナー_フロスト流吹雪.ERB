;スキル名
@SKILL_NAME_フロスト流吹雪,ARG
RESULTS = 프로스트류 눈보라

;　명중
@SKILL_HITRATE_フロスト流吹雪, ARG
RETURN 100

;　威力
@SKILL_POWER_フロスト流吹雪, ARG
RETURN 250


;　최저공격횟수
@SKILL_MINATTACKNUMBER_フロスト流吹雪,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_フロスト流吹雪,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_フロスト流吹雪, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_フロスト流吹雪,ARG
RETURN 35

;　相性
@SKILL_TYPE_フロスト流吹雪,ARG
RETURN GET_TYPE_NUM("빙결")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_フロスト流吹雪
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_フロスト流吹雪,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_フロスト流吹雪,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_フロスト流吹雪,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_フロスト流吹雪,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_フロスト流吹雪,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_フロスト流吹雪, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_フロスト流吹雪
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_フロスト流吹雪,ARG
RETURN GET_STATE_NUM("FREEZE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_フロスト流吹雪,ARG
RETURN 5


;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_フロスト流吹雪,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_フロスト流吹雪,ARG
RETURN 95

;====================================================
;ダメージ発動時
;====================================================
@SKILL_DAMAGE_EFFECT_フロスト流吹雪, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격", -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_フロスト流吹雪,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_フロスト流吹雪,ARG
PRINTL 적 1열에 빙결 상성의 마법 대미지 + 공격 저하, 동결시킬 때도 있다.
PRINTL 잭 프로스트들을 소환하여 전의를 꺾어버릴 눈보라를 뿜어내게 한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_フロスト流吹雪,ARG
RETURN 1
