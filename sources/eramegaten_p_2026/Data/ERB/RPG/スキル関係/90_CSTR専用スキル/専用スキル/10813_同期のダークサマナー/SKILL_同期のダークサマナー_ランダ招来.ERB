;なくてもいいものはコメントアウトしております
;必要だと思ったらコメントアウトを外して設定してください
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_ランダ招来,ARG
RESULTS = 란다 초래

;　명중
@SKILL_HITRATE_ランダ招来, ARG
RETURN 90

;　威力
@SKILL_POWER_ランダ招来, ARG
RETURN 120

;;クリティカル率
@SKILL_CRITICAL_RATE_ランダ招来, ARG
RETURN 15

