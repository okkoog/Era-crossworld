;RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ランダ招来,ARG
RETURN 3

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ランダ招来,ARG
RETURN 3

