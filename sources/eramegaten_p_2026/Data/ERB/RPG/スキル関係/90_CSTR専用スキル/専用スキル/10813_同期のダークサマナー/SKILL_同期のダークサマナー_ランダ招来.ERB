;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ランダ招来, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ランダ招来,ARG
RETURN 40

;　相性
@SKILL_TYPE_ランダ招来,ARG
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ランダ招来
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ランダ招来,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ランダ招来,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ランダ招来,ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ランダ招来,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_ランダ招来,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_ランダ招来, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ランダ招来
RETURN 0

;没
;@SKILL_RANK_ランダ招来, ARG = -1


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ランダ招来,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)

;　説明文の表示
@SKILL_EXPLAIN_ランダ招来,ARG
PRINTL 적 전열 1열에 검격 상성의 물리 대미지를 3회 입힌다. 후열 사용 가능. 크리티컬하기 쉽다
PRINTL 소환한 마왕 란다와 함께 적진으로 돌진한다.

