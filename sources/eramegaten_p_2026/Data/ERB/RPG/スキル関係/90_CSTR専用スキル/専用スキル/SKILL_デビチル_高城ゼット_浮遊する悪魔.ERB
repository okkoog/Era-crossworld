	RESULTS '= SET_COLOR_TAG(@"深淵魔王化:%TOFULL(TOSTR(PU_SKILLGAGE_D_GET(ARG,"浮遊する悪魔")))%Ｔ", "#dc143c")
ELSE
	RESULTS '= SET_COLOR_TAG(@"覚醒度:{PU_SKILLGAGE_H_GET(ARG,"浮遊する悪魔"),3}％", "#ff4500")
