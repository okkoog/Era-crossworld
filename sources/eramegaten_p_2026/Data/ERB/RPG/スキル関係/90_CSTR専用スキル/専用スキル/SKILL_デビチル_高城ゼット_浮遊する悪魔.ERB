	RESULTS += SET_COLOR_TAG("★", TOSTR(0xdc143c))
	RESULTS += HTML_RECT_SPLIT_BAR(PU_SKILLGAGE_D_GET(ARG, "浮遊する悪魔"), 3, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("赤"), RESULT:1)
	RESULTS:1 = 深淵魔王化
ELSE
	IF PU_SKILLGAGE_H_GET(ARG, "浮遊する悪魔") == 100
		RESULTS += SET_COLOR_TAG("★", TOSTR(0xff4500))
		RESULTS += SET_COLOR_TAG(@"%" Ready", SKILL_EX_DISPLAY_LENS - 2, LEFT%", TOSTR(0xff4500))
		RESULTS:1 = 深淵魔王化
	ELSE
		RESULTS += SET_COLOR_TAG("★", TOSTR(0xff4500))
		RESULTS += HTML_RECT_BAR(PU_SKILLGAGE_H_GET(ARG, "浮遊する悪魔"), 100, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("緑"), RESULT:1)
		RESULTS:1 = 覚醒度
	ENDIF
ENDIF
RETURN 1



