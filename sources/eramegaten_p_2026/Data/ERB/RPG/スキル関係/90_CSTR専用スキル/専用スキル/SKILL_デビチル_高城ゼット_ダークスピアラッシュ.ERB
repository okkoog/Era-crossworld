;====================================================
;○高城ゼット専用スキル『ダークスピアラッシュ』
;====================================================
;漫画版でヴァスキを大変なことにした攻撃。
;重力・呪殺相性複合の乱舞系の技
;キングストームよりは弱い感じで
;====================================================
;専用スキル用のテンプレート
;「専用技名」を別の名前に置き換えてください

;アクティブスキルに必須なものはそのままにしており
;なくてもいいものはコメントアウトしております
;必要だと思ったらコメントアウトを外して設定してください
;スキルのテンプレートになっています
;====================================================

;スキル名
@SKILL_NAME_ダークスピアラッシュ,ARG
RESULTS = 다크 스피어 러시

;　명중
@SKILL_HITRATE_ダークスピアラッシュ, ARG
	RETURN 100

;　威力
@SKILL_POWER_ダークスピアラッシュ, ARG
	RETURN 160

;クリティカル率
@SKILL_CRITICAL_RATE_ダークスピアラッシュ, ARG
	RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ダークスピアラッシュ,ARG
	;CSTR専用なのでちょっと優遇
	RETURN 4

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ダークスピアラッシュ,ARG
	RETURN 8

;一体辺りの最大ＨＩＴ数
;※ランダム攻撃系に使う
@SKILL_MAXATK_PER_ダークスピアラッシュ,ARG
	;乱舞系に従う。それでも威力は480なので専用業として十分とみる
	RETURN 3

;一体辺りの最低ＨＩＴ数
;※ランダム攻撃系に使う
@SKILL_MINATK_PER_ダークスピアラッシュ,ARG
	RETURN 3

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ダークスピアラッシュ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ダークスピアラッシュ,ARG
	RETURN 35

;　相性
;複合相性
;重力・呪殺
@SKILL_TYPE_ダークスピアラッシュ,ARG
	RETURN GET_TYPE_NUM("중력"), GET_TYPE_NUM("주살")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ダークスピアラッシュ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ダークスピアラッシュ,ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ダークスピアラッシュ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ダークスピアラッシュ,ARG
	RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ダークスピアラッシュ,ARG
RETURN GET_SPHERE_NUM("전체")

;スキルがランダム範囲かどうか
@SKILL_RAND_TARGET_ダークスピアラッシュ,ARG
	RETURN 1

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ダークスピアラッシュ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
;@SKILL_SUCCESSION_TYPE_ダークスピアラッシュ
;RETURN 23
;검격

;속도보정
@SKILL_SPEED_ダークスピアラッシュ, ARG = -1
	RETURN 10

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ダークスピアラッシュ
	RETURN 0

;没
;@SKILL_RANK_ダークスピアラッシュ, ARG = -1

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_ダークスピアラッシュ,ARG
	RETURN 0

;추가효과상성
@SKILL_ADDTIONAL_TYPE_ダークスピアラッシュ,ARG
	RETURN 0

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_ダークスピアラッシュ,ARG
	RETURN 0

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_ダークスピアラッシュ,ARG
	RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ダークスピアラッシュ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;ランダム攻撃
CALL ATTACK_RAND, ARG, ARG:1, SKILL_NUM



;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_ダークスピアラッシュ,ARG
PRINTL 적 전체에서 무작위로 중위력의 중력·주살 복합 물리 공격을 최대 8회 행한다.
PRINTL  
PRINTL 어둠의 창으로 무수히 찔러 무너뜨리는 공격.



;使用条件
@SKILL_SPECIAL_ACTIONABLE_ダークスピアラッシュ,ARG
RETURN 1
