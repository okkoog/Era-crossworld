;====================================================
@SKILL_ATTACKTYPE_オルギア改, ARG
RETURN GET_攻撃タイプ_NUM("魔法")

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_オルギア改, ARG = -1, ARG:1 = -1
RETURN 0


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_オルギア改,ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　사거리
@SKILL_RANGE_オルギア改,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_オルギア改,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_オルギア改,ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

;속도보정
@SKILL_SPEED_オルギア改, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_オルギア改
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_オルギア改,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;====================================================
;追加コマンド(一番下)
;====================================================
@SKILL_SPECIAL_COMMAND_オルギア改,ARG,LOCAL,SKILL_NUM
#DIM SKILL_NUM
#DIM ORGY_COM_NUM
#LOCALSIZE 1
ORGY_COM_NUM = 13
;元のＯＲＧＹを上書きして呼ばせる
REPEAT LOCAL
	SIF C:(COUNT+1) == ORGY_COM_NUM
		BREAK
REND
C:COUNT = 10000 + SKILL_NUM
;上書き対象がなかったら追加。あるはずだけど
IF COUNT == LOCAL
	PRINTFORML [{LOCAL}] ＯＲＧＹ
	LOCAL++
ENDIF
RETURN LOCAL

;====================================================
;コマンド実行
;====================================================
@INPUT_COM_オルギア改,ARG
PRINTL 오르기아를 발동합니다. 괜찮겠습니까?
PRINTL [0] 네
PRINTL [1] 아니오
ONEINPUTS 0
SIF RESULTS == "1"
	RETURN -1

CALL INPUT_COM_14556, ARG
RETURN RESULT
;;-1 再びコマンド選択へ
;; 1 キャラ選択へ

;　説明文の表示
@SKILL_EXPLAIN_オルギア改,ARG
PRINTL 오르기아 개
PRINTL 커맨드 선택에서 ORGY를 선택하면 발동. 발동 시 자신의 배드 스테이터스를 해제한다.
PRINTL 수 턴 동안 사용자의 전투 능력이 향상되는 대신 행동을 선택할 수 없게 된다.
;PRINTL 効果中はスキルを使用する際の消費コストが通常より少なくなる。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_オルギア改,ARG
RETURN 0
