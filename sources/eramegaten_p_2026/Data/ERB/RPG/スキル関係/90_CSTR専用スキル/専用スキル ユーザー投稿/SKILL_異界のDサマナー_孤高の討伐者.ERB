;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_孤高の討伐者,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"孤高の討伐者")
CALL SKILLGAGE_D_SET,ARG,SKILL_NUM,6
;決闘をする敵の番号を保存
CALL SKILLGAGE_H_SET,ARG,SKILL_NUM, POS(ARG:1)
CALL SET_C_BTL_EFFECT_SINGLE, ARG, POS(ARG:1), "孤高の討伐者", 0, "決闘を申し込んだ！"
;====================================================
;実行内容ここまで
;====================================================

@SKILL_BATTLE_MAIN_TOOLTIP_孤高の討伐者, ARG, ARG:1
#DIM DYNAMIC L_TARGET
SIF PU_SKILLGAGE_D_GET(ARG,"孤高の討伐者") <= 0
	RETURN 0
L_TARGET = PU_SKILLGAGE_H_GET(ARG, "孤高の討伐者")
SIF L_TARGET < 0
	RETURN 0
SIF !IS_TARGET_ABLE(L_TARGET)
	RETURN 0
RESULTS = □고고한 토벌자
RESULTS:1 '= @"TARGET：[{CPOS(L_TARGET)}] %CALLNAME:L_TARGET%　残り:{PU_SKILLGAGE_D_GET(ARG,"孤高の討伐者")}ターン"


;　説明文の表示
@SKILL_EXPLAIN_孤高の討伐者,ARG
PRINTL 지정한 적에게 결투를 신청하여, 5턴 동안 주는 데미지가 50% 오른다.
PRINTL 그러나 지정한 적 이외의 적으로부터 받는 데미지도 50% 올라버린다.
PRINTL 이계의 다크 서머너의 전용기

@SKILL_EXPLAIN_TOOLTIP_孤高の討伐者, ARG
RESULTS:0 = 지정한 적에게 결투를 신청하여, 5턴 동안 주는 데미지가 50% 오른다.
RESULTS:1 = 그러나 지정한 적 이외의 적으로부터 받는 데미지도 50% 올라버린다.
