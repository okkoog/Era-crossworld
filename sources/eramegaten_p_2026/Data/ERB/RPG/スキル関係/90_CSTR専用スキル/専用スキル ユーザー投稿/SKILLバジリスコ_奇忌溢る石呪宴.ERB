;====================================================
;トリガー発動条件
;
;詳しい仕様については資料フォルダの解説を参照してください
;====================================================
@SKILL_TRIGGER_ACTIONABLE_奇忌溢る石呪宴,ARG,ARG:1
#DIM 発動回数
#DIM 同時発生
#DIM 発動履歴, 20
#DIM LCOUNT
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
SIF !CHARANUM_CHECK(ARG:1)
	RETURN 0
SIF !INRANGE(CPOS(ARG:1), 1, 16)
	RETURN 0
SIF !GET_CREC_ACT(-1, ARG:1, "BADSTATE", "STONE")
	RETURN 0
;一行動につき一回だけ発動
SIF !同時発生
	同時発生 = GET_CREC_ACT_SUM(-1, "적아군전체", "BADSTATE", "STONE")
SIF 同時発生-- != 1
	RETURN 0

発動回数 = PU_SKILLGAGE_H_GET(ARG, "奇忌溢る石呪宴")
SIF 発動回数 >= 20
	RETURN 0
;一度発動したキャラに対しては発動しない
FOR LCOUNT, 0, 発動回数
	SIF 発動履歴:LCOUNT == ARG:1
		RETURN 0
NEXT
CALL PU_SKILLGAGE_H_SET, ARG, "奇忌溢る石呪宴", 発動回数+1
発動履歴:発動回数 = ARG:1
RETURN 1, CPOS(ARG)

