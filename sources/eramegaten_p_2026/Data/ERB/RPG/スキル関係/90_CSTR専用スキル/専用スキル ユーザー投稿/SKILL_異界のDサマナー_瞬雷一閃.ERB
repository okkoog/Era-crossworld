;専用スキル用のテンプレート
;「瞬雷一閃」を別の名前に置き換えてください

;アクティブスキルに必須なものはそのままにしており
;なくてもいいものはコメントアウトしております
;必要だと思ったらコメントアウトを外して設定してください
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_瞬雷一閃,ARG
RESULTS = 瞬雷一閃

;　명중
@SKILL_HITRATE_瞬雷一閃, ARG
RETURN 150

;　威力
@SKILL_POWER_瞬雷一閃, ARG
IF FLAG:확산플래그
	SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV3")
		RETURN 300
	SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV2")
		RETURN 240
	SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV1")
		RETURN 160
	RETURN 90
ELSE
	SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV3")
		RETURN 380
	SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV2")
		RETURN 290
	SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV1")
		RETURN 200
	RETURN 140
ENDIF

;;クリティカル率
@SKILL_CRITICAL_RATE_瞬雷一閃, ARG
RETURN 5

;;　吸収率
;@SKILL_HP_ABSORBER_瞬雷一閃, ARG
