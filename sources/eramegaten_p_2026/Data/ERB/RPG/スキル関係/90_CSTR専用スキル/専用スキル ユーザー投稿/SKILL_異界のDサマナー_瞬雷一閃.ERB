RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_瞬雷一閃,ARG
SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV3")
	RETURN 32
SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV2")
	RETURN 24
SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV1")
	RETURN 16
RETURN 10

