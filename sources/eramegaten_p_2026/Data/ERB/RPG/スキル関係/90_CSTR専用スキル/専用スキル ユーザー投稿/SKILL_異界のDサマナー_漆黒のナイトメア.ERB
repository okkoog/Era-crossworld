;専用スキル用のテンプレート
;「漆黒のナイトメア」を別の名前に置き換えてください

;アクティブスキルに必須なものはそのままにしており
;なくてもいいものはコメントアウトしております
;必要だと思ったらコメントアウトを外して設定してください
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_漆黒のナイトメア,ARG
RESULTS = 칠흑의 나이트메어

;　명중
@SKILL_HITRATE_漆黒のナイトメア, ARG
RETURN 100

;　威力
@SKILL_POWER_漆黒のナイトメア, ARG
SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV3")
	RETURN 430
SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV2")
	RETURN 360
SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV1")
	RETURN 280
RETURN 240

;;クリティカル率
@SKILL_CRITICAL_RATE_漆黒のナイトメア, ARG
RETURN 5

;;　吸収率
;@SKILL_HP_ABSORBER_漆黒のナイトメア, ARG
;RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_漆黒のナイトメア,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_漆黒のナイトメア,ARG
RETURN 1

;;一体辺りの最大ＨＩＴ数
;;※ランダム攻撃系に使う
@SKILL_MAXATK_PER_漆黒のナイトメア,ARG
RETURN 1

;;一体辺りの最低ＨＩＴ数
;;※ランダム攻撃系に使う
@SKILL_MINATK_PER_漆黒のナイトメア,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_漆黒のナイトメア, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_漆黒のナイトメア,ARG
SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV3")
	RETURN 20
SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV2")
	RETURN 15
SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV1")
	RETURN 10
RETURN 7

;　相性
@SKILL_TYPE_漆黒のナイトメア,ARG
RETURN GET_TYPE_NUM("검격")


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_漆黒のナイトメア
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_漆黒のナイトメア,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;====================================================
;攻撃手段
;1.物理攻撃 2.魔法攻撃 3.총공격 4.アイテム攻撃(ダメージ計算時の依存ステータスに関わる)
;関数がない場合はダメージタイプとおなじになる
;====================================================
@SKILL_ATTACKTYPE_漆黒のナイトメア, ARG
RETURN GET_攻撃タイプ_NUM("物理")

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_漆黒のナイトメア, ARG = -1, ARG:1 = -1
RETURN 0


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_漆黒のナイトメア,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_漆黒のナイトメア,ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_漆黒のナイトメア,ARG
RETURN GET_SPHERE_NUM("세로열")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_漆黒のナイトメア,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_漆黒のナイトメア
RETURN GET_SUCCESSION_NUM("검격")
;검격

;속도보정
@SKILL_SPEED_漆黒のナイトメア, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_漆黒のナイトメア
RETURN 0

@SKILL_ADDTIONAL_STATE_漆黒のナイトメア,ARG
RETURN GET_STATE_NUM("PANIC")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_漆黒のナイトメア,ARG
RETURN GET_TYPE_NUM("정신")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_漆黒のナイトメア,ARG
RETURN 20

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_漆黒のナイトメア,ARG
RETURN 75

;スキルランク
;スキルの習得時の必要ＭＡＧの算出に主に用いられる
;また、習得・所持スキルはこのランクの5倍のレベルを基準として設定する。
@SKILL_RANK_漆黒のナイトメア, ARG = -1
RETURN 4


;拡散スキルの拡散距離定義関数(このような感じで数値を増やすことで増えていく)
;1 　　　　　2 　　　　
;□□◆□□　□◆◆◆□
;□◆★◆□　◆◆★◆◆
@SKILL_SPREAD_漆黒のナイトメア,ARG
