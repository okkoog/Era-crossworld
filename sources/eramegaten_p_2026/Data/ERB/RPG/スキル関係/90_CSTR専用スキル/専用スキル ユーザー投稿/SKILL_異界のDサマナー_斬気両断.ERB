;　최대공격횟수
@SKILL_MAXATTACKNUMBER_斬気両断,ARG
RETURN 1

;;一体辺りの最大ＨＩＴ数
;;※ランダム攻撃系に使う
@SKILL_MAXATK_PER_斬気両断,ARG
RETURN 1

;;一体辺りの最低ＨＩＴ数
;;※ランダム攻撃系に使う
@SKILL_MINATK_PER_斬気両断,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
