;専用スキル用のテンプレート
;「斬気両断」を別の名前に置き換えてください

;アクティブスキルに必須なものはそのままにしており
;なくてもいいものはコメントアウトしております
;必要だと思ったらコメントアウトを外して設定してください
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_斬気両断,ARG
IF FLAG:총공격중
	RESULTS = 참기양단·되돌려치기
ELSE
	RESULTS = 斬気両断
ENDIF

;　명중
@SKILL_HITRATE_斬気両断, ARG
RETURN 100

;　威力
@SKILL_POWER_斬気両断, ARG
IF FLAG:총공격중
	SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV3")
		RETURN 180
	SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV2")
		RETURN 144
	SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV1")
		RETURN 96
	RETURN 56
ELSE
	SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV3")
		RETURN 450
	SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV2")
		RETURN 360
	SIF HAVE_PU_SKILL(ARG, "異世界の放浪者LV1")
		RETURN 240
	RETURN 140
ENDIF

;;クリティカル率
@SKILL_CRITICAL_RATE_斬気両断, ARG
RETURN 10

;;　吸収率
