;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_斬気両断
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_斬気両断,ARG
RETURN GET_ダメージタイプ_NUM("物理")
;====================================================
;攻撃手段
;1.物理攻撃 2.魔法攻撃 3.총공격 4.アイテム攻撃(ダメージ計算時の依存ステータスに関わる)
;関数がない場合はダメージタイプとおなじになる
;====================================================
@SKILL_ATTACKTYPE_斬気両断, ARG
RETURN GET_攻撃タイプ_NUM("物理")

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_斬気両断, ARG = -1, ARG:1 = -1
RETURN 0


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_斬気両断,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_斬気両断,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_斬気両断,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_斬気両断,ARG
