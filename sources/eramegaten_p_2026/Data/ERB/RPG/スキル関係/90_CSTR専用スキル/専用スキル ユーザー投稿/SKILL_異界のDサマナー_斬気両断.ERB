;□◆★◆□　◆◆★◆◆
;@SKILL_SPREAD_斬気両断,ARG
;RETURN 0

;====================================================
;トリガー発動条件
;
;詳しい仕様については資料フォルダの解説を参照してください
;====================================================
@SKILL_TRIGGER_ACTIONABLE_斬気両断,ARG,ARG:1
;自分じゃなければNG
SIF FLAG:행동순1 != ARG
	RETURN 0
SIF CFLAG:ARG:입력행동 != PU_SKILLNUM_GET(ARG, "斬気両断")
	RETURN 0
SIF !GET_CREC_ACT(ARG, ARG:1, "CRT/WEAK")
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
SIF RESULT != 1 || CFLAG:ARG:타겟 < 1
	RETURN 0
SIF ARG:1 < 0 || GET_STATE(CFLAG:(ARG:1):상태이상) == "DYING"
	RETURN 0
RETURN 1, CFLAG:ARG:타겟

