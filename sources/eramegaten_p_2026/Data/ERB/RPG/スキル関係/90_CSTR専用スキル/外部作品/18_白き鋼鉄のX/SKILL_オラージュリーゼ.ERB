;風の舞をスキルチェンジで作ろうと思ったけど競合したら嫌だなぁって思って作りました
;けどどうせ新造するなら疾風の乱舞っぽくすればいいかなって思いました

;スキル名
@SKILL_NAME_オラージュリーゼ, ARG
RESULTS = 오라주 리제

;　명중
@SKILL_HITRATE_オラージュリーゼ, ARG
;イプシロンは攻撃数が多いのでsage
IF SKILL_CHANGE(ARG, [[キャラ:입실론_X2]]) || SKILL_CHANGE(ARG, [[キャラ:창조주_X2]])
	RETURN 90
ELSE
	RETURN 95
ENDIF

;　威力
@SKILL_POWER_オラージュリーゼ, ARG
IF SKILL_CHANGE(ARG, [[キャラ:입실론_X2]]) || SKILL_CHANGE(ARG, [[キャラ:창조주_X2]])
	RETURN 200
ELSE
	RETURN 240
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_オラージュリーゼ, ARG
IF SKILL_CHANGE(ARG, [[キャラ:입실론_X2]]) || SKILL_CHANGE(ARG, [[キャラ:창조주_X2]])
	RETURN 5
ELSE
	RETURN 2
ENDIF

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_オラージュリーゼ, ARG
IF SKILL_CHANGE(ARG, [[キャラ:입실론_X2]]) || SKILL_CHANGE(ARG, [[キャラ:창조주_X2]])
	RETURN 5
ELSE
	RETURN 2
ENDIF

;一体辺りの最大ＨＩＴ数
;※ランダム攻撃系に使う
@SKILL_MAXATK_PER_オラージュリーゼ, ARG
RETURN 2

;一体辺りの最低ＨＩＴ数
;※ランダム攻撃系に使う
@SKILL_MINATK_PER_オラージュリーゼ, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_オラージュリーゼ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_オラージュリーゼ, ARG
RETURN 22

;　相性
@SKILL_TYPE_オラージュリーゼ, ARG
RETURN GET_TYPE_NUM("질풍")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_オラージュリーゼ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_オラージュリーゼ, ARG
IF SKILL_CHANGE(ARG, [[キャラ:입실론_X2]]) || SKILL_CHANGE(ARG, [[キャラ:창조주_X2]])
	RETURN 1
ELSE
	RETURN 2
ENDIF

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_オラージュリーゼ, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_オラージュリーゼ, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_オラージュリーゼ, ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_オラージュリーゼ, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_オラージュリーゼ, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_オラージュリーゼ
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_オラージュリーゼ, ARG, ARG:1,SKILL_NUM
#DIM SKILL_NUM

CALL ATTACK_RAND, ARG, ARG:1, SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_オラージュリーゼ, ARG
IF SKILL_CHANGE(ARG, [[キャラ:입실론_X2]]) || SKILL_CHANGE(ARG, [[キャラ:창조주_X2]])
	PRINTL 특수 프로펠러를 탑재한 워커 베스파의 능력을 복사한 재현 병장.
	PRINTL 상대를 향해 유도되는 질풍탄을 발사한다.
	PRINTL 적 전체 랜덤으로 질풍 상성으로 5회 중데미지를 준다.
ELSE
	PRINTL 상대를 향해 유도되는 질풍탄을 발사한다.
	PRINTL 적 전체 랜덤으로 질풍 상성으로 2회 중데미지를 준다.
ENDIF

;使用条件
@SKILL_SPECIAL_ACTIONABLE_オラージュリーゼ, ARG
RETURN 1

