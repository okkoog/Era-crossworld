;マジックエンハンス。　普遍的な魔法戦闘補助技能？
;短期間だけ魔法ダメージUP。

;スキル名
@SKILL_NAME_KE_マジックエンハンス,ARG
RESULTS = 매직 인핸스

;　명중
@SKILL_HITRATE_KE_マジックエンハンス, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_マジックエンハンス, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_マジックエンハンス,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_マジックエンハンス,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_マジックエンハンス, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_KE_マジックエンハンス,ARG
RESULTS = %" 15ＴＰ"%
RETURN 0

;　相性
@SKILL_TYPE_KE_マジックエンハンス,ARG
;RETURN GET_TYPE_NUM("검격")
RETURN 0

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_マジックエンハンス
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_マジックエンハンス,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_マジックエンハンス,ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　사거리
@SKILL_RANGE_KE_マジックエンハンス,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_マジックエンハンス,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_マジックエンハンス,ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;속도보정
@SKILL_SPEED_KE_マジックエンハンス, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_マジックエンハンス
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_マジックエンハンス,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

IF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"KE_マジックエンハンス")) == 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") >= 15
	;ゲージ再回収できる様に起動前にTP15消費。
	CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 15, "-="
	PRINTFORML %CALLNAME:ARG%의 마법 공격 데미지량이 상승!
	CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"KE_マジックエンハンス"),3
ELSE
	PRINTFORML 매직 인핸스　　＞　　효과가 없었다!
ENDIF

;====================================================
;実行内容ここまで
;====================================================


@SKILL_PASSIVE_BTL_EFFECT_KE_マジックエンハンス, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

IF SKILLGAGE_D_GET(L_P,PU_SKILLNUM_GET(L_P,"KE_マジックエンハンス")) > 0
	;自分が攻撃側
	IF L_P == L_ACTOR
		SELECTCASE ARGS
			;気合などと加算の枠。他に加減要素がなければ100%±X%になる
			CASE "ダメージ補正加算"
				IF L_ダメージタイプ == "魔法"
					RETURN 50
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 0

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_KE_マジックエンハンス,ARG
IF PU_SKILLGAGE_D_GET(ARG,"KE_マジックエンハンス") != 0
	RESULTS = 매직 인핸스:{PU_SKILLGAGE_D_GET(ARG,"KE_マジックエンハンス")}T
	RETURN 3
ENDIF

;　説明文の表示
@SKILL_EXPLAIN_KE_マジックエンハンス,ARG
PRINTL 『매직 인핸스』
PRINTL 사용 후 3턴 동안 주는 마법 데미지량을 ＋50% 한다.
PRINTL 이 효과는 콘센트레이트 등의 데미지 증가 플래그와 『합산』 관계이다. 효과 발휘 중에는 재사용 불가.
PRINTL 
PRINTL TP를 소비하여 단기간 마법 공격 능력을 크게 올리는 전투 보조 기능(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_マジックエンハンス,ARG
;効果発揮中は使用不可能
SIF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"KE_マジックエンハンス")) > 0
	RETURN 0
;TPが足りないと使用不可能
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 15
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_マジックエンハンス, ARG
RESULTS:0 = 사용 후 3턴 동안 주는 마법 데미지량을 ＋50% 한다.
RESULTS:1 = 이 효과는 콘센트레이트 등의 데미지 증가 플래그와 『합산』 관계이다. 효과 발휘 중에는 재사용 불가.
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 15
	RESULTS:1 = %RESULTS:1%(不足)
