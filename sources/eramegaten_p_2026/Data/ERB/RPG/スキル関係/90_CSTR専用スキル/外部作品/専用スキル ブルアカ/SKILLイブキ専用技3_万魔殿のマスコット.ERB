;====================================================
;トリガー発動条件
;
;詳しい仕様については資料フォルダの解説を参照してください
;====================================================
@SKILL_TRIGGER_ACTIONABLE_万魔殿のマスコット,ARG,ARG:1
#DIM LCOUNT
;自分自身の行動でないと誘発しない
SIF ARG != FLAG:행동순1
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;行動しているキャラが支援スキルをつかってないとダメ
CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", CFLAG:(FLAG:행동순1):입력행동, FLAG:행동순1
SIF GET_SUCCESSION(RESULT) != "지원"
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_TARGET", CFLAG:(FLAG:행동순1):입력행동, FLAG:행동순1
SIF RESULT != 2
	RETURN 0
RETURN 1, CPOS(ARG)

