;スキル名
@SKILL_NAME_おバカ消失魔法,ARG
RESULTS = 바보 소멸 마법
SIF TFLAG:전투턴진행중
	TSTR:스킬메시지행동자 '= "ドリシラ & アナステラ"

;　명중
@SKILL_HITRATE_おバカ消失魔法, ARG
RETURN 100

;　威力
@SKILL_POWER_おバカ消失魔法, ARG
SIF ARG < 0
	RETURN 40
CALL GET_SKILL_POWER_おバカ消失魔法(GET_ROLE_CFLAG_TAKEOVER(ARG, "特殊スキルランク"))
RETURN RESULT

@GET_SKILL_POWER_おバカ消失魔法, ARG
SELECTCASE ARG
	CASE 15
		RETURN 220
	CASE 11 TO 14
		RETURN 150 + (ARG - 10) * 8
	CASE 10
		RETURN 180
	CASE 2 TO 9
		RETURN 30 + 15 * ARG
	CASE 0, 1
		RETURN 45
	CASEELSE
		RETURN 0
ENDSELECT

@SKILL_CRITICAL_RATE_おバカ消失魔法, ARG
RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_おバカ消失魔法,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_おバカ消失魔法,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_おバカ消失魔法, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_おバカ消失魔法,ARG
SIF ARG < 0
	RETURN 8
CALL GET_SKILL_COST_おバカ消失魔法(GET_ROLE_CFLAG_TAKEOVER(ARG, "特殊スキルランク"))
RETURN RESULT

;　コストの量
@GET_SKILL_COST_おバカ消失魔法,ARG
SELECTCASE ARG
	CASE 15
		RETURN 60
	CASE 11 TO 14
		RETURN 35 + (ARG - 10) * 5
	CASE 10
		RETURN 35
	CASE 0, 1
		RETURN 8
	CASEELSE
		RETURN 5 + ARG * 3
ENDSELECT

;　相性
;複合相性
@SKILL_TYPE_おバカ消失魔法,ARG
RETURN GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_おバカ消失魔法
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_おバカ消失魔法,ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_おバカ消失魔法,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_おバカ消失魔法,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_おバカ消失魔法,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_おバカ消失魔法,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_おバカ消失魔法, ARG = -1
SIF ARG >= 0 && HAVE_PU_SKILL(ARG, "リードダンサー×2")
	RETURN 20
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_おバカ消失魔法, ARG = -1
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_おバカ消失魔法,ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_おバカ消失魔法,ARG
RETURN 6

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_おバカ消失魔法,ARG
SIF ARG >= 0 && HAVE_PU_SKILL(ARG, "メイド長の実力")
	RETURN 40
RETURN 20

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_おバカ消失魔法,ARG
RETURN 95
;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_おバカ消失魔法, ARG = -1, ARG:1 = -1
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "完璧主義のメイド長")
	RETURN 0, 4
ELSE
	RETURN 0, 0
ENDIF

;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_おバカ消失魔法, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "攻撃・魔法威力・防御・魔法効果・命中・回避", -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_おバカ消失魔法,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM
CALL ADD_DECIBEL_PTS, ARG, -1500

;　説明文の表示
@SKILL_EXPLAIN_おバカ消失魔法,ARG
PRINTL 【특수 강화】【리나 전용 스킬】
PRINTL 데시벨 1500pts를 소비하여 발동한다.
PRINTL 적 단체에 전격 상성의 소데미지를 주고, 저확률로 SHOCK을 부여한다.
PRINTL 공격 성공 시 대상의 모든 능력을 저하시킨다.

@ENHANCE_SKILL_EXPLAIN_おバカ消失魔法,ARG
RESULTS '= "敵単体に電撃相性の小ダメージを与え、低確率でSHOCKを付着する。" + "<br>"
RESULTS += "攻撃成功時に対象の全ての能力を低下させる。" + "<br>"

;使用条件
@SKILL_SPECIAL_ACTIONABLE_おバカ消失魔法,ARG
RESULTS = 요구: 데시벨 1500pts
SIF GET_ROLE_CFLAG_DUNGEON(ARG,"デシベル値") < 1500
	RETURN 0
RETURN 1

@BASE_DECIBEL_PTS_おバカ消失魔法, ARG
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_おバカ消失魔法, ARG = -1
RETURN 10

@SKILL_TAG_おバカ消失魔法
RESULTS = 젠제로 특수 스킬
