;白銀の城の火吹炉専用技
;白銀の爆炎		威力390・コスト55・貫通ランク2
;메기도라온		威力420・コスト60
;
;スキル名
@SKILL_NAME_白銀の爆炎,ARG
RESULTS = 백은의 폭염

;　명중
@SKILL_HITRATE_白銀の爆炎, ARG
RETURN 90

;　威力
@SKILL_POWER_白銀の爆炎, ARG
RETURN 390


;　최저공격횟수
@SKILL_MINATTACKNUMBER_白銀の爆炎,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_白銀の爆炎,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_白銀の爆炎, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_白銀の爆炎,ARG
RETURN 55

;　相性
;複合相性
@SKILL_TYPE_白銀の爆炎,ARG
RETURN GET_TYPE_NUM("화염")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_白銀の爆炎
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_白銀の爆炎,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_白銀の爆炎,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_白銀の爆炎,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_白銀の爆炎,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_白銀の爆炎,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_白銀の爆炎, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_白銀の爆炎
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_白銀の爆炎
RETURN GET_SUCCESSION_NUM("화염")

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_白銀の爆炎, ARG = -1, ARG:1 = -1
RETURN 2

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_白銀の爆炎,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_白銀の爆炎,ARG
PRINTL 적 전체에 『화염』 속성의 마법 특대 데미지.
PRINTL 이 공격에 의한 데미지는 화염 무효와 화염 내성을 관통한다.
PRINTL 백은 성의 화로(스토피)의 필살기.

@SKILL_EXPLAIN_TOOLTIP_白銀の爆炎, ARG
RESULTS:0 = 적 전체에 『화염』 속성의 마법 특대 데미지.
RESULTS:1 = 이 공격에 의한 데미지는 화염 무효와 화염 내성을 관통한다.
RESULTS:2 = 白銀の城の火吹炉の必殺技。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_白銀の爆炎,ARG
RETURN 1

;スキル変化用ランク
@SKILL_RANK_白銀の爆炎, ARG = -1
RETURN 15

