;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_コスモリアクター,ARG,ARG:1
#DIM SKILL_NUM
SIF ARG != FLAG:행동순1
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
SIF RESULT != 1 || CFLAG:ARG:타겟 < 1
	RETURN 0
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_コスモリアクター,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL SKILL_SET_カジャンダ, ARG, ARG, "크리티컬", 1, "단체", "NOMES"
;CFLAG:ARG:크리티컬강화 = MIN(9, CFLAG:ARG:크리티컬강화 + 1)
PRINTFORMW %CALLNAME:ARG%의 크리티컬률이 조금 올랐다!

