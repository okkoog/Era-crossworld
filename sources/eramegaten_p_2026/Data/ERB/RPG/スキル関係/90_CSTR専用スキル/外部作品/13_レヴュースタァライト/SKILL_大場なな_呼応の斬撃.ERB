@SKILL_SWITCHING_呼応の斬撃, ARG = -1
#FUNCTION
IF ARG < 0
	RESULTS_F '= "呼応の斬撃"
ELSE
	IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
		RESULTS_F '= "再生讃美曲"
	ELSE
		RESULTS_F '= "呼応の斬撃"
	ENDIF
ENDIF
