;アルトアイゼン・ナハト専用スキル。
;一列飛具物理、威力300、MP18、ランク9

;スキル名
@SKILL_NAME_Ｓ・クレイモア,ARG
RESULTS = S·클레이모어

;　명중
@SKILL_HITRATE_Ｓ・クレイモア, ARG
RETURN 100

;　威力
@SKILL_POWER_Ｓ・クレイモア, ARG
RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_Ｓ・クレイモア,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_Ｓ・クレイモア,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_Ｓ・クレイモア, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_Ｓ・クレイモア,ARG
RETURN 18

;　相性
@SKILL_TYPE_Ｓ・クレイモア,ARG
RETURN GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_Ｓ・クレイモア
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_Ｓ・クレイモア,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_Ｓ・クレイモア,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_Ｓ・クレイモア,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_Ｓ・クレイモア,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_Ｓ・クレイモア,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_Ｓ・クレイモア, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_Ｓ・クレイモア
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_Ｓ・クレイモア
RETURN GET_SUCCESSION_NUM("비구")
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_Ｓ・クレイモア,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;列攻撃
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_Ｓ・クレイモア,ARG
PRINTL 왼팔 실드에 장착된 대량의 베어링 탄환을 난사한다.
PRINTL 정식 명칭 <실드 클레이모어>
PRINTL 적 1열에 비구 상성의 물리 대데미지.

@SKILL_EXPLAIN_TOOLTIP_Ｓ・クレイモア, ARG
RESULTS:0 = 왼팔 실드에 장착된 대량의 베어링 탄환을 난사한다.
RESULTS:1 = 정식 명칭 <실드 클레이모어>
RESULTS:2 = 敵一列に飛具相性の物理大ダメージ。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_Ｓ・クレイモア,ARG
RETURN 1

;スキル変化用ランク
@SKILL_RANK_Ｓ・クレイモア, ARG = -1
RETURN 9
