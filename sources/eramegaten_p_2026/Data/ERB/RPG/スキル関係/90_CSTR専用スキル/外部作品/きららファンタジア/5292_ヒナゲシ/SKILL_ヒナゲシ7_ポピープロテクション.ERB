@SKILL_HITRATE_ポピープロテクション, ARG
RETURN 100

;　威力
@SKILL_POWER_ポピープロテクション, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ポピープロテクション,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ポピープロテクション,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ポピープロテクション, ARG
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_ポピープロテクション,ARG
RETURN 30

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ポピープロテクション
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ポピープロテクション,ARG
RETURN 0

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ポピープロテクション,ARG
RETURN 2

@SKILL_RANK_ポピープロテクション, ARG = -1
RETURN 10

;　사거리
@SKILL_RANGE_ポピープロテクション,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ポピープロテクション,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_ポピープロテクション,ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;속도보정
@SKILL_SPEED_ポピープロテクション, ARG = -1
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ポピープロテクション,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
IF (MAXBASE:POS(ARG:1):ＨＰ/5) >= (BASE:ARG:LV * 10)
	CALL SKILL_SET_HPバリア, POS(ARG:1), MAXBASE:POS(ARG:1):ＨＰ/5, "ポピープロテクション",
ELSE
	CALL SKILL_SET_HPバリア, POS(ARG:1), MAXBASE:ARG:LV * 10, "ポピープロテクション",
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_ポピープロテクション,ARG
PRINTL 아군 단체에 데미지를 흡수하는 배리어를 부여한다.
PRINTL 흡수량은 (사용자의 레벨 × 10) 혹은 (대상의 최대 HP의 20%) 중 많은 쪽이 된다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ポピープロテクション,ARG
