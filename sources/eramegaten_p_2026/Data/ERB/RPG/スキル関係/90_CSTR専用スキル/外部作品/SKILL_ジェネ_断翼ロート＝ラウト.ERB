;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_断翼ロート＝ラウト,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM


IF CFLAG:ARG:공격강화 == 32
	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
	CFLAG:ARG:気合フラグ = 1
	PRINTFORML %CALLNAME:ARG% 은(는) 다음 공격에 대비해 힘을 모았다!
ELSE
	;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 4)
	;PRINTFORML %CALLNAME:ARG%の攻撃力が上がった！
	CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 4, "단체", "NOWAIT"
	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
ENDIF

;CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
