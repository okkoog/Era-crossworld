;　威力
@SKILL_POWER_テキパキお掃除, ARG
SIF ARG < 0
	RETURN 75
CALL GET_SKILL_POWER_テキパキお掃除(GET_ROLE_CFLAG_TAKEOVER(ARG, "支援スキルランク"))
RETURN RESULT

@GET_SKILL_POWER_テキパキお掃除, ARG
SELECTCASE ARG
	CASE 15
		RESULT = 335
	CASE 11 TO 14
		RESULT = 285 + (ARG - 10) * 10
	CASE 10
		RESULT = 285
	CASE 2 TO 9
		RESULT = 60 + 15 * ARG
	CASE 0, 1
		RESULT = 75
	CASEELSE
		RESULT = 0
ENDSELECT
SIF FLAG:확산플래그
	RETURN RESULT / 2
RETURN RESULT
