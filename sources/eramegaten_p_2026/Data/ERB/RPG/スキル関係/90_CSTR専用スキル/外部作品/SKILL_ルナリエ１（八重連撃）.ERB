@ACTION_八重連撃,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM 八連順番
八連順番 = PU_SKILLNUM_GET(ARG,"八重連撃")
CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃

