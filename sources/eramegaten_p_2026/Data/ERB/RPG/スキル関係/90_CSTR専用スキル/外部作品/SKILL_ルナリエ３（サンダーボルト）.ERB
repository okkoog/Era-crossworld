;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_サンダーボルト（LT）, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "ATK"
		RETURN LIMIT(CFLAG:ARG:공격강화 + CFLAG:ARG:마법위력강화, -48, 64), 32
ENDSELECT

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_サンダーボルト（LT）,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM 水浸しフラグ
水浸しフラグ = PU_SKILLNUM_GET(ARG,"ファヤダーン")

;LOCAL:0 = MAXBASE:ARG:마법위력
;LOCAL:1 = CFLAG:ARG:마법위력강화
;
;MAXBASE:ARG:마법위력 = MAXBASE:ARG:공격
;CFLAG:ARG:마법위력강화 += CFLAG:ARG:공격강화

	IF SKILLGAGE_D_GET(ARG,水浸しフラグ) > 0
		CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
	ELSE
		CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
	ENDIF

;MAXBASE:ARG:마법위력 = LOCAL:0
;CFLAG:ARG:마법위력강화 = LOCAL:1

