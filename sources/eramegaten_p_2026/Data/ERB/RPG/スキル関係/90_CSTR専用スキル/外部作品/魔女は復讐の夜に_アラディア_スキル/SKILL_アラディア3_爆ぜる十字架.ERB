;破魔で拡散1マス2ヒット。2ヒット目で吸収。
;スキル名
@SKILL_NAME_爆ぜる十字架,ARG
RESULTS = 폭발하는 십자가

;　명중
@SKILL_HITRATE_爆ぜる十字架, ARG
SIF FLAG:공격횟수 == 1
	RETURN 100
RETURN 80

;　威力
@SKILL_POWER_爆ぜる十字架, ARG
RETURN 190

;;クリティカル率
@SKILL_CRITICAL_RATE_爆ぜる十字架, ARG
RETURN 5

;　吸収率
@SKILL_HP_ABSORBER_爆ぜる十字架, ARG
SIF FLAG:공격횟수 == 1
	RETURN 20
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_爆ぜる十字架,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_爆ぜる十字架,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_爆ぜる十字架, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_爆ぜる十字架,ARG
RETURN 20

;　相性
@SKILL_TYPE_爆ぜる十字架,ARG
RETURN GET_TYPE_NUM("파마")

@SKILL_SUCCESSION_TYPE_爆ぜる十字架
RETURN GET_SUCCESSION_NUM("파마")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_爆ぜる十字架, ARG
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_爆ぜる十字架,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;====================================================
;攻撃手段
;1.物理攻撃 2.魔法攻撃 3.총공격 4.アイテム攻撃(ダメージ計算時の依存ステータスに関わる)
;関数がない場合はダメージタイプとおなじになる
;====================================================
@SKILL_ATTACKTYPE_爆ぜる十字架, ARG
RETURN GET_攻撃タイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_爆ぜる十字架,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_爆ぜる十字架,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_爆ぜる十字架,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_爆ぜる十字架,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_爆ぜる十字架, ARG = -1
RETURN -10

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_爆ぜる十字架, ARG = -1
RETURN 0

;拡散スキルの拡散距離定義関数(このような感じで数値を増やすことで増えていく)
;1 　　　　　2 　　　　
;□□◆□□　□◆◆◆□
;□◆★◆□　◆◆★◆◆
@SKILL_SPREAD_爆ぜる十字架,ARG
RETURN 1

@SKILL_RANK_爆ぜる十字架, ARG = -1
RETURN 10

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_爆ぜる十字架,ARG,ARG:1,ARG:2
CALL ATTACK_SKILL,ARG,ARG:1,ARG:2

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_爆ぜる十字架,ARG
PRINTL 십자가를 전방에 투하하여 추가로 폭발시키는 교회술. 이단심문관 칸돌레가 장기로 삼는다.
PRINTL 단순한 마법, 즉 기술일 뿐이며 사용함에 있어 신앙심 따윈 파편만큼도 필요치 않았다.
PRINTL 폭발에는 술자의 체력으로 전환하는 술식이 내장되어 있다.
PRINTL 
PRINTL 적 1체를 대상 및 그 주변 적에게 파마 속성의 물리 데미지를 2회 가하고,
PRINTL 추가로 가한 데미지에 비례해 HP를 회복한다.
PRINTL 이 스킬의 데미지는 마법 위력에 의존한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_爆ぜる十字架,ARG
RETURN 1
