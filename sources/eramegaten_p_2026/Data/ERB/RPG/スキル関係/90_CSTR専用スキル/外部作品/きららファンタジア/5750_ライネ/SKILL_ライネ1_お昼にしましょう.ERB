;====================================================
;トリガー発動条件
;====================================================
@SKILL_TRIGGER_ACTIONABLE_お昼にしましょう,ARG,ARG:1
;自身の行動のみで判定
SIF FLAG:행동순1 != ARG
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
SIF !IS_PU_SKILL_入力行動(ARG, "お昼にしましょう")
	RETURN 0
SIF !GET_CREC_ACT_SUM(ARG, "적", "HIT")
	RETURN 0
RETURN 1, CFLAG:ARG:PT플래그 ? 19 # 22
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_お昼にしましょう,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
IF FLAG:총공격중
	CALL HEAL_FIELD,ARG,ARG:1,SKILL_NUM
ELSE
	CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM
ENDIF
