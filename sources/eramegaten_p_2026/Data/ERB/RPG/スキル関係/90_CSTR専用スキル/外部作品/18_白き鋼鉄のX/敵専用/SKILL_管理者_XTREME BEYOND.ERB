;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_XTREME_BEYOND,ARG,ARG:1,ARG:2

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_XTREME_BEYOND
PRINTL 2턴에 한 번, 턴 개시 시에 이하의 연동 효과가 발동한다.
PRINTL 「자신의 모든 능력을 상승시킨다. 혹은 다음 물리 공격의 명중률과 크리티컬률을 대폭 상승시키는 차지 효과를 얻는다.」

@SKILL_EXPLAIN_TOOLTIP_XTREME_BEYOND, ARG
RESULTS:0 = 2턴에 한 번, 턴 개시 시에 이하의 연동 효과가 발동한다.
RESULTS:1 = 「자신의 모든 능력을 상승시킨다. 혹은 다음 물리 공격의 명중률과 크리티컬률을 대폭 상승시키는 차지 효과를 얻는다.」

;使用条件
@SKILL_SPECIAL_ACTIONABLE_XTREME_BEYOND,ARG
RETURN 1
;とくにない

@SKILL_TURNSTART_XTREME_BEYOND, ARG
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
SIF PU_SKILLGAGE_H_GET(ARG, "XTREME_BEYOND") % 2
	RETURN 0
CALL PU_SKILLGAGE_H_ADD, ARG, "XTREME_BEYOND", 1
CALL PRINT_ACT_MESSAGE, ARG, , , , "XTREME BEYOND", "NOWAIT"
IF GET_カジャンダ_MIN(ARG) < 32
	CALL SKILL_SET_カジャンダ, ARG, ARG, "공격/방어/마법위력/마법효과/명중/회피", 4, "단체"
ELSE
	CFLAG:ARG:회심의패기플래그 = 1
	CALL PRINT_HIT_MESSAGE, ARG, "次の物理攻撃の命中率とクリティカル率が大幅上昇！"
ENDIF