;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_復讐の一撃,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SKILL,ARG,ARG:1,ARG:2
;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_復讐の一撃,ARG
PRINTL 장비한 무기에 의한 치명적인 일격.
PRINTL 공격 속성이 검에 의존하고 있어, 속성에 따라 위력과 공격 횟수도 변화한다.
PRINTL 후의 선을 노리기 위해 턴 종료 직전에 행동하며, 데미지에 비례해 어느 정도 체력을 흡수한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_復讐の一撃,ARG
RETURN 1

;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_復讐の一撃,ARG,ARG:1
#DIM DYNAMIC L_VALUE
IF ACTIONABLE_CHARA_F(ARG) && IS_PU_SKILL_入力行動(ARG, "復讐の一撃")
	L_VALUE = 100 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ
	SIF L_VALUE == 0
		RETURN 0
	CALL PU_SKILLGAGE_H_ADD, ARG, "復讐の一撃", L_VALUE
	RESULTS = 복수의 일격
	RESULTS:1 =\%
	RETURN L_VALUE
ELSE
	CALL PU_SKILLGAGE_H_SET, ARG, "復讐の一撃", 0
ENDIF

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_復讐の一撃, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			IF IS_PU_SKILL_入力行動(L_P, "復讐の一撃")
				RETURN PU_SKILLGAGE_H_GET(L_P, "復讐の一撃")
			ENDIF
	ENDSELECT
ENDIF

@リンク不能_復讐の一撃
RETURN 1