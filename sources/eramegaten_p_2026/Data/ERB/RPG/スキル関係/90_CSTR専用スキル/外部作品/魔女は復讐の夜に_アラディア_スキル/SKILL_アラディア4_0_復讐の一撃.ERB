@SKILL_SWITCHING_復讐の一撃, ARG = -1
#FUNCTION
IF ARG < 0
	RESULTS_F '= "復讐の一撃"
ELSE
	IF GROUPMATCH(GET_TYPE(ABL:ARG:공격상성), "검격", "비구", "타격", "전술")
		RESULTS_F '= "復讐の一撃" + "_" + GET_TYPE(ABL:ARG:공격상성)
	ELSE
		RESULTS_F '= "復讐の一撃_魔法"
	ENDIF
ENDIF

;スキル名
@SKILL_NAME_復讐の一撃,ARG
RESULTS = 복수의 일격

;　명중
@SKILL_HITRATE_復讐の一撃, ARG
RETURN 90

;　威力
@SKILL_POWER_復讐の一撃, ARG
RETURN 400

;　최저공격횟수
@SKILL_MINATTACKNUMBER_復讐の一撃,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_復讐の一撃,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_復讐の一撃, ARG
