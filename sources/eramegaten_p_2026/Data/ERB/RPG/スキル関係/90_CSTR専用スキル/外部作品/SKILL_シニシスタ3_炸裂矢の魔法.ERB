;　威力(通常攻撃を100%とした倍率となる)
@SKILL_POWER_炸裂矢の魔法, ARG
IF ARG >= 0
	IF HAVE_PU_SKILL(ARG, "トランケバル")
		SIF FLAG:확산플래그
			RETURN 360
		RETURN 500
	ENDIF
	IF HAVE_PU_SKILL(ARG, "破魔の杖剣")
		SIF FLAG:확산플래그
			RETURN 320
		RETURN 450
	ENDIF
	IF HAVE_PU_SKILL(ARG, "ヤマナラシの杖")
		SIF FLAG:확산플래그
			RETURN 260
		RETURN 360
	ENDIF
	IF HAVE_PU_SKILL(ARG, "イチイの杖")
		SIF FLAG:확산플래그
			RETURN 180
		RETURN 240
	ENDIF
ENDIF
RETURN 130
SIF FLAG:확산플래그
	RETURN 90
RETURN 130

