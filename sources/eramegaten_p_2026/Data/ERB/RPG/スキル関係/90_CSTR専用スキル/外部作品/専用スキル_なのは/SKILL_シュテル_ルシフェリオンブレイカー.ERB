@SKILL_EFECT_ルシフェリオンブレイカー,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_ルシフェリオンブレイカー
RETURN GET_SUCCESSION_NUM("계통없음")
;속도보정
@SKILL_SPEED_ルシフェリオンブレイカー, ARG = -1
