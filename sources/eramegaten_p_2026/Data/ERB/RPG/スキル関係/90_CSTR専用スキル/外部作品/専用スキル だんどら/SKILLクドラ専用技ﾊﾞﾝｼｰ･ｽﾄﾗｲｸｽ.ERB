;　説明文の表示
@SKILL_EXPLAIN_ﾊﾞﾝｼｰ･S,ARG
#DIM DI残りターン
#DIM スキル番号
スキル番号 = PU_SKILLNUM_GET(ARG,"Ｄ・いんすとーる")
DI残りターン = SKILLGAGE_D_GET(ARG,スキル番号)
PRINTL 기술명: 밴시·스트라이크스
PRINTL 공중으로 높이 날아올라 급강하하며 강렬한 발차기를 날려 적을 꿰뚫는다
PRINTL 적 전열 1체에 전기 상성의 특대 물리 데미지+BIND
PRINTL 용희 쿠드라의 전용기
IF DI残りターン > 0
	SETCOLOR 0xed1e25
	PRINTFORML %CALLNAME:ARG%(은)는 힘을 끌어내고 있다…… (전 내성 관통)
	RESETCOLOR
ENDIF

