;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_リミットスキル,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
PRINTFORMW %CALLNAME:ARG%(은)는 집중하여 리미트 게이지를 충전했다!

;　説明文の表示
@SKILL_EXPLAIN_リミットスキル,ARG
PRINTL 자신의 리미트 게이지를 40% 증가시킨다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_リミットスキル,ARG
#DIM L_SKILL
FOR L_SKILL, 0, CHARA_SKILLCOUNT(ARG)
	SIF L_SKILL == 0
		CONTINUE
	CALL GETS_SKILL_PROP, "SKILL_TAG", @"LIMIT_%GET_PU_SKILL_CSTR(ARG, L_SKILL)%"
	SIF RESULTS != "SQ3_LIMIT"
		CONTINUE
	SIF PU_SKILLGAGE_H_GET(ARG, GET_PU_SKILL_CSTR(ARG, L_SKILL)) == 100
		CONTINUE
	RETURN 1
NEXT
