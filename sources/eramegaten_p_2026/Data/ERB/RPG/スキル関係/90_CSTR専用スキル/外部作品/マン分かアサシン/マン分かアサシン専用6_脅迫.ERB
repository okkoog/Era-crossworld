@SKILL_SPEED_脅迫, ARG = -1
RETURN 0
;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_脅迫
RETURN 0

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_脅迫, ARG = -1, ARG:1 = -1
;解析度が最大のとき貫通を得る
SIF ARG:1 >= 0 && ANALYSIS_RATE:(NO:(ARG:1)) == ANALYSIS_COMPLETED
	RETURN 4
RETURN 0

;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_脅迫,ARG,ARG:1,ARG:2
SIF ARG:2 < -1
	RETURN 0
;自分にあてるのは問題があるきがするので
SIF ARG == ARG:1
	RETURN 0
SIF ANALYSIS_RATE:(NO:(ARG:1)) == ANALYSIS_COMPLETED && SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"脅迫"))
	TFLAG:스킬용1 = 1
	;PRINTL 　　弱点を暴いた！
	;大嘘
;NP時は威力倍
IF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")) > 0
	CFLAG:(ARG:1):ＣＯＯＰ플래그 = ANALYSIS_RATE:(NO:(ARG:1)) * ANALYSIS_RATE:(NO:(ARG:1)) / 10
ELSE
	CFLAG:(ARG:1):ＣＯＯＰ플래그 = ANALYSIS_RATE:(NO:(ARG:1)) * ANALYSIS_RATE:(NO:(ARG:1)) / 20
ENDIF

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_脅迫,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
IF ANALYSIS_RATE:(NO:(ARG:1)) == ANALYSIS_COMPLETED
	CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"脅迫"),1
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
ELSE
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
ENDIF
SIF TFLAG:스킬용1
	PRINTL 　　약점을 밝혀냈다!
	
;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_脅迫,ARG
PRINTL 적 1체에 정신 속성으로 극소 위력의 공격을 1회 가한다. 해석도 최대 시 속성을 관통한다.
PRINTL 명중 시 해석도에 비례한 위력의 CO-OP을 발생시킨다.
PRINTL
PRINTL 
PRINTL 수집한 정보를 바탕으로 협박하는 스킬.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_脅迫,ARG
RETURN 1
