;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_蒼龍の顎門,ARG,ARG:1,ARG:2
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_ENEMY
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1)
	L_ENEMY = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_ENEMY)
		CONTINUE
	IF CFLAG:L_ENEMY:전격무효화횟수 == 0
		CALL PRINT_HIT_MESSAGE, L_ENEMY, "1ターン、電撃への耐性を無効化！"
	ELSE
		CFLAG:L_ENEMY:전격무효화횟수 -= 1
		CALL PRINT_HIT_MESSAGE, L_ENEMY, "電撃無効化回数減少！"
	ENDIF
NEXT
WAIT
