;パトリシア・ハックマン専用スキル。
;単体電撃物理、威力300、MP16、ランク8

;スキル名
@SKILL_NAME_プラズマカッター,ARG
RESULTS = 플라즈마 커터

;　명중
@SKILL_HITRATE_プラズマカッター, ARG
RETURN 100

;　威力
@SKILL_POWER_プラズマカッター, ARG
RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_プラズマカッター,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_プラズマカッター,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_プラズマカッター, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_プラズマカッター,ARG
RETURN 16

;　相性
@SKILL_TYPE_プラズマカッター,ARG
RETURN GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_プラズマカッター
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_プラズマカッター,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_プラズマカッター,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_プラズマカッター,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_プラズマカッター,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_プラズマカッター,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_プラズマカッター, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_プラズマカッター
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_プラズマカッター
RETURN GET_SUCCESSION_NUM("전격")

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_プラズマカッター,ARG
RETURN GET_STATE_NUM("SHOCK")


;추가효과상성
@SKILL_ADDTIONAL_TYPE_プラズマカッター,ARG
RETURN GET_TYPE_NUM("전격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_プラズマカッター,ARG
RETURN 20

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_プラズマカッター,ARG
RETURN 95
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_プラズマカッター,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;単体攻撃
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_プラズマカッター,ARG
PRINTL 빔 검을 전개하여 적을 베어 가른다.
PRINTL 적 단체에 전격 상성의 물리 대데미지. 확률에 따라 SHOCK 상태로 만든다.

@SKILL_EXPLAIN_TOOLTIP_プラズマカッター, ARG
RESULTS:0 = 빔 검을 전개하여 적을 베어 가른다.
RESULTS:1 = 적 단체에 전격 상성의 물리 대데미지. 확률에 따라 SHOCK 상태로 만든다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_プラズマカッター,ARG
RETURN 1

;スキル変化用ランク
@SKILL_RANK_プラズマカッター, ARG = -1
RETURN 8
