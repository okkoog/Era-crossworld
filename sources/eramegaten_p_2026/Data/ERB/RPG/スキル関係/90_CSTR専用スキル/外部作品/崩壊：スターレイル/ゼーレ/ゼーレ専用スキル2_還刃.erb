;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_還刃,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

IF SKILLGAGE_H_GET(ARG,SKILL_NUM) - (GET_RPG_CFLAG_TAKEOVER(ARG, "星魂") > 1) < 1
	PRINTL ゼーレの行動速度上昇！
	CALL SKILLGAGE_H_ADD,ARG,SKILL_NUM,1
ENDIF

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃



;====================================================
;実行内容ここまで
;====================================================

;====================================================
@SKILL_ADD_STATUS_還刃, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	;RESULT = 修正値
	;RESULTS = 加算/乗算/固定値/活泉/魔脈
	;加算はそのまま固定値を加算する。乗算は(100+X)/100倍にする。固定値は必ずその数値にする(55ならなにがあろうと最大HP55になる)
	;活泉/魔脈はそのまま同種スキルと同じ枠となりもっとも効果量が高いものを優先する形になる
	;HP半減
	CASE "HP補正"
		RETURN 0
	;MP+100
	CASE "MP補正"
		RETURN 0
	;基本ステータス
	;ARG:1 に悪魔変身後の配分済みBASEステータスを格納している(悪魔変身をしていない・出来ない場合はBASE:Xとおなじ)
	;プラグイン等の割合計算はBASEの値を指定しているので、割合での増減を指定したい場合はARG:1に数字をかけて固定値で返してください
	CASE "基本ステータス"
		RETURN 0 
	;RESULT = 	ランク, 高いほど優先される。またランクによって代入されるタイミングが変わる
	;			 1~10:基本BASE代入直後(装備・MAG・強化プラグインの影響をうける。要するにBASEを変えたのと同じ挙動)
	;			11~20:装備・MAG・強化プラグイン変更後の上書き
	;			21～ :とりあえず未実装
	;			ただしペルソナ使いは10以下での変更を無視する
	;RESULT:1 = 変更する相性値
	;RESULTS  = 上書きを許可する相性を文字列で指定(通常/弱点/耐性/無効/吸収/反射)　未指定の場合は全て上書きする
	CASE "相性"
		RETURN 0
	;RESULT = 	ランク, 高いほど優先される。またランクによって代入されるタイミングが変わる
	;			 1~10:基本BASE代入直後(装備・MAG・強化プラグインの影響をうける。要するにBASEを変えたのと同じ挙動)
	;			11~20:装備・MAG・強化プラグイン変更後の上書き
	;			21～ :とりあえず未実装
	;
	;			ただし、加算で指定している時は1=BASE直後 2=装備での変更後になる
	;RESULT:1 = 変更する相性値
	;RESULTS  = "加算"の場合は耐性値に加算する。代入あるいは無指定で上書きする(相性と同じ挙動)。
	;
	;どちらにしろ、ステート耐性は0のときに通常(100%)のに注意。
	CASE "상태이상"
		RETURN 0
	;速度補正はそのまま速度補正となる
	CASE "속도보정"
		SIF SKILLGAGE_H_GET(ARG,SKILL_NUM)
			RETURN ARG:1 / 4 * MIN(RESULT , 2)
ENDSELECT
