;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_運命両断, ARG
	RESULTS = 運命両断

;　명중
@SKILL_HITRATE_KE_運命両断, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_運命両断, ARG
RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_運命両断, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_運命両断, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_運命両断, ARG
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 50
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_KE_運命両断, ARG
IF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 50
	RESULTS = %" 50ＴＰ"%
	RETURN 0
ENDIF
RETURN 25

;　相性
@SKILL_TYPE_KE_運命両断, ARG
RETURN GET_TYPE_NUM("검격"),GET_TYPE_NUM("파마")
;剣撃、破魔

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_運命両断
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_運命両断, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_運命両断, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_KE_運命両断, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_運命両断, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_運命両断, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_KE_運命両断, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_運命両断
RETURN 0


;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_KE_運命両断, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
SIF ARG:2 < -1
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "命中_回避", -4, "短縮", "", "", -4

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_運命両断, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;Fゲージ再回収できる様に起動前にTP50消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 50, "-="

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_運命両断, ARG
PRINTL 
PRINTL 저편에서 닿는 운명을 개척하는 검. TP 회수량이 많다.
PRINTL 적 단체에 검격/파마 복합 속성 대위력의 물리 공격을 가한다. 공격 후 적의 명중/회피를 1단계 낮춘다.
PRINTL 
PRINTL 문장의 왕이 사용하는 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_運命両断, ARG
;ゲージが50以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 50
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_運命両断, ARG
RESULTS:0 = 적 단체에 검격/파마 복합 속성 대위력의 물리 공격을 가한다. 공격 후 적의 명중/회피를 1단계 낮춘다.
RESULTS:1 = TP消費 50
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 50
	RESULTS:1 = %RESULTS:1%(不足)