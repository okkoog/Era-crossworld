;ゲシュペンスト・ファントム専用スキル。
;単体剣撃物理、威力160*3、MP30、ランク13

;スキル名
@SKILL_NAME_Ｇ・プラズマカッター,ARG
RESULTS = G·플라즈마 커터

;　명중
@SKILL_HITRATE_Ｇ・プラズマカッター, ARG
RETURN 100

;　威力
@SKILL_POWER_Ｇ・プラズマカッター, ARG
RETURN 160

;　최저공격횟수
@SKILL_MINATTACKNUMBER_Ｇ・プラズマカッター,ARG
RETURN 3

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_Ｇ・プラズマカッター,ARG
RETURN 3

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_Ｇ・プラズマカッター, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_Ｇ・プラズマカッター,ARG
RETURN 40

;　相性
@SKILL_TYPE_Ｇ・プラズマカッター,ARG
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_Ｇ・プラズマカッター
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_Ｇ・プラズマカッター,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_Ｇ・プラズマカッター,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_Ｇ・プラズマカッター,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_Ｇ・プラズマカッター,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_Ｇ・プラズマカッター,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_Ｇ・プラズマカッター, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_Ｇ・プラズマカッター
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_Ｇ・プラズマカッター
RETURN GET_SUCCESSION_NUM("검격")

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_Ｇ・プラズマカッター,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;単体攻撃
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_Ｇ・プラズマカッター,ARG
PRINTL 왼팔 플라즈마 스테이크 바깥쪽 1자루를 뽑아 대형 빔 검으로
PRINTL 변형시켜 적을 벤다. 정식 명칭 <그랑 플라즈마 커터>
PRINTL 적 단체에 3회 검격 상성의 물리 데미지.

@SKILL_EXPLAIN_TOOLTIP_Ｇ・プラズマカッター, ARG
RESULTS:0 = 왼팔 플라즈마 스테이크 바깥쪽 1자루를 뽑아 대형 빔 검으로
RESULTS:1 = 변형시켜 적을 벤다. 정식 명칭 <그랑 플라즈마 커터>
RESULTS:2 = 敵単体に3回剣撃相性の物理ダメージ。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_Ｇ・プラズマカッター,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_Ｇ・プラズマカッター, ARG = -1
RETURN 13
