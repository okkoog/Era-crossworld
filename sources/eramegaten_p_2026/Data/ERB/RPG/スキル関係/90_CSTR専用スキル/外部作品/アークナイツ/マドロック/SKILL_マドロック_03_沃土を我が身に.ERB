@SKILL_BATTLE_START_沃土を我が身に,ARG
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
    RETURN 0
CALL SET_RPG_CFLAG_BTL, ARG, "沃土バリア数", 1, "ADD"
CALL SET_RPG_CFLAG_BTL, ARG, "沃土バリア貼付ターン", 1, "SET"

@SKILL_TURNEND_沃土を我が身に,ARG
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
    RETURN 0
IF FLAG:경과턴수 >= GET_RPG_CFLAG_BTL(ARG, "沃土バリア貼付ターン")
    IF GET_RPG_CFLAG_BTL(ARG, "沃土バリア数") < 2
        CALL SET_RPG_CFLAG_BTL, ARG, "沃土バリア数", 1, "ADD"
        CALL SET_RPG_CFLAG_BTL, ARG, "沃土バリア貼付ターン", FLAG:경과턴수 + 3, "SET"
    ENDIF
ENDIF

