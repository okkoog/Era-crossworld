@SKILL_TRIGGER_ACTIONABLE_沃土を我が身に,ARG,ARG:1
;自身の時のみ判定
SIF ARG != ARG:1
	RETURN 0
SIF !GET_RPG_CFLAG_BTL(ARG, "バリア消費")
	RETURN 0
RETURN 1, CPOS(ARG)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_沃土を我が身に,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL HEAL_SINGLE,ARG,POS(ARG:1),SKILL_NUM
CALL SET_RPG_CFLAG_BTL, ARG, "バリア消費", 0
CALL SET_RPG_CFLAG_BTL, ARG, "沃土バリア数", -1, "ADD"

