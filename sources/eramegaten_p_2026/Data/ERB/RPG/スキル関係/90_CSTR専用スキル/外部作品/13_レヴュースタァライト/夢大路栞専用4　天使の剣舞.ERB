;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_天使の剣舞, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "ATK"
		SIF  GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
			RETURN LIMIT(CFLAG:ARG:공격강화 + CFLAG:ARG:마법위력강화, -48, 64), 32
		RETURN 0
ENDSELECT

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_天使の剣舞,ARG,ARG:1,SKILL_NUM
#LOCALSIZE 3
#DIM SKILL_NUM

IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	;MAXBASE:ARG:공격 += MAXBASE:ARG:마법위력
	;CFLAG:ARG:공격강화 += CFLAG:ARG:마법위력강화

	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)

	;MAXBASE:ARG:공격 -= MAXBASE:ARG:마법위력
	;CFLAG:ARG:공격강화 -= CFLAG:ARG:마법위력강화
	CALL SET_ROLE_CFLAG_DUNGEON, ARG,  "클라이맥스레뷰지속시간" , 0
ELSE
	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
ENDIF

	IF CFLAG:(ARG):PT플래그
		LOCAL:1 = 1
		LOCAL:2 = 7
	ELSE
		LOCAL:1 = 7
		LOCAL:2 = 17
	ENDIF
	FOR LOCAL,LOCAL:1,LOCAL:2
		SIF POS(LOCAL) < 0
			CONTINUE
		SIF GET_STATE(CFLAG:POS(LOCAL):상태이상) == "DYING"
			CONTINUE
		CALL HEAL_SINGLE,ARG,POS(LOCAL),402
	NEXT

		

	
;====================================================
;実行内容ここまで
;====================================================






;　説明文の表示
@SKILL_EXPLAIN_天使の剣舞,ARG
	IF GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
		PRINTL 반짝임으로 전장을 무대로 다시 칠하고 누군가를 쫓듯 무대를 가로지른다.
		PRINTL 적 전체에 만능 상성의 물리 소데미지 3회, 공격 후 아군 전체를 회복한다
		PRINTL 공격력은 마법 위력+공격으로 산출되며, 마카카자의 효과도 받는다
		PRINTL 사용하면 클라이맥스 레뷰는 종료된다
	ELSE
		PRINTL 춤추듯 적 전체를 쓸어버리고, 반짝임의 분류로 아군을 회복한다.
		PRINTL 적 전체에 검격 상성의 물리 중데미지, 공격 후 아군 전체를 회복한다
		PRINTL 클라이맥스 레뷰 발동 중에는 성능이 변화한다.
	ENDIF
