;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_葵, ARG, ARG:1, ARG:2
SIF CFLAG:(ARG:1):현데미지 < 1
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어", -8, "短縮"
CALL SKILL_GUARD_KILL, ARG, "검격", CPOS(ARG:1), 6, "短縮"

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_葵, ARG = -1, ARG:1 = -1
RETURN 4
;====================================================
;スキル及び行動の実行
;====================================================

@ACTION_葵, ARG, ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM L_IKARI
L_IKARI = PU_SKILLNUM_GET(ARG, "CSTR_怒り爆発")
LOCAL = POS(ARG:1)

CALL ATTACK_SINGLE, ARG,LOCAL,SKILL_NUM

SIF CFLAG:LOCAL:현데미지 > 0 && L_IKARI > 0
	CALL SKILLGAGE_D_SET, ARG,L_IKARI,0



