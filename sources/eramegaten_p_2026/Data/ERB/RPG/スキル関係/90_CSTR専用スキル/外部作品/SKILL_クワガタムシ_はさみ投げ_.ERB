;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_はさみ投げ,ARG
RESULTS = 끼워 던지기

;　명중
@SKILL_HITRATE_はさみ投げ, ARG
RETURN 70

;　威力
@SKILL_POWER_はさみ投げ, ARG
SIF FLAG:공격횟수 == 0
	RETURN 140
SIF FLAG:공격횟수 == 1
	RETURN 210

;　최저공격횟수
@SKILL_MINATTACKNUMBER_はさみ投げ,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_はさみ投げ,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_はさみ投げ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_はさみ投げ,ARG
RETURN 20

;　相性
@SKILL_TYPE_はさみ投げ,ARG
SIF FLAG:공격횟수 == 0
	RETURN GET_TYPE_NUM("검격")
SIF FLAG:공격횟수 == 1
	RETURN GET_TYPE_NUM("전술")
;전술

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_はさみ投げ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　攻撃タイプ
@SKILL_ATTACKTYPE_はさみ投げ,ARG
RETURN GET_攻撃タイプ_NUM("物理")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_はさみ投げ, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_はさみ投げ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_はさみ投げ,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_はさみ投げ,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_はさみ投げ, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_はさみ投げ
RETURN GET_SUCCESSION_NUM("전술")
;전술

;スキル変化？用ランク
@SKILL_RANK_はさみ投げ, ARG = -1
RETURN 7

;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_はさみ投げ,ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_はさみ投げ,ARG
RETURN GET_TYPE_NUM("전격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_はさみ投げ,ARG
RETURN 60

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_はさみ投げ,ARG
RETURN 95

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_はさみ投げ,ARG,ARG:1,ARG:2
CALL ATTACK_SINGLE, ARG, POS(ARG:1),ARG:2

;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_はさみ投げ,ARG
PRINTL 큰 턱으로 상대를 끼운 뒤 내던지는 사슴벌레의 주특기 무브
PRINTL 적 단체에게 저명중의 검격 소데미지를 준 뒤 전기술 중데미지를 주고, 높은 확률로 SHOCK 상태로 만든다
;使用条件
@SKILL_SPECIAL_ACTIONABLE_はさみ投げ,ARG
RETURN 1
;とくにない
