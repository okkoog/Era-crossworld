;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_飛水影縫,ARG
RESULTS = 飛水影縫

;　명중
@SKILL_HITRATE_飛水影縫, ARG
RETURN 90

;　威力
@SKILL_POWER_飛水影縫, ARG
RETURN 390

;　최저공격횟수
@SKILL_MINATTACKNUMBER_飛水影縫,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_飛水影縫,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_飛水影縫, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_飛水影縫,ARG
RETURN 38

;　相性
@SKILL_TYPE_飛水影縫,ARG
RETURN GET_TYPE_NUM("수격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_飛水影縫
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_飛水影縫, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_飛水影縫, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_飛水影縫,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_飛水影縫,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_飛水影縫, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_飛水影縫
RETURN GET_SUCCESSION_NUM("수격")

;속도보정
@SKILL_SPEED_飛水影縫, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_飛水影縫
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_飛水影縫, ARG = -1
RETURN 14

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_飛水影縫,ARG
RETURN GET_STATE_NUM("PALYZE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_飛水影縫,ARG
RETURN GET_TYPE_NUM("신경")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_飛水影縫,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_飛水影縫,ARG
RETURN 95

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_飛水影縫,ARG,ARG:1,ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,ARG:2

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_飛水影縫, ARG
PRINTL 『수』의 기를 연마한 비수류의 오의 중 하나.
PRINTL 적 1열에 수격 마법 대 데미지를 가하고, 확률로 PALYZE 상태로 만든다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_飛水影縫,ARG
RETURN 1
;とくにない

