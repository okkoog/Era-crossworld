@ACTION_ギガバスター,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

IF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ギガバスター")) == 0
	PRINTFORML %CALLNAME:ARG%의 물리 공격 데미지량이 상승!
	CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"ギガバスター"),3
ELSE
	PRINTFORML 기가 버스터　　＞　　효과가 없었다!
ENDIF

;CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
;CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
;CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM;		拡散攻撃
;CALL ATTACK_RAND,ARG,ARG:1,SKILL_NUM;			ランダム攻撃


;====================================================
;実行内容ここまで
;====================================================






@SKILL_PASSIVE_BTL_EFFECT_ギガバスター, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

IF SKILLGAGE_D_GET(L_P,PU_SKILLNUM_GET(L_P,"ギガバスター")) > 0
	;自分が攻撃側
	IF L_P == L_ACTOR
		SELECTCASE ARGS
			;気合などと加算の枠。他に加減要素がなければ100%±X%になる
			CASE "ダメージ補正加算"
				IF L_ダメージタイプ == "物理"
					RETURN 50
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 0

