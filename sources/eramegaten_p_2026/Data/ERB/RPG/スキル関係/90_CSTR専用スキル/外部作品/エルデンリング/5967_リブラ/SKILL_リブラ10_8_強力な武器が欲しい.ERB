;スキル名
@SKILL_NAME_強力な武器が欲しい,ARG
RESULTS = 강력한 무기를 원한다

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_強力な武器が欲しい, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")

;　コストの量
@SKILL_COST_強力な武器が欲しい,ARG
RETURN 0

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_強力な武器が欲しい
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_強力な武器が欲しい,ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_強力な武器が欲しい,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_強力な武器が欲しい,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_強力な武器が欲しい,ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_強力な武器が欲しい, ARG = -1
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_強力な武器が欲しい,ARG,ARG:1,ARG:2
#DIM DYNAMIC LCOUNT
CALL SET_C_BTL_EFFECT_SINGLE, ARG, POS(ARG:1), "強力な武器が欲しい", 0, "次の攻撃の威力が増加！", ,"NOWAIT"
CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "방어/마법효과/명중/회피", -4, "단체"

@SKILL_TARGETABLE_強力な武器が欲しい, ARG, ARG:1
SIF ARG == ARG:1
	RETURN 0
RETURN 1

;　説明文の表示
@SKILL_EXPLAIN_強力な武器が欲しい,ARG
PRINTL 대상 아군 1명에게 다음 물리 공격 혹은 마법 공격의 위력을 증가시키는 차지 효과를 부여하고,
PRINTL 추가로 모든 방어력과 마법 효과 및 명중률과 회피율을 저하시킨다.

;　説明文の表示
@ENHANCE_SKILL_EXPLAIN_強力な武器が欲しい,ARG
RESULTS:0 '= "対象の味方一人に次の物理攻撃あるいは魔法攻撃の威力を増加させるチャージ効果を与え、"
RESULTS:1 '= "さらに全ての防御力と魔法効果と命中率と回避率を低下させる。"

;使用条件
@SKILL_SPECIAL_ACTIONABLE_強力な武器が欲しい,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_強力な武器が欲しい, ARG = -1
RETURN 6
