;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_四拍子のガヴォット, ARG = -1, ARG:1 = -1
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "完璧主義のメイド長")
	RETURN 0, 4
ELSE
	RETURN 0, 0
ENDIF
;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_四拍子のガヴォット, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어", -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_四拍子のガヴォット,ARG,ARG:1,ARG:2
#DIM DYNAMIC L_ACTOR
#DIM DYNAMIC STOCK_ACT
L_ACTOR = GET_ROLE_CFLAG_BTL(ARG, "突撃スキル発動者")
TFLAG:소환공격스킬 = ARG:2
FLAG:소환공격중 = 1

CFLAG:(ARG):소환예정캐릭터 = CFLAG:L_ACTOR:캐릭터고유번호

CFLAG:L_ACTOR:피소환플래그 = 1
CFLAG:L_ACTOR:소환자ID = CFLAG:ARG:캐릭터고유번호
STOCK_ACT = CFLAG:L_ACTOR:입력행동
CFLAG:L_ACTOR:입력행동 = PU_SKILLNUM_GET(L_ACTOR, "四拍子のガヴォット")

CALL ATTACK_SKILL, L_ACTOR, ARG:1, CFLAG:L_ACTOR:입력행동
CALL SKILLGAGE_CHARGE_ROLE_ホロウエージェント, L_ACTOR, L_ACTOR
CALL SET_ROLE_CFLAG_BTL, ARG, "獲得デシベル値", RESULT
CFLAG:L_ACTOR:입력행동 = STOCK_ACT
CFLAG:L_ACTOR:피소환플래그 = 0
CFLAG:L_ACTOR:소환자ID = -1
CFLAG:(ARG):소환예정캐릭터 = -1

@BASE_DECIBEL_PTS_四拍子のガヴォット,ARG
RETURN 100

