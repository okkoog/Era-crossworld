@SKILL_POWER_四拍子のガヴォット, ARG
SIF ARG < 0
	RETURN 50
CALL GET_SKILL_POWER_四拍子のガヴォット(GET_ROLE_CFLAG_TAKEOVER(ARG, "通常スキルランク"))
RETURN RESULT

@GET_SKILL_POWER_四拍子のガヴォット, ARG
SELECTCASE ARG
	CASE 15
		RETURN 250
	CASE 11 TO 14
		RETURN 200 + (ARG - 10) * 10
	CASE 10
		RETURN 200
	CASE 2 TO 9
		RETURN 40 + 15 * ARG
	CASE 0, 1
		RETURN 50
	CASEELSE
		RETURN 0
ENDSELECT

