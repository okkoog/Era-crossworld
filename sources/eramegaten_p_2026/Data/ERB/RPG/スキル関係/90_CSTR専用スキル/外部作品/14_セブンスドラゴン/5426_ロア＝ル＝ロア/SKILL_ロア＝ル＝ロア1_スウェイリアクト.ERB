RETURN 1

;=====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_スウェイリアクト,ARG,ARG:1
;攻撃対象にできる敵じゃないとダメ
SIF !IS_TARGET_ABLE(ARG:1)
	RETURN 0
;自分が行動可能でないとダメ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;自分が場に出てないとダメ
SIF CPOS(ARG) < 1
	RETURN 0
;味方相手には発動しない
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
;敵が自分に対してミスをしていると発動
SIF !GET_CREC_ACT(ARG:1, ARG, "MISS")
	RETURN 0
;アクティブスキルとして起動状態にしておく必要がある。
SIF PU_SKILLGAGE_D_GET(ARG, "スウェイリアクト") < 1
	RETURN 0
;対象は敵単体
RETURN 1, CPOS(ARG:1)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_スウェイリアクト, ARG, ARG:1, ARG:2
;効果時間は1ターン
IF FLAG:카운터중
	CALL SINGLE_BADSTATE, ARG, POS(ARG:1), ARG:2
ELSE
	PRINTFORMW %CALLNAME:ARG%(은)는 공격 회피에 성공했을 경우 추가 행동을 실행하게 되었다!
	CALL PU_SKILLGAGE_D_SET, ARG, "スウェイリアクト", 1
ENDIF

