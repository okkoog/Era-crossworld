@SKILL_DAMAGETYPE_マジック・ボム,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_マジック・ボム,ARG
RETURN GET_SKILL_TARGET_NUM("적")

