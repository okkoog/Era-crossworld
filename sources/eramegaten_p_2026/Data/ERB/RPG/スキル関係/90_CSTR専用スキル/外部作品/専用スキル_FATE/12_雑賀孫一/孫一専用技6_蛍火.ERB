SIF F_GAGE > 0
	CALL PU_SKILLGAGE_F_SET(ARG,"蛍火",F_GAGE - 1)

;戦闘中に選択肢に出さない
@SKILL_QUICK_ACTION_蛍火, ARG
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_蛍火,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

CALL SET_C_BTL_EFFECT_SINGLE, ARG, ARG, "蛍火α",1,"回避しやすくなった！"
CALL SET_C_BTL_EFFECT_SINGLE, ARG, ARG, "蛍火β",1,"味方を単体攻撃から庇う！"
CALL SET_C_BTL_EFFECT_SINGLE, ARG, ARG, "蛍火γ",1,"攻撃を受けた時のNPゲージ獲得量増加！",,"NOWAIT"
;自身に蛍火βの付与に成功した場合、庇う効果を味方に付与する
SIF IS_ACTIVE_C_BTL_EFFECT("蛍火β",ARG)
	CALL SET_C_BTL_EFFECT_FIELD, ARG, CFLAG:ARG:PT플래그 > 0 ? 19 # 22, "蛍火δ",3,,,"NOPRINT"
CALL PU_SKILLGAGE_F_SET(ARG,"ノウブル・ファンタズム",MIN(PU_SKILLGAGE_F_GET(ARG,"ノウブル・ファンタズム") + 20,100))

CALL PU_SKILLGAGE_D_SET(ARG,"蛍火",6)

