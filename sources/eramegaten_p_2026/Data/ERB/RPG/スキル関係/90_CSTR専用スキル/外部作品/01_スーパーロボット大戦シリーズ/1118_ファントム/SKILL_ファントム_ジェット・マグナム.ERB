;ゲシュペンスト・ファントム専用スキル。
;単体電撃物理、威力450、MP35、ランク13

;スキル名
@SKILL_NAME_ジェット・マグナム,ARG
RESULTS = 제트 매그넘

;　명중
@SKILL_HITRATE_ジェット・マグナム, ARG
RETURN 100

;　威力
@SKILL_POWER_ジェット・マグナム, ARG
RETURN 450

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ジェット・マグナム,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ジェット・マグナム,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ジェット・マグナム, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ジェット・マグナム,ARG
RETURN 35

;　相性
@SKILL_TYPE_ジェット・マグナム,ARG
RETURN GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ジェット・マグナム
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ジェット・マグナム,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ジェット・マグナム,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ジェット・マグナム,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ジェット・マグナム,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ジェット・マグナム,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_ジェット・マグナム, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ジェット・マグナム
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_ジェット・マグナム
RETURN GET_SUCCESSION_NUM("전격")

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_ジェット・マグナム,ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_ジェット・マグナム,ARG
RETURN GET_TYPE_NUM("전격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_ジェット・マグナム,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_ジェット・マグナム,ARG
RETURN 95
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ジェット・マグナム,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;単体攻撃
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_ジェット・マグナム,ARG
PRINTL 왼팔의 플라즈마 스테이크를 대전시켜 적을 후려친다.
PRINTL 적 단체에 전격 상성의 물리 특대 데미지. 확률에 따라 SHOCK 상태로 만든다.

@SKILL_EXPLAIN_TOOLTIP_ジェット・マグナム, ARG
RESULTS:0 = 왼팔의 플라즈마 스테이크를 대전시켜 적을 후려친다.
RESULTS:1 = 적 단체에 전격 상성의 물리 특대 데미지. 확률에 따라 SHOCK 상태로 만든다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ジェット・マグナム,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_ジェット・マグナム, ARG = -1
RETURN 13
