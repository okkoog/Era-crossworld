;====================================================
;コマンド実行
;====================================================
@INPUT_COM_戦術詠唱γ,ARG
#LOCALSIZE 2
#DIM SKILL_NUM
#DIM T_SKILL_COST
SKILL_NUM = PU_SKILLNUM_GET(ARG,"戦術詠唱γ")
IF SKILLGAGE_F_GET(ARG,SKILL_NUM) > -1
	LOCAL = CFLAG:ARG:입력행동
	CALL PRINT_ACT_MESSAGE, ARG, SKILL_NUM
	CALL ACTION_戦術詠唱γ,ARG
	CALL BATTLE_EVENT_ACT, ARG
	CFLAG:ARG:입력행동 = LOCAL
ELSEIF SKILLGAGE_F_GET(ARG,SKILL_NUM) < 0 && TOINT(CSTR:ARG:102) > 3
	;スキル一覧を表示して、追加行動で使用するスキルを選択する
	;ただし、表示するスキルはMAGICに該当する物のみに限定する
	;魔法はCLOSEだと使えない
	IF CFLAG:ARG:상태이상 == GET_STATE_NUM("CLOSE")
		CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,0
		RETURN -1
	ENDIF
	CALL INPUT_COM_DO_SKILL, ARG, "MA", "UNABLE_SKILL_戦術詠唱γ"
	IF RESULT <= 0
		CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,(SKILLGAGE_H_GET(ARG,SKILL_NUM) / 10000) * 10000
		RETURN -1
	ELSE	
		;追加行動分のターゲットと追加行動の内容を設定
		CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,(RESULT:1*10000) + RESULT
	ENDIF
ENDIF
RETURN -1
;-1 再びコマンド選択へ
; 1 キャラ選択へ

@UNABLE_SKILL_戦術詠唱γ, ARG, ARG:1
#DIM L_COST
IF GROUPMATCH(SKILL_NAME_F(ARG), "悪魔召喚", "초래의무도", "사바트마")
	RESULTS = 지정 불가 스킬
	RETURN 0
ENDIF
;コスト確認
CALL GET_SKILL_COST, ARG, ARG:1
L_COST = RESULT
SIF CFLAG:(ARG:1):입력행동 > -1
	CALL GET_SKILL_COST, CFLAG:(ARG:1):입력행동, ARG:1
L_COST += RESULT
CALL GET_SKILL_PROP, "SKILL_COSTTYPE", ARG, ARG:1
IF GET_SKILL_COST_TYPE(RESULT) == "MP"
	IF BASE:(ARG:1):ＭＰ < L_COST
		RESULTS = 코스트 부족: MP
		RETURN 0
	ENDIF
ELSEIF GET_SKILL_COST_TYPE(RESULT) == "HP"
	IF BASE:(ARG:1):ＨＰ < L_COST
		RESULTS = 코스트 부족: HP
		RETURN 0
	ENDIF
ELSE
	RETURN 0
ENDIF
RETURN 1
