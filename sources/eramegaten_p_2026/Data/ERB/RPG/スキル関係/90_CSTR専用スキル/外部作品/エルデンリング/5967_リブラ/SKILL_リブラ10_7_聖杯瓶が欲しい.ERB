;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_聖杯瓶が欲しい, ARG, ARG:1, ARG:2
#DIM DYNAMIC L_T
L_T = POS(ARG:1)
CALL HEAL_SINGLE, ARG, L_T, ARG:2, 1
IF CFLAG:L_T:최대HP증가 > -20
	CFLAG:L_T:최대HP증가 = -20
	CFLAG:L_T:ＨＰ보정 = -20
	CALL SYNC_STATUS,L_T,"HPMP割合保持"
	CALL PRINT_HIT_MESSAGE, L_T, @"최대ＨＰ가 감소했다", "W"
ELSE
	CALL PRINT_HIT_MESSAGE, L_T, "효과가 없었다", "W"
ENDIF

@SKILL_TARGETABLE_聖杯瓶が欲しい, ARG, ARG:1
SIF ARG == ARG:1
	RETURN 0
RETURN 1

