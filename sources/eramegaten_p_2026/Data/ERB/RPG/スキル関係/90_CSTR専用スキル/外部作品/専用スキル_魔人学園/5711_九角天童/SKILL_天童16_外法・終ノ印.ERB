@DISPLAY_COMMAND_P_外法・終ノ印,ARG
RESULTS '= SET_COLOR_TAG(@"外法印　{PU_SKILLGAGE_H_GET(ARG, "外法・終ノ印"),3}％", "#dc143c")
RETURN 3

@SKILL_EX_DISPLAY_外法・終ノ印,ARG,ARGS
IF PU_SKILLGAGE_H_GET(ARG, "外法・終ノ印") >= 100
	RESULTS += SET_COLOR_TAG("★", "RED")
	RESULTS += SET_COLOR_TAG(@"%" ready", SKILL_EX_DISPLAY_LENS - 2, LEFT%", "RED")
	RESULTS:1 = 外法印完成
ELSE
	RESULTS += SET_COLOR_TAG("★", "RED")
	RESULTS += HTML_RECT_BAR(PU_SKILLGAGE_H_GET(ARG, "外法・終ノ印"), 100, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("緑"), RESULT:1)
	RESULTS:1 = 外法印
ENDIF
RETURN 1

