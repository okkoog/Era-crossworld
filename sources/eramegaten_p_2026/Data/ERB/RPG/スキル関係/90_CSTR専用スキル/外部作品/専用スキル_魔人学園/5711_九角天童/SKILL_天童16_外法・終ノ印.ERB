;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_外法・終ノ印,ARG,ARG:1
#DIM SKILL_NUM
#DIM L_GP
SKILL_NUM = PU_SKILLNUM_GET(ARG,"外法・終ノ印")
L_GP = 0
;自分の行動の場合
IF ARG == ARG:1
	;毎ターン＋10
	L_GP += 10
	SIF IS_PU_SKILL_入力行動(ARG, "外法・終ノ印")
		L_GP += 30
ELSE
ENDIF

CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,MIN(L_GP+SKILLGAGE_H_GET(ARG,SKILL_NUM) , 100)
IF SKILLGAGE_H_GET(ARG,SKILL_NUM)  == 100
	RESULTS = 外法印完成！
	RESULT:1 = 0xdc143c
ELSE
	RESULTS = 외법인 게이지
ENDIF
RESULTS:1 = \%
RETURN L_GP
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_外法・終ノ印,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"外法・終ノ印")
PRINTFORML %CALLNAME:ARG%(은)는 집중하여 인을 맺고 있다!

