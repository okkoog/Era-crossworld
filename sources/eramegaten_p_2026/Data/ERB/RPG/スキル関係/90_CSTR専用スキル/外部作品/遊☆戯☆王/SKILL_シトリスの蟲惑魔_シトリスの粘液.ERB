;シトリスの蟲惑魔専用スキル。丸かじりにPALYZE追加して消費+10
;スキル名
@SKILL_NAME_シトリスの粘液,ARG
RESULTS = 시트리스의 점액

;　명중
@SKILL_HITRATE_シトリスの粘液, ARG
RETURN 100

;　威力
@SKILL_POWER_シトリスの粘液, ARG
RETURN 410

;　최저공격횟수
@SKILL_MINATTACKNUMBER_シトリスの粘液,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_シトリスの粘液,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_シトリスの粘液, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_シトリスの粘液,ARG
RETURN 44

;　相性
@SKILL_TYPE_シトリスの粘液,ARG
RETURN GET_TYPE_NUM("전술")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_シトリスの粘液
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_シトリスの粘液,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_シトリスの粘液,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_シトリスの粘液,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_シトリスの粘液,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_シトリスの粘液,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_シトリスの粘液, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_シトリスの粘液
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_シトリスの粘液
RETURN GET_SUCCESSION_NUM("전술")

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_シトリスの粘液,ARG
RETURN GET_STATE_NUM("PALYZE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_シトリスの粘液,ARG
RETURN GET_TYPE_NUM("신경")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_シトリスの粘液,ARG
RETURN 15

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_シトリスの粘液,ARG
RETURN 95
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_シトリスの粘液,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;全体攻撃
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_シトリスの粘液,ARG
PRINTL 적 전체에 전기 속성의 특대 물리 데미지.
PRINTL 확률로 PALYZE 상태로 만든다. 후열 사용 가능.

@SKILL_EXPLAIN_TOOLTIP_シトリスの粘液, ARG
RESULTS:0 = 적 전체에 전기 속성의 특대 물리 데미지.
RESULTS:1 = 확률로 PALYZE 상태로 만든다. 후열 사용 가능.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_シトリスの粘液,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_シトリスの粘液, ARG = -1
RETURN 14

