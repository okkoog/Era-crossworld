;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_筆洗, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "ATK"
		RETURN LIMIT(CFLAG:ARG:공격강화 + CFLAG:ARG:회피강화, -48, 64), 32
ENDSELECT

