;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_影舞・酬, ARG, ARG:1, ARG:2
SIF ARG:2 < -1
	RETURN 0
TFLAG:스킬용1 = 1
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "크리티컬", -1, "短縮", "NOMES"

;CFLAG:(ARG:1):크리티컬강화 = MAX(-4, CFLAG:(ARG:1):크리티컬강화 - 1)
;PRINT  & 与クリティカル率ダウン



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_影舞・酬, ARG, ARG:1,SKILL_NUM
#DIM SKILL_NUM
TFLAG:스킬용1 = 0
CALL ATTACK_FIELD, ARG, ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
SIF TFLAG:스킬용1 > 0
	CALL SKILLGAGE_D_SET,ARG,[[스킬:분노폭발]],0

