;-------------------------------------------------------------------------------
;명상
;-------------------------------------------------------------------------------
;吸収禁止令出されているので、代わりに魔法威力下げます
;MPダメージの方だけは考えたけど、ありません


;スキル名
@SKILL_NAME_衝撃,ARG
RESULTS = 충격

;　명중
@SKILL_HITRATE_衝撃, ARG
RETURN 95

;　威力
@SKILL_POWER_衝撃, ARG
RETURN 150

;　최저공격횟수
@SKILL_MINATTACKNUMBER_衝撃,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_衝撃,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_衝撃, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_衝撃,ARG
RETURN 22

;　相性
@SKILL_TYPE_衝撃,ARG
RETURN GET_TYPE_NUM("만능")


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_衝撃
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_衝撃, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_衝撃,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_衝撃,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_衝撃,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_衝撃, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_衝撃
RETURN GET_SUCCESSION_NUM("만능")

@継承不能_衝撃
RETURN 1
;不可

;속도보정
@SKILL_SPEED_衝撃, ARG = -1
RETURN -5


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_衝撃
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_衝撃, ARG = -1
RETURN 10



;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_衝撃, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "마법위력", -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_衝撃,ARG,ARG:1,ARG:2
#LOCALSIZE 2
CALL ATTACK_SINGLE, ARG, POS(ARG:1), ARG:2

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_衝撃
PRINTL 적 1체에게 데미지를 가하고 마법 위력을 저하시킨다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_衝撃,ARG
RETURN 1
;とくにない

