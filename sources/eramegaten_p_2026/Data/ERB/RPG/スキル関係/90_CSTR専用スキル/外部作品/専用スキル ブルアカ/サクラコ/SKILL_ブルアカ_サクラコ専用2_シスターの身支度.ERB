@SKILL_TRIGGER_ACTIONABLE_シスターの身支度,ARG,ARG:1
;自分じゃなければNG
SIF FLAG:행동순1 != ARG
	RETURN 0
;判定は1回
SIF ARG != ARG:1
	RETURN 0
;クリティカルを受けているキャラを探す
SIF !GET_CREC_ACT(ARG, , "CRT")
	RETURN 0
;50%
SIF RAND:2
	RETURN 0
RETURN 1

