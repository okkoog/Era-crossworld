@DISPLAY_COMMAND_P_四枝の浅瀬,ARG
SELECTCASE PU_SKILLGAGE_H_GET(ARG,"四枝の浅瀬")
	CASE 0
		RESULTS = 거츠:★★★
	CASE 1
		RESULTS = 거츠:★★☆
	CASE 2
		RESULTS = 거츠:★☆☆
	CASEELSE
		RESULTS = 거츠:☆☆☆
ENDSELECT
RETURN 3


