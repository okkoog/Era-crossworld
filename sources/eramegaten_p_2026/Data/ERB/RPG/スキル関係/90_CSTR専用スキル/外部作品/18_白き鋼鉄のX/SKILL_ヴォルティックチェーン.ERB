;　威力
@SKILL_POWER_ヴォルティックチェーン, ARG
#DIM DIVA_F
#DIM DIVA_H
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	IF CFLAG:ARG:気合フラグ > 0
		SELECTCASE FLAG:확산플래그
		CASE 1
			RETURN 370
		CASE 2
			RETURN 420
		CASE 3
			RETURN 450
		CASE 4
			RETURN 470
		CASE 5 TO 10
			RETURN 500
		CASE 999
			RETURN 150
		CASEELSE
			RETURN 360
		ENDSELECT
	ELSE
		SELECTCASE FLAG:확산플래그
		CASE 1
			RETURN 390
		CASE 2
			RETURN 440
		CASE 3
			RETURN 460
		CASE 4
			RETURN 480
		CASE 5 TO 10
			RETURN 510
		CASE 99
			RETURN 80
		CASEELSE
			RETURN 400
		ENDSELECT
	ENDIF
ELSE
	IF DIVA_F == 1 || DIVA_H == 1
		SELECTCASE FLAG:확산플래그
		CASE 1
			RETURN 390
		CASE 2
			RETURN 440
		CASE 3
			RETURN 460
		CASE 4
			RETURN 480
		CASE 5 TO 10
			RETURN 510
		CASE 99
			RETURN 80
		CASEELSE
			RETURN 400
		ENDSELECT
	ELSE
		SELECTCASE FLAG:확산플래그
		CASE 1
			RETURN 400
		CASE 2
			RETURN 450
		CASE 3
			RETURN 480
		CASE 4
			RETURN 510
		CASE 5 TO 10
			RETURN 540
		CASEELSE
			RETURN 400
		ENDSELECT
	ENDIF
ENDIF

