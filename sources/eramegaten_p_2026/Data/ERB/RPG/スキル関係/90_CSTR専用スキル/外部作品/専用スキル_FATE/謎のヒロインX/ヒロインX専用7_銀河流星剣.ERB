;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_銀河流星剣, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM TOTAL_DMG_B
;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			SIF SKILLGAGE_D_GET(L_ACTOR,SKILL_NUM) < 4
				RETURN 0
			CALL SABER_CHECK(L_ACTOR, L_TARGET)
			SIF !RESULT
				RETURN 0
			RESULTS = 세이버 특효
			RETURN 50
	ENDSELECT
ENDIF

@SABER_CHECK,ARG,ARG:1
;セイバーとして認識されるのはFGO側でセイバーとして扱われた悪魔、後はEXTRA勢で剣とか持ってそうな奴
;後は刀、レイピア、剣の装備持ってる奴もセイバー認定される
;クラススキル「セイバー」を所持していなくても、CFLAG:(ARG:1):専用技のどこかに設定されていれば問答無用で特効対象
SIF PU_SKILL_CHECK(ARG:1,"セイバー")
	RETURN 1
SELECTCASE NO:(ARG:1)
	CASE [[キャラ:파랑세이버]],[[キャラ:빨강세이버]],[[キャラ:라마]],[[キャラ:지크프리트]],[[キャラ:아서]],[[キャラ:수르트]],[[キャラ:사야카]],[[キャラ:요우무]],[[キャラ:모미지_동방]],[[キャラ:텐시]],[[キャラ:요리히메]],[[キャラ:Ａ・치르노]],[[キャラ:락슈미]]
		RETURN 1
ENDSELECT
RESULT = 0
TRYCALLFORM 剣タイプ_{EQUIP:(ARG:1):검}
SELECTCASE RESULT
	CASE 1,2,4
		RETURN 1
ENDSELECT
RETURN 0
