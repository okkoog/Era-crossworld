;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_銀河流星剣,ARG,ARG:1
#LOCALSIZE 1
#DIM SKILL_NUM

SKILL_NUM = PU_SKILLNUM_GET(ARG,"銀河流星剣")
SIF ARG != FLAG:행동순1
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
SIF SKILLGAGE_D_GET(ARG,SKILL_NUM) < 4
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
SIF RESULT != 1 || CFLAG:ARG:타겟 < 1
	RETURN 0
SELECTCASE CFLAG:ARG:타겟
	CASE IS < 17
		CALL SABER_CHECK,ARG,POS(CFLAG:ARG:타겟)
		SIF RESULT == 1
			RETURN 1
	CASE IS < 20
		FOR LOCAL,1,7
			CALL SABER_CHECK,ARG,POS(LOCAL)
			SIF RESULT == 1
				RETURN 1
		NEXT
	CASEELSE
		FOR LOCAL,7,17
			CALL SABER_CHECK,ARG,POS(LOCAL)
			SIF RESULT == 1
				RETURN 1
		NEXT
ENDSELECT
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_銀河流星剣,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"銀河流星剣")

IF SKILLGAGE_D_GET(ARG,SKILL_NUM) == 0
	CALL SKILLGAGE_D_SET,ARG,SKILL_NUM,6
	PRINTL 세이버에 해당하는 대상을 공격했을 때 크리티컬률이 조금 상승하는 상태가 되었다!
	IF TOINT(CSTR:ARG:102) > 3
		PRINTL 또한 세이버에 해당하는 대상을 공격했을 때 데미지가 증가하는 상태가 되었다!
		PRINTFORMW %CALLNAME:ARG%의 공격력이 크게 상승했다!
		CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 8, "단체", "NOMES"
	ELSE
		PRINTW 또한 세이버에 해당하는 대상을 공격했을 때 데미지가 증가하는 상태가 되었다!
	ENDIF
ELSEIF SKILLGAGE_D_GET(ARG,SKILL_NUM) > 3
	CALL SKILL_SET_カジャンダ, ARG, ARG, "크리티컬", 2, "단체", "NOMES"
	PRINTFORML 세이버 특효!
	PRINTFORML %CALLNAME:ARG%의 크리티컬률이 조금 올랐다!
	PRINTFORM 　　TARGET:[{CPOS(ARG:1),2}] %CALLNAME:(ARG:1),20,LEFT%　>>>>>>　
ENDIF

