;スキル名
@SKILL_NAME_クライム・バレエ,ARG
RESULTS = 크라임 발레

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_クライム・バレエ,ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

;スキル変化？用ランク
@SKILL_RANK_クライム・バレエ, ARG = -1
RETURN 1
;変化不可

;계승타입
@SKILL_SUCCESSION_TYPE_クライム・バレエ
RETURN GET_SUCCESSION_NUM("자동효과")
;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_クライム・バレエ,ARG
#DIM SKILL_NUM
PRINTL 자동효과:명중률과 회피율이 대폭 상승한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_クライム・バレエ,ARG
RETURN 0
;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_クライム・バレエ, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		CASE "追加命中強化"
			RETURN 8
	ENDSELECT
;自分が防御側
ELSE
	SELECTCASE ARGS
		CASE "追加回避強化"
			RETURN 8
	ENDSELECT
ENDIF
RETURN 0
