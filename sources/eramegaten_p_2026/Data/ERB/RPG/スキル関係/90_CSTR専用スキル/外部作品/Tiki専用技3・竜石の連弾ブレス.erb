;;拡散攻撃用追加処理
;;ブレスなどの拡散攻撃に使う
;@SKILL_SPREAD_竜石の連弾ブレス,ARG
;RETURN 0
;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_竜石の連弾ブレス, ARG = -1, ARG:1 = -1
SIF TFLAG:스킬용1
	RETURN 0
RETURN 4

;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_竜石の連弾ブレス,ARG,ARG:1,ARG:2
SIF ARG:2 < -1
	RETURN 0
SELECTCASE SKILLGAGE_H_GET(ARG, PU_SKILLNUM_GET(ARG,"竜石変化"))
	CASE 1
		CALL SKILL_GUARD_KILL, ARG, "화염", CPOS(ARG:1), 2, "短縮"
	CASE 2
		CALL SKILL_GUARD_KILL, ARG, "빙결", CPOS(ARG:1), 2, "短縮"
	CASE 3
		CALL SKILL_GUARD_KILL, ARG, "비구", CPOS(ARG:1), 2, "短縮"
		TFLAG:스킬용1 = 1
	CASE 4
		IF GETBIT(FLAG:확산플래그,CPOS(ARG:1)) == 0
			CALL SKILL_SET_カジャンダ, ARG, ARG:1, "마법효과", -4, "短縮"
			SETBIT FLAG:확산플래그,CPOS(ARG:1)
		ENDIF
ENDSELECT

