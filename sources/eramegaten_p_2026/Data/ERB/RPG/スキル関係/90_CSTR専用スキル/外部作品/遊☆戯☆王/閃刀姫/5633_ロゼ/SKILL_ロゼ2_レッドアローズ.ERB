;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_レッドアローズ,ARG,ARG:1
#DIM LCOUNT
;判定は一回
SIF ARG != ARG:1
	RETURN 0
;自分自身の行動でないと誘発しない
SIF ARG != FLAG:행동순1
	RETURN 0
SIF !IS_PU_SKILL_入力行動(ARG, "レッドアローズ")
	RETURN 0
FOR LCOUNT, 1, 7
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	SIF !IS_SENTOUKI_REI(POS(LCOUNT))
		CONTINUE
	SIF HAVE_PU_SKILL(POS(LCOUNT), "召喚時効果_カガリ")
		RETURN 1, LCOUNT
	SIF HAVE_PU_SKILL(POS(LCOUNT), "召喚時効果_シズク")
		RETURN 1, LCOUNT
	SIF HAVE_PU_SKILL(POS(LCOUNT), "召喚時効果_ハヤテ")
		RETURN 1, LCOUNT
	SIF HAVE_PU_SKILL(POS(LCOUNT), "召喚時効果_カイナ")
		RETURN 1, LCOUNT
NEXT
RETURN 0

