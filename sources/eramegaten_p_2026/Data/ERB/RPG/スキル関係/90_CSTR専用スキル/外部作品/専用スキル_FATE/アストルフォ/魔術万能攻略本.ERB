;入場時に行う効果
@SKILL_BATTLE_ENTER_魔術万能攻略本, ARG
#DIM LCOUNT
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;入場一回目のみ発動
SIF CFLAG:ARG:입장플래그 != 1
	RETURN 0
;自身の入場のみで発動
SIF TFLAG:입장캐릭터 >= 0 && TFLAG:입장캐릭터 != ARG
	RETURN 0
IF FLAG:월령 == 0
	CALL PRINT_ACT_MESSAGE, ARG, , , , "破却宣言"
	CALL SKILL_SET_カジャンダ, ARG, ARG, "크리티컬", 4, "단체"
ELSE
	VARI TEMP, 2
	TEMP = RAND:100, RAND:100
	;アストルフォだけ防御が二段階上昇
	CALL PRINT_ACT_MESSAGE, ARG, , , , "魔術万能攻略本"
	IF TEMP < 40 && TEMP:1 < 40
		CALL PRINT_HIT_MESSAGE, ARG, "なにもおきなかった…"
	ELSE
		IF TEMP < 40
		ELSEIF TEMP < 90
			CALL SKILL_SET_カジャンダ, ARG, ARG, "방어", 4, "단체", "NOWAIT", "防御が上がった！"
		ELSE
			CALL SKILL_SET_カジャンダ, ARG, ARG, "방어", -4, "단체", "NOWAIT", "防御が下がってしまった！？"
		ENDIF
		IF TEMP:1 < 40
		ELSEIF TEMP:1 < 90
			CALL SKILL_SET_カジャンダ, ARG, ARG, "마법효과", 4, "단체", "NOWAIT", "魔法効果が上がった！"
		ELSE
			CALL SKILL_SET_カジャンダ, ARG, ARG, "마법효과", -4, "단체", "NOWAIT", "魔法効果が下がってしまった！？"
		ENDIF
	ENDIF
ENDIF
