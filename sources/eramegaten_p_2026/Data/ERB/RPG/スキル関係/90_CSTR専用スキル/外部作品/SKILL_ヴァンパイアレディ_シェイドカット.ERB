;물어-뜯기　命中90　威力150　攻撃回数1-1　消費24　검격+주살　対象の防御力を1段階下げる
;参考：牙折り　命中95　威力240　攻撃回数1-1　消費10　전술　対象の攻撃力を1段階下げる
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_シェイドカット,ARG
RESULTS = 셰이드 컷

;　명중
@SKILL_HITRATE_シェイドカット, ARG
RETURN 90

;　威力
@SKILL_POWER_シェイドカット, ARG
RETURN 150

;　최저공격횟수
@SKILL_MINATTACKNUMBER_シェイドカット,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_シェイドカット,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_シェイドカット, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_シェイドカット,ARG
RETURN 12

;　複合相性
@SKILL_TYPE_シェイドカット,ARG
RETURN GET_TYPE_NUM("검격"), GET_TYPE_NUM("주살")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_シェイドカット
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　攻撃タイプ
@SKILL_ATTACKTYPE_シェイドカット,ARG
RETURN GET_攻撃タイプ_NUM("物理")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_シェイドカット, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_シェイドカット,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_シェイドカット,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_シェイドカット,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_シェイドカット, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_シェイドカット
RETURN GET_SUCCESSION_NUM("검격")

;スキル変化？用ランク
@SKILL_RANK_シェイドカット, ARG = -1
RETURN 5

;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_シェイドカット, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어", -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_シェイドカット,ARG,ARG:1,ARG:2
CALL ATTACK_SINGLE, ARG, POS(ARG:1),ARG:2

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_シェイドカット,ARG
PRINTL 음의 마력을 담은 일격으로 적을 베어 가른다. 검격+주살 상성으로 공격하고 대상의 방어력을 낮춘다

;使用条件
@SKILL_SPECIAL_ACTIONABLE_シェイドカット,ARG
RETURN 1
;とくにない
