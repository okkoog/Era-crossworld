@SKILL_RANK_マジシャンズ・サルベーション, ARG = -1
RETURN 11


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_マジシャンズ・サルベーション,ARG,ARG:1,ARG:2
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC IS_DONE
L_CHARA = ARG:1
CALL SKILL_CURE_STATE_マジシャンズ・サルベーション,CFLAG:L_CHARA:상태이상
IF RESULT == 1
	CALL PRINT_HIT_MESSAGE, L_CHARA, @"ＨＰ회복{MAXBASE:L_CHARA:ＨＰ}", "L"
	CFLAG:L_CHARA:상태이상 = 0
	CFLAG:L_CHARA:상태이상경과턴수 = 0
	CALL VAR_HP,L_CHARA,MAXBASE:L_CHARA:ＨＰ
	IF GET_RACE(ABL:L_CHARA:종족) == "요마"		
		FOR LCOUNT, 0, VARSIZE("KAJA_TABLE")
			IF KAJA_TABLE:LCOUNT == "BS부착률"
				SIF CFLAG:ARG:(KAJA_TABLE:LCOUNT + "강화") >= 0
					CONTINUE
				CALL SKILL_SET_カジャンダ, ARG, L_CHARA, KAJA_TABLE:LCOUNT, -CFLAG:ARG:(KAJA_TABLE:LCOUNT + "강화"), "단체", "NOMES"
			ELSE
				SIF CFLAG:ARG:(KAJA_TABLE:LCOUNT + "강화") <= 0
					CONTINUE
				CALL SKILL_SET_カジャンダ, ARG, L_CHARA, KAJA_TABLE:LCOUNT, CFLAG:ARG:(KAJA_TABLE:LCOUNT + "강화"), "단체", "NOMES"
			ENDIF
			IS_DONE = 1
		NEXT
		SIF IS_DONE
			CALL PRINT_HIT_MESSAGE, L_CHARA, "能力を強化！", "L"
	ENDIF
ELSE
	CALL PRINT_HIT_MESSAGE, POS(ARG:1), @"효과가 없었다", "L"
ENDIF
WAIT
;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_マジシャンズ・サルベーション,ARG
PRINTL 사망한 아군 1명의 체력을 완전 회복시키고 소생한다.
PRINTL 또한 대상이 【요마】일 경우 자신이 지닌 능력 강화를 복사하여 부여한다.

@SKILL_EXPLAIN_TOOLTIP_マジシャンズ・サルベーション, ARG
RESULTS:0 = 사망한 아군 1명의 체력을 완전 회복시키고 소생한다.
RESULTS:1 = 또한 대상이 【요마】일 경우 자신이 지닌 능력 강화를 복사하여 부여한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_マジシャンズ・サルベーション,ARG
RETURN 1
