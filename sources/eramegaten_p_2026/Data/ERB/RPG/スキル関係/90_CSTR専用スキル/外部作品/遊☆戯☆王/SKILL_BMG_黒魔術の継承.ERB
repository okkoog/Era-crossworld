PRINTL 자동효과:「DYING」・「요마」・「남성」 조건을 만족하는 악마 1체당 3%의 마법 데미지 증가 효과를 얻는다 (상한 30%)

@SKILL_EXPLAIN_TOOLTIP_黒魔術の継承, ARG
RESULTS = 자동효과:「DYING」・「요마」・「남성」 조건을 만족하는 악마 1체당 3%의 마법 데미지 증가 효과를 얻는다 (상한 30%)

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_黒魔術の継承, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM DYNAMIC L_P;スキルの持ち主=自分
#DIM DYNAMIC L_ACTOR;攻撃者(どちらかは自分になる)
#DIM DYNAMIC L_TARGET;攻撃対象(どちらかは自分になる)
#DIM DYNAMIC SKILL_NUM;スキル番号(専用技用)
#DIMS DYNAMIC L_相性名;ダメージ計算に使用されている相性の名称
#DIM DYNAMIC L_相性値;相性の倍率(999が反射のあれ)
#DIMS DYNAMIC L_ダメージタイプ;物理/魔法
#DIMS DYNAMIC L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS DYNAMIC L_ステート名;バステの名称
#DIM DYNAMIC L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM DYNAMIC GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_RESULT

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			IF L_ダメージタイプ == "魔法"
				FOR LCOUNT, 0, BCHARANUM
					SIF GET_RACE(ABL:(BCHARA:LCOUNT):종족) != "요마"
						CONTINUE
					SIF !IS_BADSTATE(BCHARA:LCOUNT, "DYING")
						CONTINUE
					SIF !IS_MALE(BCHARA:LCOUNT)
						CONTINUE
					L_RESULT += 3
				NEXT
			ENDIF
			RETURN MIN(L_RESULT, 30)
	ENDSELECT
ENDIF
RETURN 0

;使用条件
@SKILL_SPECIAL_ACTIONABLE_黒魔術の継承,ARG
RETURN 0

