;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_変身・覚醒！／スタービーナスビリビリーム,ARG,ARG:1
#DIM SKILL_NUM
#DIM L_GP
#DIM L_T
SKILL_NUM = PU_SKILLNUM_GET(ARG,"変身・覚醒！／スタービーナスビリビリーム")
L_GP = 0
IF SKILLGAGE_H_GET(ARG,SKILL_NUM) < 1 && SKILLGAGE_F_GET(ARG,SKILL_NUM) < 100
	;自分の行動の場合
	IF ARG == ARG:1
		;ダメージを受けた敵の数に応じてスキルゲージアップ
		FOR LOCAL,0, BCHARANUM
			L_T = BCHARA:LOCAL
			IF CFLAG:L_T:현데미지 > 0
				L_GP += 3
				IF CFLAG:L_T:피탄횟수 > 1
					SELECTCASE CFLAG:ARG:입력행동
						CASE PU_SKILLNUM_GET(ARG,"変身・覚醒！／スタービーナスビリビリーム")
							;スタービーナスビリビリームの場合はゲージが増加しない
						CASEELSE
							L_GP += (3*CFLAG:L_T:피탄횟수)
					ENDSELECT
				ENDIF
			ELSE
				CONTINUE
			ENDIF
			;会心、弱点を出すとさらにアップ
			SIF GET_CREC_ACT(ARG, L_T, "CRT")
				L_GP += 10
			SIF GET_CREC_ACT(ARG, L_T, "WEAK")
				L_GP += 10
		NEXT
	ENDIF
	;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
	;怒りゲージが増える
	IF GET_CREC_ACT(ARG:1, ARG, "HIT")
		LOCAL = 60 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ
		;LOCAL = LOCAL < 2 ? 2 # LOCAL
		L_GP += MAX(LOCAL, 2)
	ENDIF
	;スキルゲージが100以上だと100にする
	CALL SKILLGAGE_F_SET, ARG,SKILL_NUM, MIN(L_GP + SKILLGAGE_F_GET(ARG,SKILL_NUM), 100)
	IF SKILLGAGE_F_GET(ARG,SKILL_NUM) == 100
		RESULTS = 変身・覚醒準備完了！
		RESULT:1 = 0x7fffd4
	ELSE
		RESULTS = EXE DRIVE
	ENDIF
	RESULTS:1 = \%
	RETURN L_GP
ENDIF
RETURN 0

