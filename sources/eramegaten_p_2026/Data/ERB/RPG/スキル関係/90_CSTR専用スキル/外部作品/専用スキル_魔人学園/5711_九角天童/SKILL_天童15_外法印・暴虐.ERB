@SKILL_DECIDE_TYPE_外法印・暴虐
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_ATTACKTYPE_外法印・暴虐, ARG
SIF ARG < 0
	RETURN 0
RETURN 1 + (MAXBASE:ARG:마법위력 > MAXBASE:ARG:공격)

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_外法印・暴虐,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_外法印・暴虐,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_外法印・暴虐,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_外法印・暴虐,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_外法印・暴虐,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_外法印・暴虐
RETURN GET_SUCCESSION_NUM("만능")

;속도보정
@SKILL_SPEED_外法印・暴虐, ARG = -1
