@SKILL_HITRATE_外法印・暴虐, ARG
RETURN 100

;　威力
@SKILL_POWER_外法印・暴虐, ARG
RETURN 500

;　최저공격횟수
@SKILL_MINATTACKNUMBER_外法印・暴虐, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_外法印・暴虐, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_外法印・暴虐,ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
