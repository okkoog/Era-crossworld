;スキル名
@SKILL_NAME_防御姿勢強化,ARG
RESULTS = 防御姿勢強化

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_防御姿勢強化, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_防御姿勢強化,ARG
RETURN 15

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_防御姿勢強化
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_防御姿勢強化, ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　範囲　単体　一列　全体　敵味方全体　縦列
@SKILL_SPHERE_防御姿勢強化,ARG
RETURN GET_SPHERE_NUM("적아군전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_防御姿勢強化, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;계승타입
@SKILL_SUCCESSION_TYPE_防御姿勢強化
RETURN GET_SUCCESSION_NUM("방어")

;속도보정
@SKILL_SPEED_防御姿勢強化, ARG = -1
RETURN 0

;スキルランク
;スキルの習得時の必要ＭＡＧの算出に主に用いられる
;また、習得・所持スキルはこのランクの5倍のレベルを基準として設定する。
@SKILL_RANK_防御姿勢強化, ARG = -1
RETURN 5

;====================================================
;スキル及び行動の実行
;ARG = スキルの使用者
;ARG:1 = スキルの使用対象
;ARG:2 = スキルの番号
;====================================================
@ACTION_防御姿勢強化, ARG, ARG:1, ARG:2
;魔法効果のみに依存するディアラマ相当
CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 8, "단체", "NOWAIT"
CALL SKILL_SET_全体HPバリア, ARG, 200 * GET_BASEHEAL_IN_CALC(MAXBASE:ARG:마법효과, MAXBASE:ARG:마법효과) / 100, "遮蔽物"

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_防御姿勢強化, ARG
PRINTL 엄폐물을 전개하여 아군 전체로 향하는 데미지를 방지한다.
PRINTL 방지할 수 있는 데미지량은 마법 효과에 의존한다.
PRINTL 추가로 자신의 공격력을 대폭 상승시킨다.

;ツールチップ版の解説文
@SKILL_EXPLAIN_TOOLTIP_防御姿勢強化, ARG
RESULTS:0 = 엄폐물을 전개하여 아군 전체로 향하는 데미지를 방지한다.
RESULTS:1 = 방지할 수 있는 데미지량은 마법 효과에 의존한다.
RESULTS:2 = さらに自身の攻撃力を大幅に上昇させる。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_防御姿勢強化,ARG
RETURN 1
