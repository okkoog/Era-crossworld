;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_雷神千破, ARG
	RESULTS = 雷神千破

;　명중
@SKILL_HITRATE_KE_雷神千破, ARG
RETURN 999

;　威力
@SKILL_POWER_KE_雷神千破, ARG
RETURN 150

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_雷神千破, ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_雷神千破, ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_雷神千破, ARG
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 15
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_KE_雷神千破, ARG
IF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 15
	RESULTS = %" 15ＴＰ"%
	RETURN 0
ENDIF
RETURN 5

;　相性
@SKILL_TYPE_KE_雷神千破, ARG
RETURN GET_TYPE_NUM("전격")
;전격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_雷神千破
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_雷神千破, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_雷神千破, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_KE_雷神千破, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_雷神千破, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_雷神千破, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_KE_雷神千破, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_雷神千破
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_KE_雷神千破, ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_KE_雷神千破, ARG
RETURN GET_TYPE_NUM("전격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_KE_雷神千破, ARG
RETURN 10

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_KE_雷神千破, ARG
RETURN 30

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_雷神千破, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;ゲージ再回収できる様に起動前にTP10消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 15, "-="

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_雷神千破, ARG
PRINTL 
PRINTL 늑대기사단에 전해지는 무쌍의 2연 필중 찌르기.
PRINTL 적 단체에 전격 속성으로 공격하여 저확률로 마비시킨다.
PRINTL 
PRINTL 늑대기사 아벤트의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_雷神千破, ARG
;ゲージが10以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 15
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_雷神千破, ARG
RESULTS:0 = 적 단체에 전격 속성으로 공격하여 저확률로 SHOCK을 부여한다.
RESULTS:1 = TP消費 15
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 15
	RESULTS:1 = %RESULTS:1%(不足)