;-------------------------------------------------------
;追撃の発動条件と対象
;自分の行動で敵を倒した時、自分に
;範囲で倒した場合は対象の数だけ発動する
;-------------------------------------------------------
@SKILL_TRIGGER_ACTIONABLE_カースリアクト,ARG,ARG:1
#DIM DYNAMIC L_STOCK
;自分の行動のときのみ追撃
SIF FLAG:행동순1 != ARG
	RETURN 0
;味方相手には発動しない
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
;アクティブスキルとして起動状態にしておく必要がある。
SIF PU_SKILLGAGE_H_GET(ARG,"カースリアクト") < 1
	RETURN 0
;この行動で敵を呪いにすることで発動
SIF !GET_CREC_ACT(ARG, ARG:1, "BAD_STATE", "CURSE")
	RETURN 0
RESULTS '= "闇の疾風"
RETURN 1, CPOS(ARG:1)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_カースリアクト, ARG, ARG:1, ARG:2
;効果時間は1ターン
CALL PU_SKILLGAGE_H_SET, ARG, "カースリアクト", 1
PRINTFORMW %CALLNAME:ARG%(은)는 대상을 저주 상태로 만들었을 경우 추가 행동을 실행하게 되었다!

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_カースリアクト, ARG
PRINTL 적을 저주 상태로 만들었을 경우 추가로 행동을 실행한다

;使用条件
@SKILL_SPECIAL_ACTIONABLE_カースリアクト,ARG
RETURN 1
;とくにない

