;-----------------------------
;デマーシアの正義
;-----------------------------
;スキル名
@SKILL_NAME_デマーシアの正義,ARG
RESULTS = 데마시아의 정의

;　명중
@SKILL_HITRATE_デマーシアの正義, ARG
RETURN 100

;　威力
@SKILL_POWER_デマーシアの正義, ARG
#DIM DYNAMIC L_POWER
SIF ARG < 0
	RETURN 80
L_POWER = 80
SIF HAVE_PU_SKILL(ARG, "デマーシアの勇士LV5")
	L_POWER = 120
SIF HAVE_PU_SKILL(ARG, "デマーシアの勇士LV10")
	L_POWER = 160
SIF HAVE_PU_SKILL(ARG, "デマーシアの勇士LV15")
	L_POWER = 200

;威力補正は100%~400%
SIF TFLAG:스킬용1 > 0
	L_POWER = L_POWER * TFLAG:스킬용1 / 100
RETURN L_POWER

;　최저공격횟수
@SKILL_MINATTACKNUMBER_デマーシアの正義,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_デマーシアの正義,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_デマーシアの正義, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_デマーシアの正義,ARG
SIF ARG < 0
	RETURN 35
SIF HAVE_PU_SKILL(ARG, "デマーシアの勇士LV15")
	RETURN 45
SIF HAVE_PU_SKILL(ARG, "デマーシアの勇士LV10")
	RETURN 60
SIF HAVE_PU_SKILL(ARG, "デマーシアの勇士LV5")
	RETURN 80
RETURN 35

;　相性
@SKILL_TYPE_デマーシアの正義,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_デマーシアの正義
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　攻撃タイプ
@SKILL_ATTACKTYPE_デマーシアの正義,ARG
RETURN GET_攻撃タイプ_NUM("物理")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_デマーシアの正義, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_デマーシアの正義,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_デマーシアの正義,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_デマーシアの正義,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_デマーシアの正義, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_デマーシアの正義
RETURN GET_SUCCESSION_NUM("만능")

;スキル変化？用ランク
@SKILL_RANK_デマーシアの正義, ARG = -1
RETURN 15

;拡散攻撃用追加処理
@SKILL_SPREAD_デマーシアの正義,ARG
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_デマーシアの正義,ARG,ARG:1,ARG:2
TFLAG:스킬용1 = LIMIT(100 - 現HP割合(POS(ARG:1)), 25, 100) * 4 
CALL ATTACK_SKILL, ARG, ARG:1,ARG:2
CALL SKILLGAGE_D_SET, ARG, ARG:2, 6

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_デマーシアの正義,ARG
PRINTL 대상과 주위의 적에게 만능 상성으로 물리 데미지를 준다.
PRINTL 이 스킬의 위력은 대상의 HP가 적을수록 증가한다.
PRINTL 
PRINTL 이 스킬은 사용 후 5턴 동안 사용할 수 없다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_デマーシアの正義,ARG
RESULTS = CT:{PU_SKILLGAGE_D_GET(ARG, "デマーシアの正義")}
SIF PU_SKILLGAGE_D_GET(ARG, "デマーシアの正義")
	RETURN 0
RETURN 1
;とくにない
