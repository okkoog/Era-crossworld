@ACTION_天使の斬撃,ARG,ARG:1,SKILL_NUM
#LOCALSIZE 3
#DIM SKILL_NUM

CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
PRINTL 
IF CFLAG:ARG:집중플래그 > 0 && CFLAG:ARG:気合フラグ > 0
	TFLAG:스킬용1 = 1
	CALL HEAL_FIELD, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, SKILL_NUM
ELSE
	TFLAG:스킬용1 = 2
	CALL HEAL_FIELD, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, SKILL_NUM
ENDIF

