;====================================================
;トリガー発動条件
;====================================================
@SKILL_TRIGGER_ACTIONABLE_堕ちるサロメ,ARG,ARG:1
SIF ARG != FLAG:행동순1
	RETURN 0
;自身は対象外
SIF ARG == ARG:1
	RETURN 0
SIF !PU_SKILLGAGE_D_GET(ARG, "堕ちるサロメ")
	RETURN 0
SIF !GET_CREC_ACT(ARG, ARG:1, "CRT")
	RETURN 0
RETURN 1, CPOS(ARG:1)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_堕ちるサロメ, ARG,ARG:1,ARG:2
IF !FLAG:총공격중
	CALL PU_SKILLGAGE_D_SET, ARG, "堕ちるサロメ", 6
	CALL SKILL_SET_カジャンダ, ARG, ARG, "命中率・クリティカル率", 4, "短縮"
	CALL PRINT_HIT_MESSAGE, ARG, "追撃効果" + TSTR:스킬메시지추가효과, "w"
ELSE
	CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "방어", -4, "단체"
ENDIF
;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_堕ちるサロメ, ARG
PRINTL 자신의 명중률과 크리티컬률을 상승시킨다.
PRINTL 또한 발동 후 5턴 동안 크리티컬을 발생시킬 때마다 이하의 연동효과가 발동한다.
PRINTL 「공격당한 상대의 방어력을 저하시킨다.」

@SKILL_EXPLAIN_TOOLTIP_堕ちるサロメ, ARG
RESULTS:0 = 자신의 명중률과 크리티컬률을 상승시킨다.
RESULTS:1 = 또한 발동 후 5턴 동안 공격 스킬을 성공시킬 때마다 이하의 연동효과가 발동한다.
RESULTS:2 = 「攻撃を受けた相手の防御力を低下させる。」

@SKILL_BATTLE_MAIN_TOOLTIP_堕ちるサロメ, ARG, ARG:1
IF SKILLGAGE_D_GET(ARG,ARG:1) > 0
	RESULTS = □타락하는 살로메
	RESULTS:1 '= "　追撃効果発動中"
ENDIF

