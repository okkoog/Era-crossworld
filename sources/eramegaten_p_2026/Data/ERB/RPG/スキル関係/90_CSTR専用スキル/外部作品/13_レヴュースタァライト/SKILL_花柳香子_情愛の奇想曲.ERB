;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_情愛の奇想曲,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
;CR展開時
IF ARG >= 0 && GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
	ALIGNMENT CENTER
	SETCOLOR 0xdc7b8c
	PRINTL 【ＣＬＩＭＡＸ　ＡＣＴ】
	RESETCOLOR
	ALIGNMENT LEFT

	;パワーアップイベント中かつボスが最終形態時のみ、ボスの不死フラグを剥がして攻撃
	IF GETBIT(イベントフラグ:93:16, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:카오루코]])
		;HPが1まで削れていたら不死身フラグを外して攻撃
		SIF BASE:(CHARANUM-1):ＨＰ < 2
			CFLAG:(CHARANUM-1):불사신플래그 = 0
	ENDIF
	
	IF ARG:1 > 16
		CALL RANDOM_TARGET,ARG,SKILL_NUM
		ARG:1 = POS(CFLAG:ARG:타겟)
	ENDIF
	
	;ぶん殴る
	CALL ATTACK_SINGLE,ARG,ARG:1,SKILL_NUM
	
	;パワーアップイベント中かつボスが最終形態時のみ、撃破時に敵が喋る
	IF GETBIT(イベントフラグ:93:16, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:카오루코]])

		;ボスのHPがぴったり1の場合、『すでに削り切ったけど、攻撃をミスってとどめを刺せていない』状況と見る
		IF BASE:(CHARANUM-1):ＨＰ == 1 && CFLAG:(CHARANUM-1):불사신플래그 < 1
			PRINTL
			SETCOLOR 0xdc7b8c
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃%"놓치지 않아! 후타바!",72,LEFT%┃
			PRINTFORML ┃%"네가 안심하고, 네 길을 걸을 수 있도록……",72,LEFT%┃
			PRINTFORML ┃%"으으으아아아아아아아아아아아아아아아아아아아아아아아아아아아아앗!!",72,LEFT%┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTL
			ALIGNMENT CENTER
			PRINTFORML ┏━━━━━━━━━━┓
			PRINTFORML ┃　　 　1more！　　　┃
			PRINTFORMW ┗━━━━━━━━━━┛
			RESETCOLOR
			ALIGNMENT LEFT
			
			;テイクツー
			CFLAG:(CHARANUM-1):불사신플래그 = 0
			TFLAG:필중 = 1
			;CFLAG:ARG:회심의패기플래그 = 1
			
			CALL ATTACK_SINGLE,ARG,ARG:1,SKILL_NUM
			
		ENDIF
		
		;ボス撃破
		IF BASE:(CHARANUM-1):ＨＰ < 1
			ALIGNMENT CENTER
			PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┃　　　　　　　　어디까지든 쫓아갈 거야　　　　　　　　┃
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┃　　　　　　나는 샤를 앙리 상송　　　　　　┃
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTL ┃　　　마리아! ……네 꽃길의 끝에서, 언젠가 반드시!　　　┃
			PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTL 
			ALIGNMENT LEFT
			
			SETCOLOR 0xdc7b8c
			PRINTL 　　　――꽃을 피워라! 단 한 사람을 위해 유한한 생명을!――
			SETCOLOR 0x815ca1
			PRINTL 　　　――꽃을 피워라! 단 한 사람을 위해 유한한 생명을!――
		ENDIF
	ELSE
		;クライマックスレヴュー終了。ゲージ取得をとめるために-1で送ってむこうで0にする
		CALL SET_ROLE_CFLAG_DUNGEON, ARG,  "클라이맥스레뷰지속시간" , -1
	ENDIF

	ALIGNMENT CENTER
	SETCOLOR 0xdc7b8c
	PRINTW 【ＣＬＩＭＡＸ　ＲＥＶＵＥ／ＦＩＮＩＳＨ】
	PRINTL
	RESETCOLOR
	ALIGNMENT LEFT
	;クライマックスレヴュー終了
	;CALL SET_ROLE_CFLAG_DUNGEON, ARG,  "클라이맥스레뷰지속시간" , 0

;それ以外
ELSE
	;相手をぶん殴る処理
	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM
	;自分の命中・回避強化を上げる処理
	CALL SKILL_SET_カジャンダ, ARG, ARG, "命中_回避", 4, "단체", "NOMES"
	;CFLAG:ARG:명중강화 = MIN(32, CFLAG:ARG:명중강화 + 4)
	;CFLAG:ARG:마법효과강화 = MIN(32, CFLAG:ARG:마법효과강화 + 4)
	;自分のみ物理反射
	CFLAG:ARG:물리반사플래그 = 1
	PRINTL ＞물리 배리어 전개!
	PRINTW ＞자신의 명중·마법 효과가 상승한다!
ENDIF

