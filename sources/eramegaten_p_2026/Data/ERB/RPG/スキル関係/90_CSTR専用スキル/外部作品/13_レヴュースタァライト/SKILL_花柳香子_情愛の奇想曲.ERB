@SKILL_EXPLAIN_情愛の奇想曲,ARG
#LOCALSIZE 1
IF CFLAG:(CHARANUM-1):PT플래그 || ARG < 0 || ARG >= CHARANUM
	PRINTL 【通常時】
	PRINTL 적 1열에 정신 상성의 중데미지+자신의 명중·회피를 1단계 올리고 1턴 동안 물리 반사 배리어를 친다
	PRINTL 
	PRINTL 【클라이맥스 레뷰 발동 시】
	PRINTL 적 1체에 마법 계산의 『타격·정신·만능』 초고명중 3히트 초특대 데미지
ELSE
	;CR展開時
	IF GET_ROLE_CFLAG_DUNGEON(ARG, "클라이맥스레뷰지속시간")
		SETCOLOR 0x8ac4ec
		PRINTL 【ＣＬＩＭＡＸ　ＡＣＴ】
		RESETCOLOR
		PRINTL 오스트리아 마술을 통달한 마리아 안토니아의 필살기
		PRINTL 적 1체에 마법 계산의 『타격·정신·만능』 초고명중 3히트 초특대 데미지
		;香子パワーアップイベント中かつボスが最終形態時のみ、撃ち放題
		IF GETBIT(イベントフラグ:93:16, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:카오루코]])
			SETCOLOR 0x8ac4ec
			PRINTL 혼신의 일격으로 이 레뷰에 결착을!
			RESETCOLOR
		;通常
		ELSE
			PRINTL 사용하면 클라이맥스 레뷰는 종료된다
		ENDIF
	ELSE
		PRINTL 적 1열에 정신 상성의 중데미지+자신의 명중·회피를 1단계 올리고 1턴 동안 물리 반사 배리어를 친다
		PRINTL 클라이맥스 레뷰 발동 중에는 성능이 변화한다.
	ENDIF
ENDIF

