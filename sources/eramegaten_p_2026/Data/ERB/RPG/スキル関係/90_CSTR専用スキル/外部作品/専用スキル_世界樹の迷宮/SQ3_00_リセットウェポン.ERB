;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_リセットウェポン, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_能力上昇解除, ARG, ARG:1, "短縮"

;====================================================
;行動によるスキルゲージ操作
;====================================================
@SKILLGAGE_CHARGE_リセットウェポン,ARG,ARG:1
CALL SKILLGAGE_CHARGE_SQ3_LIMIT, ARG, ARG:1, "リセットウェポン"

@SKILLGAGE_CHARGE_SQ3_LIMIT, ARG, ARG:1, ARGS
#LOCALSIZE 1
#DIM L_T
#DIM L_GP
#DIM IS_SQ3_LIMIT
L_GP = 0
;自分の行動の場合
IF ARG == ARG:1
	;リミットスキルを使った場合の挙動
	IF IS_PU_SKILL_入力行動(ARG, ARGS)
	    ;ゲージがたまっているときにリミットスキルを使った場合はゲージをクリアーして終了
    	CALL PU_SKILLGAGE_H_SET,ARG,ARGS, 0
  		RETURN 0
    ENDIF
	FOR LOCAL, 0, BCHARANUM
		L_T = BCHARA:LOCAL
		SIF IS_FRIEND(ARG, L_T)
			CONTINUE
		SIF GET_CREC_ACT(ARG, L_T, "HIT")
			L_GP += 2
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 3
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 3
	NEXT
	;リミットスキルを使うことで?40
	SIF IS_PU_SKILL_入力行動(ARG, "リミットスキル")
		L_GP += 40
	;気合を入れても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:기합]]
		L_GP += 20
	;集中しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:컨센트레이트]]
		L_GP += 20
	;雄叫びしても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:포효]]
		L_GP += 20
	;挑発しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:도발]]
		L_GP += 20
ELSE
	SIF PU_SKILLGAGE_H_GET(ARG,ARGS) == 100
		RETURN 0
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += MAX(40 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ, 2)
CALL PU_SKILLGAGE_H_SET,ARG,ARGS,MIN(L_GP+PU_SKILLGAGE_H_GET(ARG,ARGS), 100)
IF PU_SKILLGAGE_H_GET(ARG,ARGS) == 100
	RESULTS = ＬＩＭＩＴ ＳＫＩＬＬ ＲＥＡＤＹ！
	RESULT:1 = 0xfffacd
ELSE
	RESULTS = LIMIT GAGE
ENDIF
RESULTS:1 = \%
RETURN L_GP

