;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_アンリミテッドヴォルト, ARG, ARG:1, SKILL_NUM
#DIM SKILL_NUM
#DIM DIVA_F
#DIM DIVA_H
DIVA_F = SKILLGAGE_F_GET(ARG, [[스킬:SONG OF DIVA]])
DIVA_H = SKILLGAGE_H_GET(ARG, [[스킬:SONG OF DIVA]])

CFLAG:ARG:気合フラグ = 1
CFLAG:ARG:집중플래그 = 1
PRINTFORMW 　　TARGET:[{CPOS(ARG),2}] %CALLNAME:ARG,20,LEFT%　>>>>>>　다음 공격에 대비해 집중하고 힘을 모았다!

IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	CALL SKILL_SET_カジャンダ, ARG, ARG, "攻撃_魔法威力", 8, "단체", "NOMES"
	CALL SKILL_SET_カジャンダ, ARG, ARG, "防御_魔法効果", 4, "단체", "NOMES"
	;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 8)
	;CFLAG:ARG:마법위력강화 = MIN(32, CFLAG:ARG:마법위력강화 + 8)
	;CFLAG:ARG:방어강화 = MIN(32, CFLAG:ARG:방어강화 + 4)
	;CFLAG:ARG:마법효과강화 = MIN(32, CFLAG:ARG:마법효과강화 + 4)
	PRINTFORMW 　　TARGET:[{CPOS(ARG),2}] %CALLNAME:ARG,20,LEFT%　>>>>>>　공격·마법 위력이 대폭, 방어·마법 효과가 상승했다!
ELSE
	IF DIVA_F == 1 || DIVA_H == 1
		CALL SKILL_SET_カジャンダ, ARG, ARG, "攻撃_魔法威力", 8, "단체", "NOMES"
		;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 8)
		;CFLAG:ARG:마법위력강화 = MIN(32, CFLAG:ARG:마법위력강화 + 8)
		PRINTFORMW 　　TARGET:[{CPOS(ARG),2}] %CALLNAME:ARG,20,LEFT%　>>>>>>　공격·마법 위력이 대폭 상승했다!
	ENDIF
ENDIF

IF CFLAG:ARG:PT플래그 > 0
	LOCAL = RAND:4
	IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정") && LOCAL == 0
	ELSE
		;SP1消費=ゲージDを4加算
		CALL SKILLGAGE_D_ADD, ARG, [[스킬:뇌격린]], 4
	ENDIF
	CALL SKILLGAGE_D_SET, ARG, SKILL_NUM, 4
ENDIF
;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_アンリミテッドヴォルト, ARG
#DIM DIVA_F
#DIM DIVA_H
DIVA_F = SKILLGAGE_F_GET(ARG, [[스킬:SONG OF DIVA]])
DIVA_H = SKILLGAGE_H_GET(ARG, [[스킬:SONG OF DIVA]])
PRINTFORML 숨겨둔 제7파동의 힘을 해방하는 %CALLNAME:ARG%의 SP 스킬.
PRINTL 　
PRINTL 다음에 가하는 물리·마법 공격의 위력이 150% 증가한다.
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	PRINTL 추가로 공격·마법 위력이 2단계 상승하고, 방어·마법 효과가 1단계 상승한다.
ELSE
	IF DIVA_H == 1
		SETCOLOR 0x1d9eff
		PRINTL SONG OF DIVA 발동 중: 추가로 공격·마법 위력이 2단계 상승한다.
		RESETCOLOR
	ELSEIF DIVA_F == 1
		SETCOLOR 0x3f60a9
		PRINTL SONG OF DIVA 발동 중: 추가로 공격·마법 위력이 2단계 상승한다.
		RESETCOLOR
	ENDIF
ENDIF
PRINTL 단, 재사용까지 4턴의 쿨타임이 필요하다.
PRINTL MP와는 별개로 SP를 1 소비한다.
PRINTL ※SP는 4턴에 1 회복되며, 전투 종료 후에 완전 회복된다.
PRINTL ※스킬 「뇌격린」을 소지하지 않은 경우 사용 불가.
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	SETCOLOR 0x144ff4
	PRINTL 번개의 렌즈 장비 중 25% 확률로 SP 소비를 회피
	RESETCOLOR
ENDIF

;使用条件
@SKILL_SPECIAL_ACTIONABLE_アンリミテッドヴォルト, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "アンリミテッドヴォルト")
SIF SKILLGAGE_D_GET(ARG, SKILL_NUM)
	RETURN 0
SIF !HAVE_SKILL(ARG, [[스킬:뇌격린]])
	RETURN 0
SIF SKILLGAGE_D_GET(ARG, [[스킬:뇌격린]]) > 8
	RETURN 0
RETURN 1

