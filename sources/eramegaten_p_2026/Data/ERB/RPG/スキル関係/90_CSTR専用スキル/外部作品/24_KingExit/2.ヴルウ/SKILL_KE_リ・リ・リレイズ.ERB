;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_リ・リ・リレイズ, ARG
	RESULTS = 리・리・리레이즈

;　명중
@SKILL_HITRATE_KE_リ・リ・リレイズ, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_リ・リ・リレイズ, ARG
RETURN 400

;クリティカル率
;@SKILL_CRITICAL_RATE_KE_リ・リ・リレイズ, ARG
;RETURN 10

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_リ・リ・リレイズ, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_リ・リ・リレイズ, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_リ・リ・リレイズ, ARG
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 80
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_KE_リ・リ・リレイズ, ARG
IF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 80
	RESULTS = %" 80ＴＰ"%
	RETURN 0
ENDIF
RETURN 5

;　相性
@SKILL_TYPE_KE_リ・リ・リレイズ, ARG
RETURN GET_TYPE_NUM("타격")
;타격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_リ・リ・リレイズ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_リ・リ・リレイズ, ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_リ・リ・リレイズ, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_KE_リ・リ・リレイズ, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_リ・リ・リレイズ, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_リ・リ・リレイズ, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_KE_リ・リ・リレイズ, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_リ・リ・リレイズ
RETURN 0


;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_KE_リ・リ・リレイズ, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
SIF ARG:2 < -1
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어", -4, "短縮", "", "", -4

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_リ・リ・リレイズ, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;Fゲージ再回収できる様に起動前にTP80消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 80, "-="

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_リ・リ・リレイズ, ARG
PRINTL 
PRINTL 폭살과 소생을 그 자의 죄과만큼 반복하는 비오의 『리・리・리레이즈』.
PRINTL 적 단체에 타격 속성 특대 위력의 마법 공격을 가한다. 공격 후 방어력을 1단계까지 낮춘다.
PRINTL 
PRINTL 강철승려 브루의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_リ・リ・リレイズ, ARG
;ゲージが80以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 80
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_リ・リ・リレイズ, ARG
RESULTS:0 = 적 단체에 타격 속성 특대 위력의 마법 공격을 가한다. 공격 후 방어력을 1단계까지 낮춘다.
RESULTS:1 = TP消費 80
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 80
	RESULTS:1 = %RESULTS:1%(不足)