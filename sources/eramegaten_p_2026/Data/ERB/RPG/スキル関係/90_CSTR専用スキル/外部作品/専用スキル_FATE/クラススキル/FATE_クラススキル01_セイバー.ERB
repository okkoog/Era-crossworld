;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_セイバー, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			SIF L_相性名 == "검격"
				RETURN 15
	ENDSELECT
;自分が防御側
ELSE
	SELECTCASE ARGS
		;アドバイスの枠 & コーチングの枠
		;正の場合   1 / (1+ランク)倍になる。(1ランクでアドバイスなしのばあいクリティカル率0.5倍。ありの場合は1/2 から1/3で0.66倍) ※要するに被クリティカル率減少
		;負の場合   (1+ランク) / 1倍になる。(1ランクでアドバイスなしのばあいクリティカル率2倍。ありの場合は300%の200%で1.5倍) ※要するに被クリティカル率増加
		CASE "クリティカル耐性ランク"
			RETURN 1
	ENDSELECT
ENDIF
RETURN 0
