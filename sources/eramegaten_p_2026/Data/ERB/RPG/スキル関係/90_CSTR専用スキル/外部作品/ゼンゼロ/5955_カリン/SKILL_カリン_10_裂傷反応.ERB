;スキル名
@SKILL_NAME_裂傷反応,ARG
RESULTS = 裂傷反応

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_裂傷反応
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_裂傷反応,ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_裂傷反応,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_裂傷反応,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_裂傷反応,ARG
RETURN GET_SKILL_EFFECT_NUM("상태변화")

;スキル変化？用ランク
@SKILL_RANK_裂傷反応, ARG = -1
RETURN 3

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_裂傷反応, ARG = -1
RETURN 0

;====================================================
;追撃発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_TRIGGER_ACTIONABLE_裂傷反応,ARG,ARG:1
SIF ARG != FLAG:행동순1
	RETURN 0
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
SIF !GET_CREC_ACT(ARG, ARG:1, "CRT")
	RETURN 0
RETURN 1, CPOS(ARG:1)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_裂傷反応,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "방어", -4, "단체"

;　説明文の表示
@SKILL_EXPLAIN_裂傷反応,ARG
PRINTL 자동: 자신의 공격이 크리티컬했을 경우에 이하의 연동 효과가 발동한다.
PRINTL 　　　「대상의 방어력을 저하시킨다.」

;使用条件
@SKILL_SPECIAL_ACTIONABLE_裂傷反応,ARG
RETURN 0
