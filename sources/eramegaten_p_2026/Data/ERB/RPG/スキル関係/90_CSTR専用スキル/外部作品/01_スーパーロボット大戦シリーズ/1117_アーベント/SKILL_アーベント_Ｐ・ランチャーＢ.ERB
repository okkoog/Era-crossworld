;ヴァイスリッター・アーベント専用スキル。
;一列飛具物理、威力440、MP30、ランク12

;スキル名
@SKILL_NAME_Ｐ・ランチャーＢ,ARG
RESULTS = P·런처 B

;　명중
@SKILL_HITRATE_Ｐ・ランチャーＢ, ARG
RETURN 100

;　威力
@SKILL_POWER_Ｐ・ランチャーＢ, ARG
RETURN 440

;　최저공격횟수
@SKILL_MINATTACKNUMBER_Ｐ・ランチャーＢ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_Ｐ・ランチャーＢ,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_Ｐ・ランチャーＢ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_Ｐ・ランチャーＢ,ARG
RETURN 30

;　相性
@SKILL_TYPE_Ｐ・ランチャーＢ,ARG
RETURN GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_Ｐ・ランチャーＢ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_Ｐ・ランチャーＢ,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_Ｐ・ランチャーＢ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_Ｐ・ランチャーＢ,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_Ｐ・ランチャーＢ,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_Ｐ・ランチャーＢ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_Ｐ・ランチャーＢ, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_Ｐ・ランチャーＢ
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_Ｐ・ランチャーＢ
RETURN GET_SUCCESSION_NUM("비구")
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_Ｐ・ランチャーＢ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;列攻撃
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_Ｐ・ランチャーＢ,ARG
PRINTL 런처 총열 상단에서 실체탄을 발사한다.
PRINTL 정식 명칭 <파르티잔 런처 B모드>
PRINTL 적 1열에 비구 상성의 물리 특대 데미지. 후열 사용 가능.

@SKILL_EXPLAIN_TOOLTIP_Ｐ・ランチャーＢ, ARG
RESULTS:0 = 런처 총열 상단에서 실체탄을 발사한다.
RESULTS:1 = 정식 명칭 <파르티잔 런처 B모드>
RESULTS:2 = 敵一列に飛具相性の物理特大ダメージ。後列使用可。
;使用条件
@SKILL_SPECIAL_ACTIONABLE_Ｐ・ランチャーＢ,ARG
RETURN 1

;スキル変化用ランク
@SKILL_RANK_Ｐ・ランチャーＢ, ARG = -1
RETURN 12
