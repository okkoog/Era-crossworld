;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_オーバーガード,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM LCOUNT
#DIM IS_EFFECT
IS_EFFECT = 0
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	;複数人で使って常時無敵を防ぐために自分自身には効果なし
	SIF ARG == POS(LCOUNT)
		CONTINUE
	CALL PRINT_HIT_MESSAGE, POS(LCOUNT), "오버가드！"
	;発動時のHPを基準値として登録する。
	;随時参照だと複数回HITのときに並び順などで効果がずれてしまうので使用時で固定してしまう
	IF CFLAG:POS(LCOUNT):오버가드
		;重ねがけされたばあいはよりHPが低いほうで上書きされる
		CFLAG:POS(LCOUNT):오버가드 = MIN(BASE:ARG:ＨＰ, CFLAG:POS(LCOUNT):오버가드)
	ELSE
		CFLAG:POS(LCOUNT):오버가드 = BASE:ARG:ＨＰ
	ENDIF
	IS_EFFECT = 1
NEXT
IF IS_EFFECT
	WAIT
ELSE
	PRINTW 효과가 없었다！
ENDIF
