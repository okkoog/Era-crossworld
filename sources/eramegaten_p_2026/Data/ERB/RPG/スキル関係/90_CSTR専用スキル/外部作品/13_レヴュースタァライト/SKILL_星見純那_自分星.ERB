;추가효과상성
@SKILL_ADDTIONAL_TYPE_自分星,ARG
IF EXP:ARG:라이브경험 > 149
	RETURN GET_TYPE_NUM("만능")
ELSE
	RETURN GET_TYPE_NUM("신경")
ENDIF

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_自分星,ARG
IF EXP:ARG:라이브경험 > 299
	RETURN 100
ELSEIF EXP:ARG:라이브경험 > 199
	RETURN 75
ELSEIF EXP:ARG:라이브경험 > 99
	RETURN 50
ELSE
	RETURN 25
ENDIF

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_自分星,ARG
IF EXP:ARG:라이브경험 > 299
	RETURN 100
ELSEIF EXP:ARG:라이브경험 > 199
	RETURN 75
ELSEIF EXP:ARG:라이브경험 > 99
	RETURN 50
ELSE
	RETURN 25
ENDIF

