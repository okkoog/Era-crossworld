;====================================================
;カウンター発動条件
;ARG 		このスキルの持ち主
;ARG;1 		攻撃してきている相手
;RESULT 	カウンターが成立したかどうか
;RESULT:1	カウンターする相手のターゲット番号(ポジションなのでCPOSで返すか、あるいは範囲なら19などで返す)
;RESULT;1は指定なしなら敵の生存判定・存在判定を行わずにACTIONを実行する
;====================================================
@SKILL_COUNTER_ACTIONABLE_緊急回復,ARG,ARG:1
#DIM LCOUNT
SIF PU_SKILLGAGE_H_GET(ARG, "緊急回復")
	RETURN 0
;攻撃を受けている
SIF !GET_CREC_ACT(ARG:1, ARG, "HIT")
	RETURN 0
SIF 現HP割合(ARG) > 20
	RETURN 0
RETURN 1, CPOS(ARG)

;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
;@SKILL_DAMAGE_EFFECT_緊急回復,ARG,ARG:1,ARG:2

;====================================================
;行動によるスキルゲージ操作
;====================================================
;@SKILLGAGE_CHARGE_緊急回復,ARG,ARG:1



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_緊急回復,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL HEAL_SINGLE,ARG,POS(ARG:1),SKILL_NUM
CALL PU_SKILLGAGE_H_SET, ARG, "緊急回復", 1
;CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
;CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM;		拡散攻撃
;CALL ATTACK_RAND,ARG,ARG:1,SKILL_NUM;			ランダム攻撃


