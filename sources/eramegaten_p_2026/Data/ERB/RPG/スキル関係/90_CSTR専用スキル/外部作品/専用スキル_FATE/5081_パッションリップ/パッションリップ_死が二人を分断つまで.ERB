;====================================================
;トリガー発動条件
;====================================================
@SKILL_TRIGGER_ACTIONABLE_死が二人を分断つまで,ARG,ARG:1
SIF ARG != FLAG:행동순1
	RETURN 0
;判定は1回
SIF ARG != ARG:1
	RETURN 0
SIF !IS_PU_SKILL_入力行動(ARG, "死が二人を分断つまで")
	RETURN 0
RETURN 1, CFLAG:ARG:PT플래그 ? 19 # 22

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_死が二人を分断つまで,ARG,ARG:1,ARG:2
#DIM DYNAMIC LCOUNT
IF FLAG:총공격중
	CALL HEAL_FIELD, ARG, ARG:1, ARG:2
ELSE
	IF 淫乱系陥落(ARG)
		SIF IS_TARGET_ABLE(MASTER) && 現HP割合(MASTER) < 25
			TFLAG:스킬용1 = 1
	ELSE
		FOR LCOUNT, 1, 7
			SIF !IS_TARGET_ABLE(POS(LCOUNT))
				CONTINUE
			SIF !陥落(ARG, POS(LCOUNT))
				CONTINUE
			SIF 現HP割合(POS(LCOUNT)) >= 25
				BREAK
			TFLAG:스킬용1 = 1
		NEXT
	ENDIF
	CALL ATTACK_SKILL,ARG,ARG:1,ARG:2
ENDIF
