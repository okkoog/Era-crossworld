;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_ハンマークラッシュ,ARG
RESULTS = 해머 크래시

;　명중
@SKILL_HITRATE_ハンマークラッシュ, ARG
RETURN 95

;　威力
@SKILL_POWER_ハンマークラッシュ, ARG
SIF FLAG:확산플래그
	RETURN 325
RETURN 350

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ハンマークラッシュ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ハンマークラッシュ,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ハンマークラッシュ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ハンマークラッシュ,ARG
RETURN 30

;　相性
@SKILL_TYPE_ハンマークラッシュ,ARG
RETURN GET_TYPE_NUM("타격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ハンマークラッシュ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ハンマークラッシュ, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ハンマークラッシュ, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ハンマークラッシュ,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ハンマークラッシュ,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ハンマークラッシュ, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_ハンマークラッシュ
RETURN GET_SUCCESSION_NUM("타격")

;속도보정
@SKILL_SPEED_ハンマークラッシュ, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ハンマークラッシュ
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_ハンマークラッシュ, ARG = -1
RETURN 14



;拡散攻撃用追加処理
@SKILL_SPREAD_ハンマークラッシュ,ARG
RETURN 1
;拡散距離:1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ハンマークラッシュ, ARG, ARG:1, ARG:2
CALL ATTACK_SKILL,ARG,ARG:1,ARG:2

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_ハンマークラッシュ, ARG
PRINTL 적 단체와 주위에 타격 속성의 대 데미지를 가한다

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ハンマークラッシュ,ARG
RETURN 1
;とくにない




