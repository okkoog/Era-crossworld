;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_純粋なる力,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM
CALL PU_SKILLGAGE_F_SET, ARG, "純粋なる力",3
SIF HAVE_PU_SKILL(ARG, "声なき嘲笑")
	CALL PU_SKILLGAGE_F_SET, ARG, "声なき嘲笑",3
PRINTFORML 　
PRINTFORML ▶재사용까지 2턴!

;====================================================
;ターン終了時に行う処理
;====================================================
@SKILL_TURNEND_純粋なる力,ARG
;CT1ターン減
SIF PU_SKILLGAGE_F_GET(ARG,"純粋なる力") > 0
  CALL PU_SKILLGAGE_F_ADD, ARG, "純粋なる力",-1

;====================================================
;戦闘終了時に行う処理
;====================================================
@SKILL_BATTLE_END_純粋なる力,ARG
;CT1ターン減
SIF PU_SKILLGAGE_F_GET(ARG,"純粋なる力") > 0
  CALL PU_SKILLGAGE_F_ADD, ARG, "純粋なる力",-1

;====================================================
;実行内容ここまで
;====================================================
@SKILL_EX_DISPLAY_純粋なる力, ARG, ARGS
RESULTS '= ""
IF PU_SKILLGAGE_F_GET(ARG,"純粋なる力") == 0
	IF INPUTABLE_CHARA_F(ARG)
		RESULTS '= SET_BUTTON_TAG(SET_COLOR_TAG(@"%"▶純粋なる力", SKILL_EX_DISPLAY_LENS - 10, LEFT%", "パ緑"), ARGS)
		IF IS_PU_SKILL_入力行動(ARG, "純粋なる力") && !CFLAG:ARG:방어플래그
			RESULTS += SET_BUTTON_TAG(SET_COLOR_TAG(@"[ Set ]", "パ緑"), @"INPUT/SKILL/{ARG}/{PU_SKILLNUM_GET(ARG, "純粋なる力")}", @"純粋なる力を使用予定")
		ELSE
			RESULTS += SET_BUTTON_TAG(SET_COLOR_TAG(@"[Ready]", "パ緑"), @"INPUT/SKILL/{ARG}/{PU_SKILLNUM_GET(ARG, "純粋なる力")}", @"純粋なる力を使用")
		ENDIF
	ELSE
		RESULTS '= SET_BUTTON_TAG(SET_COLOR_TAG(@"%"▶純粋なる力", SKILL_EX_DISPLAY_LENS - 10, LEFT%", "gray"), ARGS)
		RESULTS += SET_BUTTON_TAG(SET_COLOR_TAG(@"[Ready]", "gray"), , @"행동불능")
	ENDIF
ELSE
	RESULTS += @"%"▶純粋なる力", SKILL_EX_DISPLAY_LENS - 9, LEFT%%HTML_ESCAPE(@"<CT:0{PU_SKILLGAGE_F_GET(ARG,"純粋なる力")}>")%"
ENDIF
RESULTS:1 = ▶순수한 힘
RETURN 1

