;　威力
@SKILL_POWER_ルナティックスレイ, ARG
SIF ARG == -1
	RETURN 80
IF BASE:ARG:LV > 10
	RETURN 90
ELSEIF BASE:ARG:LV >= 20
	RETURN 110
ELSEIF BASE:ARG:LV >= 30
	RETURN 120
ELSEIF BASE:ARG:LV >= 40
	RETURN 130
ELSEIF BASE:ARG:LV >= 50
	RETURN 150
ELSEIF BASE:ARG:LV >= 60
	RETURN 190
ELSEIF BASE:ARG:LV >= 70
	RETURN 200
ELSEIF BASE:ARG:LV >= 80
	RETURN 210
ELSE
	RETURN 80
ENDIF

