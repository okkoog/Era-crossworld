;====================================================
;独自処理
;====================================================
;（予定）と付けられている方は仮置きの物。実際に採用されるかどうかはわからない。
@AUTO_PU_SKILL_ラグナロク（ＡＮ）,ARG,ARGS = ""
#FUNCTION
#DIM SKILL_RANK
#DIM SKILL_NUM
#DIM FC_FLAG,2
#DIM FLAME_DOTS
;ARG = 使用者
;ARGS （ダメージ↑、被ダメージ↑、命中↑、回避↑、魔威↑、魔効↑、etc…）といった感じの奴
;文字列を参考にする都合上、どの文字列を使うか事前に定めておいた方がいいかも
;CSTR:ARG:100 = EXTRA勢出典作品、『アークナイツ』とでも書き込む（予定）
;CSTR:ARG:101 = EXTRA勢出典作品でどのキャラなのか、とりあえず『スルト（アークナイツ）』とでも書き込む（予定）
;CSTR:ARG:102 = 専用スキルその1のスキルランク変数として使用、この場合は『レーヴァテイン（ＡＮ）』が対象（予定）
;CSTR:ARG:103 = 専用スキルその2のスキルランク変数として使用、この場合は『災厄の巨焔』が対象（予定）
;CSTR:ARG:104 = 専用スキルその3のスキルランク変数として使用、この場合は『ラグナロク（ＡＮ）』が対象（予定）
;FC_FLAG = 気合、集中フラグ確保変数
SKILL_RANK = TOINT(CSTR:ARG:104)
SKILL_NUM = PU_SKILLNUM_GET(ARG,"ラグナロク（ＡＮ）")
SIF SKILL_NUM == 0
	RETURNF 0
SELECTCASE ARGS
	CASE "気合フラグ確保"
		;気合フラグを一時的に確保
		SIF FC_FLAG:0 == 1
			RETURNF 1
		IF CFLAG:ARG:気合フラグ > 0
			FC_FLAG:0 = 1
		ENDIF
	CASE "集中フラグ確保"
		;コンセフラグを一時的に確保
		SIF FC_FLAG:1 == 1
			RETURNF 1
		IF CFLAG:ARG:집중플래그 > 0
			FC_FLAG:1 = 1
		ENDIF
	CASE "気合確保変数リセット"
			FC_FLAG:0 = 0
	CASE "集中確保変数リセット"
			FC_FLAG:1 = 0
ENDSELECT
IF SKILLGAGE_F_GET(ARG,SKILL_NUM) >= 666
	SELECTCASE ARGS
		CASE "ダメージ↑"
			;気合、コンセフラグを一時的に確保
			IF CFLAG:ARG:気合フラグ > 0
				FC_FLAG:0 = 1
			ENDIF
			IF CFLAG:ARG:집중플래그 > 0
				FC_FLAG:1 = 1
			ENDIF
			;与ダメージとかに挟む場合の処理
			SELECTCASE SKILL_RANK
				CASE 1
					RETURNF 90
				CASE 2
					RETURNF 105
				CASE 3
					RETURNF 120
				CASE 4
					RETURNF 165
			ENDSELECT
		CASE "状態異常増大"
			SELECTCASE SKILLGAGE_D_GET(ARG,SKILL_NUM)
				CASE 4
					FLAME_DOTS = 24
				CASE 3
					FLAME_DOTS = 30
				CASE 2
					FLAME_DOTS = 36
				CASE 1
					FLAME_DOTS = 42
				CASE 0
					FLAME_DOTS = 48
			ENDSELECT
			RETURNF MAX(MAXBASE:ARG:ＨＰ*FLAME_DOTS/100,1)
		CASE "状態異常延長"
			RETURNF 1
		CASE "回復阻害"
			SIF SKILLGAGE_F_GET(ARG,SKILL_NUM) >= 666
				RETURNF 1
			RETURNF 0
		;CASE "Fゲージリセット"
		;	RETURNF SKILL_NUM
		CASE "気合集中フラグ返却"
			IF FC_FLAG:0 == 1
				CFLAG:ARG:気合フラグ = 1
			ENDIF
			IF FC_FLAG:1 == 1
				CFLAG:ARG:집중플래그 = 1
			ENDIF
		CASEELSE
			RETURNF 0
	ENDSELECT
ENDIF
RETURNF 0

;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_ラグナロク（ＡＮ）, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	;RESULT = 修正値
	;RESULTS = 加算/乗算/固定値/活泉/魔脈
	;加算はそのまま固定値を加算する。乗算は(100+X)/100倍にする。固定値は必ずその数値にする(55ならなにがあろうと最大HP55になる)
	;活泉/魔脈はそのまま同種スキルと同じ枠となりもっとも効果量が高いものを優先する形になる
	;HP半減
	CASE "HP補正"
		RESULTS = 加算
		SIF PU_SKILLGAGE_F_GET(ARG, "ラグナロク（ＡＮ）") >= 666
			RETURN MIN(MAXBASE:ARG:ＨＰ * 2714 / 1000, 5000)
ENDSELECT
RETURN 0
