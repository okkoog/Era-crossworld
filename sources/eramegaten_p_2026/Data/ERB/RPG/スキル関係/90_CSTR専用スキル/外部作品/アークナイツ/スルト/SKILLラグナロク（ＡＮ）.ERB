;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_ラグナロク（ＡＮ）,ARG,ARG:1
#DIM SKILL_NUM
#DIM ALIVE_FLAG
#DIM LCOUNT,3
SIF ARG != FLAG:행동순1
	RETURN 0
SIF ARG != ARG:1 || CFLAG:ARG:입력행동 == -1
	RETURN 0
SKILL_NUM = PU_SKILLNUM_GET(ARG,"ラグナロク（ＡＮ）")
IF (AUTO_PU_SKILL_ラグナロク（ＡＮ）(ARG,"気合フラグ確保") + AUTO_PU_SKILL_ラグナロク（ＡＮ）(ARG,"集中フラグ確保")) > 0
	CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
	IF RESULT == 1 && SKILLGAGE_F_GET(ARG,SKILL_NUM) < 666
		CALL GET_SKILL_PROP, "SKILL_DAMAGETYPE", CFLAG:ARG:입력행동, ARG
		IF RESULT == 1
			CALLF AUTO_PU_SKILL_ラグナロク（ＡＮ）(ARG,"気合確保変数リセット")
		ELSEIF RESULT == 2
			CALLF AUTO_PU_SKILL_ラグナロク（ＡＮ）(ARG,"集中確保変数リセット")
		ENDIF
	ENDIF
ENDIF
SIF SKILLGAGE_F_GET(ARG,SKILL_NUM) < 666
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
SIF RESULT != 1 || CFLAG:ARG:타겟 < 1 || CFLAG:ARG:타겟 > 16
	RETURN 0
LCOUNT:1 = CFLAG:ARG:PT플래그 == 0 ? 1 # 7
LCOUNT:2 = CFLAG:ARG:PT플래그 == 0 ? 7 # 17
ALIVE_FLAG = 0
FOR LCOUNT:0,LCOUNT:1,LCOUNT:2
	SIF POS(LCOUNT:0) < 0
		CONTINUE
	;このターン攻撃していたキャラクターを取得(ポジションは撃破によってずれている可能性があるので情報としては不確か)
	IF  GET_CREC_ACT(ARG, POS(LCOUNT:0), "ATTACK")
		CALL SKILLGAGE_H_SET, ARG, PU_SKILLNUM_GET(ARG,"ラグナロク（ＡＮ）"), POS(LCOUNT:0)
	ELSE
		;生存者の数を取る
		SIF GET_STATE(CFLAG:POS(LCOUNT:0):상태이상) == "DYING"
			CONTINUE
		ALIVE_FLAG += 1
	ENDIF
	SIF ALIVE_FLAG > 2
		BREAK
NEXT
SIF ALIVE_FLAG < 1
	RETURN 0
;RETURN 1, CFLAG:ARG:타겟
;実動時に成否を確定させる必要があるのでスキル表示を伏せておく
RETURN 1, -1, -1

