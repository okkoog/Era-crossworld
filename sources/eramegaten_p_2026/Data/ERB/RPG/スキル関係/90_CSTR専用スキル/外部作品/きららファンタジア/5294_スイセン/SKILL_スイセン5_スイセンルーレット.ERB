;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_スイセンルーレット,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM LCOUNT
#DIM TEMP
;Positive effects occur at 50+, negative effects otherwise
IF (RAND:100 + MAXBASE:ARG:운 / 3) >= 50
	SELECTCASE RAND:8
		CASE  0
			CFLAG:ARG:気合フラグ = 1
			CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 8, "단체", "NOWAIT"
			CALL PRINT_HIT_MESSAGE, ARG, "次の物理攻撃の威力が大幅上昇！"
		CASE 1
			CFLAG:ARG:집중플래그 = 1
			CALL SKILL_SET_カジャンダ, ARG, ARG, "마법위력", 8, "단체", "NOWAIT"
			CALL PRINT_HIT_MESSAGE, ARG, "次の魔法攻撃の威力が大幅上昇！"
		CASE  2
			CALL SET_RPG_CFLAG_BTL, ARG, "KFチャージスキル", 10
			CALL PRINT_HIT_MESSAGE, ARG, "チャージ数が10に設定された！"
		CASE  3
			CALL SKILL_INVALID_WALL, ARG, ARG, "護りの盾_聖なる加護_テトラジャ", "단체"
		CASE  4
			CALL SKILL_SET_カジャンダ, ARG, ARG, "공격/방어/마법위력/마법효과/명중/회피", 8, "단체"
		CASE  5
			CFLAG:ARG:회심의패기플래그 = 1
			CALL PRINT_HIT_MESSAGE, ARG, "次の物理攻撃の命中率とクリティカル率が大幅上昇！"
		CASE  6
			CALL SKILL_SET_カジャンダ, ARG, ARG, "크리티컬", 8, "단체"
		CASEELSE
			CALL SKILL_SET_カジャンダ, ARG, 22, "공격/방어/마법위력/마법효과/명중/회피", -4, "範囲"
	ENDSELECT
ELSE
	SELECTCASE RAND:7
		CASE IS == 0
			IF GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") >= 0
				CALL SET_RPG_CFLAG_BTL, ARG, "KFチャージスキル", 5, "-="
			ELSE
				CALL SET_RPG_CFLAG_BTL, ARG, "KFチャージスキル", 0
			ENDIF
			CALL PRINT_HIT_MESSAGE, ARG, "チャージ数が5減少した！"
		CASE IS == 1
			CALL SET_RPG_CFLAG_BTL, ARG, "KFチャージスキル", 0
			CALL PRINT_HIT_MESSAGE, ARG, "チャージ数が0にリセットされた！"
		CASE IS == 2
			CALL SKILL_SET_カジャンダ, ARG, ARG, "공격/방어/마법위력/마법효과/명중/회피", -4, "단체"
		CASE IS == 3
			CALL SKILL_SET_カジャンダ, ARG, ARG, "공격/방어/마법위력/마법효과/명중/회피", -8, "단체"
		CASE IS == 4
			CALL SKILL_SET_カジャンダ, ARG, ARG, "BS부착률", 4, "단체"
		CASE IS == 5
			CALL SKILL_SET_カジャンダ, ARG, ARG, "BS부착률", 8, "단체"
		CASEELSE
			CALL SKILL_SET_カジャンダ, ARG, 22, "공격/방어/마법위력/마법효과/명중/회피", 4, "範囲"
	ENDSELECT
ENDIF

