RETURN GET_STATE_NUM("BIND")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_蟲惑の園,ARG
RETURN GET_TYPE_NUM("신경")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_蟲惑の園,ARG
RETURN 40

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_蟲惑の園,ARG
RETURN 75
;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_蟲惑の園,ARG,ARG:1
;魔法攻撃を受けている
SIF !GET_CREC_ACT(ARG:1, ARG, "魔法")
	RETURN 0
;50%の確率で発動
SIF !RAND:2
	RETURN 0
;反撃の対象は反撃してきたキャラ(ポジションで返す)
RETURN 1, CPOS(ARG:1)
;RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_蟲惑の園, ARG, ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL SINGLE_BADSTATE, ARG, POS(ARG:1), SKILL_NUM

