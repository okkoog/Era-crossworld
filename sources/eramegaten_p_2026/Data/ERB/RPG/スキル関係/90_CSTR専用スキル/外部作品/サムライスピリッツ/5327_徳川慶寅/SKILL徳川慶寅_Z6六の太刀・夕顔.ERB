;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_六の太刀・夕顔, ARG, ARG:1, ARG:2
SIF CFLAG:(ARG:1):현데미지 < 1
	RETURN 0
SIF ARG == ARG:1
	RETURN 0
CALL SKILLGAGE_H_SETBIT, ARG, PU_SKILLNUM_GET(ARG, "七の太刀・遊蝶華"), 5
CALL PU_SKILLGAGE_D_SET, ARG, "七の太刀・遊蝶華", 1
;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_六の太刀・夕顔, ARG = -1, ARG:1 = -1
RETURN 4

;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_夕顔, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_GUARD_KILL, ARG, "검격", CPOS(ARG:1), 2, "短縮"

