;　명중
@SKILL_HITRATE_超次元電撃砲, ARG
#DIM ACC
ACC = 100
SIF ARG < 0
	RETURN ACC
SELECTCASE BASE:ARG:LV
	CASE IS >= 70
		ACC = 120
	CASE IS >= 35
		ACC = 110
ENDSELECT
RETURN ACC

;　威力
