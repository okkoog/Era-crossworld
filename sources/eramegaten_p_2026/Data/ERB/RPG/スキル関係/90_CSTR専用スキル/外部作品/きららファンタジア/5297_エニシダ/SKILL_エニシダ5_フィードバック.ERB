RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_フィードバック
RETURN 0

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_フィードバック,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_フィードバック,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_フィードバック,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_フィードバック,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_フィードバック,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

@SKILL_SUCCESSION_TYPE_フィードバック
RETURN GET_SUCCESSION_NUM("만능")

@SKILL_RANK_フィードバック, ARG
RETURN 5

;속도보정
@SKILL_SPEED_フィードバック, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_フィードバック
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_フィードバック,ARG
SIF HAVE_PU_SKILL(ARG,"呪われた歌")
	RETURN GET_STATE_NUM("CURSE")
RETURN 0

;추가효과상성
@SKILL_ADDTIONAL_TYPE_フィードバック,ARG
SIF HAVE_PU_SKILL(ARG,"呪われた歌")
	RETURN GET_TYPE_NUM("주살")
RETURN 0

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_フィードバック,ARG
SIF HAVE_PU_SKILL(ARG,"呪われた歌")
	RETURN 10
RETURN 0

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_フィードバック,ARG
SIF HAVE_PU_SKILL(ARG,"呪われた歌")
	RETURN 25
RETURN 0

;====================================================
;カウンター発動条件
;====================================================
@SKILL_COUNTER_ACTIONABLE_フィードバック,ARG,ARG:1
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
SIF !GET_CREC_ACT(ARG:1, ARG, "HIT")
	RETURN 0
RETURN 1, CPOS(ARG:1)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_フィードバック,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

TFLAG:반사0데미지화 = 1
TFLAG:흡수0데미지화 = 1
CALL ATTACK_SINGLE, ARG, POS(ARG:1), SKILL_NUM
TFLAG:반사0데미지화 = 0
TFLAG:흡수0데미지화 = 0


@SKILL_EXPLAIN_フィードバック,ARG
PRINTL 피격 시 적에 대해 만능 속성 마법으로 반격한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_フィードバック, ARG
RETURN 0

