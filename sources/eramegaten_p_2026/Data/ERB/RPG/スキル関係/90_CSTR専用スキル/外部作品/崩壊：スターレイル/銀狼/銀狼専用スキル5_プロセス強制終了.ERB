@ACTION_プロセス強制終了,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

@SKILL_AUTO_カジャンダ_プロセス強制終了, ARG
#DIM DYNAMIC TEMP, 2
WHILE 1
	TEMP = RAND:VARSIZE("BASE_KAJA_TABLE")
	TEMP:1 = RAND:VARSIZE("BASE_KAJA_TABLE")
	SIF TEMP == TEMP:1
		CONTINUE
	RESULTS '= BASE_KAJA_TABLE:TEMP + BASE_KAJA_TABLE:(TEMP:1)
	RETURN -1
WEND

