;スキル及び行動の実行
;====================================================
@ACTION_Ｄ・いんすとーる,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM スキル番号
FOR LOCAL,0,6
	CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") = MIN(32, CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") + 4)
NEXT
スキル番号 = PU_SKILLNUM_GET(ARG,"Ｄ・いんすとーる")
;ターン保存
CALL SKILLGAGE_D_SET,ARG,スキル番号,4
PRINTFORMW 　　TARGET:[{CPOS(ARG),2}] %CALLNAME:ARG,20,LEFT%　>>>>>>　모든 능력이 상승하고 4턴 동안 %CALLNAME:ARG%의 전용기에 관통이 부여된다!

;====================================================
;実行内容ここまで
;====================================================






;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_Ｄ・いんすとーる,ARG
IF PU_SKILLGAGE_D_GET(ARG, "Ｄ・いんすとーる") > 0
    PRINTFORML 전용기 강화:{PU_SKILLGAGE_D_GET(ARG, "Ｄ・いんすとーる")}T
	RETURN 3
ENDIF


;　説明文の表示
@SKILL_EXPLAIN_Ｄ・いんすとーる,ARG
PRINTL 기술명: 드래곤·인스톨
PRINTL 구속구를 풀고 용의 힘을 해방한다
PRINTL 모든 능력을 상승시키고 3턴 동안 쿠드라가 지닌 전용기에
PRINTL 상성을 꿰뚫는 효과를 부여하지만 열, 전체 범위 공격의 소비 MP가 상승한다
PRINTL 용희 쿠드라의 전용기

@SKILL_EX_DISPLAY_Ｄ・いんすとーる, ARG, ARGS
IF PU_SKILLGAGE_D_GET(ARG, "Ｄ・いんすとーる") > 0
	RESULTS += "<img src = 'SKILL_ICON_EX_00_KUDORA_CHARGE'>"
	RESULTS += HTML_RECT_SPLIT_BAR(PU_SKILLGAGE_D_GET(ARG, "Ｄ・いんすとーる"), 3, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("緑"), RESULT:1)	
ELSE
	RESULTS += "<img src = 'SKILL_ICON_EX_00_KUDORA_CHARGE'>"
	RESULTS += SET_COLOR_TAG(@"%" Ready", SKILL_EX_DISPLAY_LENS - 2, LEFT%", TOSTR(0xff4500))
ENDIF
RESULTS:1 = D·인스톨
RETURN 1

