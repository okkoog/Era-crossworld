;ヘルタ専用スキル。単体氷結魔法で全貫通。
;原作では通常攻撃だけど。敵のHP50%以下でこれに連動して弱みは付け込みが発動する。

;スキル名
@SKILL_NAME_何見てるの,ARG
RESULTS = 뭘 봐?

;　명중
@SKILL_HITRATE_何見てるの, ARG
RETURN 100

;　威力(通常攻撃を100%とした倍率となる)
@SKILL_POWER_何見てるの, ARG
IF ARG >= 0
	SIF HAVE_PU_SKILL(ARG, "欠点掴んで罵り倒す")
		RETURN 470
	SIF HAVE_PU_SKILL(ARG, "面子は徹底的に潰す")
		RETURN 410
	SIF HAVE_PU_SKILL(ARG, "私はこういう女なの")
		RETURN 320
ENDIF
RETURN 200

;基礎クリティカル率(標準は5。乗算されるので10になると200%になる)
;@SKILL_CRITICAL_RATE_何見てるの, ARG
;RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_何見てるの,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_何見てるの,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_何見てるの, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_何見てるの,ARG
IF ARG >= 0
	SIF HAVE_PU_SKILL(ARG, "欠点掴んで罵り倒す")
		RETURN 60
	SIF HAVE_PU_SKILL(ARG, "面子は徹底的に潰す")
		RETURN 48
	SIF HAVE_PU_SKILL(ARG, "私はこういう女なの")
		RETURN 24
ENDIF
RETURN 10

;　相性
@SKILL_TYPE_何見てるの,ARG
RETURN GET_TYPE_NUM("빙결")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_何見てるの
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_何見てるの, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_何見てるの, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리(1 = 後列発動不可・後列指定不可 2 = 後列発動可能・後列指定不可 3 = 後列発動可能・後列指定可能 4 = 後列発動不可・後列指定可能)
@SKILL_RANGE_何見てるの,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_何見てるの,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_何見てるの, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_何見てるの
RETURN GET_SUCCESSION_NUM("빙결")

;속도보정
@SKILL_SPEED_何見てるの, ARG = -1
RETURN 0

;スキルランク
;スキルの習得時の必要ＭＡＧの算出に主に用いられる
;また、習得・所持スキルはこのランクの5倍のレベルを基準として設定する。
@SKILL_RANK_何見てるの, ARG = -1
IF ARG >= 0 && TFLAG:전투중
	SIF HAVE_PU_SKILL(ARG, "欠点掴んで罵り倒す")
		RETURN 13
	SIF HAVE_PU_SKILL(ARG, "面子は徹底的に潰す")
		RETURN 11
	SIF HAVE_PU_SKILL(ARG, "私はこういう女なの")
		RETURN 7
ENDIF
RETURN 3

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_何見てるの,ARG
RETURN GET_STATE_NUM("FREEZE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_何見てるの,ARG
RETURN GET_TYPE_NUM("빙결")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_何見てるの,ARG
RETURN 20

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_何見てるの,ARG
RETURN 95
;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_何見てるの, ARG = -1, ARG:1 = -1
RETURN 4

;====================================================
;スキル及び行動の実行
;ARG = スキルの使用者
;ARG:1 = スキルの使用対象
;ARG:2 = スキルの番号
;====================================================
@ACTION_何見てるの, ARG, ARG:1, ARG:2
CALL ATTACK_SKILL,ARG,ARG:1,ARG:2

