;スキル変化？用ランク
@SKILL_RANK_永遠の魂, ARG = -1
RETURN 6

;계승타입
@SKILL_SUCCESSION_TYPE_永遠の魂
RETURN GET_SUCCESSION_NUM("자동효과")

@SKILL_TURNEND_永遠の魂, ARG
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC IS_DONE
SIF !CFLAG:ARG:PT플래그
	RETURN 0
;場にでていないとダメ
SIF !CPOS(ARG)
	RETURN 0
;死亡していないとダメ
SIF !IS_BADSTATE(ARG, "DYING")
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG, , , , "永遠の魂"
CUSTOMDRAWLINE =
PRINTFORML 파괴할 아군을 선택해 주십시오.
CALL SELECT_SKILL_TARGET, PU_SKILLNUM_GET(ARG, "永遠の魂"), ARG
SIF RESULT < 0
	RETURN 0
L_CHARA = POS(RESULT)

CFLAG:ARG:상태이상 = 0
CFLAG:ARG:상태이상경과턴수 = 0
CALL VAR_HP,ARG,MAXBASE:ARG:ＨＰ

FOR LCOUNT, 0, VARSIZE("KAJA_TABLE")
	IF KAJA_TABLE:LCOUNT == "BS부착률"
		SIF CFLAG:L_CHARA:(KAJA_TABLE:LCOUNT + "강화") >= 0
			CONTINUE
		CALL SKILL_SET_カジャンダ, L_CHARA, ARG, KAJA_TABLE:LCOUNT, -CFLAG:L_CHARA:(KAJA_TABLE:LCOUNT + "강화"), "단체", "NOMES"
	ELSE
		SIF CFLAG:L_CHARA:(KAJA_TABLE:LCOUNT + "강화") <= 0
			CONTINUE
		CALL SKILL_SET_カジャンダ, L_CHARA, ARG, KAJA_TABLE:LCOUNT, CFLAG:L_CHARA:(KAJA_TABLE:LCOUNT + "강화"), "단체", "NOMES"
	ENDIF
	IS_DONE = 1
NEXT

CALL DEAD_CHARA, L_CHARA, ARG, 1

CALL PRINT_HIT_MESSAGE, L_CHARA, @"破壊！", "L"
CALL PRINT_HIT_MESSAGE, ARG, @"墓地から特殊召喚", "L"
SIF IS_DONE
	CALL PRINT_HIT_MESSAGE, ARG, @"能力強化！", "L"
WAIT