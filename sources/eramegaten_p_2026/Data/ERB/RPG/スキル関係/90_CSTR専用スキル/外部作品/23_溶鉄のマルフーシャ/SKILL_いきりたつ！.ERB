;====================================================
@SKILL_COUNTER_ACTIONABLE_いきりたつ！,ARG,ARG:1
;攻撃者が味方
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
SIF CFLAG:ARG:방어플래그
	RETURN 0
SIF !GET_CREC_ACT(ARG:1, ARG, "WEAK")
	RETURN 0
RETURN 1, CPOS(ARG)

