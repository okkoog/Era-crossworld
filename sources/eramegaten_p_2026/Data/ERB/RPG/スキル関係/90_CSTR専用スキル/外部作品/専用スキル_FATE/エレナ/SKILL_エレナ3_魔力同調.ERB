;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_魔力同調,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM LCOUNT,3
SKILL_NUM = PU_SKILLNUM_GET(ARG,"魔力同調")

CALL SKILL_SET_カジャンダ,ARG,ARG:1,"魔法威力_魔法効果",4,"範囲","NOWAIT"
PRINTL
LCOUNT:1 = CFLAG:ARG:PT플래그 > 0 ? 1 # 7
LCOUNT:2 = CFLAG:ARG:PT플래그 > 0 ? 7 # 17
FOR LCOUNT,LCOUNT:1,LCOUNT:2
	;追加効果発動不可のターンが残ってる or ノウブル・ファンタズム持ってない or 100以上なら次のループ
	SIF SKILLGAGE_D_GET(ARG,SKILL_NUM) > 0
		CONTINUE
	SIF POS(LCOUNT) < 0 || !HAVE_PU_SKILL(POS(LCOUNT),"ノウブル・ファンタズム") || SKILLGAGE_F_GET(POS(LCOUNT),PU_SKILLNUM_GET(POS(LCOUNT),"ノウブル・ファンタズム")) >= 100
		CONTINUE
	CALL SKILLGAGE_F_ADD(POS(LCOUNT),PU_SKILLNUM_GET(POS(LCOUNT),"ノウブル・ファンタズム"),20)
NEXT
;追加効果が発動できる状態なら発動不可状態にする
IF SKILLGAGE_D_GET(ARG,SKILL_NUM) == 0
	CALL SKILLGAGE_D_SET(ARG,SKILL_NUM,5)
	PRINTFORML \@ CFLAG:ARG:PT플래그 == 0 ? 적 # 아군 \@의 NP 게이지가 조금 충전되었다!
ENDIF
WAIT
;====================================================
;実行内容ここまで
;====================================================





