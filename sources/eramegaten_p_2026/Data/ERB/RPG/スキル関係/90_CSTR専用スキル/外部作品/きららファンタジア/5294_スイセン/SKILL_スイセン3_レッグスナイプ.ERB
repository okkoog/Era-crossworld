
;スキル名
@SKILL_NAME_レッグスナイプ,ARG
RESULTS = 레그 스나이프

;　명중
@SKILL_HITRATE_レッグスナイプ, ARG
RETURN 110

;　威力
@SKILL_POWER_レッグスナイプ, ARG
RETURN 150

@SKILL_CRITICAL_RATE_レッグスナイプ, ARG
RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_レッグスナイプ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_レッグスナイプ,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_レッグスナイプ, ARG
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_レッグスナイプ,ARG
RETURN 9

;　相性
@SKILL_TYPE_レッグスナイプ,ARG
RETURN GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_レッグスナイプ
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_レッグスナイプ,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_レッグスナイプ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_レッグスナイプ,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_レッグスナイプ,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_レッグスナイプ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

@SKILL_SUCCESSION_TYPE_レッグスナイプ,ARG
RETURN GET_SUCCESSION_NUM("비구")

@SKILL_RANK_レッグスナイプ, ARG = -1
RETURN 3

;속도보정
@SKILL_SPEED_レッグスナイプ, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_レッグスナイプ
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_レッグスナイプ,ARG
RETURN GET_STATE_NUM("BIND")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_レッグスナイプ,ARG
RETURN GET_TYPE_NUM("신경")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_レッグスナイプ,ARG
RETURN 25

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_レッグスナイプ,ARG
RETURN 35

@SKILL_DAMAGE_EFFECT_レッグスナイプ, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "회피", -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_レッグスナイプ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_レッグスナイプ,ARG
PRINTL 적 단체에 비구 상성의 데미지를 주고, 회피율을 저하시킨다.
PRINTL 확률에 따라 BIND를 부여한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_レッグスナイプ, ARG
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_レッグスナイプ, ARG
RESULTS:0 = 적 단체에 비구 데미지를 주고, 회피를 1단계 낮춘다.
RESULTS:1 = 확률에 따라 BIND를 부여한다.
