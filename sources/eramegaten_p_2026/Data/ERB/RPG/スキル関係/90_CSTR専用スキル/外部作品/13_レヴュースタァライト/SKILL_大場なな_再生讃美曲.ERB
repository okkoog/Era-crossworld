;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_再生讃美曲, ARG = -1, ARG:1 = -1
RETURN 4

;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_再生讃美曲, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_GUARD_KILL, ARG, "검격", CPOS(ARG:1), 1, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_再生讃美曲,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
ALIGNMENT CENTER
SETCOLOR 0xfdca57
PRINTL 【ＣＬＩＭＡＸ　ＡＣＴ】
RESETCOLOR
ALIGNMENT LEFT
;パワーアップイベント中かつボスが最終形態時のみ、ボスの不死フラグを剥がして攻撃
IF GETBIT(イベントフラグ:93:17, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:나나]])
	;HPが1まで削れていたら不死身フラグを外して攻撃
	SIF BASE:(CHARANUM-1):ＨＰ < 2
		CFLAG:(CHARANUM-1):불사신플래그 = 0
ENDIF

TFLAG:필중 = 1
;何らかの事情によりターゲットが22未満だったら
IF CFLAG:ARG:타겟 < 22
	;22（全体）をセット
	CFLAG:ARG:타겟 = 22
ENDIF

;全体攻撃処理
LOCAL = 22
;ぶん殴る
CALL ATTACK_FIELD,ARG,LOCAL,SKILL_NUM

;パワーアップイベント中かつボスが最終形態時のみ、撃破時に敵が喋る
IF GETBIT(イベントフラグ:93:17, 5) && (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13) && (イベントフラグ:93:10 == [[キャラ:나나]])
	;ボスのHPがぴったり1の場合、『すでに削り切ったけど、攻撃をミスってとどめを刺せていない』状況と見る
	;という処理が他のCAスキルには入っているのだが、これは必中なので起こりえない
	;ボス撃破
	IF BASE:(CHARANUM-1):ＨＰ < 1
		ALIGNMENT CENTER
		PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTL ┃　　　　　　 준나 쨩――호시미, 준나아앗! 　　　　　　┃
		PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTL ┃　　　　　　　　　 나는, 네가ッ…… 　　　　　　　　　┃
		PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTL ┃　　　　　　　 준나 쨩이 너무 좋아서어엇! 　　　　　　　┃
		PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ALIGNMENT LEFT
		PRINTL
		SETCOLOR 0x8ac4ec
		PRINTW 　　　――언젠가 누군가 그 말로――
		PRINTL
		
		ALIGNMENT CENTER
		PRINTL ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTL ┃　　　　　　　　　　무대에서, 기다릴게　　　　　　　　　　　┃
		PRINTL ┃　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		PRINTL 
		ALIGNMENT LEFT
		SETCOLOR 0xfdca57
		PRINTW 　　　――그 온도로 나를　구원하는 거야――
		SETCOLOR 0x33ffcc
		
	ENDIF
ELSE
	;クライマックスレヴュー終了。ゲージ取得をとめるために-1で送ってむこうで0にする
	CALL SET_ROLE_CFLAG_DUNGEON, ARG,  "클라이맥스레뷰지속시간" , -1
ENDIF

ALIGNMENT CENTER
SETCOLOR 0xfdca57
PRINTW 【ＣＬＩＭＡＸ　ＲＥＶＵＥ／ＦＩＮＩＳＨ】
PRINTL
RESETCOLOR
ALIGNMENT LEFT

