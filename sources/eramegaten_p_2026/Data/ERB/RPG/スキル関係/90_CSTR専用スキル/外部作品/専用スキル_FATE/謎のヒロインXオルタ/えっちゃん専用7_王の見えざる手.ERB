;====================================================
@ACTION_王の見えざる手,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM LOCALSIZE,3

;IF CFLAG:ARG:PT플래그 == 0
;	LOCAL:1 = 7
;	LOCAL:2 = 17
;ELSE
;	LOCAL:1 = 1
;	LOCAL:2 = 7
;ENDIF

CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "크리티컬", -4, "단체", "NOMES"
;CFLAG:POS(ARG:1):크리티컬강화 = MAX(-8, CFLAG:POS(ARG:1):크리티컬강화 - 4)

;FOR LOCAL, LOCAL:1, LOCAL:2
	;SIF POS(LOCAL) < 0 || LOCAL == ARG:1
	;	CONTINUE
FOR LOCAL, CFLAG:ARG:PT플래그 ? 1 # 7, CFLAG:ARG:PT플래그 ? 7 # 17
	SIF !IS_TARGET_ABLE(POS(LOCAL))
		CONTINUE
	IF LOCAL == ARG:1
		CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "크리티컬", -4, "단체", "NOMES"
	ELSE
		CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "크리티컬", 4, "단체", "NOMES"
		;CFLAG:POS(LOCAL):크리티컬강화 = MIN(8, CFLAG:POS(LOCAL):크리티컬강화 + 4)
	ENDIF
	CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "공격", 4, "단체", "NOMES"
	;CFLAG:POS(LOCAL):공격강화 = MIN(32, CFLAG:POS(LOCAL):공격강화 + 4)
NEXT
PRINTFORML %CALLNAME:POS(ARG:1)%의 크리티컬률이 대폭 떨어졌다!
PRINTFORML %CALLNAME:POS(ARG:1)% 이외의 \@ CFLAG:ARG:PT플래그 == 0 ? 적 # 아군 \@의 크리티컬률이 올랐다!
PRINTFORMW \@ CFLAG:ARG:PT플래그 == 0 ? 적 # 아군 \@의 공격력이 올랐다!

