;-------------------------------------------------------
;追撃の発動条件と対象
;自分の行動で敵を倒した時、自分に
;範囲で倒した場合は対象の数だけ発動する
;-------------------------------------------------------
@SKILL_TRIGGER_ACTIONABLE_キリングリアクト,ARG,ARG:1
;自分の行動のときのみ追撃
SIF FLAG:행동순1 != ARG
	RETURN 0
;味方相手には発動しない
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
;アクティブスキルとして起動状態にしておく必要がある。
SIF PU_SKILLGAGE_H_GET(ARG,"キリングリアクト") < 1
	RETURN 0
;この行動で敵を殺していることで発動
SIF !GET_CREC_ACT(ARG, ARG:1, "KILL")
	RETURN 0
;対象は自分自身
RETURN 1, CPOS(ARG)
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_キリングリアクト, ARG, ARG:1, ARG:2
IF FLAG:총공격중
	CALL HEAL_SINGLE, ARG, POS(ARG:1), ARG:2
ELSE
	CALL PU_SKILLGAGE_H_SET, ARG, "キリングリアクト", 1
	PRINTFORMW %CALLNAME:ARG%(은)는 대상을 전투불능으로 만들었을 경우 추가 행동을 실행하게 되었다!
ENDIF

