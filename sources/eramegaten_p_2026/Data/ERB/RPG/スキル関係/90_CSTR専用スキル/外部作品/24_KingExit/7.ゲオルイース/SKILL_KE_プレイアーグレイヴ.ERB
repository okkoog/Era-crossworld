;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_プレイアーグレイヴ, ARG
RESULTS = 프레이어 글레이브

;　명중
@SKILL_HITRATE_KE_プレイアーグレイヴ, ARG
RETURN 999

;　威力
@SKILL_POWER_KE_プレイアーグレイヴ, ARG
RETURN 400

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_プレイアーグレイヴ, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_プレイアーグレイヴ, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_プレイアーグレイヴ, ARG
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 100
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_KE_プレイアーグレイヴ, ARG
IF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 100
	RESULTS = %"100ＴＰ"%
	RETURN 0
ENDIF
RETURN 30

;　相性
@SKILL_TYPE_KE_プレイアーグレイヴ, ARG
RETURN GET_TYPE_NUM("검격"),GET_TYPE_NUM("파마")
;검격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_プレイアーグレイヴ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_プレイアーグレイヴ, ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_プレイアーグレイヴ, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_KE_プレイアーグレイヴ, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_プレイアーグレイヴ, ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_プレイアーグレイヴ, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_KE_プレイアーグレイヴ, ARG = -1
RETURN 30

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_プレイアーグレイヴ
RETURN 0


;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_KE_プレイアーグレイヴ, ARG = -1, ARG:1 = -1
RETURN 4

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_プレイアーグレイヴ, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;Fゲージ再回収できる様に起動前にTP100消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 100, "-="

CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM;

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_プレイアーグレイヴ, ARG
PRINTL 
PRINTL 저편에서 닿는 절망을 꿰뚫는 칼날.
PRINTL 적 전체에 검격/파마 복합 속성 특대 위력의 마법 공격을 가한다.
PRINTL 
PRINTL 문장의 왕 게오루이즈의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_プレイアーグレイヴ, ARG
;ゲージが100のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 100
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_プレイアーグレイヴ, ARG
RESULTS:0 = 적 전체에 검격/파마 복합 속성 특대 위력의 마법 공격을 가한다.
RESULTS:1 = TP消費 100
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 100
	RESULTS:1 = %RESULTS:1%(不足)