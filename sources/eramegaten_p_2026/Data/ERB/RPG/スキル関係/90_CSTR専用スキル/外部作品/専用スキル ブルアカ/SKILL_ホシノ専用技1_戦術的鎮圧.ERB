;　コストの量
@SKILL_COST_戦術的鎮圧,ARG
RETURN 15

;　相性
@SKILL_TYPE_戦術的鎮圧,ARG
RETURN GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_戦術的鎮圧
