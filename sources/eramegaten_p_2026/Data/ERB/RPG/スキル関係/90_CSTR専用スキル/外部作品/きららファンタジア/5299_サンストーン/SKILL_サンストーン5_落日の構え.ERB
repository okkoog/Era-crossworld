
;スキル名
@SKILL_NAME_落日の構え,ARG
RESULTS = 낙일의 자세

;　명중
@SKILL_HITRATE_落日の構え, ARG
RETURN 100

;　威力
@SKILL_POWER_落日の構え, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_落日の構え,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_落日の構え,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_落日の構え, ARG
RETURN 1
;消費なし＝1

;　コストの量
@SKILL_COST_落日の構え,ARG
IF ARG >= 0 && GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 3
	RESULTS = %"ＣＨ:3"%
	RETURN 0
ENDIF
RETURN 0

;　相性
