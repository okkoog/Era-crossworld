RETURN GET_SKILL_EFFECT_NUM("특수")

@SKILL_SUCCESSION_TYPE_落日の構え,ARG
RETURN GET_SUCCESSION_NUM("검격")

@SKILL_RANK_落日の構え, ARG = -1
RETURN 6

;속도보정
@SKILL_SPEED_落日の構え, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_落日の構え
RETURN 0

@SKILL_QUICK_ACTION_落日の構え, ARG
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_落日の構え,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

CALL SET_RPG_CFLAG_BTL, ARG, "KFチャージスキル", 3, "-="
CALL SKILLGAGE_H_SET, ARG, SKILL_NUM ,1
PRINTFORML %CALLNAME:ARG%의 자세가 낙일로 바뀌었다.
SIF HAVE_PU_SKILL(ARG,"暁光の構え") && PU_SKILLGAGE_H_GET(ARG,"暁光の構え") > 0
	CALL PU_SKILLGAGE_H_SET, ARG, "暁光の構え", 0
SIF HAVE_PU_SKILL(ARG,"白夜の構え") && PU_SKILLGAGE_H_GET(ARG,"白夜の構え") > 0
	CALL PU_SKILLGAGE_H_SET, ARG, "白夜の構え", 0
;====================================================
;実行内容ここまで
;====================================================

@SKILLGAGE_DISPLAY_落日の構え,ARG
IF PU_SKILLGAGE_H_GET(ARG, "落日の構え")
	SETCOLOR COLOR("orange")
	PRINTFORML 자세: 낙일
	RESETCOLOR
ENDIF
;　説明文の表示
@SKILL_EXPLAIN_落日の構え,ARG
PRINTL 발동 시, 자신이 가하는 데미지를 10% 상승시킨다.
PRINTL 효과는 전투 종료까지 지속되거나, 다른 자세로 덮어씌워질 때까지 계속된다.
PRINTL 차지 3을 소비하여 발동하지만, 행동 턴은 소비하지 않는다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_落日の構え, ARG
IF PU_SKILLGAGE_H_GET(ARG,"落日の構え") > 0
	RESULTS = 発動中
	RETURN 0
ELSEIF GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 3
	RESULTS = 차지 부족
	RETURN 0
ENDIF
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_落日の構え, ARG
RESULTS:0 = 발동 시, 자신이 가하는 데미지를 10% 상승시킨다.
RESULTS:1 = 효과는 전투 종료까지 지속되거나, 다른 자세로 덮어씌워질 때까지 계속된다.
RESULTS:2 = チャージを3消費して発動するが、行動ターンは消費しない。

@SKILL_PASSIVE_BTL_EFFECT_落日の構え, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM TOTAL_DMG_B
;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			SIF PU_SKILLGAGE_H_GET(L_P, "落日の構え")
				RETURN 10
	ENDSELECT
ENDIF
