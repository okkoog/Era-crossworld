@SKILL_POWER_ヤーデアングリフ, ARG
SIF ARG == -1
	RETURN 50
IF BASE:ARG:LV < 10
	RETURN 60
ELSEIF BASE:ARG:LV < 20
	RETURN 70
ELSEIF BASE:ARG:LV < 30
	RETURN 80
ELSEIF BASE:ARG:LV < 40
	;3回攻撃
	RETURN 100
ELSE
	;3回攻撃
	RETURN 100
ENDIF
