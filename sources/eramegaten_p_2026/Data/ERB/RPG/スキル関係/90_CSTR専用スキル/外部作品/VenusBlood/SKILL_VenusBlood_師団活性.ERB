
;スキル名
@SKILL_NAME_師団活性,ARG
RESULTS = 師団活性

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_師団活性
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_師団活性, ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

;계승타입,制限なし
@SKILL_SUCCESSION_TYPE_師団活性, ARG
RETURN GET_SUCCESSION_NUM("자동효과")

;　 説明文の表示
@SKILL_EXPLAIN_師団活性, ARG
PRINTL 자동: 턴 종료 시 이하의 연동 효과가 발동한다.
PRINTL 「자신 이외의 아군의 능력 중 하나를 상승시킨다.」

@SKILL_ACTIONABLE_BATTLE_師団活性, ARG
RETURN 0

@SKILL_RANK_師団活性, ARG
RETURN 5

@SKILL_TURNEND_師団活性, ARG
#DIM DYNAMIC LCOUNT
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG, , , , "師団活性", "NOWAIT"
FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:PT플래그 ? 19 # 22), GET_POS_MAX(CFLAG:ARG:PT플래그 ? 19 # 22)
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	SIF ARG == POS(LCOUNT)
		CONTINUE
	CALL SKILL_SET_カジャンダ, ARG, POS(LCOUNT), BASE_KAJA_TABLE:(RAND:VARSIZE("BASE_KAJA_TABLE")), 4, "단체", "NOWAIT"
NEXT
WAIT
@継承不能_師団活性
RETURN 1

@味方専用_師団活性,ARG
RETURN 1
