;ゲシュペンスト・ファントム専用スキル。
;1列飛具物理、威力450、MP35、ランク13

;スキル名
@SKILL_NAME_Ｇ・スラッシュリッパー,ARG
RESULTS = G·슬래시 리퍼

;　명중
@SKILL_HITRATE_Ｇ・スラッシュリッパー, ARG
RETURN 100

;　威力
@SKILL_POWER_Ｇ・スラッシュリッパー, ARG
RETURN 450

;　최저공격횟수
@SKILL_MINATTACKNUMBER_Ｇ・スラッシュリッパー,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_Ｇ・スラッシュリッパー,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_Ｇ・スラッシュリッパー, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_Ｇ・スラッシュリッパー,ARG
RETURN 35

;　相性
@SKILL_TYPE_Ｇ・スラッシュリッパー,ARG
RETURN GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_Ｇ・スラッシュリッパー
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_Ｇ・スラッシュリッパー,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_Ｇ・スラッシュリッパー,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_Ｇ・スラッシュリッパー,ARG
RETURN 3

;　範囲　1単体　2 一列　3全体　4　敵味方全体
@SKILL_SPHERE_Ｇ・スラッシュリッパー,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_Ｇ・スラッシュリッパー,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_Ｇ・スラッシュリッパー, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_Ｇ・スラッシュリッパー
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_Ｇ・スラッシュリッパー
RETURN GET_SUCCESSION_NUM("비구")

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_Ｇ・スラッシュリッパー,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;列攻撃
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_Ｇ・スラッシュリッパー,ARG
PRINTL 등 쪽 웨폰 랙에 장착된 대형 회전 칼날을 던진다.
PRINTL 정식 명칭 <그랑 슬래시 리퍼>
PRINTL 적 1열에 비구 상성의 물리 특대 데미지. 후열 사용 가능.

@SKILL_EXPLAIN_TOOLTIP_Ｇ・スラッシュリッパー, ARG
RESULTS:0 = 등 쪽 웨폰 랙에 장착된 대형 회전 칼날을 던진다.
RESULTS:1 = 정식 명칭 <그랑 슬래시 리퍼>
RESULTS:2 = 敵一列に飛具相性の物理特大ダメージ。後列使用可。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_Ｇ・スラッシュリッパー,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_Ｇ・スラッシュリッパー, ARG = -1
RETURN 13
