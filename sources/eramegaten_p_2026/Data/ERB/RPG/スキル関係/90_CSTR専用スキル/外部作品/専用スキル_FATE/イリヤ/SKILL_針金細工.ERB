@SKILL_MINATK_PER_針金細工,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_針金細工,ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_針金細工,ARG
RETURN 20

;　相性
@SKILL_TYPE_針金細工,ARG
RETURN GET_TYPE_NUM("검격"), GET_TYPE_NUM("타격"), GET_TYPE_NUM("전술")


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_針金細工
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
