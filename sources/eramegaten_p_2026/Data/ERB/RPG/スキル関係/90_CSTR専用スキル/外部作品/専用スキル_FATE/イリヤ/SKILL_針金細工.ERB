;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_針金細工,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_針金細工,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_針金細工,ARG
RETURN GET_SPHERE_NUM("전체")

;スキルがランダム範囲かどうか
@SKILL_RAND_TARGET_針金細工,ARG
RETURN 1

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_針金細工,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_針金細工, ARG
RETURN GET_SUCCESSION_NUM("검격")

;속도보정
