SIF !IS_PU_SKILL_入力行動(ARG, "サンダーシールド")
	RETURN 0
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_サンダーシールド, ARG, ARG:1, ARG:2
#DIM DYNAMIC LCOUNT
IF FLAG:총공격중
	;実行
	FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:PT플래그 ? 19 # 22), GET_POS_MAX(CFLAG:ARG:PT플래그 ? 19 # 22) + 1
		SIF !IS_TARGET_ABLE(POS(LCOUNT))
			CONTINUE
		CFLAG:(POS(LCOUNT)):물리반사플래그 = 1
	NEXT
	PRINTFORMW TARGET:\@ ARG:1 == 19  ? ENEMY # PARTY \@ >>>>>> 물리 공격을 반사!
ELSE
	CALL ATTACK_SKILL,ARG,ARG:1,ARG:2
ENDIF

