;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_おバカをぶっ叩け,ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_おバカをぶっ叩け,ARG
RETURN 6

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_おバカをぶっ叩け,ARG
SIF ARG >= 0 && HAVE_PU_SKILL(ARG, "メイド長の実力")
	RETURN 30
RETURN 15

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_おバカをぶっ叩け,ARG
RETURN 95

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_おバカをぶっ叩け, ARG = -1, ARG:1 = -1
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "完璧主義のメイド長")
	RETURN 0, 4
ELSE
	RETURN 0, 0
ENDIF
;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_おバカをぶっ叩け, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "마법효과", -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_おバカをぶっ叩け,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_おバカをぶっ叩け,ARG
PRINTL 【일반】【리나 전용 스킬】
PRINTL 적 단체에 전격 상성의 소데미지를 주고, 저확률로 SHOCK을 부여한다.
PRINTL 공격 성공 시 대상의 마법 효과를 저하시킨다.

;　説明文の表示
@ENHANCE_SKILL_EXPLAIN_おバカをぶっ叩け,ARG
