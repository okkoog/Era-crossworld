;スキル名
@SKILL_NAME_おバカをぶっ叩け,ARG
RESULTS = 멍청이를 때려눕혀라
SIF TFLAG:전투턴진행중
	TSTR:스킬메시지행동자 '= "アナステラ"


;　명중
@SKILL_HITRATE_おバカをぶっ叩け, ARG
RETURN 100

;　威力
@SKILL_POWER_おバカをぶっ叩け, ARG
SIF ARG < 0
	RETURN 25
CALL GET_SKILL_POWER_おバカをぶっ叩け(GET_ROLE_CFLAG_TAKEOVER(ARG, "通常スキルランク"))
RETURN RESULT

@GET_SKILL_POWER_おバカをぶっ叩け, ARG
SELECTCASE ARG
	CASE 15
		RETURN 250
	CASE 11 TO 14
		RETURN 200 + (ARG - 10) * 10
	CASE 10
		RETURN 200
	CASE 2 TO 9
		RETURN 40 + 15 * ARG
	CASE 0, 1
		RETURN 50
	CASEELSE
		RETURN 0
ENDSELECT

;;クリティカル率
@SKILL_CRITICAL_RATE_おバカをぶっ叩け, ARG
RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_おバカをぶっ叩け,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_おバカをぶっ叩け,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_おバカをぶっ叩け, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_おバカをぶっ叩け,ARG
SIF ARG < 0
	RETURN 2
CALL GET_SKILL_COST_おバカをぶっ叩け(GET_ROLE_CFLAG_TAKEOVER(ARG, "通常スキルランク"))
RETURN RESULT
;　コストの量
@GET_SKILL_COST_おバカをぶっ叩け,ARG
SELECTCASE ARG
	CASE 15
		RETURN 24
	CASE 0, 1
		RETURN 3
	CASEELSE
		RETURN 1 + ARG * 3 / 2
ENDSELECT

;　相性
@SKILL_TYPE_おバカをぶっ叩け,ARG
RETURN GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_おバカをぶっ叩け
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_おバカをぶっ叩け,ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_おバカをぶっ叩け,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_おバカをぶっ叩け,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_おバカをぶっ叩け,ARG
