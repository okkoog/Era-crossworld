;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_エレキングコレダー,ARG
RESULTS = 에레킹 콜라이더

;　명중
@SKILL_HITRATE_エレキングコレダー, ARG
RETURN 90

;　威力
@SKILL_POWER_エレキングコレダー, ARG
RETURN 450

;　최저공격횟수
@SKILL_MINATTACKNUMBER_エレキングコレダー,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_エレキングコレダー,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_エレキングコレダー, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_エレキングコレダー,ARG
RETURN 25

;　相性
@SKILL_TYPE_エレキングコレダー,ARG
RETURN GET_TYPE_NUM("전격")
;전격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_エレキングコレダー
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　攻撃タイプ
@SKILL_ATTACKTYPE_エレキングコレダー,ARG
RETURN GET_攻撃タイプ_NUM("魔法")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_エレキングコレダー, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_エレキングコレダー,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_エレキングコレダー,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_エレキングコレダー,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_エレキングコレダー, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_エレキングコレダー
RETURN GET_SUCCESSION_NUM("전격")
;전격

;スキル変化？用ランク
@SKILL_RANK_エレキングコレダー, ARG = -1
RETURN 12

;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_エレキングコレダー,ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_エレキングコレダー,ARG
RETURN GET_TYPE_NUM("전격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_エレキングコレダー,ARG
RETURN 50

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_エレキングコレダー,ARG
RETURN 95

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_エレキングコレダー,ARG,ARG:1,ARG:2
CALL ATTACK_SINGLE, ARG, POS(ARG:1),ARG:2

;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_エレキングコレダー,ARG
PRINTL 적에게 달라붙어 전신에서 방전을 쏟아붓는 에레킹의 필살기
PRINTL 적 단체에게 전격 특대 데미지를 주고, 확률로 SHOCK 상태로 만든다
;使用条件
@SKILL_SPECIAL_ACTIONABLE_エレキングコレダー,ARG
RETURN 1
;とくにない
