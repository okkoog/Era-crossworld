;シフトスライス　命中100　威力150　攻撃回数1-1　消費10　物理　검격+주살

;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_シフトスライス,ARG
RESULTS = 시프트 슬라이스

;　명중
@SKILL_HITRATE_シフトスライス, ARG
RETURN 100

;　威力
@SKILL_POWER_シフトスライス, ARG
RETURN 150

;　최저공격횟수
@SKILL_MINATTACKNUMBER_シフトスライス,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_シフトスライス,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_シフトスライス, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_シフトスライス,ARG
RETURN 6

;　複合相性
@SKILL_TYPE_シフトスライス,ARG
RETURN GET_TYPE_NUM("검격"), GET_TYPE_NUM("주살")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_シフトスライス
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　攻撃タイプ
@SKILL_ATTACKTYPE_シフトスライス,ARG
RETURN GET_攻撃タイプ_NUM("物理")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_シフトスライス, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_シフトスライス, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_シフトスライス,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_シフトスライス,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_シフトスライス,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_シフトスライス
RETURN GET_SUCCESSION_NUM("빙결")
;スキル変化？用ランク
@SKILL_RANK_シフトスライス, ARG = -1
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_シフトスライス,ARG,ARG:1,ARG:2
CALL ATTACK_SINGLE,ARG,POS(ARG:1),ARG:2

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_シフトスライス,ARG
PRINTL 음의 마력을 두른 일격　검격+주살 상성

;使用条件
@SKILL_SPECIAL_ACTIONABLE_シフトスライス,ARG
RETURN 1
;とくにない


