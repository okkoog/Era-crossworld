;押し潰しをスキルチェンジで作ろうと思ったけど競合したら嫌だなぁって思って作りました

;スキル名
@SKILL_NAME_シールドストライク, ARG
RESULTS = 실드 스트라이크

;　명중
@SKILL_HITRATE_シールドストライク, ARG
RETURN 100

;　威力
@SKILL_POWER_シールドストライク, ARG
RETURN 245

;　최저공격횟수
@SKILL_MINATTACKNUMBER_シールドストライク, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_シールドストライク, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_シールドストライク, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_シールドストライク, ARG
RETURN 6

;　相性
@SKILL_TYPE_シールドストライク, ARG
RETURN GET_TYPE_NUM("타격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_シールドストライク
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_シールドストライク, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_シールドストライク, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_シールドストライク, ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_シールドストライク, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_シールドストライク, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_シールドストライク, ARG = -1
RETURN 5

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_シールドストライク
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_シールドストライク, ARG
RETURN GET_STATE_NUM("SLIP")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_シールドストライク, ARG
RETURN GET_TYPE_NUM("충격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_シールドストライク, ARG
RETURN 25

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_シールドストライク, ARG
RETURN 50

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_シールドストライク, ARG, ARG:1, SKILL_NUM
#DIM SKILL_NUM

CALL ATTACK_SINGLE, ARG, POS(ARG:1), SKILL_NUM
CALL PU_SKILLGAGE_D_SET, ARG, "シールドストライク", 2

;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_シールドストライク, ARG
PRINTL 대형 방패를 전면에 세우고 돌격을 감행한다.
PRINTL 적 단체에 타격 상성으로 대데미지를 주고, 저확률로 전도를 부여한다. 발동이 빠르다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_シールドストライク, ARG
RETURN 1
