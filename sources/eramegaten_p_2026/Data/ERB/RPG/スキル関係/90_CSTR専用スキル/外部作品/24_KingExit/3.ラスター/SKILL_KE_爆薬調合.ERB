;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_爆薬調合, ARG
RESULTS = 爆薬調合

;　명중
@SKILL_HITRATE_KE_爆薬調合, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_爆薬調合, ARG
RETURN 220

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_爆薬調合, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_爆薬調合, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_爆薬調合, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_KE_爆薬調合, ARG
RESULTS = %" 20ＴＰ"%
RETURN 0

;　相性
@SKILL_TYPE_KE_爆薬調合, ARG
RETURN GET_TYPE_NUM("화염")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_爆薬調合
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_爆薬調合, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_爆薬調合, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_KE_爆薬調合, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_爆薬調合, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_爆薬調合, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_KE_爆薬調合, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_爆薬調合
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_爆薬調合, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;ゲージ再回収できる様に起動前にTP20消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 20, "-="

CALL ATTACK_SINGLE, ARG, POS(ARG:1), SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_爆薬調合, ARG
PRINTL 
PRINTL 식물을 조합해 만든 폭약을 사용해 공격한다.
PRINTL 적 1체에 화염 속성 중 데미지.
PRINTL 
PRINTL 식물명예박사 라스터의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_爆薬調合, ARG
;ゲージが20以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 20
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_爆薬調合, ARG
RESULTS:0 = 식물을 조합해 만든 폭약을 사용해 공격한다. 적 1체에 화염 속성 중 데미지.
RESULTS:1 = TP消費 20
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 20
	RESULTS:1 = %RESULTS:1%(不足)