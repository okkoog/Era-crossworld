;ヘルタ専用スキル。氷結一列魔法全貫通。
;原作では戦闘スキル。HP50%以上の相手だとダメージ増加。

;スキル名
@SKILL_NAME_一度限りの取引,ARG
RESULTS = 일회성 거래

;　명중
@SKILL_HITRATE_一度限りの取引, ARG
RETURN 100

;　威力(通常攻撃を100%とした倍率となる)
@SKILL_POWER_一度限りの取引, ARG
IF ARG >= 0
	SIF HAVE_PU_SKILL(ARG, "欠点掴んで罵り倒す")
		RETURN 450
	SIF HAVE_PU_SKILL(ARG, "面子は徹底的に潰す")
		RETURN 380
	SIF HAVE_PU_SKILL(ARG, "私はこういう女なの")
		RETURN 200
ENDIF
RETURN 120

;基礎クリティカル率(標準は5。乗算されるので10になると200%になる)
;@SKILL_CRITICAL_RATE_一度限りの取引, ARG
;RETURN 5

