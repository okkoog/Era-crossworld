;====================================================
;トリガー発動条件
;
;詳しい仕様については資料フォルダの解説を参照してください
;====================================================
@SKILL_TRIGGER_ACTIONABLE_優しさもまた残酷,ARG,ARG:1
;１ターンに一回しか発動しない
SIF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"優しさもまた残酷"))
	RETURN 0
SIF FLAG:행동순1 == ARG
	RETURN 0
SIF !GET_ROLE_PROP("CAN_USE_GUN", ARG)
	RETURN 0
SIF EQUIP:ARG:총 == 0
	RETURN 0
;行動者と味方同士でなければ死
SIF !IS_FRIEND(FLAG:행동순1, ARG)
	RETURN 0
;対象と敵同士でなければ死
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
;単体攻撃でないと発動しない
SIF CFLAG:(FLAG:행동순1):타겟 > 16
	RETURN 0
;味方対象だと発動しない
SIF CFLAG:(FLAG:행동순1):타겟 < 7
	RETURN 0
;あたってないと発動しない
SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "HIT")
	RETURN 0
RETURN 1, CFLAG:(FLAG:행동순1):타겟
