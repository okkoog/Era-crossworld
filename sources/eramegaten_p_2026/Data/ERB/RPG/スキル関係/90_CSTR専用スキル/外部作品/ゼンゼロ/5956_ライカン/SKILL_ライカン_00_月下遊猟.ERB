;スキル名
@SKILL_NAME_月下遊猟,ARG
RESULTS = 月下遊猟

;　명중
@SKILL_HITRATE_月下遊猟, ARG
RETURN 90

;　威力
@SKILL_POWER_月下遊猟, ARG
SIF ARG < 0
	RETURN 120
CALL GET_SKILL_POWER_月下遊猟(GET_ROLE_CFLAG_TAKEOVER(ARG, "通常スキルランク"))
RETURN RESULT

@GET_SKILL_POWER_月下遊猟, ARG, ARG:1 = -1
SELECTCASE ARG
	CASE 15
		RESULT = 450
	CASE 11 TO 14
		RESULT = 390 + (ARG - 10) * 12
	CASE 10
		RESULT = 390
	CASE 2 TO 9
		RESULT = 90 + 30 * ARG
	CASE 0, 1
		RESULT = 120
	CASEELSE
		RESULT = 0
ENDSELECT
SIF ARG:1 == -1
	RETURN RESULT
RETURN RESULT * GET_CHARGE_POWER_月下遊猟(ARG:1) / 100

@GET_CHARGE_POWER_月下遊猟, ARG
#FUNCTION
#DIM DYNAMIC L_RESULT
IF HAVE_PU_SKILL(ARG, "冷酷な猟人")
	RETURNF 100 + GET_CHARGE_月下遊猟(ARG) * 25
ELSE
	RETURNF 100 + GET_CHARGE_月下遊猟(ARG) * 15
ENDIF

@GET_CHARGE_月下遊猟, ARG
#FUNCTION
SIF !HAVE_PU_SKILL(ARG, "月下遊猟")
	RETURNF 0
RETURNF PU_SKILLGAGE_H_GET(ARG, "月下遊猟")

;;クリティカル率
@SKILL_CRITICAL_RATE_月下遊猟, ARG
RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_月下遊猟,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_月下遊猟,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_月下遊猟, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_月下遊猟,ARG
SIF ARG < 0
	RETURN 4
CALL GET_SKILL_COST_月下遊猟(GET_ROLE_CFLAG_TAKEOVER(ARG, "通常スキルランク"))
RETURN RESULT

;　コストの量
@GET_SKILL_COST_月下遊猟,ARG
SELECTCASE ARG
	CASE 15
		RETURN 23
	CASE 11 TO 14
		RETURN 18 + (ARG - 10)
	CASE 10
		RETURN 18
	CASE 1 TO 9
		RETURN 3 + ARG * 3 / 2
	CASE 0, 1
		RETURN 3
ENDSELECT

;　相性
;複合相性
@SKILL_TYPE_月下遊猟,ARG
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "執事の教養")
	RETURN GET_TYPE_NUM("빙결"), GET_TYPE_NUM("타격")
ELSE
	RETURN GET_TYPE_NUM("빙결")
ENDIF


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_月下遊猟
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_月下遊猟,ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_月下遊猟,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_月下遊猟,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_月下遊猟,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_月下遊猟,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_月下遊猟, ARG = -1
RETURN 0

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_月下遊猟, ARG = -1, ARG:1 = -1
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "アルファの本性")
	RETURN 0, 4
ELSE
	RETURN 0, 0
ENDIF

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_月下遊猟,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_月下遊猟,ARG
PRINTL 【일반】【라이칸 전용 스킬】
PRINTL 적 단체에 빙결 상성의 물리 속성 데미지를 주고, 차지를 1단계 획득한다.
PRINTL 이 스킬의 위력과 획득 데시벨은 차지 단계에 따라 증가한다.
PRINTL 차지는 최대 3단계까지 누적되며, 파티의 행동으로 차지를 얻지 못했을 때 전부 상실된다.

;　説明文の表示
@ENHANCE_SKILL_EXPLAIN_月下遊猟,ARG
RESULTS '= "敵単体に氷結相性の物理属性ダメージを与え、チャージを１段階獲得する。" + "<br>"
RESULTS += "このスキルの威力と獲得デシベル値はチャージ段階によって増加する。" + "<br>"
RESULTS += "チャージは最大で3段階まで累積し、チームの行動でチャージを得られなかった時すべて失われる。"

;使用条件
@SKILL_SPECIAL_ACTIONABLE_月下遊猟,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_月下遊猟, ARG = -1
RETURN 1

@SKILL_TAG_月下遊猟
RESULTS = 젠제로 일반 스킬

@BASE_DECIBEL_PTS_月下遊猟, ARG
IF HAVE_PU_SKILL(ARG, "満月に備えよ")
	RETURN 100 + (1 + GET_CHARGE_月下遊猟(ARG)) * 35
ELSE
	RETURN 100 + (1 + GET_CHARGE_月下遊猟(ARG)) * 25
ENDIF

@SKILL_EX_DISPLAY_月下遊猟, ARG, ARGS
RESULTS '= SET_BUTTON_TAG(@"特:{GET_ROLE_CFLAG_DUNGEON(ARG,"デシベル値"),4}pts", "", "デシベル値&")
RESULTS += "　" + SET_BUTTON_TAG(@"Ch:{PU_SKILLGAGE_H_GET(ARG, "月下遊猟")}", "", @"CHARGE:一部スキル強化")
RETURN 1

@SKILLGAGE_CHARGE_月下遊猟, L_CHARA, L_ACTOR
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_ACTOR
#DIMS DYNAMIC L_SKILL
#DIM DYNAMIC L_GP
IF L_CHARA == FLAG:행동순1
	IF IS_PU_SKILL_入力行動(L_CHARA, "月下遊猟")
		IF PU_SKILLGAGE_H_GET(L_CHARA, "月下遊猟") == 3 || !GET_CREC_ACT_SUM(L_CHARA, "적", "HIT")
			CALL PU_SKILLGAGE_H_SET, L_CHARA, "月下遊猟", 0
		ELSE
			CALL PU_SKILLGAGE_H_ADD, L_CHARA, "月下遊猟", 1
			RESULTS = 차지
			RESULTS:1 = 
			RETURN 1
		ENDIF
	ELSE
		CALL PU_SKILLGAGE_H_SET, L_CHARA, "月下遊猟", 0
	ENDIF
ELSE
	SIF FLAG:행동순1 == FINDCHARA_TIMEID(CFLAG:L_CHARA:피링크캐릭터실제가입시간)
		CALL PU_SKILLGAGE_H_SET, L_CHARA, "月下遊猟", 0
ENDIF
RETURN 0

@SKILLGAGE_CHARGE_USEABLE_RESERVE_月下遊猟, ARG
RETURN 1