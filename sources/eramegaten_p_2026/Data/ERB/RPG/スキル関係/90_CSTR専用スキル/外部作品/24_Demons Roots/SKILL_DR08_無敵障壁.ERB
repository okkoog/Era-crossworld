@ACTION_無敵障壁,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM 体力消費値

;オラクルから使いまわした
体力消費値 = BASE:ARG:ＨＰ - 1
CALL VAR_HP,ARG,-体力消費値, "食いしばり無効ダメージ"
PRINTFORML ＞%CALLNAME:ARG%(은)는 생명력을 깎아 장벽을 만들어냈다!

CALL SKILL_SET_HPバリア, ARG, MAXBASE:ARG:LV * 50 , "『無敵障壁』" , "非表示"
WAIT

CALL SKILLGAGE_H_SET,ARG,PU_SKILLNUM_GET(ARG,"無敵障壁"),1



