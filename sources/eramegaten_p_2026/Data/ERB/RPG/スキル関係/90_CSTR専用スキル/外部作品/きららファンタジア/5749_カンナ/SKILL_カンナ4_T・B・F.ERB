;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_T・B・F,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL PRINT_HIT_MESSAGE, ARG, "3ターンの間、敵に狙われやすくなった！", "W"
CFLAG:ARG:피타겟비율변동지속턴수 = 3
CFLAG:ARG:변동피타겟율 = 300
CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"T・B・F"),4

