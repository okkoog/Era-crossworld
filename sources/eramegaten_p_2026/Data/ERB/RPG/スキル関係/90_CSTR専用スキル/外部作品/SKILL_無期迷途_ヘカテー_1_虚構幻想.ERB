;スキル名
@SKILL_NAME_虚構幻想,ARG
RESULTS = 虚構幻想

;　명중
@SKILL_HITRATE_虚構幻想, ARG
RETURN 100

;　威力(通常攻撃を100%とした倍率となる)
@SKILL_POWER_虚構幻想, ARG
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "寂滅の水影")
	SIF FLAG:총공격중
		RETURN 110
	RETURN 220
ELSE
	SIF FLAG:총공격중
		RETURN 40
	RETURN 80
ENDIF
;基礎クリティカル率(標準は5。乗算されるので10になると200%になる)
@SKILL_CRITICAL_RATE_虚構幻想, ARG
RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_虚構幻想,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_虚構幻想,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_虚構幻想, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_虚構幻想,ARG
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "寂滅の水影")
	RETURN 32
ELSE
	RETURN 6
ENDIF

;　相性
@SKILL_TYPE_虚構幻想,ARG
RETURN GET_TYPE_NUM("정신")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_虚構幻想
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_虚構幻想, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_虚構幻想, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리(1 = 後列発動不可・後列指定不可 2 = 後列発動可能・後列指定不可 3 = 後列発動可能・後列指定可能 4 = 後列発動不可・後列指定可能)
@SKILL_RANGE_虚構幻想,ARG
RETURN 3

;　範囲　単体　一列　全体　敵味方全体　縦列
@SKILL_SPHERE_虚構幻想,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_虚構幻想, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_虚構幻想
RETURN GET_SUCCESSION_NUM("정신")

;속도보정
@SKILL_SPEED_虚構幻想, ARG = -1
RETURN 0

;スキルランク
;スキルの習得時の必要ＭＡＧの算出に主に用いられる
;また、習得・所持スキルはこのランクの5倍のレベルを基準として設定する。
@SKILL_RANK_虚構幻想, ARG = -1
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "寂滅の水影")
	RETURN 15
ELSE
	RETURN 1
ENDIF

;====================================================
;スキル及び行動の実行
;ARG = スキルの使用者
;ARG:1 = スキルの使用対象
;ARG:2 = スキルの番号
;====================================================
@ACTION_虚構幻想, ARG, ARG:1, ARG:2
CALL ATTACK_SKILL,ARG,ARG:1,ARG:2
IF FLAG:총공격중
	CALL PU_SKILLGAGE_F_ADD, ARG, "虚構幻想", -1
ELSE
	CALL PU_SKILLGAGE_H_SET, ARG, "虚構幻想", CFLAG:POS(ARG:1):실제가입시간
	CALL PU_SKILLGAGE_F_SET, ARG, "虚構幻想", 3
ENDIF

;====================================================
;トリガー発動条件
;====================================================
@SKILL_TRIGGER_ACTIONABLE_虚構幻想,ARG,ARG:1
;行動した敵のみ判定
SIF ARG:1 != FLAG:행동순1
	RETURN 0
SIF PU_SKILLGAGE_F_GET(ARG, "虚構幻想") <= 0
	RETURN 0
SIF PU_SKILLGAGE_H_GET(ARG, "虚構幻想") != CFLAG:(FLAG:행동순1):실제가입시간
	RETURN 0
RETURN 1, CPOS(FLAG:행동순1)

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_虚構幻想, ARG
PRINTL 대상 적 1체에게 정신 상성의 소데미지를 주고, 최대 1체까지의 적을 록온한다.
PRINTL 록온된 적이 행동할 때마다, 최대 3회까지 이하의 연동 효과가 발동한다.
PRINTL 「정신 상성의 극소 데미지를 준다」

;ツールチップ版の解説文
@SKILL_EXPLAIN_TOOLTIP_虚構幻想, ARG
RESULTS:0 = 대상 적 1체에게 정신 상성의 소데미지를 주고, 최대 1체까지의 적을 록온한다.
RESULTS:1 = 록온된 적이 행동할 때마다 최대 3회까지 이하의 연동 효과가 발동한다.
RESULTS:2 = 「精神相性の極小ダメージを与える」

;使用条件
;真の時、使用可能となる。というより特定条件で使用不能にしたい場合は0をいれてかえさせる。
;RESULTSに文字をいれてもどすことで使えない場合の理由がポップアップするようになる。
@SKILL_SPECIAL_ACTIONABLE_虚構幻想,ARG
RETURN 1
;とくにない

@SKILL_BATTLE_MAIN_TOOLTIP_虚構幻想, ARG, ARG:1
#DIM DYNAMIC L_TARGET
SIF !PU_SKILLGAGE_F_GET(ARG, "虚構幻想")
	RETURN 0
L_TARGET = FINDCHARA_TIMEID(PU_SKILLGAGE_H_GET(ARG, "虚構幻想"))
SIF L_TARGET < 0
	RETURN 0
SIF !IS_TARGET_ABLE(L_TARGET)
	RETURN 0
RESULTS = □虚構幻想
RESULTS:1 '= @"　残り:{PU_SKILLGAGE_F_GET(ARG, "虚構幻想")}回 >>> [{CPOS(L_TARGET)}] %CALLNAME:L_TARGET%"

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_虚構幻想, ARG
#DIM DYNAMIC L_TARGET
SIF !PU_SKILLGAGE_F_GET(ARG, "虚構幻想")
	RETURN 0
L_TARGET = FINDCHARA_TIMEID(PU_SKILLGAGE_H_GET(ARG, "虚構幻想"))
SIF L_TARGET < 0
	RETURN 0
SIF !IS_TARGET_ABLE(L_TARGET)
	RETURN 0
RESULTS '= SET_COLOR_TAG(@"虚構幻想 >>> [POS.{CPOS(L_TARGET),2}]({PU_SKILLGAGE_F_GET(ARG, "虚構幻想")}回)", "p-green")
RETURN 3