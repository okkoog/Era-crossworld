;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_エリキシル剤,ARG,ARG:1
#LOCALSIZE 1
#DIM SKILL_NUM
#DIM L_T
#DIM 調合率
#DIM L_GP
#DIM L_GP_LIMIT
#DIM L_COLOR
L_GP = 0
L_GP_LIMIT = 100
L_COLOR = 0x34EBA7

;PU_SKILLNUM_GET(使用者,"専用技の名前")を組み込むことで、その専用技に対応するスキル番号が返ってくる
;使用者の番号が不正値（-1など）だった場合はエラーを吐くので注意
;SKILL_NUM に専用技のスキル番号を代入
SKILL_NUM = PU_SKILLNUM_GET(ARG,"エリキシル剤")

;SKILLGAGE_F_GET(使用者,スキル番号)を組み込む事で、該当するスキルのHゲージの値が返ってくる

;自身の行動でなければ終了
SIF ARG != ARG:1
	RETURN 0

;自身の手番の時に上昇率は10しか増加しない

L_GP += 10

;SKILLGAGE_F_SET(使用者,スキル番号,設定する数値)を呼ぶ事で、該当するスキルのHゲージが上書きされる
;以下の場合、 L_GP と 現在のHスキルゲージ を合算した数値か、もしくは上限値である 100 がHゲージの値に設定される
CALL SKILLGAGE_F_SET(ARG,SKILL_NUM,MIN(L_GP + SKILLGAGE_F_GET(ARG,SKILL_NUM), L_GP_LIMIT))

;増加によってゲージが上限に到達した場合、調合完了のメッセージを表示する
IF SKILLGAGE_F_GET(ARG,SKILL_NUM) == L_GP_LIMIT
	RESULTS = 調合完了！
	RESULT:1 = L_COLOR
ELSE
	RESULTS = 調合中……
ENDIF

RESULTS:1 = \%
RETURN L_GP
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_エリキシル剤,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM LCOUNT
#DIM L_CHARA
#LOCALSIZE 4
SKILL_NUM = PU_SKILLNUM_GET(ARG,"エリキシル剤")

;味方の場合、COMPの中にまで効果が及ぶ
IF CFLAG:ARG:PT플래그 == 0
	FOR L_CHARA, 0, CHARANUM
		SIF !IS_COMP内効果有効(L_CHARA)
			CONTINUE
		IF CFLAG:L_CHARA:상태이상 == GET_STATE_NUM("DYING")
			CFLAG:L_CHARA:상태이상 = GET_STATE_NUM("GOOD")
			CALL HEAL_SINGLE, ARG, L_CHARA, SKILL_NUM, 1, , "蘇生"
		ELSE
			CALL HEAL_SINGLE, ARG, L_CHARA, SKILL_NUM, 1
		ENDIF
	NEXT
ELSE
	;敵の場合は場に出てるやつにのみ
	;味方の効果をCOMPの中に届かせないなら、この部分は味方にも適用されるので上の分岐をけしてここだけ残してください
	FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
		L_CHARA = POS(LCOUNT)
		SIF L_CHARA < 0
			CONTINUE
		IF CFLAG:L_CHARA:상태이상 == GET_STATE_NUM("DYING")
			CFLAG:L_CHARA:상태이상 = GET_STATE_NUM("GOOD")
			CALL HEAL_SINGLE, ARG, L_CHARA, SKILL_NUM, 1, , "蘇生"
		ELSE
			CALL HEAL_SINGLE, ARG, L_CHARA, SKILL_NUM, 1
		ENDIF
	NEXT
ENDIF
WAIT
;CALL CURE_STATE_FIELD,ARG,ARG:1,416
;CALL HEAL_FIELD,ARG,ARG:1,420

CALL SKILLGAGE_F_SET,ARG,PU_SKILLNUM_GET(ARG,"エリキシル剤"),0

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_エリキシル剤,ARG
;ゲージ量を表示。チャージ完了時カラーで強調
IF PU_SKILLGAGE_F_GET(ARG,"エリキシル剤") == 100
	RESULTS '= SET_COLOR_TAG(@"エリキシル剤：{PU_SKILLGAGE_F_GET(ARG,"エリキシル剤")}％", "#34EBA7")
ELSE
	RESULTS '= SET_COLOR_TAG(@"エリキシル剤：{PU_SKILLGAGE_F_GET(ARG,"エリキシル剤")}％", "#999999")
ENDIF
RETURN 3

@SKILL_EX_DISPLAY_エリキシル剤, ARG, ARGS
#DIM BARLENS
BARLENS = SKILL_EX_DISPLAY_LENS - 2
IF PU_SKILLGAGE_H_GET(ARG, "エリキシル剤") >= 100
	RESULTS = %SET_COLOR_TAG(UNICODE(0x2728), "パ緑")%
	RESULTS += SET_COLOR_TAG(" " * (BARLENS - 5) + "Ready", "パ緑")
ELSE
	RESULTS = %SET_COLOR_TAG(UNICODE(0x2728), "yellow")%
	RESULTS += HTML_RECT_BAR(PU_SKILLGAGE_H_GET(ARG, "エリキシル剤"), 100, BARLENS, BARCOLORSET("緑"), RESULT:1)
ENDIF
RETURN 1
