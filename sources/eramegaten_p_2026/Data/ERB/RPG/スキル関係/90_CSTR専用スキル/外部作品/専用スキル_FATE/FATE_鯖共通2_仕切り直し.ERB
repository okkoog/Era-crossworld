;スキル名
@SKILL_NAME_仕切り直し,ARG
RESULTS = 재정비

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_仕切り直し
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_仕切り直し,ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

@SKILL_TURNEND_仕切り直し, ARG
CALL SKILL_CURE_STATE_仕切り直し, CFLAG:ARG:상태이상
SIF RESULT == 0
	RETURN 0
SIF PU_SKILLGAGE_H_GET(ARG, "仕切り直し") >= 2
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG, , , , "仕切り直し"
CALL CURE_STATE_SINGLE, ARG, ARG, PU_SKILLNUM_GET(ARG,"仕切り直し")
CALL PU_SKILLGAGE_H_ADD,ARG,"仕切り直し",1

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_仕切り直し,ARG
PRINTL 턴 종료 시 자신에게 FLY, DYING, ORGY, HEAT 이외의 상태이상이 부착되어 있을 경우 이하의 연동효과가 발동한다.
PRINTL 「자신의 상태이상을 회복한다.」
PRINTL 이 효과는 전투 중에 2회까지 발동한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_仕切り直し,ARG
RETURN 0

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_仕切り直し,ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT
