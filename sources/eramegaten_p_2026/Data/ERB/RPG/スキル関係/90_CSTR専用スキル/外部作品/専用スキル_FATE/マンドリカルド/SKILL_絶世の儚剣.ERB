;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_絶世の儚剣,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#LOCALSIZE 3
SKILL_NUM = PU_SKILLNUM_GET(ARG,"絶世の儚剣")
PRINTFORMW ＞%CALLNAME:ARG%의 공격력이 대폭 상승!
;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 12)
PRINTFORMW ＞%CALLNAME:ARG%의 크리티컬률이 대폭 상승!
;CFLAG:ARG:크리티컬강화 = MIN(8, CFLAG:ARG:크리티컬강화 + 8)
CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 12, "단체", "NOMES"
CALL SKILL_SET_カジャンダ, ARG, ARG, "크리티컬", 8, "단체", "NOMES"

;攻撃前に敵全体の防御減少効果
IF CFLAG:(ARG):PT플래그 == 0
	LOCAL:1 = 1
	LOCAL:2 = 7
ELSE
	LOCAL:1 = 7
	LOCAL:2 = 17
ENDIF

;FOR LOCAL,LOCAL:1,LOCAL:2
;	SIF POS(LOCAL) < 0
;		CONTINUE
;	CFLAG:POS(LOCAL):방어강화 = MAX(-16, CFLAG:POS(LOCAL):방어강화 - 16)
;NEXT
CALL SKILL_SET_カジャンダ, ARG, CFLAG:ARG:PT플래그 ? 22 # 19, "공격", -8, "範囲", "NOMES"
PRINTFORMW \@ CFLAG:ARG:PT플래그 ? 적 # 아군 \@의 방어력을 크게 낮췄다!

CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)

;行動後、即死
PRINTFORMW ＞절세의 몽검 효과로 %CALLNAME:ARG%(은)는 전투불능이 되었다!
BASE:ARG:ＨＰ = 0
CALL DEAD_CHARA,ARG,ARG

CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,1

;　説明文の表示
@SKILL_EXPLAIN_絶世の儚剣,ARG
PRINTL 제2보구 『절세의 몽검(레브 드 듀란달)』
PRINTL 
PRINTL 불대검의 맹세를 파기함으로써 사용할 수 있는 제2보구를 개방하여,
PRINTL 자신의 죽음도 마다하지 않는 최후의 일격을 때려박는다.
PRINTL 
PRINTL 자신의 공격력과 크리티컬률을 대폭 상승시키고, 적 전체의 방어력을 낮춘다.
PRINT 그 뒤에 적 전체에게 검격 물리 특대 데미지. 행동 후,
SETCOLOR 0xff0033
PRINT 戦闘不能
RESETCOLOR
PRINTL 가 된다.
PRINTL 1전투당 1회만 사용 가능. 사용 후 해당 전투 중에는 『불대검의 맹세』도 사용 불가.


;使用条件
@SKILL_SPECIAL_ACTIONABLE_絶世の儚剣,ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"絶世の儚剣")
SIF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")) == 0
	RETURN 0
SIF SKILLGAGE_H_GET(ARG,SKILL_NUM) != 0 
	RETURN 0
RETURN 1

