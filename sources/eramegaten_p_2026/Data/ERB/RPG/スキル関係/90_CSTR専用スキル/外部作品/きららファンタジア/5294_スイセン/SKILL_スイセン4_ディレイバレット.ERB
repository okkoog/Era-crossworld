
;スキル名
@SKILL_NAME_ディレイバレット,ARG
RESULTS = 딜레이 불릿

;　명중
@SKILL_HITRATE_ディレイバレット, ARG
RETURN 140

;　威力
@SKILL_POWER_ディレイバレット, ARG
RETURN 360

@SKILL_CRITICAL_RATE_ディレイバレット, ARG
RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ディレイバレット,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ディレイバレット,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ディレイバレット, ARG
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_ディレイバレット,ARG
RETURN 12

;　相性
@SKILL_TYPE_ディレイバレット,ARG
RETURN GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ディレイバレット
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ディレイバレット,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ディレイバレット,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ディレイバレット,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ディレイバレット,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_ディレイバレット,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

@SKILL_SUCCESSION_TYPE_ディレイバレット,ARG
RETURN GET_SUCCESSION_NUM("비구")

@SKILL_RANK_ディレイバレット, ARG = -1
RETURN 7

;속도보정
@SKILL_SPEED_ディレイバレット, ARG = -1
RETURN -30

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ディレイバレット
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ディレイバレット,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

