;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_女神の祝福, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;ゲージ再回収できる様に起動前にTP60消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 60, "-="

FOR LOCAL, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	SIF POS(LOCAL) < 0 || IS_BADSTATE(POS(LOCAL), "DYING")
		CONTINUE

	LOCAL:1 = MAX(LOCAL:1, STRLENS(CALLNAME:POS(LOCAL)))
NEXT
FOR LOCAL, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	SIF POS(LOCAL) < 0 || IS_BADSTATE(POS(LOCAL), "DYING")
		CONTINUE

	IF CFLAG:POS(LOCAL):("방어강화") >= 8
		PRINTFORML 　　TARGET:[{LOCAL},2] %CALLNAME:POS(LOCAL), LOCAL:1, LEFT% >>>>> 이미 이 스킬의 한계까지 강화되어 있다!
	ELSE
		CALL SKILL_SET_カジャンダ, ARG, POS(LOCAL), "방어", 8, "단체", "", "", 8
	ENDIF
NEXT

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_女神の祝福, ARG
PRINTL 
PRINTL 아군에게 축복을 내린다.
PRINTL 아군 전체의 방어를 2단계까지 강화한다.
PRINTL 
PRINTL 강철승려 브루의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_女神の祝福, ARG
;ゲージが60以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 60
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_女神の祝福, ARG
RESULTS:0 = 아군 전체의 방어를 2단계까지 강화한다.
RESULTS:1 = TP消費 60
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 60
	RESULTS:1 = %RESULTS:1%(不足)