;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_CSTR_怒り爆発, ARG
#DIMS DYNAMIC L_COLOR
L_COLOR = #ffdc00
SIF PU_SKILLGAGE_D_GET(ARG,"CSTR_怒り爆発") > 0
	L_COLOR = #f8b856
IF PU_SKILLGAGE_D_GET(ARG,"CSTR_怒り爆発") > 0 && PU_SKILLGAGE_H_GET(ARG,"CSTR_怒り爆発") == 200
	RESULTS '= SET_COLOR_TAG("분노폭발　: " + TOFULL(TOSTR(PU_SKILLGAGE_D_GET(ARG,"CSTR_怒り爆発"))) + "Ｔ", L_COLOR)
ELSEIF PU_SKILLGAGE_D_GET(ARG,"CSTR_怒り爆発") > 0
	RESULTS '= SET_COLOR_TAG("怒り状態　: " + TOFULL(TOSTR(PU_SKILLGAGE_D_GET(ARG,"CSTR_怒り爆発"))) + "Ｔ", L_COLOR)
ELSEIF PU_SKILLGAGE_H_GET(ARG,"CSTR_怒り爆発") < 100
	RESULTS '= SET_COLOR_TAG("怒りゲージ: " + @"{PU_SKILLGAGE_H_GET(ARG,"CSTR_怒り爆発"), 3}" + "％", L_COLOR)
ENDIF
SIF RESULTS != ""
	RESULTS += "<br>"
IF PU_SKILLGAGE_F_GET(ARG,"CSTR_怒り爆発") == 1
	RESULTS += "剣質　　　:" + SET_COLOR_TAG("羅刹", "藍色")
ELSE
	RESULTS += "剣質　　　:" + SET_COLOR_TAG("修羅", "赤")
ENDIF
RETURN 3

@SKILL_EX_DISPLAY_CSTR_怒り爆発, ARG, ARGS
#DIM BARLENS
#DIM BAR_COLOR, 2
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"CSTR_怒り爆発")

BARLENS = SKILL_EX_DISPLAY_LENS - 2
IF SKILLGAGE_F_GET(ARG,SKILL_NUM) == 1
	BAR_COLOR = BARCOLORSET("青"), RESULT:1
	RESULTS = %SET_COLOR_TAG("怒", "藍色")%
ELSE
	BAR_COLOR = BARCOLORSET("赤"), RESULT:1
	RESULTS = %SET_COLOR_TAG("怒", "赤")%
ENDIF
IF SKILLGAGE_H_GET(ARG,SKILL_NUM) == 200
	RESULTS += HTML_RECT_SPLIT_BAR(SKILLGAGE_D_GET(ARG, SKILL_NUM), 6, BARLENS, BAR_COLOR, BAR_COLOR:1)
	RESULTS:1 = 분노폭발
ELSEIF SKILLGAGE_D_GET(ARG,SKILL_NUM) > 0
	RESULTS += HTML_RECT_SPLIT_BAR(SKILLGAGE_D_GET(ARG, SKILL_NUM), 5, BARLENS, BAR_COLOR, BAR_COLOR:1)
	RESULTS:1 = 분노 상태
ELSE
	RESULTS += HTML_RECT_BAR(SKILLGAGE_H_GET(ARG, SKILL_NUM), 100, BARLENS, BAR_COLOR, BAR_COLOR:1)
	RESULTS:1 = 분노 게이지
ENDIF
RETURN 1

