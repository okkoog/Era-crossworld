@SKILL_HITRATE_ベルレンプファイル, ARG
RETURN 100

;　威力
@SKILL_POWER_ベルレンプファイル, ARG
SIF ARG == -1
	RETURN 50
IF BASE:ARG:LV < 10
	RETURN 60
ELSEIF BASE:ARG:LV < 20
	RETURN 70
ELSEIF BASE:ARG:LV < 30
	RETURN 85
ELSEIF BASE:ARG:LV < 40
	RETURN 100
ELSE
	RETURN 100
ENDIF
