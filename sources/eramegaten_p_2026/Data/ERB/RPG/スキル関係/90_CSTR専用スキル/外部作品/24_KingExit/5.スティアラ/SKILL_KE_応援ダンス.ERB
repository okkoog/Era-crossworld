;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_応援ダンス, ARG
RESULTS = 응원 댄스

;　명중
@SKILL_HITRATE_KE_応援ダンス, ARG
RETURN 0

;　威力
@SKILL_POWER_KE_応援ダンス, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_応援ダンス, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_応援ダンス, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_応援ダンス, ARG
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 30
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_KE_応援ダンス, ARG
IF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 30
	RESULTS = %" 30ＴＰ"%
	RETURN 0
ENDIF
RETURN 5

;　相性
@SKILL_TYPE_KE_応援ダンス, ARG
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_応援ダンス
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_応援ダンス, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_KE_応援ダンス, ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_応援ダンス, ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_応援ダンス, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;속도보정
@SKILL_SPEED_KE_応援ダンス, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_応援ダンス
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_応援ダンス, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;ゲージ再回収できる様に起動前にTP30消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 30, "-="

CALL SET_C_BTL_EFFECT_FIELD, ARG, ARG:1, "応援ダンス"

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_応援ダンス, ARG
PRINTL 
PRINTL 스티아라가 즉흥적인 댄스로 모두를 북돋운다.
PRINTL 아군 1열에 4턴 동안 TP를 10 회복하는 상태를 부여한다.
PRINTL 
PRINTL 전직 승려 스티아라의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_応援ダンス, ARG
;ゲージが30以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 30
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_応援ダンス, ARG
RESULTS:0 = 아군 1열에 4턴 동안 TP를 10 회복하는 상태를 부여한다.
RESULTS:1 = TP消費 30
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 30
	RESULTS:1 = %RESULTS:1%(不足)