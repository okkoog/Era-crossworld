;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_バカガード,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM L_T
#DIM L_R
LOCAL = 0
L_T = POS(ARG:1)
L_R = -1
SIF CPOS(ARG) > -1
	L_R = POS(CPOS(ARG) + (CPOS(ARG) > 6 ? 5 # 3))

;自分と対象が前列にいる
IF IS_FRONT(ARG) && IS_FRONT(L_T) && ARG != L_T
	CALL SET_C_BTL_EFFECT_SINGLE,L_T,  ARG, "バカガード"
	SIF L_R > -1
		CALL SET_C_BTL_EFFECT_SINGLE,L_T,  L_R, "バカガード"
	CFLAG:L_T:방어플래그 = 0
	CFLAG:L_T:입력행동 = -1
	PRINTFORMW %CALLNAME:(L_T)%(을)를 방패로 삼았다.
	;CALL SKILLGAGE_D_SET, ARG, SKILL_NUM, 5
ELSE
	PRINTW 제대로 들어맞지 않았다
ENDIF

