@CREATE_リラックス_SPRITE, CHARANO, L_SITUATION
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC CHARANO
#DIMS DYNAMIC L_SITUATION
#DIMS DYNAMIC L_ADDRESS
#DIMS DYNAMIC L_SPRITENAME
#DIM DYNAMIC GID,2
L_ADDRESS '= "80_スキル画像" + "\\" + "CSTR_リラックス" + "\\" + GET_識別名(CHARANO) + "\\"+ L_SITUATION
LCOUNT = 1
WHILE 1
	L_SPRITENAME '= GET_識別名(CHARANO) + "_" + L_SITUATION + "_" + @"{LCOUNT}"
	;スプライト作成済みなら終わる
	SIF SPRITECREATED(L_SPRITENAME)
		RETURN 1
	GID = GET_FREE_TEMP_GID()
	IF CHARANO == [[キャラ:에노스]] && GROUPMATCH(L_SITUATION, "アクション1", "アクション2")
		IF !SPRITECREATED("エノス_テレビ")
			SIF !GCREATEFROMFILE(GID, "80_スキル画像" + "\\" + "CSTR_リラックス" + "\\" + GET_識別名(CHARANO) + "\\"+ "エノス_テレビ" + ".png")
				RETURN 0
			SPRITECREATE "エノス_テレビ", GID, 0, 0, GWIDTH(GID), GHEIGHT(GID)	
			CALL PUSH_ARRAY_STR, TEMP_GID_SPRITENAME, "エノス_テレビ"
			GID = GET_FREE_TEMP_GID()
		ENDIF
		;1枚目が作れない場合は失敗として返す
		SIF !GCREATEFROMFILE(GID, L_ADDRESS + "_" + TOSTR(LCOUNT, "00") + ".png")
			RETURN (LCOUNT > 1)
		SPRITECREATE L_SPRITENAME + "_TEMP", GID, 0, 0, GWIDTH(GID), GHEIGHT(GID)
		CALL PUSH_ARRAY_STR, TEMP_GID_SPRITENAME, L_SPRITENAME + "_TEMP"
		
		GID:1 = GET_FREE_TEMP_GID()
		GCREATE GID:1, GWIDTH(GID) + SPRITEWIDTH("エノス_テレビ"), GHEIGHT(GID)
		GDRAWSPRITE GID:1, "エノス_テレビ", 0, 0, SPRITEWIDTH("エノス_テレビ"), GHEIGHT(GID:1)
		GDRAWSPRITE GID:1, L_SPRITENAME + "_TEMP", SPRITEWIDTH("エノス_テレビ"), 0, GWIDTH(GID), GHEIGHT(GID)
		SPRITECREATE L_SPRITENAME, GID:1, 0, 0, GWIDTH(GID:1), GHEIGHT(GID:1)
	ELSE
		;1枚目が作れない場合は失敗として返す
		SIF !GCREATEFROMFILE(GID, L_ADDRESS + "_" + TOSTR(LCOUNT, "00") + ".png")
			RETURN (LCOUNT > 1)
		SPRITECREATE L_SPRITENAME, GID, 0, 0, GWIDTH(GID), GHEIGHT(GID)
	ENDIF
	CALL PUSH_ARRAY_STR, TEMP_GID_SPRITENAME, L_SPRITENAME
	LCOUNT++
WEND

@PRINT_リラックス_ANIME, CHARANO, L_SITUATION, BASE_XPOS = 100, BASE_YPOS = -100
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC CHARANO
#DIMS DYNAMIC L_SITUATION
#DIMS DYNAMIC L_SPRITENAME, 2
#DIMS DYNAMIC SHOW_RAYER
#DIM DYNAMIC L_WIDTH
#DIM DYNAMIC BASE_XPOS
#DIM DYNAMIC BASE_YPOS
#DIMS DYNAMIC SITUATION_TABLE = "アクション1", "アクション2", "アクション3", "ドリンク", "샤워", "スリープ"
IF L_SITUATION == ""
	;テーブルをSHUFFLEして順番に試す
	CALL SHUFFLE_ARRAY_STR, SITUATION_TABLE
	FOR LCOUNT, 0, VARSIZE("SITUATION_TABLE")
		;シチュが指定されている場合
		CALL CREATE_リラックス_SPRITE, CHARANO, SITUATION_TABLE:LCOUNT
		SIF !RESULT
			CONTINUE
		L_SITUATION '= SITUATION_TABLE:LCOUNT
		BREAK
	NEXT
ELSE
	;シチュが指定されている場合
	CALL CREATE_リラックス_SPRITE, CHARANO, L_SITUATION
	SIF !RESULT
		RETURN 0
ENDIF
L_SPRITENAME '= GET_識別名(CHARANO) + "_" + L_SITUATION
LCOUNT = 1
L_WIDTH = 1250 * SPRITEWIDTH(L_SPRITENAME + "_1") / SPRITEHEIGHT(L_SPRITENAME + "_1") + 50
WHILE SPRITECREATED(L_SPRITENAME + @"_{LCOUNT}")
	SHOW_RAYER '= @"<img src = '%L_SPRITENAME%_{LCOUNT}' height = '1250'>"
	{
	SHOW_RAYER '= @"<div xpos = '{BASE_XPOS}' ypos = '{BASE_YPOS - 1300}'
					height = '1300' width = {L_WIDTH}
					padding = '25' border_width = '3px'
					background_color = '%TOSTR_HTML(GETBGCOLOR())%' display = 'absolute-leftbottom'
					>" + SHOW_RAYER + "</div>"
	}
	HTML_PRINT_ISLAND SHOW_RAYER
	INPUTMOUSEKEY 100
	HTML_PRINT_ISLAND_CLEAR
	SIF RESULT != 4
		BREAK
	LCOUNT++
WEND