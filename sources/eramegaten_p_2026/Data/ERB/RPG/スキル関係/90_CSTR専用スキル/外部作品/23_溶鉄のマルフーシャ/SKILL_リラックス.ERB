;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_リラックス,ARG, ARG:1, ARG:2
CALL PRINT_リラックス_ANIME, NO:ARG, , 100, -500
CALL HEAL_リラックス, ARG, "전투중"
CALL PU_SKILLGAGE_F_ADD, ARG, "リラックス", 1

@HEAL_リラックス, ARG, ARGS
#DIM DYNAMIC LCOUNT
;死亡以外の状態異常も回復する
CALL CURE_STATE_SINGLE, ARG, ARG, PU_SKILLNUM_GET(ARG, "リラックス"), 0, 1
CALL PRINT_HIT_MESSAGE, ARG, @"MP{MAXBASE:ARG:ＭＰ / 3}회복", "L"
CALL VAR_MP, ARG, MAXBASE:ARG:ＭＰ / 3, "회복"
IF ARGS == "전투중"
	CALL PRINT_HIT_MESSAGE, ARG, @"能力を初期化", "L"
	;自身の補助効果を全て消す
	FOR LCOUNT,0, VARSIZE("BASE_KAJA_TABLE")
		CFLAG:ARG:(BASE_KAJA_TABLE:LCOUNT + "강화") = 0
	NEXT
ENDIF
WAIT

;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_リラックス,ARG,ARG:1,SKILL_NUM
