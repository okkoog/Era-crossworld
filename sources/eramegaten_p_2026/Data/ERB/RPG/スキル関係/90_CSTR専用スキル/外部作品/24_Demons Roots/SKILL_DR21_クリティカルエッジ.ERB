;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_クリティカルエッジ, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;乗除の計算後に加算する。上記2つの乗算系は基礎クリティカル率が低いスキルには効果が薄いが、こちらは基礎が低いスキルに強力に働く
		;基礎クリティカル率が低い技しか持たないキャラの補正用と考えるのならばこれで補正するのがおすすめ
		CASE "クリティカル加算"
			IF L_攻撃タイプ == "物理"
				;通常攻撃に限り２５
				SIF CFLAG:L_P:입력행동 == 0
					RETURN 25
				;他１０
				RETURN 10
			ENDIF
	ENDSELECT
;自分が防御側
ELSE
ENDIF
RETURN 0
