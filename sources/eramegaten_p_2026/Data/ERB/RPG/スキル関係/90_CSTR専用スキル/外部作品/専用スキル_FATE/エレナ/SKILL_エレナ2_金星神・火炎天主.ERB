;　威力
@SKILL_POWER_金星神・火炎天主,ARG
#DIM SKILL_NUM
#DIM L_DMG = 375
SIF ARG < 0
	RETURN L_DMG
SKILL_NUM = PU_SKILLNUM_GET(ARG,"金星神・火炎天主")
;総威力は225,340,375、強化イベント経由時は300,420,450
SELECTCASE SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"))
	CASE IS > 3
		L_DMG = GETBIT(GET_RPG_CFLAG_TAKEOVER(ARG,"鯖強化フラグ"),0) ? 450 # 375
	CASE IS > 1
		L_DMG = GETBIT(GET_RPG_CFLAG_TAKEOVER(ARG,"鯖強化フラグ"),0) ? 420 # 340
	CASEELSE
		L_DMG = GETBIT(GET_RPG_CFLAG_TAKEOVER(ARG,"鯖強化フラグ"),0) ? 300 # 225
ENDSELECT

;何ヒット目かに応じて補正を掛ける（ヒット数を管理するHゲージが想定外の値だった場合、100を返す）
L_DMG = INRANGE(SKILLGAGE_H_GET(ARG,SKILL_NUM),0,3) ? L_DMG * AUTO_SPLIT_INT("100_20_30_50","_",SKILLGAGE_H_GET(ARG,SKILL_NUM)) / 100 # L_DMG

RETURN L_DMG

