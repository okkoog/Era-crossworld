;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_金星神・火炎天主,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM NP_TIME
#DIM RAKU_HOLD,16
#DIM LCOUNT,3
#DIMS L_STR
SKILL_NUM = PU_SKILLNUM_GET(ARG,"金星神・火炎天主")
NP_TIME = SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"))
VARSET RAKU_HOLD,0
VARSET LCOUNT,0

FOR LCOUNT:2,0,2
	;強化フラグ立ってたらラク・カジャ効果を一時的に入れ替えたりする処理を挟む
	IF GETBIT(GET_RPG_CFLAG_TAKEOVER(ARG,"鯖強化フラグ"),0)
		FOR LCOUNT,CFLAG:ARG:PT플래그 == 0 ? 1 # 7,CFLAG:ARG:PT플래그 == 0 ? 7 # 17
			SIF (LCOUNT:2 == 0 ? CFLAG:POS(LCOUNT):방어강화 # RAKU_HOLD:LCOUNT) > 0
				SWAP CFLAG:POS(LCOUNT):방어강화,RAKU_HOLD:LCOUNT
		NEXT
	ENDIF
	SIF LCOUNT:2 == 1
		BREAK
	FOR LCOUNT:1,1,4
		CALL SKILLGAGE_H_ADD(ARG,SKILL_NUM,1)
		CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM
	NEXT
NEXT
PRINTL
;攻撃後のデバフ付与部分。ノウブル・ファンタズム終了までのターン数が多いほど効果が強化される
;SKILL_SET_カジャンダは種別に応じて効果値を変更できるような処理はないので三つに分けて呼ぶ
FOR LCOUNT,0,3
	L_STR = %AUTO_SPLIT("4,4,8,8,12,12/-1,-1,-2,-2,-4,-4/2,2,3,3,4,4","/",LCOUNT)%
	CALL SKILL_SET_カジャンダ,ARG,ARG:1,AUTO_SPLIT("防御_魔法効果/BS付着率/クリティカル","/",LCOUNT),-AUTO_SPLIT_INT(L_STR,",",NP_TIME),"範囲",\@LCOUNT != 2 ? NOWAIT # \@
	PRINTL
NEXT
CALL SKILLGAGE_H_SET(ARG,SKILL_NUM,0)
CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"),0

