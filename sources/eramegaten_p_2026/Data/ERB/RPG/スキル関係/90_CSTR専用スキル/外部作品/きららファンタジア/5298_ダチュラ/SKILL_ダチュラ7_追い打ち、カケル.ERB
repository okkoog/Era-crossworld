;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_追い打ち、カケル,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
TFLAG:스킬용1 = 0
SIF CFLAG:POS(ARG:1):상태이상 != GET_STATE_NUM("GOOD")
	TFLAG:스킬용1 = 1
CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM
TFLAG:스킬용1 = 0
