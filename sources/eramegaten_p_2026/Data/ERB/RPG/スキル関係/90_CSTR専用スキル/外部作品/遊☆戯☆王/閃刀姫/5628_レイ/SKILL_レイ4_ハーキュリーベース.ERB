
;スキル名
@SKILL_NAME_ハーキュリーベース,ARG
RESULTS = 허큘리베이스

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ハーキュリーベース, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_ハーキュリーベース,ARG
RETURN 15

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ハーキュリーベース
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　対象が1敵か2味方か3場全体か4特殊か5自身
@SKILL_TARGET_ハーキュリーベース, ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_ハーキュリーベース, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;계승타입
@SKILL_SUCCESSION_TYPE_ハーキュリーベース
RETURN GET_SUCCESSION_NUM("지원")

;속도보정
@SKILL_SPEED_ハーキュリーベース, ARG = -1
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_ハーキュリーベース, ARG = -1
RETURN 7

;即時発動
@SKILL_QUICK_ACTION_ハーキュリーベース, ARG
SIF ARG >= 0 && GET_COUNT_閃刀カウンター(ARG) >= 3
	RETURN 1
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ハーキュリーベース, ARG, ARG:1, ARG:2
CALL PRINT_HIT_MESSAGE, ARG, "物理攻撃のダメージが増加！", "W"
CALL SET_RPG_CFLAG_BTL, ARG, "ハーキュリーベース", FLAG:경과턴수 + 4
;正規のチャージを通過しないのでここで削る
SIF GET_COUNT_閃刀カウンター(ARG) >= 3
	CALL SET_RPG_CFLAG_BTL, ARG, "閃刀カウンター", -3, "+="
CALL PUSH_CEMETERY_閃刀魔法, ARG, "ハーキュリーベース"

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_ハーキュリーベース, ARG
PRINTL 【閃刀魔法】
PRINTL 4턴 동안 자신과 링크체의 물리 공격으로 인한 데미지가 50% 증가한다.
PRINTL 스킬 발동 후 섬도 카운터를 1개 얻는다.
PRINTL
PRINTL 〈강화 효과〉 섬도 카운터가 3개 이상 있을 경우 턴을 소모하지 않고 즉시 발동한다.
PRINTL 강화 효과 발동 후 섬도 카운터를 얻는 대신 3개 제거한다.
PRINTL
PRINTL 이 스킬은 전투 중 1회만 사용 가능.

@SKILL_EXPLAIN_TOOLTIP_ハーキュリーベース, ARG
RESULTS = 4턴 동안 자신과 자신의 링크체의 물리 공격으로 인한 데미지가 50% 증가한다.
RESULTS:1 = 사용 후 섬도 카운터를 1개 얻는다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ハーキュリーベース,ARG
#DIM DYNAMIC LCOUNT
RESULTS = 스킬 사용 완료
SIF !IS_USEABLE_閃刀魔法(ARG, "ハーキュリーベース")
	RETURN 0
RETURN 1

@リンク不能_ハーキュリーベース
RETURN 1

@SKILL_TAG_ハーキュリーベース
RESULTS = 閃刀魔法