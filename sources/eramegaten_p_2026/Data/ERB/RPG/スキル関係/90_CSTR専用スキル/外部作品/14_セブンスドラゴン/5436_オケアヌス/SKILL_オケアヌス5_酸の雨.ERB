@SKILL_TRIGGER_ACTIONABLE_酸の雨,ARG,ARG:1
;自分じゃなければNG
SIF FLAG:행동순1 != ARG
	RETURN 0
SIF !IS_PU_SKILL_入力行動(ARG, "酸の雨")
	RETURN 0
SIF !IS_BADSTATE(ARG:1, "POISON")
	RETURN 0
SIF !GET_CREC_ACT(ARG, ARG:1, "HIT")
	RETURN 0
RETURN 1, CPOS(ARG:1)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_酸の雨, ARG, ARG:1, ARG:2
IF FLAG:총공격중
	TFLAG:반사0데미지화 = 1
	CALL ATTACK_SKILL,ARG,ARG:1,ARG:2
	TFLAG:반사0데미지화 = 0
ELSE
	CALL ATTACK_SKILL,ARG,ARG:1,ARG:2
ENDIF

