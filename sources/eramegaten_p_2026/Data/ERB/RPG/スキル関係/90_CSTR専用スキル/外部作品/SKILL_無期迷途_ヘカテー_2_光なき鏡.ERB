;スキル名
@SKILL_NAME_光なき鏡,ARG
RESULTS = 빛 없는 거울

;　명중
@SKILL_HITRATE_光なき鏡, ARG
RETURN 100

;　威力(通常攻撃を100%とした倍率となる)
@SKILL_POWER_光なき鏡, ARG
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "寂滅の水影")
	RETURN 75
ELSE
	RETURN 50
ENDIF

;基礎クリティカル率(標準は5。乗算されるので10になると200%になる)
@SKILL_CRITICAL_RATE_光なき鏡, ARG
RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_光なき鏡,ARG
RETURN 8

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_光なき鏡,ARG
RETURN 8

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_光なき鏡, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_光なき鏡,ARG
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "寂滅の水影")
	RETURN 50
ELSE
	RETURN 20
ENDIF

;　相性
@SKILL_TYPE_光なき鏡,ARG
RETURN GET_TYPE_NUM("정신")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_光なき鏡
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_光なき鏡, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_光なき鏡, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;スキルがランダム範囲かどうか
@SKILL_RAND_TARGET_光なき鏡,ARG
RETURN 1

;　사거리(1 = 後列発動不可・後列指定不可 2 = 後列発動可能・後列指定不可 3 = 後列発動可能・後列指定可能 4 = 後列発動不可・後列指定可能)
@SKILL_RANGE_光なき鏡,ARG
RETURN 3

;　範囲　単体　一列　全体　敵味方全体　縦列
@SKILL_SPHERE_光なき鏡,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_光なき鏡, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_光なき鏡
RETURN GET_SUCCESSION_NUM("정신")

;속도보정
@SKILL_SPEED_光なき鏡, ARG = -1
RETURN 0

;スキルランク
;スキルの習得時の必要ＭＡＧの算出に主に用いられる
;また、習得・所持スキルはこのランクの5倍のレベルを基準として設定する。
@SKILL_RANK_光なき鏡, ARG = -1
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "寂滅の水影")
	RETURN 15
ELSE
	RETURN 8
ENDIF

;====================================================
;スキル及び行動の実行
;ARG = スキルの使用者
;ARG:1 = スキルの使用対象
;ARG:2 = スキルの番号
;====================================================
@ACTION_光なき鏡, ARG, ARG:1, ARG:2
CALL ATTACK_SKILL,ARG,ARG:1,ARG:2

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_光なき鏡, ARG
PRINTL 적 전체 무작위에게 정신 상성의 소데미지를 8회 준다.
;ツールチップ版の解説文
@SKILL_EXPLAIN_TOOLTIP_光なき鏡, ARG
RESULTS:0 = 적 전체 무작위에게 정신 상성의 소데미지를 8회 준다.

;使用条件
;真の時、使用可能となる。というより特定条件で使用不能にしたい場合は0をいれてかえさせる。
;RESULTSに文字をいれてもどすことで使えない場合の理由がポップアップするようになる。
@SKILL_SPECIAL_ACTIONABLE_光なき鏡,ARG
RETURN 1
;とくにない