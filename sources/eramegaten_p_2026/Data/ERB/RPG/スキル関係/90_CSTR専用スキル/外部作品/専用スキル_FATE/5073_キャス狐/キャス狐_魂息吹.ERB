;通常攻撃
;スキルのテンプレートになっています

; スキル名
@SKILL_NAME_魂息吹, ARG
RESULTS = 魂息吹

; 1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_魂息吹
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

; 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_魂息吹,ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

; 계승타입
@SKILL_SUCCESSION_TYPE_魂息吹
RETURN GET_SUCCESSION_NUM("자동효과")

; スキル変化？用ランク
@SKILL_RANK_魂息吹, ARG = -1
RETURN 10

; 説明文の表示
@SKILL_EXPLAIN_魂息吹,ARG
PRINTL 자동: 전투 종료 시 액티브 상태일 경우 자신의 MP를 10% 회복시킨다.

@SKILL_ACTIONABLE_BATTLE_魂息吹, ARG
RETURN 0

@SKILL_BATTLE_END_魂息吹, ARG
SIF !FLAG:승리플래그
	RETURN 0
SIF IS_BADSTATE(ARG, "DYING")
	RETURN 0
CALL VAR_MP, ARG, MAX(MAXBASE:ARG:ＭＰ * 10 / 100, 1), "회복"

$FUNCTION_END_魂息吹
RETURN 0
