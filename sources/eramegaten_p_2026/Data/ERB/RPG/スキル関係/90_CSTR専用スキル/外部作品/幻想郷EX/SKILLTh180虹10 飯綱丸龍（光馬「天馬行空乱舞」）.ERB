@ACTION_光馬「天馬行空乱舞」,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
FLAG:확산플래그 = 0

SIF CFLAG:ARG:명중강화 > 15
	FLAG:확산플래그 = 1

CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)

FLAG:확산플래그 = 0

SIF CFLAG:ARG:명중강화 > 15
	CFLAG:ARG:명중강화 = CFLAG:ARG:명중강화 - 4


