@SKILL_POWER_も、申し訳ございません！, ARG
SIF ARG < 0
	RETURN 20
CALL GET_SKILL_POWER_も、申し訳ございません！(GET_ROLE_CFLAG_TAKEOVER(ARG, "特殊スキルランク"))
RETURN RESULT

@GET_SKILL_POWER_も、申し訳ございません！, ARG
SELECTCASE ARG
	CASE 15
		RETURN 70
	CASE 11 TO 14
		RETURN 60 + (ARG - 10) * 2
	CASE 10
		RETURN 60
	CASE 2 TO 9
		RETURN 16 + 4 * ARG
	CASE 0, 1
		RETURN 20
	CASEELSE
		RETURN 0
ENDSELECT

