;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_E_魔軍爪, ARG
RESULTS = 魔軍爪

;　명중
@SKILL_HITRATE_KE_E_魔軍爪, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_E_魔軍爪, ARG
RETURN 140

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_E_魔軍爪, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_E_魔軍爪, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_E_魔軍爪, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_KE_E_魔軍爪, ARG
RETURN 18

;　相性
@SKILL_TYPE_KE_E_魔軍爪, ARG
RETURN GET_TYPE_NUM("전술")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_E_魔軍爪
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_E_魔軍爪, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_E_魔軍爪, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_KE_E_魔軍爪, ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_E_魔軍爪, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_E_魔軍爪, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_KE_E_魔軍爪, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_E_魔軍爪
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_KE_E_魔軍爪, ARG
RETURN GET_STATE_NUM("POISON")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_KE_E_魔軍爪, ARG
RETURN 8

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_KE_E_魔軍爪, ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_KE_E_魔軍爪, ARG
RETURN 60

