;一列ランダム5ヒットの火炎ダメージ。2ヒット目からは威力が低い秀才タイプの誘導弾。単体280相当。

;スキル名
@SKILL_NAME_魔女の火球,ARG
RESULTS = 마녀의 화구

;　명중
@SKILL_HITRATE_魔女の火球, ARG
SIF FLAG:공격횟수 == 0
	RETURN 120
RETURN 90

;　威力
@SKILL_POWER_魔女の火球, ARG
SIF FLAG:공격횟수 == 0
	RETURN 150
RETURN 50

;　최저공격횟수
@SKILL_MINATTACKNUMBER_魔女の火球,ARG
RETURN 5

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_魔女の火球,ARG
RETURN 5

;一体辺りの最大ＨＩＴ数
;※ランダム攻撃系に使う
@SKILL_MAXATK_PER_魔女の火球,ARG
RETURN 5

;一体辺りの最低ＨＩＴ数
;※ランダム攻撃系に使う
@SKILL_MINATK_PER_魔女の火球,ARG
RETURN 5

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_魔女の火球, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_魔女の火球,ARG
RETURN 12

;　相性
@SKILL_TYPE_魔女の火球,ARG
RETURN GET_TYPE_NUM("화염")

@SKILL_SUCCESSION_TYPE_魔女の火球
RETURN GET_SUCCESSION_NUM("화염")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_魔女の火球, ARG
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_魔女の火球,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_魔女の火球,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_魔女の火球,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_魔女の火球,ARG
RETURN GET_SPHERE_NUM("일렬")

;スキルがランダム範囲かどうか
@SKILL_RAND_TARGET_魔女の火球,ARG
RETURN 1

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_魔女の火球,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_魔女の火球, ARG = -1
RETURN 0

@SKILL_RANK_魔女の火玉, ARG = -1
RETURN 6

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_魔女の火球,ARG,ARG:1,ARG:2
CALL ATTACK_SKILL,ARG,ARG:1,ARG:2

;　説明文の表示
@SKILL_EXPLAIN_魔女の火球,ARG
PRINTL 화구를 다수 발생시켜 전방으로 쏜다.
PRINTL 불은 인류 역사의 근원을 이루는 것이며, 이를 마법으로 만들어내는 술법은 마녀의 기본 기술이다.
PRINTL 직선으로 1발, 우회시켜 4발 쏘아내므로 모든 것을 피하기는 어렵다.
PRINTL 
PRINTL 적 1열에 랜덤하게 5회 화염 속성으로 데미지를 가한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_魔女の火球,ARG
RETURN 1

