;====================================================
;トリガー発動条件
;====================================================
@SKILL_TRIGGER_ACTIONABLE_魔眼,ARG,ARG:1
;魔眼起動中でないとダメ
SIF SKILLGAGE_H_GET(ARG,PU_SKILLNUM_GET(ARG,"魔眼")) < 1
	RETURN 0
;魔眼を起動した後の自分の行動でないとダメ
SIF ARG != ARG:1
	RETURN 0
;攻撃者が自分じゃなければNG
SIF FLAG:행동순1 != ARG
	RETURN 0
;一度のみの判定にする
SIF ARG != ARG:1
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
SIF RESULT != 1 || CFLAG:ARG:타겟 < 1
	RETURN 0
IF CFLAG:ARG:타겟 < 17
	SIF POS(CFLAG:ARG:타겟) < 0 || GET_STATE(CFLAG:POS(CFLAG:ARG:타겟):상태이상) == "DYING"
		RETURN 0
	CALL SKILLGAGE_F_SET,ARG,PU_SKILLNUM_GET(ARG,"魔眼"),2
	RESULT:1 = CFLAG:ARG:타겟
ELSEIF CFLAG:ARG:타겟 < 20
	CALL SKILLGAGE_F_SET,ARG,PU_SKILLNUM_GET(ARG,"魔眼"),3
	RESULT:1 = 19
ELSE
	CALL SKILLGAGE_F_SET,ARG,PU_SKILLNUM_GET(ARG,"魔眼"),3
	RESULT:1 = 22
ENDIF
RETURN 1

