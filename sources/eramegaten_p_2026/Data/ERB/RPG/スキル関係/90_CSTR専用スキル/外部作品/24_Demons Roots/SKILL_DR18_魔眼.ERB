;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_魔眼,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
;トリガー追撃中は攻撃するだけ
IF SKILLGAGE_H_GET(ARG,PU_SKILLNUM_GET(ARG,"魔眼")) == 0
	CALL SKILLGAGE_H_SET,ARG,PU_SKILLNUM_GET(ARG,"魔眼"),1
	PRINTL 『메비우스의 마안』 기동!
ELSE
	IF FLAG:총공격중 == 1
		;単体攻撃
		IF ARG:1 < 17
			CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
		ELSE
			CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
		ENDIF
		CALL SKILLGAGE_F_SET,ARG,PU_SKILLNUM_GET(ARG,"魔眼"),0
	ELSE
		CALL SKILLGAGE_H_SET,ARG,PU_SKILLNUM_GET(ARG,"魔眼"),0
		PRINTL 『메비우스의 마안』 해제.
	ENDIF
ENDIF

