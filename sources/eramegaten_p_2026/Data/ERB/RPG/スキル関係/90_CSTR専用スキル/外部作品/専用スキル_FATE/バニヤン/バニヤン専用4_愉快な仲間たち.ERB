;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_愉快な仲間たち,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"愉快な仲間たち")

CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격", 4, "範囲","NOWAIT"
	;追加効果発動不可のターンが残っているなら発動しない
	SIF SKILLGAGE_D_GET(ARG,SKILL_NUM) > 0
		RETURN 0
	CALL SET_C_BTL_EFFECT_FIELD, ARG, ARG:1, "愉快な仲間たち",3,"クリティカルダメージが上がった！"
;追加効果が発動できる状態なら発動不可状態にする
IF SKILLGAGE_D_GET(ARG,SKILL_NUM) == 0
	CALL SKILLGAGE_D_SET(ARG,SKILL_NUM,5)
ENDIF

