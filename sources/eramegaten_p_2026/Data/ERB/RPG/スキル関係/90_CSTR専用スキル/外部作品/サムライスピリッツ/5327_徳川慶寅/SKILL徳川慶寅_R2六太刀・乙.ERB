;通常攻撃
;スキルのテンプレートになっています
@SKILL_STRGET_六太刀・乙, ARG
#FUNCTIONS
#DIM SKILL_NUM
SKILL_NUM = CHARANUM_CHECK(ARG) ? PU_SKILLNUM_GET(ARG,"六太刀・乙") # 0
LOCAL = SKILL_NUM < 1 ? 0 # SKILLGAGE_H_GET(ARG,SKILL_NUM)
SELECTCASE LOCAL
CASE 1
	RETURNF "壱の太刀・撫子"
CASE 2
	RETURNF "弐の太刀・白百合"
CASE 3
	RETURNF "参の太刀・牡丹"
CASE 4
	RETURNF "四の太刀・椿"
CASE 0,5
	RETURNF "五の太刀・朝顔"
CASE 6
	RETURNF "六の太刀・夕顔"
ENDSELECT
RETURNF "壱の太刀・撫子"


