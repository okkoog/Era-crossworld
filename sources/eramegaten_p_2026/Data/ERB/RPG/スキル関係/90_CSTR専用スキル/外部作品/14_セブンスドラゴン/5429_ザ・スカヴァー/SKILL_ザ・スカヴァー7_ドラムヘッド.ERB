SIF !PU_SKILLGAGE_H_GET(ARG, "ドラムヘッド")
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG,  , , "ドラムヘッド", "岩石が降り注ぐ！"
TFLAG:반사0데미지화 = 1
CALL ATTACK_SKILL, ARG, CFLAG:ARG:PT플래그 ? 22 # 19, PU_SKILLNUM_GET(ARG, "ドラムヘッド")
TFLAG:반사0데미지화 = 0

