
;スキル名
@SKILL_NAME_究極の戦略,ARG
RESULTS = 궁극의 전략

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_究極の戦略, ARG
SIF GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 5
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_究極の戦略,ARG
IF ARG >= 0 && GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 5
	RESULTS = %"ＣＨ:5"%
	RETURN 0
ENDIF
RETURN 15

;　相性
@SKILL_TYPE_究極の戦略,ARG
RETURN GET_TYPE_NUM("없음")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_究極の戦略
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_究極の戦略,ARG
RETURN 2

;　사거리
@SKILL_RANGE_究極の戦略,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_究極の戦略,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_究極の戦略,ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

@SKILL_SUCCESSION_TYPE_究極の戦略,ARG
RETURN GET_SUCCESSION_NUM("지원")

@SKILL_RANK_究極の戦略, ARG = -1
RETURN 1

;속도보정
@SKILL_SPEED_究極の戦略, ARG = -1
RETURN 999

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_究極の戦略
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_究極の戦略,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL SET_RPG_CFLAG_BTL, ARG, "KFチャージスキル", 5, "-="
CALL SET_C_BTL_EFFECT_FIELD, ARG, ARG:1, "究極の戦略"

;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_究極の戦略,ARG
PRINTL 아군 전체에게 1턴 동안 가하는 데미지를 30\% 증가시키는 효과를 부여한다.
PRINTL 추가로 【리얼리스트】에 소속된 캐릭터는 소비 MP 반감 효과를 얻는다.
PRINTL 사용 시 차지 5 소비.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_究極の戦略, ARG
RESULTS = 차지 부족
SIF GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 5
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_究極の戦略, ARG
RESULTS:0 = 아군 전체에게 1턴 동안 가하는 데미지를 30\% 증가시키는 효과를 부여한다.
RESULTS:1 = 추가로 상성 그룹 【리얼리스트】에 소속된 캐릭터는 소비 MP 반감 효과를 얻는다.
RESULTS:2 = 使用時にチャージを5消費。

@SKILL_TAG_究極の戦略
RESULTS = KF 차지 스킬
