;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_殺意のリアルブート,ARG,ARG:1,ARG:2
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1)
	L_CHARA = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_CHARA)
		CONTINUE
	TSTR:스킬메시지추가효과 '= ""
	CALL SKILL_SET_カジャンダ, ARG, L_CHARA, "공격", 8, "短縮"
	CALL SKILL_SET_カジャンダ, ARG, L_CHARA, "방어", -8, "短縮"
	CALL PRINT_HIT_MESSAGE, L_CHARA, TSTR:스킬메시지추가효과, "L"
NEXT
WAIT


