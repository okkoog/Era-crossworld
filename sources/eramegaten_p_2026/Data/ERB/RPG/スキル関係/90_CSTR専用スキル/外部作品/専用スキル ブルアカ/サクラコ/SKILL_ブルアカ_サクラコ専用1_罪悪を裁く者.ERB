;スキル名
@SKILL_NAME_罪悪を裁く者,ARG
RESULTS = 죄악을 심판하는 자

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_罪悪を裁く者, ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

;계승타입
@SKILL_SUCCESSION_TYPE_罪悪を裁く者
RETURN GET_SUCCESSION_NUM("자동효과")

;スキルランク
;スキルの習得時の必要ＭＡＧの算出に主に用いられる
;また、習得・所持スキルはこのランクの5倍のレベルを基準として設定する。
@SKILL_RANK_罪悪を裁く者, ARG = -1
RETURN 4

;=========================================
;カジャンダ(戦闘能力強化セット)스킬
;ARG:0		使用者
;ARG:1		対象(単体・短縮指定の場合はキャラ番号・範囲の場合はポジション指定)
;ARGS 		効果; 文字列で指定。右の項目のうち、必要なものだけ入れて使う("攻撃_命中_防御_回避_魔法威力_魔法効果_クリティカル_BS付着率")
;ARG:2 		効果量。増減対応。1ランクが±4、2ランクが±8
;ARGS:1		範囲・メッセージ方式指定(単体・範囲はそのまま、短縮は攻撃スキルの追加効果用でダメージ & ↓공격　のようにでる)
;ARGS:2		NOWAIT:WAITで止まらない(短縮では無関係) NOMES:メッセージ表示なし
;ARGS:3		代替メッセージ
;ARG:3		上限
;AEG:4		下限
;凡例
;CALL SKILL_SET_カジャンダ, ARG, ARG:1, "攻撃_命中", -4, "短縮";ARG:1のキャラ番号の敵に攻撃と命中を1ランクさげる(-4)
;=========================================
;入場時に行う効果
@SKILL_BATTLE_ENTER_罪悪を裁く者, ARG
#DIM LCOUNT
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;入場一回目のみ発動
SIF CFLAG:ARG:입장플래그 != 1
	RETURN 0
;自身の入場のみで発動
SIF TFLAG:입장캐릭터 >= 0 && TFLAG:입장캐릭터 != ARG
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 4, "단체", "NOWAIT", "攻撃力が大幅に上がった！"

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_罪悪を裁く者, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			CALL BTL_CALC_AISYOU, -1, L_TARGET, -1, GET_TYPE_NUM("파마"), 1
			IF CHECK_WEAKNESS(RESULT) >= 1
				RESULTS = 죄악을 심판하는 자
				RETURN 10
			ENDIF
	ENDSELECT
;自分が防御側
ELSE
ENDIF
;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_罪悪を裁く者, ARG
PRINTL 자동: 전투 개시 시 자신의 공격력을 상승시킨다.
PRINTL 　　 파마 상성이 약점인 적에게 가하는 데미지가 10% 증가한다.

;ツールチップ版の解説文
@SKILL_EXPLAIN_TOOLTIP_罪悪を裁く者, ARG
RESULTS:0 = 자동: 전투 개시 시 자신의 공격력을 상승시킨다.
RESULTS:1 = 　　 파마 상성이 약점인 적에게 가하는 데미지가 10% 증가한다.
