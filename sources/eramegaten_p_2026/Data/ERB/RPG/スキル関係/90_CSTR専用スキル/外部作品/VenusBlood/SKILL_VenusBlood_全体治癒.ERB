; 説明文の表示
@SKILL_EXPLAIN_全体治癒, ARG
PRINTL 자동: 전투 승리 시 전투 참가 중일 경우, 참가 중인 아군의 HP를 25% 회복시킨다.

@SKILL_ACTIONABLE_BATTLE_全体治癒, ARG
RETURN 0

@SKILL_BATTLE_END_全体治癒, ARG
#DIM DYNAMIC LCOUNT
SIF IS_BADSTATE(ARG, "DYING")
	RETURN 0
FOR LCOUNT, 1, 7
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	CALL VAR_HP, POS(LCOUNT), MAX(MAXBASE:POS(LCOUNT):ＨＰ / 4, 1), "회복"
NEXT

