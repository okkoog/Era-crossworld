;追突剣　命中80　威力180　攻撃回数1-1　消費18　검격　対象の命中回避を1段階下げる
;	原作だとスタン(eraten的にはSHOCK？)もついてるが強すぎると思われるので無し
;参考：牙折り　命中90　威力240　攻撃回数1-1　消費10　전술　対象の攻撃力を1段階下げる

;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_追突剣,ARG
RESULTS = 追突剣

;　명중
@SKILL_HITRATE_追突剣, ARG
RETURN 80

;　威力
@SKILL_POWER_追突剣, ARG
RETURN 180

;　최저공격횟수
@SKILL_MINATTACKNUMBER_追突剣,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_追突剣,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_追突剣, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_追突剣,ARG
RETURN 15

;　相性
@SKILL_TYPE_追突剣,ARG
RETURN GET_TYPE_NUM("검격")
;검격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_追突剣
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　攻撃タイプ
@SKILL_ATTACKTYPE_追突剣,ARG
RETURN GET_攻撃タイプ_NUM("物理")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_追突剣, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_追突剣,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_追突剣,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_追突剣,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_追突剣, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_追突剣
RETURN GET_SUCCESSION_NUM("검격")
;검격

;スキル変化？用ランク
@SKILL_RANK_追突剣, ARG = -1
RETURN 4

;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_追突剣, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "命中_回避", -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_追突剣,ARG,ARG:1,ARG:2
CALL ATTACK_SINGLE, ARG, POS(ARG:1),ARG:2

;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_追突剣,ARG
PRINTL 몸째로 들이받는 기세의 일격, 대상의 명중·회피를 낮춘다

;使用条件
@SKILL_SPECIAL_ACTIONABLE_追突剣,ARG
RETURN 1
;とくにない
