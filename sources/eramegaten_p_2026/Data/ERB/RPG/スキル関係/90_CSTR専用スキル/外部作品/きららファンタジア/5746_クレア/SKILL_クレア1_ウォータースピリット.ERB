
;スキル名
@SKILL_NAME_ウォータースピリット,ARG
RESULTS = 워터 스피릿

;　명중
@SKILL_HITRATE_ウォータースピリット, ARG
RETURN 100

;　威力
@SKILL_POWER_ウォータースピリット, ARG
RETURN 120

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ウォータースピリット,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ウォータースピリット,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ウォータースピリット, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ウォータースピリット,ARG
RETURN 8

;　相性
@SKILL_TYPE_ウォータースピリット,ARG
RETURN GET_TYPE_NUM("수격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ウォータースピリット
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ウォータースピリット,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ウォータースピリット,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ウォータースピリット,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ウォータースピリット,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ウォータースピリット,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ウォータースピリット
RETURN 0

@SKILL_RANK_ウォータースピリット, ARG = -1
RETURN 3

;====================================================
;トリガー発動条件
;====================================================
@SKILL_TRIGGER_ACTIONABLE_ウォータースピリット,ARG,ARG:1
SIF ARG != FLAG:행동순1
	RETURN 0
SIF !IS_PU_SKILL_入力行動(ARG, "ウォータースピリット")
	RETURN 0
SIF !GET_CREC_ACT(ARG, ARG:1, "HIT")
	RETURN 0
RETURN 1, CPOS(ARG)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ウォータースピリット,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
IF FLAG:총공격중 == 0
	CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM
ELSE
	CALL SKILL_SET_カジャンダ, ARG, ARG, "마법효과", 4, "단체"
ENDIF

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_ウォータースピリット,ARG
PRINTL 적 1체에 수격 상성의 소데미지를 준다.
PRINTL 공격에 성공했을 때 이하의 연동 효과가 발동한다.
PRINTL 「자신의 마법 효과가 상승한다.」

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ウォータースピリット,ARG
RETURN 1
