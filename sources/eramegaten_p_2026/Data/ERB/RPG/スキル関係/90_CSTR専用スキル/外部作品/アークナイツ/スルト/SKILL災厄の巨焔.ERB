;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_災厄の巨焔,ARG,ARG:1,SKILL_NUM
#LOCALSSIZE 1
#DIM SKILL_NUM, 2
SKILL_NUM = PU_SKILLNUM_GET(ARG,"災厄の巨焔")
IF SKILLGAGE_F_GET(ARG,SKILL_NUM) < 0
	SKILL_NUM:1 = SKILLGAGE_H_GET(ARG, SKILL_NUM)
	CALLF AUTO_PU_SKILL_災厄の巨焔(ARG,"気合集中フラグ返却")
	CALL SKILL_ACTION, SKILL_NUM:1, ARG, ARG:1
	CALL GET_SKILL_PROP, "SKILL_DAMAGETYPE", SKILL_NUM:1, ARG
	IF RESULT == 1
		CFLAG:ARG:気合フラグ = 0
		CFLAG:ARG:타인기합플래그 = 0
	ELSEIF RESULT == 2
		CFLAG:ARG:집중플래그 = 0
		CFLAG:ARG:타인집중플래그 = 0
	ENDIF
ELSE
	;メモ１：正の値のFゲージはSPとして扱い、負の値は効果時間として扱う
	;メモ２：これに伴い、DゲージとかHゲージとか使わなくなった
	;CSTR:ARG:103の値に応じて維持時間を指定
	CALL SKILLGAGE_F_SET,ARG,SKILL_NUM,-TOINT(AUTO_SPLIT("15_16_17_18","_",TOINT(CSTR:ARG:103)-1))
	PRINTFORMW %CALLNAME:ARG%의 레바테인이 황혼의 불꽃을 두르기 시작했다!
ENDIF

