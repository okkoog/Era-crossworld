;スキル名
@SKILL_NAME_精神干渉無効化,ARG
RESULTS = 精神干渉無効化

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_精神干渉無効化,ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_精神干渉無効化
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_精神干渉無効化,ARG,ARG:1,ARG:2
RETURN 0

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_精神干渉無効化, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		CASE "バステ補正"
			SIF L_相性名 == "정신"
				RETURN -999
	ENDSELECT
;自分が防御側
ELSE
	SELECTCASE ARGS
	ENDSELECT
ENDIF
RETURN 0
;　説明文の表示
@SKILL_EXPLAIN_精神干渉無効化,ARG
PRINTL 혼란 커터에 의해 정신 간섭 능력이 무효화된 상태.
PRINTL 정신 속성의 배드 스테이터스 부여율이 대폭 저하된다.

;使用条件
;使用不能
@SKILL_SPECIAL_ACTIONABLE_精神干渉無効化,ARG
RETURN 0

