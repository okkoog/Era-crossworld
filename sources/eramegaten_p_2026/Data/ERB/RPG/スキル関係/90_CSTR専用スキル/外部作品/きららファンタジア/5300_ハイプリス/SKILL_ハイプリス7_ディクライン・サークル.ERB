
;スキル名
@SKILL_NAME_ディクライン・サークル,ARG
RESULTS = 디클라인 서클

;　명중
@SKILL_HITRATE_ディクライン・サークル, ARG
RETURN 100

;　威力
@SKILL_POWER_ディクライン・サークル, ARG
RETURN 100

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ディクライン・サークル,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ディクライン・サークル,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ディクライン・サークル, ARG
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_ディクライン・サークル,ARG
RETURN 40

;　相性
@SKILL_TYPE_ディクライン・サークル,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ディクライン・サークル
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ディクライン・サークル,ARG
RETURN 0

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ディクライン・サークル,ARG
RETURN 4

;　사거리
@SKILL_RANGE_ディクライン・サークル,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ディクライン・サークル,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_ディクライン・サークル,ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

@SKILL_RANK_ディクライン・サークル, ARG = -1
RETURN 8

;속도보정
@SKILL_SPEED_ディクライン・サークル, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ディクライン・サークル
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ディクライン・サークル,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
PRINTFORML %CALLNAME:ARG%(은)는 약체화 서클을 만들어냈다.
CALL SKILLGAGE_D_SET, ARG, SKILL_NUM ,7

;====================================================
;実行内容ここまで
;====================================================

;ターン終了時処理
@SKILL_TURNEND_ディクライン・サークル,ARG,ARG:1
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "ディクライン・サークル")
SIF SKILLGAGE_D_GET(ARG, SKILL_NUM) == 0
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG, SKILL_NUM
CALL SKILL_SET_カジャンダ, ARG, CFLAG:ARG:PT플래그 ? 22 # 19, AUTO_SPLIT("攻撃_魔法効果_魔法威力_防御_命中回避", "_", RAND:5), -4, "範囲"

;　説明文の表示
@SKILL_EXPLAIN_ディクライン・サークル,ARG
PRINTL 적의 약체화 서클을 전개한다.
PRINTL 매 턴 종료 시 무작위 적의 능력치를 1단계 낮춘다.
PRINTL 효과는 7턴 지속되며, 효과 도중에는 재사용 불가.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ディクライン・サークル,ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "ディクライン・サークル")
RESULTS = 発動中
SIF SKILLGAGE_D_GET(ARG, SKILL_NUM)
	RETURN 0
RETURN 1
