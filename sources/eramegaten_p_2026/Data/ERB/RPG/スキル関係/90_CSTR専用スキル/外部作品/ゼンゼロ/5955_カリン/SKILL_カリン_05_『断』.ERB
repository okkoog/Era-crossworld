;スキル名
@SKILL_NAME_『断』,ARG
RESULTS = 『断』

;　명중
@SKILL_HITRATE_『断』, ARG
RETURN 70

;　威力
@SKILL_POWER_『断』, ARG
SIF ARG < 0
	RETURN 25
CALL GET_SKILL_POWER_『断』(GET_ROLE_CFLAG_TAKEOVER(ARG, "回避スキルランク"))
RETURN RESULT

@GET_SKILL_POWER_『断』, ARG
SELECTCASE ARG
	CASE 15
		RETURN 95
	CASE 11 TO 14
		RETURN 80 + (ARG - 10) * 3
	CASE 10
		RETURN 80
	CASE 2 TO 9
		RETURN 20 + 6 * ARG
	CASE 0, 1
		RETURN 25
	CASEELSE
		RETURN 0
ENDSELECT
;;クリティカル率
@SKILL_CRITICAL_RATE_『断』, ARG
RETURN 10

;　최저공격횟수
@SKILL_MINATTACKNUMBER_『断』,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_『断』,ARG
RETURN 5

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_『断』, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_『断』,ARG
SIF ARG < 0
	RETURN 3
CALL GET_SKILL_COST_『断』(GET_ROLE_CFLAG_TAKEOVER(ARG, "回避スキルランク"))
RETURN RESULT

;　コストの量
@GET_SKILL_COST_『断』,ARG
SELECTCASE ARG
	CASE 15
		RETURN 24
	CASE 0, 1
		RETURN 3
	CASEELSE
		RETURN 2 + ARG * 3 / 2
ENDSELECT


;　相性
;複合相性
@SKILL_TYPE_『断』,ARG
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "見習いメイド")
	RETURN GET_TYPE_NUM("검격"), GET_TYPE_NUM("핵열")
ELSE
	RETURN GET_TYPE_NUM("검격")
ENDIF

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_『断』
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_『断』,ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_『断』,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_『断』,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_『断』,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_『断』,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_『断』, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_『断』, ARG = -1
RETURN 0

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_『断』, ARG = -1, ARG:1 = -1
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "特殊勤務メイド")
	RETURN 0, 4
ELSE
	RETURN 0, 0
ENDIF
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_『断』,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_『断』,ARG
PRINTL 【회피】【코린 전용 스킬】
PRINTL 적 단체에 1~5회 검격 상성의 소데미지를 준다.
PRINTL 이 스킬은 명중률이 낮고, 크리티컬률이 높다.
PRINTL 공격 대상에게 상태이상이 부여되어 있는 경우, 필중 효과를 얻는다.
PRINTL 이 스킬이 사용되는 턴 동안 적에게 표적이 될 확률이 상승한다.

@ENHANCE_SKILL_EXPLAIN_『断』,ARG
RESULTS '= "敵単体に1~5回、剣撃相性の小ダメージを与える。命中率が低く、크리티컬률이 높다。" + "<br>"
RESULTS += "攻撃対象にバッドステートが付着されている場合、必中効果を得る。" + "<br>"
RESULTS += "このスキルが使用されるターンの間、敵からの狙われ率が上昇する。"

;使用条件
@SKILL_SPECIAL_ACTIONABLE_『断』,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_『断』, ARG = -1
RETURN 2

@SKILL_TURNSTART_『断』, ARG
SIF CFLAG:ARG:입력행동 != PU_SKILLNUM_GET(ARG, "『断』")
	RETURN 0
IF CFLAG:ARG:변동피타겟율 < 300 || CFLAG:ARG:피타겟비율변동지속턴수 == 0
	CFLAG:ARG:피타겟비율변동지속턴수 = 1
	CFLAG:ARG:변동피타겟율 = 300
ENDIF

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_『断』, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "追加命中強化"
			SIF CONVERT_SKILLNUM_TO_STR(L_P, SKILL_NUM) != "『断』"
				RETURN 0
			SIF IS_BADSTATE(L_TARGET, "GOOD")
				RETURN 0
			RETURN 999
	ENDSELECT
;自分が防御側
ELSE
ENDIF
RETURN 0

@SKILL_TAG_『断』
RESULTS = 젠제로 회피 스킬
