;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;
;====================================================
@SKILL_TRIGGER_ACTIONABLE_剣豪：追加攻撃,ARG,ARG:1
;自分じゃなければNG
SIF FLAG:행동순1 != ARG
	RETURN 0
;通常攻撃にのみ
SIF CFLAG:ARG:입력행동 != [[스킬:ＡＴＴＡＣＫ]]
  RETURN 0
;一度のみの判定にする
SIF ARG != ARG:1
	RETURN 0
;相手がいないとNG
SIF CFLAG:ARG:타겟 < 1
	RETURN 0
RETURN 1, CFLAG:ARG:타겟

