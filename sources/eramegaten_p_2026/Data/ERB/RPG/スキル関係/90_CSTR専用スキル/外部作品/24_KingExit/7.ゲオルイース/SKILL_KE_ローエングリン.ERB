;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_ローエングリン, ARG
	RESULTS = 로엔그린

;　명중
@SKILL_HITRATE_KE_ローエングリン, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_ローエングリン, ARG
RETURN 350

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_ローエングリン, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_ローエングリン, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_ローエングリン, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_KE_ローエングリン, ARG
RESULTS = %" 80ＴＰ"%
RETURN 0

;　相性
@SKILL_TYPE_KE_ローエングリン, ARG
RETURN GET_TYPE_NUM("파마")
;파마

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_ローエングリン
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_ローエングリン, ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_ローエングリン, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_KE_ローエングリン, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_ローエングリン, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_ローエングリン, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_KE_ローエングリン, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_ローエングリン
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_ローエングリン, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;ゲージ再回収できる様に起動前にTP80消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 80, "-="

CALL ATTACK_SINGLE, ARG, POS(ARG:1), SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_ローエングリン, ARG
PRINTL 
PRINTL 적 단체에 파마 속성 특대 위력의 마법 공격을 가한다. 이 공격은 TP만을 소비한다.
PRINTL 
PRINTL 전 인류해방군 총사령관 게오루이즈의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_ローエングリン, ARG
;ゲージが80以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 80
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_ローエングリン, ARG
RESULTS:0 = 적 단체에 파마 속성 특대 위력의 마법 공격을 가한다. 이 공격은 TP만을 소비한다.
RESULTS:1 = TP消費 80
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 80
	RESULTS:1 = %RESULTS:1%(不足)