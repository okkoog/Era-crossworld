;『救世の光』
;회복＋状態異常の無効化。クソ強い。ただし重い
;


;スキル名
@SKILL_NAME_KE_救世の光,ARG
RESULTS = 구세의 빛

;　명중
@SKILL_HITRATE_KE_救世の光, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_救世の光, ARG
RETURN 160

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_救世の光,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_救世の光,ARG
RETURN 1

;;一体辺りの最大ＨＩＴ数
;;※ランダム攻撃系に使う
;@SKILL_MAXATK_PER_KE_救世の光,ARG
;RETURN 1

;;一体辺りの最低ＨＩＴ数
;;※ランダム攻撃系に使う
;@SKILL_MINATK_PER_KE_救世の光,ARG
;RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_救世の光, ARG
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 30
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_KE_救世の光,ARG
IF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 30
	RESULTS = %" 30ＴＰ"%
	RETURN 0
ENDIF
RETURN 70


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_救世の光
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_救世の光,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_救世の光,ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_KE_救世の光,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_救世の光,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_救世の光,ARG
RETURN GET_SKILL_EFFECT_NUM("회복")

@SKILL_HEAL_TYPE_KE_救世の光, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("통상")

;속도보정
@SKILL_SPEED_KE_救世の光, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_救世の光
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_救世の光,ARG,ARG:1,SKILL_NUM
#DIM DYNAMIC SKILL_NUM
#DIM DYNAMIC LCOUNT
;Fゲージ再回収できる様に起動前にTP30消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 30, "-="
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	TSTR:스킬메시지추가효과 '= ""
	CALL SKILL_INVALID_WALL, ARG, POS(LCOUNT), "성스러운가호", "短縮", "NOWAIT"
	CALL HEAL_SINGLE,ARG,POS(LCOUNT),SKILL_NUM, , , TSTR:스킬메시지추가효과
NEXT
WAIT
;Dゲージ6。使用後5ターンクールタイム。
CALL SKILLGAGE_D_SET, ARG, PU_SKILLNUM_GET(ARG,"KE_救世の光"),6


;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_KE_救世の光,ARG
IF PU_SKILLGAGE_D_GET(ARG,"KE_救世の光") == 0
	RESULTS '= SET_COLOR_TAG(@"救世の光：STAND BY！", "#ffef00")
ELSE
	RESULTS = 구세의 빛:CT{PU_SKILLGAGE_D_GET(ARG,"KE_救世の光")}
ENDIF
RETURN 3


;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_KE_救世の光,ARG
PRINTL 
PRINTL 사람들에게 희망을 보여주는 구세의 빛.
PRINTL 아군 전체를 회복하면서 상태이상 무효화 실드를 부여한다.
PRINTL 
PRINTL 구세주 구이네의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_救世の光,ARG
;クールタイムが0のときのみ
SIF SKILLGAGE_D_GET(ARG, PU_SKILLNUM_GET(ARG, "KE_救世の光")) != 0
	RETURN 0
;ゲージが30以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 30
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_救世の光, ARG
RESULTS:0 = 아군 전체를 회복하면서 상태이상 무효화 실드를 부여한다.
RESULTS:1 = TP消費 30
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 30
	RESULTS:1 = %RESULTS:1%(不足)