;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_仮死薬, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;ゲージ再回収できる様に起動前にTP99消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 99, "-="

CALL SINGLE_BADSTATE, ARG, POS(ARG:1), SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_仮死薬, ARG
PRINTL 
PRINTL 생물을 가사 상태로 만드는 특수한 약.
PRINTL 고확률로 적 1체에게 신경 속성의 즉사를 부여한다.
PRINTL 
PRINTL 식물명예박사 라스터의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_仮死薬, ARG
;ゲージが99以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 99
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_仮死薬, ARG
RESULTS:0 = 생물을 가사 상태로 만드는 특수한 약. 고확률로 적 1체에게 신경 속성의 즉사를 부여한다.
RESULTS:1 = TP消費 99
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 99
	RESULTS:1 = %RESULTS:1%(不足)