;素晴らしき(Fabulous)フィンガースナップ。
;スキル名
@SKILL_NAME_ファビュラススナップ,ARG
RESULTS = 패뷸러스 스냅

;　명중
@SKILL_HITRATE_ファビュラススナップ, ARG
RETURN 100

;　威力
@SKILL_POWER_ファビュラススナップ, ARG
RETURN 500

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ファビュラススナップ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ファビュラススナップ,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ファビュラススナップ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ファビュラススナップ,ARG
RETURN 22

;　相性
@SKILL_TYPE_ファビュラススナップ,ARG
RETURN GET_TYPE_NUM("질풍")

@SKILL_SUCCESSION_TYPE_ファビュラススナップ,ARG
RETURN GET_SUCCESSION_NUM("질풍")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ファビュラススナップ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ファビュラススナップ,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ファビュラススナップ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ファビュラススナップ,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ファビュラススナップ,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ファビュラススナップ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_ファビュラススナップ, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ファビュラススナップ
RETURN 0

@SKILL_RANK_ファビュラススナップ, ARG = -1
RETURN 12

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ファビュラススナップ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃

;====================================================
;実行内容ここまで
;====================================================




;　説明文の表示
@SKILL_EXPLAIN_ファビュラススナップ,ARG
PRINTL 적 1체에 질풍 상성의 물리 데미지를 준다.
PRINTL 멋진 핑거 스냅을 행하여 적을 베어 가른다.

@SKILL_EXPLAIN_TOOLTIP_ファビュラススナップ,ARG
RESULTS:0 = 적 1체에 질풍 상성의 물리 데미지를 준다.



;使用条件
@SKILL_SPECIAL_ACTIONABLE_ファビュラススナップ,ARG
RETURN 1
