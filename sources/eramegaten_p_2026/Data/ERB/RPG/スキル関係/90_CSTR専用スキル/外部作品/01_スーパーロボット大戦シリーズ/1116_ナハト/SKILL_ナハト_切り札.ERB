;アルトアイゼン・ナハト専用スキル。
;単体剣撃飛具複合物理、5回攻撃、威力100(*5=500)、MP45、ランク13

;スキル名
@SKILL_NAME_切り札,ARG
RESULTS = 비장의 패

;　명중
@SKILL_HITRATE_切り札, ARG
RETURN 100

;　威力
@SKILL_POWER_切り札, ARG
RETURN 100

;　최저공격횟수
@SKILL_MINATTACKNUMBER_切り札,ARG
RETURN 5

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_切り札,ARG
RETURN 5

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_切り札, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_切り札,ARG
RETURN 45

;　相性
@SKILL_TYPE_切り札,ARG
RETURN GET_TYPE_NUM("검격"), GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_切り札
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_切り札,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_切り札,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_切り札,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_切り札,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_切り札,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_切り札, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_切り札
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_切り札
RETURN GET_SUCCESSION_NUM("검격")
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_切り札,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;単体攻撃
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_切り札,ARG
PRINTL 전 무장을 연속으로 퍼부어 적을 분쇄한다.
PRINTL 적 단체에 5회 『검격·비구』 복합 상성의 물리 데미지.

@SKILL_EXPLAIN_TOOLTIP_切り札, ARG
RESULTS:0 = 전 무장을 연속으로 퍼부어 적을 분쇄한다.
RESULTS:1 = 적 단체에 5회 『검격·비구』 복합 상성의 물리 데미지.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_切り札,ARG
RETURN 1

;スキル変化用ランク
@SKILL_RANK_切り札, ARG = -1
RETURN 13
