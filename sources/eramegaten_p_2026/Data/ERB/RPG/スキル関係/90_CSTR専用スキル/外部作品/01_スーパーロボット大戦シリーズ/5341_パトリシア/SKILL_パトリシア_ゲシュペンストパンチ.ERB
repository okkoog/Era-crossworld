;パトリシア・ハックマン専用スキル。
;単体打撃物理、威力500、MP32、ランク13、射程は3

;スキル名
@SKILL_NAME_ゲシュペンストパンチ,ARG
RESULTS = 게슈펜스트 펀치

;　명중
@SKILL_HITRATE_ゲシュペンストパンチ, ARG
RETURN 100

;　威力
@SKILL_POWER_ゲシュペンストパンチ, ARG
RETURN 500

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ゲシュペンストパンチ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ゲシュペンストパンチ,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ゲシュペンストパンチ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ゲシュペンストパンチ,ARG
RETURN 30

;　相性
@SKILL_TYPE_ゲシュペンストパンチ,ARG
RETURN GET_TYPE_NUM("타격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ゲシュペンストパンチ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ゲシュペンストパンチ,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ゲシュペンストパンチ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ゲシュペンストパンチ,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ゲシュペンストパンチ,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ゲシュペンストパンチ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_ゲシュペンストパンチ, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ゲシュペンストパンチ
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_ゲシュペンストパンチ
RETURN GET_SUCCESSION_NUM("타격")

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ゲシュペンストパンチ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;単体攻撃
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_ゲシュペンストパンチ,ARG
PRINTL 고속으로 질주하여 혼신의 힘으로 적을 후려친다.
PRINTL 정식 명칭 <필살! 게슈펜스트 펀치>
PRINTL 적 단체에 타격 상성의 물리 특대 데미지. 후열 사용 가능.

@SKILL_EXPLAIN_TOOLTIP_ゲシュペンストパンチ, ARG
RESULTS:0 = 고속으로 질주하여 혼신의 힘으로 적을 후려친다.
RESULTS:1 = 정식 명칭 <필살! 게슈펜스트 펀치>
RESULTS:2 = 敵単体に打撃相性の物理特大ダメージ。後列使用可。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ゲシュペンストパンチ,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_ゲシュペンストパンチ, ARG = -1
RETURN 13
