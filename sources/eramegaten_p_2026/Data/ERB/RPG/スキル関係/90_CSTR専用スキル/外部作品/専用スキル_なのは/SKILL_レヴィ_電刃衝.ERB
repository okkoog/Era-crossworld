;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_電刃衝,ARG
RESULTS = 電刃衝

;　명중
@SKILL_HITRATE_電刃衝, ARG
RETURN 100

;　威力
@SKILL_POWER_電刃衝, ARG
RETURN 130

;クリティカル率
@SKILL_CRITICAL_RATE_電刃衝, ARG
RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_電刃衝,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_電刃衝,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_電刃衝, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_電刃衝,ARG
RETURN 8

;　相性
@SKILL_TYPE_電刃衝,ARG
RETURN GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_電刃衝
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_電刃衝, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_電刃衝,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_電刃衝,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_電刃衝,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_電刃衝,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_電刃衝
RETURN GET_SUCCESSION_NUM("계통없음")
;속도보정
@SKILL_SPEED_電刃衝, ARG = -1
RETURN 5


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_電刃衝
RETURN 0

@継承不能_電刃衝

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_電刃衝,ARG
RETURN 2

;추가효과상성
@SKILL_ADDTIONAL_TYPE_電刃衝,ARG
RETURN 6

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_電刃衝,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_電刃衝,ARG
RETURN 95

;拡散攻撃用追加処理
@SKILL_SPREAD_電刃衝,ARG
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_電刃衝,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_電刃衝,ARG
	PRINTL 적 1체에 전격 상성의 소데미지 공격을 고속으로 행하고, 확률에 따라 감전을 부여한다.
	PRINTL 전기로 변환한 마력을 고속으로 쏘아내는, 뇌인의 습격자의 전용 마법.

@SKILL_EXPLAIN_TOOLTIP_電刃衝, ARG
RESULTS:0 = 적 1체에 고속으로 마력탄을 쏘아 넣는다.


;使用条件
@SKILL_SPECIAL_ACTIONABLE_電刃衝,ARG
RETURN 1