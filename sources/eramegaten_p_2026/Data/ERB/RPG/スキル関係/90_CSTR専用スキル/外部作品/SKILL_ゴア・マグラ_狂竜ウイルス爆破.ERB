;スキル及び行動の実行
;====================================================
@ACTION_狂竜ウイルス爆破,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)

