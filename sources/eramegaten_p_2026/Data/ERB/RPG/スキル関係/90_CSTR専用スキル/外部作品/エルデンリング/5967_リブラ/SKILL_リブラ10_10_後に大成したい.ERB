;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_後に大成したい, ARG, ARG:1, ARG:2
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_CHARA = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_CHARA)
		CONTINUE
	CALL PRINT_HIT_MESSAGE, L_CHARA, @"ＭＰ:{BASE:L_CHARA:ＭＰ / 4}데미지", "L"
	CALL VAR_MP, L_CHARA, -BASE:L_CHARA:ＭＰ / 4, "ダメージ"
NEXT
PRINTFORMW ＞획득 경험치가 증가한다!
TFLAG:획득EXP보정 = MAX(TFLAG:획득EXP보정, 100)

@SKILL_TARGETABLE_後に大成したい, ARG, ARG:1
SIF ARG == ARG:1
	RETURN 0
RETURN 1

