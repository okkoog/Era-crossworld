RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_発狂誘い,ARG
RETURN 8

;　相性
@SKILL_TYPE_発狂誘い,ARG
RETURN GET_TYPE_NUM("정신")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_発狂誘い,ARG
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_発狂誘い,ARG
RETURN GET_SKILL_TARGET_NUM("전투전체")

;　사거리
@SKILL_RANGE_発狂誘い,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_発狂誘い,ARG
RETURN GET_SPHERE_NUM("적아군전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_発狂誘い,ARG
RETURN GET_SKILL_EFFECT_NUM("상태변화")

;スキル変化？用ランク
@SKILL_RANK_発狂誘い, ARG = -1
RETURN 1

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_発狂誘い, ARG = -1
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_発狂誘い,ARG
RETURN GET_STATE_NUM("PANIC")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_発狂誘い,ARG
RETURN GET_TYPE_NUM("정신")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_発狂誘い,ARG
RETURN 50

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_発狂誘い,ARG
RETURN 90

