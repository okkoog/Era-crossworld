;スキル及び行動の実行
;====================================================
@ACTION_発狂誘い,ARG,ARG:1,ARG:2
CALL FIELD_BADSTATE, ARG, ARG:1, ARG:2

;ターゲット条件
@SKILL_TARGETABLE_発狂誘い,ARG, ARG:1
SIF ARG == ARG:1
	RETURN 0
RETURN 1

