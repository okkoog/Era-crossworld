;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_シザーズクロス_シズク, ARG, ARG:1, ARG:2
CALL ATTACK_SKILL, ARG, ARG:1, ARG:2
CALL PUSH_CEMETERY_閃刀魔法, ARG, "シザーズクロス"
SIF GET_COUNT_閃刀カウンター(ARG) >= 3
	CALL PU_SKILLGAGE_D_SET, ARG, "シザーズクロス_シズク", 1

@SKILL_ACTEND_シザーズクロス_シズク, ARG
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC L_FUNC_PROPSET_LIST
#DIMS DYNAMIC L_EXPLAIN
#DIM L_LINE
SIF FLAG:행동순1 != ARG
	RETURN 0
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
SIF !IS_PU_SKILL_入力行動(ARG, "シザーズクロス_シズク")
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG, , , , "リンク召喚", "WAIT"

L_LINE = LINECOUNT
WHILE 1
	TFLAG:스킬용1 = PU_SKILLGAGE_D_GET(ARG, "シザーズクロス_シズク") > 0
	CLEARLINE LINECOUNT - L_LINE
	L_FUNC_PROPSET_LIST = 戦闘/育成情報/調教/基本ステータス/防御相性1/防御相性2
	L_EXPLAIN = 누구를 불러낼까？
	{
	CALL INPUT_CHARA_LIST
		, L_FUNC_PROPSET_LIST
		, L_EXPLAIN
		, "CASTING_CHOOSE_シザーズクロス" 
		, "SHOW_ADD_UP_FUNCTION"
		, "SHOW_ADD_DOWN_FUNCTION"
		, "ADD_SELECT_FUNCTION"
		, "やめる"
		, "FUNC_CUSTOM_TITLE"
		, "FUNC_CUSTOM_COLOR"
		, -1
	}
	IF RESULT == 1000
		RETURN 0
	ELSE
		VARI L_CHANGE = RESULT
		CALL INPUT_COM_リンク召喚_レイ, ARG, L_CHANGE
		IF TFLAG:스킬용1 > 0
			IF CFLAG:L_CHANGE:상태이상 == GET_STATE_NUM("DYING")
				CFLAG:L_CHANGE:상태이상 = 0
				CFLAG:L_CHANGE:상태이상경과턴수 = 0
				CALL HEAL_SINGLE, ARG, L_CHANGE, PU_SKILLNUM_GET(ARG, "シザーズクロス_シズク"), , , "蘇生"
			ELSE
				CALL HEAL_SINGLE, ARG, L_CHANGE, PU_SKILLNUM_GET(ARG, "シザーズクロス_シズク")
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
WEND
RETURN 1

