;====================================================
;トリガー発動条件
;
;詳しい仕様については資料フォルダの解説を参照してください
;====================================================
@SKILL_TRIGGER_ACTIONABLE_再現,ARG,ARG:1
;直前の行動が再現だと発動しない
SIF PU_SKILLNUM_GET(ARG,"再現") == CFLAG:ARG:입력행동
	RETURN 0
;自分の行動でなければ発動しない
SIF ARG != ARG:1
	RETURN 0
;殺していないと発動しない
SIF !GET_CREC_ACT_SUM(ARG, "적", "KILL")
	RETURN 0
RETURN 1,CPOS(ARG)

