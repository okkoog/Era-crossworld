;====================================================
;トリガー発動条件
;
;詳しい仕様については資料フォルダの解説を参照してください
;====================================================
@SKILL_TRIGGER_ACTIONABLE_プログラム応答なし…,ARG,ARG:1
;行動者と味方同士でなければ死
SIF !IS_FRIEND(FLAG:행동순1, ARG)
	RETURN 0
;対象と敵同士でなければ死
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
SIF HAVE_SKILL(ARG, PU_SKILLNUM_GET(ARG,"作成")) && GET_CREC_ACT(FLAG:행동순1, ARG:1, "WEAK")
	RETURN 1, CPOS(ARG:1)
;以降は本人のみ
SIF FLAG:행동순1 != ARG
	RETURN 0
;専用スキル以外では発動しない
SIF CFLAG:ARG:입력행동 != PU_SKILLNUM_GET(ARG,"システム警告") && CFLAG:ARG:입력행동 != PU_SKILLNUM_GET(ARG,"変更を許可しますか？")  && CFLAG:ARG:입력행동 != PU_SKILLNUM_GET(ARG,"アカウントがBANされた")
	RETURN 0
;あたってないと発動しない
SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "HIT")
	RETURN 0
;ターゲットが不在だと発動しない
SIF CFLAG:ARG:타겟 < 1
	RETURN 0
RETURN 1, CFLAG:ARG:타겟

