;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_プログラム応答なし…,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
$LP
SIF -32 >= CFLAG:POS(ARG:1):(GET_BATTLESTATUS(0) + "강화") && -32 >= CFLAG:POS(ARG:1):(GET_BATTLESTATUS(4) + "강화") && -32 >= CFLAG:POS(ARG:1):(GET_BATTLESTATUS(1) + "강화") && -32 >= CFLAG:POS(ARG:1):(GET_BATTLESTATUS(3) + "강화") && -32 >= CFLAG:POS(ARG:1):(GET_BATTLESTATUS(2) + "강화") && -32 >= CFLAG:POS(ARG:1):(GET_BATTLESTATUS(5) + "강화")
	RETURN 0
SELECTCASE RAND:6
	CASE 0
		SIF -32 >= CFLAG:POS(ARG:1):(GET_BATTLESTATUS(0) + "강화")
			GOTO LP
		CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "공격", -4 , "단체"
	CASE 1
		SIF	-32 >= CFLAG:POS(ARG:1):(GET_BATTLESTATUS(1) + "강화")
			GOTO LP
		CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "명중", -4 , "단체"
	CASE 2
		SIF	-32 >= CFLAG:POS(ARG:1):(GET_BATTLESTATUS(2) + "강화")
			GOTO LP
		CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "방어", -4 , "단체"
	CASE 3
		SIF -32 >= CFLAG:POS(ARG:1):(GET_BATTLESTATUS(4) + "강화")
			GOTO LP
		CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "마법위력", -4 , "단체"
	CASE 4
		SIF -32 >= CFLAG:POS(ARG:1):(GET_BATTLESTATUS(3) + "강화")
			GOTO LP
		CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "회피", -4 , "단체"
	CASE 5
		SIF -32 >= CFLAG:POS(ARG:1):(GET_BATTLESTATUS(5) + "강화")
			GOTO LP
		CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "마법효과", -4 , "단체"
ENDSELECT
