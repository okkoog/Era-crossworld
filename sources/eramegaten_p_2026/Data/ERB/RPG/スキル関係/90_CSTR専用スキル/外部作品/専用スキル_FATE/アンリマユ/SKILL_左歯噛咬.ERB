;====================================================
@ACTION_左歯噛咬,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#LOCALSIZE 3
IF CFLAG:(ARG):PT플래그 == 0
	LOCAL:1 = 1
	LOCAL:2 = 7
ELSE
	LOCAL:1 = 7
	LOCAL:2 = 17
ENDIF

FOR LOCAL,LOCAL:1,LOCAL:2
	SIF POS(LOCAL) < 0
		CONTINUE
	CFLAG:POS(LOCAL):공격강화 = MAX(-16, CFLAG:POS(LOCAL):공격강화 - 4)
NEXT
PRINTFORMW 공격과 동시에 상대의 공격력을 낮춘다!

;CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM
;CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
