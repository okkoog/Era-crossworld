;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_レーヴァテイン（ＡＮ）,ARG,ARG:1
#DIM SKILL_NUM
;自分の行動でなければ終了
SIF ARG != FLAG:행동순1
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
SKILL_NUM = PU_SKILLNUM_GET(ARG,"レーヴァテイン（ＡＮ）")
SIF SKILLGAGE_H_GET(ARG,SKILL_NUM) < 1
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
SIF RESULT != 1 || CFLAG:ARG:타겟 < 1
	RETURN 0
IF CFLAG:ARG:타겟 < 17
	SIF POS(CFLAG:ARG:타겟) < 0 || GET_STATE(CFLAG:POS(CFLAG:ARG:타겟):상태이상) == "DYING"
		RETURN 0
	RESULT:1 = CFLAG:ARG:타겟
ELSE
	CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,CFLAG:ARG:타겟
	RESULT:1 = CFLAG:ARG:타겟
ENDIF
RETURN 1, CFLAG:ARG:타겟
;RETURN 1

