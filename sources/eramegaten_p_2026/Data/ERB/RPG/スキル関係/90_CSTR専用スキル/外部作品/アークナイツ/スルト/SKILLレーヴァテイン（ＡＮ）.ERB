;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
;@SKILL_DAMAGE_EFFECT_レーヴァテイン（ＡＮ）,ARG,ARG:1,ARG:2

;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_レーヴァテイン（ＡＮ）,ARG,ARG:1
#DIM SKILL_NUM

;自分の行動でなければ飛ばす
SIF ARG != ARG:1
	RETURN 0
SKILL_NUM = PU_SKILLNUM_GET(ARG,"レーヴァテイン（ＡＮ）")
;行動が攻撃でない or レーヴァテイン起動中ならば終了

CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
SIF RESULT != 1 || SKILLGAGE_H_GET(ARG,SKILL_NUM) > 0
	RETURN 0
IF SKILLGAGE_F_GET(ARG,SKILL_NUM) < TOINT(AUTO_SPLIT("4_3_3_2","_",TOINT(CSTR:ARG:102)-1))
	CALL SKILLGAGE_F_ADD,ARG,SKILL_NUM,1
ENDIF
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_レーヴァテイン（ＡＮ）,ARG,ARG:1,SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM
#DIM L_MAX_F
#DIM KILL_FLAG

SKILL_NUM = PU_SKILLNUM_GET(ARG,"レーヴァテイン（ＡＮ）")
L_MAX_F = TOINT(AUTO_SPLIT("4_3_3_2","_",TOINT(CSTR:ARG:102)-1))

IF SKILLGAGE_H_GET(ARG,SKILL_NUM) > 0
	IF CFLAG:ARG:타겟 < 17
		CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM,1
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM,1
	ENDIF
	;FOR LOCAL,0,CHARANUM
	;	SIF CFLAG:LOCAL:PT플래그 == CFLAG:ARG:PT플래그
	;		CONTINUE
	;	;相手に与えたダメージが相手のＨＰを上回った場合、Hゲージを最大まで再装填する
	;	IF CFLAG:LOCAL:현데미지 >= BASE:LOCAL:ＨＰ
	;		CALL SKILLGAGE_F_SET,ARG,SKILL_NUM,L_MAX_F
	;		CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,0
	;		KILL_FLAG = 1
	;		PRINTFORMW 相手を倒した事でレーヴァテイン（ＡＮ）が再使用可能になった！
	;		BREAK
		;ELSE
		;	CONTINUE
	;	ENDIF
	;NEXT
	;敵を殺していたら再使用可能に
	IF GET_CREC_ACT_SUM(ARG, "적", "KILL")
		CALL SKILLGAGE_F_SET,ARG,SKILL_NUM,L_MAX_F
		CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,0
		PRINTFORMW 상대를 격파함으로써 레바테인 (AN)이 다시 사용 가능해졌다!
	ELSE
;	IF KILL_FLAG < 1
		CALL SKILLGAGE_F_SET,ARG,SKILL_NUM,0
		CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,0
	ENDIF
ELSEIF SKILLGAGE_F_GET(ARG,SKILL_NUM) == L_MAX_F
	CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,1
	PRINTFORML 다음 공격 후, 레바테인으로 추격을 가하게 되었다!
ENDIF
WAIT
;====================================================
;追加コマンド(一番下)
;====================================================
@INPUT_COM_NAME_レーヴァテイン（ＡＮ）,ARG
RESULTS = レーヴァテイン（ＡＮ）
RESULTS:1 = 레바테인
RESULTS:2 = 0xffa500
RETURN 2

@INPUT_COM_ABLE_レーヴァテイン（ＡＮ）,ARG
;ゲージ不足
SIF PU_SKILLGAGE_F_GET(ARG,"レーヴァテイン（ＡＮ）") < TOINT(AUTO_SPLIT("4_3_3_2","_",TOINT(CSTR:ARG:102)-1))
	RETURN -1
CALL CHECK_COST, ARG, PU_SKILLNUM_GET(ARG, "レーヴァテイン（ＡＮ）")
SIF !RESULT
	RETURN -1
RETURN 1

;====================================================
;コマンド実行
;====================================================
@INPUT_COM_レーヴァテイン（ＡＮ）,ARG
#LOCALSIZE 1
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"レーヴァテイン（ＡＮ）")

CALL GET_SKILL_COST,SKILL_NUM,ARG
PRINTFORML 레바테인 (AN)을 사용하시겠습니까? (소비 MP {RESULT})
CALL INPUT_YN
IF RESULT == 0
	LOCAL = CFLAG:ARG:입력행동
	CFLAG:ARG:입력행동 = SKILL_NUM
	CALL PAY_COST, ARG, CFLAG:ARG:입력행동
	CALL PRINT_ACT_MESSAGE, ARG, SKILL_NUM
	CALL SKILL_ACTION, SKILL_NUM, TARGET
	CALL BATTLE_EVENT_ACT, ARG
	CFLAG:ARG:입력행동 = LOCAL
ENDIF
RETURN -1
;-1 再びコマンド選択へ
; 1 キャラ選択へ

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@SKILLGAGE_DISPLAY_レーヴァテイン（ＡＮ）,ARG
#DIM SKILL_NUM
#DIM GAGE_LIMIT
#DIM L_COLOR
SKILL_NUM = PU_SKILLNUM_GET(ARG,"レーヴァテイン（ＡＮ）")

;効果未発動なら獲得上限の値を、発動中なら最大効果時間をゲージ上限として代入
GAGE_LIMIT = SKILLGAGE_H_GET(ARG,SKILL_NUM) == 0 ? TOINT(AUTO_SPLIT("28_25_22_18","_",TOINT(CSTR:ARG:102)-1)) # 1
;効果状態に応じてゲージの色を設定
L_COLOR = SKILLGAGE_H_GET(ARG,SKILL_NUM) == 0 ? 0x9acd32 # 0xff8c00
PRINT ＥＸ―ＳＫＩＬＬ|
CALL PRINT_COLORBAR, SKILLGAGE_H_GET(ARG,SKILL_NUM) == 0 ? SKILLGAGE_F_GET(ARG,SKILL_NUM) # 1, GAGE_LIMIT, 25, UNICODE(0x2585), UNICODE(0x2585), L_COLOR, 0x696969
PRINTL

;　説明文の表示
@SKILL_EXPLAIN_レーヴァテイン（ＡＮ）,ARG
PRINTL 레바테인을 일시적으로 활성화시켜, 다음 공격과 같은 범위에 화염·검격 복합 상성의 물리 공격을 가한다.
PRINTL 공격 시에 게이지가 상승하며, 게이지가 가득 찼을 때 커맨드를 선택하면 기동한다.
PRINTL 레바테인 (AN)의 추격으로 적을 격파했을 때, 게이지가 즉시 가득 찬다.
PRINTL 격파하지 못하면 게이지는 리셋된다.
PRINTL 스킬 랭크를 올리면 위력이 증가하고 스킬 게이지의 상한이 낮아진다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_レーヴァテイン（ＡＮ）,ARG
