;180
SIF ARG < 0
	RETURN L_POW
SELECTCASE BASE:ARG:LV
	CASE IS >= 70
		L_POW = 110
		;330
	CASE IS >= 35
		L_POW = 85
		;255
ENDSELECT
RETURN L_POW

