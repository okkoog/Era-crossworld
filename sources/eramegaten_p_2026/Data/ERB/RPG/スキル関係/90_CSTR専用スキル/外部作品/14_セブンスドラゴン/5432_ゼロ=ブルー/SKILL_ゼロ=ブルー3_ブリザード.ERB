;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_ブリザード, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "命中・回避", -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ブリザード, ARG, ARG:1, ARG:2
CALL PU_SKILLGAGE_H_SET, ARG, "ブリザード", 1
PRINTFORMW 턴 종료 시 눈보라가 휘몰아치게 되었다!

@SKILL_TURNEND_ブリザード, ARG
SIF !PU_SKILLGAGE_H_GET(ARG, "ブリザード")
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG,  , , "ブリザード", "吹雪が襲い掛かる！！"
TFLAG:반사0데미지화 = 1
CALL ATTACK_SKILL, ARG, CFLAG:ARG:PT플래그 ? 22 # 19, PU_SKILLNUM_GET(ARG, "ブリザード")
TFLAG:반사0데미지화 = 0

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_ブリザード, ARG
PRINTL 턴 종료 시 적의 HP를 4/5로 만들고 명중/회피를 저하시킨다

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ブリザード,ARG
RETURN 1
;とくにない

