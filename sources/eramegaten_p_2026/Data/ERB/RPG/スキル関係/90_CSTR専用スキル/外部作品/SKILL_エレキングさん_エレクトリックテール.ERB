;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_エレクトリックテール,ARG
RESULTS = 일렉트릭 테일

;　명중
@SKILL_HITRATE_エレクトリックテール, ARG
RETURN 80

;　威力
@SKILL_POWER_エレクトリックテール, ARG
RETURN 420

;　최저공격횟수
@SKILL_MINATTACKNUMBER_エレクトリックテール,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_エレクトリックテール,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_エレクトリックテール, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_エレクトリックテール,ARG
RETURN 35

;　複合相性
@SKILL_TYPE_エレクトリックテール,ARG
RETURN GET_TYPE_NUM("전격"), GET_TYPE_NUM("타격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_エレクトリックテール
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　攻撃タイプ
@SKILL_ATTACKTYPE_エレクトリックテール,ARG
RETURN GET_攻撃タイプ_NUM("物理")

;　1物理ダメージで計算するか2物理ダメージで計算するか
@SKILL_DAMAGETYPE_エレクトリックテール, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_エレクトリックテール,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_エレクトリックテール,ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_エレクトリックテール,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_エレクトリックテール, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_エレクトリックテール
RETURN GET_SUCCESSION_NUM("전격")
;전격

;スキル変化？用ランク
@SKILL_RANK_エレクトリックテール, ARG = -1
RETURN 12

;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_エレクトリックテール,ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_エレクトリックテール,ARG
RETURN GET_TYPE_NUM("전격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_エレクトリックテール,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_エレクトリックテール,ARG
RETURN 70

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_エレクトリックテール,ARG,ARG:1,ARG:2
CALL ATTACK_SINGLE, ARG, POS(ARG:1),ARG:2

