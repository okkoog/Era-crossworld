;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_主砲照準、発射,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM hitカウント
#DIM TARGET_POS, 2
VARSET TARGET_POS

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
CALL ACTION_主砲照準、跳弾,ARG,ARG:1,SKILL_NUM
TARGET_POS = RESULT, RESULT:1
FOR LOCAL, 0, 2
    SIF !TARGET_POS:LOCAL
		CONTINUE
    CALL ACTION_主砲照準、跳弾,ARG,TARGET_POS:LOCAL,SKILL_NUM
NEXT

@ACTION_主砲照準、跳弾,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM HIT_POS, 2
#DIM hitカウント
#DIM L_TARGET_POS, 18
hitカウント = 0
HIT_POS = 0, 0

;判定順をランダムにするための措置
FOR LOCAL, 1, 17
    L_TARGET_POS:LOCAL = LOCAL
NEXT
FOR LOCAL, 1, 17
    SWAP L_TARGET_POS:RAND(1, 17), L_TARGET_POS:RAND(1, 17)
NEXT

;距離は最大で5になるのでそこまで判定する
FOR LOCAL:1, 1, 5
    FOR LOCAL, 1, 17
		L_TARGET_POS = L_TARGET_POS:LOCAL
        SIF !IS_TARGET_ABLE(POS(L_TARGET_POS))
            CONTINUE
        SIF MEASURE(L_TARGET_POS, ARG:1) != LOCAL:1
            CONTINUE
        SIF !IS_FRIEND(POS(ARG:1), POS(L_TARGET_POS))
            CONTINUE
        CALL ATTACK_SINGLE,ARG,POS(L_TARGET_POS),SKILL_NUM;	単体攻撃
        HIT_POS:hitカウント = L_TARGET_POS
        hitカウント++
        SIF hitカウント > 1
            BREAK
    NEXT
    SIF hitカウント > 1
        BREAK
NEXT
;跳弾する対象外なかった場合、50%の確率で対象自身にあたる。
IF hitカウント == 0 && RAND:2
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
	RETURN ARG:1, 0
ENDIF
RETURN HIT_POS:0, HIT_POS:1

