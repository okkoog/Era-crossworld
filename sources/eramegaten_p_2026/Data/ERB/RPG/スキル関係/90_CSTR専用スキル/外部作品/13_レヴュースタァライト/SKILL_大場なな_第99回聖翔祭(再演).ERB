@ACTION_第99回聖翔祭（再演）,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#LOCALSIZE 4
;コスト支払い
;CALL PAY_COST,ARG,616

;実行
IF CFLAG:ARG:PT플래그 > 0
	LOCAL:1 = 1 , 7
ELSE
	LOCAL:1 = 7 , 17
ENDIF
FOR LOCAL, LOCAL:1, LOCAL:2
	;トップスタァイベント経験済みかつ、星のティアラを装備している
	IF EQUIP:ARG:악세서리 == GETNUM(ITEM, "별의티아라") && 大場ななの記憶:3:7 > 0
		;自分も対象に入れる
	ELSE
		SIF ARG == POS(LOCAL)
			CONTINUE
	ENDIF
	IF POS(LOCAL) > -1
		CALL SKILL_INVALID_WALL, ARG, POS(LOCAL), "護りの盾_聖なる加護_テトラジャ", "단체", "NOWAIT"
	ENDIF
NEXT

;トップスタァイベント経験済みかつ、星のティアラを装備している
IF EQUIP:ARG:악세서리 == GETNUM(ITEM, "별의티아라") && 大場ななの記憶:3:7 > 0
	;カジャンダ解除はしない
;それ以外
ELSE
	CALL SKILL_能力低下解除, ARG, 23, "範囲", "NOMES"
	CALL SKILL_能力上昇解除, ARG, 23, "範囲", "NOMES"
	;FOR LOCAL,1, 17
	;	SIF POS(LOCAL) == -1
	;		CONTINUE
	;	SIF ARG == POS(LOCAL)
	;		CONTINUE
	;	FOR LOCAL:1, GETNUM(CFLAG,"공격강화"), GETNUM(CFLAG,"마법효과강화")+1
	;		CFLAG:POS(LOCAL):(LOCAL:1) = 0
	;	NEXT
	;NEXT

	PRINTFORML 적아군 전체의 카자계·ندا계 효과가 해제되었다!
ENDIF
PRINTFORML TARGET:\@CFLAG:ARG:PT플래그 ? PARTY # ENEMY \@ >>>>>> 즉사를 무효화!
PRINTFORML TARGET:\@CFLAG:ARG:PT플래그 ? PARTY # ENEMY \@ >>>>>> 상태이상을 무효화!
PRINTFORMW TARGET:\@CFLAG:ARG:PT플래그 ? PARTY # ENEMY \@ >>>>>> 모든 속성 상성을 무효화!

