
;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_レムニスゲート,ARG
RESULTS = 레무니스 게이트

;　명중
@SKILL_HITRATE_レムニスゲート, ARG
RETURN 100

;　威力
@SKILL_POWER_レムニスゲート, ARG
RETURN 100

;　최저공격횟수
@SKILL_MINATTACKNUMBER_レムニスゲート,ARG
SIF ARG < 0
	RETURN 1
SIF GETCHARA([[キャラ:섬도희레이]]) < 0
	RETURN 1
RETURN 1 + STRCOUNT(GET_RPG_CSTR_BTL(GETCHARA([[キャラ:섬도희레이]]), "セメタリー"), "/")

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_レムニスゲート,ARG
CALL SKILL_MINATTACKNUMBER_レムニスゲート,ARG
RETURN RESULT

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_レムニスゲート, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_レムニスゲート,ARG
RETURN 8

;　相性
@SKILL_TYPE_レムニスゲート,ARG
IF ARG >= 0
	RETURN GET_TYPE_NUM("검격"), GET_ADD_TYPE_ROZE_SKILL(ARG)
ELSE
	RETURN GET_TYPE_NUM("검격")
ENDIF

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_レムニスゲート
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_レムニスゲート, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_レムニスゲート, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_レムニスゲート,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_レムニスゲート,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_レムニスゲート, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_レムニスゲート
RETURN GET_SUCCESSION_NUM("검격")

;속도보정
@SKILL_SPEED_レムニスゲート, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_レムニスゲート
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_レムニスゲート, ARG = -1
RETURN 8

;スキルがランダム範囲かどうか
@SKILL_RAND_TARGET_レムニスゲート,ARG
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_レムニスゲート, ARG, ARG:1, ARG:2
CALL ATTACK_SKILL, ARG, ARG:1, ARG:2
SIF GETCHARA([[キャラ:섬도희레이]]) >= 0
	CALL SET_RPG_CSTR_BTL, GETCHARA([[キャラ:섬도희레이]]), "セメタリー", ""

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_レムニスゲート, ARG
PRINTFORML 【로제 전용 스킬】
PRINTFORML 적 전체 랜덤에게 검격 속성의 데미지를 가한다. 후열 사용 가능.
PRINTFORML 이 스킬의 공격 횟수는 아군의 사용 완료된 【섬도마법】의 수에 따라 달라진다.
PRINTFORML 효과 발동 후 모든 【섬도마법】이 사용 가능해진다.
PRINTFORML 
PRINTFORML 이 스킬은 섬도 카운터가 3개 이상 없으면 발동할 수 없으며,
PRINTFORML 효과 발동 후 자신이 가진 섬도 카운터를 제거한다.

@SKILL_EXPLAIN_TOOLTIP_レムニスゲート, ARG = -1
RESULTS:0 = 【로제 전용 스킬】
RESULTS:1 = 적 전체 랜덤에게 검격 속성의 데미지를 가한다. 후열 사용 가능.
RESULTS:2 = このスキルの攻撃回数は味方の使用済みの【閃刀魔法】の数に応じて変わる。
RESULTS:3 = 効果発動後、全ての【閃刀魔法】が使用可能になる。
RESULTS:4 = 
RESULTS:5 = このスキルは閃刀カウンターが3つ以上なければ発動できず、
RESULTS:6 = 効果発動後、自身の持つ閃刀カウンターを取り除く。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_レムニスゲート,ARG
RESULTS = "필요:섬도 카운터 3"
SIF GET_RPG_CFLAG_BTL(ARG, "閃刀カウンター") < 3
	RETURN 0
RETURN 1

@リンク不能_レムニスゲート
RETURN 1

@SKILL_TAG_レムニスゲート
RESULTS = 로제 전용 스킬

