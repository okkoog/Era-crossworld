	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_KE_ヴェヴィーシャスアイズ, ARG
IF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 70
	RESULTS = %" 70ＴＰ"%
	RETURN 0
ENDIF
RETURN 50

