;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_ヴェヴィーシャスアイズ, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;ゲージ再回収できる様に起動前にTP70消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 70, "-="

;全能力ダウン構文
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "攻撃_防御_魔法威力_魔法効果_命中_回避", -4, "範囲"

;Dゲージ6。使用後5ターンクールタイム。
CALL SKILLGAGE_D_SET, ARG, PU_SKILLNUM_GET(ARG,"KE_ヴェヴィーシャスアイズ"),5

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_KE_ヴェヴィーシャスアイズ,ARG
IF PU_SKILLGAGE_D_GET(ARG,"KE_ヴェヴィーシャスアイズ") == 0
	RESULTS '= SET_COLOR_TAG(@"ヴェヴィーシャスアイズ：STAND BY！", "#ffef00")
ELSE
	RESULTS = V아이즈:CT{PU_SKILLGAGE_D_GET(ARG,"KE_ヴェヴィーシャスアイズ")}
ENDIF
RETURN 3

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_ヴェヴィーシャスアイズ, ARG
PRINTL 
PRINTL 진실을 꿰뚫어 보는 성마법 『베비셔스 아이즈』.
PRINTL 적 전체의 능력치를 1단계 다운시킨다.
PRINTL 
PRINTL 옥중 성직자 스티아라의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_ヴェヴィーシャスアイズ, ARG
;クールタイムが0のときのみ
SIF SKILLGAGE_D_GET(ARG, PU_SKILLNUM_GET(ARG, "KE_ヴェヴィーシャスアイズ")) != 0
	RETURN 0
;ゲージが70以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 70
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_ヴェヴィーシャスアイズ, ARG
RESULTS:0 = 적 전체의 능력치를 1단계 다운시킨다.
RESULTS:1 = TP消費 70
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 70
	RESULTS:1 = %RESULTS:1%(不足)