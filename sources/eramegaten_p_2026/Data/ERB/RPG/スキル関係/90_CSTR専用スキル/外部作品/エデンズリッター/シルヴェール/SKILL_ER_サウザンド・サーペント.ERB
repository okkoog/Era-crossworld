@SKILL_TARGET_ER_サウザンド・サーペント, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ER_サウザンド・サーペント, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ER_サウザンド・サーペント, ARG
IF GET_RPG_CSTR_BTL(ARG, "エデンズリッター変身状態") == "起動"
	RETURN 1
