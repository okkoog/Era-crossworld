;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_ER_サウザンド・サーペント, ARG
IF GET_RPG_CSTR_BTL(ARG, "エデンズリッター変身状態") == "起動"
	IF FLAG:행동순1 == ARG
		RESULTS = 루미너스 이클립스
	ELSE
		RESULTS = ﾙﾐﾅｽ･ｴｸﾘﾌﾟｽ
	ENDIF
ELSE
	IF FLAG:행동순1 == ARG
		RESULTS = 서우전드 서펀트
	ELSE
		RESULTS = ｻｳｻﾞﾝﾄﾞ･ｻｰﾍﾟﾝﾄ
	ENDIF
ENDIF

