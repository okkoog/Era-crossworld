RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_ER_サウザンド・サーペント, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ER_サウザンド・サーペント
RETURN 0


;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_ER_サウザンド・サーペント, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
SIF ARG:2 < -1
	RETURN 0

IF GET_RPG_CSTR_BTL(ARG, "エデンズリッター変身状態") == "起動"
	; デバフ
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "攻撃_防御_回避", -4, "短縮", "", "", -4
ENDIF

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ER_サウザンド・サーペント, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM
IF GET_RPG_CSTR_BTL(ARG, "エデンズリッター変身状態") == "起動"
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM
ELSE
	CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM
	
	; 自バフ
	CALL SKILL_SET_カジャンダ, ARG, ARG, "攻撃_クリティカル", 4, "短縮", "", "", 4
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_ER_サウザンド・サーペント, ARG
IF GET_RPG_CSTR_BTL(ARG, "エデンズリッター変身状態") == "起動"
	PRINTL 
	PRINTL 마의 힘을 해방하여 장총검 에스티카 로우로 꿰뚫는다.
	PRINTL 적 단체에 비구 속성 대위력의 물리 공격을 행한다.
	PRINTL 
ELSE
	PRINTL 
	PRINTL 사렵검 서펀트 팽을 뽑아 크게 휘두른다.
	PRINTL 적 전체에 검격 속성의 물리 공격을 행한다.
	PRINTL 
ENDIF

