;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_閃刀空域『エリアゼロ』, ARG, ARG:1, ARG:2
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC IS_EFFECT
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	SIF !IS_SENTOUKI_REI(POS(LCOUNT))
		CONTINUE
	CALL PRINT_HIT_MESSAGE, POS(LCOUNT), "連続行動！", "L"
	CFLAG:POS(LCOUNT):연속행동발생률 += 100
	IF CFLAG:POS(LCOUNT):피링크캐릭터실제가입시간 > 0
		CALL SET_RPG_CFLAG_BTL, FINDCHARA_TIMEID(CFLAG:POS(LCOUNT):피링크캐릭터실제가입시간), "エリアゼロ", FLAG:경과턴수 + 1
	ELSE
		CALL SET_RPG_CFLAG_BTL, POS(LCOUNT), "エリアゼロ", FLAG:경과턴수 + 1
	ENDIF
	IS_EFFECT = 1
NEXT
SIF !IS_EFFECT
	PRINTFORML 효과가 없었다。
WAIT

