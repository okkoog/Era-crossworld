@ACTION_「暴虐のバレットドミニオン」,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
FLAG:확산플래그 = 0

SIF RAND:8 < FLAG:월령
	FLAG:확산플래그 = 1

SIF RAND:100 < BASE:ARG:마력
	FLAG:확산플래그 = 1

IF FLAG:확산플래그 == 1
	SETCOLOR 0x33ffcc
	PRINTL 월홍의 힘이 고조된다!
	RESETCOLOR
ENDIF

CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)

FLAG:확산플래그 = 0


