;====================================================
;行動によるスキルゲージ操作
;====================================================
@SKILLGAGE_CHARGE_GPM【リロード】,ARG,ARG:1
#DIM SKILL_NUM
#DIM SKILL_NUM1
#DIM SKILL_NUM2
#DIM SKILL_NUM3
#DIM SKILL_NUM4
#DIM SKILL_NUM5
#DIM SKILL_NUM6
#DIM SKILL_NUM7
#DIM SKILL_NUM8
SKILL_NUM = PU_SKILLNUM_GET(ARG,"GPM【リロード】")
SKILL_NUM1 = PU_SKILLNUM_GET(ARG,"GPMアサルトライフル")
SKILL_NUM2 = PU_SKILLNUM_GET(ARG,"GPMヘビーマシンガン")
SKILL_NUM3 = PU_SKILLNUM_GET(ARG,"GPMサブマシンガン")
SKILL_NUM4 = PU_SKILLNUM_GET(ARG,"GPMロケットポッド")
SKILL_NUM5 = PU_SKILLNUM_GET(ARG,"GPM40mm高射機関砲")
SKILL_NUM6 = PU_SKILLNUM_GET(ARG,"GPMレーザーライフル")
SKILL_NUM7 = PU_SKILLNUM_GET(ARG,"GPM手榴弾")
SKILL_NUM8 = PU_SKILLNUM_GET(ARG,"GPM煙幕手榴弾")

;自分の行動の場合
IF ARG == ARG:1
	;GPM【リロード】をすると複数の武装の装填数を同時に回復させる
	IF CFLAG:ARG:입력행동 == 3904
		CALL SKILLGAGE_F_SET,ARG,SKILL_NUM1,0
		CALL SKILLGAGE_F_SET,ARG,SKILL_NUM2,0
		CALL SKILLGAGE_F_SET,ARG,SKILL_NUM3,0
		CALL SKILLGAGE_F_SET,ARG,SKILL_NUM4,0
		CALL SKILLGAGE_F_SET,ARG,SKILL_NUM5,0
		CALL SKILLGAGE_F_SET,ARG,SKILL_NUM6,0
		CALL SKILLGAGE_F_SET,ARG,SKILL_NUM7,0
		CALL SKILLGAGE_F_SET,ARG,SKILL_NUM8,0
	ELSE
	ENDIF
ELSE
ENDIF

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_GPM【リロード】,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"GPM【リロード】")
PRINTFORML %CALLNAME:ARG% 은(는) 무장을 장전했다!

