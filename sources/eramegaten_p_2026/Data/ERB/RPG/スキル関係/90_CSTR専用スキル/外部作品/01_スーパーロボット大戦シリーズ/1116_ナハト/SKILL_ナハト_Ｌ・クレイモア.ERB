;アルトアイゼン・ナハト専用スキル。
;一列ランダム飛具物理、4回攻撃、威力125(*4=500)、MP25、ランク12

;スキル名
@SKILL_NAME_Ｌ・クレイモア,ARG
RESULTS = L·클레이모어

;　명중
@SKILL_HITRATE_Ｌ・クレイモア, ARG
RETURN 100

;　威力
@SKILL_POWER_Ｌ・クレイモア, ARG
RETURN 125

;　최저공격횟수
@SKILL_MINATTACKNUMBER_Ｌ・クレイモア,ARG
RETURN 4

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_Ｌ・クレイモア,ARG
RETURN 4

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_Ｌ・クレイモア, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_Ｌ・クレイモア,ARG
RETURN 25

;　相性
@SKILL_TYPE_Ｌ・クレイモア,ARG
RETURN GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_Ｌ・クレイモア
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_Ｌ・クレイモア,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_Ｌ・クレイモア,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_Ｌ・クレイモア,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_Ｌ・クレイモア,ARG
RETURN GET_SPHERE_NUM("일렬")

;スキルがランダム範囲かどうか
@SKILL_RAND_TARGET_Ｌ・クレイモア,ARG
RETURN 1

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_Ｌ・クレイモア,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_Ｌ・クレイモア, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_Ｌ・クレイモア
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_Ｌ・クレイモア
RETURN GET_SUCCESSION_NUM("비구")
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_Ｌ・クレイモア,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;列攻撃
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_Ｌ・クレイモア,ARG
PRINTL 양 어깨 해치에 장전된 대량의 베어링 탄환을 난사한다.
PRINTL 정식 명칭 <레이어드 클레이모어>
PRINTL 적 1열 무작위로 4회 비구 상성의 물리 데미지. 후열 사용 가능.

@SKILL_EXPLAIN_TOOLTIP_Ｌ・クレイモア, ARG
RESULTS:0 = 양 어깨 해치에 장전된 대량의 베어링 탄환을 난사한다.
RESULTS:1 = 정식 명칭 <레이어드 클레이모어>
RESULTS:1 = 적 1열 무작위로 4회 비구 상성의 물리 데미지. 후열 사용 가능.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_Ｌ・クレイモア,ARG
RETURN 1

;スキル変化用ランク
@SKILL_RANK_Ｌ・クレイモア, ARG = -1
RETURN 12
