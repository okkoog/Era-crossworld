
;スキル名
@SKILL_NAME_ワタクシの歌を聴きなさい,ARG
RESULTS = 저의 노랠 들으세요

;　명중
@SKILL_HITRATE_ワタクシの歌を聴きなさい, ARG
RETURN 120

;　威力
@SKILL_POWER_ワタクシの歌を聴きなさい, ARG
RETURN 150

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ワタクシの歌を聴きなさい,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ワタクシの歌を聴きなさい,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ワタクシの歌を聴きなさい, ARG
SIF GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 4
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_ワタクシの歌を聴きなさい,ARG
IF ARG >= 0 && GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 4
	RESULTS = %"ＣＨ:4"%
	RETURN 0
ENDIF
RETURN 15

;　相性
@SKILL_TYPE_ワタクシの歌を聴きなさい,ARG
RETURN GET_TYPE_NUM("정신"), GET_TYPE_NUM("주살")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ワタクシの歌を聴きなさい
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

