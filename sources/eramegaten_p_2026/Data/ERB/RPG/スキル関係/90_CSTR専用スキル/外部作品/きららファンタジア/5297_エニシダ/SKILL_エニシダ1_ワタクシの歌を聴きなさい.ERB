@SKILL_ACTIONABLE_FIELD_ワタクシの歌を聴きなさい
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_ワタクシの歌を聴きなさい,ARG
SIF HAVE_PU_SKILL(ARG,"呪われた歌")
	RETURN GET_STATE_NUM("CURSE")
RETURN 0

;추가효과상성
@SKILL_ADDTIONAL_TYPE_ワタクシの歌を聴きなさい,ARG
SIF HAVE_PU_SKILL(ARG,"呪われた歌")
	RETURN GET_TYPE_NUM("주살")
RETURN 0

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_ワタクシの歌を聴きなさい,ARG
SIF HAVE_PU_SKILL(ARG,"呪われた歌")
	RETURN 50
RETURN 0

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_ワタクシの歌を聴きなさい,ARG
SIF HAVE_PU_SKILL(ARG,"呪われた歌")
	RETURN 95
RETURN 0

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_ワタクシの歌を聴きなさい, ARG = -1, ARG:1 = -1
SIF ABL:ARG:가창기능 >= 5
	RETURN 0, 2
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ワタクシの歌を聴きなさい,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

CALL SET_RPG_CFLAG_BTL, ARG, "KFチャージスキル", 4, "-="

CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM
;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_ワタクシの歌を聴きなさい,ARG
PRINTL 적 전체에 정신 상성+주살 상성의 데미지를 준다.
PRINTL 가창 기능이 Lv5 이상일 경우 적의 내성을 무효까지 관통하는 효과를 얻는다
PRINTL 사용 시 차지 4 소비.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ワタクシの歌を聴きなさい, ARG
RESULTS = 차지 부족
SIF GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 4
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_ワタクシの歌を聴きなさい, ARG
RESULTS:0 = 적 전체에 정신 상성+주살 상성의 데미지를 준다.
RESULTS:1 = 가창 기능이 Lv5 이상일 경우 적의 내성을 무효까지 관통하는 효과를 얻는다
RESULTS:2 = 使用時にチャージを4消費。

