;白銀の城の召使いアリアーヌ専用スキル。
;剣撃火炎複合全体物理/ランク14/複合なので威力は1ランク下げる。

;スキル名
@SKILL_NAME_白銀の燭台斧,ARG
RESULTS = 백은의 촛대도끼

;　명중
@SKILL_HITRATE_白銀の燭台斧, ARG
RETURN 100

;　威力
@SKILL_POWER_白銀の燭台斧, ARG
RETURN 390

;　최저공격횟수
@SKILL_MINATTACKNUMBER_白銀の燭台斧,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_白銀の燭台斧,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_白銀の燭台斧, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")


;　コストの量
@SKILL_COST_白銀の燭台斧,ARG
RETURN 60

;　相性
@SKILL_TYPE_白銀の燭台斧,ARG
RETURN GET_TYPE_NUM("검격"), GET_TYPE_NUM("화염")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_白銀の燭台斧
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_白銀の燭台斧,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_白銀の燭台斧,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_白銀の燭台斧,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_白銀の燭台斧,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_白銀の燭台斧,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_白銀の燭台斧, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_白銀の燭台斧
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_白銀の燭台斧
RETURN GET_SUCCESSION_NUM("검격")

;スキル変化？用ランク
@SKILL_RANK_白銀の燭台斧, ARG = -1
RETURN 14

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_白銀の燭台斧,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;全体攻撃
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_白銀の燭台斧,ARG
PRINTL 적 전체에 『검격/화염』 복합 속성의 물리 특대 데미지. 후열 사용 가능.
PRINTL 백은 성의 하인 아리안느의 필살기.

@SKILL_EXPLAIN_TOOLTIP_白銀の燭台斧, ARG
RESULTS:0 = 적 전체에 『검격/화염』 복합 속성의 물리 특대 데미지. 후열 사용 가능.
RESULTS:1 = 백은 성의 하인 아리안느의 필살기.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_白銀の燭台斧,ARG
RETURN 1



