@DISPLAY_COMMAND_P_クラス２スキル（聖剣３）,ARG
SIF PU_SKILLGAGE_D_GET(ARG,"クラス２スキル（聖剣３）") == 0
	RETURN 0
RESULTS = 클래스 스킬: CT{PU_SKILLGAGE_D_GET(ARG,"クラス２スキル（聖剣３）")}
RETURN 3

@SKILL_EX_DISPLAY_クラス２スキル（聖剣３）, ARG, ARGS
#DIM BAR_LENS, 2
#DIM BAR_COLOR, 2
#DIM L_COLOR
#DIMS L_RESULTS, 2
VARSET L_RESULTS
SELECTCASE NO:ARG
	CASE [[キャラ:리스]]
		L_COLOR = 0x009e25
	CASE [[キャラ:샤를로트]]
		L_COLOR = 0xffaa00
	CASE [[キャラ:안젤라]]
		L_COLOR = 0x782069
ENDSELECT
BAR_LENS = SKILL_EX_DISPLAY_LENS / 2 + SKILL_EX_DISPLAY_LENS % 2, SKILL_EX_DISPLAY_LENS / 2
IF PU_SKILLGAGE_D_GET(ARG, "クラス２スキル（聖剣３）")
	L_RESULTS:0 = %SET_COLOR_TAG(UNICODE(0x2694), TOSTR(L_COLOR))%
	L_RESULTS:0 += " " * (BAR_LENS - 8)
	L_RESULTS:0 += HTML_ESCAPE(@"<CT:{PU_SKILLGAGE_D_GET(ARG, "クラス２スキル（聖剣３）")}>")
ELSE
	L_RESULTS:0 = %SET_COLOR_TAG(UNICODE(0x2694), TOSTR(L_COLOR))%
	L_RESULTS:0 +=  " " * (BAR_LENS - 8) + SET_COLOR_TAG("Ready", TOSTR(L_COLOR)) +  " "
ENDIF
IF HAVE_PU_SKILL(ARG, "クラス４スキル（聖剣３）")
	IF PU_SKILLGAGE_F_GET(ARG, "クラス４スキル（聖剣３）") >= 100
		L_RESULTS:1 += SET_COLOR_TAG("★", TOSTR(L_COLOR))
		L_RESULTS:1 +=  " " * (BAR_LENS:1 - 8) + SET_COLOR_TAG("Ready", TOSTR(L_COLOR)) +  " "
	ELSE
		BAR_COLOR = BARCOLORSET("緑"), RESULT:1
		L_RESULTS:1 += SET_COLOR_TAG("★", TOSTR(L_COLOR))
		L_RESULTS:1 += HTML_RECT_BAR(PU_SKILLGAGE_F_GET(ARG, "クラス４スキル（聖剣３）"), 100, BAR_LENS:1 - 2, BAR_COLOR, BAR_COLOR:1)
		L_RESULTS:1 '= SET_BUTTON_TAG(L_RESULTS:1, ARGS, "ＳＰゲージ")
	ENDIF
ELSE
	L_RESULTS:0 += " " * BAR_LENS:1
ENDIF
L_RESULTS:0 '= SET_BUTTON_TAG(L_RESULTS:0, ARGS, "クラススキルクールタイム")
RESULTS '= L_RESULTS:0 + L_RESULTS:1
RETURN 1

