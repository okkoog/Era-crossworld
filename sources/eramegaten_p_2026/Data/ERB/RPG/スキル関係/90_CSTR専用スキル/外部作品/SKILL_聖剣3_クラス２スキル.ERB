@SKILL_EXPLAIN_クラス２スキル（聖剣３）,ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:리스]]
	IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光"
		PRINTL 『真空波動槍』
		;クラス４解禁時
		IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス4属性") != ""
			PRINTL 적 1열에 충격·검격 복합 속성의 대위력 물리 공격을 1회 가하고, 충격 속성의 다운을 부여한다.
		;クラス３解禁時
		ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") != ""
			PRINTL 적 1열에 충격·검격 복합 속성의 대위력 물리 공격을 1회 가하고, 충격 속성의 다운을 부여한다.
		;クラス２のみ解禁時
		ELSE
			PRINTL 적 1열에 충격·검격 복합 속성의 중위력 물리 공격을 1회 가하고, 충격 속성의 다운을 부여한다.
		ENDIF
		PRINT 추가 효과：공격 전, 아군 전체의 공격·회피를 1단계 강화.
		SETCOLOR 0x33ffcc
			PRINTL 쿨타임：2턴.
		RESETCOLOR
		PRINTL 
		PRINTL 창을 고속 회전시켜, 진공을 주위의 적을 향해 발구함과 동시에,
		PRINTL 바람을 일으켜 동료의 전투력을 원호한다.
		PRINTL 발키리의 힘을 얻은 리스의 클래스 스킬 (CSTR 전용)
	ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "闇"
		PRINTL 『飛天槍』
		;クラス４解禁時
		IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス4属性") != ""
			PRINTL 적 1열에 충격·검격 복합 속성의 대위력 물리 공격을 1회 가한다.
		;クラス３解禁時
		ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") != ""
			PRINTL 적 1열에 충격·검격 복합 속성의 대위력 물리 공격을 1회 가한다.
		;クラス２のみ解禁時
		ELSE
			PRINTL 적 1열에 충격·검격 복합 속성의 중위력 물리 공격을 1회 가한다.
		ENDIF
		PRINT 추가 효과：명중 시, 방어·마법효과를 1단계 저하.
		SETCOLOR 0x33ffcc
			PRINTL 쿨타임：2턴.
		RESETCOLOR
		PRINTL 
		PRINTL 창을 던지며 비상하여, 적의 상공에서 강습해 방어를 무너뜨린다.
		PRINTL 룬 메이든의 힘을 얻은 리스의 클래스 스킬 (CSTR 전용)
	ELSE
		PRINTL 클래스 체인지를 거치기 전의 스킬. 적 1열에 충격·검격 복합 속성의 중위력 물리 공격.
	ENDIF
ELSEIF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:샤를로트]]
