;スキル及び行動の実行
;====================================================
@ACTION_クラス２スキル（聖剣３）,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#LOCALSIZE 4
#DIM クラス技変数
クラス技変数 = PU_SKILLNUM_GET(ARG,"クラス２スキル（聖剣３）")
IF SKILL_CHANGE(ARG, [[キャラ:리스]])
	;光時、攻撃前に強化
	IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光"
		CALL SKILL_SET_カジャンダ, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, "攻撃_回避", 4, "範囲"
		;IF CFLAG:(ARG):PT플래그 == 0
		;	LOCAL:1 = 7
		;	LOCAL:2 = 17
		;ELSE
		;	LOCAL:1 = 1
		;	LOCAL:2 = 7
		;ENDIF

		;FOR LOCAL,LOCAL:1,LOCAL:2
		;	SIF POS(LOCAL) < 0
		;		CONTINUE
		;	CFLAG:POS(LOCAL):공격강화 = MIN(32, CFLAG:POS(LOCAL):공격강화 + 4)
		;	CFLAG:POS(LOCAL):회피강화 = MIN(32, CFLAG:POS(LOCAL):회피강화 + 4)
		;NEXT
		;PRINTFORMW \@ CFLAG:ARG:PT플래그 == 0 ? 敵 # 味方 \@の攻撃・回避がアップ！
	ENDIF
	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
ELSEIF SKILL_CHANGE(ARG, [[キャラ:샤를로트]])
	IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光"
		CALL SKILL_能力低下解除, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, "範囲"
		;IF ARG:1 == 19
		;	LOCAL:2 = 1
		;	LOCAL:3 = 7
		;ELSE
		;	LOCAL:2 = 7
		;	LOCAL:3 = 17
		;ENDIF

		;FOR LOCAL,LOCAL:2,LOCAL:3
		;	SIF POS(LOCAL) < 0
		;		CONTINUE
		;	FOR LOCAL:1,0,6
		;		CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") = MAX(0, CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화"))
		;	NEXT
		;NEXT
		;PRINTFORMW \@ CFLAG:ARG:PT플래그 > 0 ? 味方 # 敵 \@のンダ効果を打ち払った！
	ENDIF
	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
ELSEIF SKILL_CHANGE(ARG, [[キャラ:안젤라]])
	IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "闇"
		;闇状態であり、HP５％以上でかつ魔法威力強化が32未満の場合、５％消費して魔法威力強化
		IF BASE:ARG:ＨＰ > (MAXBASE:ARG:ＨＰ / 20) && CFLAG:ARG:마법위력강화 < 32
			BASE:ARG:ＨＰ -= (MAXBASE:ARG:ＨＰ / 20)
			CALL SKILL_SET_カジャンダ, ARG, ARG, "마법위력", 8, "단체", "NOMES"
			;CFLAG:ARG:마법위력강화 = MIN(32, CFLAG:ARG:마법위력강화 + 8)
			PRINTFORML 페인 매직!　HP와 맞바꿔 마법위력을 대폭 상승!
		ENDIF
	ENDIF
	CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM;		拡散攻撃
ENDIF
	;リキャストセット、数値は３＝２ターン
CALL SKILLGAGE_D_SET,ARG,クラス技変数,3

