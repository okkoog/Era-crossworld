@SKILL_SPECIAL_ACTIONABLE_クラス２スキル（聖剣３）,ARG
#DIM クラス技変数
クラス技変数 = PU_SKILLNUM_GET(ARG,"クラス２スキル（聖剣３）")
;共通でDゲージCTが０でない場合使用不可
RESULTS = 쿨타임:%TOFULL(TOSTR(SKILLGAGE_D_GET(ARG,クラス技変数)))%턴
