;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_祈りの願い,ARG,ARG:1,ARG:2
#DIM DYNAMIC L_CHARA
FOR L_CHARA,0,CHARANUM
	SIF !IS_COMP内効果有効(L_CHARA)
		CONTINUE
	IF CFLAG:(L_CHARA):상태이상 == GET_STATE_NUM("DYING")
		CFLAG:(L_CHARA):상태이상 = 0
		CFLAG:(L_CHARA):상태이상경과턴수 = 0
		CALL VAR_HP,(L_CHARA),MAXBASE:(L_CHARA):ＨＰ
		PRINTFORML %CALLNAME:(L_CHARA)%(은)는 숨을 되찾았다
	ELSE
		CALL HEAL_SINGLE, ARG, L_CHARA, ARG:2, 1
	ENDIF
NEXT
CALL VAR_MP, ARG, -MAXBASE:ARG:ＭＰ, "ダメージ"
WAIT

@SKILL_EXPLAIN_祈りの願い,ARG
PRINTL 대기를 포함한 아군 전원을 소생시키고, 추가로 HP와 모든 상태이상을 완전 회복한다.
PRINTL 스킬 발동 후 모든 MP를 잃는다.
PRINTL 이 스킬은 매우 발동이 느리다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_祈りの願い,ARG
#DIM SKILL_NUM
RETURN 1

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_祈りの願い,ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT
RETURN 0
