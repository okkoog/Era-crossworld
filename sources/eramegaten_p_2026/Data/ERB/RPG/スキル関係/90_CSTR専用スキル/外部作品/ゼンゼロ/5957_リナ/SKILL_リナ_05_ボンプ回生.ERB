;　威力
@SKILL_POWER_ボンプ回生, ARG
SIF ARG < 0
	RETURN 65
CALL GET_SKILL_POWER_ボンプ回生(GET_ROLE_CFLAG_TAKEOVER(ARG, "通常スキルランク"))
RETURN RESULT

@GET_SKILL_POWER_ボンプ回生, ARG
SELECTCASE ARG
	CASE 15
		RETURN 250
	CASE 11 TO 14
		RETURN 200 + 10 * ARG 
	CASE 10
		RETURN 200
	CASE 2 TO 9
		RETURN 50 + 15 * ARG
	CASE 0, 1
		RETURN 65
	CASEELSE
		RETURN 0
ENDSELECT


