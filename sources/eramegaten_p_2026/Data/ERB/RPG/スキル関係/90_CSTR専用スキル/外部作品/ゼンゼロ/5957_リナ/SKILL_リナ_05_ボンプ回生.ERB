;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_ボンプ回生, ARG = -1, ARG:1 = -1
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "完璧主義のメイド長")
	RETURN 0, 4
ELSE
	RETURN 0, 0
ENDIF
;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_ボンプ回生,ARG,ARG:1
SIF !GET_ROLE_CFLAG_BTL(ARG, "極限回避発動")
	RETURN 0
;攻撃を受けている
SIF !GET_CREC_ACT(ARG:1, ARG, "ATTACK")
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_DAMAGETYPE", CFLAG:(ARG:1):입력행동, ARG:1
SIF !GROUPMATCH(GET_ダメージタイプ(RESULT), "物理", "魔法")
	RETURN 0
CALL PU_SKILLGAGE_H_SET, ARG, "ボンプ回生", RESULT
;反撃の対象は反撃してきたキャラ(ポジションで返す)
RETURN 1, CPOS(ARG:1)

;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_ボンプ回生, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
IF GET_ダメージタイプ(PU_SKILLGAGE_H_GET(ARG, "ボンプ回生")) == "物理"
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격", -4, "短縮"
ELSE
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "마법위력", -4, "短縮"
ENDIF

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ボンプ回生,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
TFLAG:반사0데미지화 = 1
TFLAG:흡수0데미지화 = 1
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM
TFLAG:반사0데미지화 = 0
TFLAG:흡수0데미지화 = 0
CALL SKILLGAGE_CHARGE_ROLE_ホロウエージェント, ARG, ARG
CALL SET_ROLE_CFLAG_BTL, ARG, "獲得デシベル値", RESULT

;　説明文の表示
@SKILL_EXPLAIN_ボンプ回生,ARG
PRINTL 【회피】【리나 전용 스킬】
PRINTL 극한 회피 발동 시에 이하의 연동 효과가 발동한다.
PRINTL 「공격해 온 적에 대해 전격 상성의 소데미지를 주고, 저확률로 SHOCK을 부여한다.
PRINTL  공격 성공 시, 대상이 사용한 공격 수단에 따라 공격력 혹은 마법 위력을 저하시킨다.」

@ENHANCE_SKILL_EXPLAIN_ボンプ回生,ARG
RESULTS '= "極限回避発動時に以下の連動効果が発動する。" + "<br>"
RESULTS += "「攻撃してきた敵に対して電撃相性の小ダメージを与え、低確率でSHOCKを付着する。" + "<br>"
RESULTS += " 攻撃成功時、対象の使用したスキルに応じて、攻撃力あるいは魔法威力を低下させる。」" + "<br>"

@SKILL_ACTIONABLE_BATTLE_ボンプ回生, ARG
RETURN 0

