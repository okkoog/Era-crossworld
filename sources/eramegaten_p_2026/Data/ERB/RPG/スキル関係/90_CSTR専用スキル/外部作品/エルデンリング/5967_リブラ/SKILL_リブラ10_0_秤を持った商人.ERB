RETURN 2

@INPUT_COM_NAME_LIBRA_TRADE_2, ARG = -1
RESULTS:1 '= GET_RPG_CSTR_BTL(ARG, "取引内容2")
RETURN 2

@INPUT_COM_LIBRA_TRADE_0, ARG = -1
CALL ACTION_LIBRA_TRADE, ARG, "取引内容0"

@INPUT_COM_LIBRA_TRADE_1, ARG = -1
CALL ACTION_LIBRA_TRADE, ARG, "取引内容1"

@INPUT_COM_LIBRA_TRADE_2, ARG = -1
CALL ACTION_LIBRA_TRADE, ARG, "取引内容2"

@INPUT_COM_ABLE_LIBRA_TRADE_0, ARG = -1
SIF GET_RPG_CSTR_BTL(ARG, "取引内容0") == "取引済み"
	RETURN -1
RETURN 1

@INPUT_COM_ABLE_LIBRA_TRADE_1, ARG = -1
SIF GET_RPG_CSTR_BTL(ARG, "取引内容1") == "取引済み"
	RETURN -1
RETURN 1

@INPUT_COM_ABLE_LIBRA_TRADE_2, ARG = -1
SIF GET_RPG_CSTR_BTL(ARG, "取引内容2") == "取引済み"
	RETURN -1
RETURN 1

@ACTION_LIBRA_TRADE, L_CHARA, L_TRADE
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TRADE
#DIM DYNAMIC STOCK_SKILL
#DIM DYNAMIC STOCK_TARGET
CSTR:L_CHARA:비소지스킬 '= GET_RPG_CSTR_BTL(L_CHARA, L_TRADE)
CALL INPUT_COM_DO_SKILL, L_CHARA, , , [[스킬:비소지스킬]]
IF RESULT <= 0
	CSTR:L_CHARA:비소지스킬 '= ""
ELSE
	STOCK_SKILL = CFLAG:L_CHARA:입력행동
	STOCK_TARGET = CFLAG:L_CHARA:타겟
	CFLAG:L_CHARA:입력행동 = RESULT
	CFLAG:L_CHARA:타겟 = RESULT:1
	FLAG:행동순1 = L_CHARA
	CALL PRINT_ACT_MESSAGE, FLAG:행동순1, , , , "「取引成立だ」"
	CALL BATTLE_ACTSTART, L_CHARA
	CALL BATTLE_SKILLEND, L_CHARA
	CALL BATTLE_ACTEND, L_CHARA
	FLAG:행동순1 = -1
	CSTR:L_CHARA:비소지스킬 '= ""
	CFLAG:L_CHARA:입력행동 = STOCK_SKILL
	CFLAG:L_CHARA:타겟 = STOCK_TARGET
	CALL SET_RPG_CSTR_BTL, L_CHARA, L_TRADE, "取引済み"
ENDIF

@SET_LIBRA_TRADE_TABLE, L_CHARA
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC TRADE_TABLE = "攻撃力が欲しい", "魔法威力が欲しい", "魔法効果が欲しい", "防御力が欲しい", "命中率が欲しい", "回避率が欲しい", "聖杯瓶が欲しい", "強力な武器が欲しい", "悪魔の力が欲しい", "後に大成したい", "強くなりたい", "状態異常に強くなりたい", "死を遠ざけたい", "全力で戦いたい"
SIF GET_RPG_CFLAG_BTL(L_CHARA, "取引テーブル作成ターン") == FLAG:경과턴수 + 1
	RETURN 0
CALL SET_RPG_CFLAG_BTL, L_CHARA, "取引テーブル作成ターン", FLAG:경과턴수 + 1
CALL SHUFFLE_ARRAY_STR, TRADE_TABLE
CALL SET_RPG_CSTR_BTL, L_CHARA, "取引内容0", TRADE_TABLE:0
CALL SET_RPG_CSTR_BTL, L_CHARA, "取引内容1", TRADE_TABLE:1
CALL SET_RPG_CSTR_BTL, L_CHARA, "取引内容2", TRADE_TABLE:2

@リンク不能_秤を持った商人
RETURN 1