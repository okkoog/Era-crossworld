@ACTION_悦楽（永久人形）,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

IF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"悦楽（永久人形）")) == 0
	PRINTFORML %CALLNAME:ARG%의 물리 공격 데미지, 회피력이 상승!
	CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"悦楽（永久人形）"),4
ELSE
	PRINTFORML 悦楽　　＞　　효과가 없었다！
ENDIF



