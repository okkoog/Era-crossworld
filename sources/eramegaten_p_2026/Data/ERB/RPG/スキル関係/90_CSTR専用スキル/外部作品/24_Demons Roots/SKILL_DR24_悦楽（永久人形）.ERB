;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_悦楽（永久人形）,ARG
IF PU_SKILLGAGE_D_GET(ARG,"悦楽（永久人形）") != 0
	RESULTS = 悦楽（永久人形）：{PU_SKILLGAGE_D_GET(ARG,"悦楽（永久人形）")}Ｔ
	RETURN 3
ENDIF
;ターン開始時処理
@SKILL_TURNSTART_悦楽（永久人形）,ARG,ARG:1


@SKILL_PASSIVE_BTL_EFFECT_悦楽（永久人形）, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

IF SKILLGAGE_D_GET(L_P,PU_SKILLNUM_GET(L_P,"悦楽（永久人形）")) > 0
	;自分が攻撃側
	IF L_P == L_ACTOR
		SELECTCASE ARGS
			;気合などと加算の枠。他に下限要素がなければ100%±X%になる
			CASE "ダメージ補正加算"
				SIF L_ダメージタイプ == "物理"
					RETURN 30
			CASE "追加命中強化"
				RETURN 8
		ENDSELECT
	;自分は防御側
	ELSE
		SELECTCASE ARGS
			;回避強化を計算する時、通常の数値に追加でこの数値が合算される
			;この補正を999以上で指定した場合は回避不能、-999以下で指定した場合は絶対回避となる
			CASE "追加回避強化"
				RETURN 8
		ENDSELECT
	ENDIF
ENDIF
RETURN 0

