
;スキル名
@SKILL_NAME_オイリーアロー,ARG
RESULTS = オイリーアロー

;　명중
@SKILL_HITRATE_オイリーアロー, ARG
RETURN 100

;　威力
@SKILL_POWER_オイリーアロー, ARG
RETURN 100

;クリティカル率
@SKILL_CRITICAL_RATE_オイリーアロー, ARG
RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_オイリーアロー,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_オイリーアロー,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_オイリーアロー, ARG
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_オイリーアロー,ARG
RETURN 30

;　相性
@SKILL_TYPE_オイリーアロー,ARG
RETURN GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_オイリーアロー
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_オイリーアロー,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_オイリーアロー,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_オイリーアロー,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_オイリーアロー,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_オイリーアロー,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_オイリーアロー
RETURN GET_SUCCESSION_NUM("비구")

@SKILL_RANK_オイリーアロー, ARG = -1
RETURN 6

;속도보정
@SKILL_SPEED_オイリーアロー, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_オイリーアロー
RETURN 0

;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_オイリーアロー,ARG,ARG:1,ARG:2
SIF ARG:1 < 0
	RETURN 0
SIF ARG:2 < -1
	RETURN 0
CALL SKILL_GUARD_KILL, ARG, "화염", CPOS(ARG:1), 3, "短縮"
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_オイリーアロー,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_オイリーアロー,ARG
PRINTL 敵単体に飛具ダメージを与える。
PRINTL 成功すると、対象の火炎属性を3ターンの間無効化する。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_オイリーアロー,ARG
RETURN 1
