;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_バレルヒート,ARG,ARG:1
SIF ARG != ARG:1
	RETURN 0
IF IS_PU_SKILL_入力行動(ARG, "オーバーヒート") || IS_PU_SKILL_入力行動(ARG, "オーバーヒート★")
	CALL PU_SKILLGAGE_H_SET, ARG, "バレルヒート", 0
	RESULTS:2 = バレルヒート：≪リセット≫
	RETURN 1
ELSE
	SIF PU_SKILLGAGE_H_GET(ARG, "バレルヒート") == 5
		RETURN 0
	CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
	SIF GET_SKILL_EFFECT(RESULT) != "공격"
		RETURN 0
	CALL PU_SKILLGAGE_H_ADD, ARG, "バレルヒート", 1
	RESULTS:2 = バレルヒート：≪与ダメージと被ダメージ↑≫
	RETURN 1
ENDIF

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_バレルヒート,ARG
#DIM SKILL_NUM
PRINTL 자동 발동: 공격 스킬을 사용할 때마다 이하의 효과가 발동한다.
PRINTL 　　　　　가하는 데미지와 받는 데미지가 증가한다.

@SKILL_BATTLE_MAIN_TOOLTIP_バレルヒート, ARG, ARG:1
IF PU_SKILLGAGE_H_GET(ARG,"バレルヒート") > 0
	RESULTS = □배럴 히트
	RESULTS:1 '= "　与ダメージ＋" + TOFULL(TOSTR(PU_SKILLGAGE_H_GET(ARG,"バレルヒート") * 10)) + "\%"
	RESULTS:2 '= "　被ダメージ＋" + TOFULL(TOSTR(PU_SKILLGAGE_H_GET(ARG,"バレルヒート") * 10)) + "\%"
ENDIF
;使用条件
@SKILL_SPECIAL_ACTIONABLE_バレルヒート,ARG
RETURN 0
;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_バレルヒート, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			SIF IS_PU_SKILL_入力行動(L_P, "オーバーヒート") || IS_PU_SKILL_入力行動(L_P, "オーバーヒート★")
				RETURN 30 * PU_SKILLGAGE_H_GET(L_P, "バレルヒート")
			RETURN 10 * PU_SKILLGAGE_H_GET(L_P, "バレルヒート")
	ENDSELECT
;自分が防御側
ELSE
	SELECTCASE ARGS
		CASE "ダメージ倍率"
			RETURN 10 * SKILLGAGE_H_GET(L_P, SKILL_NUM)
	ENDSELECT
ENDIF
RETURN 0
