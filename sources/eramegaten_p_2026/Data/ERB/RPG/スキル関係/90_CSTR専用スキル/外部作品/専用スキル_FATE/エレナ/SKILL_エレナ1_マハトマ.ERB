;ターン開始時に行う処理
@SKILL_TURNSTART_マハトマ,ARG
#DIM SKILL_NUM

;戦闘に参加していない or 死んでいるなら発動しない
SIF CFLAG:ARG:포지션 < 1 || GET_STATE(CFLAG:ARG:상태이상) == "DYING"
	RETURN 0

SKILL_NUM = PU_SKILLNUM_GET(ARG,"マハトマ")

;未発動 or 発動から5ターン経過済みだと終了
SIF SKILLGAGE_D_GET(ARG,SKILL_NUM) == 0 || SKILLGAGE_D_GET(ARG,SKILL_NUM) < (GETBIT(GET_RPG_CFLAG_TAKEOVER(ARG,"鯖強化フラグ"),1) ? 2 # 4)
	RETURN 0

SETCOLOR COLOR("YELLOW")
PRINTFORMW 마하트마의 힘이 \@ CFLAG:ARG:PT플래그 == 0 ? 적 # 아군 \@(을)를 인도한다…!
RESETCOLOR
CALL SKILL_SET_カジャンダ,ARG,CFLAG:ARG:PT플래그 == 0 ? 22 # 19,"크리티컬",4,"範囲"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_マハトマ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM,2
SKILL_NUM:0 = PU_SKILLNUM_GET(ARG,"マハトマ")
SKILL_NUM:1 = PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")

CALL SKILL_SET_カジャンダ,ARG,ARG:1,"크리티컬",4,"範囲","NOWAIT"
SIF SKILLGAGE_D_GET(ARG,SKILL_NUM:0) > 0
	GOTO SKIP_LABEL
;このタイミングで確率強化フラグをリセットしておく
CALL SKILLGAGE_H_SET(ARG,SKILL_NUM,0)
CALL SKILLGAGE_D_SET(ARG,SKILL_NUM:0,GETBIT(GET_RPG_CFLAG_TAKEOVER(ARG,"鯖強化フラグ"),1) ? 4 # 6)
PRINTL
PRINTL 매 턴, 아군의 크리티컬률이 조금 상승!
IF GETBIT(GET_RPG_CFLAG_TAKEOVER(ARG,"鯖強化フラグ"),1)
	PRINTFORML %CALLNAME:ARG%의 NP 게이지가 충전되었다!
	SIF SKILLGAGE_F_GET(ARG,SKILL_NUM:1) < 100
		CALL SKILLGAGE_F_ADD(ARG,SKILL_NUM:1,30)
ENDIF
SIF RAND:100 + 1 > 40 + MAXBASE:ARG:운 / 3
	GOTO SKIP_LABEL
CALL SKILLGAGE_H_SET(ARG,SKILL_NUM:0,1)
PRINTFORML 다음 턴에 한해 %CALLNAME:ARG%의 마법 공격 위력이 상승!
$SKIP_LABEL
WAIT

;CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
;CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
;CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM;		拡散攻撃
;CALL ATTACK_RAND,ARG,ARG:1,SKILL_NUM;			ランダム攻撃


