;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_マハトマ,ARG
#DIM SKILL_NUM
#DIM LCOUNT
SKILL_NUM = PU_SKILLNUM_GET(ARG,"マハトマ")
LCOUNT = GETBIT(GET_RPG_CFLAG_TAKEOVER(ARG,"鯖強化フラグ"),1) ? 1 # 3
IF SKILLGAGE_D_GET(ARG,SKILL_NUM) > 0
	IF SKILLGAGE_D_GET(ARG,SKILL_NUM) > LCOUNT
		RESULTS = 마하트마:효과 종료
	ELSE
		RESULTS = 마하트마:CT{SKILLGAGE_D_GET(ARG,SKILL_NUM) - (SKILLGAGE_D_GET(ARG,SKILL_NUM) > LCOUNT ? LCOUNT # 0 )}
	ENDIF
	RETURN 3
ENDIF
;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_マハトマ, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;一応大丈夫だとは思うけど、念のために番号を再取得
SKILL_NUM = PU_SKILLNUM_GET(L_P,"マハトマ")

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		CASE "ダメージ補正加算"
			;確率強化のフラグが立っている && 効果発動から次のターンになっている場合（指定されるターンは鯖強化フラグに応じて変動する）
			IF SKILLGAGE_H_GET(L_P,SKILL_NUM) == 1 && SKILLGAGE_D_GET(L_P,SKILL_NUM) == (GETBIT(GET_RPG_CFLAG_TAKEOVER(L_P,"鯖強化フラグ"),1) ? 3 # 5)
				SIF L_ダメージタイプ == "魔法"
					RETURN 150
			ENDIF
	ENDSELECT
ENDIF
RETURN 0

;　説明文の表示
@SKILL_EXPLAIN_マハトマ,ARG
#DIM LCOUNT
PRINTL 아군 전체의 크리티컬 부여율을 상승시킨다  시간 경과로 효과가 옅어진다
FOR LCOUNT,1,4
	SETCOLOR ARG > -1 && SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"マハトマ")) > 0 ? COLOR("GRAY") # COLOR("YELLOW")
	IF LCOUNT == 3 && (ARG < 0 || !GETBIT(GET_RPG_CFLAG_TAKEOVER(ARG,"鯖強化フラグ"),1))
		RESETCOLOR
		BREAK
	ENDIF
	PRINTFORM 追加{LCOUNT}
	RESETCOLOR
	SELECTCASE LCOUNT
		CASE 1
			PRINTL : 5턴 동안 턴 개시 시 아군 전체의 크리티컬률을 상승시키는 상태가 된다
		CASE 2
			PRINTL : 확률로 다음 턴에 한해 자신의 마법 공격 위력이 상승한다  운이 높을수록 성공하기 쉬우며, 효과는 집중과 합산된다
		CASE 3
			PRINTL : 추가 효과 3: 자신의 NP 게이지를 30% 충전한다
	ENDSELECT
NEXT
PRINTL
PRINTL 추가 효과를 발동했을 때 전투 종료 또는 규정 수의 턴이 경과할 때까지 추가 효과는 발동하지 않는다
PRINTL
PRINTL 고차원의 존재인 「마하트마」들의 힘을 빌려, 강대한 마력을 다루는 스킬
PRINTL 행운과 우연의 도움이 필요하지만, 성공하기만 하면 수많은 상이한 마술 기반의 병렬 조작조차 가능하다고 한다

