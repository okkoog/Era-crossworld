;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_ノウブル・ファンタズム,ARG,ARG:1
#LOCALSIZE 2
#DIM LCOUNT
#DIM L_T
#DIM SKILL_NUM
#DIM L_GP
#DIM L_相性
SKILL_NUM = PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")
L_GP = 0
SIF SKILLGAGE_F_GET(ARG, SKILL_NUM) == 100
	RETURN 0
IF ARG == ARG:1
	;---- EDIT 007 ADD START ---------------------------
	CALL GET_SKILL_PROP, "SKILL_TYPE", CFLAG:ARG:입력행동, ARG
	L_相性 = RESULT
	;---- EDIT 007 ADD END ---------------------------
	FOR LCOUNT, 0, BCHARANUM
		L_T = BCHARA:LCOUNT
		;味方同士の攻撃では蓄積しない
		SIF IS_FRIEND(ARG, L_T)
			CONTINUE
		;攻撃をあてている必要がある
		SIF !GET_CREC_ACT(ARG, L_T, "HIT")
			CONTINUE
		;攻撃をHITさせている場合、5獲得
		L_GP += 5
		IF CFLAG:L_T:피탄횟수 > 1
			IF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG, "黒龍双剋勝利剣")
				IF GET_CREC_ACT(ARG, L_T, "KILL")
					L_GP += (5*CFLAG:L_T:피탄횟수)
				ELSE
					L_GP += (3*CFLAG:L_T:피탄횟수)
				ENDIF
			ELSEIF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG,"無銘勝利剣")
				IF GET_CREC_ACT(ARG, L_T, "KILL")
					L_GP += (5*CFLAG:L_T:피탄횟수)
				ELSE
					L_GP += (2*CFLAG:L_T:피탄횟수)
				ENDIF
			;---- EDIT 007 ADD START ---------------------------
			ELSEIF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG,"金星神・火炎天主")
				IF GET_CREC_ACT(ARG, L_T, "KILL")
					L_GP += (5*CFLAG:L_T:피탄횟수)
				ELSE
					L_GP += (2*CFLAG:L_T:피탄횟수)
				ENDIF
			;---- EDIT 007 ADD END ---------------------------
			;---- EDIT 008 ADD START ---------------------------
			ELSEIF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG,"今は知らず、無垢なる湖光")
				;騎士形態中に限り、宝具による攻撃でNPを回収できる
				IF !GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ")
					IF GET_CREC_ACT(ARG, L_T, "KILL")
						L_GP += (8*CFLAG:L_T:피탄횟수)
					ELSE
						L_GP += (5*CFLAG:L_T:피탄횟수)
					ENDIF
				ELSE
					L_GP = 0
				ENDIF
			;---- EDIT 008 ADD END   ---------------------------
			;---- EDIT 009 ADD START ---------------------------
			ELSEIF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG,"銃神・八咫烏")
				IF GET_CREC_ACT(ARG, L_T, "KILL")
					L_GP += (5*CFLAG:L_T:피탄횟수)
				ELSE
					L_GP += (3*CFLAG:L_T:피탄횟수)
				ENDIF
			;---- EDIT 009 ADD END   ---------------------------
			ELSE
				L_GP += (5*CFLAG:L_T:피탄횟수)
			ENDIF
		ENDIF
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 10
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 10
		;---- EDIT 007 ADD START ---------------------------
		CALL AUTO_PU_SKILL_未知への探求,ARG,"NP回収増加",LCOUNT,L_相性
		L_GP += (RESULT*CFLAG:L_T:피탄횟수)
		;---- EDIT 007 ADD END ---------------------------
	NEXT
	;挑発をしても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:도발]]
		L_GP += 25
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += MAX(60 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ, 2)
;---- EDIT 008 ADD START -----------------------------
RESULT = 0,0
CALL TRY_NP_CHARGE(ARG)
L_GP = (L_GP * (100 + RESULT:0) / 100) + RESULT:1
;---- EDIT 008 ADD END -----------------------------
;	LOCAL = LOCAL < 2 ? 2 # LOCAL
;ENDIF
;スキルゲージが100以上だと100にする
CALL SKILLGAGE_F_SET,ARG, SKILL_NUM, LIMIT(SKILLGAGE_F_GET(ARG, SKILL_NUM) + L_GP, 0, 100)
;SIF SKILLGAGE_F_GET(L_P,SKILL_NUM) > 100
;	CALL SKILLGAGE_F_SET,L_P,SKILL_NUM,100
IF SKILLGAGE_F_GET(ARG, SKILL_NUM) == 100
	RESULTS = 魔力蓄積完了
	RESULT:1 = 0x33ffcc
ELSE
	RESULTS = NP
ENDIF
RESULTS:1 = \%
RETURN L_GP
