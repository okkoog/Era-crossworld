;スキル・固有キャラが持つNP獲得量変動をまとめて返す関数
@TRY_NP_CHARGE,ARG
#DIM LCOUNT
#DIM L_NP補正,2

;L_NP補正:0 乗算 攻撃や被弾などで獲得する基本値に補正を掛ける（攻撃のみ、被弾のみの限定的な獲得量変動は搭載されていない。たぶん後になったら作るかも）
;L_NP補正:1 加算 行動後に特定の値分変動したい時に使う

VARSET L_NP補正,0
FOR LCOUNT,0,TRYSKILLNUM(ARG)
	VARSET RESULT,0,0,2
	TRYCCALLFORM NP_CHARGE_%GET_TRYSKILL(ARG, LCOUNT)%,ARG,TRYSKILL_VAR
		L_NP補正:0 += RESULT:0
		L_NP補正:1 += RESULT:1
	CATCH
	ENDCATCH
NEXT
RETURN L_NP補正:0,L_NP補正:1
