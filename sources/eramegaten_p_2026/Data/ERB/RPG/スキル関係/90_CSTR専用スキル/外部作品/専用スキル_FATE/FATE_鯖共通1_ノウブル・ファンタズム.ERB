	RESULTS += SET_COLOR_TAG("★", TOSTR(0xdc143c))
	RESULTS += HTML_RECT_SPLIT_BAR(PU_SKILLGAGE_D_GET(ARG, "ノウブル・ファンタズム"), 5, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("赤"), RESULT:1)
	RESULTS:1 = 魔力開放中
ELSE
	IF PU_SKILLGAGE_F_GET(ARG, "ノウブル・ファンタズム") == 100
		RESULTS += SET_COLOR_TAG("★", TOSTR(0xdc143c))
		RESULTS += SET_COLOR_TAG(@"%" Ready", SKILL_EX_DISPLAY_LENS - 2, LEFT%", TOSTR(0xdc143c))
		RESULTS:1 = 魔力放出
	ELSE
		RESULTS += SET_COLOR_TAG("★", TOSTR(0xdc143c))
		;0xe68a1b,0x38383fが理想値だったけどBARCOLORSETの黄色で代用
		RESULTS += HTML_RECT_BAR(PU_SKILLGAGE_F_GET(ARG, "ノウブル・ファンタズム"), 100, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("黄"), RESULT:1)
		RESULTS:1 = NP 게이지
	ENDIF
ENDIF
RETURN 1

