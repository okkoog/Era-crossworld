;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ブラッドリアクト, ARG, ARG:1, ARG:2
;効果時間は5ターン
CALL PU_SKILLGAGE_D_SET, ARG, "ブラッドリアクト", 5
PRINTFORMW %CALLNAME:ARG%(은)는 5턴 동안 방어력 저하에 반응해 추가 공격을 실행하게 되었다!

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_ブラッドリアクト,ARG,ARG:1
SIF TFLAG:스킬트리거용1
	RETURN 0
;自分じゃなければNG
SIF FLAG:행동순1 != ARG
	RETURN 0
;スキルとして起動している必要がある。
SIF !PU_SKILLGAGE_D_GET(ARG, "ブラッドリアクト")
	RETURN 0
SIF !GET_CREC_ACT(ARG, ARG:1, "HIT")
	RETURN 0
;防御力低下が必要
SIF CFLAG:(ARG:1):방어강화 >= 0
	RETURN 0
;判定が通ったことを記録しておく
TFLAG:스킬트리거용1 = 1
IF RAND:2
	RESULTS '= "血の匂いを嗅ぎ分ける"
	RETURN 1, CPOS(ARG)
ELSE
	RESULTS '= "力溜め"
	RETURN 1, CPOS(ARG)
ENDIF
;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_ブラッドリアクト, ARG
PRINTL 스킬 사용 후 공격을 성공시켰을 때 적의 방어력이 저하되어 있을 경우 이하의 연동효과가 발동하는 상태가 된다.
PRINTL 「특정 스킬을 발동시킨다.」

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ブラッドリアクト,ARG
RETURN 1
;とくにない

