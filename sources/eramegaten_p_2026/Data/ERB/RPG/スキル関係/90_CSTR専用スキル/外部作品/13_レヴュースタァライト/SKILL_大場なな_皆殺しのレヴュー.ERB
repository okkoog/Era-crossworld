;@SKILLGAGE_CHARGE_皆殺しのレヴュー,ARG,ARG:1
;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;
;悪魔変身にしているときに自分の行動後
;====================================================
@SKILL_TRIGGER_ACTIONABLE_皆殺しのレヴュー,ARG,ARG:1
#DIM 大場イニオ
大場イニオ = PU_SKILLNUM_GET(ARG, "皆殺しのレヴュー")
SIF FLAG:행동순1 != ARG
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
RETURN 1 

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_皆殺しのレヴュー,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

IF FLAG:총공격중
	CALL SKILL_能力低下解除, ARG, 23, "範囲", "NOMES"
	CALL SKILL_能力上昇解除, ARG, 23, "範囲", "NOMES"
	PRINTFORMW ＞%CALLNAME:ARG%의 반짝임으로 적아군 전체의 카자계·ندا계 효과가 해제되었다.
ELSE
	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM
ENDIF
