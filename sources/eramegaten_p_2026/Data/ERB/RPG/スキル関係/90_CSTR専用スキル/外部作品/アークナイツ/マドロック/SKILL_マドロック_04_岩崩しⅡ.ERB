;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_岩崩しⅡ
RETURN 0

@継承不能_岩崩しⅡ
RETURN 2

;拡散攻撃用追加処理
@SKILL_SPREAD_岩崩しⅡ,ARG
RETURN 1

;====================================================
;トリガー発動条件
;====================================================
@SKILL_TRIGGER_ACTIONABLE_岩崩しⅡ,ARG,ARG:1
;自身の行動のみで判定
SIF FLAG:행동순1 != ARG
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
SIF !IS_PU_SKILL_入力行動(ARG, "岩崩しⅡ")
	RETURN 0
CALL SET_RPG_CFLAG_BTL, ARG, "岩崩しヒット数", GET_CREC_ACT_SUM(ARG, "적", "HIT")
SIF !GET_RPG_CFLAG_BTL(ARG, "岩崩しヒット数")
	RETURN 0
RETURN 1, CPOS(ARG)
;====================================================
;スキルの貫通強度
;0 - 貫通なし
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;RETURNを増やすことで準貫通も対応。上記と同じだがこちらはダメージ半減。
;====================================================
;貫通なし、反射準貫通
@SKILL_PENETRATION_RANK_岩崩しⅡ, ARG = -1, ARG:1 = -1
RETURN 0, 4

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_岩崩しⅡ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
IF FLAG:총공격중
	CALL HEAL_SINGLE,ARG,ARG,SKILL_NUM
ELSE
	CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM;	単体攻撃
ENDIF
;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_岩崩しⅡ,ARG
PRINTL 적 1체와 그 주위의 적에게 지변 상성의 물리 대데미지를 준다.
PRINTL 이 공격은 모든 지변 내성을 관통한다. 단 관통 시 가하는 데미지는 반감된다.
PRINTL 공격이 성공했을 경우, 이하의 연동 효과가 발동한다.
PRINTL 「자신의 HP를 대위력으로 회복. 회복량은 공격력을 참조한다.」

@SKILL_EXPLAIN_TOOLTIP_岩崩しⅡ, ARG
RESULTS:0 = 적 1체와 그 주위의 적에게 지변 상성의 물리 대데미지를 준다.
RESULTS:1 = 이 공격은 모든 지변 내성을 관통한다. 단 관통 시 가하는 데미지는 반감된다.
RESULTS:2 = 攻撃が成功した場合、以下の連動効果が発動する。
RESULTS:3 = 「自身のＨＰを大威力で回復。回復量は攻撃力を参照する。」

;使用条件
@SKILL_SPECIAL_ACTIONABLE_岩崩しⅡ,ARG
RETURN 1
