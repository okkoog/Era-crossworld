;スキル名
@SKILL_NAME_岩崩しⅡ,ARG
IF FLAG:총공격중
	RESULTS = 野外生存
ELSE
	RESULTS = 바위 가르기 Ⅱ
ENDIF
;　명중
@SKILL_HITRATE_岩崩しⅡ, ARG
RETURN 100

;　威力
@SKILL_POWER_岩崩しⅡ, ARG
IF FLAG:총공격중
	RETURN 200
ELSE
	RETURN 320
ENDIF
;クリティカル率
;@SKILL_CRITICAL_RATE_岩崩しⅡ, ARG
;RETURN 5

@SKILL_CALC_BATTTLE_STATUS_岩崩しⅡ, ARGS, ARG, ARG:1
SIF ARG < 0
	RETURN 0
SELECTCASE ARGS
	;回復の魔法効果(影響大),마법위력(影響小)の2変数を置換する
	;攻撃のみ参照
	CASE "HEAL"
		RETURN MAXBASE:ARG:공격, MAXBASE:ARG:공격
ENDSELECT

;　최저공격횟수
@SKILL_MINATTACKNUMBER_岩崩しⅡ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_岩崩しⅡ,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_岩崩しⅡ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_岩崩しⅡ,ARG
RETURN 21

;　相性
@SKILL_TYPE_岩崩しⅡ,ARG
RETURN GET_TYPE_NUM("지변")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_岩崩しⅡ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_岩崩しⅡ,ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_岩崩しⅡ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_岩崩しⅡ,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_岩崩しⅡ,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_岩崩しⅡ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

@SKILL_HEAL_TYPE_岩崩しⅡ, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("통상")

;속도보정
@SKILL_SPEED_岩崩しⅡ, ARG = -1
