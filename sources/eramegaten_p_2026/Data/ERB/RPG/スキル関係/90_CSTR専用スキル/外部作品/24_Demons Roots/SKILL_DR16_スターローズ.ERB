;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_スターローズ,ARG,ARG:1,SKILL_NUM
#DIM DYNAMIC SKILL_NUM
#DIM DYNAMIC LCOUNT
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	TSTR:스킬메시지추가효과 '= ""
	CALL CURE_STATE_SINGLE,ARG,POS(LCOUNT),SKILL_NUM,0,1,1
	IF RESULT
		TSTR:스킬메시지추가효과 '= RESULTS + " & "
		CALL SKILL_INVALID_WALL, ARG, POS(LCOUNT), "성스러운가호", "短縮"
		CALL PRINT_HIT_MESSAGE, ARG, TSTR:스킬메시지추가효과, "L"
	ELSE
		CALL SKILL_INVALID_WALL, ARG, POS(LCOUNT), "성스러운가호", "단체", "NOWAIT"
	ENDIF
NEXT
;Dゲージ５。使用後４ターン。
CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"スターローズ"),5
WAIT

;　説明文の表示
@SKILL_EXPLAIN_スターローズ,ARG
PRINTL 『스타 로즈』
PRINTL 아군 전원의 ORGY, HEAT, FLY, DYING 이외의 모든 상태이상을 회복하고, 추가로 상태이상 방벽을 부여한다.
PRINTL 쿨타임: 4턴.
PRINTL 
PRINTL 결정이라 칭해지는 미지의 기술을 동료를 지키기 위해 행사한다. 동료들에게 유대의 결정을 부여하는 스킬.
PRINTL 환경 차이 때문인지 단기간에 연속 사용은 불가능한 모양.
PRINTL 살인귀 릴리킬러의 특수 기능(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_スターローズ,ARG
RESULTS = 쿨타임:%TOFULL(TOSTR(PU_SKILLGAGE_D_GET(ARG,"スターローズ")))%턴
SIF PU_SKILLGAGE_D_GET(ARG,"スターローズ") != 0
	RETURN 0
RETURN 1

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_スターローズ,ARG
#DIM USE_CHARA
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT
