;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_俺の後ろに隠れろ,ARG,ARG:1,ARG:2
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_T
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	IF ARG == L_T
		CFLAG:L_T:피타겟비율변동지속턴수 = 3
		CFLAG:L_T:변동피타겟율 = 300
		CALL PRINT_HIT_MESSAGE, L_T, "3ターンの間、敵に狙われやすくなった！", "L"
	ELSE
		CALL SKILL_INVALID_WALL, ARG, L_T, "수호의방패", "단체", "NOWAIT"
	ENDIF
NEXT
WAIT
;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_俺の後ろに隠れろ,ARG
PRINTL 자신을 제외한 아군 전체에 만능 상성 이외의 공격을 1회 막는 방벽을 부여하고,
PRINTL 추가로 3턴 동안 자신을 적에게 표적이 되기 쉬운 상태로 만든다.

