@ACTION_ブラッディメイス,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM メイス起動フラグ
メイス起動フラグ = PU_SKILLNUM_GET(ARG,"ブラッディメイス")

LOCAL = MIN(500, MAXBASE:ARG:ＭＰ / 2)

CALL SKILLGAGE_H_SET,ARG,メイス起動フラグ,LOCAL

PRINTFORML %CALLNAME:ARG% 은(는) 생글거리는 미소와 함께 무기를 굳게 쥐었다!
;PRINTFORML アイアンメイデン攻撃力強化量：{SKILLGAGE_H_GET(ARG,メイス起動フラグ)}

LOCAL = 0


