;　威力
@SKILL_POWER_幻想の鉄処女, ARG
#DIM L_T
SIF ARG < 0
	RETURN 400
SIF !INRANGE(CFLAG:ARG:타겟, 1, 16)
	RETURN 400
L_T = POS(CFLAG:ARG:타겟)
SIF L_T < 0
	RETURN 400
SIF TALENT:L_T:남자 || TALENT:L_T:오토코노코
	RETURN 400
IF TALENT:L_T:처녀
	RETURN 800
ELSE
	RETURN 600
ENDIF

