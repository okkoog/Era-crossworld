;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_幻想の鉄処女,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

SIF !IS_MALE(POS(ARG:1))
	PRINTFORML ＞대상은 여성! 데미지 증가!
SIF TALENT:POS(ARG:1):처녀
	PRINTFORML ＞대상은 처녀! 데미지 증가!

;CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM
CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
;CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
;CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM;		拡散攻撃
;CALL ATTACK_RAND,ARG,ARG:1,SKILL_NUM;			ランダム攻撃

IF BASE:ARG:ＨＰ >= MAXBASE:ARG:ＨＰ
ELSE
	BASE:ARG:ＨＰ += MAXBASE:ARG:ＨＰ/10
		SIF BASE:ARG:ＨＰ > MAXBASE:ARG:ＨＰ
			BASE:ARG:ＨＰ = MAXBASE:ARG:ＨＰ
ENDIF
;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 4)
CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 4, "단체", "NOMES"
PRINTFORMW ＞【환상의 철처녀】 효과로 %CALLNAME:ARG%의 HP가 회복되고 공격력이 올랐다!

CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"),0
CALL SKILLGAGE_F_SET,ARG,PU_SKILLNUM_GET(ARG,"幻想の鉄処女"),0

;====================================================
;実行内容ここまで
;====================================================






;　説明文の表示
@SKILL_EXPLAIN_幻想の鉄処女,ARG
PRINTL 『환상의 철처녀(팬텀 메이든)』
PRINTFORML %CALLNAME:ARG%(이)가 소환하는 거대한 고문기구, 철의 처녀(아이언 메이든).
PRINTL 
PRINTL 적 단체에 주살+검격 복합 특대 데미지를 가한다.
PRINTL 대상이 여성일 경우 주는 데미지 증가. 처녀일 경우 더욱 주는 데미지가 증가한다.
PRINTL 공격 후 자신의 HP를 최대 HP의 10% 회복하고, 공격력도 올린다.


;使用条件
@SKILL_SPECIAL_ACTIONABLE_幻想の鉄処女,ARG
SIF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")) == 0
	RETURN 0
RETURN 1

