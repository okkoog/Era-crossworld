;-------------------------------------------------
;COOP連動スキルの判定
;戻り値は発動率。また、COOP連動効果は常にひとつしか発動しない。
;-------------------------------------------------
@SKILL_JUDGE_EXTRA_COOP_激励鼓舞, L_CHARA, L_OPT = "参加"
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_OPT;参加or発動
SIF L_OPT != "参加"
	RETURN 0
RETURN 100

@SKILL_ACTION_EXTRA_COOP_激励鼓舞, L_CHARA
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_TARGET
#DIM DYNAMIC STOCK_HP
FOR LCOUNT, 1, 7
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	SIF STOCK_HP > (MAXBASE:POS(LCOUNT):ＨＰ - BASE:POS(LCOUNT):ＨＰ)
		CONTINUE
	STOCK_HP = MAXBASE:POS(LCOUNT):ＨＰ - BASE:POS(LCOUNT):ＨＰ
	L_TARGET = LCOUNT
NEXT
CALL HEAL_SINGLE, L_CHARA, POS(L_TARGET), PU_SKILLNUM_GET(L_CHARA, "激励鼓舞")


