;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_静寂に帰す, ARG = -1, ARG:1 = -1
;会心の覇気状態の時、貫通になる。
SIF (CFLAG:ARG:집중플래그 > 0 || CFLAG:ARG:회심의패기플래그 > 0)
	RETURN 4
	;確実にダメージを通す
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_静寂に帰す,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM

CFLAG:ARG:피타겟비율변동지속턴수 = 3
CFLAG:ARG:변동피타겟율 = 300
PRINTFORML 3턴 동안 적에게 표적이 되기 쉬워졌다!
	CALL PU_SKILLGAGE_F_SET, ARG, "静寂に帰す",4
	PRINTFORML 재사용까지 3턴!

;====================================================
;ターン終了時に行う処理
;====================================================
@SKILL_TURNEND_静寂に帰す,ARG
;CT1ターン減
SIF PU_SKILLGAGE_F_GET(ARG,"静寂に帰す") > 0
  CALL PU_SKILLGAGE_F_ADD, ARG, "静寂に帰す",-1

;====================================================
;戦闘終了時に行う処理
;====================================================
@SKILL_BATTLE_END_静寂に帰す,ARG
;CT1ターン減
SIF PU_SKILLGAGE_F_GET(ARG,"静寂に帰す") > 0
  CALL PU_SKILLGAGE_F_ADD, ARG, "静寂に帰す",-1

;====================================================
;実行内容ここまで
;====================================================
@SKILL_EX_DISPLAY_静寂に帰す, ARG, ARGS
RESULTS '= ""
IF PU_SKILLGAGE_F_GET(ARG,"静寂に帰す") == 0
	IF INPUTABLE_CHARA_F(ARG)
		RESULTS '= SET_BUTTON_TAG(SET_COLOR_TAG(@"%"∇静寂に帰す", SKILL_EX_DISPLAY_LENS - 10, LEFT%", "パ緑"), ARGS)
		IF IS_PU_SKILL_入力行動(ARG, "静寂に帰す") && !CFLAG:ARG:방어플래그
			RESULTS += SET_BUTTON_TAG(SET_COLOR_TAG(@"[ Set ]", "パ緑"), @"INPUT/SKILL/{ARG}/{PU_SKILLNUM_GET(ARG, "静寂に帰す")}", @"静寂に帰すを使用予定")
		ELSE
			RESULTS += SET_BUTTON_TAG(SET_COLOR_TAG(@"[Ready]", "パ緑"), @"INPUT/SKILL/{ARG}/{PU_SKILLNUM_GET(ARG, "静寂に帰す")}", @"静寂に帰すを使用")
		ENDIF
	ELSE
		RESULTS '= SET_BUTTON_TAG(SET_COLOR_TAG(@"%"∇静寂に帰す", SKILL_EX_DISPLAY_LENS - 10, LEFT%", "gray"), ARGS)
		RESULTS += SET_BUTTON_TAG(SET_COLOR_TAG(@"[Ready]", "gray"), , @"행동불능")
	ENDIF
ELSE
	RESULTS += @"%"∇静寂に帰す", SKILL_EX_DISPLAY_LENS - 9, LEFT%%HTML_ESCAPE(@"<CT:0{PU_SKILLGAGE_F_GET(ARG,"静寂に帰す")}>")%"
ENDIF
RESULTS:1 = ∇적막으로의 회귀
RETURN 1

