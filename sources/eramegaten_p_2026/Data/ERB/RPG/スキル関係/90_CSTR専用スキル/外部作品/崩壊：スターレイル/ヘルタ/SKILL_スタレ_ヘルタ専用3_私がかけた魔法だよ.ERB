;ヘルタ専用スキル。氷結全体魔法。これは特に貫通しない。
;原作では必殺技。これ発動後に誰も私を裏切れないが発動して魔のドナムが自分に付くので貫通は無し。

;スキル名
@SKILL_NAME_私がかけた魔法だよ,ARG
RESULTS = 내가 건 마법이야

;　명중
@SKILL_HITRATE_私がかけた魔法だよ, ARG
RETURN 100

;　威力(通常攻撃を100%とした倍率となる)
@SKILL_POWER_私がかけた魔法だよ, ARG
IF ARG >= 0
	SIF HAVE_PU_SKILL(ARG, "欠点掴んで罵り倒す")
		RETURN 420
	SIF HAVE_PU_SKILL(ARG, "面子は徹底的に潰す")
		RETURN 320
	SIF HAVE_PU_SKILL(ARG, "私はこういう女なの")
		RETURN 160
ENDIF
RETURN 110

;基礎クリティカル率(標準は5。乗算されるので10になると200%になる)
;@SKILL_CRITICAL_RATE_私がかけた魔法だよ, ARG
;RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_私がかけた魔法だよ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_私がかけた魔法だよ,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_私がかけた魔法だよ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_私がかけた魔法だよ,ARG
IF ARG >= 0
	SIF HAVE_PU_SKILL(ARG, "欠点掴んで罵り倒す")
		RETURN 50
	SIF HAVE_PU_SKILL(ARG, "面子は徹底的に潰す")
		RETURN 44
	SIF HAVE_PU_SKILL(ARG, "私はこういう女なの")
		RETURN 24
ENDIF
RETURN 16

;　相性
@SKILL_TYPE_私がかけた魔法だよ,ARG
RETURN GET_TYPE_NUM("빙결")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_私がかけた魔法だよ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_私がかけた魔法だよ, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_私がかけた魔法だよ, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리(1 = 後列発動不可・後列指定不可 2 = 後列発動可能・後列指定不可 3 = 後列発動可能・後列指定可能 4 = 後列発動不可・後列指定可能)
@SKILL_RANGE_私がかけた魔法だよ,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_私がかけた魔法だよ,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_私がかけた魔法だよ, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_私がかけた魔法だよ
RETURN GET_SUCCESSION_NUM("빙결")

;속도보정
@SKILL_SPEED_私がかけた魔法だよ, ARG = -1
RETURN 0

;スキルランク
;スキルの習得時の必要ＭＡＧの算出に主に用いられる
;また、習得・所持スキルはこのランクの5倍のレベルを基準として設定する。
@SKILL_RANK_私がかけた魔法だよ, ARG = -1
IF ARG >= 0 && TFLAG:전투중
	SIF HAVE_PU_SKILL(ARG, "欠点掴んで罵り倒す")
		RETURN 14
	SIF HAVE_PU_SKILL(ARG, "面子は徹底的に潰す")
		RETURN 11
	SIF HAVE_PU_SKILL(ARG, "私はこういう女なの")
		RETURN 7
ENDIF
RETURN 3

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_私がかけた魔法だよ,ARG
RETURN GET_STATE_NUM("FREEZE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_私がかけた魔法だよ,ARG
RETURN GET_TYPE_NUM("빙결")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_私がかけた魔法だよ,ARG
RETURN 15

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_私がかけた魔法だよ,ARG
RETURN 95

