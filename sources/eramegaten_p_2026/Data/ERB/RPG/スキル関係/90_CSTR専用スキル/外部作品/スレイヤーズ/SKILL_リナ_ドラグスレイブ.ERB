;코즈믹플레어	威力420・コスト40
;黒魔導爆裂破		威力390・コスト55・貫通ランク2
;ドラグスレイブ		威力450・コスト52
;메기도라온		威力420・コスト60
;
;適性を持たないので純粋にスキルそのもののスペック(威力)が一回り高いという形に
;本来のランク適性威力の上限を超えてるという形なのでＭＰ消費は辛くつけてます。
;竜破斬呼称も考えましたが、他に追加するとして一部魔法以外は漢字表記だとわかんない事案がだいぶでるはずなんでまぁこっちに

;スキル名
@SKILL_NAME_ドラグスレイブ,ARG
RESULTS = 드래그 슬레이브

;　명중
@SKILL_HITRATE_ドラグスレイブ, ARG
RETURN 90

;　威力
@SKILL_POWER_ドラグスレイブ, ARG
RETURN 450

;;クリティカル率
@SKILL_CRITICAL_RATE_ドラグスレイブ, ARG
RETURN 5

;;　吸収率
;@SKILL_HP_ABSORBER_ドラグスレイブ, ARG
;RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ドラグスレイブ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ドラグスレイブ,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ドラグスレイブ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ドラグスレイブ,ARG
RETURN 52

;　相性
;複合相性
@SKILL_TYPE_ドラグスレイブ,ARG
RETURN GET_TYPE_NUM("핵열")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ドラグスレイブ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ドラグスレイブ,ARG
RETURN GET_ダメージタイプ_NUM("魔法")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ドラグスレイブ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ドラグスレイブ,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ドラグスレイブ,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ドラグスレイブ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_ドラグスレイブ, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ドラグスレイブ
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ドラグスレイブ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_ドラグスレイブ,ARG
PRINTL 적 전체에 핵열 상성의 특대 데미지

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ドラグスレイブ,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_ドラグスレイブ, ARG = -1
RETURN 15

