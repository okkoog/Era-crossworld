;ゲシュペンスト・ファントム専用スキル。
;単体飛具物理、威力170*2、MP13、ランク8

;スキル名
@SKILL_NAME_プラズマサイズ,ARG
RESULTS = 플라즈마 사이즈

;　명중
@SKILL_HITRATE_プラズマサイズ, ARG
RETURN 100

;　威力
@SKILL_POWER_プラズマサイズ, ARG
RETURN 170

;　최저공격횟수
@SKILL_MINATTACKNUMBER_プラズマサイズ,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_プラズマサイズ,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_プラズマサイズ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_プラズマサイズ,ARG
RETURN 13

;　相性
@SKILL_TYPE_プラズマサイズ,ARG
RETURN GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_プラズマサイズ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_プラズマサイズ,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_プラズマサイズ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_プラズマサイズ,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_プラズマサイズ,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_プラズマサイズ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_プラズマサイズ, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_プラズマサイズ
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_プラズマサイズ
RETURN GET_SUCCESSION_NUM("비구")

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_プラズマサイズ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;単体攻撃
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_プラズマサイズ,ARG
PRINTL 왼팔 플라즈마 스테이크 안쪽 2자루를 뽑아 소형 빔 낫으로
PRINTL 변형시켜 던진다.
PRINTL 적 단체에 2회 비구 상성의 물리 데미지. 후열 사용 가능.

@SKILL_EXPLAIN_TOOLTIP_プラズマサイズ, ARG
RESULTS:0 = 왼팔 플라즈마 스테이크 안쪽 2자루를 뽑아 소형 빔 낫으로
RESULTS:1 = 변형시켜 던진다.
RESULTS:2 = 敵単体に2回飛具相性の物理ダメージ。後列使用可。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_プラズマサイズ,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_プラズマサイズ, ARG = -1
RETURN 8
