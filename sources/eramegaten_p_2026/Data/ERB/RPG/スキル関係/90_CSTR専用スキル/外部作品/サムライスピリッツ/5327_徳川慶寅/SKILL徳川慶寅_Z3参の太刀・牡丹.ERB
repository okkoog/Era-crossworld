;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_参の太刀・牡丹, ARG, ARG:1, ARG:2
SIF CFLAG:(ARG:1):현데미지 < 1
	RETURN 0
SIF ARG == ARG:1
	RETURN 0
CALL SKILLGAGE_H_SETBIT, ARG, PU_SKILLNUM_GET(ARG, "七の太刀・遊蝶華"), 2
CALL PU_SKILLGAGE_D_SET, ARG, "七の太刀・遊蝶華", 1
