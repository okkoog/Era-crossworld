;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_影舞・深潭, ARG, ARG:1, ARG:2
SIF ARG:2 < -1
	RETURN 0
TFLAG:스킬용1 = 1
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "防御_魔法効果", -4, "短縮", "NOMES"
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "BS부착률", 4, "短縮", , "& ↓방어 & ↓마법효과 & ↑BS付着率" 



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_影舞・深潭, ARG, ARG:1,SKILL_NUM
#DIM SKILL_NUM
TFLAG:스킬용1 = 0
CALL ATTACK_FIELD, ARG, ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
SIF TFLAG:스킬용1 > 0
	CALL SKILLGAGE_D_SET,ARG,[[스킬:분노폭발]],0

