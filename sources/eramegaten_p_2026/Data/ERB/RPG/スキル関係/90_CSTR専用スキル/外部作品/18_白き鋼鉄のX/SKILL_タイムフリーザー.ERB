;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_タイムフリーザー, ARG, ARG:1
#DIM SKILL_NUM
#DIM ROCK_H
;ダークネストリガー追撃条件共通
IF DTRIGGER_ABLE(ARG, "タイムフリーザー")
	ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
	SKILL_NUM = PU_SKILLNUM_GET(ARG, "タイムフリーザー")
	CALL SKILLGAGE_D_SET, ARG, SKILL_NUM, 1
	;200000をつけることで行動不能時にも追撃をするようになる
	RETURN 1, 200000 + 23
ENDIF
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_タイムフリーザー, ARG, ARG:1, SKILL_NUM
#DIM SKILL_NUM
#DIM ROCK_H
#DIM ループ用
#DIM 攻撃前敵カウント
#DIM 攻撃後敵カウント
#DIM 差分
#DIM 加算クードス

IF SKILL_CHANGE(ARG, [[キャラ:입실론_X2]]) || SKILL_CHANGE(ARG, [[キャラ:창조주_X2]])
	SIF CFLAG:ARG:명중강화 < 0
		CFLAG:ARG:명중강화 = 0
	SIF CFLAG:ARG:회피강화 < 0
		CFLAG:ARG:회피강화 = 0
	CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM
	CALL ACTION_508, ARG, ARG:1
ELSE
	;ロック中かつロック対象が生存中なら強制的にロック対象へ攻撃
	IF ARG:1 == 23
		IF BLITZ_TARGET_JUDG(ARG) == 1
			SIF FLAG:총공격중
				TFLAG:반사후0데미지화 = 1
			ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
			CALL SKILLGAGE_D_SET, ARG, SKILL_NUM, 1
			CALL ATTACK_SINGLE, ARG, ROCK_H, SKILL_NUM
		ENDIF
	ELSE
		CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM
		;スクンダ
		CALL ACTION_508, ARG, ARG:1
	ENDIF
	;撃破数1につき20の基礎クードスを得る。(上限100)
	加算クードス = MIN(GET_CREC_ACT_SUM(ARG, "적", "KILL"), 5) * 20
	CALL SET_加算クードス, ARG, 加算クードス
	;EXウェポン9番=タイムフリーザー
	SIF HAVE_SKILL(ARG, [[스킬:DARKNESS TRIGGER]])
	CALL SKILLGAGE_F_SET, ARG, [[스킬:DARKNESS TRIGGER]], 9
ENDIF
