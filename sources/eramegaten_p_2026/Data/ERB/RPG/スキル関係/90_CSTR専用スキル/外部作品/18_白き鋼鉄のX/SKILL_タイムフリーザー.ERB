;　威力
@SKILL_POWER_タイムフリーザー, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "タイムフリーザー")
IF SKILLGAGE_D_GET(ARG, SKILL_NUM) > 0
	IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "다크니스트리거Ｘ") && FLAG:총공격중
		;約1.25倍
		RETURN 335
	ELSE
		RETURN 225
	ENDIF
ELSE
	RETURN 10
ENDIF

