;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_イーグルブースター,ARG
RESULTS = 이글부스터

;　명중
@SKILL_HITRATE_イーグルブースター, ARG
RETURN 100

;　威力
@SKILL_POWER_イーグルブースター, ARG
RETURN 18

;　최저공격횟수
@SKILL_MINATTACKNUMBER_イーグルブースター,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_イーグルブースター,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_イーグルブースター, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_イーグルブースター,ARG
RETURN 20

;　相性
@SKILL_TYPE_イーグルブースター,ARG
RETURN GET_TYPE_NUM("없음")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_イーグルブースター
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_イーグルブースター, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_イーグルブースター,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_イーグルブースター,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_イーグルブースター, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;계승타입
@SKILL_SUCCESSION_TYPE_イーグルブースター
RETURN GET_SUCCESSION_NUM("방어")


;속도보정
@SKILL_SPEED_イーグルブースター, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_イーグルブースター
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_イーグルブースター, ARG = -1
RETURN 8

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_イーグルブースター, ARG, ARG:1, ARG:2
IF GET_COUNT_閃刀カウンター(ARG) >= 3
	CALL SKILL_INVALID_WALL, ARG, ARG:1, "수호의방패/성스러운가호", "範囲"
ELSE
	CALL SKILL_INVALID_WALL, ARG, ARG:1, "성스러운가호", "範囲"
ENDIF
CALL PUSH_CEMETERY_閃刀魔法, ARG, "イーグルブースター"

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_イーグルブースター, ARG
PRINTL 【閃刀魔法】
PRINTL 아군 전체에게 FLY, DYING, ORGY, HEAT 이외의 상태이상을 각각 1회씩 방어하는 장벽을 친다.
PRINTL 스킬 발동 후 섬도 카운터를 1개 얻는다.
PRINTL 
PRINTL 〈강화 효과〉 섬도 카운터가 3개 이상 있을 경우,
PRINTL 추가로 아군 전체에게 만능 속성 이외의 공격을 1회 방어하는 방벽을 부여한다.
PRINTL 강화 효과 발동 후 섬도 카운터를 얻는 대신 3개 제거한다.
PRINTL
PRINTL 이 스킬은 전투 중 1회만 사용 가능.


;使用条件
@SKILL_SPECIAL_ACTIONABLE_イーグルブースター,ARG
RESULTS = 스킬 사용 완료
SIF !IS_USEABLE_閃刀魔法(ARG, "イーグルブースター")
	RETURN 0
RETURN 1

@リンク不能_イーグルブースター
RETURN 1

@SKILL_TAG_イーグルブースター
RESULTS = 閃刀魔法
