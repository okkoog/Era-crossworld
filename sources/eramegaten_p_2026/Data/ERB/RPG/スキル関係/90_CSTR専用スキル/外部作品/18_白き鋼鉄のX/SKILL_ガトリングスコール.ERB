RETURN 0


;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_ガトリングスコール, ARG, ARG:1
#DIM SKILL_NUM
#DIM ROCK_H

;ダークネストリガー追撃条件共通
IF DTRIGGER_ABLE(ARG, "ガトリングスコール")
	ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
	SKILL_NUM = PU_SKILLNUM_GET(ARG, "ガトリングスコール")
	CALL SKILLGAGE_D_SET, ARG, SKILL_NUM, 1
	;200000をつけることで行動不能時にも追撃をするようになる
	RETURN 1, 200000 + 23
ENDIF
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ガトリングスコール, ARG, ARG:1, SKILL_NUM
#DIM SKILL_NUM
#DIM ROCK_H
#DIM 加算クードス

IF SKILL_CHANGE(ARG, [[キャラ:브리게이드_X2]])
	CALL ATTACK_RAND, ARG, ARG:1, SKILL_NUM
ELSE
	;ロック中かつロック対象が生存中なら強制的にロック対象へ攻撃
	IF ARG:1 == 23
		IF BLITZ_TARGET_JUDG(ARG) == 1
			SIF FLAG:총공격중
				TFLAG:반사후0데미지화 = 1
			ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
			CALL SKILLGAGE_D_SET, ARG, SKILL_NUM, 1
			CALL ATTACK_SINGLE, ARG, ROCK_H, SKILL_NUM
		ENDIF
	ELSE
		CALL ATTACK_SINGLE, ARG, POS(ARG:1), SKILL_NUM
	ENDIF
	;撃破数1につき20の基礎クードスを得る。(上限20)
	加算クードス = MIN(GET_CREC_ACT_SUM(ARG, "적", "KILL"), 1) * 20
	CALL SET_加算クードス, ARG, 加算クードス
	;EXウェポン10番=ガトリングスコール
	SIF HAVE_SKILL(ARG, [[스킬:DARKNESS TRIGGER]])
	CALL SKILLGAGE_F_SET, ARG, [[스킬:DARKNESS TRIGGER]], 10
ENDIF
