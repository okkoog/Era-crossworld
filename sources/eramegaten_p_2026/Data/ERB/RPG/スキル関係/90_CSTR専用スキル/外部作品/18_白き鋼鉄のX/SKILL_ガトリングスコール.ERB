	RETURN 120
ELSE
	IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "다크니스트리거Ｘ") && FLAG:총공격중
		;約1.25倍
		RETURN 150
	ELSE
		RETURN 120
	ENDIF
ENDIF

