;　명중
@SKILL_HITRATE_ガトリングスコール, ARG
#DIM SKILL_NUM
IF SKILL_CHANGE(ARG, [[キャラ:브리게이드_X2]])
	RETURN 95
ELSE
	SKILL_NUM = PU_SKILLNUM_GET(ARG, "ガトリングスコール")
	IF SKILLGAGE_D_GET(ARG, SKILL_NUM) > 0
		RETURN 95
	ELSE
		RETURN 50
	ENDIF
ENDIF

