@SKILL_ACTIONABLE_BATTLE_紺碧の種, ARG
RETURN 0

@SKILL_DEL_UNABLE_紺碧の種,ARG
RETURN 0
;削除可

@SKILL_PASSIVE_BTL_EFFECT_紺碧の種,ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;スキル命中率に加算する。低命中スキルに影響度が高く、カジャンダによって効果量が増減する
		 CASE "スキル命中強化"
			;合致した素質で攻撃した場合、命中率１０％増加
			SIF GROUPMATCH(L_相性名, "전술", "수격")
				RETURN 10
		;100% ± Xの補正を与える。同種(粗雑・慢心)などとは加算。補正量が素直
		;この補正を999以上で指定した場合は確定クリティカル、-999以下で指定した場合はクリティカル不能となる
		CASE "クリティカル補正A"
			;合致した素質で攻撃した場合、クリティカル率1.3倍
			;クリランクはアドバイスあるのでハネ上がりすぎると判断
			SIF GROUPMATCH(L_相性名, "전술", "수격")
				RETURN 30
	ENDSELECT
;自分が防御側
ELSE
ENDIF
RETURN 0