;====================================================
;コマンド実行
;====================================================
@INPUT_COM_徳川慶寅奥義, ARG
#LOCALSSIZE 1
#LOCALSIZE 3
#DIM STOCK
#DIM LCOUNT
#DIM LINE
#DIM SKILL_NUM
LINE = LINECOUNT
SKILL_NUM = PU_SKILLNUM_GET(ARG, "徳川慶寅奥義")
VARSET LOCAL
STOCK = SKILLGAGE_H_GET(ARG,SKILL_NUM)
FOR LCOUNT,0,3
	CALL SKILLGAGE_H_SET, ARG,SKILL_NUM,LCOUNT
	CALL CHECK_ACTIONABLE, ARG,SKILL_NUM
	IF RESULT && (LCOUNT < 2 || (LCOUNT == 2 && (SKILLGAGE_H_GET(ARG, PU_SKILLNUM_GET(ARG, "CSTR_怒り爆発")) == 200 || 現HP割合(ARG) < 26)))
		LOCAL:LCOUNT = 1
		CALLFORM SKILL_NAME_%SKILL_STRGET_徳川慶寅奥義(ARG)%, ARG
		LOCALS = %RESULTS%
		CALL GET_SKILL_COST,SKILL_NUM, ARG
		PRINTFORML [{LCOUNT+1}] %LOCALS, 38, LEFT%{RESULT, 3}ＭＰ
	ENDIF
NEXT
DRAWLINE
PRINTL [0] ＣＡＮＣＥＬ
CALL INPUTINT(0,1,2,3)
IF RESULT > 0 && LOCAL:(RESULT - 1) > 0
	CALL SKILLGAGE_H_SET, ARG,SKILL_NUM,RESULT - 1
	CALL SELECT_SKILL_INPUT, ARG,SKILL_NUM
	SIF RESULT > -1
		RETURN 1
ELSEIF RESULT == 0
	CALL SKILLGAGE_H_SET, ARG,SKILL_NUM,STOCK
	RETURN -1
ENDIF
CLEARLINE LINECOUNT - LINE
RESTART
