;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_イリス・マリオネット,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM L_P
#DIM L_T
#DIM LCOUNT
#DIMS L_MES
L_P = ARG
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	CALL SKILL_SET_カジャンダ, L_P, L_T, "방어", 4, "短縮", "NOMES"
	CALL HEAL_SINGLE, L_P, L_T, SKILL_NUM, 1, , "↑ 방어"
	;IF BASE:L_T:ＨＰ >= MAXBASE:L_T:ＨＰ
	;	PRINTFORML %CALLNAME:L_T% >>>>> 0回復
	;ELSE
	;	PRINTFORML %CALLNAME:L_T% >>>>> { MAX(MAXBASE:ARG:ＨＰ/2,1) }회복
	;	BASE:L_T:ＨＰ += MAXBASE:L_T:ＨＰ/2
	;		SIF BASE:L_T:ＨＰ > MAXBASE:L_T:ＨＰ
	;			BASE:L_T:ＨＰ = MAXBASE:L_T:ＨＰ
	;ENDIF
NEXT
WAIT

