;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_修補すべき全ての疵,ARG,ARG:1,SKILL_NUM
#DIM DYNAMIC SKILL_NUM
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_T
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT)
	SIF !IS_TARGET_ABLE(L_T)
		CONTINUE
	CALL SKILL_能力低下解除, ARG, L_T, "短縮"
	CALL SKILL_INVALID_WALL, ARG, L_T, "성스러운가호", "短縮"
	CALL HEAL_SINGLE, ARG, L_T, 434, 1
NEXT
WAIT

CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"),0
CALL SKILLGAGE_F_SET,ARG,PU_SKILLNUM_GET(ARG,"修補すべき全ての疵"),0

