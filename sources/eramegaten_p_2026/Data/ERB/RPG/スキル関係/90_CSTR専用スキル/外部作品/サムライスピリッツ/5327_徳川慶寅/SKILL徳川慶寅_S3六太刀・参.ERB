;====================================================
;カウンター発動条件
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;
;修羅:四の太刀・椿　　　防御中物理攻撃を受けると50％で発動。剣撃相性の大ダメージ+与クリ率低下
;====================================================
@SKILL_COUNTER_ACTIONABLE_六太刀・参,ARG,ARG:1
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"六太刀・参")

SIF !(CFLAG:ARG:방어플래그) && CFLAG:ARG:PT플래그
	RETURN 0
SIF !GET_CREC_ACT(ARG:1, ARG, "物理") && !GET_CREC_ACT(ARG:1, ARG, "魔法")
	RETURN 0
;SIF !GETBIT(CFLAG:ARG:受けフラグ,18)
;	RETURN 0
;お互いに前列にいないとだめ
SIF !IS_FRONT(ARG:1) || !IS_FRONT(ARG)
	RETURN 0
SIF ARG:1 < 0 || GET_STATE(CFLAG:(ARG:1):상태이상) == "DYING"
	RETURN 0
SIF !RAND:2
	RETURN 0
CALL SKILLGAGE_H_SET(ARG,SKILL_NUM,4)
RETURN 1, CPOS(ARG:1)

;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_六太刀・参, ARG, ARG:1, ARG:2
TRYCALLFORM SKILL_DAMAGE_EFFECT_%SKILL_STRGET_六太刀・参(ARG)%, ARG, ARG:1, ARG:2

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_六太刀・参, ARG = -1, ARG:1 = -1
RESULT = 0
TRYCALLFORM SKILL_PENETRATION_RANK_%SKILL_STRGET_六太刀・参(ARG)%, ARG, ARG:1
RETURN RESULT
