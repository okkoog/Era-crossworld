;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_冷気圧縮,ARG
RESULTS = 冷気圧縮

;　명중
@SKILL_HITRATE_冷気圧縮, ARG
RETURN 100

;　威力
@SKILL_POWER_冷気圧縮, ARG
RETURN 18

;　최저공격횟수
@SKILL_MINATTACKNUMBER_冷気圧縮,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_冷気圧縮,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_冷気圧縮, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_冷気圧縮,ARG
RETURN 48

;　相性
@SKILL_TYPE_冷気圧縮,ARG
RETURN GET_TYPE_NUM("수격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_冷気圧縮
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_冷気圧縮, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_冷気圧縮,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_冷気圧縮,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_冷気圧縮, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")


;계승타입
@SKILL_SUCCESSION_TYPE_冷気圧縮
RETURN GET_SUCCESSION_NUM("수격")

;속도보정
@SKILL_SPEED_冷気圧縮, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_冷気圧縮
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_冷気圧縮, ARG = -1
RETURN 12

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_冷気圧縮, ARG, ARG:1, ARG:2
CALL SKILL_WALL , ARG , "화염" , CFLAG:ARG:타겟 , 1
CALL SKILL_SET_カジャンダ, ARG, 22, "방어", 8, "範囲"

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_冷気圧縮, ARG
PRINTL 아군 전체를 향한 화염 속성 공격을 각각 1회씩 방어하는 벽을 치고 방어력을 2단계 올린다

;使用条件
@SKILL_SPECIAL_ACTIONABLE_冷気圧縮,ARG
RETURN 1
;とくにない

