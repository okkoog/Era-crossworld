;スキル名
@SKILL_NAME_復讐の一撃_魔法,ARG
RESULTS = 복수의 일격

;　명중
@SKILL_HITRATE_復讐の一撃_魔法, ARG
RETURN 90

;　威力
@SKILL_POWER_復讐の一撃_魔法, ARG
RETURN 440

;　吸収率
@SKILL_HP_ABSORBER_復讐の一撃_魔法, ARG
RETURN 40

;　최저공격횟수
@SKILL_MINATTACKNUMBER_復讐の一撃_魔法,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_復讐の一撃_魔法,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_復讐の一撃_魔法, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_復讐の一撃_魔法,ARG
RETURN 30

;　相性
@SKILL_TYPE_復讐の一撃_魔法,ARG
SIF ARG >= 0
	RETURN ABL:ARG:공격상성
RETURN GET_TYPE_NUM("不定")

@SKILL_SUCCESSION_TYPE_復讐の一撃_魔法
RETURN GET_SUCCESSION_NUM("계통없음")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_復讐の一撃_魔法, ARG
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_復讐の一撃_魔法,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_復讐の一撃_魔法,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_復讐の一撃_魔法,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_復讐の一撃_魔法,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_復讐の一撃_魔法,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_復讐の一撃_魔法, ARG = -1
RETURN -999

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_復讐の一撃_魔法, ARG = -1
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_復讐の一撃_魔法,ARG,ARG:1,ARG:2
CALL ATTACK_SKILL,ARG,ARG:1,ARG:2
CALL PU_SKILLGAGE_H_SET, ARG, "復讐の一撃", 0

;スキル変化？用ランク
@SKILL_RANK_復讐の一撃_魔法, ARG = -1
RETURN 12

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_復讐の一撃_魔法,ARG
PRINTL 장비한 무기에 의한 치명적인 일격.
PRINTL 통상 공격의 공격 속성에 따라 성능이 변화한다
PRINTL 후의 선을 노리기 위해 턴 종료 직전에 행동하며, 데미지에 비례해 어느 정도 체력을 흡수한다.
PRINTL 
PRINTL 《魔法》
PRINTL 적 단체에 통상 공격 속성으로 특대 데미지를 가하고, 추가로 가한 데미지에 비례해 HP를 회복한다.
PRINTL 사용 턴 중에 입은 데미지에 비례해 주는 데미지가 상승한다.
PRINTL 발동이 매우 느리다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_復讐の一撃_魔法,ARG
RETURN 1

;====================================================
;行動によるスキルゲージ操作
;====================================================
@SKILLGAGE_CHARGE_復讐の一撃_魔法,ARG,ARG:1
CALL SKILLGAGE_CHARGE_復讐の一撃,ARG,ARG:1
RETURN RESULT

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_復讐の一撃_魔法, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
CALL SKILL_PASSIVE_BTL_EFFECT_復讐の一撃, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
RETURN RESULT

@リンク不能_復讐の一撃_魔法
RETURN 1