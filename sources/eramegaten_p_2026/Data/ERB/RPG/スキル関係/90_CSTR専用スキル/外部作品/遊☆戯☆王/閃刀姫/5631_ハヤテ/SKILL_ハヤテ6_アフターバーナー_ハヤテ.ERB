;　명중
@SKILL_HITRATE_アフターバーナー_ハヤテ, ARG
RETURN 100

;　威力
@SKILL_POWER_アフターバーナー_ハヤテ, ARG
RETURN 450

;　최저공격횟수
@SKILL_MINATTACKNUMBER_アフターバーナー_ハヤテ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_アフターバーナー_ハヤテ,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
