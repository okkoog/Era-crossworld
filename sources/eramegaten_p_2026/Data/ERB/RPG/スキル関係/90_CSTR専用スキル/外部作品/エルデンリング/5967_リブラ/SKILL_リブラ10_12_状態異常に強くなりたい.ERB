RETURN GET_SKILL_EFFECT_NUM("특수")

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_状態異常に強くなりたい, ARG = -1
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_状態異常に強くなりたい,ARG,ARG:1,ARG:2
#DIM DYNAMIC LCOUNT
CALL SET_C_BTL_EFFECT_SINGLE, ARG, POS(ARG:1), "偽りの守り", 0
