;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_心の連結反応式, ARG, ARG:1, SKILL_NUM
#DIM SKILL_NUM

CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 10, "-="

IF CFLAG:ARG:("회피강화") >= 8 && CFLAG:ARG:("크리티컬강화") >= 2
	PRINTFORML %CALLNAME:ARG%(은)는 이미 강화되어 있다!
ELSE
	CALL SKILL_SET_カジャンダ, ARG, ARG, "회피", 8, "단체", "", "", 8
	CALL SKILL_SET_カジャンダ, ARG, ARG, "크리티컬", 2, "단체", "", "", 2
ENDIF

