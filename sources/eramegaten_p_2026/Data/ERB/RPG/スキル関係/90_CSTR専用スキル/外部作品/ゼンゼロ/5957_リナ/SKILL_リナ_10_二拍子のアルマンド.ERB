@SKILL_TURNEND_二拍子のアルマンド,ARG,ARG:1
#DIM DYNAMIC L_MAIN
#DIM DYNAMIC L_SKILL
L_SKILL = PU_SKILLNUM_GET(ARG, "二拍子のアルマンド")
L_MAIN = FINDCHARA_TIMEID(CFLAG:ARG:피링크캐릭터실제가입시간)
SIF L_MAIN < 0
	RETURN 0
CALL SKILL_CURE_STATE_二拍子のアルマンド, CFLAG:L_MAIN:상태이상
SIF !RESULT
	RETURN 0
CALL CHECK_COST, ARG, L_SKILL
SIF !RESULT
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG, L_SKILL, , , , "NOWAIT"
CALL CURE_STATE_SINGLE, ARG, L_MAIN, L_SKILL, 0, 0
CALL PAY_COST, ARG, L_SKILL

@SKILL_TURNEND_USEABLE_RESERVE_二拍子のアルマンド, ARG
RETURN 1

