;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_「過去の注釈」,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CFLAG:ARG:회심의패기플래그 = 1
PRINTFORML %CALLNAME:ARG%(은)는 다음 공격에 대비해 높이 팔을 치켜올렸다!
	CALL PU_SKILLGAGE_F_SET, ARG, "「過去の注釈」",3
	PRINTFORML 　
	PRINTFORML 재사용까지 2턴!

;====================================================
;ターン終了時に行う処理
;====================================================
@SKILL_TURNEND_「過去の注釈」,ARG
;CT1ターン減
SIF PU_SKILLGAGE_F_GET(ARG,"「過去の注釈」") > 0
  CALL PU_SKILLGAGE_F_ADD, ARG, "「過去の注釈」",-1

;====================================================
;戦闘終了時に行う処理
;====================================================
@SKILL_BATTLE_END_「過去の注釈」,ARG
;CT1ターン減
SIF PU_SKILLGAGE_F_GET(ARG,"「過去の注釈」") > 0
  CALL PU_SKILLGAGE_F_ADD, ARG, "「過去の注釈」",-1

;====================================================
;実行内容ここまで
;====================================================
@SKILL_EX_DISPLAY_「過去の注釈」, ARG, ARGS
RESULTS '= ""
IF PU_SKILLGAGE_F_GET(ARG,"「過去の注釈」") == 0
	IF INPUTABLE_CHARA_F(ARG)
		RESULTS '= SET_BUTTON_TAG(SET_COLOR_TAG(@"%"過去の注釈", SKILL_EX_DISPLAY_LENS - 10, LEFT%", "パ緑"), ARGS)
		IF IS_PU_SKILL_入力行動(ARG, "「過去の注釈」") && !CFLAG:ARG:방어플래그
			RESULTS += SET_BUTTON_TAG(SET_COLOR_TAG(@"[ Set ]", "パ緑"), @"INPUT/SKILL/{ARG}/{PU_SKILLNUM_GET(ARG, "「過去の注釈」")}", @"「過去の注釈」を使用予定")
		ELSE
			RESULTS += SET_BUTTON_TAG(SET_COLOR_TAG(@"[Ready]", "パ緑"), @"INPUT/SKILL/{ARG}/{PU_SKILLNUM_GET(ARG, "「過去の注釈」")}", @"「過去の注釈」を使用")
		ENDIF
	ELSE
		RESULTS '= SET_BUTTON_TAG(SET_COLOR_TAG(@"%"過去の注釈", SKILL_EX_DISPLAY_LENS - 10, LEFT%", "gray"), ARGS)
		RESULTS += SET_BUTTON_TAG(SET_COLOR_TAG(@"[Ready]", "gray"), , @"행동불능")
	ENDIF
ELSE
	RESULTS += @"%"過去の注釈", SKILL_EX_DISPLAY_LENS - 9, LEFT%%HTML_ESCAPE(@"<CT:0{PU_SKILLGAGE_F_GET(ARG,"「過去の注釈」")}>")%"
ENDIF
RESULTS:1 = ∅「과거의 주석」
RETURN 1

;　 説明文の表示
@SKILL_EXPLAIN_「過去の注釈」,ARG
PRINTL 집중하여 다음 물리 공격이 반드시 명중하고 크리티컬이 발생하기 쉬워진다
PRINTL 사용하면 “∅” 아이콘 스킬에 2턴의 쿨타임이 발생한다
PRINTL 이 스킬 사용 후에 다른 스킬을 쓰면 성능이 강화된다


@SKILL_DEL_UNABLE_「過去の注釈」,ARG
RETURN 1
;削除不可

