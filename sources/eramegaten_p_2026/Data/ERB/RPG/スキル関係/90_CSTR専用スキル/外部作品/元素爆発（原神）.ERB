;====================================================
;トリガー発動条件
;====================================================

;====================================================
;ヒット後ダメージ前処理
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_元素爆発（原神）,ARG,ARG:1,ARG:2
SIF ARG:2 < -1
	RETURN 0
IF SKILL_CHANGE(ARG, [[キャラ:기묘한바르바토스]])
	;奇妙なバルバトス６重　攻撃と魔法威力も追加で破壊。
	IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 6
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "攻撃_魔法威力_防御_魔法効果", -2, "短縮"
	ELSE
		CALL SKILL_SET_カジャンダ, ARG, ARG:1, "防御_魔法効果", -2, "短縮"
	ENDIF
	;命中前、守備と魔防を2段階破壊。本当は翠緑の効果なんですけどね。
;	CFLAG:(ARG:1):방어강화 = MAX(-16, CFLAG:(ARG:1):방어강화 - 2)
;	CFLAG:(ARG:1):마법효과강화 = MAX(-16, CFLAG:(ARG:1):마법효과강화 - 2)
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한모라쿠스]])
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한바알]])
ENDIF
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_元素爆発（原神）,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#LOCALSIZE 4
#DIM 元素爆発制御変数
#DIM 悪曜の呪詛
元素爆発制御変数 = PU_SKILLNUM_GET(ARG,"元素爆発（原神）")

;バアルの所在確認。検知＋仲間に居る場合、爆発が使用される度にゲージHを注ぎ込む。
悪曜の呪詛 = GETCHARA([[キャラ:기묘한바알]])
IF 悪曜の呪詛 >= 0 && CFLAG:悪曜の呪詛:PT플래그 == 2
	;奇妙なバアル１重　爆発が使用される度にHゲージをチャージ、最大２段階
	IF GET_RPG_CFLAG_TAKEOVER(悪曜の呪詛, "命の星座") >= 1
		CALL SKILLGAGE_H_ADD,悪曜の呪詛,元素爆発制御変数,1
		SIF SKILLGAGE_H_GET(悪曜の呪詛,元素爆発制御変数) > 2
			CALL SKILLGAGE_H_SET,悪曜の呪詛,元素爆発制御変数,2
	ENDIF
ENDIF

IF SKILL_CHANGE(ARG, [[キャラ:기묘한바르바토스]])
	ALIGNMENT CENTER
	SETCOLOR 原神カラー(ARG)
	IF RAND:2 ==0
		PRINTFORML ┏━━━━━━━┓
		PRINTFORML ┃바람이다ーー앗!┃
		PRINTFORMW ┗━━━━━━━┛
	ELSE
		PRINTFORML ┏━━━━━━━━━━━━━━━┓
		PRINTFORML ┃도망칠 생각 따윈 하지 마!┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━┛
	ENDIF
	RESETCOLOR
	ALIGNMENT LEFT
	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
	CALL SKILLGAGE_F_SET,ARG,元素爆発制御変数,0
	CALL SET_RPG_CFLAG_BTL, ARG, "元素爆発再使用可能ターン", (FLAG:경과턴수 + 5), "="
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한모라쿠스]])
	ALIGNMENT CENTER
	SETCOLOR 原神カラー(ARG)
	IF RAND:3 == 0
		PRINTFORML ┏━━━━━━━━━┓
		PRINTFORML ┃하늘의 이치가 여기 있노라.┃
		PRINTFORMW ┗━━━━━━━━━┛
	ELSEIF RAND:2 ==0
		PRINTFORML ┏━━━━━┓
		PRINTFORML ┃天動万象！┃
		PRINTFORMW ┗━━━━━┛
	ELSE
		PRINTFORML ┏━━━━━┓
		PRINTFORML ┃天理長駆！┃
		PRINTFORMW ┗━━━━━┛
	ENDIF
	RESETCOLOR
	ALIGNMENT LEFT
	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
	CALL SKILLGAGE_F_SET,ARG,元素爆発制御変数,0
	CALL SET_RPG_CFLAG_BTL, ARG, "元素爆発再使用可能ターン", (FLAG:경과턴수 + 5), "="
	;奇妙なモラクス２重　爆発起動時玉璋シールド全員に配布。
	IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 2
		;範囲の場合の構文例を拝借
		IF CFLAG:(ARG):PT플래그 == 0
			LOCAL:1 = 7
			LOCAL:2 = 17
		ELSE
			LOCAL:1 = 1
			LOCAL:2 = 7
