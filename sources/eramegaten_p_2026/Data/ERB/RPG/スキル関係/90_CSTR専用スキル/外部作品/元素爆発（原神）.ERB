;　威力
@SKILL_POWER_元素爆発（原神）, ARG
#DIM 元素スキル継続時間
#DIM 元素爆発制御変数
#DIM LCOUNT,3
#DIM 威力
#DIM LTARGET = -1
元素スキル継続時間 = PU_SKILLNUM_GET(ARG,"元素スキル（原神）")
元素爆発制御変数 = PU_SKILLNUM_GET(ARG,"元素爆発（原神）")

威力 = 0

IF SKILL_CHANGE(ARG, [[キャラ:기묘한바르바토스]])
	;基本威力
	威力 = 100
	;奇妙なバルバトス３重　元素爆発ダメージ量アップ
	SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 3
		威力 += 20
	;非戦闘中ならここまでで威力を返す
	SIF !TFLAG:전투중
		RETURN 威力
	LCOUNT:1 = CFLAG:ARG:PT플래그 > 0 ? 1 # 7
	LCOUNT:2 = CFLAG:ARG:PT플래그 > 0 ? 7 # 17
	FOR LCOUNT,LCOUNT:1,LCOUNT:2
		LTARGET = POS(LCOUNT)
		;自身と同じパーティでなければ跳ばす
		SIF LTARGET < 0 || CFLAG:LTARGET:PT플래그 != CFLAG:ARG:PT플래그
			CONTINUE
		;バアルでなければ飛ばす。
		SIF NO:LTARGET != [[キャラ:기묘한바알]]
			CONTINUE
		;更にバアルであっても雷罰悪曜の眼がオフである場合飛ばす
		SIF SKILLGAGE_D_GET(LTARGET,元素スキル継続時間) == 0
			CONTINUE
		;ここまで来れば条件を達成したとみなす。該当者が存在した時点で加算処理を終了させる。
		;雷罰悪曜の眼を起動したバアルがいる場合威力上昇。
		威力 += 20
		BREAK
	NEXT
	RETURN 威力
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한모라쿠스]])
	;基本威力
	威力 = 400
	;奇妙なモラクス５重　元素爆発ダメージ量アップ
	SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 5
		威力 += 80
	;非戦闘中ならここまでで威力を返す
	SIF !TFLAG:전투중
		RETURN 威力
	LCOUNT:1 = CFLAG:ARG:PT플래그 > 0 ? 1 # 7
	LCOUNT:2 = CFLAG:ARG:PT플래그 > 0 ? 7 # 17
	FOR LCOUNT,LCOUNT:1,LCOUNT:2
		LTARGET = POS(LCOUNT)
		;自身と同じパーティでなければ跳ばす
		SIF LTARGET < 0 || CFLAG:LTARGET:PT플래그 != CFLAG:ARG:PT플래그
			CONTINUE
		;バアルでなければ飛ばす。
		SIF NO:LTARGET != [[キャラ:기묘한바알]]
			CONTINUE
		;更にバアルであっても雷罰悪曜の眼がオフである場合飛ばす
		SIF SKILLGAGE_D_GET(LTARGET,元素スキル継続時間) == 0
			CONTINUE
		;ここまで来れば条件を達成したとみなす。該当者が存在した時点で加算処理を終了させる。
		;雷罰悪曜の眼を起動したバアルがいる場合威力上昇。
		威力 += 100
		BREAK
	NEXT
	RETURN 威力
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한바알]])
	;基本威力
	威力 = 400
	;奇妙なバアル３重　元素爆発ダメージ量アップ
	SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 3
		威力 += 90
	;非戦闘中ならここまでで威力を返す
	SIF !TFLAG:전투중
		RETURN 威力
	;奇妙なバアル１重　元素爆発起動回数に応じて威力アップ。最大60
	SIF SKILLGAGE_H_GET(ARG,元素爆発制御変数) >= 1
		威力 += (SKILLGAGE_H_GET(ARG,元素爆発制御変数) * 30) 
	;自前の雷罰悪曜の眼で爆発威力上がるの反則じゃないかなこの神。
	SIF SKILLGAGE_D_GET(ARG,元素スキル継続時間) > 0
		威力 += 100
	RETURN 威力
ELSEIF SKILL_CHANGE(ARG, [[キャラ:비묘한부에르]])
	RETURN 0
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한포칼로스]])
	RETURN 0
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한하보림]])
	;基本威力
	威力 = 400
	;２重　元素爆発ダメージ量アップ
	SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 2
		威力 += 30
	;３重　元素爆発ダメージ量アップ
	SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 3
		威力 += 40
	;非戦闘中ならここまでで威力を返す
	SIF !TFLAG:전투중
		RETURN 威力
	LCOUNT:1 = CFLAG:ARG:PT플래그 > 0 ? 1 # 7
	LCOUNT:2 = CFLAG:ARG:PT플래그 > 0 ? 7 # 17
	FOR LCOUNT,LCOUNT:1,LCOUNT:2
		LTARGET = POS(LCOUNT)
		;自身と同じパーティでなければ跳ばす
		SIF LTARGET < 0 || CFLAG:LTARGET:PT플래그 != CFLAG:ARG:PT플래그
			CONTINUE
		;バアルでなければ飛ばす。
		SIF NO:LTARGET != [[キャラ:기묘한바알]]
			CONTINUE
		;更にバアルであっても雷罰悪曜の眼がオフである場合飛ばす
		SIF SKILLGAGE_D_GET(LTARGET,元素スキル継続時間) == 0
			CONTINUE
		;ここまで来れば条件を達成したとみなす。該当者が存在した時点で加算処理を終了させる。
		;雷罰悪曜の眼を起動したバアルがいる場合威力上昇。
		威力 += 30
		BREAK
	NEXT
	RETURN 威力

ELSE
	RETURN 100
ENDIF

