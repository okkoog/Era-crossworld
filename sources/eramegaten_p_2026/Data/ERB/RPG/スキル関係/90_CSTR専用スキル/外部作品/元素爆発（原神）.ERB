@原神カラー, ARG
#FUNCTION
SELECTCASE NO:ARG
	CASE [[キャラ:기묘한바르바토스]]
		RETURNF 0x009e25
	CASE [[キャラ:기묘한모라쿠스]]
		RETURNF 0xffaa00 
	CASE [[キャラ:기묘한바알]]
		RETURNF 0x782069
	CASE [[キャラ:비묘한부에르]]
		RETURNF 0xa6cf00
	CASE [[キャラ:기묘한포칼로스]]
		RETURNF 0x00ffff
	CASE [[キャラ:기묘한하보림]]
		RETURNF 0xff6c00
