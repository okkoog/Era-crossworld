@SKILL_PASSIVE_BTL_EFFECT_元素爆発（原神）, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM 元素爆発制御変数
元素爆発制御変数 = PU_SKILLNUM_GET(L_P,"元素爆発（原神）")

IF SKILL_CHANGE(L_P, [[キャラ:기묘한포칼로스]]) && SKILLGAGE_D_GET(L_P,元素爆発制御変数) > 0
	SELECTCASE ARGS
		;小数点以下切り捨て
		CASE "ダメージ補正加算"
			IF L_相性名 == "수격"
				SIF GET_RPG_CFLAG_TAKEOVER(L_P, "命の星座") >= 2
					RETURN 10
				RETURN 5
			ENDIF
	ENDSELECT
ELSEIF SKILL_CHANGE(L_P, [[キャラ:기묘한하보림]]) && SKILLGAGE_D_GET(L_P,元素爆発制御変数) > 0
	SELECTCASE ARGS
		;小数点以下切り捨て
		CASE "ダメージ補正加算"
			IF L_相性名 == "화염"
				SIF GET_RPG_CFLAG_TAKEOVER(L_P, "命の星座") >= 4
					RETURN 10
				RETURN 5
			ENDIF
	ENDSELECT
ENDIF

RETURN 0
