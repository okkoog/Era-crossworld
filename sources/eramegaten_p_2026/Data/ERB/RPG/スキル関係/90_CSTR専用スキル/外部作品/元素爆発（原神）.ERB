;使用条件
@SKILL_SPECIAL_ACTIONABLE_元素爆発（原神）,ARG
#DIM 元素爆発制御変数
元素爆発制御変数 = PU_SKILLNUM_GET(ARG,"元素爆発（原神）")
;元素爆発リキャスト中は不可（共通）
SIF GET_RPG_CFLAG_BTL(ARG, "元素爆発再使用可能ターン") > FLAG:경과턴수
	RETURN 0
;各々の必要な元素エネルギーが既定値溜まっていなければ不可。
SIF SKILLGAGE_F_GET(ARG,元素爆発制御変数) < GET_元素爆発_ゲージ上限(ARG)
	RETURN 0
RETURN 1

@SKILLGAGE_DISPLAY_元素爆発（原神）,ARG
SIF !HAVE_PU_SKILL(ARG, "元素スキル（原神）")
	CALL SKILLGAGE_DISPLAY_元素スキル（原神）,ARG

@GET_元素爆発_ゲージ上限, ARG
#FUNCTION
SELECTCASE NO:ARG
	CASE [[キャラ:기묘한바르바토스]]
		RETURNF 60
	CASE [[キャラ:기묘한모라쿠스]]
		RETURNF 40
	CASE [[キャラ:기묘한바알]]
		RETURNF 90
	CASE [[キャラ:비묘한부에르]]
		RETURNF 50
	CASE [[キャラ:기묘한포칼로스]]
		RETURNF 60
	CASE [[キャラ:기묘한하보림]]
		RETURNF 80
ENDSELECT

