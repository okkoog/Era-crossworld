@SKILL_EX_DISPLAY_元素爆発（原神）, ARG, ARGS
#DIM BAR_LENS, 2
#DIM BAR_COLOR, 2
#DIM EFFECT_TURN
SELECTCASE NO:ARG
	CASE [[キャラ:기묘한바알]], [[キャラ:비묘한부에르]], [[キャラ:기묘한포칼로스]]
		BAR_LENS = SKILL_EX_DISPLAY_LENS / 2 + SKILL_EX_DISPLAY_LENS % 2, SKILL_EX_DISPLAY_LENS / 2
		IF PU_SKILLGAGE_F_GET(ARG, "元素爆発（原神）") >= GET_元素爆発_ゲージ上限(ARG)
			IF GET_RPG_CFLAG_BTL(ARG, "元素爆発再使用可能ターン") > FLAG:경과턴수
				RESULTS += GET_GENSHIN_SKILL_ICON(ARG, "元素爆発（原神）", "STAND")
				RESULTS += " " * (BAR_LENS - 8)
				RESULTS += HTML_ESCAPE(@"<CT:{GET_RPG_CFLAG_BTL(ARG, "元素爆発再使用可能ターン") - FLAG:경과턴수}>")
			ELSE
				RESULTS += GET_GENSHIN_SKILL_ICON(ARG, "元素爆発（原神）", "ACT")
				RESULTS +=  " " * (BAR_LENS - 8) + SET_COLOR_TAG("Ready", TOSTR(原神カラー(ARG))) +  " "
			ENDIF
		ELSE
			BAR_COLOR = BARCOLORSET("緑"), RESULT:1
			IF GET_RPG_CFLAG_BTL(ARG, "元素爆発再使用可能ターン") > FLAG:경과턴수
				RESULTS += GET_GENSHIN_SKILL_ICON(ARG, "元素爆発（原神）", "STAND")
			ELSE
				RESULTS += GET_GENSHIN_SKILL_ICON(ARG, "元素爆発（原神）", "ACT")
			ENDIF
			RESULTS += HTML_RECT_BAR(PU_SKILLGAGE_F_GET(ARG, "元素爆発（原神）"), GET_元素爆発_ゲージ上限(ARG), BAR_LENS:1 - 2, BAR_COLOR, BAR_COLOR:1)
		ENDIF
		IF PU_SKILLGAGE_D_GET(ARG, "元素爆発（原神）")
			EFFECT_TURN = NO:ARG == [[キャラ:기묘한바알]] ? 3 # (GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 1 ? 5 # 4) 
			BAR_COLOR = BARCOLORSET("赤"), RESULT:1
			RESULTS += GET_GENSHIN_SKILL_ICON(ARG, "元素爆発（原神）", "ACT")
			RESULTS += HTML_RECT_SPLIT_BAR(PU_SKILLGAGE_D_GET(ARG, "元素爆発（原神）"), EFFECT_TURN, BAR_LENS:1 - 2, BAR_COLOR, BAR_COLOR:1)
		ELSE
			RESULTS += " " * BAR_LENS:1
		ENDIF
		RESULTS:1 = 元素爆発
		RETURN 1
	CASEELSE
		IF HAVE_PU_SKILL(ARG, "元素スキル（原神）")
			RETURN 0
		ELSE
			CALL SKILL_EX_DISPLAY_元素スキル（原神）, ARG, ARGS
			RETURN 1
		ENDIF
ENDSELECT

;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_元素爆発（原神）,ARG,ARG:1
#DIM 元素スキル継続時間
#DIM 元素爆発制御変数
#LOCALSIZE 1
#DIM L_T
#DIM L_GP
#DIM L_GP_LIMIT
#DIM L_COLOR
元素スキル継続時間 = PU_SKILLNUM_GET(ARG,"元素スキル（原神）")
元素爆発制御変数 = PU_SKILLNUM_GET(ARG,"元素爆発（原神）")

;スキルゲージDがある＝発動中の場合でも貯まる。
;SIF SKILLGAGE_D_GET(ARG,元素爆発制御変数) > 0
;RETURN 0
;自分の行動の場合
L_GP = 0
L_GP_LIMIT = GET_元素爆発_ゲージ上限(ARG)
L_COLOR = 原神カラー(ARG)
;ゲージはキャラごとに上限が違う
;SELECTCASE NO:ARG
;	CASE [[キャラ:기묘한바르바토스]]
;		L_GP_LIMIT = 60
;		L_COLOR = 0x009e25
;	CASE [[キャラ:기묘한모라쿠스]]
;		L_GP_LIMIT = 40
;		L_COLOR = 0xffaa00 
;	CASE [[キャラ:기묘한바알]]
;		L_GP_LIMIT = 90
;		L_COLOR = 0x782069
;	CASE [[キャラ:비묘한부에르]]
;		L_GP_LIMIT = 50
;		L_COLOR = 0xa6cf00
;ENDSELECT
;上限に到達している場合はリターン
SIF SKILLGAGE_F_GET(ARG,元素爆発制御変数) == L_GP_LIMIT
	RETURN 0
IF ARG == ARG:1
	L_GP += 5
	;行動者がフォカロルス４重以上の場合、スキル追撃を伴う行動を行うたびに４回復
	SIF NO:(ARG:1) == [[キャラ:기묘한포칼로스]] && SKILLGAGE_D_GET(ARG,元素スキル継続時間) < 1 && GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 4
		L_GP += 4
	FOR LOCAL, 0, BCHARANUM
		L_T = BCHARA:LOCAL
		SIF IS_FRIEND(ARG, L_T)
			CONTINUE
		SIF GET_CREC_ACT(ARG, L_T, "HIT")
			L_GP += 5
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 15
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 15
	NEXT
	
	;ダメージを受けた敵の数に応じてスキルゲージアップ
	;FOR LOCAL,0,CHARANUM
	;	SIF CFLAG:LOCAL:PT플래그 == CFLAG:ARG:PT플래그
	;		CONTINUE
	;	IF CFLAG:LOCAL:현데미지 > 0
	;		CALL SKILLGAGE_F_ADD,ARG,元素爆発制御変数,5
	;	ELSE
	;		CONTINUE
	;	ENDIF
	;	;会心、弱点を出すとさらにアップ
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,21)
	;		CALL SKILLGAGE_F_ADD,ARG,元素爆発制御変数,15
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,22)
	;		CALL SKILLGAGE_F_ADD,ARG,元素爆発制御変数,15
	;NEXT
	;気合を入れても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:기합]]
		L_GP += 10
	;集中しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:컨센트레이트]]
		L_GP += 10
	;雄叫びしても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:포효]]
		L_GP += 10
	;挑発しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:도발]]
		L_GP += 10
	;元素スキルで大きく上昇する
	SIF IS_PU_SKILL_入力行動(ARG, "元素スキル（原神）")
		L_GP += 30
	;気合を入れても上がる
	;SIF CFLAG:ARG:입력행동 == 511
	;	CALL SKILLGAGE_F_ADD,ARG,元素爆発制御変数,10
	;集中しても上がる
	;SIF CFLAG:ARG:입력행동 == 512
	;	CALL SKILLGAGE_F_ADD,ARG,元素爆発制御変数,10
	;雄叫びしても上がる
	;SIF CFLAG:ARG:입력행동 == 514
	;	CALL SKILLGAGE_F_ADD,ARG,元素爆発制御変数,10
	;挑発しても上がる
	;SIF CFLAG:ARG:입력행동 == 515
	;	CALL SKILLGAGE_F_ADD,ARG,元素爆発制御変数,10
	;元素スキルで大きく上昇する
	;SIF CFLAG:ARG:입력행동 == 3905
	;	CALL SKILLGAGE_F_ADD,ARG,元素爆発制御変数,30

ENDIF
;味方のバアルの夢想の一心でゲージ+15
IF IS_FRIEND(ARG, ARG:1) && NO:(ARG:1) == [[キャラ:기묘한바알]]
	SIF IS_PU_SKILL_入力行動(ARG:1, "通常攻撃（原神）") && SKILLGAGE_D_GET(ARG:1, PU_SKILLNUM_GET(ARG:1, "元素爆発（原神）")) > 0 && GET_CREC_ACT_SUM(ARG:1, "적", "HIT")
		L_GP += 15
ENDIF

;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える。増加量は最大体力に対するダメージ割合の２倍
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += MAX(200 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ, 2)
;IF CFLAG:ARG:현데미지 > 0 || GETBIT(CFLAG:ARG:受けフラグ,18) || GETBIT(CFLAG:ARG:受けフラグ,19)
;	LOCAL = 200 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ
;	LOCAL = LOCAL < 2 ? 2 # LOCAL
;	CALL SKILLGAGE_F_ADD,ARG,元素爆発制御変数,LOCAL
;ENDIF
;SIF SKILL_CHANGE(ARG, [[キャラ:기묘한바르바토스]])
;	CALL SKILLGAGE_F_SET,ARG,元素爆発制御変数,MIN(60, L_GP + SKILLGAGE_F_GET(ARG, 元素爆発制御変数))
;SIF SKILL_CHANGE(ARG, [[キャラ:기묘한모라쿠스]])
;	CALL SKILLGAGE_F_SET,ARG,元素爆発制御変数,MIN(40, L_GP + SKILLGAGE_F_GET(ARG, 元素爆発制御変数))
;SIF SKILL_CHANGE(ARG, [[キャラ:기묘한바알]])
;	CALL SKILLGAGE_F_SET,ARG,元素爆発制御変数,MIN(90, L_GP + SKILLGAGE_F_GET(ARG, 元素爆発制御変数))
;IF SKILL_CHANGE(ARG, [[キャラ:기묘한바르바토스]])
;	SIF SKILLGAGE_F_GET(ARG,元素爆発制御変数) > 60
;		CALL SKILLGAGE_F_SET,ARG,元素爆発制御変数,60
;ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한모라쿠스]])
;	SIF SKILLGAGE_F_GET(ARG,元素爆発制御変数) > 40
;		CALL SKILLGAGE_F_SET,ARG,元素爆発制御変数,40
;ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한바알]])
;	SIF SKILLGAGE_F_GET(ARG,元素爆発制御変数) > 90
;		CALL SKILLGAGE_F_SET,ARG,元素爆発制御変数,90
;ENDIF
CALL SKILLGAGE_F_SET,ARG,元素爆発制御変数, MIN(L_GP + SKILLGAGE_F_GET(ARG,元素爆発制御変数), L_GP_LIMIT)
IF SKILLGAGE_F_GET(ARG,元素爆発制御変数) == L_GP_LIMIT
	RESULTS = ＥＬＥＭＥＮＴＡＬ ＢＵＲＳＴ ＲＥＡＤＹ！
	RESULT:1 = L_COLOR
ELSE
	RESULTS = 원소 에너지
ENDIF
RESULTS:1 = %" "%
RETURN L_GP
