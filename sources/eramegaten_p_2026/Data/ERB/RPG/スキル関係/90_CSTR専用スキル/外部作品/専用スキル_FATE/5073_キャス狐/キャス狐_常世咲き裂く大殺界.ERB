;추가효과상성
@SKILL_ADDTIONAL_TYPE_常世咲き裂く大殺界,ARG
RETURN GET_TYPE_NUM("신경")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_常世咲き裂く大殺界,ARG
