@SKILL_EFECT_常世咲き裂く大殺界,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_常世咲き裂く大殺界,ARG
RETURN GET_SUCCESSION_NUM("주살")

;속도보정
@SKILL_SPEED_常世咲き裂く大殺界, ARG = -1
