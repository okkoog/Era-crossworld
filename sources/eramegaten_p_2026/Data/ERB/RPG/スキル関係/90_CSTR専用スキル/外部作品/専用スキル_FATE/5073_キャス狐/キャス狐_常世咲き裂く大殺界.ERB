;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_常世咲き裂く大殺界
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_常世咲き裂く大殺界, ARG = -1
RETURN 15


;テンプレート用、追加効果シリーズ
