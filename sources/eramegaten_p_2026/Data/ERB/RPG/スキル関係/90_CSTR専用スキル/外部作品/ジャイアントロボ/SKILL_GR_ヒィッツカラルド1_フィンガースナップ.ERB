;ヒィッツカラルド専用スキル、ガル互換

;スキル名
@SKILL_NAME_フィンガースナップ,ARG
RESULTS = 핑거 스냅

;　명중
@SKILL_HITRATE_フィンガースナップ, ARG
RETURN 100

;　威力
@SKILL_POWER_フィンガースナップ, ARG
RETURN 150

;　최저공격횟수
@SKILL_MINATTACKNUMBER_フィンガースナップ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_フィンガースナップ,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_フィンガースナップ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_フィンガースナップ,ARG
RETURN 5

;　相性
@SKILL_TYPE_フィンガースナップ,ARG
RETURN GET_TYPE_NUM("질풍")

@SKILL_SUCCESSION_TYPE_フィンガースナップ,ARG
RETURN GET_SUCCESSION_NUM("질풍")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_フィンガースナップ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_フィンガースナップ,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_フィンガースナップ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_フィンガースナップ,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_フィンガースナップ,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_フィンガースナップ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_フィンガースナップ, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_フィンガースナップ
RETURN 0

@SKILL_RANK_フィンガースナップ, ARG = -1
RETURN 1


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_フィンガースナップ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃

;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_フィンガースナップ,ARG
PRINTL 적 1체에 질풍 상성의 물리 데미지를 준다.
PRINTL 십걸집의 한 사람, 멋진 피츠카랄도는,
PRINTL 핑거 스냅(흔히 말하는 손가락 튕기기)으로 진공파를 날려 온갖 것을 베어 가르는 능력을 지녔다.

@SKILL_EXPLAIN_TOOLTIP_フィンガースナップ,ARG
RESULTS:0 = 적 1체에 질풍 상성의 물리 데미지를 준다.


;使用条件
@SKILL_SPECIAL_ACTIONABLE_フィンガースナップ,ARG
RETURN 1
