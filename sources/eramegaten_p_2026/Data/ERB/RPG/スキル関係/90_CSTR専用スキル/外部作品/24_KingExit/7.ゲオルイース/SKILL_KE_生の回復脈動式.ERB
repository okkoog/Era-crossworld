;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_生の回復脈動式, ARG, ARG:1, SKILL_NUM
#DIM SKILL_NUM
;ゲージ再回収できる様に起動前にTP10消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 10, "-="
CALL HEAL_SINGLE, ARG, ARG, SKILL_NUM

