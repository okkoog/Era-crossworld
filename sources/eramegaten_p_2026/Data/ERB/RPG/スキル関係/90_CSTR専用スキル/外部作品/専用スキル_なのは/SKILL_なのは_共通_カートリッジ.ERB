;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_カートリッジ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL PU_SKILLGAGE_D_SET,ARG, "カートリッジ", 1
CALL SET_RPG_CFLAG_DUNGEON, ARG, "カートリッジクールタイム", 5
PRINTFORMW %CALLNAME:ARG%(은)는 마력을 해방했다!

;====================================================
;実行内容ここまで
;====================================================


;====================================================
;追加コマンド(一番下)
;====================================================
@INPUT_COM_NAME_カートリッジ,ARG = -1
RESULTS = 카트리지
IF ARG >= 0
	IF GET_RPG_CFLAG_DUNGEON(ARG, "カートリッジクールタイム") == 0
		RESULTS:1 = 카트리지 사용
	ELSE
		IF GET_RPG_CFLAG_TAKEOVER(ARG, "カートリッジ補充許可中")
			RESULTS:1 = 차지 정지
		ELSE
			RESULTS:1 = 차지 재개
		ENDIF
	ENDIF
ENDIF
RETURN 2

@INPUT_COM_ABLE_カートリッジ,ARG
RESULTS = 効果発動中
SIF PU_SKILLGAGE_D_GET(ARG,"カートリッジ")
	RETURN -1
RETURN 1

;====================================================
;コマンド実行
;====================================================
@INPUT_COM_カートリッジ,ARG
#LOCALSIZE 1
#DIM SKILL_NUM
SIF PU_SKILLGAGE_D_GET(ARG, "カートリッジ") > 0
	RETURN -1
IF GET_RPG_CFLAG_DUNGEON(ARG, "カートリッジクールタイム") == 0
	LOCAL = CFLAG:ARG:입력행동
	CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG,"カートリッジ")
	SETCOLOR COLOR("FRIEND")
	PRINTFORML ┏>CHARA━━━━━━━━━━┓　┏>ACT━━━━━━━━━━━━━━━━━━┓
	PRINTFORM ┃[{CPOS(ARG),2}] %CALLNAME:ARG,21,LEFT%┃　┃
	PRINTFORML %"카트리지",40,LEFT%┃
	PRINTFORML ┗━━━━━━━━━━━━━┛　┗━━━━━━━━━━━━━━━━━━━━┛
	PRINTFORMW ＞이번 턴 동안 공격력과 마법 위력이 상승!
	CALL ACTION_カートリッジ,ARG
	CALL BATTLE_EVENT_ACT, ARG
	RESETCOLOR
	WAIT
	CFLAG:ARG:입력행동 = LOCAL
	RETURN -1
ELSE
	IF GET_RPG_CFLAG_TAKEOVER(ARG, "カートリッジ補充許可中")
		CALL SET_RPG_CFLAG_TAKEOVER, ARG, "カートリッジ補充許可中", 0
	ELSE
		CALL SET_RPG_CFLAG_TAKEOVER, ARG, "カートリッジ補充許可中", 1
	ENDIF
	RETURN -1
ENDIF

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_カートリッジ,ARG
#DIM SKILL_NUM
IF PU_SKILLGAGE_D_GET(ARG, "カートリッジ")
	RESULTS = 카트리지 효과 발동 중
ELSE
	IF GET_RPG_CFLAG_DUNGEON(ARG, "カートリッジクールタイム") == 0
		RESULTS = 카트리지 사용 가능
	ELSE
		IF GET_RPG_CFLAG_TAKEOVER(ARG, "カートリッジ補充許可中")
			RESULTS = 카트리지 보충 중
		ELSE
			RESULTS = 카트리지 정지 중
		ENDIF
	ENDIF
ENDIF
RETURN 3

@SKILL_EX_DISPLAY_カートリッジ, ARG, ARGS
IF PU_SKILLGAGE_D_GET(ARG, "カートリッジ")
	RESULTS += SET_COLOR_TAG("★", TOSTR(0xdc143c))
	RESULTS += SET_COLOR_TAG(@"%" Burst!!", SKILL_EX_DISPLAY_LENS - 2, LEFT%", TOSTR(0xdc143c))
	RESULTS:1 = 데미지+50\%
ELSE
	IF GET_RPG_CFLAG_DUNGEON(ARG, "カートリッジクールタイム") == 0
		RESULTS += SET_COLOR_TAG("★", TOSTR(0xdc143c))
		RESULTS += SET_COLOR_TAG(@"%" Ready", SKILL_EX_DISPLAY_LENS - 2, LEFT%", TOSTR(0xdc143c))
		RESULTS:1 = 開放可能
	ELSE
		IF GET_RPG_CFLAG_TAKEOVER(ARG, "カートリッジ補充許可中")
			RESULTS += SET_COLOR_TAG("★", TOSTR(0xdc143c))
			RESULTS += HTML_RECT_SPLIT_BAR(5 - GET_RPG_CFLAG_DUNGEON(ARG, "カートリッジクールタイム"), 5, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("赤"), RESULT:1)
			RESULTS:1 = 카트리지 보충 중
		ELSE
			RESULTS += SET_COLOR_TAG("★", "gray")
			RESULTS += SET_COLOR_TAG(@"%" STOP", SKILL_EX_DISPLAY_LENS - 2, LEFT%", "gray")
			RESULTS:1 = 카트리지 정지 중
		ENDIF
	ENDIF
ENDIF
RETURN 1

;　説明文の表示
@SKILL_EXPLAIN_カートリッジ,ARG
#DIM SKILL_NUM
PRINTL 1턴 동안 데미지를 상승시킨다
PRINTL 이 스킬은 턴을 소비하지 않고 실행할 수 있으나, 한 번 쓰면 재사용까지 5턴의 차지가 필요하다.
PRINTL 추가로 스킬을 차지하기 위해 매 턴 MP를 6씩 소비해야 한다.

@SKILL_BATTLE_MAIN_TOOLTIP_カートリッジ, ARG, ARG:1
IF SKILLGAGE_D_GET(ARG,ARG:1) > 0
	RESULTS = □카트리지 발동
	RESULTS:1 = 　가하는 데미지 +50%
ELSE
	IF GET_RPG_CFLAG_DUNGEON(ARG, "カートリッジクールタイム") == 0
		RESULTS = □카트리지 발동 가능
	ELSE
		IF GET_RPG_CFLAG_TAKEOVER(ARG, "カートリッジ補充許可中")
			RESULTS = □카트리지 보충 중
		ELSE
			RESULTS = □카트리지 정지 중
		ENDIF
	ENDIF
ENDIF

@SKILL_BATTLE_MAIN_FACE_TOOLTIP_カートリッジ, ARG, ARG:1

;使用条件
@SKILL_SPECIAL_ACTIONABLE_カートリッジ,ARG
RETURN 0

;ターン終了時に行う処理
@SKILL_TURNEND_カートリッジ, ARG
IF GET_RPG_CFLAG_TAKEOVER(ARG, "カートリッジ補充許可中") && GET_RPG_CFLAG_DUNGEON(ARG, "カートリッジクールタイム") > 0 && BASE:ARG:ＭＰ >= 6
	CALL SET_RPG_CFLAG_DUNGEON, ARG, "カートリッジクールタイム", 1, "-="
	CALL VAR_MP, ARG, -6
	CALL PRINT_HIT_MESSAGE, ARG, @"ＭＰ:6消費", "w"
ENDIF

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_カートリッジ, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM TOTAL_DMG_B
;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			SIF PU_SKILLGAGE_D_GET(L_P, "カートリッジ")
				RETURN 50
			RETURN 0
	ENDSELECT
ENDIF
