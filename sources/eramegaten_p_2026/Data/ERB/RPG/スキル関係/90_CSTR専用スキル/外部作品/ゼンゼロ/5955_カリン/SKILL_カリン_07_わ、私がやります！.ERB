@SKILL_ZENZERO_PARRY_RATE_わ、私がやります！, L_CHARA, L_LINKING, L_LINK_NO
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_LINKING
#DIM DYNAMIC L_LINK_NO
FOR LCOUNT, 0, TYPENUM
	SELECTCASE GET_TYPE(LCOUNT)
		CASE "검격", "비구", "전술", "타격"
			IF HAVE_PU_SKILL(L_CHARA, "戦場ではお傍に")
				C_ZENZERO_PARRY_RATE:L_LINKING:L_LINK_NO:LCOUNT += 50
			ELSE
				C_ZENZERO_PARRY_RATE:L_LINKING:L_LINK_NO:LCOUNT += 25
			ENDIF
		CASEELSE
	ENDSELECT
NEXT