		CASE 0
			CALL SKILLGAGE_F_ADD,ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"),100
			PRINTFORML 　　%CALLNAME:ARG%의 NP 게이지가 100% 충전되었다!
			;PRINTFORML %CALLNAME:ARG%は竜骸形態へと換装した！
			;;形態換装の処理は戦闘中以外での実行処理に入ってるのでそっちを呼ぶ
		CASE 1
			CALL SET_C_BTL_EFFECT_SINGLE, ARG, ARG, "宝具ダメージ30％増加",3,"３ターンの間、宝具の与えるダメージが上昇！"
	ENDSELECT
ENDIF

