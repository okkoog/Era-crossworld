PRINTFORML \@ TFLAG:전투중 ? %"　"*2% #\@%CALLNAME:ARG%(은)는 \@ FORM_FLAG == 0 ? 용해 형태 # 기사 형태 \@(으)로 환장했다!
CALL SYNC_STATUS,ARG,"HPMP割合保持"
SIF !TFLAG:전투중
	WAIT
;入力行動をATTACK→GUN→GUARDの順に試行していく
CALL CHECK_ACTIONABLE,ARG,0
IF RESULT == 1
	CFLAG:(ARG):입력행동 = 0
	CALL RANDOM_TARGET,ARG,0
	CFLAG:(ARG):방어플래그 = 0
ELSE
	IF EQUIP:(ARG):총
		CALL CHECK_ACTIONABLE,ARG,2101
		IF RESULT == 1
			CFLAG:(ARG):입력행동 = 2101
			CFLAG:(ARG):방어플래그 = 0
			CALL RANDOM_TARGET,ARG,2101
		ELSE
			CFLAG:(ARG):입력행동 = -1
			CFLAG:(ARG):방어플래그 = 1
		ENDIF
	ELSE
		CFLAG:(ARG):입력행동 = -1
		CFLAG:(ARG):방어플래그 = 1
	ENDIF
ENDIF

