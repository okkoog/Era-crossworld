;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_レイ・ホライゾン, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM LNUM
#DIM LCOUNT
#DIM LSUM_OF_BASE

;騎士形態中は補正が発生しない
SIF GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ") == 0
	RETURN 0

SELECTCASE ARGS
	CASE "基本ステータス"
		;選択項目がLVだと補正は発生しない
		SIF ARGS:1 == "LV"
			RETURN 0
		;やってることは悪魔変身によるステータス振り分けと同じ
		LSUM_OF_BASE = 0
		FOR LCOUNT,1,FLAG:기본능력수
			LSUM_OF_BASE += BASE:ARG:(GET_BASESTATUS(LCOUNT))
		NEXT
		;初期能力値は合わせて55
		;힘,지혜,마력,내구,速度,運の順にステータス補正の振り分けを行う
		;LNUM = (LSUM_OF_BASE * AUTO_SPLIT_INT("8_22_29_10_22_6","_",GET_BASESTATUS_NUM(ARGS:1) - 1)) / (18 + 50 * 3 / 2)
		LNUM = (LSUM_OF_BASE * AUTO_SPLIT_INT("8_22_29_10_22_6","_",GET_BASESTATUS_NUM(ARGS:1) - 1)) / (93)
		RETURN LNUM - ARG:1
	CASE "相性"
		;剣撃_50_飛具_150_打撃_75_戦技_25_火炎_100_氷結_100_電撃_100_衝撃_25_神経_150_精神_150_破魔_0_呪殺_50_地変_50_水撃_100_疾風_25_重力_25_核熱_-100_万能_100
		RETURN 1,AUTO_SPLIT_INT("50_150_75_25_100_100_100_25_150_150_0_50_50_100_25_25_-100_100","_",GET_TYPE_NUM(ARGS:1))
ENDSELECT

RETURN 0

;ARG	使用キャラ
;ARGS	オプション用文字列
;====================================================
;宝具換装時、諸々の変化を行う処理
;====================================================
@FORM_CONVERSION_レイ・ホライゾン,ARG,ARGS
#LOCALSIZE 8
#DIM LCOUNT,2
#DIM TEMP_SKILL,21
#DIMS SWAP_HOLD
#DIMS L_FORMS,2
#DIMS L_STR,20
SELECTCASE ARGS
	CASE "그외"
		;タイミングは形態換装フラグの変動後という点に注意
		;素質変化
		FOR LCOUNT,GETNUM(TALENT,"머리"),GETNUM(TALENT,"사이코") + 1
			SIF !GROUPMATCH(TALENTNAME:LCOUNT,"갈퀴","날개","꼬리","화염","핵열")
				CONTINUE
			TALENT:ARG:LCOUNT = GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ") == 1 ? 1 # 0
		NEXT
		;名前変化
		SPLIT GET_RPG_CSTR_TAKEOVER(ARG,"各形態時の名前"),"/",L_STR
		;分割された数を保存
		LCOUNT = RESULT
		;換装先の番号とは反対の数値を入れる
		LCOUNT:1 = GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ") == 1 ? 0 # 1
		L_STR:(LCOUNT:1) '= @"%NAME:ARG%_%CALLNAME:ARG%"
		NAME:ARG = \@L_STR:GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ") != "" ? %AUTO_SPLIT(L_STR:GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ"),"_",0)% # メリュジーヌ\@
		CALLNAME:ARG = \@L_STR:GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ") != "" ? %AUTO_SPLIT(L_STR:GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ"),"_",1)% # メリュジーヌ\@
		CALL SET_RPG_CSTR_TAKEOVER(ARG,"各形態時の名前",STRJOIN(L_STR,"/",0,LCOUNT))
		;スキル変化
		;スキル一覧の内、L_FORMS:0は抜き出す方を、L_FORMS:1は格納される方を選択
		L_FORMS:0 = \@ GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ") == 1 ? 竜骸形態 # 騎士形態\@
		L_FORMS:1 = \@ GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ") == 1 ? 騎士形態 # 竜骸形態\@
		SPLIT GET_RPG_CSTR_TAKEOVER(ARG,@"スキル（%L_FORMS:0%）"),"/",L_STR
		VARSET LCOUNT
		VARSET SWAP_HOLD
		VARSET TEMP_SKILL
		FOR LCOUNT:0, 1, 1 + CHARA_SKILLCOUNT(ARG)
			;専用技は保存しない
			SIF IS_PU_SKILLNUM(ABL:ARG:@"스킬{LCOUNT:0}")
				CONTINUE
			;SWAP_HOLDに現在所持しているスキルを保存
			SWAP_HOLD = %SWAP_HOLD%\@SWAP_HOLD != "" ? / #\@%TOSTR(ABL:ARG:@"스킬{LCOUNT:0}")%
			;保存された場合、スキルは所持欄から削除しておく
			CALL DEL_FRIEND_HAVE_SKILL, ARG, , , LCOUNT:0
			TEMP_SKILL:(LCOUNT:0) = TOINT(L_STR:(LCOUNT:1))
			LCOUNT:1 += 1
		NEXT
		;格納先に変身元のスキルを代入して保存する
		CALL SET_RPG_CSTR_TAKEOVER(ARG,@"スキル（%L_FORMS:1%）",SWAP_HOLD)
		VARSET LCOUNT
		;空き番号を詰める
		FOR LCOUNT:0, CHARA_SKILLCOUNT(ARG), 0, -1
			SIF TEMP_SKILL:(LCOUNT:0) == 0 || IS_PU_SKILLNUM(TEMP_SKILL:(LCOUNT:0))
				ARRAYREMOVE TEMP_SKILL, LCOUNT:0, 1
		NEXT
		LCOUNT:1 = 1
		FOR LCOUNT:0, 1, 1 + CHARA_SKILLCOUNT(ARG)
			;専用技は置き換え対象外
			SIF IS_PU_SKILLNUM(ABL:ARG:@"스킬{LCOUNT:0}")
				CONTINUE
			;TEMP_SKILLに入れたスキルと所持しているスキルを交換する
			CALL SET_FRIEND_HAVE_SKILL(ARG,TEMP_SKILL:(LCOUNT:1),,LCOUNT:0)
			LCOUNT:1 += 1
		NEXT
		;雑なやり方だけどCHARA.ERBにあるSET_LEARN_SKILL関数で習得スキルを対応する形態用に入れ替える
		CALL SET_LEARN_SKILL_5098(ARG)
ENDSELECT
