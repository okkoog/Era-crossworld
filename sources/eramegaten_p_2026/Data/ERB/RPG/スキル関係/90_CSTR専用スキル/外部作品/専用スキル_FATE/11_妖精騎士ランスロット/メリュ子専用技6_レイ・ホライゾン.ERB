@ACTION_FIELD_レイ・ホライゾン,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM FORM_FLAG

SKILL_NUM = PU_SKILLNUM_GET(ARG,"レイ・ホライゾン")

FORM_FLAG = GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ")

CALL SET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ",FORM_FLAG == 0 ? 1 # 0)
