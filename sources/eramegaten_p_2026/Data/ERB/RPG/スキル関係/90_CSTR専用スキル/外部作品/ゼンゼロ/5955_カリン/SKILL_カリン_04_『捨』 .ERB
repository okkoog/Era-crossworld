;スキル名
@SKILL_NAME_『捨』,ARG
RESULTS = 『捨』

;　명중
@SKILL_HITRATE_『捨』, ARG
RETURN 999

;　威力
@SKILL_POWER_『捨』, ARG
SIF ARG < 0
	RETURN 25
CALL GET_SKILL_POWER_『捨』(GET_ROLE_CFLAG_TAKEOVER(ARG, "通常スキルランク"))
RETURN RESULT

@GET_SKILL_POWER_『捨』, ARG
SELECTCASE ARG
	CASE 15
		RETURN 95
	CASE 11 TO 14
		RETURN 80 + (ARG - 10) * 3
	CASE 10
		RETURN 80
	CASE 2 TO 9
		RETURN 20 + 6 * ARG
	CASE 0, 1
		RETURN 25
	CASEELSE
		RETURN 0
ENDSELECT


;;クリティカル率
@SKILL_CRITICAL_RATE_『捨』, ARG
RETURN 5

