;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_『捨』, ARG = -1
RETURN 0

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_『捨』, ARG = -1, ARG:1 = -1
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "特殊勤務メイド")
	RETURN 0, 4
ELSE
	RETURN 0, 0
ENDIF
;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_『捨』,ARG,ARG:1
SIF !GET_ROLE_CFLAG_BTL(ARG, "極限回避発動")
	RETURN 0
;攻撃を受けている
SIF !GET_CREC_ACT(ARG:1, ARG, "ATTACK")
	RETURN 0
;反撃の対象は反撃してきたキャラ(ポジションで返す)
RETURN 1, CPOS(ARG:1)
;RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_『捨』,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
TFLAG:반사0데미지화 = 1
TFLAG:흡수0데미지화 = 1
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM
TFLAG:반사0데미지화 = 0
TFLAG:흡수0데미지화 = 0
CALL SKILLGAGE_CHARGE_ROLE_ホロウエージェント, ARG, ARG
CALL SET_ROLE_CFLAG_BTL, ARG, "獲得デシベル値", RESULT

;　説明文の表示
@SKILL_EXPLAIN_『捨』,ARG
PRINTL 【회피】【코린 전용 스킬】
PRINTL 극한 회피 발동 시에 이하의 연동 효과가 발동한다.
PRINTL 『공격해 온 적에 대해 1~5회 검격 상성의 소데미지를 준다.』

@ENHANCE_SKILL_EXPLAIN_『捨』,ARG
RESULTS '= "極限回避発動時に以下の連動効果が発動する。" + "<br>"
RESULTS += "『攻撃してきた敵に対して1~5回、剣撃相性の小ダメージを与える。』"

@SKILL_ACTIONABLE_BATTLE_『捨』, ARG
RETURN 0

;使用条件
@SKILL_SPECIAL_ACTIONABLE_『捨』,ARG
RETURN 1

