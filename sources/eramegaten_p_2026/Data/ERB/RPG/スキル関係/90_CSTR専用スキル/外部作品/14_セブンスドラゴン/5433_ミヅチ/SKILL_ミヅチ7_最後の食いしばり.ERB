;スキル名
@SKILL_NAME_最後の食いしばり,ARG
RESULTS = 최후의 악물기

;　명중
@SKILL_HITRATE_最後の食いしばり, ARG
RETURN 100

;　威力
@SKILL_POWER_最後の食いしばり, ARG
RETURN 200

;　최저공격횟수
@SKILL_MINATTACKNUMBER_最後の食いしばり,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_最後の食いしばり,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_最後の食いしばり, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_最後の食いしばり,ARG
RETURN 60


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_最後の食いしばり
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_最後の食いしばり, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_最後の食いしばり,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_最後の食いしばり,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_最後の食いしばり, ARG
RETURN GET_SKILL_EFFECT_NUM("회복")


;계승타입
@SKILL_SUCCESSION_TYPE_最後の食いしばり
RETURN GET_SUCCESSION_NUM("회복")

;속도보정
@SKILL_SPEED_最後の食いしばり, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_最後の食いしばり
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_最後の食いしばり, ARG = -1
RETURN 16

@敵専用_最後の食いしばり
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_最後の食いしばり, ARG, ARG:1, ARG:2
CALL SKILL_SET_カジャンダ, ARG, ARG, "방어", 128, "단체", "NOMES"
PRINTFORML %CALLNAME:ARG%의 방어력이 최대까지 올랐다!
PRINTFORMW %CALLNAME:ARG%(은)는 턴 종료 시 최대 HP의 5%를 회복하게 되었다!
CALL PU_SKILLGAGE_H_SET, ARG, "最後の食いしばり", 1
;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_最後の食いしばり, ARG
PRINTL 방어력을 최대까지 올리고, 턴 종료마다 회복하게 된다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_最後の食いしばり,ARG
RETURN 1
;とくにない

;RESULT:0 = HP回復量
;RESULT:1 = MP回復量
;RESULT:2 = MAG消費量
@SKILL_REGEN_AT_TURNEND_最後の食いしばり,ARG
SIF !PU_SKILLGAGE_H_GET(ARG, "最後の食いしばり")
	RETURN 0
RETURN MAXBASE:ARG:ＨＰ * 5 / 100
