;スキル名
@SKILL_NAME_無銘勝利剣,ARG
RESULTS = 無銘勝利剣

;　명중
@SKILL_HITRATE_無銘勝利剣, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"無銘勝利剣")

;1撃目以降で相手が回避失敗ではなかった場合、命中率を0に
;SIF SKILLGAGE_H_GET(ARG,SKILL_NUM) > 1 && CFLAG:POS(CFLAG:ARG:타겟):회피실패 < 1
;初段以降は初段の判定結果に従う
IF SKILLGAGE_H_GET(ARG,SKILL_NUM) > 1
	IF GET_CREC_ACT(ARG, -1, "AVOID")
		RETURN 0
	ELSE
		RETURN 999
	ENDIF
ELSE
	RETURN 130
ENDIF


;　威力
@SKILL_POWER_無銘勝利剣, ARG
#DIM SKILL_NUM
#DIM L_DMG
SKILL_NUM = PU_SKILLNUM_GET(ARG,"無銘勝利剣")
;総威力は300,450,500、強化イベント経由時は400,550,600
SELECTCASE SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"))
	CASE IS > 3
		SELECTCASE TOINT(CSTR:ARG:102)
			CASE IS >= 1
				L_DMG = 600
			CASEELSE
				L_DMG = 500
		ENDSELECT
	CASE IS > 1
		SELECTCASE TOINT(CSTR:ARG:102)
			CASE IS >= 1
				L_DMG = 550
			CASEELSE
				L_DMG = 450
		ENDSELECT
	CASEELSE
		SELECTCASE TOINT(CSTR:ARG:102)
			CASE IS >= 1
				L_DMG = 400
			CASEELSE
				L_DMG = 300
		ENDSELECT
ENDSELECT

SELECTCASE SKILLGAGE_H_GET(ARG,SKILL_NUM)
	CASE 1
		TIMES L_DMG , 0.05
	CASE 2
		TIMES L_DMG , 0.07
	CASE 3
		TIMES L_DMG , 0.05
	CASE 4
		TIMES L_DMG , 0.07
	CASE 5
		TIMES L_DMG , 0.05
	CASE 6
		TIMES L_DMG , 0.07
	CASE 7
		TIMES L_DMG , 0.05
	CASE 8
		TIMES L_DMG , 0.07
	CASE 9
		TIMES L_DMG , 0.05
	CASE 10
		TIMES L_DMG , 0.07
	CASE 11
		TIMES L_DMG , 0.05
	CASE 12
		TIMES L_DMG , 0.35
ENDSELECT

RETURN L_DMG

