RETURN 999

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_被害妄想,ARG,ARG:1,ARG:2
#DIM DYNAMIC L_CHARA
CALL SINGLE_BADSTATE, ARG, ARG, ARG:2

@SKILL_TURNEND_被害妄想, ARG
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
SIF RAND:4
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG, , , , "被害妄想"
CALL ACTION_被害妄想,ARG,ARG:1,PU_SKILLNUM_GET(ARG, "被害妄想")

;　 説明文の表示
@SKILL_EXPLAIN_被害妄想,ARG
PRINTL 자동효과:일정 확률로 턴 종료 시에 이하의 연동 효과가 발동한다.
PRINTL 　　　　 「만능 상성으로 자신에게 PANIC을 부착한다.」

@SKILL_EXPLAIN_TOOLTIP_被害妄想, ARG
RESULTS:0 = 자동효과:일정 확률로 턴 종료 시에 이하의 연동 효과가 발동한다.
RESULTS:1 = 　　　　 「만능 상성으로 자신에게 PANIC을 부착한다.」

