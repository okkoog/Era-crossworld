;====================================================
;行動によるスキルゲージ操作
;====================================================
@SKILLGAGE_CHARGE_悲劇最果ての顫音,ARG,ARG:1
#LOCALSIZE 1
#DIM L_T
#DIM L_GP
;自分の行動の場合
IF ARG == ARG:1
	;専用技の使用でゲージ上昇
	SIF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG,"止まない夜の喧騒")
		L_GP += 20
	SIF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG,"月明かりが撫でる連綿")
		L_GP += 30
	;バステ付与した場合にゲージ＋バステ付与した敵が倒された場合にゲージ＋
	FOR LOCAL, 0, BCHARANUM
		L_T = BCHARA:LOCAL
		SIF IS_FRIEND(ARG, L_T)
			CONTINUE
		SIF GET_CREC_ACT(ARG, L_T, "BADSTATE") && HAVE_SKILL(ARG,PU_SKILLNUM_GET(ARG,"略奪"))
			L_GP += 10
		SIF GET_CREC_ACT(ARG, L_T, "KILL") && (GET_RPG_CFLAG_TAKEOVER(ARG, "星魂") > 3) && CFLAG:L_T:상태이상 != GET_STATE_NUM("GOOD")
			; 処理が未記載なのでCONTINUE仮置き
			CONTINUE
	NEXT
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += 15
CALL SKILLGAGE_F_SET,ARG ,PU_SKILLNUM_GET(ARG,"悲劇最果ての顫音"), MIN(L_GP + SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"悲劇最果ての顫音")), 60)
IF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"悲劇最果ての顫音")) >= 60
	RESULTS = ＵＬＴＩＭＡＴＥ ＲＥＡＤＹ！
ELSE
	RESULTS = ＥＰ
ENDIF
RESULTS:1 = %" "%
RETURN L_GP

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_悲劇最果ての顫音,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM LCOUNT
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM
CALL SKILLGAGE_F_SET,ARG ,PU_SKILLNUM_GET(ARG,"悲劇最果ての顫音"), -60
FOR LCOUNT, CFLAG:ARG:PT플래그 ? 7 # 1, CFLAG:ARG:PT플래그 ? 17 # 7
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	SIF CFLAG:(POS(LCOUNT)):상태이상 == GET_STATE_NUM("GOOD")
		CONTINUE
	SIF CFLAG:(ARG:1):상태이상 != GET_STATE_NUM("SHOCK") && !HAVE_SKILL(ARG, PU_SKILLNUM_GET(ARG,"苛み"))
		CONTINUE
	CALL ATTACK_SINGLE,ARG,POS(LCOUNT),SKILL_NUM
NEXT
