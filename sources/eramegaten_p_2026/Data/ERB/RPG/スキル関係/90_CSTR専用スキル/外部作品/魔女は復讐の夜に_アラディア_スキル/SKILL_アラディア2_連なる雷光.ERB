;電撃で4ヒットの拡散1。感電。
;スキル名
@SKILL_NAME_連なる雷光,ARG
RESULTS = 연달은 뇌광

;　명중
@SKILL_HITRATE_連なる雷光, ARG
RETURN 100

;　威力
@SKILL_POWER_連なる雷光, ARG
RETURN 70

;　최저공격횟수
@SKILL_MINATTACKNUMBER_連なる雷光,ARG
RETURN 4

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_連なる雷光,ARG
RETURN 4

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_連なる雷光, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_連なる雷光,ARG
RETURN 22

;　相性
@SKILL_TYPE_連なる雷光,ARG
RETURN GET_TYPE_NUM("전격")

@SKILL_SUCCESSION_TYPE_連なる雷光
RETURN GET_SUCCESSION_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_連なる雷光, ARG
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_連なる雷光,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_連なる雷光,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_連なる雷光,ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_連なる雷光,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_連なる雷光,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_連なる雷光, ARG = -1
RETURN -10

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_連なる雷光, ARG = -1
RETURN 0

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_連なる雷光,ARG
RETURN GET_STATE_NUM("SHOCK")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_連なる雷光,ARG
RETURN GET_TYPE_NUM("전격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_連なる雷光,ARG
RETURN 15

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_連なる雷光,ARG
RETURN 95

;拡散スキルの拡散距離定義関数(このような感じで数値を増やすことで増えていく)
;1 　　　　　2 　　　　
;□□◆□□　□◆◆◆□
;□◆★◆□　◆◆★◆◆
@SKILL_SPREAD_連なる雷光,ARG
RETURN 1

@SKILL_RANK_連なる雷光, ARG = -1
RETURN 9

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_連なる雷光,ARG,ARG:1,ARG:2
CALL ATTACK_SKILL,ARG,ARG:1,ARG:2

;　説明文の表示
@SKILL_EXPLAIN_連なる雷光,ARG
PRINTL 번개를 정면을 향해 수평으로 4회 쏜다.
PRINTL 나름대로 고위 마녀술이며 능숙하게 구사하는 마녀는 많지 않다.
PRINTL 발동이 느리지만 감전으로 주춤거리게 만든다.
PRINTL 
PRINTL 적 1체를 대상 및 그 주변 적에게 전격 속성의 소 데미지를 4회 가하고, 저확률로 SHOCK을 부여한다.
PRINTL 이 스킬은 발동이 느리다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_連なる雷光,ARG
RETURN 1

