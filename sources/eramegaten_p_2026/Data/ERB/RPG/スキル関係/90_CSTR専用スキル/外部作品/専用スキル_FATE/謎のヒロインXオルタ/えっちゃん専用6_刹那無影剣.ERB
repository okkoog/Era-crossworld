ELSEIF PU_SKILLGAGE_D_GET(ARG,"刹那無影剣") > 0
	RESULTS = 刹那無影剣:ＣＴ{PU_SKILLGAGE_D_GET(ARG,"刹那無影剣")}
ENDIF
