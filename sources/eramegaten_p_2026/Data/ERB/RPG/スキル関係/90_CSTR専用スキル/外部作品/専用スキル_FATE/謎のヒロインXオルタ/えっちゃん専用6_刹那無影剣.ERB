;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_刹那無影剣,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

SKILL_NUM = PU_SKILLNUM_GET(ARG,"刹那無影剣")

IF SKILLGAGE_D_GET(ARG,SKILL_NUM) == 0
	CALL SKILLGAGE_D_SET,ARG,SKILL_NUM,5
	PRINTW 3턴 동안 특정 공격 시 데미지가 상승하는 상태가 되었다!
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;追加コマンド(EXTRAの下)
;====================================================
@INPUT_COM_NAME_刹那無影剣,ARG
RESULTS = 刹那無影剣
RESULTS:1 = 刹那無影剣
RETURN 0

@INPUT_COM_ABLE_刹那無影剣,ARG
RESULTS = 効果発動中
SIF PU_SKILLGAGE_D_GET(ARG, "刹那無影剣")
	RETURN -1
CALL CHECK_COST, ARG, PU_SKILLNUM_GET(ARG, "刹那無影剣")
SIF !RESULT
	RETURN -1
RETURN 1

;====================================================
;コマンド実行
;====================================================
@INPUT_COM_刹那無影剣,ARG
#LOCALSIZE 1
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"刹那無影剣")
CALL GET_SKILL_COST,SKILL_NUM,ARG
PRINTL 스킬 사용 시 3턴 동안 이하의 공격을 실행했을 때 데미지가 상승하는 상태가 됩니다.
PRINTL 해당 공격: 『검격 속성 공격』 『전격 속성 공격』
PRINTL 
PRINTFORML 스킬을 사용하겠습니까? (소비 MP　{RESULT})
PRINTL
CALL INPUT_YN
IF RESULT == 0
	LOCAL = CFLAG:ARG:입력행동
	CFLAG:ARG:입력행동 = SKILL_NUM
	CALL PAY_COST, ARG, CFLAG:ARG:입력행동
	CALL PRINT_ACT_MESSAGE, ARG, SKILL_NUM
	CALL BATTLE_EVENT_ACT, ARG
	RESETCOLOR
	CALL ACTION_刹那無影剣,ARG
	CFLAG:ARG:입력행동 = LOCAL
ENDIF
RETURN -1
;-1 再びコマンド選択へ
; 1 キャラ選択へ

;====================================================
