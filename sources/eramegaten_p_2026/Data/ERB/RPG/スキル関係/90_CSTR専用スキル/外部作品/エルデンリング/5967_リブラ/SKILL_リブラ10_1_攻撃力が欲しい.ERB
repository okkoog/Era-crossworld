#DIM L_POWER
#DIMS DYNAMIC DOWN_TABLE = "방어", "마법효과", "마법위력", "命中率", "回避率"
CALL SHUFFLE_ARRAY_STR, DOWN_TABLE 
CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "공격", 8, "단체", "NOWAIT"
