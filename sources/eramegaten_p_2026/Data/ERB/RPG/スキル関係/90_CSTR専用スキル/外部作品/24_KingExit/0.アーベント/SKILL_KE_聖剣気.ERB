;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_聖剣気, ARG
	RESULTS = 聖剣気

;　명중
@SKILL_HITRATE_KE_聖剣気, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_聖剣気, ARG
RETURN 120

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_聖剣気, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_聖剣気, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_聖剣気, ARG
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 10
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_KE_聖剣気, ARG
IF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 10
	RESULTS = %" 10ＴＰ"%
	RETURN 0
ENDIF
RETURN 5

;　相性
@SKILL_TYPE_KE_聖剣気, ARG
RETURN GET_TYPE_NUM("파마")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_聖剣気
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_聖剣気, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_聖剣気, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_KE_聖剣気, ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_聖剣気, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_聖剣気, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_KE_聖剣気, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_聖剣気
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_聖剣気, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;ゲージ再回収できる様に起動前にTP10消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 10, "-="

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

CALL SKILL_能力上昇解除, ARG, ARG:1, "短縮"

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_聖剣気, ARG
PRINTL 
PRINTL 적 단체에 파마 속성 공격을 가하여 강화를 해제한다.
PRINTL 
PRINTL 늑대기사 아벤트의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_聖剣気, ARG
;ゲージが10以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 10
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_聖剣気, ARG
RESULTS:0 = 적 단체에 파마 속성 공격을 가하여 강화를 해제한다.
RESULTS:1 = TP消費 10
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 10
	RESULTS:1 = %RESULTS:1%(不足)