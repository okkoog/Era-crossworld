;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_東方山, ARG
RESULTS = 東方山

;　명중
@SKILL_HITRATE_KE_東方山, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_東方山, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_東方山, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_東方山, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_東方山, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_KE_東方山, ARG
RESULTS = %" 90ＴＰ"%
RETURN 0

;　相性
@SKILL_TYPE_KE_東方山, ARG
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_東方山
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_東方山, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_東方山, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_KE_東方山, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_東方山, ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_東方山, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;속도보정
@SKILL_SPEED_KE_東方山, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_東方山
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_東方山, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;TP90消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 90, "-="

CALL CURE_STATE_FIELD, ARG, ARG:1, SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_東方山, ARG
PRINTL 
PRINTL 식물을 조합해 만든 특수한 이상 회복약.
PRINTL 아군 전체의 상태이상을 회복시킨다.
PRINTL 
PRINTL 식물명예박사 라스터의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_東方山, ARG
;ゲージが90以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 90
	RETURN 0
RETURN 1

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_KE_東方山, ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

@SKILL_EXPLAIN_TOOLTIP_KE_東方山, ARG
RESULTS:0 = 식물을 조합해 만든 특수한 이상 회복약. 아군 전체의 상태이상을 회복시킨다.
RESULTS:1 = TP消費 90
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 90
	RESULTS:1 = %RESULTS:1%(不足)