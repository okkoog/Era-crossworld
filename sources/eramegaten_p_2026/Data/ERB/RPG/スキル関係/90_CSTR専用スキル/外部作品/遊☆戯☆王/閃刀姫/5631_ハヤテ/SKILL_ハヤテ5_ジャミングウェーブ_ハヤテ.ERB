;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_ジャミングウェーブ_ハヤテ,ARG,ARG:1
#DIM LCOUNT
;判定は一回
SIF ARG != ARG:1
	RETURN 0
;自分自身の行動でないと誘発しない
SIF ARG != FLAG:행동순1
	RETURN 0
SIF !IS_PU_SKILL_入力行動(ARG, "ジャミングウェーブ_ハヤテ")
	RETURN 0
SIF !PU_SKILLGAGE_D_GET(ARG, "ジャミングウェーブ_ハヤテ")
	RETURN 0
RETURN 1, CFLAG:ARG:PT플래그 ? 22 # 19

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ジャミングウェーブ_ハヤテ, ARG, ARG:1, ARG:2
IF FLAG:총공격중
	CALL ATTACK_SKILL, ARG, ARG:1, ARG:2
ELSE
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "명중/회피/마법효과", -4, "範囲"
	CALL PUSH_CEMETERY_閃刀魔法, ARG, "ジャミングウェーブ"
	SIF GET_COUNT_閃刀カウンター(ARG) >= 3
		CALL PU_SKILLGAGE_D_SET, ARG, "ジャミングウェーブ_ハヤテ", 1
ENDIF

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_ジャミングウェーブ_ハヤテ, ARG
PRINTL 【閃刀魔法】
PRINTL 적 전체의 명중률, 회피율, 마법 효과를 저하시킨다.
PRINTL 스킬 발동 후 섬도 카운터를 1개 얻는다.
PRINTL 
PRINTL 〈강화 효과〉 섬도 카운터가 3개 이상 있을 경우 이하의 연동효과가 발동한다.
PRINTL 「적 전체에 질풍 속성의 물리 속성 대 데미지를 가한다.」
PRINTL 강화 효과 발동 후 섬도 카운터를 얻는 대신 3개 제거한다.
PRINTL 
PRINTL 이 스킬은 전투 중 1회만 사용 가능.

