;スキル名
@SKILL_NAME_閃刀起動「エンゲージ」,ARG
RESULTS = 섬도기동「인게이지」

;　威力
@SKILL_POWER_閃刀起動「エンゲージ」, ARG
IF ARG >= 0 && GET_COUNT_閃刀カウンター(ARG) >= 3
	RETURN 1000
ELSE
	RETURN 75
ENDIF

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_閃刀起動「エンゲージ」, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_閃刀起動「エンゲージ」,ARG
RETURN 20

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_閃刀起動「エンゲージ」,ARG
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

@SKILL_HEAL_TYPE_閃刀起動「エンゲージ」, ARG = -1
IF ARG >= 0 && GET_COUNT_閃刀カウンター(ARG) >= 3
	RETURN GET_SKILL_HEAL_TYPE_NUM("割合")
ELSE
	RETURN GET_SKILL_HEAL_TYPE_NUM("통상")
ENDIF

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_閃刀起動「エンゲージ」, ARG
RETURN GET_SKILL_TARGET_NUM("특수")

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_閃刀起動「エンゲージ」,ARG
RETURN GET_SPHERE_NUM("적아군전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_閃刀起動「エンゲージ」,ARG
RETURN GET_SKILL_EFFECT_NUM("회복")

;계승타입
@SKILL_SUCCESSION_TYPE_閃刀起動「エンゲージ」
RETURN GET_SUCCESSION_NUM("회복")

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_閃刀起動「エンゲージ」, ARG = -1
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_閃刀起動「エンゲージ」, ARG = -1
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_閃刀起動「エンゲージ」, ARG, ARG:1, ARG:2
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC IS_HEAL
FOR LCOUNT, 0, LINKCHARANUM + 1
	IF LCOUNT == 0
		L_CHARA = ARG
	ELSE
		L_CHARA = FINDCHARA_LINK(ARG, LCOUNT - 1)
	ENDIF
	SIF L_CHARA < 0
		CONTINUE
	IF CFLAG:(L_CHARA):상태이상 == GET_STATE_NUM("DYING")
		CFLAG:(L_CHARA):상태이상 = 0
		CFLAG:(L_CHARA):상태이상경과턴수 = 0
		CALL HEAL_SINGLE, ARG, L_CHARA, ARG:2, 1, , "蘇生"
	ELSE
		CALL HEAL_SINGLE, ARG, L_CHARA, ARG:2, 1
	ENDIF
NEXT
WAIT

CALL PUSH_CEMETERY_閃刀魔法, ARG, "エンゲージ"

;　説明文の表示
@SKILL_EXPLAIN_閃刀起動「エンゲージ」,ARG
PRINTL 【閃刀魔法】
PRINTL 자신과 링크되어 있는 링크체 전체를 회복시킨다.
PRINTL 대상이 빈사 상태일 경우는 부활시킨다.
PRINTL 스킬 발동 후 섬도 카운터를 1개 얻는다.
PRINTL
PRINTL 〈강화 효과〉 섬도 카운터가 3개 이상 있을 경우,
PRINTL 대신 HP를 완전 회복시키고 부활시킨다.
PRINTL 강화 효과 발동 후 섬도 카운터를 얻는 대신 3개 제거한다.
PRINTL
PRINTL 이 스킬은 전투 중 1회만 사용 가능.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_閃刀起動「エンゲージ」,ARG
#DIM DYNAMIC LCOUNT
RESULTS = 스킬 사용 완료
SIF !IS_USEABLE_閃刀魔法(ARG, "エンゲージ")
	RETURN 0
RETURN 1


@リンク不能_閃刀起動「エンゲージ」
RETURN 1

