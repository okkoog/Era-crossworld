;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_やすらぎの光,ARG
RESULTS = 평온의 빛

;　명중
@SKILL_HITRATE_やすらぎの光, ARG
RETURN 100

;　威力
@SKILL_POWER_やすらぎの光, ARG
RETURN 50

;　최저공격횟수
@SKILL_MINATTACKNUMBER_やすらぎの光,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_やすらぎの光,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_やすらぎの光, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_やすらぎの光,ARG
RETURN 6


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_やすらぎの光
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_やすらぎの光, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_やすらぎの光,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_やすらぎの光,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_やすらぎの光, ARG
RETURN GET_SKILL_EFFECT_NUM("상태회복")


;계승타입
@SKILL_SUCCESSION_TYPE_やすらぎの光
RETURN GET_SUCCESSION_NUM("회복")

;속도보정
@SKILL_SPEED_やすらぎの光, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_やすらぎの光
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_やすらぎの光, ARG = -1
RETURN 3

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_やすらぎの光, ARG, ARG:1, ARG:2
CALL CURE_STATE_SINGLE,ARG,POS(ARG:1),ARG:2,,0

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_やすらぎの光,ARG,ARG:1,ARG:2
CALL CURE_STATE_SINGLE,ARG,POS(ARG:1), ARG:2,1,0


;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_やすらぎの光, ARG
PRINTL 【숙성: 야타】의 성스러운 힘으로 부정함을 제거한다.
PRINTL 아군 1명의 CLOSE, POISON, PALYZE, CHARM을 회복한다.

@SKILL_EXPLAIN_TOOLTIP_やすらぎの光, ARG
RESULTS = 아군 1명의 FLY, DYING, ORGY, HEAT 이외의 상태이상을 회복한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_やすらぎの光,ARG
RETURN 1
;とくにない

;ターゲット条件
@SKILL_IS_VALID_TARGET_やすらぎの光,ARG, ARG:1
SIF POS(ARG) < 0
	RETURN 0
CALL SKILL_CURE_STATE_やすらぎの光,(CFLAG:(POS(ARG)):상태이상)
RETURN RESULT

;控えに使えるか
@SKILL_T_RESERVE_やすらぎの光, ARG
RETURN 0

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_やすらぎの光,ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT