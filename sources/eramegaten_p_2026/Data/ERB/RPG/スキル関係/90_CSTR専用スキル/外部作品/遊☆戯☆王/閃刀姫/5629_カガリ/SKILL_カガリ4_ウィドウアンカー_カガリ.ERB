;弁財天五弦琵琶がヒットした相手が強化を持っていた場合
;====================================================
@SKILL_TRIGGER_ACTIONABLE_ウィドウアンカー_カガリ,ARG,ARG:1
SIF ARG != FLAG:행동순1
	RETURN 0
;自身は対象外
SIF ARG == ARG:1
	RETURN 0
SIF !IS_PU_SKILL_入力行動(ARG, "ウィドウアンカー_カガリ")
	RETURN 0
SIF !GET_CREC_ACT(ARG, ARG:1, "HIT")
	RETURN 0
SIF GET_カジャンダ_MAX(ARG:1) <= 0
	RETURN 0
RETURN 1, CPOS(ARG:1)

