;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ウィドウアンカー_カガリ, ARG, ARG:1, ARG:2
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC TEMP_VALUE
#DIM DYNAMIC MAX_TEMP_VALUE
#DIMS DYNAMIC L_MES
IF !FLAG:총공격중
	CALL ATTACK_SKILL,ARG,ARG:1,ARG:2
	CALL PUSH_CEMETERY_閃刀魔法, ARG, "ウィドウアンカー"
	SIF GET_COUNT_閃刀カウンター(ARG) >= 3
		CALL PU_SKILLGAGE_D_SET, ARG, "ウィドウアンカー_カガリ", 1
ELSE
	IF PU_SKILLGAGE_D_GET(ARG, "ウィドウアンカー_カガリ") > 0
		FOR LCOUNT, 0, VARSIZE("BASE_KAJA_TABLE")
			TEMP_VALUE = CFLAG:POS(ARG:1):(BASE_KAJA_TABLE:LCOUNT + "강화")
			SIF TEMP_VALUE <= 0
				CONTINUE
			MAX_TEMP_VALUE = MAX(MAX_TEMP_VALUE, TEMP_VALUE)
			SIF L_MES != ""
				L_MES += "・"
			L_MES += BASE_KAJA_TABLE:LCOUNT
			CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), BASE_KAJA_TABLE:LCOUNT, -TEMP_VALUE, "단체", "NOMES"
			CALL SKILL_SET_カジャンダ, ARG, ARG, BASE_KAJA_TABLE:LCOUNT, TEMP_VALUE, "단체", "NOMES"
		NEXT
		IF MAX_TEMP_VALUE > 0
			CALL PRINT_HIT_MESSAGE, POS(ARG:1), "能力上昇解除", "L"
			CALL PRINT_HIT_MESSAGE, ARG, L_MES + "강화", "w"
		ELSE
			CALL PRINT_HIT_MESSAGE, POS(ARG:1), "効果なし", "w"
		ENDIF
	ELSE
		CALL SKILL_能力上昇解除, ARG, POS(ARG:1), "단체"
	ENDIF
ENDIF

