@ACTION_竜石のブレス,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;MAXBASE:ARG:마법위력 += MAXBASE:ARG:공격
;CFLAG:ARG:마법위력강화 += CFLAG:ARG:공격강화

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

