;====================================================
;トリガー発動条件
;
;詳しい仕様については資料フォルダの解説を参照してください
;====================================================
@SKILL_TRIGGER_ACTIONABLE_ランカセーブ,ARG,ARG:1
;ランカを詠唱中か？
SIF MAX(SKILLGAGE_D_GET(ARG, [[스킬:란카]]), SKILLGAGE_D_GET(ARG, [[스킬:란캄]]) , SKILLGAGE_D_GET(ARG, [[스킬:란카인]])) < 1
	RETURN 0

;一度ランカセーブは発動したか
SIF SKILLGAGE_D_GET(ARG, PU_SKILLNUM_GET(ARG, "ランカセーブ")) > 0
	RETURN 0

;発動したのは回復スキルか？
CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
SIF RESULT == 2 || RESULT == 5
	RETURN 1
RETURN 0

