;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ランカセーブ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

CALL SKILLGAGE_D_SET, ARG, SKILL_NUM, 2

CALL SKILLGAGE_D_ADD, ARG, [[스킬:란카]], 1
CALL SKILLGAGE_D_ADD, ARG, [[스킬:란캄]], 1
CALL SKILLGAGE_D_ADD, ARG, [[스킬:란카인]], 1

PRINTFORMW %CALLNAME:ARG%의 영창은 끊기지 않았다!


