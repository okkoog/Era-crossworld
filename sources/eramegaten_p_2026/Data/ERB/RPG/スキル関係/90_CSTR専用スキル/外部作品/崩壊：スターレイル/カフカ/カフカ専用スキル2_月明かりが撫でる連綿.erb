CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM
CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"月明かりが撫でる連綿"),1
SIF GET_STATE(CFLAG:POS(ARG:1):상태이상) != "GOOD"
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

