;スキル変化？用ランク
@SKILL_RANK_清潔を保つ, ARG = -1
RETURN 2

@SKILL_TURNSTART_清潔を保つ, ARG
SIF CFLAG:ARG:입력행동 != PU_SKILLNUM_GET(ARG, "清潔を保つ")
	RETURN 0
IF CFLAG:ARG:변동피타겟율 < 300 || CFLAG:ARG:피타겟비율변동지속턴수 == 0
	CFLAG:ARG:피타겟비율변동지속턴수 = 1
	CFLAG:ARG:변동피타겟율 = 300
ENDIF

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_清潔を保つ, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "追加命中強化"
			SIF CONVERT_SKILLNUM_TO_STR(L_P, SKILL_NUM) != "清潔を保つ"
				RETURN 0
			SIF IS_BADSTATE(L_TARGET, "GOOD")
				RETURN 0
			RETURN 999
	ENDSELECT
;自分が防御側
ELSE
ENDIF
RETURN 0

@SKILL_TAG_清潔を保つ
RESULTS = 젠제로 회피 스킬

