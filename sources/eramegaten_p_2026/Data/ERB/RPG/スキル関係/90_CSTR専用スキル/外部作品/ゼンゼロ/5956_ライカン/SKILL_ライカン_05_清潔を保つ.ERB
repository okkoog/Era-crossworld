;スキル名
@SKILL_NAME_清潔を保つ,ARG
RESULTS = 청결 유지

;　명중
@SKILL_HITRATE_清潔を保つ, ARG
RETURN 100

;　威力
@SKILL_POWER_清潔を保つ, ARG
SIF ARG < 0
	RETURN 90
CALL GET_SKILL_POWER_清潔を保つ(GET_ROLE_CFLAG_TAKEOVER(ARG, "回避スキルランク"))
RETURN RESULT

@GET_SKILL_POWER_清潔を保つ, ARG
SELECTCASE ARG
	CASE 15
		RESULT = 360
	CASE 11 TO 14
		RESULT = 300 + (ARG - 10) * 12
	CASE 10
		RESULT = 300
	CASE 2 TO 9
		RESULT = 60 + 30 * ARG
	CASE 0, 1
		RESULT = 90
	CASEELSE
		RESULT = 0
ENDSELECT
SIF ARG:1 == -1
	RETURN RESULT
RETURN RESULT * GET_CHARGE_POWER_月下遊猟(ARG:1) / 100

;;クリティカル率
@SKILL_CRITICAL_RATE_清潔を保つ, ARG
RETURN 5

;　최저공격횟수
@SKILL_MINATTACKNUMBER_清潔を保つ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_清潔を保つ,ARG
RETURN 5

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_清潔を保つ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_清潔を保つ,ARG
SIF ARG < 0
	RETURN 3
CALL GET_SKILL_COST_清潔を保つ(GET_ROLE_CFLAG_TAKEOVER(ARG, "回避スキルランク"))
RETURN RESULT

;　コストの量
@GET_SKILL_COST_清潔を保つ,ARG
SELECTCASE ARG
	CASE 15
		RETURN 24
	CASE 11 TO 14
		RETURN 19 + (ARG - 10)
	CASE 10
		RETURN 19
	CASE 1 TO 9
		RETURN 3 + ARG * 3 / 2
	CASE 0, 1
		RETURN 4
ENDSELECT


;　相性
;複合相性
@SKILL_TYPE_清潔を保つ,ARG
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "執事の教養")
	RETURN GET_TYPE_NUM("빙결"), GET_TYPE_NUM("타격")
ELSE
	RETURN GET_TYPE_NUM("빙결")
ENDIF
;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_清潔を保つ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
