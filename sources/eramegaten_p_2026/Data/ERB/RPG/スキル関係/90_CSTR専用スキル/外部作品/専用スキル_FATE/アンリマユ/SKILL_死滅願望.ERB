@ACTION_死滅願望,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"死滅願望")
IF SKILLGAGE_D_GET(ARG,SKILL_NUM) == 0
	PRINTFORMW ＞死滅願望　発動！
	CALL SKILLGAGE_D_SET,ARG,SKILL_NUM,6
ELSE
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;ターン開始時の処理
;====================================================
@SKILL_TURNSTART_死滅願望,ARG,ARG:1
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"死滅願望")
IF SKILLGAGE_D_GET(ARG,SKILL_NUM) > 1
	PRINTFORMW ＞사멸소원의 효과로 %CALLNAME:ARG%의 공격력이 올랐다!
	CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 8, "단체", "NOMES"
	;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 8)
;ELSEIF SKILLGAGE_D_GET(ARG,SKILL_NUM) == 1
;	PRINTFORMW ＞死滅願望の効果で%CALLNAME:ARG%は戦闘不能になった！
;	BASE:ARG:ＨＰ = 0
;	CALL DEAD_CHARA,ARG
;ELSE
ENDIF

;====================================================
;ターン終了時の処理
;====================================================
@SKILL_TURNEND_死滅願望,ARG,ARG:1
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"死滅願望")
IF SKILLGAGE_D_GET(ARG,SKILL_NUM) == 1
	PRINTFORMW ＞사멸소원의 효과로 %CALLNAME:ARG%(은)는 전투불능이 되었다!
	BASE:ARG:ＨＰ = 0
	CALL DEAD_CHARA,ARG,ARG
ENDIF






;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_死滅願望,ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"死滅願望")

IF SKILLGAGE_D_GET(ARG,SKILL_NUM) > 1
	RESULTS '= SET_COLOR_TAG(@"戦闘不能まで　残り{SKILLGAGE_D_GET(ARG,SKILL_NUM) - 1}ターン", "#dc143c")
	RETURN 3
ENDIF

;　説明文の表示
@SKILL_EXPLAIN_死滅願望,ARG
PRINTL 발동하면 6턴 동안 턴 개시 시 공격력이 계속해서 상승한다.
PRINTL 그 대가로서 6턴 후의 턴 개시 시 전투불능이 된다.
PRINTL

@SKILL_BATTLE_MAIN_TOOLTIP_死滅願望, ARG, ARG:1
IF SKILLGAGE_D_GET(ARG,ARG:1) > 1
	RESULTS = □死滅願望
	RESULTS:1 = 　전투불능까지 잔여 {SKILLGAGE_D_GET(ARG,ARG:1) - 1}턴
ENDIF

@SKILL_BATTLE_MAIN_FACE_TOOLTIP_死滅願望, ARG, ARG:1
IF SKILLGAGE_D_GET(ARG,ARG:1) > 1
	RESULTS = □死滅願望
	RESULTS:1 = 　턴 개시 시 공격력이 대폭 상승한다.
	RESULTS:2 = 　効果終了時に戦闘不能になる。
ENDIF
