		BAR_COLOR:1 = RESULT:1
		MAX_EFFECT_CONTINUE = 100 / 20
	CASE 2
		BAR_COLOR:0 = BARCOLORSET("青")
		BAR_COLOR:1 = RESULT:1
		MAX_EFFECT_CONTINUE = 100 / 20
	CASE 3
		BAR_COLOR:0 = BARCOLORSET("紫")
		BAR_COLOR:1 = RESULT:1
		MAX_EFFECT_CONTINUE = 100 / 12
	CASE 4
		BAR_COLOR:0 = BARCOLORSET("黄")
		BAR_COLOR:1 = RESULT:1
		MAX_EFFECT_CONTINUE = 100 / 25
ENDSELECT
IF PU_SKILLGAGE_D_GET(ARG, "竜石変化")
	RESULTS = %SET_COLOR_TAG(UNICODE(0x265E), TOSTR(BAR_COLOR:0))%
	RESULTS += HTML_RECT_SPLIT_BAR(PU_SKILLGAGE_D_GET(ARG, "竜石変化"), MAX_EFFECT_CONTINUE, BARLENS, BAR_COLOR, BAR_COLOR:1)
ELSE
	RESULTS = %SET_COLOR_TAG(UNICODE(0x272A), \@ PU_SKILLGAGE_F_GET(ARG, "竜石変化") >= 40 ? yellow # デフォルト\@)%
	RESULTS += HTML_RECT_BAR(PU_SKILLGAGE_F_GET(ARG, "竜石変化"), 100, BARLENS, BAR_COLOR, BAR_COLOR:1)
ENDIF
RESULTS:1 = 竜覚醒ゲージ
RETURN 1
;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_竜石変化,ARG,ARG:1
#LOCALSIZE 2
#DIM 竜石変化ゲージ用スキル番号
#DIM L_T
#DIM L_GP
竜石変化ゲージ用スキル番号 = PU_SKILLNUM_GET(ARG,"竜石変化")
;必要な装備をつけていない場合はゲージを獲得しない
SIF ITEMNAME:(EQUIP:ARG:악세서리) != "용석의목걸이"
	RETURN 0
;スキルゲージDがある＝発動中の場合離脱
SIF SKILLGAGE_D_GET(ARG,竜石変化ゲージ用スキル番号) > 0
	RETURN 0
SIF SKILLGAGE_F_GET(ARG,竜石変化ゲージ用スキル番号) == 100
	RETURN 0
L_GP = 0
;自分の行動の場合
IF ARG == ARG:1
	;行動するたびに10獲得
	L_GP += 10
	FOR LOCAL, 0, BCHARANUM
		L_T = BCHARA:LOCAL
		;味方への攻撃では増えないL
		SIF IS_FRIEND(ARG, L_T)
			CONTINUE
		;ダメージを与える毎に+5、さらにクリティカル・弱点は追加で+5
		SIF GET_CREC_ACT(ARG, L_T, "HIT")
			L_GP += 5
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 5
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 5
	NEXT
	;ダメージを受けた敵の数に応じてスキルゲージアップ
	;FOR LOCAL,0,CHARANUM
	;	SIF CFLAG:LOCAL:PT플래그 == CFLAG:ARG:PT플래그
	;		CONTINUE
	;	IF CFLAG:LOCAL:현데미지 > 0
	;		CALL SKILLGAGE_F_ADD,ARG,竜石変化ゲージ用スキル番号,5
	;	ELSE
	;		CONTINUE
	;	ENDIF
	;	;会心、弱点を出すとさらにアップ
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,21)
	;		CALL SKILLGAGE_F_ADD,ARG,竜石変化ゲージ用スキル番号,5
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,22)
	;		CALL SKILLGAGE_F_ADD,ARG,竜石変化ゲージ用スキル番号,5
	;NEXT
	;気合を入れても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:기합]]
		L_GP += 30
	;集中しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:컨센트레이트]]
		L_GP += 30
	;雄叫びしても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:포효]]
		L_GP += 30
	;挑発しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:도발]]
		CALL SKILLGAGE_F_ADD,ARG,竜石変化ゲージ用スキル番号,30
	;気合を入れても上がる
	;SIF CFLAG:ARG:입력행동 == 511
	;	CALL SKILLGAGE_F_ADD,ARG,竜石変化ゲージ用スキル番号,30
	;集中しても上がる
	;SIF CFLAG:ARG:입력행동 == 512
	;	CALL SKILLGAGE_F_ADD,ARG,竜石変化ゲージ用スキル番号,30
	;雄叫びしても上がる
	;SIF CFLAG:ARG:입력행동 == 514
	;	CALL SKILLGAGE_F_ADD,ARG,竜石変化ゲージ用スキル番号,30
	;挑発しても上がる
	;SIF CFLAG:ARG:입력행동 == 515
	;	CALL SKILLGAGE_F_ADD,ARG,竜石変化ゲージ用スキル番号,30
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える。増加量は最大体力に対するダメージ割合の２倍
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += MAX(200 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ, 2)
;IF CFLAG:ARG:현데미지 > 0 || GETBIT(CFLAG:ARG:受けフラグ,18) || GETBIT(CFLAG:ARG:受けフラグ,19)
;	LOCAL = 200 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ
;	LOCAL = LOCAL < 2 ? 2 # LOCAL
;	CALL SKILLGAGE_F_ADD,ARG,竜石変化ゲージ用スキル番号,LOCAL
;ENDIF
;スキルゲージが100以上だと100にする
CALL SKILLGAGE_F_SET,ARG,竜石変化ゲージ用スキル番号,MIN(100, L_GP + SKILLGAGE_F_GET(ARG,竜石変化ゲージ用スキル番号))
;SIF SKILLGAGE_F_GET(ARG,竜石変化ゲージ用スキル番号) > 100
;	CALL SKILLGAGE_F_SET,ARG,竜石変化ゲージ用スキル番号,100
;RETURN 0
IF SKILLGAGE_F_GET(ARG,竜石変化ゲージ用スキル番号) >= 40
	RESULTS = ＡＷＡＫＥＮＩＮＧ　ＲＥＡＤＹ！
	RESULT:1 = COLOR("YELLOW")
ELSE
	RESULTS = 竜覚醒
ENDIF
RESULTS:1 = \%
RETURN L_GP
@継承不能_竜石変化
RETURN 1

