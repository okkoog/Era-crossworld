
;スキル名
@SKILL_NAME_ピュアリフィケーション,ARG
RESULTS = ピュアリフィケーション

;　명중
@SKILL_HITRATE_ピュアリフィケーション, ARG
RETURN 100

;　威力
@SKILL_POWER_ピュアリフィケーション, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ピュアリフィケーション,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ピュアリフィケーション,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ピュアリフィケーション, ARG
SIF GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 4
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_ピュアリフィケーション,ARG
IF ARG >= 0 && GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 4
	RESULTS = %"ＣＨ:4"%
	RETURN 0
ENDIF
RETURN 25

;　相性
@SKILL_TYPE_ピュアリフィケーション,ARG
RETURN GET_TYPE_NUM("파마")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ピュアリフィケーション
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ピュアリフィケーション,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ピュアリフィケーション,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ピュアリフィケーション,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ピュアリフィケーション,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ピュアリフィケーション,ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;계승타입
@SKILL_SUCCESSION_TYPE_ピュアリフィケーション
RETURN GET_SUCCESSION_NUM("파마")

@SKILL_RANK_ピュアリフィケーション, ARG = -1
RETURN 9

;속도보정
@SKILL_SPEED_ピュアリフィケーション, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ピュアリフィケーション
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ピュアリフィケーション,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL SKILL_GUARD_KILL, ARG, "파마", ARG:1, 3, "短縮"
CALL SKILL_GUARD_KILL, ARG, "주살", ARG:1, 3, "短縮"
PRINTFORML [{ARG:1}]%CALLNAME:POS(ARG:1),20% >>>>> 3ターン、破魔と呪殺への耐性を無効化！

CALL SET_RPG_CFLAG_BTL, ARG, "KFチャージスキル", 4, "-="
;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_ピュアリフィケーション,ARG
PRINTL 対象の破魔属性と呪殺属性を3ターンの間無効化する。
PRINTL 使用時にチャージを4消費。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ピュアリフィケーション,ARG
IF GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 4
	RESULTS = チャージ不足
	RETURN 0
ENDIF
RETURN 1
