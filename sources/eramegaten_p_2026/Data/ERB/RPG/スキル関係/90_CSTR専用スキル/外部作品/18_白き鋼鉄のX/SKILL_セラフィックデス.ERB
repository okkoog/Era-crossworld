;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_セラフィックデス, ARG,ARG:1,SKILL_NUM
#LOCALSIZE 3
#DIM SKILL_NUM
#DIM 追撃スイッチ

追撃スイッチ = 0
SIF 現HP割合(ARG) < 34
	追撃スイッチ = 1

IF CFLAG:ARG:포지션 < 7
	LOCAL:1 = 7
	LOCAL:2 = 17 
ELSE
	LOCAL:1 = 1
	LOCAL:2 = 7
ENDIF

TFLAG:스킬용1 = 0
FOR LOCAL, LOCAL:1, LOCAL:2
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0
		CONTINUE
	SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
		CONTINUE
	CFLAG:ARG:타겟 = LOCAL
	CALL ATTACK_SINGLE, ARG, FLAG:LOCALS, SKILL_NUM
NEXT

IF BASE:ARG:ＨＰ > 0 && GET_STATE(CFLAG:ARG:상태이상) != "DYING" && 追撃スイッチ
	TFLAG:스킬용1 = 99
	IF SKILL_CHANGE(ARG, [[キャラ:창조주_X2]])
		IF CFLAG:ARG:PT플래그 > 0
			TRYCALLFORM BATTLE_MESSAGE_K5473, ARG
		ELSE
			TRYCALLFORM ENEMY_BATTLE_MESSAGE_K[[キャラ:창조주_X2]], ARG
		ENDIF
	ELSEIF SKILL_CHANGE(ARG, [[キャラ:입실론_X2]])
		IF CFLAG:ARG:PT플래그 > 0
			TRYCALLFORM BATTLE_MESSAGE_K5465, ARG
		ELSE
			TRYCALLFORM ENEMY_BATTLE_MESSAGE_K[[キャラ:입실론_X2]], ARG
		ENDIF
	ENDIF
	FOR LOCAL, LOCAL:1, LOCAL:2
		TFLAG:스킬용1 = 99
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS < 0
			CONTINUE
		SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
			CONTINUE
		;中央にいたら
		SELECTCASE LOCAL
		CASE 2, 5, 8, 9, 10, 13, 14, 15
			TFLAG:스킬용1 = 100
		CASEELSE
		ENDSELECT
		CALL ATTACK_SINGLE, ARG, FLAG:LOCALS, SKILL_NUM
	NEXT
ENDIF

CALL SKILLGAGE_D_SET, ARG, SKILL_NUM ,5
