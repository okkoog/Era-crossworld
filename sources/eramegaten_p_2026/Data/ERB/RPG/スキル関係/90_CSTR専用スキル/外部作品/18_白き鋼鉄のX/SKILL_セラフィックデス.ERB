;　相性
@SKILL_TYPE_セラフィックデス, ARG
#LOCALSSIZE 7
#LOCALSIZE 4

;複合相性
IF TFLAG:스킬용1 < 99
	SELECTCASE RAND:6
	CASE 0
		LOCALS = 화염
	CASE 1
		LOCALS = 질풍
	CASE 2
		LOCALS = 핵열
	CASE 3
		LOCALS = 비구
	CASE 4
		LOCALS = 빙결
	CASE 5
		LOCALS = 검격
	ENDSELECT
	
	SIF ARG < 0 || スキル属性表示中
		RETURN GET_TYPE_NUM(LOCALS)
	SIF CFLAG:ARG:타겟 > 16 || CFLAG:ARG:타겟 < 1
		RETURN GET_TYPE_NUM(LOCALS)
	LOCAL = POS(CFLAG:ARG:타겟)
	SIF LOCAL < 0
		RETURN GET_TYPE_NUM(LOCALS)
	RETURN GET_TYPE_NUM("화염"), GET_TYPE_NUM("질풍"), GET_TYPE_NUM("핵열"), GET_TYPE_NUM("비구"), GET_TYPE_NUM("빙결"), GET_TYPE_NUM("검격")
ELSE
	RETURN GET_TYPE_NUM("만능")
ENDIF

