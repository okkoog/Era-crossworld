;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_グレイマルキン,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM DYNAMIC LCOUNT
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	TSTR:스킬메시지추가효과 '= ""
	CALL SKILL_INVALID_WALL, ARG, POS(LCOUNT), "수호의방패", "短縮"
	CALL SKILL_SET_カジャンダ, ARG, POS(LCOUNT), "크리티컬", 4, "短縮"
	CALL PRINT_HIT_MESSAGE, POS(LCOUNT), TSTR:스킬메시지추가효과, "L"
NEXT
WAIT
