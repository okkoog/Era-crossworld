;スキル名
@SKILL_NAME_清楚な高嶺の花,ARG
RESULTS = 청초한 그림의 떡

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_清楚な高嶺の花, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_清楚な高嶺の花,ARG
RETURN 30

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_清楚な高嶺の花
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_清楚な高嶺の花,ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_清楚な高嶺の花,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_清楚な高嶺の花,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_清楚な高嶺の花,ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_清楚な高嶺の花, ARG = -1
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_清楚な高嶺の花,ARG,ARG:1,ARG:2
#DIM DYNAMIC LCOUNT
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	IF CFLAG:POS(LCOUNT):공격강화 > 0 && CFLAG:POS(LCOUNT):마법위력강화 > 0
		CALL SKILL_SET_カジャンダ, ARG, POS(LCOUNT), "攻撃・魔法威力", 8, "단체", "NOWAIT"
	ELSEIF CFLAG:POS(LCOUNT):공격강화 > 0
		CALL SKILL_SET_カジャンダ, ARG, POS(LCOUNT), "공격", 8, "단체", "NOWAIT"
	ELSEIF CFLAG:POS(LCOUNT):마법위력강화 > 0
		CALL SKILL_SET_カジャンダ, ARG, POS(LCOUNT), "마법위력", 8, "단체", "NOWAIT"
	ELSE
		CALL PRINT_HIT_MESSAGE, POS(LCOUNT), "効果なし"
	ENDIF
NEXT
WAIT

;　説明文の表示
@SKILL_EXPLAIN_清楚な高嶺の花,ARG
PRINTL 공격력이 상승 중인 아군의 공격력을 대폭 상승시킨다.
PRINTL 마법 위력이 상승 중인 아군의 마법 위력을 대폭 상승시킨다.

;　説明文の表示
@ENHANCE_SKILL_EXPLAIN_清楚な高嶺の花,ARG
RESULTS:0 '= "攻撃力が上昇している味方の攻撃力を大幅に上昇させる。"
RESULTS:1 += "魔法威力が上昇している味方の魔法威力を大幅に上昇させる。"
;使用条件
@SKILL_SPECIAL_ACTIONABLE_清楚な高嶺の花,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_清楚な高嶺の花, ARG = -1
RETURN 8
