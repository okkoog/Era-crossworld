;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_思考盗撮,ARG
RESULTS = 思考盗撮

;　명중
@SKILL_HITRATE_思考盗撮, ARG
RETURN 100

;　威力
@SKILL_POWER_思考盗撮, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_思考盗撮,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_思考盗撮,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_思考盗撮, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_思考盗撮,ARG
RETURN 15

;　相性
@SKILL_TYPE_思考盗撮,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_思考盗撮
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_思考盗撮,ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　사거리
@SKILL_RANGE_思考盗撮,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_思考盗撮,ARG
RETURN GET_SPHERE_NUM("적아군전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_思考盗撮,ARG
RETURN GET_SKILL_EFFECT_NUM("특수")


;계승타입
@SKILL_SUCCESSION_TYPE_思考盗撮
RETURN GET_SUCCESSION_NUM("지원")
;スキル変化？用ランク
@SKILL_RANK_思考盗撮, ARG = -1
RETURN 6

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_思考盗撮,ARG
RETURN GET_STATE_NUM("PANIC")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_思考盗撮,ARG
RETURN GET_TYPE_NUM("만능")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_思考盗撮,ARG
RETURN 999

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_思考盗撮,ARG
RETURN 999

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_思考盗撮,ARG,ARG:1,ARG:2
#DIM DYNAMIC L_CHARA
CALL SKILL_SET_カジャンダ, ARG, ARG, "명중/회피/クリティカル", 8, "단체", "NOWAIT"
CALL SINGLE_BADSTATE, ARG, ARG, ARG:2

;　 説明文の表示
@SKILL_EXPLAIN_思考盗撮, ARG
PRINTL 자신의 명중률과 회피율과 크리티컬률을 대폭 상승시키고, 나아가 만능 상성으로 PANIC을 부착한다.

@SKILL_EXPLAIN_TOOLTIP_思考盗撮, ARG
RESULTS = 자신의 명중률과 회피율과 크리티컬률을 대폭 상승시키고, 나아가 만능 상성으로 PANIC을 부착한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_思考盗撮,ARG
;パニックになっている場合は使わない
SIF IS_BADSTATE(ARG, "PANIC")
	RETURN 0
RETURN 1
;とくにない

