;====================================================
;トリガー発動条件
;====================================================
@SKILL_TRIGGER_ACTIONABLE_『毒手』,ARG,ARG:1
SIF ARG != FLAG:행동순1
	RETURN 0
;自身は対象外
SIF ARG == ARG:1
	RETURN 0
SIF !GET_CREC_ACT(ARG, ARG:1, "HIT")
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", CFLAG:ARG:입력행동, ARG
SIF GET_SUCCESSION(RESULT) != "타격"
	RETURN 0
RETURN 1, CPOS(ARG:1)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_『毒手』, ARG,ARG:1,ARG:2
CALL SINGLE_BADSTATE, ARG, POS(ARG:1), ARG:2

