;スキル名
@SKILL_NAME_ライトニングスフィア, ARG
IF SKILL_CHANGE(ARG, [[キャラ:데머즐]])
	RESULTS = 라이트닝 만다라
ELSE
	RESULTS = LIGHTNING SPHERE
ENDIF

;　명중
@SKILL_HITRATE_ライトニングスフィア, ARG
RETURN 150

;　威力
@SKILL_POWER_ライトニングスフィア, ARG
IF SKILL_CHANGE(ARG, [[キャラ:데머즐]])
	RETURN 150
ELSE
	SIF FLAG:확산플래그
		RETURN 175
	SIF CFLAG:ARG:고유게이지D1
		RETURN 155
	RETURN 300
ENDIF

