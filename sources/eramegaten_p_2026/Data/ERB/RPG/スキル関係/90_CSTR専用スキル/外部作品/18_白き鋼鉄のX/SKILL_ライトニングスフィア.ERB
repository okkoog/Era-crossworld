;　説明文の表示
@SKILL_EXPLAIN_ライトニングスフィア, ARG
#DIM DIVA_F
#DIM DIVA_H
DIVA_F = SKILLGAGE_F_GET(ARG, [[스킬:SONG OF DIVA]])
DIVA_H = SKILLGAGE_H_GET(ARG, [[스킬:SONG OF DIVA]])
PRINTFORML 전방에 뇌구를 발생시키는 %CALLNAME:ARG%의 SP 스킬.
PRINTL 　
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	PRINTL 적 단체와 주위에 전격 상성으로 대데미지를 준다. 후열 사용 가능.
	IF CFLAG:ARG:気合フラグ > 0
		;シュート！　マンダラー！化
		SETCOLOR 0x144ff4
		PRINTL 気合状態　射程拡大：Ｌ／拡散範囲：３
		RESETCOLOR
	ENDIF
ELSE
	PRINTL 적 단체에 전격 상성으로 대데미지를 준다. 후열 사용 불가.
	;マンダラー！化
	IF DIVA_H == 1
		SETCOLOR 0x1d9eff
		PRINTL SONG OF DIVA 발동 중: 후열 사용이 가능해지며, 뇌구를 발사하여 공격이 확산된다.
		RESETCOLOR
	ELSEIF DIVA_F == 1
		SETCOLOR 0x3f60a9
		PRINTL SONG OF DIVA 발동 중: 후열 사용이 가능해지며, 뇌구를 발사하여 공격이 확산된다.
		RESETCOLOR
	ENDIF
ENDIF
PRINTL 단 사용 후에는 쿠도스가 0이 되며, 재사용까지 2턴의 쿨타임이 필요하다.
PRINTL MP와는 별개로 SP를 1 소비한다.
PRINTL ※SP는 4턴에 1 회복되며, 전투 종료 후에 완전 회복된다.
PRINTL ※스킬 「뇌격린」을 소지하지 않은 경우 사용 불가.
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	SETCOLOR 0x144ff4
	PRINTL 번개의 렌즈 장비 중 25% 확률로 쿠도스·SP 소비를 회피
	PRINTL 　　　　　　　　　　기합 상태일 경우 사거리가 L로, 확산 범위가 확대된다
	RESETCOLOR
ENDIF

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ライトニングスフィア, ARG
#DIM SKILL_NUM
IF CFLAG:ARG:PT플래그 > 0
	SKILL_NUM = PU_SKILLNUM_GET(ARG, "ライトニングスフィア")
	SIF SKILLGAGE_D_GET(ARG, SKILL_NUM)
		RETURN 0
	SIF !HAVE_SKILL(ARG, [[스킬:뇌격린]])
		RETURN 0
	SIF SKILLGAGE_D_GET(ARG, [[스킬:뇌격린]]) > 8
		RETURN 0
	RETURN 1
ELSE
	RETURN 1
ENDIF

