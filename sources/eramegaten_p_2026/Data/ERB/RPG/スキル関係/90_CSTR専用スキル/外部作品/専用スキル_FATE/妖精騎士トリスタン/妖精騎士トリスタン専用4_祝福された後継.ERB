;====================================================
@SKILL_DAMAGE_EFFECT_祝福された後継,ARG,ARG:1,ARG:2
SIF ARG:2 < -1
	RETURN 0
CALL SKILL_GUARD_KILL, ARG, "신경", CPOS(ARG:1), CFLAG:ARG:PT플래그 ? 3 # 5, "短縮"

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_祝福された後継, ARG = -1, ARG:1 = -1
RETURN 4

@ACTION_祝福された後継, ARG,ARG:1,SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM
CALL SKILLGAGE_F_ADD, ARG, SKILL_NUM,1
CALL ATTACK_SINGLE, ARG, POS(ARG:1), SKILL_NUM
;CALL ATTACK_FIELD, ARG, SKILL_NUM, 1

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_祝福された後継, ARG
#LOCALSIZE 1
#DIM 祝福された後継残弾
祝福された後継残弾 = PU_SKILLNUM_GET(ARG, "祝福された後継")

PRINTL 적 1체에 3턴 가드킬 ＋ 완전관통 ＋ 3HIT 대 데미지  고확률로 신경 속성에 의한 즉사
PRINTL 딸로서 인정받은 그녀에게는 여왕 모르간과 동일한 지배의 왕권이 갖추어져 있다.
PRINTL 이름을 물려받은 기사와 마찬가지로, 왕에게 진언할 수 있을 정도의 공간 지배력을 지닌다
PRINTL 요정기사 트리스탄의 EX 스킬(CSTR 전용)

IF CFLAG:(CHARANUM-1):PT플래그 || ARG < 0 || ARG >= CHARANUM
	PRINTL 1회 출격당 5회까지 사용 가능
ELSE
	;残弾なし
	IF SKILLGAGE_F_GET(ARG, 祝福された後継残弾) > 4
		PRINTL 残弾　0発　使用不能
	;残弾あり
	ELSE
		PRINT 残弾　
		LOCAL = 5 - SKILLGAGE_F_GET(ARG, 祝福された後継残弾)
		PRINTV LOCAL
		PRINTL 発
	ENDIF
ENDIF

