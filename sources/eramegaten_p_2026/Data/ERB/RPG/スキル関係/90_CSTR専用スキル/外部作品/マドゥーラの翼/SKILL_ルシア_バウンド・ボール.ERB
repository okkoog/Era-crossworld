RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_バウンド・ボール,ARG
RETURN 12

;　相性
@SKILL_TYPE_バウンド・ボール,ARG
RETURN GET_TYPE_NUM("충격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_バウンド・ボール
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_バウンド・ボール,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_バウンド・ボール,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_バウンド・ボール,ARG
RETURN 3

