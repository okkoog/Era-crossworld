;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ER_エデンズフォース・オーバーロード,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
IF GET_RPG_CSTR_BTL(ARG, "エデンズリッター変身状態") == "起動"
	PRINTFORMW %CALLNAME:ARG%(은)는 변신했다!
ELSE
	PRINTFORMW %CALLNAME:ARG%(은)는 변신을 해제했다!
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;追加コマンド(一番下)
;====================================================
@INPUT_COM_NAME_ER_エデンズフォース・オーバーロード,ARG
RESULTS = ER_エデンズフォース・オーバーロード
IF GET_RPG_CSTR_BTL(ARG, "エデンズリッター変身状態") == "起動"
	RESULTS:1 = 릴리스
ELSE
	IF BASE:ARG:ＭＰ > MAXBASE:ARG:ＭＰ / 10
		RESULTS:1 = 오버로드
	ELSE
		RESULTS:1 = ＭＰ枯渇
	ENDIF
ENDIF
RETURN 2

@INPUT_COM_ABLE_ER_エデンズフォース・オーバーロード,ARG
SIF BASE:ARG:ＭＰ < MAXBASE:ARG:ＭＰ / 10
	RETURN -1
RETURN 1

;====================================================
;コマンド実行
;====================================================
@INPUT_COM_ER_エデンズフォース・オーバーロード,ARG
#LOCALSIZE 1
;起動時は解除
IF GET_RPG_CSTR_BTL(ARG, "エデンズリッター変身状態") == "起動"
	CALL SET_RPG_CSTR_BTL, ARG, "エデンズリッター変身状態", "해제" 
	SETCOLOR 0x999999
	PRINTFORML ┏>CHARA━━━━━━━━━━┓　┏>ACT━━━━━━━━━━━━━━━━━━┓
	PRINTFORM ┃[{CPOS(ARG),2}] %CALLNAME:ARG,21,LEFT%┃　┃
	PRINTFORM 에덴즈 에너지 릴리스
	PRINTFORML %RESULTS,14,LEFT%┃
	PRINTFORML ┗━━━━━━━━━━━━━┛　┗━━━━━━━━━━━━━━━━━━━━┛
	PRINTFORML
	PRINTFORMW %CALLNAME:ARG%(은)는 변신을 해제했다!
	FOR LOCAL, 0, 10
		IF C_BTL_EFFECT:(ARG):LOCAL != ""
			C_BTL_EFFECT:(ARG):LOCAL = ""
		ENDIF
	NEXT
	RESETCOLOR
;解除もしくは空欄だった場合起動状態へ
ELSE
	IF BASE:ARG:ＭＰ > MAXBASE:ARG:ＭＰ / 10
		CALL SET_RPG_CSTR_BTL, ARG, "エデンズリッター変身状態", "起動" 
		SETCOLOR 0x33ffcc
		PRINTFORML ┏>CHARA━━━━━━━━━━┓　┏>ACT━━━━━━━━━━━━━━━━━━┓
		PRINTFORM ┃[{CPOS(ARG),2}] %CALLNAME:ARG,21,LEFT%┃　┃
		PRINTFORM 에덴즈 포스 오버로드
		PRINTFORML %RESULTS,8,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━┛　┗━━━━━━━━━━━━━━━━━━━━┛
		PRINTFORML
		PRINTFORMW %CALLNAME:ARG%(은)는 에덴즈 리터로 변신했다!

		CALL SET_C_BTL_EFFECT_SINGLE, ARG, ARG, "エデンズフォース・オーバーロード"

		RESETCOLOR
	ELSE

		RETURN -1
	ENDIF
ENDIF
RETURN 0

