@SKILL_BATTLE_ENTER_師弟の絆, ARG
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC IS_DONE
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
	RETURN 0
;開幕はまとめて行う
IF TFLAG:입장캐릭터 == -1
	FOR LCOUNT, CFLAG:ARG:PT플래그 ? 1 # 7, CFLAG:ARG:PT플래그 ? 7 # 17
		SIF !IS_TARGET_ABLE(POS(LCOUNT))
			CONTINUE
		SIF ARG == POS(LCOUNT)
			CONTINUE
		SIF !STRCOUNT(CSTR:POS(LCOUNT):상성그룹,"黒魔術師")
			CONTINUE
		SIF IS_DONE == 0
			CALL PRINT_ACT_MESSAGE, ARG, , , , "師弟の絆"
		CALL SKILL_SET_カジャンダ, ARG, POS(LCOUNT), "마법위력", 4, "단체", "NOWAIT"
		IS_DONE = 1
	NEXT
	SIF IS_DONE
		WAIT
ELSE
	SIF ARG == TFLAG:입장캐릭터
		RETURN 0
	SIF !STRCOUNT(CSTR:(TFLAG:입장캐릭터):상성그룹,"黒魔術師")
		RETURN 0
	CALL PRINT_ACT_MESSAGE, ARG, , , , "師弟の絆"
	CALL SKILL_SET_カジャンダ, ARG, TFLAG:입장캐릭터, "마법위력", 4, "단체"
ENDIF
