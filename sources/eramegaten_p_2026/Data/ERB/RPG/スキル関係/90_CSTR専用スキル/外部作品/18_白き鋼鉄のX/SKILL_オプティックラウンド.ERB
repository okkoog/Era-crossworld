;スキル名
@SKILL_NAME_オプティックラウンド, ARG
RESULTS = 옵틱 라운드
IF FLAG:총공격중
	TSTR:스킬메시지행동자 = RoRo
	TFLAG:스킬행동자컬러 = 0x9933cd
ENDIF
;　명중
@SKILL_HITRATE_オプティックラウンド, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "オプティックラウンド")
IF SKILLGAGE_D_GET(ARG, SKILL_NUM) > 0
	RETURN 100
ELSE
	RETURN 95
ENDIF

;　威力
@SKILL_POWER_オプティックラウンド, ARG
#DIM SKILL_NUM
IF SKILL_CHANGE(ARG, [[キャラ:오토크롬_X2]])
	RETURN 210
ELSE
	IF SKILLGAGE_D_GET(ARG, SKILL_NUM) > 0
		IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "다크니스트리거Ｘ") && FLAG:총공격중
			;約1.25倍
			RETURN 370
		ELSE
			RETURN 300
		ENDIF
	ELSE
		RETURN 200
	ENDIF
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_オプティックラウンド, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_オプティックラウンド, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_オプティックラウンド, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_オプティックラウンド, ARG
;ダークネストリガー発動中はコスト1/3
SIF SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
	RETURN 5
RETURN 15

;　相性
@SKILL_TYPE_オプティックラウンド, ARG
RETURN GET_TYPE_NUM("비구"), GET_TYPE_NUM("핵열")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_オプティックラウンド
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_オプティックラウンド, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_オプティックラウンド, ARG
;ロック中の攻撃・ロック対象に強制
IF ARG >= 0 && NO:ARG == [[キャラ:아큐라_X]] && BLITZ_TARGET_JUDG(ARG) == 1
	RETURN 4
;非ロック中の攻撃・敵単体
ELSE
	RETURN 1
ENDIF

;　사거리
@SKILL_RANGE_オプティックラウンド, ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_オプティックラウンド, ARG
IF SKILL_CHANGE(ARG, [[キャラ:오토크롬_X2]])
	RETURN 2
ELSE
	;ロック中の攻撃・ロック対象に強制
	IF BLITZ_TARGET_JUDG(ARG) == 1
		RETURN 4
	;非ロック中の攻撃・敵単体
	ELSE
		RETURN 2
	ENDIF
ENDIF

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_オプティックラウンド, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_オプティックラウンド, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_オプティックラウンド
RETURN 0


