;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_オプティックラウンド, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 3
#DIM SKILL_NUM
#DIM ROCK_H
#DIM ループ用
#DIM 攻撃前敵カウント
#DIM 攻撃後敵カウント
#DIM 差分
#DIM 加算クードス

IF SKILL_CHANGE(ARG, [[キャラ:오토크롬_X2]])
	CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM
ELSE
	;攻撃前敵カウント = 0
	;攻撃後敵カウント = 0
	;IF CFLAG:ARG:PT플래그 > 0
	;	FOR ループ用, 7, 17
	;		LOCALS = 포지션{ループ用}
	;		SIF FLAG:LOCALS == -1
	;			CONTINUE
	;		SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
	;			CONTINUE
	;		攻撃前敵カウント += 1
	;	NEXT
	;ENDIF
	;ロック中かつロック対象が生存中なら強制的にロック対象へ攻撃
	IF ARG:1 == 23
		IF BLITZ_TARGET_JUDG(ARG) == 1
			SIF FLAG:총공격중
				TFLAG:반사후0데미지화 = 1
			ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
			CALL SKILLGAGE_D_SET, ARG, SKILL_NUM, 1
			CALL ATTACK_SINGLE, ARG, ROCK_H, SKILL_NUM
		ENDIF
	ELSE
		CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM
	ENDIF
	;撃破数1につき20の基礎クードスを得る。(上限100)
	加算クードス = MIN(GET_CREC_ACT_SUM(ARG, "적", "KILL"), 5) * 20
	CALL SET_加算クードス, ARG, 加算クードス
	;IF CFLAG:ARG:PT플래그 > 0
	;	FOR ループ用, 7, 17
	;		LOCALS = 포지션{ループ用}
	;		SIF FLAG:LOCALS == -1
	;			CONTINUE
	;		SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
	;			CONTINUE
	;		攻撃後敵カウント += 1
	;	NEXT
	;ENDIF
	
	;差分 = 攻撃前敵カウント - 攻撃後敵カウント
	
	;IF 差分 > 0
		;SELECTCASE 差分
		;CASE 1
		;	加算クードス = 20
		;CASE 2
		;	加算クードス = 40
		;CASE 3
		;	加算クードス = 60
		;CASE 4
		;	加算クードス = 80
		;CASEELSE
		;	加算クードス = 100
		;ENDSELECT
		;IF EQUIP:ARG:악세서리 == GETNUM(ITEM, "무모함의증거")
		;	TIMES 加算クードス, 1.25
		;ELSEIF EQUIP:ARG:악세서리 == GETNUM(ITEM, "무기력의부적")
		;	TIMES 加算クードス, 0.5
		;ENDIF
		;PRINTFORMW AERIAL EX　Kudos + {加算クードス}
		;CALL SKILLGAGE_F_ADD, ARG, [[스킬:블리츠대쉬]], 加算クードス
	;ENDIF
	;IF EQUIP:ARG:악세서리 == GETNUM(ITEM, "무기력의부적")
		;アパシーマンの上限は1200
		;SIF SKILLGAGE_F_GET(ARG, [[스킬:블리츠대쉬]]) > 1200
			;CALL SKILLGAGE_F_SET, ARG, [[스킬:블리츠대쉬]], 1200
	;ELSE
		;上限は99999
		;SIF SKILLGAGE_F_GET(ARG, [[스킬:블리츠대쉬]]) > 99999
			;CALL SKILLGAGE_F_SET, ARG, [[스킬:블리츠대쉬]], 99999
	;ENDIF
	
	;EXウェポン12番=オプティックラウンド
	SIF HAVE_SKILL(ARG, [[스킬:DARKNESS TRIGGER]])
	CALL SKILLGAGE_F_SET, ARG, [[스킬:DARKNESS TRIGGER]], 12
ENDIF
