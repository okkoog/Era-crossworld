;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_新生アルゴノーツ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM LCOUNT,3

LCOUNT:1 = CFLAG:ARG:PT플래그 > 0 ? 1 # 7
LCOUNT:2 = CFLAG:ARG:PT플래그 > 0 ? 7 # 17

FOR LCOUNT,LCOUNT:1,LCOUNT:2
    SIF !HAVE_PU_SKILL(POS(LCOUNT),"ノウブル・ファンタズム")
        CONTINUE
    CALL SKILL_SET_カジャンダ,ARG,POS(LCOUNT),"크리티컬",8,"단체"
NEXT



