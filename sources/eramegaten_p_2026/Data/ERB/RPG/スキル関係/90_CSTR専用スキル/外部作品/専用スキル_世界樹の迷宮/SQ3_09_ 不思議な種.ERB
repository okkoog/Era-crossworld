;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_不思議な種,ARG
TFLAG:스킬용1 = RAND:9
SELECTCASE TFLAG:스킬용1
    CASE IS < 2
      	RETURN GET_STATE_NUM("BIND")
    CASE IS < 4
    	  RETURN GET_STATE_NUM("PALYZE")
    CASE IS < 6
        RETURN GET_STATE_NUM("SLEEP")
    CASE IS < 8
        RETURN GET_STATE_NUM("PANIC")
    CASE 8
        RETURN GET_STATE_NUM("DYING")
ENDSELECT
;추가효과상성
@SKILL_ADDTIONAL_TYPE_不思議な種,ARG
SELECTCASE TFLAG:스킬용1
    CASE IS < 2
		  RETURN GET_TYPE_NUM("신경")
    CASE IS < 4
		  RETURN GET_TYPE_NUM("신경")
    CASE IS < 6
		  RETURN GET_TYPE_NUM("정신")
    CASE IS < 8
		  RETURN GET_TYPE_NUM("정신")
    CASE 8
		  RETURN GET_TYPE_NUM("만능")
ENDSELECT

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_不思議な種,ARG
IF TFLAG:스킬용1 == 8
    RETURN 100
ELSE
    RETURN 50
ENDIF
