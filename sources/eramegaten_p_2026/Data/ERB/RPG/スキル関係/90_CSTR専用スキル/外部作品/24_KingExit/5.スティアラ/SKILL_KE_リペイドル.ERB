;『リペイドル』
;회복＋状態異常の無効化。クソ強い。ただし重い
;


;スキル名
@SKILL_NAME_KE_リペイドル,ARG
RESULTS = 리페이들

;　명중
@SKILL_HITRATE_KE_リペイドル, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_リペイドル, ARG
RETURN 250

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_リペイドル,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_リペイドル,ARG
RETURN 1

;;一体辺りの最大ＨＩＴ数
;;※ランダム攻撃系に使う
;@SKILL_MAXATK_PER_KE_リペイドル,ARG
;RETURN 1

;;一体辺りの最低ＨＩＴ数
;;※ランダム攻撃系に使う
;@SKILL_MINATK_PER_KE_リペイドル,ARG
;RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_リペイドル, ARG
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 80
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_KE_リペイドル,ARG
IF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 80
	RESULTS = %" 80ＴＰ"%
	RETURN 0
ENDIF
RETURN 80


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_リペイドル
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_リペイドル,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_リペイドル,ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_KE_リペイドル,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_リペイドル,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_リペイドル,ARG
RETURN GET_SKILL_EFFECT_NUM("회복")

;속도보정
@SKILL_SPEED_KE_リペイドル, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_リペイドル
RETURN 1


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_リペイドル,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;ゲージ再回収できる様に起動前にTP50消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 50, "-="

CALL HEAL_FIELD, ARG, ARG:1, SKILL_NUM
CALL CURE_STATE_FIELD,ARG, ARG:1, SKILL_NUM

;Dゲージ4。使用後3ターン。
CALL SKILLGAGE_D_SET, ARG, PU_SKILLNUM_GET(ARG,"KE_リペイドル"),4

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_KE_リペイドル,ARG
IF PU_SKILLGAGE_D_GET(ARG,"KE_リペイドル") == 0
	RESULTS '= SET_COLOR_TAG(@"リペイドル：STAND BY！", "#ffef00")
ELSE
	RESULTS = 리페이들:CT{PU_SKILLGAGE_D_GET(ARG,"KE_リペイドル")}
ENDIF
RETURN 3

;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_KE_リペイドル,ARG
PRINTL 
PRINTL 하늘의 빛을 받아 아군 전체를 치유한다.
PRINTL 아군 전체를 회복하면서 상태이상을 회복한다.
PRINTL 
PRINTL 옥중 성직자 스티아라의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_リペイドル,ARG
IF TFLAG:전투중
	;クールタイムが0のときのみ
	SIF SKILLGAGE_D_GET(ARG, PU_SKILLNUM_GET(ARG, "KE_リペイドル")) != 0
		RETURN 0
	;ゲージが50以上のときのみ
	SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 50
		RETURN 0
ENDIF
RETURN 1

;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_KE_リペイドル, ARG, ARG:1, SKILL_NUM
#DIM SKILL_NUM

CALL HEAL_FIELD, ARG, ARG:1, SKILL_NUM
PRINTFORML 　　-리페이들에 의한 상태이상 회복-
CALL CURE_STATE_FIELD, ARG, ARG:1, SKILL_NUM

;控えに使えるか
@SKILL_T_RESERVE_KE_リペイドル, ARG
RETURN 0

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_KE_リペイドル, ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

@SKILL_EXPLAIN_TOOLTIP_KE_リペイドル, ARG
RESULTS:0 = 아군 전체를 회복하면서 상태이상을 회복한다.
RESULTS:1 = TP消費 50
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 50
	RESULTS:1 = %RESULTS:1%(不足)