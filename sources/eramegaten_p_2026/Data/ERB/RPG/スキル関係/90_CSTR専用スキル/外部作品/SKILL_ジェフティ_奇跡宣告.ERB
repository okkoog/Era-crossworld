;スキル名
@SKILL_NAME_奇跡宣告,ARG
RESULTS = 奇跡宣告

;　威力
@SKILL_POWER_奇跡宣告, ARG
RETURN 1000

@SKILL_HEAL_TYPE_奇跡宣告, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("割合")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_奇跡宣告
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_奇跡宣告,ARG
RETURN GET_SKILL_EFFECT_NUM("회복")

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_奇跡宣告, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")

;　コストの量
@SKILL_COST_奇跡宣告,ARG
RETURN 0

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_奇跡宣告,ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_奇跡宣告,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_奇跡宣告,ARG
RETURN GET_SPHERE_NUM("단체")

;　説明文の表示
@SKILL_EXPLAIN_奇跡宣告,ARG
PRINTL 전투 중 1회만 사용할 수 있다.
PRINTL 자신의 공격력과 명중률을 대폭 상승시키고, HP를 완전 회복한다.
PRINTL 이 스킬은 턴을 소비하지 않고, 즉시 발동한다.

@SKILL_EXPLAIN_TOOLTIP_奇跡宣告, ARG
RESULTS:0 = 전투 중 1회만 사용할 수 있다.
RESULTS:1 = 자신의 공격력과 명중률을 대폭 상승시키고, HP를 완전 회복한다.
RESULTS:2 = このスキルはターンを消費せず、即時発動する。

;====================================================
;スキル及び行動の実行
;====================================================
;即時発動
@SKILL_QUICK_ACTION_奇跡宣告, ARG
RETURN 1

@ACTION_奇跡宣告,ARG,ARG:1,ARG:2
CALL SKILL_SET_カジャンダ, ARG, ARG, "攻撃_命中", 8, "短縮", "NOMES"
CALL HEAL_SINGLE, ARG, ARG, ARG:2, 1, , "↑↑ 攻撃・命中率"
WAIT
CALL PU_SKILLGAGE_H_SET, ARG, "奇跡宣告", 1
;使用条件
@SKILL_SPECIAL_ACTIONABLE_奇跡宣告,ARG
RESULTS = 사용 완료
SIF PU_SKILLGAGE_H_GET(ARG, "奇跡宣告")
	RETURN 0
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_奇跡宣告, ARG = -1
RETURN 1