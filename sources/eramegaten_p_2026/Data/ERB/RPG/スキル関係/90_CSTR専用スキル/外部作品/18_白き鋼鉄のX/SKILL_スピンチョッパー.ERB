;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_スピンチョッパー
RETURN 0


;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_スピンチョッパー, ARG, ARG:1
#DIM SKILL_NUM
#DIM ROCK_H

;ダークネストリガー追撃条件共通
IF DTRIGGER_ABLE(ARG, "スピンチョッパー")
	ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
	SKILL_NUM = PU_SKILLNUM_GET(ARG, "スピンチョッパー")
	CALL SKILLGAGE_D_SET, ARG, SKILL_NUM, 1
	RETURN 1, 200000 + CPOS(ROCK_H)
ENDIF
RETURN 0
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_スピンチョッパー, ARG, ARG:1, SKILL_NUM
#DIM SKILL_NUM
#DIM ROCK_H
#DIM 加算クードス

SIF !FLAG:총공격중
	CALL ATTACK_SINGLE, ARG, POS(ARG:1), SKILL_NUM
;ロック中かつロック対象が生存中ならロック対象へ攻撃
IF BLITZ_TARGET_JUDG(ARG) == 1
	SIF FLAG:총공격중
		TFLAG:반사후0데미지화 = 1
	ROCK_H = SKILLGAGE_H_GET(ARG, [[스킬:블리츠대쉬]]) / 10
	CALL SKILLGAGE_D_SET, ARG, SKILL_NUM, 1
	CALL ATTACK_SINGLE, ARG, ROCK_H, SKILL_NUM
ENDIF

IF CFLAG:ARG:PT플래그 > 0
	;撃破数1につき20の基礎クードスを得る。(上限20)
	加算クードス = GET_CREC_ACT_SUM(ARG, "적", "KILL")
	CALL SET_加算クードス, ARG, 加算クードス
ENDIF

;EXウェポン7番=スピンチョッパー
SIF HAVE_SKILL(ARG, [[스킬:DARKNESS TRIGGER]])
	CALL SKILLGAGE_F_SET, ARG, [[스킬:DARKNESS TRIGGER]], 7
;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_スピンチョッパー, ARG
PRINTL 특수 프로펠러를 탑재한 워커 베스파의 능력을 재현한 EX 웨폰.
PRINTL HP를 소비하는 커맨드 「블리츠 대시」로 록온된 적이 있는 경우 공격 후 그 대상에게 추격을 가한다.
PRINTL (공격 대상과 록온 대상이 다른 경우에도 기능한다)
PRINTL 
PRINTL 적 단체에 검격과 질풍의 복합 상성으로 중데미지를 준다.
PRINTL 추가로 록온 상태인 적이 있는 경우 그 적에게 검격 상성으로 2회 소데미지를 주는 추격을 행한다.
IF ARG > 0 && ARG < CHARANUM && IS_CHARA_EQUIPED(ARG, "다크니스트리거Ｘ") && SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
	SETCOLOR 0x9933cd
	PRINTL 다크니스 트리거 X 장비 중 다크니스 트리거에 의한 추격 시의 데미지 상승
	RESETCOLOR
ENDIF
PRINTL ※이 스킬로 적을 격파했을 경우 쿠도스가 20 가산된다

