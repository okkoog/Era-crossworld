;スキル名
@SKILL_NAME_スピンチョッパー, ARG
RESULTS = 스핀 초퍼
IF FLAG:총공격중
	TSTR:스킬메시지행동자 = RoRo
	TFLAG:스킬행동자컬러 = 0x9933cd
ENDIF

;　명중
@SKILL_HITRATE_スピンチョッパー, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "スピンチョッパー")
IF SKILLGAGE_D_GET(ARG, SKILL_NUM) > 0
	RETURN 120
ELSE
	RETURN 100
ENDIF

;　威力
@SKILL_POWER_スピンチョッパー, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "スピンチョッパー")
IF SKILLGAGE_D_GET(ARG, SKILL_NUM) > 0
	IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "다크니스트리거Ｘ") && FLAG:총공격중
		;約1.25倍
		RETURN 160
	ELSE
		RETURN 130
	ENDIF
ELSE
	RETURN 250
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_スピンチョッパー, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "スピンチョッパー")
SIF SKILLGAGE_D_GET(ARG, SKILL_NUM) > 0
	RETURN 2
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_スピンチョッパー, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "スピンチョッパー")
SIF SKILLGAGE_D_GET(ARG, SKILL_NUM) > 0
	RETURN 2
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_スピンチョッパー, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_スピンチョッパー, ARG
;ダークネストリガー発動中はコスト1/3
SIF SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
	RETURN 5
RETURN 16

;　相性
@SKILL_TYPE_スピンチョッパー, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "スピンチョッパー")
IF SKILLGAGE_D_GET(ARG, SKILL_NUM) > 0
	RETURN GET_TYPE_NUM("검격")
ELSE
	RETURN GET_TYPE_NUM("검격"), GET_TYPE_NUM("질풍")
ENDIF

