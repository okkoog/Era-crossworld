;スキル名　クラススキル（聖剣３）。基本となる補助効果と、メインの攻撃を兼ねる、ゲージの代わりにリキャスト型に。
;CFLAG:ARG:900　クラスチェンジ２をどうしたか。１に光、２に闇のスキルをつける。
;901、902でクラス３，４を制御。これらが解禁されている時は威力を底上げ。
;0である可能性もあるので、なにもないときは追加もないスキルへ

@SKILL_NAME_クラス３スキル（聖剣３）,ARG
#DIM クラス技変数
クラス技変数 = PU_SKILLNUM_GET(ARG,"クラス２スキル（聖剣３）")
IF SKILL_CHANGE(ARG, [[キャラ:리스]])
	IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光"
		IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "光"
			RESULTS = 光弾槍
		ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "闇"
			RESULTS = 流星衝
		ELSE
			RESULTS = 旋風槍２
		ENDIF
	ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "闇"
		IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "光"
			RESULTS = 竜牙槍
		ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "闇"
			RESULTS = 百花乱舞
		ELSE
			RESULTS = 旋風槍２
		ENDIF
	ELSE
		RESULTS = 旋風槍２
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:샤를로트]])
	IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光"
		IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "光"
			RESULTS = 부채 촙
		ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "闇"
			RESULTS = 콰광
		ELSE
			RESULTS = 툭닥툭닥 2
		ENDIF
	ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "闇"
		IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "光"
			RESULTS = 엉망진창
		ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "闇"
			RESULTS = 거대화
		ELSE
			RESULTS = 툭닥툭닥 2
		ENDIF
	ELSE
		RESULTS = 툭닥툭닥 2
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:안젤라]])
	IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光"
		IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "光"
			RESULTS = 스파이럴 로드
		ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "闇"
			RESULTS = 댄싱 로드
		ELSE
			RESULTS = 더블 어택 2
		ENDIF
	ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "闇"
		IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "光"
			RESULTS = １０ｔ
		ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "闇"
			RESULTS = 핫 샷
		ELSE
			RESULTS = 더블 어택 2
		ENDIF
	ELSE
		RESULTS = 더블 어택 2
	ENDIF
ELSE
	RESULTS = 클래스 2 스킬 (성검 3)
ENDIF

