;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_クラス３スキル（聖剣３）,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#LOCALSIZE 4
#DIM クラス技変数
クラス技変数 = PU_SKILLNUM_GET(ARG,"クラス２スキル（聖剣３）")
IF SKILL_CHANGE(ARG, [[キャラ:리스]])
	;光時、攻撃前に強化
	IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光"
		CALL SKILL_SET_カジャンダ, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, "魔法威力_防御", 8, "範囲"
		;IF CFLAG:(ARG):PT플래그 == 0
		;	LOCAL:1 = 7
		;	LOCAL:2 = 17
		;ELSE
		;	LOCAL:1 = 1
		;	LOCAL:2 = 7
		;ENDIF

		;FOR LOCAL,LOCAL:1,LOCAL:2
		;	SIF POS(LOCAL) < 0
		;		CONTINUE
		;	CFLAG:POS(LOCAL):마법위력강화 = MIN(32, CFLAG:POS(LOCAL):마법위력강화 + 8)
		;	CFLAG:POS(LOCAL):방어강화 = MIN(32, CFLAG:POS(LOCAL):방어강화 + 8)
		;NEXT
		;PRINTFORMW \@ CFLAG:ARG:PT플래그 == 0 ? 敵 # 味方 \@の魔法威力・防御が大幅にアップ！
	ENDIF
	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
ELSEIF SKILL_CHANGE(ARG, [[キャラ:샤를로트]])
	;光の場合自動ディア発動
	IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光"
		IF CFLAG:(ARG):PT플래그
			LOCAL:1 = 1
			LOCAL:2 = 7
		ELSE
			LOCAL:1 = 7
			LOCAL:2 = 17
		ENDIF
		FOR LOCAL,LOCAL:1,LOCAL:2
			SIF POS(LOCAL) < 0
				CONTINUE
			SIF GET_STATE(CFLAG:POS(LOCAL):상태이상) == "DYING"
				CONTINUE
			CALL HEAL_SINGLE,ARG,POS(LOCAL),401
		NEXT
	ENDIF
	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
ELSEIF SKILL_CHANGE(ARG, [[キャラ:안젤라]])
	;光の場合無条件魔力UP
	SIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光"
		CALL SKILL_SET_カジャンダ, ARG, ARG, "마법위력", 4, "단체"
		;CFLAG:ARG:마법위력강화 = MIN(32, CFLAG:ARG:마법위력강화 + 4)
	CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM;		拡散攻撃
ENDIF
	;リキャストセット、数値は５＝４ターン
CALL SKILLGAGE_D_SET,ARG,クラス技変数,5

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_クラス３スキル（聖剣３）,ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:리스]]
	;光
	IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光"
		;光光
		IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "光"
			PRINTL 『光弾槍』
