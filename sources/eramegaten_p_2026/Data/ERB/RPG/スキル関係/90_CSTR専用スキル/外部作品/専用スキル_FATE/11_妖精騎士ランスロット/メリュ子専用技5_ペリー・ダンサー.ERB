;ターン終了時に行う処理
@SKILL_TURNEND_ペリー・ダンサー,ARG
#DIM SKILL_NUM
#DIM L_F_GAGE
SKILL_NUM = PU_SKILLNUM_GET(ARG,"ペリー・ダンサー")
L_F_GAGE = SKILLGAGE_F_GET(ARG,SKILL_NUM)
SIF L_F_GAGE == 0
	RETURN 0
L_F_GAGE += L_F_GAGE > 0 ? -1 # 1
IF L_F_GAGE == 0 && SKILLGAGE_F_GET(ARG,SKILL_NUM) > 0
	PRINTFORMW %CALLNAME:ARG%의 페리 댄서 추가 효과가 종료되었다….
	L_F_GAGE = -2
ENDIF
CALL SKILLGAGE_F_SET(ARG,SKILL_NUM,L_F_GAGE)

