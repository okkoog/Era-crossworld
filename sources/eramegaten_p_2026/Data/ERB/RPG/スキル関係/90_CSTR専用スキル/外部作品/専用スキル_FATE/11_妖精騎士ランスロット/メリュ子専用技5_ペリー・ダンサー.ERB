;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_ペリー・ダンサー, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM L_NUM,2

SIF SKILLGAGE_F_GET(L_P,SKILL_NUM) < 1
	RETURN 0

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;クリティカル率が(1.35 + 味方全体のクリティカル強化値)倍になる
		CASE "クリティカル補正A"
			VARSET L_NUM
			FOR L_NUM:0,CFLAG:L_P:PT플래그 > 0 ? 1 # 7,CFLAG:L_P:PT플래그 > 0 ? 7 # 17
				SIF POS(L_NUM:0) > -1
					L_NUM:1 += CFLAG:POS(L_NUM:0):크리티컬강화
			NEXT
			RETURN 35 + L_NUM:1
	ENDSELECT
ENDIF
RETURN 0