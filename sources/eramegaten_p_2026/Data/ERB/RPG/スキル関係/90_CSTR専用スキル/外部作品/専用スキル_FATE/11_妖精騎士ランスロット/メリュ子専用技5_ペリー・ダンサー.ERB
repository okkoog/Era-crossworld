;スキル及び行動の実行
;====================================================
@ACTION_ペリー・ダンサー,ARG,ARG:1,SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

SKILL_NUM = PU_SKILLNUM_GET(ARG,"ペリー・ダンサー")
CALL SKILL_SET_カジャンダ, ARG, ARG, "크리티컬", 4, "단체","NOWAIT"

IF SKILLGAGE_F_GET(ARG,SKILL_NUM) == 0
	PRINTFORML 4턴 동안 %CALLNAME:ARG%의 스킬이 크리티컬이 발생하기 쉬워졌다!
	CALL SKILLGAGE_F_SET,ARG,SKILL_NUM,4
ENDIF
WAIT
