;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_公式かつ機密
RETURN 0



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_公式かつ機密,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
IF FLAG:악마해석률상승불가플래그 || SOFT_ON("마인드시커")
	CALL PRINT_HIT_MESSAGE, POS(ARG:1), "효과가 없었다！", "w"
ELSEIF ANALYSIS_RATE:(NO:(ARG:1)) >= ANALYSIS_COMPLETED
	CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "공격/방어/마법위력/마법효과/명중/회피", -8, "단체"
ELSE
	CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "공격/방어/마법위력/마법효과/명중/회피", -4, "단체"
ENDIF
;強制モード転落
CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"),0

;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_公式かつ機密,ARG
PRINTL 적 단체를 그 해석도에 비례해 약체화시킨다.
PRINTL 
PRINTL 방대한 기밀 정보가 정리된 파일철로, 방심하거나 저항 판정에 실패한 상대의 약점이나 비밀이 기록되어 있다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_公式かつ機密,ARG
SIF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")) > 0
	RETURN 1
RETURN 0

