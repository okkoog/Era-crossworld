@SKILL_ACTION_AT_SWITCHING_ダルク_大霊術－「一輪」, L_P, L_T
#DIM DYNAMIC L_P
#DIM DYNAMIC L_T
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC IS_DONE
#DIMS DYNAMIC TEMPS
SETCOLOR COLOR("FRIEND")
CALL PRINT_ACT_MESSAGE, L_P, , , , "大霊術－「一輪」", "NOWAIT"
CALL SET_C_BTL_EFFECT_SINGLE, L_P, L_T, "呪殺無効化", , , , "NOWAIT"
CALL SYNC_STATUS_TYPE, L_T
IF HAVE_大霊術(L_T)
	FOR LCOUNT, 0, VARSIZE("KAJA_TABLE")
		IF KAJA_TABLE:LCOUNT == "BS부착률"
			SIF CFLAG:L_P:(KAJA_TABLE:LCOUNT + "강화") >= 0
				CONTINUE
			CALL SKILL_SET_カジャンダ, L_P, L_T, KAJA_TABLE:LCOUNT, -CFLAG:L_P:(KAJA_TABLE:LCOUNT + "강화"), "단체", "NOMES"
		ELSE
			SIF CFLAG:L_P:(KAJA_TABLE:LCOUNT + "강화") <= 0
				CONTINUE
			CALL SKILL_SET_カジャンダ, L_P, L_T, KAJA_TABLE:LCOUNT, CFLAG:L_P:(KAJA_TABLE:LCOUNT + "강화"), "단체", "NOMES"
		ENDIF
		CFLAG:L_P:(KAJA_TABLE:LCOUNT + "강화") = 0
		IS_DONE = 1
	NEXT
ENDIF
SIF IS_DONE
	CALL PRINT_HIT_MESSAGE, L_T, "能力強化を譲渡", "L"
WAIT
RESETCOLOR

@SKILL_RANK_ダルク_大霊術－「一輪」, ARG = -1
RETURN 8