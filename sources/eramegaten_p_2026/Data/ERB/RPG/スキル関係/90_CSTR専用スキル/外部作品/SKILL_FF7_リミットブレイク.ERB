;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_リミットブレイク（ＦＦ７）,ARG,ARG:1
#DIM リミットゲージ
#LOCALSIZE 1
#DIM L_T
#DIM L_GP
リミットゲージ = PU_SKILLNUM_GET(ARG,"リミットブレイク（ＦＦ７）")
;スキルゲージDがある＝発動中の場合でも貯まる。
;SIF SKILLGAGE_D_GET(ARG,リミットゲージ) > 0
;RETURN 0
SIF SKILLGAGE_F_GET(ARG,リミットゲージ) == 100
	RETURN 0
L_GP = 0
;自分の行動の場合
IF ARG == ARG:1
	L_GP += 5
	;プレミアムハートを所持時、更に＋５
	SIF IS_CHARA_EQUIPED(ARG, "프리미엄하트") 
		L_GP += 5
	FOR LOCAL, 0, BCHARANUM
		L_T = BCHARA:LOCAL
		SIF IS_FRIEND(ARG, L_T)
			CONTINUE
		SIF GET_CREC_ACT(ARG, L_T, "HIT")
			L_GP += 5
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 10
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 10
	NEXT
	;気合を入れても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:기합]]
		L_GP += 10
	;集中しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:컨센트레이트]]
		L_GP += 10
	;雄叫びしても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:포효]]
		L_GP += 10
	;挑発しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:도발]]
		L_GP += 10

	;CALL SKILLGAGE_F_ADD,ARG,リミットゲージ,5
	;ティファがプレミアムハートを所持時、更に＋５
	;SIF SKILL_CHANGE(ARG, [[キャラ:티파]]) && EQUIP:ARG:검 == 2389
	;	CALL SKILLGAGE_F_ADD,ARG,リミットゲージ,5
	;ダメージを受けた敵の数に応じてスキルゲージアップ
	;FOR LOCAL,0,CHARANUM
	;	SIF CFLAG:LOCAL:PT플래그 == CFLAG:ARG:PT플래그
	;		CONTINUE
	;	IF CFLAG:LOCAL:현데미지 > 0
	;		CALL SKILLGAGE_F_ADD,ARG,リミットゲージ,5
	;	ELSE
	;		CONTINUE
	;	ENDIF
	;	;会心、弱点を出すとさらにアップ
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,21)
	;		CALL SKILLGAGE_F_ADD,ARG,リミットゲージ,10
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,22)
	;		CALL SKILLGAGE_F_ADD,ARG,リミットゲージ,10
	;NEXT
	;気合を入れても上がる
	;SIF CFLAG:ARG:입력행동 == 511
	;	CALL SKILLGAGE_F_ADD,ARG,リミットゲージ,10
	;集中しても上がる
	;SIF CFLAG:ARG:입력행동 == 512
	;	CALL SKILLGAGE_F_ADD,ARG,リミットゲージ,10
	;雄叫びしても上がる
	;SIF CFLAG:ARG:입력행동 == 514
	;	CALL SKILLGAGE_F_ADD,ARG,リミットゲージ,10
	;挑発しても上がる
	;SIF CFLAG:ARG:입력행동 == 515
	;	CALL SKILLGAGE_F_ADD,ARG,リミットゲージ,10

ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える。増加量は最大体力に対するダメージ割合の３倍
;IF CFLAG:ARG:현데미지 > 0 || GETBIT(CFLAG:ARG:受けフラグ,18) || GETBIT(CFLAG:ARG:受けフラグ,19)
IF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += MAX(300 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ, 2)
	;LOCAL = 300 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ
	;LOCAL = LOCAL < 2 ? 2 # LOCAL
	;CALL SKILLGAGE_F_ADD,ARG,リミットゲージ,LOCAL
ENDIF
;ゲージ上限100
CALL SKILLGAGE_F_SET,ARG,リミットゲージ,MIN(100, L_GP + SKILLGAGE_F_GET(ARG,リミットゲージ))
;SIF SKILLGAGE_F_GET(ARG,リミットゲージ) > 100
;	CALL SKILLGAGE_F_SET,ARG,リミットゲージ,100
IF SKILLGAGE_F_GET(ARG,リミットゲージ) == 100
	RESULTS = ＬＩＭＩＴ ＢＲＥＡＫ！
	RESULT:1 = COLOR("YELLOW")
ELSE
	RESULTS = LIMIT GAGE
ENDIF
RESULTS:1 = \%
RETURN L_GP
