;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_リミットブレイク（ＦＦ７）,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM リミットゲージ
リミットゲージ = PU_SKILLNUM_GET(ARG,"リミットブレイク（ＦＦ７）")
IF SKILL_CHANGE(ARG, [[キャラ:티파]])
	FLAG:확산플래그 = 1
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
	PRINTFORML 　
	FLAG:확산플래그 = 0
ELSE
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
ENDIF

;使用したリミットゲージをクリア
CALL SKILLGAGE_F_SET,ARG,リミットゲージ,0

