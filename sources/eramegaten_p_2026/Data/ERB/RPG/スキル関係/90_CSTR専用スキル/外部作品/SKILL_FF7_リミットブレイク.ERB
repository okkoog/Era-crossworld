;　威力
@SKILL_POWER_リミットブレイク（ＦＦ７）, ARG
IF SKILL_CHANGE(ARG, [[キャラ:티파]])
	SIF ARG == -1
		RETURN 100
	;実際の攻撃威力計算時、ランダムで０．８倍、１倍、１．２５倍にチェンジ。配分基準はレベルに応じて強化
	;レベル＋１００までのランダム。イェア率は基本的に低く、Lv25から解禁。レベルが上がるほど出やすくなる。
	IF FLAG:확산플래그 == 1
		SIF FLAG:공격횟수 == 0
			PRINTFORM 　장타 러시　　　＞
		SIF FLAG:공격횟수 == 1
			PRINTFORM 　섬머솔트　　　＞
		SIF FLAG:공격횟수 == 2
			PRINTFORM 　물수제비 차기　＞
		SIF FLAG:공격횟수 == 3
			PRINTFORM 　메테오 드라이브　＞
		SIF FLAG:공격횟수 == 4
			PRINTFORM 　돌핀 블로우　＞
		SIF FLAG:공격횟수 == 5
			PRINTFORM 　미티어스트라이크　＞
		SIF FLAG:공격횟수 == 6
			PRINTFORM 　파이널 헤븐　＞
		LOCAL = RAND:(100 + BASE:ARG:LV)
		IF LOCAL < 20
			SETCOLOR 0xff0033
				PRINTFORM Miss 　
			RESETCOLOR
			RETURN 80
		ELSEIF LOCAL < 124
			SETCOLOR 0x009e25
				PRINTFORM Hit　　
			RESETCOLOR
			RETURN 100
		ELSE
			SETCOLOR 0xff6c00
				PRINTFORM Yeah!　
			RESETCOLOR
			RETURN 125
		ENDIF
	;実際の攻撃ではない時の一旦の表示用
	ELSE
		RETURN 100
	ENDIF
ELSE
	RETURN 100
ENDIF

