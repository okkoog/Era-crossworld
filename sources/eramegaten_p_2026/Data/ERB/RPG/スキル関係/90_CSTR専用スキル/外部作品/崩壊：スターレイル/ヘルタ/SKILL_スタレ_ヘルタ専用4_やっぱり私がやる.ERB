;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_やっぱり私がやる,ARG
RETURN GET_STATE_NUM("FREEZE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_やっぱり私がやる,ARG
RETURN GET_TYPE_NUM("빙결")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_やっぱり私がやる,ARG
RETURN 15

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_やっぱり私がやる,ARG
RETURN 95

;====================================================
;トリガー発動条件
;
;詳しい仕様については資料フォルダの解説を参照してください
;====================================================
@SKILL_TRIGGER_ACTIONABLE_やっぱり私がやる,ARG,ARG:1
#DIM LCOUNT
;ターン中に一回しか発動しない
SIF GET_RPG_CFLAG_BTL(ARG, "やっぱり私がやる使用ターン")  == FLAG:경과턴수 + 1
    RETURN 0
;1戦闘10回まで使用できる
SIF GET_RPG_CFLAG_BTL(ARG, "やっぱり私がやる使用回数") > 10
    RETURN 0
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
    RETURN 0
;入力可能な状態じゃないとだめ
SIF !ACTIONABLE_CHARA_F(ARG)
    RETURN 0
;味方の攻撃でも誘発する
SIF !IS_FRIEND(FLAG:행동순1, ARG)
    RETURN 0
SIF IS_FRIEND(ARG, ARG:1)
    RETURN 0
;命中してないとダメ
SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "HIT")
    RETURN 0
;殺したらダメ
SIF GET_CREC_ACT(FLAG:행동순1, ARG:1, "KILL")
    RETURN 0
;HP50%以下か？
SIF 現HP割合(ARG:1) > 50
    RETURN 0

;全部通ったのでカウントする。
CALL SET_RPG_CFLAG_BTL, ARG, "やっぱり私がやる使用回数", 1, "ADD"
CALL SET_RPG_CFLAG_BTL, ARG, "やっぱり私がやる使用ターン", FLAG:경과턴수 + 1 , "SET"
;敵全体を追撃対象に
RETURN 1,22
;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_やっぱり私がやる, ARG = -1, ARG:1 = -1
RETURN 4

