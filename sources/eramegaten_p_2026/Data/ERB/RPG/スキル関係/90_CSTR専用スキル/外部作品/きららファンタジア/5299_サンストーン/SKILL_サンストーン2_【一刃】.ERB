
;スキル名
@SKILL_NAME_【一刃】,ARG
IF ARG < 0 || !TFLAG:전투중 || !HAVE_PU_SKILL(ARG,"【一刃】")
	RESULTS = 【一刃】
ELSE
	RESULTS '= GET_SKILL_サンストーン_構え(ARG)
	SELECTCASE PU_SKILLGAGE_D_GET(ARG,"【一刃】")
		CASE 0
			RESULTS += "【一刃】"
		CASE 1
			RESULTS += "【二襲】"
		CASE 2
			RESULTS += "【三破】"
		CASE 3
			RESULTS += "【四撃】"
	ENDSELECT
ENDIF

;　명중
@SKILL_HITRATE_【一刃】, ARG
RETURN 100

;　威力
@SKILL_POWER_【一刃】, ARG
IF ARG == -1 || !HAVE_PU_SKILL(ARG,"【一刃】")
	RETURN 200
ELSE
	IF HAVE_PU_SKILL(ARG, "真実の手【右手】")
		IF GET_SKILL_サンストーン_構え(ARG) == "落日"
			SELECTCASE PU_SKILLGAGE_D_GET(ARG,"【一刃】")
				CASE 0
					RETURN 450
				CASE 1
					RETURN 490
				CASE 2
					RETURN 530
				CASE 3
					RETURN 570
			ENDSELECT
		ELSE
			SELECTCASE PU_SKILLGAGE_D_GET(ARG,"【一刃】")
				CASE 0
					RETURN 420
				CASE 1
					RETURN 460
				CASE 2
					RETURN 500
				CASE 3
					RETURN 540
			ENDSELECT
		ENDIF
	ELSE
		IF GET_SKILL_サンストーン_構え(ARG) == "落日"
			SELECTCASE PU_SKILLGAGE_D_GET(ARG,"【一刃】")
				CASE 0
					RETURN 150
				CASE 1
					RETURN 180
				CASE 2
					RETURN 210
				CASE 3
					RETURN 240
			ENDSELECT
		ELSE
			SELECTCASE PU_SKILLGAGE_D_GET(ARG,"【一刃】")
				CASE 0
					RETURN 130
				CASE 1
					RETURN 160
				CASE 2
					RETURN 190
				CASE 3
					RETURN 220
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
@SKILL_CRITICAL_RATE_【一刃】, ARG
