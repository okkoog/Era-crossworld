	RETURN 12
RETURN 1

;속도보정
@SKILL_SPEED_【一刃】, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_【一刃】
RETURN 0

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_【一刃】, ARG = -1, ARG:1 = -1
RETURN 0

;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_【一刃】,ARG,ARG:1,ARG:2
SIF ARG:1 < 0
	RETURN 0
SIF ARG:2 < -1
	RETURN 0
IF GET_SKILL_サンストーン_構え(ARG) == "白夜"
	SELECTCASE PU_SKILLGAGE_D_GET(ARG,"【一刃】")
		CASE 0
			CALL SKILL_SET_カジャンダ, ARG, ARG:1, "마법효과", -4, "短縮"
		CASE 1
			CALL SKILL_SET_カジャンダ, ARG, ARG:1, "회피", -4, "短縮"
		CASE 2
			CALL SKILL_SET_カジャンダ, ARG, ARG:1, "BS부착률", 4, "短縮"
		CASE 3
			CALL SKILL_SET_カジャンダ, ARG, ARG:1, "방어", -4, "短縮"
	ENDSELECT
ENDIF

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_【一刃】,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM
CALL SKILLGAGE_D_ADD, ARG, SKILL_NUM ,2
SIF SKILLGAGE_D_GET(ARG,SKILL_NUM) == 5
	CALL SKILLGAGE_D_SET, ARG, SKILL_NUM ,0
;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_【一刃】,ARG
PRINTL 적 단체에 검격 속성의 데미지를 준다. 사용할 때마다 위력과 소비량이 상승한다.
PRINTL 【4격】 사용 후에는 【1인】으로 돌아간다.
PRINTL 발동 시의 자세에 따라 추가 효과가 발생한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_【一刃】, ARG
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_【一刃】, ARG
RESULTS:0 = 적 단체에 검격 속성의 데미지를 준다. 사용할 때마다 위력과 소비량이 상승한다.
RESULTS:1 = 발동 시의 자세에 따라 추가 효과가 발생한다.

@GET_SKILL_サンストーン_構え, ARG
#FUNCTIONS
SIF HAVE_PU_SKILL(ARG,"暁光の構え") && PU_SKILLGAGE_H_GET(ARG,"暁光の構え") > 0
	RETURNF "暁光"
SIF HAVE_PU_SKILL(ARG,"白夜の構え") && PU_SKILLGAGE_H_GET(ARG,"白夜の構え") > 0
	RETURNF "白夜"
SIF HAVE_PU_SKILL(ARG,"落日の構え") && PU_SKILLGAGE_H_GET(ARG,"落日の構え") > 0
	RETURNF "落日"
RETURNF ""