;スキル名
@SKILL_NAME_マルチロール,ARG
RESULTS = 멀티롤

;　威力
@SKILL_POWER_マルチロール, ARG
SIF ARG < 0 || GET_RPG_CSTR_BTL(ARG, "セメタリー") == ""
	RETURN 90
RETURN 90 + 60 * (1 + STRCOUNT(GET_RPG_CSTR_BTL(ARG, "セメタリー"), "/"))

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_マルチロール, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_マルチロール,ARG
RETURN 20

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_マルチロール,ARG
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

@SKILL_HEAL_TYPE_マルチロール, ARG = -1
RETURN GET_SKILL_HEAL_TYPE_NUM("통상")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_マルチロール, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_マルチロール,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_マルチロール,ARG
RETURN GET_SKILL_EFFECT_NUM("회복")

;계승타입
@SKILL_SUCCESSION_TYPE_マルチロール
RETURN GET_SUCCESSION_NUM("회복")

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_マルチロール, ARG = -1
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_マルチロール, ARG = -1
RETURN 7

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_マルチロール, ARG, ARG:1, ARG:2
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
CALL HEAL_FIELD, ARG, ARG:1, ARG:2
CALL SET_RPG_CSTR_BTL, ARG, "セメタリー", ""

;　説明文の表示
@SKILL_EXPLAIN_マルチロール,ARG
PRINTL 아군 전체를 회복한다.
PRINTL 이 스킬의 회복력은 사용 완료된 【섬도마법】의 수에 따라 달라진다.
PRINTL 스킬 사용 후 모든 【섬도마법】이 사용 가능해진다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_マルチロール,ARG
RETURN 1

@リンク不能_マルチロール
RETURN 1
