@SKILL_DAMAGETYPE_自由のタンゴ,ARG
RETURN GET_ダメージタイプ_NUM("魔法")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_自由のタンゴ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_自由のタンゴ,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_自由のタンゴ,ARG
RETURN GET_SPHERE_NUM("일렬")

