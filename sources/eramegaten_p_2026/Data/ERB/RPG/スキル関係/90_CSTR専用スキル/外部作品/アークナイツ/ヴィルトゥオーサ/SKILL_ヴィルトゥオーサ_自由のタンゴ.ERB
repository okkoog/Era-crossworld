@SKILL_COST_自由のタンゴ,ARG
RETURN 33

;　相性
@SKILL_TYPE_自由のタンゴ,ARG
RETURN GET_TYPE_NUM("주살")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_自由のタンゴ
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")
