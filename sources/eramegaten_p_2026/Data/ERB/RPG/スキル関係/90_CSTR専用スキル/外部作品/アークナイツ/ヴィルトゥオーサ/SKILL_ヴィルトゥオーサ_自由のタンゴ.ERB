@SKILL_EFECT_自由のタンゴ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_自由のタンゴ, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_自由のタンゴ
RETURN 0

