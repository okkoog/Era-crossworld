;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_絶・狼牙, ARG
	RESULTS = 絶・狼牙

;　명중
@SKILL_HITRATE_KE_絶・狼牙, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_絶・狼牙, ARG
RETURN 350

;クリティカル率
@SKILL_CRITICAL_RATE_KE_絶・狼牙, ARG
RETURN 10

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_絶・狼牙, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_絶・狼牙, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_絶・狼牙, ARG
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 70
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_KE_絶・狼牙, ARG
IF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 70
	RESULTS = %" 70ＴＰ"%
	RETURN 0
ENDIF
RETURN 20

;　相性
@SKILL_TYPE_KE_絶・狼牙, ARG
RETURN GET_TYPE_NUM("검격")
;검격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_絶・狼牙
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_絶・狼牙, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_絶・狼牙, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_KE_絶・狼牙, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_絶・狼牙, ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_絶・狼牙, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_KE_絶・狼牙, ARG = -1
RETURN 30

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_絶・狼牙
RETURN 0


;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_KE_絶・狼牙, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
SIF ARG:2 < -1
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격", -4, "短縮", "", "", -4


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_絶・狼牙, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;ゲージ再回収できる様に起動前にTP70消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 70, "-="

CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_絶・狼牙, ARG
PRINTL 
PRINTL 검산도수로 화하여 적진을 베어 흐트러뜨리는 비오의 『절・낭아』.
PRINTL 적 전체에 검격 속성 특대 위력의 물리 공격을 가한다. 공격 후 공격력을 1단계까지 낮춘다.
PRINTL 
PRINTL 늑대기사 아벤트의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_絶・狼牙, ARG
;ゲージが70以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 70
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_絶・狼牙, ARG
RESULTS:0 = 적 전체에 검격 속성 특대 위력의 물리 공격을 가한다. 공격 후 공격력을 1단계까지 낮춘다.
RESULTS:1 = TP消費 70
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 70
	RESULTS:1 = %RESULTS:1%(不足)