
;スキル名
@SKILL_NAME_デモンシュート★,ARG
RESULTS = 데몬 슛★

;　명중
@SKILL_HITRATE_デモンシュート★, ARG
RETURN 100

;　威力
@SKILL_POWER_デモンシュート★, ARG
RETURN 495

;　최저공격횟수
@SKILL_MINATTACKNUMBER_デモンシュート★,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_デモンシュート★,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_デモンシュート★, ARG
SIF GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 3
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_デモンシュート★,ARG
IF ARG >= 0 && GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 3
	RESULTS = %"ＣＨ:3"%
	RETURN 0
ENDIF
RETURN 15

;　相性
@SKILL_TYPE_デモンシュート★,ARG
RETURN GET_TYPE_NUM("주살")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_デモンシュート★
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_デモンシュート★,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_デモンシュート★,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_デモンシュート★,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_デモンシュート★,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復
@SKILL_EFECT_デモンシュート★,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

@SKILL_SUCCESSION_TYPE_デモンシュート★,ARG
RETURN GET_SUCCESSION_NUM("주살")

@SKILL_RANK_デモンシュート★, ARG = -1
RETURN 10

;속도보정
@SKILL_SPEED_デモンシュート★, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_デモンシュート★
RETURN 0

