;スキル及び行動の実行
;====================================================
@ACTION_デモンシュート★,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

CALL SET_RPG_CFLAG_BTL, ARG, "KFチャージスキル", 3, "-="

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM
