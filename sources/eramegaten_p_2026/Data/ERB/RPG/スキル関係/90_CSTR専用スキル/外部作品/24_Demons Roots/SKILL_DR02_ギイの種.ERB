;====================================================
;カウンター発動条件
;====================================================
@SKILL_COUNTER_ACTIONABLE_ギイの種,ARG,ARG:1
	;自分への攻撃行動でないとだめ。一応。
	SIF !GET_CREC_ACT(ARG:1, ARG, "ATTACK")
		RETURN 0
	;受けた結果が反射ではない
	SIF GET_CREC_ACT(ARG:1, ARG, "REFLECT")
		RETURN 0
	;仲間には反撃しない
	SIF IS_FRIEND(ARG:1, ARG)
		RETURN 0
	;スキル起動中でないといけない
	SIF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ギイの種")) == 0
		RETURN 0
	;反撃の対象は反撃してきたキャラ(ポジションで返す)
	RETURN 1, CPOS(ARG:1)
;要するにスキル起動中で自分が攻撃を受けて、ターゲットが死亡していない場合。
