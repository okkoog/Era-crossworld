@ACTION_ギイの種,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

IF FLAG:카운터중 == 1
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
ELSE
	CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"ギイの種"),6
	PRINTFORMW 기이의 씨앗이 \@ CFLAG:ARG:PT플래그 ? 적 # 아군 \@의 진형에 흩뿌려졌다!

ENDIF

