;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;
;修羅:参の太刀・牡丹　　単体攻撃で会心が出ると50％で発動。剣撃相性の大ダメージ。
;====================================================
@SKILL_TRIGGER_ACTIONABLE_六太刀・弐, ARG, ARG:1
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"六太刀・弐")

;自分の攻撃じゃなければNG
;SIF ARG != ARG:1
;	RETURN 0
;自分への攻撃は追撃しない
SIF ARG == ARG:1
	RETURN 0
SIF FLAG:행동순1 != ARG
	RETURN 0
;単体攻撃じゃなければNG
SIF CFLAG:ARG:타겟 > 16 || CFLAG:ARG:타겟 < 1
	RETURN 0
;クリティカルを受けているキャラを探す
SIF !GET_CREC_ACT(ARG, ARG:1, "CRT")
	RETURN 0
;死んでる可能性があるのでキャラ全体くまなく探す
;FOR LOCAL,0,CHARANUM
;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,21) && CFLAG:LOCAL:PT플래그 != CFLAG:ARG:PT플래그
;		BREAK
;	SIF LOCAL == (CHARANUM - 1)
;		RETURN 0
;NEXT

;50%
SIF RAND:2
	RETURN 0
;LOCAL = POS(CFLAG:ARG:타겟)
;SIF LOCAL < 0 || GET_STATE(CFLAG:LOCAL:상태이상) == "DYING"
;	CALL RANDOM_TARGET,ARG,3539
;SIF CFLAG:ARG:타겟 < 0 || POS(CFLAG:ARG:타겟) < 0 || GET_STATE(CFLAG:POS(CFLAG:ARG:타겟):상태이상) == "DYING"
;	RETURN 0
CALL SKILLGAGE_H_SET(ARG,SKILL_NUM,3)
;RESULT:1 = CFLAG:ARG:타겟
;RETURN 1
RETURN 1, CPOS(ARG:1)

