;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_今は知らず、無垢なる湖光,ARG,ARG:1,SKILL_NUM
#LOCALSIZE 1
#DIM L_T
#DIM SKILL_NUM
#DIM トドメまでお前を殴るのを止めないフラグ
#DIM LCOUNT,3
#DIMS L_STR,2

SKILL_NUM = PU_SKILLNUM_GET(ARG,"今は知らず、無垢なる湖光")

TFLAG:스킬용1 = GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ")

;竜骸形態で発動時、発動からそのターン内に限り貫通効果を獲得
SIF TFLAG:스킬용1
	CALL SKILLGAGE_D_SET(ARG,SKILL_NUM,1)
L_STR:0 = \@ !TFLAG:스킬용1 ? 0_20_30_30_40_40 # 0_20_30_40_50_60 \@
LOCAL = AUTO_SPLIT_INT(L_STR,"_",SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")))
L_STR:0 = \@ !TFLAG:스킬용1 ? NP獲得量 # 魔法ダメージ\@%TOSTR(LOCAL)%％増加\@ TFLAG:스킬용1 ? （FGO）# \@
L_STR:1 = \@ !TFLAG:스킬용1 ? ＮＰゲージの獲得量 # 魔法ダメージ\@
CALL SET_C_BTL_EFFECT_SINGLE, ARG, ARG, @"%L_STR:0%",3,@"３ターンの間、%L_STR:1%増加！"

FOR LCOUNT:0,GET_POS_MIN(ARG:1),GET_POS_MAX(ARG:1) + 1
	L_T = POS(LCOUNT:0)
	トドメまでお前を殴るのを止めないフラグ = 0
	SIF L_T < 0
		CONTINUE
	;相手が元から不死身じゃないなら不死身にしてボコボコにしても問題ないな！
	IF CFLAG:L_T:불사신플래그 < 1
		CFLAG:L_T:불사신플래그 = 1
		トドメまでお前を殴るのを止めないフラグ = 1
	ENDIF
	LCOUNT:2 = !TFLAG:스킬용1 ? 5 # 1
	FOR LCOUNT:1,1,LCOUNT:2 + 1
		CALL SKILLGAGE_H_ADD,ARG,SKILL_NUM,1
		;トドメまでお前を殴るのを止めないフラグが立ってたら不死身フラグを解除してトドメを刺す
		IF LCOUNT:1 == LCOUNT:2
			SIF トドメまでお前を殴るのを止めないフラグ == 1
				CFLAG:L_T:불사신플래그 = 0
		ENDIF
		CALL ATTACK_SINGLE,ARG,L_T,SKILL_NUM
		;1回目の攻撃の結果に応じて以降の命中と会心率を固定する
		IF LCOUNT:1 == LCOUNT:2
			;0ダメでもHIT履歴が登録されない問題があったのでMISSで確認する
			TFLAG:스킬용2 = !GET_CREC_ACT(ARG,L_T,"MISS") ? 1 # -1
			TFLAG:스킬용3 = GET_CREC_ACT(ARG,L_T,"CRT") ? 1 # -1
		ENDIF
		;今は知らず、無垢なる湖光に限り、被ダメージ増加デバフとクリティカル強化バフ処理が発生する
		IF LCOUNT:1 == 5 && !TFLAG:스킬용1
			SIF !GET_CREC_ACT(ARG,L_T,"MISS")
				CALL SET_C_BTL_EFFECT_SINGLE, ARG, L_T, "被ダメージ10％増加（FGO）",5,"５ターンの間、被ダメージ量が増加！"
			CALL SKILL_SET_カジャンダ, ARG, CFLAG:ARG:PT플래그 > 0 ? 19 # 22, "크리티컬", 4, "範囲",,,8,-4
		ENDIF
	NEXT
	CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,0
	TFLAG:스킬용2 = 0
	TFLAG:스킬용3 = 0
NEXT
CALL SKILLGAGE_D_SET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"),0)
TFLAG:스킬용1 = 0

