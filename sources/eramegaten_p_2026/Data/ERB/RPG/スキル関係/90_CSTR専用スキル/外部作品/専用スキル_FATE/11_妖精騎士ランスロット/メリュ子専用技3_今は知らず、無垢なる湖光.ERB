	RETURN 130
RETURN TFLAG:스킬용2 == 1 ? 999 # -100

;　威力
@SKILL_POWER_今は知らず、無垢なる湖光, ARG
#DIM SKILL_NUM
#DIM L_DMG
#DIMS L_DMGS,5
SKILL_NUM = PU_SKILLNUM_GET(ARG,"今は知らず、無垢なる湖光")

SPLIT \@ GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ") == 0 ? 450_600_675_720_750 # 300_400_450_475_500 \@,"_",L_DMGS

L_DMG = TOINT(L_DMGS:LIMIT(GET_RPG_CFLAG_TAKEOVER(ARG,"宝具再臨（ランサー）"),0,4))

SIF TFLAG:스킬용1
	RETURN L_DMG

SELECTCASE SKILLGAGE_H_GET(ARG,SKILL_NUM)
	CASE 1	
		TIMES L_DMG , 0.06
	CASE 2
		TIMES L_DMG , 0.13
	CASE 3
		TIMES L_DMG , 0.20
	CASE 4
		TIMES L_DMG , 0.26
	CASE 5
		TIMES L_DMG , 0.35
ENDSELECT

RETURN L_DMG

