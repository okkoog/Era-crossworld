;スキル名
@SKILL_NAME_悪魔の力が欲しい,ARG
RESULTS = 악마의 힘을 원한다

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_悪魔の力が欲しい, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")

;　コストの量
@SKILL_COST_悪魔の力が欲しい,ARG
RETURN 0

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_悪魔の力が欲しい
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_悪魔の力が欲しい,ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_悪魔の力が欲しい,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_悪魔の力が欲しい,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_悪魔の力が欲しい,ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_悪魔の力が欲しい, ARG = -1
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_悪魔の力が欲しい,ARG,ARG:1,ARG:2
#DIM DYNAMIC LCOUNT
CALL SET_C_BTL_EFFECT_SINGLE, ARG, POS(ARG:1), "悪魔の瞳", , , ,"NOWAIT"

@SKILL_TARGETABLE_悪魔の力が欲しい, ARG, ARG:1
SIF ARG == ARG:1
	RETURN 0
RETURN 1

;　説明文の表示
@SKILL_EXPLAIN_悪魔の力が欲しい,ARG
PRINTL 대상 아군 1명에게 적에게 가하는 데미지를 증가시키고,
PRINTL 추가로 매 턴 종료 시마다 HP를 크게 감소시키는 효과를 부여한다.

;　説明文の表示
@ENHANCE_SKILL_EXPLAIN_悪魔の力が欲しい,ARG
RESULTS:0 '= "対象の味方一人に敵に与えるダメージを増加させ、"
RESULTS:1 '= "さらにターン終了ごとにＨＰを大きく減少させる効果を与える。"

;使用条件
@SKILL_SPECIAL_ACTIONABLE_悪魔の力が欲しい,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_悪魔の力が欲しい, ARG = -1
RETURN 6
