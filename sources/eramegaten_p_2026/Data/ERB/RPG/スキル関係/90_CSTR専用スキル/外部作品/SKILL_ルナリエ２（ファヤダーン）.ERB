	RETURN 0
CALL SKILL_GUARD_KILL, ARG, "전격", CPOS(ARG:1), 2, "短縮"

;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_ファヤダーン, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "ATK"
		RETURN LIMIT(CFLAG:ARG:공격강화 + CFLAG:ARG:마법위력강화, -48, 64), 32
ENDSELECT
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ファヤダーン,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM 水浸しフラグ
水浸しフラグ = PU_SKILLNUM_GET(ARG,"ファヤダーン")

;LOCAL:0 = MAXBASE:ARG:마법위력
;LOCAL:1 = CFLAG:ARG:마법위력강화
;
;MAXBASE:ARG:마법위력 = MAXBASE:ARG:공격
;CFLAG:ARG:마법위력강화 += CFLAG:ARG:공격강화

CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)

;MAXBASE:ARG:마법위력 = LOCAL:0
;CFLAG:ARG:마법위력강화 = LOCAL:1

CALL SKILLGAGE_D_ADD,ARG,水浸しフラグ,4


;CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM;		拡散攻撃
;CALL ATTACK_RAND,ARG,ARG:1,SKILL_NUM;			ランダム攻撃

@SKILL_EX_DISPLAY_ファヤダーン, ARG, ARGS
#DIM BAR_LENS, 2
#DIMS L_RESULTS, 2
VARSET L_RESULTS
BAR_LENS = SKILL_EX_DISPLAY_LENS / 2 + SKILL_EX_DISPLAY_LENS % 2, SKILL_EX_DISPLAY_LENS / 2
IF HAVE_PU_SKILL(ARG, "ファヤダーン") && PU_SKILLGAGE_D_GET(ARG, "ファヤダーン") && HAVE_PU_SKILL(ARG, "ガンマ・レイ") && PU_SKILLGAGE_D_GET(ARG, "ガンマ・レイ")
	L_RESULTS:0 += SET_COLOR_TAG(UNICODE(0x2602) * MIN(PU_SKILLGAGE_D_GET(ARG, "ファヤダーン"), BAR_LENS / 2), "aqua")
	L_RESULTS:0 += " " * (BAR_LENS - MIN(PU_SKILLGAGE_D_GET(ARG, "ファヤダーン"), BAR_LENS / 2) * 2)
	L_RESULTS:1 += SET_COLOR_TAG(UNICODE(0x274B) * MIN(PU_SKILLGAGE_D_GET(ARG, "ガンマ・レイ"), BAR_LENS:1 / 2), "yellow")
	L_RESULTS:1 += " " * (BAR_LENS:1 - MIN(PU_SKILLGAGE_D_GET(ARG, "ガンマ・レイ"), BAR_LENS:1 / 2) * 2)
	L_RESULTS:0 '= SET_BUTTON_TAG(L_RESULTS:0, ARGS, "水浸し持続時間")
	L_RESULTS:1 '= SET_BUTTON_TAG(L_RESULTS:1, ARGS, "レイ・ペンタグマ持続時間")
	RESULTS '= L_RESULTS:0 + L_RESULTS:1
ELSE
	IF HAVE_PU_SKILL(ARG, "ファヤダーン") && PU_SKILLGAGE_D_GET(ARG, "ファヤダーン")
		RESULTS:0 += SET_COLOR_TAG(UNICODE(0x2602) * MIN(PU_SKILLGAGE_D_GET(ARG, "ファヤダーン"), SKILL_EX_DISPLAY_LENS / 2), "aqua")
		RESULTS:0 += " " * (SKILL_EX_DISPLAY_LENS - MIN(PU_SKILLGAGE_D_GET(ARG, "ファヤダーン"), SKILL_EX_DISPLAY_LENS / 2) * 2)
		RESULTS:1 = 물에 젖음 지속 시간
	ELSEIF HAVE_PU_SKILL(ARG, "ガンマ・レイ") && PU_SKILLGAGE_D_GET(ARG, "ガンマ・レイ")
		RESULTS:0 += SET_COLOR_TAG(UNICODE(0x274B) * MIN(PU_SKILLGAGE_D_GET(ARG, "ガンマ・レイ"), SKILL_EX_DISPLAY_LENS / 2), "yellow")
		RESULTS:0 += " " * (SKILL_EX_DISPLAY_LENS - MIN(PU_SKILLGAGE_D_GET(ARG, "ガンマ・レイ"), SKILL_EX_DISPLAY_LENS / 2) * 2)
		RESULTS:1 = 레이 펜타그마 지속 시간
	ELSE
		RESULTS = %SET_COLOR_TAG(UNICODE(0x2588) * SKILL_EX_DISPLAY_LENS, TOSTR(GETBGCOLOR()))%
		RESULTS:1 = 루나리에 고유 스킬 지속 시간
	ENDIF
ENDIF
RETURN 1
