@ACTION_セイバーの星,ARG,ARG:1,SKILL_NUM
#LOCALSIZE 2
#DIM SKILL_NUM

LOCAL:1 = GET_TYPE_NUM("만능")

FOR LOCAL , 0 , TYPENUM
	;万能は防げない
	SIF LOCAL == LOCAL:1
		CONTINUE
	SIF CFLAG:ARG:@"%GET_TYPE(LOCAL)%무효화횟수" < 1
		CFLAG:ARG:@"%GET_TYPE(LOCAL)%무효화횟수" = 1
NEXT

