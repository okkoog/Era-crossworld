;　威力
@SKILL_POWER_メイの露, ARG
;メディラマよりちょっと下ぐらい
IF GET_RPG_CSTR_TAKEOVER(ARG, "使徒変身状態") == "起動"
	RETURN 150
ELSE
	RETURN 295
ENDIF

;特殊な参照値
@SKILL_CALC_BATTTLE_STATUS_メイの露, ARGS, ARG, ARG:1
SIF ARG < 0
	RETURN 0
SELECTCASE ARGS
	;回復は魔法効果(影響大),마법위력(影響小)の2変数を置換する
	CASE "HEAL"
		RETURN MAXBASE:ARG:공격, MAXBASE:ARG:방어
ENDSELECT

