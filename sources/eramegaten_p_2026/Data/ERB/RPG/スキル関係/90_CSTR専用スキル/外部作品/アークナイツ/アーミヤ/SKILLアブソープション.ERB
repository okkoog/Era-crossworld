;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_アブソープション,ARG,ARG:1
#LOCALSIZE 1
#DIM MAX_F
#DIM L_T
IF ARG == ARG:1 && CSTR:ARG:104 != ""
	SELECTCASE CSTR:ARG:전용기1
		CASE "戦術詠唱γ","ソウルブースト","キメラ"
			SIF SKILLGAGE_F_GET(ARG,[[스킬:전용기1]]) < 0
				RETURN 0
			CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
			IF RESULT == 1
				CALL SKILLGAGE_F_ADD,ARG,[[스킬:전용기1]],3
				;FOR LOCAL,0,CHARANUM
				FOR LOCAL, 0, BCHARANUM
					L_T = BCHARA:LOCAL
					;同陣営の場合は省く
					SIF CFLAG:L_T:PT플래그 == CFLAG:ARG:PT플래그
						CONTINUE
					;味方で尚且つ戦闘に出ていないキャラも省く
					SIF CFLAG:L_T:PT플래그 == 1
						CONTINUE
					;回避に失敗して現ダメージが現ＨＰを上回る or DYINGになったか、もしくはDYINGのステートを付与された場合はSP加算
					;要は自身で敵を撃破したor敵をDYINGにすればSP+10という処理……合ってるかどうかはわからん
					;IF (CFLAG:LOCAL:회피실패 && (CFLAG:LOCAL:현데미지 >= BASE:LOCAL:ＨＰ || GET_STATE(CFLAG:LOCAL:상태이상) == "DYING")) || GETBIT(CFLAG:LOCAL:受けフラグ,23 + GET_STATE_NUM("DYING"))
					IF GET_CREC_ACT(ARG, L_T, "KILL")
						CALL SKILLGAGE_F_ADD,ARG,[[스킬:전용기1]],10
						;SP+10が発生した時点でBREAK
						BREAK
					ENDIF
				NEXT
			ENDIF
			;;専用技1のHゲージが最大値を越えた場合、最大値まで値を戻す
			;TRYCALLFORM AUTO_PU_SKILL_%CSTR:ARG:전용기1%,ARG,"Hゲージ最大値"
			SIF CSTR:ARG:전용기1 == "戦術詠唱γ"
				MAX_F = TOINT(AUTO_SPLIT("40_35_32_30","_",TOINT(CSTR:ARG:102)-1))
			SIF CSTR:ARG:전용기1 == "ソウルブースト"
				MAX_F = 100
			SIF CSTR:ARG:전용기1 == "キメラ"
				MAX_F = 120
			SIF SKILLGAGE_F_GET(ARG,[[스킬:전용기1]]) > MAX_F
				CALL SKILLGAGE_F_SET,ARG,[[스킬:전용기1]],MAX_F
		CASEELSE
			RETURN 0
	ENDSELECT
ENDIF

;ターン終了時に行う処理
@SKILL_TURNEND_アブソープション,ARG
#DIM SKILL_NUM
#DIM L_GAGE
;キメラのクールタイムゲージとして活用
SIF ARG < 0 || CSTR:ARG:104 == "" || CSTR:ARG:전용기1 != "キメラ"
	RETURN 0
SKILL_NUM = PU_SKILLNUM_GET(ARG,"アブソープション")
L_GAGE = SKILLGAGE_F_GET(ARG,SKILL_NUM)
SIF L_GAGE == 0
	RETURN 0
CALL SKILLGAGE_F_SET(ARG,SKILL_NUM,MIN(SKILLGAGE_F_GET(ARG,SKILL_NUM) + 5 ,0))
RETURN 0

