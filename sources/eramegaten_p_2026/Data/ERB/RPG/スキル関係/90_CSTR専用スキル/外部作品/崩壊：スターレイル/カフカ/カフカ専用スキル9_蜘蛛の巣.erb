;====================================================
;トリガー発動条件
;
;詳しい仕様については資料フォルダの解説を参照してください
;====================================================
;@SKILL_TRIGGER_ACTIONABLE_蜘蛛の巣,ARG,ARG:1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_蜘蛛の巣,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_蜘蛛の巣, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			SIF CFLAG:L_P:입력행동 != PU_SKILLNUM_GET(L_P,"月明かりが撫でる連綿") && CFLAG:L_P:입력행동 != PU_SKILLNUM_GET(L_P,"止まない夜の喧騒")  && CFLAG:L_P:입력행동 != PU_SKILLNUM_GET(L_P,"悲劇最果ての顫音")
			RETURN 25
		;スキル命中率に加算する。低命中スキルに影響度が高く、カジャンダによって効果量が増減する
		 CASE "スキル命中強化"
			RETURN 0
		;+カジャの枠。つまり0からなら加算はX/32の増加、減算はX/16の減少(カジャは+4)　通常枠の上限下限を超えて加減される(ただし、減算側は安全のために8を下限にしてあるので注意)
		;この補正を999以上で指定した場合は必中、-999以下で指定した場合は命中率0となる
		CASE "追加命中強化"
			RETURN 0
		;100% ± Xの補正を与える。同種(粗雑・慢心)などとは加算。補正量が素直
		;この補正を999以上で指定した場合は確定クリティカル、-999以下で指定した場合はクリティカル不能となる
		CASE "クリティカル補正A"
			RETURN 0
		;アドバイスの枠 & コーチングの枠。強烈に補正がかかるので注意
		;正の場合   (1+ランク) / 1倍になる。(1ランクでアドバイスなしのばあいクリティカル率2倍。ありの場合は300%の200%で1.5倍)
		;負の場合   1 / (1+ランク)倍になる。(1ランクでアドバイスなしのばあいクリティカル率0.5倍。ありの場合は1/2 から1/3で0.66倍) ※要するにクリティカル率減少
		CASE "クリティカルランク"
			RETURN 0
		;乗除の計算後に加算する。上記2つの乗算系は基礎クリティカル率が低いスキルには効果が薄いが、こちらは基礎が低いスキルに強力に働く
		;基礎クリティカル率が低い技しか持たないキャラの補正用と考えるのならばこれで補正するのがおすすめ
		CASE "クリティカル加算"
			RETURN 0
		;100% ± Xの補正を与える。つまり、20なら1.2倍、-20なら0.8倍。素質(1.5倍)や淀んだ空気(最大2倍)とは乗算
		;この補正を999以上で指定した場合は必中、-999以下で指定した場合は命中率0となる
		CASE "バステ補正"
			RETURN 0
	ENDSELECT
;自分が防御側
ELSE
	SELECTCASE ARGS
		;他のものと加算されずに全体に乗算で処理される。(-20ならダメージ0.8倍、+20なら1.2倍)
		CASE "ダメージ倍率"
			RETURN 0
		;防御時の相性を変化させる。枠としては壁やカーンなどと同じで、スキル耐性貫通スキルによって無効化される
		;※ただし耐性をあえて弱くする場合は無視されない
		;戻り値	RESULT=成否　RESULT:1 = 変化させる相性値　RESULTS = 상성변동요인
		CASE "相性変化"
			RETURN 0
			;以下は例文
			;火炎吸収
			;SIF L_相性名 == "화염"
			;		RETURN 1, -50
			;物理ダメージを弱点にする
			;SIF L_ダメージタイプ == "物理"
			;		RETURN 1, 200
			;1/4の確率で無効化
			;SIF RAND:4 == 0
			;		RETURN 1, 0
		;カジャの枠。つまり0からなら加算は32/(32+x)の減少、減算は32/(32-x)の増加(カジャは+4)　通常枠の上限下限を超えて加減される(ただし、減算側は安全のために8を下限にしてあるので注意)
		;この補正を999以上で指定した場合は絶対回避、-999以下で指定した場合は回避不能となる
		CASE "追加回避強化"
			RETURN 0
		;100% ± Xの補正を与える。同種(粗雑・慢心)などとは加算。
		;あまり極端な補正を与えたくない場合向けの補正値。
		;この補正を999以上で指定した場合は被確定クリティカル、-999以下で指定した場合はクリティカル無効となる
		CASE "クリティカル補正A"
			RETURN 0
		;アドバイスの枠 & コーチングの枠
		;正の場合   1 / (1+ランク)倍になる。(1ランクでアドバイスなしのばあいクリティカル率0.5倍。ありの場合は1/2 から1/3で0.66倍) ※要するに被クリティカル率減少
		;負の場合   (1+ランク) / 1倍になる。(1ランクでアドバイスなしのばあいクリティカル率2倍。ありの場合は300%の200%で1.5倍) ※要するに被クリティカル率増加
		CASE "クリティカル耐性ランク"
			RETURN 0
		;乗除の計算後に加算する。上記2つの乗算系は基礎クリティカル率が低いスキルには効果が薄いが、こちらは基礎が低いスキルに強力に働く
		;大半のスキルのクリティカル率は5% = ここで減算すると大半が0につっこみかねないのには注意
		;逆にある程度非クリティカルのリスクをプレイヤーに与える場合はここで加算してやるといい
		CASE "クリティカル加算"
			RETURN 0
		;100% ± Xの補正を与える。つまり、20なら1.2倍、-20なら0.8倍。素質(1.5倍)や淀んだ空気(最大2倍)とは乗算
		;この補正を999以上で指定した場合は回避不能、-999以下で指定した場合は絶対回避となる
		CASE "バステ補正"
			RETURN 0
	ENDSELECT
ENDIF
RETURN 0

;　説明文の表示
@SKILL_EXPLAIN_蜘蛛の巣,ARG
PRINTL 専用スキルの与ダメージ＋２５％。
PRINTL 『月明かりが撫でる連綿』『悲劇最果ての顫音』の追撃の威力が上昇する。
