;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_クラス４スキル（聖剣３）,ARG,ARG:1
#DIM クラス必殺変数
#DIM L_T
#DIM L_GP
#LOCALSIZE 1
クラス必殺変数 = PU_SKILLNUM_GET(ARG,"クラス４スキル（聖剣３）")	
;スキルゲージDがある＝クラス４スキルを使用するターン＝クラス４スキルでは増加しない。
SIF SKILLGAGE_D_GET(ARG,クラス必殺変数) > 0
	RETURN 0
;ゲージ上限
SIF SKILLGAGE_F_GET(ARG,クラス必殺変数) == 100
	RETURN 0
L_GP = 0
;自分の行動の場合
IF ARG == ARG:1
	L_GP += 10
	
	;ダメージを受けた敵の数に応じてスキルゲージアップ
	;FOR LOCAL,0,CHARANUM
	;	SIF CFLAG:LOCAL:PT플래그 == CFLAG:ARG:PT플래그
	;		CONTINUE
	;	IF CFLAG:LOCAL:현데미지 > 0
	;		CALL SKILLGAGE_F_ADD,ARG,クラス必殺変数,5
	;	ELSE
	;		CONTINUE
	;	ENDIF
	;	;必殺、弱点を出すとさらにアップ
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,21)
	;		CALL SKILLGAGE_F_ADD,ARG,クラス必殺変数,10
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,22)
	;		CALL SKILLGAGE_F_ADD,ARG,クラス必殺変数,10
	;NEXT
	FOR LOCAL, 0, BCHARANUM
		L_T = BCHARA:LOCAL
		SIF IS_FRIEND(ARG, L_T)
			CONTINUE
		;攻撃を当てることで+5
		SIF GET_CREC_ACT(ARG, L_T, "HIT")
			L_GP += 5
		;クリティカルでさらに+10
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 10
		;弱点をつくことでさらに+10
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 10
	NEXT
	;気合を入れても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:기합]]
		L_GP += 15
	;集中しても上がる
	SIF CFLAG:ARG:입력행동 == [[스킬:컨센트레이트]]
		L_GP += 15
	;気合を入れても上がる
	;SIF CFLAG:ARG:입력행동 == 511
	;	CALL SKILLGAGE_F_ADD,ARG,クラス必殺変数,15
	;集中しても上がる
	;SIF CFLAG:ARG:입력행동 == 512
	;	CALL SKILLGAGE_F_ADD,ARG,クラス必殺変数,15
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える。増加量は最大体力に対するダメージ割合の２倍
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += MAX(200 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ, 2)
;IF CFLAG:ARG:현데미지 > 0 || GETBIT(CFLAG:ARG:受けフラグ,18) || GETBIT(CFLAG:ARG:受けフラグ,19)
	;LOCAL = 200 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ
	;LOCAL = LOCAL < 2 ? 2 # LOCAL
	;CALL SKILLGAGE_F_ADD,ARG,クラス必殺変数,LOCAL
;ENDIF
;ゲージは１００まで
CALL SKILLGAGE_F_SET,ARG,クラス必殺変数,MIN(100, L_GP + SKILLGAGE_F_GET(ARG,クラス必殺変数))
;SIF SKILLGAGE_F_GET(ARG,クラス必殺変数) > 100
;	CALL SKILLGAGE_F_SET,ARG,クラス必殺変数,100
IF SKILLGAGE_F_GET(ARG,クラス必殺変数) == 100
	RESULTS = ＳＰ ＧＡＵＧＥ ＦＵＬＬ！
	SIF SKILL_CHANGE(ARG, [[キャラ:리스]])
		RESULT:1 = 0x009e25
	SIF SKILL_CHANGE(ARG, [[キャラ:샤를로트]])
		RESULT:1 = 0xffaa00
	SIF SKILL_CHANGE(ARG, [[キャラ:안젤라]])
		RESULT:1 = 0x782069
ELSE
	RESULTS = SP 게이지
ENDIF
RESULTS:1 = \%
RETURN L_GP
@SKILL_DEL_UNABLE_クラス４スキル（聖剣３）, ARG
RETURN 1

