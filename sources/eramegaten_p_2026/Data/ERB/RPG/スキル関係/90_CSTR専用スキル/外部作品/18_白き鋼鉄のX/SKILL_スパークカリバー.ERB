;　説明文の表示
@SKILL_EXPLAIN_スパークカリバー, ARG
#DIM DIVA_F
#DIM DIVA_H
DIVA_F = SKILLGAGE_F_GET(ARG, [[스킬:SONG OF DIVA]])
DIVA_H = SKILLGAGE_H_GET(ARG, [[스킬:SONG OF DIVA]])
;原作では「召還」だけど召喚の方が正しいだろう
PRINTFORML 전방에 뇌검을 소환하는 %CALLNAME:ARG%의 SP 스킬.
PRINTL 　
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	PRINTL 적 단체에 검격과 전격의 복합 속성으로 대데미지를 준다. 후열 사용 가능.
	PRINTL 추가로 대상 뒤에도 적이 있을 경우 그쪽에도 공격을 가한다.
	PRINTL 또한 물리 공격이지만 데미지 계산에는 마법 위력을 사용한다.
	;シュートしてからマンダラーするぞ
	IF CFLAG:ARG:집중플래그 > 0
		SETCOLOR 0x144ff4
		PRINTL 집중 상태 공격 범위 변경: 적 1열/적 후열에 추격
		RESETCOLOR
	ENDIF
ELSE
	PRINTL 적 단체에 검격과 전격의 복합 속성으로 대데미지를 준다. 후열 사용 불가.
	PRINTL 또한 물리 공격이지만 데미지 계산에는 마법 위력을 사용한다.
	;シュートするぞ
	IF DIVA_H == 1
		SETCOLOR 0x1d9eff
		PRINTL SONG OF DIVA 발동 중: 후열 사용이 가능해지며, 뇌검을 일직선으로 발사하여 뒤쪽 대상에게도 공격을 가한다.
		RESETCOLOR
	ELSEIF DIVA_F == 1
		SETCOLOR 0x3f60a9
		PRINTL SONG OF DIVA 발동 중: 후열 사용이 가능해지며, 뇌검을 일직선으로 발사하여 뒤쪽 대상에게도 공격을 가한다.
		RESETCOLOR
	ENDIF
ENDIF
PRINTL 단 사용 후에는 쿠도스가 0이 되며, 재사용까지 3턴의 쿨타임이 필요하다.
PRINTL MP와는 별개로 SP를 2 소비한다.
PRINTL ※SP는 4턴에 1 회복되며, 전투 종료 후에 완전 회복된다.
PRINTL ※스킬 「뇌격린」을 소지하지 않은 경우 사용 불가.
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	SETCOLOR 0x144ff4
	PRINTL 번개의 렌즈 장비 중 25% 확률로 쿠도스·SP 소비를 회피
	PRINTL 　　　　　　　　　　집중 상태일 경우 공격·추격 범위가 1열로 변경
	RESETCOLOR
ENDIF

;使用条件
@SKILL_SPECIAL_ACTIONABLE_スパークカリバー, ARG
#DIM SKILL_NUM
IF CFLAG:ARG:PT플래그 > 0
	SKILL_NUM = PU_SKILLNUM_GET(ARG, "スパークカリバー")
	SIF SKILLGAGE_D_GET(ARG, SKILL_NUM)
		RETURN 0
	SIF !HAVE_SKILL(ARG, [[스킬:뇌격린]])
		RETURN 0
	SIF SKILLGAGE_D_GET(ARG, [[스킬:뇌격린]]) > 4
		RETURN 0
	RETURN 1
ELSE
	RETURN 1
ENDIF

