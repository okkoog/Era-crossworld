;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_スパークカリバー, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 5
#LOCALSSIZE 1
#DIM SKILL_NUM
#DIM DIVA_F
#DIM DIVA_H
#DIM ループ用
#DIM ボス殺したフラグ
#DIM ボス検索配列, 17

DIVA_F = SKILLGAGE_F_GET(ARG, [[스킬:SONG OF DIVA]])
DIVA_H = SKILLGAGE_H_GET(ARG, [[스킬:SONG OF DIVA]])

IF SKILL_CHANGE(ARG, [[キャラ:데머즐]])
	CALL ATTACK_RAND, ARG, ARG:1, SKILL_NUM
ELSE	
	;GVが専用アクセサリを積んでたら
	IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
		;かつ集中してたら
		IF CFLAG:ARG:집중플래그 > 0
			;まず前列に攻撃
			IF CFLAG:ARG:PT플래그 == 0
				LOCAL:2 = 1
				LOCAL:3 = 4
			ELSE
				LOCAL:2 = 7
				LOCAL:3 = 12
			ENDIF
			FOR LOCAL:4, LOCAL:2, LOCAL:3
				LOCALS = 포지션{LOCAL:4}
				SIF FLAG:LOCALS < 0
					CONTINUE
				SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
					CONTINUE
				CALL ATTACK_SINGLE, ARG, FLAG:LOCALS, SKILL_NUM
			NEXT
			;続いて相手の後列に生存者がいるかを見る
			IF CFLAG:ARG:PT플래그 == 0
				LOCAL:2 = 4
				LOCAL:3 = 7
			ELSE
				LOCAL:2 = 12
				LOCAL:3 = 17
			ENDIF
			TFLAG:스킬용1 = 0
			FOR LOCAL:4, LOCAL:2, LOCAL:3
				LOCALS = 포지션{LOCAL:4}
				SIF FLAG:LOCALS < 0
					CONTINUE
				SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
					CONTINUE
				TFLAG:스킬용1 += 1
			NEXT
			IF TFLAG:스킬용1 > 0
				TRYCALLFORM BATTLE_MESSAGE_K5357_SP, ARG, "スパークカリバー2"
				PRINTW ＞소환된 뇌검이 발사되어 기합과 함께 회전을 시작했다!
				FOR LOCAL:4, LOCAL:2, LOCAL:3
					LOCALS = 포지션{LOCAL:4}
					SIF FLAG:LOCALS < 0
						CONTINUE
					SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
						CONTINUE
					CALL ATTACK_SINGLE, ARG, FLAG:LOCALS, SKILL_NUM
				NEXT
			ENDIF
			TFLAG:스킬용1 = 0
			CFLAG:ARG:집중플래그 = 0
		;かつ集中してなかったら
		ELSE
			CALL ATTACK_SINGLE, ARG, POS(ARG:1), SKILL_NUM
			;続いて対象の後ろに生存者がいるかを見る
			IF CFLAG:ARG:PT플래그 == 0
				IF ARG:1 < 4
					LOCAL:2 = ARG:1 + 3
				ENDIF
			ELSE
				IF ARG:1 < 12
					LOCAL:2 = ARG:1 + 5
				ENDIF
			ENDIF
			LOCALS = 포지션{LOCAL:2}
			IF FLAG:LOCALS > -1 && GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) != "DYING"
				TRYCALLFORM BATTLE_MESSAGE_K5357_SP, ARG, "スパークカリバー"
				PRINTW ＞소환된 뇌검이 발사되었다!
				CALL ATTACK_SINGLE, ARG, POS(LOCAL:2), SKILL_NUM
			ENDIF
		ENDIF
	;GVが専用アクセサリを積んでなかったら
	ELSE
		CALL ATTACK_SINGLE, ARG, POS(ARG:1), SKILL_NUM
		;SONG OF DIVA発動中なら
		IF DIVA_F == 1 || DIVA_H == 1
			;続いて対象の後ろに生存者がいるかを見る
			IF CFLAG:ARG:PT플래그 == 0
				IF ARG:1 < 4
					LOCAL:2 = ARG:1 + 3
				ENDIF
			ELSE
				IF ARG:1 < 12
					LOCAL:2 = ARG:1 + 5
				ENDIF
			ENDIF
			LOCALS = 포지션{LOCAL:2}
			IF FLAG:LOCALS > -1 && GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) != "DYING"
				TRYCALLFORM BATTLE_MESSAGE_K5357_SP, ARG, "スパークカリバー"
				PRINTW ＞소환된 뇌검이 발사되었다!
				CALL ATTACK_SINGLE, ARG, POS(LOCAL:2), SKILL_NUM
			ENDIF
		ENDIF
	ENDIF
ENDIF

IF CFLAG:ARG:PT플래그 > 0
	LOCAL = RAND:4
	IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정") && LOCAL == 0
	ELSE
		;SONG OF DIVA/藍の運命終了
		CALL SKILLGAGE_F_SET, ARG, [[스킬:SONG OF DIVA]], 0
		;クードス没収
		SIF SKILLGAGE_F_GET(ARG, [[스킬:뇌격린]]) > 0
			PRINTFORML ＞%CALLNAME:ARG%의 쿠도스가 리셋되었다!
		CALL SKILLGAGE_F_SET, ARG, [[스킬:뇌격린]], 0
		;SP2消費=ゲージDを8加算
		CALL SKILLGAGE_D_ADD, ARG, [[스킬:뇌격린]], 8
	ENDIF
	CALL SKILLGAGE_D_SET, ARG, SKILL_NUM, 3
ENDIF
