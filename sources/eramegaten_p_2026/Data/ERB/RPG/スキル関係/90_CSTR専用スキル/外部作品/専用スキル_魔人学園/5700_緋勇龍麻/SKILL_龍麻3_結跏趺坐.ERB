;スキル名
@SKILL_NAME_結跏趺坐,ARG
RESULTS = 結跏趺坐

;　威力
@SKILL_POWER_結跏趺坐, ARG
RETURN 300

@SKILL_HEAL_TYPE_結跏趺坐, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("割合")

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_結跏趺坐,ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_結跏趺坐,ARG
RETURN 10

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_結跏趺坐
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_結跏趺坐,ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_結跏趺坐,ARG
RETURN GET_SPHERE_NUM("적아군전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_結跏趺坐,ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;속도보정
@SKILL_SPEED_結跏趺坐, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_結跏趺坐
RETURN 0

@SKILL_QUICK_ACTION_結跏趺坐, ARG
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_結跏趺坐,ARG,ARG:1,SKILL_NUM
#DIM DYNAMIC SKILL_NUM
CALL HEAL_SINGLE, ARG, ARG, SKILL_NUM
CALL PU_SKILLGAGE_D_SET, ARG, "結跏趺坐", 3

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_結跏趺坐,ARG
PRINTL 명상을 하여 체내에 활성의 기를 순환시킨다.
PRINTL 자신의 HP를 최대 HP의 30%만큼 회복시킨다.
PRINTL 이 스킬은 턴을 소모하지 않고 즉시 발동한다.
PRINTL 이 스킬은 사용 후 3턴 동안 재사용할 수 없다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_結跏趺坐,ARG
RESULTS = 쿨타임:{PU_SKILLGAGE_D_GET(ARG, "結跏趺坐")}
SIF PU_SKILLGAGE_D_GET(ARG, "結跏趺坐")
	RETURN 0
RETURN 1

