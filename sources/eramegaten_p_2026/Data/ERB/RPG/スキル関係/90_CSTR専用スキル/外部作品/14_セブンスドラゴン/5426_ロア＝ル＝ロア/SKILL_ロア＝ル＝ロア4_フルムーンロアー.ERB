;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_フルムーンロアー, ARG, ARG:1, ARG:2
#DIM DYNAMIC L_MP_DAMAGE
SIF ARG:1 < 0
	RETURN 0
L_MP_DAMAGE = MIN(CFLAG:(ARG:1):현데미지 / 4, BASE:(ARG:1):ＭＰ)
SIF L_MP_DAMAGE <= 0
	RETURN 0
TSTR:스킬메시지추가효과 += @" & ＭＰ:{L_MP_DAMAGE, 5}데미지"
CALL VAR_MP, ARG:1, -L_MP_DAMAGE
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_フルムーンロアー, ARG, ARG:1, ARG:2
CALL ATTACK_SKILL, ARG, ARG:1, ARG:2

;====================================================
;実行内容ここまで
;====================================================

