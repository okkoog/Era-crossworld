;NEXT

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_七の太刀・遊蝶華, ARG, ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SINGLE, ARG,POS(ARG:1),SKILL_NUM
CALL SKILLGAGE_H_SET(ARG,SKILL_NUM,0)

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@SKILLGAGE_DISPLAY_七の太刀・遊蝶華, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"七の太刀・遊蝶華")
SIF SKILL_NUM < 1
	RETURN

LOCAL:1 = 0
FOR LOCAL,1,7
	IF SKILLGAGE_H_GETBIT(ARG,SKILL_NUM,LOCAL) == 1
		SELECTCASE LOCAL
		CASE 1
			SETCOLOR COLOR("ピンク")
			PRINT 撫子　
		CASE 2
			SETCOLOR COLOR("白")
			PRINT 白百合　
		CASE 3
			SETCOLOR COLOR("明桃色")
			PRINT 牡丹　
		CASE 4
			SETCOLOR COLOR("赤")
			PRINT 椿　
		CASE 5
			SETCOLOR 0xff1cd9
			PRINT 朝顔　
		CASE 6
			SETCOLOR COLOR("明黄色")
			PRINT 夕顔　
		ENDSELECT
		LOCAL:1 = 1
	ENDIF
NEXT
SIF LOCAL:1
	PRINTL
RESETCOLOR

