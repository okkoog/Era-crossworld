@SKILLGAGE_CHARGE_七の太刀・遊蝶華,ARG,ARG:1
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC L_COLOR
SIF FLAG:행동순1 != ARG
	RETURN 0
SIF !PU_SKILLGAGE_D_GET(ARG, "七の太刀・遊蝶華")
	RETURN 0
CALL PU_SKILLGAGE_D_SET, ARG, "七の太刀・遊蝶華", 0
RESULTS:2 '= ""
FOR LCOUNT, 0, 6
	IF SKILLGAGE_H_GETBIT(ARG, PU_SKILLNUM_GET(ARG, "七の太刀・遊蝶華"), LCOUNT) > 0
		SELECTCASE LCOUNT
			CASE 0
				L_COLOR '= "ピンク"
			CASE 1
				L_COLOR '= "白"
			CASE 2
				L_COLOR '= "明桃色"
			CASE 3
				L_COLOR '= "赤"
			CASE 4
				L_COLOR '= "0xff1cd9"
			CASE 5
				L_COLOR '= "明黄色"
		ENDSELECT
	ELSE
		L_COLOR '= "gray"
	ENDIF	
	SELECTCASE LCOUNT
		CASE 0
			RESULTS += SET_COLOR_TAG("撫子", L_COLOR) + " "
		CASE 1
			RESULTS += SET_COLOR_TAG("白百合", L_COLOR) + " "
		CASE 2
			RESULTS += SET_COLOR_TAG("牡丹", L_COLOR) + " "
		CASE 3
			RESULTS += SET_COLOR_TAG("椿", L_COLOR) + " "
		CASE 4
			RESULTS += SET_COLOR_TAG("朝顔", L_COLOR) + " "
		CASE 5
			RESULTS += SET_COLOR_TAG("夕顔", L_COLOR)
	ENDSELECT
NEXT
RETURN 1