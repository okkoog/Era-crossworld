;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_採血「ガイアの血液」,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM 採血残数
採血残数 = PU_SKILLNUM_GET(ARG,"採血「ガイアの血液」")
CALL SKILL_SET_カジャンダ, ARG, ARG, "공격/방어/마법위력/마법효과/명중/회피", 12, "단체", "NOMES"
CALL SKILL_SET_カジャンダ, ARG, ARG, "크리티컬", 4, "단체", "NOMES"

;CFLAG:ARG:공격강화 = MIN(32, CFLAG:ARG:공격강화 + 12)
;CFLAG:ARG:방어강화 = MIN(32, CFLAG:ARG:방어강화 + 12)
;CFLAG:ARG:마법위력강화 = MIN(32, CFLAG:ARG:마법위력강화 + 12)
;CFLAG:ARG:마법효과강화 = MIN(32, CFLAG:ARG:마법효과강화 + 12)
;CFLAG:ARG:명중강화 = MIN(32, CFLAG:ARG:명중강화 + 12)
;CFLAG:ARG:회피강화 = MIN(32, CFLAG:ARG:회피강화 + 12)
;CFLAG:ARG:크리티컬강화 = MIN(8, CFLAG:ARG:크리티컬강화 + 6)

PRINTFORML %CALLNAME:ARG%의 전 능력, 크리티컬률 강화!

CALL SKILLGAGE_F_ADD,ARG,採血残数,1


;====================================================
;実行内容ここまで
;====================================================






;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_採血「ガイアの血液」,ARG
SELECTCASE PU_SKILLGAGE_F_GET(ARG,"採血「ガイアの血液」")
	CASE 0
		RESULTS = 採血残数：★★★
	CASE 1
		RESULTS = 採血残数：★★☆
	CASE 2
		RESULTS = 採血残数：★☆☆
	CASE 3
		RESULTS = 採血残数：禁止！
ENDSELECT
RETURN 3

@SKILL_EX_DISPLAY_採血「ガイアの血液」, ARG, ARGS
RESULTS = %SET_COLOR_TAG("★", "RED")%
RESULTS += HTML_RECT_SPLIT_BAR(3 - PU_SKILLGAGE_F_GET(ARG, "採血「ガイアの血液」"), 3, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("赤"), RESULT:1)
RESULTS:1 = 採血残数
RETURN 1


;　説明文の表示
@SKILL_EXPLAIN_採血「ガイアの血液」,ARG
PRINTL 자신의 전 능력치를 3단계, 필살률을 6 상승시킨다.
PRINTL 사용 횟수 제한: 탐색 중 합계 3회까지. (상점 화면으로 이행 시 회복)
PRINTL 
PRINTL 땅 밑바닥에서 자신의 양분이 되는 것을 빨아올려 힘으로 삼는 도철의 식성의 일환.
PRINTL 석유는 지구의 피라 불리지만, 이 세계에서는 MAG도 포함되어 있을 것이다.
PRINTL 빨아올려 고갈되지 않도록 규제가 마련되어…… 있는지는 본인만이 알 것이다.
PRINTL 사신 토테츠 유마의 스펠카드 (CSTR 전용)

