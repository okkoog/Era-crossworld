;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_鉄陣甲, ARG
	RESULTS = 鉄陣甲

;　명중
@SKILL_HITRATE_KE_鉄陣甲, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_鉄陣甲, ARG
RETURN 300

;クリティカル率
@SKILL_CRITICAL_RATE_KE_鉄陣甲, ARG
RETURN 20

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_鉄陣甲, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_鉄陣甲, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_鉄陣甲, ARG
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 40
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_KE_鉄陣甲, ARG
IF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 40
	RESULTS = %"40ＴＰ"%
	RETURN 0
ENDIF
RETURN 15

;　相性
@SKILL_TYPE_KE_鉄陣甲, ARG
RETURN GET_TYPE_NUM("타격")
;타격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_鉄陣甲
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_鉄陣甲, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_鉄陣甲, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_KE_鉄陣甲, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_鉄陣甲, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_鉄陣甲, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_KE_鉄陣甲, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_鉄陣甲
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_鉄陣甲, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;Fゲージ再回収できる様に起動前にTP40消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 40, "-="

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_鉄陣甲, ARG
PRINTL 
PRINTL 자신의 갑에 중심을 두고 적에게 때려박는 오의.
PRINTL 적 단체에 대위력 고크리티컬률의 물리 공격을 가한다.
PRINTL 
PRINTL 무국 야마토 여왕 사미다레의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_鉄陣甲, ARG
;ゲージが40のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 40
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_鉄陣甲, ARG
RESULTS:0 = 자신의 갑에 중심을 두고 적에게 때려박는 오의.
RESULTS:1 = 적 단체에 대위력 고크리티컬률의 물리 공격을 가한다.
RESULTS:2 = TP消費 40
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 40
	RESULTS:2 = %RESULTS:1%(不足)