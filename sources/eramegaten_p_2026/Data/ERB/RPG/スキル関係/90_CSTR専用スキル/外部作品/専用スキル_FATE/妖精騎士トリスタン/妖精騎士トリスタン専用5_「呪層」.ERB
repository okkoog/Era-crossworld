;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_「呪層」,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

FLAG:확산플래그 = 0

IF FLAG:카운터중 == 1
	FLAG:확산플래그 = 1
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
ELSE
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
ENDIF

FLAG:확산플래그 = 0

