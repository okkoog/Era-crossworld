@ACTION_FIELD_∞黒餡子,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

CALL HEAL_SINGLE,ARG,ARG,SKILL_NUM	;単体回復

;====================================================
;実行内容ここまで
;====================================================
;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_∞黒餡子,ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"∞黒餡子")
IF SKILLGAGE_D_GET(ARG,SKILL_NUM) > 0 && SKILLGAGE_H_GET(ARG,SKILL_NUM) > 0
	IF SKILLGAGE_H_GETBIT(ARG,SKILL_NUM,1)
		RESULTS += SET_COLOR_TAG("【검】", "P-GREEN")
	ELSE
		RESULTS += SET_COLOR_TAG("【검】", "gray")
	ENDIF
	IF SKILLGAGE_H_GETBIT(ARG,SKILL_NUM,2)
		RESULTS += SET_COLOR_TAG("【電】", "P-BLUE")
	ELSE
		RESULTS += SET_COLOR_TAG("【電】", "gray")
	ENDIF
	IF SKILLGAGE_H_GETBIT(ARG,SKILL_NUM,3)
		RESULTS += SET_COLOR_TAG("【重】", "RED")
	ELSE
		RESULTS += SET_COLOR_TAG("【重】", "gray")
	ENDIF
	RESULTS += @"∞栗餡子:{SKILLGAGE_D_GET(ARG,SKILL_NUM)}Ｔ"
	RETURN 3
ENDIF

