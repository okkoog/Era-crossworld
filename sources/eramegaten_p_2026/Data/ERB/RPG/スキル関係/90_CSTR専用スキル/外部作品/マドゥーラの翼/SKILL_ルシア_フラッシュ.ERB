;ルシア専用スキル。消費は大きいものの画面全体の敵に問答無用で大ダメージを与える

;スキル名
@SKILL_NAME_フラッシュ_マドゥーラの翼,ARG
RESULTS = 플래시

;　명중
@SKILL_HITRATE_フラッシュ_マドゥーラの翼, ARG
RETURN 100

;　威力
@SKILL_POWER_フラッシュ_マドゥーラの翼, ARG
RETURN 420

;クリティカル率
;@SKILL_CRITICAL_RATE_フラッシュ_マドゥーラの翼, ARG
;RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_フラッシュ_マドゥーラの翼,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_フラッシュ_マドゥーラの翼,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_フラッシュ_マドゥーラの翼, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_フラッシュ_マドゥーラの翼,ARG
RETURN 60

;　相性
@SKILL_TYPE_フラッシュ_マドゥーラの翼,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_フラッシュ_マドゥーラの翼
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_フラッシュ_マドゥーラの翼,ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_フラッシュ_マドゥーラの翼,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_フラッシュ_マドゥーラの翼,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_フラッシュ_マドゥーラの翼,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_フラッシュ_マドゥーラの翼,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_フラッシュ_マドゥーラの翼, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_フラッシュ_マドゥーラの翼
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_フラッシュ_マドゥーラの翼
RETURN GET_SUCCESSION_NUM("만능")

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_フラッシュ_マドゥーラの翼,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;範囲攻撃
CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_フラッシュ_マドゥーラの翼,ARG
PRINTL 적 전체에 만능 속성의 특대 데미지
PRINTL 성스러운 십자가에 마력을 담아 전신에서 강렬한 섬광을 발하는 루시아의 필살기

@SKILL_EXPLAIN_TOOLTIP_フラッシュ_マドゥーラの翼, ARG
RESULTS:0 = 적 전체에 만능 속성의 특대 데미지
RESULTS:1 = 성스러운 십자가에 마력을 담아 전신에서 강렬한 섬광을 발하는 루시아의 필살기

;使用条件
@SKILL_SPECIAL_ACTIONABLE_フラッシュ_マドゥーラの翼,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_フラッシュ_マドゥーラの翼, ARG = -1
RETURN 15
