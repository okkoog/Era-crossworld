;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_狼騎士の咆哮, ARG
RESULTS = 늑대기사의 포효

;　명중
@SKILL_HITRATE_KE_狼騎士の咆哮, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_狼騎士の咆哮, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_狼騎士の咆哮, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_狼騎士の咆哮, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_狼騎士の咆哮, ARG
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 25
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_KE_狼騎士の咆哮, ARG
IF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 25
	RESULTS = %" 25ＴＰ"%
	RETURN 0
ENDIF
RETURN 10

;　相性
@SKILL_TYPE_KE_狼騎士の咆哮, ARG
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_狼騎士の咆哮
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_狼騎士の咆哮, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_KE_狼騎士の咆哮, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_狼騎士の咆哮, ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_狼騎士の咆哮, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;속도보정
@SKILL_SPEED_KE_狼騎士の咆哮, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_狼騎士の咆哮
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_狼騎士の咆哮, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM
;ゲージ再回収できる様に起動前にTP25消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 25, "-="
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "공격", 4, "範囲"

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_狼騎士の咆哮, ARG
PRINTL 
PRINTL 늑대기사에 의한 아군을 고무하는 포효.
PRINTL 아군 전체의 공격력을 상승시킨다.
PRINTL 
PRINTL 늑대기사 아벤트의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_狼騎士の咆哮, ARG
;ゲージが25以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 25
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_狼騎士の咆哮, ARG
RESULTS:0 = 늑대기사에 의한 아군을 고무하는 포효. 아군 전체의 공격력을 상승시킨다.
RESULTS:1 = TP消費 25
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 25
	RESULTS:1 = %RESULTS:1%(不足)