;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_クロスマジック, ARG
IF FLAG:행동순1 == ARG
	SELECTCASE PU_SKILLGAGE_F_GET(ARG, "KE_クロスマジック")
		CASE 0
			RESULTS = 크로스 파이어
		CASE 1
			RESULTS = 크로스 프리즈
		CASEELSE
			RESULTS = 크로스 라이징
	ENDSELECT
ELSE
	RESULTS = 크로스 매직
ENDIF

;　명중
@SKILL_HITRATE_KE_クロスマジック, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_クロスマジック, ARG
RETURN 150

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_クロスマジック, ARG
IF TFLAG:스킬용1 == 0
	RETURN 1
ENDIF
RETURN TFLAG:스킬용1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_クロスマジック, ARG
IF TFLAG:스킬용1 == 0
	RETURN 1
ENDIF
RETURN TFLAG:스킬용1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_クロスマジック, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_KE_クロスマジック, ARG
RETURN 16

;　相性
@SKILL_TYPE_KE_クロスマジック, ARG
#LOCALSIZE 1
LOCAL = PU_SKILLGAGE_F_GET(ARG, "KE_クロスマジック")
SIF (FLAG:공격횟수 + LOCAL) % 3 == 0
	RETURN GET_TYPE_NUM("화염")
SIF (FLAG:공격횟수 + LOCAL) % 3 == 1
	RETURN GET_TYPE_NUM("빙결")
SIF (FLAG:공격횟수 + LOCAL) % 3 == 2
	RETURN GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_クロスマジック
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_クロスマジック, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_クロスマジック, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_KE_クロスマジック, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_クロスマジック, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_クロスマジック, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_KE_クロスマジック, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_クロスマジック
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_クロスマジック, ARG, ARG:1, SKILL_NUM
#DIM SKILL_NUM
DO
	++TFLAG:스킬용1
LOOP RAND:2

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

TFLAG:스킬용1 = 0
;====================================================
;追加コマンド(一番下)
;====================================================
@INPUT_COM_NAME_KE_クロスマジック,ARG
#DIMS CONST L_TYPE = "화염", "빙결", "전격"
RESULTS = KE_クロスマジック
RESULTS:1 = X매직 첫 격≪%L_TYPE:PU_SKILLGAGE_F_GET(ARG, "KE_クロスマジック")%≫
RETURN 2

@INPUT_COM_ABLE_KE_クロスマジック,ARG
RETURN 1

; ====================================================
; コマンド実行
; ====================================================
@INPUT_COM_KE_クロスマジック,ARG
CALL PU_SKILLGAGE_F_SET, ARG, "KE_クロスマジック", (PU_SKILLGAGE_F_GET(ARG, "KE_クロスマジック") + 1) % 3
HTML_PRINT_ISLAND  @"<div xpos = '0' ypos = '0' width = '{CLIENTWIDTH()}px' height = '{CLIENTHEIGHT()}px' display = 'absolute-lefttop' background_color = '%TOSTR_HTML(GETBGCOLOR())%'>" + "</div>"
TWAIT 200, 1
HTML_PRINT_ISLAND_CLEAR
RETURN 0
;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_クロスマジック, ARG
PRINTL 
PRINTL 제자들과의 콤비네이션으로 다양한 마법 공격을 때려박는다.
PRINTL 적 단체에 1hit마다 속성이 변화하는(화염→빙결→전격→이하 루프) 마법 공격을 가한다.
PRINTL 공격 횟수는 독자적인 판정(1hit마다 50% 판정을 거쳐 성공 시 다음 hit 판정)으로 결정된다.
PRINTL 
PRINTL 유격마도사 베로의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_クロスマジック, ARG
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_クロスマジック, ARG
RESULTS:0 = 제자들과의 콤비네이션으로 다양한 마법 공격을 때려박는다.
RESULTS:1 = 적 단체에 1hit마다 속성이 변화하는(화염→빙결→전격→이하 루프) 마법 공격을 가한다.
RESULTS:2 = 攻撃回数は独自の判定（１hit毎に50％の判定を行い、判定成功で次のhitの判定に入る）で決まる。
