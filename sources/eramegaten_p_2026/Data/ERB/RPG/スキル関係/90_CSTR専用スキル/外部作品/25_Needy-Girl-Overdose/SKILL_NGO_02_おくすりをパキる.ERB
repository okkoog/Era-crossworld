	CALL HEAL_SINGLE,ARG,ARG,SKILL_NUM	;自己回復
	ITEM:미약 -= 1
	PRINTW 약 나왔습니다!
	CALL SET_RPG_CFLAG_DUNGEON, ARG, "스트레스치", 0

ELSE
	PRINTW 약이, 없어!
ENDIF


