;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_弱みは付け込み, ARG = -1, ARG:1 = -1
RETURN 4
;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;
;====================================================
@SKILL_TRIGGER_ACTIONABLE_弱みは付け込み,ARG,ARG:1
;自分じゃなければNG
SIF FLAG:행동순1 != ARG
	RETURN 0
;判定は一回のみ
SIF ARG != ARG:1
	RETURN 0
IF CFLAG:ARG:PT플래그
	SIF GROUPMATCH(CFLAG:ARG:타겟, 17, 18, 19)
		RETURN 0
	SIF INRANGE(CFLAG:ARG:타겟, 1, 6)
		RETURN 0
ELSE
	SIF GROUPMATCH(CFLAG:ARG:타겟, 20, 21, 22)
		RETURN 0
	SIF INRANGE(CFLAG:ARG:타겟, 7, 16)
		RETURN 0
ENDIF
;何見てるのを確認
SIF !(IS_PU_SKILL_入力行動(ARG, "何見てるの"))
	RETURN 0
;入力行動が攻撃スキルでかつターゲットがちゃんと存在していること
CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
SIF RESULT != 1 || CFLAG:ARG:타겟 < 1
	RETURN 0
;命中してないとダメ
SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "HIT")
    RETURN 0
;殺したらダメ
SIF GET_CREC_ACT(FLAG:행동순1, ARG:1, "KILL")
    RETURN 0
;敵のHPが50%以下か、51%以上だと通らない
SIF 現HP割合(ARG:1) > 50
	RETURN 0
RETURN 1, CFLAG:ARG:타겟
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_弱みは付け込み,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
IF INRANGE(ARG:1, 1, 16)
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM
ELSE
	CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM
ENDIF
