;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ムーン・C,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM DI残りターン
#DIM スキル番号
#LOCALSIZE 4
スキル番号 = PU_SKILLNUM_GET(ARG,"Ｄ・いんすとーる")
DI残りターン = SKILLGAGE_D_GET(ARG,スキル番号)
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================
;　説明文の表示
@SKILL_EXPLAIN_ムーン・C,ARG
#DIM DI残りターン
#DIM スキル番号
スキル番号 = PU_SKILLNUM_GET(ARG,"Ｄ・いんすとーる")
DI残りターン = SKILLGAGE_D_GET(ARG,スキル番号)
PRINTL 기술명: 문·차일드
PRINTL 강인한 용의 날개에 전기를 두르고 돌격하여 적을 한데 쓸어버린다
PRINTL 적 1열에 전격 물리 대데미지+SHOCK 후열 사용 가능
PRINTL 용희 쿠드라의 전용기
IF DI残りターン > 0
	SETCOLOR 0xed1e25
	PRINTFORML %CALLNAME:ARG%(은)는 힘을 끌어내고 있다…… (전 내성 관통, 소비 MP 상승)
	RESETCOLOR
ENDIF

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ムーン・C,ARG
RETURN 1
