;アルトアイゼン・ナハト専用スキル。
;単体電撃物理、威力280、MP15、ランク7

;スキル名
@SKILL_NAME_ダレイズ・ホーン,ARG
RESULTS = 더 레이어스 혼

;　명중
@SKILL_HITRATE_ダレイズ・ホーン, ARG
RETURN 100

;　威力
@SKILL_POWER_ダレイズ・ホーン, ARG
RETURN 280

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ダレイズ・ホーン,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ダレイズ・ホーン,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ダレイズ・ホーン, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ダレイズ・ホーン,ARG
RETURN 15

;　相性
@SKILL_TYPE_ダレイズ・ホーン,ARG
RETURN GET_TYPE_NUM("전격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ダレイズ・ホーン
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ダレイズ・ホーン,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ダレイズ・ホーン,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ダレイズ・ホーン,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ダレイズ・ホーン,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ダレイズ・ホーン,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_ダレイズ・ホーン, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ダレイズ・ホーン
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_ダレイズ・ホーン
RETURN GET_SUCCESSION_NUM("전격")

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_ダレイズ・ホーン,ARG
RETURN GET_STATE_NUM("SHOCK")


;추가효과상성
@SKILL_ADDTIONAL_TYPE_ダレイズ・ホーン,ARG
RETURN GET_TYPE_NUM("전격")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_ダレイズ・ホーン,ARG
RETURN 20

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_ダレイズ・ホーン,ARG
RETURN 95
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ダレイズ・ホーン,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;単体攻撃
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_ダレイズ・ホーン,ARG
PRINTL 머리의 뿔을 대전시켜 적을 꿰찌른다.
PRINTL 적 단체에 전격 상성의 물리 대데미지. 확률에 따라 SHOCK 상태로 만든다.

@SKILL_EXPLAIN_TOOLTIP_ダレイズ・ホーン, ARG
RESULTS:0 = 머리의 뿔을 대전시켜 적을 꿰찌른다.
RESULTS:1 = 적 단체에 전격 상성의 물리 대데미지. 확률에 따라 SHOCK 상태로 만든다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ダレイズ・ホーン,ARG
RETURN 1

;スキル変化用ランク
@SKILL_RANK_ダレイズ・ホーン, ARG = -1
RETURN 7
