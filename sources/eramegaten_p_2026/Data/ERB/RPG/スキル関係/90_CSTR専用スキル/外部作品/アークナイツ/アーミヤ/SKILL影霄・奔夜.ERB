@AUTO_PU_SKILL_影霄・奔夜,ARG,ARGS,ARG:1,ARG:2
#DIM SKILL_RANK
#DIM SKILL_NUM
#DIM L_USER
;ARG = 攻撃者
;ARGS （ダメージ↑、被ダメージ↑、命中↑、回避↑、魔威↑、魔効↑、etc…）といった感じの奴
;ARG:1 = 防御者
;文字列を参考にする都合上、どの文字列を使うか事前に定めておいた方がいいかも
;CSTR:ARG:100 = EXTRA勢出典作品、『アークナイツ』とでも書き込む（予定）
;CSTR:ARG:101 = EXTRA勢出典作品でどのキャラなのか、とりあえず『アーミヤ（前衛）』とでも書き込む（予定）
;CSTR:ARG:105 = 専用スキルその2のスキルランク変数として使用、この場合は『影霄・奔夜』が対象（予定）
L_USER = -1
SELECTCASE ARGS
	CASE "ダメージ↑"
		SIF CSTR:ARG:101 == "アーミヤ（前衛）"
			L_USER = ARG
	CASE "魔法回避判定↑"
		SIF CSTR:(ARG:1):101 == "アーミヤ（前衛）"
			L_USER = ARG:1
	;CASE "Hゲージ最大値","Hゲージ初期値","Dゲージ最大値"
	;	L_USER = ARG
ENDSELECT
SIF L_USER == -1
	RETURN 0
SKILL_RANK = TOINT(CSTR:L_USER:105)
SKILL_NUM = PU_SKILLNUM_GET(L_USER,"影霄・奔夜")
;IF ARGS == "Hゲージ最大値"
;	;スキルHゲージの最大値を決める処理
;	SELECTCASE SKILL_RANK
;		CASE 1
;			RETURN 45
;		CASE 2
;			RETURN 42
;		CASE 3
;			RETURN 39
;		CASE 4
;			RETURN 35
;	ENDSELECT
;ELSEIF ARGS == "Hゲージ初期値"
;	;スキルHゲージの初期値を決める処理
;	RETURN 10
;ELSEIF ARGS == "Dゲージ最大値"
;	;スキルDゲージの最大値を決める処理
;	SELECTCASE SKILL_RANK
;		CASE 1
;			RETURN 5
;		CASE 2 TO 4
;			RETURN 6
;	ENDSELECT
;ENDIF
IF SKILLGAGE_F_GET(L_USER,SKILL_NUM) < 0
	SELECTCASE ARGS
		CASE "ダメージ↑"
			;与ダメージとかに挟む場合の処理
			SELECTCASE SKILL_RANK
				CASE 1
					RETURN 10
				CASE 2
					RETURN 18
				CASE 3
					RETURN 25
				CASE 4
					RETURN 40
			ENDSELECT
		CASE "魔法回避判定↑"
			RETURN 8
	ENDSELECT
ENDIF
