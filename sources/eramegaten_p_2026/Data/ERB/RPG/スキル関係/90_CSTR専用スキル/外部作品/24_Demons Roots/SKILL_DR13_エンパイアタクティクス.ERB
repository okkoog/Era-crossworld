;ターン終了時処理
@SKILL_TURNEND_エンパイアタクティクス,ARG,ARG:1
IF PU_SKILLGAGE_H_GET(ARG, "エンパイアタクティクス") > 0 && PU_SKILLGAGE_H_GET(ARG, "エンパイアタクティクス") - FLAG:경과턴수 >= 0
	CALL PRINT_ACT_MESSAGE, ARG, , , , "エンパイアタクティクス", "NOWAIT"
	CALL SKILL_SET_カジャンダ, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, "공격/방어/마법위력/마법효과/명중/회피", -4, "範囲"
ENDIF

