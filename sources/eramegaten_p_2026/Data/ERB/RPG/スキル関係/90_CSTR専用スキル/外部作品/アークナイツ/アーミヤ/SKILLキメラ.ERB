	RESETCOLOR
	CALL SYNC_STATUS,ARG
	CALL AUTO_PU_SKILL_キメラ(ARG,"最大ＨＰ↑")
	BASE:ARG:ＨＰ = MIN(BASE:ARG:ＨＰ * (RESULT + 100) / 100,MAXBASE:ARG:ＨＰ)
ENDIF
