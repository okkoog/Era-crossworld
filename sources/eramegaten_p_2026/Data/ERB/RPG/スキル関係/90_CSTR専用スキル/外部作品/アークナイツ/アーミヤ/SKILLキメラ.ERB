;独自処理
;====================================================
;（予定）と付けられている方は仮置きの物。実際に採用されるかどうかはわからない。
@AUTO_PU_SKILL_キメラ,ARG,ARGS,ARG:1,ARG:2
#DIM SKILL_RANK
#DIM SKILL_NUM
;ARG = 使用者
;ARGS （ダメージ↑、被ダメージ↑、命中↑、回避↑、魔威↑、魔効↑、etc…）といった感じの奴
;文字列を参考にする都合上、どの文字列を使うか事前に定めておいた方がいいかも
;CSTR:ARG:100 = EXTRA勢出典作品、『アークナイツ』とでも書き込む（予定）
;CSTR:ARG:101 = EXTRA勢出典作品でどのキャラなのか、とりあえず『アーミヤ（アークナイツ）』とでも書き込む（予定）
;CSTR:ARG:102 = 専用スキルその2のスキルランク変数として使用、この場合は『戦術詠唱γ』が対象（予定）
;CSTR:ARG:103 = 専用スキルその1のスキルランク変数として使用、この場合は『レーヴァテイン（ＡＮ）』が対象（予定）
;CSTR:ARG:104 = 専用スキルその3のスキルランク変数として使用、この場合は『キメラ』が対象（予定）
SKILL_RANK = TOINT(CSTR:ARG:104)
SKILL_NUM = PU_SKILLNUM_GET(ARG,"キメラ")
;IF ARGS == "Hゲージ最大値"
;	;スキルHゲージの最大値を決める処理
;	RETURN 120
;ELSEIF ARGS == "Hゲージ初期値"
;	;スキルHゲージの初期値を決める処理
;	RETURN 0
;ELSEIF ARGS == "Dゲージ最大値"
;	;スキルDゲージの最大値を決める処理
;	RETURN 6
;ENDIF
IF SKILLGAGE_F_GET(ARG,SKILL_NUM) < 0
	SELECTCASE ARGS
		CASE "ダメージ↑"
			;与ダメージとかに挟む場合の処理
			;魔法ダメージを与える処理でなければダメ
			CALL GET_SKILL_PROP, "SKILL_DAMAGETYPE", PU_SKILLGAGE_F_GET(ARG, "アブソープション"),ARG
			SIF RESULT != 2
				RETURN 0
			SELECTCASE SKILL_RANK
				CASE 1
					RETURN 50
				CASE 2
					RETURN 65
				CASE 3
					RETURN 80
				CASE 4
					RETURN 115
			ENDSELECT
		CASEELSE
			RETURN 0
	ENDSELECT
ENDIF
RETURN 0


;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_キメラ, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	;RESULT = 修正値
	;RESULTS = 加算/乗算/固定値/活泉/魔脈
	;加算はそのまま固定値を加算する。乗算は(100+X)/100倍にする。固定値は必ずその数値にする(55ならなにがあろうと最大HP55になる)
	;活泉/魔脈はそのまま同種スキルと同じ枠となりもっとも効果量が高いものを優先する形になる
	;HP半減
	CASE "HP補正"
		RESULTS = 乗算
		;固定値ではなく、変動する倍率を指定
		;固定値を指定する場合は"ＨＰ増加"を使う
		; 最大ＨＰ（適用後） = 最大ＨＰ（適用前） * (보정 + 100) / 100 の式で行われる点に注意
		SELECTCASE TOINT(CSTR:ARG:104)
			CASE 1
				RETURN 25
			CASE 2
				RETURN 50
			CASE 3
				RETURN 75
			CASE 4
				RETURN 100
		ENDSELECT
ENDSELECT
RETURN 0
