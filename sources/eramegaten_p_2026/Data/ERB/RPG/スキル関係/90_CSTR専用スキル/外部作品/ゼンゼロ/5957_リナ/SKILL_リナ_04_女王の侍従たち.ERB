;　威力
@SKILL_POWER_女王の侍従たち, ARG
SIF ARG < 0
	RETURN 20
CALL GET_SKILL_POWER_女王の侍従たち(GET_ROLE_CFLAG_TAKEOVER(ARG, "特殊スキルランク"))
RETURN RESULT

@GET_SKILL_POWER_女王の侍従たち, ARG
SELECTCASE ARG
	CASE 15
		RETURN 100
	CASE 11 TO 14
		RETURN 80 + (ARG - 10) * 4
	CASE 10
		RETURN 80
	CASE 2 TO 14
		RETURN 14 + 6 * ARG
	CASE 0, 1
		RETURN 20
	CASEELSE
		RETURN 0
ENDSELECT

