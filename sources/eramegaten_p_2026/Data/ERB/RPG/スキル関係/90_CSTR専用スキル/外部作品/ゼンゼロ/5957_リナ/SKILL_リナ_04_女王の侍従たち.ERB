;スキル名
@SKILL_NAME_女王の侍従たち,ARG
RESULTS = 여왕의 시종들
IF FLAG:총공격중 && ARG >= 0
	IF PU_SKILLGAGE_H_GET(ARG, "女王の侍従たち") % 2
		TSTR:스킬메시지행동자 '= "ドリシラ"
	ELSE
		TSTR:스킬메시지행동자 '= "アナステラ"
	ENDIF
ENDIF
;　명중
@SKILL_HITRATE_女王の侍従たち, ARG
