;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_女王の侍従たち, ARG = -1, ARG:1 = -1
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "女王の侍従たち")
	RETURN 0, 4
ELSE
	RETURN 0, 0
ENDIF
;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_女王の侍従たち, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
IF PU_SKILLGAGE_H_GET(ARG, "女王の侍従たち") % 2
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "攻撃・魔法威力・命中", -4, "短縮"
ELSE
	CALL SKILL_SET_カジャンダ, ARG, ARG:1, "防御・魔法効果・回避", -4, "短縮"
ENDIF

;====================================================
;トリガー発動条件
;====================================================
@SKILL_TRIGGER_ACTIONABLE_女王の侍従たち,ARG,ARG:1
#DIM DYNAMIC L_MAIN
IF CFLAG:ARG:피링크캐릭터실제가입시간 > 0
	L_MAIN = FINDCHARA_TIMEID(CFLAG:ARG:피링크캐릭터실제가입시간)
ELSE
	L_MAIN = ARG
ENDIF
SIF FLAG:행동순1 != L_MAIN
	RETURN 0
;味方は対象外
SIF IS_FRIEND(L_MAIN, ARG:1)
	RETURN 0
SIF !PU_SKILLGAGE_H_GET(ARG, "女王の侍従たち")
	RETURN 0
SIF !GET_CREC_ACT(L_MAIN, ARG:1, "HIT")
	RETURN 0
RETURN 1, CPOS(ARG:1)

@SKILL_TRIGGER_ACTIONABLE_USEABLE_RESERVE_女王の侍従たち, ARG
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_女王の侍従たち,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
IF FLAG:총공격중
	TFLAG:반사0데미지화 = 1
	CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM
	TFLAG:반사0데미지화 = 0
ELSE
	CALL PRINT_HIT_MESSAGE, ARG, "ドリシラとアナステラに進撃するように指示を出した！", "w"
	CALL PU_SKILLGAGE_H_SET, ARG, "女王の侍従たち", 7
	CALL ADD_DECIBEL_PTS, ARG, -3000
ENDIF

;　説明文の表示
@SKILL_EXPLAIN_女王の侍従たち,ARG
PRINTL 【특수 강화】【리나 전용 스킬】
PRINTL 데시벨 3000pts를 소비하여 발동한다.
PRINTL 발동 후 7턴 동안 파티가 공격할 때마다 이하의 연동 효과가 발동한다.
PRINTL 「공격받은 대상에게 전격 상성의 극소 데미지를 주고, 저확률로 SHOCK을 부여한다.
PRINTL  추가로 대상의 공격·마법위력·명중률 혹은 방어·마법효과·회피율을 저하시킨다.」

@ENHANCE_SKILL_EXPLAIN_女王の侍従たち,ARG
RESULTS '= "発動後７ターンの間、チームが攻撃するたびに以下の連動効果が発動する。" + "<br>"
RESULTS += "「攻撃を受けた対象に電撃相性の極小ダメージを与え、低確率でSHOCKを付着する。" + "<br>"
RESULTS += " さらに攻撃・魔法威力・命中率あるいは防御・魔法効果・回避率を低下させる。」"

@SKILL_TURNEND_女王の侍従たち, L_CHARA, ARG
#DIM DYNAMIC L_CHARA
CALL PU_SKILLGAGE_H_SET, L_CHARA, "女王の侍従たち", MAX(PU_SKILLGAGE_H_GET(L_CHARA, "女王の侍従たち") - 1, 0)

@SKILL_TURNEND_USEABLE_RESERVE_女王の侍従たち, L_CHARA
#DIM DYNAMIC L_CHARA
RETURN 1

