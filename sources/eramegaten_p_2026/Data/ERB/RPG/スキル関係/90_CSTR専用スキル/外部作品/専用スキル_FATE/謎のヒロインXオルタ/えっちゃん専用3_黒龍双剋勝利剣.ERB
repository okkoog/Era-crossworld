;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_黒龍双剋勝利剣, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM TOTAL_DMG_B
;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			TOTAL_DMG_B = 0
			IF SKILLGAGE_D_GET(L_ACTOR,SKILL_NUM) > 0 && GET_ALI1(ABL:L_TARGET:속성LD) == "Light" && TOINT(CSTR:L_ACTOR:102) > 2
				RESULTS = Light特攻
				TOTAL_DMG_B += 50
			ENDIF
			IF CFLAG:L_ACTOR:입력행동 == SKILL_NUM
				CALL SABER_SERVANT_CHECK(L_ACTOR, L_TARGET)
				IF RESULT
					RESULTS:1 = 세이버 특효
					TOTAL_DMG_B += 150
				ENDIF
			ENDIF
			RETURN TOTAL_DMG_B
	ENDSELECT
ENDIF
