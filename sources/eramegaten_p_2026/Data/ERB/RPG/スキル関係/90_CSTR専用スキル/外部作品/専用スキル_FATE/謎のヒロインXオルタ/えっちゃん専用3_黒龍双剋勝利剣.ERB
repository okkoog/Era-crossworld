@SKILL_HITRATE_黒龍双剋勝利剣, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"黒龍双剋勝利剣")
;初段以降は初段の判定結果に従う
IF SKILLGAGE_H_GET(ARG,SKILL_NUM) > 1
	IF GET_CREC_ACT(ARG, -1, "AVOID")
		RETURN 0
	ELSE
		RETURN 999
	ENDIF
ELSE
	RETURN 130
ENDIF

;1撃目以降で相手が回避失敗ではなかった場合、命中率を0に
