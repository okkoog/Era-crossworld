;	RETURN 0
;RETURN 130


;　威力
@SKILL_POWER_黒龍双剋勝利剣, ARG
#DIM SKILL_NUM
#DIM L_DMG
SKILL_NUM = PU_SKILLNUM_GET(ARG,"黒龍双剋勝利剣")
;総威力は300,450,500、強化イベント経由時は400,550,600
SELECTCASE SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"))
	CASE IS > 3
		SELECTCASE TOINT(CSTR:ARG:102)
			CASE IS > 2
				L_DMG = 600
			CASEELSE
				L_DMG = 500
		ENDSELECT
	CASE IS > 1
		SELECTCASE TOINT(CSTR:ARG:102)
			CASE IS > 2
				L_DMG = 550
			CASEELSE
				L_DMG = 450
		ENDSELECT
	CASEELSE
		SELECTCASE TOINT(CSTR:ARG:102)
			CASE IS > 2
				L_DMG = 400
			CASEELSE
				L_DMG = 300
		ENDSELECT
ENDSELECT

SELECTCASE SKILLGAGE_H_GET(ARG,SKILL_NUM)
	CASE 1
		TIMES L_DMG , 0.02
	CASE 2
		TIMES L_DMG , 0.04
	CASE 3
		TIMES L_DMG , 0.06
	CASE 4
		TIMES L_DMG , 0.08
	CASE 5
		TIMES L_DMG , 0.11
	CASE 6
		TIMES L_DMG , 0.13
	CASE 7
		TIMES L_DMG , 0.15
	CASE 8
		TIMES L_DMG , 0.17
	CASE 9
		TIMES L_DMG , 0.24
ENDSELECT

RETURN L_DMG

