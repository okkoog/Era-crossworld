@SABER_SERVANT_CHECK,ARG,ARG:1
;セイバーサーヴァントとして認識されるのはFGO側でセイバーとして扱われた悪魔、後はEXTRA勢で剣とか持ってそうな奴
;後は刀、レイピア、剣を持ってて、尚且つ非人間の奴もセイバーサーヴァント認定される
;クラススキル「セイバー」を所持していなくても、CFLAG:(ARG:1):専用技のどこかに設定されていれば問答無用で特攻対象
SIF PU_SKILL_CHECK(ARG:1,"セイバー")
	RETURN 1
SELECTCASE NO:(ARG:1)
	CASE [[キャラ:파랑세이버]],[[キャラ:빨강세이버]],[[キャラ:라마]],[[キャラ:지크프리트]],[[キャラ:아서]],[[キャラ:수르트]],[[キャラ:사야카]],[[キャラ:요우무]],[[キャラ:모미지_동방]],[[キャラ:텐시]],[[キャラ:요리히메]],[[キャラ:Ａ・치르노]],[[キャラ:락슈미]]
		RETURN 1
ENDSELECT
RESULT = 0
TRYCALLFORM 剣タイプ_{EQUIP:(ARG:1):검}
SELECTCASE RESULT
	CASE 1,2,4
		SIF GET_ROLE_PROP("CAN_USE_EQUIP", ARG:1)
			RETURN 1 
		;SIF (ABL:(ARG:1):종족 != 0 || CFLAG:(ARG:1):악마변신)
		;	RETURN 1
ENDSELECT
RETURN 0

