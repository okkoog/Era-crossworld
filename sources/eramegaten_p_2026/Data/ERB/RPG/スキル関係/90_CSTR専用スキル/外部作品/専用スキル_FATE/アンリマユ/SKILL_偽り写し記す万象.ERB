;　威力
@SKILL_POWER_偽り写し記す万象, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"偽り写し記す万象")

IF SKILLGAGE_H_GET(ARG,SKILL_NUM) >= 1000
	RETURN 400
ELSEIF SKILLGAGE_H_GET(ARG,SKILL_NUM) >= 800
	RETURN 350
ELSEIF SKILLGAGE_H_GET(ARG,SKILL_NUM) >= 700
	RETURN 300
ELSEIF SKILLGAGE_H_GET(ARG,SKILL_NUM) >= 600
	RETURN 270
ELSEIF SKILLGAGE_H_GET(ARG,SKILL_NUM) >= 500
	RETURN 230
ELSEIF SKILLGAGE_H_GET(ARG,SKILL_NUM) >= 400
	RETURN 200
ELSEIF SKILLGAGE_H_GET(ARG,SKILL_NUM) >= 300
	RETURN 150
ELSEIF SKILLGAGE_H_GET(ARG,SKILL_NUM) >= 200
	RETURN 130
ELSE
	RETURN 100
ENDIF

