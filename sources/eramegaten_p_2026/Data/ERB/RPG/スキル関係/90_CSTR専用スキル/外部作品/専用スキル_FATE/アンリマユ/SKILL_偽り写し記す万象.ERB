;====================================================
;戦闘開始時に行う処理
;====================================================
@SKILL_BATTLE_START_偽り写し記す万象,ARG,ARG:1
;常に100の状態を維持する
SIF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")) < 100
	CALL SKILLGAGE_F_SET,ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"),100

;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_偽り写し記す万象,ARG,ARG:1
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"偽り写し記す万象")

;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える
;IF CFLAG:ARG:현데미지 > 0 || GETBIT(CFLAG:ARG:受けフラグ,18) || GETBIT(CFLAG:ARG:受けフラグ,19)
IF GET_CREC_ACT(ARG:1, ARG, "HIT")
	LOCAL = CFLAG:ARG:현데미지
	CALL SKILLGAGE_H_ADD,ARG,SKILL_NUM,LOCAL
ELSE
ENDIF

SIF GET_STATE(CFLAG:ARG:상태이상) == "DYING"
	CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_偽り写し記す万象,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"偽り写し記す万象")
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)

;この宝具を使用したら蓄積ダメージを0に
CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,0

;スキルゲージが100以上だと100にする
SIF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")) > 100
	CALL SKILLGAGE_F_SET,ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"),100

;　説明文の表示
@SKILL_EXPLAIN_偽り写し記す万象,ARG
PRINTL 『허위로 모사하여 기록하는 만상(베르그 아베스타)』
PRINTFORML 자신이 입은 상처를 상대에게 되돌려주는, %CALLNAME:ARG%(이)가 사용하는 『원초의 저주』.
PRINTL 
PRINTL 적 전체에 만능 속성의 물리 소 데미지를 가한다.
PRINTL 현재 전투 중 자신이 입은 피데미지량에 비례해 위력이 상승한다.
PRINTL 
PRINTFORML %CALLNAME:ARG%(은)는 항상 마력 방출 가능 상태를 유지하여, 원하는 타이밍에 사용할 수 있다.
PRINTL 축적된 피데미지량은 이 보구를 사용하거나, 혹은 자신이 전투불능이 되면 리셋된다.
PRINTL

