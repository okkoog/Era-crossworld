;　威力
@SKILL_POWER_燃える宇宙, ARG
#DIM L_T
SIF ARG < 0
	RETURN 480
SIF !INRANGE(CFLAG:ARG:타겟, 1, 16)
	RETURN 480
L_T = POS(CFLAG:ARG:타겟)
SIF L_T < 0
	RETURN 480
SIF IS_BADSTATE(L_T,"CHARM")
	RETURN 520

RETURN 480

