	RETURN 400
SIF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"乱れ蝶"))
	RETURN 100
RETURN 400 + (GET_RPG_CFLAG_TAKEOVER(ARG, "星魂") > 4) * 40

;クリティカル率
@SKILL_CRITICAL_RATE_乱れ蝶, ARG
