;====================================================
;トリガー発動条件
;
;詳しい仕様については資料フォルダの解説を参照してください
;====================================================
@SKILL_TRIGGER_ACTIONABLE_乱れ蝶,ARG,ARG:1
SIF ARG != ARG:1
	RETURN 0
SIF FLAG:행동순1 != ARG
	RETURN 0
SIF CFLAG:ARG:입력행동 == -1
	RETURN 0
SIF !INPUTABLE_CHARA_F(ARG)
	RETURN 0
SIF CFLAG:ARG:방어플래그 == 1
	RETURN 0
SIF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"乱れ蝶")) < 60
	RETURN 0
;単体指定でない場合、あるいは単体指定でターゲットが指定不能になっていた場合はターゲットを振りなおす
SIF !INRANGE(CFLAG:ARG:타겟, 7, 16) || !IS_TARGET_ABLE(POS(CFLAG:ARG:타겟))
	CALL RANDOM_TARGET,ARG,PU_SKILLNUM_GET(ARG,"乱れ蝶")
RETURN 1, CFLAG:ARG:타겟

;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_乱れ蝶,ARG,ARG:1,ARG:2
SIF (GET_RPG_CFLAG_TAKEOVER(ARG, "星魂") < 6)
	RETURN 0
;チェイス相手の番号をHに保存
CALL SKILLGAGE_H_SET, ARG, PU_SKILLNUM_GET(ARG,"乱れ蝶"), ARG:1
;Dに効果ターン数を保存
;効果はこのターン(1ターン)のみ
CALL SKILLGAGE_D_SET, ARG, PU_SKILLNUM_GET(ARG,"乱れ蝶"), 1

;====================================================
;行動によるスキルゲージ操作
;====================================================
@SKILLGAGE_CHARGE_乱れ蝶,ARG,ARG:1
#LOCALSIZE 1
#DIM L_T
#DIM L_GP
L_GP = 0
RESULTS = ＥＰ
;自分の行動の場合
IF ARG == ARG:1
	;専用技の使用でゲージ上昇
	SIF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG,"強襲")
		L_GP += 20
	SIF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG,"還刃")
		L_GP += 30
	;４凸効果：殺害した敵の数に応じてスキルゲージアップ
	SIF GET_RPG_CFLAG_TAKEOVER(ARG, "星魂") > 3
		L_GP += GET_CREC_ACT_SUM(ARG, "적") * 15
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += 5
CALL SKILLGAGE_F_SET,ARG ,PU_SKILLNUM_GET(ARG,"乱れ蝶"), MIN(L_GP + SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"乱れ蝶")), 60)
IF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"乱れ蝶")) >= 60
	RESULTS = ＵＬＴＩＭＡＴＥ ＲＥＡＤＹ！
ELSE
	RESULTS = ＥＰ
ENDIF
RESULTS:1 = %" "%
RETURN L_GP

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_乱れ蝶,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
CFLAG:ARG:気合フラグ = MAX(1, CFLAG:ARG:気合フラグ)
CALL PRINT_HIT_MESSAGE, ARG, "物理攻撃の威力を増幅！", "w"
SIF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"乱れ蝶")) >= 60
	CALL SKILLGAGE_F_SET,ARG,PU_SKILLNUM_GET(ARG,"乱れ蝶"),-60

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@SKILLGAGE_DISPLAY_乱れ蝶,ARG
PRINTFORML {SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"乱れ蝶"))+60,3}/120

;　説明文の表示
@SKILL_EXPLAIN_乱れ蝶,ARG
PRINTL ＥＰゲージを得る。
PRINTL ＥＰゲージが最大のとき、自身が行動した際に以下の連動効果が発動する。
PRINTL 「敵１体に剣撃＋万能の複合相性で特大威力の攻撃を１回行い、次に行う物理攻撃の威力を１５０％増加させるチャージ効果を得る。」

;使用条件
@SKILL_SPECIAL_ACTIONABLE_乱れ蝶,ARG
RETURN 0