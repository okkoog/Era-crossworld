;木っ端微塵斬りをスキルチェンジで作ろうと思ったけど競合したら嫌だなぁって思って作りました

;スキル名
@SKILL_NAME_ジャッジメントブレード, ARG
IF FLAG:행동순1 == ARG
	RESULTS = 저지먼트 블레이드
ELSE
	RESULTS = ｼﾞｬｯｼﾞﾒﾝﾄﾌﾞﾚｰﾄﾞ
ENDIF

;　명중
@SKILL_HITRATE_ジャッジメントブレード, ARG
RETURN 100

;　威力
@SKILL_POWER_ジャッジメントブレード, ARG
;LV65以上で虚空斬波級の威力に
IF BASE:ARG:LV > 64
	RETURN 410
ELSE
	RETURN 335
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ジャッジメントブレード, ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ジャッジメントブレード, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ジャッジメントブレード, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ジャッジメントブレード, ARG
;LV65以上で虚空斬波級に
SIF BASE:ARG:LV > 64
	RETURN 35
RETURN 26

;　相性
@SKILL_TYPE_ジャッジメントブレード, ARG
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ジャッジメントブレード
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ジャッジメントブレード, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ジャッジメントブレード, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ジャッジメントブレード, ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ジャッジメントブレード, ARG
;イプシロンは列攻撃
SIF SKILL_CHANGE(ARG, [[キャラ:입실론_X2]]) || SKILL_CHANGE(ARG, [[キャラ:창조주_X2]])
	RETURN 2
RETURN 3

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ジャッジメントブレード, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_ジャッジメントブレード, ARG = -1
;イプシロンならデメリットなし
SIF SKILL_CHANGE(ARG, [[キャラ:입실론_X2]]) || SKILL_CHANGE(ARG, [[キャラ:창조주_X2]])
	RETURN 0
RETURN -10

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ジャッジメントブレード
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ジャッジメントブレード, ARG, ARG:1, SKILL_NUM
#DIM SKILL_NUM

CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_ジャッジメントブレード, ARG
IF SKILL_CHANGE(ARG, [[キャラ:입실론_X2]]) || SKILL_CHANGE(ARG, [[キャラ:창조주_X2]])
	PRINTL 중화기를 다루는 워커 브리가드의 능력을 복사한 재현 병장.
	PRINTL 대형 방패에서 에너지 블레이드를 형성하여 충격파를 날린다.
	PRINT 적 전열에 검격 상성으로
	IF BASE:ARG:LV > 64
		PRINT 特大
	ELSE
		PRINT 大
	ENDIF
	PRINTL 데미지를 준다. 후열 사용 가능.
ELSE
	PRINTL 헤비 바살트의 주 병장인 거대 에너지 블레이드를 휘두른다.
	PRINT 적 전체에 검격 상성으로
	IF BASE:ARG:LV > 64
		PRINT 特大
	ELSE
		PRINT 大
	ENDIF
	PRINTL 데미지를 준다. 발동이 느리다.
ENDIF

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ジャッジメントブレード, ARG
RETURN 1

