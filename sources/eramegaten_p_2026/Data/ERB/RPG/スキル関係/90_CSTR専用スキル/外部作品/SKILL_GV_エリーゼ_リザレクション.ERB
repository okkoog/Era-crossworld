;　説明文の表示
@SKILL_EXPLAIN_リザレクション, ARG
#DIM ELISE_COUNT
PRINTFORML 영혼을 조종하여 죽은 생명마저 부활시키는 %CALLNAME:ARG%의 SP스킬.
PRINTL 　
PRINTL 아군 전체의 DYING을 회복한다.
PRINTL 소생 후의 HP 회복량은 파티 내의 엘리제 수에 따라 변화한다.
PRINTL 

CALL ELISE_COUNT_CHECK, ARG
ELISE_COUNT = RESULT
IF ELISE_COUNT <= 1
	PRINTL 1명 이하：HP 최대치의 10% 회복 (현재 적용 중)
ELSE
	PRINTL 1명 이하：HP 최대치의 10% 회복
ENDIF
IF ELISE_COUNT == 2
	PRINTL 2명　　：HP 최대치의 25% 회복 (현재 적용 중)
ELSE
	PRINTL 2명　　：HP 최대치의 25% 회복
ENDIF
IF ELISE_COUNT == 3
	PRINTL 3명　　：HP 최대치의 50% 회복 (현재 적용 중)
ELSE
	PRINTL 3명　　：HP 최대치의 50% 회복
ENDIF

;使用条件
@SKILL_SPECIAL_ACTIONABLE_リザレクション, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "リザレクション")
SIF SKILLGAGE_D_GET(ARG, SKILL_NUM)
	RETURN 0
RETURN 1

@SKILL_CURE_STATE_リザレクション, ARG
SELECTCASE GET_STATE(ARG)
	CASE "DYING"
		RETURN 1
	CASEELSE
		RETURN 0
ENDSELECT

@ELISE_COUNT_CHECK, ARG
;PT内にエリーゼがどんだけいるかを数える関数（生死は問わない）
#LOCALSIZE 3
#LOCALSSIZE 1
#DIM ELISE_COUNT
;メモ　PT플래그…0:敵/1:味方かつPT外/2:味方かつPT内
IF CFLAG:(ARG):PT플래그 == 0
	LOCAL:1 = 7
	LOCAL:2 = 17
ELSE
	LOCAL:1 = 1
	LOCAL:2 = 7
ENDIF

ELISE_COUNT = 0

IF SKILL_CHANGE(ARG, [[キャラ:엘리제1_GV]]) || SKILL_CHANGE(ARG, [[キャラ:엘리제2_GV]]) || SKILL_CHANGE(ARG, [[キャラ:엘리제3_GV]])
	SIF CFLAG:ARG:PT플래그 == 2 || CFLAG:ARG:PT플래그 == 0
		ELISE_COUNT += 1
ENDIF
FOR LOCAL, LOCAL:1, LOCAL:2
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0
		CONTINUE
	
	IF SKILL_CHANGE(ARG, [[キャラ:엘리제1_GV]])
		SIF NO:(FLAG:LOCALS) == [[キャラ:엘리제2_GV]] || NO:(FLAG:LOCALS) == [[キャラ:엘리제3_GV]]
			ELISE_COUNT += 1
	ELSEIF SKILL_CHANGE(ARG, [[キャラ:엘리제2_GV]])
		SIF NO:(FLAG:LOCALS) == [[キャラ:엘리제1_GV]] || NO:(FLAG:LOCALS) == [[キャラ:엘리제3_GV]]
			ELISE_COUNT += 1
	ELSEIF SKILL_CHANGE(ARG, [[キャラ:엘리제3_GV]])
		SIF NO:(FLAG:LOCALS) == [[キャラ:엘리제1_GV]] || NO:(FLAG:LOCALS) == [[キャラ:엘리제2_GV]]
			ELISE_COUNT += 1
	ENDIF
NEXT

RETURN ELISE_COUNT

