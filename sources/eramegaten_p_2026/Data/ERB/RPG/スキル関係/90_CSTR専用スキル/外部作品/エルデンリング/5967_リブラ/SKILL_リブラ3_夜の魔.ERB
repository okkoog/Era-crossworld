;속도보정
@SKILL_SPEED_夜の魔, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_夜の魔, ARG = -1
RETURN 0

@SKILL_PASSIVE_BTL_EFFECT_夜の魔, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM DYNAMIC L_P;スキルの持ち主=自分
#DIM DYNAMIC L_ACTOR;攻撃者(どちらかは自分になる)
#DIM DYNAMIC L_TARGET;攻撃対象(どちらかは自分になる)
#DIM DYNAMIC SKILL_NUM;スキル番号(専用技用)
#DIMS DYNAMIC L_相性名;ダメージ計算に使用されている相性の名称
#DIM DYNAMIC L_相性値;相性の倍率(999が反射のあれ)
#DIMS DYNAMIC L_ダメージタイプ;物理/魔法
#DIMS DYNAMIC L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS DYNAMIC L_ステート名;バステの名称
#DIM DYNAMIC L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM DYNAMIC GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_RESULT

;自分がPANIC
IF L_P == L_ACTOR
	IF IS_BADSTATE(L_P, "PANIC")
		SELECTCASE ARGS
			CASE "ダメージ補正加算"
				SIF L_攻撃タイプ == "物理"
					RETURN 30
				SIF L_攻撃タイプ == "魔法"
					RETURN -30
		ENDSELECT
	ELSE
		SELECTCASE ARGS
			CASE "ダメージ補正加算"
				SIF L_攻撃タイプ == "魔法"
					RETURN 15
		ENDSELECT
	ENDIF
ELSE
	IF IS_BADSTATE(L_P, "PANIC")
		SELECTCASE ARGS
			CASE "バステ無効化"
				SIF L_ステート名 != "PANIC"
					RETURN 1
		ENDSELECT
	ENDIF
ENDIF
RETURN 0

