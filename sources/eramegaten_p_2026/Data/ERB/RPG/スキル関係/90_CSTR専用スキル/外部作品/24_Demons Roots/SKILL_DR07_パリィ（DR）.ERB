@ACTION_パリィ（DR）,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

IF FLAG:카운터중 == 1
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
ELSE
	CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"パリィ（DR）"),1
	PRINTFORML %CALLNAME:ARG%(은)는 무기를 쥐고 공격에 대비해 자세를 취했다!
ENDIF

