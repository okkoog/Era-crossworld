;====================================================
;カウンター発動条件
;====================================================
@SKILL_COUNTER_ACTIONABLE_パリィ（DR）,ARG,ARG:1
;自分に攻撃が来ていること
SIF !GET_CREC_ACT(ARG:1, ARG, "ATTACK")
	RETURN 0
;受けた結果が反射ではない
SIF GET_CREC_ACT(ARG:1, ARG, "REFLECT")
	RETURN 0
;仲間には反撃しない
SIF IS_FRIEND(ARG:1, ARG)
	RETURN 0
;攻撃者が死んでたりみつからなかったらなし
SIF ARG:1 < 0 || GET_STATE(CFLAG:(ARG:1):상태이상) == "DYING"
	RETURN 0
;パリィ身構え中のターンでなければならない。
SIF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"パリィ（DR）")) == 0
	RETURN 0
;パリィ対象で攻撃を仕掛けられた。
SIF GET_CREC_ACT(ARG:1, ARG, "ATTACK", "物理")
	RETURN 1, CPOS(ARG:1)

;発動したターンであり、自分に攻撃が来た、死んでいない、物理攻撃の場合のみカウンター。

;剣・飛・打・戦の相性攻撃を受けたかチェックする手法。別案をもらったのでメモ代わりに
