;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_ER_狩人の勘, ARG
IF GET_RPG_CSTR_BTL(ARG, "エデンズリッター変身状態") == "起動"
	RESULTS = 魔血覚醒
