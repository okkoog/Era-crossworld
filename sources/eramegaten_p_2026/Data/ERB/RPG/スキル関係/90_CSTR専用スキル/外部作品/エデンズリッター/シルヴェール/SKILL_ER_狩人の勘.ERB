	RESULTS = 사냥꾼의 감
ENDIF

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ER_狩人の勘
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ER_狩人の勘, ARG
RETURN GET_SKILL_EFFECT_NUM("자동효과")

;====================================================
;ダメージ計算時の追加補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_ER_狩人の勘, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;ステート名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
;自分が攻撃側
IF L_P == L_ACTOR
	IF GET_RPG_CSTR_BTL(L_P, "エデンズリッター変身状態") == "起動"
		; 変身中攻撃時にクリティカル率に補正
		SELECTCASE ARGS
			CASE "クリティカル補正A"
				; 満月なら確定
				IF FLAG:월령 == 8
					RETURN 999
				ELSE
					RETURN 10
				ENDIF
		ENDSELECT
	ENDIF
ELSE
	IF GET_RPG_CSTR_BTL(L_P, "エデンズリッター変身状態") != "起動"
		; ノーマルモード中被ダメ時にクリティカル率に補正
		SELECTCASE ARGS
			CASE "クリティカル補正A"
				RETURN -20
		ENDSELECT
	ENDIF
ENDIF
RETURN 0

