;熱核の乱舞をスキルチェンジで作ろうと思ったけど競合したら嫌だなぁって思って作りました

;スキル名
@SKILL_NAME_エイミングレイ, ARG
RESULTS = 에이밍 레이

;　명중
@SKILL_HITRATE_エイミングレイ, ARG
RETURN 150

;　威力
@SKILL_POWER_エイミングレイ, ARG
RETURN 160

;　최저공격횟수
@SKILL_MINATTACKNUMBER_エイミングレイ, ARG
RETURN 4

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_エイミングレイ, ARG
RETURN 4

;一体辺りの最大ＨＩＴ数
@SKILL_MAXATK_PER_エイミングレイ, ARG
RETURN 3

;一体辺りの最低ＨＩＴ数
@SKILL_MINATK_PER_エイミングレイ, ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_エイミングレイ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_エイミングレイ, ARG
RETURN 15

;　相性
@SKILL_TYPE_エイミングレイ, ARG
RETURN GET_TYPE_NUM("비구"), GET_TYPE_NUM("핵열")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_エイミングレイ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_エイミングレイ, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_エイミングレイ, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_エイミングレイ, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_エイミングレイ, ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_エイミングレイ, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_エイミングレイ, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_エイミングレイ
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_エイミングレイ, ARG, ARG:1, SKILL_NUM
#DIM SKILL_NUM

CALL ATTACK_RAND, ARG, ARG:1, SKILL_NUM

;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_エイミングレイ, ARG
IF SKILL_CHANGE(ARG, [[キャラ:입실론_X2]]) || SKILL_CHANGE(ARG, [[キャラ:창조주_X2]])
	PRINTL 광학 병기를 다루는 워커 오토크롬의 능력을 복사한 재현 병장.
	PRINT 대형 방패에서
ELSE
	PRINT 날개 부분에서
ENDIF
PRINTL 고속 이동하는 록온 마커를 전개하여 정확하게 적을 저격한다.
PRINTL 적 복수 체에 핵열과 비구의 복합 상성으로 4회 소데미지를 준다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_エイミングレイ, ARG
RETURN 1
