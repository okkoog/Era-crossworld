;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_ガンマ・レイ, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "ATK"
		RETURN LIMIT(CFLAG:ARG:공격강화 + CFLAG:ARG:마법위력강화, -48, 64), 32
ENDSELECT

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_ガンマ・レイ,ARG,ARG:1
#DIM ガンマ履歴
ガンマ履歴 = PU_SKILLNUM_GET(ARG,"ガンマ・レイ")
;効果時間中
SIF SKILLGAGE_D_GET(ARG,ガンマ履歴) < 1
	RETURN 0
;攻撃者が自分である
SIF FLAG:행동순1 != ARG
	RETURN 0
;味方には発動しない
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
;攻撃を実行している
SIF !GET_CREC_ACT(ARG, ARG:1, "ATTACK")
	RETURN 0
;判定は1回
SIF TFLAG:스킬트리거용1++
	RETURN 0
;ターゲットが死んでいない状態で、単体には単体、範囲には範囲で追撃。
IF CFLAG:ARG:타겟 < 17
	CALL SKILLGAGE_H_SET,ARG,ガンマ履歴,2
	RETURN 1, CFLAG:ARG:타겟
ELSEIF CFLAG:ARG:타겟 < 20
	CALL SKILLGAGE_H_SET,ARG,ガンマ履歴,3
	RETURN 1, 19
ELSE
	CALL SKILLGAGE_H_SET,ARG,ガンマ履歴,3
	RETURN 1, 22
ENDIF

;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_ガンマ・レイ,ARG,ARG:1
#DIM ガンマ履歴
ガンマ履歴 = PU_SKILLNUM_GET(ARG,"ガンマ・レイ")
;スキル効果時間中
SIF SKILLGAGE_D_GET(ARG,ガンマ履歴) < 1
	RETURN 0
SIF !GET_CREC_ACT(ARG:1, ARG, "HIT")
	RETURN 0
;確率６６％
SIF RAND:3 == 0
	RETURN 0
CALL SKILLGAGE_H_SET,ARG,ガンマ履歴,1
RETURN 1, CPOS(ARG:1)


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ガンマ・レイ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#LOCALSIZE 4
#DIM ガンマ履歴
ガンマ履歴 = PU_SKILLNUM_GET(ARG,"ガンマ・レイ")
;トリガー追撃中は攻撃するだけ
IF FLAG:카운터중 || FLAG:총공격중
	;単体攻撃
	IF ARG:1 < 17
		CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
	ENDIF
	;攻撃内容リセット
	CALL SKILLGAGE_H_SET,ARG,ガンマ履歴,0
ELSE
	;
	IF SKILLGAGE_F_GET(ARG,ガンマ履歴) == 0
		CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
		CALL SKILLGAGE_F_SET,ARG,ガンマ履歴,1
		PRINTL 
		PRINTL 감마 레이의 가호가 다해, 레이 펜타그마가 되었다.
	ELSE
	;ガンマレイ使用後の場合レイペンタグマセット
		CALL SKILLGAGE_D_SET,ARG,ガンマ履歴,6
		PRINTL 레이 펜타그마, 세트!
	ENDIF
ENDIF

