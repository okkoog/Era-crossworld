;追撃中は名前チェンジ
	IF ARG > -1
		SIF SKILLGAGE_H_GET(ARG,ガンマ履歴) == 1
			RESULTS = 레이 펜타그마 반격
		SIF SKILLGAGE_H_GET(ARG,ガンマ履歴) == 2
			RESULTS = 레이 펜타그마 추격
		SIF SKILLGAGE_H_GET(ARG,ガンマ履歴) == 3
			RESULTS = 레이 펜타그마 추격
	ENDIF
;１戦闘中、ガンマレイ一度使用後は追撃のペンタグマへ
IF SKILLGAGE_F_GET(ARG,ガンマ履歴) >= 1
	RESULTS = 레이 펜타그마
ELSE
	RESULTS = 감마 레이
ENDIF

