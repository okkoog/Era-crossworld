;;ブレスなどの拡散攻撃に使う
;@SKILL_SPREAD_カードスキルB,ARG
;RETURN 0

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_カードスキルB,ARG,ARG:1
;味方の行動に反応する
SIF !IS_FRIEND(ARG, FLAG:행동순1)
	RETURN 0
SIF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"カードスキルB")) <= 0
	RETURN 0
;一回の行動につき一回しか判定を通さない
SIF TFLAG:스킬트리거용1++
	RETURN 0
IF SKILLGAGE_H_GET(ARG,PU_SKILLNUM_GET(ARG,"カードスキルA")) == 1
	IF CFLAG:(ARG):PT플래그 == 0
		RETURN 1, 17
	ELSE
		RETURN 1, 20
	ENDIF
	;RESULT:1 = 20
	;SIF CFLAG:(ARG):PT플래그 == 0
	;	RESULT:1 = 17
ELSEIF SKILLGAGE_H_GET(ARG,PU_SKILLNUM_GET(ARG,"カードスキルA")) == 2
	IF CFLAG:(ARG):PT플래그 == 0
		RETURN 1, 21
	ELSE
		RETURN 1, 18
	ENDIF
	;RESULT:1 = 21
	;SIF CFLAG:(ARG):PT플래그 == 0
	;	RESULT:1 = 18
ENDIF

;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_カードスキルB,ARG,ARG:1
SIF SKILLGAGE_H_GET(ARG,PU_SKILLNUM_GET(ARG,"カードスキルB")) == 0
	RETURN 0
SIF ARG:1 < 0 || GET_STATE(CFLAG:(ARG:1):상태이상) == "DYING"
	RETURN 0
;イベント用　国境門
IF CFLAG:ARG:998 == 2 && GETCHARA([[キャラ:국경문]]) > -1
	;国境門が攻撃を受けている
	SIF !GET_CREC_ACT(ARG:1, GETCHARA([[キャラ:국경문]]), "HIT")
		RETURN 0
	;前衛であるなら通し
	SIF IS_FRONT(ARG:1)
		RETURN 1, CPOS(ARG:1)
	;SIF !GETBIT(CFLAG:GETCHARA([[キャラ:국경문]]):受けフラグ,18) && !GETBIT(CFLAG:GETCHARA([[キャラ:국경문]]):受けフラグ,19)
	;	RETURN 0
	;SIF !CFLAG:GETCHARA([[キャラ:국경문]]):현데미지
	;	RETURN 0
	;SIF INRANGE(CPOS(ARG:1), 1, 3) || INRANGE(CPOS(ARG:1), 7, 11)
	;	RETURN 1
ELSE
	;自分が攻撃を受けている
	SIF !GET_CREC_ACT(ARG:1, ARG, "HIT")
		RETURN 0
	;味方同士では発動しない
	SIF IS_FRIEND(ARG, ARG:1)
		RETURN 0
	;前衛であるなら通し
	SIF IS_FRONT(ARG:1)
		RETURN 1, CPOS(ARG:1)
	;SIF !GETBIT(CFLAG:ARG:受けフラグ,18) && !GETBIT(CFLAG:ARG:受けフラグ,19)
	;	RETURN 0
	;SIF !CFLAG:ARG:현데미지
	;	RETURN 0
	;SIF INRANGE(CPOS(ARG:1), 1, 3) || INRANGE(CPOS(ARG:1), 7, 11)
	;	RETURN 1
ENDIF
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_カードスキルB,ARG,ARG:1,ARG:2
#DIM TEMP
IF INRANGE(ARG:1, 1, 16)
	LOCAL = POS(ARG:1)
ELSE
	LOCAL = 0
ENDIF
LOCAL:1 = 0
LOCAL:2 = 0
LOCAL:3 = 0

;タレット掃射
IF PU_SKILLGAGE_D_GET(ARG,"カードスキルB") > 0 && ( (CFLAG:ARG:PT플래그 > 0 && GROUPMATCH(ARG:1, 20, 21)) || (CFLAG:ARG:PT플래그 == 0 && GROUPMATCH(ARG:1, 17, 18)) )
	TEMP = PU_SKILLGAGE_F_GET(ARG,"カードスキルB")
	CALL PU_SKILLGAGE_F_SET,ARG,"カードスキルB",-1
	TFLAG:반사후0데미지화 = 1
	CALL ATTACK_FIELD,ARG,ARG:1,ARG:2
	CALL PU_SKILLGAGE_F_SET,ARG,"カードスキルB",TEMP
;地雷爆発
ELSEIF PU_SKILLGAGE_H_GET(ARG,"カードスキルB") > 0 && INRANGE(ARG:1, 1, 16) && CFLAG:ARG:PT플래그 != CFLAG:(ARG:1):PT플래그
	TEMP = PU_SKILLGAGE_F_GET(ARG,"カードスキルB")
	CALL PU_SKILLGAGE_F_SET,ARG,"カードスキルB",-2
	
	TFLAG:필중 = 1
	TFLAG:반사0데미지화 = 1
	CALL ATTACK_SINGLE, ARG, LOCAL, ARG:2
	TFLAG:필중 = 0
	TFLAG:반사0데미지화 = 0
	PRINTL 
	
	CALL PU_SKILLGAGE_H_ADD,ARG,"カードスキルB",-1
	CALL PU_SKILLGAGE_F_SET,ARG,"カードスキルB",TEMP
;地面突き刺し
ELSEIF PU_SKILLGAGE_H_GET(ARG,"カードスキルB") < 0 && INRANGE(ARG:1, 1, 16) && CFLAG:ARG:PT플래그 != CFLAG:(ARG:1):PT플래그
	TEMP = PU_SKILLGAGE_F_GET(ARG,"カードスキルB")
	CALL PU_SKILLGAGE_F_SET, ARG, "カードスキルB", -3
	
	TFLAG:필중 = 1
	TFLAG:반사0데미지화 = 1
	CALL ATTACK_SINGLE, ARG, LOCAL, ARG:2
	TFLAG:필중 = 0
	TFLAG:반사0데미지화 = 0
	PRINTL 
	
	;CALL PU_SKILLGAGE_H_ADD,ARG,"カードスキルB",1
	CALL PU_SKILLGAGE_F_SET,ARG,"カードスキルB",TEMP
ELSE
	SELECTCASE PU_SKILLGAGE_F_GET(ARG,"カードスキルB")
		CASE 1
			;バリケード
			CALL SKILL_WALL , ARG , "검격" , CFLAG:ARG:타겟 , 1, "非表示"
			CALL SKILL_WALL , ARG , "비구" , CFLAG:ARG:타겟 , 1, "非表示"
			CALL SKILL_WALL , ARG , "타격" , CFLAG:ARG:타겟 , 1, "非表示"
			CALL SKILL_WALL , ARG , "전술" , CFLAG:ARG:타겟 , 1, "非表示"
			
			LOCAL:1 = AUTO_SPLIT_INT("1_4_1_7_12_7" , "_" , CFLAG:ARG:타겟 - 17)
