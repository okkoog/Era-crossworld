;スキル名
@SKILL_NAME_カードスキルB,ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"カードスキルB")
;専用技が封印されている
IF CFLAG:ARG:998 == 0
	RESULTS = ？？？？？
ELSEIF TFLAG:전투중 == 0 && SKILLGAGE_F_GET(ARG,SKILL_NUM) == 0
	RESULTS = 설치 스킬
ELSEIF FLAG:총공격중
	RESULTS = 掃射
	IF SKILLGAGE_H_GET(ARG,PU_SKILLNUM_GET(ARG,"カードスキルA")) == 1
		TSTR:스킬메시지행동자 = 対地タレット/XX
	ELSE
		TSTR:스킬메시지행동자 = 対空タレット/XX
	ENDIF
ELSEIF FLAG:카운터중
	IF SKILLGAGE_H_GET(ARG,SKILL_NUM) > 0
		RESULTS = 爆発
		TSTR:스킬메시지행동자 = 地雷/XX
	ELSE
		RESULTS = 찌르기
		TSTR:스킬메시지행동자 = 스파이크/XX
	ENDIF
ELSE
	SELECTCASE SKILLGAGE_F_GET(ARG,SKILL_NUM)
		CASE 1
			RESULTS = 바리케이드
		CASE 2
			RESULTS = 바리케이드 LV2
		CASE 3
			RESULTS = 바리케이드 LV3
		CASE 4
			RESULTS = 地雷
		CASE 5
			RESULTS = 空爆
		CASE 6
			RESULTS = 대지 터렛
		CASE 7
			RESULTS = 대공 터렛
		CASE 8
			RESULTS = 스파이크
		CASEELSE
			IF SKILLGAGE_D_GET(ARG,SKILL_NUM) > 0 || SKILLGAGE_H_GET(ARG,SKILL_NUM) != 0
				RESULTS = 防衛設備作動中
			ELSE
				RESULTS = ＥＭＰＴＹ
			ENDIF
	ENDSELECT
ENDIF

