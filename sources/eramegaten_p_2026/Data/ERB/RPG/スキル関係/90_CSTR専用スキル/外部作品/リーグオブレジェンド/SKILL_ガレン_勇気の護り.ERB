;-----------------------------
;勇気の護り
;-----------------------------
;スキル名
@SKILL_NAME_勇気の護り,ARG
RESULTS = 용기의 가호

;　명중
@SKILL_HITRATE_勇気の護り, ARG
RETURN 100

;　威力
@SKILL_POWER_勇気の護り, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_勇気の護り,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_勇気の護り,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_勇気の護り, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_勇気の護り,ARG
SIF ARG < 0
	RETURN 20
SIF HAVE_PU_SKILL(ARG, "デマーシアの勇士LV15")
	RETURN 50
SIF HAVE_PU_SKILL(ARG, "デマーシアの勇士LV10")
	RETURN 40
SIF HAVE_PU_SKILL(ARG, "デマーシアの勇士LV5")
	RETURN 30
RETURN 20

;검격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_勇気の護り
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_勇気の護り,ARG
RETURN GET_SKILL_TARGET_NUM("자신")

;　사거리
@SKILL_RANGE_勇気の護り,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_勇気の護り,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_勇気の護り, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;계승타입
@SKILL_SUCCESSION_TYPE_勇気の護り
RETURN GET_SUCCESSION_NUM("검격")
;검격

;スキル変化？用ランク
@SKILL_RANK_勇気の護り, ARG = -1
RETURN 6

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_勇気の護り,ARG,ARG:1,ARG:2
CALL SKILLGAGE_D_SET, ARG, ARG:2, 4
CALL SYNC_STATUS_STATE, ARG
CALL PRINT_HIT_MESSAGE, ARG, "勇気の護りを身に纏った！", "w"

;====================================================
;実行内容ここまで
;====================================================


;　 説明文の表示
@SKILL_EXPLAIN_勇気の護り,ARG
PRINTL 사용한 턴 동안 마법 공격과 FLY, ORGY, HEAT 이외의 상태이상에 대해 강력한 내성을 얻는다.
PRINTL 
PRINTL 이 스킬은 턴을 소비하지 않고 즉시 발동한다.
PRINTL 이 스킬은 사용 후 3턴 동안 사용할 수 없다.


;使用条件
@SKILL_SPECIAL_ACTIONABLE_勇気の護り,ARG
RESULTS = 効果発動中
SIF PU_SKILLGAGE_D_GET(ARG, "勇気の護り") == 4
	RETURN 0
RESULTS = CT:{PU_SKILLGAGE_D_GET(ARG, "勇気の護り")}
SIF PU_SKILLGAGE_D_GET(ARG, "勇気の護り")
	RETURN 0
RETURN 1
;とくにない

;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_勇気の護り, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	;ステート耐性は0のときに通常(100%)のに注意。
	CASE "상태이상"
		IF PU_SKILLGAGE_D_GET(ARG, "勇気の護り") == 4
			SIF GROUPMATCH(ARGS:1, "FLY", "ORGY", "HEAT")
				RETURN 0
			RETURN -100
		ENDIF
ENDSELECT
RETURN 0

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_勇気の護り, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
;自分が防御側
ELSE
	SELECTCASE ARGS
		;他のものと加算されずに全体に乗算で処理される。(-20ならダメージ0.8倍、+20なら1.2倍)
		CASE "ダメージ倍率"
			SIF PU_SKILLGAGE_D_GET(L_P, "勇気の護り") == 4 && L_ダメージタイプ == "魔法"
				RETURN -80
	ENDSELECT
ENDIF
RETURN 0
;====================================================
;スキル及び行動の実行
;====================================================
;即時発動
@SKILL_QUICK_ACTION_勇気の護り, ARG
RETURN 1
