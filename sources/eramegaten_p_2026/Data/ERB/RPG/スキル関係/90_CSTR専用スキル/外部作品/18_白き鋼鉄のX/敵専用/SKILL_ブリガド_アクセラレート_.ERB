@SKILL_EFECT_アクセラレート, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")


;계승타입
@SKILL_SUCCESSION_TYPE_アクセラレート
RETURN GET_SUCCESSION_NUM("지원")

