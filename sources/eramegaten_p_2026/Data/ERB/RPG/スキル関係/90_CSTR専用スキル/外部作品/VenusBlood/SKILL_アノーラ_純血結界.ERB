CALL HEAL_SKILL, ARG, ARG:1, ARG:2
CALL SKILL_SET_全体HPバリア, ARG, 150 * GET_BASEHEAL_IN_CALC(MAXBASE:ARG:마법효과, MAXBASE:ARG:마법효과) / 100, "結界"

