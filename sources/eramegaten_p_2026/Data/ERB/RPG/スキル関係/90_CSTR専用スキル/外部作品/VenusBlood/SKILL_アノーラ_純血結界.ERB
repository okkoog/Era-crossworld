;　コストの量
@SKILL_COST_純血結界,ARG
RETURN 15

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_純血結界
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_純血結界,ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_純血結界,ARG
RETURN 3

