@SKILL_COUNTER_ACTIONABLE_毒の体,ARG,ARG:1
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
SIF !GET_CREC_ACT(ARG:1, ARG, "HIT")
	RETURN 0
SIF !GET_CREC_ACT(ARG:1, ARG, "物理")
	RETURN 0
RETURN 1, CPOS(ARG:1)

