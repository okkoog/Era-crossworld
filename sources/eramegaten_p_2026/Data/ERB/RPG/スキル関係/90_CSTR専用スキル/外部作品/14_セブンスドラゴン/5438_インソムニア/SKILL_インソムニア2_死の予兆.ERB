;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_死の予兆, ARG, ARG:1, ARG:2
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_RESULT
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	TSTR:스킬메시지추가효과 '= ""
	CALL SKILL_GUARD_KILL, ARG, "주살", LCOUNT, 2, "短縮"
	TSTR:스킬메시지추가효과 '= SUBSTRING(TSTR:스킬메시지추가효과, 3)
	L_RESULT = RESULT
	CALL SKILL_SET_カジャンダ, ARG, POS(LCOUNT), "BS부착률", 8, "短縮"
	SIF L_RESULT == 0
		TSTR:스킬메시지추가효과 '= SUBSTRING(TSTR:스킬메시지추가효과, 3)	
	CALL PRINT_HIT_MESSAGE, POS(LCOUNT), TSTR:스킬메시지추가효과, "L"
NEXT
WAIT
