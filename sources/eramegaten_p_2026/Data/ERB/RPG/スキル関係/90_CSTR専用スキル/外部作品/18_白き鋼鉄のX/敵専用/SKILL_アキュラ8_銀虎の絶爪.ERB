;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_銀虎の絶爪, ARG, ARG:1, ARG:2
#DIM DYNAMIC LCOUNT
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	SIF CFLAG:POS(LCOUNT):물리반사플래그
		CALL PRINT_HIT_MESSAGE, POS(LCOUNT), "物理反射結界解除"
	SIF CFLAG:POS(LCOUNT):마법반사플래그
		CALL PRINT_HIT_MESSAGE, POS(LCOUNT), "魔法反射結界解除"
	CFLAG:POS(LCOUNT):물리반사플래그 = 0
	CFLAG:POS(LCOUNT):마법반사플래그 = 0
NEXT
WAIT

