;　명중
@SKILL_HITRATE_メギドバースト, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "メギドバースト")
IF SKILLGAGE_D_GET(ARG, SKILL_NUM) > 0
	RETURN 95
ELSE
	RETURN 100
ENDIF

;　威力
@SKILL_POWER_メギドバースト, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "メギドバースト")
IF SKILLGAGE_D_GET(ARG, SKILL_NUM) > 0
	IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "다크니스트리거Ｘ") && FLAG:총공격중
		;約1.25倍
		RETURN 400
	ELSE
		RETURN 320
	ENDIF
ELSE
	RETURN 200
ENDIF

