@SKILL_ACTIONABLE_BATTLE_無重力勝利, ARG
RETURN 0

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PASSIVE_PENETRATION_RANK_無重力勝利, L_P, L_T, L_スキル, L_ダメージタイプ, L_攻撃タイプ, L_相性, GIVE_EFFECT_CHARA
#DIM DYNAMIC L_P;このスキルの所持者
#DIM DYNAMIC L_T;攻撃対象
#DIMS DYNAMIC L_スキル;スキルの所持者が敵に対して使用しているスキルの関数名称
#DIM DYNAMIC L_ダメージタイプ
#DIM DYNAMIC L_攻撃タイプ
#DIM DYNAMIC L_相性
#DIM DYNAMIC GIVE_EFFECT_CHARA;リーダースキル等他人からつけられている場合の提供者
RETURN 4

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_無重力勝利, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM TOTAL_DMG_B
;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			RETURN -90
	ENDSELECT
ENDIF
;====================================================
;トリガー発動条件
;====================================================
@SKILL_TRIGGER_ACTIONABLE_無重力勝利,ARG,ARG:1
;自分の行動のみ
SIF ARG != FLAG:행동순1
	RETURN 0
;攻撃対象が敵でないとダメ
SIF IS_FRIEND(ARG, ARG:1)
	RETURN 0
;攻撃が成功している
SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "HIT")
	RETURN 0
RETURN 1, CPOS(ARG:1)

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_無重力勝利,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
IF RAND:5==0
	CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "공격", -4, "단체"
ELSEIF RAND:4 == 0
	CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "마법효과", -4, "단체"
ELSEIF RAND:3 == 0
	CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "마법위력", -4, "단체"
ELSEIF RAND:2 == 0
	CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "방어", -4, "단체"
ELSE
	CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "명중/회피", -4, "단체"
ENDIF

@SKILL_DEL_UNABLE_無重力勝利, ARG
RETURN 1
