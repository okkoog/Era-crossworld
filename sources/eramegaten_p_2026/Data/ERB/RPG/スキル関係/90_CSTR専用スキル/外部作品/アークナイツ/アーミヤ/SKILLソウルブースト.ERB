;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_ソウルブースト,ARG,ARG:1
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"ソウルブースト")
SIF ARG != FLAG:행동순1
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
SIF GET_STATE(CFLAG:ARG:상태이상) == "CLOSE"
	RETURN 0
SIF SKILLGAGE_F_GET(ARG,SKILL_NUM) > -1
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
SIF RESULT != 1 || CFLAG:ARG:타겟 < 1
	RETURN 0
TRYCALL GET_SKILL_PROP, "SKILL_DAMAGETYPE", CFLAG:ARG:입력행동,ARG
SIF RESULT != 2
	RETURN 0
TRYCCALL GET_SKILL_PROP, "SKILL_ATTACKTYPE", CFLAG:ARG:입력행동, ARG
	SIF RESULT == GET_攻撃タイプ_NUM("割合")
		RETURN 0
	CATCH
ENDCATCH
;追撃の威力・相性の参照用にコマンドを保存しておく
CALL SKILLGAGE_H_SET(ARG,SKILL_NUM, CFLAG:ARG:입력행동)
RETURN 1

;ターン終了時に行う処理
@SKILL_TURNEND_ソウルブースト,ARG
#DIM SKILL_NUM
#DIM L_GAGE
#DIM L_MAX_F
SIF ARG < 0 || CSTR:ARG:103 == ""
	RETURN 0
SKILL_NUM = PU_SKILLNUM_GET(ARG,"ソウルブースト")
;PRINTFORMW H1 {SKILLGAGE_H_GET(ARG,SKILL_NUM)}
L_GAGE = SKILLGAGE_F_GET(ARG,SKILL_NUM)
IF GET_STATE(CFLAG:ARG:상태이상) == "DYING"
	;死んだ場合はゲージを初期値にリセットする
	SIF L_GAGE != 0
		CALL SKILLGAGE_F_SET,ARG,SKILL_NUM,0
	RETURN 0
ENDIF
;PRINTFORMW H2 {SKILLGAGE_H_GET(ARG,SKILL_NUM)}
;Fゲージが0or正の値（起動していない状態）か、負の値（効果発動中）で処理を変更
L_GAGE = L_GAGE > -1 ? MIN(L_GAGE + 5,100) # MIN(L_GAGE + 5 ,0)
IF L_GAGE == 0 && SKILLGAGE_F_GET(ARG,SKILL_NUM) < 0
	;効果時間が終了した際の処理
	PRINTFORMW %CALLNAME:ARG%(은)는 능력의 반동으로 자세가 무너져 버렸다!
	;SETBIT CFLAG:ARG:受けフラグ,23
	;SETBIT CFLAG:ARG:受けフラグ,23 + GET_STATE_NUM("SLIP")
	;CALL RECEIVE_SET, ARG, GET_TYPE_NUM("만능")
	;引数の1は口上を飛ばす
	CALL SET_BAD_STATE, ARG, ARG, GET_STATE_NUM("SLIP"), 1
	CALL SET_C_RECORDS, ARG, ARG, "BAD_STATE", "SLIP"
	PRINTFORM 　　TARGET:[{CPOS(ARG),2}] %CALLNAME:(ARG),20,LEFT%　>>>>>>　
	;CFLAG:ARG:상태이상 = GET_STATE_NUM("SLIP")
	CFLAG:ARG:상태이상경과턴수 = -2
	CFLAG:ARG:입력행동 = -1
	PRINTFORM SLIP
	PRINTL
ELSEIF L_GAGE == 100 && SKILLGAGE_F_GET(ARG,SKILL_NUM) > -1
	;上限まで溜まったタイミングで効果発動、L_GAGEを負の値にセット
	L_GAGE = -25
	CALL PRINT_ACT_MESSAGE, ARG, SKILL_NUM
	PRINTFORMW %CALLNAME:ARG%의 배후에 불길한 마름모꼴 표식이 떠올랐다……!
ENDIF
CALL SKILLGAGE_F_SET(ARG,SKILL_NUM,L_GAGE)
;PRINTFORMW H3 {SKILLGAGE_H_GET(ARG,SKILL_NUM)}
RETURN 0

