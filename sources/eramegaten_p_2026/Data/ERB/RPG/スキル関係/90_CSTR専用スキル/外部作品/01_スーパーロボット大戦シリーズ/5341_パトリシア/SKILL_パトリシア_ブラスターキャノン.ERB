;パトリシア・ハックマン専用スキル。
;拡散核熱物理、威力400、MP35、ランク13

;スキル名
@SKILL_NAME_ブラスターキャノン,ARG
RESULTS = 블래스터 캐넌

;　명중
@SKILL_HITRATE_ブラスターキャノン, ARG
RETURN 100

;　威力
@SKILL_POWER_ブラスターキャノン, ARG
RETURN 400

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ブラスターキャノン,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ブラスターキャノン,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ブラスターキャノン, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ブラスターキャノン,ARG
RETURN 35

;　相性
@SKILL_TYPE_ブラスターキャノン,ARG
RETURN GET_TYPE_NUM("핵열")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ブラスターキャノン
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ブラスターキャノン,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ブラスターキャノン,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ブラスターキャノン,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ブラスターキャノン,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ブラスターキャノン,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_ブラスターキャノン, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ブラスターキャノン
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_ブラスターキャノン
RETURN GET_SUCCESSION_NUM("핵열")

;拡散攻撃用追加処理
@SKILL_SPREAD_ブラスターキャノン,ARG
RETURN 1
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ブラスターキャノン,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;拡散攻撃
CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_ブラスターキャノン,ARG
PRINTL 흉부 내장 빔포에서 고위력 빔을 발사한다.
PRINTL 적 1체와 그 주위의 적에게 핵열 상성의 물리 특대 데미지. 후열 사용 가능.

@SKILL_EXPLAIN_TOOLTIP_ブラスターキャノン, ARG
RESULTS:0 = 흉부 내장 빔포에서 고위력 빔을 발사한다.
RESULTS:1 = 적 1체와 그 주위의 적에게 핵열 상성의 물리 특대 데미지. 후열 사용 가능.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ブラスターキャノン,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_ブラスターキャノン, ARG = -1
RETURN 13
