;スキル名
@SKILL_NAME_強力清掃,ARG
RESULTS = 強力清掃

;　명중
@SKILL_HITRATE_強力清掃, ARG
RETURN 70

;　威力
@SKILL_POWER_強力清掃, ARG
SIF ARG < 0
	RETURN 25
CALL GET_SKILL_POWER_強力清掃(GET_ROLE_CFLAG_TAKEOVER(ARG, "通常スキルランク"))
RETURN RESULT

;基礎威力はお掃除開始とおなじだが単体ヒット数の期待値が4と劣るので単体へのダメージ期待値ではやはり負ける
@GET_SKILL_POWER_強力清掃, ARG
SELECTCASE ARG
	CASE 15
		RETURN 95
	CASE 11 TO 14
		RETURN 80 + (ARG - 10) * 3
	CASE 10
		RETURN 80
	CASE 2 TO 9
		RETURN 20 + 6 * ARG
	CASE 0, 1
		RETURN 25
	CASEELSE
		RETURN 0
ENDSELECT

;;クリティカル率
@SKILL_CRITICAL_RATE_強力清掃, ARG
RETURN 10

;　최저공격횟수
@SKILL_MINATTACKNUMBER_強力清掃,ARG
RETURN 6

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_強力清掃,ARG
RETURN 18

;一体辺りの最低ＨＩＴ数
@SKILL_MINATK_PER_強力清掃,ARG
RETURN 2

;一体辺りの最大ＨＩＴ数
@SKILL_MAXATK_PER_強力清掃,ARG
RETURN 6


;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_強力清掃, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_強力清掃,ARG
SIF ARG < 0
	RETURN 2
CALL GET_SKILL_COST_強力清掃(GET_ROLE_CFLAG_TAKEOVER(ARG, "通常スキルランク"))
RETURN RESULT

;　コストの量
@GET_SKILL_COST_強力清掃,ARG
SELECTCASE ARG
	CASE 15
		RETURN 36
	CASE 0, 1
		RETURN 8
	CASEELSE
		RETURN 6 + ARG * 2
ENDSELECT

;　相性
;複合相性
@SKILL_TYPE_強力清掃,ARG
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "見習いメイド")
	RETURN GET_TYPE_NUM("검격"), GET_TYPE_NUM("핵열")
ELSE
	RETURN GET_TYPE_NUM("검격")
ENDIF

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_強力清掃
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_強力清掃,ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_強力清掃,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_強力清掃,ARG
RETURN 4

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_強力清掃,ARG
RETURN GET_SPHERE_NUM("전체")

;スキルがランダム範囲かどうか
@SKILL_RAND_TARGET_強力清掃,ARG
RETURN 1

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_強力清掃,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_強力清掃, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_強力清掃, ARG = -1
RETURN 0

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_強力清掃, ARG = -1, ARG:1 = -1
IF ARG >= 0 && HAVE_PU_SKILL(ARG, "特殊勤務メイド")
	RETURN 0, 4
ELSE
	RETURN 0, 0
ENDIF
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_強力清掃,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_強力清掃,ARG
PRINTL 【일반】【코린 전용 스킬】
PRINTL 적 전체 랜덤으로 최대 18회 검격 상성의 소데미지를 준다.
PRINTL 이 스킬은 명중률이 낮고, 크리티컬률이 높다.
PRINTL 공격 대상에게 상태이상이 부여되어 있는 경우, 필중 효과를 얻는다.

@ENHANCE_SKILL_EXPLAIN_強力清掃,ARG
RESULTS '= "敵全体ランダムに最大で18回、剣撃相性の小ダメージを与える。" + "<br>"
RESULTS += "このスキルは命中率が低く、크리티컬률이 높다。" + "<br>"
RESULTS += "攻撃対象にバッドステートが付着されている場合、必中効果を得る。"
;使用条件
@SKILL_SPECIAL_ACTIONABLE_強力清掃,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_強力清掃, ARG = -1
RETURN 3


;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_強力清掃, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "追加命中強化"
			SIF CONVERT_SKILLNUM_TO_STR(L_P, SKILL_NUM) != "強力清掃"
				RETURN 0
			SIF IS_BADSTATE(L_TARGET, "GOOD")
				RETURN 0
			RETURN 999
	ENDSELECT
;自分が防御側
ELSE
ENDIF
RETURN 0

@SKILL_TAG_強力清掃
RESULTS = 젠제로 일반 스킬
