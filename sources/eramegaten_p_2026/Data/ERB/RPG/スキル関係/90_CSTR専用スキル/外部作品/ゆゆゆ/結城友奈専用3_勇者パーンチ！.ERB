;ターン開始時処理
;@SKILL_TURNSTART_勇者パーンチ！,ARG,ARG:1

@SKILL_PASSIVE_BTL_EFFECT_勇者パーンチ！, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;ターゲットが神族であるときに起動する自動効果
IF GROUPMATCH(ABL:L_TARGET:종족, 1, 14, 15)
	;自分が攻撃側
	IF L_P == L_ACTOR
		SELECTCASE ARGS
			;気合などと加算の枠。他に下限要素がなければ100%±X%になる
			CASE "ダメージ補正加算"
				IF L_ダメージタイプ == "物理"
					RESULTS = 神族特効
					RETURN 50
				ENDIF
		;100% ± Xの補正を与える。同種(粗雑・慢心)などとは加算。補正量が素直
		;この補正を999以上で指定した場合は確定クリティカル、-999以下で指定した場合はクリティカル不能となる
		CASE "クリティカル補正A"
			RETURN 50
		ENDSELECT
	ENDIF
ENDIF
RETURN 0

