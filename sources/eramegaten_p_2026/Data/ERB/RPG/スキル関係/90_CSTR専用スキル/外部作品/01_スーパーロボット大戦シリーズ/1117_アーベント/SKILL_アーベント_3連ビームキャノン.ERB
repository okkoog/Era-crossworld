;ヴァイスリッター・アーベント専用スキル。
;単体核熱物理、3回攻撃、威力75(*3=225)、MP8、ランク5

;スキル名
@SKILL_NAME_3連ビームキャノン,ARG
RESULTS = 3연장 빔 캐넌

;　명중
@SKILL_HITRATE_3連ビームキャノン, ARG
RETURN 100

;　威力
@SKILL_POWER_3連ビームキャノン, ARG
RETURN 75

;　최저공격횟수
@SKILL_MINATTACKNUMBER_3連ビームキャノン,ARG
RETURN 3

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_3連ビームキャノン,ARG
RETURN 3

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_3連ビームキャノン, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_3連ビームキャノン,ARG
RETURN 8

;　相性
@SKILL_TYPE_3連ビームキャノン,ARG
RETURN GET_TYPE_NUM("핵열")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_3連ビームキャノン
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_3連ビームキャノン,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_3連ビームキャノン,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_3連ビームキャノン,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_3連ビームキャノン,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_3連ビームキャノン,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_3連ビームキャノン, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3連ビームキャノン
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_3連ビームキャノン
RETURN GET_SUCCESSION_NUM("핵열")
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3連ビームキャノン,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;単体攻撃
CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_3連ビームキャノン,ARG
PRINTL 왼팔의 중사거리 빔포를 3연사하여 적을 공격한다.
PRINTL 적 단체에 3회 핵열 상성의 물리 소데미지. 후열 사용 가능.

@SKILL_EXPLAIN_TOOLTIP_3連ビームキャノン, ARG
RESULTS:0 = 왼팔의 중사거리 빔포를 3연사하여 적을 공격한다.
RESULTS:1 = 적 단체에 3회 핵열 상성의 물리 소데미지. 후열 사용 가능.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_3連ビームキャノン,ARG
RETURN 1

;スキル変化用ランク
@SKILL_RANK_3連ビームキャノン, ARG = -1
RETURN 5
