;INTERNET_OVERDOSE
;ライトかダークかによって性能の方向性がまるで違うスキル。
;ライト：回復・強化
;ダーク：攻撃・弱化
;
;何れにせよ、やみ値を大きく上げる。
;


;スキル名
@SKILL_NAME_INTERNET_OVERDOSE,ARG
RESULTS = INTERNET OVERDOSE

;　명중
@SKILL_HITRATE_INTERNET_OVERDOSE, ARG
RETURN 150

;　威力
@SKILL_POWER_INTERNET_OVERDOSE, ARG
SIF ARG == -1
	RETURN 120
IF BASE:ARG:LV < 20
	SELECTCASE CFLAG:ARG:질혼치
		CASE IS > 170
			RETURN 100
		CASE IS < 85
			RETURN 150
		CASEELSE
			RETURN 100
	ENDSELECT
ELSEIF BASE:ARG:LV < 35
	SELECTCASE CFLAG:ARG:질혼치
		CASE IS > 170
			RETURN 160
		CASE IS < 85
			RETURN 240
		CASEELSE
			RETURN 160
	ENDSELECT
ELSEIF BASE:ARG:LV < 50
	SELECTCASE CFLAG:ARG:질혼치
		CASE IS > 170
			RETURN 240
		CASE IS < 85
			RETURN 360
		CASEELSE
			RETURN 240
	ENDSELECT
ELSEIF BASE:ARG:LV < 65
	SELECTCASE CFLAG:ARG:질혼치
		CASE IS > 170
			RETURN 300
		CASE IS < 85
			RETURN 450
		CASEELSE
			RETURN 300
	ENDSELECT
ELSE
	SELECTCASE CFLAG:ARG:질혼치
		CASE IS > 170
			RETURN 360
		CASE IS < 85
			RETURN 540
		CASEELSE
			RETURN 360
	ENDSELECT
ENDIF

;クリティカル率
@SKILL_CRITICAL_RATE_INTERNET_OVERDOSE, ARG
RETURN 5

