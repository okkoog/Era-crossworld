;消費なし＝1

;　コストの量
@SKILL_COST_INTERNET_OVERDOSE,ARG
SIF ARG == -1
	RETURN 10
IF BASE:ARG:LV < 20
			RETURN 10
ELSEIF BASE:ARG:LV < 35
			RETURN 20
ELSEIF BASE:ARG:LV < 50
			RETURN 35
ELSEIF BASE:ARG:LV < 65
			RETURN 40
ELSE
			RETURN 50
ENDIF

;　相性
@SKILL_TYPE_INTERNET_OVERDOSE,ARG
SIF ARG == -1
	RETURN GET_TYPE_NUM("만능")
SELECTCASE CFLAG:ARG:질혼치
	CASE IS > 170
		RETURN GET_TYPE_NUM("전격"), GET_TYPE_NUM("전술"), GET_TYPE_NUM("핵열")
	CASE IS < 85
		RETURN GET_TYPE_NUM("전격"), GET_TYPE_NUM("전술"), GET_TYPE_NUM("중력")
	CASEELSE
		RETURN GET_TYPE_NUM("정신")
ENDSELECT




;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_INTERNET_OVERDOSE
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_INTERNET_OVERDOSE,ARG
RETURN GET_ダメージタイプ_NUM("物理")
;====================================================
;攻撃手段
;1.物理攻撃 2.魔法攻撃 3.총공격 4.アイテム攻撃(ダメージ計算時の依存ステータスに関わる)
;関数がない場合はダメージタイプとおなじになる
;====================================================
@SKILL_ATTACKTYPE_INTERNET_OVERDOSE, ARG
RETURN GET_攻撃タイプ_NUM("魔法")

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_INTERNET_OVERDOSE, ARG = -1, ARG:1 = -1
SIF ARG == -1
	RETURN 0
SELECTCASE CFLAG:ARG:질혼치
	CASE IS > 250
		RETURN 4
	CASE IS < 5
		RETURN 4
	CASEELSE
		RETURN 0
ENDSELECT
RETURN 0


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_INTERNET_OVERDOSE,ARG
SELECTCASE CFLAG:ARG:질혼치
	CASE IS > 170
		RETURN 1
	CASE IS < 85
		RETURN 1
	CASEELSE
		RETURN 4
ENDSELECT

;　사거리
@SKILL_RANGE_INTERNET_OVERDOSE,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_INTERNET_OVERDOSE,ARG
SIF ARG == -1
	RETURN 1
	SELECTCASE CFLAG:ARG:질혼치
		CASE IS > 170
			RETURN 3
		CASE IS < 85
			RETURN 1
		CASEELSE
			RETURN 1
	ENDSELECT

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_INTERNET_OVERDOSE,ARG
SELECTCASE CFLAG:ARG:질혼치
	CASE IS > 170
		RETURN 1
	CASE IS < 85
		RETURN 1
	CASEELSE
		RETURN 2
ENDSELECT

@SKILL_HEAL_TYPE_INTERNET_OVERDOSE, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("통상")

