;特殊な攻撃参照値
@SKILL_CALC_BATTTLE_STATUS_クリスタルソード, ARGS, ARG, ARG:1
SIF ARG < 0
	RETURN 0
SELECTCASE ARGS
	CASE "ATK"
		RETURN MAXBASE:ARG:공격 + MAXBASE:ARG:마법위력
ENDSELECT
