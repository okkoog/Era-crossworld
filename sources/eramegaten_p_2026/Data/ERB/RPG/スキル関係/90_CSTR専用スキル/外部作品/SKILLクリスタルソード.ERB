;;拡散攻撃用追加処理
;;ブレスなどの拡散攻撃に使う
;@SKILL_SPREAD_クリスタルソード,ARG
;RETURN 0

;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_クリスタルソード, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "ATK"
		RETURN LIMIT(CFLAG:ARG:공격강화 + CFLAG:ARG:마법위력강화, -48, 64), 32
ENDSELECT

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_クリスタルソード,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;MAXBASE:ARG:공격 += MAXBASE:ARG:마법위력
;CFLAG:ARG:공격강화 += CFLAG:ARG:마법위력강화

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

;MAXBASE:ARG:공격 -= MAXBASE:ARG:마법위력
;CFLAG:ARG:공격강화 -= CFLAG:ARG:마법위력강화

;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_クリスタルソード,ARG
PRINTL 거대한 크리스탈 소드로 상대를 꿰뚫는다
PRINTL 적 단체에게 빙결·비구 복합 속성의 물리 공격을 가한다
PRINTL 공격력은 마법위력＋공격으로 산출되며, 마카카자의 효과도 받는다

;使用条件
@SKILL_SPECIAL_ACTIONABLE_クリスタルソード,ARG
RETURN 1
