@SKILL_HITRATE_バイ・バイ・ライジング, ARG
#DIM ACC
ACC = 90
SIF ARG < 0
	RETURN ACC
SELECTCASE BASE:ARG:LV
	CASE IS >= 70
		ACC = 100
	CASE IS >= 35
		ACC = 95
ENDSELECT
RETURN ACC

