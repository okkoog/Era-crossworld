;====================================================
;独自処理
;====================================================
;（予定）と付けられている方は仮置きの物。実際に採用されるかどうかはわからない。
@AUTO_PU_SKILL_バイ・バイ・ライジング,ARG,ARGS,ARG:1,ARG:2
#DIM SKILL_NUM
#DIM L_USER
;ARG = 攻撃者
;ARGS （ダメージ↑、被ダメージ↑、命中↑、回避↑、魔威↑、魔効↑、etc…）といった感じの奴
;ARG:1 = 防御者
;ARG:2 = etc枠。 今回では使用しない
;文字列を参考にする都合上、どの文字列を使うか事前に定めておいた方がいいかも
;CSTR:ARG:100 = EXTRA勢出典作品、『超次元ゲイムネプテューヌ』とでも書き込む（予定）
;CSTR:ARG:101 = EXTRA勢出典作品でどのキャラなのか、とりあえず『デンゲキコ』とでも書き込む（予定）
L_USER = -1
SIF (ARGS == "物理回避判定↑" || ARGS == "魔法回避判定↑") && CSTR:(ARG:1):101 == "デンゲキコ"
	L_USER = ARG:1
SIF L_USER == -1
	RETURN 0
SKILL_NUM = PU_SKILLNUM_GET(L_USER,"バイ・バイ・ライジング")
IF SKILLGAGE_D_GET(L_USER,SKILL_NUM) > 0
	SELECTCASE ARGS
		CASE "物理回避判定↑","魔法回避判定↑"
			RETURN 8
	ENDSELECT
ENDIF
RETURN 0
