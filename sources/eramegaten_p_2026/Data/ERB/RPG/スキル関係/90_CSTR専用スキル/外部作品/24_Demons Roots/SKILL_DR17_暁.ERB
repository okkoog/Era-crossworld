@SKILL_COUNTER_ACTIONABLE_暁,ARG,ARG:1
	;自分への攻撃行動でないとだめ。一応。
	SIF !GET_CREC_ACT(ARG:1, ARG, "ATTACK")
		RETURN 0
	;受けた結果が反射ではない
	SIF GET_CREC_ACT(ARG:1, ARG, "REFLECT")
		RETURN 0
	;仲間には反撃しない
	SIF IS_FRIEND(ARG:1, ARG)
		RETURN 0
	;スキル起動中でないとダメ。
	SIF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"暁")) == 0
		RETURN 0
	;50%
	SIF RAND:2 == 0
		RETURN 0
	;反撃の対象は反撃してきたキャラ(ポジションで返す)
	RETURN 1, CPOS(ARG:1)
;発動効果中であり、自分に攻撃が来た、相手死んでいない、かつ５０％

