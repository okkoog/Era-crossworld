;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_暁,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
IF FLAG:카운터중 == 1
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
ELSE
	IF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"暁")) == 0
		PRINTFORML %CALLNAME:ARG%의 물리 공격 주는 데미지량이 상승!
		PRINTFORML %CALLNAME:ARG%의 물리 공격 받는 데미지량이 감소!
		CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"暁"),4
	ELSE
		PRINTFORML 暁　　＞　　효과가 없었다！
	ENDIF
ENDIF


