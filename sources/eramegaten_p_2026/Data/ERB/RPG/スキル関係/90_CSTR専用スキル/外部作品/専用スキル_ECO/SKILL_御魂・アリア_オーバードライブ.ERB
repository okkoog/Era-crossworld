;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_オーバードライブ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
IF PU_SKILLGAGE_D_GET(ARG, "オーバードライブ") == 0
	PRINTFORML %CALLNAME:ARG%의 물리 공격 데미지량이 상승!
	CALL PU_SKILLGAGE_D_SET,ARG, "オーバードライブ", 3
ELSE
	PRINTFORML 오버드라이브　　＞　　효과가 없었다!
ENDIF


;====================================================
;実行内容ここまで
;====================================================

@SKILL_PASSIVE_BTL_EFFECT_オーバードライブ, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

IF SKILLGAGE_D_GET(L_P,PU_SKILLNUM_GET(L_P,"オーバードライブ")) > 0
	;自分が攻撃側
	IF L_P == L_ACTOR
		SELECTCASE ARGS
			;気合などと加算の枠。他に加減要素がなければ100%±X%になる
			CASE "ダメージ補正加算"
				IF L_ダメージタイプ == "物理"
					RETURN 20
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 0

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_オーバードライブ,ARG
IF PU_SKILLGAGE_D_GET(ARG,"オーバードライブ") != 0
	RESULTS = 오버드라이브:{PU_SKILLGAGE_D_GET(ARG,"オーバードライブ")}T
	RETURN 3
ENDIF

@SKILL_EX_DISPLAY_オーバードライブ, ARG, ARGS
IF PU_SKILLGAGE_D_GET(ARG, "オーバードライブ") > 0
	RESULTS += SET_COLOR_TAG("ＯＤ", TOSTR(0xdc143c))
	RESULTS += HTML_RECT_SPLIT_BAR(PU_SKILLGAGE_D_GET(ARG, "オーバードライブ"), 3, SKILL_EX_DISPLAY_LENS - 4, BARCOLORSET("赤"), RESULT:1)
	RESULTS:1 = 오버드라이브
ELSE
	IF INPUTABLE_CHARA_F(ARG)
		CALL CHECK_ACTIONABLE, ARG, PU_SKILLNUM_GET(ARG,"オーバードライブ")
		IF RESULT
			RESULTS '= SET_BUTTON_TAG(SET_COLOR_TAG(@"%"ＯＤ", SKILL_EX_DISPLAY_LENS -7, LEFT%", "パ緑"), ARGS)
			RESULTS += SET_BUTTON_TAG(SET_COLOR_TAG(@"[Ready]", "パ緑"), @"INPUT/SKILL/{ARG}/{PU_SKILLNUM_GET(ARG, "オーバードライブ")}", @"オーバードライブを使用")
		ELSE
			RESULTS '= SET_COLOR_TAG(@"%"ＯＤ", SKILL_EX_DISPLAY_LENS - 7, LEFT%", "gray")
			RESULTS += SET_COLOR_TAG(@"[Ready]", "gray")
		ENDIF
	ENDIF
ENDIF
RETURN 1

@SKILL_BATTLE_MAIN_FACE_TOOLTIP_オーバードライブ, ARG, ARG:1
IF SKILLGAGE_D_GET(ARG,ARG:1) > 0
	RESULTS = □오버드라이브
	RESULTS:1 = 　물리 데미지 +20%
