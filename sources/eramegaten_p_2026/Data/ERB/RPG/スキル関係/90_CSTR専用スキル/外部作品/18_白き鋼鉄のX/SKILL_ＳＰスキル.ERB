;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_ＳＰスキル, ARG, ARG:1
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "ＳＰスキル")
IF SKILL_CHANGE(ARG, [[キャラ:브리게이드_X2]]) && SKILLGAGE_H_GET(ARG, SKILL_NUM) && SKILLGAGE_D_GET(ARG, SKILL_NUM) == 0
	;1行動中に1回のみ
	SIF TFLAG:스킬트리거용1++
		RETURN 0
	RETURN 1
ENDIF
RETURN 0

;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_ＳＰスキル, ARG, ARG:1
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "ＳＰスキル")
IF SKILL_CHANGE(ARG, [[キャラ:브리게이드_X2]]) && SKILLGAGE_H_GET(ARG, SKILL_NUM) && BASE:ARG:ＨＰ < 1
	;死んだら
	IF BASE:ARG:ＨＰ < 1
		CALL SKILLGAGE_D_SET, ARG, SKILL_NUM ,0
		CALL SKILLGAGE_H_SET, ARG, SKILL_NUM ,0
	ENDIF
ENDIF

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ＳＰスキル, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 3
#DIM SKILL_NUM
#DIM ターゲット配列,17

IF SKILL_CHANGE(ARG, [[キャラ:입실론_X2]])
	IF CFLAG:ARG:포지션 < 7
		LOCAL:1 = 7
		LOCAL:2 = 17
	ELSE
		LOCAL:1 = 1
		LOCAL:2 = 7
	ENDIF
	FOR LOCAL, LOCAL:1, LOCAL:2
		TFLAG:스킬용1 = 0
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS < 0
			CONTINUE
		SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
			CONTINUE
		;中央にいたら
		SELECTCASE LOCAL
		CASE 2, 5, 8, 9, 10, 13, 14, 15
			TFLAG:스킬용1 = 1
		CASEELSE
		ENDSELECT
		CALL ATTACK_SINGLE, ARG, FLAG:LOCALS, SKILL_NUM
	NEXT
	TFLAG:스킬용1 = 0
	CFLAG:ARG:타겟 = CFLAG:ARG:포지션 < 7 ? 22 # 19
ELSEIF SKILL_CHANGE(ARG, [[キャラ:데이사이트_X2]])
	CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM
ELSEIF SKILL_CHANGE(ARG, [[キャラ:베스파_X2]])
	IF CFLAG:ARG:포지션 < 7
		LOCAL:1 = 7
		LOCAL:2 = 17 
	ELSE
		LOCAL:1 = 1
		LOCAL:2 = 7
	ENDIF
	FOR LOCAL, LOCAL:1, LOCAL:2
		TFLAG:스킬용1 = 0
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS < 0
			CONTINUE
		SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
			CONTINUE
		;中央にいたら
		SELECTCASE LOCAL
		CASE 2, 5, 8, 9, 10, 13, 14, 15
			TFLAG:스킬용1 = 1
		CASEELSE
		ENDSELECT
		CALL ATTACK_SINGLE, ARG, FLAG:LOCALS, SKILL_NUM
	NEXT
	TFLAG:스킬용1 = 0
	CFLAG:ARG:타겟 = CFLAG:ARG:포지션 < 7 ? 22 # 19
ELSEIF SKILL_CHANGE(ARG, [[キャラ:브리게이드_X2]])
	IF FLAG:총공격중
		PRINTFORMW 카운트가 0이 되었다! 폭탄이 기폭한다!
		IF CFLAG:ARG:포지션 < 7
			;22は敵全体を指す
			CALL ATTACK_FIELD, ARG, 22, SKILL_NUM
		ELSE
			;19は味方全体を指す
			CALL ATTACK_FIELD, ARG, 19, SKILL_NUM
		ENDIF
		SIF CFLAG:ARG:상태이상 < GET_STATE_NUM("DYING")
			CALL VAR_HP, ARG, -BASE:ARG:ＨＰ, "食いしばり無効ダメージ"
	ELSE
		PRINTFORMW %CALLNAME:ARG%(은)는 주위에 폭탄을 설치했다! 5턴 후에 기폭한다!
		CALL SKILLGAGE_H_SET, ARG, SKILL_NUM ,1
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:오토크롬_X2]])
	CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM
ELSEIF SKILL_CHANGE(ARG, [[キャラ:헤일_X2]])
	VARSET ターゲット配列, -1
	;流石に味方側で使う時は条件をつける。いずれな
	IF CFLAG:ARG:포지션 < 7
		LOCAL:1 = 7
		LOCAL:2 = 17 
	ELSE
		LOCAL:1 = 1
		LOCAL:2 = 7
	ENDIF
	FOR LOCAL, LOCAL:1, LOCAL:2
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS < 0
			CONTINUE
		ターゲット配列:LOCAL = FLAG:LOCALS
		CFLAG:(ターゲット配列:LOCAL):BS부착률강화 =MIN(4, CFLAG:(ターゲット配列:LOCAL):BS부착률강화 + 4)
		;一時的に下限だろうと超える
		CFLAG:(ターゲット配列:LOCAL):마법효과강화 = CFLAG:(ターゲット配列:LOCAL):마법효과강화 - 4
	NEXT
	CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM
	FOR LOCAL, LOCAL:1, LOCAL:2
		;攻撃前にいたやつはそのポジションの添え字にキャラ番号が入っている、それ以外は-1
		SIF ターゲット配列:LOCAL < 0
			CONTINUE
		;下げた分を元に戻す。こうすれば死んでCOMPに戻った奴も戻せるはず
		CFLAG:(ターゲット配列:LOCAL):마법효과강화 = CFLAG:(ターゲット配列:LOCAL):마법효과강화 + 4
	NEXT
ELSEIF SKILL_CHANGE(ARG, [[キャラ:슬러그_X2]])
	CALL ATTACK_RAND, ARG, ARG:1, SKILL_NUM
ELSEIF SKILL_CHANGE(ARG, [[キャラ:창조주_X2]])
	CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM
ELSEIF SKILL_CHANGE(ARG, [[キャラ:마더_X2]])
	IF SKILLGAGE_H_GET(ARG, SKILL_NUM) == 0 && CFLAG:ARG:포지션 > 6
		CFLAG:ARG:마법여데미지보정 += 30
		PRINTFORML %CALLNAME:ARG%의 공격력이 상승했다!
	ENDIF
	CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM
	CALL SKILLGAGE_H_SET, ARG, SKILL_NUM ,1
ENDIF

IF SKILL_CHANGE(ARG, [[キャラ:마더_X2]])
	CALL SKILLGAGE_D_SET, ARG, SKILL_NUM ,8
ELSE
	CALL SKILLGAGE_D_SET, ARG, SKILL_NUM ,5
ENDIF
