;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_痛幻の哭奏, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "ATK"
		RETURN LIMIT(CFLAG:ARG:공격강화 + CFLAG:ARG:마법위력강화, -48, 64), 32
ENDSELECT


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_痛幻の哭奏,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM トドメまでお前を殴るのを止めないフラグ
#DIM HIT_COUNT
#DIM HIT_CONTINUE
#DIM CRT_CONTINUE

FOR HIT_COUNT,1,7
	IF HIT_COUNT == 1 && CFLAG:ARG:PT플래그 == 0
		SETCOLOR COLOR("ENEMY")
		CALL BATTLE_EVENT_ACT, ARG
		RESETCOLOR
	ENDIF
	CALL SKILLGAGE_H_ADD,ARG,SKILL_NUM,1
	SIF POS(ARG:1) >= 0
		CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
	IF HIT_COUNT == 6
		CALL SKILLGAGE_H_SET,ARG,SKILL_NUM,0
	ENDIF
NEXT
CALL SKILLGAGE_D_SET,ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"),0

