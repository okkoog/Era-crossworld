;スキル名
@SKILL_NAME_痛幻の哭奏,ARG
RESULTS = 통환의 곡주

;　명중
@SKILL_HITRATE_痛幻の哭奏, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"痛幻の哭奏")

;1撃目以降で相手が回避失敗ではなかった場合、命中率を0に
;SIF SKILLGAGE_H_GET(ARG,SKILL_NUM) > 1 && CFLAG:POS(CFLAG:ARG:타겟):회피실패 < 1
;	RETURN 0
;RETURN 130

;初段以降は初段の判定結果に従う
IF SKILLGAGE_H_GET(ARG,SKILL_NUM) > 1
	IF GET_CREC_ACT(ARG, -1, "AVOID")
		RETURN 0
	ELSE
		RETURN 999
	ENDIF
ELSE
	RETURN 130
ENDIF

;　威力
@SKILL_POWER_痛幻の哭奏, ARG
#DIM SKILL_NUM
#DIM L_DMG
SKILL_NUM = PU_SKILLNUM_GET(ARG,"痛幻の哭奏")
SELECTCASE SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"))
	CASE IS > 3
		L_DMG = 640
	CASE IS > 1
		L_DMG = 560
	CASEELSE
		L_DMG = 480
ENDSELECT

SELECTCASE SKILLGAGE_H_GET(ARG,SKILL_NUM)
	CASE 1
		TIMES L_DMG , 0.02
	CASE 2
		TIMES L_DMG , 0.04
	CASE 3
		TIMES L_DMG , 0.06
	CASE 4
		TIMES L_DMG , 0.08
	CASE 5
		TIMES L_DMG , 0.11
	CASE 6
		TIMES L_DMG , 0.13
ENDSELECT

RETURN L_DMG

;クリティカル率
@SKILL_CRITICAL_RATE_痛幻の哭奏, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"痛幻の哭奏")
;1撃目以降で相手が被クリティカルではなかった場合、クリティカル率を0に
IF SKILLGAGE_H_GET(ARG,SKILL_NUM) > 1
	;CALL CRT_CHECK
	;SIF !GETBIT(RESULT,2)
	IF TFLAG:크리티컬발생_ACT
		RETURN 999
	ELSE
		RETURN 0
	ENDIF
ENDIF
RETURN 30


