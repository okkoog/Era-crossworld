	CASE "DYING"
		RETURN 1
	CASEELSE
		RETURN 0
ENDSELECT

;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_戦術スキル_シルヴィア, L_CHARA, ARG:1
#DIM L_CHARA
#DIM L_GP
;自身の行動のみ
SIF L_CHARA != ARG:1
	RETURN 0
L_GP = 25
IF IS_PU_SKILL_入力行動(L_CHARA, "戦術スキル_シルヴィア")
	CALL PU_SKILLGAGE_H_SET, L_CHARA, "戦術スキル_シルヴィア", 0
ELSE
	SIF GET_CREC_ACT(L_CHARA, , "HIT")
		L_GP += 25
	SIF GET_CREC_ACT(L_CHARA, , "CRT/WEAK")
		L_GP += 50
	SIF L_GP + PU_SKILLGAGE_H_GET(L_CHARA, "戦術スキル_シルヴィア") > 500
		L_GP = MAX(500 - PU_SKILLGAGE_H_GET(L_CHARA, "戦術スキル_シルヴィア"), 0)
	SIF L_GP == 0
		RETURN 0
	CALL PU_SKILLGAGE_H_ADD, L_CHARA, "戦術スキル_シルヴィア", L_GP
	RESULTS = 포스
	RETURN L_GP
ENDIF

@SKILL_EX_DISPLAY_戦術スキル_シルヴィア, ARG, ARGS
RESULTS += @"フォース：{PU_SKILLGAGE_H_GET(ARG, "戦術スキル_シルヴィア"),3}"
RESULTS:1 '= "戦術スキル_シルヴィア"
RETURN 1