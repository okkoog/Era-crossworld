;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_戦術スキル_シルヴィア,ARG, ARG:1, ARG:2
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
FOR LCOUNT, GET_POS_MIN(ARG:1), GET_POS_MAX(ARG:1) + 1
	L_CHARA = POS(LCOUNT)
	SIF L_CHARA < 0
		CONTINUE
	CALL SKILL_CURE_STATE_戦術スキル_シルヴィア, CFLAG:L_CHARA:상태이상
	IF RESULT == 1
		CFLAG:L_CHARA:상태이상 = 0
		CFLAG:L_CHARA:상태이상경과턴수 = 0
		CALL HEAL_SINGLE, ARG, L_CHARA, ARG:2, 1, , "蘇生"
	ELSE
		CALL HEAL_SINGLE, ARG, L_CHARA, ARG:2, 1
	ENDIF
NEXT
WAIT

