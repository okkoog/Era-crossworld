
;スキル名
@SKILL_NAME_戦術スキル_シルヴィア,ARG
IF ARG >= 0 && FLAG:행동순1 == ARG
	SELECTCASE PU_SKILLGAGE_H_GET(ARG, "戦術スキル_シルヴィア")
		CASE IS < 200
			RESULTS = 바루나 아디나
		CASE IS < 400
			RESULTS = 지라 솔레
		CASEELSE
			RESULTS = 셀레스티아
	ENDSELECT
ELSE
	RESULTS = 전술 스킬
ENDIF
;　명중
@SKILL_HITRATE_戦術スキル_シルヴィア, ARG
RETURN 100

