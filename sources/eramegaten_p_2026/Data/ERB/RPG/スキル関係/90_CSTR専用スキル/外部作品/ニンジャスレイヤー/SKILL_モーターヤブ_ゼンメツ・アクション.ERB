;万能拡散物理、威力450、MP46、ランク15

;スキル名
@SKILL_NAME_ゼンメツ・アクション,ARG
RESULTS = 전멸·액션

;　명중
@SKILL_HITRATE_ゼンメツ・アクション, ARG
RETURN 100

;　威力
@SKILL_POWER_ゼンメツ・アクション, ARG
RETURN 450

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ゼンメツ・アクション,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ゼンメツ・アクション,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ゼンメツ・アクション, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ゼンメツ・アクション,ARG
RETURN 46

;　相性
@SKILL_TYPE_ゼンメツ・アクション,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ゼンメツ・アクション
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ゼンメツ・アクション,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ゼンメツ・アクション,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ゼンメツ・アクション,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ゼンメツ・アクション,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ゼンメツ・アクション,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_ゼンメツ・アクション, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ゼンメツ・アクション
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_ゼンメツ・アクション
RETURN GET_SUCCESSION_NUM("만능")

;拡散攻撃用追加処理
@SKILL_SPREAD_ゼンメツ・アクション,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_ゼンメツ・アクション, ARG = -1
RETURN 15

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ゼンメツ・アクション,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;拡散攻撃
CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_ゼンメツ・アクション,ARG
PRINTL 적 1체와 그 주위의 적에게 만능 상성의 물리 특대 데미지.
PRINTL 모터 야부의 전 화력을 전개하여 일제 사격을 행한다.

@SKILL_EXPLAIN_TOOLTIP_ゼンメツ・アクション,ARG
RESULTS:0 = 적 1체와 그 주위의 적에게 만능 상성의 물리 특대 데미지.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ゼンメツ・アクション,ARG
RETURN 1

