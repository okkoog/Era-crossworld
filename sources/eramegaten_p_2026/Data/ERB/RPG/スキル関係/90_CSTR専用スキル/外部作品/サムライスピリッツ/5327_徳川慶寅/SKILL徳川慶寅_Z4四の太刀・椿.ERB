;スキル及び行動の実行
;====================================================

@ACTION_四の太刀・椿, ARG, ARG:1, SKILL_NUM
#DIM SKILL_NUM
LOCAL = POS(ARG:1)

CALL ATTACK_SINGLE, ARG,LOCAL,SKILL_NUM

