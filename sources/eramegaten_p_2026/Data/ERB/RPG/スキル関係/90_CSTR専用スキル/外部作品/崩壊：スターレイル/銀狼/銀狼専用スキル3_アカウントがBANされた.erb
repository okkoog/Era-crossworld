;====================================================
;トリガー発動条件
;
;詳しい仕様については資料フォルダの解説を参照してください
;====================================================
@SKILL_TRIGGER_ACTIONABLE_アカウントがBANされた,ARG,ARG:1
SIF CFLAG:ARG:입력행동 == -1
	RETURN 0
SIF !INPUTABLE_CHARA_F(ARG)
	RETURN 0
SIF CFLAG:ARG:방어플래그 == 1
	RETURN 0
IF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"アカウントがBANされた")) >= 55
	;既に相手方が亡くなっている場合はランダムに決めなおす
	SIF CFLAG:ARG:타겟 < 1
		CALL RANDOM_TARGET,ARG,CFLAG:ARG:PU_SKILLNUM_GET(ARG,"アカウントがBANされた")
	;ターゲットは敵単体でなければならない
	SIF !INRANGE(CFLAG:ARG:타겟,7, 16)
		RETURN 0
	CALL SKILLGAGE_F_SET,ARG,PU_SKILLNUM_GET(ARG,"アカウントがBANされた"),0
	RETURN 1, CFLAG:ARG:타겟
ENDIF
;====================================================
;カウンター発動条件
;ARG 		このスキルの持ち主
;ARG;1 		攻撃してきている相手
;RESULT 	カウンターが成立したかどうか
;RESULT:1	カウンターする相手のターゲット番号(ポジションなのでCPOSで返すか、あるいは範囲なら19などで返す)
;RESULT;1は指定なしなら敵の生存判定・存在判定を行わずにACTIONを実行する
;====================================================
;@SKILL_COUNTER_ACTIONABLE_アカウントがBANされた,ARG,ARG:1
;RETURN RESULT


;====================================================
;ダメージ発動時
;ARG:2　1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;====================================================
@SKILL_DAMAGE_EFFECT_アカウントがBANされた,ARG,ARG:1,ARG:2
CALL SKILLGAGE_D_SET,ARG ,PU_SKILLNUM_GET(ARG,"アカウントがBANされた"),1
;====================================================
;行動によるスキルゲージ操作
;====================================================
@SKILLGAGE_CHARGE_アカウントがBANされた,ARG,ARG:1
#LOCALSIZE 2
#DIM L_T
#DIM L_GP
L_GP = 0
FOR LOCAL, 1, 7
	SIF !IS_TARGET_ABLE(POS(LOCAL))
		CONTINUE
	SIF CFLAG:POS(LOCAL):ＣＯＯＰ플래그
		L_GP += 10
NEXT
;自分の行動の場合
IF ARG == ARG:1
	;毎ターン＋10
	L_GP += 10
	;専用技の使用でゲージ上昇
	SIF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG,"システム警告")
		L_GP += 20
	SIF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG,"変更を許可しますか？")
		L_GP += 30
	SIF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG,"アカウントがBANされた") 
		L_GP += 5
	;1凸効果：敵にデバフがある場合、その種類の数によってスキルゲージUP
	IF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG,"アカウントがBANされた") && (GET_RPG_CFLAG_TAKEOVER(ARG, "星魂") > 0)
		LOCAL:1 = 0
		FOR LOCAL,0,6
			SIF CFLAG:L_T:(GET_BATTLESTATUS(LOCAL) + "강화") < 0
				LOCAL:1++
		NEXT
		L_GP += MIN((LOCAL:1), 5) * 7
	ENDIF
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += 15
CALL SKILLGAGE_F_SET,ARG ,PU_SKILLNUM_GET(ARG,"アカウントがBANされた"), MIN(L_GP + SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"アカウントがBANされた")), 110)
IF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"アカウントがBANされた")) >= 55
	RESULTS = ＵＬＴＩＭＡＴＥ ＲＥＡＤＹ！
ELSE
	RESULTS = ＥＰ
ENDIF
RESULTS:1 = %" "%
RETURN L_GP

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_アカウントがBANされた,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
CALL PU_SKILLGAGE_F_SET,ARG,"アカウントがBANされた",-55
CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "방어/마법효과", -32, "단체"
CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
IF (GET_RPG_CFLAG_TAKEOVER(ARG, "星魂") > 5)
	LOCAL:1 = 0
	FOR LOCAL,0,6
		SIF CFLAG:POS(ARG:1):(GET_BATTLESTATUS(LOCAL) + "강화") < 0
			LOCAL:1++
	NEXT
	FOR LOCAL,1,MIN(LOCAL:1,5)
		CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM
	NEXT
ENDIF
