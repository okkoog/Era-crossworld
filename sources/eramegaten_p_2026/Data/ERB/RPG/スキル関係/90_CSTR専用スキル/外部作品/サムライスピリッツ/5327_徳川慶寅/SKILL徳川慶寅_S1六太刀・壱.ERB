;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;
;修羅;弐の太刀・白百合　単体攻撃スキルを外すと発動。剣撃相性の大ダメージ。命中が高い
;====================================================
@SKILL_TRIGGER_ACTIONABLE_六太刀・壱, ARG, ARG:1
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"六太刀・壱")

;SIF !CFLAG:ARG:PT플래그
;	RETURN 0
;自分の行動じゃなければNG
SIF FLAG:행동순1 != ARG
	RETURN 0
SIF ARG == ARG:1
	RETURN 0
;SIF ARG != ARG:1
;	RETURN 0
SIF CFLAG:ARG:입력행동 < 1
	RETURN 0
;スキルじゃなければNG
;SIF CFLAG:(ARG:1):입력행동 < 1
;	RETURN 0
;攻撃スキルじゃなければNG
;RESULT = 1
;TRYCALLFORM SKILL_EFECT_{CFLAG:(ARG:1):입력행동}
;SIF RESULT != 1
;	RETURN 0
;単体攻撃じゃなければNG
SIF CFLAG:ARG:타겟 > 16 || CFLAG:ARG:타겟 < 1
	RETURN 0
;LOCAL = POS(CFLAG:ARG:타겟)
;SIF LOCAL < 0 || GET_STATE(CFLAG:LOCAL:상태이상) == "DYING"
;	RETURN 0
;SIF CFLAG:LOCAL:회피실패
;	RETURN 0
;当ててたらダメ
SIF GET_CREC_ACT(ARG, ARG:1, "HIT")
	RETURN 0
;外してなきゃダメ
SIF !GET_CREC_ACT(ARG, ARG:1, "AVOID")
	RETURN 0
CALL SKILLGAGE_H_SET(ARG,SKILL_NUM,2)
;RESULT:1 = CFLAG:ARG:타겟
RETURN 1, CPOS(ARG:1)

