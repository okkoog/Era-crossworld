;スキル名
@SKILL_NAME_岩崩しⅠ,ARG
IF FLAG:총공격중
	RESULTS = 野外生存
ELSE
	RESULTS = 바위 가르기 Ⅰ
ENDIF
;　명중
@SKILL_HITRATE_岩崩しⅠ, ARG
RETURN 100

;　威力
@SKILL_POWER_岩崩しⅠ, ARG
IF FLAG:총공격중
	RETURN 75
ELSE
	RETURN 120
ENDIF
;クリティカル率
;@SKILL_CRITICAL_RATE_岩崩しⅠ, ARG
;RETURN 5

@SKILL_CALC_BATTTLE_STATUS_岩崩しⅠ, ARGS, ARG, ARG:1
SIF ARG < 0
	RETURN 0
SELECTCASE ARGS
	;回復の魔法効果(影響大),마법위력(影響小)の2変数を置換する
	;攻撃のみ参照
	CASE "HEAL"
		RETURN MAXBASE:ARG:공격, MAXBASE:ARG:공격
ENDSELECT

;　최저공격횟수
@SKILL_MINATTACKNUMBER_岩崩しⅠ,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_岩崩しⅠ,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_岩崩しⅠ, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_岩崩しⅠ,ARG
RETURN 6

;　相性
@SKILL_TYPE_岩崩しⅠ,ARG
RETURN GET_TYPE_NUM("지변")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_岩崩しⅠ
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_岩崩しⅠ,ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_岩崩しⅠ,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_岩崩しⅠ,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_岩崩しⅠ,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_岩崩しⅠ,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

@SKILL_HEAL_TYPE_岩崩しⅠ, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("통상")

;속도보정
@SKILL_SPEED_岩崩しⅠ, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_岩崩しⅠ
RETURN 0

@継承不能_岩崩しⅠ
RETURN 2

;拡散攻撃用追加処理
@SKILL_SPREAD_岩崩しⅠ,ARG
RETURN 1

;====================================================
;トリガー発動条件
;====================================================
@SKILL_TRIGGER_ACTIONABLE_岩崩しⅠ,ARG,ARG:1
;自身の行動のみで判定
SIF FLAG:행동순1 != ARG
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
SIF !IS_PU_SKILL_入力行動(ARG, "岩崩しⅠ")
	RETURN 0
CALL SET_RPG_CFLAG_BTL, ARG, "岩崩しヒット数", GET_CREC_ACT_SUM(ARG, "적", "HIT")
SIF !GET_RPG_CFLAG_BTL(ARG, "岩崩しヒット数")
	RETURN 0
RETURN 1, CPOS(ARG)
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_岩崩しⅠ,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
IF FLAG:총공격중
	CALL HEAL_SINGLE,ARG,ARG,SKILL_NUM
ELSE
	CALL ATTACK_SKILL,ARG,ARG:1,SKILL_NUM;	単体攻撃
ENDIF
;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_岩崩しⅠ,ARG
PRINTL 적 1체와 그 주위의 적에게 지변 상성의 물리 소데미지를 준다.
PRINTL 공격이 성공했을 경우, 이하의 연동 효과가 발동한다.
PRINTL 「자신의 HP를 소위력으로 회복. 회복량은 공격력을 참조한다.」

@SKILL_EXPLAIN_TOOLTIP_岩崩しⅠ, ARG
RESULTS:0 = 적 1체와 그 주위의 적에게 지변 상성의 물리 소데미지를 준다.
RESULTS:1 = 공격이 성공했을 경우, 이하의 연동 효과가 발동한다.
RESULTS:2 = 「自身のＨＰを小威力で回復。回復量は攻撃力を参照する。」

;使用条件
@SKILL_SPECIAL_ACTIONABLE_岩崩しⅠ,ARG
RETURN 1

