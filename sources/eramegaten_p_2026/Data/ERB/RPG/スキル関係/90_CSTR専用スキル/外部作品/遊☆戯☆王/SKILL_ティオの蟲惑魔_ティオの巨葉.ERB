;ティオの蟲惑魔専用スキル。虚空斬波にPALYZE追加して射程Lにして消費+10
;スキル名
@SKILL_NAME_ティオの巨葉,ARG
RESULTS = 티오의 거엽

;　명중
@SKILL_HITRATE_ティオの巨葉, ARG
RETURN 100

;　威力
@SKILL_POWER_ティオの巨葉, ARG
RETURN 410

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ティオの巨葉,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ティオの巨葉,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ティオの巨葉, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ティオの巨葉,ARG
RETURN 45

;　相性
@SKILL_TYPE_ティオの巨葉,ARG
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ティオの巨葉
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ティオの巨葉,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ティオの巨葉,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ティオの巨葉,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ティオの巨葉,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ティオの巨葉,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_ティオの巨葉, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ティオの巨葉
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_ティオの巨葉
RETURN GET_SUCCESSION_NUM("검격")

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_ティオの巨葉,ARG
RETURN GET_STATE_NUM("PALYZE")

;추가효과상성
@SKILL_ADDTIONAL_TYPE_ティオの巨葉,ARG
RETURN GET_TYPE_NUM("신경")

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_ティオの巨葉,ARG
RETURN 15

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_ティオの巨葉,ARG
RETURN 95
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ティオの巨葉,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;全体攻撃
CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_ティオの巨葉,ARG
PRINTL 적 전체에 검격 속성의 특대 물리 데미지.
PRINTL 확률로 PALYZE 상태로 만든다. 후열 사용 가능.

@SKILL_EXPLAIN_TOOLTIP_ティオの巨葉, ARG
RESULTS:0 = 적 전체에 검격 속성의 특대 물리 데미지.
RESULTS:1 = 확률로 PALYZE 상태로 만든다. 후열 사용 가능.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ティオの巨葉,ARG
RETURN 1

