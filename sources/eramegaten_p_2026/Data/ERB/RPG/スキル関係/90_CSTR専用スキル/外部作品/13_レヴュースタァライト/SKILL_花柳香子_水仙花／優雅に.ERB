@SKILL_HITRATE_水仙花／優雅に, ARG
RETURN 90

;　威力
@SKILL_POWER_水仙花／優雅に, ARG
;レベルで威力激変
SIF ARG == -1
	RETURN 40
IF BASE:ARG:LV < 10
	RETURN 10
ELSEIF BASE:ARG:LV < 20
	RETURN 30
ELSEIF BASE:ARG:LV < 30
	RETURN 60
ELSEIF BASE:ARG:LV < 40
	RETURN 70
ELSEIF BASE:ARG:LV < 50
	RETURN 75
ELSEIF BASE:ARG:LV < 60
	RETURN 80
ELSEIF BASE:ARG:LV < 70
	RETURN 85
ELSEIF BASE:ARG:LV < 80
	RETURN 90
ELSE
	RETURN 95
ENDIF
;エラー避け
RETURN 1

