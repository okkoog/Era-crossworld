
;スキル名
@SKILL_NAME_【絶】,ARG = -1
IF ARG < 0 || !TFLAG:전투중
	RESULTS = 【絶】
ELSE
	RESULTS '= GET_SKILL_サンストーン_構え(ARG) + "【絶】"
ENDIF

;　명중
@SKILL_HITRATE_【絶】, ARG
RETURN 120

;　威力
@SKILL_POWER_【絶】, ARG
SIF ARG == -1
	RETURN 500
IF HAVE_PU_SKILL(ARG, "真実の手【右手】")
	IF GET_SKILL_サンストーン_構え(ARG) == "落日"
		RETURN 550
	ELSE
		RETURN 500
	ENDIF
ELSE
	IF GET_SKILL_サンストーン_構え(ARG) == "落日"
		RETURN 240
	ELSE
		RETURN 200
	ENDIF
ENDIF
@SKILL_CRITICAL_RATE_【絶】, ARG
IF ARG == -1
	RETURN 5
ELSE
	IF GET_SKILL_サンストーン_構え(ARG) == "焼光"
		RETURN 15
	ELSE
		RETURN 5
	ENDIF
ENDIF

;　최저공격횟수
@SKILL_MINATTACKNUMBER_【絶】,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_【絶】,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_【絶】, ARG
SIF GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 4
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_【絶】,ARG
IF ARG >= 0
	IF GET_RPG_CFLAG_BTL(ARG, "KFチャージスキル") < 4
		RESULTS = %"ＣＨ:4"%
		RETURN 0
	ELSE
		IF HAVE_PU_SKILL(ARG, "真実の手【右手】")
			RETURN 64
		ELSE
			RETURN 20
		ENDIF
	ENDIF
ELSE
	RETURN 15
ENDIF

;　相性
@SKILL_TYPE_【絶】,ARG
RETURN GET_TYPE_NUM("검격"), GET_TYPE_NUM("파마")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_【絶】
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

