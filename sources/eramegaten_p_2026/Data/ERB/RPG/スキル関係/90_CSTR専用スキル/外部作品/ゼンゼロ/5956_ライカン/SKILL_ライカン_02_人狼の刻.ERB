;スキル名
@SKILL_NAME_人狼の刻,ARG
RESULTS = 늑대인간의 시간

;　명중
@SKILL_HITRATE_人狼の刻, ARG
RETURN 90

;　威力
@SKILL_POWER_人狼の刻, ARG
SIF ARG < 0
	RETURN 180
CALL GET_SKILL_POWER_人狼の刻(GET_ROLE_CFLAG_TAKEOVER(ARG, "特殊スキルランク"))
RETURN RESULT

@GET_SKILL_POWER_人狼の刻, ARG, ARG:1 = -1
SELECTCASE ARG
	CASE 15
		RESULT = 505
	CASE 11 TO 14
		RESULT = 430 + (ARG - 10) * 15
	CASE 10
		RESULT = 430
	CASE 2 TO 9
		RESULT = 130 + 30 * ARG
	CASE 0, 1
		RESULT = 160
	CASEELSE
		RESULT = 0
ENDSELECT
SIF ARG:1 == -1
	RETURN RESULT
RETURN RESULT * GET_CHARGE_POWER_月下遊猟(ARG:1) / 100

