;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_KE_乱撃, ARG
	RESULTS = 乱撃

;　명중
@SKILL_HITRATE_KE_乱撃, ARG
RETURN 100

;　威力
@SKILL_POWER_KE_乱撃, ARG
RETURN 70

;　최저공격횟수
@SKILL_MINATTACKNUMBER_KE_乱撃, ARG
RETURN 3

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_KE_乱撃, ARG
RETURN 3

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_KE_乱撃, ARG
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 5
	RETURN 1
RETURN 3
;消費なし＝1

;　コストの量
@SKILL_COST_KE_乱撃, ARG
IF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 5
	RESULTS = %" 5ＴＰ"%
	RETURN 0
ENDIF
RETURN 5

;　相性
@SKILL_TYPE_KE_乱撃, ARG
RETURN GET_TYPE_NUM("검격")
;검격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_KE_乱撃
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_KE_乱撃, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_KE_乱撃, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_KE_乱撃, ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_KE_乱撃, ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_KE_乱撃, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_KE_乱撃, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_KE_乱撃
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_KE_乱撃, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#DIM SKILL_NUM

;ゲージ再回収できる様に起動前にTP5消費。
CALL SET_RPG_CFLAG_DUNGEON, ARG, "KE_TPゲージ", 5, "-="

CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM

@SKILL_PASSIVE_BTL_EFFECT_KE_乱撃, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	IF GROUPMATCH(ABL:L_TARGET:종족, 0, 31, 43)
		SELECTCASE ARGS
			CASE "ダメージ補正加算"
				IF IS_PU_SKILL_入力行動(L_P, "KE_乱撃")
					RESULTS = 인간특효
					RETURN 30
				ENDIF
		ENDSELECT
	ENDIF
ENDIF

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_KE_乱撃, ARG
PRINTL 
PRINTL 적 단체에 검격 속성의 인간 특공 공격을 가한다.
PRINTL 
PRINTL 늑대기사 아벤트의 스킬(CSTR 전용)

;使用条件
@SKILL_SPECIAL_ACTIONABLE_KE_乱撃, ARG
;ゲージが5以上のときのみ
SIF GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 5
	RETURN 0
RETURN 1

@SKILL_EXPLAIN_TOOLTIP_KE_乱撃, ARG
RESULTS:0 = 적 단체에 검격 속성의 인간 특공 공격을 가한다.
RESULTS:1 = TP消費 5
SIF ARG >= 0 && GET_RPG_CFLAG_DUNGEON(ARG, "KE_TPゲージ") < 5
	RESULTS:1 = %RESULTS:1%(不足)