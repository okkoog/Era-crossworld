;スキル名
@SKILL_NAME_ちょっとした壊滅のオトモ,ARG
RESULTS = 약간의 파멸 길동무

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ちょっとした壊滅のオトモ
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ちょっとした壊滅のオトモ,ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_ちょっとした壊滅のオトモ,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ちょっとした壊滅のオトモ,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ちょっとした壊滅のオトモ,ARG
RETURN GET_SKILL_EFFECT_NUM("상태변화")

;スキル変化？用ランク
@SKILL_RANK_ちょっとした壊滅のオトモ, ARG = -1
RETURN 3

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ちょっとした壊滅のオトモ, ARG = -1
RETURN 0

;====================================================
;発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号
;====================================================
@SKILL_TRIGGER_ACTIONABLE_ちょっとした壊滅のオトモ,ARG,ARG:1
#DIM DYNAMIC LCOUNT
SIF ARG != FLAG:행동순1
	RETURN 0
SIF ARG != ARG:1
	RETURN 0
SIF RAND:3
	RETURN 0
FOR LCOUNT, 1, 7
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	SIF POS(LCOUNT) == ARG
		CONTINUE
	SIF CFLAG:POS(LCOUNT):입력행동 < 0
		CONTINUE
	CALL GET_SKILL_PROP, "SKILL_DAMAGETYPE", CFLAG:POS(LCOUNT):입력행동,POS(LCOUNT)
	SIF !GROUPMATCH(GET_ダメージタイプ(RESULT), "物理", "魔法")
		CONTINUE
	RETURN 1, CPOS(ARG)
NEXT

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ちょっとした壊滅のオトモ,ARG,ARG:1,SKILL_NUM
#DIM DYNAMIC SKILL_NUM
#DIM DYNAMIC LCOUNT
FOR LCOUNT, 1, 7
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	SIF POS(LCOUNT) == ARG
		CONTINUE
	SIF CFLAG:POS(LCOUNT):입력행동 < 0
		CONTINUE	
	CALL GET_SKILL_PROP, "SKILL_DAMAGETYPE", CFLAG:POS(LCOUNT):입력행동, POS(LCOUNT)
	IF GET_ダメージタイプ(RESULT) ==  "物理"
		CALL SKILL_SET_カジャンダ, ARG, POS(LCOUNT), "공격", 4, "단체", "NOWAIT"
	ELSEIF GET_ダメージタイプ(RESULT) == "魔法"
		CALL SKILL_SET_カジャンダ, ARG, POS(LCOUNT), "마법위력", 4, "단체", "NOWAIT"
	ENDIF
NEXT
WAIT
;　説明文の表示
@SKILL_EXPLAIN_ちょっとした壊滅のオトモ,ARG
PRINTL 자동: 자신의 행동마다 일정 확률로 이하의 연동 효과가 발동한다.
PRINTL 　　　「미행동 아군이 사용할 예정인 스킬에 따라 공격력 혹은 마법 위력을 상승시킨다.」

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ちょっとした壊滅のオトモ,ARG
RETURN 0
