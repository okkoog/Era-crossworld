;　威力
@SKILL_POWER_アイシクルエデン, ARG
SIF ARG < 0
	RETURN 200
SIF !TFLAG:전투중
	RETURN 200
SELECTCASE 現HP割合(ARG)
	;ミヅチはHP60%を切らないとそもそも使わないけど念のため
	;HP100-61%	200 - 219
	CASE IS > 60
		RETURN 200 + 20 * (100 - 現HP割合(ARG)) / 40
	;HP60-41%	280 - 318
	CASE IS > 40
		RETURN 280 + 40 * (60 - 現HP割合(ARG)) / 20
	;HP40-21%	380 - 437
	CASE IS > 20
		RETURN 380 + 60 * (40 - 現HP割合(ARG)) / 20
	;HP20-1%	520 - 596
	CASEELSE	
		RETURN 520 + 80 * (20 - 現HP割合(ARG)) / 20
ENDSELECT

