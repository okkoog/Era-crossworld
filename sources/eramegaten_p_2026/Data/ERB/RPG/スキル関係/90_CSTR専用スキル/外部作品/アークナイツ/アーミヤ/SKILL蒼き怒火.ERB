;====================================================
;独自処理
;====================================================
;（予定）と付けられている方は仮置きの物。実際に採用されるかどうかはわからない。
@AUTO_PU_SKILL_蒼き怒火,ARG,ARGS,ARG:1,ARG:2
#DIM SKILL_RANK
#DIM SKILL_NUM
#DIM LAMMOUNT = 0
#DIM LCOUNT
#DIM L_USER
;ARG = 攻撃者
;ARGS （ダメージ↑、被ダメージ↑、命中↑、回避↑、魔威↑、魔効↑、etc…）といった感じの奴
;ARG:1 = 防御者
;文字列を参考にする都合上、どの文字列を使うか事前に定めておいた方がいいかも
;CSTR:ARG:100 = EXTRA勢出典作品、『アークナイツ』とでも書き込む（予定）
;CSTR:ARG:101 = EXTRA勢出典作品でどのキャラなのか、とりあえず『アーミヤ（前衛）』とでも書き込む（予定）
;CSTR:ARG:104 = 現在の霊格昇華の度合。 このスキルを習得している時点で空文字の可能性は低いが、念のためにの分岐を用意
;----------------------------------------------------------------------------------------------
;この効果は攻撃側がアーミヤでなくても効果が発揮されるので、一回検索する
L_USER = -1
FOR LCOUNT,0,CHARANUM
	;戦闘に参加してないorアーミヤでないなら飛ばす
	SIF CFLAG:LCOUNT:포지션 < 1 || CSTR:LCOUNT:101 != "アーミヤ（前衛）"
		CONTINUE
	SELECTCASE ARGS
		CASE "ダメージ↑"
			;ダメージ↑の場合、攻撃者と同PTでなければ飛ばす
			SIF CFLAG:ARG:PT플래그 != CFLAG:LCOUNT:PT플래그
				CONTINUE
		CASE "被ダメージ↓"
			;被ダメージ↓の場合、防御者と同PTでなければ飛ばす
			SIF CFLAG:(ARG:1):PT플래그 != CFLAG:LCOUNT:PT플래그
				CONTINUE
	ENDSELECT
	L_USER = LCOUNT
	BREAK
NEXT
;アーミヤが見つからない、専用技1が削除されている、蒼き怒火を習得していない場合は終了
SIF L_USER == -1 || !HAVE_SKILL(L_USER,[[스킬:전용기1]]) || !HAVE_PU_SKILL(L_USER,"蒼き怒火")
	RETURN 0
SKILL_NUM = [[스킬:전용기1]]
SELECTCASE ARGS
	CASE "ダメージ↑","被ダメージ↓"
		SELECTCASE CSTR:L_USER:104
			CASE ""
				LAMMOUNT = 4
			CASEELSE
				LAMMOUNT = 7
		ENDSELECT
		SIF SKILLGAGE_F_GET(L_USER,SKILL_NUM) < 0
			LAMMOUNT *= 2
		SIF ARGS == "被ダメージ↓"
			LAMMOUNT = 100 - LAMMOUNT
		RETURN LAMMOUNT
ENDSELECT
RETURN 0
