@SKILL_HITRATE_プラティーンランツェ, ARG
RETURN 100

;　威力
@SKILL_POWER_プラティーンランツェ, ARG

	SIF ARG == -1
		RETURN 200
	IF BASE:ARG:LV < 10
		RETURN 250
	ELSEIF BASE:ARG:LV < 20
		RETURN 275
	ELSEIF BASE:ARG:LV < 30
		RETURN 300
	ELSEIF BASE:ARG:LV < 40
		RETURN 350
	ELSEIF BASE:ARG:LV < 50
		RETURN 400
	ELSE
		RETURN 400
	ENDIF

