;スキル名
@SKILL_NAME_グロリアスストライザー, ARG
RESULTS = GLORIOUS STRIZER

;　명중
@SKILL_HITRATE_グロリアスストライザー, ARG
RETURN 200

;　威力
@SKILL_POWER_グロリアスストライザー, ARG
#DIM RGRN_F

RGRN_F = SKILLGAGE_F_GET(ARG, [[스킬:뇌격린]])

;コメントアウトにテンジアンお兄様降臨　別に参戦させようとして没った訳ではない
;用心堅固。アパシーマンのクードスは1200上限にする
;直前までアパシーで10000溜めれば……という軽慮浅謀は見逃さない
SIF EQUIP:ARG:악세서리 == GETNUM(ITEM, "무기력의부적") && RGRN_F > 1200
	RGRN_F = 1200

IF RGRN_F > 9999
	;最高値　一念通天、やってやれないことはない
	RETURN 800
ELSEIF RGRN_F > 8999
	;八色雷光
	RETURN 550
ELSEIF RGRN_F > 7999
	;焼灼拳とか風神撃とか　臥薪嘗胆、ここまで溜めれば実用に堪えるか
	RETURN 400
ELSEIF RGRN_F > 6999
	;지오다인
	RETURN 320
ELSEIF RGRN_F > 4999
	;지온가
	RETURN 225
ELSEIF RGRN_F > 2499
	;스파크볼트
	RETURN 180
ELSEIF RGRN_F > 1999
	;지오
	RETURN 130
ELSEIF RGRN_F > 1499
	;코우하/에이하
	RETURN 95
;クードス1000以上→
ELSEIF RGRN_F > 999
	;프린파　威力75。電子の謡精が歌い出してすぐでは大した効果にはなり得ない。残念無念
	RETURN 75
ELSEIF RGRN_F > 499
	;忠義シリーズの基礎値
	RETURN 56
ELSE
	RETURN 40
ENDIF

