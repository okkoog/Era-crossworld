;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_グロリアスストライザー, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "ATK"
		IF SKILLGAGE_F_GET(ARG, [[스킬:뇌격린]]) > 7999
			RETURN LIMIT(CFLAG:ARG:공격강화 + CFLAG:ARG:마법위력강화, -48, 64), 32
		ELSE
			RETURN 0
		ENDIF
ENDSELECT

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_グロリアスストライザー, ARG, ARG:1, SKILL_NUM
#LOCALSIZE 4
#LOCALSSIZE 1
#DIM SKILL_NUM
#DIM RGRN_F
#DIM ボス殺したフラグ

RGRN_F = SKILLGAGE_F_GET(ARG, [[스킬:뇌격린]])
LOCAL:2 = POS(ARG:1)
CALL ATTACK_SINGLE, ARG, LOCAL:2, SKILL_NUM
;鴉雀無声。謡精の歌唱はここで終わり
CALL SKILLGAGE_F_SET, ARG, [[스킬:SONG OF DIVA]], 0
;金科玉条。クードスは没収させてもらう
SIF SKILLGAGE_F_GET(ARG, [[스킬:뇌격린]]) > 0
	PRINTFORML ＞%CALLNAME:ARG%의 쿠도스가 리셋되었다!
CALL SKILLGAGE_F_SET, ARG, [[스킬:뇌격린]], 0

LOCAL = RAND:4
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정") && LOCAL == 0
ELSE
	;規則厳守。SP3消費=ゲージDを12加算
	CALL SKILLGAGE_D_ADD, ARG, [[스킬:뇌격린]], 12
ENDIF

CALL SKILLGAGE_D_SET, ARG, SKILL_NUM, 4
;====================================================
;実行内容ここまで
;====================================================

;　説明文の表示
@SKILL_EXPLAIN_グロリアスストライザー, ARG
PRINTFORML 뇌검의 진정한 힘을 해방하여 궁극의 일격을 날리는 %CALLNAME:ARG%의 SP스킬.
PRINTL 　
PRINTL 적 단체에게 검격과 전격과 만능 복합 속성으로 데미지를 준다. 후열 사용 불가.
PRINTL 위력은 현재 쿠도스에 따라 상승한다.
PRINTL 또한, 물리 공격이지만 데미지 계산은 마법위력을 사용한다.
PRINTL 단, 사용 후에는 쿠도스가 0이 되며, 재사용까지 4턴의 쿨타임이 필요하다.
PRINTL MP와는 별개로 SP를 3 소비한다.
PRINTL ※SP는 4턴마다 1 회복되며, 전투 종료 후에 완전 회복된다.
PRINTL ※스킬「뇌격린」을 소지하지 않은 경우 사용 불가.
;スーパーガンヴォルトはストライザー使わないのでSONG OF DIVA中の強化は特になし
;流石にコイツにクードス消費回避は与えられない
IF ARG >=0 && IS_CHARA_EQUIPED(ARG, "벽색의뇌정")
	SETCOLOR 0x144ff4
	PRINTL 번개의 렌즈 장비 중 25% 확률로 SP 소비를 회피
	RESETCOLOR
ENDIF

;使用条件
@SKILL_SPECIAL_ACTIONABLE_グロリアスストライザー, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG, "グロリアスストライザー")
SIF SKILLGAGE_D_GET(ARG, SKILL_NUM)
	RETURN 0
SIF !HAVE_SKILL(ARG, [[스킬:뇌격린]])
	RETURN 0
SIF SKILLGAGE_D_GET(ARG, [[스킬:뇌격린]]) != 0
	RETURN 0
RETURN 1

