;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_黒服の男たち,ARG,ARG:1
;IF ARG:1 != ARG
;行動者が自分以外
IF FLAG:행동순1 != ARG
	;最初の一回だけ相性判定保存領域をリセットする
	SIF TFLAG:스킬트리거용1++ == 0
		CALL SKILLGAGE_F_SET, ARG, PU_SKILLNUM_GET(ARG,"黒服の男たち"), 0
	;起動してないなら死
	SIF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")) < 1
		RETURN 0
	;行動者と味方同士でなければ死
	SIF !IS_FRIEND(FLAG:행동순1, ARG)
		RETURN 0
	;対象と敵同士でなければ死
	SIF IS_FRIEND(ARG, ARG:1)
		RETURN 0
	;ダメージ与えてないなら死
	SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "HIT")
		RETURN 0
	;スキルの威力を保存する
	CALL GET_SKILL_PROP, "SKILL_POWER", CFLAG:(FLAG:행동순1):입력행동, FLAG:행동순1
	CALL SKILLGAGE_H_SET, ARG, PU_SKILLNUM_GET(ARG,"黒服の男たち"), RESULT
	;弱点攻撃を与えてたかどうかと被弾回数を10進BITでいれていく
	SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "WEAK") && CFLAG:(ARG:1):PT플래그 == 0
		CALL SKILLGAGE_F_ADD, ARG, PU_SKILLNUM_GET(ARG,"黒服の男たち"), MIN(CFLAG:(ARG:1):피탄횟수, 9) * POWER(10, CPOS(ARG:1) - 7)
	RETURN 1, CPOS(ARG:1)
	;ダメージ与えてないなら死
	;SIF !GETBIT(CFLAG:POS(CFLAG:(ARG:1):타겟):受けフラグ,20)
	;	RETURN 0
	;死んでるなら死
	;SIF GET_STATE(CFLAG:POS(CFLAG:(ARG:1):타겟):상태이상) == "DYING"
	;	RETURN 0
	;ここまで来たら攻撃準備
	;RESULT:1 = POS(CFLAG:(ARG:1):타겟)
	;スキル起動中、対象が味方の攻撃でダメージ受けてるならCOOP
	;RETURN 1
;ELSEIF ARG == ARG:1
ELSE
	;起動してたら死
	SIF SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"))
		RETURN 0
	;通常モード転落直後は死
	SIF CFLAG:ARG:입력행동 == PU_SKILLNUM_GET(ARG,"公式かつ機密")
		RETURN 0
	;敵は発動しない
	SIF CFLAG:ARG:PT플래그 == 0
		RETURN 0
	;判定対象が自分自身(=判定数を一回のみにする)
	SIF ARG != ARG:1
		RETURN 0
	;NP中でなく、O&C以外の自分の行動直後ならば発動
	RETURN 1
	;RETURN 1
ENDIF

;弱点COOPが発生していない敵に対して弱点COOPを発生させたのと同等のCOOP基礎威力を与える(ただし効果量は解析度%に減少する)
;COOPフラグは(スキル威力*100%(弱点) + スキル威力*50%(クリティカル)) * ヒット回数
;ここでは威力と回数を保存しておいて擬似的にCOOP威力を算出
;条件付きで威力が変動する技までは拾いきれないけどまぁしゃーなし
@SKILL_DAMAGE_EFFECT_黒服の男たち, ARG, ARG:1, ARG:2
#DIM L_T
#DIM L_HIT
#DIM L_威力
L_T = ARG:1
;---- EDIT P 001 MOD START -------------------------
;固定で50(通常攻撃のクリティカル相当に変更。とりあえず現行式の場合、レベル補正の下駄がはいるのでこれでも火力は十分以上出る)
;L_HIT = SKILLGAGE_F_GET(ARG, PU_SKILLNUM_GET(ARG,"黒服の男たち"))
;L_HIT = L_HIT / POWER(10, CPOS(ARG:1)-7)
;L_HIT = L_HIT % 10
;L_威力 = SKILLGAGE_H_GET(ARG,PU_SKILLNUM_GET(ARG,"黒服の男たち")) * FLAG:(20000+NO:L_T) / 1000
;CFLAG:L_T:ＣＯＯＰ플래그 += L_威力 * L_HIT
IF ANALYSIS_RATE:(NO:L_T) >= ANALYSIS_COMPLETED
	CFLAG:L_T:ＣＯＯＰ플래그 +=  50
	PRINTFORM %TSTR:스킬메시지대상%%TSTR:스킬메시지화살표%DEVIL CO-OP 세트!
ENDIF
;---- EDIT P 001 MOD END ---------------------------
;旧仕様。対象のCOOP基礎威力を解析度の2乗/2000(最大500)に上書きする。(CALLのほうはCRTフラグを0ビット目しか立ててないので、1ビット(相性),2ビット(クリティカル)どっちにもひっかかってなかった
;→追撃元の攻撃でCOOPが出ていた場合、解析度・スキル威力・クリティカル次第でむしろ威力が下がるケースがあったり、元威力が低い技に対して相当高く効果がでてしまうという問題があったので修正
;CFLAG:L_T:ＣＯＯＰ플래그 = FLAG:(20000+NO:L_T) * FLAG:(20000+NO:L_T) / 2000
;CALL BTL_CALC_DAMAGE_COOP(ARG, L_T, 1, 18, 1, 1, FLAG:(20000+NO:L_T) * FLAG:(20000+NO:L_T) / 2000)

