;====================================================
;トリガー発動条件
;====================================================
@SKILL_TRIGGER_ACTIONABLE_呪うわよ,ARG,ARG:1
;自身の行動のみ
IF FLAG:행동순1 == ARG
	CALL CHECK_SKILL_TAG, ARG, CFLAG:ARG:입력행동, "チグサ_ボンガ"
	RESULTS '= "呪うわよ"
	SIF !RESULT
		RETURN 0
	SIF CFLAG:ARG:타겟 != CPOS(ARG:1)
		RETURN 0
	;物理攻撃を与えている
	SIF !GET_CREC_ACT(ARG, ARG:1, "HIT")
		RETURN 0
	RETURN 1, CPOS(ARG:1)
ELSE
	SIF ARG:1 != FLAG:행동순1
		RETURN 0
	SIF PU_SKILLGAGE_F_GET(ARG, "呪うわよ") <= 0
		RETURN 0
	SIF PU_SKILLGAGE_H_GET(ARG, "呪うわよ") != CFLAG:(FLAG:행동순1):실제가입시간
		RETURN 0
	RETURN 1, CPOS(FLAG:행동순1)
ENDIF

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_呪うわよ,ARG,ARG:1,ARG:2
IF FLAG:행동순1 == ARG 
	CALL PU_SKILLGAGE_F_SET, ARG, "呪うわよ", 5
	CALL PU_SKILLGAGE_H_SET, ARG, "呪うわよ", CFLAG:POS(ARG:1):실제가입시간
	CALL PRINT_HIT_MESSAGE, POS(ARG:1), @"呪いの人形を付着！", "W"
ELSE
	CALL ATTACK_SKILL, ARG, ARG:1,ARG:2
	CALL PU_SKILLGAGE_F_ADD, ARG, "呪うわよ", -1
	SIF PU_SKILLGAGE_F_GET(ARG, "呪うわよ") == 0
		CALL PRINT_HIT_MESSAGE, POS(ARG:1), @"呪いの人形が消えさった", "W"
ENDIF

