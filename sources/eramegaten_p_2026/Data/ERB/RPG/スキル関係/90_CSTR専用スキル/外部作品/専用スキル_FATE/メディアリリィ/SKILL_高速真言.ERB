@SKILLGAGE_CHARGE_高速真言,ARG,ARG:1
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"高速真言")

;自分の行動の場合
IF ARG == ARG:1

	;高速真言使用でNPゲージが30上がる
	SIF CFLAG:ARG:입력행동 == 3907
		CALL SKILLGAGE_F_ADD,ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"),30
ELSE
ENDIF

;NPゲージが100以上だと100にする
SIF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")) > 100
	CALL SKILLGAGE_F_SET,ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"),100

