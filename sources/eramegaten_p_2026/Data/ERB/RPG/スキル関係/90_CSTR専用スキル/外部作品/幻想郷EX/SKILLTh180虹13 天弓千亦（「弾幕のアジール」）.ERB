;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_「弾幕のアジール」,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM アジールリキャスト
アジールリキャスト = PU_SKILLNUM_GET(ARG,"「弾幕のアジール」")

;デ・クンダ部分
IF CFLAG:(ARG):PT플래그 == 0
	LOCAL:2 = 7
	LOCAL:3 = 17
ELSE
	LOCAL:2 = 1
	LOCAL:3 = 7
ENDIF
FOR LOCAL,LOCAL:2,LOCAL:3
	SIF POS(LOCAL) < 0
		CONTINUE
	FOR LOCAL:1,0,6
		CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") = MAX(0, CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화"))
	NEXT
NEXT
PRINTFORML \@ CFLAG:ARG:PT플래그 > 0 ? 아군 # 적 \@의 ندا 효과를 떨쳐냈다!

;デ・カジャ部分
IF CFLAG:(ARG):PT플래그 == 0
	LOCAL:2 = 1
	LOCAL:3 = 7
ELSE
	LOCAL:2 = 7
	LOCAL:3 = 17
ENDIF
FOR LOCAL,LOCAL:2,LOCAL:3
	SIF POS(LOCAL) < 0
		CONTINUE
	FOR LOCAL:1,0,6
		CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") = MIN(0, CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화"))
	NEXT
NEXT
PRINTFORML \@ CFLAG:ARG:PT플래그 ? 적 # 아군 \@의 카자 효과를 지워버렸다!
LOCAL:7 = CFLAG:ARG:PT플래그 ? 1 # 7
LOCAL:8 = CFLAG:ARG:PT플래그 ? 7 # 17
FOR LOCAL:9, LOCAL:7, LOCAL:8
	LOCALS = 포지션{LOCAL:9}
	SIF FLAG:LOCALS < 0
		CONTINUE
	LOCAL = FLAG:LOCALS
	IF IS_BADSTATE(LOCAL, "DYING")
		PRINTFORML 　　TARGET:[{LOCAL:9,2}] %CALLNAME:(LOCAL),20,LEFT%　>>>>>>　숨을 되찾았다
		CFLAG:LOCAL:상태이상 = 0
		CFLAG:LOCAL:상태이상경과턴수 = 0
		CALL VAR_HP, (LOCAL), MAXBASE:(LOCAL):ＨＰ/4
	ENDIF
NEXT
WAIT

CALL SKILLGAGE_D_ADD,ARG,アジールリキャスト,4



;CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
;CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
;CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM;		拡散攻撃
