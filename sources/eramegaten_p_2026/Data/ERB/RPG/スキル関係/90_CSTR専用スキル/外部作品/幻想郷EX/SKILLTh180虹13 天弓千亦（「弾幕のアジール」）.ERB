	RESULTS += SET_COLOR_TAG(@"%"★", SKILL_EX_DISPLAY_LENS - 6, LEFT%Ready", "パ緑")
ELSE
	RESULTS += @"%"★", SKILL_EX_DISPLAY_LENS - 7, LEFT%%HTML_ESCAPE(@"<CT:{PU_SKILLGAGE_D_GET(ARG, "「弾幕のアジール」")}>")%"
