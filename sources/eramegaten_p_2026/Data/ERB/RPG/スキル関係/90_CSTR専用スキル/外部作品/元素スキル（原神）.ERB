;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_元素スキル（原神）,ARG,ARG:1
#DIM 元素スキル継続時間
元素スキル継続時間 = PU_SKILLNUM_GET(ARG,"元素スキル（原神）")
IF SKILL_CHANGE(ARG, [[キャラ:기묘한바르바토스]])
	RETURN 0
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한모라쿠스]])
	RETURN 0
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한바알]])
	;追撃はバアル・ブエルの二者
	SIF SKILLGAGE_D_GET(ARG,元素スキル継続時間) < 1
		RETURN 0
	SIF !IS_FRIEND(FLAG:행동순1, ARG)
		RETURN 0
	SIF IS_FRIEND(ARG, ARG:1)
		RETURN 0
	SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "HIT")
		RETURN 0
	RETURN 1, CPOS(ARG:1)
ELSEIF SKILL_CHANGE(ARG, [[キャラ:비묘한부에르]])
	;追撃はバアル・ブエルの二者
	SIF SKILLGAGE_D_GET(ARG,元素スキル継続時間) < 1
		RETURN 0
	SIF !IS_FRIEND(FLAG:행동순1, ARG)
		RETURN 0
	SIF IS_FRIEND(ARG, ARG:1)
		RETURN 0
	SIF !GET_CREC_ACT(FLAG:행동순1, ARG:1, "HIT")
		RETURN 0
	;追撃するトリガー攻撃は火炎・電撃・地変・水撃のいずれかでなければならない。スラッシュでor判定とか気配りの達人かよ作者
	SIF GET_CREC_ACT(FLAG:행동순1, ARG:1, "HIT", "화염/전격/지변/수격")
		RETURN 1, CPOS(ARG:1)
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한포칼로스]])
	;スキル効果中
	SIF SKILLGAGE_D_GET(ARG,元素スキル継続時間) == 0
		RETURN 0
	;攻撃者が自分である
	SIF FLAG:행동순1 != ARG
		RETURN 0
	;判定は1回
	SIF TFLAG:스킬트리거용1++
		RETURN 0
	;SIF ARG != ARG:1
	;	RETURN 0
	;プレイヤーサイドにターゲットを指定する
	IF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"通常攻撃（原神）")) == 1
		RETURN 1, CFLAG:ARG:PT플래그 ? 19 # 22
	ELSE
		;ターゲットが死んでいない状態で、単体には単体、範囲には範囲で追撃。
		IF CFLAG:ARG:타겟 < 17
			;SIF POS(CFLAG:ARG:타겟) < 0 || GET_STATE(CFLAG:POS(CFLAG:ARG:타겟):상태이상) == "DYING"
			;	RETURN 0
			CALL SKILLGAGE_H_SET,ARG,元素スキル継続時間,2
			RETURN 1, CFLAG:ARG:타겟
		ELSEIF CFLAG:ARG:타겟 < 20
			CALL SKILLGAGE_H_SET,ARG,元素スキル継続時間,3
			RETURN 1, CFLAG:ARG:타겟
		ELSE
			CALL SKILLGAGE_H_SET,ARG,元素スキル継続時間,3
			RETURN 1, 22
		ENDIF
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한하보림]])
	;スキル効果中
	SIF SKILLGAGE_D_GET(ARG,元素スキル継続時間) == 0
		RETURN 0
	;焚曜の輪状態である。
	SIF SKILLGAGE_F_GET(ARG,元素スキル継続時間) == 1
		RETURN 0
	;攻撃者が自分である
	SIF FLAG:행동순1 != ARG
		RETURN 0
	;判定は1回
	SIF TFLAG:스킬트리거용1++
		RETURN 0
	;ターゲットが死んでいない状態で、単体には単体、範囲には範囲で追撃。
	IF CFLAG:ARG:타겟 < 17
		;SIF POS(CFLAG:ARG:타겟) < 0 || GET_STATE(CFLAG:POS(CFLAG:ARG:타겟):상태이상) == "DYING"
		;	RETURN 0
		CALL SKILLGAGE_H_SET,ARG,元素スキル継続時間,2
		RETURN 1, CFLAG:ARG:타겟
	ELSEIF CFLAG:ARG:타겟 < 20
		CALL SKILLGAGE_H_SET,ARG,元素スキル継続時間,3
		RETURN 1, CFLAG:ARG:타겟
	ELSE
		CALL SKILLGAGE_H_SET,ARG,元素スキル継続時間,3
		RETURN 1, 22
	ENDIF
	
ELSE
	RETURN 0
ENDIF

