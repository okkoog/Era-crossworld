@SKILLGAGE_DISPLAY_元素スキル（原神）,ARG
#LOCALSSIZE 5
#DIM 元素スキル継続時間
#DIM 元素爆発制御変数
#DIM 文字列長
元素スキル継続時間 = PU_SKILLNUM_GET(ARG,"元素スキル（原神）")
元素爆発制御変数 = PU_SKILLNUM_GET(ARG,"元素爆発（原神）")
VARSET LOCALS
CALL SKILL_NAME_元素スキル（原神）,ARG
LOCALS:0 = %RESULTS%
CALL SKILL_NAME_元素爆発（原神）,ARG
LOCALS:1 = %RESULTS%
IF SKILL_CHANGE(ARG, [[キャラ:기묘한바르바토스]])
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한모라쿠스]])
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한바알]])
	LOCALS:2 = 雷罰悪曜の眼
    LOCALS:3 = 『夢想の一心』
    LOCALS:4 = 奥義・夢想真説
ELSEIF SKILL_CHANGE(ARG, [[キャラ:비묘한부에르]])
	LOCALS:2 = 蘊種印
    LOCALS:3 = 『摩耶の宮殿』
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한포칼로스]])
	IF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"通常攻撃（原神）")) == 1
		LOCALS:2 = 衆の水の歌い手
	ELSE
		LOCALS:2 = サロンメンバー
	ENDIF
    LOCALS:3 = 『もろびとこぞりて』
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한하보림]])
	IF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"元素スキル（原神）")) == 1
		LOCALS:2 = 双駆輪
	ELSE
		LOCALS:2 = 焚曜の輪
	ENDIF
    LOCALS:3 = 『死生の炉』
ENDIF
文字列長 = MAX(STRLENS(LOCALS:0),STRLENS(LOCALS:1),STRLENS(LOCALS:2),STRLENS(LOCALS:3),STRLENS(LOCALS:4))
SETCOLOR 0x999999
IF HAVE_PU_SKILL(ARG, "元素スキル（原神）")
	SIF LOCALS:2 != "" && SKILLGAGE_D_GET(ARG,元素スキル継続時間) >= 1
		PRINTFORML %LOCALS:2,文字列長,LEFT%　효과 시간　　　：{SKILLGAGE_D_GET(ARG,元素スキル継続時間)}턴
	CALL SKILL_NAME_元素スキル（原神）,ARG
	LOCALS = %RESULTS%
	SIF GET_RPG_CFLAG_BTL(ARG, "元素スキル再使用可能ターン") > FLAG:경과턴수
		PRINTFORML %LOCALS:0,文字列長,LEFT%　쿨타임　：{GET_RPG_CFLAG_BTL(ARG, "元素スキル再使用可能ターン") - FLAG:경과턴수}턴
ENDIF
IF HAVE_PU_SKILL(ARG, "元素爆発（原神）")
	;参照時に超過していた場合補正。
	SIF SKILLGAGE_F_GET(ARG,元素爆発制御変数) > GET_元素爆発_ゲージ上限(ARG)
	    CALL SKILLGAGE_F_SET,ARG,元素爆発制御変数,GET_元素爆発_ゲージ上限(ARG)
	;元素爆発効果中は継続ターン表示
	SIF LOCALS:3 != "" && SKILLGAGE_D_GET(ARG,元素爆発制御変数) >= 1
	    PRINTFORML %LOCALS:3,文字列長,LEFT%　효과 시간　　　：{SKILLGAGE_D_GET(ARG,元素爆発制御変数)}턴
	;元素爆発クールタイムはBTLCFLAGで制御。
	SIF GET_RPG_CFLAG_BTL(ARG, "元素爆発再使用可能ターン") > FLAG:경과턴수
	    PRINTFORML %LOCALS:1,文字列長,LEFT%　쿨타임　：{GET_RPG_CFLAG_BTL(ARG, "元素爆発再使用可能ターン") - FLAG:경과턴수}턴
	;元素エネルギー量を表示。チャージ完了時カラーで強調
	SIF SKILLGAGE_F_GET(ARG,元素爆発制御変数) == GET_元素爆発_ゲージ上限(ARG)
	    SETCOLOR 原神カラー(ARG)
	PRINTFORML %LOCALS:1,文字列長,LEFT%　원소 에너지：{SKILLGAGE_F_GET(ARG,元素爆発制御変数)}／{GET_元素爆発_ゲージ上限(ARG)}
	SETCOLOR 0x999999
	SIF SKILL_CHANGE(ARG, [[キャラ:기묘한바알]]) && SKILLGAGE_H_GET(ARG,元素爆発制御変数) > 0
	    PRINTFORML %LOCALS:4,文字列長,LEFT%　악요의 저주　　：{SKILLGAGE_H_GET(ARG,元素爆発制御変数)}／2
ENDIF
RESETCOLOR

