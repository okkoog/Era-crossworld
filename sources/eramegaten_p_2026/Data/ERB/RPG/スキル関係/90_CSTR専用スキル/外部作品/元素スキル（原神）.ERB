@ACTION_元素スキル（原神）,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#LOCALSIZE 4
#DIM 元素スキル継続時間
元素スキル継続時間 = PU_SKILLNUM_GET(ARG,"元素スキル（原神）")

IF SKILL_CHANGE(ARG, [[キャラ:기묘한바르바토스]])
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
	CALL SET_RPG_CFLAG_BTL, ARG, "元素スキル再使用可能ターン", (FLAG:경과턴수 + 4), "="
	CALL SKILL_SET_カジャンダ, ARG, ARG, "命中_回避", 8, "단체", "NOWAIT"
	;CFLAG:ARG:명중강화 = MIN(32, CFLAG:ARG:명중강화 + 8)
	;CFLAG:ARG:회피강화 = MIN(32, CFLAG:ARG:회피강화 + 8)
	;PRINTFORML %CALLNAME:ARG% の命中・回避が大幅にアップ！
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한모라쿠스]])
;	;反撃行動中は反撃するだけ。
;	IF FLAG:카운터중 == 1
;		CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
;		;玉璋シールド　反撃判定リセット
;		CALL SKILLGAGE_H_SET,ARG,元素スキル継続時間,0
;	ELSE
	IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 1
		CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM;		拡散攻撃
	ELSE
		CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
	ENDIF
		CALL SET_RPG_CFLAG_BTL, ARG, "元素スキル再使用可能ターン", (FLAG:경과턴수 + 4), "="
		CALL SKILL_SET_HPバリア, ARG, MAXBASE:ARG:ＨＰ / 5 , "『玉璋シールド』"
;	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한바알]])
	;トリガー追撃中は攻撃するだけ
	IF FLAG:총공격중 == 1
		;単体攻撃
		IF ARG:1 < 17
			CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
		ELSE
			CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
		ENDIF
		;雷罰悪曜の眼　連携内容リセット
		CALL SKILLGAGE_H_SET,ARG,元素スキル継続時間,0
	ELSE
		CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
		CALL SKILLGAGE_D_SET,ARG,元素スキル継続時間,5
		CALL SET_RPG_CFLAG_BTL, ARG, "元素スキル再使用可能ターン", (FLAG:경과턴수 + 3), "="
		;PRINTL 『雷罰悪曜の眼』　起動！
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:비묘한부에르]])
	;トリガー追撃中は攻撃するだけ
	IF FLAG:총공격중 == 1
		;単体攻撃
		IF ARG:1 < 17
			CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
		ELSE
			CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
		ENDIF
		CALL SKILLGAGE_H_SET,ARG,元素スキル継続時間,0
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
		CALL SKILLGAGE_D_SET,ARG,元素スキル継続時間,6
		CALL SET_RPG_CFLAG_BTL, ARG, "元素スキル再使用可能ターン", (FLAG:경과턴수 + 3), "="
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한포칼로스]])
	;トリガー追撃中はプネウマ：回復、ウーシア：攻撃
	IF FLAG:총공격중 == 1
		IF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"通常攻撃（原神）")) == 1
			CALL HEAL_FIELD,ARG,ARG:1,SKILL_NUM		;範囲回復(列、全体)
		ELSE
			;単体攻撃
			IF ARG:1 < 17
				CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
			ELSE
				CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
			ENDIF
			;連携内容リセット
			CALL SKILLGAGE_H_SET,ARG,元素スキル継続時間,0
		ENDIF
	ELSE
		CALL SKILLGAGE_D_SET,ARG,元素スキル継続時間,6
		CALL SET_RPG_CFLAG_BTL, ARG, "元素スキル再使用可能ターン", (FLAG:경과턴수 + 3), "="
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한하보림]])
	;トリガー追撃中は攻撃するだけ
	IF FLAG:총공격중 == 1
		;単体攻撃
		IF ARG:1 < 17
			CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
		ELSE
			CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
		ENDIF
		CALL SKILLGAGE_H_SET,ARG,元素スキル継続時間,0
	ELSE
		CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
		;命ノ星座２重、対象防御ダウン
		SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 2
			CALL SKILL_SET_カジャンダ, ARG, POS(ARG:1), "방어", -4, "단체"
		CALL SKILLGAGE_D_SET,ARG,元素スキル継続時間,5
		;星座６重の場合１ターン追加
		SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 6
			CALL SKILLGAGE_D_SET,ARG,元素スキル継続時間,6
		CALL SET_RPG_CFLAG_BTL, ARG, "元素スキル再使用可能ターン", (FLAG:경과턴수 + 3), "="
		;命ノ星座１重、自己攻撃アップ
		SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 1
			CALL SKILL_SET_カジャンダ, ARG, ARG, "공격", 4, "단체"
	ENDIF
ENDIF



