		ENDIF
		IF PU_SKILLGAGE_D_GET(ARG, "元素スキル（原神）")
			BAR_COLOR = BARCOLORSET("赤"), RESULT:1
			EFFECT_TURN = NO:ARG == [[キャラ:기묘한바알]] ? 4 # 5
			RESULTS += GET_GENSHIN_SKILL_ICON(ARG, "元素スキル（原神）", "ACT")
			RESULTS += HTML_RECT_SPLIT_BAR(PU_SKILLGAGE_D_GET(ARG, "元素スキル（原神）"), EFFECT_TURN, BAR_LENS:1 - 2, BAR_COLOR, BAR_COLOR:1)
		ELSE
			RESULTS += " " * BAR_LENS:1
		ENDIF
		RESULTS:1 = 원소전투 스킬
	CASEELSE
		IF HAVE_PU_SKILL(ARG, "元素スキル（原神）")
			IF GET_RPG_CFLAG_BTL(ARG, "元素スキル再使用可能ターン") > FLAG:경과턴수
				L_RESULTS:0 = %GET_GENSHIN_SKILL_ICON(ARG, "元素スキル（原神）", "STAND")%
				L_RESULTS:0 += " " * (BAR_LENS - 8)
				L_RESULTS:0 += HTML_ESCAPE(@"<CT:{GET_RPG_CFLAG_BTL(ARG, "元素スキル再使用可能ターン") - FLAG:경과턴수}>")
			ELSE
				L_RESULTS:0 = %GET_GENSHIN_SKILL_ICON(ARG, "元素スキル（原神）", "ACT")%
				L_RESULTS:0 +=  " " * (BAR_LENS - 8) + SET_COLOR_TAG("Ready", "パ緑") +  " "
			ENDIF
		ENDIF
		IF HAVE_PU_SKILL(ARG, "元素爆発（原神）")
			IF PU_SKILLGAGE_F_GET(ARG, "元素爆発（原神）") >= GET_元素爆発_ゲージ上限(ARG)
				IF GET_RPG_CFLAG_BTL(ARG, "元素爆発再使用可能ターン") > FLAG:경과턴수
					L_RESULTS:1 += GET_GENSHIN_SKILL_ICON(ARG, "元素爆発（原神）", "STAND")
					L_RESULTS:1 += " " * (BAR_LENS:1 - 8)
					L_RESULTS:1 += HTML_ESCAPE(@"<CT:{GET_RPG_CFLAG_BTL(ARG, "元素爆発再使用可能ターン") - FLAG:경과턴수}>")
				ELSE
					L_RESULTS:1 += GET_GENSHIN_SKILL_ICON(ARG, "元素爆発（原神）", "ACT")
					L_RESULTS:1 +=  " " * (BAR_LENS:1 - 8) + SET_COLOR_TAG("Ready", TOSTR(原神カラー(ARG))) +  " "
				ENDIF
			ELSE
				BAR_COLOR = BARCOLORSET("緑"), RESULT:1
				IF GET_RPG_CFLAG_BTL(ARG, "元素爆発再使用可能ターン") > FLAG:경과턴수
					L_RESULTS:1 += GET_GENSHIN_SKILL_ICON(ARG, "元素爆発（原神）", "STAND")
				ELSE
					L_RESULTS:1 += GET_GENSHIN_SKILL_ICON(ARG, "元素爆発（原神）", "ACT")
				ENDIF
				L_RESULTS:1 += HTML_RECT_BAR(PU_SKILLGAGE_F_GET(ARG, "元素爆発（原神）"), GET_元素爆発_ゲージ上限(ARG), BAR_LENS:1 - 2, BAR_COLOR, BAR_COLOR:1)
			ENDIF
			L_RESULTS:1 '= SET_BUTTON_TAG(L_RESULTS:1, ARGS, "元素爆発")
		ELSE
			L_RESULTS:0 += " " * BAR_LENS:1
		ENDIF
		IF !HAVE_PU_SKILL(ARG, "元素スキル（原神）")
			L_RESULTS:1 += " " * BAR_LENS
		ELSE
			L_RESULTS:0 '= SET_BUTTON_TAG(L_RESULTS:0, ARGS, "元素スキル")
		ENDIF
		RESULTS '= L_RESULTS:0 + L_RESULTS:1
ENDSELECT
RETURN 1
