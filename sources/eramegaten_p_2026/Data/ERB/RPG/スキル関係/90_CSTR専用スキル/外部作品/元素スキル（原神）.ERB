;====================================================
;実行内容ここまで
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_元素スキル（原神）, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM 元素スキル継続時間
#DIM 元素爆発制御変数
#DIM ブースト量
元素スキル継続時間 = PU_SKILLNUM_GET(L_P,"元素スキル（原神）")
元素爆発制御変数 = PU_SKILLNUM_GET(L_P,"元素爆発（原神）")

ブースト量 = 0

;自分が攻撃側
IF L_P == L_ACTOR
	IF SKILL_CHANGE(L_P, [[キャラ:기묘한바르바토스]])
		;奇妙なバルバトス４重　かつ元素スキルクールタイム中、物理与ダメージ量アップ
		IF GET_RPG_CFLAG_BTL(L_P, "元素スキル再使用可能ターン") > FLAG:경과턴수 && GET_RPG_CFLAG_TAKEOVER(L_P, "命の星座") >= 4
			SELECTCASE ARGS
				CASE "ダメージ補正加算"
				SIF L_ダメージタイプ == "物理"
					RETURN 20
			ENDSELECT
		ENDIF
	ELSEIF SKILL_CHANGE(L_P, [[キャラ:비묘한부에르]])
		SELECTCASE ARGS
			CASE "ダメージ補正加算"
				;奇妙なブエル４重　『蘊種印』状態中のダメージ量アップ
				SIF GET_RPG_CFLAG_TAKEOVER(L_P, "命の星座") >= 4 && SKILLGAGE_H_GET(L_P,元素スキル継続時間) > 0
					ブースト量 += 20
				;ブエル　GOODでない敵へのダメージ量＋３０％　爆発中は５０
				IF FLAG:총공격중 == 1 
					IF !IS_BADSTATE(L_TARGET, "GOOD")
						RESULTS = BS特効
						ブースト量 += 30
						;元素爆発中の加算
						IF SKILLGAGE_D_GET(L_P,元素爆発制御変数) > 0
							ブースト量 += 20
							;奇妙なブエル５重　元素爆発による加算量を更にUP
							SIF GET_RPG_CFLAG_TAKEOVER(L_P, "命の星座") >= 5
								ブースト量 += 20
						ENDIF
					ENDIF
				ENDIF
				RETURN ブースト量
		ENDSELECT
	ENDIF
ENDIF
RETURN 0


