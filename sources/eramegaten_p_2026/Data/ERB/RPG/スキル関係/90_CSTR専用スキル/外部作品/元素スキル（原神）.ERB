;スキル名　元素スキル（原神）。基本となる補助効果と、メインの攻撃を兼ねる中リキャストのスキル

@SKILL_NAME_元素スキル（原神）,ARG
#DIM 元素スキル継続時間
元素スキル継続時間 = PU_SKILLNUM_GET(ARG,"元素スキル（原神）")
IF SKILL_CHANGE(ARG, [[キャラ:기묘한바르바토스]])
	RESULTS = 고천의 노래
;ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한모라쿠스]]) && && FLAG:카운터중 == 1
;	RESULTS = 玉璋シールド　반격
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한모라쿠스]])
	RESULTS = 地心
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한바알]]) && FLAG:총공격중 == 1
	RESULTS = 뇌벌 악요의 눈 연계 공격
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한바알]])
	RESULTS = 神変・悪曜開眼
ELSEIF SKILL_CHANGE(ARG, [[キャラ:비묘한부에르]]) && FLAG:총공격중 == 1
	RESULTS = 所聞遍計　滅浄三業
ELSEIF SKILL_CHANGE(ARG, [[キャラ:비묘한부에르]])
	RESULTS = 所聞遍計
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한포칼로스]]) && FLAG:총공격중 == 1
	IF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"通常攻撃（原神）")) == 1
		;1はプネウマ時
		RESULTS = 뭇 물의 가수 연계 회복
	ELSE
		RESULTS = 살롱 멤버 연계 공격
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한포칼로스]])
	RESULTS = 살롱 솔리테어
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한하보림]]) && FLAG:총공격중 == 1
		RESULTS = 제화무장 분요의 고리
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한하보림]])
		RESULTS = 이름을 칭송하는 시각
ELSE
	RESULTS = 원소전투 스킬 (원신)
ENDIF

;　명중
@SKILL_HITRATE_元素スキル（原神）, ARG
RETURN 120

;　威力
@SKILL_POWER_元素スキル（原神）, ARG
#DIM 元素スキル継続時間
#DIM 元素爆発制御変数
#DIM 基礎ダメージ
元素スキル継続時間 = PU_SKILLNUM_GET(ARG,"元素スキル（原神）")
元素爆発制御変数 = PU_SKILLNUM_GET(ARG,"元素爆発（原神）")

基礎ダメージ = 0

IF SKILL_CHANGE(ARG, [[キャラ:기묘한바르바토스]])
	;奇妙なバルバトス５重　ダメージ量アップ
	IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 5
		RETURN 300
	ELSE
		RETURN 250
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한모라쿠스]])
;	IF ARG > -1
;		SIF SKILLGAGE_H_GET(ARG,元素スキル継続時間) == 1
;			RETURN 50
;	ENDIF
	;奇妙なモラクス３重　ダメージ量アップ
	IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 3
		RETURN 300
	ELSE
		RETURN 250
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한바알]])
	;追撃・雷罰悪曜の眼　連携攻撃
	IF FLAG:총공격중 == 1
		IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 5
			RETURN 100
		ELSE
			RETURN 80
		ENDIF
	ENDIF
	;神変・悪曜開眼
	;奇妙なバアル３重　ダメージ量アップ
	IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 5
		RETURN 300
	ELSE
		RETURN 250
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:비묘한부에르]])
	;追撃・滅浄三業
	IF FLAG:총공격중 == 1
		;ベース70
		基礎ダメージ = 70
		;元素爆発中は追撃威力がアップ
		IF SKILLGAGE_D_GET(ARG,元素爆発制御変数) > 0
			基礎ダメージ += 40
			;奇妙なブエル１重　元素爆発による加算量UP
			SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 1
				基礎ダメージ += 20
			;奇妙なブエル５重　元素爆発による加算量更にUP
			SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 5
				基礎ダメージ += 20
		ENDIF
		;奇妙なブエル３重　滅浄三業ダメージ量アップ
		SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 3
				基礎ダメージ += 30
		;奇妙なブエル２重　滅浄三業が20%で1.5倍
		SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 2 && RAND:5 == 0
				基礎ダメージ += (基礎ダメージ / 2)
		RETURN 基礎ダメージ
	ENDIF
	;所聞遍計
	;奇妙なブエル３重　ダメージ量アップ
	SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 3
		RETURN 260
	RETURN 220
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한포칼로스]])
	IF FLAG:총공격중 == 1
		;衆の水の歌い手、回復
		IF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"通常攻撃（原神）")) == 1
			IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 5
					RETURN 240
				ELSE
					RETURN 200
			ENDIF
		;サロンメンバー・追撃
	ELSE
			IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 5
					RETURN 160
				ELSE
					RETURN 120
			ENDIF
		ENDIF
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한하보림]])
	IF FLAG:총공격중 == 1
		;火炎追撃
		IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 5
				RETURN 120
		ELSE
				RETURN 100
		ENDIF
	ELSE
		;通常起動時
		IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 5
				RETURN 220
			ELSE
				RETURN 200
		ENDIF
	ENDIF
ELSE
	RETURN 200
ENDIF

