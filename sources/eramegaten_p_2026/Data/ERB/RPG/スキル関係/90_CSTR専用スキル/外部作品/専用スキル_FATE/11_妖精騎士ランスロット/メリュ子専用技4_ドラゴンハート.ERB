;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_ドラゴンハート, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;スキルゲージが未起動の場合、補正は発生しない
SIF SKILLGAGE_F_GET(L_P,SKILL_NUM) < 1
	RETURN 0
IF L_P == L_ACTOR
	SIF ARGS == "ダメージ補正加算"
		RETURN 40
ELSE
	;被弾時 and HPバリアが自身の最大HP10％ or 125ダメージ分のいずれか高い方の値未満の場合、即座に最大HP10％ or ダメージ125分のいずれか高い方のバリアを貼る
	SIF ARGS == "ダメージ倍率" && CFLAG:L_P:HP배리어 < MAX(MAXBASE:L_P:ＨＰ / 10,125) && !SKILLGAGE_D_GET(L_P,PU_SKILLNUM_GET(L_P,"竜炎励起"))
		CALL SKILL_SET_HPバリア,L_P,MAX(MAXBASE:L_P:ＨＰ / 10,125),"『ドラゴンハート』","非表示"
ENDIF
RETURN 0

;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_ドラゴンハート, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

SIF SKILLGAGE_F_GET(ARG,SKILL_NUM) < 1
	RETURN 0
SELECTCASE ARGS
	;基本の最大HPの30%の値が250を超えてるなら30%乗算、未満なら250加算
	CASE "HP補正"
		RESULTS = \@ MAXBASE:ARG:ＨＰ * 30 / 100 > 250 ? 乗算 # 加算 \@
		RETURN RESULTS == "乗算" ? 30 # 250
ENDSELECT
RETURN 0