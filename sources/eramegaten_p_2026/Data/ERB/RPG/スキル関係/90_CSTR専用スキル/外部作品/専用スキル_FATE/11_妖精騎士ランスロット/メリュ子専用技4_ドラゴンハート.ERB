;ターン終了時に行う処理
@SKILL_TURNEND_ドラゴンハート,ARG
#DIM SKILL_NUM
#DIM L_F_GAGE
#DIM L_WAIT
SKILL_NUM = PU_SKILLNUM_GET(ARG,"ドラゴンハート")
L_F_GAGE = SKILLGAGE_F_GET(ARG,SKILL_NUM)
SIF L_F_GAGE == 0
	RETURN 0
L_WAIT = 0
L_F_GAGE += L_F_GAGE > 0 ? -1 # 1
IF L_F_GAGE == 0 && SKILLGAGE_F_GET(ARG,SKILL_NUM) > 0
	PRINTFORML %CALLNAME:ARG%의 드래곤 하트 추가 효과가 종료되었다….
	L_F_GAGE = -3
	L_WAIT = 1
ENDIF
CALL SKILLGAGE_F_SET(ARG,SKILL_NUM,L_F_GAGE)
IF L_F_GAGE == -3
	CALL SYNC_STATUS,ARG
	CALL VAR_HP(ARG,0,"회복")
	SIF CSTR:ARG:HP배리어명 != "『ドラゴンハート』"
		RETURN 0
	CFLAG:ARG:HP배리어 = MIN(CFLAG:ARG:HP배리어,0)
	PRINTFORML 드래곤 하트의 피데미지 컷 효과가 해제되었다….
	L_WAIT = 1
ENDIF
SIF L_WAIT
	WAIT
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ドラゴンハート,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIMS L_STR

L_STR = \@ GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ") == 0 ? 기합 # 集中 \@
CFLAG:ARG:@"%L_STR%フラグ" = 1
PRINTFORML %CALLNAME:ARG%(은)는 다음 공격에 대비해 \@ L_STR == "기합" ? 힘을 모았다 # 집중하고 있다 \@!

IF SKILLGAGE_F_GET(ARG,SKILL_NUM) == 0
	PRINTFORML 또한 4턴 동안 주는 데미지 상승, 피데미지 컷, 최대 HP 증가!
	PRINTFORML %CALLNAME:ARG%의 NP 게이지가 30% 충전되었다!
	CALL SKILLGAGE_F_ADD,ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"),30
	CALL SKILLGAGE_F_SET,ARG,SKILL_NUM,4
	CALL SYNC_STATUS,ARG,"HPMP割合保持"
ENDIF
WAIT

;====================================================
;実行内容ここまで
;====================================================

