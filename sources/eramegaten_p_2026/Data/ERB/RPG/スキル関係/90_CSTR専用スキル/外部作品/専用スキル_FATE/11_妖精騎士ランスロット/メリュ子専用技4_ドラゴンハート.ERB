@DISPLAY_COMMAND_P_ドラゴンハート,ARG
IF PU_SKILLGAGE_F_GET(ARG, "ドラゴンハート") != 0
	IF PU_SKILLGAGE_F_GET(ARG, "ドラゴンハート") > 0
		RESULTS = 드래곤 하트:효과 종료
	ELSE
		RESULTS = 드래곤 하트:CT{ABS(PU_SKILLGAGE_F_GET(ARG,"ドラゴンハート"))}
	ENDIF
	RETURN 3
