;ガードスキル：ハンドソニック
;ある意味天使ちゃんのトレードマーク的な代表的なガードスキル
;高命中・高ＣＴでCO-OP起点にすれば多分最後まで使っていけないこともない筈
;
;威力80 ニ回攻撃＝実質威力120　命中140　クリティカル15

;スキル名
@SKILL_NAME_ＧＳ：ハンドソニック,ARG
RESULTS = GS: 핸드 소닉

;　명중
@SKILL_HITRATE_ＧＳ：ハンドソニック, ARG
RETURN 140

;　威力
@SKILL_POWER_ＧＳ：ハンドソニック, ARG
RETURN 60

;クリティカル率
@SKILL_CRITICAL_RATE_ＧＳ：ハンドソニック, ARG
RETURN 15

;　최저공격횟수
@SKILL_MINATTACKNUMBER_ＧＳ：ハンドソニック,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_ＧＳ：ハンドソニック,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_ＧＳ：ハンドソニック, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_ＧＳ：ハンドソニック,ARG
RETURN 4

;　相性
@SKILL_TYPE_ＧＳ：ハンドソニック,ARG
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_ＧＳ：ハンドソニック
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_ＧＳ：ハンドソニック,ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_ＧＳ：ハンドソニック,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_ＧＳ：ハンドソニック,ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_ＧＳ：ハンドソニック,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_ＧＳ：ハンドソニック,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_ＧＳ：ハンドソニック, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_ＧＳ：ハンドソニック
RETURN 0

;계승타입
@SKILL_SUCCESSION_TYPE_ＧＳ：ハンドソニック
RETURN GET_SUCCESSION_NUM("검격")

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_ＧＳ：ハンドソニック,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

;範囲攻撃
CALL ATTACK_FIELD, ARG, ARG:1, SKILL_NUM

;　説明文の表示
@SKILL_EXPLAIN_ＧＳ：ハンドソニック,ARG
PRINTL 손등에 검을 출현시키는 가드 스킬.
PRINTL 
PRINTL 적 전열 1체에 검격 상성의 극소 데미지 2회 공격.
PRINTL 命中・크리티컬률이 높다。

@SKILL_EXPLAIN_TOOLTIP_ＧＳ：ハンドソニック, ARG
RESULTS:0 = 적 전열 1체에 검격 상성의 극소 데미지 2회 공격.
RESULTS:1 = 命中・크리티컬률이 높다。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_ＧＳ：ハンドソニック,ARG
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_ＧＳ：ハンドソニック, ARG = -1
RETURN 3
