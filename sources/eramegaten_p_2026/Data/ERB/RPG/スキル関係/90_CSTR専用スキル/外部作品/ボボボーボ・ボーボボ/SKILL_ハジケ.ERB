@SKILL_PASSIVE_PENETRATION_RANK_ハジケ, L_P, L_T, L_スキル, L_ダメージタイプ, L_攻撃タイプ, L_相性, GIVE_EFFECT_CHARA
#DIM DYNAMIC L_P;このスキルの所持者
#DIM DYNAMIC L_T;攻撃対象
#DIMS DYNAMIC L_スキル;スキルの所持者が敵に対して使用しているスキルの関数名称
#DIM DYNAMIC L_ダメージタイプ
#DIM DYNAMIC L_攻撃タイプ
#DIM DYNAMIC L_相性
#DIM DYNAMIC GIVE_EFFECT_CHARA;リーダースキル等他人からつけられている場合の提供者

SIF CFLAG:L_P:입력행동 == PU_SKILLNUM_GET(L_P,"ハジケ") && CFLAG:L_T:상태이상 > GET_STATE_NUM("GOOD")
	RETURN 4
RETURN 0

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_ハジケ, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM TOTAL_DMG_B

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
            LOCAL = 0
			IF CFLAG:L_P:입력행동 == PU_SKILLNUM_GET(L_P,"ハジケ")
                LOCAL += RAND:100 - 50
                SIF L_CRT
                    LOCAL += 75
				SIF GETBIT(SKILLGAGE_H_GET(L_P,PU_SKILLNUM_GET(L_P,"ハジケ")),0)
					LOCAL = 125
				CALL SKILLGAGE_H_SET, L_P, PU_SKILLNUM_GET(L_P,"ハジケ"), 0
            ENDIF
			RETURN LOCAL
	ENDSELECT
ENDIF

