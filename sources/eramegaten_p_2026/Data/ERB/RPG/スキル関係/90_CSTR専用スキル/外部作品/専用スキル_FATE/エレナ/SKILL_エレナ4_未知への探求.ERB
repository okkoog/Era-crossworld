@ACTION_未知への探求,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM SELECT_TYPE,3
#DIM LCOUNT
#DIM L_SELECT

SKILL_NUM = PU_SKILLNUM_GET(ARG,"미지에대한탐구")

PRINTL 어느 공격을 강화하겠습니까?
PRINTL
CALL INPUT_YN,"物理攻撃","魔法攻撃",2
;選択結果を確保
L_SELECT = RESULT
CFLAG:POS(ARG:1):@"他人%\@L_SELECT == 0 ? 기합 # 集中\@%フラグ" = 1

;追加効果のクールダウン終わってないなら効果処理まで飛ぶ
SIF SKILLGAGE_D_GET(ARG,SKILL_NUM) > 0
	GOTO START_LABEL

;メモ：相性強化の処理は恐らく他の鯖にも使えるかもしれないので、関数化するのを目指しておく
VARSET SELECT_TYPE,-1
;前回選択した相性が保存されてるなら取り出す
IF GET_RPG_CSTR_TAKEOVER(ARG,"S3相性確保") != ""
	FOR LCOUNT,0,3
		SELECT_TYPE:LCOUNT = GET_TYPE_NUM(AUTO_SPLIT(GET_RPG_CSTR_TAKEOVER(ARG,"S3相性確保"),"_",LCOUNT))
	NEXT
ENDIF
$SELECT_LOOP
PRINTL 강화할 속성을 선택하자.
DRAWLINE
FOR LCOUNT,0,17
	SETCOLOR COLOR(\@GROUPMATCH(LCOUNT,SELECT_TYPE:0,SELECT_TYPE:1,SELECT_TYPE:2) ? YELLOW # GRAY\@) 
	PRINTFORM  [{LCOUNT,2}] %GET_TYPE(LCOUNT)%
	RESETCOLOR
	SIF GROUPMATCH(LCOUNT,3,7,11,16)
		PRINTL
NEXT
DRAWLINE
;枠が空いているならグレー化
SIF MATCH(SELECT_TYPE,-1)
	SETCOLOR COLOR("GRAY")
PRINTFORML [ 99] 決定
RESETCOLOR
$INPUT_LOOP
INPUT
CLEARLINE 1
IF !INRANGE(RESULT,0,16) && RESULT != 99
	REUSELASTLINE 예상 밖의 수치입니다.
	GOTO INPUT_LOOP
ELSEIF RESULT == 99
	SIF MATCH(SELECT_TYPE,-1)
		GOTO INPUT_LOOP
	SIF !MATCH(SELECT_TYPE,-1)
		GOTO START_LABEL
ENDIF
;既に選択済みの相性を選んだ場合、選択済みの相性を解除する
LCOUNT = FINDELEMENT(SELECT_TYPE,RESULT)
IF LCOUNT > -1
	SELECT_TYPE:LCOUNT = -1
ELSE
	;未選択だった相性なら、空いている選択枠に確保しておく
	LCOUNT = FINDELEMENT(SELECT_TYPE,-1)
	SIF LCOUNT != -1
		SELECT_TYPE:LCOUNT = RESULT
ENDIF
CLEARLINE 8
GOTO SELECT_LOOP
$START_LABEL

CLEARLINE 8
PRINTL
PRINTFORML 　　TARGET:[{ARG:1,2}] %CALLNAME:POS(ARG:1),20,LEFT%　>>>>>>　다음 \@L_SELECT == 0 ? 물리 # 마법\@ 공격의 위력 상승!
PRINTL
SIF SKILLGAGE_D_GET(ARG,SKILL_NUM) < 1
	PRINTFORML \@CFLAG:ARG:PT플래그 == 0 ? 적 전체 # 아군 전체\@가 실행하는 %GET_TYPE(SELECT_TYPE:0)%, %GET_TYPE(SELECT_TYPE:1)%, %GET_TYPE(SELECT_TYPE:2)% 속성 공격으로 주는 데미지 상승! & NP 획득량 증가!
WAIT
SIF SKILLGAGE_D_GET(ARG,SKILL_NUM) > 0
	RETURN 0
CALL SKILLGAGE_D_SET(ARG,SKILL_NUM,4)
CALL SKILLGAGE_F_SET(ARG,SKILL_NUM,0)

;選択された相性を保存しておく
CALL SET_RPG_CSTR_TAKEOVER,ARG,"S3相性確保",@"%GET_TYPE(SELECT_TYPE:0)%_%GET_TYPE(SELECT_TYPE:1)%_%GET_TYPE(SELECT_TYPE:2)%"

;====================================================
;実行内容ここまで
;====================================================





