	SETCOLOR ARG > -1 && SKILLGAGE_D_GET(ARG,PU_SKILLNUM_GET(ARG,"미지에대한탐구")) > 0 ? COLOR("GRAY") # COLOR("YELLOW")
	PRINTFORM 追加{LCOUNT}
