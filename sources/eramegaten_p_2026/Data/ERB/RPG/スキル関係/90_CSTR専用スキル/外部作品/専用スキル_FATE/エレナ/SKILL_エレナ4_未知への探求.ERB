;====================================================
;独自処理
;====================================================
@AUTO_PU_SKILL_未知への探求,ARG,ARGS,ARG:1,ARG:2
#DIM SKILL_NUM
#DIM L_USER
#DIM LCOUNT
;ARG	攻撃者
;ARGS	（ダメージ↑、被ダメージ↑、命中↑、回避↑、魔威↑、魔効↑、etc…）といった感じの奴
;ARG:1 	防御者
;ARG:2	自由枠　今回では攻撃者が使った攻撃の相性
;文字列を参考にする都合上、どの文字列を使うか事前に定めておいた方がいいかも
L_USER = -1
FOR LCOUNT,0,CHARANUM
	;戦闘に参加してない or 未知への探求持ちでないなら飛ばす
	SIF CFLAG:LCOUNT:포지션 < 1 || !HAVE_PU_SKILL(LCOUNT,"미지에대한탐구")
		CONTINUE
	SELECTCASE ARGS
		CASE "ダメージ↑","NP回収増加"
			;ダメージ↑ or NP回収増加の場合、攻撃者と同PTでなければ飛ばす
			SIF CFLAG:ARG:PT플래그 != CFLAG:LCOUNT:PT플래그
				CONTINUE
	ENDSELECT
	L_USER = LCOUNT
	BREAK
NEXT
SIF L_USER == -1
	RETURN 0
SKILL_NUM = PU_SKILLNUM_GET(L_USER,"미지에대한탐구")
;効果時間終了前 and CSTRに確保した相性と合致するならダメージ増加
IF SKILLGAGE_D_GET(L_USER,SKILL_NUM) > 4 && AUTO_SPLIT(GET_RPG_CSTR_TAKEOVER(L_USER,"S3相性確保"),"_",0,GET_TYPE(ARG:2)) != ""
	SELECTCASE ARGS
		CASE "ダメージ↑"
			RETURN 20
		CASE "NP回収増加"
			RETURN 5
	ENDSELECT
ENDIF
RETURN 0
