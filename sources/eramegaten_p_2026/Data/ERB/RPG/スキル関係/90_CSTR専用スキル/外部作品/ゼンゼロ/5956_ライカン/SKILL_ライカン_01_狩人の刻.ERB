;スキル名
@SKILL_NAME_狩人の刻,ARG
RESULTS = 사냥꾼의 시간

;　명중
@SKILL_HITRATE_狩人の刻, ARG
RETURN 90

;　威力
@SKILL_POWER_狩人の刻, ARG
SIF ARG < 0
	RETURN 120
CALL GET_SKILL_POWER_狩人の刻(GET_ROLE_CFLAG_TAKEOVER(ARG, "通常スキルランク"))
RETURN RESULT

@GET_SKILL_POWER_狩人の刻, ARG, ARG:1 = -1
SELECTCASE ARG
	CASE 15
		RESULT = 420
	CASE 11 TO 14
		RESULT = 360 + (ARG - 10) * 12
	CASE 10
		RESULT = 360
	CASE 2 TO 9
		RESULT = 70 + 30 * ARG
	CASE 0, 1
		RESULT = 100
	CASEELSE
		RESULT = 0
ENDSELECT
SIF ARG:1 == -1
	RETURN RESULT
RETURN RESULT * GET_CHARGE_POWER_月下遊猟(ARG:1) / 100

