;　コストの量
@SKILL_COST_狩人の刻,ARG
SIF ARG < 0
	RETURN 4
CALL GET_SKILL_COST_狩人の刻(GET_ROLE_CFLAG_TAKEOVER(ARG, "通常スキルランク"))
RETURN RESULT

;　コストの量
@GET_SKILL_COST_狩人の刻,ARG
SELECTCASE ARG
	CASE 15
		RETURN 38
	CASE 0, 1
		RETURN 10
	CASEELSE
		RETURN 8 + ARG * 2
ENDSELECT

