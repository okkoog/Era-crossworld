;　威力
@SKILL_POWER_通常攻撃（原神）, ARG
#DIM 元素スキル継続時間
#DIM 元素爆発制御変数
#DIM 基礎ダメージ
SIF ARG == -1
	RETURN 100
元素スキル継続時間 = PU_SKILLNUM_GET(ARG,"元素スキル（原神）")
元素爆発制御変数 = PU_SKILLNUM_GET(ARG,"元素爆発（原神）")

IF BASE:ARG:LV >= 39
	基礎ダメージ = 300
ELSEIF BASE:ARG:LV >= 34
	基礎ダメージ = 250
ELSEIF BASE:ARG:LV >= 29
	基礎ダメージ = 200
ELSEIF BASE:ARG:LV >= 24
	基礎ダメージ = 160
ELSEIF BASE:ARG:LV >= 19
	基礎ダメージ = 120
ELSE
	基礎ダメージ = 100
ENDIF

;バアルが爆発一心中の間のみ、攻撃力が増大。
IF SKILL_CHANGE(ARG, [[キャラ:기묘한바알]]) 
	SIF SKILLGAGE_D_GET(ARG,元素爆発制御変数) > 0
		基礎ダメージ += 100

;奇妙なブエル６重　破業障時ダメージ加算
ELSEIF SKILL_CHANGE(ARG, [[キャラ:비묘한부에르]])
	SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 6 && SKILLGAGE_D_GET(ARG,元素スキル継続時間) > 0 && SKILLGAGE_D_GET(ARG,元素爆発制御変数) > 0
		基礎ダメージ += 50
;奇妙なフォカロルス６重＋プネウマ時のスキル起動後３ターン中攻撃アップ
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한포칼로스]])
	SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 6 && SKILLGAGE_D_GET(ARG,元素スキル継続時間) > 2 && SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"通常攻撃（原神）")) == 1
		基礎ダメージ += 100

ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한하보림]])
	;奇妙なハボリム。스킬『双駆輪』中ダメージアップ
	IF SKILLGAGE_D_GET(ARG,元素スキル継続時間) > 0 && SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"元素スキル（原神）")) == 1
		基礎ダメージ += 30
		;星座ダメージアップ
		SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 5
			基礎ダメージ += 30
		SIF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 6
			基礎ダメージ += 40
	ENDIF
ENDIF

RETURN 基礎ダメージ

