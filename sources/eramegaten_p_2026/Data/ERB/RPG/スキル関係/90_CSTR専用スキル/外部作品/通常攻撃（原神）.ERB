;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_通常攻撃（原神）,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
#DIM 元素スキル継続時間
#DIM 元素爆発制御変数
#LOCALSIZE 3
元素スキル継続時間 = PU_SKILLNUM_GET(ARG,"元素スキル（原神）")
元素爆発制御変数 = PU_SKILLNUM_GET(ARG,"元素爆発（原神）")

IF SKILL_CHANGE(ARG, [[キャラ:기묘한바르바토스]]) 
	;奇妙なバルバトス１重　拡散化
	IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 1
		CALL ATTACK_SPREAD,ARG,ARG:1,SKILL_NUM;		拡散攻撃
	ELSE
		CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한모라쿠스]]) 
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
;奇妙なバアル、爆発効果時間中
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한바알]])
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
	;他の仲間の元素エネルギーゲージを＋１５させる機能は元素爆発ゲージに集約。
	;奇妙なバアル６重　夢想の一心時に仲間全員の爆発CTを短縮
	IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 6 && SKILLGAGE_D_GET(ARG,元素爆発制御変数) > 0
		IF SKILLGAGE_H_GET(ARG,元素爆発制御変数) > 0
			CALL SKILLGAGE_H_ADD, ARG,元素爆発制御変数, -1
			IF CFLAG:(ARG):PT플래그
				LOCAL:1 = 1
				LOCAL:2 = 7
			ELSE
				LOCAL:1 = 7
				LOCAL:2 = 17
			ENDIF
			FOR LOCAL,LOCAL:1,LOCAL:2
				SIF POS(LOCAL) < 0
					CONTINUE
				SIF GET_STATE(CFLAG:POS(LOCAL):상태이상) == "DYING"
					CONTINUE
				SIF HAVE_PU_SKILL(POS(LOCAL), "元素爆発（原神）") == 0
					CONTINUE
				CALL SET_RPG_CFLAG_BTL, POS(LOCAL), "元素爆発再使用可能ターン", 1 , "-="
			NEXT
		ENDIF
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:비묘한부에르]]) 
	;ブエルが命の星座６重でスキル・爆発両方の状態にある時、全体攻撃
	IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 6 && SKILLGAGE_D_GET(ARG,元素スキル継続時間) > 0 && SKILLGAGE_D_GET(ARG,元素爆発制御変数) > 0
		CALL ATTACK_FIELD,ARG,ARG:1,SKILL_NUM;			範囲攻撃(列、全体)
	ELSE
		;その他のケース
		CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한포칼로스]])
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
	;フォルカロス命の星座６重でスキル３ターン以内＋ウーシアの場合、オートディア発動
	IF GET_RPG_CFLAG_TAKEOVER(ARG, "命の星座") >= 6 && SKILLGAGE_D_GET(ARG,元素スキル継続時間) > 2 && SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"通常攻撃（原神）")) == 0
		IF CFLAG:(ARG):PT플래그
			LOCAL:1 = 1
			LOCAL:2 = 7
		ELSE
			LOCAL:1 = 7
			LOCAL:2 = 17
		ENDIF
		FOR LOCAL,LOCAL:1,LOCAL:2
			SIF POS(LOCAL) < 0
				CONTINUE
			SIF GET_STATE(CFLAG:POS(LOCAL):상태이상) == "DYING"
				CONTINUE
			CALL HEAL_SINGLE,ARG,POS(LOCAL),401
		NEXT
	ENDIF
ELSEIF SKILL_CHANGE(ARG, [[キャラ:기묘한하보림]])
	;ハボリム、シンプルに攻撃するだけ。
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
ELSE
	;該当者が居なかった場合
	CALL ATTACK_SINGLE,ARG,POS(ARG:1),SKILL_NUM;	単体攻撃
ENDIF

