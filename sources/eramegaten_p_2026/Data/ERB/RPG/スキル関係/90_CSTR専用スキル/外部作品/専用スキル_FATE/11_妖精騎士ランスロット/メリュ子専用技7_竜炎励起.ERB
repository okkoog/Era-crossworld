;使用条件
@SKILL_SPECIAL_ACTIONABLE_竜炎励起,ARG
SIF SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG,"竜炎励起")) < 1
	RETURN 0
RETURN 1

;何のバッドステータスを治せるか
@SKILL_CURE_STATE_竜炎励起, ARG
SELECTCASE GET_STATE(ARG)
	CASE "FLY","GOOD","DYING","ORGY","HEAT"
		RETURN 0
	CASEELSE
		RETURN 1
ENDSELECT

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_竜炎励起, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM L_NUM

;重数が1未満だと補正は発生しない
SIF SKILLGAGE_F_GET(L_P,SKILL_NUM) < 1
	RETURN 0
;事前に倍率を確保しておく（竜骸形態中、重数は２倍として扱う）
L_NUM = SKILLGAGE_F_GET(L_P,SKILL_NUM) * MIN(1 + GET_RPG_CFLAG_TAKEOVER(L_P,"形態換装フラグ"),2)

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		CASE "ダメージ補正加算"
			CALL CHECK_SKILL_TAG(L_P,CFLAG:L_P:입력행동,"宝具")
			;宝具攻撃だと15％ * 重数、それ以外の攻撃だと5％ * 重数分ダメージが増加する
			L_NUM = (RESULT ? 15 # 5) * L_NUM
			RETURN L_NUM
	ENDSELECT
;自分が防御側
ELSE
	SELECTCASE ARGS
		CASE "ダメージ倍率"
			IF !CFLAG:L_P:PT플래그
				;敵対時は2 ~ 10%、竜骸形態は4% ~ 20%、ドラゴンハート起動中なら最大30%の固定値バリアを貼る
				L_NUM = ((MAXBASE:L_P:ＨＰ * 2 / 100) * L_NUM) + PU_SKILLGAGE_F_GET(L_P,"ドラゴンハート") > 0 ? 10 # 0
			ELSE
				;被弾時に最大HPの3% * 重数のHPバリアを貼る 最大30%、ドラゴンハートの効果適用中なら最大40%に変化する
				L_NUM = (MAX(MAXBASE:L_P:ＨＰ * 3 / 100,35) * L_NUM) + PU_SKILLGAGE_F_GET(L_P,"ドラゴンハート") > 0 ? 10 # 0
			ENDIF
			SIF CFLAG:L_P:HP배리어 < L_NUM
				CALL SKILL_SET_HPバリア,L_P,L_NUM,"『竜炎励起』","非表示"
	ENDSELECT
ENDIF
RETURN 0
