;ターン終了時に行う処理
@SKILL_TURNEND_竜炎励起,ARG
#DIM SKILL_NUM
#DIM L_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"竜炎励起")
;所持している竜気が5個未満 and 竜気放出 使用直後でなければ竜気を１個獲得する
SIF SKILLGAGE_F_GET(ARG,SKILL_NUM) < 5 && SKILLGAGE_D_GET(ARG,SKILL_NUM) < 1
	CALL SKILLGAGE_F_ADD(ARG,SKILL_NUM,1)
;HPバリアが竜炎励起のままだった場合、ターン終了時に解除する
SIF CSTR:ARG:HP배리어명 == "『竜炎励起』"
	CFLAG:ARG:HP배리어 = 0
;竜骸形態中 and 竜気が1個以上だと自傷ダメージ発生
IF GET_RPG_CFLAG_TAKEOVER(ARG,"形態換装フラグ") == 1 && SKILLGAGE_F_GET(ARG,SKILL_NUM) > 0
	L_NUM = CFLAG:ARG:PT플래그 > 0 ? 2 # 1
	L_NUM = MAX(MAXBASE:ARG:ＨＰ * (L_NUM * SKILLGAGE_F_GET(ARG,SKILL_NUM)) / 100,1)
	PRINTFORML 竜炎励起 %CALLNAME:ARG% >>>>> {L_NUM}消耗
	CALL VAR_HP,ARG,-L_NUM,"ダメージ"
ENDIF

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_竜炎励起,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM

SKILL_NUM = PU_SKILLNUM_GET(ARG,"竜炎励起")

CALL SKILL_能力低下解除(ARG,ARG,"단체")
CALL HEAL_SINGLE,ARG,ARG,SKILL_NUM
PRINTFORML 　　%CALLNAME:ARG%의 NP 게이지가 20% 충전되었다!
CALL SKILLGAGE_F_ADD(ARG,PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム"),20)
CALL SKILLGAGE_F_ADD(ARG,SKILL_NUM,-1)

