;　コストの量
@SKILL_COST_カードスキルA,ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"カードスキルA")
SIF SKILLGAGE_D_GET(ARG,SKILL_NUM) > 0
	RETURN 0
SELECTCASE SKILLGAGE_F_GET(ARG,SKILL_NUM)
	CASE 1
		;ワイドショット
		;イベント用
		SIF CFLAG:ARG:998 == 2
			RETURN 15
		RETURN 30
	CASE 2
		;バズソーショット
		;イベント用
		SIF CFLAG:ARG:998 == 2
			RETURN 15
		RETURN 30
	CASE 3
		;シザーズショット
		;イベント用
		SIF CFLAG:ARG:998 == 2
			RETURN 15
		RETURN 30
	CASE 4
		;クレジットショット
		;イベント用
		SIF CFLAG:ARG:998 == 2
			RETURN 20
		RETURN 40
	CASE 5
		;リペアショット
		;イベント用
		SIF CFLAG:ARG:998 == 2
			RETURN 10
		RETURN 20
	CASE 6
		;電熱砲
		;イベント用
		IF CFLAG:ARG:998 == 2 && GETCHARA([[キャラ:국경문]]) > -1
			IF MAXBASE:ARG:ＭＰ < 100
				IF BASE:ARG:ＭＰ < MAXBASE:ARG:ＭＰ && BASE:GETCHARA([[キャラ:국경문]]):ＨＰ < MAXBASE:GETCHARA([[キャラ:국경문]]):ＨＰ / 3
					RETURN BASE:ARG:ＭＰ
				ELSE
					RETURN MAXBASE:ARG:ＭＰ
				ENDIF
			ELSEIF BASE:ARG:ＭＰ < 100 && BASE:GETCHARA([[キャラ:국경문]]):ＨＰ < MAXBASE:GETCHARA([[キャラ:국경문]]):ＨＰ / 3
				RETURN BASE:ARG:ＭＰ
			ELSE
				RETURN 100
			ENDIF
		ELSE
			IF MAXBASE:ARG:ＭＰ > 50 && MAXBASE:ARG:ＭＰ < 150
				IF BASE:ARG:ＭＰ < MAXBASE:ARG:ＭＰ && BASE:ARG:ＨＰ < MAXBASE:ARG:ＨＰ / 3
					RETURN BASE:ARG:ＭＰ
				ELSE
					RETURN MAXBASE:ARG:ＭＰ
				ENDIF
			ELSEIF BASE:ARG:ＭＰ < 150 && BASE:ARG:ＨＰ < MAXBASE:ARG:ＨＰ / 3
				RETURN BASE:ARG:ＭＰ
			ELSE
				RETURN 150
			ENDIF
		ENDIF
	CASE 7
		;パイルショット
		;イベント用
		SIF CFLAG:ARG:998 == 2
			RETURN 20
		RETURN 40
	CASEELSE
		;ＥＭＰＴＹ
		RETURN 0
ENDSELECT

