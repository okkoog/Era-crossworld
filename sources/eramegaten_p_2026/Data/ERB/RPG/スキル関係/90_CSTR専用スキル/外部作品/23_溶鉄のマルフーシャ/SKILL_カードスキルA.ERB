@SKILL_EXPLAIN_カードスキルA,ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"カードスキルA")
;専用技が封印されている
IF CFLAG:ARG:998 == 0
	PRINTL (개별 이벤트 전용 스킬 & 개별 이벤트 1~4를 모두 클리어하면…?)
ELSE
	SELECTCASE SKILLGAGE_F_GET(ARG,SKILL_NUM)
		CASE 1
			;ワイドショット
			PRINTL 7방향 동시에 사격하는 와이드 샷을 쏩니다
			;イベント用
			SIF CFLAG:ARG:998 == 2
				SETCOLOR 0xFFA500
			PRINTL 적 전열에 비구 속성의 대 데미지
			RESETCOLOR
		CASE 2
			;バズソーショット
			PRINTL 적을 베어가르는 톱날을 쏘아냅니다
			;イベント用
			SIF CFLAG:ARG:998 == 2
				SETCOLOR 0xFFA500
			PRINT 대상과 그 주위에 검격 속성의 대 데미지
			RESETCOLOR
			PRINTL 　크리티컬률이 약간 높다
		CASE 3
			;シザーズショット
			PRINTL 적을 협공하는 열선을 쏩니다
			;イベント用
			SIF CFLAG:ARG:998 == 2
				SETCOLOR 0xFFA500
			PRINT 적 1체와 그 뒤의 적에게 핵열 속성의 대 데미지
			RESETCOLOR
			PRINTL 　크리티컬률이 약간 낮다
		CASE 4
			;クレジットショット
			PRINTL 강력한 산탄을 쏩니다. 특수 통화가 많을수록 공격 횟수가 증가합니다
			;イベント用
			SIF CFLAG:ARG:998 == 2
				SETCOLOR 0xFFA500
			PRINTL 적 전열에 1~5회 비구 속성의 중 데미지
			RESETCOLOR
		CASE 5
			;リペアショット
			PRINTL 동료를 향해 쏘면 회복하는 탄환을 쏩니다
			;イベント用
			SIF CFLAG:ARG:998 == 2
				SETCOLOR 0xFFA500
			PRINTL 아군 1명을 크게 회복한다
			RESETCOLOR
		CASE 6
			;電熱砲
			PRINTL 적을 일소하는 전열포를 사용합니다
			;イベント用
			IF CFLAG:ARG:998 == 2
				SETCOLOR 0xFFA500
				PRINTL 온갖 방호를 꿰뚫는 포격으로 적 전체~적 1체에 화염+핵열 복합 상성의 초특대~??? 데미지
				RESETCOLOR
			ELSE
				PRINTL 온갖 방호를 꿰뚫는 포격으로 적 전체~적 1체에 화염+핵열 복합 상성의 특대~초특대 데미지
			ENDIF
			PRINTL 매우 강력하지만 코스트가 무겁고, 크리티컬률이 극히 낮으나 위기 상황에서는 저코스트로 사용할 수 있다
			;相性貫通ダメージアップ＋防御力を二分の一として計算します。
		CASE 7
			;パイルショット
			PRINTL 사거리가 짧은 열말뚝을 3발 박아넣습니다
			;イベント用
			IF CFLAG:ARG:998 == 2
				SETCOLOR 0xFFA500
				PRINTL 전열의 적 1체에 3회 핵열 상성의 대데미지를 입히고, 낙인 상태로 만든다
				RESETCOLOR
			ELSE
				PRINTL 전열의 적 1체에 3회 핵열 상성의 중데미지를 입히고, 낙인 상태로 만든다
			ENDIF
		CASEELSE
			;ＥＭＰＴＹ
			PRINTL 일회용 무기의 스킬
			PRINTL 특정 카드를 뽑으면, 대응하는 무기 스킬로 전환됩니다
	ENDSELECT
	SIF SKILLGAGE_F_GET(ARG,SKILL_NUM) > 0
		PRINTL 이 스킬은 총공격과 총명중으로 데미지를 계산하며, 사용 후에는 「EMPTY」로 돌아갑니다
ENDIF

;使用条件
@SKILL_SPECIAL_ACTIONABLE_カードスキルA,ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"カードスキルA")
;専用技が封印されている
SIF CFLAG:ARG:998 == 0
	RETURN 0
SIF SKILLGAGE_F_GET(ARG, SKILL_NUM) > 0
	RETURN 1
RETURN 0

@リンク不能_カードスキルA
RETURN 1

@電熱砲, BASE_XPOS = 100, BASE_YPOS = -500
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC BASE_XPOS
#DIM DYNAMIC BASE_YPOS
#DIM DYNAMIC GID
#DIMS DYNAMIC SHOW_RAYER
#DIMS DYNAMIC L_SPRITENAME
#DIMS DYNAMIC L_ADDRESS
#DIM DYNAMIC L_HEIGHT = 1250
#DIM DYNAMIC L_WIDTH
#DIM DYNAMIC L_SPACE
L_ADDRESS '= "80_スキル画像" + "\\" + "CSTR_カードスキルA" + "\\" + "電熱砲" + "_"

IF !SPRITECREATED("電熱砲_0")
	FOR LCOUNT, 0, 31
		GID = GET_FREE_TEMP_GID()
		SIF !GCREATEFROMFILE(GID, L_ADDRESS + TOSTR(LCOUNT, "00") + ".png")
			RETURN 0
		L_SPRITENAME '= "電熱砲_" + TOSTR(LCOUNT)
		SPRITECREATE L_SPRITENAME, GID, 0, 0, GWIDTH(GID), GHEIGHT(GID)
		CALL PUSH_ARRAY_STR, TEMP_GID_SPRITENAME, L_SPRITENAME
	NEXT
ENDIF

L_WIDTH = L_HEIGHT * SPRITEWIDTH("電熱砲_0") / SPRITEHEIGHT("電熱砲_0") + 50
FOR LCOUNT, 0, 31
	SHOW_RAYER '= @"<img src = '電熱砲_{LCOUNT}' height = '{L_HEIGHT}'>"
	{
	SHOW_RAYER '= @"<div xpos = '{BASE_XPOS + 150 - MAX((LCOUNT - 27) * 50, 0)}' ypos = '{BASE_YPOS - L_HEIGHT}'
					height = '{L_HEIGHT + 50}' width = {L_WIDTH}
					padding = '25'
					background_color = '%TOSTR_HTML(GETBGCOLOR())%' display = 'absolute-leftbottom'
					>" + SHOW_RAYER + "</div>"
	}
	{
	SHOW_RAYER += @"<div xpos = '{BASE_XPOS}' ypos = '{BASE_YPOS - L_HEIGHT}'
					height = '{L_HEIGHT + 50}' width = {L_WIDTH}
					display = 'absolute-leftbottom' border_width = '3px'>" + "</div>"
	}
	HTML_PRINT_ISLAND SHOW_RAYER
	INPUTMOUSEKEY 100
	HTML_PRINT_ISLAND_CLEAR
	SIF RESULT != 4
		BREAK
NEXT