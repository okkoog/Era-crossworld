;　威力
@SKILL_POWER_カードスキルA, ARG
#DIM SKILL_NUM
SKILL_NUM = PU_SKILLNUM_GET(ARG,"カードスキルA")
SELECTCASE SKILLGAGE_F_GET(ARG,SKILL_NUM)
	CASE 1
		;ワイドショット(一列　1500)
		;イベント用
		SIF CFLAG:ARG:998 == 2
			RETURN 350
		RETURN 300
	CASE 2
		;バズソーショット(拡散　1450)
		;イベント用
		IF CFLAG:ARG:998 == 2
			SIF FLAG:확산플래그
				RETURN 400
			RETURN 450
		ELSE
			SIF FLAG:확산플래그
				RETURN 350
			RETURN 400
		ENDIF
	CASE 3
		;シザーズショット(敵の前列と後列を貫く　900*125%=1125)
		;イベント用
		SIF CFLAG:ARG:998 == 2
			RETURN 500
		RETURN 450
	CASE 4
		;クレジットショット(一列　１～５回　特殊通貨の量による　3750)
		;イベント用
		SIF CFLAG:ARG:998 == 2
			RETURN 200
		RETURN 150
	CASE 5
		;リペアショット(회복　150)
		;イベント用
		SIF CFLAG:ARG:998 == 2
			RETURN 200
		RETURN 150
	CASE 6
		;電熱砲(全体～単体　切り札　マルフーシャ専用　800～5000*125%=1000～6250)
		;相性貫通ダメージアップ＋防御半減
		;『溶鉄のマルフーシャ』はラスボスも電熱砲で一発で倒せる
		;イベント用
		IF CFLAG:ARG:998 == 2
			SELECTCASE FLAG:확산플래그 + TFLAG:스킬용1
				CASE 3
					RETURN 2000
				CASE 2
					RETURN 1500
				CASE 1
					RETURN 999
				CASEELSE
					RETURN 800
			ENDSELECT
			;１体＋相性貫通
			;IF FLAG:확산플래그 == 3
			;	RETURN 2000
			;１体 or ２～３体＋相性貫通
			;ELSEIF FLAG:확산플래그 == 2
			;	RETURN 1500
			;２～３体 or 相性貫通
			;ELSEIF FLAG:확산플래그 == 1
			;	RETURN 999
			;ELSE
			;	RETURN 800
			;ENDIF
		ELSE
			SELECTCASE FLAG:확산플래그 + TFLAG:스킬용1
				CASE 3
					RETURN 999
				CASE 2
					RETURN 800
				CASE 1
					RETURN 650
				CASEELSE
					RETURN 50
			ENDSELECT
			;１体＋相性貫通
			;IF FLAG:확산플래그 == 3
			;	RETURN 999
			;１体 or ２～３体＋相性貫通
			;ELSEIF FLAG:확산플래그 == 2
			;	RETURN 800
			;２～３体 or 相性貫通
			;ELSEIF FLAG:확산플래그 == 1
			;	RETURN 650
			;ELSE
			;	RETURN 500
			;ENDIF
		ENDIF
	CASE 7
		;パイルショット(単体　250*3*125%=937.5)
		;イベント用
		SIF CFLAG:ARG:998 == 2
			RETURN 350
		RETURN 250
	CASEELSE
		;ＥＭＰＴＹ
		RETURN 100
ENDSELECT

