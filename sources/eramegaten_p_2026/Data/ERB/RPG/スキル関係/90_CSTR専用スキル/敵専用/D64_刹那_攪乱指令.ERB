;スキル名
@SKILL_NAME_攪乱指令,ARG
RESULTS = 攪乱指令

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_攪乱指令
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_攪乱指令,ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_攪乱指令,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_攪乱指令,ARG
RETURN GET_SPHERE_NUM("단체")

;속도보정
@SKILL_SPEED_攪乱指令, ARG = -1
RETURN -999

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_攪乱指令,ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;スキル変化？用ランク
@SKILL_RANK_攪乱指令, ARG = -1
RETURN 15

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_攪乱指令
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_攪乱指令,ARG,ARG:1,SKILL_NUM
#DIM SKILL_NUM
PRINTFORMW %CALLNAME:ARG%은(는) 아군 데빌에게 적의 교란을 지시했다.
TFLAG_D34_攪乱指令予約 = 1

;　説明文の表示
@SKILL_EXPLAIN_攪乱指令,ARG
PRINTL 아군 데빌에게 보조 행동을 지시한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_攪乱指令,ARG
RETURN 1
