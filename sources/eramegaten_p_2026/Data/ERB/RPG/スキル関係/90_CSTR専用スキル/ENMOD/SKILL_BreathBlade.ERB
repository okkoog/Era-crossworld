;専用スキル用のテンプレート
;「専用技名」を別の名前に置き換えてください

;アクティブスキルに必須なものはそのままにしており
;なくてもいいものはコメントアウトしております
;必要だと思ったらコメントアウトを外して設定してください
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_黒炎竜之牙,ARG
IF SKILLGAGE_D_GET(ARG,(PU_SKILLNUM_GET(ARG, "忍法・獣遁の術")))
	RESULTS = 黒炎竜之翼
ELSE
	RESULTS = 黒炎竜之牙
ENDIF

;　명중
@SKILL_HITRATE_黒炎竜之牙, ARG
RETURN 90

;　威力
@SKILL_POWER_黒炎竜之牙, ARG
IF SKILLGAGE_D_GET(ARG, (PU_SKILLNUM_GET(ARG, "忍法・獣遁の術")))
	IF BASE:ARG:LV < 20
		;2 Attacks, Large
		RETURN 150
	ELSEIF BASE:ARG:LV < 40
		;3 Attacks, Heavy
		RETURN 125
	ELSEIF BASE:ARG:LV < 60
		;3 Attacks, Severe
		RETURN 150
	ELSE 
		;3 Attacks, Colossal
		RETURN 200
	ENDIF
ELSE
	IF BASE:ARG:LV < 20
		;Small
		RETURN 100
	ELSEIF BASE:ARG:LV < 40
		;Small
		RETURN 150
	ELSEIF BASE:ARG:LV < 60
		;Medium
		RETURN 200
	ELSE 
		;Heavy
		RETURN 300
	ENDIF
ENDIF

;;クリティカル率
@SKILL_CRITICAL_RATE_黒炎竜之牙, ARG
IF SKILLGAGE_D_GET(ARG,(PU_SKILLNUM_GET(ARG, "忍法・獣遁の術")))
	RETURN 20
ELSE
	RETURN 0
ENDIF

