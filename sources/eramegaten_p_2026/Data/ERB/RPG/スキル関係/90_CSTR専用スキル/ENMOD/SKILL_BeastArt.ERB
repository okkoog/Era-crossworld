@SKILLGAGE_CHARGE_忍法・獣遁の術,ARG,ARG:1
#LOCALSIZE 1
#DIM L_T
#DIM L_GP
SIF SKILLGAGE_D_GET(ARG,(PU_SKILLNUM_GET(ARG, "忍法・獣遁の術"))) > 0
	RETURN 0
;Character's own actions
IF ARG == ARG:1
	;Skill gauge increases according to the number of enemies attacked.
	FOR LOCAL,0,CHARANUM
		SIF CFLAG:LOCAL:PT플래그 == CFLAG:ARG:PT플래그
			CONTINUE
		IF CFLAG:LOCAL:현데미지 > 0
			L_GP += 3
		ELSE
			CONTINUE
		ENDIF
		;Increases more if the attack hits a weak point
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 2
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 2
	NEXT
		;Goes up if charge is used
	SIF CFLAG:ARG:입력행동 == 511
		L_GP += 10
ENDIF

;Gauge increases when taking damage (excluding counters or triggers)
IF GET_CREC_ACT(ARG:1, ARG, "HIT")
	LOCAL = 60 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ
	LOCAL = LOCAL < 2 ? 2 # LOCAL
	L_GP += LOCAL
ENDIF
;If the gauge is over 100, make it 100
CALL SKILLGAGE_F_SET,ARG,PU_SKILLNUM_GET(ARG, "忍法・獣遁の術"),MIN(100, L_GP + SKILLGAGE_F_GET(ARG,PU_SKILLNUM_GET(ARG, "忍法・獣遁の術")))
RETURN 0


