;スキル名
@SKILL_NAME_無効化カウンター,ARG
RESULTS = 무효화 카운터

;　명중
@SKILL_HITRATE_無効化カウンター, ARG
RETURN 999

;　威力
@SKILL_POWER_無効化カウンター, ARG
RETURN 100

;　최저공격횟수
@SKILL_MINATTACKNUMBER_無効化カウンター,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_無効化カウンター,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_無効化カウンター, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_無効化カウンター,ARG
RETURN 0

;　相性
@SKILL_TYPE_無効化カウンター,ARG
SIF ARG < 0
	RETURN GET_TYPE_NUM("不定")
RETURN ABL:ARG:공격상성

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_無効化カウンター
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_無効化カウンター,ARG
RETURN GET_ダメージタイプ_NUM("物理")
;====================================================
;攻撃手段
;1.物理攻撃 2.魔法攻撃 3.총공격 4.アイテム攻撃(ダメージ計算時の依存ステータスに関わる)
;関数がない場合はダメージタイプとおなじになる
;====================================================
@SKILL_ATTACKTYPE_無効化カウンター, ARG
RETURN GET_攻撃タイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_無効化カウンター,ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_無効化カウンター,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_無効化カウンター,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_無効化カウンター,ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;속도보정
@SKILL_SPEED_無効化カウンター, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_無効化カウンター
RETURN 0


;====================================================
;カウンター発動条件
;ARG			このスキルの持ち主
;ARG:1			攻撃者のキャラ番号

;RESULT			1 = 反撃成立。ただし実行までの間に行動者が行動不能になった場合は不発する
;RESULT:1		反撃対象のPOS(ACTION_XXXのARG:1に送られる)。システム側で敵の生存・存在判定による不発判定をおこなうが、RESULT:1が0の場合は相手の状態に関わらず判定を通す
;RESULT:2		-1 = デフォルトのスキル名表示を省く
;====================================================
@SKILL_COUNTER_ACTIONABLE_無効化カウンター,ARG,ARG:1
;物理攻撃を受けている
SIF !GET_CREC_ACT(ARG:1, ARG, "ATTACK", "物理")
	RETURN 0
;攻撃を無効化している
SIF !GET_CREC_ACT(ARG:1, ARG, "BLOCK")
	RETURN 0
;反撃の対象は反撃してきたキャラ(ポジションで返す)
RETURN 1, CPOS(ARG:1)
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_無効化カウンター,ARG,ARG:1,SKILL_NUM
#LOCALSIZE 1
#DIM SKILL_NUM
TFLAG:반사0데미지화 = 1
TFLAG:흡수0데미지화 = 1
CALL ATTACK_SINGLE, ARG, POS(ARG:1), SKILL_NUM

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_無効化カウンター, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		; RETURN 0
		;スキル命中率に加算する。低命中スキルに影響度が高く、カジャンダによって効果量が増減する
		;CASE "スキル命中強化"
		;	RETURN 0
		;+カジャの枠。つまり0からなら加算はX/32の増加、減算はX/16の減少(カジャは+4)　通常枠の上限下限を超えて加減される(ただし、減算側は安全のために8を下限にしてあるので注意)
		;この補正を999以上で指定した場合は必中、-999以下で指定した場合は命中率0となる
		;CASE "追加命中強化"
		;	RETURN 0
		;100% ± Xの補正を与える。同種(粗雑・慢心)などとは加算。補正量が素直
		;この補正を999以上で指定した場合は確定クリティカル、-999以下で指定した場合はクリティカル不能となる
		;CASE "クリティカル補正A"
		;	RETURN 0
		;アドバイスの枠 & コーチングの枠。強烈に補正がかかるので注意
		;正の場合   (1+ランク) / 1倍になる。(1ランクでアドバイスなしのばあいクリティカル率2倍。ありの場合は300%の200%で1.5倍)
		;負の場合   1 / (1+ランク)倍になる。(1ランクでアドバイスなしのばあいクリティカル率0.5倍。ありの場合は1/2 から1/3で0.66倍) ※要するにクリティカル率減少
		;CASE "クリティカルランク"
		;	RETURN 0
		;乗除の計算後に加算する。上記2つの乗算系は基礎クリティカル率が低いスキルには効果が薄いが、こちらは基礎が低いスキルに強力に働く
		;基礎クリティカル率が低い技しか持たないキャラの補正用と考えるのならばこれで補正するのがおすすめ
		;CASE "クリティカル加算"
		;	RETURN 0
		;100% ± Xの補正を与える。つまり、20なら1.2倍、-20なら0.8倍。素質(1.5倍)や淀んだ空気(最大2倍)とは乗算
		;この補正を999以上で指定した場合は必中、-999以下で指定した場合は命中率0となる
		;CASE "バステ補正"
		;	RETURN 0
	ENDSELECT
;自分が防御側
ELSE
	;-------------------------------------------------------
	;物理攻撃を回避不能にした上でブロックさせる。
	;-------------------------------------------------------
	SELECTCASE ARGS
		;他のものと加算されずに全体に乗算で処理される。(-20ならダメージ0.8倍、+20なら1.2倍)
		;CASE "ダメージ倍率"
		;	RETURN 0
		;この補正を999以上で指定した場合は絶対回避、-999以下で指定した場合は回避不能となる
		CASE "追加回避強化"
			SIF  L_ダメージタイプ == "物理"
				RETURN -999
		;防御時の相性を変化させる。枠としては壁やカーンなどと同じで、スキル耐性貫通スキルによって無効化される
		;※ただし耐性をあえて弱くする場合は無視されない
		;戻り値		RESULT=成否及びランク　正の数値で返すことで相性変更を実施させる。他のスキルから変動が呼ばれていた場合はRESULTの大きかったものを優先する
		;			RESULT:1 = 変化させる相性値　RESULTS = 상성변동요인
		;
		CASE "相性変化"
			IF L_ダメージタイプ == "物理"
				RESULTS = 패링
				RETURN 1, 0
			ENDIF
			RETURN 0
		;100% ± Xの補正を与える。同種(粗雑・慢心)などとは加算。
		;あまり極端な補正を与えたくない場合は
		;この補正を999以上で指定した場合は被確定クリティカル、-999以下で指定した場合はクリティカル無効となる
		;CASE "クリティカル補正A"
		;	RETURN 0
		;アドバイスの枠 & コーチングの枠
		;正の場合   1 / (1+ランク)倍になる。(1ランクでアドバイスなしのばあいクリティカル率0.5倍。ありの場合は1/2 から1/3で0.66倍) ※要するに被クリティカル率減少
		;負の場合   (1+ランク) / 1倍になる。(1ランクでアドバイスなしのばあいクリティカル率2倍。ありの場合は300%の200%で1.5倍) ※要するに被クリティカル率増加
		;CASE "クリティカル耐性ランク"
		;	RETURN 0
		;乗除の計算後に加算する。上記2つの乗算系は基礎クリティカル率が低いスキルには効果が薄いが、こちらは基礎が低いスキルに強力に働く
		;大半のスキルのクリティカル率は5% = ここで減算すると大半が0につっこみかねないのには注意
		;逆にある程度非クリティカルのリスクをプレイヤーに与える場合はここで加算してやるといい
		;CASE "クリティカル加算"
		;	RETURN 0
		;100% ± Xの補正を与える。つまり、20なら1.2倍、-20なら0.8倍。素質(1.5倍)や淀んだ空気(最大2倍)とは乗算
		;この補正を999以上で指定した場合は回付不能、-999以下で指定した場合は絶対回避となる
		;CASE "バステ補正"
		;	RETURN 0
	ENDSELECT
ENDIF
RETURN 0
;　説明文の表示
@SKILL_EXPLAIN_無効化カウンター,ARG
PRINTL 물리 공격을 무효화하고 반격한다.

;使用条件
@SKILL_SPECIAL_ACTIONABLE_無効化カウンター,ARG
RETURN 0
