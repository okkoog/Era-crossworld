;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_パッシブステータス補正, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	;RESULT = 修正値
	;RESULTS = 加算/乗算/固定値/活泉/魔脈
	;加算はそのまま固定値を加算する。乗算は(100+X)/100倍にする。固定値は必ずその数値にする(55ならなにがあろうと最大HP55になる)
	;活泉/魔脈はそのまま同種スキルと同じ枠となりもっとも効果量が高いものを優先する形になる
	;HP半減
	CASE "HP補正"
		RESULTS = 乗算
		RETURN -50
	;MP+100
	CASE "MP補正"
		RESULTS = 加算
		RETURN 100
	;基本ステータス
	;ARG:1 に悪魔変身後の配分済みBASEステータスを格納している(悪魔変身をしていない・出来ない場合はBASE:Xとおなじ)
	;プラグイン等の割合計算はBASEの値を指定しているので、割合での増減を指定したい場合はARG:1に数字をかけて固定値で返してください
	CASE "基本ステータス"
		SELECTCASE ARGS:1
			;힘 +10
			CASE "힘"
				RETURN 10
			;마력 1.5倍
			CASE "마력"
				RETURN ARG:1 / 2 
		ENDSELECT
	;RESULT   = 変化があるかどうか(基準値が100だがこの項目が指定されていないと0で返してしまうので真偽判定の処理を追加している)
	;RESULT:1 = 耐性値。基準値が100なのに注意
	CASE "相性"
		SELECTCASE ARGS:1
			;打撃の基本相性を弱点にする
			CASE "타격"
				RETURN 1, 200
			;飛具が通常及び反射の場合強制的に反射にする
			CASE "비구"
				RESULTS = 通常/耐性
				RETURN 1, 999
		ENDSELECT
	;RESULT = 相性値。基準値は0でマイナスになると改善、プラスになると悪化になる。
	;
	;どちらにしろ、ステート耐性は0のときに通常(100%)のに注意。
	CASE "상태이상"
		SELECTCASE ARGS:1
			;睡眠を200％にする
			CASE "SLEEP"
				RETURN 100
			;混乱を50%にする
			CASE "PANIC"
				RETURN -50
		ENDSELECT
	;速度補正はそのまま速度補正となる
	CASE "속도보정"
		RETURN -20
ENDSELECT

RETURN 0
