;---------------------------------------
;継承不能
;1 = スキルカード化不可能・継承不能、造魔・娘への引継ぎ可能
;2 = スキルカード化不可能・継承不能、造魔・娘への引継ぎ不能
;---------------------------------------
@継承不能_追加プロパティ
RETURN 1

;---------------------------------------
;置換スキル
;なんらかの理由で継承などが不可能な時、継承やロール変更等の時に置き換わるスキルの番号を返す
;---------------------------------------
@置換スキル_追加プロパティ
RETURN [[스킬:산바람]]

;---------------------------------------
;SKILL_DEL_UNABLE
;1 = 削除不能スキル。入れ替えなどもできなくなる。
;---------------------------------------
@SKILL_DEL_UNABLE_追加プロパティ
RETURN 1

;---------------------------------------
;링크불능
;1 = リンク悪魔が所持していても変身時に使うことができない(所持スキルに入らない)스킬
;---------------------------------------
@リンク不能_追加プロパティ
RETURN 1

;---------------------------------------
;味方専用
;1 = 敵として配置された際に自動的に削除されるスキルになる
;---------------------------------------
@味方専用_追加プロパティ
RETURN 1

;---------------------------------------
;敵専用
;1 = 味方として加入した際に自動的に削除されるスキルになる
;---------------------------------------
@敵専用_追加プロパティ
RETURN 1
;---------------------------------------
;ロール専用
;1 = 特定のロール以外では取得できないスキルにする
;RESULTS = 	許可するロール名
;---------------------------------------
@ロール専用_追加プロパティ
RESULTS = 달인
RETURN 1

;---------------------------------------
;スキルのランクアップ定義
;
;ランクアップ先のスキル
;D:X = [[스킬:XXX]]
;
;戻り値 = ランク候補の数
;---------------------------------------
@SKILL_RANKUP_追加プロパティ
;낭아천주참
D:1 = [[스킬:산바람]]
;ランクアップ先は１つ
RETURN 1

;---------------------------------------
;交代時発動効果
;
;L_SWITCHING_CHARA = 交代元キャラ
;L_SUMMON_CHARA	   = 交代先キャラ(召喚キャラ)
;---------------------------------------
@SKILL_ACTION_AT_SWITCHING_追加プロパティ, L_SWITCHING_CHARA, L_SUMMON_CHARA
#DIM DYNAMIC L_SWITCHING_CHARA
#DIM DYNAMIC L_SUMMON_CHARA

;---------------------------------------
;戦闘時の使用可否
;
;戻り値 = 偽の時、戦闘中の使用可能スキルとして選択肢に入らない
;		 関数がない場合、真として扱われる
;---------------------------------------
@SKILL_ACTIONABLE_BATTLE_追加プロパティ, ARG
RETURN 0

;---------------------------------------
;即時発動かどうか
;
;戻り値 = 真の時、ターンを消費せずに発動する
;---------------------------------------
@SKILL_QUICK_ACTION_追加プロパティ, ARG
RETURN 1

;---------------------------------------
;パッシブによるコスト変更スキル
;
;L_SKILL = 判定対象となるスキル
;
;効果付与の場合の付与者がL_CHARA:1となる
;戻り値 = 100 + X%の形となる
;---------------------------------------
@SKILL_COST_CHANGE_追加プロパティ, L_CHARA, L_SKILL, L_CHARA:1
#DIM DYNAMIC L_CHARA, 2
#DIM DYNAMIC L_SKILL
RETURN -20

;---------------------------------------
;回復スキルを素質等の強化補正を受けなくするためのプロパティ
;
;戻り値 = 強化不能にする。
;---------------------------------------
@SKILL_ENHANCE_NOTABLE_追加プロパティ
RETURN 1

;---------------------------------------
;スキルを使用アイテムスキルにする
;
;戻り値 = アイテムスキル属性をつける
;---------------------------------------
@SKILL_IS_ITEMSKILL_追加プロパティ
RETURN 1

;---------------------------------------
;かばい関数
;
;戻り値 = かばい対象のキャラ登録番号。-1を指定した場合はかばわない
;---------------------------------------
@SKILL_COVERING_追加プロパティ, L_TARGET, L_ATTACKER, L_COVER,  L_スキル, L_威力, L_相性, L_相性倍率, L_クリティカル率, L_吸収率, L_ダメージタイプ, L_攻撃タイプ, L_割合計算, L_割合上限
#DIM L_TARGET		;攻撃の対象となっているキャラ
#DIM L_ATTACKER		;攻撃をしている敵
#DIM L_COVER		;かばうキャラクター
#DIM L_スキル
#DIM L_威力
#DIM L_相性
#DIM L_相性倍率
#DIM L_クリティカル率
#DIM L_吸収率
#DIM L_ダメージタイプ
#DIM L_攻撃タイプ
#DIM L_割合計算
#DIM L_割合上限
RETURN L_COVER

;---------------------------------------
;スキルを召喚スキルにする
;
;戻り値 = 召喚スキル属性をつける
;---------------------------------------
@SKILL_IS_SUMMON_追加プロパティ
RETURN 1

;---------------------------------------
;スキルを単体蘇生スキルにする
;
;戻り値 = 単体蘇生スキル属性をつける
;---------------------------------------
@SKILL_IS_RESUSCITATION_追加プロパティ
RETURN 1

;---------------------------------------
;スキルをデメリットスキルにする
;ランダム選定などから省かれるようになる
;
;戻り値 = デメリットスキル属性をつける
;---------------------------------------
@SKILL_IS_DEMERIT_追加プロパティ
RETURN 1
;-------------------------------------------------
;COOP連動スキルの判定
;戻り値は発動率。また、COOP連動効果は常にひとつしか発動しない。
;-------------------------------------------------
@SKILL_JUDGE_EXTRA_COOP_追加プロパティ, L_CHARA, L_OPT = "参加"
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_OPT;参加or発動
RETURN 50