#DIM DYNAMIC SET_SKILL_NUM
CALL FIX_CHARA_TRANS_SKILL, ARG
IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	IF CFLAG:ARG:악마변신
		IF ARGS == "変身形態"
			;---- EDIT 011 MOD START -------------------------
			IF CFLAG:ARG:링크캐릭터실제가입시간0 <= 0
				L_SKILLS '= "스킬", "초기변신악마스킬"
			ELSE
				L_SKILLS '= "초기변신악마스킬"
			ENDIF
			;---- EDIT 011 MOD END ---------------------------
		ELSE
			L_SKILLS '= "인간시스킬"
		ENDIF
	ELSE
		IF ARGS == "変身形態"
			L_SKILLS '= "초기변신악마스킬"
		ELSE
			L_SKILLS '= "스킬", "인간시스킬"
		ENDIF
	ENDIF
ELSE
	L_SKILLS '= "스킬"
ENDIF

IF ARG:2 >= 0
	SET_SKILL_NUM = ARG:2
ELSE
	FOR LCOUNT, 1, 1 + CHARA_SKILLCOUNT(ARG, ARGS)
		SIF ABL:ARG:@"%L_SKILLS%{LCOUNT}"
			CONTINUE
		SET_SKILL_NUM = LCOUNT
		BREAK
	NEXT
ENDIF
;専用スキルの場合CSTRからも削除する
DEL_SKILL = ABL:ARG:@"%L_SKILLS%{SET_SKILL_NUM}"
SIF IS_PU_SKILLNUM(DEL_SKILL)
	CSTR:ARG:@"전용기{(DEL_SKILL - [[스킬:전용기1]] + 1)}" '= ""
ABL:ARG:@"%L_SKILLS%{SET_SKILL_NUM}" = ARG:1
SIF L_SKILLS:1 != ""
	ABL:ARG:@"%L_SKILLS:1%{SET_SKILL_NUM}" = ARG:1
CALL SKILLGAGE_DIRECT_CLEAR, ARG, SET_SKILL_NUM + (ARGS == "変身形態") * 12

;---- EDIT 014 ADD START -------------------------
;==========================================
;所持スキル削除関数
;味方の所持スキルにスキルをセットする関数
;
;ARG		セットするキャラの登録番号
;ARG:1		スキルの枠番号。省力した場合は空き番号を使う
;ARGS		通常形態/変身形態
;ARG:2		削除するスキルのスキル番号
;==========================================
@DEL_FRIEND_HAVE_SKILL, L_CHARA, L_SKILL, TRANS_MODE = "通常形態", L_SKILL_HAVENUM, IS_DEL_LEARN
#DIM LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_SKILL
#DIM DYNAMIC L_SKILL_HAVENUM
#DIM DYNAMIC IS_DEL_LEARN
#DIMS DYNAMIC TRANS_MODE
#DIMS DYNAMIC L_SKILLS, 3
IF GET_ROLE_PROP("CAN_USE_TRANS", L_CHARA)
	IF TRANS_MODE == "変身形態"
		L_SKILLS '= "초기변신악마스킬", "초기변신악마습득스킬", "초기변신악마습득LV"
	ELSE
		L_SKILLS '= "인간시스킬", "습득스킬", "습득LV"
	ENDIF
ELSE
	L_SKILLS '= "스킬", "습득스킬", "습득LV"
ENDIF
IF L_SKILL > 0
	IF IS_DEL_LEARN
		FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
			SIF ABL:L_CHARA:@"%L_SKILLS:1%{LCOUNT}" != L_SKILL
				CONTINUE
			ABL:L_CHARA:@"%L_SKILLS:1%{LCOUNT}" = 0
			ABL:L_CHARA:@"%L_SKILLS:2%{LCOUNT}" = 0
		NEXT
	ENDIF
	L_SKILL_HAVENUM = 0
	FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
		SIF ABL:L_CHARA:@"%L_SKILLS%{LCOUNT}" != L_SKILL
			CONTINUE
		L_SKILL_HAVENUM = LCOUNT
		BREAK
	NEXT
	SIF L_SKILL_HAVENUM == 0
		RETURN 0
ELSE
	L_SKILL = ABL:L_CHARA:@"%L_SKILLS%{L_SKILL_HAVENUM}"
ENDIF
;専用スキルは一緒にCSTRも消しておく
SIF IS_PU_SKILLNUM(ABL:L_CHARA:@"%L_SKILLS%{L_SKILL_HAVENUM}")
	CSTR:L_CHARA:@"전용기{ABL:L_CHARA:@"%L_SKILLS%{L_SKILL_HAVENUM}" - [[스킬:전용기1]] + 1}" = 
ABL:L_CHARA:@"%L_SKILLS%{L_SKILL_HAVENUM}" = 0
IF (L_SKILLS == "인간시스킬" && !CFLAG:L_CHARA:악마변신) || (L_SKILLS == "초기변신악마스킬" && CFLAG:L_CHARA:악마변신)
	FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
		SIF ABL:L_CHARA:@"스킬{LCOUNT}" != L_SKILL
			CONTINUE
		ABL:L_CHARA:@"스킬{LCOUNT}" = 0
		BREAK
	NEXT
ENDIF
IF TRANS_MODE == "変身形態"
	SIF CFLAG:L_CHARA:링크캐릭터실제가입시간0 <= 0
		CALL SKILLGAGE_DIRECT_CLEAR, L_CHARA, L_SKILL_HAVENUM + 12
ELSE
	CALL SKILLGAGE_DIRECT_CLEAR, L_CHARA, L_SKILL_HAVENUM
ENDIF
;---- EDIT 014 ADD END ---------------------------

;----------------------------
;スキルに変更があった場合に初期変身悪魔と人間時のスキルを所持スキルに反映させる
;変身出来るキャラは直接スキルを操作しないでこれをつかってあわせないとおかしくなることがある
;----------------------------
@FIX_CHARA_TRANS_SKILL, ARG, ARGS
#DIM LCOUNT
#DIM STOCK_TRANS
IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	IF CFLAG:ARG:악마변신
		IF CFLAG:ARG:링크캐릭터실제가입시간0 <= 0
			FOR LCOUNT, 1, 1 + CHARA_SKILLCOUNT(ARG, ARGS)
				ABL:ARG:@"초기변신악마스킬{LCOUNT}" = ABL:ARG:@"스킬{LCOUNT}"
			NEXT
		ENDIF
	ELSE
		FOR LCOUNT, 1, 1 + CHARA_SKILLCOUNT(ARG, ARGS)
			ABL:ARG:@"인간시스킬{LCOUNT}" = ABL:ARG:@"스킬{LCOUNT}"
		NEXT
	ENDIF
ENDIF
;---- EDIT 026 ADD END ---------------------------
;---- EDIT 023 MOD START -------------------------
;---------------------------------------
;スキル消去関数
;
;ARG		セットする対象のキャラ登録番号
;ARGS		通常形態/変身形態の指定　デフォルトでは両方消す
;---------------------------------------
@CLEAR_ALL_SKILL, ARG, ARGS = "両形態"
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_SKILL
CALL CLEAR_LEARNED_SKILL_ALL, ARG, ARGS
FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
	IF ARGS == "両形態" || ARGS == "通常形態"
		L_SKILL = ABL:ARG:@"스킬{LCOUNT}"
		SIF IS_PU_SKILLNUM(L_SKILL)
			CSTR:ARG:@"전용기{L_SKILL - [[스킬:전용기1]] + 1}" '= ""
		ABL:ARG:@"스킬{LCOUNT}" = 0
	ENDIF
	IF ARGS == "両形態" || ARGS == "変身形態"
		L_SKILL = ABL:ARG:@"초기변신악마스킬{LCOUNT}"
		SIF IS_PU_SKILLNUM(L_SKILL)
			CSTR:ARG:@"전용기{L_SKILL - [[스킬:전용기1]] + 1}" '= ""
		ABL:ARG:@"초기변신악마스킬{LCOUNT}" = 0
	ENDIF
NEXT
;---- EDIT 023 MOD END ---------------------------

;---------------------------------------
;習得スキル消去関数
;
;ARG		セットする対象のキャラ登録番号
;ARGS		通常形態/変身形態の指定　デフォルトでは両方消す
;---------------------------------------
@CLEAR_ALL_LEARN_SKILL, ARG, ARGS = "両形態"
#DIM LCOUNT
#DIM  DYNAMIC L_SKILL
FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
	IF ARGS == "両形態" || ARGS == "通常形態"
		L_SKILL = ABL:ARG:@"습득스킬{LCOUNT}"
		SIF IS_PU_SKILLNUM(L_SKILL) && !HAVE_SKILL(ARG, L_SKILL)
			CSTR:ARG:@"전용기{L_SKILL - [[스킬:전용기1]] + 1}" '= ""
		ABL:ARG:@"습득스킬{LCOUNT}" = 0
		ABL:ARG:@"습득LV{LCOUNT}" = 0	
	ENDIF
	IF ARGS == "両形態" || ARGS == "変身形態"
		L_SKILL = ABL:ARG:@"초기변신악마습득스킬{LCOUNT}"
		SIF IS_PU_SKILLNUM(L_SKILL) && !HAVE_SKILL(ARG, L_SKILL)
			CSTR:ARG:@"전용기{L_SKILL - [[스킬:전용기1]] + 1}" '= ""
		ABL:ARG:@"초기변신악마습득스킬{LCOUNT}" = 0
		ABL:ARG:@"초기변신악마습득LV{LCOUNT}" = 0	
	ENDIF
NEXT

;---------------------------------------
;自力習得スキルの確認関数
;ARG		セットする対象のキャラ登録番号
;ARGS		セットするスキルの名称。"1"でヤマオロシのように数字指定も一応可能
;			専用スキル/XXXXで専用スキルの指定
;ARGS:1		通常形態/変身形態の指定
;---------------------------------------
@IS_LEARNED_SKILL, ARG, ARGS, ARGS:1
#FUNCTION
#DIM L_NUM
#DIM L_SKILL
#DIMS L_SKILLS
SIF ARGS == ""
	RETURNF 0
IF ARGS:1 == ""
	L_NUM = CFLAG:ARG:악마변신 ? 1 # 0
ELSE
	L_NUM = ARGS:1 == "通常形態" ? 0 # 1
ENDIF
;スキルを名称指定しているかを確認
L_SKILL = SKILL_NUM_F(ARGS)
;番号が帰ってきてるなら名称指定
IF L_SKILL >= 0
	L_SKILLS = %TOSTR(L_SKILL)%
;帰ってきてないなら番号指定or専用スキルの名称指定で、どちらもそのままで良い
ELSE
	;---- EDIT 020 MOD START -------------------------
	IF ISNUMERIC(ARGS)
		L_SKILL = TOINT(ARGS)
		;専用スキルかどうかを確認
		IF IS_PU_SKILLNUM(L_SKILL)
			L_SKILLS = %CSTR:ARG:@"전용기{(L_SKILL - [[스킬:전용기1]] + 1)}"%
		ELSE
			L_SKILLS = %ARGS%
		ENDIF
	ELSE
		L_SKILLS = %ARGS%
	ENDIF
	;---- EDIT 020 MOD END ---------------------------
ENDIF
RETURNF COUNT_SPLIT(C_LEARNED_SKILLS:ARG:L_NUM, "/", L_SKILLS)

;---------------------------------------
;自力習得スキルの履歴獲得関数
;ARG		セットする対象のキャラ登録番号
;ARGS		セットするスキルの名称。"1"でヤマオロシのように数字指定も一応可能
;ARGS:1		通常形態/変身形態の指定
;---------------------------------------
@SET_LEARNED_SKILL, ARG, ARGS, ARGS:1
#DIM L_NUM
#DIM L_SKILL
#DIMS L_SKILLS
SIF ARGS == ""
	RETURN 0
IF ARGS:1 == ""
	L_NUM = CFLAG:ARG:악마변신 ? 1 # 0
ELSE
	L_NUM = ARGS:1 == "通常形態" ? 0 # 1
ENDIF
IF ISNUMERIC(ARGS)
	L_SKILLS = %GET_SKILL_TO_STRFLAG(ARGS, ARG)%
ELSE
	L_SKILLS = %ARGS%
ENDIF
SIF COUNT_SPLIT(C_LEARNED_SKILLS:ARG:L_NUM, "/", L_SKILLS)
	RETURN 0
C_LEARNED_SKILLS:ARG:L_NUM = %ADD_SPLIT(C_LEARNED_SKILLS:ARG:L_NUM, "/", L_SKILLS)%
RETURN 1

;---- EDIT 009 ADD START -------------------------
;---------------------------------------
;スキルのSTRFLAG登録用の名称取得関数
;ARG		キャラ登録番号(専用技の判定に必要になる場合がある)
;ARGS		セットするスキルの名称。"1"でヤマオロシのように数字指定も一応可能
;			専用スキル/XXXXで専用スキルの指定
;---------------------------------------
@GET_SKILL_TO_STRFLAG, ARGS, ARG = -1
#FUNCTIONS
#DIM L_SKILL
#DIMS L_SKILLS
SIF ARGS == ""
	RETURNF ""
;専用スキルとして登録されているものが来てるならそのまま流す
IF ARG >= 0 && PU_SKILLNUM_GET(ARG, ARGS) >= 0
	L_SKILLS = %ARGS%
ELSE
	;名称指定かどうかを確認
	L_SKILL = SKILL_NUM_F(ARGS)
	;番号指定かどうかを確認
	L_SKILL = L_SKILL == -1 ? TOINT(ARGS) # L_SKILL
	;TOINTで0になってしまったのなら名称が不正
	SIF !L_SKILL
		RETURNF ""
	;専用スキルの番号が送られてきているのなら、専用技の名称を確保する
	IF IS_PU_SKILLNUM(L_SKILL) > 0
		;キャラ指定なしなら終わる
		IF ARG < 0
			RETURNF ""
		ELSE
			L_SKILLS = %CSTR:ARG:@"전용기{(L_SKILL - [[스킬:전용기1]] + 1)}"%
			SIF L_SKILLS == ""
				RETURNF ""
		ENDIF
	ELSE
		L_SKILLS = %TOSTR(L_SKILL)%
	ENDIF
ENDIF
RETURNF L_SKILLS

;---- EDIT 021 ADD START -------------------------
;---------------------------------------
;再習得リストから特定のスキルを抜く関数
;ARG		キャラクター登録番号
;ARGS		スキルの番号 / 명칭。指定方式はGET_SKILL_TO_STRFLAG参照
;ARGS:1		形態の指定	
;---------------------------------------
@CLEAR_LEARNED_SKILL, ARG, ARGS, ARGS:1 = "両形態"
#DIM LCOUNT
#DIMS L_SKILLS
FOR LCOUNT, 0, 2
	SIF LCOUNT == 0 && !(ARGS:1 == "両形態" || ARGS:1 == "通常形態")
		CONTINUE
	SIF LCOUNT == 1 && !(ARGS:1 == "両形態" || ARGS:1 == "変身形態")
		CONTINUE
	C_LEARNED_SKILLS:ARG:LCOUNT '= "/" + C_LEARNED_SKILLS:ARG:LCOUNT + "/"
	C_LEARNED_SKILLS:ARG:LCOUNT '= REPLACE(C_LEARNED_SKILLS:ARG:LCOUNT, "/" + GET_SKILL_TO_STRFLAG(ARGS, ARG) + "/", "/")
	C_LEARNED_SKILLS:ARG:LCOUNT '= SUBSTRING(C_LEARNED_SKILLS:ARG:LCOUNT, 1, STRLENS(C_LEARNED_SKILLS:ARG:LCOUNT) - 2)
NEXT
;---- EDIT 021 ADD END ---------------------------
;---- EDIT 009 ADD END ---------------------------
;---------------------------------------
;再習得リストからすべてのスキルを抜く関数
;ARG		キャラクター登録番号
;ARGS:1		形態の指定	
;---------------------------------------
@CLEAR_LEARNED_SKILL_ALL, ARG, ARGS = "両形態"
SIF ARGS == "両形態" || ARGS == "通常形態"
	C_LEARNED_SKILLS:ARG:0 = 
SIF ARGS == "両形態" || ARGS == "変身形態"
	C_LEARNED_SKILLS:ARG:1 = 

;---- EDIT 018 ADD START -------------------------
;---------------------------------------
;指定したスキルの所持可能かの判定関数
;SKILLNUM	スキルの番号
;L_CHARA	キャラクター登録番号。省略した場合はキャラが関わる要素があるスキルは自動的に所持不能と判定
;L_OPT		レベル習得時:レベルアップで習得する / 初期スキル等で一部の条件を無視できる場合
;---------------------------------------
@IS_SKILL_HAVEABLE, L_SKILLNUM, L_CHARA = -1, TRANS_MODE = "通常形態", L_OPT
#DIM L_SKILLNUM
#DIM L_CHARA
#DIMS L_ROLE
#DIMS L_OPT
#DIMS TRANS_MODE
#DIM L_SKILL_SUCCESSION
;0は常にスキル枠に入れられる
SIF L_SKILLNUM == 0
	RETURN 1
;敵は味方専用であるかどうか確認する
IF L_CHARA >= 0 && !CFLAG:L_CHARA:PT플래그
	CALL GET_SKILL_PROP, "味方専用", L_SKILLNUM, L_CHARA
	IF RESULT
		SIF L_CHARA < 0
			RETURN 0
	ENDIF
ELSE
	CALL GET_SKILL_PROP, "敵専用", L_SKILLNUM, L_CHARA
	SIF RESULT || L_CHARA < 0
		RETURN 0
	CALL GET_SKILL_PROP, "ロール専用", L_SKILLNUM, L_CHARA
	IF RESULT
		IF L_ROLE == ""
			IF L_CHARA < 0
				RETURN 0
			ELSE
				SIF !STRCOUNT(GETS_ROLE_PROP("CAN_USE_SPECIAL_SKILL", L_CHARA, ,TRANS_MODE), RESULTS)
					RETURN 0
			ENDIF
		ELSE
			SIF !STRCOUNT(GETS_ROLE_PROP("CAN_USE_SPECIAL_SKILL", , L_ROLE, TRANS_MODE), RESULTS)
				RETURN 0
		ENDIF
	ENDIF
	;キャラの習得能力によるチェック
	IF L_CHARA >= 0
		;自力で覚えたスキルは習得可能スキルとして扱う
		IF !IS_LEARNED_SKILL(L_CHARA, TOSTR(L_SKILLNUM), TRANS_MODE)
			IF !STRCOUNT(L_OPT, "レベル習得時")
				;継承タイプの取得及び使用可能状況の判定
				CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILLNUM, L_CHARA
				L_SKILL_SUCCESSION = RESULT
				;1 = 自動効果のみ	2 = 자동효과 + 継承素質を持つもの
				SELECTCASE GET_SKILL_CHANGEABLE_RANK(L_CHARA, TRANS_MODE)
					CASE 3
					CASE 2
						SIF L_SKILL_SUCCESSION != 22 && !相性素質チェック_F(L_CHARA, L_SKILL_SUCCESSION, TRANS_MODE)
							RETURN 0
					CASE 1
						SIF L_SKILL_SUCCESSION != 22
							RETURN 0
					;取得不能
					CASE 0
						RETURN 0
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
;---- EDIT 018 ADD END ---------------------------

;---------------------------------------
;習得スキルセット関数
;所持スキルと習得予定のスキルである場合はセットしない
;セットに使う番号は開いている番号を探して詰める
;
;ARG		セットする対象のキャラ登録番号
;ARGS		セットするスキルの名称。"1"でヤマオロシのように数字指定も一応可能
;			専用スキル/XXXXで専用スキルの指定
;ARG:1		習得レベルの指定
;ARGS:1		通常形態/変身形態の指定
;ARGS:2		スキルを習得した場合、メッセージ表示でメッセージ表示 / 入れ替え確認　その場で入れ替えを確認させる場合
;---------------------------------------
@SET_LEARN_SKILL, ARG, ARGS, ARG:1, ARGS:1 = "通常形態", ARGS:2 = "メッセージ非表示"
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC  L_PU_SKILL
#DIM DYNAMIC L_SKILL
#DIMS DYNAMIC  L_SKILLS
#DIM DYNAMIC L_CHANGEABLE_SKILLCOUNT
#DIM DYNAMIC L_EMPTY;스킬/習得スキルの空き番号を入れる
#DIM DYNAMIC SKILL_LIST, HAVEABLE_SKILLNUM
;先にスキル内容を更新しておく
CALL FIX_CHARA_TRANS_SKILL, ARG
L_EMPTY = 0
;専用スキルは専用スキルのセットを試してから番号を取る
IF STRCOUNT(ARGS, "CSTR専用スキル/")
	L_PU_SKILL = %AUTO_SPLIT(ARGS, "/", 1)%
	CALL PU_SKILL_ADD, ARG, L_PU_SKILL
	L_SKILL = PU_SKILLNUM_GET(ARG, L_PU_SKILL)
	SIF L_SKILL < 0
		RETURN 0
ELSE
	;---- EDIT 013 MOD START -------------------------
	IF ISNUMERIC(ARGS)
		L_SKILL = TOINT(ARGS)
	ELSE
		L_SKILL = SKILL_NUM_F(ARGS)
	ENDIF
	;---- EDIT 013 MOD END ---------------------------
ENDIF
SIF L_SKILL <= 0
	THROW スキルの指定[ARGS : %ARGS%]が不正です。
IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	IF ARGS:1 == "通常形態"
		L_SKILLS = 인간시스킬
	ELSE
		L_SKILLS = 초기변신악마스킬
	ENDIF
	;判定用のリストを作る
	FOR LCOUNT, 0, HAVEABLE_SKILLNUM
		IF ARGS:1 == "通常形態"
			IF CFLAG:ARG:악마변신
				SKILL_LIST:LCOUNT = ABL:ARG:@"인간시스킬{LCOUNT + 1}"
			ELSE
				SKILL_LIST:LCOUNT = ABL:ARG:@"스킬{LCOUNT + 1}"
			ENDIF
		ELSE
			IF CFLAG:ARG:악마변신
				IF FINDCHARA_LINK(ARG) < 0
					SKILL_LIST:LCOUNT = ABL:ARG:@"스킬{LCOUNT + 1}"
				ELSE
					SKILL_LIST:LCOUNT = ABL:ARG:@"초기변신악마스킬{LCOUNT + 1}"
				ENDIF
			ELSE
				SKILL_LIST:LCOUNT = ABL:ARG:@"초기변신악마스킬{LCOUNT + 1}"
			ENDIF
		ENDIF
	NEXT
ELSE
	L_SKILLS = 스킬
	FOR LCOUNT, 0, HAVEABLE_SKILLNUM
		SKILL_LIST:LCOUNT = ABL:ARG:@"스킬{LCOUNT + 1}"
	NEXT
ENDIF

;すでに習得しているかどうかを確認し、習得しているのならば終わる。また空き番号を確保しておく
FOR LCOUNT, 1, GET_ROLE_PROP("CHANGEABLE_SKILLCOUNT", ARG, , ARGS:1) + 1
	;習得スキルを所持していた場合は終わり
	IF MATCH(SKILL_LIST, L_SKILL)
		;習得済みスキルに入れておく
		CALL SET_LEARNED_SKILL, ARG, TOSTR(L_SKILL), ARGS:1
		RETURN 0
	ENDIF
	SIF ABL:ARG:@"%L_SKILLS%{LCOUNT}" == 0 && L_EMPTY == 0
		L_EMPTY = LCOUNT
NEXT

;---- EDIT 015 MOD START -------------------------
;習得レベルを超えている場合、
IF BASE:ARG:LV >= ARG:1 && (L_EMPTY || STRCOUNT(ARGS:2, "入れ替え確認"))
	;スキルに空きがあるなら直接習得させて終了
 	IF L_EMPTY
		CALL SET_FRIEND_HAVE_SKILL, ARG, L_SKILL, ARGS:1, L_EMPTY
		;スキルの習得履歴に追加
		IF STRCOUNT(ARGS:2, "メッセージ表示") || STRCOUNT(ARGS:2, "入れ替え確認")
			;スキルチェンジで名称が変わっている可能性があるので名前をちゃんと呼び出す
			CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, ARG
			PRINTFORMW %CALLNAME:ARG%은(는) %RESULTS%을(를) 습득했다.
		ENDIF
	;入れ替え確認のときは習得させる
	ELSE
		CALL LEARN_SKILL, ARG, L_SKILL, ARGS:1 == "変身形態" ? 1 # 0
	ENDIF
	CALL SET_LEARNED_SKILL, ARG, TOSTR(L_SKILL), ARGS:1
	RETURN 1
ENDIF
;---- EDIT 015 MOD END ---------------------------

;すでに習得スキルに入っていないか確認する。
L_EMPTY = 0
FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
	IF ARGS:1 == "変身形態"
		IF ABL:ARG:@"초기변신악마습득스킬{LCOUNT}" == L_SKILL
			IF ABL:ARG:@"초기변신악마습득LV{LCOUNT}" == 0
				ABL:ARG:@"초기변신악마습득LV{LCOUNT}" = ARG:1
				RETURN 1
			ELSE
				RETURN 0
			ENDIF
		ENDIF
		IF !L_EMPTY
			SIF ABL:ARG:@"초기변신악마습득LV{LCOUNT}" == 0
				L_EMPTY = LCOUNT
		ENDIF
	ELSE
		IF ABL:ARG:@"습득스킬{LCOUNT}" == L_SKILL
			IF ABL:ARG:@"습득LV{LCOUNT}" == 0
				ABL:ARG:@"습득LV{LCOUNT}" = ARG:1
				RETURN 1
			ELSE
				RETURN 0
			ENDIF
		ENDIF
		IF !L_EMPTY
			SIF ABL:ARG:@"습득LV{LCOUNT}" == 0
				L_EMPTY = LCOUNT
		ENDIF
	ENDIF
NEXT
;空き番号がないのなら終わる
SIF !L_EMPTY
	RETURN 0
IF ARGS:1 == "変身形態"
	ABL:ARG:@"초기변신악마습득스킬{L_EMPTY}" = L_SKILL
	ABL:ARG:@"초기변신악마습득LV{L_EMPTY}" = ARG:1	
ELSE
	ABL:ARG:@"습득스킬{L_EMPTY}" = L_SKILL
	ABL:ARG:@"습득LV{L_EMPTY}" = ARG:1	
ENDIF
RETURN 1

;---- EDIT 018 MOD START ---------------------------
;---------------------------------------
;ARGが味方として所持出来ないスキルや条件付きで所持できるスキルを判別して削除する
;ARG:1が真のときは置換・削除メッセージを出す
;---------------------------------------
@EXCLUDE_UNABLE_SKILL, ARG, ARG:1
#DIM LCOUNT, 2
#DIM L_SKILL,2
#DIMS L_SKILLS, 3
#DIMS L_TRANS
#DIM L_PERSONA
IF !TALENT:ARG:페르소나구사자
	FOR LCOUNT:1, 0, 5
		FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
			SELECTCASE LCOUNT:1
				CASE 0
					L_SKILLS:2 = 스킬
					L_SKILLS = 스킬{LCOUNT}
					L_SKILLS:1 = 
					L_TRANS = 通常形態
				CASE 1
					L_SKILLS:2 = 습득스킬
					L_SKILLS = 습득스킬{LCOUNT}
					L_SKILLS:1 = 습득LV{LCOUNT}
					L_TRANS = 通常形態
				CASE 2
					L_SKILLS:2 = 인간시스킬
					L_SKILLS = 인간시스킬{LCOUNT}
					L_SKILLS:1 = 
					L_TRANS = 通常形態
				CASE 3
					L_SKILLS:2 = 초기변신악마스킬
					L_SKILLS = 초기변신악마스킬{LCOUNT}
					L_SKILLS:1 = 
					L_TRANS = 変身形態
				CASE 4
					L_SKILLS:2 = 초기변신악마습득스킬
					L_SKILLS = 초기변신악마습득스킬{LCOUNT}
					L_SKILLS:1 = 초기변신악마습득LV{LCOUNT}
					L_TRANS = 変身形態
			ENDSELECT
			L_SKILL = ABL:ARG:L_SKILLS
			CALL GET_SKILL_PROP, "敵専用", L_SKILL, ARG
			IF RESULT == 1
				SIF ARG:1
					CALL MESSAGE_B, 1, @"%CALLNAME:ARG%が【%SKILL_NAME_F(L_SKILL)%】の所持条件を満たしていないため、スキルが削除されました。"
				;---- EDIT 021 ADD START -------------------------
				CALL CLEAR_LEARNED_SKILL, ARG, TOSTR(ABL:ARG:L_SKILLS)
				;---- EDIT 021 ADD END ---------------------------
				ABL:ARG:L_SKILLS = 0
				SIF L_SKILLS:1 != ""
					ABL:ARG:(L_SKILLS:1) = 0
				CONTINUE
			ENDIF
			;ロール指定スキルを削除
			CALL GET_SKILL_PROP, "ロール専用", L_SKILL, ARG
			IF RESULT == 1
				IF !STRCOUNT(GETS_ROLE_PROP("CAN_USE_SPECIAL_SKILL", ARG, L_TRANS), RESULTS)
					;---- EDIT 007 ADD START -------------------------
					;代わりに取得するスキルの判定をする
					CALL GET_SKILL_PROP, "置換スキル", L_SKILL, ARG
					L_SKILL:1 = RESULT
					IF L_SKILL:1 > 0
						FOR LCOUNT:1, 1, HAVEABLE_SKILLNUM + 1
							SIF ABL:ARG:@"%L_SKILLS:2%{LCOUNT:1}" != L_SKILL:1
								CONTINUE
							L_SKILL:1 = 0
							BREAK
						NEXT
					ENDIF
					IF ARG:1
						IF L_SKILL:1 == 0
							CALL MESSAGE_B, 1, @"%CALLNAME:ARG%が【%SKILL_NAME_F(L_SKILL)%】の所持条件を満たしていないため、スキルが削除されました。"
						ELSE
							CALL MESSAGE_B, 2, @"%CALLNAME:ARG%が【%SKILL_NAME_F(L_SKILL)%】の所持条件を満たしていないため、", @"スキルが【%SKILL_NAME_F(L_SKILL:1)%】に置き換えられました。"
						ENDIF
					ENDIF
					;---- EDIT 021 ADD START -------------------------
					CALL CLEAR_LEARNED_SKILL, ARG, TOSTR(ABL:ARG:L_SKILLS)
					;---- EDIT 021 ADD END ---------------------------
					ABL:ARG:L_SKILLS = L_SKILL:1
					SIF L_SKILLS:1 != "" && !L_SKILL:1
						ABL:ARG:(L_SKILLS:1) = 0
					CONTINUE
					;---- EDIT 007 ADD END ---------------------------
				ENDIF
			ENDIF
		NEXT
	NEXT
ELSE
	;---- EDIT 012 MOD START -------------------------
	IF TALENT:ARG:페르소나구사자
		L_PERSONA = CFLAG:ARG:초기페르소나넘버
		FOR LCOUNT:1, 0, 2
			FOR LCOUNT, 1, 21
				SIF LCOUNT:1 == 0 && LCOUNT >= 9
					BREAK
				RESULT = 0
				IF LCOUNT:1
					L_SKILLS = 습득스킬{LCOUNT}
				ELSE
					L_SKILLS = 스킬{LCOUNT}
				ENDIF
				L_SKILL = DITEMTYPE:L_PERSONA:페르소나(L_SKILLS)
				CALL GET_SKILL_PROP, "敵専用", L_SKILL, -1
				IF RESULT == 1
					DITEMTYPE:L_PERSONA:페르소나(L_SKILLS) = 0
					SIF ARG:1
						CALL MESSAGE_B, 1, @"%CALLNAME:ARG%が【%SKILL_NAME_F(L_SKILL)%】の所持条件を満たしていないため、スキルが削除されました。"
				ENDIF
				CALL GET_SKILL_PROP, "ロール専用", L_SKILL, -1
				IF RESULT == 1
					;代わりに取得するスキルの判定をする
					CALL GET_SKILL_PROP, "置換スキル", L_SKILL, -1
					L_SKILL:1 = RESULT
					IF ARG:1
						IF L_SKILL:1 == 0
							CALL MESSAGE_B, 1, @"%CALLNAME:ARG%が【%SKILL_NAME_F(L_SKILL)%】の所持条件を満たしていないため、スキルが削除されました。"
						ELSE
							CALL MESSAGE_B, 2, @"%CALLNAME:ARG%が【%SKILL_NAME_F(L_SKILL)%】の所持条件を満たしていないため、", @"スキルが【%SKILL_NAME_F(L_SKILL:1)%】に置き換えられました。"
						ENDIF
					ENDIF
					DITEMTYPE:L_PERSONA:페르소나(L_SKILLS) = L_SKILL:1
				ENDIF
			NEXT
		NEXT
	ENDIF
ENDIF
;---- EDIT 012 MOD END ---------------------------
;---- EDIT 018 MOD END ---------------------------
;---------------------------------------
;ARGが味方として所持出来ないスキルや条件付きで所持できるスキルを判別して削除する
;---------------------------------------
@EXCLUDE_UNABLE_SKILL_ALL_CHARA
#DIM LCOUNT, 2
FOR LCOUNT, 0, CHARANUM
	CALL EXCLUDE_UNABLE_SKILL, LCOUNT
NEXT
FOR LCOUNT, 1, 9
	CALL GET_SKILL_PROP, "敵専用", DITEMTYPE:(LCOUNT:1):페르소나(@"스킬{LCOUNT}"), -1
	SIF RESULT == 1
		DITEMTYPE:(LCOUNT:1):페르소나(@"스킬{LCOUNT}") = 0
	CALL GET_SKILL_PROP, "ロール専用", DITEMTYPE:(LCOUNT:1):페르소나(@"스킬{LCOUNT}"), -1
	SIF RESULT == 1
		DITEMTYPE:(LCOUNT:1):페르소나(@"스킬{LCOUNT}") = 0
NEXT
FOR LCOUNT:1, 1, 11
	FOR LCOUNT, 1, 21
		CALL GET_SKILL_PROP, "敵専用", DITEMTYPE:(LCOUNT:1):페르소나(@"습득스킬{LCOUNT}"), -1
		SIF RESULT == 1
			DITEMTYPE:(LCOUNT:1):페르소나(@"습득스킬{LCOUNT}") = 0
		CALL GET_SKILL_PROP, "ロール専用", DITEMTYPE:(LCOUNT:1):페르소나(@"습득스킬{LCOUNT}"), -1
		SIF RESULT == 1
			DITEMTYPE:(LCOUNT:1):페르소나(@"습득스킬{LCOUNT}") = 0
	NEXT
NEXT
;---- EDIT 084 ADD END ---------------------------

;---------------------------------------
;置換スキルの番号を取る
;---------------------------------------
@GET_REPLACE_SKILL, L_SKILL, L_CHARA = -1, TRANS_MODE = "通常形態"
#DIM DYNAMIC L_SKILL
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC TRANS_MODE
#DIM DYNAMIC IS_SUCCESS_ABLE
IS_SUCCESS_ABLE = 1
;置換チェック
CALL GET_SKILL_PROP, "継承不能", L_SKILL, L_CHARA
SIF RESULT
	IS_SUCCESS_ABLE = 0
CALL GET_SKILL_PROP, "ロール専用", L_SKILL, -1
IF RESULT
	IF L_CHARA >= 0
		SIF !STRCOUNT(GETS_ROLE_PROP("CAN_USE_SPECIAL_SKILL", L_CHARA, TRANS_MODE), RESULTS)
			IS_SUCCESS_ABLE = 0
	ELSE
		IS_SUCCESS_ABLE = 0
	ENDIF
ENDIF
IF IS_SUCCESS_ABLE == 0
	CALL GET_SKILL_PROP, "置換スキル", L_SKILL, L_CHARA
	SIF RESULT > 0
		L_SKILL = RESULT
ENDIF
RETURN L_SKILL

;---------------------------------------
;指定したスキルに対応する継承部位を持っているか
;---------------------------------------
@HAVE_SKILL_SUCCESSION_BODY, L_CHARA, L_SKILL
#DIM LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_SKILL
CALL GET_SKILL_PROP, "継承部位", L_SKILL, L_CHARA
SIF RESULT == 0
	RETURN 0
FOR LCOUNT, 0, FINDELEMENT(RESULTS, "", , , 1)
	SIF TALENT:L_CHARA:(RESULTS:LCOUNT)
		RETURN 1
NEXT
RETURN 0


;---------------------------------------
;固有スキルの習得リストの適正化
;
;戻り値:0 = 固有スキルの習得リストが存在しないか、あるいは存在しなくなった場合
;		1 = リストになんらかのスキルが存在する状態で戻された
;---------------------------------------
@FIX_SPECIAL_LEARN_SKILL, L_CHARA, TRANS_MODE = "自動選別"
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC TRANS_MODE
#DIMS DYNAMIC TEMPS
#DIMS TEMP_SKILLS, 100
IF TRANS_MODE == "自動選別"
	IF CFLAG:L_CHARA:악마변신
		TEMPS = 초기변신악마MAG스킬습득리스트
	ELSE
		TEMPS = MAG습득스킬리스트
	ENDIF
ELSE
	IF TRANS_MODE == "通常形態"
		TEMPS = MAG습득스킬리스트
	ELSE
		TEMPS = 초기변신악마MAG스킬습득리스트
	ENDIF
ENDIF
SIF CSTR:L_CHARA:TEMPS == ""
	RETURN 0
SPLIT CSTR:L_CHARA:TEMPS, "/", TEMP_SKILLS
;一度クリアする
CSTR:L_CHARA:TEMPS '= ""
FOR LCOUNT, 0, RESULT
	CALL GETS_SKILL_PROP, "SKILL_NAME", TEMP_SKILLS:LCOUNT, L_CHARA
	SIF RESULTS == ""
		CONTINUE
	IF ISNUMERIC(TEMP_SKILLS:LCOUNT)
		SIF HAVE_SKILL(L_CHARA, TOINT(TEMP_SKILLS:LCOUNT))
			CONTINUE
	ELSE
		SIF HAVE_PU_SKILL(L_CHARA, TEMP_SKILLS:LCOUNT)
			CONTINUE
	ENDIF
	SIF IS_LEARNED_SKILL(L_CHARA, TEMP_SKILLS:LCOUNT, TRANS_MODE)
		CONTINUE
	CALL GETS_SKILL_PROP, "ロール専用", TEMP_SKILLS:LCOUNT, L_CHARA
	IF RESULT
		IF !COUNT_SPLIT(GETS_ROLE_PROP("CAN_USE_SPECIAL_SKILL", L_CHARA, TEMP_SKILLS:LCOUNT), "/", RESULTS)
			CALL GETS_SKILL_PROP, "置換スキル", TEMP_SKILLS:LCOUNT, L_CHARA
			IF RESULT
				TEMP_SKILLS:LCOUNT = {RESULT}
			ELSE
				CONTINUE
			ENDIF
		ENDIF
	ENDIF
	;つなぎなおす
	SIF CSTR:L_CHARA:TEMPS != ""
		CSTR:L_CHARA:TEMPS += "/"
	CSTR:L_CHARA:TEMPS += TEMP_SKILLS:LCOUNT
NEXT
RETURN CSTR:L_CHARA:TEMPS != ""