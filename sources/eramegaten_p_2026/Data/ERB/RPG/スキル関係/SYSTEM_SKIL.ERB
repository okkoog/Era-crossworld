SIF RESULT
	RETURN 1
CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", ARG, -1
SIF RESULT > 22&& RESULT < 0
	RETURN 1

;ランクによる判定
CALL GET_SKILL_PROP, "SKILL_RANK", ARG, -1
SIF RESULT <= 0 || RESULT > 15
	RETURN 1
RETURN 0

