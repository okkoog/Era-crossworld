;==========================================
;スキルカード作成必要性忠誠度
;==========================================
@COUNT_ABLE_MAKE_SKILLCARD, ARG
#FUNCTION
#DIM L_LOYALTY
#DIM L_CNT
L_CNT = 0
L_LOYALTY = GET_CHARA_LOYALTY(ARG)
WHILE L_LOYALTY >= GET_LOYALTY_FOR_MAKE_SKILLCARD(ARG, "必要", L_CNT)
	L_LOYALTY -= GET_LOYALTY_FOR_MAKE_SKILLCARD(ARG, "消費", L_CNT)
	L_CNT++
	;100枚でとりあえず打ち切る
	SIF L_CNT == 100
		RETURNF 100
WEND
RETURNF L_CNT
