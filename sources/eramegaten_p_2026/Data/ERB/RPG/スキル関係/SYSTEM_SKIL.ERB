;==========================================
;スキルカード作成用のスキル一覧
;==========================================
@MAKE_SKILLCARD_LIST, L_CHARA, TRANS_MODE = "通常形態", CAN_NOT_MAKE_SKILLCARD
#DIMS TRANS_MODE
#DIM L_CHARA
#DIM LCOUNT
#DIM L_SKILL
#DIM REF CAN_NOT_MAKE_SKILLCARD
VARSET CAN_NOT_MAKE_SKILLCARD
FOR LCOUNT, 0, CHARA_SKILLCOUNT(L_CHARA, TRANS_MODE)
	IF TRANS_MODE == "変身形態"
		L_SKILL = ABL:L_CHARA:@"초기변신악마스킬{LCOUNT + 1}"
	ELSE
		L_SKILL = ABL:L_CHARA:@"스킬{LCOUNT + 1}"
	ENDIF
	IF L_SKILL == 0
		CAN_NOT_MAKE_SKILLCARD:LCOUNT = 3
		CONTINUE
	ENDIF
	IF TRANS_MODE == "変身形態"
		;スキルロック設定がかかっているスキルを除く
		SIF GETBIT(CFLAG:L_CHARA:악마변신스킬잠금설정, LCOUNT + 1)
			CAN_NOT_MAKE_SKILLCARD:LCOUNT = 1
	ELSE
		;スキルロック設定がかかっているスキルを除く
		SIF GETBIT(CFLAG:L_CHARA:스킬잠금설정, LCOUNT + 1)
			CAN_NOT_MAKE_SKILLCARD:LCOUNT = 1
	ENDIF
	;カード化できるスキルかどうかチェック
	CALL IS_MAKEABLE_SKILLCARD, L_SKILL
	SIF !RESULT
		CAN_NOT_MAKE_SKILLCARD:LCOUNT = 2

	;-------------------------------------
	;表示の開始
	;-------------------------------------
	SIF CAN_NOT_MAKE_SKILLCARD:LCOUNT == 1
		SETCOLOR COLOR("yellow")
	SIF CAN_NOT_MAKE_SKILLCARD:LCOUNT == 2
		SETCOLOR COLOR("gray")
	CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, L_CHARA
	PRINTFORM [{LCOUNT + 1, 2}] %RESULTS, SKILLNAMELENS, LEFT%　
	IF CAN_NOT_MAKE_SKILLCARD:LCOUNT == 2
		PRINT 카드화불능　　
	ELSEIF CAN_NOT_MAKE_SKILLCARD:LCOUNT == 1
		PRINT ROCKED　　　　　
	ELSE
		PRINT 　　　　　　　　
	ENDIF
	PRINTFORM 소지매수:{ITEM:(10000 + L_SKILL) ,3}　　
	IF IS_LEARNED_SKILL(L_CHARA, TOSTR(L_SKILL), TRANS_MODE)
		CALL PRINT_COLOR, "재습득가능　　", COLOR("p-green")
	ELSE
		PRINT 　　　　　　　
	ENDIF
	SIF ABLE_MAKESKILLCARD(L_SKILL)
		CALL PRINT_COLOR, "복제가능　　　", COLOR("p-red")
	PRINTL 
	RESETCOLOR
NEXT
