@GET_LOYALTY_FOR_MAKE_SKILLCARD, ARG, ARGS = "必要", ARG:1
#FUNCTION
IF ARGS == "消費"
	RETURNF (2 + CFLAG:ARG:스킬추출횟수 + ARG:1) * 250
ELSE
	RETURNF (4 + CFLAG:ARG:스킬추출횟수 + ARG:1) * 250
ENDIF
