;==========================================================
;==========================================================
;スキルカードシステム
;スキルカード一覧表示
;==========================================================
@SHOW_SKILL_CARD
#DIM 選択スキル
#DIM 選択スキル系統
#DIM ページ
#DIM ライン
#LOCALSIZE 2

REDRAW 0
選択スキル系統 = -1
選択スキル = -1
ページ = 0
ライン = LINECOUNT
CALL スキルカード在庫確認()
FOR LOCAL, 0, 24
	X:LOCAL = Z:LOCAL
NEXT


$START
CLEARLINE LINECOUNT - ライン
CUSTOMDRAWLINE =
IF 選択スキル > -1
	PRINTFORML 【%SKILL_NAME_F(選択スキル)%】
	SIF FLAG:스킬속성표시설정 == 1
		CALL SKILL_EXPLAIN_PERFORMANCE, 選択スキル, -1
	CALL GET_SKILL_PROP, "SKILL_EXPLAIN", 選択スキル, -1
ELSE
	PRINTFORML \@ 選択スキル系統 == -1 ? 어느 계통의 스킬 카드를 확인하겠습니까? # 어느 스킬의 설명을 보겠습니까? \@
	PRINTL
ENDIF
DRAWLINE
IF 選択スキル系統 > -1
	FOR LOCAL, ページ*20 , (ページ+1)*20
		IF HAVE_SKILLCARD_LIST:LOCAL > 0
			CALL GET_SKILL_PROP, "SKILL_NAME", HAVE_SKILLCARD_LIST:LOCAL, -1
			IF GETBIT(FLAG:커스텀게임화면,1)
				PRINTFORM [{HAVE_SKILLCARD_LIST:LOCAL,4}] %RESULTS,38,LEFT% × {ITEM:(10000+HAVE_SKILLCARD_LIST:LOCAL),3}\@ABLE_MAKESKILLCARD(HAVE_SKILLCARD_LIST:LOCAL)?　복제可　#　　　　　\@
			ELSE
				PRINTFORM [{HAVE_SKILLCARD_LIST:LOCAL,4}] %RESULTS,20,LEFT% × {ITEM:(10000+HAVE_SKILLCARD_LIST:LOCAL),3}\@ABLE_MAKESKILLCARD(HAVE_SKILLCARD_LIST:LOCAL)?　복제可　#　　　　　\@
			ENDIF
			RESETCOLOR
		ENDIF
		SIF LOCAL % 2 == 1
			PRINTL
	NEXT
ELSE
	PRINTFORM %"\n" * 10%
ENDIF
DRAWLINE
FOR LOCAL,0,24
	;使えるカードが無い系統は暗く表示
	SIF LOCAL == 21
		CONTINUE
	IF LOCAL == 選択スキル系統
		SETCOLOR COLOR("水色")
	ELSEIF X:LOCAL == 0
		SETCOLOR 0x606060
	ENDIF
	;IF LOCAL == 22
	;	PRINTFORM [4022] 자동효과
	;ELSEIF LOCAL == 23
	;	PRINTFORML [4023] レア
	;ELSE
	PRINTFORM [{4000+LOCAL}] %GET_SUCCESSION(LOCAL)%　　
	;ENDIF
	RESETCOLOR
	SIF LOCAL % 6 == 5 || LOCAL == 20
		PRINTL
NEXT
DRAWLINE
PRINTFORMLC \@(ページ <= 0) ? %" " * 16% # [3007]이전페이지\@
PRINTLC [0]돌아간다
PRINTFORMLC \@(ページ >= (LOCAL:1 - 1) / 20) ? %" " * 16% # [3009]다음페이지\@
PRINTL 
PRINTFORMLC [3004]이전계통
PRINTFORMLC 현재의계통【\@ 選択スキル系統 == -1 ? ---- #%GET_SUCCESSION(選択スキル系統)%\@】
PRINTFORMLC [3006]다음계통

$INPUT_LOOP_1
INPUT
IF RESULT == 0
	REDRAW 1
	RETURN 0
;系統選択
ELSEIF RESULT >= 4000 && RESULT <= 4023
	ページ = 0
	選択スキル系統 = RESULT - 4000
	CALL スキルカード在庫確認(選択スキル系統, , 1)
	LOCAL:1 = RESULT
	GOTO START
;系統送り
ELSEIF RESULT == 3004 || RESULT == 3006
	;---- EDIT 022 MOD START -------------------------
	ページ = 0
	IF MAXARRAY(X, 0, 24)
		DO 
			選択スキル系統 += (RESULT == 3004 ? -1 # 1)
			SIF 選択スキル系統 > 23
				選択スキル系統 = 0
			SIF 選択スキル系統 < 0
				選択スキル系統 = 23
		LOOP !X:選択スキル系統
	ENDIF
	;SIF 選択スキル系統 == 21
	;	選択スキル系統 += (RESULT == 3004 ? -1 # 1)
	CALL スキルカード在庫確認(選択スキル系統, , 1)
	LOCAL:1 = RESULT
	GOTO START
	;---- EDIT 022 MOD END ---------------------------
;ページ操作
ELSEIF (RESULT == 3007 && ページ> 0) || (RESULT == 3009 && ページ < (LOCAL:1 -1) / 20)
	ページ += (RESULT == 3007 ? -1 # 1)
	GOTO START
ELSEIF !RANGE(RESULT , 0 , VARSIZE("ITEM") - 10001) || MATCH(HAVE_SKILLCARD_LIST,RESULT) == -1 || ITEM:(10000+RESULT) < 1
	CLEARLINE 1
	GOTO INPUT_LOOP_1
ENDIF
選択スキル = RESULT
GOTO START


;==============================================================
;スキル習得用・リスト表示
;==============================================================
@SHOW_LEARN_SKILL(ARG, どっちの強化？)
#LOCALSIZE 6
#DIM どっちの強化？ , 1
LOCAL:3 = LINECOUNT
IF !LOCAL:5
	LOCAL:4 = CURRENTREDRAW()
	SIF LOCAL:4 != 2
		REDRAW 2
	LOCAL:5 = 1
ENDIF
PRINTL 어느 계통의 스킬을 습득하시겠습니까？
;CALL スキルカード在庫確認(, ARG)
CALL スキルカード在庫確認(, ARG, , どっちの強化？)
FOR LOCAL, 0, 21
	SIF FLAG:SHOP커맨드 == [[ショップ:동료마강화]] && !TALENT:ARG:GET_SUCCESSION(LOCAL)
		SETCOLOR 0xDDDDDD
	SIF (FLAG:SHOP커맨드 == [[ショップ:벨벳룸]] || FLAG:SHOP커맨드 == [[ショップ:탐색]]) && !TALENT:ARG:GET_SUCCESSION(LOCAL)
		SETCOLOR STRFLAG_EV("初期ペルソナスキル習得", 0, [[이벤트:페르소나]]) ? 0xDDDDDD # 0x404040
	SIF !Z:LOCAL	;使えるカードが無い系統は暗く表示
		SETCOLOR 0x606060
	IF FLAG:SHOP커맨드 == [[ショップ:동료마강화]]
		PRINTFORM [{LOCAL, 2}] %GET_SUCCESSION(LOCAL)%　\@ TALENT:ARG:GET_SUCCESSION(LOCAL) ? ○ # △ \@　
	ELSEIF (FLAG:SHOP커맨드 == [[ショップ:벨벳룸]] || FLAG:SHOP커맨드 == [[ショップ:탐색]])
		IF STRFLAG_EV("初期ペルソナスキル習得", 0, [[이벤트:페르소나]])
			PRINTFORM [{LOCAL, 2}] %GET_SUCCESSION(LOCAL)%　\@ TALENT:ARG:GET_SUCCESSION(LOCAL) ? ○ # △ \@　
		ELSE
			PRINTFORM [{LOCAL, 2}] %GET_SUCCESSION(LOCAL)%　\@ TALENT:ARG:GET_SUCCESSION(LOCAL) ? ○ # × \@　
		ENDIF
	ELSE
		PRINTFORM [{LOCAL,2}] %GET_SUCCESSION(LOCAL)%　　
	ENDIF
	PRINTFORM \@ LOCAL % 6 == 5 ? \n # \@
	RESETCOLOR
NEXT
SETCOLOR Z:22 ? GETCOLOR() # 0x606060
PRINT [22] 자동효과
RESETCOLOR
IF FLAG:SHOP커맨드 == [[ショップ:동료마강화]]
	SETCOLOR Z:23 ? GETCOLOR() # 0x606060
	PRINTFORM 　[23] 레어
	RESETCOLOR
ENDIF
PRINTFORML \n[100]돌아간다
$INPUT_LOOP
INPUT
IF RESULT == 100
	SIF LOCAL:4 != 2
		REDRAW LOCAL:4
	LOCAL:5 = 0
	RETURN 0
{
ELSEIF !INRANGE(RESULT, 0, 23) || RESULT == 21 || ((FLAG:SHOP커맨드 == [[ショップ:벨벳룸]] || FLAG:SHOP커맨드 == [[ショップ:탐색]]) && RESULT == 23) || 
	((FLAG:SHOP커맨드 == [[ショップ:벨벳룸]] || FLAG:SHOP커맨드 == [[ショップ:탐색]]) && RESULT != 22 && !TALENT:ARG:GET_SUCCESSION(RESULT) && 
	!STRFLAG_EV("初期ペルソナスキル習得", 0, [[이벤트:페르소나]]))
}
	CLEARLINE 1
	GOTO INPUT_LOOP
ENDIF

RESULT:10 = RESULT

CALL スキルカード在庫確認(RESULT:10, ARG, , どっちの強化？)
LOCAL:1 = RESULT
IF !LOCAL:1
	CLEARLINE 1
	REUSELASTLINE 카드를 소지하고 있지 않습니다
	GOTO INPUT_LOOP
ENDIF

;Sの中身を表示
P = 0
LOCAL:2 = LINECOUNT
$PRINT_LIST
CLEARLINE LINECOUNT - LOCAL:2
DRAWLINE
FOR LOCAL, P * 20, (P + 1) * 20
	IF HAVE_SKILLCARD_LIST:LOCAL > 0 && ITEM:(10000 + HAVE_SKILLCARD_LIST:LOCAL)
		CALL GET_SKILL_PROP, "SKILL_NAME", HAVE_SKILLCARD_LIST:LOCAL, -1
		PRINTFORM [{HAVE_SKILLCARD_LIST:LOCAL, 4}] %RESULTS, 20, LEFT% × {ITEM:(10000 + HAVE_SKILLCARD_LIST:LOCAL), 3}　　\@ LOCAL & 1 ? \n # \@
	ENDIF
NEXT
PRINTFORM \@ LINEISEMPTY() ? # \n \@
PRINTFORM \@ P && P == (LOCAL:1 - 1) / 20 ? %"\n" * MAX(0, 11 + LOCAL:2 - LINECOUNT)% # \@
DRAWLINE
PRINTFORMLC \@ P > 0 ? [3007]이전페이지 # %" " * 16% \@
PRINTLC [0]돌아간다
PRINTFORMLC \@ P < (LOCAL:1 - 1) / 20 ? [3009]다음페이지 # %" " * 16% \@
PRINTL 
$INPUT_LOOP_1
INPUT
IF RESULT == 0
	CLEARLINE LINECOUNT - LOCAL:3
	RESTART
ELSEIF RESULT == 3007 && P > 0
	P--
	GOTO PRINT_LIST
ELSEIF RESULT == 3009 && P < (LOCAL:1 - 1) / 20
	P++
	GOTO PRINT_LIST
;---- EDIT 019 MOD START -------------------------	
ELSEIF RESULT < 0 || !MATCH(HAVE_SKILLCARD_LIST, RESULT, 0, LOCAL:1) || !ITEM:(10000 + RESULT)
;ELSEIF RESULT < 0 || !MATCH(S, RESULT, 0, LOCAL:1) || !ITEM:(10000 + RESULT)
	CLEARLINE 1
	GOTO INPUT_LOOP_1
;---- EDIT 019 MOD END ---------------------------
ENDIF
SIF LOCAL:4 != 2
	REDRAW LOCAL:4
LOCAL:5 = 0
RETURN RESULT


;==========================================
;邪教の館・スキルカード作成
;種族等の判定はロールの属性に移動
;==========================================
@CASTING_MAKE_SKILLCARD(ARG:0)
;妊娠か忠誠度2000以上必要
SIF (TALENT:(ARG:0):임신 == 0 || TALENT:(ARG:0):붕괴) && GET_CHARA_LOYALTY((ARG:0)) < 500
	RETURN 0
;妊娠消えたりで面倒
SIF ((TALENT:(ARG:0):임신 && CFLAG:(ARG:0):출산예정일 - 2 <= DAY) || TALENT:(ARG:0):육아중) && FLAG:출산기능ONOFF == 1
	RETURN 0
SIF IS_RENTING(ARG:0)
	RETURN 0
SIF CFLAG:(ARG:0):이자리에없는플래그 == 1
	RETURN 0
SIF !GET_ROLE_PROP("CAN_MAKE_SKILLCARD", ARG:0)
	RETURN 0
;悪魔かつペルソナ使い　悪魔かつ達人も弾く
;SIF TALENT:(ARG:0):페르소나구사자 || TALENT:(ARG:0):달인
;	RETURN 0
RETURN 1
;---- EDIT 018 ADD START -------------------------
;==========================================
;指定したスキルがスキルカードにできるかどうかの確認関数
;==========================================
@IS_MAKEABLE_SKILLCARD, L_SKILL
#DIM L_SKILL
;ランクが値域外のものは弾く
CALL GET_SKILL_PROP, "SKILL_RANK", L_SKILL, -1
SIF !INRANGE(RESULT, 1, 15)
	RETURN 0

;継承不能スキルは弾く
CALL GET_SKILL_PROP, "継承不能", L_SKILL, -1
SIF RESULT
	RETURN 0

;敵専用スキルは弾く
CALL GET_SKILL_PROP, "敵専用", L_SKILL, -1
SIF RESULT
	RETURN 0

;削除不能
CALL GET_SKILL_PROP, "SKILL_DEL_UNABLE", L_SKILL, -1
SIF RESULT
	RETURN 0

;リンク不能スキルは弾く
CALL GET_SKILL_PROP, "링크불능", L_SKILL, -1
SIF RESULT
	RETURN 0

;ロール専用スキルは弾く
CALL GET_SKILL_PROP, "ロール専用", L_SKILL, -1
SIF RESULT
	RETURN 0
RETURN 1
;---- EDIT 018 ADD END ---------------------------

;---- EDIT 016 MOD START -------------------------
@MAKE_SKILLCARD
#DIM LINE, 3
#DIM L_CHARA
#DIM LCOUNT
#DIM L_SKILL
#DIM L_RESULT
#DIM CAN_NOT_MAKE_SKILLCARD, HAVEABLE_SKILLNUM
;LOCAL FOR用
;LOCAL:1 作成する悪魔
;LOCAL:2 作成するスキルの習得番号
;LOCAL:5 ページ管理用
;LOCAL:7 スキルカード化可能スキルの個数

;LOCAL:8-12 増加するストレス値

;キャラリストを表示・選択
;CALL INPUT_CHARA_LIST("スキルカードを作成する悪魔を選んでください", "CASTING_MAKE_SKILLCARD")
{
CALL INPUT_CHARA_LIST
	, "FUNC_PROPSET_LIST_BATTLE"
	, "스킬카드를 작성할 악마를 선택해주세요"
	, "CASTING_MAKE_SKILLCARD" 
	, "SHOW_ADD_UP_FUNCTION"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
SIF RESULT == 1000
	RETURN 0
;LOCAL:1 = RESULT
L_CHARA = RESULT

;一文字U利用箇所
U = L_CHARA
;U = LOCAL:1
DRAWLINE
LINE = LINECOUNT
$INPUT_LOOP
CLEARLINE LINECOUNT - LINE
VARSET CAN_NOT_MAKE_SKILLCARD
;VARSET S,-1

DRAWLINE
PRINTFORML □%CALLNAME:L_CHARA%의 스킬
DRAWLINE
CALL MAKE_SKILLCARD_LIST, L_CHARA, "通常形態", CAN_NOT_MAKE_SKILLCARD
IF MINARRAY(CAN_NOT_MAKE_SKILLCARD) > 1
	PRINTFORMW 스킬카드로 만들 수 있는 스킬을 습득하지 않았습니다
	CLEARLINE 2
	RESTART
ENDIF
DRAWLINE
PRINTL □스킬카드 작성 방법
CALL PRINT_COLOR, @"　①스킬추출　　　　충성도를 {GET_LOYALTY_FOR_MAKE_SKILLCARD(L_CHARA, "消費")} 소비하고、추가로 스킬을 삭제한다 (요:충성도{GET_LOYALTY_FOR_MAKE_SKILLCARD(L_CHARA, "必要")})", GET_CHARA_LOYALTY(L_CHARA) < GET_LOYALTY_FOR_MAKE_SKILLCARD(L_CHARA, "必要") ? COLOR("gray") # COLOR("DEF"), "L"
CALL PRINT_COLOR, @"　②스킬카드화　　　악마를 삭제한다 (요:충성도 500)", GET_CHARA_LOYALTY(L_CHARA) < 500 ? COLOR("gray") # COLOR("DEF"), "L"
CALL PRINT_COLOR, @"　③태아카드화　　　임신을 잏고、추가로 스트레스와 피로를 가산한다 (요:임신 + 붕괴 미소지)", (!TALENT:L_CHARA:임신 || TALENT:L_CHARA:붕괴) ? COLOR("gray") # COLOR("DEF"), "L"
DRAWLINE
PRINTL [ 0]돌아간다　[99]스킬잠금설정
INPUT
IF RESULT == 0
	RESTART
ELSEIF RESULT == 99
	CALL SKILL_ROCK_SETTING, L_CHARA
	GOTO INPUT_LOOP
;ELSEIF RESULT < 0 || RESULT > FLAG:이능자스킬수+1 || S:RESULT == -1
;	GOTO INPUT_LOOP_2
ENDIF

L_RESULT = RESULT
SIF !INRANGE(L_RESULT, 1, HAVEABLE_SKILLNUM)
	GOTO INPUT_LOOP
SIF CAN_NOT_MAKE_SKILLCARD:(L_RESULT - 1)
	GOTO INPUT_LOOP
L_SKILL = ABL:L_CHARA:@"스킬{L_RESULT}"
LINE:1 = LINECOUNT
$INPUT_LOOP_2
CLEARLINE LINE:1 - LINECOUNT

DRAWLINE
CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, -1
CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILL, L_CHARA
PRINTFORML 【%GET_SUCCESSION(RESULT)%】 %RESULTS%
SIF FLAG:스킬속성표시설정 == 1
	CALL SKILL_EXPLAIN_PERFORMANCE, L_SKILL, L_CHARA
CALL GET_SKILL_PROP, "SKILL_EXPLAIN", L_SKILL, L_CHARA
DRAWLINE
IF ITEM:(10000 + L_SKILL)
	LOCAL:4 = GETCOLOR()
	SETCOLOR COLOR("PASTEL-RED")
	PRINTFORML ※이 스킬카드는 {ITEM:(10000 + L_SKILL)}매 소지하고 있습니다
	SETCOLOR LOCAL:4
ENDIF
IF ABLE_MAKESKILLCARD(L_SKILL)
	LOCAL:4 = GETCOLOR()
	SETCOLOR COLOR("PASTEL-BLUE")
	PRINTL ※이 스킬카드는 시간성에서 복제 가능합니다
	SETCOLOR LOCAL:4
ENDIF
PRINTFORML 현재、이하의 방법으로 스킬카드를 작성할 수 있습니다　충성도{GET_CHARA_LOYALTY(L_CHARA),6}
DRAWLINE
IF GET_CHARA_LOYALTY(L_CHARA) >= GET_LOYALTY_FOR_MAKE_SKILLCARD(L_CHARA, "必要")
	PRINTFORML [1] 스킬추출 (충성도가 {GET_LOYALTY_FOR_MAKE_SKILLCARD(L_CHARA, "消費")} 감소하고、대상 스킬을 잊어버립니다)
ELSE
	CALL PRINT_COLOR, @"[1] 스킬추출 (충성도가 {GET_LOYALTY_FOR_MAKE_SKILLCARD(L_CHARA, "必要")} 필요합니다)", COLOR("gray"), "L"
ENDIF
IF GET_CHARA_LOYALTY(L_CHARA) >= 500
