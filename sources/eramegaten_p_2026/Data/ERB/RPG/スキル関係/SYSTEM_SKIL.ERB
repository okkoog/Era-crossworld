;==========================================
;スキルカード一覧用 スキルカード在庫確認
;==========================================
@スキルカード在庫確認, ARG = -1, ARG:1 = -1, ARG:2, IS_TRANS
#DIM IS_TRANS
#DIMS TRANS_MODE
#DIM LCOUNT
#DIMS TEMPS
#DIM L_SKILL
#DIM L_SKILLCOUNT
#DIM HAVE_SKILL, 21
#DIM L_SKILL_SUCCESSION
;계승타입=ARGのスキルカードの所持を調べ、所持していたらS:に代入
;ARG が指定されていない場合、各継承タイプの所持種類数をZ:に代入して返す
;ARG:1 が指定されている場合、ARG:1の習得できるスキルのみを調べる
;ARG:2 が真の場合スキルカードが作成出来る場合も判定を通す
;なお、継承不能スキルは継承タイプ23として扱う
SIF ARG:1 >= CHARANUM
	ARG:1 = -1
TRANS_MODE = \@IS_TRANS ? 変身形態 # 通常形態\@
;---- EDIT 006 ADD START -------------------------
;処理の簡易化のために所持スキルをリスト化しておく
IF ARG:1 >= 0
	VARSET HAVE_SKILL
	IF CSTR:(ARG:1):롤 != "" && GET_ROLE_PROP("CAN_USE_TRANS", ARG:1)
		TEMPS = \@IS_TRANS ? 초기변신악마스킬 # 인간시스킬\@
	ELSE
		TEMPS = 스킬
	ENDIF
	IF CSTR:(ARG:1):롤 == ""
		L_SKILLCOUNT = 8
	ELSE
		L_SKILLCOUNT = GET_ROLE_PROP("CHANGEABLE_SKILLCOUNT", ARG:1, , TRANS_MODE)
	ENDIF
	FOR LCOUNT, 1, L_SKILLCOUNT + 1
		HAVE_SKILL:LCOUNT = ABL:(ARG:1):@"%TEMPS%{LCOUNT}"
	NEXT
ENDIF
;---- EDIT 006 ADD END ---------------------------
VARSET HAVE_SKILLCARD_LIST,-1
VARSET Z,0
LOCAL:1 = 0
LOCAL:2 = 0

;EDIT 002 MOD START -----------------------------------
;Sに選択した系統のスキルを代入
;FOR LOCAL, 1 ,4000
FOR LOCAL, 1, SKILLNUM
	CALL SKIP_スキルカード化不能領域, LOCAL
;EDIT 002 MOD END -------------------------------------
	;所持していないカードをまず弾く
	;ただしARG:2が真の場合はカード作成可能な場合も通す
	IF ARG:2
		SIF (ITEM:(10000+LOCAL) < 1) && !ABLE_MAKESKILLCARD(LOCAL)
			CONTINUE
	ELSE
		SIF (ITEM:(10000+LOCAL) < 1)
			CONTINUE
	ENDIF
	
;---- EDIT 006 ADD START -------------------------
	;スキル所持による判定
	IF ARG:1 >= 0
		SIF MATCH(HAVE_SKILL, LOCAL)
			CONTINUE
	ENDIF
;---- EDIT 006 ADD END ---------------------------
;---- EDIT 006 DEL START -------------------------
	;スキル所持による判定
	;デビルシフター変身後用処理
	;IF ARG:1 > -1 && HAVE_SKILL_C(ARG:1 , LOCAL)
	;	TRYCCALLFORM 重複習得数_{LOCAL}
	;		SIF HAVE_SKILL_OVERLAP(ARG:1,LOCAL,どっちの強化？) + 1 > RESULT
	;			CONTINUE
	;	CATCH
	;		CONTINUE
	;	ENDCATCH
	;ARG:1>=0なら、ARG:1のキャラが持ってて重複習得上限に達したスキルは弾く
	;ELSEIF ARG:1 > -1 && HAVE_SKILL(ARG:1 , LOCAL)
	;	TRYCCALLFORM 重複習得数_{LOCAL}
	;		SIF HAVE_SKILL_OVERLAP(ARG:1,LOCAL) + 1 > RESULT
	;			CONTINUE
	;	CATCH
	;		CONTINUE
	;	ENDCATCH
	;ENDIF
	;---- EDIT 006 DEL END ---------------------------
	;---- EDIT 008 MOD START -------------------------
	;----------------------------------------------
	;継承タイプによる判定
	;----------------------------------------------
	;継承タイプの取得及び使用可能状況の判定
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", LOCAL, ARG:1
	L_SKILL_SUCCESSION = RESULT
	;スキルカード使用可能ランクによる判定
	;1 = 自動効果のみ	2 = 자동효과 + 継承素質を持つもの
	IF ARG:1 >= 0 && CSTR:(ARG:1):롤 != ""
		SELECTCASE GET_SKILL_CHANGEABLE_RANK(ARG:1, TRANS_MODE)
			CASE 2
				SIF !相性素質チェック_F(ARG:1, L_SKILL_SUCCESSION, TRANS_MODE) && L_SKILL_SUCCESSION != 22
					CONTINUE
			CASE 1
				SIF L_SKILL_SUCCESSION != 22
					CONTINUE
		ENDSELECT
	ENDIF
	IF ARG:1 >= 0 && CSTR:(ARG:1):롤 != ""
		CALL GET_SKILL_PROP, "ロール専用", LOCAL, ARG:1
		IF RESULT
			SIF !STRCOUNT(GETS_ROLE_PROP("CAN_USE_SPECIAL_SKILL", ARG:1, TRANS_MODE), RESULTS)
				CONTINUE
		ENDIF
	ENDIF
	;---- EDIT 008 MOD END ---------------------------
	RESULT = 0
	;継承不能スキルかチェックし、不能なら23番の扱いにする
	CALL GET_SKILL_PROP, "継承不能", LOCAL, ARG:1
	SIF RESULT
		L_SKILL_SUCCESSION = 23
	;継承タイプが指定されている場合は離脱判定
	SIF L_SKILL_SUCCESSION != ARG && ARG > -1
		CONTINUE

	;ランクが範囲外なら外す
	CALL GET_SKILL_PROP, "SKILL_RANK", LOCAL, ARG:1
	SIF RESULT <= 0 || RESULT > 15
		CONTINUE
	HAVE_SKILLCARD_LIST:(LOCAL:1) = LOCAL
	LOCAL:1 += 1
	Z:(L_SKILL_SUCCESSION) += 1
NEXT
RETURN LOCAL:1

;==========================================
;特殊スキルチェック
;ARG	スキル番号
;ARG:1	スキル番号も含むか　0含まない　1含む
;==========================================
@SP_SKILL_CHECK, ARG, ARG:1 = 0
;スキル番号が汎用か
SIF 2500 <= ARG && ARG:1 > 0
	RETURN 1

;継承タイプによる判定
RESULT = 0
