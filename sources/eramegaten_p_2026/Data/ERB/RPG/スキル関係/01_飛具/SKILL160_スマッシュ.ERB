;スキル名
@SKILL_NAME_160,ARG
RESULTS = 스매시

;　명중
@SKILL_HITRATE_160, ARG
RETURN 100

;　威力
@SKILL_POWER_160, ARG
SIF ARG < 0
	RETURN 0
SIF BASE:ARG:LV < 20
	RETURN 120
SIF BASE:ARG:LV < 30
	RETURN 170
SIF BASE:ARG:LV < 40
	RETURN 220
SIF BASE:ARG:LV < 60
	RETURN 270
RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_160,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_160,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_160, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_160,ARG
SIF ARG < 0
	RETURN 10
SIF BASE:ARG:LV < 20
	RETURN 10
SIF BASE:ARG:LV < 30
	RETURN 14
SIF BASE:ARG:LV < 40
	RETURN 18
SIF BASE:ARG:LV < 60
	RETURN 22
RETURN 24

;　相性
@SKILL_TYPE_160,ARG
RETURN GET_TYPE_NUM("비구")
;비구

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_160
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")
;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_160, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_160, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_160,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_160,ARG
SIF ARG < 0
	RETURN 1
SIF 陥落(ARG) == 0
	RETURN 1
SIF 陥落(ARG) == 1
	RETURN 2
RETURN 3

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_160, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_160
RETURN GET_SUCCESSION_NUM("비구")

@継承不能_160
RETURN 1
;継承不能

;속도보정
@SKILL_SPEED_160, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_160
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_160, ARG = -1
RETURN 13



;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_160, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "DEF"
		RETURN -32, 32
ENDSELECT

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_160, ARG, ARG:1, ARG:2
CALL ATTACK_SKILL,ARG,ARG:1,160

