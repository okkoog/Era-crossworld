;2024/02/29		tokisaka sou	菜々子専用ペルソナ用の専用スキル
;								飛具、打撃、戦技のそれぞれの相性による３回物理攻撃。
;								単発の威力は抑えめ。
;

;スキル名
@SKILL_NAME_170,ARG
RESULTS = 역귀문영수삼연격

;　명중
@SKILL_HITRATE_170, ARG
RETURN 110

;　威力
@SKILL_POWER_170, ARG
RETURN 90

;　최저공격횟수
@SKILL_MINATTACKNUMBER_170,ARG
RETURN 3

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_170,ARG
RETURN 3

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_170, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_170,ARG
RETURN 25

;　相性
@SKILL_TYPE_170,ARG
SIF FLAG:공격횟수 == 0
	RETURN GET_TYPE_NUM("비구")
;비구
SIF FLAG:공격횟수 == 1
	RETURN GET_TYPE_NUM("타격")
;타격
SIF FLAG:공격횟수 == 2
	RETURN GET_TYPE_NUM("전술")
;전술

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_170
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_170, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_170, ARG
RETURN GET_SKILL_TARGET_NUM("적")
;単体

;　사거리
@SKILL_RANGE_170,ARG
RETURN 3
;L

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_170,ARG
RETURN GET_SPHERE_NUM("단체")
;単体

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_170, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")
;공격


;계승타입
@SKILL_SUCCESSION_TYPE_170
RETURN GET_SUCCESSION_NUM("비구")
@継承不能_170
RETURN 2
;継承不可。造魔、子供も継承不可。

;속도보정
@SKILL_SPEED_170, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_170
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_170, ARG = -1
RETURN 18


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_170, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,170





;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_170, ARG
PRINTL 역귀문을 상징하는 신(申)유(酉)술(戌)의 영수를 불러내、적에게 덤벼들게 한다。
PRINTL 비구、타격、전술 각각 １회씩 총 ３회의 물리공격。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_170,ARG
RETURN 1
;とくにない

