;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_109, ARG, ARG:1, ARG:2
;コスト支払い
;CALL PAY_COST,ARG,109

;実行
IF SKILL_CHANGE(ARG, [[キャラ:야치호]])
	IF ARG < 0
		CALL SKILL_WALL , ARG , "비구" , CFLAG:ARG:타겟 , 1
	ELSEIF 陥落(ARG) == 0
		CALL SKILL_WALL , ARG , "비구" , CFLAG:ARG:타겟 , 1
	ELSEIF 陥落(ARG) == 1
		CALL SKILL_WALL , ARG , "비구" , CFLAG:ARG:타겟 , 2
	ELSE
		CALL SKILL_WALL , ARG , "비구" , CFLAG:ARG:타겟 , 3
	ENDIF
ELSE
	CALL SKILL_WALL , ARG , "비구" , CFLAG:ARG:타겟 , 1
ENDIF





