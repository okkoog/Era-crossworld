@SKILL_NAME_129,ARG
RESULTS = 비구가드브레이크

;　명중
@SKILL_HITRATE_129, ARG
RETURN 100

;　威力
@SKILL_POWER_129, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_129,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_129,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_129, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
