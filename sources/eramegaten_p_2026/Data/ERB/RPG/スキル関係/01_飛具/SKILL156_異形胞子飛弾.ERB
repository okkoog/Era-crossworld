;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_156,ARG
A = RAND:8
IF A == 0
	RETURN GET_STATE_NUM("CHARM")
ELSEIF A == 1
	RETURN GET_STATE_NUM("PANIC")
ELSEIF A == 2
	RETURN GET_STATE_NUM("SLEEP")
ELSEIF A == 3
	RETURN GET_STATE_NUM("HAPPY")
ELSEIF A == 4
	RETURN GET_STATE_NUM("BIND")
ELSEIF A == 5
	RETURN GET_STATE_NUM("CLOSE")
ELSEIF A == 6
	RETURN GET_STATE_NUM("POISON")
ELSE
	RETURN GET_STATE_NUM("PALYZE")
ENDIF
;추가효과상성
@SKILL_ADDTIONAL_TYPE_156,ARG
IF A < 4
	RETURN 9
ELSE
	RETURN 8
ENDIF
RETURN 8

