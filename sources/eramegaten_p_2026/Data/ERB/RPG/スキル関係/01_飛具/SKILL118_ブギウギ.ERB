;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_118,ARG
RESULTS = 부기우기

;　명중
@SKILL_HITRATE_118, ARG
RETURN 100

;　威力
@SKILL_POWER_118, ARG
RETURN 120

;　최저공격횟수
@SKILL_MINATTACKNUMBER_118,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_118,ARG
RETURN 4

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_118, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_118,ARG
RETURN 8

;　相性
@SKILL_TYPE_118,ARG
RETURN GET_TYPE_NUM("비구")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_118
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_118, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_118, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_118,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_118,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_118, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_118
RETURN GET_SUCCESSION_NUM("비구")
@継承不能_118
RETURN 1
;속도보정
@SKILL_SPEED_118, ARG = -1
RETURN 2


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_118
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_118, ARG = -1
RETURN 0



