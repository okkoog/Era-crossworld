@SKILL_DAMAGETYPE_2317,ARG
SIF ARG < 0
	RETURN 1
;使用者の攻撃力が魔法威力より低い場合は魔法ダメージタイプになる
SIF MAXBASE:ARG:공격 < MAXBASE:ARG:마법위력
	RETURN 2
RETURN 1

