@SKILL_NAME_2317,ARG
RESULTS = 잠재반격

;　명중
@SKILL_HITRATE_2317, ARG
RETURN 100


;　威力
@SKILL_POWER_2317, ARG
#DIM TOTAL_POW
TOTAL_POW = 100
SIF ARG < 0
	RETURN 100
;ペルソナ相性が☆なら威力値を500に、◎なら威力値300にする
SELECTCASE GET_P_FITNESS(ARG, 0)
	CASE 3
		TOTAL_POW = 500
	CASE 2
		TOTAL_POW = 300
ENDSELECT
;上記で設定した威力値 + 使用者の力 or 魔力、いずれか高い方を加算する
TOTAL_POW += MAX(MAXBASE:ARG:힘,MAXBASE:ARG:마력)
RETURN TOTAL_POW


