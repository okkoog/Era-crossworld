;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2101,ARG
TRYCCALLFORM 追加効果命中率_{EQUIP:ARG:총},ARG
	RETURN RESULT
CATCH
	RETURN 0
ENDCATCH

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2101,ARG
TRYCCALLFORM 追加効果最大命中率_{EQUIP:ARG:총},ARG
	RETURN RESULT
CATCH
	RETURN 0
ENDCATCH

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2101, ARG, ARG:1, ARG:2
CALL GET_SKILL_PROP, "SKILL_SPHERE", 2101, ARG
IF RESULT == 1
	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,2101
ELSE
	RESULT = 0
	TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총},ARG
	IF RESULT == 1
		CALL ATTACK_RAND,ARG,ARG:1,2101
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,2101
	ENDIF
ENDIF

