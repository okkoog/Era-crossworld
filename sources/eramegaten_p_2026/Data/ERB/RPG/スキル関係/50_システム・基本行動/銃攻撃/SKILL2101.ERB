;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2101,ARG
RESULTS = ＧＵＮ

;　명중
@SKILL_HITRATE_2101, ARG
RETURN 100

;　威力
@SKILL_POWER_2101, ARG
SIF ARG == -1
	RETURN 100
CALLFORM 銃タイプ_{EQUIP:ARG:총},ARG
SELECTCASE RESULT
	CASE 4
		RETURN 300
	CASEELSE
		RETURN 100
ENDSELECT


;　최저공격횟수
@SKILL_MINATTACKNUMBER_2101,ARG
CALLFORM 最低攻撃回数_{EQUIP:ARG:총},ARG
RETURN RESULT

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2101,ARG
CALLFORM 最大攻撃回数_{EQUIP:ARG:총},ARG
RETURN RESULT

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2101, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_2101,ARG
RETURN 0

;　相性
@SKILL_TYPE_2101,ARG
SIF ARG >= 0	;スキル属性表示で落ちるのでガード
	CALLFORM 攻撃相性_{EQUIP:ARG:총},ARG
RETURN ARG >= 0 ? RESULT # 1
;銃に依存
;RETURN 1
;비구

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2101
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2101, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　基礎攻撃力の算出タイプ(1:物理,2:魔法, 3:총, 4:アイテム, 5:割合)
@SKILL_ATTACKTYPE_2101, ARG
RETURN GET_攻撃タイプ_NUM("총")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2101, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2101,ARG
CALLFORM 射程_{EQUIP:ARG:총},ARG
RETURN RESULT

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2101,ARG
CALLFORM 攻撃範囲_{EQUIP:ARG:총},ARG
RETURN RESULT

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2101, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2101
RETURN GET_SUCCESSION_NUM("계통없음")

;속도보정
@SKILL_SPEED_2101, ARG = -1
SIF ARG == -1
	RETURN 0
TRYCCALLFORM 速度補正_{EQUIP:ARG:총},ARG
	RETURN RESULT
CATCH
	RETURN 0
ENDCATCH

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2101
RETURN 0

