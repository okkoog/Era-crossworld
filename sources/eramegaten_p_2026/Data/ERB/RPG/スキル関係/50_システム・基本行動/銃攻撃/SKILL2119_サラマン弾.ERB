;火炎っぽい名前だけど核熱に

;スキル名
@SKILL_NAME_2119,ARG
RESULTS = 살라만더탄

;　명중
@SKILL_HITRATE_2119, ARG
RETURN 100

;　威力
@SKILL_POWER_2119, ARG
SIF ARG == -1
	RETURN 110
CALLFORM 銃タイプ_{EQUIP:ARG:총},ARG
SELECTCASE RESULT
	CASE 4
		RETURN 330
	CASEELSE
		RETURN 110
ENDSELECT

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2119,ARG
CALLFORM 最低攻撃回数_{EQUIP:ARG:총},ARG
RETURN RESULT

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2119,ARG
CALLFORM 最大攻撃回数_{EQUIP:ARG:총},ARG
RETURN RESULT

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2119, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_2119,ARG
RETURN 0

;　相性
@SKILL_TYPE_2119,ARG
RETURN GET_TYPE_NUM("핵열")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2119
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2119, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　基礎攻撃力の算出タイプ(1:物理,2:魔法, 3:총, 4:アイテム, 5:割合, 関数がない場合はダメージタイプと一致させる)
@SKILL_ATTACKTYPE_2119, ARG
RETURN GET_攻撃タイプ_NUM("총")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2119, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2119,ARG
CALLFORM 射程_{EQUIP:ARG:총},ARG
RETURN RESULT

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2119,ARG
CALLFORM 攻撃範囲_{EQUIP:ARG:총},ARG
RETURN RESULT

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2119, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2119
RETURN GET_SUCCESSION_NUM("계통없음")

;속도보정
@SKILL_SPEED_2119, ARG = -1
SIF ARG == -1
	RETURN 0
TRYCCALLFORM 速度補正_{EQUIP:ARG:총},ARG
	RETURN RESULT
CATCH
	RETURN 0
ENDCATCH

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2119
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2119, ARG = -1
RETURN 0
;変化不可

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2119, ARG, ARG:1, ARG:2
CALL GET_SKILL_PROP, "SKILL_SPHERE", 2119, ARG
IF RESULT == 1
	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,2119
ELSE
	RESULT = 0
	TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총},ARG
	IF RESULT == 1
		CALL ATTACK_RAND,ARG,ARG:1,2119
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,2119
	ENDIF
	
ENDIF
SIF CFLAG:ARG:PT플래그 > 0
	ITEM:5517 -= 1




;====================================================
;実行内容ここまで
;====================================================

@SKILL_TAG_2119
RESULTS = 特殊弾

;　 説明文の表示
@SKILL_EXPLAIN_2119, ARG
PRINTL 정령　살라만더의 가호를 받은 탄환으로 핵열 상성의 데미지를 준다。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_2119,ARG
SIF EQUIP:ARG:총 == 0
	RETURN 0
SIF CFLAG:ARG:PT플래그 == 0
	RETURN 1
SIF !GET_ROLE_PROP("CAN_USE_GUN", ARG)
	RETURN 0
SIF !GET_BTL_TALENT_LV("건슬링거", ARG)
	RETURN 0
SIF ITEM:5517 < 1
	RETURN 0
SIF HAVE_BULLET(ARG,5517) == 0
	RETURN 0
RETURN 1
;とくにない

