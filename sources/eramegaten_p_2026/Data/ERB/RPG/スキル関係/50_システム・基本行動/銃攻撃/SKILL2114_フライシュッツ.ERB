;Freischutz
;至高の魔弾コピーにするよりはこっちかな、と…

;スキル名
@SKILL_NAME_2114,ARG
RESULTS = Freischutz

;　명중
@SKILL_HITRATE_2114, ARG
RETURN 150

;　威力
@SKILL_POWER_2114, ARG
SIF ARG == -1
	RETURN 470
CALLFORM 銃タイプ_{EQUIP:ARG:총},ARG
SELECTCASE RESULT
	CASE 4
		RETURN 600
	CASEELSE
		RETURN 470
ENDSELECT

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2114,ARG
CALLFORM 最低攻撃回数_{EQUIP:ARG:총},ARG
RETURN RESULT

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2114,ARG
CALLFORM 最大攻撃回数_{EQUIP:ARG:총},ARG
RETURN RESULT

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2114, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_2114,ARG
RETURN 0

;　相性
@SKILL_TYPE_2114,ARG
RETURN GET_TYPE_NUM("만능")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2114
RETURN GET_SKILL_DECIDE_TYPE_NUM("未指定")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2114, ARG
RETURN GET_ダメージタイプ_NUM("物理")
;　基礎攻撃力の算出タイプ(1:物理,2:魔法, 3:총, 4:アイテム, 5:割合, 関数がない場合はダメージタイプと一致させる)
@SKILL_ATTACKTYPE_2114, ARG
RETURN GET_攻撃タイプ_NUM("총")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2114, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2114,ARG
CALLFORM 射程_{EQUIP:ARG:총},ARG
RETURN RESULT

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2114,ARG
CALLFORM 攻撃範囲_{EQUIP:ARG:총},ARG
RETURN RESULT

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2114, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2114
RETURN GET_SUCCESSION_NUM("계통없음")

;속도보정
@SKILL_SPEED_2114, ARG = -1
SIF ARG == -1
	RETURN 0
TRYCCALLFORM 速度補正_{EQUIP:ARG:총},ARG
	RETURN RESULT
CATCH
	RETURN 0
ENDCATCH

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2114
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2114, ARG = -1
RETURN 0
;変化不可

;テンプレート用、追加効果シリーズ
;追加効果ステータス
@SKILL_ADDTIONAL_STATE_2114,ARG
RETURN 0

;추가효과상성
@SKILL_ADDTIONAL_TYPE_2114,ARG
RETURN 11

;追加効果基本付与確率
@SKILL_ADDTIONAL_BASE_RATE_2114,ARG
CALLFORM 銃タイプ_{EQUIP:ARG:총},ARG
SELECTCASE RESULT
	CASE 1
		RETURN 40
	CASE 2
		RETURN 25
	CASE 3
		RETURN 8
	CASE 4
		RETURN 50
	CASEELSE
		RETURN 40
ENDSELECT
RETURN 0

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2114,ARG
CALLFORM 銃タイプ_{EQUIP:ARG:총},ARG
SELECTCASE RESULT
	CASE 1
		RETURN 90
	CASE 2
		RETURN 50
	CASE 3
		RETURN 20
	CASE 4
		RETURN 95
	CASEELSE
		RETURN 90
ENDSELECT
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2114, ARG, ARG:1, ARG:2
CALL GET_SKILL_PROP, "SKILL_SPHERE", 2114, ARG
IF RESULT == 1
	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,2114
ELSE
	RESULT = 0
	TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총},ARG
	IF RESULT == 1
		CALL ATTACK_RAND,ARG,ARG:1,2114
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,2114
	ENDIF
	
ENDIF
SIF CFLAG:ARG:PT플래그 > 0
	ITEM:5512 -= 1



;====================================================
;実行内容ここまで
;====================================================

@SKILL_TAG_2114
RESULTS = 特殊弾

;　 説明文の表示
@SKILL_EXPLAIN_2114, ARG
PRINTL 모든 것을 꿰뚫는 마탄에 의한 만능 상성의 총격으로 특대 데미지를 준다。명중률이 높다。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_2114,ARG
SIF EQUIP:ARG:총 == 0
	RETURN 0
SIF CFLAG:ARG:PT플래그 == 0
	RETURN 1
SIF !GET_ROLE_PROP("CAN_USE_GUN", ARG)
	RETURN 0
SIF !GET_BTL_TALENT_LV("건슬링거", ARG)
	RETURN 0
SIF ITEM:5512 < 1
	RETURN 0
SIF HAVE_BULLET(ARG,5512) == 0
	RETURN 0
RETURN 1
;とくにない

