;====================================================
;独自のカジャ処理
;ARG		攻撃側のキャラ登録番号
;ARG:1		防御側のキャラ登録番号
;RESULT 	= 強化値
;RESULT:1	= 基準値	(基準値 + x) / 基準値 あるいは　(基準値 * 2 - x) /基準値 * 2倍になる
;			　デフォは基準値32で、最大で(32 + 32) / 32 or (64 - 32) / 64倍になる
;====================================================
@SKILL_CALC_BUFF_2123, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "DEF"
		RETURN -32, 32
ENDSELECT

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2123, ARG, ARG:1, ARG:2
CALL GET_SKILL_PROP, "SKILL_SPHERE", 2123, ARG
IF RESULT == 1
	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,2123
ELSE
	RESULT = 0
	TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총},ARG
	IF RESULT == 1
		CALL ATTACK_RAND,ARG,ARG:1,2123
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,2123
	ENDIF
	
ENDIF
SIF CFLAG:ARG:PT플래그 > 0
	ITEM:5521 -= 1

;====================================================
;実行内容ここまで
;====================================================

@SKILL_TAG_2123
RESULTS = 特殊弾

;　 説明文の表示
@SKILL_EXPLAIN_2123, ARG
PRINTL 상대의 급소를 노리고 장갑을 관통하는 총격을 행해 중 데미지。상대의 방어력을 반감하고、크리티컬률이 높다。
PRINTL 이 스킬에 의한 데미지는 공격대상의 방어력을 최대로 낮춘 상태로 산출된다。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_2123,ARG
SIF EQUIP:ARG:총 == 0
	RETURN 0
SIF CFLAG:ARG:PT플래그 == 0
	RETURN 1
SIF !GET_ROLE_PROP("CAN_USE_GUN", ARG)
	RETURN 0
SIF !GET_BTL_TALENT_LV("건슬링거", ARG)
	RETURN 0
SIF ITEM:5521 < 1
	RETURN 0
SIF HAVE_BULLET(ARG,5521) == 0
	RETURN 0
RETURN 1
;とくにない

