;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2150,ARG
RESULTS = 더블탭

;　명중
@SKILL_HITRATE_2150, ARG
RETURN 100

;　威力
@SKILL_POWER_2150, ARG
RETURN 100

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2150,ARG
SIF ARG < 0
	RETURN 2
CALLFORM 最低攻撃回数_{EQUIP:ARG:총},ARG
LOCAL = RESULT * 2
RETURN LOCAL

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2150,ARG
SIF ARG < 0
	RETURN 2
CALLFORM 最大攻撃回数_{EQUIP:ARG:총},ARG
LOCAL = RESULT * 2
RETURN LOCAL

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2150, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2150,ARG
RETURN 5

;　相性
@SKILL_TYPE_2150,ARG
SIF ARG < 0
	RETURN 1
CALLFORM 攻撃相性_{EQUIP:ARG:총},ARG
RETURN RESULT
;銃に依存
;RETURN 1
;비구

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2150
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2150, ARG
RETURN GET_ダメージタイプ_NUM("物理")
@SKILL_ATTACKTYPE_2150, ARG
RETURN GET_攻撃タイプ_NUM("총")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2150, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2150,ARG
SIF ARG < 0
	RETURN 3
CALLFORM 射程_{EQUIP:ARG:총},ARG
RETURN RESULT

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2150,ARG
SIF ARG < 0
	RETURN 1
CALLFORM 攻撃範囲_{EQUIP:ARG:총},ARG
RETURN RESULT

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2150, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2150
RETURN GET_SUCCESSION_NUM("비구")
;속도보정
@SKILL_SPEED_2150, ARG = -1
SIF ARG == -1
	RETURN 0
TRYCCALLFORM 速度補正_{EQUIP:ARG:총}, ARG
	RETURN RESULT
CATCH
	RETURN 0
ENDCATCH

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2150
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2150, ARG = -1
RETURN 0
;変化不可

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2150, ARG, ARG:1, ARG:2
CALL GET_SKILL_PROP, "SKILL_SPHERE", 2150, ARG
IF RESULT == 1
	LOCAL = POS(ARG:1)
	CALL ATTACK_SINGLE,ARG,LOCAL,2150
ELSE
	RESULT = 0
	TRYCALLFORM GUN_RANDOMTARGET_{EQUIP:ARG:총}
	IF RESULT == 1
		CALL ATTACK_RAND,ARG,ARG:1,2150
	ELSE
		CALL ATTACK_FIELD,ARG,ARG:1,2150
	ENDIF
	
ENDIF





;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2150, ARG
PRINTL 장비하고 있는 총으로 ２회 공격한다。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_2150,ARG
RESULTS = 사용조건:총 장비
SIF EQUIP:ARG:총 == 0
	RETURN 0
RETURN 1
;とくにない

