;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2314, ARG, ARG:1, ARG:2
IF TFLAG:전투중절정
	PRINTFORMW %CALLNAME:(ARG)% %조사만처리(CALLNAME:(ARG),"는")% 절정의 여운에 잠겨있다
;ELSEIF CFLAG:ARG:ボイコットフラグ == 1 && FLAG:戦闘時ボイコット設定 > 2
;	PRINTFORMW %CALLNAME:ARG% はボイコットした
;	CFLAG:ARG:ボイコットフラグ = 0
ELSE
	SIF GET_STATE(CFLAG:ARG:상태이상) == "PANIC"
		PRINTFORMW %ARG는% 멍하니 있다……
	SIF GET_STATE(CFLAG:ARG:상태이상) == "CHARM"
		PRINTFORMW %ARG는% 욕정하고 있다……
	IF GET_STATE(CFLAG:ARG:상태이상) == "HAPPY"
		IF 위험일(ARG) == 2 && FLAG:무후후전개
			PRINTFORMW  %CALLNAME:ARG% %조사만처리(CALLNAME:ARG,"는")% 자신의 몸을 더듬고 있다
		ELSE
			PRINTFORMW %ARG는% 행복하다
		ENDIF
	ENDIF
ENDIF
