;====================================================
;カウンター発動条件
;====================================================
@SKILL_COUNTER_ACTIONABLE_2319,ARG,ARG:1
#DIM L_HP_PER
SIF !TALENT:ARG:페르소나구사자
	RETURN 0
SIF CFLAG:ARG:PT플래그 == 0
	RETURN 0
SIF !GET_CREC_ACT(ARG:1, ARG, "HIT")
	RETURN 0
;ペルソナの相性が☆か◎じゃなければ発動不可
SIF GET_P_FITNESS(ARG,0) < 2
	RETURN 0
;小数点以下を扱えないおかげで切り下げの影響を激しく受けるので数値を増やして対処する。
L_HP_PER = (BASE:ARG:ＨＰ * 100 * 100) / MAXBASE:ARG:ＨＰ
;HP1/4以下時残りＨＰに応じた確率で発動(25%ちょうどで1/4, 12.5%で1/2でキャップ)
SIF L_HP_PER > 2500
	RETURN 0
SIF RAND:MAX(L_HP_PER, 1250) > 625
	RETURN 0
;使用者の潜在能力発動回数が3を超えていたら発動しない
SIF CFLAG:ARG:잠재능력발동횟수 > 3
	RETURN 0
;PRINTW 潜在能力発動回数4未満チェック
;死亡時・COMP内発動は対象+100000で指定する
RETURN 1, 22

