@SKILL_HITRATE_2322, ARG
RETURN 100

;　威力
@SKILL_POWER_2322, ARG
IF ARG < 0 || !TFLAG:치환원스킬
	RETURN 100
ELSE
	CALL GET_SKILL_PROP, "SKILL_RANK", TFLAG:치환원스킬, ARG
	IF INRANGE(RESULT, 1, 15)
		RETURN 100 + 30 * RESULT
	ELSE
		RETURN 600
	ENDIF
ENDIF

