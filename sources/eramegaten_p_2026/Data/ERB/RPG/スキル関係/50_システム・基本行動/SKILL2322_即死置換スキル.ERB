@SKILL_NAME_2322,ARG
IF ARG < 0 || !TFLAG:치환원스킬
	RESULTS = 즉사치환스킬
ELSE
	CALL GET_SKILL_PROP, "SKILL_NAME", TFLAG:치환원스킬, ARG
ENDIF

