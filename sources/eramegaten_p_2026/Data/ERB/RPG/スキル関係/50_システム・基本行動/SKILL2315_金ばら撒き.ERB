;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2315, ARG, ARG:1, ARG:2
LOCAL = 0
IF GET_STATE(CFLAG:ARG:상태이상) == "PANIC"
	LOCAL   = MONEY / 20
	LOCAL:1 = MONEY / 10
	SIF LOCAL:1 > 0
		LOCAL = LOCAL + RAND:(LOCAL:1)
ENDIF


PRINTFORMW %ARG는% ￥{LOCAL}을 흩뿌렸다！
MONEY -= LOCAL


