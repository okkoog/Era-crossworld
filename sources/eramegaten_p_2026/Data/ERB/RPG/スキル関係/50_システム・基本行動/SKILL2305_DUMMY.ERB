;DUMMY,スキル名をTSTRと吐き出すだけのDUMMYコマンド
;TSTRは思考パターン内で代入して、メッセージが必要なら敵口上を利用するといいでしょう
;使い道？　それは発想次第
;
;例としてはプリンストーラスはリロードで、特殊弾を入れ替えたってメッセージがでて、次のターンに撃ってくる属性弾の予告をする
;で、実際のところ、撃ってくる特殊弾の指定なんかの管理は思考パターンでやったほうがいいんで、スキル側でアクション書く必要がほとんどない
;なんで専用スキル作ってもほとんど空スキルになるだけだし、それならこういうのつくっといてもいいよねという気分に

;スキル名
@SKILL_NAME_2305,ARG
IF ARG > -1 && CSTR:ARG:더미스킬명 != ""
	RESULTS = %CSTR:ARG:더미스킬명%
ELSE
	IF TSTR == ""
		RESULTS = ＤＵＭＭＹ
	ELSE
		RESULTS = %TSTR%
	ENDIF
ENDIF

;　명중
@SKILL_HITRATE_2305, ARG
RETURN 0

;　威力
@SKILL_POWER_2305, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2305,ARG
RETURN 0

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2305,ARG
RETURN 0

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2305, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_2305,ARG
RETURN 0

;　相性
@SKILL_TYPE_2305,ARG
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2305
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2305, ARG
RETURN GET_SKILL_TARGET_NUM("특수")

;　사거리
@SKILL_RANGE_2305,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2305,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2305, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;계승타입
@SKILL_SUCCESSION_TYPE_2305
RETURN GET_SUCCESSION_NUM("검격")

;속도보정
@SKILL_SPEED_2305, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2305
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_2305, ARG = -1
RETURN 0
;変化不可

