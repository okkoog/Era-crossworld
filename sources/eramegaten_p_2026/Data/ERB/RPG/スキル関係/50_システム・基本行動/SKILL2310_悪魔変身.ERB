;====================================================
;スキル及び行動の実行
;====================================================
;デビルシフターなどの変身職、及びAion式召喚術の仲魔セット時の処理
;ARG   変身するキャラ
;ARG:1 変身時のメッセージを出すか出さないか？
;ARGS 変身解除で解除のみに絞る
@ACTION_2310, ARG, ARG:1, ARG:2
CALL TRANS_DEVIL, ARG

@TRANS_DEVIL, ARG, ARG:1 = 0, ARGS
#LOCALSIZE 2
#DIM 仲魔
#DIM 変身前ＨＰ
#DIM 変身前ＭＰ
#DIM 変数
#DIM DEVIL_SKILL
#DIM TEMP_SKILL, 13
#DIMS TEMPS
;変身解除を指定していて、変身していないのなら解除する必要がすでにないので終わる
SIF ARGS == "変身解除" && CFLAG:ARG:악마변신 == 0
	RETURN 0
仲魔 = FINDCHARA_LINK(ARG)
;探索・戦闘中は場にでてるストレージ悪魔には変身できない。
IF CFLAG:ARG:악마변신 == 0 && GROUPMATCH(FLAG:SHOP커맨드, [[ショップ:탐색]],[[ショップ:콜로세움참가]],[[ショップ:이벤트]],[[ショップ:의뢰청부]])
	IF 仲魔 >= 0 && CPOS(仲魔) > 0 && CFLAG:仲魔:소속ＣＯＭＰ < 0
		PRINTFORMW 악마를 송환할 수 없다！
		RETURN 0
	ENDIF
ENDIF


SIF ARG:1 == 1
	PRINTFORMW %AUTO_SPLIT("악마로 모습을 바꿨다！_인간의 모습으로 돌아왔다！","_",CFLAG:ARG:악마변신)%

CFLAG:ARG:악마변신 = !CFLAG:ARG:악마변신

SIF 仲魔 > 0 && TALENT:ARG:데빌시프터
	CFLAG:仲魔:피변신플래그 = CFLAG:ARG:악마변신

;変身先悪魔がパーティに居るなら外す
SIF CFLAG:ARG:악마변신 && FIND_LINKED_NAKAMA(ARG)
	CALL REMOVE_POSITION, CPOS(仲魔)

VARSET TEMP_SKILL
FOR LOCAL,1,FLAG:이능자스킬수 + 1
	SELECTCASE 1
		;変身解除
		CASE CFLAG:ARG:악마변신 == 0
			;仲魔に変身ではない＝初期変身悪魔から変身解除なら、初期変身悪魔スキルの並び順を更新
			;何らかの事情で初期変身悪魔スキルを操作する場合、悪魔変身をしている状態でやるとこの処理で上書きされるので注意
			SIF !(MIN(CFLAG:ARG:링크캐릭터실제가입시간0,仲魔) > 0)
				ABL:ARG:@"초기변신악마스킬{LOCAL}" = ABL:ARG:@"스킬{LOCAL}"
			TEMP_SKILL:LOCAL = ABL:ARG:@"인간시스킬{LOCAL}"
		;仲魔に変身
		CASE MIN(CFLAG:ARG:링크캐릭터실제가입시간0,仲魔) > 0
			;人間時スキルにスキルを保存する
			;基本的にやることはないと思うが、悪魔状態での初期悪魔スキル同様
			;人間時に人間時スキルを操作するとスキルで上書きされるので注意
			ABL:ARG:@"인간시스킬{LOCAL}" = ABL:ARG:@"스킬{LOCAL}"
			;リンク不能属性のスキルは除外
			RESULT = 0
			CALL GET_SKILL_PROP, "링크불능", ABL:仲魔:@"스킬{LOCAL}", 仲魔
			IF RESULT
				TEMP_SKILL:LOCAL = 0
			ELSE
				;覚醒スキルは除外
				IF ABL:仲魔:@"스킬{LOCAL}" == SKILL_NUM_F("각성스킬")
					TEMP_SKILL:LOCAL = 0
				ELSE
					TEMP_SKILL:LOCAL = ABL:仲魔:@"스킬{LOCAL}"
				ENDIF
			ENDIF
		;初期変身悪魔に変身
		CASEELSE
			;人間時スキルにスキルを保存する
			ABL:ARG:@"인간시스킬{LOCAL}" = ABL:ARG:@"스킬{LOCAL}"
			TEMP_SKILL:LOCAL = ABL:ARG:@"초기변신악마스킬{LOCAL}"
	ENDSELECT
NEXT
;空き番号を詰める
FOR LOCAL, FLAG:이능자스킬수, 0, -1
	SIF TEMP_SKILL:LOCAL == 0
		ARRAYREMOVE TEMP_SKILL, LOCAL, 1
NEXT
FOR LOCAL, 1, FLAG:이능자스킬수 + 1
	ABL:ARG:@"스킬{LOCAL}" = TEMP_SKILL:LOCAL
NEXT

CALL SYNC_STATUS,ARG,"HPMP割合保持"
CALL COMMAND_REPEAT, ARG


;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2310, ARG
PRINTL 악마로 변신한다。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_2310,ARG
IF FINDCHARA_LINK(ARG) > 0
	ARG:1 = FINDCHARA_LINK(ARG)
	;召喚予定のキャラは無理
	SIF CFLAG:(ARG:1):피소환플래그
		RETURN 0
	SIF CFLAG:(ARG:1):이자리에없는플래그
		RETURN 0
	SIF CFLAG:(ARG:1):전투이외불능
		RETURN 0
ENDIF
RETURN 1
;とくにない

;---- 002 自動悪魔変身 START (ADD) ------------------------------
;====================================================
;自動変身の処理
;このファイルに記述するのが適切かというとあれなんですが
;処理が必要なBATTLE.ERBとSYSTEM_DANGEONの分野が遠い上に内容が多すぎるところなので
;半システムファイルとして動いてるここに置いときます
;====================================================
@AUTO_TRANSFORM
#DIM 仲魔
FOR LOCAL,1,7
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0
		CONTINUE
	SIF CFLAG:(FLAG:LOCALS):자동변신실행완료
		CONTINUE
	SIF !CFLAG:(FLAG:LOCALS):자동변신
		CONTINUE
	SIF !ACTIONABLE_CHARA_F(FLAG:LOCALS)
		CONTINUE
	SIF !TALENT:(FLAG:LOCALS):데빌시프터 && !TALENT:(FLAG:LOCALS):식노
		CONTINUE
	;仲魔を自動的に外す挙動が発生する場合は中断する
	SIF FIND_LINKED_NAKAMA(FLAG:LOCALS)
		CONTINUE
	IF TFLAG:전투중
		SELECTCASE CFLAG:(FLAG:LOCALS):자동변신
			CASE 3
				SIF !CFLAG:(FLAG:LOCALS):악마변신
					CALL TRANS_DEVIL, FLAG:LOCALS
			CASE 4
				SIF CFLAG:(FLAG:LOCALS):악마변신
					CALL TRANS_DEVIL, FLAG:LOCALS
		ENDSELECT
	ELSE
		SELECTCASE CFLAG:(FLAG:LOCALS):자동변신
			CASE 1, 3
				SIF CFLAG:(FLAG:LOCALS):악마변신
					CALL TRANS_DEVIL, FLAG:LOCALS
			CASE 2, 4
				SIF !CFLAG:(FLAG:LOCALS):악마변신
					CALL TRANS_DEVIL, FLAG:LOCALS
		ENDSELECT
	ENDIF
	CFLAG:(FLAG:LOCALS):자동변신실행완료 = 1
NEXT

@CLEAR_AUTO_TRANSFORM_FLAG
FOR LOCAL, 1, 7
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS > -1
		CFLAG:(FLAG:LOCALS):자동변신실행완료 = 0
NEXT

@FIND_LINKED_NAKAMA, ARG
#FUNCTION
SIF !TALENT:ARG:데빌시프터
	RETURNF 0
LOCAL = FINDCHARA_LINK(ARG)
SIF LOCAL < 0
	RETURNF 0
SIF CPOS(LOCAL) < 1
	RETURNF 0
RETURNF 1
;---- 002 自動悪魔変身 END (ADD)------------------------------
