;====================================================
;スキル及び行動の実行
;====================================================
@CASTING_LINK_DEVIL(ARG:0)
TRYCCALLFORM CASTING_LINK_DEVIL_%CSTR:CASTING_CHARA:롤%, ARG:0
	SIF !RESULT
		RETURN 0
CATCH
	;---- EDIT 005 MOD START -------------------------
	SIF CSTR:(ARG:0):롤 != "悪魔"
		RETURN 0
	SIF !GET_ROLE_PROP("CAN_PUT_IN_COMP", ARG)
		RETURN 0
	;スキルが習得できない場合は無理
	SIF !GET_ROLE_PROP("CHANGEABLE_SKILLCOUNT", ARG)
		RETURN 0
	SIF CHARA_SKILLCOUNT(CASTING_CHARA, "変身形態") < CHARA_SKILLCOUNT(ARG)
		RETURN 0
	IF GROUPMATCH(FLAG:SHOP커맨드, [[ショップ:탐색]],[[ショップ:콜로세움참가]],[[ショップ:이벤트]],[[ショップ:의뢰청부]])
		SIF CPOS(ARG:0) > 0 && CFLAG:(ARG:0):소속ＣＯＭＰ < 0
			RETURN 0
	ENDIF
	;---- EDIT 005 MOD END ---------------------------
ENDCATCH
SIF CFLAG:(ARG:0):링크불능
	RETURN 0
SIF CFLAG:(ARG:0):피링크캐릭터실제가입시간 > 0
	RETURN 0
SIF TALENT:(ARG:0):비전투원
	RETURN 0
SIF CFLAG:(ARG:0):이자리에없는플래그 == 1
	RETURN 0
SIF CFLAG:(ARG:0):전투이외불능
	RETURN 0
;レンタル中は除外
SIF IS_RENTING(ARG:0)
	CONTINUE
SIF CFLAG:(ARG:0):PT플래그 == 0
	RETURN 0
RETURN 1

@UP_PRINT_ACTION_2311
PRINTFORM 누구와 링크할까？　
SIF A > リスト表示数()
	PRINTFORM ＜page.{P + 1}/{A / リスト表示数() + 1}＞
PRINTL
DRAWLINE

PRINTFORML 　　　[1001] %CSVNAME(CFLAG:CASTING_CHARA:초기링크악마,0)%

@CASTING_RESULT_ACTION_2311 , ARG
SIF ARG == 1001
	RETURN 1001 , 0
RETURN ARG , 1

@ACTION_2311, ARG, ARG:1, ARG:2
#LOCALSIZE 1
#DIM DYNAMIC L_RESULT
#DIMS L_UP_PRINT_ACTION_2311
#DIMS L_CASTING_RESULT_ACTION_2311
L_UP_PRINT_ACTION_2311 = UP_PRINT_ACTION_2311
L_CASTING_RESULT_ACTION_2311 = CASTING_RESULT_ACTION_2311

CASTING_CHARA = ARG

RESULT = 0
TRYCALLFORM ROLE_UP_PRINT_ACTION_2311_%CSTR:ARG:롤%, ARG
SIF RESULT
	L_UP_PRINT_ACTION_2311 += "_" + CSTR:ARG:롤
RESULT = 0
;CALL INPUT_CHARA_LIST("誰とリンクする？", "CASTING_LINK_DEVIL", L_UP_PRINT_ACTION_2311 , , L_CASTING_RESULT_ACTION_2311)
{
CALL INPUT_CHARA_LIST
	, "FUNC_PROPSET_LIST_BATTLE"
	, "누구와 링크할까？"
	, "CASTING_LINK_DEVIL" 
	, L_UP_PRINT_ACTION_2311
	, "SHOW_ADD_DOWN_FUNCTION"
	, L_CASTING_RESULT_ACTION_2311
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}

IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1001
	CALL REMOVE_LINK_DEVIL, ARG
	RETURN 1
ENDIF
L_RESULT = RESULT
IF FINDCHARA_LINK(ARG) > 0
	CFLAG:FINDCHARA_LINK(ARG):피링크캐릭터실제가입시간 = 0
	CFLAG:FINDCHARA_LINK(ARG):피변신플래그 = 0
ENDIF

;変身している場合変身解除
CALL TRANS_DEVIL , ARG, 0, "変身解除"

CFLAG:L_RESULT:피링크캐릭터실제가입시간 = CFLAG:ARG:실제가입시간
CFLAG:L_RESULT:피변신플래그 = 0
CFLAG:ARG:링크캐릭터실제가입시간0 = CFLAG:L_RESULT:실제가입시간

;リンクした時点で変更がかかるロールの処理
TRYCALLFORM ROLE_LINK_ACT_%CSTR:ARG:롤%, ARG
RETURN 1

;リンク悪魔の解除処理
@REMOVE_LINK_DEVIL, ARG, ARG:1 = -1, ARG:2 = -1
#DIM DYNAMIC LCOUNT
;変身している場合変身解除
CALL TRANS_DEVIL, ARG, 0, "変身解除"
FOR LCOUNT, 0, 5
	;番号指定があった場合
	SIF ARG:1 >= 0 && ARG:1 != LCOUNT
		CONTINUE
	;キャラ指定で外す場合
	SIF ARG:2 >= 0 && FINDCHARA_LINK(ARG, LCOUNT) != ARG:2
		CONTINUE
	IF FINDCHARA_LINK(ARG, LCOUNT) > 0
		CFLAG:FINDCHARA_LINK(ARG, LCOUNT):피링크캐릭터실제가입시간 = 0
		CFLAG:FINDCHARA_LINK(ARG, LCOUNT):피변신플래그 = 0
	ENDIF
	CFLAG:ARG:@"링크캐릭터실제가입시간{LCOUNT}" = 0
NEXT

;リンクした時点で変更がかかるロールの処理
;例:Aion式サマナーのスキル登録処理
TRYCALLFORM ROLE_LINK_ACT_%CSTR:ARG:롤%, ARG

