;Hi-DAS

;スキル名
@SKILL_NAME_2306,ARG
RESULTS = Hi-Das
SIF TFLAG:전투턴진행중
	RESULTS = High-Devil Analyze

;　명중
@SKILL_HITRATE_2306, ARG
RETURN 0

;　威力
@SKILL_POWER_2306, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2306,ARG
RETURN 0

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2306,ARG
RETURN 0

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2306, ARG
RETURN GET_SKILL_COST_TYPE_NUM("無消費")
;消費なし＝1

;　コストの量
@SKILL_COST_2306,ARG
RETURN 0

;　相性
@SKILL_TYPE_2306,ARG
RETURN GET_TYPE_NUM("만능")
;相性なし

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2306
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2306, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2306,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2306,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2306, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")

;계승타입
@SKILL_SUCCESSION_TYPE_2306
RETURN GET_SUCCESSION_NUM("검격")

;속도보정
@SKILL_SPEED_2306, ARG = -1
RETURN 10

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2306
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2306, ARG = -1
RETURN 0
;変化不可
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2306, ARG, ARG:1, ARG:2
CALL ACTION_SKILL_ANALYZE, POS(ARG:1)


;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2306, ARG
PRINTL 적 １체의 해석도를 높인다。

;使用条件
@SKILL_SPECIAL_ACTIONABLE_2306,ARG
RETURN 1
;とくにない

