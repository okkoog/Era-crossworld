;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_0,ARG
IF ARG < 0
	RESULTS = ＡＴＴＡＣＫ
	RETURN 0
ENDIF
IF EQUIP:ARG:검 > 0 && CFLAG:ARG:악마변신 == 0
	RESULTS = ＳＷＯＲＤ
ELSEIF TALENT:ARG:식노 > 0 && CFLAG:ARG:악마변신 == 1
	RESULTS = ＨＵＮＴ
ELSEIF TALENT:ARG:소인체형 && (TALENT:ARG:남자 == 0 || TALENT:ARG:오토코노코)
	SIF EQUIP:(ARG):악세서리 == 8190
		RESULTS = 찍찍 쏜다
	SELECTCASE ABL:ARG:공격상성
		CASE 2
			RESULTS = 찰싹찰싹 때린다
		CASE 3
			RESULTS = 앙앙 문다
		CASE 0
			RESULTS = 콕콕 찌른다
		CASEELSE
			RESULTS = ＡＴＴＡＣＫ
	ENDSELECT
ELSEIF TALENT:ARG:유아체형 && (TALENT:ARG:남자 == 0 || TALENT:ARG:오토코노코)
	SIF EQUIP:(ARG):악세서리 == 8190
		RESULTS = 찍찍 쏜다
	SELECTCASE ABL:ARG:공격상성
		CASE 2
			RESULTS = 콩콩 때린다
		CASEELSE
			RESULTS = ＡＴＴＡＣＫ
	ENDSELECT
ELSE
	RESULTS = ＡＴＴＡＣＫ
ENDIF

;　명중
@SKILL_HITRATE_0, ARG = -1
LOCAL = 100
SIF ARG == -1
	RETURN 100
;IF ABL:ARG:종족 != 0 && NO:ARG != 3501 && NO:ARG != 3502
SIF EQUIP:(ARG):악세서리 == 8190
	RETURN LOCAL
SELECTCASE ABL:ARG:사거리
	CASE 2
		LOCAL -= 5
	CASE 3
		LOCAL -= 15
ENDSELECT
;ENDIF
RETURN LOCAL

;　威力
@SKILL_POWER_0, ARG = -1
LOCAL = 100
SIF ARG == -1
	RETURN 100
;IF ABL:ARG:종족 != 0 && NO:ARG != 3501 && NO:ARG != 3502
SELECTCASE ABL:ARG:공격범위
	CASE 2
		LOCAL -= 15
	CASE 3
		LOCAL -= 30
	CASE 5
		LOCAL -= 10
ENDSELECT
SIF HAVE_SKILL(ARG, [[스킬:흡수공격]])
	LOCAL = LOCAL * 7/10
;ENDIF
RETURN LOCAL

;　吸収率
@SKILL_HP_ABSORBER_0, ARG
IF HAVE_SKILL(ARG, [[스킬:흡수공격]])
	SELECTCASE ABL:ARG:공격범위
		CASE 2
			RETURN 15
		CASE 3
			RETURN 10
	ENDSELECT
	RETURN 25
ENDIF
RETURN 0

