;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_0, ARG, ARG:1, ARG:2
LOCAL = ARG:1
IF ARG:1 == 0
	PRINTW 올바르지 않은 위치를 공격하려 했습니다
	RETURN 0
ENDIF
CALL ATTACK_SKILL, ARG, ARG:1, 0, 1
;IF ARG:1 < 17 
;	LOCAL = POS(ARG:1)
;	CALL ATTACK_SINGLE,ARG,LOCAL,0,1
;ELSE
;	CALL ATTACK_FIELD,ARG,ARG:1,0,1
;ENDIF
;人間のみ武器の熟練度上昇
IF ABL:ARG:종족 == 0 || ABL:ARG:종족 == 36
	TRYCCALLFORM 剣タイプ_{EQUIP:ARG:검}
		IF RESULT > 0 && RESULT < 12
			CFLAG:ARG:(1049 + RESULT) += (1 + RAND:5) * (EQUIP:ARG:악세서리 == 5207 ? 2 # 1)
			CFLAG:ARG:(1049 + RESULT) = MIN(1000,CFLAG:ARG:(1049 + RESULT))
		ENDIF
	CATCH
	ENDCATCH
ENDIF	





