;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_228,ARG
RESULTS = 타격가드브레이크

;　명중
@SKILL_HITRATE_228, ARG
RETURN 100

;　威力
@SKILL_POWER_228, ARG
RETURN 0

;　최저공격횟수
@SKILL_MINATTACKNUMBER_228,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_228,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_228, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_228,ARG
RETURN 55

;　相性
@SKILL_TYPE_228,ARG
RETURN GET_TYPE_NUM("타격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_228
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_228, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_228,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_228,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_228, ARG
RETURN GET_SKILL_EFFECT_NUM("특수")


;계승타입
@SKILL_SUCCESSION_TYPE_228
RETURN GET_SUCCESSION_NUM("타격")

;속도보정
@SKILL_SPEED_228, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_228
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_228, ARG = -1
RETURN 13



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_228, ARG, ARG:1, ARG:2
CALL SKILL_GUARD_KILL, ARG, "타격", ARG:1, 3

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_228, ARG
PRINTL 3턴간、적 전체의 타격 내성을 무효화한다




;使用条件
@SKILL_SPECIAL_ACTIONABLE_228,ARG
RETURN 1
;とくにない




