
;スキル名
@SKILL_NAME_242,ARG
RESULTS = 빈사의일격

;　명중
@SKILL_HITRATE_242, ARG
RETURN 90

;　威力
@SKILL_POWER_242, ARG = -1
SIF ARG == -1
	RETURN 200
SELECTCASE BASE:ARG:ＨＰ * 100 / MAXBASE:ARG:ＨＰ
	CASE IS <= 1
		RETURN 600
	CASE IS < 5
		RETURN 450
	CASE IS < 20
		RETURN 350
	CASE IS < 50
		RETURN 275
	CASE IS < 70
		RETURN 250
	CASEELSE
		RETURN 225
ENDSELECT


