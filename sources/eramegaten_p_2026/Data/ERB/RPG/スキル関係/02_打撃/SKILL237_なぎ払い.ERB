;-------------------------------------------------------------------------------
; [メモ]
; 打撃版の回転斬りみたいなポジション。回し蹴りとメガトンプレスの中間。
; 全体中ダメージ。
;-------------------------------------------------------------------------------


;スキル名
@SKILL_NAME_237,ARG
IF SKILL_CHANGE(ARG, [[キャラ:스우]])
	RESULTS = 閃炎華
ELSE
	RESULTS = 베어넘기기
ENDIF

;　명중
@SKILL_HITRATE_237, ARG
RETURN 95

;　威力
@SKILL_POWER_237, ARG
RETURN 180

;　최저공격횟수
@SKILL_MINATTACKNUMBER_237,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_237,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_237, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_237,ARG
RETURN 12

;　相性
@SKILL_TYPE_237,ARG
RETURN GET_TYPE_NUM("타격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_237
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_237, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_237, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_237,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_237,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_237, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_237
RETURN GET_SUCCESSION_NUM("타격")

;속도보정
@SKILL_SPEED_237, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_237
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_237, ARG = -1
RETURN 7



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_237, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,237






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_237, ARG
PRINTL 적 전체에 중위력의 타격 상성 공격을 행한다。





;使用条件
@SKILL_SPECIAL_ACTIONABLE_237,ARG
RETURN 1
;とくにない

