
;瀕死の一撃の全体バージョン。命中更に低下。

;スキル名
@SKILL_NAME_243,ARG
RESULTS = 최후의일격

;　명중
@SKILL_HITRATE_243, ARG
RETURN 80

;　威力
@SKILL_POWER_243, ARG = -1
SIF ARG == -1
	RETURN 300
SELECTCASE BASE:ARG:ＨＰ * 100 / MAXBASE:ARG:ＨＰ
	CASE IS <= 1
		RETURN 900
	CASE IS < 5
		RETURN 600
	CASE IS < 20
		RETURN 450
	CASE IS < 50
		RETURN 400
	CASE IS < 70
		RETURN 350
	CASEELSE
		RETURN 300
ENDSELECT


;　최저공격횟수
@SKILL_MINATTACKNUMBER_243,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_243,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_243, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_243,ARG
RETURN 25

;　相性
@SKILL_TYPE_243,ARG
RETURN GET_TYPE_NUM("타격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_243
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_243, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_243, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_243,ARG
RETURN 4

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_243,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_243, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_243
RETURN GET_SUCCESSION_NUM("타격")

;속도보정
@SKILL_SPEED_243, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_243
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_243, ARG = -1
RETURN 12


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_243, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,243

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_243, ARG
PRINTL 적 전체에 타격 상성의 대 데미지。ＨＰ가 낮을수록 위력이 높아진다。




;使用条件
@SKILL_SPECIAL_ACTIONABLE_243,ARG
RETURN 1
;とくにない

