@ACTION_208, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
IF CFLAG:LOCAL:방어플래그
	CFLAG:LOCAL:방어플래그 = 0
	FLAG:확산플래그 = 1
	CALL ATTACK_SINGLE,ARG,LOCAL,208
	FLAG:확산플래그 = 0
ELSE
	CALL ATTACK_SINGLE,ARG,LOCAL,208
ENDIF





