;　명중
@SKILL_HITRATE_224, ARG
RETURN 90

;　威力
@SKILL_POWER_224, ARG = -1
SIF ARG == -1
	RETURN 300
SELECTCASE BASE:ARG:ＨＰ * 100 / MAXBASE:ARG:ＨＰ
	CASE IS <= 1
		RETURN 900
	CASE IS < 5
		RETURN 600
	CASE IS < 20
		RETURN 450
	CASE IS < 50
		RETURN 400
	CASE IS < 70
		RETURN 350
	CASEELSE
		RETURN 300
ENDSELECT


