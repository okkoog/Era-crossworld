;スキル名
@SKILL_NAME_230,ARG
RESULTS = 천열찌르기

;　명중
@SKILL_HITRATE_230, ARG
RETURN 100

;　威力
@SKILL_POWER_230, ARG
RETURN 100

;2+敵の速さより5高いごとに最大攻撃回数+1
;最大攻撃回数が7回に到達したのちは最低攻撃回数が増加する
;ただし敵はステータス不利になるので判定の際の速さが増加する
@SKILL_MINATTACKNUMBER_230,ARG
SIF ARG == -1 || TFLAG:스킬용1 == -1
	RETURN 2
RETURN LIMIT(MAX(MAXBASE:ARG:속도 - MAXBASE:(TFLAG:스킬용1):속도 + (!CFLAG:ARG:PT플래그 * 10) - 25, 1) / 5 + 2, 2, 7)

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_230,ARG
SIF ARG == -1 || TFLAG:스킬용1 == -1
	RETURN 7
RETURN LIMIT(MAX(MAXBASE:ARG:속도 - MAXBASE:(TFLAG:스킬용1):속도 + (!CFLAG:ARG:PT플래그 * 10), 1) / 5 + 2, 2, 7)

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_230, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_230,ARG
RETURN 32

;　相性
@SKILL_TYPE_230,ARG
RETURN GET_TYPE_NUM("타격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_230
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_230, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_230, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_230,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_230,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_230, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_230
RETURN GET_SUCCESSION_NUM("타격")

;속도보정
@SKILL_SPEED_230, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_230
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_230, ARG = -1
RETURN 11



;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_230, ARG, ARG:1, ARG:2
#LOCALSIZE 3
IF CFLAG:ARG:포지션 < 7
	LOCAL:1 = 7
	LOCAL:2 = 12 
ELSE
	LOCAL:1 = 1
	LOCAL:2 = 4
ENDIF
FOR LOCAL, LOCAL:1, LOCAL:2
	SIF POS(LOCAL) < 0
		CONTINUE
	SIF GET_STATE(CFLAG:POS(LOCAL):상태이상) == "DYING"
		CONTINUE
	;FLAG:확산플래그 = POS(LOCAL)
	TFLAG:스킬용1 = POS(LOCAL)
	CALL ATTACK_SINGLE, ARG, POS(LOCAL), 230
NEXT
;FLAG:확산플래그 = -1

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_230, ARG
PRINTL 적 전열에 각각 ２～７회、소위력 공격。
PRINTL 속도가 대상을 ５ 상회할 때마다 최대공격횟수가 증가한다。
PRINTL 최대공격횟수가 ７회에 도달하면、최저공격횟수가 증가한다。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_230,ARG
RETURN 1
;とくにない

