;スキル名
@SKILL_NAME_229,ARG
RESULTS = 백열찌르기

;　명중
@SKILL_HITRATE_229, ARG
RETURN 100

;　威力
@SKILL_POWER_229, ARG
RETURN 100

;2+敵の速さより5高いごとに最大攻撃回数+1
;最大攻撃回数が7回に到達したのちは最低攻撃回数が増加する
;ただし敵はステータス不利になるので判定の際の速さが増加する
;　최저공격횟수
@SKILL_MINATTACKNUMBER_229,ARG
SIF ARG == -1
	RETURN 2
RETURN LIMIT(MAX(MAXBASE:ARG:속도 - MAXBASE:POS(CFLAG:ARG:타겟):속도 + (!CFLAG:ARG:PT플래그 * 10) - 25, 1) / 5 + 2, 2, 7)
;　최대공격횟수
@SKILL_MAXATTACKNUMBER_229,ARG
SIF ARG == -1
	RETURN 7
RETURN LIMIT(MAX(MAXBASE:ARG:속도 - MAXBASE:POS(CFLAG:ARG:타겟):속도 + (!CFLAG:ARG:PT플래그 * 10), 1) / 5 + 2, 2, 7)

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_229, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_229,ARG
RETURN 8

;　相性
@SKILL_TYPE_229,ARG
RETURN GET_TYPE_NUM("타격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_229
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_229, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_229, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_229,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_229,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_229, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_229
RETURN GET_SUCCESSION_NUM("타격")

;속도보정
@SKILL_SPEED_229, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_229
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_229, ARG = -1
RETURN 8

@SKILL_RANKUP_229
D:1 = 230
;ランクアップ先は一つ
RETURN 1


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_229, ARG, ARG:1, ARG:2
LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,229

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_229, ARG
PRINTL 적 １체에 ２～７회、소위력 공격。
PRINTL 속도가 대상을 ５ 상회할때마다 최대공격횟수가 증가한다。
PRINTL 최대공격횟수가 ７회에 도달하면、최저공격횟수가 증가한다。



;使用条件
@SKILL_SPECIAL_ACTIONABLE_229,ARG
RETURN 1
;とくにない

