;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_209, ARG, ARG:1, ARG:2
;コスト支払い
;CALL PAY_COST

IF ARG:1 == 19
	LOCAL:7 = 1
	LOCAL:8 = 7
ELSE
	LOCAL:7 = 7
	LOCAL:8 = 17
ENDIF

FOR LOCAL:1,LOCAL:7,LOCAL:8
	LOCAL = POS(LOCAL:1)
	SIF LOCAL < 0
		CONTINUE
	SIF GET_STATE(CFLAG:LOCAL:상태이상) == "DYING"
		CONTINUE
	IF CFLAG:LOCAL:방어플래그
		CFLAG:LOCAL:방어플래그 = 0
		FLAG:확산플래그 = 2
		CALL ATTACK_SINGLE,ARG,LOCAL,209
		FLAG:확산플래그 = 0
	ELSE
		FLAG:확산플래그 = 1
		CALL ATTACK_SINGLE,ARG,LOCAL,209
		FLAG:확산플래그 = 0
	ENDIF
NEXT




