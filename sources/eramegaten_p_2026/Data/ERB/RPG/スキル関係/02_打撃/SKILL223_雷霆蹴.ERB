
;スキル名
@SKILL_NAME_223,ARG
IF SKILL_CHANGE(ARG, [[キャラ:시온]])
	RESULTS = 커팅ㆍ싱크
ELSEIF SKILL_CHANGE(ARG, [[キャラ:아키하]])
	RESULTS = 아가씨 야쿠자 킥
ELSE
	RESULTS = 뇌정축
ENDIF

