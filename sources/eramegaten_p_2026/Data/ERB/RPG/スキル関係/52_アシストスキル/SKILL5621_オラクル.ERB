;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_5621, ARG, ARG:1, ARG:2
#DIM LCOUNT
#DIMS L_EFFECT
IF SKILL_5621_GET_ORACLE_EFFECT(ARG) == "未発動"
	CALL SKILLGAGE_D_SET, ARG, 5621, 2
	SELECTCASE RAND:10000
		CASE IS < 1500
			L_EFFECT = 異常回復
			PRINTFORMW ＞턴 종료시에 아군 전원의 배드스테이터스를 회복한다！
		CASE IS < 2500
			L_EFFECT = 全能力アップ
			PRINTFORMW ＞턴 종료시에 아군 전원의 모든 능력이 UP한다！
		CASE IS < 3000
			L_EFFECT = 全能力大幅アップ
			PRINTFORMW ＞턴 종료시에 아군 전원의 모든 능력이 대폭 UP한다！
		CASE IS < 3500
			L_EFFECT = 能力アップダウン解除
			PRINTFORMW ＞턴 종료시에 아군 전원의 능력의 UP과 DOWN이 해제된다！
		CASE IS < 4500
			L_EFFECT = クリティカル率アップ
			PRINTFORMW ＞턴 종료시에 아군 전원의 크리티컬률이 대폭 UP한다！
		CASE IS < 5000
			L_EFFECT = 気合集中
			PRINTFORMW ＞턴 종료시에 아군 전원이 다음의 물리공격력과 마법공격력을 대폭 증가하는 효과를 얻는다！
		CASE IS < 6000
			L_EFFECT = HP全回復
			PRINTFORMW ＞턴 종료시에 아군 전원의 ＨＰ가 전부 회복한다！
		CASE IS < 7000
			L_EFFECT = HP回復
			PRINTFORMW ＞턴 종료시에 아군 전원의 ＨＰ가 회복한다！
		CASE IS < 7500
			L_EFFECT = 護りの盾
			PRINTFORMW ＞턴 종료시에 아군 전원이 적의 공격을 무효화하는 효과를 얻는다！
		CASE IS < 8500
			L_EFFECT = MP消費半減
			PRINTFORMW ＞다음 턴、아군 전원의 소비 ＭＰ가 50\% 환원되게 된다！
		CASE IS < 9000
			L_EFFECT = MP消費無効
			PRINTFORMW ＞다음 턴、아군 전원의 소비 ＭＰ가 100\% 환원되게 된다！
		CASEELSE 
			L_EFFECT = 瀕死
			PRINTFORMW ＞턴 종료시에、아군 전원의 대 데미지를 받는다！
	ENDSELECT
	FOR LCOUNT, 0, 20
		SIF L_EFFECT == SKILL_5621_ORACLE_EFFECT(LCOUNT)
			CALL SKILLGAGE_H_SET, ARG, 5621, LCOUNT
	NEXT
ENDIF

