;何のバッドステータスを治せるか
@SKILL_CURE_STATE_5621, ARG
IF SKILL_5621_GET_ORACLE_EFFECT(ARG) == "異常回復"
	SELECTCASE GET_STATE(ARG)
		CASE "GOOD", "DYING"
			RETURN 0
		CASEELSE
			RETURN 1
	ENDSELECT
	ENDIF
RETURN 0
@SKILL_5621_ORACLE_EFFECT, ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		RETURNF "異常回復"
	CASE 2
		RETURNF "全能力アップ"
	CASE 3
		RETURNF "全能力大幅アップ"
	CASE 4
		RETURNF "クリティカル率アップ"
	CASE 5
		RETURNF "能力アップダウン解除"
	CASE 6
		RETURNF "気合集中"
	CASE 7
		RETURNF "HP全回復"
	CASE 8
		RETURNF "HP回復"
	CASE 9
		RETURNF "護りの盾"
	CASE 10
		RETURNF "瀕死"
	CASE 11
		RETURNF "MP消費半減"
	CASE 12
		RETURNF "MP消費無効"
ENDSELECT

@SKILL_5621_GET_ORACLE_EFFECT, ARG
#FUNCTIONS
SIF !SKILLGAGE_D_GET(ARG, 5621)
	RETURNF "未発動"
RETURNF SKILL_5621_ORACLE_EFFECT(SKILLGAGE_H_GET(ARG, 5621))

@SKILL_TURNEND_5621, ARG
#DIM LCOUNT, 2
#DIMS TEMPS
SIF GROUPMATCH(SKILL_5621_GET_ORACLE_EFFECT(ARG), "未発動")
	RETURN 0
SETCOLOR COLOR("BATTLE", ARG)
CALL MESSAGE_B, 1, "예언이 실현된다！"
RESETCOLOR
SELECTCASE SKILL_5621_GET_ORACLE_EFFECT(ARG)
	CASE "異常回復"
		CALL CURE_STATE_FIELD,ARG, 19,5621
	CASE "全能力アップ"
		CALL SKILL_SET_カジャンダ, ARG, 19, "공격/방어/마법위력/마법효과/명중/회피", 4, "範囲"
	CASE "全能力大幅アップ"
		CALL SKILL_SET_カジャンダ, ARG, 19, "공격/방어/마법위력/마법효과/명중/회피", 8, "範囲"
	CASE "クリティカル率アップ"
		CALL SKILL_SET_カジャンダ, ARG, 19, "크리티컬률", 8, "範囲"
	CASE "能力アップダウン解除"
		FOR LCOUNT,1, 7
			SIF !IS_TARGET_ABLE(POS(LCOUNT))
				CONTINUE
			FOR LCOUNT:1, GETNUM(CFLAG,"공격강화"), GETNUM(CFLAG,"마법효과강화")+1
				CFLAG:POS(LCOUNT):(LCOUNT:1) = 0
			NEXT
			CALL PRINT_HIT_MESSAGE, POS(LCOUNT), "능력 상승과 저하가 해제되었다！"
		NEXT
		WAIT
	CASE "気合集中"
		FOR LCOUNT,1, 7
			SIF !IS_TARGET_ABLE(POS(LCOUNT))
				CONTINUE
			IF CFLAG:POS(LCOUNT):気合フラグ == 0 && CFLAG:POS(LCOUNT):집중플래그 == 0
				TEMPS = 공격력 대폭 UP & 마법공격력 대폭 UP
			ELSEIF CFLAG:POS(LCOUNT):気合フラグ == 0
				TEMPS = 공격력 대폭 UP
			ELSEIF CFLAG:POS(LCOUNT):집중플래그 == 0
				TEMPS = 마법공격력 대폭 UP
			ELSE
				TEMPS = 효과없음
			ENDIF
			CFLAG:POS(LCOUNT):気合フラグ = MAX(CFLAG:POS(LCOUNT):気合フラグ, 1)
			CFLAG:POS(LCOUNT):집중플래그 = MAX(CFLAG:POS(LCOUNT):집중플래그, 1)
			CALL PRINT_HIT_MESSAGE, POS(LCOUNT), TEMPS
		NEXT
		WAIT
	CASE "HP全回復"
		CALL HEAL_FIELD,ARG, 19,5621
	CASE "HP回復"
		CALL HEAL_FIELD,ARG, 19,5621
	CASE "護りの盾"
		CALL SKILL_INVALID_WALL, ARG, 19, "수호의방패", "範囲"
	CASE "瀕死"
		FOR LCOUNT,1, 7
			SIF !IS_TARGET_ABLE(POS(LCOUNT))
				CONTINUE
			TEMPS = {BASE:POS(LCOUNT):ＨＰ - 1}데미지
			CALL VAR_HP, POS(LCOUNT), -(BASE:POS(LCOUNT):ＨＰ - 1), "食いしばり無効ダメージ"
			CALL PRINT_HIT_MESSAGE, POS(LCOUNT), TEMPS
		NEXT
		WAIT
	CASE "MP消費半減"
		CALL SET_C_BTL_EFFECT_FIELD, ARG, 19, "MP消費半減"
	CASE "MP消費無効"
		CALL SET_C_BTL_EFFECT_FIELD, ARG, 19, "MP消費無効"
ENDSELECT
CALL SKILLGAGE_H_SET, ARG, 5621, 0
