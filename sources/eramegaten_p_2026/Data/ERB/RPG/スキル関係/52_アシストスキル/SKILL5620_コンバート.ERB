;============================================
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_5620, ARG, ARG:1, ARG:2
#DIMS L_SKILL_NAME
CALL GET_SKILL_PROP, "SKILL_NAME", SKILL_NUM_F("변신악마변경"), POS(ARG:1)

L_SKILL_NAME = %RESULTS%
CALL PRINT_HIT_MESSAGE, POS(ARG:1), L_SKILL_NAME, "W"
CALL SKILL_ACTION, SKILL_NUM_F("변신악마변경"), POS(ARG:1)
SIF !RESULT
	RETURN 0
CALL PRINT_ACT_MESSAGE, POS(ARG:1), SKILL_NUM_F("변신악마변경")
PRINTFORMW 　%조사처리(CALLNAME:POS(ARG:1), "는")% %조사처리(L_SKILL_NAME,"을")% 실행했다！
RETURN 1

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_5620, ARG
PRINTL 아군 한 명의 링크악마、혹은 세트악마를 변경한다。

@SKILL_EXPLAIN_TOOLTIP_5620, ARG
CALL GET_CAST_SKILL_EMULATOR, 5620, ARG
IF ARG < 0
	RESULTS = 어시스트스킬:필요턴수%TOFULL(TOSTR(RESULT))%
ELSE
	IF RESULT <= 0
		RESULTS = 어시스트스킬:ＲＥＡＤＹ
	ELSE
		RESULTS = 어시스트스킬:필요턴수%TOFULL(TOSTR(RESULT))%
	ENDIF
ENDIF
RESULTS:1 = 아군 한 명의 링크악마、혹은 세트악마를 변경한다。

@SKILL_BATTLE_MAIN_TOOLTIP_5620, ARG, ARG:1
CALL GET_CAST_SKILL_EMULATOR, ARG:1, ARG
RESULTS = □컨버트
IF RESULT <= 0
	RESULTS:1 = 　READY
ELSE
	RESULTS:1 =　필요턴수:{RESULT}
ENDIF

@ロール専用_5620
RESULTS = Aion식 서머너
RETURN 1

@SKILL_EX_DISPLAY_5620, ARG, ARGS
CALL ASSIST_SKILL_EX_DISPLAY, ARG, ARGS, 5620, "Convert"
RETURN RESULT




;ターゲット条件
@SKILL_TARGETABLE_5620,ARG, ARG:1
SIF !GET_ROLE_PROP("CAN_USE_LINK", ARG:1)
	RETURN 0
SIF RESULTS_F:3 != "悪魔一般"
	RETURN 0
SIF !INPUTABLE_CHARA_F(ARG:1)
	RETURN 0
RETURN 1

;使用条件
@SKILL_SPECIAL_ACTIONABLE_5620, ARG
#DIM L_POS
RESULTS = 対象不在
FOR L_POS, 1, 7
	SIF !GET_ROLE_PROP("CAN_USE_LINK", POS(L_POS))
		CONTINUE
	SIF RESULTS_F:3 != "悪魔一般"
		CONTINUE
	SIF !INPUTABLE_CHARA_F(POS(L_POS))
		CONTINUE
	RETURN 1
NEXT
RETURN 0
;とくにない

