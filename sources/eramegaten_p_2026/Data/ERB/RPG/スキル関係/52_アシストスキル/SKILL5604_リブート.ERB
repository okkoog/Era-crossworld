;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_5604, ARG, ARG:1, ARG:2
#DIM L_POS
#DIM L_CHARA
#DIM SUMMON_DEVIL
#DIM IS_SUMMON_ABLE
;控えも含めて死者を全員起こす
FOR L_CHARA, 0, CHARANUM
	SIF !IS_COMP内効果有効(L_CHARA)
		CONTINUE
	SIF CFLAG:L_CHARA:상태이상 != GET_STATE_NUM("DYING")
		CONTINUE
	CFLAG:L_CHARA:상태이상 = 0
	CFLAG:L_CHARA:상태이상경과턴수 = 0
	CALL VAR_HP, L_CHARA, MAXBASE:L_CHARA:ＨＰ
	CALL COMMAND_REPEAT, L_CHARA
	CALL PRINT_HIT_MESSAGE, L_CHARA, "되살아났다", "L"
NEXT
TFLAG:추가소환권 += 3
PRINTFORMW 추가로 ３회의 ＳＵＭＭＯＮ을 사용 가능해졌다！
WAIT
CALL SKILLGAGE_H_SET, ARG, 5604, 1

;====================================================
;実行内容ここまで
;====================================================

;====================================================
;実行内容ここまで
;====================================================
;　 説明文の表示
@SKILL_EXPLAIN_5604, ARG
PRINTL 빈사의 아군을 전원 부활시키고、추가로 이 턴간、추가로 ３회의 소환권을 얻는다。

@SKILL_EXPLAIN_TOOLTIP_5604, ARG
CALL GET_CAST_SKILL_EMULATOR, 5604, ARG
IF ARG < 0
	RESULTS = 어시스트스킬:필요턴수%TOFULL(TOSTR(RESULT))%
ELSE
	IF RESULT <= 0
		RESULTS = 어시스트스킬:ＲＥＡＤＹ
	ELSE
		RESULTS = 어시스트스킬:필요턴수%TOFULL(TOSTR(RESULT))%
	ENDIF
ENDIF
RESULTS = 빈사의 아군을 전원 부활시키고、추가로 이 턴간、추가로 추가로 ３회의 소환권을 얻는다。

@SKILL_BATTLE_MAIN_TOOLTIP_5604, ARG, ARG:1
CALL GET_CAST_SKILL_EMULATOR, ARG:1, ARG
RESULTS = □리부트
IF RESULT <= 0
	RESULTS:1 = 　READY
ELSE
	RESULTS:1 =　필요턴수:{RESULT}
ENDIF

@SKILL_EX_DISPLAY_5604, ARG, ARGS
CALL ASSIST_SKILL_EX_DISPLAY, ARG, ARGS, 5604, "Reboot"
RETURN RESULT


