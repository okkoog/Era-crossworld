;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_5603, ARG, ARG:1, ARG:2
CALL SKILL_CURE_STATE_5603,CFLAG:(ARG:1):상태이상
IF RESULT == 1
	PRINTFORMW %조사처리(CALLNAME:(ARG:1),"는")% 되살아났다
	CFLAG:(ARG:1):상태이상 = 0
	CFLAG:(ARG:1):상태이상경과턴수 = 0
	CALL VAR_HP,(ARG:1),MAXBASE:(ARG:1):ＨＰ/4
	CALL COMMAND_REPEAT, ARG:1
ENDIF

