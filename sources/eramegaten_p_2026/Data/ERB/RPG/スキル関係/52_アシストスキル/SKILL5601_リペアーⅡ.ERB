CALL GET_CAST_SKILL_EMULATOR, 5601, ARG
IF ARG < 0
	RESULTS = 어시스트스킬:필요턴수%TOFULL(TOSTR(RESULT))%
ELSE
	IF RESULT <= 0
		RESULTS = 어시스트스킬:ＲＥＡＤＹ
	ELSE
		RESULTS = 어시스트스킬:필요턴수%TOFULL(TOSTR(RESULT))%
	ENDIF
ENDIF
