@SKILL_HITRATE_2734, ARG
RETURN 100

;　威力
@SKILL_POWER_2734, ARG
RETURN 200

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2734,ARG
RETURN 1

;　최대공격횟수
