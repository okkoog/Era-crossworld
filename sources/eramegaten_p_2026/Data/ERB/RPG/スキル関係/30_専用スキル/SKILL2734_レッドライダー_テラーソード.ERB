@SKILL_ADDTIONAL_BASE_RATE_2734,ARG
RETURN 30

;追加効果付与確率上限
@SKILL_ADDTIONAL_MAX_RATE_2734,ARG
RETURN 65

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_2734, ARG = -1, ARG:1 = -1
RETURN 4
;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2734, ARG, ARG:1, ARG:2
CALL ATTACK_SKILL,ARG,ARG:1,2734

