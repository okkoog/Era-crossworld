;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2736, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD, ARG, ARG:1, 2736

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2736, ARG
PRINTL 적 전체에 대위력의 전술 상성 공격。
PRINTL 대상이 상태이상일 시、위력이 상승한다



;使用条件
@SKILL_SPECIAL_ACTIONABLE_2736,ARG
RETURN 1
;とくにない

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_2736, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			SIF CFLAG:L_P:입력행동 == 2736 && !IS_BADSTATE(L_TARGET, "GOOD")
				RETURN 100
	ENDSELECT
;自分が防御側
ELSE
ENDIF
RETURN 0
