;====================================================
;●폭철화의무대장치＜ホマンドー＞
;====================================================
;ほむほむがわるぷーにブッパしたアレイメージのスキル
;飛具飛具飛具火炎核熱の多段全体攻撃
;知恵によってダメージが強化される
;素の威力は控えめ（結局わるぷー仕留められてないし）で燃費も悪い
;また、仮にほむら以外が使用した場合、命中が爆下がりしてマトモに扱えたもんじゃなくなる
;※眼鏡ほむら、悪魔ほむらでもダメです※
;====================================================

;スキル名
@SKILL_NAME_2712,ARG
	;まさにホマンドー
;	RESULTS = ホマンドー
	;俗にいう「ピタゴラ装置」のこと
;	RESULTS = ｺﾞｰﾙﾄﾞﾊﾞｰｸﾞ・ﾏｼﾝ
	;舞台装置の魔女を撃破するための舞台装置
;	RESULTS = 爆殺舞台装置
	RESULTS = 폭철화의무대장치

;　명중
@SKILL_HITRATE_2712, ARG
;ほむほむ以外がマトモにピタゴラできると思うな
IF SKILL_CHANGE(ARG, [[キャラ:호무라]])
	RETURN 120
ELSE
	RETURN 25
ENDIF


;　威力
@SKILL_POWER_2712, ARG
	SIF ARG < 0
		RETURN 50
	;知恵の半分が威力に加算される
	;素の威力は40+40+40+50+90＝260とコストに比してかなり悲惨
	;想定威力は、知恵40の60+60+60+70+110＝360
	;知恵60で70+70+70+80+120＝410、まあ専用スキルだし今すぐ許せよ！って感じ
	;最大威力は、+250になるので510、でも知恵100に、するかぁ？いくらほむほむとは言え

	;威力加算は知恵100まで
	FLAG:확산플래그 = MIN((MAXBASE:(ARG):지혜 / 2),50)

	;1-3回目はちょっと威力が低いが、4、5回目は威力を上昇させる
	IF FLAG:공격횟수 == 3
		;タンクローリーだッ！
		RETURN 50 + FLAG:확산플래그
	ELSEIF FLAG:공격횟수 == 4
		;シメの爆破
		RETURN 90 + FLAG:확산플래그
	ELSE
		RETURN 40 + FLAG:확산플래그
	ENDIF

	;おまじない
	RETURN 50


;　최저공격횟수
@SKILL_MINATTACKNUMBER_2712,ARG
RETURN 5

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2712,ARG
RETURN 5

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2712, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2712,ARG
;3相性の全体多段攻撃なので燃費はかなり悪い（命中のわりにも）
;参考までに、デッドリーバーンは35
RETURN 50

;　相性
@SKILL_TYPE_2712,ARG
IF FLAG:공격횟수 == 3
	;화염
	;タンクローリーだッ！
	RETURN GET_TYPE_NUM("화염")
ELSEIF FLAG:공격횟수 == 4
	;핵열
	;シメの爆破
	RETURN GET_TYPE_NUM("핵열")
ENDIF
;基本は飛具
RETURN GET_TYPE_NUM("비구")


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2712
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2712,ARG
;ほむほむ一応魔法型だったっけか……いちおう知恵をあげる＝魔法威力の方が高いハズなので魔法攻撃
RETURN 2


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2712, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2712,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2712,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2712, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2712
RETURN GET_SUCCESSION_NUM("비구")
;비구

;속도보정
@SKILL_SPEED_2712, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2712
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2712, ARG = -1
RETURN 15

@継承不能_2712
RETURN 2

@SKILL_RANKUP_2712
;ランクアップしない
RETURN 0


;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2712, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD,ARG,ARG:1,2712



;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2712, ARG
;PRINTL ホマンドー。またの名を、マジカル爆殺ピタゴラスイッチ。
PRINTL 지혜에 따라 위력이 상승한다、비구・화염・핵열 상성의 전체 다단 마법공격。
PRINTL 무대장치의 마녀를 폭살하기 위한 무대장치、그 재연。
PRINTL 마법소녀 아케미 호무라의 비장의 수。
PRINTL 이런 것을 제대로 맞출 수 있는 자는、호무라 본인뿐이다。
;PRINTL なお、一回で200億円くらいかかるとかなんとか。





;使用条件
@SKILL_SPECIAL_ACTIONABLE_2712,ARG
RETURN 1
;とくにない

