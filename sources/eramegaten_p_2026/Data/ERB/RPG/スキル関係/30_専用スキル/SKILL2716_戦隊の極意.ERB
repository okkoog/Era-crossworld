;====================================================
;ステータス計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_ADD_STATUS_2716, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM LCOUNT
#DIM IS_FAIL
;フロストファイブはこのスキルの効果の影響を受けない
SIF BTL_NO(ARG) == [[キャラ:프로스트파이브]]
	RETURN 0
SELECTCASE ARGS
	CASE "HP補正"
		RESULTS = 固定
		RETURN 55
	CASE "相性"
		IF ARGS:1 == "만능"
			RETURN 1, 100
		ELSE
			RETURN 1, 999
		ENDIF
ENDSELECT

@SKILL_PASSIVE_BTL_EFFECT_2716, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM LCOUNT

;フロストファイブはこのスキルの効果の影響を持たない
SIF BTL_NO(L_P) == [[キャラ:프로스트파이브]]
	RETURN 0
;敵はペナルティなし
SIF !CFLAG:L_P:PT플래그
	RETURN 0
;自分が防御側
IF L_P != L_ACTOR
	IF ARGS == "相性変化"
		FOR LCOUNT, 1, 7
			SIF POS(LCOUNT) < 0
				CONTINUE
			;自分自身はカウントしない
			SIF POS(LCOUNT) == L_P
				CONTINUE
			;スキル持ち+フロストファイブ変身体などだけ通す
			SIF !(BTL_NO(POS(LCOUNT)) == [[キャラ:프로스트파이브]] || HAVE_SKILL(POS(LCOUNT), SKILL_NUM))
				CONTINUE
			RESULTS = 전대의극의:破綻
			RETURN 1, 200
		NEXT
	ENDIF
ENDIF