;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_2732, ARG = -1, ARG:1 = -1
SIF ARG >= 0 && INRANGE(CFLAG:ARG:타겟, 1, 16) && IS_BADSTATE(POS(CFLAG:ARG:타겟), "CURSE")
	RETURN 4, 0
RETURN 0, 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2732, ARG, ARG:1, ARG:2
CALL ATTACK_TARGET, ARG, POS(ARG:1), 2732

