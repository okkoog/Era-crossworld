;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_2731, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
SIF !IS_BADSTATE(ARG:1, "CURSE")
	RETURN 0
CALL SKILLGAGE_D_SET, ARG, 2731, 1

;====================================================
;トリガー発動条件
;思ったような条件にしようとするとコツがいるので追撃スキルを作りたい場合は
;一度資料フォルダ内の「追撃カウンタースキル解説」に目を通すことを推奨します
;====================================================
@SKILL_TRIGGER_ACTIONABLE_2731,ARG,ARG:1
;自分以外ならNG
SIF FLAG:행동순1 != ARG
	RETURN 0
;ヒットフラグが立っていないとだめ
SIF !SKILLGAGE_D_GET(ARG, 2731)
	RETURN 0
;一回しか発動しない
SIF TFLAG:스킬트리거용1
	RETURN 0
TFLAG:스킬트리거용1 = 1
RETURN 1, CFLAG:ARG:PT플래그 ? 19 # 22

;====================================================
;スキルの貫通強度
;1 - 耐性(1~99%)を100%にする。2022年10月時点では存在しない
;2 - 1に加えて、無効に対応する。eratenの貫通はデフォルトではこれ
;3 - 2に加えて、吸収に対応する。本家のデフォルトはこれだけど最近は反射もいれてんのが多い。
;4 - 3に加えて、反射に対応する。最近の本家の流行り。わかりやすい。
;====================================================
@SKILL_PENETRATION_RANK_2731, ARG = -1, ARG:1 = -1
SIF ARG >= 0 && INRANGE(CFLAG:ARG:타겟, 1, 16) && IS_BADSTATE(POS(CFLAG:ARG:타겟), "CURSE")
	RETURN 4, 0
RETURN 0, 0

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2731, ARG, ARG:1, ARG:2
IF FLAG:총공격중
	CALL HEAL_FIELD, ARG, ARG:1, 2731
ELSE
	CALL ATTACK_FIELD, ARG, ARG:1, 2731
ENDIF
