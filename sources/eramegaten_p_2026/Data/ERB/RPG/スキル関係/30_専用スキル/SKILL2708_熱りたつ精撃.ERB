
;スキル名
@SKILL_NAME_2708,ARG
;#LOCALSSIZE 1
;#LOCALSIZE 9
;#DIM LCOUNT,2
;#DIM L_T

IF FLAG:행동순1 > -1 && FLAG:행동순1 == ARG && INRANGE(CFLAG:ARG:타겟, 1, 16) && POS(CFLAG:ARG:타겟) >= 0
	CFLAG:ARG:분노약점부여 = 0
	SETBIT CFLAG:ARG:분노약점부여, GET_TYPE_NUM("지변")
	SETBIT CFLAG:ARG:분노약점부여, GET_TYPE_NUM("수격")
	SETBIT CFLAG:ARG:분노약점부여, GET_TYPE_NUM("질풍")
	CALL BTL_CALC_AISYOU, ARG, POS(CFLAG:ARG:타겟), 2708
	;適用された属性は弱点付与から外れる
	CLEARBIT CFLAG:ARG:분노약점부여, RESULT:1
	SELECTCASE GET_TYPE(RESULT:1)
		CASE "지변"
			RESULTS = 분노의토사
		CASE "수격"	
			RESULTS = 분노의호우
		CASE "질풍"
			RESULTS = 분노의선풍
	ENDSELECT
ELSE
	RESULTS = 분노의정격
ENDIF

;　명중
@SKILL_HITRATE_2708, ARG
RETURN 100

;　威力
@SKILL_POWER_2708, ARG
RETURN 600

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2708,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2708,ARG
RETURN 1

