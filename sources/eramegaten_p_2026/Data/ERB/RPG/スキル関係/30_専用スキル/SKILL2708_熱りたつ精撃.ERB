;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2708, ARG, ARG:1, ARG:2
#LOCALSSIZE 1
#LOCALSIZE 1

LOCAL = POS(ARG:1)
CALL ATTACK_SINGLE,ARG,LOCAL,2708

CALL SYNC_STATUS(ARG)
FOR LOCAL, 0, 17
	SIF GETBIT(CFLAG:ARG:분노약점부여,LOCAL)
		PRINTFORML %CALLNAME:ARG%의 %조사처리(GET_TYPE(LOCAL),"가")% 약점으로 변화했다
NEXT
WAIT

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2708, ARG
PRINTL 지변、수젹、질풍 중、상대에게 가장 유리한 상성으로 １체 공격한다
PRINTL 속성에 따라 이름이 변하고、내성이 변한다


