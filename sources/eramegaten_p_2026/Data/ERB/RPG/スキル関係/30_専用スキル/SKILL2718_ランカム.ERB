;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2718, ARG, ARG:1, ARG:2

IF SKILLGAGE_D_GET(ARG,2718) < 1
	CALL SKILLGAGE_H_SET,ARG,2718,1
ELSE
	CALL SKILLGAGE_H_ADD,ARG,2718,1
ENDIF

CALL SKILLGAGE_D_SET,ARG,2718,2

IF SKILLGAGE_H_GET(ARG,2718) == 1
	PRINTW ＞온　알파…
ELSEIF SKILLGAGE_H_GET(ARG,2718) == 2
	PRINTW ＞온　알파　에토　오메가…
ELSEIF SKILLGAGE_H_GET(ARG,2718) == 3
	PRINTL ＞온　알파　에토　오메가　이오토！
	CALL ATTACK_FIELD,ARG,ARG:1,2718
	
	CALL SKILLGAGE_H_SET,ARG,2718,0
	CALL SKILLGAGE_D_SET,ARG,2718,0
ENDIF

;====================================================
;戦闘中スキルゲージの可視化
;====================================================
@DISPLAY_COMMAND_P_2718,ARG
SIF SKILLGAGE_H_GET(ARG,2718) == 0
	RETURN 0
RESULTS '= SET_COLOR_TAG(@"란캄　영창{SKILLGAGE_H_GET(ARG,2718)}턴",  "DARK-PINK")
RETURN 4
