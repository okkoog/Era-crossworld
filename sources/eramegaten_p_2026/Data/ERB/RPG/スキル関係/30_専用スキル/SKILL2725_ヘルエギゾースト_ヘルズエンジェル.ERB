;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_2725,ARG
RESULTS = 헬에기조스트

;　명중
@SKILL_HITRATE_2725, ARG
RETURN 85

;　威力
@SKILL_POWER_2725, ARG
RETURN 140

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2725,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2725,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2725, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2725,ARG
RETURN 32

;　相性
@SKILL_TYPE_2725,ARG
RETURN GET_TYPE_NUM("충격")
;충격

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2725
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2725, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2725, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2725,ARG
RETURN 2

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2725,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2725, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2725
RETURN GET_SUCCESSION_NUM("충격")
;충격

@継承不能_2725
RETURN 1

;속도보정
@SKILL_SPEED_2725, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2725
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2725, ARG = -1
RETURN 15

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2725, ARG, ARG:1, ARG:2
CALL ATTACK_SKILL, ARG,ARG:1,2725

;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_2725, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_能力上昇解除, ARG, ARG:1, "短縮"


