;ミノタウロス用
;高クリティカル・低命中で概ね敵として戦うときにミスを出してもらうのがお仕事

;スキル名
@SKILL_NAME_2755,ARG
RESULTS = 라비리스연격

;　명중
@SKILL_HITRATE_2755, ARG
RETURN 70

;　威力
@SKILL_POWER_2755, ARG
RETURN 120

;クリティカル率
@SKILL_CRITICAL_RATE_2755, ARG
RETURN 15

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2755,ARG
RETURN 3

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2755,ARG
RETURN 3

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2755, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")

;　コストの量
@SKILL_COST_2755,ARG
RETURN 15

;　相性
@SKILL_TYPE_2755,ARG
RETURN GET_TYPE_NUM("검격")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2755
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2755, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2755, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2755,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2755,ARG
RETURN GET_SPHERE_NUM("일렬")

;スキルがランダム範囲かどうか
@SKILL_RAND_TARGET_2755,ARG
RETURN 1

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2755, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")

;계승타입
@SKILL_SUCCESSION_TYPE_2755
RETURN GET_SUCCESSION_NUM("검격")

@継承不能_2755
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_2755, ARG = -1
RETURN 8

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2755, ARG, ARG:1, ARG:2
CALL ATTACK_RAND,ARG,ARG:1,2755

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2755, ARG
PRINTL 적 전열을 검격 상성으로 랜덤으로 ３회 공격。
PRINTL 크리티컬률이 매우 높고、명중률이 낮다。
PRINTL 라브리스를 사용한 삼연격。미노타우로스의 필살기。

;継承に必要な部位
@継承部位_2755,ARG
RESULTS = 무기
RETURN 1

;使用条件
@SKILL_SPECIAL_ACTIONABLE_2755,ARG
RETURN 1
;とくにない

