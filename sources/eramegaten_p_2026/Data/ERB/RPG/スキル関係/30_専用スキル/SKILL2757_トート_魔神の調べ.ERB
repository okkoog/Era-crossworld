;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_2757, ARG, ARG:1, ARG:2
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CNT
#DIMS DYNAMIC TYPE_TABLE = "화염", "빙결", "전격", "충격", "파마", "주살"
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SHUFFLE_ARRAY_STR, TYPE_TABLE
FOR LCOUNT, 0, VARSIZE("TYPE_TABLE")
	;もともとの耐性が破壊対象にならないやつは弾く
	SIF CHECK_WEAKNESS(MAXBASE:(ARG:1):(TYPE_TABLE:LCOUNT)) >= 0
		CONTINUE
	L_CNT = 3
	IF L_CNT > CFLAG:(ARG:1):@"%TYPE_TABLE:LCOUNT%무효화횟수"*2
		L_CNT -= CFLAG:(ARG:1):@"%TYPE_TABLE:LCOUNT%무효화횟수"
		IF L_CNT >= CFLAG:(ARG:1):@"%TYPE_TABLE:LCOUNT%가드킬"
			CFLAG:(ARG:1):@"%TYPE_TABLE:LCOUNT%가드킬" = L_CNT
			TSTR:스킬메시지추가효과 += " & " + "《" + TYPE_TABLE:LCOUNT + "내성파괴" + "》"
		ENDIF
	ELSE
		CFLAG:(ARG:1):@"%TYPE_TABLE:LCOUNT%무효화횟수" = MAX(CFLAG:(ARG:1):@"%TYPE_TABLE:LCOUNT%무효화횟수" - L_CNT, 0)
		IF CFLAG:(ARG:1):@"%TYPE_TABLE:LCOUNT%무효화횟수" > 0
			TSTR:스킬메시지추가효과 += " & " + "《" + TYPE_TABLE:LCOUNT + "장벽파손" + "》"
		ELSE
			TSTR:스킬메시지추가효과 += " & " + "《" + TYPE_TABLE:LCOUNT + "장벽파괴" + "》"
		ENDIF
	ENDIF
	BREAK
NEXT

