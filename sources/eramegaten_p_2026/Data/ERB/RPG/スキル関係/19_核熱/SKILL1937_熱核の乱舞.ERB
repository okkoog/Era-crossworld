;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_1937,ARG
IF SKILL_CHANGE(ARG, [[キャラ:마리사]])
	RESULTS = 儀符「ｵｰﾚﾘｰｽﾞｻﾝ」
ELSE
	RESULTS = 열핵의난무
ENDIF

;　명중
@SKILL_HITRATE_1937, ARG
RETURN 90

;　威力
;仕様上,単体相手なら1~3回になるのでダイン相当の320
;上限HIT数に引っかからなければ単体あたりの期待値は240
;スペカの方は回数増やした分ちょっと弱体化。
@SKILL_POWER_1937, ARG
IF SKILL_CHANGE(ARG, [[キャラ:마리사]])
	RETURN 140
ELSE
	RETURN 160
ENDIF

;最低がここで渋いのは同ランクにあたるマハ系が最大5HITしかできないから
;敵総数の判定を全後列合計にできるという強みもあるので、ここで少し絞っといても総HIT数は割合稼げる…はず
;최저공격횟수
@SKILL_MINATTACKNUMBER_1937,ARG
IF SKILL_CHANGE(ARG, [[キャラ:마리사]])
	RETURN 3
ELSE
	RETURN 2
ENDIF

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1937,ARG
RETURN 8

;一体辺りの最大ＨＩＴ数
@SKILL_MAXATK_PER_1937,ARG
IF SKILL_CHANGE(ARG, [[キャラ:마리사]])
	RETURN 4
ELSE
	RETURN 3
ENDIF

;一体辺りの最低ＨＩＴ数
@SKILL_MINATK_PER_1937,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
