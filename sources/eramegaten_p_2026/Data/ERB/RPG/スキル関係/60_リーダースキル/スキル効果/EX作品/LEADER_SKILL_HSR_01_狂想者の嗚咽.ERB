;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@LEADER_SKILL_CONTROL_NO_HSR_1,ARG
RESULTS = 광상자의 오열

;スキル名
@SKILL_NAME_LEADER_狂想者の嗚咽,ARG
RESULTS = 광상가의 오열

;　 説明文の設定
@SET_VAR_LEADER_SKILL_EXPLAIN_狂想者の嗚咽, L_TEXT
#DIMS REF L_TEXT
#DIM L_CNT
L_TEXT = 파티 멤버 전체의 상태이상의 상대에게 가하는 데미지＋３０％

;重複可能な数
@LEADER_SKILL_COUNT_LIMIT_狂想者の嗚咽
RETURN 1

;====================================================
;ダメージ計算時の追加補正
;与ダメージ+30%
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_LEADER_狂想者の嗚咽, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM L_RESULT
#DIM L_DOSE

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			SIF GET_STATE(CFLAG:L_TARGET:상태이상) != "GOOD"
			RETURN 30
	ENDSELECT
ENDIF
RETURN 0