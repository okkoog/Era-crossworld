;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@LEADER_SKILL_CONTROL_NO_58,ARG
RESULTS = 액막이 부적

;スキル名
@SKILL_NAME_LEADER_厄除けの護符,ARG
RESULTS = 액막이호부

@ACTION_LEADER_厄除けの護符,ARG,ARG:1,ARG:2

;　 説明文の設定
@SET_VAR_LEADER_SKILL_EXPLAIN_厄除けの護符, L_TEXT
#DIMS REF L_TEXT
#DIM L_CNT
IF LEADER_SKILL_COUNT_ACTABLE_厄除けの護符()
	L_TEXT = 파티 멤버가 받는 즉사의 효과를 {LEADER_SKILL_COUNT_ACTABLE_厄除けの護符()}회 까지 무효화한다。
ELSE
	L_TEXT = 일정 횟수、파티 멤버가 받는 즉사의 효과를 무효화한다。
ENDIF

;重複可能な数
@LEADER_SKILL_COUNT_LIMIT_厄除けの護符
RETURN 6

;効果量
@LEADER_SKILL_COUNT_ACTABLE_厄除けの護符, ARG
#FUNCTION
#DIM L_CNT
L_CNT = COUNT_ACTIVE_LEADER_SKILL("厄除けの護符", ARG)
SIF L_CNT == 0
	RETURNF 0
RETURNF L_CNT * 3 / 2 + 2