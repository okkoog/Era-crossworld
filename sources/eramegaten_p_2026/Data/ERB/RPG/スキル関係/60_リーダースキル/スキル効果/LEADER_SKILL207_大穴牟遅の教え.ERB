;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@LEADER_SKILL_CONTROL_NO_207,ARG
RESULTS = 오오나무지의 가르침

;スキル名
@SKILL_NAME_LEADER_大穴牟遅の教え,ARG
RESULTS = 오오나무치의 가르침

;　 説明文の設定
@SET_VAR_LEADER_SKILL_EXPLAIN_大穴牟遅の教え, L_TEXT
#DIMS REF L_TEXT
L_TEXT = 자신과 자신 이외의【토요아시하라】가 액티브일 때、아군 전체의 회복・변화・방어 스킬의 소비 ＭＰ가 감소한다

;重複可能な数
@LEADER_SKILL_COUNT_LIMIT_大穴牟遅の教え
RETURN 6

;効果付与の場合の付与者がL_CHARA:1となる
@SKILL_COST_CHANGE_LEADER_大穴牟遅の教え, L_CHARA, L_SKILL, L_CHARA:1
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA, 2
#DIM DYNAMIC L_SKILL
CALL GET_SKILL_PROP, "SKILL_COSTTYPE", L_SKILL, L_CHARA
SIF GET_SKILL_COST_TYPE(RESULT) != "MP"
	RETURN 0
CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILL, L_CHARA
SIF !GROUPMATCH(GET_SUCCESSION(RESULT), "회복", "지원", "방어")
	RETURN 0
FOR LCOUNT, GET_POS_MIN(CFLAG:L_CHARA:PT플래그 ? 19 # 22), GET_POS_MAX(CFLAG:L_CHARA:PT플래그 ? 19 # 22) + 1
	SIF POS(LCOUNT) < 0
		CONTINUE
	SIF POS(LCOUNT) == L_CHARA:1
		CONTINUE
	SIF CSTR:POS(LCOUNT):상성그룹 != "豊葦原"
		CONTINUE
	RETURN -20
NEXT
RETURN 0