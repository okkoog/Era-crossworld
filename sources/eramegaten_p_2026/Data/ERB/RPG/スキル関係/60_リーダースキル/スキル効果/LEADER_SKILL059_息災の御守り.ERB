;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@LEADER_SKILL_CONTROL_NO_59,ARG
RESULTS = 무병장수 부적

;スキル名
@SKILL_NAME_LEADER_息災の御守り,ARG
RESULTS = 식재의부적

@ACTION_LEADER_息災の御守り,ARG,ARG:1,ARG:2

;　 説明文の設定
@SET_VAR_LEADER_SKILL_EXPLAIN_息災の御守り, L_TEXT
#DIMS REF L_TEXT
#DIM L_CNT
IF LEADER_SKILL_COUNT_ACTABLE_息災の御守り()
	L_TEXT = 파티 멤버에 대한 배드스테이터스의 부착을 {LEADER_SKILL_COUNT_ACTABLE_息災の御守り()}회 까지 무효화한다。
ELSE
	L_TEXT = 일정 횟수、파티 멤버에 대한 배드스테이터스의 부착을 무효화한다。
ENDIF

;重複可能な数
@LEADER_SKILL_COUNT_LIMIT_息災の御守り
RETURN 6

;効果量
@LEADER_SKILL_COUNT_ACTABLE_息災の御守り, ARG
#FUNCTION
#DIM L_CNT
L_CNT = COUNT_ACTIVE_LEADER_SKILL("息災の御守り", ARG)
SIF L_CNT == 0
	RETURNF 0
RETURNF L_CNT * 3 / 2 + 2