;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@LEADER_SKILL_CONTROL_NO_51,ARG
RESULTS = 체인 업

;スキル名
@SKILL_NAME_LEADER_チェーンアップ,ARG
RESULTS = 체인업

;　 説明文の設定
@SET_VAR_LEADER_SKILL_EXPLAIN_チェーンアップ, L_TEXT
#DIMS REF L_TEXT
#DIM L_CNT
IF COUNT_ACTIVE_LEADER_SKILL("チェーンアップ")
	L_TEXT = 아군의 기합의 효과가 {GET_POWER_チェーンアップ()}\% UP한다。
ELSE
	L_TEXT = 아군의 기합의 효과가 15\% UP한다。
ENDIF
;重複可能な数
@LEADER_SKILL_COUNT_LIMIT_チェーンアップ
RETURN 6

@GET_POWER_チェーンアップ, ARG = -1
#FUNCTION
RESULT_F = TOINT(AUTO_SPLIT("0/5/7/9/11/13/15", "/", MIN(COUNT_ACTIVE_LEADER_SKILL("チェーンアップ", ARG),6)))
RETURNF TOINT(AUTO_SPLIT("0/15/25/35/40/45/50", "/", MIN(COUNT_ACTIVE_LEADER_SKILL("チェーンアップ", ARG),6)))
