;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@LEADER_SKILL_CONTROL_NO_52,ARG
RESULTS = 도트 사이트

;スキル名
@SKILL_NAME_LEADER_ダットサイト,ARG
RESULTS = 도트사이트

;　 説明文の設定
@SET_VAR_LEADER_SKILL_EXPLAIN_ダットサイト, L_TEXT
#DIMS REF L_TEXT
#DIM L_CNT
IF COUNT_ACTIVE_LEADER_SKILL("ダットサイト")
	L_TEXT = 아군의 집중의 효과가 {GET_POWER_ダットサイト()}\% UP한다。
ELSE
	L_TEXT = 아군의 집중의 효과가 15\% UP한다。
ENDIF
;重複可能な数
@LEADER_SKILL_COUNT_LIMIT_ダットサイト
RETURN 6

@GET_POWER_ダットサイト, ARG = -1
#FUNCTION
RESULT_F = TOINT(AUTO_SPLIT("0/5/7/9/11/13/15", "/", MIN(COUNT_ACTIVE_LEADER_SKILL("ダットサイト", ARG),6)))
RETURNF TOINT(AUTO_SPLIT("0/15/25/35/40/45/50", "/", MIN(COUNT_ACTIVE_LEADER_SKILL("ダットサイト", ARG),6)))
