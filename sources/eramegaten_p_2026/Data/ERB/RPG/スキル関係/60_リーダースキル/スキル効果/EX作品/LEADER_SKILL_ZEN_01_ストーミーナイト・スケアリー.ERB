;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@LEADER_SKILL_CONTROL_NO_ZEN_1,ARG
RESULTS = 스토미 나이트 스케어리

;スキル名
@SKILL_NAME_LEADER_ストーミーナイト・スケアリー,ARG
RESULTS = 뇌우가 내리는 밤의 공포

;　 説明文の設定
@SET_VAR_LEADER_SKILL_EXPLAIN_ストーミーナイト・スケアリー, L_TEXT
#DIMS REF L_TEXT
L_TEXT = 

;重複可能な数
@LEADER_SKILL_COUNT_LIMIT_ストーミーナイト・スケアリー
RETURN 1

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_LEADER_ストーミーナイト・スケアリー, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			IF L_相性名 == "전격"
				RETURN 10
			ELSE
				RETURN 0
			ENDIF
	ENDSELECT
;自分が防御側
ELSE
	SELECTCASE ARGS
	ENDSELECT
ENDIF
RETURN 0