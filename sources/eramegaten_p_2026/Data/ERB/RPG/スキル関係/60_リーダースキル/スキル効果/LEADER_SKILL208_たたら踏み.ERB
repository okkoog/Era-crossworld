;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@LEADER_SKILL_CONTROL_NO_208,ARG
RESULTS = 풀무 밟기

;スキル名
@SKILL_NAME_LEADER_たたら踏み,ARG
RESULTS = 타타라 밟기

;　 説明文の設定
@SET_VAR_LEADER_SKILL_EXPLAIN_たたら踏み, L_TEXT
#DIMS REF L_TEXT
L_TEXT = 전투 중 액티브 상태인 동안、노려질 확률 상승 효과가 붙은 아군이 받는 데미지가 감소한다。

;重複可能な数
@LEADER_SKILL_COUNT_LIMIT_たたら踏み
RETURN 1

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_LEADER_たたら踏み, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
;自分が防御側
ELSE
	SELECTCASE ARGS
		;他のものと加算されずに全体に乗算で処理される。(-20ならダメージ0.8倍、+20なら1.2倍)
		CASE "ダメージ倍率"
			SIF CFLAG:L_TARGET:피타겟비율변동지속턴수 > 0 && CFLAG:L_TARGET:변동피타겟율 > 100
				RETURN -25
	ENDSELECT
ENDIF
RETURN 0