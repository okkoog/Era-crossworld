;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@LEADER_SKILL_CONTROL_NO_NGO_1,ARG
RESULTS = 超天使

;スキル名
@SKILL_NAME_LEADER_超天使,ARG
RESULTS = 초천사

;　 説明文の設定
@SET_VAR_LEADER_SKILL_EXPLAIN_超天使, L_TEXT
#DIMS REF L_TEXT
#DIM L_CNT
L_TEXT = 파티 멤버 전체의 주는 데미지와 받는 데미지를 증감시킨다

;重複可能な数
@LEADER_SKILL_COUNT_LIMIT_超天使
RETURN 1

@SKILL_BATTLE_MAIN_TOOLTIP_LEADER_超天使, ARG, ARG:1
#DIM DYNAMIC GIVE_EFFECT_CHARA
GIVE_EFFECT_CHARA = TRYSKILL_VAR
VARSET RESULTS, "", 0, 4
RESULTS:1 '= "　주는 데미지:" + \@GET_STRENGTH_LEADER_超天使(ARG, "ダメージ補正加算", GIVE_EFFECT_CHARA) >= 0 ? ＋ # \@+ TOFULL(TOSTR(GET_STRENGTH_LEADER_超天使(ARG, "ダメージ補正加算", GIVE_EFFECT_CHARA))) + "％"
SIF GET_STRENGTH_LEADER_超天使(ARG, "크리티컬보정", GIVE_EFFECT_CHARA)
	RESULTS:2 '= "　크리티컬 　:" + \@GET_STRENGTH_LEADER_超天使(ARG, "크리티컬보정", GIVE_EFFECT_CHARA) > 0 ? ＋ # \@+ TOFULL(TOSTR(GET_STRENGTH_LEADER_超天使(ARG, "크리티컬보정", GIVE_EFFECT_CHARA))) + "％"
SIF GET_STRENGTH_LEADER_超天使(ARG, "被クリティカル補正", GIVE_EFFECT_CHARA)
	RESULTS:3 '= "　피 크리티컬:" + \@GET_STRENGTH_LEADER_超天使(ARG, "被クリティカル補正", GIVE_EFFECT_CHARA) > 0 ? ＋ # \@+ TOFULL(TOSTR(GET_STRENGTH_LEADER_超天使(ARG, "被クリティカル補正", GIVE_EFFECT_CHARA))) + "％"
RESULTS = □超天使

;====================================================
;ダメージ計算時の追加補正
;クリティカルダメージ+10%　セット数が増える場合5%づつ強化される
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_LEADER_超天使, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM L_RESULT
#DIM L_DOSE
RESULTS '= ""
IF L_P == L_ACTOR
	SELECTCASE ARGS
		CASE "ダメージ補正加算"
			RETURN GET_STRENGTH_LEADER_超天使(L_P, "ダメージ補正加算", GIVE_EFFECT_CHARA)
		;50% ~ 250%
		CASE "クリティカル補正A"
			RETURN GET_STRENGTH_LEADER_超天使(L_P, "크리티컬보정", GIVE_EFFECT_CHARA)
	ENDSELECT
ELSE
	SELECTCASE ARGS
		;100% ~ 200%
		CASE "クリティカル補正A"
			RETURN GET_STRENGTH_LEADER_超天使(L_P, "被クリティカル補正", GIVE_EFFECT_CHARA)
	ENDSELECT
ENDIF
RETURN 0

@GET_STRENGTH_LEADER_超天使, L_P, L_PROP, GIVE_EFFECT_CHARA
#FUNCTION
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC GIVE_EFFECT_CHARA
#DIM DYNAMIC L_P
#DIMS DYNAMIC L_PROP
#DIM DYNAMIC L_DOSE
L_DOSE = GET_RPG_CFLAG_DUNGEON(GIVE_EFFECT_CHARA, "스트레스치") / 100
SIF L_DOSE == 0
	RETURNF 0
;主人や所持者でなく、陥落対象が効果所持者と同じで、信頼陥落でなくかつ陥落深度が効果所持者と同等以上は与えるダメージが気持ち下がる。やみ値の1/10（実数値1000分の1）
;つまり、同担で自分がマウント取れる陥落深度じゃない相手に威圧をかける。なんてやつだ
IF L_P != MASTER && L_P != GIVE_EFFECT_CHARA && CFLAG:L_P:함락캐릭터 == CFLAG:GIVE_EFFECT_CHARA:함락캐릭터 && (陥落(L_P) && RESULTS != "신뢰") && 陥落(L_P) >= 陥落(GIVE_EFFECT_CHARA) && GET_RPG_CFLAG_TAKEOVER(GIVE_EFFECT_CHARA, "てんちゃん強化１") == 0
	IF L_PROP == "ダメージ補正加算"
		RETURNF 0 - L_DOSE / 10
	ELSE
		RETURNF 0
	ENDIF
ELSE
	SELECTCASE L_PROP
		CASE "ダメージ補正加算"
			;0～49　-6～12
			IF L_DOSE < 50
				RETURNF MIN(L_DOSE - 25, 50) / 4
			;50～75　17～25
			ELSEIF L_DOSE  < 75
				RETURNF MIN(L_DOSE , 75) / 3
			;75～90　37～45
			ELSEIF L_DOSE  < 90
				RETURNF MIN(L_DOSE , 90) / 2
			;90～99　90～99
			ELSEIF L_DOSE  < 100
				RETURNF MIN(L_DOSE , 100)
			ENDIF
		CASE "크리티컬보정"
			RETURNF (L_DOSE - 25) * 2
		CASE "被クリティカル補正"
			RETURNF L_DOSE
	ENDSELECT
ENDIF