;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@LEADER_SKILL_CONTROL_NO_209,ARG
RESULTS = 타르타로스의 옥지기

;スキル名
@SKILL_NAME_LEADER_タルタロスの牢番,ARG
RESULTS = 타르타로스의 감옥지기

;　 説明文の設定
@SET_VAR_LEADER_SKILL_EXPLAIN_タルタロスの牢番, L_TEXT
#DIMS REF L_TEXT
L_TEXT = 전투 중 액티브 상태인 동안、아군 전체를 대상으로 하는 공격으로부터 받는 데미지가 감소한다。

;重複可能な数
@LEADER_SKILL_COUNT_LIMIT_タルタロスの牢番
RETURN 1

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_LEADER_タルタロスの牢番, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
;自分が防御側
ELSE
	SELECTCASE ARGS
		;他のものと加算されずに全体に乗算で処理される。(-20ならダメージ0.8倍、+20なら1.2倍)
		CASE "ダメージ倍率"
			CALL GET_SKILL_PROP, "SKILL_SPHERE", CFLAG:L_ACTOR:입력행동, L_ACTOR
			SIF RESULT != 3
				RETURN 0
			CALL GET_SKILL_PROP, "SKILL_RAND_TARGET", CFLAG:L_ACTOR:입력행동, L_ACTOR
			SIF RESULT > 0
				RETURN 0
			RETURN -20
	ENDSELECT
ENDIF
RETURN 0