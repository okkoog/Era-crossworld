;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@LEADER_SKILL_CONTROL_NO_8,ARG
RESULTS = 리커버리
;スキル名
@SKILL_NAME_LEADER_リカバリー,ARG
RESULTS = 리커버리

;　 説明文の設定
@SET_VAR_LEADER_SKILL_EXPLAIN_リカバリー, L_TEXT
#DIMS REF L_TEXT
L_TEXT = 턴 종료시에 일정확률로 ＣＯＭＰ 내의 동료마의 ＨＰ를 회복한다。

;重複可能な数
@LEADER_SKILL_COUNT_LIMIT_リカバリー
RETURN 6

;ターン終了時に行う処理
@SKILL_TURNEND_LEADER_リカバリー,ARG,ARG:1
#DIM LCOUNT, 2
#DIM L_CHARA
#DIM L_CNT_SKILL
#DIM SHOWED_MES
SHOWED_MES = 0
;25% ~ 100%
SIF (10 + COUNT_ACTIVE_LEADER_SKILL("リカバリー")) * 15 < RAND:100
	RETURN 0
FOR L_CHARA, 0, CHARANUM
	;場に出てるキャラは省く
	IF CPOS(L_CHARA)
		;Aion式サマナーはリンク先が効果を受けられるなら効果を受ける
		IF GETS_ROLE_PROP("CAN_USE_SPECIAL_SKILL", L_CHARA) == "Aion式サマナー"
			SIF CFLAG:L_CHARA:링크캐릭터실제가입시간0 <= 0
				CONTINUE
			SIF !IS_COMP内効果有効(FINDCHARA_LINK(L_CHARA))
				CONTINUE
		ELSE
			CONTINUE
		ENDIF
	ENDIF
	SIF !IS_COMP内効果有効(L_CHARA)
		CONTINUE
	SIF IS_BADSTATE(L_CHARA, "DYING")
		CONTINUE
	SIF BASE:L_CHARA:ＨＰ >= MAXBASE:L_CHARA:ＨＰ
		CONTINUE
	IF !SHOWED_MES
		SETCOLOR COLOR("FRIEND")
		PRINTFORML ┏━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃　　　　　　　　　 리커버리 　　　　　　　　　┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━┛
		;PRINTFORM ┃         ﾘｶﾊﾞﾘｰ         ┃
		SHOWED_MES = 1
		RESETCOLOR
	ENDIF
	CSTR:(ARG:1):비소지스킬 = LSリカバリー
	CALL HEAL_SINGLE, ARG:1, L_CHARA, [[스킬:비소지스킬]], 1
NEXT
SIF SHOWED_MES
	WAIT

;同種のスキルが複数あっても一回しか発動しない
@SKILL_TURNEND_ONCE_LEADER_リカバリー
RETURN 1

