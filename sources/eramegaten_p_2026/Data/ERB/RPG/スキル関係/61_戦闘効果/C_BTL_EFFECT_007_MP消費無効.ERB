;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@C_BTL_EFFECT_CONTROL_NO_7,ARG
RESULTS = MP消費無効

;スキル名
@SKILL_NAME_C_BTL_EFFECT_MP消費無効,ARG
RESULTS = MP소비 무효

;重複可能な数
@C_BTL_EFFECT_COUNT_LIMIT_MP消費無効
RETURN 1

;効果時間　最大10ターンまで、0を指定した場合は戦闘中永続
@C_BTL_EFFECT_CONTINUE_TIME_MP消費無効
RETURN 1

;排他となる効果
;戻り値
; RESULTS = 効果名
; RESULT
; 0 = 排他
;-1 = 上書き不能
; 1 = 上書き(対象も1なら相互上書き)
@C_BTL_EFFECT_EXCLUSIVE_MP消費無効
RESULTS = MP消費半減
RETURN 1

;個別の対象条件
;ARG 	効果を受けるキャラの登録番号
;ARG:1	効果を与えるキャラの登録番号
@C_BTL_EFFECT_SPECIAL_TARGET_MP消費無効, ARG, ARG:1
RETURN 1

;ARG = キャラ登録番号
;ARG:1 = 使用スキル番号
;ARG:2 = 効果付与の場合の付与者
@SKILL_COST_CHANGE_C_BTL_EFFECT_MP消費無効, ARG, ARG:1, ARG:2
CALL GET_SKILL_PROP, "SKILL_COSTTYPE", ARG:1
SIF GET_SKILL_COST_TYPE(RESULT) == "MP"
	RETURN -100