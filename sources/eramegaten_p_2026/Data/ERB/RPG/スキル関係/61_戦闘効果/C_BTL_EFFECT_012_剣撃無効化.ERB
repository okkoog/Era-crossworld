;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@C_BTL_EFFECT_CONTROL_NO_12,ARG
RESULTS = 剣撃無効化

;スキル名
@SKILL_NAME_C_BTL_EFFECT_剣撃無効化,ARG
RESULTS = 검격무효화

;重複可能な数
@C_BTL_EFFECT_COUNT_LIMIT_剣撃無効化
RETURN 1

;効果時間　最大10ターンまで、0を指定した場合は戦闘中永続
@C_BTL_EFFECT_CONTINUE_TIME_剣撃無効化
RETURN 1

;排他となる効果
;戻り値
; RESULTS = 効果名
; RESULT
; 0 = 排他
;-1 = 上書き不能
; 1 = 上書き(対象も1なら相互上書き)
@C_BTL_EFFECT_EXCLUSIVE_剣撃無効化
RESULTS = 
RETURN 0

;個別の対象条件
;ARG 	効果を受けるキャラの登録番号
;ARG:1	効果を与えるキャラの登録番号
@C_BTL_EFFECT_SPECIAL_TARGET_剣撃無効化, ARG, ARG:1
SIF IS_BADSTATE(ARG, "DYING")
	RETURN 0
RETURN 1


;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_C_BTL_EFFECT_剣撃無効化, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	CASE "相性"
		SELECTCASE ARGS:1
			CASE "검격"
				RETURN 1, 0
		ENDSELECT
ENDSELECT
