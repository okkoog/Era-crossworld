;個別の対象条件
;ARG 	効果を受けるキャラの登録番号
;ARG:1	効果を与えるキャラの登録番号
@C_BTL_EFFECT_SPECIAL_TARGET_偽りの守り, ARG, ARG:1
SIF IS_BADSTATE(ARG, "DYING")
	RETURN 0
RETURN 1

;====================================================
;ステータス計算時の追加補正
;
;ARGS:0		= 大項目(基本ステータス/相性/ステートなど)
;ARGS:1		= 小項目(力・速さ/화염/SLEEPなど)
;ARG		= スキルの持ち主
;ARG:1		= 特殊な引値
;
;@STATUS_SYNCを通過しないと効果が反映されないことに注意。
;スキルを使っている間だけ変化のような処理をする場合は、変化と同時にCALL SYNC_STATUSを実行させること
;====================================================
@SKILL_ADD_STATUS_C_BTL_EFFECT_偽りの守り, ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM SKILL_NUM;スキル番号(専用技用)
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
SELECTCASE ARGS
	;ステート耐性は0のときに通常(100%)のに注意。
	CASE "상태이상"
		SIF GROUPMATCH(ARGS:1, "FLY", "DYING", "ORGY", "HEAT")
			RETURN 0
		RETURN -100
ENDSELECT
RETURN 0

;====================================================
;ダメージ計算時の追加補正
;クリティカルダメージ+10%　セット数が増える場合5%づつ強化される
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_C_BTL_EFFECT_偽りの守り, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
ELSE
	SELECTCASE ARGS
		;気合などと加算の枠。他に下限要素がなければ100%±X%になる
		CASE "ダメージ補正加算"
			RETURN 25
		CASE "クリティカル補正A"
			RETURN 100
	ENDSELECT
ENDIF
RETURN 0

