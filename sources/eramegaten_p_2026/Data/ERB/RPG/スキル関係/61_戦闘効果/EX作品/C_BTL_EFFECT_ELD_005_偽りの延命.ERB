;ARG:1	効果を与えるキャラの登録番号
@C_BTL_EFFECT_SPECIAL_TARGET_偽りの延命, ARG, ARG:1
SIF IS_BADSTATE(ARG, "DYING")
	RETURN 0
RETURN 1

@SKILL_TURNEND_C_BTL_EFFECT_偽りの延命, ARG, ARG:1
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CNT
#DIM DYNAMIC STOCK_HP
;場にでて健在じゃないとだめ
SIF !IS_TARGET_ABLE(ARG)
	RETURN 0
;HPが全快なら終わる
SIF 現HP割合(ARG) >= 100
	RETURN 0
CALL PRINT_ACT_MESSAGE, ARG, , , , "거짓된 연명"
CSTR:(ARG:1):비소지스킬 '= "C_BTL_EFFECT_偽りの延命"
STOCK_HP = 現HP割合(ARG)
CALL HEAL_SINGLE, ARG:1, ARG, [[스킬:비소지스킬]]
L_CNT = (現HP割合(ARG) - STOCK_HP) / 10 + 1
CSTR:(ARG:1):비소지스킬 '= ""
FOR LCOUNT, 0, L_CNT
	CALL SKILL_SET_カジャンダ, ARG, ARG, BASE_KAJA_TABLE:(RAND:VARSIZE("BASE_KAJA_TABLE")), -4, "단체", "NOWAIT"
NEXT
WAIT

