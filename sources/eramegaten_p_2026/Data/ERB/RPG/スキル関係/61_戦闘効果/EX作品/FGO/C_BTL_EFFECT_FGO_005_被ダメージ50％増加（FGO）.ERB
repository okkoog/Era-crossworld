;リスト生成やデータ抽出のみに使う
@C_BTL_EFFECT_CONTROL_NO_FGO_5,ARG
RESULTS = 피데미지 50% 증가 (FGO)

;スキル名
@SKILL_NAME_C_BTL_EFFECT_被ダメージ50％増加（FGO）,ARG
RESULTS = 피 데미지 50％ 증가

;重複可能な数
@C_BTL_EFFECT_COUNT_LIMIT_被ダメージ50％増加（FGO）
RETURN 10

;効果時間　最大10ターンまで、0を指定した場合は戦闘中永続
@C_BTL_EFFECT_CONTINUE_TIME_被ダメージ50％増加（FGO）
RETURN 5

;排他となる効果
;戻り値
; RESULTS = 効果名
; RESULT
; 0 = 排他
;-1 = 上書き不能
; 1 = 上書き(対象も1なら相互上書き)
@C_BTL_EFFECT_EXCLUSIVE_被ダメージ50％増加（FGO）
RESULTS = 
RETURN 0

;個別の対象条件
;ARG 	効果を受けるキャラの登録番号
;ARG:1	効果を与えるキャラの登録番号
@C_BTL_EFFECT_SPECIAL_TARGET_被ダメージ50％増加（FGO）, ARG, ARG:1
SIF IS_BADSTATE(ARG, "DYING")
	RETURN 0
RETURN 1

;====================================================
;ダメージ計算時の追加補正
;クリティカルダメージ+10%　セット数が増える場合5%づつ強化される
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_C_BTL_EFFECT_被ダメージ50％増加（FGO）, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;対象が防衛側じゃない or 発生中の処理が被ダメージ以外だと0を返す
SIF L_P != L_TARGET || ARGS != "ダメージ倍率"
	RETURN 0
;付与されたキャラの被ダメージが10%上昇する
RETURN 50
