;管理用のグループ定義関数です
;基本的にはWIKI内容やデバッグ用のデータ取得にしかつかわないのでまぁ適当に
@GET_C_BTL_EFFECT_EX_GROUP, ARG = -1, ARGS
#FUNCTIONS
#DIMS L_LIST, 50
#DIM DYNAMIC LCOUNT
IF L_LIST:0 == ""
	L_LIST:(LCOUNT++) '= "EX"
	L_LIST:(LCOUNT++) '= "AK"
	L_LIST:(LCOUNT++) '= "BA"
	L_LIST:(LCOUNT++) '= "DR"
	L_LIST:(LCOUNT++) '= "ELD"
	L_LIST:(LCOUNT++) '= "ER"
	L_LIST:(LCOUNT++) '= "FGO"
	L_LIST:(LCOUNT++) '= "KE"
	L_LIST:(LCOUNT++) '= "SQ"
	L_LIST:(LCOUNT++) '= "ZEN"
	L_LIST:(LCOUNT++) '= "星をみるひと"
ENDIF
IF ARG >= 0
	RETURNF L_LIST:ARG
ELSE
	SIF ARGS == ""
		THROW 引き数の指定ミス
	RETURNF TOSTR(FINDELEMENT(L_LIST, ARGS, , , 1))
ENDIF

@GET_C_BTL_EFFECT_EX_GROUP_NUM, ARGS
#FUNCTION
RETURNF TOINT(GET_C_BTL_EFFECT_EX_GROUP(-1, ARGS))