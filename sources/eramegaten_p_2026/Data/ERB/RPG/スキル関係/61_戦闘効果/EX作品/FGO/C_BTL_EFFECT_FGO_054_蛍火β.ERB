;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@C_BTL_EFFECT_CONTROL_NO_FGO_54,ARG
RESULTS = 蛍火β

;スキル名
@SKILL_NAME_C_BTL_EFFECT_蛍火β,ARG
RESULTS = １체 공격 대신 맞기 

;重複可能な数
@C_BTL_EFFECT_COUNT_LIMIT_蛍火β
RETURN 1

;効果時間　最大10ターンまで、0を指定した場合は戦闘中永続
@C_BTL_EFFECT_CONTINUE_TIME_蛍火β
RETURN 1

;排他となる効果
;戻り値
; RESULTS = 効果名
; RESULT
; 0 = 排他
;-1 = 上書き不能
; 1 = 上書き(対象も1なら相互上書き)
@C_BTL_EFFECT_EXCLUSIVE_蛍火β
RESULTS = 強化無効
RETURN -1

;個別の対象条件
;ARG 	効果を受けるキャラの登録番号
;ARG:1	効果を与えるキャラの登録番号
@C_BTL_EFFECT_SPECIAL_TARGET_蛍火β, ARG, ARG:1
;対象がDYINGの場合は無効
SIF IS_BADSTATE(ARG, "DYING")
	RETURN 0
RETURN 1

;ターン開始時の処理
@SKILL_TURNSTART_C_BTL_EFFECT_蛍火β, ARG, GIVE_EFFECT_CHARA
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
;ターン開始時に味方全体に戦闘効果を付与する
CALL SET_C_BTL_EFFECT_FIELD, ARG, CFLAG:ARG:PT플래그 ? 19 # 22, "蛍火δ",1,"","","NOPRINT"


;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_C_BTL_EFFECT_蛍火β, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す
#DIM LCOUNT

;対象が防御側じゃない or 発生中の処理が追加回避強化以外だと0を返す
SIF L_P != L_TARGET || ARGS != "追加回避強化"
	RETURN 0
RETURN 24