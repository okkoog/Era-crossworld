@C_BTL_EFFECT_EXCLUSIVE_ラインディバイド
RESULTS = 
RETURN 0

;個別の対象条件
;ARG 	効果を受けるキャラの登録番号
;ARG:1	効果を与えるキャラの登録番号
@C_BTL_EFFECT_SPECIAL_TARGET_ラインディバイド, ARG, ARG:1
SIF IS_BADSTATE(ARG, "DYING")
	RETURN 0
RETURN 1
;====================================================
;かばうの判定
;
;RESULT かばうキャラの登録番号、不成立の場合は-1をかえすこと
;====================================================
@SKILL_COVERING_C_BTL_EFFECT_ラインディバイド, L_TARGET, L_ATTACKER, L_COVER,  L_スキル, L_威力, L_相性, L_相性倍率, L_クリティカル率, L_吸収率, L_ダメージタイプ, L_攻撃タイプ, L_割合計算, L_割合上限
#DIM L_TARGET		;攻撃の対象となっているキャラ
#DIM L_ATTACKER		;攻撃をしている敵
#DIM L_COVER		;かばうキャラクター
#DIM L_スキル
#DIM L_威力
#DIM L_相性
#DIM L_相性倍率
#DIM L_クリティカル率
#DIM L_吸収率
#DIM L_ダメージタイプ
#DIM L_攻撃タイプ
#DIM L_割合計算
#DIM L_割合上限

RETURN L_COVER
;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_C_BTL_EFFECT_ラインディバイド, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
ELSE
	SELECTCASE ARGS
		CASE "ダメージ倍率"
			;持ち主はダメージ軽減
			SIF GIVE_EFFECT_CHARA == L_TARGET
				RETURN -30
		CASE "追加回避強化"
			;カバー時は回避不能
			SIF TFLAG:커버링 && GIVE_EFFECT_CHARA == L_TARGET
				RETURN -999
	ENDSELECT
ENDIF
RETURN 0
