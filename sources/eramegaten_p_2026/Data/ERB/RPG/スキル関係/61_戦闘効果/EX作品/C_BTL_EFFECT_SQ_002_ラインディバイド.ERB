@C_BTL_EFFECT_COUNT_LIMIT_ラインディバイド
RETURN 1

;効果時間　最大10ターンまで、0を指定した場合は戦闘中永続
@C_BTL_EFFECT_CONTINUE_TIME_ラインディバイド
