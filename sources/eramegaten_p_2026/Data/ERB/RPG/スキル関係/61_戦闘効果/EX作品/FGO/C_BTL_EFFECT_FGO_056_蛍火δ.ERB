;スキルの管理番号
;実数値としては使わずに(変数として保存しないようにするし、通常の呼出対象にはしない)
;リスト生成やデータ抽出のみに使う
@C_BTL_EFFECT_CONTROL_NO_FGO_56,ARG
RESULTS = 蛍火δ

;スキル名
@SKILL_NAME_C_BTL_EFFECT_蛍火δ,ARG
RESULTS = 수호대상

;重複可能な数
@C_BTL_EFFECT_COUNT_LIMIT_蛍火δ
RETURN 1

;効果時間　最大10ターンまで、0を指定した場合は戦闘中永続
@C_BTL_EFFECT_CONTINUE_TIME_蛍火δ
RETURN 1

;排他となる効果
;戻り値
; RESULTS = 効果名
; RESULT
; 0 = 排他
;-1 = 上書き不能
; 1 = 上書き(対象も1なら相互上書き)
@C_BTL_EFFECT_EXCLUSIVE_蛍火δ
RESULTS = 
RETURN 0

;個別の対象条件
;ARG 	効果を受けるキャラの登録番号
;ARG:1	効果を与えるキャラの登録番号
@C_BTL_EFFECT_SPECIAL_TARGET_蛍火δ, ARG, ARG:1
;対象がDYINGの場合は無効
SIF IS_BADSTATE(ARG, "DYING")
	RETURN 0
RETURN 1

;====================================================
;かばうの判定
;
;RESULT かばうキャラの登録番号、不成立の場合は-1をかえすこと
;====================================================
@SKILL_COVERING_C_BTL_EFFECT_蛍火δ, L_TARGET, L_ATTACKER, L_COVER,  L_スキル, L_威力, L_相性, L_相性倍率, L_クリティカル率, L_吸収率, L_ダメージタイプ, L_攻撃タイプ, L_割合計算, L_割合上限
#DIM L_TARGET		;攻撃の対象となっているキャラ
#DIM L_ATTACKER		;攻撃をしている敵
#DIM L_COVER		;かばうキャラクター
#DIM L_スキル
#DIM L_威力
#DIM L_相性
#DIM L_相性倍率
#DIM L_クリティカル率
#DIM L_吸収率
#DIM L_ダメージタイプ
#DIM L_攻撃タイプ
#DIM L_割合計算
#DIM L_割合上限

CALL GET_SKILL_PROP, "SKILL_SPHERE", L_スキル, L_ATTACKER
;敵の攻撃が単体対象技以外だった場合、かばうは成立しない
SIF RESULT != 1
	RETURN -1
RETURN L_COVER
