;通常攻撃
;スキルのテンプレートになっています

;スキル名
@SKILL_NAME_1518,ARG
RESULTS = 드래곤퀘이크

;　명중
@SKILL_HITRATE_1518, ARG
RETURN 100

;　威力
@SKILL_POWER_1518, ARG
SIF SKILL_CHANGE(ARG, [[キャラ:라후]]) && CFLAG:ARG:보스플래그
	RETURN 600
RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_1518,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1518,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1518, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1518,ARG
RETURN 30

;　相性
@SKILL_TYPE_1518,ARG
RETURN GET_TYPE_NUM("지변")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1518
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_1518, ARG
RETURN GET_ダメージタイプ_NUM("物理")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1518, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_1518,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1518,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_1518, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_1518
RETURN GET_SUCCESSION_NUM("지변")

;속도보정
@SKILL_SPEED_1518, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1518
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1518, ARG = -1
RETURN 11



