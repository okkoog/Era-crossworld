;達人向け。達人あなた用に作られたスキル。

;スキル名
@SKILL_NAME_1537,ARG
RESULTS = 칸타렐라요리

;　명중
@SKILL_HITRATE_1537, ARG
RETURN 100

;　威力
@SKILL_POWER_1537, ARG
SIF ARG == -1
	RETURN 90
IF ABL:ARG:요리기능 == 0
	RETURN 100
ELSEIF ABL:ARG:요리기능 == 1
	RETURN 110
ELSEIF ABL:ARG:요리기능 == 2
	RETURN 130
ELSEIF ABL:ARG:요리기능 == 3
	RETURN 150
ELSEIF ABL:ARG:요리기능 == 4
	RETURN 170
ELSEIF ABL:ARG:요리기능 == 5
	RETURN 200
ELSEIF ABL:ARG:요리기능 == 6
	RETURN 220
ELSEIF ABL:ARG:요리기능 == 7
	RETURN 260
ELSEIF ABL:ARG:요리기능 == 8
	RETURN 300
ELSEIF ABL:ARG:요리기능 == 9
	RETURN 400
ELSE
	RETURN 450
ENDIF
RETURN 90

;　최저공격횟수
@SKILL_MINATTACKNUMBER_1537,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1537,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1537, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1537,ARG
SIF ARG == -1
	RETURN 9
IF ABL:ARG:요리기능 == 0
	RETURN 9
ELSEIF ABL:ARG:요리기능 == 1
	RETURN 12
ELSEIF ABL:ARG:요리기능 == 2
	RETURN 15
ELSEIF ABL:ARG:요리기능 == 3
	RETURN 18
ELSEIF ABL:ARG:요리기능 == 4
	RETURN 23
ELSEIF ABL:ARG:요리기능 == 5
	RETURN 26
ELSEIF ABL:ARG:요리기능 == 6
	RETURN 29
ELSEIF ABL:ARG:요리기능 == 7
	RETURN 34
ELSEIF ABL:ARG:요리기능 == 8
	RETURN 38
ELSEIF ABL:ARG:요리기능 == 9
	RETURN 41
ELSE
	RETURN 45
ENDIF
RETURN 9

;　相性
@SKILL_TYPE_1537,ARG
RETURN GET_TYPE_NUM("지변")
;지변

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1537
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_1537, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1537, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_1537,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1537,ARG
RETURN GET_SPHERE_NUM("전체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_1537, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_1537
RETURN GET_SUCCESSION_NUM("지변")
;지변

;속도보정
@SKILL_SPEED_1537, ARG = -1
RETURN 0

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1537
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1537, ARG = -1
RETURN 22


