;====================================================
;スキル及び行動の実行
;複合相性のために、実際は敵の数だけ単体スキルを打ち込むという仕様に
;====================================================
@ACTION_1521, ARG, ARG:1, ARG:2
IF CFLAG:ARG:포지션 < 7
	LOCAL:1 = 7
	LOCAL:2 = 17 
ELSE
	LOCAL:1 = 1
	LOCAL:2 = 7
ENDIF
FOR LOCAL, LOCAL:1, LOCAL:2
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0
		CONTINUE
	SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
		CONTINUE
	CFLAG:ARG:타겟 = LOCAL
	CALL ATTACK_SINGLE, ARG, FLAG:LOCALS, 1521
NEXT
CFLAG:ARG:타겟 = CFLAG:ARG:포지션 < 7 ? 22 # 19
;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_1521, ARG
PRINTL 적 전체에 지변＋정신＋주살의 복합상성의 특대 데미지를 주고、매혹시킨다



;使用条件
@SKILL_SPECIAL_ACTIONABLE_1521,ARG
RETURN 1
;とくにない

