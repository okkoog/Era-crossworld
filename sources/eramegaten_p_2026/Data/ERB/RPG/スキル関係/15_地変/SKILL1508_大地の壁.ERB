;　コストの量
@SKILL_COST_1508,ARG
RETURN 16

;　相性
@SKILL_TYPE_1508,ARG
RETURN GET_TYPE_NUM("지변")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1508
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1508, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_1508,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1508,ARG
RETURN GET_SPHERE_NUM("전체")

