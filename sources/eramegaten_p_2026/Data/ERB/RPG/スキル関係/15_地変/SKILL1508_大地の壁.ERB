RETURN 18

;　최저공격횟수
@SKILL_MINATTACKNUMBER_1508,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1508,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1508, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
