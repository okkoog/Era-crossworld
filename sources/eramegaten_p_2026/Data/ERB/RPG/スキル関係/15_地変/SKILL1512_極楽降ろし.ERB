;20220205	NEO		萃香用のスキルチェンジ構文入れ

;スキル名
@SKILL_NAME_1512,ARG
IF SKILL_CHANGE(ARG, [[キャラ:스이카]])
	;本来は『符の壱　「投擲の天岩戸」』、男投げは「岩を投げるスキル」としては不適当であるためこちらで
	RESULTS = 취부 「투척 아마노이와토」
ELSE
	RESULTS = 극락떨구기
ENDIF

;　명중
@SKILL_HITRATE_1512, ARG
RETURN 100

;　威力
@SKILL_POWER_1512, ARG
SIF FLAG:확산플래그
	RETURN 130
RETURN 210

;　최저공격횟수
@SKILL_MINATTACKNUMBER_1512,ARG
RETURN 2

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_1512,ARG
RETURN 2

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_1512, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_1512,ARG
RETURN 20

;　相性
@SKILL_TYPE_1512,ARG
RETURN GET_TYPE_NUM("지변")

;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_1512
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_1512, ARG
IF (ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:스이카]]) || ((FLAG:행동순1) > 0 && NO:(FLAG:행동순1) == [[キャラ:스이카]])
	RETURN 1
ELSE
	RETURN 2
ENDIF


;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_1512, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_1512,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_1512,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_1512, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_1512
RETURN GET_SUCCESSION_NUM("지변")

;속도보정
@SKILL_SPEED_1512, ARG = -1
RETURN 0


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_1512
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_1512, ARG = -1
RETURN 10



;拡散攻撃用追加処理
@SKILL_SPREAD_1512,ARG
RETURN 1
;拡散距離:1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_1512, ARG, ARG:1, ARG:2
CALL ATTACK_SPREAD,ARG,ARG:1,1512



;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_1512, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:스이카]]
	PRINTL 거대한 암괴를 내던져、대상과 그 주위에 지변 상성의 중위력 물리데미지를 ２회 준다。
	PRINTL 요귀　이부키 스이카의 스펠카드。
ELSE
	PRINTL 암석을 떨어뜨려、대상과 그 주위에 ２회 중 데미지。
ENDIF




;使用条件
@SKILL_SPECIAL_ACTIONABLE_1512,ARG
RETURN 1
;とくにない




