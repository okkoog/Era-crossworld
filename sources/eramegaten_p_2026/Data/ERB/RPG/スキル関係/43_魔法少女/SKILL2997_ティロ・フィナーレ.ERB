;拡散攻撃用追加処理
@SKILL_SPREAD_2997,ARG
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2997, ARG, ARG:1, ARG:2
IF SKILL_CHANGE(ARG, [[キャラ:홀리마미]])
	CALL ATTACK_FIELD,ARG,ARG:1,2997
ELSE
	CALL ATTACK_SPREAD,ARG,ARG:1,2997
ENDIF






;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2997, ARG
IF ARG > 0 && ARG < CHARANUM && NO:ARG == [[キャラ:홀리마미]]
	PRINTL 티로・피날레 홀리 나이트
	PRINTL 대량의 머스킷 총을 생성·전개하여 일제사격으로 「융단폭격」을 행한다.
	PRINTL 마법성녀 홀리 마미의 고유 기술
ELSE
	PRINTL 적 1체에 거대한 탄환을 쏘아 그 주위까지 모조리 섬멸한다.
	PRINTL 크리티컬률 높음·명중률 불안정
	PRINTL 마법소녀 토모에 마미의 필살기
ENDIF



