	RETURN 100
ELSE
	RETURN 85
ENDIF


;　威力
@SKILL_POWER_2997, ARG
IF SKILL_CHANGE(ARG, [[キャラ:홀리마미]])
	RETURN 300
ELSE
	SIF FLAG:확산플래그
		RETURN 260
	RETURN 400
ENDIF


@SKILL_CRITICAL_RATE_2997, ARG
