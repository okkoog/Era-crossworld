;====================================================
;行動によるスキルゲージ操作
;各キャラクターの通常の行動後に全キャラで呼び出される
;ARG:		このスキルの持ち主のキャラ番号
;ARG:1		行動したキャラクターのキャラ番号
;
;RESULT 		獲得したゲージの量を返すことで獲得量を表示させる。つまり、他人の行動に反応させることなども可能。
;RESULT:1		獲得表示のときの文字色を指定できる。ゲージが溜まったときの表示わけなどに
;RESULTS		ゲージの名称 「<<XXXX>>」という形で表示される
;RESULTS:1		ゲージの単位。半角の%を使いたい場合は「\%」と言うかたちで退避記号を使うと良い
;RESULTS;2		色指定以外の要素を使わずに文字列を返す。ゲージ式の獲得量で表現したい場合などに
;====================================================
@SKILLGAGE_CHARGE_3700,ARG,ARG:1
#LOCALSIZE 1
#DIM L_T
#DIM L_GP
SIF SKILLGAGE_D_GET(ARG,3700) > 0
	RETURN 0
SIF SKILLGAGE_F_GET(ARG,3700) == 100
	RETURN 0
L_GP = 0
;自分の行動の場合
IF ARG == ARG:1
	FOR LOCAL, 0, BCHARANUM
		L_T = BCHARA:LOCAL
		SIF IS_FRIEND(ARG, L_T)
			CONTINUE
		SIF GET_CREC_ACT(ARG, L_T, "HIT")
			L_GP += 1
		SIF GET_CREC_ACT(ARG, L_T, "CRT")
			L_GP += 1
		SIF GET_CREC_ACT(ARG, L_T, "WEAK")
			L_GP += 1
	NEXT
	;ティロ・フィナーレ使用時にボーナス
	SIF CFLAG:ARG:입력행동 == 2997
		L_GP += 5
	;ダメージを受けた敵の数に応じてスキルゲージアップ
	;FOR LOCAL,0,CHARANUM
	;	SIF CFLAG:LOCAL:PT플래그 == CFLAG:ARG:PT플래그
	;		CONTINUE
	;	IF CFLAG:LOCAL:현데미지 > 0
	;		CALL SKILLGAGE_F_ADD,ARG,3700,1
	;	ELSE
	;		CONTINUE
	;	ENDIF
	;	;会心、弱点を出すとさらにアップ
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,21)
	;		CALL SKILLGAGE_F_ADD,ARG,3700,1
	;	SIF GETBIT(CFLAG:LOCAL:受けフラグ,22)
	;		CALL SKILLGAGE_F_ADD,ARG,3700,1
	;NEXT
	;ティロ・フィナーレ使用時にボーナス
	;SIF CFLAG:ARG:입력행동 == 2997
	;	CALL SKILLGAGE_F_ADD,ARG,3700,5
ENDIF
;ダメージを受けた又はカウンター、トリガー以外の攻撃を受けたら
;ゲージが増える
SIF GET_CREC_ACT(ARG:1, ARG, "HIT")
	L_GP += MAX(60 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ, 2)
;IF CFLAG:ARG:현데미지 > 0 || GETBIT(CFLAG:ARG:受けフラグ,18) || GETBIT(CFLAG:ARG:受けフラグ,19)
;	LOCAL = 60 * CFLAG:ARG:현데미지 / MAXBASE:ARG:ＨＰ
;	LOCAL = LOCAL < 2 ? 2 # LOCAL
;	CALL SKILLGAGE_F_ADD,ARG,3700,LOCAL
;ENDIF
CALL SKILLGAGE_F_SET,ARG,3700,MIN(L_GP+SKILLGAGE_F_GET(ARG,3700), 100)
IF SKILLGAGE_F_GET(ARG,3700) == 100
	RESULTS = ＤＯＰＰＥＬＧＡＮＧＥＲ ＲＥＡＤＹ！
	RESULT:1 = 0x9400d3
ELSE
	RESULTS = MAGIA
ENDIF
RESULTS:1 = \%
RETURN L_GP
;スキルゲージが100以上だと100にする
;SIF SKILLGAGE_F_GET(ARG,3700) > 100
;	CALL SKILLGAGE_F_SET,ARG,3700,100
RETURN 0

;====================================================
;スキル及び行動の実行
;====================================================

