@SKILL_EX_DISPLAY_3700, ARG, ARGS
RESULTS = 
IF SKILLGAGE_F_GET(ARG, 3700) >= 100
	RESULTS += SET_COLOR_TAG(UNICODE(0x2694), TOSTR(0x999999))
	RESULTS += SET_COLOR_TAG(@"%" Ready", SKILL_EX_DISPLAY_LENS - 2, LEFT%", TOSTR(0x999999))
	RESULTS:1 = 티로 센트 도펠리온
ELSE
	RESULTS += SET_COLOR_TAG(UNICODE(0x2694), TOSTR(0x999999))
	RESULTS += HTML_RECT_BAR(SKILLGAGE_F_GET(ARG, 3700 ), 100, SKILL_EX_DISPLAY_LENS - 2, BARCOLORSET("緑"), RESULT:1)
	RESULTS:1 = MAGIA
ENDIF
RETURN 1
