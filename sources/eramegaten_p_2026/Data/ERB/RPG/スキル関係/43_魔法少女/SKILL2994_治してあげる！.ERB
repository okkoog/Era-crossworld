@SKILL_HITRATE_2994, ARG
RETURN 100

;　威力
@SKILL_POWER_2994, ARG
RETURN 300

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2994,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2994,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2994, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
