;　コストの量
@SKILL_COST_2994,ARG
RETURN 12


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2994
RETURN GET_SKILL_DECIDE_TYPE_NUM("MA")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2994, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

@SKILL_HEAL_TYPE_2994, ARG
RETURN GET_SKILL_HEAL_TYPE_NUM("통상")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2994, ARG
RETURN GET_SKILL_TARGET_NUM("아군")

;　사거리
@SKILL_RANGE_2994,ARG
RETURN 1

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2994,ARG
RETURN GET_SPHERE_NUM("단체")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2994, ARG
RETURN GET_SKILL_EFFECT_NUM("회복")


;계승타입
@SKILL_SUCCESSION_TYPE_2994
RETURN GET_SUCCESSION_NUM("회복")
;不可

@継承不能_2994
RETURN 1

;속도보정
@SKILL_SPEED_2994, ARG = -1
RETURN 2

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2994
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_2994, ARG = -1
RETURN 9




