;-------------------------------------------------------------------------------
;終わる世界改造
;条件の都合2週目以降確定なので、超強力特技
;-------------------------------------------------------------------------------
;スキル名
@SKILL_NAME_2988,ARG
RESULTS = 사랑을품은검은날개

;　명중
@SKILL_HITRATE_2988, ARG
RETURN 120

;　威力
@SKILL_POWER_2988, ARG
RETURN 320

;　최저공격횟수
@SKILL_MINATTACKNUMBER_2988,ARG
RETURN 1

;　최대공격횟수
@SKILL_MAXATTACKNUMBER_2988,ARG
RETURN 1

;　ＨＰ2を支払うかＭＰ3を支払うか
@SKILL_COSTTYPE_2988, ARG
RETURN GET_SKILL_COST_TYPE_NUM("MP")
;消費なし＝1

;　コストの量
@SKILL_COST_2988,ARG
RETURN 72

;　相性
@SKILL_TYPE_2988,ARG
RETURN GET_TYPE_NUM("만능")


;　1EXTRAか2MAGICか
@SKILL_DECIDE_TYPE_2988
RETURN GET_SKILL_DECIDE_TYPE_NUM("EX")

;　1物理ダメージで計算するか2魔法ダメージで計算するか
@SKILL_DAMAGETYPE_2988, ARG
RETURN GET_ダメージタイプ_NUM("魔法")

;　対象が1敵か2味方か3場全体か4特殊か
@SKILL_TARGET_2988, ARG
RETURN GET_SKILL_TARGET_NUM("적")

;　사거리
@SKILL_RANGE_2988,ARG
RETURN 3

;　範囲　1単体　21列　3全体　4　敵味方全体
@SKILL_SPHERE_2988,ARG
RETURN GET_SPHERE_NUM("일렬")

;　 効果のタイプ　1攻撃、2回復、3状態変化、4特殊、5状態回復、6自動効果
@SKILL_EFECT_2988, ARG
RETURN GET_SKILL_EFFECT_NUM("공격")


;계승타입
@SKILL_SUCCESSION_TYPE_2988
RETURN GET_SUCCESSION_NUM("만능")
;継承不可

;속도보정
@SKILL_SPEED_2988, ARG = -1
RETURN -1


;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_2988
RETURN 0

;スキル変化？用ランク
@SKILL_RANK_2988, ARG = -1
RETURN 15

@継承不能_2988
RETURN 1


;====================================================
;ダメージ発動時
;ARG:0	行動者のキャラ番号
;ARG:1	対象のキャラ番号
;ARG:2	1: 弱点攻撃	0:100%	-1:耐性	-2;無効	-3:吸収	-4:反射
;
;備考:標準の追加効果付与はblock・吸収の場合は発動しない。
;====================================================
@SKILL_DAMAGE_EFFECT_2988, ARG, ARG:1, ARG:2
SIF ARG:1 < 0
	RETURN 0
;無効以下では発動しない
SIF ARG:2 <= -2
	RETURN 0
CALL SKILL_SET_カジャンダ, ARG, ARG:1, "防御_命中_回避", -4, "短縮"

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_2988, ARG, ARG:1, ARG:2
CALL ATTACK_FIELD, ARG, ARG:1, 2988

;====================================================
;実行内容ここまで
;====================================================

;　 説明文の表示
@SKILL_EXPLAIN_2988, ARG
PRINTL 세계를 개변한 힘의 일편이 거칠게 날뛴다. 적 1열에 만능 상성의 대데미지를 주고 방어력·명중·회피를 저하시킨다
PRINTL 마법소녀 아케미 호무라의 필살기

;継承に必要な部位
@継承部位_2988,ARG
RESULTS = 날개
RETURN 1

;使用条件
@SKILL_SPECIAL_ACTIONABLE_2988,ARG
RETURN 1
;とくにない

