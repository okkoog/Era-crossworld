;Miru Syndrome戦　完全固定パターン
@SET_ACTION_MiruSyndrome, ARG
#DIM ループ用
IF (FLAG:경과턴수+1) % 5 == 1
	IF CFLAG:ARG:행동한횟수 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:마하에이하]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:마하무드온]]
	ENDIF
ELSEIF (FLAG:경과턴수+1) % 5 == 2
	IF CFLAG:ARG:행동한횟수 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:데・카쟈]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:주살가드브레이크]]
	ENDIF
ELSEIF (FLAG:경과턴수+1) % 5 == 3
	IF CFLAG:ARG:행동한횟수 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:히트라이저]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:마하에이하]]
	ENDIF
ELSEIF (FLAG:경과턴수+1) % 5 == 4
	IF CFLAG:ARG:행동한횟수 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:마하무드온]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:컨센트레이트]]
	ENDIF
ELSEIF (FLAG:경과턴수+1) % 5 == 0
	IF CFLAG:ARG:행동한횟수 == 0
		PRINTL 
		PRINTL 미루의, 취옥색 눈동자가 기이하게 빛난다！
		PRINTL 
		CALL SET_ACTION_SKILL, ARG, [[스킬:나락의파동]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:어둠의포미러버]]
	ENDIF
ENDIF




