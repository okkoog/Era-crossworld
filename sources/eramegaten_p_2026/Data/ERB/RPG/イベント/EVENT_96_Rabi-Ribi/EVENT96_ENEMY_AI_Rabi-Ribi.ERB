		CALL SET_ACTION_SKILL, ARG, [[스킬:질투의폭압]]
	ENDIF
ELSEIF (FLAG:경과턴수+1) % 6 == 0
	IF CFLAG:ARG:행동한횟수 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:스쿠・카쟈]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		CALL SET_ACTION_SKILL, ARG, [[스킬:데・카쟈]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:쿼드커즈]]
	ENDIF
ENDIF

@EVENT_BATTLE_TURNTOP_ミルリターンズ
IF FLAG:경과턴수 > 0
	PRINTL 
	PRINT ＞미루의 마력이 공간을 잠식한다……
	SETCOLOR 0x33ffcc
	PRINT 『
	SETCOLOR 0xff0000
	PRINT 주살내성
	SETCOLOR 0x33ffcc
	PRINT 이 파괴되어간다』
	RESETCOLOR
	PRINTL 
	FOR LOCAL,1, 7
		SIF POS(LOCAL) < 0 || CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("DYING")
			CONTINUE
		;ガーキル追加
		CFLAG:POS(LOCAL):주살무효화횟수 = 0
		CFLAG:POS(LOCAL):주살가드킬 = 1
	NEXT
	IF (FLAG:경과턴수) % 2 == 1
		PRINTFORML 
		PRINTFORML ＞미루가 토끼 인형을 띄우며, 마법에 집중한다。
		SETCOLOR 0x33ffcc
		PRINTFORM ＞마법영창을 하는 미루는 빈틈투성이로 보이나、
			SETCOLOR 0x33ffcc
		PRINTFORML 『유인하는』 것처럼 보이기도 한다。
		RESETCOLOR
		;受けるダメージ倍加。ただしニアデスリベンジが発動しやすくなるってことでもあるんだぜ
		CFLAG:(CHARANUM-1):물리피데미지보정 = 100
		CFLAG:(CHARANUM-1):마법피데미지보정 = 100
		PRINTFORML 
	ELSE
		PRINTFORML 
		PRINTFORM ＞미루가 영창을 끝내고, 이쪽을 노려본다。
		SETCOLOR 0x33ffcc
		PRINTFORML 공격으로 넘어갈 듯 하다。
		RESETCOLOR
		CFLAG:(CHARANUM-1):물리피데미지보정 = 0
		CFLAG:(CHARANUM-1):마법피데미지보정 = 0
		PRINTFORML 
	ENDIF
ENDIF


@EVENT_BATTLE_TURNEND_ミルリターンズ
#DIM ループ用
PRINTL ＞미루의 마력이 넘쳐흐른다……。
FOR ループ用, 1, 7
	;誰もいない、または死んでる場合、スルー
	IF POS(ループ用) < 0 || GET_STATE(CFLAG:POS(ループ用):상태이상) == "DYING"
	;石化⇒即死
	ELSEIF GET_STATE(CFLAG:POS(ループ用):상태이상) == "STONE"
		;実際にDYINGする処理
		PRINTFORML 　　TARGET:[{ループ用,2}] %CALLNAME:POS(ループ用),20,LEFT%　>>>>>>　DYING！　석화자의 생명을 빼앗는다!
		CFLAG:POS(ループ用):상태이상 = GET_STATE_NUM("DYING")
		CALL DEAD_CHARA, POS(ループ用)
	;麻痺⇒石化
	ELSEIF GET_STATE(CFLAG:POS(ループ用):상태이상) == "PALYZE"
		;実際にSTONEする処理
		PRINTFORML 　　TARGET:[{ループ用,2}] %CALLNAME:POS(ループ用),20,LEFT%　>>>>>>　STONE！　마비자의 몸을 돌로 바꾸어 간다!
		CFLAG:POS(ループ用):상태이상 = GET_STATE_NUM("STONE")
		CALL SYNC_STATUS,POS(ループ用)
	;呪⇒麻痺
	ELSEIF GET_STATE(CFLAG:POS(ループ用):상태이상) == "CURSE"
		;実際にPALYZEする処理
		PRINTFORML 　　TARGET:[{ループ用,2}] %CALLNAME:POS(ループ用),20,LEFT%　>>>>>>　PALYZE！　저주받은 자를 마비시킨다!
		CFLAG:POS(ループ用):상태이상 = GET_STATE_NUM("PALYZE")
		CALL SYNC_STATUS,POS(ループ用)
	ENDIF
NEXT

