@GET_EVENT_NAME_96
#FUNCTIONS
RESULTS_F '= "라비리비"
RETURNF RESULTS_F

@PLAYABLE_EVENT_96
;メガテン系イベント以外不許可/Rabi-Ribiオフの場合禁止
SIF !GETS_USEABLE_EXTRA_TITLE("ラビリビ")
	RETURN 0
;貢献度５万から解禁
SELECTCASE イベントフラグ:96:0
	CASE 0
		SIF FLAG:조직공헌도 + FLAG:명성 * 100 < 50000
			RETURN 0
		RESULTS = （EX:Rabi-Ribi）Bunny meets YOU
	CASE 2
;イベント条件検討中
		SIF FLAG:조직공헌도 + FLAG:명성 * 100 < 100000
			RETURN 0
		RESULTS = （EX:Rabi-Ribi）WARP DESTINATION
	CASE 3
		SIF FLAG:조직공헌도 + FLAG:명성 * 100 < 200000
			RETURN 0
		RESULTS = 【EX:Rabi-Ribi】진실, 말해지지 아니하고
	CASE 4
		RESULTS = （EX:Rabi-Ribi）EXTRA Chapter
	CASE 5
		SIF FLAG:조직공헌도 + FLAG:명성 * 100 < 350000
			RETURN 0
		RESULTS = 【Rabi-Ribi EXTRA】Delicious Food……？
	CASE 6
		IF IS_TALKABLE_ERINA()
			RESULTS = 【Rabi-Ribi EXTRA】In Digital Devil World
		ELSE
			RESULTS = （EX:Rabi-Ribi）『Locked』In Digital Devil World
		ENDIF
	CASE 7
		IF IS_TALKABLE_ERINA()
			RESULTS = 【Rabi-Ribi EXTRA】She's Returns
		ELSE
			RESULTS = （EX:Rabi-Ribi）『Locked』She's Returns
		ENDIF
	CASE 8
		RESULTS = 【Rabi-Ribi EXTRA】At Last.
	CASEELSE
		RETURN 0
ENDSELECT
RETURN 1


@SHOPCOM_EVENT_96
IF イベントフラグ:96:0 == 0
	CALL EVENT_96_1
ELSE
	CALLFORM EVENT_96_{イベントフラグ:96:0}
ENDIF
IF RESULT == 0
	RETURN 0
ELSE
	SIF イベントフラグ:96:0 < 8
		CALL RESET_ANNOUNCE_FLAG
	RETURN 1
ENDIF
;イベント進行ができるかどうかの判定
@IS_TALKABLE_ERINA
#FUNCTION
#DIM DYNAMIC L_ERINA
L_ERINA = GETCHARA([[キャラ:에리나_라비리비]])
SIF L_ERINA < 0
	RETURNF 0
SIF 服従系陥落(L_ERINA)
	RETURNF 0
SIF TALENT:L_ERINA:붕괴
	RETURNF 0
SIF TALENT:L_ERINA:비전투원
	RETURNF 0
RETURNF 1