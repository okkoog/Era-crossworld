@SET_BOSS_ENEMY_EVENT_96, L_ENEMY_NAME, L_NO = -1, L_OPT
#DIM DYNAMIC L_NO
#DIM DYNAMIC L_ENEMY
#DIMS DYNAMIC L_ENEMY_NAME
#DIMS DYNAMIC L_OPT
#DIMS DYNAMIC L_ENEMY_TABLE, 20

L_ENEMY_TABLE:0 '= "ノア", "ノア_2戦目", "ノアリウス", "ミル・シンドローム", "ノア_3戦目", "ノア_4戦目", "リボン_SP", "イリス_SP", "ミル_SP"

IF L_NO >= 0
	SIF !INRANGE(L_NO, 0, VARSIZE("L_ENEMY_TABLE") - 1)
		RETURN 0
	L_ENEMY_NAME '= L_ENEMY_TABLE:L_NO
ENDIF
IF L_OPT == "名称取得"
	SIF L_ENEMY_TABLE:L_NO == ""
		RETURN 0
	RESULTS '= L_ENEMY_NAME
	RETURN 1
ENDIF
SELECTCASE L_ENEMY_NAME
	;-------------------------------------------------
	;EVENT96_2_ WARP DESTINATION
	;-------------------------------------------------
	CASE "ノア"
		CALL SET_ENEMY,9, [[キャラ:노아_라비리비]], 20, 1, 1
		L_ENEMY = CHARANUM-1
		CALLNAME:L_ENEMY = 수수께끼의 소녀
		CFLAG:L_ENEMY:ＨＰ보정 = 500
		CFLAG:L_ENEMY:ＭＰ보정 += 999
		CFLAG:L_ENEMY:행동횟수 = 1
		ABL:L_ENEMY:공격상성 = 1
		ABL:L_ENEMY:공격범위 = 1
		ABL:L_ENEMY:사거리 = 3
		CALL CLEAR_ALL_SKILL, L_ENEMY
		ABL:L_ENEMY:스킬1 = [[스킬:마하무드]]
		ABL:L_ENEMY:스킬2 = [[스킬:마하에이하]]
		ABL:L_ENEMY:스킬3 = [[스킬:도무디]]
		BASE:L_ENEMY:검격 = 100
		BASE:L_ENEMY:비구 = 100
		BASE:L_ENEMY:타격 = 100
		BASE:L_ENEMY:전술 = 100
		BASE:L_ENEMY:화염 = 100
		BASE:L_ENEMY:빙결 = 100
		BASE:L_ENEMY:전격 = 100
		BASE:L_ENEMY:신경 = 100
		BASE:L_ENEMY:정신 = 100
		BASE:L_ENEMY:파마 = 0
		BASE:L_ENEMY:주살 = 100
		BASE:L_ENEMY:충격 = 100
		BASE:L_ENEMY:지변 = 100
		BASE:L_ENEMY:수격 = 100
		BASE:L_ENEMY:질풍 = 100
		BASE:L_ENEMY:중력 = 100
		BASE:L_ENEMY:핵열 = 100
		BASE:L_ENEMY:만능 = 100
		CSTR:(CHARANUM-1):30 = 세이프하우스 밖을 서성이던 정체불명의 소녀。
		CSTR:(CHARANUM-1):31 = 
		CSTR:(CHARANUM-1):32 = 흐트러진 파자마를 입고 나이트캡을 쓴 채、 졸린 눈을 하고 있다。
		CSTR:(CHARANUM-1):33 = 『우사쨩』이란 것을 찾는 것 같은데……。
		CSTR:L_ENEMY:34 = 
		CSTR:L_ENEMY:35 = 
		CSTR:L_ENEMY:36 = 
		CSTR:L_ENEMY:37 = 
		CSTR:L_ENEMY:38 = 
		CSTR:L_ENEMY:39 = 
		CSTR:L_ENEMY:40 = 
		CALL SYNC_STATUS,L_ENEMY
		CALL HEALTH_CHARA,L_ENEMY
	;-------------------------------------------------
	;EVENT96_2_ WARP DESTINATION
	;-------------------------------------------------
	CASE "ノア_2戦目"
		TSTR:전투이벤트패턴 = EV96_ノア_2戦目
		CALL SET_ENEMY,9, [[キャラ:노아_라비리비]], 40, 1, 1
		L_ENEMY = CHARANUM-1
		CALL SET_ENEMY_TIMEID, L_ENEMY, "ノア"
		CALLNAME:L_ENEMY = ノア
		;イベントで逃走するまで死なない
		CFLAG:L_ENEMY:불사신플래그 = 1
		CFLAG:L_ENEMY:ＭＰ보정 += 9999
		CFLAG:L_ENEMY:행동횟수 = 1
		ABL:L_ENEMY:공격상성 = 1
		ABL:L_ENEMY:공격범위 = 1
		ABL:L_ENEMY:사거리 = 3
		;ノアのスキル検討
		CALL CLEAR_ALL_SKILL, L_ENEMY
		ABL:L_ENEMY:스킬1 = [[스킬:메기도라]]
		ABL:L_ENEMY:스킬2 = [[스킬:라쿠・카쟈]]
		ABL:L_ENEMY:스킬3 = [[스킬:아쿠아다인]]
		CSTR:(CHARANUM-1):37 = 결계를 전개하고、 에리나 일행에게 공격해왔다。
		CSTR:(CHARANUM-1):38 = 거기에 뭔가 책략이 있는 것 같은데……
		CSTR:L_ENEMY:39 = 
		CSTR:L_ENEMY:40 = 
	CASE "ノアリウス"
		CALL SET_ENEMY,9, [[キャラ:일루전・아리우스]], 35, 1, 1
		L_ENEMY = CHARANUM-1
		CALL SET_ENEMY_TIMEID, L_ENEMY, "ノアリウス"
		CFLAG:L_ENEMY:ＭＰ보정 += 9999
		CFLAG:L_ENEMY:행동횟수 = 2
		CSTR:L_ENEMY:사고패턴 = アリウスの頭
		TSTR:전투이벤트패턴 = ノアリウス
		CSTR:L_ENEMY:랜덤선택금지스킬 = {SKILL_NUM_F("옥쇄파")}
	;-------------------------------------------------
	;EVENT96_3_真実、語られる事なく
	;-------------------------------------------------
	CASE "ミル・シンドローム"
		CALL SET_ENEMY,9, [[キャラ:미루・신드롬]], 55, 1, 1
		L_ENEMY = CHARANUM-1
		CFLAG:L_ENEMY:ＭＰ보정 += 9999
		CFLAG:L_ENEMY:행동횟수 = 2
		CSTR:L_ENEMY:사고패턴 '= "MiruSyndrome"
	CASE "ノア_3戦目"
		CALL SET_ENEMY,9, [[キャラ:노아_3차전]], 60, 1, 3
		L_ENEMY = CHARANUM-1
		CALL SET_ENEMY_TIMEID, L_ENEMY, "ノア"
		CFLAG:L_ENEMY:ＭＰ보정 += 9999
		CFLAG:L_ENEMY:행동횟수 = 2
		CFLAG:L_ENEMY:불사신플래그 = 1
		TSTR:전투이벤트패턴 '= "EVENT96_ノア_3戦目"
	CASE "ノア_4戦目"
		CALL SET_ENEMY,9, [[キャラ:노아_4차전]], 60, 1, 3
		L_ENEMY = CHARANUM-1
		CFLAG:L_ENEMY:ＭＰ보정 += 9999
		CFLAG:L_ENEMY:행동횟수 = 1
		CSTR:L_ENEMY:사고패턴 '= "在りし日の彼女"

	;-------------------------------------------------
	;EVENT96_5_ Delicious Food……？
	;-------------------------------------------------
	CASE "リボン_SP"
		;モチーフのRabi-Ribiリボンちゃんに則ってHPは低め、レベルを上げればしばける程度の作り。
		CALL SET_ENEMY,9, [[キャラ:리본_SP]], 80, 1, 3
		L_ENEMY = CHARANUM-1
		CFLAG:L_ENEMY:ＨＰ보정 -= 500
		CFLAG:L_ENEMY:ＭＰ보정 += 9999
		CFLAG:L_ENEMY:행동횟수 = 2
		CALL SET_ENEMY_TIMEID, L_ENEMY, "リボン_SP"
		CSTR:L_ENEMY:사고패턴 = デリシャスフード
		TSTR:전투이벤트패턴 = デリシャスフード

	;-------------------------------------------------
	;EVENT96_6_ In Digital Devil Land
	;-------------------------------------------------
	CASE "イリス_SP"
		CALL SET_ENEMY,9, [[キャラ:이리스_SP]], 85, 1, 3
		L_ENEMY = CHARANUM-1
		CALL SET_BATTLE_STATUS, L_ENEMY, 15000 * (FLAG:전투난이도 * 25  + 50) / 100, "ＨＰ"
		CFLAG:L_ENEMY:ＭＰ보정 += 9999
		
		CALL SET_ENEMY_TIMEID, L_ENEMY, "イリス_SP"

		;移行まで耐えるのでちょっとだけね
		CFLAG:L_ENEMY:불사신플래그 = 1
		CSTR:L_ENEMY:사고패턴 = イリスインデーモンランド
		TSTR:전투이벤트패턴 = イリスインデーモンランド
	;-------------------------------------------------
	;EVENT96_7_She's Returns
	;-------------------------------------------------
	CASE "ミル・リターンズ"
		CALL SET_ENEMY,9, [[キャラ:미루・리턴즈]], 85, 1, 3
		L_ENEMY = CHARANUM-1
		CALL SET_BATTLE_STATUS, L_ENEMY, 20000 * (FLAG:전투난이도 * 25  + 50) / 100, "ＨＰ"
		CFLAG:L_ENEMY:ＭＰ보정 += 9999
		CFLAG:L_ENEMY:행동횟수 = 3
		CSTR:L_ENEMY:사고패턴 = ミルリターンズ
		TSTR:전투이벤트패턴 = ミルリターンズ
ENDSELECT
;ステータス同期と回復
CALL SET_UP_ENEMY