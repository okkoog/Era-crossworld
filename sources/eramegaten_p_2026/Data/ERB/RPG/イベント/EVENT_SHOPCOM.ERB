@SHOPCOMABLE_105
#DIM LCOUNT
SIF !IS_USEABLE_EVENT
	RETURN 0
;パーティに一人以上いるなら
LOCAL = 0
FOR LCOUNT, 0, CHARANUM
	SIF CFLAG:LCOUNT:PT플래그 == 2
		LOCAL:1 += 1
NEXT

FOR LOCAL, 0, 999
	TRYCCALLFORM PLAYABLE_EVENT_{LOCAL}
		IF RESULT
			LOCAL:2 += 1
		ENDIF
	CATCH
	ENDCATCH
NEXT

RESULT:1 = 1
RESULTS = 이벤트
IF LOCAL:1 > 0 && LOCAL:2 > 0
	RETURN 1
ELSE
	RETURN 0
ENDIF


@SHOW_EVENT
CUSTOMDRAWLINE =

FOR LOCAL, 0, 999
	SIF !IS_USEABLE_SHOPCOM && !GROUPMATCH(LOCAL, [[이벤트:이상한손님]])
		CONTINUE
	TFLAG:LOCAL = 0
	RESULTS '= "", ""
	;---- EDIT P 001 MOD START -------------------------
	TRYCCALLFORM PLAYABLE_EVENT_{LOCAL}
		IF RESULT
			TFLAG:LOCAL = RESULT
			IF RESULTS != ""
				SIF ANNOUNCE_EVENT_APPEARED:LOCAL == 2
					ANNOUNCE_EVENT_APPEARED:LOCAL = 3
				SIF ANNOUNCE_EVENT_APPEARED:LOCAL == 3
					SETCOLOR COLOR("p-green")
				SIF TFLAG:LOCAL < 0
					SETCOLOR COLOR("gray")
				PRINTFORM [{LOCAL,3}] - %RESULTS, 36, LEFT%
				SIF RESULT < 0
					PRINTFORM %RESULTS:1%
				PRINTL 
				RESETCOLOR
			ENDIF
		ENDIF
	CATCH
		
	ENDCATCH
	;---- EDIT P 001 MOD START -------------------------
NEXT

@SHOP_COM_105, ARG
CALL SHOW_EVENT
PRINTL [1000] 돌아간다

DRAWLINE
PRINTL 어느 이벤트를 실행하시겠습니까？
VARI L_LINE = LINECOUNT
WHILE 1
	CLEARLINE LINECOUNT - L_LINE
	INPUT
	SELECTCASE RESULT
		CASE 1000
			FLAG:SHOP커맨드 = 0
			BREAK
		CASE 0 TO VARSIZE("TFLAG") - 1
			IF TFLAG:RESULT <= 0
				IF IS_DEBUG
					PRINTFORMW 조건 미달 상태로 이벤트를 시작합니다
				ELSE
					CONTINUE
				ENDIF
			ENDIF
			FLAG:진행중이벤트 = RESULT
			CALL STARTUP_RPG_SHOPCOM
			TRYCALLFORM SHOPCOM_EVENT_{FLAG:진행중이벤트}
			FOR LOCAL,0,CHARANUM
				SIF CFLAG:LOCAL:악마변신 == 1
					CALL TRANS_DEVIL , LOCAL , 0
			NEXT
			FLAG:진행중이벤트 = 0
			FLAG:SHOP커맨드 = 0
			BREAK
	ENDSELECT
WEND
VARSET TFLAG,-1
RETURN 0

@GET_EVENT_NAME, EV_NO
#FUNCTIONS
#DIM DYNAMIC EV_NO
IF EXISTFUNCTION(@"GET_EVENT_NAME_{EV_NO}")
	CALLFORMF GET_EVENT_NAME_{EV_NO}
	RETURNF RESULTS_F
ELSE
	RETURNF "名称未定義"
ENDIF