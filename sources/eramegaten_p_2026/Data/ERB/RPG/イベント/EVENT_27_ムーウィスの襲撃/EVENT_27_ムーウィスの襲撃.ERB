	;ネミッサがパーティ内にいる
	IF (FINDCHARA_B([[キャラ:네밋사_밝음]]) == 2 || FINDCHARA_B([[キャラ:네밋사_쿨]]) == 2 || FINDCHARA_B([[キャラ:네밋사_섹시]]) == 2)
		;朝か昼
		;IF TIME == 0 || TIME == 1
		;	RESULTS = ネミッサとの会話
		;	RETURN 1
		;夕方か夜
		;ELSEIF TIME == 2 || TIME == 3
			RESULTS = 습격
			RETURN 1
		;ENDIF
	;ネミッサが加入している
	ELSEIF (FINDCHARA_B([[キャラ:네밋사_밝음]]) >= 1 || FINDCHARA_B([[キャラ:네밋사_쿨]]) >= 1 || FINDCHARA_B([[キャラ:네밋사_섹시]]) >= 1)
		RESULTS = 네밋사와의 대화
		RETURN 1
	ENDIF
ENDIF
RETURN 0

