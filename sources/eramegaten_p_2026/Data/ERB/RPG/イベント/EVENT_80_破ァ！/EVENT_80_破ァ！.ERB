;====================
;条件
;====================
@GET_EVENT_NAME_80
#FUNCTIONS
RESULTS_F '= "파앗!"
RETURNF RESULTS_F

@PLAYABLE_EVENT_80
;メガテン系イベント以外不許可の場合
SIF !GETS_USEABLE_EXTRA_TITLE("ネットミーム")
	RETURN 0

;ノルマ3回達成後
IF FLAG:조직공헌도 >= 350000 && イベントフラグ:80:0 == 0 && BASE:MASTER:LV > 50
	RESULTS = （EX:인터넷 밈）절 태생의 Ｔ씨
	RETURN 1
ENDIF
RETURN 0


;====================
;内容
;====================
@SHOPCOM_EVENT_80
#DIM L_CHARA
IF イベントフラグ:80:0 == 0
	;KR판 임의수정 추정, 이벤트 약간 가필
	PRINTFORMW 어느날、일의 예정이 취소가 되어버린 %MASTER는% 비밀 사냥터에서 한바탕 땀을 빼기로 했다。
	PRINTW 장소는 시내에서 조금 떨어진 곳에 있는 지하도、그것도 조용하고 수익이 짭짤한 지점……
	PRINTW 그날도 아주 열심히 기분 좋게 불태웠기에、자신 스스로 이를 치하하기 위해 이소라 구이를 즐기기로 했다。
	PRINTW 그런데 구이가 슬슬 익어가기 시작할 무렵、갑자기 온몸에 한기가 엄습했다…！
	PRINTFORMW 뭔가 뒤숭숭하네……그렇게 생각하면서도 %MASTER는% 계속해서 화염병으로 이소라를 굽고 있었다。
	PRINTL
	PRINTW 「당신도 낚시입니까？」
	PRINTL
	PRINTFORMW 순간、뒤에서 누군가가 말을 걸어왔다。그것은 아무리 보아도 악령이었다。%MASTER는% 주살내성에 대한 대책을 준비하고 있지 않았다。
	PRINTW 젠장, 망했다.
	PRINTW 절망한 당신의 시야에、돌연、빛나는 충격파가 날아들었다。
	PRINTL
	PRINTW 「파앗(破)！！」
	PRINTL
	PRINTW 콰아앙!!！
	PRINTW 무려、그 남자의 기합 하나로、악령은 무참히 폭발하여 사방으로 흩어지고 말았다！
	PRINTL
	PRINTW 「당신、초심자로는 보이지 않지만…… 훗、물고기를 쫒아가다가 도리어 자신이 낚이면 어쩌자는 거야？
	PRINTW 　그건 그렇고、해가 완전히 져버렸군、
	PRINTW 　어디、거리에 여자라도 낚시하러 갈까?  당신도 올 텐가？」
	PRINTL
	PRINTW 그렇게 말한 뒤 차에 탑승하면서 환하게 웃는 남자를 보고、
	PRINTFORMW 과연 그렇군……그가 소문으로 들은『절 태생의 Ｔ씨』인가……하고、%MASTER는% 납득했다。
	PRINTW 절 태생은 굉장하군。
	PRINTL
	PRINTW 인간　절 태생의 T씨가 동료가 되었다！
	CALL ADD_NEW_COMPANION, [[キャラ:T씨]], 1000, 0, 0, 0, 55
	L_CHARA = RESULT:1
	SIF RESULT > 0
		CALL SET_TALENT_PARTY_JOINABLE, L_CHARA, "신용"
	イベントフラグ:80:0 = 1
ENDIF


