@EVENT_BATTLE_TURNEND_TEST_WAVE_BATTLE
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_POS
#DIM DYNAMIC L_ENEMY
#DIM DYNAMIC CNT_SUCCESS
#DIM CONST POS_TABLE = 12, 16, 13, 15, 14,7, 11, 8, 10, 9
;敵追加
FOR LCOUNT, 0, BCHARANUM
	L_ENEMY = BCHARA:LCOUNT
	;登場ターンを過ぎてる
	SIF CFLAG:L_ENEMY:800 >= FLAG:경과턴수 + 1
		CONTINUE
	;味方
	SIF CFLAG:L_ENEMY:PT플래그 > 0
		CONTINUE
	;配置済み
	SIF CPOS(L_ENEMY) > 0
		CONTINUE
	;死亡している
	SIF IS_BADSTATE(L_ENEMY, "DYING")
		CONTINUE
	SIF IS_BADSTATE(L_ENEMY, "STONE")
		CONTINUE
	;空きポジションを探して入れる
	FOR L_POS, 0, VARSIZE("POS_TABLE")
		SIF POS(POS_TABLE:L_POS) >= 0
			CONTINUE
		CALL INSERT_POSITION, POS_TABLE:L_POS, L_ENEMY
		CNT_SUCCESS = 1
		BREAK
	NEXT
NEXT
IF CNT_SUCCESS > 0
	SETCOLOR COLOR("ENEMY")
	CALL MESSAGE_B2, , , "새로운 적이 나타났다!"
	RESETCOLOR
ENDIF


;-------------------------------------------------------------
;特殊勝敗判定
;敵増援ストックがいる限り敗北させない
;-------------------------------------------------------------
@FIGHT_IT_OUT_TEST_WAVE_BATTLE
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC IS_NOT_WIN
;控え込みで敵影以外の敵が全滅しているかどうかで判定する
FOR LCOUNT, 0, BCHARANUM
	L_CHARA = BCHARA:LCOUNT
	SIF CFLAG:L_CHARA:PT플래그
		CONTINUE
	SIF !IS_BADSTATE(L_CHARA, "DYING")
		IS_NOT_WIN = 1
	SIF !IS_BADSTATE(L_CHARA, "STONE")
		IS_NOT_WIN = 1
	SIF IS_NOT_WIN
		BREAK
NEXT
IF IS_NOT_WIN == 0
	FLAG:승리플래그 = 1
	RETURN 1
ENDIF
;通常の
CALL FIGHT_IT_OUT_LOSE
RETURN 1

@TEST_BOSS_BATTLE, ARGS = "DUNGEON"
#DIM DYNAMIC L_STAGE
#DIM DYNAMIC EXIST_BATTLE, 1000
#DIMS DYNAMIC SHOWLINE
#DIM DYNAMIC L_CNT
DRAWLINE
SELECTCASE ARGS
ENDSELECT	
FOR L_STAGE, 0, 1000
	TRYCCALLFORM SET_BOSS_ENEMY_%ARGS%_{L_STAGE}, , 0, "名称取得"
		IF RESULT
			CALLFORMF GET_%ARGS%_NAME_{L_STAGE}
			SHOWLINE += @"<div xpos = '{50 * 40 * L_CNT}'>" + SET_BUTTON_TAG(@"[{L_STAGE,3}] %RESULTS_F%", TOSTR(L_STAGE)) + "</div>"
			EXIST_BATTLE:L_STAGE = 1
			IF L_CNT == 2
				HTML_PRINT SHOWLINE
				L_CNT = 0
				SHOWLINE '= ""
			ENDIF
			L_CNT++
		ENDIF
	CATCH
	ENDCATCH
NEXT
SIF SHOWLINE != ""
	HTML_PRINT SHOWLINE
WHILE LINECOUNT - L_LINE < 30
	PRINTL 
WEND
DRAWLINE
PRINTFORML [999] 돌아간다
VARI L_LINE = LINECOUNT
DO 
	CLEARLINE LINECOUNT - L_LINE
	INPUT
	SIF RESULT == 999
		RETURN 0
LOOP !(INRANGE(RESULT, 0, VARSIZE("EXIST_BATTLE") - 1) && EXIST_BATTLE:RESULT > 0)

L_STAGE = RESULT
DRAWLINE
CALLFORMF GET_%ARGS%_NAME_{L_STAGE}
PRINTFORML %RESULTS_F%
DRAWLINE
VARI LCOUNT
VARI ABLE_BATTLE, 100

VARI L_LINE = LINECOUNT
DO 
	CLEARLINE LINECOUNT - L_LINE
	FOR LCOUNT, 0, 100
		CALLFORM SET_BOSS_ENEMY_%ARGS%_{L_STAGE}, , LCOUNT, "名称取得"
		SIF !RESULT
			CONTINUE
		ABLE_BATTLE:LCOUNT = 1
		HTML_PRINT SET_BUTTON_TAG(@"[{LCOUNT, 2}] %RESULTS%", TOSTR(LCOUNT))
	NEXT
	WHILE LINECOUNT - L_LINE < 30
		PRINTL 
	WEND
	DRAWLINE
	PRINTFORML [999] 돌아간다
	INPUT
	IF INRANGE(RESULT, 0, 100) && ABLE_BATTLE:RESULT
		CALLFORM SET_BOSS_ENEMY_%ARGS%_{L_STAGE}, , RESULT
		CALL BATTLE_START
	ENDIF
LOOP RESULT != 999