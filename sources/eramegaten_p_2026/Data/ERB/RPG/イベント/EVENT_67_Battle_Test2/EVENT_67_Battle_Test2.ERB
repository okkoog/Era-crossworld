@SHOPCOM_EVENT_67
#DIM LCOUNT
#DIM ENEMY_LV
#DIMS ENEMY_AI
#DIM ENENY_HP
#DIM ENENY_MP
#DIM ENEMY_NO
ENEMY_LV = 5
ENENY_HP = 100000
ENENY_MP = 10000
PRINTFORML [0] 샌드백
PRINTFORML [1] 로카파라
PRINTFORML [2] WAVE 배틀
PRINTFORML [3] 던전
PRINTFORML [4] 이벤트
PRINTFORML [5] 투기장
PRINTFORML [6] 의뢰
PRINTFORML [9] 취소
CALL INPUTINT , 0, 1, 2, 3, 4, 5, 6, 9
SELECTCASE RESULT
	CASE 0
		FOR LCOUNT, 7, 17
			SIF !GROUPMATCH(LCOUNT, 8, 9, 10, 14)
				CONTINUE
			ENEMY_NO = [[キャラ:쁘띠프로스트]]
			ANALYSIS_RATE:ENEMY_NO = ANALYSIS_COMPLETED
			CALL SET_ENEMY,LCOUNT,ENEMY_NO, ENEMY_LV,1,0
			SIF POS(LCOUNT) < 0
				CONTINUE
			CFLAG:POS(LCOUNT):ＨＰ보정 = ENENY_HP
			CFLAG:POS(LCOUNT):ＭＰ보정 = ENENY_MP
			CFLAG:POS(LCOUNT):명중보정 = 5000
		NEXT
		;ステータス同期と回復
		CALL SET_UP_ENEMY
	CASE 1
		FLAG:SHOP커맨드 = [[ショップ:탐색]]
		FLAG:현던전 = [[ダンジョン:로카파라]]
		FLAG:진행중이벤트 = 0
		SIF !RESULT
			RESTART
		CALL TEST_SET_ENEMY_LOKAPALA
	CASE 2
		CALL TEST_WAVE_BATTLE
		RETURN 0
	CASE 3
		CALL TEST_BOSS_BATTLE, "DUNGEON"
		RETURN 0
	CASE 4
		CALL TEST_BOSS_BATTLE, "EVENT"
		RETURN 0
	CASE 5
		CALL TEST_BOSS_BATTLE, "COLOSSEUM"
		RETURN 0
	CASE 6
		CALL TEST_BOSS_BATTLE, "REQUEST"
		RETURN 0
	CASE 9
		RETURN 0
ENDSELECT
;解析度をつける
FOR LCOUNT, 7, 17
	SIF POS(LCOUNT) >= 0
		FLAG:(NO:POS(LCOUNT) + 20000) = 10000
NEXT
FLAG:선제기습취소 = 1
CALL BATTLE_START
FLAG:선제기습취소 = 0

FLAG:SHOP커맨드 = [[ショップ:이벤트]]
FLAG:현던전 = 0
FLAG:진행중이벤트 = 67

