PRINTFORML [15] Lv85 리얼 바루나
PRINTFORML [16] Lv88 카마소츠
PRINTFORML [17] Lv92 라후
PRINTFORML [18] Lv95 라바나
PRINTFORML [19] Lv99 브라흐마
PRINTFORML [99] 돌아간다

WHILE 1
	INPUT
	CLEARLINE 1
	IF RESULT == 99
		RETURN 0
	ELSEIF INRANGE(RESULT, 0, 19)
		SELECTCASE GET_BOSS_NAME_TABLE_DUNGEON_13(RESULT)
			CASE "クパンダ"
				FLAG:현M = 0
			CASE "ラボ明智", "ミロク菩薩"
				FLAG:현M = 37
			CASE "ヴリュンヒルド", "オーディン", "ミトラ菩薩"
				FLAG:현M = 53
			CASE "宇宙の卵明智", "イナンナ", "ヴィシュヌレン"
				FLAG:현M = 62
			CASE "リアルヴァルナ", "カマソッソ", "ラーフ", "ラーヴァナ", "ブラフマー"
				FLAG:현M = 94
			CASEELSE
				FLAG:현M = 94
		ENDSELECT
		CALL SET_BOSS_ENEMY_DUNGEON_13, GET_BOSS_NAME_TABLE_DUNGEON_13(RESULT)
		RETURN 1
	ENDIF
WEND

