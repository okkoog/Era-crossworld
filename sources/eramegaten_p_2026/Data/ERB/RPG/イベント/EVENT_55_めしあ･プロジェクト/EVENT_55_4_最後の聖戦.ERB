;-------------------------------------------------	
@EVENT_BATTLE_TURNEND_EVENT55
IF イベントフラグ:55:4 > 0
	PRINTFORML TURN_END処理開始
	;大天使との戦闘：敵3人のうち誰かが死んだ
	IF イベントフラグ:55:4 == 3 && ENEMY_COUNT() == 2 && イベントフラグ:55:7 == 0
		SETCOLOR 0XDC143C
			PRINTFORML 
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃네놈, 감히……! 　　　　　　　　　　　　　　┃
			PRINTFORML ┃이제 더 이상의 용서는 없다 　　　　　　　　　┃
			PRINTFORML ┃신의 적을 도륙하는 우리의 힘, 똑똑히 보아라! ┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
		RESETCOLOR
	;ラファエル攻撃回数増加
		CFLAG:(CHARANUM-1):행동횟수 = 2	
		ABL:(CHARANUM-1):최저공격횟수 = 2
		ABL:(CHARANUM-1):최대공격횟수 = 2
	;ミカエル攻撃回数増加	
		CFLAG:(CHARANUM-2):행동횟수 = 2
		ABL:(CHARANUM-2):최저공격횟수 = 2
		ABL:(CHARANUM-2):최대공격횟수 = 2
	;ウリエル攻撃回数増加	
		CFLAG:(CHARANUM-3):행동횟수 = 2
		ABL:(CHARANUM-3):최저공격횟수 = 2
		ABL:(CHARANUM-3):최대공격횟수 = 2
	イベントフラグ:55:7 = 1	
	;敵2人死んだ
	ELSEIF イベントフラグ:55:4 == 3 && ENEMY_COUNT() == 1 && イベントフラグ:55:7 == 1
		SETCOLOR 0XDC143C
			PRINTFORML 
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃이상의 천년왕국을 건설하려 이 땅에 내렸건만　┃
			PRINTFORML ┃끝내 메시아는 오지 않고, 심지어 저런 자가 　┃
			PRINTFORML ┃메시아라니, 결단코 인정할 수 없다……!! 　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
		RESETCOLOR
	;ラファエル攻撃回数増加
		CFLAG:(CHARANUM-1):행동횟수 = 3
		ABL:(CHARANUM-1):최저공격횟수 = 2
		ABL:(CHARANUM-1):최대공격횟수 = 3
	;ミカエル攻撃回数増加	
		CFLAG:(CHARANUM-2):행동횟수 = 3
		ABL:(CHARANUM-2):최저공격횟수 = 2
		ABL:(CHARANUM-2):최대공격횟수 = 3
	;ウリエル攻撃回数増加	
		CFLAG:(CHARANUM-3):행동횟수 = 3
		ABL:(CHARANUM-3):최저공격횟수 = 2
		ABL:(CHARANUM-3):최대공격횟수 = 3
	イベントフラグ:55:7 = 2
	ENDIF
	;三大天使生存状況を確認後、敵味方全体に歌声デバフ
	;PRINTFORML 歌声デバフ処理
	LOCAL:1 = RAND:100
	IF LOCAL:1 < 30
			SETCOLOR 0x65F1FF
				PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
				PRINTFORML ┃하ー마온온!!　　　　　　　　　　　　　　　　┃
				PRINTFORML ┃　　　　　마한마온온!!! 　　　　　　　　　　┃
				PRINTFORML ┃　　　　　　　　　　　　　　　　　　　　　　┃
				PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
			RESETCOLOR 	
		;状態異常（歌が聞こえない）キャラ以外を回復する。めしあちゃんスゲエ
		LOCALS = 메시아쨩의 노랫소리가 청중을 치유한다……!!
		CALL MESSAGE_B(1, LOCALS)
		FOR LOCAL,1,16
			;自軍敵軍パーティーのポジションをチェック
			IF POS(LOCAL) > -1
				;状態異常にかかっていたら処理しない
				IF CFLAG:(POS(LOCAL)):상태이상 > 0 || GET_STATE(CFLAG:LOCAL:상태이상) == "DYING"
					CONTINUE
				ELSE
					PRINTFORMW TARGET:[{LOCAL,2}] %CALLNAME:POS(LOCAL),20,LEFT%　>>>>>>　200 회복
					CALL VAR_HP, LOCAL, +200, "회복"
				ENDIF
			ELSE
			ENDIF
		NEXT
	ELSEIF LOCAL:1 >= 30
			SETCOLOR 0x65F1FF
				PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
				PRINTFORML ┃하ー마! 　　　　　　　　　　　　　　　　　　┃
				PRINTFORML ┃　　　　　하마온!!　　　　　　　　　　　　　┃
				PRINTFORML ┃　　　　　　　　　　　마한마온온!!! 　　　┃
				PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
			RESETCOLOR 	
		;状態異常（歌が聞こえない）キャラ以外をHAPPYに。めしあちゃんヤベエ
		LOCALS = 메시아쨩의 노랫소리가 청중을 매료한다……!!
			CALL MESSAGE_B(1, LOCALS)
			;自軍敵軍パーティーのポジションをチェック
			FOR LOCAL,1,16
				IF POS(LOCAL) > -1
					LOCAL:1 = RAND:100
					;状態異常にかかっていたら処理しない
					IF CFLAG:(POS(LOCAL)):상태이상 > 0
						CONTINUE
					;とりあえず確率6割で強制HAPPY
					ELSEIF LOCAL:1 < 60
						PRINTFORMW TARGET:[{LOCAL,2}] %CALLNAME:POS(LOCAL),20,LEFT%　>>>>>>　HAPPY
						;●HAPPYになる処理をここに入れる
						CFLAG:(POS(LOCAL)):상태이상 = GET_STATE_NUM("HAPPY")
					ELSE
						PRINTFORMW TARGET:[{LOCAL,2}] %CALLNAME:POS(LOCAL),20,LEFT%　>>>>>>　MISS
					ENDIF
				ENDIF
			NEXT
		;バステ処理フラグをリセット
		SIF イベントフラグ:55:8 == 1
		イベントフラグ:55:8 = 0
		;御使いはポジション8～10にいるのでそこを検索
		FOR LOCAL,8,10
			;空になっていないポジション8～10のナンバーを取得し、HAPPY状態であるかを見る
			IF POS(LOCAL) > -1 
				SIF GET_STATE(CFLAG:LOCAL:상태이상) == "HAPPY"
				イベントフラグ:55:8 += 1
			ENDIF
		NEXT
		;バステ処理フラグが0でない（1以上）とき、御使いのコメントが発生してなければ御使いが喋る
		IF イベントフラグ:55:8 != 0
			IF イベントフラグ:55:6 == 1
				SETCOLOR 0XDC143C
					PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
					PRINTFORML ┃말도 안 돼, 이 무슨 일인가 　　　　　　　　　┃
					PRINTFORML ┃사람의 자식의 노랫소리가 우리 영혼을 좀먹다니┃
					PRINTFORML ┃역시 저 계집아이, 살려둘 수는 없다 　　　　┃
					PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
				RESETCOLOR 
					イベントフラグ:55:6 = 2
			;上記を一度聞いている
			ELSEIF イベントフラグ:55:6 == 2
				SETCOLOR 0XDC143C
					PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
					PRINTFORML ┃오오, 위대하신 가슴(아버지)이시여 　　　　　┃
					PRINTFORML ┃찌ー찌……　　　　　　　　　　　　　　　　　┃
					PRINTFORML ┃오오오, 내 영혼을 건드리지 마라……!! 　　　┃
					PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
				RESETCOLOR 
					イベントフラグ:55:6 = 3
			;それ以降（発生しない）
			ELSEIF イベントフラグ:55:6 == 3
			
			ENDIF
		ENDIF
	ENDIF
ELSE
ENDIF
;=================================================
; EVENT_BATTLE_START_EVENT55_4
;=================================================
@EVENT_BATTLE_START_EVENT55

;PRINTFORMW 戦闘開始処理
;このイベントの戦闘中かつハードモードならあなたに火炎ガーキル(される）状態を付与する。
IF イベントフラグ:55:0 == 4 && イベントフラグ:55:4 > 0 && イベントフラグ:55:5 == 1
	;PRINTFORMW ガーキル処理開始
	;バステ処理フラグをリセット
	SIF イベントフラグ:55:8 == 1  
		イベントフラグ:55:8 = 0  

	;あなたが死んでなければ
	IF CFLAG:MASTER:상태이상 != GET_STATE_NUM("DYING")
		;あなたを火炎ガードキルです
		CFLAG:MASTER:화염가드킬 = 999
		;バフの付与に成功したならフラグを立てておく
		SIF イベントフラグ:55:8 == 0
			イベントフラグ:55:8 = 1
	ENDIF
	
	;バフ付与に成功したらメッセージ表示
	IF イベントフラグ:55:8 == 1 
		PRINTFORM %CALLNAME:MASTER%은 이 전투 동안, 
		SETCOLOR 0xd76c00
			PRINTFORM 화염가드킬 상태
		RESETCOLOR
		PRINTFORMW 가 되었다!
	ELSEIF イベントフラグ:55:8 == 0
		
	ELSE
		
	ENDIF
ENDIF

