; EVENT_BATTLE_TURNTOP_EVENT55_4
;=================================================
@EVENT_BATTLE_TURNTOP_EVENT55
IF FLAG:경과턴수 > 0
	;PRINTFORMW ターン開始処理
	;このイベントの戦闘中かつハードモードならあなたに火炎ガーキル(される）状態を付与する。
	IF イベントフラグ:55:0 == 4 && イベントフラグ:55:4 > 0 && イベントフラグ:55:5 == 1
		;PRINTFORMW ガーキル処理開始
		SIF イベントフラグ:55:8 == 1  
			イベントフラグ:55:8 = 0  

		;あなたが死んでなければ
		IF CFLAG:MASTER:상태이상 != GET_STATE_NUM("DYING")
			;あなたを火炎ガードキルです
			CFLAG:MASTER:화염가드킬 = 999
			;バフの付与に成功したならフラグを立てておく
			SIF イベントフラグ:55:8 == 0
				イベントフラグ:55:8 = 1
		ENDIF

		;バフ付与に成功したらメッセージ表示
		IF イベントフラグ:55:8 == 1 && FLAG:경과턴수 == 0
			PRINTFORM %CALLNAME:MASTER%은 이 전투 동안, 
			SETCOLOR 0xd76c00
				PRINTFORM 화염가드킬 상태
			RESETCOLOR
			PRINTFORMW 가 되었다!
		ELSE

		ENDIF
	ENDIF
ENDIF
