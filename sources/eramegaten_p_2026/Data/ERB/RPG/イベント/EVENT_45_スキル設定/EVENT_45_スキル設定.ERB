@COST_KEISAN
#DIM DYNAMIC スキル数
#DIM DYNAMIC 順番

イベントフラグ:45:16 = 0
イベントフラグ:45:19 = 1
;威力分の計算
IF イベントフラグ:45:14 == 0 || イベントフラグ:45:14 == 1
	イベントフラグ:45:16 = (ABS(イベントフラグ:45:12) / 30) + (ABS(イベントフラグ:45:12) * ABS(イベントフラグ:45:12) / 5000)
ENDIF
IF イベントフラグ:45:14 == 0
	イベントフラグ:45:16 += イベントフラグ:45:7
ENDIF

;上の時点でコストを0に出来る問題対策
SIF イベントフラグ:45:16 == 0
	イベントフラグ:45:16 ++

;状態異常分の加算
IF イベントフラグ:45:11 > 0 && (イベントフラグ:45:14 == 0 || イベントフラグ:45:14 == 2)
	IF イベントフラグ:45:11 == 13
		IF イベントフラグ:45:14 == 2
			イベントフラグ:45:19 = 16 * イベントフラグ:45:13
		ELSEIF イベントフラグ:45:14 == 0
			イベントフラグ:45:19 = 16 * イベントフラグ:45:10
		ENDIF
	ELSEIF イベントフラグ:45:11 == 14
		IF イベントフラグ:45:14 == 2
			イベントフラグ:45:19 = 20 * イベントフラグ:45:13
		ELSEIF イベントフラグ:45:14 == 0
			イベントフラグ:45:19 = 20 * イベントフラグ:45:10
		ENDIF
	ELSE
		IF イベントフラグ:45:14 == 2
			イベントフラグ:45:19 = 8 * イベントフラグ:45:13
		ELSEIF イベントフラグ:45:14 == 0
			イベントフラグ:45:19 = 8 * イベントフラグ:45:10
		ENDIF
	ENDIF
	イベントフラグ:45:19 /= 100
	イベントフラグ:45:16 += イベントフラグ:45:19
	イベントフラグ:45:19 = 1
ENDIF

IF (イベントフラグ:45:14 == 0 && イベントフラグ:45:12) || (イベントフラグ:45:14 == 2 && イベントフラグ:45:13)
	;万能属性補正　
	IF イベントフラグ:45:14 == 0
		IF イベントフラグ:45:8 == 17
			イベントフラグ:45:16 *= 150
		ENDIF
	ENDIF
	IF イベントフラグ:45:14 == 2
		IF イベントフラグ:45:12 == 17
			イベントフラグ:45:16 += 125
		ENDIF
	ELSEIF イベントフラグ:45:14 == 0 && イベントフラグ:45:10 > 0 && イベントフラグ:45:11 > 0
		IF イベントフラグ:45:9 == 17
			イベントフラグ:45:16 += 125
		ENDIF
	ENDIF
	イベントフラグ:45:16 /= 100
ENDIF

;変動させる能力によるコスト加算
IF イベントフラグ:45:14 == 3
	イベントフラグ:45:19 = 0
	IF イベントフラグ:45:13 == 2
		SIF イベントフラグ:45:8 > 0
			イベントフラグ:45:16 += 4*イベントフラグ:45:8
			イベントフラグ:45:19 += イベントフラグ:45:8
		SIF イベントフラグ:45:9 > 0
			イベントフラグ:45:16 += 4*イベントフラグ:45:9
			イベントフラグ:45:19 += イベントフラグ:45:9
		SIF イベントフラグ:45:10 > 0
			イベントフラグ:45:16 += 4*イベントフラグ:45:10
			イベントフラグ:45:19 += イベントフラグ:45:10
		SIF イベントフラグ:45:11 > 0
			イベントフラグ:45:16 += 4*イベントフラグ:45:11
			イベントフラグ:45:19 += イベントフラグ:45:11
		SIF イベントフラグ:45:12 > 0
			イベントフラグ:45:16 += 4*イベントフラグ:45:12
			イベントフラグ:45:19 += イベントフラグ:45:12
		イベントフラグ:45:16 *= 100+25*(イベントフラグ:45:19-1)
		イベントフラグ:45:16 /=  100
	ELSE
		SIF イベントフラグ:45:8 < 0
			イベントフラグ:45:16 += 5*ABS(イベントフラグ:45:8)
			イベントフラグ:45:19 += ABS(イベントフラグ:45:8)
		SIF イベントフラグ:45:9 < 0
			イベントフラグ:45:16 += 5*ABS(イベントフラグ:45:9)
			イベントフラグ:45:19 += ABS(イベントフラグ:45:9)
		SIF イベントフラグ:45:10 < 0
			イベントフラグ:45:16 += 5*ABS(イベントフラグ:45:10)
			イベントフラグ:45:19 += ABS(イベントフラグ:45:10)
		SIF イベントフラグ:45:11 < 0
			イベントフラグ:45:16 += 5*ABS(イベントフラグ:45:11)
			イベントフラグ:45:19 += ABS(イベントフラグ:45:11)
		SIF イベントフラグ:45:12 < 0
			イベントフラグ:45:16 += 5*ABS(イベントフラグ:45:12)
			イベントフラグ:45:19 += ABS(イベントフラグ:45:12)
		イベントフラグ:45:16 *= 100+50*(イベントフラグ:45:19-1)
		イベントフラグ:45:16 /=  100
	ENDIF
	イベントフラグ:45:19 = 1
ENDIF

;명중보정
IF イベントフラグ:45:14 == 0
;	IF イベントフラグ:45:3 > 100
;		イベントフラグ:45:16 *= イベントフラグ:45:3
;	ELSE
;		イベントフラグ:45:16 *= (100 + イベントフラグ:45:3)
;		イベントフラグ:45:16 /=  2
;	ENDIF
	イベントフラグ:45:16 *= (100 + イベントフラグ:45:3)
	イベントフラグ:45:16 /=  2
	イベントフラグ:45:16 /= 100
ENDIF

;上の時点でコストを0に出来る問題対策
SIF イベントフラグ:45:16 == 0
	イベントフラグ:45:16 ++

;射程補正　全体攻撃ではボーナス無し
IF イベントフラグ:45:15 != 3 && イベントフラグ:45:15 != 4
	IF イベントフラグ:45:0 == 1
		イベントフラグ:45:16 *= 2
		イベントフラグ:45:16 /= 3
	ELSEIF イベントフラグ:45:0 == 2
		イベントフラグ:45:16 *= 3
		イベントフラグ:45:16 /= 4
	ENDIF
ENDIF
;上の時点でコストを0に出来る問題対策
SIF イベントフラグ:45:16 == 0
	イベントフラグ:45:16 ++

;攻撃範囲による補正　敵味方全体はコスト減少
;既存の普通のスキルと比べて滅茶苦茶コスパ良かったから見直し
IF イベントフラグ:45:15 == 2
	イベントフラグ:45:16 *= 2
;	イベントフラグ:45:16 *= 4
;	イベントフラグ:45:16 /= 3
ELSEIF イベントフラグ:45:15 == 3
	イベントフラグ:45:16 *= 3
;	イベントフラグ:45:16 /= 2
ELSEIF イベントフラグ:45:15 == 4
	イベントフラグ:45:16 *= 3
	イベントフラグ:45:16 /= 4
ELSEIF イベントフラグ:45:15 == 5
	イベントフラグ:45:16 *= 2
ENDIF

;SIF イベントフラグ:45:16 == 0
;	イベントフラグ:45:16 ++

;連続攻撃補正
IF イベントフラグ:45:14 == 0
	IF イベントフラグ:45:15 > 5
		イベントフラグ:45:16 *= (イベントフラグ:45:5 + イベントフラグ:45:6*2 + イベントフラグ:45:4)
		イベントフラグ:45:16 /= 4
	ELSE
		イベントフラグ:45:16 *= (イベントフラグ:45:5 + イベントフラグ:45:6)
		イベントフラグ:45:16 /= 2
	ENDIF
ENDIF

;-------------------------------
;セットしたスキル数が増えるほどコスパが悪くなる
;カジャ系の2つ以上の能力が上がるスキル(パワーブレスやドラゴンハッスル）のコストを参考にして設定
IF イベントフラグ:45:14 == 0
	スキル数 = 2
ELSEIF イベントフラグ:45:14 == 3
	スキル数 = 7
ELSEIF イベントフラグ:45:14 == 2
	スキル数 = 10
ELSEIF イベントフラグ:45:14 == 1
	スキル数 = 11
ELSEIF イベントフラグ:45:14 == 4
	スキル数 = 12
ENDIF

イベントフラグ:45:19 = 0
FOR 順番, 1, (スキル数+1)
	IF イベントフラグ:45:順番 > 0 && イベントフラグ:45:順番 != (3900 + イベントフラグ:45:14)
		CALL GET_SKILL_PROP, "SKILL_COST", イベントフラグ:45:順番
		イベントフラグ:45:16 += RESULT
		イベントフラグ:45:19 += 1
	ENDIF
NEXT
イベントフラグ:45:16 *= 100+(20*(イベントフラグ:45:19))
イベントフラグ:45:16 /=  100
イベントフラグ:45:19 = 1
;-----------------------------

;SIF イベントフラグ:45:16 == 0
;	イベントフラグ:45:16 ++


;속도보정
SIF イベントフラグ:45:18 > 0
	イベントフラグ:45:16 += イベントフラグ:45:18


;HPを支払う場合は二倍
;正直コスト2倍は軽すぎる気がしないでもけど保留
IF イベントフラグ:45:17 == 2
	イベントフラグ:45:16 *= 2
ENDIF

