@SHOW_MAKE_ORIGINAL_SKILL
#DIM DYNAMIC 계승타입
#DIM DYNAMIC L_I
#DIM DYNAMIC スキル番号
#DIM DYNAMIC ページ
$ORIGINAL_SKILL_TYPE
DRAWLINE
PRINTFORM  [0] 검격
PRINTFORM  [1] 비구
PRINTFORM  [2] 타격
PRINTFORML  [3] 전술
PRINTFORM  [4] 회복
PRINTFORM  [5] 지원
PRINTFORML  [6] 방어
PRINTFORM  [7] 화염
PRINTFORM  [8] 빙결
PRINTFORM  [9] 전격
PRINTFORML [10] 충격
PRINTFORM [11] 신경
PRINTFORM [12] 정신
PRINTFORM [13] 파마
PRINTFORML [14] 주살
PRINTFORM [15] 지변
PRINTFORM [16] 수격
PRINTFORM [17] 질풍
PRINTFORML [18] 중력
PRINTFORM [19] 핵열
PRINTFORML [20]만능
PRINTFORML [21]외부작품
$INPUT_LOOP_ORIGINAL_SKILL_TYPE
INPUT
IF RESULT > -1 && RESULT < 21
	계승타입 = RESULT
	ページ = 1
	$ORIGINAL_SKILL_TYPE_PAGE
	PRINTFORML [0] 無
	FOR L_I, 1, 2100
		SIF (ページ == 1 && L_I > 계승타입*ページ*100+50) || (ページ == 2 && L_I < 계승타입*100+51)
			CONTINUE
		CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_I, -1
		SIF 계승타입 != RESULT
			CONTINUE
		CALL GET_SKILL_PROP, "SKILL_EFECT", L_I, -1
		SIF RESULT < 1
			CONTINUE
		CALL GET_SKILL_PROP, "敵専用", L_I, -1
		SIF RESULT == 1
			CONTINUE
		CALL GET_SKILL_PROP, "ロール専用", L_I, -1
		SIF RESULT == 1
			CONTINUE
		CALL GET_SKILL_PROP, "SKILL_NAME", L_I
			PRINTFORM [{L_I}] %RESULTS,26,LEFT%
	NEXT
;----------------------
ELSEIF RESULT == 21
	$ORIGINAL_SKILL_TYPE_EXTRA
	DRAWLINE
	PRINTFORM  [0] 검격
	PRINTFORM  [1] 비구
	PRINTFORM  [2] 타격
	PRINTFORML  [3] 전술
	PRINTFORM  [4] 회복
	PRINTFORM  [5] 지원
	PRINTFORML  [6] 방어
	PRINTFORM  [7] 화염
	PRINTFORM  [8] 빙결
	PRINTFORM  [9] 전격
	PRINTFORML [10] 충격
	PRINTFORM [11] 신경
	PRINTFORM [12] 정신
	PRINTFORM [13] 파마
	PRINTFORML [14] 주살
	PRINTFORM [15] 지변
	PRINTFORM [16] 수격
	PRINTFORM [17] 질풍
	PRINTFORML [18] 중력
	PRINTFORM [19] 핵열
	PRINTFORML [20]만능
	PRINTFORML [21]돌아간다
	PRINTFORML [5002] 스킬편성으로 돌아간다
	$INPUT_LOOP_ORIGINAL_SKILL_TYPE_EXTRA
	INPUT
	IF RESULT >= 0 && RESULT <= 20
		계승타입 = RESULT
		FOR L_I, 2501, 3999
			SIF L_I > 2100 && L_I < 2500
				CONTINUE
			SIF L_I > 2600 && L_I < 2698
				CONTINUE
			SIF L_I > 3000 && L_I < 3500
				CONTINUE
			SIF L_I >= 3900 && L_I <= 3903
				CONTINUE
			CALL GET_SKILL_PROP, "SUCCESSION_TYPE", L_I, -1
				SIF 계승타입 != RESULT
					CONTINUE
			CALL GET_SKILL_PROP, "SKILL_EFECT", L_I, -1
			SIF RESULT < 1
				CONTINUE
			CALL GET_SKILL_PROP, "敵専用", L_I, -1
			SIF RESULT == 1
				CONTINUE
			CALL GET_SKILL_PROP, "SKILL_NAME", L_I
				PRINTFORM [{L_I}] %RESULTS,26,LEFT%
		NEXT
	;----------------------
	ELSEIF RESULT == 21
		GOTO ORIGINAL_SKILL_TYPE
	ELSEIF RESULT == 5002
		RETURN 0
	ELSE
		GOTO INPUT_LOOP_ORIGINAL_SKILL_TYPE_EXTRA
	ENDIF
;	$END
ELSE
	GOTO INPUT_LOOP_ORIGINAL_SKILL_TYPE
ENDIF
PRINTFORML
PRINTFORM [5003] 이전페이지
PRINTFORML [5004] 다음페이지
PRINTFORM [5000] 돌아간다（여신전생）
PRINTFORML [5001] 돌아간다（외부작품）
PRINTFORML [5002] 스킬편성으로 돌아간다
$INPUT_LOOP_MAKE_ORIGINAL_SKILL_CHOICE
INPUT
IF RESULT == 5000
	GOTO ORIGINAL_SKILL_TYPE
ELSEIF RESULT == 5001
	GOTO ORIGINAL_SKILL_TYPE_EXTRA
ELSEIF RESULT == 5002
;	JUMP SHOPCOM_EVENT_45
	RETURN 0
ELSEIF RESULT == 5003
	IF ページ > 1
		ページ -= 1
	ENDIF
	GOTO ORIGINAL_SKILL_TYPE_PAGE
ELSEIF RESULT == 5004
	IF ページ < 2
		ページ += 1
	ENDIF
	GOTO ORIGINAL_SKILL_TYPE_PAGE
ELSE
	スキル番号 = RESULT
	$INPUT_LOOP_SKILL_SELECT
	IF スキル番号 != 0
		CALL GET_SKILL_PROP, "SKILL_EXPLAIN", スキル番号, -1
	ENDIF
	IF スキル番号 > 0
		CALL GET_SKILL_PROP, "SKILL_NAME", スキル番号
		PRINTFORML 【%RESULTS%】이것으로 좋습니까？
	ELSEIF スキル番号 == 0
		PRINTFORML  【】이것으로 좋습니까？
	ENDIF
	PRINTL [0]네
	PRINTL [1]아니오
	INPUT
	IF RESULT < 0 || RESULT > 1
		GOTO INPUT_LOOP_SKILL_SELECT
	ELSEIF RESULT == 0
		RETURN スキル番号
	ELSEIF RESULT == 1
		GOTO ORIGINAL_SKILL_TYPE
	ENDIF
;	$END
ENDIF
