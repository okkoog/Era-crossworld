;━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━
;たぶんAIはここでいいと思う。
;特殊思考パターン

;　やりたいこと
;　可奈美はツインスラッシュor一文字斬りor低確率でセイントアタック→히트웨이브→大地の壁か畳返し、を繰り返す。ワンモアは必ずヒートウェイブ
;　可奈美はHPが減っても行動を変えない。戸惑ってる娘だし。
;　姫和はイナズマ突き→クイックスピア、ただし3の倍数のターンはイナズマ突きorクイックスピアorライトスピアor光の壁
;　ワンモアは6割かすみ斬り、4割セイントアタック
;　ただしHPが50%以下になると行動が変わり、クイックバスターやライトバスターを使うし、ワンモアは絶対にかすみ斬りなど行動が変わる



;━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━
@SET_ACTION_衛藤可奈美（初回）, ARG
#DIM 可奈美のこうげき
#DIM 可奈美の八幡力攻撃フラグ

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1


;━━━━━━━━━━
;
;　絶対に出ない選択肢
IF 0
	PRINTFORMW 절대로 출력되지 않는 선택지입니다.
	PRINTFORMW ELSEIF가 많을 경우 처음에 이걸 만들어 두면 편할지도.
;
;　ワンモアの場合
ELSEIF CFLAG:ARG:１more플래그 > 0
	CFLAG:ARG:입력행동 = [[스킬:히트웨이브]]
	;特に　可奈美のこうげき　に影響はしない
;
;　偶数ターンで、一回以上攻撃していて、八幡力攻撃フラグがたっていない時の行動。つまり二ターン目だけの行動
;　なくても二ターン目はヒートウェイブしてくれそうな気もする
ELSEIF FLAG:경과턴수 % 2 == 0 && CFLAG:ARG:행동한횟수 >= 1 && 可奈美の八幡力攻撃フラグ == 0
	CFLAG:ARG:입력행동 = [[스킬:히트웨이브]]
	可奈美の八幡力攻撃フラグ++
	可奈美のこうげき ++
;
;　最初の行動
;　40%の確率で一文字斬り、40%の確率でツインスラッシュ、20%の確率でセイントアタック
;　表記としてどうなんだという気しますが、ここだけRAND:100とかLOCALとか使うと私が後でわからなくなりそう
ELSEIF 可奈美のこうげき == 0
		IF RAND:5 == 0
			CFLAG:ARG:입력행동 = [[스킬:일문자베기]]
		ELSEIF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:일문자베기]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:트윈슬래시]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:트윈슬래시]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:세인트어택]]
		ENDIF	
	可奈美のこうげき ++
;
;　次の行動
ELSEIF 可奈美のこうげき == 1
	CFLAG:ARG:입력행동 = [[스킬:히트웨이브]]
	可奈美のこうげき ++
;
;　三回目の行動、これでまた最初に戻る
ELSEIF 可奈美のこうげき == 2
		IF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:다다미반환]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:대지의벽]]
		ENDIF	
		可奈美のこうげき = 0
ENDIF
;━━━━━━━━━━




;行動未決定時のおまじない
SIF CFLAG:ARG:입력행동 == -1
	CALL ランダム行動 , ARG
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1
;━━━━━━━━━━
;━━━━━━━━━━━━━━━━━━━━







;━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━
@SET_ACTION_十条姫和（初回）, ARG

;━━━━━
#DIM 姫和のこうげき
;━━━━━

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

;
;━━━━━━━━━━
;;━━━━━

;　絶対に出ない選択肢
IF 0
	PRINTFORMW 절대로 출력되지 않는 선택지입니다.
	PRINTFORMW ELSEIF가 많을 경우 처음에 이걸 만들어 두면 편할지도.
;
;━━━━━
;　HP50%以下で行動が変わる
ELSEIF 現HP割合(ARG) <= 50
	;　ワンモアの場合
	IF CFLAG:ARG:１more플래그 > 0
		CFLAG:ARG:입력행동 = [[스킬:안개베기]]
		;特に　姫和のこうげき　に影響はしない
	;
	;3の倍数ターンの行動の次の行動はこれになる
	ELSEIF 姫和のこうげき == 1
		IF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:안개베기]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:퀵버스터]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:라이트블래스트]]
		ENDIF	
		;3の倍数ターン完了で姫和のこうげき　を0に戻す
		姫和のこうげき = 0
	;
	;その次のターンはこれになる
	ELSEIF 姫和のこうげき == 0
		IF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:번개찌르기]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:안개베기]]
		ENDIF	
		姫和のこうげき ++
	;
	;3の倍数ターンでも最初の行動でもない何かだったらこれになる
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:퀵버스터]]
		姫和のこうげき ++
	ENDIF
;━━━━━
;
;━━━━━
;　ワンモアの場合
ELSEIF CFLAG:ARG:１more플래그 > 0
		;40%の割合で、ワンモアの際セイントアタックを放ってくれる
		IF RAND:5 == 0
			CFLAG:ARG:입력행동 = [[스킬:안개베기]]
		ELSEIF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:안개베기]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:안개베기]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:세인트어택]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:세인트어택]]
		ENDIF	
	;特に　姫和のこうげき　に影響はしない
;
;3の倍数ターンかどうかを見る（0割る3の余りは0なのだ？　行動回数も見ないと最初からこれを使うっぽい）。ついでに最初の行動ではこの選択肢は選ばない
ELSEIF FLAG:경과턴수 % 3 == 0 && CFLAG:ARG:행동한횟수 >= 1 && 姫和のこうげき == 1
	;そうであるなら二段突きorクイックスピアor光の壁orライトスピア
		IF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:이단찌르기]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:퀵스피어]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:빛의벽]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:라이트스피어]]
		ENDIF	
	;3の倍数ターン完了で姫和のこうげき　を0に戻す
	姫和のこうげき = 0
;
;最初の行動と、3の倍数ターンの行動の次の行動はこれになる
ELSEIF 姫和のこうげき == 0
	CFLAG:ARG:입력행동 = [[스킬:번개찌르기]]
	;で、その次の行動はこのELSEIFではない何かになる
	姫和のこうげき ++
;
;3の倍数ターンでも最初の行動でもない何かだったらクイックスピアぶっぱ
ELSE
	CFLAG:ARG:입력행동 = [[스킬:퀵스피어]]
	姫和のこうげき ++
ENDIF
;━━━━━

;━━━━━━━━━━



;行動未決定時のおまじない
SIF CFLAG:ARG:입력행동 == -1
	CALL ランダム行動 , ARG
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1