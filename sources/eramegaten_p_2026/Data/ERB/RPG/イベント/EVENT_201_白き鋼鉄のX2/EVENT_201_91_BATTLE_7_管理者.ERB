@EVENT_BATTLE_TURNSTART_EVENT_201_7_マザー
#DIM 進行度
#DIM DYNAMIC COPEN
SIF 進行度 == 30
	RETURN 0
SIF FINDCHARA_B([[キャラ:아큐라_X]])  != 2
	RETURN 0
COPEN = RESULT:1
SELECTCASE 進行度
	CASE 0
		SETCOLOR COLOR("FRIEND")
		BTL_KOJO_RESULTS:0 = 貴様の遺したデータを見た。何故、新人類を滅ぼした？
		BTL_KOJO_RESULTS:1 = 人類の復興には、協力が最善の手だったはずだ
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		
		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = 何故、ですか。その疑問が湧くのも、
		BTL_KOJO_RESULTS:1 = アレらについて知らなければ仕方のないことでしょうね
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("マザー")
		
		BTL_KOJO_RESULTS:0 = 新人類は、天使たちによって
		BTL_KOJO_RESULTS:1 = 悪魔化因子《デモニックジーン》を組み込まれていたのです
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("マザー")
		
		進行度 = 10
		RESETCOLOR
	CASE 10
		CALL SET_RORO_KOJO_FLAG, COPEN
		BTL_KOJO_RESULTS:0 = 悪魔化因子を、人間に……？
		BTL_KOJO_RESULTS:1 = 一体何の目的で、そんなことを……
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		
		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = 신인류가 지혜를 얻어, 자신들의 손을 벗어날 상황을 고려했던 것이겠지요
		BTL_KOJO_RESULTS:1 = 특정 조건을 만족한 순간, 악마가 되도록 프로그래밍되어 있었습니다
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("マザー")
		
		BTL_KOJO_RESULTS:0 = 말하자면, 팔에서 총을 돋아나게 한…… 아니, 전신이 흉기인 괴물
		BTL_KOJO_RESULTS:1 = 그런 것이―― 마스터가 정의하는 『인간』일 리가 없습니다!
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("マザー")
		
		進行度 = 20
		RESETCOLOR
	CASE 20
		SETCOLOR COLOR("FRIEND")
		BTL_KOJO_RESULTS:0 = ……자신의 과거를, 들이대어지고 있는 것 같군
		BTL_KOJO_RESULTS:1 = 어느 세계의 나든, 별반 다르지 않다는 건가
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		
		CALL SET_RORO_KOJO_FLAG, COPEN
		BTL_KOJO_RESULTS:0 = 과거의 너는, 그랬을지도 몰라……
		BTL_KOJO_RESULTS:1 = 하지만 지금의 너는 다르잖아?
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		BTL_KOJO_RESULTS:0 = 가자, 아큐라 군. 코하쿠 짱을 구하는 거야
		BTL_KOJO_RESULTS:1 = 뒤돌아보는 건 그 뒤에 하자
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		
		SETCOLOR COLOR("FRIEND")
		BTL_KOJO_RESULTS:0 = 그래……!
		TSTR:전투구상캐릭터화상어드레스 '= "アキュラ_X_" + CONVERT_FACE_ADDRESS_アキュラ("ブリッツシフト")
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		
		進行度 = 30
		RESETCOLOR
ENDSELECT

