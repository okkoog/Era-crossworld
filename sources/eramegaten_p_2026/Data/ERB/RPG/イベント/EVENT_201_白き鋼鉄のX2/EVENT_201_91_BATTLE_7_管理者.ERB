	IF GET_カジャンダ_MIN(GET_RANDOM_FRIEND()) > -32 || GET_カジャンダ_MIN(GET_RANDOM_FRIEND()) > -32
		CALL SET_ACTION_SKILL, ARG, [[스킬:랜더마이저]]
	ELSEIF GET_カジャンダ_MAX(GET_RANDOM_FRIEND()) >= 16 || GET_カジャンダ_MAX(GET_RANDOM_FRIEND()) >= -16
		CALL SET_ACTION_SKILL, ARG, [[스킬:데・카쟈]]
