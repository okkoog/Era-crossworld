@SET_ACTION_アタックコードシュレッド, ARG
;どうせラスボスの前座だしそこまでこだわらなくてもいいかなと思う
#LOCALSIZE 1
#LOCALSSIZE 2
IF CFLAG:ARG:800 == 2
	CALL SET_ACTION_SKILL, ARG, [[스킬:X-ROSS DISASTER]]
	CFLAG:ARG:800 = 3
ELSEIF CFLAG:ARG:１more플래그 > 0
	IF RAND:2 && !CFLAG:ARG:수호의방패
		CALL SET_ACTION_SKILL, ARG, [[스킬:수호의방패]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:라스타캔디]]
	ENDIF
ELSEIF CFLAG:ARG:행동한횟수 == 0
	;ガンヴォルトあるある：HPが1/3切ったらSPスキル使う　5Tに1回打ってくるぞ
	IF CFLAG:ARG:800 && SKILLGAGE_D_GET(ARG, [[스킬:X-ROSS DISASTER]]) == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:X-ROSS DISASTER]]
	ELSE
		IF FLAG:경과턴수 % 2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:역테트라칸]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:역마가라칸]]
		ENDIF
	ENDIF
ELSE
	SELECTCASE RAND:7
		CASE 0
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "アイアンファング")
		CASE 1
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "バンテージライン") 
		CASE 2
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "テイルバンカー")
		CASE 3
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ワイドサーキット")
		CASE 4
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "アバランチソード")
		CASE 5
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "プリズムブレイク")
		CASE 6
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ハイドロザッパー")
	ENDSELECT
ENDIF

@EVENT_BATTLE_DYING_EVENT_201_7_マザー, L_T, L_P, L_SKIP
#DIM DYNAMIC L_T
#DIM DYNAMIC L_P
#DIM DYNAMIC L_SKIP
IF L_T == GET_ENEMY("マザー") && CFLAG:L_T:800 == 0
	TSTR:스킬메시지추가 = %CALLNAME:L_T%は立ち上がった！!
	
	CFLAG:L_T:상태이상 = GET_STATE_NUM("GOOD")
	BASE:L_T:ＨＰ = MAXBASE:L_T:ＨＰ / 3
	CFLAG:L_T:800 = 1
	CFLAG:L_T:공격대상제외_ACT = 1
ENDIF

@EVENT_BATTLE_ACTEND_EVENT_201_7_マザー
