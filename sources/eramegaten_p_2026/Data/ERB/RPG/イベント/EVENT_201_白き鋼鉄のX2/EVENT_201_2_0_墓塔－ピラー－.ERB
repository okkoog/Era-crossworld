@SHOPCOM_EVENT_201_2
#DIM DYNAMIC L_ACURA
#DIMS DYNAMIC SHOW_LINE
#DIMS DYNAMIC TEMPS
#DIM DYNAMIC LCOUNT, 2
#DIMS DYNAMIC L_SPRITE
#DIMS DYNAMIC L_SPRITENAME
#DIM DYNAMIC GID
#DIM CONST FACE_TABLE = [[キャラ:데이사이트_X2]], [[キャラ:베스파_X2]], [[キャラ:입실론_X2]], [[キャラ:오토크롬_X2]], [[キャラ:아큐라_X]], [[キャラ:브리게이드_X2]], [[キャラ:헤일_X2]], [[キャラ:슬러그_X2]]
#DIMS CONST STAGE_TABLE = "", "입구 게이트", "화산 블록", "밀림 블록", "상층 플로어", "연구소 블록", "공장 블록", "한랭지 블록", "우주 블록"
#DIM DYNAMIC STAGE_SELECT_ABLE, 20
#DIMS DYNAMIC L_SHOW_STAT, 20
#DIM DYNAMIC L_PLACE_NO, 20
#DIMS DYNAMIC L_BUTTON, 20
#DIM DYNAMIC L_SELECTABLE_ARRAY, 100
VARSET L_SELECTABLE_ARRAY
VARSET L_SHOW_STAT
REDRAW 0
L_ACURA = GETCHARA([[キャラ:아큐라_X]])
FOR LCOUNT, 0, VARSIZE("FACE_TABLE")
	SELECTCASE FACE_TABLE:LCOUNT
		CASE [[キャラ:데이사이트_X2]]
			IF !FLAG_白き鋼鉄のX2_入り口クリア
				L_SHOW_STAT:LCOUNT '= "白抜き"
			ELSE
				IF FLAG_白き鋼鉄のX2_炎獄クリア
					L_SHOW_STAT:LCOUNT '= "グレースケール"
				ELSE
					L_BUTTON:LCOUNT '= TOSTR(FINDELEMENT(STAGE_TABLE, "화산 블록"))
					L_SELECTABLE_ARRAY:(FINDELEMENT(STAGE_TABLE, "화산 블록")) = 1
				ENDIF
			ENDIF
			L_PLACE_NO:LCOUNT = FINDELEMENT(STAGE_TABLE, "화산 블록")
		CASE [[キャラ:베스파_X2]]
			IF !FLAG_白き鋼鉄のX2_入り口クリア
				L_SHOW_STAT:LCOUNT '= "白抜き"
			ELSE
				IF FLAG_白き鋼鉄のX2_機蜂クリア
					L_SHOW_STAT:LCOUNT '= "グレースケール"
				ELSE
					L_BUTTON:LCOUNT '= TOSTR(FINDELEMENT(STAGE_TABLE, "밀림 블록"))
					L_SELECTABLE_ARRAY:(FINDELEMENT(STAGE_TABLE, "밀림 블록")) = 1
				ENDIF
			ENDIF
			L_PLACE_NO:LCOUNT = FINDELEMENT(STAGE_TABLE, "밀림 블록")
		CASE [[キャラ:입실론_X2]]
			IF !FLAG_白き鋼鉄のX2_炎獄クリア || !FLAG_白き鋼鉄のX2_機蜂クリア
				L_SHOW_STAT:LCOUNT '= "白抜き"
			ELSE
				IF FLAG_白き鋼鉄のX2_超越クリア
					L_SHOW_STAT:LCOUNT '= "グレースケール"
				ELSE
					L_BUTTON:LCOUNT '= TOSTR(FINDELEMENT(STAGE_TABLE, "상층 플로어"))
					L_SELECTABLE_ARRAY:(FINDELEMENT(STAGE_TABLE, "상층 플로어")) = 1
				ENDIF
			ENDIF
			L_PLACE_NO:LCOUNT = FINDELEMENT(STAGE_TABLE, "상층 플로어")
		CASE [[キャラ:오토크롬_X2]]
			IF !FLAG_白き鋼鉄のX2_超越クリア
				L_SHOW_STAT:LCOUNT '= "白抜き"
			ELSE
				IF FLAG_白き鋼鉄のX2_光芒クリア
					L_SHOW_STAT:LCOUNT '= "グレースケール"
				ELSE
					L_BUTTON:LCOUNT '= TOSTR(FINDELEMENT(STAGE_TABLE, "연구소 블록"))
					L_SELECTABLE_ARRAY:(FINDELEMENT(STAGE_TABLE, "연구소 블록")) = 1
				ENDIF
			ENDIF
			L_PLACE_NO:LCOUNT = FINDELEMENT(STAGE_TABLE, "연구소 블록")
		CASE [[キャラ:아큐라_X]]
			IF !FLAG_白き鋼鉄のX2_入り口クリア
				L_BUTTON:LCOUNT '= TOSTR(FINDELEMENT(STAGE_TABLE, "입구 게이트"))
				L_SELECTABLE_ARRAY:(FINDELEMENT(STAGE_TABLE, "입구 게이트")) = 1
			ENDIF
			L_PLACE_NO:LCOUNT = FINDELEMENT(STAGE_TABLE, "입구 게이트")
		CASE [[キャラ:브리게이드_X2]]
			IF !FLAG_白き鋼鉄のX2_超越クリア
				L_SHOW_STAT:LCOUNT '= "白抜き"
			ELSE
				IF FLAG_白き鋼鉄のX2_鋼獣クリア
					L_SHOW_STAT:LCOUNT '= "グレースケール"
				ELSE
					L_BUTTON:LCOUNT '= TOSTR(FINDELEMENT(STAGE_TABLE, "공장 블록"))
					L_SELECTABLE_ARRAY:(FINDELEMENT(STAGE_TABLE, "공장 블록")) = 1
				ENDIF
			ENDIF
			L_PLACE_NO:LCOUNT = FINDELEMENT(STAGE_TABLE, "공장 블록")
		CASE [[キャラ:헤일_X2]]
			IF !FLAG_白き鋼鉄のX2_超越クリア
				L_SHOW_STAT:LCOUNT '= "白抜き"
			ELSE
				IF FLAG_白き鋼鉄のX2_極寒クリア
					L_SHOW_STAT:LCOUNT '= "グレースケール"
				ELSE
					L_BUTTON:LCOUNT '= TOSTR(FINDELEMENT(STAGE_TABLE, "한랭지 블록"))
					L_SELECTABLE_ARRAY:(FINDELEMENT(STAGE_TABLE, "한랭지 블록")) = 1
				ENDIF
			ENDIF
			L_PLACE_NO:LCOUNT = FINDELEMENT(STAGE_TABLE, "한랭지 블록")
		CASE [[キャラ:슬러그_X2]]
			IF !FLAG_白き鋼鉄のX2_超越クリア
				L_SHOW_STAT:LCOUNT '= "白抜き"
			ELSE
				IF FLAG_白き鋼鉄のX2_飛刀クリア
					L_SHOW_STAT:LCOUNT '= "グレースケール"
				ELSE
					L_BUTTON:LCOUNT '= TOSTR(FINDELEMENT(STAGE_TABLE, "우주 블록"))
					L_SELECTABLE_ARRAY:(FINDELEMENT(STAGE_TABLE, "우주 블록")) = 1
				ENDIF
			ENDIF
			L_PLACE_NO:LCOUNT = FINDELEMENT(STAGE_TABLE, "우주 블록")
	ENDSELECT
NEXT
CALL DISPOSE_GRAPHICS, "QUEST"
FOR LCOUNT, 0, VARSIZE("FACE_TABLE")
	SIF L_SHOW_STAT:LCOUNT == ""
		CONTINUE
	L_SPRITE '= GET_FACE_BY_CSV(FACE_TABLE:LCOUNT)
	L_SPRITENAME '= L_SPRITE + "_" + L_SHOW_STAT:LCOUNT
	GID = QUEST_GIDNUM_START + LCOUNT
	QUEST_GID_SPRITENAME:LCOUNT '= L_SPRITENAME
	CALL CHANGE_COLOR_MATRIX, GID, L_SPRITE, L_SHOW_STAT:LCOUNT
	SPRITECREATE L_SPRITENAME, GID, 0, 0, GWIDTH(GID), GHEIGHT(GID)
NEXT
VARI SHOW_TABLE, 3, 5
SHOW_TABLE:0:0 = [[キャラ:오토크롬_X2]], [[キャラ:브리게이드_X2]], 0, [[キャラ:헤일_X2]], [[キャラ:슬러그_X2]]
SHOW_TABLE:1:0 = 0, 0, [[キャラ:입실론_X2]], 0, 0
SHOW_TABLE:2:0 = 0, [[キャラ:데이사이트_X2]], [[キャラ:아큐라_X]], [[キャラ:베스파_X2]], 0

VARI L_LINE = LINECOUNT
VARI L_CHARA_NO
VARI L_NO
VARI SELECT_PLACE
VARS BORDER_COLOR
WHILE 1
	VARSET SHOW_LINE
	CLEARLINE LINECOUNT - L_LINE
	DRAWLINE
	PRINTFORML 그레이브 필러
	DRAWLINE
	FOR LCOUNT:1, 0, 3
		FOR LCOUNT, 0, 5
			L_CHARA_NO = SHOW_TABLE:(LCOUNT:1):LCOUNT
			SIF L_CHARA_NO == 0
				CONTINUE
			L_NO = FINDELEMENT(FACE_TABLE, L_CHARA_NO)
			IF L_SHOW_STAT:L_NO != ""
				TEMPS '=  GET_FACE_BY_CSV(L_CHARA_NO) + "_" + L_SHOW_STAT:L_NO
			ELSE
				IF L_CHARA_NO == [[キャラ:아큐라_X]]
					TEMPS '= GET_FACE_BY_CHARA(GETCHARA(L_CHARA_NO))
				ELSE
					TEMPS '=  GET_FACE_BY_CSV(L_CHARA_NO)
				ENDIF
			ENDIF
			TEMPS '=  @"<img src = '%TEMPS%' height = '800'>"
			SIF L_BUTTON:L_NO != ""
				TEMPS '= SET_BUTTON_TAG(TEMPS, L_BUTTON:L_NO)
			IF SELECT_PLACE == L_PLACE_NO:L_NO
				BORDER_COLOR '= TOSTR_HTML(COLOR("p-green"))
			ELSE
				BORDER_COLOR '= TOSTR_HTML(COLOR("デフォルト"))
			ENDIF
			TEMPS '= @"<div xpos = '{LCOUNT * 1000}' ypos = '{(LCOUNT:1) * 1000}' width = '900' height = '900' border_width = '5px' border_color = '%BORDER_COLOR%' padding = '50'>" + TEMPS + "</div>"
			SHOW_LINE += TEMPS
		NEXT
	NEXT
	FOR LCOUNT, 1, VARSIZE("STAGE_TABLE")
		TEMPS '= @"[{LCOUNT,2}] %STAGE_TABLE:LCOUNT%"
		IF L_SELECTABLE_ARRAY:LCOUNT
			TEMPS '= SET_BUTTON_TAG(TEMPS, TOSTR(LCOUNT))
			SIF SELECT_PLACE == LCOUNT
				TEMPS '= SET_COLOR_TAG(TEMPS, "p-green")
		ELSE
			TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
		ENDIF
		SHOW_LINE += @"<div xpos = '5000' ypos = {LCOUNT * 100 - 100}>" + TEMPS + "</div>"
	NEXT
	SHOW_LINE += @"<div xpos = '0' ypos = '2900'>" + DRAWLINESTR + "</div>"
	TRYCCALLFORM EVENT_TITLE_TEXT_201_2_{SELECT_PLACE}
		SHOW_LINE += @"<div xpos = '0' ypos = '3000'>" + RESULTS + "</div>"
	CATCH
	ENDCATCH
	HTML_PRINT SHOW_LINE
	FOR LCOUNT, 0, GET_HEIGHTLENS() - 6
		PRINTL 
	NEXT
	DRAWLINE
	TEMPS '= "[0] 결정"
	IF SELECT_PLACE > 0
		TEMPS '= SET_BUTTON_TAG(TEMPS, "0")
		L_SELECTABLE_ARRAY:0 = 1
	ELSE
		TEMPS '= SET_COLOR_TAG(TEMPS, "gray")
		L_SELECTABLE_ARRAY:0 = 0
	ENDIF
	TEMPS += "　　　"
	TEMPS += SET_BUTTON_TAG("[99] 돌아간다", "99")
	L_SELECTABLE_ARRAY:99 = 1
	HTML_PRINT TEMPS
	CALL INPUT_ARRAY, L_SELECTABLE_ARRAY
	SELECTCASE RESULT
		CASE 0
			CLEARLINE LINECOUNT - L_LINE
			CALLFORM SHOPCOM_EVENT_201_2_{SELECT_PLACE}

			FOR LCOUNT,0,CHARANUM
				CALL HEALTH_CHARA,LCOUNT
			NEXT
			CALL DISPOSE_GRAPHICS, "QUEST"
			SIF FLAG_白き鋼鉄のX2_進行度 == 2
				RETURN 1
			RESTART
		CASE 1 TO VARSIZE("STAGE_TABLE")
			SELECT_PLACE = RESULT
		CASE 99
			RETURN 0
	ENDSELECT
WEND

@GRAVEKEEPER_DEFEAT_AFTER, ARG, ARGS
SELECTCASE ARGS
	CASE "火山", "密林"
		;화산 또는 밀림 중 하나 클리어 후
		IF !FLAG_白き鋼鉄のX2_炎獄クリア || !FLAG_白き鋼鉄のX2_機蜂クリア
			CALL PRINT_FACE_BY_CHARA, GETCHARA([[キャラ:코하쿠_X]]), [[キャラ:코하쿠_X]]
