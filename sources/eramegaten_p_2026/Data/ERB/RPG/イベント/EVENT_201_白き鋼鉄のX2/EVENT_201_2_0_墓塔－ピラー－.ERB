@PLAYABLE_EVENT_201_2
SIF FLAG_白き鋼鉄のX2_進行度 != 1
	RETURN 0
SIF GETCHARA([[キャラ:아큐라_X]]) < 0
	RETURN 0
;원 네타：건볼트 조 그레이브 필러 미션 셀렉트 화면
;아큐라 편 6보스 스테이지를 통괄하는 허브
RESULTS = 묘탑－필러－
RETURN 1

