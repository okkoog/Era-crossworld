		BTL_KOJO_RESULTS:0 = 気をつけてアキュラくん！　前と違って
		BTL_KOJO_RESULTS:1 = 墓守の力を利用してるみたい！
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		
		CALL SET_RORO_KOJO_FLAG, COPEN
		BTL_KOJO_RESULTS:0 = これじゃ見た目だけじゃなくて戦い方までアキュラくんそっくりだ
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = 酷似した戦闘スタイルなのは癇に障るが……
		BTL_KOJO_RESULTS:1 = これで貴様を倒せば、オレの優位性が証明されるッ！
		LOCAL = 0
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("イプシロン")
		進行度 = 20
		RESETCOLOR
	CASE 20
		SETCOLOR COLOR("FRIEND")
		BTL_KOJO_RESULTS:0 = お前が何者かは知らないが、
		BTL_KOJO_RESULTS:1 = こんなところで斃れるつもりはない……！
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		
		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = クハハハハッ！！　そう来なくては面白くない！
		BTL_KOJO_RESULTS:1 = 貴様の全身全霊を撃ち砕かずして勝利とは言えんからなッ！
		LOCAL = 0
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("イプシロン")
		
		BTL_KOJO_RESULTS:0 = マザーよ、ご覧あれ！　このオレこそが、
		BTL_KOJO_RESULTS:1 = あなたのパートナーに相応しいと証明してみせようッ！
		LOCAL = 0
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("イプシロン")
		
		進行度 = 30
		RESETCOLOR
ENDSELECT
