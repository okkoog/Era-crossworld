@SET_BOSS_ENEMY_EVENT_201_超越, L_ENEMY_NAME
#DIMS DYNAMIC L_ENEMY_NAME
#DIM DYNAMIC L_ENEMY
SELECTCASE L_ENEMY_NAME
	CASE "超越1"
		TSTR:전투이벤트패턴 = EVENT_201_3_超越
		CALL SET_ENEMY, 7, [[キャラ:근접전투워커]], 37
		CALL SET_ENEMY, 8, [[キャラ:근접전투워커]], 37
		CALL SET_ENEMY, 10, [[キャラ:시키오우지]], 36
		CALL SET_ENEMY, 11, [[キャラ:카마조츠]], 38
	CASE "超越2"
		CALL SET_ENEMY, 7, [[キャラ:근접전투워커]], 37
		CALL SET_ENEMY, 8, [[キャラ:시키오우지]], 36
		CALL SET_ENEMY, 9, [[キャラ:근접전투워커]], 37
		CALL SET_ENEMY, 10, [[キャラ:시키오우지]], 36
		CALL SET_ENEMY, 11, [[キャラ:근접전투워커]], 37
		CALL SET_ENEMY, 12, [[キャラ:다프네]], 36
		CALL SET_ENEMY, 13, [[キャラ:특공형드론]], 35
		CALL SET_ENEMY, 14, [[キャラ:디스]], 34
		CALL SET_ENEMY, 15, [[キャラ:특공형드론]], 35
		CALL SET_ENEMY, 16, [[キャラ:젤라론즈]], 35
	CASE "超越3"
		TSTR:전투이벤트패턴 = EVENT_201_3_超越
		CALL SET_ENEMY, 9, [[キャラ:우드골렘]], 35, 1, 1
	CASE "イプシロン2"
		TSTR:전투이벤트패턴 = EVENT_201_4_イプシロン3

		CALL SET_ENEMY, 9, [[キャラ:입실론_X2]], 40, 2, 1
		L_ENEMY = CHARANUM - 1
		CALL SET_ENEMY_TIMEID, L_ENEMY, "イプシロン"
		CFLAG:L_ENEMY:ＨＰ보정 += 2000
		CFLAG:L_ENEMY:ＭＰ보정 += 50000
		CFLAG:L_ENEMY:행동횟수 = 2
		BASE:L_ENEMY:SHOCK = -50
		CSTR:L_ENEMY:사고패턴 = ブレイジングテンペスト
		
		CALL CLEAR_ALL_SKILL, L_ENEMY
		CALL SET_SKILL, L_ENEMY, "シールドストライク"
		CALL SET_SKILL, L_ENEMY, "インフェルノドロップ"
		CALL SET_SKILL, L_ENEMY, "オラージュリーゼ"
		CALL SET_SKILL, L_ENEMY, "ＳＰスキル"
		CALL SET_SKILL, L_ENEMY, "결단"
		CSTR:L_ENEMY:랜덤선택금지스킬 '= "ＳＰスキル"
ENDSELECT

;=============================================
;EVENT_201_4_イプシロン3
;=============================================
@SET_ACTION_ブレイジングテンペスト, ARG
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM ターン保存
#DIM SKILL_NUM
IF CFLAG:ARG:１more플래그 > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
ELSEIF CFLAG:ARG:행동한횟수 == 0
	;ガンヴォルトあるある：HPが1/3切ったらSPスキル使う　5Tに1回打ってくるぞ
	IF CFLAG:ARG:800 == 3 && PU_SKILLGAGE_D_GET(ARG, "ＳＰスキル") == 0
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ＳＰスキル")
	ELSEIF PU_SKILLGAGE_D_GET(ARG, "シールドストライク") > 0 && RAND:10 > 3
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "インフェルノドロップ")
	ELSE
		IF RAND:5 == 0
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "シールドストライク")
		ELSEIF RAND:4 == 0
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "インフェルノドロップ")
		ELSEIF RAND:3 == 0
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "シールドストライク")
		ELSEIF RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "シールドストライク")
		ELSE
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "オラージュリーゼ")
		ENDIF
	ENDIF
ELSE
	IF PU_SKILLGAGE_D_GET(ARG, "シールドストライク") > 0 && RAND:10 > 3
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "インフェルノドロップ")
	ELSEIF RAND:5 == 0
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "シールドストライク")
	ELSEIF RAND:4 == 0
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "インフェルノドロップ")
	ELSEIF RAND:3 == 0
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "オラージュリーゼ")
	ELSEIF RAND:2 == 0
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "オラージュリーゼ")
	ELSE
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "オラージュリーゼ")
	ENDIF
ENDIF

@CHANGE_ACTION_ブレイジングテンペスト, ARG
IF CFLAG:ARG:800 == 2 
	CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ＳＰスキル")
	CFLAG:ARG:800 = 3
ENDIF

@EVENT_BATTLE_DYING_EVENT_201_4_イプシロン3, L_T, L_P, L_SKIP
#DIM DYNAMIC L_T
#DIM DYNAMIC L_P
#DIM DYNAMIC L_SKIP
IF L_T == GET_ENEMY("イプシロン") && CFLAG:L_T:800 == 0
	TSTR:스킬메시지추가 = %CALLNAME:L_T%은(는) 일어섰다!!
	
	CFLAG:L_T:상태이상 = GET_STATE_NUM("GOOD")
	BASE:L_T:ＨＰ = MAXBASE:L_T:ＨＰ / 3
	CFLAG:L_T:800 = 1
	CFLAG:L_T:공격대상제외_ACT = 1
ENDIF

@EVENT_BATTLE_ACTEND_EVENT_201_4_イプシロン3
IF CFLAG:GET_ENEMY("イプシロン"):800 == 1
	BTL_KOJO_RESULTS:0 = マザーの、ために……ッ！
	SETCOLOR COLOR("ENEMY")
	CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("イプシロン")
	CFLAG:GET_ENEMY("イプシロン"):800 = 2
ENDIF

