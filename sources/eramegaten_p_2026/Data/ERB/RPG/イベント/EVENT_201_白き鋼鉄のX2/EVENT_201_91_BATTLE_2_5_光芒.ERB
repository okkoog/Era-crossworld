@KOJO_ENEMY_BATTLE_MESSAGE_K[[キャラ:오토크롬_X2]], ARG, ARG:1 = 0
;-------------------------------------------------
;特定スキル
;-------------------------------------------------
;これは通常攻撃
SELECTCASE CFLAG:ARG:입력행동
	CASE 0
		IF CFLAG:ARG:800 == 99 && RAND:2 == 0
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 테이얏!
				CASE 1
					BTL_KOJO_RESULTS:0 = 에에잇!
				CASE 2
					BTL_KOJO_RESULTS:0 = 거기서 꼼짝 마세요!
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 하앗!
				CASE 1
					BTL_KOJO_RESULTS:0 = 맞아라앗!
				CASE 2
					BTL_KOJO_RESULTS:0 = 느리군!
			ENDSELECT
		ENDIF
;-------------------------------------------------
;汎用スキル
;-------------------------------------------------
	CASE [[스킬:데・카쟈]]
		SELECTCASE RAND:3
			CASE 0
