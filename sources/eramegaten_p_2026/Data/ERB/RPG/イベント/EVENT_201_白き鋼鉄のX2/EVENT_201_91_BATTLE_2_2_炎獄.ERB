@SET_BOSS_ENEMY_EVENT_201_炎獄, L_ENEMY_NAME
#DIMS DYNAMIC L_ENEMY_NAME
#DIM DYNAMIC L_ENEMY
SELECTCASE L_ENEMY_NAME
	CASE "炎獄1"
		TSTR:전투이벤트패턴 = EVENT_201_2_2_炎獄
		CALL SET_ENEMY, 7, [[キャラ:락샤사]], 32
		CALL SET_ENEMY, 10, [[キャラ:락샤사]], 32
		CALL SET_ENEMY, 12, [[キャラ:경비드론]], 30
		CALL SET_ENEMY, 15, [[キャラ:경비드론]], 30
	CASE "炎獄2"
		TSTR:전투이벤트패턴 = EVENT_201_2_2_炎獄
		CALL SET_ENEMY, 7, [[キャラ:피닉스]], 31
		CALL SET_ENEMY, 9, [[キャラ:화염방사워커]], 32
		CALL SET_ENEMY, 10, [[キャラ:화염방사워커]], 32
		CALL SET_ENEMY, 11, [[キャラ:경비워커]], 30
		CALL SET_ENEMY, 15, [[キャラ:경비드론]], 30
	CASE "炎獄3"
		TSTR:전투이벤트패턴 = EVENT_201_2_2_炎獄
		CALL SET_ENEMY, 8, [[キャラ:화염방사워커]], 32
		CALL SET_ENEMY, 9, [[キャラ:아레스]], 35
		CALL SET_ENEMY, 10, [[キャラ:화염방사워커]], 32
	CASE "デイサイト"
		TSTR:전투이벤트패턴 = EVENT_201_2_2_デイサイト

		CALL SET_ENEMY, 9, [[キャラ:데이사이트_X2]], 35, 1, 1
		L_ENEMY = CHARANUM - 1
		CALL SET_ENEMY_TIMEID, L_ENEMY, "デイサイト"
		CSTR:L_ENEMY:사고패턴 = アルマゲドンレイ
		CFLAG:L_ENEMY:ＨＰ보정 += 1000
		CFLAG:L_ENEMY:ＭＰ보정 += 50000
		CFLAG:L_ENEMY:행동횟수 = 2
		BASE:L_ENEMY:SHOCK = -25
		
		CSTR:L_ENEMY:基本アイコンファイルネーム '= "デイサイト_X2_FACE_1"
		
		CALL CLEAR_ALL_SKILL, L_ENEMY
		CALL SET_SKILL, L_ENEMY, "섬머솔트"
		CALL SET_SKILL, L_ENEMY, "트위스터킥"
		CALL SET_SKILL, L_ENEMY, "화쇄열풍파"
		CALL SET_SKILL, L_ENEMY, "폭렬의손톱"
		CALL SET_SKILL, L_ENEMY, "메테오피스트"
		CALL SET_SKILL, L_ENEMY, "헬파이어"
		CALL SET_SKILL, L_ENEMY, "소작권"
		CALL SET_SKILL, L_ENEMY, "ＳＰスキル"
		CALL SET_SKILL, L_ENEMY, "백열찌르기"
		CALL SET_SKILL, L_ENEMY, "마그마・액시스"
		CALL SET_SKILL, L_ENEMY, "インフェルノドロップ"
		
		CSTR:L_ENEMY:랜덤선택금지스킬 '= "ＳＰスキル"
ENDSELECT

