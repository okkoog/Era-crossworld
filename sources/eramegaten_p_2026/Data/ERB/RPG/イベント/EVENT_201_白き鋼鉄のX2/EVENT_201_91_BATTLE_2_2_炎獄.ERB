@SET_ACTION_アルマゲドンレイ, ARG
IF CFLAG:ARG:１more플래그 > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
ELSEIF CFLAG:ARG:행동한횟수 == 0
	IF CFLAG:ARG:800 == 3
		;ガンヴォルトあるある：HPが1/3切ったらSPスキル使う　5Tに1回打ってくるぞ
		IF PU_SKILLGAGE_D_GET(ARG, "ＳＰスキル") == 0
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ＳＰスキル")
		ELSE
			IF RAND:5 == 0
				CALL SET_ACTION_SKILL, ARG, [[스킬:폭렬의손톱]]
			ELSEIF RAND:4 == 0
				CALL SET_ACTION_SKILL, ARG, [[스킬:백열찌르기]]
			ELSEIF RAND:3 == 0
				CALL SET_ACTION_SKILL, ARG, [[스킬:화염가드킬]]
			ELSEIF RAND:2 == 0
				CALL SET_ACTION_SKILL, ARG, [[스킬:마그마・액시스]]
			ELSE
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "インフェルノドロップ")
			ENDIF
		ENDIF
	ELSE
		IF RAND:5 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:폭렬의손톱]]
		ELSEIF RAND:4 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:메테오피스트]]
		ELSEIF RAND:3 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:화염가드킬]]
		ELSEIF RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:마그마・액시스]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "インフェルノドロップ")
		ENDIF
	ENDIF
ELSE
	IF RAND:4 == 0
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "インフェルノドロップ")
	ELSEIF RAND:3 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:트위스터킥]]
	ELSEIF RAND:2 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:헬파이어]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:화쇄열풍파]]
	ENDIF
ENDIF

@CHANGE_ACTION_アルマゲドンレイ, ARG
