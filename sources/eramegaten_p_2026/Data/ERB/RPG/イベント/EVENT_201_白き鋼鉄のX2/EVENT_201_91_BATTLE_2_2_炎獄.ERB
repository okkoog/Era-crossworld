@EVENT_BATTLE_ACTEND_EVENT_201_2_2_炎獄
#DIM DYNAMIC L_DAMAGE
#DIM DYNAMIC L_TYPE_VALUE
SIF FLAG_白き鋼鉄のX2_マグマ到達ターン > 0
	RETURN 0
SIF !IS_TARGET_ABLE(FLAG:행동순1)
	RETURN 0
L_DAMAGE = RAND(20, 30)
CALL BTL_CALC_AISYOU, -1, FLAG:행동순1, -1, GET_TYPE_NUM("화염")
L_TYPE_VALUE = RESULT
IF L_TYPE_VALUE == 999
	L_TYPE_VALUE = 0
	L_DAMAGE = 0
ELSE
	L_DAMAGE = L_DAMAGE * RESULT / 100
ENDIF
TSTR:스킬메시지대상 = 　　TARGET:[{CPOS(FLAG:행동순1),2}] %CALLNAME:(FLAG:행동순1),20,LEFT%
TSTR:스킬메시지화살표 = 　>>>>>>　
CALL BTL_CALC_DAMAGE_EXE, -1, FLAG:행동순1, L_DAMAGE, GET_TYPE_NUM("화염"), L_TYPE_VALUE
CALL PRINT_ACT_MESSAGE, , , COLOR("ENEMY"), "마그마", "화염상성데미지", "NOWAIT"
CALL PRINT_SKILL_MESSAGE
WAIT

