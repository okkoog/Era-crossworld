@EVENT_BATTLE_TURNSTART_EVENT_201_2_2_デイサイト
#DIM 進行度
#DIM DYNAMIC COPEN
SIF 進行度 == 30
	RETURN 0
SIF FINDCHARA_B([[キャラ:아큐라_X]])  != 2
	RETURN 0
COPEN = RESULT:1
SELECTCASE 進行度
	CASE 0
		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = 너와 싸우고 있자니, 옛날 생각이 나는군
		BTL_KOJO_RESULTS:1 = 이렇게 탑을 노리는 인간들과도 싸우곤 했었지
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("デイサイト")

		SETCOLOR COLOR("FRIEND")
		BTL_KOJO_RESULTS:0 = 인간과 싸웠다고?
		BTL_KOJO_RESULTS:1 = 너희들은 인간이 만든 것이 아니었던가?
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN

		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = 아아, 그래. 우리 워커는 인간이 만들었지
		BTL_KOJO_RESULTS:1 = 그렇다 해도 제조 목적을 다하기 위해서라면 인간 상대로도 힘을 휘둘렀다
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("デイサイト")

		進行度 = 10
		RESETCOLOR
	CASE 10
		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = 그런 자신에게 의문을 품었던 적조차 있었지
		BTL_KOJO_RESULTS:1 = 하지만―― 이윽고, 그런 의문조차 품을 필요가 없어졌다
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("デイサイト")

		SETCOLOR COLOR("FRIEND")
		BTL_KOJO_RESULTS:0 = ……이 세계의 인류가, 멸망했기 때문인가
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN

		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = 그 말대로다
		BTL_KOJO_RESULTS:1 = 그렇게 내 투쟁심은 사그라들었던 참이었지―― 어제까지는
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("デイサイト")

		進行度 = 20
		RESETCOLOR
	CASE 20
		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = 솔직한 심정으로, 난 오랜만에 뜨겁게 달아오르고 있어
		BTL_KOJO_RESULTS:1 = 네가 내게 불을 붙여 주었으니까
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("デイサイト")

		BTL_KOJO_RESULTS:0 = 도굴꾼에게 할 말은 아니지만, 감사를 표해야 할지도 모르겠군
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("デイサイト")

		SETCOLOR COLOR("FRIEND")
		BTL_KOJO_RESULTS:0 = ……감사를 표할 바엔, 열쇠를 넘겨주었으면 좋겠군
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN

		進行度 = 30
		RESETCOLOR
ENDSELECT

