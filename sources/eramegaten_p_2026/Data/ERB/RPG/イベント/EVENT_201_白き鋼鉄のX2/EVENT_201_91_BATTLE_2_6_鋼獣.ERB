	BTL_KOJO_RESULTS:0 = 馬鹿なぁっ！　た、隊長ぉー……！
	SETCOLOR COLOR("ENEMY")
	CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("ヘヴィバザルト")
	CFLAG:GET_ENEMY("ヘヴィバザルト"):800 = 2
	RESETCOLOR
	PRINTFORML 헤비 바살트의 각 부위가 불을 뿜기 시작하더니, 이윽고 대폭발을 일으켰다.
