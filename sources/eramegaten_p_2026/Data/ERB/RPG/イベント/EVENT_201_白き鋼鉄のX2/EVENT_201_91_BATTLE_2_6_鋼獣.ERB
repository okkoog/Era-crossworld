@SET_BOSS_ENEMY_EVENT_201_鋼獣, L_ENEMY_NAME
#DIMS DYNAMIC L_ENEMY_NAME
#DIM DYNAMIC L_ENEMY
#DIM DYNAMIC ADD_LV
ADD_LV = GROUPMATCH(1, FLAG_白き鋼鉄のX2_光芒クリア, FLAG_白き鋼鉄のX2_鋼獣クリア, FLAG_白き鋼鉄のX2_極寒クリア, FLAG_白き鋼鉄のX2_飛刀クリア) * 3
SELECTCASE L_ENEMY_NAME
	CASE "鋼獣1"
		TSTR:전투이벤트패턴 = EVENT_201_2_6_鋼獣
		CALL SET_ENEMY, 8, [[キャラ:근접전투워커]], 42 + ADD_LV
		CALL SET_ENEMY, 9, [[キャラ:루흐]], 43 + ADD_LV
		ABL:(CHARANUM-1):스킬2  = 0
		CALL SET_ENEMY, 10, [[キャラ:근접전투워커]], 42 + ADD_LV
		CALL SET_ENEMY, 13, [[キャラ:포획드론]], 40 + ADD_LV
		CALL SET_ENEMY, 15, [[キャラ:포획드론]], 40 + ADD_LV

	CASE "鋼獣2"
		TSTR:전투이벤트패턴 = EVENT_201_2_6_鋼獣

		CALL SET_ENEMY, 7, [[キャラ:화염방사워커]], 41 + ADD_LV
		CALL SET_ENEMY, 8, [[キャラ:트리글라프]], 42 + ADD_LV
		CALL SET_ENEMY, 9, [[キャラ:카브라칸]], 43 + ADD_LV
		CALL SET_ENEMY, 10, [[キャラ:화염방사워커]], 41 + ADD_LV
		CALL SET_ENEMY, 11, [[キャラ:트리글라프]], 42 + ADD_LV
		CALL SET_ENEMY, 12, [[キャラ:실드캐논]], 40 + ADD_LV
		CFLAG:(CHARANUM-1):ＨＰ보정 += 500
		CALL SET_ENEMY, 13, [[キャラ:카나로아]], 42 + ADD_LV
		CALL SET_ENEMY, 14, [[キャラ:벨로보그]], 42 + ADD_LV
		CALL SET_ENEMY, 15, [[キャラ:카나로아]], 42 + ADD_LV
		CALL SET_ENEMY, 16, [[キャラ:실드캐논]], 40 + ADD_LV
		CFLAG:(CHARANUM-1):ＨＰ보정 += 500
	CASE "鋼獣3"
		TSTR:전투이벤트패턴 = EVENT_201_2_6_鋼獣
		CALL SET_ENEMY, 7, [[キャラ:호버중장비]], 43 + ADD_LV
		CALL SET_ENEMY, 9, [[キャラ:트리글라프]], 42 + ADD_LV
		CALL SYNC_STATUS, (CHARANUM-1)
		CALL SET_ENEMY, 11, [[キャラ:호버중장비]], 43 + ADD_LV
		CALL SET_ENEMY, 13, [[キャラ:루흐]], 43 + ADD_LV
		ABL:(CHARANUM-1):스킬2  = 0
		CALL SET_ENEMY, 15, [[キャラ:루흐]], 43 + ADD_LV
		ABL:(CHARANUM-1):스킬2  = 0
	CASE "ヘヴィバザルト"
		TSTR:전투이벤트패턴 = EVENT_201_2_6_ブリガド

		CALL SET_ENEMY, 9, [[キャラ:헤비바잘트]], 45 + ADD_LV, 1, 1
		L_ENEMY = CHARANUM - 1
		CALL SET_ENEMY_TIMEID, L_ENEMY, "ヘヴィバザルト"
		CSTR:L_ENEMY:적구상명칭 = EVENT_201_2_6_ブリガド
		CFLAG:L_ENEMY:ＨＰ보정 += 4500
		CFLAG:L_ENEMY:ＭＰ보정 += 50000
		CFLAG:L_ENEMY:행동횟수 = 2
		BASE:L_ENEMY:SHOCK = -25
		CSTR:L_ENEMY:사고패턴 = ヘヴィバザルト
		CFLAG:L_ENEMY:ＥＸＰ보정 = 0
		CFLAG:L_ENEMY:ＭＡＧ보정 = 0

		CFLAG:L_ENEMY:물리피데미지보정 = -30
		CFLAG:L_ENEMY:마법피데미지보정 = -30

		CALL SET_ENEMY, , [[キャラ:브리게이드_X2]], 45 + ADD_LV, 1, 1
		L_ENEMY = CHARANUM - 1
		CALL SET_ENEMY_TIMEID, L_ENEMY, "ブリガド"
		CALL SET_BATTLE_STATUS, L_ENEMY, MAXBASE:L_ENEMY:ＨＰ / 3, "ＨＰ"
		CSTR:L_ENEMY:적구상명칭 = EVENT_201_2_6_ブリガド
		CFLAG:L_ENEMY:ＨＰ보정 += 1500
		CFLAG:L_ENEMY:ＭＰ보정 += 50000
		CFLAG:L_ENEMY:행동횟수 = 3
		BASE:L_ENEMY:SHOCK = -25
		CSTR:L_ENEMY:사고패턴 = ファイナルオペレーション

		CFLAG:L_ENEMY:검격여데미지보정 = 20
		CFLAG:L_ENEMY:비구여데미지보정 = 20
		CALL CLEAR_ALL_SKILL, L_ENEMY
		CALL SET_SKILL, L_ENEMY, "ＳＰスキル"
		CALL SET_SKILL, L_ENEMY, "베놈재퍼"
		CALL SET_SKILL, L_ENEMY, "멸살수전"
		CALL SET_SKILL, L_ENEMY, "암야검"
		CALL SET_SKILL, L_ENEMY, "기합"
		CALL SET_SKILL, L_ENEMY, "백발백중"
ENDSELECT

;=============================================
;EVENT_201_2_6_ブリガド
;=============================================
@SET_ACTION_ヘヴィバザルト, ARG
IF CFLAG:ARG:１more플래그 > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
ELSE
	IF CFLAG:ARG:행동한횟수 == 0
		IF RAND:5 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:파워브레스]]
		ELSEIF RAND:4 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:도발]]
		ELSEIF RAND:3 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:파워브레스]]
		ELSEIF RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:마카라칸]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:테트라칸]]
		ENDIF
	ELSE
		IF FLAG:경과턴수 % 6 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:뉴클리어미사일]]
		ELSEIF FLAG:경과턴수 % 6 == 1
			CALL SET_ACTION_SKILL, ARG, [[스킬:슈퍼노바]]
		ELSEIF FLAG:경과턴수 % 6 == 2
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ガトリングスコール")
		ELSEIF FLAG:경과턴수 % 6 == 3
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ジャッジメントブレード")
		ELSEIF FLAG:경과턴수 % 6 == 4
			CALL SET_ACTION_SKILL, ARG, [[스킬:그랜드턱]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:슈퍼노바]]
		ENDIF
	ENDIF
ENDIF

;=============================================
;EVENT_201_2_6_ブリガド
;=============================================
@SET_ACTION_ファイナルオペレーション, ARG
IF CFLAG:ARG:１more플래그 > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
ELSE
	IF CFLAG:ARG:행동한횟수 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:이니셜라이즈]]
	ELSE
		IF RAND:5 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:파워브레스]]
		ELSEIF RAND:4 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:베놈재퍼]]
		ELSEIF RAND:3 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:멸살수전]]
		ELSEIF RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:암야검]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:천우의춤]]
		ENDIF
	ENDIF
ENDIF

@EVENT_BATTLE_ACTEND_EVENT_201_2_6_ブリガド
