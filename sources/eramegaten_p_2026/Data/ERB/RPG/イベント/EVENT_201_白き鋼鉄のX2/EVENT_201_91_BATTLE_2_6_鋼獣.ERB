;ブリガド戦専用ライブノベル
@EVENT_BATTLE_TURNSTART_EVENT_201_2_6_ブリガド
#DIM 進行度
#DIM DYNAMIC COPEN
SIF 進行度 == 30
	RETURN 0
SIF FINDCHARA_B([[キャラ:아큐라_X]])  != 2
	RETURN 0
COPEN = RESULT:1
SIF CPOS(GET_ENEMY("ヘヴィバザルト")) == 0
	RETURN 0
SELECTCASE 進行度	
	CASE 0
		CALL SET_RORO_KOJO_FLAG, COPEN
		BTL_KOJO_RESULTS:0 = うわ、ごっつい兵器！　あれ、大艦巨砲主義ってヤツ？
		BTL_KOJO_RESULTS:1 = どれも当たったらタダじゃ済まないよ！
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		
		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = 当然であります。キサマはあの隊長が不覚を取る手練れ
		BTL_KOJO_RESULTS:1 = この“ヘヴィバザルト”を持ち出すに値する相手であります！
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("ヘヴィバザルト")
		
		SETCOLOR COLOR("FRIEND")
		BTL_KOJO_RESULTS:0 = 確かに脅威的だが……こうした相手と戦うのは初めてではない
		BTL_KOJO_RESULTS:1 = サイズの大小で勝敗は決しないと教えてやる
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		
		進行度 = 10
		RESETCOLOR
	CASE 10
		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = そちらこそヘヴィバザルトを見くびらないことでありますな！
		BTL_KOJO_RESULTS:1 = これこそは当ブロックの技術の結晶！
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("ヘヴィバザルト")
		
		BTL_KOJO_RESULTS:0 = 生産ラインから部品を拝借し構築した、
		BTL_KOJO_RESULTS:1 = 自分専用の一点物なのであります！
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("ヘヴィバザルト")
		
		SETCOLOR COLOR("FRIEND")
		CALL SET_RORO_KOJO_FLAG, COPEN
		BTL_KOJO_RESULTS:0 = えっ、それって資材の私物化じゃないの……？
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		
		進行度 = 20
		RESETCOLOR
	CASE 20
		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = そっ、そんなことは些事であります！　最優先事項は侵入者の撃滅！
		BTL_KOJO_RESULTS:1 = それが果たされるならば多少の事は多めに見られるはずであります！
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("ヘヴィバザルト")
		
		SETCOLOR COLOR("FRIEND")
		CALL SET_RORO_KOJO_FLAG, COPEN
		BTL_KOJO_RESULTS:0 = そんな上手くいくかなぁ……
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		
		SETCOLOR COLOR("FRIEND")
		BTL_KOJO_RESULTS:0 = ……どうだろうな
		CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
		
		進行度 = 30
		RESETCOLOR
ENDSELECT
