		ABL:(CHARANUM-1):스킬5  = [[스킬:드래곤퀘이크]]
	CASE "ヴェスクロム"
		TSTR:전투이벤트패턴 = EVENT_201_3_ヴェスクロム

		CALL SET_ENEMY, 8, [[キャラ:베스파_X2]], 55, 1, 1
		L_ENEMY = CHARANUM - 1
		CFLAG:L_ENEMY:ＨＰ보정 += 3000
		CFLAG:L_ENEMY:ＭＰ보정 += 50000
		CFLAG:L_ENEMY:행동횟수 = 2
		BASE:L_ENEMY:SHOCK = -25
		CSTR:(CHARANUM-1):사고패턴 = シンクロオンスロートV
		
		CALL CLEAR_ALL_SKILL, L_ENEMY
		CALL SET_SKILL, L_ENEMY, "オラージュリーゼ"
		CALL SET_SKILL, L_ENEMY, "갈다인"
		CALL SET_SKILL, L_ENEMY, "마하・갈다인"
		CALL SET_SKILL, L_ENEMY, "바람의춤"
		CALL SET_SKILL, L_ENEMY, "요화열풍"
		CALL SET_SKILL, L_ENEMY, "크로스포츈"
		CALL SET_SKILL, L_ENEMY, "땅의열풍"
		CALL SET_SKILL, L_ENEMY, "고천열풍탄"
		CALL SET_SKILL, L_ENEMY, "찰나장대비쏘기"
		CALL SET_SKILL, L_ENEMY, "컨센트레이트"
		CALL SET_SKILL, L_ENEMY, "회심의패기"
		CALL SET_SKILL, L_ENEMY, "와이즈맨스냅"
		CALL SET_ENEMY_TIMEID, L_ENEMY, "ヴェスパ"

		CALL SET_ENEMY, 10, [[キャラ:오토크롬_X2]], 55, 1, 1
		L_ENEMY = CHARANUM - 1
		CFLAG:L_ENEMY:ＨＰ보정 += 3000
		CFLAG:L_ENEMY:ＭＰ보정 += 50000
		CFLAG:L_ENEMY:행동횟수 = 2
		BASE:L_ENEMY:SHOCK = -25

		CSTR:L_ENEMY:사고패턴 = シンクロオンスロートA
		CSTR:L_ENEMY:적구상명칭 = EVENT_201_3_オートクロム2
		CALL CLEAR_ALL_SKILL, L_ENEMY
		CALL SET_SKILL, L_ENEMY, "エイミングレイ"
		CALL SET_SKILL, L_ENEMY, "オプティックラウンド"
		CALL SET_SKILL, L_ENEMY, "플래시봄"
		CALL SET_SKILL, L_ENEMY, "뉴클리어미사일"
		CALL SET_SKILL, L_ENEMY, "찰나장대비쏘기"
		CALL SET_SKILL, L_ENEMY, "그랜드턱"
		CALL SET_SKILL, L_ENEMY, "저스티스샷"
		CALL SET_SKILL, L_ENEMY, "비구가드브레이크"
		CALL SET_SKILL, L_ENEMY, "기합"
		CALL SET_SKILL, L_ENEMY, "회심의패기"
		CALL SET_SKILL, L_ENEMY, "데・카쟈"
		CALL SET_SKILL, L_ENEMY, "파워브레스"
		CALL SET_SKILL, L_ENEMY, "결단"
		CALL SET_SKILL, L_ENEMY, "백발백중"
		CALL SET_ENEMY_TIMEID, L_ENEMY, "オートクロム"

		CSTR:L_ENEMY:랜덤선택금지스킬 '= "ＳＰスキル"
		
		CALL SET_ENEMY, , [[キャラ:베스크롬]], 55, 1, 1
		L_ENEMY = CHARANUM - 1
		CALL SET_ENEMY_TIMEID, L_ENEMY, "ヴェスクロム"

		CFLAG:L_ENEMY:ＨＰ보정 += 3000
		CFLAG:L_ENEMY:ＭＰ보정 += 50000
		CFLAG:L_ENEMY:행동횟수 = 2

		CFLAG:L_ENEMY:물리피데미지보정 = -20
		CFLAG:L_ENEMY:마법피데미지보정 = -20
		CSTR:L_ENEMY:사고패턴 = シンクロオンスロート
		BASE:L_ENEMY:SHOCK = -100
ENDSELECT

