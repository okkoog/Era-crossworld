@SET_BOSS_ENEMY_EVENT_201_交錯, L_ENEMY_NAME
#DIMS DYNAMIC L_ENEMY_NAME
#DIM DYNAMIC L_ENEMY
SELECTCASE L_ENEMY_NAME
	CASE "交錯1"
		TSTR:전투이벤트패턴 = EVENT_201_3_交錯
		CALL SET_ENEMY, 7, [[キャラ:란다]], 51
		CALL SET_ENEMY, 8, [[キャラ:알렉토]], 54
		CALL SET_ENEMY, 10, [[キャラ:후츠누시]], 53
		CALL SET_ENEMY, 11, [[キャラ:케르눈노스]], 53
		CALL SET_ENEMY, 13, [[キャラ:레이저포대]], 52
		CALL SET_ENEMY, 15, [[キャラ:레이저포대]], 52
	CASE "交錯2"
		TSTR:전투이벤트패턴 = EVENT_201_3_交錯
		CALL SET_ENEMY, 7, [[キャラ:란다]], 51
		CALL SET_ENEMY, 8, [[キャラ:다곤]], 54
		CALL SET_ENEMY, 9, [[キャラ:케찰코아틀]], 54
		CALL SET_ENEMY, 10, [[キャラ:다곤]], 54
		CALL SET_ENEMY, 11, [[キャラ:알렉토]], 54
		CALL SET_ENEMY, 12, [[キャラ:쿠반다]], 54
		CALL SET_ENEMY, 13, [[キャラ:파르바티]], 55
		CALL SET_ENEMY, 14, [[キャラ:오베론]], 55
		CALL SET_ENEMY, 15, [[キャラ:티타니아]], 52
		CALL SET_ENEMY, 16, [[キャラ:쿠반다]], 54
	CASE "交錯3"
		TSTR:전투이벤트패턴 = EVENT_201_3_交錯
		CALL SET_ENEMY, 9, [[キャラ:우드골렘]], 55, 1, 1
		NAME:(CHARANUM-1) = ウッドゴーレム改
		CALLNAME:(CHARANUM-1) = ウッドゴーレム改
