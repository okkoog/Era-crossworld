@EVENT_BATTLE_TURNEND_EVENT_201_3_交錯
FLAG_白き鋼鉄のX2_有害物質到達ターン--

@EVENT_BATTLE_NAVI_EVENT_201_3_交錯, ARGS
SELECTCASE ARGS
	CASE "メイン画面"
		CALL SET_RORO_KOJO_FLAG, GETCHARA([[キャラ:아큐라_X]])
		RESETCOLOR
		IF FLAG_白き鋼鉄のX2_有害物質到達ターン > 0
			BTL_KOJO_RESULTS:0 = 有害物質が来るまであと{FLAG_白き鋼鉄のX2_有害物質到達ターン}ターンだよ！ 急いで！
		ELSE
			BTL_KOJO_RESULTS:0 = 有害物質のせいで行動する度にダメージを受けるから気を付けて！
		ENDIF
		CALL PRINT_KOJO_RPG_MESSAGE, "ナビ_メイン画面"
		RETURN 1
ENDSELECT

@EVENT_BATTLE_ACTEND_EVENT_201_3_交錯
#DIM DYNAMIC L_DAMAGE
#DIM DYNAMIC L_TYPE_VALUE
SIF FLAG_白き鋼鉄のX2_有害物質到達ターン > 0
	RETURN 0
SIF !IS_TARGET_ABLE(FLAG:행동순1)
	RETURN 0
L_DAMAGE = RAND(20, 51)
CALL BTL_CALC_AISYOU, -1, FLAG:행동순1, -1, GET_TYPE_NUM("만능")
L_TYPE_VALUE = RESULT
IF L_TYPE_VALUE == 999
	L_TYPE_VALUE = 0
	L_DAMAGE = 0
ELSE
	L_DAMAGE = L_DAMAGE * RESULT / 100
ENDIF
TSTR:스킬메시지대상 = 　　TARGET:[{CPOS(FLAG:행동순1),2}] %CALLNAME:(FLAG:행동순1),20,LEFT%
TSTR:스킬메시지화살표 = 　>>>>>>　
CALL BTL_CALC_DAMAGE_EXE, -1, FLAG:행동순1, L_DAMAGE, GET_TYPE_NUM("만능"), L_TYPE_VALUE
CALL PRINT_ACT_MESSAGE, , , COLOR("ENEMY"), "有害物質", "万能相性ダメージ", "NOWAIT"
CALL PRINT_SKILL_MESSAGE
WAIT

@EVENT_BATTLE_DYING_EVENT_201_3_ヴェスクロム, L_T, L_P, L_SKIP
#DIM DYNAMIC L_T
#DIM DYNAMIC L_P
#DIM DYNAMIC L_SKIP
IF L_T == GET_ENEMY("ヴェスパ") && CFLAG:L_T:800 == 0
	TSTR:스킬메시지추가 = %CALLNAME:L_T%は致命的な打撃を受けた！
	
	CFLAG:L_T:상태이상 = GET_STATE_NUM("GOOD")
	BASE:L_T:ＨＰ = 1
	CFLAG:L_T:800 = 1
	CFLAG:L_T:공격대상제외_ACT = 1
ENDIF

IF L_T == GET_ENEMY("オートクロム") && CFLAG:L_T:800 == 0
	TSTR:스킬메시지추가 = %CALLNAME:L_T%は致命的な打撃を受けた！
	
	CFLAG:L_T:상태이상 = GET_STATE_NUM("GOOD")
	BASE:L_T:ＨＰ = 1
	CFLAG:L_T:800 = 1
	CFLAG:L_T:공격대상제외_ACT = 1
ENDIF

@EVENT_BATTLE_ACTEND_EVENT_201_3_ヴェスクロム
IF CFLAG:GET_ENEMY("ヴェスパ"):800 == 1
	IF CFLAG:GET_ENEMY("オートクロム"):800 == 0
		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = 妹よ、ここは一旦退け
		BTL_KOJO_RESULTS:1 = 後はオレが引き受ける
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("オートクロム")

		BTL_KOJO_RESULTS:0 = くっ……仕方ありませんわね
		BTL_KOJO_RESULTS:1 = 態勢を立て直します
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("ヴェスパ")
		RESETCOLOR
		PRINTFORMW ＞베스파가 전투에서 이탈했다
	ENDIF
	CALL REMOVE_POSITION, CPOS(GET_ENEMY("ヴェスパ"))
	CFLAG:GET_ENEMY("ヴェスパ"):800 = 2
ENDIF

IF CFLAG:GET_ENEMY("オートクロム"):800 == 1
	IF CFLAG:GET_ENEMY("ヴェスパ"):800 == 0
		SETCOLOR COLOR("ENEMY")
		BTL_KOJO_RESULTS:0 = お兄様、無理が祟ったのではなくて？
		BTL_KOJO_RESULTS:1 = 後はワタシにお任せなさい！
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("ヴェスパ")

		BTL_KOJO_RESULTS:0 = 止むを得んか……すまないが頼んだ
		BTL_KOJO_RESULTS:1 = オレは後衛に回る
		CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("オートクロム")
		RESETCOLOR
		PRINTFORMW ＞오토크롬이 전투에서 이탈했다
	ENDIF
	CALL REMOVE_POSITION, CPOS(GET_ENEMY("オートクロム"))
	CFLAG:GET_ENEMY("オートクロム"):800 = 2
ENDIF

IF CFLAG:GET_ENEMY("ヴェスパ"):800 == 2 && CFLAG:GET_ENEMY("オートクロム"):800 == 2
	CFLAG:GET_ENEMY("オートクロム"):800 = 3
	CFLAG:GET_ENEMY("ヴェスパ"):800 = 3
	SETCOLOR COLOR("ENEMY")
	BTL_KOJO_RESULTS:0 = 行くぞ、妹よ！
	CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("オートクロム")

	BTL_KOJO_RESULTS:0 = ええ、お兄様！
	CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("ヴェスパ")

	CALLF DISPOSE_SPRITE_FORCE_F, TEMP_GID_START, "ヴェスクロム_シンクロ"
	;アイコン設定時の表示に使うアイコン
	VARI GID
	GID = FINDELEMENT(USED_CHARA_GID, 0)
	USED_CHARA_GID:GID = 1, 1, 1
	GCREATE GID, 96, 96
	GCREATE GID + 1, 96, 96
	GCREATE GID + 2, 96, 96

	CALL 顔グラ追加, [[キャラ:오토크롬_X2]]
	CALL 顔グラ追加, [[キャラ:베스파_X2]]
	GDRAWSPRITE GID + 1, "オートクロム_X2_FACE_0", 0, 0, 96, 96
	GDRAWSPRITE GID + 2, "ヴェスパ_X2_FACE_0", 0, 0, 96, 96

	GCREATE GID, 96, 96
	GDRAWG GID, GID + 1, 0, 0, 96, 96, 48, 0, 96, 96
	GDRAWG GID, GID + 2, 48, 0, 96, 96, 0, 0, 96, 96

	SPRITECREATE "ヴェスクロム_シンクロ", GID

	CALL PRINT_ACT_MESSAGE, , , COLOR("ENEMY"), "クロム & ヴェスパ", "CONNECTED GRANDCROSS"
	TSTR:전투구상캐릭터명칭 '= "クロム & ヴェスパ"
	TSTR:전투구상캐릭터화상어드레스 = ヴェスクロム_シンクロ
	BTL_KOJO_RESULTS:0 = コネクティング！
	BTL_KOJO_RESULTS:1 = ゴー！
	CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("オートクロム")

