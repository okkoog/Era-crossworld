@SET_ACTION_シンクロオンスロートV, ARG
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM COPEN

IF CFLAG:ARG:１more플래그 > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:데・쿤다]]
ELSEIF CFLAG:ARG:집중플래그 > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:크로스포츈]]
ELSEIF CFLAG:ARG:회심의패기플래그 > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:원샷킬]]
ELSEIF CFLAG:ARG:행동한횟수 == 0
	IF FLAG:경과턴수 % 6 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:용분의춤]]
	ELSEIF FLAG:경과턴수 % 6 == 1
		CALL SET_ACTION_SKILL, ARG, [[스킬:갈다인]]
	ELSEIF FLAG:경과턴수 % 6 == 2
		CALL SET_ACTION_SKILL, ARG, [[스킬:용분의춤]]
	ELSEIF FLAG:경과턴수 % 6 == 3
		CALL SET_ACTION_SKILL, ARG, [[스킬:찰나장대비쏘기]]
	ELSEIF FLAG:경과턴수 % 6 == 4
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "オラージュリーゼ")
	ELSE
		IF RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:컨센트레이트]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:회심의패기]]
		ENDIF
	ENDIF
ELSE
	IF FLAG:경과턴수 % 6 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:땅의열풍]]
	ELSEIF FLAG:경과턴수 % 6 == 1
		CALL SET_ACTION_SKILL, ARG, [[스킬:마하・갈다인]]
	ELSEIF FLAG:경과턴수 % 6 == 2
		CALL SET_ACTION_SKILL, ARG, [[스킬:고천열풍탄]]
	ELSEIF FLAG:경과턴수 % 6 == 3
		CALL SET_ACTION_SKILL, ARG, [[스킬:원샷킬]]
	ELSEIF FLAG:경과턴수 % 6 == 4
		IF RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:컨센트레이트]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:회심의패기]]
		ENDIF
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:땅의열풍]]
	ENDIF
ENDIF

