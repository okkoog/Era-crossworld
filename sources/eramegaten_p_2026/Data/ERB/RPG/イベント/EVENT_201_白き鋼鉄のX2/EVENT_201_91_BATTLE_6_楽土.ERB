@SET_ACTION_アルマゲドンレイ2, ARG
IF CFLAG:ARG:１more플래그 > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:회심의패기]]
ELSEIF CFLAG:ARG:행동한횟수 == 0
	;ライブノベルは使わないので省略
	;ガンヴォルトあるある：HPが1/3切ったらSPスキル使う　5Tに1回打ってくるぞ
	IF CFLAG:ARG:800 == 3 && PU_SKILLGAGE_D_GET(ARG, "ＳＰスキル") == 0
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ＳＰスキル")
	ELSE
		IF FLAG:경과턴수 % 6 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:포효]]
		ELSEIF FLAG:경과턴수 % 6 == 1
			CALL SET_ACTION_SKILL, ARG, [[스킬:헬파이어]]
		ELSEIF FLAG:경과턴수 % 6 == 2
			CALL SET_ACTION_SKILL, ARG, [[스킬:워크라이]]
		ELSEIF FLAG:경과턴수 % 6 == 3
			CALL SET_ACTION_SKILL, ARG, [[스킬:뇌진왕모의발차기]]
		ELSEIF FLAG:경과턴수 % 6 == 4
			CALL SET_ACTION_SKILL, ARG, [[스킬:회심의패기]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:예광구리가라축]]
		ENDIF
	ENDIF
ELSE
	IF FLAG:경과턴수 % 6 == 0
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "インフェルノドロップ")
	ELSEIF FLAG:경과턴수 % 6 == 1
		CALL SET_ACTION_SKILL, ARG, [[스킬:불꽃의난무]]
	ELSEIF FLAG:경과턴수 % 6 == 2
		CALL SET_ACTION_SKILL, ARG, [[스킬:타격가드브레이크]]
	ELSEIF FLAG:경과턴수 % 6 == 3
		CALL SET_ACTION_SKILL, ARG, [[스킬:분노의철권]]
	ELSEIF FLAG:경과턴수 % 6 == 4
		CALL SET_ACTION_SKILL, ARG, [[스킬:천열찌르기]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:소작권]]
	ENDIF
ENDIF

