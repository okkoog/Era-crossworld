@SET_ACTION_ターミナルデトネーション, ARG
;ライブノベルは使わないので省略
IF CFLAG:ARG:１more플래그 > 0
	;一度クリティカルを許すと延々とクリティカルされ続ける……的な
	CALL SET_ACTION_SKILL, ARG, [[스킬:브레이브스텝]]
ELSE
	IF CFLAG:ARG:행동한횟수 == 0
		IF CFLAG:ARG:회피강화 < 32
			;回避MAXじゃなかったら
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "アクセラレート")
		ELSE
			;それ以外なら命中回避を下げてくる
			CALL SET_ACTION_SKILL, ARG, [[스킬:포그브레스]]
		ENDIF
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		VARI LCOUNT, 2
		CFLAG:ARG:입력행동 = -1
		VARS L_TYPES, 2
		IF RAND:2
			L_TYPES '= "검격", "신경"
		ELSE
			L_TYPES '= "비구", "신경"
		ENDIF
		;あとから神経で上書きを試すので神経が優先される
		FOR LCOUNT:1, 0, 2
			FOR LCOUNT, 1, 7
				SIF !IS_TARGET_ABLE(POS(LCOUNT))
					CONTINUE
				SIF CHECK_WEAKNESS(MAXBASE:POS(LCOUNT):(L_TYPES:(LCOUNT:1))) >= 0
					CONTINUE
				SIF CFLAG:POS(LCOUNT):((L_TYPES:(LCOUNT:1)) + "가드킬")
					CONTINUE
				CALL SET_ACTION_SKILL, ARG, SKILL_NUM_F(L_TYPES:(LCOUNT:1) + "ガードブレイク")
				BREAK
			NEXT
		NEXT
		;ブレイクの必要がないなら淀んだ空気
		SIF CFLAG:ARG:입력행동 == -1
			CALL SET_ACTION_SKILL, ARG, [[스킬:무거운공기]]
	ELSE
		VARI LCOUNT, 2
		VARS L_TYPES, 2
		IF RAND:2
			L_TYPES '= "검격", "비구"
		ELSE
			L_TYPES '= "비구", "검격"
		ENDIF
		FOR LCOUNT, 0, 2
			IF L_TYPES:LCOUNT == "검격"
				SELECTCASE RAND:10
					CASE 0, 1
						CALL SET_ACTION_SKILL, ARG, [[스킬:포이즌블레이드]]
					CASE 2, 3
						CALL SET_ACTION_SKILL, ARG, [[스킬:자벨린레인]]
					CASE 4, 5
						CALL SET_ACTION_SKILL, ARG, [[스킬:부월쇄파]]
					CASE 6, 7, 8
						CALL SET_ACTION_SKILL, ARG, [[스킬:암야검]]
					CASE 9
						CALL SET_ACTION_SKILL, ARG, [[스킬:브레이브재퍼]]
				ENDSELECT
			ELSE
				SELECTCASE RAND:10
					CASE 0, 1, 2
						CALL SET_ACTION_SKILL, ARG, [[스킬:멸살수전]]
					CASE 3, 4, 5
						CALL SET_ACTION_SKILL, ARG, [[스킬:천우의춤]]
					CASE 6, 7, 8
						CALL SET_ACTION_SKILL, ARG, [[스킬:암파쌍비조]]
					CASE 9
						;1/10で状態異常に関わらない強烈な一撃
						CALL SET_ACTION_SKILL, ARG, [[스킬:지고의마탄]]
				ENDSELECT
			ENDIF
			;対象の相性チェック
			FOR LCOUNT:1, GET_POS_MIN(CFLAG:ARG:타겟), GET_POS_MAX(CFLAG:ARG:타겟) + 1
				SIF !IS_TARGET_ABLE(POS(LCOUNT:1))
					CONTINUE
				CALL BTL_CALC_AISYOU, ARG, POS(LCOUNT:1), CFLAG:ARG:입력행동
				SIF CHECK_WEAKNESS(RESULT) >= 0
					CONTINUE
				CALL SET_ACTION_SKILL, ARG, [[스킬:꿰뚫는투기]]
				BREAK
			NEXT
		NEXT
	ENDIF
ENDIF

