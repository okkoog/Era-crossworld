;====================
;イベント名称
;====================
@GET_EVENT_NAME_201
#FUNCTIONS
RESULTS_F '= "하얀강철의X2"
RETURNF RESULTS_F

;====================
;条件
;====================
@PLAYABLE_EVENT_201
SIF FLAG_白き鋼鉄のX2_進行度 < 0
	RETURN 0
SIF !GETS_USEABLE_EXTRA_TITLE("白き鋼鉄のX")
	RETURN 0
;Xルート確定後はダメ
SIF FLAG_白き鋼鉄のX_進行度 > 1
	RETURN 0
TRYCCALLFORM PLAYABLE_EVENT_201_{FLAG_白き鋼鉄のX2_進行度 + 1}
	IF RESULT > 0
		;編成の共通チェック
		RESULTS:1 '= "필요: 아큐라의 편성"
		SIF FINDCHARA_B([[キャラ:아큐라_X]]) != 2
			RETURN -1
		RESULTS '= "(EX:하얀강철의X2)" + RESULTS
	ENDIF
	RETURN RESULT
CATCH
	RETURN 0
ENDCATCH

;====================
;内容
;====================
@SHOPCOM_EVENT_201
CALLFORM SHOPCOM_EVENT_201_{FLAG_白き鋼鉄のX2_進行度 + 1}
SIF !RESULT
	RETURN 0
CALL RESET_ANNOUNCE_FLAG
;성별을 기억
FLAG_白き鋼鉄のX2_アキュラ男性記録 = IS_MALE(GETCHARA([[キャラ:아큐라_X]]))
FLAG_白き鋼鉄のX2_マスター男性記録 = IS_MALE(MASTER)