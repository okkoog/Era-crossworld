@SET_ACTION_エクストリームビヨンド, ARG
;ここからが本番。
;ガチガチにしすぎたかもしれんが「vsバッドエンドの先まで行き着いた主人公」がテーマなので一度は死んでいただくぐらいのつもり
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC L_TYPES
#DIMS CONST L_TYPE_TABLE = "타격","화염","질풍","핵열","비구","검격","빙결"
;CSTR:ARG:전용기1 = シールドストライク
;CSTR:ARG:전용기2 = インフェルノドロップ
;CSTR:ARG:전용기3 = オラージュリーゼ
;CSTR:ARG:전용기4 = ＳＰスキル（今回は使わない）
;CSTR:ARG:전용기5 = エイミングレイ
;CSTR:ARG:전용기6 = タイムフリーザー
;CSTR:ARG:전용기7 = ジャッジメントブレード
;CSTR:ARG:전용기8 = φシュート
;CSTR:ARG:전용기9 = セラフィックデス
CFLAG:ARG:입력행동 = 0
CFLAG:ARG:타겟 = -1

IF CFLAG:ARG:800 == 2
	CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "セラフィックデス")
	CFLAG:ARG:800 = 3
ELSEIF CFLAG:ARG:１more플래그 > 0
	IF RAND:2 == 0
		;集中しても意味がない
		CALL SET_ACTION_SKILL, ARG, [[스킬:일기당천의눈빛]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:랜더마이저]]
	ENDIF
ELSEIF CFLAG:ARG:800 == 3 && PU_SKILLGAGE_D_GET(ARG, "セラフィックデス")
	CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "セラフィックデス")
ELSEIF CFLAG:ARG:(BASE_KAJA_TABLE:RAND(0, VARSIZE("BASE_KAJA_TABLE")) + "강화") < 0 || GET_カジャンダ_MIN(ARG) < -16
	CFLAG:ARG:입력행동 = [[스킬:이니셜라이즈]]
ELSEIF GET_カジャンダ_MAX(GET_RANDOM_FRIEND()) >= 16
	CFLAG:ARG:입력행동 = [[스킬:이니셜라이즈]]
ELSE
	;スキルの仮決定
	SIF L_TYPES == "" || CFLAG:ARG:행동한횟수 == 0
		L_TYPES '= L_TYPE_TABLE:RAND(VARSIZE("L_TYPE_TABLE"))
	SELECTCASE L_TYPES
		CASE "타격"
			CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "シールドストライク")
		CASE "화염"
			CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "インフェルノドロップ")
		CASE "질풍"
			CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "オラージュリーゼ")
		CASE "핵열", "비구"
			CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "エイミングレイ")
		CASE "검격"
			IF RAND:2
				CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "ジャッジメントブレード")
			ELSE
				CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "φシュート")
			ENDIF
		CASE "빙결"
			CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "タイムフリーザー")
	ENDSELECT

	;耐性をチェックし、ガードブレイクか万能攻撃に振り替える
	FOR LCOUNT, 1, 7
		SIF !IS_TARGET_ABLE(POS(LCOUNT))
			CONTINUE
		IF CHECK_WEAKNESS(MAXBASE:POS(LCOUNT):L_TYPES < 0) && !CFLAG:POS(LCOUNT):(L_TYPES + "가드킬")
			CFLAG:ARG:입력행동 = SKILL_NUM_F(L_TYPES + "ガードブレイク")
			BREAK
		ELSE
			CALL BTL_CALC_AISYOU, ARG, POS(LCOUNT), , GET_TYPE_NUM(L_TYPES)
			IF CHECK_WEAKNESS(RESULT) <= -2
				IF CFLAG:ARG:행동한횟수 == 0
					SELECTCASE RAND:3
						CASE 0
							;単体・威力210*2。クリティカル35%で普通に痛い
							CFLAG:ARG:입력행동 = [[스킬:메기도크로스]]
						CASE 1
							;単体・威力325。確率は低いが万能DYINGは怖い
							CFLAG:ARG:입력행동 = [[스킬:적살]]
						CASE 2
							;一列・威力320。威力はこの中だと一番低いが防御低下してくる
							CFLAG:ARG:입력행동 = [[스킬:끝나는세계]]
					ENDSELECT
				ELSE
					CFLAG:ARG:입력행동 = [[스킬:이니셜라이즈]]
				ENDIF
				BREAK
			ENDIF
		ENDIF
	NEXT
ENDIF
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
