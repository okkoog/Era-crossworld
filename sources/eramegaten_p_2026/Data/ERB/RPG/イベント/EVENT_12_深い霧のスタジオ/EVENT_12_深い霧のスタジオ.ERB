@GET_EVENT_NAME_12
#FUNCTIONS
RESULTS_F '= "깊은안개속의스튜디오"
RETURNF RESULTS_F

@PLAYABLE_EVENT_12
;レベル１０以上
IF BASE:MASTER:LV >= 10 && イベントフラグ:12:0 == 0 || (ダンジョンフラグ:72:8 > 0 && イベントフラグ:12:0 == 1) || (ダンジョンフラグ:73:8 > 0 && イベントフラグ:12:0 == 2)
	RESULTS = 깊은 안개의 스튜디오
	RETURN 1
;レベル４０以上、大浴場クリア済み
ELSEIF BASE:MASTER:LV >= 40 && イベントフラグ:12:0 == 3
	;P4主人公が戦闘参加可能＝調教陥落済み、P4主人公がパーティメンバーにいる
	IF FINDCHARA_B([[キャラ:P4주인공]]) == 2 && GET_VALUE_TALENT_JOINABLE(GETCHARA([[キャラ:P4주인공]])) == 2
		RESULTS = 깊은 안개의 스튜디오：곰으로부터의 메일
		RETURN 1
	;P4主人公が協力者ポジション、調教すると戦闘参加不可に、P4主人公がパーティメンバーにいる
	ELSEIF FINDCHARA_B([[キャラ:P4주인공]]) == 2 && GET_VALUE_TALENT_JOINABLE(GETCHARA([[キャラ:P4주인공]])) == 1
		RESULTS = 깊은 안개의 스튜디오：갑작스러운 방문
		RETURN 1
	ELSE
		RESULTS = 깊은 안개의 스튜디오：곰으로부터의 메일
		RETURN 1
	ENDIF
;天上楽土開始済み、かつ天上楽土進行状況突入済みで天上楽土の霧状況霧が出ていない、天上楽土クリアしてない
ELSEIF イベントフラグ:12:0 == 4 && ダンジョンフラグ:74:5 >= 1 && ダンジョンフラグ:74:3 == 0 &&  ダンジョンフラグ:74:1 == 0
	RESULTS = 깊은 안개의 스튜디오：야소이나바의 안개
	RETURN 1
;レベル５０以上、天上楽土開始、クリア済み、時間帯夜
;ELSEIF BASE:MASTER:LV >= 50 && イベントフラグ:12:0 == 4 && ダンジョンフラグ:74:1 >= 1 && TIME == 3
ELSEIF BASE:MASTER:LV >= 50 && イベントフラグ:12:0 == 4 && ダンジョンフラグ:74:1 >= 1
	RESULTS = 깊은 안개의 스튜디오：심야 TV
	RETURN 1
ENDIF
RETURN 0


