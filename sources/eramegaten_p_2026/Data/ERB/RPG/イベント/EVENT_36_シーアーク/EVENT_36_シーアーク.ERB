;シーアーク関連
;====================
;条件
;施設利用許可は主人のレベルがその階の敵最低レベルを超えていることとその階層で出せる敵が10種類以上
;装備品の支給は配給される物品の必要レベルを満たしていること
;
;フラグはダンジョンのものを使うのでそちらをあわせて見られたし
;====================
;ダンジョンフラグ:94:1 利用許可フラグ
;ダンジョンフラグ:94:4 アイテム支給フラグ
@GET_EVENT_NAME_36
#FUNCTIONS
RESULTS_F '= "시 아크"
RETURNF RESULTS_F

@PLAYABLE_EVENT_36
#LOCALSIZE 2
#DIM LCOUNT,2
#DIM L_RANK
#DIM M_RANK
#DIM L_MLV
;両方のイベントを終えてたら判定を抜ける
SIF GET_SEA_ARCH_FLAG("探索許可ランク") >= 17 && GET_SEA_ARCH_FLAG("支給品ランク") >= 7
	RETURN 0
;貢献度が低すぎる場合は離脱
SIF FLAG:조직공헌도 < 10000
	RETURN 0
;確認は1日1回
IF GET_SEA_ARCH_FLAG("イベント確認日") == DAY
	GOTO END
ELSE
	CALL SET_SEA_ARCH_FLAG, "イベント確認日", DAY
ENDIF
;処理を軽減するためにすでに許可が確定しているランクまでの処理も飛ばす
L_RANK = MAX(GET_SEA_ARCH_FLAG("探索許可ランク"), GET_SEA_ARCH_FLAG("探索許可イベントランク"))
;初回判定用(初期状態で実質条件を満たすので貢献度だけ見る形に)
IF GET_SEA_ARCH_FLAG("探索許可ランク") == 0
	L_RANK = 1
;最上階の開放判定
ELSEIF GET_SEA_ARCH_FLAG("探索許可ランク") >= 9 &&  GET_SEA_ARCH_FLAG("探索許可イベントランク") != 17
	;80レベルから開けられる(72以上の敵の数の問題で広範囲のレベルの敵をまとめなきゃいけないということで
	;このランク帯の敵はレベルを変更して凄まじいレベルムラを吸収するので、実際にあけられるレベルをずらす
	IF BASE:MASTER:LV >= 80
		FOR LCOUNT, 1, CSVCHARANUM
			SIF !CAN_ENCOUNT_SEA_ARCH(LCOUNT, 17)
				CONTINUE
			LOCAL++
			;10匹拾えた時点で終わる
			SIF LOCAL >= 10
				BREAK
		NEXT
		;10体の敵がでるならランク更新
		SIF LOCAL >= 10
			L_RANK = 17
	ENDIF	
ELSE
	;ランク9の許可は8の後でないといけない
	FOR LCOUNT, L_RANK+1, 9 + (GET_SEA_ARCH_FLAG("探索許可ランク") >= 8)
		;主人のレベルがレベル帯にあわない場合は離脱
		SIF GET_SEA_ARCH_ENEMYRANK(, MASTER) < LCOUNT
			BREAK
		;ランク帯における出現可能な敵の数を確認する
		LOCAL = 0
		FOR LCOUNT:1, 1, CSVCHARANUM
			SIF !CAN_ENCOUNT_SEA_ARCH(LCOUNT:1, LCOUNT)
				CONTINUE
			LOCAL++
			;10匹拾えた時点で終わる
			SIF LOCAL >= 10
				BREAK
		NEXT
		;10体の敵がでないなら離脱
		SIF LOCAL < 10
			BREAK
		L_RANK++
	NEXT
ENDIF
;ランクが更新できてるか確認
CALL SET_SEA_ARCH_FLAG, "探索許可イベントランク", L_RANK > GET_SEA_ARCH_FLAG("探索許可ランク") ? L_RANK # 0

L_RANK = MAX(GET_SEA_ARCH_FLAG("支給品ランク"), GET_SEA_ARCH_FLAG("支給品イベントランク"))
;装備品支給
;レベルの変動があったときのみ判定する
IF L_MLV != BASE:MASTER:LV
	L_MLV = BASE:MASTER:LV
	FOR LCOUNT, L_RANK+1, 8
		LOCALS = %EVENT_36_ITEMTABLE(LCOUNT)%
		LOCAL = 0
		LOCAL:1 = 0
		LCOUNT:1 = 0
		WHILE AUTO_SPLIT(LOCALS, "/", LCOUNT:1) != ""
			;判定した数と判定が通った数を記録する
			LOCAL:1++
			CALLFORM 必要レベル_{GETNUM(ITEM, AUTO_SPLIT(LOCALS, "/", LCOUNT:1))}
			SIF RESULT > BASE:MASTER:LV
				BREAK
			LOCAL++
			LCOUNT:1++
		WEND
		;判定漏れがあった場合は終わる
		SIF LOCAL < LOCAL:1
			BREAK
		L_RANK++
	NEXT
ENDIF
;ランクが更新できてるか確認
CALL SET_SEA_ARCH_FLAG, "支給品イベントランク", L_RANK > GET_SEA_ARCH_FLAG("支給品ランク") ? L_RANK # 0
$END
;どちらかの条件を満たしていれば良い
IF GET_SEA_ARCH_FLAG("探索許可イベントランク")
	RESULTS = 시설이용허가
	SIF GET_SEA_ARCH_FLAG("探索許可イベントランク") == 9
		RESULTS = 호텔ㆍ시아크에 대한 추가 정보
	RETURN 1
ENDIF
IF GET_SEA_ARCH_FLAG("支給品イベントランク")
	RESULTS = 장비품 배급
	RETURN 1
ENDIF
RETURN 0
