
;イベントフラグ:10:0を参照する部分
;32個(CASE 31)まで作成可能
@EVENT_10_PLAYABLE_0(ARG)
SELECTCASE ARG

CASE 1 ; 雰囲気の違う足使い達1
	
	;千枝ちゃんとゲイルがいる事
	SIF EVENT_10_2人掛け合いチェック([[キャラ:치에]],[[キャラ:게일]])
		RETURN 1
	
CASE 2 ; 雰囲気の違う足使い達2
	
	;雰囲気の違う足使い達を見ている
	SIF !GETBIT(イベントフラグ:10:0,1)
		RETURN 0
	;千枝ちゃんとゲイルがいて二人の絆(互いへの好感度+忠誠)が一定値以上
	SIF !EVENT_10_2人掛け合いチェック([[キャラ:치에]],[[キャラ:게일]],2500)
		RETURN 0
	;両者の忠誠値が700以上
	SIF GET_CHARA_LOYALTY(GETCHARA([[キャラ:치에]])) < 700
		RETURN 0
	SIF GET_CHARA_LOYALTY(GETCHARA([[キャラ:게일]])) < 700
		RETURN 0
	RETURN 1
	
