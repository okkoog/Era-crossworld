@EVENT_10_TITLELIST_0(ARG)
SELECTCASE ARG
CASE 1
	RESULTS = 분위기가 다른 발기술 사용자들 1
CASE 2
	RESULTS = 분위기가 다른 발기술 사용자들 2
CASE 3
	RESULTS = 분위기가 다른 발기술 사용자들 3
CASE 4
	RESULTS = 칸다: 헌책방 방문 1
CASE 5
	RESULTS = 칸다: 헌책방 방문 2
CASE 6
	RESULTS = 칸다: 헌책방 방문 3
CASE 7
	RESULTS = 총 매니아의 이야기 1
CASE 8
	RESULTS = 총 매니아의 이야기 2
CASE 9
	RESULTS = 총 매니아의 이야기 3
CASEELSE
	RETURN 0
ENDSELECT
RETURN 1


