;====================
;身体部位描写(Representation)
;====================
@BODY_R(ARGS , ARG)
#FUNCTIONS
#DIMS 部位

	部位 = %RSELECT_STRBODY(ARGS)%
	LOCALS:0 = 
	LOCALS:1 = 
	
	SELECTCASE 部位
		CASE "가슴"
			IF TALENT:(ARG:0):남자 && !TALENT:(ARG:0):오토코노코
				LOCALS:0 = %部位%
			ELSE
				SELECTCASE ABL:(ARG:0):Ｂ감각 + TALENT:(ARG:0):Ｂ민감 * 5 - TALENT:(ARG:0):Ｂ둔감 * 5 + TALENT:(ARG:0):음유 * 15
					CASE IS >= 30
						LOCALS:0 = %LOCALS:0%%SPLIT_R("이상한 감도의：쾌감에 거역할 수 없는：완전히 조교된")%
					CASE IS >= 20
						LOCALS:0 = %LOCALS:0%%SPLIT_R("너무나 과민한：쾌감에 약한：약점 그 자체인")%
					CASE IS >= 10
						LOCALS:0 = %LOCALS:0%%SPLIT_R("감도가 너무 좋은：자극에 약한：약점인")%
					CASE IS >= 4
						LOCALS:0 = %LOCALS:0%%SPLIT_R("느끼기 쉬운：자극에 민감한：반응이 좋은：성감대인")%
					CASE IS >= 1
						LOCALS:0 = %LOCALS:0%%SPLIT_R("개발 중인：감도가 좋은")%
					CASEELSE
						LOCALS:0 = %LOCALS:0%%SPLIT_R("개발되지 않은：미개발의：쾌락을 모르는")%
				ENDSELECT
			;胸のサイズで末尾を決める
				IF TALENT:(ARG:0):폭유
					LOCALS:1 = %LOCALS:1%%SPLIT_R("폭유：손에 다 안 들어오는 가슴：감싸 안을 정도의 유방")%
				ELSEIF TALENT:(ARG:0):거유
					LOCALS:1 = %LOCALS:1%%SPLIT_R("거유：탐스러운 가슴：손에서 흘러넘칠 듯한 유방")%
				ELSEIF TALENT:(ARG:0):빈유
					LOCALS:1 = %LOCALS:1%%SPLIT_R("작은 가슴：손에 쏙 들어오는 유방")%
				ELSEIF TALENT:(ARG:0):절벽
					LOCALS:1 = %LOCALS:1%%SPLIT_R("빈약한 가슴：판자 같은 유방")%
				ELSE
					LOCALS:1 = %LOCALS:1%%SPLIT_R("적당한 크기의 가슴：모양이 좋은 유방")%
				ENDIF
				
				LOCALS:0 = %LOCALS:0%%LOCALS:1%
				
				SIF TALENT:(ARG:0):매혹
					LOCALS:0 = 매혹적인 %LOCALS:0%
				
			ENDIF
		CASE "乳首", "유두"
			IF TALENT:(ARG:0):남자 && !TALENT:(ARG:0):오토코노코
				LOCALS:0 = %部位%
			ELSE
				SELECTCASE ABL:(ARG:0):Ｂ감각 + TALENT:(ARG:0):Ｂ민감 * 5 - TALENT:(ARG:0):Ｂ둔감 * 5 + TALENT:(ARG:0):음유 * 15
					CASE IS >= 30
						LOCALS:0 = %LOCALS:0%%SPLIT_R("이상한 감도의：쾌감에 거역할 수 없는：완전히 조교된")%%部位%
					CASE IS >= 20
						LOCALS:0 = %LOCALS:0%%SPLIT_R("너무나 과민한：쾌감에 약한：약점 그 자체인")%%部位%
					CASE IS >= 10
						LOCALS:0 = %LOCALS:0%%SPLIT_R("감도가 너무 좋은：자극에 약한：약점인")%%部位%
					CASE IS >= 4
						LOCALS:0 = %LOCALS:0%%SPLIT_R("느끼기 쉬운：자극에 민감한：반응이 좋은：성감대인")%%部位%
					CASE IS >= 1
						LOCALS:0 = %LOCALS:0%%SPLIT_R("개발 중인：감도가 좋은")%%部位%
					CASEELSE
						LOCALS:0 = %LOCALS:0%%SPLIT_R("개발되지 않은：미개발의：쾌락을 모르는")%%部位%
				ENDSELECT
				SIF TALENT:(ARG:0):매혹
					LOCALS:0 = 매혹적인 %LOCALS:0%
			ENDIF
		CASE "クリ", "클리", "음핵"
			IF TALENT:(ARG:0):남자 || TALENT:(ARG:0):오토코노코
				SELECTCASE TALENT:MASTER:페니스사이즈
					CASE 5
						LOCALS:0 = %LOCALS:0%%SPLIT_R("말 같은：팔뚝만 한 거대한")%
					CASE 4
						LOCALS:0 = %LOCALS:0%%SPLIT_R("핏줄이 곤두선：딱딱하게 융기한")%
					CASE 2
						LOCALS:0 = %LOCALS:0%%SPLIT_R("보통보다는 작은：조그마한")%
					CASE 1
						LOCALS:0 = %LOCALS:0%%SPLIT_R("작고 짧은：왜소한")%
					CASEELSE
						LOCALS:0 = %LOCALS:0%%SPLIT_R("늠름한：기운차게 솟구쳐 발기한")%
				ENDSELECT
			ELSE
				SELECTCASE ABL:(ARG:0):Ｃ감각 + TALENT:(ARG:0):Ｃ민감 * 5 - TALENT:(ARG:0):Ｂ둔감 * 5 + TALENT:(ARG:0):음유 * 15
					CASE IS >= 30
						LOCALS:0 = %LOCALS:0%%SPLIT_R("이상한 감도의：쾌감에 거역할 수 없는：완전히 조교된")%陰核
					CASE IS >= 20
						LOCALS:0 = %LOCALS:0%%SPLIT_R("너무나 과민한：쾌감에 약한：약점 그 자체인")%陰核
					CASE IS >= 10
						LOCALS:0 = %LOCALS:0%%SPLIT_R("감도가 너무 좋은：자극에 약한：약점인")%陰核
					CASE IS >= 4
						LOCALS:0 = %LOCALS:0%%SPLIT_R("느끼기 쉬운：자극에 민감한：반응이 좋은：성감대인")%陰核
					CASE IS >= 1
						LOCALS:0 = %LOCALS:0%%SPLIT_R("개발 중인：감도가 좋은")%陰核
					CASEELSE
						LOCALS:0 = %LOCALS:0%%SPLIT_R("개발되지 않은：미개발의：쾌락을 모르는")%陰核
				ENDSELECT
				
				SIF TALENT:(ARG:0):매혹
					LOCALS:0 = 매혹적인 %LOCALS:0%
				
			ENDIF
		CASE "身体", "신체"	
			IF TALENT:(ARG:0):남자 && !TALENT:(ARG:0):오토코노코
				LOCALS:0 = %部位%
			ELSE
				IF TALENT:(ARG:0):유아체형
					LOCALS:0 = %LOCALS:0%%SPLIT_R("작은：자그마한")%몸
				ELSEIF TALENT:(ARG:0):큰체형
					LOCALS:0 = %LOCALS:0%%SPLIT_R("큼직한")%몸
				ELSEIF TALENT:(ARG:0):거체
					LOCALS:0 = %LOCALS:0%%SPLIT_R("거대한")%몸
				ELSEIF TALENT:(ARG:0):거유
					LOCALS:0 = %LOCALS:0%%SPLIT_R("육감적인：남자의 눈길을 끄는")%몸
				ELSEIF TALENT:(ARG:0):빈유
					LOCALS:0 = %LOCALS:0%%SPLIT_R("늘씬한：균형 잡힌")%몸
				ELSE
					LOCALS:0 = %部位%
				ENDIF
				SIF TALENT:(ARG:0):매혹
					LOCALS:0 = %LOCALS:1%%SPLIT_R("매혹적인：요염한")%%LOCALS:0%
			ENDIF
	ENDSELECT

RETURNF LOCALS:0


;--------------------------------------------------------
;@RSELECT_STRBODY
;指定された部位から一か所を選ぶ
;--------------------------------------------------------
@RSELECT_STRBODY(ARGS)
#FUNCTIONS
#DIM LCOUNT
#DIMS 部位候補, 15
#DIMS 部位
#DIM 部位数
#DIM 分割数

VARSET 部位候補

部位 = ""
部位数 = 0
VARSET LOCAL
VARSET LOCALS

SPLIT ARGS, "：", LOCALS
分割数 = RESULT

FOR LCOUNT, 0, 分割数
	LOCALS:11 = %LOCALS:LCOUNT%
	SELECTCASE LOCALS:11
		CASE "가슴", "乳首", "유두", "尻", "엉덩이", "膣", "질", "애널", "腰", "허리", "陰唇", "음순", "クリ", "클리", "음핵", "尻肉", "엉덩이살", "身体", "신체"
			部位候補:部位数 = %LOCALS:11%
			部位数 ++
	ENDSELECT
NEXT
SIF 部位数 > 0
	部位 = %部位候補:(RAND:部位数)%

RETURNF 部位



;--------------------------------------------------------
;@SPLIT_R
;：で区切られた文字列からランダムに一つを返す
;--------------------------------------------------------
@SPLIT_R(ARGS)
#FUNCTIONS
#DIM LCOUNT

VARSET LOCAL
VARSET LOCALS

SPLIT ARGS, "：", LOCALS

RETURNF LOCALS:(RAND:RESULT)


;====================
;経験値処理
;====================
;CALL FUCK(対象,回数,経験値文字列)
;第一引数：対象を指定
;第二引数：SEX回数を指定
;第三引数："で区切った中に例の様に経験を入れたい文字を入れる、どんな文字が使えるかは下記HORO_FUCK_EXP_PROCESS参照
;　　　　　ＢＣＶＡＭのみ後ろに小OR大とつけることで加減可能
;
;
@FUCK(対象,回数,経験値文字列)
#DIM 対象
#DIM 回数
#DIMS 経験値文字列

CALL FUCK_EXP_PROCESS(対象,回数,経験値文字列)

;-------------------------------------------------
;FUCKにおける、部位に経験値を加算する関数
;-------------------------------------------------
@FUCK_EXP_PROCESS(対象,回数,経験値指定文字列)
#DIM 対象
#DIM 回数
#DIMS 経験値指定文字列
#DIMS 経験値, 100

;LOCAL:2 = 回数
;LOCAL:3 = セックス系プレイ頻度(回数)
;LOCAL:4 = 奉仕系プレイ頻度(回数)
;LOCAL:5 = SM系その他プレイ頻度（回数）
;LOCAL:6 = プレイ頻度合計(割合計算用)
;LOCAL:7 = Ｖ／Ａプレイ回数差計算用
;LOCAL:8 = Ｖプレイ回数
;LOCAL:9 = Ａプレイ回数

;LOCAL配列初期化
VARSET LOCAL,0
LOCAL:3 = 0
LOCAL:4 = 0
LOCAL:5 = 0
LOCAL:6 = 0
LOCAL:7 = 0
LOCAL:8 = 0
LOCAL:9 = 0

LOCAL:2 = 回数

;それぞれのプレイ回数を計算
;素質、能力に応じて行為の比率の決定(各素質は持ってれば1が入っている）
;セックス系、基本的に大きい。AV感覚、処女、再生処女、セックス中毒、セックス狂、尻穴狂い

;オトコが無い場合のみＶでの回数を加算する
SIF !TALENT:対象:남자
LOCAL:3 = ABL:対象:Ｖ감각 + TALENT:対象:처녀 * 7 + TALENT:対象:재생처녀 * 3 + TALENT:対象:섹스광 * 5
LOCAL:3 += ABL:対象:Ａ감각 + ABL:対象:섹스중독 + TALENT:対象:애널광 * 5

;奉仕系、奉仕精神と精液中毒が高く、献身的
IF TALENT:対象:처녀
	LOCAL:4 = LOCAL:3/3
ELSE
	LOCAL:4 = ABL:対象:봉사정신+ABL:対象:정액중독+TALENT:対象:헌신적*5
ENDIF

;SM系、|새드끼-마조끼|の数値が大きい、倒錯的、サド、マゾ、体力大目
;マゾ傾向
IF ABL:対象:마조끼 >= ABL:対象:새드끼
	LOCAL:5 = ABL:対象:마조끼 - ABL:対象:새드끼 + TALENT:対象:마조 * 10 + TALENT:対象:헌신적 * 5
;サド傾向
ELSEIF ABL:対象:새드끼 > ABL:対象:마조끼
	LOCAL:5 = ABL:対象:새드끼 - ABL:対象:마조끼 + TALENT:対象:새드 * 10 + TALENT:対象:헌신적 * 5
;同値
ELSE
	LOCAL:5 = ABL:対象:마조끼 + TALENT:対象:헌신적 * 5
ENDIF

;各調教回数計算
LOCAL:6 = MAX(1,LOCAL:3 + LOCAL:4 + LOCAL:5)
;それぞれの系統のプレイ回数を算出してLOCAL:4とLOCAL:5に入れる
LOCAL:3 = LOCAL:2 * LOCAL:3 / LOCAL:6
LOCAL:4 = LOCAL:2 * LOCAL:4 / LOCAL:6
LOCAL:5 = LOCAL:2 * LOCAL:5 / LOCAL:6

SIF LOCAL:3 + LOCAL:4 + LOCAL:5 == 0
	LOCAL:(3+RAND:4) = LOCAL:2

IF LOCAL:4 > 0
	;VとAのプレイ差
	IF ABL:対象:Ｖ감각 > ABL:対象:Ａ감각
		LOCAL:7 = ABL:対象:Ｖ감각-ABL:対象:Ａ감각
		LOCAL:8 = LOCAL:3/2+LOCAL:7
		LOCAL:9 = LOCAL:3-LOCAL:8
	ELSE
		LOCAL:7 = ABL:対象:Ａ감각-ABL:対象:Ｖ감각
		LOCAL:8 = LOCAL:3/2-LOCAL:7
		LOCAL:9 = LOCAL:3-LOCAL:8
	ENDIF

	SIF LOCAL:8 < 0
		LOCAL:8 = 0
	SIF LOCAL:9 < 0
		LOCAL:9 = 0
ENDIF


VARSET 経験値
SPLIT 経験値指定文字列, ",", 経験値
LOCAL:1 = 0
FOR LOCAL, 0, VARSIZE("経験値")
	;空文字列ならスキップ
	SIF 経験値:LOCAL == ""
		CONTINUE
	;スペースを除去
	経験値:LOCAL = %REPLACE(経験値:LOCAL, " ", "")%
	経験値:LOCAL = %REPLACE(経験値:LOCAL, "　", "")%

	IF 経験値:LOCAL == "Ｃ"
		JUEL:対象:쾌Ｃ += ABL:対象:Ｃ감각 * 5 + 4 + LOCAL:4 * 50
		LOCAL:1 += ABL:対象:Ｃ감각
		CONTINUE
	ENDIF
	
	IF 経験値:LOCAL == "Ｖ" && !TALENT:対象:남자
		;처녀상실플래그
		IF TALENT:対象:처녀 == 1
			TALENT:対象:처녀 = 0
			CFLAG:対象:처녀상실플래그 = 1
		ENDIF
		;재생처녀상실플래그
		IF TALENT:対象:재생처녀 == 1
			TALENT:対象:재생처녀 = 0
			CFLAG:対象:재생처녀상실플래그 = 1
		ENDIF
		EXP:対象:Ｖ경험 += ABL:対象:Ｖ감각 * 5 + 4 + LOCAL:8
		EXP:対象:성교경험 += ABL:対象:Ｖ감각 * 5 + 4 + LOCAL:8
		EXP:対象:질사경험 += (ABL:対象:Ｖ감각 * 5 + 4 + LOCAL:8)/3
		EXP:対象:정액경험 += (ABL:対象:Ｖ감각 * 5 + 4 + LOCAL:8)/3
		JUEL:対象:쾌Ｖ += ABL:対象:Ｖ감각 * 5 + 4 + LOCAL:8 * 50
		LOCAL:1 += ABL:対象:Ｖ감각
		CONTINUE
	ENDIF

	IF 経験値:LOCAL == "Ｂ"
		JUEL:対象:쾌Ｂ += ABL:対象:Ｂ감각 * 5 + 4 + LOCAL:4 * 50
		LOCAL:1 += ABL:対象:Ｂ감각
		CONTINUE
	ENDIF
	
	IF 経験値:LOCAL == "Ａ"
		EXP:対象:Ａ경험 += ABL:対象:Ａ감각 * 5 + 4 +LOCAL:9
		EXP:対象:성교경험 += ABL:対象:Ａ감각 * 5 + 4 +LOCAL:9
		EXP:対象:정액경험 += (ABL:対象:Ａ감각 * 5 + 4 + LOCAL:9)/3
		JUEL:対象:쾌Ａ += ABL:対象:Ａ감각 * 5 + 4 + LOCAL:9 * 50
		LOCAL:1 += ABL:対象:Ａ감각
		CONTINUE
	ENDIF

	IF 経験値:LOCAL == "他"
		EXP:対象:절정경험 += LOCAL:2 * 2/3
		JUEL:対象:복종 += ABL:対象:순종 * 5 + 7 + LOCAL:1 * 30
		JUEL:対象:욕정 += ABL:対象:욕망 * 5 + 7 + LOCAL:1 * 30
		JUEL:対象:윤활 += (ABL:対象:Ｃ감각 + ABL:対象:Ｂ감각) * 5 + 7 + LOCAL:1 + RAND:10 * 50
		JUEL:対象:굴복 += (ABL:対象:순종 + ABL:対象:욕망 + ABL:対象:봉사정신) * 5 + 7 + LOCAL:1 * 30
		CONTINUE
	ENDIF
	
	IF 経験値:LOCAL == "羞恥"
		EXP:対象:자위경험 += (ABL:対象:욕망 + ABL:対象:자위중독) * 5 + 4 +LOCAL:5
		EXP:対象:조교자위경험 += (ABL:対象:욕망 + ABL:対象:자위중독) * 5 + 4 +LOCAL:5
		JUEL:対象:복종 += ABL:対象:순종 * 5 + 7 + LOCAL:1 * 30
		JUEL:対象:욕정 += ABL:対象:욕망 * 5 + 7 + LOCAL:1 * 30
		JUEL:対象:윤활 += (ABL:対象:Ｃ감각 + ABL:対象:Ｂ감각) * 5 + 7 + LOCAL:1 * 50
		JUEL:対象:굴복 += (ABL:対象:순종 + ABL:対象:욕망 + ABL:対象:노출증) * 5 + 7 + LOCAL:1 * 30
		JUEL:対象:치정 += (ABL:対象:욕망 + ABL:対象:자위중독) * 5 + 7 + LOCAL:1 * 30
		CONTINUE
	ENDIF
	
	IF 経験値:LOCAL == "奉仕"
		EXP:対象:봉사쾌락경험 += ABL:対象:봉사정신 * 5 + 5 + LOCAL:4
		EXP:対象:펠라경험 += ABL:対象:봉사정신 * 5 + 5 + LOCAL:4 * 2/3
		JUEL:対象:굴복 += ABL:対象:봉사정신 * 5 + 7 + LOCAL:1 * 30
		JUEL:対象:습득 += ABL:対象:봉사정신 * 5 + 7 + LOCAL:1 * 30
		CONTINUE
	ENDIF

	IF 経験値:LOCAL == "性交"
		EXP:対象:성교경험 += LOCAL:3
		CONTINUE
	ENDIF

	IF 経験値:LOCAL == "レズ" && !TALENT:対象:남자
		EXP:対象:레즈경험 += LOCAL:2
		CONTINUE
	ENDIF
	
	IF 経験値:LOCAL == "ＢＬ" && TALENT:対象:남자
		EXP:対象:ＢＬ경험 += LOCAL:2
		CONTINUE
	ENDIF

	IF 経験値:LOCAL == "노출"
		EXP:対象:야외노출경험 += ABL:対象:노출증 * 6 + 6 + RAND:10
		JUEL:対象:치정 += ABL:対象:노출증 * 5 + 7 + LOCAL:1 * 30
		CONTINUE
	ENDIF

	IF 経験値:LOCAL == "자위"
		EXP:対象:자위경험 += ABL:対象:자위중독 * 3 + 5 + RAND:6
		CONTINUE
	ENDIF

	IF 経験値:LOCAL == "사정" && TALENT:対象:후타나리 || TALENT:対象:남자
		EXP:対象:사정경험 += LOCAL:2 * 2/3
		CONTINUE
	ENDIF

	IF 経験値:LOCAL == "분유" && TALENT:対象:모유체질
		EXP:対象:분유경험 += ABL:対象:분유중독 * 2 + 3 + RAND:4
		JUEL:対象:쾌Ｂ += ABL:対象:분유중독 * 5 + 7 + LOCAL:1 * 50
		JUEL:対象:굴복 += ABL:対象:분유중독 * 5 + 7 + LOCAL:1 * 30
		JUEL:対象:치정 += ABL:対象:분유중독 * 5 + 7 + LOCAL:1 * 30
		CONTINUE
	ENDIF

	IF 経験値:LOCAL == "촉수"
		EXP:対象:촉수경험 += ABL:対象:촉수중독 * 3 + 5 + RAND:8
		JUEL:対象:굴복 += ABL:対象:촉수중독 * 5 + 7 + LOCAL:1 * 30
		JUEL:対象:고통 += ABL:対象:촉수중독 * 5 + 7 + LOCAL:1 * 30
		JUEL:対象:공포 += ABL:対象:촉수중독 * 5 + 7 + LOCAL:1 * 30
		CONTINUE
	ENDIF

	IF 経験値:LOCAL == "마조"
		EXP:対象:고통쾌락경험 += ABL:対象:마조끼 * 3 + 5 + RAND:5
		JUEL:対象:굴복 += ABL:対象:마조끼 * 5 + 7 + LOCAL:1 * 30
		JUEL:対象:고통 += ABL:対象:마조끼 * 5 + 7 + LOCAL:1 * 30
		JUEL:対象:공포 += ABL:対象:마조끼 * 5 + 7 + LOCAL:1 * 30
		CONTINUE
	ENDIF

	IF 経験値:LOCAL == "새드"
		EXP:対象:가학쾌락경험 += ABL:対象:새드끼 * 3 + 5 + RAND:5
		JUEL:対象:습득 += ABL:対象:새드끼 * 5 + 7 + LOCAL:1 * 30
		CONTINUE
	ENDIF


	IF 経験値:LOCAL == "Ｖ拡張" && !TALENT:対象:남자
		EXP:対象:Ｖ확장경험 += RAND:5
		CONTINUE
	ENDIF
	
	IF 経験値:LOCAL == "Ａ拡張"
		EXP:対象:Ａ확장경험 += RAND:5
		CONTINUE
	ENDIF

	IF 経験値:LOCAL == "긴박"
		EXP:対象:긴박경험 += 3 + RAND:4
		CONTINUE
	ENDIF
	
	IF 経験値:LOCAL == "キス"
		EXP:対象:키스경험 += LOCAL:4 * 2 + RAND:8
		CONTINUE
	ENDIF
		
;	IF 経験値:LOCAL == "口淫"
;		EXP:対象:口淫経験 += 3 + RAND:5
;		CONTINUE
;	ENDIF
	
	IF 経験値:LOCAL == "売春"
		EXP:対象:매춘경험 += 3 + RAND(2, MAX(3, MIN(8, ABL:対象:욕망)))
		CONTINUE
	ENDIF
	
	IF 経験値:LOCAL == "獣姦"
		EXP:対象:수간경험 += 3 + RAND(2, MAX(3, MIN(8, ABL:対象:욕망)))
		CONTINUE
	ENDIF
NEXT




RETURN 1

