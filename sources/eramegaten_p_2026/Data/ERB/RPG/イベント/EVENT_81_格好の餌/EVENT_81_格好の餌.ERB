;公園で休息する
;-------------------------
@RESTING_IN_THE_PARK
#DIM DYNAMIC 陥落キャラリスト,65536
#DIM 候補数
#DIM LCOUNT
#DIM 対象
#DIM 回数

候補数 = 0

;メンバー全員チェック
FOR LCOUNT,0,CHARANUM
	;この場に居ない除外
	SIF CFLAG:LCOUNT:이자리에없는플래그 == 1
		RETURN 0
	SIF CFLAG:LCOUNT:전투이외불능
		RETURN 0
	;レンタル中は除外
	SIF IS_RENTING(LCOUNT)
		CONTINUE
	;人間以外は除外
	SIF IS_HUMAN(LCOUNT) == 0
		CONTINUE
	;陥落していないキャラは除外;信頼系も除外
	SIF (LCOUNT != MASTER && 陥落(LCOUNT) == 0) || 信頼系陥落(LCOUNT) || 동료(LCOUNT)
		CONTINUE
	;体力が25%超は除外
	SIF MAXBASE:LCOUNT:체력 / BASE:LCOUNT:체력 > 4
		CONTINUE
	;体力回復停止中は除外
	SIF CFLAG:LCOUNT:체력회복정지플래그 > 0
		CONTINUE
	;専有奴隷の首輪を装備している場合は対象外
	;→22/06/07：同効果の服を増やして関数にしたので修正
	SIF IS_ANTI_NTR_CLOTHES(LCOUNT) == 1
		CONTINUE
	;全ての例外に当てはまらなかったらリストに追加、候補数+1
	ARRAYSHIFT 陥落キャラリスト, 1, LCOUNT
	候補数++
NEXT

;対象が一人もいないときは終了
SIF 候補数 <= 0
	RETURN 0

;対象を決定
対象 = 陥落キャラリスト:(RAND:候補数)

回数 = 3

PRINTFORMW ＜공원에서 휴식＞
PRINTFORML 
PRINTFORML 
	;体力回復
		BASE:対象:체력 = MIN(MAXBASE:対象:체력 , BASE:対象:체력 + 800)
