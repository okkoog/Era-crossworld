;====================
;陥落者竿姉妹フラグ付与処理
;====================
@MASTER_SEX_TRAIN_OFFERING
#DIM DYNAMIC 陥落キャラリスト,65536
#DIM 候補数
#DIM LCOUNT
#DIM 対象

候補数 = 0

;メンバー全員チェック
FOR LCOUNT,0,CHARANUM
	;この場に居ない除外
	SIF CFLAG:LCOUNT:이자리에없는플래그 == 1
		RETURN 0
	SIF CFLAG:LCOUNT:전투이외불능
		RETURN 0
	;レンタル中は除外
	SIF IS_RENTING(LCOUNT)
		CONTINUE
	;主人ならスキップ
	SIF LCOUNT == MASTER
		CONTINUE
	;対象が男の娘でなくオトコならスキップ
	SIF TALENT:LCOUNT:남자 && !TALENT:LCOUNT:오토코노코
		CONTINUE
	;処女は除外
	SIF TALENT:LCOUNT:처녀 && !TALENT:LCOUNT:재생처녀
		CONTINUE
	;陥落していないキャラは除外;信頼系も除外
	SIF 陥落(LCOUNT) == 0 || 信頼系陥落(LCOUNT) || 동료(LCOUNT)
		CONTINUE
	;専有奴隷の首輪を装備している場合は対象外
	;→22/06/07：同効果の服を増やして関数にしたので修正
	SIF IS_ANTI_NTR_CLOTHES(LCOUNT) == 1
		CONTINUE
	;既にフラグついてるキャラは除外
	SIF CFLAG:LCOUNT:함락자간자매플래그 == 1
		CONTINUE
	;全ての例外に当てはまらなかったらリストに追加、候補数+1
	ARRAYSHIFT 陥落キャラリスト, 1, LCOUNT
	候補数++
NEXT

;竿姉妹イベフラグ確認。オフの時は発生しないようにする
	SIF !GETBIT(FLAG:ＮＴＲ기능 , 1)
		RETURN 0

;候補が一人もいないときは終了
	SIF 候補数 <= 0
		RETURN 0

