	CFLAG:COPEN:개별이벤트플래그1 = 1
	RETURN 0
ELSE
	SKILL_USER = ？？？
	CALL PRINT_ACT_MESSAGE, , [[스킬:SONG OF DIVA]], 0x9065ee, SKILL_USER
	CALL SING_MYTYL
	VARSET 行動決定
	;行動優先度1：敵側の強化段階が-2以下になってるものが三種類以上存在するか。
	VARSET デバフチェック, 0
	FOR LOCAL, 7, 12
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS == -1
			CONTINUE
		SIF CFLAG:(FLAG:LOCALS):상태이상 == GET_STATE_NUM("DYING")
			CONTINUE
		FOR LOCAL:1, 0, 6
			IF CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:1) + "강화") <= -8
				デバフチェック:(LOCAL:1) = 1
			ENDIF
		NEXT
	NEXT
	VARSET 強化配列, 0
	配列引数 = 0
	;デバフチェック:0～5には対応する能力強化が-2段階以上だと1が入る
	FOR LOCAL, 0, 6
		IF デバフチェック:(LOCAL) == 1
			強化配列:配列引数 = LOCAL
			配列引数 += 1
		ENDIF
	NEXT
	;三種類以上なら？
	SIF 配列引数 > 2
		行動決定 = バフ消去
	IF 行動決定 == "バフ消去"
		IF 配列引数 == 3
			LOCAL:1 = 強化配列:0
			LOCAL:2 = 強化配列:1
			LOCAL:3 = 強化配列:2
			FOR LOCAL, 7, 12
				LOCALS = 포지션{LOCAL}
				SIF FLAG:LOCALS == -1
					CONTINUE
				SIF CFLAG:(FLAG:LOCALS):상태이상 == GET_STATE_NUM("DYING")
					CONTINUE
				CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:1) + "강화") = 0
				CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:2) + "강화") = 0
				CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:3) + "강화") = 0
			NEXT
			PRINTFORMW ＞사이버 디바의 노랫소리가 가호를 내린다! 적의 2단계 이상의 약화가 3개 소거되었다!
		ELSE
			DO
				LOCAL:1 = 強化配列:(RAND:(配列引数))
				LOCAL:2 = 強化配列:(RAND:(配列引数))
			;LOCAL:1 == LOCAL:2が1(真)である限りDO～LOOPを繰り返す(つまりLOCAL:1とLOCAL:2が違う値になれば終わるということ)
			LOOP LOCAL:1 == LOCAL:2
			DO
				LOCAL:3 = 強化配列:(RAND:(配列引数))
			LOOP (LOCAL:1 == LOCAL:3) || (LOCAL:2 == LOCAL:3)
			DO
				LOCAL:4 = 強化配列:(RAND:(配列引数))
			LOOP (LOCAL:1 == LOCAL:4) || (LOCAL:2 == LOCAL:4) || (LOCAL:3 == LOCAL:4)
			FOR LOCAL, 7, 12
				LOCALS = 포지션{LOCAL}
				SIF FLAG:LOCALS == -1
					CONTINUE
				SIF CFLAG:(FLAG:LOCALS):상태이상 == GET_STATE_NUM("DYING")
					CONTINUE
				CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:1) + "강화") = 0
				CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:2) + "강화") = 0
				CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:3) + "강화") = 0
				CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:4) + "강화") = 0
			NEXT
			PRINTFORMW ＞사이버 디바의 노랫소리가 가호를 내린다! 적의 2단계 이상의 약화가 4개 소거되었다!
		ENDIF
		RETURN 0
	ENDIF
	;行動優先度2：味方側の強化段階が+4以上になってるものが二種類以上存在するか。
	VARSET バフチェック, 0
	FOR LOCAL, 1, 7
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS == -1
			CONTINUE
		SIF CFLAG:(FLAG:LOCALS):상태이상 == GET_STATE_NUM("DYING")
			CONTINUE
		FOR LOCAL:1, 0, 6
			IF CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:1) + "강화") >= 16
				バフチェック:(LOCAL:1) = 1
			ENDIF
		NEXT
	NEXT
	VARSET 強化配列, 0
	配列引数 = 0
	;バフチェック:0～5には対応する能力強化が+4段階以上だと1が入る
	FOR LOCAL, 0, 6
		IF バフチェック:(LOCAL) == 1
			強化配列:配列引数 = LOCAL
			配列引数 += 1
		ENDIF
	NEXT
	;二種類以上なら？
	SIF 配列引数 > 1
		行動決定 = バフ消去
	IF 行動決定 == "バフ消去"
		IF 配列引数 == 2
			LOCAL:1 = 強化配列:0
			LOCAL:2 = 強化配列:1
			FOR LOCAL, 1, 7
				LOCALS = 포지션{LOCAL}
				SIF FLAG:LOCALS == -1
					CONTINUE
				SIF CFLAG:(FLAG:LOCALS):상태이상 == GET_STATE_NUM("DYING")
					CONTINUE
				CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:1) + "강화") = 0
				CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:2) + "강화") = 0
			NEXT
			PRINTFORMW ＞사이버 디바의 노랫소리가 가호를 내린다! 아군의 4단계 이상의 강화가 2개 소거되었다!
		ELSE
			DO
				LOCAL:1 = 強化配列:(RAND:(配列引数))
				LOCAL:2 = 強化配列:(RAND:(配列引数))
			;LOCAL:1 == LOCAL:2が1(真)である限りDO～LOOPを繰り返す(つまりLOCAL:1とLOCAL:2が違う値になれば終わるということ)
			LOOP LOCAL:1 == LOCAL:2
			DO
				LOCAL:3 = 強化配列:(RAND:(配列引数))
			LOOP (LOCAL:1 == LOCAL:3) || (LOCAL:2 == LOCAL:3)
			FOR LOCAL, 1, 7
				LOCALS = 포지션{LOCAL}
				SIF FLAG:LOCALS == -1
					CONTINUE
				SIF CFLAG:(FLAG:LOCALS):상태이상 == GET_STATE_NUM("DYING")
					CONTINUE
				CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:1) + "강화") = 0
				CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:2) + "강화") = 0
				CFLAG:(FLAG:LOCALS):(GET_BATTLESTATUS(LOCAL:3) + "강화") = 0
			NEXT
			PRINTFORMW ＞사이버 디바의 노랫소리가 가호를 내린다! 아군의 4단계 이상의 강화가 3개 소거되었다!
		ENDIF
		RETURN 0
	ENDIF
	;上記の条件に該当しない場合：一回だけ万能以外の攻撃を無効化（カゲロウ的なアレ）
	;CHARANUM-2 = アキュラ
	SIF BASE:GET_ENEMY("アキュラ"):ＨＰ > 0
		CFLAG:GET_ENEMY("アキュラ"):수호의방패 = 1
	;CHARANUM-1 = ガンヴォルト
	SIF BASE:GET_ENEMY("GV"):ＨＰ > 0
		CFLAG:GET_ENEMY("GV"):수호의방패 = 1
	PRINTFORMW ＞사이버 디바의 노랫소리가 가호를 내린다! 한 번만 만능 이외의 공격을 무효화하게 되었다!
	RETURN 0
ENDIF
