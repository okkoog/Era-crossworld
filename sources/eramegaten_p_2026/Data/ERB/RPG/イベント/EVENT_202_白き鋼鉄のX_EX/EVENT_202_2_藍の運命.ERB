;전용기1 ライトニングスフィア
;전용기2 スパークカリバー
;전용기3 ヴォルティックチェーン
IF CFLAG:ARG:１more플래그 > 0
	IF RAND:2 == 0
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ヴォルティックチェーン")
	ELSE
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "スパークカリバー")
	ENDIF
ELSE
	IF CFLAG:ARG:800 && CFLAG:ARG:행동한횟수 == 0
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "蒼龍の顎門")
	ELSE
		IF CFLAG:ARG:행동한횟수 == 1 && CFLAG:ARG:800
			SELECTCASE RAND:10
				CASE 0 TO 1
					;20%の確率でヴォルティックチェーン
					CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ヴォルティックチェーン")
				CASE 2 TO 5
					;40%の確率でライトニングスフィア
					CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ライトニングスフィア")
				CASEELSE
					;40%の確率でスパークカリバー
					CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "スパークカリバー")
			ENDSELECT
		ELSE
			SELECTCASE RAND:10
				CASE 0
					;10%の確率でヴォルティックチェーン
					CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ヴォルティックチェーン")
				CASE 1 TO 3
					;30%の確率でライトニングスフィア
					CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ライトニングスフィア")
				CASE 4 TO 6
					;30%の確率で八色雷公
					CALL SET_ACTION_SKILL, ARG, [[스킬:팔색뇌공]]
				CASEELSE
					;30%の確率でスパークカリバー
					CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "スパークカリバー")
			ENDSELECT
		ENDIF
	ENDIF
ENDIF

