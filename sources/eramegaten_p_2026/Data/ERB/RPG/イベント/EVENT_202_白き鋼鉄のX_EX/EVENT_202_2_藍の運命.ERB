	SKILL_USER = ？？？
	CALL PRINT_ACT_MESSAGE, , [[스킬:SONG OF DIVA]], 0x9065ee, SKILL_USER
	PRINTL ♪ - 남빛 운명 -　　　　　
	ALIGNMENT LEFT
	SETCOLOR 0x9065ee
	BTL_KOJO_RESULTS:0 = 나의 노래가, 반드시 지킬 테니까――
	TSTR:전투구상캐릭터명칭 '= "？？？"
	TSTR:전투구상캐릭터화상어드레스 '= "アキュラ_X_" + CONVERT_FACE_ADDRESS_アキュラ("ミチル")
	CALL PRINT_KOJO_RPG_MESSAGE, , GET_ENEMY("アキュラ")
	
	PRINTL 　　하늘이 떨어져　소란스러워진　세계의 한구석에서
	PRINTL 　　　조용히 쪽빛을 자아내는 실　생명을 꿰매어 멈추었네
	PRINTL 　
	RESETCOLOR
	PRINTFORMW ＞사이버 디바의 노랫소리가 %CALLNAME:GET_ENEMY("アキュラ")% 일행에게 힘을 준다!
	;CHARANUM-2 = アキュラ
	CALL SKILLGAGE_H_SET, GET_ENEMY("アキュラ"), [[스킬:SONG OF DIVA]], 1
	;これ与えないとＨＰマイナスで生き続けるゾンビになる
	CFLAG:GET_ENEMY("アキュラ"):이악물기플래그 = 1
	;CHARANUM-1 = ガンヴォルト
	CALL SKILLGAGE_H_SET, GET_ENEMY("GV"), [[스킬:SONG OF DIVA]], 1
	;これ与えないとＨＰマイナスで生き続けるゾンビになる
