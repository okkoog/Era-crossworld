FLAG:선제기습취소 = 0

SIF FLAG:패배플래그
	RETURN 0

PRINTFORML 두 사람이 쓰러지자, 등 뒤에 계속 떠 있던 수수께끼의 소녀의 환영도 사라졌다.
PRINTFORML ……어떻게든 살아남은 것 같다.
PRINTFORML 전회의 예를 생각하면, 분명 이것으로 원래 세계로 돌아갈 수 있을 터.
PRINTFORML 그것을 증명하듯 %CALLNAME:MASTER%의 시야가 급격히 일렁이기 시작했고,
PRINTFORMW 가라앉아 가는 의식에 저항하지 않고 몸을 맡겼다.
PRINTFORML ………
PRINTFORML ……
PRINTFORMW …
PRINTFORML ――정신을 차려보니 %CALLNAME:MASTER%은(는), 여느 때와 다름없이 거점의 한 방에 있었다.
PRINTFORML 시계를 확인해 봐도, 시간은 별로 지나지 않았다.
PRINTFORML 또다시 몹시 무시무시한 꿈을 꾸었던 것 같은 기분도 들지만, 안개가 낀 것처럼 기억나지 않는다.
PRINTFORMW ……슬슬 누군가, 신뢰할 수 있는 사람에게 진찰이라도 받아보는 편이 좋을까.
IF GETS_HAVE_ITEM_NUM("다크니스트리거Ｘ") == 0
	CALL GET_ITEMS, "다크니스트리거Ｘ", 1
	SETCOLOR 0xed1a72
	PRINTFORML ※%ACURA_NAME%이(가) 전용 액세서리를 획득했습니다.
	PRINTFORMW 　이것을 장비하면 일부 습득 스킬이 강화됩니다.
	RESETCOLOR
ENDIF
IF GETS_HAVE_ITEM_NUM("번개의렌즈") == 0
	CALL GET_ITEMS, "번개의렌즈", 1
	SETCOLOR 0x144ff4
	PRINTFORML ※%GV_NAME%이(가) 전용 액세서리를 획득했습니다.
	PRINTFORMW 　이것을 장비하면 일부 습득 스킬이 강화됩니다.
	RESETCOLOR
ENDIF
RETURN 1


@SET_ACTION_藍の運命_COPEN, ARG
#DIM DYNAMIC LCOUNT
#LOCALSIZE 1
#LOCALSSIZE 2
#DIM COPEN
#DIM お仕置きスイッチ
#DIM ターン記録
#DIM お仕置き回数
;전용기1 ＥＸウェポン
;CFLAG:800 口上分岐用
;CFLAG:801 ＥＸウェポン制御
;CFLAG:802 ＥＸウェポン有効期間
;CFLAG:803 選択中ＥＸウェポン
CFLAG:ARG:입력행동 = -1
IF TFLAG:400 == 1
	CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "銀虎の絶爪")
	TFLAG:400 = 2
ELSEIF TFLAG:400 == 2
	CALL SET_ACTION_SKILL, ARG, [[스킬:X-ROSS DISASTER]]
	TFLAG:400 = 0
ELSE
	IF CFLAG:ARG:１more플래그 > 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
	ELSE
		SELECTCASE CFLAG:ARG:행동한횟수 - CFLAG:ARG:추가행동횟수
			CASE 0
				COPEN = GETCHARA([[キャラ:아큐라_X]])
				SIF RAND:100 < 40
					CALL SET_ACTION_SKILL, ARG, [[스킬:ＧＵＮ]]
			CASE 1
				SIF RAND:100 < 25
					CALL SET_ACTION_SKILL, ARG, [[스킬:ＧＵＮ]]
			;以降に入るのは不死身フラグ解除後のみ
			CASE 2
				SIF RAND:100 < 66
					CALL SET_ACTION_SKILL, ARG, [[스킬:ＧＵＮ]]
			CASE 3
				SIF RAND:100 < 30
					CALL SET_ACTION_SKILL, ARG, [[스킬:ＧＵＮ]]
			CASE 4
				IF RAND:15 == 0
					CALL SET_ACTION_SKILL, ARG, [[스킬:X-ROSS DISASTER]]
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
IF CFLAG:ARG:입력행동 == -1
	IF CFLAG:ARG:800 == 0
		SELECTCASE TSTR:AI용_BATTLE1
			CASE "赤"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ブレイジングバリスタ")
			CASE "橙"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "グリードスナッチャー")
			CASE "黄"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ミリオンイーター")
			CASE "緑"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "アロガントファング")
			CASE "水"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "レイジーレーザー")
			CASE "紫"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ジェラシックゴルゴン")
			CASE "桃"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ラストドップラー")
			CASEELSE
				CALL SET_ACTION_SKILL, ARG, [[스킬:ＧＵＮ]]
		ENDSELECT
	ELSE
		SELECTCASE TSTR:AI용_BATTLE1
			CASE "赤"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "アイアンファング")
			CASE "橙"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "バンテージライン")
			CASE "黄"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "テイルバンカー")
			CASE "緑"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ワイドサーキット")
			CASE "水"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "アバランチソード")
			CASE "紫"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "プリズムブレイク")
			CASE "桃"
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ハイドロザッパー")
			CASEELSE
				CALL SET_ACTION_SKILL, ARG, [[스킬:ＧＵＮ]]
		ENDSELECT
	ENDIF
ENDIF
@CHANGE_ACTION_藍の運命_COPEN, ARG
#DIM DYNAMIC LCOUNT
IF CFLAG:ARG:입력행동 != [[스킬:짐승의안광]]
	FOR LCOUNT, 1, 7
		SIF POS(LCOUNT) < 0
			CONTINUE
		SIF !IS_TARGET_ABLE(POS(LCOUNT))
			CONTINUE
		SIF !CFLAG:POS(LCOUNT):물리반사플래그 && !CFLAG:POS(LCOUNT):마법반사플래그
			CONTINUE
		CALL SET_ACTION_SKILL, ARG, [[스킬:짐승의안광]]
		TFLAG:400 = 1
		RETURN 1
	NEXT
ENDIF

;====================================================
;ダメージ計算時の追加補正
;
;戻り値
;RESULT:0 = スキルの持ち主に与える補正
;====================================================
@SKILL_PASSIVE_BTL_EFFECT_藍の運命_COPEN, ARGS, L_P, L_ACTOR, L_TARGET, L_相性名, L_相性値, L_ダメージタイプ, L_攻撃タイプ, L_ステート名, L_CRT, SKILL_NUM, GIVE_EFFECT_CHARA
#DIM L_P;スキルの持ち主=自分
#DIM L_ACTOR;攻撃者(どちらかは自分になる)
#DIM L_TARGET;攻撃対象(どちらかは自分になる)
#DIM SKILL_NUM;スキル番号(専用技用)
#DIMS L_相性名;ダメージ計算に使用されている相性の名称
#DIM L_相性値;相性の倍率(999が反射のあれ)
#DIMS L_ダメージタイプ;物理/魔法
#DIMS L_攻撃タイプ;物理/魔法/총/アイテム/割合
#DIMS L_ステート名;バステの名称
#DIM L_CRT;0 = クリティカルしてない/1=クリティカルしている
#DIM GIVE_EFFECT_CHARA;他のキャラが持っているスキルの効果を受けている場合、その持ち主を示す

;自分が攻撃側
IF L_P == L_ACTOR
	SELECTCASE ARGS
	ENDSELECT
;自分が防御側
ELSE
	SELECTCASE ARGS
		CASE "ダメージ倍率"
			SELECTCASE TSTR:AI용_BATTLE1
				CASE "赤"
					SELECTCASE ARGS:1
						CASE "수격"
							RETURN 150
						CASE "화염", "주살"
							RETURN 0
					ENDSELECT
				CASE "橙"
					SELECTCASE ARGS:1
						CASE "빙결"
							RETURN 150
						CASE "중력", "핵열"
							RETURN 0
					ENDSELECT
				CASE "黄"
					SELECTCASE ARGS:1
						CASE "화염"
							RETURN 150
						CASE "비구", "타격"
							RETURN 0
					ENDSELECT
				CASE "緑"
					SELECTCASE ARGS:1
						CASE "전격"
							RETURN 150
						CASE "파마", "지변"
							RETURN 0
					ENDSELECT
				CASE "水"
					SELECTCASE ARGS:1
						CASE "전술"
							RETURN 150
						CASE "검격", "빙결"
							RETURN 0
					ENDSELECT
				CASE "紫"
					SELECTCASE ARGS:1
						CASE "핵열"
							RETURN 150
						CASE "전술", "주살"
							RETURN 0
					ENDSELECT
				CASE "桃"
					SELECTCASE ARGS:1
						CASE "전격"
							RETURN 150
						CASE "수격", "정신"
							RETURN 0
					ENDSELECT
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 0


