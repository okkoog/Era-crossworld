@SET_ACTION_ヘヴィバザルト2, ARG
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM バフチェック
#DIM ガーキルチェック
#DIM TEMP
#DIM 攻撃配列, 2
IF CFLAG:ARG:１more플래그 > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
ELSE
	IF CFLAG:ARG:행동한횟수 == 0
		SELECTCASE FLAG:경과턴수 % 6
			CASE 0
				CALL SET_ACTION_SKILL, ARG, [[스킬:회심의패기]]
			CASE 1
				CALL SET_ACTION_SKILL, ARG, [[스킬:워크라이]]
			CASE 2
				IF RAND:2 == 0
					CALL SET_ACTION_SKILL, ARG, [[스킬:테트라칸]]
				ELSE
					CALL SET_ACTION_SKILL, ARG, [[스킬:마카라칸]]
				ENDIF
			CASE 3
				CALL SET_ACTION_SKILL, ARG, [[스킬:파워브레스]]
			CASE 4
				CALL SET_ACTION_SKILL, ARG, [[스킬:도발]]
			CASEELSE
				CALL SET_ACTION_SKILL, ARG, [[스킬:앉은비차동굴곰]]
		ENDSELECT
	ELSE
		SELECTCASE FLAG:경과턴수 % 6
			CASE 0
				CALL SET_ACTION_SKILL, ARG, [[스킬:천경지폭단]]
			CASE 1
				CALL SET_ACTION_SKILL, ARG, [[스킬:뉴클리어미사일]]
			CASE 2
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ジャッジメントブレード")
			CASE 3
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ガトリングスコール")
			CASE 4
				CALL SET_ACTION_SKILL, ARG, [[스킬:원샷킬]]
			CASEELSE
				CALL SET_ACTION_SKILL, ARG, [[스킬:슈퍼노바]]
		ENDSELECT
	ENDIF
ENDIF

