@SET_ACTION_セラフィックルインX, ARG
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM ターン保存
#DIM SKILL_NUM
#DIM バフチェック
#DIM バフMAXチェック
#DIM デバフチェック
SKILL_NUM = PU_SKILLNUM_GET(ARG, "セラフィックデス")
;CSTR:ARG:전용기1 = シールドストライク
;CSTR:ARG:전용기2 = インフェルノドロップ
;CSTR:ARG:전용기3 = オラージュリーゼ
;CSTR:ARG:전용기4 = ＳＰスキル（今回は使わない）
;CSTR:ARG:전용기5 = エイミングレイ
;CSTR:ARG:전용기6 = タイムフリーザー
;CSTR:ARG:전용기7 = ジャッジメントブレード
;CSTR:ARG:전용기8 = φシュート
;CSTR:ARG:전용기9 = セラフィックデス
IF CFLAG:ARG:１more플래그 > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
;ガンヴォルトあるある：HPが1/3切ったらSPスキル使う　5Tに1回打ってくるぞ
ELSEIF CFLAG:ARG:800 && PU_SKILLGAGE_D_GET(ARG, "セラフィックデス") == 0
	CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "セラフィックデス")
ELSE
	IF RAND:5 == 0
		IF GET_カジャンダ_MAX(ARG) < 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:외법의유혹]]
		ELSEIF GET_カジャンダ_MIN(ARG) < 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:이니셜라이즈]]
		ELSEIF GET_カジャンダ_MAX(ARG) < 32
			CALL SET_ACTION_SKILL, ARG, [[스킬:히트라이저]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:랜더마이저]]
		ENDIF
	ELSE
		IF CFLAG:ARG:행동한횟수 == 0
			IF PU_SKILLGAGE_D_GET(ARG, "シールドストライク") > 0 && RAND:10 > 5
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "インフェルノドロップ")
			ELSE
				SELECTCASE RAND:5
					CASE 0
						CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "シールドストライク")
					CASE 1
						CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "オラージュリーゼ")
					CASE 2
						CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "エイミングレイ")
					CASE 3
						CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "タイムフリーザー")
					CASEELSE
						CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "φシュート")
				ENDSELECT
			ENDIF
		ELSE
			IF PU_SKILLGAGE_D_GET(ARG, "シールドストライク") > 0 && RAND:10 > 3
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "インフェルノドロップ")
			ELSE
				SELECTCASE RAND:6
					CASE 5
						CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "シールドストライク")
					CASE 4
						CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ジャッジメントブレード")
					CASE 3
						CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "φシュート")
					CASE 2
						CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "オラージュリーゼ")
					CASE 1
						CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ジャッジメントブレード")
					CASEELSE
					CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "φシュート")
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ENDIF

