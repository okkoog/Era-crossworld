@SHOPCOM_EVENT_202_1
#DIM DYNAMIC BLADE
#DIM DYNAMIC LCOUNT
CUSTOMDRAWLINE =
BLADE = GETCHARA([[キャラ:블레이드_X]])
LOCAL = 0
IF FLAG_白き鋼鉄のX_進行度 >= 5
	;デマーゼル戦終了済み
	PRINTFORML ――정신을 차려보니 %CALLNAME:MASTER%은(는), 데머즐과 격투를 벌였던 방에 있었다.
	PRINTFORML 두통이 심해, 방금 전까지 어디에 있었는지조차 기억나지 않는다.
	IF BLADE == -1
		PRINTFORML 일단 무슨 일이 일어났는지, 주위를 조사하고자 둘러보자, 저 멀리에 블레이드가 서 있다.
		PRINTFORML 이상하다, 블레이드는 이제 %CALLNAME:MASTER%의 손에 없을 텐데.
	ELSE
		PRINTFORML 일단 무슨 일이 일어났는지, 주위를 조사하고자 둘러보자, 저 멀리에 %CALLNAME:BLADE%이(가) 서 있다.
	ENDIF
ELSE
	;デマーゼル戦まだ
	PRINTFORML ――정신을 차려보니 %CALLNAME:MASTER%은(는), 낯선 방에 있었다.
	PRINTFORML 두통이 심해, 방금 전까지 어디에 있었는지조차 기억나지 않는다.
	PRINTFORML 차폐되어 햇빛조차 닿지 않는 어두운 방. 그러나 어째서일까, 이전에도 이곳에 와 본 적이 있는 것 같은 느낌이 든다.
	IF FLAG_白き鋼鉄のX_進行度 >= 2
		;今周回でブレイドと交戦済み
		IF BLADE == -1
			PRINTFORML 일단 무슨 일이 일어났는지, 주위를 조사하고자 둘러보자, 저 멀리에 블레이드가 서 있다.
			PRINTFORML 이상하다, 블레이드는 이제 %CALLNAME:MASTER%의 손에 없을 텐데.
		ELSE
			PRINTFORML 일단 무슨 일이 일어났는지, 주위를 조사하고자 둘러보자, 저 멀리에 %CALLNAME:BLADE%이(가) 서 있다.
		ENDIF
	ELSE
		;今周回でブレイドと未交戦
		IF BLADE > 0
			PRINTFORML 일단 무슨 일이 일어났는지, 주위를 조사하고자 둘러보자, 저 멀리에 %CALLNAME:BLADE%이(가) 서 있다.
		ELSE
			PRINTFORML 일단 무슨 일이 일어났는지, 주위를 조사하고자 둘러보자, 저 멀리에 가면의 검사가 서 있다.
			LOCAL = 1
		ENDIF
	ENDIF
ENDIF
IF LOCAL == 0
	IF BLADE == -1
		PRINTFORMW 같은 원인으로 이곳에 날려온 것일까? 정보를 공유하고자 다가가자, 블레이드가 이쪽을 향해 시선을 돌리더니 검을 뽑아 들었다.
	ELSE
		PRINTFORMW 같은 원인으로 이곳에 날려온 것일까? 정보를 공유하고자 다가가자, %CALLNAME:BLADE%이(가) 이쪽을 향해 시선을 돌리더니 검을 뽑아 들었다.
	ENDIF
ELSE
	PRINTFORMW 같은 원인으로 이곳에 날려온 것일까? 경계하며 다가가자, 가면의 검사가 이쪽을 향해 시선을 돌리더니 검을 뽑아 들었다.
ENDIF
PRINTFORML 자세를 잡은 모습에는 빈틈이 없고, 심상치 않은 살기가 느껴진다. 아무래도 농담 따위가 아닌 모양이다.
IF LOCAL == 0
	IF BLADE == -1
		PRINTFORMW ……가면을 쓰고 있는 걸 보면, 또 세뇌라도 당한 건가? 하고 생각한 것도 찰나, 블레이드가 벽뢰를 두르고 쇄도해 왔다!
	ELSE
		PRINTFORMW ……가면을 쓰고 있는 걸 보면, 또 세뇌라도 당한 건가? 하고 생각한 것도 찰나, %CALLNAME:BLADE%이(가) 벽뢰를 두르고 쇄도해 왔다!
	ENDIF
ELSE
	PRINTFORMW 그건 그렇고 이런 전개, 역시 어디선가 본 듯한――이라고 생각한 것도 찰나, 가면의 검사가 푸른 빛을 두르고 쇄도해 왔다!
ENDIF
PRINTFORML 　
PRINTFORMW 셉티마 홀더　블레이드가　1체 나타났다!

FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1

CALL SET_BOSS_ENEMY_EVENT_202, "ブレイド"
CALL BATTLE_START

FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0

SIF FLAG:패배플래그
	RETURN 0

IF LOCAL == 0
	IF BLADE == -1
		PRINTFORML 블레이드가 쓰러지자, 그 모습은 안개처럼 사라져 갔다…….
	ELSE
		PRINTFORML %CALLNAME:BLADE%이(가) 쓰러지자, 그 모습은 안개처럼 사라져 갔다…….
	ENDIF
ELSE
	PRINTFORML 가면의 검사가 쓰러지자, 그 모습은 안개처럼 사라져 갔다…….
ENDIF
PRINTFORML 가까스로 쓰러뜨린 것에 안도한 것도 찰나, %CALLNAME:MASTER%은(는) 급격한 현기증에 휩싸였다.
PRINTFORMW 서 있을 수도 없어, 의식이 암전된다――
PRINTFORML ………
PRINTFORML ……
PRINTFORMW …
PRINTFORML ――정신을 차려보니 %CALLNAME:MASTER%은(는), 여느 때와 다름없이 거점의 한 방에 있었다.
PRINTFORML 시계를 확인해 봐도, 시간은 별로 지나지 않았다.
PRINTFORMW 왠지 몹시 무시무시한 꿈을 꾸었던 것 같은 기분도 들지만, 안개가 낀 것처럼 기억나지 않아 단념했다.
IF GETS_HAVE_ITEM_NUM("벽색의뇌정") == 0
	CALL GET_ITEMS, "벽색의뇌정", 1
	SETCOLOR 0x14ffd7
	IF BLADE >= 0
		PRINTFORML ※%CALLNAME:BLADE%의 전용 액세서리를 획득했습니다.
	ELSE
		PRINTFORML ※블레이드의 전용 액세서리를 획득했습니다.
	ENDIF
	PRINTFORMW 　이것을 장비하면 일부 습득 스킬이 강화됩니다.
	RESETCOLOR
ENDIF
RETURN 1

@SET_ACTION_ライトニングベルセルクＸ, ARG
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC WEAKNESS_SWORD
#DIM DYNAMIC WEAKNESS_THUNDER
FOR LCOUNT, 1, 7
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	CALL BTL_CALC_AISYOU, ARG, POS(LCOUNT), , GET_TYPE_NUM("검격")
	WEAKNESS_SWORD += CHECK_WEAKNESS(RESULT) > 0
	CALL BTL_CALC_AISYOU, ARG, POS(LCOUNT), , GET_TYPE_NUM("전격")
	WEAKNESS_THUNDER += CHECK_WEAKNESS(RESULT) > 0
NEXT

IF CFLAG:ARG:１more플래그 > 0
	;ワンモア取る度に気合入るウーマン
	;ダメージ３倍だぞ３倍
	CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
ELSEIF CFLAG:ARG:행동한횟수 == 0
	IF CFLAG:ARG:800
		;1回目の行動は速度補正が高いやつ
		CALL SET_ACTION_SKILL, ARG, [[스킬:퀵버스터]]
	ELSE
		;1回目の行動は速度補正が高いやつ
		IF RAND:2
			CALL SET_ACTION_SKILL, ARG, [[스킬:퀵버스터]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:블리츠레인]]
		ENDIF
	ENDIF
ELSEIF CFLAG:ARG:행동한횟수 == 1
	IF CFLAG:ARG:800
		SELECTCASE RAND:10
			CASE 0 TO 1
				;20%の確率でコレダーデュランダル
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "コレダーデュランダル")
			CASE 2 TO 5
				;40%の確率で吼雷降
				CALL SET_ACTION_SKILL, ARG, [[스킬:헬라이트닝]]
			CASE 6 TO 7
				CALL SET_ACTION_SKILL, ARG, [[스킬:부월쇄파]]
			CASE 8
				CALL SET_ACTION_SKILL, ARG, [[스킬:대나무베기]]
			CASEELSE
				CALL SET_ACTION_SKILL, ARG, [[스킬:토르해머]]
		ENDSELECT
	ELSE
		;PTの半分以上が剣撃弱点　かつ　電撃弱点より数が多かったら？
		IF WEAKNESS_SWORD > 3 && WEAKNESS_SWORD > WEAKNESS_THUNDER
			CALL SET_ACTION_SKILL, ARG, [[스킬:산산조각베기]]
		;PTの半分以上が電撃弱点なら？
		ELSEIF WEAKNESS_THUNDER > 3
			CALL SET_ACTION_SKILL, ARG, [[스킬:썬더볼트]]
		ELSEIF FLAG:경과턴수 % 5 == 1 || FLAG:경과턴수 % 5 == 3
			IF RAND:2
				CALL SET_ACTION_SKILL, ARG, [[스킬:브레이브재퍼]]
			ELSE
				CALL SET_ACTION_SKILL, ARG, [[스킬:부월쇄파]]
			ENDIF
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:토르해머]]
		ENDIF
	ENDIF
ELSE
	;PTの半分以上が剣撃弱点　かつ　電撃弱点より数が多かったら？　あるいは25%
	IF (RAND:4 == 0) || (WEAKNESS_SWORD > 3 && WEAKNESS_SWORD > WEAKNESS_THUNDER)
		CALL SET_ACTION_SKILL, ARG, [[스킬:산산조각베기]]
	;PTの半分以上が電撃弱点なら？　あるいは25%
	ELSEIF (RAND:4 == 0) || (WEAKNESS_THUNDER > 3)
		CALL SET_ACTION_SKILL, ARG, [[스킬:썬더볼트]]
	ELSEIF FLAG:경과턴수 % 5 == 1 || FLAG:경과턴수 % 5 == 3
		IF RAND:2
			CALL SET_ACTION_SKILL, ARG, [[스킬:번개찌르기]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:부월쇄파]]
		ENDIF
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:토르해머]]
	ENDIF
ENDIF

