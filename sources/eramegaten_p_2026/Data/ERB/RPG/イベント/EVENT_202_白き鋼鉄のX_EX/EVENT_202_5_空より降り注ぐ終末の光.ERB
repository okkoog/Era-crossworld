@SET_ACTION_オブリタレーションブラスト2, ARG
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM SKILL_NUM
IF CFLAG:ARG:１more플래그 > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:데・카쟈]]
ELSEIF CFLAG:ARG:気合フラグ > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:뉴클리어미사일]]
ELSEIF CFLAG:ARG:회심의패기플래그 > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:저스티스샷]]
ELSEIF CFLAG:ARG:행동한횟수 == 0
	;ガンヴォルトあるある：HPが1/3切ったらSPスキル使う　5Tに1回打ってくるぞ
	IF CFLAG:ARG:800 && PU_SKILLGAGE_D_GET(ARG, "ＳＰスキル") == 0
		CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "ＳＰスキル")
	ELSE
		SELECTCASE FLAG:경과턴수 % 6
			CASE 0
				CALL SET_ACTION_SKILL, ARG, [[스킬:플래시봄]]
			CASE 1
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "エイミングレイ")
			CASE 2
				CALL SET_ACTION_SKILL, ARG, [[스킬:비구가드브레이크]]
			CASE 3
				IF RAND:2 == 0
					CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
				ELSE
					CALL SET_ACTION_SKILL, ARG, [[스킬:회심의패기]]
				ENDIF
			CASE 4
				CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "エイミングレイ")
			CASEELSE
				CALL SET_ACTION_SKILL, ARG, [[스킬:파워브레스]]
		ENDSELECT
	ENDIF
ELSE
	SELECTCASE FLAG:경과턴수 % 6
		CASE 0
			CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "オプティックラウンド")
		CASE 1
			CALL SET_ACTION_SKILL, ARG, [[스킬:그랜드턱]]
		CASE 2
			IF RAND:2 == 0
				CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
			ELSE
				CALL SET_ACTION_SKILL, ARG, [[스킬:회심의패기]]
			ENDIF
		CASE 3
			CALL SET_ACTION_SKILL, ARG, [[스킬:찰나장대비쏘기]]
		CASE 4
			CALL SET_ACTION_SKILL, ARG, [[스킬:플래시봄]]
		CASEELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:파워브레스]]
	ENDSELECT
ENDIF

