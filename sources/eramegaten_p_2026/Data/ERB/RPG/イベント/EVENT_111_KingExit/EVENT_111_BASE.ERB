;ライセンスフリー
;DRがあるならKEも追加しなきゃあなぁ！？
;2024/06/01 作成者：路傍の木
;====================
;条件
;====================
@PLAYABLE_EVENT_111
;SHOP画面から表示を消す。
;実装分最終フラグでイベントフラグ消滅させる。
SIF イベントフラグ:111:0 == 3
	RETURN 0

LOCAL = GETCHARA([[キャラ:데스포르카_DR]])
;デスポリュカが居るかチェック
SIF LOCAL <= 0
	RETURN 0

;DemonsRootsイベントをクリアしてないとダメ
SIF !GETBIT(CFLAG:LOCAL:개별이벤트읽음, 4)
	RETURN 0

;【King Exit】人類の英雄未クリアで、デスポリュカがパーティにいる
IF イベントフラグ:111:0 == 0 && FINDCHARA_B([[キャラ:데스포르카_DR]]) == 2
	RESULTS = 【King Exit】인류의 영웅 ※DemonsRoots / KingExit의 스포일러를 다수 포함합니다
	RETURN 1
;【King Exit】人類の英雄をクリア済み、かつデスポリュカがパーティにいる
ELSEIF イベントフラグ:111:0 == 1 && FINDCHARA_B([[キャラ:데스포르카_DR]]) == 2
	RESULTS = 【King Exit】성녀의 귀환
	RETURN 1
;伝説の終末をクリア済み
ELSEIF ダンジョンフラグ:103:13 == 1
	RESULTS = 【King Exit】영웅의 여행길
	RETURN 1
ENDIF
RETURN 0

@EVENT_111_聖女の帰還開始条件判定
;デスポリュカと＠のみがパーティにいる事が条件
FOR LOCAL, 1, 7
	;空きポジションは勘定外
	SIF POS(LOCAL) < 0
		CONTINUE
	;主人は勘定外
	SIF POS(LOCAL) == MASTER
		CONTINUE
	;悪魔人はNG
	SIF ABL:POS(LOCAL):종족 == 73
		RETURN 0
	;デスポリュカ・ゲオルイース以外の人間がパーティにいるとNG
	SIF ABL:POS(LOCAL):종족 == 0 && !(GROUPMATCH(NO:POS(LOCAL), [[キャラ:데스포르카_DR]], [[キャラ:게오루이스_KE]]))
		RETURN 0
NEXT
RETURN 1

