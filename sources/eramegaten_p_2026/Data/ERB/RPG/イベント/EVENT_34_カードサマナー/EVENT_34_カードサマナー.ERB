		SPRITECREATED CARD_IMAGE_ID:L_COUNT
		IF !RESULT
			CALL PORTRATE_ID_GET_S, CARD_DATE_S:CBS_NAME, 1
			IF RESULT > 0
				CARD_IMAGE_ID:L_COUNT = %RESULTS:0%
				PRINTFORML %CARD_DATE_S:CBS_NAME%을(를) 설정했습니다.%RESULTS:0%
			ENDIF
		ENDIF
