	LOCAL:6 = (L_INPUT == 1 ? 0 # 1)
	
	L_NAME_C = 0
	FOR L_COUNT, 0, 9999
		IF EXISTCSV(L_COUNT, 0) != 0
			;PRINTFORML %CSVNAME(L_COUNT, 0)%
			L_NAMEV:(L_NAME_C) = L_COUNT
			L_NAMES:(L_NAME_C++) = %CSVNAME(L_COUNT, 0)%
			L_NAMEV:(L_NAME_C) = L_COUNT
			L_NAMES:(L_NAME_C++) = %CSVCALLNAME(L_COUNT, 0)%
		ENDIF
	NEXT
	FOR L_COUNT, 0, VARSIZE("OWN_CARD", 0)
		CALL CARD_DATA_GET(L_COUNT)
		LOCAL:1 = IMAGE_LINE_COUNT(CARD_IMAGE_ID:L_COUNT)
		IF CARD_DATE_V:CBV_NO > 0 && LOCAL:1 != 4 && LOCAL:1 != 6
			LOCAL:3 = 0
			FOR LOCAL, 0, L_NAME_C
				IF CARD_DATE_S:CBS_NAME == L_NAMES:LOCAL
					;PRINTFORML %CSVNAME(L_COUNT, 0)%
					FOR L_IMAGE_N, 0, 64
						LOCALS = A{L_NAMEV:LOCAL}_{L_IMAGE_N * 100 + LOCAL:5}
						LOCAL:2 = IMAGE_LINE_COUNT(LOCALS)
						IF LOCAL:2 == 4 || LOCAL:2 == 6
							CARD_IMAGE_ID:L_COUNT = %LOCALS%
							PRINTFORML %CARD_DATE_S:CBS_NAME%을(를) 설정했습니다.
							LOCAL:3 = 1
							BREAK
						ENDIF
					NEXT
					SIF LOCAL:3 == 1
						BREAK
					
					FOR L_IMAGE_N, 0, 64
						LOCALS = A{L_NAMEV:LOCAL}_{L_IMAGE_N * 100 + LOCAL:6}
						LOCAL:2 = IMAGE_LINE_COUNT(LOCALS)
						IF LOCAL:2 == 4 || LOCAL:2 == 6
							CARD_IMAGE_ID:L_COUNT = %LOCALS%
							PRINTFORML %CARD_DATE_S:CBS_NAME%을(를) 설정했습니다.
							LOCAL:3 = 1
							BREAK
						ENDIF
					NEXT
					SIF LOCAL:3 == 1
						BREAK
				ENDIF
			NEXT
		ENDIF
	NEXT
	PRINTFORMW 설정 완료했습니다.
ELSEIF L_INPUT == 99
	RETURN
ENDIF



