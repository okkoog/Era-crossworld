		L_WARE = 528
		L_PRICE = 15000
		SIF CS_OBTAIN_CARD_GET(528)
			L_PRICE = 7500
	ELSEIF  L_CHOICE == "CARD529"
		L_WARE = 529
		L_PRICE = 7500
	ELSEIF  L_CHOICE == "CARD530"
		L_WARE = 530
		L_PRICE = 7500
	ELSEIF  L_CHOICE == "CARD531"
		L_WARE = 531
		L_PRICE = 7500
	ELSEIF  L_CHOICE == "CARD541"
		L_WARE = 541
		L_PRICE = 15000
		SIF CS_OBTAIN_CARD_GET(541)
			L_PRICE = 7500
	ENDIF
	IF MONEY:5 >= L_PRICE
		PRINTL 
		PRINTFORML %L_CHOICE%　%ITEMNAME:L_WARE%
		PRINTL 수수께끼의 남자
		PRINTFORML 「그 녀석이라면 Ð{L_PRICE}다.」
		PRINTL 　[1]산다　[0]사지 않는다
		INPUT
		IF RESULT == 1
			IF STRFIND(L_CHOICE, "SKILL") >= 0
				ITEM:L_WARE ++
			ELSE
				OWN_CARD:L_WARE += 1
				CALL CS_CARD_CONFIRMATION, L_WARE
			ENDIF
			MONEY:5 -= L_PRICE
			PRINTFORMW 「매번 감사」
		ENDIF
	ELSE
		PRINTL 수수께끼의 남자
		PRINTFORMW 「뭐야, 부족하잖아」
	ENDIF
ENDIF
GOTO LP

