	CALL MESSAGE_WINDOW_ICON, 0, "　", , "수수께끼의 남자", @"디지털머니를 환금해 주고 싶지만…/아무래도 돈이 부족한 모양이군"
	CALL MESSAGE_WINDOW_ICON, 0, "　", , "수수께끼의 남자", @"￥10,000 이상 있으면 환금해 주지"
ELSE
	CALL MESSAGE_WINDOW_ICON, 0, "　", , "수수께끼의 남자", @"여어, 왔냐?/￥10,000을 Ð5,000으로 환금해 주마"
	CALL INPUT_SELECT_D, "[0]￥10,000을 Ð5,000으로 환금한다/[1]환금하지 않는다 "
