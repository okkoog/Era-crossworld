;特技名
@CGSP_NAME_98, ARGS, ARG
RESULTS = 神罰砲

;　コストの量
@CGSP_COST_98, ARGS, ARG
RETURN 8


;　타겟(選択するかしないか)
@CGSP_TARGET_98, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_98, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_98, ARGS, ARG, ARG:1
IF FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_ONESELF
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ENDIF
FOR LOCAL, LOCAL:1, LOCAL:2
	CALL SP_DAMAGE, LOCAL, (FIELD_DEMON_DATE_V:LOCAL:CBV_KINDS > 10 && FIELD_DEMON_DATE_V:LOCAL:CBV_KINDS / 10 == 1 ? 3 # 4), ARG
NEXT
;


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_98, ARGS, ARG, ARG:1
RETURN 1
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_98, ARGS, ARG
RESULTS = 敵仲魔全体にダメージを与え、ライト属性には３Ｐ、それ以外の属性に４Ｐのダメージを与える。場合このＳＰを使った仲魔はフリーズする。『サタン専用のＳＰ』


;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　1(アギとかのダメージ魔法系は1),ダメージ,範囲1体は1、全体は2
@CGSP_TYPE_98, ARGS, ARG
RESULTS = ライト-1
RETURN 1, 4, 2

