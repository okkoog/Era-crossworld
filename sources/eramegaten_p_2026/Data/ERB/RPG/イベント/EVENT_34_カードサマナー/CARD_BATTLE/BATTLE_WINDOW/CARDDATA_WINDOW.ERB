;
;	Module		:DEC2HEX.ERB
;	Facility	:16進数の文字列が欲しいときに使う。ほぼ開発用
;
;	Licence		:ライセンスフリー
;
;	Modification Data:
;
;	Edit	Date			Author					Reason
;	001		2023/09/18		Jガン					ARGの数値を16進数の文字列に変換する。ほぼ開発用
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;--------------------------------------------------------------------
;ARG	カード番号
;ARG:1	表示位置縦
;ARG:2	表示位置横
;ARG:3	表示行
@CARDDATA_WINDOW , ARG , ARG:1 , ARG:2 , ARG:3 = 30
#DIM L_IMAGE_TYPE

L_IMAGE_TYPE = 0
CALL CARD_DATA_GET, ARG
;┏┓┗┛━┃┳┣┻┫╋
SIF ARG:3 < 40
	ARG:3 = 40

CALL SET_PICTURE , @"┏%"━" * 10%┓" , ARG:1 , , ARG:2
FOR LOCAL , 1 , ARG:3 - 1
	CALL SET_PICTURE , @"┃%"　" * 10%┃" , ARG:1 + LOCAL , , ARG:2
NEXT
CALL SET_PICTURE , @"┗%"━" * 10%┛" , ARG:1 + ARG:3 - 1 , , ARG:2
;PRINTFORM {CARD_DATE_V:CBV_NO} {CARD_DATE_V:CBV_KINDS}
IF CARD_DATE_V:CBV_NO > 0 && CARD_DATE_V:CBV_KINDS >= 100
	LOCAL = ARG:1 + 1
	LOCAL:2 = IMAGE_LINE_COUNT(CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO))
	IF LOCAL:2 == 4 || LOCAL:2 == 6
		CALL BF_IMEGE_WINDOW, CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO), ARG:1 + 1, ARG:2 + 2
		SIF LOCAL:2 == 4
			L_IMAGE_TYPE = 1
		SIF LOCAL:2 == 6
			L_IMAGE_TYPE = 2
	ELSE
		LOCAL:2 = 0
		CALL BF_IMEGE_WINDOW, CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO), -1
		IF RESULT
			CALL BF_IMEGE_WINDOW, CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO), ARG:1 + 1, ARG:2 + 2, 6
			L_IMAGE_TYPE = 2
			LOCAL:2 = 6
		ENDIF
	ENDIF
	
	
	CALL SET_PICTURE , "ＮＯ." + TOSTR(CARD_DATE_V:CBV_NO, "000") , ARG:1 , , ARG:2 + 2
	;CALL SET_PICTURE , "아이템" , ARG:1 + (LOCAL:2 > 0 ? 2 # 1), , ARG:2 + (LOCAL:2 > 0 ? 14 # 2)
	IF L_IMAGE_TYPE == 1
		CALL SET_PICTURE , "아이템" , ARG:1 + 3, , ARG:2 + 14
	ELSEIF L_IMAGE_TYPE == 2
		CALL SET_PICTURE , "아이템" , ARG:1 + 4, , ARG:2 + 14
	ELSE
		CALL SET_PICTURE , "아이템" , ARG:1 + 1, , ARG:2 + 2
	ENDIF
	CALL SET_PICTURE , @"%CARD_DATE_S:CBS_NAME,20,RIGHT%" , ARG:1 + (LOCAL:2 > 0 ? 7 # 2), , ARG:2 + 2
	
	IF CARD_DATE_V:CBV_KINDS == 100
		LOCALS = 그외
	ELSEIF CARD_DATE_V:CBV_KINDS == 101
		LOCALS = 銃火器
	ELSEIF CARD_DATE_V:CBV_KINDS == 102
		LOCALS = 強化
	ELSEIF CARD_DATE_V:CBV_KINDS == 103
		LOCALS = 회복
	ELSEIF CARD_DATE_V:CBV_KINDS == 104
		LOCALS = 呪具
	ELSEIF CARD_DATE_V:CBV_KINDS == 105
		LOCALS = 武具
	ELSEIF CARD_DATE_V:CBV_KINDS == 106
		LOCALS = 소프트
	ELSEIF CARD_DATE_V:CBV_KINDS == 107
		LOCALS = COMP
	ENDIF
	CALL SET_PICTURE , LOCALS , ARG:1 + 6 , , ARG:2 + (LOCAL:2 > 0 ? 14 # 2)
	IF L_IMAGE_TYPE == 1
		CALL SET_PICTURE , @"Ｒ{CARD_DATE_V:CBV_RARITY,2}" , ARG:1 + 1 , , ARG:2 + 10
		CALL SET_PICTURE , @"%"★" * (CARD_DATE_V:CBV_RARITY / 5)%,{COLOR("ショッキングピンク")}_%"☆" * (CARD_DATE_V:CBV_RARITY % 5)%,{COLOR("WHITE")}" , ARG:1 + 2 , , ARG:2 + 10
	ELSEIF L_IMAGE_TYPE == 2
		CALL SET_PICTURE , @"Ｒ{CARD_DATE_V:CBV_RARITY,2}" , ARG:1 + 1 , , ARG:2 + 14
		IF CARD_DATE_V:CBV_RARITY < 5
			CALL SET_PICTURE , @"%"☆" * (CARD_DATE_V:CBV_RARITY % 5)%,{COLOR("WHITE")}" , ARG:1 + 2 , , ARG:2 + 14
		ELSEIF CARD_DATE_V:CBV_RARITY >= 5
			CALL SET_PICTURE , @"%"★" * (CARD_DATE_V:CBV_RARITY / 5)%,{COLOR("ショッキングピンク")}" , ARG:1 + 2 , , ARG:2 + 14
			SIF CARD_DATE_V:CBV_RARITY % 5 > 0
				CALL SET_PICTURE , @"%"☆" * (CARD_DATE_V:CBV_RARITY % 5)%,{COLOR("WHITE")}" , ARG:1 + 3 , , ARG:2 + 14
		ENDIF
	ELSE
		CALL SET_PICTURE , @"Ｒ{CARD_DATE_V:CBV_RARITY,2}_%"★" * (CARD_DATE_V:CBV_RARITY / 5)%,{COLOR("ショッキングピンク")}_%"☆" * (CARD_DATE_V:CBV_RARITY % 5)%,{COLOR("WHITE")}" , ARG:1 + 7 , , ARG:2 + 2
	ENDIF
	LOCAL = ARG:1 + 8
	CALL SET_PICTURE , @"┣%"━" * 10%┫" , LOCAL++ , , ARG:2
	LOCALS = COST：
	IF CARD_DATE_V:CBV_FUSION == 2
		LOCALS += "② "
	ELSEIF CARD_DATE_V:CBV_FUSION == 3
		LOCALS += "③ "
	ELSE
		LOCALS += "● "
	ENDIF
	LOCALS += @"{CARD_DATE_V:CBV_COST}%"ﾛ" * CARD_DATE_V:CBV_OFFERING%"
	CALL SET_PICTURE , LOCALS , LOCAL++ , , ARG:2 + 2
	LOCAL++
	CALL SET_PICTURE , @"┣%"━" * 10%┫" , LOCAL++ , , ARG:2
	
	LOCAL:1 = 0
	WHILE STRLENS(SUBSTRING_T(CARD_DATE_S:CBS_COMMENTARY, LOCAL:1, 19)) > 0
		CALL SET_PICTURE , @"%SUBSTRING_T(CARD_DATE_S:CBS_COMMENTARY, LOCAL:1, 19)%" , LOCAL++ , , ARG:2 + 2
		LOCAL:1 += STRLENS(SUBSTRING_T(CARD_DATE_S:CBS_COMMENTARY, LOCAL:1, 19))
	WEND
	
ELSEIF CARD_DATE_V:CBV_NO > 0 && CARD_DATE_V:CBV_KINDS >= 0
	CALL SET_PICTURE , "ＮＯ." + TOSTR(CARD_DATE_V:CBV_NO, "000") , ARG:1 , , ARG:2 + 2
	LOCAL = ARG:1 + 1
	LOCAL:2 = IMAGE_LINE_COUNT(CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO))
	IF LOCAL:2 == 4 || LOCAL:2 == 6
		CALL BF_IMEGE_WINDOW, CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO), ARG:1 + 1, ARG:2 + (LOCAL:2 == 6 ? 10 # 14)
		SIF LOCAL:2 == 4
			L_IMAGE_TYPE = 1
		SIF LOCAL:2 == 6
			L_IMAGE_TYPE = 2
	ELSE
		LOCAL:2 = 0
		CALL BF_IMEGE_WINDOW, CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO), -1
		IF RESULT
			L_IMAGE_TYPE = 2
			LOCAL:2 = 6
			CALL BF_IMEGE_WINDOW, CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO), ARG:1 + 1, ARG:2 + 10, 6
		ENDIF
	ENDIF
	
	
	CALL SET_PICTURE , CARD_DATE_S:CBS_RACE , ARG:1 + (LOCAL:2 > 0 ? 5 # 1), , ARG:2 + 2
	CALL CGDEMON_CURSOR_EXPLAIN(CARD_DATE_S:CBS_COMMENTARY , CARD_DATE_S:CBS_APPEARANCE)
	CALL SET_PICTURE , @"%CARD_DATE_S:CBS_NAME,20,RIGHT%,,,,%RESULTS%" , ARG:1 + (LOCAL:2 > 0 ? 7 # 2), , ARG:2 + 2
	LOCAL += 3
	CALL SET_PICTURE , @"%ALIGNMENT_PICTURE(CARD_DATE_V:CBV_KINDS,(LOCAL:2 == 6 ? 1 # 0))%_" , ARG:1 + 6 , , ARG:2 + 2
;	IF CARD_DATE_V:CBV_KINDS > 10 && CARD_DATE_V:CBV_KINDS < 34
;		CALL SET_PICTURE , @"%GET_ALI1(CARD_DATE_V:CBV_KINDS / 10)%,{CS_ALICOLOR(0,CARD_DATE_V:CBV_KINDS / 10)}_-_%GET_ALI2(CARD_DATE_V:CBV_KINDS % 10)%,{CS_ALICOLOR(1,CARD_DATE_V:CBV_KINDS % 10)}_" , LOCAL++ , , ARG:2 + 2
;	ELSEIF CARD_DATE_V:CBV_KINDS == 1
;		CALL SET_PICTURE , @"Unkown,{KINDSCOLOR(CARD_DATE_V:CBV_KINDS)}" , LOCAL++ , , ARG:2 + 2
;	ELSE
;		CALL SET_PICTURE , @"None,{KINDSCOLOR(CARD_DATE_V:CBV_KINDS)}" , LOCAL++ , , ARG:2 + 2
;	ENDIF
	IF LOCAL:2 > 0
		CALL SET_PICTURE , @"Ｒ{CARD_DATE_V:CBV_RARITY,2}" , ARG:1 + 1 , , ARG:2 + 2
		IF L_IMAGE_TYPE == 1
			CALL SET_PICTURE , @"%"★" * (CARD_DATE_V:CBV_RARITY / 5)%,{COLOR("ショッキングピンク")}_%"☆" * (CARD_DATE_V:CBV_RARITY % 5)%,{COLOR("WHITE")}" , ARG:1 + 2 , , ARG:2 + 2
		ELSEIF L_IMAGE_TYPE == 2
			IF CARD_DATE_V:CBV_RARITY < 5
				CALL SET_PICTURE , @"%"☆" * (CARD_DATE_V:CBV_RARITY % 5)%,{COLOR("WHITE")}" , ARG:1 + 2 , , ARG:2 + 2
			ELSEIF CARD_DATE_V:CBV_RARITY >= 5
				CALL SET_PICTURE , @"%"★" * (CARD_DATE_V:CBV_RARITY / 5)%,{COLOR("ショッキングピンク")}" , ARG:1 + 2 , , ARG:2 + 2
				SIF CARD_DATE_V:CBV_RARITY % 5 > 0
					CALL SET_PICTURE , @"%"☆" * (CARD_DATE_V:CBV_RARITY % 5)%,{COLOR("WHITE")}" , ARG:1 + 3 , , ARG:2 + 2
			ENDIF
		ENDIF
	ELSE
		CALL SET_PICTURE , @"Ｒ{CARD_DATE_V:CBV_RARITY,2}_%"★" * (CARD_DATE_V:CBV_RARITY / 5)%,{COLOR("ショッキングピンク")}_%"☆" * (CARD_DATE_V:CBV_RARITY % 5)%,{COLOR("WHITE")}" , ARG:1 + 7 , , ARG:2 + 2
	ENDIF
	
	LOCAL = ARG:1 + 8
	CALL SET_PICTURE , @"┣%"━" * 10%┫" , LOCAL++ , , ARG:2
	LOCALS = COST：
	IF CARD_DATE_V:CBV_FUSION == 2
		LOCALS += "② "
	ELSEIF CARD_DATE_V:CBV_FUSION == 3
		LOCALS += "③ "
	ELSE
		LOCALS += "● "
	ENDIF
	LOCALS += @"{CARD_DATE_V:CBV_COST}%"ﾛ" * CARD_DATE_V:CBV_OFFERING%"
	CALL SET_PICTURE , LOCALS , LOCAL++ , , ARG:2 + 2
	CALL SET_PICTURE , @"　AP：{CARD_DATE_V:CBV_AP,2}　HP：{CARD_DATE_V:CBV_HP,2}" + (CARD_DATE_V:CBV_FLIGHT > 0 ? " 飛" # " 歩") , LOCAL++ , , ARG:2 + 2
	CALL SET_PICTURE , @"┣%"━" * 10%┫" , LOCAL++ , , ARG:2

	TRYCCALLFORM CGSP_NAME_{CARD_DATE_V:CBV_SP1}, CARD_DATE_S:CBS_SP1_SUB, CARD_DATE_V:CBV_NO
		LOCALS = SP1:
		IF CARD_DATE_S:CBS_SP1_NAME_CHANGE != ""
			LOCALS += CARD_DATE_S:CBS_SP1_NAME_CHANGE
		ELSE
			LOCALS += RESULTS
		ENDIF
		CALL CGSP_CURSOR_EXPLAIN(CARD_DATE_V:CBV_SP1 , CARD_DATE_V:CBV_NO , CARD_DATE_S:CBS_SP1_SUB, CARD_DATE_S:CBS_SP1_NAME_CHANGE)
		CALL SET_PICTURE , LOCALS + ",,,," + RESULTS , LOCAL++ , , ARG:2 + 2
		CALLFORM CGSP_TIMING_{CARD_DATE_V:CBV_SP1}, CARD_DATE_S:CBS_SP1_SUB, CARD_DATE_V:CBV_NO
		IF RESULT > 0
			LOCALS:1 = 自動発動
		ELSE
			CALLFORM CGSP_COST_{CARD_DATE_V:CBV_SP1}, CARD_DATE_S:CBS_SP1_SUB, CARD_DATE_V:CBV_NO
			LOCALS:1 = ｺｽﾄ：{RESULT,2}
			CALLFORM CGSP_ACTION_AFTER_{CARD_DATE_V:CBV_SP1}, CARD_DATE_S:CBS_SP1_SUB, CARD_DATE_V:CBV_NO
			IF RESULT == 1
				LOCALS:1 += @"_▼,{COLOR("パ赤")}"
			ELSEIF RESULT == 2
				LOCALS:1 += @"_■,{COLOR("藍色")}"
			ELSEIF RESULT == 3
				LOCALS:1 += @"_◆,{COLOR("LIGHT-YELLOW")}"
			ENDIF
		ENDIF
		CALL SET_PICTURE , LOCALS:1 , LOCAL++ , , ARG:2 + 2
		CALL SET_PICTURE , @"┣%"━" * 10%┫" , LOCAL++ , , ARG:2
		CALLFORM CGSP_EXPLAIN_{CARD_DATE_V:CBV_SP1}, CARD_DATE_S:CBS_SP1_SUB, CARD_DATE_V:CBV_NO
		LOCALS:2 '= RESULTS
		LOCAL:1 = 0
		WHILE STRLENS(SUBSTRING_T(LOCALS:2, LOCAL:1, 19)) > 0 && LOCAL < 48
			CALL SET_PICTURE , @"%SUBSTRING_T(LOCALS:2, LOCAL:1, 19),20,LEFT%" , LOCAL++ , , ARG:2 + 2
			LOCAL:1 += STRLENS(SUBSTRING_T(LOCALS:2, LOCAL:1, 19))
			SIF CARD_DATE_V:CBV_SP2 > 0 && LOCAL > 38
				BREAK
		WEND
		;CALL SET_PICTURE , SUBSTRING(LOCALS:2, 0, 20) , LOCAL++ , , ARG:2 + 2
		;CALL SET_PICTURE , SUBSTRING(LOCALS:2, 20, 20) , LOCAL++ , , ARG:2 + 2
		;CALL SET_PICTURE , SUBSTRING(LOCALS:2, 40, 20) , LOCAL++ , , ARG:2 + 2
		;CALL SET_PICTURE , SUBSTRING(LOCALS:2, 60, 20) , LOCAL++ , , ARG:2 + 2
		;CALL SET_PICTURE , SUBSTRING(LOCALS:2, 80, 20) , LOCAL++ , , ARG:2 + 2
		
	CATCH
		;LOCALS += "----------------"
		;CALL SET_PICTURE , LOCALS , LOCAL++ , , ARG:2 + 2
		;CALL SET_PICTURE , "ｺｽﾄ： 0" , LOCAL++ , , ARG:2 + 2
		;CALL SET_PICTURE , @"┣%"━" * 10%┫" , LOCAL++ , , ARG:2
		;LOCAL += 5
		;CALL SET_PICTURE , @"┣%"━" * 10%┫" , LOCAL++ , , ARG:2
	ENDCATCH
	
	IF LOCAL < 48
		TRYCCALLFORM CGSP_NAME_{CARD_DATE_V:CBV_SP2}, CARD_DATE_S:CBS_SP2_SUB, CARD_DATE_V:CBV_NO
			CALL SET_PICTURE , @"┣%"━" * 10%┫" , LOCAL++ , , ARG:2
			LOCALS = SP2:
			IF CARD_DATE_S:CBS_SP2_NAME_CHANGE != ""
				LOCALS += CARD_DATE_S:CBS_SP2_NAME_CHANGE
			ELSE
				LOCALS += RESULTS
			ENDIF
			CALL CGSP_CURSOR_EXPLAIN(CARD_DATE_V:CBV_SP2 , CARD_DATE_V:CBV_NO , CARD_DATE_S:CBS_SP2_SUB, CARD_DATE_S:CBS_SP2_NAME_CHANGE)
			CALL SET_PICTURE , LOCALS + ",,,," + RESULTS , LOCAL++ , , ARG:2 + 2
			CALLFORM CGSP_TIMING_{CARD_DATE_V:CBV_SP2}, CARD_DATE_S:CBS_SP2_SUB, CARD_DATE_V:CBV_NO
			IF RESULT > 0
				LOCALS:1 = 自動発動
			ELSE
				CALLFORM CGSP_COST_{CARD_DATE_V:CBV_SP2}, CARD_DATE_S:CBS_SP2_SUB, CARD_DATE_V:CBV_NO
				LOCALS:1 = ｺｽﾄ：{RESULT,2}
				CALLFORM CGSP_ACTION_AFTER_{CARD_DATE_V:CBV_SP2}, CARD_DATE_S:CBS_SP2_SUB, CARD_DATE_V:CBV_NO
				IF RESULT == 1
					LOCALS:1 += @"_▼,{COLOR("パ赤")}"
				ELSEIF RESULT == 2
					LOCALS:1 += @"_■,{COLOR("藍色")}"
				ELSEIF RESULT == 3
					LOCALS:1 += @"_◆,{COLOR("LIGHT-YELLOW")}"
				ENDIF
			ENDIF
			CALL SET_PICTURE , LOCALS:1 , LOCAL++ , , ARG:2 + 2
			CALL SET_PICTURE , @"┣%"━" * 10%┫" , LOCAL++ , , ARG:2
			CALLFORM CGSP_EXPLAIN_{CARD_DATE_V:CBV_SP2}, CARD_DATE_S:CBS_SP2_SUB, CARD_DATE_V:CBV_NO
			LOCALS:2 '= RESULTS
			LOCAL:1 = 0
			WHILE STRLENS(SUBSTRING_T(LOCALS:2, LOCAL:1, 19)) > 0 && LOCAL < 48
				CALL SET_PICTURE , @"%SUBSTRING_T(LOCALS:2, LOCAL:1, 19),20,LEFT%" , LOCAL++ , , ARG:2 + 2
				LOCAL:1 += STRLENS(SUBSTRING_T(LOCALS:2, LOCAL:1, 19))
			WEND
			;CALL SET_PICTURE , SUBSTRING(LOCALS:2, 0, 20) , LOCAL++ , , ARG:2 + 2
			;CALL SET_PICTURE , SUBSTRING(LOCALS:2, 20, 20) , LOCAL++ , , ARG:2 + 2
			;CALL SET_PICTURE , SUBSTRING(LOCALS:2, 40, 20) , LOCAL++ , , ARG:2 + 2
			;CALL SET_PICTURE , SUBSTRING(LOCALS:2, 60, 20) , LOCAL++ , , ARG:2 + 2
			;CALL SET_PICTURE , SUBSTRING(LOCALS:2, 80, 20) , LOCAL++ , , ARG:2 + 2
			;CALL SET_PICTURE , @"┣%"━" * 10%┫" , LOCAL++ , , ARG:2
			
		CATCH
			;LOCALS += "----------------"
			;CALL SET_PICTURE , LOCALS , LOCAL++ , , ARG:2 + 2
			;CALL SET_PICTURE , "ｺｽﾄ： 0" , LOCAL++ , , ARG:2 + 2
			;CALL SET_PICTURE , @"┣%"━" * 10%┫" , LOCAL++ , , ARG:2
			;LOCAL += 5
			;CALL SET_PICTURE , @"┣%"━" * 10%┫" , LOCAL++ , , ARG:2
		ENDCATCH
	ENDIF
ENDIF



@CS_ALICOLOR(ARG , ARG:1)
#FUNCTION
SIF ARG:1 < 1
	RETURNF COLOR("DEFAULT")
IF ARG == 0
	RETURNF TOINT(AUTO_SPLIT(@"{COLOR("黄色")}_{COLOR("パ緑")}_{COLOR("灰色")}" , "_" , ARG:1-1))
ELSE
	RETURNF TOINT(AUTO_SPLIT(@"{COLOR("暗水色")}_{COLOR("パ緑")}_{COLOR("RED")}" , "_" , ARG:1-1))
ENDIF

@KINDSCOLOR(ARG)
#FUNCTION
IF 0
ELSEIF ARG == 0
	RETURNF COLOR("PINK")
ELSEIF ARG == 1
	RETURNF COLOR("パ紫")
ELSEIF ARG == 11
	RETURNF COLOR("AQUA")
ELSEIF ARG == 12
	RETURNF COLOR("黄色")
ELSEIF ARG == 13
	RETURNF 0xEE7800
ELSEIF ARG == 21
	RETURNF COLOR("暗水色")
ELSEIF ARG == 22
	RETURNF COLOR("パ緑")
ELSEIF ARG == 23
	RETURNF COLOR("RED")
ELSEIF ARG == 31
	RETURNF COLOR("藍色")
ELSEIF ARG == 32
	RETURNF COLOR("灰色")
ELSEIF ARG == 33
	RETURNF 0x660000
ELSEIF ARG >= 100
	RETURNF COLOR("WHITE")
ENDIF

@RARITYCOLOR(ARG , ARG:1)
#FUNCTION
IF 0
ELSEIF ARG <= 3
	RETURNF COLOR("WHITE")
ELSEIF ARG <= 6
	RETURNF 0xb87333
ELSEIF ARG <= 9
	RETURNF COLOR("LIGHT-GRAY")
ELSEIF ARG <= 12
	RETURNF COLOR("LIGHT-YELLOW")
ELSE
	RETURNF COLOR("ショッキングピンク")
ENDIF


@CGSP_CURSOR_EXPLAIN(ARG , ARG:1 , ARGS , ARGS:1 = "")
CALLFORM CGSP_NAME_{ARG}, ARGS, ARG:1
IF ARGS:1 != ""
	LOCALS '= ARGS:1
ELSE
	LOCALS '= RESULTS
ENDIF
LOCALS += UNICODE(0x000D)

CALLFORM CGSP_TIMING_{ARG}, ARGS, ARG:1
IF RESULT > 0
	LOCALS:1 = 自動発動
ELSE
	CALLFORM CGSP_COST_{ARG}, ARGS, ARG:1
	LOCALS:1 = ｺｽﾄ：{RESULT,2}
	CALLFORM CGSP_ACTION_AFTER_{ARG}, ARGS, ARG:1
	IF RESULT == 1
		LOCALS:1 += "▼"
	ELSEIF RESULT == 2
		LOCALS:1 += "■"
	ELSEIF RESULT == 3
		LOCALS:1 += "◆"
	ENDIF
ENDIF
		

CALLFORM CGSP_EXPLAIN_{ARG}, ARGS, ARG:1
LOCALS:2 '= RESULTS
LOCAL = 0
WHILE STRLENS(SUBSTRING(LOCALS:2, LOCAL, 40)) > 0
	LOCALS:1 += UNICODE(0x000D) + SUBSTRING(LOCALS:2, LOCAL, 40)
	LOCAL += 40
WEND

RESULTS '= LOCALS + LOCALS:1

@CGDEMON_CURSOR_EXPLAIN(ARGS , ARGS:1)
LOCAL = 0
RESULTS = 해설
RESULTS += UNICODE(0x000D)
WHILE STRLENS(SUBSTRING(ARGS, LOCAL, 60)) > 0
	RESULTS += SUBSTRING(ARGS, LOCAL, 60) + UNICODE(0x000D)
	LOCAL += 60
WEND
RESULTS += UNICODE(0x000D)
RESULTS += "登場作品　" + ARGS:1
