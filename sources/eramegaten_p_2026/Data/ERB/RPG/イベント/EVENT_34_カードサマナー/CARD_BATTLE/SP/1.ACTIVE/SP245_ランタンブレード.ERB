
;特技名
@CGSP_NAME_245, ARGS, ARG
RESULTS = ランタンブレード

;　コストの量
@CGSP_COST_245, ARGS, ARG
RETURN 2
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_245, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_245, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_245, ARGS, ARG, ARG:1
;
#DIM L_HOST
#DIM L_A
L_HOST = FIELD_DEMON_DATE_V:ARG:CBV_HOST

IF L_HOST == CS1_ONESELF
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ENDIF
L_A = 1
FOR LOCAL, LOCAL:1, LOCAL:2
	SIF ARG == LOCAL
		CONTINUE
	IF STRFIND(FIELD_DEMON_DATE_S:LOCAL:CBS_NAME, "ジャック") >= 0 && FIELD_DEMON_DATE_V:LOCAL:CBV_NO > 0
        L_A = 2
		BREAK
	ENDIF
NEXT

CALL CB_STATE_ADD, ARG, 301, 1
CALL SP_PUWER_UP, ARG, L_A, -1

;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_245, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_245, ARGS, ARG
RESULTS = このＳＰを使うと使った仲魔はこのターンの間、ＡＰ＋１／ＨＰ－１と『先制』状態になる。自身の場に自分を除く味方の名前に「ジャック」が付く仲魔がいる場合「ＡＰ＋２」になる。『パワーアップし、さらに攻撃を先に当てることができるＳＰ』


;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　2(このターンパワーアップは2),AP,HP,自身は1、他人は2、全体は3
@CGSP_TYPE_245, ARGS, ARG
#DIM L_HOST
#DIM L_A
L_HOST = FIELD_DEMON_DATE_V:ARG:CBV_HOST

IF L_HOST == CS1_ONESELF
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ENDIF
L_A = 1
FOR LOCAL, LOCAL:1, LOCAL:2
	SIF ARG == LOCAL
		CONTINUE
	IF STRFIND(FIELD_DEMON_DATE_S:LOCAL:CBS_NAME, "ジャック") >= 0 && FIELD_DEMON_DATE_V:LOCAL:CBV_NO > 0
        L_A = 2
		BREAK
	ENDIF
NEXT

RESULTS = 先制
RETURN 2, L_A, -1, 1

