
;特技名
@CGSP_NAME_649, ARGS, ARG
RESULTS = 雲の咆哮

;　コストの量
@CGSP_COST_649, ARGS, ARG
RETURN 2
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_649, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_649, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_649, ARGS, ARG, ARG:1

FIELD_DEMON_DATE_V:ARG:CBV_B_HP -= 2
FIELD_DEMON_DATE_V:ARG:CBV_HP -= 2

CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(ARG) + @"は基礎HP:-2になった。"

CALL CB_S_STATE_ADD, FIELD_DEMON_DATE_V:ARG:CBV_HOST, 9, 2

;CALL CS_DICEROLL_S_STATE,999, ARG, FIELD_DEMON_DATE_V:ARG:CBV_HOST, 8, 1, 2

;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_649, ARGS, ARG, ARG:1
RETURN 1
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_649, ARGS, ARG
RESULTS = 基礎HPを-2にし、自ｻﾏﾅｰを「飛行防壁」状態にして、飛行仲魔へのｱﾀｯｸを無効化する。ただし、このＳＰを使った仲魔はフリーズする。『インドラジット専用のＳＰ』

;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　42 自サマナーに状態付与（バフ）
@CGSP_TYPE_649, ARGS, ARG
RETURN 42, 9

