
;特技名
@CGSP_NAME_230, ARGS, ARG
RESULTS = ガリアンソード

;　コストの量
@CGSP_COST_230, ARGS, ARG
RETURN 1
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_230, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_230, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_230, ARGS, ARG, ARG:1
;
#DIM L_HOST
L_HOST = FIELD_DEMON_DATE_V:ARG:CBV_HOST
;HAND_CARDS(L_HOST)

IF HAND_CARDS(L_HOST) <= 4
    CALL SP_PUWER_UP, ARG, 2, 0
ELSE
    CALL SP_PUWER_UP, ARG, 1, 0
ENDIF

;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_230, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_230, ARGS, ARG
RESULTS = このＳＰを使うと使った仲魔はこのターンの間、ＡＰ＋１になる。使用時に自身のサマナーの手札が４枚以下の場合、ＡＰ＋２になる。『パワーアップするＳＰ』


;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　2(このターンパワーアップは2),AP,HP,自身は1、他人は2、全体は3
@CGSP_TYPE_230, ARGS, ARG
IF HAND_CARDS(FIELD_DEMON_DATE_V:ARG:CBV_HOST) <= 4
    RETURN 2, 2, 0, 1
ELSE
    RETURN 2, 1, 0, 1
ENDIF

