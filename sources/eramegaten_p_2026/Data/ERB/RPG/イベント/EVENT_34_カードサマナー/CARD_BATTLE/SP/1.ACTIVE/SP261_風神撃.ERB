
;特技名
@CGSP_NAME_261, ARGS, ARG
RESULTS = 풍신격

;　コストの量
@CGSP_COST_261, ARGS, ARG
RETURN 3
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_261, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_261, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_261, ARGS, ARG, ARG:1
;
CALL SP_PUWER_UP, ARG, 5, -5, 2, 5


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_261, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　3(防御時パワーアップは3),AP,HP,自身は1、他人は2、全体は3
@CGSP_TYPE_261, ARGS, ARG
RETURN 3, 5, -5, 1

