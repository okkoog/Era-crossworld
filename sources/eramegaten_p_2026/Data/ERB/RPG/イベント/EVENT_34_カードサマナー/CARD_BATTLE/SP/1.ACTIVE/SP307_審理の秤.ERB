
;特技名
@CGSP_NAME_307, ARGS, ARG
RESULTS = 審理の秤

;　コストの量
@CGSP_COST_307, ARGS, ARG
RETURN 1


;　타겟(選択するかしないか)
@CGSP_TARGET_307, ARGS, ARG
RETURN 3
