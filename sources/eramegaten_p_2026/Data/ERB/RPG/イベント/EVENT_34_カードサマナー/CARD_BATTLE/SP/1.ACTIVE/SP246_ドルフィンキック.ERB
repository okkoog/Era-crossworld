
;特技名
@CGSP_NAME_246, ARGS, ARG
RESULTS = 돌핀킥

;　コストの量
@CGSP_COST_246, ARGS, ARG
RETURN 5
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_246, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_246, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_246, ARGS, ARG, ARG:1
;
CALL SP_PUWER_UP, ARG, 3, 0, 2, 6


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_246, ARGS, ARG, ARG:1
RETURN 0
