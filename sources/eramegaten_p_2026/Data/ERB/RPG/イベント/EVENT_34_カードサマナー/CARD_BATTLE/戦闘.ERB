$INPUT_LOOP
CALL INPUTS_SET, "CLEAR"

;アカデミー生徒群
L_NPC_STUDENT =
IF 10 <= イベントフラグ:34:0
; && イベントフラグ:34:0 < 20
	SIF GETBIT(イベントフラグ:34:17,5)
		L_NPC_STUDENT += "_アキ,Aki"
	L_NPC_STUDENT += "_ツトム,Tsutomu_ドラオ,Dorao_タケシ,Takeshi"
ENDIF
IF 15 <= イベントフラグ:34:0
; && イベントフラグ:34:0 < 20
	SIF GETBIT(イベントフラグ:34:17,4)
		L_NPC_STUDENT += "_ミドリ,Midori"
	SIF GETBIT(イベントフラグ:34:17,6)
		L_NPC_STUDENT += "_ミホ,Miho"
	L_NPC_STUDENT += "_マイケル,Michael_タイゾー,Taizo"
ENDIF
IF ((15 <= イベントフラグ:34:0 && GETBIT(イベントフラグ:34:16,1)) || 20 <= イベントフラグ:34:0)
	SIF GETBIT(イベントフラグ:34:17,7)
		L_NPC_STUDENT += "_リカ,Rika"
ENDIF
IF 41 <= イベントフラグ:34:0
	SIF GETBIT(イベントフラグ:34:17,8)
		L_NPC_STUDENT += "_シズカ,Shizuka"
	SIF GETBIT(イベントフラグ:34:17,9)
		L_NPC_STUDENT += "_サクラ,Sakura"
	L_NPC_STUDENT += "_サトシ,Satoshi _ユキヒコ,Yukihiko _タクヤ,Takuya"
ENDIF
IF L_NPC_STUDENT != ""
	L_NPC_STUDENT '= SUBSTRING(L_NPC_STUDENT, 1)
	L_NPC_STUDENT += "_戻る"
	CALL INPUTS_SET, "SET", "S,アカデミー生徒"
ENDIF


;アカデミーその他群
L_NPC_ACADEMY =
SIF GETBIT(イベントフラグ:34:17,2)
	L_NPC_ACADEMY += "_レオン,Leon"
SIF GETBIT(イベントフラグ:34:17,0)
	L_NPC_ACADEMY += "_アリス,Alice"
SIF GETBIT(イベントフラグ:34:17,3)
	L_NPC_ACADEMY += "_ルナ,Luna"
IF 41 <= イベントフラグ:34:0
	L_NPC_ACADEMY += "_マユミ,Mayumi"
ENDIF
IF 44 <= イベントフラグ:34:0
	L_NPC_ACADEMY += "_オダ,Oda _クロサワ,Kurosawa _サカモト,Sakamoto"
ENDIF
IF 48 <= イベントフラグ:34:0
	SIF GETBIT(イベントフラグ:34:17,10)
		L_NPC_ACADEMY += "_レイカ,Reika"
	L_NPC_ACADEMY += "_イガラシ,Igarashi"
ENDIF
IF 14 <= イベントフラグ:34:0
; && イベントフラグ:34:0 < 20
	L_NPC_ACADEMY += "_Ｚ８０,Z80_ＭＳＸ,MSX_Ｘ６８,X68"
ENDIF
IF L_NPC_ACADEMY != ""
	L_NPC_ACADEMY '= SUBSTRING(L_NPC_ACADEMY, 1)
	L_NPC_ACADEMY += "_戻る"
	CALL INPUTS_SET, "SET", "A,アカデミーその他"
ENDIF

L_NPC_DEVIL =
;悪魔陣営
SIF イベントフラグ:34:2 > 3
	L_NPC_DEVIL += "_はなこ,Hanako"
IF 41 <= イベントフラグ:34:0
	L_NPC_DEVIL += "_アーマーン,Ammut _キングフロスト,KingFrost _ケルベロス,Kerberos _ザントマン,Sandman "
	L_NPC_DEVIL += "_スナッピー,Snappy _ジャックフロスト,JackFrost _ジャックランタン,JackLantern _セイテンタイセイ,QitianDasheng "
	L_NPC_DEVIL += "_ニスロク,Nisroch _ネコマタ,Nekomata _パールヴァティ,Parvati _パズス,Pazuzu "
	L_NPC_DEVIL += "_パラスアテナ,PallasAthena _ヘケト,Heqet _ヤタガラス,Yatagarasu "
	L_NPC_DEVIL += "_マーメイド,Mermaid"
ENDIF
IF 44 <= イベントフラグ:34:0
	L_NPC_DEVIL += "_アヌビス,Anpu _ベルセルク,Berserk"
ENDIF
IF GETBIT(イベントフラグ:34:16,2) || 44 <= イベントフラグ:34:0
	L_NPC_DEVIL += "_ジャグラー,Juggler _ドッペルゲンガー,Doppelganger "
	SIF 44 <= イベントフラグ:34:0
		L_NPC_DEVIL += "_ドリルハンニャ,DrillHannya "
	SIF 48 <= イベントフラグ:34:0
		L_NPC_DEVIL += "_アグラト,Agrat"
ENDIF
IF L_NPC_DEVIL != ""
	L_NPC_DEVIL '= SUBSTRING(L_NPC_DEVIL, 1)
	L_NPC_DEVIL += "_戻る"
	CALL INPUTS_SET, "SET", "D,悪魔"
ENDIF

L_OCC = CS_OBTAIN_CARD_COUNT()
CB_FIRLD_KIND = フリーバトル

CALL INPUTS_SET, "SET", "R,戻る"
CALL INPUTS_SET, "INPUTV"
PRINTL
PRINTL
IF RESULTS == "S"
	CALL INPUTS_SET, "CLEAR"
	CALL INPUTS_SET, "SET", L_NPC_STUDENT
ELSEIF RESULTS == "A"
	CALL INPUTS_SET, "CLEAR"
	CALL INPUTS_SET, "SET", L_NPC_ACADEMY
ELSEIF RESULTS == "D"
	CALL INPUTS_SET, "CLEAR"
	CALL INPUTS_SET, "SET", L_NPC_DEVIL
ELSEIF RESULTS == "R"
	CB_FIRLD_KIND = 
	RETURN
ENDIF
CALL INPUTS_SET, "INPUTV" , , 2
PRINTL
PRINTL
IF RESULTS == "돌아간다"
	GOTO INPUT_LOOP
ELSE
	CALL CS_CARD_BATTLE_NPC, RESULTS
ENDIF

CB_FIRLD_KIND = 
RETURN



@CS_CARD_BATTLE_TOURNAMENT, L_CLASS
#DIMS L_CLASS
#DIMS L_SELECT_NPC, 20
#DIM L_SNPC_C
#DIMS L_NPCS, 6
#DIMS L_NPCS_N, 6
#DIM L_LINE
#DIM WIN_DATA
#DIM B_AREA
#DIMS L_EM

#DIMS L_OF

#DIMS L_R_WINNER
#DIMS L_R_WINNER_N
#DIM L_COUNT
#DIM L_WIN_C
#DIM L_LOSE
#DIM L_DECK_N
#DIM L_NPCB, 2

L_WIN_C = 0
L_LOSE = 0
WIN_DATA = 0
L_SNPC_C = 0
B_AREA = イベントフラグ:34:1
L_EM = CardSummoner

イベントフラグ:34:1 = 19
CALL EVENT_MAP_SET, "CLEAR"
CALL EVENT_MAP_SET, "事", "＠,緑", 10, 6
CALL EVENT_MAP_SET, "事", "JO,緑", 8, 4

IF L_CLASS == "ノーマル"
	L_SELECT_NPC:(L_SNPC_C ++) = ルナ,ﾙﾅ
	L_SELECT_NPC:(L_SNPC_C ++) = レオン,ﾚｵ
	L_SELECT_NPC:(L_SNPC_C ++) = アリス,ｱﾘ

	L_SELECT_NPC:(L_SNPC_C ++) = アキ,ｱｷ
	L_SELECT_NPC:(L_SNPC_C ++) = サトシ,ｻﾄ
	L_SELECT_NPC:(L_SNPC_C ++) = シズカ,ｼｽ
	L_SELECT_NPC:(L_SNPC_C ++) = タイゾー,ﾀｲ
	L_SELECT_NPC:(L_SNPC_C ++) = タケシ,ﾀｲ
	L_SELECT_NPC:(L_SNPC_C ++) = ツトム,ﾂﾄ
	L_SELECT_NPC:(L_SNPC_C ++) = ドラオ,ド
	L_SELECT_NPC:(L_SNPC_C ++) = マイケル,ﾏｲ
	L_SELECT_NPC:(L_SNPC_C ++) = ミドリ,ﾐﾄ
	L_SELECT_NPC:(L_SNPC_C ++) = ミホ,ﾐﾎ
	L_SELECT_NPC:(L_SNPC_C ++) = ユキヒコ,ﾕｷ
	L_SELECT_NPC:(L_SNPC_C ++) = リカ,ﾘｶ
	
ELSEIF L_CLASS == "グレート"
	L_SELECT_NPC:(L_SNPC_C ++) = アグラト,Ag

	L_SELECT_NPC:(L_SNPC_C ++) = イガラシ,ｲｶ
	L_SELECT_NPC:(L_SNPC_C ++) = オダ,ｵﾀ
	L_SELECT_NPC:(L_SNPC_C ++) = クロサワ,ｸﾛ
	L_SELECT_NPC:(L_SNPC_C ++) = サカモト,ｻｶ
	L_SELECT_NPC:(L_SNPC_C ++) = サクラ,ｻｸ
	L_SELECT_NPC:(L_SNPC_C ++) = サトシ,ｻﾄ
	L_SELECT_NPC:(L_SNPC_C ++) = シズカ,ｼｽ
	L_SELECT_NPC:(L_SNPC_C ++) = タクヤ,ﾀｸ
	L_SELECT_NPC:(L_SNPC_C ++) = マユミ,ﾏﾕ
	L_SELECT_NPC:(L_SNPC_C ++) = ミドリ,ﾐﾄ
	L_SELECT_NPC:(L_SNPC_C ++) = ユキヒコ,ﾕｷ
	L_SELECT_NPC:(L_SNPC_C ++) = レイカ,ﾚｲ

ENDIF

FOR L_COUNT, 0, 1000
	SWAP L_SELECT_NPC:(RAND:L_SNPC_C), L_SELECT_NPC:(RAND:L_SNPC_C)
NEXT

L_NPCS:0 '= NAME:MASTER
FOR L_COUNT, 1, VARSIZE("L_NPCS")
	L_NPCS:L_COUNT '= L_SELECT_NPC:(L_COUNT - 1)
	L_NPCS_N:L_COUNT '= AUTO_SPLIT(L_NPCS:L_COUNT , "," , 0)
NEXT

L_LINE = LINECOUNT
FOR L_COUNT, 0, 3
	CALL CS_CARD_BATTLE_TOURNAMENT_VIEW, L_NPCS_N, WIN_DATA
	IF L_COUNT == 0
		L_OF '= L_NPCS:1
	ELSEIF L_COUNT == 1
		L_OF '= L_NPCS:2
	ELSEIF L_COUNT == 2
		L_OF '= L_R_WINNER
	ENDIF

	CALL EVENT_MAP_SET, "事", AUTO_SPLIT(L_OF , "," , 1) + ",緑", 6, 6
	IF L_COUNT < 2
		LOCALS = {L_COUNT + 1}戦目
	ELSE
		LOCALS = 決勝戦
	ENDIF

	CALL MESSAGE_WINDOW_EM_ICON, L_EM, E34_C_ICON_N("ジョージ"), RESULTS, , "조지", @"오래 기다리셨습니다~/토너먼트 %LOCALS%입니-다"

	CALL CS_NPC_SET, AUTO_SPLIT(L_OF , "," , 0)
	CALL CS_NPC_DECK_SET, AUTO_SPLIT(L_OF , "," , 0), "トーナメント"
	L_DECK_N = RESULT

	LOCAL:0 = 0
	LOCAL:1 = 0
	CS_START_T_FIXED = 1 + RAND:2

	WHILE LOCAL:0 < 2 && LOCAL:1 < 2
		CALL CS_NPC_SET, AUTO_SPLIT(L_OF , "," , 0)
		CALL CS_NPC_DECK_SET, AUTO_SPLIT(L_OF , "," , 0), "トーナメント", L_DECK_N

		CALL CS_BATTLE_START,0 ,20 ,20 ,40 ,40
		IF RESULT > 0
			LOCAL:0 ++
		ELSEIF RESULT < 0
			LOCAL:1 ++
		ENDIF
		PRINTFORMW {LOCAL:0}勝　{LOCAL:1}敗
		CS_START_T_FIXED ++
	WEND
	IF LOCAL:0 > LOCAL:1
		SIF L_COUNT == 0
			SETBIT WIN_DATA, 0
		SIF L_COUNT == 1
			SETBIT WIN_DATA, 2
		SIF L_COUNT == 2
			SETBIT WIN_DATA, 8
		MONEY:5 += 400
		PRINTFORMW 400의 디지털 머니를 획득했다
		L_WIN_C ++
	ELSE
		SIF L_COUNT == 0
			SETBIT WIN_DATA, 1
		SIF L_COUNT == 1
			SETBIT WIN_DATA, 3
		SIF L_COUNT == 1
			SETBIT WIN_DATA, 9
		L_LOSE ++
	ENDIF
	IF LOCAL:0 > LOCAL:1
		IF L_COUNT < 2
			LOCALS = {L_COUNT + 1}回戦
			CALL MESSAGE_WINDOW_EM_ICON, L_EM, E34_C_ICON_N("ジョージ"), RESULTS, , "조지", @"축하드립니-다 %LOCALS% 돌파입니-다"
		ELSE
			CALL MESSAGE_WINDOW_EM_ICON, L_EM, E34_C_ICON_N("ジョージ"), RESULTS, , "조지", @"축하드립니-다 우승입니-다"
		ENDIF
	ENDIF
	CALL CS_CARD_BATTLE_TOURNAMENT_VIEW, L_NPCS_N, WIN_DATA
	SIF L_LOSE
		BREAK
	IF L_COUNT == 0
		L_NPCB:0 = CS_NPC_STRANGE(L_NPCS_N:4)
		L_NPCB:1 = CS_NPC_STRANGE(L_NPCS_N:5)
		
			PRINTL ========================================
		PRINTFORML 
		;          　なまえ名まえまえ VS なまえ名まえまえ
		PRINTFORML 　%L_NPCS_N:4,16% VS %L_NPCS_N:5,16%
		PRINTFORML 
			PRINTW ========================================
		IF RAND:(L_NPCB:0 + L_NPCB:1) < L_NPCB:0
			L_R_WINNER '= L_NPCS:4
			L_R_WINNER_N '= L_NPCS_N:4
			SETBIT WIN_DATA, 4
		ELSE
			L_R_WINNER '= L_NPCS:5
			L_R_WINNER_N '= L_NPCS_N:5
			SETBIT WIN_DATA, 5
		ENDIF
	ELSEIF L_COUNT == 1
		L_NPCB:0 = CS_NPC_STRANGE(L_NPCS_N:3)
		L_NPCB:1 = CS_NPC_STRANGE(L_R_WINNER_N)
			PRINTL ========================================
		PRINTFORML 
		;          　なまえ名まえまえ VS なまえ名まえまえ
		PRINTFORML 　%L_NPCS_N:3,16% VS %L_R_WINNER_N,16%
		PRINTFORML 
			PRINTW ========================================
		IF RAND:(L_NPCB:0 + L_NPCB:1) < L_NPCB:0
			L_R_WINNER '= L_NPCS:3
			L_R_WINNER_N '= L_NPCS_N:3
			SETBIT WIN_DATA, 6
		ELSE
			SETBIT WIN_DATA, 7
		ENDIF
	ENDIF
	IF L_COUNT < 2
		PRINTFORML 
		;          　なまえ名まえまえ VS なまえ名まえまえ
		PRINTFORML 　%L_R_WINNER_N,16% WIN
		PRINTFORML 
			PRINTW ========================================
	ENDIF

NEXT
CS_START_T_FIXED = 0
イベントフラグ:34:1 = B_AREA
CALL EVENT_MAP_SET, "CLEAR"

RETURN L_WIN_C


