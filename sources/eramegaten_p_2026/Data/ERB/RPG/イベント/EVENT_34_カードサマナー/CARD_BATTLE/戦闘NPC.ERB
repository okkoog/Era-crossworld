#DIM L_SUMMUNER
#DIM L_COUNT
#DIM L_V_C
#DIM L_C_NO, 21 ;カード番号　
#DIM L_VOL, 21 ;カードの枚数

FOR L_COUNT, 0, VARSIZE("SUMMONER_DECK", 1)
	IF SUMMONER_DECK:L_SUMMUNER:L_COUNT == 0
		LOCAL = L_COUNT
		BREAK
	ELSEIF L_COUNT == VARSIZE("SUMMONER_DECK", 1) - 1
		RETURN
	ENDIF
NEXT

FOR L_COUNT, 0, VARSIZE("L_C_NO", 0)
	;hhh
	SIF L_C_NO:L_COUNT == 0
		CONTINUE
	FOR L_V_C, 0, L_VOL:L_COUNT
		SUMMONER_DECK:L_SUMMUNER:(LOCAL++ ) = L_C_NO:L_COUNT
		SIF LOCAL > VARSIZE("SUMMONER_DECK", 1) - 1
			RETURN
	NEXT
	SIF LOCAL > VARSIZE("SUMMONER_DECK", 1) - 1
		RETURN

NEXT