{
@CS_CARD_DELIVERY, L_MIN, L_C_NO:0, L_PROB:0
, L_C_NO:1 = 0, L_PROB:1 = 0, L_C_NO:2 = 0, L_PROB:2 = 0, L_C_NO:3 = 0, L_PROB:3 = 0, L_C_NO:4 = 0, L_PROB:4 = 0
, L_C_NO:5 = 0, L_PROB:5 = 0, L_C_NO:6 = 0, L_PROB:6 = 0, L_C_NO:7 = 0, L_PROB:7 = 0, L_C_NO:8 = 0, L_PROB:8 = 0
, L_C_NO:9 = 0, L_PROB:9 = 0
}
#DIM L_MIN
#DIM L_MAX
#DIM L_E
#DIM L_GET
#DIM L_C_NO, 10 ;カード番号　
#DIM L_PROB, 10 ;確率
#DIM L_SUM_PROB;合計
#DIM L_TPROB, 10 ;真の確率
#DIM L_COUNT
#DIM L_C_ONE
#DIM L_C_GET, 10 ;カード取得枚数
#DIM L_V, 10 ;表示用
#DIM L_F_MAX

L_SUM_PROB = 0
VARSET L_TPROB
VARSET L_C_GET
VARSET L_V

L_F_MAX = VARSIZE("L_C_NO")

;FOR L_COUNT, 0, L_F_MAX
	;PRINTFORM {L_C_NO:L_COUNT} {L_PROB:L_COUNT}    
;NEXT
;PRINTFORML

FOR L_COUNT, 0, L_F_MAX
	L_TPROB:L_COUNT = L_PROB:L_COUNT + L_SUM_PROB
	L_SUM_PROB += L_PROB:L_COUNT
	;PRINTFORM {L_COUNT} {L_TPROB:L_COUNT} {L_SUM_PROB}   
NEXT
;PRINTFORML

L_E = L_MIN

L_GET = 0

FOR L_COUNT, 0, L_E
	LOCAL = RAND:L_SUM_PROB
	FOR L_C_ONE, 0, L_F_MAX
		IF L_PROB:L_C_ONE > 0 && L_C_NO:L_C_ONE > 0 && LOCAL < L_TPROB:L_C_ONE
			L_C_GET:L_C_ONE ++
			L_GET = 1
			BREAK
		ENDIF
	NEXT
NEXT

LOCAL = 0
LOCALS =
IF L_GET
	FOR L_COUNT, 0, L_F_MAX
		IF L_C_GET:L_COUNT > 0
			CALL CARD_DATA_GET, L_C_NO:L_COUNT
			OWN_CARD:(L_C_NO:L_COUNT) += L_C_GET:L_COUNT
			L_V:LOCAL = L_C_NO:L_COUNT
			LOCALS += @"%CARD_DATE_S:CBS_NAME%x{L_C_GET:L_COUNT}　"
			LOCAL ++
			SIF LOCAL % 3 == 0
				LOCALS += "/"
		ENDIF
	NEXT
	LOCALS += "を入手した。"

	CALL MESSAGE_WINDOW, "", LOCALS

	CALL CS_CARD_CONFIRMATION, L_V:0, L_V:1, L_V:2, L_V:3, L_V:4, L_V:5, L_V:6, L_V:7, L_V:8, L_V:9
ENDIF

RETURN L_GET

@CS_FUSION_KNOW_RANDOM_GET, ARG:0 = -1, ARG:1 = -1, ARG:2 = -1, ARG:3 = -1, ARG:4 = -1, ARG:5 = -1, ARG:6 = -1
#DIM L_FL, VARSIZE("CS_FUSION_KNOW") * 64
#DIM L_FC
#DIM L_COUNT

VARSET L_FL
L_FC = 0

IF ARG:0 == -99
	FOR L_COUNT, 0, VARSIZE("CS_FUSION_KNOW") * 64
		SIF CS_FUSION_NUM_COMBI_GET_F(L_COUNT, 0) == 0
			CONTINUE
		SIF !CS_FUSION_KNOW_GET_F(L_COUNT)
			L_FL:(L_FC ++) = L_COUNT
	NEXT
ELSE
	SIF ARG:0 < 0
		RETURN 0

	FOR L_COUNT, 0, VARSIZE("ARG")
		SIF ARG:L_COUNT < 0
			CONTINUE
		SIF CS_FUSION_NUM_COMBI_GET_F(ARG:L_COUNT, 0) == 0
			CONTINUE
		SIF !CS_FUSION_KNOW_GET_F(ARG:L_COUNT)
			L_FL:(L_FC ++) = ARG:L_COUNT
	NEXT
ENDIF
SIF L_FC > 0
	CALL CS_FUSION_KNOW_SET(L_FL:(RAND:L_FC), 1)

