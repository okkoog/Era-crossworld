;잔/1/0/
;特技名
@CGSP_NAME_6019, ARGS, ARG
RESULTS = 機関銃・光の弾丸

;　コストの量
@CGSP_COST_6019, ARGS, ARG
RETURN 6

;　타겟(選択するかしないか)
@CGSP_TARGET_6019, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_6019, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　4-召喚時

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_6019, ARGS, ARG, ARG:1
IF (ARG % 20) == CS1_ONESELF
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ENDIF

LOCAL:3 = 0
FOR LOCAL, 0, VARSIZE("OFFERING_CARD_DATE_V", 0)
	SIF OFFERING_CARD_DATE_V:LOCAL:CBV_KINDS >= 100 || CS_KIND_CHECK(LOCAL ,"LAW")
		LOCAL:3 = 1
NEXT
FOR LOCAL, LOCAL:1, LOCAL:2
	IF CS_KIND_CHECK(LOCAL ,"CHAOS")
		CALL SP_DAMAGE, LOCAL, 3, ARG
	ELSEIF !CS_KIND_CHECK(LOCAL ,"LAW") || LOCAL:3 > 0
		CALL SP_DAMAGE, LOCAL, 2, ARG
	ENDIF
NEXT


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_6019, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_6019, ARGS, ARG
{
RESULTS = ロウ属性以外の全ての敵仲魔に2Pのダメージをあたえる。カオス属性の場合、3Pのダメージになる。
供物にアイテム又はロウ属性の仲魔のカードを使うと、ロウ属性にも2Pのダメージを与えるようになる。
『混沌の者を滅する光の弾丸を使用したマシンガン』
}

;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　1(アギとかのダメージ魔法系は1),ダメージ,範囲1体は1、全体は2
@CGSP_TYPE_6019, ARGS, ARG
RESULTS = カオス+1ロウ-90
RETURN 1, 2, 2

@CGSP_TYPE_6019_1, ARGS, ARG
RESULTS = カオス+1
RESULTS:1 = アイテムライト仲魔
RETURN 1, 2, 2

