;잔/1/0/
;特技名
@CGSP_NAME_6032, ARGS, ARG
RESULTS = 賢者の石

;　コストの量
@CGSP_COST_6032, ARGS, ARG
RETURN 9

;　타겟(選択するかしないか)
@CGSP_TARGET_6032, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_6032, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　4-召喚時

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_6032, ARGS, ARG, ARG:1

CALL CS_DICEROLL(3, ARG)
IF RESULT
	FOR LOCAL, CBF_ALLY_POS1, CBF_ENEMY_POS6 + 1
		SIF LOCAL != ARG && FIELD_DEMON_DATE_V:ARG:CBV_NO > 0
			CALL CB_STATE_ADD, LOCAL, 998, 1
	NEXT
ENDIF


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_6032, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_6032, ARGS, ARG
RESULTS = 3/6 （50％）の確率で場にいる、全ての仲魔を黄泉に葬る。『膨大な知識と神の奇跡が生んだ宝石』


;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　1(アギとかのダメージ魔法系は1),ダメージ,範囲1体は1、全体は2
@CGSP_TYPE_6032, ARGS, ARG
RETURN 999, 3

