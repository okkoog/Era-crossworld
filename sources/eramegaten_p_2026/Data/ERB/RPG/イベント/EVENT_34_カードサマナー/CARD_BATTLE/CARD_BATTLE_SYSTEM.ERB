
@CS_BATTLE_FIELD_VIEW_SET, MESSAGE = "　"
#DIMS MESSAGE
SIF CS_DEBUG == 0
	REDRAW 0

CALL SET_PICTURE, , , "消去"
FOR LOCAL ,0 ,50
	CALL SET_PICTURE , " " , LOCAL , , 0
NEXT

CALL BF_PHASE_WINDOW , 0 , 0 , 92
CALL BF_SUMMONER_WINDOW , 1 , 0 , 0
CALL BF_DEMON_WINDOW , 1 , 3 , 12
CALL SET_PICTURE , @"%"=" * 132%" , 19 , , 0
CALL SET_PICTURE , MESSAGE , 20 , , 0
CALL SET_PICTURE , @"%"=" * 132%" , 21 , , 0
CALL BF_DEMON_WINDOW , 0 , 22 , 12
CALL BF_SUMMONER_WINDOW , 0 , 23 , 0
CALL BF_DECK_WINDOW , 99 , 38 , 32
CALL BF_INFORMATION_WINDOW , CBF_SELECT , 41 , 0

;CALL SET_PICTURE, , 0, "HTML表示", 50

@CARDBATTLE_MESSAGE, ARGS, ARG = 0, ARG:1 = 0
#DIM L_LINE

L_LINE = CBF_START_LINE

CALL CS_BATTLE_FIELD_VIEW_SET, ARGS
CALL SET_PICTURE, , 0, "HTML表示", 50
REDRAW 1

IF CB_SETTING_BM_SPEED == 9999
	WAIT
ELSE
	TWAIT CB_SETTING_BM_SPEED, 0
ENDIF
IF ARG:1 == 0
	SIF CS_DEBUG == 0
		REDRAW 0
	CLEARLINE LINECOUNT - L_LINE
ENDIF
SIF ARG != 0
	RETURN
FOR LOCAL, 0, VARSIZE("CBF_LOG", 0)
	IF CBF_LOG:LOCAL == ""
		CBF_LOG:LOCAL '= ARGS
		RETURN
	ENDIF
NEXT
FOR LOCAL, 1, VARSIZE("CBF_LOG", 0)
	CBF_LOG:(LOCAL - 1) '= CBF_LOG:LOCAL
NEXT
CBF_LOG:(VARSIZE("CBF_LOG", 0) - 1) '= ARGS

;ARGS			メッセージ
@CARDBATTLE_SELECT_F1, ARGS = "타겟을 선택해 주세요"
#DIM L_LINE
#DIM L_AI
#DIM L_COUNT

L_LINE = CBF_START_LINE
$INPUT_LOOP
CBF_SELECT_MODE = 1

CALL CS_BATTLE_FIELD_VIEW_SET, ARGS
CALL SET_PICTURE , @"[4000]취소　,,,4000" , 49 , ,  250 - 18
CALL SET_PICTURE, , 0, "HTML表示", 50
REDRAW 1
IF (CBF_P_TURN == 0 && CBF_PHASE != 4) || (CBF_P_TURN == 1 && CBF_PHASE == 4)
	L_AI = 0
	INPUT
ELSE
	L_AI = 1
	RESULT = CB_AI_ACT()
	IF CB_SETTING_BM_SPEED == 9999
		WAIT
	ELSE
		TWAIT CB_SETTING_BM_SPEED, 0
	ENDIF
ENDIF
SIF RESULT == 0 && L_AI == 1
	RESULT = 4000

SIF CS_DEBUG == 0
	REDRAW 0
CLEARLINE LINECOUNT - L_LINE

CBF_SELECT_MODE = 0
IF 0 <= RESULT && RESULT < 3000 && L_AI == 0
	CBF_SELECT = RESULT
ELSEIF RESULT == 4100 && L_AI == 0
	IF (CBF_SELECT == 0 || CBF_SELECT == 1) && GETBIT(CBF_SELECT_BIT, 20 + CBF_SELECT)
		RETURN CBF_SELECT
	ELSEIF 1000 <= CBF_SELECT && CBF_SELECT <= 1011 && GETBIT(CBF_SELECT_BIT, CBF_SELECT - 1000)
		RETURN CBF_SELECT
	ENDIF
ELSEIF 100 <= RESULT && RESULT < 200 && L_AI == 1
	IF (RESULT == 120 || RESULT == 121) && GETBIT(CBF_SELECT_BIT, RESULT % 100)
		RETURN RESULT - 120
	ELSEIF 100 <= RESULT && RESULT <= 111 && GETBIT(CBF_SELECT_BIT, RESULT - 100)
		RETURN 1000 + RESULT % 100
	ENDIF
ELSEIF RESULT == 4000
	RETURN 4000
ENDIF
GOTO INPUT_LOOP

;L_MINP			選択に必要な数（最大がない場合）。最低数
;L_MAXP			選択に必要な最大数
;ARGS			メッセージ
@CARDBATTLE_SELECT_F2, L_MINP = 1, L_MAXP = 0, ARGS = "타겟을 선택해 주세요"
#DIM L_LINE
#DIM L_AI
#DIM L_COUNT
#DIM L_MINP
#DIM L_MAXP
#DIM L_OK
#DIM L_LIMIT
#DIM L_ATKP
#DIM L_ATKO
#DIM L_ATK ,2
#DIM L_BLCP
#DIM L_BLCO
#DIM L_BLC ,2

CBF_SELECTING_BIT = 0
L_LINE = CBF_START_LINE

IF CBF_P_TURN == CS1_ONESELF
	L_ATK:0 = CBF_ALLY_POS1
	L_ATK:1 = CBF_ALLY_POS6
	L_BLC:0 = CBF_ENEMY_POS1
	L_BLC:1 = CBF_ENEMY_POS6
ELSE
	L_ATK:0 = CBF_ENEMY_POS1
	L_ATK:1 = CBF_ENEMY_POS6
	L_BLC:0 = CBF_ALLY_POS1
	L_BLC:1 = CBF_ALLY_POS6
ENDIF

IF L_MINP > 100 && L_MINP % 100 > 0
	L_ATKO = L_MINP % 100
	L_BLCO = L_MINP / 100
ELSE
	L_ATKO = 0
	L_BLCO = 0
ENDIF

$INPUT_LOOP
CBF_SELECT_MODE = 2

L_OK = 0
LOCAL = 0
L_ATKP = 0
L_BLCP = 0
FOR L_COUNT, 0, 30
	SIF L_ATK:0 <= L_COUNT && L_COUNT <= L_ATK:1
		L_ATKP++
	SIF L_BLC:0 <= L_COUNT && L_COUNT <= L_BLC:1
		L_BLCP++
	SIF GETBIT(CBF_SELECTING_BIT, L_COUNT)
		LOCAL++
NEXT

L_LIMIT = MAX(L_MINP ,L_MAXP)

IF L_ATKO > 0 && L_BLCO > 0
	SIF L_ATKO == L_ATKP && L_BLCO == L_BLCP
		L_OK = 1
	
	L_LIMIT = L_ATKO + L_BLCO
ELSEIF L_MINP > 0 && L_MAXP > 0
	SIF L_MINP <= LOCAL && LOCAL <= L_MAXP
		L_OK = 1
ELSEIF L_MAXP == 0
	SIF L_MINP == LOCAL
		L_OK = 1
ENDIF


CALL CS_BATTLE_FIELD_VIEW_SET, ARGS
SIF L_OK
	CALL SET_PICTURE , @"[4001]決定　,,,4001" , 49 , , 250 - 20 - 12
CALL SET_PICTURE , @"[4000]취소　,,,4000" , 49 , , 250 - 20
CALL SET_PICTURE, , 0, "HTML表示", 50
REDRAW 1
IF (CBF_P_TURN == 0 && CBF_PHASE != 4) || (CBF_P_TURN == 1 && CBF_PHASE == 4)
	L_AI = 0
	INPUT
ELSE
	L_AI = 1
	RESULT = CB_AI_ACT()
	IF CB_SETTING_BM_SPEED == 9999
		WAIT
	ELSE
		TWAIT CB_SETTING_BM_SPEED, 0
	ENDIF
ENDIF
IF 100 <= RESULT && RESULT < 200 && L_AI == 1
	RESULT = 4100 + RESULT - 100
ENDIF
IF RESULT == 0 && !L_OK && L_AI == 1
	RESULT = 4000
ELSEIF (RESULT == 0 && L_OK && L_AI == 1) || RESULT == 999
	RESULT = 4001
ENDIF
SIF CS_DEBUG == 0
	REDRAW 0
CLEARLINE LINECOUNT - L_LINE

CBF_SELECT_MODE = 0
LOCAL:1 = RESULT
IF 0 <= LOCAL:1 && LOCAL:1 < 3000
	CBF_SELECT = LOCAL:1
ELSEIF LOCAL:1 >= 4100 && LOCAL:1 <= 4112 && GETBIT(CBF_SELECT_BIT, LOCAL:1 - 4100)
	SIF GETBIT(CBF_SELECT_BIT, LOCAL:1 - 4100) || (LOCAL < L_LIMIT)
		INVERTBIT CBF_SELECTING_BIT, LOCAL:1 - 4100
ELSEIF LOCAL:1 == 4001 && L_OK
	RETURN CBF_SELECTING_BIT
ELSEIF LOCAL:1 == 4000
	RETURN 0
ENDIF
GOTO INPUT_LOOP

;ARGS			メッセージ
@CARDBATTLE_SELECT_H1, ARGS = "패를 선택해 주세요"
#DIM L_LINE
#DIM L_AI
#DIM L_COUNT

L_LINE = CBF_START_LINE
$INPUT_LOOP
CBF_SELECT_MODE = 11

CALL CS_BATTLE_FIELD_VIEW_SET, ARGS
CALL SET_PICTURE , @"[4000]취소　,,,4000" , 49 , ,  250 - 18
CALL SET_PICTURE, , 0, "HTML表示", 50
REDRAW 1
IF (CBF_P_TURN == 0 && CBF_PHASE != 4) || (CBF_P_TURN == 1 && CBF_PHASE == 4)
	L_AI = 0
	INPUT
ELSE
	L_AI = 1
	LOCAL = CB_AI_ACT()
	IF CB_SETTING_BM_SPEED == 9999
		WAIT
	ELSE
		TWAIT CB_SETTING_BM_SPEED, 0
	ENDIF
ENDIF
IF LOCAL == 0 && L_AI == 1
	RESULT = 4000

ENDIF
SIF CS_DEBUG == 0
	REDRAW 0
CLEARLINE LINECOUNT - L_LINE

CBF_SELECT_MODE = 0
IF 0 <= RESULT && RESULT < 3000 && L_AI == 0
	CBF_SELECT = RESULT
ELSEIF RESULT == 4100 && L_AI == 0
	IF 2000 <= CBF_SELECT && CBF_SELECT < 3000 && GETBIT(CBF_SELECT_BIT, CBF_SELECT - 2000)
		RETURN CBF_SELECT
	ENDIF
ELSEIF 100 <= LOCAL && LOCAL < 200 && L_AI == 1
	;LOCAL = RESULT
	IF GETBIT(CBF_SELECT_BIT, LOCAL - 100)
		RETURN LOCAL + 1900
	ENDIF
ELSEIF RESULT == 4000
	RETURN 4000
ENDIF
GOTO INPUT_LOOP

;ARG			選択に必要な数
;ARGS			メッセージ
@CARDBATTLE_SELECT_H2, ARG, ARGS = "패를 선택해 주세요"
#DIM L_AI
#DIM L_LINE
#DIM L_COUNT

CBF_SELECTING_BIT = 0
L_LINE = CBF_START_LINE
$INPUT_LOOP
CBF_SELECT_MODE = 12

LOCAL = 0
FOR L_COUNT, 0, 60
	SIF GETBIT(CBF_SELECTING_BIT, L_COUNT)
		LOCAL++
NEXT

CALL CS_BATTLE_FIELD_VIEW_SET, ARGS
SIF ARG == LOCAL
	CALL SET_PICTURE , @"[4001]決定　,,,4001" , 49 , , 250 - 20 - 12
CALL SET_PICTURE , @"[4000]취소　,,,4000" , 49 , , 250 - 20
CALL SET_PICTURE, , 0, "HTML表示", 50
REDRAW 1
IF (CBF_P_TURN == 0 && CBF_PHASE != 4) || (CBF_P_TURN == 1 && CBF_PHASE == 4)
	L_AI = 0
	INPUT
ELSE
	L_AI = 1
	RESULT = CB_AI_ACT()
	IF CB_SETTING_BM_SPEED == 9999
		WAIT
	ELSE
		TWAIT CB_SETTING_BM_SPEED, 0
	ENDIF
ENDIF
IF 20000 <= RESULT && RESULT < 30000 && L_AI == 1
	FOR L_COUNT, 0, DECK_CARDS(CS1_OPPONENT)
		IF SUMMONER_HAND_CARDS:CS1_OPPONENT:L_COUNT == RESULT - 20000 && GETBIT(CBF_SELECT_BIT, L_COUNT) && !GETBIT(CBF_SELECTING_BIT, L_COUNT)
			RESULT = 4100 + L_COUNT
			BREAK
		ENDIF
	NEXT
ENDIF
IF RESULT == 0 && ARG != LOCAL && L_AI == 1
	RESULT = 4000
ELSEIF ((RESULT == 0 || RESULT == 999) && ARG == LOCAL && L_AI == 1) || RESULT == 999
	RESULT = 4001
ENDIF
SIF CS_DEBUG == 0
	REDRAW 0
CLEARLINE LINECOUNT - L_LINE

LOCAL:1 = RESULT
CBF_SELECT_MODE = 0
IF 0 <= LOCAL:1 && LOCAL:1 < 3000
	CBF_SELECT = LOCAL:1
ELSEIF LOCAL:1 >= 4100 && LOCAL:1 <= 4160 && GETBIT(CBF_SELECT_BIT, LOCAL:1 - 4100)
	SIF GETBIT(CBF_SELECT_BIT, LOCAL:1 - 4100) || (LOCAL < ARG)
		INVERTBIT CBF_SELECTING_BIT, LOCAL:1 - 4100
ELSEIF LOCAL:1 == 4001 && ARG == LOCAL
	RETURN CBF_SELECTING_BIT
ELSEIF LOCAL:1 == 4000
	RETURN 0
ENDIF
GOTO INPUT_LOOP

;ARB	서머너
;ARB:1	ドローする枚数
@CS_DECKCARD_DRAW, ARG, ARG:1 = 1
FOR LOCAL ,0, ARG:1
	SIF SUMMONER_DECK:ARG:0 == 0
		BREAK
	CALL CS_HANDCARD_ADD, ARG, SUMMONER_DECK:ARG:0
	CALL CS_CARD_DECK_DEL, ARG, 0, 1
NEXT


;ARB	서머너
;ARB:1	召喚する手札番号
;召喚成功-1　召喚失敗-0
@CS_HANDCARD_SUMMON, ARG, ARG:1
#DIM L_COUNT
#DIM L_POSITION
#DIM L_OFFERING
#DIM L_MAG
#DIM L_FUSION

CALL CARD_DATA_GET, (SUMMONER_HAND_CARDS:ARG:(ARG:1))
SIF CARD_DATE_V:CBV_NO < 1 && CARD_DATE_V:CBV_KINDS < 100
	RETURN 0
IF CARD_DATE_V:CBV_FUSION < 2 && CS_F_DEMON_COUNT(ARG) > 5
	CALL CARDBATTLE_MESSAGE, @"소환할 공간이 없다！", 1
	RETURN 0
ELSEIF CARD_DATE_V:CBV_FUSION < 2 && CS_F_DEMON_COUNT(ARG) > 1 && CBF_TURN == 1
	CALL CARDBATTLE_MESSAGE, @"1턴째에는 필드에 낼 수 있는 중마는 2체까지입니다！", 1
	RETURN 0
ENDIF
L_MAG = CARD_DATE_V:CBV_COST
L_FUSION = CARD_DATE_V:CBV_FUSION
;SIF CBF_P_TURN == 1 && CS_DEBUG > 0
;	PRINTFORMW {CARD_DATE_V:CBV_COST} {SUMMONER_PARAMETER:ARG:CSP2_MAG}
SIF CARD_DATE_V:CBV_FUSION < 2 && S_STATE_INFO_GET_F(ARG, 3) == 3
	L_MAG = 0
SIF S_STATE_INFO_GET_F(ARG, 7) == 7 && 2 < CARD_DATE_V:CBV_FUSION
	L_FUSION = 2
SIF S_STATE_INFO_GET_F(ARG, 4) == 4 && RESULT:2 >= CARD_DATE_V:CBV_FUSION
	L_FUSION = 0
IF L_MAG <= SUMMONER_PARAMETER:ARG:CSP2_MAG
	L_OFFERING = 0
	IF CARD_DATE_V:CBV_OFFERING > 0
		CBF_SELECT_BIT = 0
		FOR L_COUNT, 0, HAND_CARDS(ARG)
			SIF ARG:1 == L_COUNT
				CONTINUE
			SETBIT CBF_SELECT_BIT, L_COUNT
		NEXT
		CALL CARDBATTLE_SELECT_H2, CARD_DATE_V:CBV_OFFERING, "공물로 바칠 패를 선택해 주세요."
		IF RESULT < 1
			RETURN 0
		ELSE
			L_OFFERING = RESULT
		ENDIF
	ENDIF
	IF L_FUSION > 1
		LOCAL = 0
		CBF_SELECT_BIT = 0
		LOCAL:1 = (ARG == 0 ? 0 # 6)
		
		LOCALS:1 = F
		FOR L_COUNT, LOCAL:1, LOCAL:1 + 6
			SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1
				CONTINUE
			SIF STATE_INFO_GET_F(L_COUNT, 112) || GETBIT(FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION, 3)
				CONTINUE
			LOCAL++
			SETBIT CBF_SELECT_BIT, L_COUNT
			LOCALS:1 += @"{L_COUNT}"
		NEXT
		IF L_FUSION <= LOCAL
			CALL CARDBATTLE_SELECT_F2, L_FUSION, ,"합체 소재를 선택해 주세요."
			IF RESULT < 1
				RETURN 0
			ELSE
				LOCAL:1 = RESULT
				FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_DATE_V", 1)
					IF GETBIT(LOCAL:1, L_COUNT)
						CALL CS_FUSIONDEMON_SET, L_COUNT
						CALL CS_FIELD_DEMON_CLEAR, L_COUNT
					ENDIF
				NEXT
				
			ENDIF
		ELSE
			LOCALS = %LOCALS:1% {LOCAL:1} 
			LOCALS += "필드에 합체 소재로 삼을 수 있는 중마가 부족하다！"
			CALL CARDBATTLE_MESSAGE, LOCALS, 1
			RETURN 0
		ENDIF
	ENDIF
	CALL CS_DEMON_SUMMON, ARG, SUMMONER_HAND_CARDS:ARG:(ARG:1)
	IF RESULT > 0
		FOR L_COUNT, 0, HAND_CARDS(ARG)
			SIF GETBIT(L_OFFERING, L_COUNT)
				CALL CS_OFFERING_CARD_SET, SUMMONER_HAND_CARDS:ARG:L_COUNT
		NEXT
		
		L_POSITION = RESULT - 1
		CALL CARD_DATA_GET, (SUMMONER_HAND_CARDS:ARG:(ARG:1))
		FOR L_COUNT, HAND_CARDS(ARG) - 1, -1, -1
			SIF GETBIT(L_OFFERING, L_COUNT) || L_COUNT == ARG:1
				CALL CS_HANDCARD_DEL, ARG, L_COUNT
		NEXT
		;CALL CS_HANDCARD_DEL, ARG, ARG:1
		SUMMONER_PARAMETER:ARG:CSP2_MAG -= L_MAG
		CALL CARDBATTLE_MESSAGE, SUMMONER_INFO:ARG:CSI2_NANE + @"(은)는 %CARD_DATE_S:CBS_NAME%을(를) 소환했다."
			
		SIF S_STATE_INFO_GET_F(ARG, 3) == 3 && FIELD_DEMON_DATE_V:L_POSITION:CBV_FUSION < 2
			CALL CB_S_STATE_DELETE2, ARG, 3
		SIF S_STATE_INFO_GET_F(ARG, 7) == 7 && 2 < FIELD_DEMON_DATE_V:L_POSITION:CBV_FUSION
			CALL CB_S_STATE_DELETE2, ARG, 7
		SIF S_STATE_INFO_GET_F(ARG, 4) == 4 && RESULT:2 >= FIELD_DEMON_DATE_V:L_POSITION:CBV_FUSION
			CALL CB_S_STATE_DELETE2, ARG, 4

		TRYCCALLFORM CGSP_TIMING_{FIELD_DEMON_DATE_V:L_POSITION:CBV_SP1}, FIELD_DEMON_DATE_S:L_POSITION:CBS_SP1_SUB, FIELD_DEMON_DATE_V:L_POSITION:CBV_NO
			IF RESULT == 4
				CALLFORM CGSP_ACTION_{FIELD_DEMON_DATE_V:L_POSITION:CBV_SP1}, FIELD_DEMON_DATE_S:L_POSITION:CBS_SP1_SUB, L_POSITION, -1
			ENDIF
		CATCH
		ENDCATCH
		
		TRYCCALLFORM CGSP_TIMING_{FIELD_DEMON_DATE_V:L_POSITION:CBV_SP2}, FIELD_DEMON_DATE_S:L_POSITION:CBS_SP2_SUB, FIELD_DEMON_DATE_V:L_POSITION:CBV_NO
			IF RESULT == 4
				CALLFORM CGSP_ACTION_{FIELD_DEMON_DATE_V:L_POSITION:CBV_SP2}, FIELD_DEMON_DATE_S:L_POSITION:CBS_SP2_SUB, L_POSITION, -1
			ENDIF
		CATCH
		ENDCATCH

		SIF S_STATE_INFO_GET_F(ARG, 104) == 104 && RESULT:2 > 0
			CALL CS_DICEROLL_S_STATE, RESULT:2, -1, L_POSITION, 998
		SIF S_STATE_INFO_GET_F(ARG, 107) == 107 && RESULT:2 > 0
			CALL CS_SUMMONER_DAMAGE, ARG, RESULT:2, -1, 99

		;召喚時のNPC
		CALL CS_BATTLE_MESSAGE_VIEW, FIELD_DEMON_DATE_V:L_POSITION:CBV_NO + 1000

		VARSET FUSION_CARD_DATE_V
		VARSET FUSION_CARD_DATE_S
		VARSET OFFERING_CARD_DATE_V
		VARSET OFFERING_CARD_DATE_S
		
		RETURN 1
	ELSE
		CALL CARDBATTLE_MESSAGE, @"소환에 실패했다！", 1
	ENDIF
ELSE
	CALL CARDBATTLE_MESSAGE, @"MAG가 부족하다！", 1
ENDIF
RETURN 0

;セットするポジション
@CS_FUSIONDEMON_SET, ARG
#DIM L_COUNT

FOR L_COUNT, 0, VARSIZE("FUSION_CARD_DATE_V", 0)
	IF FUSION_CARD_DATE_V:L_COUNT:0 < 1
		FOR LOCAL, 0, VARSIZE("FUSION_CARD_DATE_V", 1)
			FUSION_CARD_DATE_V:L_COUNT:LOCAL = FIELD_DEMON_DATE_V:ARG:LOCAL
		NEXT
		FOR LOCAL, 0, VARSIZE("FUSION_CARD_DATE_S", 1)
			FUSION_CARD_DATE_S:L_COUNT:LOCAL = FIELD_DEMON_DATE_S:ARG:LOCAL
		NEXT
		
		RETURN 1
	ENDIF
NEXT
RETURN 0

;セットする手札番号
;ARB	供物にセットするカード番号
@CS_OFFERING_CARD_SET, ARG
#DIM L_COUNT

CALL CARD_DATA_GET, ARG
FOR L_COUNT, 0, VARSIZE("OFFERING_CARD_DATE_V", 0)
	IF OFFERING_CARD_DATE_V:L_COUNT:0 < 1
		FOR LOCAL, 0, VARSIZE("OFFERING_CARD_DATE_V", 1)
			OFFERING_CARD_DATE_V:L_COUNT:LOCAL = CARD_DATE_V:LOCAL
		NEXT
		FOR LOCAL, 0, VARSIZE("OFFERING_CARD_DATE_S", 1)
			OFFERING_CARD_DATE_S:L_COUNT:LOCAL = CARD_DATE_S:LOCAL
		NEXT
		
		RETURN 1
	ENDIF
NEXT
RETURN 0

;ARB	手札追加する人
;ARB:1	追加するカード番号
;召喚成功-1　召喚失敗-0
@CS_HANDCARD_ADD, ARG, ARG:1
CALL CARD_DATA_GET, ARG:1
SIF CARD_DATE_V:CBV_NO < 1
	RETURN 0
FOR LOCAL, 0, VARSIZE("SUMMONER_DECK", 1)
	IF SUMMONER_HAND_CARDS:ARG:LOCAL == 0
		SUMMONER_HAND_CARDS:ARG:LOCAL = ARG:1
		RETURN 1
	ENDIF
NEXT
RETURN 0

;ARB	手札除去する人
;ARB:1	除去する手札番号
@CS_HANDCARD_DEL, ARG, ARG:1
FOR LOCAL, ARG:1 + 1, VARSIZE("SUMMONER_HAND_CARDS", 1)
	SUMMONER_HAND_CARDS:ARG:(LOCAL - 1) = SUMMONER_HAND_CARDS:ARG:LOCAL
NEXT
SUMMONER_HAND_CARDS:ARG:(VARSIZE("SUMMONER_HAND_CARDS", 1) - 1) = 0

;ARB	召喚する人
;ARB:1	召喚する悪魔NO
;召喚成功-1　召喚失敗-0
@CS_DEMON_SUMMON, ARG, ARG:1
CALL CARD_DATA_GET, ARG:1

IF ARG == CS1_ONESELF
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ENDIF
;SIF CBF_P_TURN == 1 && CS_DEBUG > 0
;	PRINTFORMW {CARD_DATE_V:CBV_NO} {CARD_DATE_V:CBV_KINDS} {CBF_ENEMY_POS1} {CBF_ENEMY_POS6 + 1}

IF CARD_DATE_V:CBV_NO > 0 && CARD_DATE_V:CBV_KINDS >= 0 && CARD_DATE_V:CBV_KINDS < 100
	FOR LOCAL, LOCAL:1, LOCAL:2
		IF FIELD_DEMON_DATE_V:LOCAL:CBV_NO < 1
			CALL CS_DEMON_SUMMON_FIELD, LOCAL, ARG:1
			
			RETURN 1 + LOCAL
		ENDIF
	NEXT
ENDIF
RETURN 0

;ARG　召喚する場所
;ARG:1召喚する悪魔NO
@CS_DEMON_SUMMON_FIELD, ARG, ARG:1
CALL CARD_DATA_GET, ARG:1
;SIF CBF_P_TURN == 1 && CS_DEBUG > 0
;	PRINTFORMW {ARG} {ARG:1}

IF CARD_DATE_V:CBV_NO > 0 && CARD_DATE_V:CBV_KINDS >= 0 && CARD_DATE_V:CBV_KINDS < 100 && 0 <= ARG && ARG < 24
	FOR LOCAL, 0, VARSIZE("CARD_DATE_V", 0)
		FIELD_DEMON_DATE_V:ARG:LOCAL = CARD_DATE_V:LOCAL
	NEXT
	FOR LOCAL, 0, VARSIZE("CARD_DATE_S", 0)
		FIELD_DEMON_DATE_S:ARG:LOCAL '= CARD_DATE_S:LOCAL
	NEXT
	FIELD_DEMON_DATE_V:ARG:CBV_HOST = ((ARG % 12) < 6 ? CS1_ONESELF # CS1_OPPONENT)
	FIELD_DEMON_DATE_V:ARG:CBV_B_AP = CARD_DATE_V:CBV_AP
	FIELD_DEMON_DATE_V:ARG:CBV_B_HP = CARD_DATE_V:CBV_HP
	FIELD_DEMON_DATE_V:ARG:CBV_FLYING = (CARD_DATE_V:CBV_FLIGHT ? 99 # 0)
	FIELD_DEMON_DATE_V:ARG:CBV_MAG = MAG_SUPPLY(SUMMONER_PARAMETER:(FIELD_DEMON_DATE_V:ARG:CBV_HOST):CSP2_ALIGNMENT, FIELD_DEMON_DATE_V:ARG:CBV_KINDS, FIELD_DEMON_DATE_V:ARG:CBV_FUSION)
	SIF ARG < 12
		SETBIT FIELD_DEMON_DATE_V:ARG:CBV_CONDITION,2
	RETURN 1
ENDIF
RETURN 0

;ARG	確率　1につき1/6(999で必ず成功)
;ARG:1	使う人(サマナーの場合100以上)
;ARG:2	受ける人(サマナーのみ0,1)
;他	付けるステイトのデータ
@CS_DICEROLL_S_STATE, ARG, ARG:1 = -1, ARG:2, STATE_DATA_V:CSS3_STATE, STATE_DATA_V:CSS3_TURN, STATE_DATA_V:CSS3_SUB1 = 0, STATE_DATA_V:CSS3_SUB2 = 0, STATE_DATA_V:CSS3_SUB3 = 0
#DIM STATE_DATA_V, VARSIZE("SUMMONER_STATE", 2)
LOCAL = ARG

IF ARG == 999
	RESULT = 1
ELSE
	CALL CS_DICEROLL(LOCAL, ARG:1, ARG:2)
ENDIF
IF RESULT
	CALL CB_S_STATE_ADD, ARG:2, STATE_DATA_V:CSS3_STATE, STATE_DATA_V:CSS3_TURN, STATE_DATA_V:CSS3_SUB1, STATE_DATA_V:CSS3_SUB2, STATE_DATA_V:CSS3_SUB3
	RETURN 1 + RESULT
ELSE
	RETURN 0
ENDIF

;ARG	確率　1につき1/6(999で必ず成功 9999の場合無効も貫通)
;ARG:1	使う人(サマナーの場合100以上)
;ARG:2	受ける人(仲魔のみ)
;他	付けるステイトのデータ
@CS_DICEROLL_STATE, ARG, ARG:1 = -1, ARG:2, STATE_DATA_V:CBV_STATE, STATE_DATA_V:CBV_TURN = 1, STATE_DATA_V:CBV_TIMING = 0, STATE_DATA_V:CBV_SUB1 = 0, STATE_DATA_V:CBV_SUB2 = 0, STATE_DATA_V:CBV_SUB3 = 0, STATE_DATA_S:CBS_SUB1 = "", STATE_DATA_S:CBS_SUB2 = "", STATE_DATA_S:CBS_SUB3 = ""
#DIM STATE_DATA_V, VARSIZE("FIELD_DEMON_STATE_V", 2)
#DIMS STATE_DATA_S, VARSIZE("FIELD_DEMON_STATE_S", 2)
LOCAL = ARG

IF ARG == 9999
	RESULT = 1
ELSEIF ARG == 999
	RESULT = 1
ELSE
	CALL CS_DICEROLL(LOCAL, ARG:1, ARG:2)
ENDIF
IF RESULT
	;即死時のアクション(バトルフェイズ以外)
	SIF STATE_DATA_V:CBV_STATE == 998 && CBF_PHASE != 4
		CALL CS_DEATH_ACTION, ARG:2, ARG:1, 0
	CALL CB_STATE_ADD, ARG:2, STATE_DATA_V:CBV_STATE, STATE_DATA_V:CBV_TURN, STATE_DATA_V:CBV_TIMING, STATE_DATA_V:CBV_SUB1, STATE_DATA_V:CBV_SUB2, STATE_DATA_V:CBV_SUB3, STATE_DATA_S:CBS_SUB1, STATE_DATA_S:CBS_SUB2, STATE_DATA_S:CBS_SUB3
	RETURN 1 + RESULT
ELSE
	RETURN 0
ENDIF

;ARG	確率　1につき1/6
;ARG:1	使う人(サマナーの場合100以上)
;ARG:2	受ける人(サマナーの場合100以上)
@CS_DICEROLL, ARG, ARG:1 = -1, ARG:2 = -1
#DIM L_HOST

LOCAL = ARG
IF ARG:1 >= 100
	L_HOST = ARG:1 % 20
ELSEIF CBF_ALLY_POS1 <= ARG:1 && ARG:1 <= CBF_ENEMY_AI_POS6
	L_HOST = FIELD_DEMON_DATE_V:(ARG:1):CBV_HOST
ELSE
	L_HOST = -1
ENDIF

SIF ARG:2 >= 0 && ARG:2 < 12 && STATE_INFO_GET_F(ARG:2, 12)
	LOCAL -= RESULT:3
SIF ARG:2 >= 0 && ARG:2 < 12 && STATE_INFO_GET_F(ARG:2, 113)
	LOCAL += RESULT:3

IF L_HOST != -1 && S_STATE_INFO_GET_F(L_HOST, 10)
	LOCAL += 100
	CALL CB_S_STATE_DELETE2(L_HOST, 10)
ENDIF

IF RAND:6 < LOCAL
	CALL CARDBATTLE_MESSAGE, "成功！"
	RETURN 1
ELSE
	CALL CARDBATTLE_MESSAGE, "失敗…"
	RETURN 0
ENDIF

;L_D	死ぬ人(仲魔のみ)
;L_A	殺す人(サマナーの場合100以上)
;L_TYPE	死に方　0SP、アイテム　1バトル
@CS_DEATH_ACTION, L_D, L_A, L_TYPE
#DIM L_D
#DIM L_A
#DIM L_TYPE

#DIM L_HOST
#DIM L_DAMAGE

L_HOST = FIELD_DEMON_DATE_V:L_D:CBV_HOST

;報復状態の処理
IF STATE_INFO_GET_F(L_D, 21) && L_TYPE == 0
	L_DAMAGE = RESULT:3
	;倒した相手が、敵の仲魔かサマナーだった場合発動
	IF (L_A < 100 && L_HOST != FIELD_DEMON_DATE_V:L_A:CBV_HOST) || (L_A >= 100 && L_HOST != L_A % 20)
		IF FIELD_DEMON_DATE_V:L_D:CBV_HOST == CS1_ONESELF
			LOCAL:1 = CBF_ENEMY_POS1
			LOCAL:2 = CBF_ENEMY_POS6 + 1
		ELSE
			LOCAL:1 = CBF_ALLY_POS1
			LOCAL:2 = CBF_ALLY_POS6 + 1
		ENDIF
		FOR LOCAL, LOCAL:1, LOCAL:2
			CALL CS_DEMON_BATTLE_DAMAGE, LOCAL, L_DAMAGE, L_D, 99
		NEXT


	ENDIF
ENDIF

;ARB	与える人(仲魔のみ)
;ARB:1	受けるサマナー(0、1)
@CS_SUMMONER_ATTACK, ARG, ARG:1
CALL CS_SUMMONER_DAMAGE, ARG:1, FIELD_DEMON_DATE_V:ARG:CBV_AP, ARG, 1

;ARB	受ける人(0、1)
;ARB:1	ダメージ
;ARB:2	与える人(サマナーは100以上、ターゲット制)
;ARB:3	タイプ 0=SP 1=アタック
@CS_SUMMONER_DAMAGE, ARG, ARG:1, ARG:2 = -1, ARG:3 = 0
#DIM DAMAGE
DAMAGE = ARG:1

;ダメージ軽減
SIF S_STATE_INFO_GET_F(ARG, 1) == 1 && ARG:3 != 99
	DAMAGE  -= RESULT:2


IF CBF_ALLY_POS1 <= ARG:2 && ARG:2 <= CBF_ENEMY_AI_POS6
	;飛行防壁
	SIF S_STATE_INFO_GET_F(ARG, 9) > 0 && FIELD_DEMON_DATE_V:(ARG:2):CBV_FLYING > 0
		DAMAGE = 0
ENDIF


DAMAGE = MAX(DAMAGE, 0)

SUMMONER_PARAMETER:ARG:CSP2_HP -= DAMAGE
CALL CARDBATTLE_MESSAGE, SUMMONER_INFO:ARG:CSI2_NANE + @"(은)는 {DAMAGE}P의 데미지를 입었다."

;サマナーが"Aﾀﾞﾒｰｼﾞ返し"状態の時、アタックで敵仲間に反射ダメージ
IF S_STATE_INFO_GET_F(ARG, 8) > 0 && 0 <= ARG:2 && ARG:2 < 100 && ARG:3 == 1 && DAMAGE > 0
	CALL CS_DEMON_BATTLE_DAMAGE, ARG:2, DAMAGE, ARG + 100, 99
ELSE
ENDIF
RETURN DAMAGE


;ARB	与える仲魔
;ARB:1	受ける仲魔
@CS_DEMON_ATTACK_STATE, ARG, ARG:1
FOR LOCAL, 0, VARSIZE("FIELD_DEMON_STATE_V", 1)
	IF 1000 <= FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE < 2000
		IF FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING == 10
		{
			CALL CS_DICEROLL_STATE, FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB3 % 100, ARG, ARG:1,
			FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE % 1000, FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB1,
			FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB3 / 100, FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB2, 0, 0, 
			FIELD_DEMON_STATE_S:ARG:LOCAL:CBS_SUB1, FIELD_DEMON_STATE_S:ARG:LOCAL:CBS_SUB2, FIELD_DEMON_STATE_S:ARG:LOCAL:CBS_SUB3
		}
		ENDIF
	ELSEIF 2000 <= FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE < 3000
		TRYCCALLFORM CGEX_STATE_TIMING_{FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE}, ARG, LOCAL
		;	IF RESULT == 7 || RESULT == 9
		;		CALLFORM CGEX_STATE_ACTION_{FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE}, ARG, LOCAL, (LOCAL:11)
		;	ENDIF
		CATCH
		ENDCATCH
	ENDIF
NEXT


;ARB	与える仲魔
;ARB:1	受ける仲魔
@CS_DEMON_BATTLE_ATTACK, ARG, ARG:1
CALL CS_DEMON_BATTLE_DAMAGE, ARG:1, FIELD_DEMON_DATE_V:ARG:CBV_AP, ARG, 1

;ARB	受ける仲魔
;ARB:1	ダメージ
;ARB:2	与える人(サマナーは100以上、ターゲット制)
;L_TYPE	タイプ 0=SP,アイテム 1=アタック
@CS_DEMON_BATTLE_DAMAGE, ARG, ARG:1, ARG:2, L_TYPE = 0
#DIM DAMAGE
#DIM L_TYPE
SIF FIELD_DEMON_DATE_V:ARG:CBV_NO == 0
	RETURN

DAMAGE = ARG:1
IF L_TYPE == 1
	;ダメージ軽減、増加
	SIF STATE_INFO_GET_F(ARG, 2)
		DAMAGE -= RESULT:3
	SIF STATE_INFO_GET_F(ARG, 110)
		DAMAGE += RESULT:3

	;無効化
	SIF STATE_INFO_GET_F(ARG, 3)
		DAMAGE = 0
	SIF STATE_INFO_GET_F(ARG, 4)
		DAMAGE = 0
	SIF STATE_INFO_GET_F(ARG, 25) && FIELD_DEMON_DATE_V:(ARG:2):CBV_SPEED > 0
		DAMAGE = 0
	SIF STATE_INFO_GET_F(ARG, 26) && FIELD_DEMON_DATE_V:(ARG:2):CBV_FLYING > 0
		DAMAGE = 0
ENDIF

DAMAGE = MAX(DAMAGE, 0)

FIELD_DEMON_DATE_V:ARG:CBV_HP -= DAMAGE
CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(ARG) + @"에게 {DAMAGE}P의 데미지를 입혔다."
IF STATE_INFO_GET_F(ARG, 116) > 0 && DAMAGE > 0
	FIELD_DEMON_DATE_V:ARG:CBV_B_HP -= 1
	CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(ARG) + @"(은)는 기초 HP: -1이 되었다."
ENDIF
IF STATE_INFO_GET_F(ARG, 21) > 0 && FIELD_DEMON_DATE_V:ARG:CBV_HP < 1 && FIELD_DEMON_DATE_V:ARG:CBV_B_HP > 0
	CALL CB_STATE_DELETE2, ARG, 21
	FIELD_DEMON_DATE_V:ARG:CBV_HP = 1
	CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(ARG) + @"(은)는 악물기로 버텼다！"
ELSEIF CBF_PHASE != 4
	CALL CS_DEATH_ACTION, ARG, ARG:1, L_TYPE
ENDIF

;CALL CARDBATTLE_MESSAGE, FIELD_DEMON_DATE_S:ARG:CBS_NAME + @"に{DAMAGE}Pのダメージを与えた。"
RETURN DAMAGE

;ARB	受ける仲魔
;ARB:1	ダメージ
;ARB:2	与える人(サマナーは100以上、ターゲット制)
;@CS_DEMON_DAMAGE, ARG, ARG:1, ARG:2
;#DIM DAMAGE
;DAMAGE = MAX(DAMAGE, 0)
;
;FIELD_DEMON_DATE_V:ARG:CBV_HP -= DAMAGE
;CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(ARG) + @"에게 {DAMAGE}P의 데미지를 입혔다."
;;CALL CARDBATTLE_MESSAGE, FIELD_DEMON_DATE_S:ARG:CBS_NAME + @"に{DAMAGE}Pのダメージを与えた。"
;RETURN DAMAGE




@CS_DEMON_BACK, ARG
#DIM II
#DIM JJ
SIF 0 > ARG || ARG > 11
	RETURN
CALL CS_CARD_DECKBACK, FIELD_DEMON_DATE_V:ARG:CBV_HOST, FIELD_DEMON_DATE_V:ARG:CBV_NO
SIF RESULT
	CALL CS_FIELD_DEMON_CLEAR, ARG

;HP0以下の仲魔を除去する
@CS_NOHP_DEMON_DEATH, ARG = -1, ARG:1 = -1
IF ARG == -1 && ARG:1 == -1
	LOCAL:1 = 0
	LOCAL:2 = 12
ELSEIF -1 < ARG && ARG < 12 && ARG:1 == -1
	LOCAL:1 = ARG
	LOCAL:2 = ARG + 1
ELSEIF -1 < ARG && ARG < 12 && ARG <= ARG:1 && ARG:1 < 12
	LOCAL:1 = ARG
	LOCAL:2 = ARG:1 + 1
ELSE
	PRINTW 수치가 올바르지 않습니다. CS_NOHP_DEMON_DEATH
ENDIF

FOR LOCAL, LOCAL:1, LOCAL:2
	SIF FIELD_DEMON_DATE_V:LOCAL:CBV_HP < 1
		CALL CS_DEMON_DEATH, LOCAL, 0
NEXT

;ARG	死ぬ人
;ARG:1	バトル時一旦残す
;ARG:2	STOCK-MAGの生成
@CS_DEMON_DEATH, ARG, ARG:1 = 1, ARG:2 = 1
#DIM II
#DIM JJ
#DIMS L_NAME
SIF 0 > ARG || ARG > 11
	RETURN
L_NAME = %FIELD_DEMON_DATE_S:ARG:CBS_NAME%
IF CBF_PHASE == 4 && ARG:1 == 1
	FIELD_DEMON_DATE_V:ARG:CBV_HP = -9
ELSE
	IF ARG:2 == 1
		CALL CS_STOCK_MAG_GET, ARG, 1, 1
		
	ENDIF
	CALL CS_FIELD_DEMON_CLEAR, ARG

	CALL CARDBATTLE_MESSAGE, L_NAME + @"(은)는 이 필드에서 사라졌다."
ENDIF
;ARG	서머너
;ARG:1	削除開始番号
;ARG:2	削除枚数
@CS_CARD_DECK_DEL, ARG, ARG:1, ARG:2

FOR LOCAL, ARG:1, VARSIZE("SUMMONER_DECK", 1)
	IF (LOCAL + ARG:2) < VARSIZE("SUMMONER_DECK", 1)
		SUMMONER_DECK:ARG:LOCAL = SUMMONER_DECK:ARG:(LOCAL + ARG:2)
	ELSE
		SUMMONER_DECK:ARG:LOCAL = 0
	ENDIF
NEXT

;ARG	서머너
;ARG:1	デッキに戻るカード
;ARG:2	メッセージを出すか出さないか 1で出さない
@CS_CARD_DECKBACK, ARG, ARG:1, ARG:2 = 0
#DIM L_DECK, VARSIZE("SUMMONER_DECK", 1)
#DIM II
#DIM JJ
CALL CARD_DATA_GET, ARG:1
SIF 0 > ARG || ARG > 1 || CARD_DATE_V:CBV_NO < 1
	RETURN 0
II = RAND:(DECK_CARDS(ARG))
FOR LOCAL, 0, VARSIZE("SUMMONER_DECK", 1)
	L_DECK:LOCAL = SUMMONER_DECK:ARG:LOCAL
NEXT
ARRAYSHIFT L_DECK, 1, ARG:1, RAND:(DECK_CARDS(ARG))
FOR LOCAL, 0, VARSIZE("SUMMONER_DECK", 1)
	SUMMONER_DECK:ARG:LOCAL = L_DECK:LOCAL
NEXT
;CALL CS_FIELD_DEMON_CLEAR, ARG

SIF ARG:2 == 0
	CALL CARDBATTLE_MESSAGE, CARD_DATE_S:CBS_NAME + "(은)는 " + CS_PIC_NAME(100 + ARG) + "의 덱으로 되돌아갔다."
	;CALL CARDBATTLE_MESSAGE, CARD_DATE_S:CBS_NAME + @"は%SUMMONER_INFO:ARG:CSI2_NANE%のデッキに戻った。"
RETURN 1

@CS_FIELD_DEMON_CLEAR, ARG
#DIM II
#DIM JJ
SIF 0 > ARG || ARG > 11
	RETURN

FOR LOCAL, 0, VARSIZE("FIELD_DEMON_DATE_V", 1)
	FIELD_DEMON_DATE_V:ARG:LOCAL = 0
NEXT
FOR LOCAL, 0, VARSIZE("FIELD_DEMON_DATE_S", 1)
	FIELD_DEMON_DATE_S:ARG:LOCAL = 
NEXT

FOR LOCAL, 0, VARSIZE("FIELD_DEMON_STATE_V", 1)
	FOR II, 0, VARSIZE("FIELD_DEMON_STATE_V", 2)
		FIELD_DEMON_STATE_V:ARG:LOCAL:II = 0
	NEXT
NEXT
FOR LOCAL, 0, VARSIZE("FIELD_DEMON_STATE_S", 1)
	FOR II, 0, VARSIZE("FIELD_DEMON_STATE_S", 2)
		FIELD_DEMON_STATE_S:ARG:LOCAL:II =
	NEXT
NEXT

;ARG	STOCK_MAG放出者
;ARG:1	放出方法　0-生成　1-황천
;L_GET	1でマスターがSTOCK_MAG獲得
;L_P_RANK	増減するランク
@CS_STOCK_MAG_GET, ARG, ARG:1, L_GET = 0, L_P_RANK = 0
#DIM L_MASTER
#DIM L_GET
#DIM L_SMAG
#DIM L_RSMAG
#DIM L_P_RANK

SIF GETBIT(FIELD_DEMON_DATE_V:ARG:CBV_CONDITION, 3)
	RETURN 0

L_MASTER = FIELD_DEMON_DATE_V:ARG:CBV_HOST

L_RSMAG = CS_STOCK_MAG_GET_F(ARG ,L_MASTER ,ARG:1, L_P_RANK)

IF L_GET == 1
	;SUMMONER_PARAMETER:L_MASTER:CSP2_STOCK_MAG += L_RSMAG
	;CALL CARDBATTLE_MESSAGE, @"%SUMMONER_INFO:L_MASTER:CSI2_NANE%は{L_RSMAG}のストックMAGを獲得した。"
	CALL CS_STOCK_MAG_D_GET(L_MASTER, L_RSMAG)
ENDIF

RETURN L_RSMAG


@CS_STOCK_MAG_D_GET, L_MASTER, L_RSMAG
#DIM L_MASTER
#DIM L_RSMAG
IF L_MASTER == CS1_ONESELF || L_MASTER == CS1_OPPONENT
	SUMMONER_PARAMETER:L_MASTER:CSP2_STOCK_MAG += L_RSMAG
	CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(100 + L_MASTER) + @"(은)는 {L_RSMAG}의 스톡 MAG를 획득했다."
ENDIF

;L_DEMON	STOCK_MAG放出者 -1フィールド外 0～23フィールド内
;L_MASTER	放出者のマスター
;L_WAY		放出方法　0-生成　1-황천
;L_P_RANK	増減するランク
@CS_STOCK_MAG_GET_F, L_DEMON, L_MASTER, L_WAY, L_P_RANK = 0
#FUNCTION
#DIM L_DEMON
#DIM L_MASTER
#DIM L_WAY
#DIM L_SMAG
#DIM L_RSMAG
#DIM L_P_RANK

L_SMAG = CS_STOCK_MAG_RANK(L_DEMON ,L_MASTER ,L_WAY)
L_SMAG += L_P_RANK

L_RSMAG = L_SMAG / 3 * 10
SIF L_SMAG % 3 > 0
	L_RSMAG += L_SMAG % 3 * 3 + 1

RETURNF L_RSMAG


;L_DEMON	STOCK_MAG放出者 -1フィールド外 0～23フィールド内
;L_MASTER	放出者のマスター
;L_WAY		放出方法　0-生成　1-황천
@CS_STOCK_MAG_RANK, L_DEMON, L_MASTER, L_WAY
#FUNCTION
#DIM L_DEMON
#DIM L_MASTER
#DIM L_WAY
#DIM L_KINDS

#DIM L_FUSION
#DIM L_ALIGNMENT

#DIM L_SMAG

L_KINDS = INRANGE(L_DEMON ,0 ,23) ? FIELD_DEMON_DATE_V:L_DEMON:CBV_KINDS # CARD_DATE_V:CBV_KINDS
L_SMAG = 0

IF L_WAY == 0
	IF L_KINDS / 10 == 1
		L_SMAG = 5
	ELSEIF L_KINDS / 10 == 2
		L_SMAG = 3
	ELSE
		L_SMAG = 2
	ENDIF
ELSEIF L_WAY == 1
	L_FUSION = INRANGE(L_DEMON ,0 ,23) ? FIELD_DEMON_DATE_V:L_DEMON:CBV_FUSION # CARD_DATE_V:CBV_FUSION
	L_ALIGNMENT = INRANGE(L_MASTER ,0 ,1) ? SUMMONER_PARAMETER:L_MASTER:CSP2_ALIGNMENT # 0

	L_SMAG = 3

	SIF L_FUSION > 1
		L_SMAG++
	IF 10 < L_KINDS && L_KINDS < 34
		IF L_KINDS / 10 == 1
			L_SMAG--
		ELSEIF L_KINDS / 10 == 3
			L_SMAG++
		ENDIF
		SIF L_KINDS % 10 == L_ALIGNMENT % 10
			L_SMAG++
	ELSE
		L_SMAG--
	ENDIF
ENDIF
RETURNF L_SMAG


@CS_ATTACK_ACTION, L_OFFENSE, L_DEFENSE = -1
#DIM L_OFFENSE
#DIM L_DEFENSE
#DIM L_D_SUMMONER

#DIM L_TRAMPLE

#DIM L_FAST
#DIM L_LATE

#DIM L_O_R
#DIM L_D_R

#DIM L_BLOCKING

L_FAST = -1
L_LATE = -1

L_O_R = -1
L_D_R = -1

SIF L_OFFENSE < 0
	RETURN 0

L_D_SUMMONER = FIELD_DEMON_DATE_V:L_OFFENSE:CBV_HOST == CS1_ONESELF ? CS1_OPPONENT # CS1_ONESELF

IF L_OFFENSE >= 0
	SIF L_OFFENSE <= CBF_ALLY_POS6 && CS_TUTORIAL:0 == 0
		CARD_FIGHTING_COUNT:(FIELD_DEMON_DATE_V:L_OFFENSE:CBV_NO) ++
		
	FOR LOCAL, 0, VARSIZE("FIELD_DEMON_STATE_V", 1)
		IF 1000 <= FIELD_DEMON_STATE_V:(L_OFFENSE):LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:(L_OFFENSE):LOCAL:CBV_STATE < 2000
			IF FIELD_DEMON_STATE_V:(L_OFFENSE):LOCAL:CBV_TIMING == 7 || FIELD_DEMON_STATE_V:(L_OFFENSE):LOCAL:CBV_TIMING == 9
			{
				CALL CB_STATE_ADD, (L_OFFENSE), FIELD_DEMON_STATE_V:(L_OFFENSE):LOCAL:CBV_STATE % 1000, FIELD_DEMON_STATE_V:(L_OFFENSE):LOCAL:CBV_SUB1, 0, 
				FIELD_DEMON_STATE_V:(L_OFFENSE):LOCAL:CBV_SUB2, 0, 0, 
				FIELD_DEMON_STATE_S:(L_OFFENSE):LOCAL:CBS_SUB1, FIELD_DEMON_STATE_S:(L_OFFENSE):LOCAL:CBS_SUB2, FIELD_DEMON_STATE_S:(L_OFFENSE):LOCAL:CBS_SUB3
			}
			ENDIF
		ELSEIF 2000 <= FIELD_DEMON_STATE_V:(L_OFFENSE):LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:(L_OFFENSE):LOCAL:CBV_STATE < 3000
			TRYCCALLFORM CGEX_STATE_TIMING_{FIELD_DEMON_STATE_V:(L_OFFENSE):LOCAL:CBV_STATE}, (L_OFFENSE), LOCAL
				IF RESULT == 7 || RESULT == 9
					CALLFORM CGEX_STATE_ACTION_{FIELD_DEMON_STATE_V:(L_OFFENSE):LOCAL:CBV_STATE}, (L_OFFENSE), LOCAL, (L_DEFENSE)
				ENDIF
			CATCH
			ENDCATCH
		ENDIF
	NEXT

ENDIF
IF L_DEFENSE >= 0
	SIF L_DEFENSE <= CBF_ALLY_POS6 && CS_TUTORIAL:0 == 0
		CARD_FIGHTING_COUNT:(FIELD_DEMON_DATE_V:L_DEFENSE:CBV_NO) ++

	FOR LOCAL, 0, VARSIZE("FIELD_DEMON_STATE_V", 1)
		IF 1000 <= FIELD_DEMON_STATE_V:(L_DEFENSE):LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:(L_DEFENSE):LOCAL:CBV_STATE < 2000
			IF FIELD_DEMON_STATE_V:(L_DEFENSE):LOCAL:CBV_TIMING == 8 || FIELD_DEMON_STATE_V:(L_DEFENSE):LOCAL:CBV_TIMING == 9
			{
				CALL CB_STATE_ADD, (L_DEFENSE), FIELD_DEMON_STATE_V:(L_DEFENSE):LOCAL:CBV_STATE % 1000, FIELD_DEMON_STATE_V:(L_DEFENSE):LOCAL:CBV_SUB1, 0, 
				FIELD_DEMON_STATE_V:(L_DEFENSE):LOCAL:CBV_SUB2, 0, 0, 
				FIELD_DEMON_STATE_S:(L_DEFENSE):LOCAL:CBS_SUB1, FIELD_DEMON_STATE_S:(L_DEFENSE):LOCAL:CBS_SUB2, FIELD_DEMON_STATE_S:(L_DEFENSE):LOCAL:CBS_SUB3
			}
			ENDIF
		ELSEIF 2000 <= FIELD_DEMON_STATE_V:(L_DEFENSE):LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:(L_DEFENSE):LOCAL:CBV_STATE < 3000
			TRYCCALLFORM CGEX_STATE_TIMING_{FIELD_DEMON_STATE_V:(L_DEFENSE):LOCAL:CBV_STATE}, (L_DEFENSE), LOCAL
				IF RESULT == 8 || RESULT == 9
					CALLFORM CGEX_STATE_ACTION_{FIELD_DEMON_STATE_V:(L_DEFENSE):LOCAL:CBV_STATE}, (L_DEFENSE), LOCAL, (L_OFFENSE)
				ENDIF
			CATCH
			ENDCATCH
		ENDIF
	NEXT
ENDIF

IF L_DEFENSE >= 0
	IF LIMIT(FIELD_DEMON_DATE_V:L_OFFENSE:CBV_SPEED, -1, 1) < LIMIT(FIELD_DEMON_DATE_V:L_DEFENSE:CBV_SPEED, -1, 1) && STATE_INFO_GET_F(L_OFFENSE, 13) == 0
		L_FAST = L_DEFENSE
		L_LATE = L_OFFENSE
	ELSEIF LIMIT(FIELD_DEMON_DATE_V:L_OFFENSE:CBV_SPEED, -1, 1) > LIMIT(FIELD_DEMON_DATE_V:L_DEFENSE:CBV_SPEED, -1, 1) && STATE_INFO_GET_F(L_DEFENSE, 13) == 0
		L_FAST = L_OFFENSE
		L_LATE = L_DEFENSE
	ENDIF

	;時の回廊処理
	IF STATE_INFO_GET_F(L_OFFENSE, 204) > 0 || STATE_INFO_GET_F(L_DEFENSE, 204) > 0
		CALL CS_DEMON_BACK, L_DEFENSE
		CALL CS_DEMON_BACK, L_OFFENSE
	;必殺の構え処理
	ELSEIF STATE_INFO_GET_F(L_OFFENSE, 201) > 0 || STATE_INFO_GET_F(L_DEFENSE, 201) > 0
		FIELD_DEMON_DATE_V:L_DEFENSE:CBV_HP = -99
		CALL CS_DEMON_DEATH, L_DEFENSE, 0
		FIELD_DEMON_DATE_V:L_OFFENSE:CBV_HP = -99
		CALL CS_DEMON_DEATH, L_OFFENSE, 0
	;先攻・後攻あり
	ELSEIF L_FAST >= 0
		CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(L_FAST) + @"의 선제공격！"

		L_BLOCKING = CS_ATTACK_BLOCKING(L_LATE, L_FAST)
		IF L_BLOCKING == 20
			CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(L_LATE) + @"(은)는 공격을 반사！"
			;ダメージ処理
			LOCAL:14 = MIN(FIELD_DEMON_DATE_V:(L_FAST):CBV_HP ,0)
			CALL CS_DEMON_BATTLE_ATTACK, L_FAST, L_FAST
			;貫通処理
			LOCAL:14 = -1 * FIELD_DEMON_DATE_V:(L_FAST):CBV_HP + LOCAL:14
			SIF STATE_INFO_GET_F(L_FAST, 8) > 0 && LOCAL:14 > 0 && L_FAST == L_DEFENSE
				CALL CS_SUMMONER_DAMAGE(FIELD_DEMON_DATE_V:(L_FAST):CBV_HOST, LOCAL:14, L_FAST, 1)
			;ステイト処理
			SIF STATE_INFO_GET_F(L_FAST, 3) < 1 && STATE_INFO_GET_F(L_FAST, 4) < 1
				CALL CS_DEMON_ATTACK_STATE, L_FAST, L_FAST
		ELSEIF L_BLOCKING == 10
			CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(L_LATE) + @"(은)는 공격을 완전 무효화했다！"
		ELSE
			;ダメージ処理
			LOCAL:14 = MIN(FIELD_DEMON_DATE_V:(L_LATE):CBV_HP ,0)
			CALL CS_DEMON_BATTLE_ATTACK, L_FAST, L_LATE
			;貫通処理
			LOCAL:14 = -1 * FIELD_DEMON_DATE_V:(L_LATE):CBV_HP + LOCAL:14
			SIF STATE_INFO_GET_F(L_FAST, 8) > 0 && LOCAL:14 > 0 && L_FAST == L_OFFENSE
				CALL CS_SUMMONER_DAMAGE(FIELD_DEMON_DATE_V:(L_LATE):CBV_HOST, LOCAL:14, L_FAST, 1)
			;ステイト処理
			SIF STATE_INFO_GET_F(L_LATE, 3) < 1
				CALL CS_DEMON_ATTACK_STATE, L_FAST, L_LATE
		ENDIF
		IF FIELD_DEMON_DATE_V:L_OFFENSE:CBV_HP > 0 && FIELD_DEMON_DATE_V:L_DEFENSE:CBV_HP > 0
			CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(L_LATE) + @"의 공격！"

			L_BLOCKING = CS_ATTACK_BLOCKING(L_FAST, L_LATE)
			IF L_BLOCKING == 20
				CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(L_FAST) + @"(은)는 공격을 반사！"
				;ダメージ処理
				LOCAL:14 = MIN(FIELD_DEMON_DATE_V:(L_LATE):CBV_HP ,0)
				CALL CS_DEMON_BATTLE_ATTACK, L_LATE, L_LATE
				;貫通処理
				LOCAL:14 = -1 * FIELD_DEMON_DATE_V:(L_LATE):CBV_HP + LOCAL:14
				SIF STATE_INFO_GET_F(L_LATE, 8) > 0 && LOCAL:14 > 0 && L_LATE == L_DEFENSE
					CALL CS_SUMMONER_DAMAGE(FIELD_DEMON_DATE_V:(L_LATE):CBV_HOST, LOCAL:14, L_LATE, 1)
				;ステイト処理
				SIF STATE_INFO_GET_F(L_LATE, 3) < 1 && STATE_INFO_GET_F(L_LATE, 4) < 1
					CALL CS_DEMON_ATTACK_STATE, L_LATE, L_LATE
			ELSEIF L_BLOCKING == 10
				CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(L_FAST) + @"(은)는 공격을 완전 무효화했다！"
			ELSE
				;ダメージ処理
				LOCAL:14 = MIN(FIELD_DEMON_DATE_V:(L_FAST):CBV_HP ,0)
				CALL CS_DEMON_BATTLE_ATTACK, L_LATE, L_FAST
				;貫通処理
				LOCAL:14 = -1 * FIELD_DEMON_DATE_V:(L_FAST):CBV_HP + LOCAL:14
				SIF STATE_INFO_GET_F(L_LATE, 8) > 0 && LOCAL:14 > 0 && L_LATE == L_OFFENSE
					CALL CS_SUMMONER_DAMAGE(FIELD_DEMON_DATE_V:(L_FAST):CBV_HOST, LOCAL:14, L_LATE, 1)
				;ステイト処理
				SIF STATE_INFO_GET_F(L_FAST, 3) < 1
					CALL CS_DEMON_ATTACK_STATE, L_LATE, L_FAST
			ENDIF
		ENDIF

		;誘爆処理
		SIF FIELD_DEMON_DATE_V:L_DEFENSE:CBV_HP < 1 && STATE_INFO_GET_F(L_DEFENSE, 20)
			CALL CS_DEMON_BATTLE_DAMAGE, L_OFFENSE, RESULT:3, L_DEFENSE, 99
		SIF FIELD_DEMON_DATE_V:L_OFFENSE:CBV_HP < 1 && STATE_INFO_GET_F(L_OFFENSE, 20)
			CALL CS_DEMON_BATTLE_DAMAGE, L_DEFENSE, RESULT:3, L_OFFENSE, 99

		;死亡時のアクション
		LOCAL = 0
		IF FIELD_DEMON_DATE_V:L_DEFENSE:CBV_HP < 1
			CALL CS_DEATH_ACTION, L_DEFENSE, L_OFFENSE, 1
			LOCAL = 1
		ENDIF
		SIF FIELD_DEMON_DATE_V:L_OFFENSE:CBV_HP < 1
			CALL CS_DEATH_ACTION, L_OFFENSE, L_DEFENSE, 1
		SIF FIELD_DEMON_DATE_V:L_DEFENSE:CBV_HP < 1 && LOCAL == 0
			CALL CS_DEATH_ACTION, L_DEFENSE, L_OFFENSE, 1

		CALL CS_NOHP_DEMON_DEATH, L_OFFENSE
		CALL CS_NOHP_DEMON_DEATH, L_DEFENSE
	ELSE
		CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(L_OFFENSE) + "와(과) " + CS_PIC_NAME(L_DEFENSE) + @"의 공격！"

		
		L_BLOCKING = CS_ATTACK_BLOCKING(L_DEFENSE, L_OFFENSE)
		IF L_BLOCKING == 20
			CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(L_DEFENSE) + @"(은)는 공격을 반사！"
			;ダメージ処理
			CALL CS_DEMON_BATTLE_ATTACK, L_OFFENSE, L_OFFENSE
			;ステイト処理
			SIF STATE_INFO_GET_F(L_OFFENSE, 3) < 1 && STATE_INFO_GET_F(L_OFFENSE, 4) < 1
				L_O_R = L_OFFENSE
		ELSEIF L_BLOCKING == 10
			CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(L_DEFENSE) + @"(은)는 공격을 완전 무효화했다！"
		ELSE
			;ダメージ処理
			LOCAL:14 = MIN(FIELD_DEMON_DATE_V:(L_DEFENSE):CBV_HP ,0)
			CALL CS_DEMON_BATTLE_ATTACK, L_OFFENSE, L_DEFENSE
			;貫通処理
			LOCAL:14 = -1 * FIELD_DEMON_DATE_V:(L_DEFENSE):CBV_HP + LOCAL:14
			SIF STATE_INFO_GET_F(L_OFFENSE, 8) > 0 && LOCAL:14 > 0
				CALL CS_SUMMONER_DAMAGE(FIELD_DEMON_DATE_V:(L_DEFENSE):CBV_HOST, LOCAL:14, L_OFFENSE, 1)
			;ステイト処理
			SIF STATE_INFO_GET_F(L_DEFENSE, 3) < 1
				L_O_R = L_DEFENSE
		ENDIF

		L_BLOCKING = CS_ATTACK_BLOCKING(L_OFFENSE, L_DEFENSE)
		IF L_BLOCKING == 20
			CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(L_OFFENSE) + @"(은)는 공격을 반사！"
			;ダメージ処理
			LOCAL:14 = MIN(FIELD_DEMON_DATE_V:(L_DEFENSE):CBV_HP ,0)
			CALL CS_DEMON_BATTLE_ATTACK, L_DEFENSE, L_DEFENSE
			;貫通処理
			LOCAL:14 = -1 * FIELD_DEMON_DATE_V:(L_DEFENSE):CBV_HP + LOCAL:14
			SIF STATE_INFO_GET_F(L_DEFENSE, 8) > 0 && LOCAL:14 > 0
				CALL CS_SUMMONER_DAMAGE(FIELD_DEMON_DATE_V:(L_DEFENSE):CBV_HOST, LOCAL:14, L_DEFENSE, 1)
			;ステイト処理
			SIF STATE_INFO_GET_F(L_DEFENSE, 3) < 1 && STATE_INFO_GET_F(L_DEFENSE, 4) < 1
				L_D_R = L_DEFENSE
		ELSEIF L_BLOCKING == 10
			CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(L_OFFENSE) + @"(은)는 공격을 완전 무효화했다！"
		ELSE
			;ダメージ処理
			CALL CS_DEMON_BATTLE_ATTACK, L_DEFENSE, L_OFFENSE
			;ステイト処理
			SIF STATE_INFO_GET_F(L_OFFENSE, 3) < 1
				L_D_R = L_OFFENSE
		ENDIF

		;ステイト処理
		SIF L_O_R > -1
			CALL CS_DEMON_ATTACK_STATE, L_OFFENSE, L_O_R
		SIF L_D_R > -1
			CALL CS_DEMON_ATTACK_STATE, L_DEFENSE, L_D_R

		;誘爆処理
		SIF FIELD_DEMON_DATE_V:L_DEFENSE:CBV_HP < 1 && STATE_INFO_GET_F(L_DEFENSE, 20)
			CALL CS_DEMON_BATTLE_DAMAGE, L_OFFENSE, RESULT:3, L_DEFENSE, 99
		SIF FIELD_DEMON_DATE_V:L_OFFENSE:CBV_HP < 1 && STATE_INFO_GET_F(L_OFFENSE, 20)
			CALL CS_DEMON_BATTLE_DAMAGE, L_DEFENSE, RESULT:3, L_OFFENSE, 99

		;死亡時のアクション
		LOCAL = 0
		IF FIELD_DEMON_DATE_V:L_DEFENSE:CBV_HP < 1
			CALL CS_DEATH_ACTION, L_DEFENSE, L_OFFENSE, 1
			LOCAL = 1
		ENDIF
		SIF FIELD_DEMON_DATE_V:L_OFFENSE:CBV_HP < 1
			CALL CS_DEATH_ACTION, L_OFFENSE, L_DEFENSE, 1
		SIF FIELD_DEMON_DATE_V:L_DEFENSE:CBV_HP < 1 && LOCAL == 0
			CALL CS_DEATH_ACTION, L_DEFENSE, L_OFFENSE, 1

		CALL CS_NOHP_DEMON_DEATH, L_OFFENSE
		CALL CS_NOHP_DEMON_DEATH, L_DEFENSE
	ENDIF
ELSE
	CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(L_OFFENSE) + @"의 공격！"
	CALL CS_SUMMONER_ATTACK, L_OFFENSE, L_D_SUMMONER

	CALL CS_NOHP_DEMON_DEATH, L_OFFENSE
ENDIF
IF FIELD_DEMON_DATE_V:L_OFFENSE:CBV_NO > 0 && STATE_INFO_GET_F(L_OFFENSE, 11) < 1
	CALL CB_STATE_ADD, L_OFFENSE, 999, 1

ENDIF

;返り値　0.無効化できない　10.完全無効化　20.反射
@CS_ATTACK_BLOCKING, L_BLOCKER, L_ATTACKER
#FUNCTION
#DIM L_RETS
#DIM L_BLOCKER
#DIM L_ATTACKER
IF STATE_INFO_GET_F(L_BLOCKER, 4)
	RETURNF 20
ELSE
	SIF STATE_INFO_GET_F(L_BLOCKER, 22) && RESULT:3 >= FIELD_DEMON_DATE_V:L_ATTACKER:CBV_HP
		RETURNF 10
	SIF STATE_INFO_GET_F(L_BLOCKER, 23) && RESULT:3 >= FIELD_DEMON_DATE_V:L_ATTACKER:CBV_B_HP
		RETURNF 10
		
ENDIF
RETURNF 0




;ARG	名前出すポジション　100.101だとサマナー
;L_CLICK	クリック時の文字列
@CS_PIC_NAME, ARG, L_CLICK = ""
#FUNCTIONS
#DIMS L_RETS
#DIMS L_CLICK
#DIMS L_COLLAR

L_RETS =
L_COLLAR = {COLOR("WHITE")}
IF     CBF_ALLY_POS1 <= ARG && ARG < CBF_ALLY_POS6 + 1
	;味方仲魔
	L_COLLAR = {COLOR("FRIEND")}
	L_RETS = _%FIELD_DEMON_DATE_S:ARG:CBS_NAME%
ELSEIF CBF_ENEMY_POS1 <= ARG && ARG < CBF_ENEMY_POS6 + 1
	;敵仲魔
	L_COLLAR = {COLOR("ENEMY")}
	L_RETS = _%FIELD_DEMON_DATE_S:ARG:CBS_NAME%
ELSEIF ARG == 20 + CS1_ONESELF
	;＠서머너
	L_COLLAR = {COLOR("FRIEND")}
	L_RETS = _%SUMMONER_INFO:(ARG - 20):CSI2_NANE%

ELSEIF ARG == 20 + CS1_OPPONENT
	;敵サマナー
	L_COLLAR = {COLOR("ENEMY")}
	L_RETS = _%SUMMONER_INFO:(ARG - 20):CSI2_NANE%
ELSEIF ARG == 100 + CS1_ONESELF
	;＠서머너
	L_COLLAR = {COLOR("FRIEND")}
	L_RETS = _%SUMMONER_INFO:(ARG - 100):CSI2_NANE%

ELSEIF ARG == 100 + CS1_OPPONENT
	;敵サマナー
	L_COLLAR = {COLOR("ENEMY")}
	L_RETS = _%SUMMONER_INFO:(ARG - 100):CSI2_NANE%
ENDIF

L_RETS += "," + L_COLLAR + ",," + L_CLICK + "_"
RETURNF L_RETS



