;잔/1/0/
;特技名
@CGSP_NAME_6072, ARGS, ARG
RESULTS = 뉴클리어밤

;　コストの量
@CGSP_COST_6072, ARGS, ARG
RETURN 4

;　타겟(選択するかしないか)
@CGSP_TARGET_6072, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_6072, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　4-召喚時

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_6072, ARGS, ARG, ARG:1
IF (ARG % 20) == CS1_ONESELF
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ENDIF

LOCAL:3 = 0
FOR LOCAL, 0, VARSIZE("OFFERING_CARD_DATE_V", 0)
	SIF OFFERING_CARD_DATE_V:LOCAL:CBV_KINDS >= 100
		LOCAL:3 = 1
NEXT
FOR LOCAL, LOCAL:1, LOCAL:2
	IF LOCAL:3 > 0
		CALL SP_DAMAGE, LOCAL, 3, ARG
	ELSE
		CALL SP_DAMAGE, LOCAL, 2, ARG
	ENDIF
NEXT
IF LOCAL:3 > 0
    CALL CS_SUMMONER_DAMAGE, ARG % 20, 7, -1, 99
ELSE
    CALL CS_SUMMONER_DAMAGE, ARG % 20, 5, -1, 99
ENDIF


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_6072, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_6072, ARGS, ARG
{
RESULTS = 全ての敵仲魔に、2Pのダメージをあたえるが、サマナーも5Pのダメージをうける。
供物にアイテムを使用すると、敵仲魔に3Pダメージを与えるが、サマナーへのダメージが7Pになる。
『核爆弾。強力すぎるためこれを使った者も無傷では済まない。』
}

;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　1(アギとかのダメージ魔法系は1),ダメージ,範囲1体は1、全体は2
@CGSP_TYPE_6072, ARGS, ARG
RESULTS = 自傷5
RETURN 1, 2, 2

@CGSP_TYPE_6072_1, ARGS, ARG
RESULTS = 自傷7
RESULTS:1 = アイテム
RETURN 1, 3, 2

