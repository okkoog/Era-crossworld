;잔/1/0/
;特技名
@CGSP_NAME_6040, ARGS, ARG
RESULTS = 魔装レールガン

;　コストの量
@CGSP_COST_6040, ARGS, ARG
RETURN 2

;　타겟(選択するかしないか)
@CGSP_TARGET_6040, ARGS, ARG
RETURN 3
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_6040, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　4-召喚時

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_6040, ARGS, ARG, ARG:1
LOCAL:3 = 0

FOR LOCAL, 0, VARSIZE("OFFERING_CARD_DATE_V", 0)
	SIF OFFERING_CARD_DATE_V:LOCAL:CBV_COST >= 5
		LOCAL:3 = 1
NEXT

CALL SP_DAMAGE, ARG:1, (LOCAL:3 > 0 ? 3 # 1), ARG


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_6040, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_6040, ARGS, ARG
RESULTS = 敵仲魔1体に1Pのダメージをあたえる。供物にコスト5以上のカードを使用すると3Pダメージになる。『生贄のエネルギーによって強大な破壊力を生み出す禁断の兵器』


;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　1(アギとかのダメージ魔法系は1),ダメージ,範囲1体は1、全体は2
@CGSP_TYPE_6040, ARGS, ARG
RETURN 1, 1, 1

@CGSP_TYPE_6040_1, ARGS, ARG
RESULTS:1 = コスト5以上
RETURN 1, 3, 1

