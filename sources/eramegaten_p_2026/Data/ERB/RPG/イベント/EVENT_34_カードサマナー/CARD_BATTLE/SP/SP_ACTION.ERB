


;ARB	受ける人
;ARB:1	ダメージ
;ARB:2	SP使う人
;ARB:3	0-ダメージ処理を行う 1-ダメージ量を返す(-88で無効、-99で反射)
@SP_DAMAGE, ARG, ARG:1, ARG:2 = -1, ARG:3 = 0
#DIM DAMAGE
#DIM REFLECT
#DIM L_BLOCK

DAMAGE = ARG:1
REFLECT = 0
L_BLOCK = 0

SIF FIELD_DEMON_DATE_V:ARG:CBV_NO < 1
	RETURN 0

SIF STATE_INFO_GET_F(ARG, 5)
	DAMAGE -= RESULT:3
SIF STATE_INFO_GET_F(ARG, 111)
	DAMAGE += RESULT:3

IF ARG:2 >= 20 && ARG:2 <= 110
	SIF STATE_INFO_GET_F(ARG, 14)
		DAMAGE -= RESULT:3
	SIF STATE_INFO_GET_F(ARG, 113)
		DAMAGE += RESULT:3
	SIF STATE_INFO_GET_F(ARG, 15)
		DAMAGE = -88
	IF STATE_INFO_GET_F(ARG, 18)
		REFLECT = ARG:1
		DAMAGE = -99
	ENDIF
ELSEIF ARG:2 >= CBF_ALLY_POS1 && ARG:2 <= CBF_ENEMY_POS6
	SIF STATE_INFO_GET_F(ARG, 16)
		DAMAGE -= RESULT:3
	SIF STATE_INFO_GET_F(ARG, 114)
		DAMAGE += RESULT:3
	SIF STATE_INFO_GET_F(ARG, 17)
		DAMAGE = -88
	IF STATE_INFO_GET_F(ARG, 19)
		REFLECT = ARG:1
		DAMAGE = -99
	ENDIF
ENDIF

IF DAMAGE > -80
	SIF STATE_INFO_GET_F(ARG, 6)
		DAMAGE = -88
	IF STATE_INFO_GET_F(ARG, 20)
		REFLECT = ARG:1
		DAMAGE = -99
	ENDIF
ENDIF

IF ARG:3 == 0
	DAMAGE = MAX(DAMAGE, 0)
	IF DAMAGE > 0
		;FIELD_DEMON_DATE_V:ARG:CBV_HP -= DAMAGE

		;CALL CARDBATTLE_MESSAGE, FIELD_DEMON_DATE_S:ARG:CBS_NAME + @"に{DAMAGE}Pのダメージを与えた。"
		CALL CS_DEMON_BATTLE_DAMAGE, ARG, DAMAGE, ARG:2, 0
		CALL CS_NOHP_DEMON_DEATH, ARG
	ENDIF
	IF REFLECT > 0
		CALL CARDBATTLE_MESSAGE, @"反射された！！"
		IF 0 <= ARG:2 && ARG:2 < 20
			;FIELD_DEMON_DATE_V:(ARG:1):CBV_HP -= REFLECT
			CALL CARDBATTLE_MESSAGE, FIELD_DEMON_DATE_S:(ARG:1):CBS_NAME + @"に{REFLECT}Pのダメージを与えた。"
			CALL CS_NOHP_DEMON_DEATH, (ARG:1)
		ELSEIF ARG:2 >= 20
			CALL CS_SUMMONER_DAMAGE, ARG:1 % 20, REFLECT, ARG, 99
		ENDIF
	ENDIF
ELSEIF ARG:3 == 1
	RETURN DAMAGE, REFLECT
ENDIF


;ARB	回復する召喚士(0,1)
;ARB:1	回復量
;ARB:2	回復する人(サマナーは20以上、ターゲット制)
@SP_SUMMONER_HEAL, ARG, ARG:1, ARG:2 = -1
#DIM HEAL
HEAL = ARG:1

SIF S_STATE_INFO_GET_F(ARG, 101)
	HEAL = 0
HEAL = MAX(HEAL, 0)

SUMMONER_PARAMETER:ARG:CSP2_HP = MIN(SUMMONER_PARAMETER:ARG:CSP2_HP + HEAL, SUMMONER_PARAMETER:ARG:CSP2_MAX_HP)
CALL CARDBATTLE_MESSAGE, SUMMONER_INFO:ARG:CSI2_NANE + (SUMMONER_PARAMETER:ARG:CSP2_HP >= SUMMONER_PARAMETER:ARG:CSP2_MAX_HP ? "は全回復した。" # @"は{HEAL}P回復した。")

;ARB	パワーアップする仲魔
;ARB:1	AP
;ARB:2	HP
;ARB:3	継続時間
;ARB:4	タイミング
@SP_PUWER_UP, ARG, ARG:1 = 0, ARG:2 = 0, ARG:3 = 0, ARG:4 = 0
#DIM APP
#DIM HPP

IF ARG:4 > 0
	APP = (ARG:1 < 0 ? ARG:1 * -1 + 100 # ARG:1)
	HPP = (ARG:2 < 0 ? ARG:2 * -1 + 100 # ARG:2)
	CALL CB_STATE_ADD, ARG, 1001, ARG:3, ARG:4, 1, APP * 1000 + HPP
ELSE
	FIELD_DEMON_DATE_V:ARG:CBV_AP = MAX(FIELD_DEMON_DATE_V:ARG:CBV_AP + ARG:1, 0)
	SIF STATE_INFO_GET_F(ARG, 105) < 1 || ARG:2 < 0
		FIELD_DEMON_DATE_V:ARG:CBV_HP = MAX(FIELD_DEMON_DATE_V:ARG:CBV_HP + ARG:2, 0)
	
	SIF ARG <= CBF_ENEMY_POS6
		CALL CARDBATTLE_MESSAGE, FIELD_DEMON_DATE_S:ARG:CBS_NAME + @"はAP:{FIELD_DEMON_DATE_V:ARG:CBV_AP,2}/HP:{FIELD_DEMON_DATE_V:ARG:CBV_HP,2}になった。"
ENDIF






