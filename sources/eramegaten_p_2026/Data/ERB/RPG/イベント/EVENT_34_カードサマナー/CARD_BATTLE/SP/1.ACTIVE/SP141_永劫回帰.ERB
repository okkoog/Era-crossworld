
;特技名
@CGSP_NAME_141, ARGS, ARG
RESULTS = 永劫回帰

;　コストの量
@CGSP_COST_141, ARGS, ARG
RETURN 0
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_141, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_141, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_141, ARGS, ARG, ARG:1
;

CALL SP_SUMMONER_HEAL, CS1_ONESELF, 20, ARG
CALL SP_SUMMONER_HEAL, CS1_OPPONENT, 20, ARG

;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_141, ARGS, ARG, ARG:1
RETURN 3
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_141, ARGS, ARG
RESULTS = 両サマナーのＨＰを２０Ｐ回復する。このＳＰを使った仲魔は黄泉に葬られる。

;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　31 両方回復
@CGSP_TYPE_141, ARGS, ARG
RETURN 31, 20


