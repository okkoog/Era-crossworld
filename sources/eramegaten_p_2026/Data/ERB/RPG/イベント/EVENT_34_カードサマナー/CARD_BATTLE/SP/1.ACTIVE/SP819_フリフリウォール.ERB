
;特技名
@CGSP_NAME_819, ARGS, ARG
RESULTS = フリフリウォール

;　コストの量
@CGSP_COST_819, ARGS, ARG
RETURN 1
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_819, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_819, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_819, ARGS, ARG, ARG:1
IF FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_ONESELF
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ENDIF
;
FOR LOCAL, LOCAL:1, LOCAL:2
    CALL CB_STATE_ADD, LOCAL, 5, 2, 0, 2
NEXT


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_819, ARGS, ARG, ARG:1
RETURN 3
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　31～33 ダメージSPシールド　31両方　32アイテム　33SP
;　シールドの強さ
;　範囲　1単体　2全体

@CGSP_TYPE_819, ARGS, ARG
RETURN 31, 2, 2

;　 説明文の表示
@CGSP_EXPLAIN_819, ARGS, ARG
RESULTS = 味方仲魔全員を、次ターン終了まで「魔弾耐性2」状態にし、SPやアイテムによるダメージを2軽減する。このＳＰを使った仲魔は黄泉に葬られる。『マメダヌキ専用SP』



