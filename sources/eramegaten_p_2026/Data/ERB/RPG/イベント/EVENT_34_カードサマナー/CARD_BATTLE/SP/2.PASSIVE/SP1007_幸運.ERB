
;特技名
@CGSP_NAME_1007, ARGS, ARG
RESULTS = 幸運%ARGS%

;　コストの量
@CGSP_COST_1007, ARGS, ARG
RETURN 0
;自動発動なので0

;　타겟(選択するかしないか)
@CGSP_TARGET_1007, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_1007, ARGS, ARG
RETURN 3
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_1007, ARGS, ARG, ARG:1
LOCAL = TOINT(ARGS)
CALL CB_STATE_ADD, ARG, 12, 1, 0, MAX(1, LOCAL)

;====================================================
;実行内容ここまで
;====================================================

;発動後どうなるか
@CGSP_ACTION_AFTER_1007, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_1007, ARGS, ARG
RESULTS = ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ時に自身は「幸運%ARGS,2,RIGHT%」状態になり、自身がターゲットの状態付与の確率を{TOINT(ARGS),2}/6({100 * TOINT(ARGS) / 6}％)下げる



