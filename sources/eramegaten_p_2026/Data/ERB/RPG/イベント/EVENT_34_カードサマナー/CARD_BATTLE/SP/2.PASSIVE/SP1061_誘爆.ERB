
;特技名
@CGSP_NAME_1061, ARGS, ARG
IF ISNUMERIC(ARGS) && TOINT(ARGS) > 1
    LOCAL = TOINT(ARGS)
ELSE
    LOCAL = 1
ENDIF

RESULTS = 誘爆{LOCAL}

;　コストの量
@CGSP_COST_1061, ARGS, ARG
RETURN 0
;自動発動なので0

;　타겟(選択するかしないか)
@CGSP_TARGET_1061, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_1061, ARGS, ARG
RETURN 3
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_1061, ARGS, ARG, ARG:1
IF ISNUMERIC(ARGS) && TOINT(ARGS) > 1
    LOCAL = TOINT(ARGS)
ELSE
    LOCAL = 1
ENDIF

CALL CB_STATE_ADD, ARG, 20, 1, 0, LOCAL

;====================================================
;実行内容ここまで
;====================================================

;発動後どうなるか
@CGSP_ACTION_AFTER_1061, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_1061, ARGS, ARG
IF ISNUMERIC(ARGS) && TOINT(ARGS) > 1
    LOCAL = TOINT(ARGS)
ELSE
    LOCAL = 1
ENDIF
RESULTS = 相手のﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ時に自身は「誘爆{LOCAL}」状態になり、バトルでやられた時に相手の仲魔に{LOCAL}のダメージを与える。『バトルでやられてもダメージを与えられるＳＰ』



