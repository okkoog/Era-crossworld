
;特技名
@CGSP_NAME_398, ARGS, ARG
RESULTS = メスラムタエア

;　コストの量
@CGSP_COST_398, ARGS, ARG
RETURN 5
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_398, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか

;　発動タイミング
@CGSP_TIMING_398, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_398, ARGS, ARG, ARG:1
IF FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_ONESELF
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ENDIF

FOR LOCAL, LOCAL:1, LOCAL:2
	CALL CS_DICEROLL_STATE(999, ARG, LOCAL, 105, 1)
NEXT


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_398, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

