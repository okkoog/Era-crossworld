
;特技名
@CGSP_NAME_225, ARGS, ARG
RESULTS = 神殺し

;　コストの量
@CGSP_COST_225, ARGS, ARG
LOCAL:1 = -1
LOCAL:2 = -1
IF ARG >= 0
    IF ARG <= CBF_ALLY_POS6
        LOCAL:1 = CBF_ENEMY_POS1
        LOCAL:2 = CBF_ENEMY_POS6 + 1
    ELSEIF ARG <= CBF_ENEMY_POS6
        LOCAL:1 = CBF_ALLY_POS1
        LOCAL:2 = CBF_ALLY_POS6 + 1
    ENDIF
ENDIF
IF LOCAL:1 > -1
    FOR LOCAL ,LOCAL:1 ,LOCAL:2
        SIF FIELD_DEMON_DATE_V:LOCAL:CBV_NO != 0 && CS_KIND_CHECK(LOCAL ,"LIGHT")
            RETURN 3
    NEXT
ENDIF
RETURN 5

;1

;　타겟(選択するかしないか)
@CGSP_TARGET_225, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_225, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_225, ARGS, ARG, ARG:1
;
CALL SP_PUWER_UP, ARG, 3, 1


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_225, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_225, ARGS, ARG
RESULTS = このＳＰを使うと使った仲魔はこのターンの間、ＡＰ＋３／ＨＰ＋１になる。相手の場にライト仲魔がいると使用コストが３になる。


;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　2(このターンパワーアップは2),AP,HP,自身は1、他人は2、全体は3
@CGSP_TYPE_225, ARGS, ARG
RETURN 2, 3, 1, 1

