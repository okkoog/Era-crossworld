;特技発動
;====================================================
@CGSP_ACTION_640, ARGS, ARG, ARG:1
CALL CB_S_STATE_ADD, FIELD_DEMON_DATE_V:ARG:CBV_HOST, 8, 2

;CALL CS_DICEROLL_S_STATE,999, ARG, FIELD_DEMON_DATE_V:ARG:CBV_HOST, 8, 1, 2

