		CALL MESSAGE_WINDOW_EM_ICON, "CardSummoner", E34_C_ICON_N("리젤"), RESULTS, , "리젤", @"%NAME:MASTER% 씨　이 승부 이길 수 있을지도 몰라./다음 턴 자신의 어택을 생각해서 블록해 봐"
		
		CS_TUTORIAL:1 = 8
	ELSEIF CBF_TURN == 7 && ARG == 6 && CS_TUTORIAL:1 == 8
		{
		IF ((FIELD_DEMON_DATE_V:0:CBV_BATTLE > 0 && FIELD_DEMON_DATE_V:1:CBV_BATTLE == 0) || 
			(FIELD_DEMON_DATE_V:1:CBV_BATTLE > 0 && FIELD_DEMON_DATE_V:0:CBV_BATTLE == 0))&&
			FIELD_DEMON_DATE_V:2:CBV_BATTLE == 0 && FIELD_DEMON_DATE_V:3:CBV_BATTLE == 0
		}
		ELSE
			CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("리젤"), RESULTS, , "리젤", @"%NAME:MASTER% 씨/더 좋은 방법이 있어"
			CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("리젤"), RESULTS, , "리젤", @"지금 HP는 5, 그레이맨의 AP는 3/1체 공격을 받아도 살아남을 수 있을 거야"
			CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("리젤"), RESULTS, , "리젤", @"게다가, 다음 턴에 블록할 수 있는 건/일루얀카스뿐이야./상대의 HP는 5, 다음 턴에 처치할 방법을 생각하는 거야."
			SIF !RAND:10
				CALL CS_BATTLE_MESSAGE_WINDOW_ICON, 0, "　", , "하늘의 소리", @"푸르손 1체만으로 블록하는 것입니다."
			RETURN -1
		ENDIF
	ELSEIF CBF_TURN == 8 && ARG == 99 && CS_TUTORIAL:1 == 8
		CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("리젤"), RESULTS, , "리젤", @"이걸로 %NAME:MASTER% 씨의 승리네."
		CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("루나"), RESULTS, , "루나", "네? 방금 뭐라고요?"
	ELSEIF CBF_TURN == 8 && ARG == 5 && CS_TUTORIAL:1 == 8
		{
		IF (FIELD_DEMON_DATE_V:0:CBV_BATTLE > 0 || FIELD_DEMON_DATE_V:1:CBV_BATTLE > 0) &&
			FIELD_DEMON_DATE_V:2:CBV_BATTLE > 0 && FIELD_DEMON_DATE_V:3:CBV_BATTLE > 0
		}
		ELSE
			CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("리젤"), RESULTS, , "리젤", @"%NAME:MASTER% 씨/더 좋은 방법이 있어"
			SIF !RAND:10
				CALL CS_BATTLE_MESSAGE_WINDOW_ICON, 0, "　", , "하늘의 소리", @"바실리스크 2체와 푸르손 1체로 어택하는 것입니다."
			RETURN -1
		ENDIF
	ELSEIF ARG == 7 && CS_TUTORIAL:1 < 8
		CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("루나"), RESULTS, , "루나", "잠깐만요! 기브업은 금지라고요!"
		RETURN -1
	ENDIF
	
	
	
	
	
	
	
