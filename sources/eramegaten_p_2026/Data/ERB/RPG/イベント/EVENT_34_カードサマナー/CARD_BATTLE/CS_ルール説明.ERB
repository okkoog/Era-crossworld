	CALL BF_PHASE_WINDOW , 0 , 0 , 92
	CALL BF_SUMMONER_WINDOW , 1 , 0 , 0
	CALL BF_DEMON_WINDOW , 1 , 3 , 12
	CALL SET_PICTURE , @"%"=" * 132%" , 19 , , 0
	CALL SET_PICTURE , "　" , 20 , , 0
	CALL SET_PICTURE , @"%"=" * 132%" , 21 , , 0
	CALL BF_DEMON_WINDOW , 0 , 22 , 12
	CALL BF_SUMMONER_WINDOW , 0 , 23 , 0
	CALL BF_DECK_WINDOW , 99 , 38 , 32

	CALL SET_PICTURE, , 0, "HTML表示", 50
	PRINTL
	PRINTL
	CALL CARDBATTLE_MESSAGE, @"%FIELD_DEMON_DATE_S:6:CBS_NAME%의 공격！", 1, 1
	CALL CS_SUMMONER_ATTACK, 6, 0
	FIELD_DEMON_DATE_V:6:CBV_BATTLE = 0
	
	PRINTL
	PRINTL
	CALL SET_PICTURE, , , "消去"
	CALL BF_PHASE_WINDOW , 0 , 0 , 92
	CALL BF_SUMMONER_WINDOW , 1 , 0 , 0
	CALL BF_DEMON_WINDOW , 1 , 3 , 12
	CALL SET_PICTURE , @"%"=" * 132%" , 19 , , 0
	CALL SET_PICTURE , "　" , 20 , , 0
	CALL SET_PICTURE , @"%"=" * 132%" , 21 , , 0
	CALL BF_DEMON_WINDOW , 0 , 22 , 12
	CALL BF_SUMMONER_WINDOW , 0 , 23 , 0
	CALL BF_DECK_WINDOW , 99 , 38 , 32

	CALL SET_PICTURE, , 0, "HTML表示", 50
	PRINTL
	PRINTL
	WAIT
	PRINTW 이와 같이 「HP」를 깎을 수 있습니다.
	PRINTW 상대 푸르손의 「어택」으로 당신의 「현재 HP」가 「2」 줄어들었습니다.
	PRINTW 하지만 당신의 「필드」에 동료마가 존재하면, 그 공격을 「블록」하여 막아낼 수 있습니다.
	PRINTL
	PRINTL
