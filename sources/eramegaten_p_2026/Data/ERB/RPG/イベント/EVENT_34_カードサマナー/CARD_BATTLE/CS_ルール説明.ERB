	CALL SET_PICTURE, , , "消去"
	CALL BF_PHASE_WINDOW , 0 , 0 , 92
	CALL BF_SUMMONER_WINDOW , 1 , 0 , 0
	CALL BF_DEMON_WINDOW , 1 , 3 , 12
	CALL SET_PICTURE , @"%"=" * 132%" , 19 , , 0
	CALL SET_PICTURE , "　" , 20 , , 0
	CALL SET_PICTURE , @"%"=" * 132%" , 21 , , 0
	CALL BF_DEMON_WINDOW , 0 , 22 , 12
	CALL BF_SUMMONER_WINDOW , 0 , 23 , 0
	CALL BF_DECK_WINDOW , 99 , 38 , 32

	CALL SET_PICTURE, , 0, "HTML表示", 50
	PRINTL
	PRINTL
	WAIT
	PRINTW 이것은 푸르손의 「HP:2」에 대해 탕가타 마누의 「AP:2」이므로,
	PRINTW 푸르손이 상대 필드에서 사라졌습니다.
	PRINTW 반면, 탕가타 마누의 「HP:3」에 대해 푸르손의 「AP:2」이므로,
	PRINTW 탕가타 마누는 공격을 받았으나 HP가 「1」 남아 살아남았습니다.
	PRINTW 이것이 어택과 블록의 기본입니다. 「HP」가 높은 동료마를 소환하면 블록 시에 유리해집니다.
	PRINTL
	PRINTL
	
	VARSET FIELD_DEMON_DATE_V
	VARSET FIELD_DEMON_DATE_S
	VARSET FIELD_DEMON_STATE_V
	VARSET FIELD_DEMON_STATE_S

@CS_TUTORIAL_SUMMON
#DIM L_LINE
#DIM L_COUNT
#DIM L_SELECT
	PRINTW 그럼, 튜토리얼을 진행하겠습니다.
	PRINTL 서로 HP는 4, 덱의 매수는 0,
	PRINTW 패는 「탕가타 마누」 「푸르손」의 2장으로 진행합니다.
	CS_TUTORIAL:0 = 1
	CS_TUTORIAL:1 = 0
	CS_DECK_FIXED = 1
	CS_START_T_FIXED = 1
	SUMMONER_INFO:CS1_ONESELF:CSI2_NANE = 당신
	SUMMONER_PARAMETER:CS1_ONESELF:CSP2_ALIGNMENT = 23
	SUMMONER_HAND_CARDS:CS1_ONESELF:0 = 34
	SUMMONER_HAND_CARDS:CS1_ONESELF:1 = 32
	
	SUMMONER_INFO:CS1_OPPONENT:CSI2_NANE = 상대
	SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT = 23
	SUMMONER_HAND_CARDS:CS1_OPPONENT:0 = 34
	SUMMONER_HAND_CARDS:CS1_OPPONENT:1 = 32
	
	CALL CS_BATTLE_START, 0, 4, 4
	
	
	CS_TUTORIAL:0 = 0
	CS_TUTORIAL:1 = 0
	CS_DECK_FIXED = 0
	CS_START_T_FIXED = 0
	
	VARSET FIELD_DEMON_DATE_V
	VARSET FIELD_DEMON_DATE_S
	VARSET FIELD_DEMON_STATE_V
	VARSET FIELD_DEMON_STATE_S

@CS_RULE_GETMAG
#DIM L_LINE
#DIM L_COUNT
#DIM L_SELECT
	PRINTL
	PRINTL
	PRINTW 획득 MAG에 대해 알려드리겠습니다.
	PRINTL
	PRINTL
	SUMMONER_INFO:CS1_ONESELF:CSI2_NANE = 당신
	SUMMONER_PARAMETER:CS1_ONESELF:CSP2_ALIGNMENT = 23
	
	SUMMONER_INFO:CS1_OPPONENT:CSI2_NANE = 상대
	SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT = 23
	
	CALL CS_DEMON_SUMMON_FIELD, 6, 27
	CBF_SELECT = 1006
	
	CALL CARDBATTLE_MESSAGE, @"　",1 ,1

	CALL SET_PICTURE, , 0, "HTML表示", 50
	WAIT
	PRINTL
	PRINTL
	PRINTW 키키모라를 살펴봅시다.
	PRINTW 필드 쪽에는 「M → 2」, 아래쪽 파라미터 쪽에는 「MAG: 2」라고 되어 있지요.
	PRINTW 이 수치는 동료마가 턴 시작 시 방출하는 MAG의 양이 됩니다.
	PRINTW 필드에 있는 동료마의 그 MAG 합계치에 따라 서머너가 획득하는 MAG가 결정됩니다.
	PRINTW 하지만 서머너가 획득하는 MAG의 양에는 최저 보증이 있습니다.
	PRINTW 동료마의 MAG 합계가 「4 이하」일 경우, 서머너가 MAG를 획득하는 양은 「4」가 됩니다.
	PRINTW 그리고 동료마의 MAG 합계가 「5 이상」일 경우, 서머너가 MAG를 획득하는 양은 「5 이상」이 됩니다.
	PRINTL 
	PRINTW 이 최저 보증의 「4」를 「서머너의 마그네타이트」, 동료마의 방출 MAG 합계치를 「동료마의 마그네타이트」라고 한다면,
	PRINTW 「서머너의 마그네타이트」보다 「동료마의 마그네타이트」 쪽이 많으면 「동료마의 마그네타이트」를 획득한다.
	PRINTW 「동료마의 마그네타이트」보다 「서머너의 마그네타이트」 쪽이 많으면 「서머너의 마그네타이트」를 획득한다.
	PRINTW 라는 느낌입니다.
	PRINTW 동료마를 필드에 소환하면 할수록 획득하는 MAG가 많아져, 강력한 악마의 소환이나 SP, 아이템을 많이 쓸 수 있습니다.
	;추가 룰S　2024/10/12＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
	;PRINTL 
	;PRINTW 그리고, MAG를 사용하지 않고 있으면, 다음에 이월할 수 있습니다.
	;PRINTW 필드 중마의 MAG 합계가 소지 MAG보다 적을 경우, MAG는 그대로 유지됩니다.
	;추가 룰E＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
	PRINTL
	PRINTL
	VARSET FIELD_DEMON_DATE_V
	VARSET FIELD_DEMON_DATE_S
	VARSET FIELD_DEMON_STATE_V
	VARSET FIELD_DEMON_STATE_S
	
@CS_TUTORIAL_SP
#DIM L_LINE
#DIM L_COUNT
#DIM L_SELECT
	PRINTL
	PRINTL
	PRINTW 다음은 SP에 대해 알려드리겠습니다.
	PRINTW SP란 동료마가 가진 특기를 말합니다.
	PRINTW 턴 시작 시에 자동으로 발동하는 것과, 서머너가 임의로 발동할 수 있는 것이 있습니다.
	PRINTW 코스트가 있는 SP도 존재하며, 사용 시 MAG를 소비합니다.
	PRINTW 그 외에도 사용 시 탭(동결)되는 동료마도 있으므로, 탭 시에는 주의합시다.
	PRINTW 지금부터 SP를 가진 동료마를 표시하겠습니다. 파라미터를 확인해 주세요.
	PRINTL
	PRINTL
	L_LINE = LINECOUNT
	L_SELECT = 1
	LOCAL:1 = 35
	LOCAL:2 = 53
	LOCAL:3 = 59
	LOCAL:4 = 87
	LOCAL:5 = 122
	LOCAL:6 = 113
	
	LOCAL:7 = 36
	LOCAL:8 = 129
	LOCAL:9 = 6
	LOCAL:10 = 55
	LOCAL:11 = 78
	LOCAL:12 = 85
	
	$INPUT_LOOP
	CLEARLINE LINECOUNT - L_LINE
	CALL SET_PICTURE, , , "消去"
