
@CS_RULE
#DIM L_LINE
#DIM L_COUNT
#DIM L_SELECT

PRINTL [ 0] 배틀 필드에 대하여
PRINTL [ 1] 어택, 블록에 대하여
PRINTL [ 2] 튜토리얼 1　기본 조작(소환, 어택, 블록)
PRINTL [ 3] 획득 MAG에 대하여
PRINTL [ 4] 튜토리얼 2　SP
PRINTL [ 5] 페이즈에 대하여
PRINTL [ 6] 비행 동료마에 대하여
PRINTL [ 7] 합체 동료마에 대하여
PRINTL [ 8] 속성에 대하여
PRINTL [ 9] 제물에 대하여
PRINTL [10] 스톡 마그에 대하여
PRINTL 
PRINTL [99] 돌아간다
INPUT


IF RESULT == 0
	CALL CS_RULE_FIELD
ELSEIF RESULT == 1
	CALL CS_RULE_BATTLE
ELSEIF RESULT == 2
	CALL CS_TUTORIAL_SUMMON
ELSEIF RESULT == 3
	CALL CS_RULE_GETMAG
ELSEIF RESULT == 4
	CALL CS_TUTORIAL_SP
ELSEIF RESULT == 5
	CALL CS_RULE_PHASE
ELSEIF RESULT == 6
	CALL CS_RULE_FLYING_DEMONS
ELSEIF RESULT == 7
	CALL CS_RULE_FUSION_DEMONS
ELSEIF RESULT == 8
	CALL CS_RULE_ALIGNMENT
ELSEIF RESULT == 9
	CALL CS_RULE_KUMOTU
ELSEIF RESULT == 10
	CALL CS_RULE_STOCKMAG
ELSEIF RESULT == 99
	RETURN
ENDIF

RESTART

@CS_RULE_FIELD
#DIM L_LINE
#DIM L_COUNT
#DIM L_SELECT
	SUMMONER_INFO:CS1_ONESELF:CSI2_NANE = 당신
	SUMMONER_PARAMETER:CS1_ONESELF:CSP2_MAX_HP = 5
	SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP = 5
	SUMMONER_PARAMETER:CS1_ONESELF:CSP2_ALIGNMENT = 23
	
	SUMMONER_INFO:CS1_OPPONENT:CSI2_NANE = 상대
	SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_MAX_HP = 5
	SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP = 5
	SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT = 23
	PRINTL
	PRINTL
	PRINTW 여기서는 카드 서머너의 플레이어를 「서머너」라고 부릅니다.
	PRINTL
	PRINTL
	CALL SET_PICTURE, , , "消去"
	CALL BF_PHASE_WINDOW , 0 , 0 , 92
	CALL BF_SUMMONER_WINDOW , 1 , 0 , 0
	CALL BF_DEMON_WINDOW , 1 , 3 , 12
	CALL SET_PICTURE , @"%"=" * 132%" , 19 , , 0
	CALL SET_PICTURE , "　" , 20 , , 0
	CALL SET_PICTURE , @"%"=" * 132%" , 21 , , 0
	CALL BF_DEMON_WINDOW , 0 , 22 , 12
	CALL BF_SUMMONER_WINDOW , 0 , 23 , 0
	CALL BF_DECK_WINDOW , 99 , 38 , 32

	CALL SET_PICTURE, , 0, "HTML表示", 50
	WAIT
	PRINTL
	PRINTL
	PRINTW 이것이 카드 서머너의 「배틀 필드」입니다.
	PRINTW 「배틀 필드」는 통칭 「필드(필드)」라고 불립니다.
	PRINTW 아래쪽이 자신의 필드, 위쪽이 대전 상대의 「필드」가 됩니다.
	PRINTW 왼쪽에 표시된 파란색과 빨간색은 서머너의 파라미터를 표시하고 있습니다.
	PRINTW 파란색은 자신, 빨간색은 상대의 파라미터를 나타냅니다.
	PRINTW 「DECK」은 덱의 남은 매수, 「HAND」는 패(핸드)의 매수를 나타냅니다.
	PRINTW 「MAG」는 자신의 턴일 때 쓸 수 있는 코스트를 나타냅니다.
	PRINTW 「HP」는 체력입니다. 둘 표시되어 있으며, 왼쪽이 「현재 HP」, 오른쪽이 「최대 HP」가 됩니다.
	PRINTW 서로의 서머너는 「현재 HP」를 깎아, 이를 「0」으로 만들면 승부가 결정됩니다.
	PRINTL 
	PRINTL 
	PRINTW 그럼, 다음으로 동료마의 소환을 진행하겠습니다.
	PRINTW 여기서는 유닛을 필드에 내놓는 것을 「소환」이라 부르고, 소환된 유닛을 「동료마」라고 부릅니다.
	PRINTL 
	PRINTL 
	CALL CS_DEMON_SUMMON_FIELD, 6, 39
	
	CALL SET_PICTURE, , , "消去"
	CALL BF_PHASE_WINDOW , 0 , 0 , 92
	CALL BF_SUMMONER_WINDOW , 1 , 0 , 0
	CALL BF_DEMON_WINDOW , 1 , 3 , 12
	CALL SET_PICTURE , @"%"=" * 132%" , 19 , , 0
	CALL SET_PICTURE , "　" , 20 , , 0
	CALL SET_PICTURE , @"%"=" * 132%" , 21 , , 0
	CALL BF_DEMON_WINDOW , 0 , 22 , 12
	CALL BF_SUMMONER_WINDOW , 0 , 23 , 0
	CALL BF_DECK_WINDOW , 99 , 38 , 32

	CALL SET_PICTURE, , 0, "HTML表示", 50
	WAIT
	PRINTL
	PRINTL
	PRINTW 지금, 상대 필드에 픽시가 소환되었지만, 표시가 갈색으로 되어 있습니다.
	PRINTW 이것은 실체화되지 않아 아무 행동도 일으킬 수 없습니다. 이른바 소환 후유증입니다.
	PRINTW 이 상태를 「카드 상태」라고 부르며, 턴이 지나면 하얗게 변해 행동을 취할 수 있는 「액티브 상태」가 됩니다.
	PRINTL
	PRINTL
	
	FIELD_DEMON_DATE_V:6:CBV_CONDITION = 0
	
	CALL SET_PICTURE, , , "消去"
	CALL BF_PHASE_WINDOW , 0 , 0 , 92
	CALL BF_SUMMONER_WINDOW , 1 , 0 , 0
	CALL BF_DEMON_WINDOW , 1 , 3 , 12
	CALL SET_PICTURE , @"%"=" * 132%" , 19 , , 0
	CALL SET_PICTURE , "　" , 20 , , 0
	CALL SET_PICTURE , @"%"=" * 132%" , 21 , , 0
	CALL BF_DEMON_WINDOW , 0 , 22 , 12
	CALL BF_SUMMONER_WINDOW , 0 , 23 , 0
	CALL BF_DECK_WINDOW , 99 , 38 , 32

	CALL SET_PICTURE, , 0, "HTML表示", 50
	WAIT
	PRINTL
	PRINTL
	VARSET FIELD_DEMON_DATE_V
	VARSET FIELD_DEMON_DATE_S
	VARSET FIELD_DEMON_STATE_V
	VARSET FIELD_DEMON_STATE_S

