;잔/1/0/
;特技名
@CGSP_NAME_6020, ARGS, ARG
RESULTS = 対魔機関銃　３Ｐ

;　コストの量
@CGSP_COST_6020, ARGS, ARG
RETURN 6

;　타겟(選択するかしないか)
@CGSP_TARGET_6020, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_6020, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　4-召喚時

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_6020, ARGS, ARG, ARG:1
IF (ARG % 20) == CS1_ONESELF
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ENDIF

FOR LOCAL, LOCAL:1, LOCAL:2
	TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:LOCAL:CBV_SP1}, FIELD_DEMON_DATE_S:LOCAL:CBS_SP1_SUB, LOCAL
		SIF RESULT == 1
			CALL SP_DAMAGE, LOCAL, 3, ARG
	CATCH
	ENDCATCH
NEXT


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_6020, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_6020, ARGS, ARG
RESULTS = ダメージSPを持っている全ての敵仲魔に3Pのダメージを与える。『アギなどのスキルを覚えた敵を一掃できる。弾にディスペル弾を使ったマシンガン』

;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　1(アギとかのダメージ魔法系は1),ダメージ,範囲1体は1、全体は2
@CGSP_TYPE_6020, ARGS, ARG
RESULTS = ダメSP+3
RETURN 1, 0, 2

