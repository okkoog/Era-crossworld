
;特技名
@CGSP_NAME_697, ARGS, ARG
RESULTS = オルレアンの祈り

;　コストの量
@CGSP_COST_697, ARGS, ARG
RETURN 0
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_697, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_697, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_697, ARGS, ARG, ARG:1

SUMMONER_PARAMETER:(FIELD_DEMON_DATE_V:ARG:CBV_HOST):CSP2_MAG += 1
LOCAL = FIELD_DEMON_DATE_V:ARG:CBV_HOST + 100
CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(LOCAL) + @"は1PのMAGが増加した。"

CALL CB_STATE_ADD, ARG, 996, 1
CALL CB_STATE_ADD, ARG, 105, 1
CALL CS_DEMON_BATTLE_DAMAGE, ARG, 5, ARG, 99

;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_697, ARGS, ARG, ARG:1
RETURN 1
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_697, ARGS, ARG
RESULTS = サマナーのＭＡＧを１増加させる。ただし、このＳＰを使った仲魔は5ダメージを受けフリーズ、「HP上昇封」「MAG放出」状態になる。『ジャンヌ・ダルク専用のＳＰ』

;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　41 MAG獲得
@CGSP_TYPE_697, ARGS, ARG
RETURN 41, 1

