;特技発動
;====================================================
@CGSP_ACTION_6069, ARGS, ARG, ARG:1
;

FOR LOCAL, CBF_ALLY_POS1, CBF_ENEMY_POS6 + 1
    CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(LOCAL) + @"はHPが3になった。"
    FIELD_DEMON_DATE_V:LOCAL:CBV_HP = 3
NEXT

