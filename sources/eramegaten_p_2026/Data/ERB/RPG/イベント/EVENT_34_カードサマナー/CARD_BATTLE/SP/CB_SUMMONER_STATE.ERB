
@CB_S_STATE_ADD, L_SUMMONER, STATE_DATA_V:CSS3_STATE, STATE_DATA_V:CSS3_TURN, STATE_DATA_V:CSS3_SUB1 = 0, STATE_DATA_V:CSS3_SUB2 = 0, STATE_DATA_V:CSS3_SUB3 = 0
#DIM L_SUMMONER
#DIM STATE_DATA_V, VARSIZE("SUMMONER_STATE", 2)
#DIMS STATE_DATA_A
#DIMS STATE_DATA_B
#DIMS STATE_DATA_AL
#DIMS STATE_DATA_BL
#DIM F_SAME_V
#DIM F_SAME_S
#DIM L_COUNT
#DIM L_SORT1, VARSIZE("SUMMONER_STATE", 1), VARSIZE("SUMMONER_STATE", 2)
#DIMS L_SORT2, VARSIZE("SUMMONER_STATE", 1)

#DIMS S_NAME

S_NAME = %CS_PIC_NAME(L_SUMMONER + 100)%

STATE_DATA_AL = {STATE_DATA_V:CSS3_STATE,4}{STATE_DATA_V:CSS3_TURN,4}{STATE_DATA_V:CSS3_SUB1,4}{STATE_DATA_V:CSS3_SUB2,4}{STATE_DATA_V:CSS3_SUB3,4}
STATE_DATA_BL = {STATE_DATA_V:CSS3_STATE,4}{STATE_DATA_V:CSS3_SUB1,4}{STATE_DATA_V:CSS3_SUB2,4}{STATE_DATA_V:CSS3_SUB3,4}

SIF L_SUMMONER < 0 || L_SUMMONER > 1 || STATE_DATA_V:CSS3_STATE < 1
	RETURN 0
FOR LOCAL, 0, VARSIZE("SUMMONER_STATE", 1)
	STATE_DATA_A = {SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_STATE,4}{SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_TURN,4}{SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_SUB1,4}{SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_SUB2,4}{SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_SUB3,4}
	STATE_DATA_B = {SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_STATE,4}{SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_SUB1,4}{SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_SUB2,4}{SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_SUB3,4}
	SIF STATE_DATA_AL == STATE_DATA_A
		RETURN 0
	IF STATE_DATA_AL == STATE_DATA_B
		IF SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_TURN < STATE_DATA_V:CSS3_TURN
			SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_TURN = STATE_DATA_V:CSS3_TURN
			RETURN 2
			LOCALS = S_STATE_NAME_FULL(STATE_DATA_V:CSS3_STATE, STATE_DATA_V:CSS3_TURN, STATE_DATA_V:CSS3_SUB1, STATE_DATA_V:CSS3_SUB2, STATE_DATA_V:CSS3_SUB3)
			CALL CARDBATTLE_MESSAGE, @"%S_NAME%は『%LOCALS%』状態のターンが延長された。"
		ELSE
			LOCALS = S_STATE_NAME_FULL(STATE_DATA_V:CSS3_STATE, STATE_DATA_V:CSS3_TURN, STATE_DATA_V:CSS3_SUB1, STATE_DATA_V:CSS3_SUB2, STATE_DATA_V:CSS3_SUB3)
			CALL CARDBATTLE_MESSAGE, @"%S_NAME%は『%LOCALS%』状態にすでになっている。"
			RETURN 0
		ENDIF
	ENDIF
	IF SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_STATE < 1
		FOR L_COUNT ,0 , VARSIZE("SUMMONER_STATE", 2)
			SUMMONER_STATE:L_SUMMONER:LOCAL:L_COUNT = STATE_DATA_V:L_COUNT
		NEXT
		BREAK
	ENDIF
NEXT

VARSET L_SORT1
VARSET L_SORT2
FOR LOCAL, 0, VARSIZE("SUMMONER_STATE", 1)
	IF SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_STATE > 0
		L_SORT2:LOCAL = {SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_STATE,4}{5000-SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_SUB1,4}{5000-SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_SUB2,4}{5000-SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_SUB3,4}{SUMMONER_STATE:L_SUMMONER:LOCAL:CSS3_TURN,4}
		FOR L_COUNT ,0 , VARSIZE("SUMMONER_STATE", 2)
			L_SORT1:LOCAL:L_COUNT = SUMMONER_STATE:L_SUMMONER:LOCAL:L_COUNT
		NEXT
	ENDIF
NEXT

ARRAYMSORT L_SORT2, L_SORT1

FOR LOCAL, 0, VARSIZE("SUMMONER_STATE", 1)
	FOR L_COUNT ,0 , VARSIZE("SUMMONER_STATE", 2)
		SUMMONER_STATE:L_SUMMONER:LOCAL:L_COUNT = L_SORT1:LOCAL:L_COUNT
	NEXT
NEXT

LOCALS '= S_STATE_NAME_FULL(STATE_DATA_V:CSS3_STATE, STATE_DATA_V:CSS3_TURN, STATE_DATA_V:CSS3_SUB1, STATE_DATA_V:CSS3_SUB2, STATE_DATA_V:CSS3_SUB3)
CALL CARDBATTLE_MESSAGE, @"%S_NAME%は『%LOCALS%』状態になった。"

RETURN 1


@CB_S_STATE_DELETE, L_SUMMONER, ARG
#DIM L_SUMMONER
#DIM L_COUNT
SIF L_SUMMONER < 0 || L_SUMMONER > 1 || VARSIZE("SUMMONER_STATE", 1) <= ARG
	RETURN 0
FOR LOCAL, ARG, VARSIZE("SUMMONER_STATE", 1) - 1
	FOR L_COUNT ,0 , VARSIZE("SUMMONER_STATE", 2)
		SUMMONER_STATE:L_SUMMONER:LOCAL:L_COUNT = SUMMONER_STATE:L_SUMMONER:(LOCAL + 1):L_COUNT
	NEXT
NEXT
FOR L_COUNT ,0 , VARSIZE("SUMMONER_STATE", 2)
	SUMMONER_STATE:L_SUMMONER:(VARSIZE("SUMMONER_STATE", 1) - 1):L_COUNT = 0
NEXT

@CB_S_STATE_DELETE2, L_SUMMONER, ARG
#DIM L_SUMMONER
#DIM L_COUNT

SIF L_SUMMONER < 0 || L_SUMMONER > 1 || ARG < 1
	RETURN 0

FOR LOCAL, VARSIZE("SUMMONER_STATE", 1) - 1 , -1 , -1
	SIF SUMMONER_STATE:L_SUMMONER:LOCAL:CBV_STATE == ARG
		CALL CB_S_STATE_DELETE, L_SUMMONER, LOCAL
NEXT



