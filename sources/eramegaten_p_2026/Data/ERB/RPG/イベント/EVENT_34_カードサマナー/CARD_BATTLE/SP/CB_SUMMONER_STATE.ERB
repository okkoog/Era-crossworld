{
RETURNF S_STATE_NAME_FULL(SUMMONER_STATE:SUMMONER:ARG:CSS3_STATE, SUMMONER_STATE:SUMMONER:ARG:CSS3_TURN
, SUMMONER_STATE:SUMMONER:ARG:CSS3_SUB1, SUMMONER_STATE:SUMMONER:ARG:CSS3_SUB2, SUMMONER_STATE:SUMMONER:ARG:CSS3_SUB3)
}

@S_STATE_NAME_FULL, L_STATE, L_TURN, L_SUB1 = 0, L_SUB2 = 0, L_SUB3 = 0
#FUNCTIONS
#DIM L_STATE
#DIM L_TURN
#DIM L_SUB1
#DIM L_SUB2
#DIM L_SUB3

LOCALS =

;IF STATE > 1000
;	IF TIMING 
LOCALS += S_STATE_NAME_GET(L_STATE) + (L_SUB1 > 0 ? @"{L_SUB1}" # "")

RETURNF LOCALS



@S_STATE_INFO_GET, ARG, STATE
#DIM STATE
FOR LOCAL, 0, VARSIZE("SUMMONER_STATE", 1)
	IF SUMMONER_STATE:ARG:LOCAL:CBV_STATE == STATE
		RESULT:1 = SUMMONER_STATE:ARG:LOCAL:CSS3_TURN 
		RESULT:2 = SUMMONER_STATE:ARG:LOCAL:CSS3_SUB1 
		RESULT:3 = SUMMONER_STATE:ARG:LOCAL:CSS3_SUB2 
		RESULT:4 = SUMMONER_STATE:ARG:LOCAL:CSS3_SUB3
		RETURN STATE
	ENDIF
NEXT
RETURN 0

@S_STATE_INFO_GET_F, ARG, STATE
#FUNCTION
#DIM STATE
FOR LOCAL, 0, VARSIZE("SUMMONER_STATE", 1)
	IF SUMMONER_STATE:ARG:LOCAL:CBV_STATE == STATE
		RESULT:1 = SUMMONER_STATE:ARG:LOCAL:CSS3_TURN 
		RESULT:2 = SUMMONER_STATE:ARG:LOCAL:CSS3_SUB1 
		RESULT:3 = SUMMONER_STATE:ARG:LOCAL:CSS3_SUB2 
		RESULT:4 = SUMMONER_STATE:ARG:LOCAL:CSS3_SUB3
		RETURNF STATE
	ENDIF
NEXT
RETURNF 0









