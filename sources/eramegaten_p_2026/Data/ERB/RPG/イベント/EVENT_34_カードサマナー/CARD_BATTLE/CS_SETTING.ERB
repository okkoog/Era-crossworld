@CARDBATTLE_SETTING
#DIM L_LINE
L_LINE = LINECOUNT

$START
CLEARLINE LINECOUNT - L_LINE

DRAWLINE
PRINTL 어떤 설정을 변경하시겠습니까?
DRAWLINE
PRINTBUTTON @"%"[ 0]배틀 메시지 속도",30,LEFT%", 0
PRINTFORML %CB_SETTING_BM_SPEED != 9999 ? @"{CB_SETTING_BM_SPEED}ms" # "無限"%
PRINTBUTTON @"%"[ 1]名前変更",30,LEFT%", 1
PRINTFORML %NAME:MASTER%
PRINTBUTTON @"%"[ 2]主人公画像設定",30,LEFT%", 2
PRINTFORML %CBF_IMAGE_ID%
PRINTBUTTON @"%"[50]카드 화상 설정",30,LEFT%", 50
PRINTFORML 
DRAWLINE
PRINTBUTTON @"[99]돌아간다", 99
INPUT
IF RESULT == 0
	CALL CARDBATTLE_MESSAGE_SPEED_SETTING
ELSEIF RESULT == 1
	CALL CARDBATTLE_NAMECHANGE_SETTING
ELSEIF RESULT == 2
	CALL CARDBATTLE_OWN_IMAGE_SETTING
ELSEIF RESULT == 50
	CALL CARDBATTLE_CARD_IMAGE_SETTING
ELSEIF RESULT == 99
	RETURN
ENDIF
GOTO START




@CARDBATTLE_MESSAGE_SPEED_SETTING

PRINTL 얼마로 설정하시겠습니까? (1당 1ms(1/1000초), 9999 입력 시 무한)
INPUT
IF 0 <= RESULT
	CB_SETTING_BM_SPEED = RESULT
ELSE
	PRINTW 수치가 너무 작습니다.
ENDIF


@CARDBATTLE_NAMECHANGE_SETTING
PRINTL 변경할 이름을 입력해 주세요.
INPUTS
IF "" != RESULTS
	PRINTFORML %RESULTS%
	PRINTFORML 이 이름으로 괜찮습니까?
	PRINTFORML [0]네　[1]아니오
	INPUT
	SIF RESULT == 0
		NAME:MASTER '= RESULTS
ENDIF


@CARDBATTLE_OWN_IMAGE_SETTING
#DIMS L_PIC
PRINTL 자신의 필드에 사용할 서머너의 화상 이름을 입력해 주세요.
PRINTL ※4행 또는 6행의 정사각형 화상을 설정해 주세요.
INPUTS
LOCAL = IMAGE_LINE_COUNT(RESULTS)
IF LOCAL == 4 || LOCAL == 6
	FOR LOCAL:1, 1, LOCAL + 1
		PRINT_IMG RESULTS + "_" + @"{LOCAL:1}"
		PRINTFORML ║
	NEXT
	PRINTFORML %"　" * LOCAL%║
	PRINTFORML %RESULTS%
	PRINTFORML 이 화상으로 괜찮습니까?
	PRINTFORML ※우측 선이 위에서 아래까지 끊어지지 않았다면 OK입니다.
	PRINTFORML [0]네　[1]아니오
	INPUT
	SIF RESULT == 0
		CBF_IMAGE_ID '= RESULTS
ELSE
	L_PIC = RESULTS
	SPRITECREATED L_PIC
	IF RESULT
		HTML_PRINT "<img src = '" + L_PIC + "' height = '600' width = '600'>"
		PRINTFORML \n\n\n\n\n
		PRINTFORML %L_PIC%
		PRINTFORML 이 화상으로 괜찮습니까?
		PRINTFORML [0]네　[1]아니오
		INPUT
		SIF RESULT == 0
			CBF_IMAGE_ID '= L_PIC
	ELSE
		PRINTFORMW 이 화상으로는 설정할 수 없습니다.
	ENDIF
ENDIF

@CARDBATTLE_CARD_IMAGE_SETTING
#DIM OWN_CARD_NUM,999
#DIM OWN_CARD_C
#DIM L_COUNT
#DIM L_PAGE
#DIM L_LINE
#DIM L_M_PAGE
#DIM L_INPUT

#DIM L_1PAGE_C
#DIM L_COUNT_X
#DIM L_COUNT_Y

VARSET OWN_CARD_NUM
L_1PAGE_C = 8 * 6

OWN_CARD_C = 0
FOR L_COUNT, 0, VARSIZE("OWN_CARD", 0)
	IF OWN_CARD:L_COUNT > 0
		OWN_CARD_NUM:(OWN_CARD_C ++) = L_COUNT
	ENDIF
NEXT
L_PAGE = 0
L_M_PAGE = OWN_CARD_C / L_1PAGE_C + (OWN_CARD_C % L_1PAGE_C > 0 ? 1 # 0)

L_LINE = LINECOUNT
$INPUT_LOOP
CLEARLINE LINECOUNT - L_LINE

CALL SET_PICTURE, , , "消去"

FOR L_COUNT, L_1PAGE_C * L_PAGE, L_1PAGE_C * (L_PAGE + 1)
	SIF OWN_CARD_NUM:L_COUNT < 1
		BREAK
	CALL CARD_DATA_GET, OWN_CARD_NUM:L_COUNT
	
	LOCAL = L_COUNT % L_1PAGE_C
	
	CALL SET_PICTURE , @"No.%TOSTR(CARD_DATE_V:CBV_NO, "000")%,,,{OWN_CARD_NUM:L_COUNT}"	 , LOCAL / 8 * 8 , , LOCAL % 8 * 16
	CALL SET_PICTURE , @"%CARD_DATE_S:CBS_NAME%,,,{OWN_CARD_NUM:L_COUNT}"					 , LOCAL / 8 * 8 + 1 , , LOCAL % 8 * 16
	
	CALL SET_PICTURE , @"┏━━━━┓,,,{OWN_CARD_NUM:L_COUNT}"								 , LOCAL / 8 * 8 + 2 , , LOCAL % 8 * 16
	CALL SET_PICTURE , @"┃NONE    ┃,,,{OWN_CARD_NUM:L_COUNT}"								 , LOCAL / 8 * 8 + 3 , , LOCAL % 8 * 16
	CALL SET_PICTURE , @"┃        ┃,,,{OWN_CARD_NUM:L_COUNT}"								 , LOCAL / 8 * 8 + 4 , , LOCAL % 8 * 16
	CALL SET_PICTURE , @"┃        ┃,,,{OWN_CARD_NUM:L_COUNT}"								 , LOCAL / 8 * 8 + 5 , , LOCAL % 8 * 16
	CALL SET_PICTURE , @"┃        ┃,,,{OWN_CARD_NUM:L_COUNT}"								 , LOCAL / 8 * 8 + 6 , , LOCAL % 8 * 16
	CALL SET_PICTURE , @"┗━━━━┛,,,{OWN_CARD_NUM:L_COUNT}"								 , LOCAL / 8 * 8 + 7 , , LOCAL % 8 * 16

	IF IMAGE_LINE_COUNT(CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO)) == 4
		CALL BF_IMEGE_WINDOW, CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO), LOCAL / 8 * 8 + 3, LOCAL % 8 * 16 + 2, -1, -1, @"{OWN_CARD_NUM:L_COUNT}"
	ELSEIF IMAGE_LINE_COUNT(CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO)) == 6
		CALL BF_IMEGE_WINDOW, CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO), LOCAL / 8 * 8 + 2, LOCAL % 8 * 16    , -1, -1, @"{OWN_CARD_NUM:L_COUNT}"
	ELSE
		TRYCALL BF_IMEGE_WINDOW, CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO), -1
		SPRITECREATED CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO)
		IF RESULT
			CALL BF_IMEGE_WINDOW, CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO), LOCAL / 8 * 8 + 2, LOCAL % 8 * 16,  6, -1, @"{OWN_CARD_NUM:L_COUNT}"
			CALL SET_PICTURE , @"            ,,,{OWN_CARD_NUM:L_COUNT}"								 , LOCAL / 8 * 8 + 3 , , LOCAL % 8 * 16
			CALL SET_PICTURE , @"            ,,,{OWN_CARD_NUM:L_COUNT}"								 , LOCAL / 8 * 8 + 4 , , LOCAL % 8 * 16
			CALL SET_PICTURE , @"            ,,,{OWN_CARD_NUM:L_COUNT}"								 , LOCAL / 8 * 8 + 5 , , LOCAL % 8 * 16
			CALL SET_PICTURE , @"            ,,,{OWN_CARD_NUM:L_COUNT}"								 , LOCAL / 8 * 8 + 6 , , LOCAL % 8 * 16
			CALL SET_PICTURE , @"            ,,,{OWN_CARD_NUM:L_COUNT}"								 , LOCAL / 8 * 8 + 7 , , LOCAL % 8 * 16
		ENDIF
	ENDIF
	
	
	
	
NEXT
CALL SET_PICTURE , @"Page.{L_PAGE + 1}", 48, , 63
SIF L_PAGE > 0
	CALL SET_PICTURE , @"＜　이전 페이지,,,9001", 48, , 0
SIF L_PAGE < L_M_PAGE - 1
	CALL SET_PICTURE , @"다음 페이지　＞,,,9002", 48, , 120
CALL SET_PICTURE , @"[돌아간다],,,9999", 49, , 0
CALL SET_PICTURE, , 0, "HTML表示", 50
INPUT
L_INPUT = RESULT
IF     RESULT == 9001 && L_PAGE > 0
	L_PAGE --
ELSEIF RESULT == 9002 && L_PAGE < L_M_PAGE - 1
	L_PAGE ++
ELSEIF RESULT == 9999
	RETURN
ELSE
	CALL CARD_DATA_GET, RESULT
	IF CARD_DATE_V:CBV_NO > 0
		CALL SET_PICTURE, , , "消去"
		SUMMONER_HAND_CARDS:0:0 = CARD_DATE_V:CBV_NO
		CALL CARDDATA_WINDOW , CARD_DATE_V:CBV_NO , 0, 0
		
		CALL BF_INFORMATION_WINDOW , 2000 , 9 , 0
		IF CARD_DATE_V:CBV_KINDS < 100
			CALL CS_DEMON_SUMMON_FIELD, 0, CARD_DATE_V:CBV_NO
			CALL BF_DEMON_WINDOW , 0 , 16 , 0
			CALL SET_PICTURE, , 0, "HTML表示", 32
		ELSE
			CALL SET_PICTURE, , 0, "HTML表示", 18
		ENDIF
		
		VARSET FIELD_DEMON_DATE_V
		VARSET FIELD_DEMON_DATE_S
		VARSET FIELD_DEMON_STATE_V
		VARSET FIELD_DEMON_STATE_S
		VARSET SUMMONER_HAND_CARDS
		
		DRAWLINE
		PRINTFORML %CARD_DATE_S:CBS_NAME%의 화상을 어느 방법으로 설정하시겠습니까?
		DRAWLINE
		PRINTBUTTON @"%"[ 0]문자열로 설정",30,LEFT%", 0
		PRINTFORML 
		PRINTBUTTON @"%"[ 1]번호로 설정",30,LEFT%", 1
		PRINTFORML 
		PRINTBUTTON @"%"[ 2]直接入力",30,LEFT%", 2
		PRINTFORML 
		DRAWLINE
		PRINTBUTTON @"[99]돌아간다", 99
		INPUT
		IF RESULT == 0
			CALL NUMBER_C_IMAGE_SETTING, CARD_DATE_V:CBV_NO, 0
		ELSEIF RESULT == 1
			CALL NUMBER_C_IMAGE_SETTING, CARD_DATE_V:CBV_NO, 1
		ELSEIF RESULT == 2
			CALL DIRECT_C_IMAGE_SETTING, CARD_DATE_V:CBV_NO
		ENDIF
	ENDIF
ENDIF
GOTO INPUT_LOOP

@DIRECT_C_IMAGE_SETTING, ARG
#DIM L_LINE
#DIM L_SPC
#DIMS L_INPUTS
CALL CARD_DATA_GET, ARG
L_LINE = LINECOUNT
$INPUT_LOOP
CLEARLINE LINECOUNT - L_LINE
PRINTFORML %CARD_DATE_S:CBS_NAME%에 사용할 화상 이름을 입력해 주세요.
PRINTL ※4행 또는 6행의 정사각형 화상을 설정해 주세요.
INPUTS
L_INPUTS = %RESULTS%
LOCAL = IMAGE_LINE_COUNT(L_INPUTS)
TRYCALL CS_PORTRATE_SCRIPT, L_INPUTS
SPRITECREATED L_INPUTS
L_SPC = RESULT
IF LOCAL == 4 || LOCAL == 6 || L_SPC
	IF L_SPC
		HTML_PRINT "<img src = '" + L_INPUTS + "' height = '600' width = '600'>"
		PRINTFORML \n\n\n\n\n
	ELSE
		FOR LOCAL:1, 1, LOCAL + 1
			PRINT_IMG L_INPUTS + "_" + @"{LOCAL:1}"
			PRINTFORML ║
		NEXT
		PRINTFORML %"　" * LOCAL%║
		PRINTFORML ※우측 선이 위에서 아래까지 끊어지지 않았다면 OK입니다.
	ENDIF
	PRINTFORML %L_INPUTS%
	PRINTFORML 이 화상으로 괜찮습니까?
	PRINTFORML [0]네　[1]아니오
	INPUT
	IF RESULT == 0
		CARD_IMAGE_ID:(CARD_DATE_V:CBV_NO) '= L_INPUTS
		RETURN
	ENDIF
ELSEIF L_INPUTS == ""
	RETURN
ELSE
	PRINTFORMW 이 화상으로는 설정할 수 없습니다.
ENDIF
GOTO INPUT_LOOP

@NUMBER_C_IMAGE_SETTING, ARG, ARG:1
#DIM L_LINE
#DIM L_COUNT
#DIM L_INPUT
#DIMS L_INPUTS
#DIMS L_IMAGES, VARSIZE("OWN_CARD", 0)
VARSET L_IMAGES
CALL CARD_DATA_GET, ARG

IF ARG:1 == 0
	PRINTFORML %CARD_DATE_S:CBS_NAME%에 사용할 화상의 문자열을 입력해 주세요.
	PRINTFORML ※미입력 시 자동으로 「%CARD_DATE_S:CBS_NAME%」로 출력합니다.
	INPUTS
	L_INPUTS = %RESULTS%
	SIF L_INPUTS == ""
		L_INPUTS = %CARD_DATE_S:CBS_NAME%
	CALL PORTRATE_ID_GET_S, L_INPUTS
	L_INPUT = RESULT
	LOCAL = 0
	FOR L_COUNT, 0 ,L_INPUT
		L_IMAGES:(LOCAL ++) = %RESULTS:L_COUNT%
	NEXT

ELSEIF ARG:1 == 1
	PRINTFORML %CARD_DATE_S:CBS_NAME%에 사용할 화상 번호를 입력해 주세요.
	PRINTL ※「-1」을 입력하면 이름으로부터 자동으로 번호를 출력합니다.
	INPUT
	L_INPUT = RESULT
	IF L_INPUT == -1
		L_INPUT = GET_識別番号(CARD_DATE_S:CBS_NAME)
		;FOR L_COUNT, 0, 9999
		;	IF EXISTCSV(L_COUNT, 0) != 0
		;		IF CSVNAME(L_COUNT, 0) == CARD_DATE_S:CBS_NAME
		;			L_INPUT = L_COUNT
		;			BREAK
		;		ELSEIF CSVCALLNAME(L_COUNT, 0) == CARD_DATE_S:CBS_NAME
		;			L_INPUT = L_COUNT
		;			BREAK
		;		ENDIF
		;	ENDIF
		;NEXT
	ENDIF
	LOCAL = 0
	CALL PORTRATE_ID_GET_V, L_INPUT
	IF RESULT > 0
		LOCAL:1 = RESULT
		FOR L_COUNT, 0 ,LOCAL:1
			L_IMAGES:(LOCAL ++) = %RESULTS:L_COUNT%
		NEXT
	ENDIF
	FOR L_COUNT, 0 ,64
		LOCALS = A{L_INPUT}_{L_COUNT * 100 + 1}
		LOCAL:1 = IMAGE_LINE_COUNT(LOCALS)
		IF LOCAL:1 == 4 || LOCAL:1 == 6
			;PRINTFORML %LOCALS%
			L_IMAGES:(LOCAL ++) = %LOCALS%
		ENDIF
	NEXT
	FOR L_COUNT, 0 ,64
		LOCALS = A{L_INPUT}_{L_COUNT * 100}
		LOCAL:1 = IMAGE_LINE_COUNT(LOCALS)
		IF LOCAL:1 == 4 || LOCAL:1 == 6
			;PRINTFORML %LOCALS%
			L_IMAGES:(LOCAL ++) = %LOCALS%
		ENDIF
	NEXT
ENDIF

IF LOCAL > 0
	L_LINE = LINECOUNT
	$INPUT_LOOP
	CLEARLINE LINECOUNT - L_LINE
	PRINTFORML %CARD_DATE_S:CBS_NAME%에 사용할 화상을 선택해 주세요.
	
	
	CALL SET_PICTURE, , , "消去"
	FOR L_COUNT, 0, LOCAL
		CALL SET_PICTURE , @"[{L_COUNT}],,,{L_COUNT}"	 ,0 , , L_COUNT % 10 * 13
		LOCALS = %L_IMAGES:L_COUNT%
		;PRINTFORML %LOCALS%
		IF IMAGE_LINE_COUNT(LOCALS) == 4
			CALL SET_PICTURE , @"┏━━━━┓,,,{L_COUNT}"	 ,1 , , L_COUNT % 10 * 13
			CALL SET_PICTURE , @"┃NONE    ┃,,,{L_COUNT}"	 ,2 , , L_COUNT % 10 * 13
			CALL SET_PICTURE , @"┃        ┃,,,{L_COUNT}"	 ,3 , , L_COUNT % 10 * 13
			CALL SET_PICTURE , @"┃        ┃,,,{L_COUNT}"	 ,4 , , L_COUNT % 10 * 13
			CALL SET_PICTURE , @"┃        ┃,,,{L_COUNT}"	 ,5 , , L_COUNT % 10 * 13
			CALL SET_PICTURE , @"┗━━━━┛,,,{L_COUNT}"	 ,6 , , L_COUNT % 10 * 13
			CALL BF_IMEGE_WINDOW, LOCALS, 2, L_COUNT % 10 * 13 + 2, -1, -1, @"{L_COUNT}"
		ELSEIF IMAGE_LINE_COUNT(LOCALS) == 6
			CALL BF_IMEGE_WINDOW, LOCALS, 1, L_COUNT % 10 * 13    , -1, -1, @"{L_COUNT}"
		ELSE
			CALL BF_IMEGE_WINDOW, LOCALS, 1, L_COUNT % 10 * 13    ,  6, -1, @"{L_COUNT}"
			CALL SET_PICTURE , @"            ,,,{L_COUNT}"	 ,2 , , L_COUNT % 10 * 13
			CALL SET_PICTURE , @"            ,,,{L_COUNT}"	 ,3 , , L_COUNT % 10 * 13
			CALL SET_PICTURE , @"            ,,,{L_COUNT}"	 ,4 , , L_COUNT % 10 * 13
			CALL SET_PICTURE , @"            ,,,{L_COUNT}"	 ,5 , , L_COUNT % 10 * 13
			CALL SET_PICTURE , @"    분할 없음,,,{L_COUNT}"	 ,6 , , L_COUNT % 10 * 13
		ENDIF
		IF L_COUNT % 10 == 9
			CALL SET_PICTURE, , 0, "HTML表示", 8
			CALL SET_PICTURE, , , "消去"
		ENDIF
	NEXT
	CALL SET_PICTURE , @"[돌아간다],,,9999"	 ,7 , , 0
	CALL SET_PICTURE, , 0, "HTML表示", 9
	
	INPUT
	IF RESULT == 9999
		RETURN
	ELSEIF 0 <= RESULT && RESULT < LOCAL
		L_INPUT = RESULT
		CALL SET_PICTURE, , , "消去"
		CALL SET_PICTURE , @"            "	 ,1 , , 0
		CALL SET_PICTURE , @"            "	 ,2 , , 0
		CALL SET_PICTURE , @"            "	 ,3 , , 0
		CALL SET_PICTURE , @"            "	 ,4 , , 0
		CALL SET_PICTURE , @"            "	 ,5 , , 0
		IF IMAGE_LINE_COUNT(LOCALS) >= 4
			CALL BF_IMEGE_WINDOW, L_IMAGES:L_INPUT, 0, 0
		ELSE
			CALL BF_IMEGE_WINDOW, L_IMAGES:L_INPUT, 0, 0, 6
		ENDIF
		CALL SET_PICTURE, , 0, "HTML表示", 9
		PRINTFORML 이 화상으로 괜찮습니까?
		PRINTFORML [0]네　[1]아니오
		INPUT
		IF RESULT == 0
			CARD_IMAGE_ID:ARG '= L_IMAGES:L_INPUT
			RETURN
		ENDIF
	ENDIF
	GOTO INPUT_LOOP
ELSE
	PRINTFORMW 이 번호로는 설정할 수 없습니다.
ENDIF

;@CS_PORTRATE_SELECT,
@PORTRATE_ID_GET_V, L_NUM, L_MAX_V = -1
#DIM L_NUM
#DIMS L_NAME
#DIM L_MAX_V
VARSET RESULTS
LOCAL = 0

L_NAME = %GET_識別名(L_NUM)%

IF L_NAME != ""
	CALL PORTRATE_ID_GET_S, L_NAME, L_MAX_V
	RETURN RESULT
ELSE
	RETURN 0
ENDIF

@PORTRATE_ID_GET_S, L_NAME, L_MAX_V = -1
#DIMS L_NAME
#DIMS L_TYPE = "", "_UNIQUE", "_TS"
#DIM L_MAX_V
#DIM L_COUNT_N
#DIM L_COUNT_T
VARSET RESULTS
LOCAL = 0

CALL 顔グラ追加CS, L_NAME
FOR L_COUNT_T, 0, VARSIZE("L_TYPE", 0)
	FOR L_COUNT_N, 0, 20
		LOCALS '= L_NAME + "_FACE" + L_TYPE:L_COUNT_T + @"_{L_COUNT_N}"
		LOCALS '= HTML_ESCAPE(LOCALS)
		;HTML_PRINT "<img src = '" + LOCALS + "' height = '600' width = '600'>"

		;PRINTFORML %LOCALS%
		;SPRITECREATED LOCALS
		IF SPRITECREATED(LOCALS)
			RESULTS:(LOCAL ++) '= LOCALS
			;PRINTFORML OK
		ELSE
			;PRINTFORML NG
		ENDIF
		
		SIF L_MAX_V > -1 && LOCAL >= L_MAX_V
			BREAK
	NEXT
	SIF L_MAX_V > -1 && LOCAL >= L_MAX_V
		BREAK
NEXT
RETURN LOCAL

