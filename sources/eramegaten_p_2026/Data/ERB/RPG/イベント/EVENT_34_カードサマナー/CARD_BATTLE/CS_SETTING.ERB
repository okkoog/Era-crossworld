#DIMS L_NAME
#DIM IS_SIMPLE
#DIM cNUM
#DIM L_COUNT
VARSET cNUM, -1
cNUM = GET_識別番号(L_NAME)
IF cNUM >= 0
	TRYCALLFORM 顔グラ追加, cNUM
ENDIF