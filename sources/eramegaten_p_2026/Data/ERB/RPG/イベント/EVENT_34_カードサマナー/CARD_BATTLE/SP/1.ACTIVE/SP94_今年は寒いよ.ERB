;지오/2/3/
;特技名
@CGSP_NAME_94, ARGS, ARG
RESULTS = 今年は寒いよ

;　コストの量
@CGSP_COST_94, ARGS, ARG
RETURN 0


;　타겟(選択するかしないか)
@CGSP_TARGET_94, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_94, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_94, ARGS, ARG, ARG:1
#DIM L_HOST
L_HOST = FIELD_DEMON_DATE_V:ARG:CBV_HOST

IF L_HOST == CS1_ONESELF
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
	LOCAL:3 = CBF_ALLY_POS1
	LOCAL:4 = CBF_ALLY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
	LOCAL:3 = CBF_ENEMY_POS1
	LOCAL:4 = CBF_ENEMY_POS6 + 1
ENDIF
FOR LOCAL, LOCAL:1, LOCAL:2
	CALL SP_DAMAGE, LOCAL, 4, ARG
NEXT

FOR LOCAL, LOCAL:3, LOCAL:4
	SIF ARG == LOCAL
		CONTINUE
	IF STRFIND(FIELD_DEMON_DATE_S:LOCAL:CBS_NAME, "フロスト") >= 0 && FIELD_DEMON_DATE_V:LOCAL:CBV_NO > 0
		CALL CS_STOCK_MAG_D_GET(L_HOST, 10)
		BREAK
	ENDIF
NEXT
;


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_94, ARGS, ARG, ARG:1
RETURN 3
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_94, ARGS, ARG
RESULTS = 敵仲魔全体に４Ｐのダメージを与え、自身の場に自分を除く味方の名前に「フロスト」が付く仲魔がいる場合、自身のサマナーのストックMAGを+10する。このＳＰを使った仲魔は黄泉に葬られる。


;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　1(アギとかのダメージ魔法系は1),ダメージ,範囲1体は1、全体は2
@CGSP_TYPE_94, ARGS, ARG
RETURN 1, 4, 2

