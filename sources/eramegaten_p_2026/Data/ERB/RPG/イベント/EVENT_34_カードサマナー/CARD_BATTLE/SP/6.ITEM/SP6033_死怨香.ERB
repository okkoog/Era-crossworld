@CGSP_ACTION_6033, ARGS, ARG, ARG:1

FOR LOCAL, CBF_ALLY_POS1, CBF_ENEMY_POS6 + 1
	CALL CS_DICEROLL_STATE(999, ARG, LOCAL, 995, 1)
NEXT


