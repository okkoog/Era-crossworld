;지오/2/3/
;特技名
@CGSP_NAME_42, ARGS, ARG
RESULTS = 부하악마의행군

;　コストの量
@CGSP_COST_42, ARGS, ARG
RETURN 5


;　타겟(選択するかしないか)
@CGSP_TARGET_42, ARGS, ARG
RETURN 3
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_42, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_42, ARGS, ARG, ARG:1
#DIM L_D

IF FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_ONESELF
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ENDIF
L_D = 1
FOR LOCAL, LOCAL:1, LOCAL:2
		SIF FIELD_DEMON_DATE_V:LOCAL:CBV_NO == 0 || GETBIT(FIELD_DEMON_DATE_V:LOCAL:CBV_CONDITION, 2)
			CONTINUE
        L_D ++ 
NEXT
CALL SP_DAMAGE, ARG:1, L_D, ARG
;


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_42, ARGS, ARG, ARG:1
RETURN 1
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_42, ARGS, ARG
RESULTS = 敵仲魔１体に(1+カード状態ではない味方数)Ｐのダメージを与える。このＳＰを使った仲魔はフリーズする。『味方が多いほどダメージが上がるが、召喚したての仲魔だと効果がない』


;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　1(アギとかのダメージ魔法系は1),ダメージ,範囲1体は1、全体は2
@CGSP_TYPE_42, ARGS, ARG
#DIM L_D

IF FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_ONESELF
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ENDIF
L_D = 1
FOR LOCAL, LOCAL:1, LOCAL:2
	SIF FIELD_DEMON_DATE_V:LOCAL:CBV_NO == 0 || GETBIT(FIELD_DEMON_DATE_V:LOCAL:CBV_CONDITION, 2)
		CONTINUE
	L_D ++ 
NEXT
;RESULTS = 味方存在数+1
RETURN 1, L_D, 1

