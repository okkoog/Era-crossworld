                IF MAX(LOCAL:10, LOCAL:11) < 10
                    LOCAL:22 = 0
                ;必ずブロックできる
                ELSEIF MIN(LOCAL:10, LOCAL:11) >= 10
                    LOCAL:22 = 3
                ;スキル使用すればブロック可
