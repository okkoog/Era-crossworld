	    CS_AI_STEP = 50
    SIF ARG == 1 || ARG == 2
        PRINTFORMW 블록 여기까지
    
    REDRAW 1
	RETURN 0

ENDIF
;0  SPブロマS   SPブロマ即死100 防御PUスキル    ブロマ召喚
;1              SPブロマ即死99
;2　アタクマS   アタクマ即死100                 アタクマ召喚
;3              アタクマ即死99                                  ブロックサポSP
;5                              攻撃PUスキル                    アタックサポSP  
;6                              最強、SP召喚
;7                              低コスト召喚
;5              雑魚散らしD
;8                              攻撃宣言
FOR L_C_ACTION, 0, 9
    ;----------
    ;味方の排除
    ;----------
    ;IF CS_AI_STEP == 10
    CS_AI_ACTNUM = 1000 * L_C_ACTION
    IF 1
        VARSET TARGET_INFO, -1
        FOR L_COUNT_P, CBF_ALLY_POS1, CBF_ALLY_POS6 + 1
            TARGET_INFO:L_COUNT_P:0 = L_COUNT_P
            SIF FIELD_DEMON_DATE_V:L_COUNT_P:CBV_NO == 0
                CONTINUE
            TARGET_INFO:L_COUNT_P:1 = 0
            ;ブロックマークはあるか？
            ;PRINTFORML %FIELD_DEMON_DATE_S:L_COUNT_P:CBS_NAME,16%  {UNIT_INFO_P:L_COUNT_P:4}
            IF UNIT_INFO_P:L_COUNT_P:4 > 0 && L_C_ACTION < 2
                TARGET_INFO:L_COUNT_P:1 += UNIT_INFO_P:L_COUNT_P:4 * 30
            ELSEIF UNIT_INFO_P:L_COUNT_P:3 > 0 && L_C_ACTION < 4
            ;アタックマークの状況
                ;LOCAL = UNIT_INFO_P:L_COUNT_P:3
                ;LOCAL:1 = 0
                ;LOCAL:1 -= (LOCAL % 100) * 2
                ;LOCAL /= 100
                ;LOCAL:1 -= LOCAL % 100
                ;LOCAL /= 100
                ;LOCAL:1 += LOCAL % 100
                ;LOCAL /= 100
                ;LOCAL:1 += LOCAL % 100
                ;IF LOCAL:1 > 0
                ;    TARGET_INFO:L_COUNT_P:1 += UNIT_INFO_P:L_COUNT_P:3 * 5
                ;ENDIF
                TARGET_INFO:L_COUNT_P:1 += UNIT_INFO_P:L_COUNT_P:3 * 100
            ENDIF
        NEXT

        IF L_C_ACTION < 2
            ;SPの状況
            FOR L_COUNT, 0, VARSIZE("SP_INFO_V_P",0)
                L_COUNT_P = SP_INFO_V_P:L_COUNT:0
                IF SP_INFO_V_P:L_COUNT:1 == 1
                    TARGET_INFO:L_COUNT_P:1 += 50
                    SIF SP_INFO_V_P:L_COUNT:3 == 2
                        TARGET_INFO:L_COUNT_P:1 += 200
                    SIF SP_INFO_V_P:L_COUNT:12 == 0
                        TARGET_INFO:L_COUNT_P:1 += 100
                    FOR L_C_NUM, 14, 20
                        TARGET_INFO:L_COUNT_P:1 += SP_INFO_V_P:L_COUNT:L_C_NUM * 10
                    NEXT
                ELSEIF SP_INFO_V_P:L_COUNT:1 == 12 && (SP_INFO_V_P:L_COUNT:2 == 998 || SP_INFO_V_P:L_COUNT:2 == 997)
                    TARGET_INFO:L_COUNT_P:1 += 180
                    FOR L_C_NUM, 14, 20
                        TARGET_INFO:L_COUNT_P:1 += SP_INFO_V_P:L_COUNT:L_C_NUM * 10
                    NEXT
                ENDIF
            NEXT
        ENDIF

        VARSET L_SORT
        L_SORT:0 = 10000 - TARGET_INFO:0:1
        L_SORT:1 = 10000 - TARGET_INFO:1:1
        L_SORT:2 = 10000 - TARGET_INFO:2:1
        L_SORT:3 = 10000 - TARGET_INFO:3:1
        L_SORT:4 = 10000 - TARGET_INFO:4:1
        L_SORT:5 = 10000 - TARGET_INFO:5:1

        ARRAYMSORT L_SORT, TARGET_INFO

        IF L_C_ACTION < 2
            PRINTL ブロマタゲ
        ELSEIF L_C_ACTION < 4
            PRINTL アタクマタゲ
        ENDIF
        FOR L_COUNT_P, CBF_ALLY_POS1, CBF_ALLY_POS6 + 1
            PRINTFORML %FIELD_DEMON_DATE_S:(TARGET_INFO:L_COUNT_P:0):CBS_NAME,16%  {TARGET_INFO:L_COUNT_P:1}
        NEXT

        ;----------
        ;ダメージSPによる排除（100％だけにしておく）
        ;----------
        IF (L_C_ACTION == 0 || L_C_ACTION == 2)
            IF L_C_ACTION < 2
                PRINTL ブロマ排除
            ELSEIF L_C_ACTION < 4
                PRINTL アタクマ排除
            ENDIF
            FOR L_COUNT, 0, VARSIZE("TARGET_INFO",0)
                SIF TARGET_INFO:L_COUNT:1 < 10
                    CONTINUE
                L_COUNT_P = TARGET_INFO:L_COUNT:0
                
                VARSET USE_SP_INFO
                LOCAL = 0
                FOR L_C_NUM, 0, VARSIZE("SP_INFO_V_E",0)
                    IF SP_INFO_V_E:L_C_NUM:1 == 1
                        SIF SP_INFO_V_E:L_C_NUM:(14 + L_COUNT_P) < 1
                            CONTINUE
                        IF SP_INFO_V_E:L_C_NUM:0 >= 100 && TARGET_INFO:L_COUNT:1 > 0
                            USE_SP_INFO:LOCAL:0 = L_C_NUM
                            USE_SP_INFO:LOCAL:1 = 10 + (SP_INFO_V_E:L_C_NUM:13 * 10)
                            LOCAL ++
                        ELSEIF SP_INFO_V_E:L_C_NUM:0 < 100
                            L_COUNT_E = SP_INFO_V_E:L_C_NUM:0 - 6
                            ;代償
                            IF SP_INFO_V_E:L_C_NUM:12 == 0
                                ;アンタップ
                                USE_SP_INFO:LOCAL:0 = L_C_NUM
                                USE_SP_INFO:LOCAL:1 = 0
                                LOCAL ++
                            ELSEIF SP_INFO_V_E:L_C_NUM:12 == 1 && TARGET_INFO:L_COUNT:1 > 0
                                ;タップ
                                LOCAL:1 = 0
                                IF UNIT_INFO_E:L_COUNT_E:4 % 1048576 > 0
                                    ;ブロック候補で、相手にブロックマークはあるか？
                                    IF UNIT_INFO_P:L_COUNT_P:4 > 0
                                        LOCAL:1 = 1
                                    ;ブロック候補で、替りはいるか？
                                    ELSE
                                        LOCAL:2 = UNIT_INFO_E:L_COUNT_E:4 / 1048576
                                        FOR L_C_FOR, 0 ,6
                                            SIF L_COUNT_E == L_C_FOR
                                                CONTINUE
                                            LOCAL:3 = LOCAL:2 & (UNIT_INFO_E:L_C_FOR:4 / 1048576)
                                            IF LOCAL:2 == LOCAL:3
                                                LOCAL:1 = 1
                                                BREAK
                                            ENDIF
                                        NEXT
                                    ENDIF
                                ELSEIF UNIT_INFO_E:L_COUNT_E:4 <= 300
                                    ;アタック候補で、300未満？
                                    LOCAL:1 = 1
                                ENDIF
                                IF LOCAL:1 == 1
                                    USE_SP_INFO:LOCAL:0 = L_C_NUM
                                    USE_SP_INFO:LOCAL:1 = UNIT_INFO_E:L_COUNT_E:11 / 10 + 1
                                    LOCAL ++
                                ENDIF
                            ELSEIF (SP_INFO_V_E:L_C_NUM:12 == 2 || SP_INFO_V_E:L_C_NUM:12 == 3)  && TARGET_INFO:L_COUNT:1 > 0
                                ;山札、黄泉
                                ;相手よりバトル力は低いか同等？
                                IF UNIT_INFO_P:L_COUNT_P:11 >= UNIT_INFO_E:L_COUNT_E:11 - 3
                                    ;ブロック候補で、相手にブロックマークはあるか？
                                    ;アタック候補で、300未満？
                                    IF (UNIT_INFO_E:L_COUNT_E:4 % 1048576 > 0 && UNIT_INFO_P:L_COUNT_P:4 > 0) || UNIT_INFO_E:L_COUNT_E:4 <= 300
                                        USE_SP_INFO:LOCAL:0 = L_C_NUM
                                        USE_SP_INFO:LOCAL:1 = UNIT_INFO_E:L_COUNT_E:11 + 5
                                        LOCAL ++
                                    ENDIF
                                ENDIF
                            ENDIF
                        ENDIF
                    ENDIF
                NEXT
                LOCAL:30 = 0 ;SP除け位置
                IF LOCAL > 0
                    PRINTFORML
                    PRINTFORML SP 받음 %FIELD_DEMON_DATE_S:L_COUNT_P:CBS_NAME,16%　現MAG {L_USING_MAG}
                    FOR L_C_NUM, 0, LOCAL
                        PRINTFORML %SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):9,16% {USE_SP_INFO:L_C_NUM:0} {USE_SP_INFO:L_C_NUM:1}
                    NEXT
                    LOCAL:1 =  1 << LOCAL

                    $DSP_CONTINUE
                    ;LOCAL:20 = 0 ;採用組み合わせ
                    ;LOCAL:21 = 0 ;総合代償
                    ;LOCAL:22 = 0 ;手札使用位置
                    VARSET USING_SP_DATA, 0
                    FOR L_C_NUM , 1, LOCAL:1
                        LOCAL:10 = 0 ;ダメージ
                        LOCAL:11 = 0 ;代償
                        LOCAL:12 = 0 ;SP人数
                        LOCAL:13 = 0 ;使用コスト
                        LOCAL:18 = 0 ;手札使用位置
                        LOCAL:19 = -1 ;SP番号
                        FOR L_C_FOR, 0, LOCAL
                            IF GETBIT(L_C_NUM, L_C_FOR)
                                SIF GETBIT(LOCAL:30, L_C_FOR) 
                                    CONTINUE
                                LOCAL:10 += SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):(14 + L_COUNT_P)
                                LOCAL:11 += USE_SP_INFO:L_C_FOR:1
                                LOCAL:12 ++
                                LOCAL:13 += SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):10
                                SIF SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):0 == LOCAL:19 && SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):0 > -1
                                    CONTINUE
                                SIF SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):0 >= 100
                                    SETBIT LOCAL:18, SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):0 - 100
                                LOCAL:19 = SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):0
                            ENDIF
                            LOCAL:11 = LOCAL:11 * 1000 + LOCAL:12 * 100 + LOCAL:13
                            {
                            IF FIELD_DEMON_DATE_V:L_COUNT_P:CBV_HP <= LOCAL:10 && (USING_SP_DATA:0:1 < 1 || LOCAL:11 < USING_SP_DATA:0:1) 
                            && L_USING_MAG >= LOCAL:13
                            }
                                USING_SP_DATA:0:0 = L_C_NUM
                                USING_SP_DATA:0:1 = LOCAL:11
                                USING_SP_DATA:0:2 = LOCAL:18
                            ENDIF
                        NEXT
                    NEXT
                    IF USING_SP_DATA:0:0 != 0
                        FOR L_C_NUM , 0, LOCAL
                            IF GETBIT(USING_SP_DATA:0:0, L_C_NUM)
                                IF SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):0 < 100
                                    SIF ARG == 0 || ARG == 1
                                        CALL CB_AI_SET, 1500 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):0
                                    PRINTFORML {1500 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):0}
                                ELSE
                                    SIF ARG == 0 || ARG == 1
                                        CALL CB_AI_SET, 10000 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):9
                                    PRINTFORML {10000 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):9}
                                    IF SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):13 > 0
                                        CALL CB_OFFERING_POSGET, HAND_INFO_V_E, SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):13, USING_SP_DATA:0:2, SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):0
                                        IF RESULT != 0
                                            L_OFFERING_RES = RESULT
                                            FOR L_C_FOR , 0, HAND_CARDS(CS1_OPPONENT)
                                                IF GETBIT(L_OFFERING_RES, L_C_FOR)
                                                    IF HAND_INFO_V_E:L_C_FOR:0 >= 100
                                                        SIF ARG == 0 || ARG == 1
                                                            CALL CB_AI_SET, 20000 + HAND_INFO_V_E:L_C_FOR:9
                                                        PRINTFORML {20000 + HAND_INFO_V_E:L_C_FOR:9}
                                                    ELSE
                                                        SIF ARG == 0 || ARG == 1
                                                            CALL CB_AI_SET, 20000 + HAND_INFO_V_E:L_C_FOR:12
                                                        PRINTFORML {20000 + HAND_INFO_V_E:L_C_FOR:12}
                                                    ENDIF
                                                ENDIF
                                            NEXT
                                            PRINTFORML {999}
                                            SIF ARG == 0 || ARG == 1
                                                CALL CB_AI_SET, 999
                                        ELSE
                                            SETBIT LOCAL:30, L_C_NUM
                                            GOTO DSP_CONTINUE
                                        ENDIF
                                    ENDIF
                                ENDIF
                                IF SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):3 == 1
                                    PRINTFORML {100 + L_COUNT_P}
                                    SIF ARG == 0 || ARG == 1
                                        CALL CB_AI_SET, 100 + L_COUNT_P
                                ENDIF
                            ENDIF
                        NEXT
                        PRINTFORML OK
                        PRINTFORML
                        SIF ARG == 0 || ARG == 1
                            GOTO AI_SET_OK
                    ENDIF

                ENDIF
            NEXT
        ENDIF
        ;----------
        ;即死による排除
        ;----------
        CS_AI_ACTNUM ++
        IF (L_C_ACTION < 4)
            IF L_C_ACTION == 0
                PRINTL ブロマ即死100
            ELSEIF L_C_ACTION == 1
                PRINTL ブロマ即死99
            ELSEIF L_C_ACTION == 2
                PRINTL アタクマ即死100
            ELSEIF L_C_ACTION == 3
                PRINTL アタクマ即死99
            ENDIF
            FOR L_COUNT, 0, VARSIZE("TARGET_INFO",0)
                SIF TARGET_INFO:L_COUNT:1 < 10
                    CONTINUE
                L_COUNT_P = TARGET_INFO:L_COUNT:0
                
                VARSET USE_SP_INFO
                LOCAL = 0
                FOR L_C_NUM, 0, VARSIZE("SP_INFO_V_E",0)
                    IF SP_INFO_V_E:L_C_NUM:1 == 12 && (SP_INFO_V_E:L_C_NUM:2 == 998 || SP_INFO_V_E:L_C_NUM:2 == 997)
                        SIF SP_INFO_V_E:L_C_NUM:(14 + L_COUNT_P) < 1
                            CONTINUE
                        SIF SP_INFO_V_E:L_C_NUM:(14 + L_COUNT_P) < 6 && (L_C_ACTION == 0 || L_C_ACTION == 2)
                            CONTINUE
                        IF SP_INFO_V_E:L_C_NUM:0 >= 100 && TARGET_INFO:L_COUNT:1 > 0
                            USE_SP_INFO:LOCAL:0 = L_C_NUM
                            USE_SP_INFO:LOCAL:1 = 10 + (SP_INFO_V_E:L_C_NUM:13 * 10)
                            LOCAL ++
                        ELSEIF SP_INFO_V_E:L_C_NUM:0 < 100
                            L_COUNT_E = SP_INFO_V_E:L_C_NUM:0 - 6
                            ;代償
                            IF SP_INFO_V_E:L_C_NUM:12 == 0
                                ;アンタップ
                                USE_SP_INFO:LOCAL:0 = L_C_NUM
                                USE_SP_INFO:LOCAL:1 = 0
                                LOCAL ++
                            ELSEIF SP_INFO_V_E:L_C_NUM:12 == 1 && TARGET_INFO:L_COUNT:1 > 0
                                ;タップ
                                LOCAL:1 = 0
                                IF UNIT_INFO_E:L_COUNT_E:4 % 1048576 > 0
                                    ;ブロック候補で、相手にブロックマークはあるか？
                                    IF UNIT_INFO_P:L_COUNT_P:4 > 0
                                        LOCAL:1 = 1
                                    ;ブロック候補で、替りはいるか？
                                    ELSE
                                        LOCAL:2 = UNIT_INFO_E:L_COUNT_E:4 / 1048576
                                        FOR L_C_FOR, 0 ,6
                                            SIF L_COUNT_E == L_C_FOR
                                                CONTINUE
                                            LOCAL:3 = LOCAL:2 & (UNIT_INFO_E:L_C_FOR:4 / 1048576)
                                            IF LOCAL:2 == LOCAL:3
                                                LOCAL:1 = 1
                                                BREAK
                                            ENDIF
                                        NEXT
                                    ENDIF
                                ELSEIF UNIT_INFO_E:L_COUNT_E:4 <= 300
                                    ;アタック候補で、300未満？
                                    LOCAL:1 = 1
                                ENDIF
                                SIF SP_INFO_V_E:L_C_NUM:(14 + L_COUNT_P) < 6 && TARGET_INFO:L_COUNT:1 < 100
                                    CONTINUE
                                IF LOCAL:1 == 1
                                    USE_SP_INFO:LOCAL:0 = L_C_NUM
                                    USE_SP_INFO:LOCAL:1 = UNIT_INFO_E:L_COUNT_E:11 / 10 + 1
                                    LOCAL ++
                                ENDIF
                            ELSEIF (SP_INFO_V_E:L_C_NUM:12 == 2 || SP_INFO_V_E:L_C_NUM:12 == 3)  && TARGET_INFO:L_COUNT:1 > 0
                                ;山札、黄泉
                                ;相手よりバトル力は低いか同等？
                                SIF SP_INFO_V_E:L_C_NUM:(14 + L_COUNT_P) < 6 && TARGET_INFO:L_COUNT:1 < 100
                                    CONTINUE
                                IF UNIT_INFO_P:L_COUNT_P:11 >= UNIT_INFO_E:L_COUNT_E:11 - 3
                                    ;ブロック候補で、相手にブロックマークはあるか？
                                    ;アタック候補で、300未満？
                                    IF (UNIT_INFO_E:L_COUNT_E:4 % 1048576 > 0 && UNIT_INFO_P:L_COUNT_P:4 > 0) || UNIT_INFO_E:L_COUNT_E:4 <= 300
                                        USE_SP_INFO:LOCAL:0 = L_C_NUM
                                        USE_SP_INFO:LOCAL:1 = UNIT_INFO_E:L_COUNT_E:11 + 5
                                        LOCAL ++
                                    ENDIF
                                ENDIF
                            ENDIF
                        ENDIF
                    ENDIF
                NEXT
                LOCAL:30 = 0 ;SP除け位置
                IF LOCAL > 0
                    PRINTFORML
                    PRINTFORML SP 받음 %FIELD_DEMON_DATE_S:L_COUNT_P:CBS_NAME,16%
                    FOR L_C_NUM, 0, LOCAL
                        PRINTFORML %SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):9,16% {USE_SP_INFO:L_C_NUM:1}
                    NEXT
                    LOCAL:1 =  1 << LOCAL

                    $DETSP_CONTINUE
                    LOCAL:20 = -1 ;採用組み合わせ
                    LOCAL:21 = 0 ;総合代償
                    LOCAL:22 = 0 ;手札使用位置

                    FOR L_C_FOR, 0, LOCAL
                        LOCAL:10 = 0 ;ダメージ
                        LOCAL:11 = 0 ;代償
                        LOCAL:12 = 0 ;SP人数
                        LOCAL:13 = 0 ;使用コスト
                        LOCAL:18 = 0 ;手札使用位置
                        LOCAL:19 = -1 ;SP番号
                        SIF GETBIT(LOCAL:30, L_C_FOR) 
                            CONTINUE
                        ;LOCAL:10 += SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):(14 + L_COUNT_P)
                        LOCAL:11 += USE_SP_INFO:L_C_FOR:1
                        ;LOCAL:12 ++
                        LOCAL:13 += SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):10
                        SIF SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):0 == LOCAL:19 && SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):0 > -1
                            CONTINUE
                        SIF SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):0 >= 100
                            SETBIT LOCAL:18, SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):0 - 100
                        LOCAL:19 = SP_INFO_V_E:(USE_SP_INFO:L_C_FOR:0):0

                        ; + LOCAL:12 * 100
                        LOCAL:11 = LOCAL:11 * 1000 + LOCAL:13
                        ;PRINTFORMW {LOCAL:11}
                        {
                        IF (LOCAL:21 < 1 || LOCAL:11 < LOCAL:21)
                        && L_USING_MAG >= LOCAL:13
                        }
                            LOCAL:20 = L_C_FOR
                            LOCAL:21 = LOCAL:11
                            LOCAL:22 = LOCAL:18
                        ENDIF
                    NEXT
                    ;PRINTFORMW {LOCAL:20}

                    IF LOCAL:20 > -1
                        L_C_NUM = LOCAL:20
                        
                        IF SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):0 < 100
                            SIF ARG == 0 || ARG == 1
                                CALL CB_AI_SET, 1500 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):0
                            PRINTFORML {1500 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):0}
                        ELSE
                            SIF ARG == 0 || ARG == 1
                                CALL CB_AI_SET, 10000 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):9
                            PRINTFORML {10000 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):9}
                            IF SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):13 > 0
                                CALL CB_OFFERING_POSGET, HAND_INFO_V_E, SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):13, LOCAL:22, SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):0
                                IF RESULT != 0
                                    L_OFFERING_RES = RESULT
                                    FOR L_C_FOR , 0, LOCAL
                                        IF GETBIT(L_OFFERING_RES, L_C_FOR)
                                            IF HAND_INFO_V_E:L_C_FOR:0 >= 100
                                                PRINTFORML {20000 + HAND_INFO_V_E:L_C_FOR:9}
                                                SIF ARG == 0 || ARG == 1
                                                    CALL CB_AI_SET, 20000 + HAND_INFO_V_E:L_C_FOR:9
                                            ELSE
                                                PRINTFORML {10000 + HAND_INFO_V_E:L_C_FOR:12}
                                                SIF ARG == 0 || ARG == 1
                                                    CALL CB_AI_SET, 20000 + HAND_INFO_V_E:L_C_FOR:12
                                            ENDIF
                                        ENDIF
                                    NEXT
                                    PRINTFORML {999}
                                    SIF ARG == 0 || ARG == 1
                                        CALL CB_AI_SET, 999
                                    LOCAL:22 |= LOCAL:29
                                ELSE
                                    SETBIT LOCAL:30, L_C_NUM
                                    GOTO DETSP_CONTINUE
                                ENDIF
                            ENDIF
                        ENDIF
                        PRINTFORML {100 + L_COUNT_P}
                        SIF ARG == 0 || ARG == 1
                            CALL CB_AI_SET, 100 + L_COUNT_P

                        PRINTFORML OK
                        PRINTFORML
                        SIF ARG == 0 || ARG == 1
                            GOTO AI_SET_OK
                    ENDIF

                ENDIF
            NEXT
            PRINTFORML
            ;PRINTFORMW
        ENDIF

    ENDIF
    ;----------
    ;ブロック候補者がスキル使用
    ;----------
    CS_AI_ACTNUM ++
    ;IF CS_AI_STEP == 20
    VARSET L_予定SP, -1
    VARSET L_予定SP_戦闘力, -1
    VARSET L_予定SP_防御度, -1
    VARSET L_予定SP_COST, -1
    LOCAL:10 = -1
    LOCAL:11 = -1
    LOCAL:12 = -1
    LOCAL:13 = -1
    IF L_C_ACTION == 0
        PRINTFORML 블록 강화 스킬 사용
        PRINTFORML
        FOR L_COUNT_E, 0, 6
            PRINTFORML %FIELD_DEMON_DATE_S:(UNIT_INFO_E:L_COUNT_E:0):CBS_NAME% 조사
            FOR L_C_FOR, 0 ,2
                ;ブロック候補度
                LOCAL = L_C_FOR == 0 ? UNIT_INFO_E:L_COUNT_E:4 % 1048576 # UNIT_INFO_E:L_COUNT_E:9 % 1048576
                PRINTFORML ブロック候補度{LOCAL}

                ;ブロックする相手
                L_COUNT_P = LOCAL / 1000

                ;相手がスキル使う？
                L_C_ONE = UNIT_INFO_E:L_COUNT_P:10 == 0 ? 0 # 1
                SIF LOCAL < 1 || !CS_SP_USE_CHECK(UNIT_INFO_E:L_COUNT_E:0)
                    CONTINUE

                LOCAL = LOCAL % 1000
                PRINTFORML %FIELD_DEMON_DATE_S:L_COUNT_P:CBS_NAME%　{LOCAL}

                ;防御度
                LOCAL:13 = L_C_FOR == 0 ? LOCAL / 100 # LOCAL % 10
                ;ブロック度
                LOCAL:11 = L_C_FOR == 0 ? LOCAL % 100 # LOCAL / 10

                SIF BLOCK_BATTLE_RESULT:(L_C_ONE + 2):L_COUNT_P:L_COUNT_E <= BLOCK_BATTLE_RESULT:L_C_ONE:L_COUNT_P:L_COUNT_E
                    CONTINUE
                SIF BLOCK_BATTLE_RESULT:(L_C_ONE + 2):L_COUNT_P:L_COUNT_E < 20 && LOCAL:13 != 2
                    CONTINUE
                
                ;コスト
                TRYCALLFORM CGSP_COST_{FIELD_DEMON_DATE_V:(UNIT_INFO_E:L_COUNT_E:0):CBV_SP1}, FIELD_DEMON_DATE_S:(UNIT_INFO_E:L_COUNT_E:0):CBS_SP1_SUB, (UNIT_INFO_P:L_COUNT_P:0)
