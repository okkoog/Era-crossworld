                ;LOCAL:25 = (UNIT_INFO_E:L_COUNT_E:4 % 1048576) % 100 ;ブロック安全度


                IF LOCAL:22 > 0
                    LOCAL:14 = MIN(LOCAL:10 < 10 ? 99 # LOCAL:10, LOCAL:11 < 10 ? 99 # LOCAL:11)
                    LOCAL:15 = MAX(LOCAL:10 < 10 ?  0 # LOCAL:10, LOCAL:11 < 10 ?  0 # LOCAL:11)
                    
                    IF LOCAL:14 >= 35
                        LOCAL:23 = LOCAL:14
                    ELSEIF LOCAL:14 == 32
                        LOCAL:23 = 15
                    ELSEIF LOCAL:14 <= 20
                        LOCAL:23 = LOCAL:14
                    ENDIF

                    IF (LOCAL:21 < 1 || (LOCAL:21 < (LOCAL:22 * 100 + LOCAL:23))) && LOCAL:24 < 1
                        LOCAL:20 = L_COUNT_E
                        LOCAL:21 = (LOCAL:22 * 100 + LOCAL:23) * 1000 + (900 - LOCAL:26)
                    ENDIF
                    IF (LOCAL:31 < 1 || (LOCAL:31 < (LOCAL:23 * 10 + LOCAL:22))) && LOCAL:25 < 1
                        LOCAL:30 = L_COUNT_E
                        LOCAL:31 = (LOCAL:23 * 10 + LOCAL:22) * 1000 + (900 - LOCAL:26)
                    ENDIF
                ENDIF
            NEXT
            SIF LOCAL:21 % 100 < 20 && L_C_NUM == 1
                UNIT_INFO_P:L_COUNT:4 = MAX(ATTACK_SUMMONER_D_P:L_COUNT_P, ATTACK_SUMMONER_D_P:(L_COUNT_P + 6))
            PRINTFORML {LOCAL:21}　{LOCAL:31}
        NEXT

        SIF LOCAL:20 > -1
            UNIT_INFO_E:(LOCAL:20):4 += L_COUNT_P * 1000 + (LOCAL:21 / 1000)
        SIF LOCAL:30 > -1
            UNIT_INFO_E:(LOCAL:30):9 += L_COUNT_P * 1000 + (LOCAL:31 / 1000)
        IF LOCAL:20 > -1 || LOCAL:30 > -1
