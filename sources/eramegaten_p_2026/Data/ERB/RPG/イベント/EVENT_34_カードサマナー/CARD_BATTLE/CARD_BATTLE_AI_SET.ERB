                SIF L_戦闘アタック者:L_COUNT / 100000 < 1
                    CONTINUE
                L_TAMOKU:12 = MATH_ROUND(SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP, L_戦闘アタック者:L_COUNT / 100000, 1)
                IF L_C_NUM == 0
                    L_TAMOKU:11 = 1
