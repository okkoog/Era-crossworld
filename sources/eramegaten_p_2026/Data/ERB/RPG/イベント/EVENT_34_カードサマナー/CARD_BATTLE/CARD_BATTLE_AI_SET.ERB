@DEC_TO_BIN, ARG
#FUNCTIONS
#DIMS L_RETS
#DIM L_COUNT
#DIM L_NUM
L_RETS =
L_NUM = ARG
L_COUNT = 0
DO
    IF GETBIT(ARG, L_COUNT)
        L_RETS = 1%L_RETS%
    ELSE
        L_RETS = 0%L_RETS%
    ENDIF
    CLEARBIT L_NUM, L_COUNT
    L_COUNT ++
LOOP L_NUM > 0
RETURNF L_RETS




;ARG    除外位置（ビット）
{
@CB_MAX_SUM, L_EXCLUSION = 0, L_NUM = 3, 
ARG:0 = 0, ARG:1 = 0, ARG:2 = 0, ARG:3 = 0, ARG:4 = 0, ARG:5 = 0, ARG:6 = 0, ARG:7 = 0,
ARG:8 = 0, ARG:9 = 0, ARG:10 = 0, ARG:11 = 0, ARG:12 = 0, ARG:13 = 0, ARG:14 = 0, ARG:15 = 0
}
#FUNCTION
#DIM L_EXCLUSION
#DIM L_COUNT
#DIM L_NUM
#DIM L_RET
LOCAL:1 = 0
L_RET = 0

DO
    LOCAL:2 = 0
    FOR L_COUNT, 0, 16
        SIF GETBIT(L_EXCLUSION, L_COUNT)
            ARG:L_COUNT = 0
        IF LOCAL:2 < ARG:L_COUNT
            LOCAL:2 = ARG:L_COUNT
            LOCAL = L_COUNT
        ENDIF
    NEXT
    IF LOCAL:2 > 0
        L_RET += LOCAL:2
        ARG:LOCAL = 0
        LOCAL:1 ++
    ENDIF
LOOP LOCAL:2 > 0 && LOCAL:1 < L_NUM

RETURNF L_RET

