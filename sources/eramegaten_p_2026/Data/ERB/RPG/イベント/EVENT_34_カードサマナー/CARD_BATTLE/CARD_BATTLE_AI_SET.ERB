                    CONTINUE
                SIF LOCAL:20 > 0 && LOCAL:30 > 0
                    CONTINUE
                SIF LOCAL:20 > 300000
                    CONTINUE
            ENDIF
            FOR L_COUNT_E, 0, 6
                SIF UNIT_INFO_E:L_COUNT_E:2 < 0
