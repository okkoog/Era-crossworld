                                CALL CB_STATE_ADD, L_COUNT + 12, SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):2, 2 ,3
                            ELSEIF GROUPMATCH(SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1 % 1000, 12)
                                CALL CB_STATE_ADD, L_COUNT + 12, SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):2, 2
                            ELSEIF GROUPMATCH(SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1 % 1000, 16)
                                CALL CB_STATE_ADD, L_COUNT + 12, SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):2, SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):4
                            ENDIF
                        ENDIF
                    NEXT

                    ;IF SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):2 == 999
                    ;    SETBIT FIELD_DEMON_DATE_V:(L_C_FOR + 12):CBV_CONDITION,0
                    ;ELSE
                    ;    IF GROUPMATCH(SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1 % 100, 10, 14)
                    ;        CALL CB_STATE_ADD, L_C_FOR + 12, SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):2, 1
                    ;    ELSEIF GROUPMATCH(SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1 % 100, 11, 15)
                    ;        CALL CB_STATE_ADD, L_C_FOR + 12, SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):2, 2 ,3
                    ;    ELSEIF GROUPMATCH(SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1 % 100, 12)
                    ;        CALL CB_STATE_ADD, L_C_FOR + 12, SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):2, 2
                    ;    ELSEIF GROUPMATCH(SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1 % 100, 16)
                    ;        CALL CB_STATE_ADD, L_C_FOR + 12, SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):2, SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):4
                    ;    ENDIF
                    ;ENDIF
                    
                    
                ELSEIF INRANGE(SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1, 2 ,4)
                    SIF FIELD_DEMON_DATE_V:(L_C_FOR + 18):CBV_NO == 0
                        CONTINUE
                    SIF !CS_ATTACK_USE_CHECK(L_C_FOR + 18, 0)
                        CONTINUE
                    VARSET L_TAMOKU
                    L_C_ONE = 0
                    SIF STRFIND(SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):0, "無敵") >= 0
                        L_TAMOKU:(L_C_ONE ++) = 3 * 10 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1
                    SIF STRFIND(SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):0, "A反射") >= 0
                        L_TAMOKU:(L_C_ONE ++) = 4 * 10 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1
                    SIF STRFIND(SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):0, "制空") >= 0
                        L_TAMOKU:(L_C_ONE ++) = 7 * 10 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1
                    SIF STRFIND(SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):0, "관통") >= 0
                        L_TAMOKU:(L_C_ONE ++) = 8 * 10 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1
                    SIF STRFIND(SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):0, "通過") >= 0
                        L_TAMOKU:(L_C_ONE ++) = 9 * 10 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1
                    SIF STRFIND(SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):0, "先無") >= 0
                        L_TAMOKU:(L_C_ONE ++) = 13 * 10 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1
                    SIF STRFIND(SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):0, "先制") >= 0
                        L_TAMOKU:(L_C_ONE ++) = 301 * 10 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1
                    SIF STRFIND(SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):0, "飛行") >= 0
                        L_TAMOKU:(L_C_ONE ++) = 305 * 10 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1
                    SIF STRFIND(SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):0, "歩行") >= 0
                        L_TAMOKU:(L_C_ONE ++) = 306 * 10 + SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):1
                    FOR L_C_TWO, 0, L_C_ONE
                        IF L_TAMOKU:L_C_TWO % 10 == 2
                            CALL CB_STATE_ADD, L_C_FOR + 18, L_TAMOKU:L_C_TWO / 10, 1
                        ELSEIF L_TAMOKU:L_C_TWO % 10 == 3
                            CALL CB_STATE_ADD, L_C_FOR + 18, L_TAMOKU:L_C_TWO / 10, 2 ,3
                        ELSEIF L_TAMOKU:L_C_TWO % 10 == 4
                            CALL CB_STATE_ADD, L_C_FOR + 18, L_TAMOKU:L_C_TWO / 10, 2
                            CALL CB_STATE_ADD, L_C_FOR + 18, L_TAMOKU:L_C_TWO / 10, 2 ,3
                        ENDIF
                    NEXT
                    LOCAL:11 = L_C_FOR + 6
                ENDIF
                IF SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):12 == 1
                    SETBIT FIELD_DEMON_DATE_V:(SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):0 + 12):CBV_CONDITION,0
                ELSEIF SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):12 == 2 || SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):12 == 3
                    CALL CS_FIELD_DEMON_CLEAR, SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):0 + 12
                ENDIF

                VARSET L_SP後優勢攻撃力_E
                VARSET L_SP後絶対攻撃力_E
                VARSET L_SP後最大攻撃力_E
                L_SP後絶対攻撃度_E = 0
                L_SP後最大攻撃度_E = 0
                VARSET L_SP後結果攻撃度_E

                IF L_C_ACTION == 4
                    VARSET L_TAMOKU
                    LOCAL:2 = 0
                    FOR L_COUNT_E, 0, 6
                        SIF FIELD_DEMON_DATE_V:(L_COUNT_E + 18):CBV_NO == 0
                            CONTINUE
                        FOR L_COUNT_P, 0, 6
                            SIF FIELD_DEMON_DATE_V:(L_COUNT_P + 12):CBV_NO == 0
                                CONTINUE
                            CALL CB_AI戦闘結果GET, (L_COUNT_E + 18), (L_COUNT_P + 12), 0, 0
                            L_TAMOKU:(L_COUNT_P + 20) = RESULT
                            SIF L_TAMOKU:(L_COUNT_P + 20) == 32
                                L_TAMOKU:(L_COUNT_P + 20) = 12
                            L_TAMOKU:29 = RESULT:1
                        NEXT
                        L_TAMOKU:28 = MAX(L_TAMOKU:20, L_TAMOKU:21, L_TAMOKU:22, L_TAMOKU:23, L_TAMOKU:24, L_TAMOKU:25)
                        PRINTFORML ＠ {L_TAMOKU:20} {L_TAMOKU:21} {L_TAMOKU:22} {L_TAMOKU:23} {L_TAMOKU:24} {L_TAMOKU:25}
                        IF L_TAMOKU:28 < 10
                            L_TAMOKU:(L_COUNT_E) = L_TAMOKU:29
                            L_TAMOKU:6 ++
                        ELSEIF L_TAMOKU:28 < 20
                            FOR L_COUNT_P, 0, 6
                                SIF L_TAMOKU:(L_COUNT_P + 20) >= 10
                                    SETBIT LOCAL:2, L_COUNT_P
                            NEXT
                            L_TAMOKU:(L_COUNT_E + 10) = L_TAMOKU:29
                            L_TAMOKU:16 ++
                        ENDIF
                    NEXT
                    ;攻撃者が防御者より多い
                    ;絶対攻撃者が二人以下
                    ;防御者が、攻撃者の空きより少ない
                    LOCAL:3 = L_TAMOKU:16 - BIT_SUM(LOCAL:2)
                    PRINTFORML AITEM入れ替え前　絶対{L_TAMOKU:6}　最大{L_TAMOKU:16}　ブロック数{BIT_SUM(LOCAL:2)}
                    IF LOCAL:3 > 0 && L_TAMOKU:6 < 2 && (3 - L_TAMOKU:6) > BIT_SUM(LOCAL:2)
                        FOR L_C_ONE, 0, LOCAL:3
                            LOCAL:4 = 99
                            LOCAL:5 = -1
                            FOR L_COUNT_E, 0, 6
                                IF L_TAMOKU:(L_COUNT_E + 10) > 0 && L_TAMOKU:(L_COUNT_E + 10) < LOCAL:4
                                    LOCAL:4 = L_TAMOKU:(L_COUNT_E + 10)
                                    LOCAL:5 = L_COUNT_E
                                ENDIF
                            NEXT
                            IF LOCAL:5 >= 0
                                L_TAMOKU:(LOCAL:5) = L_TAMOKU:(LOCAL:5 + 10)
                                L_TAMOKU:(LOCAL:5 + 10) = 0
                                L_TAMOKU:6 ++
                                L_TAMOKU:16 --
                            ENDIF
                        NEXT
                    ENDIF
                    PRINTFORML AITEM入れ替え後　絶対{L_TAMOKU:6}　最大{L_TAMOKU:16}　ブロック数{BIT_SUM(LOCAL:2)}
                    L_SP後絶対攻撃力_E:0 = CB_MAX_SUM(0,3,L_TAMOKU:0,L_TAMOKU:1,L_TAMOKU:2,L_TAMOKU:3,L_TAMOKU:4,L_TAMOKU:5)
                    L_SP後絶対攻撃力_E:1 = 0
                    IF L_SP後絶対攻撃力_E:0 == 0
                        L_SP後絶対攻撃度_E = 0
                    ELSE
                        LOCAL:1 = (SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP / L_SP後絶対攻撃力_E:0)
                        LOCAL:1 += ((SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP % L_SP後絶対攻撃力_E:0) > 0)
                        L_SP後絶対攻撃力_E:1 = MAX(6 - LOCAL:1, 1)
                        L_SP後絶対攻撃度_E = (L_SP後絶対攻撃力_E:1) * 100 + L_SP後絶対攻撃力_E:0
                    ENDIF
        
                    ;L_SP後優勢攻撃力_E:0 = CB_MAX_SUM(0,3,L_TAMOKU:10,L_TAMOKU:11,L_TAMOKU:12,L_TAMOKU:13,L_TAMOKU:14,L_TAMOKU:15)
                    ;L_SP後優勢攻撃力_E:1 = (SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP / L_SP後優勢攻撃力_E:0)
                    ;L_SP後優勢攻撃力_E:1 += ((SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP % L_SP後優勢攻撃力_E:0) > 0)
        
                    L_SP後最大攻撃力_E:0 = CB_MAX_SUM(0,3,L_TAMOKU:0,L_TAMOKU:1,L_TAMOKU:2,L_TAMOKU:3,L_TAMOKU:4,L_TAMOKU:5,L_TAMOKU:10,L_TAMOKU:11,L_TAMOKU:12,L_TAMOKU:13,L_TAMOKU:14,L_TAMOKU:15)
                    L_SP後最大攻撃力_E:1 = 0
                    IF L_SP後最大攻撃力_E:0 == 0
                        L_SP後最大攻撃度_E = 0
                    ELSE
                        LOCAL:1 = (SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP / L_SP後最大攻撃力_E:0)
                        LOCAL:1 += ((SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP % L_SP後最大攻撃力_E:0) > 0)
                        L_SP後最大攻撃力_E:1 = MAX(5 - LOCAL:1, 1)
                        L_SP後最大攻撃度_E = (L_SP後最大攻撃力_E:1) * 100 + L_SP後最大攻撃力_E:0
                    ENDIF
        
                    L_SP後結果攻撃度_E:0 = L_SP後絶対攻撃度_E >= L_SP後最大攻撃度_E ? L_SP後絶対攻撃度_E # L_SP後最大攻撃度_E
                    L_SP後結果攻撃度_E:1 = L_SP後絶対攻撃度_E >= L_SP後最大攻撃度_E ? 1 # 0
    
                ENDIF

                VARSET L_TAMOKU
                LOCAL:2 = 0
                FOR L_COUNT_P, 12, 18
                    SIF FIELD_DEMON_DATE_V:L_COUNT_P:CBV_NO == 0
                        CONTINUE
                    FOR L_COUNT_E, 18, 24
                        SIF FIELD_DEMON_DATE_V:L_COUNT_E:CBV_NO == 0
                            CONTINUE
                        
                        L_C_ONE = UNIT_INFO_P:(L_COUNT_P - 12):10 > 0 ? 1 # 0
                        CALL CB_AI戦闘結果GET, L_COUNT_P, L_COUNT_E, L_C_ONE, 1
                        L_TAMOKU:(L_COUNT_E + 2) = RESULT
                        SIF L_TAMOKU:(L_COUNT_E + 2) == 32
                            L_TAMOKU:(L_COUNT_E + 2) = 12
                        L_TAMOKU:29 = RESULT:1
                    NEXT
                    L_TAMOKU:28 = MAX(L_TAMOKU:20, L_TAMOKU:21, L_TAMOKU:22, L_TAMOKU:23, L_TAMOKU:24, L_TAMOKU:25)
                    PRINTFORML 敵 {L_TAMOKU:20} {L_TAMOKU:21} {L_TAMOKU:22} {L_TAMOKU:23} {L_TAMOKU:24} {L_TAMOKU:25}
                    IF L_TAMOKU:28 < 10
                        L_TAMOKU:(L_COUNT_P - 12) = L_TAMOKU:29
                        L_TAMOKU:6 ++
                    ELSEIF L_TAMOKU:28 < 20
                        FOR L_COUNT_E, 0, 6
                            SIF L_TAMOKU:(L_COUNT_E + 20) >= 10
                                SETBIT LOCAL:2, L_COUNT_E
                        NEXT
                        L_TAMOKU:(L_COUNT_P - 2) = L_TAMOKU:29
                        L_TAMOKU:16 ++
                    ENDIF
                NEXT
                ;攻撃者が防御者より多い
                ;絶対攻撃者が二人以下
                ;防御者が、攻撃者の空きより少ない
                LOCAL:3 = L_TAMOKU:16 - BIT_SUM(LOCAL:2)
                PRINTFORML BITEM入れ替え前　絶対{L_TAMOKU:6}　最大{L_TAMOKU:16}　ブロック数{BIT_SUM(LOCAL:2)}
                IF LOCAL:3 > 0 && L_TAMOKU:6 < 2 && (3 - L_TAMOKU:6) > BIT_SUM(LOCAL:2)
                    FOR L_C_ONE, 0, LOCAL:3
                        LOCAL:4 = 99
                        LOCAL:5 = -1
                        FOR L_COUNT_E, 0, 6
                            IF L_TAMOKU:(L_COUNT_E + 10) > 0 && L_TAMOKU:(L_COUNT_E + 10) < LOCAL:4
                                LOCAL:4 = L_TAMOKU:(L_COUNT_E + 10)
                                LOCAL:5 = L_COUNT_E
                            ENDIF
                        NEXT
                        IF LOCAL:5 >= 0
                            L_TAMOKU:(LOCAL:5) = L_TAMOKU:(LOCAL:5 + 10)
                            L_TAMOKU:(LOCAL:5 + 10) = 0
                            L_TAMOKU:6 ++
                            L_TAMOKU:16 --
                        ENDIF
                    NEXT
                ENDIF
                PRINTFORML BITEM入れ替え後　絶対{L_TAMOKU:6}　最大{L_TAMOKU:16}　ブロック数{BIT_SUM(LOCAL:2)}

                L_SP後絶対攻撃力_P:0 = CB_MAX_SUM(0,3,L_TAMOKU:0,L_TAMOKU:1,L_TAMOKU:2,L_TAMOKU:3,L_TAMOKU:4,L_TAMOKU:5)
                L_SP後絶対攻撃力_P:1 = 0
                IF L_SP後絶対攻撃力_P:0 == 0
                    L_SP後絶対攻撃度_P = 0
                ELSE
                    LOCAL:1 = (SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP / L_SP後絶対攻撃力_P:0)
                    LOCAL:1 += ((SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP % L_SP後絶対攻撃力_P:0) > 0)
                    L_SP後絶対攻撃力_P:1 = MAX(6 - LOCAL:1, 1)
                    L_SP後絶対攻撃度_P = (L_SP後絶対攻撃力_P:1) * 100 + L_SP後絶対攻撃力_P:0
                ENDIF
                
                L_SP後最大攻撃力_P:0 = CB_MAX_SUM(0,3,L_TAMOKU:0,L_TAMOKU:1,L_TAMOKU:2,L_TAMOKU:3,L_TAMOKU:4,L_TAMOKU:5,L_TAMOKU:10,L_TAMOKU:11,L_TAMOKU:12,L_TAMOKU:13,L_TAMOKU:14,L_TAMOKU:15)
                L_SP後最大攻撃力_P:1 = 0
                IF L_SP後最大攻撃力_P:0 == 0
                    L_SP後最大攻撃度_P = 0
                ELSE
                    LOCAL:1 = (SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP / L_SP後最大攻撃力_P:0)
                    LOCAL:1 += ((SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP % L_SP後最大攻撃力_P:0) > 0)
                    L_SP後最大攻撃力_P:1 = MAX(5 - LOCAL:1, 1)
                    L_SP後最大攻撃度_P = (L_SP後最大攻撃力_P:1) * 100 + L_SP後最大攻撃力_P:0
                ENDIF
        
                ;L_SP後優勢攻撃力_P:0 = CB_MAX_SUM(0,3,L_TAMOKU:10,L_TAMOKU:11,L_TAMOKU:12,L_TAMOKU:13,L_TAMOKU:14,L_TAMOKU:15)
                ;L_SP後優勢攻撃力_P:1 = (SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP / L_SP後優勢攻撃力_P:0)
                ;L_SP後優勢攻撃力_P:1 += ((SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP % L_SP後優勢攻撃力_P:0) > 0)
        
                L_SP後結果攻撃度_P:0 = L_SP後絶対攻撃度_P >= L_SP後最大攻撃度_P ? L_SP後絶対攻撃度_P # L_SP後最大攻撃度_P
                L_SP後結果攻撃度_P:1 = L_SP後絶対攻撃度_P >= L_SP後最大攻撃度_P ? 1 # 0

                PRINTFORML 敵 {L_SP後結果攻撃度_E:0}　＠ {L_SP後結果攻撃度_P:0}

                L_SP後結果攻撃度総合 = L_SP後結果攻撃度_E:0 - L_SP後結果攻撃度_P:0 - (LOCAL:10 * 34)
                IF L_SP後結果攻撃度総合 > L_結果攻撃度総合 && ((USING_SP_DATA:0:0 < 0) || (USING_SP_DATA:0:1 < L_SP後結果攻撃度総合))
                    IF SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):13 > 0
                        CALL CB_OFFERING_POSGET, HAND_INFO_V_E, SP_INFO_V_E:(USE_SP_INFO:L_C_NUM:0):13, USE_SP_INFO:L_C_NUM:2, SP_INFO_S_E:(USE_SP_INFO:L_C_NUM:0):0
                        SIF RESULT == 0
                            CONTINUE
                    ENDIF
                    IF (L_C_ACTION == 3 && (L_SP後結果攻撃度総合 / 100) > (L_結果攻撃度総合 / 100)) || (L_C_ACTION == 4)
                        USING_SP_DATA:0:0 = USE_SP_INFO:L_C_NUM:0 + 100
                        USING_SP_DATA:0:1 = L_SP後結果攻撃度総合
                        USING_SP_DATA:0:2 = LOCAL:11
                        PRINTFORML SP使用 {USING_SP_DATA:0:0}　{USING_SP_DATA:0:1}　{USING_SP_DATA:0:2}
                    ENDIF
                ENDIF

            NEXT
        NEXT
        
        FOR L_COUNT, CBF_ALLY_AI_POS1, CBF_ENEMY_AI_POS6 + 1
            CALL CS_FIELD_DEMON_CLEAR, L_COUNT
        NEXT
        IF USING_SP_DATA:0:0 > -1 && USE_SP_INFO:0:0 > -1
            PRINTFORML 最終SP使用 {USING_SP_DATA:0:0}　{USING_SP_DATA:0:1}　{USING_SP_DATA:0:2}
            IF USING_SP_DATA:0:0 >= 100
                USING_SP_DATA:0:0 -= 100
                IF SP_INFO_V_E:(USING_SP_DATA:0:0):0 < 100
                    SIF ARG == 0 || ARG == 1
                        CALL CB_AI_SET, 1500 + SP_INFO_V_E:(USING_SP_DATA:0:0):0
                    PRINTFORML {1500 + SP_INFO_V_E:(USING_SP_DATA:0:0):0}
                ELSE
                    SIF ARG == 0 || ARG == 1
                        CALL CB_AI_SET, 10000 + SP_INFO_V_E:(USING_SP_DATA:0:0):9
                    PRINTFORML {10000 + SP_INFO_V_E:(USING_SP_DATA:0:0):9}
                ENDIF
            ELSE
                PRINTFORML {1500 + USING_SP_DATA:0:0 + 6}
                SIF ARG == 0 || ARG == 1
                    CALL CB_AI_SET, 1500 + USING_SP_DATA:0:0 + 6
                SIF USING_SP_DATA:0:0 && USING_SP_DATA:0:2 == -2
                    SETBIT CS_AI_ATTACK_S, USING_SP_DATA:0:0 + 6
            ENDIF
            IF SP_INFO_V_E:(USING_SP_DATA:0:0):13 > 0
                CALL CB_OFFERING_POSGET, HAND_INFO_V_E, SP_INFO_V_E:(USING_SP_DATA:0:0):13, USING_SP_DATA:0:2, SP_INFO_S_E:(USING_SP_DATA:0:0):0
                IF RESULT != 0
                    L_OFFERING_RES = RESULT
                    FOR L_C_FOR , 0, HAND_CARDS(CS1_OPPONENT)
                        IF GETBIT(L_OFFERING_RES, L_C_FOR)
                            IF HAND_INFO_V_E:L_C_FOR:0 >= 100
                                SIF ARG == 0 || ARG == 1
                                    CALL CB_AI_SET, 20000 + HAND_INFO_V_E:L_C_FOR:9
                                PRINTFORML {20000 + HAND_INFO_V_E:L_C_FOR:9}
                            ELSE
                                SIF ARG == 0 || ARG == 1
                                    CALL CB_AI_SET, 20000 + HAND_INFO_V_E:L_C_FOR:12
                                PRINTFORML {20000 + HAND_INFO_V_E:L_C_FOR:12}
                            ENDIF
                        ENDIF
                    NEXT
                    PRINTFORML {999}
                    SIF ARG == 0 || ARG == 1
                        CALL CB_AI_SET, 999
                ENDIF
            ENDIF
            IF USING_SP_DATA:0:2 > -1
                PRINTFORML {100 + USING_SP_DATA:0:2}
                SIF ARG == 0 || ARG == 1
                    CALL CB_AI_SET, 100 + USING_SP_DATA:0:2
                SIF L_C_ACTION == 4 && 5 < USING_SP_DATA:0:2
                    SETBIT CS_AI_ATTACK_S, USING_SP_DATA:0:2
            ENDIF
            PRINTFORML OK
            PRINTFORML
            SIF ARG == 0 || ARG == 1
                GOTO AI_SET_OK
        ENDIF
    ENDIF
NEXT

PRINTFORML SP 사용 기타
PRINTFORML 
VARSET L_TAMOKU, -1

L_TAMOKU:1 = 30
FOR L_C_ACTION ,1 ,VARSIZE("L_TAMOKU", 0)
    SIF L_TAMOKU:L_C_ACTION <= 0
        BREAK
    L_TAMOKU = L_TAMOKU:L_C_ACTION
    SIF L_TAMOKU == 30
        PRINTFORML 회복
    USING_SP_DATA:0:0 = -1
    USING_SP_DATA:0:1 = 0

    CS_AI_ACTNUM = 1100 + L_TAMOKU
    FOR L_COUNT ,0 ,VARSIZE("SP_INFO_V_E", 0)
        IF SP_INFO_V_E:L_COUNT:1 == L_TAMOKU
            PRINTFORML %SP_INFO_S_E:L_COUNT:9%
            IF L_TAMOKU == 30
                LOCAL = SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_MAX_HP - SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP
                SIF LOCAL < 1
                    BREAK
                IF SP_INFO_V_E:L_COUNT:0 >= 100 && LOCAL >= SP_INFO_V_E:L_COUNT:2
                    PRINTFORML {10000 + SP_INFO_V_E:L_COUNT:9} %SP_INFO_S_E:L_COUNT:9%
                    PRINTFORML OK
                    IF ARG == 0 || ARG == 1
                        CALL CB_AI_SET, 10000 + SP_INFO_V_E:L_COUNT:9
                        GOTO AI_SET_OK
                    ENDIF
                ELSEIF 0 <= SP_INFO_V_E:L_COUNT:0 && SP_INFO_V_E:L_COUNT:0 < 100
                    LOCAL:10 = (3 - SP_INFO_V_E:L_COUNT:12) * 100000 + (20 - SP_INFO_V_E:L_COUNT:10) * 1000 + 900 - UNIT_INFO_E:(SP_INFO_V_E:L_COUNT:0 - 6):11
                    IF SP_INFO_V_E:L_COUNT:12 == 0 && LOCAL >= SP_INFO_V_E:L_COUNT:2 && USING_SP_DATA:0:1 < LOCAL:10
                        USING_SP_DATA:0:0 = SP_INFO_V_E:L_COUNT:0
                        USING_SP_DATA:0:1 = LOCAL:10
                    ELSEIF SP_INFO_V_E:L_COUNT:12 > 0
                        SIF UNIT_INFO_E:(SP_INFO_V_E:L_COUNT:0 - 6):3 >= 300 && SP_INFO_V_E:L_COUNT:12 == 1
                            CONTINUE
                        SIF UNIT_INFO_E:(SP_INFO_V_E:L_COUNT:0 - 6):3 >= 100 && (SP_INFO_V_E:L_COUNT:12 == 2 || SP_INFO_V_E:L_COUNT:12 == 3)
                            CONTINUE
                        LOCAL:3 = -1
                        LOCAL:4 = -1
                        IF UNIT_INFO_E:(SP_INFO_V_E:L_COUNT:0 - 6):4 % 1048576 > 0
                            LOCAL:3 = (UNIT_INFO_E:(SP_INFO_V_E:L_COUNT:0 - 6):4 % 1048576) / 1000
                            LOCAL:3 = MAX(ATTACK_SUMMONER_D_E:(LOCAL:3), ATTACK_SUMMONER_D_E:(LOCAL:3 + 6))
                        ENDIF
                        IF UNIT_INFO_E:(SP_INFO_V_E:L_COUNT:0 - 6):9 > 0
                            LOCAL:4 = UNIT_INFO_E:(SP_INFO_V_E:L_COUNT:0 - 6):9 / 1000
                            LOCAL:4 = MAX(ATTACK_SUMMONER_D_E:(LOCAL:4), ATTACK_SUMMONER_D_E:(LOCAL:4 + 6))
                        ENDIF
                        LOCAL:5 = MAX(LOCAL:3, LOCAL:4)
                        SIF LOCAL:5 > 0 && (SP_INFO_V_E:L_COUNT:12 == 2 || SP_INFO_V_E:L_COUNT:12 == 3)
                            CONTINUE
                        SIF LOCAL:5 > SP_INFO_V_E:L_COUNT:2 && LOCAL:5 > -1
                            CONTINUE
                        {
                        IF USING_SP_DATA:0:1 < LOCAL:10
                        && (((LOCAL:5 < 0 || SP_INFO_V_E:L_COUNT:2 <= LOCAL - 2) && SP_INFO_V_E:L_COUNT:12 == 1) 
                        || (SP_INFO_V_E:L_COUNT:2 <= LOCAL && (SP_INFO_V_E:L_COUNT:12 == 2 || SP_INFO_V_E:L_COUNT:12 == 3)))
                        }
                            USING_SP_DATA:0:0 = SP_INFO_V_E:L_COUNT:0
                            USING_SP_DATA:0:1 = LOCAL:10
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    NEXT
    IF USING_SP_DATA:0:0 > -1
        PRINTFORML {3500 + USING_SP_DATA:0:0} %FIELD_DEMON_DATE_S:(USING_SP_DATA:0:0):CBS_NAME%
        PRINTFORML OK
        IF ARG == 0 || ARG == 1
            CALL CB_AI_SET, 1500 + USING_SP_DATA:0:0
            GOTO AI_SET_OK
        ENDIF
    ENDIF
NEXT

PRINTFORML 어택 세트
CS_AI_ACTNUM = 1200

VARSET L_TAMOKU
VARSET L_SORT
L_TAMOKU = 0
L_攻撃数 = 0
;1の位　攻撃者のポジション
;10の位　攻撃力
FOR L_COUNT_E, 0, 6
    LOCAL = UNIT_INFO_E:L_COUNT_E:7 >= 100 ? UNIT_INFO_E:L_COUNT_E:7 / 100 # UNIT_INFO_E:L_COUNT_E:7

    IF FIELD_DEMON_DATE_V:(L_COUNT_E + 6):CBV_BATTLE > 0
        L_攻撃数 ++
        CONTINUE
    ENDIF
    SIF LOCAL < 1 || !CS_ATTACK_USE_CHECK(L_COUNT_E + 6, 0)
        CONTINUE
    SIF !GETBIT(CS_AI_ATTACK_S, L_COUNT_E + 6) && (UNIT_INFO_E:L_COUNT_E:4 % 1048576 > 0 || UNIT_INFO_E:L_COUNT_E:9 > 0)
        CONTINUE
        
    LOCAL:1 = (SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP / LOCAL)
    LOCAL:1 += ((SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP % LOCAL) > 0)

    LOCAL:2 = 0
    IF GETBIT(CS_AI_ATTACK_S, L_COUNT_E + 6)
        LOCAL:2 = MAX(6 - LOCAL:1, 1)
    ELSEIF UNIT_INFO_E:L_COUNT_E:3 >= 400
        LOCAL:2 = MAX(6 - LOCAL:1, 1)
    ELSEIF UNIT_INFO_E:L_COUNT_E:3 >= 300
        LOCAL:2 = MAX(5 - LOCAL:1, 1)
    ELSEIF UNIT_INFO_E:L_COUNT_E:3 % 100 == 2
        FOR L_COUNT_P, 0, 6
            ;
            IF ATTACK_BATTLE_RESULT:0:L_COUNT_E:L_COUNT_P == 20
                L_TAMOKU:(10 + L_COUNT_E) ++
                SETBIT L_TAMOKU:(20 + L_COUNT_E), L_COUNT_P
            ENDIF
        NEXT
    ELSEIF UNIT_INFO_E:L_COUNT_E:3 % 100 == 1
        LOCAL:2 = MAX(4 - LOCAL:1, 1)
    ELSEIF UNIT_INFO_E:L_COUNT_E:3 % 100 == 0 && UNIT_INFO_E:L_COUNT_E:3 > 0
        SETBIT L_TAMOKU:5, L_COUNT_E
    ENDIF
    IF LOCAL:2 > 0
        LOCAL:2 = LOCAL:2 * 100 + LOCAL

        L_SORT:L_TAMOKU = LOCAL:2 * 100 + L_COUNT_E + 6
        L_TAMOKU ++
    ENDIF
NEXT


IF L_TAMOKU > 0
    ARRAYSORT L_SORT, BACK, 0, L_TAMOKU
    LOCAL = 0
    FOR L_COUNT, 0, L_TAMOKU
        IF L_SORT:L_COUNT > 0
            SIF ARG == 0 || ARG == 1
                CALL CB_AI_SET, 3500 + L_SORT:L_COUNT % 100
            PRINTFORML {3500 + L_SORT:L_COUNT % 100} %FIELD_DEMON_DATE_S:(L_SORT:L_COUNT % 100):CBS_NAME%
            LOCAL ++
        ENDIF
        SIF L_攻撃数 + LOCAL > 2
            BREAK
    NEXT
    SIF LOCAL > 0
        PRINTFORML OK
        SIF ARG == 0 || ARG == 1
            GOTO AI_SET_OK
ENDIF

IF L_攻撃数 < 2
    VARSET L_SORT
    L_TAMOKU = 0
    FOR L_COUNT_E, 0, 6
        ;
        SIF L_TAMOKU:(10 + L_COUNT_E) < 1
            CONTINUE
        LOCAL = UNIT_INFO_E:L_COUNT_E:7 >= 100 ? UNIT_INFO_E:L_COUNT_E:7 / 100 # UNIT_INFO_E:L_COUNT_E:7
        IF (3 - L_攻撃数) > L_TAMOKU:(10 + L_COUNT_E)
            ;
            L_SORT:L_TAMOKU = LOCAL * 100 + L_COUNT_E
            L_TAMOKU ++
        ENDIF
    NEXT
    IF L_TAMOKU >= 2
        ;
        ARRAYSORT L_SORT, BACK, 0, L_TAMOKU
        LOCAL = 0
        LOCAL:1 = 0
        FOR L_COUNT, 0, MIN(3 - L_攻撃数, L_TAMOKU)
            ;
            LOCAL ++
            LOCAL:1 |= L_TAMOKU:(20 + L_SORT:L_COUNT % 100)
        NEXT
        IF LOCAL > BIT_SUM(LOCAL:1,0,12)
            FOR L_COUNT, 0, MIN(3 - L_攻撃数, L_TAMOKU)
                SIF ARG == 0 || ARG == 1
                    CALL CB_AI_SET, 3500 + L_SORT:L_COUNT % 100 + 6
                PRINTFORML {3500 + L_SORT:L_COUNT % 100 + 6} %FIELD_DEMON_DATE_S:(L_SORT:L_COUNT % 100 + 6):CBS_NAME%
            NEXT
            PRINTFORML OK
            SIF ARG == 0 || ARG == 1
                GOTO AI_SET_OK
        ENDIF
    ENDIF
ENDIF

IF L_TAMOKU:5 != 0
    ;
    VARSET L_SORT
    L_TAMOKU = 0
    FOR L_COUNT, 0, 6
        ;
        IF GETBIT(L_TAMOKU:5, L_COUNT)
            ;
            LOCAL = UNIT_INFO_E:L_COUNT:7 >= 100 ? UNIT_INFO_E:L_COUNT:7 / 100 # UNIT_INFO_E:L_COUNT:7
            L_SORT:L_TAMOKU = LOCAL * 100 + L_COUNT
            L_TAMOKU ++
        ENDIF
    NEXT
    IF L_TAMOKU > 0
        ;
        ARRAYSORT L_SORT, BACK, 0, L_TAMOKU
        FOR L_COUNT, 0, L_TAMOKU
            LOCAL:1 = (SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP / (L_SORT:L_COUNT / 100))
            LOCAL:1 += ((SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP % (L_SORT:L_COUNT / 100)) > 0)
            
            SIF LOCAL:1 > 4
                CONTINUE
            LOCAL:2 = -1
            LOCAL:3 = 99
            FOR L_COUNT_P, 0, 6
                ;
                IF ATTACK_BATTLE_RESULT:0:(L_SORT:L_COUNT % 100):L_COUNT_P == 35 && UNIT_INFO_P:L_COUNT_P:1 < LOCAL:3
                    LOCAL:2 = L_COUNT_P
                    LOCAL:3 = UNIT_INFO_P:L_COUNT_P:1
                ENDIF
            NEXT
            IF LOCAL:2 >= 0
                LOCAL:4 = 0
                LOCAL:5 = 0
                SETBIT LOCAL:4, L_SORT:L_COUNT % 100
                SETBIT LOCAL:5, LOCAL:2
                LOCAL:6 = CB_MAX_SUM(LOCAL:4, 3, UNIT_INFO_E:0:1, UNIT_INFO_E:1:1, UNIT_INFO_E:2:1, UNIT_INFO_E:3:1, UNIT_INFO_E:4:1, UNIT_INFO_E:5:1)
                LOCAL:7 = CB_MAX_SUM(LOCAL:5, 3, UNIT_INFO_P:0:1, UNIT_INFO_P:1:1, UNIT_INFO_P:2:1, UNIT_INFO_P:3:1, UNIT_INFO_P:4:1, UNIT_INFO_P:5:1)
                IF LOCAL:6 >= LOCAL:7
                    SIF ARG == 0 || ARG == 1
                        CALL CB_AI_SET, 3500 + L_SORT:L_COUNT % 100 + 6
                    PRINTFORML {3500 + L_SORT:L_COUNT % 100 + 6} %FIELD_DEMON_DATE_S:(L_SORT:L_COUNT % 100 + 6):CBS_NAME%
                    PRINTFORML OK
                    SIF ARG == 0 || ARG == 1
                        GOTO AI_SET_OK
                ENDIF
            ENDIF
        NEXT

    ENDIF

ENDIF








PRINTFORML 스톡 마그네타이트
PRINTFORML 生成
CS_AI_ACTNUM = 1300

LOCAL = 0
LOCAL:1 = -1
LOCAL:2 = SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_STOCK_MAG % 10
FOR L_COUNT_E, 6, 12
    {
    SIF FIELD_DEMON_DATE_V:L_COUNT_E:CBV_BATTLE > 0 || FIELD_DEMON_DATE_V:L_COUNT_E:CBV_NO == 0
    || GETBIT(FIELD_DEMON_DATE_V:L_COUNT_E:CBV_CONDITION, 0) || GETBIT(FIELD_DEMON_DATE_V:L_COUNT_E:CBV_CONDITION, 2) || GETBIT(FIELD_DEMON_DATE_V:L_COUNT_E:CBV_CONDITION, 3)
    }
        CONTINUE
    SIF UNIT_INFO_E:(L_COUNT_E - 6):4 % 1048576 > 0 || UNIT_INFO_E:(L_COUNT_E - 6):9 > 0
        CONTINUE
    LOCAL:3 = CS_STOCK_MAG_GET_F(L_COUNT_E, CS1_OPPONENT, 0) * 10000 + BIT_SUM(UNIT_INFO_E:(L_COUNT_E - 6):4, 20, 30) * 1000 + 200 - UNIT_INFO_E:(L_COUNT_E - 6):11
    IF CS_STOCK_MAG_GET_F(L_COUNT_E, CS1_OPPONENT, 0) + LOCAL:2 >= 10 && LOCAL < LOCAL:3
        LOCAL = CS_STOCK_MAG_GET_F(L_COUNT_E, CS1_OPPONENT, 0)
        LOCAL:1 = L_COUNT_E
    ELSEIF CS_STOCK_MAG_GET_F(L_COUNT_E, CS1_OPPONENT, 0) + LOCAL:2 < 10
        LOCAL:2 += CS_STOCK_MAG_GET_F(L_COUNT_E, CS1_OPPONENT, 0)
    ENDIF
NEXT
IF LOCAL:1 > -1
    PRINTFORML {3600 + LOCAL:1} %FIELD_DEMON_DATE_S:(LOCAL:1):CBS_NAME%
    PRINTFORML OK
    SIF ARG == 0 || ARG == 1
        CALL CB_AI_SET, 3600 + LOCAL:1
    ;RETURN 1
    SIF ARG == 0 || ARG == 1
        GOTO AI_SET_OK
ENDIF

SIF ARG == 1 || ARG == 2
    PRINTFORMW 
CLEARLINE LINECOUNT - L_LINE


REDRAW 1
SIF ARG == 0 || ARG == 1
    CS_AI_STEP = 40

RETURN 0

$AI_SET_OK
IF ARG == 1
    PRINTFORML 
    PRINTFORML 
    PRINTFORML ACTION
    FOR L_COUNT, 0, VARSIZE("CS_AI_ACTION",0)
        SIF CS_AI_ACTION:L_COUNT < 1
            BREAK
        PRINTFORML {CS_AI_ACTION:L_COUNT}
    NEXT
    WAIT
