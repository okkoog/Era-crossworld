;잔/1/0/
;特技名
@CGSP_NAME_6071, ARGS, ARG
RESULTS = チャイカムNTN

;　コストの量
@CGSP_COST_6071, ARGS, ARG
RETURN 3

;　타겟(選択するかしないか)
@CGSP_TARGET_6071, ARGS, ARG
RETURN 3
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_6071, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　4-召喚時

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_6071, ARGS, ARG, ARG:1

LOCAL:3 = 0
FOR LOCAL, 0, VARSIZE("OFFERING_CARD_DATE_V", 0)
	SIF OFFERING_CARD_DATE_V:LOCAL:CBV_KINDS >= 100
		LOCAL:3 = 1
NEXT

IF LOCAL:3 == 0
    CALL SP_DAMAGE, ARG:1, 4, ARG
    CALL CS_SUMMONER_DAMAGE, ARG % 20, 5, -1, 99
ELSE
    CALL SP_DAMAGE, ARG:1, 5, ARG
    CALL CS_SUMMONER_DAMAGE, ARG % 20, 6, -1, 99
ENDIF

;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_6071, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_6071, ARGS, ARG
RESULTS = 敵仲魔1体に、4Pのダメージをあたえるが、サマナーも5Pのダメージをうける。供物にアイテムを使用すると、敵仲魔に5Pダメージを与えるが、サマナーへのダメージが6Pになる。『長方形の固形爆弾。とても強力な爆弾で使った本人もダメージを受ける。』


;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　1(アギとかのダメージ魔法系は1),ダメージ,範囲1体は1、全体は2
@CGSP_TYPE_6071, ARGS, ARG
RESULTS = 自傷5
RETURN 1, 4, 1

@CGSP_TYPE_6071_1, ARGS, ARG
RESULTS = 自傷6
RESULTS:1 = アイテム
RETURN 1, 5, 1

