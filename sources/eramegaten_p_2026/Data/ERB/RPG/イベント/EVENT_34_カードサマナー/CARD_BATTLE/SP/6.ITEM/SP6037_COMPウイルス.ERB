
;特技名
@CGSP_NAME_6037, ARGS, ARG
RESULTS = COMPウイルス

;　コストの量
@CGSP_COST_6037, ARGS, ARG
RETURN 6
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_6037, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_6037, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_6037, ARGS, ARG, ARG:1
;ｻﾏﾅｰは+20
IF (ARG % 20) == CS1_ONESELF
	LOCAL = CS1_OPPONENT
ELSE
	LOCAL = CS1_ONESELF
ENDIF

CALL CS_DICEROLL_S_STATE,999, ARG, LOCAL, 106, 2

;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_6037, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_6037, ARGS, ARG
RESULTS = 次ﾀｰﾝ まで敵ｻﾏﾅｰに「召喚封じ」を付与し、仲魔の召喚を封じる。『ウィルスにおかされたコンピュータは悪魔の召喚ができない』


;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　20は状態でｻﾏﾅｰ妨害
@CGSP_TYPE_6037, ARGS, ARG
RETURN 20, 106

