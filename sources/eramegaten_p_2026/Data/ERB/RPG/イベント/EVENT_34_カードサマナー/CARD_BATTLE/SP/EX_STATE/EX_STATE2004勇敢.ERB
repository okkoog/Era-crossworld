@CGEX_STATE_TIMING_2004, ARG, ARG:1,
RETURN 9
;0-그외
;1-自分ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ
;4-自分ﾊﾞﾄﾙﾌｪｲｽﾞ　5-相手ﾊﾞﾄﾙﾌｪｲｽﾞ　6-両方ﾊﾞﾄﾙﾌｪｲｽﾞ
;7-自分戦闘時　8-相手戦闘時　9-両方戦闘時
;10-自分ｴﾝﾄﾞﾌｪｲｽﾞ時ターンカウント0時

;====================================================
;ステイト発動
;====================================================
;ARG	状態保持者
;ARG:1	ステイトの位置
;ARG:2	戦闘時などの相手
@CGEX_STATE_ACTION_2004, ARG, ARG:1, ARG:2 = -1
#DIM L_NUM

IF ARG:2 > -1 && (FIELD_DEMON_DATE_V:(ARG):CBV_B_AP + FIELD_DEMON_DATE_V:(ARG):CBV_B_AP) < (FIELD_DEMON_DATE_V:(ARG:2):CBV_B_AP + FIELD_DEMON_DATE_V:(ARG:2):CBV_B_AP)
	L_NUM = FIELD_DEMON_STATE_V:ARG:(ARG:1):CBV_SUB1

	CALL SP_PUWER_UP, ARG, STATE_PUAPHP_GET(L_NUM, 0), STATE_PUAPHP_GET(L_NUM, 1)
ENDIF


