;アタック、ブロック危険度算出

;ARB　ポイント者
;ARB:1　お相手
;ARB:2　ステイト　ポイント者無し1、お相手無し2、両方無し3
;ARGS　ポイント者の付与ステ
;ARGS:1　お相手の付与ステ
;L_BATTLE　攻勢0か防衛1か
@CBAI_LUCRATIVE_P, ARG = -1, ARG:1 = -1, L_BATTLE, ARGS = "", ARGS:1 = "", ARG:2 = 0
#DIM L_ATTACKER
#DIM L_BLOCKER
#DIM L_COUNT
#DIM L_BATTLE

#DIM L_AAP
#DIM L_AHP
#DIM L_ASPEED
#DIM L_AFLY
#DIM L_ASTATE
#DIM L_ASTATE2
#DIMS L_ASP_STATE
#DIMS L_AG_STATE

#DIM L_BAP
#DIM L_BHP
#DIM L_BSPEED
#DIM L_BFLY
#DIM L_BSTATE
#DIM L_BSTATE2
#DIMS L_BSP_STATE
#DIMS L_BG_STATE

#DIM L_LUCRATIVE_P, 4


SIF !INRANGE (ARG, 0, 11) || !INRANGE (ARG:1, 0, 11)
	RETURN 0, 0 ,0 ,0

L_ATTACKER = (L_BATTLE == 0 ? ARG # ARG:1)
L_BLOCKER = (L_BATTLE == 0 ? ARG:1 # ARG)

SIF FIELD_DEMON_DATE_V:L_ATTACKER:CBV_NO < 1 || FIELD_DEMON_DATE_V:L_BLOCKER:CBV_NO < 1
	RETURN 0, 0 ,0 ,0

L_AG_STATE = (L_BATTLE == 0 ? ARGS # ARGS:1)
L_BG_STATE = (L_BATTLE == 0 ? ARGS:1 # ARGS)

IF L_BATTLE == 0
	L_ASTATE = (GETBIT(ARG:2, 0) ? 0 # 1)
	L_BSTATE = (GETBIT(ARG:2, 1) ? 0 # 1)
ELSE
	L_ASTATE = (GETBIT(ARG:2, 1) ? 0 # 1)
	L_BSTATE = (GETBIT(ARG:2, 0) ? 0 # 1)
ENDIF

LOCAL:0 = 0
SIF STRFIND(ARGS:0, "回封") >= 0
	SETBIT LOCAL:0, 0

LOCAL:1 = 0
SIF STRFIND(ARGS:1, "回封") >= 0
	SETBIT LOCAL:1, 0

L_ASTATE2 = (L_BATTLE == 0 ? LOCAL # LOCAL:1)
L_BSTATE2 = (L_BATTLE == 0 ? LOCAL:1 # LOCAL)






FOR L_COUNT, 0, 4
	LOCAL:4 = 0
	IF CS_ATTACK_USE_CHECK(L_ATTACKER, L_ASTATE)
		RESULTS =
		L_ASPEED = AI_SPEED_GET(L_ATTACKER, 0)
		L_AFLY = AI_FLY_GET(L_ATTACKER, 0)
		CALL CB_BATTLE_APHP_GET, L_ATTACKER, L_COUNT % 2, 0, L_BLOCKER, L_ASTATE, L_ASTATE2
		L_AAP = RESULT
		L_AHP = RESULT:1
		L_ASP_STATE = RESULTS
		
		IF STRFIND(L_ASP_STATE, "先制") >= 0
			L_ASPEED = 1
		ELSEIF STRFIND(L_ASP_STATE, "後攻") >= 0
			L_ASPEED = -1
		ENDIF
		IF STRFIND(L_ASP_STATE, "飛行") >= 0
			L_AFLY = 1
		ELSEIF STRFIND(L_ASP_STATE, "歩行") >= 0
			L_AFLY = 0
		ENDIF
		SIF STRFIND(L_ASP_STATE, "速低") >= 0
			L_ASPEED -= 1
		
		IF STRFIND(L_AG_STATE, "先制") >= 0
			L_ASPEED = 1
		ELSEIF STRFIND(L_AG_STATE, "後攻") >= 0
			L_ASPEED = -1
		ENDIF
		IF STRFIND(L_AG_STATE, "飛行") >= 0
			L_AFLY = 1
		ELSEIF STRFIND(L_AG_STATE, "歩行") >= 0
			L_AFLY = 0
		ENDIF
		SIF STRFIND(L_AG_STATE, "速低") >= 0
			L_ASPEED -= 1
	
		L_BSPEED = AI_SPEED_GET(L_BLOCKER, 1)
		L_BFLY = AI_FLY_GET(L_BLOCKER, 1)
		RESULTS =
		CALL CB_BATTLE_APHP_GET, L_BLOCKER, L_COUNT / 2, 1, L_ATTACKER, L_BSTATE, L_BSTATE2
		L_BAP = RESULT
		L_BHP = RESULT:1
		L_BSP_STATE = RESULTS
		
		IF STRFIND(L_BSP_STATE, "先制") >= 0
			L_ASPEED = 1
		ELSEIF STRFIND(L_BSP_STATE, "後攻") >= 0
			L_ASPEED = -1
		ENDIF
		IF STRFIND(L_BSP_STATE, "飛行") >= 0
			L_AFLY = 1
		ELSEIF STRFIND(L_BSP_STATE, "歩行") >= 0
			L_AFLY = 0
		ENDIF
		SIF STRFIND(L_BSP_STATE, "速低") >= 0
			L_ASPEED -= 1
		
		IF STRFIND(L_BG_STATE, "先制") >= 0
			L_BSPEED = 1
		ELSEIF STRFIND(L_BG_STATE, "後攻") >= 0
			L_BSPEED = -1
		ENDIF
		IF STRFIND(L_BG_STATE, "飛行") >= 0
			L_BFLY = 1
		ELSEIF STRFIND(L_BG_STATE, "歩行") >= 0
			L_BFLY = 0
		ENDIF
		SIF STRFIND(L_BG_STATE, "速低") >= 0
			L_BSPEED -= 1
		
		LOCAL:2 = (FIELD_DEMON_DATE_V:L_ATTACKER:CBV_B_AP + FIELD_DEMON_DATE_V:L_ATTACKER:CBV_B_HP) - (FIELD_DEMON_DATE_V:L_BLOCKER:CBV_B_AP + FIELD_DEMON_DATE_V:L_BLOCKER:CBV_B_HP)
		
		IF CS_BLOCK_BATTLE_CHECK(L_BLOCKER, L_ATTACKER, L_BFLY, L_AFLY) && STRFIND(L_AG_STATE + L_ASP_STATE, "通過") < 0
			;PRINTFORML %FIELD_DEMON_DATE_S:L_COUNT:CBS_NAME% AAP {L_AAP}　AHP {L_AHP}　ASPEED {L_ASPEED}　　%FIELD_DEMON_DATE_S:L_BLOCKER:CBS_NAME% BAP {L_BAP}　BHP {L_BHP}　BSPEED {L_BSPEED}
		
			IF CB_SP_SPEED_VIE(L_ATTACKER, L_BLOCKER, L_ASPEED, L_BSPEED) > 0 && STRFIND(L_BG_STATE + L_BG_STATE, "先無") < 0
				IF L_BATTLE == 0
					;アタッカーが有利だと少なく
					IF L_BHP <= L_AAP
						LOCAL:3 = 10
					ELSEIF L_AHP <= L_BAP
						LOCAL:3 = 40
					ELSE
						LOCAL:3 = 20
					ENDIF
				ELSE
					IF L_BHP <= L_AAP
						LOCAL:3 = 40
					ELSEIF L_AHP <= L_BAP
						LOCAL:3 = 10
					ELSE
						LOCAL:3 = 20
					ENDIF
				ENDIF
			ELSEIF CB_SP_SPEED_VIE(L_ATTACKER, L_BLOCKER, L_ASPEED, L_BSPEED) < 0 && STRFIND(L_AG_STATE + L_ASP_STATE, "先無") < 0
				IF L_BATTLE == 0
					;アタッカーが有利だと少なく
					IF L_AHP <= L_BAP
						LOCAL:3 = 40
					ELSEIF L_BHP <= L_AAP
						LOCAL:3 = 10
					ELSE
						LOCAL:3 = 20
					ENDIF
				ELSE
					IF L_AHP <= L_BAP
						LOCAL:3 = 10
					ELSEIF L_BHP <= L_AAP
						LOCAL:3 = 40
					ELSE
						LOCAL:3 = 20
					ENDIF
				ENDIF
			ELSEIF CB_SP_SPEED_VIE(L_ATTACKER, L_BLOCKER, L_ASPEED, L_BSPEED) == 0
				;PRINTFORML %FIELD_DEMON_DATE_S:L_COUNT:CBS_NAME% AAP {L_AAP}　AHP {L_AHP}　ASPEED {L_ASPEED}　　%FIELD_DEMON_DATE_S:LOCAL:CBS_NAME% BAP {L_BAP}　BHP {L_BHP}　BSPEED {L_BSPEED}
				IF L_BATTLE == 0
					;アタッカーが有利だと少なく
					IF L_AHP <= L_BAP && L_BHP <= L_AAP
						IF LOCAL:2 > 2
							LOCAL:3 = 38
						ELSEIF LOCAL:2 < -2
							LOCAL:3 = 33
						ELSE
							LOCAL:3 = 35
						ENDIF
					ELSEIF L_AHP <= L_BAP
						LOCAL:3 = 40
					ELSEIF L_BHP <= L_AAP
						LOCAL:3 = 10
					ELSE
						LOCAL:3 = 20
					ENDIF
				ELSE
					IF L_AHP <= L_BAP && L_BHP <= L_AAP
						IF LOCAL:2 > 2
							LOCAL:3 = 33
						ELSEIF LOCAL:2 < -2
							LOCAL:3 = 38
						ELSE
							LOCAL:3 = 35
						ENDIF
					ELSEIF L_AHP <= L_BAP
						LOCAL:3 = 10
					ELSEIF L_BHP <= L_AAP
						LOCAL:3 = 40
					ELSE
						LOCAL:3 = 20
					ENDIF
				ENDIF
			ENDIF
			;PRINTFORML {LOCAL:3}
		ELSE
			IF L_BATTLE == 0
				;アタッカーが有利だと少なく
				LOCAL:3 = 5
			ELSE
				LOCAL:3 = 50
			ENDIF
		ENDIF
		L_LUCRATIVE_P:L_COUNT = LOCAL:3
	ELSE
		IF L_BATTLE == 0
			;アタッカーが有利だと少なく
			L_LUCRATIVE_P:L_COUNT = 0
		ELSE
			L_LUCRATIVE_P:L_COUNT = 5
		ENDIF
	ENDIF
NEXT

RESULTS =

RETURN L_LUCRATIVE_P:0, L_LUCRATIVE_P:1, L_LUCRATIVE_P:2, L_LUCRATIVE_P:3

;アタック、ブロック危険度算出END


;ｓｐタイプチェック kokokokokokoko
@CBAI_SPTYPE_CHECK, L_ARG_NUM, ARG = -1, ARG:1 = -1, ARG:2 = -1, ARG:3 = -1, ARG:4 = -1, ARG:5 = -1
#DIM L_ARG_NUM
#DIM L_COUNT

LOCAL:1 = 0
LOCAL:2 = 0
LOCAL:3 = 0
LOCAL:4 = 0
FOR L_COUNT, 0, DECK_CARDS(CS1_OPPONENT)
	CALL CARD_DATA_GET, SUMMONER_HAND_CARDS:CS1_OPPONENT:L_COUNT
	IF CARD_DATE_V:CBV_KINDS >= 100
		TRYCCALLFORM CGSP_TYPE_{CARD_DATE_V:CBV_SP1}, CARD_DATE_S:CBS_SP1_SUB, -1
			FOR LOCAL, 0, L_ARG_NUM
				IF RESULT:LOCAL == ARG:LOCAL
					SIF LOCAL == L_ARG_NUM - 1
						SETBIT LOCAL:1, L_COUNT
				ELSE
					CONTINUE
				ENDIF
			NEXT
		CATCH
		ENDCATCH
	ENDIF
NEXT
FOR L_COUNT, 6, 12
	IF CS_SP_USE_CHECK(L_COUNT)
		TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
			FOR LOCAL, 0, L_ARG_NUM
				IF RESULT:LOCAL == ARG:LOCAL
					IF LOCAL == L_ARG_NUM - 1
						SETBIT LOCAL:2, L_COUNT
						CALLFORM CGSP_ACTION_AFTER_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
						SIF RESULT > 1
							SETBIT LOCAL:2, L_COUNT - 6
					ENDIF
				ELSE
					CONTINUE
				ENDIF
			NEXT
		CATCH
		ENDCATCH
	ENDIF
NEXT
RETURN LOCAL:1, LOCAL:2

;AI_BRAIN_OFFERING 元
;ARG 供物数
;1 使う供物の価値
;2 除外するやつ(ビット ONを除外)
;ARGS 供物の種類(文字列)
@AICB_OFFERING_SEARCH, AI_BRAIN_OFFERING, ARG, ARG:1, ARG:2, ARGS = "ALL"
#DIM REF AI_BRAIN_OFFERING, 0, 0
#DIM L_HAND
#DIM L_OFFE
#DIM L_OK
#DIM L_WORTH

VARSET LOCAL, -1

FOR L_OFFE, 0, ARG
	L_WORTH = ARG:1
	FOR L_HAND, 0, HAND_CARDS(CS1_OPPONENT)
		SIF GETBIT(ARG:2, L_HAND)
			CONTINUE
		SIF AI_BRAIN_OFFERING:L_HAND:20 >= L_WORTH
			CONTINUE
		L_OK = 0
		IF ARGS == "ALL" || ARGS == ""
			L_OK = 1
		ELSE
			IF STRFIND(ARGS, "アイテム") >= 0
				IF AI_BRAIN_OFFERING:L_HAND:CBV_KINDS >= 100
					L_OK = 1
				ELSEIF STRFIND(ARGS, "AND") >= 0
					CONTINUE
				ENDIF
			ENDIF
			IF STRFIND(ARGS, "ライト仲魔") >= 0
				IF AI_BRAIN_OFFERING:L_HAND:CBV_KINDS > 10 && AI_BRAIN_OFFERING:L_HAND:CBV_KINDS / 10 == 1
					L_OK = 1
				ELSEIF STRFIND(ARGS, "AND") >= 0
					CONTINUE
				ENDIF
			ENDIF
			IF STRFIND(ARGS, "ダーク仲魔") >= 0
				IF AI_BRAIN_OFFERING:L_HAND:CBV_KINDS > 10 && AI_BRAIN_OFFERING:L_HAND:CBV_KINDS / 10 == 3
					L_OK = 1
				ELSEIF STRFIND(ARGS, "AND") >= 0
					CONTINUE
				ENDIF
			ENDIF
		ENDIF
		SIF L_OK == 0
			CONTINUE
		L_WORTH = AI_BRAIN_OFFERING:L_HAND:20
		LOCAL:L_OFFE = L_HAND
	NEXT
	SIF LOCAL:L_OFFE < 0
		BREAK
	SIF LOCAL:L_OFFE > -1
		SETBIT ARG:2, L_HAND
NEXT
FOR L_OFFE, 0, ARG
	RESULT:L_OFFE = LOCAL:L_OFFE
NEXT
RETURN LOCAL:0

;自軍除去の挙動
;AI_BRAIN_P　元
;使用できるMAG
;召喚する仲魔の戦闘力
@AICB_OWN_DEMON_REMOVAL, AI_BRAIN_P, ARG, ARG:1
#DIM REF AI_BRAIN_P, 0, 0
#DIM AI_BRAIN, 50, 40
#DIMS AI_BRAINS, 50, 30
#DIM AI_BRAIN_SORT, 50
#DIM L_COUNT
VARSET AI_BRAIN

LOCAL = 0
FOR L_COUNT, 6, 12
	RESULTS =
	IF CS_SP_USE_CHECK(L_COUNT)
		TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
			IF RESULT == 50 ;除去系
				AI_BRAIN:LOCAL:9 = RESULT ;タイプ

				AI_BRAIN:LOCAL:0 = L_COUNT ;場所
				AI_BRAIN:LOCAL:1 = RESULT:1 ;誰が1自分　2他人　3両方
				CALLFORM CGSP_COST_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
				AI_BRAIN:LOCAL:3 = RESULT ;コスト
				CALLFORM CGSP_ACTION_AFTER_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
				AI_BRAIN:LOCAL:4 = RESULT ;技使用後
				SIF AI_BRAIN:LOCAL:1 == 1
					AI_BRAIN:LOCAL:4 = 0 ;技使用後
				CALLFORM CGSP_TARGET_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
				AI_BRAIN:LOCAL:5 = RESULT ;範囲2
				
				AI_BRAIN:LOCAL:11 = AI_BRAIN_P:(L_COUNT - 6):1
				AI_BRAIN:LOCAL:12 = AI_BRAIN_P:(L_COUNT - 6):2
				AI_BRAIN:LOCAL:13 = AI_BRAIN_P:(L_COUNT - 6):3
				AI_BRAIN:LOCAL:14 = AI_BRAIN_P:(L_COUNT - 6):4
				AI_BRAIN:LOCAL:15 = AI_BRAIN_P:(L_COUNT - 6):5

				AI_BRAIN:LOCAL:30 = AI_BRAIN_P:(L_COUNT - 6):20
				
				;PRINTFORML 場所{AI_BRAIN:LOCAL:0}　%FIELD_DEMON_DATE_S:(AI_BRAIN:LOCAL:0):CBS_NAME%
				
				LOCAL ++
			ENDIF
		CATCH
		ENDCATCH
	ENDIF
NEXT
LOCAL:10 = LOCAL ;스킬수
LOCAL:11 = ARG:1 ;戦闘力
LOCAL:12 = -1 ;ユニット
LOCAL:13 = 0 ;誰に使うか
LOCAL:14 = 20 ;本人の代償
FOR L_COUNT, 0, LOCAL:10
	IF AI_BRAIN:L_COUNT:9 == 50 && AI_BRAIN:LOCAL:1 == 1 && AI_BRAIN:L_COUNT:3 > ARG && AI_BRAIN:L_COUNT:20 < LOCAL:11 && LOCAL:13 < 2
		LOCAL:11 = AI_BRAIN:L_COUNT:30
		LOCAL:12 = AI_BRAIN:L_COUNT:0
		LOCAL:13 = AI_BRAIN:L_COUNT:1
		LOCAL:14 = 0
	ELSEIF AI_BRAIN:L_COUNT:9 == 50 && AI_BRAIN:LOCAL:1 == 2 && AI_BRAIN:L_COUNT:3 > ARG && AI_BRAIN:L_COUNT:4 == 0
		LOCAL:11 = AI_BRAIN:L_COUNT:30
		LOCAL:12 = AI_BRAIN:L_COUNT:0
		LOCAL:13 = AI_BRAIN:L_COUNT:1
		LOCAL:14 = AI_BRAIN:L_COUNT:4
	ELSEIF AI_BRAIN:L_COUNT:9 == 50 && AI_BRAIN:LOCAL:1 == 2 && AI_BRAIN:L_COUNT:3 > ARG && AI_BRAIN:L_COUNT:4 < LOCAL:14
		LOCAL:11 = AI_BRAIN:L_COUNT:30
		LOCAL:12 = AI_BRAIN:L_COUNT:0
		LOCAL:13 = AI_BRAIN:L_COUNT:1
		LOCAL:14 = AI_BRAIN:L_COUNT:4
	ENDIF
NEXT
IF LOCAL:13 == 1
	CALL CB_AI_SET, 1500 + LOCAL:12
	RETURN 1
ELSEIF LOCAL:13 == 2 || LOCAL:13 == 3
	LOCAL:11 = ARG:1 ;戦闘力
	LOCAL:14 = -1 ;ユニット
	FOR LOCAL, 0, 6
		IF AI_BRAIN:LOCAL:20 < LOCAL:11
			LOCAL:11 = AI_BRAIN:LOCAL:20
			LOCAL:14 = LOCAL
		ENDIF
	NEXT
	IF LOCAL:14 > -1
		CALL CB_AI_SET, 1500 + LOCAL:12
		CALL CB_AI_SET, 100 + LOCAL:14
		RETURN 1
	ENDIF
ENDIF
;ここに自爆　

LOCAL = 0
FOR L_COUNT, 6, 12
	SIF AI_BRAIN_P:(L_COUNT - 6):20 >= ARG:1
		CONTINUE
	RESULTS =
	IF CS_SP_USE_CHECK(L_COUNT)
		TRYCCALLFORM CGSP_ACTION_AFTER_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
			IF RESULT == 2 || RESULT == 3;除去系

				TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
					IF RESULT == 1
						AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ
						
						AI_BRAIN:LOCAL:1 = RESULT:1 ;威力
						AI_BRAIN:LOCAL:2 = RESULT:2 ;範囲
						AI_BRAINS:LOCAL:0 = %SUBSTRING(RESULTS:0, 0, STRFIND(RESULTS:0, "供物"))% ;備考
						
					ELSEIF RESULT == 30
						AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ(회복)
						
						AI_BRAIN:LOCAL:1 = RESULT:1 ;回復量
						AI_BRAIN:LOCAL:2 = 0
						AI_BRAIN:LOCAL:3 = 0
						AI_BRAINS:LOCAL:0  = RESULTS ;備考
					ELSEIF RESULT == 40
						AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ(カードドロー)
						
						AI_BRAIN:LOCAL:1 = RESULT:1 ;枚数
						AI_BRAIN:LOCAL:2 = 0
						AI_BRAIN:LOCAL:3 = 0
						AI_BRAINS:LOCAL:0  = RESULTS ;備考
					ELSEIF RESULT == 41
						AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ(MAG獲得)
						
						AI_BRAIN:LOCAL:1 = RESULT:1 ;獲得量
						AI_BRAIN:LOCAL:2 = 0
						AI_BRAIN:LOCAL:3 = 0
						AI_BRAINS:LOCAL:0  = RESULTS ;備考
					ENDIF
					IF AI_BRAIN:LOCAL:9 > 0
						AI_BRAIN:LOCAL:0 = L_COUNT ;場所

						CALLFORM CGSP_COST_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
						AI_BRAIN:LOCAL:4 = RESULT ;コスト
						CALLFORM CGSP_ACTION_AFTER_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
						AI_BRAIN:LOCAL:5 = RESULT ;技使用後
						CALLFORM CGSP_TARGET_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
						AI_BRAIN:LOCAL:6 = RESULT ;範囲2
						
						AI_BRAIN:LOCAL:10 = AI_BRAIN_P:(L_COUNT - 6):0
						AI_BRAIN:LOCAL:11 = AI_BRAIN_P:(L_COUNT - 6):1
						AI_BRAIN:LOCAL:12 = AI_BRAIN_P:(L_COUNT - 6):2
						AI_BRAIN:LOCAL:13 = AI_BRAIN_P:(L_COUNT - 6):3
						AI_BRAIN:LOCAL:14 = AI_BRAIN_P:(L_COUNT - 6):4
						AI_BRAIN:LOCAL:15 = AI_BRAIN_P:(L_COUNT - 6):5
						AI_BRAIN:LOCAL:16 = AI_BRAIN_P:(L_COUNT - 6):6
						AI_BRAIN:LOCAL:17 = AI_BRAIN_P:(L_COUNT - 6):7

						AI_BRAIN:LOCAL:30 = AI_BRAIN_P:(L_COUNT - 6):20
						AI_BRAIN:LOCAL:31 = AI_BRAIN_P:(L_COUNT - 6):21
						
						;PRINTFORML 場所{AI_BRAIN:LOCAL:0}　%FIELD_DEMON_DATE_S:(AI_BRAIN:LOCAL:0):CBS_NAME%
						
						LOCAL ++
					ENDIF
				CATCH
				ENDCATCH
			ENDIF
		CATCH
		ENDCATCH
	ENDIF
NEXT

LOCAL:10 = LOCAL ;스킬수
LOCAL:11 = ARG:1 ;戦闘力
LOCAL:12 = -1 ;ユニット
LOCAL:13 = 0 ;タイプ
FOR L_COUNT, 0, LOCAL:10
	SIF ARG < AI_BRAIN:LOCAL:4
		CONTINUE
	IF AI_BRAIN:L_COUNT:20 < LOCAL:11
		IF AI_BRAIN:L_COUNT:9 == 1 && (AI_BRAIN:L_COUNT:6 == 4 || AI_BRAIN:L_COUNT:6 == 6)
			LOCAL:11 = AI_BRAIN:L_COUNT:30
			LOCAL:12 = AI_BRAIN:L_COUNT:0
			LOCAL:13 = AI_BRAIN:L_COUNT:9
		ELSEIF AI_BRAIN:L_COUNT:9 == 30 || AI_BRAIN:L_COUNT:9 == 40 || AI_BRAIN:L_COUNT:9 == 41
			LOCAL:11 = AI_BRAIN:L_COUNT:30
			LOCAL:12 = AI_BRAIN:L_COUNT:0
			LOCAL:13 = AI_BRAIN:L_COUNT:9
		ENDIF
	ENDIF
NEXT
IF LOCAL:12 > -1
	CALL CB_AI_SET, 1500 + LOCAL:12
	SIF LOCAL:13 == 1
		CALL CB_AI_SET, 120
	RETURN 1
ENDIF









RETURN 0




;ダメージSPの増減処理
;0	食らう人
;1	術者
;2	元ダメージ
@CBAI_SP_DAMAGE, ARG, ARG:1, L_DAMEGE, ARGS
#DIM L_DAMEGE
#DIM L_COUNT

SIF STR_AFT_TOINT(ARGS, "ロウ") == 1 && FIELD_DEMON_DATE_V:ARG:CBV_KINDS % 10 == 1 && FIELD_DEMON_DATE_V:ARG:CBV_KINDS > 10
	L_DAMEGE += RESULT:1
SIF STR_AFT_TOINT(ARGS, "カオス") == 1 && FIELD_DEMON_DATE_V:ARG:CBV_KINDS % 10 == 3 && FIELD_DEMON_DATE_V:ARG:CBV_KINDS > 10
	L_DAMEGE += RESULT:1
SIF STR_AFT_TOINT(ARGS, "ライト") == 1 && FIELD_DEMON_DATE_V:ARG:CBV_KINDS / 10 == 1 && FIELD_DEMON_DATE_V:ARG:CBV_KINDS > 10
	L_DAMEGE += RESULT:1
SIF STR_AFT_TOINT(ARGS, "ダーク") == 1 && FIELD_DEMON_DATE_V:ARG:CBV_KINDS / 10 == 3 && FIELD_DEMON_DATE_V:ARG:CBV_KINDS > 10
	L_DAMEGE += RESULT:1
IF STR_AFT_TOINT(ARGS, "弱者") == 1
	PRINTFORML {FIELD_DEMON_DATE_V:ARG:CBV_B_AP + FIELD_DEMON_DATE_V:ARG:CBV_B_HP}
	SIF (FIELD_DEMON_DATE_V:ARG:CBV_B_AP + FIELD_DEMON_DATE_V:ARG:CBV_B_HP) < 5
		L_DAMEGE += RESULT:1
ENDIF
SIF STR_AFT_TOINT(ARGS, "飛OR速") == 1 && (FIELD_DEMON_DATE_V:ARG:CBV_FLYING > 0 || FIELD_DEMON_DATE_V:ARG:CBV_SPEED > 0)
	L_DAMEGE += RESULT:1
SIF STR_AFT_TOINT(ARGS, "飛行") == 1 && FIELD_DEMON_DATE_V:ARG:CBV_FLYING > 0
	L_DAMEGE += RESULT:1
TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:ARG:CBV_SP1}, FIELD_DEMON_DATE_S:ARG:CBS_SP1_SUB, ARG
	SIF STR_AFT_TOINT(ARGS, "ダメSP") == 1
		L_DAMEGE += RESULT:1
CATCH
ENDCATCH
IF 0 <= ARG && ARG < 12 && STR_AFT_TOINT(ARGS, "高ＨＰ") == 1
	LOCAL = (ARG / 6) * 6
	LOCAL:2 = RESULT:1
	{
	LOCAL:1 = MAX(
	FIELD_DEMON_DATE_V:(LOCAL + 0):CBV_HP, FIELD_DEMON_DATE_V:(LOCAL + 1):CBV_HP,
	FIELD_DEMON_DATE_V:(LOCAL + 2):CBV_HP, FIELD_DEMON_DATE_V:(LOCAL + 3):CBV_HP,
	FIELD_DEMON_DATE_V:(LOCAL + 4):CBV_HP, FIELD_DEMON_DATE_V:(LOCAL + 5):CBV_HP)
	}
	SIF FIELD_DEMON_DATE_V:ARG:CBV_HP >= LOCAL:1
		L_DAMEGE += LOCAL:2
ENDIF
IF 0 <= ARG && ARG < 12 && STR_AFT_TOINT(ARGS, "味方存在数") == 1
	LOCAL = (ARG:1 / 6)
	LOCAL:2 = RESULT:1
	FOR L_COUNT, LOCAL, LOCAL + 6
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1 || GETBIT(FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION, 2)
			CONTINUE
        L_DAMEGE += LOCAL:2
	NEXT
ENDIF

CALL SP_DAMAGE, ARG, L_DAMEGE, ARG:1, 1
L_DAMEGE = RESULT

RETURN MAX(0, L_DAMEGE)

;確率状態付与のSPの増減処理
;0	食らう人
;1	術者
;2	元ダメージ
@CBAI_SP_SUCCESS, ARG, ARG:1, L_SUCCESS, ARGS
#DIM L_SUCCESS

SIF STR_AFT_TOINT(ARGS, "低HP") == 1 && FIELD_DEMON_DATE_V:ARG:CBV_HP < FIELD_DEMON_DATE_V:(ARG:1):CBV_HP
	L_SUCCESS += RESULT:1
SIF STR_AFT_TOINT(ARGS, "飛行") == 1 && FIELD_DEMON_DATE_V:ARG:CBV_FLYING > 0
	L_SUCCESS += RESULT:1
	
SIF STATE_INFO_GET_F(ARG, 113) > 0 && LOCAL:2 > 0
	L_SUCCESS += RESULT:3
SIF STATE_INFO_GET_F(ARG, 12) > 0 && LOCAL:2 > 0
	L_SUCCESS -= RESULT:3
	
RETURN MAX(0, L_SUCCESS)

@STR_AFT_TOINT, ARGS, ARGS:1
#FUNCTION
	;PRINTFORM %ARGS%
WHILE STRLENS(ARGS) > 0
	SIF STRFIND(ARGS, ARGS:1) < 0
		RETURNF 0
	LOCAL:1 = STRLENS(ARGS:1) + STRFIND(ARGS, ARGS:1)
		;PRINTFORM {LOCAL:1}
	LOCAL = LOCAL:1
	LOCALS =
	LOCAL:2 = 1
	WHILE LOCAL:2 == 1
		LOCALS:1 = %SUBSTRING(ARGS, LOCAL, 1)%
		;SIF STRLENS(LOCALS:1) < 1
		;	BREAK
		;PRINTFORM %LOCALS:1%
		IF (LOCALS:1 == "+" || LOCALS:1 == "-") && LOCAL == LOCAL:1
			LOCALS += LOCALS:1
		ELSEIF LOCALS:1 == "0"
			LOCALS += LOCALS:1
		ELSEIF 0 < TOINT(LOCALS:1) && TOINT(LOCALS:1) < 10
			LOCALS += LOCALS:1
		;ELSEIF ((LOCALS == "+" || LOCALS == "-") && LOCAL + 1 == LOCAL:1) || LOCAL == LOCAL:1
		;	ARGS = %SUBSTRING(ARGS, LOCAL:1 , -1)%
		;	CONTINUE
		ELSE
			LOCAL:2 = 0
		ENDIF
		LOCAL++
	WEND
	SIF STRLENS(LOCALS) < 1
		RETURNF 0
	RESULT:1 = TOINT(LOCALS)
	RETURNF 1
WEND
RETURNF 0


@CB_HAVE_SP, ARG, ARG:1
#FUNCTION
SIF FIELD_DEMON_DATE_V:ARG:CBV_SP1 == ARG:1
	RETURNF 1
SIF FIELD_DEMON_DATE_V:ARG:CBV_SP2 == ARG:1
	RETURNF 2
RETURNF 0

;ビットのON又はOFF数
;0-調べる数値
;1-はじめ
;2-終わり
;3-マイナスでOFFの数を調べる
@BIT_SUM, ARG, ARG:1 = 0, ARG:2 = 63, ARG:3 = 0
#FUNCTION
ARG:1 = MAX(ARG:1, 0)
ARG:2 = MIN(ARG:2, 63)
;SIF ARG:1 > ARG:2
;	RETURNF -1
LOCAL:1 = 0
FOR LOCAL, ARG:1, ARG:2 + 1
	IF GETBIT(ARG, LOCAL) && ARG:3 >= 0
		LOCAL:1 ++
	ELSEIF !GETBIT(ARG, LOCAL) && ARG:3 < 0
		LOCAL:1 ++
	ENDIF
NEXT
RETURNF LOCAL:1

@SUBSTRING_T, ARGS, ARG = 0, ARG:1 = -1
#FUNCTIONS

SIF ARG:1 < 1
	RETURNF SUBSTRING(ARGS, ARG)

;SIF ARG:1 > ARG:2
;	RETURNF -1
LOCALS:1 = %SUBSTRING(ARGS, ARG)%
LOCALS =
LOCAL = 0
DO
	LOCALS += SUBSTRINGU(LOCALS:1, LOCAL, 1)
	LOCAL ++
LOOP STRLENS(SUBSTRINGU(LOCALS:1, LOCAL, 1)) > 0 && STRLENS(LOCALS) < ARG:1
RETURNF LOCALS

;L_ACTION-ビット演算
;　　　0-攻撃側PUSP使用
;　　　1-防御側PUSP使用
;　　　2-状態剥がし

;返り値　戦いの結果、通した際のサマナーへのダメージ
;攻撃側　5-ブロックされず通す　10-相手を一方的にやれる　20-お互いに生き残る　
;　　　　32-各上と相打　35-同格と相打ち　37-格下と相打ち　40-一方的にやられる　50-攻撃できない
;　　　　
;防御側の場合逆になる
;　　　　5-ブロックできない　10-一方的にやられる　20-お互いに生き残る　
;　　　　32-格下と相打　35-同格と相打ち　37-格上と相打ち　40-一方的にやれる　50-バトルができない
@CB_AI戦闘結果GET, L_OFFENSE, L_DEFENSE, L_ACTION, L_TIME
#DIM L_TIME		;経過時間
#DIM L_ACTION

#DIM L_OFFENSE
#DIM L_A_AP
#DIM L_A_HP
#DIM L_A_SPEED
#DIM L_A_位置
#DIM L_A_アタック耐性

#DIM L_A_SPEED_I
#DIM L_A_SUMMONER_D


#DIM L_DEFENSE
#DIM L_D_AP
#DIM L_D_HP
#DIM L_D_SPEED
#DIM L_D_位置
#DIM L_D_アタック耐性

#DIM L_D_SPEED_I
#DIM L_D_SUMMONER_D


#DIM L_FAST = -1
#DIM L_F_AP
#DIM L_F_HP
#DIM L_F_SPEED
#DIM L_F_位置
#DIM L_F_アタック耐性

#DIM L_F_SPEED_I
#DIM L_F_SUMMONER_D = 0


#DIM L_LATE = -1
#DIM L_L_AP
#DIM L_L_HP
#DIM L_L_SPEED
#DIM L_L_位置
#DIM L_L_アタック耐性

#DIM L_L_SPEED_I
#DIM L_L_SUMMONER_D = 0


#DIM L_ACT = 0
#DIM L_貫通 = 0

L_FAST = -1
L_LATE = -1
;SPEED_I　ビット
;0~3	속도
;4		先制無視
;5		対空
;
;20		관통
;
;30		HP上昇封
;
;40		必殺の構え

SIF GETBIT(L_ACTION,2)
	SETBIT L_ACT, 1

SIF GETBIT(L_ACTION,0)
	SETBIT L_ACT, 0
CALL CB_AI戦闘能力GET, L_OFFENSE, 0, L_ACT, L_TIME
L_A_AP = RESULT
L_A_HP = RESULT:1
L_A_SPEED_I = RESULT:2
L_A_SPEED = L_A_SPEED_I % 8
L_A_位置 = RESULT:3
L_A_アタック耐性 = RESULT:4
L_A_SUMMONER_D = RESULT:5


A:(L_OFFENSE * 20 + 0 + (L_ACT > 0) * 10) = L_A_AP
A:(L_OFFENSE * 20 + 1 + (L_ACT > 0) * 10) = L_A_HP
A:(L_OFFENSE * 20 + 2 + (L_ACT > 0) * 10) = L_A_SPEED
A:(L_OFFENSE * 20 + 3 + (L_ACT > 0) * 10) = L_A_位置

CALL CB_AI戦闘能力GET, L_DEFENSE, 1, L_ACT, L_TIME
L_D_AP = RESULT
L_D_HP = RESULT:1
L_D_SPEED_I = RESULT:2
L_D_SPEED = L_D_SPEED_I % 8
L_D_位置 = RESULT:3
L_D_アタック耐性 = RESULT:4
L_D_SUMMONER_D = L_A_AP

B:(L_DEFENSE * 20 + 0 + (L_ACT > 0) * 10) = L_D_AP
B:(L_DEFENSE * 20 + 1 + (L_ACT > 0) * 10) = L_D_HP
B:(L_DEFENSE * 20 + 2 + (L_ACT > 0) * 10) = L_D_SPEED
B:(L_DEFENSE * 20 + 3 + (L_ACT > 0) * 10) = L_D_位置

IF GETBIT(L_ACTION,1)
	SETBIT L_ACT, 0
ELSE
	CLEARBIT L_ACT, 0
ENDIF
SIF L_A_位置 < 0
	RETURN 50, L_A_SUMMONER_D, 0
SIF FIELD_DEMON_DATE_V:L_DEFENSE:CBV_NO == 0
	RETURN 5, L_A_SUMMONER_D, L_A_SUMMONER_D




SIF !GETBIT(L_D_位置, L_A_位置)
	RETURN 5, L_A_SUMMONER_D, L_A_SUMMONER_D

;アタック側　速さ変更
IF GETBIT(L_D_位置, 4) && !GETBIT(L_D_位置, 2)
	SIF GETBIT(L_A_SPEED_I, 5)
		L_A_SPEED = 5
ENDIF

;ブロック側　速さ変更
IF L_A_位置 == 4
	SIF GETBIT(L_D_SPEED_I, 5)
		L_D_SPEED = 5
ENDIF

;アタック側　特殊状態によるパラメータ変更
IF !GETBIT(L_ACTION,2)
	IF L_A_SPEED < L_D_SPEED && STATE_INFO_GET_F(L_OFFENSE, 2003) > 0 && RESULT:1 > L_TIME
		LOCAL:2 = RESULT:3
		
		LOCAL:3 = LOCAL:2 % 1000000 / 1000
		IF LOCAL > 100
			L_A_AP -= LOCAL:3 % 100
		ELSE
			L_A_AP += LOCAL:3 % 100
		ENDIF
		
		LOCAL:3 = LOCAL:2 % 1000
		IF LOCAL > 100
			L_A_HP -= LOCAL:3 % 100
		ELSE
			SIF !GETBIT(L_A_SPEED_I, 30)
				L_A_HP += LOCAL:3 % 100
		ENDIF
	ENDIF
	{
	IF SUMMONER_PARAMETER:(FIELD_DEMON_DATE_V:L_OFFENSE:CBV_HOST):CSP2_HP
	 < SUMMONER_PARAMETER:(FIELD_DEMON_DATE_V:L_DEFENSE:CBV_HOST):CSP2_HP
	&& STATE_INFO_GET_F(L_OFFENSE, 2004) > 0 && RESULT:1 > L_TIME
	}
		LOCAL:2 = RESULT:3
		
		LOCAL:3 = LOCAL:2 % 1000000 / 1000
		IF LOCAL > 100
			L_A_AP -= LOCAL:3 % 100
		ELSE
			L_A_AP += LOCAL:3 % 100
		ENDIF
		
		LOCAL:3 = LOCAL:2 % 1000
		IF LOCAL > 100
			L_A_HP -= LOCAL:3 % 100
		ELSE
			SIF !GETBIT(L_A_SPEED_I, 30)
				L_A_HP += LOCAL:3 % 100
		ENDIF
	ENDIF
	{
	IF (FIELD_DEMON_DATE_V:L_OFFENSE:CBV_B_AP + FIELD_DEMON_DATE_V:L_OFFENSE:CBV_B_HP)
	 < (FIELD_DEMON_DATE_V:L_DEFENSE:CBV_B_AP + FIELD_DEMON_DATE_V:L_DEFENSE:CBV_B_HP)
	&& STATE_INFO_GET_F(L_OFFENSE, 2005) > 0 && RESULT:1 > L_TIME
	}
		LOCAL:2 = RESULT:3
		
		LOCAL:3 = LOCAL:2 % 1000000 / 1000
		IF LOCAL > 100
			L_A_AP -= LOCAL:3 % 100
		ELSE
			L_A_AP += LOCAL:3 % 100
		ENDIF
		
		LOCAL:3 = LOCAL:2 % 1000
		IF LOCAL > 100
			L_A_HP -= LOCAL:3 % 100
		ELSE
			SIF !GETBIT(L_A_SPEED_I, 30)
				L_A_HP += LOCAL:3 % 100
		ENDIF
	ENDIF
ENDIF

;ブロック側　特殊状態によるパラメータ変更
IF !GETBIT(L_ACTION,2)
	IF L_D_SPEED < L_A_SPEED && STATE_INFO_GET_F(L_DEFENSE, 2003) > 0 && RESULT:1 > L_TIME
		LOCAL:2 = RESULT:3
		
		LOCAL:3 = LOCAL:2 % 1000000 / 1000
		IF LOCAL > 100
			L_D_AP -= LOCAL:3 % 100
		ELSE
			L_D_AP += LOCAL:3 % 100
		ENDIF
		
		LOCAL:3 = LOCAL:2 % 1000
		IF LOCAL > 100
			L_D_HP -= LOCAL:3 % 100
		ELSE
			SIF !GETBIT(L_D_SPEED_I, 30)
				L_D_HP += LOCAL:3 % 100
		ENDIF
	ENDIF
	{
	IF SUMMONER_PARAMETER:(FIELD_DEMON_DATE_V:L_DEFENSE:CBV_HOST):CSP2_HP
	 < SUMMONER_PARAMETER:(FIELD_DEMON_DATE_V:L_OFFENSE:CBV_HOST):CSP2_HP
	&& STATE_INFO_GET_F(L_DEFENSE, 2004) > 0 && RESULT:1 > L_TIME
	}
		LOCAL:2 = RESULT:3
		
		LOCAL:3 = LOCAL:2 % 1000000 / 1000
		IF LOCAL > 100
			L_D_AP -= LOCAL:3 % 100
		ELSE
			L_D_AP += LOCAL:3 % 100
		ENDIF
		
		LOCAL:3 = LOCAL:2 % 1000
		IF LOCAL > 100
			L_D_HP -= LOCAL:3 % 100
		ELSE
			SIF !GETBIT(L_D_SPEED_I, 30)
				L_D_HP += LOCAL:3 % 100
		ENDIF
	ENDIF
	{
	IF (FIELD_DEMON_DATE_V:L_DEFENSE:CBV_B_AP + FIELD_DEMON_DATE_V:L_DEFENSE:CBV_B_HP)
	 < (FIELD_DEMON_DATE_V:L_OFFENSE:CBV_B_AP + FIELD_DEMON_DATE_V:L_OFFENSE:CBV_B_HP)
	&& STATE_INFO_GET_F(L_DEFENSE, 2005) > 0 && RESULT:1 > L_TIME
	}
		LOCAL:2 = RESULT:3
		
		LOCAL:3 = LOCAL:2 % 1000000 / 1000
		IF LOCAL > 100
			L_D_AP -= LOCAL:3 % 100
		ELSE
			L_D_AP += LOCAL:3 % 100
		ENDIF
		
		LOCAL:3 = LOCAL:2 % 1000
		IF LOCAL > 100
			L_D_HP -= LOCAL:3 % 100
		ELSE
			SIF !GETBIT(L_D_SPEED_I, 30)
				L_D_HP += LOCAL:3 % 100
		ENDIF
	ENDIF
ENDIF

;必殺の構え
IF GETBIT(L_A_SPEED_I, 40) || GETBIT(L_D_SPEED_I, 40)
	LOCAL = (FIELD_DEMON_DATE_V:L_OFFENSE:CBV_B_AP * 3 + FIELD_DEMON_DATE_V:L_OFFENSE:CBV_B_HP * 2)
	LOCAL -= (FIELD_DEMON_DATE_V:L_DEFENSE:CBV_B_AP * 3 + FIELD_DEMON_DATE_V:L_DEFENSE:CBV_B_HP * 2)
	LOCAL += (FIELD_DEMON_DATE_V:L_OFFENSE:CBV_FLIGHT > 0) * 6 - (FIELD_DEMON_DATE_V:L_DEFENSE:CBV_FLIGHT > 0) * 6
	{
	LOCAL += (CB_HAVE_SP(L_OFFENSE, 1003) > 0) * FIELD_DEMON_DATE_V:L_OFFENSE:CBV_B_AP
	 - (CB_HAVE_SP(L_DEFENSE, 1003) > 0) * FIELD_DEMON_DATE_V:L_DEFENSE:CBV_B_AP
	}
	
	LOCAL:1 = 0
	SIF GETBIT(L_A_SPEED_I, 20)
		LOCAL:1 = MAX(L_A_AP - L_D_HP, 0)

	LOCAL:2 = 35
	SIF LOCAL > 5
		LOCAL:2 = 32
	SIF LOCAL > 5
		LOCAL:2 = 37
	
	RETURN LOCAL:2, L_A_SUMMONER_D, LOCAL:1

ELSEIF L_A_SPEED > L_D_SPEED && !GETBIT(L_D_SPEED_I, 4)
	L_FAST				= L_OFFENSE
	L_F_AP				= L_A_AP
	L_F_HP				= L_A_HP
	L_F_SPEED			= L_A_SPEED
	L_F_位置			= L_A_位置
	L_F_アタック耐性	= L_A_アタック耐性
	L_F_SPEED_I			= L_A_SPEED_I

	L_LATE				= L_DEFENSE
	L_L_AP				= L_D_AP
	L_L_HP				= L_D_HP
	L_L_SPEED			= L_D_SPEED
	L_L_位置			= L_D_位置
	L_L_アタック耐性	= L_D_アタック耐性
	L_L_SPEED_I			= L_D_SPEED_I
ELSEIF L_A_SPEED < L_D_SPEED && !GETBIT(L_A_SPEED_I, 4)
	L_FAST				= L_DEFENSE
	L_F_AP				= L_D_AP
	L_F_HP				= L_D_HP
	L_F_SPEED			= L_D_SPEED
	L_F_位置			= L_D_位置
	L_F_アタック耐性	= L_D_アタック耐性
	L_F_SPEED_I			= L_D_SPEED_I

	L_LATE				= L_OFFENSE
	L_L_AP				= L_A_AP
	L_L_HP				= L_A_HP
	L_L_SPEED			= L_A_SPEED
	L_L_位置			= L_A_位置
	L_L_アタック耐性	= L_A_アタック耐性
	L_L_SPEED_I			= L_A_SPEED_I
ENDIF

IF L_FAST > -1 && L_LATE > -1
	LOCAL = L_L_HP
	IF L_L_アタック耐性 == 999
		L_F_HP -= L_F_AP
	ELSEIF L_L_アタック耐性 == 888
	ELSE
		LOCAL -= MAX(L_F_AP - L_L_アタック耐性, 0)
	ENDIF
	SIF L_F_HP < 1 && L_FAST == L_OFFENSE
		RETURN 40, L_A_SUMMONER_D, 0
	SIF L_F_HP < 1 && L_FAST == L_DEFENSE
		RETURN 10, L_A_SUMMONER_D, 0
	
	LOCAL:1 = 0
	SIF GETBIT(L_F_SPEED_I, 20) && L_FAST == L_OFFENSE
		LOCAL:1 = MAX(L_F_AP - L_L_HP, 0)
	
	
	SIF LOCAL < 1 && L_FAST == L_OFFENSE
		RETURN 10, L_A_SUMMONER_D, LOCAL:1
	SIF LOCAL < 1 && L_FAST == L_DEFENSE
		RETURN 40, L_A_SUMMONER_D, LOCAL:1
	L_L_HP = LOCAL


	LOCAL = L_F_HP
	IF L_F_アタック耐性 == 999
		L_L_HP -= L_L_AP
	ELSEIF L_F_アタック耐性 == 888
	ELSE
		LOCAL -= MAX(L_L_AP - L_F_アタック耐性, 0)
	ENDIF
	SIF L_L_HP < 1 && L_FAST == L_OFFENSE
		RETURN 10, L_A_SUMMONER_D, 0
	SIF L_L_HP < 1 && L_FAST == L_DEFENSE
		RETURN 40, L_A_SUMMONER_D, 0
	
	;LOCAL:1 = 0
	SIF GETBIT(L_L_SPEED_I, 20) && L_LATE == L_OFFENSE
		LOCAL:1 = MAX(L_L_AP - L_F_HP, 0)
	
	SIF LOCAL < 1 && L_FAST == L_OFFENSE
		RETURN 40, L_A_SUMMONER_D, LOCAL:1
	SIF LOCAL < 1 && L_FAST == L_DEFENSE
		RETURN 10, L_A_SUMMONER_D, LOCAL:1
	
ELSE
	LOCAL = L_D_HP
	IF L_D_アタック耐性 == 999
		L_A_HP -= L_A_AP
	ELSEIF L_D_アタック耐性 == 888
	ELSE
		LOCAL -= MAX(L_A_AP - L_D_アタック耐性, 0)
	ENDIF

	LOCAL:1 = 0
	SIF GETBIT(L_A_SPEED_I, 20)
		LOCAL:1 = MAX(L_A_AP - L_D_HP, 0)
	
	L_D_HP = LOCAL

	;PRINTFORML 1. AT {L_A_HP}　DF {L_D_HP}

	IF L_A_アタック耐性 == 999
		L_D_HP -= L_D_AP
	ELSEIF L_A_アタック耐性 == 888
	ELSE
		L_A_HP -= MAX(L_D_AP - L_A_アタック耐性, 0)
	ENDIF

	;PRINTFORML 2. AT {L_A_HP}　DF {L_D_HP}

	IF L_D_HP < 1 && L_A_HP < 1
		LOCAL = (FIELD_DEMON_DATE_V:L_OFFENSE:CBV_B_AP * 3 + FIELD_DEMON_DATE_V:L_OFFENSE:CBV_B_HP * 2)
		LOCAL -= (FIELD_DEMON_DATE_V:L_DEFENSE:CBV_B_AP * 3 + FIELD_DEMON_DATE_V:L_DEFENSE:CBV_B_HP * 2)
		LOCAL += (FIELD_DEMON_DATE_V:L_OFFENSE:CBV_FLIGHT > 0) * 6 - (FIELD_DEMON_DATE_V:L_DEFENSE:CBV_FLIGHT > 0) * 6
		{
		LOCAL += (CB_HAVE_SP(L_OFFENSE, 1003) > 0) * FIELD_DEMON_DATE_V:L_OFFENSE:CBV_B_AP
		- (CB_HAVE_SP(L_DEFENSE, 1003) > 0) * FIELD_DEMON_DATE_V:L_DEFENSE:CBV_B_AP
		}
		
		LOCAL:2 = 35
		SIF LOCAL > 5
			LOCAL:2 = 32
		SIF LOCAL < -5
			LOCAL:2 = 37
		
		RETURN LOCAL:2, L_A_SUMMONER_D, LOCAL:1

	ELSEIF L_D_HP < 1
		RETURN 10, L_A_SUMMONER_D, LOCAL:1
	ELSEIF L_A_HP < 1
		RETURN 40, L_A_SUMMONER_D, LOCAL:1
	ENDIF
	;PRINTFORML 3. AT {L_A_HP}　DF {L_D_HP}

ENDIF

RETURN 20, L_A_SUMMONER_D, LOCAL:1


@CB_バトル力GET, ARG
LOCAL = FIELD_DEMON_DATE_V:ARG:CBV_B_AP * 3 + FIELD_DEMON_DATE_V:ARG:CBV_B_HP * 2
LOCAL += (FIELD_DEMON_DATE_V:ARG:CBV_FLIGHT > 0) * 6
LOCAL += (CB_HAVE_SP(ARG, 1003) > 0) * FIELD_DEMON_DATE_V:ARG:CBV_B_AP
RETURN LOCAL


@CB_戦闘結果P変換, L_POINT, L_DEF
#FUNCTION
#DIM L_POINT	;ポイント
#DIM L_DEF		;0-공격　1-방어
IF L_DEF == 0
	SELECTCASE L_POINT
		CASE 5
			RETURNF 70
		CASE 10
			RETURNF 60
		CASE 32
			RETURNF 50
		CASE 35
			RETURNF 40
		CASE 20
			RETURNF 30
		CASE 37
			RETURNF 20
		CASE 40
			RETURNF 10
		CASE 50
			RETURNF 0
	ENDSELECT
;防御側の場合逆になる
;　　　　5-ブロックできない　10-一方的にやられる　20-お互いに生き残る　
;　　　　32-格下と相打　35-同格と相打ち　37-格上と相打ち　40-一方的にやれる　50-バトルができない
ELSEIF L_DEF == 0
	SELECTCASE L_POINT
		CASE 5
			RETURNF 0
		CASE 10, 32
			RETURNF 10
		CASE 35
			RETURNF 20
		CASE 20
			RETURNF 30
		CASE 37
			RETURNF 40
		CASE 40
			RETURNF 50
	ENDSELECT
ENDIF
RETURNF 0



;返り値　AP、HP、速さ状況と状態、攻撃位置OR守備位置、アタック耐性
;0-戦闘能力見る人
;1-どういう状況か　0-공격　1-守備　-1-素の能力
;L_ACTION-ビット演算
;　　0-パワーアップスキル使用
;　　1-状態剥がし
@CB_AI戦闘能力GET, ARG, ARG:1 = 0, L_ACTION, L_TIME = -1
#DIM L_AP
#DIM L_HP
#DIM L_SPEED
#DIM L_SPEED_I = 0
#DIM L_R_位置 = 0
#DIM L_R_位置2 = -1
#DIM L_アタック耐性 = 0
#DIM L_アタック弱点 = 0
;位置2が優先される

#DIM L_COUNT

#DIM L_HOST_T
#DIM L_FAZE
#DIM L_TIME
#DIM L_HP_UP = 1

#DIM L_ACTION
#DIM L_S_DAMAGE

L_S_DAMAGE = 0
;AIが見れるタイミングが
;フェイズ3（メインフェイズ）の攻撃時と
;フェイズ4（バトルフェイズ）の防御時になる

;メインフェイズ時
;攻撃時のパラメータを調べる場合は
;バトルフェイズ時、戦闘時の能力も調べる
;守備時のパラメータを調べる場合は
;全ての能力を調べる

;バトルフェイズ時（守備時）
;守備時のパラメータを調べる場合は
;戦闘時のみ調べる


;---------
;素の能力を見ている
;HP上昇封のみ、状態を見ている。
;---------
;敵側で　
;現在敵のターンでバトルフェイズではなく、攻撃時の場合
;現在＠のターンでバトルフェイズで、防御時の場合


{
IF L_TIME == 0 ||
(L_TIME == -1 && 
((FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_OPPONENT && 
((CBF_P_TURN == FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE != 4 && ARG:1 == 0) || 
(CBF_P_TURN != FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE == 4 && ARG:1 == 1)))
|| (FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_ONESELF  && 
((CBF_P_TURN != FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE != 4 && ARG:1 == 1) || 
(CBF_P_TURN == FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE == 4 && ARG:1 == 0)))))
}
;＠側で
;現在敵のターンでバトルフェイズではなく、防御時の場合
;現在＠のターンでバトルフェイズで、攻撃時の場合

	;現在の能力を見る

	L_AP = FIELD_DEMON_DATE_V:ARG:CBV_AP
	L_HP = FIELD_DEMON_DATE_V:ARG:CBV_HP

	L_FAZE = 3
	SIF CBF_PHASE >= 4
		L_FAZE = 6
	L_TIME = 0

	;HP上昇不能が付いているか
	SIF (STATE_INFO_GET_F(ARG, 105) > 0) && RESULT:1 > L_TIME && !GETBIT(L_ACTION, 1)
		L_HP_UP = 0
	
	;基本が4、0～2のビットは速度
	;3＝先制攻撃無効
	;5＝対空（相手が飛行だと先制）
	L_SPEED = 4
	SIF FIELD_DEMON_DATE_V:ARG:CBV_SPEED > 0
		L_SPEED ++
	SIF FIELD_DEMON_DATE_V:ARG:CBV_SPEED < 0
		L_SPEED --

	;攻撃位置
	IF ARG:1 == 0
		L_R_位置2 = -1

		L_S_DAMAGE = L_AP
		L_R_位置 = 3
		SIF FIELD_DEMON_DATE_V:ARG:CBV_FLYING > 0
			L_R_位置 = 4
		SIF GETBIT(FIELD_DEMON_DATE_V:ARG:CBV_CONDITION, 0)
			L_R_位置2 = -2
	;守備位置
	ELSEIF ARG:1 == 1
		L_R_位置2 = 0

		L_R_位置 = 0
		IF FIELD_DEMON_DATE_V:ARG:CBV_FLYING > 0
			SETBIT L_R_位置, 3
			SETBIT L_R_位置, 4
		ELSE
			SETBIT L_R_位置, 2
			SETBIT L_R_位置, 3
		ENDIF
		SIF GETBIT(FIELD_DEMON_DATE_V:ARG:CBV_CONDITION, 0)
			L_R_位置2 = -2

	ENDIF
ELSE
	;次ターン以降の能力を見る

	L_FAZE = 0
	SIF L_TIME < 0
		L_TIME = 1

	L_AP = FIELD_DEMON_DATE_V:ARG:CBV_B_AP

	;HP上昇不能が付いているか
	IF L_HP_UP == 0 || ((STATE_INFO_GET_F(ARG, 105) > 0 && RESULT:1 > L_TIME && !GETBIT(L_ACTION, 1)))
		L_HP_UP = 0
		L_HP = FIELD_DEMON_DATE_V:ARG:CBV_HP
	ELSE
		L_HP = FIELD_DEMON_DATE_V:ARG:CBV_B_HP
	ENDIF
	
	;基本が4、0～3のビットは速度
	;4＝先制攻撃無効
	;5＝対空（相手が飛行だと先制）
	L_SPEED = 4
	SIF FIELD_DEMON_DATE_V:ARG:CBV_SPEED > 1 || CB_HAVE_SP(ARG, 1003)
		L_SPEED ++
	SIF FIELD_DEMON_DATE_V:ARG:CBV_SPEED < -1 || CB_HAVE_SP(ARG, 1009)
		L_SPEED --
	
	;攻撃位置
	IF ARG:1 == 0
		L_S_DAMAGE = L_AP
		L_R_位置2 = -1

		L_R_位置 = 3
		SIF FIELD_DEMON_DATE_V:ARG:CBV_FLIGHT > 0 || FIELD_DEMON_DATE_V:ARG:CBV_FLYING > L_TIME
			L_R_位置 = 4

	;守備位置
	ELSEIF ARG:1 == 1
		L_R_位置2 = 0

		L_R_位置 = 0
		IF FIELD_DEMON_DATE_V:ARG:CBV_FLIGHT > 0 || FIELD_DEMON_DATE_V:ARG:CBV_FLYING > L_TIME
			SETBIT L_R_位置, 3
			SETBIT L_R_位置, 4
		ELSE
			SETBIT L_R_位置, 2
			SETBIT L_R_位置, 3
		ENDIF
		SIF GETBIT(FIELD_DEMON_DATE_V:ARG:CBV_CONDITION, 0) && L_TIME < 2
			L_R_位置2 = -2
		SIF FIELD_DEMON_DATE_V:ARG:CBV_BATTLE > 0 && !(STATE_INFO_GET_F(ARG, 11) > 0)
			L_R_位置2 = -2
	ENDIF
ENDIF



RESULTS =
;パワーアップスキルの使用
IF GETBIT(L_ACTION, 0)
	IF ARG:1 == 0
		TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:ARG:CBV_SP1}, FIELD_DEMON_DATE_S:ARG:CBS_SP1_SUB, ARG
			IF (RESULT == 2 || RESULT == 4) && RESULT:3 == 1
				L_AP += RESULT:1
				L_S_DAMAGE += RESULT:1
				SIF L_HP_UP
					L_HP += RESULT:2
			ELSE
				RESULTS =
			ENDIF
		CATCH
		ENDCATCH
	;守備は状態付与の可能性大
	;バトルフェイズ時PUとかは結界で解かれる
	;プリ―ペアフェイズ時だと解かれない
	ELSEIF ARG:1 == 1
		TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:ARG:CBV_SP1}, FIELD_DEMON_DATE_S:ARG:CBS_SP1_SUB, ARG
			IF (RESULT == 3 || RESULT == 4) && RESULT:3 == 1
				L_AP += RESULT:1
				SIF L_HP_UP
					L_HP += RESULT:2
			ELSE
				RESULTS =
			ENDIF
		CATCH
		ENDCATCH
	ENDIF
ENDIF

SIF STRFIND(RESULTS, "先制") >= 0
	L_SPEED = 5
SIF STRFIND(RESULTS, "後攻") >= 0
	L_SPEED = 3
SIF STRFIND(RESULTS, "先無") >= 0
	SETBIT L_SPEED_I, 4
SIF STRFIND(RESULTS, "관통") >= 0 && ARG:1 == 0
	SETBIT L_SPEED_I, 20
IF STRFIND(RESULTS, "飛行") >= 0
	;攻撃位置
	IF ARG:1 == 0
		L_R_位置 = 4
	;守備位置
	ELSEIF ARG:1 == 1
		L_R_位置 = 0
		SETBIT L_R_位置, 3
		SETBIT L_R_位置, 4
	ENDIF
ENDIF
IF STRFIND(RESULTS, "歩行") >= 0
	;攻撃位置
	IF ARG:1 == 0
		L_R_位置 = 3
	;守備位置
	ELSEIF ARG:1 == 1
		L_R_位置 = 0
		SETBIT L_R_位置, 2
		SETBIT L_R_位置, 3
	ENDIF
ENDIF
SIF STRFIND(RESULTS, "制空") >= 0 && ARG:1 == 1
	SETBIT L_R_位置, 4
SIF STRFIND(RESULTS, "無敵") >= 0 && ARG:1 == 1
	L_アタック耐性 = 888
SIF STRFIND(RESULTS, "A反射") >= 0 && ARG:1 == 1
	L_アタック耐性 = 999
SIF STRFIND(RESULTS, "通過") >= 0 && ARG:1 == 0 && L_R_位置2 > -2
	L_R_位置2 = 60


;ステイト関連
IF !GETBIT(L_ACTION, 1)
	;1で自分のターン、2で相手のターン
	L_HOST_T = ((CBF_P_TURN + L_TIME) % 2 == FIELD_DEMON_DATE_V:ARG:CBV_HOST)

	;先制無視
	SIF (STATE_INFO_GET_F(ARG, 13) > 0 && RESULT:1 > L_TIME)
		SETBIT L_SPEED_I, 4

	;アタック耐性
	SIF (STATE_INFO_GET_F(ARG, 2) > 0 && RESULT:1 > L_TIME && L_アタック耐性 < RESULT:3)
		L_アタック耐性 = RESULT:3
	;アタック無効
	SIF (STATE_INFO_GET_F(ARG, 3) > 0 && RESULT:1 > L_TIME && L_アタック耐性 < 888)
		L_アタック耐性 = 888
	;アタック反射
	SIF (STATE_INFO_GET_F(ARG, 4) > 0 && RESULT:1 > L_TIME && L_アタック耐性 < 999)
		L_アタック耐性 = 999
	
	;アタック弱点
	SIF (STATE_INFO_GET_F(ARG, 110) > 0 && RESULT:1 > L_TIME && L_アタック弱点 < RESULT:3)
		L_アタック弱点 = RESULT:3

	;必殺の構え
	SIF (STATE_INFO_GET_F(ARG, 201) > 0 && RESULT:1 > L_TIME) || (CB_HAVE_SP(ARG, 1008) && 0 < L_TIME)
		SETBIT L_SPEED_I, 30

	;対空
	IF (STATE_INFO_GET_F(ARG, 2001) && RESULT:1 > L_TIME) || (CB_HAVE_SP(ARG, 1100) && 0 < L_TIME)
		SIF L_R_位置2 > -1
			SETBIT L_R_位置2, 4
		SIF ARG:1 == 1
			SETBIT L_SPEED_I, 5
	ENDIF

	;攻撃側
	IF ARG:1 == 0
		;アタック不可
		SIF (STATE_INFO_GET_F(ARG, 101) > 0 && RESULT:1 > L_TIME) || (CB_HAVE_SP(ARG, 1005) &&  0 < L_TIME)
			L_R_位置2 = -2
	;防御側
	ELSEIF ARG:1 == 1
		SIF CB_HAVE_SP(ARG, 1010) && 0 < L_TIME
			SETBIT L_SPEED_I, 4
		;制空
		SIF ((STATE_INFO_GET_F(ARG, 7) > 0 && RESULT:1 > L_TIME) || (CB_HAVE_SP(ARG, 1004) &&  0 < L_TIME))
			SETBIT L_R_位置, 4
		;ブロック不可
		SIF (STATE_INFO_GET_F(ARG, 102) > 0 && RESULT:1 > L_TIME) || (CB_HAVE_SP(ARG, 1001) &&  0 < L_TIME)
			L_R_位置2 = -2
	ENDIF
	FOR L_COUNT, 0, 3
		IF L_COUNT == 2
			;守備位置
			SIF CB_HAVE_SP(ARG, 1050) && 0 < L_TIME
				L_AP += 3
			SIF CB_HAVE_SP(ARG, 1051) && 0 < L_TIME
				L_AP += 2
			SIF CB_HAVE_SP(ARG, 1052) && 0 < L_TIME && L_HP_UP
				L_HP += 1
			SIF CB_HAVE_SP(ARG, 1053) && 0 < L_TIME && L_HP_UP
				L_HP += 2
				
		ENDIF
		FOR LOCAL, 0, VARSIZE("FIELD_DEMON_STATE_V", 1)
			;タイミングが規定タイミング
			;タイミングが3の倍数（相手でも自分でも発動）
			;タイミングが3の倍数+1（自分のターンで発動）
			;タイミングが3の倍数+2（相手のターンで発動）
			{
			IF L_FAZE < FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING < 10 
			&& FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING <= ((L_COUNT + 1) * 3) &&
				(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING % 3 == 0 || 
					(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING % 3 == 1 && L_HOST_T == 1) ||
					(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING % 3 == 2 && L_HOST_T == 0))
					&& FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TURN > L_TIME 
			}
				IF 1001 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE
					LOCAL:2 = FIELD_DEMON_STATE_V:ARG:LOCAL:CSS3_SUB1
					
					LOCAL:3 = LOCAL:2 % 1000000 / 1000
					IF LOCAL > 100
						L_AP -= LOCAL:3 % 100
					ELSE
						L_AP += LOCAL:3 % 100
					ENDIF
					
					LOCAL:3 = LOCAL:2 % 1000
					IF LOCAL > 100
						L_HP -= LOCAL:3 % 100
					ELSE
						SIF L_HP_UP
							L_HP += LOCAL:3 % 100
					ENDIF
				ELSEIF 1001 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE && L_アタック耐性 < FIELD_DEMON_STATE_V:ARG:LOCAL:CSS3_SUB1
						L_アタック耐性 = FIELD_DEMON_STATE_V:ARG:LOCAL:CSS3_SUB1
				ELSEIF 1002 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE && L_アタック耐性 < 888
						L_アタック耐性 = 888
				ELSEIF 1003 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE && L_アタック耐性 < 999
						L_アタック耐性 = 999
				ELSEIF 1007 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING < 7 && ARG:1 == 1
					SIF L_R_位置2 > -1
						SETBIT L_R_位置, 4
				ELSEIF 1008 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE && ARG:1 == 0
					SETBIT L_SPEED_I, 20
				ELSEIF 1009 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING < 7 && ARG:1 == 0
					SIF L_R_位置2 >= -1
						L_R_位置2 = 60
				ELSEIF 1013 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE
					SETBIT L_SPEED_I, 4
				ELSEIF 1102 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING < 7 && ARG:1 == 1
					L_R_位置2 = -2
				ELSEIF 1104 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE
					L_AP = 0
				ELSEIF 1110 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE && L_アタック弱点 < FIELD_DEMON_STATE_V:ARG:LOCAL:CSS3_SUB1
					L_アタック弱点 = FIELD_DEMON_STATE_V:ARG:LOCAL:CSS3_SUB1
				ELSEIF 1201 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE
					SETBIT L_SPEED_I, 30
				ELSEIF 1301 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE
					L_SPEED = 5
				ELSEIF 1302 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE
					L_SPEED = 3
				ELSEIF 1303 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE
					L_SPEED = MIN(5, L_SPEED + 1)
				ELSEIF 1304 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE
					L_SPEED = MAX(3, L_SPEED - 1)
				ELSEIF 1305 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING < 7
					;攻撃位置
					IF ARG:1 == 0
						L_R_位置 = 3
					;守備位置
					ELSEIF ARG:1 == 1
						L_R_位置 = 0
						SETBIT L_R_位置, 2
						SETBIT L_R_位置, 3
					ENDIF
				ELSEIF 1306 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING < 7
					;攻撃位置
					IF ARG:1 == 0
						L_R_位置 = 4
					;守備位置
					ELSEIF ARG:1 == 1
						L_R_位置 = 0
						SETBIT L_R_位置, 3
						SETBIT L_R_位置, 4
					ENDIF
				ELSEIF 1999 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING < 7 && ARG:1 == 1
					L_R_位置2 = -2
				ENDIF
			ENDIF
		NEXT
	NEXT

ENDIF

SIF L_HP_UP == 0
	SETBIT L_SPEED_I, 30

L_SPEED |= L_SPEED_I

;攻撃位置
IF ARG:1 == 0

	IF L_R_位置2 < -1
		L_R_位置 = -1
		L_S_DAMAGE = 0
	ELSEIF L_R_位置2 > -1
		L_R_位置 = L_R_位置2
	ENDIF
;守備位置
ELSEIF ARG:1 == 1
	IF L_R_位置2 < -1
		L_R_位置 = 0
	ELSEIF L_R_位置2 > -1
		L_R_位置 |= L_R_位置2
	ENDIF
ELSE
	L_R_位置 = -2
	L_S_DAMAGE = 0
ENDIF

SIF L_アタック耐性 < 888
	L_アタック耐性 -= L_アタック弱点

RETURN L_AP, L_HP, L_SPEED, L_R_位置, L_アタック耐性, L_S_DAMAGE

;引数
;手札状況
;供物数
;供物にしない除去位置(ビット)
;供物条件(文字)
@CB_OFFERING_POSGET, HAND_INFO_V_E, DEMAND_N, REP_POS, TERMS_S = ""
#DIM REF HAND_INFO_V_E, 0, 0
#DIM DEMAND_N
#DIM REP_POS
#DIMS TERMS_S

#DIM OFFERING_C, 50
#DIM OFFERING_P, 2, 50
#DIM L_COUNT
#DIM L_C_NUM
#DIM L_WORTH

#DIM L_FUS_D

VARSET OFFERING_C, -1
L_FUS_D = 0

PRINTFORML 供物選択開始
FOR L_COUNT, 0, VARSIZE("HAND_INFO_V_E", 0)
	SIF GETBIT(REP_POS, L_COUNT)
		CONTINUE
	IF HAND_INFO_V_E:L_COUNT:0 >= 100
	;アイテムの場合
    	CALL CARD_DATA_GET, HAND_INFO_V_E:LOCAL:9
		CALL CB_SP_WORTH, CARD_DATE_V:CBV_SP1
		PRINTFORML {CARD_DATE_V:CBV_NO}　%CARD_DATE_S:CBS_NAME%　{L_COUNT}　{RESULT}
		OFFERING_C:L_COUNT = RESULT
	ELSEIF HAND_INFO_V_E:L_COUNT:2 > 0
	;仲魔の場合
		OFFERING_C:L_COUNT = 0
    	CALL CARD_DATA_GET, HAND_INFO_V_E:LOCAL:12
        CALL CS_DEMON_SUMMON_FIELD, CBF_ENEMY_AI_POS1, CARD_DATE_V:CBV_NO

		CALL CB_SP_WORTH, CARD_DATE_V:CBV_SP1, CBF_ENEMY_AI_POS1, CARD_DATE_S:CBS_SP1_SUB
		OFFERING_C:L_COUNT += RESULT
		SIF CARD_DATE_V:CBV_FUSION > 1
			L_FUS_D = 1
			
		OFFERING_C:L_COUNT += (14 - CARD_DATE_V:CBV_COST)
		OFFERING_C:L_COUNT += HAND_INFO_V_E:L_COUNT:11 / 2

		{
		LOCAL:1 = MAX(
			HAND_INFO_V_E:L_COUNT:20, HAND_INFO_V_E:L_COUNT:21,
			HAND_INFO_V_E:L_COUNT:22, HAND_INFO_V_E:L_COUNT:23,
			HAND_INFO_V_E:L_COUNT:24, HAND_INFO_V_E:L_COUNT:25
		)
		}
		{
		LOCAL:2 = MAX(
			HAND_INFO_V_E:L_COUNT:26, HAND_INFO_V_E:L_COUNT:29,
			HAND_INFO_V_E:L_COUNT:27, HAND_INFO_V_E:L_COUNT:30,
			HAND_INFO_V_E:L_COUNT:28, HAND_INFO_V_E:L_COUNT:31
		)
		}
		OFFERING_C:L_COUNT += 40 - MIN(LOCAL:1, LOCAL:2, 40)

		LOCAL:1 = 55
		LOCAL:3 = 0
		LOCAL:4 = 0
		FOR L_C_NUM , 32, 39
			IF HAND_INFO_V_E:L_COUNT:L_C_NUM == 5
				LOCAL:3 ++
			ELSEIF HAND_INFO_V_E:L_COUNT:L_C_NUM == 37
				LOCAL:4 ++
			ENDIF
			SIF LOCAL:1 > HAND_INFO_V_E:L_COUNT:L_C_NUM && HAND_INFO_V_E:L_COUNT:L_C_NUM > 5
				LOCAL:1 = HAND_INFO_V_E:L_COUNT:L_C_NUM
		NEXT
		IF LOCAL:1 > 50 && LOCAL:3 > 0
			LOCAL:1 = 5
		ELSE
			SIF LOCAL:1 < 37
				LOCAL:1 = MIN(37, LOCAL:1 + LOCAL:4 * 3)
			LOCAL:1 -= LOCAL:3 * 3
		ENDIF
		LOCAL:1 = MIN(LOCAL:1 - 5, 0)

		LOCAL:2 = 55
		LOCAL:3 = 0
		LOCAL:4 = 0
		FOR L_C_NUM , 39, 45
			IF HAND_INFO_V_E:L_COUNT:L_C_NUM == 5
				LOCAL:3 ++
			ELSEIF HAND_INFO_V_E:L_COUNT:L_C_NUM == 37
				LOCAL:4 ++
			ENDIF
			SIF LOCAL:2 > HAND_INFO_V_E:L_COUNT:L_C_NUM && HAND_INFO_V_E:L_COUNT:L_C_NUM > 5
				LOCAL:2 = HAND_INFO_V_E:L_COUNT:L_C_NUM
		NEXT
		IF LOCAL:2 >= 50 && LOCAL:3 > 0
			LOCAL:2 = 5
		ELSE
			SIF LOCAL:2 < 37
				LOCAL:2 = MIN(37, LOCAL:2 + LOCAL:4 * 3)
			LOCAL:2 -= LOCAL:3 * 3
		ENDIF
		LOCAL:2 = MIN(LOCAL:2 - 10, 0)
		

		OFFERING_C:L_COUNT += MAX(LOCAL:1, LOCAL:2)

		PRINTFORML {CARD_DATE_V:CBV_NO}　%CARD_DATE_S:CBS_NAME%　{L_COUNT}　{OFFERING_C:L_COUNT}



        CALL CS_FIELD_DEMON_CLEAR, CBF_ENEMY_AI_POS1
	ENDIF
NEXT

VARSET OFFERING_P, -1
L_WORTH = 0

PRINTFORML
PRINTFORML

FOR L_COUNT, 0, VARSIZE("HAND_INFO_V_E", 0)
	SIF OFFERING_C:L_COUNT < 0
		CONTINUE
	FOR L_C_NUM, 0, DEMAND_N
		IF OFFERING_C:L_COUNT < OFFERING_P:0:L_C_NUM || OFFERING_P:0:L_C_NUM < 0
			IF L_C_NUM < DEMAND_N - 1 && OFFERING_P:0:(L_C_NUM + 1) < 0
				OFFERING_P:0:(L_C_NUM + 1) = OFFERING_P:0:L_C_NUM
				OFFERING_P:1:(L_C_NUM + 1) = OFFERING_P:1:L_C_NUM
			ENDIF
			OFFERING_P:0:L_C_NUM = OFFERING_C:L_COUNT
			OFFERING_P:1:L_C_NUM = L_COUNT
			PRINTFORML SET　{OFFERING_P:1:L_C_NUM}　{OFFERING_P:0:L_C_NUM}
			BREAK
		ENDIF
	NEXT
NEXT

PRINTFORML
PRINTFORML

FOR L_C_NUM, 0, DEMAND_N
	PRINTFORML {OFFERING_P:0:L_C_NUM}
	SIF OFFERING_P:0:L_C_NUM < 0
		RETURN 0
	SETBIT L_WORTH, OFFERING_P:1:L_C_NUM
NEXT
RETURN L_WORTH

@CB_SP_WORTH, ARG, L_P = -1, L_SP_SUB = ""
#DIM L_P
#DIMS L_SP_SUB
#DIM L_WORTH
L_WORTH = 0

TRYCCALLFORM CGSP_TYPE_{ARG}, L_SP_SUB, L_P
	IF RESULT == 1
		L_WORTH += 60
		L_WORTH += 30 * RESULT:1
		IF RESULT:1 == 2
			L_WORTH += 100
		ENDIF
	ELSEIF 2 <= RESULT && RESULT <= 4 && RESULT:3 > 1
		L_WORTH += 2
		SIF RESULT == 4
			L_WORTH += 2
		SIF RESULT:3 == 3
			L_WORTH += 4
	ELSEIF RESULT == 30
		L_WORTH += RESULT:1
	ELSEIF 10 <= RESULT && RESULT <= 16
		L_WORTH += 2
		SIF RESULT == 12 || RESULT == 16
			L_WORTH += 2
		IF RESULT:1 == 998 || RESULT:1 == 997
			L_WORTH += 100
			L_WORTH += 10 * MIN(RESULT:2, 8)
		ELSE
			L_WORTH += MIN(RESULT:2, 8)
		ENDIF
	ELSEIF RESULT == 999
		L_WORTH += 4
		L_WORTH += MIN(RESULT:2, 8) * 4
	ELSEIF RESULT == 20
		L_WORTH += 2
		L_WORTH += MIN(RESULT:2, 8) * 2
	ELSEIF RESULT == 21
		L_WORTH += RESULT:1 * 5
		L_WORTH += MIN(RESULT:2, 8) * 5
	ELSEIF RESULT == 22
		L_WORTH += RESULT:1
		L_WORTH += MIN(RESULT:2, 8)
	ELSEIF RESULT == 40
		L_WORTH += RESULT:1 * 10
	ELSEIF RESULT == 41
		L_WORTH += RESULT:1 * 10
	ELSEIF RESULT == 50
		L_WORTH += 2
	ELSEIF RESULT == 45
		L_WORTH += 30
	ELSE
	ENDIF
CATCH
ENDCATCH
RETURN L_WORTH

