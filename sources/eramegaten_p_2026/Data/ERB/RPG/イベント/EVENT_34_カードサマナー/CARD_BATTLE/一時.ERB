SELECTCASE L_CHECK_S
	CASE "LL","LIGHT-LAW"		 , "ライト・ロウ"
		SIF L_KINDS == 11
			RETURNF 1
	CASE "LN","LIGHT-NEUTRAL"	 , "ライト・ニュートラル"
		SIF L_KINDS == 12
			RETURNF 11
	CASE "LC","LIGHT-CHAOS"		 , "ライト・カオス"
		SIF L_KINDS == 12
			RETURNF 1

	CASE "NL","NEUTRAL-LAW"		 , "ニュートラル・ロウ"
		SIF L_KINDS == 11
			RETURNF 1
	CASE "NN","NEUTRAL-NEUTRAL"	 , "ニュートラル・ニュートラル" ,"TN","TRUE-NEUTRAL", "トゥルーニュートラル"
		SIF L_KINDS == 12
			RETURNF 11
	CASE "NC","NEUTRAL-CHAOS"	 , "ニュートラル・カオス"
		SIF L_KINDS == 12
			RETURNF 1

	CASE "DL","DARK-LAW"		 , "ダーク・ロウ"
		SIF L_KINDS == 11
			RETURNF 1
	CASE "DN","DARK-NEUTRAL"	 , "ダーク・ニュートラル"
		SIF L_KINDS == 12
			RETURNF 11
	CASE "DC","DARK-CHAOS"		 , "ダーク・カオス"
		SIF L_KINDS == 12
			RETURNF 1

	CASE "LIGHT"	,"L ", "LI", "ライト"
		SIF L_KINDS / 10 == 1
			RETURNF 1
	CASE "DARK"		,"D ", "DA", "D", "ダーク"
		SIF L_KINDS / 10 == 3
			RETURNF 1
	CASE "LAW"		," L", "LA", "ロウ"
		SIF L_KINDS > 10 && L_KINDS % 10 == 1
			RETURNF 1
	CASE "CHAOS"	," C", "CA", "C" ,"カオス"
		SIF L_KINDS > 10 && L_KINDS % 10 == 3
			RETURNF 1

	CASE "NEUTRAL"	, "N","ニュートラル"
		SIF L_KINDS > 10 && L_KINDS % 10 == 2
			RETURNF 1
		SIF L_KINDS / 10 == 2
			RETURNF 1
	CASE "N "
		SIF L_KINDS / 10 == 2
			RETURNF 1
	CASE " N"
		SIF L_KINDS > 10 && L_KINDS % 10 == 2
			RETURNF 1

	CASE "NONE"		, "None"	, "無し", "無"
		SIF L_KINDS == 0
			RETURNF 1
	CASE "UNKOWN"	, "Unkown"	, "不明", "?", "????"
		SIF L_KINDS == 1
			RETURNF 1
ENDSELECT
RETURNF 0


