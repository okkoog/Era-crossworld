
;特技名
@CGSP_NAME_6050, ARGS, ARG
RESULTS = バルーンシールド

;　コストの量
@CGSP_COST_6050, ARGS, ARG
RETURN 2
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_6050, ARGS, ARG
RETURN 1
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_6050, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_6050, ARGS, ARG, ARG:1
;
CALL CB_STATE_ADD, ARG:1, 6, 2


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_6050, ARGS, ARG, ARG:1
RETURN 0
