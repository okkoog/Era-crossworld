;잔/1/0/
;特技名
@CGSP_NAME_6074, ARGS, ARG
RESULTS = 運命の爆弾

;　コストの量
@CGSP_COST_6074, ARGS, ARG
RETURN 7

;　타겟(選択するかしないか)
@CGSP_TARGET_6074, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_6074, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　4-召喚時

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_6074, ARGS, ARG, ARG:1
#DIM L_DAMAGE , 3 
#DIM L_ADD
L_DAMAGE:0 = 2
L_DAMAGE:1 = 3
L_DAMAGE:2 = 4

L_ADD = 0
FOR LOCAL, 0, VARSIZE("OFFERING_CARD_DATE_V", 0)
	SIF OFFERING_CARD_DATE_V:LOCAL:CBV_KINDS >= 100
		L_ADD = 1
NEXT
LOCAL = RAND:3

IF (ARG % 20) == CS1_ONESELF
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ENDIF

FOR LOCAL, LOCAL:1, LOCAL:2
	CALL SP_DAMAGE, LOCAL, L_DAMAGE:LOCAL + L_ADD, ARG
NEXT

SIF LOCAL == 2
    CALL CS_SUMMONER_DAMAGE, ARG % 20, 10, -1, 99


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_6074, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_6074, ARGS, ARG
{
RESULTS = 全ての敵仲魔に2P、3P、4Pいずれかダメージをあたえる。
供物にアイテムを使うと敵仲魔へのダメージが+1上昇する。最大値だと自身に10Pのダメージ。
『さだめのばくだん、運次第の爆弾』
}

;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　1(アギとかのダメージ魔法系は1),ダメージ,範囲1体は1、全体は2
@CGSP_TYPE_6074, ARGS, ARG
RETURN 1, 3, 2

@CGSP_TYPE_6074_1, ARGS, ARG
RESULTS:1 = アイテム
RETURN 1, 4, 2

