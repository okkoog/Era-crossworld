
;特技名
@CGSP_NAME_353, ARGS, ARG
RESULTS = 絶滅覇拳

;　コストの量
@CGSP_COST_353, ARGS, ARG
RETURN 3
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_353, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_353, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_353, ARGS, ARG, ARG:1
;
CALL CS_DICEROLL(4, ARG)
IF RESULT
	FOR LOCAL, CBF_ALLY_POS1, CBF_ENEMY_POS6 + 1
		SIF LOCAL != ARG && FIELD_DEMON_DATE_V:ARG:CBV_NO > 0
			CALL CS_DICEROLL_STATE(9999, ARG, ARG:1, 998, 1)
			;CALL CB_STATE_ADD, LOCAL, 998, 1
	NEXT
ENDIF


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_353, ARGS, ARG, ARG:1
RETURN 3
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_353, ARGS, ARG
RESULTS = 4/6 （66％）の確率で場にいる、全ての仲魔を黄泉に葬る。このSPを、使った仲魔も黄泉に葬られる。『自身は失敗しても黄泉に葬られるので注意』


;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　999,場一掃系
@CGSP_TYPE_353, ARGS, ARG
RETURN 999, 4


