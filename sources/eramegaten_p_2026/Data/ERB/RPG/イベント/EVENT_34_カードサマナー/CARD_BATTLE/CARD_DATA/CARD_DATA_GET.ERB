CALL CARD_DATA_4TH, ARG

IF ARG <= 130
ENDIF

@CARD_NUMBER_GET, ARGS, L_SET = 0
#FUNCTION
#DIMS L_NAME, 1000
#DIM L_COUNT
#DIM L_SET
IF L_SET < 1
	FOR L_COUNT, 1, 1000
		SIF ARGS == L_NAME:L_COUNT
			RETURNF L_COUNT
	NEXT
	PRINTFORML %ARGS% 카드는 존재하지 않습니다.
	CLEARLINE 1
ELSEIF L_SET > 0
	L_NAME:L_SET = %ARGS%
	RETURNF 0
ENDIF
RETURNF -1
