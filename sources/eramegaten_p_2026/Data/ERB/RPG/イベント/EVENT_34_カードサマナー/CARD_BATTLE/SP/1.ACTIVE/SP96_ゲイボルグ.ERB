;特技名
@CGSP_NAME_96, ARGS, ARG
RESULTS = 게이볼그

;　コストの量
@CGSP_COST_96, ARGS, ARG
RETURN 4


;　타겟(選択するかしないか)
@CGSP_TARGET_96, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_96, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_96, ARGS, ARG, ARG:1
#DIM L_POS, 6
#DIM L_HP
#DIM L_NUM

L_HP = 0
VARSET L_POS, -1
IF FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_ONESELF
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ENDIF
L_NUM = 0
FOR LOCAL, LOCAL:1, LOCAL:2
	IF FIELD_DEMON_DATE_V:LOCAL:CBV_HP > L_HP
		L_HP = FIELD_DEMON_DATE_V:LOCAL:CBV_HP
		L_NUM = 0
		L_POS:(L_NUM ++) = LOCAL
	ELSEIF FIELD_DEMON_DATE_V:LOCAL:CBV_HP == L_HP
		L_POS:(L_NUM ++) = LOCAL
	ENDIF
NEXT
SIF L_NUM > 0
CALL SP_DAMAGE, L_POS:(RAND:L_NUM), 2, ARG
;


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_96, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_96, ARGS, ARG
RESULTS = 現ＨＰが一番高い敵仲魔に一体２Ｐのダメージを与える。『このＳＰを使ってもフリーズしない。』


;　スキルタイプ
