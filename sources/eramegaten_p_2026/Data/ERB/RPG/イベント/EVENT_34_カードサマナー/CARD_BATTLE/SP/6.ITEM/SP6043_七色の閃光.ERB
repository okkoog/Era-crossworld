
;特技名
@CGSP_NAME_6043, ARGS, ARG
RESULTS = 七色の閃光

;　コストの量
@CGSP_COST_6043, ARGS, ARG
RETURN 2
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_6043, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_6043, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_6043, ARGS, ARG, ARG:1
IF (ARG % 20) == CS1_ONESELF
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ENDIF
;
FOR LOCAL, LOCAL:1, LOCAL:2
    CALL CB_STATE_ADD, LOCAL, 13, 1
NEXT


;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_6043, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　2(このターンパワーアップは2),AP,HP,自身は1、他人は2、全体は3
@CGSP_TYPE_6043, ARGS, ARG
RESULTS = 先無
RETURN 2, 0, 0, 2

;　 説明文の表示
@CGSP_EXPLAIN_6043, ARGS, ARG
RESULTS = 味方仲魔全員を、このターンの間まで「先制無視」状態になり、アタックの時に先制攻撃されなくなる。『天空にかかる虹の力を凝縮した宝石。砕け散ると四方に拡散し、悪魔たちはみずからのスピードによってその破片を肉体に食い込ませてしまう』



