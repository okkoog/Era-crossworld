					L_SORT_LIST:L_LIST = 10000 - CARD_DATE_V:CBV_COST
				ELSEIF L_SORT == 12
					L_SORT_LIST:L_LIST = OWN_CARD:L_COUNT + 1
				ELSEIF L_SORT == 13
					L_SORT_LIST:L_LIST = 10000 - OWN_CARD:L_COUNT
				ELSEIF L_SORT == 14
					L_SORT_LIST:L_LIST = CARD_DATE_V:CBV_RARITY + 1
				ELSEIF L_SORT == 15
					L_SORT_LIST:L_LIST = 10000 - CARD_DATE_V:CBV_RARITY
				ENDIF
