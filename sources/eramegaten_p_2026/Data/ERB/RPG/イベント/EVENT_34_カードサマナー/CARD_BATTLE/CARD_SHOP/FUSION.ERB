					PRINTFORM {OWN_CARD:(CS_SP_FUSION_COMBI:L_C_TWO),4}
					RESETCOLOR
					SIF L_C_TWO < (VARSIZE("CS_SP_FUSION_COMBI") - 1)
						PRINT  ×
				NEXT
				PRINTL
			ELSE
				PRINTL ------          ？？？？？？？？
			ENDIF
		ENDIF
	NEXT 
	PRINTL [9999]돌아간다
	INPUT
	L_INPUT = RESULT
	IF L_INPUT < (VARSIZE("CS_FUSION_KNOW")) * 64 && CS_FUSION_KNOW_GET_F(L_INPUT)
		IF GETBIT(L_SP_FUSION:(L_INPUT / 64),L_INPUT % 64)
			LOCAL = CS_FUSION_NUM_COMBI_GET_F(L_INPUT)
			CALL CARD_DATA_GET, LOCAL
			PRINTFORML %CARD_DATE_S:CBS_NAME%의 소재 카드를 세트하시겠습니까?
			PRINTL [0]세트한다　[1]세트하지 않는다
			INPUT
			IF RESULT == 0
				VARSET L_CARD_SET
				L_CARD_SET:(CS_SP_FUSION_COMBI:0) ++
				L_CARD_SET:(CS_SP_FUSION_COMBI:1) ++
				L_CARD_SET:(CS_SP_FUSION_COMBI:2) ++
			ENDIF
		ELSE
			PRINTW 카드가 부족합니다
		ENDIF
	ENDIF
ELSEIF RESULT == 9999
	RETURN
ELSEIF RESULT > 9999 && RESULT < 40000
	LOCAL = RESULT
	CALL CARD_DATA_GET, LOCAL % 10000
	IF CARD_DATE_V:CBV_NO > 0
		L_SELECT = LOCAL % 10000
		LOCAL:1 = (CARD_DATE_V:CBV_LIMIT > 0 && CARD_DATE_V:CBV_LIMIT < 3 ? CARD_DATE_V:CBV_LIMIT # 3)
		SIF LOCAL / 10000 == 2 && L_CARD_SET:L_SELECT < LOCAL:1 && L_DECK_COUNT < 3 && L_CARD_SET:L_SELECT < OWN_CARD:L_SELECT
			L_CARD_SET:L_SELECT++
		SIF LOCAL / 10000 == 3 && L_CARD_SET:L_SELECT > 0
			L_CARD_SET:L_SELECT--
	ENDIF
ENDIF
GOTO INPUT_LOOP
;合体結果を出したり、合体後の結果を出す
;L_MODE	0.合体実行　1.合体結果表示のみ(認知判定あり)
@CS_CARD_FUSION, L_MODE = 0 ,L_FUSION_CARD:0, L_FUSION_CARD:1, L_FUSION_CARD:2
#DIM L_FUSION_CARD, 3
#DIM L_MODE
#DIM L_FUSION_RESULT
#DIM L_COUNT
#DIM L_CATEGORY
#DIM L_SP
#DIM L_RES
#DIM L_R_SUM

ARRAYSORT L_FUSION_CARD
L_FUSION_RESULT = 0
L_CATEGORY = 0

FOR L_COUNT, 0, VARSIZE("CS_FUSION_KNOW") * 64
	L_RES = CS_FUSION_NUM_COMBI_GET_F(L_COUNT)
	IF L_RES != 0 && CS_SP_FUSION_COMBI:0 == L_FUSION_CARD:0 && CS_SP_FUSION_COMBI:1 == L_FUSION_CARD:1 && CS_SP_FUSION_COMBI:2 == L_FUSION_CARD:2
		L_FUSION_RESULT = L_RES
		L_SP = L_COUNT
		IF L_MODE == 1 && !CS_FUSION_KNOW_GET_F(L_COUNT)
			;
			L_FUSION_RESULT = 0
		ELSEIF L_MODE == 0 && !CS_FUSION_KNOW_GET_F(L_COUNT)
			PRINTFORMW 특수합체다！
			CALL CS_FUSION_KNOW_SET(L_SP)
		ENDIF
		BREAK
	ENDIF
NEXT
SIF L_FUSION_RESULT != 0
	RETURN L_FUSION_RESULT, L_CATEGORY

L_R_SUM = 0
FOR L_COUNT, 0, 3
	CALL CARD_DATA_GET, L_FUSION_CARD:L_COUNT
	IF CARD_DATE_V:CBV_NO != 0
		L_R_SUM += CARD_DATE_V:CBV_RARITY
	ELSE
		RETURN 0, L_CATEGORY
	ENDIF
NEXT
IF L_R_SUM >= 45
	L_CATEGORY = 10
ELSEIF L_R_SUM >= 43
	L_CATEGORY = 9
ELSEIF L_R_SUM >= 39
	L_CATEGORY = 8
ELSEIF L_R_SUM >= 32
	L_CATEGORY = 7
ELSEIF L_R_SUM >= 31
	L_CATEGORY = 6
ELSEIF L_R_SUM >= 26
	L_CATEGORY = 5
ELSEIF L_R_SUM >= 16
	L_CATEGORY = 4
ELSEIF L_R_SUM >= 15
	L_CATEGORY = 3
ELSEIF L_R_SUM >= 9
	L_CATEGORY = 2
ELSEIF L_R_SUM >= 1
	L_CATEGORY = 1
ENDIF

IF L_MODE == 0
	SIF L_CATEGORY == 7 && !RAND:3
		RETURN 395, L_CATEGORY
	SIF L_CATEGORY == 8 && !RAND:3
		RETURN 397, L_CATEGORY
	SIF L_CATEGORY == 9 && !RAND:3
		RETURN 393, L_CATEGORY
	SIF L_CATEGORY == 10 && !RAND:3
		RETURN 556, L_CATEGORY
	CALL CS_CARD_SHOP_LINEUP, L_CATEGORY, 100
	RETURN CS_SHOP_CL:(RAND:CS_SHOP_CC)
ELSEIF L_MODE == 1
	;
	RETURN 0, L_CATEGORY
ENDIF

@CS_FUSION_KNOW_CHECK, ARG:0 = -1, ARG:1 = -1, ARG:2 = -1, ARG:3 = -1, ARG:4 = -1, ARG:5 = -1, ARG:6 = -1
#FUNCTION
#DIM L_COUNT

IF ARG:0 == -99
	FOR L_COUNT, 0, VARSIZE("CS_FUSION_KNOW") * 64
		SIF CS_FUSION_NUM_COMBI_GET_F(L_COUNT, 0) == 0
			CONTINUE
		SIF !CS_FUSION_KNOW_GET_F(L_COUNT)
			RETURNF 0
	NEXT
	RETURNF 1
ELSE
	SIF ARG:0 < 0
		RETURNF 0

	FOR L_COUNT, 0, VARSIZE("ARG")
		SIF ARG:L_COUNT < 0
			CONTINUE
		SIF CS_FUSION_NUM_COMBI_GET_F(ARG:L_COUNT, 0) == 0
			CONTINUE
		SIF !CS_FUSION_KNOW_GET_F(ARG:L_COUNT)
			RETURNF 0
	NEXT
	RETURNF 1
ENDIF
RETURNF 0






