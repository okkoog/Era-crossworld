INPUT

IF RESULT == 1 || RESULT == 2
	IF RESULT == 1
		L_ALI_SET++
	ELSE
		L_ALI_SET--
	ENDIF
	SIF L_ALI_SET % 10 == 4
		L_ALI_SET += 7
	SIF L_ALI_SET % 10 == 0
