;잔/1/0/
;特技名
@CGSP_NAME_6010, ARGS, ARG
RESULTS = ネオクリア

;　コストの量
@CGSP_COST_6010, ARGS, ARG
RETURN 2

;　타겟(選択するかしないか)
@CGSP_TARGET_6010, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_6010, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　4-召喚時

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_6010, ARGS, ARG, ARG:1
IF (ARG % 20) == CS1_ONESELF
	LOCAL = CS1_OPPONENT
ELSE
	LOCAL = CS1_ONESELF
ENDIF

CALL CS_CARD_DECK_DEL, LOCAL, 0, 3
CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(LOCAL) + @"は山札を３枚捨てた。"

;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_6010, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_6010, ARGS, ARG
RESULTS = 敵サマナーの山札からカードを3枚すてる。『敵のコンピュータのプログラムをデリートすることができるソフト』


;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　1(アギとかのダメージ魔法系は1),ダメージ,範囲1体は1、全体は2
@CGSP_TYPE_6010, ARGS, ARG
RETURN 22, 3, 999

