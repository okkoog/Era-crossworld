		INPUT
		IF RESULT == 0 && 160 <= MONEY:5
			IF LOCAL < (L_PACK_C * 1)
				CALL CS_CARD_SHOP_LINEUP, 1, 50
			ELSEIF LOCAL < (L_PACK_C * 1)
				CALL CS_CARD_SHOP_LINEUP, 2, 50
			ENDIF
			
			MONEY:5 -= 160
			FOR L_COUNT, 0, VARSIZE("L_GET_CARD", 0)
				L_GET_CARD:L_COUNT = CS_SHOP_CL:(SC_SS:(LOCAL * 4 + 500 + L_COUNT) % CS_SHOP_CC)
				OWN_CARD:(L_GET_CARD:L_COUNT) ++
			NEXT
			SC_SS:(LOCAL * 4 + 700) = 0
			$LP
			CLEARLINE LINECOUNT - L_LINE
			
			CALL SET_PICTURE, , , "消去"
			CALL SET_PICTURE , @"입수 카드" , 4 , , 25
			FOR L_COUNT, 0, VARSIZE("L_GET_CARD", 0)
				IF L_GET_CARD:L_COUNT > 0
