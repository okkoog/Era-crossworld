;入力							
CALL INPUTINT(0,1,2,3,4,5,9,10,99)
IF RESULT == 0
	CLEARLINE LINECOUNT - L_LINE

	{
	CALL CS_CARD_SHOP_PICTURE, E34_C_ICON_B("マキ"),
	"마키:" + "/" + 
	"「다음에 또 와」"
	}

	DRAWLINE
	PRINTL
	PRINTL
	PRINTL
	PRINTL
	PRINTL
	DRAWLINE
	PRINTL
	TWAIT 2000,0
	RETURN 0
ELSEIF RESULT == 1
	CALL CS_SINGLE_SHOP
ELSEIF RESULT == 2
	CALL BOOSTER_PACK
ELSEIF RESULT == 3
	SIF CS_CARDSHOP_RANK() > 1
		CALL ZOKUSEI_PACK
ELSEIF RESULT == 4
	SIF CS_CARDSHOP_RANK() > 1
		CALL GATTAI_PACK
ELSEIF RESULT == 5
	SIF CS_CARDSHOP_RANK() > 2
		CALL CS_GOD_DRAW
ELSEIF RESULT == 9
	;CALL RAG_SOZAI
	SIF CS_CARDSHOP_RANK() > 2
		CALL CS_SINGLE_RARE
ELSEIF RESULT == 10
	{
	CALL CS_CARD_SHOP_PICTURE, E34_C_ICON_B("マキ"),
	"마키:" + "/" + 
	"「쇼핑은 처음이야?" + "/" + 
	"　쇼핑은 전용 디지털 머니를 사용해줘」"
	}
	WAIT
	GOTO SHOP_START
ELSEIF RESULT == 99
	CALL CS_CARD_SELLING
ELSE
	CLEARLINE 1
ENDIF
IF RESULT == 0
	DRAWLINE
	PRINTL
	{
	CALL CS_CARD_SHOP_PICTURE, E34_C_ICON_B("マキ"),
	"마키:" + "/" + 
	"「다음에 또 와」"
	}
	DRAWLINE
	PRINTL
	PRINTL
	DRAWLINE
	PRINTL
	TWAIT 2000,0
	RETURN 0
ENDIF
IF RESULT == -1
	CUSTOMDRAWLINE =
	GOTO SHOP_START
ENDIF


@CS_SINGLE_SHOP
#DIM L_COUNT
#DIM L_SELECT
#DIM L_LINEUP,30
#DIM L_LINE
L_LINE = LINECOUNT

$LP
VARSET L_LINEUP
CALL CS_CARD_SHOP_LINEUP, 1, 1
FOR L_COUNT, 0, 6
	SIF SC_SS:(L_COUNT + 10) < 1
		CONTINUE
	L_LINEUP:L_COUNT = CS_SHOP_CL:(SC_SS:(L_COUNT + 10) % CS_SHOP_CC)
NEXT
IF CS_CARDSHOP_RANK() > 0
	CALL CS_CARD_SHOP_LINEUP, 2, 1
	FOR L_COUNT, 6, 12
		SIF SC_SS:(L_COUNT + 10) < 1
			CONTINUE
		L_LINEUP:L_COUNT = CS_SHOP_CL:(SC_SS:(L_COUNT + 10) % CS_SHOP_CC)
	NEXT
ENDIF
IF CS_CARDSHOP_RANK() > 1
	CALL CS_CARD_SHOP_LINEUP, 3, 1
	FOR L_COUNT, 12, 18
		SIF SC_SS:(L_COUNT + 10) < 1
			CONTINUE
		L_LINEUP:L_COUNT = CS_SHOP_CL:(SC_SS:(L_COUNT + 10) % CS_SHOP_CC)
	NEXT
ENDIF
IF CS_CARDSHOP_RANK() > 2
	CALL CS_CARD_SHOP_LINEUP, 4, 1
	FOR L_COUNT, 18, 24
		SIF SC_SS:(L_COUNT + 10) < 1
			CONTINUE
		L_LINEUP:L_COUNT = CS_SHOP_CL:(SC_SS:(L_COUNT + 10) % CS_SHOP_CC)
	NEXT
ENDIF

$INPUT_LOOP
CLEARLINE LINECOUNT - L_LINE
CALL SET_PICTURE, , , "消去"
FOR L_COUNT, 0, VARSIZE("L_LINEUP", 0)
	IF L_LINEUP:L_COUNT > 0
		CALL CARD_DATA_GET, L_LINEUP:L_COUNT
		CALL SET_PICTURE , @"[{L_COUNT,2}]%CARD_DATE_S:CBS_NAME%,{L_COUNT == L_SELECT ? COLOR("P-GREEN") # COLOR("WHITE")},,{L_COUNT}" , L_COUNT + 5 , , 25
		CALL SET_PICTURE , @"Ð{CARD_DATE_V:CBV_BUY,5}" , L_COUNT + 5 , , 50
		CALL SET_PICTURE , @"所持数:{OWN_CARD:(L_LINEUP:L_COUNT)}" , L_COUNT + 5 , , 60
		CALL SET_PICTURE , @"[{L_COUNT + 1000,3}]구매,,,{L_COUNT + 1000}" , L_COUNT + 5 , , 70
	ELSE
		CALL SET_PICTURE , @"[--]SOLD OUT,{COLOR("DARK-GRAY")}" , L_COUNT + 5 , , 25
	ENDIF
NEXT
CALL SET_PICTURE , @"D-MONEY：{MONEY:5}" , 38, , 25
CALL SET_PICTURE , @"[999]돌아간다,,,999" , 40, , 25
CALL CARDDATA_WINDOW , L_LINEUP:L_SELECT , 0 , 0 , 50

CALL SET_PICTURE, , 0, "HTML表示", 50

INPUT


IF 0 <= RESULT && RESULT < 30 && L_LINEUP:RESULT > 0
	L_SELECT = RESULT
ELSEIF RESULT == 999
	RETURN -1
ELSEIF 1000 <= RESULT && RESULT < 2000 && L_LINEUP:(RESULT - 1000) > 0
	LOCAL = RESULT - 1000
	CALL CARD_DATA_GET, L_LINEUP:LOCAL
	{
	CALL CS_CARD_SHOP_PICTURE, E34_C_ICON_B("マキ"),
	"마키:" + "/" + 
	@"「%CARD_DATE_S:CBS_NAME%으로 하는 거네." + "/" + 
	@"　Ð{CARD_DATE_V:CBV_BUY}이야.」"
	}
	PRINTFORML [0]산다　[1]사지 않는다
	INPUT
	IF RESULT == 0 && CARD_DATE_V:CBV_BUY <= MONEY:5
		PRINTFORMW %CARD_DATE_S:CBS_NAME%을(를) 구입했다.
		
		OWN_CARD:(L_LINEUP:LOCAL) ++
		MONEY:5 -= CARD_DATE_V:CBV_BUY
		SC_SS:(LOCAL + 10) = 0
		GOTO LP
	ELSEIF RESULT == 0
		{
		CALL CS_CARD_SHOP_PICTURE, E34_C_ICON_B("マキ"),
		"마키:" + "/" + 
		@"「어머, 가진 돈이 부족한 것 같네.」"
		}
	ENDIF
	
	
	
ENDIF
GOTO INPUT_LOOP

@BOOSTER_PACK
#DIM L_COUNT
#DIM L_SELECT
#DIM L_OK
;#DIM L_BUY_C
#DIM L_LINE
#DIM L_GET_CARD,6

L_LINE = LINECOUNT
;L_BUY_C = 5
;SIF CS_CARDSHOP_RANK() > 0
;	L_BUY_C = 10
;SIF CS_CARDSHOP_RANK() > 1
;	L_BUY_C = 15
$INPUT_LOOP
CLEARLINE LINECOUNT - L_LINE

L_OK = 0

FOR L_COUNT, 0, ((CS_CARDSHOP_RANK() + 1) * 5)
	IF SC_SS:(L_COUNT * 6 + 200) > 0
		IF L_COUNT < 5
			LOCALS:L_COUNT = 부스터 팩 1ST
		ELSEIF L_COUNT < 10
			LOCALS:L_COUNT = 부스터 팩 2ND
		ELSEIF L_COUNT < 15
			LOCALS:L_COUNT = 부스터 팩 3RD
		ELSEIF L_COUNT < 20
			LOCALS:L_COUNT = 부스터 팩 4TH
		ENDIF
		PRINTFORML [{L_COUNT,2}] %LOCALS:L_COUNT% Ð200
		SETBIT L_OK, L_COUNT
	ELSE
		PRINTFORML  --  SOLD OUT
	ENDIF
NEXT
PRINTFORML
PRINTFORML
PRINTFORML D-MONEY：{MONEY:5}
PRINTFORML
PRINTFORML [999] 돌아간다
PRINTFORML [1001] 1ST 라인업
SIF CS_CARDSHOP_RANK() > 0
	PRINTFORML [1002] 2ND 라인업
SIF CS_CARDSHOP_RANK() > 1
	PRINTFORML [1003] 3RD 라인업
SIF CS_CARDSHOP_RANK() > 2
	PRINTFORML [1003] 4TH 라인업
INPUT
IF 0 <= RESULT && RESULT < 64
	LOCAL = RESULT
	
	IF GETBIT(L_OK, LOCAL)
		{
		CALL CS_CARD_SHOP_PICTURE, E34_C_ICON_B("マキ"),
		"마키:" + "/" + 
		@"「%LOCALS:LOCAL%(으)로 하는 거네." + "/" + 
		@"　Ð200이야.」"
		}
		PRINTFORML [0]산다　[1]사지 않는다
		INPUT
		IF RESULT == 0 && 200 <= MONEY:5
			;PRINTFORMW %CARD_DATE_S:CBS_NAME%을(를) 구입했다.
			;CALL CS_CARD_SHOP_LINEUP, 1, 2
			IF LOCAL < 5
				CALL CS_CARD_SHOP_LINEUP, 1, 2
			ELSEIF LOCAL < 10
				CALL CS_CARD_SHOP_LINEUP, 2, 2
			ELSEIF LOCAL < 15
				CALL CS_CARD_SHOP_LINEUP, 3, 2
			ELSEIF LOCAL < 20
				CALL CS_CARD_SHOP_LINEUP, 4, 2
			ENDIF
			
			MONEY:5 -= 200
			FOR L_COUNT, 0, VARSIZE("L_GET_CARD", 0)
				L_GET_CARD:L_COUNT = CS_SHOP_CL:(SC_SS:(LOCAL * 6 + 200 + L_COUNT) % CS_SHOP_CC)
				OWN_CARD:(L_GET_CARD:L_COUNT) ++
			NEXT
			SC_SS:(LOCAL * 6 + 200) = 0
			$LP
			CLEARLINE LINECOUNT - L_LINE
			
			CALL SET_PICTURE, , , "消去"
			CALL SET_PICTURE , @"입수 카드" , 4 , , 25
			FOR L_COUNT, 0, VARSIZE("L_GET_CARD", 0)
				IF L_GET_CARD:L_COUNT > 0
					CALL CARD_DATA_GET, L_GET_CARD:L_COUNT
					CALL SET_PICTURE , @"[{L_COUNT,2}]%CARD_DATE_S:CBS_NAME%,{L_COUNT == L_SELECT ? COLOR("P-GREEN") # COLOR("WHITE")},,{L_COUNT}" , L_COUNT + 5 , , 25
					CALL SET_PICTURE , @"所持数:{OWN_CARD:(L_GET_CARD:L_COUNT)}" , L_COUNT + 5 , , 50
				ENDIF
			NEXT
			CALL SET_PICTURE , @"[999]돌아간다,,,999" , 40, , 25
			CALL CARDDATA_WINDOW , L_GET_CARD:L_SELECT , 0 , 0 , 50

			CALL SET_PICTURE, , 0, "HTML表示", 50

			INPUT
			
			IF 0 <= RESULT && RESULT < 6
				L_SELECT = RESULT
				GOTO LP
			ELSEIF RESULT == 999
			ELSE
				GOTO LP
			ENDIF
		ELSEIF RESULT == 0
			{
			CALL CS_CARD_SHOP_PICTURE, E34_C_ICON_B("マキ"),
			"마키:" + "/" + 
			@"「어머, 가진 돈이 부족한 것 같네.」"
			}
		ENDIF
	ENDIF
ELSEIF RESULT == 999
	RETURN -1
ELSEIF 1000 < RESULT && RESULT < 1004
	SIF 1001 == RESULT
		CALL CS_CARD_SHOP_LINEUP, 1, 2
	SIF 1002 == RESULT
		CALL CS_CARD_SHOP_LINEUP, 2, 2
	SIF 1003 == RESULT
		CALL CS_CARD_SHOP_LINEUP, 3, 2
	SIF 1004 == RESULT
		CALL CS_CARD_SHOP_LINEUP, 4, 2

	CALL CS_CARDSHOP_LINEUP_SHOW
	
	
ENDIF
GOTO INPUT_LOOP


@ZOKUSEI_PACK
#DIM L_COUNT
#DIM L_SELECT
#DIM L_OK
;#DIM L_BUY_C
#DIM L_LINE
#DIM L_GET_CARD,4
#DIMS L_ZOKUSEI_S = "LIGHT", "DARK", "LAW", "CHAOS", "NEUTRAL"
#DIM L_ZOKUSEI_N = 10, 30, 41, 43, 44
#DIM L_P_ZOKUSEI

L_LINE = LINECOUNT
;L_BUY_C = 5
;SIF CS_CARDSHOP_RANK() > 0
;	L_BUY_C = 10
;SIF CS_CARDSHOP_RANK() > 1
;	L_BUY_C = 15
$INPUT_LOOP
CLEARLINE LINECOUNT - L_LINE

L_OK = 0

FOR L_COUNT, 0, ((CS_CARDSHOP_RANK() - 1) * 4)
	IF SC_SS:(L_COUNT * 4 + 500) > 0
		L_P_ZOKUSEI = SC_SS:(L_COUNT * 4 + 500) % 5
		IF L_COUNT < 4
			LOCALS:L_COUNT = %L_ZOKUSEI_S:L_P_ZOKUSEI%속성 팩 A
		ELSEIF L_COUNT < 8
			LOCALS:L_COUNT = %L_ZOKUSEI_S:L_P_ZOKUSEI%속성 팩 B
		ENDIF
		PRINTFORML [{L_COUNT,2}] %LOCALS:L_COUNT% Ð180
		SETBIT L_OK, L_COUNT
	ELSE
		PRINTFORML  --  SOLD OUT
	ENDIF
NEXT
PRINTFORML
PRINTFORML
PRINTFORML D-MONEY：{MONEY:5}
PRINTFORML
PRINTFORML [999] 돌아간다
IF CS_CARDSHOP_RANK() > 1
	PRINTFORML [1001] LIGHT속성 A 라인업　[1002] DARK속성 A 라인업　[1003] LAW속성 A 라인업
	PRINTFORML [1004] CHAOS속성 A 라인업　[1005] NEUTRAL속성 A 라인업
ENDIF
IF CS_CARDSHOP_RANK() > 2
	PRINTFORML [1011] LIGHT속성 B 라인업　[1012] DARK속성 B 라인업　[1013] LAW속성 B 라인업
	PRINTFORML [1014] CHAOS속성 B 라인업　[1015] NEUTRAL속성 B 라인업
ENDIF
INPUT
IF 0 <= RESULT && RESULT < 64
	LOCAL = RESULT
	
	IF GETBIT(L_OK, LOCAL)
		{
		CALL CS_CARD_SHOP_PICTURE, E34_C_ICON_B("マキ"),
		"마키:" + "/" + 
		@"「%LOCALS:LOCAL%(으)로 하는 거네." + "/" + 
		@"　Ð180이야.」"
		}
		PRINTFORML [0]산다　[1]사지 않는다
		INPUT
		IF RESULT == 0 && 180 <= MONEY:5
			L_P_ZOKUSEI = SC_SS:(LOCAL * 4 + 500) % 5

			;PRINTFORMW %CARD_DATE_S:CBS_NAME%을(를) 구입했다.
			;CALL CS_CARD_SHOP_LINEUP, 1, 2
			;PRINTFORMW {LOCAL} {L_ZOKUSEI_N:L_P_ZOKUSEI}
			IF LOCAL < 4
				CALL CS_CARD_SHOP_LINEUP, 1, L_ZOKUSEI_N:L_P_ZOKUSEI
			ELSEIF LOCAL < 8
				CALL CS_CARD_SHOP_LINEUP, 2, L_ZOKUSEI_N:L_P_ZOKUSEI
			ENDIF
			
			MONEY:5 -= 180
			FOR L_COUNT, 0, VARSIZE("L_GET_CARD", 0)
				L_GET_CARD:L_COUNT = CS_SHOP_CL:(SC_SS:(LOCAL * 4 + 500 + L_COUNT) % CS_SHOP_CC)
				OWN_CARD:(L_GET_CARD:L_COUNT) ++
			NEXT
			SC_SS:(LOCAL * 4 + 500) = 0
			$LP
			CLEARLINE LINECOUNT - L_LINE
			
			CALL SET_PICTURE, , , "消去"
			CALL SET_PICTURE , @"입수 카드" , 4 , , 25
			FOR L_COUNT, 0, VARSIZE("L_GET_CARD", 0)
				IF L_GET_CARD:L_COUNT > 0
					CALL CARD_DATA_GET, L_GET_CARD:L_COUNT
					CALL SET_PICTURE , @"[{L_COUNT,2}]%CARD_DATE_S:CBS_NAME%,{L_COUNT == L_SELECT ? COLOR("P-GREEN") # COLOR("WHITE")},,{L_COUNT}" , L_COUNT + 5 , , 25
					CALL SET_PICTURE , @"所持数:{OWN_CARD:(L_GET_CARD:L_COUNT)}" , L_COUNT + 5 , , 50
				ENDIF
			NEXT
			CALL SET_PICTURE , @"[999]돌아간다,,,999" , 40, , 25
			CALL CARDDATA_WINDOW , L_GET_CARD:L_SELECT , 0 , 0 , 50

			CALL SET_PICTURE, , 0, "HTML表示", 50

			INPUT
			
			IF 0 <= RESULT && RESULT < 4
				L_SELECT = RESULT
				GOTO LP
			ELSEIF RESULT == 999
			ELSE
				GOTO LP
			ENDIF
		ELSEIF RESULT == 0
			{
			CALL CS_CARD_SHOP_PICTURE, E34_C_ICON_B("マキ"),
			"마키:" + "/" + 
			@"「어머, 가진 돈이 부족한 것 같네.」"
			}
		ENDIF
	ENDIF
ELSEIF RESULT == 999
	RETURN -1
ELSEIF 1000 < RESULT && RESULT < 2000
	IF 1010 > RESULT
		CALL CS_CARD_SHOP_LINEUP, 1, L_ZOKUSEI_N:(RESULT % 10 - 1)
	ELSEIF 1020 > RESULT
		CALL CS_CARD_SHOP_LINEUP, 2, L_ZOKUSEI_N:(RESULT % 10 - 1)
	ENDIF

	CALL CS_CARDSHOP_LINEUP_SHOW
	
	
ENDIF
GOTO INPUT_LOOP

@GATTAI_PACK
#DIM L_COUNT
#DIM L_SELECT
#DIM L_OK
;#DIM L_BUY_C
#DIM L_LINE
#DIM L_GET_CARD,4
#DIM L_P_ZOKUSEI
#DIM L_PACK_C = 3

L_LINE = LINECOUNT
;L_BUY_C = 5
;SIF CS_CARDSHOP_RANK() > 0
;	L_BUY_C = 10
;SIF CS_CARDSHOP_RANK() > 1
;	L_BUY_C = 15
$INPUT_LOOP
CLEARLINE LINECOUNT - L_LINE

L_OK = 0

FOR L_COUNT, 0, ((CS_CARDSHOP_RANK() - 1) * L_PACK_C)
	IF SC_SS:(L_COUNT * 4 + 700) > 0
		L_P_ZOKUSEI = SC_SS:(L_COUNT * 4 + 500) % 5
		IF L_COUNT < (L_PACK_C * 1)
			LOCALS:L_COUNT = 합체 중마 팩 A
		ELSEIF L_COUNT < (L_PACK_C * 2)
			LOCALS:L_COUNT = 합체 중마 팩 B
		ENDIF
		PRINTFORML [{L_COUNT,2}] %LOCALS:L_COUNT% Ð160
		SETBIT L_OK, L_COUNT
	ELSE
		PRINTFORML  --  SOLD OUT
	ENDIF
NEXT
PRINTFORML
PRINTFORML
