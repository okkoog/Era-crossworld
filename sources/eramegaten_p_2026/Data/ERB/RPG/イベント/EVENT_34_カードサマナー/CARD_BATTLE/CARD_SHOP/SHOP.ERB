SIF CS_CARDSHOP_RANK() > 1
	PRINTFORML [1001] 팩 A 라인업
SIF CS_CARDSHOP_RANK() > 2
	PRINTFORML [1002] 팩 B 라인업
INPUT
IF 0 <= RESULT && RESULT < 64
	LOCAL = RESULT
	
	IF GETBIT(L_OK, LOCAL)
		{
		CALL CS_CARD_SHOP_PICTURE, E34_C_ICON_B("マキ"),
		"마키:" + "/" + 
		@"「%LOCALS:LOCAL%(으)로 하는 거네." + "/" + 
