;		ゴッドドローの場合　1が基本、ピンキリ
;		カード合体の場合　1～10　カテゴリ別
;		連勝バトルの賞品　1～5　これ以上は種類が少ないので直接渡す
;ARG:1	종류　1-シングル　2-ブースター　10～44属性パック　50合体パック 98ゴッドドロー 99レア
;       属性パック　11～33それぞれの属性　10ライト　20LiDa以外　30ダーク
;										  41ロウ　　42LaCa以外　43カオス
;										  44ニュートラル
;       100-カード合体（ランダム用）
;       200-連勝バトルの賞品（高レアを制限するため）
@CS_CARD_SHOP_LINEUP, ARG = 0, ARG:1 = 0
#DIM L_COUNT
#DIM L_START
#DIM L_END
#DIM L_OK
#DIM L_PACK_BIT = 0
VARSET CS_SHOP_CC
VARSET CS_SHOP_CL
L_PACK_BIT = 0

IF ARG:1 == 1 || ARG:1 == 2
	IF ARG == 1
		SETBIT L_PACK_BIT,1
	ELSEIF ARG == 2
		SETBIT L_PACK_BIT,2
	ELSEIF ARG == 3
		SETBIT L_PACK_BIT,3
	ELSEIF ARG == 4
		SETBIT L_PACK_BIT,4
	ENDIF
ELSEIF 10 <= ARG:1 && ARG:1 <= 50
	IF ARG == 1
		SETBIT L_PACK_BIT,1
		SETBIT L_PACK_BIT,2
		SETBIT L_PACK_BIT,3
	ELSEIF ARG == 2
		SETBIT L_PACK_BIT,2
		SETBIT L_PACK_BIT,3
		SETBIT L_PACK_BIT,4
	ENDIF
ELSEIF ARG:1 == 99 || ARG:1 == 98
	SETBIT L_PACK_BIT,1
	SETBIT L_PACK_BIT,2
	SETBIT L_PACK_BIT,3
	SETBIT L_PACK_BIT,4
ELSEIF ARG:1 == 100
	SETBIT L_PACK_BIT,1
	SETBIT L_PACK_BIT,2
	SETBIT L_PACK_BIT,3
	SETBIT L_PACK_BIT,4
ELSEIF ARG:1 == 200
	SETBIT L_PACK_BIT,1
	SETBIT L_PACK_BIT,2
	SETBIT L_PACK_BIT,3
	SETBIT L_PACK_BIT,4
ENDIF

FOR L_COUNT, 0, 999
	CALL CARD_DATA_GET, L_COUNT
	SIF CARD_DATE_V:CBV_NO < 1
		CONTINUE
	
	IF 10 <= ARG:1 && ARG:1 < 50
		SIF CARD_DATE_V:CBV_KINDS >= 100
			CONTINUE
		IF 0 < ARG:1 % 10 && ARG:1 % 10 < 4 && 0 < ARG:1 / 10 && ARG:1 / 10 < 4
			SIF CARD_DATE_V:CBV_KINDS != ARG:1
				CONTINUE
		ELSEIF ARG:1 == 10
			SIF !CS_KIND_CHECK(-1 ,"LIGHT")
				CONTINUE
		ELSEIF ARG:1 == 20
			SIF !CS_KIND_CHECK(-1 ,"N ")
				CONTINUE
		ELSEIF ARG:1 == 30
			SIF !CS_KIND_CHECK(-1 ,"DARK")
				CONTINUE
		ELSEIF ARG:1 == 41
			SIF !CS_KIND_CHECK(-1 ,"LAW")
				CONTINUE
		ELSEIF ARG:1 == 42
			SIF !CS_KIND_CHECK(-1 ," N")
				CONTINUE
		ELSEIF ARG:1 == 43
			SIF !CS_KIND_CHECK(-1 ,"CHAOS")
				CONTINUE
		ELSEIF ARG:1 == 44
			SIF !CS_KIND_CHECK(-1 ,"NEUTRAL")
				CONTINUE
		ELSE
			CONTINUE
		ENDIF
	ENDIF


	SIF ARG:1 == 50 && (CARD_DATE_V:CBV_KINDS >= 100 || CARD_DATE_V:CBV_FUSION < 2)
		CONTINUE

	L_OK = 0
	SIF ARG:1 == 43 && EQUALCHECK(L_COUNT, 3, 173, 330, 334, 502)
		L_OK = 1
	SIF ARG:1 == 44 && EQUALCHECK(L_COUNT, 25, 170, 411, 579, 591)
		L_OK = 1
	SIF ARG:1 == 50 && EQUALCHECK(L_COUNT, 327 ,344, 408, 453, 459, 486, 587)
		L_OK = 1
	SIF ARG:1 == 99 && EQUALCHECK(L_COUNT, 4, 5, 8, 99, 100, 323, 332, 373, 393, 456, 470, 498, 509, 527, 540, 547, 556, 563)
		L_OK = 1

	SIF ARG:1 == 98 && ARG:0 == 1 && EQUALCHECK(L_COUNT, 15, 110, 178, 188, 291, 298, 328, 334, 344, 349, 360)
		L_OK = 1
	SIF ARG:1 == 98 && ARG:0 == 1 && EQUALCHECK(L_COUNT, 388, 395, 453, 459, 467, 471, 477, 493, 512)
		L_OK = 1
	SIF ARG:1 == 98 && ARG:0 == 1 && EQUALCHECK(L_COUNT, 232, 332, 500, 504, 548)
		L_OK = 1

	IF ARG:1 == 100
		SIF CARD_DATE_V:CBV_RARITY < 1
			CONTINUE
		IF ARG == 1 && 1 != CARD_DATE_V:CBV_RARITY
			CONTINUE
		ELSEIF ARG == 2 && 4 < CARD_DATE_V:CBV_RARITY
			CONTINUE
		ELSEIF ARG == 3 && (CARD_DATE_V:CBV_RARITY < 3 || 8 < CARD_DATE_V:CBV_RARITY)
			CONTINUE
		ELSEIF ARG == 4 && (CARD_DATE_V:CBV_RARITY < 6 || 9 < CARD_DATE_V:CBV_RARITY)
			CONTINUE
		ELSEIF ARG == 5 && (CARD_DATE_V:CBV_RARITY < 5 || 10 < CARD_DATE_V:CBV_RARITY)
			CONTINUE
		ELSEIF ARG == 6 && (CARD_DATE_V:CBV_RARITY < 7 || 11 < CARD_DATE_V:CBV_RARITY)
			CONTINUE
		ELSEIF ARG == 7
			SIF EQUALCHECK(L_COUNT, 177, 212, 213, 214, 215, 258, 292, 293, 294, 395, 411, 415, 471) ;395
				L_OK = 1
			SIF L_OK == 0
				CONTINUE
		ELSEIF ARG == 8
			SIF EQUALCHECK(L_COUNT, 25, 232, 291, 298, 300, 325, 328, 330, 332, 334, 334, 397) ;397
				L_OK = 1
			SIF L_OK == 0
				CONTINUE
		ELSEIF ARG == 9
			SIF EQUALCHECK(L_COUNT, 92, 130, 174, 296, 323, 326, 327, 331, 333, 358, 393, 452, 571) ;393
				L_OK = 1
			SIF L_OK == 0
				CONTINUE
		ELSEIF ARG == 10
			SIF EQUALCHECK(L_COUNT, 69, 90, 99, 186, 202, 341, 347, 375, 408, 470, 524, 556) ;556
				L_OK = 1
			SIF L_OK == 0
				CONTINUE
		ENDIF
	ELSEIF ARG:1 == 200
		SIF CARD_DATE_V:CBV_RARITY < 1
			CONTINUE
		IF 0
		ELSEIF ARG == 5
			IF EQUALCHECK(L_COUNT, 298, 330, 334)
				L_OK = 1
			ELSEIF L_COUNT < 101 || 114 < L_COUNT
				CONTINUE
			ENDIF
		ELSEIF ARG == 4
			IF EQUALCHECK(L_COUNT, 391, 113, 372)
				L_OK = 1
			ELSEIF L_COUNT < 5 || 25 < L_COUNT
				CONTINUE
			ENDIF
		ELSEIF ARG == 3
			SIF L_COUNT < 233 || 290 < L_COUNT
				CONTINUE
		ELSEIF ARG == 2
			SIF L_COUNT < 115 || 172 < L_COUNT
				CONTINUE
		ELSEIF ARG == 1
			SIF L_COUNT < 26 || 68 < L_COUNT
				CONTINUE
		ENDIF

	ENDIF
		
	SIF ARG:1 == 98 && L_OK == 0
		CONTINUE
	SIF ARG:1 == 99 && L_OK == 0
		CONTINUE


	IF 0 < CARD_DATE_V:CBV_NO && CARD_DATE_V:CBV_NO <= 130 && GETBIT(L_PACK_BIT, 1)
		{
		IF (CARD_DATE_V:CBV_RARITY < 12)
		|| (ARG:1 == 1 && EQUALCHECK(L_COUNT, 25, 110, 114, 128))
		|| (ARG:1 == 2 && EQUALCHECK(L_COUNT, 15, 25, 92, 110, 128, 130))
		|| (ARG:1 == 10 && EQUALCHECK(L_COUNT, 114))
		|| (ARG:1 == 30 && EQUALCHECK(L_COUNT, 130))
		|| (ARG:1 == 41 && EQUALCHECK(L_COUNT, 92))
		|| L_OK
		}
			CS_SHOP_CL:(CS_SHOP_CC ++) = L_COUNT
		ENDIF
	ELSEIF 130 < CARD_DATE_V:CBV_NO && CARD_DATE_V:CBV_NO <= 280 && GETBIT(L_PACK_BIT, 2)
		{
		IF (CARD_DATE_V:CBV_RARITY < 12)
		|| (ARG:1 == 1 && EQUALCHECK(L_COUNT, 204, 258))
		|| (ARG:1 == 2 && EQUALCHECK(L_COUNT, 178, 180, 260))
		|| (ARG:1 == 10 && EQUALCHECK(L_COUNT, 258))
		|| (ARG:1 == 30 && EQUALCHECK(L_COUNT, 174, 204))
		|| (ARG:1 == 41 && EQUALCHECK(L_COUNT, 178))
		|| L_OK
		}
			CS_SHOP_CL:(CS_SHOP_CC ++) = L_COUNT
		ENDIF
	ELSEIF 280 < CARD_DATE_V:CBV_NO && CARD_DATE_V:CBV_NO <= 440 && GETBIT(L_PACK_BIT, 3)
		{
		IF (CARD_DATE_V:CBV_RARITY < 12)
		|| (ARG:1 == 1 && EQUALCHECK(L_COUNT, 293, 325, 328, 344, 349, 386, 388, 395, 411))
		|| (ARG:1 == 2 && EQUALCHECK(L_COUNT, 333, 359, 360, 386, 415))
		|| (ARG:1 == 10 && EQUALCHECK(L_COUNT, 296, 298, 328))
		|| (ARG:1 == 30 && EQUALCHECK(L_COUNT, 293, 349, 360))
		|| (ARG:1 == 41 && EQUALCHECK(L_COUNT, 291, 325, 358))
		|| L_OK
		}
			CS_SHOP_CL:(CS_SHOP_CC ++) = L_COUNT
		ENDIF
	ELSEIF 440 < CARD_DATE_V:CBV_NO && CARD_DATE_V:CBV_NO <= 600 && GETBIT(L_PACK_BIT, 4)
		{
		IF (CARD_DATE_V:CBV_RARITY < 12)
		|| (ARG:1 == 1 && EQUALCHECK(L_COUNT, 467, 477, 486, 510, 599))
		|| (ARG:1 == 2 && EQUALCHECK(L_COUNT, 477, 510))
		|| (ARG:1 == 10 && EQUALCHECK(L_COUNT, 571, 572))
		|| (ARG:1 == 30 && EQUALCHECK(L_COUNT, 467))
		|| (ARG:1 == 41 && EQUALCHECK(L_COUNT, 471, 496, 512))
		|| L_OK
		}
			CS_SHOP_CL:(CS_SHOP_CC ++) = L_COUNT
		ENDIF
		
	ENDIF
	
NEXT

