
@CS_CARDSHOP_RANK
#FUNCTION
SIF CS_G_FLAG > 2 || CS_S_FLAG >= 40
	RETURNF 3
SIF CS_G_FLAG > 1 || CS_S_FLAG >= 20
	RETURNF 2
SIF CS_G_FLAG > 0 || CS_S_FLAG >= 10
	RETURNF 1
RETURNF 0


@CS_CARD_SHOP_PICTURE, L_PICTURES, L_MESSAGE
#DIM L_COUNT
#DIM L_PICTURE
#DIM L_PICTURE2
#DIMS L_PICTURES
#DIMS L_PICTURES2
#DIMS L_MESSAGE
#DIM L_MESSAGE_N

L_PICTURE = IMAGE_LINE_COUNT(L_PICTURES)
SPRITECREATED L_PICTURES
L_PICTURE2 = RESULT
SPLIT L_MESSAGE , "/" , LOCALS
L_MESSAGE_N = RESULT

IF L_PICTURE > 0
	FOR L_COUNT, 0, MAX(L_PICTURE, L_MESSAGE_N)
		IF L_COUNT < L_PICTURE
			L_PICTURES2 = %L_PICTURES%_{L_COUNT + 1}
			PRINT_IMG L_PICTURES2
		ENDIF
		IF L_COUNT < L_MESSAGE_N
			PRINTFORML %LOCALS:L_COUNT%
		ELSE
			PRINTFORML 
		ENDIF
	NEXT
ELSE
	IF L_PICTURE2
		;HTML_PRINT "<img src = '" + L_PICTURES + "' width = '600'>"
		FOR L_COUNT, 0, MAX(6, L_MESSAGE_N)
			SIF L_COUNT > 0
				PRINTFORM 　　　　　　
			IF L_COUNT == 0
				HTML_PRINT "<img src = '" + L_PICTURES + "' height = '600'>" + LOCALS:L_COUNT
			ELSEIF L_COUNT < L_MESSAGE_N
				PRINTFORML %LOCALS:L_COUNT%
			ELSE
				PRINTFORML 
			ENDIF
		NEXT
	ELSE
		FOR L_COUNT, 0, L_MESSAGE_N
			IF L_COUNT < L_MESSAGE_N
				PRINTFORML %LOCALS:L_COUNT%
			ENDIF
		NEXT
	ENDIF
ENDIF

@CS_CARD_SHOP
#DIM L_LINE
#DIM L_COUNT

RESULT = 0
CUSTOMDRAWLINE =
L_LINE = LINECOUNT

{
CALL CS_CARD_SHOP_PICTURE, E34_C_ICON_B("マキ"),
"마키:" + "/" +
"「어머, 어서 와」"
}

DRAWLINE
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
DRAWLINE
;ALIGNMENT CENTER
PRINTL [CLICK]
;ALIGNMENT LEFT
TWAIT 2000,0
$SHOP_START
CLEARLINE LINECOUNT - L_LINE

{
CALL CS_CARD_SHOP_PICTURE, E34_C_ICON_B("マキ"),
"마키:" + "/" + 
"「어떤 카드를 원해?」"
}

CALL CS_OBTAIN_CARD_SET
DRAWLINE
