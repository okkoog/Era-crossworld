	ENDIF
	IF LOCAL:22 > -1
		CALL CB_AI_SET, 3600 + LOCAL:25
		CALL CB_AI_SET, 100 + LOCAL:22
	ENDIF
	IF LOCAL:23 > -1
		CALL CB_AI_SET, 3600 + LOCAL:26
		CALL CB_AI_SET, 100 + LOCAL:23
