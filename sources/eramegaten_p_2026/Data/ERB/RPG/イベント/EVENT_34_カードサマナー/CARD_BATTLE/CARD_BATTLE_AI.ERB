;アタック危険度
;ダメージSP状況
;スキルによる飛行は後回し
;FOR LOCAL, 0, VARSIZE("SUMMONER_DECK", 1)
;	SIF SUMMONER_DECK:ARG:LOCAL == 0
;		RETURNF LOCAL
;NEXT
;CALL CARD_DATA_GET, ARG
;

@CB_CPU_AI_SET
#DIM L_COUNT
#DIM L_COUNT_P
#DIM L_COUNT_E
#DIM L_SORT
#DIM L_AAP
#DIM L_AHP
#DIM L_ASPEED
#DIM L_AFLY
#DIM L_BAP
#DIM L_BHP
#DIM L_BSPEED
#DIM L_BFLY
#DIM AI_BRAIN_E, 6, 20
;0-場所　1-危険度　2-ブロック可(ビット)　3-アタック時の危険度(対サマナー)　5-アタック時の危険度(対仲魔)　6-ブロック強度
#DIM AI_BRAIN_P, 6, 40
;0-場所　1-ブロック重要度　2-ブロック危険度　3-ブロック危険度(PUスキルあり)　4-アタック危険度　5-アタック危険度(PUあり)　6-スキル使用で上がるAP量　7-アタック強度
;10、11、12、13、14、15ブロック時それぞれの危険度 20総合戦闘力　21対空力
;アタックとかブロック危険度(下記は基準、少ないほど安全)
;10倒されないし相手を倒せる、20倒れないがお互い生き残る、3*相打ちしお互いに倒れる、40一方的にやられる、50ブロックされずに攻撃できる(敵)
;														32格と　35同格と　38格と＝敵、味方で33.38の価値は変わる
#DIM AI_BRAIN_SORT, 50
#DIM AI_BRAIN_OFFERING, 50, 30
#DIM L_OFFERING
#DIM MAG_MAX
#DIM MAG_P, 50, 4 ; 0-獲得数　1-代償　2-
#DIMS OFFERING_S
#DIM AI_BRAIN_MAX_FP, 2, 3
#DIM AI_BRAIN_MAX_SPD

;スキル使ったとき、状態剥がした時、HP減らした時、AP減らした時
;どれだけHPを減らせばいいか
;相手に羽ばたき持ちがいるとか、考える(相手の制空は無視)
#DIMS AI_BRAINS, 50, 30
#DIM AI_BRAIN, 50, 40


IF 1
	VARSET AI_BRAIN
	VARSET AI_BRAINS
	VARSET AI_BRAIN_E
	VARSET AI_BRAIN_P
	VARSET RESULTS
	VARSET AI_BRAIN_MAX_FP
	VARSET AI_BRAIN_MAX_SPD
	
	FOR L_COUNT, 6, 12
		AI_BRAIN_P:(L_COUNT - 6):0 = L_COUNT
	NEXT
	FOR L_COUNT, 0, 6
		AI_BRAIN_E:L_COUNT:0 = L_COUNT
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1
			CONTINUE
		AI_BRAIN_MAX_FP:0:0 = MAX(AI_BRAIN_MAX_FP:0:0, FIELD_DEMON_DATE_V:L_COUNT:CBV_B_AP + FIELD_DEMON_DATE_V:L_COUNT:CBV_B_HP)
		AI_BRAIN_MAX_FP:0:1 = MAX(AI_BRAIN_MAX_FP:0:1, FIELD_DEMON_DATE_V:L_COUNT:CBV_B_AP)
		AI_BRAIN_MAX_FP:0:2 = MAX(AI_BRAIN_MAX_FP:0:2, FIELD_DEMON_DATE_V:L_COUNT:CBV_B_HP)
		LOCAL:1 = 0
		;敵用のAI判断の奴
		AI_BRAIN_E:L_COUNT:1 = FIELD_DEMON_DATE_V:L_COUNT:CBV_AP + FIELD_DEMON_DATE_V:L_COUNT:CBV_HP
		;PRINTFORML {AI_BRAIN_E:L_COUNT:1}　{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}　{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP2}
		AI_BRAIN_E:L_COUNT:1 += CB_SP_DAMGER(FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1) + CB_SP_DAMGER(FIELD_DEMON_DATE_V:L_COUNT:CBV_SP2)
		;PRINTFORML {AI_BRAIN_E:L_COUNT:1}
		;LOCAL:1 = FIELD_DEMON_DATE_V:ARG:CBV_FLYING
		;TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
		;	IF STRFIND(RESULTS, "飛行") >= 0
		;		LOCAL:1 = 1
		;	ENDIF
		;CATCH
		;ENDCATCH
		FOR LOCAL, 6, 12
			SIF FIELD_DEMON_DATE_V:LOCAL:CBV_NO < 1
				CONTINUE
			IF CS_BLOCK_BATTLE_CHECK(LOCAL, L_COUNT)
				SETBIT AI_BRAIN_E:L_COUNT:2, LOCAL
				LOCAL:1 += 1
			ENDIF
		NEXT

		;アタック危険度は自分の残りHPと敵のAPで決める
		AI_BRAIN_E:L_COUNT:3 = FIELD_DEMON_DATE_V:L_COUNT:CBV_AP
		IF STATE_INFO_GET_F(L_COUNT, 1104)
			SIF RESULT:1 > 1 && (RESULT:2 == 1 || RESULT:2 == 3 || RESULT:2 == 4 || RESULT:2 == 6)
				AI_BRAIN_E:L_COUNT:3 = 0
		ENDIF
		RESULTS =
		TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
			IF RESULT == 2
				AI_BRAIN_E:L_COUNT:3 += RESULT:1
			ENDIF
		CATCH
		ENDCATCH
		IF FIELD_DEMON_DATE_V:L_COUNT:CBV_AP >= SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP
			;必ず死守
			AI_BRAIN_E:L_COUNT:3 += 80
			AI_BRAIN_E:L_COUNT:1 += 20
		ELSEIF FIELD_DEMON_DATE_V:L_COUNT:CBV_AP >= SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP / 2
			;必ず死守
			AI_BRAIN_E:L_COUNT:3 += 30
			AI_BRAIN_E:L_COUNT:1 += 10
		ELSEIF FIELD_DEMON_DATE_V:L_COUNT:CBV_AP >= SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP / 3
			;相打ちで倒せるなら倒す
			AI_BRAIN_E:L_COUNT:3 += 20
			AI_BRAIN_E:L_COUNT:1 += 6
		ELSEIF FIELD_DEMON_DATE_V:L_COUNT:CBV_AP >= SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP / 4
			;守れるなら守る(生存)
			AI_BRAIN_E:L_COUNT:3 += 10
			AI_BRAIN_E:L_COUNT:1 += 3
		ENDIF
		
		;攻撃ができない場合、アタック危険度1
		IF STATE_INFO_GET_F(L_COUNT, 1999) || STATE_INFO_GET_F(L_COUNT, 1101)
			SIF RESULT:1 > 1 && (RESULT:2 == 1 || RESULT:2 == 3)
				LOCAL:1 = -1
		ELSEIF  STATE_INFO_GET_F(L_COUNT, 101)
			SIF RESULT:1 > 1
				LOCAL:1 = -1
		ELSEIF STATE_INFO_GET_F(L_COUNT, 1998) || STATE_INFO_GET_F(L_COUNT, 1997) || STATE_INFO_GET_F(L_COUNT, 1104)
			SIF RESULT:1 > 1 && (RESULT:2 == 1 || RESULT:2 == 3 || RESULT:2 == 4 || RESULT:2 == 6 || RESULT:2 == 7 || RESULT:2 == 9)
				LOCAL:1 = -1
		ENDIF

		LOCAL:6 = LOCAL:1
		;30以上且つそれをブロックするユニットが一人しかいない場合、ブロック重要度最大
		;敵のアタック危険度もやっとく
		;ブロックしなければならないユニットは9
		;9以上が4体以上いたとき、一人攻撃をする
		;相手がスキル使わない場合と使う場合両方作る
		;敵アタック危険度
		;味方ブロック重要度
		;味方ブロック危険度
		IF CS_ATTACK_USE_CHECK(L_COUNT)
			SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1
				CONTINUE
			AI_BRAIN_E:L_COUNT:5 = 50
			SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE > 0 && CBF_PHASE < 4
				CONTINUE
			FOR LOCAL, 6, 12
				LOCAL:7 = 0
				IF AI_BRAIN_P:(LOCAL - 6):2 >= 100
					LOCAL:7 = AI_BRAIN_P:(LOCAL - 6):2 / 100
					AI_BRAIN_P:(LOCAL - 6):2 %= 100
				ENDIF
				LOCAL:8 = 0
				IF AI_BRAIN_P:(LOCAL - 6):3 >= 100
					LOCAL:8 = AI_BRAIN_P:(LOCAL - 6):3 / 100
					AI_BRAIN_P:(LOCAL - 6):3 %= 100
				ENDIF
				SIF FIELD_DEMON_DATE_V:LOCAL:CBV_NO < 1
					CONTINUE
				CALL CBAI_LUCRATIVE_P, LOCAL, L_COUNT, 1
				LOCAL:7 += (MIN(RESULT:0, RESULT:1) >= 50 ? 1 # 0)
				LOCAL:8 += (MIN(RESULT:2, RESULT:3) >= 50 ? 1 # 0)
				
				IF RESULT:0 < 50 || RESULT:1 < 50 || RESULT:2 < 50 || RESULT:3 < 50
					IF LOCAL:6 == 1 && AI_BRAIN_E:L_COUNT:3 > 30
						;必ず守る
						AI_BRAIN_P:(LOCAL - 6):1 = MAX(AI_BRAIN_P:(LOCAL - 6):1, 9)
					ELSEIF LOCAL:6 > 1 && AI_BRAIN_E:L_COUNT:3 > 30
						;余れば攻撃
						AI_BRAIN_P:(LOCAL - 6):1 = MAX(AI_BRAIN_P:(LOCAL - 6):1, 8)
					ELSEIF LOCAL:6 > 0 && AI_BRAIN_E:L_COUNT:3 > 20
						;余れば攻撃
						AI_BRAIN_P:(LOCAL - 6):1 = MAX(AI_BRAIN_P:(LOCAL - 6):1, 7)
					ELSEIF LOCAL:6 > 0 && AI_BRAIN_E:L_COUNT:3 > 10
						;2体守る
						AI_BRAIN_P:(LOCAL - 6):1 = MAX(AI_BRAIN_P:(LOCAL - 6):1, 6)
					ELSE
						AI_BRAIN_P:(LOCAL - 6):1 = MAX(AI_BRAIN_P:(LOCAL - 6):1, 5)
					ENDIF
				ENDIF
				AI_BRAIN_E:L_COUNT:5 = MIN(AI_BRAIN_E:L_COUNT:5, RESULT:0, RESULT:2, RESULT:1, RESULT:3)
				
				RESULT:0 = RESULT:0 >= 50 ? 0 # RESULT:0
				RESULT:1 = RESULT:1 >= 50 ? 0 # RESULT:1
				RESULT:2 = RESULT:2 >= 50 ? 0 # RESULT:2
				RESULT:3 = RESULT:3 >= 50 ? 0 # RESULT:3
				
				AI_BRAIN_P:(LOCAL - 6):2 = MAX(AI_BRAIN_P:(LOCAL - 6):2, RESULT:0, RESULT:1)
				AI_BRAIN_P:(LOCAL - 6):3 = MAX(AI_BRAIN_P:(LOCAL - 6):3, RESULT:2, RESULT:3)
				AI_BRAIN_P:(LOCAL - 6):(10 + L_COUNT) = RESULT:0
				
				AI_BRAIN_P:(LOCAL - 6):2 += 100 * LOCAL:7
				AI_BRAIN_P:(LOCAL - 6):3 += 100 * LOCAL:8
				
			NEXT
			
			
		ELSE
			AI_BRAIN_E:L_COUNT:5 = 5
		ENDIF
		AI_BRAIN_E:L_COUNT:1 += AI_BRAIN_E:L_COUNT:5 / 10
	NEXT
	
	LOCAL:1 = 0
	FOR L_COUNT, 0, 6
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE > 0
			LOCAL:1 ++
	NEXT
	
	IF LOCAL:1 > 2
		FOR L_COUNT, 0, 6
			SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE > 0
				AI_BRAIN_E:L_COUNT:3 += (LOCAL:1 - 1) * 5
		NEXT
	ENDIF
	
	
	
	
	
	
	
	
	
	
	
	
	FOR L_COUNT, 6, 12
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1
			CONTINUE
		AI_BRAIN_MAX_FP:1:0 = MAX(AI_BRAIN_MAX_FP:1:0, FIELD_DEMON_DATE_V:L_COUNT:CBV_B_AP + FIELD_DEMON_DATE_V:L_COUNT:CBV_B_HP)
		AI_BRAIN_MAX_FP:1:1 = MAX(AI_BRAIN_MAX_FP:1:1, FIELD_DEMON_DATE_V:L_COUNT:CBV_B_AP)
		AI_BRAIN_MAX_FP:1:2 = MAX(AI_BRAIN_MAX_FP:1:2, FIELD_DEMON_DATE_V:L_COUNT:CBV_B_HP)

		AI_BRAIN_P:(L_COUNT - 6):20 = FIELD_DEMON_DATE_V:L_COUNT:CBV_B_AP + FIELD_DEMON_DATE_V:L_COUNT:CBV_B_HP
		AI_BRAIN_P:(L_COUNT - 6):20 += CB_SP_DAMGER(FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1) / 2 + CB_SP_DAMGER(FIELD_DEMON_DATE_V:L_COUNT:CBV_SP2) / 2
		AI_BRAIN_P:(L_COUNT - 6):20 += (CB_ANTI_AIR_F(L_COUNT ) == 2 ? 3 # 0 )
		AI_BRAIN_P:(L_COUNT - 6):21 = CB_ANTI_AIR_F(L_COUNT )
		
		IF SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP < FIELD_DEMON_DATE_V:L_COUNT:CBV_AP
			AI_BRAIN_P:(L_COUNT - 6):7 = 1000
		ELSEIF SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP / 2 < FIELD_DEMON_DATE_V:L_COUNT:CBV_AP
			AI_BRAIN_P:(L_COUNT - 6):7 = 800
		ELSEIF SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP / 3 < FIELD_DEMON_DATE_V:L_COUNT:CBV_AP
			AI_BRAIN_P:(L_COUNT - 6):7 = 700
		ELSEIF SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP / 4 < FIELD_DEMON_DATE_V:L_COUNT:CBV_AP
			AI_BRAIN_P:(L_COUNT - 6):7 = 600
		ELSE
			AI_BRAIN_P:(L_COUNT - 6):7 = 500
		ENDIF
		AI_BRAIN_P:(L_COUNT - 6):7 += FIELD_DEMON_DATE_V:L_COUNT:CBV_AP
		;敵用のAI判断の奴
		;味方アタック危険度
		;敵ブロック強度
		FOR LOCAL, 0, 6
			SIF FIELD_DEMON_DATE_V:LOCAL:CBV_NO < 1
				CONTINUE
			IF !CS_BLOCK_USE_CHECK(AI_BRAIN_E:LOCAL:0)
				AI_BRAIN_E:LOCAL:6 = 5
				CONTINUE
			ENDIF
				
			AI_BRAIN_E:LOCAL:6 = 50
			CALL CBAI_LUCRATIVE_P, LOCAL, L_COUNT, 0
			
			
			FOR LOCAL:1, 0, 2
				
				
				CALL CBAI_LUCRATIVE_P, L_COUNT, LOCAL, 0
				PRINTFORML A %FIELD_DEMON_DATE_S:L_COUNT:CBS_NAME% VS B %FIELD_DEMON_DATE_S:LOCAL:CBS_NAME% {RESULT:0} {RESULT:1} {RESULT:2} {RESULT:3}
				AI_BRAIN_P:(L_COUNT - 6):4 = MAX(RESULT:0, AI_BRAIN_P:(L_COUNT - 6):4)
				AI_BRAIN_P:(L_COUNT - 6):5 = MAX(RESULT:1, AI_BRAIN_P:(L_COUNT - 6):5)
				AI_BRAIN_E:LOCAL:6 = MIN(AI_BRAIN_E:LOCAL:6, RESULT:0, RESULT:1)
				
				
			NEXT
			
			
		NEXT
		
		
	






		;RESULTS =
		;IF CS_SP_USE_CHECK(L_COUNT)
		;	TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
		;		IF RESULT == 1
		;			AI_BRAIN_P:(L_COUNT - 6):10 = RESULT:1 ;威力
		;			AI_BRAIN_P:(L_COUNT - 6):11 = RESULT:2 ;範囲
		;			AI_BRAINS:(L_COUNT - 6):11  = RESULTS ;備考
		;			CALLFORM CGSP_COST_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
		;			AI_BRAIN_P:(L_COUNT - 6):12 = RESULT ;コスト
		;			CALLFORM CGSP_ACTION_AFTER_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
		;			AI_BRAIN_P:(L_COUNT - 6):13 = RESULT ;技使用後
		;			CALLFORM CGSP_TARGET_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
		;			AI_BRAIN_P:(L_COUNT - 6):14 = RESULT ;範囲2
		;			
		;			AI_BRAIN_MAX_SPD += AI_BRAIN_P:(L_COUNT - 6):10
		;		ELSEIF RESULT == 1
		;			AI_BRAIN_P:(L_COUNT - 6):6 = RESULT:1
		;		ENDIF
		;	CATCH
		;	ENDCATCH
		;ENDIF
	NEXT
	
	VARSET AI_BRAIN_OFFERING
	VARSET L_OFFERING
	
	FOR L_COUNT, 0, HAND_CARDS(CS1_OPPONENT)
		L_OFFERING ++
		SIF SUMMONER_HAND_CARDS:CS1_OPPONENT:L_COUNT == 0
			CONTINUE
		CALL CARD_DATA_GET, SUMMONER_HAND_CARDS:CS1_OPPONENT:L_COUNT
		FOR LOCAL, 0, VARSIZE("CARD_DATE_V", 0)
			AI_BRAIN_OFFERING:L_COUNT:LOCAL = CARD_DATE_V:LOCAL
		NEXT
		
		IF CARD_DATE_V:CBV_KINDS < 100
			AI_BRAIN_OFFERING:L_COUNT:20 = CARD_DATE_V:CBV_AP + CARD_DATE_V:CBV_HP
			SIF CARD_DATE_V:CBV_SP1 == 1001 || CARD_DATE_V:CBV_SP2 == 1001
				AI_BRAIN_OFFERING:L_COUNT:20 = AI_BRAIN_OFFERING:L_COUNT:20 / 2
			AI_BRAIN_OFFERING:L_COUNT:20 += CB_SP_DAMGER(CARD_DATE_V:CBV_SP1) / 5 + CB_SP_DAMGER(CARD_DATE_V:CBV_SP2) / 5
			SIF CARD_DATE_V:CBV_FLIGHT > 0
				AI_BRAIN_OFFERING:L_COUNT:20 += 3
			SIF AI_BRAIN_OFFERING:L_COUNT:20 < 1
				AI_BRAIN_OFFERING:L_COUNT:20 = 1
		ELSE
			AI_BRAIN_OFFERING:L_COUNT:20 = CARD_DATE_V:CBV_RARITY * 2
		ENDIF
	NEXT
	
	IF 1 ;CS_DEBUG > 0
		PRINTFORML {CS_AI_STEP}
		PRINTFORML 敵AI状況表示
		PRINTFORML 
		PRINTFORML 場所　　　危険度　　ﾌﾞﾛｯｸ 　　A危険度S　　　　　　A危険度D　ﾌﾞﾛｯｸ強度 
		PRINTFORML 
		FOR L_COUNT, 0, 6
			FOR LOCAL, 0, 8
				PRINTFORM {AI_BRAIN_E:L_COUNT:LOCAL,10,LEFT}
			NEXT
			PRINTFORML 
		NEXT
		PRINTFORML 
		PRINTFORML 場所　　　B重要度 　B危険度 　B危険度PU A危険度 　A危険度PU SP上昇AP　A強度
		FOR L_COUNT, 0, 6
			FOR LOCAL, 0, 8
				PRINTFORM {AI_BRAIN_P:L_COUNT:LOCAL,10,LEFT}
			NEXT
			FOR LOCAL, 10, 16
				PRINTFORM {AI_BRAIN_P:L_COUNT:LOCAL,4,LEFT}
			NEXT
			PRINTFORML 
		NEXT
		
	ENDIF
	
ENDIF

;相手の攻撃をブロックする
IF CBF_PHASE == 4
	
	LOCAL:20 = CS_F_DEMON_COUNT(1)

	LOCAL:24 = -1 ;攻撃者1
	LOCAL:25 = -1 ;攻撃者2
	LOCAL:26 = -1 ;攻撃者3
	VARSET AI_BRAIN_SORT
	FOR L_COUNT, 0, 6
		IF FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_BATTLE > 0
			AI_BRAIN_SORT:L_COUNT = 1000 - AI_BRAIN_E:L_COUNT:3
			LOCAL:(23 + FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_BATTLE % 10) = AI_BRAIN_E:L_COUNT:0
		ELSE
			AI_BRAIN_SORT:L_COUNT = 1000
		ENDIF
	NEXT
	ARRAYMSORT AI_BRAIN_SORT, AI_BRAIN_E
	
	VARSET AI_BRAIN_SORT
	FOR L_COUNT, 0, 6
		IF FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_BATTLE > 0
			AI_BRAIN_SORT:L_COUNT = 1
			FOR LOCAL, 0, 6
				SIF GETBIT(AI_BRAIN_E:L_COUNT:2, LOCAL + 6)
					AI_BRAIN_SORT:L_COUNT ++
			NEXT
		ELSE
			AI_BRAIN_SORT:L_COUNT = 1000
		ENDIF
	NEXT
	ARRAYMSORT AI_BRAIN_SORT, AI_BRAIN_E
	
	VARSET AI_BRAIN_SORT
	FOR L_COUNT, 0, 6
		IF 10 < FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_BATTLE && FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_BATTLE < 20
			AI_BRAIN_SORT:L_COUNT = 990
		ELSE
			AI_BRAIN_SORT:L_COUNT = 1000
		ENDIF
	NEXT
	ARRAYMSORT AI_BRAIN_SORT, AI_BRAIN_E
	
	LOCAL:21 = -1 ;守備者1
	LOCAL:22 = -1 ;守備者2
	LOCAL:23 = -1 ;守備者3
	
	FOR L_COUNT, 0, 6
		SIF FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_BATTLE < 1
			CONTINUE
		SIF AI_BRAIN_E:L_COUNT:5 >= 50
			CONTINUE
			
		
		LOCAL:40 = FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_BATTLE % 10 + 20
		;危険度30以上且つアタック強度40以上
		;一番弱いやつで必ず防御
		IF AI_BRAIN_E:L_COUNT:5 >= 40 && AI_BRAIN_E:L_COUNT:3 >= 30
			LOCAL:30 = -1 ;戦闘力
			FOR LOCAL, 0, 6
				SIF !(GETBIT(AI_BRAIN_E:L_COUNT:2, AI_BRAIN_P:LOCAL:0))
					CONTINUE
				SIF LOCAL:21 == AI_BRAIN_P:LOCAL:0 || LOCAL:22 == AI_BRAIN_P:LOCAL:0 || LOCAL:23 == AI_BRAIN_P:LOCAL:0
					CONTINUE
				IF LOCAL:(LOCAL:40) < 0 || LOCAL:30 > AI_BRAIN_P:LOCAL:20
					LOCAL:(LOCAL:40) = AI_BRAIN_P:LOCAL:0
					LOCAL:30 = AI_BRAIN_P:LOCAL:20
					PRINTFORML %FIELD_DEMON_DATE_S:(LOCAL:(LOCAL:40)):CBS_NAME%
				ENDIF
			NEXT
			SIF LOCAL:(LOCAL:40) > -1 && LOCAL:30 > 30
				LOCAL:20 --
		;危険度20以上相打ちで倒せるなら倒す
		;30前後のやつで防御
		ELSEIF AI_BRAIN_E:L_COUNT:3 >= 20
			LOCAL:30 = -1 ;戦闘力
			LOCAL:31 = -1 ;危険度
			FOR LOCAL, 0, 6
