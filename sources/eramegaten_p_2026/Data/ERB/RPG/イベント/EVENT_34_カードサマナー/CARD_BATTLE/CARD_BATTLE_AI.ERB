@CB_AI_ACT
#FUNCTION
#DIM L_COUNT
LOCAL = CS_AI_ACTION:0
FOR L_COUNT, 1, VARSIZE("CS_AI_ACTION", 0)
	CS_AI_ACTION:(L_COUNT - 1) = CS_AI_ACTION:L_COUNT
NEXT
CS_AI_ACTION:(VARSIZE("CS_AI_ACTION", 0) - 1) = 0
RETURNF LOCAL

;-1　現在参照しているカード(CARD_DATE_V)
;0～11　場にいるカード(FIELD_DEMON_DATE_V)
;100～手札のカード(味方)
;200～手札のカード(敵)
@CB_ANTI_AIR_F(ARG = -1)
#FUNCTION
#DIM L_FLY
#DIM L_SKILL1
#DIM L_SKILL2
;IF 100 <= ARG && ARG < 200
;	CALL CARD_DATA_GET, SUMMONER_HAND_CARDS:CS1_ONESELF:(ARG % 100)
;	SIF CARD_DATE_V:CBV_NO < 1
;		RETURNF -1
;	ARG = -1
;ELSEIF 200 <= ARG && ARG < 300
;	CALL CARD_DATA_GET, SUMMONER_HAND_CARDS:CS1_OPPONENT:(ARG % 100)
;	SIF CARD_DATE_V:CBV_NO < 1
;		RETURNF -1
;	ARG = -1
;ENDIF
IF ARG == -1
	L_FLY = CARD_DATE_V:CBV_FLIGHT
	L_SKILL1 = CARD_DATE_V:CBV_SP1
	L_SKILL2 = CARD_DATE_V:CBV_SP2
ELSEIF 0 <= ARG && ARG < 12
	L_FLY = FIELD_DEMON_DATE_V:ARG:CBV_FLIGHT
	L_SKILL1 = FIELD_DEMON_DATE_V:ARG:CBV_SP1
	L_SKILL2 = FIELD_DEMON_DATE_V:ARG:CBV_SP2
ELSE
	RETURNF -1
ENDIF

SIF L_FLY > 0
	RETURNF 2
SIF L_SKILL1 == 1004 || L_SKILL1 == 1100
	RETURNF 1
SIF L_SKILL2 == 1004 || L_SKILL2 == 1100
	RETURNF 1
RETURNF 0

;ARG攻,ARG:1防　両方とも場所番号///
;ARG:2 = 攻撃側の速度 ARG:3 = 防御側の速度
;ARG:4 = 攻撃側の飛行 ARG:5 = 防御側の飛行
;ARG:6 = ステートの使用(1で使用)
;速さだけじゃなく、お互いの状態も調べる
;1で攻撃側先攻、-1で防御側先攻、0で同時
@CB_SP_SPEED_VIE, ARG, ARG:1, ARG:2 = -99, ARG:3 = -99, ARG:4 = -99, ARG:5 = -99, ARG:6 = 1
#FUNCTION
SIF ARG:2 == -99
	ARG:2 = FIELD_DEMON_DATE_V:ARG:CBV_SPEED
SIF ARG:3 == -99
	ARG:3 = FIELD_DEMON_DATE_V:(ARG:1):CBV_SPEED
SIF ARG:4 == -99
	ARG:4 = FIELD_DEMON_DATE_V:ARG:CBV_FLYING
SIF ARG:5 == -99
	ARG:5 = FIELD_DEMON_DATE_V:(ARG:1):CBV_FLYING
ARG:2 = (ARG:2 > 1 ? 1 # (ARG:2 < -1 ? -1 # ARG:2))
ARG:3 = (ARG:3 > 1 ? 1 # (ARG:3 < -1 ? -1 # ARG:3))
SIF ARG:5 > 0 && STATE_INFO_GET_F(ARG, 2001) > 0 && ARG:6 == 1
	ARG:2 = 1
SIF ARG:4 > 0 && STATE_INFO_GET_F(ARG:1, 2001) > 0 && ARG:6 == 1
	ARG:3 = 1
	
SIF (STATE_INFO_GET_F(ARG, 201) > 0 || STATE_INFO_GET_F(ARG:1, 201) > 0) && ARG:6 == 1
	RETURNF 0

IF ARG:2 > ARG:3
	SIF STATE_INFO_GET_F(ARG:1, 13) > 0 && ARG:6 == 1
		RETURNF 0
	RETURNF 1
ELSEIF ARG:2 < ARG:3
	SIF STATE_INFO_GET_F(ARG, 13) > 0 && ARG:6 == 1
		RETURNF 0
	RETURNF -1
ELSE
	RETURNF 0
ENDIF

;ARGのバトル時のパラメータを取得///
;ARG:1でスキルを使うかどうか0-使わない 1-使う
;自分のブロック時はお互いにスキルが使えるのでそこを考える
;ARG:2で攻勢か防衛か0-공격 1-방어
;ARG:3はお相手
;ARG:4 = ステートの使用(ビット 0メイン、1お相手)
;ARG:5 = 他の処理　ビット(0回復封じ)
;RESULT:0-AP　RESULT:1-HP　RESULTS:0-スキルで得られる特殊効果
@CB_BATTLE_APHP_GET, ARG, ARG:1, ARG:2, ARG:3 = -1, ARG:4 = 3, ARG:5 = 0
#DIM L_AP
#DIM L_HP
#DIM L_HP_UP
#DIM L_FAZE
#DIM L_TIME

L_HP_UP = 1
SIF GETBIT(ARG:5, 0)
	L_HP_UP = 0
;敵側で　
;現在敵のターンでバトルフェイズではなく、攻撃時の場合
;現在＠のターンでバトルフェイズで、防御時の場合
{
IF (FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_OPPONENT && 
((CBF_P_TURN == FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE != 4 && ARG:2 == 0) || 
(CBF_P_TURN != FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE == 4 && ARG:2 == 1)))
|| (FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_ONESELF  && 
((CBF_P_TURN != FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE != 4 && ARG:2 == 1) || 
(CBF_P_TURN == FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE == 4 && ARG:2 == 0)))
}
;＠側で
;現在敵のターンでバトルフェイズではなく、防御時の場合
;現在＠のターンでバトルフェイズで、攻撃時の場合
	L_AP = FIELD_DEMON_DATE_V:ARG:CBV_AP
	L_HP = FIELD_DEMON_DATE_V:ARG:CBV_HP
	
	L_FAZE = 3
	SIF CBF_PHASE >= 4
		L_FAZE = 6
	L_TIME = 0
	SIF (STATE_INFO_GET_F(ARG, 105) > 0) && RESULT:1 == L_TIME && GETBIT(ARG:4, 0)
		L_HP_UP = 0
ELSE
	L_FAZE = 0
	L_TIME = 1
	L_AP = FIELD_DEMON_DATE_V:ARG:CBV_B_AP
	IF L_HP_UP == 0 || ((STATE_INFO_GET_F(ARG, 105) > 0) && RESULT:1 >= L_TIME && GETBIT(ARG:4, 0))
		L_HP_UP = 0
		L_HP = FIELD_DEMON_DATE_V:ARG:CBV_HP
	ELSE
		L_HP = FIELD_DEMON_DATE_V:ARG:CBV_B_HP
	ENDIF
ENDIF

;自動効果スキルはPFでのみ発動
;状態はPF、BF、戦闘でそれぞれ状態が発動する
;自分が防衛は、お互いにスキルが使える
;自分が攻撃の場合、敵は状態のみで判断する
IF CBF_P_TURN != ARG:2
	LOCAL:1 = 0
ELSEIF CBF_PHASE > 3
	LOCAL:1 = 6
ELSEIF CBF_PHASE > 2
	LOCAL:1 = 3
ELSE
	LOCAL:1 = 0
ENDIF

;必殺の構え
{
IF (STATE_INFO_GET_F(ARG, 201) > 0 && RESULT:1 > L_TIME && GETBIT(ARG:4, 0))
|| (CB_HAVE_SP(ARG, 1008) && L_TIME > 1)
}
	RETURN 90, 1
ENDIF

IF ARG:3 > -1
	;必殺の構え
	{
	IF (STATE_INFO_GET_F(ARG:3, 201) > 0 && RESULT:1 > L_TIME && GETBIT(ARG:4, 1))
	|| (L_TIME > 1 && CB_HAVE_SP(ARG:3, 1008))
	}
		RETURN 90, 1
	ENDIF

	;相手がアタック耐性
	IF STATE_INFO_GET_F(ARG:3,   2) > 0 && RESULT:1 > L_TIME && GETBIT(ARG:4, 1)
		L_AP -= RESULT:3
	ENDIF

	;相手がアタック弱点
	IF STATE_INFO_GET_F(ARG:3, 110) > 0 && RESULT:1 > L_TIME && GETBIT(ARG:4, 1)
		L_AP += RESULT:3
	ENDIF

	;相手がアタック無効
	IF STATE_INFO_GET_F(ARG:3,   3) > 0 && RESULT:1 > L_TIME && GETBIT(ARG:4, 1)
		L_AP = -99
	ENDIF

	;相手がアタック反射
	IF STATE_INFO_GET_F(ARG:3,   4) > 0 && RESULT:1 > L_TIME && GETBIT(ARG:4, 1)
		L_AP = -99
	ENDIF
ENDIF

;パワーアップスキルの使用
IF ARG:1 == 1
	IF ARG:2 == 0
		TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:ARG:CBV_SP1}, FIELD_DEMON_DATE_S:ARG:CBS_SP1_SUB, ARG
			IF RESULT == 2 && RESULT:3 == 1
				L_AP += RESULT:1
				SIF L_HP_UP
					L_HP += RESULT:2
			ELSE
				RESULTS =
			ENDIF
		CATCH
		ENDCATCH
	ELSEIF ARG:2 == 1
		TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:ARG:CBV_SP1}, FIELD_DEMON_DATE_S:ARG:CBS_SP1_SUB, ARG
			IF RESULT == 3 && RESULT:3 == 1
				L_AP += RESULT:1
				SIF L_HP_UP
					L_HP += RESULT:2
			ELSE
				RESULTS =
			ENDIF
		CATCH
		ENDCATCH
	ENDIF
ENDIF

FOR LOCAL, 0, VARSIZE("FIELD_DEMON_STATE_V", 1)
	;タイミングが規定タイミング
	;タイミングが3の倍数（相手でも自分でも発動）
	;タイミングが3の倍数+1（自分のターンで発動）で攻勢
	;タイミングが3の倍数+2（相手のターンで発動）で防衛
	;スキル封じ無し
	{
	IF L_FAZE < FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING < 10 && 
		(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING % 3 == 0 || 
			(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING % 3 == 1 && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TURN > L_TIME && ARG:2 == 0) ||
			(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING % 3 == 2 && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TURN > L_TIME && ARG:2 == 1)) && 
		GETBIT(ARG:4, 0)
	}
		IF 1001 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE
			LOCAL:2 = FIELD_DEMON_STATE_V:ARG:LOCAL:CSS3_SUB1
			
			LOCAL:3 = LOCAL:2 % 1000000 / 1000
			IF LOCAL > 100
				L_AP -= LOCAL:3 % 100
			ELSE
				L_AP += LOCAL:3 % 100
			ENDIF
			
			LOCAL:3 = LOCAL:2 % 1000
			IF LOCAL > 100
				L_HP -= LOCAL:3 % 100
			ELSE
				SIF L_HP_UP
					L_HP += LOCAL:3 % 100
			ENDIF
		ELSEIF 1104 == FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE
			L_AP = 0
		ENDIF
	ENDIF
NEXT
SIF STRFIND(RESULTS, "無敵") >= 0
	L_HP = 80

RETURN L_AP, L_HP

;ARG	仲魔
;ARG:1	0攻勢　1防衛
;ARG:2	ステートの使用
@AI_FLY_GET, ARG, ARG:1, ARG:2 = 1
#FUNCTION
#DIM L_FLY
#DIM L_FAZE
#DIM L_TIME

L_FLY = 0
{
IF (FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_OPPONENT && ((CBF_P_TURN == FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE != 4 && ARG:1 == 0) || (CBF_P_TURN != FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE == 4 && ARG:1 == 1)))
|| (FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_ONESELF  && ((CBF_P_TURN != FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE != 4 && ARG:1 == 1) || (CBF_P_TURN == FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE == 4 && ARG:1 == 0)))
}
	L_FLY = FIELD_DEMON_DATE_V:ARG:CBV_FLYING
	
	L_FAZE = 3
	SIF CBF_PHASE >= 4
		L_FAZE = 6
	L_TIME = 0
ELSE
	L_FLY = FIELD_DEMON_DATE_V:ARG:CBV_FLIGHT - 1
	
	L_FAZE = 0
	L_TIME = 1
ENDIF

IF ARG:2 == 1
	FOR LOCAL:1, 0, 3
		FOR LOCAL, 0, VARSIZE("FIELD_DEMON_STATE_V", 1)
			{
			IF FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TURN > L_TIME && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TURN > 1 
			&& L_FAZE < FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING < 10
			&& (LOCAL:1 * 3) < FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING <= ((LOCAL:1 + 1) * 3)
			&& ((FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING % 3 == 0) || 
				(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING % 3 == 1 && ARG:1 == 0) || 
				(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING % 3 == 2 && ARG:1 == 1))
			}
				IF FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE == 1305
					L_FLY = MAX(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB1, 1)
				ELSEIF FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE == 1306
					L_FLY = -MAX(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB1, 1)
				ENDIF
			ENDIF
		NEXT
	NEXT
ENDIF
RETURNF L_FLY

;ARG	仲魔
;ARG:1	0攻勢　1防衛
;ARG:2	ステートの使用
@AI_SPEED_GET, ARG, ARG:1, ARG:2 = 1
#FUNCTION
#DIM L_SPEED
#DIM L_FAZE
#DIM L_TIME

L_SPEED = 0
{
IF (FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_OPPONENT && ((CBF_P_TURN == FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE != 4 && ARG:1 == 0) || (CBF_P_TURN != FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE == 4 && ARG:1 == 1)))
|| (FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_ONESELF  && ((CBF_P_TURN != FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE != 4 && ARG:1 == 1) || (CBF_P_TURN == FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE == 4 && ARG:1 == 0)))
}
	L_SPEED = FIELD_DEMON_DATE_V:ARG:CBV_SPEED
	L_FAZE = 3
	SIF CBF_PHASE >= 4
		L_FAZE = 6
	L_TIME = 0
ELSE
	SIF FIELD_DEMON_DATE_V:ARG:CBV_SPEED > 0
		L_SPEED = FIELD_DEMON_DATE_V:ARG:CBV_SPEED - 1
	SIF FIELD_DEMON_DATE_V:ARG:CBV_SPEED < 0
		L_SPEED = FIELD_DEMON_DATE_V:ARG:CBV_SPEED + 1
	IF STATE_INFO_GET_F(ARG,106) > 0 && RESULT:1 < 2
		L_SPEED = MAX(CB_HAVE_SP(ARG, 1003), L_SPEED)
		L_SPEED = MIN(- CB_HAVE_SP(ARG, 1009), L_SPEED)
	ENDIF
	L_FAZE = 0
	L_TIME = 1
ENDIF

IF ARG:2 == 1
	FOR LOCAL:1, 0, 3
		FOR LOCAL, 0, VARSIZE("FIELD_DEMON_STATE_V", 1)
			{
			IF FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TURN > L_TIME && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TURN > 1 
			&& L_FAZE < FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING < 10
			&& (LOCAL:1 * 3) < FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING && FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING <= ((LOCAL:1 + 1) * 3)
			&& ((FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING % 3 == 0) || 
				(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING % 3 == 1 && ARG:1 == 0) || 
				(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING % 3 == 2 && ARG:1 == 1))
			}
				IF FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE == 1301
					L_SPEED = MAX(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB1, 1)
				ELSEIF FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE == 1302
					L_SPEED = -MAX(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB1, 1)
				ELSEIF FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE == 1303
					L_SPEED =  MIN(L_SPEED + MAX(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB1, 1), MAX(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB1, 1))
				ELSEIF FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE == 1304
					L_SPEED =  MAX(L_SPEED - MAX(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB1, 1), -MAX(FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB1, 1))
				ENDIF
			ENDIF
		NEXT
