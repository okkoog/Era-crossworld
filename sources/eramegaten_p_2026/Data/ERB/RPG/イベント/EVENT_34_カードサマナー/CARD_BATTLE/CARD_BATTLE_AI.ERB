				;SIF AI_BRAIN_P:LOCAL:(LOCAL:41) >= 40
				;	CONTINUE
				;LOCAL:40 = FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_BATTLE % 10 + 20
				{
				IF LOCAL:(LOCAL:40) < 0 
				|| (LOCAL:31  > AI_BRAIN_P:LOCAL:(LOCAL:41))
				|| (LOCAL:31 == 20 && AI_BRAIN_P:LOCAL:(LOCAL:41) == 33)
				|| (LOCAL:31 == AI_BRAIN_P:LOCAL:(LOCAL:41) && LOCAL:30 > AI_BRAIN_P:LOCAL:20)
				|| (LOCAL:31 >= 38 && AI_BRAIN_P:LOCAL:(LOCAL:41) >= 38 && LOCAL:30 > AI_BRAIN_P:LOCAL:20)
				}
					LOCAL:(LOCAL:40) = AI_BRAIN_P:LOCAL:0
					LOCAL:31 = AI_BRAIN_P:LOCAL:(LOCAL:41)
					LOCAL:30 = AI_BRAIN_P:LOCAL:20
					PRINTFORML %FIELD_DEMON_DATE_S:(LOCAL:(LOCAL:40)):CBS_NAME%
				ENDIF
			NEXT
			SIF LOCAL:(LOCAL:40) > -1 && LOCAL:30 > 30
				LOCAL:20 --
		ENDIF
		PRINTFORML 
	NEXT
	FOR L_COUNT, 0, 6
		SIF FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_BATTLE < 1
			CONTINUE
		SIF AI_BRAIN_E:L_COUNT:5 >= 50
			CONTINUE
			
		
		LOCAL:40 = FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_BATTLE % 10 + 20
		;危険度30以上且つアタック強度40以上
		;一番弱いやつで必ず防御
		IF LOCAL:(LOCAL:40) < 1 && AI_BRAIN_E:L_COUNT:3 >= 10 && LOCAL:20 > 4
			LOCAL:30 = -1 ;戦闘力
			LOCAL:31 = -1 ;危険度
			FOR LOCAL, 0, 6
				SIF !(GETBIT(AI_BRAIN_E:L_COUNT:2, AI_BRAIN_P:LOCAL:0))
					CONTINUE
				SIF LOCAL:21 == AI_BRAIN_P:LOCAL:0 || LOCAL:22 == AI_BRAIN_P:LOCAL:0 || LOCAL:23 == AI_BRAIN_P:LOCAL:0
					CONTINUE
				LOCAL:41 = AI_BRAIN_E:L_COUNT:0 + 10
				SIF LOCAL:31 == 33 && AI_BRAIN_P:LOCAL:(LOCAL:41) == 20
