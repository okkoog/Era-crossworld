;最初は飛行や守備重要度でタップ、アタックできる仲魔数を算出
;
IF 30 <= CS_AI_STEP && CS_AI_STEP < 40
	VARSET AI_BRAIN
	VARSET AI_BRAINS
	LOCAL = 0
	FOR L_COUNT, 0, 6
		RESULTS =
		IF CS_SP_USE_CHECK(L_COUNT + 6)
			PRINTFORML %FIELD_DEMON_DATE_S:(L_COUNT + 6):CBS_NAME%
			TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:(L_COUNT + 6):CBV_SP1}, FIELD_DEMON_DATE_S:(L_COUNT + 6):CBS_SP1_SUB, (L_COUNT + 6)
				IF RESULT == 1
					AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ
					
					AI_BRAIN:LOCAL:1 = RESULT:1 ;威力
					AI_BRAIN:LOCAL:2 = RESULT:2 ;範囲
					AI_BRAINS:LOCAL:0 = %SUBSTRING(RESULTS:0, 0, STRFIND(RESULTS:0, "供物"))% ;備考
					
				ELSEIF 10 <= RESULT && RESULT < 20
					AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ
					
					AI_BRAIN:LOCAL:1 = RESULT:0 ;攻撃封じか防御封じか
					AI_BRAIN:LOCAL:2 = RESULT:1 ;状態異常
					AI_BRAIN:LOCAL:3 = RESULT:2 ;確率
					AI_BRAINS:LOCAL:0  = RESULTS ;備考
				ELSEIF RESULT == 20
					AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ
					
					AI_BRAIN:LOCAL:1 = 0
					AI_BRAIN:LOCAL:2 = RESULT:1 ;状態異常
					AI_BRAIN:LOCAL:3 = RESULT:2 ;確率
					AI_BRAINS:LOCAL:0  = RESULTS ;備考
				ELSEIF 2 <= RESULT && RESULT < 4
					AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ(2　攻撃強化、3　防御強化、4　両方強化)
					
					AI_BRAIN:LOCAL:1 = RESULT:1 ;上昇AP
					AI_BRAIN:LOCAL:2 = RESULT:2 ;上昇HP
					AI_BRAIN:LOCAL:3 = RESULT:3 ;誰に使うか
					AI_BRAINS:LOCAL:0  = RESULTS ;備考
				ELSEIF RESULT == 30
					AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ(회복)
					
					AI_BRAIN:LOCAL:1 = RESULT:1 ;回復量
					AI_BRAIN:LOCAL:2 = 0
					AI_BRAIN:LOCAL:3 = 0
					AI_BRAINS:LOCAL:0  = RESULTS ;備考
				ELSEIF RESULT == 40
					AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ(カードドロー)
					
					AI_BRAIN:LOCAL:1 = RESULT:1 ;枚数
					AI_BRAIN:LOCAL:2 = 0
					AI_BRAIN:LOCAL:3 = 0
					AI_BRAINS:LOCAL:0  = RESULTS ;備考
				ENDIF
				IF AI_BRAIN:LOCAL:9 > 0
					AI_BRAIN:LOCAL:0 = L_COUNT + 6 ;場所

					CALLFORM CGSP_COST_{FIELD_DEMON_DATE_V:(L_COUNT + 6):CBV_SP1}, FIELD_DEMON_DATE_S:(L_COUNT + 6):CBS_SP1_SUB, (L_COUNT + 6)
					AI_BRAIN:LOCAL:4 = RESULT ;コスト
					CALLFORM CGSP_ACTION_AFTER_{FIELD_DEMON_DATE_V:(L_COUNT + 6):CBV_SP1}, FIELD_DEMON_DATE_S:(L_COUNT + 6):CBS_SP1_SUB, (L_COUNT + 6)
					AI_BRAIN:LOCAL:5 = RESULT ;技使用後
					CALLFORM CGSP_TARGET_{FIELD_DEMON_DATE_V:(L_COUNT + 6):CBV_SP1}, FIELD_DEMON_DATE_S:(L_COUNT + 6):CBS_SP1_SUB, (L_COUNT + 6)
					AI_BRAIN:LOCAL:6 = RESULT ;範囲2
					
					AI_BRAIN:LOCAL:10 = AI_BRAIN_P:L_COUNT:0
					AI_BRAIN:LOCAL:11 = AI_BRAIN_P:L_COUNT:1
					AI_BRAIN:LOCAL:12 = AI_BRAIN_P:L_COUNT:2
					AI_BRAIN:LOCAL:13 = AI_BRAIN_P:L_COUNT:3
					AI_BRAIN:LOCAL:14 = AI_BRAIN_P:L_COUNT:4
					AI_BRAIN:LOCAL:15 = AI_BRAIN_P:L_COUNT:5
					AI_BRAIN:LOCAL:16 = AI_BRAIN_P:L_COUNT:6
					AI_BRAIN:LOCAL:17 = AI_BRAIN_P:L_COUNT:7
					AI_BRAIN:LOCAL:30 = AI_BRAIN_P:L_COUNT:20
					AI_BRAIN:LOCAL:31 = AI_BRAIN_P:L_COUNT:21
					
					;AI_BRAIN_MAX_SPD += AI_BRAIN:LOCAL:1
					
					LOCAL ++
				ENDIF
				
			CATCH
			ENDCATCH
		ENDIF
	NEXT
	
	IF S_STATE_INFO_GET_F(CS1_OPPONENT, 102) == 0
		FOR L_COUNT, 0, HAND_CARDS(CS1_OPPONENT)
			SIF SUMMONER_HAND_CARDS:CS1_OPPONENT:L_COUNT == 0
				CONTINUE
			CALL CARD_DATA_GET, SUMMONER_HAND_CARDS:CS1_OPPONENT:L_COUNT
			SIF CARD_DATE_V:CBV_KINDS < 100
				CONTINUE
			SIF CARD_DATE_V:CBV_OFFERING > 0 ;供物は保留kokokoko
				CONTINUE
			RESULTS =
			PRINTFORML %CARD_DATE_S:CBS_NAME%
			TRYCCALLFORM CGSP_TYPE_{CARD_DATE_V:CBV_SP1}, CARD_DATE_S:CBS_SP1_SUB, L_COUNT
				IF RESULT == 1
					AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ
					
					AI_BRAIN:LOCAL:1 = RESULT:1 ;威力
					AI_BRAIN:LOCAL:2 = RESULT:2 ;範囲
					AI_BRAINS:LOCAL:0  = %SUBSTRING(RESULTS:0, 0, STRFIND(RESULTS:0, "供物"))% ;備考
				ELSEIF 10 <= RESULT && RESULT < 20
					AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ
					
					AI_BRAIN:LOCAL:1 = RESULT:0 ;攻撃封じか防御封じか
					AI_BRAIN:LOCAL:2 = RESULT:1 ;状態異常
					AI_BRAIN:LOCAL:3 = RESULT:2 ;確率
					AI_BRAINS:LOCAL:0  = RESULTS ;備考
				ELSEIF 20 <= RESULT && RESULT < 30
					AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ
					
					AI_BRAIN:LOCAL:1 = 0
					AI_BRAIN:LOCAL:2 = RESULT:1 ;状態異常
					AI_BRAIN:LOCAL:3 = RESULT:2 ;確率
					AI_BRAINS:LOCAL:0  = RESULTS ;備考
				ELSEIF 2 <= RESULT && RESULT < 4
					AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ(2　攻撃強化、3　防御強化、4　両方強化)
					
					AI_BRAIN:LOCAL:1 = RESULT:1 ;上昇AP
					AI_BRAIN:LOCAL:2 = RESULT:2 ;上昇HP
					AI_BRAIN:LOCAL:3 = RESULT:3 ;誰に使うか
					AI_BRAINS:LOCAL:0  = RESULTS ;備考
				ELSEIF RESULT == 30
					AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ(회복)
					
					AI_BRAIN:LOCAL:1 = RESULT:1 ;回復量
					AI_BRAIN:LOCAL:2 = 0
					AI_BRAIN:LOCAL:3 = 0
					AI_BRAINS:LOCAL:0  = RESULTS ;備考
				ELSEIF RESULT == 40
					AI_BRAIN:LOCAL:9 = RESULT ;スキルタイプ(カードドロー)
					
					AI_BRAIN:LOCAL:1 = RESULT:1 ;枚数
					AI_BRAIN:LOCAL:2 = 0
					AI_BRAIN:LOCAL:3 = 0
					AI_BRAINS:LOCAL:0  = RESULTS ;備考
				ENDIF
