				CALLFORM CGSP_COST_{FIELD_DEMON_DATE_V:L_COUNT_P:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT_P:CBS_SP1_SUB, L_COUNT_P
				AI_BRAIN:LOCAL:1 -= RESULT ;コスト
				SIF AI_BRAIN:LOCAL:1 < 1
					CONTINUE

				LOCAL:11 += AI_BRAIN:LOCAL:1
				CALLFORM CGSP_ACTION_AFTER_{FIELD_DEMON_DATE_V:L_COUNT_P:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT_P:CBS_SP1_SUB, L_COUNT_P
				AI_BRAIN:LOCAL:4 = RESULT ;技使用後
				CALLFORM CGSP_TARGET_{FIELD_DEMON_DATE_V:L_COUNT_P:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT_P:CBS_SP1_SUB, L_COUNT_P
				AI_BRAIN:LOCAL:5 = RESULT ;範囲2

				;代償計算
				AI_BRAIN:LOCAL:6 -= CB_SP_DAMGER(FIELD_DEMON_DATE_V:L_COUNT_P:CBV_SP1)

				FOR L_COUNT, 0, 30
					AI_BRAIN:LOCAL:(L_COUNT + 10) = AI_BRAIN_P:(L_COUNT_P - 6):L_COUNT
				NEXT

				
				;PRINTFORML 場所{AI_BRAIN:LOCAL:0}　%FIELD_DEMON_DATE_S:(AI_BRAIN:LOCAL:0):CBS_NAME%
				
				LOCAL ++
			ENDIF
		CATCH
		ENDCATCH
	ENDIF
NEXT
;MAG_P 0-獲得数　1-代償　2-犠牲場 3-スキル、アイテム使用場
;MAG_MAX
LOCAL:10 = LOCAL
MAG_MAX = LOCAL:11
IF LOCAL:10 > 0 && LOCAL:11 > 0
	VARSET MAG_P
	L_COUNT_E = 0
	LOCAL:2 = 1 << LOCAL:10

	;FOR L_COUNT, 0, LOCAL:11
		FOR LOCAL:3, 1, LOCAL:2
			LOCAL:20 = 0;代償
			LOCAL:21 = 0;タップ場
			LOCAL:22 = 0;犠牲場
			LOCAL:23 = 0;獲得数
			LOCAL:24 = 0;タップ数
			LOCAL:25 = 0;犠牲数
			LOCAL:26 = 0;スキル使用場(アイテムはまだ)kokokokokoko
			FOR LOCAL, 0, LOCAL:10
				IF GETBIT(LOCAL:3, LOCAL)
					SETBIT LOCAL:26, AI_BRAIN:LOCAL:0
					LOCAL:23 += AI_BRAIN:LOCAL:1
					LOCAL:20 += AI_BRAIN:LOCAL:6;代償
					IF AI_BRAIN:LOCAL:4 == 1
						SETBIT LOCAL:21, AI_BRAIN:LOCAL:0
						LOCAL:24 ++
					ENDIF
					IF AI_BRAIN:LOCAL:4 == 2 || AI_BRAIN:LOCAL:4 == 3
						SETBIT LOCAL:21, AI_BRAIN:LOCAL:0
						SETBIT LOCAL:22, AI_BRAIN:LOCAL:0
						LOCAL:25 ++
					ENDIF
				ENDIF
			NEXT
			;SIF LOCAL:23 != L_COUNT
			;	CONTINUE
			LOCAL:20 += LOCAL:24 * 5 + LOCAL:25 * 10
			IF MAG_P:(LOCAL:23):0 == 0 || MAG_P:(LOCAL:23):1 > LOCAL:20
				MAG_P:(LOCAL:23):0 = LOCAL:23
				MAG_P:(LOCAL:23):1 = LOCAL:20
				MAG_P:(LOCAL:23):2 = LOCAL:25
				MAG_P:(LOCAL:23):3 = LOCAL:26
			ENDIF
		NEXT
	;NEXT
	LOCAL:1 = 0
	LOCAL:2 = 0
	FOR L_COUNT , 0, MAG_MAX
		IF MAG_P:L_COUNT:0 == 0 || MAG_P:L_COUNT:1 > MAG_P:(L_COUNT + 1):1
			FOR LOCAL, L_COUNT, MAG_MAX + 1
				MAG_P:LOCAL:0 = MAG_P:(LOCAL + 1):0
				MAG_P:LOCAL:1 = MAG_P:(LOCAL + 1):1
				MAG_P:LOCAL:2 = MAG_P:(LOCAL + 1):2
				MAG_P:LOCAL:3 = MAG_P:(LOCAL + 1):3
			NEXT
			LOCAL:1 = 0
			SIF L_COUNT > 0
				L_COUNT --
		ENDIF
		SIF MAG_P:L_COUNT:0 == 0 && MAG_P:(L_COUNT + 1):0 == 0
			LOCAL:1 ++
		SIF LOCAL:1 > MAG_MAX
			BREAK
		SIF MAG_P:L_COUNT:0 > 0
			LOCAL:2 = L_COUNT
	NEXT
	FOR L_COUNT , 0, LOCAL:2
		MAG_P:L_COUNT:1 /= 2
	NEXT

ENDIF





