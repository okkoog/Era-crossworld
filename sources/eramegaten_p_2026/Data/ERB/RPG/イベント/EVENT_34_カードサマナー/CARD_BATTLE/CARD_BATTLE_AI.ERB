			ENDIF
		ENDIF
		IF LOCAL:34 > 1 && LOCAL:53 < LOCAL:50
			LOCAL:30 = -1 ;攻撃者1
			LOCAL:31 = -1 ;攻撃者2
			LOCAL:32 = -1 ;攻撃者3
			L_COUNT = 30
			FOR L_COUNT_P, 0, 6
				SIF GETBIT(LOCAL:52, L_COUNT_P)
					LOCAL:(L_COUNT++) = AI_BRAIN_P:L_COUNT_P:0
			NEXT
			IF LOCAL:(30 + LOCAL:53) > -1
				SIF LOCAL:30 > -1
					CALL CB_AI_SET, 3500 + LOCAL:30
				SIF LOCAL:31 > -1
					CALL CB_AI_SET, 3500 + LOCAL:31
				SIF LOCAL:32 > -1
					CALL CB_AI_SET, 3500 + LOCAL:32
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
	

	;他、サマナー妨害など、MAGや仲魔が余れば使うxxxxxxxxxx
	IF LOCAL:18 > 0
		PRINTFORML 대가 기타 {LOCAL:10}
		;やるのは仲魔のみ
		;20サマナー妨害、30回復
		;他人強化(방어)
		FOR L_COUNT, 0, LOCAL:10
			SIF AI_BRAIN:L_COUNT:10 < 12
				PRINTFORML %FIELD_DEMON_DATE_S:(AI_BRAIN:L_COUNT:10):CBS_NAME%
			PRINTFORM {AI_BRAIN:L_COUNT:4}  {SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_MAG}
			SIF SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_MAG < AI_BRAIN:L_COUNT:4
				CONTINUE
			PRINTFORML MAG OK
			;SIF !(AI_BRAIN:L_COUNT:9 == 20 || AI_BRAIN:L_COUNT:9 == 30 || AI_BRAIN:L_COUNT:9 == 40)
			;	CONTINUE
			;PRINTFORML SKILL K OK

			;SIF AI_BRAIN:L_COUNT:5 > 1
				CONTINUE
			IF AI_BRAIN:L_COUNT:5 > 1 && AI_BRAIN:L_COUNT:10 < 12
				IF AI_BRAIN:L_COUNT:12 % 100 >= 40 && AI_BRAIN:L_COUNT:13 % 100 >= 40
				ELSEIF MIN(AI_BRAIN:L_COUNT:12, AI_BRAIN:L_COUNT:13) % 100 == 0 || MIN(AI_BRAIN:L_COUNT:12, AI_BRAIN:L_COUNT:13) > 100
				ELSE
					CONTINUE
				ENDIF

				IF AI_BRAIN:L_COUNT:14 >= 40 && AI_BRAIN:L_COUNT:15 >= 40 && AI_BRAIN:L_COUNT:17 < 800
				ELSE
					CONTINUE
				ENDIF
				SIF AI_BRAIN:L_COUNT:11 > 8
					CONTINUE
			ENDIF
			PRINTFORML 代償 OK
			IF AI_BRAIN:L_COUNT:10 < 12
				SIF LOCAL:19 < 1 && GETBIT(LOCAL:17, AI_BRAIN:L_COUNT:10) && AI_BRAIN:L_COUNT:5 > 0
					CONTINUE
				PRINTFORML 空中 OK
				SIF AI_BRAIN:L_COUNT:5 > 0 && FIELD_DEMON_DATE_V:(AI_BRAIN:L_COUNT:10):CBV_BATTLE > 0
					CONTINUE
			ENDIF
				; || AI_BRAIN:L_COUNT:0 < 100
			IF AI_BRAIN:L_COUNT:9 == 1 && AI_BRAIN:L_COUNT:2 == 1 && (AI_BRAIN:L_COUNT:6 == 4 || AI_BRAIN:L_COUNT:6 == 6)
				IF AI_BRAIN:L_COUNT:0 < 100
					CALL CB_AI_SET, 1500 + AI_BRAIN:L_COUNT:10
				ELSE
					CALL CB_AI_SET, 10000 + AI_BRAIN:L_COUNT:10
				ENDIF
				CALL CB_AI_SET, 120
				RETURN 1
			ELSEIF AI_BRAIN:L_COUNT:9 == 20
				IF AI_BRAIN:L_COUNT:0 < 100
					CALL CB_AI_SET, 1500 + AI_BRAIN:L_COUNT:10
				ELSE
					CALL CB_AI_SET, 10000 + AI_BRAIN:L_COUNT:10
				ENDIF
				RETURN 1
			ELSEIF AI_BRAIN:L_COUNT:9 == 21
				IF HAND_CARDS(CS1_ONESELF) > 0
					IF AI_BRAIN:L_COUNT:10 < 100
						CALL CB_AI_SET, 1500 + AI_BRAIN:L_COUNT:10
					ELSE
						CALL CB_AI_SET, 10000 + AI_BRAIN:L_COUNT:10
					ENDIF
					RETURN 1
				ENDIF
			ELSEIF AI_BRAIN:L_COUNT:9 == 22
				IF DECK_CARDS(CS1_ONESELF) > 0
					IF AI_BRAIN:L_COUNT:10 < 100
						CALL CB_AI_SET, 1500 + AI_BRAIN:L_COUNT:10
					ELSE
						CALL CB_AI_SET, 10000 + AI_BRAIN:L_COUNT:10
					ENDIF
					RETURN 1
				ENDIF
			ELSEIF AI_BRAIN:L_COUNT:9 == 40 && AI_BRAIN:L_COUNT:10 >= 100
				IF AI_BRAIN:L_COUNT:0 < 100
					CALL CB_AI_SET, 1500 + AI_BRAIN:L_COUNT:10
				ELSE
					CALL CB_AI_SET, 10000 + AI_BRAIN:L_COUNT:10
				ENDIF
				RETURN 1
			ELSEIF AI_BRAIN:L_COUNT:9 == 30 && SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_MAX_HP - SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP >= AI_BRAIN:L_COUNT:1
				IF AI_BRAIN:L_COUNT:0 < 100
					CALL CB_AI_SET, 1500 + AI_BRAIN:L_COUNT:10
				ELSE
					CALL CB_AI_SET, 10000 + AI_BRAIN:L_COUNT:10
				ENDIF
				RETURN 1
			ENDIF
			
		NEXT
	ENDIF
	
	
	
	
	RETURN 0
ENDIF








