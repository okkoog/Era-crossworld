					LOCAL:30 = AI_BRAIN_P:LOCAL:20
					PRINTFORML %FIELD_DEMON_DATE_S:(LOCAL:(LOCAL:40)):CBS_NAME%
				ENDIF
			NEXT
		ENDIF
		
		
		IF LOCAL:(LOCAL:40) < 1 && ((AI_BRAIN_E:L_COUNT:3 >= 10 && LOCAL:20 > 4) || (10 < FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_BATTLE && FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_BATTLE < 20))
			LOCAL:30 = -1 ;戦闘力
			LOCAL:31 = -1 ;危険度
