		ELSE
			LOCAL:30 = -1 ;戦闘力
			LOCAL:31 = -1 ;危険度
			FOR LOCAL, 0, 6
				SIF !(GETBIT(AI_BRAIN_E:L_COUNT:2, AI_BRAIN_P:LOCAL:0))
					CONTINUE
				SIF LOCAL:21 == AI_BRAIN_P:LOCAL:0 || LOCAL:22 == AI_BRAIN_P:LOCAL:0 || LOCAL:23 == AI_BRAIN_P:LOCAL:0
					CONTINUE
				LOCAL:41 = AI_BRAIN_E:L_COUNT:0 + 10
