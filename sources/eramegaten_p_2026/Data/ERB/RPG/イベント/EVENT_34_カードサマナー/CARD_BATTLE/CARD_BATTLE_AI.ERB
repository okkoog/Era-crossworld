							LOCAL:11 = 0
						LOCAL:12 += AI_BRAIN:(LOCAL:1):3
						IF AI_BRAIN:(LOCAL:1):0 >= 100
							LOCAL:13 += 15
						ELSEIF AI_BRAIN:(LOCAL:1):4 == 1
							IF AI_BRAIN:(LOCAL:1):11 > 8 && CS_BLOCK_BATTLE_CHECK(AI_BRAIN:(LOCAL:1):0, AI_BRAIN_E:L_COUNT:0)
								LOCAL:13 += 50
								SIF FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_B_AP + FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_B_HP < FIELD_DEMON_DATE_V:(AI_BRAIN:(LOCAL:1):0):CBV_B_AP + FIELD_DEMON_DATE_V:(AI_BRAIN:(LOCAL:1):0):CBV_B_HP - 4
									BREAK
							;ブロ重9で相手が同格以上なら半減
							ELSEIF AI_BRAIN:(LOCAL:1):11 > 7
								IF FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_B_AP + FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_B_HP - 3 > FIELD_DEMON_DATE_V:(AI_BRAIN:(LOCAL:1):0):CBV_B_AP + FIELD_DEMON_DATE_V:(AI_BRAIN:(LOCAL:1):0):CBV_B_HP
									LOCAL:13 += 10
								ELSEIF 4 > FIELD_DEMON_DATE_V:(AI_BRAIN:(LOCAL:1):0):CBV_B_AP + FIELD_DEMON_DATE_V:(AI_BRAIN:(LOCAL:1):0):CBV_B_HP
									LOCAL:13 += 10
								ELSE
									LOCAL:13 += 13
								ENDIF
							ELSE
								LOCAL:13 += 10
							ENDIF
							;相手が相当各上なら0
							
							LOCAL:14 ++
						ELSEIF AI_BRAIN:(LOCAL:1):4 == 2
							IF AI_BRAIN:(LOCAL:1):11 > 8 && CS_BLOCK_BATTLE_CHECK(AI_BRAIN:(LOCAL:1):0, AI_BRAIN_E:L_COUNT:0)
								LOCAL:13 += 300
								SIF FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_B_AP + FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_B_HP < FIELD_DEMON_DATE_V:(AI_BRAIN:(LOCAL:1):0):CBV_B_AP + FIELD_DEMON_DATE_V:(AI_BRAIN:(LOCAL:1):0):CBV_B_HP - 4
									BREAK
							;ブロ重9で相手が同格以上なら半減
							ELSEIF AI_BRAIN:(LOCAL:1):11 > 7
								IF FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_B_AP + FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_B_HP - 3 > FIELD_DEMON_DATE_V:(AI_BRAIN:(LOCAL:1):0):CBV_B_AP + FIELD_DEMON_DATE_V:(AI_BRAIN:(LOCAL:1):0):CBV_B_HP
									LOCAL:13 += 100
								ELSEIF 4 > FIELD_DEMON_DATE_V:(AI_BRAIN:(LOCAL:1):0):CBV_B_AP + FIELD_DEMON_DATE_V:(AI_BRAIN:(LOCAL:1):0):CBV_B_HP
									LOCAL:13 += 15
								ELSE
									LOCAL:13 += 600
								ENDIF
							ELSE
								LOCAL:13 += 100
							ENDIF
							;相手が相当各上なら0
							
							LOCAL:14 ++
						ENDIF
					ENDIF
				NEXT
				
				;PRINTFORML 使用数 {LOCAL:10}　コスト {LOCAL:12}　消失度 {LOCAL:13}　行動不能数 {LOCAL:14}　敵危険度{AI_BRAIN_E:L_COUNT:1}
				
				
				
				
				IF SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_MAG < LOCAL:12
					CONTINUE
				ELSE
					;PRINTFORML コストOK
				ENDIF
				IF AI_BRAIN_E:L_COUNT:1 < 10 && (CS_F_DEMON_COUNT(0) < 3 || LOCAL:13 > 14)
					CONTINUE
				ELSE
					;PRINTFORML MAG狩りOK
				ENDIF
				IF AI_BRAIN_E:L_COUNT:1 < 15 && LOCAL:13 > 99
					CONTINUE
				ELSE
					;PRINTFORML 弱いやつで消失しすぎないA
				ENDIF
				IF AI_BRAIN_MAX_FP:1:0 - 3 > FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_B_AP + FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_B_HP && LOCAL:13 >= 600
					CONTINUE
				ELSE
					;PRINTFORML 弱いやつで消失しすぎないB
				ENDIF
				
				IF FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_HP <= LOCAL:11 && LOCAL:13 <= LOCAL:23
					PRINTFORML 사용 수 {LOCAL:10}　코스트 {LOCAL:12}　소실도 {LOCAL:13}　행동불능 수 {LOCAL:14}
					;タップ、黄泉数の考慮
					IF LOCAL:14 > 0
						SIF MIN(LOCAL:18 - 1, 2) > LOCAL:15 - LOCAL:14
							CONTINUE
						SIF MIN(LOCAL:19 - 1, 3) > LOCAL:15 - LOCAL:14
							CONTINUE
					ENDIF
					;消失度
					;コスト
					;タップ、黄泉数
					;使用数
					{
					IF  (LOCAL:13 <  LOCAL:23) ||
						(LOCAL:13 == LOCAL:23 && LOCAL:22 >  LOCAL:12) ||
						(LOCAL:13 == LOCAL:23 && LOCAL:22 == LOCAL:12 && LOCAL:24 >  LOCAL:14) ||
						(LOCAL:13 == LOCAL:23 && LOCAL:22 == LOCAL:12 && LOCAL:24 == LOCAL:14 && LOCAL:21 >  LOCAL:10)
					}
						LOCAL:20 = LOCAL
						LOCAL:21 = LOCAL:10;使用数
						LOCAL:22 = LOCAL:12;コスト
						LOCAL:23 = LOCAL:13;消失度
						LOCAL:24 = LOCAL:14;タップ、黄泉数
					ENDIF
				ENDIF
			NEXT
			IF LOCAL:20 > 0
				FOR LOCAL , 0, LOCAL:3
					IF GETBIT(LOCAL:20, LOCAL)
						IF AI_BRAIN:LOCAL:0 < 100
							CALL CB_AI_SET, 1500 + AI_BRAIN:LOCAL:0
						ELSE
							CALL CB_AI_SET, 10000 + AI_BRAIN:LOCAL:10
						ENDIF
						SIF AI_BRAIN:LOCAL:2 == 1
							CALL CB_AI_SET, 100 + AI_BRAIN_E:L_COUNT:0
					ENDIF
				NEXT
				RETURN 1
			ENDIF
		NEXT
	ENDIF
	
	;ブロック強度、Dアタック危険度が40以上且つステータス合計8以上の場合
	
	VARSET AI_BRAIN
	VARSET AI_BRAINS
	LOCAL = 0
	
	;味方の魔法SPでのダメージ計算
	;0-ダメージ　1-範囲　2-使用MAG　2-使用MAG
	FOR L_COUNT, 0, 6
		RESULTS =
		IF CS_SP_USE_CHECK(L_COUNT + 6)
			TRYCCALLFORM CGSP_TYPE_{FIELD_DEMON_DATE_V:(L_COUNT + 6):CBV_SP1}, FIELD_DEMON_DATE_S:(L_COUNT + 6):CBS_SP1_SUB, (L_COUNT + 6)
				IF RESULT == 12 && (RESULT:1 == 998 || RESULT:1 == 997)
					AI_BRAIN:LOCAL:0 = L_COUNT + 6 ;場所
					AI_BRAIN:LOCAL:1 = RESULT:1 ;ステイト
					AI_BRAIN:LOCAL:2 = RESULT:2 ;確率
					AI_BRAINS:LOCAL:0  = RESULTS ;備考
					CALLFORM CGSP_COST_{FIELD_DEMON_DATE_V:(L_COUNT + 6):CBV_SP1}, FIELD_DEMON_DATE_S:(L_COUNT + 6):CBS_SP1_SUB, (L_COUNT + 6)
					AI_BRAIN:LOCAL:3 = RESULT ;コスト
					CALLFORM CGSP_ACTION_AFTER_{FIELD_DEMON_DATE_V:(L_COUNT + 6):CBV_SP1}, FIELD_DEMON_DATE_S:(L_COUNT + 6):CBS_SP1_SUB, (L_COUNT + 6)
					AI_BRAIN:LOCAL:4 = RESULT ;技使用後
					CALLFORM CGSP_TARGET_{FIELD_DEMON_DATE_V:(L_COUNT + 6):CBV_SP1}, FIELD_DEMON_DATE_S:(L_COUNT + 6):CBS_SP1_SUB, (L_COUNT + 6)
					AI_BRAIN:LOCAL:5 = RESULT ;範囲
					AI_BRAIN:LOCAL:6 = CARD_DATE_V:CBV_OFFERING ;供物
					
					AI_BRAIN:LOCAL:11 = AI_BRAIN_P:L_COUNT:1
					AI_BRAIN:LOCAL:12 = AI_BRAIN_P:L_COUNT:2
					AI_BRAIN:LOCAL:13 = AI_BRAIN_P:L_COUNT:3
					AI_BRAIN:LOCAL:14 = AI_BRAIN_P:L_COUNT:4
					AI_BRAIN:LOCAL:15 = AI_BRAIN_P:L_COUNT:5
					
					AI_BRAIN_MAX_SPD += AI_BRAIN:LOCAL:1
					PRINTFORML 即死 場所{AI_BRAIN:LOCAL:0}　%FIELD_DEMON_DATE_S:(AI_BRAIN:LOCAL:0):CBS_NAME%
					
					LOCAL ++
				ENDIF
			CATCH
			ENDCATCH
		ENDIF
	NEXT
	
	IF S_STATE_INFO_GET_F(CS1_OPPONENT, 102) == 0
		FOR L_COUNT, 0, HAND_CARDS(CS1_OPPONENT)
			SIF SUMMONER_HAND_CARDS:CS1_OPPONENT:L_COUNT == 0
				CONTINUE
			CALL CARD_DATA_GET, SUMMONER_HAND_CARDS:CS1_OPPONENT:L_COUNT
			SIF CARD_DATE_V:CBV_KINDS < 100
				CONTINUE
			RESULTS =
			TRYCCALLFORM CGSP_TYPE_{CARD_DATE_V:CBV_SP1}, CARD_DATE_S:CBS_SP1_SUB, L_COUNT
				IF RESULT == 12 && (RESULT:1 == 998 || RESULT:1 == 997)
					AI_BRAIN:LOCAL:0 = L_COUNT + 100 ;場所
					AI_BRAIN:LOCAL:1 = RESULT:1 ;ステイト
					AI_BRAIN:LOCAL:2 = RESULT:2 ;確率
					AI_BRAINS:LOCAL:0  = RESULTS ;備考
					AI_BRAIN:LOCAL:3 = CARD_DATE_V:CBV_COST ;コスト
					AI_BRAIN:LOCAL:4 = 0
					CALLFORM CGSP_TARGET_{CARD_DATE_V:CBV_SP1}, CARD_DATE_S:CBS_SP1_SUB, L_COUNT
					AI_BRAIN:LOCAL:5 = RESULT ;範囲
					
					AI_BRAIN:LOCAL:10 = CARD_DATE_V:CBV_NO
					
					AI_BRAIN_MAX_SPD += AI_BRAIN:LOCAL:1
					
					LOCAL ++
				ENDIF
			CATCH
			ENDCATCH
		NEXT
	ENDIF
	
	
	
	IF LOCAL > 0
		
		;コスト順
		VARSET AI_BRAIN_SORT
		FOR L_COUNT, 0, LOCAL
			AI_BRAIN_SORT:L_COUNT = AI_BRAIN:L_COUNT:3 + 1
		NEXT
		ARRAYMSORT AI_BRAIN_SORT, AI_BRAIN, AI_BRAINS

		;安全度順
		VARSET AI_BRAIN_SORT
		FOR L_COUNT, 0, LOCAL
			AI_BRAIN_SORT:L_COUNT = AI_BRAIN:L_COUNT:4 + 1
		NEXT
		ARRAYMSORT AI_BRAIN_SORT, AI_BRAIN, AI_BRAINS
		
		;確率順
		VARSET AI_BRAIN_SORT
		FOR L_COUNT, 0, LOCAL
			AI_BRAIN_SORT:L_COUNT = 1000 - AI_BRAIN:L_COUNT:2
		NEXT
		ARRAYMSORT AI_BRAIN_SORT, AI_BRAIN, AI_BRAINS
		
		LOCAL:3 = LOCAL
		FOR L_COUNT , 0, 6
			{
			IF FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_B_AP + FIELD_DEMON_DATE_V:(AI_BRAIN_E:L_COUNT:0):CBV_B_HP >= 8
			&& AI_BRAIN_E:L_COUNT:5 >= 40 && AI_BRAIN_E:L_COUNT:6 >= 40
			}
			ELSE
				CONTINUE
			ENDIF
			PRINTFORML 場所{AI_BRAIN_E:L_COUNT:0}　%FIELD_DEMON_DATE_S:(AI_BRAIN_E:L_COUNT:0):CBS_NAME%
			FOR LOCAL, 0, LOCAL:3
				VARSET LOCAL, -1, 10, 30

				IF AI_BRAIN:LOCAL:6 > 0
					LOCAL:1 = 0
					SIF AI_BRAIN:LOCAL:0 >= 100
						SETBIT LOCAL:1, AI_BRAIN:LOCAL:0 - 100
					CALL AICB_OFFERING_SEARCH, AI_BRAIN_OFFERING, AI_BRAIN:LOCAL:6, 15, LOCAL:1, AI_BRAINS:LOCAL:1
					FOR LOCAL:1, 0, AI_BRAIN:LOCAL:6
						LOCAL:(LOCAL:1 + 10) = RESULT:(LOCAL:1)
					NEXT
					SIF LOCAL:(AI_BRAIN:LOCAL:6 + 9) < 0
						CONTINUE
				ENDIF

				IF SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_MAG >= AI_BRAIN:LOCAL:3
					IF AI_BRAIN:LOCAL:0 < 100
						CALL CB_AI_SET, 1500 + AI_BRAIN:LOCAL:0
					ELSE
						CALL CB_AI_SET, 10000 + AI_BRAIN:LOCAL:10
					ENDIF
					IF AI_BRAIN:LOCAL:6 > 0
						FOR L_COUNT_P, 10, 10 + AI_BRAIN:LOCAL:6
							CALL CB_AI_SET, 20000 + AI_BRAIN:(LOCAL:L_COUNT_P):10
						NEXT
						CALL CB_AI_SET, 999
					ENDIF
					CALL CB_AI_SET, 100 + AI_BRAIN_E:L_COUNT:0
						
					RETURN 1
				ENDIF
			NEXT
		NEXT
	ENDIF
	RETURN 0
	
ENDIF





;仲魔を召喚する
;最初の1ターンだとコスト4以内の中で一番HPが高い悪魔を召喚する
IF CS_AI_STEP == 20
	;ダメージSPで敵仲魔を倒す
	VARSET AI_BRAIN
	VARSET AI_BRAINS
	AI_BRAIN_MAX_SPD = 0
	
	LOCAL = 0
	LOCAL:14 = 0 ;フィールド上対飛行能力数
	LOCAL:15 = 0 ;守備重要味方数
	LOCAL:19 = 0 ;危険敵数
	LOCAL:18 = 0 ;準危険敵数
	
	FOR L_COUNT, 0, 6
		SIF AI_BRAIN_E:L_COUNT:3 >= 20
			LOCAL:19 ++
		SIF AI_BRAIN_E:L_COUNT:3 >= 10
			LOCAL:18 ++
	NEXT
	
	FOR L_COUNT, 0, 6
		SIF AI_BRAIN_P:L_COUNT:1 >= 7 ;味方守備重要数
			LOCAL:15 ++
		SIF AI_BRAIN_P:L_COUNT:21 > 0 ;味方対空数
			LOCAL:14 ++
	NEXT
	
	VARSET AI_BRAIN_SORT
	LOCAL:1 = 0
	LOCAL:16 = -1;合体悪魔の最低コスト
	LOCAL:17 = -1;合体悪魔の最大コスト
	LOCAL:20 = 0;無合体0コストの悪魔数
	LOCAL:21 = 0;無合体1コストの悪魔数
	LOCAL:22 = 0;無合体2コストの悪魔数
	LOCAL:23 = 0;無合体3コストの悪魔数
	LOCAL:24 = 0;無合体4コストの悪魔数
	LOCAL:25 = 0
	LOCAL:26 = 0
	LOCAL:27 = 0
	LOCAL:28 = 0
	LOCAL:29 = 0
	FOR L_COUNT, 0, HAND_CARDS(CS1_OPPONENT)
		SIF SUMMONER_HAND_CARDS:CS1_OPPONENT:L_COUNT == 0
			CONTINUE
		CALL CARD_DATA_GET, SUMMONER_HAND_CARDS:CS1_OPPONENT:L_COUNT
		;SIF CARD_DATE_V:CBV_COST > SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_MAG
		;	CONTINUE
		FOR LOCAL, 0, VARSIZE("CARD_DATE_V", 0)
			AI_BRAIN:(LOCAL:1):LOCAL = CARD_DATE_V:LOCAL
		NEXT
		SIF AI_BRAIN:(LOCAL:1):CBV_FUSION < 2 && S_STATE_INFO_GET_F(CS1_OPPONENT, 3) == 3
			AI_BRAIN:(LOCAL:1):CBV_COST = 0
		SIF 2 < CARD_DATE_V:CBV_FUSION && S_STATE_INFO_GET_F(CS1_OPPONENT, 7) == 7
			AI_BRAIN:(LOCAL:1):CBV_FUSION = 2
		SIF RESULT:2 >= CARD_DATE_V:CBV_FUSION && S_STATE_INFO_GET_F(CS1_OPPONENT, 4) == 4
			AI_BRAIN:(LOCAL:1):CBV_FUSION = 0
		IF CARD_DATE_V:CBV_KINDS >= 100
			AI_BRAIN:(LOCAL:1):30 = CARD_DATE_V:CBV_RARITY * 2
			AI_BRAIN_SORT:(LOCAL:1) = 0
			CONTINUE
		ENDIF
		AI_BRAIN:(LOCAL:1):31 = CB_ANTI_AIR_F( )
		AI_BRAIN:(LOCAL:1):CBV_HOST = L_COUNT
		AI_BRAIN:(LOCAL:1):CBV_MAG = MAG_SUPPLY(SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT, CARD_DATE_V:CBV_KINDS, CARD_DATE_V:CBV_FUSION)
		SIF AI_BRAIN:(LOCAL:1):CBV_COST < 10 && AI_BRAIN:(LOCAL:1):CBV_FUSION < 2 && AI_BRAIN:(LOCAL:1):CBV_OFFERING < 1
			LOCAL:(20 + AI_BRAIN:(LOCAL:1):CBV_COST) ++
		IF AI_BRAIN:(LOCAL:1):CBV_FUSION > 1
			SIF LOCAL:16 == -1 || LOCAL:16 > AI_BRAIN:(LOCAL:1):CBV_COST
				LOCAL:16 = AI_BRAIN:(LOCAL:1):CBV_COST
			SIF LOCAL:17 == -1 || LOCAL:17 < AI_BRAIN:(LOCAL:1):CBV_COST
				LOCAL:17 = AI_BRAIN:(LOCAL:1):CBV_COST
		ENDIF
		;AI_BRAIN_SORT:(LOCAL:1) += 10000 - AI_BRAIN:(LOCAL:1):CBV_FUSION * 1000
		;AI_BRAIN_SORT:(LOCAL:1) += AI_BRAIN:(LOCAL:1):CBV_COST * 100
		AI_BRAIN_SORT:(LOCAL:1) += (AI_BRAIN:(LOCAL:1):CBV_AP + AI_BRAIN:(LOCAL:1):CBV_HP * 4/3)
		LOCAL:2 = AI_BRAIN:(LOCAL:1):CBV_B_AP + AI_BRAIN:(LOCAL:1):CBV_B_HP
		
		AI_BRAIN_SORT:(LOCAL:1) += (AI_BRAIN:(LOCAL:1):CBV_SP1 >= 1000 ? CB_SP_DAMGER(AI_BRAIN:(LOCAL:1):CBV_SP1, LOCAL:2)/ 5 # CB_SP_DAMGER(AI_BRAIN:(LOCAL:1):CBV_SP1, LOCAL:2))
		AI_BRAIN_SORT:(LOCAL:1) += (AI_BRAIN:(LOCAL:1):CBV_SP2 >= 1000 ? CB_SP_DAMGER(AI_BRAIN:(LOCAL:1):CBV_SP2, LOCAL:2)/ 5 # CB_SP_DAMGER(AI_BRAIN:(LOCAL:1):CBV_SP2, LOCAL:2))
		
		;SIF AI_BRAIN:(LOCAL:1):CBV_SP1 == 1001 || AI_BRAIN:(LOCAL:1):CBV_SP1 == 1001
		;	AI_BRAIN_SORT:(LOCAL:1) = AI_BRAIN_SORT:(LOCAL:1) / 2
		SIF AI_BRAIN:(LOCAL:1):CBV_FLIGHT > 0
			AI_BRAIN_SORT:(LOCAL:1) += 3
		SIF AI_BRAIN_SORT:(LOCAL:1) < 1
			AI_BRAIN_SORT:(LOCAL:1) = 1
		AI_BRAIN:(LOCAL:1):30 = AI_BRAIN_SORT:(LOCAL:1)
		LOCAL:1 ++
	NEXT
	IF LOCAL:1 > 0
		FOR L_COUNT, 0, HAND_CARDS(CS1_OPPONENT)
			AI_BRAIN_SORT:L_COUNT = 1000 - AI_BRAIN_SORT:L_COUNT
		NEXT
		ARRAYMSORT AI_BRAIN_SORT, AI_BRAIN
	ELSE
		RETURN 0
	ENDIF
	
	LOCAL:30 = SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_MAG
	LOCAL:35 = 0
	
	;コストが低く、無合体の仲魔を召喚
	IF CS_F_DEMON_COUNT(1) < 4 && CBF_TURN != 1
		VARSET AI_BRAIN_SORT
		FOR L_COUNT, 0, LOCAL:1
			AI_BRAIN_SORT:L_COUNT = AI_BRAIN:L_COUNT:CBV_COST + 1
		NEXT
		ARRAYMSORT AI_BRAIN_SORT, AI_BRAIN
		
		LOCAL:30 = SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_MAG
		LOCAL:31 = CS_F_DEMON_COUNT(1)
		LOCAL:32 = 0
		LOCAL:33 = 0
		LOCAL:34 = 0
		VARSET AI_BRAIN_SORT
		FOR L_COUNT, 0, LOCAL:1
			AI_BRAIN_SORT:L_COUNT = AI_BRAIN:L_COUNT:CBV_COST + 1
		NEXT
		ARRAYMSORT AI_BRAIN_SORT, AI_BRAIN
		FOR L_COUNT, 0, LOCAL:1
			SIF AI_BRAIN:L_COUNT:CBV_FUSION > 1 || AI_BRAIN:L_COUNT:CBV_OFFERING > 0
				CONTINUE
			SIF LOCAL:31 > 3
				CONTINUE
			SIF AI_BRAIN:L_COUNT:CBV_COST > LOCAL:30 || LOCAL:32 > 3
				BREAK
			;供物も考慮する
			CALL CB_AI_SET, 10000 + AI_BRAIN:(L_COUNT):0
			LOCAL:30 -= AI_BRAIN:L_COUNT:CBV_COST
			LOCAL:31 ++
			LOCAL:32 ++
		NEXT
		SIF LOCAL:32 > 0
			RETURN 1
	ENDIF
	
	;強いやつを召喚
		VARSET AI_BRAIN_SORT
		FOR L_COUNT, 0, LOCAL:1
			AI_BRAIN_SORT:L_COUNT = 1000 - AI_BRAIN:L_COUNT:30
		NEXT
		ARRAYMSORT AI_BRAIN_SORT, AI_BRAIN

		IF CBF_TURN == 1
			IF CS_F_DEMON_COUNT(1) < 1
				VARSET AI_BRAIN_SORT
				FOR L_COUNT, 0, LOCAL:1
					AI_BRAIN_SORT:L_COUNT = 1000 - MAX(2, MAG_SUPPLY(SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT, AI_BRAIN:L_COUNT:CBV_KINDS, AI_BRAIN:L_COUNT:CBV_FUSION))
				NEXT
				ARRAYMSORT AI_BRAIN_SORT, AI_BRAIN
			ELSEIF CS_F_DEMON_COUNT(1) == 1 && FIELD_DEMON_DATE_V:0:CBV_SP1 > 2
				VARSET AI_BRAIN_SORT
				FOR L_COUNT, 0, LOCAL:1
					AI_BRAIN_SORT:L_COUNT = 1000 - MAX(1, MAG_SUPPLY(SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT, AI_BRAIN:L_COUNT:CBV_KINDS, AI_BRAIN:L_COUNT:CBV_FUSION))
				NEXT
				ARRAYMSORT AI_BRAIN_SORT, AI_BRAIN
			ENDIF
		ENDIF
		
		
		FOR L_COUNT, 0, LOCAL:1
			;SIF SUMMONER_HAND_CARDS:CS1_OPPONENT:L_COUNT == 0
			;	CONTINUE
			FOR LOCAL:4, -1, MAG_MAX
				LOCAL:30 = SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_MAG
				SIF LOCAL:4 > -1 && 1 > MAG_P:(LOCAL:4):0
					BREAK
				SIF LOCAL:4 > -1 && AI_BRAIN:L_COUNT:CBV_HP < 6 && AI_BRAIN:L_COUNT:CBV_AP < 6
					BREAK

				LOCAL:5 = 0
				SIF LOCAL:4 > -1
					LOCAL:5 += MAG_P:(LOCAL:4):0

				SIF AI_BRAIN:L_COUNT:CBV_COST > LOCAL:30
					CONTINUE
				;SIF AI_BRAIN:L_COUNT:CBV_FUSION >= 1
				;	PRINTFORMW {AI_BRAIN:L_COUNT:CBV_FUSION}
				IF AI_BRAIN:L_COUNT:CBV_FUSION >= 2
					;PRINTFORMW {AI_BRAIN:L_COUNT:CBV_NO}
					LOCAL:40 = LOCAL:30 - AI_BRAIN:L_COUNT:CBV_COST + LOCAL:5
					LOCAL:41 = 0 ;素材悪魔可能（ビット）
					LOCAL:42 = 0 ;素材悪魔可能数
					;APとHPが高く、飛行能力があるか無いかで判断
					LOCAL:43 = 0 ;手札内の素材悪魔(コストあり)
					LOCAL:50 = 0
					LOCAL:51 = 0
					LOCAL:52 = 0
					IF AI_BRAIN:L_COUNT:CBV_HP > 4 && AI_BRAIN:L_COUNT:CBV_AP > 4
						CALL CBAI_SPTYPE_CHECK, 2, 45, 7
						LOCAL:50 = RESULT;合体サポート(三身合体軽減,手札)
						LOCAL:51 = (LOCAL:50 > 0 ? 0 # RESULT:1);合体サポート(三身合体軽減,場)
						LOCAL:52 = 0;三身合体軽減使用
					ENDIF
					IF LOCAL:50 > 0
						FOR LOCAL, 0, HAND_CARDS(CS1_OPPONENT)
							IF GETBIT(LOCAL:50, LOCAL)
								LOCAL:50 = LOCAL
								BREAK
							ENDIF
						NEXT
					ELSEIF LOCAL:51 > 0
						LOCAL:2 = 0
						FOR LOCAL, 6, 12
							IF GETBIT(LOCAL:51, LOCAL)
								LOCAL:2 = LOCAL
								IF !GETBIT(LOCAL:51, LOCAL - 6)
									LOCAL:2 = 13
									BREAK
								ENDIF
							ENDIF
						NEXT
						LOCAL:51 = LOCAL:2
					ENDIF

					FOR LOCAL, 0, 6
						SIF FIELD_DEMON_DATE_V:(AI_BRAIN_P:LOCAL:0):CBV_NO < 1
							CONTINUE
						SIF AI_BRAIN_P:LOCAL:CBV_FUSION > 0 && AI_BRAIN_P:LOCAL:20 > 5
							CONTINUE
						SIF AI_BRAIN_P:LOCAL:20 >= AI_BRAIN:L_COUNT:30
							CONTINUE
						SIF AI_BRAIN_P:LOCAL:1 >= 9 && CB_ANTI_AIR_F(AI_BRAIN_P:LOCAL:0) > 0 && 0 == AI_BRAIN:L_COUNT:31
							CONTINUE
						SIF LOCAL:4 > -1 && GETBIT(MAG_P:(LOCAL:4):2, AI_BRAIN_P:LOCAL:0)
							CONTINUE
						SETBIT LOCAL:41, LOCAL
						LOCAL:42 ++
					NEXT
					;PRINTFORMW {LOCAL:42}
					FOR LOCAL, 1, LOCAL:40 / AI_BRAIN:L_COUNT:CBV_FUSION + 1
						LOCAL:43 += LOCAL:(20 + LOCAL)
					NEXT
					IF LOCAL:43 + LOCAL:42 + LOCAL:20 < AI_BRAIN:L_COUNT:CBV_FUSION
						LOCAL:44 = 0 ;合体素材OK
						IF AI_BRAIN:L_COUNT:CBV_FUSION == 3 && CBF_TURN != 1
							FOR LOCAL, LOCAL:40 / AI_BRAIN:L_COUNT:CBV_FUSION + 1, MIN(LOCAL:40, 9)
								SIF LOCAL:(20 + LOCAL) < 1
									CONTINUE
								LOCAL:43 = 0
								LOCAL:45 = LOCAL:40 - LOCAL
								FOR LOCAL:2, 1, LOCAL:45 / 2 + 1
									SIF LOCAL == LOCAL:2
										LOCAL:43 --
									LOCAL:43 += LOCAL:(20 + LOCAL:2)
								NEXT
								IF LOCAL:43 + LOCAL:42 + LOCAL:20 < 2
									FOR LOCAL:2, LOCAL:45 / 2 + 1, MIN(LOCAL:45, 9)
										SIF LOCAL:42 + LOCAL:20 + MIN(LOCAL:(20 + LOCAL:2) - (LOCAL == LOCAL:2 ? 1 # 0), 1) + MIN(LOCAL:(20 + LOCAL:45 - LOCAL:2) - (LOCAL == LOCAL:45 - LOCAL:2 ? 1 # 0), 1) >= 2
											LOCAL:44 = 1
										SIF LOCAL:44 == 1
											BREAK
									NEXT
									SIF LOCAL:45 < 10 && LOCAL:20 + MIN(LOCAL:(20 + LOCAL:45) - (LOCAL == LOCAL:45 ? 1 # 0), 1) >= 2
										LOCAL:44 = 1
								ELSE
									LOCAL:44 = 1
								ENDIF
								SIF LOCAL:44 == 1
									BREAK
								;召喚サポート
							NEXT
						ENDIF
						IF LOCAL:44 == 0 && (AI_BRAIN:L_COUNT:CBV_FUSION == 2 || (AI_BRAIN:L_COUNT:CBV_FUSION == 3 && LOCAL:50 + LOCAL:51 > 0))
							FOR LOCAL, LOCAL:40 / 2 + 1, MIN(LOCAL:40, 9)
								IF LOCAL:42 + LOCAL:20 + MIN(LOCAL:(20 + LOCAL), 1) + MIN(LOCAL:(20 + LOCAL:40 - LOCAL), 1) >= 2
									LOCAL:44 = 1
									SIF AI_BRAIN:L_COUNT:CBV_FUSION > 2
										LOCAL:52 = 1
								ENDIF
								SIF LOCAL:44 == 1
									BREAK
							NEXT
						ENDIF
						SIF LOCAL:40 < 10 && LOCAL:20 + MIN(LOCAL:(20 + LOCAL:40), 1) >= AI_BRAIN:L_COUNT:CBV_FUSION
							LOCAL:44 = 1
						SIF LOCAL:44 == 0
							CONTINUE
					ENDIF
					IF LOCAL:52 == 1 && LOCAL:51 > 0
						FOR LOCAL, 0, 6
							SIF AI_BRAIN_P:LOCAL:0 == LOCAL:51
								CLEARBIT LOCAL:41, LOCAL
						NEXT
					ENDIF
					
					LOCAL:30 -= AI_BRAIN:L_COUNT:CBV_COST + LOCAL:5
					;コストが低い仲魔カード優先で合体素材を選択
					LOCAL:31 = -1
					LOCAL:32 = -1
					LOCAL:33 = -1
					LOCAL:34 = 99
					LOCAL:35 = 99
					LOCAL:36 = CS_F_DEMON_COUNT(1)
					LOCAL:37 = 0
					FOR LOCAL, 11, 5, -1
						SIF FIELD_DEMON_DATE_V:LOCAL:CBV_NO < 1
							LOCAL:37 = LOCAL:37 * 100 + LOCAL
					NEXT
					IF LOCAL:36 < 6
						FOR LOCAL, 0, LOCAL:1
							SIF AI_BRAIN:LOCAL:CBV_FUSION > 1
								CONTINUE
							IF LOCAL:34 > AI_BRAIN:LOCAL:CBV_COST || (LOCAL:34 == AI_BRAIN:LOCAL:CBV_COST && LOCAL:35 > AI_BRAIN:LOCAL:30)
								LOCAL:31 = LOCAL
								LOCAL:34 = AI_BRAIN:LOCAL:CBV_COST
								LOCAL:35 = AI_BRAIN:LOCAL:30
							ENDIF
						NEXT
					ENDIF
					FOR LOCAL, 0, 6
						SIF !GETBIT(LOCAL:41, LOCAL)
							CONTINUE
						IF LOCAL:35 > AI_BRAIN_P:LOCAL:20
							LOCAL:31 = 100 + AI_BRAIN_P:LOCAL:0
							LOCAL:34 = 0
							LOCAL:35 = AI_BRAIN_P:LOCAL:20
						ENDIF
					NEXT
					IF LOCAL:31 < 100 && LOCAL:31 > -1
						LOCAL:30 -= AI_BRAIN:(LOCAL:31):CBV_COST
						LOCAL:36 ++
					ENDIF
					;PRINTFORMW {LOCAL:31}
					
					LOCAL:34 = 99
					LOCAL:35 = 99
					IF LOCAL:36 < 6
						FOR LOCAL, 0, LOCAL:1
							SIF AI_BRAIN:LOCAL:CBV_FUSION > 1
								CONTINUE
							SIF LOCAL == LOCAL:31
								CONTINUE
							SIF AI_BRAIN:LOCAL:CBV_COST > LOCAL:30
								CONTINUE
							IF LOCAL:34 > AI_BRAIN:LOCAL:CBV_COST || (LOCAL:34 == AI_BRAIN:LOCAL:CBV_COST && LOCAL:35 > AI_BRAIN_SORT:LOCAL)
								LOCAL:32 = LOCAL
								LOCAL:34 = AI_BRAIN:LOCAL:CBV_COST
								LOCAL:35 = AI_BRAIN:LOCAL:30
							ENDIF
						NEXT
					ENDIF
					FOR LOCAL, 0, 6
						SIF !GETBIT(LOCAL:41, LOCAL)
							CONTINUE
						SIF 100 + AI_BRAIN_P:LOCAL:0 == LOCAL:31
							CONTINUE
						IF LOCAL:35 > AI_BRAIN_P:LOCAL:20
							LOCAL:32 = 100 + AI_BRAIN_P:LOCAL:0
							LOCAL:34 = 0
							LOCAL:35 = AI_BRAIN_P:LOCAL:20
						ENDIF
					NEXT
					IF LOCAL:32 < 100 && LOCAL:32 > -1
						LOCAL:30 -= AI_BRAIN:(LOCAL:32):CBV_COST
						LOCAL:36 ++
					ENDIF
					;PRINTFORMW {LOCAL:32}
					
					IF AI_BRAIN:L_COUNT:CBV_FUSION > 2
						LOCAL:34 = 99
						LOCAL:35 = 99
						IF LOCAL:36 < 6
							FOR LOCAL, 0, LOCAL:1
								SIF AI_BRAIN:LOCAL:CBV_FUSION > 1
									CONTINUE
								SIF LOCAL == LOCAL:31
									CONTINUE
								SIF LOCAL == LOCAL:32
									CONTINUE
								SIF AI_BRAIN:LOCAL:CBV_COST > LOCAL:30
									CONTINUE
								IF LOCAL:34 > AI_BRAIN:LOCAL:CBV_COST || (LOCAL:34 == AI_BRAIN:LOCAL:CBV_COST && LOCAL:35 > AI_BRAIN_SORT:LOCAL)
									LOCAL:33 = LOCAL
									LOCAL:34 = AI_BRAIN:LOCAL:CBV_COST
									LOCAL:35 = AI_BRAIN:LOCAL:30
								ENDIF
							NEXT
						ENDIF
						FOR LOCAL, 0, 6
							SIF !GETBIT(LOCAL:41, LOCAL)
								CONTINUE
							SIF 100 + AI_BRAIN_P:LOCAL:0 == LOCAL:31
								CONTINUE
							SIF 100 + AI_BRAIN_P:LOCAL:0 == LOCAL:32
								CONTINUE
							IF LOCAL:35 > AI_BRAIN_P:LOCAL:20
								LOCAL:33 = 100 + AI_BRAIN_P:LOCAL:0
								LOCAL:34 = 0
								LOCAL:35 = AI_BRAIN_P:LOCAL:20
							ENDIF
						NEXT
					ELSE
						LOCAL:33 = 999
					ENDIF
					
					;供物も考慮する
					LOCAL:40 = 0
					LOCAL:41 = -1
					LOCAL:42 = -1
					LOCAL:43 = -1
					LOCAL:44 = -1
					LOCAL:45 = -1
					LOCAL:46 = -1
					IF AI_BRAIN:L_COUNT:CBV_OFFERING > 0
						FOR LOCAL, 41, 41 + AI_BRAIN:L_COUNT:CBV_OFFERING - (LOCAL:50 >= 10 ? 1 # 0)
							LOCAL:47 = -1
							LOCAL:48 = 999
							FOR LOCAL:2, 0, HAND_CARDS(CS1_OPPONENT)
								SIF AI_BRAIN:L_COUNT:CBV_HOST == LOCAL:2 || LOCAL:41 == LOCAL:2 || LOCAL:42 == LOCAL:2 || LOCAL:43 == LOCAL:2 || LOCAL:44 == LOCAL:2 || LOCAL:45 == LOCAL:2 || LOCAL:46 == LOCAL:2
									CONTINUE
								SIF LOCAL:31 == LOCAL:2 || LOCAL:32 == LOCAL:2 || LOCAL:33 == LOCAL:2
									CONTINUE
								SIF AI_BRAIN:L_COUNT:30 < AI_BRAIN_OFFERING:(LOCAL:2):20 || (LOCAL:52 > 0 && LOCAL:50 == LOCAL:2)
									CONTINUE
								SIF LOCAL:48 > AI_BRAIN_OFFERING:(LOCAL:2):20 && AI_BRAIN_OFFERING:(LOCAL:2):CBV_KINDS < 100
									CONTINUE
								SIF LOCAL:4 > -1 && GETBIT(MAG_P:(LOCAL:4):2, LOCAL:2 + 12)
									CONTINUE
								LOCAL:(LOCAL) = LOCAL:2
								LOCAL:48 = AI_BRAIN_OFFERING:(LOCAL:2):20
							NEXT
							SIF LOCAL:(LOCAL) < 0
								BREAK
						NEXT
						SIF LOCAL:(40 + AI_BRAIN:L_COUNT:CBV_OFFERING) < 0
							CONTINUE
					ENDIF
					IF LOCAL:52 > 0
						IF LOCAL:50 > 0
							CALL CB_AI_SET, 10000 + AI_BRAIN_OFFERING:(LOCAL:50):CBV_NO
							RETURN 1
						ELSEIF LOCAL:51 > 0
							CALL CB_AI_SET, 1500 + LOCAL:51
							RETURN 1
						ENDIF
					ENDIF
					IF LOCAL:31 > -1 && LOCAL:32 > -1 && LOCAL:33 > -1
						IF LOCAL:4 > -1
							FOR LOCAL , 63, 0, -1
								IF GETBIT(MAG_P:(LOCAL:4):3, LOCAL)
									IF LOCAL < 12
										CALL CB_AI_SET, 1500 + LOCAL
									ELSE
										CALL CB_AI_SET, 10000 + SUMMONER_HAND_CARDS:CS1_OPPONENT:(LOCAL - 12)
									ENDIF
								ENDIF
							NEXT
						ENDIF
						FOR LOCAL, 31, 34
							SIF LOCAL:(LOCAL) < 100
								CALL CB_AI_SET, 10000 + AI_BRAIN:(LOCAL:(LOCAL)):CBV_NO
						NEXT
						CALL CB_AI_SET, 10000 + AI_BRAIN:(L_COUNT):CBV_NO
						IF AI_BRAIN:L_COUNT:CBV_OFFERING > 0
							FOR LOCAL, 41, 41 + AI_BRAIN:L_COUNT:CBV_OFFERING
								CALL CB_AI_SET, 20000 + AI_BRAIN_OFFERING:(LOCAL:(LOCAL)):CBV_NO
							NEXT
							CALL CB_AI_SET, 999
						ENDIF
						FOR LOCAL, 31, 34
							;PRINTFORML {LOCAL:(LOCAL)}
							IF LOCAL:(LOCAL) < 100
								CALL CB_AI_SET, 100 + LOCAL:37 % 100
								LOCAL:37 /= 100
							ELSEIF LOCAL:(LOCAL) / 100 == 1
								CALL CB_AI_SET, LOCAL:(LOCAL)
							ENDIF
						NEXT
						RETURN 1
					ENDIF
				ELSEIF (CS_F_DEMON_COUNT(CS1_OPPONENT) < 6 && CBF_TURN != 1) || (CS_F_DEMON_COUNT(CS1_OPPONENT) < 2 && CBF_TURN == 1)
					;供物も考慮する
					LOCAL:40 = 0
					LOCAL:41 = -1
					LOCAL:42 = -1
					LOCAL:43 = -1
					LOCAL:44 = -1
					LOCAL:45 = -1
					LOCAL:46 = -1
					IF AI_BRAIN:L_COUNT:CBV_OFFERING > 0
						FOR LOCAL, 41, 41 + AI_BRAIN:L_COUNT:CBV_OFFERING
							LOCAL:47 = -1
							LOCAL:48 = 999
							FOR LOCAL:2, 0, HAND_CARDS(CS1_OPPONENT)
								SIF AI_BRAIN:L_COUNT:CBV_HOST == LOCAL:2 || LOCAL:41 == LOCAL:2 || LOCAL:42 == LOCAL:2 || LOCAL:43 == LOCAL:2 || LOCAL:44 == LOCAL:2 || LOCAL:45 == LOCAL:2 || LOCAL:46 == LOCAL:2
									CONTINUE
								SIF AI_BRAIN:L_COUNT:30 < AI_BRAIN_OFFERING:(LOCAL:2):20
									CONTINUE
								SIF LOCAL:48 > AI_BRAIN_OFFERING:(LOCAL:2):20 && AI_BRAIN_OFFERING:(LOCAL:2):CBV_KINDS < 100
									CONTINUE
								SIF LOCAL:4 > -1 && GETBIT(MAG_P:(LOCAL:4):2, LOCAL:2 + 12)
									CONTINUE
								LOCAL:(LOCAL) = LOCAL:2
								LOCAL:48 = AI_BRAIN_OFFERING:(LOCAL:2):20
							NEXT
							SIF LOCAL:(LOCAL) < 0
								BREAK
						NEXT
						SIF LOCAL:(40 + AI_BRAIN:L_COUNT:CBV_OFFERING) < 0
							CONTINUE
					ENDIF
					IF LOCAL:4 > -1
						FOR LOCAL , 63, 0, -1
							IF GETBIT(MAG_P:(LOCAL:4):3, LOCAL)
								IF LOCAL < 12
									CALL CB_AI_SET, 1500 + LOCAL
								ELSE
									CALL CB_AI_SET, 10000 + SUMMONER_HAND_CARDS:CS1_OPPONENT:(LOCAL - 12)
								ENDIF
							ENDIF
						NEXT
					ENDIF
					CALL CB_AI_SET, 10000 + AI_BRAIN:(L_COUNT):CBV_NO
					FOR LOCAL, 41, 41 + AI_BRAIN:L_COUNT:CBV_OFFERING
						CALL CB_AI_SET, 20000 + AI_BRAIN_OFFERING:(LOCAL:(LOCAL)):CBV_NO
					NEXT
					RETURN 1
				ELSEIF AI_BRAIN:L_COUNT:CBV_FUSION < 2 && CBF_TURN != 1
					;kokoko自軍除去
					CALL AICB_OWN_DEMON_REMOVAL, AI_BRAIN_P, LOCAL:30 - AI_BRAIN:L_COUNT:CBV_COST, AI_BRAIN:L_COUNT:30
					SIF RESULT > 0
						RETURN 1
				ENDIF
			NEXT
		NEXT
		
	RETURN 0
	
ENDIF


;一方的に攻撃、防御できる敵が3体以上
