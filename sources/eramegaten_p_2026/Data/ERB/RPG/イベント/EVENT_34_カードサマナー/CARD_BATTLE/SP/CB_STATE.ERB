#FUNCTIONS
#DIM L_DEMON
{
RETURNF STATE_DESCRIPTION_GET(FIELD_DEMON_STATE_V:L_DEMON:ARG:CBV_STATE, FIELD_DEMON_STATE_V:L_DEMON:ARG:CBV_TIMING
, FIELD_DEMON_STATE_V:L_DEMON:ARG:CBV_SUB1, FIELD_DEMON_STATE_V:L_DEMON:ARG:CBV_SUB2, FIELD_DEMON_STATE_V:L_DEMON:ARG:CBV_SUB3
, FIELD_DEMON_STATE_S:L_DEMON:ARG:CBS_SUB1, FIELD_DEMON_STATE_S:L_DEMON:ARG:CBS_SUB2, FIELD_DEMON_STATE_S:L_DEMON:ARG:CBS_SUB3)
}

@STATE_DESCRIPTION_GET, STATE, TIMING = 0, SUB1 = 0, SUB2 = 0, SUB3 = 0, S_SUB1 = "", S_SUB2 = "", S_SUB3 = ""
#FUNCTIONS
#DIM STATE
#DIM TIMING
#DIM SUB1
#DIM SUB2
#DIM SUB3
#DIMS S_SUB1
#DIMS S_SUB2
#DIMS S_SUB3

LOCALS =
LOCAL = STATE
IF 1000 < STATE && STATE < 2000
	IF TIMING == 1
		LOCALS += "自身のプリ―ペアフェイズ時に"
	ELSEIF TIMING == 2
		LOCALS += "相手のプリ―ペアフェイズ時に"
	ELSEIF TIMING == 3
		LOCALS += "プリ―ペアフェイズ時に"
	ELSEIF TIMING == 4
		LOCALS += "自身のバトルフェイズ時に"
	ELSEIF TIMING == 5
		LOCALS += "相手のバトルフェイズ時に"
	ELSEIF TIMING == 6
		LOCALS += "バトルフェイズ時に"
	ELSEIF TIMING == 7
		LOCALS += "アタック時に"
	ELSEIF TIMING == 8
		LOCALS += "ブロック時に"
	ELSEIF TIMING == 9
		LOCALS += "戦闘時に"
	ELSEIF TIMING == 10
		LOCALS += "攻撃成功時に"
	ENDIF
	LOCAL = STATE % 1000
	IF TIMING == 10
		LOCALS += @"{SUB1}ターンの間、"
		;LOCALS += STATE_NAME_GET(LOCAL) + "状態"
		SIF SUB3 / 100 > 0
			LOCAL += 1000
		LOCALS += STATE_NAME_FULL(LOCAL, SUB1, SUB3 / 100, SUB2, 0, 0, S_SUB1, S_SUB2, S_SUB3)
		IF SUB3 == 99
			LOCALS += @"を相手に付与する。"
		ELSE
			LOCALS += @"を{SUB3 % 100}/6の確率で相手に付与する。"
		ENDIF
		SUB1 = SUB2
		SUB2 = 0
		SUB3 = 0
	ELSE
		LOCALS += @"{SUB1}ターンの間、"
		;LOCALS += STATE_NAME_GET(LOCAL) + "状態"
		LOCALS += STATE_NAME_FULL(LOCAL, SUB1, 0, SUB2, SUB3, 0, S_SUB1, S_SUB2, S_SUB3)
		LOCALS += "になる。"
		SUB1 = SUB2
		SUB2 = SUB3
		SUB3 = 0
	ENDIF
	LOCALS += UNICODE(0x000D)
	
	
ENDIF
LOCALS += STATE_COMMENT_GET(STATE, SUB1, SUB2, SUB3, S_SUB1, S_SUB2, S_SUB3)

RETURNF LOCALS





