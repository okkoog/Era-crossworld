@STATE_NAME_FULL2, L_DEMON, ARG
#FUNCTIONS
#DIM L_DEMON
{
RETURNF STATE_NAME_FULL(FIELD_DEMON_STATE_V:L_DEMON:ARG:CBV_STATE, FIELD_DEMON_STATE_V:L_DEMON:ARG:CBV_TURN, FIELD_DEMON_STATE_V:L_DEMON:ARG:CBV_TIMING
, FIELD_DEMON_STATE_V:L_DEMON:ARG:CBV_SUB1, FIELD_DEMON_STATE_V:L_DEMON:ARG:CBV_SUB2, FIELD_DEMON_STATE_V:L_DEMON:ARG:CBV_SUB3
, FIELD_DEMON_STATE_S:L_DEMON:ARG:CBS_SUB1, FIELD_DEMON_STATE_S:L_DEMON:ARG:CBS_SUB2, FIELD_DEMON_STATE_S:L_DEMON:ARG:CBS_SUB3)
}

@STATE_NAME_FULL, L_STATE, L_TURN, L_TIMING = 0, L_SUB1 = 0, L_SUB2 = 0, L_SUB3 = 0, L_S_SUB1 = "", L_S_SUB2 = "", L_S_SUB3 = ""
#FUNCTIONS
#DIM L_STATE
#DIM L_TURN
#DIM L_TIMING
#DIM L_SUB1
#DIM L_SUB2
#DIM L_SUB3
#DIMS L_S_SUB1
#DIMS L_S_SUB2
#DIMS L_S_SUB3

IF L_STATE < 1000
	IF L_STATE == 1
		LOCAL = L_SUB1 % 1000000 / 1000
		IF LOCAL > 100
			LOCALS:1 = {-(LOCAL % 100)}
		ELSE
			LOCALS:1 = +{LOCAL % 100}
		ENDIF
		
		LOCAL = L_SUB1 % 1000
		IF LOCAL > 100
			LOCALS:2 = {-(LOCAL % 100)}
		ELSE
			LOCALS:2 = +{LOCAL % 100}
		ENDIF
		LOCALS = %LOCALS:1%/%LOCALS:2%
	ELSE
		LOCALS '= STATE_NAME_GET(L_STATE)
		SIF L_SUB1 > 0
			LOCALS += @"{L_SUB1}"
	ENDIF
ELSEIF L_STATE >= 2000
	LOCALS '= STATE_NAME_GET(L_STATE)
	IF L_STATE == 2003 || L_STATE == 2004 || L_STATE == 2005
		LOCAL = L_SUB1 % 100000 / 1000
		IF LOCAL > 100
			LOCALS:1 = {-(LOCAL % 100)}
		ELSE
			LOCALS:1 = +{LOCAL % 100}
		ENDIF
		
		LOCAL = L_SUB1 % 1000
		IF LOCAL > 100
			LOCALS:2 = {-(LOCAL % 100)}
		ELSE
			LOCALS:2 = +{LOCAL % 100}
		ENDIF
		LOCALS = %LOCALS%%LOCALS:1%/%LOCALS:2%
	ENDIF
ELSE
	IF L_TIMING == 1
		LOCALS:3 = 自PF時
	ELSEIF L_TIMING == 2
		LOCALS:3 = 敵PF時
	ELSEIF L_TIMING == 3
		LOCALS:3 = PF時
	ELSEIF L_TIMING == 4
		LOCALS:3 = 自BF時
	ELSEIF L_TIMING == 5
		LOCALS:3 = 敵BF時
	ELSEIF L_TIMING == 6
		LOCALS:3 = BF時
	ELSEIF L_TIMING == 7
		LOCALS:3 = ｱﾀｯｸ時
	ELSEIF L_TIMING == 8
		LOCALS:3 = ﾌﾞﾛｯｸ時
	ELSEIF L_TIMING == 9
		LOCALS:3 = 戦闘時
	ELSEIF L_TIMING == 10
		LOCALS:3 = HIT時
	ENDIF
	LOCALS:3 += STATE_NAME_FULL(L_STATE % 1000, L_SUB1, 0, L_SUB2, L_SUB3,0 , L_S_SUB1, L_S_SUB2, L_S_SUB3)
	SIF L_TIMING == 7
		LOCALS:3 += "付与"
	LOCALS = %LOCALS:3%
ENDIF


RETURNF LOCALS
;IF STATE > 1000
;	IF TIMING 


@STATE_PUNUM_GET, L_AP, L_HP
#FUNCTION
#DIM L_AP
#DIM L_HP
#DIM L_RET

IF L_AP < 0
	LOCAL = 100 - L_AP
ELSE
	LOCAL = L_AP
ENDIF
IF L_HP < 0
	L_RET = 100 - L_HP
ELSE
	L_RET = L_HP
ENDIF
L_RET += LOCAL * 1000
RETURNF L_RET

;L_RET 返りステ　0.AP 1.HP
@STATE_PUAPHP_GET, L_NUM, L_RET = 0
#FUNCTION
#DIM L_NUM
#DIM L_RET

IF L_RET == 0
	LOCAL = L_NUM % 100000 / 1000
	IF LOCAL > 100
		LOCAL:1 = -(LOCAL % 100)
	ELSE
		LOCAL:1 = LOCAL
	ENDIF
ELSE
	LOCAL = L_NUM % 1000
	IF LOCAL > 100
		LOCAL:1 = -(LOCAL % 100)
	ELSE
		LOCAL:1 = LOCAL
	ENDIF
ENDIF
RETURNF LOCAL:1



@STATE_INFO_GET, ARG, STATE, TURN = -1, TIMING = -1
#DIM STATE
#DIM TURN
#DIM TIMING
FOR LOCAL, 0, VARSIZE("FIELD_DEMON_STATE_V", 1)
	IF FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_STATE == STATE
		IF FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TURN == TURN || TURN == -1
			IF FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING == TIMING || TIMING == -1
				RESULT:1 = FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TURN
				RESULT:2 = FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_TIMING
				RESULT:3 = FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB1
				RESULT:4 = FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB2
				RESULT:5 = FIELD_DEMON_STATE_V:ARG:LOCAL:CBV_SUB3
				RESULTS:0 = FIELD_DEMON_STATE_S:ARG:LOCAL:CBS_SUB1
				RESULTS:1 = FIELD_DEMON_STATE_S:ARG:LOCAL:CBS_SUB2
				RESULTS:2 = FIELD_DEMON_STATE_S:ARG:LOCAL:CBS_SUB3
				RETURN STATE
			ENDIF
		ENDIF
	ENDIF
NEXT
RETURN 0

