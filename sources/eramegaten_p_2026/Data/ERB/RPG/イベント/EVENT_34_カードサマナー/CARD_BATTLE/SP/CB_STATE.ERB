;CBV_STATE	ステイト　0.通常　1000～.時間差　2000～EXステイト
;CBV_TURN	持続ターン (1000以下の強制ブロックの場合　別の奴)
;CBV_TIMING	時間差ステイトの発動タイミング
;			1、自身プリ―ペアフェイズ
;			2、相手プリ―ペアフェイズ
;			3、両方プリ―ペアフェイズ
;			4、自身バトルフェイズ
;			5、相手バトルフェイズ
;			6、両方バトルフェイズ
;			7、アタック時
;			8、ブロック時
;			9、戦闘時
;			10、戦闘時相手に攻撃したときに相手に付与
;CBV_SUB1	サブ1　通常.ステイトの強さ、時間差.付与するときの持続時間
;CBV_SUB2	サブ2　通常.未使用、時間差.ステイトの強さ
;CBV_SUB3	サブ3　通常.未使用、時間差(タイミング10).1と2桁付与確率.3と4桁付与タイミング



@CB_STATE_ADD, L_DEMON, STATE_DATA_V:CBV_STATE, STATE_DATA_V:CBV_TURN, STATE_DATA_V:CBV_TIMING = 0, STATE_DATA_V:CBV_SUB1 = 0, STATE_DATA_V:CBV_SUB2 = 0, STATE_DATA_V:CBV_SUB3 = 0, STATE_DATA_S:CBS_SUB1 = "", STATE_DATA_S:CBS_SUB2 = "", STATE_DATA_S:CBS_SUB3 = ""
#DIM L_DEMON
#DIM L_COUNT
#DIM STATE_DATA_V, VARSIZE("FIELD_DEMON_STATE_V", 2)
#DIMS STATE_DATA_S, VARSIZE("FIELD_DEMON_STATE_S", 2)
#DIM F_SAME_V
#DIM F_SAME_S
#DIM F_SAME
#DIM F_ADD
#DIMS D_NAME

D_NAME = %CS_PIC_NAME(L_DEMON)%

SIF L_DEMON < 0 || L_DEMON >= VARSIZE("FIELD_DEMON_DATE_V", 0) || STATE_DATA_V:CBV_STATE < 1
	RETURN 0
SIF STATE_DATA_V:CBV_STATE < 1000 && STATE_DATA_V:CBV_TIMING > 0 && STATE_DATA_V:CBV_TURN > 0
	STATE_DATA_V:CBV_STATE += 1000
IF 0
ELSEIF STATE_DATA_V:CBV_STATE == 103
	FIELD_DEMON_DATE_V:L_DEMON:CBV_MAG = 0
	SIF L_DEMON <= CBF_ENEMY_POS6
		CALL CARDBATTLE_MESSAGE, @"%D_NAME%はMAG供給量が0になった。"
		
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 104
	FIELD_DEMON_DATE_V:L_DEMON:CBV_AP = 0
	SIF L_DEMON <= CBF_ENEMY_POS6
		CALL CARDBATTLE_MESSAGE, @"%D_NAME%はAPが0になった。"
		
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 202
	IF FIELD_DEMON_DATE_V:L_DEMON:CBV_BATTLE < 1 && FIELD_DEMON_DATE_V:L_DEMON:CBV_HOST == CBF_P_TURN
		LOCAL = 0
		FOR L_COUNT, FIELD_DEMON_DATE_V:L_DEMON:CBV_HOST * 6, FIELD_DEMON_DATE_V:L_DEMON:CBV_HOST * 6 + 6
			SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE % 10 > 0
				SETBIT LOCAL, FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE % 10
		NEXT
		IF !GETBIT(LOCAL, 1)
			FIELD_DEMON_DATE_V:L_DEMON:CBV_BATTLE = 21
		ELSEIF !GETBIT(LOCAL, 2)
			FIELD_DEMON_DATE_V:L_DEMON:CBV_BATTLE = 22
		ELSEIF !GETBIT(LOCAL, 3)
			FIELD_DEMON_DATE_V:L_DEMON:CBV_BATTLE = 23
		ENDIF
		SIF INRANGE(FIELD_DEMON_DATE_V:L_DEMON:CBV_BATTLE, 20, 30) && L_DEMON <= CBF_ENEMY_POS6
			CALL CARDBATTLE_MESSAGE, @"%D_NAME%は『強制ｱﾀｯｸ』状態になった。"
	ENDIF
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 203
	IF CBV_TURN > 0
		LOCAL = CBV_TURN % 3
		SIF LOCAL == 0
			LOCAL = 3
		FIELD_DEMON_DATE_V:L_DEMON:CBV_BATTLE = 23 + LOCAL
		SIF INRANGE(FIELD_DEMON_DATE_V:L_DEMON:CBV_BATTLE, 20, 30) && L_DEMON <= CBF_ENEMY_POS6
			CALL CARDBATTLE_MESSAGE, @"%D_NAME%は『強制ﾌﾞﾛｯｸ』状態になった。"

	ELSEIF FIELD_DEMON_DATE_V:L_DEMON:CBV_BATTLE < 1 && FIELD_DEMON_DATE_V:L_DEMON:CBV_HOST != CBF_P_TURN
		LOCAL = 0
		FOR L_COUNT, FIELD_DEMON_DATE_V:L_DEMON:CBV_HOST * 6, FIELD_DEMON_DATE_V:L_DEMON:CBV_HOST * 6 + 6
			SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE % 10 > 0
				SETBIT LOCAL, FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE % 10
		NEXT
		IF !GETBIT(LOCAL, 4)
			FIELD_DEMON_DATE_V:L_DEMON:CBV_BATTLE = 24
		ELSEIF !GETBIT(LOCAL, 5)
			FIELD_DEMON_DATE_V:L_DEMON:CBV_BATTLE = 25
		ELSEIF !GETBIT(LOCAL, 6)
			FIELD_DEMON_DATE_V:L_DEMON:CBV_BATTLE = 26
		ENDIF
		SIF INRANGE(FIELD_DEMON_DATE_V:L_DEMON:CBV_BATTLE, 20, 30) && L_DEMON <= CBF_ENEMY_POS6
			CALL CARDBATTLE_MESSAGE, @"%D_NAME%は『強制ﾌﾞﾛｯｸ』状態になった。"
	ENDIF
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 301
	FIELD_DEMON_DATE_V:L_DEMON:CBV_SPEED = MAX(STATE_DATA_V:CBV_SUB1, 1)
	SIF L_DEMON <= CBF_ENEMY_POS6
		CALL CARDBATTLE_MESSAGE, @"%D_NAME%は『先制攻撃』状態になった。"
		
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 302
	FIELD_DEMON_DATE_V:L_DEMON:CBV_SPEED = - MAX(STATE_DATA_V:CBV_SUB1, 1)
	SIF L_DEMON <= CBF_ENEMY_POS6
		CALL CARDBATTLE_MESSAGE, @"%D_NAME%は『後手攻撃』状態になった。"
		
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 303
	FIELD_DEMON_DATE_V:L_DEMON:CBV_SPEED = MIN(FIELD_DEMON_DATE_V:L_DEMON:CBV_SPEED + MAX(STATE_DATA_V:CBV_SUB1, 1), MAX(STATE_DATA_V:CBV_SUB1, 1))
	SIF L_DEMON <= CBF_ENEMY_POS6
		CALL CARDBATTLE_MESSAGE, @"%D_NAME%は攻撃速度が速くなった。"
		
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 304
	FIELD_DEMON_DATE_V:L_DEMON:CBV_SPEED = MAX(FIELD_DEMON_DATE_V:L_DEMON:CBV_SPEED - MAX(STATE_DATA_V:CBV_SUB1, 1), - MAX(STATE_DATA_V:CBV_SUB1, 1))
	SIF L_DEMON <= CBF_ENEMY_POS6
		CALL CARDBATTLE_MESSAGE, @"%D_NAME%は攻撃速度が遅くなった。"
		
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 305
	FIELD_DEMON_DATE_V:L_DEMON:CBV_FLYING = MAX(STATE_DATA_V:CBV_SUB1, 1)
	SIF L_DEMON <= CBF_ENEMY_POS6
		CALL CARDBATTLE_MESSAGE, @"%D_NAME%は『飛行』状態になった。"
		
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 306
	FIELD_DEMON_DATE_V:L_DEMON:CBV_FLYING = - MAX(STATE_DATA_V:CBV_SUB1, 1)
	SIF L_DEMON <= CBF_ENEMY_POS6
		CALL CARDBATTLE_MESSAGE, @"%D_NAME%は『歩行』状態になった。"
		
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 999
	SETBIT FIELD_DEMON_DATE_V:L_DEMON:CBV_CONDITION,0
	SIF L_DEMON <= CBF_ENEMY_POS6
		CALL CARDBATTLE_MESSAGE, @"%D_NAME%は『フリーズ』状態になった。"
		
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 998
	CALL CS_DEMON_DEATH, L_DEMON
		
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 997
	CALL CS_DEMON_BACK, L_DEMON
		
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 996
	SETBIT FIELD_DEMON_DATE_V:L_DEMON:CBV_CONDITION,3
	SIF L_DEMON <= CBF_ENEMY_POS6
		CALL CARDBATTLE_MESSAGE, @"%D_NAME%は『MAG放出』状態になった。"
		
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 995
	CALL CB_STATE_ALLCLEAR, L_DEMON
	SIF L_DEMON <= CBF_ENEMY_POS6
		CALL CARDBATTLE_MESSAGE, @"%D_NAME%の状態が全て消えた。"
		
	RETURN 1
ELSEIF STATE_DATA_V:CBV_STATE == 1
	LOCAL:1 = STATE_DATA_V:CBV_SUB1 % 1000000 / 1000
	LOCAL:2 = STATE_DATA_V:CBV_SUB1 % 1000
	
	LOCAL:1 = ( LOCAL:1 < 100 ? LOCAL:1 # -(LOCAL:1 % 100))
	LOCAL:2 = ( LOCAL:2 < 100 ? LOCAL:2 # -(LOCAL:2 % 100))
	
	CALL SP_PUWER_UP, L_DEMON, LOCAL:1, LOCAL:2
	RETURN 1
ENDIF
F_ADD = 0
F_SAME = 0
FOR LOCAL, 0, VARSIZE("FIELD_DEMON_STATE_V", 1)
	F_SAME_V = 0
	F_SAME_S = 0
	
	FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_STATE_V", 2)
		SIF FIELD_DEMON_STATE_V:L_DEMON:LOCAL:L_COUNT == STATE_DATA_V:L_COUNT
			SETBIT F_SAME_V, L_COUNT
	NEXT
	FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_STATE_S", 2)
		SIF FIELD_DEMON_STATE_S:L_DEMON:LOCAL:L_COUNT == STATE_DATA_S:L_COUNT
			SETBIT F_SAME_S, L_COUNT
	NEXT
	
	IF FIELD_DEMON_STATE_V:L_DEMON:LOCAL:CBV_STATE == 0
		F_ADD = 1
	ELSEIF GETBIT(F_SAME_V, CBV_STATE)
		F_SAME = 1
		IF GETBIT(F_SAME_V, CBV_TIMING) && STATE_DATA_V:CBV_SUB1 > FIELD_DEMON_STATE_V:L_DEMON:LOCAL:CBV_SUB1
			F_ADD = 1
		ELSEIF GETBIT(F_SAME_V, CBV_TIMING) && GETBIT(F_SAME_V, CBV_SUB1) && GETBIT(F_SAME_V, CBV_SUB2) && GETBIT(F_SAME_V, CBV_SUB3) && GETBIT(F_SAME_S, CBS_SUB1) && GETBIT(F_SAME_S, CBS_SUB2) && GETBIT(F_SAME_S, CBS_SUB3)
			IF FIELD_DEMON_STATE_V:L_DEMON:LOCAL:CBV_TURN < STATE_DATA_V:CBV_TURN
				FIELD_DEMON_STATE_V:L_DEMON:LOCAL:CBV_TURN = STATE_DATA_V:CBV_TURN
				LOCALS '= STATE_NAME_FULL(STATE_DATA_V:CBV_STATE, STATE_DATA_V:CBV_TURN, STATE_DATA_V:CBV_TIMING , STATE_DATA_V:CBV_SUB1, STATE_DATA_V:CBV_SUB2, STATE_DATA_V:CBV_SUB3, STATE_DATA_S:CBS_SUB1, STATE_DATA_S:CBS_SUB2, STATE_DATA_S:CBS_SUB3)
				SIF L_DEMON <= CBF_ENEMY_POS6
					CALL CARDBATTLE_MESSAGE, @"%D_NAME%は『%LOCALS%』状態のターンが延長された。"
				RETURN 1
			ELSE
				LOCALS '= STATE_NAME_FULL(STATE_DATA_V:CBV_STATE, STATE_DATA_V:CBV_TURN, STATE_DATA_V:CBV_TIMING , STATE_DATA_V:CBV_SUB1, STATE_DATA_V:CBV_SUB2, STATE_DATA_V:CBV_SUB3, STATE_DATA_S:CBS_SUB1, STATE_DATA_S:CBS_SUB2, STATE_DATA_S:CBS_SUB3)
				SIF L_DEMON <= CBF_ENEMY_POS6
					CALL CARDBATTLE_MESSAGE, @"%D_NAME%は『%LOCALS%』状態にすでになっている。"
				RETURN 0
			ENDIF
		ENDIF
	ELSEIF STATE_DATA_V:CBV_STATE < 1000 && FIELD_DEMON_STATE_V:L_DEMON:LOCAL:CBV_STATE > 1000
		F_ADD = 1
	ELSEIF F_SAME && FIELD_DEMON_STATE_V:L_DEMON:LOCAL:CBV_STATE != STATE_DATA_V:CBV_STATE
		F_ADD = 1
	ENDIF
	IF F_ADD
		SIF FIELD_DEMON_STATE_V:L_DEMON:LOCAL:CBV_STATE > 0
			CALL CB_STATE_SHIFT, L_DEMON, LOCAL
		FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_STATE_V", 2)
			FIELD_DEMON_STATE_V:L_DEMON:LOCAL:L_COUNT = STATE_DATA_V:L_COUNT
		NEXT
		FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_STATE_S", 2)
			FIELD_DEMON_STATE_S:L_DEMON:LOCAL:L_COUNT '= STATE_DATA_S:L_COUNT
		NEXT
		LOCALS '= STATE_NAME_FULL(STATE_DATA_V:CBV_STATE, STATE_DATA_V:CBV_TURN, STATE_DATA_V:CBV_TIMING , STATE_DATA_V:CBV_SUB1, STATE_DATA_V:CBV_SUB2, STATE_DATA_V:CBV_SUB3, STATE_DATA_S:CBS_SUB1, STATE_DATA_S:CBS_SUB2, STATE_DATA_S:CBS_SUB3)
		SIF L_DEMON <= CBF_ENEMY_POS6
			CALL CARDBATTLE_MESSAGE, @"%D_NAME%は『%LOCALS%』状態になった。"
		
		RETURN 1
	ENDIF
NEXT
RETURN 0

@CB_STATE_SHIFT, L_DEMON, ARG, ARG:1 = 1
#DIM L_DEMON
#DIM L_COUNT
SIF L_DEMON < 0 || L_DEMON > CBF_ENEMY_AI_POS6 || ARG:1 < 1
	RETURN

FOR LOCAL, VARSIZE("FIELD_DEMON_STATE_V", 1) - 1 - ARG:1, ARG - 1, -1
	FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_STATE_V", 2)
		FIELD_DEMON_STATE_V:L_DEMON:(LOCAL + ARG:1):L_COUNT = FIELD_DEMON_STATE_V:L_DEMON:LOCAL:L_COUNT
	NEXT
	FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_STATE_S", 2)
		FIELD_DEMON_STATE_S:L_DEMON:(LOCAL + ARG:1):L_COUNT '= FIELD_DEMON_STATE_S:L_DEMON:LOCAL:L_COUNT
	NEXT
NEXT
FOR LOCAL, ARG, ARG + ARG:1
	FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_STATE_V", 2)
		FIELD_DEMON_STATE_V:L_DEMON:LOCAL:L_COUNT = 0
	NEXT
	FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_STATE_S", 2)
		FIELD_DEMON_STATE_S:L_DEMON:LOCAL:L_COUNT =
	NEXT
NEXT

;ステートを消す
;ARG 消す番号
@CB_STATE_DELETE, L_DEMON, ARG
#DIM L_DEMON
#DIM L_COUNT
SIF L_DEMON < 0 || L_DEMON > CBF_ENEMY_AI_POS6 || VARSIZE("FIELD_DEMON_STATE_V", 1) <= ARG
	RETURN
FOR LOCAL, ARG, VARSIZE("FIELD_DEMON_STATE_V", 1) - 1
	FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_STATE_V", 2)
		FIELD_DEMON_STATE_V:L_DEMON:LOCAL:L_COUNT = FIELD_DEMON_STATE_V:L_DEMON:(LOCAL + 1):L_COUNT
	NEXT
	FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_STATE_S", 2)
		FIELD_DEMON_STATE_S:L_DEMON:LOCAL:L_COUNT '= FIELD_DEMON_STATE_S:L_DEMON:(LOCAL + 1):L_COUNT
	NEXT
NEXT

FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_STATE_V", 2)
	FIELD_DEMON_STATE_V:L_DEMON:(VARSIZE("FIELD_DEMON_STATE_V", 1) - 1):L_COUNT = 0
NEXT
FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_STATE_S", 2)
	FIELD_DEMON_STATE_S:L_DEMON:(VARSIZE("FIELD_DEMON_STATE_S", 1) - 1):L_COUNT =
NEXT

;指定されたステートを消す(アタック不可とか　1000+とかのとは一緒にならない)
;ARG	これで指定されたステートを除去する
;L_OPTION 0.指定のみ　1.時間差含む
@CB_STATE_DELETE2, L_DEMON, ARG, L_OPTION = 0
#DIM L_DEMON
#DIM L_COUNT
#DIM L_SEARCH
#DIM L_FLAG
#DIM L_OPTION

L_FLAG = 0

SIF L_DEMON < 0 || L_DEMON > CBF_ENEMY_AI_POS6 || ARG < 1
	RETURN 0
IF 0 <= ARG && ARG < 2000 && L_OPTION == 1
	L_SEARCH = ARG % 1000
	L_FLAG = 1
ENDIF

FOR LOCAL, VARSIZE("FIELD_DEMON_STATE_V", 1) - 1 , -1 , -1
	IF L_FLAG == 1
		SIF FIELD_DEMON_STATE_V:L_DEMON:LOCAL:CBV_STATE % 1000 == L_SEARCH
			CALL CB_STATE_DELETE, L_DEMON, LOCAL
	ELSE
		SIF FIELD_DEMON_STATE_V:L_DEMON:LOCAL:CBV_STATE == ARG
			CALL CB_STATE_DELETE, L_DEMON, LOCAL
	ENDIF
NEXT

;結界等のSPで状態のリセットをする。
;L_DEMON	消す仲魔
;ARG	消す方法
@CB_STATE_ALLCLEAR, L_DEMON, ARG = 0
#DIM L_DEMON
#DIM L_COUNT
SIF L_DEMON < 0 || L_DEMON > CBF_ENEMY_AI_POS6
	RETURN

FOR LOCAL, VARSIZE("FIELD_DEMON_STATE_V", 1) - 1 , -1 , -1
	SIF FIELD_DEMON_STATE_V:L_DEMON:LOCAL:CBV_STATE > 0
		CALL CB_STATE_DELETE, L_DEMON, LOCAL
NEXT


