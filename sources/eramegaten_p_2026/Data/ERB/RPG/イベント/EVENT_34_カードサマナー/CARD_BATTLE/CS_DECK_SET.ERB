
;ARG	表示するデッキ
;ARG:1	空デッキを選択できるか？0でOFF

@CS_DECK_SELECT, ARG = 0, ARG:1 = 1
#DIM L_LINE
L_LINE = LINECOUNT
$INPUT_LOOP

FOR LOCAL, 0, VARSIZE("OWN_CARDDECK", 0)
	
	LOCALS '= (OWN_DECK_NAME:LOCAL == "" ? "----------------------------------------" # OWN_DECK_NAME:LOCAL)
	
	FONTSTYLE 8
	PRINTBUTTON @"[{LOCAL,2}]%LOCALS,40,LEFT%", LOCAL
	PRINTFORM  {CS_DECK_COUNT(LOCAL)}
	FONTSTYLE 0
	SETCOLOR CS_ALICOLOR(0, OWN_DECK_ALIGNMENT:LOCAL / 10)
	PRINTFORM 　%OWN_DECK_ALIGNMENT:LOCAL / 10 == 1 ? "L" # (OWN_DECK_ALIGNMENT:LOCAL / 10 == 3 ? "D" # "N")%
	SETCOLOR CS_ALICOLOR(1, OWN_DECK_ALIGNMENT:LOCAL % 10)
	PRINTFORM %(OWN_DECK_ALIGNMENT:LOCAL % 10) == 1 ? "L" # ((OWN_DECK_ALIGNMENT:LOCAL % 10) == 3 ? "C" # "N")%
	
	SETCOLOR COLOR("DEFAULT")
	SIF OWN_MAINDECK == LOCAL
		SETCOLOR COLOR("PINK")
	PRINTBUTTON @"  [MAIN]", LOCAL + 100
	PRINTL
	
	SETCOLOR COLOR("DEFAULT")
NEXT
CUSTOMDRAWLINE =
PRINTBUTTON @"[99]돌아간다", 99
INPUT
CLEARLINE LINECOUNT - L_LINE
IF 0 <= RESULT && RESULT < 10 && (ARG:1 == 1 || OWN_DECK_ALIGNMENT:RESULT > 10)
	RETURN RESULT
ELSEIF 100 <= RESULT && RESULT < 110
	SIF OWN_DECK_ALIGNMENT:(RESULT - 100) > 10
		OWN_MAINDECK = RESULT - 100
ELSEIF RESULT == 99
	RETURN 99
ENDIF
GOTO INPUT_LOOP



@CS_DECK_SET, L_DECK_C:0 = 1, L_DECK_C:1 = 50
#DIM L_LINE
#DIM L_DECK_C, 2
L_LINE = LINECOUNT
$INPUT_LOOP

PRINTFORML 편집할 덱을 선택해 주세요
PRINTFORML
CALL CS_DECK_SELECT
CLEARLINE LINECOUNT - L_LINE
IF 0 <= RESULT && RESULT < 10
	CALL CS_DECK_SETTING, RESULT, L_DECK_C:0, L_DECK_C:1
	CLEARLINE LINECOUNT - L_LINE
ELSEIF RESULT == 99
	RETURN 99
ENDIF
GOTO INPUT_LOOP


@CS_DECK_SETTING, ARG, L_DECK_C:0 = 1, L_DECK_C:1 = 50
#DIM L_LINE
#DIM L_CARD_SET, VARSIZE("OWN_CARD", 0)
#DIM L_CARD_LIST, VARSIZE("OWN_CARD", 0)
#DIM L_SORT_LIST, VARSIZE("OWN_CARD", 0)
#DIM L_DECK_COUNT
#DIMS L_NAME_SET
#DIM L_ALI_SET
#DIM L_COUNT
#DIM L_LIST
#DIM L_LIST_C
#DIM L_PAGE
#DIM L_SELECT
#DIM L_SORT
#DIM L_SORT_SELECT
#DIMS L_SORTNAME = "번호 오름차순", "번호 내림차순", "속성 오름차순", "속성 내림차순", "AP 오름차순", "AP 내림차순", "HP 오름차순", "HP 내림차순", "합계 오름차순", "합계 내림차순", "코스트 오름차순", "코스트 내림차순", "소지수 오름차순", "소지수 내림차순"
#DIM L_REFINE_ALI
#DIM L_ALI_LIST = -1, 0, 1, 11, 12, 13, 21, 22 ,23, 31, 32, 33, 100
#DIM L_REFINE_MOVE
#DIM L_REFINE_FUSION
#DIM L_DECK_C, 2

VARSET L_CARD_SET
FOR L_COUNT, 0, VARSIZE("OWN_CARDDECK", 1)
	SIF OWN_CARDDECK:ARG:L_COUNT > 0
		L_CARD_SET:(OWN_CARDDECK:ARG:L_COUNT) ++
NEXT
L_ALI_SET = (OWN_DECK_ALIGNMENT:ARG < 11 ? 22 # OWN_DECK_ALIGNMENT:ARG)
L_NAME_SET '= OWN_DECK_NAME:ARG
L_SELECT = 0
L_LINE = LINECOUNT
$SORT_LOOP

VARSET L_CARD_LIST
VARSET L_SORT_LIST
L_LIST = 0
FOR L_COUNT, 1, VARSIZE("OWN_CARD", 0)
	CALL CARD_DATA_GET, L_COUNT
	SIF OWN_CARD:L_COUNT < 1 || CARD_DATE_V:CBV_NO < 1
		CONTINUE
	IF L_ALI_LIST:L_REFINE_ALI < 0 || CARD_DATE_V:CBV_KINDS == L_ALI_LIST:L_REFINE_ALI || (L_ALI_LIST:L_REFINE_ALI == 100 && L_ALI_LIST:L_REFINE_ALI <= CARD_DATE_V:CBV_KINDS)
		IF L_REFINE_FUSION < 1 || (L_REFINE_FUSION == 1 && CARD_DATE_V:CBV_FUSION < 2) || (L_REFINE_FUSION == 2 && CARD_DATE_V:CBV_FUSION > 1)
			IF L_REFINE_MOVE < 1 || L_ALI_LIST:L_REFINE_ALI == 100 || (L_REFINE_MOVE == 1 && CARD_DATE_V:CBV_FLIGHT == 0) || (L_REFINE_MOVE == 2 && CARD_DATE_V:CBV_FLIGHT > 0)
				L_CARD_LIST:L_LIST = L_COUNT
				IF L_SORT == 0
					L_SORT_LIST:L_LIST = CARD_DATE_V:CBV_NO + 1
				ELSEIF L_SORT == 1
					L_SORT_LIST:L_LIST = 10000 - CARD_DATE_V:CBV_NO
				ELSEIF L_SORT == 2
					L_SORT_LIST:L_LIST = CARD_DATE_V:CBV_KINDS + 1
				ELSEIF L_SORT == 3
					L_SORT_LIST:L_LIST = 10000 - CARD_DATE_V:CBV_KINDS
				ELSEIF L_SORT == 4
					L_SORT_LIST:L_LIST = CARD_DATE_V:CBV_AP + 1
				ELSEIF L_SORT == 5
					L_SORT_LIST:L_LIST = 10000 - CARD_DATE_V:CBV_AP
				ELSEIF L_SORT == 6
					L_SORT_LIST:L_LIST = CARD_DATE_V:CBV_HP + 1
				ELSEIF L_SORT == 7
					L_SORT_LIST:L_LIST = 10000 - CARD_DATE_V:CBV_HP
				ELSEIF L_SORT == 8
					L_SORT_LIST:L_LIST = CARD_DATE_V:CBV_AP + CARD_DATE_V:CBV_HP + 1
				ELSEIF L_SORT == 9
					L_SORT_LIST:L_LIST = 10000 - (CARD_DATE_V:CBV_AP + CARD_DATE_V:CBV_HP)
				ELSEIF L_SORT == 10
					L_SORT_LIST:L_LIST = CARD_DATE_V:CBV_COST + 1
				ELSEIF L_SORT == 11
					L_SORT_LIST:L_LIST = 10000 - CARD_DATE_V:CBV_COST
				ELSEIF L_SORT == 12
					L_SORT_LIST:L_LIST = OWN_CARD:L_COUNT + 1
				ELSEIF L_SORT == 13
					L_SORT_LIST:L_LIST = 10000 - OWN_CARD:L_COUNT
				ENDIF
				L_LIST++
			ENDIF
		ENDIF
	ENDIF
NEXT

;FOR L_COUNT, 0, 10
;	PRINTFORML {L_CARD_LIST:L_COUNT} {L_SORT_LIST:L_COUNT} {OWN_CARD:(L_CARD_LIST:L_COUNT)}
;NEXT

ARRAYMSORT L_SORT_LIST, L_CARD_LIST

$INPUT_LOOP
CLEARLINE LINECOUNT - L_LINE

L_DECK_COUNT = 0
FOR L_COUNT, 1, VARSIZE("OWN_CARD", 0)
	CALL CARD_DATA_GET, L_COUNT
	SIF CARD_DATE_V:CBV_NO
		L_DECK_COUNT += L_CARD_SET:L_COUNT
NEXT

CALL SET_PICTURE, , , "消去"
CALL CARDDATA_WINDOW , L_SELECT , 0 , 0 , 50
;                                    NEUTRAL-NEUTRAL
;                         3         4         5         6         7         8
;                   456789012345678901234567890123456789012345678901234567890123456789
CALL SET_PICTURE , "카드 목록┏━━━━┳━━━━━━━┳━━━━━━━┳━━━━━━━┓" , 0 , , 24
CALL SET_PICTURE , "　　　　　┃조건검색┃속성:     ＜＞┃이동:     ＜＞┃합체:     ＜＞┃" , 1 , , 24
CALL SET_PICTURE , "　　　　　┣━━━━╋━━━━━━━┻━━━━━━━┻━━━━━━━┫" , 2 , , 24
CALL SET_PICTURE , "　　　　　┃정렬방식┃                                          ＜＞┃" , 3 , , 24
CALL SET_PICTURE , "　　　　　┗━━━━┻━━━━━━━━━━━━━━━━━━━━━━━┛" , 4 , , 24

CALL SET_PICTURE , L_ALI_LIST:L_REFINE_ALI < 0 ? "----" # (L_ALI_LIST:L_REFINE_ALI < 100 ? @" %ALIGNMENT_PICTURE(L_ALI_LIST:L_REFINE_ALI,1)%_" # "ITEM_") , 1 , , 51
CALL SET_PICTURE , "＜,,,101_＞,,,100_" , 1 , , 56
CALL SET_PICTURE , L_REFINE_MOVE == 1 ? "歩行" # (L_REFINE_MOVE == 2 ? "飛行" # "----") , 1 , , 67
CALL SET_PICTURE , "＜,,,103_＞,,,102_" , 1 , , 72
CALL SET_PICTURE , L_REFINE_FUSION == 1 ? "통상" # (L_REFINE_FUSION == 2 ? "合体" # "----") , 1 , , 83
CALL SET_PICTURE , "＜,,,105_＞,,,104_" , 1 , , 88

CALL SET_PICTURE , L_SORTNAME:L_SORT , 3 , , 46
CALL SET_PICTURE , "＜,,,201_＞,,,200_" , 3 , , 88


L_LIST_C = 39
FOR L_COUNT, 0, L_LIST_C
	LOCAL = L_PAGE * L_LIST_C + L_COUNT
	
	CALL CARD_DATA_GET, L_CARD_LIST:LOCAL
	SIF CARD_DATE_V:CBV_NO < 1
		BREAK
	
	CALL SET_PICTURE , CARD_DATE_S:CBS_RACE , (L_COUNT % (L_LIST_C / 3)) * 3 + 5 , , (L_COUNT / (L_LIST_C / 3)) * 28 + 24
	CALL SET_PICTURE , @"%CARD_DATE_S:CBS_NAME%,{KINDSCOLOR(CARD_DATE_V:CBV_KINDS)},,{10000 + CARD_DATE_V:CBV_NO}" , (L_COUNT % (L_LIST_C / 3)) * 3 + 5 , , (L_COUNT / (L_LIST_C / 3)) * 28 + 30
	CALL SET_PICTURE , @"＋,{COLOR("P-BLUE")},,{20000 + CARD_DATE_V:CBV_NO}_－,{COLOR("P-RED")},,{30000 + CARD_DATE_V:CBV_NO}" , (L_COUNT % (L_LIST_C / 3)) * 3 + 5 , , (L_COUNT / (L_LIST_C / 3)) * 28 + 46
	
	IF CARD_DATE_V:CBV_KINDS >= 100
		LOCALS =
		IF CARD_DATE_V:CBV_FUSION == 2
			LOCALS += "② "
		ELSEIF CARD_DATE_V:CBV_FUSION == 3
			LOCALS += "③ "
		ELSE
			LOCALS += "◆ "
		ENDIF
		LOCALS += @"{CARD_DATE_V:CBV_COST}%"ﾛ" * CARD_DATE_V:CBV_OFFERING%"
		CALL SET_PICTURE , LOCALS , (L_COUNT % (L_LIST_C / 3)) * 3 + 6 , , (L_COUNT / (L_LIST_C / 3)) * 28 + 24
		
	ELSE
		LOCALS =
		IF CARD_DATE_V:CBV_FUSION == 2
			LOCALS += "②"
		ELSEIF CARD_DATE_V:CBV_FUSION == 3
			LOCALS += "③"
		ELSE
			LOCALS += "●"
		ENDIF
		LOCALS += @"{CARD_DATE_V:CBV_COST}" + (CARD_DATE_V:CBV_OFFERING > 0 ? @"ﾛ{CARD_DATE_V:CBV_OFFERING}" # "")
		CALL SET_PICTURE , LOCALS , (L_COUNT % (L_LIST_C / 3)) * 3 + 6 , , (L_COUNT / (L_LIST_C / 3)) * 28 + 24
		CALL SET_PICTURE , @"AP:{CARD_DATE_V:CBV_AP,2} HP:{CARD_DATE_V:CBV_HP,2}" , (L_COUNT % (L_LIST_C / 3)) * 3 + 6 , , (L_COUNT / (L_LIST_C / 3)) * 28 + 30
	ENDIF
	
	CALL SET_PICTURE , @"持:{OWN_CARD:(CARD_DATE_V:CBV_NO),2}" , (L_COUNT % (L_LIST_C / 3)) * 3 + 6 , , (L_COUNT / (L_LIST_C / 3)) * 28 + 42
	CALL SET_PICTURE , @"x{L_CARD_SET:(CARD_DATE_V:CBV_NO)},{L_CARD_SET:(CARD_DATE_V:CBV_NO) > 0 ? COLOR("AQUA") # COLOR("WHITE")}" , (L_COUNT % (L_LIST_C / 3)) * 3 + 6 , , (L_COUNT / (L_LIST_C / 3)) * 28 + 48
	
NEXT

CALL SET_PICTURE , @"PAGE.{L_PAGE + 1,2}" , 44 , , 62
SIF L_PAGE > 0
	CALL SET_PICTURE , "＜ＢＡＣＫ,,,11" , 44 , , 24
SIF L_PAGE < (L_LIST / L_LIST_C) - (L_LIST % L_LIST_C == 0 ? 1 # 0)
	CALL SET_PICTURE , "ＮＥＸＴ＞,,,10" , 44 , , 96




;                                 NEUTRAL-NEUTRAL
;                         3         4         5         6         7         8
;                   456789012345678901234567890123456789012345678901234567890123456789
CALL SET_PICTURE , "┏━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━┓" , 45 , , 24
CALL SET_PICTURE , "┃덱 이름  ┃                                        [변경]┃" , 46 , , 24
CALL SET_PICTURE , "┣━━━━━╋━━━━━━━━━━━┳━━━━━┳━━━━━┫" , 47 , , 24
CALL SET_PICTURE , "┃덱 속성┃                  ＜＞┃덱 매수┃        00┃" , 48 , , 24
CALL SET_PICTURE , "┗━━━━━┻━━━━━━━━━━━┻━━━━━┻━━━━━┛" , 49 , , 24
CALL SET_PICTURE , L_NAME_SET , 46 , , 38
CALL SET_PICTURE , "[変更],,,3" , 46 , , 78
CALL SET_PICTURE , @"%ALIGNMENT_PICTURE(L_ALI_SET)%_" , 48 , , 38
CALL SET_PICTURE , "＜,,,2_＞,,,1_" , 48 , , 56
CALL SET_PICTURE , @"{L_DECK_COUNT,2}" , 48 , , 82
CALL SET_PICTURE , @"{L_DECK_C:0,2}-{L_DECK_C:1,2},{COLOR("パ緑")}" , 48 , , 74
;おおおおおおおおおお                    
CALL SET_PICTURE , "[다른 덱에서 복사],,,1001" , 46 , , 86
CALL SET_PICTURE , "[결정],,,1000_[돌아간다],,,9999" , 49 , , 86

FOR L_COUNT, 0, 50
	CALL SET_PICTURE , "┃" , L_COUNT , , 106
NEXT


LOCAL = 0
FOR LOCAL:1, 3, -2, -1
	FOR LOCAL:2, 9, -2, -1
		FOR L_COUNT, 1, VARSIZE("L_CARD_SET", 0)
			IF L_CARD_SET:L_COUNT > 0
				CALL CARD_DATA_GET, L_COUNT
				IF (LOCAL:1 == CARD_DATE_V:CBV_FUSION && LOCAL:2 == CARD_DATE_V:CBV_COST && LOCAL:1 > -1 && CARD_DATE_V:CBV_KINDS < 100) || (LOCAL:1 <= -1 && LOCAL:2 <= -1 && CARD_DATE_V:CBV_KINDS >= 100)
					;CALL SET_PICTURE , CARD_DATE_S:CBS_RACE , LOCAL , , 108
					LOCALS =
					IF CARD_DATE_V:CBV_KINDS >= 100
						LOCALS += "◆"
					ELSEIF CARD_DATE_V:CBV_FUSION == 2
						LOCALS += "②"
					ELSEIF CARD_DATE_V:CBV_FUSION == 3
						LOCALS += "③"
					ELSE
						LOCALS += "●"
					ENDIF
					LOCALS += @"{CARD_DATE_V:CBV_COST}"
					CALL SET_PICTURE , LOCALS , LOCAL , , 108
					CALL SET_PICTURE , @"%CARD_DATE_S:CBS_NAME%,{KINDSCOLOR(CARD_DATE_V:CBV_KINDS)},,{10000 + CARD_DATE_V:CBV_NO}" , LOCAL , , 112
					CALL SET_PICTURE , @"x{L_CARD_SET:L_COUNT}" , LOCAL , , 128
					CALL SET_PICTURE , @"+,{COLOR("P-BLUE")},,{20000 + CARD_DATE_V:CBV_NO}_-,{COLOR("P-RED")},,{30000 + CARD_DATE_V:CBV_NO}" , LOCAL++ , , 130
				ENDIF
			ENDIF
			;L_DECK_COUNT += L_CARD_SET:L_COUNT
		NEXT
	NEXT
NEXT

CALL SET_PICTURE, , 0, "HTML表示", 50

INPUT

IF RESULT == 1 || RESULT == 2
	IF RESULT == 1
		L_ALI_SET++
	ELSE
		L_ALI_SET--
	ENDIF
	SIF L_ALI_SET % 10 == 4
		L_ALI_SET += 7
	SIF L_ALI_SET % 10 == 0
		L_ALI_SET -= 7
	SIF L_ALI_SET < 11
		L_ALI_SET = 33
	SIF L_ALI_SET > 33
		L_ALI_SET = 11
ELSEIF RESULT == 3
	PRINTL 변경할 덱 이름을 입력해 주세요.
	INPUTS
	L_NAME_SET '= RESULTS
ELSEIF RESULT == 10 && L_PAGE < (L_LIST / L_LIST_C) - (L_LIST % L_LIST_C == 0 ? 1 # 0)
	L_PAGE++
ELSEIF RESULT == 11 && L_PAGE > 0
	L_PAGE--
ELSEIF RESULT >= 100 && RESULT <= 105
	SIF RESULT == 100
		L_REFINE_ALI++
	SIF RESULT == 101
		L_REFINE_ALI--
	SIF RESULT == 102
		L_REFINE_MOVE++
	SIF RESULT == 103
		L_REFINE_MOVE = ( L_REFINE_MOVE < 1 ? 2 # L_REFINE_MOVE - 1)
	SIF RESULT == 104
		L_REFINE_FUSION++
	SIF RESULT == 105
		L_REFINE_FUSION = ( L_REFINE_FUSION < 1 ? 2 # L_REFINE_FUSION - 1)
	
	SIF L_REFINE_ALI < 0
		L_REFINE_ALI = VARSIZE("L_ALI_LIST", 0) - 1
	L_REFINE_ALI %= VARSIZE("L_ALI_LIST", 0)
	L_REFINE_MOVE %= 3
	L_REFINE_FUSION %= 3
	
	L_PAGE = 0
	GOTO SORT_LOOP
ELSEIF RESULT == 200 || RESULT == 201
	IF RESULT == 200
		L_SORT++
	ELSE
		L_SORT = ( L_SORT < 1 ? VARSIZE("L_SORTNAME", 0) - 1 # L_SORT - 1)
	ENDIF
	L_SORT %= VARSIZE("L_SORTNAME", 0)
	GOTO SORT_LOOP
ELSEIF RESULT == 1000
;L_DECK_C:0 = 50, L_DECK_C:1 = 50
;IF L_DECK_C:0 > L_DECK_COUNT || L_DECK_COUNT > L_DECK_C:1
	IF 1 > L_DECK_COUNT || L_DECK_COUNT > 50
		PRINTW 덱의 카드 매수가 부족합니다.
	ELSEIF STRLENS(L_NAME_SET) < 1
		PRINTW 덱 이름이 입력되지 않았습니다.
	ELSE
		OWN_DECK_ALIGNMENT:ARG = L_ALI_SET
		OWN_DECK_NAME:ARG '= L_NAME_SET
		
		LOCAL = 0
		FOR L_COUNT, 0, 50
			OWN_CARDDECK:ARG:L_COUNT = 0
		NEXT
		FOR L_COUNT, 0, VARSIZE("L_CARD_SET", 0)
			IF L_CARD_SET:L_COUNT > 0
				FOR LOCAL:1, 0, L_CARD_SET:L_COUNT
					OWN_CARDDECK:ARG:(LOCAL++) = L_COUNT
				NEXT
			ENDIF
		NEXT
		RETURN
	ENDIF
ELSEIF RESULT == 1001
;L_DECK_C:0 = 50, L_DECK_C:1 = 50
;IF L_DECK_C:0 > L_DECK_COUNT || L_DECK_COUNT > L_DECK_C:1
	CALL CS_DECK_SELECT, 0, 0
	LOCAL = RESULT
	IF 0 <= LOCAL && LOCAL < VARSIZE("OWN_CARDDECK", 0)

		PRINTL 
		PRINTFORM 　　
		FONTSTYLE 8
		PRINTFORM %OWN_DECK_NAME:LOCAL,40,LEFT%
		PRINTFORM  {CS_DECK_COUNT(LOCAL)}
		FONTSTYLE 0
		SETCOLOR CS_ALICOLOR(0, OWN_DECK_ALIGNMENT:LOCAL / 10)
		PRINTFORM 　%OWN_DECK_ALIGNMENT:LOCAL / 10 == 1 ? "L" # (OWN_DECK_ALIGNMENT:LOCAL / 10 == 3 ? "D" # "N")%
		SETCOLOR CS_ALICOLOR(1, OWN_DECK_ALIGNMENT:LOCAL % 10)
		PRINTFORM %(OWN_DECK_ALIGNMENT:LOCAL % 10) == 1 ? "L" # ((OWN_DECK_ALIGNMENT:LOCAL % 10) == 3 ? "C" # "N")%
		RESETCOLOR
		PRINTL 
		PRINTL 이 덱의 카드를 복사하시겠습니까?
		PRINTL ※현재 세트 데이터에 덮어씌워집니다.
		PRINTL [1]이 덱을 복사한다　[2]복사하지 않는다
		INPUT
		
		IF RESULT == 1
			L_ALI_SET = OWN_DECK_ALIGNMENT:LOCAL
			L_NAME_SET '= OWN_DECK_NAME:LOCAL
			
			VARSET L_CARD_SET
			FOR L_COUNT, 0, VARSIZE("OWN_CARDDECK", 1)
				SIF OWN_CARDDECK:LOCAL:L_COUNT > 0
					L_CARD_SET:(OWN_CARDDECK:LOCAL:L_COUNT) += 1
			NEXT
		ENDIF
	ENDIF
	
	
ELSEIF RESULT == 9999
	PRINTL 변경 사항을 취소하고 돌아가시겠습니까?
	CALL INPUT_YN,,,2
	SIF RESULT == 0
		RETURN
ELSEIF RESULT > 9999 && RESULT < 40000
	LOCAL = RESULT
	CALL CARD_DATA_GET, LOCAL % 10000
	IF CARD_DATE_V:CBV_NO > 0
		L_SELECT = LOCAL % 10000
		LOCAL:1 = (CARD_DATE_V:CBV_LIMIT > 0 && CARD_DATE_V:CBV_LIMIT < 3 ? CARD_DATE_V:CBV_LIMIT # 3)
		SIF LOCAL / 10000 == 2 && L_CARD_SET:L_SELECT < LOCAL:1 && L_DECK_COUNT < 50 && L_CARD_SET:L_SELECT < OWN_CARD:L_SELECT
			L_CARD_SET:L_SELECT++
		SIF LOCAL / 10000 == 3 && L_CARD_SET:L_SELECT > 0
			L_CARD_SET:L_SELECT--
	ENDIF
ENDIF
GOTO INPUT_LOOP

@CS_DECK_COUNT, ARG
#FUNCTION
#DIM L_COUNT
#DIM L_CARD
L_CARD = 0
FOR L_COUNT, 0, VARSIZE("OWN_CARDDECK", 1)
	SIF OWN_CARDDECK:ARG:L_COUNT > 0
		L_CARD ++
NEXT
RETURNF L_CARD

@CS_OBTAIN_CARD_SET
FOR LOCAL, 0, VARSIZE("OWN_CARD", 0)
	SIF OWN_CARD:LOCAL > 0
		SETBIT OBTAIN_CARD:(LOCAL / 64) , LOCAL % 64
NEXT

@CS_OBTAIN_CARD_GET, ARG = 0
#FUNCTION
IF ARG == 0
	RETURNF 0
ELSE
	RETURNF GETBIT(OBTAIN_CARD:(ARG / 64) , ARG % 64)
ENDIF

@CS_OBTAIN_CARD_COUNT
#FUNCTION
#DIM L_CARD
