
;特技名
@CGSP_NAME_604, ARGS, ARG
RESULTS = ゴッドドロー

;　コストの量
@CGSP_COST_604, ARGS, ARG
RETURN 2
;1

;　타겟(選択するかしないか)
@CGSP_TARGET_604, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_604, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_604, ARGS, ARG, ARG:1
FOR LOCAL,0,8
	IF HAND_CARDS(CS1_ONESELF) < 8
		CALL CS_DECKCARD_DRAW, CS1_ONESELF, 1
	ENDIF
	IF HAND_CARDS(CS1_OPPONENT) < 8
		CALL CS_DECKCARD_DRAW, CS1_OPPONENT, 1
	ENDIF
NEXT
CALL CARDBATTLE_MESSAGE, CS_PIC_NAME(100 + CS1_ONESELF) + "と" + CS_PIC_NAME(100 + CS1_OPPONENT) + @"は8枚になるまでカードを引いた。"

;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_604, ARGS, ARG, ARG:1
RETURN 3
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_604, ARGS, ARG
RESULTS = 両サマナーは手札が8枚になるまでの山札からカードを引く。このSPを使った仲魔は黄泉に葬られる。

;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　30 회복
@CGSP_TYPE_604, ARGS, ARG
RETURN 40, 8

;使用条件
;特になければ省略してOK
@CGSP_SPECIAL_ACTIONABLE_604, ARGS, ARG
SIF HAND_CARDS(FIELD_DEMON_DATE_V:ARG:CBV_HOST) < 8
	RETURN 1
RETURN 0
;とくにない

