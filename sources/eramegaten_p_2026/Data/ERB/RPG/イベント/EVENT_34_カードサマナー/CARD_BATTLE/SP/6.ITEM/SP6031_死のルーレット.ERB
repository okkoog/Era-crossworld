
;特技名
@CGSP_NAME_6031, ARGS, ARG
RESULTS = 死のルーレット

;　コストの量
@CGSP_COST_6031, ARGS, ARG
RETURN 2


;　타겟(選択するかしないか)
@CGSP_TARGET_6031, ARGS, ARG
RETURN 0
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか
;自動発動なので0

;　発動タイミング
@CGSP_TIMING_6031, ARGS, ARG
RETURN 0
;0-アクティブ　1-味方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　2-相手ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ　3-両方ﾌﾟﾘｰﾍﾟｱﾌｪｲｽﾞ

;====================================================
;特技発動
;====================================================
@CGSP_ACTION_6031, ARGS, ARG, ARG:1
;
#DIM L_COUNT
#DIM L_T ,12

LOCAL = 0
FOR L_COUNT, CBF_ALLY_POS1, CBF_ENEMY_POS6 + 1
    SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO > 0
        L_T:(LOCAL ++) = L_COUNT
NEXT
SIF LOCAL > 0
    CALL CB_STATE_ADD, L_T:(RAND:LOCAL), 998, 1

;====================================================
;実行内容ここまで
;====================================================
;発動後どうなるか
@CGSP_ACTION_AFTER_6031, ARGS, ARG, ARG:1
RETURN 0
;0-何もなし　1-フリーズ状態　2-山札に戻る　3-即死する

;　 説明文の表示
@CGSP_EXPLAIN_6031, ARGS, ARG
RESULTS = 場にいる仲魔の、どれか1体を黄泉に送る。『強力な破魔の力をこめたルーレット』

;　スキルタイプ
;　主にこのターンパワーアップとアギとかのダメージ系で使用
;　それ以外は省略
;　101は敵味方ランダム
@CGSP_TYPE_6031, ARGS, ARG
RETURN 12, 998, 101


