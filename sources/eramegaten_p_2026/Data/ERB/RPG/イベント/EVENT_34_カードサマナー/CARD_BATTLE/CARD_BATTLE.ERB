			CONTINUE
		SIF L_COUNT < 6 && GETBIT(FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION, 2)
			CARD_USING_COUNT:(FIELD_DEMON_DATE_V:L_COUNT:CBV_NO) ++
