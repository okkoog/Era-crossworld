

;バトル種類　0-通常バトル
;自分最大HP　-1の場合自分のデッキをセットするのみ
;敵最大HP
;戻り値　2-KO勝ち　1-判定勝ち　0-引き分け　-1ギブアップ負け　-2判定負け　-3KO負け

@CS_BATTLE_START, ARG = 0, ARG:1 = 20, ARG:2 = 20, L_DECK_C:0 = 10, L_DECK_C:1 = 50
#DIM L_LINE
#DIM L_DECK_C, 2

IF CS_DECK_FIXED == 0
	IF ARG:1 != -1
		IF (DECK_CARDS(CS1_OPPONENT) < 1 || DECK_CARDS(CS1_OPPONENT) > 50) && ARG == 0
			PRINTW 적의 덱이 세트되어 있지 않습니다.
			RETURN 0
		ENDIF

		IF 1 > SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT % 10 || SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT % 10 > 3 || 1 > SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT / 10 || SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT / 10 > 3
			PRINTW 적의 성향 정보가 올바르지 않습니다. NN속성을 설정합니다.
			SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT = 22
		ENDIF
	ENDIF

	L_LINE = LINECOUNT
	LOCAL = OWN_MAINDECK
	SIF OWN_DECK_ALIGNMENT:LOCAL < 11 || OWN_DECK_NAME:LOCAL == ""
		LOCAL = -1
	RESULT = 0
	$INPUT_LOOP
	IF 0 <= LOCAL && L_DECK_C:0 <= CS_DECK_COUNT(LOCAL) && CS_DECK_COUNT(LOCAL) <= L_DECK_C:1
		PRINTL 이 덱으로 도전하시겠습니까?
		PRINTL 
		PRINTFORM 　　
		FONTSTYLE 8
		PRINTFORM %OWN_DECK_NAME:LOCAL,40,LEFT%
		PRINTFORM  {CS_DECK_COUNT(LOCAL)}
		FONTSTYLE 0
		SETCOLOR CS_ALICOLOR(0, OWN_DECK_ALIGNMENT:LOCAL / 10)
		PRINTFORM 　%OWN_DECK_ALIGNMENT:LOCAL / 10 == 1 ? "L" # (OWN_DECK_ALIGNMENT:LOCAL / 10 == 3 ? "D" # "N")%
		SETCOLOR CS_ALICOLOR(1, OWN_DECK_ALIGNMENT:LOCAL % 10)
		PRINTFORM %(OWN_DECK_ALIGNMENT:LOCAL % 10) == 1 ? "L" # ((OWN_DECK_ALIGNMENT:LOCAL % 10) == 3 ? "C" # "N")%
		RESETCOLOR
		PRINTL 
		PRINTL [1]예　[2]다른 덱으로 한다
		INPUT
	ELSEIF LOCAL > -1
		PRINTFORML 이 덱으로는 도전할 수 없습니다.
		PRINTL 
		PRINTFORM 　　
		FONTSTYLE 8
		PRINTFORM %OWN_DECK_NAME:LOCAL,40,LEFT%
		PRINTFORM  {CS_DECK_COUNT(LOCAL)}
		FONTSTYLE 0
		SETCOLOR CS_ALICOLOR(0, OWN_DECK_ALIGNMENT:LOCAL / 10)
		PRINTFORM 　%OWN_DECK_ALIGNMENT:LOCAL / 10 == 1 ? "L" # (OWN_DECK_ALIGNMENT:LOCAL / 10 == 3 ? "D" # "N")%
		SETCOLOR CS_ALICOLOR(1, OWN_DECK_ALIGNMENT:LOCAL % 10)
		PRINTFORM %(OWN_DECK_ALIGNMENT:LOCAL % 10) == 1 ? "L" # ((OWN_DECK_ALIGNMENT:LOCAL % 10) == 3 ? "C" # "N")%
		RESETCOLOR
		PRINTL 
		PRINTFORML 다른 덱을 고르거나, 덱의 규정 매수에 맞게 덱을 편집해 주세요.
		PRINTFORMW (현재 덱 매수:{CS_DECK_COUNT(LOCAL)}　규정 덱 매수 {L_DECK_C:0}～{L_DECK_C:1})
		LOCAL = -1
	ENDIF
	IF RESULT == 2 || LOCAL < 0
		CLEARLINE LINECOUNT - L_LINE
		PRINTFORML 어느 덱으로 도전하시겠습니까? (덱 매수 {L_DECK_C:0}～{L_DECK_C:1})
		PRINTL 
		CALL CS_DECK_SELECT, , 1
		IF 0 <= RESULT && RESULT < 10
			LOCAL = RESULT
		ELSEIF RESULT == 99
			LOCAL = -1
		ENDIF
		IF LOCAL >= 0
			PRINTFORML {LOCAL}. %OWN_DECK_NAME:LOCAL% {CS_DECK_COUNT(LOCAL)}
			PRINTL [1]이 덱으로 도전한다　[2]이 덱을 편집한다
			INPUT
			IF RESULT == 2
				CALL CS_DECK_SETTING, LOCAL, L_DECK_C:0, L_DECK_C:1
				;, L_DECK_C:0, L_DECK_C:1
			ENDIF
		ENDIF
		CLEARLINE LINECOUNT - L_LINE
		GOTO INPUT_LOOP
	ENDIF
	SUMMONER_INFO:CS1_ONESELF:CSI2_DECK_NAME = %OWN_DECK_NAME:LOCAL%
	FOR LOCAL:1, 0, VARSIZE("OWN_CARDDECK", 1)
		SUMMONER_DECK:CS1_ONESELF:(LOCAL:1) = OWN_CARDDECK:LOCAL:(LOCAL:1)

		;出撃回数を加算
		SIF CS_TUTORIAL:0 == 0 && (LOCAL:1 < 1 || (OWN_CARDDECK:LOCAL:(LOCAL:1) != OWN_CARDDECK:LOCAL:(LOCAL:1 - 1)))
			CARD_MARCHING_COUNT:(OWN_CARDDECK:LOCAL:(LOCAL:1)) ++
	NEXT
	SUMMONER_PARAMETER:CS1_ONESELF:CSP2_ALIGNMENT = OWN_DECK_ALIGNMENT:LOCAL

	SIF ARG:1 == -1
		RETURN

	FOR LOCAL:1, 0, 1000
		SWAP SUMMONER_DECK:CS1_ONESELF:(RAND:DECK_CARDS(CS1_ONESELF)), SUMMONER_DECK:CS1_ONESELF:(RAND:DECK_CARDS(CS1_ONESELF))
		SWAP SUMMONER_DECK:CS1_OPPONENT:(RAND:DECK_CARDS(CS1_OPPONENT)), SUMMONER_DECK:CS1_OPPONENT:(RAND:DECK_CARDS(CS1_OPPONENT))
	NEXT
ELSE
	L_LINE = LINECOUNT
ENDIF
	
SUMMONER_PARAMETER:CS1_ONESELF:CSP2_MAX_HP = ARG:1
SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP = ARG:1
SIF CS_HP_FIXED:CS1_ONESELF > 0
	SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP = CS_HP_FIXED:CS1_ONESELF

SUMMONER_INFO:CS1_ONESELF:CSI2_NANE '= NAME:MASTER
SUMMONER_INFO:CS1_ONESELF:CSI2_IMAGE '= CBF_IMAGE_ID

SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_MAX_HP = ARG:2
SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP = ARG:2
SIF CS_HP_FIXED:CS1_OPPONENT > 0
	SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP = CS_HP_FIXED:CS1_OPPONENT


CLEARLINE LINECOUNT - L_LINE
L_LINE = LINECOUNT
IF CS_START_T_FIXED < 1
	FOR LOCAL:1, 0, 50

		PRINTL 　　룰렛
	PRINTFORML 　　%SUMMONER_INFO:CS1_OPPONENT:CSI2_NANE%
	PRINTFORML 　　%SUMMONER_INFO:CS1_OPPONENT:CSI2_DECK_NAME%
		IF LOCAL:1 % 4 == 0
			PRINTL 　　　　△　　
		ELSE
			PRINTL 　　　　　　　
		ENDIF
		PRINTL 　　　　　　　
		IF LOCAL:1 % 4 == 1
			PRINTL 　　　　　　＞
		ELSEIF LOCAL:1 % 4 == 3
			PRINTL 　　＜　　　　
		ELSE
			PRINTL 　　　　　　　
		ENDIF
		PRINTL 　　　　　　　
		IF LOCAL:1 % 4 == 2
			PRINTL 　　　　▽　　
		ELSE
			PRINTL 　　　　　　　
		ENDIF
	PRINTFORML 　　%SUMMONER_INFO:CS1_ONESELF:CSI2_NANE%
	PRINTFORML 　　%SUMMONER_INFO:CS1_ONESELF:CSI2_DECK_NAME%
		
		TWAIT 20, 0
		CLEARLINE LINECOUNT - L_LINE
	NEXT
ENDIF

CBF_P_TURN = RAND:2
SIF CS_START_T_FIXED > 0
	CBF_P_TURN = CS_START_T_FIXED % 2
PRINTFORML 　　　%(CBF_P_TURN == 1 ? "先攻" # "後攻")%
PRINTFORML 　　%SUMMONER_INFO:CS1_OPPONENT:CSI2_NANE%
PRINTFORML 　　%SUMMONER_INFO:CS1_OPPONENT:CSI2_DECK_NAME%
	IF CBF_P_TURN == 1
		PRINTL 　　　　△　　
	ELSE
		PRINTL 　　　　　　　
	ENDIF
	PRINTL 　　　　　　　
	PRINTL 　　　　　　　
	PRINTL 　　　　　　　
	IF CBF_P_TURN == 0
		PRINTL 　　　　▽　　
	ELSE
		PRINTL 　　　　　　　
	ENDIF
PRINTFORML 　　%SUMMONER_INFO:CS1_ONESELF:CSI2_NANE%
PRINTFORML 　　%SUMMONER_INFO:CS1_ONESELF:CSI2_DECK_NAME%
PRINTFORMW 　　　%(CBF_P_TURN == 0 ? "先攻" # "後攻")%
CLEARLINE LINECOUNT - L_LINE

IF CS_TUTORIAL:0 == 0
	VARSET SUMMONER_HAND_CARDS
	CBF_PHASE = 0
ELSE
	CBF_TURN = 1
	CBF_PHASE = 1
ENDIF


CALL CS_BATTLE
;2-完全勝利　1-判定勝ち　0-引き分け
;-3完全敗北　-2-判定敗北　-1-ギブアップ
LOCAL = RESULT
CALL CS_BATTLE_MESSAGE_VIEW, 210 + LOCAL
IF LOCAL > 0
	PRINTFORMW 당신의 승리！
	SIF イベントフラグ:34:0 >= 40 && CB_FIRLD_KIND == "フリーバトル"
		イベントフラグ:34:3 ++
ELSEIF LOCAL < 0
	PRINTFORMW 당신의 패배…
ELSEIF CS_TUTORIAL:0 == 0
	PRINTFORMW 무승부
ENDIF

SIF CB_FIRLD_KIND == "連続バトル"
	CS_HP_FIXED:CS1_ONESELF = SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP

CBF_TURN = 0
CBF_PHASE = 0
VARSET SUMMONER_PARAMETER
VARSET SUMMONER_INFO
VARSET SUMMONER_DECK
VARSET SUMMONER_HAND_CARDS
VARSET SUMMONER_STATE
VARSET FIELD_DEMON_DATE_V
VARSET FIELD_DEMON_DATE_S
VARSET FIELD_DEMON_STATE_V
VARSET FIELD_DEMON_STATE_S
VARSET CBF_NPC_COMMENT
VARSET CBF_NPC_ACE


SIF CS_TUTORIAL:0 == 0
	CALL CS_SSS

RETURN LOCAL

@CS_BATTLE
#DIM L_LINE
#DIM L_COUNT
#DIM L_COUNT_O
#DIM L_COUNT_D
#DIM L_INPUT
#DIM L_OFFERING
#DIM L_AI
#DIMS L_MESSAGE
#DIM L_OFFENSE_P
#DIM L_DEFENSE_P
#DIM L_OFFENSE_FD
#DIM L_DEFENSE_FD

#DIM L_RESULT

#DIM L_S_POSITION

;SP、アイテム使用用
#DIM L_SP_TARGET, 3


#DIM L_MAX_LINE = STRLENS(GETLINESTR("="))

#DIM L_COUNT_LOOP
CBF_START_LINE = LINECOUNT
L_LINE = LINECOUNT

$PHASE_CHANGE
IF SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP < 1
	CALL CARDBATTLE_MESSAGE, "배틀 종료！", 1, 1
	RETURN 2
ELSEIF SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP < 1
	CALL CARDBATTLE_MESSAGE, "배틀 종료！", 1, 1
	RETURN -3
ENDIF

SIF CS_TUTORIAL:0 > 0 && CS_TUTORIAL:1 == -1
	RETURN 0
IF CBF_PHASE == 0
	IF CS_TUTORIAL:0 >= 100
		CALL CS_DECKCARD_DRAW, CS1_ONESELF, 3
		CALL CS_DECKCARD_DRAW, CS1_OPPONENT, 3
	ELSE
		CALL CS_DECKCARD_DRAW, CS1_ONESELF, 6
		CALL CS_DECKCARD_DRAW, CS1_OPPONENT, 6
	ENDIF
	CBF_TURN = 0
ELSEIF CBF_PHASE == 1
	CALL CARDBATTLE_MESSAGE, @"{CBF_TURN,2}턴째 개시！%SUMMONER_INFO:CBF_P_TURN:CSI2_NANE% 턴"
	CALL CARDBATTLE_MESSAGE, @"프리페어 페이즈"
	L_OFFENSE_P = (CBF_P_TURN == 0 ? 0 # 1)
	L_DEFENSE_P = (CBF_P_TURN == 0 ? 1 # 0)
	L_OFFENSE_FD = (CBF_P_TURN == 0 ? 0 # 6)
	L_DEFENSE_FD = (CBF_P_TURN == 0 ? 6 # 0)
	
	CS_AI_ATTACK_S = 0
		;PRINTFORMW L_OFFENSE_P:{L_OFFENSE_P} L_DEFENSE_P:{L_DEFENSE_P}
	FOR L_COUNT, L_OFFENSE_FD, L_OFFENSE_FD + 6
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1
			CONTINUE
		CLEARBIT FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION, 0
		CLEARBIT FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION, 1
		CLEARBIT FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION, 3
		FIELD_DEMON_DATE_V:L_COUNT:CBV_MAG = MAG_SUPPLY(SUMMONER_PARAMETER:(FIELD_DEMON_DATE_V:L_COUNT:CBV_HOST):CSP2_ALIGNMENT, FIELD_DEMON_DATE_V:L_COUNT:CBV_KINDS, FIELD_DEMON_DATE_V:L_COUNT:CBV_FUSION)
		SIF STATE_INFO_GET_F(L_OFFENSE_FD, 103) > 0
			FIELD_DEMON_DATE_V:L_COUNT:CBV_MAG = 0
	NEXT

	;パッシヴスキル処理
	;ロストワード(SP封印処理)
	FOR L_COUNT, CBF_ALLY_POS1, CBF_ENEMY_POS6 + 1
		IF CB_HAVE_SP(L_COUNT, 1250) > 0
			CALL CGSP_ACTION_1250,"", L_COUNT, -1
			BREAK
		ENDIF
	NEXT


	FOR L_COUNT, L_OFFENSE_FD, L_OFFENSE_FD + 6
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1 || STATE_INFO_GET_F(L_COUNT,106) > 0
			CONTINUE
		
		TRYCCALLFORM CGSP_TIMING_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
			IF RESULT == 1 || RESULT == 3
				CALLFORM CGSP_ACTION_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT, -1
			ENDIF
		CATCH
		ENDCATCH
		
		TRYCCALLFORM CGSP_TIMING_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP2}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP2_SUB, L_COUNT
			IF RESULT == 1 || RESULT == 3
				CALLFORM CGSP_ACTION_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP2}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP2_SUB, L_COUNT, -1
			ENDIF
		CATCH
		ENDCATCH
		
	NEXT
	FOR L_COUNT, L_DEFENSE_FD, L_DEFENSE_FD + 6
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1 || STATE_INFO_GET_F(L_COUNT,106) > 0
			CONTINUE
		
		TRYCCALLFORM CGSP_TIMING_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
			IF RESULT == 2 || RESULT == 3
				CALLFORM CGSP_ACTION_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT, -1
			ENDIF
		CATCH
		ENDCATCH
		
		TRYCCALLFORM CGSP_TIMING_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP2}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP2_SUB, L_COUNT
			IF RESULT == 2 || RESULT == 3
				CALLFORM CGSP_ACTION_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP2}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP2_SUB, L_COUNT, -1
			ENDIF
		CATCH
		ENDCATCH
	NEXT
	
	;時間差ステイト処理
	FOR L_COUNT, L_OFFENSE_FD, L_OFFENSE_FD + 6
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1
			CONTINUE
		FOR LOCAL, 0, VARSIZE("FIELD_DEMON_STATE_V", 1)
			IF 1000 <= FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE < 2000
				IF FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_TIMING == 1 || FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_TIMING == 3
				{
					CALL CB_STATE_ADD, L_COUNT, FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE % 1000, FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_SUB1, 0, 
					FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_SUB2, 0, 0, 
					FIELD_DEMON_STATE_S:L_COUNT:LOCAL:CBS_SUB1, FIELD_DEMON_STATE_S:L_COUNT:LOCAL:CBS_SUB2, FIELD_DEMON_STATE_S:L_COUNT:LOCAL:CBS_SUB3
				}
				ENDIF
			ELSEIF 2000 <= FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE < 3000
				TRYCCALLFORM CGEX_STATE_TIMING_{FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE}, L_COUNT, LOCAL
					IF RESULT == 1 || RESULT == 3
						CALLFORM CGEX_STATE_ACTION_{FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE}, L_COUNT, LOCAL
					ENDIF
				CATCH
				ENDCATCH
			ENDIF
		NEXT
	NEXT
	FOR L_COUNT, L_DEFENSE_FD, L_DEFENSE_FD + 6
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1
			CONTINUE
		FOR LOCAL, 0, VARSIZE("FIELD_DEMON_STATE_V", 1)
			IF 1000 <= FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE < 2000
				IF FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_TIMING == 2 || FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_TIMING == 3
				{
					CALL CB_STATE_ADD, L_COUNT, FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE % 1000, FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_SUB1, 0, 
					FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_SUB2, 0, 0, 
					FIELD_DEMON_STATE_S:L_COUNT:LOCAL:CBS_SUB1, FIELD_DEMON_STATE_S:L_COUNT:LOCAL:CBS_SUB2, FIELD_DEMON_STATE_S:L_COUNT:LOCAL:CBS_SUB3
				}
				ENDIF
			ELSEIF 2000 <= FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE && FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE < 3000
				TRYCCALLFORM CGEX_STATE_TIMING_{FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE}, L_COUNT, LOCAL
					IF RESULT == 2 || RESULT == 3
						CALLFORM CGEX_STATE_ACTION_{FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE}, L_COUNT, LOCAL
					ENDIF
				CATCH
				ENDCATCH
			ENDIF
		NEXT
	NEXT

	LOCAL = 0
	FOR L_COUNT, L_OFFENSE_FD, L_OFFENSE_FD + 6
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1
			CONTINUE
		LOCAL += FIELD_DEMON_DATE_V:L_COUNT:CBV_MAG
	NEXT
	SUMMONER_PARAMETER:L_OFFENSE_P:CSP2_MAG = 0
	IF S_STATE_INFO_GET_F(L_OFFENSE_P, 201) > 0
		SUMMONER_PARAMETER:L_OFFENSE_P:CSP2_MAG = RESULT:CSS3_SUB1
		CALL CARDBATTLE_MESSAGE, SUMMONER_INFO:CBF_P_TURN:CSI2_NANE + @"(은)는 {RESULT:CSS3_SUB1}P의 MAG를 획득했다."
	ELSE
		IF SUMMONER_PARAMETER:L_OFFENSE_P:CSP2_MAG < 4 || SUMMONER_PARAMETER:L_OFFENSE_P:CSP2_MAG < LOCAL
			SUMMONER_PARAMETER:L_OFFENSE_P:CSP2_MAG = MAX(LOCAL, 4)
			
			CALL CARDBATTLE_MESSAGE, SUMMONER_INFO:CBF_P_TURN:CSI2_NANE + @"(은)는 {SUMMONER_PARAMETER:L_OFFENSE_P:CSP2_MAG}P의 MAG를 획득했다."
		ENDIF
		IF SUMMONER_PARAMETER:L_OFFENSE_P:CSP2_STOCK_MAG > 9
			LOCAL = SUMMONER_PARAMETER:L_OFFENSE_P:CSP2_STOCK_MAG / 10
			SUMMONER_PARAMETER:L_OFFENSE_P:CSP2_MAG += LOCAL
			CALL CARDBATTLE_MESSAGE, SUMMONER_INFO:CBF_P_TURN:CSI2_NANE + @"(은)는 스톡 MAG로부터 {LOCAL}P의 MAG를 획득했다."
		ENDIF
	ENDIF
	SUMMONER_PARAMETER:L_OFFENSE_P:CSP2_STOCK_MAG = 0

	CBF_PHASE = 2
	GOTO PHASE_CHANGE
ELSEIF CBF_PHASE == 2
	CALL CARDBATTLE_MESSAGE, @"드로우 페이즈"
	IF CBF_TURN > 1 && DECK_CARDS(L_OFFENSE_P) > 0
		;PRINTFORMW L_OFFENSE_P:{L_OFFENSE_P} L_DEFENSE_P:{L_DEFENSE_P}
		CALL CS_DECKCARD_DRAW, L_OFFENSE_P, 1
		SIF S_STATE_INFO_GET_F(L_OFFENSE_P, 6) > 0
			CALL CS_DECKCARD_DRAW, L_OFFENSE_P, 1
		CALL CARDBATTLE_MESSAGE, SUMMONER_INFO:L_OFFENSE_P:CSI2_NANE + @"(은)는 카드를 뽑았다."
	ENDIF
	CBF_PHASE = 3
	TRYCCALLFORM CS_DEBUG_TTT
		CALL CB_CPU_AI_SETTING, 2
	CATCH
	ENDCATCH
	GOTO PHASE_CHANGE
ELSEIF CBF_PHASE == 3
	CALL CARDBATTLE_MESSAGE, @"메인 페이즈"
	CALL CS_TUTORIAL_MESSAGE, 99 ;チュートリアル用
	SIF RESULT == -2
		RETURN 0
	CS_AI_STEP = 10
ELSEIF CBF_PHASE == 4
	CALL CARDBATTLE_MESSAGE, @"배틀 페이즈"
	LOCAL = 0
	FOR L_COUNT, L_OFFENSE_FD, L_OFFENSE_FD + 6
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE > 0
			LOCAL++
	NEXT
	LOCAL:1 = 0
	FOR L_COUNT, L_DEFENSE_FD, L_DEFENSE_FD + 6
		SIF CS_BLOCK_USE_CHECK(L_COUNT) > 0
			LOCAL:1 ++
	NEXT
	LOCAL:2 = 0
	LOCAL:3 = 0
	LOCAL:4 = 0
	LOCAL:5 = 0
	FOR L_COUNT_O, L_OFFENSE_FD, L_OFFENSE_FD + 6
		IF 10 < FIELD_DEMON_DATE_V:L_COUNT_O:CBV_BATTLE && FIELD_DEMON_DATE_V:L_COUNT_O:CBV_BATTLE < 20
			SETBIT LOCAL:2, FIELD_DEMON_DATE_V:L_COUNT_O:CBV_BATTLE % 10
			LOCAL:3 ++
			FOR L_COUNT_D, L_DEFENSE_FD, L_DEFENSE_FD + 6
				SIF CS_BLOCK_BATTLE_CHECK(L_COUNT_D, L_COUNT_O) > 0
					SETBIT LOCAL:4, L_COUNT_D
			NEXT
			FOR L_COUNT_D, L_DEFENSE_FD, L_DEFENSE_FD + 6
				SIF GETBIT(LOCAL:4, L_COUNT_D)
					LOCAL:5 ++
			NEXT
