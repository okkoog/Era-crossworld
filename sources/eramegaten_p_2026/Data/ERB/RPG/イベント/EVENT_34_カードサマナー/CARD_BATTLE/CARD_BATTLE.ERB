					FIELD_DEMON_STATE_S:L_COUNT:LOCAL:CBS_SUB1, FIELD_DEMON_STATE_S:L_COUNT:LOCAL:CBS_SUB2, FIELD_DEMON_STATE_S:L_COUNT:LOCAL:CBS_SUB3
				}
				ENDIF
