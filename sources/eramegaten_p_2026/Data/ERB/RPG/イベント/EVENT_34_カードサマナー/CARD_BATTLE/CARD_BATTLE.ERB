	NEXT
	
	FOR L_COUNT, 0, VARSIZE("FIELD_DEMON_STATE_V", 0)
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1
			CONTINUE
		FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE = 0
		
		;飛行、先制、APHP初期化
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_FLYING > 0 && FIELD_DEMON_DATE_V:L_COUNT:CBV_FLYING < 90
			FIELD_DEMON_DATE_V:L_COUNT:CBV_FLYING--
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_FLYING < 0
			FIELD_DEMON_DATE_V:L_COUNT:CBV_FLYING++
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_FLYING == 0
			FIELD_DEMON_DATE_V:L_COUNT:CBV_FLYING = (FIELD_DEMON_DATE_V:L_COUNT:CBV_FLIGHT ? 99 # 0)
		
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_SPEED > 0
			FIELD_DEMON_DATE_V:L_COUNT:CBV_SPEED--
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_SPEED < 0
			FIELD_DEMON_DATE_V:L_COUNT:CBV_SPEED++
		
		FIELD_DEMON_DATE_V:L_COUNT:CBV_AP = FIELD_DEMON_DATE_V:L_COUNT:CBV_B_AP
		
		SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_HP > FIELD_DEMON_DATE_V:L_COUNT:CBV_B_HP || STATE_INFO_GET_F(L_COUNT, 105) < 1
			FIELD_DEMON_DATE_V:L_COUNT:CBV_HP = FIELD_DEMON_DATE_V:L_COUNT:CBV_B_HP
		
		;状態T-1
		FOR LOCAL, VARSIZE("FIELD_DEMON_STATE_V", 1) - 1, -1, -1
			IF FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_STATE > 0
				FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_TURN -= 1
				SIF FIELD_DEMON_STATE_V:L_COUNT:LOCAL:CBV_TURN < 1
					CALL CB_STATE_DELETE, L_COUNT, LOCAL
			ENDIF
		NEXT
		
	NEXT
	FOR L_COUNT, 0, VARSIZE("SUMMONER_STATE", 0)
	
		;サマナーの状態T-1
		FOR LOCAL, VARSIZE("SUMMONER_STATE", 1) - 1, -1, -1
			IF SUMMONER_STATE:L_COUNT:LOCAL:CSS3_STATE > 0
				SUMMONER_STATE:L_COUNT:LOCAL:CSS3_TURN -= 1
				SIF SUMMONER_STATE:L_COUNT:LOCAL:CSS3_TURN < 1
					CALL CB_S_STATE_DELETE, L_COUNT, LOCAL
			ENDIF
		NEXT
		
	NEXT
	;SUMMONER_PARAMETER:L_OFFENSE_P:CSP2_MAG = 0
	
	CBF_P_TURN = (CBF_P_TURN == 0 ? 1 # 0)
	
	CBF_TURN++
	CBF_PHASE = 1
	GOTO PHASE_CHANGE
ENDIF

