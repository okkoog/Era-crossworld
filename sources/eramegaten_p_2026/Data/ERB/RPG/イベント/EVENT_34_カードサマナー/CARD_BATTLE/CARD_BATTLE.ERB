							GOTO INPUT_LOOP
						ELSE
							L_OFFERING = RESULT
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			TRYCCALLFORM CGSP_TARGET_{LOCAL:2}, LOCALS, LOCAL
				IF RESULT == 0
					IF LOCAL:5 == 0
						IF L_INPUT == 3001
							PRINTFORML ●%LOCALS:1%
							PRINTFORML 
							CALLFORM CGSP_EXPLAIN_{LOCAL:2}, LOCALS, LOCAL
							PRINTFORML □%RESULTS%
						ELSEIF L_INPUT == 3010
							CALL CARD_DATA_GET(LOCAL:2)
							PRINTFORML ●%CARD_DATE_S:CBS_NAME%
							PRINTFORML 
							PRINTFORML □%CARD_DATE_S:CBS_COMMENTARY%
						ENDIF
						PRINTFORML 이 SP를 사용하시겠습니까?
						PRINTFORML [4001]예　[4000]아니오
						INPUT
					ENDIF
					SIF CS_DEBUG == 0
						REDRAW 0
					CLEARLINE LINECOUNT - L_LINE
					IF RESULT == 4001 || LOCAL:5 == 1
						CALL CARDBATTLE_MESSAGE, LOCALS:2
						IF L_INPUT == 3010 || (1600 <= L_INPUT && L_INPUT < 2000)
							FOR L_COUNT, HAND_CARDS(L_OFFENSE_P) - 1, -1, -1
								SIF GETBIT(LOCAL:6, L_COUNT)
									CALL CS_HANDCARD_DEL, L_OFFENSE_P, L_COUNT
							NEXT
						ENDIF
						CALLFORM CGSP_ACTION_{LOCAL:2}, LOCALS, LOCAL, -1
						LOCAL:1 = 1
					ENDIF
				ELSE
					IF L_INPUT == 3001
						L_MESSAGE = %LOCALS:1%을(를) 누구에게 사용하시겠습니까?
					ELSEIF L_INPUT == 3010
						L_MESSAGE = %CARD_DATE_S:CBS_NAME%을(를) 누구에게 사용하시겠습니까?
					ENDIF
					RESULT:1 = 0
					RESULT:2 = 0
					CALLFORM CGSP_TARGET_{LOCAL:2}, LOCALS, LOCAL
					;PRINTFORMW {RESULT}
					L_SP_TARGET:0 = RESULT:0
					L_SP_TARGET:1 = RESULT:1
					L_SP_TARGET:2 = RESULT:2

					CALL CS_TARGET_SET, RESULT, LOCAL, LOCAL:2, LOCALS
					SIF CS_DEBUG == 0
						REDRAW 0
					CLEARLINE LINECOUNT - L_LINE
					IF RESULT != 0
						FOR L_COUNT, 0, HAND_CARDS(L_OFFENSE_P)
							SIF GETBIT(L_OFFERING, L_COUNT)
								CALL CS_OFFERING_CARD_SET, SUMMONER_HAND_CARDS:L_OFFENSE_P:L_COUNT
						NEXT
						LOCAL:6 |= L_OFFERING
						IF L_SP_TARGET:1 > 0
							CALL CARDBATTLE_SELECT_F2, L_SP_TARGET:1, L_SP_TARGET:2, L_MESSAGE
							LOCAL:5 = RESULT
							IF LOCAL:5 != 0
								CALL CARDBATTLE_MESSAGE, LOCALS:2
								IF L_INPUT == 3010 || (1600 <= L_INPUT && L_INPUT < 2000)
									FOR L_COUNT, HAND_CARDS(L_OFFENSE_P) - 1, -1, -1
										SIF GETBIT(LOCAL:6, L_COUNT)
											CALL CS_HANDCARD_DEL, L_OFFENSE_P, L_COUNT
									NEXT
								ENDIF
								CALLFORM CGSP_ACTION_{LOCAL:2}, LOCALS, LOCAL, LOCAL:5
								LOCAL:1 = 1
							ENDIF
						ELSE
							CALL CARDBATTLE_SELECT_F1, L_MESSAGE
							LOCAL:5 = RESULT
							IF 1000 <= LOCAL:5 && LOCAL:5 < 2000
								CALL CARDBATTLE_MESSAGE, LOCALS:2
								IF L_INPUT == 3010 || (1600 <= L_INPUT && L_INPUT < 2000)
									FOR L_COUNT, HAND_CARDS(L_OFFENSE_P) - 1, -1, -1
										SIF GETBIT(LOCAL:6, L_COUNT)
											CALL CS_HANDCARD_DEL, L_OFFENSE_P, L_COUNT
									NEXT
								ENDIF
								CALLFORM CGSP_ACTION_{LOCAL:2}, LOCALS, LOCAL, LOCAL:5 - 1000
								LOCAL:1 = 1
							ELSEIF 0 <= LOCAL:5 && LOCAL:5 < 2
								CALL CARDBATTLE_MESSAGE, LOCALS:2
								IF L_INPUT == 3010 || (1600 <= L_INPUT && L_INPUT < 2000)
									FOR L_COUNT, HAND_CARDS(L_OFFENSE_P) - 1, -1, -1
										SIF GETBIT(LOCAL:6, L_COUNT)
											CALL CS_HANDCARD_DEL, L_OFFENSE_P, L_COUNT
									NEXT
								ENDIF
								CALLFORM CGSP_ACTION_{LOCAL:2}, LOCALS, LOCAL, LOCAL:5 + 100
								LOCAL:1 = 1
							ENDIF
						ENDIF
						VARSET OFFERING_CARD_DATE_V
						VARSET OFFERING_CARD_DATE_S
					ELSE
						CALL CARDBATTLE_MESSAGE, "타겟이 존재하지 않는다！", 1
					ENDIF
				ENDIF
				IF LOCAL:1 > 0
					IF LOCAL == 100 + CS1_ONESELF && CS_TUTORIAL:0 == 0
						CARD_USING_COUNT:(SUMMONER_HAND_CARDS:CS1_ONESELF:(LOCAL:4)) ++
					ENDIF
					IF LOCAL <= CBF_ALLY_POS6 && CS_TUTORIAL:0 == 0
						CARD_SP_USING_COUNT:(FIELD_DEMON_DATE_V:LOCAL:CBV_NO) ++
					ENDIF
					SUMMONER_PARAMETER:L_OFFENSE_P:CSP2_MAG -= LOCAL:3
					IF L_INPUT == 3001 || (1500 <= L_INPUT && L_INPUT < 1600)
						SETBIT FIELD_DEMON_DATE_V:LOCAL:CBV_CONDITION, 1
						CALLFORM CGSP_ACTION_AFTER_{LOCAL:2}, LOCALS, LOCAL
						IF RESULT == 1
							CALL CB_STATE_ADD, LOCAL, 999, 1
						ELSEIF RESULT == 2
							CALL CB_STATE_ADD, LOCAL, 997, 1
						ELSEIF RESULT == 3
							CALL CS_DEMON_DEATH, LOCAL,,0
							;CALL CB_STATE_ADD, LOCAL, 998, 1
						ENDIF
						IF FIELD_DEMON_DATE_V:LOCAL:CBV_NO > 0
							IF STATE_INFO_GET_F(LOCAL, 109) > 0
								CALL CB_STATE_ADD, LOCAL, 998, 1
							ELSEIF STATE_INFO_GET_F(LOCAL, 108) > 0
								CALL CB_STATE_ADD, LOCAL, 997, 1
							ELSEIF STATE_INFO_GET_F(LOCAL, 107) > 0
								CALL CB_STATE_ADD, LOCAL, 999, 1
							ENDIF
						ENDIF
						;自身のＳＰで基礎ＨＰが無くなるとストックMAGを作らずに黄泉へ
						SIF FIELD_DEMON_DATE_V:LOCAL:CBV_B_HP < 1 && FIELD_DEMON_DATE_V:LOCAL:CBV_NO != 0
							CALL CS_DEMON_DEATH, LOCAL,,0

					ELSEIF L_INPUT == 3010 || (1600 <= L_INPUT && L_INPUT < 2000)
						SIF S_STATE_INFO_GET_F(L_OFFENSE_P, 103) == 103
							CALL CS_SUMMONER_DAMAGE, L_OFFENSE_P, RESULT:2, -1, 99
						;CALL CS_HANDCARD_DEL, L_OFFENSE_P, LOCAL:4
					ENDIF
				ENDIF
			CATCH
			ENDCATCH
		ELSE
			CALL CARDBATTLE_MESSAGE, "MAG가 부족하다！", 1
		ENDIF
	ENDIF
{
ELSEIF CBF_PHASE == 3
 && ((L_INPUT == 3000 && 2000 <= CBF_SELECT && CBF_SELECT < 3000 && L_AI == 0) || (2500 <= L_INPUT && L_INPUT < 3000 && L_AI == 1))
 && S_STATE_INFO_GET_F(L_OFFENSE_P, 106) <= 0
}
	IF L_AI == 0
		CALL CS_TUTORIAL_MESSAGE, 3 ;チュートリアル用
		SIF CS_TUTORIAL:0 > 0 && RESULT == -1
			GOTO INPUT_LOOP
		CALL CARD_DATA_GET(SUMMONER_HAND_CARDS:CS1_ONESELF:(CBF_SELECT - 2000))
	ELSE
		CALL CARD_DATA_GET(SUMMONER_HAND_CARDS:CS1_OPPONENT:(L_INPUT - 2500))
	ENDIF
	SIF CS_DEBUG == 0
		REDRAW 0
	CLEARLINE LINECOUNT - L_LINE
	IF CARD_DATE_V:CBV_KINDS < 100
		IF L_AI == 0
			CALL CS_HANDCARD_SUMMON, L_OFFENSE_P, CBF_SELECT - 2000
		ELSE
			CALL CS_HANDCARD_SUMMON, L_OFFENSE_P, L_INPUT - 2500
		ENDIF
	ENDIF
ELSEIF CBF_PHASE == 4 && ((L_INPUT == 3100 && 1000 <= CBF_SELECT && CBF_SELECT < 2000 && L_AI == 0) || (3600 <= L_INPUT && L_INPUT < 3700 && L_AI == 1))
	SIF CS_DEBUG == 0
		REDRAW 0
	CLEARLINE LINECOUNT - L_LINE
	IF L_AI == 0
		CALL CS_TUTORIAL_MESSAGE, 4 ;チュートリアル用
		SIF CS_TUTORIAL:0 > 0 && RESULT == -1
			GOTO INPUT_LOOP
		LOCAL:10 = CBF_SELECT - 1000
	ELSE
		LOCAL:10 = L_INPUT - 3600
	ENDIF
	IF FIELD_DEMON_DATE_V:(LOCAL:10):CBV_HOST != CBF_P_TURN && FIELD_DEMON_DATE_V:(LOCAL:10):CBV_BATTLE > 0
		SIF CS_DEBUG == 0
			REDRAW 0
		CLEARLINE LINECOUNT - L_LINE
		FIELD_DEMON_DATE_V:(LOCAL:10):CBV_BATTLE = 0
	ELSEIF FIELD_DEMON_DATE_V:(LOCAL:10):CBV_BATTLE > 0
		L_MESSAGE = %FIELD_DEMON_DATE_S:(LOCAL:10):CBS_NAME%을(를) 누구로 블록하시겠습니까?
		LOCAL:11 = FIELD_DEMON_DATE_V:(LOCAL:10):CBV_BATTLE % 10
		CBF_SELECT_BIT = 0
		FOR L_COUNT, L_DEFENSE_FD, L_DEFENSE_FD + 6
			SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1
				CONTINUE
			SIF CS_BLOCK_BATTLE_CHECK(L_COUNT, LOCAL:10)
				SETBIT CBF_SELECT_BIT, L_COUNT
		NEXT
		CALL CARDBATTLE_SELECT_F1, L_MESSAGE
		LOCAL:12 = RESULT
		IF 1000 <= LOCAL:12 && LOCAL:12 < 2000
			FOR L_COUNT, L_DEFENSE_FD, L_DEFENSE_FD + 6
				SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE % 10 == LOCAL:11 + 3
					FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE = 0
			NEXT
			FIELD_DEMON_DATE_V:(LOCAL:12 - 1000):CBV_BATTLE = LOCAL:11 + 3
		ENDIF
	ENDIF
ELSEIF CBF_PHASE == 3 && L_INPUT == 4000
	CALL CS_TUTORIAL_MESSAGE, 5 ;チュートリアル用
	SIF CS_TUTORIAL:0 > 0 && RESULT == -1
		GOTO INPUT_LOOP
	IF L_AI == 0
		PRINTFORML 메인 페이즈를 종료하시겠습니까?
		PRINTFORML [0]네　[1]아니오
		INPUT
	ENDIF
	SIF CS_DEBUG == 0
		REDRAW 0
	CLEARLINE LINECOUNT - L_LINE
	IF RESULT == 0 || L_AI == 1
		CBF_PHASE = 4
		GOTO PHASE_CHANGE
	ENDIF
ELSEIF CBF_PHASE == 4 && L_INPUT == 4000
	CALL CS_TUTORIAL_MESSAGE, 6 ;チュートリアル用
	SIF CS_TUTORIAL:0 > 0 && RESULT == -1
		GOTO INPUT_LOOP
	LOCAL:10 = 0
	;PRINTFORMW {LOCAL:2} {LOCAL:3} {LOCAL:4} {LOCAL:5}
	FOR L_COUNT_D, L_DEFENSE_FD, L_DEFENSE_FD + 6
		SIF FIELD_DEMON_DATE_V:L_COUNT_D:CBV_BATTLE > 0 && GETBIT(LOCAL:2, FIELD_DEMON_DATE_V:L_COUNT_D:CBV_BATTLE % 10 - 3)
			LOCAL:10 ++
	NEXT
	IF LOCAL:10 < MIN(LOCAL:3, LOCAL:5)
		CALL CARDBATTLE_MESSAGE, "블록해야 하는 적이 있습니다.", 1
		GOTO INPUT_LOOP
	ENDIF
	IF L_AI == 0
		PRINTFORML 배틀로 이행하시겠습니까?
		PRINTFORML [0]네　[1]아니오
		INPUT
	ENDIF
	SIF CS_TUTORIAL:0 > 0 && CS_TUTORIAL:1 == -1
		RETURN 0
	SIF CS_DEBUG == 0
		REDRAW 0
	CLEARLINE LINECOUNT - L_LINE
	IF RESULT == 0 || L_AI == 1
		CALL CARDBATTLE_MESSAGE, @"배틀 개시！"
		
		LOCAL:1 = -1
		LOCAL:2 = -1
		LOCAL:3 = -1
		LOCAL:4 = -1
		LOCAL:5 = -1
		LOCAL:6 = -1
		
		FOR L_COUNT, 0, 12
			{
			SIF 0 < FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE % 10 && 
				FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE % 10 < 7
			}
				LOCAL:(FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE % 10) = L_COUNT
		NEXT
		FOR L_COUNT, 0, 3
			LOCAL:10 = LOCAL:(L_COUNT + 1)
			LOCAL:11 = LOCAL:(L_COUNT + 4)
			CALL CS_ATTACK_ACTION, LOCAL:10, LOCAL:11
		NEXT
		CBF_PHASE = 5
		GOTO PHASE_CHANGE
	ENDIF
ELSEIF (CBF_PHASE == 3 || CBF_PHASE == 4) && L_INPUT == 4001
	FOR LOCAL, 0, VARSIZE("CBF_LOG", 0)
		CALL SET_PICTURE, , , "消去"
		SIF CBF_LOG:LOCAL != ""
			CALL SET_PICTURE , CBF_LOG:LOCAL , 0 , , 0
		;PRINTFORML %CBF_LOG:LOCAL%
		CALL SET_PICTURE, , 0, "HTML表示", 1
	NEXT
	WAIT
	SIF CS_DEBUG == 0
		REDRAW 0
	CLEARLINE LINECOUNT - L_LINE
ELSEIF (CBF_PHASE == 3 || CBF_PHASE == 4) && L_INPUT == 4002
	CALL CS_TUTORIAL_MESSAGE, 7 ;チュートリアル用
	SIF CS_TUTORIAL:0 > 0 && RESULT == -1
		GOTO INPUT_LOOP
	PRINTFORML 기브업하시겠습니까?
	PRINTFORML [0]네　[1]아니오
	INPUT
	IF RESULT == 0
		RETURN -1
	ENDIF
	SIF CS_DEBUG == 0
		REDRAW 0
	CLEARLINE LINECOUNT - L_LINE
ELSEIF CBF_PHASE == 4 && L_INPUT == 6010 && 1000 <= CBF_SELECT && CBF_SELECT < 2000 && CS_DEBUG > 0
	L_S_POSITION = CBF_SELECT - 1000
	IF FIELD_DEMON_DATE_V:L_S_POSITION:CBV_NO != 0
	ELSEIF FIELD_DEMON_DATE_V:L_S_POSITION:CBV_NO == 0
		PRINTL 소환할 카드 번호를 입력해 주세요.
		INPUT
		L_RESULT = RESULT
		CALL CARD_DATA_GET(L_RESULT)
		IF CARD_DATE_V:CBV_NO != 0 && CARD_DATE_V:CBV_KINDS < 100
			CALL CS_DEMON_SUMMON_FIELD, L_S_POSITION, L_RESULT
		ENDIF

	ENDIF

ELSEIF (CBF_PHASE == 3 || CBF_PHASE == 4)
	SIF CS_DEBUG == 0
		REDRAW 0
	CLEARLINE LINECOUNT - L_LINE
ENDIF
CALL CS_TUTORIAL_MESSAGE, 8 ;チュートリアル用
SIF RESULT == -2
	RETURN 0
	
SIF CS_TUTORIAL:0 > 0 && RESULT == -1
	GOTO INPUT_LOOP
IF SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP < 1
	CALL CARDBATTLE_MESSAGE, "배틀 종료！", 1, 1
	RETURN 2
ELSEIF SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP < 1
	CALL CARDBATTLE_MESSAGE, "배틀 종료！", 1, 1
	RETURN -3
ENDIF


GOTO INPUT_LOOP






