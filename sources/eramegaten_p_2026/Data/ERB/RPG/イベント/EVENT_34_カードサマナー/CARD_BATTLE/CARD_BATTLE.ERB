;相手にBLOCKが使えるかどうか
;0	ブロックする人
;1	攻撃者
;2	ブロックする人の飛行状況
;3	攻撃者の飛行状況
;4	状態の使用(ビット)
@CS_BLOCK_BATTLE_CHECK, ARG, ARG:1, ARG:2 = -99, ARG:3 = -99, ARG:4 = 3
#FUNCTION
#DIM L_FAZE
#DIM L_TIME

{
IF (FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_OPPONENT && (CBF_P_TURN != FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE == 4))
|| (FIELD_DEMON_DATE_V:ARG:CBV_HOST == CS1_ONESELF  && (CBF_P_TURN == FIELD_DEMON_DATE_V:ARG:CBV_HOST && CBF_PHASE != 4))
}
	L_FAZE = 3
	SIF CBF_PHASE >= 4
		L_FAZE = 6
	L_TIME = 0
ELSE
	L_FAZE = 0
	L_TIME = 1
ENDIF
SIF ARG:2 == -99
	ARG:2 = FIELD_DEMON_DATE_V:ARG:CBV_FLYING - L_TIME
SIF ARG:3 == -99
	ARG:3 = FIELD_DEMON_DATE_V:(ARG:1):CBV_FLYING - L_TIME

SIF FIELD_DEMON_DATE_V:ARG:CBV_NO < 1
	RETURNF 0
SIF FIELD_DEMON_DATE_V:(ARG:1):CBV_NO < 1
	RETURNF 0
;タップ状態
SIF GETBIT(FIELD_DEMON_DATE_V:ARG:CBV_CONDITION, 0)
	RETURNF 0
;敵のターンに召喚酔い(ブロック側)
SIF GETBIT(FIELD_DEMON_DATE_V:ARG:CBV_CONDITION, 2) && FIELD_DEMON_DATE_V:ARG:CBV_HOST != CBF_P_TURN
	RETURNF 0
;ﾌﾞﾛｯｸ側がﾌﾞﾛｯｸ不可
SIF STATE_INFO_GET_F(ARG, 102) > 0 && RESULT:1 > L_TIME && GETBIT(ARG:4, 0)
	RETURNF 0
;アタック側がﾌﾞﾛｯｸ貫通状態
SIF STATE_INFO_GET_F(ARG:1, 9) > 0 && RESULT:1 > L_TIME && GETBIT(ARG:4, 1)
	RETURNF 0
;ﾌﾞﾛｯｸ側が制空又は飛行
SIF (STATE_INFO_GET_F(ARG, 7) && RESULT:1 > L_TIME && GETBIT(ARG:4, 0)) || (CB_ANTI_AIR_F(ARG) > 0 && L_TIME > 0) || ARG:2 > 0
	RETURNF 1
;アタック側がアタック不可
SIF STATE_INFO_GET_F(ARG:1, 101) > 0 && RESULT:1 > L_TIME && GETBIT(ARG:4, 1)
	RETURNF 0
;アタック側が歩行
SIF ARG:3 < 1
	RETURNF 1
RETURNF 0

;SPが使えるかどうか
@CS_SP_USE_CHECK, ARG, L_TIME = 0
#FUNCTION
#DIM L_TIME
SIF FIELD_DEMON_DATE_V:ARG:CBV_NO < 1
	RETURNF 0
SIF GETBIT(FIELD_DEMON_DATE_V:ARG:CBV_CONDITION, 0)
	RETURNF 0
SIF GETBIT(FIELD_DEMON_DATE_V:ARG:CBV_CONDITION, 1)
	RETURNF 0
SIF GETBIT(FIELD_DEMON_DATE_V:ARG:CBV_CONDITION, 2)
	RETURNF 0
;SIF FIELD_DEMON_DATE_V:ARG:CBV_BATTLE > 1
;	RETURNF 0
SIF FIELD_DEMON_DATE_V:ARG:CBV_SP1 < 1
	RETURNF 0
SIF STATE_INFO_GET_F(ARG, 106) > 0 && RESULT:1 > L_TIME
	RETURNF 0
RETURNF 1

@CS_SP_USE_CHECK_FULL, ARG, L_TIME = 0
#DIM L_TIME
TRYCCALLFORM CGSP_TIMING_{FIELD_DEMON_DATE_V:ARG:CBV_SP1}, FIELD_DEMON_DATE_S:ARG:CBS_SP1_SUB, ARG
	SIF RESULT == 0 && CS_SP_USE_CHECK(ARG, L_TIME)
		RETURN 1
CATCH
ENDCATCH
RETURN 0
	
;ターゲットのセット
;ARG　0-ターゲットの種類　1-スキル使う人(0~11 仲魔　100.101 서머너)　
;ターゲットの種類	
;0-無し　　　1-味方1体　2-味方1体(自身含む)　3-敵1体　4-敵1体(サマナー含む)
;5-敵味方1体　6-サマナーどちらか　7-敵味方１体(サマナー含む)　8-敵味方１体(サマナー含む、自分含まず)

@CS_TARGET_SET, ARG, ARG:1 = -1, L_SP, L_SP_SUB
#DIM L_COUNT
#DIM L_SP
#DIMS L_SP_SUB
#DIM L_T_HOST
CBF_SELECT_BIT = 0

IF 0 <= ARG:1 && ARG:1 < 12 && 0 < ARG && ARG <= 5
	L_T_HOST = FIELD_DEMON_DATE_V:(ARG:1):CBV_HOST
ELSEIF 100 <= ARG:1 && ARG:1 < 102 && 0 < ARG && ARG <= 5
	L_T_HOST = ARG:1 % 20
ELSEIF ARG <= 7
	L_T_HOST = -1
ELSE
	RETURN 0
ENDIF

SIF (ARG == 3 || ARG == 4) && (L_T_HOST == 1 || L_T_HOST == 0)
	L_T_HOST = (L_T_HOST == 0 ? 1 # 0)
;PRINTFORMW {L_T_HOST}

IF (0 < ARG && ARG <= 5) || ARG == 7 || ARG == 8
	FOR L_COUNT, 0, 12
		IF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO > 0 && (FIELD_DEMON_DATE_V:L_COUNT:CBV_HOST == L_T_HOST || L_T_HOST == -1)
			TRYCCALLFORM CGSP_TARGET_TERMS_{L_SP}, L_SP_SUB, ARG:1 ,L_COUNT
				SIF RESULT
					SETBIT CBF_SELECT_BIT, L_COUNT
			CATCH
				SETBIT CBF_SELECT_BIT, L_COUNT
			ENDCATCH
		ENDIF
		;PRINTFORMW {FIELD_DEMON_DATE_V:L_COUNT:CBV_HOST}
	NEXT
	IF ARG == 7 || ARG == 8
		SETBIT CBF_SELECT_BIT, 20
		SETBIT CBF_SELECT_BIT, 21
	ENDIF

	SIF (ARG == 1 || ARG == 8) && ARG:1 < 20
		CLEARBIT CBF_SELECT_BIT, ARG:1
	SIF (ARG == 1 || ARG == 8) && ARG:1 >= 20
		CLEARBIT CBF_SELECT_BIT, 20 + (ARG:1 % 20)

	SIF ARG == 4
		SETBIT CBF_SELECT_BIT, 20 + L_T_HOST
ELSEIF ARG == 6
	SETBIT CBF_SELECT_BIT, 20
	SETBIT CBF_SELECT_BIT, 21
ENDIF
RETURN CBF_SELECT_BIT

;ARG		仲魔ポジション
;ARG:1		スキル場（1.2）
@CSF_SKILLNAME_GET, ARG, ARG:1 = -1
#DIM L_COUNT
#DIM L_SKILL
#DIMS L_SUB
#DIMS L_NAME_C
RESULTS =
IF ARG:1 == 1
	L_SKILL	 = FIELD_DEMON_DATE_V:ARG:CBV_SP1
	L_SUB	 '= FIELD_DEMON_DATE_S:ARG:CBS_SP1_SUB
	L_NAME_C '= FIELD_DEMON_DATE_S:ARG:CBS_SP1_NAME_CHANGE
ELSEIF ARG:1 == 2
	L_SKILL	 = FIELD_DEMON_DATE_V:ARG:CBV_SP2
	L_SUB	 '= FIELD_DEMON_DATE_S:ARG:CBS_SP2_SUB
	L_NAME_C '= FIELD_DEMON_DATE_S:ARG:CBS_SP2_NAME_CHANGE
ELSE
	RETURN 0
ENDIF
SIF L_SKILL < 1
	RETURN 0

TRYCCALLFORM CGSP_NAME_{L_SKILL}, L_SUB, ARG
	IF L_NAME_C != ""
		RESULTS '= L_NAME_C
	ENDIF
	RETURN 1
CATCH
	RETURN 0
ENDCATCH

;カードバトル中のメッセージ表示
@CS_BATTLE_MESSAGE_VIEW, ARG
#DIM L_MASS
#DIMS L_PICTURE
L_MASS = -1
IF ARG == 99 && CBF_TURN == 1
	L_MASS = 0
ELSEIF  ARG == 99 && CBF_P_TURN == 1
	IF SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP > SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP
		IF SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP > 3
			L_MASS = 1
		ELSE
			L_MASS = 2
		ENDIF
	ELSEIF SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP < SUMMONER_PARAMETER:CS1_ONESELF:CSP2_HP
		IF SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_HP > 3
			L_MASS = 3
		ELSE
			L_MASS = 4
		ENDIF
	ELSE
		L_MASS = 9
	ENDIF
ELSEIF ARG == 100 && CBF_P_TURN == 1
	L_MASS = 5
ELSEIF 200 < ARG && ARG < 220
	IF ARG < 210
		L_MASS = 6
	ELSEIF ARG > 210
		L_MASS = 7
	ELSE
		L_MASS = 8
	ENDIF
ELSEIF 1000 < ARG && ARG < 2000 && CBF_P_TURN == 1
	IF MATCH(CBF_NPC_ACE, ARG - 1000) > 0
		L_MASS = 10
	ENDIF
ENDIF
IF L_MASS >= 0 && CBF_NPC_COMMENT:L_MASS:0 != ""

	L_PICTURE = %CBF_NPC_COMMENT:L_MASS:1 != "" ? CBF_NPC_COMMENT:L_MASS:1 # SUMMONER_INFO:CS1_OPPONENT:CSI2_IMAGE%
	CALL CS_BATTLE_MESSAGE_WINDOW_ICON, IMAGE_LINE_COUNT(L_PICTURE) * 2, L_PICTURE, , SUMMONER_INFO:CS1_OPPONENT:CSI2_NANE, CBF_NPC_COMMENT:L_MASS:0
ENDIF
