			SETBIT CBF_SELECT_BIT, L_COUNT
		NEXT
		SIF CS_AI_ACTION:0 == 0 && CBF_P_TURN == 1
			CALL CB_CPU_AI_SET()
		;PRINTFORMW {CS_AI_ACTION:0}
		CALL CARDBATTLE_SELECT_H1, "버릴 패를 선택해 주세요."
