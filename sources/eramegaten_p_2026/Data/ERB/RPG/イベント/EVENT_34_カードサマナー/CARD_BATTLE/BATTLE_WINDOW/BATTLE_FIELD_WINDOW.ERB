				CALL SET_PICTURE , @"[召喚],{L_COLOR},,3000" , ARG:1 + 2 , , ARG:2 + 6 * LOCAL
		ELSE
			CALL SET_PICTURE , @"┃ITEM,{L_COLOR},,{2000 + LOCAL}" , ARG:1 + 1 , , ARG:2 + 6 * LOCAL
			IF CBF_TURN > 0 && CBF_PHASE == 3 && CBF_SELECT == LOCAL + 2000 && CARD_DATE_V:CBV_SP1 > 0
				TRYCCALLFORM CGSP_SPECIAL_ACTIONABLE_{CARD_DATE_V:CBV_SP1}, CARD_DATE_S:CBS_SP1_SUB ,20
