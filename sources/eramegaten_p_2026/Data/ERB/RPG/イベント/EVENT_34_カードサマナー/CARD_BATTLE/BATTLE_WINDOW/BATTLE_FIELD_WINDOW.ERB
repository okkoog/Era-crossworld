		ELSE
			CALL SET_PICTURE , @"┃ITEM,{L_SELECT_COLOR},,{2000 + LOCAL}" , ARG:1 + 1 , , ARG:2 + 6 * LOCAL
		ENDIF
		IF CBF_SELECT_MODE == 11 && CBF_SELECT == LOCAL + 2000 && GETBIT(CBF_SELECT_BIT, LOCAL)
			CALL SET_PICTURE , @"[選択],{L_SELECT_COLOR},,4100" , ARG:1 + 2 , , ARG:2 + 6 * LOCAL
		ELSEIF CBF_SELECT_MODE == 12 && GETBIT(CBF_SELECT_BIT, LOCAL)
			CALL SET_PICTURE , (GETBIT(CBF_SELECTING_BIT, LOCAL) ? "[해제]" # "[選択]") + @",{L_SELECT_COLOR},,{LOCAL + 4100}" , ARG:1 + 2 , , ARG:2 + 6 * LOCAL
		ENDIF
	ENDIF
