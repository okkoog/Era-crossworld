			CALL SET_PICTURE , SUBSTRING_T(LOCALS:2, LOCAL:3, 29) , ARG:1 + 6 , , ARG:2 + 24
			LOCAL:3 += STRLENS(SUBSTRING_T(LOCALS:2, LOCAL:3, 29))
			CALL SET_PICTURE , SUBSTRING_T(LOCALS:2, LOCAL:3, 29) , ARG:1 + 7 , , ARG:2 + 24
			
		CATCH
			LOCALS += "----------------"
			CALL SET_PICTURE , LOCALS , ARG:1 + 3 , , ARG:2 + 24
			CALL SET_PICTURE , "ｺｽﾄ: 0" , ARG:1 + 3 , , ARG:2 + 46
		ENDCATCH
		
		LOCALS = SP2:
		TRYCCALLFORM CGSP_NAME_{DEMON_DATE_V:CBV_SP2}, DEMON_DATE_S:CBS_SP2_SUB, -1
			IF DEMON_DATE_S:CBS_SP2_NAME_CHANGE != ""
				LOCALS += DEMON_DATE_S:CBS_SP2_NAME_CHANGE
			ELSE
				LOCALS += RESULTS
			ENDIF
			CALL CGSP_CURSOR_EXPLAIN(DEMON_DATE_V:CBV_SP2 , -1 , DEMON_DATE_S:CBS_SP2_SUB, DEMON_DATE_S:CBS_SP2_NAME_CHANGE)
			CALL SET_PICTURE , LOCALS + ",,,," + RESULTS , ARG:1 + 3 , , ARG:2 + 56
			CALLFORM CGSP_TIMING_{DEMON_DATE_V:CBV_SP2}, DEMON_DATE_S:CBS_SP2_SUB, -1
			IF RESULT > 0
				LOCALS:1 = 自動発動
			ELSE
				CALLFORM CGSP_COST_{DEMON_DATE_V:CBV_SP2}, DEMON_DATE_S:CBS_SP2_SUB, -1
				LOCALS:1 = ｺｽﾄ:{RESULT,2}
				CALLFORM CGSP_ACTION_AFTER_{DEMON_DATE_V:CBV_SP2}, DEMON_DATE_S:CBS_SP2_SUB, -1
				IF RESULT == 1
					LOCALS:1 += @"_▼,{COLOR("パ赤")}"
				ELSEIF RESULT == 2
					LOCALS:1 += @"_■,{COLOR("藍色")}"
				ELSEIF RESULT == 3
					LOCALS:1 += @"_◆,{COLOR("LIGHT-YELLOW")}"
				ENDIF
			ENDIF
			CALL SET_PICTURE , LOCALS:1 , ARG:1 + 3 , , ARG:2 + 78
			
			CALLFORM CGSP_EXPLAIN_{DEMON_DATE_V:CBV_SP2}, DEMON_DATE_S:CBS_SP2_SUB, -1
			LOCALS:2 '= RESULTS
			LOCAL:3 = 0
			CALL SET_PICTURE , SUBSTRING_T(LOCALS:2, LOCAL:3, 29) , ARG:1 + 5 , , ARG:2 + 56
			LOCAL:3 += STRLENS(SUBSTRING_T(LOCALS:2, LOCAL:3, 29))
			CALL SET_PICTURE , SUBSTRING_T(LOCALS:2, LOCAL:3, 29) , ARG:1 + 6 , , ARG:2 + 56
			LOCAL:3 += STRLENS(SUBSTRING_T(LOCALS:2, LOCAL:3, 29))
			CALL SET_PICTURE , SUBSTRING_T(LOCALS:2, LOCAL:3, 29) , ARG:1 + 7 , , ARG:2 + 56
			
		CATCH
			LOCALS += "----------------"
			CALL SET_PICTURE , LOCALS , ARG:1 + 3 , , ARG:2 + 56
			CALL SET_PICTURE , "ｺｽﾄ: 0" , ARG:1 + 3 , , ARG:2 + 78
		ENDCATCH
	ENDIF
	
	
	
ENDIF

;ARGS	画像アドレス
;ARG:0	表示位置縦 -1でSETなしで読み込めた行数を返す
;ARG:1	表示位置横
;ARG:2	画像行数	自動で最大数になる
;ARG:3	画像横長	自動で正方形になる(行数の2倍)
@BF_IMEGE_WINDOW, ARGS, ARG , ARG:1 , ARG:2 = -1, ARG:3 = -1, ARGS:1 = ""
#DIM IMAGE_C
;PRINTFORMW %ARGS%
SIF STRLENS(ARGS) < 1
	RETURN 0

IMAGE_C = IMAGE_LINE_COUNT(ARGS)
IF IMAGE_C > 0
	ARG:2 = (ARG:2 == -1 ? IMAGE_C # ARG:2)
	ARG:3 = (ARG:3 == -1 ? IMAGE_C * 2 # ARG:3)

	IF ARG >= 0
		FOR LOCAL, 0, ARG:2
			LOCALS = %ARGS%_{LOCAL + 1}
			CALL SET_PICTURE , @"%" " * ARG:3%,WRITE-IMAGE,%PICTURE_IMG(LOCALS)%,%ARGS:1%" , ARG + LOCAL , , ARG:1
		NEXT
	ELSE
		RETURN IMAGE_C
	ENDIF
ELSEIF ARG:2 > 0 || ARG < 0
	SPRITECREATED ARGS
	IF !RESULT
		TRYCALL CS_PORTRATE_SCRIPT ,ARGS
	ENDIF
	IF RESULT
		IF ARG >= 0
			ARG:3 = (ARG:3 < 0 ? ARG:2 * 2 # ARG:3)
			CALL SET_PICTURE , @"%" " * ARG:3%,WRITE-IMAGE-{ARG:2}-{ARG:3},%PICTURE_IMG(ARGS)%,%ARGS:1%" , ARG , , ARG:1
			;PRINTFORMW @"%" " * ARG:3%,WRITE-IMAGE-{ARG:2}-{ARG:3},%PICTURE_IMG(ARGS)%
		ELSE
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 0



;information
;ARG 서머너
;ARG:1 仲魔
;ARG:2 合体
@MAG_SUPPLY, ARG, ARG:1, ARG:2 = 0
#FUNCTION
SIF ARG > 33 || ARG < 11 || ARG:1 > 33
	RETURNF 0
LOCAL = 0
SIF ARG:2 > 1
	LOCAL = 1
IF ARG == ARG:1
	RETURNF 2 + LOCAL
ELSEIF ARG % 10 == ARG:1 % 10 || ARG / 10 == ARG:1 / 10 || ARG:1 == 1
	RETURNF 1 + LOCAL
ELSEIF (ARG % 10 == 2 || ARG / 10 == 2) && (ARG:1 % 10 == 2 || ARG:1 / 10 == 2)
	RETURNF 1 + LOCAL
ENDIF
RETURNF 0 + LOCAL


@ALIGNMENT_PICTURE, ARG, ARG:1 = 0, ARGS = "", ARGS:1 = ""
#FUNCTIONS


IF ARG > 10 && ARG < 34
	IF ARG:1 == 1
		LOCALS '= SUBSTRING(GET_ALI1(ARG / 10), 0, 1)
		LOCALS:1 '= SUBSTRING(GET_ALI2(ARG % 10), 0, 1)
	ELSE
		LOCALS '= GET_ALI1(ARG / 10)
		LOCALS:1 '= GET_ALI2(ARG % 10)
	ENDIF
	
	RETURNF @"%LOCALS%,{CS_ALICOLOR(0,ARG / 10)},,%ARGS%,%ARGS:1%_-,,,%ARGS%,%ARGS:1%_%LOCALS:1%,{CS_ALICOLOR(1,ARG % 10)},,%ARGS%,%ARGS:1%_"
ELSEIF ARG == 1
	IF ARG:1 == 1
		RETURNF @"????,{KINDSCOLOR(ARG)},,%ARGS%,%ARGS:1%_"
	ELSE
		RETURNF @"Unkown,{KINDSCOLOR(ARG)},,%ARGS%,%ARGS:1%_"
	ENDIF
ELSE
	RETURNF @"None,{KINDSCOLOR(ARG)},,%ARGS%,%ARGS:1%_"
ENDIF



