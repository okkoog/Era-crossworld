;ARG:1	表示位置縦
;ARG:2	表示位置横
;ARG:3	画像の大きさ
@BF_SUMMONER_WINDOW , ARG , ARG:1 , ARG:2 , ARG:3 = 0
#DIMS L_NAME
#DIM L_SELECT_COLOR
#DIM L_COLOR
#DIM L_HPCOLOR
#DIM L_SUMMONER
#DIM L_ALIGNMENT
#DIM L_DECK
#DIM L_HAND
#DIM L_HP_MAG
#DIM L_CLICK
#DIM L_IMAGE_TYPE
;┏┓┗┛━┃┳┣┻┫╋█▉▊▋▌▎▎▏　K▁▂▄▃▅▆▇█ ▉▐▔▕
;┌┐└┘─│┴├┬┤┼
;"　∭∭　　　　　　 ▕░░"
;" ▟┃╲ 　　　　　 ▕░░"
;"▟▘┃ ╲　　　　　 ▕░░"
;あいうえおかきくけこさしすせそたちつてと
;═║╔╦╗╠╬╣╚╩╝",▖▗▘▙▚▛▜▝▞▟
;┍┎┑┒┕┖┙┚

IF SUMMONER_INFO:ARG:CSI2_NANE != ""
	L_NAME '= SUBSTRING(SUMMONER_INFO:ARG:CSI2_NANE, 0, 8)
ELSE
	L_NAME '= (ARG == CS1_ONESELF ? "ONESELF" # "OPPONENT")
ENDIF
L_COLOR = (ARG == CS1_ONESELF ? COLOR("FRIEND") # COLOR("ENEMY"))
IF ARG == CS1_ONESELF
	L_SUMMONER = 12
	L_ALIGNMENT = 15
	L_DECK = 0
	L_HAND = 3
	L_HP_MAG = 6
	L_CLICK = 8
ELSE
	L_SUMMONER = 0
	L_ALIGNMENT = 0
	L_CLICK = 6
	L_DECK = 12
	L_HAND = 15
	L_HP_MAG = 10
ENDIF


L_IMAGE_TYPE = 0
IF SUMMONER_INFO:ARG:CSI2_IMAGE != ""
	IF IMAGE_LINE_COUNT(SUMMONER_INFO:ARG:CSI2_IMAGE) == 4
		L_IMAGE_TYPE = 1
	ELSEIF IMAGE_LINE_COUNT(SUMMONER_INFO:ARG:CSI2_IMAGE) == 6
		L_IMAGE_TYPE = 2
	ELSE
		SPRITECREATED SUMMONER_INFO:ARG:CSI2_IMAGE
		SIF RESULT
			L_IMAGE_TYPE = 2
	ENDIF


	IF L_IMAGE_TYPE == 1
		CALL SET_PICTURE , @"┏━━━━┓,{L_COLOR},,{ARG}" , ARG:1 + L_SUMMONER , , ARG:2
		CALL SET_PICTURE , @"┃        ┃,{L_COLOR},,{ARG}" , ARG:1 + L_SUMMONER + 1 , , ARG:2
		CALL SET_PICTURE , @"┃        ┃,{L_COLOR},,{ARG}" , ARG:1 + L_SUMMONER + 2 , , ARG:2
		CALL SET_PICTURE , @"┃        ┃,{L_COLOR},,{ARG}" , ARG:1 + L_SUMMONER + 3 , , ARG:2
		CALL SET_PICTURE , @"┃        ┃,{L_COLOR},,{ARG}" , ARG:1 + L_SUMMONER + 4 , , ARG:2
		CALL SET_PICTURE , @"┗━━━━┛,{L_COLOR},,{ARG}" , ARG:1 + L_SUMMONER + 5 , , ARG:2
		CALL BF_IMEGE_WINDOW, SUMMONER_INFO:ARG:CSI2_IMAGE, ARG:1 + L_SUMMONER + 1, ARG:2 + 2, 4, -1, @"{ARG}"
	ELSEIF L_IMAGE_TYPE == 2
		CALL BF_IMEGE_WINDOW, SUMMONER_INFO:ARG:CSI2_IMAGE, ARG:1 + L_SUMMONER, ARG:2, 6, -1, @"{ARG}"
	ENDIF
	;IF ARG:3 == 0
	;	CALL SET_PICTURE , @"%ARG == 0 ? "ONESELF" # "OPPONENT",8%,WRITE-IMAGE,%PICTURE_IMG(SUMMONER_INFO:ARG:CSI2_IMAGE)%_0_1,{ARG}" , ARG:1 + L_SUMMONER + 1 , , ARG:2 + 2
	;	CALL SET_PICTURE , @"        ,WRITE-IMAGE,%PICTURE_IMG(SUMMONER_INFO:ARG:CSI2_IMAGE)%_0_2,{ARG}" , ARG:1 + L_SUMMONER + 2 , , ARG:2 + 2
	;	CALL SET_PICTURE , @"        ,WRITE-IMAGE,%PICTURE_IMG(SUMMONER_INFO:ARG:CSI2_IMAGE)%_0_3,{ARG}" , ARG:1 + L_SUMMONER + 3 , , ARG:2 + 2
	;	CALL SET_PICTURE , @"        ,WRITE-IMAGE,%PICTURE_IMG(SUMMONER_INFO:ARG:CSI2_IMAGE)%_0_4,{ARG}" , ARG:1 + L_SUMMONER + 4 , , ARG:2 + 2
	;ELSEIF ARG:3 == 1
	;	CALL SET_PICTURE , @"┏━━━━┓,WRITE-IMAGE,%PICTURE_IMG(SUMMONER_INFO:ARG:CSI2_IMAGE)%_1_1,{ARG}" , ARG:1 + L_SUMMONER , , ARG:2
	;	CALL SET_PICTURE , @"┃%ARG == 0 ? "ONESELF" # "OPPONENT",8%┃,WRITE-IMAGE,%PICTURE_IMG(SUMMONER_INFO:ARG:CSI2_IMAGE)%_1_2,{ARG}" , ARG:1 + L_SUMMONER + 1 , , ARG:2
	;	CALL SET_PICTURE , @"┃        ┃,WRITE-IMAGE,%PICTURE_IMG(SUMMONER_INFO:ARG:CSI2_IMAGE)%_1_3,{ARG}" , ARG:1 + L_SUMMONER + 2 , , ARG:2
	;	CALL SET_PICTURE , @"┃        ┃,WRITE-IMAGE,%PICTURE_IMG(SUMMONER_INFO:ARG:CSI2_IMAGE)%_1_4,{ARG}" , ARG:1 + L_SUMMONER + 3 , , ARG:2
	;	CALL SET_PICTURE , @"┃        ┃,WRITE-IMAGE,%PICTURE_IMG(SUMMONER_INFO:ARG:CSI2_IMAGE)%_1_5,{ARG}" , ARG:1 + L_SUMMONER + 4 , , ARG:2
	;	CALL SET_PICTURE , @"┗━━━━┛,WRITE-IMAGE,%PICTURE_IMG(SUMMONER_INFO:ARG:CSI2_IMAGE)%_1_6,{ARG}" , ARG:1 + L_SUMMONER + 5 , , ARG:2
	;ENDIF
ENDIF
IF L_IMAGE_TYPE == 0
	CALL SET_PICTURE , @"┏━━━━┓,{L_COLOR},,{ARG}" , ARG:1 + L_SUMMONER , , ARG:2
	CALL SET_PICTURE , @"┃%ARG == 0 ? "ONESELF" # "OPPONENT",8%┃,{L_COLOR},,{ARG}" , ARG:1 + L_SUMMONER + 1 , , ARG:2
	CALL SET_PICTURE , @"┃        ┃,{L_COLOR},,{ARG}" , ARG:1 + L_SUMMONER + 2 , , ARG:2
	CALL SET_PICTURE , @"┃        ┃,{L_COLOR},,{ARG}" , ARG:1 + L_SUMMONER + 3 , , ARG:2
	CALL SET_PICTURE , @"┃        ┃,{L_COLOR},,{ARG}" , ARG:1 + L_SUMMONER + 4 , , ARG:2
	CALL SET_PICTURE , @"┗━━━━┛,{L_COLOR},,{ARG}" , ARG:1 + L_SUMMONER + 5 , , ARG:2
ENDIF

IF SUMMONER_PARAMETER:ARG:CSP2_HP < 4
	L_HPCOLOR = COLOR("WARNING")
ELSEIF SUMMONER_PARAMETER:ARG:CSP2_HP <= SUMMONER_PARAMETER:ARG:CSP2_MAX_HP / 2
	L_HPCOLOR = COLOR("YELLOW")
ELSE
	L_HPCOLOR = COLOR("P-GREEN")
ENDIF
;CALL SET_PICTURE , @"HP :_{SUMMONER_PARAMETER:ARG:CSP2_HP,2},{L_HPCOLOR}_/{SUMMONER_PARAMETER:ARG:CSP2_MAX_HP,2}  _%"█" * SUMMONER_PARAMETER:ARG:CSP2_HP%,{L_HPCOLOR}", ARG:1 + L_HP_MAG , , ARG:2
CALL SET_PICTURE , @"HP :_{SUMMONER_PARAMETER:ARG:CSP2_HP,2},{L_HPCOLOR}_/{SUMMONER_PARAMETER:ARG:CSP2_MAX_HP,2}", ARG:1 + L_HP_MAG , , ARG:2
CALL SET_PICTURE , @"MAG:{SUMMONER_PARAMETER:ARG:CSP2_MAG,2}", ARG:1 + L_HP_MAG + 1 , , ARG:2
CALL SET_PICTURE , @"{SUMMONER_PARAMETER:ARG:CSP2_STOCK_MAG,2},{COLOR("AQUA")}", ARG:1 + L_HP_MAG + 1 , , ARG:2 + 7
L_SELECT_COLOR = L_COLOR

IF 0 < CBF_SELECT_MODE
	L_SELECT_COLOR = COLOR("DARK-GRAY")
	IF CBF_SELECT_MODE == 1 && GETBIT(CBF_SELECT_BIT, ARG + 20)
		L_SELECT_COLOR = COLOR("WHITE")
	ELSEIF CBF_SELECT_MODE == 2 && GETBIT(CBF_SELECT_BIT, ARG + 20)
		L_SELECT_COLOR = COLOR("WHITE")
		SIF GETBIT(CBF_SELECTING_BIT, ARG + 20)
			L_SELECT_COLOR = COLOR("P-BLUE")
	ENDIF
ENDIF
CALL SET_PICTURE ,   @"┏━━━━┓,{CBF_SELECT == ARG ? COLOR("YELLOW") # L_SELECT_COLOR},,{ARG}" , ARG:1 + L_CLICK , , ARG:2
CALL SET_PICTURE , @"┃%L_NAME,8%┃,{CBF_SELECT == ARG ? COLOR("YELLOW") # L_SELECT_COLOR},,{ARG}" , ARG:1 + L_CLICK + 1 , , ARG:2
CALL SET_PICTURE ,   @"┗━━━━┛,{CBF_SELECT == ARG ? COLOR("YELLOW") # L_SELECT_COLOR},,{ARG}" , ARG:1 + L_CLICK + 2 , , ARG:2

IF CBF_SELECT_MODE == 1 && CBF_SELECT == ARG && GETBIT(CBF_SELECT_BIT, ARG + 20)
	CALL SET_PICTURE , @"[SELECT],{L_SELECT_COLOR},,4100" , ARG:1 + L_CLICK + 2 , , ARG:2 + 3
	
ELSEIF CBF_SELECT_MODE == 2 && GETBIT(CBF_SELECT_BIT, ARG + 20)
	CALL SET_PICTURE , (GETBIT(CBF_SELECTING_BIT, ARG + 20) ? "[REMOVE]" # "[SELECT]") + @",{L_SELECT_COLOR},,{ARG + 20 + 4100}" , ARG:1 + L_CLICK + 2 , , ARG:2 + 3
	
ENDIF

;CALL SET_PICTURE , @"%L_NAME,6%,{L_SELECT_COLOR},,{ARG}" , ARG:1 + L_CLICK + 1 , , ARG:2 + 2

		;ここに状態異常
		FOR LOCAL:1, 0, 8
			IF SUMMONER_STATE:ARG:(LOCAL:1):CSS3_STATE > 1
				SIF SUMMONER_STATE:ARG:(LOCAL:1):CSS3_STATE < 2000
					LOCAL:3 = SUMMONER_STATE:ARG:(LOCAL:1):CSS3_STATE % 1000
				
				IF LOCAL:3 < 100
					LOCAL:2 = COLOR("FRIEND")
				ELSEIF LOCAL:3 < 200
					LOCAL:2 = COLOR("WARNING")
				ELSE
					LOCAL:2 = COLOR("YELLOW")
				ENDIF
				LOCALS '= S_STATE_NAME_FULL(ARG, LOCAL:1) + @"  {SUMMONER_STATE:ARG:(LOCAL:1):CSS3_TURN}T" + UNICODE(0x000D) + UNICODE(0x000D) + S_STATE_DESCRIPTION_GET2(ARG, LOCAL:1)
				CALL SET_PICTURE , S_STATE_MARK_GET(LOCAL:3) + @",{LOCAL:2},,{ARG}," + LOCALS, ARG:1 + L_CLICK + 3 , , ARG:2 + LOCAL:1 * 2
			ENDIF
		NEXT
;NEUTRAL-NEUTRAL

;CALL SET_PICTURE , @"┏%"━" * 8%┓┏━━━━┓┏━━━━┓,{L_COLOR},,{ARG}" , ARG:1 + 3 , , ARG:2 + 12
;CALL SET_PICTURE , @"┃%"  " * 8%┃┃DECK：{DECK_CARDS(ARG),2}┃┃HAND：{HAND_CARDS(ARG),2}┃,{L_COLOR},,{ARG}" , ARG:1 + 4 , , ARG:2 + 12
;CALL SET_PICTURE , @"┗%"━" * 8%┛┗━━━━┛┗━━━━┛,{L_COLOR},,{ARG}" , ARG:1 + 5 , , ARG:2 + 12
;CALL SET_PICTURE , @"%ALIGNMENT_PICTURE(SUMMONER_PARAMETER:ARG:CSP2_ALIGNMENT,0,TOSTR(ARG))%_" , ARG:1 + 4 , , ARG:2 + 14

CALL SET_PICTURE , @"┏%"━" * 8%┓,{L_COLOR},,{ARG}" , ARG:1 + L_ALIGNMENT , , ARG:2 + 12
CALL SET_PICTURE , @"┃%"  " * 8%┃,{L_COLOR},,{ARG}" , ARG:1 + L_ALIGNMENT + 1 , , ARG:2 + 12
CALL SET_PICTURE , @"┗%"━" * 8%┛,{L_COLOR},,{ARG}" , ARG:1 + L_ALIGNMENT + 2 , , ARG:2 + 12
CALL SET_PICTURE , @"%ALIGNMENT_PICTURE(SUMMONER_PARAMETER:ARG:CSP2_ALIGNMENT,0,TOSTR(ARG))%_" , ARG:1 +  L_ALIGNMENT + 1 , , ARG:2 + 14


CALL SET_PICTURE , @"┏━━━━┓,{L_COLOR},,{ARG}" , ARG:1 + L_DECK , , ARG:2
CALL SET_PICTURE , @"┃DECK：{DECK_CARDS(ARG),2}┃,{L_COLOR},,{ARG}" , ARG:1 + L_DECK + 1 , , ARG:2
CALL SET_PICTURE , @"┗━━━━┛,{L_COLOR},,{ARG}" , ARG:1 + L_DECK + 2 , , ARG:2

CALL SET_PICTURE , @"┏━━━━┓,{L_COLOR},,{ARG}" , ARG:1 + L_HAND, , ARG:2
CALL SET_PICTURE , @"┃HAND：{HAND_CARDS(ARG),2}┃,{L_COLOR},,{ARG}" , ARG:1 + L_HAND + 1 , , ARG:2
CALL SET_PICTURE , @"┗━━━━┛,{L_COLOR},,{ARG}" , ARG:1 + L_HAND + 2 , , ARG:2





;この辺に状態

;ARG	サマナー番号
;ARG:1	表示位置縦
;ARG:2	表示位置横
@BF_DEMON_WINDOW , ARG , ARG:1 , ARG:2 
#DIM L_COUNT
#DIM L_COLOR
#DIM L_HPCOLOR
#DIM L_APCOLOR
#DIM L_MAGCOLOR
#DIM L_NAMECOLOR
#DIM L_SELECT_COLOR
#DIM L_HP
#DIM L_AP
#DIM L_MAG
#DIMS L_CLICK_STR
#DIM L_IMAGE_TYPE

IF ARG == CS1_ONESELF
	LOCAL:1 = CBF_ALLY_POS1
	LOCAL:2 = CBF_ALLY_POS6 + 1
ELSE
	LOCAL:1 = CBF_ENEMY_POS1
	LOCAL:2 = CBF_ENEMY_POS6 + 1
ENDIF
FOR L_COUNT, LOCAL:1, LOCAL:2
	
	
	IF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1
		L_COLOR = COLOR("DARK-GRAY")
	ELSEIF GETBIT(FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION,2)
		L_COLOR = 0xa73836
	ELSEIF GETBIT(FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION,0)
		L_COLOR = COLOR("LIGHT-GRAY")
	ELSE
		L_COLOR = COLOR("WHITE")
	ENDIF
	
	IF 0 < CBF_SELECT_MODE
		L_COLOR = COLOR("DARK-GRAY")
		IF CBF_SELECT_MODE == 1 && GETBIT(CBF_SELECT_BIT, L_COUNT)
			L_COLOR = COLOR("P-BLUE")
		ELSEIF CBF_SELECT_MODE == 2 && GETBIT(CBF_SELECT_BIT, L_COUNT)
			L_COLOR = COLOR("P-BLUE")
			SIF GETBIT(CBF_SELECTING_BIT, L_COUNT)
				L_COLOR = COLOR("LIME")
		ENDIF
	ENDIF
	
	L_CLICK_STR = {L_COUNT + 1000}
	
	L_SELECT_COLOR = (CBF_SELECT == L_COUNT + 1000 ? COLOR("YELLOW") # L_COLOR)
	
	LOCAL = (FIELD_DEMON_DATE_V:L_COUNT:CBV_FLYING > 0 ? 0 # 2) + (ARG > 0 ? 0 # 2)
	
	CALL SET_PICTURE , @"┏━━━━━━━━┓,{L_SELECT_COLOR},,%L_CLICK_STR%" , ARG:1 + LOCAL , , ARG:2 + (L_COUNT % 6 * 20)
	CALL SET_PICTURE , @"┃                ┃,{L_SELECT_COLOR},,%L_CLICK_STR%" , ARG:1 + LOCAL + 1 , , ARG:2 + (L_COUNT % 6 * 20)
	CALL SET_PICTURE , @"┃                ┃,{L_SELECT_COLOR},,%L_CLICK_STR%" , ARG:1 + LOCAL + 2 , , ARG:2 + (L_COUNT % 6 * 20)
	CALL SET_PICTURE , @"┃                ┃,{L_SELECT_COLOR},,%L_CLICK_STR%" , ARG:1 + LOCAL + 3 , , ARG:2 + (L_COUNT % 6 * 20)
	CALL SET_PICTURE , @"┃                ┃,{L_SELECT_COLOR},,%L_CLICK_STR%" , ARG:1 + LOCAL + 4 , , ARG:2 + (L_COUNT % 6 * 20)
	CALL SET_PICTURE , @"┃                ┃,{L_SELECT_COLOR},,%L_CLICK_STR%" , ARG:1 + LOCAL + 5 , , ARG:2 + (L_COUNT % 6 * 20)
	CALL SET_PICTURE , @"┃                ┃,{L_SELECT_COLOR},,%L_CLICK_STR%" , ARG:1 + LOCAL + 6 , , ARG:2 + (L_COUNT % 6 * 20)
	CALL SET_PICTURE , @"┃                ┃,{L_SELECT_COLOR},,%L_CLICK_STR%" , ARG:1 + LOCAL + 7 , , ARG:2 + (L_COUNT % 6 * 20)
	CALL SET_PICTURE , @"┣━━━━━━━━┫,{L_SELECT_COLOR},,%L_CLICK_STR%" , ARG:1 + LOCAL + 8 , , ARG:2 + (L_COUNT % 6 * 20)
	CALL SET_PICTURE , @"┃                ┃,{L_SELECT_COLOR},,%L_CLICK_STR%" , ARG:1 + LOCAL + 9 , , ARG:2 + (L_COUNT % 6 * 20)
	CALL SET_PICTURE , @"┃                ┃,{L_SELECT_COLOR},,%L_CLICK_STR%" , ARG:1 + LOCAL + 10 , , ARG:2 + (L_COUNT % 6 * 20)
	CALL SET_PICTURE , @"┗━━━━━━━━┛,{L_SELECT_COLOR},,%L_CLICK_STR%" , ARG:1 + LOCAL + 11 , , ARG:2 + (L_COUNT % 6 * 20)
	
	IF CBF_SELECT_MODE == 1 && CBF_SELECT == L_COUNT + 1000 && GETBIT(CBF_SELECT_BIT, L_COUNT)
		CALL SET_PICTURE , @"[SELECT],{L_SELECT_COLOR},,4100" , ARG:1 + LOCAL + 11 , , ARG:2 + (L_COUNT % 6 * 20) + 6
		
	ELSEIF CBF_SELECT_MODE == 2 && GETBIT(CBF_SELECT_BIT, L_COUNT)
		CALL SET_PICTURE , (GETBIT(CBF_SELECTING_BIT, L_COUNT) ? "[REMOVE]" # "[SELECT]") + @",{L_SELECT_COLOR},,{L_COUNT + 4100}" , ARG:1 + LOCAL + 11 , , ARG:2 + (L_COUNT % 6 * 20) + 6
	ELSEIF CBF_SELECT_MODE == 0 && CBF_PHASE == 3 && CBF_SELECT == L_COUNT + 1000  && !GETBIT(FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION, 0) && !GETBIT(FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION, 2) && FIELD_DEMON_DATE_V:L_COUNT:CBV_HOST == CBF_P_TURN
		IF FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE < 1
			SIF CS_ATTACK_USE_CHECK(L_COUNT)
				CALL SET_PICTURE , @"[ATTACK],{COLOR("WHITE")},,3000" , ARG:1 + LOCAL + 11 , , ARG:2 + (L_COUNT % 6 * 20) + 2
		ELSE
			CALL SET_PICTURE , @"[ OFF  ],{COLOR("WHITE")},,3000" , ARG:1 + LOCAL + 11 , , ARG:2 + (L_COUNT % 6 * 20) + 2
		ENDIF
		TRYCCALLFORM CGSP_TIMING_{FIELD_DEMON_DATE_V:L_COUNT:CBV_SP1}, FIELD_DEMON_DATE_S:L_COUNT:CBS_SP1_SUB, L_COUNT
			SIF RESULT == 0 && CS_SP_USE_CHECK(L_COUNT)
				CALL SET_PICTURE , @"[  SP  ],{COLOR("WHITE")},,3001" , ARG:1 + LOCAL + 11 , , ARG:2 + (L_COUNT % 6 * 20) + 10
		CATCH
		ENDCATCH
		SIF !GETBIT(FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION, 3) && FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE < 1 && FIELD_DEMON_DATE_V:L_COUNT:CBV_NO != 0
			CALL SET_PICTURE , @"[M-CREATE],{L_SELECT_COLOR},,3002" , ARG:1 + LOCAL , , ARG:2 + (L_COUNT % 6 * 20) + 10
	ELSEIF CBF_SELECT_MODE == 0 && CBF_PHASE == 4 && CBF_SELECT == L_COUNT + 1000  && FIELD_DEMON_DATE_V:L_COUNT:CBV_BATTLE > 0
		IF FIELD_DEMON_DATE_V:L_COUNT:CBV_HOST == CBF_P_TURN
			CALL SET_PICTURE , @"[BLOCKING],{L_SELECT_COLOR},,3100" , ARG:1 + LOCAL + 11 , , ARG:2 + (L_COUNT % 6 * 20) + 5
		ELSE
			CALL SET_PICTURE , "[ OFF  ]" + @",{L_SELECT_COLOR},,3100" , ARG:1 + LOCAL + 11 , , ARG:2 + (L_COUNT % 6 * 20) + 6
		ENDIF
	ENDIF
	
	
	
	
	IF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1
		CALL SET_PICTURE , @"EMPTY,{L_COLOR},,%L_CLICK_STR%" , ARG:1 + LOCAL + 1 , , ARG:2 + (L_COUNT % 6 * 20) + 2
	ELSE
		IF FIELD_DEMON_DATE_V:L_COUNT:CBV_NO < 1
			L_NAMECOLOR = COLOR("DARK-GRAY")
		ELSEIF GETBIT(FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION,2)
			L_NAMECOLOR = 0xa73836
		ELSEIF GETBIT(FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION,0)
			L_NAMECOLOR = COLOR("DARK-GRAY")
		ELSEIF GETBIT(FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION,1)
			L_NAMECOLOR = COLOR("ピンク")
		ELSE
			L_NAMECOLOR = COLOR("WHITE")
		ENDIF
		L_AP = FIELD_DEMON_DATE_V:L_COUNT:CBV_AP
		L_HP = FIELD_DEMON_DATE_V:L_COUNT:CBV_HP
		L_MAG = FIELD_DEMON_DATE_V:L_COUNT:CBV_MAG
		IF L_AP == FIELD_DEMON_DATE_V:L_COUNT:CBV_B_AP
			L_APCOLOR = COLOR("WHITE")
		ELSE
			L_APCOLOR = (L_AP > FIELD_DEMON_DATE_V:L_COUNT:CBV_B_AP ? COLOR("AQUA") # COLOR("WARNING"))
		ENDIF
		IF L_HP == FIELD_DEMON_DATE_V:L_COUNT:CBV_B_HP
			L_HPCOLOR = COLOR("WHITE")
		ELSE
			L_HPCOLOR = (L_HP > FIELD_DEMON_DATE_V:L_COUNT:CBV_B_HP ? COLOR("AQUA") # COLOR("WARNING"))
		ENDIF
		IF L_MAG == MAG_SUPPLY(SUMMONER_PARAMETER:ARG:CSP2_ALIGNMENT, FIELD_DEMON_DATE_V:L_COUNT:CBV_KINDS, FIELD_DEMON_DATE_V:L_COUNT:CBV_FUSION)
			L_MAGCOLOR = COLOR("P-GREEN")
		ELSE
			L_MAGCOLOR = (L_MAG > MAG_SUPPLY(SUMMONER_PARAMETER:ARG:CSP2_ALIGNMENT, FIELD_DEMON_DATE_V:L_COUNT:CBV_KINDS, FIELD_DEMON_DATE_V:L_COUNT:CBV_FUSION) ? COLOR("AQUA") # COLOR("WARNING"))
		ENDIF
		
		L_IMAGE_TYPE = 0
		IF IMAGE_LINE_COUNT(CARD_IMAGE_ID:(FIELD_DEMON_DATE_V:L_COUNT:CBV_NO)) == 4
			L_IMAGE_TYPE = 1
			LOCAL:2 = 4
		ELSEIF IMAGE_LINE_COUNT(CARD_IMAGE_ID:(FIELD_DEMON_DATE_V:L_COUNT:CBV_NO)) == 6
			L_IMAGE_TYPE = 2
			LOCAL:2 = 6
		ELSE
			CALL BF_IMEGE_WINDOW, CARD_IMAGE_ID:(FIELD_DEMON_DATE_V:L_COUNT:CBV_NO), -1
			IF RESULT
				L_IMAGE_TYPE = 1
				LOCAL:2 = 4
			ENDIF
		ENDIF
		CALL BF_IMEGE_WINDOW, CARD_IMAGE_ID:(FIELD_DEMON_DATE_V:L_COUNT:CBV_NO), ARG:1 + LOCAL + 1, ARG:2 + (L_COUNT % 6 * 20) + 2, LOCAL:2, -1, L_CLICK_STR
		
		;SIF LOCAL:4 < 4
		SIF L_IMAGE_TYPE == 0
