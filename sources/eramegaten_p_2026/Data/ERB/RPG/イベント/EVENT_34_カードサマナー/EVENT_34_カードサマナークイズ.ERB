

@CS_QUIZ
#DIM L_LINE
#DIM L_COUNT
#DIM L_SELECT
#DIMS L_EM

L_EM = CardSummoner
IF イベントフラグ:34:2 == 1
    CS_TUTORIAL:0 = 101
    CS_TUTORIAL:1 = 0
    CS_DECK_FIXED = 1
    CS_START_T_FIXED = 1
    SUMMONER_INFO:CS1_ONESELF:CSI2_NANE = 당신
    SUMMONER_PARAMETER:CS1_ONESELF:CSP2_ALIGNMENT = 23

    SUMMONER_INFO:CS1_OPPONENT:CSI2_NANE = 하나코
    SUMMONER_INFO:CS1_OPPONENT:CSI2_IMAGE '= E34_C_ICON_B("はなこ")
    SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT = 23
    
    ;バトル終了　勝利
    CBF_NPC_COMMENT:6:0 = 어택 중마의 「AP」가 아니라/「HP」에 주목해 줘.

    CALL CS_DEMON_SUMMON_FIELD, 0, 32;プールソン
    CALL CS_DEMON_SUMMON_FIELD, 1, 30;バジリスク
    CALL CS_DEMON_SUMMON_FIELD, 2, 27;キキーモラ

    CALL CS_DEMON_SUMMON_FIELD, 6, 30;バジリスク
    CALL CS_DEMON_SUMMON_FIELD, 7, 34;タンガタ・マヌ
    CALL CS_DEMON_SUMMON_FIELD, 8, 29;ドゥン

	FOR L_COUNT, 1, 13
        FIELD_DEMON_DATE_V:(L_COUNT - 1):CBV_CONDITION = 0
    NEXT

    CALL CS_BATTLE_START, 0, 4, 4

ELSEIF イベントフラグ:34:2 == 2
    CS_TUTORIAL:0 = 102
    CS_TUTORIAL:1 = 0
    CS_DECK_FIXED = 1
    CS_START_T_FIXED = 1
    SUMMONER_INFO:CS1_ONESELF:CSI2_NANE = 당신
    SUMMONER_PARAMETER:CS1_ONESELF:CSP2_ALIGNMENT = 23

    SUMMONER_INFO:CS1_OPPONENT:CSI2_NANE = 하나코
    SUMMONER_INFO:CS1_OPPONENT:CSI2_IMAGE '= E34_C_ICON_B("はなこ")
    SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT = 23

    ;バトル終了　勝利
    CBF_NPC_COMMENT:6:0 = 어택 중마의 「AP」와/아군 중마의 「HP」에 주목해 줘.

    CALL CS_DEMON_SUMMON_FIELD, 0, 27;キキーモラ
    CALL CS_DEMON_SUMMON_FIELD, 1, 28;グレイマン
    CALL CS_DEMON_SUMMON_FIELD, 2, 34;タンガタ・マヌ

    CALL CS_DEMON_SUMMON_FIELD, 6, 27;キキーモラ
    CALL CS_DEMON_SUMMON_FIELD, 7, 32;プールソン
    CALL CS_DEMON_SUMMON_FIELD, 8, 34;タンガタ・マヌ

	FOR L_COUNT, 1, 13
        FIELD_DEMON_DATE_V:(L_COUNT - 1):CBV_CONDITION = 0
    NEXT

    CALL CS_BATTLE_START, 0, 1, 1
ELSEIF イベントフラグ:34:2 == 3
    CS_TUTORIAL:0 = 103
    CS_TUTORIAL:1 = 0
    CS_DECK_FIXED = 1
    CS_START_T_FIXED = 1
    SUMMONER_INFO:CS1_ONESELF:CSI2_NANE = 당신
    SUMMONER_PARAMETER:CS1_ONESELF:CSP2_ALIGNMENT = 23

    SUMMONER_INFO:CS1_OPPONENT:CSI2_NANE = 하나코
    SUMMONER_INFO:CS1_OPPONENT:CSI2_IMAGE '= E34_C_ICON_B("はなこ")
    SUMMONER_PARAMETER:CS1_OPPONENT:CSP2_ALIGNMENT = 23

    ;バトル終了　勝利
    CBF_NPC_COMMENT:6:0 = 당신과 나의 HP는 「6」/적과 아군의 「AP」로 누구를 누구로 블록할지 생각해 봐.

    CALL CS_DEMON_SUMMON_FIELD, 0, 30;バジリスク
    CALL CS_DEMON_SUMMON_FIELD, 1, 34;タンガタ・マヌ
    CALL CS_DEMON_SUMMON_FIELD, 2, 30;バジリスク

    CALL CS_DEMON_SUMMON_FIELD, 6, 28;グレイマン
    CALL CS_DEMON_SUMMON_FIELD, 7, 34;タンガタ・マヌ
    CALL CS_DEMON_SUMMON_FIELD, 8, 30;バジリスク

    FOR L_COUNT, 1, 13
        FIELD_DEMON_DATE_V:(L_COUNT - 1):CBV_CONDITION = 0
    NEXT

    CALL CS_BATTLE_START, 0, 6, 6
    IF イベントフラグ:34:2 > 3
        CALL MESSAGE_WINDOW_EM_ICON, L_EM, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", @"당신과 카드 배틀하는 거/재미있을지도…/후후후…"
        CALL MESSAGE_WINDOW_EM_ICON, L_EM, 0, "　", , "　", @"하나코 씨와 프리 배틀을 할 수 있게 되었다."
        CALL MESSAGE_WINDOW_EM_ICON, L_EM, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", @"퀴즈를 풀고 싶을 때는 화장실에 말을 걸어줘…/후후후…"
    ENDIF
ELSE
    CALL MESSAGE_WINDOW_EM_ICON, L_EM, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", @"미안해/지금은, 낼 수 있는 퀴즈가 없어."

ENDIF
CS_TUTORIAL:0 = 0
CS_TUTORIAL:1 = 0
CS_DECK_FIXED = 0
CS_START_T_FIXED = 0


@CS_QUIZ_MESSAGE_VIEW, ARG
#DIM L_COUNT
#DIM L_SELECT

IF CS_TUTORIAL:0 == 101
    IF ARG == 99 && CBF_TURN == 1
        CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "「퀴즈 1」/맞비기기가 되어도 좋으니까 어택 중마를/전부 쓰러뜨릴 수 있는 블록을 해봐"
        CALL CS_BATTLE_MESSAGE_WINDOW_ICON, 0, "", , "", "블록으로 적 중마를 모두 쓰러뜨려라"

        CALL CB_AI_SET, 3506
        CALL CB_AI_SET, 3507
        CALL CB_AI_SET, 3508
        CS_AI_STEP = 40
    ELSEIF CBF_TURN > 1
        L_SELECT = 0
        FOR L_COUNT, CBF_敵ポジション1, CBF_敵ポジション6 + 1
            SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_HP > 0
            L_SELECT ++
        NEXT
        IF L_SELECT < 1
            CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "정답이야/간단했으려나？"
            CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "자, Ð200 줄게."
            MONEY:5 += 200
            イベントフラグ:34:2 ++
        ELSE
            CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "오답이야"
            CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "어택 중마의 「AP」가 아니라/「HP」에 주목해 줘."
        ENDIF
        RETURN -2
    ENDIF
ELSEIF CS_TUTORIAL:0 == 102
    IF ARG == 99 && CBF_TURN == 1
        CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "「퀴즈 2」/가장 좋은 블록은 어떻게 하면 될까？/이번에는 맞비기기가 되면 안 돼."
        CALL CS_BATTLE_MESSAGE_WINDOW_ICON, 0, "", , "", "적 중마를 모두 블록하고/전원 생존하라"

        CALL CB_AI_SET, 3506
        CALL CB_AI_SET, 3507
        CALL CB_AI_SET, 3508
        CS_AI_STEP = 40
    ELSEIF CBF_TURN > 1
        L_SELECT = 0
        FOR L_COUNT, CBF_味方ポジション1, CBF_味方ポジション6 + 1
            SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_HP > 0
                L_SELECT ++
        NEXT
        IF L_SELECT > 2
            CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "정답이야/간단했으려나？"
            CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "자, Ð200 줄게."
            MONEY:5 += 200
            イベントフラグ:34:2 ++
        ELSE
            CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "오답이야"
            CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "어택 중마의 「AP」와/아군 중마의 「HP」에 주목해 줘."
        ENDIF
        RETURN -2
    ENDIF
ELSEIF CS_TUTORIAL:0 == 103
    IF ARG == 99 && CBF_TURN == 1
        CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "「퀴즈 3」/어쨌든 가장 좋은 조합으로/블록해 보렴."
        CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "잘하면 다음 턴에 이길 수 있어./자, 힘내렴"
        CALL CS_BATTLE_MESSAGE_WINDOW_ICON, 0, "", , "", "이번 턴에 살아남아/다음 턴에 적 서머너를 격파하라."

        CALL CB_AI_SET, 3506
        CALL CB_AI_SET, 3507
        CALL CB_AI_SET, 3508
        CS_AI_STEP = 40
    ELSEIF CBF_TURN > 1
        L_SELECT = 0
        FOR L_COUNT, CBF_味方ポジション1, CBF_味方ポジション6 + 1
            SIF FIELD_DEMON_DATE_V:L_COUNT:CBV_CONDITION == 0
                L_SELECT += FIELD_DEMON_DATE_V:L_COUNT:CBV_AP
        NEXT
        IF L_SELECT > 5
            CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "정답이야/이것들로 지금 어택하면 이길 수 있지？"
            CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "자, Ð200 줄게."
            MONEY:5 += 200
            イベントフラグ:34:2 ++
        ELSE
            CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "오답이야"
            CALL CS_BATTLE_MESSAGE_WINDOW_ICON, E34_C_ICON_N("はなこ"), RESULTS, , "하나코", "당신과 나의 HP는 「6」/적과 아군의 「AP」로 누구를 누구로 블록할지 생각해 봐."
        ENDIF
        RETURN -2
    ENDIF
ENDIF