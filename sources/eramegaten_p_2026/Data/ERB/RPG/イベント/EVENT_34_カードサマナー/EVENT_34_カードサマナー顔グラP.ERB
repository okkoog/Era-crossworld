@CS_PORTRATE_SCRIPT, P_ID
#DIMS P_ID
#DIMS L_NAME
#DIMS L_SPRITE
SIF SPRITECREATED(P_ID)
	RETURN 1
LOCAL = STRFIND(P_ID, "_FACE")
IF LOCAL >= 1
	L_NAME = %SUBSTRING(P_ID, 0, LOCAL)%
	L_SPRITE = %SUBSTRING(P_ID, LOCAL + 1)%

	;PRINTFORML %L_NAME%    %L_SPRITE%
	CALLF GET_FACE_BY_CSV, GET_識別番号(L_NAME), L_SPRITE
	SIF SPRITECREATED(P_ID)
		RETURN 1
ENDIF
RETURN 0

