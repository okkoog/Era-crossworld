@E34_PLAYABLE_EVENT_CHARA
#DIM L_COUNT
#DIM L_CHARA_N

FOR L_COUNT, 0, 7
	L_CHARA_N = [[キャラ:미도리]] + L_COUNT
	IF キャラ存在確かめ(L_CHARA_N) || (GETCHARA(L_CHARA_N) < 0 && COUNT_SOLD_CHARA:L_CHARA_N < 1)
		SETBIT イベントフラグ:34:17,4 + L_COUNT
	ELSE
		CLEARBIT イベントフラグ:34:17,4 + L_COUNT
	ENDIF
NEXT



