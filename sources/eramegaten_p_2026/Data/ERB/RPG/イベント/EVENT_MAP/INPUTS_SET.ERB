;ARGS:0	アクション
;ARGS:1	セットする文字列(ARGS:0でセットをアクション宣言した場合のみ)
;ARG:0	選択肢の列数(ARGS:0で選択入力をアクション宣言した場合のみ)
;ARG:1	選択肢の文字数(ARGS:0で選択入力をアクション宣言した場合のみ)

@INPUTS_SET, ARGS = "", ARGS:1 = "", ARG:0 = 0, ARG:1 = 40
#DIMS L_SET
#DIMS L_SET2
#DIM L_COUNT
#DIMS L_RESULTS
#DIM L_MAX
#DIMS L_ACTION, 3
#DIM L_ACT
VARSET L_ACTION
L_ACT = 0
SPLIT ARGS, "_", L_ACTION
;L_ACTION:L_ACT

IF  L_ACTION:L_ACT == "CLEAR" || L_ACTION:L_ACT == "消去"
	VARSET L_SET
	VARSET L_SET2
	L_ACT++
ENDIF
IF L_ACTION:L_ACT == "SET" || L_ACTION:L_ACT == "セット"
	IF STRLENS(ARGS:1) > 0
		;SIF STRLENS(L_SET) > 0 && (SUBSTRING(ARGS:1, 0, 1) != "_" || SUBSTRING(ARGS:1, STRLENS(L_SET) - 1, 1) != "_")
		;	L_SET += "_"
		;L_SET += AUTO_SPLIT(ARGS:1 , "," , 0)
		SIF STRLENS(L_SET2) > 0 && (SUBSTRING(ARGS:1, 0, 1) != "_" || SUBSTRING(ARGS:1, STRLENS(L_SET2) - 1, 1) != "_")
			L_SET2 += "_"
		L_SET2 += ARGS:1
	ENDIF
	L_ACT++
ENDIF
IF L_ACTION:L_ACT == "INPUT" || L_ACTION:L_ACT == "入力" || L_ACTION:L_ACT == "INPUTV" || L_ACTION:L_ACT == "選択入力"
	FLAG:윈도우메시지스킵 = 0
	IF L_ACTION:L_ACT == "INPUTV" || L_ACTION:L_ACT == "選択入力"
		VARSET LOCALS
		L_MAX = STRCOUNT(L_SET2, "_") + 1
		SPLIT L_SET2, "_", LOCALS
		FOR L_COUNT, 0, L_MAX
			SIF L_COUNT > 0 && (ARG:0 < 2 || L_COUNT % ARG:0 == ARG:0 - 1)
				PRINTL
			L_RESULTS = [%AUTO_SPLIT(LOCALS:L_COUNT, ",", 0)%]%AUTO_SPLIT(LOCALS:L_COUNT, ",", 1)%
			PRINTBUTTON @"%L_RESULTS,ARG:1,LEFT%", AUTO_SPLIT(LOCALS:L_COUNT, ",", 0)
			
		NEXT
		PRINTL
	ENDIF
	
	VARSET L_SET
	VARSET LOCALS
	L_MAX = STRCOUNT(L_SET2, "_") + 1
	SPLIT L_SET2, "_", LOCALS
	FOR L_COUNT, 0, L_MAX
		IF LOCALS:L_COUNT != ""
			LOCALS:L_COUNT = %AUTO_SPLIT(LOCALS:L_COUNT , "," , 0)%
			L_SET += LOCALS:L_COUNT + " "
		ENDIF
	NEXT
	;SPLIT L_SET, "_", LOCALS
	
	IF STRLENS(L_SET) < 1
		INPUTS
	ELSE
		$INPUT_LOOP
		INPUTS
		;PRINTFORMW %RESULTS%
		L_RESULTS = %RESULTS%
		IF L_RESULTS == ""
			PRINTFORML 입력 가능한 문자열
			PRINTFORMW %L_SET%
			CLEARLINE 2
			GOTO INPUT_LOOP
		ENDIF
		FOR L_COUNT, 0, L_MAX
			IF LOCALS:L_COUNT == L_RESULTS
				RESULTS = %L_RESULTS%
				;AUTO_SPLIT(L_RESULTS , "," , 2)
				CLEARLINE 1
				RETURN
			ENDIF
		NEXT
		CLEARLINE 1
		GOTO INPUT_LOOP
	ENDIF
ENDIF








