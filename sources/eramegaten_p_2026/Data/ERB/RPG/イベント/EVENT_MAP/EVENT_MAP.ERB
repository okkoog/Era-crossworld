@EVENT_MAP, ARGS
#DIMS L_RESULTS

TRYCALLFORM EVENTMAP_START_%ARGS%

$LP
CALL INPUTS_SET, "CLEAR"
CALL EVENT_MAP_SET, "CLEAR"
CALL INPUTS_SET, "SET", "END"

CALL EVENT_MAP_SHOW, ARGS

CALL INPUTS_SET, "INPUT"
L_RESULTS '= RESULTS

IF L_RESULTS == "END"
	RETURN
ELSE
	TRYCALLFORM EVENTMAP_EVENT_%ARGS%, L_RESULTS
	SIF RESULT == -99
		RETURN
ENDIF

GOTO LP



@EVENT_MAP_SHOW, ARGS
;FLAG:커맨드표시행수 = LINECOUNT
PRINTSL GETLINESTR("=")
TRYCALLFORM EVENTMAP_UPPER_%ARGS%

TRYCALLFORM EVENTMAP_SET_%ARGS%
CALL EVENT_MAP_SET, "表示", , 18

PRINTSL GETLINESTR("=")
FLAG:커맨드표시행수 = LINECOUNT
TRYCALLFORM EVENTMAP_MENU_%ARGS%
PRINTSL GETLINESTR("=")
;FLAG:커맨드표시행수 = LINECOUNT



@EVENT_MAP_SET, L_ACTION, L_WRITE = "", YY = -1, XX = -1
#DIMS L_ACTION
#DIMS L_WRITE
#DIMS L_WRITING
#DIM YY
#DIM XX
#DIM MAX_Y
#DIM MAX_X
#DIM L_CLEAR
#DIM L_COUNT
#DIM L_COUNT2

#DIMS L_EVENT,3
#DIMS L_MAP_FLOOR,100
#DIMS L_MAP_EVENT,100
#DIMS L_MAP_COLOR,100
#DIMS L_MAP_CLICK,100


IF L_ACTION == "表示" || L_ACTION == "VIEW"
	
	ALIGNMENT CENTER
	IF YY > MAX_Y
		FOR L_COUNT , 0 , (YY - MAX_Y)/2
			PRINTL
		NEXT
	ENDIF
	CALL SET_PICTURE, , , "消去"
	FOR L_COUNT, 0, MAX_Y + 1
		CALL STR_OVERWRITE, L_MAP_FLOOR:L_COUNT, "", XX, MAX_X
		CALL SET_PICTURE , L_MAP_FLOOR:L_COUNT , L_COUNT , ,  0
		FOR L_COUNT2, 0, MAX_X, 2
			VARSET L_EVENT
			L_EVENT:0 '= SUBSTRING(L_MAP_EVENT:L_COUNT, L_COUNT2, 2)
			L_EVENT:1 '= SUBSTRING(L_MAP_COLOR:L_COUNT, L_COUNT2, 2)
			L_EVENT:2 '= SUBSTRING(L_MAP_CLICK:L_COUNT, L_COUNT2, 2)
			SIF STRLENS(L_EVENT:0) != 2 || L_EVENT:0 == "  " || L_EVENT:0 == "　"
				L_EVENT:0 =
			;SIF STRLENS(L_EVENT:1) != 2 || L_EVENT:1 == "  " || L_EVENT:1 == "　"
			;	L_EVENT:1 =
			L_EVENT:1 '= COLOR_2H(L_EVENT:1) > -1 ? TOSTR(COLOR_2H(L_EVENT:1)) # ""
			SIF STRLENS(L_EVENT:2) != 2 || L_EVENT:2 == "  " || L_EVENT:2 == "　"
				L_EVENT:2 =
			
			IF L_EVENT:0 != "" || L_EVENT:1 != "" || L_EVENT:2 != ""
				SIF L_EVENT:0 == ""
					L_EVENT:0 '= SUBSTRING(L_MAP_FLOOR:L_COUNT, L_COUNT2, 2)
				CALL SET_PICTURE , @"%L_EVENT:0%,%L_EVENT:1%,,%L_EVENT:2%", L_COUNT , ,  L_COUNT2

				SIF L_EVENT:2 != ""
					CALL INPUTS_SET, "SET", L_EVENT:2
			ENDIF
		NEXT
	NEXT
	CALL SET_PICTURE, , , "表示"
	IF YY > MAX_Y
		FOR L_COUNT , 0 , (YY - MAX_Y + 1)/2
			PRINTL
		NEXT
	ENDIF
	ALIGNMENT LEFT
	
	
	
	
ELSEIF L_ACTION == "床" || L_ACTION == "SET"
	SIF XX > -1
		XX *= 2
	SIF XX == -1
		XX = 0
	
	
	L_WRITING '= L_MAP_FLOOR:YY
	CALL STR_OVERWRITE, L_WRITING, L_WRITE, XX, MAX_X
	L_MAP_FLOOR:YY '= L_WRITING
	
	MAX_Y = (                     YY > MAX_Y ? YY # MAX_Y)
	MAX_X = (STRLENS(L_MAP_FLOOR:YY) > MAX_X ? STRLENS(L_MAP_FLOOR:YY) # MAX_X)
ELSEIF L_ACTION == "事" || L_ACTION == "EVENT"
	SIF XX > -1
		XX *= 2
	SIF XX == -1
		XX = 0
	VARSET L_EVENT
	SPLIT L_WRITE , "," , L_EVENT
	L_WRITING '= L_MAP_EVENT:YY
	CALL STR_OVERWRITE, L_WRITING, L_EVENT:0, XX
	L_MAP_EVENT:YY '= L_WRITING
	IF 0 < STRLENS(L_EVENT:0) && STRLENS(L_EVENT:0) < 3
		IF 0 < STRLENS(L_EVENT:1) && STRLENS(L_EVENT:1) < 3
			L_WRITING '= L_MAP_COLOR:YY
			CALL STR_OVERWRITE, L_WRITING, L_EVENT:1, XX
			L_MAP_COLOR:YY '= L_WRITING
		ENDIF
		IF 0 < STRLENS(L_EVENT:2) && STRLENS(L_EVENT:2) < 3
			L_WRITING '= L_MAP_CLICK:YY
			CALL STR_OVERWRITE, L_WRITING, L_EVENT:2, XX
			L_MAP_CLICK:YY '= L_WRITING
		ENDIF
	ENDIF
ELSEIF L_ACTION == "色" || L_ACTION == "COLOR"
	SIF XX > -1
		XX *= 2
	SIF XX == -1
		XX = 0
	;SIF 0 < STRLENS(L_WRITE) && STRLENS(L_WRITE) < 3
	L_WRITING '= L_MAP_COLOR:YY
	CALL STR_OVERWRITE, L_WRITING, L_WRITE, XX
	L_MAP_COLOR:YY '= L_WRITING
ELSEIF L_ACTION == "押" || L_ACTION == "CLICK"
	SIF XX > -1
		XX *= 2
	SIF XX == -1
		XX = 0
	;SIF 0 < STRLENS(L_WRITE) && STRLENS(L_WRITE) < 3
	L_WRITING '= L_MAP_CLICK:YY
	CALL STR_OVERWRITE, L_WRITING, L_WRITE, XX
	L_MAP_CLICK:YY '= L_WRITING
ELSEIF STRFIND(L_ACTION, "消去") >= 0 || STRFIND(L_ACTION, "CLEAR") >= 0
	L_CLEAR = 0
	SIF STRFIND(L_ACTION, "事") >= 0 || STRFIND(L_ACTION, "EVENT") >= 0
		SETBIT L_CLEAR, 0
	SIF STRFIND(L_ACTION, "色") >= 0 || STRFIND(L_ACTION, "COLOR") >= 0
		SETBIT L_CLEAR, 1
	SIF STRFIND(L_ACTION, "押") >= 0 || STRFIND(L_ACTION, "CLICK") >= 0
		SETBIT L_CLEAR, 2
	
	IF STRFIND(L_ACTION, "消去S") >= 0 || STRFIND(L_ACTION, "CLEAR_S") >= 0
		SIF YY == -1
			YY = 0
		SIF XX > -1
			XX *= 2
		SIF XX == -1
			XX = 0
		
		SIF L_CLEAR == 0
			CALL STR_OVERWRITE, L_MAP_FLOOR:YY, "  ", XX, MAX_X
		SIF L_CLEAR == 0 || GETBIT(L_CLEAR, 0)
			CALL STR_OVERWRITE, L_MAP_EVENT:YY, "  ", XX
		SIF L_CLEAR == 0 || GETBIT(L_CLEAR, 1)
			CALL STR_OVERWRITE, L_MAP_COLOR:YY, "  ", XX
		SIF L_CLEAR == 0 || GETBIT(L_CLEAR, 2)
			CALL STR_OVERWRITE, L_MAP_CLICK:YY, "  ", XX
	ELSE
		IF YY == -1 && XX == -1
			YY = 0
			XX = MAX_Y + 1
		ELSEIF YY > -1 && XX == -1
			XX = YY
		ENDIF
		
		SIF L_CLEAR == 0
			VARSET L_MAP_FLOOR, "", YY, XX
		SIF L_CLEAR == 0 || GETBIT(L_CLEAR, 0)
			VARSET L_MAP_EVENT, "", YY, XX
		SIF L_CLEAR == 0 || GETBIT(L_CLEAR, 1)
			VARSET L_MAP_COLOR, "", YY, XX
		SIF L_CLEAR == 0 || GETBIT(L_CLEAR, 2)
			VARSET L_MAP_CLICK, "", YY, XX
		SIF L_CLEAR == 0 && XX >= MAX_Y
			MAX_Y = YY
		SIF MAX_Y == 0
			MAX_X = 0
	ENDIF
ENDIF

@COLOR_2H, L_STR
#FUNCTION
#DIMS L_STR
IF 0
ELSEIF L_STR == "赤" || L_STR == "Re"
	RETURNF COLOR("赤")
ELSEIF L_STR == "青" || L_STR == "Bl"
	RETURNF 0x0000FF
ELSEIF L_STR == "黄" || L_STR == "Ye"
	RETURNF COLOR("黄色")
ELSEIF L_STR == "紫" || L_STR == "Pu"
	RETURNF COLOR("ショッキングピンク")
ELSEIF L_STR == "緑" || L_STR == "Gr"
	RETURNF 0x00FF00
ELSEIF L_STR == "橙" || L_STR == "Or"
	RETURNF 0xFFA500
ELSEIF L_STR == "茶" || L_STR == "Br"
	RETURNF 0xA52A2A
ELSEIF L_STR == "桃" || L_STR == "Pi"
	RETURNF 0xFF99FF
ELSEIF L_STR == "水" || L_STR == "Sk" || L_STR == "空"
	RETURNF COLOR("水色")
ELSEIF L_STR == "黒" || L_STR == "BL"
	RETURNF COLOR("黒")
ELSEIF L_STR == "灰" || L_STR == "GR"
	RETURNF COLOR("灰色")
ELSEIF L_STR == "白" || L_STR == "Wh"
	RETURNF COLOR("白")
ELSEIF L_STR == "デ" || L_STR == "DE"
	RETURNF GETDEFCOLOR()
ENDIF
RETURNF -1







@STR_OVERWRITE, L_STR, L_OWSTR = "", L_POSITION, L_MAX = -1
#DIMS REF L_STR
#DIMS L_OWSTR
#DIM L_POSITION
#DIM L_MAX
#DIMS L_PUTSTR,2

SIF STRLENS(L_STR) < L_POSITION
	L_STR += " " * (L_POSITION - STRLENS(L_STR))
SIF STRLENS(L_STR) < L_MAX
	L_STR += " " * (L_MAX - STRLENS(L_STR))

IF STRLENS(L_OWSTR) > 0
	L_PUTSTR:0 = %SUBSTRING(L_STR, 0 , L_POSITION)%
	L_PUTSTR:1 = %SUBSTRING(L_STR, L_POSITION + STRLENS(L_OWSTR), -1)%

	L_STR = %L_PUTSTR:0%%L_OWSTR%%L_PUTSTR:1%
ENDIF
