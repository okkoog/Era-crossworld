;特殊思考パターン
@SET_ACTION_ガラダブラ, ARG
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
;ワンモア（クリティカルか、弱点を突いた場合の行動）
IF CFLAG:ARG:１more플래그 > 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:메기도크로스]]
;最初は必ずメガトンプレスをぶっぱしてくる。対巨大ロボ戦のイメージ
ELSEIF CFLAG:ARG:행동한횟수 == 0
	CFLAG:ARG:입력행동 = [[스킬:메가톤프레스]]
ELSE
	IF RAND:3 == 0
		CFLAG:ARG:입력행동 = [[스킬:열풍격]]
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:산산조각베기]]
	ENDIF
ENDIF
;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;行動未決定時のおまじない
SIF CFLAG:ARG:입력행동 == -1
	CALL ランダム行動 , ARG
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1


