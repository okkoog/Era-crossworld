;====================
;条件
;ゲーム開始時点から選択可能
;====================
@GET_EVENT_NAME_43
#FUNCTIONS
RESULTS_F '= "퍼스널트루퍼"
RETURNF RESULTS_F

@PLAYABLE_EVENT_43
#LOCALSIZE 1
#LOCALSSIZE 1
	;PTのEXTRAがOFF
	IF !GETS_USEABLE_EXTRA_TITLE("スパロボ")
		RETURN 0
	ELSEIF イベントフラグ:43:0 == 0 && BASE:MASTER:LV > 9
		RESULTS = （EX:PT）환영의 유령
		イベントフラグ:43:9 = 1
		RETURN 1
	;Mr.K作成ルート
	ELSEIF イベントフラグ:43:1 == 0
		IF イベントフラグ:43:0 == 1 && (FLAG:조직공헌도 >= 100000 && BASE:MASTER:LV > 24)
			IF FINDCHARA_B([[キャラ:팬텀]]) > 0 && BASE:(RESULT:1):LV > 25
				RESULTS = （EX:PT）야음의 고철과 석양의 백기사
				イベントフラグ:43:9 = 2
				RETURN 1
			ENDIF
		ELSEIF イベントフラグ:43:0 == 2 && BASE:MASTER:LV > 34
			RESULTS = （EX:PT）크로스게이트에서 나타나는 자
			イベントフラグ:43:9 = 3
			RETURN 1
		ELSEIF イベントフラグ:43:0 == 3 && BASE:MASTER:LV > 34 && FINDCHARA_B([[キャラ:아벤트]]) > 0 && BASE:(RESULT:1):LV > 34
			RESULTS = （EX:PT）「무한의 프론티어 (그들이 태어난 세계)」
			イベントフラグ:43:9 = 4
			RETURN 1
		ELSEIF イベントフラグ:43:0 == 4 && BASE:MASTER:LV > 39
			RESULTS = （EX:PT）크로스게이트 조사 보고
			イベントフラグ:43:9 = 5
			RETURN 1
		ENDIF
	;別人追加ルート
	;※既に複数人の手が入ってるので勝手に全部消すのはやめてね！！！
	;ゲシュペンストがEF仕様で加入するなどムゲフロを意識したAルートに対し版権含むスパロボ本編を意識したルートとしてDCルートとする
	ELSEIF イベントフラグ:43:1 == 1
		IF イベントフラグ:43:0 == 1 && (FLAG:조직공헌도 >= 100000 && BASE:MASTER:LV > 24)
			IF FINDCHARA_B([[キャラ:팬텀]]) > 0 && BASE:(RESULT:1):LV > 25
				RESULTS = （EX:PT）시험 운용 데이터의 회수
				イベントフラグ:43:9 = 12
				RETURN 1
			ENDIF
		ELSEIF イベントフラグ:43:0 == 2
			RESULTS = （EX:eraten X 기동전사 건담）「데빌 슈트」
			イベントフラグ:43:9 = 13
			RETURN 1
		ELSEIF イベントフラグ:43:0 == 3
			RESULTS = （EX:로봇 걸즈 Z）싸워라!! 기계수 걸즈!?
			イベントフラグ:43:9 = 14
			RETURN 1
		ENDIF
	ENDIF
