;-----------------------------------------
;ファイルを指定してキャラクタを解凍する関数
;-----------------------------------------
@EVENT_110_AWAKE, FILE_TYPE
#DIM LCOUNT							;ループカウンタ
#DIM FILE_TYPE						;解凍するファイルのタイプ
#DIM CHARA_UNIQUE_NO_LIST, 200		;キャラクタの固有番号リスト(解凍するキャラクタに設定する)
#DIM CHARA_UNIQUE_NO_CNT			;用意したキャラクタの固有番号の数
#DIMS FILE_NAME						;解凍するファイル名
#DIM BUFFER_NO						;チェック処理の際に一時的に番号を格納するバッファー
#DIM SAVEDATE_ID					;セーブデータのID
#DIM SAVEDATE_ORBITING_ID			;セーブデータのID(現在の周回)
#DIM CHARA_CNT						;解凍するキャラの数　※1ファイルに複数キャラを設定する場合もあるため
#DIM CHARA_NO						;現在処理中のキャラクタ番号

;---------------------------------
;解凍するキャラクタを選択する
;---------------------------------
CALL EVENT_110_SELECT_AWAKE_CHARA, FILE_TYPE
FILE_NAME = %RESULTS%

;[1000]やめる の場合、終了
IF RESULT == -1
	PRINTFORML 그만두는 겐가. 그것도 좋을 테지.
	PRINTFORML
	RETURN 0
ENDIF

PRINTFORML 해동하는 것은 %FILE_NAME%로군? 잠깐 기다리거라!

;---------------------------------
;解凍前のチェック処理を行う(キャラ重複など)
;---------------------------------
CALL EVENT_110_AWAKE_CHECK, FILE_NAME, FILE_TYPE
IF RESULT == 0
	RETURN 0
ENDIF

;---------------------------------
;解凍するファイルのメモ情報を取得する
;---------------------------------
;解凍するキャラクタのメモ情報を取得する
CALL EVENT_110_READ_FILE_MEMO, FILE_NAME
CHARA_CNT = EVENT110_ARRAY_FILE_MEMO:1
SAVEDATE_ID = EVENT110_ARRAY_FILE_MEMO:3
SAVEDATE_ORBITING_ID = EVENT110_ARRAY_FILE_MEMO:4

;------------------------------
;新しい「キャラ固有番号」の取得
;および「個人識別ID」重複チェック
;------------------------------
CHARA_UNIQUE_NO_CNT = 0
FOR LCOUNT, 0, MAX_PLAYER_CHARA
	IF !CMATCH(CFLAG:캐릭터고유번호, LCOUNT)
		;新規のキャラクタの固有番号を取得する
		CHARA_UNIQUE_NO_LIST:CHARA_UNIQUE_NO_CNT = LCOUNT
		CHARA_UNIQUE_NO_CNT ++

		;解凍するキャラクタの数だけキャラ固有番号を用意できた場合、終了
		IF CHARA_UNIQUE_NO_CNT >= CHARA_CNT
			BREAK
		ENDIF
	ENDIF
NEXT

;------------------------------
;キャラクタ解凍処理
;------------------------------
;データファイルを読み込む
LOADCHARA FILE_NAME

;「キャラ固有番号」の設定など
FOR LCOUNT, 0, CHARA_CNT
	;「キャラ固有番号」の設定
	CHARA_NO = CHARANUM - (CHARA_CNT - LCOUNT)
	CFLAG:CHARA_NO:캐릭터고유번호 = CHARA_UNIQUE_NO_LIST:LCOUNT
	;「매각불가플래그」の設定
	CFLAG:CHARA_NO:매각불가플래그 = 1
	;他のセーブデータまたは他の周回からの引継ぎの場合、「인계플래그」「인계횟수」を設定する
	IF SAVEDATE_ID != EVENT110_SAVEDATE_ID || SAVEDATE_ORBITING_ID != EVENT110_SAVEDATE_ORBITING_ID
		CFLAG:CHARA_NO:인계플래그 = 1
		CFLAG:CHARA_NO:인계횟수   = CFLAG:CHARA_NO:인계횟수 + 1
	ENDIF
NEXT

;解凍の残り回数処理
IF FILE_TYPE == EVENT110_CONST_FILE_TYPE_NORMAL
	;通常の冬眠ファイルの場合、他のセーブデータもしくは他の周回からキャラクタデータを持ち越した場合は残り回数を-1する
	IF SAVEDATE_ID != EVENT110_SAVEDATE_ID || SAVEDATE_ORBITING_ID != EVENT110_SAVEDATE_ORBITING_ID
		EVENT110_ZAN_THAW_CNT = EVENT110_ZAN_THAW_CNT - 1
	ENDIF
ENDIF

;---- EDIT 2024/05/24 START -------------------------
;---- EDIT 2024/06/03 START -------------------------
CALL VERUP_CHANGE_CSVNO, CHARA_NO
CALL CHECK_EXIST_CSV_FOR_CHARA, CHARA_NO
;---- EDIT 2024/06/03 START -------------------------
CALL VERUP_FOR_CHARA, CHARA_NO
CFLAG:CHARA_NO:본체버전정보 = GAMEBASE_VERSION
CFLAG:CHARA_NO:본체버전관리보조정보 = FLAG:버전관리보조
;---- EDIT 2024/05/24 END ---------------------------
;------------------------------
;最後にセリフを表示
;------------------------------
PRINTFORML 좋은 아침이네. 데리러 와 주었으니, 힘내보렴!
PRINTFORMW 또 잠들고 싶어지면 언제라도 오면 된다네.

;処理を終了する
RETURN


