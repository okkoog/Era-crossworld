;---------------------------------
;冬眠対象のキャラクタを選択する関数
;---------------------------------
@EVENT_110_SELECT_COLD_SLEEP_CHARA, CHARA_SELECT_MAX_CNT
#DIM LCOUNT					;ループカウンタ
#DIM LCOUNT2				;ループカウンタ
#DIM TARGET_CNT				;冬眠可能なキャラクタの数
#DIM CHARA_LIST, 1000, 2	;冬眠可能な全てのキャラクタのキャラ番号リスト。一応上限は1000人としておく。第二添え字は(0:キャラ番号 / 1:現在選択中であるか)
#DIM PAGE_NO				;ページ番号。冬眠可能なキャラクタが多い場合はページ分けして表示する。この現在ページの管理に使用する
#DIM CHARA_SELECT_CNT		;選択しているキャラクタ数
#DIM CHARA_SELECT_MAX_CNT	;キャラクタの選択数上限
#DIMS CHARA_STATE			;キャラクタの選択状態(未選択 / 選択)

PAGE_NO = 0
VARSET CHARA_LIST, -1
TARGET_CNT = 0
CHARA_SELECT_CNT = 0
VARSET EVENT110_ARRAY_SELECT_CHARA_NO_LIST, 0
LCOUNT = 0
LCOUNT2 = 0

FOR LCOUNT, 0, CHARANUM
    ;この場にいないキャラクタは対象外
    SIF CFLAG:LCOUNT:이자리에없는플래그
        CONTINUE
	;リンク先指定など特殊な条件がかむので排除
	SIF CFLAG:LCOUNT:전투이외불능
		CONTINUE
    ;@は対象外
	SIF LCOUNT == MASTER
		CONTINUE
	;식노/マントラは処理が独特なため、念のために対象外とする。(喰奴が好きな人は、ごめんね！)
	SIF TALENT:LCOUNT:식노== 1
		CONTINUE
	;人修羅も処理が独特なため、念のために対象外とする。(人修羅が好きな人は、ごめんね！)
	SIF TALENT:LCOUNT:인수라== 1
		CONTINUE
	IF CFLAG:LCOUNT:인계횟수 == 0
		;キャラクター個別の条件があるかを見る
		RESULT = -1
		TRYCALLFORM SELECT_YOME_{NO:LCOUNT}, LCOUNT
		SIF RESULT == 0
			CONTINUE
		SIF 陥落(LCOUNT) < 3
			CONTINUE
    ENDIF
	CHARA_LIST:TARGET_CNT:0 = LCOUNT	;選択可能なキャラの番号を保存
	CHARA_LIST:TARGET_CNT:1 = 0			;現在の選択状態を(0:未選択)に設定する
	TARGET_CNT += 1
NEXT

$PRINT_LIST

PRINTFORML 동면시킬 캐릭터를 골라주십시오(현재 {CHARA_SELECT_CNT} / {CHARA_SELECT_MAX_CNT})　＜page.{PAGE_NO + 1}＞
DRAWLINE

FOR LCOUNT, PAGE_NO * リスト表示数(), (PAGE_NO + 1) * リスト表示数()
	IF CHARA_LIST:LCOUNT:0 > -1
		;キャラクタの選択状態を取得する
		IF CHARA_LIST:LCOUNT:1 == 0
			CHARA_STATE = 미선택
		ELSE
			CHARA_STATE = 선택완료
		ENDIF
        PRINTFORML [{LCOUNT,3,RIGHT}] %CALLNAME:(CHARA_LIST:LCOUNT:0),30, LEFT%%CHARA_STATE%
	ENDIF
NEXT

DRAWLINE
PRINTFORMLC \@(PAGE_NO <= 0) ? %" " * 16% # [1007]이전페이지\@
PRINTFORMLC %" " * 5% [1001] 동면 캐릭터를 결정한다
PRINTFORMLC %" " * 5% [1000] 그만둔다
PRINTFORMLC \@(PAGE_NO >= (TARGET_CNT - 1) / リスト表示数()) ? %" " * 16% # [1009]다음페이지\@

$INPUT_LOOP_1
INPUT
IF RESULT == 1000
	RETURN 0

ELSEIF RESULT == 1001
	IF CHARA_SELECT_CNT == 0
		PRINTFORML 캐릭터가 선택되지 않았습니다.
		GOTO INPUT_LOOP_1
	ENDIF

	;選択されているキャラクタをリストにセットする
	FOR LCOUNT, 0, TARGET_CNT
		IF CHARA_LIST:LCOUNT:1 == 1
			EVENT110_ARRAY_SELECT_CHARA_NO_LIST:LCOUNT2 = CHARA_LIST:LCOUNT:0
			LCOUNT2 ++
		ENDIF
	NEXT

	RETURN CHARA_SELECT_CNT

ELSEIF RESULT == 1007
	IF PAGE_NO > 0
	PAGE_NO -= 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT == 1009
	IF PAGE_NO < (TARGET_CNT - 1) / リスト表示数()
	PAGE_NO += 1
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT < 0 || RESULT >= CHARANUM || RESULT > TARGET_CNT
	GOTO INPUT_LOOP_1
ENDIF

;選択したキャラクタの選択状態を変更する
IF CHARA_LIST:RESULT:1 == 0
	;未選択→選択
	IF CHARA_SELECT_CNT >= CHARA_SELECT_MAX_CNT
		;既に選択上限の場合
		PRINTFORML 이미 캐릭터 선택 수가 상한입니다.
		PRINTFORML 
	ELSE
		;選択上限ではない場合
		CHARA_LIST:RESULT:1 = 1
		CHARA_SELECT_CNT ++
	ENDIF
ELSE
	;選択→未選択
	CHARA_LIST:RESULT:1 = 0
	CHARA_SELECT_CNT --
ENDIF

;選択画面に戻る
GOTO PRINT_LIST

;あり得ないですがもしここまで進んでしまった場合は返り値0(キャンセル)で終了
RETURN 0


;---------------------------------
;解凍するファイルを選択する関数
;---------------------------------
@EVENT_110_SELECT_AWAKE_CHARA, FILE_TYPE
#LOCALSIZE  1
#LOCALSSIZE 1

#DIM LCOUNT					;ループカウンタ
#DIM FILE_CNT				;冬眠しているキャラクタファイルの数(今回の解凍対象ではないファイルも計上される)
#DIM FILE_NO				;今回の解凍対象となるファイルのそれぞれの番号
#DIMS FILE_LIST, 1000		;冬眠しているキャラクタのファイル名のリスト
#DIMS RTN_FILE_NAME			;選択した解凍ファイル名
#DIM FILE_TYPE				;解凍する候補となるファイルの種類
#DIMS FILE_NAME_BUH			;ファイル名を一時的に格納するバッファー

;--------------------------------
;解凍するキャラクタの選択
;--------------------------------
RTN_FILE_NAME = "NOTHING"

;冬眠しているファイルのリストを取得する
FIND_CHARADATA
FILE_CNT = RESULT

PRINTFORML 누구를 해동하겠는가?
DRAWLINE
FILE_NO = 0
WHILE 1
	;解凍対象キャラクタを選択
	FOR LCOUNT, 0, FILE_CNT
		;ファイル名をバッファーに保存する　※メモ情報取得時に「RESULTS」が上書きされてしまうため
		FILE_NAME_BUH = %RESULTS:LCOUNT%
		;ファイルのメモ情報を取得する
		CALL EVENT_110_READ_FILE_MEMO, FILE_NAME_BUH
		;引数の「ファイルの種類」と合致するもののみリストに表示する
		IF EVENT110_ARRAY_FILE_MEMO:0 == FILE_TYPE
			FILE_LIST:FILE_NO = %FILE_NAME_BUH%
			PRINTFORML {FILE_NO}：%FILE_LIST:FILE_NO%
			FILE_NO ++
		ENDIF
	NEXT

	DRAWLINE
	PRINTFORML [1000]그만둔다
	$INPUT_LOOP_SELECT_AWAKE_CHARA
	INPUT

	IF 0 <= RESULT && RESULT <= FILE_CNT - 1
		;-----------------------------
		;解凍キャラを正しく選択した場合
		;-----------------------------
		RTN_FILE_NAME = %FILE_LIST:RESULT%
		BREAK

	ELSEIF RESULT == 1000
		;-----------------------------
		;[1000]やめる
		;-----------------------------
		RETURN -1

	ELSE
		;-----------------------------
		;入力ミスのためやり直し
		;-----------------------------
		GOTO INPUT_LOOP_SELECT_AWAKE_CHARA

	ENDIF
WEND

RESULTS = %RTN_FILE_NAME%

;---------------------------------
;キャラクタの重複チェック関数
;---------------------------------
@EVENT_110_CHECK_DUPLICATION, CSV_NO,　CHARA_UNIQUE_ID
#DIM LCOUNT				;ループカウンタ
#DIM CSV_NO       		;対象となるキャラクタのCSV番号
#DIM CHARA_UNIQUE_ID   	;キャラクタの個人識別ID　※加入時のミリセカンドを利用したID。同じCSV番号のキャラでも加入するたびに別のIDとなる。
#DIM BUFFER_NO			;チェック処理の際に一時的に番号を格納するバッファー

;同じ「個人識別ID」のキャラクタがすでに存在しないかチェックする
;------------------------------
;「個人識別ID」重複チェック
;悪魔などの重複可能キャラでも、まったく同一のキャラの複製はここではじく
;------------------------------
FOR LCOUNT, 0, CHARANUM
	BUFFER_NO = CFLAG:LCOUNT:실제가입시간
	;「個人識別ID」が重複している場合、エラー
	IF CHARA_UNIQUE_ID == BUFFER_NO
		RETURN 0
	ENDIF
NEXT

;------------------------------
;重複不可キャラのチェック
;※人間のユニークキャラなど
;------------------------------
IF GETCHARA(CSV_NO) > -1
	IF (CSVABL(CSV_NO,GETNUM(ABL,"종족"),0) == 0 && CSVCFLAG(CSV_NO,GETNUM(CFLAG,"복수생성가능"),0) != 1)
		;重複あり
		RETURN 0
	;一体のみフラグで制限されている場合
	ELSEIF CSVCFLAG(CSV_NO,GETNUM(CFLAG,"１체만"),0) > 0
		;重複あり
		RETURN 0
	ENDIF
ENDIF

;重複無し	
RETURN 1

