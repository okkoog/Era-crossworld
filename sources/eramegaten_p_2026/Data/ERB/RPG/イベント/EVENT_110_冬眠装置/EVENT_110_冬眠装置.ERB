;---------------------------------------------------------------------------------------------------------------------------------
;이벤트「동면장치」
;---------------------------------------------------------------------------------------------------------------------------------
;更新日時       更新者                  更新内容
;2024/05/07     ロッド@カヤノソト	    ファイルを新規作成
;2024/05/13     ロッド@カヤノソト	    複数のキャラを1ファイルにまとめて出力するモードを作成
;2024/05/24     P(bazzile)			   出力したキャラに対して互換処理をかけるように変更
;2024/06/03     P(bazzile)			   NOの入れ替え処理を先に行うようにしたので処理を追加
;---------------------------------------------------------------------------------------------------------------------------------
;主な機能は以下の通り
;	冬眠：キャラクタデータをファイル出力する。その後、該当キャラクタはゲームデータから削除する
;	解凍：ファイルを読み込んでキャラクタを復活させる
;---------------------------------------------------------------------------------------------------------------------------------

;====================
;条件
;====================
@GET_EVENT_NAME_110
#FUNCTIONS
RESULTS_F '= "동면장치"
RETURNF RESULTS_F

@PLAYABLE_EVENT_110
;エンディング発見数が5以上、かつダンジョン「에코빌딩」クリアで解放
IF COUNT_ENDING_POINT() >= 5 && ダンジョンフラグ:1:1 == 1
	RESULTS = 동면장치
	RETURN 1
ENDIF

RETURN 0

;====================
;内容
;====================
@SHOPCOM_EVENT_110

;初期化されていない場合、周回時同様に初期化処理を行う　※想定としては1周目の場合、および当イベントが実装された直後など
IF EVENT110_SAVEDATE_ID == 0
	CALL EVENT_110_INIT
ENDIF

PRINTFORML 잘 왔네, 젊은이. 여기는 인공동면을 행하는 시설일세.
PRINTFORML 세계 마지막 순간은 가까웠어.
PRINTFORML 다가올 대붕괴에 맞설 힘과 용기가 없다면, 여기서 잠드는 것도 좋을 테지.
PRINTFORML 안심해도 좋아. 설령 세계의 멸망과 재생이 몇 번을 반복되든 편안히 계속 잠들 것을 약속해 주마.
PRINTFORML 다만... 모든 것이 끝난 후에 깨워줄 왕자님이 있을지 어떨지는, 뭐 그 사람에게 달렸지만 말이야.
PRINTFORML 
PRINTFORML 그래, 용건은 동면과 해동 중 어느 쪽인가?
IF DAY > 50 || FLAG:게임모드 == 9
	PRINTFORML 
	PRINTFORML ※무제한 모드：다른 주회나 세이브 데이터에서 동면한 캐릭터의 해동 제한이 해제되어 있습니다.
	PRINTFORML 　(50일 경과 또는 엔들리스 모드 돌입 중)
ELSE
	PRINTFORML 
	PRINTFORML ※제한 모드：다른 주회나 세이브 데이터에서 동면한 캐릭터의 해동이 제한되어 있습니다.
	PRINTFORML 　(50일 경과 또는 엔들리스 모드 돌입 시 제한 해제)
ENDIF
DRAWLINE

WHILE 1
	;--------------------------------
	;冬眠/解凍のどちらを行うか選択する
	;--------------------------------
	PRINTFORML [  0]동면한다
	PRINTFORML [  1]여러 명의 그룹으로 함께 동면한다

	IF DAY > 50 || FLAG:게임모드 == 9
		PRINTFORML [  2]해동한다
		PRINTFORML [  3]여러 명의 그룹을 해동한다

	ELSEIF EVENT110_ZAN_THAW_CNT > 0
		PRINTFORML [  2]해동한다　　　　　　　　　　　　　　※다른 세이브, 주회에서 동면한 캐릭터는 해동 횟수 제한 있음. 남은 횟수 {EVENT110_ZAN_THAW_CNT}회
		PRINTFORML [  3]여러 명의 그룹을 해동한다　　　　　※다른 세이브, 주회에서 동면한 캐릭터는 현재 해동 불가.
	ELSE
		PRINTFORML [  2]해동한다　　　　　　　　　　　　　　※다른 세이브, 주회에서 동면한 캐릭터는 현재 해동 불가.
		PRINTFORML [  3]여러 명의 그룹을 해동한다　　　　　※다른 세이브, 주회에서 동면한 캐릭터는 현재 해동 불가.
	ENDIF
	PRINTFORML [ 99]설명
	PRINTFORML [100]그만둔다
	DRAWLINE
	$INPUT_LOOP_SLEEP_OR_AWAKE
	INPUT
	IF RESULT == 0
		;----------------
		;[  0]冬眠する
		;----------------
		PRINTFORML 잠들 텐가. 아아, 좋고말고.
		PRINTFORML 앞을 바라보며 살아가기에는, 조금 너무 괴로운 시대니까 말이지.
		PRINTFORML 

		;キャラクタを選択して冬眠させる
		CALL EVENT_110_COLD_SLEEP, EVENT110_CONST_FILE_TYPE_NORMAL

	ELSEIF RESULT == 1
		;----------------
		;[  1]数名のグループで一緒に冬眠する
		;----------------
		PRINTFORML 다 함께 잠들고 싶은 게로군. 좋은 선택이야.
		PRINTFORML 동면 중에 뿔뿔이 흩어져 눈을 떴을 때 외톨이가 되는, 그런 일은 없을 테니 말이지.
		PRINTFORML 다만 집단이라면 무리한 장기 보존은 불가능해. 반드시 이번 주회 중에 해동하도록 해.
		PRINTFORML 

		;キャラクタを選択して冬眠させる
		CALL EVENT_110_COLD_SLEEP, EVENT110_CONST_FILE_TYPE_GROUP

	ELSEIF RESULT == 2
		;----------------
		;[  2]解凍する
		;----------------
		PRINTFORML 동료마를 깨우러 왔는가. 자네도 참 모진 녀석이구먼.
		PRINTFORML 기껏 잠들어 있던 녀석들을 이런 지옥으로 끌어내려 하다니 말이야.
		PRINTFORML 

		;キャラクタを選択して解凍する
		CALL EVENT_110_AWAKE, EVENT110_CONST_FILE_TYPE_NORMAL

	ELSEIF RESULT == 3
		;----------------
		;[  3]複数名のグループを解凍する
		;----------------
		PRINTFORML 동료마를 깨우러 왔는가. 자네도 참 모진 녀석이구먼.
		PRINTFORML 기껏 잠들어 있던 녀석들을 이런 지옥으로 끌어내려 하다니 말이야.
		PRINTFORML 

		;キャラクタを選択して解凍する
		CALL EVENT_110_AWAKE, EVENT110_CONST_FILE_TYPE_GROUP

	ELSEIF RESULT == 99
		;----------------
		;[ 99]설명
		;----------------
		PRINTFORML 여기서는 싸움에 지친 인간이나 악마를 데이터화시켜 동면시키고 있어.
		PRINTFORML 폭풍이 지나갈 때까지 몇백 년, 몇천 년이라도 편히 잠들게 해주고말고.
		PRINTFORML 동면시킨 동료마는 「\\eraten\\Data\\dat」 폴더 안에 「xxxx.dat」라는 형식으로 보존되는 거지.
		PRINTFORML 장비나 페르소나를 해제하는 것은 이쪽에서 알아서 해둘 테니 안심하렴!
		PRINTFORML 
		PRINTFORML 동면시킨 동료마는 이 시설에서 언제라도 해동할 수 있다는 계산이야.
		PRINTFORML 다만 레벨은 초기화되니, 확실하게 다시 단련시켜 주도록 해.
		PRINTFORML 
		PRINTFORML ...아아, 덧붙여서 데이터화한 동료마를 다른 사람과 주고받는 것도 가능하다네.
		PRINTFORML 주고받아지는 본인 입장에서 보면, 눈을 떴더니 이세계에 와 있었다! 가 되는 셈이지.
		PRINTFORML 어떻게 하냐고? 전자 파일 주고받기 정도는 스스로 알아서 해!
		PRINTFORML 이 늙은이보다 요즘 서머너들이 더 능숙할 것 아닌가? 전자 기기란 녀석은 말이야!
		PRINTFORMW 
		DRAWLINE
		PRINTFORML ※주의! 동면 중인 캐릭터의 해동에는 제한이 있습니다.
		PRINTFORML 같은 세이브 데이터・같은 주회에서 동면한 캐릭터는 무제한으로 해동 가능.
		PRINTFORML 
		PRINTFORML 다른 주회나 다른 세이브 데이터에서 동면한 캐릭터의 경우는 다음과 같습니다:
		PRINTFORML 　・통상 동면의 경우　　　　　　　　　：해동 횟수 제한 있음 (1회 주회당 3회까지)
		PRINTFORML 　・복수 캐릭터를 한꺼번에 동면한 경우：해동 불가
		PRINTFORML 
		PRINTFORML 다만 50일을 경과하면 어느 쪽의 경우든 해동 제한이 해제됩니다.
		PRINTFORML 
		PRINTFORML ※주의! 해동한 캐릭터는 매각 불가입니다.
		PRINTFORML 같은 동면 파일에서 몇 번이라도 해동할 수 있는 사양이므로, 무한 골드/자원 벌기 방지를 위한 처리입니다.
		PRINTFORML 
		PRINTFORML ※주의! 페르소나 구사자를 동면→해동하면 스킬을 전부 잊어버립니다.
		PRINTFORML 또한, 페르소나 구사자는 사양이 복잡하므로 가급적 동면시키지 않는 편이 좋을지도 모릅니다.
		PRINTFORML (최대한 테스트는 거쳤으나 다소 불안한 점이 있습니다. 양해 부탁드립니다.)
		PRINTFORML 
		PRINTFORML ※주의! 식노는 동면할 수 없습니다.
		PRINTFORML (처리가 독특하여, 고려 누락으로 버그가 발생하는 것을 방지하기 위해 제외했습니다. 양해 부탁드립니다.)
		PRINTFORMW 

	ELSEIF RESULT == 100
		;----------------
		;[100]그만둔다
		;----------------
		PRINTFORML 그만두는 겐가. 그것도 좋을 테지.
		PRINTFORML 다가오는 위기에 맞서 싸워보는 것도 좋겠지. 살아간다는 건 그런 것이니 말이야.
		PRINTFORML 
		BREAK;

	ELSE
		;入力ミスのためやり直し
		GOTO INPUT_LOOP_SLEEP_OR_AWAKE
	ENDIF

	DRAWLINE
	PRINTFORML 아직 볼일이 남았는가?
WEND

;----------------------------------
;キャラクタを選択して冬眠させる関数
;----------------------------------
@EVENT_110_COLD_SLEEP, FILE_TYPE
#DIM LCOUNT					;ループカウンタ
#DIM LCOUNT2				;ループカウンタ
#DIM FILE_TYPE				;作成するファイルのタイプ
#DIM CHARA_SELECT_CNT       ;選択された冬眠キャラクタ数
#DIMS FILE_NAME				;保存するファイル名
#DIM CHARA_NO				;キャラクタ番号
#DIMS POSITION_NO			;ポジション番号
#DIM CHARA_SELECT_MAX_CNT	;キャラクタの選択数上限
#DIM FLG_PERSONA_CHECKED	;ペルソナ使いを冬眠させる場合の確認メッセージを表示済みであるか　※複数のペルソナ使いを一度に冬眠させる場合に何度も確認メッセージが表示されるのは邪魔なため、一度限りにする

;冬眠モードごとにキャラクタの最大選択数を設定する
SELECTCASE FILE_TYPE
	CASE EVENT110_CONST_FILE_TYPE_NORMAL
		;通常の冬眠の場合
		CHARA_SELECT_MAX_CNT = 1
	CASE EVENT110_CONST_FILE_TYPE_GROUP
		;まとめて1ファイルに冬眠の場合
		CHARA_SELECT_MAX_CNT = 50
ENDSELECT

;冬眠させるキャラクタを選択する
CALL EVENT_110_SELECT_COLD_SLEEP_CHARA, CHARA_SELECT_MAX_CNT

;[1000]やめる　を選択した場合は終了
IF RESULT == 0
    RETURN
ENDIF
CHARA_SELECT_CNT = RESULT

;メモ情報作成用の配列を初期化する
VARSET EVENT110_ARRAY_FILE_MEMO, 0
VARSET EVENT110_ARRAY_FILE_MEMO_DETAIL, 0

;冬眠ファイルのメモ情報(基本)を作成する
EVENT110_ARRAY_FILE_MEMO:0 = FILE_TYPE											;ファイルタイプ
EVENT110_ARRAY_FILE_MEMO:1 = CHARA_SELECT_CNT									;冬眠キャラクタ数
EVENT110_ARRAY_FILE_MEMO:2 = LASTLOAD_VERSION									;冬眠ファイル作成時のゲームバージョン　※古いバージョンで作成した冬眠ファイルを解凍する場合は警告を行う
EVENT110_ARRAY_FILE_MEMO:3 = EVENT110_SAVEDATE_ID								;冬眠時のセーブデータのユニークID　※セーブデータ自体と周回でそれぞれIDを付ける
EVENT110_ARRAY_FILE_MEMO:4 = EVENT110_SAVEDATE_ORBITING_ID						;冬眠時のセーブデータの現周回のユニークID　※セーブデータ自体と周回でそれぞれIDを付ける

;ペルソナ使いを冬眠させる場合の確認メッセージ表示済みフラグを初期化する
FLG_PERSONA_CHECKED = 0

;キャラクタ毎に処理を行う
FOR LCOUNT, 0, CHARA_SELECT_CNT
	;キャラクタ情報を取得する
	CHARA_NO = EVENT110_ARRAY_SELECT_CHARA_NO_LIST:LCOUNT						;キャラクタ番号
	
	;冬眠ファイルのメモ情報(キャラごとの詳細)を作成する
	EVENT110_ARRAY_FILE_MEMO_DETAIL:LCOUNT:0 = NO:CHARA_NO						;冬眠キャラのCSV番号
	EVENT110_ARRAY_FILE_MEMO_DETAIL:LCOUNT:1 = CFLAG:CHARA_NO:실제가입시간	 ;冬眠キャラのユニーク番号　※キャラ加入時点のミリセカンドで設定される
	EVENT110_ARRAY_FILE_MEMO_DETAIL:LCOUNT:2 = CHARA_NO							;冬眠キャラのセーブデータ内でのキャラクタ番号

	;キャラクタ初期化
	CALL EVENT_110_CARA_INIT, CHARA_NO

	;ペルソナ使いの場合の処理を行う
	IF TALENT:CHARA_NO:페르소나구사자
		IF FLG_PERSONA_CHECKED == 0
			DRAWLINE
			PRINTFORML 페르소나 구사자는 동면하면 스킬을 전부 잊어버립니다.
			PRINTFORML 또한, 사양이 복잡하므로 동면→해동 처리에 다소 불안한 점이 있습니다.
			PRINTFORML 동면시키겠습니까?
			PRINTFORML 
			WHILE 1
				PRINTFORML [  0]동면한다
				PRINTFORML [100]그만둔다
				DRAWLINE
			$INPUT_LOOP_PERSONA_SLEEP_CHECK
				INPUT
				IF RESULT == 0
					;-----------------
					;[  0]동면한다
					;-----------------
					BREAK
				ELSEIF RESULT == 100
					;-----------------
					;[100]그만둔다
					;-----------------
					RETURN 0
				ELSE
					;-----------------
					;入力ミスのためやり直し
					;-----------------
					GOTO INPUT_LOOP_PERSONA_SLEEP_CHECK
				ENDIF
			WEND

			;ペルソナ使いを冬眠させる場合の確認メッセージ表示済みフラグを1(確認済み)にする
			FLG_PERSONA_CHECKED = 1
		ENDIF

		;ゲームデータ側のペルソナ情報を処理する　※キャラ削除と同じ処理ですが、キャラデータ出力前に行う必要あり
		FOR LCOUNT2, 1, 4
			LOCALS = 소지페르소나{LCOUNT2}
			IF EQUIP:CHARA_NO:LOCALS
				DITEMTYPE:(EQUIP:CHARA_NO:LOCALS):페르소나("装備状態") = 1
				DITEMTYPE:(EQUIP:CHARA_NO:LOCALS):페르소나("ペルソナ所持者") = -1
			ENDIF
		NEXT
		IF CFLAG:CHARA_NO:초기페르소나넘버
			FOR LCOUNT2, 0, 50
				DITEMTYPE:(CFLAG:CHARA_NO:초기페르소나넘버):LCOUNT2 = 0
			NEXT
		ENDIF

		;キャラデータ側の初期ペルソナナンバーをリセットする　※ペルソナ使いを解凍した際に、相手側のデータと矛盾しないようにするため。
		CFLAG:CHARA_NO:초기페르소나넘버 = 0

		;所持ペルソナをすべて外す
		WHILE EQUIP:CHARA_NO:소지페르소나1 != 0
			CALL PERSONA_UNEQUIPMENT(CHARA_NO, EQUIP:CHARA_NO:(GETNUM(EQUIP, "소지페르소나1")))
		WEND
	ENDIF

	;デビルシフターの場合、リンク解除する
	IF TALENT:CHARA_NO:데빌시프터 == 1
		CALL REMOVE_LINK_DEVIL, CHARA_NO
	ENDIF

	;PTに存在する場合、PTから外す
	FOR LCOUNT2, 1, 7
		POSITION_NO = 포지션{LCOUNT2}
		IF FLAG:POSITION_NO == CHARA_NO
			CALL REMOVE_POSITION, LCOUNT2
		ENDIF
	NEXT

	;「Cdflag」を初期化する　※「캐릭터간호감도」等の初期化のため。
	VARSET CDFLAG:CHARA_NO:0:0, 0

	;妊娠周りのフラグをクリアする
	CALL CLEAR_PREGNANCY_FLAG(CHARA_NO)

	;父親は不明とする　※冬眠キャラのデータを他の人に渡す可能性を考慮する
	CFLAG:CHARA_NO:딸의친부모고유번호딸 = -1
	CFLAG:CHARA_NO:딸의부친고유번호딸 = -1
	CFLAG:CHARA_NO:부친의고유번호부모 = -1
	CFLAG:CHARA_NO:부친실종 = 1
NEXT

;作成するファイル名を指定する　※キャラクタのCSV上の名前とする
SELECTCASE FILE_TYPE
	CASE EVENT110_CONST_FILE_TYPE_NORMAL
		;通常の冬眠の場合
		FILE_NAME = %CSVCALLNAME(EVENT110_ARRAY_FILE_MEMO_DETAIL:0:0)%
	CASE EVENT110_CONST_FILE_TYPE_GROUP
		;まとめて1ファイルに冬眠の場合
		FILE_NAME = %CSVCALLNAME(EVENT110_ARRAY_FILE_MEMO_DETAIL:0:0)%_御一行様_計{CHARA_SELECT_CNT}名
ENDSELECT

;キャラクタデータをファイル出力する　※キャラクタのCSV番号と個人識別IDを第二引数(メモ)として保存する。解凍時にキャラ重複チェックに使用するため
CALL EVENT_110_CREATE_COLD_SLEEP_FILE, FILE_NAME

;キャラクタ削除
FOR LCOUNT, 0, CHARA_SELECT_CNT
	;キャラクタ情報を取得する
	;※キャラクタを削除する度にキャラ番号が1つ前にずれることを考慮のこと
	CHARA_NO = EVENT110_ARRAY_SELECT_CHARA_NO_LIST:LCOUNT - LCOUNT
	CALL キャラ削除, CHARA_NO
NEXT

PRINTFORMW 잘 자렴. 좋은 꿈을 꿀 수 있다면 좋겠구나.

;処理を終了する
RETURN 1

;-----------------------------------------
;キャラデータをファイル出力する処理
;-----------------------------------------
@EVENT_110_CREATE_COLD_SLEEP_FILE, FILE_NAME
#DIM LCOUNT						;ループカウンタ
#DIMS FILE_NAME					;作成するファイル名
#DIMS FILE_MEMO_HEADER			;出力ファイルに登録するメモ情報(ヘッダー部分)
#DIMS FILE_MEMO_DETAIL			;出力ファイルに登録するメモ情報(詳細部分)
#DIMS FILE_MEMO					;出力ファイルに登録するメモ情報(ヘッダー+詳細)

;メモ情報(のヘッダー部分)を作成する
