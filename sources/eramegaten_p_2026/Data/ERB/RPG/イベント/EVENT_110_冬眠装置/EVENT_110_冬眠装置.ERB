IF EVENT110_SAVEDATE_ID == 0
	EVENT110_SAVEDATE_ID = EVENT110_SAVEDATE_ORBITING_ID
ENDIF

RETURN 1


;---------------------------------
;冬眠ファイルのメモ情報取得処理
;---------------------------------
@EVENT_110_READ_FILE_MEMO, FILE_NAME
#DIM LCOUNT				;ループカウンタ
#DIMS FILE_NAME			;対象ファイル名
#DIM MEMO_POINT			;メモ情報(詳細)について、現在読み込み中の位置
#DIMS ARG_MEMO, 200		;メモ情報を格納する文字列配列

;メモ情報の初期化
VARSET EVENT110_ARRAY_FILE_MEMO, 0
VARSET EVENT110_ARRAY_FILE_MEMO_DETAIL, 0

;対象ファイルのメモ情報を取得して「ARG_MEMO」に格納する
CHKCHARADATA FILE_NAME
SPLIT RESULTS:0, ",", ARG_MEMO

;メモ情報(ヘッダー)を取得する
MEMO_POINT = 0
EVENT110_ARRAY_FILE_MEMO:0 = TOINT(ARG_MEMO:MEMO_POINT)	;冬眠ファイルの形式(通常の冬眠の他にも闘技場に登場させるPTデータなどを想定)
MEMO_POINT ++
EVENT110_ARRAY_FILE_MEMO:1 = TOINT(ARG_MEMO:MEMO_POINT)	;冬眠ファイル内のキャラクタ数
MEMO_POINT ++
EVENT110_ARRAY_FILE_MEMO:2 = TOINT(ARG_MEMO:MEMO_POINT)	;冬眠ファイル作成時のゲームバージョン　※古いバージョンで作成した冬眠ファイルを解凍する場合は警告を行う
MEMO_POINT ++
EVENT110_ARRAY_FILE_MEMO:3 = TOINT(ARG_MEMO:MEMO_POINT)	;冬眠時のセーブデータのユニークID　※セーブデータ自体と周回でそれぞれIDを付ける
MEMO_POINT ++
EVENT110_ARRAY_FILE_MEMO:4 = TOINT(ARG_MEMO:MEMO_POINT)	;冬眠時のセーブデータの現周回のユニークID　※セーブデータ自体と周回でそれぞれIDを付ける
MEMO_POINT ++

;メモ情報(詳細)を取得する
FOR LCOUNT, 0, EVENT110_ARRAY_FILE_MEMO:1
	EVENT110_ARRAY_FILE_MEMO_DETAIL:LCOUNT:0 = TOINT(ARG_MEMO:MEMO_POINT)	;キャラクタのCSV番号
	MEMO_POINT ++
	EVENT110_ARRAY_FILE_MEMO_DETAIL:LCOUNT:1 = TOINT(ARG_MEMO:MEMO_POINT)	;キャラクタのユニークID
	MEMO_POINT ++
NEXT

RETURN 1


;---------------------------------
;冬眠キャラ解凍前のチェック
;---------------------------------
@EVENT_110_AWAKE_CHECK, FILE_NAME, FILE_TYPE
;---------------------------------
;引数
;---------------------------------
#DIMS FILE_NAME				;チェック対象のファイル名
#DIM FILE_TYPE				;作成するファイルのタイプ
;---------------------------------
;変数宣言(メモ情報：ヘッダ)
;---------------------------------
#DIM CHARA_CNT				;解凍ファイル内のキャラクタ数
#DIM FILE_VER_NO			;解凍ファイルのゲームバージョン情報
#DIM SAVEDATE_ID			;解凍ファイルのセーブデータID
#DIM SAVEDATE_ORBITING_ID	;解凍ファイルのセーブデータID(周回ごと)
;---------------------------------
;変数宣言(メモ情報：詳細)
;---------------------------------
#DIM CSV_NO       			;対象となるキャラクタのCSV番号
#DIM CHARA_UNIQUE_ID		;キャラクタの固有番号
;---------------------------------
;変数宣言(그외)
;---------------------------------
#DIM LCOUNT					;ループカウンタ
#DIMS CHARA_NAME			;対象となるキャラクタ名
#DIM TARGET_CSV_LEVEL		;対象となるキャラクタのCSVに設定されている基準レベル。@の現在レベルよりこの基準レベルが高い場合、解凍不可。

;---------------------------------
;解凍ファイルのメモ情報を取得する
;---------------------------------
;ファイルメモ読み込み
CALL EVENT_110_READ_FILE_MEMO, FILE_NAME
;メモのヘッダ情報を取得
CHARA_CNT = EVENT110_ARRAY_FILE_MEMO:1
FILE_VER_NO = EVENT110_ARRAY_FILE_MEMO:2
SAVEDATE_ID = EVENT110_ARRAY_FILE_MEMO:3
SAVEDATE_ORBITING_ID = EVENT110_ARRAY_FILE_MEMO:4

;---------------------------------
;解凍ファイル全体のチェック(メモのヘッダ情報に対応)
;---------------------------------
;キャラクタ数上限チェック
IF CHARANUM + CHARA_CNT > MAX_PLAYER_CHARA
	PRINTFORML 동료마가 너무 많구먼. 멤버를 정리하고 나서 다시 오도록 해!
	PRINTFORML 
	RETURN 0
ENDIF

;別のセーブデータや周回からの持ち越しチェック
IF DAY > 50 || FLAG:게임모드 == 9
	;50日経過、またはエンドレスモード突入の場合は制限なし
ELSE
	;その他の場合、冬眠ファイルの種類ごとにチェックを実施。
	IF FILE_TYPE == EVENT110_CONST_FILE_TYPE_NORMAL
		;通常の冬眠ファイルの場合
		;※他のセーブデータもしくは他の周回からキャラクタデータを持ち越した場合、回数制限あり
		IF SAVEDATE_ID != EVENT110_SAVEDATE_ID || SAVEDATE_ORBITING_ID != EVENT110_SAVEDATE_ORBITING_ID
			IF SAVEDATE_ID != EVENT110_SAVEDATE_ID
				PRINTFORML 어라? 이 아이는 『다른 세계선』에서 흘러들어온 모양이구먼.
			ELSE
				PRINTFORML 어라? 이 아이는 『이 세계의 다른 주회』에서 흘러들어온 모양이구먼.
			ENDIF
			IF EVENT110_ZAN_THAW_CNT == 0
				PRINTFORML ...으~음, 안 되겠어. 특수한 사례라 해동 장치의 내구성에 불안이 있거든.
				PRINTFORML 다음 주회나, 50일째 이후에 다시 오렴!
				PRINTFORML 
				RETURN 0
			ELSE
				PRINTFORML 자네 운이 좋구먼! 해동 장치를 요전에 막 점검해 둔 참이거든.
				PRINTFORML 이 아이의 해동은 충분히 가능할 테지.
				PRINTFORML 
			ENDIF
		ELSE
			PRINTFORML 이 아이는 이전에, 자네가 여기서 동면시켰던 아이로군.
			PRINTFORML 
		ENDIF

	ELSEIF FILE_TYPE == EVENT110_CONST_FILE_TYPE_GROUP
		;まとめて1ファイルに冬眠の場合
		;※他のセーブデータもしくは他の周回からキャラクタデータを持ち越し不可
		IF SAVEDATE_ID != EVENT110_SAVEDATE_ID || SAVEDATE_ORBITING_ID != EVENT110_SAVEDATE_ORBITING_ID
			PRINTFORML 이 동면 그룹은 먼 곳에서 온 모양이구먼.
			PRINTFORML 안타깝지만 지금 시설로는 해동할 수 없다네. 50일째 이후에 다시 오렴!
			PRINTFORML 
			RETURN 0
		ENDIF
	ENDIF
ENDIF

;解凍ファイルのゲームバージョンチェック
;IF FILE_VER_NO != GAMEBASE_VERSION
;	DRAWLINE
;	PRINTFORML 解凍キャラのバージョン：{FILE_VER_NO} / 現在のゲームバージョン：{GAMEBASE_VERSION}
;	PRINTFORML 解凍キャラのバージョンが現在のゲームバージョンと異なります。
;	PRINTFORML 互換性による問題が発生する可能性があります。解凍しますか？
;	PRINTFORML 
;	WHILE 1
;		PRINTFORML [  0]解凍する
;		PRINTFORML [100]やめる
;		DRAWLINE
;		$INPUT_LOOP_VERSION_CHECK
;		INPUT
;		IF RESULT == 0
;			;-----------------
;			;[  0]解凍する
;			;-----------------
;			BREAK
;		ELSEIF RESULT == 100
;			;-----------------
;			;[100]やめる
;			;-----------------
;			RETURN 0
;		ELSE
;			;-----------------
;			;入力ミスのためやり直し
;			;-----------------
;			GOTO INPUT_LOOP_VERSION_CHECK
;		ENDIF
;	WEND
;ENDIF

;---------------------------------
;解凍するキャラクタ毎のチェック(メモの詳細情報に対応)
;---------------------------------
FOR LCOUNT, 0, EVENT110_ARRAY_FILE_MEMO:1
	;チェック対象のキャラクタ情報を取得する
	CSV_NO = EVENT110_ARRAY_FILE_MEMO_DETAIL:LCOUNT:0
	CHARA_UNIQUE_ID = EVENT110_ARRAY_FILE_MEMO_DETAIL:LCOUNT:1
	CHARA_NAME = %CSVCALLNAME(CSV_NO)%
	TARGET_CSV_LEVEL = CSVBASE(CSV_NO,GETNUM(BASE,"LV"),0)

	;キャラクタ重複チェック
	CALL EVENT_110_CHECK_DUPLICATION, CSV_NO, CHARA_UNIQUE_ID

	;重複が存在した場合、メッセージを表示して終了
	IF RESULT == 0
		PRINTFORML ...응? %CHARA_NAME%은(는) 이미 자네의 동료마로 있는 모양이구먼.
		PRINTFORML 같은 인물을 동시에 존재시키는 건 불쌍하니 관두도록 하자꾸나.
		PRINTFORML 
		RETURN 0
	ENDIF

	;悪魔は自分より強い者にしか従わないチェック
	;※対象キャラのCSV上の基準レベルを取得する
	IF BASE:MASTER:LV < TARGET_CSV_LEVEL
		PRINTFORML %CHARA_NAME%의 기준 레벨은 {TARGET_CSV_LEVEL}이로군.
		PRINTFORML 자네보다 강한 아이는 해동하지 않는 편이 좋을 게야.
		PRINTFORML 더 강해지거든, 다시 오렴!
		PRINTFORML 
		RETURN 0
	ENDIF

NEXT

;チェックOK
RETURN 1

