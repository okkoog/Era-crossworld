ENDIF

;通常行動
IF CFLAG:ARG:행동한횟수 == 0
	;奇数ターンは核熱、偶数は火炎ガードキルを使う可能性がある
	IF RAND:4 == 0
		IF FLAG:경과턴수 % 2 == 1
			CFLAG:ARG:입력행동 = [[스킬:핵열가드브레이크]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:화염가드브레이크]]
		ENDIF
	;バフデバフ
	ELSEIF RAND:3 == 0
		CFLAG:ARG:입력행동 = [[스킬:포그브레스]]
	ELSEIF RAND:2 == 0
		CFLAG:ARG:입력행동 = [[스킬:마카・카쟈]]
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:독의빛]]
