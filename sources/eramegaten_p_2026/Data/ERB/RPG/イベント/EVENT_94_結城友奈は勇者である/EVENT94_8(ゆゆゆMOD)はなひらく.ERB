;=======================================================================
;ﾚｵ･ｽﾀｰｸﾗｽﾀｰ行動パターン
;=======================================================================
@SET_ACTION_cluster,ARG
#LOCALSIZE 2
#LOCALSSIZE 1
;HPが５０％切ったら行動回数増える
IF CFLAG:ARG:행동횟수 < 3 && (BASE:ARG:ＨＰ)*100/(MAXBASE:ARG:ＨＰ) < 50
	PRINTFORML ┏>CHARA━━━━━━━━━━┓　┏>ACT━━━━━━━━━━━━━━━━━━┓
	PRINTFORM ┃[{CFLAG:ARG:포지션,2}] %CALLNAME:ARG,21,LEFT%┃　┃
	RESULTS = 용의안광
	PRINTFORML %RESULTS,40,LEFT%┃
	PRINTFORMW ┗━━━━━━━━━━━━━┛　┗━━━━━━━━━━━━━━━━━━━━┛
	CFLAG:ARG:행동횟수 = 4
ENDIF

IF FLAG:경과턴수 == 0 && CFLAG:ARG:행동한횟수 == 0
	;開幕ヒートカイザー
	CFLAG:ARG:입력행동 = 1904
	CALL RANDOM_TARGET,ARG,CFLAG:ARG:입력행동
	RETURN 0
ELSE
	$DECIDE_ACTION
	LOCAL = RAND:10
	;通常攻撃
	IF LOCAL == 0
		CFLAG:ARG:입력행동 = 0
	;コズミック
	ELSEIF LOCAL == 1
		CFLAG:ARG:입력행동 = 1913
	;히트카이저
	ELSEIF 2 <= LOCAL && LOCAL <= 3
		CFLAG:ARG:입력행동 = 1904
	;프로미넌스
	ELSEIF 4 <= LOCAL && LOCAL <= 5
		CFLAG:ARG:입력행동 = 749
	;메기도라온
	ELSEIF 6 <= LOCAL && LOCAL <= 7
		CFLAG:ARG:입력행동 = 2003
	;悪魔召喚、失敗したら通常攻撃
	ELSE
		FOR LOCAL, 7, 17
			SIF POS(LOCAL) >= 0
				CONTINUE
			BREAK
		NEXT
		IF LOCAL == 17
			CFLAG:ARG:입력행동 = 0
		ELSE
			CFLAG:ARG:입력행동 = 2308
		ENDIF
	ENDIF
ENDIF
CALL CHECK_ACTIONABLE,ARG,CFLAG:ARG:입력행동
IF RESULT == 1
	CALL RANDOM_TARGET,ARG,CFLAG:ARG:입력행동
ELSE
	;なんかエラーあれば通常攻撃に
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET,ARG,CFLAG:ARG:입력행동
ENDIF
RETURN 0

