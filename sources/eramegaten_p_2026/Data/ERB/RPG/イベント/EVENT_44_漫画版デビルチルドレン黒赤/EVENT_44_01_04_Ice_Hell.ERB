#DIM 에네미레벨
#DIM 시체가남는플래그
#DIM 보스플래그
#DIM 위치플래그

	;●1615.헬
	;아이스랜드의 마왕
	;아마 잭 프로스트계지만 그렇게는 안 보이는 흉악함.

	위치플래그 = 9
	에네미레벨 = 30
	시체가남는플래그 = 1
	보스플래그 = 1
	CALL SET_ENEMY, 위치플래그, [[キャラ:헬]], 에네미레벨, 시체가남는플래그, 보스플래그
	;LOCAL에 일단 보존
	LOCAL = CHARANUM - 1

	;●데이터 변경
	;헬이지만 이 녀석은 남자다, 히호ー! 딱히 의미는 없을 터
	TALENT:LOCAL:남자 = 1

	CSTR:LOCAL:종족명 = 마왕
	ABL:LOCAL:종족 = 3

	CFLAG:LOCAL:ＨＰ보정 += 1500
	CFLAG:LOCAL:ＭＰ보정 += 30000
	CFLAG:LOCAL:행동횟수 = 2
	;빙결 상성
	ABL:LOCAL:공격상성 = 5
	;통상공격은 3회 공격
	ABL:LOCAL:최저공격횟수 = 3
	ABL:LOCAL:최대공격횟수 = 3
	;듬뿍
	CFLAG:LOCAL:명중보정 += 50
	;둔하다
	CFLAG:LOCAL:속도보정 -= 15

	;통상 헬에서 변경
	;약점을 화염만으로 변경, 단 그 화염이 엄청나게 잘 통함
	;지변은 펜릴의 마그나스를 맞고 죽었으므로 통하도록
	;빙결과 수격은 흡수
	BASE:LOCAL:검격 = 100
	BASE:LOCAL:비구 = 100
	BASE:LOCAL:타격 = 100
	BASE:LOCAL:전술 = 100
	BASE:LOCAL:화염 = 250
	BASE:LOCAL:빙결 = -100
	BASE:LOCAL:전격 = 75
	BASE:LOCAL:충격 = 75
	BASE:LOCAL:신경 = 0
	BASE:LOCAL:정신 = 0
	BASE:LOCAL:파마 = 100
	BASE:LOCAL:주살 = 999
	BASE:LOCAL:지변 = 100
	BASE:LOCAL:수격 = -100
	BASE:LOCAL:질풍 = 100
	BASE:LOCAL:중력 = 100
	BASE:LOCAL:핵열 = 100

	;원작 사용 스킬은 부흐나 마하부흐 등.
	CALL CLEAR_ALL_SKILL, LOCAL
	CALL SET_SKILL, LOCAL, "마하・부흐라"
	CALL SET_SKILL, LOCAL, "부흐다인"
	CALL SET_SKILL, LOCAL, "아이스브레스"
	CALL SET_SKILL, LOCAL, "얼음의난무"
	CALL SET_SKILL, LOCAL, "한숨"
	CALL SET_SKILL, LOCAL, "물의벽"
;	CALL SET_SKILL, LOCAL, "치유촉진(소)"

	;빙결 준관통
	CSTR:LOCAL:특수적보정패턴 = EVE44_01_04_VS_HELL

	;입수 아이템 등이 있다면 여기
;	ABL:LOCAL:아이템1 = GETNUM(ITEM, "보옥")
;	ABL:LOCAL:입수확률1 = 100

	CALL SYNC_STATUS,LOCAL
	CALL HEALTH_CHARA,LOCAL

	FLAG:도주불가플래그 = 1
	FLAG:회화불능플래그 = 1
	FLAG:선제기습취소 = 1

	CALL BATTLE_START

	FLAG:도주불가플래그 = 0
	FLAG:회화불능플래그 = 0
	FLAG:선제기습취소 = 0

;========================================
;헬에게 빙결 준관통을 부여한다
;========================================
@SKILL_PASSIVE_PENETRATION_RANK_EVE44_01_04_VS_HELL, L_P, L_T, L_스킬, L_데미지타입, L_공격타입, L_상성, GIVE_EFFECT_CHARA
#DIM DYNAMIC L_P;이 스킬의 소지자
#DIM DYNAMIC L_T;공격 대상
#DIMS DYNAMIC L_스킬;스킬 소지자가 적에 대해 사용 중인 스킬의 함수 명칭
#DIM DYNAMIC L_데미지타입
#DIM DYNAMIC L_공격타입
#DIM DYNAMIC L_상성
#DIM DYNAMIC GIVE_EFFECT_CHARA;리더스킬 등 타인으로부터 부여받은 경우의 제공자
;빙결 준관통
SIF GET_TYPE(L_상성) == "빙결"
	RETURN 0, 4
RETURN 0, 0
