			CALL EVENT_44_01_10
		;11.『ForgetLand』
		ELSEIF イベントフラグ:44:1 == 11
			CALL EVENT_44_01_11
		;12.『Talk.』
		ELSEIF イベントフラグ:44:1 == 12
			CALL EVENT_44_01_12
		;13.『Fallen a Angel』
		ELSEIF イベントフラグ:44:1 == 13
			CALL EVENT_44_01_13
		;14.『Azel』
		ELSEIF イベントフラグ:44:1 == 14
			CALL EVENT_44_01_14
		;15.『Season in Full Bloom』
		ELSEIF イベントフラグ:44:1 == 15
			CALL EVENT_44_01_15
		ENDIF
	;============================================================================================================
	;●未来とっ捕まえたルート
	;============================================================================================================
	ELSEIF イベントフラグ:44:0 == 2
		;途中終了ルート
		;未来いなきゃダメ……ということはないかな
		IF 0
		;『大魔王アゼルの手紙』
		ELSEIF イベントフラグ:44:1 == 1
			CALL EVENT_44_02_01
		;『大魔王アゼルとの謁見』
		ELSEIF イベントフラグ:44:1 == 2
			CALL EVENT_44_02_02
		ENDIF
	;============================================================================================================
	;●未来ルート
	;============================================================================================================
	ELSEIF イベントフラグ:44:0 == 3
		;============================================================================================================
		;●更新を待ってネ
		;============================================================================================================
		;今はここまでだよ！ってやつ
		PRINTFORML 　
		PRINTFORML ＞만화판 데빌칠드런 루트는 일단 여기까지입니다.
		PRINTFORML ＞업데이트를 기다려 주십시오.
		PRINTFORMW 　
	ENDIF



