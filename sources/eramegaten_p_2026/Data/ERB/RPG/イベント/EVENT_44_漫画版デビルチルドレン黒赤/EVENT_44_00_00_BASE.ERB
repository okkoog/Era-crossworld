;================================================================================================================
;●なんか参考になるの欲しいな～と思ってるあなたへ
;================================================================================================================
;　Read Meは***必ず***散逸するので、重要なことは全部ここに書いておこうね。
;　3か月も経ったら人間別人になるので、必要なことはきちんとメモしておこうね。
;================================================================================================================
;
;
;================================================================================================================
;●レベル設計
;================================================================================================================
;――全体
;　全体として、「Lv15スタート、Lv80でエンディング」
;　原宿スタートではあるがレベル条件があるので、
;　ダンジョンがないため、レベル上昇は結構急勾配。
;
;――発生条件
;　基本的に、「イベントをクリアすると次回のイベントが発生する」タイプ。特に時間制限などはない。
;　最初のイベントは、あなたのLvが15以上で初めて原宿に突入すると発生する。
;　その後の条件は特にない予定。
;
;――報酬
;　最終報酬として「エンディング」「Lv50対応のノルンの鍵」、「어나더노른」
;　途中報酬に関しては……一緒程度にしたいけど無理だね！
;　結果的に、「名声をコンスタントに稼げるイベント群」になった感ある。
;================================================================================================================


;================================================================================================================
;●イベント変数群
;================================================================================================================
;・イベントフラグ:44:0
;　――ルート分岐変数
;　　00：開始前
;　　01：通常ルート（刹那ルート）
;　　02：未来を初手捕まえたルート
;　　03：アイスランドにて未来を助けるルート（未来・ナガヒサルート）
;・イベントフラグ:44:1
;　――ルート進行変数
;　　1/00：開始前。原宿の入り口で選択することで色々あって02に変更される
;　　1/01：１、『20XXアーリーウィンター』発生条件（まあ入り口で発生するので飛ばされるが）
;　　1/02：２、『Go_to_MAKAI』発生条件
;　　1/03：３、『White & Blood』発生条件
;　　1/04：４、『Ice HELL』発生条件
;　　1/05：５、刹那ルート。『Rumor』発生条件
;　　1/06：６、『Elegy』発生条件
;　　1/07：７、『three-sided war』発生条件
;　　1/08：８、『Z』発生条件
;　　1/09：９、『Double』発生条件
;　　1/10：10、『Ghost』発生条件
;　　1/11：11、『ForgetLand』発生条件
;　　1/12：12、『Talk.』発生条件
;　　1/12：13、『Fallen a Angel』発生条件
;　　1/12：14、『Azel』発生条件
;　　1/12：15、『Season in Full Bloom』発生条件
;　　2/01：アゼル大勝利ルート。『大魔王アゼルの手紙』発生条件
;　　2/02：『大魔王アゼルとの謁見』発生条件
;　　3/01：未来ルート。
;　　3/02：――――
;　　X/999：完全終了
;・イベントフラグ:44:2
;　――戦闘イベント管理変数
;　　00：なにも発生しない
;　　01：1-01.『AD.20XX Early Winter』で会話が発生
;　　02：2-02.『大魔王アゼルとの謁見』でアゼルが全開パワー叩きつけてー！してくる
;　　03：1-08.『Z』でゼットが喋る
;　　04：1-14.『Azel』で全開バトル叩きつけてー！する
;・イベントフラグ:44:3
;　――「AD.20XX Early Winter」発生日時保存
;　　00：開始前
;　　XX：開始日時保存
;　　XX+20：『大魔王アゼルの手紙』発生条件
;　
;================================================================================================================


;================================================================================================================
;●条件
;================================================================================================================
@GET_EVENT_NAME_44
#FUNCTIONS
RESULTS_F '= "만화판데빌칠드런"
RETURNF RESULTS_F

@PLAYABLE_EVENT_44
;#DIM SETSUNA_NO
;#DIM MIRAI_NO
#DIM TEMP_INT

;今のところ要らない予定
;	;刹那の番号とかを取得
;	CALLF FINDCHARA_B([[キャラ:세츠나]])
;	SETSUNA_NO = RESULT:1
;	CALLF FINDCHARA_B([[キャラ:미라이]])
;	MIRAI_NO = RESULT:1

	;デビチルゲーム版ルートが始まってたら弾く（排他）
	SIF ダンジョンフラグ:61:1 != 3
		RETURN 0
	;おまじない、こっちでも弾く
	SIF 依頼フラグ:[[依頼:데빌칠드런]]:0 > 0
		RETURN 0
	;終了フラグが立ってたら　もんどう　むよう！
	SIF イベントフラグ:44:1 == 99
		RETURN 0




	IF 0
	ELSEIF イベントフラグ:44:0 == 1
		;正規ルート
		IF 0
		;原宿入り口で呼ぶのでこちらでは呼ばない
;		;1
;		ELSEIF イベントフラグ:44:1 == 1
;			RESULTS = AD.20XX Early Winter
;			RETURN 1
		;2
		ELSEIF イベントフラグ:44:1 == 2
			RESULTS = Go to MAKAI
			RETURN 1
		;3
		ELSEIF イベントフラグ:44:1 == 3
			RESULTS = White & Blood
			RETURN 1
		;4
		ELSEIF イベントフラグ:44:1 == 4
			RESULTS = Ice HELL
			RETURN 1
		;5
		ELSEIF イベントフラグ:44:1 == 5
			RESULTS = Rumor
			RETURN 1
		;6
		ELSEIF イベントフラグ:44:1 == 6
			RESULTS = Elegy
			RETURN 1
		;7
		ELSEIF イベントフラグ:44:1 == 7
			RESULTS = Three-sided war
			RETURN 1
		;8
		ELSEIF イベントフラグ:44:1 == 8
			RESULTS = Z
			RETURN 1
		;9
		ELSEIF イベントフラグ:44:1 == 9
			RESULTS = Double
			RETURN 1
		;10
		ELSEIF イベントフラグ:44:1 == 10
			RESULTS = Ghost
			RETURN 1
		;11
		ELSEIF イベントフラグ:44:1 == 11
			RESULTS = ForgetLand
			RETURN 1
		;12
		ELSEIF イベントフラグ:44:1 == 12
			RESULTS = Talk.
			RETURN 1
		;13
		ELSEIF イベントフラグ:44:1 == 13
			RESULTS = Fallen a Angel
			RETURN 1
		;14
		ELSEIF イベントフラグ:44:1 == 14
			RESULTS = Azel
			RETURN 1
		;15
		ELSEIF イベントフラグ:44:1 == 15
			RESULTS = Season in Full Bloom
			RETURN 1
		ENDIF

	ELSEIF イベントフラグ:44:0 == 2
		;途中終了ルート
		;未来いなきゃダメ……ということはないかな

		;シナリオ２番で未来をとっ捕まえた日数＋20
		TEMP_INT = イベントフラグ:44:3 + 20

		IF 0
		;『大魔王アゼルの手紙』、未来をとっ捕まえた日数から20日経過後、Lv60以上
		ELSEIF イベントフラグ:44:1 == 1 && DAY > TEMP_INT && BASE:MASTER:LV >= 60
			RESULTS = 대마왕 아젤의 편지
			RETURN 1
		;『大魔王アゼルとの謁見』
		ELSEIF イベントフラグ:44:1 == 2
			RESULTS = 대마왕 아젤과의 알현
			RETURN 1
		ELSE
			;こっちは２個でお終いな
		ENDIF
	ELSEIF イベントフラグ:44:0 == 3
		;未来ルート
		;未来、ナガヒサあたりの視点で行くハナシ

		;今はここまでだよ！ってやつ
		RESULTS = (업데이트를 기다려줘)
		RETURN 1

	ENDIF




