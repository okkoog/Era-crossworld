		;6.『Elegy』
		ELSEIF イベントフラグ:44:1 == 6
			CALL EVENT_44_01_06
		;7.『Three-sided war』
		ELSEIF イベントフラグ:44:1 == 7
			CALL EVENT_44_01_07
		;8.『Z』
