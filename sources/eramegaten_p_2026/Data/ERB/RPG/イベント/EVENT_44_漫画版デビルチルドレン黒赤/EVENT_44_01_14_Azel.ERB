@EVENT_44_01_14_BATTLE_TURNTOP
;=======================================================================
	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃노른의 열쇠의 힘이 넘쳐흐른다!!!　　　　　　　　　　　　　┃
	PRINTFORML ┃적의 전 능력이 상승했다!!!　　　　　　　　　　　　　　　　┃
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃또 하나의 노른의 열쇠의 힘이 넘쳐흐른다!!!　　　　　　　　┃
	PRINTFORML ┃아군의 전 능력이 상승했다!!!　　　　　　　　　　　　　　　┃
	PRINTFORML ┃아군의 ＨＰ・ＭＰ가 회복되었다!!!　　　　　　　　　　　　　┃
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

	;전 능력 상승 (+2)
	CALL SKILL_SET_カジャンダ, POS(9), POS(9), "공격/방어/마법위력/마법효과/명중/회피", 8, "단체", "NOMES"

	;전 능력 상승 (+2)
	FOR LOCAL,1,7
		CALL SKILL_SET_カジャンダ, POS(LOCAL), POS(LOCAL), "공격/방어/마법위력/마법효과/명중/회피", 8, "단체", "NOMES"
		;ＨＰ 회복 (3~8%)
		LOCAL:1 = RAND:50 + 30
		IF POS(LOCAL) > -1 && GET_STATE(CFLAG:(POS(LOCAL)):상태이상) != "DYING"
			PRINTFORML [{LOCAL}] %CALLNAME:POS(LOCAL)%　>>>>>>　ＨＰ {MAXBASE:(POS(LOCAL)):ＨＰ*(LOCAL:1)/1000} 회복
			CALL VAR_HP, POS(LOCAL), +MAXBASE:(POS(LOCAL)):ＨＰ * (LOCAL:1) / 1000
		ENDIF
		;ＭＰ 회복 (3~8%)
		LOCAL:1 = RAND:50 + 30
		IF POS(LOCAL) > -1 && GET_STATE(CFLAG:(POS(LOCAL)):상태이상) != "DYING"
			PRINTFORML [{LOCAL}] %CALLNAME:POS(LOCAL)%　>>>>>>　ＭＰ {MAXBASE:(POS(LOCAL)):ＭＰ*(LOCAL:1)/1000} 회복
			CALL VAR_MP, POS(LOCAL), +MAXBASE:(POS(LOCAL)):ＭＰ * (LOCAL:1) / 1000
		ENDIF
	NEXT
