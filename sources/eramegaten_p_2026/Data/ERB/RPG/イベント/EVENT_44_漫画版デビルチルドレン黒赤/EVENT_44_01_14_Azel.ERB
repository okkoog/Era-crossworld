;=======================================================================
@SET_ACTION_EV44_01_14_VS_アゼル1, ARG
;=======================================================================
#DIM デカジャチェック
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

	デカジャチェック = 0
	FOR LOCAL, 1, 7
		SIF POS(LOCAL) < 0
			CONTINUE
		SIF CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("DYING")
			CONTINUE
		デカジャチェック += COUNT_カジャンダ_OR_MORE(POS(LOCAL),16)
	NEXT

	IF 0
	ELSEIF CFLAG:ARG:１more플래그 > 0
		IF !RAND:3
			CFLAG:ARG:입력행동 = [[스킬:스마일차지]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:랜더마이저]]
		ENDIF
	ELSEIF (デカジャチェック > 5 || GET_カジャンダ_MIN(ARG) < -12) && !RAND:3
		CFLAG:ARG:입력행동 = [[스킬:이니셜라이즈]]
	;N+6턴 토
	ELSEIF FLAG:경과턴수 % 7 == 6
		IF 0
		ELSEIF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・마그바리온]]
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			CFLAG:ARG:입력행동 = [[스킬:티타노마키아]]
		ELSE
			CALL ランダム行動, ARG
		ENDIF
	;N+5턴 뇌
	ELSEIF FLAG:경과턴수 % 7 == 5
		IF 0
		ELSEIF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・지오바리온]]
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			CFLAG:ARG:입력행동 = [[스킬:나루카미]]
		ELSE
			CALL ランダム行動, ARG
		ENDIF
	;N+4턴 풍
	ELSEIF FLAG:경과턴수 % 7 == 4
		IF 0
		ELSEIF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・잔바리온]]
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			CFLAG:ARG:입력행동 = [[스킬:이계의바람]]
		ELSE
			CALL ランダム行動, ARG
		ENDIF
	;N+3턴 수
	ELSEIF FLAG:경과턴수 % 7 == 3
		IF 0
		ELSEIF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・부흐바리온]]
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			CFLAG:ARG:입력행동 = [[스킬:극한동결]]
		ELSE
			CALL ランダム行動, ARG
		ENDIF
	;N+2턴 화
	ELSEIF FLAG:경과턴수 % 7 == 2
		IF 0
		ELSEIF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・아기바리온]]
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			CFLAG:ARG:입력행동 = [[스킬:라그나로크]]
		ELSE
			CALL ランダム行動, ARG
		ENDIF
	;N+1턴 월
	ELSEIF FLAG:경과턴수 % 7 == 1
		IF 0
		ELSEIF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하무드바리온]]
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			CFLAG:ARG:입력행동 = [[스킬:불멸의흑]]
		ELSE
			CALL ランダム行動, ARG
		ENDIF
	;N+0턴 일
	ELSEIF FLAG:경과턴수 % 7 == 0
		IF 0
		ELSEIF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・기가바리온]]
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
		ELSE
			CALL ランダム行動, ARG
		ENDIF
	ELSE
	ENDIF

CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1


