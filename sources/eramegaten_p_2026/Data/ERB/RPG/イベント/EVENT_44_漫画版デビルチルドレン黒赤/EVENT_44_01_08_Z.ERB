@SET_ACTION_EV44_01_08_VS_高城ゼット, ARG
;=======================================================================
;1회 행동
;컨셉은 「아무것도 하지 않는다」
;……하지만 가~끔 이상한 짓을 해온다
;=======================================================================
;입력 행동을 -1과 타겟을 -1로 해둔다
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

	IF 0
	;에레지의 공격을 무효화했던 녀석
	ELSEIF !RAND:6
		CFLAG:ARG:입력행동 = [[스킬:수호의방패]]
	;제불 요소
	ELSEIF !RAND:5
		CFLAG:ARG:입력행동 = [[스킬:파리화의저주]]
	ELSE
		CSTR:ARG:더미스킬명 = 웃는다
		CFLAG:ARG:입력행동 = [[스킬:ＤＵＭＭＹ]]
	ENDIF

;액션 실행 불능이라면 자동적으로 통상 공격으로 전환
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;여기까지 타겟이 결정되지 않았다면 랜덤 타겟을 불러 결정
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1




