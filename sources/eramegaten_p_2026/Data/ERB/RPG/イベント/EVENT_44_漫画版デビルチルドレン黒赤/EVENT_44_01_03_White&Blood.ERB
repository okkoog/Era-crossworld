;vs.네크베트
;데비칠에만 있는 냄새가 나므로 이츠마데를 개변
;========================================
#DIM 에네미레벨
#DIM 시체가남는플래그
#DIM 보스플래그
#DIM 위치플래그


	FOR 위치플래그, 7, 17
		;「있는 장소」를 가리킨다
		IF !GROUPMATCH(위치플래그, 7, 8, 9, 10, 11)
			;23456
			;78911
			CONTINUE
		ELSE
			;●967.이츠마데 모델 『네크베트』
			;뭐 네크베트 미구현이므로……
			;전초전, 뭐 20 미만 정도인가?
			에네미레벨 = 17
			시체가남는플래그 = 0
			보스플래그 = 0
			CALL SET_ENEMY, 위치플래그, [[キャラ:이츠마데]], 에네미레벨, 시체가남는플래그, 보스플래그
			;LOCAL에 일단 보존
			LOCAL = CHARANUM - 1

			;●데이터 변경

			NAME:LOCAL = 네크베트
			CALLNAME:LOCAL = 네크베트
			CFLAG:LOCAL:ＨＰ보정 += 50
			CFLAG:LOCAL:행동횟수 = 1
			;통상공격은 2회 공격
			ABL:LOCAL:최저공격횟수 = 2
			ABL:LOCAL:최대공격횟수 = 2
			CFLAG:LOCAL:속도보정 = 5

			;내성：통상에서 변경 없음

			;통상 습득 스킬을 명시적으로 갖추게 한다
			;단 잔은 마하잔으로 변경
			CALL CLEAR_ALL_SKILL, LOCAL
			CALL SET_SKILL, LOCAL, "마하・잔"
			CALL SET_SKILL, LOCAL, "스쿤・다"
			CALL SET_SKILL, LOCAL, "할퀴기"
			CALL SET_SKILL, LOCAL, "마이트"
			CALL SET_SKILL, LOCAL, "잔마"
		ENDIF
	NEXT


	FLAG:도주불가플래그 = 1
	FLAG:회화불능플래그 = 1
	FLAG:선제기습취소 = 1

	CALL BATTLE_START

	FLAG:도주불가플래그 = 0
	FLAG:회화불능플래그 = 0
	FLAG:선제기습취소 = 0

