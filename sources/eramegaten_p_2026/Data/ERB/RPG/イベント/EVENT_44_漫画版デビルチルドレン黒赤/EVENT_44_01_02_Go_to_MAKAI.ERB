@EVENT_44_01_02_BATTLE_02
;========================================
;vs.나이트메어 넘버즈
;========================================
#DIM 에네미레벨
#DIM 시체가남는플래그
#DIM 보스플래그
#DIM 위치플래그


	FOR 위치플래그, 7, 17
		;「있는 장소」를 가리킨다
		IF !GROUPMATCH(위치플래그, 7, 8, 9, 10, 11, 13, 14, 15)
			;23456
			;78911
			CONTINUE
		ELSE
			;●431.나이트메어×8
			;뭐 잡몹님
			에네미레벨 = 15 + RAND:3
			시체가남는플래그 = 1
			보스플래그 = 1
			CALL SET_ENEMY, 위치플래그, [[キャラ:나이트메어]], 에네미레벨, 시체가남는플래그, 보스플래그
			;LOCAL에 일단 보존
			LOCAL = CHARANUM - 1

			;●데이터 변경
			;나이트메어지만 이 녀석들은 남자다 문ー! 딱히 의미는 없을 터
			TALENT:LOCAL:남자 = 1

			CFLAG:LOCAL:ＨＰ보정 += 100
			CFLAG:LOCAL:ＭＰ보정 += 3000
			CFLAG:LOCAL:행동횟수 = 2
			;통상공격은 1～2회 공격
			ABL:LOCAL:최저공격횟수 = 1
			ABL:LOCAL:최대공격횟수 = 2
			CFLAG:LOCAL:속도보정 = 10

			;내성：통상 나이트메어에서 변경 없음

			;원작 사용 스킬적으로 「잔」밖에 사용하지 않는다
			;전회는 메시아의 뿔 파워가 있어서 「잔마」가 되어 있었지만 이번엔 잔
			CALL CLEAR_ALL_SKILL, LOCAL
			CALL SET_SKILL, LOCAL, "잔"
			CALL SET_SKILL, LOCAL, "마하・잔"

			CALL SYNC_STATUS,LOCAL
			CALL HEALTH_CHARA,LOCAL
		ENDIF
	NEXT

	FLAG:도주불가플래그 = 1
	FLAG:회화불능플래그 = 1
	FLAG:선제기습취소 = 1

	CALL BATTLE_START

	FLAG:도주불가플래그 = 0
	FLAG:회화불능플래그 = 0
	FLAG:선제기습취소 = 0
