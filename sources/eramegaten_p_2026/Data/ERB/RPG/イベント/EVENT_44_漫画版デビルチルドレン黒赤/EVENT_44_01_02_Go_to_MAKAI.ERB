@EVENT_44_01_02_BATTLE_01
;========================================
;vs.미라이＆벨
;상정 레벨보다 제법 높음
;========================================
#DIM 에네미레벨
#DIM 시체가남는플래그
#DIM 보스플래그
#DIM 위치플래그

	;●865.벨1
	;이 단계에서는 강함 Lv25
	에네미레벨 = 25
	시체가남는플래그 = 1
	보스플래그 = 1
	위치플래그 = 9
	CALL SET_ENEMY, 위치플래그, [[キャラ:벨]], 에네미레벨, 시체가남는플래그, 보스플래그
	;LOCAL에 일단 보존
	LOCAL = CHARANUM - 1

	;●데이터 변경

	CFLAG:LOCAL:ＨＰ보정 += 300
	CFLAG:LOCAL:ＭＰ보정 += 3000
	CFLAG:LOCAL:행동횟수 = 2
	;통상공격은 2회 공격
	ABL:LOCAL:최저공격횟수 = 2
	ABL:LOCAL:최대공격횟수 = 2
	CFLAG:LOCAL:속도보정 = 10

	;내성：통상에서 변경 없음

	;충격・질풍계, Lv15 직후부터 가능하지만 거기서 잔마와 갈룰라는 빡세겠지
	CALL CLEAR_ALL_SKILL, LOCAL
	CALL SET_SKILL, LOCAL, "마하・잔마"
	CALL SET_SKILL, LOCAL, "마하・갈라"
	CALL SET_SKILL, LOCAL, "날개짓"
	CALL SET_SKILL, LOCAL, "어설트다이브"
	CALL SET_SKILL, LOCAL, "소닉붐"

	;●4504.미라이
	;이 단계에서는 강함 Lv25
	에네미레벨 = 25
	시체가남는플래그 = 1
	보스플래그 = 1
	위치플래그 = 14
	CALL SET_ENEMY, 위치플래그, [[キャラ:미라이]], 에네미레벨, 시체가남는플래그, 보스플래그
	;LOCAL에 일단 보존
	LOCAL = CHARANUM - 1

	;●데이터 변경
	CFLAG:LOCAL:강제악마화 = 1
	CFLAG:LOCAL:ＨＰ보정 += 300
	CFLAG:LOCAL:ＭＰ보정 += 3000
	CFLAG:LOCAL:행동횟수 = 2
	;통상공격이 GUN 상성의 원거리 공격
	ABL:LOCAL:공격상성 = 1
	ABL:LOCAL:사거리 = 3
	;통상공격은 2회 공격
	ABL:LOCAL:최저공격횟수 = 2
	ABL:LOCAL:최대공격횟수 = 2
	CFLAG:LOCAL:속도보정 = 10

	;거의 완전히 날조 (뇌천깨기는 뇌천짓밟기의 재현이라는 것으로)
	;아이템계 달인 같은 취급을 한다
	CALL CLEAR_ALL_SKILL, LOCAL
	CALL SET_SKILL, LOCAL, "머리깨기"
	CALL SET_SKILL, LOCAL, "마석"
	CALL SET_SKILL, LOCAL, "네이팜탄"
	CALL SET_SKILL, LOCAL, "액화질소봄베"
	CALL SET_SKILL, LOCAL, "라이어트밤"

	CALL SYNC_STATUS,LOCAL
	CALL HEALTH_CHARA,LOCAL



	FLAG:도주불가플래그 = 1
	FLAG:회화불능플래그 = 1
	FLAG:선제기습취소 = 1

	CALL BATTLE_START

	FLAG:도주불가플래그 = 0
	FLAG:회화불능플래그 = 0
	FLAG:선제기습취소 = 0


