;====================
;召喚イベント条件
;====================
@FGO_SUMMON_CHECK_11
#DIM L_CHARA
#DIM 生贄
#DIMS 対象結果,3 = "未所持"

;■召喚可否条件をここに記載することで読み込んでくれます■
;※召喚はイベントフラグ:82:1が必ず4以上から。

L_CHARA = GETCHARA([[キャラ:ＦＫ・랜슬롯]])
IF イベントフラグ:82:1 > 3
	RESULTS = 가련하고도 최강인 용의 요정(요정기사 란슬롯)
	RESULTS:1 = 필요 촉매：ERROR! 『촉매에 적합한 악마를 특정할 수 없습니다』
	;未所持なら素通し
	SIF L_CHARA == -1
		RETURN 1
	RESULTS:1 = %RESULTS:1 + "보구 재림 실행 가능"%
	;宝具再臨が4未満なら通過可能
	SIF GET_RPG_CFLAG_TAKEOVER(L_CHARA,"宝具再臨（ランサー）") < 4
		RETURN 1
	;宝具再臨が4だと通過不可
	RESULTS:1 '= "보구 최종재림 도달 완료"
	RETURN 0
ELSE
	;そもこれが出ることはないはずだけど、確認用に一応記載
	RESULTS = 최초 소환 이벤트 미소화
	RETURN 0
ENDIF

;※RETURN 1　で鯖リストのBITがオンになるようにしているため、必ずRETURNを記入してください

;通常召喚ではなく独自形式の召喚処理を行う場合に用意される関数
;普通のとは別の処理をやりたい場合は関数を用意して1を返す
@FGO_UNIQUE_SUMMON_11
RETURN 1

;----------------------------------------
;生贄にする条件に適した悪魔を複数選択する関数
;使用する場合、CASTING_FGO_SUMMON_SACRIFICE_{使用しているイベントビットの桁}関数を作る必要がある
;----------------------------------------
;ARG		召喚する鯖のイベントビット桁（メリュジーヌは11桁目のビットを使用しているので11）
;L_CHARA	生贄として選択された悪魔の登録番号を入れるところ
@FGO_SUMMON_SACRIFICE,ARG
#DIM L_CHARA,3
#DIM LCOUNT
VARSET L_CHARA,-1
VARSET LCOUNT
CALL FGO_SUMMON_SACRIFICE_STOCK,"RESETALL"
$LIST_LOOP
;メモ：もし余裕があったら生贄にする悪魔の数や、悪魔の代わりに指定したアイテムを生贄として選択する処理を追加しておく
;キャラ一覧から条件が合うキャラが表示されるリストの中から生贄にする悪魔を選ぶ
;CALL INPUT_CHARA_LIST(@"%TOFULL(TOSTR(LCOUNT + 1))%つ目に生贄にする悪魔を選んでください",@"CASTING_FGO_SUMMON_SACRIFICE_{ARG}")
{
CALL INPUT_CHARA_LIST
	, "FUNC_PROPSET_LIST"
	, @"%TOFULL(TOSTR(LCOUNT + 1))%번째로 제물로 바칠 악마를 선택해 주십시오"
	, @"CASTING_FGO_SUMMON_SACRIFICE_{ARG}"
	, "SHOW_ADD_UP_FUNCTION"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "L_CANCELS"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
;キャンセル選択 and １つ目の悪魔選択時、イベントキャンセルの値を返す
IF RESULT == 1000 && LCOUNT == 0
	CALL FGO_SUMMON_SACRIFICE_STOCK,"RESETALL"
	RETURN -1
ENDIF
;キャンセル選択なら-1を、それ以外ならキャラ番号を登録、RESULTに入れなおして返す
L_CHARA:LCOUNT = RESULT
CALL FGO_SUMMON_SACRIFICE_STOCK,\@ RESULT == 1000 ? RESET # RECORD \@,RESULT == 1000 ? LIMIT(LCOUNT -1,0,2) # LCOUNT,L_CHARA:LCOUNT
;キャンセル選択なら-1を、それ以外なら1をLCOUNTに加算
LCOUNT += RESULT == -1 ? -1 # 1
;三つ目の悪魔の選択でなければ次の悪魔を選ぶ
SIF LCOUNT < 3
	GOTO LIST_LOOP
;選択した悪魔の登録番号がRESULT:0,RESULT:1,RESULT:2に入って返ってくる
RETURN L_CHARA:0,L_CHARA:1,L_CHARA:2

;----------------------------------------
;生贄候補の悪魔を仮登録する関数
;----------------------------------------
;ARG		使用する配列の要素数
;ARG:1		キャラ登録番号
;ARGS		옵션。RESETALLで全消し、RESETで対応した特定の部分消し、MATCHで登録済みかどうか確認する、RECORDなら登録
@FGO_SUMMON_SACRIFICE_STOCK,ARGS = "",ARG,ARG:1 = -1
#DIM L_CSVID,3
;たぶんERHでグローバル変数用意した方が手間がかからないと思う
SELECTCASE ARGS
	CASE "RECORD"
		L_CSVID:ARG = NO:(ARG:1)
		RETURN ARG:1
	CASE "RESETALL"
		VARSET L_CSVID,-1
	CASE "RESET"
		L_CSVID:ARG = -1
		RETURN -1
	CASE "MATCH"
		SIF (ARG > -1 && L_CSVID:ARG == NO:(ARG:1)) || MATCH(L_CSVID,NO:(ARG:1))
			RETURN 1
ENDSELECT
RETURN 0

;----------------------------------------
;召喚確率まとめて計算して返してくれる関数
;使用する場合、FGO_SUMMON_SACRIFICE_SCORE_{使用しているイベントビットの桁}関数を作る必要がある
;----------------------------------------
;ARG		召喚する鯖のイベントビット桁（メリュジーヌは11桁目のビットを使用しているので11）
;ARGS		選択した悪魔の登録番号を文字列に変換したやつ。SPLIT用に/で区切る(例：101/102/103)
@FGO_SUMMON_SACRIFICE_SCORE,ARG,ARGS
#DIM LCOUNT,2
#DIM SUMMON_SCORE
#DIM L_COLOR
#DIMS L_STR,10
VARSET SUMMON_SCORE
SPLIT ARGS,"/",L_STR
LCOUNT:1 = RESULT
SIF !RESULT
	THROW SPLITでRESULTに代入された値が0です。（ARGSに代入する文字列を / で区切ってください）
SIF VARSIZE("L_STR") < LCOUNT:1
	THROW 分割された文字列の数が配列の要素数を越えています。
FOR LCOUNT:0,0,LCOUNT:1 + 1
	;最後のループになると-1を返す。対応するサーヴァントを検索するときの分岐用
	CALLFORM FGO_SUMMON_SACRIFICE_SCORE_{ARG},LCOUNT:0 == LCOUNT:1 ? -1 # TOINT(L_STR:(LCOUNT:0))
	SUMMON_SCORE += RESULT
NEXT
SELECTCASE SUMMON_SCORE
	CASE IS >= 4000
		L_COLOR = 0x008000
	CASE 3000 TO 3999
		L_COLOR = 0xffff00
	CASE 2000 TO 2999
		L_COLOR = 0xffa500
	CASE IS <= 1999
		L_COLOR = 0xff0000
ENDSELECT
RETURN MAX(SUMMON_SCORE + RAND:100,1),L_COLOR

;生贄候補の悪魔の適合率
@FGO_SUMMON_SACRIFICE_SCORE_11,ARG
#DIM L_SCORE
VARSET L_SCORE
IF ARG > -1
	SELECTCASE ABL:ARG:종족
		CASE 6,44
			L_SCORE += 100
		CASE 8
			L_SCORE += 200
		CASE 9
			L_SCORE += 50
	ENDSELECT
	SIF GET_ALI1(ABL:ARG:속성LD) == "Dark"
		L_SCORE += 100
	SIF GET_ALI2(ABL:ARG:속성LC) == "Neutral"
		L_SCORE += 100
	SIF !IS_MALE(ARG)
		L_SCORE += 100
	SELECTCASE NO:ARG
		CASE [[キャラ:비비안]],[[キャラ:아서]]
			L_SCORE += 100
		CASE [[キャラ:펜드래곤]],[[キャラ:모르간]],[[キャラ:멜뤼지느]]
			L_SCORE += 200
	ENDSELECT
	L_SCORE += (300 * 陥落(ARG))
ELSE
	SIF GETCHARA([[キャラ:ＦＫ・랜슬롯]]) > -1
		L_SCORE += 1000
ENDIF
RETURN L_SCORE

