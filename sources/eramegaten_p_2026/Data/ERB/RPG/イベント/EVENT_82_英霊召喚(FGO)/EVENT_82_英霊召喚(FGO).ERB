;召喚候補のサーヴァントの一覧を表示する関数
@FGO_SUMMON
#DIM LCOUNT
#DIM L_LINECOUNT
#DIM L_PAGE,2
#DIM EXTRA_FLAG
#DIM L_RESULT

L_PAGE:0 = 0

VARSET EXTRA_FLAG

$INPUT_LOOP
VARSET 鯖リスト
VARSET EXリスト
L_LINECOUNT = LINECOUNT
CUSTOMDRAWLINE =
PRINTL  
IF !EXTRA_FLAG
	PRINTL  「새로운 실험의 무대에 온 것을 환영하네……아직 모색 중이기는 하나, 앞으로 점점 더 선택지도 늘어나겠지
	PRINTL  자, 무슨 일이든 시작하지 않으면 나아가지 못하는 법.　지금 시험해 볼 수 있는 소환은―――――」
ELSE
	PRINTL  「미지의 실험의 무대에 온 것을 환영하네……이 몸들은 나날이 진화 중이기에
	PRINTL  　용솟음치는 호기심의 결과, 이런 시도도 태어난 것이라네.　자, 지금 시험해 볼 수 있는 소환은―――――」
ENDIF
PRINTL  
DRAWLINE
;１ページにつき、１０体分の鯖の召喚可否を確認、内９体のみサーヴァントを表示する
;そのページの１０体目は다음페이지への移行可否として使い、다음페이지で改めて表示する
FOR LCOUNT,0 + (10 * L_PAGE:0),11 + (10 * L_PAGE:0)
	TRYCCALLFORM \@!EXTRA_FLAG ? FGO # EX\@_SUMMON_CHECK_{LCOUNT}
		IF RESULT == 1
			IF !EXTRA_FLAG
				SETBIT 鯖リスト, LCOUNT
			ELSE
				SETBIT EXリスト, LCOUNT
			ENDIF
		ENDIF
		;１０体目は表示せず、ページ数上限を設定してループ中断
		IF LCOUNT == 10 + (10 * L_PAGE:0)
			L_PAGE:1 = 1 + L_PAGE:0
			BREAK
		ENDIF
		PRINTFORML [{LCOUNT}]%RESULTS%
		PRINTFORML 【조건】%RESULTS:1%
		PRINTL
	CATCH
		;１０体目になったらループ中止
		SIF LCOUNT == 10 + (10 * L_PAGE:0)
			BREAK
		PRINTFORML 
		PRINTL
		PRINTL
	ENDCATCH
NEXT
DRAWLINE
PRINTFORMLC \@ L_PAGE:0 > 0 ? [1006]이전페이지 # [----] \@
PRINTFORMLC \@ L_PAGE:0 < L_PAGE:1 ? [1007]다음페이지 # [----] \@
PRINTL
DRAWLINE
PRINTFORML [998]\@ !EXTRA_FLAG ? 새로운 도전에(타 작품 소환) # 일반 소환으로 \@
PRINTFORML [999]역시 그만둔다
INPUT
L_RESULT = RESULT
CLEARLINE LINECOUNT - L_LINECOUNT
SELECTCASE L_RESULT
	CASE 998
		EXTRA_FLAG = !EXTRA_FLAG
		VARSET L_PAGE,0
	CASE 0 TO 63,999
		CALL 疑似的画面クリア
		RETURN L_RESULT,EXTRA_FLAG
	CASE 1006,1007
		L_PAGE:0 = L_RESULT == 1006 ? L_PAGE:0 -1 # L_PAGE:0 + 1
ENDSELECT
GOTO INPUT_LOOP

@FGO_SUMMON_SACRIFIE_COMMON, ARG
#FUNCTION
;労役中はダメ
SIF IS_RENTING(ARG)
	RETURNF 0
;この場にいない人もダメ
SIF CFLAG:ARG:이자리에없는플래그 > 0
	RETURNF 0
RETURNF 1