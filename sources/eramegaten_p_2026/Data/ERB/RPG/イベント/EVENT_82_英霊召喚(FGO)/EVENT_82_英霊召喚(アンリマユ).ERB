;イベントフラグ:82:5の30番台をアンリマユ関係で使用しています

;====================
;召喚イベント条件
;====================
@FGO_SUMMON_CHECK_3
#DIM 生贄

;■召喚可否条件をここに記載することで読み込んでくれます■
;※召喚はイベントフラグ:82:1が必ず4以上から。

IF イベントフラグ:82:1 > 3
	IF GETCHARA([[キャラ:앙리마유]]) > 0
		RESULTS = 이 세상 모든 악……?(앙리마유)
		RESULTS:1 = 필요 촉매：마왕 앙리・만유(함락됨)　앙리마유 가입 완료
		RETURN 0
	ELSEIF GETCHARA([[キャラ:앙리・만유]]) > 0
		IF !陥落(GETCHARA([[キャラ:앙리・만유]]))
			RESULTS = 이 세상 모든 악……?(앙리마유)
			RESULTS:1 = 필요 촉매：마왕 앙리・만유(함락됨)　미함락
			RETURN 0
		ELSE
			RESULTS = 이 세상 모든 악……?(앙리마유)
			RESULTS:1 = 필요 촉매：마왕 앙리・만유(함락됨)　앙리마유 미가입
			RETURN 1
		ENDIF
	ELSE
		RESULTS = 이 세상 모든 악……?(앙리마유)
		RESULTS:1 = 필요 촉매：마왕 앙리・만유(함락됨)　미소지
		RETURN 0
	ENDIF
ELSE
	;そもこれが出ることはないはずだけど、確認用に一応記載
	RESULTS = 최초 소환 이벤트 미소화
	RETURN 0
ENDIF

;※RETURN 1　で鯖リストのBITがオンになるようにしているため、必ずRETURNを記入してください


;---- EDIT 002 ADD START ---------------------------
;====================
;生贄可否の条件確認
;====================
@FGO_SUMMON_SACRIFICE_3(ARG:0)
	;魔王アンリ・マンユ以外は不可
	SIF NO:ARG != [[キャラ:앙리・만유]]
		RETURN 0
	;未陥落は対象外
	SIF !陥落(ARG)
		RETURN 0
	SIF !FGO_SUMMON_SACRIFIE_COMMON(ARG)
		RETURN 0
	RETURN 1
;---- EDIT 002 ADD END -----------------------------


