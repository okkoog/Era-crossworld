;イベントフラグ:82:5の50番台を使用しています

;====================
;召喚イベント条件
;====================
@FGO_SUMMON_CHECK_12
#DIM LCOUNT
#DIM 達成度
#DIM L_CHARA
#DIM 召喚確率
#DIMS L_RESULTS,2

;■召喚可否条件をここに記載することで読み込んでくれます■
;※召喚はイベントフラグ:82:1が必ず4以上から。

VARSET L_RESULTS
VARSET 達成度

L_CHARA = GETCHARA([[キャラ:호타루]])
IF イベントフラグ:82:1 > 3
	RESULTS = 심부름센터 M51(사이카 마고이치)
	RESULTS:1 '= "필요 촉매：LV50 이상의 남자가 아닌 조마(함락 필요) + 국우의총"
	;造魔と国友の銃を持っていないとダメ
	IF GETCHARA([[キャラ:조마]]) == -1 || ITEM:국우의총 < 1
		RESULTS:1 = %RESULTS:1 + "　미소지"%
		RETURN 0
	;持っていた場合、条件を満たしているかチェックする
	ELSE
		;陥落関数がRESULTS:1を上書きするのでこちらで確保
		L_RESULTS '= RESULTS:0,RESULTS:1
		FOR LCOUNT,0,CHARANUM
			;造魔ではない or オトコである or レベルが50未満 or 未陥落だとNG
			SIF NO:LCOUNT != [[キャラ:조마]] || IS_MALE(LCOUNT) || BASE:LCOUNT:LV < 50 || !陥落(LCOUNT)
				CONTINUE
			;上記条件達成していたら達成度に+1
			達成度 = 1
			BREAK
		NEXT
		;確保してた文字列をRESULTSに戻す
		RESULTS '= L_RESULTS:0,L_RESULTS:1
	ENDIF
	;達成度が足りてないとNG
	IF 達成度 < 1
		RESULTS:1 = %RESULTS:1 + "　조건 미달성"%
		RETURN 0
	;達成度が足りてた場合、鯖が召喚済み尚且つ宝具再臨が上限まで到達しているとNG
	ELSEIF L_CHARA > -1 && GET_RPG_CFLAG_TAKEOVER(L_CHARA,"宝具再臨") >= 4
		RESULTS:1 '= "보구 최종재림 도달 완료"
		RETURN 0
	ENDIF
	;ここまでくれば召喚可能
	;雑賀孫一が加入してるか否かで表示メッセージを変更
	IF L_CHARA == -1
		RESULTS:1 = %L_RESULTS:1 + "　사이카 마고이치 미가입"%
	ELSE
		召喚確率 = AUTO_SPLIT_INT("40_30_25_20","_",GET_RPG_CFLAG_TAKEOVER(L_CHARA,"宝具再臨"))
		RESULTS:1 = %"보구 재림 실행 가능　" + "성공률：" + TOSTR(召喚確率) + "％"%
	ENDIF
	RETURN 1
ELSE
	;そもこれが出ることはないはずだけど、確認用に一応記載
	RESULTS = 최초 소환 이벤트 미소화
	RETURN 0
ENDIF

;※RETURN 1　で鯖リストのBITがオンになるようにしているため、必ずRETURNを記入してください

;====================
;生贄可否の条件確認
;====================
@FGO_SUMMON_SACRIFICE_12(ARG:0)
;造魔以外は不可
SIF NO:ARG != [[キャラ:조마]]
	RETURN 0
;オトコ素質所持者は対象外
SIF IS_MALE(ARG)
	RETURN 0
;LV50未満は対象外
SIF BASE:ARG:LV < 50
	RETURN 0
;未陥落は対象外
SIF !陥落(ARG)
	RETURN 0
SIF !FGO_SUMMON_SACRIFIE_COMMON(ARG)
	RETURN 0
RETURN 1


;====================
;蛍ちゃん召喚
;====================
