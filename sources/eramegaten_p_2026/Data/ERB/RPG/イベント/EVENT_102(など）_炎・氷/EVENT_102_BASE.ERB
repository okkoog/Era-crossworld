@GET_EVENT_NAME_102
#FUNCTIONS
RESULTS_F '= "데빌칠드런炎・氷"
RETURNF RESULTS_F

@PLAYABLE_EVENT_102

IF ダンジョンフラグ:97:0 == 1 && イベントフラグ:102:0 == 0
	RESULTS = 프롤로그, 시간의 틈새에서
	RETURN 1
;ランドを仲魔にしたルート=========================================================================================================================================================================
ELSEIF イベントフラグ:102:0 == 1 && イベントフラグ:102:1 == 1
	;天界へ
	RESULTS = 하이에스트 피크
	RETURN 1
ELSEIF イベントフラグ:102:0 == 2
	RESULTS = 얼음의 끝에서
	RETURN 1
ENDIF

;ゲイルを仲魔にしたしたルート===================================================================================================================================================================
IF イベントフラグ:102:0 == 4 && イベントフラグ:102:1 == 2
	;魔界へ
	RESULTS = 빼앗긴 딥 홀
	RETURN 1
ENDIF
IF イベントフラグ:102:0 == 5
	RESULTS = 불꽃의 끝에서
	RETURN 1
ENDIF
RETURN 0

;====================
;内容
;====================
@SHOPCOM_EVENT_102
CALL RESET_ANNOUNCE_FLAG

IF イベントフラグ:102:0 == 0
	CALL EVENT_102_0
ELSEIF イベントフラグ:102:0 == 1
	CALL EVENT_102_1
ELSEIF イベントフラグ:102:0 == 2
	CALL EVENT_102_2

ELSEIF イベントフラグ:102:0 == 4
	CALL EVENT_102_4
ELSEIF イベントフラグ:102:0 == 5
	CALL EVENT_102_5
ENDIF

