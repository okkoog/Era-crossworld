		CFLAG:ARG:입력행동 = [[스킬:철사권]]
	ELSEIF RAND:5 == 0
		CFLAG:ARG:입력행동 = [[스킬:네거티브파일]]
	ELSEIF RAND:4 == 0
		CFLAG:ARG:입력행동 = [[스킬:헬스트라이크]]
	ELSEIF RAND:3 == 0
		CFLAG:ARG:입력행동 = [[스킬:데스샤워]]
	;ガードなんぞしてんじゃねぇ！！！
	;死亡告知以外のターンでのガードを咎める
	ELSEIF RAND:2 == 0
		CFLAG:ARG:입력행동 = [[스킬:오의방어부수기]]
	;わりと状態異常が多いため咎めに行く
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:약자필멸권]]
	ENDIF
ENDIF


;アクション実行不能
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1



