;通常行動
ELSE
	IF 0
	ELSEIF RAND:10 == 0 && EVENT_41_2_5_Ayame_DeadEnd != 0
		CFLAG:ARG:입력행동 = [[스킬:명계의문]]
	ELSEIF RAND:9 == 0 && EVENT_41_2_5_Ayame_DeadEnd != 0
		CFLAG:ARG:입력행동 = [[스킬:무드바리온]]
