@SET_ACTION_EVENT_41_2_5_KAGOME, ARG
;=======================================================================
;08：斑女
;→2回行動
;　剣撃攻撃がメイン、アイテムを使用
;　自身のHPが50％以下になると1回だけ宝玉輪（＝メディアラハン）を使用
;　綾女、籠女のどちらかが死んでる場合、1回だけ反魂香を使用
;　「데카쟈의돌」「데쿤다의돌」を適切なタイミングで使用する。
;　ただし個数制限アリ（石は合計で6回まで）
;=======================================================================
#DIM EVENT_41_4_KAGOME_Bead_Chain
#DIM EVENT_41_4_KAGOME_Flag_BalmOfRising
#DIM EVENT_41_4_KAGOME_Stone
#DIM EVENT_41_4_KAGOME_Flag_DekundaStone
#DIM EVENT_41_4_KAGOME_Flag_DekajaStone

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

;デカジャンダの石の使用フラグを初期化
EVENT_41_4_KAGOME_Flag_DekundaStone = 0
EVENT_41_4_KAGOME_Flag_DekajaStone = 0


	;デクンダチェック
	;自分が2段弱体化していたら使用
	IF CFLAG:ARG:공격강화 < -4 || CFLAG:ARG:방어강화 < -4 || CFLAG:ARG:마법위력강화 < -4 || CFLAG:ARG:명중강화 < -4 || CFLAG:ARG:회피강화 < -4
		EVENT_41_4_KAGOME_Flag_DekundaStone = 1
	ENDIF

	;デカジャチェック
	LOCAL:3 = 0
	FOR LOCAL, 1, 7
		SIF POS(LOCAL) < 0
			CONTINUE
		SIF CFLAG:POS(LOCAL):공격강화 > 0
			LOCAL:3 += CFLAG:POS(LOCAL):공격강화
		SIF CFLAG:POS(LOCAL):방어강화 > 0
			LOCAL:3 += CFLAG:POS(LOCAL):방어강화
		SIF CFLAG:POS(LOCAL):마법위력강화 > 0
			LOCAL:3 += CFLAG:POS(LOCAL):마법위력강화
		SIF CFLAG:POS(LOCAL):마법효과강화 > 0
			LOCAL:3 += CFLAG:POS(LOCAL):마법효과강화
		SIF CFLAG:POS(LOCAL):회피강화 + CFLAG:POS(LOCAL):명중강화 > 0
			LOCAL:3 += (CFLAG:POS(LOCAL):회피강화 + CFLAG:POS(LOCAL):명중강화) / 2
	NEXT

	;PT6名の強化平均が+2(内部的には+8)以上＝5か所が+2(+8)以上、なので6*8*5、でLOCAL3が240以上ならデカジャの石を使用するフラグをオン
	SIF LOCAL:3 >= 240
		EVENT_41_4_KAGOME_Flag_DekajaStone = 1

	;※ただしデカジャデクンダの石は合計で6個まで（6回までしか使用しない）

	;ワンモアが入ると気合
	IF CFLAG:ARG:１more플래그 > 0
		CFLAG:ARG:입력행동 = [[스킬:기합]]
		;こっそり石の使用個数が回復してもいいかな……

	;HP50％以下
	ELSEIF 現HP割合(ARG) < 51 && EVENT_41_4_KAGOME_Bead_Chain == 0
		;1回だけ宝玉輪を使用
		CFLAG:ARG:입력행동 = [[스킬:보옥륜]]
		EVENT_41_4_KAGOME_Bead_Chain = 1
	;誰かが死んでたら反魂香（1回だけ）
	ELSEIF EVENT_41_4_KAGOME_Flag_BalmOfRising == 0
		;使えるなら反魂香
		CFLAG:ARG:입력행동 = SKILL_NUM_F("반혼향")
		CFLAG:ARG:타겟 = -1
		CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
		;タゲ発見できたりしたら１を返す
		IF RESULT
			EVENT_41_4_KAGOME_Flag_BalmOfRising = 1
			RETURN 1
		ENDIF

		;ダメなら通常行動へ
		GOTO DECIDE_ACTION

	;その他RAND
	ELSE
		$DECIDE_ACTION
		;石使用回数が6未満、かつデカジャ石使用フラグが立ってる
		IF EVENT_41_4_KAGOME_Flag_DekajaStone == 1 && EVENT_41_4_KAGOME_Stone < 6
			CFLAG:ARG:입력행동 = [[스킬:데카쟈의돌]]
			;石の使用回数+1
			EVENT_41_4_KAGOME_Stone += 1
		;石使用回数が6未満、かつデクンダ石使用フラグが立ってる
		ELSEIF EVENT_41_4_KAGOME_Flag_DekundaStone == 1 && EVENT_41_4_KAGOME_Stone < 6
			CFLAG:ARG:입력행동 = [[스킬:데쿤다의돌]]
			;石の使用回数+1
			EVENT_41_4_KAGOME_Stone += 1
		;以下、攻撃スキルを使用
		ELSEIF RAND:5 == 0
			CFLAG:ARG:입력행동 = [[스킬:밤벚꽃의춤]]
		ELSEIF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:어둠속의기습]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:물반경]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:산산조각베기]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:암파쌍비조]]
		ENDIF
	ENDIF


	;アクション実行不能
	CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
	SIF RESULT == 0
		CFLAG:ARG:입력행동 = 0
	;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
	SIF CFLAG:ARG:타겟 == -1
		CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
	RETURN 1




