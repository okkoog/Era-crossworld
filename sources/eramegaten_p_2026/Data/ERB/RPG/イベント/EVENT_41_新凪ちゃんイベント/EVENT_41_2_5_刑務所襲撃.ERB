ELSEIF EVENT_41_2_5_Ayame_DeadEnd == 1 || (FLAG:경과턴수 % 3 == 0 && EVENT_41_2_5_Ayame_DeadEnd == 2)
	IF CFLAG:ARG:행동한횟수 == 0
