;=======================================================================
@SET_ACTION_EVENT_41_1_3_Orphan, ARG
;=======================================================================
;取り巻きが全員死ぬと本気を出す
;=======================================================================
#DIM 生存人数
#DIM 本気度

	;入力行動を-1とターゲットを-1にしておく
	CFLAG:ARG:입력행동 = -1
	CFLAG:ARG:타겟 = -1


	;敵生存人数の感知
	生存人数 = 0
	FOR LOCAL,7,17
		SIF POS(LOCAL) < 0
			CONTINUE
		生存人数++
	NEXT

	IF 生存人数 == 1 && 本気度 == 0
		本気度 = 1
		CFLAG:ARG:행동횟수 = 3
		PRINTFORML ┏>오펀 ━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃호오……? 제법이군……　　　　　　　　　　　　　　　　┃
		PRINTFORML ┃흥미롭군. 조금은 즐겁게 해 봐라　　　　　　　　　　　　┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF

	IF 0
	;あたり：もう一回
	ELSEIF CFLAG:ARG:１more플래그 > 0
		CFLAG:ARG:입력행동 = [[스킬:즌바라린]]
	;本気を出さない限りほとんど攻撃してこない（やる気がない）（でもめんどくさい置物ではある）
	ELSEIF CFLAG:ARG:행동한횟수 == 0
		IF 0
		;４ターンに１回イニシャライズ
		ELSEIF FLAG:경과턴수 % 4 == 0
			CFLAG:ARG:입력행동 = [[스킬:이니셜라이즈]]
		ELSEIF FLAG:경과턴수 % 3 == 0
			CFLAG:ARG:입력행동 = [[스킬:결계부・물리]]
		ELSEIF FLAG:경과턴수 % 2 == 0
			CFLAG:ARG:입력행동 = [[스킬:결계부・마법]]
		ELSE
			CALL ランダム行動, ARG
		ENDIF
	ELSE
		;以下ランダム行動
		CALL ランダム行動, ARG
	ENDIF



	;アクション実行不能
	CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
	SIF RESULT == 0
		CFLAG:ARG:입력행동 = 0
	;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
	SIF CFLAG:ARG:타겟 == -1
		CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
	RETURN 1







