			CFLAG:ARG:입력행동 = [[스킬:이니셜라이즈]]
		ELSEIF FLAG:경과턴수 % 6 == 4
			CFLAG:ARG:입력행동 = [[스킬:결계부・물리]]
		ELSEIF FLAG:경과턴수 % 6 == 3
			CFLAG:ARG:입력행동 = [[스킬:4대소환]]
		ELSEIF FLAG:경과턴수 % 6 == 2
			;３ターンに１度、確定行動
			CFLAG:ARG:입력행동 = [[스킬:이니셜라이즈]]
		ELSEIF FLAG:경과턴수 % 6 == 1
			CFLAG:ARG:입력행동 = [[스킬:결계부・마법]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:오니야라이]]
		ENDIF
	;オーファン行動２
	ELSEIF CFLAG:ARG:행동한횟수 == 0
		IF 0
		ELSEIF FLAG:경과턴수 % 6 == 5
			CFLAG:ARG:입력행동 = [[스킬:기합]]
		ELSEIF FLAG:경과턴수 % 6 == 4
			CFLAG:ARG:입력행동 = [[스킬:용권지옥]]
		ELSEIF FLAG:경과턴수 % 6 == 3
			CFLAG:ARG:입력행동 = [[스킬:천년의저주]]
		ELSEIF FLAG:경과턴수 % 6 == 2
			CFLAG:ARG:입력행동 = [[스킬:소작권]]
		ELSEIF FLAG:경과턴수 % 6 == 1
			CFLAG:ARG:입력행동 = [[스킬:지옥의업화]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:허공참파]]
		ENDIF
	;ベヒモス行動
	ELSE
		IF 0
		ELSEIF !RAND:7
			CFLAG:ARG:입력행동 = [[스킬:명계의문]]
		ELSEIF !RAND:6
			CFLAG:ARG:입력행동 = [[스킬:광란의강조]]
		ELSEIF !RAND:5
			CFLAG:ARG:입력행동 = [[스킬:마구날뛰기]]
		ELSEIF !RAND:4
			CFLAG:ARG:입력행동 = [[스킬:모탈지하드]]
		ELSEIF !RAND:3
			CFLAG:ARG:입력행동 = [[스킬:지모의만찬]]
		ELSEIF !RAND:2
			CFLAG:ARG:입력행동 = [[스킬:암파쌍비조]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:산산조각베기]]
		ENDIF
	ENDIF

	;アクション実行不能
	CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
	SIF RESULT == 0
		CFLAG:ARG:입력행동 = 0
	;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
	SIF CFLAG:ARG:타겟 == -1
		CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
	RETURN 1



