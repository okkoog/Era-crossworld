;			PRINTFORML デバッグ：火炎ターンだよ～
;		;現在ターン数が6n+2：氷結
;		ELSEIF FLAG:경과턴수 % 6 == 2
;			PRINTFORML デバッグ：氷結ターンだよ～
;		;現在ターン数が6n+3：電撃
;		ELSEIF FLAG:경과턴수 % 6 == 3
;			PRINTFORML デバッグ：電撃ターンだよ～
;		;現在ターン数が6n+4：衝撃
;		ELSEIF FLAG:경과턴수 % 6 == 4
;			PRINTFORML デバッグ：衝撃ターンだよ～
;		;現在ターン数が6n+5：万能
;		ELSEIF FLAG:경과턴수 % 6 == 5
;			PRINTFORML デバッグ：万能ターンだよ～
;		ENDIF
	ENDIF

	;具体的な行動
	IF 0
	;ワンモア一丁はいりまーす！！！ってとき
	ELSEIF CFLAG:ARG:１more플래그 > 0
		;発狂ポイント加算
		EV41_Clarion_発狂ポイント += 1
		;ランダムで魔力増大
		IF RAND:5 == 0
			;CSTR専用スキル0：「クラリオンの魔力が増大していく！」
			CFLAG:ARG:입력행동 = 3904
