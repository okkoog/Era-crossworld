;================================================================================================================
;메모
;================================================================================================================
;나기 동료 루트: 강제 종료
;도중에 나기의 신뢰를 배신했을 경우 이쪽으로 진입
;================================================================================================================


@EVENT_41_1_98
#DIM NAGI_NO
#DIM KUSHI_NO

	CALLF FINDCHARA_B([[キャラ:나기]])
	LOCAL = RESULT:1
	NAGI_NO = GETCHARA([[キャラ:나기]])

	CALLF FINDCHARA_B([[キャラ:쿠시나다]])
	LOCAL = RESULT:1
	KUSHI_NO = GETCHARA([[キャラ:쿠시나다]])



	PRINTFORMW 
	;쿠시나다 히메를 가로챘다
	IF イベントフラグ:41:12 == 4
		PRINTFORML ＞……아무래도 %CALLNAME:MASTER%는 나기의 신뢰를 배신한 모양이다.
		PRINTFORMW 
		PRINTFORML 　나기
		PRINTFORML 「……지금까지의 지도에 감사드리는 프로세스입니다, %CALLNAME:MASTER% 님.
		PRINTFORML 　아니, 팬텀 소사이어티의 다크 서머너 님」
		PRINTFORMW 
		PRINTFORML ＞나기는 그렇게 결별을 고해왔다.
		PRINTFORML ＞자주 %CALLNAME:MASTER%의 사무소에 얼굴을 비추던 나기지만, 이제 두 번 다시 이렇게 찾아오는 일은 없으리라.
		PRINTFORMW 

		;쿠시나다가 있고, 함락 완료
		IF KUSHI_NO > 0 && 陥落(KUSHI_NO)
			PRINTFORML 　쿠시나다 히메
			PRINTFORML 「있잖아, 나기……」
			PRINTFORMW 
			PRINTFORML ＞%CALLNAME:MASTER%의 곁에 앉아 있던 쿠시나다 히메가 하얀 뺨을 붉히며 말했다.
			PRINTFORMW 
			PRINTFORML 　쿠시나다 히메
			PRINTFORML 「확실히 꽤 억지로 끌려오긴 했지만, 험한 짓은――
			PRINTFORML 　――음, 으음, 조, 조금밖에 안 당했다 아이가」
			PRINTFORMW 
			PRINTFORML ＞자기가 먼저 참견해 놓고 스스로 자폭하는 건 대체 무슨 경우인가.
			PRINTFORML ＞변호가 되는지 안 되는지 모를 소리를 늘어놓고는 쿠시나다 히메는 뺨에 손을 얹었다.
			PRINTFORMW 
			PRINTFORML 　쿠시나다 히메
			PRINTFORML 「앗! 시, 싫은 건 아이다, 진짜로, 진짜.
			PRINTFORML 　내, 조, 조금 곤란하긴 한데에……」
			PRINTFORMW 
			PRINTFORML 　나기
			PRINTFORML 「……%CALLNAME:MASTER% 님」
			PRINTFORMW 
			PRINTFORML ＞나기가 노려보아 온다……
			PRINTFORML ＞이 적의는 쿠시나다 히메를 집적거렸다는 사실을 들킨 탓일까.
			PRINTFORMW 
			PRINTFORML ＞신뢰를 저버린 것은 사실이다.
			PRINTFORML ＞나기가 분노하는 것도 지극히 당연한 일.
			PRINTFORML ＞다음에 만날 때는 서로 적이다.
			PRINTFORML ＞%CALLNAME:MASTER%의 말에 나기는 고개를 끄덕이고 자리에서 일어났다.
			PRINTFORMW 
			PRINTFORML ＞더 이상 얼굴도 마주하기 싫다는 태도다.
			PRINTFORML ＞그토록 신뢰를 보내주었거늘, 입장의 차이, 태도의 차이란 참으로 잔혹한 법이다.
		ELSEIF KUSHI_NO > 0 && !陥落(KUSHI_NO)
			PRINTFORML ＞쿠쿠리 가문의 쿠시나다 히메《串蛇媛》는 틀림없이 %CALLNAME:MASTER%가 보호하겠다――
			PRINTFORML ＞약속하마, 라고 말하자 나기는 살짝 표정을 풀었다.
			PRINTFORMW 
			PRINTFORML ＞뭐, 그녀의 신병은 어찌 되었든 순결 따위는 아무것도 약속하지 않았지만.
			PRINTFORML ＞그것을 굳이 지금 입 밖에 낼 필요는 없으리라.
			PRINTFORMW 
			PRINTFORML ＞신뢰를 저버린 것은 사실이다.
			PRINTFORML ＞나기가 분노하는 것도 지극히 당연한 일.
			PRINTFORML ＞다음에 만날 때는 서로 적이다.
			PRINTFORML ＞%CALLNAME:MASTER%의 말에 나기는 고개를 끄덕이고 자리에서 일어났다.
			PRINTFORMW 
			PRINTFORML 　나기
			PRINTFORML 「건강하십시오, %CALLNAME:MASTER% 님.
			PRINTFORML 　가능하다면, ……다음에도 또 아군으로서 만나고 싶은 세오리입니다」
			PRINTFORMW 
			PRINTFORML ＞%CALLNAME:MASTER%는 고개를 끄덕였지만, 무리겠지, 라고 답했다.
			PRINTFORML ＞나기는 사무소를 빠져나가려 걸음을 옮긴다.
		;쿠시나다가 이미 없음
		ELSE
			PRINTFORML ＞쿠쿠리 가문의 쿠시나다 히메《串蛇媛》를 코도쿠노 마레비토 녀석들이 손에 넣는 일은 이제 없다.
			PRINTFORML ＞그것만은 확실하다.
			PRINTFORML ＞――이미 마계 호사가의 손아귀에 떨어진 자를 그들이 어찌 손에 넣겠는가.
			PRINTFORMW 
			PRINTFORML 　나기
			PRINTFORML 「윽, %CALLNAME:MASTER% 님은……!」
			PRINTFORMW 
			PRINTFORML ＞나기는 격분하여 일어서더니, ……고개를 내젓고는 발길을 돌렸다.
		ENDIF
		PRINTFORML ＞%CALLNAME:MASTER%는 걸어가다 넘어질 테니 조심하라고 말을 건넨다.
		PRINTFORMW 
		PRINTFORML 　나기
		PRINTFORML 「에……?」
		PRINTFORMW 
		PRINTFORML ＞뒤를 돌아본 나기가 스르륵 힘없이 무너져 내렸다.
		PRINTFORML ＞%CALLNAME:MASTER%는 팬텀 소사이어티 소속의 다크 서머너다.
		PRINTFORML ＞그 사무소에 단신으로 찾아온 어여쁜 소녀――
		PRINTFORML ＞――독니에 걸려드는 것이 당연하지 않겠는가.
		PRINTFORMW 
		PRINTFORML ＞나기는 절망에 찬 표정으로 %CALLNAME:MASTER%를 올려다보았다.
		PRINTFORML  
		PRINTFORML  
		PRINTFORML ＞……나기를 노예로 삼았다.
	ELSE
	ENDIF

	CALL AA_EV41_tenten
	PRINTFORML ＞그로부터 얼마 지나지 않아 비밀결사 코도쿠노 마레비토가 괴멸했다는 정보를 입수했다.
	PRINTFORML ＞해치운 것은 쿠즈노하 라이도…… 역시나 무시무시한 사내다.
	PRINTFORMW  
	PRINTFORML ＞야타가라스의 눈 밖에 난다는 것은 곧 쿠즈노하 라이도의 표적이 된다는 뜻이다.
	PRINTFORML ＞표적이 될 빌미를 만들어 버렸지만…… 뭐, 새삼스러운 일이다.
	PRINTFORML ＞오늘도 다크 서머너 본업에 충실히 매진하기로 하자.

	;나기가 함락되지 않았다면
	IF !陥落(NAGI_NO)
		;PT에서 이탈
		SIF CPOS(NAGI_NO) > 0
			CALL REMOVE_POSITION,CPOS(NAGI_NO)
		;전투 참가 불가능
		CALL SET_TALENT_PARTY_JOINABLE, NAGI_NO, "참가불가능"
	ENDIF

	;이벤트 종료
	イベントフラグ:41:0 = 99
	イベントフラグ:41:1 = 99
