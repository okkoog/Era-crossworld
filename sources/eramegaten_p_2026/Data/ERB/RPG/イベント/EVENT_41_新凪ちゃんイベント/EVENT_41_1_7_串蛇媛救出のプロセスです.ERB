	CFLAG:LOCAL:ＨＰ보정 += 50000
	CFLAG:LOCAL:ＭＰ보정 += 50000
	CFLAG:LOCAL:명중보정 += 25
	;はちゃめちゃに脚が遅い
	CFLAG:LOCAL:속도보정 -= 100

	;反射：物理４種、呪殺
	;耐性：
	;無効：
	;弱点：火炎、氷結、電撃、衝撃、破魔
	;ギリメカラはギリメカラなので。
	BASE:LOCAL:검격 = 999
