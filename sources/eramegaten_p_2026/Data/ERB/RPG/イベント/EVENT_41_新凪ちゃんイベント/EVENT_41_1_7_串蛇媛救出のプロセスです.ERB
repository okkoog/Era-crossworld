@EVENT_41_6_EightShoJin
;=======================================================================
;合体八神将をセットしてバトル
;レベルは生き残りの八神将の数で変動
;まあレベル90にしてあげた方が美味しいと思いますよ、弱いので……
;=======================================================================
#DIM EIGHT_LV

	;最低レベルは70
	EIGHT_LV = 70
	;100で割って３桁目を取り出す
	LOCAL = イベントフラグ:41:11 / 100
	;１番目の選択肢＝生き残らせる選択肢であるならLv＋５
	SIF LOCAL == 1
		EIGHT_LV += 5

	;10で割ってから、10で割ったあまりを見て２桁目を取り出す
	LOCAL = イベントフラグ:41:11 / 10
	LOCAL = LOCAL % 10
	;１番目の選択肢＝生き残らせる選択肢であるならLv＋５
	SIF LOCAL == 1
		EIGHT_LV += 5

	;10で割った余りを見て１桁目を取り出す
	LOCAL = イベントフラグ:41:11 % 10
	;１番目の選択肢＝生き残らせる選択肢であるならLv＋10
	SIF LOCAL == 1
		EIGHT_LV += 10
	
	;これ素直に「１１１」見ればいいのでは？　って思うじゃん
	;その通りですね

	;ショウテン（ギリメカラで代理）
	;もとはLv54
	;原作ではコイツが核（そして綾女に瞬殺された）
	;AI？あるわけねーだろ
	;행동횟수？１回だよ、七英雄じゃないんだから
	CALL SET_ENEMY, 9, [[キャラ:기리메칼라]],EIGHT_LV,1,1
	;きゃらなむをLOCALに保存
	LOCAL = CHARANUM - 1
	NAME:LOCAL = 합체 팔신장
	CALLNAME:LOCAL = 합체 팔신장
