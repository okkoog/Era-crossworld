@SKILL_PASSIVE_PENETRATION_RANK_EVENT_41_1_5_VS_YAMADA, L_P, L_T, L_スキル, L_ダメージタイプ, L_攻撃タイプ, L_相性, GIVE_EFFECT_CHARA
