;		ELSEIF FLAG:경과턴수 % 6 == 0
;			IF RAND:2 == 0
;				CFLAG:ARG:입력행동 = [[스킬:화염가드브레이크]]
;			ELSE
;				CFLAG:ARG:입력행동 = [[스킬:화염가드킬]]
;			ENDIF
		ELSE
			CALL ランダム行動, ARG
		ENDIF
	ELSE
		;以下ランダム行動
		CALL ランダム行動, ARG
	ENDIF



	;アクション実行不能
	CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
	SIF RESULT == 0
		CFLAG:ARG:입력행동 = 0
	;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
	SIF CFLAG:ARG:타겟 == -1
		CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
	RETURN 1

