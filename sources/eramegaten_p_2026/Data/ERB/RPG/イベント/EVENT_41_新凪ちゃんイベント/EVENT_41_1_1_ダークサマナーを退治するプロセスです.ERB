			ITEM:[[アイテム:소마]] = 1
		ENDIF

		BASE:(LOCAL):충성도 += 500

		;나기가 셀프 수행한 프로세스입니다.
		イベントフラグ:41:4 = 1
		CALL EVENT_41_Nagi_Learn_Skill

		;이벤트 진행
		イベントフラグ:41:1 = 2
	ENDIF




