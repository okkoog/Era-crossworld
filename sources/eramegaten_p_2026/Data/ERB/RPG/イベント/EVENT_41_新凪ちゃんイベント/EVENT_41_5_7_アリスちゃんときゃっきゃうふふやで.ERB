		PRINTFORML ┃꺄하하하하하하하하하하하하하하하!! 　　　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF

	IF 0
	ELSEIF FLAG:경과턴수 > 10
		;10ターンで強制終了
		FLAG:승리플래그 = 0
		FLAG:도주플래그 = 1
		CALL BATTLE_END
		RETURN 0
	;ワンモア一丁はいりまーす！！！ってとき
	ELSEIF CFLAG:ARG:１more플래그 > 0
		;呪殺耐性がない？　はー（溜息）
		;くたばれもしくは死ねェ！！！
		CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
	ELSEIF CFLAG:ARG:행동한횟수 == 0
		IF 0
		;偶数ターン
		ELSEIF FLAG:경과턴수 % 2 == 0
			;単体対象です、まあさすがにね
			CFLAG:ARG:입력행동 = [[스킬:주살가드킬]]
		ELSE
			;呪い付与、呪いは即死防御貫通よん
			CFLAG:ARG:입력행동 = [[스킬:저주비문]]
		ENDIF
	ELSE
		IF 0
		;偶数ターン
		ELSEIF FLAG:경과턴수 % 2 == 0
			;死ぬかオトモダチになるか選べィ
			CFLAG:ARG:입력행동 = [[스킬:죽어줄래？]]
		ELSE
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:저주비문]]
			ELSE
				;さらっとバリオン
				CFLAG:ARG:입력행동 = [[스킬:마하에이바리온]]
			ENDIF
		ENDIF
	ENDIF

	;アクション実行不能
	CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
	SIF RESULT == 0
		CFLAG:ARG:입력행동 = 0
	;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
	SIF CFLAG:ARG:타겟 == -1
		CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
	RETURN 1



