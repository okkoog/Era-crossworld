;勝つとほんのちょっとご褒美アリ
;あと「素は弱い」みたいなのを示すためレベルは低め
;=======================================================================
#DIM Eight_Lv
	;Lv設定
	Eight_Lv = 45

	;ラクサーシャ
	;元のレベルは30
	CALL SET_ENEMY, 8, [[キャラ:락샤사]],Eight_Lv,1,1
	LOCAL = CHARANUM - 1
	NAME:LOCAL = 타케히로
	CALLNAME:LOCAL = 타케히로
	CSTR:LOCAL:종족명 = 팔신장
	CFLAG:LOCAL:ＨＰ보정 += 1000
	;耐性：戦技、火炎、電撃、水撃、疾風
	;無効：破魔
	;弱点：氷結、呪殺、地変、核熱
	;→耐性になってるのを25％まで下げる
	BASE:LOCAL:검격 = 100
	BASE:LOCAL:비구 = 100
	BASE:LOCAL:타격 = 100
	BASE:LOCAL:전술 = 25
	BASE:LOCAL:화염 = 25
	BASE:LOCAL:빙결 = 150
	BASE:LOCAL:전격 = 25
	BASE:LOCAL:충격 = 100
	BASE:LOCAL:신경 = 100
	BASE:LOCAL:정신 = 100
	BASE:LOCAL:파마 = 0
	BASE:LOCAL:주살 = 200
	BASE:LOCAL:지변 = 125
	BASE:LOCAL:수격 = 25
	BASE:LOCAL:질풍 = 25
	BASE:LOCAL:중력 = 100
	BASE:LOCAL:핵열 = 125
	;スキルをリセットする
	CALL EVENT_41_Skill_Reset(LOCAL)

	ABL:LOCAL:스킬1 = [[스킬:산산조각베기]]
	ABL:LOCAL:스킬2 = [[스킬:즌바라린]]
	ABL:LOCAL:스킬3 = [[스킬:텐타라후]]
	ABL:LOCAL:스킬4 = [[스킬:화쇄열풍파]]
	ABL:LOCAL:스킬5 = [[스킬:구십구나선격]]
	ABL:LOCAL:스킬6 = [[스킬:길로틴블레이드]]
	ABL:LOCAL:스킬7 = [[스킬:철사권]]
	ABL:LOCAL:스킬8 = 0
	CALL SYNC_STATUS,LOCAL
	CALL HEALTH_CHARA,LOCAL



	;アタバク（フドウミョウオウで代理）
	;元のLvは66
	CALL SET_ENEMY, 10, [[キャラ:부동명왕]],Eight_Lv,1,1
	LOCAL = CHARANUM - 1
	NAME:LOCAL = 마가라
	CALLNAME:LOCAL = 마가라
	CSTR:LOCAL:종족명 = 팔신장
	CFLAG:LOCAL:ＨＰ보정 += 1500
	;耐性：物理、電撃、衝撃、地変、疾風、重力
	;無効：火炎、破魔、呪殺、核熱
	;弱点：氷結、神経、精神、水撃
	;さすがにLv66が元だけあってなかなか強力。
	;正直他との格差があるが、まあよかんべ。
	BASE:LOCAL:검격 = 50
	BASE:LOCAL:비구 = 50
	BASE:LOCAL:타격 = 50
	BASE:LOCAL:전술 = 50
	BASE:LOCAL:화염 = 999
	BASE:LOCAL:빙결 = 200
	BASE:LOCAL:전격 = 75
	BASE:LOCAL:충격 = 75
	BASE:LOCAL:신경 = 125
	BASE:LOCAL:정신 = 125
	BASE:LOCAL:파마 = 0
	BASE:LOCAL:주살 = 0
	BASE:LOCAL:지변 = 75
	BASE:LOCAL:수격 = 150
	BASE:LOCAL:질풍 = 75
	BASE:LOCAL:중력 = 75
	BASE:LOCAL:핵열 = 999
	BASE:LOCAL:만능 = 100
	;スキルをリセットする
	CALL EVENT_41_Skill_Reset(LOCAL)
	;利剣乱舞、劫火召喚、炎の乱舞、マハンマバリオン、炎の壁、曳光倶利伽羅蹴、くりからの黒龍
	;元からかなり強い。炎の壁は「おまえがやることじゃない」ということでカットしようかと思ったが、あまり頭はよくなさそうなので、そのまま使用させる
	;利剣乱舞だけ弱い（というか低レベル向けの）スキルであるが、だからって虚空斬波とかにするとマジでヤバいと思われるため。
	ABL:LOCAL:스킬1 = [[스킬:이검난무]]
	ABL:LOCAL:스킬2 = [[스킬:겁화소환]]
	ABL:LOCAL:스킬3 = [[스킬:불꽃의난무]]
	ABL:LOCAL:스킬4 = [[스킬:마한마바리온]]
	ABL:LOCAL:스킬5 = [[스킬:불의벽]]
	ABL:LOCAL:스킬6 = [[스킬:예광구리가라축]]
	ABL:LOCAL:스킬7 = [[스킬:쿠리카라의흑룡]]

	CALL SYNC_STATUS,LOCAL
	CALL HEALTH_CHARA,LOCAL



	FLAG:도주불가플래그 = 1
	FLAG:회화불능플래그 = 1
	FLAG:선제기습취소 = 1

	CALL BATTLE_START

	FLAG:도주불가플래그 = 0
	FLAG:회화불능플래그 = 0
	FLAG:선제기습취소 = 0
	FORCEWAIT











