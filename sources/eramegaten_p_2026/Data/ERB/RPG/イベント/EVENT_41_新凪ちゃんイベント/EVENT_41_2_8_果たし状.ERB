@SET_ACTION_EVENT_41_2_8_Obariyon, ARG
;=======================================================================
;2回行動予定
;衝撃系スキルと、ガンガン支援を使う
;主に支援役/ンダ系
;=======================================================================
#DIM デカジャチェック

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

	デカジャチェック = 0
	;デ・カジャチェック
	FOR LOCAL, 1, 7
		;いなかったら戻る
		SIF POS(LOCAL) < 0
			CONTINUE
		;DYINGも無視
		SIF CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("DYING")
			CONTINUE

		;強化段階が３段以上になってる能力があったらデカジャフラグセット
		FOR LOCAL:1, 0, 6
			IF CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") > 8
				デカジャチェック += 1
				BREAK
			ENDIF
		NEXT
		;一人でもいたらそれで使うぞ
		SIF デカジャチェック >= 1
			BREAK
	NEXT


	IF 0
	ELSEIF デカジャチェック >= 1
		CFLAG:ARG:입력행동 = [[스킬:데・카쟈]]
		デカジャチェック = 0
	;ワンモア一丁はいりまーす！！！ってとき
	;衝撃弱点にたまたまザンダインが刺さった時くらいか
	ELSEIF CFLAG:ARG:１more플래그 > 0
		IF 0
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:잔바리온]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:마하・잔다인]]
		ENDIF
	ELSE
		;ランダムで行動
		IF 0
		ELSEIF RAND:7 == 0
			CFLAG:ARG:입력행동 = [[스킬:잔다인]]
		ELSEIF RAND:6 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・타룬다]]
		ELSEIF RAND:5 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・스쿤다]]
		ELSEIF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・라쿤다]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・마칸다]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・사만다]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:오바리욘포효]]
		ENDIF
	ENDIF

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1


