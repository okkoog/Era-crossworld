	;以後、呪殺ターンに「死亡告知」をぶっ放してくる
	ELSEIF EV41_2_8_綾女の行動選択 == 3
		IF CFLAG:ARG:행동한횟수 == 0
			PRINTFORML ┏>『살안』의 아야메 ━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃꺼림도, 두려움도 없이, 이르는 곳마다 모조리 죽여라！　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			CFLAG:ARG:입력행동 = [[스킬:히트라이저]]
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			;ニヤリ
			CFLAG:ARG:입력행동 = [[스킬:스마일차지]]
		ELSE
			CSTR:ARG:전용기1 = 死亡告知
			CFLAG:ARG:입력행동 = 3904
			EV41_2_8_綾女殺意満点 = 1
		ENDIF
	;死亡告知ターン
	;スマイルチャージなので次の物理攻撃がクソ痛いことになるワケだな
	ELSEIF EV41_2_8_綾女の行動選択 == 2
		IF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = [[스킬:히트라이저]]
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			CFLAG:ARG:입력행동 = [[스킬:스마일차지]]
		ELSE
			CSTR:ARG:전용기1 = 死亡告知
			CFLAG:ARG:입력행동 = 3904
		ENDIF
	;呪殺ターン
	;呪殺耐性はあると思うのであまり怖くない
	ELSEIF EV41_2_8_綾女の行動選択 == 1
		;ランダムで行動
		IF 0
		ELSEIF RAND:6 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하에이바리온]]
		ELSEIF RAND:5 == 0
			CFLAG:ARG:입력행동 = [[스킬:헬즈아이]]
		ELSEIF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:암흑의난무]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:악마의위협]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:카오스엘리먼트]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:테트라프리즌]]
		ENDIF

	;物理系攻撃ターン
	ELSE
		;ランダムで行動
		IF 0
		;新月の場合、闇討ちを使用する場合がある（率高め）
		ELSEIF FLAG:월령 == 0 && RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:어둠속의기습]]
		ELSEIF RAND:6 == 0
			CFLAG:ARG:입력행동 = [[스킬:아라이소]]
		ELSEIF RAND:5 == 0
			CFLAG:ARG:입력행동 = [[스킬:길로틴페이크]]
		ELSEIF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:즌바라린]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:밤벚꽃의춤]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:암파쌍비조]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:네거티브파일]]
		ENDIF
	ENDIF

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1

