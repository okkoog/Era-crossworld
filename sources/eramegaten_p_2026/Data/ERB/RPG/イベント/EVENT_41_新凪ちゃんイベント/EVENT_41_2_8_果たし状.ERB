		ELSEIF RAND:8 == 0
			CFLAG:ARG:입력행동 = [[스킬:메가스트라이크]]
		;剣撃に攻撃が寄ってる分当然ながらテトラカーンに死ぬほど弱いので、一応の対策
		ELSEIF RAND:7 == 0
			CFLAG:ARG:입력행동 = [[스킬:테트라브레이크]]
		ELSEIF RAND:6 == 0
			CFLAG:ARG:입력행동 = [[스킬:테트라브레이크]]
		ELSEIF RAND:5 == 0
			CFLAG:ARG:입력행동 = [[스킬:배리어브레이크]]
		ELSEIF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:실드브레이크]]
		;踏み込めアクセル！
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:브레이브스텝]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:무거운공기]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:발진오보로구루마]]
		ENDIF
	ENDIF

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
