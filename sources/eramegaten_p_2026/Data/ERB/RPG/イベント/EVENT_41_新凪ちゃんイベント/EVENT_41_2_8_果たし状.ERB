;=======================================================================
@SET_ACTION_EVENT_41_2_8_HighPixie, ARG
;=======================================================================
;電撃、疾風、精神、万能、回復を使用
;コンセプトは「やることが……やることが多い……！」
;・アムリタ、デクンダ、デカジャ
;　必要な時に使用
;　必要な人数が多いほど使用率が増加
;・メディアラハン
;　10+（メディアラハン使用回数×２）ターンごとにメディアラハンを使用
;　だんだん使用間隔が伸びていく
;　『一人に集中攻撃しろよ！』というギミック
;その他、色々とやってくるが脅威度は低め、というか、すげー忙しい
;みんな！回復とデカジャデクンダとアムリタ持ちはできれば分けておこうな！
;=======================================================================
#DIM メディアラハン使用ターンカウント
#DIM メディアラハン使用間隔
#DIM 凪チーム生存人数
#DIM あなたチーム生存人数
#DIM 状態異常チェック
#DIM デカジャチェック
#DIM デクンダチェック


;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

	;初期セット、10ターン後にメディアラハンを使用
	IF メディアラハン使用ターンカウント == 0
		メディアラハン使用ターンカウント = 10
		メディアラハン使用間隔 = 10
	ENDIF

	;経過ターンが使用ターンカウントを越えたらメディアラハンを確定で使用、また10+(2×使用回数）ターンほど後に使用予約
	;（１回使用するごとに再使用までの間隔が伸びる）
	IF メディアラハン使用ターンカウント <= FLAG:경과턴수
		CFLAG:ARG:입력행동 = [[스킬:메・디아라한]]

		メディアラハン使用間隔 += 2
		メディアラハン使用ターンカウント += メディアラハン使用間隔
	ELSE
		;自軍の状態異常を確認
		;DYING、GOOD以外の味方がいたらアムリタを使うことがある
		;神経精神破魔呪殺があんまり埋まってないからねこのチーム。
		;ちなみにというか大魔宮のヘカーテ様のあたりでやってるデカジャ・デクンダの使用チェックしてるのがすげーうまくやってるので参考にできるぜ。

		;まず初期化
		凪チーム生存人数 = 0
		あなたチーム生存人数 = 0
		状態異常チェック = 0
		デクンダチェック = 0
		デカジャチェック = 0

		;アムリタ、デ・クンダを使用するかどうかのチェック
		FOR LOCAL, 7, 17
			;いなかったら戻る
			SIF POS(LOCAL) < 0
				CONTINUE
			;DYINGも無視
			SIF CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("DYING")
				CONTINUE
			;生存人数をカウント
			凪チーム生存人数 += 1
			
			;アムリタチェック
			;GOODでなければ++
			;GOOD以外のキャラが多いほどアムリタ使用率が上昇
			SIF CFLAG:POS(LOCAL):상태이상 != GET_STATE_NUM("GOOD")
				状態異常チェック += 1

			;強化段階がマイナスになっている能力をカウント
			FOR LOCAL:1, 0, 6
				SIF CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") < 0
					デクンダチェック += 1
			NEXT
		NEXT

		;デ・カジャチェック
		FOR LOCAL, 1, 7
			;いなかったら戻る
			SIF POS(LOCAL) < 0
				CONTINUE
			;DYINGも無視
			SIF CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("DYING")
				CONTINUE
			;生存人数をカウント
			あなたチーム生存人数 += 1

			;強化段階がプラスになっている能力をカウント
			FOR LOCAL:1, 0, 6
				SIF CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") > 0
					デカジャチェック += 1
			NEXT
		NEXT

		;ゼロ除算にしないおまじない
		SIF 凪チーム生存人数 < 1
			凪チーム生存人数 = 1
		SIF あなたチーム生存人数 < 1
			あなたチーム生存人数 = 1

		IF 0
		;アムリタ使用
		;状態異常にかかっているキャラがいる　かつ　「生存人数-状態異常人数-1」でRAND＝0のとき
		;（６人中ひとりが状態異常なら、RAND:(6-1)==0のとき）
		;※RAND:0はエラーが出るのでMAX関数を使ってかならずRANDは1以上にする
		ELSEIF 状態異常チェック >= 1 && RAND:(MAX(1, 凪チーム生存人数 - 状態異常チェック - 1)) == 0
			CFLAG:ARG:입력행동 = [[스킬:암리타]]
		;デ・クンダ確率使用
		;能力マイナス状態のキャラがいる　かつ　「能力数-(合計マイナス箇所/人数)」
		;（ひとりにつき５種類以上マイナスになっている能力があれば確定使用）
		ELSEIF デクンダチェック >= 1 && RAND:(MAX(1, 6 - (デクンダチェック / 凪チーム生存人数))) == 0
			CFLAG:ARG:입력행동 = [[스킬:데・쿤다]]
		;デ・カジャ確率使用
		ELSEIF デカジャチェック >= 1 && RAND:(MAX(1, 6 - (デカジャチェック / あなたチーム生存人数))) == 0
			CFLAG:ARG:입력행동 = [[스킬:데・카쟈]]
		;ワンモア一丁はいりまーす！！！ってとき
		ELSEIF CFLAG:ARG:１more플래그 > 0
			;以下のスキルを使用
			IF 0
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
			;ここまで来てファイナルヌードに対策を持たないとも考えづらいのでこれはボーナス行動
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:파이널누드]]
			ENDIF
		;RAND行動
		ELSE
			IF 0
			;たま～にメギドラオンをぶっぱなす
			ELSEIF RAND:10 == 0
				CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
			;「針の剣」で色々やってたのだが、それの再現よりは別相性で「やってたこと」の再現のほうがよかろうという感じ
			;撹乱です
			ELSEIF RAND:7 == 0
				CFLAG:ARG:입력행동 = [[스킬:브레인쉐이크]]
			ELSEIF RAND:6 == 0
				CFLAG:ARG:입력행동 = [[스킬:스카프런지]]
			ELSEIF RAND:5 == 0
				CFLAG:ARG:입력행동 = [[스킬:마하・지오다인]]
			ELSEIF RAND:4 == 0
				CFLAG:ARG:입력행동 = [[스킬:마하・갈다인]]
			;妖精フレヰム相当
			ELSEIF RAND:3 == 0
				CFLAG:ARG:입력행동 = [[스킬:아기바리온]]
			;かわいい（確信）　まあまあボーナス行動なのはFヌードと同じ
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:절세의육체]]
			;ボーナス行動なのはFヌードと同じ
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:유혹의안개]]
			ENDIF
		ENDIF
	ENDIF

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1


;=======================================================================
@SET_ACTION_EVENT_41_2_8_Nagi, ARG
;=======================================================================
;主に剣撃やカジャを使用
;3回行動想定
;剣撃メインだが、意外と相性幅が広い
;=======================================================================
#DIM MASTERの状態


;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

	;状態チェックのため初期化
	MASTERの状態 = 0
	;あなたが生きていて、剣撃・物理に耐性がある場合、対策行動をとる
	;ガードキルで対策できないものは条件から外しました
	;SIF CFLAG:CPOS(MASTER):상태이상 != GET_STATE_NUM("DYING") && (CFLAG:MASTER:검격무효화횟수 < 1 || CFLAG:MASTER:물리반사플래그 < 1 || CFLAG:MASTER:無効フラグ < 1 || CHECK_WEAKNESS(MAXBASE:MASTER:검격) <= -2)
	SIF CFLAG:MASTER:상태이상 != GET_STATE_NUM("DYING") && (CFLAG:MASTER:검격무효화횟수 || CHECK_WEAKNESS(MAXBASE:MASTER:검격) <= -2)
		MASTERの状態 = 1
	IF 0
	;ワンモア一丁はいりまーす！！！ってとき
	ELSEIF CFLAG:ARG:１more플래그 > 0
		IF 0
		ELSEIF (CFLAG:ARG:공격강화 + CFLAG:ARG:명중강화) <= 32
			CFLAG:ARG:입력행동 = [[스킬:파워브레스]]
		ELSEIF RAND:3 == 0 && CFLAG:ARG:気合フラグ == 0
			CFLAG:ARG:입력행동 = [[스킬:기합]]
		ELSEIF RAND:2 == 0 && !CFLAG:ARG:회심의패기플래그
			CFLAG:ARG:입력행동 = [[스킬:회심의패기]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:검격가드브레이크]]
		ENDIF
	;バフるターン
	ELSEIF RAND:2
		IF 0
		;自分のクリティカル強化がイマイチな場合はブレイブステップを使用
		ELSEIF CFLAG:ARG:크리티컬강화 < 3
			CFLAG:ARG:입력행동 = [[스킬:브레이브스텝]]
		;強化がイマイチな場合、またはMAXでなく1/4の確率で
		ELSEIF ((CFLAG:ARG:공격강화 + CFLAG:ARG:명중강화) <= 32) || (RAND:4 == 0 && (CFLAG:ARG:공격강화 + CFLAG:ARG:명중강화) <= 64)
			CFLAG:ARG:입력행동 = [[스킬:파워브레스]]
		ELSEIF RAND:3 == 0 && CFLAG:ARG:気合フラグ == 0
			CFLAG:ARG:입력행동 = [[스킬:기합]]
		;ヨシ！もういいな！ってなるとよしつねけんざーん！が飛んでくる
		ELSE
			;あなたが剣撃反射耐性を持っているか、反射フラグなんかのガード手段を持ってたら使用率爆増
			;超万能攻撃、名前変更で「万魔調伏の剣」と表示されるはず
			;ヨシツネ見参とどっちがマシか分からねぇな
			IF RAND:5 == 0 || (RAND:3 == 0 && MASTERの状態)
				CFLAG:ARG:입력행동 = [[스킬:기부「천계기상의검」]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:요시츠네등장]]
			ENDIF
		ENDIF
	ELSE
		;ランダムで行動
		;ひとりリンケージを多用する
		IF 0
		;あなたが剣撃反射耐性を持っているか、反射フラグなんかのガード手段を持ってたら使用率爆増
		;超万能攻撃、名前変更で「万魔調伏の剣」と表示されるはず
		ELSEIF RAND:10 == 0 || (RAND:3 == 0 && MASTERの状態)
			CFLAG:ARG:입력행동 = [[스킬:기부「천계기상의검」]]
		ELSEIF RAND:9 == 0
			CFLAG:ARG:입력행동 = [[스킬:뇌진난무]]
		ELSEIF RAND:8 == 0
			CFLAG:ARG:입력행동 = [[스킬:질풍난무]]
		ELSEIF RAND:7 == 0
			CFLAG:ARG:입력행동 = [[스킬:뇌진난무]]
		ELSEIF RAND:6 == 0
			CFLAG:ARG:입력행동 = [[스킬:광염난무]]
		;リンケージ4688、疾風相性の２段攻撃（2段目は魔法攻撃になる）
		ELSEIF RAND:5 == 0
			CFLAG:ARG:입력행동 = [[스킬:용비천상]]
		;『精霊指定都市ザ・ダンジョン』：エルジェーベト専用の全体RAND型戦技
		ELSEIF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:만천화우]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:허공참파]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:요시츠네등장]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:즌바라린]]
		ENDIF
	ENDIF

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1





;=======================================================================
@SET_ACTION_EVENT_41_2_8_Slave, ARG
;=======================================================================
;3回行動想定
;発狂、コンセプトは「こいつひとりだけが登場してもキツい」
;主に剣撃スキルを使用　貫通持ち　遊びスキルがない　殺意の塊　絶対にひとりにしてはいけない
;=======================================================================
#DIM モハヤコレマデ
#DIM アナタダケヲミツメテイル
#DIM デカジャチェック

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

	;発狂チェック
	IF モハヤコレマデ < 99
		モハヤコレマデ = 0

		;ひとりだけになったら発狂
		FOR LOCAL, 7, 17
			;いなかったら戻る
			SIF POS(LOCAL) < 0
				CONTINUE
			;DYINGも無視
			SIF CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("DYING")
				CONTINUE
			;誰かが生き残っていたらプラス、ふたり以上が生き残っていたら発狂しないよ
			モハヤコレマデ += 1
		NEXT

		;HP３割以下で強制発狂
		SIF 現HP割合(ARG) < 31
			モハヤコレマデ = 1

		;発狂
		IF モハヤコレマデ == 1
			CFLAG:ARG:행동횟수 = 4
			モハヤコレマデ = 99
		ENDIF
	ENDIF

	;あなただけを見つめている
	;条件によって半分くらい発狂
	;行動回数が0の時のみ、フラグを初期化する(壁のみで条件を満たした場合、ガーキルで剥がして以降の行動で継続しないので)
	SIF CFLAG:ARG:행동한횟수 == 0
		アナタダケヲミツメテイル = 0
	SIF CFLAG:MASTER:상태이상 != GET_STATE_NUM("DYING") && (CFLAG:MASTER:검격무효화횟수 || CHECK_WEAKNESS(MAXBASE:MASTER:검격) <= -2)
		アナタダケヲミツメテイル = 1
	;デカジャチェック
	;発狂時、静寂の祈り……まあイニシャライズ……を使用する
	デカジャチェック = 0
	FOR LOCAL, 1, 7
		;いなかったら戻る
		SIF POS(LOCAL) < 0
			CONTINUE
		;DYINGも無視
		SIF CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("DYING")
			CONTINUE

		;強化段階が３段以上になってる能力があったらデカジャフラグセット
		FOR LOCAL:1, 0, 6
			IF CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") > 8
				デカジャチェック += 1
				BREAK
			ENDIF
		NEXT
	NEXT


	IF 0
	;ワンモア一丁はいりまーす！！！ってとき
	ELSEIF CFLAG:ARG:１more플래그 > 0
		IF 0
			;짐승의안광……は流石に死ぬでしょ
		;自前で回復もする
		ELSEIF CFLAG:ARG:상태이상 != GET_STATE_NUM("GOOD")
			CFLAG:ARG:입력행동 = [[스킬:파트라디]]
		ELSEIF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:검격가드브레이크]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:대마법「마신복송」]]
		ELSEIF RAND:2 == 0
			;狼煙、いくつかあるので念のため番号で記載
			;CFLAG:ARG:입력행동 = [[스킬:돌격의봉화]]
			;CFLAG:ARG:입력행동 = 4298
			CFLAG:ARG:입력행동 = 4238
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:어둠의포옹]]
		ENDIF
	;残りが凪ひとりの場合/発狂
	ELSEIF モハヤコレマデ >= 99
		;すげー最悪なこと思いついたと自分に恐怖している
		CFLAG:ARG:방어플래그 = 1

		;発狂モードに入ったゼ、という文言な
		IF モハヤコレマデ == 99
			モハヤコレマデ = 100
			PRINTFORML ┏>악마인간 요시츠네 ━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃아―. 아아아아. 좋아　　　　　　　　　　　　　　　　　　　┃
			PRINTFORML ┃　　　　　　　　　　――하는 걸까, 요? 　　　　　　　　┃
			PRINTFORML ┃　　　　　당신을　　　　　　　　　　　　　　　　　　　　┃
			PRINTFORML ┃　　　　　　　어째서　저n는 　　　　　　　　　　┌┐　　┃
			PRINTFORML ┃　　　　　　　　　　　　　　　　러브라는 카테고리┘└? 　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			FORCEWAIT
			SETCOLOR COLOR("RED")
			PRINTFORML ┏>악마인간 요시츠네 ━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃아――아아아아아, 아아아아아아아아아아아아. 　　　　　　　┃
			PRINTFORML ┃――아아아아아아아아아아아아아――아아아아아아아아！！！ 　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			RESETCOLOR
			PRINTFORML ┏>MESSAGE  ━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃악마인간 요시츠네／쿠즈노하 게이린／나기의 갑옷이 다가온다……！ ┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ENDIF
	
	
	
	
		;もう一人だけなので、容赦なくイニシャライズを使う
		;自己強化は「魔神復誦」でなんとかする
		IF デカジャチェック > 1 && RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:침묵의기도]]
		;あなたが死んでなくて剣撃ガードキルじゃなかったらガーキルにする
		ELSEIF CFLAG:MASTER:상태이상 != GET_STATE_NUM("DYING") && !CFLAG:MASTER:검격가드킬
			CFLAG:ARG:입력행동 = [[스킬:검격가드브레이크]]
		;気合が入ってなかったらヒートライザ――ではなく、「魔神復誦」する。いちおうこのパッチで他のボスもなんか使えるっぽい名前、「アグニ開眼」になるよう変えておいた。
		ELSEIF CFLAG:ARG:気合フラグ == 0
			CFLAG:ARG:입력행동 = [[스킬:대마법「마신복송」]]
		ELSE
			;ぶっ殺す！イエー！！！
			IF 0
			ELSEIF RAND:3 == 0
				CFLAG:ARG:입력행동 = [[스킬:극광대파참]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:팔척뛰기]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:요시츠네등장]]
			ENDIF
		ENDIF
	;あなたが凪との触れ合いを剣撃反射とかで拒否している場合
	ELSEIF アナタダケヲミツメテイル == 1
		IF 0
		ELSEIF RAND:4 == 0
			PRINTFORML ┏>악마인간 요시츠네 ━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃고마　　　　　　　이쪽을 봐　　　　　　　　　　　　　　┃
			PRINTFORML ┃　　　워요　　군요　　　　　　주세요　　　　　　　　　┃
			PRINTFORML ┃　　　　　Nice　　　　　　　　　　　　　　　　　　　　죽여┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ELSEIF RAND:3 == 0
			PRINTFORML ┏>악마인간 요시츠네 ━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃당신만을 바라보고 있어　　　　　　　　　　　　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ELSEIF RAND:2 == 0
			PRINTFORML ┏>악마인간 요시츠네 ━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃당　　　에닿　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTFORML ┃　신　에　　　　　았　　　　　　　　　　　　　　　　　　┃
			PRINTFORML ┃　　　　　　게　　　　다　　　　　　　　　　　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ELSE
			PRINTFORML ┏>악마인간 요시츠네 ━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃어　당신　닿지않　　┌？　　　　　　　　　　　　　　　　┃
			PRINTFORML ┃째서　에게손이　는세오리　　　　　　　　　　　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ENDIF
		;剣撃ガードキルじゃなかったらガーキルにする
		;IF CFLAG:CPOS(MASTER):상태이상 != GET_STATE_NUM("DYING") && !CFLAG:MASTER:검격가드킬
		IF CFLAG:MASTER:상태이상 != GET_STATE_NUM("DYING") && !CFLAG:MASTER:검격가드킬
			CFLAG:ARG:입력행동 = [[스킬:검격가드브레이크]]
		ELSEIF CFLAG:ARG:気合フラグ == 0
			CFLAG:ARG:입력행동 = [[스킬:대마법「마신복송」]]
		;%CALLNAME:MASTER%殿！　死んで（はぁと）
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:요시츠네등장]]
		ENDIF
	;バフるターン
	ELSEIF RAND:2 == 0
		IF 0
		;自分のクリティカル強化がイマイチな場合はブレイブステップを使用
		ELSEIF CFLAG:ARG:크리티컬강화 < 3
			CFLAG:ARG:입력행동 = [[스킬:브레이브스텝]]
		;強化がイマイチな場合、またはMAXでなく1/4、または気合を入れたい場合
		ELSEIF ((CFLAG:ARG:공격강화 + CFLAG:ARG:명중강화) <= 32) || (RAND:4 == 0 && (CFLAG:ARG:공격강화 + CFLAG:ARG:명중강화) <= 64) || CFLAG:ARG:気合フラグ == 0
			CFLAG:ARG:입력행동 = [[스킬:대마법「마신복송」]]
		;ヨシ！もういいな！ってなるとよしつねけんざーん！が飛んでくる
		ELSE
			;超万能攻撃、名前変更で「万魔調伏の剣」と表示されるはず
			IF RAND:5 == 0
				CFLAG:ARG:입력행동 = [[스킬:기부「천계기상의검」]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:팔척뛰기]]
			ELSE
			CFLAG:ARG:입력행동 = [[스킬:요시츠네등장]]
			ENDIF
		ENDIF
	ELSE
		;ランダムで行動
		IF 0
		;あなたが剣撃反射耐性を持っているか、反射フラグなんかのガード手段を持ってたら使用率爆増
		;超万能攻撃、名前変更で「万魔調伏の剣」と表示されるはず
		;上で同条件で落としてるので状態チェックは死に分岐
		;ELSEIF RAND:10 == 0 || (RAND:3 == 0 && CFLAG:POS(LOCAL):상태이상 != GET_STATE_NUM("DYING") && (CFLAG:MASTER:검격무효화횟수 < 1 || CFLAG:MASTER:물리반사플래그 < 1 || CFLAG:MASTER:無効フラグ < 1 || BASE:MASTER:검격 == 999 || BASE:MASTER:검격 <= 0))
		ELSEIF RAND:10 == 0
			CFLAG:ARG:입력행동 = [[스킬:기부「천계기상의검」]]
		ELSEIF RAND:9 == 0
			CFLAG:ARG:입력행동 = [[스킬:부월쇄파]]
		ELSEIF RAND:8 == 0
			CFLAG:ARG:입력행동 = [[스킬:브레이브재퍼]]
		ELSEIF RAND:7 == 0
			CFLAG:ARG:입력행동 = [[스킬:팔척뛰기]]
		ELSEIF RAND:6 == 0
			CFLAG:ARG:입력행동 = [[스킬:극광대파참]]
		ELSEIF RAND:5 == 0
			CFLAG:ARG:입력행동 = [[스킬:아공양단]]
		ELSEIF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:화차베기]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:허공참파]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:요시츠네등장]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:즌바라린]]
		ENDIF
	ENDIF

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1



