@SET_ACTION_EVENT_41_2_8_Oboroguruma, ARG
;=======================================================================
;２回行動予定
;戦技、支援（特殊）を主に使用
;=======================================================================
#DIM デクンダチェック

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

	デクンダチェック = 0

	;デ・クンダを使用するかどうかのチェック
	FOR LOCAL, 7, 17
		;いなかったら戻る
		SIF POS(LOCAL) < 0
			CONTINUE
		;DYINGも無視
		SIF CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("DYING")
			CONTINUE
		

		;強化段階がマイナス２段階になっている能力をカウント
		FOR LOCAL:1, 0, 6
			IF CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") < -4
				デクンダチェック += 1
				BREAK
			ENDIF
		NEXT
		;一人でもいたらそれで使うぞ
		SIF デクンダチェック >= 1
			BREAK
	NEXT

	IF 0
	ELSEIF デクンダチェック >= 1
		CFLAG:ARG:입력행동 = [[스킬:데・쿤다]]
		デクンダチェック = 0
	;ワンモア一丁はいりまーす！！！ってとき
	;こちらもまあ少なそう
	ELSEIF CFLAG:ARG:１more플래그 > 0
