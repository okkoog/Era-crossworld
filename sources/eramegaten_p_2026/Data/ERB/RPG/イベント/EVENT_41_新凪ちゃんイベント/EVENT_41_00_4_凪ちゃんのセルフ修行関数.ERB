;=======================================================================================================================================================
;メモ
;=======================================================================================================================================================
;凪仲間ルートの節目節目で習得させていく
;想定レベル帯がそもそも高いのと、（異能者にしたので）普通にスキルカードで習得していくってこともできるので、わりと1周目（あるいは低周回）を想定したボーナス
;（まあ、2ケタ周回でも、MAGを注ぎ込んだりスキカ用意したりする手間はあるんで、この関数で手間は減るかな……くらいのアレ）
;覚えさえすればMAG強化とかで育てていけるスキルもチョイチョイ
;凪のデフォルト習得スキル、「一歩物足りない」ものとしてるがこちらでフォローしてもらう想定なのだ
;
;関数「LEARN_SKILL」
;　レベルが上がった時スキルを習得するじゃん　アレ
;　なのでもちろん、習得した！って出るけどそれを覚えないこともできる
;
;凪ちゃんの習得予定スキルは下記の通り
;
;・初期習得
;	이단찌르기
;	필사적인공부
;	이검난무
;	번개찌르기
;	히트웨이브
;・レベルアップで習得
;	요정후레옴
;	퀵버스터
;	이할의마맥
;	충의의참격
;	오바리욘포효
;	추격의심득
;	발진오보로구루마
;	즌바라린
;	갑옷관통
;	기합
;	灼熱車駕（二段突きの派生の派生）
;	삼할의마맥
;	블레이드댄스
;	파사의광인
;	요시츠네등장
;===========================================================================================================================================================================

@EVENT_41_Nagi_Learn_Skill
#DIM 凪ちゃん

凪ちゃん = GETCHARA([[キャラ:나기]])

	PRINTFORML 

	;凪ちゃん第XX段階
	;これは一例、雰囲気としてこんな感じ
	;基本として三択
	;1.剣撃系スキル
	;2.その他相性の物理スキル
	;3.검격"以外"のスキル、ディアとか
	IF イベントフラグ:41:4 == 99
		PRINTFORML ＞나기는 실전을 통해 또 하나 강해진 것 같다.
		PRINTFORML ＞%CALLNAME:MASTER%가 보기로는……
		PRINTFORML  
		PRINTFORML [0] 단일을 대상으로 하는 검기 『산바람』을 깨우친 것 같다
		PRINTFORML [1] 적 전열을 대상으로 하는 검기 『히트웨이브』를 깨우친 것 같다
		PRINTFORML [2] 단일을 대상으로 하는 회복마법 『디아』를 깨우친 것 같다
		$INPUT_LOOP_EVENT_41_Nagi_Learn_Skill_X
		INPUT
		IF RESULT == 0
			PRINTFORML 나기가 스킬 『산바람』을 습득했다!
			;メモ：LEARN_SKILLの取り扱い
			;LEARN_SKILL(覚える対象,覚えるスキル,覚えるのが変身先悪魔かどうか）
			;デビシフでないなら最後の数字は0でOK
			CALL LEARN_SKILL(凪ちゃん, [[스킬:산바람]],0)
		ELSEIF RESULT == 1
			PRINTFORML 나기가 스킬 『히트웨이브』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:히트웨이브]],0)
		ELSEIF RESULT == 2
			PRINTFORML 나기가 스킬 『디아』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:디아]],0)
		ELSE
			GOTO INPUT_LOOP_EVENT_41_Nagi_Learn_Skill_X
		ENDIF
	;「ダークサマナーを退治するプロセスです」、十文字ワーグナー勝利後
	;凪ちゃんはLv25以上、＠は35以上
	ELSEIF イベントフラグ:41:4 == 1
		PRINTFORML ＞나기는 실전을 통해 또 하나 강해진 것 같다.
		PRINTFORML ＞%CALLNAME:MASTER%가 보기로는……
		PRINTFORML  
		PRINTFORML [0] 단일을 대상으로 하는 검기 『강절단』을 깨우친 것 같다
		PRINTFORML [1] 눈속임을 위해 『플래시봄』의 사용법을 깨우친 것 같다
		PRINTFORML [2] 치유의 힘이 필요하다고 생각하여 회복마법 『메・디아』를 깨우친 것 같다
		$INPUT_LOOP_EVENT_41_Nagi_Learn_Skill_1
		INPUT
		IF RESULT == 0
			PRINTFORML 나기가 스킬 『강절단』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:강절단]],0)
		ELSEIF RESULT == 1
			PRINTFORML 나기가 스킬 『플래시봄』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:플래시봄]],0)
		ELSEIF RESULT == 2
			PRINTFORML 나기가 스킬 『메・디아』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:메・디아]],0)
		ELSE
			GOTO INPUT_LOOP_EVENT_41_Nagi_Learn_Skill_1
		ENDIF

	;「供倶璃の家が大炎上のプロセスです」終了時習得
	;想定Lvは40
	;凪ちゃん苦労ポイントに応じた分岐アリ
	;火炎相性の物理スキル少ないなあ（当然だが）
	ELSEIF イベントフラグ:41:4 == 2
		PRINTFORML ＞나기는 실전을 통해 또 하나 강해진 것 같다.
		PRINTFORML ＞%CALLNAME:MASTER%가 보기로는……
		PRINTFORML  
		PRINTFORML [0] 적진을 베어가르는 검기 『산산조각베기』를 깨우친 것 같다
		PRINTFORML [1] 화재 속에서 싸운 결과 『폭렬의손톱』을 깨우친 것 같다
		PRINTFORML [2] 화재 속을 뛰어다닌 결과 『불/물/대지/중력의벽』『성스러운가호』…… 각종 방벽술을 깨우친 것 같다
		SIF イベントフラグ:41:8 >= 6
			PRINTFORML [3] 자신에게 부하를 건 결과 『결단』을 습득한 것 같다
		SIF イベントフラグ:41:8 >= 11
			PRINTFORML [4] ……어딘가에서 비밀 미사일을 입수한 것 같다
		$INPUT_LOOP_EVENT_41_Nagi_Learn_Skill_2
		INPUT
		IF RESULT == 0
			PRINTFORML 나기가 스킬 『산산조각베기』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:산산조각베기]],0)
		ELSEIF RESULT == 1
			PRINTFORML 나기가 스킬 『폭렬의손톱』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:폭렬의손톱]],0)
		ELSEIF RESULT == 2
			;各種、火炎氷結電撃衝撃を防ぐ壁
			;聖なる加護が目玉、
			PRINTFORML 나기가 스킬 『불의벽』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:불의벽]],0)
			PRINTFORML 나기가 스킬 『물의벽』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:물의벽]],0)
			PRINTFORML 나기가 스킬 『대지의벽』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:대지의벽]],0)
			PRINTFORML 나기가 스킬 『중력의벽』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:중력의벽]],0)
			PRINTFORML 나기가 스킬 『성스러운가호』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:성스러운가호]],0)
		ELSEIF RESULT == 3
			PRINTFORML 나기가 스킬 『결단』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:결단]],0)
		ELSEIF RESULT == 4
			PRINTFORML 나기가 스킬 『뉴클리어미사일』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:뉴클리어미사일]],0)
		ELSE
			GOTO INPUT_LOOP_EVENT_41_Nagi_Learn_Skill_2
		ENDIF
	;「秘密結社コドクノマレビトが刑務所襲撃のプロセスです」終了時習得
	;想定Lvは55
	;凪ちゃん苦労ポイントに応じた分岐アリ（今回は2～10）
	ELSEIF イベントフラグ:41:4 == 3
		PRINTFORML ＞나기는 실전을 통해 또 하나 강해진 것 같다.
		PRINTFORML ＞%CALLNAME:MASTER%가 보기로는……
		PRINTFORML  
		PRINTFORML [0] 마침내 오의 『허공참파』를 습득한 것 같다
		PRINTFORML [1] 체술을 극한까지 연마하여 『썬더피스트』를 깨우친 것 같다
		PRINTFORML [2] 회복마법의 필요성을 통감하고 『메・디아라마』를 습득한 것 같다
		SIF イベントフラグ:41:8 >= 5
			PRINTFORML [3] 자신을 분발시킨 결과 『회심의패기』를 습득한 것 같다
		SIF イベントフラグ:41:8 >= 10
			PRINTFORML [4] 살짝 못된 것을 배워 씨익 웃는 『스마일차지』를 습득한 것 같다
		$INPUT_LOOP_EVENT_41_Nagi_Learn_Skill_3
		INPUT
		IF RESULT == 0
			PRINTFORML 나기가 스킬 『허공참파』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:허공참파]],0)
		ELSEIF RESULT == 1
			PRINTFORML 나기가 스킬 『썬더피스트』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:썬더피스트]],0)
		ELSEIF RESULT == 2
			PRINTFORML 나기가 스킬 『메・디아라마』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:메・디아라마]],0)
		ELSEIF RESULT == 3
			PRINTFORML 나기가 스킬 『회심의패기』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:회심의패기]],0)
		ELSEIF RESULT == 4
			PRINTFORML 나기가 스킬 『스마일차지』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:스마일차지]],0)
		ELSE
			GOTO INPUT_LOOP_EVENT_41_Nagi_Learn_Skill_3
		ENDIF


	;「串蛇媛救出のプロセスです」終了時習得
	;想定Lvは70
	;凪ちゃん苦労ポイントに応じた分岐アリ（今回は0～8）
	ELSEIF イベントフラグ:41:4 == 4
		PRINTFORML ＞나기는 사선을 넘나들며 또 하나 강해진 것 같다.
		PRINTFORML ＞%CALLNAME:MASTER%가 보기로는……
		PRINTFORML 
		PRINTFORML [0] 공간을 베어 가르는 『아공양단』을 습득한 것 같다
		PRINTFORML [1] 만능 십자살 『메기도크로스』를 습득한 것 같다
		PRINTFORML [2] 심안을 개안하여 『서드아이』를 습득한 것 같다
		SIF イベントフラグ:41:8 >= 4
			PRINTFORML [3] 선봉을 서는 용기로 인해 『브레이브스텝』을 습득한 것 같다
		SIF イベントフラグ:41:8 >= 8
			PRINTFORML [4] 요시츠네의 힘을 완전히 이끌어내어 『관통』을 습득한 것 같다
		$INPUT_LOOP_EVENT_41_Nagi_Learn_Skill_4
		INPUT
		IF RESULT == 0
			PRINTFORML 나기가 스킬 『아공양단』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:아공양단]],0)
		ELSEIF RESULT == 1
			PRINTFORML 나기가 스킬 『메기도크로스』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:메기도크로스]],0)
		ELSEIF RESULT == 2
			PRINTFORML 나기가 스킬 『서드아이』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:서드아이]],0)
		ELSEIF RESULT == 3
			PRINTFORML 나기가 스킬 『브레이브스텝』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:브레이브스텝]],0)
		ELSEIF RESULT == 4
			PRINTFORML 나기가 스킬 『관통』을 습득했다!
			CALL LEARN_SKILL(凪ちゃん, [[스킬:관통]],0)
		ELSE
			GOTO INPUT_LOOP_EVENT_41_Nagi_Learn_Skill_4
		ENDIF



	;「クラリオンと決戦のプロセスです」終了時習得
	;想定Lvは80
	ELSEIF イベントフラグ:41:4 == 5
		PRINTFORML 
		PRINTFORML ＞…………그건 그렇고.
		PRINTFORML ＞쿠즈노하 게이린이라 자칭하게 될 만도 하여, 나기는 몰라볼 정도로 크게 성장한 것 같다.
		PRINTFORML  
		PRINTFORML ＞나기의 전용 스킬이 파워업했다!
		PRINTFORMW  
		PRINTFORML ＞쿠즈노하의 소환술을 기계적으로 재현한 스킬 에뮬레이터 『쿠즈노하학설』을 입수했다!
		PRINTFORMW  
		;スキルエミュレータ『쿠즈노하학설』を入手
		CALL ADDS_SKILL_EMULATOR, "ＣＳ - 쿠즈노하학설"

	ENDIF








