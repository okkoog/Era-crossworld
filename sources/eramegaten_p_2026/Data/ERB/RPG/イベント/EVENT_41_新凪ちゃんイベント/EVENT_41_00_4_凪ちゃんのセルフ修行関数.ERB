;=======================================================================================================================================================
;●固定敵配置用スキルリセット
;=======================================================================================================================================================
;ボスは20個までスキルを持てるが、レベルアップで事故的なスキル（メディアラハンとか）を習得する場合があるため、ここでリセットを行う
;=======================================================================================================================================================
@EVENT_41_Skill_Reset, ARG
#DIM TGT
	TGT = ARG

	;存在しないキャラだったら戻る
	SIF TGT < 0
		RETURN 0
	;PTフラグがゼロ以外＝仲魔の操作をしようとしてる場合も戻る
	SIF CFLAG:TGT:PT플래그 != 0
		RETURN 0

	;スキルを１～20まで全部明示的にゼロを入れる
	ABL:TGT:스킬1  = 0
	ABL:TGT:스킬2  = 0
	ABL:TGT:스킬3  = 0
	ABL:TGT:스킬4  = 0
	ABL:TGT:스킬5  = 0
	ABL:TGT:스킬6  = 0
	ABL:TGT:스킬7  = 0
	ABL:TGT:스킬8  = 0
	ABL:TGT:스킬9  = 0
	ABL:TGT:스킬10 = 0
	ABL:TGT:스킬11 = 0
	ABL:TGT:스킬12 = 0
	ABL:TGT:스킬13 = 0
	ABL:TGT:스킬14 = 0
	ABL:TGT:스킬15 = 0
	ABL:TGT:스킬16 = 0
	ABL:TGT:스킬17 = 0
	ABL:TGT:스킬18 = 0
	ABL:TGT:스킬19 = 0
	ABL:TGT:스킬20 = 0

	RETURN 0

