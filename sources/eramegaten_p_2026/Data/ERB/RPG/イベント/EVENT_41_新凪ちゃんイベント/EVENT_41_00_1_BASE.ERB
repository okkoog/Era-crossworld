			RETURN 1
		;이벤트「いつかの未来が、ウチを待っとる」
		ELSEIF イベントフラグ:41:1 == 11
			RESULTS = 언젠가의 미래가, 내를 기다리고 있데이
			RETURN 1
		ENDIF
	ENDIF

	CALL RESET_ANNOUNCE_FLAG
	RETURN 0












