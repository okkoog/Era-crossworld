	CFLAG:ARG:입력행동 = 2301
	CFLAG:ARG:타겟 = CPOS(ARG) - 5
ELSE
	CALL ランダム行動, ARG
ENDIF


;=======================================================================
@SET_ACTION_EVENT_41_2_7_Back, ARG
;=======================================================================

;前衛に居るなら後ろに下がる
IF IS_FRONT(ARG) && POS(CPOS(ARG) + 5) >= 0 && !IS_BADSTATE(POS(CPOS(ARG) + 5), "DYING")
	CFLAG:ARG:입력행동 = 2301
	CFLAG:ARG:타겟 = CPOS(ARG) + 5
ELSE
	CALL ランダム行動, ARG
ENDIF



;=======================================================================
@SET_ACTION_EVENT_41_2_7_Suzaku, ARG
;=======================================================================
;スザクの行動パターン
;味方を蘇生する
;デカジャ・デクンダも使う
;忙しい……
;=======================================================================
#DIM EVENT_41_2_7_Suzaku_Flag_Dekunda
#DIM EVENT_41_2_7_Suzaku_Flag_Dekaja
#DIM LCOUNT
#DIM MIN_ENEMY
#DIM MIN_HP

	;入力行動を-1とターゲットを-1にしておく
	CFLAG:ARG:입력행동 = -1
	CFLAG:ARG:타겟 = -1

	;フラグを初期化
	EVENT_41_2_7_Suzaku_Flag_Dekunda = 0
	EVENT_41_2_7_Suzaku_Flag_Dekaja = 0


	;デクンダチェック
	;自分が2段弱体化していたら使用
	IF CFLAG:ARG:공격강화 < -4 || CFLAG:ARG:방어강화 < -4 || CFLAG:ARG:마법위력강화 < -4 || CFLAG:ARG:명중강화 < -4 || CFLAG:ARG:회피강화 < -4
		EVENT_41_2_7_Suzaku_Flag_Dekunda = 1
	ENDIF


	;デカジャチェック
	LOCAL:3 = 0
	FOR LOCAL, 1, 7
		SIF POS(LOCAL) < 0
			CONTINUE
		SIF CFLAG:POS(LOCAL):공격강화 > 0
			LOCAL:3 += CFLAG:POS(LOCAL):공격강화
		SIF CFLAG:POS(LOCAL):방어강화 > 0
			LOCAL:3 += CFLAG:POS(LOCAL):방어강화
		SIF CFLAG:POS(LOCAL):마법위력강화 > 0
			LOCAL:3 += CFLAG:POS(LOCAL):마법위력강화
		SIF CFLAG:POS(LOCAL):마법효과강화 > 0
			LOCAL:3 += CFLAG:POS(LOCAL):마법효과강화
		SIF CFLAG:POS(LOCAL):회피강화 + CFLAG:POS(LOCAL):명중강화 > 0
			LOCAL:3 += (CFLAG:POS(LOCAL):회피강화 + CFLAG:POS(LOCAL):명중강화) / 2
	NEXT

	;PT6名の強化平均が+2(内部的には+8)以上＝5か所が+2(+8)以上、なので6*8*5、でLOCAL3が240以上ならデカジャを使用するフラグをオン
	SIF LOCAL:3 >= 240
		EVENT_41_2_7_Suzaku_Flag_Dekaja = 1


	;ワンモアが入ると回復
	IF CFLAG:ARG:１more플래그 > 0
		CFLAG:ARG:입력행동 = [[스킬:메・디아라마]]
	;自分以外が死んでたら無制限にリカーム
	ELSEIF 1
		;使えるならリカーム
		CFLAG:ARG:입력행동 = SKILL_NUM_F("리캄")
		CFLAG:ARG:타겟 = -1
		CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
		;タゲ発見できたりしたら１を返す
		SIF RESULT
			RETURN 1
		
		;タゲ発見できなかったりだったらランダム行動へ
		GOTO ELSE_ACTION
	;その他RAND
	ELSE
		$ELSE_ACTION
		;デカジャ使用フラグが立ってる
		IF EVENT_41_2_7_Suzaku_Flag_Dekaja == 1
			CALL SET_ACTION_SKILL, ARG, [[스킬:데・카쟈]]
		;デクンダ使用フラグが立ってる
		ELSEIF EVENT_41_2_7_Suzaku_Flag_Dekunda == 1
			CALL SET_ACTION_SKILL, ARG, [[스킬:데・쿤다]]
		;以下、攻撃スキルを使用
		ELSE
			CALL ランダム行動, ARG
		ENDIF
	ENDIF


	;アクション実行不能
	CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
	SIF RESULT == 0
		CFLAG:ARG:입력행동 = 0
	;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
	SIF CFLAG:ARG:타겟 == -1
		CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
	RETURN 1



