;=======================================================================
;●vs.本気オーファンAI
;=======================================================================
@SET_ACTION_EV41_5_8_VS_ORPHAN, ARG
;=======================================================================
;「これ俺がやった方が早いな……」でいろんなことに手を出しちゃうタイプだと思う
;まあ人を使うのもうまいんだけどコイツ
;=======================================================================
#DIM CHK_DEKAJA
#DIM CHK_DEKUNDA

	;入力行動を-1とターゲットを-1にしておく
	CFLAG:ARG:입력행동 = -1
	CFLAG:ARG:타겟 = -1

	IF 0
	;ワンモア一丁はいりまーす！！！ってとき
	ELSEIF CFLAG:ARG:１more플래그 > 0
		CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
	ELSEIF CFLAG:ARG:행동한횟수 == 0
		;デカジャチェック
		CHK_DEKAJA = 0
		FOR LOCAL, 1, 7
			SIF POS(LOCAL) < 0
				CONTINUE
			SIF CFLAG:POS(LOCAL):공격강화 > 0
				CHK_DEKAJA += CFLAG:POS(LOCAL):공격강화
			SIF CFLAG:POS(LOCAL):방어강화 > 0
				CHK_DEKAJA += CFLAG:POS(LOCAL):방어강화
			SIF CFLAG:POS(LOCAL):마법위력강화 > 0
				CHK_DEKAJA += CFLAG:POS(LOCAL):마법위력강화
			SIF CFLAG:POS(LOCAL):마법효과강화 > 0
				CHK_DEKAJA += CFLAG:POS(LOCAL):마법효과강화
			SIF CFLAG:POS(LOCAL):회피강화 + CFLAG:POS(LOCAL):명중강화 > 0
				CHK_DEKAJA += (CFLAG:POS(LOCAL):회피강화 + CFLAG:POS(LOCAL):명중강화) / 2
		NEXT

		;デクンダチェック
		SIF CFLAG:ARG:공격강화 < -4 || CFLAG:ARG:방어강화 < -4 || CFLAG:ARG:마법위력강화 < -4 || CFLAG:ARG:명중강화 < -4 || CFLAG:ARG:회피강화 < -4
			CHK_DEKUNDA = 1

		;まあまあ適切にビャッと消しちゃう
		IF (50 < CHK_DEKAJA) || CHK_DEKUNDA
			CFLAG:ARG:입력행동 = [[스킬:이니셜라이즈]]
		ELSE
			CALL ランダム行動 , ARG
		ENDIF
	ELSE
		CALL ランダム行動 , ARG
	ENDIF


	;アクション実行不能
	CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
	SIF RESULT == 0
		CFLAG:ARG:입력행동 = 0
	;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
	SIF CFLAG:ARG:타겟 == -1
		CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
	RETURN 1



