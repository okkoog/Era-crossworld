;ライセンスフリー
;ななみちゃん推すために原作イベントを追加してみる。
;リプレイ本のコンバートだから基本会話ばっかりです。1話当たり400行までに収める感じで作成予定。
;チュートリアル的な内容をちりばめられたら良いな…（希望
;2020/03/07 作成者：92473/ななみの人 第１話+第２話分作成、原作本通り全５話構成（願望）。
;2020/03/16 作成者：92473/ななみの人 第３話追加
;2020/04/09 作成者：92473/ななみの人 第４話追加
;====================
;条件
;====================
@GET_EVENT_NAME_35
#FUNCTIONS
RESULTS_F '= "ＴＲＰＧ리플레이_재회"
RETURNF RESULTS_F

@PLAYABLE_EVENT_35
;主人レベル10以上
IF BASE:MASTER:LV >= 10 && イベントフラグ:35:0 == 0
	RESULTS = 사교의 관에서
	RETURN 1
;EVENT_35_邪教の館にて でななみを仲魔にして夜間パーティ内に据えると発生する。
;ELSEIF イベントフラグ:35:0 == 1 && FINDCHARA_B([[キャラ:나나미]]) == 2 && TIME == 3
ELSE
	SIF GETCHARA([[キャラ:나나미]]) < 0
		RETURN 0
	SELECTCASE イベントフラグ:35:0
		CASE 1
			RESULTS = TRPG 리플레이_재회_제1화
		CASE 2
			RESULTS = TRPG 리플레이_재회_제2화
		;EVENT_35_2_第２話 ボルテクス界をクリアしてななみをパーティ内に据えると発生する。
		CASE 3
			RESULTS = TRPG 리플레이_재회_제3화
		;EVENT_35_3_第３話 人形の夢をクリアしてななみをパーティ内に据えると発生する。
		CASE 4
			RESULTS = TRPG 리플레이_재회_제4화
		;CASE 5
		;	EVENT_35_4_第４話 蜃気楼の龍をクリアしてななみをパーティ内に据えると発生する。
		;	マタドール戦⇒超人戦
		;	RESULTS = ＴＲＰＧリプレイ再会_第５話 再会 ～ See you again next world ～
		CASEELSE
			RETURN 0
	ENDSELECT
	RESULTS:1 = 필요:나나미의 파티 참가
	SIF FINDCHARA_B([[キャラ:나나미]]) != 2
		RETURN -1
	RETURN 1
ENDIF

;====================
;内容
;====================
@SHOPCOM_EVENT_35
CALLFORM EVENT_35_{イベントフラグ:35:0}
CALL RESET_ANNOUNCE_FLAG