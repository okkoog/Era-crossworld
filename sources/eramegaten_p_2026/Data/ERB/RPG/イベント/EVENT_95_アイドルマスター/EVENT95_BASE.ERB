CALL RESET_ANNOUNCE_FLAG

IF イベントフラグ:95:0 == 0
	CALL EVENT_95_1
	RETURN 0
ENDIF


IF イベントフラグ:95:1 == 1
	CALL EVENT_95_2
	RETURN 0
ENDIF
IF イベントフラグ:95:2 == 1
	CALL EVENT_95_3
	RETURN 0
ENDIF

IF イベントフラグ:95:3 == 1
	CALL EVENT_95_4
	RETURN 0
ENDIF

IF イベントフラグ:95:4 == 1
	CALL EVENT_95_5
	RETURN 0
ENDIF

IF イベントフラグ:95:5 == 1
	CALL EVENT_95_6
	RETURN 0
ENDIF

IF イベントフラグ:95:6 == 1
	CALL EVENT_95_7
	RETURN 0
ENDIF

IF イベントフラグ:95:7 == 1
	CALL EVENT_95_8
	RETURN 0
ENDIF

IF イベントフラグ:95:8 == 1
	CALL EVENT_95_9
	RETURN 0
ENDIF

IF イベントフラグ:95:9 == 1
	IF イベントフラグ:95:0 == 1
		CALL EVENT_95_11
		RETURN 0
	ENDIF
	IF イベントフラグ:95:1 == 2
		CALL EVENT_95_11
		RETURN 0
	ENDIF
	IF イベントフラグ:95:1 == 3
		CALL EVENT_95_11
		RETURN 0
	ENDIF
	IF イベントフラグ:95:3 == 2
		CALL EVENT_95_11
		RETURN 0
	ENDIF
	IF イベントフラグ:95:4 == 2
		CALL EVENT_95_11
		RETURN 0
	ENDIF
	IF イベントフラグ:95:4 == 3
		CALL EVENT_95_11
		RETURN 0
	ENDIF
	IF イベントフラグ:95:5 == 2
		CALL EVENT_95_11
		RETURN 0
	ENDIF
	IF イベントフラグ:95:6 == 2
		CALL EVENT_95_11
		RETURN 0
	ENDIF
	IF イベントフラグ:95:8 == 2
		CALL EVENT_95_11
		RETURN 0
	ENDIF
ENDIF

IF イベントフラグ:95:11 == 1 && イベントフラグ:95:9 == 1
	CALL EVENT_95_11
	RETURN 0
ENDIF