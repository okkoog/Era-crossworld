;
@KOJOSYOUKAIPAGE
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC DAMANA_FACE
#DIM DYNAMIC L_LINE
L_LINE = LINECOUNT
DO
	CLEARLINE LINECOUNT - L_LINE
	DRAWLINE
	DAMANA_FACE '= GET_FACE_BY_CHARA_AS_HTML(GETCHARA([[キャラ:동기다크서머너]]),600, , , [[キャラ:동기다크서머너]], "FACE_0")
	IF DAMANA_FACE != ""
		HTML_PRINT DAMANA_FACE
		FOR LCOUNT, 0, 5
			PRINTL 
		NEXT
	ENDIF
	PRINTL 
	SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「이게 악마의 목록이다。원하는 것을 골라줘」
		CASE 1
			PRINTFORML 「왜 그래？　내 얼굴에 뭐가 묻었어？」
		CASE 2
			PRINTFORML 「마카는 충분해？　뭐, 놀려도 불평하지 말라고」
	ENDSELECT

	PRINTFORML 소지마카：{MONEY:1}마카
	DRAWLINE
	PRINTL 
	PRINTFORML 약한 악마의 리스트
	PRINTFORML [60]리스트 1
	PRINTFORML [61]리스트 2
	PRINTFORML [62]리스트 3
	PRINTFORML 
	PRINTFORML 강한 악마의 리스트
	PRINTFORML [63]리스트 4
	PRINTFORML [64]리스트 5
	PRINTFORML [65]리스트 6
	PRINTFORML [66]리스트 7
	PRINTFORML [67]리스트 8
	PRINTFORML [70]특수한？악마
	PRINTFORML 
	PRINTFORML [80]특별의뢰
	PRINTFORML [90]잡담
	DRAWLINE
	PRINTFORML [99]돌아간다
	CALL INPUTINT(60, 61, 62, 63, 64, 65, 66, 67, 70, 80, 90, 99)
	IF RESULT == 60
		CALL KOJOSYOUKAI
	ELSEIF RESULT == 61
		CALL KOJOSYOUKAI2
	ELSEIF RESULT == 62
		CALL KOJOSYOUKAI3
	ELSEIF RESULT == 63
		IF BASE:MASTER:LV > 49
			CALL KOJOSYOUKAI4
		ELSE
			PRINTFORMW 「아직은、소개해줄 수 없겠네。레벨 50 이상이면 소개해주지」
		ENDIF
	ELSEIF RESULT == 64
		IF BASE:MASTER:LV > 49
			CALL KOJOSYOUKAI5
		ELSE
			PRINTFORMW 「아직은、소개해줄 수 없겠네。레벨 50 이상이면 소개해주지」
		ENDIF
	ELSEIF RESULT == 65
		IF BASE:MASTER:LV > 49
			CALL KOJOSYOUKAI6
		ELSE
			PRINTFORMW 「아직은、소개해줄 수 없겠네。레벨 50 이상이면 소개해주지」
		ENDIF
	ELSEIF RESULT == 66
		IF BASE:MASTER:LV > 49
			CALL KOJOSYOUKAI7
		ELSE
			PRINTFORMW 「아직은、소개해줄 수 없겠네。레벨 50 이상이면 소개해주지」
		ENDIF
	ELSEIF RESULT == 67
		IF BASE:MASTER:LV > 49
			CALL KOJOSYOUKAI8
		ELSE
			PRINTFORMW 「아직은、소개해줄 수 없겠네。레벨 50 이상이면 소개해주지」
		ENDIF
	ELSEIF RESULT == 70
		IF BASE:MASTER:LV > 49
			IF !GET_USEABLE_EXTRA_TITLE()
				PRINTFORML 「으음, 그렇군……」
				PRINTFORML 　으음, 미안하지만 지금은 품절이다.
				PRINTFORMW 　납품처와 트러블이 있어서 말이지…… 언제 들어올진 미정이다. 미안」
			ELSE
				PRINTFORML 「어이쿠, 이 녀석들은 악마인지 다른 무언가인지 모르겠는 놈들이다.
				PRINTFORML 　산다면 각오를 단단히 하고 사라고.
				PRINTFORMW 　경고는 했다?」
				CALL EVENT_52_EXTRAKOJO
			ENDIF
		ELSE
			PRINTFORML 「으음, 그렇군……
			PRINTFORML 　으음, 미안하지만 지금은 품절이다
			PRINTFORMW 　네가 더 강해졌을 때 입고해 둘게」
		ENDIF

	ELSEIF RESULT == 80
		IF BASE:MASTER:LV > 49
			PRINTFORML 「오, 의뢰를 받아주는 거냐.
			PRINTFORML 　이건 개인적인 부탁이다. 내가 특이한 악마를 좋아하는 건 알고 있지?
			PRINTFORML 　부끄럽지만, 아직 본 적 없는 악마나 이능자가 많아서 말이야.
			PRINTFORML 
			PRINTFORML 　그래서, 여러모로 발이 넓은 너한테 소개를 받았으면 하는 거다.
			PRINTFORML 　물론 보수는 줄 거고, 악마를 넘기라는 말은 안 해. 그저, 보여주기만 하면 돼.
			PRINTFORMW 　지금 맡기고 싶은 의뢰는 이런 느낌이려나」
			CALL EVENT_52_IRAI
		ELSE
			PRINTFORMW 「아직 의뢰를 맡기기엔 역부족인 것 같군. 레벨이 50 이상이 될 때까지는 보류다」
		ENDIF
	ELSEIF RESULT == 90
		PRINTFORML 「응? 뭔데?」
		DO
			PRINTFORML 
			PRINTFORML [0]이 가게는 뭐야?
			PRINTFORML [1]추천하는 악마는?
			PRINTFORML [2]네가 탐나
			PRINTFORML [3]이제 됐다

			CALL INPUTINT, 0, 1, 2, 3
			IF RESULT == 0
				PRINTFORML 「이 가게에 대해서인가……
				PRINTFORML 　말 그대로, 특이한 악마를 취급하는 가게다.
				PRINTFORML 　특이한 악마, 즉 보통 악마들과는 다른 반응을 보이는 녀석들이지.
				PRINTFORML 　전투 시에 이상한 소릴 하는 녀석, 조교 시에 묘한 소릴 하는 녀석들을 여기서 취급하는 거다.
				PRINTFORML 
				PRINTFORML 　네가 만나본 적 없는 악마도 다루지만, 사교의 관보단 좀 비싸.
				PRINTFORML 　이쪽도 여러모로 비용이 많이 드니까, 비싼 건 양해해 달라고?
				PRINTFORML 　그리고, 일부 악마는 파는 데 조건이 있으니까, 문제를 해결하고 나서 사줘.
				PRINTFORML 　
				PRINTFORML 　그리고, 네 레벨이 50을 넘으면 의뢰를 맡길 테니, 받아주면 도움이 되겠어.
				PRINTFORMW 　가게 설명은 이 정도려나」
			ELSEIF RESULT == 1
				PRINTFORML 「추천하는 악마인가, 그래……
				IF RAND:7 == 0
					PRINTFORML 　요즘은 이누가미가 잘 팔려.
					PRINTFORML 　과묵하고, 보쿠소녀에, 충실하지. 그런 소녀 악마니까, 인기 있는 것도 납득이 가네.
					PRINTFORMW 　팔고 있는 건 리스트 2의 9번이다」
				ELSEIF RAND:6 == 0
					PRINTFORML 　사성수는 어때? 4마리 다 귀여운 소녀라고.
					PRINTFORML 　현무는 과묵한 검은 고스 로리타 소녀.
					PRINTFORML 　청룡은 프라이드가 높은 노쟈 로리 소녀.
					PRINTFORML 　주작은 기가 센 흰 고스 로리타 소녀.
					PRINTFORML 　백호는 중화풍 순정소녀.
					PRINTFORML 　누구 한 명쯤은 마음에 드는 아이가 있지 않겠어?
					PRINTFORMW 　팔고 있는 건 리스트 6의 전반부다」
				ELSEIF RAND:5 == 0
					PRINTFORML 　지극정성으로 섬겨주길 바란다면, 타마모는 어때?
					PRINTFORML 　주인님을 모집 중이라, 분위기는 가볍지만 헌신적인 여우 소녀라고.
					PRINTFORML 　뭐, 산 녀석이 넋이 쏙 빠져버리는 일도 있긴 하지만 말이지……
					PRINTFORMW 　팔고 있는 건 리스트 4의 9번이다」
				ELSEIF RAND:4 == 0 && !GET_USEABLE_EXTRA_TITLE()
					PRINTFORML 　특이한 걸로는 코메이지 사토리는 어때?
					PRINTFORML 　여기와는 다른 세계 출신의 악마…… 아니 요괴라더군.
					PRINTFORML 　자존심이 높은 데다 선을 긋고 있으니, 조교사로서의 실력을 시험해 보기에 좋을지도 모르지.
					PRINTFORML 　사토리 요괴인 만큼 마음을 읽어오니까, 꽤 만만치 않을지도 몰라.
					PRINTFORMW 　팔고 있는 건 특수한 악마 리스트 1의 5번이다」
				ELSEIF RAND:3 == 0
					PRINTFORML 　사흉은 어때? 4마리 모두 인간의 모습이 되어준다고.
					PRINTFORML 　혼돈은 키 큰 눈가림 망상소녀.
					PRINTFORML 　궁기는 후드를 뒤집어쓴 자신만만한 요수 소녀.
					PRINTFORML 　도올은 나른한 분위기의 쿨계 소녀.
					PRINTFORML 　도철은 폭식하는 폭신폭신 천연 소녀.
					PRINTFORML 　뭐, 한가닥하는 녀석들이지만, 그런 놈들을 다루는 게 데빌서머너잖아?
					PRINTFORMW 　팔고 있는 건 리스트 7의 전반부다」
				ELSEIF RAND:2 == 0
					PRINTFORML 　…………전부 다 추천한다고 하면 안 되나?
					PRINTFORMW 　안 되나, 안 되겠지……」
				ELSE
					PRINTFORML 　모ㆍ쇼보는 인기가 많지.
					PRINTFORML 　던전에서 호되게 당한 서머너일수록 사 가는 느낌이야.
					PRINTFORML 　조교할 때는 몹시 약해진다고 하니까, 분풀이하려는 서머너가 많은 거겠지……
					PRINTFORML 　뭐, 내가 할 말은 아니지만, 살 거면 상냥하게 대해줘라?
					PRINTFORMW 　팔고 있는 건 리스트 1의 3번이다」
				ENDIF
			ELSEIF RESULT == 2
				CALL EVENT_52_BOSS
				RETURN 1
			ENDIF
		LOOP RESULT != 3
	ENDIF
LOOP RESULT != 99
RETURN 0