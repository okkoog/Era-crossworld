		IF SPRITECREATED(GET_識別名([[キャラ:니케]]) + "_" + "FACE_TS_0")
			HTML_PRINT GET_FACE_BY_CSV_AS_HTML([[キャラ:니케]], "FACE_TS_0")
		ELSE
			HTML_PRINT GET_FACE_BY_CSV_AS_HTML([[キャラ:니케]])
		ENDIF
		VARI LCOUNT
		FOR LCOUNT, 0, 5
			PRINTL 
		NEXT
		PRINTFORML 
		PRINTFORML 「니케를 사는 건가?
		PRINTFORML 　이 녀석은 아테나를 맹신하고 있는 니케다.
		PRINTFORML 　아마도, 어지간히 마음에 들어도, 아테나 이상의 존재는 못 될지도 몰라.
		PRINTFORML 　가격은 1000마카다.
		IF MONEY:1 < 1000
			PRINTFORMW 　돈이 부족하다고」
			GOTO INPUT_LOOP_KOJOSYOUKAI
		ELSEIF GETCHARA([[キャラ:니케]]) > 0 
			PRINTFORMW 　뭐야, 이미 데리고 있잖냐」
			GOTO INPUT_LOOP_KOJOSYOUKAI
		ELSE
			PRINTFORML 　살 건가?」
			CALL INPUT_YN
			IF RESULT == 0
				MONEY:1 -= 1000
				PRINTFORML 「매번 감사」
				PRINTFORMW 니케「그 이름 높은 전쟁의 여신의 권속이자 승리의 여신인 제가, 이런 곳에서 끝날 리가 없었지요.
				PRINTFORMW 　　　　아테나 님, 감사드립니다!」
				PRINTFORMW 천사　니케가 동료마가 되었다.
				CALL ADD_NEW_COMPANION,[[キャラ:니케]],500,1
				GOTO INPUT_LOOP_KOJOSYOUKAI
			ELSE
				PRINTFORMW 「뭐, 달리 숭배하는 대상이 있는 악마니까 말이지……」
				GOTO INPUT_LOOP_KOJOSYOUKAI
			ENDIF
		ENDIF
	ELSEIF RESULT == 10
		CALL 顔グラ追加, [[キャラ:다크엘프]]
		IF SPRITECREATED(GET_識別名([[キャラ:다크엘프]]) + "_" + "FACE_TS_0")
			HTML_PRINT GET_FACE_BY_CSV_AS_HTML([[キャラ:다크엘프]], "FACE_TS_0")
		ELSE
			HTML_PRINT GET_FACE_BY_CSV_AS_HTML([[キャラ:다크엘프]])
		ENDIF
		VARI LCOUNT
		FOR LCOUNT, 0, 5
			PRINTL 
		NEXT
		PRINTFORML 
		PRINTFORML 「다크엘프를 사는 건가?
		PRINTFORML 　이 녀석은 그야말로 전사라는 느낌의 악마다.
		PRINTFORML 　이런 여자를 굴복시키는 건 남자의 로망일지도 모르겠네. 난 잘 모르겠지만……
		PRINTFORML 　가격은 1000마카다.
		IF MONEY:1 < 1000
			PRINTFORML 　돈이 부족하다고」
			GOTO INPUT_LOOP_KOJOSYOUKAI
		ELSEIF GETCHARA([[キャラ:다크엘프]]) > 0 
			PRINTFORMW 　뭐야, 이미 데리고 있잖냐」
			GOTO INPUT_LOOP_KOJOSYOUKAI
		ELSE
			PRINTFORML 　살 건가?」
			CALL INPUT_YN
			IF RESULT == 0
				MONEY:1 -= 1000
				PRINTFORML 「매번 감사」
				PRINTFORMW 다크엘프「손은 빌려주지. 그러니 마그네타이트는 아끼지 말라고」
				PRINTFORMW 요정　다크엘프가 동료마가 되었다.
				CALL ADD_NEW_COMPANION,[[キャラ:다크엘프]],500,1
				GOTO INPUT_LOOP_KOJOSYOUKAI
			ELSE
				PRINTFORMW 「다크가 아닌 쪽 엘프가 나았나?」
				GOTO INPUT_LOOP_KOJOSYOUKAI
			ENDIF
		ENDIF
	ELSEIF RESULT == 12
		RETURN  1
	ELSEIF RESULT == 99
 		RETURN 99
 	ELSE
		RETURN
	ENDIF
