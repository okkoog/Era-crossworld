	CALL SET_SKILL, LOCAL, "절세의육체"
	CALL SET_SKILL, LOCAL, "색즉시공"
	CALL SET_SKILL, LOCAL, "어나더디멘션"
	CALL SET_SKILL, LOCAL, "스펙트라포스"

	CALL SYNC_STATUS, LOCAL
	CALL HEALTH_CHARA, LOCAL

	FLAG:도주불가플래그 = 1
