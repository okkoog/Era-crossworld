@SET_ACTION_EV19_21_神々の女王_VSヘーラー, ARG
;============================================================
;３回行動→４回行動
;全体万能即死「アナザディメンジョン」、全体（万能）状態異常「색즉시공」をメインに使用
;その代わり攻撃行動はそれほど苛烈ではない
;HP３割以下でメディアラハンを使用。同時に、与・被ダメージが上昇する（パワーが上昇し、防御力がダウンする）。
;「何度も全快するHPを、どんどん上がっていくダメージで張り倒す」戦闘
;============================================================
#DIM デカジャチェック
#DIM デクンダチェック
#DIM 対策札チェック
#DIM ゴールデントライアングルフラグ
#DIM 真チェンジげきおこフラグ

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

	デカジャチェック = 0
	対策札チェック = 0
	;チェック
	FOR LOCAL, 1, 7
		SIF POS(LOCAL) < 0
			CONTINUE
		SIF CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("DYING")
			CONTINUE
		SIF CFLAG:POS(LOCAL):테트라쟈 > 0
			対策札チェック += 1
		SIF CFLAG:POS(LOCAL):성스러운가호 < 1
			対策札チェック += 1
		デカジャチェック += COUNT_カジャンダ_OR_MORE(POS(LOCAL),16)
	NEXT

	;ゴールデントライアングルフラグを戻す（ターン１回制限技の制限）
	SIF CFLAG:ARG:행동한횟수 == 0
		ゴールデントライアングルフラグ = 0
	;ただしげきおこ後はテトラジャ/聖なる加護を感知するとまた色即是空・アナザディメンジョンを使用する可能性がある
	SIF 真チェンジげきおこフラグ == 1 && 対策札チェック > 0 && RAND:4 == 0
		ゴールデントライアングルフラグ = 0

	IF 0
	;HP３割以下で発狂
	ELSEIF 現HP割合(ARG) < 31 && 真チェンジげきおこフラグ == 0
		PRINTFORML ┏>격노한 헤라 ━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃네놈에게선 바람피운 남편과 똑같은 냄새가 난다ッ！！！　　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		CFLAG:ARG:입력행동 = [[스킬:메・디아라한]]

		;発狂フラグな
		真チェンジげきおこフラグ = 1
		;行動回数が増える
		CFLAG:ARG:행동횟수 = 4
		;与・被ダメージ補正を引き上げる
		CFLAG:ARG:물리여데미지보정 += 30
