@EV19_21_BATTLE
;============================================================
;vs.げきおこヘーラー
;============================================================
#DIM エネミーレベル
#DIM 死体が残るフラグ
#DIM 보스플래그
#DIM いちフラグ

	;●140.ヘーラー
	いちフラグ = 9
	エネミーレベル = 90
	死体が残るフラグ = 1
	보스플래그 = 1
	CALL SET_ENEMY, いちフラグ, [[キャラ:헤라]], エネミーレベル, 死体が残るフラグ, 보스플래그
	;LOCALにいったん保存
	LOCAL = CHARANUM - 1

	NAME:LOCAL = 격노한 헤라
	CALLNAME:LOCAL = 격노한 헤라

	CFLAG:LOCAL:ＨＰ보정 += 12000
	CFLAG:LOCAL:ＭＰ보정 += 20000
	CFLAG:LOCAL:행동횟수 = 3
	;通常攻撃は３回攻撃
	ABL:LOCAL:최저공격횟수 = 3
	ABL:LOCAL:최대공격횟수 = 3

	CSTR:LOCAL:사고패턴 = EV19_21_神々の女王_VSヘーラー

	;明示的に元々の耐性を設定
	BASE:LOCAL:검격 = 90
	BASE:LOCAL:비구 = 0
	BASE:LOCAL:타격 = 90
	BASE:LOCAL:전술 = 100
	BASE:LOCAL:화염 = 90
	BASE:LOCAL:빙결 = 90
	BASE:LOCAL:전격 = 0
	BASE:LOCAL:충격 = 90
	BASE:LOCAL:신경 = 50
	BASE:LOCAL:정신 = 0
	BASE:LOCAL:파마 = 0
	BASE:LOCAL:주살 = 0
	BASE:LOCAL:지변 = 200
	BASE:LOCAL:수격 = 90
	BASE:LOCAL:질풍 = 90
	BASE:LOCAL:중력 = 200
	BASE:LOCAL:핵열 = 90
	BASE:LOCAL:만능 = 100

	;所持スキルをリセット
	CALL CLEAR_ALL_SKILL, LOCAL

	;スキルセット
	;AIを使うので特に意味はない
	CALL SET_SKILL, LOCAL, "메・디아라한"
