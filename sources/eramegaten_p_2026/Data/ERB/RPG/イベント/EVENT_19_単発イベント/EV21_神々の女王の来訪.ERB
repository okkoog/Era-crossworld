		CFLAG:ARG:입력행동 = [[스킬:침묵의기도]]
	;-3以下のンダが自分にあれば、静寂の祈りを撃つ
	ELSEIF CFLAG:ARG:공격강화 < -8 || CFLAG:ARG:방어강화 < -8 || CFLAG:ARG:마법위력강화 < -8 || CFLAG:ARG:명중강화 < -8 || CFLAG:ARG:회피강화 < -8
		CFLAG:ARG:입력행동 = [[스킬:침묵의기도]]
	;このターンまだ使用していなければ、ゴールデントライアングル！違います。聖闘士星矢ネタじゃ。
	ELSEIF ゴールデントライアングルフラグ == 0
		;偶数ターン
		IF FLAG:경과턴수 % 2 == 0
			CFLAG:ARG:입력행동 = [[스킬:색즉시공]]
		;奇数ターン
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:어나더디멘션]]
		ENDIF
		;このターンはもう使用しない
		ゴールデントライアングルフラグ += 1
	;さもなくばランダム行動
	ELSE
		IF 0
		ELSEIF !RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:무거운한숨]]
		ELSEIF !RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:절세의육체]]
		ELSEIF !RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:스펙트라포스]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:스펙트라포스]]
		ENDIF
	ENDIF

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1








