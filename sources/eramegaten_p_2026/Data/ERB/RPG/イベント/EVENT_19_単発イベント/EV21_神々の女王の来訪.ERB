			PRINTFORML ┃이놈, 이놈 이놈 이놈으으으윽！！！　　　　　　　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		ELSEIF RAND:2 == 0
