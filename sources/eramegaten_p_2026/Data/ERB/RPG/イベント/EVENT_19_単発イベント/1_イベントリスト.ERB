	ENDIF
	
ELSEIF CFLAG:ARG:행동한횟수 == 1
	CFLAG:ARG:입력행동 = [[스킬:스펠그룸]]
	
ELSE
	IF CFLAG:ARG:행동한횟수 == 2 && FLAG:경과턴수 % 2 == 0
		CFLAG:ARG:입력행동 = [[스킬:정신가드킬]]
