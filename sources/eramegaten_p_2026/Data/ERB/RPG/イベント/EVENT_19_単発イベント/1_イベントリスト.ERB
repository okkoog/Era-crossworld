			;가창기능-5の数字を強化段階に掛け算。
			CFLAG:POS(ループ用):공격강화 = MIN(32, (8 * (ABL:POS(ループ用):가창기능 - 5)))
			CFLAG:POS(ループ用):방어강화 = MIN(32, (8 * (ABL:POS(ループ用):가창기능 - 5)))
			CFLAG:POS(ループ用):명중강화 = MIN(32, (8 * (ABL:POS(ループ用):가창기능 - 5)))
			CFLAG:POS(ループ用):회피강화 = MIN(32, (8 * (ABL:POS(ループ用):가창기능 - 5)))
			CFLAG:POS(ループ用):마법위력강화 = MIN(32, (8 * (ABL:POS(ループ用):가창기능 - 5)))
			CFLAG:POS(ループ用):마법효과강화 = MIN(32, (8 * (ABL:POS(ループ用):가창기능 - 5)))
			
			PRINTFORML 　　TARGET:[{ループ用,2}] %CALLNAME:POS(ループ用),20,LEFT%　>>>>>>　가창기능이 세이렌을 상회했다！　전 능력 상승 중！
			
			なんかした = 1
		;味方の歌唱技能を参照し、5より少なければ確定魅了
		ELSEIF POS(ループ用) >= 0 && ABL:POS(ループ用):가창기능 < 5
