@SET_ACTION_E19田ボ,ARG
#DIM L_BGUARD
#DIM L_HAJIKE
#DIM L_ONE_SM

LOCAL:0 = -1
SIF POS(8) >= 0
	LOCAL:0 = 8
SIF POS(10) >= 0 && (LOCAL:0 == -1 || !RAND:2)
	LOCAL:0 = 10

L_BGUARD = PU_SKILLNUM_GET(ARG,"バカガード")
L_HAJIKE = PU_SKILLNUM_GET(ARG,"ハジケ")
L_ONE_SM = SKILL_NUM_F("각성스킬")

IF !RAND:3 && CFLAG:ARG:행동한횟수 == 0
	IF LOCAL:0 > -1 && SKILLGAGE_D_GET(ARG, L_ONE_SM) == 0
		CFLAG:ARG:입력행동 = L_BGUARD
		CFLAG:ARG:타겟 = LOCAL:0
		RETURN
	ELSEIF CFLAG:ARG:추가행동횟수 == 0
		CFLAG:ARG:입력행동 = [[스킬:짐승의안광]]
		CALL RANDOM_TARGET,ARG,[[스킬:짐승의안광]]
		RETURN
	ENDIF
ENDIF
IF 現HP割合(ARG) < 50 && SKILLGAGE_H_GET(ARG, L_ONE_SM) < 1 && (CFLAG:ARG:행동한횟수 - CFLAG:ARG:추가행동횟수) <= 0
	CFLAG:ARG:입력행동 = L_ONE_SM
	CALL RANDOM_TARGET,ARG,L_ONE_SM
	RETURN
ENDIF
IF RAND:4 && SKILLGAGE_D_GET(ARG, L_ONE_SM) > 0
	CFLAG:ARG:입력행동 = L_HAJIKE
	CALL RANDOM_TARGET,ARG,L_HAJIKE
	RETURN
ENDIF

CALL SKILLGAGE_D_SET, ARG, L_BGUARD, 0

CALL ランダム行動, ARG

@SET_ACTION_E19ハジケ雑魚,ARG
#DIM L_ONE_SM
