@SET_ACTION_マジギレゴトウ, ARG
;=======================================================================
;1.회심의패기→真・テンキョー→검격
;2.会心の覇気or剣ガーキル→검격
;基本的には剣撃オンリー、3回行動である
;弱点：デカジャデクンダを使わない
;=======================================================================
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1


IF FLAG:경과턴수 == 0 && CFLAG:ARG:행동한횟수 == 0
	PRINTFORML ┏> 고토우━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃나, 비검에 눈을 떴도다……！　　　　　　　　┃
	PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━┛
ENDIF


;ワンモアが入ると気合
IF CFLAG:ARG:１more플래그 > 0
	CFLAG:ARG:입력행동 = [[스킬:기합]]

;奇数ターン
ELSEIF FLAG:경과턴수 % 2 == 1
	IF CFLAG:ARG:행동한횟수 == 0
		CFLAG:ARG:입력행동 = [[스킬:회심의패기]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		;HP50％以下になるとクリ率が上昇し耐性などを貫通するアホみたいなのを使ってくる
		IF 現HP割合(ARG) < 50
			CFLAG:ARG:입력행동 = [[스킬:진・천경지폭단]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:천경지폭단]]
		ENDIF
	ELSE
		;ランダム剣撃（ひとつ戦技）
		IF 0
		ELSEIF RAND:7 == 0
			CFLAG:ARG:입력행동 = [[스킬:산산조각베기]]
		ELSEIF RAND:6 == 0
			CFLAG:ARG:입력행동 = [[스킬:화차베기]]
		ELSEIF RAND:5 == 0
			CFLAG:ARG:입력행동 = [[스킬:아라이소]]
		ELSEIF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:난심의일도]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:밤벚꽃의춤]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:대나무베기]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:앵화섬란]]
		ENDIF
	ENDIF


;偶数ターン
ELSEIF FLAG:경과턴수 % 2 == 0
	IF CFLAG:ARG:행동한횟수 == 0
		IF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:검격가드브레이크]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:회심의패기]]
		ENDIF
	ELSE
		;ランダム剣撃（ひとつ戦技）
		IF 0
		ELSEIF RAND:7 == 0
			CFLAG:ARG:입력행동 = [[스킬:산산조각베기]]
		ELSEIF RAND:6 == 0
			CFLAG:ARG:입력행동 = [[스킬:화차베기]]
