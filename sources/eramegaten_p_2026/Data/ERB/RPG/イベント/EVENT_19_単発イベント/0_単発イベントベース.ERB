;イベントは全部ビット演算を使うことにする
;改造)	イベント1つ毎に2つのビットを使用し未読チェックを行う様に
;		その関係で1つの変数に保存できるイベント数は64個から32個に減少
;イベントベースは内部処理に特化し、【イベント作りたい人が見なくてもいい部分】として独立化。

;====================
;条件
;====================
@GET_EVENT_NAME_19
#FUNCTIONS
RESULTS_F '= "단발이벤트"
RETURNF RESULTS_F

@PLAYABLE_EVENT_19
#LOCALSIZE 3
#DIM L_INDEX
VARSET LOCAL
;インデックスを参照
;参照する配列とBIT値を得る為二重ループ
;現在は10×32の320個まで作成できる計算。
;増やしたい場合は↓の行の"LOCAL,0,10"の最後の10を増やせばOK(最大100)
FOR L_INDEX,0,20
	FOR LOCAL,0,32
		TRYCCALLFORM EVENT_19_LIST_{L_INDEX} , LOCAL,1
		CATCH
			BREAK
		ENDCATCH
		SIF !RESULT
			CONTINUE
		SIF GETBIT(イベントフラグ:19:L_INDEX,LOCAL)
			CONTINUE
		IF !GETBIT(イベントフラグ:19:L_INDEX,LOCAL+32)
			SETBIT イベントフラグ:19:L_INDEX,LOCAL+32
			CALLFORM EVENT_19_LIST_{L_INDEX} , LOCAL,0
			LOCALS = 단발이벤트【%RESULTS%】이(가) 출현！
			CALL MESSAGE_B(1, LOCALS)
		ENDIF
		;まだ見てないイベントの数をカウント
		SIF !GETBIT(イベントフラグ:19:L_INDEX,LOCAL)
			LOCAL:1++
		LOCAL:2++
	NEXT
NEXT
IF LOCAL:1 > 0
	RESULTS = 단발이벤트\(신규{LOCAL:1}개\)
ELSE
	RESULTS = 단발이벤트
ENDIF
SIF LOCAL:2
	RETURN 1

;====================
;内容
;====================
@SHOPCOM_EVENT_19
#LOCALSIZE 5
#DIM L_INDEX
CUSTOMDRAWLINE =
PRINTFORML 어떤 이벤트를 진행합니까？
CUSTOMDRAWLINE =

FOR L_INDEX,0,20
	FOR LOCAL,0,32
		TRYCCALLFORM EVENT_19_LIST_{L_INDEX} , LOCAL,1
		CATCH
			BREAK
		ENDCATCH
		SIF !RESULT
			CONTINUE
		SIF GETBIT(イベントフラグ:19:L_INDEX,LOCAL)
			CONTINUE
		CALLFORM EVENT_19_LIST_{L_INDEX} , LOCAL,0
		;SIF RESULT == 0
		;	CONTINUE
		PRINTFORM [{L_INDEX*100+LOCAL,4}] %RESULTS%
		PRINTL
	NEXT
NEXT
PRINTFORML [9999]돌아간다
$INPUT_LOOP
INPUT
SIF RESULT == 9999
	RETURN
LOCAL:3 = RESULT / 100
LOCAL:4 = RESULT % 100
TRYCCALLFORM EVENT_19_LIST_{LOCAL:3} , LOCAL:4,1
	SIF !RESULT
		GOTO END_EVENT
	SIF GETBIT(イベントフラグ:19:(LOCAL:3),LOCAL:4)
		GOTO END_EVENT
	CALLFORM EVENT_19_LIST_{LOCAL:3} , LOCAL:4,2
	;返り値１だとイベント完了
	SIF RESULT == 1
		SETBIT イベントフラグ:19:(LOCAL:3),LOCAL:4
	;---- EDIT ADD START -------------------------
	SIF FLAG:전생리스타트예약
		RETURN 0
	;---- EDIT ADD END ---------------------------
	PRINTL
	PRINTL
	RESTART
CATCH
ENDCATCH
$END_EVENT
CLEARLINE 1
GOTO INPUT_LOOP

;====================
;出現チェック関数
;====================
@EVENT19_APP_CHECK,ARG,ARG:1
#FUNCTION
RETURNF GETBIT(イベントフラグ:19:ARG,ARG:1+32)

;====================
;完了チェック関数
;====================
@EVENT19_READ_CHECK,ARG,ARG:1
#FUNCTION
RETURNF GETBIT(イベントフラグ:19:ARG,ARG:1)

;------
;使用例
;------
;ヴォーカリスト・セイレーンをクリアしたかどうか
;SIF EVENT19_READ_CHECK(0,6)
;	RETURN 1

;====================
;出現チェック関数(タイトルで)
;====================
@EVENT19_APP_CHECK_T,ARGS = ""
#DIM L_INDEX,2
SIF ARGS == ""
	RETURN 0
FOR L_INDEX,0,20
	FOR L_INDEX:1,0,32
		TRYCCALLFORM EVENT_19_LIST_{L_INDEX} , L_INDEX:1,0
			SIF ARGS == RESULTS
				RETURN GETBIT(イベントフラグ:19:L_INDEX,L_INDEX:1+32)
		CATCH
			BREAK
		ENDCATCH
	NEXT
NEXT
RETURN 0

;====================
;完了チェック関数(タイトルで)
;====================
@EVENT19_READ_CHECK_T,ARGS = ""
#DIM L_INDEX,2
SIF ARGS == ""
	RETURN 0
FOR L_INDEX,0,20
	FOR L_INDEX:1,0,32
		TRYCCALLFORM EVENT_19_LIST_{L_INDEX} , L_INDEX:1,0
			SIF ARGS == RESULTS
				RETURN GETBIT(イベントフラグ:19:L_INDEX,L_INDEX:1)
		CATCH
			BREAK
		ENDCATCH
	NEXT
NEXT
RETURN 0

