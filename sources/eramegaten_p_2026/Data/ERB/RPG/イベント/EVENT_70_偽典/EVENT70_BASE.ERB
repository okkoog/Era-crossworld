;=======================================================================
;攻略条件
;=======================================================================
@GET_EVENT_NAME_70
#FUNCTIONS
RESULTS_F '= "위전이벤트"
RETURNF RESULTS_F

@PLAYABLE_EVENT_70
IF イベントフラグ:70:0 == 0
	SIF BASE:MASTER:LV < 20 || ダンジョンフラグ:34:8 == 0
		RETURN 0
	RESULTS = 여신의 연인
	RETURN 1

ELSEIF イベントフラグ:70:0 == 3
	RESULTS = 천사의 발버둥
	RETURN 1

ELSEIF イベントフラグ:70:0 == 4 && BASE:MASTER:LV > 49
	RESULTS = 성왕전설
	RETURN 1

ELSEIF イベントフラグ:70:0 == 5
	RESULTS = 롯폰기 공략작전
	RETURN 1

ELSEIF イベントフラグ:70:0 == 6 && 依頼フラグ:[[依頼:에코빌딩습격]]:0 != 0
	RESULTS = 황천에서 온 사자
	RETURN 1

ELSEIF イベントフラグ:70:0 == 8
	RESULTS = 잠입・바엘 성
	RETURN 1

ELSEIF イベントフラグ:70:0 == 9
	RESULTS = 이슈타르 부활
	RETURN 1
ENDIF
RETURN 0

;====================
;内容
;====================
@SHOPCOM_EVENT_70
IF イベントフラグ:70:0 == 0
	CALL EVENT_70_1
	RETURN 0

ELSEIF イベントフラグ:70:0 == 3
	CALL EVENT_70_2
	RETURN 0

ELSEIF イベントフラグ:70:0 == 4
	CALL EVENT_70_3
	RETURN 0

ELSEIF イベントフラグ:70:0 == 5
	CALL EVENT_70_4
	RETURN 0

ELSEIF イベントフラグ:70:0 == 6
	CALL EVENT_70_5
	RETURN 0

ELSEIF イベントフラグ:70:0 == 8
	CALL EVENT_70_6
	RETURN 0

ELSEIF イベントフラグ:70:0 == 9
	CALL EVENT_70_7
	RETURN 0
ENDIF