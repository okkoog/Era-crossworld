@PLAYABLE_EVENT_7
;罪ルートの場合は進行度3以上から可能
IF (STRFLAG_NUM_EV("罪ルート進行", , , , [[이벤트:페르소나２]]) >= 3 || STRFLAG_NUM_EV("罰ルート進行", , , , [[이벤트:페르소나２]]) >= 3)
	RESULTS = 소문이 사실이 되는 마을
	RETURN 1
ENDIF
RETURN 0

