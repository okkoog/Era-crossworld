;=============================================
;EVENT_200_4_レイジフルデタミネーション
;バタフライエフェクト
;=============================================
@SET_ACTION_ペインフルデターミネーション, ARG
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM ターン保存
;이 녀석에게 SP스킬은 없다
IF CFLAG:ARG:１more플래그 > 0
	;원 모어 가져갈 때마다 디버프 노래를 부른다
	IF RAND:2 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:Breakin’Through]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:Laser Beam]]
	ENDIF
ELSEIF CFLAG:ARG:행동한횟수 == 0
	IF 現HP割合(ARG) < 34
		IF RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:Breakin’Through]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:Laser Beam]]
		ENDIF
	ELSE
		IF (FLAG:경과턴수-ターン保存) % 3 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:Time to Make History]]
		ELSEIF (FLAG:경과턴수-ターン保存) % 3 == 1
			CALL SET_ACTION_SKILL, ARG, [[스킬:Go-Round]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:MAZE OF LIFE]]
		ENDIF
	ENDIF
ELSE
	IF 現HP割合(ARG) < 34
		;처음으로 HP 1/3 이하가 되고 두 번째 행동은 확정 전체 회복
		IF ターン保存 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:Never More]]
			ターン保存 = FLAG:경과턴수
		ELSE
			CFLAG:ARG:800 = 0
			CFLAG:ARG:801 = 0
			FOR LOCAL, 1, 7
				LOCALS = 포지션{LOCAL}
				SIF FLAG:LOCALS == -1
					CONTINUE
				SIF CFLAG:(FLAG:LOCALS):상태이상 == GET_STATE_NUM("DYING")
					CONTINUE
				SIF CFLAG:ARG:타겟 != -1
					CONTINUE
				;정신 1배와 약점 수를 확인
				SIF MAXBASE:(FLAG:LOCALS):정신 >= 100
					CFLAG:ARG:800 += 1
				;정신 반사와 흡수 수를 확인
				SIF MAXBASE:(FLAG:LOCALS):정신 == 999 || MAXBASE:(FLAG:LOCALS):정신 < 0
					CFLAG:ARG:801 += 1
			NEXT
			;PT의 절반 이상이 정신 1배이거나 약점이라면?
			IF CFLAG:ARG:800 > 3 && CFLAG:ARG:801 == 0
				LOCAL = RAND:2
				SELECTCASE LOCAL
				CASE 0
					CALL SET_ACTION_SKILL, ARG, [[스킬:델타・푸푸라]]
				CASE 1
					CALL SET_ACTION_SKILL, ARG, [[스킬:브레인버스트]]
				ENDSELECT
			ELSE
				LOCAL = RAND:3
				SELECTCASE LOCAL
				CASE 0
					CALL SET_ACTION_SKILL, ARG, [[스킬:트라이앵글・나이트메어]]
				CASE 1
					CALL SET_ACTION_SKILL, ARG, [[스킬:Burn my Dread]]
				CASE 2
					CALL SET_ACTION_SKILL, ARG, [[스킬:Mass Destruction]]
				ENDSELECT
			ENDIF
		ENDIF
	ELSE
		FOR LOCAL, 1, 7
			CFLAG:ARG:800 = 0
			CFLAG:ARG:801 = 0
			LOCALS = 포지션{LOCAL}
			SIF FLAG:LOCALS == -1
				CONTINUE
			SIF CFLAG:(FLAG:LOCALS):상태이상 == GET_STATE_NUM("DYING")
				CONTINUE
			SIF CFLAG:ARG:타겟 != -1
				CONTINUE
			;정신 1배와 약점 수를 확인
			SIF MAXBASE:(FLAG:LOCALS):정신 >= 100
				CFLAG:ARG:800 += 1
			;정신 반사와 흡수 수를 확인
			SIF MAXBASE:(FLAG:LOCALS):정신 == 999 || MAXBASE:(FLAG:LOCALS):정신 < 0
				CFLAG:ARG:801 += 1
		NEXT
		;PT의 절반 이상이 정신 1배이거나 약점이라면?
		IF CFLAG:ARG:800 > 3 && CFLAG:ARG:801 == 0
			LOCAL = RAND:2
			SELECTCASE LOCAL
			CASE 0
				CALL SET_ACTION_SKILL, ARG, [[스킬:텐타라후]]
			CASE 1
				CALL SET_ACTION_SKILL, ARG, [[스킬:브레인버스트]]
			ENDSELECT
		ELSE
			LOCAL = RAND:5
			SELECTCASE LOCAL
			CASE 0
				CALL SET_ACTION_SKILL, ARG, [[스킬:『불의전차』]]
			CASE 1
				CALL SET_ACTION_SKILL, ARG, [[스킬:『폭풍을부르는남자』]]
			CASE 2
				CALL SET_ACTION_SKILL, ARG, [[스킬:『얼려버리는라인』]]
			CASE 3
				CALL SET_ACTION_SKILL, ARG, [[스킬:『봄버걸』]]
			CASE 4
				CALL SET_ACTION_SKILL, ARG, [[스킬:『너의눈은일만볼트』]]
			ENDSELECT
		ENDIF
	ENDIF
ENDIF


;버터플라이 이펙트 전 전용 라이브 노벨
@EVENT_BATTLE_TURNSTART_EVENT_200_4_ペインフルデターミネーション
#DIM 進行度
#DIM COPEN
#DIM GV
SIF 進行度 == 30
	RETURN 0
CALL VARSET_KOJO_RPG_FLAG
SELECTCASE 進行度
	CASE 0
		IF FINDCHARA_B([[キャラ:아큐라_X]])  == 2
			COPEN = RESULT:1
			SETCOLOR COLOR("FRIEND")
			BTL_KOJO_RESULTS:0 = 설마, 저것과 다시 대치하게 될 줄이야……
			CALL PRINT_KOJO_RPG_MESSAGE, , COPEN

			IF SKILLGAGE_H_GET(COPEN, [[스킬:DARKNESS TRIGGER]]) == 1
			ELSE
				CALL SET_RORO_KOJO_FLAG, COPEN
				BTL_KOJO_RESULTS:0 = 아큐라……		
				CALL PRINT_KOJO_RPG_MESSAGE, , COPEN

				SETCOLOR COLOR("FRIEND")
				BTL_KOJO_RESULTS:0 = 염려 마라, 로로. 이제 와서 망설이지는 않는다
				CALL PRINT_KOJO_RPG_MESSAGE, , COPEN
				RESETCOLOR
			ENDIF
			GV = GETCHARA([[キャラ:GV]])
			IF CFLAG:GV:PT플래그 == 2
				進行度 = 1
			ELSE
				進行度 = 10
			ENDIF
		ENDIF
	CASE 1
		IF FINDCHARA_B([[キャラ:GV]])  == 2
			GV = RESULT:1
			SETCOLOR COLOR("FRIEND")
			BTL_KOJO_RESULTS:0 = （노랫소리와 함께, 그녀의 절규《목소리》가 흘러들어와
			BTL_KOJO_RESULTS:1 = 　저렇게 되어버린 이상, 이제 어쩔 도리가 없어……）
			CALL PRINT_KOJO_RPG_MESSAGE, , GV

			BTL_KOJO_RESULTS:0 = （저 아이는, 과거의 시안과 같아
			BTL_KOJO_RESULTS:1 = 　스메라기에 의해 억지로 노래해야 했던 시절의 시안과……）
			CALL PRINT_KOJO_RPG_MESSAGE, , GV
			RESETCOLOR

			進行度 = 10
		ENDIF
	CASE 10
		IF FINDCHARA_B([[キャラ:아큐라_X]])  == 2
			COPEN = RESULT:1
			SETCOLOR COLOR("FRIEND")
			BTL_KOJO_RESULTS:0 = 네가 누구이고, 어떤 경위로 그렇게 되었는지는 모른다
			BTL_KOJO_RESULTS:1 = 이제는 그 누구도 너를 구원해 줄 수 없겠지
			CALL PRINT_KOJO_RPG_MESSAGE, , COPEN

			BTL_KOJO_RESULTS:0 = 내가 할 수 있는 것은―― 그저, 파괴하는 것뿐이다
			CALL PRINT_KOJO_RPG_MESSAGE, , COPEN

			GV = GETCHARA([[キャラ:GV]])
			IF CFLAG:GV:PT플래그 == 2
				進行度 = 11
			ELSE
				進行度 = 20
			ENDIF
			RESETCOLOR
		ENDIF
	CASE 11
		IF FINDCHARA_B([[キャラ:GV]])  == 2
			GV = RESULT:1
			SETCOLOR 0x1d9eff
			BTL_KOJO_RESULTS:0 = GV, 부탁이야…… 저 아이를, 잠들게 해줘
			BTL_KOJO_RESULTS:1 = 나에게도 느껴져. 원하지 않는데 억지로 노래하고 있다는 걸
			LOCAL = 6500

			TSTR:전투구상캐릭터명칭 '= "シアン"
			TSTR:전투구상캐릭터화상어드레스 '= "GV_FACE_EX_1"
			CALL PRINT_KOJO_RPG_MESSAGE, , GV

			SETCOLOR COLOR("FRIEND")
			BTL_KOJO_RESULTS:0 = 물론이지, 시안. 우리들만이, 그것을 할 수 있으니까
			CALL PRINT_KOJO_RPG_MESSAGE, , GV		
			進行度 = 20
		ENDIF
	CASE 20
		IF FINDCHARA_B([[キャラ:아큐라_X]])  == 2
			COPEN = RESULT:1
			SETCOLOR COLOR("FRIEND")
			BTL_KOJO_RESULTS:0 = 버터플라이 이펙트는 존재 자체도 용납되지 않는다
			BTL_KOJO_RESULTS:1 = 설령 형상만 흉내낸 모조품일지라도…… 그 금기, 내가 토멸한다!
			SIF CSTR:COPEN:아이콘패턴 == "デフォルト"
				TSTR:전투구상캐릭터화상어드레스 '= "アキュラ_X_" + CONVERT_FACE_ADDRESS_アキュラ("SPスキル")
			CALL PRINT_KOJO_RPG_MESSAGE, , COPEN

			GV = GETCHARA([[キャラ:GV]])
			IF CFLAG:GV:PT플래그 == 2
				進行度 = 21
			ELSE
				進行度 = 30
			ENDIF
			RESETCOLOR
		ENDIF
	CASE 21
		IF FINDCHARA_B([[キャラ:GV]])  == 2
			GV = RESULT:1
			SETCOLOR COLOR("FRIEND")
			BTL_KOJO_RESULTS:0 = 용솟음쳐라! 푸른 뇌정이여《암드 블루》!!
			BTL_KOJO_RESULTS:1 = 기계에 사로잡힌 영혼을 해방할, 구제의 일섬이 되어라!!
			SIF CSTR:GV:아이콘패턴 == "デフォルト"
				TSTR:전투구상캐릭터화상어드레스 '= "GV_FACE_EX_0"
			CALL PRINT_KOJO_RPG_MESSAGE, , GV		
			進行度 = 30
			RESETCOLOR
		ENDIF
ENDSELECT
