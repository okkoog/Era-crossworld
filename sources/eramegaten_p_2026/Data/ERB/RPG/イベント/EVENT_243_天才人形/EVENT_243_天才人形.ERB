@SET_BOSS_ENEMY_EVENT_243, L_ENEMY_NAME, L_NO = -1, L_OPT
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_NO
#DIM DYNAMIC L_ENEMY
#DIMS DYNAMIC L_ENEMY_NAME
#DIMS DYNAMIC L_OPT
#DIMS DYNAMIC L_ENEMY_TABLE, 10

L_ENEMY_TABLE:0 '= "수수께끼의 인형"

IF L_NO >= 0
	SIF !INRANGE(L_NO, 0, VARSIZE("L_ENEMY_TABLE") - 1)
		RETURN 0
	L_ENEMY_NAME '= L_ENEMY_TABLE:L_NO
ENDIF
IF L_OPT == "名称取得"
	SIF L_ENEMY_TABLE:L_NO == ""
		RETURN 0
	RESULTS '= L_ENEMY_NAME
	RETURN 1
ENDIF

CALL SET_ENEMY,9, [[キャラ:헤르타]], 20, 0, 1
NAME:(CHARANUM-1) = 수수께끼의 인형
CALLNAME:(CHARANUM-1) = 수수께끼의 인형
L_ENEMY = CHARANUM - 1
CSTR:L_ENEMY:사고패턴 = 수수께끼의인형
TSTR:전투이벤트패턴 = 수수께끼의 인형
CALL SET_ENEMY_TIMEID, L_ENEMY, "수수께끼의 인형"
CFLAG:L_ENEMY:강제악마화 = 1
ABL:L_ENEMY:공격상성 = GET_TYPE_NUM("타격")
FOR LCOUNT, 0, TYPENUM
	SELECTCASE GET_TYPE(LCOUNT)
		CASE "빙결", "파마", "수격"
			BASE:L_ENEMY:GET_TYPE(LCOUNT) = 0
		CASE "화염", "전격", "핵열"
			BASE:L_ENEMY:GET_TYPE(LCOUNT) = 150
	ENDSELECT
NEXT
;全貫通持ちなのでHP補正はやめておく。
CFLAG:L_ENEMY:ＭＰ보정 += 2000
CFLAG:L_ENEMY:행동횟수 = 1
BASE:L_ENEMY:힘 = 1
BASE:L_ENEMY:지혜 = 12
BASE:L_ENEMY:마력 = 12
BASE:L_ENEMY:내구 = 7
BASE:L_ENEMY:속도 = 12
BASE:L_ENEMY:운 = 4
;余計なスキルを持たないよう初期化
CALL CLEAR_ALL_SKILL, L_ENEMY

;順に単体、一列、全体を撃ってくる。

;やっぱり私がやるは敵だと上手く動かせなかったので持たない
;２段階マカカジャの改善すべきだよを搭載。

CALL SET_SKILL, L_ENEMY, "何見てるの"
CALL SET_SKILL, L_ENEMY, "一度限りの取引"
CALL SET_SKILL, L_ENEMY, "私がかけた魔法だよ"
CALL SET_SKILL, L_ENEMY, "改善すべきだよ"
CALL SYNC_STATUS,L_ENEMY
CALL HEALTH_CHARA,L_ENEMY

;=======================================================================
@SET_ACTION_수수께끼의인형, ARG

@SET_ACTION_謎の人形, ARG
CALL SET_ACTION_수수께끼의인형, ARG
;=======================================================================
;敵特殊思考パターン
;基本行動
;1ターン目　何見てるの
;2ターン目　一度限りの取引
;3ターン目　私がかけた魔法だよ
;1ターン目へ
;=======================================================================
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

;ワンモア（クリティカルか、弱点を突いた場合の行動）
IF CFLAG:ARG:１more플래그 > 0
	;1more時は一度限りの取引を撃つ
	CALL SET_ACTION_SKILL, ARG, PU_SKILLNUM_GET(ARG, "一度限りの取引")
ELSEIF CFLAG:ARG:행동한횟수 == 0
	SELECTCASE FLAG:경과턴수 % 3
		;１ターン目
		CASE 0
			CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "何見てるの")
		;２ターン目
		CASE 1
			CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "一度限りの取引")
		;３ターン目
		CASEELSE
			CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "私がかけた魔法だよ")
	ENDSELECT
ENDIF

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;行動未決定時のおまじない
SIF CFLAG:ARG:입력행동 == -1
	CALL ランダム行動 , ARG
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1