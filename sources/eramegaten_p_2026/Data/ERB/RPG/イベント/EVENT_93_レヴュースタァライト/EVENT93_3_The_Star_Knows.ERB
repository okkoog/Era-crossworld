		LOCAL:97 = 1
	ENDIF
	
	;レベルは自軍最大値（最低値10）
	LOCAL:98 = 0
	FOR LOCAL , 0 , CHARANUM
		SIF IS_JOINABLE_BATTLE(LOCAL) < 1
			CONTINUE
		LOCAL:98 = MAX(LOCAL:98 , BASE:LOCAL:LV)
	NEXT
	SIF LOCAL:98 < 10
		LOCAL:98 = 10
	
	;- SET:純那
		;メガネ
		;最終戦は出ない
