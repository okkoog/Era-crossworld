		IF RAND:5 == 0
			;화염
			CALL SET_ACTION_SKILL, ARG, [[스킬:파이어브레스]]
		ELSEIF RAND:4 == 0
			;주살
			CALL SET_ACTION_SKILL, ARG, [[스킬:페트라브레스]]
		ELSEIF RAND:3 == 0
			;지원
			CALL SET_ACTION_SKILL, ARG, [[스킬:용해브레스]]
		ELSEIF RAND:2 == 0
			;주살
			CALL SET_ACTION_SKILL, ARG, [[스킬:데스브레스]]
		ELSE
			;화염
			CALL SET_ACTION_SKILL, ARG, [[스킬:파이어브레스]]
		ENDIF
		
	;3번째 수는 전기술
	ELSEIF CFLAG:ARG:행동한횟수 == 2
		IF RAND:5 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:명계의문]]
		ELSEIF RAND:4 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:트리플바이스]]
		ELSEIF RAND:3 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:용해액]]
		ELSEIF RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:머리깨기]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:메가클로]]
		ENDIF
		
	;4번째 수도 전기술
	ELSEIF CFLAG:ARG:행동한횟수 == 3
		IF RAND:5 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:명계의문]]
		ELSEIF RAND:4 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:트리플바이스]]
		ELSEIF RAND:3 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:용해액]]
		ELSEIF RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:머리깨기]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:메가클로]]
		ENDIF
		
		
	;5번째 수는 드래곤퀘이크 or 마하・마그나스
	ELSE
		;지변
		;3턴에 1회 드래곤퀘이크
		IF FLAG:경과턴수 % 3 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:드래곤퀘이크]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:마하・마그나스]]
		ENDIF
		
	ENDIF

;イベントフラグ:93:15, 3……두 번째 단계 사악한 정령
ELSEIF GETBIT(イベントフラグ:93:15, 3)
	IF CFLAG:ARG:행동한횟수 == 0
		IF RAND:3 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:갈라]]
		ELSEIF RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:아기라오]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:마그나스]]
		ENDIF
	;2 패턴
	ELSEIF CFLAG:ARG:행동한횟수 == 1 && RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:마하주온]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
			CALL SET_ACTION_SKILL, ARG, [[스킬:히트라이저]]
	
	ELSE
		;주살
		;3턴에 1회 카오스엘리먼트
		IF FLAG:경과턴수 % 3 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:카오스엘리먼트]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:마하에이하]]
		ENDIF
		
	ENDIF


;그 외 (제1단계)
ELSE
	IF CFLAG:ARG:행동한횟수 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:마하에이하]]
			
	;2 패턴
	ELSEIF CFLAG:ARG:행동한횟수 == 1 && RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:마하・마그나스]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
			CALL SET_ACTION_SKILL, ARG, [[스킬:히트라이저]]
			
	ELSE
		IF CFLAG:ARG:행동한횟수 == 2 && RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:머리깨기]]
		ELSE
			CALL ランダム行動 , ARG
		ENDIF
		
	ENDIF
ENDIF
