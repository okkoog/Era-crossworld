			CALL SET_ACTION_SKILL, ARG, [[스킬:타루・카쟈]]
		ELSE
			;화염
			CALL SET_ACTION_SKILL, ARG, [[스킬:소작권]]
		ENDIF
		
	;絶望の女神
	ELSE
		;중력
		;２ターンに１回七星降天
		IF FLAG:경과턴수 % 2 == 0
			;중력
			CALL SET_ACTION_SKILL, ARG, [[스킬:칠성강천]]
		ELSE
			;지원
			CALL SET_ACTION_SKILL, ARG, [[스킬:랜더마이저]]
		ENDIF
		
	ENDIF

;それ以外（第一段階）絶望の女神
ELSE
	CALL SET_ACTION_SKILL, ARG, [[스킬:칠성강천]]
