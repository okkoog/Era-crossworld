@SET_ACTION_高天原の舞台少女, ARG
#DIM ガード殺すマン
#DIM ループ用
;殺すマンゼロクリア
ガード殺すマン = 0

;イベントフラグ:93:12, 6……ラスト（愛の星のアマテラス／クライマックスレヴュー）
IF GETBIT(イベントフラグ:93:12, 5) && BASE:(CHARANUM-1):ＨＰ < 2
		;約束タワーブリッジ連射
		CALL SET_ACTION_SKILL, ARG, [[스킬:만마의일격]]

;イベントフラグ:93:12, 5……最終段階（愛の星のアマテラス）
ELSEIF GETBIT(イベントフラグ:93:12, 5)
	IF CFLAG:ARG:행동한횟수 == 0
		IF RAND:2 == 0
			;火炎全体ランダム
			CALL SET_ACTION_SKILL, ARG, [[스킬:연성의불꽃]]
		ELSE
			;火炎単体
			CALL SET_ACTION_SKILL, ARG, [[스킬:소작권]]
		ENDIF
		
	;２パターン
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		IF RAND:2 == 0
			;核熱全体
			CALL SET_ACTION_SKILL, ARG, [[스킬:코즈믹플레어]]
		ELSE
			;敵味方CT率増
			CALL SET_ACTION_SKILL, ARG, [[스킬:레볼루션]]
		ENDIF
		
	ELSE
		IF CFLAG:ARG:행동한횟수 == 2 && RAND:3 == 0
			;単体剣撃＋SHOCK
			CALL SET_ACTION_SKILL, ARG, [[스킬:번개찌르기]]
		ELSE
			;全体剣撃
			CALL SET_ACTION_SKILL, ARG, [[스킬:허공참파]]
		ENDIF
		
	ENDIF

;イベントフラグ:93:12, 4……三段階目
ELSEIF GETBIT(イベントフラグ:93:12, 4)
	IF CFLAG:ARG:행동한횟수 == 0
		IF RAND:2 == 0
			;電撃全体
			CALL SET_ACTION_SKILL, ARG, [[스킬:썬더볼트]]
		ELSE
			;重力一列
			CALL SET_ACTION_SKILL, ARG, [[스킬:그라비티마인]]
		ENDIF
		
	;２パターン
	ELSEIF CFLAG:ARG:행동한횟수 == 1 && RAND:2 == 0
			;검격　前一列
			CALL SET_ACTION_SKILL, ARG, [[스킬:데스바운드]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
			;타격　前一列
			CALL SET_ACTION_SKILL, ARG, [[스킬:아카샤아츠]]
		
	ELSE
		IF CFLAG:ARG:행동한횟수 == 2 && RAND:3 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:이니셜라이즈]]
		ELSE
			;주살　
			CALL SET_ACTION_SKILL, ARG, [[스킬:테트라프리즌]]
		ENDIF
		
	ENDIF

;イベントフラグ:93:12, 3……二段階目
ELSEIF GETBIT(イベントフラグ:93:12, 3)
	IF CFLAG:ARG:행동한횟수 == 0
		IF RAND:2 == 0
			;電撃全体
			CALL SET_ACTION_SKILL, ARG, [[스킬:썬더볼트]]
		ELSE
			;타격　前一列
			CALL SET_ACTION_SKILL, ARG, [[스킬:아카샤아츠]]
		ENDIF
		
	;２パターン
	ELSEIF CFLAG:ARG:행동한횟수 == 1 && RAND:2 == 0
			;水撃一列
			CALL SET_ACTION_SKILL, ARG, [[스킬:물살가르기]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
			;검격　前一列
			CALL SET_ACTION_SKILL, ARG, [[스킬:데스바운드]]
	ELSE
		;2パターン
		IF RAND:2 == 0
			;타격　前一体
			CALL SET_ACTION_SKILL, ARG, [[스킬:맹돌진]]
		ELSE
			;검격　前一体
			CALL SET_ACTION_SKILL, ARG, [[스킬:낭아천주참]]
		ENDIF
		
	ENDIF


;それ以外（第一段階）
ELSE
	IF CFLAG:ARG:행동한횟수 == 0
		;電撃１体
		CALL SET_ACTION_SKILL, ARG, [[스킬:지오다인]]
		
	;２パターン
	ELSEIF CFLAG:ARG:행동한횟수 == 1 && RAND:2 == 0
			;검격　前一体
			CALL SET_ACTION_SKILL, ARG, [[스킬:퀵버스터]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
			;重力１体
			CALL SET_ACTION_SKILL, ARG, [[스킬:그라다인]]
	ELSE
		;타격　前一体
		CALL SET_ACTION_SKILL, ARG, [[스킬:맹돌진]]
		
	ENDIF
ENDIF

