@SET_ACTION_격노한후타바, ARG
#DIM ガード殺すマン
#DIM ループ用
;殺すマンゼロクリア
ガード殺すマン = 0

IF CFLAG:ARG:행동한횟수 == 0
	FOR ループ用, 1, 7
		;ガードしている誰かを探してガード殺すマンを保存
		IF POS(ループ用) >= 0 && GET_STATE(CFLAG:POS(ループ用):상태이상) != "DYING" && CFLAG:POS(ループ用):방어플래그
			ガード殺すマン = ループ用
			BREAK
		ENDIF
	NEXT
	;誰もガードしていないのなら暴れまくり
	IF ガード殺すマン == 0
		CFLAG:ARG:입력행동 = [[스킬:마구날뛰기]]
	;ガードしてたらそいつを殺す
	ELSE
		SETCOLOR 0x815ca1
		;みんな大好きバルバドス
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃가드 따위…… 올리고 앉았냐!　　　　　　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
		RESETCOLOR
		CFLAG:ARG:타겟 = ガード殺すマン
		CFLAG:ARG:입력행동 = [[스킬:방어부수기]]
	ENDIF
	
ELSEIF CFLAG:ARG:행동한횟수 == 1
	CFLAG:ARG:입력행동 = [[스킬:질풍격]]
	
ELSE
	IF CFLAG:ARG:행동한횟수 == 2 && RAND:2 == 0
		SETCOLOR 0x815ca1
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃숨 좀 가다듬어야겠어!　　　　　　　　　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
		RESETCOLOR
		CFLAG:ARG:입력행동 = [[스킬:기합]]
	ELSE
		CALL ランダム行動 , ARG
	ENDIF
	
ENDIF


@SET_ACTION_오차즈케라도드시지요, ARG
#DIM 不健康カウント
#DIM ループ用


;奇数ターンは疾風物理
IF CFLAG:ARG:행동한횟수 == 0 && FLAG:경과턴수 % 2 == 0
	SETCOLOR 0xdc7b8c
	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃그라믄, 대담하게~♪　　　　　　　　　　　　┃
	PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
	RESETCOLOR
	CFLAG:ARG:입력행동 = [[스킬:전용기2]]
;偶数ターンはテンタラフー互換
ELSEIF CFLAG:ARG:행동한횟수 == 0
	SETCOLOR 0xdc7b8c
	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃그라믄, 우아하게…… 가볼까예?　　　　　　　┃
	PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
	RESETCOLOR
	CFLAG:ARG:입력행동 = [[스킬:전용기1]]
	
	
ELSEIF CFLAG:ARG:행동한횟수 == 1
	CFLAG:ARG:입력행동 = [[스킬:바리언트댄스]]
	
ELSE
	不健康カウント = 0
	FOR ループ用, 1, 7
		;状態異常（死亡・魅了以外）をカウント
		IF POS(ループ用) >= 0 && GET_STATE(CFLAG:POS(ループ用):상태이상) != "DYING" && GET_STATE(CFLAG:POS(ループ用):상태이상) != "GOOD"
			不健康カウント ++
		ENDIF
	NEXT
	;バステを溜めると壊滅
	IF CFLAG:ARG:행동한횟수 == 2 && 不健康カウント > 3
		;全体確定魅了
		SETCOLOR 0xdc7b8c
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃서면 작약, 앉으면 모란, 춤추는 자태는 월하미인……┃
		PRINTFORML ┃99기생, 하나야기 카오루코!　　　　　　　　　┃
		PRINTFORML ┃끝까지 함께해 줘야겠데이!　　　　　　　　　┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━┛
		RESETCOLOR
		PRINTFORMW ＞큰일이다, 배드 스테이터스를 너무 많이 쌓았다!
		
		FOR ループ用, 1, 7
			;死亡者以外を強制的にCHARMへ
			IF POS(ループ用) >= 0 && GET_STATE(CFLAG:POS(ループ用):상태이상) != "DYING"
				;実際にHAPPYする処理
				PRINTFORML 　　TARGET:[{ループ用,2}] %CALLNAME:POS(ループ用),20,LEFT%　>>>>>>　그라믄, 『CHARM』이라예%UNICODE(0x2661)%
				CFLAG:POS(ループ用):상태이상 = GET_STATE_NUM("CHARM")
				CFLAG:POS(ループ用):상태이상경과턴수 = 0
				CALL SYNC_STATUS,POS(ループ用)
			ENDIF
		NEXT
		WAIT
		
	ELSEIF CFLAG:ARG:행동한횟수 == 2 && RAND:10 == 0
		SETCOLOR 0xdc7b8c
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃내 이름은 하나야기 카오루코… 언젠가 세계를 쥘 여자라 카이!┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
		RESETCOLOR
		CFLAG:ARG:입력행동 = [[스킬:스마일차지]]
		IF 不健康カウント > 1
			PRINTFORML ＞어서 배드 스테이터스를 해제해야 한다……!
			FORCEWAIT
		ENDIF
	ELSE
		CALL ランダム行動 , ARG
		IF 不健康カウント > 1
			PRINTFORML ＞어서 배드 스테이터스를 해제해야 한다……!
			FORCEWAIT
		ENDIF
	ENDIF
	
ENDIF

