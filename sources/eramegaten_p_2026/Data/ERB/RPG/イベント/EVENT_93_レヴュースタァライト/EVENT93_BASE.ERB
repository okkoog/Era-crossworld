@GET_NO_舞台少女, ARGS
#FUNCTION
SELECTCASE ARGS
	CASE "華恋"
		RETURNF [[キャラ:카렌_무대소녀]]
	CASE "ひかり"
		RETURNF [[キャラ:히카리]]
	CASE "まひる"
		RETURNF [[キャラ:마히루]]
	CASE "純那"
		RETURNF [[キャラ:쥰나]]
	CASE "双葉"
		RETURNF [[キャラ:후타바_무대소녀]]
	CASE "香子"
		RETURNF [[キャラ:카오루코]]
	CASE "なな"
		RETURNF [[キャラ:나나]]
	CASE "真矢"
		RETURNF [[キャラ:마야_무대소녀]]
	CASE "クロディーヌ"
		RETURNF [[キャラ:클로딘]]
	CASEELSE
		THROW 不適切な名称[%ARGS%]がARGSとして指定されています
ENDSELECT

