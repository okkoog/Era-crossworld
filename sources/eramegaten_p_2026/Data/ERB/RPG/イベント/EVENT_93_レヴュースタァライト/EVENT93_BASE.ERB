			LOCAL = EVENT93_推しの位置取得()
			;推しのレベルが低すぎる場合、怒られる
			IF BASE:LOCAL:LV < 40
				RESULTS = （EX:RSL）세이렌 선생님이 화났다……
			ELSE
				RESULTS = （EX:RSL）【경고】무대소녀를 합숙에 보낸다【경고】
			ENDIF
			RETURN 1
		ELSE
			RETURN 0
		ENDIF
	;合宿に送ったあと
	ELSEIF (イベントフラグ:93:0 == 12 || イベントフラグ:93:0 == 13)
		IF 先生の数 > 1 && イベントフラグ:93:10 > 0
			SELECTCASE イベントフラグ:93:10
				CASE [[キャラ:나나]]
					IF 大場ななの記憶_L:0:1 < 3
						RESULTS = （EX:RSL）빛나는 무지개와도 같은 행복한 나날을, 영원히
					ELSE
						RESULTS = （EX:RSL）『다이바 나나』
					ENDIF
				CASEELSE
					RESULTS = （EX:RSL）별을 목표로 한 소녀들에게
			ENDSELECT
			RETURN 1
		ELSE
			RETURN 0
		ENDIF
	;キリンのありがたいコメント
	ELSEIF イベントフラグ:93:0 == 9
		RESULTS = （EX:RSL）※지하극장에는 아무도 없다
		RETURN 1
	;舞台少女戦は終わったけど個別イベントの消化がまだ
	ELSEIF イベントフラグ:93:0 == 8 && EVENT93_個別イベ3終わった判定() < 9
		RESULTS = （EX:RSL）무대소녀와 마주한다
		RETURN 1
	;舞台少女戦が終わってない
	ELSEIF イベントフラグ:93:0 < 8
		RESULTS = （EX:RSL）기린의 지하극장에서 레뷰에 도전한다
		RETURN 1
	ENDIF
RETURN 0


