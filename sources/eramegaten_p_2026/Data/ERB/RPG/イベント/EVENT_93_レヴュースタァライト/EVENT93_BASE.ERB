	SIF 大場ななの記憶:0:1 < 2 && !GETS_USEABLE_EXTRA_TITLE("レヴュースタァライト")
		RETURN 0
	
	;組織貢献度10000で解放
	SIF FLAG:조직공헌도 < 10000
		RETURN 0
		
	;イベントフラグ:93:0 が 9 以上のときだけ、特定の悪魔がいるかどうか判定
	IF イベントフラグ:93:0 > 8
		先生の数 = 0
		SIF ヴォーカリスト・セイレーン進行 && FINDCHARA_B([[キャラ:세이렌]], 1) >= 0
			先生の数 += 1
		SIF シナリオライター・ジークフリート進行 > 1 && FINDCHARA_B([[キャラ:지크프리트]], 1) >= 0
			先生の数 += 1
		;IF ヴォーカリスト・セイレーン進行 > 1
		;	FOR LOCAL, 0, CHARANUM
		;		;劇場憑きのセイレーンはここで判定
		;		IF NO:LOCAL == [[キャラ:세이렌]] && CFLAG:LOCAL:998 == 1
		;			先生の数 ++
		;			BREAK
		;		ENDIF
		;	NEXT
		;ENDIF
		;;シナリオライター・ジークフリート（大劇場）
		;IF 
		;	FOR LOCAL, 0, CHARANUM
		;		;劇場憑きのジークフリートはここで判定
		;		IF NO:LOCAL == [[キャラ:지크프리트]] && CFLAG:LOCAL:998 == 1
		;			先生の数 ++
		;			BREAK
		;		ENDIF
		;	NEXT
		;ENDIF
		;PRINTV 先生の数
		;PRINTL ﾆｬｰﾝ
		;WAIT
	ENDIF

	;(舞台少女戦制覇後は省略)
	IF イベントフラグ:93:0 == 0 && GLOBAL:기린의기억 < 1
		RESULTS = （EX:RSL）착신・ki-ringtone
		RETURN 1
	;(舞台少女戦制覇後は省略)
	ELSEIF イベントフラグ:93:0 == 1 && GLOBAL:기린의기억 < 1
		RESULTS = （EX:RSL）정열의 레뷰 【-Re_PLAY-】
		RETURN 1
	;舞台少女戦＆個別イベント3終了後かつ、マヨ公加入可能フラグ後、上司を名乗る何者かの来訪　舞台少女全員揃い
	ELSEIF イベントフラグ:93:0 == 8 && EVENT93_個別イベ3終わった判定() > 8 && (イベントフラグ:1:0 > 1 && BASE:MASTER:LV > 40) && (EVENT93_人数確認() > 8)
		RESULTS = （EX:RSL）……상사가 와 있다
		RETURN 1
	;上司襲来後、劇場憑き悪魔のうち、セイレーンとジークフリートがいる
	ELSEIF イベントフラグ:93:0 == 10
		IF 先生の数 > 1 && (EVENT93_人数確認() > 8)
			RESULTS = （EX:RSL）무대소녀와 극장의 악마
			RETURN 1
		ELSE
			RETURN 0
		ENDIF		
	;先生ズとの顔合わせ後、劇場憑き悪魔のうち、セイレーンとジークフリートがいる
	;2022/04/30　全員実装
	;ELSEIF イベントフラグ:93:0 == 11 && 先生の数 > 1 && (イベントフラグ:93:10 == [[キャラ:카렌_무대소녀]] || イベントフラグ:93:10 == [[キャラ:히카리]] || イベントフラグ:93:10 == [[キャラ:마히루]] || イベントフラグ:93:10 == [[キャラ:쥰나]] || イベントフラグ:93:10 == [[キャラ:후타바_무대소녀]] || イベントフラグ:93:10 == [[キャラ:카오루코]] || イベントフラグ:93:10 == [[キャラ:나나]] || イベントフラグ:93:10 == [[キャラ:마야_무대소녀]] || イベントフラグ:93:10 == [[キャラ:클로딘]]) && (EVENT93_人数確認() > 8)
