;推しといいつつ明確に恋慕信頼系優遇の判定かつ同率の場合の優先度が平等ではないので何かに流用する人は注意な
;実行後に何が帰ってくるかはRETURNの直前参照
@EVENT93_推しチェック
#DIM DYNAMIC ループ用, 2
#DIM DYNAMIC 推し番号1
#DIM DYNAMIC 推し番号2
#DIM DYNAMIC 推し番号3
#DIM DYNAMIC 推し番号4
#DIM DYNAMIC 推し番号5
#DIM DYNAMIC 推し番号6
#DIM DYNAMIC 推し番号7
#DIM DYNAMIC 推し番号8
#DIM DYNAMIC 推し番号9
#DIM DYNAMIC ポイント計算用
#DIM DYNAMIC 個別番号, 9
#DIM DYNAMIC 個別ポイント, 9

FOR ループ用, 0, CHARANUM
	IF GROUPMATCH(NO:ループ用, [[キャラ:카렌_무대소녀]], [[キャラ:히카리]], [[キャラ:마히루]], [[キャラ:쥰나]], [[キャラ:후타바_무대소녀]], [[キャラ:카오루코]], [[キャラ:나나]], [[キャラ:마야_무대소녀]], [[キャラ:클로딘]])
		;ひとつでも取得しちゃってる場合は-1点で固定ですニャン
		IF GET_VALUE_TALENT_JOINABLE(ループ用) > 0 && TALENT:ループ用:비전투원 < 1 && TALENT:ループ用:예속 < 1 && TALENT:ループ用:복종 < 1 && TALENT:ループ用:붕괴 < 1
			;計算領域ゼロクリア
			ポイント計算用 = 0
			
			;以下、習得素質に基づき足し算していく
			;基本的にはクリティカルな素質・経験などのみ足していく
			
			;契約系
			IF TALENT:ループ用:맹우
				ポイント計算用 += 1000
			ELSEIF TALENT:ループ用:아내 || TALENT:ループ用:남편
				ポイント計算用 += 800
			ELSEIF TALENT:ループ用:음마
				ポイント計算用 += 500
			;上位陥落
			ELSEIF TALENT:ループ用:동료
				ポイント計算用 += 1000
			ELSEIF TALENT:ループ用:친애
				ポイント計算用 += 800
			ELSEIF TALENT:ループ用:창부
				ポイント計算用 += 500
			;下位陥落
			ELSEIF TALENT:ループ用:신뢰
				ポイント計算用 += 500
			ELSEIF TALENT:ループ用:연모
				ポイント計算用 += 400
			ELSEIF TALENT:ループ用:음란
				ポイント計算用 += 250
			ENDIF
			
			;EXP
			SIF EXP:ループ用:애정경험 > 9
				ポイント計算用 += (EXP:ループ用:애정경험 / 10)
			SIF EXP:ループ用:이상경험
				ポイント計算用 += EXP:ループ用:이상경험
			;충성도(1/100にして加算）
			SIF GET_CHARA_LOYALTY(ループ用) > 99
				ポイント計算用 += (GET_CHARA_LOYALTY(ループ用) / 100)
			;LV(10倍にして加算）
			SIF BASE:ループ用:LV > 9
				ポイント計算用 += (BASE:ループ用:LV * 10)
				
			;最後は属性LD軸で加減（影響大）
			;Lだとスタァライトされているとみなし掛け算
			;スタァライトされるって日本語おかしいね
			IF ABL:ループ用:속성LD == 1
				TIMES ポイント計算用 , 1.25
			;Dだと割り算。デフォだと大場だけ
			ELSEIF ABL:ループ用:속성LD == 3
				TIMES ポイント計算用 , 0.75
			ENDIF
			;Q:なんでLだとスタァライトされてるの？　天使とかと同類なの？
			;A:舞台に目覚め、舞台に生き、舞台のために命を燃やす
			;　そんなキチガイのアライメントがまともだと思ってんの？
		ELSE
			ポイント計算用 = -1
		ENDIF
		
		;0の場合は1にする（ソートが機能しないので）
		SIF ポイント計算用 == 0
			ポイント計算用 = 1
		
		;キャラ番号とか記憶
		SELECTCASE NO:ループ用
			CASE [[キャラ:카렌_무대소녀]]
				個別ポイント:0 = ポイント計算用
				個別番号:0 = ループ用
			CASE [[キャラ:히카리]]
				個別ポイント:1 = ポイント計算用
				個別番号:1 = ループ用
			CASE [[キャラ:쥰나]]
				個別ポイント:2 = ポイント計算用
				個別番号:2 = ループ用
			CASE [[キャラ:마히루]]
				個別ポイント:3 = ポイント計算用
				個別番号:3 = ループ用
			CASE [[キャラ:후타바_무대소녀]]
				個別ポイント:4 = ポイント計算用
				個別番号:4 = ループ用
			CASE [[キャラ:카오루코]]
				個別ポイント:5 = ポイント計算用
				個別番号:5 = ループ用
			CASE [[キャラ:나나]]
				個別ポイント:6 = ポイント計算用
				個別番号:6 = ループ用
			CASE [[キャラ:마야_무대소녀]]
				個別ポイント:7 = ポイント計算用
				個別番号:7 = ループ用
			CASE [[キャラ:클로딘]]
				個別ポイント:8 = ポイント計算用
				個別番号:8 = ループ用
		ENDSELECT
	ENDIF
NEXT

;存在しない（個別番号が0）舞台少女の個別番号・個別ポイントを-1へ変換　ソートが機能しなくなるので
FOR ループ用, 0, 9
	IF 個別番号:ループ用 == 0
		個別番号:ループ用 = -1
		個別ポイント:ループ用 = 1
	ENDIF
NEXT

FOR ループ用, 0, 9
	SIF 個別ポイント:ループ用 == 0
		個別ポイント:ループ用 = __INT_MAX__
NEXT
ARRAYMSORT 個別ポイント,個別番号
FOR ループ用, 0, 9
	SIF 個別ポイント:ループ用 == __INT_MAX__
		個別ポイント:ループ用 = 0
NEXT

