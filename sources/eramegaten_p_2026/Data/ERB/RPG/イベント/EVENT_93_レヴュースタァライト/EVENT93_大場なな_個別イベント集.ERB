			PRINTW 지하 극장에, 강렬한 마그네타이트 반응이 나타난 것은.

		ENDIF

	ENDIF




;----------------여기서부터 아래, 나나 관련 각종 함수----------------------------------------------

;조금 더 좋은 방법이 있을 거라 생각하지만 뭐 상관없겠지
;다른 파일을 그다지 건드리고 싶지 않아서 이런 느낌으로 했는데,
;어떠신가요
@EVENT_93_大場なな_毎日の判定
#DIM DYNAMIC 루프용0
#DIM DYNAMIC 루프용1

;첫날 아침 한정　글로벌 변수와의 동기 및 최근 플레이에서 이어받은 함락 내용을 카운트한 뒤, 소거
;라는 처리가 일찍이 존재했던 것이다
IF DAY < 2 && TIME < 1

;첫날 아침 이외에는 나나의 2인칭과 각 무대소녀의 함락 상태를 오로지 계속 기억해둔다
;나나가 있다
ELSEIF GETCHARA([[キャラ:나나]]) > -1
	LOADGLOBAL

	LOCAL:1 = GETCHARA([[キャラ:나나]])
	大場ななの二人称 = %CSTR:(LOCAL:1):이인칭%

	;각 무대소녀의 함락 상태
	;사용처는 생각 안 함 ()
	;이쪽은 대략적으로 기록 (마지막으로 읽은 세이브 데이터에 따라 이리저리 바뀜)
	FOR LOCAL:1, 1, 10
		IF LOCAL:1 == 1
			LOCAL:0 = GETCHARA([[キャラ:카렌_무대소녀]])
		ELSEIF LOCAL:1 == 2
			LOCAL:0 = GETCHARA([[キャラ:히카리]])
		ELSEIF LOCAL:1 == 3
			LOCAL:0 = GETCHARA([[キャラ:쥰나]])
		ELSEIF LOCAL:1 == 4
			LOCAL:0 = GETCHARA([[キャラ:마히루]])
		ELSEIF LOCAL:1 == 5
			LOCAL:0 = GETCHARA([[キャラ:후타바_무대소녀]])
		ELSEIF LOCAL:1 == 6
			LOCAL:0 = GETCHARA([[キャラ:카오루코]])
		ELSEIF LOCAL:1 == 7
			CONTINUE
		ELSEIF LOCAL:1 == 8
			LOCAL:0 = GETCHARA([[キャラ:마야_무대소녀]])
		ELSEIF LOCAL:1 == 9
			LOCAL:0 = GETCHARA([[キャラ:클로딘]])
		ENDIF
		;-1이 돌아왔다 (존재하지 않음)
		IF LOCAL < 0
			;가입 이벤트가 끝났는데도 존재하지 않는 (팔았거나 지웠다) 경우
			IF イベントフラグ:93:(LOCAL:1)
				大場ななの記憶_L:2:(LOCAL:1) = -1
				大場ななの記憶:2:(LOCAL:1) = -1
			ENDIF
		;연모・신뢰는 같은 판정
		ELSEIF TALENT:LOCAL:연모 || TALENT:LOCAL:친애 || TALENT:LOCAL:신뢰 || TALENT:LOCAL:동료
			大場ななの記憶_L:2:(LOCAL:1) = 1
			大場ななの記憶:2:(LOCAL:1) = 1
		;음란
		ELSEIF TALENT:LOCAL:음란 || TALENT:LOCAL:창부
			大場ななの記憶_L:2:(LOCAL:1) = 2
			大場ななの記憶:2:(LOCAL:1) = 2
		;복종・붕괴는 같은 판정
		ELSEIF TALENT:LOCAL:복종 || TALENT:LOCAL:예속 || TALENT:LOCAL:붕괴
			大場ななの記憶_L:2:(LOCAL:1) = 3
			大場ななの記憶:2:(LOCAL:1) = 3
		ELSE
			大場ななの記憶_L:2:(LOCAL:1) = 0
			大場ななの記憶:2:(LOCAL:1) = 0
		ENDIF

		SAVEGLOBAL

	NEXT

	;나나의 함락 횟수가 로컬과 글로벌에서 하나라도 어긋나면 이탈 (복제 데이터로 플레이하고 있다고 간주함)
	FOR 루프용0, 1, 4,
		;PRINTV 루프용0
		;PRINTW 회째다냥
		IF 大場ななの記憶_L:1:(루프용0) != 大場ななの記憶:1:(루프용0)
			RETURN
		ENDIF
	NEXT

	;무대소녀의 상태가 로컬과 글로벌에서 하나라도 어긋나면 이탈
	;이라고 생각했지만, 이쪽은 판정이 대략적이라, 이탈하면 오히려 복잡해진다는 것을 깨닫고 주석 처리
	;무언가에 유용할지도 모르니 일단 놔둠
	;FOR 루프용0, 1, 9,
	;	IF 大場ななの記憶_L:2:(루프용0) != 大場ななの記憶:2:(루프용0)
	;		RETURN
	;	ENDIF
	;NEXT


	;이하 기록 작업

	;나나만큼은 꼼꼼하게 기록해간다구
	LOCAL:0 = GETCHARA([[キャラ:나나]])

	;붕괴되어 있고 붕괴 기록이 없다
	IF TALENT:LOCAL:붕괴 && 大場ななの記憶_L:1:0 != 3
		CALL EVENT_93_大場なな_後から崩壊した時の処理

	;연모이면서 신뢰계가 없고, 기록도 신뢰로 되어 있다
	ELSEIF (TALENT:LOCAL:연모 || TALENT:LOCAL:친애) && TALENT:LOCAL:신뢰 == 0 && TALENT:LOCAL:동료 == 0 && 大場ななの記憶_L:1:0 == 4
		CALL EVENT_93_大場なな_信頼から恋慕った時の処理
	;아직 판정이 들어가지 않았다
	;함락되어 있지 않으면 통과
	ELSEIF 大場ななの記憶:1:0 < 1
		;PRINTW 테스트 꼬추-! 꼬추-!
		;이미 기록한 세이브 데이터라면 이탈
		IF FINDELEMENT(大場なな_セーブデータID記憶領域, セーブデータID,0,99) > -1
			;PRINTW 테스트 멍멍
			RETURN
		ENDIF

		LOCAL:0 = GETCHARA([[キャラ:나나]])
		;신뢰
		IF TALENT:LOCAL:신뢰 || TALENT:LOCAL:동료
			大場ななの記憶_L:1:0 = 4
			大場ななの記憶:1:0 = 4
			;횟수 늘린다
			大場ななの記憶_L:1:4 ++
			大場ななの記憶:1:4 ++
			CALL EVENT_93_大場なな_セーブデータID記録
		;연모
		ELSEIF TALENT:LOCAL:연모 || TALENT:LOCAL:친애
			大場ななの記憶_L:1:0 = 1
			大場ななの記憶:1:0 = 1
			;횟수 늘린다
			大場ななの記憶_L:1:1 ++
			大場ななの記憶:1:1 ++
			CALL EVENT_93_大場なな_セーブデータID記録
		;음란
		ELSEIF TALENT:LOCAL:음란 || TALENT:LOCAL:창부
			大場ななの記憶_L:1:0 = 2
			大場ななの記憶:1:0 = 2
			;횟수 늘린다
			大場ななの記憶_L:1:2 ++
			大場ななの記憶:1:2 ++
			CALL EVENT_93_大場なな_セーブデータID記録
		;복종・붕괴는 같은 판정
		ELSEIF TALENT:LOCAL:복종 || TALENT:LOCAL:예속 || TALENT:LOCAL:붕괴
			大場ななの記憶_L:1:0 = 3
			大場ななの記憶:1:0 = 3
			;횟수 늘린다
			大場ななの記憶_L:1:3 ++
			大場ななの記憶:1:3 ++
			CALL EVENT_93_大場なな_セーブデータID記録
		ENDIF
	ENDIF

	SAVEGLOBAL
;나나가 2회차 이후, 인식 후 최애로 고르기 전이며, 나나의 기억에 붕괴가 기록되어 있지 않고, 나나 가입 후임에도 불구하고 나나가 없다 (팔았거나 지웠다)
ELSEIF 大場ななの記憶:0:0 > 0 &&  大場ななの記憶:0:1 < 3 && 大場ななの記憶:1:0 != 3 && GETBIT(イベントフラグ:93:7,1) && GETCHARA([[キャラ:나나]]) < 0
	LOADGLOBAL
	;나중에 붕괴했을 때와 같은 판정
	CALL EVENT_93_大場なな_後から崩壊した時の処理
	SAVEGLOBAL

ENDIF


@EVENT_93_大場なな_セーブデータID記録
	;세이브 데이터 ID에 기록한 것을 보존
	ARRAYSHIFT 大場なな_セーブデータID記憶領域,1,0
	大場なな_セーブデータID記憶領域:0 = セーブデータID

@EVENT_93_大場なな_信頼から恋慕った時の処理
	;연모로 고쳐 쓴다
	大場ななの記憶_L:1:0 = 1
	大場ななの記憶:1:0 = 1
	;신뢰 횟수 줄인다
	大場ななの記憶_L:1:4 -= 1
	大場ななの記憶:1:4 -= 1
	;연모 횟수 늘린다
	大場ななの記憶_L:1:1 += 1
	大場ななの記憶:1:1 += 1

@EVENT_93_大場なな_後から崩壊した時の処理
	;그때까지의 함락 내용은 지우지 않으므로 무언가의 카운트를 할 때는 주의 (비망록)

	;붕괴로 고쳐 쓴다
	大場ななの記憶_L:1:0 = 3
	大場ななの記憶:1:0 = 3
	;복종・붕괴 횟수 늘린다
	大場ななの記憶_L:1:3 += 1
	大場ななの記憶:1:3 += 1


@EVENT_93_大場なな_初日判定
#DIM IS_NEW_CHARA
#DIM DYNAMIC 루프용0
#DIM DYNAMIC 루프용1
#DIM DYNAMIC 랜덤쨩
LOADGLOBAL

;지금까지의 플레이에서 무대소녀 톱스타 이벤트를 경험했다면, 경험 수에 따라 별의 티아라의 재고를 늘린다
;（인계 등으로 가지고 있는 경우는 그만큼을 뺀다）
;누군가 가지고 있지 않은지 찾는다
LOCAL:1 = 0
FOR 루프용0, 0, CHARANUM
	;가지고 있다면 기록
	IF EQUIP:루프용0:악세서리 == GETNUM(ITEM, "별의티아라")
		;기록
		LOCAL:1 ++
	ENDIF
NEXT

LOCAL:2 = 0
;지금까지 경험한 톱스타 이벤트의 수를 카운트
FOR 루프용0, 1, 10
	IF 大場ななの記憶:3:루프용0 > 0
		LOCAL:2 ++
	ENDIF
NEXT

;현재 티아라 수 + 가지고 있는 티아라 수가, 지금까지 경험한 톱스타 이벤트 수보다 적다면,
;지금까지 경험한 톱스타 이벤트 수까지 티아라 수를 늘린다
IF (ITEM:별의티아라 + LOCAL:1) < LOCAL:2
	ITEM:별의티아라 = LOCAL:2
ENDIF

;나나가 이쪽을 인식하고 있는 경우, 첫날 첫수에 가입 이벤트
IF 大場ななの記憶:0:1 > 1
	;대바를 가입시킨다
	CALL ADD_NEW_COMPANION, [[キャラ:나나]],200
	LOCAL = RESULT:1
	;생성된 (인계하지 않은) 경우, 전투 참가 가능 처리
	IF RESULT == 1
		CALL SET_TALENT_PARTY_JOINABLE, LOCAL, "신용"
		IS_NEW_CHARA = 1
	ELSE
		IS_NEW_CHARA = 0
	ENDIF
	CUSTOMDRAWLINE =

	;이하의 처리는 인계했든 아니든 문답무용으로 들어간다
	;신뢰가 3회 이상이고, 음란보다 신뢰 횟수가 많으며, 복종・붕괴 9회 이하까지라면, 전자동으로 동료가 붙는다
	IF 大場ななの記憶:1:4 > 2 && (大場ななの記憶:1:4 > 大場ななの記憶:1:2) && 大場ななの記憶:1:3 < 10
		PRINTL 
		TALENT:LOCAL:동료 = 1

		;다른 함락 소질 소거
		;붕괴는 지우지 않는다
		TALENT:LOCAL:연모 = 0
		TALENT:LOCAL:친애 = 0

		TALENT:LOCAL:음란 = 0
		TALENT:LOCAL:창부 = 0

		TALENT:LOCAL:복종 = 0
		TALENT:LOCAL:예속 = 0

		TALENT:LOCAL:신뢰 = 0

		;맹우는 지우지 않는다
		;다른 결혼(가칭) 계열 소질은 지운다
		TALENT:LOCAL:음마 = 0
		TALENT:LOCAL:노리개 = 0
		TALENT:LOCAL:남편 = 0
		TALENT:LOCAL:아내 = 0

	;연모가 3회 이상이고, 음란보다 연모 횟수가 많으며, 복종・붕괴 9회 이하까지라면, 전자동으로 친애가 붙는다
	ELSEIF 大場ななの記憶:1:1 > 2 && (大場ななの記憶:1:1 > 大場ななの記憶:1:2) && 大場ななの記憶:1:3 < 10
		TALENT:LOCAL:친애 = 1

		;다른 함락 소질 소거
		;붕괴는 지우지 않는다
		TALENT:LOCAL:연모 = 0

		TALENT:LOCAL:음란 = 0
		TALENT:LOCAL:창부 = 0

		TALENT:LOCAL:복종 = 0
		TALENT:LOCAL:예속 = 0

		TALENT:LOCAL:신뢰 = 0
		TALENT:LOCAL:동료 = 0

		;아내・남편은 지우지 않는다
		;다른 결혼(가칭) 계열 소질은 지운다
		TALENT:LOCAL:음마 = 0
		TALENT:LOCAL:노리개 = 0
		TALENT:LOCAL:맹우 = 0

		;저항・일선을넘지않음을 잃는다
		TALENT:LOCAL:저항 = 0
		TALENT:LOCAL:일선을넘지않음 = 0

	;음란이 3회 이상이고, 연모보다 음란 횟수가 많으며, 복종・붕괴 9회 이하까지라면, 전자동으로 창부가 붙는다
	ELSEIF 大場ななの記憶:1:2 > 2 && (大場ななの記憶:1:2 > 大場ななの記憶:1:1) && 大場ななの記憶:1:3 < 10
		TALENT:LOCAL:창부 = 1

		;다른 함락 소질 소거
		;붕괴는 지우지 않는다
		TALENT:LOCAL:연모 = 0
		TALENT:LOCAL:친애 = 0

		TALENT:LOCAL:음란 = 0

		TALENT:LOCAL:복종 = 0
		TALENT:LOCAL:예속 = 0

		TALENT:LOCAL:신뢰 = 0
		TALENT:LOCAL:동료 = 0

		;다른 결혼(가칭) 계열 소질은 지운다
		TALENT:LOCAL:아내 = 0
		TALENT:LOCAL:남편 = 0
		TALENT:LOCAL:맹우 = 0
		TALENT:LOCAL:노리개 = 0

		;저항・일선을넘지않음을 잃는다
		TALENT:LOCAL:저항 = 0
		TALENT:LOCAL:일선을넘지않음 = 0

	;복종 or 붕괴, 및 매각이 10회 이상 있다면 이제 두 번 다시 제정신으로 돌아오지 않는다
	ELSEIF 大場ななの記憶:1:3 > 9
		TALENT:LOCAL:예속 = 1

		;다른 함락 소질 소거
		;붕괴는 지우지 않는다
		TALENT:LOCAL:연모 = 0
		TALENT:LOCAL:친애 = 0

		TALENT:LOCAL:음란 = 0
		TALENT:LOCAL:창부 = 0

		TALENT:LOCAL:예속 = 0

		TALENT:LOCAL:신뢰 = 0
		TALENT:LOCAL:동료 = 0

		;다른 결혼(가칭) 계열 소질은 지운다
		TALENT:LOCAL:아내 = 0
		TALENT:LOCAL:남편 = 0
		TALENT:LOCAL:맹우 = 0
		TALENT:LOCAL:음마 = 0

		;저항・일선을넘지않음을 잃고, 고무를 얻는다
		TALENT:LOCAL:저항 = 0
		TALENT:LOCAL:일선을넘지않음 = 0
		TALENT:LOCAL:고무 = 1

		;무대소녀가 아니게 된다 (비전투원화하지 않음)
		CSTR:LOCAL:종족명 = 인간
	ENDIF

	;셀프 스타라이트 완료 및 예속이 아님
	IF 大場ななの記憶:0:4 > 0 && TALENT:LOCAL:예속 < 1
		;얼라인먼트를 L로
		CFLAG:LOCAL:선악치 = 256
	ENDIF

	;20231002 인계 캐릭터인 경우, 디폴트 상태로 되돌려지면 곤란한 변화가 붙어있을 가능성이 있으므로 인계 캐릭터는 처리에서 배제하도록
	;나나 톱스타 이벤트 후에는 톱스타 상태로 가입
	;단 복종・예속・붕괴인 경우는 톱스타 상태가 되지 않음
	;IF IS_NEW_CHARA && 大場ななの記憶:0:1 > 4 && (TALENT:LOCAL:복종 < 1 && TALENT:LOCAL:예속 < 1 && TALENT:LOCAL:붕괴 < 1)
	IF IS_NEW_CHARA && 大場ななの記憶:0:1 > 4
		;일시 기록 변수를 리셋
		LOCAL:1 = 0
		CALLFORM SET_BASE_5317, LOCAL, 2
		CALLFORM SET_BTL_TALENT_5317, LOCAL, 2
		CALLFORM SET_LEARN_SKILL_5317, LOCAL, 2
	ENDIF

	;↓비망록　캐릭터 개별의 인계 횟수는 이것으로 판정하는 거라구
	;CFLAG:LOCAL:인계횟수

	;호무라에게서 넘겨받은 직후
	IF イベントフラグ:99:5 == 3
		;이미 무대소녀가 아니게 됨
		IF TALENT:LOCAL:예속 == 1
		PRINTFORMW 「――아, %CSTR:LOCAL:이인칭%
