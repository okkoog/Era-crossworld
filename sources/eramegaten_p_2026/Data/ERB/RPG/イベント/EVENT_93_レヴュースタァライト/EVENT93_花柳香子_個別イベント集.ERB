@SET_ACTION_双葉アンリサンソン, ARG
#DIM 가드죽이는맨
#DIM 루프용
;죽이는맨 제로 클리어
가드죽이는맨 = 0


;이벤트플래그:93:13, 5……최종단계
IF GETBIT(イベントフラグ:93:16, 5)
	IF CFLAG:ARG:행동한횟수 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
	;2패턴
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		IF RAND:2 == 0
			;충격 확산
			CALL SET_ACTION_SKILL, ARG, [[스킬:전용기1]]
		ELSE
			;충격 단체
			CALL SET_ACTION_SKILL, ARG, [[스킬:전용기2]]
		ENDIF
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:포효]]
	ENDIF

;이벤트플래그:93:13, 4……3단계 4회 행동
ELSEIF GETBIT(イベントフラグ:93:16, 4)
	IF CFLAG:ARG:행동한횟수 == 0
		FOR 루프용, 1, 7
			;가드하고 있는 누군가를 찾아 가드죽이는맨에 보존
			IF POS(루프용) >= 0 && GET_STATE(CFLAG:POS(루프용):상태이상) != "DYING" && CFLAG:POS(루프용):방어플래그
				가드죽이는맨 = 루프용
				BREAK
			ENDIF
		NEXT
		;아무도 가드하고 있지 않다면 만마의 일격
		IF 가드죽이는맨 == 0
			;단체 만능
			CALL SET_ACTION_SKILL, ARG, [[스킬:만마의일격]]
		;가드하고 있다면 기합 플래그 달고 만마의 일격
		ELSE
			;PRINTVL 가드죽이는맨
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃발을 멈췄구나아앗!! 　　　　　　　　　　　　┃
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTFORMW ＞산손은 기합을 넣었다
			CFLAG:ARG:気合フラグ = 1
			CFLAG:ARG:타겟 = 가드죽이는맨
			CFLAG:ARG:입력행동 = [[스킬:만마의일격]]
		ENDIF

	ELSEIF CFLAG:ARG:행동한횟수 == 1
		;2패턴
		IF RAND:2 == 0
			;검격＋주살 즉사
			CALL SET_ACTION_SKILL, ARG, [[스킬:길로틴블레이드]]
		ELSE
			;신경＋신경 마비
			CALL SET_ACTION_SKILL, ARG, [[스킬:아카샤아츠]]
		ENDIF
	ELSEIF CFLAG:ARG:행동한횟수 == 2
		;2패턴
		IF RAND:2 == 0
			;만능 전체
			CALL SET_ACTION_SKILL, ARG, [[스킬:엄정한심판]]
		ELSE
			;만능 전체
			CALL SET_ACTION_SKILL, ARG, [[스킬:엄정한심판]]
		ENDIF
	ELSE
		;2턴에 1번 만능 연사
		IF CFLAG:ARG:행동한횟수 == 3 && FLAG:경과턴수 % 2 == 0
			;만능 전체
			CALL SET_ACTION_SKILL, ARG, [[스킬:엄정한심판]]
		;그 외에는 2패턴
		ELSEIF RAND:2 == 0
			;정신
			CALL SET_ACTION_SKILL, ARG, [[스킬:메가스트라이크]]
		ELSE
			;타격
			CALL SET_ACTION_SKILL, ARG, [[스킬:브레인쉐이크]]
		ENDIF

	ENDIF

;이벤트플래그:93:13, 3……2단계 3회 행동
ELSEIF GETBIT(イベントフラグ:93:16, 3)
	IF CFLAG:ARG:행동한횟수 == 0
		;3패턴
		IF RAND:3 == 0
			;기합
			CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
		ELSEIF RAND:2 == 0
			;강화 2단
			CALL SET_ACTION_SKILL, ARG, [[스킬:돌격의봉화]]
		ELSE
			;약화 1단
			CALL SET_ACTION_SKILL, ARG, [[스킬:랜더마이저]]
		ENDIF
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		;2패턴
		IF RAND:2 == 0
			;정신
			CALL SET_ACTION_SKILL, ARG, [[스킬:메가스트라이크]]
		ELSE
			;만능 전체
			CALL SET_ACTION_SKILL, ARG, [[스킬:엄정한심판]]
		ENDIF
	ELSE
		;2패턴
		IF RAND:2 == 0
			;검격 HP 1
			CALL SET_ACTION_SKILL, ARG, [[스킬:길로틴페이크]]
		ELSE
			;검격＋주살 즉사
			CALL SET_ACTION_SKILL, ARG, [[스킬:길로틴블레이드]]
		ENDIF

	ENDIF


;그 외 (제1단계)
ELSE
	IF CFLAG:ARG:행동한횟수 == 0
		;2패턴
		IF RAND:2 == 0
			;검격
			CALL SET_ACTION_SKILL, ARG, [[스킬:데스바운드]]
		ELSE
			;버프
			CALL SET_ACTION_SKILL, ARG, [[스킬:히트라이저]]
		ENDIF
	;2패턴
	ELSEIF CFLAG:ARG:행동한횟수 == 1 && RAND:2 == 0
			;정신
			CALL SET_ACTION_SKILL, ARG, [[스킬:메가스트라이크]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
			;타격＋PANIC
			CALL SET_ACTION_SKILL, ARG, [[스킬:브레인쉐이크]]
	ELSE
