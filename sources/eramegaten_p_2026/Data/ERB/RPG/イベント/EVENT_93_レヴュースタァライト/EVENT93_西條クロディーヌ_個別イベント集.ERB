@SET_ACTION_this_is_ヘラクレス, ARG
#DIM ガード殺すマン
#DIM ループ用
;殺すマンゼロクリア
ガード殺すマン = 0

;イベントフラグ:93:13, 5……最終段階
IF GETBIT(イベントフラグ:93:19, 5)
	IF CFLAG:ARG:행동한횟수 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
	;２パターン
	ELSEIF CFLAG:ARG:행동한횟수 == 1 && RAND:2 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:브레이브재퍼]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		CALL SET_ACTION_SKILL, ARG, [[스킬:브레이브재퍼]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:브레이브재퍼]]
	ENDIF

;イベントフラグ:93:13, 4……三段階目
ELSEIF GETBIT(イベントフラグ:93:19, 4)
	IF CFLAG:ARG:행동한횟수 == 0
		FOR ループ用, 1, 7
			;ガードしている誰かを探してガード殺すマンを保存
			IF POS(ループ用) >= 0 && GET_STATE(CFLAG:POS(ループ用):상태이상) != "DYING" && CFLAG:POS(ループ用):방어플래그
				ガード殺すマン = ループ用
				BREAK
			ENDIF
		NEXT
		;誰もガードしていないのなら突撃の狼煙
		IF ガード殺すマン == 0
			;지원
			CALL SET_ACTION_SKILL, ARG, [[스킬:돌격의봉화]]
		;ガードしてたらそいつを殺す
		ELSE
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃가드했겠다? 죽어라아앗!!　　　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
			CFLAG:ARG:타겟 = ガード殺すマン
			;만능
			CFLAG:ARG:입력행동 = [[스킬:만마의일격]]
		ENDIF
		
	;3パターン
	ELSEIF CFLAG:ARG:행동한횟수 == 1 && RAND:3 == 0
			;飛具即死
			CALL SET_ACTION_SKILL, ARG, [[스킬:바이스샷]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1 && RAND:2 == 0
			;戦技即死
			CALL SET_ACTION_SKILL, ARG, [[스킬:꼬치꿰기]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
			;검격＋SHOCK
			CALL SET_ACTION_SKILL, ARG, [[스킬:번개찌르기]]
		
	ELSE
		IF CFLAG:ARG:행동한횟수 == 2 && RAND:2 == 0
			;지변
			CALL SET_ACTION_SKILL, ARG, [[스킬:기간트마키아]]
		ELSE
			;지변
			CALL SET_ACTION_SKILL, ARG, [[스킬:기간트마키아]]
		ENDIF
		
	ENDIF

;イベントフラグ:93:13, 3……二段階目
ELSEIF GETBIT(イベントフラグ:93:19, 3)
	IF CFLAG:ARG:행동한횟수 == 0
			IF RAND:2 == 0
				;타격+SHOCK
				CALL SET_ACTION_SKILL, ARG, [[스킬:뇌정축]]
			ELSE
				;지원
				CALL SET_ACTION_SKILL, ARG, [[스킬:데・쿤다]]
			ENDIF
	;２パターン
	ELSEIF CFLAG:ARG:행동한횟수 == 1 && RAND:3 == 0
			;破魔即死
			CALL SET_ACTION_SKILL, ARG, [[스킬:파마의뇌광]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1 && RAND:2 == 0
			;비구＋デバフ
			CALL SET_ACTION_SKILL, ARG, [[스킬:플레어샷]]
