;イベントフラグ:99:0 リスト
;0:開始前				1:インキュベーター受け取ってない		2:インキュベーター受け取り		3:魔法少女脱走解決
;4:ラスボス対決準備		5:ラスボスと対決直前		6:ラスボス撃破		7:キュウべえの誘いを蹴った（イベント終了）

;イベントフラグ:99:1 リスト
;0:ほむらルート		1:キュウべえルート

;イベントフラグ:99:2 リスト
;0:オクタヴィア撃破		1:さやか救済

;イベントフラグ:99:3 リスト
;0:エンディング無し　1:キュウべえＥＮＤ
;条件
;====================
@GET_EVENT_NAME_99
#FUNCTIONS
RESULTS_F '= "마도카마기카"
RETURNF RESULTS_F

@PLAYABLE_EVENT_99
;メガテン系イベント以外不許可の場合
SIF !GETS_USEABLE_EXTRA_TITLE("まどかマギカ")
	RETURN 0 
SIF GET_PAYMENT_RANK() < 1
	RETURN 0
IF (イベントフラグ:99:0 == 0 || イベントフラグ:99:0 == 1 )
	IF イベントフラグ:99:0 == 0 
		RESULTS = （EX:마도카☆마기카）정체불명의 하얀 악마
		RETURN 1
	ELSE
		RESULTS = （EX:마도카☆마기카）큐베의 선물
		RETURN 1
	ENDIF
ENDIF

IF BASE:MASTER:LV > 24 && イベントフラグ:99:0 == 2
	RESULTS = （EX:마도카☆마기카）마법 소녀 탈주
	RETURN 1
ENDIF

IF イベントフラグ:99:0 == 3
	RESULTS = （EX:마도카☆마기카）큐베의 권유
	RETURN 1
ENDIF

IF BASE:MASTER:LV > 59 && イベントフラグ:99:0 == 4
	RESULTS = （EX:마도카☆마기카）결전 전야
	RETURN 1
ENDIF

IF イベントフラグ:99:0 == 5
	IF イベントフラグ:99:1 == 0 
		RESULTS = （EX:마도카☆마기카）발프르기스・나이트
		RETURN 1
	ELSE
		RESULTS = （EX:마도카☆마기카）비틀려 굽혀진 『소원』
		RETURN 1
	ENDIF
ENDIF

IF イベントフラグ:99:0 == 6 && イベントフラグ:99:1 == 0 && BASE:MASTER:LV > 69
	RESULTS = （마도카☆마기카ＭＯＤ2）반역의 이야기
	RETURN 1
ENDIF	

RETURN 0

