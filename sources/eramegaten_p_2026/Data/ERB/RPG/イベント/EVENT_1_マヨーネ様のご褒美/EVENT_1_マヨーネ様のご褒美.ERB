;イベントフラグ:1:0 = マヨ様の状態( 3仲魔に )
;イベントフラグ:1:1 = 組織から警告を受けたか( -1未受領 0イベント未発生 1受けた(イベント前) 2受けた(イベント後) )
;イベントフラグ:1:2 = 保留して崩壊させるか、達人にするか(1 = 붕괴　2 = 달인)
;イベントフラグ:1:3 = 受け取りの保留日
;====================
;条件
;====================
@GET_EVENT_NAME_1
#FUNCTIONS
RESULTS_F '= "마요네님의포상"
RETURNF RESULTS_F

@PLAYABLE_EVENT_1
;ノルマ3回達成後
;IF FLAG:조직공헌도 >= 350000 && (イベントフラグ:1:0 < 2 || (イベントフラグ:1:0 == 2 && BASE:MASTER:LV > 30))
;	SIF イベントフラグ:1:1 == 0
;		イベントフラグ:1:1 = -1
;	RESULTS = 마요네님의포상
;	RETURN 1
;エンドレス突入前で50日経過
;ELSEIF DAY > 50 && GROUPMATCH(イベントフラグ:1:1,0,1) && FLAG:게임모드 < 9
;	イベントフラグ:1:1 = 1
;	RESULTS = マヨーネ様の警告
;	RETURN 1
;ENDIF
;RETURN 0
;---- EDIT 006 ADD START -------------------------
;保留している場合は日数の条件を満たすことでイベントを再出現させる
IF イベントフラグ:1:2
	IF DAY >= イベントフラグ:1:3 + 5
		RESULTS = 마요네님의포상
		RETURN 1
	ENDIF
	RETURN 0
ENDIF
;---- EDIT 006 ADD END -------------------------
;2022/04/01　修正。５０日以降経過時に貢献度35万いくと、イベント名が「ご褒美」なのに内容が「警告」になるので、順番変更
;エンドレス突入前で50日経過
IF DAY > 50 && GROUPMATCH(イベントフラグ:1:1,0,1) && FLAG:게임모드 < 9
	イベントフラグ:1:1 = 1
	RESULTS = 마요네 님의 경고
	RETURN 1
ELSEIF FLAG:조직공헌도 >= 350000 && (イベントフラグ:1:0 < 2 || (イベントフラグ:1:0 == 2 && BASE:MASTER:LV > 30))
	SIF イベントフラグ:1:1 == 0
		イベントフラグ:1:1 = -1
	RESULTS = 마요네 님의 포상
	RETURN 1
ENDIF
RETURN 0




