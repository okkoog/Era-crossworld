@SET_BOSS_ENEMY_EVENT_203, L_ENEMY_NAME, L_NO = -1, L_OPT
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_NO
#DIM DYNAMIC L_ENEMY
#DIMS DYNAMIC L_ENEMY_NAME
#DIMS DYNAMIC L_OPT
#DIMS DYNAMIC L_ENEMY_TABLE, 50

L_ENEMY_TABLE:0 '= "エリーゼ"
IF L_NO >= 0
	SIF !INRANGE(L_NO, 0, VARSIZE("L_ENEMY_TABLE") - 1)
		RETURN 0
	L_ENEMY_NAME '= L_ENEMY_TABLE:L_NO
ENDIF
IF L_OPT == "名称取得"
	SIF L_ENEMY_TABLE:L_NO == ""
		RETURN 0
	RESULTS '= L_ENEMY_NAME
	RETURN 1
ENDIF

SELECTCASE L_ENEMY_NAME
	CASE "エリーゼ"
		TSTR:전투이벤트패턴 '= "アンリミテッドエンヴィー"
		CALL SET_ENEMY, 11, [[キャラ:엘리제3_GV]], 42, 1, 1
		L_ENEMY = CHARANUM - 1
		NAME:L_ENEMY '= "엘리제3"
		CALLNAME:L_ENEMY '= "엘리제3"
		CALL SET_ENEMY_TIMEID, L_ENEMY, "エリーゼ3"

		CFLAG:L_ENEMY:ＨＰ보정 += 1000
		CFLAG:L_ENEMY:ＭＰ보정 += 50000
		CSTR:L_ENEMY:사고패턴 = アンリミテッドエンヴィー3

		;CHARANUM-2:エリーゼ2
		CALL SET_ENEMY, 9, [[キャラ:엘리제2_GV]], 44, 1, 1
		L_ENEMY = CHARANUM - 1
		NAME:L_ENEMY '= "엘리제2"
		CALLNAME:L_ENEMY '= "엘리제2"
		CALL SET_ENEMY_TIMEID, L_ENEMY, "エリーゼ2"

		CFLAG:L_ENEMY:ＨＰ보정 += 1000
		CFLAG:L_ENEMY:ＭＰ보정 += 50000
		CSTR:L_ENEMY:사고패턴 = アンリミテッドエンヴィー2
		CFLAG:L_ENEMY:물리피데미지보정 = -10
		CFLAG:L_ENEMY:마법피데미지보정 = -10

		;CHARANUM-1:エリーゼ1
		CALL SET_ENEMY, 7, [[キャラ:엘리제1_GV]], 42, 1, 1
		L_ENEMY = CHARANUM - 1
		NAME:L_ENEMY '= "엘리제1"
		CALLNAME:L_ENEMY '= "엘리제1"
		CALL SET_ENEMY_TIMEID, L_ENEMY, "エリーゼ1"

		CFLAG:L_ENEMY:ＨＰ보정 += 1000
		CFLAG:L_ENEMY:ＭＰ보정 += 50000
		CSTR:L_ENEMY:사고패턴 = アンリミテッドエンヴィー1
ENDSELECT
;ステータス同期と回復
CALL SET_UP_ENEMY
