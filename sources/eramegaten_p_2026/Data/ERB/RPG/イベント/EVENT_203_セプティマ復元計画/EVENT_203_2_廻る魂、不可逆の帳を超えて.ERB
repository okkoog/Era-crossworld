@SET_ACTION_アンリミテッドエンヴィー3, ARG
#DIM 死者スイッチ
#DIM リザレクションカウント
#DIM 脅しOK

脅しOK = 0
FOR LOCAL, 1, 7
	SIF POS(LOCAL) < 0
		CONTINUE
	SIF CFLAG:POS(LOCAL):마법효과강화 != -32
		脅しOK = 1
NEXT
IF RAND:7 == 0 && 脅しOK
	CALL SET_ACTION_SKILL, ARG, [[스킬:악마의위협]]
ELSEIF RAND:6 == 0 && 現HP割合(ARG) < 34
	CALL SET_ACTION_SKILL, ARG, [[스킬:이블아이]]
ELSEIF RAND:5 == 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:페트라아이]]
ELSEIF RAND:4 == 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:암흑의난무]]
ELSEIF RAND:3 == 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:멸살수전]]
ELSEIF RAND:2 == 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:에이가온]]
ELSE
	CALL SET_ACTION_SKILL, ARG, [[스킬:데스샤워]]
ENDIF

