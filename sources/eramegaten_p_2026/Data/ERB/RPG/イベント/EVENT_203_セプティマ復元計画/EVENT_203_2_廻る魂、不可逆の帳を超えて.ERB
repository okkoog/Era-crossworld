@SET_ACTION_アンリミテッドエンヴィー1, ARG
#DIM 死者スイッチ
#DIM リザレクションカウント
#DIM 歯ぎしりOK

歯ぎしりOK = 0
FOR LOCAL, 1, 7
	SIF POS(LOCAL) < 0
		CONTINUE
	SIF CFLAG:POS(LOCAL):마법위력강화 != -32
		歯ぎしりOK = 1
NEXT
IF RAND:5 == 0 && 歯ぎしりOK
	CALL SET_ACTION_SKILL, ARG, [[스킬:악마의이갈이]]
ELSEIF RAND:4 == 0 && 現HP割合(ARG) < 34
	CALL SET_ACTION_SKILL, ARG, [[스킬:백마비침]]
ELSEIF RAND:3 == 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:페트라아이]]
ELSEIF RAND:2 == 0
	CALL SET_ACTION_SKILL, ARG, [[스킬:에이가온]]
ELSE
	CALL SET_ACTION_SKILL, ARG, [[스킬:데스샤워]]
ENDIF

