;+1000 友好フラグからの敵対
;イベントフラグ:98:3  MASTERの聖杯への願い
; 0　自分で何とかする　1　ファントム・ソサエティからの解放と自由 2　世界の変更　3何もなし
;====================
;条件
;====================
@GET_EVENT_NAME_98
#FUNCTIONS
RESULTS_F '= "페이트"
RETURNF RESULTS_F

@PLAYABLE_EVENT_98
SIF !GETS_USEABLE_EXTRA_TITLE("FATE")
	RETURN 0
SIF BASE:MASTER:LV < 11
	RETURN 0
SIF GET_PAYMENT_RANK() < 1
	RETURN 0
IF イベントフラグ:98:0 == 0
	RESULTS = （EX:Fate ＭＯＤ-1）게임 소프트 「HolyChalice」
	RETURN 1
ELSEIF イベントフラグ:98:0 == 2
	CALL CHECK_Fate
	IF RESULT == 1
		RESULTS = （EX:Fate ＭＯＤ-2）성배전쟁
		RETURN 1
	ENDIF
ELSEIF イベントフラグ:98:0 == 3
	CALL CHECK_Fate
	IF RESULT == 1
		RESULTS = （EX:Fate ＭＯＤ-3）개전
		RETURN 1
	ENDIF
ELSEIF イベントフラグ:98:0 == 4
	CALL CHECK_Fate
	IF RESULT == 1
		RESULTS = （EX:Fate ＭＯＤ-4）만행
		RETURN 1
	ENDIF
ELSEIF イベントフラグ:98:0 == 5
	CALL CHECK_Fate
	IF RESULT == 1
		IF (イベントフラグ:98:2 % 10 == 0 && イベントフラグ:98:2 / 10 == 2) || (イベントフラグ:98:2 % 10 == 0 && イベントフラグ:98:2 / 10 == 3)
			RESULTS = （EX:Fate ＭＯＤ-5）음모
		ELSE
			RESULTS = （EX:Fate ＭＯＤ-5）사냥
		ENDIF
		RETURN 1
	ENDIF
ELSEIF イベントフラグ:98:0 == 6
	CALL CHECK_Fate
	IF RESULT == 1
		RESULTS = （EX:Fate ＭＯＤ-6）교회
		RETURN 1
	ENDIF
	RETURN 1
ELSEIF イベントフラグ:98:0 == 7
	CALL CHECK_Fate
	IF RESULT == 1
		RESULTS = （EX:Fate ＭＯＤ-7）蟲蔵
		RETURN 1
	ENDIF
	RETURN 1
ELSEIF イベントフラグ:98:0 == 8
	CALL CHECK_Fate
	IF RESULT == 1
		RESULTS = （EX:Fate ＭＯＤ-8）狂戦士
		RETURN 1
	ENDIF
	RETURN 1
ELSEIF イベントフラグ:98:0 == 9
	CALL CHECK_Fate
	IF RESULT == 1
		RESULTS = （EX:Fate ＭＯＤ-9）大聖杯
		RETURN 1
	ENDIF
	RETURN 1
ENDIF

RETURN 0

