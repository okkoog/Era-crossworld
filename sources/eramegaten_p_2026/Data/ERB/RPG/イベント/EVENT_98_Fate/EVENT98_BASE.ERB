;=======================================================================
;FireWall思考パターン
;=======================================================================
@SET_ACTION_FW,ARG
#DIM CHARA
#DIM 강화랭크
IF NO:ARG == [[キャラ:천둥의체크맨]]
	;黄色いファイアウォール　마카・카쟈
	IF CFLAG:ARG:마법위력강화 < 16
		CFLAG:ARG:입력행동 = [[스킬:마카・카쟈]]
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:심판의천둥]]
		;CFLAG:ARG:입력행동 = [[스킬:裁きの雷]]
	ENDIF
ELSEIF NO:ARG == [[キャラ:불의체크맨]]
	;赤いファイアウォール　タルカジャ
	IF CFLAG:ARG:공격강화 < 16
		CFLAG:ARG:입력행동 = [[스킬:타루・카쟈]]
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:프로미넌스]]
	ENDIF
ELSEIF NO:ARG == [[キャラ:바람의체크맨]]
	;緑のファイアウォール　ラクカジャ
	IF CFLAG:ARG:방어강화 < 16
		CFLAG:ARG:입력행동 = [[스킬:라쿠・카쟈]]
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:용권지옥]]
	ENDIF
ELSEIF NO:ARG == [[キャラ:빛의체크맨]]
	;白のファイアウォール　デクンダ
	IF CFLAG:ARG:공격강화 < -16 || CFLAG:ARG:명중강화 < -16 || CFLAG:ARG:회피강화 < -16 || CFLAG:ARG:마법위력강화 < -16
		CFLAG:ARG:입력행동 = [[스킬:데・쿤다]]
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
	ENDIF
ELSEIF NO:ARG == [[キャラ:어둠의체크맨]]
	;黒のファイアウォール デカジャ
	LOCAL:1 = 0
	FOR LOCAL,1,7
		CHARA = POS(LOCAL)
		SIF CHARA < 0
			CONTINUE
		강화랭크 = ( CFLAG:CHARA:공격강화 + CFLAG:CHARA:방어강화 + CFLAG:CHARA:명중강화 + CFLAG:CHARA:회피강화 + CFLAG:CHARA:마법위력강화 + CFLAG:CHARA:마법효과강화 ) / 6
		;強化ランク平均が16以上
		IF 강화랭크 > 15
			LOCAL:1 = 1
		ENDIF
	NEXT
	IF LOCAL:1 == 1
		CFLAG:ARG:입력행동 = [[스킬:데・카쟈]]
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:마하・그라바리온]]
	ENDIF
ELSEIF NO:ARG == [[キャラ:얼음의체크맨]]
	;青のファイアウォール 스쿠・카쟈
	IF CFLAG:ARG:명중강화 < 16
		CFLAG:ARG:입력행동 = [[스킬:스쿠・카쟈]]
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:절대영도]]
	ENDIF
ELSE
	;一応通常攻撃入れとこう
	CFLAG:ARG:입력행동 = 0
ENDIF

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ランダムターゲットをよんで決定
CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1

