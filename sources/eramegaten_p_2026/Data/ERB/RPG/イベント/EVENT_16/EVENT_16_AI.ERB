; EVENT_16_AI.ERB
; 全能のバランサーとマーガレットの戦闘AIを記述しています

; 全能のバランサーの思考パターン
; コンセントレイトと6種の単体属性魔法、メギドラオンを繰り返す。1moreはコンセントレイト固定
; 魔力が高いためHP3桁程度では弱点でなくても即死するくらいには痛い。運が低いのでよく外れるが……
; 基本的に単体魔法で弱点狙い。魔法反射がかかっている場合、33%でメギドラオン、HPが30%を切ると確実にメギドラオン
; HPが30%を切ると魔法反射がかかっていなくてもメギドラオンが混ざる
; クリティカルの出方次第で1ターンでも倒せるが下手に削って生き残ってしまうとコンセメギドがとんでくる
; ところでバランサーの攻撃時のぶるるるるって声なんか異様にかわいくないですかね？
@SET_ACTION_全能バランサ, ARG
; 初期化
VARSET LOCAL, 0
; 1moreかコンセントレイト未実行ならコンセントレイト
IF CFLAG:ARG:１more플래그 > 0 || CFLAG:ARG:집중플래그 == 0
	CALL EVENT_16_SET_ACTION, ARG, [[스킬:컨센트레이트]]
	RETURN 0
; それ以外
ELSE
	; HPが5割を切ってるなら1/4でメギドラオンセット
	IF 現HP割合(ARG) < 50 && RAND:4 == 0
		CALL EVENT_16_SET_ACTION, ARG, [[스킬:메기도라온]]
		RETURN 0
	ENDIF
	; キャラ走査
	FOR LOCAL:3, 1, 7
		LOCAL = POS(LOCAL:3)
		; 空ポジションかDYINGなら次
		SIF LOCAL < 0 || GET_STATE(CFLAG:LOCAL:상태이상) == "DYING"
			CONTINUE
		; 魔法反射状態なら一定確率でメギドラオンセットしてキャラ走査終了
		; 気づいてしまったけど反射の持続1ターンだしもしかしてこれ意味がな……
		IF CFLAG:LOCAL:마법반사플래그 > 0 && (現HP割合(ARG) < 40 || (現HP割合(ARG) < 80 && RAND:3 == 0))
			CALL EVENT_16_SET_ACTION, ARG, [[스킬:메기도라온]]
			BREAK
		ENDIF
		; 既に行動が入力されている場合は1/3でキャラ走査終了
		SIF CFLAG:ARG:입력행동 >= 0 && RAND:3 == 0
			BREAK
		; 耐性走査
		FOR LOCAL:4, 40, 59
			SELECTCASE LOCAL:4
				; 화염
				CASE 44
					; 弱点でなければ次
					SIF CHECK_WEAKNESS(MAXBASE:LOCAL:(LOCAL:4)) < 0
						CONTINUE
					; 既に行動が入力されている場合は1/3で耐性走査終了
					SIF CFLAG:ARG:입력행동 > 0 && RAND:3 == 0
						BREAK
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:아기다인]], LOCAL:3
				; 빙결
				CASE 45
					; 弱点でなければ次
					SIF CHECK_WEAKNESS(MAXBASE:LOCAL:(LOCAL:4)) < 0
						CONTINUE
					; 既に行動が入力されている場合は1/3で耐性走査終了
					SIF CFLAG:ARG:입력행동 > 0 && RAND:3 == 0
						BREAK
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:부흐다인]], LOCAL:3
				; 전격
				CASE 46
					; 弱点でなければ次
					SIF CHECK_WEAKNESS(MAXBASE:LOCAL:(LOCAL:4)) < 0
						CONTINUE
					; 既に行動が入力されている場合は1/3で耐性走査終了
					SIF CFLAG:ARG:입력행동 > 0 && RAND:3 == 0
						BREAK
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:지오다인]], LOCAL:3
				; 지변
				CASE 52
					; 弱点でなければ次
					SIF CHECK_WEAKNESS(MAXBASE:LOCAL:(LOCAL:4)) < 0
						CONTINUE
					; 既に行動が入力されている場合は1/3で耐性走査終了
					SIF CFLAG:ARG:입력행동 > 0 && RAND:3 == 0
						BREAK
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:마그다인]], LOCAL:3
				; 수격
				CASE 53
					; 弱点でなければ次
					SIF CHECK_WEAKNESS(MAXBASE:LOCAL:(LOCAL:4)) < 0
						CONTINUE
					; 既に行動が入力されている場合は1/3で耐性走査終了
					SIF CFLAG:ARG:입력행동 > 0 && RAND:3 == 0
						BREAK
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:아쿠아다인]], LOCAL:3
				; 질풍
				CASE 54
					; 弱点でなければ次
					SIF CHECK_WEAKNESS(MAXBASE:LOCAL:(LOCAL:4)) < 0
						CONTINUE
					; 既に行動が入力されている場合は1/3で耐性走査終了
					SIF CFLAG:ARG:입력행동 > 0 && RAND:3 == 0
						BREAK
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:갈다인]], LOCAL:3
			ENDSELECT
		NEXT
	NEXT
	; ここまで来て属性魔法がセットされていない場合はランダム対象で属性魔法を使う
	SIF CFLAG:ARG:입력행동 > 0
		RETURN 0
	SELECTCASE RAND:6
		CASE 0
			CALL EVENT_16_SET_ACTION, ARG, [[스킬:아기다인]]
		CASE 1
			CALL EVENT_16_SET_ACTION, ARG, [[스킬:부흐다인]]
		CASE 2
			CALL EVENT_16_SET_ACTION, ARG, [[스킬:지오다인]]
		CASE 3
			CALL EVENT_16_SET_ACTION, ARG, [[스킬:마그다인]]
		CASE 4
			CALL EVENT_16_SET_ACTION, ARG, [[스킬:아쿠아다인]]
		CASE 5
			CALL EVENT_16_SET_ACTION, ARG, [[스킬:갈다인]]
	ENDSELECT
ENDIF

; マーガレットの思考パターン
; 
; ・全段階で常時2回行動
; ・全段階で1moreを含む行動50回毎に9999固定メギドラオン
; ・全段階で一定条件においてメギドラオンモード(行動が全て9999固定ダメージメギドラオン化)
;     不屈の闘志が発動した場合、メギドラオンモードon
;     パーティーにレベルに対して能力が高すぎる(18+Lv*1.5+5の2倍以上)キャラが存在する場合、メギドラオンモードon
;     パーティーに主人以外のマハアナライズを持っているキャラが存在する場合、メギドラオンモードon
; 
; ・第一段階 HP90%まで
;   アタック*2
; ・第二段階 HP50%まで
;   화염->빙결->전격->질풍->コンセ->メギドラオンのローテーションで攻撃
; ・第三段階 初めてHP50%未満
;   새벽의명성
; ・第四段階 明けの明星後
;   디아라한
; ・第五段階 第三段階以降HP90%まで
;   アタック*2
; ・第六段階 第三段階以降HP50%まで
;   화염->빙결->전격->질풍->コンセ->メギドラオンのローテーションで攻撃。攻撃相性が無効と吸収のみの場合は次の攻撃相性のガードブレイク
; ・第七段階 第三段階以降HP50%未満
;   화염->빙결->전격->질풍->기합->八艘飛びのローテーションで攻撃
;   この時点でスキルから不屈の闘志が削除される
@SET_ACTION_マーガレット, ARG
#LOCALSIZE 4
VARSET LOCAL, 0
; 全能の真珠モードチェック
IF !CFLAG:ARG:601 < 99
	; 速攻キルしたら死ぬがよい
	IF CFLAG:ARG:이악물기플래그
		DEBUGPRINTL メギドラオンモードon(이악물기플래그)
		CFLAG:ARG:601 = 99
	ELSE
		FOR LOCAL, 1, 7
			SIF POS(LOCAL) < 0
				CONTINUE
			; マハアナライズを持っていたら死ぬがよい(ただしMASTERは除く)
			IF POS(LOCAL) != MASTER && HAVE_SKILL(POS(LOCAL), [[스킬:마하애널라이즈]])
				DEBUGPRINTL メギドラオンモードon(마하애널라이즈)
				CFLAG:ARG:601 = 99
				BREAK
			ENDIF
			; 能力許容値(キャラクター作成時の基準の2倍)を超えているなら死ぬがよい
			; 例. Lv100なら合計346まで許容
			LOCAL:2 = 0
			FOR LOCAL:1 ,31 ,37
				LOCAL:2 += BASE:(POS(LOCAL)):(LOCAL:1)
			NEXT
			FOR LOCAL:1 ,1171 ,1177
				LOCAL:2 += CFLAG:(POS(LOCAL)):(LOCAL:1)
			NEXT
			IF LOCAL:2 > (23 + BASE:(POS(LOCAL)):LV * 3 / 2) * 3 / 2
				DEBUGPRINTL メギドラオンモードon(能力許容値オーバー)
				CFLAG:ARG:601 = 99
				BREAK
			ENDIF
		NEXT
	ENDIF
ELSE
	FOR LOCAL, 0, 6
		CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") = 32
	NEXT
ENDIF

; 50の倍数回行動するか全能の真珠モードで9999メギドラオン
IF (CFLAG:ARG:600 > 0 && (CFLAG:ARG:600 % 50) == 0) || CFLAG:ARG:601 == 99
	; 9999메기도라온
	CALL EVENT_16_SET_ACTION, ARG, [[스킬:9999메기도라온]]
	DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:9999메기도라온
; 戦闘開始
ELSEIF CFLAG:ARG:601 == 0
	CALL EVENT_16_SET_ACTION, ARG, [[스킬:ＡＴＴＡＣＫ]]
	CFLAG:ARG:601 = 1
; 第一, 第五段階 アタックのみ
ELSEIF 現HP割合(ARG) > 90
	DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:アタック
	CALL EVENT_16_SET_ACTION, ARG, [[스킬:ＡＴＴＡＣＫ]]
ELSEIF 現HP割合(ARG) < 50 && CFLAG:ARG:601 < 5
	; 第三段階 새벽의명성
	IF CFLAG:ARG:601 < 4
		CALL EVENT_16_SET_ACTION, ARG, [[스킬:새벽의명성]]
		CFLAG:ARG:601 = 4
		DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:새벽의명성
	; 第四段階 디아라한
	ELSE
		CALL EVENT_16_SET_ACTION, ARG, [[스킬:디아라한]]
		CFLAG:ARG:601 = 5
		DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:디아라한
	ENDIF
; 第二, 第六, 第七段階 화염->빙결->전격->질풍->(コンセメギドラオン or チャージ八艘飛び) ローテーション攻撃
ELSE
	; 段階更新
	IF CFLAG:ARG:601 < 2
		CFLAG:ARG:601 = 2
		CFLAG:ARG:602 = 0
	ELSEIF CFLAG:ARG:601 == 5
		CFLAG:ARG:601 = 6
	ELSEIF 現HP割合(ARG) < 50 && CFLAG:ARG:601 == 6
		CFLAG:ARG:601 = 7
	ENDIF
	; ローテーション行動
	SELECTCASE CFLAG:ARG:602
		CASE 0
			; 基本的にメギドラオンで1moreは取らないと思うので、
			; 必然的に八艘跳びで取った際にここに来る
			IF CFLAG:ARG:１more플래그 > 0
				; 弱体がかかっていればデクンダ。かかってなければヒートライザ
				FOR LOCAL, 0, 6
					IF CFLAG:ARG:(GET_BATTLESTATUS(LOCAL) + "강화") < 0
						; デクンダ
						CALL EVENT_16_SET_ACTION, ARG, [[스킬:데・쿤다]]
						DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:1more_デクンダ
						BREAK
					ELSE
						; 히트라이저
						CALL EVENT_16_SET_ACTION, ARG, [[스킬:히트라이저]]
						DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:1more_ヒートライザ
					ENDIF
				NEXT
			ELSE
				RESULT = EVENT_16_SEARCH_REGISTANCE(2, "화염", 1, 1)
				DEBUGPRINTFORML 火炎耐性検索結果:{RESULT}
				; 弱点持ちがいる
				IF RESULT > 0
					; 火炎単体
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:라그나로크]], RESULT
					DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_火炎単体
				; 全員が無効か吸収
				ELSEIF (RESULT == -2 || (RESULT == -1 && RAND:2)) && CFLAG:ARG:601 >= 5
					; ガードキル
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:빙결가드브레이크]]
					DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_火炎耐性対応
				; 弱点持ちがいないか反射持ちが混ざっている
				ELSE
					; 火炎全体
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:프로미넌스]]
					DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_火炎全体
				ENDIF
			ENDIF
		CASE 1
			; 火炎で1more
			IF CFLAG:ARG:１more플래그 > 0
				; 火炎全体
				CALL EVENT_16_SET_ACTION, ARG, [[스킬:프로미넌스]]
				DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:1more_火炎全体
			ELSE
				RESULT = EVENT_16_SEARCH_REGISTANCE(2, "빙결", 1, 1)
				DEBUGPRINTFORML 氷結耐性検索結果:{RESULT}
				; 弱点持ちがいる
				IF RESULT > 0
					; 氷結単体
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:코큐토스]], RESULT
					DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_氷結単体
				; 全員が無効か吸収
				ELSEIF (RESULT == -2 || (RESULT == -1 && RAND:2)) && CFLAG:ARG:601 >= 5
					; ガードキル
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:전격가드브레이크]]
					DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_氷結耐性対応
				; 弱点持ちがいないか反射持ちが混ざっている
				ELSE
					; 氷結全体
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:니플헤임]]
					DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_氷結全体
				ENDIF
			ENDIF
		CASE 2
			; 氷結で1more
			IF CFLAG:ARG:１more플래그 > 0
				; 氷結全体
				CALL EVENT_16_SET_ACTION, ARG, [[스킬:니플헤임]]
				DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:1more_氷結全体
			ELSE
				RESULT = EVENT_16_SEARCH_REGISTANCE(2, "전격", 1, 1)
				DEBUGPRINTFORML 電撃耐性検索結果:{RESULT}
				; 弱点持ちがいる
				IF RESULT > 0
					; 電撃単体
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:진리의번개]], RESULT
					DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_電撃単体
				; 全員が無効か吸収
				ELSEIF (RESULT == -2 || (RESULT == -1 && RAND:2)) && CFLAG:ARG:601 >= 5
					; ガードキル
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:질풍가드브레이크]]
					DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_電撃耐性対応
				; 弱点持ちがいないか反射持ちが混ざっている
				ELSE
					; 電撃全体
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:엘・지하드]]
					DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_電撃全体
				ENDIF
			ENDIF
		CASE 3
			; 電撃で1more
			IF CFLAG:ARG:１more플래그 > 0
				; 電撃全体
				CALL EVENT_16_SET_ACTION, ARG, [[스킬:엘・지하드]]
				DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:1more_電撃全体
			ELSE
				RESULT = EVENT_16_SEARCH_REGISTANCE(2, "질풍", 1, 1)
				DEBUGPRINTFORML 疾風耐性検索結果:{RESULT}
				; 弱点持ちがいる
				IF RESULT > 0
					; 疾風単体
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:만물유전]], RESULT
					DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_疾風単体
				; 全員が無効か吸収
				ELSEIF (RESULT == -2 || (RESULT == -1 && RAND:2)) && CFLAG:ARG:601 >= 5
					; ガードキル
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:화염가드브레이크]]
					DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_疾風耐性対応
				; 弱点持ちがいないか反射持ちが混ざっている
				ELSE
					; 疾風全体
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:신공파]]
					DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_疾風全体
				ENDIF
			ENDIF
		CASE 4
			; 疾風で1more
			IF CFLAG:ARG:１more플래그 > 0
				; 疾風全体
				CALL EVENT_16_SET_ACTION, ARG, [[스킬:신공파]]
				DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:1more_疾風全体
			ELSE
				IF CFLAG:ARG:601 == 7
					RESULT = EVENT_16_SEARCH_REGISTANCE(2, "검격", 1, 0)
					DEBUGPRINTFORML 剣撃耐性検索結果:{RESULT}
					; 剣撃が通らないならガードブレイク
					IF RESULT == -2 || (RESULT == -1 && RAND:2)
						CALL EVENT_16_SET_ACTION, ARG, [[스킬:검격가드브레이크]]
						DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_剣撃耐性対応
					ELSE
						CALL EVENT_16_SET_ACTION, ARG, [[스킬:기합]]
						DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_チャージ
					ENDIF
				ELSE
					CALL EVENT_16_SET_ACTION, ARG, [[스킬:컨센트레이트]]
					DEBUGPRINTFORML 行動{CFLAG:ARG:600, 4}回目:ローテーション{CFLAG:ARG:602}_コンセ
				ENDIF
			ENDIF
		CASE 5
			IF CFLAG:ARG:601 == 7
				; 팔척뛰기
				CALL EVENT_16_SET_ACTION, ARG, [[스킬:팔척뛰기]]
				DEBUGPRINTFORML 行動{CFLAG:ARG:601,4}回目:ローテーション{CFLAG:ARG:602}_HASSO-BEAT
			ELSE
				; 메기도라온
				CALL EVENT_16_SET_ACTION, ARG, [[스킬:메기도라온]]
				DEBUGPRINTFORML 行動{CFLAG:ARG:601,4}回目:ローテーション{CFLAG:ARG:602}_通常メギドラオン
			ENDIF
	ENDSELECT
ENDIF
CFLAG:ARG:600++
RETURN 0

; 相性変化
; ステータス変化はオミット
; ARG   変更対象キャラ
; ARG:1 変更ペルソナ番号
; ARG:2 現在のペルソナ番号
; ARG:3 変更を表示するかどうか
@EVENT_16_PCHANGE, ARG, CHANGE_P, ARG:1 = 0
#DIM CHANGE_P, 1
; 現況と変更先のペルソナ番号が同じならスキップ
SIF CHANGE_P == CFLAG:ARG:603
	RETURN 0
SELECTCASE CHANGE_P
	CASE 0
		; ペルソナ無し
		; 第一段階のみ
		LOCALS = P・체인지
		MAXBASE:ARG:검격 = 100
		MAXBASE:ARG:비구 = 100
		MAXBASE:ARG:타격 = 100
		MAXBASE:ARG:전술 = 100
		MAXBASE:ARG:화염 = 100
		MAXBASE:ARG:빙결 = 100
		MAXBASE:ARG:전격 = 100
		MAXBASE:ARG:충격 = 100
		MAXBASE:ARG:신경 = 100
		MAXBASE:ARG:정신 = 100
		MAXBASE:ARG:파마 = 0
		MAXBASE:ARG:주살 = 100
		MAXBASE:ARG:지변 = 100
		MAXBASE:ARG:수격 = 100
