;-----------------------------------------------------------
; 相性走査関数　@EVENT_16_SEARCH_REGISTANCE(ARG, ARGS, ARG:1 = 0, ARG:2 = 0)
; 
; 引数
;  ARG   공격범위。0 == 前列(1～3), 1 == 後列(4～6), 2 == 全体(1～6)
;  ARGS  相性名
;  ARG:1 カーン、壁、ガードキルを考慮するか？(1 == する)
;  ARG:2 カーンを考慮する場合の攻撃種別 (0 == 物理, 1 == 魔法)
;
; 戻り値
;  -999 引数の設定ミスによる処理中断
;  -3   反射持ちキャラがいる
;  -2   吸収のみ
;  -1   無効のみ
;  0    弱点持ちキャラがいない
;  >= 1 弱点持ちキャラのポジション
;-----------------------------------------------------------
@EVENT_16_SEARCH_REGISTANCE(ARG, ARGS, ARG:1 = 0, ARG:2 = 0)
#FUNCTION
#DIM COM, 7
#LOCALSIZE 6
; 変数初期化
VARSET LOCAL, 0
VARSET COM, -999
; 走査範囲設定
SELECTCASE ARG
	CASE 0
		LOCAL:2 = 1
		LOCAL:3 = 4
	CASE 1
		LOCAL:2 = 4
		LOCAL:3 = 7
	CASE 2
		LOCAL:2 = 1
		LOCAL:3 = 7
ENDSELECT
; 範囲チェック
SIF !LOCAL:2 && !LOCAL:3
	RETURNF -999
; 走査処理
FOR LOCAL, LOCAL:2, LOCAL:3
	; 存在しないか死んでいるならスキップ
	SIF POS(LOCAL) < 0 || GET_STATE(CFLAG:(POS(LOCAL)):상태이상) == "DYING"
		CONTINUE
	LOCAL:1 = GETNUM(BASE, ARGS)
	; カーン
	; 反射扱いにする
	IF ARG:1 && ARGS != "만능" && (ARG:2 == 0 && CFLAG:(POS(LOCAL)):물리반사플래그) || (ARG:2 == 1 && CFLAG:(POS(LOCAL)):마법반사플래그)
		COM:(LOCAL - 1) = 999
		CONTINUE
	; 壁
	; 無効未満なら無効扱いにする
	ELSEIF ARG:1 && CFLAG:(POS(LOCAL)):(1130 + GET_TYPE_NUM(ARGS)) > 0 && MAXBASE:(POS(LOCAL)):(LOCAL:1) > 0
		COM:(LOCAL - 1) = 0
		CONTINUE
	; ガードキル
	; 耐性以上なら等倍扱いにする
	ELSEIF ARG:1 && CFLAG:(POS(LOCAL)):(1270 + GET_TYPE_NUM(ARGS)) > 0 && MAXBASE:(POS(LOCAL)):(LOCAL:1) < 100
		COM:(LOCAL - 1) = 100
		CONTINUE
	; 방어
	; 1moreが取れないので等倍扱いにする
	ELSEIF ARG:1 && CFLAG:(POS(LOCAL)):방어플래그 && MAXBASE:(POS(LOCAL)):(LOCAL:1) > 100
		COM:(LOCAL - 1) = 100
		CONTINUE
	ENDIF
	COM:(LOCAL - 1) = MAXBASE:(POS(LOCAL)):(LOCAL:1)
NEXT
; 変数セット
LOCAL:4 = -999
FOR LOCAL, 0, 6
	IF LOCAL:4 < COM:LOCAL
		LOCAL:4 = COM:LOCAL
		LOCAL:5 = LOCAL
	ENDIF
NEXT
SIF LOCAL:4 == 999
	RETURNF -3
SIF LOCAL:4 < 0
	RETURNF -2
SIF LOCAL:4 == 0
	RETURNF -1
SIF LOCAL:4 > 100
