@戦闘能力修正_3756,ARG,ARG:1 = -1
SIF ARG == -1
			RETURN 0
SELECTCASE ARG
	CASE 2
		SIF ARG:1 == -1
			RETURN 0
		IF FLAG:무후후전개
			IF EQUIP:(ARG:1):머리 == 0 && EQUIP:(ARG:1):팔 == 0 && EQUIP:(ARG:1):발 == 0
				LOCAL = MIN(BASE:(ARG:1):LV * 2 + 30 , 200)
				RETURN LOCAL
			ELSE
			RETURN 0
			ENDIF
		ELSE
		RETURN 0
		ENDIF
	CASE 3
		SIF ARG:1 == -1
			RETURN 0
		IF FLAG:무후후전개
			IF EQUIP:(ARG:1):머리 == 0 && EQUIP:(ARG:1):팔 == 0 && EQUIP:(ARG:1):발 == 0
				LOCAL = MIN(BASE:(ARG:1):LV * 1 + 10 , 130)
				RETURN LOCAL
			ELSE
			RETURN 0
			ENDIF
		ELSE
		RETURN 0
		ENDIF
	CASE 5
		SIF ARG:1 == -1
			RETURN 0
		IF FLAG:무후후전개
			IF EQUIP:(ARG:1):머리 == 0 && EQUIP:(ARG:1):팔 == 0 && EQUIP:(ARG:1):발 == 0
				LOCAL = MIN(BASE:(ARG:1):LV / 2 + 10 , 60)
				RETURN LOCAL
			ELSE
			RETURN 0
			ENDIF
		ELSE
		RETURN 0
		ENDIF
ENDSELECT

RETURN 0

