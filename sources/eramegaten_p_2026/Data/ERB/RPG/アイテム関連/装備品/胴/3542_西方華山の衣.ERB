@基本能力修正_3542,ARG,ARG:1 = -1
;1.힘　2.지혜　3.마력　4.내구　5.속도　6.운
SELECTCASE GET_BASESTATUS(ARG)
	CASE "힘", "지혜", "마력", "내구", "속도", "운"
		IF ARG:1 > -1
			IF EQUIP:(ARG:1):머리 == 3031 && EQUIP:(ARG:1):몸통 == 3542 && EQUIP:(ARG:1):팔 == 4024 && EQUIP:(ARG:1):발 == 4527
				LOCAL = BASE:(ARG:1):LV / 10 + 1
				IF LOCAL > 10
					LOCAL = 10
				ENDIF
				RETURN LOCAL
			ENDIF
		ENDIF
ENDSELECT
RETURN 0

