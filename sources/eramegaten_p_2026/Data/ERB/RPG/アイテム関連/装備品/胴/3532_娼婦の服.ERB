@戦闘能力修正_3532,ARG,ARG:1 = -1

SELECTCASE ARG
	;방어
	CASE 2
		IF ARG:1 > -1
			RETURN -30 + MIN((62 * EXP:(ARG:1):매춘경험 / 2000) , 30 + (MAXBASE:(ARG:1):LV * 275 / 100 + 8) * 4 / 10)
		ELSE
			RETURN -30
		ENDIF
	;회피
	CASE 3
		IF ARG:1 > -1
			RETURN -15 + MIN((31 * EXP:(ARG:1):매춘경험 / 2000) , 15 + (MAXBASE:(ARG:1):LV * 175 / 100 + 6) * 3 / 10)
		ELSE
			RETURN -15
		ENDIF
	;마법효과
	CASE 5
		IF ARG:1 > -1
			RETURN -2 + MIN((10 * EXP:(ARG:1):매춘경험 / 2000) , 2 + (MAXBASE:(ARG:1):LV * 175 / 100 + 8) * 1 / 10)
		ELSE
			RETURN -2
		ENDIF
		
ENDSELECT
RETURN 0

@防御相性_3532,ARG,ARG:1 = -1
SELECTCASE ARG
	;정신
	CASE 9
		IF ARG:1 > -1
			RETURN MAX(200 - EXP:(ARG:1):매춘경험 / 100 * 5, 50)
		ELSE
			RETURN 200
		ENDIF
	;破魔・呪殺
	CASE 10,11
		IF ARG:1 > -1
			RETURN MAX(200 - EXP:(ARG:1):매춘경험 / 50 * 5, 100)
		ELSE
			RETURN 200
		ENDIF
	CASEELSE
		IF ARG:1 > -1
			RETURN MAX(200 - EXP:(ARG:1):매춘경험 / 100 * 5, 100)
		ELSE
			RETURN 200
		ENDIF
ENDSELECT
RETURN 100

