@基本能力修正_3620,ARG,ARG:1 = -1
SIF ARG:1 < 0
	RETURN 0
SELECTCASE ARG
CASE 2
	RETURN MIN(BASE:(ARG:1):LV/15, 3)
CASEELSE
	RETURN MIN(BASE:(ARG:1):LV/60, 1)
ENDSELECT
RETURN 0

@戦闘能力修正_3620,ARG,ARG:1 = -1
SIF ARG:1 < 0
	RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "魔胴", 1)
;レベル5おきに性能強化、レベルが上がるごとに少しずつ同レベル帯の装備に後れを取る（ステータス生成関数側に上限設定があるのでレベル100で追いつく）
RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "魔胴", (MAX(1, (BASE:(ARG:1):LV/5)*5) * MAX(80, 100-BASE:(ARG:1):LV/5)) / 100)

@防御相性_3620,ARG,ARG:1 = -1
; 0-검격　 1-비구　 2-타격　 3-전술　 4-화염　 5-빙결　 6-전격　 7-충격　 8-신경　 9-정신
;10-파마　11-주살　12-지변　13-수격　14-질풍　15-중력　16-핵열　17-만능
SELECTCASE ARG
	;無効
	CASE 8, 11
		RETURN 0
	;耐性
	CASE 5, 9
		RETURN 50
	;弱点
	CASE 7, 14
		RETURN 125
	CASE 16
		RETURN 150
	CASE 4
		RETURN 200
ENDSELECT
RETURN 100

@バステ耐性_3620,ARG,ARG:1 = -1
; 1-HAPPY  幸福　 2-SHOCK 感電　 3-PANIC 混乱　 4-SLEEP 睡眠　 5-FREEZE 凍結
; 6-BIND   긴박　 7-CLOSE 魔封　 8-POISON　毒　 9-BOMB　爆弾　10-CHARM　魅了
;11-PALYZE 麻痺　12-CURSE 呪い　14-STONE 石化　15-DYING 即死　18-FLAME　炎上
;19-SLIP　 転倒　20-BEAND 낙인
SELECTCASE ARG
	;無効
	CASE 14
		RETURN -100
ENDSELECT
RETURN 0

