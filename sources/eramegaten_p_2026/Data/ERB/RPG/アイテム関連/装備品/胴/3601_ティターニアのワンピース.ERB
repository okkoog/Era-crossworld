@戦闘能力修正_3601,ARG,ARG:1 = -1

SELECTCASE ARG
	CASE 2
		SIF ARG:1 == -1
			RETURN 70
		IF EQUIP:(ARG:1):머리 == 3201
			LOCAL = BASE:(ARG:1):LV / 3 +70
			RETURN LOCAL
		ELSE
			RETURN 70
		ENDIF
	CASE 3
		SIF ARG:1 == -1
			RETURN 25
		IF EQUIP:(ARG:1):머리 == 3201
			LOCAL = BASE:(ARG:1):LV / 4 + 25
			RETURN LOCAL
		ELSE
			RETURN 25
		ENDIF
	CASE 4
		SIF ARG:1 == -1
			RETURN 5
		LOCAL = BASE:(ARG:1):LV / 4 + 11
		RETURN LOCAL
	CASE 5
		SIF ARG:1 == -1
			RETURN 5
		LOCAL = BASE:(ARG:1):LV / 4 + 5
		RETURN LOCAL
ENDSELECT
RETURN 0

