	CASE "수격", "질풍", "중력", "지변", "핵열"
		RETURN 50
		;, "정신", "신경", "파마", "주살"
	CASE "화염", "빙결", "전격", "충격"
		RETURN 125
ENDSELECT
RETURN 100

