@基本能力修正_3605,ARG,ARG:1 = -1

SELECTCASE ARG
ENDSELECT
RETURN 0

@戦闘能力修正_3605,ARG,ARG:1 = -1

SELECTCASE ARG
	CASE 2
		SIF ARG:1 == -1
			RETURN 13
		IF EQUIP:(ARG:1):머리 == 3205 && EQUIP:(ARG:1):발 == 4603
			LOCAL = BASE:(ARG:1):LV / 2 + 13
			SIF TALENT:(ARG:1):헌신적
				LOCAL = LOCAL * 5 / 4
				IF LOCAL > 120
					LOCAL = 120
				ENDIF
			RETURN LOCAL
		ELSE
			RETURN 13
		ENDIF
	CASE 3
		SIF ARG:1 == -1
			RETURN 4
		IF EQUIP:(ARG:1):머리 == 3205 && EQUIP:(ARG:1):발 == 4603
			LOCAL = BASE:(ARG:1):LV / 2 + 4
			SIF TALENT:(ARG:1):헌신적
				LOCAL = LOCAL * 5 / 4
				IF LOCAL > 60
					LOCAL = 60
				ENDIF
			RETURN LOCAL
		ELSE
			RETURN 4
		ENDIF
ENDSELECT
RETURN 0

@防御相性_3605,ARG,ARG:1 = -1

SELECTCASE GET_TYPE(ARG)
	CASE "타격", "빙결"
		IF (ARG:1) < 0
		ELSEIF EQUIP:(ARG:1):머리 == 3205 && EQUIP:(ARG:1):발 == 4603
			RETURN 50
		ENDIF
	CASE "신경", "중력", "만능"
		IF (ARG:1) < 0
		ELSEIF EQUIP:(ARG:1):머리 == 3205 && EQUIP:(ARG:1):발 == 4603
			RETURN 80
		ENDIF
	CASE "정신"
		IF (ARG:1) < 0
		ELSEIF EQUIP:(ARG:1):머리 == 3205 && EQUIP:(ARG:1):발 == 4603
			RETURN 0
		ENDIF
ENDSELECT
RETURN 100

