@戦闘能力修正_3501,ARG,ARG:1 = -1

SELECTCASE ARG
	CASE 2
		RETURN 14
	CASE 3
		IF ARG:1 > -1
			SELECTCASE ABL:(ARG:1):노출증
				CASE 0
					RETURN 5
				CASE 1
					RETURN 7
				CASE IS < 4
					RETURN 11
				CASEELSE
					RETURN 14
			ENDSELECT
		ELSE
			RETURN 5
		ENDIF
	CASE 5
		RETURN 3
ENDSELECT
RETURN 0

@防御相性_3501,ARG,ARG:1 = -1
SELECTCASE ARG
	;화염
	CASE 4
		IF ARG:1 > -1 
			RETURN MAX(100 - (ABL:(ARG:1):노출증 * 10), 0)
		ELSE
			RETURN 100
		ENDIF
	;빙결
	CASE 5
		IF ARG:1 > -1
			RETURN MAX(150 - (ABL:(ARG:1):노출증 * 5), 100)
		ELSE
			RETURN 150
		ENDIF
ENDSELECT
RETURN 100

