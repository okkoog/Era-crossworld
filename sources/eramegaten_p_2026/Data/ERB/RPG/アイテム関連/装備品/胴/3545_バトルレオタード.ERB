@戦闘能力修正_3545,ARG,ARG:1 = -1

SELECTCASE ARG
	;防御24~80 露出癖とレベルで変化
	CASE 2
		IF ARG:1 > -1
			SELECTCASE ABL:(ARG:1):노출증
				CASE 0
					RETURN 24
				CASE 1
					RETURN 28
				CASE IS < 4
					IF EQUIP:(ARG:1):머리 == 3004 && EQUIP:(ARG:1):발 == 4528
						LOCAL = BASE:(ARG:1):LV / 5 + 30
							IF LOCAL > 60
								LOCAL = 60
							ENDIF
						RETURN LOCAL
					ELSE
						RETURN 30
					ENDIF
				CASEELSE
					IF EQUIP:(ARG:1):머리 == 3004 && EQUIP:(ARG:1):발 == 4528
						LOCAL = BASE:(ARG:1):LV / 4 + 35
							IF LOCAL > 80
								LOCAL = 80
							ENDIF
						RETURN LOCAL
					ELSE
						RETURN 35
					ENDIF
			ENDSELECT
		ENDIF
		RETURN 24
	;露出癖とレベルで変化 最大100
	CASE 3
		IF ARG:1 > -1
			SELECTCASE ABL:(ARG:1):노출증
				CASE 0
					RETURN 10
				CASE 1
					RETURN 15
				CASE IS < 4
					IF EQUIP:(ARG:1):머리 == 3004 && EQUIP:(ARG:1):발 == 4528
						LOCAL = BASE:(ARG:1):LV / 4 + 20
							IF LOCAL > 80
								LOCAL = 80
							ENDIF
						RETURN LOCAL
					ELSE
						RETURN 20
					ENDIF
				CASEELSE
					IF EQUIP:(ARG:1):머리 == 3004 && EQUIP:(ARG:1):발 == 4528
						LOCAL = BASE:(ARG:1):LV / 3 + 26
							IF LOCAL > 100
								LOCAL = 100
							ENDIF
						RETURN LOCAL
					ELSE
						RETURN 26
					ENDIF
			ENDSELECT
		ELSE
			RETURN 11
		ENDIF
	CASE 5
		RETURN 3
ENDSELECT
RETURN 0
@防御相性_3545,ARG,ARG:1 = -1
;0,검격
;1,비구
;2,타격
;3,전술
;4,화염
;5,빙결
;6,전격
;7,충격
;8,신경
;9,정신
;10,파마
;11,주살
;一応
;12,지변
;13,수격
;14,질풍
;15,중력
;16,핵열
;17,만능
;18,사이코
SELECTCASE GET_TYPE(ARG)
	CASE "지변", "중력"
		IF (ARG:1) < 0
		ELSEIF EQUIP:(ARG:1):머리 == 3004 && EQUIP:(ARG:1):발 == 4528
				RETURN 50
		ENDIF
	CASE "정신"
		IF (ARG:1) < 0
		ELSEIF EQUIP:(ARG:1):머리 == 3004 && EQUIP:(ARG:1):발 == 4528
				RETURN 999
		ENDIF
	CASE "만능"
		IF (ARG:1) < 0
		ELSEIF EQUIP:(ARG:1):머리 == 3004 && EQUIP:(ARG:1):발 == 4528
				RETURN 80
		ENDIF
ENDSELECT
RETURN 100

