	RETURN 1
RETURN 0

@戦闘能力修正_3566,ARG,ARG:1 = -1
SELECTCASE ARG
	CASE 2
		RETURN 50
	CASE 3
		RETURN 30
	CASE 5
		RETURN 15
ENDSELECT
RETURN 0

@防御相性_3566,ARG,ARG:1 = -1
;吸電
SELECTCASE ARG
	;화염/충격
	CASE 4, 7
		RETURN 150
	;정신/질풍/중력/핵열
	CASE 9, 14, 15, 16
		RETURN 50
	;전격
	CASE 6
		RETURN -50
	;파마
	CASE 10
		RETURN 0
	;주살
	CASE 11
		RETURN 200
ENDSELECT
RETURN 100

