@戦闘能力修正_3621,ARG,ARG:1 = -1

SELECTCASE ARG
;공격
	CASE 0
		RETURN 0
;명중
	CASE 1
		RETURN 0
;방어
	CASE 2
			SIF ARG:1 == -1
			RETURN 100
		LOCAL = 100 - BASE:(ARG:1):LV * 3
			SIF LOCAL <= 0
			LOCAL = 0
		RETURN LOCAL
;회피
	CASE 3
		SIF ARG:1 == -1
			RETURN 50
		LOCAL = 50 - BASE:(ARG:1):LV * 2
			SIF LOCAL <= 0
			LOCAL = 0
		RETURN LOCAL
		RETURN 0
;魔法攻撃
	CASE 4
		RETURN 0
;魔法防御
	CASE 5
		SIF ARG:1 == -1
			RETURN 100	
		LOCAL = 100 - BASE:(ARG:1):LV * 3
			SIF LOCAL <= 0
			LOCAL = 0
		RETURN LOCAL
ENDSELECT
RETURN 0

