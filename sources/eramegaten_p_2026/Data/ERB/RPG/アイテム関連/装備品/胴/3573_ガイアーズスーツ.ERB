@戦闘能力修正_3573,ARG,ARG:1 = -1
SELECTCASE ARG
	;방어
	CASE 2
		IF ARG:1 > -1
			RETURN MIN((62 * (255 - CFLAG:(ARG:1):질혼치) / 255) , (MAXBASE:(ARG:1):LV * 275 / 100 + 8) * 4 / 10)
		ELSE
			RETURN 30
		ENDIF
	;회피
	CASE 3
		IF ARG:1 > -1
			RETURN MIN((31 * (255 - CFLAG:(ARG:1):질혼치) / 150) , (MAXBASE:(ARG:1):LV * 175 / 100 + 6) * 3 / 10)
		ELSE
			RETURN 15
		ENDIF
	;마법효과
	CASE 5
		IF ARG:1 > -1
			RETURN MIN((10 * (255 - CFLAG:(ARG:1):질혼치) / 150) , (MAXBASE:(ARG:1):LV * 175 / 100 + 8) * 1 / 10)
		ELSE
			RETURN 2
		ENDIF
ENDSELECT
RETURN 0

