;============================================================================
;装備解除
;============================================================================
@装備解除, ARG:0 = -1, L_装備部位, IS_SYNC_SKIP
#DIMS DYNAMIC L_装備部位
#DIM DYNAMIC IS_SYNC_SKIP
SIF ARG:0<0
	THROW キャラ登録番号指定なしで装備解除をしようとしています！
SIF EQUIP:ARG:L_装備部位 == 0
	RETURN 0
;装備があれば解除して、アイテム欄の分を１個増やす
SELECTCASE EQUIP:ARG:L_装備部位
	CASE MIN_PLUGINNUM TO MAX_PLUGINNUM - 1
	CASEELSE
		CALL GET_ITEMMAX, EQUIP:ARG:L_装備部位
		SIF GET_HAVE_ITEM_NUM(EQUIP:ARG:L_装備部位) <= RESULT
			ITEM:(EQUIP:ARG:L_装備部位) += 1
ENDSELECT
EQUIP:ARG:L_装備部位 = 0
SIF 生得武器所持(ARG) && EQUIP:ARG:검 == 0
	EQUIP:ARG:검 = GETNUM(ITEM, "생득무기")
ITEM:생득무기 = 0
;全装備解除の場合はSYNCしない
SIF !IS_SYNC_SKIP
	CALL SYNC_STATUS, ARG

;============================================================================
;全装備解除
;ARG:0に対象者の登録番号(間違うとやばそうなので、省略時はエラー出す)
;============================================================================
@全装備解除(ARG:0 = -1)
#DIM LCOUNT
SIF ARG:0<0
	THROW キャラ登録番号指定なしで全装備解除をしようとしています！
FOR LCOUNT, 0, 8
	CALL 装備解除, ARG, GET_EQUIP(LCOUNT), 1
NEXT
CALL SYNC_STATUS,ARG:0
RETURN

