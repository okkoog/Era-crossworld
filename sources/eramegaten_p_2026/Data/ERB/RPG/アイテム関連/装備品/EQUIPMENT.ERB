@EQUIP_SPECIAL_BULLET,ARG
#DIM LCOUNT
#DIM LINE, 2
#DIM TEMP
#DIM L_COMMENT
#DIM EQUIP_BULLET, 9;判定用に装備中の弾丸をしまっておく
#DIM BULLET_LIST, 100;本来は500だけど…100もいかないだろうしまぁ…
#DIM BULLET_LV, 100
#DIM MAGAZINE_NUM;銃の弾倉数
#DIM L_REPLACE
DRAWLINE
L_COMMENT = -1
L_REPLACE = 0
LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - LINE
VARSET BULLET_LIST, 100*100*100
PRINTL □장비중인 탄환
CALLFORM 特殊弾倉_{EQUIP:ARG:총},ARG
MAGAZINE_NUM = RESULT
VARSET EQUIP_BULLET, 0
FOR LCOUNT ,1, 9
	SIF LCOUNT == 5
		PRINTL
	SIF MAGAZINE_NUM < LCOUNT
		BREAK
	LOCALS = 특수탄{LCOUNT}
	IF EQUIP:ARG:LOCALS == 0
		PRINTFORM [{LCOUNT}] 
		SETCOLOR 0x404040
		PRINT ＥＭＰＴＹ　　　 
		RESETCOLOR
		CONTINUE
	ENDIF
	EQUIP_BULLET:LCOUNT = EQUIP:ARG:LOCALS
	SETCOLOR LCOUNT == L_REPLACE ? COLOR("aqua") # GETCOLOR()
	PRINTFORM [{LCOUNT}] %ITEMNAME:(EQUIP:ARG:LOCALS),20,LEFT%
	RESETCOLOR
NEXT
PRINTL
DRAWLINE
LINE:1 = LINECOUNT
IF L_COMMENT >= 0
	CALLFORM 弾レベル_{L_COMMENT}
	PRINTFORML □%ITEMNAME:L_COMMENT,20,LEFT%　필요 건슬링거Lv:{RESULT}
	CALL EQ_装備解説, L_COMMENT
ENDIF
WHILE LINECOUNT < LINE:1 + 3
	PRINTL 
WEND
DRAWLINE
FOR LCOUNT, 0, VARSIZE("BULLET_LIST")
	TEMP = LCOUNT + 5500
	TRYCCALLFORM 弾レベル_{TEMP}
		SIF ITEM:TEMP > 0
			BULLET_LIST:LCOUNT = RESULT * 1000 + LCOUNT
	CATCH
	ENDCATCH
NEXT
ARRAYSORT BULLET_LIST, FORWARD
FOR LCOUNT, 0, VARSIZE("BULLET_LIST")
	SIF BULLET_LIST:LCOUNT == 100*100*100
		BREAK
	BULLET_LV:LCOUNT = 	BULLET_LIST:LCOUNT / 1000
	BULLET_LIST:LCOUNT %= 1000
NEXT
FOR LCOUNT, 0, VARSIZE("BULLET_LIST")
	SIF BULLET_LIST:LCOUNT == 100*100*100
		BREAK

	TEMP = BULLET_LIST:LCOUNT + 5500
	SIF GET_BTL_TALENT_LV("건슬링거", ARG) < BULLET_LV:LCOUNT
		SETCOLOR COLOR("DARK-GRAY")
	SIF MATCH(EQUIP_BULLET, TEMP)
		SETCOLOR COLOR("パ緑")
	PRINTFORM [{LCOUNT + 100 * BULLET_LV:LCOUNT, 3}] %ITEMNAME:(TEMP), 20, LEFT%×{ITEM:TEMP, 4}　　　　
	RESETCOLOR
	SIF LCOUNT % 3 == 2
		CONTINUE
	SIF !LINEISEMPTY() && (BULLET_LV:LCOUNT != BULLET_LV:(LCOUNT+1))
		PRINTL 
NEXT
SIF !LINEISEMPTY()
	PRINTL 
DRAWLINE
PRINTL 장비 중인 탄환을 선택하여 장비를 해제할 수 있습니다.
PRINTL [ALT]/[마우스 사이드 버튼]을 누른 채로, 장비 중인 탄환을 선택하여 위치를 교체할 수 있습니다.
PRINTL 목록의 탄환을 선택하여 장비를 장착/해제할 수 있습니다.
PRINTL [ALT]/[마우스 사이드 버튼]을 누른 채로, 목록의 탄환을 선택하여 장비 착탈 없이 설명문 표시만 변경할 수 있습니다.
DRAWLINE
PRINTL [0]돌아간다
RESETCOLOR
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF INRANGE(RESULT, 1, MAGAZINE_NUM)
	IF GETKEY(0x12)|| GETKEY(0x05)
		IF L_REPLACE
			SWAP EQUIP:ARG:@"특수탄{L_REPLACE}", EQUIP:ARG:@"특수탄{RESULT}"
		ELSE
			L_REPLACE = RESULT
			GOTO START
		ENDIF
	ELSE
		EQUIP:ARG:@"특수탄{RESULT}" = 0
	ENDIF
ELSEIF BULLET_LIST:(RESULT % 100) < 100 * 100 * 100
	RESULT %= 100
	TEMP = BULLET_LIST:RESULT + 5500
	L_COMMENT = TEMP
	SIF GETKEY(0x12)|| GETKEY(0x05)
		GOTO START
	IF FINDELEMENT(EQUIP_BULLET, TEMP) >= 0
		EQUIP:ARG:@"특수탄{FINDELEMENT(EQUIP_BULLET, TEMP)}" = 0
	ELSE
		IF GET_BTL_TALENT_LV("건슬링거", ARG) >= BULLET_LV:RESULT
			SIF FINDELEMENT(EQUIP_BULLET, 0, 1, MAGAZINE_NUM + 1) >= 0
				EQUIP:ARG:@"특수탄{FINDELEMENT(EQUIP_BULLET, 0, 1, MAGAZINE_NUM + 1)}" = TEMP
		ENDIF
	ENDIF		
ENDIF
L_REPLACE = 0
FOR LCOUNT, 1, MAGAZINE_NUM
	SIF !EQUIP:ARG:@"특수탄{LCOUNT}"
		SWAP EQUIP:ARG:@"특수탄{LCOUNT}", EQUIP:ARG:@"특수탄{LCOUNT+1}"
