;============================================================================
;キャラの装備確認関数
;指定した名称の装備をすべて装備しているかをチェックする
;============================================================================
@IS_CHARA_EQUIPED, L_CHARA, L_EQUIPNAME:0, L_EQUIPNAME:1, L_EQUIPNAME:2, L_EQUIPNAME:3, L_EQUIPNAME:4, L_EQUIPNAME:5, L_EQUIPNAME:6, L_EQUIPNAME:7
#FUNCTION
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_EQUIPNAME, 8
#DIM DYNAMIC L_HIT
FOR LCOUNT, 0, VARSIZE("L_EQUIPNAME")
	SIF L_EQUIPNAME:LCOUNT == ""
		CONTINUE
	SIF GETNUM(ITEM, L_EQUIPNAME:LCOUNT) < 0
		THROW 装備の名称の指定が間違っています [%L_EQUIPNAME:LCOUNT%]
	SIF !MATCH(EQUIP:L_CHARA:0, GETNUM(ITEM, L_EQUIPNAME:LCOUNT), GETNUM(EQUIP, "검"), GETNUM(EQUIP, "탄환") + 1)
		RETURNF 0
	L_HIT = 1
NEXT
RETURNF L_HIT