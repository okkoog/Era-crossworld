	RETURN 0
;SIF ABL:(ARG:0):종족 > 0 && ABL:(ARG:0):종족 < 46 && ABL:(ARG:0):종족 != 36 && SKILL_EQUIPTHEORY_IS_HAVE_SKILL(ARG:0) == 0
;	RETURN 0
