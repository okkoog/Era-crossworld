	L_LINE = LINECOUNT
	FOR LCOUNT,0,7
		SELECTCASE GET_EQUIP(LCOUNT)
			CASE "총"
				SIF !GET_ROLE_PROP("CAN_EQUIP_GUN", U)
					CONTINUE
			CASEELSE
				SIF !GET_ROLE_PROP("CAN_USE_EQUIP", U)
					CONTINUE
