PRINTFORMLC \@(LIST_NUM == 0) ? %" " * 16% # [1001]이전캐릭터\@
PRINTLC [100] 캔슬　　[200]장비변경종료　　
PRINTFORMLC \@(LIST_NUM == A-1) ? %" " * 16% # [1003]다음캐릭터\@
$INPUT_LOOP2
INPUT
L_RESULT = RESULT

IF RESULT == 100
	RESTART
ELSEIF RESULT == 200
	RETURN 0
ELSEIF RESULT == 300
	CALL 全装備解除(L_CHARA)
	GOTO PRINT_ELIST
ELSEIF RESULT == 1001 && LIST_NUM > 0
	LIST_NUM -= 1
	L_CHARA = Q:LIST_NUM
	GOTO PRINT_ELIST
ELSEIF RESULT == 1003 && LIST_NUM < A-1
	LIST_NUM += 1
	L_CHARA = Q:LIST_NUM
	GOTO PRINT_ELIST
ELSEIF RESULT < 0 || RESULT >= 8
	GOTO INPUT_LOOP2
ENDIF
;IF RESULT == 7 && TALENT:(L_CHARA):건슬링거 && EQUIP:(L_CHARA):총;EDIT 017 MOD
IF RESULT == 7 && GET_BTL_TALENT_LV("건슬링거", L_CHARA)  && EQUIP:(L_CHARA):총 > 0
	CALL EQUIP_SPECIAL_BULLET,L_CHARA
	GOTO PRINT_ELIST
ELSEIF RESULT == 7
	GOTO INPUT_LOOP2
ENDIF
CALL EQUIP_CHANGE, L_RESULT, L_CHARA
SIF RESULT == 0
	GOTO PRINT_ELIST
RETURN 1


;EQUIPMENTのINPUT_CHARA_LISTへ渡す用
@EQUIPMENT_ADD_SELECT(ARG)
#DIM DYNAMIC LCOUNT
IF ARG == -1
	PRINTLC [1010]마우스UI모드
	PRINTLC [1011]전체장비해제
	RETURN
ENDIF
IF ARG == 1010
	CALL EQUIPMENT_MouseUI
	SIF RESULT == 1
		RETURN 1000, 0
	RETURN 0, -1
ELSEIF ARG == 1011
	FOR LCOUNT, 0, CHARANUM
		CALL CASTING_EQUIPMENT, LCOUNT
		SIF !RESULT
			CONTINUE
		CALL 全装備解除, LCOUNT
		PRINTFORML %CALLNAME:LCOUNT%의 모든 장비가 해제되었습니다。
	NEXT
	WAIT
	RETURN 0, -1
ENDIF
RETURN ARG, 1

;多分こんなノリ
;ARG:0…装備カテゴリ(0.검/1.총/2.머리/3.몸통/4.팔/5.발/6.악세서리)
;ARG:1…キャラ登録番号
;ARG:2…呼び元(0.装備変更/1.ステータス画面)
@EQUIP_CHANGE, L_EQUIP_TYPE, L_CHARA, ARG
#LOCALSIZE 2
#DIM L_EQUIP_TYPE
#DIM L_CHARA
#DIMS SHOW_MODE
#DIM アイテム確認表示
#DIM 元戦闘能力, 8
#DIM L_COUNT
#DIM LLINE
#DIM LPAGE
#DIM LREDRAW
#DIM LSIZE
;---- EDIT 003 ADD START -------------------------
#DIM L_NG
;---- EDIT 003 ADD END   -------------------------
SHOW_MODE = \@ARG == 0 ? 装備変更 # ステータス画面\@
CALL STATUS_WINDOW_EQUIP_ITEM_LIST(L_CHARA, 0, 0, L_EQUIP_TYPE, "リスト作成")
ARRAYREMOVE アイテムリスト, 0, 1
LLINE = LINECOUNT
LPAGE = 0
LREDRAW = CURRENTREDRAW()
SIF LREDRAW != 2
	REDRAW 2
LSIZE = FINDELEMENT(アイテムリスト, -1)
ARRAYSORT アイテムリスト, FORWARD, 0, LSIZE

$PRINT_EMLIST
CLEARLINE LINECOUNT - LLINE
;---- EDIT 003 ADD START -------------------------
