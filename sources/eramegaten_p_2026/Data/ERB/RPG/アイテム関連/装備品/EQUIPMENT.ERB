		ELSE
			PRINTL ＥＭＰＴＹ
		ENDIF
	ENDIF

	IF ARG && GET_BTL_TALENT_LV("건슬링거",  U)
		SIF FLAG:커스텀게임화면
			PRINT 　
		IF EQUIP:U:총 > 0
			PRINTL [57][특수탄변경]
		ELSE
			PRINTL [--][----------]
		ENDIF
	ENDIF
	DRAWLINE
ENDCATCH

