@EQUIPMENT , ARG = -1 , ARG:1 = -1
#DIM LINE
#DIM LCOUNT
#DIM L_CHARA
#DIM L_RESULT
#DIM LIST_NUM
;キャラリストを表示・選択
IF ARG == -1
	;CALL INPUT_CHARA_LIST("装備を変更させたいキャラを選んでください", "CASTING_EQUIPMENT", , , "EQUIPMENT_MouseUI_Handler")
	{
	CALL INPUT_CHARA_LIST
		, "FUNC_PROPSET_LIST_BATTLE"
		, "장비를 바꾸고 싶은 캐릭터를 선택해주세요"
		, "CASTING_EQUIPMENT" 
		, "SHOW_ADD_UP_FUNCTION"
		, "SHOW_ADD_DOWN_FUNCTION"
		, "EQUIPMENT_ADD_SELECT"
		, "L_CANCELS"
		, "FUNC_CUSTOM_TITLE"
		, "FUNC_CUSTOM_COLOR"
		, -1
	}
	SIF RESULT == 1000
		RETURN 0
	L_CHARA = RESULT
ELSE
	;ステータス画面から来た人用
	L_CHARA = ARG
	
	;キャラ送り用のリスト作成
	VARSET Q , -1
	FOR LCOUNT, 0, CHARANUM
		CALL CASTING_EQUIPMENT(LCOUNT)
		SIF RESULT
			Q:FINDELEMENT(Q, -1) = LCOUNT
	NEXT
	
ENDIF
LIST_NUM = FINDELEMENT(Q, L_CHARA)

SIF GETBIT(FLAG:스테이터스화면타입, 2)
	GOTO PRINT_ELIST

CUSTOMDRAWLINE =
LINE = LINECOUNT
LIST_NUM = FINDELEMENT(Q, L_CHARA)
変更装備箇所 = ARG:1

$RESET
VARSET アイテムリスト , -1
SIF 変更装備箇所 != -1
	CALL STATUS_WINDOW_EQUIP_ITEM_LIST , L_CHARA , 0 , 0 , 変更装備箇所 , "リスト作成"
VARSET 変更予定装備 , -1
CALL 装備変更時ステータス更新 , L_CHARA

$PRINTLOOP
CLEARLINE LINECOUNT - LINE

CALL SET_PICTURE , , , "消去"

;CALL STATUS_WINDOW_MAIN , L_CHARA , 0 , 0

CALL STATUS_WINDOW_EQUIP , L_CHARA , 0 , 0 , 1
CALL STATUS_WINDOW_BATTLE_STATUS , L_CHARA , 13 , 0 , 1
CALL STATUS_WINDOW_DEFTYPE , L_CHARA , 24 , 0 , 1
CALL STATUS_WINDOW_EQUIP_ITEM_LIST , L_CHARA , 0 , 52

;
IF 変更装備箇所 != -1
	CALL STATUS_WINDOW_EQUIP_DATA , L_CHARA , 13 , 76 , EQUIP:(L_CHARA):GET_EQUIP(変更装備箇所) , ""
	CALL SET_PICTURE , "[-],,,-_표시정보전환_[+],,,+" , 13 , , 100
ENDIF
IF 変更装備箇所 > -1 && 変更予定装備:変更装備箇所 != -1
	CALL SET_PICTURE , "↓↓↓" , 23 , , 90
	CALL STATUS_WINDOW_EQUIP_DATA , L_CHARA , 24 , 76 , 変更予定装備:変更装備箇所 , ""
ENDIF

CALL SET_PICTURE ,  , 0 , "表示" , 35 ;35行まで表示
IF FLAG:장비화면생략스위치 == 0
	PRINTL ========
	PRINTL 장비해설
	PRINTL ========
	IF 変更装備箇所 != -1
		CALL EQ_装備解説, EQUIP:(L_CHARA):GET_EQUIP(変更装備箇所), L_CHARA
		SIF !RESULT
			PRINTL 
		IF GET_EQUIP(変更装備箇所) == "검"
			PRINT 종별：
			TRYCCALLFORM 剣タイプ_{EQUIP:(L_CHARA):GET_EQUIP(変更装備箇所)}
				PRINTFORML %GET_ARMS_TYPE(RESULT)%
			CATCH
				PRINTL 그외
			ENDCATCH
		ENDIF
		CALL 装備強化_CSTR, "解説表示", (L_CHARA),EQUIP:(L_CHARA):GET_EQUIP(変更装備箇所)
		;---- EDIT 021 MOD END ---------------------------
	ELSE
		PRINTL
	ENDIF
	IF 変更装備箇所 > -1 && 変更予定装備:変更装備箇所 != -1
		PRINTL 　↓　　　　　　
		CALL EQ_装備解説, 変更予定装備:変更装備箇所
		SIF !RESULT
			PRINTL 
		IF GET_EQUIP(変更装備箇所) == "검"
			PRINT 종별：
			TRYCCALLFORM 剣タイプ_{変更予定装備:変更装備箇所}
				PRINTFORML %GET_ARMS_TYPE(RESULT)%
			CATCH
				PRINTL 그외
			ENDCATCH
		ENDIF
	ELSE
		PRINTL
	ENDIF
ENDIF
IF FLAG:장비화면생략스위치 == 1
	CUSTOMDRAWLINE =
	PRINTL [401]등록장비1세트 　　[402]등록장비2세트 　　[403]등록장비3세트
	PRINTL [404]등록장비4세트 　　[405]등록장비5세트 　　[406]등록장비6세트 
ENDIF
CUSTOMDRAWLINE =
PRINTFORM \@(LIST_NUM == 0) ? %" " * 16% # [1001]이전캐릭터\@
PRINT [100] 돌아간다 [200]장비변경반영 [300]모든장비를 해제
PRINTFORM \@(LIST_NUM == FINDELEMENT(Q, -1) - 1) ? %" " * 16% # [1003]다음캐릭터\@
PRINTL [400]현재의 장비를 등록 [500]표시변경

$INPUTS_LOOP
INPUTS
ENCODETOUNI %RESULTS%
IF RESULTS == "100"
	変更装備箇所 = -1
	VARSET 変更予定装備, -1
	CALL 装備変更時ステータス更新(L_CHARA)
	RETURN 0
ELSEIF RESULTS == "200"
	FOR LOCAL , 0 , 7
		SIF 変更予定装備:LOCAL != -1
			CALL 装備変更 , L_CHARA , LOCAL , 変更予定装備:LOCAL
	NEXT
	GOTO RESET
ELSEIF RESULTS == "300"
	CALL 全装備解除(L_CHARA)
	GOTO RESET
ELSEIF RESULTS == "400"
	CLEARLINE LINECOUNT - LINE
	CALL 装備登録 , L_CHARA
	GOTO PRINTLOOP
ELSEIF RESULTS == "500"
	CLEARLINE LINECOUNT - LINE
	IF FLAG:장비화면생략스위치 == 0
		FLAG:장비화면생략스위치 = 1
	ELSEIF FLAG:장비화면생략스위치 == 1
		FLAG:장비화면생략스위치 = 2
	ELSEIF FLAG:장비화면생략스위치 == 2
		FLAG:장비화면생략스위치 = 0
	ELSE
		FLAG:장비화면생략스위치 = 0
	ENDIF
	GOTO PRINTLOOP
ELSEIF RANGE(TOINT(RESULTS) , 401 , 406)
	LOCAL = TOINT(RESULTS) - 401
	LOCAL = 3100 + LOCAL * 7
	FOR LCOUNT , 0 , 7
		;CALLFORM 装備条件_{CFLAG:(L_CHARA):(LOCAL + LCOUNT)},L_CHARA
		CALL EQ_装備可能確認,L_CHARA,CFLAG:(L_CHARA):(LOCAL + LCOUNT),LCOUNT
		IF EQUIP:(L_CHARA):GET_EQUIP(LCOUNT) == CFLAG:(L_CHARA):(LOCAL + LCOUNT)
			変更予定装備:LCOUNT = -1
		ELSEIF RESULT && (CFLAG:(L_CHARA):(LOCAL + LCOUNT) == 0 || ITEM:(CFLAG:(L_CHARA):(LOCAL + LCOUNT)))
			変更予定装備:LCOUNT = CFLAG:(L_CHARA):(LOCAL + LCOUNT)
		ELSE
			PRINTFORMW %GET_EQUIP(LCOUNT)% 장비를 세팅할 수 없었습니다
		ENDIF
	NEXT
	CALL 装備変更時ステータス更新 , L_CHARA
	RESULT = 0
	GOTO PRINTLOOP
ELSEIF RESULTS == "1001" && LIST_NUM > 0
	変更装備箇所 = -1
	LIST_NUM -= 1
	L_CHARA = Q:LIST_NUM
	GOTO RESET
ELSEIF RESULTS == "1003" && LIST_NUM < FINDELEMENT(Q, -1) -1
	変更装備箇所 = -1
	LIST_NUM += 1
	L_CHARA = Q:LIST_NUM
	GOTO RESET
ELSEIF RESULTS == "56" && GET_ROLE_PROP("CAN_USE_PLUGIN", L_CHARA)
	CALL CHANGE_PLUGIN_SOFT, L_CHARA
	GOTO RESET
ELSEIF RANGE(TOINT(RESULTS) , 50 , 56)
	変更装備箇所 = TOINT(RESULTS) - 50
	CALL STATUS_WINDOW_EQUIP_ITEM_LIST , L_CHARA , 0 , 0 , 変更装備箇所 , "リスト作成"
	GOTO PRINTLOOP

;ELSEIF RANGE(TOINT(RESULTS) , 2000 , 5499) && FINDELEMENT(アイテムリスト , TOINT(RESULTS)) > -1
ELSEIF RESULT == 1 && RANGE(RESULT:1 , 97 , 97 + 19) && アイテムリスト:(アイテムリストページ * 20 + RESULT:1 - 97) > -1
	;変更予定装備:変更装備箇所 = TOINT(RESULTS)
	変更予定装備:変更装備箇所 = アイテムリスト:(アイテムリストページ * 20 + RESULT:1 - 97)
	CALL 装備変更時ステータス更新 , L_CHARA
	
	GOTO PRINTLOOP
ELSEIF RESULTS == "57" && GET_BTL_TALENT_LV("건슬링거", L_CHARA)  && EQUIP:(L_CHARA):총 > 0
;ELSEIF RESULTS == "57" && TALENT:(L_CHARA):건슬링거 > 0 && EQUIP:(L_CHARA):총 > 0;EDIT 017 MOD
	CALL EQUIP_SPECIAL_BULLET, L_CHARA
	GOTO RESET
ELSEIF RESULTS == "<"
	アイテムリストページ = LIMIT(アイテムリストページ-1 , 0 , (FINDELEMENT(アイテムリスト , -1)-1) / 20)
	GOTO PRINTLOOP
ELSEIF RESULTS == ">"
	アイテムリストページ = LIMIT(アイテムリストページ+1 , 0 , (FINDELEMENT(アイテムリスト , -1)-1) / 20)
	GOTO PRINTLOOP
ELSEIF RESULTS == "장비상세선택" && 変更装備箇所 >= 0
	CALL EQUIP_DETAIL_ITEM_LIST, 変更装備箇所, L_CHARA
	SIF RESULT != 100
		変更予定装備:変更装備箇所 = RESULT
	CALL 装備変更時ステータス更新 , L_CHARA
	GOTO PRINTLOOP
ELSEIF RESULTS == "+" || RESULTS == "-"
	CALL STATUS_WINDOW_EQUIP_DATA , , , , , @"表示切替%RESULTS%"
	GOTO PRINTLOOP
ELSEIF RESULTS == "≫"
	FLAG:윈도우내성표시설정 = ++FLAG:윈도우내성표시설정 % 3
	GOTO PRINTLOOP
ELSEIF RESULTS == "≪"
	FLAG:윈도우내성표시설정 = (FLAG:윈도우내성표시설정 + 2) % 3
	GOTO PRINTLOOP
ELSEIF RESULTS == "정렬 조건 변경"
	CALL CHANGE_CONDITION_EQUIP_SORT
	CALL EQUIP_SORT , L_CHARA , 1
	GOTO PRINTLOOP
ELSE
	GOTO INPUTS_LOOP
ENDIF

