@銃攻撃_2783,ARG = -1
SIF ARG == -1
	RETURN 120
IF ARG > -1
	;初期化
	LOCAL = 0
	IF TALENT:ARG:모유체질 == 1 || TALENT:ARG:절벽 == 1
		LOCAL = 10 + MIN((EXP:(ARG):분유경험 / 5) + (ABL:(ARG):분유중독 * 10) , 110)
		RETURN LOCAL
	ELSE
		RETURN 0
	ENDIF
ENDIF

