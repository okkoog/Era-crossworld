@銃攻撃_2780,ARG = -1
SIF ARG == -1
	RETURN 60
IF ARG > -1
	;初期化
	LOCAL = 0
	IF TALENT:ARG:모유체질 == 1
		LOCAL = 10 + MIN((EXP:(ARG):분유경험 / 10) + (ABL:(ARG):분유중독 * 5) , 90)
		RETURN LOCAL
	ELSEIF TALENT:ARG:모유체질 == 0
		RETURN 0
	ENDIF
ENDIF

