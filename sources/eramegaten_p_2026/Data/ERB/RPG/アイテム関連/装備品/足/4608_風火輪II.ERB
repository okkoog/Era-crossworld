@装備追加スキル_4608,ARG,ARG:1 = -1
SIF ARG:1 == -1
	RETURN 0
SIF EQUIP:(ARG:1):검
	RETURN 0
IF GET_ROLE_PROP("CAN_USE_WEAPON_MASTERY", ARG:1) && TALENT:(ARG:1):마샬아츠
	;IF MAXBASE:(ARG:1):ＭＰ < 1
	IF !GET_ROLE_PROP("HAVE_MP", ARG:1)
		SELECTCASE ARG
			CASE 0
				RETURN [[스킬:결단]]
			CASE 1
				RETURN [[스킬:타격부스터]]
		ENDSELECT
	ELSE
		SELECTCASE ARG
			CASE 0
				RETURN [[스킬:화쇄열풍파]]
			CASE 1
				RETURN [[스킬:열풍격]]
		ENDSELECT
	ENDIF
ENDIF
RETURN 0

