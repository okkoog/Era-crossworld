@戦闘能力修正_4549,ARG,ARG:1 = -1
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		SIF ARG:1 == -1
			RETURN 0
		SIF EQUIP:(ARG:1):검 == 0 && TALENT:(ARG:1):마샬아츠
			RETURN 182
	CASE "명중"
		SIF ARG:1 == -1
			RETURN 0
		SIF EQUIP:(ARG:1):검 == 0 && TALENT:(ARG:1):마샬아츠
			RETURN 151
	CASE "방어"
		RETURN 23
	CASE "회피"
		RETURN 22
	CASE "마법위력"
		SIF ARG:1 == -1
			RETURN 0
		SIF EQUIP:(ARG:1):검 == 0 && TALENT:(ARG:1):마샬아츠
			RETURN 28
	CASE "마법효과"
		SIF ARG:1 == -1
			RETURN 8
		SIF EQUIP:(ARG:1):검 == 0 && TALENT:(ARG:1):마샬아츠
			RETURN 22
		RETURN 8
ENDSELECT
RETURN 0

