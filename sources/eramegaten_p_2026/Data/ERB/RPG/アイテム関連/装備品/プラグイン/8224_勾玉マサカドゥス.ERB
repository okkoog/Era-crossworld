@防御相性_8224,ARG,ARG:1 = -1
;装備者がいない場合
IF ARG:1 == -1
	SELECTCASE GET_TYPE(ARG)
		CASE "신경","정신","파마","주살"
			RETURN 0
		CASE "검격","비구","타격","전술","화염","빙결","전격","충격"
			RETURN 100
		CASE "지변","수격","질풍","중력","핵열","만능"
			RETURN 150
	ENDSELECT
;80より上
ELSEIF BASE:(ARG:1):30 > 79
	SELECTCASE GET_TYPE(ARG)
		CASE "검격","비구","타격","전술","화염","빙결","전격","충격","신경","정신","파마","주살"
			RETURN 0
		CASE "지변","수격","질풍","중력","핵열","만능"
			RETURN 100
	ENDSELECT
;51Lv以降
ELSEIF BASE:(ARG:1):30 > 50
	SELECTCASE GET_TYPE(ARG)
		CASE "신경","정신","파마","주살"
			RETURN 0
		CASE "검격","비구","타격","전술","화염","빙결","전격","충격"
			RETURN 50
		CASE "지변","수격","질풍","중력","핵열","만능"
			RETURN 125
	ENDSELECT
;26Lv以降
ELSEIF BASE:(ARG:1):30 > 25
	SELECTCASE GET_TYPE(ARG)
		CASE "신경","정신","파마","주살"
			RETURN 0
		CASE "검격","비구","타격","전술","화염","빙결","전격","충격"
			RETURN 75
		CASE "지변","수격","질풍","중력","핵열","만능"
			RETURN 150
	ENDSELECT
;25Lv以下
ELSE
	SELECTCASE GET_TYPE(ARG)
		CASE "신경","정신","파마","주살"
			RETURN 0
		CASE "검격","비구","타격","전술","화염","빙결","전격","충격"
			RETURN 100
		CASE "지변","수격","질풍","중력","핵열","만능"
			RETURN 150
	ENDSELECT
ENDIF
RETURN 100
