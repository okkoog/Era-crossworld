@基本能力修正_8020,ARG,ARG:1 = -1
#LOCALSIZE 2
SIF ARG:1 == -1
	RETURN 0
		LOCAL = BASE:(ARG:1):힘/4
		LOCAL:1 = BASE:(ARG:1):내구/4
SELECTCASE GET_BASESTATUS(ARG)
	CASE "힘"
		RETURN -LOCAL
	CASE "지혜"
		RETURN LOCAL:1
	CASE "마력"
		RETURN LOCAL
	CASE "내구"
		RETURN -LOCAL:1
ENDSELECT
