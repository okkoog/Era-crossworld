@防御相性_4449,ARG,ARG:1 = -1
SELECTCASE GET_TYPE(ARG)
;ベンベン琵琶と同時装備で破魔強抵抗・呪殺無効
	CASE "파마"
			SIF ARG:1 == -1
			RETURN 100
	IF EQUIP:(ARG:1):악세서리 == 5253
		RETURN 25
	ELSE
		RETURN 100
	ENDIF
	CASE "주살"
			SIF ARG:1 == -1
			RETURN 100
	IF EQUIP:(ARG:1):악세서리 == 5253
		RETURN 0
	ELSE
		RETURN 100
	ENDIF
ENDSELECT
RETURN 100

