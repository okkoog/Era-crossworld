@防御相性_4055,ARG,ARG:1 = -1
IF ARG:1 > -1
	SELECTCASE GET_TYPE(ARG)
		CASE "빙결"
			IF EQUIP:(ARG:1):몸통 == 3503
				RETURN 75
			ELSE
				RETURN 100
			ENDIF
		CASE "화염"
			IF EQUIP:(ARG:1):몸통 == 3503
				RETURN 150
			ELSE
				RETURN 100
			ENDIF
	ENDSELECT
ENDIF
RETURN 100

