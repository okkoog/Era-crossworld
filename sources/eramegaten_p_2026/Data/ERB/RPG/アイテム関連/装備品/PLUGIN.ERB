@PLUGUIN_CUSTOM_TITLE, ARG, ARGS
SIF ARGS == "PLUGINSHORTCUT"
	RETURN 0
SIF ARGS == "EQPLUGIN" && INRANGE(EQUIP:ARG:악세서리, MIN_PLUGINNUM, MAX_PLUGINNUM)
	CALL GET_TITLE_FOR_PLUGUIN, EQUIP:ARG:악세서리
RETURN 1

@INFO_PLUGIN_MAIN
RESULTS '= "NO_NAME_LV_CP_EQPLUGIN_PLUGINSHORTCUT"

@INFO_PLUGIN_戦闘
RESULTS '= "NO_NAME_LV_ALI_SEX_POS_HP_MP_CP_EQPLUGIN"

;--------------------------------------------------------------------------------
;EQPLUGIN
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_EQPLUGIN_HEADER
INFO_HEADER += SET_BUTTON_TAG(TOALIGNMENT("PLUGIN", 24, "CENTER"), "SORT,EQPLUGIN")

@GET_VAR_INFO_DATA_EQPLUGIN, ARG
#DIMS DYNAMIC L_PLUGINNAME
IF EQUIP:ARG:악세서리
	L_PLUGINNAME '= PLUGINNAME(EQUIP:ARG:악세서리)
	SIF STRLENS(L_PLUGINNAME) > 24
		L_PLUGINNAME '= SUBSTRING(L_PLUGINNAME, 0, 22) + ".."
	RESULTS '= TOALIGNMENT(L_PLUGINNAME, 24, "CENTER")
ELSE
	RESULTS '= TOALIGNMENT("ＥＭＰＴＹ", 24, "CENTER")
ENDIF
@GET_INFO_SORT_KEY_EQPLUGIN, ARG, ARGS
RETURN EQUIP:ARG:악세서리

;--------------------------------------------------------------------------------
;PLUGINSHORTCUT
;--------------------------------------------------------------------------------
@SET_VAR_INFO_DATA_PLUGINSHORTCUT_HEADER
#DIMS DYNAMIC TEMPS
INFO_HEADER += " " * 28
TEMPS '= UNICODE(0x25c0) * 2
TEMPS '= SET_COLOR_TAG(TEMPS, "p-green")
TEMPS '= SET_BUTTON_TAG(TEMPS, "FUNC" + "," + "PLUGIN_SHORTCUTLIST_PAGE_CHANGE" + "," + "DOWN")

INFO_HEADER += TEMPS
INFO_HEADER += "SHORTCUT" + TOSTR(PLUGUIN_SHORTCUT_PAGENUM + 1)

TEMPS '= UNICODE(0x25B6) * 2
TEMPS '= SET_COLOR_TAG(TEMPS, "p-green")
TEMPS '= SET_BUTTON_TAG(TEMPS, "FUNC" + "," + "PLUGIN_SHORTCUTLIST_PAGE_CHANGE" + "," + "UP")
INFO_HEADER += TEMPS
INFO_HEADER += " " * 31

@INFO_FUNC_PLUGIN_SHORTCUTLIST_PAGE_CHANGE, ARGS, ARGS:1, ARGS:2, ARGS:3
IF ARGS == "UP"
	SIF ++PLUGUIN_SHORTCUT_PAGENUM == PLUGUIN_SHORTCUT_PAGEMAX
		PLUGUIN_SHORTCUT_PAGENUM = 0
ELSE
	SIF --PLUGUIN_SHORTCUT_PAGENUM < 0
		PLUGUIN_SHORTCUT_PAGENUM = PLUGUIN_SHORTCUT_PAGEMAX - 1
ENDIF
@GET_VAR_INFO_DATA_PLUGINSHORTCUT, ARG
#DIM LCOUNT
#DIMS DYNAMIC L_RESULTS
#DIMS DYNAMIC L_PLUGINNAME
#DIM DYNAMIC L_PLUGINNUM
L_RESULTS = 
FOR LCOUNT, 0, PLUGUIN_SHORTCUT_NUMMAX
	SIF LCOUNT
		L_RESULTS += " " * 2
	L_PLUGINNUM = PLUGUIN_SHORTCUT:PLUGUIN_SHORTCUT_PAGENUM:LCOUNT
	IF L_PLUGINNUM
		L_PLUGINNAME '= PLUGINNAME(L_PLUGINNUM)
		SIF STRLENS(L_PLUGINNAME) > 10
			L_PLUGINNAME '= SUBSTRING(L_PLUGINNAME, 0, 8) + ".."
		L_PLUGINNAME '= TOALIGNMENT(L_PLUGINNAME, 10, "CENTER")
		SIF EQUIP:ARG:악세서리 == L_PLUGINNUM
			L_PLUGINNAME '= SET_COLOR_TAG(L_PLUGINNAME, "p-green")
		CALLFORM EQ_装備可能確認, ARG, L_PLUGINNUM, GET_EQUIPNUM("악세서리")
		SIF !RESULT
			L_PLUGINNAME '= SET_COLOR_TAG(L_PLUGINNAME, "gray")
		CALL GET_TITLE_FOR_PLUGUIN, L_PLUGINNUM
		L_PLUGINNAME '= SET_BUTTON_TAG(L_PLUGINNAME, "FUNC" + "," + "PLUGIN_SHORTCUT_CHANGE" + "," + TOSTR(ARG) + "," + TOSTR(LCOUNT), "ALT + CLICK:단축키 변경" + UNICODE(0x000D) * 2 + RESULTS)
	ELSE
		L_PLUGINNAME '= TOALIGNMENT("ＥＭＰＴＹ", 10, "CENTER")
		L_PLUGINNAME '= SET_BUTTON_TAG(L_PLUGINNAME, "FUNC" + "," + "PLUGIN_SHORTCUT_CHANGE" + "," + TOSTR(ARG) + "," + TOSTR(LCOUNT), "ALT + CLICK:단축키 변경")
	ENDIF
	L_RESULTS += "[" + L_PLUGINNAME + "]"
NEXT
RESULTS '= L_RESULTS

@INFO_FUNC_PLUGIN_SHORTCUT_CHANGE, ARGS, ARGS:1, ARGS:2, ARGS:3
#DIM DYNAMIC L_LINE
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_PLUGINNUM
#DIM DYNAMIC L_PLUGUIN_SHORTCUTNUM
L_CHARA = TOINT(ARGS)
L_PLUGUIN_SHORTCUTNUM = TOINT(ARGS:1)
L_PLUGINNUM = PLUGUIN_SHORTCUT:PLUGUIN_SHORTCUT_PAGENUM:L_PLUGUIN_SHORTCUTNUM
IF (GETKEY(0x12) || GETKEY(0x05))
	DRAWLINE
	PRINTL 단축키 변경
	L_LINE = LINECOUNT
	WHILE 1
		CLEARLINE LINECOUNT - L_LINE
		CALL SHOW_PLUGIN_LIST, L_CHARA, "단축키 변경", L_PLUGUIN_SHORTCUTNUM
		PRINTL [998] EMPTY
		PRINTL [999] 취소
		INPUT
		SELECTCASE RESULT
			CASE 998
				PLUGUIN_SHORTCUT:PLUGUIN_SHORTCUT_PAGENUM:L_PLUGUIN_SHORTCUTNUM = 0
				BREAK
			CASE 999
				BREAK
			CASEELSE
				IF INRANGE(RESULT + MIN_PLUGINNUM, MIN_PLUGINNUM, MAX_PLUGINNUM) && ITEM:(RESULT + MIN_PLUGINNUM) > 0				
					PLUGUIN_SHORTCUT:PLUGUIN_SHORTCUT_PAGENUM:L_PLUGUIN_SHORTCUTNUM = RESULT + MIN_PLUGINNUM
					BREAK
				ENDIF
		ENDSELECT
	WEND
ELSE
	IF L_PLUGINNUM
		CALLFORM EQ_装備可能確認, L_CHARA, L_PLUGINNUM, GET_EQUIPNUM("악세서리")
		SIF !RESULT
			RETURN 0
	ENDIF
	EQUIP:L_CHARA:악세서리 = L_PLUGINNUM
ENDIF

@SHOW_PLUGIN_LIST, ARG, ARGS, ARG:1
#DIMS DYNAMIC TEMPS
#DIM DYNAMIC L_PLUGINNUM
#DIM DYNAMIC CNT_SHOW_PLUGIN
#DIMS DYNAMIC SHOW_LINE
#DIM DYNAMIC SHORTCUT_LIST, 25
#DIM DYNAMIC L_PLUGUIN_SHORTCUT_PAGENUM
#DIM DYNAMIC L_PLUGUIN_SHORTCUTNUM
#DIM LCOUNT
#DIM LSKILL_COUNT
#DIM TEMP_SKILL
#DIM TEMP_SKILL_LV
#DIM TEMP_SKILL_2
#DIM TEMP_SKILL_LV_2
;色変更用にショートカットに入っているものを一次元変数に格納
IF ARGS == "단축키 변경"
	FOR L_PLUGUIN_SHORTCUT_PAGENUM, 0, PLUGUIN_SHORTCUT_PAGEMAX
		FOR L_PLUGUIN_SHORTCUTNUM, 0, PLUGUIN_SHORTCUT_NUMMAX
			SHORTCUT_LIST:(L_PLUGUIN_SHORTCUT_PAGENUM * PLUGUIN_SHORTCUT_NUMMAX + L_PLUGUIN_SHORTCUTNUM) = PLUGUIN_SHORTCUT:L_PLUGUIN_SHORTCUT_PAGENUM:L_PLUGUIN_SHORTCUTNUM
		NEXT
	NEXT
ENDIF
;ソフト一覧
FOR L_PLUGINNUM, MIN_PLUGINNUM, MAX_PLUGINNUM
	SIF !ITEM:(L_PLUGINNUM)
		CONTINUE
	TEMPS = [{L_PLUGINNUM-MIN_PLUGINNUM,3}] %PLUGINNAME(L_PLUGINNUM), 24, LEFT%
	CALL GET_TITLE_FOR_PLUGUIN, L_PLUGINNUM
	TEMPS = <button value = '{L_PLUGINNUM - MIN_PLUGINNUM}' title = '%RESULTS%'>%TEMPS%</button>
	IF ARGS == "단축키 변경"
		;セットされているプラグイン
		IF MATCH(SHORTCUT_LIST, L_PLUGINNUM)
			IF PLUGUIN_SHORTCUT:PLUGUIN_SHORTCUT_PAGENUM:(ARG:1) == L_PLUGINNUM
				;選択中のショートカットにはいっているプラグイン
				TEMPS = %SET_COLOR_TAG(TEMPS, "aqua")%
			ELSE
				TEMPS = %SET_COLOR_TAG(TEMPS, "p-green")%
			ENDIF
		ENDIF
	ELSE
		CALL EQ_装備可能確認, ARG, L_PLUGINNUM, GET_EQUIPNUM("악세서리")
		SIF !RESULT
			TEMPS = %SET_COLOR_TAG(TEMPS, "gray")%
	ENDIF
	IF TALENT:ARG:인수라 && (L_PLUGINNUM >= 8200 && L_PLUGINNUM <= 8224)
		LSKILL_COUNT = 0
		TEMP_SKILL_2 = 0
		TEMP_SKILL_LV_2 = 0
		FOR LCOUNT,0,20
			RESULT = 0
			TRYCALLFORM P習得スキル_{L_PLUGINNUM},LCOUNT
			TEMP_SKILL = RESULT
			TEMP_SKILL_LV = RESULT:1
			LOCALS = 습득스킬{LSKILL_COUNT+1}
			LOCALS:2 = 습득LV{LSKILL_COUNT+1}
			;装備品に習得スキル&LVが存在してて、かつ習得経験が無いことが条件
			IF TEMP_SKILL > 0 && TEMP_SKILL_LV > 0 && !(CDFLAG:ARG:((L_PLUGINNUM)%5+1):((L_PLUGINNUM-8000)/5) & POWER(2,LCOUNT))
				IF TEMP_SKILL_LV > TEMP_SKILL_LV_2
					TEMP_SKILL_2 = TEMP_SKILL
					TEMP_SKILL_LV_2 = TEMP_SKILL_LV
					BREAK
				ENDIF
			ENDIF
		NEXT
		SIF TEMP_SKILL_LV_2 == 0
			TEMPS = %SET_COLOR_TAG(TEMPS, "#00BFFF")%
		SIF TEMP_SKILL_LV_2 <= BASE:ARG:LV
			TEMPS = %SET_COLOR_TAG(TEMPS, "#90EE90")%
	ENDIF
	SHOW_LINE += TEMPS
	IF CNT_SHOW_PLUGIN % 4 == 3
		HTML_PRINT SHOW_LINE
		SHOW_LINE = 
	ENDIF
	CNT_SHOW_PLUGIN++
NEXT
SIF SHOW_LINE != ""
	HTML_PRINT SHOW_LINE

@CHANGE_PLUGIN_SOFT, ARG
#DIM LINE, 1
#DIMS SHOW_LINE
#DIMS TEMPS
#LOCALSIZE 2
LINE = LINECOUNT
$CHOICE
CLEARLINE LINECOUNT-LINE
DRAWLINE
PRINTL 플러그인 변경
CALL SHOW_PLUGIN_LIST, ARG
PRINTL [999] 캔슬
$INPUT_LOOP2
INPUT
SIF RESULT == 999
	RETURN 0
LOCAL = RESULT + MIN_PLUGINNUM
IF !RANGE(LOCAL, MIN_PLUGINNUM, MAX_PLUGINNUM) || !ITEM:(LOCAL)
	GOTO INPUT_LOOP2
ENDIF
DRAWLINE
IF EQUIP:ARG:악세서리 > 0
	CALL 装備説明, EQUIP:ARG:악세서리, ARG
	PRINTL
	CUSTOMDRAWLINE ↓
	PRINTL
ENDIF
CALL 装備説明, LOCAL, ARG
CALLFORM 必要レベル_{LOCAL}
IF RESULT > BASE:ARG:LV
	PRINTFORMW 세트에 필요한 레벨이 부족합니다
	GOTO CHOICE
ENDIF
CALLFORM 装備条件_{LOCAL}, ARG
IF !RESULT
	PRINTFORMW 세트에 필요한 조건을 만족하지 않았습니다
	GOTO CHOICE
ENDIF
SIF !RESULT
	SETCOLOR COLOR("gray")
PRINTL 소프트를 변경하시겠습니까?
CALL INPUT_YN
SIF RESULT == 1
	GOTO CHOICE
PRINTFORMW %NAME:ARG%에게 %PLUGINNAME(LOCAL)%을(를) 세트했습니다
EQUIP:ARG:악세서리 = LOCAL
CALL SYNC_STATUS, ARG
RETURN 1

@LIST_PLUGIN_SOFT(ARG:0)
SIF !GET_ROLE_PROP("CAN_USE_PLUGIN",ARG:0)
	RETURN 0
