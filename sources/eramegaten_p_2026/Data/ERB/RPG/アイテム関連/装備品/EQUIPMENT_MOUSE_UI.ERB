;装備変更モードでは購買関係のUIを表示しない
SIF aMode != "EQUIP"
	LOCALS += MouseUIStore_ActiveColorBtn(TOALIGNMENT("단가", 12, "CENTER"), "Pri_0")
LOCALS += MouseUIStore_ActiveColorBtn(TOALIGNMENT("소지", 6, "CENTER"), "Pss_0")
