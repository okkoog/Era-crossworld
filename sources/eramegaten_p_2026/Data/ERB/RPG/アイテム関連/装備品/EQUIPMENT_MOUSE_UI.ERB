;-------------------------------------------------
;使用者の装備による変化
;-------------------------------------------------
@EQUIPMENT_MouseUIStore_Shows_UserStatus(aUserNo, aItemType, aItemNo, aTypeColor, ChangeList)
#LOCALSIZE 2
#LOCALSSIZE 7
#DIM REF ChangeList, 0, 0
#DIM aUserNo
#DIMS aItemType
#DIM aItemNo
#DIMS aTypeColor
#DIM DYNAMIC lEData, 31
#DIMS DYNAMIC lEDataS, 31
#DIM DYNAMIC lIData, 31
#DIMS DYNAMIC lIDataS, 31
#DIM lEquipNo
#DIM lEquipTypeNo
#DIM Diff
#DIMS DiffS
#DIM Color
IF aUserNo < 0
	RETURN 0
ENDIF
LOCALS:0 '= GETLINESTR("─") + "<br>"
SELECTCASE aItemType
	CASE "탄환"
		IF 0 <= aUserNo && EQUIP:aUserNo:총 != 0
			CALLFORM 特殊弾倉_{EQUIP:aUserNo:총}, aUserNo
			HTML_PRINT GETLINESTR("─") + "<br>" * (6 - (RESULT - 1) / 4)
		ELSE
			HTML_PRINT GETLINESTR("─") + "<br><br><br><br><br><br>"
		ENDIF
		RETURN 0
	CASE "アイテム", "調教アイテム"
		HTML_PRINT GETLINESTR("─") + "<br><br><br><br><br><br><br><br>"
		RETURN 0
	CASE "검", "총"
		LOCALS:0 += " "*8 + MouseUIStore_Shows_ItemList_HEAD_Detail(aItemType) + "<br>" + GETLINESTR("─") + "<br>"
		lEquipNo = EQUIP:aUserNo:aItemType
		CALLFORM MouseUIStore_ITEMDATA_%aItemType%(lEData, lEDataS, lEquipNo, aUserNo)
		CALLFORM MouseUIStore_ITEMDATA_%aItemType%(lIData, lIDataS, aItemNo, aUserNo)
		;装備変更（確定前）の装備は色を変える
		IF ChangeList:(CPOS(aUserNo)-1):MouseUIStore_ItemType_ToNo(aItemType) == -1
			LOCALS:1 '= " "*8 + MouseUIStore_Shows_ItemList_LINE_Detail(lEData, lEDataS, aItemType, "  ") + "<br>"
		ELSE
			LOCALS:1 '= MouseUIStore_HtmlColorS(" "*8 + MouseUIStore_Shows_ItemList_LINE_Detail(lEData, lEDataS, aItemType, "  "), "ACTIVE") + "<br>"
		ENDIF
		LOCALS:2 '= " "*8 + MouseUIStore_Shows_ItemList_LINE_Detail(lIData, lIDataS, aItemType, "❏") + "<br>"
		LOCALS:3 '= GETLINESTR("─") + "<br>"
		LOCALS:3 += " "*8 + " "*45
		FOR LOCAL, 3, 7
			Diff = lIData:LOCAL - lEData:LOCAL
			Color = GETDEFCOLOR()
			IF Diff < 0
				Color = COLOR("RED")
			ELSEIF 0 < Diff
				Color = COLOR("AQUA")
			ENDIF
			DiffS = {Diff}
			SIF 0 <= Diff
				DiffS = +%DiffS%
			LOCALS:3 += MouseUIStore_HtmlColor(TOALIGNMENT(@"%DiffS, 4, RIGHT%", 5, "CENTER"), Color)
		NEXT
		HTML_PRINT "<nobr>" + LOCALS:0 + LOCALS:1 + LOCALS:2 + LOCALS:3 + "<br><br>"
	CASE "머리","몸통", "팔", "발", "악세서리"
		FOR LOCAL, 0, 5
			lEquipNo = EQUIP:aUserNo:(GETNUM(EQUIP, "머리") + LOCAL)
			CALL MouseUIStore_ITEMDATA_防具(lEData, lEDataS, lEquipNo, aUserNo, aTypeColor)
			;装備変更（確定前）の装備は色を変える
			IF ChangeList:(CPOS(aUserNo)-1):(LOCAL+2) == -1
				LOCALS:(LOCAL + 1) '= " "*8 + MouseUIStore_Shows_ItemList_LINE_Detail(lEData, lEDataS, aItemType, "  ") + "<br>"
			ELSE
				LOCALS:(LOCAL + 1) '= MouseUIStore_HtmlColorS(" "*8 + MouseUIStore_Shows_ItemList_LINE_Detail(lEData, lEDataS, aItemType, "  "), "ACTIVE") + "<br>"
			ENDIF
		NEXT
		;表示中のカテゴリは最下部に
		LOCAL = GETNUM(EQUIP, aItemType) - GETNUM(EQUIP, "머리") + 1
		LOCALS:LOCAL '= ""
		CALL MouseUIStore_ITEMDATA_防具(lEData, lEDataS, EQUIP:aUserNo:aItemType, aUserNo, aTypeColor)
		CALL MouseUIStore_ITEMDATA_防具(lIData, lIDataS, aItemNo, aUserNo, aTypeColor)
		LOCALS:6 '= GETLINESTR("─") + "<br>"
		LOCALS:6 += MouseUIStore_HtmlColorS(" "*8 + MouseUIStore_Shows_ItemList_LINE_Detail(lEData, lEDataS, aItemType, "  "), "SELECTED") + "<br>"
		LOCALS:6 += MouseUIStore_HtmlColorS(" "*8 + MouseUIStore_Shows_ItemList_LINE_Detail(lIData, lIDataS, aItemType, "❏"), "SEEING") + "<br>"
		HTML_PRINT "<nobr>" + LOCALS:0 + LOCALS:1 + LOCALS:2 + LOCALS:3 + LOCALS:4 + LOCALS:5 + LOCALS:6
ENDSELECT


@EQUIPMENT_MouseUIStore_Shows_ItemList(rDisplays, rCart, aPerPage, aCategoryName, aCategory, aPage, aSelectedItem, aUserNo, aMode, aTypeColor, aCurEquip, aPrevEquip)
#LOCALSIZE 1
#LOCALSSIZE 3
#DIM REF rDisplays, 0, 0
#DIM aPerPage
#DIM REF rCart, 0, 0
#DIMS aCategoryName
#DIM aCategory
#DIM aPage
#DIM aSelectedItem
#DIM aUserNo
#DIMS aMode
#DIMS aTypeColor
#DIM lData, 31
#DIMS lDataS, 31
#DIM lPointer
#DIM aCurEquip
#DIM aPrevEquip
;ヘッダ
{
	LOCALS:0 '= GETLINESTR("━") + "<br>"
	 + MouseUIStore_Space() + EQUIPMENT_MouseUIStore_Shows_ItemList_HEAD(aCategoryName, aMode) + "<br>"
	 + GETLINESTR("─") + "<br>"
}
;リスト
LOCALS:1 '= ""
FOR lPointer, aPage*aPerPage - 2, aPage*aPerPage + aPerPage - 2
	;アイテム欄の最初の二つは特別なコマンドにする
	IF lPointer == -2
		IF aPrevEquip == -1
			LOCALS:1 += MouseUIStore_Space()*5 + MouseUIStore_HtmlColorS("【되돌리기】" + " "*91, "NONACTIVE") + "<br>"
		ELSE
			LOCALS:1 += MouseUIStore_Space()*5 + MouseUIStore_ActiveColorBtn("【되돌리기】" + " "*91, "und_0") + "<br>"
		ENDIF
	ELSEIF lPointer == -1
		IF aCurEquip == 0
			LOCALS:1 += MouseUIStore_Space()*5 + MouseUIStore_HtmlColorS("【해제】" + " "*91, "NONACTIVE") + "<br>"
		ELSE
			LOCALS:1 += MouseUIStore_Space()*5 + MouseUIStore_ActiveColorBtn("【해제】" + " "*91, "ueq_0") + "<br>"
		ENDIF
	ELSEIF rDisplays:aCategory:lPointer
		SELECTCASE aCategoryName
			CASE "머리", "몸통", "팔", "발", "악세서리"
				CALL MouseUIStore_ITEMDATA_防具(lData, lDataS, rDisplays:aCategory:lPointer, aUserNo, aTypeColor)
			CASEELSE
				CALLFORM MouseUIStore_ITEMDATA_%aCategoryName%(lData, lDataS, rDisplays:aCategory:lPointer, aUserNo)
		ENDSELECT
		SIF 改造装備(rDisplays:aCategory:lPointer)
			lDataS:0 '= 改造装備名称(改造装備番号(rDisplays:aCategory:lPointer))
		IF lPointer == aSelectedItem
			LOCALS:1 += MouseUIStore_Space() + MouseUIStore_Shows_ItemList_LINE(lData, lDataS, aCategoryName, lPointer, rCart:aCategory:lPointer, "SELECTED", aMode) + "<br>"
		ELSE
			LOCALS:1 += MouseUIStore_Space() + MouseUIStore_Shows_ItemList_LINE(lData, lDataS, aCategoryName, lPointer, rCart:aCategory:lPointer, "", aMode) + "<br>"
		ENDIF
	ELSE
		LOCALS:1 += "<br>"
	ENDIF
NEXT
;ページめくり
LOCALS:2 '= MouseUIStore_Space()
IF aPage > 0
	LOCALS:2 += MouseUIStore_ActiveColorBtn("▲PREV▲", "scr_0")
ELSE
	LOCALS:2 += MouseUIStore_HtmlColorS("▲PREV▲", "NONACTIVE")
ENDIF
LOCALS:2 += MouseUIStore_Space()
VARSIZE rDisplays
IF (aPage*aPerPage + aPerPage - 2) < RESULT:1 && rDisplays:aCategory:(aPage*aPerPage + aPerPage - 2) > 0
	LOCALS:2 += MouseUIStore_ActiveColorBtn("▼NEXT▼", "scr_1")
ELSE
	LOCALS:2 += MouseUIStore_HtmlColorS("▼NEXT▼", "NONACTIVE")
ENDIF
LOCALS:2 += "<br>"
HTML_PRINT "<nobr>" + LOCALS:0 + LOCALS:1 + LOCALS:2


@EQUIPMENT_MouseUIStore_Shows_ItemList_HEAD(aCategoryName, aMode)
#FUNCTIONS
#LOCALSSIZE 1
#DIMS aCategoryName
#DIMS aMode
VARSET LOCALS
IF aMode == "BUY"
	LOCALS '= TOALIGNMENT("구입", 9, "CENTER")
ELSEIF aMode == "TRADEIN" || aMode == "SELL"
	LOCALS '= TOALIGNMENT("매각", 9, "CENTER")
ELSEIF aMode == "EQUIP"
	;pass
ELSE
	THROW %aMode%은(는) 알 수 없는 매매 형식입니다。
