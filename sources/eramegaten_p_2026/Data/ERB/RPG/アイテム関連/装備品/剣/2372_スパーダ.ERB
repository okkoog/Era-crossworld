@装備追加スキル_2372,ARG,ARG:1 = -1
IF ARG:1 > -1 && ARG:1 == GETCHARA([[キャラ:트리쉬_DMC]])
	SELECTCASE ARG
		CASE 0
			RETURN [[스킬:데빌트리거]]
		CASE 1
			RETURN [[스킬:라운드트립]]
	ENDSELECT
ENDIF
RETURN 0

