;======================================================
;装備品のデータ：魔神皇殺し
;======================================================
;秋山ノブの受胎アイテム（「昔使っていた剣をやるよ」って感じのアレ）
;ノブが現在Lv30加入なので、Lv60くらいが適正の装備として設計
;ハザマを殺した武器なので、ハザマによく効く……としたかったが、さすがに範囲が狭すぎる……
;よって、『魔神皇ハザマ』を含む超人全般に強くなるよう、スキル「인간특효」を作成し追加（対象種族：人間・狂人・超人）
;======================================================
;漫画『真・女神転生if... 学園の悪魔使い』においてノブが持っていた幅広の両刃剣。
;作中では特に名前はついていない。
;名付けるとしたら、ノブが持っていたから『ノブの剣』、
;ノブの友達のスミオくんが持ってたのをもらったので『スミオの剣』、
;これでハザマにトドメを刺したので『마신황죽이기』……と迷って、ドスの効いた名前に
;======================================================

@基本能力修正_2373,ARG,ARG:1 = -1
	;BASE:LVは補正しない
	SIF !ARG
		RETURN 0
	RETURN 3

@戦闘能力修正_2373,ARG,ARG:1 = -1
	SELECTCASE ARG
		CASE 0
			;Lv70武器に匹敵するレベルの攻撃
			RETURN 228
		CASE 1
			;Lv70武器に匹敵するレベルの命中
			RETURN 203
		CASE 4
			;カスの魔法威力（なんとアタックナイフより低い）
			RETURN 10
		CASE 5
			;ダメダメな魔法効果
			RETURN 32
	ENDSELECT
	RETURN 0

@防御相性_2373,ARG,ARG:1 = -1
	SELECTCASE ARG
	ENDSELECT
	RETURN 100

@バステ耐性_2373,ARG,ARG:1 = -1
	SELECTCASE ARG
	ENDSELECT
	RETURN 0

;剣撃相性で射程Sで単体攻撃
@攻撃相性_2373, ARG = -1
	RETURN 0

@最低攻撃回数_2373, ARG = -1
	RETURN 1

@最大攻撃回数_2373, ARG = -1
	RETURN 1

@射程_2373, ARG = -1
	RETURN 1

@攻撃範囲_2373, ARG = -1
	RETURN 1

@装備箇所_2373
	RETURN GET_EQUIPNUM("검")

@装備追加スキル_2373,ARG,ARG:1 = -1
;	SIF ARG:1 == -1
;		RETURN 0
	SELECTCASE ARG
		CASE 0
			RETURN [[스킬:인간특효]]
	ENDSELECT

	RETURN 0

;-----------------------------
;- ショップ
;-----------------------------
@購入条件_2373
	;受胎アイテムのため不可
	RETURN 0

@必要レベル_2373
	RETURN 60

@装備条件_2373,ARG
	;LV60未満だとダメ
	;SIF BASE:ARG:LV < 60
	;	RETURN 0

	RETURN 1

@装備条件説明_2373
	;PRINTL 装備条件：LV60～

@装備解説_2373
	PRINTL 마신황에 의해 떨어진 마계에서 아키야마 노부가 손에 넣은 무명의 양날검.
	PRINTL 마신황을 토벌한 검이며, 깊이 배어든 신비가 인간에 대한 살상 능력을 높이고 있다.
	;PRINTL 
	;PRINTL 追加スキル:【인간특효】
	RETURN 0

@剣タイプ_2373
;1 = 刀　2 =레이피어　3 = 弓　　　　4 = 검　5 = 槍　　　6 = 斧、鈍器
;7 = 채찍　8 =投具　　　9 = 杖、祭具　10= 棍　11= 拳闘具
RETURN 4

@引継ぎ可不可_2373
RETURN 1