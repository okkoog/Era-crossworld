@戦闘能力修正_2220,ARG,ARG:1
IF ARG == -1 || ARG:1 == -1
	SELECTCASE ARG
	;공격
	CASE 0
		RETURN 0
	;명중
	CASE 1
		RETURN 0
	;마법위력
	CASE 4
		RETURN 0
	;마법효과
	CASE 5
		RETURN 0
	ENDSELECT
ELSEIF ARG >= 0 || ARG:1 >= 0
SELECTCASE ARG
	;공격
	CASE 0
	SIF ARG:1 == -1
	RETURN 0
		LOCAL = 0 + MIN(((MAXBASE:(ARG:1):LV ) * 3/2) + (ABL:(ARG:1):기교 * 1) , 200) + MIN(((FLAG:촉수레벨) / 5) , 20)
		RETURN LOCAL
	;명중
	CASE 1
	SIF ARG:1 == -1
	RETURN 0
		LOCAL = 0 + MIN(((MAXBASE:(ARG:1):LV ) * 7/5) + (ABL:(ARG:1):기교 * 2) , 180) + MIN(((FLAG:촉수레벨) / 5) , 20)
		RETURN LOCAL
	;마법위력
	CASE 4
	SIF ARG:1 == -1
	RETURN 0
		LOCAL = 0 + MIN(((MAXBASE:(ARG:1):LV ) * 7/5) + (ABL:(ARG:1):기교 * 1) , 190) + MIN(((FLAG:촉수레벨) / 5) , 20)
		RETURN LOCAL
	;마법효과
	CASE 5
	SIF ARG:1 == -1
	RETURN 0
		LOCAL = 0 + MIN(((MAXBASE:(ARG:1):LV ) * 1/1) + (ABL:(ARG:1):기교 * 1) , 100) + MIN(((FLAG:촉수레벨) / 5) , 20)
		RETURN LOCAL
ENDSELECT
ELSE
	RETURN 0
ENDIF


