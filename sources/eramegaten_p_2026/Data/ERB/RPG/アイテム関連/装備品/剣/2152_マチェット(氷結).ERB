@戦闘能力修正_2152,ARG,ARG:1 = -1
#DIM TEMP, 2
CALLFORM 剣タイプ_2152
TEMP = RESULT
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), GET_ARMS_TYPE(TEMP), 5 + 2)
	CASE "명중"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), GET_ARMS_TYPE(TEMP), 5 + 2)
	CASE "마법위력"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), GET_ARMS_TYPE(TEMP), 5 - 2)
	CASE "마법효과"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), GET_ARMS_TYPE(TEMP), 5 - 1)
	CASEELSE
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), GET_ARMS_TYPE(TEMP), 5)
ENDSELECT

