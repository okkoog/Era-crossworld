@戦闘能力修正_2090,ARG,ARG:1 = -1
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "채찍", 20 - 2)
	CASE "명중"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "杖・祭具", 20 - 4)
	CASE "마법위력"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "杖・祭具", 20 - 4)
	CASE "마법효과"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "레이피어", 20 + 0)
	CASEELSE
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "杖・祭具", 20)
ENDSELECT
