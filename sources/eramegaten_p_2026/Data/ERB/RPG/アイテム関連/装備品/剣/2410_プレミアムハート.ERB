@基本能力修正_2410,ARG,ARG:1 = -1
;1-힘　2-지혜　3-마력　4-내구　5-속도　6-운
SELECTCASE GET_BASESTATUS(ARG)
	CASE "힘"
		RETURN 3
	CASE "속도"
		RETURN 3
ENDSELECT
RETURN 0
 
@戦闘能力修正_2410,ARG,ARG:1 = -1
;80だと上限なので数値加算に
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "拳闘具", 80) + 10
	CASE "명중"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "拳闘具", 80) + 5
	CASE "마법위력"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "검", 80) + 10
	CASE "마법효과"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "검", 80) + 5
	CASEELSE
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "拳闘具", 80)
ENDSELECT
RETURN 0
 
