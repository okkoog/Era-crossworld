@戦闘能力修正_2100,ARG,ARG:1 = -1
#DIM TEMP, 2
CALLFORM 剣タイプ_2100
TEMP = RESULT
;標準的な係数としてLv1あたりの変動幅以下の通り
;攻・魔威は2 ~ 2.5
;命中は1.5 ~ 2
;魔攻は0.75 ~ 1
;
;ドロップ装備はとりあえず+3レベル前後の範囲程度で
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), GET_ARMS_TYPE(TEMP), 5 - 3)
	CASE "명중"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), GET_ARMS_TYPE(TEMP), 5 + 1)
	CASE "마법위력"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), GET_ARMS_TYPE(TEMP), 5 + 3)
	CASE "마법효과"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), GET_ARMS_TYPE(TEMP), 5 + 6)
	CASEELSE
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), GET_ARMS_TYPE(TEMP), 5)
ENDSELECT

