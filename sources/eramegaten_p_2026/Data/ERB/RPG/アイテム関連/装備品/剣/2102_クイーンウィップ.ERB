@基本能力修正_2102,ARG,ARG:1 = -1
SELECTCASE ARG
	CASE 1
		IF ARG:1 > -1
			SELECTCASE TALENT:(ARG:1):새드
				CASE 0
					RETURN 0
				CASE 1
					RETURN 1
			ENDSELECT
		ELSE
			RETURN 0
		ENDIF
ENDSELECT
RETURN 0


@戦闘能力修正_2102,ARG,ARG:1 = -1
IF ARG:1 == -1 || TALENT:(ARG:1):새드
	SELECTCASE ARG
		CASE 0
			RETURN 113
		CASE 1
			RETURN 126
		CASE 3
			RETURN 5
		CASE 4
			RETURN 165
		CASE 5
			RETURN 60
	ENDSELECT
ELSE
	SELECTCASE ARG
		CASE 0
			RETURN 56
		CASE 1
			RETURN 63
		CASE 3
			RETURN -15
		CASE 4
			RETURN 82
		CASE 5
			RETURN 25
	ENDSELECT
ENDIF
RETURN 0

