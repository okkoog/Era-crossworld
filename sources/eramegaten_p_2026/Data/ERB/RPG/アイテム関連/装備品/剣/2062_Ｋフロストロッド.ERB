;氷の壁、絶対零度、ブフダイン、大冷界→アイスエイジ・マハブフバリオン・大冷界
;仕様上3つまでしか追加できないので変更。さらに縛りの厳しさを考慮してスキルのランクを上昇
@装備追加スキル_2062,ARG,ARG:1 = -1
;IF ARG:1 != -1 && ABL:(ARG:1):종족 == 36
IF ARG:1 >= 0
	IF ITEMNAME:(EQUIP:(ARG:1):머리) == "Ｋ프로스트가발" && ITEMNAME:(EQUIP:(ARG:1):몸통) == "Ｋ프로스트망토" && ITEMNAME:(EQUIP:(ARG:1):팔) == "Ｋ프로스트미튼" && ITEMNAME:(EQUIP:(ARG:1):발) == "Ｋ프로스트부츠"
		SELECTCASE ARG
			CASE 0
				RETURN [[스킬:아이스에이지]]
			CASE 1
				RETURN [[스킬:마하・부흐바리온]]
			CASE 2
				RETURN [[스킬:마술의소양]]
;			CASE 3
;				RETURN 817
		ENDSELECT
	ENDIF
ENDIF
RETURN 0

