@戦闘能力修正_2097,ARG,ARG:1 = -1
;宝箱アイテムなので若干つよく
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "拳闘具", 5 + 2)
	CASE "명중"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "拳闘具", 5)
	CASE "마법위력"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "拳闘具", 5)
	CASE "마법효과"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "拳闘具", 5 + 2)
	CASEELSE
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "拳闘具", 5)
ENDSELECT
