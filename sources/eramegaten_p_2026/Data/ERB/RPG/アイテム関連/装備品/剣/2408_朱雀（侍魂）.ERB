@戦闘能力修正_2408,ARG,ARG:1 = -1
SELECTCASE ARG
	CASE 0
		SIF ARG:1 == -1
			RETURN 288
		LOCAL = 195
		IF NO:(ARG:1) == [[キャラ:카즈키]]
			;LOCAL += 93 * (MIN(MAX(51,MAXBASE:(ARG:1):LV),70) - 50) / 20
			LOCAL += 93 * LIMIT(MAXBASE:(ARG:1):LV - 50, 1, 20) / 20
		ELSEIF ABL:(ARG:1):속성LC == 3 && MAXBASE:(ARG:1):LV > 69
			SIF TALENT:(ARG:1):아픔에강함
				LOCAL += 20
			SIF TALENT:(ARG:1):솔직함
				LOCAL += 10
			SIF TALENT:(ARG:1):해방
				LOCAL += 50
			SIF ABL:(ARG:1):속성LD == 2
				LOCAL += 13
		ENDIF
		RETURN LOCAL
	CASE 1
		SIF ARG:1 == -1
			RETURN 141
		LOCAL = 101
		IF NO:(ARG:1) == [[キャラ:카즈키]]
			;LOCAL += MIN(MAX(50,MAXBASE:(ARG:1):LV),70) - 50 * 2
			LOCAL += LIMIT(MAXBASE:(ARG:1):LV - 50, 0, 20) * 2
		ELSEIF ABL:(ARG:1):속성LC == 3 && MAXBASE:(ARG:1):LV > 69
			SIF TALENT:(ARG:1):솔직함
				LOCAL += 40
		ENDIF
		RETURN LOCAL
	CASE 4
		RETURN 106
	CASE 5
		SIF ARG:1 == -1
			RETURN 80
		LOCAL = 50
		IF NO:(ARG:1) == [[キャラ:카즈키]]
			;LOCAL += 163 * (MIN(MAX(51,MAXBASE:(ARG:1):LV),70) - 50) / 20
			;LOCAL += MIN(MAX(50,MAXBASE:(ARG:1):LV),70) - 50 * 3/2
			LOCAL += LIMIT(MAXBASE:(ARG:1):LV - 50, 0, 20) * 3 / 2
		ELSEIF ABL:(ARG:1):속성LC == 3 && MAXBASE:(ARG:1):LV > 69
			SIF TALENT:(ARG:1):아픔에강함
				LOCAL += 30
		ENDIF
		RETURN LOCAL
ENDSELECT
RETURN 0

