;======================================================
;이시키리카네미츠
;秋山凜子のステータスに比例する
;======================================================
@基本能力修正_2377,ARG,ARG:1 = -1
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = GETCHARA([[キャラ:아키야마린코]])
SIF LOCAL < 0
	RETURN 0
SIF ARG:1 < 0
	RETURN 0
SIF ARG:1 == GETCHARA([[キャラ:아키야마린코]]) || (FAVORITE_1(LOCAL) == ARG:1 && 陥落(LOCAL))
	RETURN BASE:LOCAL:GET_BASESTATUS(ARG) / 10
RETURN 0
@戦闘能力修正_2377,ARG,ARG:1 = -1
#LOCALSIZE 3
LOCAL = GETCHARA([[キャラ:아키야마린코]])
LOCAL:1 = 0
LOCAL:2 = 10
;剣のレベル設定。凜子が陥落している場合、凜子のレベルの半分が加算される
SIF ARG:1 >=0 && LOCAL >= 0 && (NO:(ARG:1) == [[キャラ:아키야마린코]] || 陥落(LOCAL, ARG:1))
	LOCAL:2 += MIN(BASE:LOCAL:LV / 2, 10)
LOCAL:2 += 5
;レベルによる戦闘能力値
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		LOCAL:1 = LOCAL:2 * 3/2
	CASE "명중"
		LOCAL:1 = LOCAL:2
	CASE "마법위력"
		LOCAL:1 = LOCAL:2 * 3/2
	CASE "마법효과"
		LOCAL:1 = LOCAL:2
ENDSELECT
;STATUSによる能力値　凜子陥落でステータスによって性能が加算される
IF ARG:1 >= 0 && (NO:(ARG:1) == [[キャラ:아키야마린코]] || (LOCAL >=0 && 陥落(LOCAL, ARG:1)))
	SELECTCASE GET_BATTLESTATUS(ARG)
		CASE "공격"
			LOCAL:1 +=  BASE:(ARG:1):힘*3/2 + BASE:(ARG:1):내구 / 2
		CASE "명중"
			LOCAL:1 += BASE:(ARG:1):속도*3/2 + BASE:(ARG:1):운/2
		CASE "마법위력"
			LOCAL:1 += BASE:(ARG:1):마력*3/2 + BASE:(ARG:1):지혜 / 2
		CASE "마법효과"
			LOCAL:1 += BASE:(ARG:1):지혜 + BASE:(ARG:1):운/2 + BASE:(ARG:1):마력/2
	ENDSELECT
ENDIF
;剣仕様に変更
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		TIMES LOCAL:1, 1.10
	CASE "명중"
		LOCAL:1 += 10
	CASE "마법위력"
		TIMES LOCAL:1, 1.00
	CASE "마법효과"
		TIMES LOCAL:1, 0.30
ENDSELECT
;最低ステータスは十徳刀と同程度
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		RETURN MAX(50, LOCAL:1)
	CASE "명중"
		RETURN MAX(50, LOCAL:1)
	CASE "마법위력"
		RETURN MAX(46, LOCAL:1)
	CASE "마법효과"
		RETURN MAX(15, LOCAL:1)
ENDSELECT
@防御相性_2377,ARG,ARG:1 = -1
SELECTCASE ARG
ENDSELECT
RETURN 100

