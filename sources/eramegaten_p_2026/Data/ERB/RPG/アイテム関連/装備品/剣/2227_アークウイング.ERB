@戦闘能力修正_2227,ARG,ARG:1 = -1
SIF ARG:1 < 0 || EQUIP:(ARG:1):발 == 0
	RETURN 0
LOCAL = EQUIP:(ARG:1):발
TRYCCALLFORM 戦闘能力修正_{LOCAL},2,ARG:1
	LOCAL:1 = RESULT
	CALLFORM 戦闘能力修正_{LOCAL},3,ARG:1
	LOCAL:2 = RESULT
	CALLFORM 戦闘能力修正_{LOCAL},5,ARG:1
	LOCAL:3 = RESULT
	TRYCCALLFORM 必要レベル_{LOCAL}
		LOCAL:4 = RESULT
	CATCH
		LOCAL:4 = 1
	ENDCATCH
CATCH
	RETURN 0
ENDCATCH

SELECTCASE ARG
	;공격
	CASE 0
		RETURN LOCAL:1 * 4 + LOCAL:4
	;명중
	CASE 1
		RETURN LOCAL:2 * 3
	;마법위력
	CASE 4
		RETURN LOCAL:3 * 3 + LOCAL:4
	;마법효과
	CASE 5
		RETURN LOCAL:2 + LOCAL:3
ENDSELECT
RETURN 0

