;======================================================
;装備品のデータ：アナザーノルン
;======================================================
;漫画版デビチルルートクリア報酬
;LV50に対応したノルンの鍵……という塩梅の性能
;もとがLv1武器にしては強いので、調整の可能性大
;まあ、「ずーっとノルンの鍵持ってる」ってのも不健全なので……まあ一番デカいバージョンアップは「誰でも持てる」だと思うけど
;======================================================

@基本能力修正_2375,ARG,ARG:1 = -1

	;BASE:LVは補正しない
	SIF !ARG
		RETURN 0
	;全能力値＋５
	RETURN 5

@戦闘能力修正_2375,ARG,ARG:1 = -1

	;元々ノルンの鍵は、おそらく元々Lv50相当くらいの装備品なのよね……
	;攻撃力こそ低いけど、万能相性全体攻撃なので。
	;塩梅が難しい……調整の可能性ある……
	SELECTCASE ARG
		;공격
		CASE 0
			RETURN 150
		;명중
		CASE 1
			RETURN 150
		;방어
		CASE 2
			RETURN 0
		;회피
		CASE 3
			RETURN 0
		;魔法攻撃
		CASE 4
			RETURN 150
		;마법효과
		CASE 5
			RETURN 125
	ENDSELECT
	RETURN 0

@防御相性_2375,ARG,ARG:1 = -1
	SELECTCASE ARG
	ENDSELECT
	RETURN 100

;万能相性全体攻撃、2-3回。ノルンの鍵比、最大攻撃回数＋１。
@攻撃相性_2375, ARG = -1
	;万能相性
	RETURN 17

@最低攻撃回数_2375, ARG = -1
	RETURN 2

@最大攻撃回数_2375, ARG = -1
	RETURN 3

@射程_2375, ARG = -1
	RETURN 3

@攻撃範囲_2375, ARG = -1
	RETURN 3

@装備箇所_2375
	RETURN GET_EQUIPNUM("검")

@条件つき装備追加スキル_2375
	RETURN 0

;-----------------------------
;- ショップ
;-----------------------------
@購入条件_2375
	;不可
	RETURN 0

@必要レベル_2375
	RETURN 50

@装備条件_2375,ARG
	;誰でも装備できる
	RETURN 1

@装備条件説明_2375
	;なし

@装備解説_2375
	PRINTFORML 왕 된 열쇠에 걸린 안전장치.
	PRINTFORML 폭학한 왕을 퇴위시키는 반역의 열쇠.

@引継ぎ可不可_2375
	RETURN 1

@剣タイプ_2375
	;1 = 刀　2 =레이피어　3 = 弓　　　　4 = 검　5 = 槍　　　6 = 斧、鈍器
	;7 = 채찍　8 =投具　　　9 = 杖、祭具　10= 棍　11= 拳闘具
	RETURN 4
