;======================================================
;魔晶装備性能参照用関数
;======================================================
@基本能力修正_魔晶装備,ARG,ARG:1
RETURN DC:(ARG:1):ARG

@戦闘能力修正_魔晶装備,ARG,ARG:1
RETURN DC:(ARG:1):(10+ARG)

@銃攻撃_魔晶装備,ARG,ARG:1
RETURN 0
@銃命中_魔晶装備,ARG,ARG:1
RETURN 0
@防御相性_魔晶装備,ARG,ARG:1
RETURN DC:(ARG:1):(20+ARG)

@攻撃相性_魔晶装備,ARG
RETURN DC:ARG:40

@最低攻撃回数_魔晶装備,ARG
RETURN DC:ARG:41

@最大攻撃回数_魔晶装備,ARG
RETURN DC:ARG:42

@射程_魔晶装備,ARG
RETURN DC:ARG:43

@攻撃範囲_魔晶装備,ARG
RETURN DC:ARG:44

@追加効果_魔晶装備,ARG
RETURN DC:ARG:45
@追加効果相性_魔晶装備,ARG
RETURN DC:ARG:46
@追加効果命中率_魔晶装備,ARG
RETURN DC:ARG:47
@追加効果最大命中率_魔晶装備,ARG
RETURN DC:ARG:48

@装備追加スキル_魔晶装備,ARG,ARG:1
SELECTCASE ARG
	CASE 0
		RETURN DC:(ARG:1):53
	CASE 1
		RETURN DC:(ARG:1):54
	CASE 2
		RETURN DC:(ARG:1):55
ENDSELECT
RETURN 0



@装備箇所_魔晶装備,ARG
RETURN DC:ARG:39

@必要レベル_魔晶装備,ARG,ARG:1
SIF DC:(ARG:1):50 == 0
	RETURN 1
RETURN DC:(ARG:1):50

@装備条件_魔晶装備,ARG,ARG:1
SIF TALENT:ARG:석세서 == 0 || (DC:(ARG:1):50 > BASE:ARG:LV)
	RETURN 0
RETURN 1

@装備条件説明_魔晶装備,ARG,ARG:1
IF DC:(ARG):50 <= 1
	PRINTL 장비 조건: 석세서
ELSE
	PRINTFORML 장비 조건: 석세서　LV{DC:(ARG):50}～
ENDIF
