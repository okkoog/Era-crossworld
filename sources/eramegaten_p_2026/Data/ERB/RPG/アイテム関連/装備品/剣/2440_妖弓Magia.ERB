;終わる世界を追加すること踏まえて物理方面に強化を入れる
@戦闘能力修正_2440,ARG,ARG:1 = -1
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "弓", 80) + 15
	CASE "명중"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "弓", 80) + 15
	CASE "마법위력"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "弓", 80) - 15
	CASE "마법효과"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "弓", 80) - 5
	CASEELSE
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "弓", 80)
ENDSELECT
RETURN 0


