@戦闘能力修正_2158,ARG,ARG:1 = -1
SELECTCASE ARG
	CASE 0
		RETURN 229
	CASE 1
		LOCAL = 202
		SIF ARG:1 < 0
			RETURN LOCAL
		SIF EQUIP:(ARG:1):머리 == 0
			LOCAL += 30
		SIF EQUIP:(ARG:1):몸통 == 0
			LOCAL += 40
		SIF EQUIP:(ARG:1):팔 == 0
			LOCAL += 20
		RETURN LOCAL
	CASE 3
		LOCAL = 0
		SIF ARG:1 < 0
			RETURN LOCAL
		SIF EQUIP:(ARG:1):머리 == 0
			LOCAL += 30
		SIF EQUIP:(ARG:1):몸통 == 0
			LOCAL += 55
		SIF EQUIP:(ARG:1):팔 == 0
			LOCAL += 32
		RETURN LOCAL
	CASE 4
		RETURN 166
	CASE 5
		RETURN 56
ENDSELECT
RETURN 0

