;======================================================
;装備品のデータ
;히노카쿠츠치의검
;原作小説含めて、N島くん以外も使ってるし、装備制限自体はなしに
;ただ、N島くんが使うときは弓子のステに応じた基本ステ補正と自分と弓子のLVに応じて攻撃力・命中にボーナスをつけるように
;性能の計算は魔晶剣とほぼ同じで、持ち手のステータス
;この補正は弓子を陥落させている場合は好感度TOPのキャラにも発生する
;======================================================
@基本能力修正_2207,ARG,ARG:1 = -1
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = GETCHARA([[キャラ:유미코]])
SIF LOCAL < 0
	RETURN 0
SIF ARG:1 < 0
	RETURN 0
SIF ARG:1 == GETCHARA([[キャラ:아케미]]) || (FAVORITE_1(LOCAL) == ARG:1 && 陥落(LOCAL))
	RETURN BASE:LOCAL:GET_BASESTATUS(ARG) / 10
RETURN 0
@戦闘能力修正_2207,ARG,ARG:1 = -1
#LOCALSIZE 3
LOCAL = GETCHARA([[キャラ:유미코]])
LOCAL:1 = 0
LOCAL:2 = 40
;剣のレベル設定。弓子が陥落している場合、弓子のレベルの半分が加算される
SIF ARG:1 >=0 && LOCAL >= 0 && (NO:(ARG:1) == [[キャラ:아케미]] || 陥落(LOCAL, ARG:1))
	LOCAL:2 += MIN(BASE:LOCAL:LV / 2, 40)
LOCAL:2 += 5
;レベルによる戦闘能力値
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		LOCAL:1 = LOCAL:2 * 3/2
	CASE "명중"
		LOCAL:1 = LOCAL:2
	CASE "마법위력"
		LOCAL:1 = LOCAL:2 * 3/2
	CASE "마법효과"
		LOCAL:1 = LOCAL:2
ENDSELECT
;STATUSによる能力値　朱美ありは弓子陥落でステータスによって性能が加算される
IF ARG:1 >= 0 && (NO:(ARG:1) == [[キャラ:아케미]] || (LOCAL >=0 && 陥落(LOCAL, ARG:1)))
	SELECTCASE GET_BATTLESTATUS(ARG)
		CASE "공격"
			LOCAL:1 +=  BASE:(ARG:1):힘*3/2 + BASE:(ARG:1):내구 / 2
		CASE "명중"
			LOCAL:1 += BASE:(ARG:1):속도*3/2 + BASE:(ARG:1):운/2
		CASE "마법위력"
			LOCAL:1 += BASE:(ARG:1):마력*3/2 + BASE:(ARG:1):지혜 / 2
		CASE "마법효과"
			LOCAL:1 += BASE:(ARG:1):지혜 + BASE:(ARG:1):운/2 + BASE:(ARG:1):마력/2
	ENDSELECT
ENDIF
;剣仕様に変更
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		TIMES LOCAL:1, 1.00
	CASE "명중"
		LOCAL:1 += 10
	CASE "마법위력"
		TIMES LOCAL:1, 0.80
	CASE "마법효과"
		TIMES LOCAL:1, 0.40
ENDSELECT
;最低でも40レベル剣の性能は保証される
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		RETURN MAX(107, LOCAL:1)
	CASE "명중"
		RETURN MAX(94, LOCAL:1)
	CASE "마법위력"
		RETURN MAX(85, LOCAL:1)
	CASE "마법효과"
		RETURN MAX(33, LOCAL:1)
ENDSELECT
@防御相性_2207,ARG,ARG:1 = -1
SELECTCASE ARG
ENDSELECT
RETURN 100

