;======================================================
;装備品のデータ：クシナダノツルギ
;======================================================
;コドクノマレビトルート：串蛇ルートクリア報酬
;本来はたぶん『アマノオハバリ』って名前なのだが、eraten実装シナリオでは「アマノオハバリ」を経由してないので……
;======================================================
;基本性能は串蛇のLVに依存し、串蛇のLv（か、Lv5）相当の性能になる
;Lv5ではアタックナイフ相当の性能
;======================================================

@基本能力修正_2374,ARG,ARG:1 = -1
#DIM KUSHI_NO
#DIM KUSHI_Lv
#DIM SPEC

	;BASE:LVは補正しない
	SIF !ARG
		RETURN 0
	KUSHI_NO = GETCHARA([[キャラ:쿠시나다]])
	IF 0
	;イベント中は限界突破
	ELSEIF イベントフラグ:41:0 == 5 && イベントフラグ:41:1 == 10 && イベントフラグ:41:12 == 3
		KUSHI_Lv = 200
	;串蛇がいない場合、またはLvが5未満の場合
	ELSEIF KUSHI_NO < 1 || BASE:KUSHI_NO:LV < 5
		;Lv5の性能で固定
		KUSHI_Lv = 5
	ELSE
		;串蛇のLvは80がマックス
		KUSHI_Lv = MIN(BASE:KUSHI_NO:LV,80)
	ENDIF

	;最終的には全能力＋３
	SPEC = 3 * KUSHI_Lv / 80
	RETURN SPEC

@戦闘能力修正_2374,ARG,ARG:1 = -1
#DIM KUSHI_NO
#DIM KUSHI_Lv
#DIM SPEC
	KUSHI_NO = GETCHARA([[キャラ:쿠시나다]])
	IF 0
	;イベント中は限界突破
	ELSEIF イベントフラグ:41:0 == 5 && イベントフラグ:41:1 == 10 && イベントフラグ:41:12 == 3
		KUSHI_Lv = 200
	;串蛇がいない場合、またはLvが5未満の場合
	ELSEIF KUSHI_NO < 1 || BASE:KUSHI_NO:LV < 5
		;Lv5の性能で固定
		KUSHI_Lv = 5
	ELSE
		;串蛇のLvは80がマックス
		KUSHI_Lv = MIN(BASE:KUSHI_NO:LV,80)
	ENDIF

	SELECTCASE ARG
		;공격
		CASE 0
			SPEC = 26 + (180 * KUSHI_Lv) / 80
			RETURN SPEC
		;명중
		CASE 1
			SPEC = 20 + (140 * KUSHI_Lv) / 80
			RETURN SPEC
		;방어
		CASE 2
			RETURN 0
		;회피
		CASE 3
			RETURN 0
		;魔法攻撃
		CASE 4
			SPEC = 21 + (140 * KUSHI_Lv) / 80
			RETURN SPEC
		;마법효과
		CASE 5
			SPEC = 6 + (100 * KUSHI_Lv) / 80
			RETURN SPEC
	ENDSELECT
	RETURN 0

@防御相性_2374,ARG,ARG:1 = -1
#DIM KUSHI_NO
	KUSHI_NO = GETCHARA([[キャラ:쿠시나다]])
	SELECTCASE GET_TYPE(ARG)
		CASE "파마"
			;串蛇がいる場合
			SIF KUSHI_NO > 0
				RETURN 0
		CASE "주살"
			;串蛇がいる場合
			SIF KUSHI_NO > 0
				RETURN 0
	ENDSELECT
	RETURN 100

@バステ耐性_2374,ARG,ARG:1 = -1
#DIM KUSHI_NO
	KUSHI_NO = GETCHARA([[キャラ:쿠시나다]])
	SELECTCASE ARG
		CASE GET_STATE_NUM("DYING")
			;串蛇がいる場合
			SIF KUSHI_NO > 0
				RETURN -100
	ENDSELECT
	RETURN 0

;破魔相性で射程Sで単体攻撃
@攻撃相性_2374, ARG = -1
	RETURN 10

