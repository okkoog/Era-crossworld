@装備追加スキル_2374,ARG,ARG:1 = -1
#DIM KUSHI_NO
	KUSHI_NO = GETCHARA([[キャラ:쿠시나다]])
	SIF ARG:1 == -1
		RETURN 0
	SELECTCASE ARG
		CASE 0
			;串蛇がいる場合、かつ装備者がサマナーLv5なら追加スキル
			SIF KUSHI_NO > 0 && TALENT:(ARG:1):서머너 >= 5
				RETURN [[스킬:나와라나의모든중마]]
	ENDSELECT

	RETURN 0

