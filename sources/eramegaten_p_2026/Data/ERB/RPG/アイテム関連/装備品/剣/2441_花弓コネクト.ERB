	CASE "지혜"
		RETURN 1
	CASE "마력"
		RETURN 1
ENDSELECT
RETURN 0

;受胎元が魔知型なので投具ベースに
;あとまぁ追加スキルがフィニトラなのでそちらにあわせる形に
@戦闘能力修正_2441,ARG,ARG:1 = -1
;80だと上限なので数値加算に
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "投具", 80) - 15
	CASE "명중"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "投具", 80) - 10
	CASE "마법위력"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "投具", 80) + 15
	CASE "마법효과"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "投具", 80) + 10
	CASEELSE
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "投具", 80)
ENDSELECT
RETURN 0

