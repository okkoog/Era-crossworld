@戦闘能力修正_2407,ARG,ARG:1 = -1
;80だと上限なので数値加算に
SELECTCASE GET_BATTLESTATUS(ARG)
	CASE "공격"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "레이피어", 80) - 25
	CASE "명중"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "레이피어", 80) + 15
	CASE "마법위력"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "投具", 80) - 5
	CASE "마법효과"
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "레이피어", 80) + 5
	CASE "회피"
		RETURN 15
	CASEELSE
		RETURN EQ_戦闘ステータス生成(GET_BATTLESTATUS(ARG), "레이피어", 80)
ENDSELECT
RETURN 0

