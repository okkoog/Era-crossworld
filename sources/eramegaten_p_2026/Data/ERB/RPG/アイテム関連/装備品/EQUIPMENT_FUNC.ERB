;=================================================
;   sub EQ_射程名称
;=================================================
;   EQ:射程名称
;-------------------------------------------------
; Input:
;  ARG					사거리
; Output:
;  RETURNF				명칭
;-------------------------------------------------
@EQ_射程名称(ARG)
#FUNCTIONS

SELECTCASE ARG
	CASE 1
		RETURNF "Ｓ"
	CASE 2
		RETURNF "Ｍ"
	CASE 3
		RETURNF "Ｌ"
	CASE 4
		RETURNF "S+"
	CASEELSE
		;- 引っかからない場合はERROR
		RETURNF "E!"
ENDSELECT
;------- MOD 003 ADD START -----------------------
;=================================================
;   sub EQUIPMENT_CHECK
;=================================================
;   EQ:EQUIPMENT_CHECK(そのキャラが装備してるかのチェック)
;-------------------------------------------------
; Input:
;  ARG					キャラ番号
;  ARG:1				装備番号
; Output:
;  RETURNF				0-装備してない
;						1-装備してる
;-------------------------------------------------
@EQUIPMENT_CHECK(ARG,ARG:1)
#FUNCTION
FOR LOCAL,10,17
	SIF EQUIP:ARG:LOCAL == ARG:1
		RETURNF 1
	SIF 改造装備(EQUIP:ARG:LOCAL) && ARG:1 == ベース装備番号:改造装備番号(EQUIP:ARG:LOCAL)
		RETURNF 1
NEXT
RETURNF 0

;=================================================
;   sub EQUIPMENT_COUNT
;=================================================
;   EQ:EQUIPMENT_COUNT(装備してる人数のチェック)
;-------------------------------------------------
; Input:
;  ARG					装備番号
; Output:
;  RETURNF				装備者の人数
;-------------------------------------------------
@EQUIPMENT_COUNT(ARG)
#FUNCTION
LOCAL:1 = 0
FOR LOCAL,0,CHARANUM
	SIF EQUIPMENT_CHECK(LOCAL,ARG)
		LOCAL:1 ++
NEXT
RETURNF LOCAL:1

;------- MOD 003 ADD END   -----------------------
;=================================================
;   sub EQ_装備可能確認
;=================================================
;   指定されたキャラが指定された装備を利用できるか取得する
;-------------------------------------------------
; Input:
;  ARG					キャラクター登録番号
;  ARG:1				装備番号
;  ARG:2				装備箇所
; Output:
;  RESULT				装備が可能なら真
;-------------------------------------------------
@EQ_装備可能確認(ARG,ARG:1,ARG:2)
#DIM LCOUNT
#DIM L_RESULT, 2
#DIMS TEMPS
#DIM L_TALENT_LV
#DIMS L_TALENT
;ARG:0 装備キャラ
;ARG:1 アイテム番号
;ARG:2 装備箇所
IF 魔晶装備(ARG:1)
	TRYCCALLFORM 装備条件_魔晶装備,ARG,ARG:1 - 2450 - 450 * ARG:2
		RETURN RESULT
	CATCH
		RETURN 0
	ENDCATCH
ELSE
	SELECTCASE GET_EQUIP(ARG:2)
		CASE "총"
			SIF !GET_ROLE_PROP("CAN_EQUIP_GUN", ARG)
				RETURN 0
		CASE "탄환"
			;特殊弾の判定
			TRYCCALLFORM 弾レベル_{ARG:1}
				SIF GET_BTL_TALENT_LV("건슬링거", ARG) < RESULT
					RETURN 0
			CATCH
			ENDCATCH
		CASE "악세서리"
			;プラグイン
			IF INRANGE(ARG:1, 8000, 8499)
				SIF !GET_ROLE_PROP("CAN_USE_PLUGIN", ARG)
					RETURN 0
			ELSE
				SIF !GET_ROLE_PROP("CAN_USE_EQUIP", ARG)
					RETURN 0
			ENDIF
		CASEELSE
			SIF !GET_ROLE_PROP("CAN_USE_EQUIP", ARG)
				RETURN 0
	ENDSELECT
	;必要レベルのチェック
	CALL EQ_必要レベル取得, ARG, ARG:1, ARG:2
	SIF BASE:ARG:LV < RESULT
		RETURN 0
	;必要ステータスのチェック
	CALL EQ_必要ステータス取得, ARG, ARG:1, ARG:2
	IF RESULT
		L_RESULT = RESULT
		L_RESULT:1 = 0
		FOR LCOUNT, 0, STRCOUNT(RESULTS, "/") + 1
			SELECTCASE RESULTS:1 
				CASE "合計"
					L_RESULT -= BASE:ARG:AUTO_SPLIT(RESULTS, "/", LCOUNT)
					;ひいていって0以下になったら合計値がこえていることになる
					SIF L_RESULT > 0
						CONTINUE
					L_RESULT:1 = 1
					BREAK
				CASE "OR", "いずれか" 
					SIF BASE:ARG:AUTO_SPLIT(RESULTS, "/", LCOUNT) < L_RESULT
						CONTINUE
					L_RESULT:1 = 1
					BREAK
				CASE "AND", "すべて"
					;抜けたときに真となるのでここで設定する
					L_RESULT:1 = 1
					SIF BASE:ARG:AUTO_SPLIT(RESULTS, "/", LCOUNT) >= L_RESULT
						CONTINUE
					L_RESULT:1 = 0
					BREAK
			ENDSELECT
		NEXT
		SIF !L_RESULT:1
			RETURN 0
	ENDIF
	;必要素質のチェック
	CALL EQ_必要素質取得, ARG, ARG:1, ARG:2
	IF RESULT
		L_RESULT = RESULT
		L_RESULT:1 = 0
		FOR LCOUNT, 0, STRCOUNT(RESULTS, "/") + 1
			TEMPS '= AUTO_SPLIT(RESULTS, "/", LCOUNT)
			L_TALENT = %AUTO_SPLIT(TEMPS, "_", 0)%
			L_TALENT_LV = MAX(TOINT(AUTO_SPLIT(TEMPS, "_", 1)), 1)
			SELECTCASE RESULTS:1
				CASE "OR", "いずれか"
					IF GET_SUB_ROLE_NUM(L_TALENT) >= 0
						SIF GET_BTL_TALENT_LV(L_TALENT, ARG) < L_TALENT_LV
							CONTINUE
					ELSE
						SIF TALENT:ARG:L_TALENT < L_TALENT_LV
							CONTINUE
					ENDIF
					L_RESULT:1 = 1
					BREAK
				CASE "AND", "すべて"
					;抜けたときに真となるのでここで設定する
					L_RESULT:1 = 1
					IF GET_SUB_ROLE_NUM(L_TALENT) >= 0
						SIF GET_BTL_TALENT_LV(L_TALENT, ARG) >= L_TALENT_LV
							CONTINUE
					ELSE
						SIF TALENT:ARG:L_TALENT >= L_TALENT_LV
							CONTINUE
					ENDIF
					L_RESULT:1 = 0
					BREAK
			ENDSELECT
		NEXT
		SIF !L_RESULT:1
			RETURN 0
	ENDIF
	;性別制限のチェック
	CALL EQ_性別制限取得, ARG, ARG:1, ARG:2
	IF RESULT
		SIF RESULT:1 && !IS_LOOKSLIKE_MALE(ARG)
			RETURN 0
		SIF RESULT:2 && IS_LOOKSLIKE_MALE(ARG)
			RETURN 0
	ENDIF

	TRYCCALLFORM 装備条件_{ARG:1},ARG
		RETURN RESULT
	CATCH
		RETURN 0
	ENDCATCH
ENDIF

;=================================================
;   sub EQ_必要レベル取得
;=================================================
;   指定された装備の必要レベルを返す
;-------------------------------------------------
; Input:
;  ARG					キャラクター登録番号(省略された場合はキャラクターによる補正をかける前の数値を返す)
;  ARG:1				装備番号
;  ARG:2				装備箇所(省略された場合は自動的に取得する)
; Output:
;  RESULT				キャラクター補正済みの必要レベル
;  RESULT:1				キャラクター補正前の必要レベル
;-------------------------------------------------
@EQ_必要レベル取得(ARG = -1, ARG:1, ARG:2 = -1)
#DIM L_RESULT, 2
RESULT = 0
TRYCALLFORM 必要レベル_{ARG:1}
L_RESULT = RESULT, RESULT
IF ARG:2 < 0
	TRYCCALLFORM 装備箇所_{ARG:1}
		ARG:2 = RESULT
	CATCH
	ENDCATCH
ENDIF
;キャラ未指定の場合は補正処理をせずに終わる
SIF ARG < 0
	RETURN L_RESULT, L_RESULT
;---- EDIT 009 ADD START -------------------------
;装備固有の軽減処理
TRYCCALLFORM 必要レベル軽減_{ARG:1}, ARG
	SIF RESULT > 0
		L_RESULT -= RESULT
CATCH
ENDCATCH
;---- EDIT 009 ADD END ---------------------------
;装備種毎の特性
SELECTCASE GET_EQUIP(ARG:2)
	CASE "총"
		;銃はガンスリンガー所持で必要レベルが緩和される
		SIF GET_BTL_TALENT_LV("건슬링거", ARG) > 0
			L_RESULT -= 5
ENDSELECT
RETURN MAX(L_RESULT, 1), MAX(L_RESULT:1, 1)

;=================================================
;   sub EQ_必要ステータス取得取得
;=================================================
;   指定された装備の必要素質を返す
;-------------------------------------------------
; Input:
;  ARG					キャラクター登録番号(省略された場合はキャラクターによる補正をかける前の数値を返す)
;  ARG:1				装備番号
;  ARG:2				装備箇所(省略された場合は自動的に取得する)
; Output:
;  RESULT				必要なステータスの数値
;  RESULT:1				必要なステータスの数値(キャラクターによる補正をかけるまえ)
;  RESULTS				必要なステータスの定義(ステータス名/)
;  RESULTS:1			必要ステータスが複数ある場合に合計 ・ OR ・ AND で条件を定義
;-------------------------------------------------
@EQ_必要ステータス取得(ARG = -1, ARG:1, ARG:2 = -1)
#DIM L_RESULT, 2
RESULTS = 
RESULTS:1 = 
IF ARG:2 < 0
	TRYCCALLFORM 装備箇所_{ARG:1}
		ARG:2 = RESULT
	CATCH
	ENDCATCH
ENDIF
TRYCCALLFORM 必要ステータス_{ARG:1}
	;---- EDIT 009 ADD START -------------------------
	SIF RESULT <= 0
		RETURN 0
	L_RESULT = RESULT, RESULT
	SIF ARG < 0
		RETURN L_RESULT, L_RESULT
	;装備毎の軽減処理
	TRYCCALLFORM 必要ステータス軽減_{ARG:1}, ARG
		SIF RESULT > 0
			L_RESULT -= RESULT
	CATCH
	ENDCATCH
	;---- EDIT 009 ADD END ---------------------------
	;装備種毎の特性
	SELECTCASE GET_EQUIP(ARG:2)
		CASE "총"
			;銃はガンスリンガー所持で必要ステータスが緩和される
			SIF GET_BTL_TALENT_LV("건슬링거", ARG) > 0
				L_RESULT = L_RESULT * 80 / 100
			;機械の乙女は固定値で緩和される
			;---- EDIT 008 MOD START -------------------------
			;SIF (RESULTS:1 == "힘/내구") && (GET_BTL_TALENT_LV("기계의처녀", ARG) > 0)
			SIF (RESULTS == "힘/내구") && (GET_BTL_TALENT_LV("기계의처녀", ARG) > 0)
				L_RESULT -= 30
			;---- EDIT 008 MOD END ---------------------------
	ENDSELECT
	RETURN MAX(L_RESULT, 1), L_RESULT:1
CATCH
	RETURN 0
ENDCATCH

