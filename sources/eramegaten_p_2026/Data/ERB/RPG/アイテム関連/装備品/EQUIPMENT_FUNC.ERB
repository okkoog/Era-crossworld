;=================================================
;   sub EQ_装備解説
;=================================================
;   LVと装備種を指定して標準的な戦闘ステータスを生成する
;   性能値自体はRev148段階の強めの装備とそうずれないようにする
;   式変更で改定する予定
;-------------------------------------------------
; Input:
;  EQ_ST					戦闘ステータス
;  EQ_TYPE					装備種
;  EQ_LV					LV
;-------------------------------------------------
@EQ_戦闘ステータス生成, EQ_ST, EQ_TYPE, EQ_LV
#FUNCTION
#DIM TEMP
#DIM L_RESULT
#DIMS EQ_ST
#DIMS EQ_TYPE
#DIM EQ_LV
#DIM BASE_ST
#DIM VAR_BT_ST_MULTI, GUN_BATTLESTATUSNUM
#DIM CONST ADD_LV = 5;補正レベル
#DIM CONST MAX_LV = 80;一応上限をきっておく(システム側でこれ以上のレベルに対して補正をあたえだすので)

;レベルの補正を入れる(装備を5レベル刻み目安にするので基本はLV5の差となる)
EQ_LV = MIN(EQ_LV, MAX_LV) + ADD_LV
;合計ステータス(小数点以下を扱えないので100倍を入れておく)
BASE_ST = (EQ_LV * 100 * 3 / 2 + 1800)
;各ステータス
BASE_ST = BASE_ST / 6

;ステータスの補正 悪魔がMAGでステータスを伸ばしていると仮定してのステータス
;ゲームが進行するほど悪魔のステータスの偏りが大きくなるのを見込んでここの係数をずらす
;仕様的に合計値は人間が安定して高く、個々の数値の特化は悪魔が有利…になるはず
;将来的にはステータス1点の伸びを同じにしてこの措置をいらないようにすべき
;160%~240%+αを想定
BASE_ST = BASE_ST * (160 + EQ_LV) / 100

;基準値の算出
;レベル点
SELECTCASE EQ_ST
	CASE "공격", "마법위력"
		L_RESULT = EQ_LV * 300 / 2
	CASEELSE
		L_RESULT = EQ_LV * 200 / 2
ENDSELECT
;ステータス点
SELECTCASE EQ_ST
	CASE "방어"
		L_RESULT += BASE_ST * 5 / 2
	CASEELSE
		L_RESULT += BASE_ST * 2
ENDSELECT

;係数補正
SELECTCASE EQ_TYPE
							;공격 	명중	방어	회피	마법위력	마법효과
	CASE "검"
		VAR_BT_ST_MULTI = 	 110,	100,		0,		0,		90,			50
	CASE "刀"
		VAR_BT_ST_MULTI = 	 120,	 90,		0,		0,		65,			30
	CASE "레이피어"
		VAR_BT_ST_MULTI = 	  95,	120,		0,		0,		100,		70
	CASE "斧", "鈍器", "斧・鈍器"
		VAR_BT_ST_MULTI = 	 130,	 75,		0,		0,		60,			25
	CASE "棍"
		VAR_BT_ST_MULTI = 	 100,	105,		0,		0,		105,		55
	CASE "槍"
		VAR_BT_ST_MULTI = 	 110,	 95,		0,		0,		85,			40
	CASE "채찍"
		VAR_BT_ST_MULTI = 	 105,	 90,		0,		0,		110,		55
	CASE "弓"
		VAR_BT_ST_MULTI = 	 115,	 70,		0,		0,		95,			45
	CASE "投具"
		VAR_BT_ST_MULTI = 	  85,	100,		0,		0,		115,		60
	CASE "杖", "祭具", "杖・祭具"
		VAR_BT_ST_MULTI = 	  50,	 80,		0,		0,		130,		40
	CASE "拳闘具"
		VAR_BT_ST_MULTI = 	 115,	110,		0,		0,		80,			35
	CASE "その他武器"
		VAR_BT_ST_MULTI = 	  80,	 80,		0,	 	0,		80,			30

							;공격 	명중	방어	회피	마법위력	마법효과
	CASE "머리"
		VAR_BT_ST_MULTI = 	 	0,		0,	 20,	 15,		0,			20
	CASE "魔頭"
		VAR_BT_ST_MULTI = 	 	0,		0,	 10,	 10,		0,			25
	CASE "몸통"
		VAR_BT_ST_MULTI = 	 	0,		0,	 40,	 30,		0,			10
	CASE "魔胴"
		VAR_BT_ST_MULTI = 	 	0,		0,	 30,	 25,		0,			15
	CASE "팔"
		VAR_BT_ST_MULTI = 	 	0,		0,	 20,	 15,		0,			10
	CASE "魔腕"
		VAR_BT_ST_MULTI = 	 	0,		0,	 10,	 10,		0,			15
	CASE "발"
		VAR_BT_ST_MULTI = 	 	0,		0,	 20,	 40,		0,			10
	CASE "魔足"
		VAR_BT_ST_MULTI = 	 	0,		0,	 10,	 35,		0,			15
							;공격 	명중	방어	회피	마법위력	마법효과
	CASEELSE
		RETURNF 0
ENDSELECT
;係数をかける
IF EQ_ST == "合計値"
	TEMP = L_RESULT * (SUMARRAY(VAR_BT_ST_MULTI) - VAR_BT_ST_MULTI:GET_BATTLESTATUS_NUM("명중")) / 100
	;命中だけ数値變動が少なすぎるときに下限にする
	IF VAR_BT_ST_MULTI:GET_BATTLESTATUS_NUM(EQ_ST) >= 100
		L_RESULT = TEMP + MAX(L_RESULT * VAR_BT_ST_MULTI:GET_BATTLESTATUS_NUM(EQ_ST) / 100, L_RESULT + VAR_BT_ST_MULTI:GET_BATTLESTATUS_NUM(EQ_ST) - 100)
	ELSE
		L_RESULT = TEMP + MIN(L_RESULT * VAR_BT_ST_MULTI:GET_BATTLESTATUS_NUM(EQ_ST) / 100, L_RESULT + VAR_BT_ST_MULTI:GET_BATTLESTATUS_NUM(EQ_ST) - 100)
	ENDIF
ELSE
	IF EQ_ST == "명중"
		;命中だけ数値變動が少なすぎるときに下限にする
		IF VAR_BT_ST_MULTI:GET_BATTLESTATUS_NUM(EQ_ST) >= 100
			L_RESULT = MAX(L_RESULT * VAR_BT_ST_MULTI:GET_BATTLESTATUS_NUM(EQ_ST) / 100, L_RESULT + VAR_BT_ST_MULTI:GET_BATTLESTATUS_NUM(EQ_ST) - 100)
		ELSE
			L_RESULT = MIN(L_RESULT * VAR_BT_ST_MULTI:GET_BATTLESTATUS_NUM(EQ_ST) / 100, L_RESULT + VAR_BT_ST_MULTI:GET_BATTLESTATUS_NUM(EQ_ST) - 100)
		ENDIF
	ELSE
		L_RESULT = L_RESULT * VAR_BT_ST_MULTI:GET_BATTLESTATUS_NUM(EQ_ST) / 100
	ENDIF
ENDIF
;切り捨て対策部分を戻す
L_RESULT /= 100
RETURNF L_RESULT
;---- EDIT 010 ADD END ---------------------------


;=================================================
;   sub EQ_売却価格
;=================================================
;   装備の販売価格を算出する
;-------------------------------------------------
@EQ_売却価格, ARG
#DIM L_PRICE
#DIM L_LV
#DIM L_RANK
;価格1と0は売却不能となる
SIF ITEMPRICE:ARG <= 1
	RETURN 0

RESULT = 0
;購入条件でジャンク品かどうかを判別する
;※条件を満たしていないジャンク品も含まれるのに注意
TRYCALLFORM 購入条件_{ARG}
IF !RESULT
	TRYCCALLFORM 必要レベル_{ARG}
		L_LV = RESULT
		L_RANK = LIMIT(L_LV / 5, 0, PAYMENT_MAXRANK() - 1)
		;納金価格から算出する
		L_PRICE = GET_PAYMENT_TABLE_FOR_NEXT_RANK(L_RANK)
		TIMES L_PRICE, 0.02
		;端数レベルの補正
		L_PRICE = L_PRICE * ((L_LV - L_RANK * 5) * 2 + 100) / 100
		TRYCCALLFORM 装備箇所_{ARG}
			SELECTCASE GET_EQUIP(RESULT)
				CASE "검"
					TIMES L_PRICE, 1.00
				CASE "머리"
					TIMES L_PRICE, 0.50
				CASE "몸통"
					TIMES L_PRICE, 0.80
				CASE "손"
					TIMES L_PRICE, 0.50
				CASE "발"
					TIMES L_PRICE, 0.40
				CASE "악세서리"
					TIMES L_PRICE, 0.45
				CASEELSE
					TIMES L_PRICE, 0.50
			ENDSELECT
		CATCH
		ENDCATCH
		;端数処理
		L_PRICE /= 10
		L_PRICE *= 10
		RETURN L_PRICE
	CATCH
		RETURN ITEMPRICE:ARG / 2
	ENDCATCH
ENDIF
RETURN ITEMPRICE:ARG / 2


