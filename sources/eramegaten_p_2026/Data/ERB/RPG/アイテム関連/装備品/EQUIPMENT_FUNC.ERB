;=================================================
;   sub EQ_性別制限取得
;=================================================
;   指定された装備の性別制限を返す
;-------------------------------------------------
; Input:
;  ARG					キャラクター登録番号(省略された場合はキャラクターによる補正をかける前の数値を返す)
;  ARG:1				装備番号
;  ARG:2				装備箇所(省略された場合は自動的に取得する)
; Output:
;  RESULT				性別の制限が設定されているならば真
;  RESULT:1				男性のみ装備可能ならば真
;  RESULT:2				女性のみ装備可能ならば真
;-------------------------------------------------
@EQ_性別制限取得(ARG = -1, ARG:1, ARG:2 = -1)
IF ARG:2 < 0
	TRYCCALLFORM 装備箇所_{ARG:1}
		ARG:2 = RESULT
	CATCH
	ENDCATCH
ENDIF
TRYCCALLFORM 性別制限_{ARG:1}
	;装備種毎の特性
	SELECTCASE GET_EQUIP(ARG:2)
		CASE "총"
	ENDSELECT
	RESULT:1 = (RESULT == 1)
	RESULT:2 = (RESULT == 2)
	RETURN RESULT:1 || RESULT:2
CATCH
	RETURN 0
ENDCATCH

;=================================================
;   sub EQ_装備条件説明
;=================================================
;   装備プロパティから装備条件の説明を生成して表示する
;-------------------------------------------------
; Input:
;  ARG					装備番号
;  ARG:1				キャラクター登録番号(省略された場合はキャラクターによる補正をかける前の数値を返す)
;  ARG:2				装備箇所(省略された場合は自動的に取得する)
;-------------------------------------------------
@EQ_装備条件説明, ARG, ARG:1 = -1, ARG:2 = -1
#DIM LCOUNT
#DIMS L_LV
#DIMS L_TALENT
#DIM L_RESULT, 2
#DIMS TEMPS
#DIMS L_STATUS
IF ARG:2 < 0
	TRYCCALLFORM 装備箇所_{ARG}
		ARG:2 = RESULT
	CATCH
	ENDCATCH
ENDIF
;装備種毎の特性
L_TALENT = 
L_STATUS = 
SELECTCASE GET_EQUIP(ARG:2)
	;他装備品も追加
	CASE "검", "총", "머리", "몸통", "팔", "발", "악세서리"
		CALL EQ_必要レベル取得, ARG:1, ARG, ARG:2
		IF RESULT != RESULT:1
			L_LV = {RESULT}({RESULT:1})
		ELSE
			L_LV = {RESULT}
		ENDIF
		CALL EQ_必要素質取得, ARG:1, ARG, ARG:2
		IF RESULT
			FOR LCOUNT, 0, STRCOUNT(RESULTS, "/") + 1
				IF LCOUNT > 0
					IF RESULTS:1 == "AND"
						L_TALENT += " & "
					ELSE
						L_TALENT += "　"
					ENDIF
				ENDIF
				TEMPS = %AUTO_SPLIT(RESULTS, "/", LCOUNT)%
				IF STRCOUNT(TEMPS, "_")
					L_TALENT += @"[%AUTO_SPLIT(TEMPS, "_", 0)%Lv%AUTO_SPLIT(TEMPS, "_", 1)%]"
				ELSE
					L_TALENT += @"[%TEMPS%]"
				ENDIF
			NEXT
		ENDIF
		CALL EQ_必要ステータス取得, ARG:1, ARG, ARG:2
		IF RESULT
			L_RESULT = RESULT, RESULT:1
			FOR LCOUNT, 0, STRCOUNT(RESULTS, "/") + 1
				SIF LCOUNT > 0
					L_STATUS += "・"
				L_STATUS += AUTO_SPLIT(RESULTS, "/", LCOUNT)
			NEXT
			IF STRCOUNT(L_STATUS, "・")
				SELECTCASE RESULTS:1
					CASE "合計", "합계"
						L_STATUS += @"의 합계치"
					CASE "OR", "いずれか", "어느하나"
						L_STATUS += @" 중 어느 하나"
					CASE "AND", "すべて", "모두"
						L_STATUS += @" 모두"
				ENDSELECT
			ENDIF
			IF L_RESULT != L_RESULT:1
				L_STATUS += @"가 {L_RESULT}({L_RESULT:1}) 이상"
			ELSE
				L_STATUS += @"가 {L_RESULT} 이상"
			ENDIF
		ENDIF
		PRINTFORM 필요 레벨:%L_LV%　
		SIF L_TALENT != ""
			PRINTFORM 　필요 소질:%L_TALENT%
		IF L_STATUS != ""
			PRINTL 
			PRINTFORM 필요 능력치:%L_STATUS%
		ENDIF
		CALL EQ_性別制限取得, ARG:1, ARG, ARG:2
		IF RESULT
			SIF RESULT:1
				PRINT 　성별 제한：♂
			SIF RESULT:2
				PRINT 　성별 제한：♀
		ENDIF
		PRINTL 
	CASE "탄환"
		CALLFORM 弾レベル_{ARG}
		PRINTFORML 필요소질:건슬링거Lv{RESULT}
ENDSELECT
TRYCCALLFORM 装備条件説明_{ARG}
CATCH
ENDCATCH
RETURN RESULT

;=================================================
;   sub EQ_装備解説
;=================================================
;   装備プロパティから装備条件の説明を生成して表示する
;-------------------------------------------------
; Input:
;  ARG					装備番号
;  ARG:1				キャラクター登録番号(省略された場合はキャラクターによる補正をかける前の数値を返す)
;  ARG:2				装備箇所(省略された場合は自動的に取得する)
;  ARG:3				速度のためにボタン作製を省く
;-------------------------------------------------
@EQ_装備解説, ARG, ARG:1 = -1, ARG:2 = -1, ARG:3
#DIM LCOUNT, 3
#DIM L_RESULT, 3
#DIM L_SKILLNUM
#DIMS L_TITLE
#DIMS TEMPS
#DIMS SHOW_LINE, 20
#DIM SHOW_LINE_NUM
#DIMS L_SPLIT, 10
#DIMS L_SKILLS, 10
#DIM L_LINE, 2
#DIM L_FORNUM
#DIM STCOK_U
L_LINE = LINECOUNT
IF ARG:2 < 0
	TRYCCALLFORM 装備箇所_{ARG}
		ARG:2 = RESULT
	CATCH
	ENDCATCH
ENDIF
VARSET SHOW_LINE
VARSET L_SKILLS
STCOK_U = U
TRYCCALLFORM 装備解説_{ARG}
CATCH
ENDCATCH
TRYCCALLFORM 引継ぎ可不可_{ARG}
	SIF RESULT == 0
		PRINT 【인계 불가】
CATCH
ENDCATCH
TRYCCALLFORM 最大所持数_{ARG}
	SIF RESULT > 0
		PRINTFORM 【소지수 제한:{RESULT}】
CATCH
ENDCATCH
SIF !LINEISEMPTY()
	PRINTL 
SELECTCASE GET_EQUIP(ARG:2)
	CASE "악세서리"
		IF INRANGE(ARG, MIN_PLUGINNUM, MAX_PLUGINNUM - 1)
			PRINTL 
			CALLFORM 必要レベル_{ARG}
			PRINTFORML 필요 레벨:{RESULT}
			CALLFORM 増加CP_{ARG}
			PRINTFORML CP 보정:\@RESULT < 0 ?－#＋\@{ABS(RESULT)}\%
		ENDIF
ENDSELECT


;条件つきのものは装備解説にかかせる
TRYCCALLFORM 条件つき装備追加スキル_{ARG}
CATCH
	VARSET L_RESULT;EDIT 007 ADD
	FOR LCOUNT, 0, 3
		TRYCCALLFORM 装備追加スキル_{ARG}, LCOUNT;EDIT 007 MOD
			SIF !RESULT
				CONTINUE
			SIF MATCH(L_RESULT, RESULT)
				CONTINUE
			L_RESULT:LCOUNT = RESULT
			IF LCOUNT == 0
				SIF !INRANGE(ARG, MIN_PLUGINNUM, MAX_PLUGINNUM - 1)
					PRINTL 
				PRINT 추가스킬：
			ELSE
				PRINT ,
			ENDIF
			PRINTFORM 【%SKILL_NAME_F(RESULT)%】
		CATCH
		ENDCATCH
	NEXT
	SIF !LINEISEMPTY()
		PRINTL 
ENDCATCH

SELECTCASE GET_EQUIP(ARG:2)
	CASE "검"
		CALL GET_DEVIL_ARMS_SKILL, ARG
		IF MATCH(RESULT, 0, 0, 3) < 3
			L_RESULT = RESULT, RESULT:1, RESULT:2
			SIF !STRCOUNT(HTML_GETPRINTEDSTR(0), "追加")
				PRINTL 
			PRINT 추가스킬:
			FOR LCOUNT, 0, 3
				SIF !L_RESULT:LCOUNT
					CONTINUE
				SIF LCOUNT
					PRINT ,
				PRINTFORM 【%SKILL_NAME_F(L_RESULT:LCOUNT)%】
			NEXT
			PRINTL 　추가조건:[데빌암즈]
		ENDIF
ENDSELECT

IF L_LINE != LINECOUNT
	L_FORNUM = LINECOUNT - L_LINE
	FOR LCOUNT, 0, L_FORNUM
		SHOW_LINE_NUM = L_FORNUM - LCOUNT - 1
		TEMPS = %HTML_TOPLAINTEXT(HTML_GETPRINTEDSTR(SHOW_LINE_NUM))%
		;---- EDIT 005 START END ---------------------------
		TEMPS = %HTML_ESCAPE(TEMPS)%
		;---- EDIT 005 ADD END -----------------------------
		SPLIT TEMPS, "【", L_SPLIT
		L_RESULT = RESULT
		IF L_RESULT > 1
			FOR LCOUNT:1, 0, L_RESULT
				;---- EDIT 006 MOD START -------------------------
				IF STRCOUNT(L_SPLIT:(LCOUNT:1), "】")
					L_SKILLS:(LCOUNT:1) = %AUTO_SPLIT(L_SPLIT:(LCOUNT:1), "】", 0)%
					L_SKILLNUM = SKILL_NUM_F(L_SKILLS:(LCOUNT:1))
					CALL GET_SKILL_EXPLAIN_TOOLTIP, L_SKILLNUM, ARG:1
					L_TITLE = %RESULTS%
					L_SKILLS:(LCOUNT:1) = <nonbutton title = '%L_TITLE%'>【%L_SKILLS:(LCOUNT:1)%】</nonbutton>
					SHOW_LINE:LCOUNT += L_SKILLS:(LCOUNT:1) + AUTO_SPLIT(L_SPLIT:(LCOUNT:1), "】", 1) 
				ELSE
					SHOW_LINE:LCOUNT += L_SPLIT:(LCOUNT:1)
				ENDIF
				;---- EDIT 006 MOD END ---------------------------
			NEXT
		ELSE
			SHOW_LINE:LCOUNT = %TEMPS%
		ENDIF
	NEXT
ENDIF
CLEARLINE LINECOUNT - L_LINE
FOR LCOUNT, 0, L_FORNUM
	HTML_PRINT SHOW_LINE:LCOUNT
NEXT
U = STCOK_U
RETURN L_LINE != LINECOUNT

