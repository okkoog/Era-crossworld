;======================================================
;専用装備防具（アクセサリも含む）
;벽색의뇌정　装備すると以下の効果を得る
;・電撃吸収
;・習得スキルが強化
;要は装備の影響で電撃弱点になるブレイドさんのための装備である
;ステータス補正とかはとくにない
;======================================================
 
@基本能力修正_5490, ARG, ARG:1 = -1
;1-힘　2-지혜　3-마력　4-내구　5-속도　6-운
RETURN 0
 
@戦闘能力修正_5490, ARG, ARG:1 = -1
;0-공격　1-명중　2-방어　3-회피　4-마법위력　5-마법효과
RETURN 0
 
@防御相性_5490, ARG, ARG:1 = -1
; 0-검격　 1-비구　 2-타격　 3-전술　 4-화염　 5-빙결　 6-전격　 7-충격　 8-신경　 9-정신
;10-파마　11-주살　12-지변　13-수격　14-질풍　15-중력　16-핵열　17-만능
SELECTCASE ARG
	;無効
	CASE 6
		RETURN -50
	;弱点
	CASE 13
		RETURN 125
	CASE 16
		RETURN 150
ENDSELECT
RETURN 100
 
@攻撃相性_5490, ARG = -1
RETURN 0
 
@バステ耐性_5490, ARG, ARG:1 = -1
; 1-HAPPY  幸福　 2-SHOCK 感電　 3-PANIC 混乱　 4-SLEEP 睡眠　 5-FREEZE 凍結
; 6-BIND   긴박　 7-CLOSE 魔封　 8-POISON　毒　 9-BOMB　爆弾　10-CHARM　魅了
;11-PALYZE 麻痺　12-CURSE 呪い　14-STONE 石化　15-DYING 即死　18-FLAME　炎上
;19-SLIP　 転倒　20-BEAND 낙인
RETURN 0
 
@最低攻撃回数_5490, ARG = -1
RETURN 0
 
@最大攻撃回数_5490, ARG = -1
RETURN 0
 
@射程_5490, ARG = -1
RETURN 0
 
@攻撃範囲_5490, ARG = -1
RETURN 0
 
@装備箇所_5490
RETURN GET_EQUIPNUM("악세서리") 

@最大所持数_5490
RETURN 1

@装備追加スキル_5490, ARG, ARG:1 = -1
SIF ARG:1 == -1
	RETURN 0
RETURN 0

;-----------------------------
;- ショップ
;-----------------------------
@装備条件_5490, ARG
SIF ARG < 0
	RETURN 0
SIF NO:ARG != [[キャラ:블레이드_X]]
	RETURN 0
RETURN 1
 
