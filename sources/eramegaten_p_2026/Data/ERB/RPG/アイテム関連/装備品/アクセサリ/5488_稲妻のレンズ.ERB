@基本能力修正_5488, ARG, ARG:1 = -1
;1-힘　2-지혜　3-마력　4-내구　5-속도　6-운
RETURN 0
 
@戦闘能力修正_5488, ARG, ARG:1 = -1
;0-공격　1-명중　2-방어　3-회피　4-마법위력　5-마법효과
RETURN 0
 
@防御相性_5488, ARG, ARG:1 = -1
; 0-검격　 1-비구　 2-타격　 3-전술　 4-화염　 5-빙결　 6-전격　 7-충격　 8-신경　 9-정신
;10-파마　11-주살　12-지변　13-수격　14-질풍　15-중력　16-핵열　17-만능
SELECTCASE ARG
	;無効
	CASE 6
		RETURN -50
	;弱点
	CASE 13
		RETURN 125
ENDSELECT
RETURN 100
 
@攻撃相性_5488, ARG = -1
RETURN 0
 
@バステ耐性_5488, ARG, ARG:1 = -1
; 1-HAPPY  幸福　 2-SHOCK 感電　 3-PANIC 混乱　 4-SLEEP 睡眠　 5-FREEZE 凍結
