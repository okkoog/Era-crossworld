@SKILL_SPEED_3009, ARG = -1
RETURN 5

;戦闘時以外に使用できるか
@SKILL_ACTIONABLE_FIELD_3009
RETURN 1

;スキル変化？用ランク
@SKILL_RANK_3009, ARG = -1
RETURN 0
;変化不可

@SKILL_IS_ITEMSKILL_3009
RETURN 1

;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3009, ARG, ARG:1, ARG:2

CALL SKILL_CURE_STATE_3009,CFLAG:(ARG:1):상태이상
	IF RESULT == 1
	PRINTFORMW %조사처리(CALLNAME:(ARG:1),"는")% 되살아났다
	CFLAG:(ARG:1):상태이상 = 0
	CFLAG:(ARG:1):상태이상경과턴수 = 0
	CALL VAR_HP,(ARG:1),MAXBASE:(ARG:1):ＨＰ
ENDIF

;====================================================
;実行内容ここまで
;====================================================


;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_3009,ARG,ARG:1,ARG:2
LOCAL = 30
PRINTW 반혼향을 사용했다.
CALL SKILL_CURE_STATE_3009,CFLAG:(ARG:1):상태이상
	IF RESULT == 1
	PRINTFORMW %조사처리(CALLNAME:(ARG:1),"는")% 되살아났다
	CFLAG:(ARG:1):상태이상 = 0
	CFLAG:(ARG:1):상태이상경과턴수 = 0
	CALL VAR_HP,(ARG:1),MAXBASE:(ARG:1):ＨＰ
ENDIF

;====================================================
;実行内容ここまで
