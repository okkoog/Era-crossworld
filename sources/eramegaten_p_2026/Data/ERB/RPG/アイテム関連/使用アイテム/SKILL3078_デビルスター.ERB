;スキル及び行動の実行
;====================================================
@ACTION_3078, ARG, ARG:1, ARG:2
;ARG 使用者　ARG:1 対象
IF HAVE_SKILL(POS(ARG:1), [[스킬:데빌트리거]])
	CALL PRINT_HIT_MESSAGE, POS(ARG:1), "50회복"
	CALL SKILLGAGE_F_ADD, POS(ARG:1), [[스킬:데빌트리거]],50
ELSE
	CALL PRINT_HIT_MESSAGE, POS(ARG:1), "효과없음"
ENDIF

