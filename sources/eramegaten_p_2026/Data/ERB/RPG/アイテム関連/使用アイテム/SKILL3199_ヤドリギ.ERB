;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3199, ARG, ARG:1, ARG:2
#LOCALSIZE 1
#DIM MISTLETOE_DAMAGE
LOCAL = POS(ARG:1)
IF NO:LOCAL != [[キャラ:벨・데르]]
	PRINTW 효과가 없다！
	RETURN 0
ENDIF


;難易度上昇などで敵HPが異常に多い場合の対策
;相手の最大HPの５～６％のダメージ
;カジャンダ全開だと20％チョイのダメージになるが、特効アイテムだしよかんべ
MISTLETOE_DAMAGE = MAXBASE:LOCAL:ＨＰ
MISTLETOE_DAMAGE *= 500 + RAND:100
MISTLETOE_DAMAGE /= 10000

MISTLETOE_DAMAGE += 50 + BASE:ARG:LV * 5 + RAND:20
IF CFLAG:ARG:공격강화 > 0
	MISTLETOE_DAMAGE = MISTLETOE_DAMAGE * (32 + CFLAG:ARG:공격강화) / 32
ELSE
	MISTLETOE_DAMAGE = MISTLETOE_DAMAGE * MIN(64 + CFLAG:ARG:공격강화, 32) / 64
ENDIF
IF CFLAG:LOCAL:방어강화 > 0
	MISTLETOE_DAMAGE = MISTLETOE_DAMAGE * MIN(64 - CFLAG:LOCAL:방어강화, 32) / 64
ELSE
	MISTLETOE_DAMAGE = MISTLETOE_DAMAGE * (32 - CFLAG:LOCAL:방어강화) / 32
ENDIF

;MISTLETOE_DAMAGE *= (32 + CFLAG:ARG:공격강화)
;MISTLETOE_DAMAGE /= (32 + CFLAG:LOCAL:방어강화)

PRINTFORMW TARGET:[{ARG:1, 2}] %CALLNAME:LOCAL,20,LEFT%　>>>>>>　{MISTLETOE_DAMAGE}데미지
CALL VAR_HP, LOCAL, - MISTLETOE_DAMAGE, "食いしばり無効ダメージ"
