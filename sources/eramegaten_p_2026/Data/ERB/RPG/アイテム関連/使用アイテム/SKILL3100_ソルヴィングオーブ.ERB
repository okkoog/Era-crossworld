;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3100, ARG, ARG:1, ARG:2



;====================================================
;実行内容ここまで
;====================================================


;====================================================
;戦闘中以外での実行
;====================================================
@ACTION_FIELD_3100,ARG,ARG:1,ARG:2
#LOCALSIZE 3
#DIM LIST, 100
LOCAL:1 = 0
VARSET LIST, -1
FOR LOCAL, MIN_LINKAGENUM, MAX_LINKAGENUM
	CALL GET_SKILL_PROP, "SKILL_NAME", LOCAL, -1
	SIF RESULTS == ""
		CONTINUE
	SIF GETBIT(FLAG:(1202+LOCAL / 63), LOCAL % 63)
		CONTINUE
	LIST:(LOCAL:1) = LOCAL
	SIF ++LOCAL:1 == 100
		BREAK
NEXT
IF LOCAL:1 == 0
	PRINTW 미지의 링케이지는 존재하지 않는 것 같다…
ELSE
	LOCAL = LIST:(RAND:(LOCAL:1))
	SETBIT FLAG:(1202+LOCAL / 63), LOCAL % 63
	CALL GET_SKILL_PROP, "SKILL_NAME", LOCAL, -1
	PRINTFORMW %조사처리(RESULTS,"를")% 애널라이즈했다！
	PRINTL 
	PRINTFORML [{LOCAL}] %RESULTS,20,LEFT%
	CALLFORM 参加人数_{LOCAL}
	FOR LOCAL:1, 1, RESULT + 2
		SIF LOCAL:1 > 1
			PRINT 　→　
		CALLFORM 参加条件表示_{LOCAL}, LOCAL:1
	NEXT
	PRINTL 
	PRINT 발동자 　
	CALL GET_SKILL_COST, LOCAL
	PRINTFORM %RESULTS, 11, LEFT%
	CALLFORM 参加人数_{LOCAL}
	LOCAL:1 = RESULT + 1
	FOR LOCAL:2, 1, LOCAL:1
		PRINTFORM 참가자{LOCAL:2}　
		CALLFORM リンケージコストタイプ_{LOCAL}, LOCAL:2
		IF RESULT == 2
			CALLFORM リンケージコスト_{LOCAL}, LOCAL:2
			PRINTFORM ＨＰ{RESULT,3}％　
		ELSE
			CALLFORM リンケージコスト_{LOCAL}, LOCAL:2
			PRINTFORM ＭＰ{RESULT,3}　　
		ENDIF
		SIF LOCAL:2 == 2
			PRINTL 
	NEXT
	SIF LOCAL:2 != 3
		PRINTL 
	CALL GET_SKILL_PROP, "SKILL_EXPLAIN", LOCAL, -1
	WAIT
	IF --ITEM:1100
		PRINTL 
		PRINTL 이어서、애널라이즈합니까？
		CALL INPUT_YN
		SIF !RESULT
			RESTART
	ENDIF
ENDIF

