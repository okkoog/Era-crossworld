;====================================================
;スキル及び行動の実行
;====================================================
@ACTION_3072, ARG, ARG:1, ARG:2
;回復量
LOCAL =  100

IF ARG:1 == 19
	LOCAL:7 = 1
	LOCAL:8 = 7
ELSE
	LOCAL:7 = 7
	LOCAL:8 = 17
ENDIF

FOR LOCAL:9,LOCAL:7,LOCAL:8
	LOCALS = 포지션{LOCAL:9}
	SIF FLAG:LOCALS < 0
		CONTINUE
	SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING"
		CONTINUE
	PRINTFORM 　　TARGET:[{LOCAL:9,2}] %CALLNAME:(FLAG:LOCALS),20,LEFT%　>>>>>>　
	PRINTFORMW {LOCAL}회복
	CALL VAR_HP,FLAG:LOCALS,LOCAL,"회복"
NEXT

