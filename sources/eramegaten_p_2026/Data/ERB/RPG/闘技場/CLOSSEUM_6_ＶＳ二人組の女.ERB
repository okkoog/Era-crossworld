;メアリの思考パターン
;ンダの数に応じた確率でデクンダ
;ターンの偶奇+行動の遇奇で回復+カジャンダ+壁or肉弾orドナムを行う
@SET_ACTION_COL_6_メアリ,ARG
#DIM LCOUNT, 2
#DIM L_KAJA_SUM
L_KAJA_SUM = 0
CFLAG:ARG:타겟 = -1
;カジャンダのマイナス補正を拾う
FOR LCOUNT:1, 7, 17
	SIF POS(LCOUNT:1) < 0
		CONTINUE
	FOR LCOUNT, 0, VARSIZE("KAJA_TABLE")
		L_KAJA_SUM -= MIN(CFLAG:POS(LCOUNT:1):LCOUNT, 0)
	NEXT
NEXT
IF RAND:100 < L_KAJA_SUM
	CFLAG:ARG:입력행동 = SKILL_NUM_F("데・쿤다")
ELSE
	IF CFLAG:ARG:행동한횟수 == 0
		IF FLAG:경과턴수 % 2 == 0
			SELECTCASE RAND:100
				CASE IS < 35
					CFLAG:ARG:입력행동 = SKILL_NUM_F("디아라마")
				CASE IS < 70
					CFLAG:ARG:입력행동 = SKILL_NUM_F("마카・카쟈")
				CASEELSE
					;壁の補助はネミッサの弱点にあわせる
					SELECTCASE 闘技場フラグ:6:1
						CASE 1
							IF POS(10) >= 0 && !CFLAG:POS(10):빙결무효화횟수
								CFLAG:ARG:입력행동 = SKILL_NUM_F("불의벽")
							ELSE
								CFLAG:ARG:입력행동 = SKILL_NUM_F("스쿠・카쟈")
							ENDIF
						CASE 2
							IF POS(10) >= 0 && !CFLAG:POS(10):화염무효화횟수
								CFLAG:ARG:입력행동 = SKILL_NUM_F("물의벽")
							ELSE
								CFLAG:ARG:입력행동 = SKILL_NUM_F("스쿠・카쟈")
							ENDIF
						CASE 3
							IF POS(10) >= 0 && !CFLAG:POS(10):수격무효화횟수
								CFLAG:ARG:입력행동 = SKILL_NUM_F("번개의벽")
							ELSE
								CFLAG:ARG:입력행동 = SKILL_NUM_F("스쿠・카쟈")
							ENDIF
					ENDSELECT
			ENDSELECT
		ELSE
			SELECTCASE RAND:100
				CASE IS < 35
					CFLAG:ARG:입력행동 = SKILL_NUM_F("메・디아라마")
				CASE IS < 70
					CFLAG:ARG:입력행동 = SKILL_NUM_F("스쿠・카쟈")
				CASEELSE
					SELECTCASE 闘技場フラグ:6:1
						CASE 1
							IF POS(10) >= 0 && !CFLAG:POS(10):수격무효화횟수
								CFLAG:ARG:입력행동 = SKILL_NUM_F("번개의벽")
							ELSE
								CFLAG:ARG:입력행동 = SKILL_NUM_F("스쿠・카쟈")
							ENDIF
						CASE 2
							IF POS(10) >= 0 && !CFLAG:POS(10):핵열무효화횟수
								CFLAG:ARG:입력행동 = SKILL_NUM_F("수정의벽")
							ELSE
								CFLAG:ARG:입력행동 = SKILL_NUM_F("스쿠・카쟈")
							ENDIF
						CASE 3
							IF POS(10) >= 0 && !CFLAG:POS(10):핵열무효화횟수
								CFLAG:ARG:입력행동 = SKILL_NUM_F("수정의벽")
							ELSE
								CFLAG:ARG:입력행동 = SKILL_NUM_F("스쿠・카쟈")
							ENDIF
					ENDSELECT
			ENDSELECT
		ENDIF
	ELSE
		IF FLAG:경과턴수 % 2 == 0
			SELECTCASE RAND:100
				CASE IS < 35
					CFLAG:ARG:입력행동 = SKILL_NUM_F("디아라마")
				CASE IS < 70
					CFLAG:ARG:입력행동 = SKILL_NUM_F("타룬・다")
				CASEELSE
