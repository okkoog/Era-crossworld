;メイン属性3種 + サブ属性2種でHPが減る毎に使うスキルが上等になっていくパターン
;闘技場かつダメージ属性がひとつなので、スキルの水準はそれなりに高め
@SET_ACTION_COL_6_ネミッサ,ARG
CFLAG:ARG:타겟 = -1
SELECTCASE 現HP割合(ARG)
	CASE IS < 25
		IF CFLAG:ARG:타인집중플래그
			CFLAG:ARG:입력행동 = SKILL_NUM_F("로마・카롤")
		ELSE
			SELECTCASE RAND:100
				CASE IS < 20
					CFLAG:ARG:입력행동 = SKILL_NUM_F("아기라오")
				;ロマが通常選択肢に入る
				CASE IS < 40
					IF CFLAG:ARG:행동한횟수 == 1
						CFLAG:ARG:입력행동 = SKILL_NUM_F("로마・카롤")
					ELSE
						CFLAG:ARG:입력행동 = SKILL_NUM_F("아기라오")
					ENDIF
				CASE IS < 75
					CFLAG:ARG:입력행동 = SKILL_NUM_F("마하・라기온")
				CASEELSE
					CFLAG:ARG:입력행동 = SKILL_NUM_F("마한마")
			ENDSELECT
		ENDIF
	CASE IS < 50
		IF CFLAG:ARG:타인집중플래그
			CFLAG:ARG:입력행동 = SKILL_NUM_F("로마・카롤")
		ELSE
			SELECTCASE RAND:100
				CASE IS < 50
					CFLAG:ARG:입력행동 = SKILL_NUM_F("아기라오")
				CASE IS < 75
					CFLAG:ARG:입력행동 = SKILL_NUM_F("마하・라기온")
				CASEELSE
					IF RAND:2
						CFLAG:ARG:입력행동 = SKILL_NUM_F("한마")
					ELSE
						CFLAG:ARG:입력행동 = SKILL_NUM_F("마한마")
					ENDIF
			ENDSELECT
		ENDIF
	CASEELSE
		IF CFLAG:ARG:타인집중플래그
			CFLAG:ARG:입력행동 = SKILL_NUM_F("마하・라기온")
		ELSE
			SELECTCASE RAND:100
				CASE IS < 75
					CFLAG:ARG:입력행동 = SKILL_NUM_F("아기라오")
				CASEELSE
					CFLAG:ARG:입력행동 = SKILL_NUM_F("한마")
			ENDSELECT
		ENDIF
ENDSELECT
;性格に応じて振り分ける
IF 闘技場フラグ:6:1 == 2
	SELECTCASE CFLAG:ARG:입력행동
		CASE SKILL_NUM_F("아기라오")
			CFLAG:ARG:입력행동 = SKILL_NUM_F("부흐라")
		CASE SKILL_NUM_F("마하・라기온")
			CFLAG:ARG:입력행동 = SKILL_NUM_F("마하・부흐라")
		CASE SKILL_NUM_F("로마・카롤")
			CFLAG:ARG:입력행동 = SKILL_NUM_F("로마・그랜드")
		CASE SKILL_NUM_F("한마")
			CFLAG:ARG:입력행동 = SKILL_NUM_F("무드")
		CASE SKILL_NUM_F("마한마")
			CFLAG:ARG:입력행동 = SKILL_NUM_F("마하무드")
	ENDSELECT
ENDIF
IF 闘技場フラグ:6:1 == 3
	SELECTCASE CFLAG:ARG:입력행동
		CASE SKILL_NUM_F("아기라오")
			CFLAG:ARG:입력행동 = SKILL_NUM_F("지온가")
		CASE SKILL_NUM_F("마하・라기온")
			CFLAG:ARG:입력행동 = SKILL_NUM_F("마하・지온가")
		CASE SKILL_NUM_F("로마・카롤")
			CFLAG:ARG:입력행동 = SKILL_NUM_F("로마・풀멘")
		CASE SKILL_NUM_F("한마")
			CFLAG:ARG:입력행동 = SKILL_NUM_F("마린카린")
		CASE SKILL_NUM_F("마한마")
			CFLAG:ARG:입력행동 = SKILL_NUM_F("메기도")
	ENDSELECT
ENDIF
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT
