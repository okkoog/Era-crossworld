@GET_COLOSSEUM_NAME_19
#FUNCTIONS
RESULTS_F '= "実験体少女A"
RETURNF RESULTS_F

@PLAYABLE_COLOSSEUM_19
SIF FLAG:투기장랭크 < 0
	RETURN 0
SIF FLAG:투기장명성 < 10
	RETURN 0
SIF 闘技場フラグ:19:0
	RETURN 0
RESULTS = 시합 랭크Ｅ　ＶＳ 실험체소녀A
RETURN 1

;====================
;内容
;====================
@COLOSSEUM_19
FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1
CALL MESSAGE_WINDOW, "", "＞투기장 중앙에서 소녀가 관객의 소란에도 아랑곳하지 않고/　중얼중얼 혼잣말을 읊조리고 있다", , , , , 4
CALL MESSAGE_WINDOW, "소녀", "…죽 …여…버 …린다…", , , , , 4
CALL MESSAGE_WINDOW, "소녀", "너　죽인다！", , , , , 4
CALL MESSAGE_WINDOW, "", @"＞시합 개시의 징 소리와 함께 소녀는 %CALLNAME:MASTER%에게 덤벼든다", , , , , 4
CALL MESSAGE_WINDOW, "", @"실험체 소녀A가 1체 나타났다！", , , , , 4

TSTR:전투이벤트패턴 = コロシアム_セラ
CALL SET_ENEMY,14,[[キャラ:세라]],20,0,1
NAME:(CHARANUM-1) = 실험체소녀A
CALLNAME:(CHARANUM-1) = 실험체소녀A

CALL SET_BATTLE_STATUS(CHARANUM - 1, 75, "ＨＰ")

CFLAG:(CHARANUM-1):속도보정 += 10
CFLAG:(CHARANUM-1):행동횟수 = 2
CFLAG:(CHARANUM-1):초기링크악마 = [[キャラ:바루나니_링크전용]]

CSTR:(CHARANUM-1):사고패턴 = コロシアム_セラ
CALL SET_ENEMY_TIMEID, CHARANUM-1, "セラ"

CALL SYNC_STATUS, (CHARANUM-1)
CALL HEALTH_CHARA, (CHARANUM-1)
CALL BATTLE_START

FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0
CUSTOMDRAWLINE =
CALL MESSAGE_WINDOW, "", "￥15000을 상금으로 받고、명성 100을 얻었다", , , , , 4
CALL MESSAGE_WINDOW, "", "당신 앞으로 인스톨 소프트 【삼히타】가 보내졌다", , , , , 4
CALL GETS_INSTALLSOFT, "삼히타"
MONEY += 15000
FLAG:명성 += 100
FLAG:투기장명성 += 100
闘技場フラグ:19:0 = 1
IF FLAG:투기장랭크 < 1
	FLAG:투기장랭크 = 1
ENDIF

;セラの思考パターン
@SET_ACTION_コロシアム_セラ,ARG
;味方の中で一番ＨＰが低く、かつ飛具相性が1未満or999ではないキャラにＧＵＮ攻撃

;全員の中で一番ＨＰが低いキャラクターを狙う

CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

;変身しているかどうか
IF CFLAG:ARG:악마변신 == 0
	;人間版
	SELECTCASE RAND:100
		CASE 0 TO 39 
			CFLAG:ARG:입력행동 = [[스킬:ＧＵＮ]]
			CFLAG:ARG:타겟 = -1
			FOR LOCAL,1,7
				LOCALS = 포지션{LOCAL}
				SIF FLAG:LOCALS == -1
					CONTINUE
				SIF CFLAG:(FLAG:LOCALS):상태이상 >= GET_STATE_NUM("STONE")
					CONTINUE
				SIF MAXBASE:(FLAG:LOCALS):비구 < 1 || MAXBASE:(FLAG:LOCALS):비구 == 999
					CONTINUE
				IF FLAG:LOCALS > -1 && CFLAG:ARG:타겟 == -1 
					CFLAG:ARG:타겟 = LOCAL
					CONTINUE
				ENDIF
				IF FLAG:LOCALS > -1 && BASE:(FLAG:LOCALS):ＨＰ < BASE:((POS(CFLAG:ARG:타겟))):ＨＰ
					CFLAG:ARG:타겟 = LOCAL
				ENDIF
			NEXT
		CASE 40 TO 69
			CFLAG:ARG:입력행동 = [[스킬:랜디샷]]
			CFLAG:ARG:타겟 = -1
			FOR LOCAL,1,7
				LOCALS = 포지션{LOCAL}
				SIF FLAG:LOCALS == -1
					CONTINUE
				SIF CFLAG:(FLAG:LOCALS):상태이상 >= GET_STATE_NUM("STONE")
					CONTINUE
				SIF MAXBASE:(FLAG:LOCALS):정신 < 1 || MAXBASE:(FLAG:LOCALS):정신 == 999
					CONTINUE
				IF FLAG:LOCALS > -1 && CFLAG:ARG:타겟 == -1 
					CFLAG:ARG:타겟 = LOCAL
					CONTINUE
				ENDIF
				IF FLAG:LOCALS > -1 && BASE:(FLAG:LOCALS):ＨＰ < BASE:((POS(CFLAG:ARG:타겟))):ＨＰ
					CFLAG:ARG:타겟 = LOCAL
				ENDIF
			NEXT
		CASE 70 TO 99
			CFLAG:ARG:입력행동 = [[스킬:코로나샷]]	
			CFLAG:ARG:타겟 = -1
			FOR LOCAL,1,7
				LOCALS = 포지션{LOCAL}
				SIF FLAG:LOCALS == -1
					CONTINUE
				SIF CFLAG:(FLAG:LOCALS):상태이상 >= GET_STATE_NUM("STONE")
					CONTINUE
				SIF MAXBASE:(FLAG:LOCALS):전격 < 1 || MAXBASE:(FLAG:LOCALS):전격 == 999
					CONTINUE
				IF FLAG:LOCALS > -1 && CFLAG:ARG:타겟 == -1 
					CFLAG:ARG:타겟 = LOCAL
					CONTINUE
				ENDIF
				IF FLAG:LOCALS > -1 && BASE:(FLAG:LOCALS):ＨＰ < BASE:((POS(CFLAG:ARG:타겟))):ＨＰ
					CFLAG:ARG:타겟 = LOCAL
				ENDIF
			NEXT
	ENDSELECT
	;弱い敵にちまちま攻撃
	CFLAG:ARG:타겟 = -1
	CALL ATTACK_MIN_HP,ARG,0
ELSE
	SELECTCASE RAND:100
		CASE 0 TO 19 
			IF CFLAG:ARG:행동한횟수 == 0
				CFLAG:ARG:입력행동 = [[스킬:빙결브레이크]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:부흐]]
			ENDIF
		CASE 20 TO 50
			IF CFLAG:ARG:행동한횟수 == 0
				CFLAG:ARG:입력행동 = [[스킬:아쿠아]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:물고늘어지기]]
			ENDIF
		CASE 51 TO 99
			IF CFLAG:ARG:행동한횟수 == 0
				CFLAG:ARG:입력행동 = [[스킬:아쿠아]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:부흐]]
			ENDIF
	ENDSELECT
ENDIF
;アクション実行不能
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동

IF RESULT == 0 && CFLAG:ARG:악마변신 == 0
	;人間時
	CFLAG:ARG:입력행동 = [[스킬:ＧＵＮ]]
ELSEIF RESULT == 0 && CFLAG:ARG:악마변신 == 1
	CFLAG:ARG:입력행동 = 0
ENDIF

SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
@EVENT_BATTLE_DYING_コロシアム_セラ, L_T, L_P, L_SKIP
#DIM DYNAMIC L_T
#DIM DYNAMIC L_P
#DIM DYNAMIC L_SKIP
IF L_T == GET_ENEMY("セラ") && CFLAG:GET_ENEMY("セラ"):800 == 0
	TSTR:스킬메시지추가 = 少女の様子がおかしい

	CFLAG:L_T:상태이상 = GET_STATE_NUM("GOOD")
	BASE:L_T:ＨＰ = MAXBASE:L_T:ＨＰ
	CFLAG:L_T:800 = 1
	CFLAG:L_T:공격대상제외_ACT = 1
	CFLAG:L_T:ＣＯＯＰ플래그 = 0
ENDIF

@EVENT_BATTLE_ACTEND_コロシアム_セラ
IF CFLAG:GET_ENEMY("セラ"):800 == 1
	CFLAG:GET_ENEMY("セラ"):800 = 2
	RESETCOLOR
	PRINTFORML
	PRINTFORMW ＞소녀는 악마로 변신했다！
	CALL ACTION_[[스킬:악마변신]], GET_ENEMY("セラ")
ENDIF
