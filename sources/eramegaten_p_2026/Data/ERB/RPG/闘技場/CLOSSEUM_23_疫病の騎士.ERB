;=======================================================================
;ペイルライダー行動パターン
;=======================================================================
@SET_ACTION_闘技場ペイルライダー,ARG
#DIM DYNAMIC LCOUNT
CFLAG:ARG:입력행동 = 0
CFLAG:ARG:타겟 = 0
;HPが半分以下の場合は眼光の判定を行う
IF RAND:2 == 0 && 現HP割合(ARG) < 50 && CFLAG:ARG:추가행동횟수 == 0
	CFLAG:ARG:입력행동 = [[스킬:용의안광]]
ELSEIF FLAG:경과턴수 == 0 && CFLAG:ARG:행동한횟수 == 0
	CFLAG:ARG:입력행동 = [[스킬:혼탁의장기]]
ELSE
	;異常もちの数だけペストクロップの追加判定を行う
	FOR LCOUNT, 1, 7
		SIF !IS_TARGET_ABLE(POS(LCOUNT))
			CONTINUE
		SIF IS_BADSTATE(POS(LCOUNT), "GOOD")
			CONTINUE
		SIF RAND:4
			CONTINUE
		CFLAG:ARG:입력행동 = [[스킬:전염병생산]]
		BREAK
	NEXT
ENDIF
IF CFLAG:ARG:입력행동 == 0
	SELECTCASE RAND:100
		CASE IS < 10
			CFLAG:ARG:입력행동 = 0
		CASE IS < 30
			CFLAG:ARG:입력행동 = [[스킬:전염병생산]]
		CASE IS < 40
			CFLAG:ARG:입력행동 = [[스킬:부흐바리온]]
		CASE IS < 50
			CFLAG:ARG:입력행동 = [[스킬:마하・부흐바리온]]
		CASE IS < 60
			CFLAG:ARG:입력행동 = [[스킬:혼탁의장기]]
		CASE IS < 70
			CFLAG:ARG:입력행동 = [[스킬:베놈재퍼]]
		CASEELSE
			FOR LCOUNT, 7, 17
				SIF POS(LCOUNT) >= 0
					CONTINUE
				BREAK
			NEXT
			IF LCOUNT == 17
				CFLAG:ARG:입력행동 = 0
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:소환]]
			ENDIF
	ENDSELECT
ENDIF

CALL CHECK_ACTIONABLE,ARG,CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
SIF CFLAG:ARG:타겟 == 0
	CALL RANDOM_TARGET,ARG,CFLAG:ARG:입력행동
RETURN 0

