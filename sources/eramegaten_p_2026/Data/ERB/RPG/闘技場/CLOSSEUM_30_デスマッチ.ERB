@PLAYABLE_COLOSSEUM_30
SELECTCASE 闘技場フラグ:30:0
	CASE 0
		IF BASE:MASTER:LV >= 20 && FLAG:투기장명성 >= 100 && 闘技場フラグ:30:0 == 0
			RESULTS = 데스매치의 초대장
			RETURN 1
		ENDIF
	CASE 1
		IF 闘技場フラグ:30:0 == 1
			RESULTS = 데스매치 二回戦
			RETURN 1
		ENDIF
	CASE 2
		IF 闘技場フラグ:30:0 == 2
			RESULTS = 데스매치 準決勝
			RETURN 1
		ENDIF
	CASE 3
		IF 闘技場フラグ:30:0 == 3
			RESULTS = 데스매치 決勝戦
			RETURN 1
		ENDIF
ENDSELECT
RETURN 0


