@EVENT_BATTLE_TURNEND_COLOSSEUM55
CALL SKILL_2504_RESISTBREAK
CALL サタン相性セット(CHARANUM-1,FLAG:경과턴수)

;戦闘開始時、ターン終了時に呼び出される
;ShinEraTensei仕様として火炎と核熱、地変と重力、電撃と疾風、氷結と水撃はリンクさせる
;ARG = 경과턴수
@サタン相性セット(ARG,ARG:1)
SELECTCASE ARG:1 % 4
CASE 0
	;4n+1ターン目 火炎・氷結・電撃反射　地変と衝撃と物理が有効
	BASE:ARG:검격 = 100
	BASE:ARG:화염 = 999
	BASE:ARG:빙결 = 999
	BASE:ARG:전격 = 999
	BASE:ARG:충격 = 100
	BASE:ARG:지변 = 100
CASE 1
	;4n+2ターン目 氷結・電撃・衝撃反射　火炎と地変と物理が有効
	BASE:ARG:검격 = 100
	BASE:ARG:화염 = 100
	BASE:ARG:빙결 = 999
	BASE:ARG:전격 = 999
	BASE:ARG:충격 = 999
	BASE:ARG:지변 = 100
CASE 2
	;4n+3ターン目 地変・電撃・衝撃反射　火炎と氷結と物理が有効
	BASE:ARG:검격 = 100
	BASE:ARG:화염 = 100
	BASE:ARG:빙결 = 100
	BASE:ARG:전격 = 999
	BASE:ARG:충격 = 999
	BASE:ARG:지변 = 999
CASE 3
	;4n+4ターン目 物理反射　それ以外が有効	
	BASE:ARG:검격 = 999
	BASE:ARG:화염 = 100
	BASE:ARG:빙결 = 100
	BASE:ARG:전격 = 100
	BASE:ARG:충격 = 100
	BASE:ARG:지변 = 100
ENDSELECT
BASE:ARG:비구 = BASE:ARG:검격
BASE:ARG:타격 = BASE:ARG:검격
BASE:ARG:전술 = BASE:ARG:검격
BASE:ARG:핵열 = BASE:ARG:화염
BASE:ARG:수격 = BASE:ARG:빙결
BASE:ARG:중력 = BASE:ARG:지변
BASE:ARG:질풍 = BASE:ARG:전격
FOR LOCAL,GETNUM(BASE,"검격"),GETNUM(BASE,"사이코")+1
	MAXBASE:ARG:LOCAL = BASE:ARG:LOCAL
NEXT

;相手の弱点を探す関数
@SATAN_GET_WEAK(ARG,ARG:1)
#DIM L_COUNT
#DIM CHARA
#DIM 相性
#DIM L_PARTY,6
VARSET L_COUNT
VARSET L_PARTY
VARSET 相性
IF ARG:1 == 17
	LOCAL:1 = 1
	LOCAL:2 = 4
ELSEIF ARG:1 == 18
	LOCAL:1 = 4
	LOCAL:2 = 7
ELSEIF ARG:1 == 19
	LOCAL:1 = 1
	LOCAL:2 = 7
ELSEIF ARG:1 == 20
	LOCAL:1 = 7
	LOCAL:2 = 12
ELSEIF ARG:1 == 21
	LOCAL:1 = 12
	LOCAL:2 = 17
ELSEIF ARG:1 == 22
	LOCAL:1 = 7
	LOCAL:2 = 17
ELSEIF ARG:1 == 23
	LOCAL:1 = 1
	LOCAL:2 = 17
ELSE
	CHARA = POS(ARG:1)
	GOTO SKIP_CHARASELECT
ENDIF
FOR LOCAL,LOCAL:1,LOCAL:2
	SIF POS(LOCAL) < 0
		CONTINUE
	L_PARTY:(L_COUNT++) = POS(LOCAL)
NEXT
CHARA = L_PARTY:(RAND:L_COUNT)
$SKIP_CHARASELECT
PRINTFORM 弱点感知：%CALLNAME:CHARA%　
;破魔・呪殺のうち耐性が低い方
RESULT:1 = 相性係数(CHARA,"파마") > 相性係数(CHARA,"주살") ? GET_TYPE_NUM("파마") # GET_TYPE_NUM("주살")
PRINTFORM 弱点１：%GET_TYPE(RESULT:1)%　
;火炎・氷結・電撃・衝撃・地変のうち最も弱い相性の
;行動阻害を与えられる電撃・氷結は若干出しやすい
相性 = 相性係数(CHARA,"전격")
RESULT:2 = GET_TYPE_NUM("전격")
FOR LOCAL,1, 5
	SELECTCASE LOCAL
	CASE 1
		LOCALS = 빙결
	CASE 2
		LOCALS = 화염
	CASE 3
		LOCALS = 충격
	CASE 4
		LOCALS = 지변
	ENDSELECT
	;よく通る属性に変更
	IF 相性 < 相性係数(CHARA,LOCALS)
		相性 = 相性係数(CHARA,LOCALS)
		RESULT:2 = GET_TYPE_NUM(LOCALS)
	ENDIF
NEXT
PRINTFORMW 弱点２：%GET_TYPE(RESULT:2)%({相性})
RETURN CHARA
