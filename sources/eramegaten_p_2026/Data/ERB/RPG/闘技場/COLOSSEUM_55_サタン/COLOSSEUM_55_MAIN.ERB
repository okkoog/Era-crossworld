;#;			CALL HEALTH_CHARA(LOCAL)
;#;		NEXT
;#;	ENDIF
発狂モード = 0
매혹의과실 = 0

CUSTOMDRAWLINE =
WAIT

CALL SET_ENEMY,14,[[キャラ:사탄]],99,0,1
;디버그용 サタンボスフラグ解除
;#;	SIF GETBIT(OPTION,4)
;#;		CFLAG:(CHARANUM-1):보스플래그 = 0
CFLAG:(CHARANUM-1):행동횟수 = 5
;一切補正を含まない分能力値が凶悪
;(本来の能力は18+LV(99)*1.5=168±5辺りが妥当である)
CALL SET_ENEMY_BASE_STAT, CHARANUM-1, 99, 150, 120, 150, 120, 100, 100
CALL SYNC_STATUS(CHARANUM-1)
SIF MAXBASE:(CHARANUM-1):ＨＰ < 30000
	CALL SET_BATTLE_STATUS, CHARANUM-1, 30000, "ＨＰ"
CALL SET_BATTLE_STATUS, CHARANUM-1, 99999, "ＭＰ"

;合計能力740。ポケモンもびっくり
;相性セット
BASE:(CHARANUM-1):정신 = 0
BASE:(CHARANUM-1):신경 = 0
BASE:(CHARANUM-1):만능 = 50
BASE:(CHARANUM-1):파마 = 0
BASE:(CHARANUM-1):주살 = 0
;全BS無効
FOR LOCAL,GETNUM(BASE,"HAPPY"),GETNUM(BASE,"DYING")+1
	BASE:(CHARANUM-1):LOCAL = -100
NEXT
