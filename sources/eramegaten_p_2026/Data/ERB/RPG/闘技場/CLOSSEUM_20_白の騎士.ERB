;=======================================================================
;ホワイトライダー行動パターン
;=======================================================================
@SET_ACTION_闘技場ホワイトライダー,ARG
#DIM DYNAMIC LCOUNT
#DIM L_TARGET, 2
#DIM DYNAMIC L_POS = 1, 2, 3, 4, 5, 6
CFLAG:ARG:입력행동 = 0
CFLAG:ARG:타겟 = 0
CALL SHUFFLE_ARRAY_INT, L_POS
;
IF CFLAG:ARG:꿰뚫는투기
	CFLAG:ARG:입력행동 = [[스킬:갓애로우]]
	CFLAG:ARG:타겟 = L_TARGET:1
	L_TARGET:1 = 0
;HPが半分以下の場合は眼光の判定を行う
ELSEIF RAND:3 == 0 && 現HP割合(ARG) < 50 && CFLAG:ARG:추가행동횟수 == 0
	CFLAG:ARG:입력행동 = [[스킬:용의안광]]
;４分の１でデカジャチェック
ELSEIF RAND:4 == 0
	FOR LCOUNT, 1, 7
		SIF !IS_TARGET_ABLE(POS(LCOUNT))
			CONTINUE
		SIF GET_カジャンダ_MAX(POS(LCOUNT)) <= 0
			CONTINUE
		CFLAG:ARG:입력행동 = [[스킬:데・카쟈]]
		BREAK
	NEXT
;２分の１でテトラジャチェック
ELSEIF RAND:2 == 1
	FOR LCOUNT, 7, 17
		SIF !IS_TARGET_ABLE(POS(LCOUNT))
			CONTINUE
		SIF CFLAG:POS(LCOUNT):테트라쟈 < 1
			CONTINUE
		CFLAG:ARG:입력행동 = [[스킬:테트라쟈]]
		BREAK
	NEXT
ENDIF
IF CFLAG:ARG:입력행동 == 0
	SELECTCASE RAND:100
		CASE IS < 30
			CFLAG:ARG:입력행동 = 0
		;ゴッドアロー、破魔効く奴探してそいつ狙う(ただしテトラジャスルー)失敗は破魔ガードキル
		CASE IS < 50
			FOR LCOUNT, 0, 6
				L_TARGET = POS(L_POS:LCOUNT), 0
				SIF !IS_TARGET_ABLE(L_TARGET)
					CONTINUE
				L_TARGET:1 = L_POS:LCOUNT
				CALL BTL_CALC_AISYOU, ARG, L_TARGET, , GET_TYPE_NUM("파마")
				SELECTCASE RESULT
					CASE 999, IS <= 0
						SIF RAND:2
							CFLAG:ARG:입력행동 = [[스킬:꿰뚫는투기]]
					CASE IS >= 100
						;갓애로우
						CFLAG:ARG:입력행동 = [[스킬:갓애로우]]
						CFLAG:ARG:타겟 = L_POS:LCOUNT
					CASE IS >= 50
						;갓애로우
						IF RAND:4 == 0
							CFLAG:ARG:입력행동 = [[스킬:꿰뚫는투기]]
						ELSE
							CFLAG:ARG:입력행동 = [[스킬:갓애로우]]
							CFLAG:ARG:타겟 = L_POS:LCOUNT
						ENDIF
					CASEELSE
						;갓애로우
						IF RAND:4 > 0
							CFLAG:ARG:입력행동 = [[스킬:꿰뚫는투기]]
						ELSE
							CFLAG:ARG:입력행동 = [[스킬:갓애로우]]
							CFLAG:ARG:타겟 = L_POS:LCOUNT
						ENDIF
				ENDSELECT
				SIF CFLAG:ARG:입력행동 != 0
					BREAK
			NEXT
		CASE IS < 80
			;지옥의업화
			CFLAG:ARG:입력행동 = [[스킬:지옥의업화]]
		CASEELSE
			FOR LCOUNT, 7, 17
				SIF POS(LCOUNT) >= 0
					CONTINUE
				BREAK
			NEXT
			IF LCOUNT == 17
				CFLAG:ARG:입력행동 = 0
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:소환]]
			ENDIF
	ENDSELECT
ENDIF

CALL CHECK_ACTIONABLE,ARG,CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
SIF CFLAG:ARG:타겟 == 0
	CALL RANDOM_TARGET,ARG,CFLAG:ARG:입력행동
RETURN 0

