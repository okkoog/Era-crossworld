	;-------------
	;戦闘処理
	;-------------
	;レベル、キャラクター番号を指定して「犬を連れた少年」を呼び出す　※まだ存在しないので「CSVNo.0：あなた」のデータを参照
	CALL SET_ENEMY, 9, 0, 99, 0, 1
	;ステータスを調節(お香とかMAG強化してくる想定)
	;※めっちゃ素早い上に二階行動で物反鏡とか使ってくる。ずるい！
	;CFLAG:(CHARANUM-1):ＨＰ보정 += MAXBASE:(CHARANUM-1):ＨＰ * 1
	BASE:(CHARANUM-1):힘 += 100
	BASE:(CHARANUM-1):지혜 += 160
	BASE:(CHARANUM-1):마력 += 160
	BASE:(CHARANUM-1):내구 += 50
	BASE:(CHARANUM-1):속도 += 90
	BASE:(CHARANUM-1):운 += 5
	;敵キャラの名称を「소년」に変更
	CALLNAME:(CHARANUM-1) = 소년

	;行動パターンをセット
	;※通常行動とは別口で物反鏡と魔反鏡をランダムで使ってくる。ずるい！
	CSTR:(CHARANUM-1):사고패턴 = COLOSSEUM_26_EVENT3

	;装備をセット
	EQUIP:(CHARANUM-1):검 = GETNUM(ITEM, "마사카도의검")
	EQUIP:(CHARANUM-1):총 = GETNUM(ITEM, "레일건")
	EQUIP:(CHARANUM-1):머리 = GETNUM(ITEM, "마사카도의투구")
	EQUIP:(CHARANUM-1):몸통 = GETNUM(ITEM, "마사카도의갑주")
	EQUIP:(CHARANUM-1):팔 = GETNUM(ITEM, "마사카도의토시")
	EQUIP:(CHARANUM-1):발 = GETNUM(ITEM, "기간트폴")

	;スキルを設定
	;※MPが0だけどアイテムを使ってくる。消費MPなしでアイテム個数制限なし。ずるい！
	ABL:(CHARANUM-1):스킬1 = [[스킬:마석]]
	ABL:(CHARANUM-1):스킬2 = [[스킬:메기도스톤]]
	ABL:(CHARANUM-1):스킬3 = [[스킬:신경탄]]
	ABL:(CHARANUM-1):스킬4 = [[스킬:아이템숙련]]
	ABL:(CHARANUM-1):스킬5 = [[스킬:아이템숙련]]
	ABL:(CHARANUM-1):스킬6 = [[스킬:아이템숙련]]

	;行動回数を設定
	CFLAG:(CHARANUM-1):행동횟수 = 2

	;全BS無効(ジオハメ、ダメ！ゼッタイ！)
	FOR LOCAL,GETNUM(BASE,"HAPPY"),GETNUM(BASE,"BRAND")+1
		BASE:(CHARANUM-1):LOCAL = -100
		MAXBASE:(CHARANUM-1):LOCAL = -100
	NEXT

	;ステータスなどの設定値を反映させる。
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)

	;レベル、キャラクター番号を指定して「ペットの犬」を呼び出す　※「CSVNo.852：ケルベロス」のデータを参照
	CALL SET_ENEMY, 10, [[キャラ:케르베로스]], 99, 0, 1

	;敵キャラの名称を「ペットの犬」に変更
	CALLNAME:(CHARANUM-1) = ペットの犬

	;全BS無効(ジオハメ、ダメ！ゼッタイ！)
	FOR LOCAL,GETNUM(BASE,"HAPPY"),GETNUM(BASE,"BRAND")+1
		BASE:(CHARANUM-1):LOCAL = -100
		MAXBASE:(CHARANUM-1):LOCAL = -100
	NEXT

	;ステータスを調節
	;※物理系のステータス補正をかける。強い。
	BASE:(CHARANUM-1):힘 += 100
	BASE:(CHARANUM-1):지혜 += 30
	BASE:(CHARANUM-1):마력 += 80
	BASE:(CHARANUM-1):내구 += 50
	BASE:(CHARANUM-1):속도 += 80
	BASE:(CHARANUM-1):운 += 5

	;スキルを設定
	ABL:(CHARANUM-1):스킬4 = [[스킬:기합]]	;スキル4の『지옥의업화』は魔法なので合わないため入れ替え

	;ステータスなどの設定値を反映させる。
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)

	;経験値処理をスキップする
	FLAG:RESULT스킵 = 1
	;会話不能にする(ここで無限に仲魔入手は仕様外です)
	FLAG:회화불능플래그 = 1

	;ここで戦闘開始
	CALL BATTLE_START
	RESETCOLOR

	;経験値処理をデフォルトに戻す
	FLAG:RESULT스킵 = 0
	;会話不能フラグをデフォルトに戻す
	FLAG:회화불능플래그 = 0

	;PTメンバーのHP・MPを全回復する
	CALL COLOSSEUM_26_RECOVERY_ALL

	;-------------
	;戦闘終了後
	;-------------
	PRINTFORML
	PRINTFORML 문득 정신을 차려보니 소년은 어디에도 없었다。
	PRINTFORML 몇 가지 장비와 핸드벨트 컴퓨터만이 지면에 남아 있다。
	PRINTFORML
	PRINTFORML 『운명을 누군가에게 내맡기거나 하지 않아！』
	PRINTFORMW 『신에게도！ 악마에게도！！』
	PRINTFORML
	PRINTFORMW 그렇게 주장하던 그의 모습이 눈에 박혀 떠나지 않는다。
	PRINTFORMW 당신은、조직의 개다。
	PRINTFORMW 살아가는 방식조차 선택할 수 없다。
	PRINTFORMW
	PRINTFORMW ………
	PRINTFORMW ……
	PRINTFORMW …
	PRINTFORML
	DRAWLINE
	IF COMP_SIZEUP_BY_EVENT:COMP_SIZEUP_EVENTNUM("CL26_ダメージコンテスト特典2")
		;COMP容量が30以上の場合、COMP容量の増加はなし(代わりに先輩サマナーにアイテムをもらう)
		PRINTFORML 에？ 이 악마소환 프로그램、유용할 수 없다고？
		PRINTFORML 애초에 구조가 다르다고？ BASIC으로 기술되어 있다고？
		PRINTFORML 그렇구나…… 엣 BASIC？
		PRINTFORML
	ELSE
		CALL MESSAGE_WINDOW, "" , "＞COMP의 용량이 1 늘어났다"
		CALL SIZEUP_COMP_BY_EVEMT, "CL26_ダメージコンテスト特典2"
		PRINTFORML
	ENDIF
	PRINTFORML
	CALL MESSAGE_WINDOW, "" , "빛의 소태도를 손에 넣었다"
	CALL GET_ITEMS, "빛의소태도", 1
	CALL MESSAGE_WINDOW, "" , "단두대 도끼를 손에 넣었다"
	CALL GET_ITEMS, "길로틴액스", 1

	;特殊イベントを(9:終了済)にする
	COLOSSEUM_26_SPECIAL_EVENT_FLG:EVENT_NO = 9
ENDIF

RETURN 1


