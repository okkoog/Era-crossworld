;---------------------------------
;挑戦可能な特殊イベントの数を集計する
;---------------------------------
@ADD_UP_SPECIAL_EVENT
#FUNCTION
#LOCALSIZE  1
#LOCALSSIZE 1

;-------------
;変数定義
;-------------
;挑戦可能な特殊イベントの数
#DIM SPECIAL_EVENT_COUNT

;-------------
;本処理
;-------------
SPECIAL_EVENT_COUNT = 0

;特殊イベント1～10の内、挑戦可能(進行中)のものを集計する
FOR LOCAL,0,9
	;ランキング一位、かつご褒美イベントがまだ発生していない場合
	IF COLOSSEUM_26_SPECIAL_EVENT_FLG:LOCAL >= 1 && COLOSSEUM_26_SPECIAL_EVENT_FLG:LOCAL <= 8
	SPECIAL_EVENT_COUNT ++
	ENDIF
NEXT

RETURNF SPECIAL_EVENT_COUNT




