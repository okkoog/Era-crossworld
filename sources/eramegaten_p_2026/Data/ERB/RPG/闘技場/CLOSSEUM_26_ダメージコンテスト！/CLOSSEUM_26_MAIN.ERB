;---------------------------------
;ランキングご褒美イベント
;---------------------------------
@COLOSSEUM_26_RANKING_EVENT_REGULATION, TEMP_REGULATION
;-------------
;変数定義
;-------------
;何回目のイベントであるか
#DIM EVENT_NO

;イベント発生時のレギュレーション
#DIM TEMP_REGULATION

;電光掲示板に表示するメッセージ(一位の名前と得点)
#DIMS TEMP_MESSEGE

;-------------
;本処理
;-------------
;ご褒美イベント中はレギュレーション99とする(ターン終了時のポイント表示などをさせないため)
COLOSSEUM_26_REGULATION_NO = 99

;何回目のご褒美イベントかを取得する
EVENT_NO = 1
FOR LOCAL,0,10
	;ご褒美イベント発生済の場合、カウント+1
	;※この時点では、現在発生しているイベントはカウントされないため「EVENT_NO」の初期値は0ではなく1としている。
	IF COLOSSEUM_26_RANKING_EVENT_FLG:LOCAL == 1
		EVENT_NO += 1
	ENDIF
NEXT

;電光掲示板に表示するメッセージを作成
TEMP_MESSEGE = 1位：%CALLNAME:MASTER%({COLOSSEUM_26_MAX_DAMAGE:TEMP_REGULATION}ポイント)

;X回目イベントを発生させる。
SELECTCASE EVENT_NO
	CASE 1
		;1回目のご褒美イベント
		PRINTFORML 당신은 측정기를 후려치고 표시된 득점을 보며 엷은 미소를 띄웠다。
		PRINTFORMW 콜로세움의 전광판이 점멸하며 순위가 뒤바뀐다。
		PRINTFORML 
		CALL MESSAGE_WINDOW, "" , TEMP_MESSEGE
		PRINTFORMW 겨드랑이에 스케치북을 끼고 카운터로 향한다。
		PRINTFORML 데미지 콘테스트 기록 갱신자에게는 경품으로
		PRINTFORMW 원하는 디자인의 오리지널 COMP를 마련해 준다고 한다。
		PRINTFORMW 그런 소식을 듣고 덥석 달려들고 마는 것을 보니、당신도 훌륭한 팬텀 서머너였다。
		PRINTFORML
		PRINTFORMW ………
		PRINTFORMW ……
		PRINTFORMW …
		PRINTFORML
		IF COMP_SIZEUP_BY_EVENT:COMP_SIZEUP_EVENTNUM("CL26_ダメージコンテスト特典1")
			;COMP容量が30以上の場合、COMP容量の増加はなし(代わりに先輩サマナーにアイテムをもらう)
			PRINTFORML 엣、이 이상 강력한 COMP는 준비할 수 없다고？
			PRINTFORML 그럼 성능은 떨어져도 좋으니까 이 노트대로 디자인을…… 저기、피네간 씨？
			PRINTFORML 죽어버리니까 안 돼？ 실동부대로서 그건 용납할 수 없어？
			PRINTFORML 그런……
			PRINTFORML
			CALL MESSAGE_WINDOW, "" , "피네간에게 메리켄 사크를 받았다"
			CALL GET_ITEMS, "너클더스터", 1
			CALL MESSAGE_WINDOW, "" , "마요네에게 섹시 힐을 받았다"
			CALL GET_ITEMS, "섹시힐", 1
		ELSE
			;COMP容量が28以下の場合、COMP容量が2増加
			CALL MESSAGE_WINDOW, "" , "＞COMP의 용량이 1 늘어났다"
			;FLAG:ＣＯＭＰ용량 += 1
			CALL SIZEUP_COMP_BY_EVEMT, "CL26_ダメージコンテスト特典1"
			PRINTFORML
		ENDIF
		CALL MESSAGE_WINDOW, "" , "＞1000마카를 손에 넣었다"
		MONEY:1 += 1000
		PRINTFORML

	CASE 2
		;2回目のご褒美イベント
		PRINTFORML 측정 종료 버저가 울리고、당신은 숨을 헐떡이며 전광판을 올려다보았다。
		PRINTFORMW 
		CALL MESSAGE_WINDOW, "" , TEMP_MESSEGE
		PRINTFORMW 사방에서 터져 나오는 환호성에 손을 흔들어 화답하며 당신은 선수석으로 돌아왔다。
		PRINTFORML 스스로를 단련하고 힘을 피로한다。
		PRINTFORML 원치 않는 채로 조직에 얽매여 울굴한 나날을 보내던 당신이었으나
		PRINTFORMW 어느샌가 투기장에서의 활동에 보람을 느끼고 있었다。
		PRINTFORMW 메시아교 지배하의 콜로세움까지 일부러 발걸음을 옮길 정도로。
		PRINTFORML
		CALL MESSAGE_WINDOW, "" , "＞1000마카를 손에 넣었다"
		MONEY:1 += 1000
		PRINTFORML
		PRINTFORMW ………
		PRINTFORMW ……
		PRINTFORMW …
		PRINTFORML
		PRINTFORML 상금을 수령하고 출구로 향하려던 당신은
		PRINTFORMW 개를 데리고 있는 소년이 멍하니 동상을 올려다보고 있는 것을 알아차렸다。
		PRINTFORMW 분명 이 콜로세움의 초대 챔피언 동상이다。
		PRINTFORML
		PRINTFORMW 소년이 뒤를 돌아보았다。
		PRINTFORML 아무래도 정신을 차려보니 이곳에 있었던 모양인지 상황을 잘 파악하지 못하고 있는 듯하다。
		PRINTFORMW 당신에게 몇 가지 질문을 던져왔다。
		PRINTFORML
		PRINTFORMW 이 일대는 이미 사회가 붕괴되어 사람들의 명운은 신마들의 손에 쥐여져 있다。
		PRINTFORML 천사에 의한 관리、그리고 악마들의 습격과 약탈。
		PRINTFORMW 사람들을 둘러싼 현 상황을 들을 때마다 소년은 표정을 어둡게 흐렸다。
		PRINTFORML 그는 한 여성에 대해 물어왔다。
		PRINTFORML 해당하는 이름의 여성 -- 이 시설에서 마담이라 불리던 미망인 -- 의 전말을 들려주자
		PRINTFORMW 몹시 큰 충격을 받은 모양이다。
		PRINTFORML
		PRINTFORMW ………
		PRINTFORMW ……
		PRINTFORMW …
		PRINTFORML
		PRINTFORMW 소년은 팔에 장착하고 있는 기계를 COMP로서 사용하고 있는 듯하다。
		PRINTFORMW 이것은…… 새로운 디자인！ 개성적인 COMP다！
		PRINTFORML 갑자기 텐션이 오른 당신에게 쓴웃음을 지으면서도 소년은 상품명과 부품 번호를 가르쳐 주었다。
		PRINTFORMW 어서 잡화점으로 쇼핑을 하러 가자！
		PRINTFORML
		;IF FLAG:ＣＯＭＰ용량 >= 30
		IF COMP_SIZEUP_BY_EVENT:COMP_SIZEUP_EVENTNUM("CL26_ダメージコンテスト特典2")
			;COMP容量が30以上の場合、COMP容量の増加はなし(代わりに先輩サマナーにアイテムをもらう)
			PRINTFORML 에？ 핸드벨트 컴퓨터는 골동품이라고？
			PRINTFORML 가지고 있는 악마소환 프로그램을 구동하기엔 용량이 부족하다고？
			PRINTFORML 멋진데……
			PRINTFORML
		ELSE
			;COMP容量が28以下の場合、COMP容量が2増加
			CALL MESSAGE_WINDOW, "" , "＞COMP의 용량이 1 늘어났다"
			CALL SIZEUP_COMP_BY_EVEMT, "CL26_ダメージコンテスト特典2"
			;FLAG:ＣＯＭＰ용량 += 1
			PRINTFORML
		ENDIF
		PRINTFORML

	CASE 3
		;3回目のご褒美イベント
		PRINTFORML 터져 나오는 환호성을 등 뒤로 받으며 당신은 포효를 내질렀다。
		PRINTFORML 
		CALL MESSAGE_WINDOW, "" , TEMP_MESSEGE
		PRINTFORMW 장비를 모았다。자신과 동료들을 철저히 단련했다。그리고 전술을 갈고닦았다。
		PRINTFORML 즐겁다。
		PRINTFORMW 싸우는 것이。겨루는 것이。
		PRINTFORMW 힘을 떨치는 그 순간 당신은 자유로웠다。
		PRINTFORML 조직의 굴레를、그리고 조교사의 일을 잊고
		PRINTFORMW 그저 한 명의 전사로서 당신은 그곳에 있었다。
		PRINTFORML
		CALL MESSAGE_WINDOW, "" , "＞1000마카를 손에 넣었다"
		MONEY:1 += 1000
		PRINTFORMW
		PRINTFORMW ………
		PRINTFORMW ……
		PRINTFORMW …
		PRINTFORML
		PRINTFORMW 경기를 마치고 선수석으로 돌아오자 개를 데리고 있는 소년이 말을 걸어왔다。
		PRINTFORML 그 역시 이 콜로세움에 참가하고 있는 선수다。
		PRINTFORML 요전에 알게 된 이후로 가끔 얼굴을 마주하며 대화하고 있다。
		PRINTFORML
		PRINTFORMW 아무래도 겨뤄보고 싶은 모양이다。
		PRINTFORML 당신은 알고 있었다。그가 진지하게、그리고 무언가에 쫓기듯 훈련에 매진하고 있음을。
		PRINTFORML 때때로 슬픈 듯이 이 시설과 사람들을 바라보는 모습을。
		PRINTFORML 그의 사정은 당신이 알 바가 아니다。
		PRINTFORMW 그럼에도 조금 어린 COMP 동료의 요청에 당신은 흔쾌히 응하기로 했다。
		PRINTFORML
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃특수 이벤트가 해금되었습니다　　　　　　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛

		;特殊イベント1:『犬を連れた少年』の進行度を1(発生)に変更
		COLOSSEUM_26_SPECIAL_EVENT_FLG:0 = 1

	CASEELSE
		;その他の場合、存在しない番号なので何もしない　※エラー処理作ってなくてごめんね！
		PRINTFORMW 오류: 존재하지 않는 이벤트({EVENT_NO}번째 포상)를 호출하려 하고 있습니다。
ENDSELECT

RETURN 1


