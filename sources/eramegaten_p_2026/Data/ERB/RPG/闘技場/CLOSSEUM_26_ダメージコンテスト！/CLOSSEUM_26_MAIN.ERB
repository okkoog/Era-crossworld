;---------------------------------------------------------------------------------------------------------------------------------
;데미지콘테스트！
;サンドバッグの敵に攻撃を加えてダメージコンテストを行う闘技場イベントです。
;また、レベル・耐性・敵の種類・使用してくるスキルを指定した敵を用意することで
;耐性・弱点持ちの敵相手へのダメージを確認したり、逆に敵に任意のスキルを使用させたりのテストもできるよ！
;上記目的に沿っていただければどなたでも追記・修正大歓迎です。

;更新日時　　　更新者				更新内容
;2021/06/25　　ロッド@カヤノソト	以下の3つのレギュレーションを作成。
;										・1ターンのダメージで競争
;										・5ターンのダメージで競争
;									バフ・デバフ等の準備し放題で競争(ダメージが最初に発生したターンのみ測定)
;2021/08/31　　	ロッド@カヤノソト	以下の4点の修正を実施
;										・イベントバトル(犬を連れた少年)を強制バトルから任意バトルに変更
;										・ダメージコンテストに参加せず、戦闘テストなどの場合はコロシアム参加済みにならないように変更
;										・ダメージコンテストなどの終了後に全員全回復する処理を追加
;										・PTメンバーを入れ替えることができる機能を追加
;2022/01/04　　	ロッド@カヤノソト	次の2点の微調整を実施	①測定器に即死と石化以外の状態異常が通るようにする(状態異常を利用してダメージを伸ばせるように)　②ダメコン本編では戦闘難易度をNORMALで固定する (戦闘テストなどダメコン以外の要素は変更なし)
;---------------------------------------------------------------------------------------------------------------------------------


;====================
;条件
;====================
@GET_COLOSSEUM_NAME_26
#FUNCTIONS
RESULTS_F '= "ダメージコンテスト"
RETURNF RESULTS_F

@PLAYABLE_COLOSSEUM_26
IF (ANALYZE_COUNT_CHECK(1, 100, 100, 1, 999, -1) >= 100 && BASE:MASTER:LV >= 50) || FLAG:DEBUG
	RESULTS = 데미지콘테스트！
	RETURN 1
ENDIF

;====================
;内容
;====================
@COLOSSEUM_26

;-------------
;変数定義
;-------------
;指定されたレベル
#DIM SELECT_LEVEL

;属性を指定するかどうかのフラグ
#DIM SELECT_TAISEI_FLG

;指定された属性耐性。順番に([0]검격, [1]비구, [2]타격, [3]전술, [4]화염, [5]빙결, [6]전격, [7]충격, [8]신경, [9]정신, [10]파마, [11]주살, [12]지변, [13]수격, [14]질풍, [15]중력, [16]핵열, [17]만능)
#DIM SELECT_TAISEI, 18

;耐性値を変更する属性の番号。上記の属性耐性の番号(0～17)に対応
#DIM SELECT_ZOKUSEI_NUM

;呼び出すキャラクター番号
#DIM SELECT_CHARACTOR_NUM

;呼び出すキャラクターの名称
#DIMS SELECT_CHARACTOR_NAME

;使用してくるスキルを指定するかどうかのフラグ
#DIM SELECT_SKILL_FLG

;使用してくるスキルの番号
#DIM SELECT_SKILL_NO

;使用してくるスキルの名称
#DIMS SELECT_SKILL_NAME

;挑戦可能な特殊イベントの数
#DIM SPECIAL_EVENT_COUNT

;-------------
;定数定義
;-------------
;コンテスト用の敵キャラのレベル
#DIM CONST CONTEST_LEVEL = 30

;コンテスト用の敵キャラの耐性。順番に([0]검격, [1]비구, [2]타격, [3]전술, [4]화염, [5]빙결, [6]전격, [7]충격, [8]신경, [9]정신, [10]파마, [11]주살, [12]지변, [13]수격, [14]질풍, [15]중력, [16]핵열, [17]만능)
#DIM CONST CONTEST_TAISEI, 18 = 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100


;-------------
;変数の値を初期化
;-------------
;指定されたレベル
SELECT_LEVEL = 30

;属性を指定するかどうかのフラグ
SELECT_TAISEI_FLG = 0

;指定された属性耐性。順番に([0]검격, [1]비구, [2]타격, [3]전술, [4]화염, [5]빙결, [6]전격, [7]충격, [8]신경, [9]정신, [10]파마, [11]주살, [12]지변, [13]수격, [14]질풍, [15]중력, [16]핵열, [17]만능)
SELECT_TAISEI = 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100

;呼び出すキャラクター番号
SELECT_CHARACTOR_NUM = 517

;呼び出すキャラクターの名称
SELECT_CHARACTOR_NAME = %CSVCALLNAME(SELECT_CHARACTOR_NUM)%

;使用してくるスキルを指定するかどうかのフラグ
SELECT_SKILL_FLG = 0

;使用してくるスキルの番号
SELECT_SKILL_NO = 701

;挑戦可能な特殊イベントの数
SPECIAL_EVENT_COUNT = 0

;ダメージコンテストに参加したかどうかのフラグ
;※テスト戦闘のみの場合、その日のコロシアム参加が終了していない扱いとする。
ATTEND_CONTEST_FLG = 0

