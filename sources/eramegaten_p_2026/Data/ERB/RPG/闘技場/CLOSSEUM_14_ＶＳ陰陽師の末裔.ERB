;星命の思考パターン
;@SET_ACTION_957,ARG
@SET_ACTION_COLOSSEUM_14_SEIMEI, ARG
#DIM LCOUNT
#DIM MIN_ENEMY
#DIM MIN_HP
;4ターンに一度、道返玉と治癒を使う
IF FLAG:경과턴수 % 4 == 3
	;死人がいたらリカーム
	CFLAG:ARG:입력행동 = SKILL_NUM_F("도반옥")
	CFLAG:ARG:타겟 = -1
	CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
	SIF RESULT
		RETURN 1
	MIN_ENEMY = -1
	MIN_HP = 100
	;割合で見て一番ダメージを受けている味方にディアラハン
	;ただし75%以下の味方が居ない場合は使わない
	FOR LCOUNT, 7, 17
		SIF POS(LCOUNT) < 0
			CONTINUE
		SIF 現HP割合(POS(LCOUNT)) >= MIN_HP
			CONTINUE
		MIN_HP = 現HP割合(POS(LCOUNT))
		MIN_ENEMY = LCOUNT
	NEXT
	IF MIN_HP <= 90
		CFLAG:ARG:입력행동 = SKILL_NUM_F("결계부・치유")
		CFLAG:ARG:타겟 = MIN_ENEMY
		CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
		SIF RESULT
			RETURN 1
	ENDIF
ENDIF
CALL SET_ACTION_COLOSSEUM_14_BACK, ARG

;スザクの思考パターン
;@SET_ACTION_957,ARG
@SET_ACTION_COLOSSEUM_14_SUZAKU, ARG
#DIM LCOUNT
#DIM MIN_ENEMY
#DIM MIN_HP
;3ターンに一度、リカーム・ディアラハンを使う
IF FLAG:경과턴수 % 3 == 2
	;死人がいたらリカーム
	CFLAG:ARG:입력행동 = SKILL_NUM_F("리캄")
	CFLAG:ARG:타겟 = -1
	CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
	SIF RESULT
		RETURN 1
	MIN_ENEMY = -1
	MIN_HP = 100
	;割合で見て一番ダメージを受けている味方にディアラハン
	;ただし75%以下の味方が居ない場合は使わない
	FOR LCOUNT, 7, 17
		SIF POS(LCOUNT) < 0
			CONTINUE
		;スザク自身は判定をわける
		SIF POS(LCOUNT) == ARG
			CONTINUE
		SIF 現HP割合(POS(LCOUNT)) >= MIN_HP
			CONTINUE
		MIN_HP = 現HP割合(POS(LCOUNT))
		MIN_ENEMY = LCOUNT
	NEXT
	IF MIN_HP <= 75
		CFLAG:ARG:입력행동 = SKILL_NUM_F("디아라한")
		CFLAG:ARG:타겟 = MIN_ENEMY
		CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
		SIF RESULT
			RETURN 1
	ELSE
		;スザク自身の回復は他に回復対象が居ない時、HP50%で実行する
		IF 現HP割合(ARG) < 50
			CFLAG:ARG:입력행동 = SKILL_NUM_F("디아라한")
			CFLAG:ARG:타겟 = CPOS(ARG)
			CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
			SIF RESULT
				RETURN 1
		ENDIF
	ENDIF
ENDIF
CALL SET_ACTION_COLOSSEUM_14_BACK, ARG



