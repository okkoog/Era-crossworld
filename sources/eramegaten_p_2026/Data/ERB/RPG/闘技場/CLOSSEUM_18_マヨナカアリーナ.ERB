@SET_ACTION_4700,ARG
;ラビリスの思考
IF CFLAG:ARG:１more플래그 > 0
	CFLAG:ARG:입력행동 = [[스킬:전광석화]]
ELSEIF CFLAG:ARG:気合フラグ == 1
	;검격
	IF RAND:3 == 0
		IF RAND:2 == 0
			CFLAG:ARG:입력행동 = 224
		ELSE
			CFLAG:ARG:입력행동 = 205
		ENDIF
	;타격
	ELSEIF RAND:2 == 0
		IF RAND:3 == 0
			CFLAG:ARG:입력행동 = 3
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = 15
		ELSE
			CFLAG:ARG:입력행동 = 29
		ENDIF
	;전술
	ELSE
		IF RAND:2 == 0
			CFLAG:ARG:입력행동 = 327
		ELSE
			CFLAG:ARG:입력행동 = 348
		ENDIF
	ENDIF
	;ここでスキル番号を行動内容に代入
	SIF CFLAG:ARG:타겟 == -1
		GOTO DECIDE_ACTION
	CFLAG:ARG:입력행동 = LOCAL:1
ELSE
	$DECIDE_ACTION
	CALL ランダム行動, ARG
	RETURN 1
ENDIF
