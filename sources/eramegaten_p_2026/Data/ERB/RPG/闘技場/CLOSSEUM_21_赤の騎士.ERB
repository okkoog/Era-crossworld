;=======================================================================
;レッドライダー行動パターン
;=======================================================================
@SET_ACTION_闘技場レッドライダー,ARG
#DIM DYNAMIC LCOUNT
CFLAG:ARG:입력행동 = 0
CFLAG:ARG:타겟 = 0
;HPが半分以下の場合は眼光の判定を行う
IF RAND:3 == 0 && 現HP割合(ARG) < 50 && CFLAG:ARG:추가행동횟수 == 0
	CFLAG:ARG:입력행동 = [[스킬:용의안광]]
;４分の１でデカジャチェック
ELSEIF RAND:3 == 0
	FOR LCOUNT, 7, 17
		SIF !IS_TARGET_ABLE(POS(LCOUNT))
			CONTINUE
		SIF GET_カジャンダ_MIN(POS(LCOUNT)) >= 0
			CONTINUE
		CFLAG:ARG:입력행동 = [[스킬:데・쿤다]]
		BREAK
	NEXT
ENDIF
IF CFLAG:ARG:입력행동 == 0
	SELECTCASE RAND:100
		CASE IS < 10
			CFLAG:ARG:입력행동 = 0
		CASE IS < 30
			CFLAG:ARG:입력행동 = [[스킬:테러소드]]
		CASE IS < 50
			CFLAG:ARG:입력행동 = [[스킬:악마의일갈]]
		CASE IS < 60
			CFLAG:ARG:입력행동 = [[스킬:썬더볼트]]
		CASE IS < 70
			CFLAG:ARG:입력행동 = [[스킬:마하・잔다인]]
		CASEELSE
			FOR LCOUNT, 7, 17
				SIF POS(LCOUNT) >= 0
					CONTINUE
				BREAK
			NEXT
			IF LCOUNT == 17
				CFLAG:ARG:입력행동 = 0
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:소환]]
			ENDIF
	ENDSELECT
ENDIF

CALL CHECK_ACTIONABLE,ARG,CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
SIF CFLAG:ARG:타겟 == 0
	CALL RANDOM_TARGET,ARG,CFLAG:ARG:입력행동
RETURN 0

