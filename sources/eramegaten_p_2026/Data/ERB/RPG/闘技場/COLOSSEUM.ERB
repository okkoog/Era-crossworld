@SHOPCOMABLE_102
#DIM LCOUNT
SIF !IS_USEABLE_SHOPCOM
	RETURN 0
RESULT:1 = 1
RESULTS = 콜로세움참가
SIF FLAG:콜로세움참가완료
	RETURN 0
;あなたが臨月だと不可
SIF (TALENT:MASTER:임신 && CFLAG:MASTER:출산예정일 - 2 <= DAY)
	RETURN 0
;あなた育児中だと不可
SIF TALENT:MASTER:육아중
	RETURN 0
;パーティに一人以上いるなら
LOCAL = 0
FOR LCOUNT, 0, CHARANUM
	SIF CFLAG:LCOUNT:PT플래그 == 2
		LOCAL += 1
NEXT
IF LOCAL > 0
	RETURN 1
ELSE
	RETURN 0
ENDIF


@SHOW_COLOSSEUM
CUSTOMDRAWLINE =

FOR LOCAL, 0, 999
	TFLAG:LOCAL = 0
	RESULTS = 
	TRYCCALLFORM PLAYABLE_COLOSSEUM_{LOCAL}
		IF RESULT
			TFLAG:LOCAL = 1
			IF RESULTS != ""
				SIF ANNOUNCE_COLOSSEUM_APPEARED:LOCAL == 2
					ANNOUNCE_COLOSSEUM_APPEARED:LOCAL = 3
				SIF ANNOUNCE_COLOSSEUM_APPEARED:LOCAL == 3
					SETCOLOR COLOR("p-green")
				PRINTFORML [{LOCAL,3}] - %RESULTS%
				RESETCOLOR
			ENDIF
		ENDIF
	CATCH
		
	ENDCATCH
NEXT

@SHOP_COM_102, ARG
CALL SHOW_COLOSSEUM
PRINTL [1000] 돌아간다

DRAWLINE
PRINTL 어느 시합에 출전하시겠습니까？

$INPUT_LOOP
INPUT
IF RESULT == 1000
	FLAG:SHOP커맨드 = 0
	RETURN 0
ELSEIF RESULT < 0 || RESULT >= VARSIZE("TFLAG")
	GOTO INPUT_LOOP
ELSEIF TFLAG:RESULT > 0 || IS_DEBUG 
	FLAG:진행중콜로세움 = RESULT
	CALL STARTUP_RPG_SHOPCOM
	TRYCALLFORM COLOSSEUM_{FLAG:진행중콜로세움}
	SIF RESULT >= 0
		FLAG:콜로세움참가완료 = 1
	FOR LOCAL,0,CHARANUM
		CALL TRANS_DEVIL , LOCAL , 0, "変身解除"
	NEXT
	FLAG:진행중콜로세움 = 0
	FLAG:SHOP커맨드 = 0
	;---- EDIT 002 ADD START -------------------------
	SIF FLAG:전생리스타트예약
		RETURN 0
ELSE
	GOTO INPUT_LOOP
ENDIF

VARSET TFLAG,-1
RETURN 0


;====================================================================
;투기장패배
;====================================================================
@LOSE_COLOSSEUM
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM LINE
#DIM 元TARGET
LOCALS = 0
FOR LOCAL, 1, 10
	RESULT = 0
	TRYCALLFORM CL_LOSE_ABLE_{LOCAL}
	SIF RESULT
		LOCALS += @"/{LOCAL}"
NEXT
TFLAG:투기장패배 = TOINT(RAND_SPLIT(LOCALS, "/"))
;入場者などの描写
CALLFORM CL_LOSE_START_{TFLAG:투기장패배}
CUSTOMDRAWLINE ・
元TARGET = TARGET
FOR LOCAL, 1, 7
	TARGET = POS(LOCAL)
	SIF TARGET < 0
		CONTINUE
	CALL KOJO_MESSAGE_LOSE_COLOSSEUM
	PRINTL 
	DRAWLINE
NEXT
TARGET = 元TARGET
CUSTOMDRAWLINE ・
;末路などの描写
CALLFORM CL_LOSE_END_{TFLAG:투기장패배}
CALL GAME_OVER

@MESSAGE_LOSE_COLOSSEUM
CALLFORM CL_LOSE_MAIN_{TFLAG:투기장패배}

