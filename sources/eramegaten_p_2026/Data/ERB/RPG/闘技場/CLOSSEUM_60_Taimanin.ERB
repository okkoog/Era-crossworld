@SET_ACTION_9000,ARG
#DIM CHARA

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1


SELECTCASE 現HP割合(ARG)
CASE IS > 50
	SELECTCASE RAND:100
		CASE IS < 20
			;20%で風切り
			CFLAG:ARG:입력행동 = [[스킬:일도류・바람베기]]
		CASE IS < 30
			;10％で楓ノ型
			CFLAG:ARG:입력행동 = [[스킬:일도류・바람의형]]
		CASE IS < 40
			IF !CFLAG:ARG:気合フラグ
				;10％で気合フラグが無ければ気合
				CFLAG:ARG:입력행동 = [[스킬:기합]]
			ELSE
				;上でなければ楓ノ型
				CFLAG:ARG:입력행동 = [[스킬:일도류・바람의형]]
			ENDIF
		CASE IS < 100
			;60%で一ノ型
			CFLAG:ARG:입력행동 = [[스킬:일도류・제1형]]
	ENDSELECT

CASE IS <= 50
	;体力50％未満で行動回数増加・奥義解放・パッシブスキル「인법・공둔의술」해방
	;各ターン最初の行動で、胡蝶獄門と胡蝶乱舞を交互に１回のみ
	;１more時は通常スキルを発動する
	IF CFLAG:ARG:행동한횟수 == 0 && CFLAG:ARG:１more플래그 == 0
		IF (FLAG:경과턴수) % 2 == 0
			CFLAG:ARG:입력행동 = [[스킬:일도류오의・호접옥문]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:일도류・호접난무]]
		ENDIF
	ELSE
		SELECTCASE RAND:100
			CASE IS < 10 && !CFLAG:ARG:気合フラグ
				;10％で気合フラグが無ければ気合
				CFLAG:ARG:입력행동 = [[스킬:기합]]
			CASE IS < 40
				;30％で楓ノ型
				CFLAG:ARG:입력행동 = [[스킬:일도류・바람의형]]
			CASE IS < 70
				;30%で風切り
				CFLAG:ARG:입력행동 = [[스킬:일도류・바람베기]]
			CASE IS < 100
				;30%で一ノ型
				CFLAG:ARG:입력행동 = [[스킬:일도류・제1형]]
		ENDSELECT
	ENDIF
ENDSELECT

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1