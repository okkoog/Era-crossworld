;=======================================================================
;ブラックライダー行動パターン
;=======================================================================
@SET_ACTION_闘技場ブラックライダー,ARG
#DIM DYNAMIC LCOUNT
CFLAG:ARG:입력행동 = 0
CFLAG:ARG:타겟 = 0
;HPが半分以下の場合は眼光の判定を行う
SIF RAND:2 == 0 && 現HP割合(ARG) < 50 && CFLAG:ARG:추가행동횟수 == 0
	CFLAG:ARG:입력행동 = [[스킬:용의안광]]
SIF FLAG:경과턴수 == 0 && CFLAG:ARG:행동한횟수 == 0
	CFLAG:ARG:입력행동 = [[스킬:혼의밸런스]]
IF CFLAG:ARG:입력행동 == 0
	SELECTCASE RAND:100
		CASE IS < 10
			CFLAG:ARG:입력행동 = 0
		CASE IS < 30
			CFLAG:ARG:입력행동 = [[스킬:혼의밸런스]]
		CASE IS < 40
			CFLAG:ARG:입력행동 = [[스킬:대냉계]]
		CASE IS < 50
			CFLAG:ARG:입력행동 = [[스킬:마하무드온]]
		CASE IS < 70
			CFLAG:ARG:입력행동 = [[스킬:메기도라]]
		CASEELSE
			FOR LCOUNT, 7, 17
				SIF POS(LCOUNT) >= 0
					CONTINUE
				BREAK
			NEXT
			IF LCOUNT == 17
				CFLAG:ARG:입력행동 = 0
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:소환]]
			ENDIF
	ENDSELECT
ENDIF

CALL CHECK_ACTIONABLE,ARG,CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
SIF CFLAG:ARG:타겟 == 0
	CALL RANDOM_TARGET,ARG,CFLAG:ARG:입력행동
RETURN 0

