


	
;============================================================================================================================================
;条件
;============================================================================================================================================
@GET_REQUEST_NAME_13
#FUNCTIONS
RESULTS_F '= "姫巫女救出依頼"
RETURNF RESULTS_F

@PLAYABLE_REQUEST_13
IF 依頼フラグ:[[依頼:공주무녀구출의뢰]]:0 == 0 && FLAG:명성 >= 150
	依頼フラグ:[[依頼:공주무녀구출의뢰]]:0 = 1
ENDIF
IF GROUPMATCH(依頼フラグ:[[依頼:공주무녀구출의뢰]]:0 , 1 , 2 , 3 , 4)
	RESULTS = 공주 무녀 구출 의뢰
	RETURN 1
ELSEIF 依頼フラグ:[[依頼:공주무녀구출의뢰]]:0 == 5
	RESULTS = 야마토신족 해방
	RETURN 1
ENDIF

;====================================================================================================================================================================================
;説明
;====================================================================================================================================================================================
@EXPLAIN_REQUEST_13
SELECTCASE 依頼フラグ:[[依頼:공주무녀구출의뢰]]:0
	CASE 1
		PRINTL
		PRINTL 메이지신궁을 거점으로 하는 퇴마조직 "신궁의 숲"이 전날 적대 조직의 습격을 받아、메이지 신궁이 제압되어 버렸다。
		PRINTL 현재、메시아교의 거점에 "신궁의 숲"의 수장인 공주 무녀,「히메미야 키쿠에」를 감금하고 있다고 한다。
		PRINTL 그녀를 구출해、의뢰인에게 데려오길 바란다
		PRINTL 의뢰인：히루코라 자칭하는 인물
		PRINTL
	CASE 2
		PRINTL
		PRINTL 팩토리 에어리어로 가서、공주 무녀「히메미야 키쿠에」를 구출하자。
		PRINTL 협력자와는 팩토리ㆍ타운의 술집에서 합류할 수 있는 것 같다。
		PRINTL 그 후의 지시는 구출 후에 전해 주는 것 같다。
		PRINTL
		RETURN 1
	CASE 3
		PRINTL
		PRINTL 의뢰받은 대로,「히메미야 키쿠에」를 구출했다。
		PRINTL 향후의 지시를 의뢰인에게 받았다。
		PRINTL
	CASE 4
		PRINTL
		PRINTL 히루코라 자칭하는 의뢰인은、아카사카의 지하에 잠복하고 있는 것 같다。
		PRINTL 의뢰받은 대로、히메미야 키쿠에를 그에게 데려다 주자。
		PRINTL
		RETURN 1
	CASE 5
		PRINTL
		PRINTL 향후 쿠니츠신(국진신)ㆍ아마츠신(천진신)의 해방에 관한 이벤트는 이 항목에서 실행합니다
		PRINTL 현재 이 앞은 실장되어 있지 않습니다
		PRINTL
		RETURN 1
ENDSELECT




