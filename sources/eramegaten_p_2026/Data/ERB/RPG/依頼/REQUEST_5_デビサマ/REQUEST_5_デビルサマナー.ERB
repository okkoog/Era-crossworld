;====================
;関連フラグリスト
;====================
;====================
;조건
;====================
@GET_REQUEST_NAME_5
#FUNCTIONS
RESULTS_F '= "데빌서머너"
RETURNF RESULTS_F

@PLAYABLE_REQUEST_5
SELECTCASE 依頼フラグ:[[依頼:데빌서머너]]:0
	CASE 0
		IF IS_CLEARED_FIRST_DUNGENON()
			RESULTS = 교수댁 조사 의뢰
			RETURN 1
		ENDIF
	CASE 1
		IF ダンジョンフラグ:49:0 == 1
			RESULTS = 교수의 은신처
			RETURN 1
		ENDIF
	CASE 2
		;IF ダンジョンフラグ:81:0 == 1
		IF ダンジョンフラグ:79:0 == 1
			RESULTS = 불온분자 배제
			RETURN 1
		ENDIF
	CASE 3
		;古墳迷宮クリア：エンディング
		IF ダンジョンフラグ:85:0 == 1
			RESULTS = 데빌서머너
			RETURN 1
		ENDIF

ENDSELECT
RETURN 0

@EXPLAIN_REQUEST_5
IF 依頼フラグ:[[依頼:데빌서머너]]:0 == 0
	CALL EXPLAIN_REQUEST_5_1
ELSEIF 依頼フラグ:[[依頼:데빌서머너]]:0 == 1 && ダンジョンフラグ:49:0 == 1
	CALL EXPLAIN_REQUEST_5_2
ELSEIF 依頼フラグ:[[依頼:데빌서머너]]:0 == 2 && ダンジョンフラグ:79:0 == 1;&& ダンジョンフラグ:81:0 == 1
	CALL EXPLAIN_REQUEST_5_3
ELSEIF 依頼フラグ:[[依頼:데빌서머너]]:0 == 3 && ダンジョンフラグ:85:0 == 1
	CALL EXPLAIN_REQUEST_5_4
ENDIF

@REQUEST_5
IF 依頼フラグ:[[依頼:데빌서머너]]:0 == 0
	CALL REQUEST_5_1
ELSEIF 依頼フラグ:[[依頼:데빌서머너]]:0 == 1 && ダンジョンフラグ:49:0 == 1
	CALL REQUEST_5_2
ELSEIF 依頼フラグ:[[依頼:데빌서머너]]:0 == 2 && ダンジョンフラグ:79:0 == 1;&& ダンジョンフラグ:81:0 == 1
	CALL REQUEST_5_3
ELSEIF 依頼フラグ:[[依頼:데빌서머너]]:0 == 3 && ダンジョンフラグ:85:0 == 1
	CALL REQUEST_5_4
	;ここには来ないはずだが念のため
	依頼フラグ:[[依頼:데빌서머너]]:0 = 4
ENDIF
CALL RESET_ANNOUNCE_FLAG