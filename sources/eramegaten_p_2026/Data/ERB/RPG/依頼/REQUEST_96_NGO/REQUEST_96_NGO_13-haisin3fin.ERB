			CALL SET_ACTION_SKILL, ARG, [[스킬:컨센트레이트]]
		ELSE
			CALL ランダム行動 , ARG
		ENDIF
	;4n+0
	ELSEIF (FLAG:경과턴수) % 4 == 3
		IF CFLAG:ARG:행동한횟수 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:랜더마이저]]
		ELSEIF RAND:3 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:컨센트레이트]]
		ELSE
			CALL ランダム行動 , ARG
		ENDIF
	;1以外の4n+1
	ELSEIF (FLAG:경과턴수) % 4 == 0
		IF CFLAG:ARG:행동한횟수 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:데・카쟈]]
		ELSEIF RAND:3 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:컨센트레이트]]
		ELSE
			CALL ランダム行動 , ARG
		ENDIF
	ENDIF

