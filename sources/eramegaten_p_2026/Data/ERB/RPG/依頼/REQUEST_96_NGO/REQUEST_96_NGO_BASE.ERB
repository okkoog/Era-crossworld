;====================
;流れ・フラグリスト
;====================
;１：NGO_01
;ダンジョンフラグ:42:80 ==  0　未起動
;ダンジョンフラグ:42:80 ==  1　１完了、帰りにスタンバイ
;ダンジョンフラグ:42:80 == 99　ブレイク
;ダンジョンフラグ:42:80 == 98　正常完了
;
;２：NGO_02
;ターンエンドイベント１　頭にジェルばんわの配信１
;依頼フラグ:[[依頼:NGO의뢰]]:0 = 2　ターンエンド1完了

;ダンジョンフラグ:42:80 ==  98　２が完了
;依頼フラグ:[[依頼:NGO의뢰]]:0 = 1

;３：NGO_03
;依頼イベント１　エクソシスト募集
;依頼フラグ:[[依頼:NGO의뢰]]:0 = 3　依頼イベント2エクソシスト完了
;
;４：NGO_04　明日イカないと消える配信２
;依頼フラグ:[[依頼:NGO의뢰]]:0 = 4　ターンエンド2新宿出現配信完了

;５：NGO_05　AION or TENCHAN
;依頼フラグ96:0 = 5 　NGOルート１侵入
;依頼フラグ96:0 = 21　AIONルート１侵入


;Tenchanルート
;仮に5とする

;依頼フラグ96:0 = 5 　NGOルート１　愛が足りないッピ
;依頼フラグ96:0 = 6 　NGOルート２　愛が足りて夜の配信完了。
;依頼フラグ96:0 = 7 　NGOルート３　真実をお話します完了


;Aionルート
;仮に21とする
;====================
;条件
;====================
@GET_REQUEST_NAME_96
#FUNCTIONS
RESULTS_F '= "NGO의뢰"
RETURNF RESULTS_F

@PLAYABLE_REQUEST_96
#DIM TENCHAN
#DIM LCOUNT

TENCHAN = GETCHARA([[キャラ:초텐짱]])
SELECTCASE 依頼フラグ:[[依頼:NGO의뢰]]:0
	CASE 2
		;ブレイク時なし
		IF ダンジョンフラグ:42:80 == 99
		;頭にジェルばんわ完了してる
		ELSE
			RESULTS = （EX:N.G.O）급구：엑소시스트
			RETURN 1
		ENDIF
	CASE 4
			;コレを見た当日のみ
			IF GET_FLAG_TURNEND_EV("NGOターンエンド１", "アルタ開始日") == DAY
				RESULTS = （EX:N.G.O）신주쿠 알타 앞으로 와줄 수 있어?
				RETURN 1
			ENDIF
	CASE 5
		IF 陥落(TENCHAN) == 0
			RESULTS = （EX:N.G.O）사랑이 부족하다구!
			RETURN 1
		ENDIF
	CASE 6
			RESULTS = （EX:N.G.O）【진실을】설정자료집 증정회【말씀드립니다……】
			RETURN 1
	CASE 7
			RESULTS = （EX:N.G.O）나를 패러다임 X로 데려가줘%UNICODE(0x2661)%
			RETURN 1
	CASE 8
			RESULTS = （EX:N.G.O）전파, 닿았어?
			RETURN 1
	CASE 9
			RESULTS = （EX:N.G.O）어른의 힘이란 건 대단해ー
			RETURN 1
	CASE 10
			RESULTS = （EX:N.G.O）bye bye ten-chan
			RETURN 1
	CASE 11
			IF EXP:TENCHAN:라이브경험 < 30 && ABL:TENCHAN:가창기능 < 5
				RESULTS = （EX:N.G.O）너와 함께%UNICODE(0x2020)%승천%UNICODE(0x2020)%하고 싶어……
			ELSE
				RESULTS = （EX:N.G.O）내 이름을 불러줘
			ENDIF
			RETURN 1
	CASE 12
			RESULTS = （EX:N.G.O）【막간】지금, 나의 소원이 이루어진다면
			RETURN 1
	CASE 13
		;トゥルーフラグ３、つまり全回収以上
		IF 依頼フラグ:[[依頼:NGO의뢰]]:1 >= 3
			RESULTS = （EX:N.G.O）승천：내 노래를 모두 네게 줄게
		ELSE
			RESULTS = （EX:N.G.O）종언：경계 없는 세계
		ENDIF
			RETURN 1

ENDSELECT
RETURN 0

@EXPLAIN_REQUEST_96
#DIM TENCHAN
TENCHAN = GETCHARA([[キャラ:초텐짱]])
IF 依頼フラグ:[[依頼:NGO의뢰]]:0 == 2
