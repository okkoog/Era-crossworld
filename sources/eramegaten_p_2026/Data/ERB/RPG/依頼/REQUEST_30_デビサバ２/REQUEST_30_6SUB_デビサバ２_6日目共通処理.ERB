		;氷結衝撃無効
		BASE:(CHARANUM-1):빙결 = 0
		BASE:(CHARANUM-1):충격 = 0
		
		;スキル構成は原作戦闘時を参考
		ABL:(CHARANUM - 1):스킬1 = [[스킬:팔상발파]]
		ABL:(CHARANUM - 1):스킬2 = [[스킬:마하・잔다인]]
		ABL:(CHARANUM - 1):스킬3 = [[스킬:메・디아라마]]
		ABL:(CHARANUM - 1):스킬4 = [[스킬:삼할의활천]]
