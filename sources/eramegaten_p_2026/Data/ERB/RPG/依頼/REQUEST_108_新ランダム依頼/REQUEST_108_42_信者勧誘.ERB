@TITLE_RANDOM_REQUEST_108_42
RESULTS = 신자 권유（난이도 ☆☆）
RETURN 1

;説明===================================================================
@REQUEST_EXPLAIN_108_42
PRINTL 
PRINTL 【의뢰주】메시아교
PRINTL 
PRINTL 　어느 인물에게 매료 마법을 걸어 CHARM 상태로 만들어라.
PRINTL 
PRINTL
PRINTL 【작전영역】	시가지
PRINTL 【적의 전력】	사회인
PRINTL 【성공조건】	목표를 CHARM 상태로 만든다
PRINTL 【주의사항】	쓰러뜨려 버리면 실패가 됩니다.
PRINTL 
PRINTL 
;内容====================================================================
@REQUEST_108_42
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", @"%CALLNAME:MASTER%에게는 어떤 인물을 권유하는 데 협력해 주셔야겠습니다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", "저희의 자금원 중 하나로 신도분들의 기부가 있었습니다만/최근 기부 금액에 제한을 두는 법률이 제정되려 하고 있습니다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", "신도분들의 기부는 그분들의 신앙심의 표현이며, 세속의 법으로 제한받을 이유는 없습니다만/유감스럽게도 이 나라는 이러한 신앙의 형태에 무지합니다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", "안타깝지만, 법률이 제정되는 것은 피할 수 없을 것 같습니다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", "그렇기에 현재 기부를 하려고 생각 중인 신도분들께는/기부를 서둘러 주실 필요가 있습니다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", "실은 어느 자산가분이 저희 가르침에 관심을 두고 계신다는 이야기가 있었습니다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", "평소라면 저희가 직접 확실하게 가르침을 전하여 신도가 되어 주시고/그 결과로서 기부해 주십니다만, 지금은 시간이 없습니다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", "이분이 저희 신도가 되는 것을 앞당기기 위해, 매료 마법을 걸어 주십시오./그 후 저희가 이분께 가르침을 내릴 것입니다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", "아아, 오해하지는 말아 주세요. 이것은 세뇌가 아닙니다/단지 저희 신도가 되는 시기가 조금 빨라질 뿐인 것입니다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", "그럼, 잘 부탁드립니다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, ,"BLANK", "", "MESSAGE", "＞………………", , , , , 4
CALL MESSAGE_WINDOW_ICON, ,"BLANK", "", "MESSAGE", "＞목표인 자산가의 저택 근처까지 왔다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, ,"BLANK", "", "MESSAGE", "＞숨어서 저택을 관찰해 보니, 예상대로 경비원이 경비하고 있다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, ,"BLANK", "", "MESSAGE", "＞이곳은…", , , , , 4
CALL INPUT_YN_M , "몰래 숨어든다（속도로 판정）" , "강행 돌파한다（전투）" , , , , 4
;忍び込む
IF RESULT == 0
	CALL MESSAGE_WINDOW_ICON, ,"BLANK", "", "MESSAGE", "＞………………", , , , , 4
	;成功(速さが10以上で確実に成功）
	IF RAND:10 <= BASE:MASTER:속도
		CALL MESSAGE_WINDOW_ICON, ,"BLANK", "", "MESSAGE", @"＞%CALLNAME:MASTER%은(는) 저택에 몰래 숨어드는 데 성공했다.", , , , , 4
		依頼フラグ:[[依頼:랜덤의뢰]]:4 = 2
	;失敗
	ELSE
		CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "경비원", @"응? …누구냐! 거기 있는 녀석은!!", , , , , 4
		CALL MESSAGE_WINDOW_ICON, ,"BLANK", "", "MESSAGE", @"＞경비원에게 들키고 말았다. 쓰러뜨리고 나아갈 수밖에 없다.", , , , , 4
		依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
	ENDIF
;強行突破する
ELSE
	CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "경비원", @"응? …방문객인가? 약속은…", , , , , 4
	CALL MESSAGE_WINDOW_ICON, ,"BLANK", "", "MESSAGE", @"＞%CALLNAME:MASTER%은(는) 경비원에게 덤벼들었다.", , , , , 4
	依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
ENDIF

;ガードマンと戦闘	
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	;戦闘設定
	FLAG:도주불가플래그 = 1
	FLAG:회화불능플래그 = 1
	FLAG:선제기습취소 = 1
	;位置9にブラックマンをLv15で人間(1)として雑魚(0)として配置
	CALL SET_ENEMY,9,[[キャラ:블랙맨]],15,1,0
	;名前をガードマンに変更
	NAME:(CHARANUM-1) = ガードマン
	CALLNAME:(CHARANUM-1) = ガードマン
	;スキルを変更
	ABL:(CHARANUM-1):스킬2 = [[스킬:기합]]
	ABL:(CHARANUM-1):스킬3 = [[스킬:연속사격]]
	;変更内容を反映
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
	;戦闘開始
	CALL BATTLE_START
	FLAG:도주불가플래그 = 0
	FLAG:회화불능플래그 = 0
	FLAG:선제기습취소 = 0
	依頼フラグ:[[依頼:랜덤의뢰]]:4 = 2
ENDIF

;資産家と戦闘
CALL MESSAGE_WINDOW_ICON, ,"BLANK", "", "MESSAGE", @"＞%CALLNAME:MASTER%이(가) 저택 안으로 침입하자 목표인 자산가를 바로 발견했다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "자산가", "응? 자네는 대체…", , , , , 4
;戦闘設定
FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1
;位置9に無名の社会人をLv1で人間(1)として雑魚(0)として配置
CALL SET_ENEMY,9,[[キャラ:무명의사회인]],1,1,0
;名前を資産家に変更
NAME:(CHARANUM-1) = 資産家
CALLNAME:(CHARANUM-1) = 資産家
;資産家のステータスを変更（破魔無効）
FOR LOCAL:1, 40, 58
	BASE:(CHARANUM-1):(LOCAL:1) = 100
NEXT
BASE:(CHARANUM-1):파마 =0
;思考パターンを設定
CSTR:(CHARANUM-1):사고패턴 = 資産家_ランダム依頼４２
;変更内容を反映
CALL SYNC_STATUS,(CHARANUM-1)
CALL HEALTH_CHARA,(CHARANUM-1)
;戦闘開始
CALL BATTLE_START
FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0

;依頼終了
;成功
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 3
	CALL MESSAGE_WINDOW_ICON, ,"BLANK", "", "MESSAGE", "＞의뢰에 성공했다.", , , , , 4
	;報酬
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 2;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 0;그외
	CALL PRIZE_REQUEST_108
;失敗
ELSE
	CALL MESSAGE_WINDOW_ICON, ,"BLANK", "", "MESSAGE", "＞의뢰에 실패했다.", , , , , 4
ENDIF

;資産家の戦闘行動====================================================================
@SET_ACTION_資産家_ランダム依頼４２, ARG
CFLAG:ARG:입력행동 = [[스킬:도주]]
RETURN 1

;戦闘中行動終了時処理====================================================================
@EVENT_BATTLE_ACTEND_REQUEST_108_42
IF CFLAG:POS(9):상태이상 == GET_STATE_NUM("CHARM") && 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 2
	LOCALS = 목표를 매료 상태로 만들었다.
	CALL MESSAGE_B(1, LOCALS)
	依頼フラグ:[[依頼:랜덤의뢰]]:4 = 3
	FLAG:승리플래그 = 1
ENDIF
