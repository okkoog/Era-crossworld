;ダンジョン名=============================================================
@DUNGEON_NAME_108_6
#FUNCTIONS
RESULTS_F = 댐 지하 시설

;攻略開始時のイベント=====================================================
@EVENT_DUNGEON_START_108_6
CALL MESSAGE_WINDOW_D, "" , @"＞연구원이 숨어든 댐 내부로 침입했다。", , , , , 4

;ダンジョン内イベント
@DUNGEON_EVENT_108_6
SELECTCASE FLAG:현M
	CASE 5
		IF FLAG:현X == 2 && FLAG:현Y == 2
			CALL MESSAGE_WINDOW_D, "" ,@"＞댐 하부 발전시설로 돌입하자 다수의 머신이 도사리고 있었다。", , , , , 4
			CALL MESSAGE_WINDOW_D, "" ,@"안쪽에서 백의의 사내가 아타셰케이스를 소중한 듯 껴안고 있다。", , , , , 4
			CALL MESSAGE_WINDOW_D, "메시아교 연구원" ,@"왔구나……！ 하지만 이 물건을 넘겨줄 성 싶으냐！/가라！ 놈을 갈기갈기 찢어버려라！", , , , , 4
			CALL MESSAGE_WINDOW_D, "" ,@"＞머신들이 덤벼들었다！", , , , , 4
			FLAG:도주불가플래그 = 1
			FLAG:회화불능플래그 = 1
			FLAG:선제기습취소 = 1
			FOR LOCAL, 7, 11
				CALL SET_ENEMY, LOCAL ,[[キャラ:라비]],23+RAND:5,1,0
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
			NEXT
			
			CALL SET_ENEMY, 9 ,[[キャラ:비트볼]],20+RAND:5,1,0
			CALL SYNC_STATUS,(CHARANUM-1)
			CALL HEALTH_CHARA,(CHARANUM-1)
			
			CALL SET_ENEMY, 14 ,[[キャラ:다크서머너]],15+RAND:5,1,0
			NAME:(CHARANUM-1) = 研究員
			CALLNAME:(CHARANUM-1) = 研究員
			CALL SYNC_STATUS,(CHARANUM-1)
			CALL HEALTH_CHARA,(CHARANUM-1)
			CALL BATTLE_START
			FLAG:도주불가플래그 = 0
			FLAG:회화불능플래그 = 0
			FLAG:선제기습취소 = 0
			CALL MESSAGE_WINDOW_D, "" ,@"＞시설을 점거하고 있던 연구원을 쓰러뜨렸다。", , , , , 4
			依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
			FLAG:탈출 = 1
		ENDIF
ENDSELECT

;脱出時のイベント==========================================================
@DUNGEON_RESULT_108_6
;報酬
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 3;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 1;依頼主：メシア教
	CALL PRIZE_REQUEST_108
;ダンジョンを出ると依頼キャンセル
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다。"
ENDIF

