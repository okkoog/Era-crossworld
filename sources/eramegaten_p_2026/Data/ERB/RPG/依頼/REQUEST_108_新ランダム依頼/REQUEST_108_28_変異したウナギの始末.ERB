CALL MESSAGE_WINDOW, "장어 양식업자" , @"일부 장어가 MAG를 너무 많이 흡수해 악마 변이를 일으키고 말았습니다。/변이된 장어는 어망에서 탈출해 지금은 하수도에 있는 모양입니다。", , , , , 4
CALL MESSAGE_WINDOW, "장어 양식업자" , @"저희 장어가 일반인을 다치게 하면 회사의 신용 문제가 됩니다。/그렇게 되기 전에 은밀하게 변이된 악마 장어를 퇴치해 주십시오。", , , , , 4
CALL MESSAGE_WINDOW, "" , @"＞【하수도】에 들어갈 수 있게 되었다", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:2 = 1
依頼フラグ:[[依頼:랜덤의뢰]]:3 = 2

;ダンジョン名=============================================================
@DUNGEON_NAME_108_28
#FUNCTIONS
RESULTS_F = 하수도

;攻略開始時のイベント=====================================================
@EVENT_DUNGEON_START_108_28
CALL MESSAGE_WINDOW_D, "" , @"＞악마 변이된 장어를 쫓아 하수도로 침입했다。", , , , , 4;

;ダンジョンでのイベント===================================================
@DUNGEON_EVENT_108_28
CALL MESSAGE_WINDOW, "" , @"＞수로에서 돌연 장어？가 덤벼들었다！", , , , , 4
CALL MESSAGE_WINDOW, "악마 변이된 장어" , @"「키샤아아악！！」", , , , , 4
FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1

FOR LOCAL, 7, 12
	CALL SET_ENEMY, LOCAL ,[[キャラ:웜]],10+RAND:5,0,0
	NAME:(CHARANUM-1) = 悪魔変異ウナギ
	CALLNAME:(CHARANUM-1) = 悪魔変異ウナギ
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
NEXT

CALL BATTLE_START

FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0

CALL MESSAGE_WINDOW, "" , @"＞목표를 격파했다", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
FLAG:탈출 = 1


;脱出時のイベント==========================================================
@DUNGEON_RESULT_108_28
;報酬
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 1;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 0;依頼主：その他
	CALL PRIZE_REQUEST_108
;ダンジョンを出ると依頼キャンセル
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다。"
ENDIF

