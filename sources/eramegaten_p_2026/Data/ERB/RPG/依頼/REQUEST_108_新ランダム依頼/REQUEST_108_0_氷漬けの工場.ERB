;依頼名===================================================================
;依頼難易度は敵の最大レベルによって変動
; 1～10　☆、11～20　☆☆、21～30　☆☆☆、以下略
;ダンジョン攻略が必要な場合は☆が★になる。

@TITLE_RANDOM_REQUEST_108_0
RESULTS = 얼어붙은 공장（난이도 ★★）
RETURN 1

;説明===================================================================
@REQUEST_EXPLAIN_108_0
	PRINTL 
	PRINTL 【의뢰주】과자 메이커 사장
	PRINTL
	PRINTL 　우리 회사의 과자 공장이 돌연 얼어붙고 말았다。
	PRINTL 　아마도 악마의 소행이겠지。제발 도와주게！
	PRINTL
	PRINTL 【작전영역】과자 메이커의 공장
	PRINTL 【적의전력】잭 프로스트（화염、핵열 유효）
	PRINTL 【성공조건】원인의 배제
	PRINTL 【주의사항】던전 공략 필요
	PRINTL 

;内容====================================================================
@REQUEST_108_0
PRINTFORMW 【얼어붙은 제과공장】에 들어갈 수 있게 되었다。
依頼フラグ:[[依頼:랜덤의뢰]]:2 = 1
依頼フラグ:[[依頼:랜덤의뢰]]:3 = 3

;ダンジョン名=============================================================
@DUNGEON_NAME_108_0
#FUNCTIONS
RESULTS_F = 얼어붙은 제과공장

;攻略開始時のイベント=====================================================
@EVENT_DUNGEON_START_108_0
CALL MESSAGE_WINDOW_D, "", @"＞공장 안으로 들어가자、사방이 온통 얼음에 뒤덮여 있다。", , , , , 4

;ダンジョン内イベント=====================================================
@DUNGEON_EVENT_108_0
CALL MESSAGE_WINDOW_D, "" ,@"＞공장 안쪽에서는 잭 프로스트 무리가 제품으로 보이는 과자를 먹어치우고 있었다。", , , , , 4
CALL MESSAGE_WINDOW_D, "잭 프로스트들" ,@"얏호-！히-호-！ 기분 최고다 호-！/과자가 잔뜩이다 호-！", , , , , 4
CALL MESSAGE_WINDOW_D, "" ,@"＞아무래도 과자를 노린 잭 프로스트들이 「이 사태」를 일으킨 모양이다。", , , , , 4
CALL MESSAGE_WINDOW_D, "" ,@"＞그리고、저쪽도 이쪽을 알아차린 것 같다。", , , , , 4
CALL MESSAGE_WINDOW_D, "잭 프로스트들" ,@"음、뭐냐 호？/설마、우리들한테서 여길 빼앗으러 온 거냐 호？", , , , , 4
CALL MESSAGE_WINDOW_D, "잭 프로스트들" ,@"그렇게는 안 둔다 호！/혼내주겠다 호-！", , , , , 4
CALL MESSAGE_WINDOW_D, "" ,@"＞잭 프로스트들이 덤벼들었다！", , , , , 4
FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1
FOR LOCAL:2, 7, 12
	CALL SET_ENEMY, LOCAL:2 ,[[キャラ:잭프로스트]],15+RAND:5,0,0
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
NEXT
CALL BATTLE_START
FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0
CALL MESSAGE_WINDOW_D, "" ,@"＞공장을 점거하고 있던 잭 프로스트들을 쓰러뜨렸다。", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
FLAG:탈출 = 1

;脱出時のイベント==========================================================
@DUNGEON_RESULT_108_0
;報酬
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 2;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 0;依頼主：その他
	CALL PRIZE_REQUEST_108
;ダンジョンを出ると依頼キャンセル
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다。"
ENDIF

;敵の総数==================================================================
@ENEMY_NUM_108_0
RESULTS = 初級
RETURN 0

;敵の種類==================================================================
@ENEMY_108_0
RETURN [[キャラ:잭프로스트]], 13

;フロア名表示===============================================================
@FLOORNAME_108_0
PRINTL 제과공장

;MAP改変=====================================================================
@MAP_CHANGE_108_0
;X == 7,Y == 2にイベント(=4)を設置
CALL SET_TILE, 7 , 2 , , , 4
