CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", @"우리에게 반항하고 질서를 어지럽히는 것이 어떤 결과를 낳는지/그들에게 가르쳐 주십시오。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", @"놈들은 비합법 조직 치고는 얕볼 수 없는 전력을 갖추었으나/어차피 오합지졸에 불과합니다", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", @"%CALLNAME:MASTER%께는 수월한 임무일 터이니、신속하게 처리해 주십시오。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", @"이상입니다、잘 부탁드립니다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "MESSAGE" ,@"＞【점거당한 댐】에 들어갈 수 있게 되었다", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:2 = 1
依頼フラグ:[[依頼:랜덤의뢰]]:3 = 1

;ダンジョン名=============================================================
@DUNGEON_NAME_108_5
#FUNCTIONS
RESULTS_F = 점거당한 댐

;攻略開始時のイベント=====================================================
@EVENT_DUNGEON_START_108_5
CALL MESSAGE_WINDOW_D, "메시아교도" , @"「의뢰를 맡아주신 분이로군요、기다리고 있었습니다。」", , , , , 4
CALL MESSAGE_WINDOW_D, "메시아교도" , @"「적은 안쪽에 진을 치고 있습니다。확실하게 처리해 주십시오。」", , , , , 4

;ダンジョン内イベント=====================================================
@DUNGEON_EVENT_108_5
SELECTCASE FLAG:현M
	CASE 5
		IF FLAG:현X == 2 && FLAG:현Y == 2
			CALL MESSAGE_WINDOW_D, "" , @"＞댐 제어실로 돌입하자 가이아교도가 기다리고 있었다。", , , , , 4
			CALL MESSAGE_WINDOW_D, "가이아교도" ,@"역시 왔군、메시아교의 앞잡이 놈！/어머니 대자연을 파괴하는 짓은 우리가 용납 못 한다！", , , , , 4
			CALL MESSAGE_WINDOW_D, "" , @"＞가이아교도가 덤벼들었다！", , , , , 4
			FLAG:도주불가플래그 = 1
			FLAG:회화불능플래그 = 1
			FLAG:선제기습취소 = 1
			FOR LOCAL:2, 7, 12
				CALL SET_ENEMY, LOCAL:2 ,[[キャラ:모무노후]],25+RAND:5,1,0
				NAME:(CHARANUM-1) = ガイア教徒
				CALLNAME:(CHARANUM-1) = ガイア教徒
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
			NEXT
			CALL BATTLE_START
			
			FLAG:도주불가플래그 = 0
			FLAG:회화불능플래그 = 0
			FLAG:선제기습취소 = 0
			CALL MESSAGE_WINDOW_D, "",@"＞시설을 점거하고 있던 가이아교도들을 쓰러뜨렸다。", , , , , 4
			依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
			FLAG:탈출 = 1
		ENDIF
ENDSELECT


;脱出時のイベント==========================================================
@DUNGEON_RESULT_108_5
;報酬
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 3;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 1;依頼主：メシア教
	CALL PRIZE_REQUEST_108
;ダンジョンを出ると依頼キャンセル
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다。"
ENDIF

