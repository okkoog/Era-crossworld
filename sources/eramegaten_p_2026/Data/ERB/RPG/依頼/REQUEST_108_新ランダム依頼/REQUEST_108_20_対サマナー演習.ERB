	PRINTL 

;内容====================================================================
@REQUEST_108_20
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", @"얼마 전、우리의 지원자로부터 제공받은 템플나이트를 사용하여/실전 연습을 실시합니다。이에 서머너의 협력을 부탁드립니다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", @"내용은 아주 단순합니다。우리가 준비한 템플나이트 부대와 전투를 치러주십시오。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", @"다만、그쪽에서도 진심으로 싸워주지 않으면 의미가 없습니다。/보수는 우리가 패배했을 경우에만 지급하도록 하겠습니다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", @"서머너와의 실전을 거듭하여、악마나 이능자에게 대항할 수 있게 된다면/가이아교나 정부의 타도도 허황된 꿈이 아닙니다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", @"이번 연습은 그 위대한 이상을 향한 한 걸음입니다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", @"장소는 시나가와 근처의 폐기된 조차장을 사용합니다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "メシア教徒", "메시아교도", @"이상입니다、잘 부탁드립니다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "MESSAGE" , @"――폐기된 조차장――", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "MESSAGE" , @"＞지정된 장소에 도착하자、목표로 보이는 템플나이트 집단이 보였다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "MESSAGE" , @"＞집단의 리더로 보이는 사내가 훈시를 하고 있다。", , , , , 4
CALL MESSAGE_WINDOW_ICON,2, "モブ", "テンプルナイト", "템플나이트 대장" ,@"「각원에게 고한다、서로 봐주기 없기다、전력으로 간다」", , , , , 4
CALL MESSAGE_WINDOW_ICON,2, "モブ", "テンプルナイト", "템플나이트 대장" ,@"「이것을 실전이라 생각하라、패배하면 다음은 없다고 생각하라」", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "MESSAGE" , @"＞템플나이트가 이쪽으로 덤벼들었다！", , , , , 4
FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1

FOR LOCAL, 8, 11
	CALL SET_ENEMY, LOCAL ,[[キャラ:자프키엘]],35+RAND:5,1,0
	NAME:(CHARANUM-1) = テンプルナイト
	CALLNAME:(CHARANUM-1) = テンプルナイト
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
NEXT

FOR LOCAL, 13, 16
	CALL SET_ENEMY, LOCAL ,[[キャラ:파워]],34+RAND:5,1,0
	NAME:(CHARANUM-1) = テンプルナイト
	CALLNAME:(CHARANUM-1) = テンプルナイト
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
