@REQUEST_108_15
CALL MESSAGE_WINDOW_ICON, [[キャラ:픽시]], "CSV", "", "픽시", @"우리 거처 중 하나인 숲이 고블린들의 수색을 받고 있어/만약 거처를 들키면 골치 아파진다구。", , , , , 4
CALL MESSAGE_WINDOW_ICON, [[キャラ:픽시]], "CSV", "", "픽시", @"지금은 아직 숲속을 대충대충 뒤지는 모양이라/거처의 정확한 장소까지는 모르는 것 같아。", , , , , 4
CALL MESSAGE_WINDOW_ICON, [[キャラ:픽시]], "CSV", "", "픽시", @"이쪽에서 확인해봤는데、숲에 온 건 정찰병뿐인 것 같아。", , , , , 4
CALL MESSAGE_WINDOW_ICON, [[キャラ:픽시]], "CSV", "", "픽시", @"별것 아닌 전력이지만、우리가 나섰다간 거처의 존재를 알리는 꼴이 되잖아。/상관없는 누군가에게 격퇴를 부탁하는 게 무난하다고 생각해。", , , , , 4
CALL MESSAGE_WINDOW_ICON, [[キャラ:픽시]], "CSV", "", "픽시", @"고블린 정찰부대를 해치워줘/부탁해♪", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "", @"＞【요정의 숲】에 들어갈 수 있게 되었다。", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:2 = 1
依頼フラグ:[[依頼:랜덤의뢰]]:3 = 4

;ダンジョン名=============================================================
@DUNGEON_NAME_108_15
#FUNCTIONS
RESULTS_F = 요정의 숲

;攻略開始時のイベント=====================================================
@EVENT_DUNGEON_START_108_15
CALL MESSAGE_WINDOW_D, "", @"＞요정들이 거처로 삼고 있는 숲으로 발을 들였다。", , , , , 4


;ダンジョン内イベント=====================================================
@DUNGEON_EVENT_108_15
CALL MESSAGE_WINDOW_D, "" ,@"＞고블린 정찰부대가 있다。", , , , , 4
CALL MESSAGE_WINDOW_D, "고블린" ,@"구후후후、빨리 픽시를 ”잡아먹고” 싶다 고브", , , , , 4
CALL MESSAGE_WINDOW_D, "고블린" ,@"음、뭐냐 너、방해된다 고브！꺼져라 고브！", , , , , 4
CALL MESSAGE_WINDOW_D, "" ,@"＞정찰부대가 이쪽으로 덤벼들었다！", , , , , 4

FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1

FOR LOCAL, 8, 11
	CALL SET_ENEMY, LOCAL ,[[キャラ:고블린]],9+RAND:5,0,0
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
NEXT

CALL BATTLE_START

FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0

CALL MESSAGE_WINDOW_D, "" ,@"＞목표를 격파했다。", , , , , 4

依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
FLAG:탈출 = 1

;脱出時のイベント==========================================================
@DUNGEON_RESULT_108_15
;報酬
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 1;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 0;依頼主：その他
	CALL PRIZE_REQUEST_108
;ダンジョンを出ると依頼キャンセル
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다。"
ENDIF

