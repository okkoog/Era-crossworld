; 1～10　☆、11～20　☆☆、21～30　☆☆☆、以下略
;ダンジョン攻略が必要な場合は☆が★になる。

@TITLE_RANDOM_REQUEST_108_32
RESULTS = 지하 동굴 수사（난이도 ★★★）
RETURN 1

;説明===================================================================
@REQUEST_EXPLAIN_108_32
PRINTL 
PRINTL 【의뢰주】교외 지주
PRINTL 
PRINTL 　산의 지하 동굴이 이계화되어, 골머리를 앓고 있다고 한다.
PRINTL 　조사하여, 이계화의 원인을 배제하라.
PRINTL 
PRINTL 【작전영역】지하 동굴
PRINTL 【적의전력】다수의 악마（화염 유효）
PRINTL 【성공조건】목표 격파
PRINTL 【주의사항】던전 공략 필요
PRINTL 

;内容====================================================================
@REQUEST_108_32
CALL MESSAGE_WINDOW, "지주" , @"우리 일족이 소유한 산에 지하 동굴이 있는데/아무래도 「이상한 놈」이 눌러앉은 모양이야。", , , , , 4
CALL MESSAGE_WINDOW, "지주" , @"쫓아내려 해도 동굴은 들어갈 때마다 지형이 바뀌고/괴물들까지 어슬렁거리는 꼴이라 조사조차 못 하고 있는 실정이지。", , , , , 4
CALL MESSAGE_WINDOW, "지주" , @"솜씨에 자신 있지？ 가서 좀 조사해 주지 않겠나。", , , , , 4
CALL MESSAGE_WINDOW, "" , @"＞【지하 동굴】에 들어갈 수 있게 되었다", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:2 = 1
依頼フラグ:[[依頼:랜덤의뢰]]:3 = 6

;ダンジョン名=============================================================
@DUNGEON_NAME_108_32
#FUNCTIONS
RESULTS_F = 지하 동굴

;攻略開始時のイベント=====================================================
@EVENT_DUNGEON_START_108_32
CALL MESSAGE_WINDOW_D, "" , @"＞의뢰가 있었던 지하 동굴로 침입했다/＞명백히 이계화되어 있다……", , , , , 4
CALL MESSAGE_WINDOW_D, "" , @"＞최심부에 있을 이계의 「주인」을 쓰러뜨리면 문제는 해결될 것이다", , , , , 4
CALL MESSAGE_WINDOW_D, "" , @"＞……강렬한 부패취가 코를 찌른다。얼른 끝내도록 하자。", , , , , 4

;ダンジョン内イベント=====================================================
@DUNGEON_EVENT_108_32
CALL MESSAGE_WINDOW_D, "" , @"＞동굴 안쪽에서는 로브를 입은 인물이 의식을 치르고 있었다。", , , , , 4
CALL MESSAGE_WINDOW_D, "사령술사" , @"누구냐…… 내 거처에 발을 들이는 목숨 아까운 줄 모르는 자는……", , , , , 4
CALL MESSAGE_WINDOW_D, "사령술사" , @"뭐 좋다、네놈도 내 수족으로 삼아주마！", , , , , 4
CALL MESSAGE_WINDOW_D, "" , @"＞사령술사가 덤벼들었다！", , , , , 4
FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1

FOR LOCAL, 7, 12
	CALL SET_ENEMY, LOCAL ,[[キャラ:좀비독]],15+RAND:5,1,0
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
NEXT

CALL SET_ENEMY, 14 ,[[キャラ:파계승]],21+RAND:5,1,1
NAME:(CHARANUM-1) = 死霊術師
CALLNAME:(CHARANUM-1) = 死霊術師
CALL SYNC_STATUS,(CHARANUM-1)
CALL HEALTH_CHARA,(CHARANUM-1)

CALL BATTLE_START

FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0

CALL MESSAGE_WINDOW, "" ,@"＞지하 동굴에 눌러앉은 사령술사를 퇴치했다。", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
FLAG:탈출 = 1


;脱出時のイベント==========================================================
@DUNGEON_RESULT_108_32
;報酬
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 2;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 0;依頼主：その他
	CALL PRIZE_REQUEST_108
;ダンジョンを出ると依頼キャンセル
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다。"
ENDIF

;敵の総数==================================================================
@ENEMY_NUM_108_32
RESULTS = 中級
RETURN 0

;敵の種類==================================================================
@ENEMY_108_32
RETURN [[キャラ:좀비독]], 10

;フロア名表示===============================================================
@FLOORNAME_108_32
SELECTCASE FLAG:현M
	CASE 9
		PRINTFORML 지하 동굴 입구
	CASE 0
		PRINTFORML 지하 동굴 최심부
	CASEELSE
		PRINTFORML 지하 동굴 B{(9-(FLAG:현M))}F
ENDSELECT

