	FLAG:도주불가플래그 = 1
	FLAG:회화불능플래그 = 1
	FLAG:선제기습취소 = 1
	FOR  LOCAL, 7, 12
		CALL SET_ENEMY, LOCAL, [[キャラ:루게이에]], 20+RAND:5, 1, 0
		NAME:(CHARANUM-1) = ガイア教徒
		CALLNAME:(CHARANUM-1) = ガイア教徒
		CALL SYNC_STATUS,(CHARANUM-1)
		CALL HEALTH_CHARA,(CHARANUM-1)
	NEXT

	CALL SET_ENEMY, 14, [[キャラ:발람]], 35, 1, 0
	NAME:(CHARANUM-1) = 部隊長
	CALLNAME:(CHARANUM-1) = 部隊長
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)

	CALL BATTLE_START
	FLAG:도주불가플래그 = 0
	FLAG:회화불능플래그 = 0
	FLAG:선제기습취소 = 0
	CALL MESSAGE_WINDOW_D, "MESSAGE" , @"＞가이아교 부대장 중 한 명을 쓰러뜨렸다.", , , , , 4
	ダンジョンフラグ:108:20 += 1
	;！表示を削除
	DA:(FLAG:현X):(FLAG:현Y) = 1

	IF ダンジョンフラグ:108:20 == 3
		CALL MESSAGE_WINDOW_D, "메시아교도의 통신" , @"부대장을 쓰러뜨린 것으로 어딘가에 거점장이 나타났습니다./거점장을 격파해 주십시오.", , , , , 4
		CALL MAKE_FLOOR, FLAG:현던전
		CALL AUTOMAP
	ENDIF
ELSE
