@REQUEST_108_24
CALL MESSAGE_WINDOW, "경찰관" , @"메시아교의 활동이 최근 각지에서 활발해지고 있어、우리는 진압 강화에 나서기로 했습니다。/그 일환으로、각지에 퍼진 놈들의 아지트를 치는 작전을 펼칩니다。", , , , , 4
CALL MESSAGE_WINDOW, "경찰관" , @"이에、놈들의 은신처로 판명된 곳 중 하나인 해안가 폐공장으로 가주셨으면 합니다。/목표는、폐공장에 숨어 있는 전력의 격멸입니다。", , , , , 4
CALL MESSAGE_WINDOW, "경찰관" , @"폐공장은 놈들의 저장고로도 사용되는 모양이라/다수의 물자가 비축되어 있다는 정보도 있습니다。", , , , , 4
CALL MESSAGE_WINDOW, "경찰관" , @"그것들을 발견하면 가능한 한 파괴해 주십시오/임무의 성패와는 관계없지만 보수는 추가해 드리겠습니다。", , , , , 4
CALL MESSAGE_WINDOW, "경찰관" , @"좋은 보고를 기다리겠습니다。이상입니다。", , , , , 4
CALL MESSAGE_WINDOW, "경찰관" , @"【폐공장】에 들어갈 수 있게 되었다", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:2 = 1
依頼フラグ:[[依頼:랜덤의뢰]]:3 = 3

;ダンジョン名=============================================================
@DUNGEON_NAME_108_24
#FUNCTIONS
RESULTS_F = 폐공장

;攻略開始時のイベント=====================================================
@EVENT_DUNGEON_START_108_24
CALL MESSAGE_WINDOW_D, "", @"＞메시아교 거점 중 하나인 폐공장으로 발을 들였다。", , , , , 4
	

;ダンジョン内イベント=====================================================
@DUNGEON_EVENT_108_24
;備蓄物資
IF DA:(FLAG:현X):(FLAG:현Y) == 4
	CALL MESSAGE_WINDOW_D, "" , @"메시아교의 비축물자를 발견하여、파괴했다。", , , , , 4
	ダンジョンフラグ:108:20 += 1
	DA:(FLAG:현X):(FLAG:현Y) = 1
;テンプルナイトx5
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 14
	CALL MESSAGE_WINDOW_D, "" , @"＞폐공장 안에서는 다수의 템플나이트가 경비하고 있었다。", , , , , 4
	CALL MESSAGE_WINDOW_D, "템플나이트" , @"누구냐！ 이곳을 들킨 이상 살려둘 수 없다！", , , , , 4
	CALL MESSAGE_WINDOW_D, "" , @"＞템플나이트가 덤벼들었다。", , , , , 4
	FLAG:도주불가플래그 = 1
	FLAG:회화불능플래그 = 1
	FLAG:선제기습취소 = 1
	FOR  LOCAL:2, 7, 12
		CALL SET_ENEMY, LOCAL:2 ,[[キャラ:템플나이트]],22+RAND:5,0,0
		CALL SYNC_STATUS,(CHARANUM-1)
		CALL HEALTH_CHARA,(CHARANUM-1)
	NEXT
	CALL BATTLE_START			
	FLAG:도주불가플래그 = 0
	FLAG:회화불능플래그 = 0
	FLAG:선제기습취소 = 0
	PRINTFORMW ＞목표 격파에 성공했다。
	依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
	FLAG:탈출 = 1
ENDIF

;脱出時のイベント==========================================================
@DUNGEON_RESULT_108_24
;報酬
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 3 + ダンジョンフラグ:108:20;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 0;依頼主：その他
	CALL PRIZE_REQUEST_108
;ダンジョンを出ると依頼キャンセル
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다。"
ENDIF

;敵の総数==================================================================
@ENEMY_NUM_108_24
RESULTS = 中級
RETURN 0

;敵の種類==================================================================
@ENEMY_108_24
RETURN [[キャラ:템플나이트]], 20

