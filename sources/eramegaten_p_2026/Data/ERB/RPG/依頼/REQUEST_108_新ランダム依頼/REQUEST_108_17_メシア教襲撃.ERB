;依頼名===================================================================
;依頼難易度は敵の最大レベルによって変動
; 1～10　☆、11～20　☆☆、21～30　☆☆☆、以下略
;ダンジョン攻略が必要な場合は☆が★になる。

@TITLE_RANDOM_REQUEST_108_17
RESULTS = 메시아교 습격（난이도 ☆☆☆）
RETURN 1

;説明===================================================================
@REQUEST_EXPLAIN_108_17
	PRINTL 
	PRINTL 【의뢰주】가이아교
	PRINTL 
	PRINTL 　메시아교 창고에 습격을 가할 모양이다。
	PRINTL 　그들에게 협력하여、습격을 성공시켜라。
	PRINTL 
	PRINTL 【작전영역】메시아교 거점
	PRINTL 【적의전력】경비부대（주살 유효）
	PRINTL 【성공조건】경비부대 전멸
	PRINTL

;内容====================================================================
@REQUEST_108_17
CALL MESSAGE_WINDOW_ICON, , "モブ", "ガイア教徒", "가이아교도", @"최근 들어、우리가 소유하고 있는 물자가 바닥을 드러내고 있다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "ガイア教徒", "가이아교도", @"이에、우리는 메시아교가 보유하고 있는 물자 창고를 습격하여/물자를 확보할 계획을 세웠다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "ガイア教徒", "가이아교도", @"더 많은 성과를 올리기 위해、서머너에게 협력을 의뢰하고 싶다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "ガイア教徒", "가이아교도", @"적의 경비부대를 분산시키기 위해、여러 창고를 동시에 습격한다。/서머너에게는 제{1+RAND:3}창고를 담당해 주었으면 한다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "ガイア教徒", "가이아교도", @"또한、본 계획은 창고 내 물자를 손에 넣는 것이 목적이다。/적의 지원군이 오기 전에 필요량의 물자를 확보할 수 없다고 판단되면、작전을 중단하게 된다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "ガイア教徒", "가이아교도", @"전투에 시간을 너무 끌어서 물자를 확보하지 못했다는/그런 일이 없도록 주의해 주게。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "ガイア教徒", "가이아교도", @"그럼、건투를 빈다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "MESSAGE" , @"――메시아교 거점――", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "MESSAGE" , @"＞메시아교의 경비부대가 있다。", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ", "テンプルナイト", "템플나이트" , @"「뭐냐 네놈은！꺼져라！」", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "MESSAGE" , @"＞템플나이트가 이쪽으로 덤벼들었다！", , , , , 4
FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1

FOR LOCAL, 7, 12
	CALL SET_ENEMY, LOCAL ,[[キャラ:템플나이트]],18+RAND:5,1,0
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
NEXT

CALL BATTLE_START

FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0


IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 <= 4
	CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "MESSAGE" , @"＞경비부대를 전멸시켰다。", , , , , 4
	;報酬
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 4;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 2;ガイア教
	CALL PRIZE_REQUEST_108
ELSE
	CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "MESSAGE" , @"＞임무에 실패했다。", , , , , 4
ENDIF


;戦闘中ターン終了時処理=======================================================
@EVENT_BATTLE_TURNEND_REQUEST_108_17
SELECTCASE 依頼フラグ:[[依頼:랜덤의뢰]]:4
	CASE 0
		CALL MESSAGE_B2("가이아교도로부터의 통신", , "　","시간 여유가 별로 없다。서둘러 적을 해치워라。","　")
	CASE 5
		CALL MESSAGE_B2("가이아교도로부터의 통신", , "　","시간이 너무 지체되었다… 작전을 중단한다…","　")
		FLAG:승리플래그 = 1
ENDSELECT
依頼フラグ:[[依頼:랜덤의뢰]]:4 += 1

