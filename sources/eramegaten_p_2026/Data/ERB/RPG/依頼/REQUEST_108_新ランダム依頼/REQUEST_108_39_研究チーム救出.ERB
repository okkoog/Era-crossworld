	CASE 0
		CALL MESSAGE_B2("메시아교도의 통신", , "　","「시간을 낭비하고 있습니다. 가능한 한 전투를 피하여 연구팀이 있는 곳으로 서둘러 주십시오.」","　")
	CASE 5
		CALL MESSAGE_B2("메시아교도의 통신", , "　","「연구팀이 몰리고 있습니다. 서둘러 주십시오.」","　")
	CASE 10
		CALL MESSAGE_B2("메시아교도의 통신", , "　","「연구팀과의 통신이 끊겼습니다… 작전은 실패입니다….」","　")
		FLAG:승리플래그 = 1
		FLAG:탈출 = 1
