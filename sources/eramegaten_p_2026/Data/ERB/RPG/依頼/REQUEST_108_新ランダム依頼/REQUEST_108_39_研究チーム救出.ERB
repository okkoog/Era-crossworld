@EVENT_DUNGEON_START_108_39
CALL MESSAGE_WINDOW_D, "", @"＞산악에 발을 들여놓았다.", , , , , 4


;ダンジョンでのイベント====================================================================
@DUNGEON_EVENT_108_39
CALL MESSAGE_WINDOW_D, "" , @"＞호위 목표인 연구팀이 적 강습부대에게 막다른 곳에 몰려 있다.", , , , , 4
CALL MESSAGE_WINDOW_D, "가이아교도" , @"큭! 구출부대인가…/마침 잘됐군, 여기서 한꺼번에 처리해 주마!", , , , , 4
CALL MESSAGE_WINDOW_D, "" , @"＞가이아교 강습부대가 덮쳐왔다!", , , , , 4
;戦闘開始＆ターン終了時処理をストップ
ダンジョンフラグ:108:21 = 1

FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1
FOR  LOCAL:2, 7, 17
	CALL SET_ENEMY, LOCAL:2 ,[[キャラ:테나가]],18+RAND:5,0,0
	NAME:(CHARANUM-1) = ガイア教徒
	CALLNAME:(CHARANUM-1) = ガイア教徒
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
NEXT
