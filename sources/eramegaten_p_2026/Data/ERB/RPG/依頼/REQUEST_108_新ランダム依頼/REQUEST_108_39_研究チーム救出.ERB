FLAG:선제기습취소 = 0
CALL MESSAGE_WINDOW_D, "연구원" ,@"「이쪽은 전원 무사합니다. 서머너, 구원에 감사드립니다.」", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
FLAG:탈출 = 1


;脱出時のイベント====================================================================
@DUNGEON_RESULT_108_39
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	CALL MESSAGE_WINDOW_D, "" , @"＞목표 구출에 성공했다.", , , , , 4
	;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 2;
	;依頼主：メシア教
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 1
	CALL PRIZE_REQUEST_108
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다."
ENDIF

