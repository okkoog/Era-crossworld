FLAG:탈출 = 1

;脱出時のイベント==========================================================
@DUNGEON_RESULT_108_23
;報酬
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 3;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 2;依頼主：ガイア教
	CALL PRIZE_REQUEST_108
;ダンジョンを出ると依頼キャンセル
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다。"
ENDIF

