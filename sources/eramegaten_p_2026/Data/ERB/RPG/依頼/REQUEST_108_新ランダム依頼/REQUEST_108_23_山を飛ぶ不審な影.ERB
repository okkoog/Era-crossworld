FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1
FOR  LOCAL:2, 7, 17
	CALL SET_ENEMY, LOCAL:2 ,[[キャラ:안주]],26+RAND:5,0,0
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
NEXT
