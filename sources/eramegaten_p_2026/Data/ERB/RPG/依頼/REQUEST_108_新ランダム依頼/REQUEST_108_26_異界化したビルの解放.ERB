;依頼名===================================================================
;依頼難易度は敵の最大レベルによって変動
; 1～10　☆、11～20　☆☆、21～30　☆☆☆、以下略
;ダンジョン攻略が必要な場合は☆が★になる。

@TITLE_RANDOM_REQUEST_108_26
RESULTS = 이계화된 빌딩 해방（난이도 ★★★★）
RETURN 1

;説明===================================================================
@REQUEST_EXPLAIN_108_26
	PRINTL 
	PRINTL 【의뢰주】빌딩 오너
	PRINTL 
	PRINTL 　헐값에 빌딩을 샀으나、안이 이계화되어 있던 모양이다。
	PRINTL 　불쌍한 피해자를 위해 악마를 구제하라。
	PRINTL 
	PRINTL 【작전영역】이계화된 빌딩
	PRINTL 【적의전력】좀비독（화염、파마 유효）
	PRINTL 【성공조건】악마 구제
	PRINTL 【주의사항】던전 공략 필요
	PRINTL 

;内容====================================================================
@REQUEST_108_26
CALL MESSAGE_WINDOW, "빌딩 오너" , @"사기당했어！ 헐값에 빌딩을 손에 넣었다고 생각했더니/괴물들이 배회하고 있어서 안으로 들어갈 수도 없어！", , , , , 4
CALL MESSAGE_WINDOW, "빌딩 오너" , @"이대로라면 막대한 손해야！/제발 괴물들을 어떻게 좀 해줘！", , , , , 4
CALL MESSAGE_WINDOW, "" , @"＞【이계화된 빌딩】에 들어갈 수 있게 되었다", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:2 = 1
依頼フラグ:[[依頼:랜덤의뢰]]:3 = 1

;ダンジョン名=============================================================
@DUNGEON_NAME_108_26
#FUNCTIONS
RESULTS_F = 이계화된 빌딩

;攻略開始時のイベント=====================================================
@EVENT_DUNGEON_START_108_26
CALL MESSAGE_WINDOW_D, "",@"＞이계화된 빌딩으로 침입했다。", , , , , 4


;ダンジョンでのイベント===================================================
@DUNGEON_EVENT_108_26
SELECTCASE FLAG:현M
	CASE 5
		IF FLAG:현X == 6 && FLAG:현Y == 12
			CALL MESSAGE_WINDOW_D, "", "＞이 이계의 주인으로 보이는 악마가 있다", , , , , 4
			CALL MESSAGE_WINDOW_D, "이계의 주인", 	"뭐냐 네놈은！？ 이곳은 우리 거처다！ 나가라！", , , , , 4
			
			FLAG:도주불가플래그 = 1
			FLAG:회화불능플래그 = 1
			FLAG:선제기습취소 = 1
			
			FOR LOCAL:2, 7, 12
				CALL SET_ENEMY, LOCAL:2 ,[[キャラ:좀비독]],9+RAND:5,0,0
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
			NEXT
			CALL SET_ENEMY, 14 ,[[キャラ:마카브르]],18+RAND:5,0,1
			CALL SYNC_STATUS,(CHARANUM-1)
			CALL HEALTH_CHARA,(CHARANUM-1)
			
			CALL BATTLE_START
			
			FLAG:도주불가플래그 = 0
			FLAG:회화불능플래그 = 0
			FLAG:선제기습취소 = 0
			
			CALL MESSAGE_WINDOW_D, "", 			"＞이계화된 빌딩을 해방했다。", , , , , 4
			依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
			FLAG:탈출 = 1
		ENDIF
ENDSELECT

;脱出時のイベント==========================================================
@DUNGEON_RESULT_108_26
;報酬
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 2;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 0;依頼主：その他
	CALL PRIZE_REQUEST_108
;ダンジョンを出ると依頼キャンセル
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다。"
ENDIF

;敵の総数==================================================================
@ENEMY_NUM_108_26
RESULTS = 中級
RETURN 0

;敵の種類==================================================================
@ENEMY_108_26
RETURN [[キャラ:좀비독]], 10

;フロア名表示===============================================================
@FLOORNAME_108_26
PRINT 이계화된 빌딩　
SELECTCASE FLAG:현M
	CASE 0
		PRINTL １Ｆ
	CASE 1
		PRINTL ２Ｆ
	CASE 2
		PRINTL ３Ｆ
	CASE 3
		PRINTL ４Ｆ
	CASE 4
		PRINTL ５Ｆ
	CASE 5
		PRINTL ６Ｆ
	CASEELSE
		PRINTL
ENDSELECT

;MAP改変=====================================================================
@MAP_CHANGE_108_26
;X == 6,Y == 12にイベントを設置(6階)
SELECTCASE FLAG:현M
	CASE 5
		CALL SET_TILE, 6, 12, , , 4
ENDSELECT