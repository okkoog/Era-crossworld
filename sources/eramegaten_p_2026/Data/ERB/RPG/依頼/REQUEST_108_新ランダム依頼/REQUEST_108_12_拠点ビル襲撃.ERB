;MAP改変=====================================================================
@MAP_CHANGE_108_12
SELECTCASE FLAG:현M
	CASE 1
		;ダンジョンフラグ:108:20 == 0ならX == 2,Y == 2にイベントを設置
		CALL SET_TILE, 2, 2, ダンジョンフラグ:108:20, 0, 4
	CASE 2
		;ダンジョンフラグ:108:20 == 1ならX == 8,Y == 2にイベントを設置
		CALL SET_TILE, 8, 2, ダンジョンフラグ:108:20, 1, 4
	CASE 3
		;ダンジョンフラグ:108:20 == 2ならX == 2,Y == 2にイベントを設置
		CALL SET_TILE, 2, 2, ダンジョンフラグ:108:20, 2, 4
	CASE 5
		;ダンジョンフラグ:108:20 == 3ならX == 6,Y == 6にイベントを設置
		CALL SET_TILE, 6, 6, ダンジョンフラグ:108:20, 3, 4
ENDSELECT
