;依頼名===================================================================
;依頼難易度は敵の最大レベルによって変動
; 1～10：☆、11～20：☆☆、21～30：☆☆☆、以下略
;ダンジョン攻略が必要な場合は☆が★になる。

@TITLE_RANDOM_REQUEST_108_30
RESULTS = 드라이어드를 솎아 주게（난이도 ★★）
RETURN 1

;説明===================================================================
@REQUEST_EXPLAIN_108_30
	PRINTL 
	PRINTL 【의뢰주】오니 일족
	PRINTL 
	PRINTL 　드라이어드가 대군세로 숲에 눌러앉았다。그 탓에 숲의 안전이 위협받고 있다。
	PRINTL 　자연을 위해 드라이어드를 솎아내라。
	PRINTL 
	PRINTL 【작전영역】삼림지대
	PRINTL 【적의전력】드라이어드
	PRINTL 【성공조건】목표 격파
	PRINTL 【주의사항】던전 공략 필요
	PRINTL 

;内容====================================================================
@REQUEST_108_30
CALL MESSAGE_WINDOW, "오니" , @"근처 숲의 드라이어드를 솎아내 줘。", , , , , 4
CALL MESSAGE_WINDOW, "오니" , @"최근 우리가 사는 산 근처의 숲에 드라이어드가 대량으로 눌러앉은 모양이야。", , , , , 4
CALL MESSAGE_WINDOW, "오니" , @"그것뿐이라면 문제없겠지만/놈들이 하필 삼나무에 깃들어버렸단 말이지。", , , , , 4
CALL MESSAGE_WINDOW, "오니" , @"덕분에 생기가 넘치게 된 삼나무가 매일같이 꽃가루를 날려대서/결국 우리 악마들조차도 하루 종일 꽃가루 알레르기 신세다。", , , , , 4
CALL MESSAGE_WINDOW, "오니" , @"수를 좀 줄이고 와줘。", , , , , 4
CALL MESSAGE_WINDOW, "" , @"＞【삼림지대】에 들어갈 수 있게 되었다", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:2 = 1
依頼フラグ:[[依頼:랜덤의뢰]]:3 = 4

;ダンジョン名=============================================================
@DUNGEON_NAME_108_30
#FUNCTIONS
RESULTS_F = 삼림지대

;攻略開始時のイベント=====================================================
@EVENT_DUNGEON_START_108_30
CALL MESSAGE_WINDOW_D, "" , @"＞삼림지대로 발을 들였다。/＞MAG로 인해 변이된 고농도의 꽃가루가 떠돌고 있다……", , , , , 4


;ダンジョン内イベント=====================================================
@DUNGEON_EVENT_108_30
CALL MESSAGE_WINDOW, "" , @"＞이 부근은 특히 드라이어드가 많다", , , , , 4
CALL MESSAGE_WINDOW, "" , @"＞적의를 감지한 드라이어드들이 이쪽으로 덤벼들었다！", , , , , 4

FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1

FOR LOCAL, 7, 17
	CALL SET_ENEMY, LOCAL ,[[キャラ:드라이어드]],12+RAND:5,0,0
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
NEXT

CALL BATTLE_START

FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0

CALL MESSAGE_WINDOW, "" , @"＞이만큼 솎아냈으면 충분하겠지。", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
FLAG:탈출 = 1


;脱出時のイベント==========================================================
@DUNGEON_RESULT_108_30
;報酬
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 2;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 0;依頼主：その他
	CALL PRIZE_REQUEST_108
;ダンジョンを出ると依頼キャンセル
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다。"
ENDIF

;敵の総数==================================================================
@ENEMY_NUM_108_30
RESULTS = 初級
RETURN 0

;敵の種類==================================================================
@ENEMY_108_30
RETURN [[キャラ:드라이어드]], 12

;フロア名表示===============================================================
@FLOORNAME_108_30
PRINT 삼림지대

;MAP改変=====================================================================
@MAP_CHANGE_108_30
;X ==  8,Y == 12にイベント(=4)を設置
CALL SET_TILE, 8, 12, , , 4


;行動終了時にダメージ=========================================================
@EVENT_BATTLE_ACTEND_DUNGEON_108_30
#DIM DYNAMIC 行動者
行動者 = FLAG:행동순1
;ダメージ処理が発生する
RESULTS:0 = あり
;ダメージを与える属性
RESULTS:1 = 신경
;ダメージを受ける際に表示するテキスト
RESULTS:2 = MAG로 유독하게 변이된 꽃가루가 %CALLNAME:行動者%를 덮친다！
;ダメージ量
RETURN RAND:20 + 50
