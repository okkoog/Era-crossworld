@REQUEST_EXPLAIN_108_21
	PRINTL 
	PRINTL 【의뢰주】신흥 농업계 기업
	PRINTL 
	PRINTL 　농협이 보낸 습격부대를 배제해 주십시오。
	PRINTL 
	PRINTL 【작전영역】연구시설
	PRINTL 【적의전력】불명（빙결 유효）
	PRINTL 【성공조건】원인 배제
	PRINTL 

;内容====================================================================
@REQUEST_108_21
CALL MESSAGE_WINDOW, "CEO" , @"최근、우리 회사의 극비 시험장에서 원인 모를 화재가 다발하고 있습니다。", , , , , 4
CALL MESSAGE_WINDOW, "CEO" , @"아마도 우리 회사의 연구개발을 저지하고자/농협에서 보낸 습격부대의 소행이겠지요。", , , , , 4
CALL MESSAGE_WINDOW, "CEO" , @"놈들은 혼란을 틈타 우리가 개발한 농산물을 가로채려는 것이 분명합니다。", , , , , 4
CALL MESSAGE_WINDOW, "CEO" , @"우리가 진행하고 있는 연구는 당사의 이익에만 그치지 않고/사회적으로도 큰 역할을 짊어진 사업입니다。", , , , , 4
CALL MESSAGE_WINDOW, "CEO" , @"기업체로서의 노력과 바람직한 모습/그것을 놈들은 이해하지 못하고 있다고 말할 수밖에 없습니다。", , , , , 4
CALL MESSAGE_WINDOW, "CEO" , @"우리의 연구에 방해가 되지 않도록/농협이 보낸 습격부대를 배제해 주셨으면 합니다", , , , , 4
CALL MESSAGE_WINDOW, "MESSAGE" , @"―극비 시험소―", , , , , 4
CALL MESSAGE_WINDOW, "MESSAGE" , @"＞이곳에서는 악마의 힘을 이용하여、먹으면 「행복」해질 수 있는 과일 등의 연구를 진행하고 있다。", , , , , 4
CALL MESSAGE_WINDOW, "MESSAGE" , @"＞연구소 주변에서 경계를 서고 있자、무언가 타는 냄새가 풍겨왔다。", , , , , 4
CALL MESSAGE_WINDOW, "습격부대" , @"가라！ 위험한 농산물을 만들어내는、악마의 연구소를 잿더미로 만들어라！", , , , , 4
CALL MESSAGE_WINDOW, "MESSAGE" , @"＞농협이 습격해왔다！", , , , , 4

FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1

FOR LOCAL, 7, 17
	CALL SET_ENEMY, LOCAL ,[[キャラ:살라만더]],20+RAND:5,0,0
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
NEXT



CALL BATTLE_START

FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0

CALL MESSAGE_WINDOW, "MESSAGE" , @"＞농협 습격부대를 전멸시켰다。", , , , , 4

