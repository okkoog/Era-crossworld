;===============================================================================
;戦闘時イベント
;===============================================================================
;-------------------------------------------------
;FLAG:勝利フラグに1をセットすると、戦闘を強制終了出来る
;FLAG:敗北フラグに1をセットすると、ゲームオーバーに出来る
;-------------------------------------------------

;戦闘中ターン終了時処理==========================================================
@EVENT_BATTLE_TURNEND_REQUEST108
TRYCALLFORM EVENT_BATTLE_TURNEND_REQUEST_108_{依頼フラグ:[[依頼:랜덤의뢰]]:1}



;戦闘中行動終了時処理============================================================
;20240528 108がコメントアウトされて109にされていたのを戻す。理由は不明
@EVENT_BATTLE_ACTEND_REQUEST108
;@EVENT_BATTLE_ACTEND_REQUEST109
#DIM DYNAMIC 行動者
#DIM DYNAMIC ダメージ量
#DIMS DYNAMIC 属性
#DIMS DYNAMIC ダメージテキスト
#DIMS DYNAMIC ダメージ判定
#DIMS DYNAMIC ダメージ表示

;行動終了時にダメージ==========================================================
RESULTS:0 '= ""
TRYCALLFORM EVENT_BATTLE_ACTEND_REQUEST_108_{依頼フラグ:[[依頼:랜덤의뢰]]:1}
ダメージ判定 = %RESULTS:0%
属性 = %RESULTS:1%
ダメージテキスト = %RESULTS:2%
ダメージ量 = RESULT
行動者 = FLAG:행동순1
IF ダメージ判定 == "あり"
	;ダメージ処理が発生するか否か
	IF CFLAG:行動者:PT플래그 == 0
		RETURN 0
	ELSEIF 行動者 < 0
		RETURN 0
	ELSEIF CFLAG:行動者:상태이상 == GET_STATE_NUM("DYING")
		RETURN 0
	;34:救助任務は救出するまでダメージは発生しない
	ELSEIF 依頼フラグ:[[依頼:랜덤의뢰]]:1 == 34 && 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 0
		RETURN 0
	ENDIF
	;ダメージ計算
	IF MAXBASE:行動者:属性 == 999
		ダメージ量 = 0
	ELSE
		LOCALS = %属性%무효화횟수
		IF CFLAG:行動者:LOCALS > 0
			ダメージ量 = 0
			CFLAG:行動者:LOCALS -= 1
		ELSE
			ダメージ量 = ダメージ量 * MAXBASE:行動者:属性 / 100
		ENDIF
	ENDIF
	;ダメージ表示
	IF ダメージ量 < 0
		ダメージ表示 = {-(ダメージ量)}회복
	ELSEIF ダメージ量 == 0
		ダメージ表示 = BLOCK
	ELSE
		ダメージ表示 = {ダメージ量}데미지
	ENDIF
	LOCALS = %ダメージテキスト%
	SETCOLORBYNAME Red
	CALL MESSAGE_B(1, LOCALS)
	RESETCOLOR
	PRINTFORMW 　　TARGET:[{行動者,2}] %CALLNAME:行動者,20,LEFT%　>>>>>>　%ダメージ表示%
	CALL VAR_HP, 行動者, -(ダメージ量)
ENDIF
;行動終了時にダメージ、ここまで=================================================================================






;===================================================================================
;報酬判定
;依頼フラグ:[[依頼:랜덤의뢰]]:1		依頼の分岐に使用
;依頼フラグ:[[依頼:랜덤의뢰]]:2		依頼の受諾判定に使用
;依頼フラグ:[[依頼:랜덤의뢰]]:5		依頼の難易度判定に使用
;依頼フラグ:[[依頼:랜덤의뢰]]:7		依頼主（1:メシア教、2:ガイア教、0:その他）の判定に使用
;依頼フラグ:[[依頼:랜덤의뢰]]:11	メシア教の戦力値
;依頼フラグ:[[依頼:랜덤의뢰]]:12	ガイア教の戦力値
;
;===================================================================================
@PRIZE_REQUEST_108
#DIM DYNAMIC 依頼難易度
#DIM DYNAMIC メシア教戦力
#DIM DYNAMIC ガイア教戦力
#DIM DYNAMIC 報酬
#DIM DYNAMIC 仲介料
#DIM DYNAMIC 獲得名声

依頼難易度 = 依頼フラグ:[[依頼:랜덤의뢰]]:5
メシア教戦力 = 依頼フラグ:[[依頼:랜덤의뢰]]:11
ガイア教戦力 = 依頼フラグ:[[依頼:랜덤의뢰]]:12

;ダンジョン攻略が必要な依頼の場合：通常の4倍の報酬
IF 依頼フラグ:[[依頼:랜덤의뢰]]:2 == 1
	;メシア教、ガイア教の依頼は戦力値によって報酬変動（50～200%）
	SELECTCASE 依頼フラグ:[[依頼:랜덤의뢰]]:7
		CASE 1
			報酬 = (RAND:5 + 依頼難易度) * 4 * 100 / (メシア教戦力 + 50)
		CASE 2
			報酬 = (RAND:5 + 依頼難易度) * 4 * 100 / (ガイア教戦力 + 50)
		CASEELSE
			報酬 = (RAND:5 + 依頼難易度) * 4
	ENDSELECT
	;最低報酬1000円を保証
	SIF 報酬 < 1
		報酬 = 1
	;獲得名声の算出
	獲得名声 = (RAND:5 + 依頼難易度) * 4
	;ダンジョン依頼実施回数カウント
	依頼フラグ:[[依頼:랜덤의뢰]]:17 += 1
;通常の依頼（ダンジョン攻略は不要）
ELSE
	;メシア教、ガイア教の依頼は戦力値によって報酬変動（50～200%）
	SELECTCASE  依頼フラグ:[[依頼:랜덤의뢰]]:7
		CASE 1
			報酬 = (RAND:5 + 依頼難易度) * 100 / (メシア教戦力 + 50)
		CASE 2
			報酬 = (RAND:5 + 依頼難易度) * 100 / (ガイア教戦力 + 50)
		CASEELSE
			報酬 = RAND:5 + 依頼難易度
	ENDSELECT
	;最低報酬1000円を保証
	SIF 報酬 < 1
		報酬 = 1
	;獲得名声の算出
	獲得名声 = RAND:5 + 依頼難易度
ENDIF
;報酬入手処理====================================================
CALL MESSAGE_WINDOW, "" , @"＞%CALLNAME:MASTER%는 보수로 {報酬},000엔과 {獲得名声}의 명성을 얻었다。", , , , , 4
MONEY:0 += 1000*報酬
FLAG:명성 += 獲得名声
仲介料 = 500*依頼難易度
CALL MESSAGE_WINDOW, "" , @"＞의뢰 중개료로 팬텀에 {仲介料}엔을 납부했다。", , , , , 4
MONEY:0 -= 仲介料
;ランダム依頼実施回数をカウント============================================
依頼フラグ:[[依頼:랜덤의뢰]]:16 += 1
;アライメントの変化============================================
;メシア教からの依頼はアライメントがLaw側に変化
IF 依頼フラグ:[[依頼:랜덤의뢰]]:7 == 1
	CALL INCREASE_LC, 25
;ガイア教からの依頼はアライメントがChaos側に変化
ELSEIF 依頼フラグ:[[依頼:랜덤의뢰]]:7 == 2
	CALL INCREASE_LC, -25
ENDIF
;メシア教とガイア教の戦力値の変化(0～150)=================================================
SELECTCASE 依頼フラグ:[[依頼:랜덤의뢰]]:7
	;メシア教からの依頼
	CASE 1
		依頼フラグ:[[依頼:랜덤의뢰]]:11 = LIMIT (依頼フラグ:[[依頼:랜덤의뢰]]:11 + (依頼難易度+ RAND:10), 1, 150)
		依頼フラグ:[[依頼:랜덤의뢰]]:12 = LIMIT (依頼フラグ:[[依頼:랜덤의뢰]]:12 - (依頼難易度+ RAND:10), 1, 150)
	;ガイア教からの依頼
	CASE 2
		依頼フラグ:[[依頼:랜덤의뢰]]:11 = LIMIT (依頼フラグ:[[依頼:랜덤의뢰]]:11 - (依頼難易度+ RAND:10), 1, 150)
		依頼フラグ:[[依頼:랜덤의뢰]]:12 = LIMIT (依頼フラグ:[[依頼:랜덤의뢰]]:12 + (依頼難易度+ RAND:10), 1, 150)
	;그외
	CASEELSE
		依頼フラグ:[[依頼:랜덤의뢰]]:11 = LIMIT (依頼フラグ:[[依頼:랜덤의뢰]]:11 - (依頼難易度+ RAND:10), 1, 150)
		依頼フラグ:[[依頼:랜덤의뢰]]:12 = LIMIT (依頼フラグ:[[依頼:랜덤의뢰]]:12 - (依頼難易度+ RAND:10), 1, 150)
ENDSELECT
;称号関係の処理＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
;依頼フラグ:[[依頼:랜덤의뢰]]:16 += 100
;依頼フラグ:[[依頼:랜덤의뢰]]:17 += 10
;称号【仕事中毒】を所持している場合は体力が1000減少
IF GETBIT(GLOBAL:称号記録4, 36) == 1
	BASE:MASTER:체력 -= 1000
	SIF BASE:MASTER:체력 <= 1000
	PRINTFORMW ＞체력이 한계라 더 이상은 의뢰를 받을 수 없다。
ENDIF
;依頼解決合計100回（ダンジョン依頼を最低10回)で称号を獲得
IF (依頼フラグ:[[依頼:랜덤의뢰]]:16 >= 100 && 依頼フラグ:[[依頼:랜덤의뢰]]:17 >= 10) && GETBIT(GLOBAL:称号記録4, 36) == 0
	DRAWLINE
	PRINTFORMW ＞수많은 의뢰를 해결하여、칭호 【일중독】이 해방되었습니다。
	SETBIT GLOBAL:称号記録4, 36
	SAVEGLOBAL
	PRINTFORMW ＞앞으로는 체력을 1000 소비하는 대신 얼마든지 랜덤의뢰를 받을 수 있습니다。
	DRAWLINE
ENDIF

;ライバルイベント＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
CALL RIVAL_TALK_RANDOM_REQUEST

;フラグリセット
CALL REQUEST_108_FLAG_CLEAR

;===============================================================================================================================
;各種フラグの初期化を行う。(個別の依頼における初期化忘れによって報酬計算が変になるケースがあるため、共通処理でリセットをかける)
;================================================================================================================================
@REQUEST_108_FLAG_CLEAR
;ダンジョンの有無(デフォルトは「0：なし」とする。)
依頼フラグ:[[依頼:랜덤의뢰]]:2 = 0

;依頼中の状況判定(デフォルトは「0：なし」とする。)
依頼フラグ:[[依頼:랜덤의뢰]]:4 = 0

;依頼の難易度(デフォルトは「1」とする)
依頼フラグ:[[依頼:랜덤의뢰]]:5 = 1

;依頼主(デフォルトは「0：その他」とする)
依頼フラグ:[[依頼:랜덤의뢰]]:7 = 0

;ダンジョン系依頼の進行状況フラグ。(デフォルトは0とする)
FOR LOCAL, 20, 30
	ダンジョンフラグ:108:LOCAL = 0
NEXT








;===================================================================================
;終日の戦力値辺土イベント
;依頼フラグ:[[依頼:랜덤의뢰]]:11	メシア教の戦力値
;依頼フラグ:[[依頼:랜덤의뢰]]:12	ガイア教の戦力値
;===================================================================================
@DAIRY_EVENT_REQUEST_108
IF イベントフラグ:108:0 == 0
	RETURN 0
ELSEIF イベントフラグ:108:0 == 1
	CUSTOMDRAWLINE -
	IF RAND:2 == 0
		PRINTFORMW 메시아교의 활동이 활발해지고 있는 모양입니다。
		依頼フラグ:[[依頼:랜덤의뢰]]:11 += 25 + RAND:10
	ENDIF
	IF RAND:2 == 0 && 依頼フラグ:[[依頼:랜덤의뢰]]:11 <= 20
		PRINTFORMW 새로운 로우 히어로가 탄생하여 활약하고 있는 모양입니다。
		依頼フラグ:[[依頼:랜덤의뢰]]:11 += 75 + RAND:10
	ENDIF
	IF RAND:2 == 0
		PRINTFORMW 가이아교의 활동이 활발해지고 있는 모양입니다。
		依頼フラグ:[[依頼:랜덤의뢰]]:12 += 25 + RAND:10
	ENDIF
	IF RAND:2 == 0 && 依頼フラグ:[[依頼:랜덤의뢰]]:12 <= 20
		PRINTFORMW 새로운 카오스 히어로가 탄생하여 활약하고 있는 모양입니다。
		依頼フラグ:[[依頼:랜덤의뢰]]:12 += 25 + RAND:10
	ENDIF
	IF RAND:2 == 0 && (依頼フラグ:[[依頼:랜덤의뢰]]:11 >= 80 && 依頼フラグ:[[依頼:랜덤의뢰]]:12 >= 80)
		PRINTFORMW 야타가라스가 적극적으로 활동하고 있는 모양입니다。
		依頼フラグ:[[依頼:랜덤의뢰]]:11 -= 50 +RAND:10
		依頼フラグ:[[依頼:랜덤의뢰]]:12 -= 50 +RAND:10
	ENDIF
	IF RAND:2 == 0 && (依頼フラグ:[[依頼:랜덤의뢰]]:11 >= 40 && 依頼フラグ:[[依頼:랜덤의뢰]]:12 >= 40)
		PRINTFORMW 메시아교와 가이아교의 충돌이 발생했습니다！
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 메시아교가 우세한 모양입니다。
				依頼フラグ:[[依頼:랜덤의뢰]]:11 -= 25 + RAND:10
				依頼フラグ:[[依頼:랜덤의뢰]]:12 -= 35 + RAND:10
			CASE 1
				PRINTFORMW 가이아교가 우세한 모양입니다。
				依頼フラグ:[[依頼:랜덤의뢰]]:11 -= 35 + RAND:10
				依頼フラグ:[[依頼:랜덤의뢰]]:12 -= 25 + RAND:10
			CASE 2
				PRINTFORMW 양측 모두 무승부인 모양입니다。
				依頼フラグ:[[依頼:랜덤의뢰]]:11 -= 30 + RAND:10
				依頼フラグ:[[依頼:랜덤의뢰]]:12 -= 30 + RAND:10
		ENDSELECT
	ENDIF
	;勢力地の上限・下限をセット
	依頼フラグ:[[依頼:랜덤의뢰]]:11 = LIMIT(依頼フラグ:[[依頼:랜덤의뢰]]:11, 1, 150)
	依頼フラグ:[[依頼:랜덤의뢰]]:12 = LIMIT(依頼フラグ:[[依頼:랜덤의뢰]]:12, 1, 150)
	DRAWLINE
ENDIF
