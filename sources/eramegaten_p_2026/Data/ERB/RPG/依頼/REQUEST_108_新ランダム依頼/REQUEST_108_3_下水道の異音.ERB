;依頼名===================================================================
;依頼難易度は敵の最大レベルによって変動
; 1～10　☆、11～20　☆☆、21～30　☆☆☆、以下略
;ダンジョン攻略が必要な場合は☆が★になる。

@TITLE_RANDOM_REQUEST_108_3
RESULTS = 하수도의 이음（난이도 ★）
RETURN 1

;説明===================================================================
@REQUEST_EXPLAIN_108_3
	PRINTL 
	PRINTL 【의뢰주】수도국
	PRINTL 
	PRINTL 　하수도에서 이상한 소리가 나서 조사원이 향했으나 돌아오지 않는다。
	PRINTL 　어쩌면 「무언가」 있을지도 모르니 소리의 원인을 확인해 주길 바란다。
	PRINTL 
	PRINTL 【작전영역】하수도
	PRINTL 【적의전력】슬라임（화염、파마 유효）
	PRINTL 【성공조건】원인 배제
	PRINTL 【주의사항】던전 공략 필요
	PRINTL 

;内容====================================================================
@REQUEST_108_3

PRINTFORMW 【하수도】에 들어갈 수 있게 되었다。
依頼フラグ:[[依頼:랜덤의뢰]]:2 = 1
依頼フラグ:[[依頼:랜덤의뢰]]:3 = 2

;ダンジョン名=============================================================
@DUNGEON_NAME_108_3
#FUNCTIONS
RESULTS_F = 하수도

;攻略開始時のイベント=====================================================
@EVENT_DUNGEON_START_108_3
CALL MESSAGE_WINDOW_D, "",@"＞하수도 안으로 들어가자 무언가 들려왔다。", , , , , 4
CALL MESSAGE_WINDOW_D, "？？？" ,@"「……녹아…… 녹아……」「……아파아…… 괴로워어……」", , , , , 4

;ダンジョン内イベント=====================================================
@DUNGEON_EVENT_108_3
CALL MESSAGE_WINDOW, "" ,@"＞소리가 나는 쪽으로 향하자 대량의 슬라임이 하수도를 막아서고 있었다。/이것이 이상한 소리의 원인인 모양이다。", , , , , 4
CALL MESSAGE_WINDOW, "슬라임들" ,@"아、아파아아아！/괴、괴로워어어어！", , , , , 4
CALL MESSAGE_WINDOW, "" ,@"＞옷가지 잔해가 주변에 흩어져 있다。/아무래도 조사원은 이미 먹혀버린 뒤인 모양이다。", , , , , 4
CALL MESSAGE_WINDOW, "슬라임들" ,@"너도오오오！/함께에에에！", , , , , 4
CALL MESSAGE_WINDOW, "" ,@"＞슬라임들이 덤벼들었다！", , , , , 4
FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1
FOR LOCAL:2, 7, 17
	CALL SET_ENEMY, LOCAL:2 ,[[キャラ:슬라임]],1+RAND:5,0,0
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
NEXT
CALL BATTLE_START
FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0
CALL MESSAGE_WINDOW, "" ,@"＞하수도를 막고 있던 슬라임을 제거했다。", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
FLAG:탈출 = 1

;脱出時のイベント==========================================================
@DUNGEON_RESULT_108_3
;報酬
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 1;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 0;依頼主：その他
	CALL PRIZE_REQUEST_108
;ダンジョンを出ると依頼キャンセル
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다。"
ENDIF

;敵の総数==================================================================
@ENEMY_NUM_108_3
RESULTS = 初級
RETURN 0

;敵の種類==================================================================
@ENEMY_108_3
RETURN [[キャラ:슬라임]], 1

;フロア名表示===============================================================
@FLOORNAME_108_3
PRINTL 하수도

;MAP改変=====================================================================
@MAP_CHANGE_108_3
;X == 13～16,Y == 8にイベント(=4)を設置
FOR LOCAL, 13, 17
	CALL SET_TILE, LOCAL , 8 , , , 4
NEXT