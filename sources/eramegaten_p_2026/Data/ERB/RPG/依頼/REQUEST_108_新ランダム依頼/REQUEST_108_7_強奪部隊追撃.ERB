依頼フラグ:[[依頼:랜덤의뢰]]:3 = 2

;ダンジョン名=============================================================
@DUNGEON_NAME_108_7
#FUNCTIONS
RESULTS_F = 지하수도

;攻略開始時のイベント=====================================================
@EVENT_DUNGEON_START_108_7
CALL MESSAGE_WINDOW_D, "" , @"＞습격부대가 농성 중인 지하수도로 침입했다。", , , , , 4

;ダンジョン内イベント=====================================================
@DUNGEON_EVENT_108_7
CALL MESSAGE_WINDOW_ICON, , "モブ", "ガイア教徒", "가이아교도", @"새로운 추격자인가… 하지만 이 함정 지옥 속에서 어디까지 버틸 수 있을까！", , , , , 4
FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1

FOR LOCAL, 7, 12
	CALL SET_ENEMY, LOCAL ,[[キャラ:어새신]],35+RAND:5,1,0
	NAME:(CHARANUM-1) = ガイア教徒
	CALLNAME:(CHARANUM-1) = ガイア教徒
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
NEXT
FOR LOCAL, 13, 16
	CALL SET_ENEMY, LOCAL ,[[キャラ:모스맨]],30+RAND:5,1,0
	NAME:(CHARANUM-1) = ガイア教徒
	CALLNAME:(CHARANUM-1) = ガイア教徒
	BASE:(CHARANUM-1):화염 = 0
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
NEXT

CALL BATTLE_START

FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0

CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "MESSAGE" ,@"＞강탈부대를 전멸시켰다。", , , , , 4
依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
FLAG:탈출 = 1

;脱出時のイベント==========================================================
@DUNGEON_RESULT_108_7
;報酬
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 4;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 1;依頼主：メシア教
	CALL PRIZE_REQUEST_108
;ダンジョンを出ると依頼キャンセル
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다。"
ENDIF

;敵の総数==================================================================
@ENEMY_NUM_108_7
RESULTS = 中級
RETURN 0

