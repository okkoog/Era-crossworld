;説明===================================================================
@REQUEST_EXPLAIN_108_40
PRINTL 
PRINTL 【의뢰주】가이아교
PRINTL 
PRINTL 　산속으로 쳐들어가, 방위 포대를 파괴하라.
PRINTL 
PRINTL
PRINTL 【작전영역】	산악 방위망
PRINTL 【적의 전력】	방위 포대（빙결이 유효）
PRINTL 【성공조건】	포대의 전 파괴
PRINTL 【주의사항】	던전 공략이 필요
PRINTL 
;内容====================================================================
@REQUEST_108_40
CALL MESSAGE_WINDOW_ICON, , "モブ","ガイア教徒", "가이아교도", @"메시아교의 산악 방위망에 습격을 가해다오.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ","ガイア教徒", "가이아교도", @"우리는 산속에 있는 메시아교 거점으로의 침공을 계획하고 있으나/해당 지역에는 방위용 포대가 다수 배치되어 대부대의 침공이 극히 곤란한 상황이다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ","ガイア教徒", "가이아교도", @"그렇기에 산속으로 쳐들어가 방위 포대를 파괴하는 것이 이번 의뢰 내용이다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ","ガイア教徒", "가이아교도", @"포대는 상당히 광범위하게 설치되어 있지만/너에게는 지정된 작전 구역 내의 포대를 파괴해 주었으면 한다.", , , , , 4
CALL MESSAGE_WINDOW_ICON, , "モブ","ガイア教徒", "가이아교도", @"그럼, 건투를 빈다.", , , , , 4
CALL MESSAGE_WINDOW,  "MESSAGE", "＞【산악 방위망】에 들어갈 수 있게 되었다.", , , , , 4
;ダンジョン発生
依頼フラグ:[[依頼:랜덤의뢰]]:2 = 1
;ダンジョンの種類：山
依頼フラグ:[[依頼:랜덤의뢰]]:3 = 5

;ダンジョン名=============================================================
@DUNGEON_NAME_108_40
#FUNCTIONS
RESULTS_F = 산악 방위망

;攻略開始時のイベント=====================================================
@EVENT_DUNGEON_START_108_40
CALL MESSAGE_WINDOW_D, "",@"＞메시아교 산악 방위망의 일각에 침입하자 경보가 울려 퍼졌다.", , , , , 4
CALL MESSAGE_WINDOW_D, "경보",@"소속 불명의 전력 침입을 확인, 각 포대는 적 세력을 포격하라.", , , , , 4


;ダンジョンでのイベント====================================================================
@DUNGEON_EVENT_108_40
	CALL MESSAGE_WINDOW_D, "방위 포대 지휘관" ,@"「적습인가! 각 포좌, 요격 태세 준비!/　인근 포대에 원호 요청을 보내라!」", , , , , 4
	FLAG:도주불가플래그 = 1
	FLAG:회화불능플래그 = 1
	FLAG:선제기습취소 = 1
	FOR  LOCAL:2, 7, 12
		CALL SET_ENEMY, LOCAL:2 ,[[キャラ:살라만더]],20+RAND:5,1,0
		NAME:(CHARANUM-1) = 砲台
		CALLNAME:(CHARANUM-1) = 砲台
		BASE:(CHARANUM-1):화염 = 0
		BASE:(CHARANUM-1):핵열 = 0
		CALL SYNC_STATUS,(CHARANUM-1)
		CALL HEALTH_CHARA,(CHARANUM-1)
	NEXT
	CALL BATTLE_START
	FLAG:도주불가플래그 = 0
	FLAG:회화불능플래그 = 0
	FLAG:선제기습취소 = 0
IF ダンジョンフラグ:108:20 <= 2
	CALL MESSAGE_WINDOW,  "MESSAGE" ,@"＞메시아교 방위 포대를 파괴했다.", , , , , 4
	ダンジョンフラグ:108:20 += 1
	;！表示を削除
	DA:(FLAG:현X):(FLAG:현Y) = 1
ELSE
	CALL MESSAGE_WINDOW_D, "MESSAGE" ,@"＞목표인 메시아교 방위 포대를 모두 파괴했다.", , , , , 4
	依頼フラグ:[[依頼:랜덤의뢰]]:4 = 1
	FLAG:탈출 = 1
ENDIF

;脱出時のイベント====================================================================
@DUNGEON_RESULT_108_40
IF 依頼フラグ:[[依頼:랜덤의뢰]]:4 == 1
	;難易度
	依頼フラグ:[[依頼:랜덤의뢰]]:5 = 2;
	;依頼主：ガイア教
	依頼フラグ:[[依頼:랜덤의뢰]]:7 = 2
	CALL PRIZE_REQUEST_108
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞의뢰를 취소했다."
ENDIF

;敵の総数==================================================================
@ENEMY_NUM_108_40
RESULTS = 中級
RETURN 0

;敵の種類==================================================================
@ENEMY_108_40
RETURN [[キャラ:템플나이트]], 22

;フロア名表示===============================================================
@FLOORNAME_108_40
PRINT 산악 방위망

;MAP改変=====================================================================
@MAP_CHANGE_108_40
;(X,Y) == (4,22)(25,26)(11,13)(26,12)に24を設置
CALL SET_TILE,  4, 22, , , 24
CALL SET_TILE, 25, 26, , , 24
CALL SET_TILE, 11, 13, , , 24
CALL SET_TILE, 26, 12, , , 24


;行動終了時にダメージ=========================================================
@EVENT_BATTLE_ACTEND_DUNGEON_108_40
#DIM DYNAMIC 行動者
行動者 = FLAG:행동순1
;ダメージ処理が発生する
RESULTS:0 = あり
;ダメージを与える属性
RESULTS:1 = 화염
;ダメージを受ける際に表示するテキスト
RESULTS:2 = 주위 포대로부터의 포격이 %CALLNAME:行動者%을(를) 덮친다!
;ダメージ量
RETURN RAND:20 + 50