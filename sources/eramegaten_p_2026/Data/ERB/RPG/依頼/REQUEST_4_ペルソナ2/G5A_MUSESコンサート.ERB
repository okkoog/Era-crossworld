;周防達哉思考パターン
;4種類のペルソナを交換しながら攻めて来る。
;全種あわせるとほとんどの攻撃相性をもち、ほとんどの攻撃相性が弱点となっている
;ステータスはバランス・BS特化・物理重視・魔法特化、そしてアイテム回復で、一人PTを組める構成
;これと戦えるってことは仲間0で頑張ってるってことなので、孤独が彼を強くした
;ぶっちゃけ、前座にトーラスもいるし、このイベント来る時点じゃなかなか勝てないだろーなーと思って作ってる
;まぁ、立ち位置的に隠しボスみたいな・・・というか、たぶんヒーローの噂流す人多いだろうし、会うことすらないだろう
;てか、ヒーローの噂はギンコとれなくなるし、基本的に罠すぎる…w
;ヒーロー流して、ニャルルート潰れた場合、ファントム・ソサエティの指令で、ペルソナ使いと戦え的なの作って
;それで、ギンコとまやねえをたっちゃんから強奪できるってイベントでも作ろうかなぁ
;
;LOCAL:1,HP記録　LOCAL:2、MP記録 LOCAL:3,ペルソナ使用ターン数制御
;ペルソナ順番チェンジ制御　LOCAL:4 ~ 8
;LOCAL:9,10 一時記憶用
;LOCAL:11 あんまり決定が長引いた場合、通常攻撃させるためのフラグ


;ペルソナチェンジ　3ターンごとに実行、変化先はランダムであるが、かならず4回1セットで4種をそれぞれ1回づつだしてくる
;また、同じのを2回連続で出してくることはない。の二つのルールで決めてくる
;完全固定はちょっと馬鹿に見えすぎるし、完全ランダムは運ゲー度高すぎなので間をとってみる
;つってもこの法則に気づくのは難しいかもですが、一応気づいてれば、1/3 1/3 1/2 1/1で相手を読めるんで、だいぶ違うはず
;法則に注意すれば、ペルソナ使い・悪魔がチェンジ即攻撃で事故ることもかなり減らせるはず
;法則に気づかないことを考えるんなら、耐性も弱点もなしの人間を使うのが安定しそう
;
;それぞれ弱点の数は多めになってるので弱点を突くこと自体はむずかしくないです
;まぁ3ターンに1回は避けてくる感じですが
;基本的にはペルソナ使い有利か、ガンスリサクセサーも武器1属性に、弾丸＋通常射撃で4属性で、全部にCOOP狙うのは難しくないですが
;異能者も準備しとけば3のうち、3つくらいまではとれるんで、思ったほど不利にはならなさそう
;（と、見せかけて、直前のトーラス戦でつかえる疾風弱点もちがいないんで、さらに1枠厳しくなってる）
;悪魔も入れ替えできるとはいえ、3ターンの間隔が短いので入れ替えてるとちょっと厳しいか。GUNないし。まぁ様子見て調整

;なお、MHPもそれぞれ、9000・7500・12000・6000と変化しており、チェンジした際にMHPの増減にあわせて、現HPも増減する

;つまり、アグリに1000与えた場合、クエレでは2000相当のダメになる。逆にクエレで1000与えても、アグリでは500相当になる
;まぁ、つまり、防御紙で低HPなアグリは大ダメージを与えるチャンス。まぁアグリはその分火力がキチガイなんで
;安定して火力が低い、バルバドスのほうが狙い目かもしれない
;と、思ったけど、マカラカーン唱えて、全力でアグリ叩くのが安定かもしらん
;ただし、マニアック以降はMHPが120%、140%、160%と増加していくので注意。悪夢はアグリですらHP10000近いとかマジ悪夢、まぁ悪夢だからいいか
;耐力増加によるぶんだとそんなふえねーなぁというきがしたので

;属性の重要度をあげるために65%を基準にする。弱点つくと130%で2倍なんで、実質200%相当、またCOOPのダメの重要性もあがる
;最初はヴォルカヌスを降魔する
@SET_ACTION_周防達哉, ARG
#LOCALSIZE 12
#DIM 元力
#DIM 元知恵
#DIM 元魔力
#DIM 元耐力
#DIM 元速さ
#DIM 元運
;戦闘開始時
IF FLAG:경과턴수 == 0 && LOCAL:3 == 0
	元力 = BASE:ARG:힘
	元知恵 = BASE:ARG:지혜
	元魔力 = BASE:ARG:마력
	元耐力 = BASE:ARG:내구
	元速さ = BASE:ARG:속도
	元運 = BASE:ARG:운
	CALL SET_BATTLE_STATUS(ARG, MAXBASE:ARG:명중 * 125 / 100, "명중")
	;ペルソナチェンジ回数
	LOCAL:4 = 0
	LOCAL:5 = 0
	LOCAL:6 = 1
	LOCAL:7 = 2
	LOCAL:8 = 3
	FOR LOCAL,6 , 9
		SWAP LOCAL:LOCAL, LOCAL:(RAND:3 + 6)
	NEXT
ENDIF
IF FLAG:경과턴수 % 3 == 0
	SIF LOCAL:3 == 0
		LOCAL:3 = 1 
ELSE
	LOCAL:3 = 0
ENDIF
IF CFLAG:ARG:행동한횟수 == 0 && LOCAL:3 == 1
	;チェンジは行動回数を消費しない
	CFLAG:ARG:행동한횟수 -= 1
	LOCAL:3 = 2
	CFLAG:ARG:입력행동 = [[스킬:P・체인지]]
	CFLAG:ARG:타겟 = CFLAG:ARG:포지션
	LOCAL:1 = MAXBASE:ARG:ＨＰ
	LOCAL:2 = MAXBASE:ARG:ＭＰ
	;初期ペルソナフラグを利用する
	;0,ヴォルカヌス、1,バルバトス, 2,クエレプレ, 3,アグリッパ
	;一周したら配置しなおし
	ABL:ARG:초기페르소나 = LOCAL:(5 + ((LOCAL:4) % 4))
	IF (LOCAL:4) % 4 == 3
		DO
			SWAP LOCAL:(RAND:4 + 5), LOCAL:(RAND:4 + 5)
		LOOP LOCAL:5 == ABL:ARG:초기페르소나
	ENDIF
	LOCAL:4 += 1
	;バルバトス 狩人ということなので、運速知恵の3点を伸ばし、状態異常銃を撃ってくる
	;攻撃力は低いが、行動回数3になる
	IF ABL:ARG:초기페르소나 == 1
		;MHP7500
		CFLAG:ARG:행동횟수 = 3
		BASE:ARG:힘 = 元力 * 5 / 10
		BASE:ARG:지혜 = 元知恵 * 15/ 10
		BASE:ARG:마력 = 元魔力 * 6 / 10
		BASE:ARG:내구 = 元耐力 * 7 / 10
		BASE:ARG:속도 = 元速さ * 15 / 10
		BASE:ARG:운 = 元運 * 20 / 10
		;破魔・地変・電撃に弱く、呪殺に耐性をもち、精神・神経・疾風・衝撃無効
		FOR LOCAL, 0, TYPENUM
			SELECTCASE GET_TYPE(LOCAL)
				CASE "비구"
					BASE:ARG:GET_TYPE(LOCAL) = 999
				CASE "파마"
					BASE:ARG:GET_TYPE(LOCAL) = 130
				CASE "주살"
					BASE:ARG:GET_TYPE(LOCAL) = 30
				CASE "지변"
					BASE:ARG:GET_TYPE(LOCAL) = 130
				CASE "신경"
					BASE:ARG:GET_TYPE(LOCAL) = 0
				CASE "정신"
					BASE:ARG:GET_TYPE(LOCAL) = 0
				CASE "질풍"
					BASE:ARG:GET_TYPE(LOCAL) = 0
				CASE "충격"
					BASE:ARG:GET_TYPE(LOCAL) = 0
				CASE "전격"
					BASE:ARG:GET_TYPE(LOCAL) = 130
				CASEELSE
					BASE:ARG:GET_TYPE(LOCAL) = 65
			ENDSELECT
		NEXT
	;クエレプレ
	;魔法は完璧に捨てた物理重視
	ELSEIF ABL:ARG:초기페르소나 == 2
		;MHP12000
		CFLAG:ARG:행동횟수 = 2
		BASE:ARG:힘 = 元力 * 20 / 10
		BASE:ARG:지혜 = 元知恵 * 2/ 10
		BASE:ARG:마력 = 元魔力 * 2 / 10
		BASE:ARG:내구 = 元耐力 * 18 / 10
		BASE:ARG:속도 = 元速さ * 12 / 10
		BASE:ARG:운 = 元運 * 10 / 10
		;衝撃・火炎が弱点で、氷結・電撃無効、核熱耐性、精神もやや効く
		;さすがに原作通りに物理弱点だと、アグリッパとかぶるので調整
		FOR LOCAL, 0, TYPENUM
			SELECTCASE GET_TYPE(LOCAL)
				CASE "화염"
					BASE:ARG:GET_TYPE(LOCAL) = 130
				CASE "충격"
					BASE:ARG:GET_TYPE(LOCAL) = 130
				CASE "정신"
					BASE:ARG:GET_TYPE(LOCAL) = 105
				CASE "빙결"
					BASE:ARG:GET_TYPE(LOCAL) = 0
				CASE "전격"
					BASE:ARG:GET_TYPE(LOCAL) = 0
				CASE "핵열"
					BASE:ARG:GET_TYPE(LOCAL) = 30
				CASEELSE
					BASE:ARG:GET_TYPE(LOCAL) = 65
			ENDSELECT
		NEXT
	;アグリッパ
	;敵も魔特。魔威が高いんで脅威度は一位か？
	;でも、圧倒的にダメ取りやすいと思うんでチャンスはチャンス
	ELSEIF ABL:ARG:초기페르소나 == 3
		CFLAG:ARG:행동횟수 = 2
		BASE:ARG:힘 = 元力 * 1 / 10
		BASE:ARG:지혜 = 元知恵 * 15/ 10
		BASE:ARG:마력 = 元魔力 * 25 / 10
		BASE:ARG:내구 = 元耐力 * 2 / 10
		BASE:ARG:속도 = 元速さ * 7 / 10
		BASE:ARG:운 = 元運 * 10 / 10
		;物理3種に弱く、万能に普通、あとは0%、いわゆるP2魔法型っぽい。さすがに反射吸収はきついので、それはしませんが
		FOR LOCAL, 0, TYPENUM
			SELECTCASE GET_TYPE(LOCAL)
				CASE "검격", "비구", "전술", "타격"
					BASE:ARG:GET_TYPE(LOCAL) = 130
				CASE "만능"
					BASE:ARG:GET_TYPE(LOCAL) = 65
				CASEELSE
					BASE:ARG:GET_TYPE(LOCAL) = 0
			ENDSELECT
		NEXT
	;ヴォルカヌス
	;ステータスはバランス型、かなりフラット
	;狂焔乱舞が多分怖い
	ELSE
		;MHP9000 
		CFLAG:ARG:행동횟수 = 2
		BASE:ARG:힘 = 元力 * 15 / 10
		BASE:ARG:지혜 = 元知恵
		BASE:ARG:마력 = 元魔力 * 15 / 10
		BASE:ARG:내구 = 元耐力
		BASE:ARG:속도 = 元速さ
		BASE:ARG:운 = 元運
		;周防 達哉とおなじ,飛具以外の物理にやや強く、火炎反射で、破魔に耐性を持ち、水氷結にやや弱い
		;一番、ダメ通しにくいのは相性☆の特権ということで
		FOR LOCAL, GETNUM(BASE, "검격"), GETNUM(BASE, "사이코")+1
			BASE:ARG:LOCAL = CSVBASE(NO:ARG, LOCAL, 0)
		NEXT
	ENDIF
	;一旦ステータス同期
	CFLAG:ARG:공격보정 = 0
	CALL SYNC_STATUS, ARG
	;ステータス補正
	;難度係数は1.0~1.6、システム的に直指定はフォローしてもらえないのでてきとーに
	LOCAL = FLAG:전투난이도 - 3 > 0 ? 10 + (FLAG:전투난이도 - 3) * 2 # 10
	;バルは銃攻撃・命中は直接指定、かつ、COOPダメ確保用に攻撃を高めておく
	IF ABL:ARG:초기페르소나 == 1
		CALL SET_BATTLE_STATUS(ARG, 750 * LOCAL, "ＨＰ")
		CALL SET_BATTLE_STATUS(ARG, MAXBASE:ARG:공격, "총공격")
		CALL SET_BATTLE_STATUS(ARG, MAXBASE:ARG:공격 * 15 / 10, "공격")
		CALL SET_BATTLE_STATUS(ARG, MAXBASE:ARG:명중, "총명중")
	;クエレ
	ELSEIF ABL:ARG:초기페르소나 == 2
		CALL SET_BATTLE_STATUS(ARG, 1200 * LOCAL, "ＨＰ")
	;アグリ
	ELSEIF ABL:ARG:초기페르소나 == 3
		CALL SET_BATTLE_STATUS(ARG, 600 * LOCAL, "ＨＰ")
	;ヴォル
	ELSE
		CALL SET_BATTLE_STATUS(ARG, 900 * LOCAL, "ＨＰ")
	ENDIF
	BASE:ARG:ＨＰ *= MAXBASE:ARG:ＨＰ
	BASE:ARG:ＨＰ /= LOCAL:1
	BASE:ARG:ＭＰ *= MAXBASE:ARG:ＭＰ
	BASE:ARG:ＭＰ /= LOCAL:2
	;ステータス同期
	CALL SYNC_STATUS, ARG
	RETURN 1
ENDIF
;ＭＰが50%を割ると、チューイン・ソウルを使う
;ヴォルで600のうち50%だから、数回は見れるかな？
;使うのは攻撃が一番苛烈な2回目の行動で確定
;つまり、使うターンがわかれば、チャンスターンになる
IF 現MP割合(ARG) < 50 && CFLAG:ARG:행동한횟수 == 1
	TSTR = チューイン・ソウル
	CFLAG:ARG:입력행동 = [[스킬:ＤＵＭＭＹ]]
	CFLAG:ARG:타겟 = CFLAG:ARG:포지션
	RETURN 1
ENDIF
LOCAL:11 = 0
$DECIDE_ACTION
SIF ++ LOCAL:11 > 3
	GOTO NOMALATTACK
LOCAL = RAND:100
;LOCAL:9 = 0
;LOCAL:10 = 0
;HPが5％減るごとに1％の確率補正を行う
LOCAL:1 = (100 - 現HP割合(ARG)) / 5
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
;バルバドス
;3回行動で、補助、銃攻撃、魔法の順で撃ってくる
;狩人らしさということで弱点学習をするかしこさを与えてみる
;COOPとられなければゴミ火力だけど、状態異常がけっこうヤクい
;これも脆いのでうまく攻撃に繋げたい
IF ABL:ARG:초기페르소나 == 1
	IF CFLAG:ARG:행동한횟수 == 0
		IF LOCAL < 50 && CFLAG:ARG:BS부착률강화 == 0
			CFLAG:ARG:입력행동 = [[스킬:무거운공기]]
		ELSE
			IF RAND:3 == 0
				CFLAG:ARG:입력행동 = [[스킬:스쿠・카쟈]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:타룬・다]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:우황단]]
			ENDIF
		ENDIF
	;6回まで実行、相性学習をし、無効と反射と吸収には撃ってこなくなる
	;また、ガードしている場合も50%で撃つのをやめる。まぁつまり有効そうなやつに集中砲火してくる仕様
	;Pチェンジターンに飛具弱点もちが、無対策でつったってるとまず狩られると思います
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		IF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:베놈샷]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:랜디샷]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:신경탄]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:디스펠샷]]
		ENDIF
		LOCAL:11 = 0
		$GUN_TAGET

		SIF LOCAL:10 == 0
			LOCAL:10 = RAND:6 + 1
		IF POS(LOCAL:10) < 0 || GET_STATE(CFLAG:(POS(LOCAL:10)):상태이상) == "DYING" || (CHECK_WEAKNESS(MEMORIZE_WEAKNESS(ARG, LOCAL:10, "비구")) < -1) || (CFLAG:POS(LOCAL:10):방어플래그 && RAND:2)
			LOCAL:10 = RAND:6 + 1
			LOCAL:11 += 1
			SIF LOCAL:11 < 20
				GOTO GUN_TAGET
		ENDIF
		CFLAG:ARG:타겟 = LOCAL:10
		LOCAL:9 += 1
		LOCAL:10 += 1
		IF LOCAL:9 < 6 && LOCAL:11 < 20
			CFLAG:ARG:행동한횟수 -= 1
		ELSE
			LOCAL:9 = 0
		ENDIF
;		FOR LOCAL, 1, 7
;			LOCALS = 포지션{LOCAL}
;			IF FLAG:LOCALS > -1 && GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) != "DYING"
;				IF LOCAL < 4
;					LOCAL:9 += 1
;				ELSE
;					LOCAL:10 += 1
;				ENDIF
;			ENDIF
;			;前列より後列のほうを好む。また、人数が多い方を好む
;			CFLAG:ARG:타겟 = 17 + (RAND:(LOCAL:9 + 1) < (RAND:(LOCAL:10 + 1) * 2 - 1))
;			RETURN 1
;		NEXT
	;最終ターンは魔法攻撃、恐ろしく威力がしょぼいけど、これもCOOPはまると死ぬのでちょっと注意
	ELSE
		IF LOCAL < 70
			IF RAND:2
				CFLAG:ARG:입력행동 = [[스킬:잔마]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마그나스]]
			ENDIF
			CALL GET_SKILL_PROP, "SKILL_TYPE", CFLAG:ARG:입력행동, ARG
			;弱点のやつがいるならそいつ
			IF CHECK_WEAKNESS(MEMORIZE_WEAKNESS(ARG, 22, GET_TYPE(RESULT), 1)) == 1
				CFLAG:ARG:타겟 = RESULT:2
			ELSE
				CFLAG:ARG:타겟 = RAND:6 + 1 
				SIF CHECK_WEAKNESS(MEMORIZE_WEAKNESS(ARG, CFLAG:ARG:타겟, GET_TYPE(RESULT), 1)) < 0
					GOTO DECIDE_ACTION
			ENDIF
		ELSE
			IF RAND:2
				CFLAG:ARG:입력행동 = [[스킬:마하・잔]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마하・마그나스]]
			ENDIF
		ENDIF
		CALL GET_SKILL_PROP, "SKILL_TYPE", CFLAG:ARG:입력행동, ARG
		CALLF MEMORIZE_WEAKNESS(ARG, CFLAG:ARG:타겟, GET_TYPE(RESULT))
	ENDIF
;クエレプレ
;一回目は50%で単体スキル
;二回目は範囲攻撃系を0%~80%で行う
;アイスブレスがあるとはいえ、攻撃はほぼ全て前列に来るので、前列GUARDで後列で火力連打が安定かもしれない
;いわゆる壁タイプ、攻撃は厳しくもやっかいでもないので、ここで体勢ととのえるといいかも
ELSEIF ABL:ARG:초기페르소나 == 2
	IF CFLAG:ARG:행동한횟수 == 0
		IF LOCAL < 50
			IF RAND:3 == 0
				CFLAG:ARG:입력행동 = [[스킬:물어뜯기]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:독물어뜯기]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마비물어뜯기]]
			ENDIF
		ENDIF
	ELSE
		;0%~80%の確率で範囲攻撃、そんなランク高くない技なんで、威力はそこまででもないはず
		IF LOCAL:1 * 4 < LOCAL
			IF RAND:3 == 0
				CFLAG:ARG:입력행동 = [[스킬:마구날뛰기]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:날개짓]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:아이스브레스]]
			ENDIF
		ENDIF
	ENDIF
;アグリッパ
;ヴォルカヌス同様、マカカジャをかけようとするので、デカジャ・タルンダを使っておけば、攻撃を潰せる
;当然だけど、単純な火力は圧倒的。そして、その分脆さも圧倒的
;ぶっちゃけマカラカーンして、こいつに集中攻撃かけるのが一番楽な気がします
;1ターン目にマカカジャさせとけば通らないし、後列からでも銃なら簡単にCOOPとれるし
ELSEIF ABL:ARG:초기페르소나 == 3
	;一回目、アギラオと
	IF CFLAG:ARG:행동한횟수 == 0
		;80%の確率でマカ・カジャ、ただし3回目、4回目は40%、5回目以降の強化は行わない
		IF LOCAL < 80
			IF (CFLAG:ARG:마법위력강화 + CFLAG:ARG:공격강화) < 8 || ((CFLAG:ARG:마법위력강화 + CFLAG:ARG:공격강화) < 16 && LOCAL < 40)
				CFLAG:ARG:입력행동 = [[스킬:마카・카쟈]]
			ENDIF
		ELSE
			;確率取り直し
			LOCAL = RAND:100
			;20％で牛黄丹
			IF LOCAL < 20
				CFLAG:ARG:입력행동 = [[스킬:우황단]]
			;70%~50%で単体魔法
			ELSEIF LOCAL < 90 - LOCAL:1
				IF RAND:3 == 0
					CFLAG:ARG:입력행동 = [[스킬:지온가]]
				ELSEIF RAND:2 == 0
					CFLAG:ARG:입력행동 = [[스킬:아쿠에스]]
				ELSE
					CFLAG:ARG:입력행동 = [[스킬:갈라]]
				ENDIF
			;10~30%で範囲魔法
			ELSE
				IF RAND:3 == 0
					CFLAG:ARG:입력행동 = [[스킬:마하・지온가]]
				ELSEIF RAND:2 == 0
					CFLAG:ARG:입력행동 = [[스킬:마하・아쿠에스]]
				ELSE
					CFLAG:ARG:입력행동 = [[스킬:마하・갈라]]
				ENDIF
			ENDIF
		ENDIF
	ELSE
		;20%でマハ・ジオンガ
		IF LOCAL < 40
			IF RAND:3 == 0
				CFLAG:ARG:입력행동 = [[스킬:마하・지온가]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:마하・아쿠에스]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마하・갈라]]
			ENDIF
		;0~20%でメギドラ
		ELSEIF LOCAL < 40 + LOCAL:1
			CFLAG:ARG:입력행동 = [[스킬:메기도라]]
		;60%~40%で単体魔法
		ELSE
			IF RAND:3 == 0
				CFLAG:ARG:입력행동 = [[스킬:지온가]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:아쿠에스]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:그라이바]]
			ENDIF
		ENDIF
	ENDIF
;ヴォルカヌス
;一文字斬り・マハラギオン・アギラオ・狂焔乱舞・タルカジャ
;1回目は強化かかってない場合タルカジャがかなりの確率で選択される、2回目は範囲攻撃メイン
;HPが減るごとに範囲攻撃の確率があがっていく、最終的に1回目で計60％、2回目で90％の確率で来るようになる
;タルカジャを使わせれば、攻撃が1回減るので、タルンダ・デカジャでタルカジャを使わせるようにするのが攻略のコツか
ELSE
	IF CFLAG:ARG:행동한횟수 == 0
		;80%の確率でタルカジャ、ただし3回目、4回目は40%、5回目以降の強化は行わない
		IF LOCAL < 80
			IF CFLAG:ARG:공격강화 < 8 || (CFLAG:ARG:공격강화 < 16 && LOCAL < 40)
				CFLAG:ARG:입력행동 = [[스킬:타루・카쟈]]
			ENDIF
		ELSE
			;確率取り直し
			LOCAL = RAND:100
			;10％で牛黄丹
			IF LOCAL < 10
				CFLAG:ARG:입력행동 = [[스킬:우황단]]
			;10%~30%で一文字斬り
			ELSEIF LOCAL < 20 + LOCAL:1
				CFLAG:ARG:입력행동 = [[스킬:일문자베기]]
			;10％~30％でマハ・ラギオン
			ELSEIF LOCAL < 30 + LOCAL:1 * 2
				CFLAG:ARG:입력행동 = [[스킬:마하・라기온]]
			;70％~30％で単体攻撃
			ELSE
				;1/2でアギラオ
				SIF RAND:2
					CFLAG:ARG:입력행동 = [[스킬:아기라오]]
			ENDIF
		ENDIF
	ELSE
		IF LOCAL < (20 + LOCAL:1)
			CFLAG:ARG:입력행동 = [[스킬:일문자베기]]
		ELSEIF LOCAL < (40 + LOCAL:1 * 2)
			CFLAG:ARG:입력행동 = [[스킬:마하・라기온]]
		ELSEIF LOCAL < (50 + LOCAL:1 * 3)
			CFLAG:ARG:입력행동 = [[스킬:회전베기]]
		ELSE
			SIF RAND:2
				CFLAG:ARG:입력행동 = [[스킬:아기라오]]
		ENDIF
	ENDIF
ENDIF
;ここまで来て何もはいってなかったら、通常攻撃
CFLAG:ARG:입력행동 = CFLAG:ARG:입력행동 >= 0 ? CFLAG:ARG:입력행동 # 0
;アクション実行不能ならコマンド選定からやりなおし
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	GOTO DECIDE_ACTION
;ここまでターゲットが決まってなかったら、ランダムターゲットを読んで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1
;何度もコマンドやりなおしにいくようなら通常攻撃にいかせる
$NOMALATTACK
CFLAG:ARG:입력행동 = 0
CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1
