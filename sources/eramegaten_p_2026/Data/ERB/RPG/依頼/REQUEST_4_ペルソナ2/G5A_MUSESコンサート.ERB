;-----------------------------------------------------------
;プリンストーラス思考パターン
;なんか銃持ってるよねこれ、ということで銃キャラにする予定
;予定としては属性特殊弾全部を持つ、つまり破魔呪殺暗黒火炎氷結電撃飛具＋マグナ系の8属性もち
;まぁそのまま8属性使うとかやられても困るので、最後の行動で、フロスト弾を装填した、なんかのMESSAGEをだして
;次回の攻撃を予告する感じに、銃ダメは単発30か50くらいかなぁ。まぁ、銃攻撃を直接指定して調整します
;武器はショットガンで列攻撃だけど、後列にも届かないと話にならないんで、ボス専用銃を作ります
;で、COOPダメは300くらいにして、銃ダメはそこまででもないけど、COOPとられると即死亡な感じにしたい
;
;暗黒マハマグナ飛具まで含めて常に5属性を撃ってくる可能性がある
;ってのはちょっとえぐいなぁ、と思ったので暗黒マハマグナを原作通り混乱付与にして呪殺カットで1属性減らす
;さらに特殊弾は1回目はランダム、2回目の特殊弾は前列を、3回目の特殊弾は後列を狙う
;特殊弾は1回目は0~20%で、2回目は20%~60%、3回目は20%固定なんで、後列はかなり安全度高い
;つまり、気づけばだけど、後列はわりと安全
;っていっても、そうそう気づかないし、たちっぱはあぶない選択肢なんで、やっぱ弱点なしが強いですね
;うーん、ペルソナ悪魔優遇できるかとおもったけど、弱点なしの強さを思い知らされるわ
;次のレオさまーも、アタックチェンジタイプとして、単体狙いな代わりに耐性なしで受けると即死クラスにしようかなぁ
;
;4色髑髏を翳す→次のターンに単体に一撃600~700の4色属性の防御無視ダメージをだしてくる（GUARDした場合は150~200程度に減衰）
;ただ、これCOMP係があたると勝負にならないので、噂で仮面党の力をまったくうけつけない凄腕のサマナーがいる…の噂を流していると、主人公にのみ0ダメ固定
;これなら、耐性＆弱点もちのほうが、耐性なしより有利になるし、問題は仲魔のうち水撃・火炎・地変・疾風のうち1属性はともかく2属性以上に耐性を持つのは厳しいよなぁ…wってことか
;ニャルルートだと、そんな感じの強化版がでて、他ルートだと通常版が出ることにしようかしらん。ニャルルートはペルソナ好きなんだから、ペルソナ使い有利な敵でいいよね…
;ペルソナ２キャラの加入が少ないルートだけど
;
;これだとガードに弱すぎ（なるべく入替えをして欲しい）なんで、ガード崩し弾を実装して
;ガード崩し弾→弱点弾で同一ターンに2回あたってしまうと、COOPとられる仕様にする感じに
;
;対策はPチェンジ・悪魔入れ替えもありますが、仕様的に弱点取れない相手にたいして火力不足になるだろうから
;人間のばあい、弱点さえ作って置かなければ大丈夫かなぁ
;-----------------------------------------------------------
@SET_ACTION_トーラス, ARG
;確率生成、及びHP減少による確率補正を作成
LOCAL = RAND:100
LOCAL:1 = (100 - 現HP割合(ARG)) / 5
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
;使用弾丸指定
LOCALS = 특수탄{RAND:2+1}
;1more時の行動
LOCAL:3 = FLAG:전투난이도 - 3 > 0 ? 10 + (FLAG:전투난이도 - 3) * 2 # 10
;1more時はフライシュッツを撃ちこんでくる
IF CFLAG:ARG:１more플래그 > 0
	CALL SET_BATTLE_STATUS(ARG, 10 * LOCAL:3, "총공격")
	CFLAG:ARG:타겟 = 17 + RAND:2
	CFLAG:ARG:입력행동 = [[스킬:Freischutz]]
	RETURN 0
ELSE
	CALL SET_BATTLE_STATUS(ARG, 8 * LOCAL:3, "총공격")
ENDIF
;1ターン目　ノイズショットはここでしか使わない
;また、暗黒マハマグナもここでは来ない。コンボ考えなければ一番攻撃が甘い箇所
IF CFLAG:ARG:행동한횟수 == 0
	;ノイズショットコンボフラグ
	LOCAL:2 = 0
	SELECTCASE LOCAL
		;ニャルルートでは30%~50%でノイズショットコンボを狙う
		;ガードしている味方がいるかどうかを見て、ガードしている味方がいる場合、そいつがいる列にノイズショットを打ち込んでくる
		;ガードしている相手がいない場合汎用に流れるけど、それで特殊弾撃ってくる率が減るということもないので注意
		CASE 0 TO 29 + LOCAL:1
			IF STRFLAG_NUM_EV("ニャル進行", , , , [[이벤트:페르소나２]])
				IF RAND:3
					FOR LOCAL:3, 6, 0, -1
						IF POS(LOCAL:3) >= 0 && GET_STATE(CFLAG:(POS(LOCAL:3)):상태이상) != "DYING" && CFLAG:POS(LOCAL:3):방어플래그
							CFLAG:ARG:타겟 = 17 + (LOCAL:3 > 3)
							CFLAG:ARG:입력행동 = EQUIP:ARG:특수탄3
							EQUIP:ARG:특수탄3 = [[스킬:ＧＵＮ]]
							LOCAL:2 = 1
							BREAK
						ENDIF
					NEXT
				ELSE
					FOR LOCAL:3, 1, 7
						IF POS(LOCAL:3) >= 0 && GET_STATE(CFLAG:(POS(LOCAL:3)):상태이상) != "DYING" && CFLAG:POS(LOCAL:3):방어플래그
							CFLAG:ARG:타겟 = 17 + (LOCAL:3 > 3)
							CFLAG:ARG:입력행동 = EQUIP:ARG:특수탄3
							EQUIP:ARG:특수탄3 = [[스킬:ＧＵＮ]]
							LOCAL:2 = 1
							BREAK
						ENDIF
					NEXT
				ENDIF
			ENDIF
		;0%～20%で特殊弾を撃ちこんでくる
		CASE 30 + LOCAL:1 TO LOCAL:1 * 2
			CFLAG:ARG:입력행동 = EQUIP:ARG:LOCALS
			EQUIP:ARG:LOCALS = [[스킬:ＧＵＮ]]
	ENDSELECT
ELSEIF CFLAG:ARG:행동한횟수 == 1
	;2回目の銃攻撃は前列狙い
	;ノイズショットコンボ,一回目でノイズショットを撃ってた場合、二回目は前列に特殊弾を打ち込む
	IF LOCAL:2
		CFLAG:ARG:타겟 = 17
		CFLAG:ARG:입력행동 = EQUIP:ARG:LOCALS
		EQUIP:ARG:LOCALS = [[스킬:ＧＵＮ]]
	ELSE
		SELECTCASE LOCAL
			;40%~60%で特殊弾
			CASE 0 TO 39 + LOCAL:1
				CFLAG:ARG:입력행동 = EQUIP:ARG:LOCALS
				EQUIP:ARG:LOCALS = [[스킬:ＧＵＮ]]
				CFLAG:ARG:타겟 = 17
			;10%~30%で暗黒マハ・マグナ
			CASE 40 + LOCAL:1 TO 30 + LOCAL:1 * 2
				CFLAG:ARG:입력행동 = [[스킬:암흑마하・마그나]]
		ENDSELECT
	ENDIF
ELSE
	;ノイズショットコンボ、残ってるほうの弾を後列に撃ちこんでくる
	IF LOCAL:2
		CFLAG:ARG:입력행동 = MAX(EQUIP:ARG:특수탄1, EQUIP:ARG:특수탄2)
		EQUIP:ARG:특수탄1 = [[스킬:ＧＵＮ]]
		EQUIP:ARG:특수탄2 = [[스킬:ＧＵＮ]]
		CFLAG:ARG:타겟 = 17
		SIF POS(4) >= 0 || POS(5) >= 0 || POS(6) >= 0
			CFLAG:ARG:타겟 = 18
	ELSE
		;2回目の銃攻撃は後列を狙う
		SELECTCASE LOCAL
			;30%で特殊弾
			CASE 0 TO 29
				CFLAG:ARG:입력행동 = EQUIP:ARG:LOCALS
				EQUIP:ARG:LOCALS = [[스킬:ＧＵＮ]]
				CFLAG:ARG:타겟 = 17 + RAND:2
			;30%~50%で暗黒マハマグナ
			CASE 30 TO 59 + LOCAL:1
				CFLAG:ARG:입력행동 = [[스킬:암흑마하・마그나]]
		ENDSELECT
	ENDIF
ENDIF
;確率再生成
LOCAL = RAND:100
;ここまで入力行動が決まってなかったら、汎用3種に行く
;GUNは特殊弾でも撃って来やすいので減らしとく
IF CFLAG:ARG:입력행동 == -1
	SELECTCASE LOCAL
		CASE 0 TO 29
			CFLAG:ARG:입력행동 = [[스킬:마린카린]]
		CASE 30 TO 79
			CFLAG:ARG:입력행동 = [[스킬:마그나스]]
		CASEELSE
			CFLAG:ARG:입력행동 = [[스킬:ＧＵＮ]]
	ENDSELECT
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;後列をうつ場合、ちゃんとターゲットがいるか確認する
IF CFLAG:ARG:타겟 == 18
	LOCAL = 0
	FOR LOCAL:3, 4, 7
		SIF POS(LOCAL:3) >= 0 && GET_STATE(CFLAG:(POS(LOCAL:3)):상태이상) != "DYING"
			LOCAL = 1
	NEXT
	CFLAG:ARG:타겟 = LOCAL ? 18 # 17
ENDIF
;アクション実行不能なら自動的に銃射撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = [[스킬:ＧＵＮ]]
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1

;呼び出し場所が数カ所あるので
@SET_TAURUS
CALL SET_ENEMY, 9, [[キャラ:토러스]], 25,0,1
LOCAL = CHARANUM - 1
;HP8000/MP1000
LOCAL:1 = FLAG:전투난이도 - 3 > 0 ? 10 + (FLAG:전투난이도 - 3) * 2 # 10
CALL SET_BATTLE_STATUS(LOCAL, 800 * LOCAL:1, "ＨＰ")
CALL SET_BATTLE_STATUS(LOCAL, 100 * LOCAL:1, "ＭＰ")
CALL SET_BATTLE_STATUS(LOCAL, 18 * LOCAL:1, "공격")
CALL SET_BATTLE_STATUS(LOCAL, 8 * LOCAL:1, "총공격")
CALL SET_BATTLE_STATUS(LOCAL, 100 * LOCAL:1, "총명중")
CFLAG:LOCAL:크리티컬보정 = -90
CFLAG:LOCAL:속도보정 = 5
CSTR:LOCAL:사고패턴 = %CALLNAME:LOCAL%
CFLAG:LOCAL:행동횟수 = 3
;初期に使用してくる弾丸をセット、こうしてみるとスロ3でもある
EQUIP:LOCAL:특수탄1 = [[스킬:랜디샷]]
EQUIP:LOCAL:특수탄2 = [[스킬:프로스트샷]]
EQUIP:LOCAL:특수탄3 = [[스킬:노이즈샷]]
CALL SYNC_STATUS, LOCAL
CALL HEALTH_CHARA, LOCAL

;トーラスはターン終了ごとに弾丸の詰めなおしを行う
;特徴としてはノイズショットは撃つたびに必ず補充、他の弾は2個おんなじのをいれないようにする
@EVENT_BATTLE_TURNEND_REQUEST4
;トーラスがいないなら先に進まない
SIF !FINDCHARA_ENEMY([[キャラ:토러스]])
	RETURN 0
LOCAL= RESULT:1
IF EQUIP:LOCAL:특수탄1 == [[스킬:ＧＵＮ]] || EQUIP:LOCAL:특수탄2 == [[스킬:ＧＵＮ]] || EQUIP:LOCAL:특수탄3 == [[스킬:ＧＵＮ]]
	SETCOLOR 0x990000
	PRINTFORML ┏>CHARA━━━━━━━━━━┓　┏>ACT━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃[9] 토러스　 　　　　　　        ┃   ┃리로드　　　　　　　　　　　　　　　   　┃
	PRINTFORMW ┗━━━━━━━━━━━━━┛　┗━━━━━━━━━━━━━━━━━━━━┛
	DO 
		LOCAL:1 = RAND:6
		LOCAL:2 = RAND:6
	LOOP LOCAL:1 == LOCAL:2
	FOR LOCAL:3, 1 , 3
		SELECTCASE LOCAL:(LOCAL:3)
			CASE 0
				LOCAL:(LOCAL:3) = [[스킬:랜디샷]]
				LOCALS:(LOCAL:3) = 랜디샷
			CASE 1
				LOCAL:(LOCAL:3) = [[스킬:저주의탄환]]
				LOCALS:(LOCAL:3) = 저주의탄환
			CASE 2
				LOCAL:(LOCAL:3) = [[스킬:성스러운탄환]]
				LOCALS:(LOCAL:3) = 성스러운탄환
			CASE 3
				LOCAL:(LOCAL:3) = [[스킬:코로나샷]]
				LOCALS:(LOCAL:3) = 코로나샷
			CASE 4
				LOCAL:(LOCAL:3) = [[스킬:랜턴샷]]
				LOCALS:(LOCAL:3) = 랜턴탄
			CASE 5
				LOCAL:(LOCAL:3) = [[스킬:프로스트샷]]
				LOCALS:(LOCAL:3) = 프로스트탄
		ENDSELECT
	NEXT
	;ニャルルートでない場合は弾は一種類となる
	IF STRFLAG_NUM_EV("ニャル進行", , , , [[이벤트:페르소나２]])
		IF EQUIP:LOCAL:특수탄1 == [[스킬:ＧＵＮ]]
			PRINTFORML 토러스는 %조사처리(LOCALS:1,"를")% 장전했다
			EQUIP:LOCAL:특수탄1 = LOCAL:1
		ENDIF
		IF EQUIP:LOCAL:특수탄2 == [[스킬:ＧＵＮ]]
			PRINTFORML 토러스는 %조사처리(LOCALS:2,"를")% 장전했다
			EQUIP:LOCAL:특수탄2 = LOCAL:2
		ENDIF
		IF EQUIP:LOCAL:특수탄3 == [[스킬:ＧＵＮ]]
			PRINTFORML 토러스는 음향탄을 장전했다
			EQUIP:LOCAL:특수탄3 = [[스킬:노이즈샷]]
		ENDIF
	ELSE
		IF EQUIP:LOCAL:특수탄1 == [[스킬:ＧＵＮ]] || EQUIP:LOCAL:특수탄2 == [[스킬:ＧＵＮ]]
			PRINTFORML 토러스는 %조사처리(LOCALS:1,"를")% 장전했다
			EQUIP:LOCAL:특수탄1 = LOCAL:1
			EQUIP:LOCAL:특수탄2 = LOCAL:1
		ENDIF
	ENDIF
	RESETCOLOR
	WAIT
ENDIF
;リンダ思考パターン
;はじめはハッピー系を中心＋바리언트댄스
;HPが減ってくると、セクシーダンスとハッピー系
;さらに減るとファイナルヌード
;しかし、文章が過激すぎるおかげで元アイドル悲惨すぎる感じだ
;まぁ、実際にはこんなアイドルいないけど、原作的に
;
;攻撃力はほぼなしで、バステ成功率は異様、というか、ステが異様
;狙うは挑発と魅了のコンボ
;解法は精神耐性持ちを前に立たせて、残りのメンバーはGUARDし続けること
;でも嫌がらせでGUARD数増えるとマモリクズシうってきます
;あんまりたまると奥義来ます
;神経耐性を揃えつつ、如何に速攻で潰すかが勝負の鍵
;トーラス、ひいてはそのあと達哉までにこれで削れるかどうかですね
@SET_ACTION_リンダ, ARG
;ガードポイント加算、ポイントによってガード崩しを狙ってくる
IF CFLAG:ARG:행동한횟수 == 0
	FOR LOCAL, 1, 7
		SIF POS(LOCAL) >= 0 && GET_STATE(CFLAG:POS(LOCAL):상태이상) != "DYING" && CFLAG:POS(LOCAL):방어플래그
			LOCAL:1 += 1
	NEXT
	SIF LOCAL:1 > 10 && RAND:100 > LOCAL:1
		CFLAG:ARG:입력행동 = [[스킬:방어부수기]]
	SIF LOCAL:1 >= 50
		CFLAG:ARG:입력행동 = [[스킬:오의방어부수기]]
	GOTO RINDA_END
ENDIF

;確率生成
LOCAL = RAND:100
IF 現HP割合(ARG) < 33
	IF LOCAL:1 >= 50
		CFLAG:ARG:입력행동 = [[스킬:파이널누드]]
	;33%以下突入で再び挑発
	ELSEIF  CFLAG:ARG:200 < 3
		CFLAG:ARG:200 = 3
		CFLAG:ARG:입력행동 = [[스킬:도발]]
	ELSE
		SELECTCASE LOCAL
			CASE 0 TO 29
				CFLAG:ARG:입력행동 = [[스킬:섹시댄스]]
			CASE 30 TO 59
				CFLAG:ARG:입력행동 = [[스킬:파이널누드]]
		ENDSELECT
	ENDIF
ELSEIF 現HP割合(ARG) < 66
	IF LOCAL:1 >= 50
		CFLAG:ARG:입력행동 = [[스킬:섹시댄스]]
	;66%以下突入で挑発
	ELSEIF  CFLAG:ARG:200 <  1
		CFLAG:ARG:200 = 1
		CFLAG:ARG:입력행동 = [[스킬:도발]]
	ELSE
		SELECTCASE LOCAL
			CASE 0 TO 19
				CFLAG:ARG:입력행동 = [[스킬:캔디보이스]]
			CASE 20 TO 39
				CFLAG:ARG:입력행동 = [[스킬:섹시댄스]]
			CASE 30 TO 59
				CFLAG:ARG:입력행동 = [[스킬:바리언트댄스]]
		ENDSELECT
	ENDIF
ELSE
	IF LOCAL:1 >= 50
		CFLAG:ARG:입력행동 = [[스킬:바리언트댄스]]
	ELSE
		SELECTCASE LOCAL
			CASE 0 TO 19
				CFLAG:ARG:입력행동 = [[스킬:캔디보이스]]
			CASE 20 TO 39
				CFLAG:ARG:입력행동 = [[스킬:해피스텝]]
			CASE 40 TO 59
				CFLAG:ARG:입력행동 = [[스킬:바리언트댄스]]
		ENDSELECT
	ENDIF
ENDIF
SIF LOCAL:1 >= 50
	LOCAL:1 -= 50
$RINDA_END
SIF CFLAG:ARG:입력행동 == -1
	CFLAG:ARG:입력행동 = 0
;アクション実行不能なら自動的に銃射撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
;ターゲット決定
CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1
