;内容
;====================
@REQUEST_4
LOCAL = STRFLAG_NUM_EV("罪ルート進行", , , , [[이벤트:페르소나２]])
LOCAL:1 = STRFLAG_NUM_EV("罰ルート進行", , , , [[이벤트:페르소나２]])
CALL RESET_ANNOUNCE_FLAG
IF LOCAL == 0 && LOCAL:1 == 0
	SIF 依頼フラグ:[[依頼:카루코자카고교체육관(1)]]:0 && 依頼フラグ:[[依頼:카루코자카고교체육관(2)]]:0
		CALL REQUEST_4_GP0
ENDIF
IF LOCAL == 5
	IF STRFLAG_NUM_EV("ヴィジュアル系番長の噂", , , , [[이벤트:소문]]) == 2
		CALL REQUEST_4_G5B
	ELSE
		CALL REQUEST_4_G5A
	ENDIF
ENDIF
IF LOCAL:1 == 7 && STRFLAG_NUM_REQ("ルート進行日", , , , [[이벤트:페르소나２]]) + 2 < DAY
	CALL REQUEST_4_P7
	CALLF STRFLAG_NUM_EV("罰ルート進行", "=", , 8, [[이벤트:페르소나２]])
ENDIF

IF LOCAL:1 == 8 && STRFLAG_NUM_REQ("ルート進行日", , , , [[이벤트:페르소나２]]) + 2 < DAY
	CALL REQUEST_4_P8
	CALLF STRFLAG_NUM_EV("罰ルート進行", "=", , 9, [[이벤트:페르소나２]])
ENDIF
CALLF STRFLAG_NUM_EV("ルート進行日", "=", , DAY, [[이벤트:페르소나２]])
