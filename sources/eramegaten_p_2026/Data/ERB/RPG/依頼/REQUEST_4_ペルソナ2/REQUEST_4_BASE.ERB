@GET_REQUEST_NAME_4
#FUNCTIONS
RESULTS_F '= "ペルソナ２"
RETURNF RESULTS_F

@PLAYABLE_REQUEST_4
LOCAL = STRFLAG_NUM_EV("罪ルート進行", , , , [[이벤트:페르소나２]])
LOCAL:1 = STRFLAG_NUM_EV("罰ルート進行", , , , [[이벤트:페르소나２]])
IF LOCAL == 0 && LOCAL:1 == 0
	IF 依頼フラグ:[[依頼:카루코자카고교체육관(1)]]:0 && 依頼フラグ:[[依頼:카루코자카고교체육관(2)]]:0
		;依頼:페르소나２
		RESULTS = 칠자매학원조사의뢰
		RETURN 1
	ENDIF
ENDIF
IF LOCAL == 5
	IF STRFLAG_NUM_EV("ヴィジュアル系番長の噂", , , , [[이벤트:소문]]) == 2
		RESULTS = 가스쳄버라이브
	ELSE
		RESULTS = ＭＵＳＥＳ콘서트
	ENDIF
	RETURN 1
ENDIF
IF LOCAL:1 == 7 && STRFLAG_NUM_REQ("P6クリア日", , , , [[依頼:페르소나２]]) + 2 < DAY
	RESULTS = 새로운 ＪＯＫＥＲ
	RETURN 1
ENDIF
IF LOCAL:1 == 8 && STRFLAG_NUM_REQ("P7クリア日", , , , [[依頼:페르소나２]]) + 2 < DAY
	RESULTS = 신세계당의 세계
	RETURN 1
ENDIF
;#;RESULTS = 페르소나２의뢰
;#;RETURN 1
RETURN 0
