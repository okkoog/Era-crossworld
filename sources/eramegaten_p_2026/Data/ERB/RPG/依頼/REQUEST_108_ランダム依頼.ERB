;====================
;条件
;====================
;ランダム依頼を受注できる条件、および受注できる場合はどの種類の依頼が表示されるかを設定する
@GET_REQUEST_NAME_108
#FUNCTIONS
RESULTS_F '= "랜덤의뢰"
RETURNF RESULTS_F

@PLAYABLE_REQUEST_108
#DIM DYNAMIC 依頼総数
;EXTRAイベントがOFFの場合は発生しない　※以前はヤマタイカフィルターでしたが、EXTRA全般に変更
IF !GET_USEABLE_EXTRA_TITLE()
	RETURN 0
;あなたのレベル20以上か名声20か納金総額1万円以上なら開始イベント発生
ELSEIF 依頼フラグ:[[依頼:랜덤의뢰]]:15 == 0 && (BASE:MASTER:LV >= 20 || FLAG:명성 >= 20 || FLAG:조직공헌도 >= 10000)
	RESULTS = 의뢰 알선의 통지
	RETURN 1
;「ランダム依頼を非表示にする」を選択した場合は表示しない
ELSEIF 依頼フラグ:[[依頼:랜덤의뢰]]:15 == 1
	RETURN 0
;既にランダム依頼を実行中(ダンジョン攻略が必要な依頼)の場合、表示しない
ELSEIF 依頼フラグ:[[依頼:랜덤의뢰]]:2 == 1
	RETURN 0
;称号【仕事中毒】を取得済みでない場合、この日のこの時間に既に依頼を受けていれば表示しない
;ELSEIF (GETBIT(GLOBAL:称号記録4, 36) == 0) && (DAY == 依頼フラグ:[[依頼:랜덤의뢰]]:8 && TIME == 依頼フラグ:[[依頼:랜덤의뢰]]:9)
ELSEIF (GETBIT(GLOBAL:称号記録4, 36) == 0) && (DAY == 依頼フラグ:[[依頼:랜덤의뢰]]:8)
	RETURN 0
;称号【仕事中毒】を取得済みでも、体力が1000以下なら表示しない
ELSEIF (GETBIT(GLOBAL:称号記録4, 36) == 1) && (BASE:MASTER:체력 <= 1000)
	RETURN 0
;ランダム依頼を表示する
ELSEIF 依頼フラグ:[[依頼:랜덤의뢰]]:15 == 2
	;依頼総数をチェック
	FOR LOCAL, 0, 99
		TRYCALLFORM TITLE_RANDOM_REQUEST_108_{LOCAL}
		SIF RESULT == 1
			依頼総数 += 1
		RESULT = 0
	NEXT
	;出現する依頼をランダムで選ぶ
	依頼フラグ:[[依頼:랜덤의뢰]]:1 = RAND(0, 依頼総数)
	;依頼タイトルを読み込み
	TRYCALLFORM TITLE_RANDOM_REQUEST_108_{依頼フラグ:[[依頼:랜덤의뢰]]:1}
	RESULTS = %RESULTS%
	RETURN 1
ELSE
	RETURN 0
ENDIF

;====================
;説明
;====================
@EXPLAIN_REQUEST_108
;-------------------
;変数定義
;-------------------
#DIM REWARD_PERCENTAGE_L		;メシア教側の報酬変動率(%)
#DIM REWARD_PERCENTAGE_C		;ガイア教側の報酬変動率(%)

;-------------------
;変数の初期化
;-------------------
REWARD_PERCENTAGE_L = 100		;メシア教側の報酬変動率(%)
REWARD_PERCENTAGE_C = 100		;ガイア教側の報酬変動率(%)

;-------------------
;ここから本処理
;-------------------
;開始イベント
IF 依頼フラグ:[[依頼:랜덤의뢰]]:15 == 0
	PRINTFORMW 팬텀 소사이어티로부터 메일이 도착해 있다。
ELSE
	;メシア・ガイアの報酬変動率の算出　※劣勢なほど報酬は良くなる。倍率は50～200%
	REWARD_PERCENTAGE_L = LIMIT (100 * (100 / (依頼フラグ:[[依頼:랜덤의뢰]]:11 + 50)), 50, 200)
	REWARD_PERCENTAGE_C = LIMIT (100 * (100 / (依頼フラグ:[[依頼:랜덤의뢰]]:12 + 50)), 50, 200)

	;メシア・ガイアの勢力状況および報酬への影響を表示する
	PRINTFORM 메시아교의 전력치：{依頼フラグ:[[依頼:랜덤의뢰]]:11}、보수：통상의 {REWARD_PERCENTAGE_L}\%
	SELECTCASE REWARD_PERCENTAGE_L
		CASE IS <= 80
			PRINTL (전력은 충분한 모양입니다。보수는 기대할 수 없습니다。)
		CASE IS >= 120
			PRINTL (전력이 부족한 모양입니다。평소보다 고액의 보수를 기대할 수 있습니다。)
		CASEELSE
			PRINTL (평소대로의 보수를 기대할 수 있습니다。)
	ENDSELECT
	PRINTFORM 가이아교의 전력치：{依頼フラグ:[[依頼:랜덤의뢰]]:12}、보수：통상의 {REWARD_PERCENTAGE_C}\%
	SELECTCASE REWARD_PERCENTAGE_C
		CASE IS <= 80
			PRINTL (전력은 충분한 모양입니다。보수는 기대할 수 없습니다。)
		CASE IS >= 120
			PRINTL (전력이 부족한 모양입니다。평소보다 고액의 보수를 기대할 수 있습니다。)
		CASEELSE
			PRINTL (평소대로의 보수를 기대할 수 있습니다。)
	ENDSELECT

	;個別の依頼の説明を表示する(「氷漬けの工場」「教会施設を防衛」など各依頼の説明はここから)
	CALLFORM REQUEST_EXPLAIN_108_{依頼フラグ:[[依頼:랜덤의뢰]]:1}
ENDIF
;====================
;内容
;====================
@REQUEST_108
;ランダム依頼を受けるのが初回である場合、メシア・ガイアの勢力を互角にする(両方50ずつ)
IF 依頼フラグ:[[依頼:랜덤의뢰]]:8 == 0 && 依頼フラグ:[[依頼:랜덤의뢰]]:9 == 0
	依頼フラグ:[[依頼:랜덤의뢰]]:11 = 50
	依頼フラグ:[[依頼:랜덤의뢰]]:12 = 50
ENDIF
;最初に、フラグなどをリセットする　※個別依頼でのフラグリセットし忘れによる報酬計算ミスの対応
CALL REQUEST_108_FLAG_CLEAR
;開始イベント
IF 依頼フラグ:[[依頼:랜덤의뢰]]:15 == 0
	PRINTFORMW 『팬텀 소사이어티에 새롭게 들어온 구성원에게。』
	PRINTFORMW 『자네의 조직에 대한 충성을 인정해、의뢰 알선을 개시하겠다。』
	PRINTFORMW 『앞으로도 계속해서 충성을 보여주기를 기대하고 있겠네。』
	PRINTFORML 
	PRINTFORMW 랜덤의뢰가 출현하게 되었다。
	PRINTFORML 
	PRINTFORML 랜덤의뢰를 숨기겠습니까？
	PRINTL
	CALL INPUT_YN, "YES(랜덤의뢰를 숨긴다)", "No(랜덤의뢰가 표시되도록 한다)"
	IF RESULT == 0
		依頼フラグ:[[依頼:랜덤의뢰]]:15 = 1
	ELSE
		依頼フラグ:[[依頼:랜덤의뢰]]:15 = 2
	ENDIF
	;CLEARBIT GLOBAL:称号記録4, 36
	;SAVEGLOBAL
	RETURN 0
;個別の依頼を開始する(「氷漬けの工場」「教会施設を防衛」など各依頼の処理はここから)
ELSE
	CALLFORM REQUEST_108_{依頼フラグ:[[依頼:랜덤의뢰]]:1}
ENDIF
;ランダム依頼実行時の日時を記録
依頼フラグ:[[依頼:랜덤의뢰]]:8 = DAY
依頼フラグ:[[依頼:랜덤의뢰]]:9 = TIME

