;-------------------------------------------------------------------------------
; 【当ファイルについて】
; 当ファイルは真IVのイベントをCALLするだけの、メインファイルである。
; 詳細な処理は各サブファイルに記載する。
; （サブファイルはイベントごとに１ファイル用意する）
;
;
; 【フラグについて】
; デビルサバイバー２のイベントでは、"FLAG:진IV진행도"を使用している。
; ３桁の数値が以下の仕様で設定される。
;
; ・３桁目…イベント進行度
; ・２桁目…
; ・１桁目…
;
;-------------------------------------------------------------------------------

;===============================================================================
;  ◇記載関数一覧(記載順)
;
;		Module Name						Explanation
;
;	・ PLAYABLE_REQUEST_xxx				依頼:条件
;	・ EXPLAIN_REQUEST_xxx				依頼:説明
;	・ REQUEST_xxx						依頼:メイン処理
;	・ EVENT_BATTLE_TURNTOP_REQUESTxxx	依頼:戦闘中処理(ターン開始時)
;	・ EVENT_BATTLE_TURNEND_REQUESTxxx	依頼:戦闘中処理(ターン終了時)
;
; *- 独自関数
;
;	・ REQUEST_30_DAY_TITLE				依頼:一日のタイトル
;	・ REQUEST_30_DAY_END				依頼:一日の終了
;	・ REQUEST_30_TURN_END				依頼:ターンの終了
;	・ REQUEST_30_BASE_LV				依頼:基礎レベル
;
;===============================================================================


;====================
;条件
;====================
@GET_REQUEST_NAME_60
#FUNCTIONS
RESULTS_F '= "真4依頼"
RETURNF RESULTS_F

@PLAYABLE_REQUEST_60
#DIM DYNAMIC L_FLAG_REQ
#DIM DYNAMIC L_FLAG_EVENT_DIGIT
#DIM DYNAMIC L_FLAG
#DIM DYNAMIC L_FLAG2
#DIM DYNAMIC L_FLAG3

;-----------------------------
;- 共通チェック
;-----------------------------

;- デバッグ
IF FLAG:DEBUG
	;OK

;- 主人レベル20以上
ELSEIF BASE:MASTER:LV >= 20
	;OK

ELSE
	;NG
	RETURN 0
ENDIF

;-----------------------------
;- 処理開始
;-----------------------------

;- フラグをセット(イベントフラグ:3桁目)
L_FLAG_REQ = FLAG:진IV진행도 /100

SELECTCASE L_FLAG_REQ
	;-----------------------------
	;- [第1イベント　東京スカイタワー]
	;-----------------------------
	CASE 0
		;- CHK:イベントフラグ
		RESULTS = 스카이트리 이계화
		RETURN 1
	;-----------------------------
	;- [第2イベント　신주쿠]
	;-----------------------------
	CASE 1
		;- CHK:イベントフラグ 新宿でオザワが倒されている
		IF ダンジョンフラグ:42:新宿フラグ("オザワ") > 0
			RESULTS = 아수라회의 의뢰
			RETURN 1
		ENDIF
	;-----------------------------
	;- [第3イベント　]
	;-----------------------------
	CASE 2
	;- フラグをセット(イベントフラグ:2桁目)
		L_FLAG_REQ = FLAG:진IV진행도 % 100
		L_FLAG_REQ = L_FLAG_REQ / 10

		IF L_FLAG_REQ == 1
			RESULTS = 아수라회에서 온 의뢰
			RETURN 1
		ELSEIF L_FLAG_REQ == 9
	;- フラグをセット(イベントフラグ:1桁目)
		L_FLAG_REQ = FLAG:진IV진행도 % 10
			IF L_FLAG_REQ == 2
				RESULTS = 동쪽 미카도국의 의뢰
				RETURN 1
			ELSE
				RESULTS = 이케부쿠로에서의 악마 퇴치
				RETURN 1
			ENDIF
		ENDIF
	;-----------------------------
	;- [第4イベント　]
	;-----------------------------
	CASE 3
;- フラグをセット(イベントフラグ:2桁目)
		L_FLAG_REQ = FLAG:진IV진행도 % 100
		L_FLAG_REQ = L_FLAG_REQ / 10
		IF L_FLAG_REQ == 1
			L_FLAG = イベントフラグ:60:0 % 10
			IF L_FLAG == 2
				RESULTS = 아수라회에서 온 의뢰 2
				RETURN 1
			ENDIF
		ELSEIF L_FLAG_REQ == 9
;- フラグをセット(イベントフラグ:1桁目)
			L_FLAG = イベントフラグ:60:0 % 10
			L_FLAG2 = イベントフラグ:60:0 / 10
			L_FLAG2 = L_FLAG2 % 10
			L_FLAG3 = イベントフラグ:60:0 / 100

			IF L_FLAG + L_FLAG2 + L_FLAG3 >= 3
				RESULTS = 동쪽 미카도국의 의뢰 2
				RETURN 1
			ENDIF
		ENDIF
	;-----------------------------
	;- [第5イベント　]
	;-----------------------------
	CASE 4
;- フラグをセット(イベントフラグ:2桁目)
		RESULTS = 거꾸로 힐즈
		RETURN 1
	;-----------------------------
	;- [第6イベント　]
	;-----------------------------
	CASE 5
;- フラグをセット(イベントフラグ:2桁目)
		IF イベントフラグ:60:1 >= 100
			L_FLAG_REQ = FLAG:진IV진행도 % 100
			L_FLAG_REQ = L_FLAG_REQ / 10
			IF L_FLAG_REQ == 1
				RESULTS = 유리코 암살 계획
				RETURN 1
			ELSEIF L_FLAG_REQ == 9
	;- フラグをセット(イベントフラグ:1桁目)
				L_FLAG = 0
				IF イベントフラグ:60:1 == 101
					L_FLAG2 = [[キャラ:요나탄]]
				ELSEIF イベントフラグ:60:1 == 102
					L_FLAG2 = [[キャラ:이자보]]
				ELSEIF イベントフラグ:60:1 == 103
					L_FLAG2 = [[キャラ:월터]]
				ELSE
					L_FLAG2 = 0
				ENDIF
				FOR LOCAL, 1, 7
					;空きポジションは勘定外
					SIF POS(LOCAL) < 0
						CONTINUE
					;主人は勘定外
					SIF POS(LOCAL) == MASTER
						CONTINUE
					;人間以外は勘定外
					SIF ABL:POS(LOCAL):종족
						CONTINUE
					SIF NO:POS(LOCAL) == L_FLAG2
						L_FLAG = 1
				NEXT
				IF L_FLAG == 1
					RESULTS = 유리코 또 다시
					RETURN 1
				ELSE
					RETURN 0
				ENDIF
			ENDIF
		ELSE
			RETURN 0
		ENDIF
	;-----------------------------
	;- [第7イベント　]
	;-----------------------------
	CASE 6
;- フラグをセット(イベントフラグ:2桁目)
		IF イベントフラグ:60:1 >= 100
			L_FLAG_REQ = FLAG:진IV진행도 % 100
			L_FLAG_REQ = L_FLAG_REQ / 10
			IF L_FLAG_REQ == 1
				RESULTS = 타야마의 비밀
				RETURN 1
			ELSEIF L_FLAG_REQ == 9
	;- フラグをセット(イベントフラグ:1桁目)
				L_FLAG = 0
				IF イベントフラグ:60:1 == 101
					L_FLAG2 = [[キャラ:요나탄]]
				ELSEIF イベントフラグ:60:1 == 102
					L_FLAG2 = [[キャラ:이자보]]
				ELSEIF イベントフラグ:60:1 == 103
					L_FLAG2 = [[キャラ:월터]]
				ELSE
					L_FLAG2 = 0
				ENDIF
				FOR LOCAL, 1, 7
					;空きポジションは勘定外
					SIF POS(LOCAL) < 0
						CONTINUE
					;主人は勘定外
					SIF POS(LOCAL) == MASTER
						CONTINUE
					;人間以外は勘定外
					SIF ABL:POS(LOCAL):종족
						CONTINUE
					SIF NO:POS(LOCAL) == L_FLAG2
						L_FLAG = 1
				NEXT
				IF L_FLAG == 1
					RESULTS = 이치가야로
					RETURN 1
				ELSE
					RETURN 0
				ENDIF
			ENDIF
		ELSE
			RETURN 0
		ENDIF

	;-----------------------------
	;- 終了
	;-----------------------------
	;- 作成中
	CASEELSE
		RESULTS = 개발 대기
		RETURN 1

ENDSELECT

;念の為
RETURN 0

