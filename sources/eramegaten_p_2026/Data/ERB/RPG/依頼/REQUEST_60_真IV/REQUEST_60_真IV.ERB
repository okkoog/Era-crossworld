		;- 依頼:メイン処理(1ST DAY)
		CALL REQUEST_60_4
	;-----------------------------
	;- 逆さヒルズ
	;-----------------------------
	CASE 4
		;- 依頼:メイン処理(1ST DAY)
		CALL REQUEST_60_5
	;-----------------------------
	;- 逆さヒルズ
	;-----------------------------
	CASE 5
		;- 依頼:メイン処理(1ST DAY)
		CALL REQUEST_60_6
		
	;-----------------------------
	;- 市ヶ谷
