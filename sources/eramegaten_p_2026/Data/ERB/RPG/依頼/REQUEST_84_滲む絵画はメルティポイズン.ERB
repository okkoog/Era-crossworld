;=======================================================================
@SET_ACTION_メルティポイズン, ARG,
;=======================================================================
;敵特殊思考パターン
;基本行動
;1ターン目　랜더마이저→돌려차기
;2ターン目　도발→데・카쟈
;3ターン目　ミズキリorベノンザッパー→섬머솔트　予告
;4ターン目　魔剣ジゼル→이검난무
;1ターン目へ
;=======================================================================
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

;ワンモア（クリティカルか、弱点を突いた場合の行動）
IF CFLAG:ARG:１more플래그 > 0
	;1more時は回し蹴りを打つ
	CALL SET_ACTION_SKILL, ARG, [[스킬:돌려차기]]
ELSEIF CFLAG:ARG:행동한횟수 == 0
	SELECTCASE FLAG:경과턴수 % 4
		CASE 0
			CFLAG:ARG:입력행동 = [[스킬:랜더마이저]]
		CASE 1
			CFLAG:ARG:입력행동 = [[스킬:도발]]
		CASE 2
			CFLAG:ARG:입력행동 = RAND:2 ? [[스킬:베놈재퍼]] # [[스킬:물살가르기]]
		;4ターン目
		CASEELSE
			CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "踵の名は魔剣ジゼル")
	ENDSELECT
ELSEIF CFLAG:ARG:행동한횟수 == 1
	SELECTCASE FLAG:경과턴수 % 4
		CASE 0
			CFLAG:ARG:입력행동 = [[스킬:돌려차기]]
		CASE 1
			CFLAG:ARG:입력행동 = [[스킬:데・카쟈]]
		CASE 2
			CFLAG:ARG:입력행동 = [[스킬:섬머솔트]]
		;4ターン目
		CASEELSE
			CFLAG:ARG:입력행동 = [[스킬:이검난무]]
	ENDSELECT
ENDIF

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;行動未決定時のおまじない
SIF CFLAG:ARG:입력행동 == -1
	CALL ランダム行動 , ARG
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1

