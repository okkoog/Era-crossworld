@SHOPCOMABLE_104
#DIM LCOUNT
;パーティに一人以上いるなら
RESULT:1 = 1
RESULTS = 의뢰청부
LOCAL = 0
FOR LCOUNT, 0, CHARANUM
	SIF CFLAG:LCOUNT:PT플래그 == 2
		LOCAL += 1
NEXT
IF LOCAL > 0
	RETURN 1
ELSE
	RETURN 0
ENDIF


@SHOW_REQUEST
CUSTOMDRAWLINE =

FOR LOCAL, 0, 999
	TFLAG:LOCAL = 0
	RESULTS = 
	SIF !IS_USEABLE_SHOPCOM && !GROUPMATCH(LOCAL, [[依頼:ＣＯＭＰ장인의도움]])
		CONTINUE
	;---- EDIT P 001 MOD START -------------------------
	TRYCCALLFORM PLAYABLE_REQUEST_{LOCAL}
		IF RESULT
			TFLAG:LOCAL = 1
			IF RESULTS != ""
				SIF ANNOUNCE_REQUEST_APPEARED:LOCAL == 2
					ANNOUNCE_REQUEST_APPEARED:LOCAL = 3
				SIF ANNOUNCE_REQUEST_APPEARED:LOCAL == 3
					SETCOLOR COLOR("p-green")
				PRINTFORML [{LOCAL,3}] - %RESULTS%
				RESETCOLOR
			ENDIF
		ENDIF
	CATCH
		
	ENDCATCH
	;---- EDIT P 001 MOD END ---------------------------
NEXT

@SHOP_COM_104, ARG
CALL SHOW_REQUEST
PRINTL [1000] 돌아간다

DRAWLINE
PRINTL 어느 의뢰를 받으시겠습니까？

$INPUT_LOOP
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT < 0 || RESULT >= VARSIZE("TFLAG")
	GOTO INPUT_LOOP
ELSEIF TFLAG:RESULT > 0 || IS_DEBUG
	LOCAL = RESULT
	DRAWLINE
	TRYCALLFORM EXPLAIN_REQUEST_{RESULT}
	DRAWLINE
	SELECTCASE RESULT
		;通常
		CASE 0
			PRINTL 이 의뢰를 받으시겠습니까？
			CALL INPUT_YN,"Yes","No"

			IF RESULT == 0
				FLAG:진행중의뢰 = LOCAL
				CALL STARTUP_RPG_SHOPCOM
				TRYCALLFORM REQUEST_{LOCAL}
				FLAG:진행중의뢰 = 0
				FOR LOCAL,0,CHARANUM
					CALL TRANS_DEVIL , LOCAL , 0, "変身解除"
				NEXT
				;---- EDIT 002 ADD START -------------------------
				SIF FLAG:전생리스타트예약
					RETURN 0
				;---- EDIT 002 ADD END ---------------------------
				;IF RESULT == 1
				;	VARSET TFLAG,-1
				;	BEGIN TURNEND
				;ENDIF
			ELSEIF RESULT == 1
				RESTART
			ENDIF
		;説明だけを見るパターン
		CASE 1
			WAIT
			RESTART
	ENDSELECT
ENDIF

VARSET TFLAG,-1
RETURN 0

