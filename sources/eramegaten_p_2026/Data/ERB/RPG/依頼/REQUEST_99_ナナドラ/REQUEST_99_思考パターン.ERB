;=================================================
;   sub SET_ACTION_トリニトロ
;=================================================
;   依頼:トリニトロ用思考パターン
;-------------------------------------------------
@SET_ACTION_トリニトロ,ARG
#DIM num
#DIM num1
#DIM num2
#DIM CTR
#LOCALSIZE 3
;FLAG:경과턴수=0が1ターン目なので特定ターンの行動を決定したいなら経過ターン数に+1しないとダメ
IF LOCAL:2 > 0
	IF num == 0
		num = 1
		CTR = FLAG:경과턴수
	ENDIF
	IF !PU_SKILLGAGE_H_GET(ARG, "高速再生")
		CALL SETS_ACTION_SKILL, ARG, "高速再生"
	;HP30%以下で1回だけ実施
	ELSEIF num1 == 0 && LOCAL:2 == 2
		CALL SETS_ACTION_SKILL, ARG, "体内フレア"
		num1 = 1
	ELSEIF CFLAG:ARG:집중플래그 == 1
		CALL SETS_ACTION_SKILL, ARG, "ヒートブレス"
	;5n+2回目の行動
	ELSEIF ((FLAG:경과턴수-CTR) + 1) % 5 == 1 && CFLAG:ARG:행동한횟수 == 1
		CALL SETS_ACTION_SKILL, ARG, "ヒートチャージ"
	;2ターン目の初回行動だけ通常攻撃(↓の6n+9のため)
	ELSEIF ((FLAG:경과턴수-CTR) + 1)  == 2 && CFLAG:ARG:행동한횟수 == 0
		CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
		num2 = num2 + 1
	;6n+9回目の行動
	ELSEIF ((FLAG:경과턴수-CTR) + 1) % 3 == 2 && CFLAG:ARG:행동한횟수 == 0
		CALL SETS_ACTION_SKILL, ARG, "テイルブレード"
		num2 = num2 + 1
	;16n+1回目の行動
	ELSEIF ((FLAG:경과턴수-CTR) + 1) % 8 == 1 && CFLAG:ARG:행동한횟수 == 0
		CFLAG:ARG:타겟 = 9
		CALL SETS_ACTION_SKILL, ARG, "高速再生"
		num2 = num2 + 1
	;テイルブレード/高速再生/通常攻撃実行回数が合計3回 かつ 2n+1回目の行動
	ELSEIF num2 == 3 && CFLAG:ARG:행동한횟수 == 0
		CALL SETS_ACTION_SKILL, ARG, "フレイムベーン"
		num2 = 0
	;それ以外
	ELSE
		CFLAG:ARG:타겟 = RAND:2 + 1
		CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
		num2 = num2 + 1
	ENDIF
ELSE
	;ここから初回行動
	IF FLAG:경과턴수 == 0
		CFLAG:ARG:타겟 = RAND:2 + 1
		CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
	;ここまで初回行動
	;6n-1回目の行動
	ELSEIF (FLAG:경과턴수 + 1) % 3 == 0 && CFLAG:ARG:행동한횟수 == 0
		CALL SETS_ACTION_SKILL, ARG, "テイルブレード"
	;4n回目の行動
	ELSEIF (FLAG:경과턴수 + 1) % 2 == 0 && CFLAG:ARG:행동한횟수 == 1
		CALL SETS_ACTION_SKILL, ARG, "フレイムベーン"
	ELSE
		CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
	ENDIF
ENDIF

;25%と50%切ったらパターン変化
SIF 現HP割合(ARG) < 50 && LOCAL:2 < 1
	LOCAL:2 = 1
SIF 現HP割合(ARG) < 30
	LOCAL:2 = 2

