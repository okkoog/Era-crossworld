#LOCALSIZE 3

;50%切ったらパターン変化
IF 現HP割合(ARG) < 50 && CFLAG:ARG:행동한횟수 == 0
	LOCAL:2 = 1
ENDIF
;FLAG:경과턴수=0が1ターン目なので特定ターンの行動を決定したいなら経過ターン数に+1しないとダメ
IF CFLAG:ARG:집중플래그 == 1
	SYUTYU = 1
ENDIF
IF LOCAL:2 == 1
	IF num == 0
		num = 1
		CTR = FLAG:경과턴수
	ENDIF
	IF SYUTYU == 1
		IF CFLAG:ARG:행동한횟수 == 0
			IF ((FLAG:경과턴수-CTR) + 1) == 3
				CALL SETS_ACTION_SKILL, ARG, "暗キ閃光"
