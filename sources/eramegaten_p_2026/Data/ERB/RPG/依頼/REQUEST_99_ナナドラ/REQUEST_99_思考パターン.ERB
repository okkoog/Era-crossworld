;=================================================
;   sub SET_ACTION_5424
;=================================================
;   依頼:ウォークライ用思考パターン
;-------------------------------------------------
@SET_ACTION_ウォークライ,ARG
#DIM num
#DIM CTR
#LOCALSIZE 3
;FLAG:경과턴수=0が1ターン目なので特定ターンの行動を決定したいなら経過ターン数に+1しないとダメ
IF LOCAL:2 == 1
	IF num == 0
		num = 1
		CTR = FLAG:경과턴수
	ENDIF
	IF CFLAG:ARG:気合フラグ == 1
		CALL SETS_ACTION_SKILL, ARG, "タイフーンハウル"
	ELSE
		;ここから初回行動
		IF (FLAG:경과턴수-CTR) == 0 && CFLAG:ARG:행동한횟수 == 0
			CALL SETS_ACTION_SKILL, ARG, "데・쿤다"
		ELSEIF (FLAG:경과턴수-CTR) == 0 && CFLAG:ARG:행동한횟수 == 1
			CALL SETS_ACTION_SKILL, ARG, "力溜め"
		;ここまで初回行動
		;10n+1回目の行動
		ELSEIF ((FLAG:경과턴수-CTR) + 1) % 5 == 1 && CFLAG:ARG:행동한횟수 == 0
			CALL SETS_ACTION_SKILL, ARG, "力溜め"
		;6n+1回目の行動
		ELSEIF ((FLAG:경과턴수-CTR) + 1) % 3 == 1 && CFLAG:ARG:행동한횟수 == 0
			CALL SETS_ACTION_SKILL, ARG, "灼熱の剛火球"
		;それ以外
		ELSE
			CALL SET_ACTION_トリニトロ_B,ARG
		ENDIF
	ENDIF
ELSE
	;5n回目の行動
	IF ((FLAG:경과턴수 + 1) % 5 == 3 && CFLAG:ARG:행동한횟수 == 0) || ((FLAG:경과턴수 + 1) % 5 == 0 && CFLAG:ARG:행동한횟수 == 1)
		CALL SETS_ACTION_SKILL, ARG, "灼熱の剛火球"
	;それ以外
	ELSE
		CALL SET_ACTION_トリニトロ_A,ARG
	ENDIF
ENDIF
;50%切ったらパターン変化
SIF 現HP割合(ARG) < 50
	LOCAL:2 = 1

;=================================================
;   sub SET_ACTION_トリニトロ_A
;=================================================
;   依頼:ウォークライ用思考パターン(サブ)
;-------------------------------------------------
@SET_ACTION_トリニトロ_A,ARG
#DIM num1
;通常攻撃→通常攻撃→ギガブレイク→頭に戻る　というローテ
IF num1 % 3 == 2
	CALL SETS_ACTION_SKILL, ARG, "ギガブレイク"
ELSE
	CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
ENDIF
;=================================================
;   sub SET_ACTION_トリニトロ_B
;=================================================
;   依頼:ウォークライ用思考パターン(サブ)
;-------------------------------------------------
;HP50％以下になったらSET_ACTION_5424_Aのnum1をリセットすればいいんだけど処理めんどくさいのでコピペ
@SET_ACTION_トリニトロ_B,ARG
#DIM num1
IF num1 % 3 == 2
	CALL SETS_ACTION_SKILL, ARG, "ギガブレイク"
	num1 = 0
ELSE
	CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
	num1 = num1 + 1
ENDIF
;=================================================
;   sub SET_ACTION_ジゴワット
;=================================================
;   依頼:ジゴワット用思考パターン
;-------------------------------------------------
@SET_ACTION_ジゴワット,ARG
#DIM num
#DIM num1
#DIM CTR
#DIM switch
#LOCALSIZE 3
IF LOCAL:2 == 1
	IF num == 0
		num = 1
		CTR = FLAG:경과턴수
	ENDIF
	IF num1 == 0
		IF (FLAG:경과턴수-CTR) == 0 && CFLAG:ARG:행동한횟수 == 0
			CALL SETS_ACTION_SKILL, ARG, "放電攻撃"
		ELSEIF ((FLAG:경과턴수-CTR) == 1 && CFLAG:ARG:행동한횟수 == 1) || ((FLAG:경과턴수-CTR) == 3 && CFLAG:ARG:행동한횟수 == 0)
			CALL SETS_ACTION_SKILL, ARG, "全体掃射"
		ELSEIF (FLAG:경과턴수-CTR) == 2 && CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:타겟 = RAND:5 + 1
			CALL SETS_ACTION_SKILL, ARG, "エイミングショット"
		ELSEIF (FLAG:경과턴수-CTR) == 3 && CFLAG:ARG:행동한횟수 == 1
			CALL SETS_ACTION_SKILL, ARG, "放電攻撃"
			num = 0
			num1 = 1
			switch = 1
		ELSE
			CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
		ENDIF
	ELSE
		IF switch == 1;パターンA(ナルカミパターン)
			IF (FLAG:경과턴수-CTR) == 0 && CFLAG:ARG:행동한횟수 == 0
				IF RAND:2 == 0
					CALL SETS_ACTION_SKILL, ARG, "데・카쟈"
				ELSE
					CALL SETS_ACTION_SKILL, ARG, "데・쿤다"
				ENDIF
			ELSEIF (FLAG:경과턴수-CTR) == 0 && CFLAG:ARG:행동한횟수 == 1
				CALL SETS_ACTION_SKILL, ARG, "超電磁チャージ"
			ELSEIF (FLAG:경과턴수-CTR) == 1 && CFLAG:ARG:행동한횟수 == 0
				CALL SETS_ACTION_SKILL, ARG, "超電磁砲"
			ELSEIF (FLAG:경과턴수-CTR) == 1 && CFLAG:ARG:행동한횟수 == 1
				CFLAG:ARG:타겟 = 9
				CFLAG:ARG:입력행동 = -1
				CFLAG:ARG:방어플래그 = 1
				num = 0
				switch = 2;次行動からパターンB開始
			ELSE
				CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
			ENDIF
		ELSEIF switch == 2;パターンB(通常攻撃パターン)
			IF (FLAG:경과턴수-CTR) == 1 && CFLAG:ARG:행동한횟수 == 0
				CALL SETS_ACTION_SKILL, ARG, "全体掃射"
			ELSEIF (FLAG:경과턴수-CTR) == 1 && CFLAG:ARG:행동한횟수 == 1
				CALL SETS_ACTION_SKILL, ARG, "エイミングショット"
			ELSEIF (FLAG:경과턴수-CTR) == 3 && CFLAG:ARG:행동한횟수 == 0
				CALL SETS_ACTION_SKILL, ARG, "放電攻撃"
			ELSEIF (FLAG:경과턴수-CTR) == 3 && CFLAG:ARG:행동한횟수 == 1
				CALL SETS_ACTION_SKILL, ARG, "全体掃射"
				num = 0
				switch = 1;次行動からパターンA開始
			ELSE
				CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
			ENDIF
		ENDIF
	ENDIF
ELSE
	IF ((FLAG:경과턴수 + 1) % 5 == 2 && CFLAG:ARG:행동한횟수 == 0) || ((FLAG:경과턴수 + 1) % 5 == 3 && CFLAG:ARG:행동한횟수 == 1)
		CALL SETS_ACTION_SKILL, ARG, "全体掃射"
	ELSEIF (FLAG:경과턴수 + 1) % 5 == 2 && CFLAG:ARG:행동한횟수 == 1
		CFLAG:ARG:타겟 = RAND:5 + 1
		CALL SETS_ACTION_SKILL, ARG, "エイミングショット"
	ELSEIF (FLAG:경과턴수 + 1) % 5 == 4 && CFLAG:ARG:행동한횟수 == 0
		IF RAND:2 == 0
			CALL SETS_ACTION_SKILL, ARG, "데・카쟈"
		ELSE
			CALL SETS_ACTION_SKILL, ARG, "데・쿤다"
		ENDIF
	ELSEIF (FLAG:경과턴수 + 1) % 5 == 4 && CFLAG:ARG:행동한횟수 == 1
		CALL SETS_ACTION_SKILL, ARG, "超電磁チャージ"
	ELSEIF (FLAG:경과턴수 + 1) % 5 == 0 && CFLAG:ARG:행동한횟수 == 0
		CALL SETS_ACTION_SKILL, ARG, "超電磁砲"
	ELSEIF (FLAG:경과턴수 + 1) % 5 == 0 && CFLAG:ARG:행동한횟수 == 1
		CFLAG:ARG:타겟 = 9
		CFLAG:ARG:입력행동 = -1
		CFLAG:ARG:방어플래그 = 1
	ELSE
		CFLAG:ARG:타겟 = RAND:5 + 1
		CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
	ENDIF
ENDIF
;50%切ったらパターン変化
SIF 現HP割合(ARG) < 50
	LOCAL:2 = 1
