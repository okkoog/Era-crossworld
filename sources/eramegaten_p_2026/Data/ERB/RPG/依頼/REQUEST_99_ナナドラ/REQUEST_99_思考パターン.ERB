;=================================================
;   sub SET_ACTION_インソムニア
;=================================================
;   依頼:インソムニア用思考パターン
;-------------------------------------------------
@SET_ACTION_インソムニア,ARG
#DIM num1
#DIM num2
#DIM CTR
#DIM SENKOKU
#DIM TAME
#DIM TAMECTR
#LOCALSIZE 3
IF CFLAG:ARG:행동한횟수 == 0
	;25%と60%切ったらパターン変化
	SIF 現HP割合(ARG) < 60 && LOCAL:2 < 1
		LOCAL:2 = 1
	SIF 現HP割合(ARG) < 40
		LOCAL:2 = 2
ENDIF
;FLAG:경과턴수=0が1ターン目なので特定ターンの行動を決定したいなら経過ターン数に+1しないとダメ
;HP40%以下
IF LOCAL:2 == 2
	IF num2 == 0
		num2 = 1
		CTR = FLAG:경과턴수
	ENDIF
	IF TAME == 1
		IF CFLAG:ARG:행동한횟수 == 0
			CALL SETS_ACTION_SKILL, ARG, "漆黒ブレス"
		ELSE
			CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
			TAME = 0
		ENDIF
	ELSEIF ((FLAG:경과턴수-CTR) + 1) % 3 == 1
		IF CFLAG:ARG:행동한횟수 == 0
			IF RAND:3 == 0
				CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
			ELSEIF RAND:2 == 0
				CALL SETS_ACTION_SKILL, ARG, "パワースラッシュ"
			ELSE
				CALL SETS_ACTION_SKILL, ARG, "물고늘어지기"
			ENDIF
		ELSE
			IF RAND:3 == 0
				CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
			ELSEIF RAND:2 == 0
				CALL SETS_ACTION_SKILL, ARG, "パワースラッシュ"
			ELSE
				CALL SETS_ACTION_SKILL, ARG, "물고늘어지기"
			ENDIF
		ENDIF
	ELSEIF ((FLAG:경과턴수-CTR) + 1) % 3 == 2
		IF CFLAG:ARG:행동한횟수 == 0
			IF RAND:2 == 0
				CALL SETS_ACTION_SKILL, ARG, "데・카쟈"
			ELSE
				CALL SETS_ACTION_SKILL, ARG, "데・쿤다"
			ENDIF
		ELSE
			CALL SETS_ACTION_SKILL, ARG, "力溜め"
			TAME = 1
		ENDIF
	ENDIF
;HP60%以下
ELSEIF LOCAL:2 == 1
	IF num1 == 0
		num1 = 1
		CTR = FLAG:경과턴수
	ENDIF
	IF SENKOKU == 1
		IF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "死の宣告")
		ELSE
			CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
			SENKOKU = 0
		ENDIF
	ELSEIF TAME == 1
		IF CFLAG:ARG:행동한횟수 == 0 && TAMECTR == 1
			CALL SETS_ACTION_SKILL, ARG, "漆黒ブレス"
		ELSEIF CFLAG:ARG:행동한횟수 == 0 && TAMECTR % 2 == 1
			IF RAND:2 == 0
				CALL SETS_ACTION_SKILL, ARG, "漆黒ブレス"
			ELSE
				CALL SETS_ACTION_SKILL, ARG, "エグゾーストブレス"
			ENDIF
		ELSEIF CFLAG:ARG:행동한횟수 == 0
			CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
		ELSE
			IF RAND:2 == 0
				CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
			ELSE
				CALL SETS_ACTION_SKILL, ARG, "パワースラッシュ"
			ENDIF
			TAME = 0
		ENDIF
	;形態変化の1ターン目は固定
	ELSEIF ((FLAG:경과턴수-CTR) + 1) == 1
		IF CFLAG:ARG:행동한횟수 == 0
			IF RAND:2 == 0
				CALL SETS_ACTION_SKILL, ARG, "데・카쟈"
			ELSE
				CALL SETS_ACTION_SKILL, ARG, "데・쿤다"
			ENDIF
		ELSE
			CALL SETS_ACTION_SKILL, ARG, "力溜め"
			TAME = 1
			TAMECTR += 1
		ENDIF
