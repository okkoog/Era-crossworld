	ENDIF
	;前ターンで力溜め済み
	IF KIAI == 1
		IF  CFLAG:ARG:행동한횟수 == 0
			CALL SETS_ACTION_SKILL, ARG, "クリスタルブレス"
		ELSE
			CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
			KIAI = 0
		ENDIF
	ELSE
		;5n+1ターンの1回目
		IF ((FLAG:경과턴수-CTR) + 1) % 5 == 1 && CFLAG:ARG:행동한횟수 == 0
			IF RAND:3 == 0
				CALL SETS_ACTION_SKILL, ARG, "ドラゴンファング"
			ELSEIF RAND:2 == 0
				CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
			ELSE
				IF RAND:2 == 0
					CALL SETS_ACTION_SKILL, ARG, "데・카쟈"
				ELSE
					CALL SETS_ACTION_SKILL, ARG, "데・쿤다"
				ENDIF
			ENDIF
		;5n+1ターンの2回目
		ELSEIF ((FLAG:경과턴수-CTR) + 1) % 5 == 1 && CFLAG:ARG:행동한횟수 == 1
			CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG, "力溜め")
		;ここまで初回行動
		;5n+3ターンの1,2回目
		ELSEIF ((FLAG:경과턴수-CTR) + 1) % 5 == 3
			IF RAND:2 == 0
				CALL SETS_ACTION_SKILL, ARG, "ドラゴンファング"
			ELSE
				CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
			ENDIF
		;5n+4ターンの2回目
		ELSEIF ((FLAG:경과턴수-CTR) + 1) % 5 == 4 && CFLAG:ARG:행동한횟수 == 1
			IF RAND:2 == 0
				CALL SETS_ACTION_SKILL, ARG, "ドラゴンファング"
			ELSE
				CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
			ENDIF
		;5nターンの2回目
		ELSEIF ((FLAG:경과턴수-CTR) + 1) % 5 == 0 && CFLAG:ARG:행동한횟수 == 1
			CALL SETS_ACTION_SKILL, ARG, "タイフーンハウル"
		;それ以外
		ELSE
			CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
		ENDIF
	ENDIF
ELSE
	;1ターン目限定の行動
	IF (FLAG:경과턴수 + 1) == 1
		IF CFLAG:ARG:행동한횟수 == 1
			IF RAND:2 == 0
				CALL SETS_ACTION_SKILL, ARG, "ドラゴンファング"
			ELSE
				CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
			ENDIF
		;それ以外
		ELSE
			CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
		ENDIF
	;2ターン目以降の行動
	ELSE
		;5n+3ターン・5nターンの1回目
		IF ((FLAG:경과턴수 + 1) % 5 == 3 && CFLAG:ARG:행동한횟수 == 0) || ((FLAG:경과턴수 + 1) % 5 == 0 && CFLAG:ARG:행동한횟수 == 0)
			CALL SETS_ACTION_SKILL, ARG, "タイフーンハウル"
		;5n+4ターン・5n+1ターンの2回目
		ELSEIF ((FLAG:경과턴수 + 1) % 5 == 4 && CFLAG:ARG:행동한횟수 == 1) || ((FLAG:경과턴수 + 1) % 5 == 1 && CFLAG:ARG:행동한횟수 == 1)
			CALL SETS_ACTION_SKILL, ARG, "ドラゴンファング"
		;それ以外
		ELSE
			CALL SETS_ACTION_SKILL, ARG, "ＡＴＴＡＣＫ"
		ENDIF
	ENDIF
ENDIF
