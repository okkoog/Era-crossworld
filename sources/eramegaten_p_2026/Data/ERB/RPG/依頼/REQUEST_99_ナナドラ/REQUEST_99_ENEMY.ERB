@SET_BOSS_ENEMY_REQUEST_99, L_ENEMY_NAME, L_NO = -1, L_OPT
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_NO
#DIM DYNAMIC L_ENEMY
#DIMS DYNAMIC L_ENEMY_NAME
#DIMS DYNAMIC L_OPT
#DIMS DYNAMIC L_ENEMY_TABLE, 20

L_ENEMY_TABLE:0 '= "워크라이", "ジゴワット", "ロア＝ア＝ルア", "トリニトロ", "スリーピーホロウ", "スリーピーホロウ2", "ザ・スカヴァー", "ゼロ＝ブルー", "ミヅチ", "ニアラ", "ニアラ_弱"
