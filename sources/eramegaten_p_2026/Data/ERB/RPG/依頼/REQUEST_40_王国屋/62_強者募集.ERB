@CHARASELLABLE_OUKOKUYA_REQ_62(ARG:0)

;ＬＶを満たしていないとアウト
SIF !(HAVE_VAGINA(ARG:0) && BASE:(ARG:0):LV >= 55)
	RETURN 0

;打撃耐性があるかをチェック
IF BASE:(ARG:0):타격 == 999 || (CFLAG:ARG:변경상성1 == 3 && CFLAG:ARG:추가변경상성치1 == 999)
;	PRINTFORMW %CALLNAME:(ARG:0)% は打撃反射でOK
ELSEIF BASE:(ARG:0):타격 == 0 || (CFLAG:ARG:변경상성1 == 3 && CFLAG:ARG:추가변경상성치1 == 0)
;	PRINTFORMW %CALLNAME:(ARG:0)% は打撃無効
ELSEIF BASE:(ARG:0):타격< 0 || (CFLAG:ARG:변경상성1 == 3 && CFLAG:ARG:추가변경상성치1 < 0)
;	PRINTFORMW %CALLNAME:(ARG:0)% は打撃反射とか吸収するからOK
ELSEIF BASE:(ARG:0):타격 == 100|| (CFLAG:ARG:변경상성1 == 3 && CFLAG:ARG:추가변경상성치1 ==  0)
;	PRINTFORMW %CALLNAME:(ARG:0)% は打撃耐性なしでアウト
	RETURN 0
ELSE
;	PRINTFORMW %CALLNAME:(ARG:0)% は打撃弱点でアウト
	RETURN 0
ENDIF

;戦技耐性があるかをチェック
IF BASE:(ARG:0):전술 == 999 || (CFLAG:ARG:변경상성1 == 4 && CFLAG:ARG:추가변경상성치1 == 999)
;	PRINTFORMW %CALLNAME:(ARG:0)% は戦技反射でOK
ELSEIF BASE:(ARG:0):전술 == 0 || (CFLAG:ARG:변경상성1 == 4 && CFLAG:ARG:추가변경상성치1 == 0)
;	PRINTFORMW %CALLNAME:(ARG:0)% は戦技無効
ELSEIF BASE:(ARG:0):전술< 0 || (CFLAG:ARG:변경상성1 == 4 && CFLAG:ARG:추가변경상성치1 < 0)
;	PRINTFORMW %CALLNAME:(ARG:0)% は戦技反射とか吸収するからOK
ELSEIF BASE:(ARG:0):전술 == 100|| (CFLAG:ARG:변경상성1 == 4 && CFLAG:ARG:추가변경상성치1 ==  0)
;	PRINTFORMW %CALLNAME:(ARG:0)% は戦技耐性なしでアウト
	RETURN 0
ELSE
;	PRINTFORMW %CALLNAME:(ARG:0)% は戦技弱点でアウト
	RETURN 0
ENDIF

RETURN 1

