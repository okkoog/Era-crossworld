@TAKE_REWARD_OUKOKUYA_REQ_62, ARG
CALL CHARA_SELL, ARG, 1
LOCAL = RESULT
CALL MESSAGE_WINDOW, "후루이치안", @"감사합니다.　이걸로 그 자식을 이길 수 있겠습니다", , , , , 4
CALL MESSAGE_WINDOW, "후루이치안", @"보수인 악마입니다만, 서버로 전송해 두었습니다", , , , , 4
CALL MESSAGE_WINDOW, "", @"＞의뢰를 달성하여/＞마수 스핑크스가 동료악마가 되었다.", , , , , 4

;売却代と名声
MONEY:1 += LOCAL
FLAG:조교사명성 += 150

;帳簿閲覧用処理
CALL 帳簿閲覧, ARG, LOCAL

;スフィンクス加入処理
;"対バエル用に悪魔を合体したけど事故った"という設定
CALL ADD_NEW_COMPANION, [[キャラ:스핑크스]], 500, 1, , , 56
