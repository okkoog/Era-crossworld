RESULTS += "/조건/"
RESULTS += "소녀 말투의 악마/"
RESULTS += "소질[모성]을 소지/"
RESULTS += "경험[출산경험]이 1 이상/"
RESULTS += "/비고/"
RESULTS += "요즘은 『바부미』? 인가 하는 게 유행인 모양이니까/"
RESULTS += "앞으로를 위해 어떤 것인지 알아두려고 해/"
RESULTS += "/아이인데 엄마인 거였나?"

@CHARASELLABLE_OUKOKUYA_REQ_60(ARG:0)
SIF !(HAVE_VAGINA(ARG:0) && ABL:(ARG:0):회화타입 == 303 && TALENT:(ARG:0):모성 && EXP:(ARG:0):출산경험 > 0)
	RETURN 0
RETURN 1

;--------------------------------------------------------
;報酬処理
;ただし、売却人数・属性変動などは共通で処理済み
;調教師名声の処理はされてないので適宜処理してください
;
;ARGはキャラクター
;--------------------------------------------------------
@TAKE_REWARD_OUKOKUYA_REQ_60, ARG

CALL CHARA_SELL, ARG, 1
LOCAL = RESULT
CALL MESSAGE_WINDOW, "", @"＞의뢰를 달성하여/＞{LOCAL}마카를 손에 넣었습니다", , , , , 4
MONEY:1 += LOCAL
FLAG:조교사명성 += 25

;帳簿閲覧用処理
CALL 帳簿閲覧, ARG, LOCAL
