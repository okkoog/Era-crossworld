;-------------------------------------------------------------
;ランダム依頼はABL/TALENT/종족/스킬/属性の5種類
;なお依頼はSAVESTR:王国屋ランダム依頼Xの中に
;0/    /1     /   2/     3/   4/     5
;ABL_LV/TALENT/종족/스킬/属性/報酬補正 でしまう
;-------------------------------------------------------------
@SET_OUKOKUYA, ARG
#DIM ABL依頼
#DIM TALENT依頼
#DIM 種族依頼
#DIM スキル依頼
#DIM 属性依頼
#DIM 報酬補正
#DIM 主人ランク
#DIMS 依頼

;-------------------------------------------------------------
;乱数を固定
;種は操作手段がかなり限られてくるＥＸＰと毎日変わるDAYを使ってみる
;先の日付まで確認して利用するのはEXPさえ変動させなければ可能という裏ワザが残るけどまぁたぶんこのくらいなら問題ない
;-------------------------------------------------------------
RANDOMIZE BASE:MASTER:ＥＸＰ * DAY + ARG

;-------------------------------------------------------------
;フラグ初期化
;-------------------------------------------------------------
ABL依頼 = 0
TALENT依頼 = 0
種族依頼 = 0
スキル依頼 = 0
属性依頼 = 0
報酬補正 = 0
依頼 = 
;-------------------------------------------------------------
;依頼パターン設定
;絶対にABLかTALENTの1つは絡ませる
;ABLは補正が高いのと複数つくことで時間経過のロスが現象しやすいので1個限定にする
;-------------------------------------------------------------
SELECTCASE RAND:100
	CASE IS < 20
		ABL依頼 = 1
	CASE IS < 40
		ABL依頼 = 1
		TALENT依頼 = 1
	CASE IS < 60
		TALENT依頼 = 1
	CASE IS < 70
		TALENT依頼 = 2
	CASE IS < 75
		TALENT依頼 = 2
	CASE IS < 80
		種族依頼 = 1
		TALENT依頼 = RAND:2
		ABL依頼 = RAND:2
	CASE IS < 90
		スキル依頼 = 1
		TALENT依頼 = RAND:2
		ABL依頼 = RAND:2
	CASEELSE
		属性依頼 = 1 + !RAND:4
		TALENT依頼 = RAND:2
		ABL依頼 = RAND:2
ENDSELECT

;----------------------------------------------------------------------------------------------------
;ABL依頼のセット
;従順技巧欲望は4・5のみ
;その他は3・4・5
;
;BLっ気・BL中毒・撮影・料理・歌唱はとりあえず価格定義はしてあるけど選考から除外
;また、価格定義の問題
;----------------------------------------------------------------------------------------------------
IF ABL依頼
	LOCALS = %RAND_SPLIT("순종/기교/Ｃ감각/Ｖ감각/Ａ감각/Ｂ감각/봉사정신/노출증/마조끼/새드끼/레즈끼/레즈중독/자위중독/정액중독/섹스중독/분유중독/수간중독/촉수중독/윤간중독/키스중독", "/")%
	IF GETNUM(ABL, LOCALS) == -1
		PRINTFORMW 왕국점의뢰에 존재하지 않는 ABL「%LOCALS%」이 지정되었으므로 처리를 중단합니다、
		RETURN 0
	ENDIF
	LOCAL = RAND(3 + GROUPMATCH(LOCALS, "순종", "기교", "욕망"), 6)
	報酬補正 += OUKOKUYA_PRICE_ABL(LOCALS, LOCAL)
	依頼 += @"%LOCALS%_{LOCAL}"
ENDIF
依頼 += "/"

;----------------------------------------------------------------------------------------------------
;TALENT依頼のセット
;従順技巧欲望は4・5のみ
;その他は3・4・5
;
;BLっ気・BL中毒・撮影・料理・歌唱はとりあえず価格定義はしてあるけど選考から除外
;また、価格定義の問題
;----------------------------------------------------------------------------------------------------
LOCALS = 
WHILE TALENT依頼
	LOCAL = RAND:200
	;価格が定義されてないものを弾く
	SIF !OUKOKUYA_PRICE_TALENT(TALENTNAME:LOCAL)
		CONTINUE
	;すでに選定されているかのチェック
	SIF STRCOUNT(依頼, TALENTNAME:LOCAL)
		CONTINUE
	;両立不可能な素質のチェック
	SELECTCASE TALENTNAME:LOCAL
		CASE "프라이드높음"
			SIF STRCOUNT(依頼, "프라이드낮음")
				CONTINUE
		CASE "프라이드낮음"
			SIF STRCOUNT(依頼, "프라이드높음")
				CONTINUE
		CASE "호기심"
			SIF STRCOUNT(依頼, "보수적")
				CONTINUE
		CASE "보수적"
			SIF STRCOUNT(依頼, "호기심")
				CONTINUE
		CASE "낙관적"
			SIF STRCOUNT(依頼, "비관적")
				CONTINUE
		CASE "비관적"
			SIF STRCOUNT(依頼, "낙관적")
				CONTINUE
		CASE "정조관념"
			SIF STRCOUNT(依頼, "정조관결여")
				CONTINUE
		CASE "정조관결여"
			SIF STRCOUNT(依頼, "정조관념")
				CONTINUE
		CASE "해방"
			SIF STRCOUNT(依頼, "억압")
				CONTINUE
		CASE "억압"
			SIF STRCOUNT(依頼, "해방")
				CONTINUE
		CASE "아픔에강함"
			SIF STRCOUNT(依頼, "아픔에약함")
				CONTINUE
		CASE "아픔에약함"
			SIF STRCOUNT(依頼, "아픔에강함")
				CONTINUE
		CASE "젖기어려움"
			SIF STRCOUNT(依頼, "젖기쉬움")
				CONTINUE
		CASE "젖기쉬움"
			SIF STRCOUNT(依頼, "젖기어려움")
				CONTINUE
		CASE "습득빠름"
			SIF STRCOUNT(依頼, "습득느림")
				CONTINUE
		CASE "습득느림"
			SIF STRCOUNT(依頼, "습득빠름")
				CONTINUE
		CASE "악취민감"
			SIF STRCOUNT(依頼, "악취둔감")
				CONTINUE
		CASE "악취둔감"
			SIF STRCOUNT(依頼, "악취민감")
				CONTINUE
	ENDSELECT
	報酬補正 += OUKOKUYA_PRICE_TALENT(TALENTNAME:LOCAL)
	依頼 +=TALENTNAME:LOCAL
	SIF TALENT依頼 -- > 1
		依頼 += "_"
	
WEND
依頼 += "/"
;----------------------------------------------------------------------------------------------------
;種族設定
;種族番号 1 - 11まで(つまり基本的な種族のみ)
;----------------------------------------------------------------------------------------------------
IF 種族依頼
	依頼 += STR:RAND(1, 12)
	報酬補正 += 30
ENDIF
依頼 += "/"
;---------------------------------------------------------------------------------------------------
;스킬설정
;
;指定されるスキルの候補は主人のレベルに依存する
;価格補正はカード用意の手間が若干のMAGと全書の呼び出し代くらいしか違いでないのと
;低ランクのほうが高レベル悪魔に持たせにくいのと、ここで上昇かけると二次関数的に価格上昇かかるので一律で30％に
;---------------------------------------------------------------------------------------------------
IF スキル依頼
	SELECTCASE BASE:MASTER:LV
		CASE IS < 8
			主人ランク = 2
		CASE IS < 15
			主人ランク = 3
		CASE IS < 25
			主人ランク = 4
		CASE IS < 35
			主人ランク = 5
		CASE IS < 40
			主人ランク = 6
		CASE IS < 45
			主人ランク = 8
		CASE IS < 50
			主人ランク = 9
		CASE IS < 55
			主人ランク = 11
		CASE IS < 60
			主人ランク = 12
		CASE IS < 65
			主人ランク = 13
		CASE IS < 70
			主人ランク = 14
		CASEELSE
			主人ランク = 15
	ENDSELECT
	WHILE 1
		LOCAL = RAND(1, 2500)
		;銃・基本スキルは除く
		SIF RANGE(LOCAL, 2101, 2399)
			CONTINUE
		;ランクを見る
		CALL GET_SKILL_PROP, "SKILL_RANK", LOCAL, -1
		SIF RESULT > 主人ランク
			CONTINUE
		SIF RESULT == 0
			CONTINUE
		CALL GET_SKILL_PROP, "敵専用", LOCAL, -1
		SIF RESULT
			CONTINUE
		CALL GET_SKILL_PROP, "ロール専用", LOCAL, -1
		SIF RESULT
			CONTINUE
		CALL GET_SKILL_PROP, "継承不能", LOCAL, -1
		SIF RESULT
			CONTINUE
		依頼 += @"{LOCAL}"
		報酬補正 += 30
		BREAK
	WEND
ENDIF
依頼 += "/"
IF 属性依頼
	LOCALS = %RAND_SPLIT("LIGHT/NEUTRAL(LD軸)/DARK/LAW/NEUTRAL(LC軸)/CHAOS", "/")%
	依頼 += LOCALS
	IF 属性依頼 == 2
		WHILE 1
			LOCALS:1 = %RAND_SPLIT("LIGHT/NEUTRAL(LD軸)/DARK/LAW/NEUTRAL(LC軸)/CHAOS", "/")%
			SIF LOCALS == LOCALS:1
				CONTINUE
			依頼 += "_" + LOCALS:1
			BREAK
		WEND
	ENDIF
	報酬補正 += 属性依頼 == 2 ? 50 # 20
ENDIF

SAVESTR:@"왕국점의뢰{ARG}" = %依頼%/{報酬補正}
RETURN 1
;-----------------------------------------------------------------------------------------------------
;TALENTの価格定義
;価格の基準は難度上昇素質　＞　難度低下素質　かつ　難度低下素質の中で価格低下するもの　＞上昇するもの
;つまり、難度面・価格面で扱いにくい素質ほど高価格になる
;
;ARGS	TALENT名称
;-----------------------------------------------------------------------------------------------------
@OUKOKUYA_PRICE_TALENT, ARGS
#FUNCTION
SELECTCASE ARGS
	CASE "자위광", "섹스광", "애널광", "음유", "창놈"
		RETURNF 100
	CASE "꿋꿋함", "반항적", "자제심", "일선을넘지않음", "약독내성", "쾌감을부정", "새드", "마조", "여성혐오", "남성혐오", "회복느림"
		RETURNF 50
	CASE "무관심", "프라이드높음", "건방짐", "감정결핍", "정조관념", "부끄럼쟁이", "부끄럼없음", "아픔에강함", "젖기어려움", "습득느림"
		RETURNF 40
	CASE "솔직함", "얌전함", "츤데레", "보수적", "겁쟁이", "프라이드낮음", "정조관결여", "아픔에약함", "쾌감에솔직"
		RETURNF 30
	CASE "호기심", "눈에띄고싶어함", "해방", "젖기쉬움", "습득빠름", "혀놀림", "자위하기쉬움", "도착적", "소악마", "헌신적", "매력", "매혹", "회복빠름"
		RETURNF 20
ENDSELECT
;LVは0-5を返す
;-------------------------------------------------
;ABLの価格定義
;他のカテゴリーは用意の手間があるものの時間経過しないものの
;このカテゴリーは用意の手間こそほとんどないものの確実に時間ロスするので
;高めに設定
;なお、6レベル以上は明らかに用意コストが高くなりすぎるのでとりあえず置いておく
;
;ARGS	ABL名称
;ARG	ABLレベル
;-------------------------------------------------
@OUKOKUYA_PRICE_ABL, ARGS, ARG
#FUNCTION
SELECTCASE ARGS
	CASE "순종", "기교", "욕망"
		SELECTCASE ARG
			CASE 4
				RETURNF 20
			CASE 5
				RETURNF 30
		ENDSELECT
	CASE "Ｃ감각", "Ｂ감각", "Ｖ감각", "Ａ감각"
		SELECTCASE ARG
			CASE 3
				RETURNF 10
			CASE 4
				RETURNF 15
			CASE 5
				RETURNF 20
		ENDSELECT
	CASE "봉사정신", "노출증", "마조끼", "새드끼", "레즈끼", "ＢＬ끼"
		SELECTCASE ARG
			CASE 3
				RETURNF 15
			CASE 4
				RETURNF 30
			CASE 5
				RETURNF 50
		ENDSELECT
	CASE "자위중독", "정액중독", "레즈중독", "섹스중독", "분유중독", "키스중독"
		SELECTCASE ARG
			CASE 3
				RETURNF 25
			CASE 4
				RETURNF 50
			CASE 5
				RETURNF 75
		ENDSELECT
	CASE "수간중독", "촉수중독", "윤간중독", "가창기능", "요리기능", "촬영기능"
		SELECTCASE ARG
			CASE 3
				RETURNF 30
			CASE 4
				RETURNF 60
			CASE 5
				RETURNF 100
		ENDSELECT
ENDSELECT

@SHOW_OUKOKUYA_REQ_RANDOM, ARG
#DIMS 表示内容
#LOCALSSIZE 6
SPLIT SAVESTR:@"왕국점의뢰{ARG}", "/", LOCALS
表示内容 = 
表示内容 += @"/일반의뢰{ARG}%\@GETBIT(依頼フラグ:[[依頼:왕국점]]:0, ARG) ?(予約中)#\@%/"
表示内容 += @"난이도:☆%"☆"* (TOINT(LOCALS:5) / 20)%/"
表示内容 += "보수:조건을 만족시킨 악마의 가치에 상응하는 마카/"
表示内容 += "/조건/"
IF LOCALS != ""
	SPLIT LOCALS, "_", RESULTS
	表示内容 += @"능력 [%RESULTS%]이 Lv%RESULTS:1% 이상/"
ENDIF
IF LOCALS:1 != ""
	SPLIT LOCALS:1, "_", RESULTS
	FOR LOCAL, 0, RESULT
		表示内容 += @"소질 [%RESULTS:LOCAL%] 소지/"
	NEXT
ENDIF
SIF LOCALS:2 != ""
	表示内容 += @"종족이 [%LOCALS:2%]일 것/"
IF LOCALS:3 != ""
	CALL GETS_SKILL_PROP, "SKILL_NAME", LOCALS:3
	表示内容 += @"스킬 [%RESULTS%] 소지/"
ENDIF
IF LOCALS:4 != ""
	SPLIT LOCALS:4, "_", RESULTS
	表示内容 += @"속성이 [%RESULTS%]일 것/"
	SIF RESULT > 1
		表示内容 += @"속성이[%RESULTS:1%]일 것/"
ENDIF
表示内容 += "/" * (17 - STRCOUNT(表示内容, "/"))
CALL SHOW_PICTURE, "NONFLOORD", "펫숍 왕국점", 表示内容

@CHARASELLABLE_OUKOKUYA_REQ(ARG:0)
#LOCALSSIZE 6
;売却可能でないとだめ
SIF !GET_CHARASELLABLE(ARG:0)
	RETURN 0
;悪魔でないとだめ
SIF !GET_DEVIL(ARG:0)
	RETURN 0
;Rは依頼番号
;1～3の時はランダム依頼
IF RANGE(R, 1, 3)
	SPLIT SAVESTR:@"왕국점의뢰{R}", "/", LOCALS
	;一つ目はABL
	IF LOCALS != ""
		SPLIT LOCALS, "_", RESULTS
		SIF ABL:(ARG:0):RESULTS < TOINT(RESULTS:1)
			RETURN 0
	ENDIF
	IF LOCALS:1 != ""
		SPLIT LOCALS:1, "_", RESULTS
		FOR LOCAL, 0, RESULT
			SIF !TALENT:(ARG:0):(RESULTS:LOCAL)
				RETURN 0
		NEXT
	ENDIF
	IF LOCALS:2 != ""
		SIF STR:(ABL:(ARG:0):종족) != LOCALS:2
			RETURN 0
	ENDIF
	IF LOCALS:3 != ""
		SIF !HAVE_SKILL(ARG:0, TOINT(LOCALS:3))
			RETURN 0
	ENDIF
	IF LOCALS:4 != ""
		SPLIT LOCALS:4, "_", RESULTS
		FOR LOCAL, 0, RESULT
			SELECTCASE RESULTS:LOCAL
				CASE "LIGHT"
					SIF ABL:(ARG:0):속성LD != 1
						RETURN 0
				CASE "NEUTRAL(LD軸)"
					PRINTFORMW %CALLNAME:(ARG:0)%의 속성LD는 {ABL:(ARG:0):속성LD}
					SIF ABL:(ARG:0):속성LD != 2
						RETURN 0
				CASE "DARK"
					SIF ABL:(ARG:0):속성LD != 3
						RETURN 0
				CASE "LAW"
					SIF ABL:(ARG:0):속성LC != 1
						RETURN 0
				CASE "NEUTRAL(LC軸)"
					SIF ABL:(ARG:0):속성LC != 2
						RETURN 0
				CASE "CHAOS"
					SIF ABL:(ARG:0):속성LC != 3
						RETURN 0
			ENDSELECT
		NEXT
	ENDIF
ELSE
	CALLFORM CHARASELLABLE_OUKOKUYA_REQ_{R}(ARG:0)
	SIF !RESULT
		RETURN 0
ENDIF
RETURN 1


@CHARATALENTCHECK_OUKOKUYA_REQ(ARG)
#LOCALSSIZE 6
;悪魔でないとだめ
SIF !GET_DEVIL(ARG)
	RETURN 0
;Rは依頼番号
;1～3の時はランダム依頼
IF RANGE(R, 1, 3)
	SPLIT SAVESTR:@"왕국점의뢰{R}", "/", LOCALS
	;一つ目はABL
	IF LOCALS:1 != ""
		SPLIT LOCALS:1, "_", RESULTS
		FOR LOCAL, 0, RESULT
			SIF !TALENT:ARG:(RESULTS:LOCAL)
				RETURN 0
		NEXT
	ENDIF
	IF LOCALS:2 != ""
		SIF STR:(ABL:ARG:종족) != LOCALS:2
			RETURN 0
	ENDIF
	IF LOCALS:3 != ""
		SIF !HAVE_SKILL(ARG, TOINT(LOCALS:3))
			RETURN 0
	ENDIF
	IF LOCALS:4 != ""
		SPLIT LOCALS:4, "_", RESULTS
		FOR LOCAL, 0, RESULT
			SELECTCASE RESULTS:LOCAL
				CASE "LIGHT"
					SIF ABL:ARG:속성LD != 1
						RETURN 0
				CASE "NEUTRAL(LD軸)"
					PRINTFORMW %CALLNAME:ARG%의 속성LD는 {ABL:ARG:속성LD}
					SIF ABL:ARG:속성LD != 2
						RETURN 0
				CASE "DARK"
					SIF ABL:ARG:속성LD != 3
						RETURN 0
				CASE "LAW"
					SIF ABL:ARG:속성LC != 1
						RETURN 0
				CASE "NEUTRAL(LC軸)"
					SIF ABL:ARG:속성LC != 2
						RETURN 0
				CASE "CHAOS"
					SIF ABL:ARG:속성LC != 3
						RETURN 0
			ENDSELECT
		NEXT
	ENDIF
ELSE
	CALLFORM CHARATALENTCHECK_OUKOKUYA_REQ_{R}(ARG)
	SIF !RESULT
		RETURN 0
ENDIF
RETURN 1

