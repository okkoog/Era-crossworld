;--------------------------------------------------------
;報酬処理
;ただし、売却人数・属性変動などは共通で処理済み
;調教師名声の処理はされてないので適宜処理してください
;
;ARGはキャラクター
;--------------------------------------------------------
@TAKE_REWARD_OUKOKUYA_REQ_21, ARG
#LOCALSIZE 1
CALL CHARA_SELL, ARG, 1
LOCAL = RESULT
LOCAL = LOCAL * 125 / 100
CALL MESSAGE_WINDOW, "", @"＞의뢰를 달성하고/＞{LOCAL}마카\@!HAVE_INSTALLSOFT("에너미바이바이") ?와 에너미바이바이#\@를 손에 넣었습니다", , , , , 4
SIF !HAVE_INSTALLSOFT("에너미바이바이")
	CALL GETS_INSTALLSOFT, "에너미바이바이"
MONEY:1 += LOCAL
FLAG:조교사명성 += LOCAL / 100

;帳簿閲覧用処理
CALL 帳簿閲覧, ARG, LOCAL
