@CHARASELLABLE_OUKOKUYA_REQ_21(ARG:0)
SIF !(IS_MALE(ARG:0) || (ABL:(ARG:0):레즈끼 >= 3 && ABL:(ARG:0):레즈중독 >= 1))
	RETURN 0
