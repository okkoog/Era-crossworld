
;依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:0を参照する部分
;32個(CASE 31)まで作成可能
@REQUEST_80_PLAYABLE_0(ARG)
SELECTCASE ARG
CASE 0
	;条件はダークかノーマル
	SIF (ABL:MASTER:속성LD == 3 || ABL:MASTER:속성LD == 2)
		RETURN 1
CASE 1 
	;条件は貢献度20万以上で、ライトかノーマル
	IF FLAG:조직공헌도 >= 200000
		SIF (ABL:MASTER:속성LD == 1 || ABL:MASTER:속성LD == 2)
			RETURN 1
	ENDIF
CASE 2
	;条件はあなたレベル10以上、すぐ出てくる
	SIF BASE:MASTER:LV > 10
		RETURN 1
CASE 3
	;条件は貢献度と総コンサート総利益が10万以上で、あなたレベルが15以上
	IF FLAG:조직공헌도 >= 100000 && FLAG:총콘서트총이익 >= 100000
		SIF BASE:MASTER:LV > 15
			RETURN 1
	ENDIF
CASE 4
	;あなたのレベル15以上
	SIF BASE:MASTER:LV > 15
		RETURN 1
CASE 5
	;有香ちゃんが恋慕ルートで陥落+アイドル人気が50以上
	IF FINDCHARA_B([[キャラ:유카_아이마스]]) >= 1
		SIF (TAlENT:GETCHARA([[キャラ:유카_아이마스]]):연모 || TALENT:GETCHARA([[キャラ:유카_아이마스]]):친애) && CFLAG:GETCHARA([[キャラ:유카_아이마스]]):아이돌인기 > 49
		RETURN 1
	ENDIF
;CASE 6
	;メロウイエロー三人が恋慕ルートで陥落+アイドル人気100以上
	;IF FINDCHARA_B([[キャラ:유카_아이마스]]) >= 1 && FINDCHARA_B([[キャラ:미즈모토 유카리]]) >= 1 && FINDCHARA_B([[キャラ:노리코_아이마스]]) >= 1
	;SIF (TALENT:GETCHARA([[キャラ:유카_아이마스]]):연모 || TALENT:GETCHARA([[キャラ:유카_아이마스]]):친애) && CFLAG:GETCHARA([[キャラ:유카_아이마스]]):아이돌인기 > 99 && (TALENT:GETCHARA([[キャラ:미즈모토 유카리]]):연모 || TALENT:GETCHARA([[キャラ:미즈모토 유카리]]):친애) && CFLAG:GETCHARA([[キャラ:미즈모토 유카리]]):아이돌인기 > 99 && (TALENT:GETCHARA([[キャラ:노리코_아이마스]]):연모 || TALENT:GETCHARA([[キャラ:노리코_아이마스]]):친애) && CFLAG:GETCHARA([[キャラ:노리코_아이마스]]):아이돌인기 > 99
		;RETURN 1
	;ENDIF
CASE 10
	;あなたがレベル20以上
	SIF BASE:MASTER:LV > 20
		RETURN 1
ENDSELECT
RETURN 0


