;イベントは全部ビット演算を使うことにする
;改造)	イベント1つ毎に2つのビットを使用し未読チェックを行う様に
;		その関係で1つの変数に保存できるイベント数は64個から32個に減少
;イベントベースは内部処理に特化し、【イベント作りたい人が見なくてもいい部分】として独立化。


;追記)	戦闘中イベントの処理を実装するに際して【現在実行中のイベント】を取得しておきたかったので
;		イベント呼び出し前に一行ずつ追加し、依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:11に【実行するイベントのタイトル番号】を記録させる処理を追加。
;		ただし、引用する依頼フラグに関してはL_INDEXの最終値+1を参照するため、そこに関して後々弄る必要はない
;====================
;条件
;====================
@GET_REQUEST_NAME_80
#FUNCTIONS
RESULTS_F '= "シンデレラガールズ依頼"
RETURNF RESULTS_F

@PLAYABLE_REQUEST_80
#DIM L_INDEX
SIF !GETS_USEABLE_EXTRA_TITLE("アイマス")
	RETURN 0
SIF GET_PAYMENT_RANK() < 1
	RETURN 0
VARSET LOCAL
;インデックスを参照
;参照する配列とBIT値を得る為二重ループ
;現在は10×32の320個まで作成できる計算。
;増やしたい場合は↓の行の"LOCAL,0,10"の最後の10を増やせばOK(最大100)
FOR L_INDEX,0,20
	FOR LOCAL,0,32
		SIF GETBIT(依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:L_INDEX,LOCAL)
			CONTINUE
		TRYCCALLFORM REQUEST_80_PLAYABLE_{L_INDEX} , LOCAL
		CATCH
			BREAK
		ENDCATCH
		SIF !RESULT && !GETBIT(依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:L_INDEX,LOCAL)
			CONTINUE
		IF !GETBIT(依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:L_INDEX,LOCAL+32)
			SETBIT 依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:L_INDEX,LOCAL+32
			CALLFORM REQUEST_80_TITLELIST_{L_INDEX} , LOCAL
			LOCALS = （EX:IM＠S）의뢰 【신데렐라걸【%RESULTS%】】%조사만처리(RESULTS,"가")% 출현！
			CALL MESSAGE_B(1, LOCALS)
		ENDIF
		;まだ見てないイベントの数をカウント
		SIF !GETBIT(依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:L_INDEX,LOCAL)
			LOCAL:1++
		LOCAL:2++
	NEXT
NEXT
IF LOCAL:1 > 0
	RESULTS = （EX:IM＠S）신데렐라걸\(신규{LOCAL:1}개\)
ELSE
	RESULTS = （EX:IM＠S）신데렐라걸
ENDIF
SIF LOCAL:2
	RETURN 1
;====================
;説明
;====================
@EXPLAIN_REQUEST_80

;====================
;内容
;====================
@REQUEST_80
#DIM L_INDEX
CUSTOMDRAWLINE =
PRINTFORML 어느 이벤트를 봅니까？
CUSTOMDRAWLINE =

FOR L_INDEX,0,10
	FOR LOCAL,0,32
		SIF GETBIT(依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:L_INDEX,LOCAL)
			CONTINUE
		TRYCCALLFORM REQUEST_80_PLAYABLE_{L_INDEX} , LOCAL
		CATCH
			BREAK
		ENDCATCH
		SIF !RESULT && !GETBIT(依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:L_INDEX,LOCAL)
			CONTINUE
		CALLFORM REQUEST_80_TITLELIST_{L_INDEX} , LOCAL
		SIF RESULT == 0
			CONTINUE
		PRINTFORM [{L_INDEX*100+LOCAL,4}] %RESULTS%
		PRINTL
	NEXT
NEXT
PRINTFORML [9999]돌아간다
$INPUT_LOOP
INPUT
SIF RESULT == 9999
	RETURN
TFLAG:0 = RESULT
LOCAL:3 = RESULT / 100
LOCAL:4 = RESULT % 100
TRYCCALLFORM REQUEST_80_PLAYABLE_{LOCAL:3} , LOCAL:4
	SIF GETBIT(依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:L_INDEX,LOCAL)
		GOTO END_EVENT
	SIF !RESULT && !GETBIT(依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:L_INDEX,LOCAL)
		GOTO END_EVENT
	依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:(L_INDEX+1)=LOCAL:4;現在実行中のイベントのタイトル番号を依頼フラグ80:(L_INDEX+1)に記録する。
	CALLFORM REQUEST_80_TITLELIST_{LOCAL:3} , LOCAL:4
	CALLFORM REQUEST_80_%RESULTS%
	依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:(L_INDEX+1)=0;タイトル番号の記録を初期化。
	PRINTL
	PRINTL
	;既読にする
	SETBIT 依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:(LOCAL:3),LOCAL:4
	RESTART
CATCH
ENDCATCH
$END_EVENT
CLEARLINE 1
GOTO INPUT_LOOP

;====================
;出現チェック関数
;====================
@REQUEST80_APP_CHECK,ARG,ARG:1
#FUNCTION
RETURNF GETBIT(依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:ARG,ARG:1+32)

;====================
;既読チェック関数
;====================
@REQUEST80_READ_CHECK,ARG,ARG:1
#FUNCTION
RETURNF GETBIT(依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:ARG,ARG:1)

;------
;使用例
;------
;深淵なる闇からの誘いをクリアしたかどうか
;SIF REQUEST80_READ_CHECK(0,2)
;	RETURN 1

;====================
;出現チェック関数(タイトルで)
;====================
@REQUEST80_APP_CHECK_T,ARGS = ""
#DIM L_INDEX,2
SIF ARGS == ""
	RETURN 0
FOR L_INDEX,0,20
	FOR L_INDEX:1,0,32
		TRYCCALLFORM REQUEST_80_TITLELIST_{L_INDEX} , L_INDEX:1
			SIF ARGS == RESULTS
				RETURN GETBIT(依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:L_INDEX,L_INDEX:1+32)
		CATCH
			BREAK
		ENDCATCH
	NEXT
NEXT
RETURN 0

;====================
;既読チェック関数(タイトルで)
;====================
@REQUEST80_READ_CHECK_T,ARGS = ""
#DIM L_INDEX,2
SIF ARGS == ""
	RETURN 0
FOR L_INDEX,0,20
	FOR L_INDEX:1,0,32
		TRYCCALLFORM REQUEST_80_TITLELIST_{L_INDEX} , L_INDEX:1
			SIF ARGS == RESULTS
				RETURN GETBIT(依頼フラグ:[[依頼:신데렐라걸즈의뢰]]:L_INDEX,L_INDEX:1)
		CATCH
			BREAK
		ENDCATCH
	NEXT
NEXT
RETURN 0

