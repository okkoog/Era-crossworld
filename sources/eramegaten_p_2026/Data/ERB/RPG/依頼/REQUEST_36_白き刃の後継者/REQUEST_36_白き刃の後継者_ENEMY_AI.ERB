;=======================================================================
;
;聖域の策謀
;
;=======================================================================
;アーシェラが生きている限り、ターンエンドごとに2体のマシンが追加される。
@EVENT_BATTLE_TURNEND_聖域の策謀
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_ENEMY
#DIM DYNAMIC L_ENEMYNO
#DIM DYNAMIC IS_PUSHED, 2
#DIM CONST POS_TABLE = 9, 14, 8, 13, 10, 15, 7, 12, 11, 16
SIF IS_BADSTATE(GET_ENEMY("アーシェラ"), "DYING")
	RETURN 0
FOR LCOUNT:1, 0, 2
	IS_PUSHED = 0
	FOR LCOUNT, 0, VARSIZE("POS_TABLE")
		SIF POS(POS_TABLE:LCOUNT) >= 0
			CONTINUE
		FOR L_ENEMYNO, 0, 4
			IF LCOUNT:1
				L_ENEMY = GET_ENEMY(@"T95メデューサ_{L_ENEMYNO}")
			ELSE
				L_ENEMY = GET_ENEMY(@"T95ゴーレム_{L_ENEMYNO}")
			ENDIF
			SIF CPOS(L_ENEMY) > 0
				CONTINUE
			CFLAG:L_ENEMY:800 = 0
			CALL REFRESH_BATTLE_CHARA_FLAG, L_ENEMY
			CALL HEALTH_CHARA, L_ENEMY
			CALL INSERT_POSITION, POS_TABLE:LCOUNT, L_ENEMY
			IS_PUSHED:(LCOUNT:1) = 1
			BREAK
		NEXT
		SIF IS_PUSHED:(LCOUNT:1)
			BREAK
	NEXT
NEXT
IF IS_PUSHED:0 || IS_PUSHED:1
	SETCOLOR COLOR("ENEMY")
	CALL MESSAGE_B2, , , "증원이 나타났다!"
	RESETCOLOR
ENDIF

@SET_ACTION_アーシェラ_聖域の策謀, ARG
IF CFLAG:ARG:１more플래그 > 0
	CFLAG:ARG:입력행동 = [[스킬:만마의일격]]
ELSE
	IF CFLAG:ARG:행동한횟수 == 0
		;エイダか自分の能力が一定以上下がってるなら
		IF GET_カジャンダ_MIN(ARG) < -16 || GET_カジャンダ_MIN(GET_ENEMY("エイダ")) < -16
			CFLAG:ARG:입력행동 = [[스킬:침묵의기도]]
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CFLAG:ARG:입력행동 = [[스킬:파워브레스]]
				CASE 1
					CFLAG:ARG:입력행동 = [[스킬:타룬・다]]
				CASE 2
					CFLAG:ARG:입력행동 = [[스킬:메・디아]]
			ENDSELECT
		ENDIF
	ELSE
		IF RAND:2
			IF CFLAG:ARG:꿰뚫는투기
				IF RAND:2
					CFLAG:ARG:입력행동 = [[스킬:브레이브재퍼]]
				ELSE
					CFLAG:ARG:입력행동 = [[스킬:델타포스]]
				ENDIF
			ELSE
				IF RAND:2
					CFLAG:ARG:입력행동 = [[스킬:꿰뚫는투기]]
				ELSE
					CFLAG:ARG:입력행동 = 0
				ENDIF
			ENDIF
		ELSE
			IF RAND:2
				CFLAG:ARG:입력행동 = [[스킬:만마의일격]]
			ELSE
				CFLAG:ARG:입력행동 = 0
			ENDIF
		ENDIF
	ENDIF
ENDIF
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동

@SET_ACTION_エイダ_聖域の策謀, ARG
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
CFLAG:ARG:입력행동 = 0
CFLAG:ARG:타겟 = -1
IF CFLAG:ARG:１more플래그 > 0
	CFLAG:ARG:입력행동 = 0
ELSE
	;アーシェラが異常になっていたらアムリタ
	IF !IS_BADSTATE(GET_ENEMY("アーシェラ"), "GOOD") && !IS_BADSTATE(GET_ENEMY("アーシェラ"), "DYING")
		CFLAG:ARG:입력행동 = [[스킬:암리타]]
	ELSE
		;カジャの効果をランダムで2回チェックしてデカジャ判定を行う
		FOR LCOUNT, 0, 2
			L_CHARA = POS(RAND(1, 7))
			SIF !IS_TARGET_ABLE(L_CHARA)
				CONTINUE
			SIF GET_カジャンダ_MAX(ARG) < 16
				CONTINUE
			CFLAG:ARG:입력행동 = [[스킬:데・카쟈]]
			BREAK
		NEXT
		IF CFLAG:ARG:입력행동 == 0
			;ランダムな敵一体の壁をチェック(空きポジションが増えると使ってくる可能性が減る)
			L_CHARA = POS(RAND(7, 17))
			IF IS_TARGET_ABLE(L_CHARA)
				IF CFLAG:L_CHARA:전격무효화횟수 == 0
					CFLAG:ARG:입력행동 = [[스킬:대지의벽]]
					BREAK
				ELSEIF CFLAG:L_CHARA:수호의방패 == 0
					CFLAG:ARG:입력행동 = [[스킬:수호의방패]]
					BREAK
				ENDIF
			ENDIF
			;ここまでに決まってなかったらアーシェラ支援
			IF CFLAG:ARG:입력행동 == 0
				CFLAG:ARG:타겟 = CPOS(GET_ENEMY("アーシェラ"))
				IF RAND:2 && 現HP割合(GET_ENEMY("アーシェラ")) < 100
					CFLAG:ARG:입력행동 = [[스킬:디아라마]]
				ELSE
					CFLAG:ARG:입력행동 = [[스킬:히트라이저]]
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
SIF CFLAG:ARG:타겟 == -1 || CFLAG:ARG:입력행동 == 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동

;マシン2種は一発うったら気合からの自爆の固定パターン
@SET_ACTION_T95メデューサ_聖域の策謀, ARG
IF CFLAG:ARG:800++ == 0
	CFLAG:ARG:입력행동 = [[스킬:산탄사격]]
