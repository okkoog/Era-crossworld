;=======================================================================
;
;하얀칼날의후계자
;
;=======================================================================
;ターン冒頭で一閃以外の5人に行動パターン番号を渡しておくことで攻撃の頻度を調整する。
;0 = 範囲攻撃
;1, 3 = 補助1
;2, 4 = 単体攻撃
;4 = 単体攻撃
@EVENT_BATTLE_TURNTOP_白き刃の後継者
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC L_ENEMY_TABLE = "綾女", "ヘルマン", "御夜子", "夢子", "瑞岐"
CALL SHUFFLE_ARRAY_STR, L_ENEMY_TABLE
FOR LCOUNT, 0, 5
	SIF !IS_TARGET_ABLE(GET_ENEMY(L_ENEMY_TABLE:LCOUNT))
		CONTINUE
	CFLAG:GET_ENEMY(L_ENEMY_TABLE:LCOUNT):800 = LCOUNT
NEXT
;=======================================================================
;気合・会心の覇気と攻撃の交互
;ただしどちらでも通常攻撃が挟まる可能性がある。
;=======================================================================
@SET_ACTION_一閃_白き刃の後継者, ARG
IF CFLAG:ARG:１more플래그 > 0
	CFLAG:ARG:입력행동 = [[스킬:일문자베기]]
ELSE
	IF !CFLAG:ARG:気合フラグ && !CFLAG:ARG:회심의패기플래그
		SELECTCASE RAND:3
			CASE 0
				CFLAG:ARG:입력행동 = 0
			CASE 1
				CFLAG:ARG:입력행동 = [[스킬:기합]]
			CASE 2
				CFLAG:ARG:입력행동 = [[스킬:회심의패기]]
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CFLAG:ARG:입력행동 = 0
			CASE 1
				CFLAG:ARG:입력행동 = [[스킬:일문자베기]]
			CASE 2
				CFLAG:ARG:입력행동 = [[스킬:안개베기]]
		ENDSELECT
	ENDIF
ENDIF
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동

@SET_ACTION_綾女_白き刃の後継者, ARG
