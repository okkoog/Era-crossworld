;====================
;関連フラグリスト
;====================
;依頼フラグ:[[依頼:하얀칼날의후계자]]:0 進行状況
;====================
;条件
;====================
@GET_REQUEST_NAME_36
#FUNCTIONS
RESULTS_F '= "白き刃の後継者"
RETURNF RESULTS_F

@PLAYABLE_REQUEST_36
SIF 依頼フラグ:[[依頼:하얀칼날의후계자]]:1 == DAY + 1
	RETURN 0
SELECTCASE 依頼フラグ:[[依頼:하얀칼날의후계자]]:0
	CASE 0
		IF IS_CLEARED_FIRST_DUNGENON()
			RESULTS = 하얀 칼날의 후계자
			RETURN 1
		ENDIF
	CASE 1
		IF BASE:MASTER:LV >= 25
			RESULTS = 무구한 요람의 용
			RETURN 1
		ENDIF
	CASE 2
		IF BASE:MASTER:LV >= 35
			RESULTS = 성역의 책모
			RETURN 1
		ENDIF
	CASEELSE
		RETURN 0
ENDSELECT


;====================
;説明
;====================
@EXPLAIN_REQUEST_36
CALLFORM EXPLAIN_REQUEST_36_{依頼フラグ:[[依頼:하얀칼날의후계자]]:0}
;====================
;内容
;====================
@REQUEST_36
CALLFORM REQUEST_36_{依頼フラグ:[[依頼:하얀칼날의후계자]]:0}
依頼フラグ:[[依頼:하얀칼날의후계자]]:1 = DAY + 1
CALL RESET_ANNOUNCE_FLAG
