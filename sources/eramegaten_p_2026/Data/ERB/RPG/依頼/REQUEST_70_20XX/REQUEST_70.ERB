;====================
;関連フラグリスト
;====================
;依頼フラグ:[[依頼:20XX의뢰]]:0 進行度フラグ 0:開始 1:アイン捕獲 2:第一研究所潜入済み 3:第二研究所潜入済み 4:ファントムにアインの所有を認められた 5:アインを拉致された 6:アインの居場所が分かった
;							  7:アインを救出した 8:ルート決定 9:ルートクリア
;							  99:アイン殺害or実験台(=ルート終了)
;依頼フラグ:[[依頼:20XX의뢰]]:1 ガイア教施設調査でアインを連れてきたか 0:連れてきた 1:連れてこなかった
;依頼フラグ:[[依頼:20XX의뢰]]:2 ガイア教施設調査(2)でアインを連れてきたか 0:連れてきた 1:連れてこなかった
;依頼フラグ:[[依頼:20XX의뢰]]:3 最終ルート 1:LAW 2:NEWTRAL 3:CHAOS
;依頼フラグ:[[依頼:20XX의뢰]]:4 日数記録用
;====================
;条件
;====================


@GET_REQUEST_NAME_70
#FUNCTIONS
RESULTS_F '= "20XX依頼"
RETURNF RESULTS_F

@PLAYABLE_REQUEST_70
IF 依頼フラグ:[[依頼:20XX의뢰]]:4 == DAY
	RETURN 0
ELSEIF FLAG:명성 >= 500 && 依頼フラグ:[[依頼:20XX의뢰]]:0 == 0
	RESULTS = 실험체 포획 의뢰
	RETURN 1
;アインが出撃不能な状態を除く
ELSEIF (GETCHARA([[キャラ:아인]]) > 0 && GET_VALUE_TALENT_JOINABLE(GETCHARA([[キャラ:아인]])) > 0) == 0
	RETURN 0
	
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 1 && BASE:MASTER:LV > 29
	RESULTS = 가이아교 시설 조사
	RETURN 1
	
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 2
	RESULTS = 돌입 가이아 교회
	RETURN 1

ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 3 && BASE:MASTER:LV > 44
	RESULTS = 키메라 프로젝트
	RETURN 1
	
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 4
	RESULTS = 템플나이트 내습
	RETURN 1

ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 5
	RESULTS = 수용소 조사 결과 보고
	RETURN 1
	
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 7
	RESULTS = 결단의 때
	RETURN 1
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 8 && 依頼フラグ:[[依頼:20XX의뢰]]:3 == 1
	RESULTS = 신의 나라의 문은 항상 열려있다
	RETURN 1
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 8 && 依頼フラグ:[[依頼:20XX의뢰]]:3 == 2
	RESULTS = 나는 나의 길을 간다
	RETURN 1
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 8 && 依頼フラグ:[[依頼:20XX의뢰]]:3 == 3
	RESULTS = 위대한 대마왕 루시퍼 님께 맹세코
	RETURN 1
ELSE
	RETURN 0
ENDIF

@EXPLAIN_REQUEST_70
IF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 0
	CALL EXPLAIN_REQUEST_70_1
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 1
	CALL EXPLAIN_REQUEST_70_2
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 2
	CALL EXPLAIN_REQUEST_70_3
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 3
	CALL EXPLAIN_REQUEST_70_4
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 4
	CALL EXPLAIN_REQUEST_70_5
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 5
	CALL EXPLAIN_REQUEST_70_6
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 7
	CALL EXPLAIN_REQUEST_70_7
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 8
	CALL EXPLAIN_REQUEST_70_8
ENDIF

@REQUEST_70
IF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 0
	CALL REQUEST_70_1
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 1
	CALL REQUEST_70_2
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 2
	CALL REQUEST_70_3
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 3
	CALL REQUEST_70_4
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 4
	CALL REQUEST_70_5
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 5
	CALL REQUEST_70_6
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 7
	CALL REQUEST_70_7
ELSEIF 依頼フラグ:[[依頼:20XX의뢰]]:0 == 8
	CALL REQUEST_70_8
ENDIF
CALL RESET_ANNOUNCE_FLAG

