;====================
;関連フラグリスト
;====================
;====================
;条件
;====================
@GET_REQUEST_NAME_12
#FUNCTIONS
RESULTS_F '= "デビルチルドレン"
RETURNF RESULTS_F

@PLAYABLE_REQUEST_12
;漫画版ルートだったら弾く（排他）
SIF ダンジョンフラグ:61:1 == 3
	RETURN 0

SELECTCASE 依頼フラグ:[[依頼:데빌칠드런]]:0
	CASE 0
		IF ダンジョンフラグ:61:0 == 5
			RESULTS = 반란군으로부터의 사자
			RETURN 1
		ENDIF
	CASE 1
		IF ダンジョンフラグ:63:0 == 8
			RESULTS = 대마왕의 딸
			RETURN 1
		ENDIF
	CASE 2
		IF イベントフラグ:25:0 == 1
			RESULTS = 천계로부터의 침략
			RETURN 1
		ENDIF
ENDSELECT
RETURN 0

@EXPLAIN_REQUEST_12
SELECTCASE 依頼フラグ:[[依頼:데빌칠드런]]:0
	CASE 0
		CALL EXPLAIN_REQUEST_12_1
	CASE 1
		CALL EXPLAIN_REQUEST_12_2
	CASE 2
		CALL EXPLAIN_REQUEST_12_3
ENDSELECT

@REQUEST_12
SELECTCASE 依頼フラグ:[[依頼:데빌칠드런]]:0
	CASE 0
		CALL REQUEST_12_1
	CASE 1
		CALL REQUEST_12_2
	CASE 2
		CALL REQUEST_12_3
ENDSELECT
;ARG＝番号、ARG:1＝0：ダンジョン、1：闘技場、2：イベント、3：依頼
CALL RESET_ANNOUNCE_FLAG