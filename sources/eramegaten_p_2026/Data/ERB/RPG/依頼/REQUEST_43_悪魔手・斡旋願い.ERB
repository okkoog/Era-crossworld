;=================================================
;●イージーモード支援依頼
;　キャラを中々売れない初心者のため、「キャラを売ればマッカが手に入るよ」と知らせる
;　今回は特別に未調教でもいいけどな！って。
;　報酬は、イージーモード用に「하쿠타로우」などのインストールソフト。
;　ぶっちゃけて言えば「長期的に見ればまったく割に合わない」依頼とする。
;　単発依頼でもいいっちゃいいけど、初心者支援なので「独立して、見やすい感じのやつ」にする
;　……しかしなんで依頼主、全書召喚しないんだろうな……？
;
;-------------------------------------------------
;●ハンドアウト
;　あなたのもとにメールが届く。
;　緊急で人材を融通してほしいとのことだ。
;　未調教でもいいらしいが、レベルは「一定以上」は欲しいとのことだ。
;　さて、戦力に余裕はあっただろうか……
;-------------------------------------------------
;●報酬
;　1.多少のマッカ
;　2.インストールソフト数種orスキルカード
;　　2-1.하쿠타로우
;　　2-2.アルバート、DDM
;　　2-3.Hi-DAS、ギボ・アイズ
;　　2-4.ダークスキャナー、ゲートキーパー
;　　2-5.低級のスキルカード
;　　　Lv10：アギジオザンブフ、ディア
;　　　Lv15/20：アクアグライマグナガルフレイ
;　　　Lv30：カジャ5種種詰め合わせ+솔빙오브
;　3.依頼完走時、少々の名声
;-------------------------------------------------
;●フラグ
;依頼フラグ:[[依頼:악마의손・중개요청]]:0
;　必要な悪魔※人間でもいい※のレベル。
;　これが31以上になると（要求悪魔レベルが31を超えると）発生しなくなる。
;依頼フラグ:[[依頼:악마의손・중개요청]]:1
;　売却回数フラグ。
;　このフラグ×戦闘難易度に応じた数値により、斡旋対象のレベルが決定される。
;依頼フラグ:[[依頼:악마의손・중개요청]]:2
;　その回の依頼を見たかのフラグ。
;　0なら見ていない、1なら見ている。
;依頼フラグ:[[依頼:악마의손・중개요청]]:3
;　売却対象。
;依頼フラグ:[[依頼:악마의손・중개요청]]:4
;　前回奴隷を渡した日。2回目以後のイベントは即日発生はしない。
;-------------------------------------------------


;====================
;条件
;====================
@GET_REQUEST_NAME_43
#FUNCTIONS
RESULTS_F '= "悪魔手・斡旋願い"
RETURNF RESULTS_F

@PLAYABLE_REQUEST_43

	;イージーは3日目から
	SIF DAY < 1 && FLAG:전투난이도 == 1
		RETURN 0

	;ノーマルは7日目から
	;SIF DAY < 7 && FLAG:전투난이도 == 2
	;	RETURN 0

	;依頼を受けてから数日経たないと次のイベントは発生しない
	SIF DAY < ((依頼フラグ:[[依頼:악마의손・중개요청]]:4) + (FLAG:전투난이도))
		RETURN 0

	;おまじない
	依頼フラグ:[[依頼:악마의손・중개요청]]:0 = 999

	;戦闘難易度、周回フラグに応じて発生回数が変動
	;初周回だと低レベルで発生
	IF FLAG:주회횟수 == 0
		;イージーでは10.20.30の3回発生
		SIF FLAG:전투난이도 == 1
			依頼フラグ:[[依頼:악마의손・중개요청]]:0 = 10
		;ノーマルでは15.30の2回
		;SIF FLAG:전투난이도 == 2
		;	依頼フラグ:[[依頼:악마의손・중개요청]]:0 = 15
	ELSE
		;イージーでは15.30の2回発生
		SIF FLAG:전투난이도 == 1
			依頼フラグ:[[依頼:악마의손・중개요청]]:0 = 15
		;ノーマルでは30の1回
		;SIF FLAG:전투난이도 == 2
		;	依頼フラグ:[[依頼:악마의손・중개요청]]:0 = 30
	ENDIF
	;それ以上だと発生しない
	SIF FLAG:전투난이도 >= 2
		RETURN 0

	;フラグ1は売却回数
	依頼フラグ:[[依頼:악마의손・중개요청]]:0 = 依頼フラグ:[[依頼:악마의손・중개요청]]:0 * ((依頼フラグ:[[依頼:악마의손・중개요청]]:1) + 1)
	
	
	;結果が30を越えたら終了
	SIF 依頼フラグ:[[依頼:악마의손・중개요청]]:0 >= 31
		RETURN 0

	;マスターのレベルが結果レベル必要
	SIF BASE:MASTER:LV < 依頼フラグ:[[依頼:악마의손・중개요청]]:0
		RETURN 0

	;条件ぜんぶ越えたら発生
	RESULTS = 악마의손・중개요청
	RETURN 1

