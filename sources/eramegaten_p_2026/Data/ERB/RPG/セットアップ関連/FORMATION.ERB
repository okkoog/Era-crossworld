@GET_VALUE_TALENT_JOINABLE, L_CHARA
#FUNCTION
#DIM DYNAMIC L_CHARA
SIF TALENT:L_CHARA:반발
	RETURNF 0
SIF TALENT:L_CHARA:반역
	RETURNF 0
SIF TALENT:L_CHARA:신용
	RETURNF 1
RETURNF 2

@SET_TALENT_PARTY_JOINABLE, L_CHARA, ARGS
#DIM DYNAMIC L_CHARA
SELECTCASE ARGS
	CASE "参加不可能"
		TALENT:L_CHARA:신용 = 0
		TALENT:L_CHARA:반발 = 1
	CASE "参加可能"
		TALENT:L_CHARA:신용 = 0
		TALENT:L_CHARA:반발 = 0
		TALENT:L_CHARA:반역 = 0
	CASE "信用", "신용"
		TALENT:L_CHARA:신용 = 1
		TALENT:L_CHARA:반발 = 0
	CASE "反逆", "반역"
		TALENT:L_CHARA:신용 = 0
		TALENT:L_CHARA:반발 = 0
		TALENT:L_CHARA:반역 = 1
	CASEELSE
		THROW 引き数の指定ミス
ENDSELECT

;========================================================================
;ポジションキャラ側から読み込み
;合体、売却等でキャラが消滅する際にポジションを読み込みし直す処理
;========================================================================
@REFRESH_POS
FOR LOCAL,1,17
	LOCALS = 포지션{LOCAL}
	FLAG:LOCALS = -1
NEXT

FOR LOCAL,0,CHARANUM
	SIF CFLAG:LOCAL:PT플래그 == 2
		CFLAG:LOCAL:PT플래그 = 1
	IF CFLAG:LOCAL:포지션 > 0
		;ステータス同期をせずに入れなおす
		CALL INSERT_POSITION,CFLAG:LOCAL:포지션,LOCAL, 1
	ENDIF
NEXT

;ステータス同期
CALL SET_LEADER_SKILL
;リーダースキルの変更があった場合は@SET_LEADER_SKILL内でSYNCするようになっているため、ここでのSYNCはコメントアウト
;FOR LOCAL, 1, 17
;	SIF POS(LOCAL) < 0
;		CONTINUE
;	CALL SYNC_STATUS, POS(LOCAL), "HPMP割合保持"
;NEXT

;----------------------------------
;指定PT作成関数
;イベントで特定PTで戦闘させたいという時に
;
;MASTER抜きPTを作る場合はイベント終了後にMASTERを加入させたPTをつくってください
;サバトマやCOMPを抑制する仕様はないので別で制御してください
;また、陥落しているメンバーがいないPTを作った場合はエラー落ちするので注意してください
;
;ARG:0 ~ ARG:5 	PTメンバーに指定するキャラクターのNO、基本的には[[キャラ:XXXX]]で指定してください
;ARGS			欠員許容を指定した場合、指定メンバーの一部がいない場合でもPT作成を完了できます
;				逆に非許容のままPTメンバーが足りない場合はエラー落ちするのでこの関数に到達するまでの条件を見直してください
;----------------------------------
@MAKE_SELECTED_PT, ARG = -1, ARG:1 = -1, ARG:2 = -1, ARG:3 = -1, ARG:4 = 1, ARG:5 = -1, ARGS = "欠員非許容"
#DIM LCOUNT
#DIM CHARA
#DIM IS_ABLE
FOR LCOUNT, 1, 7
	SIF POS(LCOUNT) < 0
		CONTINUE
	CALL REMOVE_POSITION, LCOUNT
NEXT
;PT作成
FOR LCOUNT, 0, 6
	SIF ARG:LCOUNT == -1
		CONTINUE
	CHARA = GETCHARA(ARG:LCOUNT)
	;PTの参加可否
	;PTの参加可否
	IS_ABLE = 1	
	IF CHARA >= 0
		SIF CFLAG:CHARA:PT플래그 != 1 && CFLAG:CHARA:PT플래그 != 2
			IS_ABLE = 0
		SIF GET_VALUE_TALENT_JOINABLE(CHARA) == 0
			IS_ABLE = 0
		SIF TALENT:CHARA:전력상실 > 0
			IS_ABLE = 0
		SIF IS_RENTING(CHARA)
			IS_ABLE = 0
		SIF TALENT:CHARA:비전투원
			IS_ABLE = 0
	ELSE
		IS_ABLE = 0
	ENDIF
	;欠員を許容しない場合はメンバー不足のときにエラー落ちで警告する
	IF !IS_ABLE
		IF ARGS != "欠員許容"
			A = -1
			IF CHARA == -1
				PRINTFORMW %CSVNAME(ARG:LCOUNT)%의 GETCHARA를 할 수 없습니다!
			ELSE
				PRINTFORMW %CSVNAME(ARG:LCOUNT)%이(가) PT에 들어갈 수 없는 상태입니다!
			ENDIF
			TSTR:A = この関数に到達するまでの条件を見直してください
		ELSE
			CONTINUE
		ENDIF
	ENDIF
	CALL INSERT_POSITION, LCOUNT+1, CHARA
NEXT
;ゲームオーバーチェック
FOR LCOUNT, 1, 7
	CHARA = POS(LCOUNT)
	SIF CHARA < 0
		CONTINUE
	SIF MASTER == CHARA
		RETURN 1
	SIF 陥落(CHARA)
		RETURN 1
NEXT
A=-1
PRINTL 배치 완료 PT
FOR LCOUNT, 1, 7
	CHARA = POS(LCOUNT)
	IF CHARA < 0
		PRINTFORML [{LCOUNT}] EMPTY
	ELSE
		PRINTFORML [{LCOUNT}] %CALLNAME:CHARA%
	ENDIF
NEXT
TSTR:A = このままのPTで戦闘させるとゲームオーバーしてしまいます！条件を見直してください！

;----------------------------------
;指定PT作成条件確認関数
;上記のPT作成関数を通るPTをつくれるかどうかを確認する
;
;戻り値	1 = 作成可能　0 = 作成不能　またRESULTSに作成ができない理由を格納
;----------------------------------
@CHECK_CAN_MAKE_SELECTED_PT, ARG = -1, ARG:1 = -1, ARG:2 = -1, ARG:3 = -1, ARG:4 = 1, ARG:5 = -1, ARGS = "欠員非許容"
#FUNCTION
#DIM LCOUNT
#DIM CHARA
#DIM IS_ABLE
;メンバー存在 & PT参加可否チェック
FOR LCOUNT, 0, 6
	SIF ARG:LCOUNT == -1
		CONTINUE
	CHARA = GETCHARA(ARG:LCOUNT)
	;PTの参加可否
	IS_ABLE = 1	
	IF CHARA >= 0
		SIF CFLAG:CHARA:PT플래그 != 1 && CFLAG:CHARA:PT플래그 != 2
			IS_ABLE = 0
		SIF GET_VALUE_TALENT_JOINABLE(CHARA) == 0
			IS_ABLE = 0
		SIF TALENT:CHARA:전력상실 > 0
			IS_ABLE = 0
		SIF IS_RENTING(CHARA)
			IS_ABLE = 0
		SIF TALENT:CHARA:비전투원
			IS_ABLE = 0
	ELSE
		IS_ABLE = 0
	ENDIF
	;欠員を許容しない場合はメンバー不足を通さない
	IF !IS_ABLE
		IF ARGS != "欠員許容"
			IF CHARA < 0
				RESULTS = %CSVNAME(ARG:LCOUNT)%이(가) 존재하지 않음
			ELSE
				RESULTS = %CSVNAME(ARG:LCOUNT)%이(가) PT에 참가 불가능
			ENDIF
			RETURNF 0
		ELSE
			CONTINUE
		ENDIF
	ENDIF
NEXT
;ゲームオーバーチェック
FOR LCOUNT, 1, 7
	CHARA = POS(LCOUNT)
	SIF CHARA < 0
		CONTINUE
	SIF MASTER == CHARA
		RETURNF 1
	SIF 陥落(CHARA)
		RETURNF 1
NEXT
RESULTS = 게임 오버 체크아웃
RETURNF 0

