SHOW_LINE += "<br>"
VARI CNT_LINE
FOR LCOUNT:1, ARG:1-1, ARG-1,-1
	FOR LCOUNT, 0, 5
		L_POS = LCOUNT + LCOUNT:1 * 5 + 7
		L_ENEMY = POS(L_POS)
		CALL MAKE_STR_SHOW_FORMATION_CHARA_E, L_ENEMY, L_POS, L_SITUATION, L_TYPE, L_ACTOR, L_SKILL
		L_WIDTH = RESULT
		L_HEIGHT = RESULT:1
		SHOW_LINE += @"<div xpos = '{200 + LCOUNT * (L_WIDTH + 100)}' ypos = '{CNT_LINE * L_HEIGHT}'>"  + RESULTS + "</div>"
	NEXT
	CNT_LINE++
NEXT
HTML_PRINT SHOW_LINE
FOR LCOUNT, 0, LINENUM - 1
	PRINTL 
NEXT
PRINTSL GETLINESTR("=")
RETURN 0

;==================================
;前詰め/死亡チェック
;==================================
@REFRESH_FORMATION
#DIM LCOUNT
#DIM L_FRONT
#DIM L_BACK
;---- EDIT 049 ADD START -------------------------
;場から除外されるキャラがいないか先にチェック
FOR LCOUNT, 1, 17
	SIF POS(LCOUNT) < 0
		CONTINUE
	SIF !IS_BADSTATE(POS(LCOUNT), "DYING")
		CONTINUE
	IF CFLAG:POS(LCOUNT):PT플래그 > 0
		CONTINUE
	ELSE
		SIF CFLAG:POS(LCOUNT):시체잔존 > 0
			CONTINUE
	ENDIF
	CALL REMOVE_POSITION, LCOUNT
NEXT
;---- EDIT 049 ADD END ---------------------------
;前衛が空いているのに後衛がいるポジションがないか調べる
FOR LCOUNT,1,4
	L_FRONT = POS(LCOUNT)
	L_BACK = POS(LCOUNT+3)
	IF L_FRONT == -1
		SIF L_BACK > -1
			CALL INSERT_POSITION,LCOUNT,L_BACK
	ELSEIF GET_STATE(CFLAG:(L_FRONT):상태이상) == "DYING"
		SIF L_BACK > -1 && GET_STATE(CFLAG:(L_BACK):상태이상) != "DYING"
			CALL CHANGE_POSITION,L_FRONT,L_BACK
	ENDIF
NEXT
FOR LCOUNT,7,12
	L_FRONT = POS(LCOUNT)
	L_BACK = POS(LCOUNT+5)
	IF L_FRONT == -1
		SIF L_BACK > -1
			CALL INSERT_POSITION,LCOUNT,L_BACK
	ELSEIF GET_STATE(CFLAG:(L_FRONT):상태이상) == "DYING"
		SIF L_BACK > -1 && GET_STATE(CFLAG:(L_BACK):상태이상) != "DYING"
			CALL CHANGE_POSITION,L_FRONT,L_BACK
	ENDIF
NEXT

;==============================================
;ポジション入れ替え
;==============================================
@CHANGE_POSITION,ARG,ARG:1
	LOCALS = 포지션{CFLAG:(ARG:0):포지션}
	LOCALS:1 = 포지션{CFLAG:(ARG:1):포지션}
	SWAP FLAG:LOCALS,FLAG:(LOCALS:1)
	SWAP CFLAG:(ARG:0):포지션,CFLAG:(ARG:1):포지션

;==============================================
;ポジション入れ替え2式
;==============================================
@CHANGE_POS,ARG,ARG:1
	LOCALS = 포지션{ARG}
	LOCALS:1 = 포지션{ARG:1}
	SIF FLAG:LOCALS > -1
		CFLAG:(FLAG:LOCALS):포지션 = ARG:1
	SIF FLAG:(LOCALS:1) > -1
		CFLAG:(FLAG:(LOCALS:1)):포지션 = ARG
	CALL REFRESH_POS
;		SWAP FLAG:LOCALS,FLAG:(LOCALS:1)

;==================================
;ポジションに挿入
;==================================
@INSERT_POSITION, ARG = -1, ARG:1, NOT_SYNC
#DIM DYNAMIC SWITCHING_CHARA = -1
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC NOT_SYNC
IF ARG == -1
	SIF CPOS(ARG:1) > 0
		RETURN 0
	FOR LCOUNT, 6, 0, -1
		SIF POS(LCOUNT) >= 0
			CONTINUE
		ARG = LCOUNT
		BREAK
	NEXT
	SIF ARG == -1
		THROW 空きポジションがない状態でキャラを挿入しようとしています！
ENDIF
LOCALS = 포지션{ARG}
IF CFLAG:(ARG:1):PT플래그 > 0
	SIF ARG < 4
		LOCALS:1 = 포지션{ARG+3}
ELSE
	SIF ARG < 12
		LOCALS:1 = 포지션{ARG+5}
ENDIF
IF FLAG:LOCALS > -1
	;後ろが空いてるならずれてもらう
	IF ((CFLAG:(ARG:1):PT플래그 && ARG < 4) || (CFLAG:(ARG:1):PT플래그 == 0 && ARG < 12)) && FLAG:(LOCALS:1) == -1
		CFLAG:(FLAG:LOCALS):포지션 = ARG+3+!CFLAG:(FLAG:LOCALS):PT플래그*2
		FLAG:(LOCALS:1) = FLAG:LOCALS
		;PRINTFORML {ARG}に%CALLNAME:(ARG:1)%を配置します
		FLAG:LOCALS = ARG:1
		;PRINTFORML %CALLNAME:(ARG:1)%のポジションを{ARG}に書き換えます。
		CFLAG:(ARG:1):포지션 = ARG
		SIF CFLAG:(ARG:1):PT플래그
			CFLAG:(ARG:1):PT플래그 = 2
	;空いておらず、そこに居るのが主人なら交代不可
	ELSEIF (FLAG:LOCALS) == MASTER
		PRINTW 교체할 수 없습니다
		RETURN -1, -1
	;交代
	ELSEIF GET_ROLE_PROP("CAN_PUT_IN_COMP", FLAG:LOCALS) && CFLAG:(FLAG:LOCALS):소속ＣＯＭＰ == 0
		SWITCHING_CHARA = FLAG:LOCALS
		CALL REMOVE_POSITION,ARG
		;PRINTFORML {ARG}に%CALLNAME:(ARG:1)%を配置します
		FLAG:LOCALS = ARG:1
		;PRINTFORML %CALLNAME:(ARG:1)%のポジションを{ARG}に書き換えます。
		CFLAG:(ARG:1):포지션 = ARG
		SIF CFLAG:(ARG:1):PT플래그
			CFLAG:(ARG:1):PT플래그 = 2
	;そこに居るのが主人以外かつ探索or戦闘中でなければ交代
	ELSEIF (FLAG:LOCALS) != MASTER && FLAG:SHOP커맨드 == [[ショップ:셋업]]
		SWITCHING_CHARA = FLAG:LOCALS
		CALL REMOVE_POSITION,ARG
		;PRINTFORML {ARG}に%CALLNAME:(ARG:1)%を配置します
		FLAG:LOCALS = ARG:1
		;PRINTFORML %CALLNAME:(ARG:1)%のポジションを{ARG}に書き換えます。
		CFLAG:(ARG:1):포지션 = ARG
		SIF CFLAG:(ARG:1):PT플래그
			CFLAG:(ARG:1):PT플래그 = 2
	ELSE
	;どれかに引っかからなかったら交代できない
		PRINTW 교체할 수 없습니다
		RETURN -1, -1
	ENDIF
ELSE
	IF CFLAG:(ARG:1):포지션
		LOCALS:2 = 포지션{CFLAG:(ARG:1):포지션}
		FLAG:(LOCALS:2) = -1
	ENDIF
	;PRINTFORML {ARG}に%CALLNAME:(ARG:1)%を配置します
	FLAG:LOCALS = ARG:1
	;PRINTFORML %CALLNAME:(ARG:1)%のポジションを{ARG}に書き換えます。
	CFLAG:(ARG:1):포지션 = ARG
	SIF CFLAG:(ARG:1):PT플래그
		CFLAG:(ARG:1):PT플래그 = 2
ENDIF
SIF !NOT_SYNC
	CALL SYNC_STATUS, ARG:1, "HPMP割合保持"
RETURN 1, SWITCHING_CHARA

