	;色リスト表示１行目
	COLOR_LIST += @"<font color = '%TOSTR_HTML(COLOR("약점컬러"))%'>■</font>%"WEAK", 7, LEFT%" + " " * 8
	COLOR_LIST += "<br>" + @"<font color = '%TOSTR_HTML(COLOR("통상컬러"))%'>■</font>%"NORMAL", 7, LEFT%" + " " * 8
	COLOR_LIST += "<br>" + @"<font color = '%TOSTR_HTML(COLOR("내성컬러"))%'>■</font>%"RESIST", 7, LEFT%" + " " * 8
	COLOR_LIST += "<br>" + @"<font color = '%TOSTR_HTML(COLOR("무효컬러"))%'>■</font>%"BLOCK", 7, LEFT%" + " " * 8
	COLOR_LIST += "<br>" + @"<font color = '%TOSTR_HTML(COLOR("흡수컬러"))%'>■</font>%"ABSORB", 7, LEFT%" + " " * 8
	COLOR_LIST += "<br>" + @"<font color = '%TOSTR_HTML(COLOR("반사컬러"))%'>■</font>%"REFLECT", 7, LEFT%" + " " * 8
	COLOR_LIST '= "<div xpos = '0' ypos = '0'>" + COLOR_LIST + "</div>"
	SHOW_LINE += COLOR_LIST
ENDIF
L_XPOS = 50 * 17
L_YPOS = 0

VARI L_ROW
VARI L_COLUMN
VARS CHARA_INFO
VARI L_XPOS_CHARA_INFO
VARI L_YPOS_CHARA_INFO
FOR L_ROW, 0, 2
	FOR L_COLUMN, 0, 3
		L_POS = L_ROW * 3 + L_COLUMN + 1
		IF SHOW_SET_PT_NO == -1
			L_CHARA = POS(L_POS)
		ELSE
			L_CHARA = POS_FOR_FORMATION_P(L_POS, SHOW_SET_PT_NO)
		ENDIF
		IF IMG_SIZE == "L"
			L_XPOS_CHARA_INFO = 1100 + 600
		ELSE
			L_XPOS_CHARA_INFO = 1100 + 400
		ENDIF
		L_XPOS_CHARA_INFO += 100
		L_XPOS_CHARA_INFO *= L_COLUMN
		IF IMG_SIZE == "L"
			L_YPOS_CHARA_INFO = 700 * L_ROW
		ELSE
			L_YPOS_CHARA_INFO = 500 * L_ROW
		ENDIF
		CALL MAKE_STR_SHOW_FORMATION_CHARA_P, L_CHARA, L_POS, ARG:2, IMG_SIZE, L_SITUATION, L_ACTOR, L_SKILL
		;CHARA_INFO += RESULTS
		CHARA_INFO += @"<div xpos = '{L_XPOS_CHARA_INFO}' ypos = '{L_YPOS_CHARA_INFO}'>" + RESULTS + "</div>"
	NEXT
NEXT
CHARA_INFO '= @"<div xpos = {L_XPOS} ypos = {L_YPOS}>" + CHARA_INFO + "<div>"
SHOW_LINE += CHARA_INFO
HTML_PRINT SHOW_LINE
FOR LCOUNT, 0, LINENUM - 1
	PRINTL 
NEXT
