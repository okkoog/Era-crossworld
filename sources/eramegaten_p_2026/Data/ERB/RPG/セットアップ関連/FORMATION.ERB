@CASTING_CHOOSE_COMPANION(ARG:0)
;---- EDIT 052 ADD START -------------------------
SIF FLAG:소환불능
	RETURN 0
;---- EDIT 052 ADD END ---------------------------
SIF CFLAG:(ARG:0):PT플래그 != 1
	RETURN 0
IF GROUPMATCH(FLAG:SHOP커맨드, [[ショップ:탐색]],[[ショップ:콜로세움참가]],[[ショップ:이벤트]],[[ショップ:의뢰청부]])
	SIF GET_VALUE_TALENT_JOINABLE((ARG:0)) == 0
		RETURN 0
ELSE
	SIF TALENT:(ARG:0):반역
		RETURN 0
ENDIF
SIF TALENT:(ARG:0):전력상실 > 0
	RETURN 0
SIF IS_RENTING(ARG:0)
	RETURN 0
SIF TALENT:(ARG:0):비전투원
	RETURN 0
SIF CFLAG:(ARG:0):이자리에없는플래그 == 1
	RETURN 0
SIF CFLAG:(ARG:0):피변신플래그
	RETURN 0
TRYCCALLFORM CASTING_CHOOSE_COMPANION_ROLE_%CSTR:(ARG:0):롤%, ARG
	SIF !RESULT
		RETURN 0
CATCH
ENDCATCH
TRYCCALLFORM CASTING_CHOOSE_COMPANION_CHARA_{NO:(ARG:0)}, ARG
	SIF !RESULT
		RETURN 0
CATCH
ENDCATCH
;探索・戦闘中に呼出
IF COUNT_SPLIT(CHOOSE_COMPANION_VAR, "/", "RPG")
	SIF GET_STATE(CFLAG:(ARG:0):상태이상) == "DYING"
		RETURN 0
	;---- EDIT 061 MOD START -------------------------
	SIF !GET_ROLE_PROP("CAN_PUT_IN_COMP", ARG)
		RETURN 0
	;SIF ABL:(ARG:0):종족 == 0
	;	RETURN 0
	;---- EDIT 061 MOD END ---------------------------
	;SIF CFLAG:(ARG:0):피변신플래그
	;	RETURN 0
	SIF CFLAG:(ARG:0):소속ＣＯＭＰ == -1
		RETURN 0
	;召喚攻撃からの呼出では死亡の他の攻撃不能な異常も見る
	IF COUNT_SPLIT(CHOOSE_COMPANION_VAR, "/", "召喚攻撃")
		CALL ACTIONABLE_CHARA, ARG:0
		SIF !RESULT
			RETURN 0
	ENDIF
ENDIF
;フィルタリングされてるキャラは除外
SIF CFLAG:(ARG:0):필터링플래그
	RETURN 0
RETURN 1
