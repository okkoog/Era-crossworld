	ENDIF
ELSE
	;---- EDIT P 001 MOD START -------------------------
	TEMP_SHOWLINE '= "ＰＡＲＴＹ"
	;---- EDIT P 003 MOD START -------------------------
	IF IS_USEABLE_MAGATSUHI_SKILL()
		TEMP_SHOWLINE += " " * 16
		FOR LCOUNT, 0, 2
			TEMP_SHOWLINE += " " * 19
