@SETUP_SUMMON, ARG = -1
#DIM DYNAMIC SELECT_POS
#DIM DYNAMIC SELECT_CHARA
IF ARG == -1
	PRINTL
	CALL SHOW_NOW_FORMATION_P,0,2,3
	PRINTC [1000] - 돌아간다
	PRINTL
	DRAWLINE
	PRINTL 어디에 배치할까？
	$INPUT_LOOP
	INPUT
	IF RESULT == 1000
		RETURN 0
	ELSEIF !(RESULT < 7 && 0 < RESULT)
		GOTO INPUT_LOOP
	ENDIF
	SELECT_POS = RESULT
ELSE
	SELECT_POS = ARG
ENDIF
$INPUT_LOOP2
CALL CHOOSE_COMPANION,"셋업"
SELECT_CHARA = RESULT
IF RESULT == 1000
	;---- EDIT 059 MOD START -------------------------
	IF ARG == -1
		RESTART
	ELSE
		RETURN 0
	ENDIF
	;---- EDIT 059 MOD END ---------------------------
ELSE
	;---- EDIT 007 ADD START -------------------------
	IF POS(SELECT_POS) > 0 && CFLAG:POS(SELECT_POS):소속ＣＯＭＰ == -1 && FLAG:SHOP커맨드 == [[ショップ:탐색]] && !(SELECT_POS < 4 && POS(SELECT_POS+3) == -1)
		PRINTFORML %CALLNAME:POS(SELECT_POS)%은(는) 자택 서버에 등록되어 있는 악마입니다
		PRINTL 던전 안에서는 자택 서버에 등록되어 있는 악마를 파티에서 제외할 수 없습니다
		PRINTW 다른 포지션을 선택하여 소환해 주십시오
		CLEARLINE 3
		GOTO INPUT_LOOP2
	ENDIF
	;---- EDIT 007 ADD END   -------------------------
	;LOCAL:2 = FLAG:SHOP커맨드
	;FLAG:SHOP커맨드 = [[ショップ:셋업]]
	CALL INSERT_POSITION,SELECT_POS,SELECT_CHARA
	;FLAG:SHOP커맨드 = LOCAL:2
	IF RESULT > -1
		SELECTCASE FLAG:SHOP커맨드
			CASE [[ショップ:탐색]],[[ショップ:콜로세움참가]],[[ショップ:이벤트]],[[ショップ:의뢰청부]]
				IF CFLAG:(SELECT_CHARA):PT플래그 > 0 && ABL:(SELECT_CHARA):종족 != 0
					CALL CONTROL_MAG, MASTER, -MAXBASE:(SELECT_CHARA):￥
				ENDIF
		ENDSELECT
	ENDIF
	SIF ARG == -1
		RESTART
ENDIF
CALL REFRESH_FORMATION
