;==================================
;ポジション変更
;==================================
@SETUP_FORMATION
#LOCALSIZE 2
#DIMS DYNAMIC SHOW_LINE
PRINTL
DRAWLINE
DRAWLINE
LOCAL:1 = LINECOUNT
PRINTL 포지션변경
$START
CLEARLINE LOCAL:1 - LINECOUNT
CALL SHOW_NOW_FORMATION_P, 0, 2, 3
DRAWLINE
PRINT 교체할 포지션을 선택해주세요(
PRINTBUTTON "[  0] - 돌아간다",0
PRINT 　
PRINTBUTTON "[  9] - 전체변경",9
PRINTL )
CALL INPUTINT(0, 1, 2, 3, 4, 5 ,6, 9)
SIF RESULT == 0
	RETURN 0
IF RESULT == 9
	CALL SETUP_FORMATIONS
	SIF RESULT
		RETURN 0
	GOTO START
ENDIF
LOCAL = RESULT
CLEARLINE LOCAL:1 - LINECOUNT
;---- EDIT 058 ADD START -------------------------
;---- EDIT P 002 MOD START -------------------------
VARI L_XPOS
L_XPOS = 17 * 50
L_XPOS += ((LOCAL - 1) % 3) * (GET_CHARALENS_FORMATION_P() + 2) * 50
VARI L_HEIGHT = FLAG:상성등표시ON > 0 ? 700 # 500
VARI L_YPOS = 300 + ((LOCAL -1) > 2 ? L_HEIGHT # 0)
VARI L_WIDTH
L_WIDTH = GET_CHARALENS_FORMATION_P() * 50
VARS L_BGCOLOR
L_BGCOLOR '= TOSTR_HTML(BGCOLOR("LIGHT-BLACK"))
HTML_PRINT @"<div xpos = '{L_XPOS}' ypos = '{L_YPOS}' height = '{L_HEIGHT}' width = '{L_WIDTH}' background_color = '%L_BGCOLOR%'>" + "</div>"

;SHOW_LINE = 
;SHOW_LINE += (FLAG:커스텀게임화면 && !FLAG:화상표시설정 ? 17 + 12 # 17) * " "
;SHOW_LINE += ((LOCAL -1) % 3) * GET_CHARALENS_FORMATION_P() * " "
;SHOW_LINE += @"<shape type ='rect' param = '0, {(LOCAL -1) > 2 ? 900 # 300}, {GET_CHARALENS_FORMATION_P() * 50}, {}' color = '%TOSTR_HTML(BGCOLOR("LIGHT-BLACK"))%'>"
;HTML_PRINT SHOW_LINE
;---- EDIT 058 ADD END ---------------------------
;---- EDIT P 002 MOD END ---------------------------
CALL SHOW_NOW_FORMATION_P,0,2, 3
DRAWLINE
PRINTFORM [ {LOCAL}]와 교체할 포지션을 선택해주세요 (
PRINTBUTTON "[  0] - 취소",0
PRINTL )
CALL INPUTINT(0, 1, 2, 3, 4, 5 ,6)
SIF RANGE(RESULT, 1, 6)
	CALL CHANGE_POS,LOCAL ,RESULT
GOTO START
@SETUP_FORMATIONS
#DIM LCOUNT
#LOCALSIZE 3
VARSET Q,-1
;PRINTL
;DRAWLINE
;DRAWLINE
CALL SHOW_NOW_FORMATION_P,0,2, 3
DRAWLINE
;PRINTL ポジションを変更します
VARSET Q,-1
LOCAL = 0
FOR LCOUNT, 0, CHARANUM
	SIF CFLAG:LCOUNT:PT플래그 != 2
		CONTINUE
	Q:LOCAL = LCOUNT
	;元のポジションを保存
	Q:(10+LOCAL) = CFLAG:LCOUNT:포지션
	LOCAL += 1
NEXT

FOR LCOUNT, 0, 6
	LOCALS = 포지션{LCOUNT+1}
	IF FLAG:LOCALS > -1
		;各ポジションの数値を保存
		Q:(20+LCOUNT) = FLAG:LOCALS
		
		CFLAG:(FLAG:LOCALS):포지션 = 0
		FLAG:(LOCALS) = -1
	ENDIF
NEXT
FOR LOCAL:2,0,LOCAL
	CALL SHOW_NOW_FORMATION_P,0,2, 3
	DRAWLINE
	PRINTFORM %CALLNAME:(Q:(LOCAL:2))%은(는) 어느 포지션？ (
	PRINTBUTTON "[  0] - 취소",0
	PRINT 　
	PRINTBUTTON "[  9] - 한 단계 뒤로",9
	PRINTL )
	$INPUT_LOOP
	INPUT
	LOCALS = 포지션{RESULT}
	;戻る
	IF RESULT == 9 && LOCAL:2 > 0
		LOCAL:2--
		CALL REMOVE_POSITION, Q:(LOCAL:2+30)
		FLAG:(LOCALS) = Q:(LOCAL:2 + 20)
		CFLAG:(Q:(LOCAL:2)):포지션 = 0
		LOCAL:2--
	ELSEIF RESULT == 0
		;キャンセル
		FOR LCOUNT, 0, 6
			IF Q:LCOUNT > -1
				CFLAG:(Q:LCOUNT):포지션 = Q:(10+LCOUNT)
			ENDIF
			
			LOCALS = 포지션{LCOUNT+1}
			FLAG:(LOCALS) = Q:(20+LCOUNT)
		NEXT
		RETURN 0
	ELSEIF RESULT < 1 || RESULT > 6 || FLAG:LOCALS > -1
		GOTO INPUT_LOOP
	ELSE
		Q:(LOCAL:2+30) = RESULT
		CALL INSERT_POSITION,RESULT,Q:(LOCAL:2)
	ENDIF
NEXT
CALL REFRESH_FORMATION
RETURN 1

;==================================
;メンバーを外す：選択
;==================================
@SETUP_REMOVE, FORCE_REMOVE_NUMBER, L_MES
#DIM DYNAMIC L_LINE
#DIMS DYNAMIC L_MES
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC FORCE_REMOVE_NUMBER
PRINTL
DRAWLINE
L_LINE = LINECOUNT
DO
	CLEARLINE LINECOUNT - L_LINE
	DRAWLINE
	CALL SHOW_NOW_FORMATION_P,0,2, 3
	DRAWLINE
	IF FORCE_REMOVE_NUMBER == 0
		PRINTC [0] 그만둔다
		PRINTL
	ELSE
		IF L_MES == ""
			HTML_PRINT @"동료를 가입시킬 수 있도록, 파티에 빈 자리를 만들어 주십시오."
		ELSE
			HTML_PRINT L_MES
		ENDIF
	ENDIF
	DRAWLINE
	PRINTL 누구를 되돌릴까？
	CALL INPUTINT, 0, 1, 2, 3, 4, 5, 6
	IF RESULT > 0
		L_CHARA = POS(RESULT)
		IF L_CHARA < 0
			CONTINUE
		ELSEIF CAN_REMOVE_POSITION(L_CHARA, FORCE_REMOVE_NUMBER == 0 ? -1 # 0)
			CALL REMOVE_POSITION,CPOS(L_CHARA)
		ELSE
			IF GET_ROLE_PROP("CAN_PUT_IN_COMP", L_CHARA) && CFLAG:L_CHARA:소속ＣＯＭＰ == -1
				PRINTW 던전 안에서는 자택 서버에 등록되어 있는 악마를 파티에서 제외할 수 없습니다
			ELSE
				PRINTFORMW %CALLNAME:L_CHARA%을(를) 파티에서 제외할 수는 없습니다
			ENDIF
			CONTINUE
		ENDIF
	ENDIF
LOOP CMATCH(CFLAG:0:PT플래그, 2) > (6 - FORCE_REMOVE_NUMBER)

;==================================
;メンバーを外す実行処理
;==================================
@REMOVE_POSITION,ARG
LOCALS = 포지션{ARG}
IF FLAG:(LOCALS) > -1
	CFLAG:(FLAG:LOCALS):포지션 = 0
	CFLAG:(FLAG:LOCALS):입력행동 = -1
