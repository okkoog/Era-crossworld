IF FLAG:월령 != 0 && FLAG:월령 != 8
	SHOW_LINE += TOALIGNMENT(@"현재의월령：{FLAG:월령}/8 \@ FLAG:월령벡터 == 0 ? ＹＯＵＮＧ # ＯＬＤ \@ ＭＯＯＮ", 100, "RIGHT")
ELSE
	SHOW_LINE += TOALIGNMENT(@"현재의월령：\@ FLAG:월령 == 8 ? ＦＵＬＬ ＭＯＯＮ # ＮＥＷ ＭＯＯＮ\@", 100, "RIGHT")
ENDIF
