CHOOSE_COMPANION_VAR '= ""
IF RESULT == 1000
	RETURN 1000
;ELSEIF RESULT == 1002 && ARG == 2 ;この1002がよく分からないからコメントアウト
;	RETURN 1002
ELSE
	IF GET_VALUE_TALENT_JOINABLE(RESULT) == 0
		PRINTFORMW %CALLNAME:RESULT%은(는) 전투 참가를 거부하고 있다.
		PRINTFORMW 「순종」 혹은 「욕망」 능력을 올려 【반발각인】을 소거해 주십시오.
		CLEARLINE 3
		GOTO START
	ELSE
		SELECTCASE FLAG:SHOP커맨드
			CASE [[ショップ:탐색]],[[ショップ:콜로세움참가]],[[ショップ:이벤트]],[[ショップ:의뢰청부]]
				;IF ABL:RESULT:종족 != 0 && GET_CHARA_STOCK_MAG(MASTER) < MAXBASE:RESULT:￥
				IF ABL:RESULT:종족 != 0 && GET_CHARA_STOCK_MAG(MASTER) < MAXBASE:RESULT:￥
					PRINTW MAG가 부족합니다
					CLEARLINE 2
					GOTO START
				ENDIF
		ENDSELECT
		RETURN RESULT
	ENDIF
ENDIF
