IF L_SITUATION == "BATTLE_MAIN" && (!NUM_SUMMONER(1) || !NUM_HAVESKILL([[스킬:하이・애널라이즈]]))
	;敵全ての情報がとれているか確認する
	VARI CAN_SHOW_ENEMY_TYPE_ALL = 1
	VARI L_ENEMY
	FOR LCOUNT:1,ARG:1-1,ARG-1,-1
		FOR LCOUNT, 0, 5
			L_POS = LCOUNT+LCOUNT:1*5+7
			L_ENEMY = POS(L_POS)
			SIF !IS_TARGET_ABLE(L_ENEMY)
				CONTINUE
			SIF CAN_SHOW_ENEMY_TYPE(L_ENEMY)
				CONTINUE
			SIF CFLAG:L_ENEMY:보스플래그
				CONTINUE
			CAN_SHOW_ENEMY_TYPE_ALL = 0
		NEXT
	NEXT
	TEMPS '= ""
	FOR LCOUNT, 0, LINENUM + 1
		SIF LCOUNT
			TEMPS += "<br>"
		TEMPS += "┃"
	NEXT
	SHOW_LINE += @"<div xpos = '7200' ypos = '0'>" + TEMPS + "</div>"
	VARS L_CAUTION
	L_CAUTION '= "ＣＡＵＴＩＯＮ" + "<br>"
	FOR LCOUNT:1, 0, TYPENUM / 2
		TEMPS '= ""
		FOR LCOUNT, 0, 2
			TEMP = LCOUNT:1 * 2 + LCOUNT
			TEMPS += SUBSTRING(GET_TYPE(TEMP), 0, 2)+":"
			IF ENEMY_HAVE_SKILL_ATK_TYPE:TEMP == 2
				TEMPS += "！"
				TEMPS '= SET_COLOR_TAG(TEMPS, "red")
			ELSE
				IF CAN_SHOW_ENEMY_TYPE_ALL
					TEMPS += "―"
				ELSE
					TEMPS += "？"
					TEMPS '= SET_COLOR_TAG(TEMPS, "light-gray")
				ENDIF
			ENDIF
			SIF !LCOUNT
				TEMPS += "　　"
		NEXT
		L_CAUTION += TEMPS + "<br>"
	NEXT
	L_CAUTION '= @"<div xpos = '7300' ypos = '0'>" + SET_BUTTON_TAG(L_CAUTION, , "アナライズ済みの敵が使用する可能性のある攻撃相性") + "</div>"
	SHOW_LINE += L_CAUTION
ENDIF
SHOW_LINE '= "<div xpos = '0' ypos = '0'>" + SHOW_LINE + "</div>"
;----------------------------------------------------
;LCOUNT:1 は列を制御。0 = 前列、1 = 後列
