;-------------------------------------------------
;編成セットのポジションから登録されているキャラ番号を取得する関数  
;-------------------------------------------------
; Input:
;  ARG:0				포지션
;  ARG:1				編成セット番号
;-------------------------------------------------
@POS_FOR_FORMATION_P, ARG, ARG:1
#FUNCTION
RETURNF FINDCHARA(CFLAG:0:실제가입시간, BATTLE_MEMBERSET:(ARG:1):ARG)
;---- EDIT 019 ADD END ---------------------------

;-------------------------------------------------
;現在のパーティを登録されている編成セットのものに入れ替える関数
;-------------------------------------------------
; Input:
;  ARG:0				編成セット番号
;-------------------------------------------------
@CHANGE_BATTLE_MEMBERSET, ARG
#DIM DYNAMIC L_POS
#DIM DYNAMIC L_CHARA
;---- EDIT 059 MOD START -------------------------
FOR L_POS, 1, 7
	;先に全員外す
	SIF POS(L_POS) >= 0
		CALL REMOVE_POSITION, L_POS
NEXT
FOR L_POS, 1, 7
	L_CHARA = POS_FOR_FORMATION_P(L_POS, ARG)
	SIF L_CHARA < 0
		CONTINUE
	;配置条件を確認する
	CALL CASTING_CHOOSE_COMPANION, L_CHARA
	SIF !RESULT
		CONTINUE 
	CALL INSERT_POSITION, L_POS, L_CHARA
NEXT
;---- EDIT 059 MOD END ---------------------------
;-------------------------------------------------
;最後に編成されたパーティメンバー編成を登録する関数
;-------------------------------------------------
@SET_LAST_BATTLE_MEMBERSET
#DIM DYNAMIC LCOUNT
FOR LCOUNT, 1, 7
	IF POS(LCOUNT) < 0
		BATTLE_MEMBERSET:(BATTLE_MEMBERSETNUM - 1):LCOUNT = 0
	ELSE
		BATTLE_MEMBERSET:(BATTLE_MEMBERSETNUM - 1):LCOUNT = CFLAG:POS(LCOUNT):실제가입시간
	ENDIF
NEXT

;-------------------------------------------------
;現在のパーティを最後に利用された編成に入れ替える
;-------------------------------------------------
@CHANGE_LAST_BATTLE_MEMBERSET
CALL CHANGE_BATTLE_MEMBERSET, BATTLE_MEMBERSETNUM - 1
