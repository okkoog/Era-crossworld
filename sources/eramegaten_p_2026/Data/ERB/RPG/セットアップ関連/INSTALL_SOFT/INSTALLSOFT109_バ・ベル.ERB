;바・벨
@INSTALLSOFT_EXPLAIN_109
RESULTS = 벨신에게서 흡수한 힘을 강마한다。
IF FLAG:벨신격파 & 64
	RESULTS:1 = 힘＋５　지혜＋５　마력＋５　내구＋５　속도＋５　운＋５
ELSE
	;ベル・イアル
	SIF FLAG:벨신격파 & 1
		RESULTS:1 = 힘＋3
	;イザ・ベル
	SIF FLAG:벨신격파 & 2
		RESULTS:1 += "　지혜＋3"
	;ベル・ベリト
	SIF FLAG:벨신격파 & 4
		RESULTS:1 += "　마력＋3"
	;ベル・デル
	SIF FLAG:벨신격파 & 8
		RESULTS:1 += "　내구＋3"
	;ベル・ゼブブ
	SIF FLAG:벨신격파 & 16
		RESULTS:1 += "　속도＋3"
	;ア・ベル
	SIF FLAG:벨신격파 & 32
		RESULTS:1 += "　운＋3"
ENDIF
