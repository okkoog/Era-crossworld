;===============================================================================
;  ◇記載関数一覧(記載順)
;
;		Module Name						Explanation
;		IS_EQUIPED_KAMUI_BY_CHARA		指定したキャラクターに指定した神意が装備されているか確認する
;		IS_EQUIPED_KAMUI_BY_PARTY		パーティ内で指定した神意が装備されているか確認する
;===============================================================================
;-------------------------------------------------------------------------------
;指定したキャラクターに指定した神意が装備されているか確認する
;-------------------------------------------------------------------------------
@IS_EQUIPED_KAMUI_BY_CHARA, L_CHARA, L_KAMUI
#FUNCTION
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_KAMUI
#DIM DYNAMIC LCOUNT
FOR LCOUNT, 0, VARSIZE("C_EQUIPED_KAMUI")
	SIF C_EQUIPED_KAMUI:L_CHARA:LCOUNT == L_KAMUI
		RETURNF 1
NEXT
RETURNF 0

;-------------------------------------------------------------------------------
;パーティ内で指定した神意が装備されているか確認する
;-------------------------------------------------------------------------------
@IS_EQUIPED_KAMUI_BY_PARTY, L_KAMUI
#FUNCTION
#DIMS DYNAMIC L_KAMUI
#DIM DYNAMIC LCOUNT
FOR LCOUNT, 1, 7 
	SIF POS(LCOUNT) < 0
		CONTINUE
	SIF IS_EQUIPED_KAMUI_BY_CHARA(POS(LCOUNT), L_KAMUI)
		RETURNF 1
NEXT
RETURNF 0