@NAVIGATOR_CUSTOM_COMMENT, ARG
RESULTS = 
TRYCCALLFORM IS_EXIST_KOJO_BATTLE_NAVI%口上関数末尾文字(ARG)%, ARG
	IF RESULT
		IF RESULTS == ""
			PRINT 　전용 구상 있음
		ELSE
			PRINTFORM 　%RESULTS%
		ENDIF
	ELSE
		PRINTFORM 　%RESULTS%
	ENDIF
CATCH
	CALL 口上存在確認, ARG
	;専用の口上自体はあるが、ナビ口上が存在しない場合は汎用口上に落とすのを避ける
	IF RESULT == 1
		PRINT 　구상 없음
	ELSE
		TRYCCALLFORM IS_EXIST_KOJO_BATTLE_NAVI_PUB{ABL:ARG:회화타입}
			IF RESULT
				IF RESULTS == ""
					PRINT 　범용 구상 있음
				ELSE
					PRINTFORM 　%RESULTS%
				ENDIF
			ELSE
				PRINTFORM 　%RESULTS%
			ENDIF
		CATCH
			PRINT 　구상 없음
		ENDCATCH
	ENDIF
ENDCATCH
