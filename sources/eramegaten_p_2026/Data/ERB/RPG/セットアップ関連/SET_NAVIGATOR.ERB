@SET_OPT_NAVIGATOR_COLOR
#DIM STOCK_TARGET
#DIM L_RGB, 2, 3
#DIM LCOUNT, 3
#DIM TEMP, 3
#DIM TEMP_COLOR
#DIM L_LINE
REDRAW 0

STOCK_TARGET = TARGET
TARGET = 0
L_RGB:0:0 = COLOR("NAVI") / 256 / 256, COLOR("NAVI") / 256 % 256, COLOR("NAVI") % 256 % 256
L_RGB:1:0 = COLOR("NAVI_MAIN") / 256 / 256, COLOR("NAVI_MAIN") / 256 % 256, COLOR("NAVI_MAIN") % 256 % 256
L_LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - L_LINE
CALL VARSET_KOJO_RPG_FLAG

FOR LCOUNT, 0, 2
	TSTR:전투구상캐릭터명칭 = ピクシー
	TSTR:전투구상캐릭터화상어드레스 = %GET_FACE_BY_CSV_AS_HTML([[キャラ:픽시]], , 400)%
	IF !LCOUNT
		BTL_KOJO_RESULTS:0 = 戦闘開始や戦闘終了のナビを表示するときの色だよ
		BTL_KOJO_RESULTS:1 = 通常の戦闘口上と並んだりもするよ
	ELSE
		BTL_KOJO_RESULTS:0 = コマンド入力のトップ画面での色だよ
		BTL_KOJO_RESULTS:1 = 他のコマンドとかと並ぶからそれを踏まえて設定してね
	ENDIF
	DRAWLINE
	PRINTFORML %AUTO_SPLIT("전투시작/전투종료_메인화면", "_", LCOUNT)%
	DRAWLINE
	CUSTOMDRAWLINE =
	SETCOLOR L_RGB:LCOUNT:0, L_RGB:LCOUNT:1, L_RGB:LCOUNT:2
	CALL PRINT_KOJO_RPG_MESSAGE, "ナビ_メイン画面"
	RESETCOLOR
	PRINT 　　　 
	CALL PRINT_COLOR, "[", COLOR("デフォルト")
	FOR LCOUNT:1, 0, BTL_COLOR_TABLE_NUM() + 1
		TEMP_COLOR = COLOR(AUTO_SPLIT(BTL_COLOR_TABLE(), "/", LCOUNT:1))
		SETCOLOR TEMP_COLOR
		PRINTBUTTON "■", (LCOUNT+1) * 1000 + LCOUNT:1
		RESETCOLOR
	NEXT
	CALL PRINT_COLOR, "]", COLOR("デフォルト")
	PRINTL 
	FOR LCOUNT:1, 0, 3
		PRINTFORM %AUTO_SPLIT("Ｒ/Ｇ/Ｂ", "/", LCOUNT:1)%{L_RGB:LCOUNT:(LCOUNT:1), 3}　
		FOR LCOUNT:2, 0, 4
			PRINTBUTTON @"[{LCOUNT * 12 + LCOUNT:1 * 4 + LCOUNT:2, 3}] %AUTO_SPLIT("+1/+10/-1/-10", "/", LCOUNT:2)%", LCOUNT * 12 + LCOUNT:1 * 4 + LCOUNT:2
			PRINT 　
		NEXT
		PRINTL 
	NEXT
NEXT
RESETCOLOR
DRAWLINE
PRINTL [ 98] 다시하기
PRINTL [ 99] 기본 설정으로 되돌리기
PRINTL [100] 돌아간다
INPUT
SELECTCASE RESULT
	CASE 98
		RESTART
	CASE 99
		OPT_NAVI_COLOR_OTHER = 0
		OPT_NAVI_COLOR_MAIN = 0
		RESTART
	CASE 100
		OPT_NAVI_COLOR_OTHER = L_RGB:0:0 * 256 * 256 + L_RGB:0:1 * 256 + L_RGB:0:2
		OPT_NAVI_COLOR_MAIN = L_RGB:1:0 * 256 * 256 + L_RGB:1:1 * 256 + L_RGB:1:2
		SAVEGLOBAL
		;変数の後始末
		TARGET = STOCK_TARGET
		REDRAW 1
		RESETCOLOR
		RETURN 0
	CASE 0 TO 23
		TEMP = RESULT / 12, RESULT % 12 / 4, RESULT % 4
		L_RGB:TEMP:(TEMP:1) += TOINT(AUTO_SPLIT("+1/+10/-1/-10", "/", TEMP:2))
		L_RGB:TEMP:(TEMP:1) = LIMIT(L_RGB:TEMP:(TEMP:1), 0, 255)
	CASE 1000 TO 2099
		TEMP = (RESULT % 1000)
		TEMP:1 = (RESULT / 1000) - 1
		SIF TEMP > BTL_COLOR_TABLE_NUM()
			GOTO START
		TEMP_COLOR = COLOR(AUTO_SPLIT(BTL_COLOR_TABLE(), "/", TEMP))
		L_RGB:(TEMP:1):0 = TEMP_COLOR / 256 / 256
		L_RGB:(TEMP:1):1 = TEMP_COLOR / 256 % 256
		L_RGB:(TEMP:1):2 = TEMP_COLOR % 256
		GOTO START
ENDSELECT
GOTO START
