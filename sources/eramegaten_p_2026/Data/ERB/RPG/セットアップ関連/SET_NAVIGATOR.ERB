@NAVIGATOR_CUSTOM_COLOR, ARG
IF ARG == NAVIGATOR
	RETURN COLOR("aqua")
ELSE
	TRYCCALLFORM IS_EXIST_KOJO_BATTLE_NAVI%口上関数末尾文字(ARG)%, ARG
		RETURN COLOR("パ緑")
	CATCH
		CALL 口上存在確認, ARG
		;専用の口上自体はあるが、ナビ口上が存在しない場合は汎用口上に落とすのを避ける
		IF RESULT == 1
			RETURN GETDEFCOLOR()
		ELSE
			TRYCCALLFORM IS_EXIST_KOJO_BATTLE_NAVI_PUB{ABL:ARG:회화타입}
				SIF RESULT
					RETURN COLOR("ピンク")
			CATCH
				RETURN GETDEFCOLOR()
			ENDCATCH
		ENDIF
	ENDCATCH
ENDIF
