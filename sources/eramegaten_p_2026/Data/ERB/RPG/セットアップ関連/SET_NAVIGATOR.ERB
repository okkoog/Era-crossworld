@NAVIGATOR_ABLE, ARG
#FUNCTION
;主人は除外
SIF ARG == MASTER
	RETURNF 0
;労役中キャラは除外
SIF IS_RENTING(ARG)
	RETURNF 0
;育児・出産中のキャラは省く
SIF CHECK_CHILD_CARE(ARG)
	RETURNF 0
;失踪中などこの場にいないなら除外
SIF CFLAG:ARG:이자리에없는플래그
	RETURNF 0
;戦闘に参加できないとだめ
SIF GET_VALUE_TALENT_JOINABLE(ARG) == 0
	RETURNF 0
SIF CFLAG:ARG:전투이외불능
	RETURNF 0
SIF CPOS(ARG)
	RETURNF 0
SIF CFLAG:ARG:필터링플래그
	RETURNF 0
RETURNF 1

@SET_NAVIGATOR
PRINTL
CUSTOMDRAWLINE =
;キャラリストを表示
{
CALL INPUT_CHARA_LIST
, "FUNC_PROPSET_LIST"
, "誰をナビゲーターにする？"
, "CASTING_SET_NAVIGATOR"
, "UP_PRINT_ACTION_NAVIGATOR"
, "CASTING_RESULT_ACTION_NAVIGATOR"
, "NAVIGATOR_DOWN_INPUT"
, "L_CANCELS"
, "FUNC_CUSTOM_TITLE"
, "NAVIGATOR_CUSTOM_COLOR"
, -1
}
SELECTCASE RESULT
	CASE 1000
		RETURN 0
	CASE 1001
		NAVIGATOR = -1
	CASE 1011
		CALL SET_OPT_NAVIGATOR_COLOR
		RESTART
	CASE 1012
		OPT_KOJO_FILTER = !OPT_KOJO_FILTER
		RESTART
	CASEELSE
		NAVIGATOR = RESULT
ENDSELECT
@CASTING_SET_NAVIGATOR, ARG
SIF !NAVIGATOR_ABLE(ARG)
	RETURN 0
IF OPT_KOJO_FILTER
	;口上がない場合でもバージョン違いであることを表示させるために関数の有無を見るだけにする
	TRYCCALLFORM IS_EXIST_KOJO_BATTLE_NAVI%口上関数末尾文字(ARG)%, ARG
	CATCH
		CALL 口上存在確認, ARG
		;専用の口上自体はあるが、ナビ口上が存在しない場合は汎用口上に落とすのを避ける
		IF RESULT == 1
			RETURN 0
		ELSE
			TRYCCALLFORM IS_EXIST_KOJO_BATTLE_NAVI_PUB{ABL:ARG:회화타입}
			CATCH
				RETURN 0
			ENDCATCH
		ENDIF
	ENDCATCH
ENDIF
RETURN 1

