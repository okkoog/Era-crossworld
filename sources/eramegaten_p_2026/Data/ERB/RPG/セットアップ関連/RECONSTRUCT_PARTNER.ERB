;==================================
;仲間再構成
;==================================
@RECONSTRUCTION
PRINTL [1]소환/편입
PRINTL [2]귀환/제외
PRINTL [1000]아무것도안한다
$INPUT_LOOP
INPUT
IF RESULT != 1 && RESULT != 2 && RESULT != 1000
	GOTO INPUT_LOOP 
ELSEIF RESULT == 1
	CALL RECONSTRUCT_PARTNER
ELSEIF RESULT == 2
	CALL REMOVE_PARTNER
ELSEIF RESULT == 1000
	RETURN 1
ENDIF
;==================================
;仲間入れ替え
;==================================
@RECONSTRUCT_PARTNER
PRINTL
CALL SHOW_NOW_FORMATION_P,0,2, 3
PRINTC [1000] - 돌아간다
PRINTL
DRAWLINE
PRINTL 어디에 배치할까？

$INPUT_LOOP
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT < 7 && 0 < RESULT
	LOCAL = RESULT
	$INPUT_LOOP2
	CALL CHOOSE_PARTNER,2
	LOCAL:1 = RESULT
	IF RESULT == 1000
		RESTART
	ELSE
		;---- EDIT 007 ADD END   -------------------------
		;LOCAL:2 = FLAG:SHOP커맨드
		;FLAG:SHOP커맨드 = 106
		CALL INSERT_PARTNER,LOCAL,LOCAL:1
		;FLAG:SHOP커맨드 = LOCAL:2
		IF RESULT > -1
			SELECTCASE FLAG:SHOP커맨드
				CASE [[ショップ:탐색]],[[ショップ:콜로세움참가]],[[ショップ:이벤트]],[[ショップ:의뢰청부]]
					IF CFLAG:(LOCAL:1):PT플래그 > 0 && ABL:(LOCAL:1):종족 != 0
						CALL CONTROL_MAG, MASTER, -MAXBASE:(LOCAL:1):￥
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF

	RESTART
ELSE
	GOTO INPUT_LOOP
ENDIF

CALL REFRESH_FORMATION

;==================================
;仲間帰還
;==================================
@REMOVE_PARTNER
PRINTL
DRAWLINE
DRAWLINE
CALL SHOW_NOW_FORMATION_P,0,2, 3
DRAWLINE
PRINTC [0]그만둔다

PRINTL
DRAWLINE
PRINTL 누구를 되돌릴까？
$INPUT_LOOP
INPUT
LOCALS = 포지션{RESULT}
IF RESULT == 0
	RETURN 0

ELSEIF RESULT < 1 || RESULT > 6 || FLAG:LOCALS == 0 || FLAG:LOCALS == -1
	GOTO INPUT_LOOP
ELSE
	IF FLAG:SHOP커맨드 == [[ショップ:탐색]] && (ABL:(FLAG:LOCALS):종족 > 45)
		PRINTW 던전 내에서는 인간을 파티에서 제외할 수 없습니다
		CLEARLINE 1
		GOTO INPUT_LOOP
	ENDIF
	CALL REMOVE_POSITION,RESULT
ENDIF
RESTART

;==================================
;ポジションに挿入
;==================================
@INSERT_PARTNER,ARG,ARG:1
LOCALS = 포지션{ARG}
IF CFLAG:(ARG:1):PT플래그 > 0
	SIF ARG < 4
		LOCALS:1 = 포지션{ARG+3}
ELSE
	SIF ARG < 12
		LOCALS:1 = 포지션{ARG+5}
ENDIF
IF FLAG:LOCALS > -1
	;後ろが空いてるならずれてもらう
	IF ((CFLAG:(ARG:1):PT플래그 && ARG < 4) || (CFLAG:(ARG:1):PT플래그 == 0 && ARG < 12)) && FLAG:(LOCALS:1) == -1
		CFLAG:(FLAG:LOCALS):포지션 = ARG+3+!CFLAG:(FLAG:LOCALS):PT플래그*2
		FLAG:(LOCALS:1) = FLAG:LOCALS
		;PRINTFORML {ARG}に%CALLNAME:(ARG:1)%を配置します
		FLAG:LOCALS = ARG:1
		;PRINTFORML %CALLNAME:(ARG:1)%のポジションを{ARG}に書き換えます。
		CFLAG:(ARG:1):포지션 = ARG
		SIF CFLAG:(ARG:1):PT플래그
			CFLAG:(ARG:1):PT플래그 = 2
	;空いておらず、そこに居るのが悪魔なら交代;悪魔人もここ
	ELSEIF ((ABL:(FLAG:LOCALS):종족 >= 0 && ABL:(FLAG:LOCALS):종족 < 46) || ABL:(FLAG:LOCALS):종족 == 73) && (FLAG:LOCALS) != MASTER
		CALL REMOVE_POSITION,ARG
		;PRINTFORML {ARG}に%CALLNAME:(ARG:1)%を配置します
		FLAG:LOCALS = ARG:1
		;PRINTFORML %CALLNAME:(ARG:1)%のポジションを{ARG}に書き換えます。
		CFLAG:(ARG:1):포지션 = ARG
		SIF CFLAG:(ARG:1):PT플래그
			CFLAG:(ARG:1):PT플래그 = 2
	;そこに居るのが主人以外かつ探索or戦闘中でなければ交代
	ELSEIF (FLAG:LOCALS) != MASTER && FLAG:SHOP커맨드 == [[ショップ:셋업]]
		CALL REMOVE_POSITION,ARG
		;PRINTFORML {ARG}に%CALLNAME:(ARG:1)%を配置します
		FLAG:LOCALS = ARG:1
		;PRINTFORML %CALLNAME:(ARG:1)%のポジションを{ARG}に書き換えます。
		CFLAG:(ARG:1):포지션 = ARG
		SIF CFLAG:(ARG:1):PT플래그
			CFLAG:(ARG:1):PT플래그 = 2
	ELSE
	;どれかに引っかからなかったら交代できない
		PRINTW 교대할 수 없습니다
		RETURN -1
	ENDIF
	
ELSE
	IF CFLAG:(ARG:1):포지션
		LOCALS:2 = 포지션{CFLAG:(ARG:1):포지션}
		FLAG:(LOCALS:2) = -1
	ENDIF
	;PRINTFORML {ARG}に%CALLNAME:(ARG:1)%を配置します
	FLAG:LOCALS = ARG:1
	;PRINTFORML %CALLNAME:(ARG:1)%のポジションを{ARG}に書き換えます。
	CFLAG:(ARG:1):포지션 = ARG
	SIF CFLAG:(ARG:1):PT플래그
		CFLAG:(ARG:1):PT플래그 = 2
ENDIF



;==================================
;仲間を表示
;==================================
;これって@CHOOSE_COMPANIONと中身一緒じゃない？
@CHOOSE_PARTNER,ARG
#DIMS DYNAMIC L_MESSAGE
N = ARG
IF FLAG:SHOP커맨드 == [[ショップ:셋업]]
	L_MESSAGE = 누구를 배치할까？
ELSE
	L_MESSAGE = 누구를 불러낼까？
ENDIF
{
CALL INPUT_CHARA_LIST
	, "FUNC_PROPSET_LIST_BATTLE"
	, L_MESSAGE
	, "CASTING_CHOOSE_PARTNER" 
	, "SHOW_ADD_UP_FUNCTION"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "그만둔다"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
;IF FLAG:SHOP커맨드 == [[ショップ:셋업]]
;	CALL INPUT_CHARA_LIST("誰を配置する？", "CASTING_CHOOSE_PARTNER", "", "", "", "やめる")
;ELSE
;	CALL INPUT_CHARA_LIST("누구를 불러낼까？", "CASTING_CHOOSE_PARTNER", "", "", "", "やめる")
;ENDIF
IF RESULT == 1000
	RETURN 1000
;ELSEIF RESULT == 1002 && ARG == 2 ;この1002がよく分からないからコメントアウト
;	RETURN 1002
ELSE
	SELECTCASE FLAG:SHOP커맨드
		CASE [[ショップ:탐색]],[[ショップ:콜로세움참가]],[[ショップ:이벤트]],[[ショップ:의뢰청부]]
			IF ABL:RESULT:종족 != 0 && GET_CHARA_STOCK_MAG(MASTER) < MAXBASE:RESULT:￥
				PRINTW MAG가 부족합니다
				CLEARLINE 2
				RESTART
			ENDIF
	ENDSELECT
	RETURN RESULT
ENDIF

@CASTING_CHOOSE_PARTNER(ARG:0)
SIF CFLAG:(ARG:0):PT플래그 != 1
	RETURN 0
SIF GET_VALUE_TALENT_JOINABLE((ARG:0)) == 0
	RETURN 0
SIF CFLAG:(ARG:0):전투이외불능
	RETURN 0
SIF TALENT:(ARG:0):전력상실 > 0
	RETURN 0
SIF IS_RENTING(ARG:0)
	RETURN 0
SIF N == 1 && GET_STATE(CFLAG:(ARG:0):상태이상) == "DYING"
	RETURN 0
SIF TALENT:(ARG:0):비전투원
	RETURN 0
SIF CFLAG:(ARG:0):이자리에없는플래그 == 1
	RETURN 0
SIF N == 1 && ABL:(ARG:0):종족 == 0
	RETURN 0
SIF N == 1 && CFLAG:(ARG:0):피변신플래그
	RETURN 0
SIF N == 1 && CFLAG:(ARG:0):소속ＣＯＭＰ == -1
	RETURN 0
;フィルタリングされてるキャラは除外
SIF CFLAG:(ARG:0):필터링플래그
	RETURN 0
RETURN 1