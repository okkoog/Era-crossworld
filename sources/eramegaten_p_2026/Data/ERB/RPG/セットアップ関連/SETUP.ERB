		TEMPS = ＬＡＳＴ ＰＡＲＴＹ
	ELSEIF BATTLE_MEMBERSET_NAME:LCOUNT != ""
		TEMPS = %BATTLE_MEMBERSET_NAME:LCOUNT%
	ELSE
		TEMPS = ＳＥＴ - %SUBSTRINGU("ＡＢＣＦＥＦＧ", LCOUNT, 1)%
	ENDIF
	TEMPS = [{30 + LCOUNT}] %TEMPS%
	;---- EDIT P 001 MOD START -------------------------
	PRINTBUTTON TOALIGNMENT(TEMPS, GET_CHARALENS_FORMATION_P(), "LEFT") + "　", 30 + LCOUNT
