@DEVIL_STORAGE
#DIM LCOUNT

P = 0
;表示させるキャラを抽出（Q:*に表示するキャラの登録番号、LOCAL:2に人数）
VARSET Q, -1
LOCAL:2 = 0
FOR LCOUNT, 0, CHARANUM
	SIF LCOUNT == MASTER
		CONTINUE
	;---- EDIT 020 MOD START -------------------------
	SIF !GET_ROLE_PROP("CAN_PUT_IN_COMP", LCOUNT)
		CONTINUE
	;SIF (ABL:LCOUNT:종족 == 0 || ABL:LCOUNT:종족 > 45) && ABL:LCOUNT:종족 != 73
	;	CONTINUE
	;IF TALENT:LCOUNT:인수라
	;	CFLAG:LCOUNT:소속ＣＯＭＰ = -1
	;	CONTINUE
	;ENDIF
	;---- EDIT 020 MOD END ---------------------------
	SIF CFLAG:LCOUNT:이자리에없는플래그 == 1
		CONTINUE
	;SIF CFLAG:LCOUNT:용량미사용
	;	CONTINUE
	Q:(LOCAL:2) = LCOUNT
	LOCAL:2 ++
NEXT

DRAWLINE

$PRINT_LIST
PRINTFORML ＣＯＭＰ-자택서버간 전송시킬 악마를 선택해주세요　＜page.{P + 1}＞　ＣＯＭＰ：{NUM_NAKAMA()}/{GET_STOCKSIZE()}
FOR LOCAL, P * リスト表示数() , MIN(P * リスト表示数() + リスト表示数(), LOCAL:2)
	CALL ARRANGE_CHARALIST, Q:LOCAL
	CALL ARRANGE_CHARALIFE, Q:LOCAL
;---- EDIT 005 MOD START -------------------------
	PRINTFORM 　
	CALL ARRANGE_FALLTALENT, Q:LOCAL
	CALL PRINT_ALIGNMENT, Q:LOCAL, 1, 0
	PRINTFORM %AUTO_SPLIT(" 　　, ①　, ②　, ③　, 　④, 　⑤, 　⑥",",",CFLAG:(Q:LOCAL):포지션)%
;---- EDIT 005 MOD END   -------------------------
	;IF CFLAG:(Q:LOCAL):용량미사용 || ABL:(Q:LOCAL):종족 == 73
	;	PRINTFORML [\@ CFLAG:(Q:LOCAL):소속ＣＯＭＰ == -1 ? 待機中 # 同行中 \@]
	;ELSE
		PRINTFORML [\@ CFLAG:(Q:LOCAL):소속ＣＯＭＰ == -1 ? 자택서버 # ＣＯＭＰ \@]
	;ENDIF
NEXT
;---- EDIT 006 MOD START -------------------------
DRAWLINE
PRINTFORMLC \@ LOCAL:2 > リスト表示数() ?[1007]이전페이지# [----] \@
PRINTLC [1000]돌아간다
PRINTFORMLC \@ LOCAL:2 > リスト表示数() ?[1009]다음페이지# [----] \@

$INPUT_LOOP_1
INPUT
IF RESULT == 1000
	RETURN 0
ELSEIF RESULT == 1007
	IF P > 0
		P -= 1
		GOTO PRINT_LIST
	ELSEIF P == 0
		P =(LOCAL:2-1) / リスト表示数() 
		GOTO PRINT_LIST
	ELSE
		GOTO INPUT_LOOP_1
	ENDIF
ELSEIF RESULT == 1009
	IF P == (LOCAL:2-1) / リスト表示数()
		P = 0
		GOTO PRINT_LIST
	ELSEIF P < (LOCAL:2-1) / リスト表示数()
		P += 1
		GOTO PRINT_LIST
	ENDIF
;---- EDIT 006 MOD END   -------------------------
ELSEIF RESULT < 1 || RESULT >= CHARANUM || MATCH(Q,RESULT,0) == 0
	GOTO INPUT_LOOP_1
ELSE
	IF CFLAG:RESULT:소속ＣＯＭＰ == -1
		LOCAL = RESULT
		;IF CFLAG:RESULT:용량미사용 || ABL:RESULT:종족 == 73
		;---- EDIT 004 MOD START -------------------------
		;IF ストック空き容量() < 1 && SOFT_ON("デビルチェンバー") && NUM_NAKAMA_HEADCOUNT() == 6
		;	PRINTW ＣＯＭＰの悪魔が６体を超えるとデビルチェンバーの効果が消えて容量オーバーしてしまいます！
		;	CLEARLINE 2
		;	GOTO INPUT_LOOP_1
		;ELSEIF ストック空き容量() < 1
		;---- EDIT 004 MOD END ---------------------------
		IF NUM_NAKAMA() >= GET_STOCKSIZE()
			PRINTW ＣＯＭＰ의 용량이 가득찼습니다
			CLEARLINE 2
			GOTO INPUT_LOOP_1
		ENDIF
		;---- EDIT 017 MOD START -------------------------
		;IF NO:LOCAL != [[キャラ:당신의딸]] && NO:LOCAL != [[キャラ:노예의딸]] && NO:LOCAL != [[キャラ:조마]]
		IF CSVCFLAG(NO:LOCAL,GETNUM(CFLAG,"복수생성가능"),0) != 1
		;---- EDIT 017 MOD END ---------------------------
			FOR LOCAL:1,0,CHARANUM
				IF 계약(LOCAL:1) == 0 && NO:(LOCAL:1) == NO:LOCAL && 계약(LOCAL) == 0 && CFLAG:(LOCAL:1):소속ＣＯＭＰ != -1
					PRINTW 같은 악마가 ＣＯＭＰ에 있습니다
					CLEARLINE 2
					GOTO INPUT_LOOP_1
				ENDIF
			NEXT
		ENDIF
		CFLAG:RESULT:소속ＣＯＭＰ = 0
	ELSE
		CFLAG:RESULT:소속ＣＯＭＰ = -1
	ENDIF
	GOTO PRINT_LIST
ENDIF
