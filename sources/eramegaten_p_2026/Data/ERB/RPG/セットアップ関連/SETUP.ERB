;-------------------------------------------------
;編成セットの登録関数
;-------------------------------------------------
@SET_PARTYSET_MEMBER
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC SHOW_LINE
#DIMS DYNAMIC TEMP
#DIMS DYNAMIC TEMPS
#DIM DYNAMIC L_LINE
#DIM DYNAMIC STOCK_REDRAW
#DIM DYNAMIC SELECT_PARTYSET
#DIM DYNAMIC SELECT_POS
#DIM DYNAMIC SELECT_MODE
#DIM DYNAMIC LEFT_SPACE_LENS
#DIM DYNAMIC SELECT_CHANGE

LEFT_SPACE_LENS = 17
STOCK_REDRAW = CURRENTREDRAW()
REDRAW 0
L_LINE = LINECOUNT
$START
CLEARLINE LINECOUNT - L_LINE
;同期処理
CALL SET_LEADER_SKILL
FOR LCOUNT, 1, 7
	SIF POS(LCOUNT) < 0
		CONTINUE
	CALL SYNC_STATUS, POS(LCOUNT), "HPMP割合保持"
NEXT
IF SELECT_CHANGE
	SHOW_LINE = 
	SHOW_LINE += LEFT_SPACE_LENS * " "
	SHOW_LINE += ((SELECT_CHANGE -1) % 3) * GET_CHARALENS_FORMATION_P() * " "
	SHOW_LINE += @"<shape type ='rect' param = '0, {(SELECT_CHANGE -1) > 2 ? 1100 # 500}, {GET_CHARALENS_FORMATION_P() * 50}, {FLAG:상성등표시ON > 0 ? 700 # 500}' color = '%TOSTR_HTML(BGCOLOR("LIGHT-BLACK"))%'>"
	HTML_PRINT SHOW_LINE
ELSE
	PRINTL 
ENDIF
DRAWLINE
DRAWLINE
CALL SHOW_NOW_FORMATION_P,0,2, 3, , SELECT_PARTYSET
FOR LCOUNT, 0, BATTLE_MEMBERSETNUM - 1
	SIF LCOUNT % 3 == 0
		PRINTFORM %" " * LEFT_SPACE_LENS%
	IF BATTLE_MEMBERSET_NAME:LCOUNT != ""
		TEMPS = %BATTLE_MEMBERSET_NAME:LCOUNT%
	ELSE
		TEMPS = ＳＥＴ - %SUBSTRINGU("ＡＢＣＦＥＦＧ", LCOUNT, 1)%
	ENDIF
	TEMPS = [{20 + LCOUNT}] %TEMPS%
	SETCOLOR SELECT_PARTYSET == LCOUNT ? COLOR("p-green") # COLOR("DEF")
	PRINTBUTTON TOALIGNMENT(TEMPS, GET_CHARALENS_FORMATION_P(), "LEFT"), 20 + LCOUNT
	SIF LCOUNT % 3 == 2
		PRINTL 
NEXT
RESETCOLOR
SIF !LINEISEMPTY()
	PRINTL 
DRAWLINE
SHOW_LINE '= " " * LEFT_SPACE_LENS
SHOW_LINE += SET_COLOR_TAG(SET_BUTTON_TAG(@"%"[10] 소환/편입", GET_CHARALENS_FORMATION_P(), LEFT%", "10"), \@SELECT_MODE == 0 ? aqua # DEF\@)
SHOW_LINE += SET_COLOR_TAG(SET_BUTTON_TAG(@"%"[11] 포지션변경", GET_CHARALENS_FORMATION_P(), LEFT%", "11"), \@SELECT_MODE == 1 ? aqua # DEF\@)
SHOW_LINE += SET_COLOR_TAG(SET_BUTTON_TAG(@"%"[12] 귀환/제외", GET_CHARALENS_FORMATION_P(), LEFT%", "12"), \@SELECT_MODE == 2 ? aqua # DEF\@)
HTML_PRINT SHOW_LINE
DRAWLINE
PRINTFORML [90] 현재 파티 편성을 복사한다
PRINTFORML [91] 편성을 리셋한다
PRINTFORML [92] 세트명 편집
PRINTFORML [99] 돌아간다
INPUT
IF INRANGE(RESULT, 1, 7)
	SELECT_POS = RESULT
	L_CHARA = POS_FOR_FORMATION_P(SELECT_POS, SELECT_PARTYSET)
ELSE
	SELECT_CHANGE = 0
ENDIF
SELECTCASE RESULT
	CASE 1 TO 7
		SELECTCASE SELECT_MODE
			CASE 0
				IF L_CHARA != MASTER
					CALL CHOOSE_COMPANION,"셋업"
					IF RESULT != 1000
						;既にほかのポジションに登録されている場合、はがす
						FOR LCOUNT, 1, 7
							SIF BATTLE_MEMBERSET:SELECT_PARTYSET:LCOUNT == CFLAG:RESULT:실제가입시간
								BATTLE_MEMBERSET:SELECT_PARTYSET:LCOUNT = 0
						NEXT
						BATTLE_MEMBERSET:SELECT_PARTYSET:SELECT_POS = CFLAG:RESULT:실제가입시간
					ENDIF
				ENDIF
			CASE 1
				IF SELECT_CHANGE
					SWAP BATTLE_MEMBERSET:SELECT_PARTYSET:SELECT_POS, BATTLE_MEMBERSET:SELECT_PARTYSET:SELECT_CHANGE
					SELECT_CHANGE = 0
				ELSE
					SELECT_CHANGE = SELECT_POS
				ENDIF
			CASE 2
				SIF L_CHARA >= 0 && L_CHARA != MASTER
					BATTLE_MEMBERSET:SELECT_PARTYSET:SELECT_POS = 0
		ENDSELECT
	CASE 10 TO 12
		SELECT_MODE = RESULT % 10
	CASE 20 TO 20 + BATTLE_MEMBERSETNUM - 1
		SELECT_PARTYSET = RESULT - 20
	CASE 90
		FOR LCOUNT, 1, 7
			IF POS(LCOUNT) < 0
				BATTLE_MEMBERSET:SELECT_PARTYSET:LCOUNT = 0
			ELSE
				BATTLE_MEMBERSET:SELECT_PARTYSET:LCOUNT = CFLAG:POS(LCOUNT):실제가입시간
			ENDIF
		NEXT
	CASE 91
		FOR LCOUNT, 1, 7
			BATTLE_MEMBERSET:SELECT_PARTYSET:LCOUNT = 0
		NEXT
		BATTLE_MEMBERSET:SELECT_PARTYSET:2 = CFLAG:MASTER:실제가입시간
	CASE 92
		PRINTFORML 세트의 명칭을 입력해주세요
		INPUTS
		BATTLE_MEMBERSET_NAME:SELECT_PARTYSET = %SUBSTRING(RESULTS, 0, 20)%
		PRINTFORMW 세트명을『%BATTLE_MEMBERSET_NAME:SELECT_PARTYSET%』로 변경했습니다。
	CASE 99
		REDRAW STOCK_REDRAW
		RETURN 0
ENDSELECT
GOTO START
