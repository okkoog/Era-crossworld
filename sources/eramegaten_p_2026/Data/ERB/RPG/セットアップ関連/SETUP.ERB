;=================================================================
;仲魔と別れる
;=================================================================
@SETUP_PARTING
;---- EDIT 018 MOD START -------------------------
;CALL INPUT_CHARA_LIST("誰を仲魔から外しますか？", "CASTING_SETUP_PARTING")
{
CALL INPUT_CHARA_LIST
	, "FUNC_PROPSET_LIST"
	, "누구를 동료마에서 제외합니까？"
	, "CASTING_SETUP_PARTING"
	, "SHOW_ADD_UP_FUNCTION"
	, "SHOW_ADD_DOWN_FUNCTION"
	, "ADD_SELECT_FUNCTION"
	, "그만둔다"
	, "FUNC_CUSTOM_TITLE"
	, "FUNC_CUSTOM_COLOR"
	, -1
}
;---- EDIT 018 MOD END ---------------------------
IF RESULT == 1000
	RETURN 0
ELSE
	SIF CFLAG:RESULT:12 > 0
		RESTART
	LOCAL:20 = RESULT
	IF ABL:(LOCAL:20):종족 != 0
		;PRINTFORML %NAME:(LOCAL:20)%のデータをＣＯＭＰから削除しますか？
		PRINTFORML %NAME:(LOCAL:20)%의 데이터를 삭제하시겠습니까？
	ELSE
		PRINTFORML %조사처리(NAME:(LOCAL:20),"를")% 해방하시겠습니까？
	ENDIF
	
	CALL INPUT_YN,"Yes","No",2

	SELECTCASE RESULT
		CASE 0
			;死んでるか石化してる仲魔だったら主人属性値ダウン
			IF CFLAG:(LOCAL:20):상태이상 == GET_STATE_NUM("DYING") || CFLAG:(LOCAL:20):상태이상 == GET_STATE_NUM("STONE")
				CALL INCREASE_LD,-5
			ENDIF
			CALL キャラ削除, LOCAL:20
		CASE 1
			RESTART
	ENDSELECT

	;フォーメーション再読み込み
	CALL REFRESH_POS

ENDIF

@CASTING_SETUP_PARTING(ARG:0)
SIF ARG:0 == MASTER
	RETURN 0
IF GET_ROLE_PROP("CAN_PUT_IN_COMP", ARG)
	SIF GET_RACE(ABL:ARG:종족) == "조마"
		RETURN 0
	SIF GROUPMATCH(GET_RACE(ABL:ARG:종족), "인간", "반마인", "악마인") && CSVCFLAG(NO:ARG,GETNUM(CFLAG,"복수생성가능"),0) != 1
		RETURN 0
ELSE
	SIF CSVCFLAG(NO:ARG,GETNUM(CFLAG,"복수생성가능"),0) != 1
		RETURN 0
ENDIF
SIF CFLAG:(ARG:0):이자리에없는플래그 == 1
	RETURN 0
SIF CFLAG:(ARG:0):소속ＣＯＭＰ == -1 && FLAG:SHOP커맨드 ==[[ショップ:탐색]]
	RETURN 0
RETURN 1


