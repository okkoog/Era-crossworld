@SHOP_COM_110, ARG
#DIM LCOUNT
#DIM SPACE_LENS
#DIMS DYNAMIC TEMPS
#DIM L_CNT
#DIM L_LINE, 2
#DIM LREDRAW
#DIMS L_MENU, 15
#DIM CONST MENU_LENS = 22
#DIMS L_TITLE, 15
#DIM IS_MENU_UNABLE, 15
#DIMS SHOW_LINE, 4

SPACE_LENS = 17

L_MENU:0 '= "소환/편입", "포지션변경", "귀환/제외"
L_MENU:3 '= "장비변경", "동료마해방", "악마스토리지"
L_MENU:6 '= "인스톨소프트", "플러그인소프트", "스킬에뮬레이터"
L_MENU:9 '= "세트편성", "링케이지스킬확인", "네비게이터 지정"
L_MENU:12'= "팀 구성"

L_TITLE:FINDELEMENT(L_MENU, "소환/편입") = 전투에 참가할 멤버를 선택해、포지션을에 배치시킵니다。
L_TITLE:FINDELEMENT(L_MENU, "포지션변경") = 천투에 참가중인 멤버의 포지션을 변경합니다。
L_TITLE:FINDELEMENT(L_MENU, "귀환/제외") = 전투에 참가중인 멤버를 포지션에서 제외합니다。
L_TITLE:FINDELEMENT(L_MENU, "장비변경") = 장비를 변경합니다。
L_TITLE:FINDELEMENT(L_MENU, "동료마해방") = 동료마와 헤어집니다。헤어진 동료마는 등록이 삭제되며、두번 다시 만날 수 없게 됩니다。
L_TITLE:FINDELEMENT(L_MENU, "악마스토리지") = 동료마의 소속을 변경합니다。%UNICODE(0x000D)%ＣＯＭＰ에 소속된 동료마는 전투중이나 탐색중에 소환이나 귀환을 이용해、파티와 대기를 오갈 수 있습니다。%UNICODE(0x000D)%자택서버에 소속된 동료마는 ＣＯＭＰ의 용량을 소비하지 않게 되는 대신 소환과 귀환이 불가능하게 됩니다。
L_TITLE:FINDELEMENT(L_MENU, "인스톨소프트") = 탐색이나 전투를 유리하게 진행할 수 있게 하는 효과를 발휘하는 소프트웨어를 세트합니다。%UNICODE(0x000D)%소프트는 ＣＯＭＰ의 용량을 소비하고、%UNICODE(0x000D)%또한、효과를 발휘하하기 위해 소프트마다 설정된 서머너레벨을 파티 멤버의 누군가가 만족시킬 필요가 있습니다。
L_TITLE:FINDELEMENT(L_MENU, "플러그인소프트") = 일부 동료마에게 능력을 강화하는 소프트를 장비시킵니다。%UNICODE(0x000D)%소프트는 악마해석을 진행하는 것으로 사교의관에서 획득할 수 있습니다。
L_TITLE:FINDELEMENT(L_MENU, "스킬에뮬레이터") = 일정 이상의 서머너레벨을 가진 캐릭터가 이용할 수 있는 소프트를 장비시킵니다。%UNICODE(0x000D)%데빌서머너는 스킬에뮬레이터를 세팅함으로써 강화나 지원 능력을 얻을 수 있습니다。
L_TITLE:FINDELEMENT(L_MENU, "세트편성") = 파티 구성을 세트로 등록・변경한다。
L_TITLE:FINDELEMENT(L_MENU, "링케이지스킬확인") = 복수의 캐릭터가 협력해 발동하는 스킬인 링케이지의 조건을 확인할 수 있습니다。
L_TITLE:FINDELEMENT(L_MENU, "네비게이터 지정") = 전투 중에 전황을 분석하여、보고하는 내비게이터를 지정할 수 있습니다。%UNICODE(0x000D)%단、내비게이터가 직접 전투에 참가하고 있으면 내비게이션을 할 수 없다는 점에 주의해 주세요。
L_TITLE:FINDELEMENT(L_MENU, "팀 구성") = 특정 캐릭터들을 하나로 묶은 팀을 편성합니다。

VARSET IS_MENU_UNABLE
IS_MENU_UNABLE:FINDELEMENT(L_MENU, "네비게이터 지정") = !CAN_USE_NAVIGATOR
IS_MENU_UNABLE:FINDELEMENT(L_MENU, "팀 구성") = 1
FOR LCOUNT, 0, CHARANUM
	SIF CSTR:LCOUNT:롤 != "ホロウエージェント"
		CONTINUE
	IS_MENU_UNABLE:FINDELEMENT(L_MENU, "팀 구성") = 0
	BREAK
NEXT
