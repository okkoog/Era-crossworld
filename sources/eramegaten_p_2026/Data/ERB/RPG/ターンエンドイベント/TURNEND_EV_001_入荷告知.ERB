;====================
;定義名
;====================
@TURNEND_EV_NAME_1
RESULTS = 入荷告知

;====================
;条件
;====================
@PLAYABLE_TURNEND_EV_1
#DIM LCOUNT
#DIM TEMP
#DIMS TEMPS
SIF GET_STR_TURNEND_EV("入荷告知", "告知文") == ""
	RETURN 0
FOR LCOUNT, 0, STRCOUNT(GET_STR_TURNEND_EV("入荷告知", "告知文"), "/") + 1
	TEMPS = %AUTO_SPLIT(GET_STR_TURNEND_EV("入荷告知", "告知文"), "/", LCOUNT)%
	;日数条件を確認する
	SIF TOINT(AUTO_SPLIT(TEMPS, "_", 1)) <= DAY
		RETURN 1
NEXT
RETURN 0

;====================
;内容
;====================
@TURNEND_EV_1
#DIM LCOUNT
#DIMS TEMPS
#DIM TEMP
FOR LCOUNT, 0, STRCOUNT(GET_STR_TURNEND_EV("入荷告知", "告知文"), "/") + 1
	TEMPS = %AUTO_SPLIT(GET_STR_TURNEND_EV("入荷告知", "告知文"), "/", LCOUNT)%
	IF TOINT(AUTO_SPLIT(TEMPS, "_", 1)) <= DAY
		IF TEMP == 0
			PRINTFORMW ………
			PRINTFORMW ……
			PRINTFORMW …
			PRINTFORMW ＞메일이 도착해 있다
		ENDIF
		TEMP = 1
		;特殊な処置が必要場合
		SELECTCASE AUTO_SPLIT(TEMPS, "_", 2)
			CASE "風花"
				HAVE_RECORD_SKILL_EMULATOR:GET_SKILL_EMULATOR_NUM("오라클") = 1
			CASE "りせ"
				HAVE_RECORD_SKILL_EMULATOR:GET_SKILL_EMULATOR_NUM("치어링") = 1
				HAVE_RECORD_SKILL_EMULATOR:GET_SKILL_EMULATOR_NUM("원기의노래") = 1
		ENDSELECT

		PRINTFORMW %AUTO_SPLIT(TEMPS, "_", 0)%
		CALL SET_STR_TURNEND_EV, "入荷告知", "告知文", DEL_SPLIT(GET_STR_TURNEND_EV("入荷告知", "告知文"), "/", TEMPS)
	ENDIF
NEXT
RETURN TEMP
