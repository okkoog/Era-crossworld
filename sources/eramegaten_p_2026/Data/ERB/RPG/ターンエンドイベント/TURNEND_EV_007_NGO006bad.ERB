;====================
;定義名
;====================
@TURNEND_EV_NAME_7
RESULTS = NGOバッドエンド

;====================
;条件
;====================
@PLAYABLE_TURNEND_EV_7
#DIM TENCHAN
SIF FINDCHARA_B([[キャラ:초텐짱]]) == -1
	RETURN 0
TENCHAN = RESULT:1
SIF 依頼フラグ:[[依頼:NGO의뢰]]:0 == 99
	RETURN 0
SIF 陥落(TENCHAN) == 0
	RETURN 0
SIF DAY > 50
	RETURN 1

;====================
;内容
;====================
@TURNEND_EV_7
#DIM LCOUNT
#DIMS L_ANGEL_COMMENT, 3
#DIMS L_COMMENT, 45
#DIM TENCHAN
TENCHAN = GETCHARA([[キャラ:초텐짱]])

REDRAW 0
PRINTFORMW ………
PRINTFORMW ……
PRINTFORMW …
FOR LCOUNT, 0, 15
	SETFONT 
NEXT
IF 依頼フラグ:[[依頼:NGO의뢰]]:0 <= 5;
;NGOルート陥落前
	PRINTFORML 
	PRINTFORMW ＞덜컥！
	PRINTFORMW 돌연, 당신의 방 입구가 열렸다。
	PRINTFORMW 무슨 일인가 하고 경계하자, 흑발 트윈테일의 여자, 아메가 서 있었다。
	PRINTFORML 
	FORCEWAIT
	PRINTFORML 
	PRINTFORMW 「꺾였어」
	PRINTFORML 
	PRINTFORMW ……뭐가？
	PRINTFORML 
	PRINTFORMW 「별로」
	PRINTFORML 
	PRINTFORMW 아메는 그저 그 말만을 남기고 문도 닫지 않은 채 어디론가 가버렸다。
