#DIM CONST TURNEND_EV_NUM = 10								;イベントの作れる数の上限。超えたら適宜追加してくあさい
#DIMS TURNEND_EV_NAME, TURNEND_EV_NUM

;要素数の定義
#DIM CONST VARSIZE_TURNEND_EV = 10
