;=================================================
;配信用のスキップフラグを折る関数
;配信を実行したら常に終了時にこれを宣言してフラグをおるように
;=================================================
@RESET_SKIP_SUPER_ANGEL_HAISIN
#DIMS L_DUMMY;参照値渡しの仕様上、引数を省略できないので送る
CALL PRINT_SUPER_ANGEL_HAISIN, "RESET_SKIP", L_DUMMY, L_DUMMY

;=================================================
;配信風表示関数
;ARGS 				= メイン画面表示内容(基本的にはアスキーアートを想定)
;L_ANGEL_COMMENT	= 画面下部、配信者のセリフ、参照渡し(配列ごともらってくる)
;L_ANGEL_COMMENT	= 画面右部、コメント欄、　　参照渡し(配列ごともらってくる)
;ANGEL_COLOR		= 色を指定する場合(特殊数値:-1:虹色、-2;虹色アニメ1、-3:虹色アニメ2)
;=================================================
@PRINT_SUPER_ANGEL_HAISIN, ARGS, L_ANGEL_COMMENT, L_COMMENT, ANGEL_COLOR
#DIM L_LINE
#DIM L_RAINBOW_CNT
#DIM SHOW_LINENUM
#DIM LCOUNT, 2
#DIMS REF L_ANGEL_COMMENT
#DIMS REF L_COMMENT
#DIM ANGEL_COLOR
#DIMS ANGEL_COMMENT_COLOR
#DIMS COMMENT_COLOR
#DIMS ANGEL_COMMENT_LINE, 5 
#DIMS AA_STR, 45
#DIMS SHOW_LINE, 45
#DIMS SHOW_COMMENT, 45
#DIM IS_BREAK
#DIM IS_MESSKIP
SELECTCASE ARGS
	CASE "RESET_SKIP"
		IS_MESSKIP = 0
		RETURN 0
ENDSELECT
L_LINE = LINECOUNT
IS_BREAK = 0
WHILE 1
	CLEARLINE LINECOUNT - L_LINE
	CALL SET_VAR_NGO_AA, ARGS, AA_STR, ANGEL_COLOR, L_RAINBOW_CNT
	SHOW_LINENUM = RESULT
	;色の指定部分
	COMMENT_COLOR = %TOSTR_HTML(COLOR("p-blue"))%
	ANGEL_COMMENT_COLOR = %TOSTR_HTML(COLOR("p-blue"))%

	SHOW_COMMENT:0 = <font color = '%COMMENT_COLOR%'>┏━━━━━━━━━━━━┓</font>
	SHOW_COMMENT:1 = <font color = '%COMMENT_COLOR%'>┃시청자 코멘트 　　　　　┃</font>
	SHOW_COMMENT:2 = <font color = '%COMMENT_COLOR%'>┣━━━━━━━━━━━━┫</font>
	SHOW_COMMENT:(SHOW_LINENUM -1) = <font color = '%COMMENT_COLOR%'>┗━━━━━━━━━━━━┛</font>

	FOR LCOUNT, 3, SHOW_LINENUM - 1
		SHOW_COMMENT:LCOUNT = ┃%L_COMMENT:(LCOUNT-3)%%" " * (24 - STRLENS(HTML_TOPLAINTEXT(L_COMMENT:(LCOUNT-3))))%┃
		CALL SET_COLOR_TAG_IN_TAG_CASE, SHOW_COMMENT:LCOUNT, COMMENT_COLOR
		SHOW_COMMENT:LCOUNT = %RESULTS%
	NEXT

	FOR LCOUNT, 0, SHOW_LINENUM
		SHOW_LINE:LCOUNT '= AA_STR:LCOUNT + SHOW_COMMENT:LCOUNT
	NEXT

	ANGEL_COMMENT_LINE:0 = <font color = '%ANGEL_COMMENT_COLOR%'>┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓</font>
	ANGEL_COMMENT_LINE:4 = <font color = '%ANGEL_COMMENT_COLOR%'>┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛</font>

	FOR LCOUNT, 1, VARSIZE("ANGEL_COMMENT_LINE") - 1
		ANGEL_COMMENT_LINE:LCOUNT = ┃%L_ANGEL_COMMENT:(LCOUNT-1)%%" " * (96 - STRLENS(HTML_TOPLAINTEXT(L_ANGEL_COMMENT:(LCOUNT-1))))%┃
		CALL SET_COLOR_TAG_IN_TAG_CASE, ANGEL_COMMENT_LINE:LCOUNT, ANGEL_COMMENT_COLOR
		ANGEL_COMMENT_LINE:LCOUNT = %RESULTS%
	NEXT

	;本表示のときはスペースをいれて調整する
	IF IS_BREAK == 0
		FOR LCOUNT, 0, 50
			PRINTL 
		NEXT
	ENDIF
	FOR LCOUNT, 0, VARSIZE("AA_STR")
		HTML_PRINT SHOW_LINE:LCOUNT
	NEXT
	FOR LCOUNT, 0, VARSIZE("ANGEL_COMMENT_LINE")
		HTML_PRINT ANGEL_COMMENT_LINE:LCOUNT
	NEXT
	SIF IS_BREAK
		BREAK
	IF MESSKIP() || IS_MESSKIP
		RESULT = 1
		REDRAW 2
	ELSE
		INPUTMOUSEKEY  100
	ENDIF
	IF RESULT < 4
		IS_BREAK = 1
		SIF RESULT == 1 && RESULT:1 == 0x200000
			IS_MESSKIP = 1
	ELSE
		L_RAINBOW_CNT++
		L_RAINBOW_CNT %= 12
	ENDIF
WEND

