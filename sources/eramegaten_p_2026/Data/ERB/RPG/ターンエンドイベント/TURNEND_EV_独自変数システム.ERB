;==========================================================
;@SET_SKILL_EMULATOR_VAR
;#FUNCTION内でTRYをしないように済ますために変数として取得させておくための変数
;==========================================================
@SET_TURNEND_EV_VAR
#DIM LCOUNT, 2
FOR LCOUNT, 0, TURNEND_EV_NUM
	TRYCCALLFORM TURNEND_EV_NAME_{LCOUNT}
		TURNEND_EV_NAME:LCOUNT = %RESULTS%
	CATCH
		BREAK
	ENDCATCH
	VARSET RESULTS, "", 0, VARSIZE_TURNEND_EV
	TRYCCALLFORM TURNEND_EV_FLAGNAME_{LCOUNT}
		FOR LCOUNT:1, 0, VARSIZE_TURNEND_EV
			TURNEND_EV_FLAGNAME:LCOUNT:(LCOUNT:1) = %RESULTS:(LCOUNT:1)%
		NEXT
	CATCH
	ENDCATCH
	VARSET RESULTS, "", 0, VARSIZE_TURNEND_EV_STR
	TRYCCALLFORM TURNEND_EV_STRNAME_{LCOUNT}
		FOR LCOUNT:1, 0, VARSIZE_TURNEND_EV_STR
			TURNEND_EV_STRNAME:LCOUNT:(LCOUNT:1) = %RESULTS:(LCOUNT:1)%
		NEXT
	CATCH
	ENDCATCH
	VARSET RESULTS, "", 0, VARSIZE_TURNEND_EV_TAKEOVER
	TRYCCALLFORM TURNEND_EV_TAKEOVER_FLAGNAME_{LCOUNT}
		FOR LCOUNT:1, 0, VARSIZE_TURNEND_EV_TAKEOVER
			TURNEND_EV_FLAGNAME_TAKEOVER:LCOUNT:(LCOUNT:1) = %RESULTS:(LCOUNT:1)%
		NEXT
	CATCH
	ENDCATCH
	VARSET RESULTS, "", 0, VARSIZE_TURNEND_EV_STR_TAKEOVER
	TRYCCALLFORM TURNEND_EV_TAKEOVER_STRNAME_{LCOUNT}
		FOR LCOUNT:1, 0, VARSIZE_TURNEND_EV_STR_TAKEOVER
			TURNEND_EV_STRNAME_TAKEOVER:LCOUNT:(LCOUNT:1) = %RESULTS:(LCOUNT:1)%
		NEXT
	CATCH
	ENDCATCH
NEXT

;==========================================================
;@GET_TURNEND_EV
;番号からイベントの名称を返す
;==========================================================
@GET_TURNEND_EV_NAME, ARG
#FUNCTIONS
RETURNF TURNEND_EV_NAME:ARG

;==========================================================
;@GET_TURNEND_EV_NUM
;名称からイベントの番号を返す (한/일 상호 호환 별칭 매핑)
;==========================================================
@GET_TURNEND_EV_NUM, ARGS
#FUNCTION
#DIM L_RESULT
L_RESULT = FINDELEMENT(TURNEND_EV_NAME, ARGS, , , 1)
SIF L_RESULT >= 0
	RETURNF L_RESULT
SELECTCASE ARGS
	CASE "絶縁状", "절연장"
		RETURNF FINDELEMENT(TURNEND_EV_NAME, "絶縁状", , , 1)
	CASE "入荷告知", "입고고지", "입고 고지", "입하고지", "입하 고지"
		RETURNF FINDELEMENT(TURNEND_EV_NAME, "入荷告知", , , 1)
	CASE "NGOターンエンド１", "NGO 턴엔드 1", "NGO턴엔드1"
		RETURNF FINDELEMENT(TURNEND_EV_NAME, "NGOターンエンド１", , , 1)
	CASE "NGOターンエンド２", "NGO 턴엔드 2", "NGO턴엔드2"
		RETURNF FINDELEMENT(TURNEND_EV_NAME, "NGOターンエンド２", , , 1)
	CASE "NGO_TURNEND_EV"
		RETURNF FINDELEMENT(TURNEND_EV_NAME, "NGO_TURNEND_EV", , , 1)
	CASE "てんちゃん崩壊４０４", "텐짱 붕괴 404", "텐짱붕괴404", "텐쨩 붕괴 404", "텐쨩붕괴404"
		RETURNF FINDELEMENT(TURNEND_EV_NAME, "てんちゃん崩壊４０４", , , 1)
	CASE "NGO陥落予報", "NGO 함락 예보", "NGO함락예보"
		RETURNF FINDELEMENT(TURNEND_EV_NAME, "NGO陥落予報", , , 1)
	CASE "NGOバッドエンド", "NGO 배드엔드", "NGO배드엔드"
		RETURNF FINDELEMENT(TURNEND_EV_NAME, "NGOバッドエンド", , , 1)
	CASE "聖華学園調査報告", "세이카학원조사보고", "세이카 학원 조사 보고"
		RETURNF FINDELEMENT(TURNEND_EV_NAME, "聖華学園調査報告", , , 1)
	CASE "ソロモンの結婚指輪", "솔로몬의 결혼 반지", "솔로몬의결혼반지"
		RETURNF FINDELEMENT(TURNEND_EV_NAME, "ソロモンの結婚指輪", , , 1)
ENDSELECT
RETURNF -1

;==========================================================
;@IS_MATCH_TURNEND_EV_FLAGNAME
;플래그 명칭의 한국어/일본어 상호 호환 매칭 함수
;==========================================================
@IS_MATCH_TURNEND_EV_FLAGNAME, ARGS, ARGS:1
#FUNCTION
SIF ARGS == ARGS:1
	RETURNF 1
SELECTCASE ARGS:1
	CASE "絶縁", "절연"
		SIF GROUPMATCH(ARGS, "絶縁", "절연")
			RETURNF 1
	CASE "絶縁済み", "절연 완료", "절연완료"
		SIF GROUPMATCH(ARGS, "絶縁済み", "절연 완료", "절연완료")
			RETURNF 1
	CASE "警告", "경고"
		SIF GROUPMATCH(ARGS, "警告", "경고")
			RETURNF 1
	CASE "警告済み", "경고 완료", "경고완료"
		SIF GROUPMATCH(ARGS, "警告済み", "경고 완료", "경고완료")
			RETURNF 1
	CASE "イベント進度", "이벤트 진도", "이벤트진도"
		SIF GROUPMATCH(ARGS, "イベント進度", "이벤트 진도", "이벤트진도")
			RETURNF 1
	CASE "アルタ開始日", "알타 시작일", "알타시작일"
		SIF GROUPMATCH(ARGS, "アルタ開始日", "알타 시작일", "알타시작일")
			RETURNF 1
	CASE "リンゴバトル１", "링고 배틀 1", "링고배틀1"
		SIF GROUPMATCH(ARGS, "リンゴバトル１", "링고 배틀 1", "링고배틀1")
			RETURNF 1
	CASE "フィグバトル１", "피그 배틀 1", "피그배틀1"
		SIF GROUPMATCH(ARGS, "フィグバトル１", "피그 배틀 1", "피그배틀1")
			RETURNF 1
	CASE "告知文", "고지문"
		SIF GROUPMATCH(ARGS, "告知文", "고지문")
			RETURNF 1
ENDSELECT
RETURNF 0

;==========================================================
;個別フラグのセッター/ゲッター
;==========================================================
;-----------------------------------------------------
;セット関数
;SET_RPG_CFLAG_XX のXXの部分にEV・TAKEOVER、BTL, DUNGEONをいれて変数指定
;ARG = キャラ番号
;ARGS = フラグ名
;ARG:1 = 計算に使う数値　デフォルトでは代入
;ARGS:1 = "=, +=, -=, *=, /="  左の文字列を指定することで四則演算をさせられます
;
;式中関数版を通過しているのはデバッグコンソールから直接操作をするためです
;SET_RPG_CFLAG_EV_F(TARGET, "test")のように使ってください
;-----------------------------------------------------
@SET_FLAG_TURNEND_EV, ARGS, ARGS:1, ARG, ARGS:2 = "SET"
CALLFORMF SET_FLAG_TURNEND_EV_F, ARGS, ARGS:1, ARG, ARGS:2

@SET_FLAG_TURNEND_EV_F, ARGS, ARGS:1, ARG, ARGS:2 = "SET"
#FUNCTION
CALLFORMF SET_TURNEND_EV_F, ARGS, ARGS:1, ARG, "TURNEND_EV", ARGS:2

;-----------------------------------------------------
@SET_FLAG_TURNEND_EV_TAKEOVER, ARGS, ARGS:1, ARG, ARGS:2 = "SET"
CALLFORMF SET_FLAG_TURNEND_EV_TAKEOVER_F, ARGS, ARGS:1, ARG, ARGS:2

@SET_FLAG_TURNEND_EV_TAKEOVER_F, ARGS, ARGS:1, ARG, ARGS:2 = "SET"
#FUNCTION
CALLFORMF SET_TURNEND_EV_F, ARGS, ARGS:1, ARG, "TURNEND_EV_TAKEOVER", ARGS:2

;-----------------------------------------------------
;本体
;-----------------------------------------------------
@SET_TURNEND_EV_F, ARGS, ARGS:1, ARG, ARGS:2, ARGS:3 = "SET"
#FUNCTION
#DIM LCOUNT
#DIM EV_NUM
#DIM L_VARSIZE
EV_NUM = GET_TURNEND_EV_NUM(ARGS)
SIF EV_NUM < 0
	RETURNF 0
SELECTCASE ARGS:2
	CASE "TURNEND_EV"
		L_VARSIZE = VARSIZE_TURNEND_EV
	CASE "TURNEND_EV_TAKEOVER"
		L_VARSIZE = VARSIZE_TURNEND_EV_TAKEOVER
ENDSELECT
FOR LCOUNT, 0, L_VARSIZE
	SELECTCASE ARGS:2
		CASE "TURNEND_EV"
			SIF !IS_MATCH_TURNEND_EV_FLAGNAME(TURNEND_EV_FLAGNAME:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			SELECTCASE ARGS:3
				CASE "SET", "="
					TURNEND_EV:EV_NUM:LCOUNT = ARG
				CASE "ADD", "+", "+="
					TURNEND_EV:EV_NUM:LCOUNT += ARG
				CASE "SUB", "SUBTRACITON", "-", "-="
					TURNEND_EV:EV_NUM:LCOUNT -= ARG
				CASE "MUL", "MULTI", "*", "*="
					TURNEND_EV:EV_NUM:LCOUNT *= ARG
				CASE "DIV", "DIVISION", "/", "/="
					TURNEND_EV:EV_NUM:LCOUNT /= ARG
			ENDSELECT
		CASE "TURNEND_EV_TAKEOVER"
			SIF !IS_MATCH_TURNEND_EV_FLAGNAME(TURNEND_EV_FLAGNAME_TAKEOVER:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			SELECTCASE ARGS:3
				CASE "SET", "="
					TURNEND_EV_TAKEOVER:EV_NUM:LCOUNT = ARG
				CASE "ADD", "+", "+="
					TURNEND_EV_TAKEOVER:EV_NUM:LCOUNT += ARG
				CASE "SUB", "SUBTRACITON", "-", "-="
					TURNEND_EV_TAKEOVER:EV_NUM:LCOUNT -= ARG
				CASE "MUL", "MULTI", "*", "*="
					TURNEND_EV_TAKEOVER:EV_NUM:LCOUNT *= ARG
				CASE "DIV", "DIVISION", "/", "/="
					TURNEND_EV_TAKEOVER:EV_NUM:LCOUNT /= ARG
			ENDSELECT
	ENDSELECT
	RETURNF 1
NEXT
RETURNF 0

@GET_TURNEND_EV_F, ARGS, ARGS:1, ARGS:2
#FUNCTION
#DIM LCOUNT
#DIM EV_NUM
#DIM L_VARSIZE
EV_NUM = GET_TURNEND_EV_NUM(ARGS)
SIF EV_NUM < 0
	RETURNF 0
SELECTCASE ARGS:2
	CASE "TURNEND_EV"
		L_VARSIZE = VARSIZE_TURNEND_EV
	CASE "TURNEND_EV_TAKEOVER"
		L_VARSIZE = VARSIZE_TURNEND_EV_TAKEOVER
ENDSELECT
FOR LCOUNT, 0, L_VARSIZE
	SELECTCASE ARGS:2
		CASE "TURNEND_EV"
			SIF !IS_MATCH_TURNEND_EV_FLAGNAME(TURNEND_EV_FLAGNAME:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			RETURNF TURNEND_EV:EV_NUM:LCOUNT
		CASE "TURNEND_EV_TAKEOVER"
			SIF !IS_MATCH_TURNEND_EV_FLAGNAME(TURNEND_EV_FLAGNAME_TAKEOVER:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			RETURNF TURNEND_EV_TAKEOVER:EV_NUM:LCOUNT
	ENDSELECT
NEXT
RETURNF 0

@GET_FLAG_TURNEND_EV, ARGS, ARGS:1
#FUNCTION
RETURNF GET_TURNEND_EV_F(ARGS, ARGS:1, "TURNEND_EV")

@GET_FLAG_TURNEND_EV_TAKEOVER, ARGS, ARGS:1
#FUNCTION
RETURNF GET_TURNEND_EV_F(ARGS, ARGS:1, "TURNEND_EV_TAKEOVER")
;============================================================================

@SET_STR_TURNEND_EV, ARGS, ARGS:1, ARGS:2, ARGS:3 = "SET"
CALLFORMF SET_STR_TURNEND_EV_F, ARGS, ARGS:1, ARGS:2, ARGS:3

@SET_STR_TURNEND_EV_F, ARGS, ARGS:1, ARGS:2, ARGS:3 = "SET"
#FUNCTION
CALLFORMF SETS_TURNEND_EV_F, ARGS, ARGS:1, ARGS:2, "TURNEND_EV_STR", ARGS:3

;-----------------------------------------------------
@SET_STR_TURNEND_EV_TAKEOVER, ARGS, ARGS:1, ARGS:2, ARGS:3 = "SET"
CALLFORMF SET_STR_TURNEND_EV_TAKEOVER_F, ARGS, ARGS:1, ARGS:2, ARGS:3

@SET_STR_TURNEND_EV_TAKEOVER_F, ARGS, ARGS:1, ARGS:2, ARGS:3 = "SET"
#FUNCTION
CALLFORMF SETS_TURNEND_EV_F, ARGS, ARGS:1, ARGS:2, "TURNEND_EV_STR_TAKEOVER", ARGS:3
;-----------------------------------------------------

@SETS_TURNEND_EV_F, ARGS, ARGS:1, ARGS:2, ARGS:3, ARGS:4 = "SET"
#FUNCTION
#DIM LCOUNT
#DIM EV_NUM
#DIM L_VARSIZE
EV_NUM = GET_TURNEND_EV_NUM(ARGS)
SIF EV_NUM < 0
	RETURNF 0
SELECTCASE ARGS:3
	CASE "TURNEND_EV_STR"
		L_VARSIZE = VARSIZE_TURNEND_EV_STR
	CASE "TURNEND_EV_STR_TAKEOVER"
		L_VARSIZE = VARSIZE_TURNEND_EV_STR_TAKEOVER
ENDSELECT
FOR LCOUNT, 0, L_VARSIZE
	SELECTCASE ARGS:3
		CASE "TURNEND_EV_STR"
			SIF !IS_MATCH_TURNEND_EV_FLAGNAME(TURNEND_EV_STRNAME:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			SELECTCASE ARGS:4
				CASE "SET", "="
					TURNEND_EV_STR:EV_NUM:LCOUNT = %ARGS:2%
				CASE "ADD", "+", "+="
					TURNEND_EV_STR:EV_NUM:LCOUNT += ARGS:2
			ENDSELECT
		CASE "TURNEND_EV_STR_TAKEOVER"
			SIF !IS_MATCH_TURNEND_EV_FLAGNAME(TURNEND_EV_STRNAME_TAKEOVER:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			SELECTCASE ARGS:4
				CASE "SET", "="
					TURNEND_EV_STR_TAKEOVER:EV_NUM:LCOUNT = %ARGS:2%
				CASE "ADD", "+", "+="
					TURNEND_EV_STR_TAKEOVER:EV_NUM:LCOUNT += ARGS:2
			ENDSELECT
	ENDSELECT
	RETURNF 1
NEXT
RETURNF 0

@GETS_TURNEND_EV_F, ARGS, ARGS:1, ARGS:2
#FUNCTIONS
#DIM LCOUNT
#DIM EV_NUM
#DIM L_VARSIZE
EV_NUM = GET_TURNEND_EV_NUM(ARGS)
SIF EV_NUM < 0
	RETURNF ""
SELECTCASE ARGS:2
	CASE "TURNEND_EV_STR"
		L_VARSIZE = VARSIZE_TURNEND_EV_STR
	CASE "TURNEND_EV_STR_TAKEOVER"
		L_VARSIZE = VARSIZE_TURNEND_EV_STR_TAKEOVER
ENDSELECT
FOR LCOUNT, 0, L_VARSIZE
	SELECTCASE ARGS:2
		CASE "TURNEND_EV_STR"
			SIF !IS_MATCH_TURNEND_EV_FLAGNAME(TURNEND_EV_STRNAME:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			RETURNF TURNEND_EV_STR:EV_NUM:LCOUNT
		CASE "TURNEND_EV_STR_TAKEOVER"
			SIF !IS_MATCH_TURNEND_EV_FLAGNAME(TURNEND_EV_STRNAME_TAKEOVER:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			RETURNF TURNEND_EV_STR_TAKEOVER:EV_NUM:LCOUNT
	ENDSELECT
NEXT
RETURNF ""

@GET_STR_TURNEND_EV, ARGS, ARGS:1
#FUNCTIONS
RETURNF GETS_TURNEND_EV_F(ARGS, ARGS:1, "TURNEND_EV_STR")

@GET_STR_TURNEND_EV_TAKEOVER, ARGS, ARGS:1
#FUNCTIONS
RETURNF GETS_TURNEND_EV_F(ARGS, ARGS:1, "TURNEND_EV_STR_TAKEOVER")
