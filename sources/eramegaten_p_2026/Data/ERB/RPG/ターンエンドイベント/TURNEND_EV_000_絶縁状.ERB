;====================
;定義名
;====================
@TURNEND_EV_NAME_0
RESULTS = 絶縁状

;====================
;条件
;====================
@PLAYABLE_TURNEND_EV_0
;SIF TIME != 3
;	RETURN 0
SIF !FLAG:턴이행시
	RETURN 0
SIF GET_FLAG_TURNEND_EV("絶縁状", "絶縁済み")
	RETURN 0
;LLに偏ってるか、あるいは品川でハニエルに協力した場合は絶縁状が来る
IF ((CFLAG:MASTER:선악치 + CFLAG:MASTER:질혼치 > 340) || ダンジョンフラグ:[[ダンジョン:시나가와]]:2 == 1) && (FLAG:나오야루트 > 3 || FLAG:나오야루트 < 0)
	CALL SET_FLAG_TURNEND_EV, "絶縁状", "絶縁" , 1
	RETURN 1
ELSE
	SIF !FLAG:나오야루트
		RETURN 0
	SIF GET_FLAG_TURNEND_EV("絶縁状", "警告")
		RETURN 0
	SIF CFLAG:MASTER:선악치 + CFLAG:MASTER:질혼치 < 276
		RETURN 0
	CALL SET_FLAG_TURNEND_EV, "絶縁状", "警告" , 1
	RETURN 1
ENDIF
RETURN 0

;====================
;内容
;====================
@TURNEND_EV_0
IF GET_FLAG_TURNEND_EV("絶縁状", "絶縁")
	PRINTFORMW ………
	PRINTFORMW ……
	PRINTFORMW …
	PRINTFORMW ＞나오야에게서 메일이 와 있다…
	PRINTL 
	PRINTW ＞네놈에게는 실망했다
	PRINTW ＞정의나 규율 같은 속임수에 매달리는 인간이
	PRINTW ＞신을 쳐부술 마왕이 될 수 있을 리가 없지
	PRINTW ＞따라서, 이 일은 끝이다
	PRINTW ＞【바・벨】은 회수해 가겠다
	PRINTW ＞나머지는 네 좋을 대로 해라
	PRINTL 
	PRINTW ＞COMP를 체크해보니, 【바・벨】이 사라져 있다…
	PRINTW ＞아무래도 해킹을 당한 것 같다…
	PRINTW ＞다른 피해는 없는 모양이지만…
	HAVE_INSTALLSOFT:GET_INSTALLSOFT_NUM("바・벨") = 0
	EQUIP_INSTALLSOFT:GET_INSTALLSOFT_NUM("바・벨") = 0
	CALL SET_FLAG_TURNEND_EV, "絶縁状", "絶縁済み" , 1
	FLAG:나오야루트 = -1 * ABS(FLAG:나오야루트)
	PRINTL 
ELSE
	PRINTFORMW ………
	PRINTFORMW ……
	PRINTFORMW …
	PRINTFORMW ＞나오야에게서 메일이 왔다。
	PRINTL 
	PRINTW ＞나는 네게, 앞으로 나아갈 길은 신에게 맞서는 길이라고 분명 전했을 터다
	PRINTW ＞정의나 질서 따위 결국엔 환상이다
	PRINTW ＞그런 것에 매달린다는 것은 요컨대 신의 하수인 노릇에 만족한다는 뜻이다
	PRINTW ＞진정으로 인류를 생각한다면, 신은 쓰러뜨리는 수밖에 없다
	PRINTW ＞질서를 파괴하고, 혼돈을 갈구해라
	PRINTW ＞선인인 척하는 짓은 그만두고, 악이 되는 것을 두려워 마라
	PRINTW ＞네겐 힘과 재능이 있다
	PRINTW ＞그 올바른 사용법을 잘 생각해 봐라
	CALL SET_FLAG_TURNEND_EV, "絶縁状", "警告済み" , 1
	PRINTL 
ENDIF
RETURN 1

