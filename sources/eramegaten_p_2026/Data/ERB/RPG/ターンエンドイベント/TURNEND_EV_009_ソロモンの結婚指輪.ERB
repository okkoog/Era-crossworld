;====================
;定義名
;====================
@TURNEND_EV_NAME_9
RESULTS = ソロモンの結婚指輪

;====================
;条件
;====================
@PLAYABLE_TURNEND_EV_9
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC 契約人数
SIF ITEM:플러그인／솔로몬의결혼반지
	RETURN 0
FOR LCOUNT, 0, CHARANUM
	SIF !INRANGE(계약(LCOUNT), 1, 3)
		CONTINUE
	SIF ++契約人数 >= 10
		RETURN 1
NEXT
RETURN 0

;====================
;内容
;====================
@TURNEND_EV_9
CALL SHOW_PICTURE, "NONFLOORD", "街中"
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "",  @"………………/…………/……", , , , 88, 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "이상한 남자",  @"호오… 그대도 악마술사인 모양이로군…", , , , 88, 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "",  @"＞거리를 걷고 있자 수상한 남자가 말을 걸어왔다/＞눈앞의 남자도 서머너인 듯하며, 게다가 심상치 않은 기운이 느껴진다。/＞하지만, 상대에게서 적대적인 기운은 느껴지지 않는다。", , , , 88, 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "이상한 남자",  @"악마를 지혜롭게 사역한다면, 많은 일을 이룰 수 있다/그야말로, 한 나라를 번영시키는 것 따위 손쉬운 일이지…", , , , 88, 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "이상한 남자",  @"＞그대는 동료마와 강한 유대를 맺고 있는 모양이군, 그 유대에 조금이나마 힘을 보태주마", , , , 88, 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "",  @"＞플러그인: 솔로몬의 결혼반지를 손에 넣었다。", , , , 88, 4
CALL MESSAGE_WINDOW_ICON, , "BLANK", "", "이상한 남자",  @"허나 조심하도록 해라。아내를 수백 명씩 두거나 하면 나라를 분열시키는 꼴을 보게 될 테니 말이다…", , , , 88, 4
CALL GET_ITEMS, "플러그인／솔로몬의결혼반지", 1
