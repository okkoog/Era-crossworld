$INPUT_POSITION_LOOP
INPUT
IF RESULT == 0
	RETURN -1
ELSEIF ((CFLAG:(ARG):포지션 == 1) && (RESULT == 4 || RESULT == 2 )) || ((CFLAG:(ARG):포지션 == 2) && (RESULT == 5 || RESULT == 1 || RESULT == 3)) || ((CFLAG:(ARG):포지션 == 3) && (RESULT == 2 || RESULT == 6 )) || ((CFLAG:(ARG):포지션 == 4) && (RESULT == 1 || RESULT == 5 )) || ((CFLAG:(ARG):포지션 == 5) && (RESULT == 4 || RESULT == 2 || RESULT == 6)) || ((CFLAG:(ARG):포지션 == 6) && (RESULT == 5 || RESULT == 3 ))
	SIF POS(RESULT) > -1 && (CFLAG:POS(RESULT):링케이지참가 || CFLAG:POS(RESULT):링케이지발동)
		GOTO INPUT_POSITION_LOOP
	
	CFLAG:(ARG):타겟 = RESULT
	CFLAG:(ARG):입력행동 = [[스킬:ＣＨＡＮＧＥ]]
	LOCALS = 포지션{RESULT}
	IF FLAG:LOCALS > -1
		CFLAG:(FLAG:LOCALS):ＣＨＡＮＧＥ대상플래그 = 1
	ENDIF
	CFLAG:(ARG):방어플래그 = 0
ELSE
	GOTO INPUT_POSITION_LOOP
ENDIF
RETURN 1

;---------------------------------------------------
;メンバーと控えとの交代が発生した時の処理
;---------------------------------------------------
@SKILL_ACTION_AT_SWITCHING, L_SWITCHING_CHARA, L_SUMMON_CHARA
#DIM DYNAMIC L_SWITCHING_CHARA	;交代でさがるキャラ
#DIM DYNAMIC L_SUMMON_CHARA		;交代で戦闘参加するキャラ
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC TEMP_SKILL
#DIM DYNAMIC L_TRYSKILL_VAR
#DIMS DYNAMIC L_TRYSKILL_STR
#DIM DYNAMIC SKILLCOUNT
#DIMS DYNAMIC STOCK_SKILL, 2
#DIMS DYNAMIC C_STOCK_SKILL
;交代したキャラがいない場合
SIF L_SWITCHING_CHARA < 0
	RETURN 0
FOR SKILLCOUNT, 0, TRYSKILLNUM(L_SWITCHING_CHARA)
	RESULT = 0
	;---- EDIT 004 MOD START -------------------------
	TEMP_SKILL = %GET_TRYSKILL(L_SWITCHING_CHARA, SKILLCOUNT)%
	;---- EDIT 004 MOD END ---------------------------
	L_TRYSKILL_VAR = TRYSKILL_VAR
	L_TRYSKILL_STR = %TRYSKILL_STR%
	;通常スキルは専用技かどうか確認し、変数を差し替える
	IF GROUPMATCH(L_TRYSKILL_STR, "SKILL", "EQUIP")
		SIF IS_PU_SKILLNUM(TOINT(TEMP_SKILL))
			TEMP_SKILL = %GET_PU_SKILL_CSTR(L_SWITCHING_CHARA, TOINT(TEMP_SKILL) - [[스킬:전용기1]] + 1)%
	ENDIF
	;同一スキルを複数持っている場合、発動させない
	SIF COUNT_SPLIT(C_STOCK_SKILL, "/", TEMP_SKILL)
		CONTINUE
	TRYCALLFORM SKILL_ACTION_AT_SWITCHING_%TEMP_SKILL%, L_SWITCHING_CHARA, L_SUMMON_CHARA
NEXT

