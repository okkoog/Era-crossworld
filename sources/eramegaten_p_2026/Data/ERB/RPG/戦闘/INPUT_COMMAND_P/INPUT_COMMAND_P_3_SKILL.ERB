
;=================================================
;入力結果：ＥＸＴＲＡ/ＭＡＧＩＣ及び他スキル
;ARG = 	キャラ登録番号
;=================================================
@INPUT_COM_NAME_COM_3,ARG
RESULTS = SKILL
IF GET_ROLE_PROP("CAN_USE_SKILL", ARG)
	RESULTS:1 = ＳＫＩＬＬ
ELSE
	RESULTS:1 = Ｃ - ＳＫＩＬＬ
ENDIF
RETURN 0

@INPUT_COM_ABLE_SKILL,ARG
SIF !(GET_ROLE_PROP("CAN_USE_SKILL", ARG) || C_COMMANDER_SKILL:ARG:0)
	RETURN 0
CALL CAN_USE_SKILL, ARG
SIF RESULT == 0
	RETURN -1
RETURN 1

@INPUT_COM_SKILL, ARG, ARG:1 = -1
#DIM DYNAMIC L_SKILL
#DIM DYNAMIC L_TARGET
;スキル使用者を一文字関数Uに入れておく
U = ARG
IF GET_ROLE_PROP("CAN_USE_SKILL", ARG)
	CALL INPUT_COM_DO_SKILL, ARG, , , ARG:1
ELSE
	CALL INPUT_COM_DO_SKILL, ARG, "CS", , ARG:1
ENDIF
SIF RESULT <= 0
	RETURN RESULT
L_SKILL = RESULT
L_TARGET = RESULT:1

CALL GET_SKILL_PROP, "SKILL_QUICK_ACTION", L_SKILL, ARG
IF RESULT > 0
	CALL ACT_SKILL_QUICK, ARG, L_SKILL, L_TARGET
ELSE
	CFLAG:ARG:입력행동 = L_SKILL
	CFLAG:ARG:타겟 = L_TARGET
	CFLAG:ARG:방어플래그 = 0
	CALL SET_REPEAT_CHARA, ARG, L_SKILL, L_TARGET
ENDIF
RETURN 1

@ACT_SKILL_QUICK, L_CHARA, L_SKILL, L_TARGET, L_NOHAVE_ACT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_SKILL
#DIM DYNAMIC L_TARGET
#DIMS DYNAMIC L_NOHAVE_ACT
#DIM DYNAMIC STOCK_ACT
#DIMS DYNAMIC STOCK_NOHAVE_ACT
#DIM DYNAMIC STOCK_TARGET

STOCK_ACT = CFLAG:L_CHARA:입력행동
STOCK_NOHAVE_ACT '= CSTR:L_CHARA:비소지스킬
STOCK_TARGET = CFLAG:L_CHARA:타겟
FLAG:행동순1 = L_CHARA
CFLAG:L_CHARA:입력행동 = L_SKILL
CFLAG:L_CHARA:타겟 = L_TARGET
CSTR:L_CHARA:비소지스킬 '= L_NOHAVE_ACT
;アクションの実行
CALL PRINT_ACT_MESSAGE, L_CHARA, L_SKILL
CALL BATTLE_ACTSTART, L_CHARA
CALL BATTLE_SKILLEND, L_CHARA
CALL BATTLE_ACTEND, L_CHARA
FLAG:행동순1 = -1
CFLAG:L_CHARA:입력행동 = STOCK_ACT
CFLAG:L_CHARA:타겟 = STOCK_TARGET
CSTR:L_CHARA:비소지스킬 '= STOCK_NOHAVE_ACT
RETURN 1