;=================================================
;入力結果：ＷＡＩＴ
;=================================================
@INPUT_COM_NAME_COM_43,ARG
RESULTS = WAIT
IF CFLAG:ARG:오토웨이트
	RESULTS:1 = ＡＵＴＯ－ＷＡＩＴ解除
ELSE
	RESULTS:1 = ＷＡＩＴ
ENDIF
RETURN 2
@INPUT_COM_ABLE_WAIT,ARG
SIF !TALENT:ARG:식노
	RETURN 0
SIF !CFLAG:ARG:악마변신
	RETURN 0
SIF CFLAG:ARG:오토웨이트
	RETURN 1
SIF CFLAG:ARG:롱기누스
	RETURN -1
SIF MAXARRAY(CFLAG:ARG:0, GETNUM(CFLAG, "검격웨이트"),  GETNUM(CFLAG, "검격웨이트") + TYPENUM) > 0
	RETURN -1
SIF CFLAG:ARG:어택커 >= 0
	RETURN -1
RETURN 1

@INPUT_COM_WAIT,ARG,ARG:1 = 0
#DIM SKILL
#DIM 装備スキル有無
#DIM ブレイク解除MP
#DIM リフレクト解除MP
#DIM ドレイン解除MP
#DIM 設定中ウェイト
#DIM SET_WAIT
#DIM A_WAIT
#LOCALSIZE 9
LOCAL:1 = 0
LOCAL:3 = LINECOUNT
A_WAIT = 0
IF ARG:1 == 1
	A_WAIT = 2
ELSE
	IF CFLAG:ARG:오토웨이트
		PRINTL 오토 웨이트를 해제하시겠습니까?
		PRINTL [0] 해제한다
		PRINTL [1] 해제하지 않는다
		CALL INPUTINT,0,1
		SIF RESULT == 0
			CFLAG:ARG:오토웨이트 = 0
		RETURN -1
	ENDIF
ENDIF
$START
LOCAL:5 = 0
;消費コスト計算
LOCAL:1 = 0
FOR LOCAL, 0, TYPENUM
	SIF !CFLAG:ARG:(GET_TYPE(LOCAL)+"웨이트")
		 CONTINUE
	LOCAL:1++
	;係数はブレイク2,リフレクト3,ドレイン4 で1:1.5:2にする
	LOCAL:5 += CFLAG:ARG:(GET_TYPE(LOCAL)+"웨이트") + 1
NEXT
;アタッカは2
IF CFLAG:ARG:어택커 >= 0
	LOCAL:1++
	LOCAL:5 += 2
ENDIF
;先に消費経験値測定用に次にウェイトスキルを使った場合のＭＰを出す
LOCAL:6 = (LOCAL:5+2) * (LOCAL:1 + 1) * MAX(1, MAXBASE:ARG:ＭＰ / 100)
LOCAL:7 = (LOCAL:5+3) * (LOCAL:1 + 1) * MAX(1, MAXBASE:ARG:ＭＰ / 100)
LOCAL:8 = (LOCAL:5+4) * (LOCAL:1 + 1) * MAX(1, MAXBASE:ARG:ＭＰ / 100)

;次にウェイトスキルを外した場合のＭＰ計算を追加
ブレイク解除MP = (LOCAL:5-2) * (LOCAL:1 - 1) * MAX(1, MAXBASE:ARG:ＭＰ / 100)
リフレクト解除MP = (LOCAL:5-3) * (LOCAL:1 - 1) * MAX(1, MAXBASE:ARG:ＭＰ / 100)
ドレイン解除MP = (LOCAL:5-4) * (LOCAL:1 - 1) * MAX(1, MAXBASE:ARG:ＭＰ / 100)

LOCAL:5 = LOCAL:5 * LOCAL:1 * MAX(1, MAXBASE:ARG:ＭＰ / 100)
LOCAL:6 -= LOCAL:5
LOCAL:7 -= LOCAL:5
LOCAL:8 -= LOCAL:5

ブレイク解除MP -= LOCAL:5
リフレクト解除MP -= LOCAL:5
ドレイン解除MP -= LOCAL:5

CLEARLINE LINECOUNT - LOCAL:3
DRAWLINE
PRINTFORML ＭＰ[{BASE:ARG:ＭＰ}/{MAXBASE:ARG:ＭＰ}]
PRINTFORML 消費　{LOCAL:5}
DRAWLINE
LOCAL:1 = 0
装備スキル有無 = 0
SET_WAIT = 0;037
FOR LOCAL, 1, 42
	LOCAL = LOCAL == FLAG:스킬수 + 1 ? 21 # LOCAL
	SKILL = ABL:ARG:@"\@ LOCAL > 20 ? 장비 # \@스킬{LOCAL > 20 ? LOCAL - 20 # LOCAL}"
	SIF !SKILL && LOCAL > 20
		BREAK
	
	RESULT = 0
	TRYCALLFORM ウェイトスキル_{SKILL}
	SIF !RESULT
		CONTINUE
	
	LOCAL:2 = RESULT
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", SKILL, ARG
	装備スキル有無 = LOCAL > 20
	IF LOCAL:2 == 4	;어택커
		;選択中のアタッカは水色、いずれかのアタッカ選択中で選択中以外のアタッカは灰色
		SIF CFLAG:ARG:어택커 >= 0
			SETCOLOR COLOR("gray")
		IF GET_TYPE_NUM(GET_SUCCESSION(RESULT)) == CFLAG:ARG:어택커
			SETCOLOR COLOR("aqua")
			設定中ウェイト = 1
		ELSE
			設定中ウェイト = 0
		ENDIF
	ELSE
		;同相性のウェイトスキルは1個しか使えない
		SIF CFLAG:ARG:(GET_SUCCESSION(RESULT) + "웨이트") > 0
			SETCOLOR COLOR("gray")
		IF LOCAL:2 == CFLAG:ARG:(GET_SUCCESSION(RESULT) + "웨이트")
			SETCOLOR COLOR("aqua")
			設定中ウェイト = 1
		ELSE
			設定中ウェイト = 0
		ENDIF
	ENDIF
	
	CALL GET_SKILL_PROP, "SKILL_NAME", SKILL, ARG
	IF 設定中ウェイト == 1
		SETBIT SET_WAIT,LOCAL;037
		SELECTCASE LOCAL:2
			CASE 1, 4
				PRINTFORM [{LOCAL, 2}] %RESULTS, 20, LEFT%{ブレイク解除MP, 4}ＭＰ　　\@ LOCAL:1++ & 1 ? \n # \@
			CASE 2
				PRINTFORM [{LOCAL, 2}] %RESULTS, 20, LEFT%{リフレクト解除MP, 4}ＭＰ　　\@ LOCAL:1++ & 1 ? \n # \@
			CASE 3
				PRINTFORM [{LOCAL, 2}] %RESULTS, 20, LEFT%{ドレイン解除MP, 4}ＭＰ　　\@ LOCAL:1++ & 1 ? \n # \@
		ENDSELECT
	ELSE
		SELECTCASE LOCAL:2
			CASE 1, 4
				PRINTFORM [{LOCAL, 2}] %RESULTS, 20, LEFT%{LOCAL:6, 4}ＭＰ　　\@ LOCAL:1++ & 1 ? \n # \@
			CASE 2
				PRINTFORM [{LOCAL, 2}] %RESULTS, 20, LEFT%{LOCAL:7, 4}ＭＰ　　\@ LOCAL:1++ & 1 ? \n # \@
			CASE 3
				PRINTFORM [{LOCAL, 2}] %RESULTS, 20, LEFT%{LOCAL:8, 4}ＭＰ　　\@ LOCAL:1++ & 1 ? \n # \@
		ENDSELECT
	ENDIF
	RESETCOLOR
NEXT
SIF !LINEISEMPTY()
	PRINTL 
DRAWLINE
PRINTFORM [ 0] 決定 [99] AUTO WAIT
;---- EDIT 037 ADD START -------------------------
IF ARG:1 == 1
	PRINT  RESET
ELSEIF A_WAIT
	SETCOLOR COLOR("aqua")
	PRINTFORM 　\@ A_WAIT == 1 ? 전투 중 WAIT 지속 # 다음 전투에도 지속 \@
	RESETCOLOR
ENDIF
INPUT
IF RESULT == 0
	;---- EDIT 037 ADD START -------------------------
	SIF A_WAIT == 2
		SETBIT SET_WAIT,0
	SIF A_WAIT
		CFLAG:ARG:오토웨이트 = SET_WAIT
	SIF ARG:1 == 1
		GOTO RES
	;---- EDIT 037 ADD END   -------------------------
	BASE:ARG:ＭＰ -= LOCAL:5
	RETURN 1
ELSEIF INRANGE(RESULT, 1, FLAG:스킬수)
	SKILL = ABL:ARG:@"스킬{RESULT}"
	RESULT = 0
	TRYCALLFORM ウェイトスキル_{SKILL}
	SIF !RESULT
		GOTO START
	LOCAL:1 = RESULT
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", SKILL, ARG
	SELECTCASE LOCAL:1
		CASE 1
			IF (LOCAL:5 + LOCAL:6 <= BASE:ARG:ＭＰ) && !CFLAG:ARG:(GET_SUCCESSION(RESULT)+"웨이트")
				CFLAG:ARG:(GET_SUCCESSION(RESULT)+"웨이트") = 1
			ELSEIF CFLAG:ARG:(GET_SUCCESSION(RESULT)+"웨이트") == 1
				CFLAG:ARG:(GET_SUCCESSION(RESULT)+"웨이트") = 0
			ENDIF
		CASE 2
			IF (LOCAL:5 + LOCAL:7 <= BASE:ARG:ＭＰ) && !CFLAG:ARG:(GET_SUCCESSION(RESULT)+"웨이트")
				CFLAG:ARG:(GET_SUCCESSION(RESULT)+"웨이트") = 2
			ELSEIF CFLAG:ARG:(GET_SUCCESSION(RESULT)+"웨이트") == 2
				CFLAG:ARG:(GET_SUCCESSION(RESULT)+"웨이트") = 0
			ENDIF
		CASE 3
			IF (LOCAL:5 + LOCAL:8 <= BASE:ARG:ＭＰ) && !CFLAG:ARG:(GET_SUCCESSION(RESULT)+"웨이트")
				CFLAG:ARG:(GET_SUCCESSION(RESULT)+"웨이트") = 3
			ELSEIF CFLAG:ARG:(GET_SUCCESSION(RESULT)+"웨이트") == 3
				CFLAG:ARG:(GET_SUCCESSION(RESULT)+"웨이트") = 0
			ENDIF
		CASE 4
			IF (LOCAL:5 + LOCAL:6 <= BASE:ARG:ＭＰ) && CFLAG:ARG:어택커 == -1
				CFLAG:ARG:어택커 = GET_TYPE_NUM(GET_SUCCESSION(RESULT))
			ELSEIF CFLAG:ARG:어택커 == GET_TYPE_NUM(GET_SUCCESSION(RESULT))
				CFLAG:ARG:어택커 = -1
			ENDIF
	ENDSELECT
ELSEIF RESULT == 9
	$RES
	CFLAG:ARG:어택커 = -1
	VARSET CFLAG:ARG:0, 0, GETNUM(CFLAG, "검격웨이트"),  GETNUM(CFLAG, "검격웨이트") + TYPENUM
	RETURN -1
ELSEIF RESULT == 99
	IF ARG:1 == 1
		CFLAG:ARG:어택커 = -1
		VARSET CFLAG:ARG:0, 0, GETNUM(CFLAG, "검격웨이트"),  GETNUM(CFLAG, "검격웨이트") + TYPENUM
	ELSE
		A_WAIT = (A_WAIT + 1) % 3
	ENDIF
ENDIF
GOTO START
@AUTO_WAIT,ARG
#LOCALSSIZE 1
#LOCALSIZE 4
#DIM SKILL
SIF !INPUTABLEF_CHARA(ARG)
	RETURN
SIF FLAG:경과턴수 == 0 && (FLAG:기습플래그 || FLAG:선제공격플래그)
	RETURN
SIF !CFLAG:ARG:악마변신 || CFLAG:ARG:롱기누스
	RETURN

LOCAL:1 = 0
LOCAL:3 = 0
LOCALS = 
FOR LOCAL, 1, 42
	SIF !GETBIT(CFLAG:ARG:오토웨이트,LOCAL)
		CONTINUE
	SKILL = ABL:ARG:@"\@ LOCAL > 20 ? 장비 # \@스킬{LOCAL > 20 ? LOCAL - 20 # LOCAL}"
	
	RESULT = 0
	TRYCALLFORM ウェイトスキル_{SKILL}
	SIF !RESULT
		CONTINUE
	LOCAL:2 = RESULT
	
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", SKILL, ARG
	IF LOCAL:2 == 4	;어택커
		CFLAG:ARG:어택커 = GET_TYPE_NUM(GET_SUCCESSION(RESULT))
		LOCAL:1 += 2
		LOCAL:3 ++
	ELSE
		CFLAG:ARG:(GET_SUCCESSION(RESULT)+"웨이트") = LOCAL:2
		LOCAL:1 += LOCAL:2 + 1
		LOCAL:3 ++
	ENDIF
	CALL GET_SKILL_PROP, "SKILL_NAME", SKILL, ARG
	LOCALS += RESULTS + "\n"
NEXT
SIF LOCAL:3 < 1
	RETURN
PRINTFORM [AUTO WAIT] %CALLNAME:ARG% >>>>> 
LOCAL:3 = LOCAL:3 * LOCAL:1 * MAX(1, MAXBASE:ARG:ＭＰ / 100)
IF BASE:ARG:ＭＰ >= LOCAL:3
	PRINTFORML 消費ＭＰ　{LOCAL:3}
	BASE:ARG:ＭＰ -= LOCAL:3
	PRINTFORMW %LOCALS%
ELSE
	PRINTW ＭＰ가 없기 때문에 오토 웨이트를 해제합니다
	CFLAG:ARG:오토웨이트 = 0
	CFLAG:ARG:어택커 = -1
	VARSET CFLAG:ARG:0, 0, GETNUM(CFLAG, "검격웨이트"),  GETNUM(CFLAG, "검격웨이트") + TYPENUM
ENDIF