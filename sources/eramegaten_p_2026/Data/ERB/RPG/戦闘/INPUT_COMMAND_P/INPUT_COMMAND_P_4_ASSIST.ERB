;=================================================
;入力結果：ASSISTスキル
;ARG = 	キャラ登録番号
;ARG:1 = コマンド直指定
;=================================================
@INPUT_COM_NAME_COM_4,ARG
RESULTS = ASSIST
RESULTS:1 = Ａ - ＳＫＩＬＬ
RETURN 0

@INPUT_COM_ABLE_ASSIST,ARG
SIF !C_ASSIST_SKILL:ARG:0
	RETURN 0
CALL CAN_USE_SKILL, ARG
SIF !RESULT
	RETURN -1
RETURN 1

@INPUT_COM_ASSIST, ARG, ARG:1 = -1
CALL INPUT_COM_DO_SKILL, ARG, "AS", , ARG:1
SIF RESULT <= 0
	RETURN RESULT
CALL ACT_SKILL_QUICK, ARG, RESULT, RESULT:1
RETURN RESULT
