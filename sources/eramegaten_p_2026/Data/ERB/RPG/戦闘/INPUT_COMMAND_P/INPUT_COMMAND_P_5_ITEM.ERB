@INPUT_COM_NAME_COM_5,ARG
RESULTS = ITEM
RESULTS:1 = ＩＴＥＭ
RETURN 0

@INPUT_COM_ABLE_ITEM,ARG
SIF !GET_BTL_TALENT_LV("도구지식", ARG)
	RETURN 0
RETURN 1

@INPUT_COM_ITEM,ARG
#DIM DYNAMIC L_LINE
L_LINE = LINECOUNT
WHILE 1
	CLEARLINE LINECOUNT - L_LINE
	CALL PRINT_USE_ITEM,ARG
	IF RESULT == 1000
		RETURN -1
	ELSE
		LOCAL = RESULT+3000
		CUSTOMDRAWLINE =
		SIF FLAG:스킬속성표시설정 == 1
			CALL SKILL_EXPLAIN_PERFORMANCE, LOCAL, ARG
		;スキル使用者を一文字関数Uに入れておく
		U = ARG
		CALL GET_SKILL_PROP, "SKILL_EXPLAIN", LOCAL, ARG
		DRAWLINE
		CALL SELECT_SKILL_TARGET,LOCAL,ARG
		IF RESULT >= 0
			CFLAG:ARG:타겟 = RESULT
			CFLAG:ARG:입력행동 = LOCAL
			CFLAG:ARG:방어플래그 = 0
			CALL SET_REPEAT_CHARA, ARG
			RETURN 1
		ENDIF
	ENDIF
WEND