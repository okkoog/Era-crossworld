;=================================================
;合体スキル用関数置き場
;================================================


;---- EDIT 023 ADD START ---------------------------
;=================================================
;入力結果：ＥＣＳＬＩＮＫＡＧＥ
;=================================================
@INPUT_COM_NAME_COM_22,ARG
RESULTS = ECSLINKAGE
RESULTS:1 = ＥＣＳＬＩＮＫＡＧＥ
RETURN 1

@INPUT_COM_ABLE_ECSLINKAGE,ARG
SIF !FLAG:무후후전개
	RETURN 0
SIF !SOFT_ON("엑스링케이지")
	RETURN 0
RESULTS = %CALLNAME:MASTER%発情値不足
SIF CFLAG:MASTER:던전내발정용욕정치 < 1000
	RETURN -1
SIF CFLAG:ARG:롱기누스
	RETURN -1
RETURN 1

;リンケージの内容コピって別に立てたる
@INPUT_COM_ECSLINKAGE,ARG
#DIM 元リンケージ , 1
#DIM 元人数 , 1
;LOCAL:1-5 参加予定者
FOR LOCAL,1,6
	LOCAL:LOCAL = -1
NEXT
元リンケージ = CFLAG:ARG:사용링케이지
IF 元リンケージ < 4000
	TRYCALLFORM 参加人数_{元リンケージ}
	FOR LOCAL, RESULT+1, 6
		;PRINTFORML %CALLNAME:(CFLAG:ARG:(1253+LOCAL)%リンケージ参加解除
		CFLAG:ARG:("링케이지참가자"+ TOSTR(LOCAL)) = -1
	NEXT
ENDIF
;元参加予定者
FOR LOCAL,11,16
	LOCAL:LOCAL = -1
	IF CFLAG:ARG:("링케이지참가자"+ TOSTR(LOCAL-10)) > -1 && CFLAG:ARG:("링케이지참가자"+ TOSTR(LOCAL-10)) < CHARANUM && CFLAG:ARG:링케이지발동
		IF CFLAG:(CFLAG:ARG:("링케이지참가자"+ TOSTR(LOCAL-10))):PT플래그 == 2
			CFLAG:(CFLAG:ARG:("링케이지참가자"+ TOSTR(LOCAL-10))):링케이지참가 = 0
			LOCAL:LOCAL = CFLAG:ARG:("링케이지참가자"+ TOSTR(LOCAL-10))
			CFLAG:ARG:("링케이지참가자"+ TOSTR(LOCAL-10)) = -1
		ENDIF
	ENDIF
NEXT
;まず、Ｓに使えるリンケージを立てる
VARSET S , 0
;FOR LOCAL,4000,5000 EDIT 005 MOD
FOR LOCAL, MIN_LINKAGENUM, MAX_LINKAGENUM
	TRYCCALLFORM LINKAGE_{LOCAL}
		SIF RESULT == 0
			CONTINUE
	CATCH
		CONTINUE
	ENDCATCH
	CALL ACTIONABLE_ECSLINKAGE,LOCAL,ARG
	SIF RESULT == 1
		S:(LOCAL-4000) = 1
NEXT

;表示
$PRINT_ECSLINKAGE
;LOCAL:20 = 0
;FOR LOCAL,4000,5000 EDIT 005 MOD
FOR LOCAL, MIN_LINKAGENUM, MAX_LINKAGENUM
	IF S:(LOCAL-4000) == 1
		CALL GET_SKILL_PROP, "SKILL_NAME", LOCAL,ARG
		PRINTFORM [{LOCAL}] %RESULTS,20,LEFT%
		CALL GET_SKILL_PROP, "SKILL_EXPLAIN", LOCAL,ARG
		PRINTL 発動者 　
		CALL GET_SKILL_PROP, "SKILL_COSTTYPE", LOCAL, ARG
		IF RESULT == 2
			CALL GET_SKILL_PROP, "SKILL_COST", LOCAL, ARG
			PRINTFORM ＨＰ{RESULT,3}％　
		ELSE
			CALL GET_SKILL_PROP, "SKILL_COST", LOCAL, ARG
			PRINTFORM ＭＰ{RESULT,3}　　
		ENDIF
		CALLFORM 参加人数_{LOCAL}
		LOCAL:32 = RESULT + 1
		FOR LOCAL:31, 1, LOCAL:32
			PRINTFORM 参加者{LOCAL:31}　
			CALLFORM リンケージコストタイプ_{LOCAL}, LOCAL:31
			IF RESULT == 2
				CALLFORM リンケージコスト_{LOCAL}, LOCAL:31
				PRINTFORM ＨＰ{RESULT,3}％　
			ELSE
				CALLFORM リンケージコスト_{LOCAL}, LOCAL:31
				PRINTFORM ＭＰ{RESULT,3}　　
			ENDIF
			IF LOCAL:31 == LOCAL:32 - 1
				PRINTL 
			ELSEIF LOCAL:31 == 2
				PRINTL 
				PRINTFORM %" "* 27%
			ENDIF
		NEXT
	ENDIF
NEXT
PRINTL
DRAWLINE
PRINTL [1000]ＣＡＮＣＥＬ [999]ＲＥＰＥＡＴ [1001] ＡＮＡＬＹＺＥ

$INPUT_LOOP1
INPUT
IF RESULT == 1000
	;参加予定者関係を元に戻す
	FOR LOCAL,11,16
		IF LOCAL:LOCAL > -1
			;PRINTFORML LOCAL:{LOCAL} = {LOCAL:LOCAL}
			CFLAG:ARG:("링케이지참가자"+ TOSTR(LOCAL-10)) = LOCAL:LOCAL
			;---- EDIT 002 MOD START ---------------------------
			CFLAG:(LOCAL:LOCAL):링케이지참가 = ARG+1
			;---- EDIT 002 MOD END ---------------------------
		ENDIF
		LOCAL:LOCAL = -1
	NEXT
	RETURN -1
ELSEIF RESULT == 999
	SIF CFLAG:ARG:사용링케이지 < 4000
		GOTO INPUT_LOOP1
	;前回使用したメンバーで使用できるかチェック
	LOCAL:7 = CFLAG:ARG:사용링케이지
	CALL CHECK_ACTIONABLE,ARG,LOCAL:7
	SIF RESULT == 0
		GOTO INPUT_LOOP1
	CALLFORM 参加人数_{LOCAL:7}
	LOCAL:8 = RESULT
	FOR LOCAL , 1 , LOCAL:8+1
		SIF RANGE(LOCAL:(10+LOCAL), 0 , CHARANUM) == 0
			GOTO INPUT_LOOP1
		;---- EDIT 006 MOD START -------------------------
		;CALLFORM 参加者条件_{LOCAL:7}, LOCAL:(10+LOCAL) , LOCAL
		CALL リンケージ参加者条件確認, LOCAL:7, LOCAL:(10+LOCAL) , LOCAL
		SIF RESULT == 0
			GOTO INPUT_LOOP1
		;---- EDIT 006 MOD END ---------------------------
		CALL ACTIONABLE_CHARA,LOCAL:(10+LOCAL)
		SIF RESULT == 0
			GOTO INPUT_LOOP1
		SIF CFLAG:(LOCAL:(10+LOCAL)):PT플래그 < 2
			GOTO INPUT_LOOP1
	NEXT
	
	;ここまで通ったら、LOCAL:1-6にLOCAL:11-16を投げてPRINT_MENEへ
	FOR LOCAL, 1 , 7
		LOCAL:LOCAL = LOCAL:(10+LOCAL)
	NEXT
	GOTO PRINT_MENE
ELSEIF RESULT == 1001
	CALL SHOW_LINKAGE
	GOTO PRINT_ECSLINKAGE
ELSEIF RESULT < 4000 || RESULT > 5000 || S:(RESULT-4000) == 0
	GOTO INPUT_LOOP1
ENDIF
;LOCLA:7のスキルを使用
LOCAL:7 = RESULT
;発動者が使用できるかチェック
CALL CHECK_ACTIONABLE,ARG,LOCAL:7
SIF RESULT == 0
	GOTO INPUT_LOOP1
;参加者表示
$PRINT_MENE
DRAWLINE
CALLFORM 参加人数_{LOCAL:7}
LOCAL:8 = RESULT
	;---- EDIT 010 MOD START -------------------------
	CALL GET_SKILL_PROP, "SKILL_EXPLAIN", LOCAL:7,ARG
	;---- EDIT 010 MOD END   -------------------------

FOR LOCAL,1,LOCAL:8+1
	PRINTFORM [{LOCAL}]
	IF LOCAL:LOCAL == -1
		SETCOLOR 0x404040
		PRINTFORM ＥＭＰＴＹ　　　　　：
		RESETCOLOR
	ELSE
		PRINTFORM %CALLNAME:(LOCAL:LOCAL),20,LEFT%：
	ENDIF
	CALLFORM 参加条件表示_{LOCAL:7},LOCAL
	PRINTL
	PRINTL ↓
NEXT
PRINTFORM [{LOCAL:8+1}]%CALLNAME:ARG,20,LEFT%
CALLFORM 参加条件表示_{LOCAL:7},LOCAL:8+1
PRINTL 
DRAWLINE
PRINTL [0]ＯＫ      [10]ＣＡＮＣＥＬ

$INPUT_LOOP2
INPUT
IF RESULT == 10
	FOR LOCAL, 1, 6
		LOCAL:LOCAL = -1
	NEXT
	GOTO PRINT_ECSLINKAGE
ELSEIF RESULT == 0
	;全部埋まってないと駄目
	IF MATCH(LOCAL,-1,1,LOCAL:8+1)
		PRINTFORMW 참가자가 부족합니다
		CLEARLINE 2
		GOTO INPUT_LOOP2
	ENDIF
	;ターゲット決定＋行動入力
	
	CALLFORM SELECT_SKILL_TARGET,LOCAL:7,ARG
	SIF RESULT == -1
		GOTO PRINT_ECSLINKAGE


	;--- ここからエクスリンケージ実行
	CFLAG:(ARG):타겟 = RESULT
	CFLAG:(ARG):입력행동 = LOCAL:7
	CFLAG:ARG:사용링케이지 = LOCAL:7
	CFLAG:ARG:링케이지발동 = 1

	FOR LOCAL,1, 6
		IF LOCAL > LOCAL:8
			CFLAG:ARG:("링케이지참가자"+ TOSTR(LOCAL)) = -1
		ELSE
			;PRINTFORML %CALLNAME:(LOCAL:LOCAL)%が参加者 {LOCAL:LOCAL}
			CFLAG:ARG:("링케이지참가자"+ TOSTR(LOCAL)) = LOCAL:LOCAL
			;---- EDIT 002 MOD START ---------------------------
			CFLAG:(LOCAL:LOCAL):링케이지참가 = ARG+1
			;---- EDIT 002 MOD END ---------------------------
		ENDIF
	NEXT

	;--- こっからbattleturnstartのほぼコピ
	CALL SHOW_NOW_FORMATION_E,0,2, -2
	DRAWLINE
	CALL SHOW_NOW_FORMATION_P,0,2
	DRAWLINE

	CALL PRINT_ACT_MESSAGE, ARG, CFLAG:ARG:입력행동
	IF FLAG:RPG구상
		SKIPDISP 1
	ENDIF
	SKIPDISP 0
	RESETCOLOR

	CALL PAY_COST, ARG, CFLAG:(ARG):입력행동
	
	;エラー落ち対策
	FLAG:행동순1 = ARG
	
	CALL SKILL_ACTION, CFLAG:(ARG):입력행동, ARG, CFLAG:(ARG):타겟
	RESULT = 0

	SIF ARG >= 0 && CFLAG:(ARG):입력행동 >= 0
		CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:(ARG):입력행동, ARG
	SIF RESULT == 1
		CALL BATTLE_EVENT_ATTACK, ARG
	;気合・集中フラグの終了
	IF CFLAG:(ARG):입력행동 > -1
		RESULT = 0
		TRYCALL GET_SKILL_PROP, "SKILL_DAMAGETYPE", CFLAG:(ARG):입력행동, ARG
		;---- EDIT 003 MOD START ---------------------------
		IF RESULT == 1
			CFLAG:(ARG):気合フラグ = 0
			CFLAG:(ARG):타인기합플래그 = 0
			CFLAG:(ARG):회심의패기플래그 = 0
		ELSEIF RESULT == 2
			CFLAG:(ARG):집중플래그 = 0
			CFLAG:(ARG):타인집중플래그 = 0
		ENDIF
		;---- EDIT 003 MOD END ---------------------------
	ENDIF
	;HP吸収処理
	SIF CFLAG:(ARG):상태이상 == GET_STATE_NUM("BRAND") && CFLAG:(ARG):HP흡수량 > 0
		CFLAG:(ARG):HP흡수량 = 1
	SIF CFLAG:(ARG):회복불능플래그 && CFLAG:(ARG):HP흡수량 > 0
		CFLAG:(ARG):HP흡수량 = 0
	IF CFLAG:(ARG):HP흡수량 != 0
		PRINTL
		PRINTFORM 　ATTACKER:[{CPOS(ARG),2}] %CALLNAME:(ARG),20,LEFT%
		IF CFLAG:(ARG):HP흡수량 > 0
			PRINTFORM 　吸収>>　{CFLAG:(ARG):HP흡수량}회복
			CALL VAR_HP, ARG, CFLAG:(ARG):HP흡수량, "회복"
			PRINTL
			PRINTW
		ELSE
			;2021/5/24
			PRINTFORM 　反動>>　{-CFLAG:(ARG):HP흡수량}데미지
			CALL VAR_HP, ARG, CFLAG:ARG:HP흡수량, "食いしばり無効ダメージ"
			PRINTL
			PRINTW
		ENDIF
	ENDIF
	CFLAG:(ARG):HP흡수량 = 0
	
	;無効化回数を減らす処理
	FOR LOCAL:10,0,CHARANUM
		FOR LOCAL:11,0,TYPENUM
			IF CFLAG:(LOCAL:10):(GET_TYPE(LOCAL:11) + "피탄")
				CFLAG:(LOCAL:10):(GET_TYPE(LOCAL:11) + "무효화횟수") -= 1
				CFLAG:(LOCAL:10):(GET_TYPE(LOCAL:11) + "피탄") = 0
			ENDIF
		NEXT
		
		IF CFLAG:(LOCAL:10):BS피탄
			CFLAG:(LOCAL:10):BS피탄 = 0
			CFLAG:(LOCAL:10):성스러운가호 = 0
		ENDIF
	NEXT
	
	;マイト化による爆発フラグが立っているキャラが居たら爆発する
	SIF FINDCHARA(CFLAG:BOMB인화플래그,1) != -1
		CALL BOMB_BANG
	
	SIF CFLAG:(ARG):도주플래그
		CALL REMOVE_POSITION, CPOS(ARG)
	;ここまで
	CALL COMMAND_REPEAT, ARG
	CFLAG:ARG:던전내발정용욕정치 /= 4
	BASE:ARG:체력 -= 100
	BASE:ARG:기력 -= 100

	;参加予定者関係を元に戻す
	FOR LOCAL,1,6
		IF CFLAG:ARG:("링케이지참가자" + TOSTR(LOCAL)) > -1
			CFLAG:(CFLAG:ARG:("링케이지참가자" + TOSTR(LOCAL))):입력행동 = -1
			CFLAG:(CFLAG:ARG:("링케이지참가자" + TOSTR(LOCAL))):방어플래그 = 1
			CFLAG:(CFLAG:ARG:("링케이지참가자" + TOSTR(LOCAL))):링케이지참가 = 0
			CFLAG:(CFLAG:ARG:("링케이지참가자" + TOSTR(LOCAL))):던전내발정용욕정치 /= 2
			BASE:(CFLAG:ARG:("링케이지참가자" + TOSTR(LOCAL))):체력 -= 100
			BASE:(CFLAG:ARG:("링케이지참가자" + TOSTR(LOCAL))):기력 -= 100
			CFLAG:ARG:("링케이지참가자" + TOSTR(LOCAL)) = -1
		ENDIF
	NEXT
	RETURN 0
ELSEIF RESULT < 1 || RESULT > LOCAL:8
	GOTO INPUT_LOOP2
ENDIF
;LOCAL:9番目の参加者
LOCAL:9 = RESULT

CALL SHOW_NOW_FORMATION_P,0,2
PRINTL [10]ＣＡＮＣＥＬ
$INPUT_LOOP3
INPUT
IF RESULT == 10
	GOTO PRINT_MENE
ELSEIF RESULT < 1 || RESULT > 6 || POS(RESULT) == -1
	GOTO INPUT_LOOP3
ENDIF
;LOCAL:10のキャラが参加
LOCAL:10 = POS(RESULT)
;---- EDIT 006 MOD START -------------------------
;CALLFORM 参加者条件_{LOCAL:7}, LOCAL:10 , LOCAL:9
CALL リンケージ参加者条件確認, LOCAL:7, LOCAL:10 , LOCAL:9
SIF RESULT == 0
	GOTO INPUT_LOOP3
;---- EDIT 006 MOD END ---------------------------
;ＣＨＡＮＧＥ対象は弾く
SIF CFLAG:(LOCAL:10):ＣＨＡＮＧＥ대상플래그
	GOTO INPUT_LOOP3
;既に他のリンケージに参加しているキャラは弾く
SIF CFLAG:(LOCAL:10):링케이지참가
	GOTO INPUT_LOOP3
;発動者ははじく
SIF ARG == LOCAL:10
	GOTO INPUT_LOOP3
;他の場所に入ってるキャラも弾く
SIF MATCH(LOCAL,LOCAL:10,1,6)
	GOTO INPUT_LOOP3
;入力できないキャラも弾く
CALL INPUTABLE_CHARA , LOCAL:10
	
LOCAL:(LOCAL:9) = LOCAL:10

GOTO PRINT_MENE
;---- EDIT 023 ADD END ---------------------------



;=================================================
;エクスリンケージ使用可能判定
;================================================
@ACTIONABLE_ECSLINKAGE,ARG,ARG:1
;まずオプション他が条件にあってなかったら帰る
SIF !(FLAG:무후후전개) || !SOFT_ON("엑스링케이지")
	RETURN 0
;対象スキルがそもそもリンケージじゃなかったら帰る
;この処理はより上の階層に逃がす予定
TRYCCALLFORM LINKAGE_{ARG}
	SIF RESULT == 0
		RETURN 0
CATCH
	RETURN 0
ENDCATCH
;発動者が発情しておらず、体力気力が100以下だったら帰る
SIF CFLAG:(ARG:1):던전내발정용욕정치 < 10000 || BASE:(ARG:1):체력 <= 100 || BASE:(ARG:1):기력 <= 100
	RETURN 0

;発動者が条件を満たしているかチェック
;---- EDIT 006 MOD START -------------------------
;CALLFORM 発動者条件_{ARG},ARG:1
CALL リンケージ発動者条件確認, ARG, ARG:1
SIF RESULT == 0
	RETURN 0
;---- EDIT 006 MOD END ---------------------------

;参加者の人数をチェック
CALLFORM 参加人数_{ARG}
LOCAL:1 = RESULT

;条件を満たす参加者をDの枠に放り込む
VARSET D , 0
FOR LOCAL, 1 , LOCAL:1+1
	FOR LOCAL:2 , 1 , 7
		SIF POS(LOCAL:2) == -1
			CONTINUE
		;発動者は参加者になれない
		SIF POS(LOCAL:2) == ARG:1
			CONTINUE
		;入力できない状態の人はそもそも無理
		CALL INPUTABLE_CHARA , POS(LOCAL:2)
		SIF RESULT == 0
			CONTINUE
		;---- EDIT 006 MOD START -------------------------
		;CALLFORM 参加者条件_{ARG},POS(LOCAL:2),LOCAL
		CALL リンケージ参加者条件確認, ARG, POS(LOCAL:2), LOCAL
		SIF RESULT == 0
			CONTINUE
		;---- EDIT 006 MOD END ---------------------------
		;エクスリンケージは発情してかつ体力気力なきゃ参加者になれない
		SIF CFLAG:POS(LOCAL:2):던전내발정용욕정치 < 10000 || BASE:POS(LOCAL:2):체력 <= 100 || BASE:POS(LOCAL:2):기력 <= 100
			CONTINUE
		D:LOCAL |= POWER(2,LOCAL:2)
	NEXT
NEXT

;0があると駄目
SIF MINARRAY(D,1,LOCAL:1+1) == 0
	RETURN 0



;重複せずに全てが埋まる組み合わせがあるかをチェック
;どうすんだこれ
VARSET E , 0

FOR LOCAL:4 , 1 , 7
	$LOOP1
	;LOCAL番目の条件をLOCAL:4人が満たしている場合、番号の若い順に当てはめ
	;当てはめたらまた一人からチェック
	FOR LOCAL , 1 , LOCAL:1 + 1
		SIF E:LOCAL > 0
			CONTINUE
		;人数を判定
		LOCAL:3 = 0
		FOR LOCAL:2 , 1 , 7
			LOCAL:3 += GETBIT(D:LOCAL, LOCAL:2)
		NEXT
		;LOCAL:4人じゃなければ次へ
		SIF LOCAL:3 != LOCAL:4
			CONTINUE
		FOR LOCAL:2 , 1 , 7
			IF D:LOCAL & POWER(2,LOCAL:2)
				E:LOCAL = POWER(2,LOCAL:2)
				;全てのDからLOCAL:2番目のビットを削除
				FOR LOCAL:3 , 1 , LOCAL:1+1
					D:(LOCAL:3) &= ~(POWER(2,LOCAL:2))
				NEXT
				LOCAL:4 = 0
				GOTO LOOP1
			ENDIF
		NEXT
	NEXT
NEXT


;Eに0が残ってたら駄目

SIF MINARRAY(E,1,LOCAL:1+1) == 0
	RETURN 0
SETBIT FLAG:(1202+ARG / 63), ARG % 63
RETURN 1


