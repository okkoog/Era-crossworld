;=========================================================
;ペルソナ変更
;=========================================================
@INPUT_COM_NAME_COM_40,ARG = -1
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC BUTTON_NUM
#DIMS DYNAMIC L_BUTTON, 3
#DIM DYNAMIC L_PERSONA, 3
BUTTON_NUM = FINDELEMENT(COMMAND_LIST_P, "", 1, , 1)
COMMAND_LIST_NAME:0 '= "PCHANGE0", "PCHANGE1", "PCHANGE2"
COMMAND_LIST_SHOWNAME:0 = [  ] Ｐ－ＣＨＡＮＧＥ
COMMAND_LIST_CATEGORY:0 = 2

IF ARG >= 0
	L_PERSONA = CFLAG:ARG:초기페르소나넘버, EQUIP:ARG:소지페르소나1, EQUIP:ARG:소지페르소나2
	FOR LCOUNT, 0, 3
		IF L_PERSONA:LCOUNT > 0
			L_BUTTON:LCOUNT += @"[{BUTTON_NUM + LCOUNT,2}] " + CSVNAME(DITEMTYPE:(L_PERSONA:LCOUNT):페르소나("NO"),0)			
			IF CFLAG:ARG:롱기누스
				L_BUTTON:LCOUNT '= SET_COLOR_TAG(L_BUTTON:LCOUNT, "dark-gray")
				COMMAND_LIST_UNABLE:LCOUNT = 1
				L_BUTTON:LCOUNT '= SET_BUTTON_TAG(L_BUTTON:LCOUNT, , "異能力封印")
			ELSE
				IF LCOUNT == 0 && EQUIP:ARG:장비페르소나 == 0
					L_BUTTON:LCOUNT '= SET_COLOR_TAG(L_BUTTON:LCOUNT, "p-green")
					COMMAND_LIST_UNABLE:LCOUNT = 1
				ELSEIF LCOUNT && EQUIP:ARG:장비페르소나 == L_PERSONA:LCOUNT
					L_BUTTON:LCOUNT '= SET_COLOR_TAG(L_BUTTON:LCOUNT, "p-green")
					COMMAND_LIST_UNABLE:LCOUNT = 1
				ELSE
					L_BUTTON:LCOUNT '= SET_BUTTON_TAG(L_BUTTON:LCOUNT, TOSTR(BUTTON_NUM + LCOUNT))
				ENDIF
			ENDIF
		ELSE
			L_BUTTON:LCOUNT += @"[{BUTTON_NUM + LCOUNT,2}] ＥＭＰＴＹ"
			L_BUTTON:LCOUNT '= SET_BUTTON_TAG(SET_COLOR_TAG(L_BUTTON:LCOUNT, "dark-gray"), TOSTR(BUTTON_NUM + LCOUNT))
			COMMAND_LIST_UNABLE:LCOUNT = 1
		ENDIF
		COMMAND_LIST_SHOWNAME:0 += "<br>" + "　　" + L_BUTTON:LCOUNT
	NEXT
ENDIF
RETURN 2

@INPUT_COM_ABLE_PCHANGE0,ARG
SIF !TALENT:ARG:페르소나구사자
	RETURN 0
SIF CFLAG:ARG:롱기누스
	RETURN -1
RETURN 1

@INPUT_COM_PCHANGE0, ARG
CALL CHANGE_EQUIP_PERSONA, ARG, "초기페르소나"
CALL INPUT_COM_PCHANGE, ARG

@INPUT_COM_PCHANGE1, ARG
CALL CHANGE_EQUIP_PERSONA, ARG, "소지페르소나1"
CALL INPUT_COM_PCHANGE, ARG

@INPUT_COM_PCHANGE2, ARG
CALL CHANGE_EQUIP_PERSONA, ARG, "소지페르소나2"
CALL INPUT_COM_PCHANGE, ARG

@INPUT_COM_PCHANGE, L_CHARA
#DIM DYNAMIC L_CHARA
CALL リンケージ破棄確認, L_CHARA
;リピートのセット
CALL SET_REPEAT_CHARA, L_CHARA
HTML_PRINT_ISLAND  @"<div xpos = '0' ypos = '0' width = '{CLIENTWIDTH()}px' height = '{CLIENTHEIGHT()}px' display = 'absolute-lefttop' background_color = '%TOSTR_HTML(GETBGCOLOR())%'>" + "</div>"
TWAIT 200, 1
HTML_PRINT_ISLAND_CLEAR
