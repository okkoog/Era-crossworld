		CFLAG:L_FRIEND:입수경험치 += L_GET_EXP
		;AP
		IF GET_ROLE_PROP("CAN_USE_MANTRA", L_FRIEND) && EQUIP:L_FRIEND:장비만트라 && CFLAG:L_FRIEND:PT플래그 == 2
			;基本値 暴飲暴食がスタメン化できるあたりで減少措置
			SELECTCASE CFLAG:L_FRIEND:만트라적성레벨
				CASE IS > 45
					LOCAL:3 = 30 * 100
				CASE IS > 20
					LOCAL:3 = 50 * 100
				CASEELSE
					LOCAL:3 = 75 * 100
			ENDSELECT
			LOCAL:4 = BASE:L_ENEMY:LV - CFLAG:L_FRIEND:만트라적성레벨
			WHILE LOCAL:4
				IF LOCAL:4 > 0
					TIMES LOCAL:3, 1.10
					LOCAL:4--
				ELSE
					TIMES LOCAL:3, 0.80
					LOCAL:4++
				ENDIF
			WEND
			LOCAL:3 = MAX(LOCAL:3 / 20, 1) ;061
			;LOCAL:3 = MAX(LOCAL:3 / 100, 1)
			;ハントは5倍
			IF CFLAG:L_ENEMY:피헌트 == L_FRIEND + 1
				CFLAG:L_FRIEND:입수AP += LOCAL:3 * 5
			ELSEIF CFLAG:L_ENEMY:피헌트 == 0
				CFLAG:L_FRIEND:입수AP += LOCAL:3
			ENDIF
		ENDIF
	NEXT

	;ポジションによる経験点補正
	;戦闘終了時のメンバー
	TEMP_PTフラグ = CFLAG:L_FRIEND:PT플래그

	VARI L_CHARA
	
	;レベルリンクをしている場合、リンクしているやつのポジションも見る
	VARI LINK_CHARA
	VARI IS_LEVEL_LINK = 0
	L_CHARA = L_FRIEND
	FOR LCOUNT, 0, LINKCHARANUM
		LINK_CHARA = FINDCHARA_LINK(L_FRIEND, LCOUNT)
		SIF LINK_CHARA < 0
			CONTINUE
		SIF !CFLAG:LINK_CHARA:레벨링크
			CONTINUE
		TEMP_PTフラグ = MAX(TEMP_PTフラグ, CFLAG:LINK_CHARA:PT플래그)
		IS_LEVEL_LINK = 1
	NEXT

	;リンク先がいる場合、リンク先の戦闘参加状況も見る
	VARI LINKED_CHARA
	LINKED_CHARA = FINDCHARA_TIMEID(CFLAG:L_FRIEND:피링크캐릭터실제가입시간)
	SIF LINKED_CHARA >= 0
		TEMP_PTフラグ = MAX(TEMP_PTフラグ, CFLAG:LINKED_CHARA:PT플래그)

	IF TEMP_PTフラグ == 2
		CFLAG:L_FRIEND:입수경험치 = CFLAG:L_FRIEND:입수경험치 * 100 / 100
		;PT人数で割る
		CFLAG:L_FRIEND:입수경험치 /= GET_EXP_FRIEND_NUM
	;控え
	ELSEIF MATCH(BCHARA, L_FRIEND)
		VARI TEMP_EXP_CORRECT
		TEMP_EXP_CORRECT = 50
		SIF HAVE_SKILL(L_FRIEND,[[스킬:견학성장]])
			TEMP_EXP_CORRECT += 25
		SIF SOFT_ON("화이트앨범")
			TEMP_EXP_CORRECT += 25
		CFLAG:L_FRIEND:입수경험치 = CFLAG:L_FRIEND:입수경험치 * TEMP_EXP_CORRECT / 100
		;PT外メンバーは常に6人割
		CFLAG:L_FRIEND:입수경험치 /= 6
	ELSE
		IF HAVE_SKILL(L_FRIEND,[[스킬:견학성장]])
			CFLAG:L_FRIEND:입수경험치 = CFLAG:L_FRIEND:입수경험치 * 25 / 100
			CFLAG:L_FRIEND:입수경험치 /= 6
		ELSE
			CFLAG:L_FRIEND:입수경험치 = 0
		ENDIF
	ENDIF
	;レベルリンクをしている場合、リンク先にここで配布する
	IF IS_LEVEL_LINK
		FOR LCOUNT, 0, LINKCHARANUM
			LINK_CHARA = FINDCHARA_LINK(L_FRIEND, LCOUNT)
			SIF LINK_CHARA < 0
				CONTINUE
			SIF !CFLAG:LINK_CHARA:레벨링크
				CONTINUE
			CFLAG:LINK_CHARA:입수경험치 = CFLAG:L_FRIEND:입수경험치
		NEXT
	ENDIF
NEXT
FOR L_ENEMY,CHARANUM-1,0,-1
	;倒した敵であるかを確認
	IF CFLAG:L_ENEMY:PT플래그 == 0 && (GET_STATE(CFLAG:L_ENEMY:상태이상) == "DYING" || GET_STATE(CFLAG:L_ENEMY:상태이상) == "STONE")
		;イベント戦では特別に解析値をつける
		IF FLAG:도주불가플래그 > 0
			IF FLAG:악마해석률상승불가플래그 == 0
				;解析可能な場合
				CALL INCREASE_ANALYZE,NO:L_ENEMY,10
				SIF CFLAG:L_ENEMY:보스플래그 > 0
					CALL INCREASE_ANALYZE,NO:L_ENEMY,ANALYSIS_COMPLETED
			ENDIF
		ENDIF
		FOR LCOUNT,0,3
			LOCALS = 아이템{LCOUNT+1}
			LOCALS:1 = 입수확률{LCOUNT+1}
			SIF ITEMPRICE:(ABL:L_ENEMY:LOCALS) == 0
				CONTINUE
			;オプションでアイテム合成がONでないなら素材をドロップさせない
			SIF !FLAG:아이템합성해금 && INRANGE(ABL:L_ENEMY:LOCALS, MIN_MATERIAL, MAX_MATERIAL - 1)
				CONTINUE
			DROP_RATE = ABL:L_ENEMY:(LOCALS:1) * 100
			;予め計算しておいた補正を使う
			DROP_RATE = DROP_RATE * DROP_RATE_VALUE / 100
			SIF RAND:10000 < DROP_RATE
				G:(ABL:L_ENEMY:LOCALS) += 1
		NEXT
		FLAG:입수￥ += (COEFFICIENT_MONEY(ABL:L_ENEMY:종족)+CFLAG:L_ENEMY:￥보정) * BASE:L_ENEMY:LV
		;---- EDIT P 002 MOD START -------------------------
		FLAG:입수ＭＡＧ += GET_BASE_ENEMY_MAG(L_ENEMY)
		;FLAG:입수ＭＡＧ += (COEFFICIENT_MAG(ABL:L_ENEMY:종족)+CFLAG:L_ENEMY:ＭＡＧ보정) * BASE:L_ENEMY:LV * (1+BASE:L_ENEMY:LV/8) * 4/5
		;---- EDIT P 002 MOD END ---------------------------		
		;アルセーヌによる追加ドロップは最大サマナーレベルでドロップ率が変わる
		;宝石のレアリティランクは下記のようになることを想定しているらしい
		;１：サファイア,진주,루비,다이아몬드,
		;２：オニキス,아쿠아마린,터키석,토파즈
		;３：エメラルド,아메지스트,오팔,가넷
		;
		;2023 0811 トパーズのドロップに邪神を追加
		;2024 0328 アルセーヌの効果を5%に固定
		;IF SOFT_ON("아르센") && (RAND:100 < (GET_SUMMONER_LV() + 1))
		IF SOFT_ON("아르센") && (RAND:100 < 5)
			SELECTCASE GET_RACE(ABL:L_ENEMY:종족)
				CASE "지모신"
					G:GETNUM(ITEM, "진주") += 1
				CASE "여신"
					G:GETNUM(ITEM, "사파이어") += 1
				CASE "마왕", "사신"
					G:GETNUM(ITEM, "토파즈") += 1
				CASE "천사", "타천사"
					G:GETNUM(ITEM, "에메랄드") += 1
				CASE "요마"
					G:GETNUM(ITEM, "아쿠아마린") += 1
				CASE "요정"
					G:GETNUM(ITEM, "오닉스") += 1
				CASE "요귀"
					G:GETNUM(ITEM, "가넷") += 1
				CASE "용왕", "요조"
					G:GETNUM(ITEM, "아메지스트") += 1
				CASE "마수"
					G:GETNUM(ITEM, "터키석") += 1
				CASE "외도"
					G:GETNUM(ITEM, "오팔") += 1
				CASE "머신"
				CASE "정령"
				CASE "어령"
				CASE "귀신"
					G:GETNUM(ITEM, "루비") += 1
				CASE "마신"
					G:GETNUM(ITEM, "다이아몬드") += 1
			ENDSELECT
		ENDIF
	ENDIF
NEXT
