;==================================================================
;戦闘でのメイン画面の処理と戦闘時の各種処理を行います
;==================================================================

;===================================================================
;戦闘開始処理
;===================================================================
@BATTLE_START
IF MATCH(FLAG, -1, GETNUM(FLAG, "포지션7"), GETNUM(FLAG, "포지션16")+1) == 10
	PRINTW 적이 배치되지 않은 상태에서 전투가 개시되었습니다
	PRINTW 오류를 방지하기 위해 전투 처리를 중단하고 종료합니다
	PRINTW 이 오류가 발생한 이벤트 혹은 던전과 층수의 보고를 부탁드립니다
	RETURN 0
ENDIF
CALL REFRESH_FORMATION
CALL REFRESH_BATTLE
CALL SET_ENEMY_HAVE_SKILL_ATK_TYPE

;ウィンドウ型メッセージのスキップフラグ折り
FLAG:윈도우메시지스킵 = 0

CALLFORM EVENT_BATTLE_START
SIF FLAG:선제기습취소 == 0
	CALL CHECK_SURPRISEATTACK
;戦闘のメインフロー
CALL BATTLE_MAIN

;戦闘終了時の処理
CALL BATTLE_END

;===================================================================
;先制不意打ち背後攻撃判定
;===================================================================
@CHECK_SURPRISEATTACK
#LOCALSIZE 4
LOCAL:1 = 0
;プレイヤー側の判定値
LOCAL:3 = 0
;人数
LOCAL:2 = 0
;敵側の判定値
FOR LOCAL,1,7
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0
		CONTINUE
	LOCAL:1 += (BASE:(FLAG:LOCALS):(GET_BASESTATUS(5)) + BASE:(FLAG:LOCALS):(GET_BASESTATUS(6)))
	LOCAL:3 += 1
NEXT
LOCAL:1 /= LOCAL:3
LOCAL:3 = 0
FOR LOCAL,7,17
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0
		CONTINUE
	LOCAL:2 += (BASE:(FLAG:LOCALS):(GET_BASESTATUS(5)))
	LOCAL:3 += 1
NEXT
LOCAL:2 /= LOCAL:3
;---- EDIT 129 MOD START -------------------------
IF !FLAG:선제공격플래그 && !FLAG:백어택플래그 && !FLAG:기습플래그 && !COUNT_CONTINUE_BATTLED
	IF RAND:100 + LOCAL:1 + (SOFT_ON("Mr.서프라이즈") * 20) + (HAVE_AW_SKILL_FRIEND(MASTER, "時間遡行者", 1) * 20) > RAND:100 + LOCAL:2
		SIF RAND:100 < MAX(5,10 + LOCAL:1 - LOCAL:2) + (SOFT_ON("Mr.서프라이즈")) * 20
			FLAG:선제공격플래그 = 1
	ELSE
		SELECTCASE RAND:100
			CASE IS < MAX(5,8 + LOCAL:2 -LOCAL:1) + (FLAG:월령 == 0 || FLAG:월령 == 8 ? 15 # 0) + (DA:(FLAG:현X):(FLAG:현Y) % 10 == -1) * 10
				FLAG:백어택플래그 = 1
				FLAG:기습플래그 = 1
			CASE IS < MAX(5,25 + LOCAL:2 -LOCAL:1) + (FLAG:월령 == 0 || FLAG:월령 == 8 ? 30 # 0) + (DA:(FLAG:현X):(FLAG:현Y) % 10 == -1) * 20
				FLAG:기습플래그 = 1
		ENDSELECT
	ENDIF
ENDIF 
;百太郎と混ざると面倒かつ口上的な課題があるので時間遡行者とエネミーサーチはフラグそのものを折る。
IF HAVE_AW_SKILL_FRIEND(MASTER, "時間遡行者", 1) || IS_ENEMY_HUNT
	FLAG:백어택플래그 = 0
	FLAG:기습플래그 = 0
ENDIF
IF FLAG:백어택플래그
	IF !SOFT_ON("하쿠타로우")
		FOR LOCAL,1,7
			LOCALS = 포지션{LOCAL}보존
			LOCALS:1 = 포지션{LOCAL}
			FLAG:LOCALS = FLAG:(LOCALS:1)
		NEXT
		CALL CHANGE_POS,1,6
		CALL CHANGE_POS,2,5
		CALL CHANGE_POS,3,4
	ENDIF
ENDIF
;---- EDIT 129 MOD END ---------------------------
;SIF ASSI > 0 && (FLAG:선제공격플래그 + FLAG:기습플래그 < 1)
;	CALL SUPORT(1, 0)

;===================================
;戦闘時メインメニュー表示及び処理メインフロー
;動作部は主に以下の通り
;1.ターン冒頭の処理(戦闘開始時の処理)
;2.コマンド入力
;3.ターン開始
;
;なお、この関数でRETURNをすると戦闘が終了する
;===================================
@BATTLE_MAIN
#LOCALSIZE 8
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_POS
#DIM DYNAMIC L_CHARA;EDIT ADD 092
#DIM DYNAMIC L_SKILL
#DIM DYNAMIC SKILL_EX_DISPLAY_NUM
#DIM DYNAMIC L_LINE
#DIM DYNAMIC KOJO_TABLE, 6
#DIMS DYNAMIC COMMAND_MENU
#DIMS DYNAMIC L_SYMBOL, 35
#DIMS DYNAMIC L_COMMANDNAME, 35
#DIMS DYNAMIC L_COMMANDABLE, 35
;---- EDIT 103 MOD START -------------------------
;勝敗をチェック
CALL FIGHT_IT_OUT
SIF RESULT
	RETURN 1
;-------------------------------------------------
;ターン冒頭の処理　ただし1ターン目は戦闘開始時の処理を行う
;-------------------------------------------------
TFLAG:네비용난수시트 = GETMILLISECOND();EDIT ADD 105

;---- EDIT 103 MOD END ---------------------------
;1ターン目冒頭の処理
;先制攻撃フラグは敵行動不能・不意打ちフラグは味方行動不能
IF FLAG:경과턴수 < 1
	TSTR:전투개시상황 = 통상
	IF FLAG:선제공격플래그
		SETCOLOR COLOR("FRIEND")
		PRINTL 　┏━━━━━━━━━━━━━┓
		PRINTL 　┃ PARTY SURPRISE ATTACK !! ┃
		PRINTW 　┗━━━━━━━━━━━━━┛
		RESETCOLOR
		TSTR:전투개시상황 = 先制攻撃
	ELSEIF FLAG:백어택플래그 || FLAG:기습플래그
		SETCOLOR COLOR("ENEMY")
		IF FLAG:백어택플래그
			PRINTL 　┏━━━━━━━━━━━━━┓
			PRINTL 　┃  ENEMY  BACK  ATTACK !!! ┃
			PRINTW 　┗━━━━━━━━━━━━━┛
			TSTR:전투개시상황 = バックアタック
		ELSE
			PRINTL 　┏━━━━━━━━━━━━━┓
			PRINTL 　┃ ENEMY SURPRISE ATTACK !! ┃
			PRINTW 　┗━━━━━━━━━━━━━┛
			TSTR:전투개시상황 = 不意打ち
		ENDIF
		RESETCOLOR
		IF SOFT_ON("하쿠타로우") && FLAG:기습플래그 < 2
			CLEARLINE 3
			SETCOLOR COLOR("FRIEND")
			PRINTL 　┏━━━━━━━━━━━━━┓
			PRINTL 　┃"HYAKU-TARO" SAVED YOU !! ┃
			PRINTW 　┗━━━━━━━━━━━━━┛
			RESETCOLOR
			FLAG:기습플래그 = 0
			FLAG:백어택플래그 = 0
			TSTR:전투개시상황 += "阻止"
		ENDIF
	ENDIF

	;---- EDIT 127 MOD START -------------------------
	;1ターン目の口上
	CALL EVENT_BATTLE_NAVI, "戦闘開始"
	;---- EDIT 127 MOD END ---------------------------
	SETCOLOR COLOR("FRIEND")
	IF TSTR:전투개시상황 == "통상"
		CALL BATTLE_EVENT, "戦闘開始時"
	ELSE
		CALL BATTLE_EVENT, TSTR:전투개시상황
	ENDIF
	RESETCOLOR
	;不意打ちなら味方の入力終了時まで飛ばす
	SIF FLAG:기습플래그
		GOTO INPUT_COMMAND_END
ENDIF
CALL EVENT_BATTLE_TURNTOP
CALL SKILL_TIMING, "TURNTOP"
;---- 086 自動悪魔変身 START (ADD) ------------------------------
;自動で悪魔変身を実行する
CALL AUTO_TRANSFORM
;---- 086 自動悪魔変身 START (ADD) ------------------------------

;命乞い判定
SIF FLAG:도주불가플래그 == 0 && FLAG:회화불능플래그 == 0
	CALL 命乞い
IF GETBIT(FLAG:목숨구걸플래그, 1) || GETBIT(FLAG:목숨구걸플래그, 2)
	LOCALS = %RESULTS%
	GOTO 命乞い会話
ENDIF

;-------------------------------------------------
;ターン冒頭の処理　コマンド入力
;-------------------------------------------------
;入力行動をＲＥＰＥＡＴから呼び出して登録
FOR L_POS, 1, 7
	SIF POS(L_POS) < 0
		CONTINUE
	CALL COMMAND_REPEAT, POS(L_POS)
NEXT
$INPUT_COMMAND_START
CALL REFRESH_FORMATION

;---- EDIT 103 MOD START -------------------------
;勝敗をチェック
CALL FIGHT_IT_OUT
SIF RESULT
	RETURN 1


;---- EDIT 134 ADD START -------------------------
;コマンドを実行不能になっていないかチェックする
FOR L_POS, 1, 7
	L_CHARA = POS(L_POS)
	SIF POS(L_POS) < 0
		CONTINUE
	CALL CORRECT_ACTION, L_CHARA, 1
NEXT
;---- EDIT 134 ADD END ---------------------------
;勝敗をチェック
;CALL FIGHT_IT_OUT
;敗北フラグ立ってたらゲームオーバー呼び出し
;SIF FLAG:패배플래그 == 1
;	CALL BATTLE_LOSE
;IF FLAG:승리플래그 || FLAG:도주플래그
;	CALL BATTLE_END
;	RETURN 1
;ENDIF
;---- EDIT 103 MOD END ---------------------------

;戦闘中アナウンス
;SIF ASSI > 0
;	CALL SUPORT(3, 1)

LOCAL = 0
CALL SHOW_NOW_FORMATION_E, 0, 2, -1, "BATTLE_MAIN";EDIT 094 ADD
DRAWLINE
CALL SHOW_NOW_FORMATION_P,0,2, 7, "戦闘中_メイン";EDIT MOD 092

CALL SET_NAVI_DATA_FOR_MAIN
;---- EDIT 127 MOD START -------------------------
CALL EVENT_BATTLE_NAVI, "メイン画面"
;---- EDIT 127 MOD END ---------------------------
;---- EDIT 090 強制勝利コマンド追加				(2022/11/25) ADD START ----
;---- EDIT FPS操作時戦闘コマンド対応キー変更(2011/02/13) MOD START ----
{
L_SYMBOL '= "0",  "",  "",  "",  "", "", "M",
			"1", "e",  "",  "",  "", "", "H",
			"2",  "",  "",  "",  "", "", "E",
			"3",  "",  "",  "",  "", "",  "",
			"4", "5", "6", "7", "9", "i",  "",
}
{
L_COMMANDNAME '= 	"FIGHT", 	"",  		"",  			"",  			"", 	"", "MUDO-ON CURRY",
					"TALK",  	"SUMMON",  	"",  			"",  			"", 	"", "HARU-MAGE DON",
					"ANALYZE",  "",  		"",  			"",  			"", 	"", "ENEMY COMMAND",
					"ESCAPE",   "",  		"",  			"",  			"", 	"", "",
					"AUTO", 	"GUN AUTO", "REPEAT AUTO", 	"GUARD AUTO", 	"相性", "ENEMY_ICON"
}
VARSET COMMAND_MENU
VARI TEMPNUM
VARS TEMPNAME
VARS L_COLOR
FOR LCOUNT:1, 0, 5
	FOR LCOUNT, 0, 7
		TEMPNUM = LCOUNT:1 * 7 + LCOUNT
		SELECTCASE L_SYMBOL:TEMPNUM
			CASE ""
				CONTINUE
			CASE "0"
				SIF FLAG:던전내조작설정 == 1
					L_SYMBOL:TEMPNUM '= " "
			CASE "1"
				SIF FLAG:던전내조작설정 == 1
					L_SYMBOL:TEMPNUM '= "w"
			CASE "4"
				SIF FLAG:던전내조작설정 == 1
					L_SYMBOL:TEMPNUM '= "a"
			CASE "5"
				SIF FLAG:던전내조작설정 == 1
					L_SYMBOL:TEMPNUM '= "s"
			CASE "6"
				SIF FLAG:던전내조작설정 == 1
					L_SYMBOL:TEMPNUM '= "d"
			CASE "7"
				SIF FLAG:던전내조작설정 == 1
					L_SYMBOL:TEMPNUM '= "f"		
		ENDSELECT
		
		L_COLOR '= TOSTR_HTML(COLOR("DEFAULT"))
		TEMPNAME '= L_COMMANDNAME:TEMPNUM
		SELECTCASE TEMPNAME
			CASE "相性"
				SELECTCASE FLAG:상성등표시ON
					CASE 0
						TEMPNAME = 표시전환[OFF]
					CASE 1
						TEMPNAME = 표시전환[상성]
					CASE 2
						TEMPNAME = 표시전환[강화]
					CASE 3
						TEMPNAME = 표시전환[방벽]
				ENDSELECT
			CASE "ENEMY_ICON"
				IF FLAG:적아이콘표시
					TEMPNAME =  적아이콘표시[ON]
				ELSE
					TEMPNAME =  적아이콘표시[OFF]
				ENDIF
			CASE "SUMMON"
				TEMPNAME = SUMMON [{COUNT_SUMMONABLE()}/{COUNT_SUMMONABLE_MAX()}]
				SIF !COUNT_SUMMONABLE()
					L_COLOR '= TOSTR_HTML(COLOR("gray"))
			CASE "MUDO-ON CURRY"
				SIF !IS_DEBUG
					CONTINUE
				L_COLOR '= TOSTR_HTML(COLOR("red"))
			CASE "HARU-MAGE DON"
				SIF !IS_DEBUG
					CONTINUE
				L_COLOR '= TOSTR_HTML(COLOR("p-green"))
			CASE "ENEMY COMMAND"
				SIF !IS_DEBUG
					CONTINUE
				L_COLOR '= TOSTR_HTML(COLOR("p-green"))
			CASE "TALK"
				SIF FLAG:회화불능플래그
					L_COLOR '= TOSTR_HTML(COLOR("gray"))
			CASE "ESCAPE"
				SIF FLAG:도주불가플래그
					L_COLOR '= TOSTR_HTML(COLOR("gray"))
		ENDSELECT
		TEMPNAME '= SET_BUTTON_TAG(TEMPNAME, L_SYMBOL:TEMPNUM)
		TEMPNAME '= SET_COLOR_TAG(TEMPNAME,  L_COLOR)
		COMMAND_MENU += @"<div xpos = '{LCOUNT * 50 * 19}' ypos = '{LCOUNT:1 * 100}'>"
		COMMAND_MENU += "[" + L_SYMBOL:TEMPNUM + "] " + TEMPNAME
		COMMAND_MENU += "</div>"
	NEXT
NEXT
HTML_PRINT COMMAND_MENU
FOR LCOUNT, 0, 4
	PRINTL 
NEXT

L_LINE = LINECOUNT
$INPUT_LOOP
CLEARLINE LINECOUNT - L_LINE
SETANIMETIMER TFLAG:애니메이션타이머
ONEINPUTS
SETANIMETIMER 0
;---- EDIT FPS操作時戦闘コマンド対応キー変更(2011/02/13) MOD START ----
IF RESULTS == "0" || RESULTS == " "
	$INPUT_COMMAND
;---- EDIT FPS操作時戦闘コマンド対応キー変更(2011/02/13) MOD END ------
	CALL INPUT_COMMAND
	SIF RESULT == 0
		GOTO INPUT_COMMAND_START
;---- EDIT FPS操作時戦闘コマンド対応キー変更(2011/02/13) MOD START ----
ELSEIF RESULTS == "1" || RESULTS == "w"
;---- EDIT FPS操作時戦闘コマンド対応キー変更(2011/02/13) MOD END ------
	IF INPUTABLEF_CHARA(MASTER) == 0
		PRINTFORMW %MASTER는% 대화할 수 있는 상태가 아니다
		GOTO INPUT_LOOP
	ENDIF

	IF FLAG:회화불능플래그
		PRINTW 전투 상태라서 그럴 겨를이 없다
		GOTO INPUT_LOOP
	ENDIF
	CALL SHOW_NOW_FORMATION_E,0,2, -2
	PRINTL 누구와 대화할까？
	PRINTL [100] 그만둔다
	$INPUT_LOOP2
	INPUT
	LOCALS = 포지션{RESULT}
	IF RESULT == 100
		GOTO INPUT_COMMAND_START
	ELSEIF RESULT < 7 || RESULT > 16
		GOTO INPUT_LOOP2
	ELSEIF FLAG:LOCALS > -1 && CFLAG:(FLAG:LOCALS):PT플래그 == 0
		$命乞い会話
		CALL TALK,FLAG:LOCALS
