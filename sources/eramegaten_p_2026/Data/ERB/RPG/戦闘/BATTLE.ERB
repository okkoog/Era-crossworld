	ENDIF
	SIF CFLAG:L_CHARA:크리티컬강화 > 0
		CFLAG:L_CHARA:크리티컬강화 -= 1
	SIF CFLAG:L_CHARA:크리티컬강화 < 0
		CFLAG:L_CHARA:크리티컬강화 += 1
	SIF CFLAG:L_CHARA:BS부착률강화 > 0
		CFLAG:L_CHARA:BS부착률강화 -= 1
	SIF CFLAG:L_CHARA:BS부착률강화 < 0
		CFLAG:L_CHARA:BS부착률강화 += 1
	SIF CFLAG:L_CHARA:롱기누스 > 0
		CFLAG:L_CHARA:롱기누스 -= 1
	SIF CFLAG:L_CHARA:회복불능플래그 > 0
		CFLAG:L_CHARA:회복불능플래그 -= 1
	;---- EDIT 003 DEL START -------------------------
	;SIF CFLAG:L_CHARA:独覚フラグ > 0
	;	CFLAG:L_CHARA:独覚フラグ -= 1
	;---- EDIT 003 DEL END ---------------------------
	;ガードキル効果ターン減少
	FOR LCOUNT, 0, 19
		SIF CFLAG:L_CHARA:(GET_TYPE(LCOUNT)+"가드킬") > 0
			CFLAG:L_CHARA:(GET_TYPE(LCOUNT)+"가드킬") --
	NEXT
	;固有ゲージ増減
	FOR LCOUNT, 1, 21
		SIF CFLAG:L_CHARA:("고유게이지D"+TOSTR(LCOUNT)) > 0
			CFLAG:L_CHARA:("고유게이지D"+TOSTR(LCOUNT)) --
		SIF CFLAG:L_CHARA:("고유게이지D"+TOSTR(LCOUNT)) < 0
			CFLAG:L_CHARA:("고유게이지D"+TOSTR(LCOUNT)) ++
	NEXT
	;---- EDIT 040 ADD START ---------------------------
	;スキルゲージ増減
	;---- EDIT 136 ---------------------------
	CALL SKILLGAGE_D_ALL_DRIFTING, L_CHARA
	;FOR LCOUNT, 1, 51
	;	SIF CFLAG:L_CHARA:("스킬게이지D"+TOSTR(LCOUNT)) > 0
	;		CFLAG:L_CHARA:("스킬게이지D"+TOSTR(LCOUNT)) --
	;	SIF CFLAG:L_CHARA:("스킬게이지D"+TOSTR(LCOUNT)) < 0
	;		CFLAG:L_CHARA:("스킬게이지D"+TOSTR(LCOUNT)) ++
	;NEXT

	;コマンダースキルとアシストスキルのカウント減少
	FOR LCOUNT, 0, COMMANDER_SKILL_HAVEABLE_NUM
		SIF C_COMMANDER_SKILL:L_CHARA:LCOUNT == 0
			BREAK
		C_COMMANDER_SKILL_CT:L_CHARA:LCOUNT += 1
	NEXT
	FOR LCOUNT, 0, ASSIST_SKILL_HAVEABLE_NUM
		SIF C_ASSIST_SKILL:L_CHARA:LCOUNT == 0
			BREAK
		C_ASSIST_SKILL_CT:L_CHARA:LCOUNT += 1
	NEXT

	CFLAG:L_CHARA:피타겟비율변동지속턴수 = MAX(CFLAG:L_CHARA:피타겟비율변동지속턴수 - 1, 0)
	SIF CFLAG:L_CHARA:피타겟비율변동지속턴수 == 0
		CFLAG:L_CHARA:변동피타겟율 = 0
	
	;戦闘時効果をずらして顕在化するものを変える
	ARRAYREMOVE C_BTL_EFFECT:L_CHARA:0, 0, 1
	;解析度アップ
	IF FLAG:악마해석률상승불가플래그 == 0
		;解析可能な場合
		CALL INCREASE_ANALYZE,NO:(L_CHARA),5
	ENDIF
	;死亡だと自然消耗しない
	IF CFLAG:L_CHARA:상태이상 != GET_STATE_NUM("DYING") && BASE:L_CHARA:ＨＰ > 0		
		VARI SUM_REGEN_HP = 0
		VARI SUM_REGEN_MP = 0
		VARI SUM_MAGCOST = 0
		VARS L_MES
		FOR LCOUNT, 0, TRYSKILLNUM(L_CHARA)
			RESULT = 0, 0, 0
			RESULTS '= ""
			TRYCCALLFORM SKILL_REGEN_AT_TURNEND_%GET_TRYSKILL(L_CHARA, LCOUNT)%, L_CHARA
				SUM_REGEN_HP += RESULT
				SUM_REGEN_MP += RESULT:1
				SUM_MAGCOST += RESULT:2
				SIF RESULTS != ""
					L_MES += "《" + RESULTS + "》"
			CATCH
			ENDCATCH
		NEXT
		
		IF SUM_REGEN_HP > 0
			;最大HPと比較して回復量の調整
			SUM_REGEN_HP = MIN(SUM_REGEN_HP, MAX(MAXBASE:L_CHARA:ＨＰ - BASE:L_CHARA:ＨＰ,0))
			;回復しない場合はコストも飛ばす
			IF SUM_REGEN_HP > 0
				PRINTFORML %CALLNAME:L_CHARA, 20, LEFT% >>>>> ＨＰ　:{SUM_REGEN_HP,5}회복 %L_MES%
				CALL VAR_HP,L_CHARA, SUM_REGEN_HP,"회복"
			ENDIF
		ELSEIF SUM_REGEN_HP < 0
			PRINTFORML %CALLNAME:L_CHARA, 20, LEFT% >>>>> ＨＰ　:{-SUM_REGEN_HP,5}소모 %L_MES%
			CALL VAR_HP,L_CHARA, SUM_REGEN_HP,"食いしばり無効ダメージ"
		ENDIF
		IF SUM_REGEN_MP > 0
			;最大HPと比較して回復量の調整
			SUM_REGEN_MP = MIN(SUM_REGEN_MP, MAX(MAXBASE:L_CHARA:ＭＰ - BASE:L_CHARA:ＭＰ,0))
			IF SUM_REGEN_MP > 0
				PRINTFORML %CALLNAME:L_CHARA, 20, LEFT% >>>>> ＭＰ　:{SUM_REGEN_MP,5}회복 %L_MES%
				CALL VAR_MP,L_CHARA, SUM_REGEN_MP,"회복"
			ENDIF
		ELSEIF SUM_REGEN_MP < 0
			PRINTFORML %CALLNAME:L_CHARA, 20, LEFT% >>>>> ＭＰ　:{-SUM_REGEN_MP,5}소모 %L_MES%
			CALL VAR_MP,L_CHARA, SUM_REGEN_MP,"ダメージ"
		ENDIF
		;回復が発生しない場合はコストも飛ばす
		IF SUM_MAGCOST > 0 && (SUM_REGEN_HP || SUM_REGEN_MP) && CFLAG:L_CHARA:PT플래그 > 0
			VARI PAY_CHARA
			IF GET_ROLE_PROP("CAN_PUT_IN_COMP", L_CHARA) && !CFLAG:L_CHARA:ＭＡＧ자기소비
				IF GET_CHARA_STOCK_MAG(MASTER) > SUM_MAGCOST
					PAY_CHARA = MASTER
				ELSE
					PAY_CHARA = L_CHARA
				ENDIF
			ELSE
				PAY_CHARA = L_CHARA
			ENDIF
			PRINTFORML %CALLNAME:PAY_CHARA,20,LEFT% >>>>> ＭＡＧ:{SUM_MAGCOST}소비
			CALL CONTROL_MAG, PAY_CHARA, -SUM_MAGCOST
		ENDIF
		CALL SYNC_STATUS, L_CHARA, "HPMP割合保持"
	ENDIF
	;死亡していたら中断
	SIF IS_BADSTATE(L_CHARA, "DYING")
		CONTINUE
	IF CFLAG:L_CHARA:상태이상 > 0
		CFLAG:L_CHARA:상태이상경과턴수 += 1
		;バッドステータス・セービング
		CALL BADSTATUS_SAVING,L_CHARA,1;ADD 055 引数追加
		SIF RESULT
			LOCAL:2 = 20;ADD 055
		;毒ならダメージ
		IF CFLAG:L_CHARA:상태이상 == GET_STATE_NUM("POISON")
			PRINTFORML POISON [{LOCAL}] %CALLNAME:L_CHARA% >>>>> { MAX(MAXBASE:L_CHARA:ＨＰ/16,1) }데미지
			;---- EDIT 117 MOD START -------------------------
			CALL VAR_HP,L_CHARA,-MAX(MAXBASE:L_CHARA:ＨＰ/16,1),"食いしばり無効ダメージ"
			;---- EDIT 117 MOD END ---------------------------
		ENDIF
		;麻痺ならMP減少
		IF CFLAG:L_CHARA:상태이상 == GET_STATE_NUM("PALYZE") && MAXBASE:L_CHARA:ＭＰ > 0
			PRINTFORML PALYZE [{LOCAL}] %CALLNAME:L_CHARA% >>>>> { MAX(MAXBASE:L_CHARA:ＭＰ/16,1) }ＭＰ 감소
			CALL VAR_MP,L_CHARA,-MAX(MAXBASE:L_CHARA:ＭＰ/16,1),"ダメージ"
		ENDIF
		;炎上ならダメージ
		;---- EDIT 064 ADD START ---------------------------
		IF CFLAG:L_CHARA:상태이상 == GET_STATE_NUM("FLAME")
			IF AUTO_PU_SKILL_ラグナロク（ＡＮ）(L_CHARA,"状態異常増大") > 0
				RESULT = AUTO_PU_SKILL_ラグナロク（ＡＮ）(L_CHARA,"状態異常増大")
				PRINTFORML FLAME [{LOCAL}] %CALLNAME:L_CHARA% >>>>> 황혼의 겁화가 몸을 태운다！ { RESULT }데미지
				CALL VAR_HP,L_CHARA,-(RESULT),"ダメージ"
			ELSE
				PRINTFORML FLAME [{LOCAL}] %CALLNAME:L_CHARA% >>>>> 불타고 있다！ { MAX(MAXBASE:L_CHARA:ＨＰ/10,1) }데미지
				;---- EDIT 117 MOD START -------------------------
				CALL VAR_HP,L_CHARA,-MAX(MAXBASE:L_CHARA:ＨＰ/10,1),"食いしばり無効ダメージ"
				;---- EDIT 117 MOD END ---------------------------
			ENDIF
		ENDIF
		;---- EDIT 064 ADD END ---------------------------
	ENDIF
NEXT
IF TEMP_LINE != LINECOUNT
	CUSTOMDRAWLINE =
	WAIT
ENDIF
FOR LOCAL,1,17
	L_CHARA = POS(LOCAL)
	SIF !IS_TARGET_ABLE(L_CHARA)
		CONTINUE
	KOJO_PATTERN = 0
	;---- EDIT 023 ADD START -------------------------
	;エクスリンケージをインスコ中でムフフONならば戦闘中欲情増加処理
	IF FLAG:무후후전개 && SOFT_ON("엑스링케이지")
		SELECTCASE GET_STATE(CFLAG:L_CHARA:상태이상)
			CASE "DYING","STONE","PALYZE","BIND","FREEZE","SHOCK","SLEEP"
				;ヒート、スリップ以外の行動不可状態チェック。それ以外ならELSEで処理
			CASEELSE
				;CFLAG:ダンジョン内発情用欲情値が15000以下の場合
				IF CFLAG:L_CHARA:던전내발정용욕정치 < 15000
					;精液の箇所ひとつに付き欲情が精液中毒ＬＶ分増える
					CFLAG:L_CHARA:던전내발정용욕정치 += GET_STAIN("질내" , "精液" , L_CHARA) * ABL:L_CHARA:정액중독
					CFLAG:L_CHARA:던전내발정용욕정치 += GET_STAIN("바기나" , "精液" , L_CHARA) * ABL:L_CHARA:정액중독
					CFLAG:L_CHARA:던전내발정용욕정치 += GET_STAIN("입" , "精液" , L_CHARA) * ABL:L_CHARA:정액중독
					CFLAG:L_CHARA:던전내발정용욕정치 += GET_STAIN("손" , "精液" , L_CHARA) * ABL:L_CHARA:정액중독
					CFLAG:L_CHARA:던전내발정용욕정치 += GET_STAIN("가슴" , "精液" , L_CHARA) * ABL:L_CHARA:정액중독
					CFLAG:L_CHARA:던전내발정용욕정치 += GET_STAIN("애널" , "精液" , L_CHARA) * ABL:L_CHARA:정액중독
					CFLAG:L_CHARA:던전내발정용욕정치 += GET_STAIN("머리카락" , "精液" , L_CHARA) * ABL:L_CHARA:정액중독
					;アソコと乳首が露出していると露出癖ＬＶ分欲情が増える
					SIF TEQUIP:L_CHARA:유두노출 == -1
						CFLAG:L_CHARA:던전내발정용욕정치 += ABL:L_CHARA:노출증
					SIF TEQUIP:L_CHARA:음순노출 == -1
						CFLAG:L_CHARA:던전내발정용욕정치 += ABL:L_CHARA:노출증
	
					SIF 위험일(L_CHARA) == 2
						CFLAG:L_CHARA:던전내발정용욕정치 += 2 * ABL:L_CHARA:욕망
					;HAPPYなら欲望ＬＶ分の欲情値上昇
					SIF CFLAG:L_CHARA:상태이상 == GET_STATE_NUM("HAPPY")
						CFLAG:L_CHARA:던전내발정용욕정치 += 2 * ABL:L_CHARA:욕망
					;CHARMなら奉仕精神と欲望ＬＶ×１．５分の欲情値上昇
					SIF CFLAG:L_CHARA:상태이상 == GET_STATE_NUM("CHARM")
						CFLAG:L_CHARA:던전내발정용욕정치 += (3 * (ABL:L_CHARA:욕망 + ABL:L_CHARA:봉사정신)) /2
					;CFLAG:ダンジョン内発情用欲情値の上限は15000
					SIF CFLAG:L_CHARA:던전내발정용욕정치 > 15000
						CFLAG:L_CHARA:던전내발정용욕정치 = 15000
				ENDIF
				
				;膣内が精液で汚れている場合は10％の確率でヴァギナに汚れが付く
				IF GET_STAIN("질내" , "精液" , L_CHARA) && GET_STAIN("바기나" , "精液" , L_CHARA) == 0 && RAND:100 < 10
					SETCOLOR COLOR("pink")
					PRINTFORMW %CALLNAME:L_CHARA%의 안에 쏟아진 정액이 흘러나왔다…
					RESETCOLOR
					CALL SET_STAIN("바기나" , "精液" , L_CHARA)
					;三分の一の確立で膣内の汚れ消去
					SIF RAND:3 == 0
						STAIN:L_CHARA:질내 = 0
					KOJO_PATTERN = 3;ADD 055
				ENDIF
			
				;欲情一定値以下、かつHAPPY、CHARMでなければ発情終了
				IF  CFLAG:L_CHARA:던전내발정용욕정치 < 2000 && CFLAG:L_CHARA:던전내발정 && GET_STATE(CFLAG:L_CHARA:상태이상) != "CHARM" && GET_STATE(CFLAG:L_CHARA:상태이상) != "HAPPY"
					CFLAG:L_CHARA:던전내발정 = 0
					PRINTFORMW %조사처리(CALLNAME:L_CHARA, "는")% 진정되었다
					KOJO_PATTERN = 1;ADD 055
				ENDIF
		
				;欲情が10000以上になると発情
				IF (!TALENT:L_CHARA:남자 || TALENT:L_CHARA:오토코노코) && !CFLAG:L_CHARA:던전내발정 && CFLAG:L_CHARA:던전내발정용욕정치 >= 10000
					CFLAG:L_CHARA:던전내발정 = 1
					CALL SET_STAIN("질내" , "愛液" , L_CHARA)
					CALL SET_STAIN("바기나" , "愛液" , L_CHARA)
					SETCOLOR COLOR("pink")
					PRINTFORMW %조사처리(CALLNAME:L_CHARA, "는")% 머릿속이 핑크빛으로 물들었다
					RESETCOLOR
					KOJO_PATTERN = 2;ADD 055
				;発情状態の時に10％の確率でHAPPYになる
				ELSEIF RAND:100 < 10 && CFLAG:L_CHARA:던전내발정 && CFLAG:L_CHARA:상태이상 == 0
					CFLAG:L_CHARA:상태이상 = GET_STATE_NUM("HAPPY")
					KOJO_PATTERN = 2;ADD 055
				ENDIF
				;素質『발정가능』を持っていると魅了状態時に10％の確率で発情する
				IF TALENT:L_CHARA:남자 == 0 && CFLAG:L_CHARA:상태이상 == GET_STATE_NUM("CHARM") && TALENT:L_CHARA:발정가능 && CFLAG:L_CHARA:던전내발정 == 0 && RAND:100 < 10
					CFLAG:L_CHARA:던전내발정 = 1
					CALL SET_STAIN("질내" , "愛液" , L_CHARA)
					CALL SET_STAIN("바기나" , "愛液" , L_CHARA)
					SETCOLOR COLOR("pink")
					PRINTFORMW %조사처리(CALLNAME:L_CHARA, "는")% 머릿속이 핑크빛으로 물들었다
					RESETCOLOR
					KOJO_PATTERN = 2;ADD 055
				ENDIF
		ENDSELECT
	ENDIF
	IF KOJO_PATTERN == 0
		CALL BATTLE_EVENT, "ターン終了時口上", L_CHARA
	ELSEIF KOJO_PATTERN == 1
		CALL BATTLE_EVENT, "ターン終了時エクスリンケージ装備時のイベント口上", L_CHARA
	ELSEIF KOJO_PATTERN == 2
		SETCOLOR COLOR("pink")
		CALL BATTLE_EVENT, "ターン終了時エクスリンケージ装備時のイベント口上", L_CHARA
	ELSEIF KOJO_PATTERN == 3
		SETCOLOR COLOR("pink")
		CALL BATTLE_EVENT, "ターン終了時エクスリンケージ装備時のイベント口上2", L_CHARA
	ENDIF
	RESETCOLOR
NEXT
