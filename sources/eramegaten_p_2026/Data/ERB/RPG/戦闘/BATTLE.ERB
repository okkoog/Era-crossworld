;---- EDIT 088 ADD STATR 行動後のフラグ処理の関数化-----------------------------
;ゲージ獲得処理より遅いとメッセージ的に問題が出てくるので独立させる
@BATTLE_BARRIER_BREAK
#DIM L_T
#DIM LCOUNT, 2
#DIM IS_BREAK;ブレイクが成立したかどうか。立っていれば最後にWAITが入る
;ブレイク系処理
IS_BREAK = 0
FOR LCOUNT,0, BCHARANUM
	L_T = BCHARA:LCOUNT
	IF (GETBIT(TFLAG:테트라브레이크,0) && CFLAG:L_T:PT플래그 == 0) || (GETBIT(TFLAG:테트라브레이크,1) && CFLAG:L_T:PT플래그 > 0)
		IF CFLAG:L_T:물리반사플래그 > 0
			PRINTFORML 　　TARGET:[{CPOS(L_T),2}] %CALLNAME:L_T,20,LEFT% >>>>>> 물리반사 상태를 해제！
			IS_BREAK = 1
		ENDIF
		CFLAG:L_T:물리반사플래그 = 0
	ENDIF
	IF (GETBIT(TFLAG:마카라브레이크,0) && CFLAG:L_T:PT플래그 == 0) || (GETBIT(TFLAG:마카라브레이크,1) && CFLAG:L_T:PT플래그 > 0)
		IF CFLAG:L_T:마법반사플래그 > 0
			PRINTFORML 　　TARGET:[{CPOS(L_T),2}] %CALLNAME:(L_T),20,LEFT% >>>>>> 마법반사 상태를 해제！
			IS_BREAK = 1
		ENDIF
		CFLAG:L_T:마법반사플래그 = 0
	ENDIF
	;---- EDIT 089 MOD START -------------------------GET_TYEPE() GET_STATE()にL_Tを送っていたのをLCOUNT:1に
	IF (GETBIT(TFLAG:실드브레이크,0) && CFLAG:L_T:PT플래그 == 0) || (GETBIT(TFLAG:실드브레이크,1) && CFLAG:L_T:PT플래그 > 0)
		IF CFLAG:L_T:수호의방패 > 0
			PRINTFORML 　　TARGET:[{CPOS(L_T),2}] %CALLNAME:(L_T),20,LEFT% >>>>>> 만능 이외 무효화 상태를 해제！
			IS_BREAK = 1
		ENDIF
		CFLAG:L_T:수호의방패 = 0
		FOR LCOUNT:1 , 0 , TYPENUM
			IF CFLAG:L_T:@"%GET_TYPE(LCOUNT:1)%무효화횟수" > 0
				PRINTFORML 　　TARGET:[{CPOS(L_T),2}] %CALLNAME:(L_T),20,LEFT% >>>>>> %GET_TYPE(LCOUNT:1)% 무효화 상태를 해제！
				IS_BREAK = 1
			ENDIF
			CFLAG:L_T:@"%GET_TYPE(LCOUNT:1)%무효화횟수" = 0
		NEXT
	ENDIF
	IF (GETBIT(TFLAG:배리어브레이크,0) && CFLAG:L_T:PT플래그 == 0) || (GETBIT(TFLAG:배리어브레이크,1) && CFLAG:L_T:PT플래그 > 0)
		IF CFLAG:L_T:성스러운가호 > 0
			PRINTFORML 　　TARGET:[{CPOS(L_T),2}] %CALLNAME:(L_T),20,LEFT% >>>>>> 모든 상태이상 무효화 상태를 해제！
			IS_BREAK = 1
		ENDIF
		CFLAG:L_T:성스러운가호 = 0
	ENDIF
	;ガードキルブレイクは敵のみ
	IF TFLAG:가드킬브레이크 > 0 && CFLAG:L_T:PT플래그 == 0
		FOR LCOUNT:1 , 0 , TYPENUM
			IF CFLAG:L_T:(GET_TYPE(LCOUNT:1)+"가드킬") > 0
				PRINTFORML 　　TARGET:[{CPOS(L_T),2}] %CALLNAME:(L_T),20,LEFT% >>>>>> %GET_TYPE(LCOUNT:1)% 가드킬을 해제！
				IS_BREAK = 1
			ENDIF
			CFLAG:L_T:(GET_TYPE(LCOUNT:1)+"가드킬") = 0
		NEXT
	ENDIF
	;---- EDIT 089 MOD END ---------------------------
NEXT
;メッセージ表示待ちのWAIT
SIF IS_BREAK > 0
	WAIT
