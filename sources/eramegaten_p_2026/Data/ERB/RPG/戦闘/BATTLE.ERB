;====================================================
;行動を正しい状態にする。
;ARG = キャラ登録番号
;
;RESULT = ターゲットを正しい状態にできたら真
;====================================================
@CORRECT_ACTION, L_CHARA, USEABLE_GUARD
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC USEABLE_GUARD
#DIM DYNAMIC COUNT_LINKNUM
#DIM DYNAMIC LINK_CHARA
IF CFLAG:L_CHARA:입력행동 >= 0 && ACTIONABLE_CHARA_F(L_CHARA)
	CALL CHECK_ACTIONABLE,L_CHARA,CFLAG:L_CHARA:입력행동
	IF RESULT
		;リンケージの場合、全員が条件を満たせないと終了
		IF CFLAG:L_CHARA:링케이지발동 && INRANGE(CFLAG:L_CHARA:입력행동,MIN_LINKAGENUM,MAX_LINKAGENUM)
			CALLFORM 参加人数_{CFLAG:L_CHARA:입력행동}
			FOR LCOUNT , 1, RESULT
				LINK_CHARA = CFLAG:L_CHARA:@"링케이지참가자{LCOUNT}"
				SIF INRANGE(LINK_CHARA,0,CHARANUM) == 0
					GOTO UNABLE_ACT
				CALL リンケージ参加者条件確認, CFLAG:L_CHARA:입력행동, LINK_CHARA , LCOUNT
				SIF RESULT == 0
					GOTO UNABLE_ACT
				CALL ACTIONABLE_CHARA,LINK_CHARA
				SIF RESULT == 0
					GOTO UNABLE_ACT
				SIF CFLAG:LINK_CHARA:PT플래그 < 2
					GOTO UNABLE_ACT
			NEXT
		ENDIF
		CALL IS_CORRECT_ACT_SPHERE, L_CHARA
		IF RESULT
			CALL IS_CORRECT_ACT_TARGET, L_CHARA
			SIF RESULT
				RETURN 1
		ENDIF
		IF GROUPMATCH(CFLAG:L_CHARA:타겟, 18, 21)
			CFLAG:L_CHARA:타겟 -= 1
			RETURN 1
		ELSE
			;ターゲットをランダムに決めなおす
			CALL RANDOM_TARGET,L_CHARA,CFLAG:L_CHARA:입력행동
			SIF RESULT
				RETURN 1
		ENDIF
	ENDIF
ENDIF

$UNABLE_ACT

;ここまできたら行動できないので入力行動を消す
CFLAG:L_CHARA:입력행동 = -1
;GUARDを選べるタイミングの場合はGUARD判定
IF USEABLE_GUARD
	;状態異常で行動不能かどうかでわける
	IF ACTIONABLE_CHARA_F(L_CHARA)
		CFLAG:L_CHARA:방어플래그 = 1
	ELSE
		CFLAG:L_CHARA:방어플래그 = 0
	ENDIF
ENDIF
RETURN 0

;====================================================
;行動の判定指定が正しく存在しているか判定する
;ARG = キャラ登録番号
;
;RESULT = 正しい状態なら真
;====================================================
@IS_CORRECT_ACT_SPHERE, L_CHARA
#DIM DYNAMIC L_CHARA
SIF CFLAG:L_CHARA:입력행동 == -1
	RETURN 1
SIF CFLAG:L_CHARA:방어플래그
	RETURN 1

CALL GET_SKILL_PROP, "SKILL_T_RESERVE", CFLAG:L_CHARA:입력행동, L_CHARA
SIF RESULT
	RETURN 1

;範囲が特殊なものは素通しにする
RESULT = 0
CALL GET_SKILL_PROP, "SKILL_TARGET", CFLAG:L_CHARA:입력행동, L_CHARA
SIF GROUPMATCH(GET_SKILL_TARGET(RESULT), "특수", "자신")
	RETURN 1

CALL GET_SKILL_PROP, "SKILL_SPHERE", CFLAG:L_CHARA:입력행동,L_CHARA
SELECTCASE RESULT
	CASE 1, 5
		SIF INRANGE(CFLAG:L_CHARA:타겟, 1, 16)
			RETURN 1
	CASE 2
		SIF GROUPMATCH(CFLAG:L_CHARA:타겟, 17, 18, 20, 21)
			RETURN 1
	CASE 3
		SIF GROUPMATCH(CFLAG:L_CHARA:타겟, 19, 22)
			RETURN 1
	CASE 4
		SIF CFLAG:L_CHARA:타겟 == 23
			RETURN 1
	CASEELSE
		RETURN 0
ENDSELECT


;---- EDIT 102 ADD START -------------------------
;---- EDIT 133 MOD START -------------------------
;====================================================
;行動の対象が正しく存在しているか判定する
;ARG = キャラ登録番号
;
;RESULT = ターゲットの存在しているなら真
;====================================================
@IS_CORRECT_ACT_TARGET, ARG
#DIM DYNAMIC LCOUNT
CALL GET_SKILL_PROP, "SKILL_T_RESERVE", CFLAG:ARG:입력행동, ARG
IF RESULT
	SIF !INRANGE(CFLAG:ARG:타겟, 0, CHARANUM -1)
		RETURN 0
	CALL GET_SKILL_PROP, "SKILL_TARGETABLE", CFLAG:ARG:입력행동, ARG, CFLAG:ARG:타겟
	SIF RESULT == 0
		RETURN 0
ELSE
	IF CFLAG:ARG:타겟 < 1 || CFLAG:ARG:타겟 > 23
		;ありえないターゲットをしている
		PRINTFORMW 오류：%NAME:ARG%의 행동 {CFLAG:ARG:입력행동}의 타겟이 올바르지 않습니다 → {CFLAG:ARG:타겟}
		PRINTFORMW 스킬이 사용 가능하다면 타겟을 다시 결정합니다
		RETURN 0
	ELSEIF CFLAG:ARG:타겟 < 17
		IF CFLAG:ARG:소환예정캐릭터 < 1 && CFLAG:ARG:입력행동 != [[스킬:ＣＨＡＮＧＥ]]
			;LOCALS = 포지션{CFLAG:ARG:타겟}
			IF POS(CFLAG:ARG:타겟) == -1
				RETURN 0
			ELSE
				CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
				IF GROUPMATCH(GET_SKILL_EFFECT(RESULT), "공격", "상태변화", "특수") && CFLAG:POS(CFLAG:ARG:타겟):상태이상 == GET_STATE_NUM("DYING")
					;居ない場合はスキル使用可能かを判定
					CALL CHECK_ACTIONABLE,ARG,CFLAG:ARG:입력행동
					;不可の場合行動済み処理
					SIF RESULT == 0
						RETURN 0
					;可能な場合はターゲットをランダムに決めなおす
					CALL RANDOM_TARGET,ARG,CFLAG:ARG:입력행동
					SIF RESULT == 0
						RETURN 0
				;ELSEIF RESULT == 2 && CFLAG:POS(CFLAG:ARG:타겟):상태이상 == GET_STATE_NUM("DYING")
				ELSEIF GET_SKILL_EFFECT(RESULT) == "회복" && CFLAG:POS(CFLAG:ARG:타겟):상태이상 == GET_STATE_NUM("DYING")
					;死体に対して使えるチェック
					CALL GET_SKILL_PROP, "SKILL_TARGETABLE", CFLAG:ARG:입력행동, ARG, POS(CFLAG:ARG:타겟)
					SIF RESULT > 0
						RETURN 1
					;使えないなら振替チェック
					CALL RANDOM_TARGET,ARG,CFLAG:ARG:입력행동
					SIF RESULT == 0
						RETURN 0
				ENDIF
			ENDIF
		ENDIF
	;後列指定は後列がいるかどうかをチェック
	ELSEIF GROUPMATCH(CFLAG:ARG:타겟, 18, 21)
		FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:타겟), GET_POS_MAX(CFLAG:ARG:타겟) + 1
			SIF !IS_TARGET_ABLE(POS(LCOUNT))
				CONTINUE
			RETURN 1
		NEXT
		RETURN 0
	ENDIF
ENDIF
RETURN 1
