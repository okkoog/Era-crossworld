#DIM L_GET_EXP
#DIM L_ENEMY
#DIM L_ENEMY_RACE
#DIM L_ENEMY_LV
IF L_ENEMY >= 0
	L_ENEMY_RACE = ABL:L_ENEMY:종족
	L_ENEMY_LV = BASE:L_ENEMY:LV
ENDIF
L_GET_EXP = COEFFICIENT_EXP(L_ENEMY_RACE)
L_GET_EXP = L_GET_EXP * L_ENEMY_LV * (4+L_ENEMY_LV/4) / 4
SIF L_ENEMY >= 0
	L_GET_EXP = L_GET_EXP * CFLAG:L_ENEMY:ＥＸＰ보정 / 100
SIF L_ENEMY >= 0 && CFLAG:L_ENEMY:보스플래그
	L_GET_EXP *= 4
RETURNF L_GET_EXP

;経験値に対してLV差補正をかけてから返す関数
@MULTI_LEVEL_CORRECTION_TO_EXP, L_GET_EXP, L_FRIEND = -1, L_ENEMY = -1, L_FRIEND_LV, L_ENEMY_LV
#FUNCTION
#DIM L_GET_EXP
#DIM L_FRIEND
#DIM L_ENEMY
#DIM L_FRIEND_LV
#DIM L_ENEMY_LV
#DIM TEMP
SIF L_FRIEND >= 0
	L_FRIEND_LV = BASE:L_FRIEND:LV
SIF L_ENEMY >= 0
	L_ENEMY_LV = BASE:L_ENEMY:LV

;味方のレベルが高く、減少を補正を受ける場合は4レベル毎に1/2
;マインドシーカーは1段階緩和する
TEMP = 2 + L_ENEMY_LV
;マインドシーカーによってアンノウンフラグが立てられている場合
SIF L_ENEMY >= 0 && CFLAG:L_ENEMY:언노운플래그
	TEMP += 4
SIF L_FRIEND_LV > TEMP
	L_GET_EXP /= POWER(2 , MIN((L_FRIEND_LV - TEMP) / 4 + 1, 30))

;レベル差補正による増加は4レベル毎に2倍
IF L_FRIEND_LV < L_ENEMY_LV
	L_GET_EXP *= POWER(3, MIN((L_ENEMY_LV - L_FRIEND_LV)/4, 4))
	L_GET_EXP /= POWER(2, MIN((L_ENEMY_LV - L_FRIEND_LV)/4, 4))
ENDIF
RETURNF L_GET_EXP
