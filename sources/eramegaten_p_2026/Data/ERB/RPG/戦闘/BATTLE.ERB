	;----------------------------------------------------------------
	;COOP追撃
	;----------------------------------------------------------------	
	VARI L_P
	VARS TEMP_SKILL
	VARI TEMPNUM
	VARS EXTRA_COOP, 50
	VARI EXTRA_COOP_RATE, 50
	VARI EXTRA_COOP_ACTOR, 50
	VARSET EXTRA_COOP
	VARSET EXTRA_COOP_RATE
	VARSET EXTRA_COOP_ACTOR
	FOR LCOUNT:1, 1, 7
		L_P = POS(LCOUNT:1)
