@GET_BASE_ENEMY_MAG, L_ENEMY = -1, L_ENEMY_LV, L_ENEMY_RACE
#FUNCTION
#DIM L_GET_MAG
#DIM L_ENEMY
#DIM L_ENEMY_RACE
#DIM L_ENEMY_LV
IF L_ENEMY >= 0
	L_ENEMY_RACE = ABL:L_ENEMY:종족
	L_ENEMY_LV = BASE:L_ENEMY:LV
ENDIF

L_GET_MAG = COEFFICIENT_MAG(L_ENEMY_RACE) 
L_GET_MAG = L_GET_MAG * L_ENEMY_LV * (1+L_ENEMY_LV/8) * 4/5
SIF L_ENEMY >= 0
	L_GET_MAG = L_GET_MAG * CFLAG:L_ENEMY:ＭＡＧ보정 / 100
RETURNF L_GET_MAG
