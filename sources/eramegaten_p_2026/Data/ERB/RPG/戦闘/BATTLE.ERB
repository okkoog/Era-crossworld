;===================================
;決着判定
;勝敗のフラグを判定して立てる
;いずれかの決着がついている場合に1を返す
;===================================
@FIGHT_IT_OUT
#LOCALSIZE 3
#LOCALSSIZE 1
;---- EDIT 103 ADD START -------------------------
;すでに決着が確定していたら終わる
SIF FLAG:승리플래그 || FLAG:패배플래그 || FLAG:도주플래그
	RETURN 1
;---- EDIT 103 ADD END ---------------------------
;特殊判定
RESULT = 0
TRYCCALLFORM FIGHT_IT_OUT_%TSTR:전투이벤트패턴%
CATCH
	SELECTCASE FLAG:SHOP커맨드
		CASE [[ショップ:탐색]]
			TRYCALLFORM FIGHT_IT_OUT_DUNGEON{FLAG:현던전}
		CASE [[ショップ:콜로세움참가]]
			TRYCALLFORM FIGHT_IT_OUT_COLOSSEUM{FLAG:진행중콜로세움}
		CASE [[ショップ:이벤트]]
			TRYCALLFORM FIGHT_IT_OUT_EVENT{FLAG:진행중이벤트}
		CASE [[ショップ:의뢰청부]]
			TRYCALLFORM FIGHT_IT_OUT_REQUEST{FLAG:진행중의뢰}
		;---- EDIT 068 MOD START -------------------------
		CASE [[ショップ:개별이벤트]]
			TRYCALLFORM FIGHT_IT_OUT_INDIVIDUALEVENT_K{FLAG:개별이벤트캐릭}
		;---- EDIT 068 MOD END   -------------------------
	ENDSELECT
ENDCATCH
;特殊判定で勝敗が確定していたら終わる
SIF FLAG:승리플래그 || FLAG:패배플래그 || FLAG:도주플래그
	RETURN 1
;特殊判定で戻り値が真の場合は通常判定を実行させずに打ち切る
SIF RESULT
	RETURN 0
;LOCAL 敵パーティの戦闘不能じゃない人数
LOCAL = 0
FOR LOCAL:1,0,10
	LOCALS = 포지션{LOCAL:1+7}
	SIF FLAG:LOCALS < 0
		CONTINUE
	SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING" || GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "STONE"
		CONTINUE
	LOCAL = 1
	BREAK
NEXT
SIF LOCAL == 0
	FLAG:승리플래그 = 1
CALL FIGHT_IT_OUT_LOSE

;敗北判定
@FIGHT_IT_OUT_LOSE
;---- EDIT 070 MOD START -------------------------
;MASTERがパーティにいるかどうか
LOCAL:2 = 0
;MASTERがパーティにいる
SIF CFLAG:MASTER:PT플래그 == 2
	LOCAL:2 = 1
;---- EDIT 070 MOD END -------------------------

;EDIT 072：ソフト「데드엔드」があるとあなたが死ぬと即ゲームオーバー
;PTにあなたがおり、デッドエンドをインストしており、あなたがDYINGまたはSTONEである
SIF LOCAL:2 == 1 && SOFT_ON("데드엔드") && (GET_STATE(CFLAG:MASTER:상태이상) == "DYING" || GET_STATE(CFLAG:MASTER:상태이상) == "STONE")
	FLAG:패배플래그 = 1

LOCAL = 0
FOR LOCAL:1,1,7
	LOCALS = 포지션{LOCAL:1}
	;ポジションにキャラがいなければ戻る
	SIF FLAG:LOCALS < 0
		CONTINUE
	;マスターがPTに存在し、今見ているのがマスターでなく、かつ陥落していなければ戻る
	;EDIT 072：ソフト「데스마치」があれば陥落状況を問わない(陥落しておらずデスマーチをインストしていない)
	SIF LOCAL:2 == 1 && MASTER != FLAG:LOCALS && !陥落(FLAG:LOCALS) && !SOFT_ON("데스마치")
		CONTINUE
	;キャラがDEADまたはSTONEなら戻る
	SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING" || GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "STONE"
		CONTINUE
	;ここまで通過できれば「生存している」判定
	LOCAL = 1
	BREAK
NEXT
SIF LOCAL == 0
	FLAG:패배플래그 = 1
RETURN FLAG:승리플래그 || FLAG:패배플래그 || FLAG:도주플래그;EDIT103 MOD
