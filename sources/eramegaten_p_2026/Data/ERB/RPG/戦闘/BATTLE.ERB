;入手したＭＡＧを分配
;主人が５０％　※20230301 挙動とコメントにくい違いがある
;実際の挙動は主人が100%を取り、さらに総獲得量の25%相当のMAGがPTメンバー向けに湧いてきている
CFLAG:MASTER:입수ＭＡＧ = FLAG:입수ＭＡＧ

;仲魔の基礎獲得値
VARI BASE_GET_MAG
BASE_GET_MAG = CFLAG:MASTER:입수ＭＡＧ * 25 / 100
FOR LCOUNT,1,7
	;---- EDIT 113 ADD START -------------------------
	L_FRIEND = POS(LCOUNT)
	SIF L_FRIEND < 0
		CONTINUE
	IF CFLAG:L_FRIEND:MAG링크
		SIF CPOS(FINDCHARA_TIMEID(CFLAG:L_FRIEND:피링크캐릭터실제가입시간)) > 0
			CONTINUE
	ENDIF
	IF L_FRIEND == MASTER
		;魅せる殺戮は10% * 20で1.1倍まで
		CFLAG:L_FRIEND:입수ＭＡＧ = CFLAG:L_FRIEND:입수ＭＡＧ * MIN((CFLAG:L_FRIEND:매혹적인살육플래그 * 10 + 100), 200) / 100
	ELSE
		L_GET_MAG = BASE_GET_MAG / (FRIEND_NUM - (CPOS(MASTER) > 0))
		;霊媒体質は1.5倍補正
		SIF GET_BTL_TALENT_LV("영매체질", L_FRIEND)
			TIMES L_GET_MAG, 1.50
		;PTからの魅せる殺戮は10%*10で2倍まで
		L_GET_MAG = L_GET_MAG * MIN((CFLAG:L_FRIEND:매혹적인살육플래그 * 10 + 100), 200) / 100
		CFLAG:L_FRIEND:입수ＭＡＧ = L_GET_MAG
	ENDIF
	VARI LINK_CHARA
	IF !IS_BADSTATE(L_FRIEND, "DYING")
		FOR LCOUNT:1, 0, LINKCHARANUM
			LINK_CHARA = FINDCHARA_LINK(L_FRIEND, LCOUNT:1)
			SIF LINK_CHARA < 0
				CONTINUE
			SIF CPOS(LINK_CHARA) > 0
				CONTINUE
			SIF CFLAG:LINK_CHARA:MAG링크
				CONTINUE
			L_GET_MAG = BASE_GET_MAG / 5
			SIF GET_BTL_TALENT_LV("영매체질", LINK_CHARA)
				TIMES L_GET_MAG, 1.50	
			;PTからの魅せる殺戮は10%*10で2倍まで
			L_GET_MAG = L_GET_MAG * MIN((CFLAG:L_FRIEND:매혹적인살육플래그 * 10 + 100), 200) / 100
			CALL CONTROL_MAG, LINK_CHARA, L_GET_MAG
		NEXT
	ENDIF
NEXT
;戦闘に参加可能なキャラは合体時にボーナスとして追加されるMAGを獲得する(5人割時の半分)
FOR LCOUNT, 0, BCHARANUM
	SIF IS_BADSTATE(BCHARA:LCOUNT, "DYING")
