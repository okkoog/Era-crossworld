;---- EDIT 055 MOD バステのターン終了時の口上処理追加 -------------------------
;===================================
;バッドステータスの自動回復
;===================================
@BADSTATUS_SAVING,ARG,ARG:1 = 0;ADD 055 引数追加
;ARG	キャラ番号
;ARG:1	口上の表示　0-しない 1-する
#LOCALSIZE 2
LOCAL = RAND:100
LOCAL:1 = 0
SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
	CASE "HAPPY","PANIC","SLEEP"
		;HAPPY
		IF LOCAL > 95
		ELSEIF  (CFLAG:ARG:보스플래그 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 20 -10) || (CFLAG:ARG:보스플래그 == 0 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 20 -30) || LOCAL < 5
			LOCAL:1 = 1
		ENDIF
	CASE "SHOCK","FREEZE"
		;SHOCK,FREEZE 必ず治る
		LOCAL:1 = 1
	CASE "SLIP"
		;SLIP
		IF CFLAG:ARG:SLIP중중력피탄플래그 > 0 && ((CFLAG:ARG:보스플래그 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 45) || (CFLAG:ARG:보스플래그 == 0 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 35))
			LOCAL:1 = 1
		ELSEIF (CFLAG:ARG:보스플래그 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 45 +50) || (CFLAG:ARG:보스플래그 == 0 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 35 +45) || LOCAL < 5
			LOCAL:1 = 1
		ENDIF
	CASE "BIND","BOMB"
		;BIND
		IF LOCAL > 95
		ELSEIF (CFLAG:ARG:보스플래그 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 5 + 30) || (CFLAG:ARG:보스플래그 == 0 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 5 + 20) || LOCAL < 5
			LOCAL:1 = 1
		ENDIF
	CASE "CLOSE"
		;CLOSE
		IF LOCAL > 95
		ELSEIF (CFLAG:ARG:보스플래그 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 5 + 40) || (CFLAG:ARG:보스플래그 == 0 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 5 + 15) || LOCAL < 5
			LOCAL:1 = 1
		ENDIF
	CASE "POISON","BRAND","CURSE"
		;POISON,BRAND,CURSE ボス以外治らない
		IF LOCAL > 95
		ELSEIF (CFLAG:ARG:보스플래그 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 10)
			LOCAL:1 = 1
		ENDIF
	;---- EDIT 064 ADD START ---------------------------
	CASE "CHARM"
		;CHARM
		IF LOCAL > 95
		ELSEIF (CFLAG:ARG:보스플래그 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 5 + 30) || (CFLAG:ARG:보스플래그 == 0 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 10 - 20) || LOCAL < 5
			LOCAL:1 = 1
		ENDIF
	CASE "FLAME"
		;FLAME
		IF LOCAL > 95
		ELSEIF AUTO_PU_SKILL_ラグナロク（ＡＮ）(ARG,"状態異常延長") > 0
		ELSEIF (CFLAG:ARG:보스플래그 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 5 + 30) || (CFLAG:ARG:보스플래그 == 0 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 10 - 20) || LOCAL < 5
			LOCAL:1 = 1
		ENDIF
	;---- EDIT 064 ADD END ---------------------------
	CASE "PALYZE"
		;PALYZE
		IF LOCAL > 95
		ELSEIF (CFLAG:ARG:보스플래그 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 10 + 15) || (CFLAG:ARG:보스플래그 == 0 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 20 - 40) || LOCAL < 5
			LOCAL:1 = 1
		ENDIF
	CASE "STONE"
		;STON ボス以外治らない
		IF LOCAL > 95
		ELSEIF (CFLAG:ARG:보스플래그 && LOCAL < CFLAG:ARG:상태이상경과턴수 * 40)
			LOCAL:1 = 1
		ENDIF
	CASE "DYING"
		;DYING 治らない
		RETURN 0
	CASE "FLY"
		;3ターンは必ず続く
		IF LOCAL > 95
		ELSEIF CFLAG:ARG:보스플래그 || LOCAL < CFLAG:ARG:상태이상경과턴수 * 20 || LOCAL < 5
			;TFLAG:전투이벤트 = 50
			SIF ARG:1 == 1
				CALL BATTLE_EVENT, "バステ自然回復", ARG
			CFLAG:ARG:상태이상 = 0
			CFLAG:ARG:상태이상경과턴수 = 0
			CALL SYNC_STATUS,ARG
			RETURN ARG:1
		ENDIF
		
	CASE "ORGY","HEAT"
		;ORGY,HEAT ３ターンで確実に次へ移行
		IF CFLAG:ARG:상태이상경과턴수 > 2
			IF GET_STATE(CFLAG:ARG:상태이상) == "ORGY"
				CFLAG:ARG:상태이상 = GET_STATE_NUM("HEAT")
				CFLAG:ARG:상태이상경과턴수 = 0
				LOCAL:1 = -1
			ELSE
				LOCAL:1 = 1
			ENDIF
		ENDIF
	CASEELSE
		RETURN 0
ENDSELECT
IF LOCAL:1 == 1
	;TFLAG:전투이벤트 = 50
	SIF ARG:1 == 1
		CALL BATTLE_EVENT, "バステ自然回復", ARG
	CFLAG:ARG:상태이상 = 0
	CFLAG:ARG:상태이상경과턴수 = 0
	RETURN ARG:1
ELSEIF LOCAL:1 == -1
	;TFLAG:전투이벤트 = 52
	SIF ARG:1 == 1
		CALL BATTLE_EVENT, "HEAT移行", ARG
	RETURN ARG:1
ENDIF
RETURN 0




;===================================
;逃亡判定
;===================================
@ESCAPE_CHECK
#LOCALSIZE 8
#DIM DYNAMIC SUM_STAT_FRIEND
#DIM DYNAMIC SUM_STAT_ENEMY
#DIM DYNAMIC COUNT_FRIEND
#DIM DYNAMIC COUNT_ENEMY
#LOCALSSIZE 1
PRINTFORMW %CALLNAME:MASTER% 일행은 도망쳤다
;逃亡できたかどうかの判定

;味方側の判定値
FOR LOCAL,1,7
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0
		CONTINUE
	SUM_STAT_FRIEND += BASE:(FLAG:LOCALS):속도 + BASE:(FLAG:LOCALS):운
	COUNT_FRIEND += 1
NEXT
SUM_STAT_FRIEND /= COUNT_FRIEND

FOR LOCAL,7,17
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0
		CONTINUE
	SUM_STAT_ENEMY += BASE:(FLAG:LOCALS):속도
	COUNT_ENEMY += 1
NEXT
SIF COUNT_ENEMY > 0
	SUM_STAT_ENEMY /= COUNT_ENEMY

;ここまでに処理を
IF (RAND:100 < 60 + SUM_STAT_FRIEND - SUM_STAT_ENEMY) || FLAG:선제공격플래그 > 0 || COUNT_ENEMY == 0 || IS_ENEMY_HUNT
	PRINTFORMW ………무사히 도망쳤다
	;---- EDIT 082 MOD START -------------------------
	;一時的に強化したステータスのリセット処理呼び出し。
	;CALL TEMP_STATUS_RESET EDIT 110 DEL
	;---- EDIT 082 MOD END -------------------------
	;---- EDIT 034 MOD START -------------------------
	LOCAL:7 = 0
	FOR LOCAL,1,7
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS < 0
			CONTINUE
		SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING" || GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "STONE"
			CONTINUE
		;---- EDIT 062 ADD START ---------------------------
		IF HAVE_SKILL((FLAG:LOCALS),PU_SKILLNUM_GET((FLAG:LOCALS),"ゲッシュ"))
			;PRINTFORMW  逃走時、ゲッシュゲージ-1になり、次回はデバフ発生
			CALL SKILLGAGE_F_SET,(FLAG:LOCALS),PU_SKILLNUM_GET((FLAG:LOCALS),"ゲッシュ"),-1
		ENDIF
		;---- EDIT 062 ADD END ---------------------------
		LOCAL:(LOCAL:7 + 1) = FLAG:LOCALS
		LOCAL:7 ++
	NEXT
	IF LOCAL:7 > 0
		SETCOLOR COLOR("FRIEND")
		;LOCAL = LOCAL:(RAND:(LOCAL:7) + 1)
		CALL BATTLE_EVENT, "逃走成功"
		;TFLAG:전투이벤트 = 92
		;SWAP LOCAL,TARGET
		;CALL BATTLE_EVENT,TARGET
		;SWAP LOCAL,TARGET
		RESETCOLOR
	ENDIF
	;---- EDIT 034 MOD END ---------------------------
	;CALL BATTLE_END
