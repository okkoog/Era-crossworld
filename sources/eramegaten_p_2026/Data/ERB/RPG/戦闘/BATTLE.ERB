			IF RESULT == 0
				CALL DEADEND
				QUIT
			ENDIF
		CATCH
			CALL DEADEND
			QUIT
		ENDCATCH
	;---- EDIT 068 MOD START -------------------------
	ELSEIF  FLAG:SHOP커맨드 == [[ショップ:개별이벤트]]
