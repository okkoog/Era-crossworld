;---------------------------------------------------------------
;カジャオート
;---------------------------------------------------------------
@KAJA_AUTO
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC SKILLCOUNT
#DIMS DYNAMIC カジャ_FRIEND
#DIMS DYNAMIC ンダ_FRIEND
#DIMS DYNAMIC カジャ_ENEMY
#DIMS DYNAMIC ンダ_ENEMY
FOR LCOUNT, 1, 17
	L_CHARA = POS(LCOUNT)
	SIF L_CHARA < 0
		CONTINUE
	SIF IS_BADSTATE(L_CHARA, "DYING")
		CONTINUE
	CALL WEAPON_STYLE_CHECK(L_CHARA,GET_WEAPON_TYPE_NUM("刀"))
	IF RESULT == 2 && !RAND:3
		CALL PRINT_ACT_MESSAGE, L_CHARA, , , , "도술　제 2형", "NOWAIT"
		CALL PRINT_HIT_MESSAGE, L_CHARA, "다음 물리공격의 명중률과 크리티컬률이 대폭 상승！", "w"
		CFLAG:(L_CHARA):회심의패기플래그 = 1
	ENDIF
	CALL WEAPON_STYLE_CHECK(L_CHARA,GET_WEAPON_TYPE_NUM("斧、鈍器"))
	IF RESULT == 2 && !RAND:3
		CALL PRINT_ACT_MESSAGE, L_CHARA, , , , "도끼술　제 2형", "NOWAIT"
		CALL PRINT_HIT_MESSAGE, L_CHARA, "다음 물리공격의 위력이 대폭 상승！", "w"
		CFLAG:(L_CHARA):気合フラグ = 1
		PRINTFORMW [도끼술　제 2형] %CALLNAME:(L_CHARA)% >>>>> 기합 상태가 되었다！
	ENDIF
	CALL WEAPON_STYLE_CHECK(L_CHARA,GET_WEAPON_TYPE_NUM("杖、祭具"))
	IF RESULT == 2 && !RAND:3
		CALL PRINT_ACT_MESSAGE, L_CHARA, , , , "제사　제 2형", "NOWAIT"
		CALL PRINT_HIT_MESSAGE, L_CHARA, "다음 마법공격의 위력이 대폭 상승！", "w"
		CFLAG:(L_CHARA):집중플래그 = 1
	ENDIF
	SIF CFLAG:(L_CHARA):오토웨이트
		CALL AUTO_WAIT,L_CHARA
	;■FATE専用技"ゲッシュ"に関する処理
	IF HAVE_SKILL(L_CHARA,PU_SKILLNUM_GET(L_CHARA,"ゲッシュ"))
		CALL PRINT_ACT_MESSAGE, L_CHARA, , , , "ゲッシュ", "NOWAIT"
		;与ダメ±20%、被ダメ±20%、回避±50%、命中±30%
		IF SKILLGAGE_F_GET((L_CHARA),PU_SKILLNUM_GET((L_CHARA),"ゲッシュ")) == -1
			CALL PRINT_HIT_MESSAGE, L_CHARA, "전투 능력이 현저하게 떨어졌다!", "w"
		ELSE
			CALL PRINT_HIT_MESSAGE, L_CHARA, "전투 능력이 대폭 올랐다!", "w"
		ENDIF
	ENDIF
	FOR SKILLCOUNT, 0, TRYSKILLNUM(L_CHARA)
		CALL GETS_SKILL_PROP, "SKILL_AUTO_カジャンダ", GET_TRYSKILL(L_CHARA, SKILLCOUNT)
		FOR LCOUNT:1, 0, VARSIZE("KAJA_TABLE")
			IF RESULT:(LCOUNT:1) > 0
				IF CFLAG:L_CHARA:PT플래그
					カジャ_FRIEND += RESULTS:(LCOUNT:1)
				ELSE
					カジャ_ENEMY += RESULTS:(LCOUNT:1)
				ENDIF
			ELSEIF RESULT:(LCOUNT:1) < 0
				IF CFLAG:L_CHARA:PT플래그
					ンダ_ENEMY += RESULTS:(LCOUNT:1)
				ELSE
					ンダ_FRIEND += RESULTS:(LCOUNT:1)
				ENDIF
			ELSE
				BREAK
			ENDIF
		NEXT
	NEXT
NEXT
IF カジャ_FRIEND != ""
	CALL PRINT_ACT_MESSAGE, , , COLOR("FRIEND"), "PARTY/―", "오토 강화", "NOWAIT"
	CALL SKILL_SET_カジャンダ, -1, 19, カジャ_FRIEND, 4, "範囲"
ENDIF
IF ンダ_ENEMY != ""
	CALL PRINT_ACT_MESSAGE, , , COLOR("FRIEND"), "PARTY/―", "오토 약화", "NOWAIT"
	CALL SKILL_SET_カジャンダ, -1, 22, ンダ_ENEMY, -4, "範囲"
ENDIF
IF カジャ_ENEMY != ""
	CALL PRINT_ACT_MESSAGE, , , COLOR("ENEMY"), "ENEMY/―", "오토 강화", "NOWAIT"
	CALL SKILL_SET_カジャンダ, -1, 22, カジャ_ENEMY, 4, "範囲"
ENDIF
IF ンダ_FRIEND != ""
	CALL PRINT_ACT_MESSAGE, , , COLOR("ENEMY"), "ENEMY/―", "오토 약화", "NOWAIT"
	CALL SKILL_SET_カジャンダ, -1, 19, ンダ_FRIEND, -4, "範囲"
ENDIF
RETURN 0

;===================================
;命乞い判定
;敵の場合は残り一体でＨＰ半分以下
;FLAG:목숨구걸플래그 = 1.敵の命乞い　2.敵からの取引　3.￥が50000以上あるか　4.魔貨が1000以上あるか　5.相手の性の対象になるか　6.このターンで命乞いの処理に入ったか
;LOCAL:1 = パーティの戦闘不能じゃない人数
;RESULTS = 敵会話相手のポジション番号
;===================================
@命乞い
#LOCALSIZE 3
#LOCALSSIZE 1
CLEARBIT FLAG:목숨구걸플래그, 1
CLEARBIT FLAG:목숨구걸플래그, 2
;オプション設定判定
SIF FLAG:전투시목숨구걸이벤트 == 0
	RETURN
;命乞いが起きるのは一戦闘に一回だけ
SIF GETBIT(FLAG:목숨구걸플래그, 6)
	RETURN
LOCAL:1 = 0
;敵の命乞い判定
FOR LOCAL,0,10
	LOCALS = 포지션{LOCAL + 7}
	SIF FLAG:LOCALS < 0
		CONTINUE
	;あなたのレベルが対象悪魔よりも１5以上高い場合、指定確率で命乞い
	IF BASE:MASTER:LV > BASE:(FLAG:LOCALS):LV + 15 && RAND:100 < FLAG:전투시목숨구걸이벤트발생률
		LOCAL:1 = 1
		RESULTS = %LOCALS%
		BREAK
	ENDIF
	;ＨＰが半分より大きい時または100%-指定確率で敵の命乞いを発生させない
	IF BASE:(FLAG:LOCALS):ＨＰ > MAXBASE:(FLAG:LOCALS):ＨＰ / 2 || RAND:100 < (100 - FLAG:전투시목숨구걸이벤트발생률)
		LOCAL:1 = 0
		BREAK
	ENDIF
	LOCAL:1 += 1
	SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "STONE"
		CONTINUE
	;生き残っているキャラの番号
	RESULTS = %LOCALS%
	;二体以上生き残っている場合は終了
	SIF LOCAL:1 > 1
		BREAK
NEXT
;敵の命乞いを優先する
IF LOCAL:1 == 1
	SETBIT FLAG:목숨구걸플래그, 1
	;話しかけられた味方キャラを決める
	;『あなた』がDYING、STONEの場合
	IF GET_STATE(CFLAG:MASTER:상태이상) == "DYING" || GET_STATE(CFLAG:MASTER:상태이상) == "STONE"
		FOR LOCAL,1,7
			LOCALS = 포지션{LOCAL}
			SIF FLAG:LOCALS < 0
				CONTINUE
			SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING" || GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "STONE"
				CONTINUE
			;生き残っているキャラの番号
			;とりあえず最初にヒットしたキャラにする
			PLAYER = POS(LOCAL)
			BREAK
		NEXT
	;通常は『あなた』が会話をする
	ELSE
		PLAYER = MASTER
	ENDIF
	RETURN
ENDIF

;味方の命乞い判定
;生き残っているキャラを捜す
LOCAL:1 = 0
FOR LOCAL,1,7
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0
		CONTINUE
	;ＨＰが半分以下じゃない
	IF BASE:(FLAG:LOCALS):ＨＰ > MAXBASE:(FLAG:LOCALS):ＨＰ / 2
		LOCAL:1 = 0
		BREAK
	ENDIF
	SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING" || GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "STONE"
		CONTINUE
	LOCAL:1 += 1
	;生き残っているキャラの番号
	PLAYER = POS(LOCAL)
	;二人以上生き残っている場合は終了
	SIF LOCAL:1 > 1
		BREAK
NEXT
;条件に合わない場合は終了
SIF LOCAL:1 > 1 || LOCAL:1 == 0
	RETURN
;話しかけてきた敵キャラを決める
LOCAL:1 = 0
FOR LOCAL,0,10
	LOCALS = 포지션{LOCAL + 7}
	SIF FLAG:LOCALS < 0
		CONTINUE
	SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "STONE"
		CONTINUE
	;￥50000以下又は魔貨1000以下の場合を弾く
	SIF MONEY <= 50000 || MONEY:1 <= 1000
		CONTINUE
	;FLAG:ムフフ展開がオフの場合は￥、魔貨の判定のみ
	SIF FLAG:무후후전개 == 0
		CONTINUE
	;味方がオトコかつ男の娘でない時に、敵がオトコかつ男の娘でない場合は弾く（純男同士は弾く
	SIF TALENT:PLAYER:남자 && !TALENT:PLAYER:오토코노코 && TALENT:(FLAG:LOCALS):남자 && !TALENT:(FLAG:LOCALS):오토코노코
		CONTINUE
	;味方がオトコの時、男嫌いは弾く
	SIF TALENT:PLAYER:남자 && TALENT:(FLAG:LOCALS):남성혐오
		CONTINUE
	;味方がオンナの時に敵がオンナorオンナ嫌いの場合は弾く
	SIF !TALENT:PLAYER:남자 && (!TALENT:(FLAG:LOCALS):남자 || TALENT:(FLAG:LOCALS):여성혐오)
		CONTINUE
	;話しかけてきた敵キャラの番号
	;とりあえず最初にヒットしたキャラにする
	RESULTS = %LOCALS%
	LOCAL:1 = 1
	BREAK
NEXT
;敵に該当キャラがいない場合は終了
SIF LOCAL:1 == 0
	RETURN

SETBIT FLAG:목숨구걸플래그, 2
SIF MONEY > 50000
	SETBIT FLAG:목숨구걸플래그, 3
SIF MONEY:1 > 1000
	SETBIT FLAG:목숨구걸플래그, 4
SIF FLAG:무후후전개 && (TALENT:PLAYER:남자 && !TALENT:(FLAG:LOCALS):남자 && !TALENT:(FLAG:LOCALS):남성혐오 || (TALENT:PLAYER:오토코노코 || TALENT:(FLAG:LOCALS):오토코노코) && !TALENT:(FLAG:LOCALS):남성혐오 || !TALENT:PLAYER:남자 && TALENT:(FLAG:LOCALS):남자 && !TALENT:(FLAG:LOCALS):여성혐오 || TALENT:(FLAG:LOCALS):바이)
	SETBIT FLAG:목숨구걸플래그, 5
RETURN

