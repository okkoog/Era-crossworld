;===================================
;戦闘中ムフフイベント判定
;行動中イく確率
;===================================
@BATTLE_H_EVENT_PRO,ARG
#FUNCTION
LOCAL = 0
IF FLAG:무후후전개
	SIF CFLAG:ARG:속옷（하） == [[衣装:바이브달린쇼츠]] || CFLAG:ARG:속옷（하） == [[衣装:Ｗ바이브달린쇼츠]] || CFLAG:ARG:속옷（하） == [[衣装:바이브달린정조대]] || CFLAG:ARG:속옷（하） == [[衣装:Ｗ바이브달린정조대]]
		LOCAL = MAX(ABL:ARG:Ｖ감각 + (10 * 위험일(ARG)),LOCAL)
	SIF CFLAG:ARG:속옷（하） == [[衣装:Ａ바이브달린쇼츠]] || CFLAG:ARG:속옷（하） == [[衣装:꼬리플러그]] || CFLAG:ARG:속옷（하） == [[衣装:Ａ바이브달린정조대]] || CFLAG:ARG:속옷（하） == [[衣装:Ｗ바이브달린쇼츠]] || CFLAG:ARG:속옷（하） == [[衣装:Ｗ바이브달린정조대]]
		LOCAL = MAX(ABL:ARG:Ａ감각 + (10 * 위험일(ARG)),LOCAL)
	SIF CFLAG:ARG:전신복 == [[衣装:촉수갑옷]] || CFLAG:ARG:전신속옷 == [[衣装:촉수수트]]
		LOCAL = MAX((ABL:ARG:Ｃ감각 + ABL:ARG:Ｖ감각 + ABL:ARG:Ａ감각 + ABL:ARG:Ｂ감각 + (10 * 위험일(ARG)) / 4) + ABL:ARG:촉수중독,LOCAL)
	SIF CFLAG:ARG:전신속옷 == [[衣装:촉수수트]]
		LOCAL = MAX((ABL:ARG:Ｃ감각 + ABL:ARG:Ｖ감각 + ABL:ARG:Ａ감각 + ABL:ARG:Ｂ감각 + (10 * 위험일(ARG)) / 1) + ABL:ARG:촉수중독,LOCAL)
	SIF CFLAG:ARG:속옷（하） == [[衣装:촉수팬츠]]
		LOCAL = MAX((ABL:ARG:Ｃ감각 + ABL:ARG:Ｖ감각 + ABL:ARG:Ａ감각 + (10 * 위험일(ARG)) / 3) + ABL:ARG:촉수중독,LOCAL)
	SIF CFLAG:ARG:속옷（상） == [[衣装:촉수브라]]
		LOCAL = MAX(ABL:ARG:Ｂ감각 + (10 * 위험일(ARG) + ABL:ARG:촉수중독),LOCAL)
ENDIF
RETURNF LOCAL
