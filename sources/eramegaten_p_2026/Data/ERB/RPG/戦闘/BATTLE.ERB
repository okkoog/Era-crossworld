;===================================
;行動順番の決定
;
;ARG = ポジション外キャラを考慮してふりなおす場合
;===================================
@BATTLE_DECIDE_INITIATIVE, ARG = -1
#LOCALSIZE 4
#LOCALSSIZE 5
#DIM LCOUNT, 2
#DIM DYNAMIC L_CHARA
#DIM TEMP_SKILL
#DIMS TEMP_SKILLS
#DIM 링케이지참가자
#DIM 参加者速度
LOCAL:1 = 0
LOCAL:2 = 0
FOR LCOUNT, 0, 16
	LOCALS = 행동순{LCOUNT+1}
	FLAG:LOCALS = -1
NEXT

FOR LOCAL,0,16 + 1
	RESULT = 0
	IF LOCAL < 16
		L_CHARA = POS(LOCAL + 1)
	ELSE
		SIF ARG < 0 || CPOS(ARG) > 0
			CONTINUE
		L_CHARA = ARG
	ENDIF
	LOCALS:2 = 행동순{1}
	SIF L_CHARA > -1 && CFLAG:(L_CHARA):입력행동 == -1
		CONTINUE
	SIF L_CHARA > -1 && CFLAG:(L_CHARA):ＣＨＡＮＧＥ대상플래그 == 1
		CONTINUE
	SIF L_CHARA > -1
		CALL ACTIONABLE_CHARA,L_CHARA
	
	;---- EDIT 091 補正スキルの記述を変更						MOD START ----
	;---- EDIT 090 補正スキル呼び出し追加+記述整理(2022/11/25)	MOD START ----
	IF RESULT > 0
		CFLAG:(L_CHARA):행동속도 = MAXBASE:(L_CHARA):(GET_BASESTATUS(5))
		CFLAG:(L_CHARA):행동속도 += CFLAG:(L_CHARA):속도보정
		;所持スキルによる補正	
		FOR LCOUNT, 0, TRYSKILLNUM(L_CHARA)
			RESULT = 0
			TEMP_SKILLS = %GET_TRYSKILL(L_CHARA, LCOUNT)%
			TEMP_SKILL = TOINT(TEMP_SKILLS)
			SIF TEMP_SKILLS == "0"
				CONTINUE
			TRYCCALLFORM SKILL_ADD_STATUS_%TEMP_SKILLS%, "속도보정", "指定なし", L_CHARA, TEMP_SKILL, TRYSKILL_VAR
				CFLAG:(L_CHARA):행동속도 += RESULT
			CATCH
			ENDCATCH
		NEXT
		;リンケージは参加者の中で一番遅いキャラの速度になる
		IF CFLAG:(L_CHARA):링케이지발동
			FOR LCOUNT, 1, 6
				링케이지참가자 = CFLAG:(L_CHARA):("링케이지참가자"+ TOSTR(LCOUNT))
				SIF 링케이지참가자 < 0
					CONTINUE
				参加者速度 = MAXBASE:링케이지참가자:(GET_BASESTATUS(5))
				参加者速度 += CFLAG:링케이지참가자:속도보정
				FOR LCOUNT, 0, TRYSKILLNUM(링케이지참가자)
					RESULT = 0
					TEMP_SKILLS = %GET_TRYSKILL(링케이지참가자, LCOUNT)%
					TEMP_SKILL = TOINT(TEMP_SKILLS)
					SIF TEMP_SKILLS == "0"
						CONTINUE
					TRYCCALLFORM SKILL_ADD_STATUS_%TEMP_SKILLS%, "속도보정", "指定なし", 링케이지참가자, TEMP_SKILL, TRYSKILL_VAR
						参加者速度 += RESULT
					CATCH
					ENDCATCH
				NEXT
				CFLAG:(L_CHARA):행동속도 = MIN(CFLAG:(L_CHARA):행동속도, 参加者速度)
			NEXT
		ENDIF
		CALL GET_SKILL_PROP, "SKILL_SPEED", CFLAG:(L_CHARA):입력행동, L_CHARA
		CFLAG:(L_CHARA):행동속도 += RESULT - (CFLAG:(L_CHARA):행동한횟수 * 5)
		SIF (CFLAG:(L_CHARA):PT플래그 == 2 && LOCAL < 3) || (CFLAG:(L_CHARA):PT플래그 == 0 && LOCAL < 11)
			CFLAG:(L_CHARA):행동속도 += 2
		FOR LOCAL:2,0,16
			LOCALS:2 = 행동순{LOCAL:2+1}
			IF FLAG:(LOCALS:2) == -1
				FLAG:(LOCALS:2) = L_CHARA
				BREAK
				;PRINTFORML 誰もいないので{LOCAL:2}にいれます
			ELSEIF CFLAG:(FLAG:(LOCALS:2)):행동속도 > CFLAG:(L_CHARA):행동속도
				;PRINTFORML {LOCAL:2}よりおそいです
				CONTINUE
			ELSEIF CFLAG:(FLAG:(LOCALS:2)):행동속도 < CFLAG:(L_CHARA):행동속도
				;PRINTFORML {LOCAL:2}より速いです
				FOR LOCAL:3,0,(15-LOCAL:2)
					LOCALS:3 = 행동순{16-LOCAL:3}
					LOCALS:4 = 행동순{15-LOCAL:3}
					FLAG:(LOCALS:3) = FLAG:(LOCALS:4)
				NEXT
				FLAG:(LOCALS:2) = L_CHARA
				BREAK
			ELSEIF CFLAG:(FLAG:(LOCALS:2)):행동순 == CFLAG:(L_CHARA):행동순
				;PRINTFORML {LOCAL:2}と同速です
				SIF RAND:2 == 0
					CONTINUE
				FOR LOCAL:3,0,(15-LOCAL:2)
					LOCALS:3 = 행동순{16-LOCAL:3}
					LOCALS:4 = 행동순{15-LOCAL:3}
					FLAG:(LOCALS:3) = FLAG:(LOCALS:4)
				NEXT
				FLAG:(LOCALS:2) = L_CHARA
				BREAK
			ENDIF
		NEXT
	ENDIF
NEXT


