@ACTIONABLE_NPC_COMMAND,ARG

;---- EDIT 111 MOD START -------------------------
;====================================================
;使用可能なスキルをリスト化
;====================================================
@SEARCH_ACT, ARG
#DIM LCOUNT
#DIM L_SKILL
#DIM TEMP
VARSET USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1

;最初に全ての候補をリストに入れる
;通常攻撃を入れる
USEABLE_SKILL_LIST_FOR_RANDOM_ACT:0 = 0
;銃を装備している場合は銃も候補に入れる
SIF EQUIP:ARG:총
	USEABLE_SKILL_LIST_FOR_RANDOM_ACT:0 = [[스킬:ＧＵＮ]]
FOR LCOUNT, 1, CHARA_SKILLCOUNT(ARG) + 1
	SIF !ABL:ARG:@"스킬{LCOUNT}"
		CONTINUE
	USEABLE_SKILL_LIST_FOR_RANDOM_ACT:FINDELEMENT(USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1) = ABL:ARG:@"스킬{LCOUNT}"
NEXT
FOR LCOUNT, 1, HAVEABLE_EQ_SKILLNUM + 1
	SIF !ABL:ARG:@"장비스킬{LCOUNT}"
		CONTINUE
NEXT

;リストから候補にできないスキルを抜いていく
FOR LCOUNT, FINDELEMENT(USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1) - 1, -1, -1
	L_SKILL = USEABLE_SKILL_LIST_FOR_RANDOM_ACT:LCOUNT
	;召喚スキルは省く
	CALL GET_SKILL_PROP, "SKILL_IS_SUMMON", L_SKILL, ARG
	IF RESULT
		USEABLE_SKILL_LIST_FOR_RANDOM_ACT:LCOUNT = -1
		CONTINUE
	ENDIF
	;ランダムで選ばないように指定してあるスキル
	IF !CFLAG:ARG:PT플래그 && COUNT_SPLIT(CSTR:ARG:랜덤선택금지스킬, "/", CONVERT_SKILLNUM_TO_STR(ARG, L_SKILL))
		ARRAYSHIFT USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1, -1, LCOUNT, VARSIZE("USEABLE_SKILL_LIST_FOR_RANDOM_ACT")
		CONTINUE
	ENDIF
	CALL GET_SKILL_PROP, "SKILL_ACTIONABLE_BATTLE", L_SKILL, ARG
	IF !RESULT
		ARRAYSHIFT USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1, -1, LCOUNT, VARSIZE("USEABLE_SKILL_LIST_FOR_RANDOM_ACT")
		CONTINUE
	ENDIF
	CALL GET_SKILL_PROP, "SKILL_DECIDE_TYPE", L_SKILL, ARG
	;アシストスキルは当然として、コマンダースキルも効果があやしいので抜く
	IF GROUPMATCH(GET_SKILL_DECIDE_TYPE(RESULT), "CS", "AS")
		ARRAYSHIFT USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1, -1, LCOUNT, VARSIZE("USEABLE_SKILL_LIST_FOR_RANDOM_ACT")
		CONTINUE
	ENDIF
	CALL CHECK_ACTIONABLE, ARG, L_SKILL
	IF !RESULT
		ARRAYSHIFT USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1, -1, LCOUNT, VARSIZE("USEABLE_SKILL_LIST_FOR_RANDOM_ACT")
		CONTINUE
	ENDIF
	;条件付きで選定させないスキル
	CALL GET_SKILL_PROP, "SKILL_SELECTABLE_BY_AUTO", L_SKILL, ARG
	IF !RESULT
		ARRAYSHIFT USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1, -1, LCOUNT, VARSIZE("USEABLE_SKILL_LIST_FOR_RANDOM_ACT")
		CONTINUE
	ENDIF
NEXT
;魅了と混乱の場合はATTACKの比率をある程度あげる
IF IS_BADSTATE(ARG, "CHARM") || (IS_BADSTATE(ARG, "PANIC") && !HAVE_PANIC_RESISTANCE(ARG))
	WHILE 1
		TEMP = FINDELEMENT(USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1)
		SIF TEMP < 0
			BREAK
		SIF (VARSIZE("USEABLE_SKILL_LIST_FOR_RANDOM_ACT") - MATCH(USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1)) / 3 < MATCH(USEABLE_SKILL_LIST_FOR_RANDOM_ACT, 0)
			BREAK
		USEABLE_SKILL_LIST_FOR_RANDOM_ACT:FINDELEMENT(USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1) = 0
	WEND
ENDIF
RETURN VARSIZE("USEABLE_SKILL_LIST_FOR_RANDOM_ACT") - MATCH(USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1)

;===============================================
;指定したコマンドが使用可能か
;===============================================
@CHECK_ACTIONABLE,ARG,ARG:1
#LOCALSIZE 1
#DIM DYNAMIC L_COST
#DIM DYNAMIC L_COST_TYPE
#DIMS DYNAMIC L_SKILLS
SIF TALENT:ARG:전력상실 > 0
	RETURN 0
L_SKILLS '= CONVERT_SKILLNUM_TO_STR(ARG, ARG:1)

IF CFLAG:ARG:롱기누스
	CALL GETS_SKILL_PROP, "SKILL_DECIDE_TYPE", L_SKILLS, ARG
	SIF GROUPMATCH(GET_SKILL_DECIDE_TYPE(RESULT), "EX", "MA")
		RETURN 0
ENDIF
;---- EDIT 114 MOD END ---------------------------
CALL GETS_SKILL_PROP, "SKILL_SPECIAL_ACTIONABLE", L_SKILLS, ARG
SIF RESULT == 0
	RETURN 0
IF CFLAG:ARG:PT플래그
	TRYCCALLFORM アイテム使用能力レベル_%L_SKILLS%
		SIF RESULT > 0 && GET_BTL_TALENT_LV("도구지식", ARG) < RESULT
			RETURN 0
	CATCH
	ENDCATCH
ENDIF
CALL GETS_SKILL_PROP, "SKILL_DECIDE_TYPE", L_SKILLS, ARG
IF RESULT == 2 && CFLAG:ARG:상태이상 == GET_STATE_NUM("CLOSE")
	RESULTS = ＣＬＯＳＥ
	RETURN 0
ENDIF
;エラー吐くから処理を変更する(番号取得し、100で割った数値で判定している　2400番台以外の数値の場合、後処理でエラー吐く)
;自動発動系スキルを弾く
;IF (ARG:1/100) == 24
;	RETURN 0
;ENDIF

;スキルタイプを取得して判断する
CALL GETS_SKILL_PROP, "SKILL_EFECT", L_SKILLS, ARG
;6番は自動効果スキル
IF RESULT == 6
	RETURN 0
ENDIF

;---- EDIT 102 MOD START -------------------------
;単体蘇生
CALL GETS_SKILL_PROP, "SKILL_IS_RESUSCITATION", L_SKILLS, ARG
IF RESULT
	;単体蘇生対象が存在するかチェック
	CALL CHECK_TARGET_RESUSCITATION, ARG
	IF RESULT == -1
		RESULTS = 蘇生対象不在
		RETURN 0
	ENDIF
	;CFLAG:ARG:타겟 = RESULT
ENDIF
;---- EDIT 102 MOD END ---------------------------
;---- EDIT 073 ADD START -------------------------
;召喚系スキル
CALL GETS_SKILL_PROP, "SKILL_IS_SUMMON", L_SKILLS, ARG
IF RESULT
	IF FLAG:소환불능
		RESULTS = 召喚不能状態
		RETURN 0
	ENDIF
ENDIF
;-----------------------------------------
;コスト判定
;-----------------------------------------
CALL CHECK_COST, ARG, ARG:1
SIF !RESULT
	RETURN 0
;---- EDIT 102 MOD END ---------------------------
IF !TFLAG:전투중
	SIF (CFLAG:ARG:소속ＣＯＭＰ == 0 && CFLAG:ARG:PT플래그 == 1 && NUM_SUMMONER(1) == 0) || GET_VALUE_TALENT_JOINABLE(ARG) == 0
		RETURN 0
	CALL GET_SKILL_PROP, "SKILL_ACTIONABLE_FIELD", ARG:1, ARG
	SIF RESULT > 0
		RETURN 1
ELSE
	CALL SEARCH_TARGET,ARG,ARG:1
	SIF FLAG:SHOP커맨드 == [[ショップ:능력확인]] || RESULT == 1
		RETURN 1
	RETURN 0
ENDIF
;---- EDIT 090 スキル選択不能時の説明文(ツールチップ)追加(2022/11/25) ADD START ----
;===============================================
;指定したコマンドの対象がいるか
;===============================================
@SEARCH_TARGET,L_ACTOR,L_SKILL
#DIM DYNAMIC L_SKILL
#DIM DYNAMIC L_ACTOR
#DIM LCOUNT
#DIM L_RANGE
#DIM ACTOR_POS
;---- EDIT 102 ADD START -------------------------
;召喚攻撃用に召喚者のPOSを見れるように置き換える
ACTOR_POS = CFLAG:L_ACTOR:피소환플래그? CPOS(FINDCHARA_ID(CFLAG:L_ACTOR:소환자ID)) # CPOS(L_ACTOR)

CALL GET_SKILL_PROP, "SKILL_TARGET", L_SKILL, L_ACTOR
IF RESULT == 1
	RESULT = 0
	CALL GET_SKILL_PROP, "SKILL_RANGE", L_SKILL,L_ACTOR
	L_RANGE = RESULT
	;敵
	IF CFLAG:L_ACTOR:PT플래그 == 0
		IF (RESULT == 1 && ACTOR_POS < 12) || RESULT == 2
			FOR LCOUNT, 1, 4
				SIF !IS_TARGET_ABLE(POS(LCOUNT))
					CONTINUE
				CALL GET_SKILL_PROP, "SKILL_TARGETABLE", L_SKILL, L_ACTOR, POS(LCOUNT)
				SIF !RESULT
					CONTINUE
				RETURN 1
			NEXT
		ELSEIF RESULT == 3 || (RESULT == 4 && ACTOR_POS < 12)
			FOR LCOUNT, 1, 7
				SIF !IS_TARGET_ABLE(POS(LCOUNT))
					CONTINUE
				CALL GET_SKILL_PROP, "SKILL_TARGETABLE", L_SKILL, L_ACTOR, POS(LCOUNT)
				SIF !RESULT
					CONTINUE
				RETURN 1
			NEXT
		ENDIF
		RETURN 0
	ELSEIF CFLAG:L_ACTOR:PT플래그 && INRANGE(ACTOR_POS, 1, 6)
		;味方
		IF (RESULT == 1 && ACTOR_POS < 4) || RESULT == 2
			FOR LCOUNT,7,12
				SIF !IS_TARGET_ABLE(POS(LCOUNT))
					CONTINUE
				CALL GET_SKILL_PROP, "SKILL_TARGETABLE", L_SKILL, L_ACTOR, POS(LCOUNT)
				SIF !RESULT
					CONTINUE
				RETURN 1
			NEXT
		ELSEIF RESULT == 3 || (RESULT == 4 && ACTOR_POS < 4)
			FOR LCOUNT,7,17
				SIF !IS_TARGET_ABLE(POS(LCOUNT))
					CONTINUE
				CALL GET_SKILL_PROP, "SKILL_TARGETABLE", L_SKILL, L_ACTOR, POS(LCOUNT)
				SIF !RESULT
					CONTINUE
				RETURN 1
			NEXT
		ENDIF
		;原則的に敵が前列に存在しないケースがないので射程範囲外になることはないはずだが、一応
		IF (L_RANGE == 1 || L_RANGE == 4) && !IS_FRONT(CFLAG:L_ACTOR:피소환플래그? FINDCHARA_ID(CFLAG:L_ACTOR:소환자ID) # L_ACTOR)
			RESULTS = 後列発動不能
		ELSE
			RESULTS = 射程範囲外
		ENDIF
		RETURN 0
	ENDIF
ELSE
	RETURN 1
ENDIF
;---- EDIT 090 スキル選択不能時の説明文(ツールチップ)追加(2022/11/25) ADD END ----
