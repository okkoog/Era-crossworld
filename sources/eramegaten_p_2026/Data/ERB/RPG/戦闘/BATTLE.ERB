VARSET 加算値
VARSET 初期値
VARSET 加算前NEXT
;EXPバーの加算値取得
FOR LOCAL, 1, 7
	L_FRIEND = POS(LOCAL)
	SIF L_FRIEND == -1
		CONTINUE
	;EXP初期値の計算
	レベル = BASE:L_FRIEND:LV
	;陥落によって必要EXPが変化する場合、初期値がマイナスいく問題があるので、0保証しておく
	;初期値:(LOCAL) = MAX(0, (BASE:POS(LOCAL):ＥＸＰ - GET_NEXT_EXP(レベル-1, ABL:POS(LOCAL):종족 != 0 && !陥落(POS(LOCAL)))) * 191 / (GET_NEXT_EXP(レベル, ABL:POS(LOCAL):종족 != 0 && !陥落(POS(LOCAL))) - GET_NEXT_EXP(レベル-1, ABL:POS(LOCAL):종족 != 0 && !陥落(POS(LOCAL)))))
	初期値:(LOCAL) = MAX(0, (BASE:L_FRIEND:ＥＸＰ - GET_NEXT_EXP(L_FRIEND, レベル-1))) * 191 / (GET_NEXT_EXP(L_FRIEND) - GET_NEXT_EXP(L_FRIEND, レベル - 1))
	初期値ＥＸＰ割合:LOCAL = 初期値:LOCAL
	加算前NEXT:(LOCAL) = MAX(MAXBASE:L_FRIEND:ＥＸＰ - BASE:L_FRIEND:ＥＸＰ , 0)
	;MAG初期値の計算
	初期値:(LOCAL+6) = GET_CHARA_STOCK_MAG(L_FRIEND) * 959 / GET_CHARA_MAXMAG(L_FRIEND)
	;忠誠度初期値の計算
	初期値:(LOCAL+12) = MIN(GET_CHARA_LOYALTY(L_FRIEND), 10000) * 959 / 10000
	;AP初期値の計算
	SIF GET_ROLE_PROP("CAN_USE_MANTRA", L_FRIEND) && EQUIP:L_FRIEND:장비만트라 > 0
		初期値:(LOCAL+18) = CDFLAG:L_FRIEND:만트라:(EQUIP:L_FRIEND:장비만트라) * 191 / 10000
;	PRINTFORML {(BASE:POS(LOCAL):ＥＸＰ - GET_NEXT_EXP(レベル-1, ABL:POS(LOCAL):종족 != 0 && !陥落(POS(LOCAL))))} * 191 / {(GET_NEXT_EXP(レベル, ABL:ARG:종족 != 0 && !陥落(ARG)) - GET_NEXT_EXP(レベル-1, ABL:ARG:종족 != 0 && !陥落(ARG)))}
;	PRINTFORML ({BASE:POS(LOCAL):ＥＸＰ} - {GET_NEXT_EXP(レベル-1, ABL:POS(LOCAL):종족 != 0 && !陥落(POS(LOCAL)))}) * 191 / ({GET_NEXT_EXP(レベル, ABL:ARG:종족 != 0 && !陥落(ARG))} - {GET_NEXT_EXP(レベル-1, ABL:ARG:종족 != 0 && !陥落(ARG))})
;	PRINTFORML %CALLNAME:POS(LOCAL)% 初期値:{初期値:(LOCAL)} 加算値:{加算値:(LOCAL)}
	;加算値の計算
	IF GET_STATE(CFLAG:L_FRIEND:상태이상) != "DYING"
		LOCAL:2 = 初期値:(LOCAL)
		;EXP加算
		BASE:L_FRIEND:ＥＸＰ += CFLAG:L_FRIEND:입수경험치
		TOTAL_TAKE_EXP:L_FRIEND:0 += CFLAG:L_FRIEND:입수경험치
		WHILE GET_NEXT_EXP(L_FRIEND, レベル) <= BASE:L_FRIEND:ＥＸＰ
			IF レベル == BASE:L_FRIEND:LV
				加算値:(LOCAL) += 191 - 初期値:(LOCAL)
			ELSE
				加算値:(LOCAL) += 191
			ENDIF
			レベル++
			LOCAL:2 = 0
		WEND
		;加算値:(LOCAL) += (BASE:POS(LOCAL):ＥＸＰ - GET_NEXT_EXP(レベル-1, ABL:POS(LOCAL):종족 != 0 && !陥落(POS(LOCAL)))) * 191 / (GET_NEXT_EXP(レベル, ABL:POS(LOCAL):종족 != 0 && !陥落(POS(LOCAL))) - GET_NEXT_EXP(レベル-1, ABL:POS(LOCAL):종족 != 0 && !陥落(POS(LOCAL)))) - LOCAL:2
		加算値:(LOCAL) += (BASE:L_FRIEND:ＥＸＰ - GET_NEXT_EXP(L_FRIEND, レベル-1) * 191) / (GET_NEXT_EXP(L_FRIEND, レベル) - GET_NEXT_EXP(L_FRIEND, レベル-1)) - LOCAL:2
		加算値:(LOCAL) = MAX(0, 加算値:(LOCAL))
		;MAG加算値
		CALL CONTROL_MAG,L_FRIEND,CFLAG:L_FRIEND:입수ＭＡＧ
		加算値:(LOCAL+6) = GET_CHARA_STOCK_MAG(L_FRIEND) * 959 / GET_CHARA_MAXMAG(L_FRIEND) - 初期値:(LOCAL+6)
		IF L_FRIEND > 0
			;---- EDIT 107 DEL START -------------------------
			;CFLAG:L_FRIEND:전투중획득충성도 += 10
			CALL CONTROL_LOYALTY, L_FRIEND, CFLAG:L_FRIEND:전투중획득충성도
			加算値:(LOCAL+12) = MIN(GET_CHARA_LOYALTY(L_FRIEND), 10000) * 959 / 10000 - 初期値:(LOCAL+12)
			;---- EDIT 107 DEL END ---------------------------
		ENDIF
		;AP加算値　ここでは9999までにしておいて、あとのメッセージ表示のときに10000にする
		IF GET_ROLE_PROP("CAN_USE_MANTRA", L_FRIEND) && EQUIP:L_FRIEND:장비만트라 > 0 && CDFLAG:L_FRIEND:만트라:(EQUIP:L_FRIEND:장비만트라) < 10000
			CDFLAG:L_FRIEND:만트라:(EQUIP:L_FRIEND:장비만트라) = MIN(9999, CDFLAG:L_FRIEND:만트라:(EQUIP:L_FRIEND:장비만트라) + CFLAG:L_FRIEND:입수AP)
			;9999だとぎりぎり214になってしまうので調整
			IF CDFLAG:L_FRIEND:만트라:(EQUIP:L_FRIEND:장비만트라) == 9999
				加算値:(LOCAL+18) = 191 - 初期値:(LOCAL+18)
			ELSE
				加算値:(LOCAL+18) = CDFLAG:L_FRIEND:만트라:(EQUIP:L_FRIEND:장비만트라) * 191 / 10000 - 初期値:(LOCAL+18)
			ENDIF
		ENDIF
	ELSE
		;獲得の初期化
		CFLAG:L_FRIEND:전투중획득충성도 = 0
		CFLAG:L_FRIEND:입수경험치 = 0
		CFLAG:L_FRIEND:입수ＭＡＧ = 0
		CFLAG:L_FRIEND:입수AP = 0
	ENDIF
	;造魔はEXPの加算なし
	;IF ABL:L_FRIEND:종족 == 45
	IF GET_ROLE_PROP("NEXT_EXP", L_FRIEND) == -1
