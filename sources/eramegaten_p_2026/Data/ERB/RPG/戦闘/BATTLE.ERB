FOR LCOUNT, 1, BCHARANUM + 7
	;PTにはいってるキャラから先に処理する
	IF LCOUNT >= 7
		L_FRIEND = BCHARA:(LCOUNT - 7)
		SIF CPOS(L_FRIEND) > 0
			CONTINUE
	ELSE
		L_FRIEND = POS(LCOUNT)
		SIF L_FRIEND < 0
			CONTINUE
	ENDIF
	SIF IS_BADSTATE(L_FRIEND, "DYING")
		CONTINUE
	SIF !CFLAG:L_FRIEND:PT플래그
		CONTINUE
	SIF L_FRIEND == MASTER
		CONTINUE
	;戦闘終了時のメンバーは+10
	SIF CPOS(L_FRIEND) > 0
		CFLAG:L_FRIEND:전투중획득충성도 += 10 * (CONTINUE_BATTLE_NUM + 1)
	CFLAG:L_FRIEND:전투중획득충성도 = CFLAG:L_FRIEND:전투중획득충성도 * (TFLAG:획득충성도보정 + 100) / 100
	SIF CONTINUE_BATTLE_NUM > 0
		CFLAG:L_FRIEND:전투중획득충성도 = CFLAG:L_FRIEND:전투중획득충성도 * (100 + 50 * CONTINUE_BATTLE_NUM) / 100
	;忠誠度リンクの特別措置
	IF CFLAG:L_FRIEND:충성도링크	
		LINKED_CHARA = FINDCHARA_TIMEID(CFLAG:L_FRIEND:피링크캐릭터실제가입시간)
		IF LINKED_CHARA >= 0 && CPOS(LINKED_CHARA) == 0
			CFLAG:L_FRIEND:전투중획득충성도 += CFLAG:LINKED_CHARA:전투중획득충성도
			CFLAG:LINKED_CHARA:전투중획득충성도 = 0
		ELSE
			CFLAG:L_FRIEND:전투중획득충성도 = 0
		ENDIF
	ENDIF
	;---- EDIT P 005 ADD START -------------------------
	SIF SOFT_ON("페로몬커피")
		CFLAG:L_FRIEND:전투중획득충성도 *= 100
	;---- EDIT P 005 ADD END ---------------------------
	;戦闘に不参加な場合は表示に関わらないのでここで処理をする
	IF CPOS(L_FRIEND) == 0
		CALL CONTROL_LOYALTY, L_FRIEND, CFLAG:L_FRIEND:전투중획득충성도
		CFLAG:L_FRIEND:전투중획득충성도 = 0
	ENDIF
NEXT
