#DIMS L_MESSAGE, 2
#DIM L_P
L_P = ARG
RESULT:1 = 0
VARSET L_MESSAGE
;HAPPYなら50％で失敗
IF CFLAG:L_P:상태이상 == GET_STATE_NUM("HAPPY") && RAND:100 < 50
	CFLAG:L_P:입력행동 = [[스킬:행동불능]];ADD 055
	RETURN 1, -1
ENDIF

;ボイコットフラグが立っている場合はボイコットする
;IF CFLAG:L_P:ボイコットフラグ == 1 && FLAG:戦闘時ボイコット設定 > 2
;	CFLAG:L_P:입력행동 = [[스킬:행동불능]]
;	RETURN 1, COLOR("RED")
;ENDIF

;バイブ付きの下着を装備しているとＶ感覚orＡ感覚+(위험일+10、発情+20、満月（悪魔限定）+30）/2の確率でイク
IF FLAG:무후후전개
	TFLAG:전투이벤트 = 0
	IF 위험일(L_P) == 2 && RAND:100 < 50 && CFLAG:L_P:PT플래그 > 0 && CFLAG:L_P:상태이상 == GET_STATE_NUM("HAPPY")
		SOURCE:L_P:쾌Ｃ += 100
		SOURCE:L_P:쾌Ｂ += 100
		CALL TECHNIQUE_CHECK, L_P, L_P
		CALL SOURCE_CHECK_DUNGEON , L_P
		CFLAG:L_P:입력행동 = [[스킬:행동불능]];ADD 055
		RETURN 1, -1
	ENDIF
	SETCOLOR COLOR("pink")
	IF RAND:100 < (ABL:L_P:Ｖ감각 + (10 * 위험일(L_P))) / 2 && (CFLAG:L_P:속옷（하） == [[衣装:바이브달린쇼츠]] ||  CFLAG:L_P:속옷（하） == [[衣装:Ｗ바이브달린쇼츠]] || CFLAG:L_P:속옷（하） == [[衣装:바이브달린정조대]] || CFLAG:L_P:속옷（하） == [[衣装:Ｗ바이브달린정조대]])
		L_MESSAGE = %CALLNAME:(L_P)% は身に着けた%GET_衣装名(CFLAG:L_P:속옷（하）)%の振動で絶頂に達した
		TCVAR:L_P:획득Ｖ경험 = 1
	ENDIF
	IF RAND:100 < (ABL:L_P:Ａ감각 + (10 * 위험일(L_P))) / 2 && (CFLAG:L_P:속옷（하） == [[衣装:Ａ바이브달린쇼츠]] ||CFLAG:L_P:속옷（하） == 615 || CFLAG:L_P:속옷（하） == [[衣装:Ａ바이브달린정조대]] || CFLAG:L_P:속옷（하） == [[衣装:바이브달린쇼츠]] || CFLAG:L_P:속옷（하） == [[衣装:Ｗ바이브달린정조대]])
		L_MESSAGE = %CALLNAME:(L_P)% は身に着けた%GET_衣装名(CFLAG:L_P:속옷（하）)%の振動で絶頂に達した
		TCVAR:L_P:획득Ａ경험 = 1
	ENDIF
	;触手アーマーを装備していると(Ｃ、Ｖ、Ａ、Ｂ感覚+(위험일+10、発情+20、満月（悪魔限定）+30）/4) +触手中毒の確率でイク
	IF RAND:100 < ((ABL:L_P:Ｃ감각 + ABL:L_P:Ｖ감각 + ABL:L_P:Ａ감각 + ABL:L_P:Ｂ감각 + (10 * 위험일(L_P))) / 4) + ABL:L_P:촉수중독 && CFLAG:L_P:전신복 == [[衣装:촉수갑옷]]
		L_MESSAGE = %CALLNAME:(L_P)% は身に着けた%GET_衣装名(CFLAG:L_P:전신복)%による責めで絶頂に達した
		TCVAR:L_P:획득Ｖ경험 = 1
		TCVAR:L_P:획득Ａ경험 = 1
		TCVAR:L_P:획득촉수경험 = 1
	ENDIF
	;触手スーツを装備しているとＣ、Ｖ、Ａ、Ｂ感覚+(위험일+10、発情+20、満月（悪魔限定）+30） +触手中毒の確率でイク 攻略中に着るのはとんでもないレベルの制限プレイ
	IF RAND:100 < ((ABL:L_P:Ｃ감각 + ABL:L_P:Ｖ감각 + ABL:L_P:Ａ감각 + ABL:L_P:Ｂ감각 + (10 * 위험일(L_P))) / 1) + ABL:L_P:촉수중독 && CFLAG:L_P:전신속옷 == [[衣装:촉수수트]]
		L_MESSAGE = %CALLNAME:(L_P)% は身に着けた%GET_衣装名(CFLAG:L_P:전신속옷)%による責めで絶頂に達した
		TCVAR:L_P:획득Ｖ경험 = 1
		TCVAR:L_P:획득Ａ경험 = 1
		TCVAR:L_P:획득촉수경험 = 1
	ENDIF
	;触手パンツを装備していると(Ｃ、Ｖ、Ａ+(위험일+10、発情+20、満月（悪魔限定）+30）/3) +触手中毒の確率でイク
	IF RAND:100 < ((ABL:L_P:Ｃ감각 + ABL:L_P:Ｖ감각 + ABL:L_P:Ａ감각 + (10 * 위험일(L_P))) / 3) + ABL:L_P:촉수중독 && CFLAG:L_P:속옷（하） == [[衣装:촉수팬츠]]
		L_MESSAGE = %CALLNAME:(L_P)% は身に着けた%GET_衣装名(CFLAG:L_P:속옷（하）)%による責めで絶頂に達した
		TCVAR:L_P:획득Ｖ경험 = 1
		TCVAR:L_P:획득Ａ경험 = 1
		TCVAR:L_P:획득촉수경험 = 1
	ENDIF
	;触手ブラを装備していると(Ｂ감각+(위험일+10、発情+20、満月（悪魔限定）+30）) +触手中毒の確率でイク
	IF RAND:100 < (ABL:L_P:Ｂ감각 + (10 * 위험일(L_P)) + ABL:L_P:촉수중독) && CFLAG:L_P:속옷（상） == [[衣装:촉수브라]]
		L_MESSAGE = %CALLNAME:(L_P)% は身に着けた%GET_衣装名(CFLAG:L_P:속옷（상）)%による責めで絶頂に達した
		TCVAR:L_P:획득촉수경험 = 1
	ENDIF
	;イクと50％の確率で行動不能
	IF TCVAR:L_P:획득Ａ경험 + TCVAR:L_P:획득Ｖ경험 > 0
		IF RAND:2 == 0
			L_MESSAGE:1 = %CALLNAME:(L_P)% は歯を食いしばって快楽に耐えた
			CFLAG:L_P:던전내발정용욕정치 += 1000
			SIF TCVAR:L_P:획득촉수경험 > 0
				CFLAG:L_P:던전내발정용욕정치 += 100 * ABL:L_P:촉수중독
			;TFLAG:전투이벤트 = 47;ADD 055
			;CALL BATTLE_EVENT, L_P
			CALL BATTLE_EVENT, "전투중 가버려 행동불능이 되지 않고 버텼다", L_P
		ELSE
			CFLAG:L_P:던전내발정용욕정치 -= 1000
			SIF TCVAR:L_P:획득촉수경험 > 0
				CFLAG:L_P:던전내발정용욕정치 += 50 * ABL:L_P:촉수중독
			SIF CFLAG:L_P:던전내발정용욕정치 < 0
				CFLAG:L_P:던전내발정용욕정치 = 0
			SIF RAND:2 == 0
				CFLAG:L_P:상태이상 = GET_STATE_NUM("HAPPY")
			;TFLAG:전투이벤트 = 48;ADD 055
			CALL BATTLE_EVENT, "행동중 가버려 행동불능이 되었다", L_P
			TFLAG:전투중절정 = 1
			CFLAG:L_P:입력행동 = [[스킬:행동불능]]
		ENDIF
		EXP:L_P:절정경험 += TCVAR:L_P:획득Ａ경험 + TCVAR:L_P:획득Ｖ경험
		TCVAR:L_P:획득Ａ경험 = 0
		TCVAR:L_P:획득Ｖ경험 = 0
		TCVAR:L_P:획득촉수경험 = 0
		GOTO UFUFU_END
	ENDIF
	;触装デモニカを装備しているとＢ、Ｃ、Ｖ、Ａ+(위험일+10、発情+20、満月（悪魔限定）+30）/3) + 촉수중독 の確率でイク。
	IF RAND:100 < ((ABL:L_P:Ｂ감각 + ABL:L_P:Ｃ감각 + ABL:L_P:Ｖ감각 + ABL:L_P:Ａ감각 + ABL:L_P:Ｂ감각 + (10 * 위험일(L_P))) / 4) + 60 + (ABL:L_P:촉수중독) && EQUIPMENT_CHECK(L_P, [[アイテム:촉수옷데모니카]])
		L_MESSAGE = %CALLNAME:(L_P)% は身に着けた%装備の名称(EQUIP:L_P:몸통)%による責めで絶頂に達した
		TCVAR:L_P:획득Ｖ경험 = 1
		TCVAR:L_P:획득Ａ경험 = 1
		TCVAR:L_P:획득촉수경험 = 1
	
		;触装デモニカでイクと100％の確率で行動不能だが、触手経験と触手中毒により確率を緩和できる。
		IF TCVAR:L_P:획득Ａ경험 + TCVAR:L_P:획득Ｖ경험 > 0
			IF RAND:100 + 1 > (ABL:L_P:촉수중독 * 10) + (EXP:L_P:촉수경험 / 30)
				L_MESSAGE:1 = %CALLNAME:(L_P)% は快楽に身を委ねながらも動きを止めなかった
				CFLAG:L_P:던전내발정용욕정치 += 1000
				SIF TCVAR:L_P:획득촉수경험 > 0
					CFLAG:L_P:던전내발정용욕정치 += 100 * ABL:L_P:촉수중독
				;TFLAG:전투이벤트 = 47;ADD 055
				CALL BATTLE_EVENT, "전투중 가버려 행동불능이 되지 않고 버텼다", L_P
			ELSE
				CFLAG:L_P:던전내발정용욕정치 -= 1000
				SIF TCVAR:L_P:획득촉수경험 > 0
					CFLAG:L_P:던전내발정용욕정치 += 50 * ABL:L_P:촉수중독
				SIF CFLAG:L_P:던전내발정용욕정치 < 0
					CFLAG:L_P:던전내발정용욕정치 = 0
				SIF RAND:2 == 0
					CFLAG:L_P:상태이상 = GET_STATE_NUM("HAPPY")
				;TFLAG:전투이벤트 = 48;ADD 055
				TFLAG:전투중절정 = 1
				CFLAG:L_P:입력행동 = [[스킬:행동불능]]
				CALL BATTLE_EVENT, "행동중 가버려 행동불능이 되었다", L_P
				GOTO UFUFU_END
			ENDIF
			EXP:L_P:절정경험 += TCVAR:L_P:획득Ａ경험 + TCVAR:L_P:획득Ｖ경험
			TCVAR:L_P:획득Ａ경험 = 0
			TCVAR:L_P:획득Ｖ경험 = 0
			TCVAR:L_P:획득촉수경험 = 0
		ENDIF
	ENDIF
	$UFUFU_END
	IF TFLAG:전투이벤트
		CALL PRINT_ACT_MESSAGE, L_P, , COLOR("pink"), , "절정"
		SETCOLOR COLOR("pink")
		PRINTFORMW %L_MESSAGE%
		SIF L_MESSAGE:1 != ""
			PRINTFORMW %L_MESSAGE:1%
		;CALL BATTLE_EVENT, L_P
		RESETCOLOR
		RETURN 1, COLOR("pink")
	ENDIF
ENDIF
RETURN 0, -1

;---- EDIT 106 ADD START -------------------------
;===========================================================
;デバッグ用敵コマンド指定関数
;敵のコマンドとターゲットを指定する。
;ただし、コマンドは所持しているもので、ターゲット選定も最低限
;===========================================================
@SET_ENEMY_COMMAND
#DIM LCOUNT
#DIM L_CHARA
#DIM L_LINE, 2
#DIM L_SKILL
L_LINE = LINECOUNT
REDRAW 0
$START
CLEARLINE LINECOUNT - L_LINE
FOR LCOUNT, 7, 17
	L_CHARA = POS(LCOUNT)
	PRINTFORM [{LCOUNT, 2}] 
	IF L_CHARA < 0
		PRINTL EMPTY
	ELSE
		PRINTBUTTON @"%CALLNAME:L_CHARA, 26, LEFT%", 100 + LCOUNT
		IF CFLAG:L_CHARA:적커맨드지정 == 0 && CFLAG:L_CHARA:적타겟지정 == 0
			PRINTBUTTON @"%"[" + "RANDOM" + "]", 26, LEFT%", LCOUNT + 100
		ELSE
			CALL GET_SKILL_PROP, "SKILL_NAME", CFLAG:L_CHARA:적커맨드지정, L_CHARA
			PRINTBUTTON @"%"[" + RESULTS + "]", 26, LEFT%", LCOUNT + 100
			PRINT 　>>>>>　
			SELECTCASE CFLAG:L_CHARA:적타겟지정
				CASE 0
					RESULTS = --
				CASE 1 TO 16
					IF POS(CFLAG:L_CHARA:적타겟지정) >= 0
						RESULTS = %CALLNAME:POS(CFLAG:L_CHARA:적타겟지정)%
					ELSE
						RESULTS = --
					ENDIF
				CASE 17
					RESULTS = 아군전열
				CASE 18
					RESULTS = 아군후열
				CASE 19
					RESULTS = 아군전체
				CASE 20
					RESULTS = 적전열
				CASE 21
					RESULTS = 적후열
				CASE 22
					RESULTS = 적전체
				CASE 23
					RESULTS = 적아군전체
			ENDSELECT
			PRINTBUTTON @"[{CFLAG:L_CHARA:적타겟지정, 2}] %RESULTS%", LCOUNT + 200
		ENDIF
		PRINTL 
	ENDIF
NEXT
PRINTL [99] 돌아간다
INPUT
SELECTCASE RESULT
	CASE 107 TO 117
		L_CHARA = POS(RESULT - 100)
		IF L_CHARA >= 0
			L_LINE:1 = LINECOUNT
			$INPUT_LOOP
			CLEARLINE LINECOUNT - L_LINE:1
			PRINTL [ 0] ATTACK
			FOR LCOUNT, 1, 20
				L_SKILL = ABL:L_CHARA:@"스킬{LCOUNT}"
				IF L_SKILL
					CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, L_CHARA
					PRINTFORML [{LCOUNT, 2}] %RESULTS%
				ENDIF
			NEXT
			PRINTL [21] 랜덤　　
			PRINTL [99] 돌아간다
			INPUT
			SELECTCASE RESULT
				CASE 0 TO 20
					IF RESULT == 0
						L_SKILL = 0
					ELSE
						L_SKILL = ABL:L_CHARA:@"스킬{RESULT}"
					ENDIF
					CFLAG:L_CHARA:적커맨드지정 = L_SKILL
					CALL GET_SKILL_PROP, "SKILL_TARGET", L_SKILL, L_CHARA
					SELECTCASE RESULT
						CASE 3, 4
							CFLAG:L_CHARA:적타겟지정 = 23
						CASE 1
							CALL GET_SKILL_PROP, "SKILL_SPHERE", L_SKILL, L_CHARA
							SELECTCASE RESULT
								CASE 1
									IF !INRANGE(CFLAG:L_CHARA:적타겟지정, 1, 6)
										FOR LCOUNT, 1, 7
											;---- EDIT 125 MOD START -------------------------
											SIF !IS_TARGET_ABLE(POS(LCOUNT))
												CONTINUE
											CFLAG:L_CHARA:적타겟지정 = LCOUNT
											;---- EDIT 125 MOD END ---------------------------
										NEXT
									ENDIF
								CASE 2
									SIF CFLAG:L_CHARA:적타겟지정 != 18
										CFLAG:L_CHARA:적타겟지정 = 17
								CASE 3
									CFLAG:L_CHARA:적타겟지정 = 19
							ENDSELECT
						CASE 2
							CALL GET_SKILL_PROP, "SKILL_SPHERE", L_SKILL, L_CHARA
							SELECTCASE RESULT
								;---- EDIT 115 MOD START -------------------------
								CASE 1, 5
								;---- EDIT 115 MOD END ---------------------------
									IF !INRANGE(CFLAG:L_CHARA:적타겟지정, 7, 16)
										FOR LCOUNT, 7, 17
											;---- EDIT 125 MOD START -------------------------
											SIF !IS_TARGET_ABLE(POS(LCOUNT))
												CONTINUE
											CFLAG:L_CHARA:적타겟지정 = LCOUNT
											;---- EDIT 125 MOD END ---------------------------
										NEXT
									ENDIF
								CASE 2
									SIF CFLAG:L_CHARA:적타겟지정 != 22
										CFLAG:L_CHARA:적타겟지정 = 21
								CASE 3
									CFLAG:L_CHARA:적타겟지정 = 22
							ENDSELECT
						CASEELSE
							GOTO INPUT_LOOP
					ENDSELECT
				CASE 21
					CFLAG:L_CHARA:적커맨드지정 = 0
					CFLAG:L_CHARA:적타겟지정 = 0
			ENDSELECT
		ENDIF
	CASE 207 TO 217
		L_CHARA = POS(RESULT - 200)
		IF L_CHARA >= 0
			L_SKILL = CFLAG:L_CHARA:적커맨드지정
			CALL GET_SKILL_PROP, "SKILL_TARGET", L_SKILL, L_CHARA
			SELECTCASE RESULT
				CASE 3, 4
					CFLAG:L_CHARA:적타겟지정 = 23
				CASE 1
					CALL GET_SKILL_PROP, "SKILL_SPHERE", L_SKILL, L_CHARA
					SELECTCASE RESULT
						CASE 1
							DO	
								CFLAG:L_CHARA:적타겟지정++
								SIF CFLAG:L_CHARA:적타겟지정 > 6
									CFLAG:L_CHARA:적타겟지정 = 1
							LOOP POS(CFLAG:L_CHARA:적타겟지정) < 0
						CASE 2
							CFLAG:L_CHARA:적타겟지정 = CFLAG:L_CHARA:적타겟지정 == 17 ? 18 # 17
					ENDSELECT
				CASE 2
					CALL GET_SKILL_PROP, "SKILL_SPHERE", L_SKILL, L_CHARA
					SELECTCASE RESULT
						CASE 1
							DO	
								CFLAG:L_CHARA:적타겟지정++
								SIF CFLAG:L_CHARA:적타겟지정 > 16
									CFLAG:L_CHARA:적타겟지정 = 7
							LOOP POS(CFLAG:L_CHARA:적타겟지정) < 0
						CASE 2
							CFLAG:L_CHARA:적타겟지정 = CFLAG:L_CHARA:적타겟지정 == 20 ? 21 # 20
						CASE 3
							CFLAG:L_CHARA:적타겟지정 = 22
					ENDSELECT
			ENDSELECT
		ENDIF
	CASE 99
		REDRAW 1
		RETURN 0
ENDSELECT
GOTO START
;---- EDIT 106 ADD END ---------------------------