;===================================
;敵の設定
;===================================
@SET_ENEMY,L_POS,ENEMY_NO,ENEMY_LV,IS_NOT_REMOVE,IS_BOSS = 0,IS_USEABLE_ESTOMA
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_POS
#DIM DYNAMIC L_ENEMY
#DIM DYNAMIC ENEMY_NO
#DIM DYNAMIC ENEMY_LV
#DIM DYNAMIC IS_NOT_REMOVE
#DIM DYNAMIC IS_BOSS
#DIM DYNAMIC IS_USEABLE_ESTOMA
#DIM DYNAMIC TEMP
#DIM DYNAMIC ADD_SKILL_LIST, 3000
#DIM DYNAMIC SKILL_NUM
;ARG:0 セットするポジション　ENEMY_NO　セットする悪魔　ENEMY_LV セットする悪魔のレベル　IS_NOT_REMOVE　死体残存フラグの有無 IS_BOSSボスフラグ
;1-6指定してたら面倒なので帰る
;LOCAL:4 レベルアップによる能力の増加値合計

IF INRANGE(L_POS, 7, 17)
	SIF POS(L_POS) >= 0
		THROW すでに敵がいるポジションに敵を配置しようとしています！
ELSE
	;ゼロはポジションに配置しない敵セット
	SIF L_POS != 0
		RETURN 0
ENDIF

;レベル設定
SIF ENEMY_LV == 0
	ENEMY_LV = CSVBASE(ENEMY_NO, GETNUM(BASE, "LV"))
IF FLAG:적강화옵션
	ENEMY_LV += FLAG:적강화옵션*(5+ENEMY_LV)/10
	;強化値×３の最低レベル保証。
	ENEMY_LV = MAX(ENEMY_LV, FLAG:적강화옵션*3)
ENDIF
;エストマ・キャプスロックの判定
IF IS_USEABLE_ESTOMA && IS_VALID_ESTOMA()
	SIF ENEMY_LV <= BASE:MASTER:LV
		RETURN 0
ENDIF

ADDCHARA ENEMY_NO
L_ENEMY = CHARANUM - 1

BCHARA:BCHARANUM = L_ENEMY
IS_JOINED_BCHARA:L_ENEMY:0 = 1
BCHARANUM++

;---- EDIT 000 XXX START -------------------------
;マインドシーカーはボスフラグを持たない相手に対してアンノウンフラグを立てる
IF SOFT_ON("마인드시커") && IS_BOSS == 0
	NAME:L_ENEMY = ？？？？
	CALLNAME:L_ENEMY = ？？？？
	CFLAG:L_ENEMY:언노운플래그 = 1
ENDIF
;---- EDIT 000 XXX END ---------------------------
CALL CONVERT_SECOND_PERSON, L_ENEMY

CFLAG:L_ENEMY:행동횟수 = 1
CFLAG:L_ENEMY:캐릭터고유번호 = -2

CFLAG:L_ENEMY:시체잔존 = IS_NOT_REMOVE
;SYNC関数に移動 20241125
;攻撃力と魔法威力に下駄
;CFLAG:L_ENEMY:공격보정 = ENEMY_LV
;CFLAG:L_ENEMY:마법위력보정 = ENEMY_LV

CALL SET_ENEMY_BASE_STAT, L_ENEMY, ENEMY_LV

;強化ランクを一応セットしておく
CFLAG:L_ENEMY:강화랭크 = ENEMY_LV - CSVBASE(NO:L_ENEMY,GETNUM(BASE,"LV"),0) 
;ボスフラグセット
CFLAG:L_ENEMY:보스플래그 = IS_BOSS

CALL INIT_CHARA_SKILL, L_ENEMY
FOR LCOUNT,1,21
	IF ABL:L_ENEMY:("습득스킬"+TOSTR(LCOUNT)) > 0
		CALL GET_SKILL_PROP, "味方専用", ABL:L_ENEMY:("습득스킬"+TOSTR(LCOUNT)), L_ENEMY
		IF RESULT == 0
			IF ABL:L_ENEMY:("습득LV"+TOSTR(LCOUNT)) <= BASE:L_ENEMY:LV
				CALL LEARN_SKILL_ENEMY,L_ENEMY,ABL:L_ENEMY:("습득스킬"+TOSTR(LCOUNT))
				ABL:L_ENEMY:("습득스킬"+TOSTR(LCOUNT)) = 0
				ABL:L_ENEMY:("습득LV"+TOSTR(LCOUNT)) = 0
			ENDIF
		ENDIF
	ENDIF
NEXT

;---- EDIT 005 ADD START -------------------------
IF FLAG:적강화옵션 > 0
	;強化値１０を超えると、１あたり１０％の確率で行動回数が増えてる
	SIF CFLAG:L_ENEMY:행동횟수 < 2 && RAND:10 < (FLAG:적강화옵션 - 10)
		CFLAG:(CHARANUM-1):행동횟수 += 1
	;スキル追加用のリストを作る
	;20230530
	;アクティブスキルが絶対に選定されない状態になっていた不具合を修正し、選定のアルゴリズムを変更
	;旧:Rank1 ~ 強化OP-1のスキルから1/3の確率で選定
	;新:自動スキルはRank1~強化OP
	;　 アクティブスキルのランクはレベル/5(10まで) ~ 強化OP+5(仕様上、こうしないと低Rankスキルばかりで逆に弱くなるので)
	;　 また、1/3を廃してかわりに継承素質の有無を見るように
	;　 回復スキルは常に排除する(メディアラハンなどが入るとどう考えてもひどいことになるので)
	IF FLAG:적강화옵션 > 2
		VARSET ADD_SKILL_LIST
		FOR SKILL_NUM,1,2600
			CALL GET_SKILL_PROP, "SKILL_NAME", SKILL_NUM, L_ENEMY
			SIF RESULTS == ""
				CONTINUE
			;デメリットを受けるスキルは排除
			RESULT = 0
			CALL GET_SKILL_PROP, "SKILL_IS_DEMERIT", SKILL_NUM, L_ENEMY
			SIF RESULT
				CONTINUE
			;味方専用スキルも追加候補に入らないようにする
			CALL GET_SKILL_PROP, "味方専用", SKILL_NUM, L_ENEMY
			SIF RESULT > 0
				CONTINUE
			;継承不能スキルは追加候補に入らないようにする
			CALL GET_SKILL_PROP, "継承不能", SKILL_NUM, L_ENEMY
			SIF RESULT > 0
				CONTINUE
			RESULT = 0
			CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", SKILL_NUM, L_ENEMY
			IF INRANGE(RESULT, 0, SUCCESSIONNUM -1)
				SIF !TALENT:L_ENEMY:GET_SUCCESSION(RESULT)
					CONTINUE
			ELSE
				SIF RESULT != 22
					CONTINUE
			ENDIF
			;難易度7以下では、敵専用スキルは追加候補に入らないようにする
			IF FLAG:적강화옵션 <= 7
				RESULT = 0
				CALL GET_SKILL_PROP, "敵専用", SKILL_NUM, L_ENEMY
				SIF RESULT > 0 
					CONTINUE
				CALL GET_SKILL_PROP, "ロール専用", SKILL_NUM, L_ENEMY
				SIF RESULT > 0 
					CONTINUE
			ENDIF
			RESULT = 0
			CALL GET_SKILL_PROP, "SKILL_EFECT", SKILL_NUM, L_ENEMY
			;자동효과
			;回復はボスでほぼ確実にバグるので除く
			IF RESULT == 2
				CONTINUE
			ELSEIF RESULT == 6
				RESULT = 0
				TRYCALL GET_SKILL_PROP, "SKILL_RANK", SKILL_NUM, L_ENEMY
				SIF !INRANGE(RESULT, 1, FLAG:적강화옵션)
					CONTINUE
			;自動効果以外のスキルの判定
			ELSE
				;スキルのランクを見る
				RESULT = 0
				TRYCALL GET_SKILL_PROP, "SKILL_RANK", SKILL_NUM, L_ENEMY
				;アクティブスキルはランクが低いものを持つとかえって弱くなる可能性が高いのでレベルから下限を決める
				SIF RESULT < MIN(BASE:L_ENEMY:LV / 5, 10)
					CONTINUE
				;上限はOPで決める
				SIF RESULT > FLAG:적강화옵션 + 5
					CONTINUE
			ENDIF
			ADD_SKILL_LIST:FINDELEMENT(ADD_SKILL_LIST, 0) = SKILL_NUM
			;PRINTFORML %SKILL_NAME_F(SKILL_NUM)%
		NEXT
		;WAIT
		FOR LCOUNT:1,0,FLAG:적강화옵션
			FOR LCOUNT,1,9
				LOCALS = 스킬{LCOUNT}
				IF ABL:L_ENEMY:LOCALS > 0
					VARSET D
					CALL GET_SKILL_PROP, "SKILL_RANKUP", ABL:L_ENEMY:LOCALS, L_ENEMY
					IF RESULT > 0
						TEMP = RAND:RESULT
						SIF D:(TEMP) > 0
							ABL:L_ENEMY:LOCALS = D:(TEMP)
					ENDIF
				ELSE
					WHILE MAXARRAY(ADD_SKILL_LIST) > 0
						TEMP = RAND:(FINDELEMENT(ADD_SKILL_LIST, 0))
						SKILL_NUM = ADD_SKILL_LIST:TEMP
						;所持済みならリストから抜いて再びまわす
						IF HAVE_SKILL(L_ENEMY, SKILL_NUM)
							ARRAYREMOVE ADD_SKILL_LIST, TEMP, 1
							CONTINUE
						ENDIF
						ABL:L_ENEMY:LOCALS = SKILL_NUM
						BREAK
					WEND
				ENDIF
			NEXT
		NEXT
	ENDIF

	;相性操作、弱点を３で通常、４で耐性、５で無効、６で吸収、７以上で反射に
	IF FLAG:적강화옵션 > 2
		;相性１つを
		VARSET D,-1
		TEMP = 0
		FOR LCOUNT, 0, TYPENUM - 1
			SIF MAXBASE:L_ENEMY:GET_TYPE(LCOUNT) == 999 || MAXBASE:L_ENEMY:GET_TYPE(LCOUNT) < 100
				CONTINUE
			D:(TEMP) = LCOUNT
			TEMP += 1
		NEXT
		IF TEMP > 0
			CFLAG:L_ENEMY:변경상성1 = D:(RAND:TEMP)
			CFLAG:L_ENEMY:변경상성치1 = 250-(50*FLAG:적강화옵션)
			SIF FLAG:적강화옵션 >= 7
				CFLAG:L_ENEMY:변경상성치1 = 999
;			SIF FLAG:DEBUG
;				PRINTFORML ``%CALLNAME:LOCAL%相性{CFLAG:L_ENEMY:변경상성1}`` 
		ENDIF
		;更に弱点でない相性１つも、強化値６で通常、７で耐性、８で無効、９で吸収、１０以上で反射に
		IF FLAG:적강화옵션 > 5
			VARSET D,-1
			TEMP = 0
			FOR LCOUNT, 0, TYPENUM - 1
				SIF MAXBASE:L_ENEMY:GET_TYPE(LCOUNT) == 999
					CONTINUE
				SIF MAXBASE:L_ENEMY:GET_TYPE(LCOUNT) <= 100 && FLAG:적강화옵션 < 7
					CONTINUE
				SIF MAXBASE:L_ENEMY:GET_TYPE(LCOUNT) <= 0 && FLAG:적강화옵션 < 8
					CONTINUE
				SIF MAXBASE:L_ENEMY:GET_TYPE(LCOUNT) < 0 && FLAG:적강화옵션 < 9
					CONTINUE
				D:(TEMP) = LCOUNT
				TEMP += 1
			NEXT
			IF TEMP > 0
				CFLAG:L_ENEMY:변경상성2 = D:(RAND:(TEMP))
				CFLAG:L_ENEMY:변경상성치2 = 400-(50*FLAG:적강화옵션)
				SIF FLAG:적강화옵션 >= 10
					CFLAG:L_ENEMY:변경상성치2 = 999
	;			SIF FLAG:DEBUG
	;				PRINTFORML ``%CALLNAME:LOCAL%相性{CFLAG:L_ENEMY:변경상성2}`` 
			ENDIF
		ENDIF
	ENDIF
	;強化値９以上から攻撃相性を万能相性に
	SIF FLAG:적강화옵션 > 8
		ABL:L_ENEMY:공격상성 = 17
	;強化値１３以上から最大攻撃回数が２回に
	SIF FLAG:적강화옵션 > 12 && ABL:L_ENEMY:최대공격횟수 < 2
		ABL:L_ENEMY:최대공격횟수 += 1
	;強化値１５以上から最低攻撃回数が２回に
	SIF FLAG:적강화옵션 > 12 && ABL:L_ENEMY:최저공격횟수 < 2
		ABL:L_ENEMY:최저공격횟수 += 1
	;強化値１５を超える１あたり最大攻撃回数が＋１回
	SIF FLAG:적강화옵션 > 15 && ABL:L_ENEMY:최대공격횟수 < (FLAG:적강화옵션 - 13)
		ABL:L_ENEMY:최대공격횟수 += (FLAG:적강화옵션 - 15)
ENDIF
;---- EDIT 005 ADD END ---------------------------

;味方専用スキルを削除
FOR LCOUNT,1,FLAG:스킬수+1
	LOCALS = 스킬{LCOUNT}
	CALL GET_SKILL_PROP, "味方専用", ABL:L_ENEMY:LOCALS, L_ENEMY
	SIF RESULT == 1
		ABL:L_ENEMY:LOCALS = 0
NEXT

CFLAG:L_ENEMY:ＥＸＰ보정 = 100
CFLAG:L_ENEMY:ＭＡＧ보정 = 100

;---- EDIT P 001 ADD START -------------------------
BASE:L_ENEMY:ＭＡＧ = GET_BASE_ENEMY_MAG(LOCAL)
;---- EDIT P 001 ADD END ---------------------------

;二人称を変換する
CALL CONVERT_SECOND_PERSON, LOCAL
;배우자랜덤부여
;配偶者が設定されている場合はスキップ
IF CSVCSTR(NO:LOCAL , GETNUM(CSTR , "배우자") , 0) == "" && FLAG:배우자랜덤부여 && RAND:100 < FLAG:배우자랜덤부여
	IF TALENT:L_ENEMY:남자
		CSTR:L_ENEMY:배우자 = 아내
	ELSE
		CSTR:L_ENEMY:배우자 = 남편
	ENDIF
ENDIF
;야생악마소질랜덤설정
;とりあえず胸のみ
IF FLAG:야생악마소질랜덤설정 && RAND:100 < FLAG:야생악마소질랜덤설정
	IF TALENT:L_ENEMY:남자 == 0
		TALENT:L_ENEMY:빈유 = 0
		TALENT:L_ENEMY:절벽 = 0
		TALENT:L_ENEMY:거유 = 0
		TALENT:L_ENEMY:폭유 = 0
		SELECTCASE RAND:6
			CASE 0
				TALENT:L_ENEMY:빈유 = 1
			CASE 1
				TALENT:L_ENEMY:절벽 = 1
			CASE 2
				TALENT:L_ENEMY:거유 = 1
			CASE 3
				TALENT:L_ENEMY:폭유 = 1
			CASE 4
				TALENT:L_ENEMY:마유 = 1
			;普乳
			CASE 5

		ENDSELECT
	ENDIF
ENDIF

;==========================================================
;敵の独自設定
;==========================================================
TRYCALLFORM SET_ENEMY_{NO:L_ENEMY}, L_ENEMY

CFLAG:L_ENEMY:실제가입시간 = GETMILLISECOND()
WHILE CMATCH(CFLAG:L_ENEMY:실제가입시간, CFLAG:L_ENEMY:실제가입시간) > 1
	CFLAG:L_ENEMY:실제가입시간++
WEND

CALL ADJUST_CHARA_ALI,L_ENEMY
CALL SYNC_STATUS,L_ENEMY
CALL HEALTH_CHARA,L_ENEMY
SIF L_POS > 0
	CALL INSERT_POSITION,L_POS,L_ENEMY
RETURN 1

@IS_VALID_ESTOMA
#FUNCTION
RETURNF FLAG:에스트마 || (SOFT_ON("캡스・락") && !IS_DISABLE_CAPSLOCK)

;二人称を変換する
@CONVERT_SECOND_PERSON, ARG, ARG:1 = -1, IS_CSV
#DIM DYNAMIC STOCK_MASTER
#DIM DYNAMIC IS_CSV
STOCK_MASTER = MASTER
;キャラ指定がある場合。展開の条件を踏まえてMASTERを入れ替える
SIF ARG:1 != -1
	MASTER = ARG:1
IF IS_CSV
	CSTR:ARG:이인칭 '= STRFORM(CSVCSTR(NO:ARG, GETNUM(CSTR, "이인칭")))
ELSE
	CSTR:ARG:이인칭 '= STRFORM(CSTR:ARG:이인칭)
ENDIF
IF TALENT:MASTER:남자 == 0
	SIF CSTR:ARG:이인칭 == "お兄ちゃん"
