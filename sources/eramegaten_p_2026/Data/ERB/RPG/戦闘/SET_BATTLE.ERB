@COMMAND_REPEAT, L_ACTOR = -1
#DIM DYNAMIC L_ACTOR
#DIM DYNAMIC LCOUNT
;行動入力可能でなければ行動不能にして飛ばす
IF !INPUTABLE_CHARA_F(L_ACTOR)
	CFLAG:(L_ACTOR):입력행동 = -1
	CFLAG:(L_ACTOR):방어플래그 = 0
	RETURN 0
ENDIF
;リンケージに参加している場合はセットしない
SIF CFLAG:L_ACTOR:링케이지참가
	RETURN 0
FOR LCOUNT, 0, VARSIZE("C_REPEAT_SKILL")
	CALL SET_COMMAND_REPEAT, L_ACTOR, LCOUNT
	SIF RESULT > 0
		RETURN 1
	SIF RESULT < 0
		BREAK
NEXT
;リピートをセットできなかったらGUARDに
CFLAG:(L_ACTOR):입력행동 = -1
CFLAG:(L_ACTOR):방어플래그 = 1
RETURN 0

@SET_COMMAND_REPEAT, L_ACTOR = -1, L_REPEAT_NO
#DIM DYNAMIC L_REPEAT_NO
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_ACTOR
#DIM DYNAMIC L_SKILL
#DIMS DYNAMIC L_NOT_HAVE_SKILL
#DIM DYNAMIC L_LINKAGE_MEMBER, 5
#DIM DYNAMIC L_TARGET
#DIM リンケ , 1
#DIM 人数 , 1
#LOCALSIZE 1
#DIM 元参加者 , 5

;変数セット
L_SKILL = C_REPEAT_SKILL:L_ACTOR:L_REPEAT_NO
L_NOT_HAVE_SKILL '= C_REPEAT_NOT_HAVE_SKILL:L_ACTOR:L_REPEAT_NO
L_TARGET = C_REPEAT_TARGET:L_ACTOR:L_REPEAT_NO
FOR LCOUNT, 0, 5
	IF C_REPEAT_LINKAGE_MEMBER:L_ACTOR:L_REPEAT_NO:LCOUNT == 0
		L_LINKAGE_MEMBER:LCOUNT = -2
	ELSE
		L_LINKAGE_MEMBER:LCOUNT = FINDCHARA_TIMEID(C_REPEAT_LINKAGE_MEMBER:L_ACTOR:L_REPEAT_NO:LCOUNT)
	ENDIF
NEXT
;------------------------------------------------------------
;REPEATしないスキルはここで処理
;------------------------------------------------------------
;-1はGUARDとして戻す
SIF L_SKILL < 0
	RETURN -1

;召還スキルはリピートしない
CALL GET_SKILL_PROP, "SKILL_IS_SUMMON", L_SKILL, L_ACTOR
SIF RESULT
	RETURN 0
;スキルの存在チェック
CALL GET_SKILL_PROP, "SKILL_NAME", L_SKILL, L_ACTOR
SIF RESULTS == ""
	RETURN 0

;------------------------------------------------------------
;スキルの所持チェック
;------------------------------------------------------------
VARI IS_USEABLE
;通常攻撃とリンケージは所持している必要がない
SIF L_SKILL == 0
	IS_USEABLE = 1
SIF L_SKILL == [[스킬:ＧＵＮ]]
	IS_USEABLE = 1
SIF HAVE_SKILL(L_ACTOR, L_SKILL)
	IS_USEABLE = 1
CALL GET_SKILL_PROP, "SKILL_IS_ITEMSKILL", L_SKILL, L_ACTOR
SIF RESULT
	IS_USEABLE = 1
CALL CHECK_SKILL_TAG, L_ACTOR, L_SKILL, "特殊弾"
SIF RESULT
	IS_USEABLE = 1
SIF L_SKILL == [[스킬:비소지스킬]]
	IS_USEABLE = 1
VARI L_CHARA
;リンケージ
IF INRANGE(L_SKILL, MIN_LINKAGENUM, MAX_LINKAGENUM)
	FOR LCOUNT, 0, 5
		L_CHARA = L_LINKAGE_MEMBER:LCOUNT
		SIF L_CHARA == -2
			CONTINUE
		;参加キャラがいない
		SIF L_CHARA == -1
			RETURN 0
		SIF CFLAG:L_CHARA:PT플래그 != 2
			RETURN 0
		SIF !INPUTABLE_CHARA_F(L_CHARA)
			RETURN 0
		SIF CFLAG:L_CHARA:링케이지발동
			RETURN 0
		;他のリンケージへの参加者
		SIF !GROUPMATCH(CFLAG:L_CHARA:링케이지참가, 0, L_ACTOR -1)
			RETURN 0
		CALL リンケージ参加者条件確認, L_SKILL, L_CHARA, LCOUNT + 1
		SIF !RESULT
			RETURN 0
	NEXT
	IS_USEABLE = 1
ENDIF
;スキル非所持
SIF !IS_USEABLE
	RETURN 0


;------------------------------------------------------------
;特殊なスキルはここで処理
;------------------------------------------------------------
;単体蘇生は独自の振替工程を行う
CALL GET_SKILL_PROP, "SKILL_IS_RESUSCITATION", L_SKILL, L_ACTOR
IF RESULT
	;単体蘇生対象が存在するかチェック
	CALL CHECK_TARGET_RESUSCITATION, L_ACTOR
	SIF RESULT == -1
		RETURN 0
	CFLAG:L_ACTOR:입력행동 = L_SKILL
	CFLAG:L_ACTOR:타겟 = RESULT
	RETURN 1
ENDIF
;------------------------------------------------------------
;選定条件チェック
;------------------------------------------------------------
CALL GET_SKILL_PROP, "SKILL_SELECTABLE_BY_AUTO", L_SKILL, L_ACTOR
SIF !RESULT
	RETURN 0
;------------------------------------------------------------
;リンケージのフラグセット
;------------------------------------------------------------
IF INRANGE(L_SKILL, MIN_LINKAGENUM, MAX_LINKAGENUM)
	CFLAG:L_ACTOR:사용링케이지 = L_SKILL
	CFLAG:L_ACTOR:링케이지발동 = 1
	FOR LCOUNT, 0, 5
		L_CHARA = L_LINKAGE_MEMBER:LCOUNT
		SIF L_CHARA < 0
			CONTINUE
		CFLAG:L_ACTOR:@"링케이지참가자{LCOUNT + 1}" = L_CHARA
		CFLAG:L_CHARA:링케이지참가 = L_ACTOR + 1
		CFLAG:L_CHARA:입력행동 = -1
		CFLAG:L_CHARA:방어플래그 = 0
	NEXT
ENDIF
;------------------------------------------------------------
;スキルの対象と範囲が合ってなかったら修正
;------------------------------------------------------------
CFLAG:L_ACTOR:입력행동 = L_SKILL
SIF CFLAG:L_ACTOR:입력행동 == [[스킬:비소지스킬]]
	CSTR:L_ACTOR:비소지스킬 '= L_NOT_HAVE_SKILL
CFLAG:L_ACTOR:타겟 = L_TARGET
CALL CORRECT_ACTION, L_ACTOR, 1
SIF !RESULT
	RETURN 0
CFLAG:L_ACTOR:방어플래그 = 0
RETURN 1

;-----------------------------------------
;敵キャラのベースステータス補正関数
;
;指定したキャラのステータスを難易度補正こみでセットする
;引数の並びはキャラ登録番号/힘/지혜/마력/내구/속도/운/전투난이도
;-----------------------------------------
@SET_ENEMY_BASE_STAT, L_ENEMY, L_STAT:0 = -1, L_STAT:1 = -1, L_STAT:2 = -1, L_STAT:3 = -1, L_STAT:4 = -1, L_STAT:5 = -1, L_STAT:6 = -1, L_DIFFICULT = -1
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_ENEMY
#DIM DYNAMIC L_STAT, 7
#DIM DYNAMIC L_DIFFICULT
#DIM DYNAMIC SUM_BASESTAT, 2
SIF L_DIFFICULT == -1
	L_DIFFICULT = FLAG:전투난이도
;ステータスが指定されている場合
FOR LCOUNT,1,7
	SIF L_STAT:LCOUNT >= 0
		BASE:L_ENEMY:(GET_BASESTATUS(LCOUNT)) = L_STAT:LCOUNT
NEXT

;LVによるステータス変化
IF BASE:L_ENEMY:LV != L_STAT:GET_BASESTATUS_NUM("LV") && L_STAT:GET_BASESTATUS_NUM("LV") >= 0
	;ステータスの直指定が存在していたらLVによる適正化を行わない
	IF MAXARRAY(L_STAT, 1, 7) == -1
		SUM_BASESTAT:0 = (18 + BASE:L_ENEMY:LV * 3 / 2)
		SUM_BASESTAT:1 = (18 + L_STAT:GET_BASESTATUS_NUM("LV") * 3 / 2)
		FOR LCOUNT, 1, 7
			BASE:L_ENEMY:GET_BASESTATUS(LCOUNT) *= SUM_BASESTAT:1
			BASE:L_ENEMY:GET_BASESTATUS(LCOUNT) /= SUM_BASESTAT:0
		NEXT
	ENDIF
	BASE:L_ENEMY:LV = L_STAT:GET_BASESTATUS_NUM("LV")
ENDIF

;難易度による補正
IF BASE:L_ENEMY:LV > 5
	SELECTCASE  FLAG:튜토리얼진행중 ? 2 # L_DIFFICULT
		CASE 4
			IF L_STAT:GET_BASESTATUS_NUM("LV") >= 6
				FOR LCOUNT, 1, 7
					BASE:L_ENEMY:GET_BASESTATUS(LCOUNT) *= 4
					BASE:L_ENEMY:GET_BASESTATUS(LCOUNT) /= 3
				NEXT
			ENDIF
		CASE 5
			FOR LCOUNT, 1, 7
				BASE:L_ENEMY:GET_BASESTATUS(LCOUNT) *= 8
				BASE:L_ENEMY:GET_BASESTATUS(LCOUNT) /= 3
			NEXT
		CASE IS >= 6
			FOR LCOUNT, 1, 7
				BASE:L_ENEMY:GET_BASESTATUS(LCOUNT) *= 12
				BASE:L_ENEMY:GET_BASESTATUS(LCOUNT) /= 3
			NEXT
		CASEELSE
	ENDSELECT
ENDIF

IF FLAG:적강화옵션 > 0
	FOR LCOUNT, 1, 7
		BASE:L_ENEMY:GET_BASESTATUS(LCOUNT) += FLAG:적강화옵션*(5+BASE:L_ENEMY:GET_BASESTATUS(LCOUNT))/15
		SIF CFLAG:L_ENEMY:보스플래그
			BASE:L_ENEMY:GET_BASESTATUS(LCOUNT) += FLAG:적강화옵션
	NEXT
ENDIF

;-----------------------------------------
;敵のキャラID登録関数
;L_CHARA	キャラ登録番号
;L_NAME		登録名
;特定キャラの時間IDに名前を付けて保存をする。
;システム側では自動的に実行しないので敵配置時に手動でセットしてください。
;
;登録番号は何らかの理由でずれる可能性があるので、時間IDを利用して出し入れする。
;-----------------------------------------
@SET_ENEMY_TIMEID, L_CHARA, L_NAME
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_NAME
#DIM DYNAMIC L_NUM
L_NUM = FINDELEMENT(ENEMY_TIMEID_LIST, 0)
ENEMY_TIMEID_LIST:L_NUM = CFLAG:L_CHARA:실제가입시간
ENEMY_NAME_LIST:L_NUM '= L_NAME
RETURN L_NUM

;-----------------------------------------
;敵のキャラID登録関数
;L_NAME		登録名
;
;上記関数でセットした名前から敵の登録番号を取得する。
;AIや戦闘イベント等、関数を横断して敵キャラの登録番号が必要な場合に使う。
;-----------------------------------------
@GET_ENEMY, L_NAME
#FUNCTION
#DIMS L_NAME
SIF FINDELEMENT(ENEMY_NAME_LIST, L_NAME, , , 1) < 0
	RETURNF -1
RETURNF FINDCHARA_TIMEID(ENEMY_TIMEID_LIST:FINDELEMENT(ENEMY_NAME_LIST, L_NAME, , , 1))

;-----------------------------------------
;敵のステータス同期・回復処理関数
;引数はキャラ登録番号
;指定していない場合は敵全体に処理をかける
;-----------------------------------------
@SET_UP_ENEMY, L_ENEMY = -1
#DIM DYNAMIC L_ENEMY
IF L_ENEMY >= 0
	CALL SYNC_STATUS,L_ENEMY
	CALL HEALTH_CHARA,L_ENEMY
ELSE
	FOR L_ENEMY, 0, CHARANUM
		SIF CFLAG:L_ENEMY:PT플래그 > 0
			CONTINUE
		CALL SYNC_STATUS,L_ENEMY
		CALL HEALTH_CHARA,L_ENEMY
	NEXT
ENDIF