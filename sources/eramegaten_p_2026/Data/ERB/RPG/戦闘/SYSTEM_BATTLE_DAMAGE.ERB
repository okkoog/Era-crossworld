;=================================================
;   sub DAMAGE_1
;=================================================
;   BTL計算:ダメージ
;-------------------------------------------------
;   ダメージの計算と処理を行う
;-------------------------------------------------
; Input:
;  ARG:0				攻撃者
;  ARG:1				被攻撃者
;  ARG:2				威力
;  ARG:3				使用スキル
;  ARG:4				공격상성
;  ARG:5				攻撃相性によるダメージ倍率
;  ARG:6				クリティカル率(%)
;  ARG:7				吸収率
;  ARG:8				ダメージタイプ
;  ARG:9				攻撃タイプ
;-------------------------------------------------
@BTL_CALC_DAMAGE, ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5, ARG:6 = 5, ARG:7 = 0, ARG:8 = -1, ARG:9 = -1, ARG:10, ARG:11
#DIM L_P
#DIM L_T
#DIM L_スキル
#DIM L_威力
#DIM L_相性
#DIM L_相性倍率
#DIM L_クリティカル率
#DIM L_吸収率
#DIM L_ダメージタイプ
#DIM L_攻撃タイプ
#DIM L_割合計算
#DIM L_割合上限
#DIM L_DMG
#DIM L_CRT
#DIM L_COOP

L_P = ARG
L_T = ARG:1
L_スキル = ARG:2
L_威力 = ARG:3
L_相性 = ARG:4
L_相性倍率 = ARG:5
L_クリティカル率 = ARG:6
L_吸収率 = ARG:7
L_ダメージタイプ = ARG:8
L_攻撃タイプ = ARG:9
L_割合計算 = ARG:10
L_割合上限 = ARG:11

;リンケージでのメインの行動者を確定する
CALL BTL_CHK_リンケージ, L_P
L_P = RESULT

;---- EDIT 046 MOD START 引数追加-------------------------
;クリティカル判定(戻り値はクリティカルしたかどうか)
CALL BTL_JUDG_CRT, L_P, L_T, L_クリティカル率, L_ダメージタイプ, L_攻撃タイプ, GET_TYPE(L_相性), L_相性倍率
L_CRT = RESULT
;---- EDIT 056 ADD START -------------------------
SELECTCASE RESULT:1
	CASE 999
		TSTR:바로우즈메시지 = %ADD_SPLIT(TSTR:바로우즈메시지, UNICODE(0x000D), @"CRTRATE:　確定")%
	CASE -999
		TSTR:바로우즈메시지 = %ADD_SPLIT(TSTR:바로우즈메시지, UNICODE(0x000D), @"CRTRATE:　無効")%
	;魔法で判定自体がない場合
	CASE -1000
	CASEELSE
		TSTR:바로우즈메시지 = %ADD_SPLIT(TSTR:바로우즈메시지, UNICODE(0x000D), @"CRTRATE:　{RESULT:1, 3}\%")%
ENDSELECT
;---- EDIT 056 ADD END ---------------------------
;---- EDIT 046 MOD END ---------------------------
;ダメージ計算。基礎ダメージを算出したのちに補正をかけて増減させる。(RESULT = ダメージ)
IF L_攻撃タイプ == GET_攻撃タイプ_NUM("割合")
	CALL BTL_CALC_RATE_DAMAGE, L_P, L_T, L_威力, L_ダメージタイプ, L_吸収率, L_割合計算, L_割合上限
;---- EDIT 052 ADD START -------------------------
ELSEIF L_攻撃タイプ == GET_攻撃タイプ_NUM("固定")
	CALL BTL_CALC_FIXED_DAMAGE, L_P, L_T, L_威力, L_相性倍率
;---- EDIT 052 ADD END ---------------------------
ELSE
	;---- EDIT 050 MOD START -------------------------
	;- BTL計算:基礎ダメージ
	CALL BTL_CALC_BASE_DAMAGE, L_P, L_T, L_威力, L_ダメージタイプ, L_攻撃タイプ, L_スキル
	L_DMG = RESULT
	;- BTL計算:ダメージ調整
	CALL BTL_CALC_DAMAGE_ADJUSTMENT(L_P, L_T, L_DMG, L_相性, L_相性倍率, L_CRT, L_ダメージタイプ, L_攻撃タイプ, L_スキル)
	;---- EDIT 050 MOD END ---------------------------
ENDIF
L_DMG = RESULT

;- BTL計算:ダメージをキャラクターに与え、それによって発生する処理を実行する。(RESULT = ダメージ。 RESULT:1 = クリティカル)
CALL BTL_CALC_DAMAGE_EXE(L_P, L_T, L_DMG, L_相性, L_相性倍率, L_ダメージタイプ, L_攻撃タイプ, L_CRT, L_吸収率)
L_DMG = RESULT:0
SIF RESULT:1
	SETBIT L_CRT, 0

;口上用にフラグ保存
;CALL BATTLE_EVENT_ATTACK, L_P, L_T, L_DMG, L_ダメージタイプ

SIF L_DMG < 1
	RETURN 0

;-----------------------------------------------------------------
;COOP/1moreのフラグ立てとダメージ計算(ダメージ実行処理は行動終了後)
;-----------------------------------------------------------------
;割合/固定ダメージは1MOREはするCOOPはしない
SIF GROUPMATCH(L_攻撃タイプ, GET_攻撃タイプ_NUM("割合"), GET_攻撃タイプ_NUM("固定")) && CFLAG:L_P:PT플래그 > 0
	RETURN L_DMG, L_CRT
L_COOP = 0
SIF CHECK_WEAKNESS(L_相性倍率) > 0
	SETBIT L_COOP, 0
SIF L_CRT
	SETBIT L_COOP, 1
SIF !L_COOP
	RETURN L_DMG, L_CRT
CALL BTL_CALC_DAMAGE_COOP(L_P, L_T, L_DMG, L_相性, L_ダメージタイプ, L_COOP, L_威力)
RETURN L_DMG, L_CRT

;=================================================
;   sub BTL_CHK_リンケージ
;=================================================
;   BTL:リンケージチェック
;-------------------------------------------------
; Input:
;  ARG:0				対象者
; Output:
;  RETURN				チェック結果のキャラ
;-------------------------------------------------
@BTL_CHK_リンケージ(ARG:0)
#DIM L_P
L_P = ARG:0

;リンケージの場合、能力参照者を指定できる
IF CFLAG:L_P:링케이지발동 && !CFLAG:L_P:단독링케이지
	TRYCCALLFORM リンケージ能力参照者_{CFLAG:L_P:사용링케이지}, L_P
		TRYCALLFORM リンケージ能力参照者_{CFLAG:L_P:사용링케이지}, L_P
		SIF RESULT
			L_P = CFLAG:L_P:@"링케이지참가자{RESULT}"
	CATCH
	ENDCATCH
ENDIF

RETURN L_P

;=================================================
;   sub BTL_CALC_BASE_DAMAGE
;=================================================
;   BTL計算:基礎ダメージ
;-------------------------------------------------
; Input:
;  ARG:0				攻撃者
;  ARG:1				被攻撃者
;  ARG:2				威力
;  ARG:3				計算タイプ(物理/魔法)
;  ARG:4				攻撃タイプ(物理/魔法/총/道具/割合)
; Output:
;  RETURN				ダメージ
;
;EVALUATE_DMG			
;
;備考
;アイテムの攻撃タイプはオプションで排除されるがその判定タイミングはスキルから数値を拾うときに実行
;-------------------------------------------------
;---- EDIT 050 ADD START -------------------------
@BTL_CALC_BASE_DAMAGE(ARG:0, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5)
#DIM DYNAMIC L_P
#DIM DYNAMIC L_T
#DIM DYNAMIC L_威力
#DIM DYNAMIC L_DMG
#DIM DYNAMIC L_ATK
#DIM DYNAMIC L_DEF
#DIM DYNAMIC L_攻撃値
#DIM DYNAMIC L_防御値
#DIMS DYNAMIC L_攻撃タイプ
#DIMS DYNAMIC L_ダメージタイプ
#DIM DYNAMIC L_SKILL

L_P		= ARG:0
L_T		= ARG:1
L_威力	= ARG:2
L_DMG = 0
L_ATK = 0
L_DEF = 0
L_ダメージタイプ = %GET_ダメージタイプ(ARG:3)%
L_攻撃タイプ = %GET_攻撃タイプ(ARG:4)%
;---- EDIT 060 ADD START -------------------------
L_SKILL = ARG:5
;---- EDIT 060 ADD END ---------------------------
;-----------------------------
;- 計算タイプ別チェック
;-----------------------------
;---- EDIT 060 MOD START -------------------------
TSTR:데미지해석1 = 【威力_{L_威力}】【%L_攻撃タイプ%/%L_ダメージタイプ%】
;攻撃ステータスによる基礎ダメージ算出
RESULT = 0
TRYCALLFORM SKILL_CALC_BATTTLE_STATUS_%CONVERT_SKILLNUM_TO_STR(L_P, L_SKILL)%, "ATK", L_P, L_T
IF RESULT > 0
	L_ATK = (100+MAXBASE:L_P:LV)*(RESULT)*(10+RESULT/12)
ELSE
	SELECTCASE L_攻撃タイプ
		CASE "物理"
			L_ATK = (100+MAXBASE:L_P:LV)*(MAXBASE:L_P:공격)*(10+MAXBASE:L_P:공격/12)
		CASE "魔法"
			L_ATK = (100+MAXBASE:L_P:LV)*(MAXBASE:L_P:마법위력)*(10+MAXBASE:L_P:마법위력/12)
		CASE "총"
			L_ATK = (100+MAXBASE:L_P:LV)*(MAXBASE:L_P:총공격)*(10+MAXBASE:L_P:총공격/12)
		CASE "アイテム"
			L_ATK = (100+MAXBASE:L_P:LV)*(MAXBASE:L_P:도구위력)*(10+MAXBASE:L_P:도구위력/12)
		CASE "LV"
			VARI LV_ATK = MAXBASE:L_P:LV * 2 + ((MAXBASE:L_P:LV + 18) / 6) * 7 / 2
			L_ATK = (100+MAXBASE:L_P:LV)*(LV_ATK)*(10+LV_ATK/12)
		CASE "固定"
			L_DMG = L_威力
			RETURN 0
		CASEELSE
			PRINTFORMW 공격 타입 지정 미스가 있습니다。
			PRINTFORMW 처리를 중단합니다。
			PRINTFORMW 이 메시지가 나온 경우, 보고를 부탁드립니다。
			;エラー
			RETURN 0
	ENDSELECT
ENDIF
L_DMG = L_ATK * L_威力
;防御ステータスによる基礎ダメージ減少
RESULT = 0
TRYCALLFORM SKILL_CALC_BATTTLE_STATUS_%CONVERT_SKILLNUM_TO_STR(L_P, L_SKILL)%, "DEF", L_P, L_T
IF RESULT > 0
	L_DEF = RESULT * 100 * 100
ELSE
	SELECTCASE L_ダメージタイプ
		CASE "物理"
			L_DEF = (MAXBASE:L_T:방어) * 100 * 100
		CASE "魔法"
			L_DEF = ((MAXBASE:L_T:마법효과*2+MAXBASE:L_T:방어)/3) * 100 * 100
		CASEELSE
			;エラー
			PRINTFORMW 데미지 타입 지정 미스가 있습니다。
			PRINTFORMW 처리를 중단합니다。
			PRINTFORMW 이 메시지가 나온 경우, 보고를 부탁드립니다。
			RETURN 0
	ENDSELECT
ENDIF
L_DMG /= L_DEF
TSTR:데미지해석1 += @"_【攻/防_{L_ATK}/{L_DEF}_({L_ATK*100 / L_DEF}\%)_{L_DMG}】"
;---- EDIT 060 MOD END ---------------------------
;---- EDIT 050 ADD END ---------------------------
;-----------------------------
;- 基本調整
;-----------------------------

;乱数
SIF L_DMG > 0
	L_DMG += RAND:3
L_DMG *= (9500+RAND:1000)
L_DMG /= 10000

TSTR:데미지해석1 += @"【乱数処理_{L_DMG}】"
;-----------------------------
;- 終了
;-----------------------------
RETURN L_DMG


;=================================================
;   sub BTL_CALC_DAMAGE_ADJUSTMENT
;=================================================
;   BTL計算:ダメージ調整
;-------------------------------------------------
;   入力されたダメージを、必要に応じて調整する
;-------------------------------------------------
; Input:
;  ARG:0				攻撃者
;  ARG:1				被攻撃者
;  ARG:2				ダメージ値
;  ARG:3				공격상성
;  ARG:4				相性倍率
;  ARG:5				クリティカルしているかどうか
;  ARG:6				ダメージタイプ(1:物理 2:魔法)
;  ARG:7				攻撃タイプ(物理/魔法/총/道具)
; Output:
;  RETURN				ダメージ値
;
; 備考
;  基本ダメージ算出に関与しないダメージ増減処理はここに追加してください。
;  同カテゴリー内での記述の順番は大雑把に言えば汎用性の高さ
;  どんなキャラでもつかえる>一部の種族・ロールでつかえる>原作の一部キャラのみがつかえる>EXキャラのみが使える
;  と言った感じでお願いします
;-------------------------------------------------
@BTL_CALC_DAMAGE_ADJUSTMENT(ARG:0, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5, ARG:6, ARG:7, ARG:8)
#DIM LCOUNT, 2
#DIM TEMP
#DIM L_P
#DIM L_T
#DIM L_DMG
#DIM L_SKILL
#DIM L_CRT
#DIM L_相性
#DIMS L_相性名
#DIM L_継承素質
#DIM L_相性値
#DIM L_貫通フラグ;024
#DIMS L_ダメージタイプ
#DIMS L_攻撃タイプ
#DIM L_武器素質P
#DIM L_武器素質T
#DIM L_ダメージ補正
#DIM L_解析用
#DIM TEMP_SKILL
#DIM L_SKILLCOUNT, 2
;-----------------------------
;- 初期処理
;-----------------------------

L_P				 = ARG:0
L_T				 = ARG:1
L_DMG			 = ARG:2
L_相性			 = ARG:3
L_相性名		 = %GET_TYPE(L_相性)%
L_相性値		 = ARG:4
L_CRT			 = ARG:5
L_ダメージタイプ'= GET_ダメージタイプ(ARG:6)
L_攻撃タイプ	'= GET_攻撃タイプ(ARG:7)
L_SKILL 		 = ARG:8

CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", L_SKILL, L_P
L_継承素質 = RESULT

CALL MATCHING_WEAPON_CHECK(L_P)
L_武器素質P = RESULT
CALL WEAPON_STYLE_CHECK(L_P,RESULT)
;3ケタ以降は型
L_武器素質P += RESULT * 100

CALL MATCHING_WEAPON_CHECK(L_T)
L_武器素質T = RESULT
CALL WEAPON_STYLE_CHECK(L_T,RESULT)
;3ケタ以降は型
L_武器素質T += RESULT * 100

L_SKILLCOUNT = CHARA_SKILLCOUNT(L_P), CHARA_SKILLCOUNT(L_T);EDIT046 ADD

SIF L_相性 < 0
	THROW 相性のないスキル[{L_SKILL}]がダメージ処理を通過しようとしています
;-----------------------------
;- ダメージタイプ別チェック
;-----------------------------
TSTR:데미지해석2 = 【基礎_{L_DMG}】
L_解析用 = MAX(L_DMG, 1)
;- 物理ダメージタイプ
IF (L_ダメージタイプ == "物理")
	;影霄・絶影用特殊処理
	IF SKILLGAGE_F_GET(L_P,PU_SKILLNUM_GET(L_P,"影霄・絶影")) < 0
		IF SKILLGAGE_H_GET(L_P,PU_SKILLNUM_GET(L_P,"影霄・絶影")) >= 10000 || SKILLGAGE_H_GET(L_P,PU_SKILLNUM_GET(L_P,"影霄・絶影")) >= -1
			L_DMG *= 2
			GOTO AN_CHIMAERA_SKIP
		ENDIF
	ENDIF
	;毒は物理ダメージを半減させる
	SIF GET_STATE(CFLAG:L_P:상태이상) == "POISON"
		L_DMG /= 2
	;特殊ダメージ補正
	L_DMG = L_DMG * (CFLAG:L_T:물리피데미지보정 +100) / 100
	L_DMG = L_DMG * (CFLAG:L_P:물리여데미지보정 +100) / 100
ELSE
	;キメラ用特殊処理
	IF SKILLGAGE_F_GET(L_P,PU_SKILLNUM_GET(L_P,"キメラ")) < 0
		L_DMG *= 2
		GOTO AN_CHIMAERA_SKIP
	ENDIF
	;魔法はダメージを1/5にする
	SIF GET_STATE(CFLAG:L_P:상태이상) == "CLOSE"
		L_DMG /= 5

	;特殊ダメージ補正
	L_DMG = L_DMG * (CFLAG:L_T:마법피데미지보정 +100) / 100
	L_DMG = L_DMG * (CFLAG:L_P:마법여데미지보정 +100) / 100
ENDIF
L_DMG = L_DMG * (CFLAG:L_T:(L_相性名 + "피데미지보정") +100) / 100
L_DMG = L_DMG * (CFLAG:L_P:(L_相性名 + "여데미지보정") +100) / 100
TSTR:데미지해석2 += @"【攻防強化_{L_DMG * 100/L_解析用}\%】"
L_解析用 = MAX(L_DMG, 1)
;---- EDIT 056 ADD START -------------------------
;-----------------------------
;- カジャンダの処理
;-----------------------------
;---- EDIT P 001 MOD START -------------------------
;---- EDIT 060 MOD START -------------------------
RESULT = 0, 0
;スキル側で指定する場合
TRYCALLFORM SKILL_CALC_BUFF_%CONVERT_SKILLNUM_TO_STR(L_P, L_SKILL)%, "ATK", L_P, L_T
IF RESULT:1 > 0
	IF RESULT > 0
		IF CFLAG:L_P:장력
			;장력　攻撃・魔威両参照などで3倍になっているものなどを考慮して上限をセットしておく
			L_DMG = L_DMG * (RESULT + MIN(RESULT / 2, RESULT:1 / 2) + RESULT:1) / RESULT:1
		ELSE
			L_DMG = L_DMG * (RESULT + RESULT:1) / RESULT:1
		ENDIF
	ELSE
		L_DMG = L_DMG * (RESULT + RESULT:1 * 2) /(RESULT:1 * 2)
	ENDIF
ELSE
	IF L_攻撃タイプ == "魔法"
		IF CFLAG:L_P:마법위력강화 > 0
			IF CFLAG:L_P:장력
				L_DMG = L_DMG * (CFLAG:L_P:마법위력강화 * 3 / 2 + 32) / 32
			ELSE
				L_DMG = L_DMG * (CFLAG:L_P:마법위력강화 + 32) / 32
			ENDIF
		ELSE
			L_DMG = L_DMG * (CFLAG:L_P:마법위력강화 + 64) / 64
		ENDIF
	ELSE
		IF CFLAG:L_P:공격강화 > 0
			IF CFLAG:L_P:장력
				L_DMG = L_DMG * (CFLAG:L_P:공격강화 * 3 / 2 + 32) / 32
			ELSE
				L_DMG = L_DMG * (CFLAG:L_P:공격강화 + 32) / 32
			ENDIF
		ELSE
			L_DMG = L_DMG * (CFLAG:L_P:공격강화 + 64) / 64
		ENDIF
	ENDIF
ENDIF
;---- EDIT P 001 MOD END ---------------------------
RESULT = 0, 0
TRYCALLFORM SKILL_CALC_BUFF_%CONVERT_SKILLNUM_TO_STR(L_P, L_SKILL)%, "DEF", L_P, L_T
;スキル側して指定する場合
IF RESULT:1 > 0
	IF RESULT > 0
		L_DMG = L_DMG * (RESULT:1 * 2 - RESULT) / (RESULT:1 * 2)
	ELSE
		L_DMG = L_DMG * (RESULT:1 - RESULT) / RESULT:1
	ENDIF
ELSE
	IF L_ダメージタイプ == "魔法"
		;魔法ダメージはラクカジャ・サマカジャの両方を見る
		IF CFLAG:L_T:방어강화 + CFLAG:L_T:마법효과강화 > 0
			L_DMG = L_DMG * MAX(128 - (CFLAG:L_T:방어강화 + CFLAG:L_T:마법효과강화), 64) / 128
		ELSE
			L_DMG = L_DMG * (64 - (CFLAG:L_T:방어강화 + CFLAG:L_T:마법효과강화)) / 64
		ENDIF
	ELSE
		IF CFLAG:L_T:방어강화 > 0
			L_DMG = L_DMG * (64 - CFLAG:L_T:방어강화) / 64
		ELSE
			L_DMG = L_DMG * (32 - CFLAG:L_T:방어강화) / 32
		ENDIF
	ENDIF
ENDIF
;---- EDIT 060 MOD END ---------------------------
;---- EDIT 056 ADD END ---------------------------
TSTR:데미지해석2 += @"【カジャンダ_{L_DMG * 100/L_解析用}\%】"
L_解析用 = MAX(L_DMG, 1)
$AN_CHIMAERA_SKIP
;-----------------------------
;- 耐性処理
;相性は上流で計算したものを適用する
;-----------------------------
L_DMG *= L_相性値
L_DMG /= 100

TSTR:데미지해석2 += @"【相性_{L_相性値}\%】"
L_解析用 = MAX(L_DMG, 1)
;-----------------------------
;-基本のダメージ処置
;방어플래그(ダメージ半減)
;後列判定(ダメージ0.7倍)
;異常によるダメージ増加(最大2倍)
;真全門耐性・追撃の心得・ヘルズゲート
;-----------------------------

;防御中のキャラにはダメージ減少
SIF CFLAG:L_T:방어플래그
	L_DMG /= 2

;---- EDIT 012 ADD ------
;槍、投具の二ノ型の場合後列への攻撃減少なし(銃・アイテムを除く)
;IF !FLAG:銃攻撃中 && ((L_武器素質P == 205 && L_ダメージタイプ == 1) || (L_武器素質P == 208 && L_ダメージタイプ == 2))
IF (L_攻撃タイプ != "총") && ((L_武器素質P == 205 && L_ダメージタイプ == "物理") || (L_武器素質P == 208 && L_ダメージタイプ == "魔法"))
	TIMES L_DMG,1.00
;後列のキャラにはダメージ減少
ELSEIF !IS_FRONT(L_T)
	TIMES L_DMG,0.70
ENDIF
TSTR:데미지해석2 += @"【列・GUARD_{L_DMG * 100/L_解析用}\%】"
L_解析用 = MAX(L_DMG, 1)

;---- EDIT P 004 MOD START -------------------------
IF CFLAG:L_T:PT플래그 > 0 && !FLAG:튜토리얼진행중
	SELECTCASE FLAG:전투난이도
		CASE 1
			TIMES L_DMG,0.75
		CASE 3,4
			TIMES L_DMG , 1.5
		CASE 5
			TIMES L_DMG , 2
		CASE 6
			TIMES L_DMG , 3
	ENDSELECT
ENDIF
;---- EDIT P 004 MOD END ---------------------------
TSTR:데미지해석2 += @"【難度補正_{L_DMG * 100/L_解析用}\%】"
L_解析用 = MAX(L_DMG, 1)
;攻撃者が幸せだとダメージ減少
SIF CFLAG:L_P:상태이상 == GET_STATE_NUM("HAPPY")
	TIMES L_DMG,0.70

;攻撃者が蝿でダメージ減少
SIF CFLAG:L_P:상태이상 == GET_STATE_NUM("FLY")
	TIMES L_DMG,0.50

;---- EDIT P 004 MOD START -------------------------
;難易度EASYなら敵へのダメージ大
SIF CFLAG:L_T:PT플래그 == 0 && FLAG:전투난이도 == 1 &&  !FLAG:튜토리얼진행중
	TIMES L_DMG , 1.40
;---- EDIT P 004 MOD END ---------------------------
;幸せだとダメージ大
SIF CFLAG:L_T:상태이상 == GET_STATE_NUM("HAPPY")
	TIMES L_DMG,1.25
;眠っていたらダメージ大
SIF CFLAG:L_T:상태이상 == GET_STATE_NUM("SLEEP")
	TIMES L_DMG,1.5
;蝿状態ならダメージ大
SIF CFLAG:L_T:상태이상 == GET_STATE_NUM("FLY")
	TIMES L_DMG,1.5
;自身がオルギアでダメージ上昇
SIF CFLAG:L_P:상태이상 == GET_STATE_NUM("ORGY")
	TIMES L_DMG,1.25

;- 特定の状態異常時、ダメージが倍化
SELECTCASE GET_STATE(CFLAG:L_T:상태이상)
	;- FREEZE時は電撃、地変
	CASE "FREEZE"
		SIF L_相性名 == "전격" || L_相性名 == "지변"
			TIMES L_DMG,2.0
			
	;- SHOCK時は氷結、水撃
	CASE "SHOCK"
		SIF L_相性名 == "빙결" || L_相性名 == "수격"
			TIMES L_DMG,2.0
			
	;- SLIP時は重力、物理
	CASE "SLIP"
		IF L_相性名 == "중력" || L_相性名 == "검격" || L_相性名 == "타격" || L_相性名 == "비구" || L_相性名 == "전술"
			TIMES L_DMG,1.7
			SIF L_相性名 == "중력"
				CFLAG:L_T:SLIP중중력피탄플래그 = 1
		ENDIF
		
	;- FLAME時は疾風、核熱
	CASE "FLAME"
		SIF L_相性名 == "질풍" || L_相性名 == "핵열"
			TIMES L_DMG,1.5
			
ENDSELECT
;more系
;追撃の心得持ち+1more中は威力が1.5倍
SIF CFLAG:L_T:１more플래그 > 900 && HAVE_SKILL(L_T,[[스킬:추격의심득]])
	TIMES L_DMG,1.5

;진・전문내성(万能以外半減・万能倍化)
SIF HAVE_SKILL(L_T, [[스킬:진・전문내성]])
	L_DMG = (L_相性名 == "만능") ? L_DMG * 2 # L_DMG / 2

;ヘルズゲート処理
;敵の1MOREを発生させなくする代わりに被ダメージ2倍
;ヘルズゲートをインストールしていて、攻撃対象が味方である
IF SOFT_ON("헬즈게이트") && CFLAG:L_T:PT플래그
	IF !HAVE_SKILL(L_P, [[스킬:엑스트라원]] ) && !CFLAG:L_P:보스플래그
		IF L_CRT  && CHECK_WEAKNESS(L_相性値) > 0
			L_DMG *= 2
		ENDIF
	ENDIF
ENDIF

TSTR:데미지해석2 += @"【バステ_{L_DMG * 100/L_解析用}\%】"
L_解析用 = MAX(L_DMG, 1)
;------------------------------------------------------------------------
;クリティカルの処理
;------------------------------------------------------------------------
IF L_CRT
	TIMES L_DMG , 1.50
	TFLAG:크리티컬발생_HIT = 1
	TFLAG:크리티컬발생_ACT = 1
ENDIF

TSTR:데미지해석2 += @"【CRT_{L_DMG * 100/L_解析用}\%】"
L_解析用 = MAX(L_DMG, 1)
;---------------------------------------------------------------------------
;素質によるダメージ増加(継承素質補正+武器素質系補正)
;ダメージへの影響度が下記の乗算ダメージ補正群より大きくなるので
;基本的にはここへの補正の追加は推奨しません。
;---------------------------------------------------------------------------
L_ダメージ補正 = 100
;攻撃の心得はLv毎に10%の補正を与える(旧達人・人修羅処理)
;継承素質補正は15%の補正を与える
;この2種は片方のみ適用される
IF GET_BTL_TALENT_LV("스킬적성", L_P) && 相性素質チェック_F(L_P, L_継承素質)
	TEMP = SUB_ROLE_스킬적성효과("ダメージ補正", L_P)
ELSE
	TEMP = 0
ENDIF
