;------------------------------------------------------------------------
;ダメージタイプ変更措置
;------------------------------------------------------------------------
;キメラ起動中、魔法攻撃だった場合はダメージタイプを「なし」として扱う
;具体的には気合・集中の利用ができなくなり、さらにカジャンダによるダメージ増減の影響を受けなくなり、一部の武器素質による補正が発生しなくなる。
SIF SKILLGAGE_F_GET(L_P,PU_SKILLNUM_GET(L_P,"キメラ")) < 0 && L_ダメージタイプ == "魔法"
	L_ダメージタイプ = なし
;影霄・絶影の最後の一撃と、その後のスキル効果時間中は物理攻撃のダメージタイプを「なし」として扱う
SIF (SKILLGAGE_F_GET(L_P,PU_SKILLNUM_GET(L_P,"影霄・絶影")) < 0 && L_ダメージタイプ == "物理") && (SKILLGAGE_H_GET(L_P,PU_SKILLNUM_GET(L_P,"影霄・絶影")) >= 10000 || SKILLGAGE_H_GET(L_P,PU_SKILLNUM_GET(L_P,"影霄・絶影")) > -1)
	L_ダメージタイプ = なし

;-----------------------------------------------------------------------
;乗算ダメージ補正群
;大半のダメージ補正はここで加算にすることでダメージインフレに対する安全係数を確保しています。
;そういうわけでキャラ個別の補正は基本的にここに追加してください。
;-----------------------------------------------------------------------
L_ダメージ補正 = 100
L_ダメージ補正 += C_HAVE_BOOSTER_STRENGTH:L_P:L_相性

;==============================
;チャージ効果
;기합/集中　+150%で、2以上のフラグを持たされている場合は+50づつ増加、ブースタは+50%、チェーンアップは下のテーブル参照
;他人気合/集中(ドナム)　+50%で、2以上のフラグを持たされている場合は+10づつ増加、ブースタは+15%
;==============================
;気合で物理攻撃のみ+150%
;使用判定は命中判定後に行う
IF TFLAG:기합사용
	L_ダメージ補正 += (CFLAG:L_P:気合フラグ > 0) * 100 + CFLAG:L_P:気合フラグ * 50
	L_ダメージ補正 += (CFLAG:L_P:타인기합플래그 > 0) * 40 + CFLAG:L_P:타인기합플래그 * 10
	IF HAVE_SKILL(L_P, [[스킬:기합부스터]])
		L_ダメージ補正 += (CFLAG:L_P:気合フラグ > 0) * 50
		L_ダメージ補正 += (CFLAG:L_P:타인기합플래그 > 0) * 15
	ELSE
		IF COUNT_ACTIVE_LEADER_SKILL("チェーンアップ") && GETS_ROLE_PROP("INSTALLSOFT_EFFECT_TYPE", L_P) == "悪魔"
			L_ダメージ補正 += (CFLAG:L_P:気合フラグ > 0) * GET_POWER_チェーンアップ(L_P)
			L_ダメージ補正 += (CFLAG:L_P:타인기합플래그 > 0) * RESULT_F
