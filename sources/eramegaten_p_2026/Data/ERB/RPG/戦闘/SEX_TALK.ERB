	;임신
	SIF RESULT
		CALL SET_PREGNANCY, ARG:1, ARG
		;CALL SET_FETUS_STATUS, ARG:1, ARG
		;CALL SET_FATHERINFO, ARG:1, NO:ARG, , NAME:ARG
	;Ａ経験だけでは相手にペニスがあるか分からないのでそこもチェック
ELSEIF TALENT:(ARG:1):오토코노코 == 1 && HAVE_PENIS(ARG)
	CFLAG:(ARG:1):고객의질내사정에의한임신판정 = TCVAR:(ARG:1):획득Ａ경험*2
	CALL PREGNANCY_CHECK, ARG:1, ARG
	;임신
	SIF RESULT
		CALL SET_PREGNANCY, ARG:1, ARG
		;CALL SET_FETUS_STATUS, ARG:1, ARG
		;CALL SET_FATHERINFO, ARG:1, NO:ARG, , NAME:ARG
ENDIF
CALL SEXIAL_まとめ処理, ARG, ARG:1, 3,
LOCAL:1 = RESULT

CALL FIGHT_IT_OUT
RETURN LOCAL:1
;===================================
;プレイ回数計算
;===================================
@ADD_SEXTALK_PLAY,ARG,ARG:1,ARG:2
#DIM CHARA , 1
#DIM DEMON , 1
#DIM 回数計算
#DIM 回数
#DIM 精液量
#DIM Ｃ回数
#DIM Ｖ回数
#DIM Ｂ回数
#DIM 絶頂回数
#DIM 精液回数
#DIM 精飲回数
#DIM 性交回数
#DIM 질내사정횟수
#DIM キス回数
#DIM 펠라횟수
#DIM Ａ回数
#DIM Ａ性交回数
#DIM 絶頂ポイント
#DIM 精液残量

;ARG = 교섭대상
;ARG:1 = 宛がわれたキャラ
;ARG:2 = 0 相手からの要求 1 犯して欲しい 2 やらせて欲しい
CHARA = ARG:1
DEMON = ARG

;初期化
FOR LOCAL,0,2
	CFLAG:(ARG:LOCAL):삽입횟수 = 0
	CFLAG:(ARG:LOCAL):본방횟수 = 0
	CFLAG:(ARG:LOCAL):애널횟수 = 0
	CFLAG:(ARG:LOCAL):펠라횟수 = 0
	CFLAG:(ARG:LOCAL):클리자극횟수 = 0
	CFLAG:(ARG:LOCAL):가슴자극횟수 = 0
NEXT

;対象がペニス付きならフェラ・Ｖ・Ａ増加
IF HAVE_PENIS(DEMON)
	IF HAVE_VAGINA(CHARA)
		CFLAG:DEMON:삽입횟수 = 1+(3+ABL:CHARA:Ｖ감각)/2
		;本番は必ず1回はする
		CFLAG:CHARA:본방횟수 += LIMIT(RAND:(CFLAG:DEMON:삽입횟수+1), 1, CFLAG:DEMON:삽입횟수)
	ELSE
		CFLAG:DEMON:삽입횟수 = 1+(3+ABL:CHARA:Ａ감각)/2
		CFLAG:CHARA:애널횟수 += LIMIT(RAND:(CFLAG:DEMON:삽입횟수+1), 0, CFLAG:DEMON:삽입횟수)
	ENDIF
	CFLAG:DEMON:삽입횟수 = 1+(3+ABL:CHARA:Ａ감각)/2
	CFLAG:CHARA:애널횟수 += LIMIT(RAND:(CFLAG:DEMON:삽입횟수+1), 0, CFLAG:DEMON:삽입횟수)
	回数計算 = 1+(5+ABL:CHARA:봉사정신)/2
	CFLAG:CHARA:펠라횟수 += LIMIT(RAND:(回数計算+1), 0, 回数計算)
ELSE
	回数計算 = (6+ ABL:DEMON:기교)/2
	CFLAG:DEMON:클리자극횟수 += LIMIT(RAND:(回数計算+1), 0, 回数計算)
ENDIF
;仲魔がペニスつきならフェラ・Ｖ・Ａ増加
IF HAVE_PENIS(CHARA)
	IF HAVE_VAGINA(DEMON)
		CFLAG:CHARA:삽입횟수 = 1+(3+ ABL:DEMON:기교)/2
		;本番は必ず1回はする
		CFLAG:DEMON:본방횟수 += LIMIT(RAND:(CFLAG:CHARA:삽입횟수+1), 1, CFLAG:CHARA:삽입횟수)
	ELSE
		IF TALENT:DEMON:남자 == 0 || ABL:DEMON:Ａ감각 || (ABL:DEMON:ＢＬ끼 && TALENT:CHARA:남자) || TALENT:CHARA:오토코노코
			CFLAG:CHARA:삽입횟수 = 1+(3+ ABL:DEMON:기교)/2
			CFLAG:DEMON:애널횟수 += LIMIT(RAND:(CFLAG:CHARA:삽입횟수+1), 0, CFLAG:CHARA:삽입횟수)
		ENDIF
	ENDIF
	IF TALENT:DEMON:남자 == 0 || ABL:DEMON:Ａ감각 || (ABL:DEMON:ＢＬ끼 && TALENT:CHARA:남자) || TALENT:CHARA:오토코노코
		CFLAG:CHARA:삽입횟수 += 1+(3+ ABL:DEMON:기교)/2
		CFLAG:DEMON:애널횟수 += LIMIT(RAND:(CFLAG:CHARA:삽입횟수+1), 0, CFLAG:CHARA:삽입횟수)
	ENDIF
	SIF TALENT:DEMON:남자 == 0 || TALENT:DEMON:오토코노코 || (ABL:DEMON:ＢＬ끼 && TALENT:CHARA:남자)
		CFLAG:DEMON:펠라횟수 += 1+(5+ ABL:DEMON:기교)/2
ELSE
	CFLAG:CHARA:클리자극횟수 += (6+ABL:CHARA:Ｃ감각)/2
ENDIF


SIF TALENT:CHARA:오토코노코 || TALENT:CHARA:남자 == 0
	CFLAG:CHARA:가슴자극횟수 += (6+ABL:CHARA:Ｂ감각)/2
SIF TALENT:DEMON:오토코노코 || TALENT:DEMON:남자 == 0
	CFLAG:DEMON:가슴자극횟수 += (6 + ABL:DEMON:기교)/2

IF !(HAVE_PENIS(DEMON) || HAVE_PENIS(CHARA))
	TIMES CFLAG:DEMON:클리자극횟수 , 2.00
	TIMES CFLAG:DEMON:가슴자극횟수 , 2.00
	TIMES CFLAG:CHARA:클리자극횟수 , 2.00
	TIMES CFLAG:CHARA:가슴자극횟수 , 2.00
ENDIF

FOR LOCAL,0,2
	TCVAR:(ARG:LOCAL):획득펠라경험 = CFLAG:(ARG:LOCAL):펠라횟수
	TCVAR:(ARG:LOCAL):획득Ｖ경험 = CFLAG:(ARG:LOCAL):본방횟수
	TCVAR:(ARG:LOCAL):획득Ａ경험 = CFLAG:(ARG:LOCAL):애널횟수
	TCVAR:(ARG:LOCAL):획득성교경험 = CFLAG:(ARG:LOCAL):본방횟수 + CFLAG:(ARG:LOCAL):애널횟수
	TCVAR:(ARG:LOCAL):획득키스경험 = LIMIT(RAND:(TCVAR:(ARG:LOCAL):획득성교경험+1), 0, TCVAR:(ARG:LOCAL):획득성교경험)
NEXT
;획득질사경험(仲魔)
回数計算 = CFLAG:CHARA:본방횟수
SIF CFLAG:CHARA:본방횟수
	TCVAR:CHARA:획득질사경험 = LIMIT(RAND:(回数計算+1), 1, 回数計算)
;획득질사경험(悪魔)
回数計算 = CFLAG:DEMON:본방횟수
SIF CFLAG:DEMON:본방횟수
	TCVAR:DEMON:획득질사경험 = LIMIT(RAND:(回数計算+1), 1, 回数計算)

;획득절정경험(仲魔)
回数計算 = CFLAG:CHARA:본방횟수 + CFLAG:CHARA:애널횟수
SIF ABL:DEMON:기교 > 0
	回数計算 += CFLAG:CHARA:클리자극횟수 + CFLAG:CHARA:가슴자극횟수
TCVAR:CHARA:획득절정경험 = LIMIT(RAND:(回数計算+1), 0, 回数計算)
回数計算 = CFLAG:CHARA:본방횟수 + CFLAG:CHARA:애널횟수
SIF ABL:DEMON:기교 > 0
	回数計算 += CFLAG:CHARA:클리자극횟수 + CFLAG:CHARA:가슴자극횟수
TCVAR:CHARA:획득절정경험 = LIMIT(RAND:(回数計算+1), 0, 回数計算)
;획득절정경험(悪魔)
回数計算 = CFLAG:DEMON:본방횟수 + CFLAG:DEMON:애널횟수
SIF ABL:CHARA:기교 > 0
	回数計算 += CFLAG:DEMON:클리자극횟수 + CFLAG:DEMON:가슴자극횟수
TCVAR:DEMON:획득절정경험 = LIMIT(RAND:(回数計算+1), 0, 回数計算)
回数計算 = CFLAG:DEMON:본방횟수 + CFLAG:DEMON:애널횟수
SIF ABL:CHARA:기교 > 0
	回数計算 += CFLAG:DEMON:클리자극횟수 + CFLAG:DEMON:가슴자극횟수
TCVAR:DEMON:획득절정경험 = LIMIT(RAND:(回数計算+1), 0, 回数計算)

TCVAR:CHARA:획득매춘경험 = 1 + TCVAR:CHARA:획득성교경험
;획득정액경험(仲魔)
TCVAR:CHARA:획득정액경험 = TCVAR:CHARA:획득질사경험 + TCVAR:CHARA:획득펠라경험
;획득정액경험(悪魔)
TCVAR:DEMON:획득정액경험 = TCVAR:DEMON:획득질사경험 + TCVAR:DEMON:획득펠라경험

;획득사정경험
TCVAR:DEMON:획득사정경험 = TCVAR:CHARA:획득정액경험
;획득사정경험
TCVAR:CHARA:획득사정경험 = TCVAR:DEMON:획득정액경험

IF !(TALENT:CHARA:짐승 || TALENT:CHARA:새) && (TALENT:DEMON:짐승 || TALENT:DEMON:새)
	SIF EXP:CHARA:수간경험 == 0
		CALL ADDS_ABNORMAL_EXP, "獣姦", CHARA
	TCVAR:CHARA:획득수간경험 = TCVAR:CHARA:획득성교경험
ENDIF
IF (TALENT:CHARA:짐승 || TALENT:CHARA:새) && !(TALENT:DEMON:짐승 || TALENT:DEMON:새)
	SIF EXP:DEMON:수간경험 == 0
		CALL ADDS_ABNORMAL_EXP, "獣姦", DEMON
	TCVAR:DEMON:획득수간경험 = TCVAR:DEMON:획득성교경험
ENDIF
;陥落している場合にヤラせてもらう・犯してもらうだと浮気経験が付く
IF 陥落(CHARA) && (ARG:2 == 1 || ARG:2 == 2)
	TCVAR:CHARA:획득바람경험 = 1
ENDIF
;ソースの獲得
SOURCE:CHARA:쾌Ｃ = CFLAG:CHARA:클리자극횟수*25 + CFLAG:DEMON:펠라횟수 * 25 + CFLAG:CHARA:삽입횟수 * 50
SOURCE:CHARA:쾌Ｖ = CFLAG:CHARA:본방횟수*50
SOURCE:CHARA:쾌Ａ += CFLAG:CHARA:애널횟수*50
SOURCE:CHARA:쾌Ｂ += CFLAG:CHARA:가슴자극횟수*25
SOURCE:CHARA:욕정 += TCVAR:CHARA:획득정액경험*5 * (ABL:CHARA:정액중독)

;汚れの処理
IF TALENT:CHARA:남자
	CALL SET_STAIN("페니스" , "愛液" , CHARA)
	SIF TALENT:DEMON:처녀
		CALL SET_STAIN("페니스" , "破瓜の血" , CHARA)
ELSE
	CALL SET_STAIN("질내" , "愛液" , CHARA)
	CALL SET_STAIN("바기나" , "愛液" , CHARA)
	IF CFLAG:CHARA:본방횟수 > 0
		CALL SET_STAIN("질내" , "精液" , CHARA)
		CALL SET_STAIN("바기나" , "精液" , CHARA)
		SIF TALENT:CHARA:처녀 || TALENT:CHARA:재생처녀
			CALL SET_STAIN("바기나" , "破瓜の血" , CHARA)
	ENDIF
	IF CFLAG:CHARA:펠라횟수 > 0
		CALL SET_STAIN("입" , "精液" , CHARA)
		CALL SET_STAIN("손" , "精液" , CHARA)
		SIF TEQUIP:CHARA:유방노출
			CALL SET_STAIN("가슴" , "精液" , CHARA)
	ENDIF
	IF CFLAG:CHARA:애널횟수 > 0
		CALL SET_STAIN("애널" , "精液" , CHARA)
	ENDIF
	;髪への汚れはとりあえずランダム
	SIF RAND:4 == 0
		CALL SET_STAIN("머리카락" , "精液" , CHARA)
ENDIF

;自分から売っても売春は売春だよね？異常経験が付いていいと思うのでそうする
;SIF TALENT:CHARA:처녀 && ARG:2 == 0
IF CFLAG:CHARA:본방횟수 > 0
	SIF TALENT:CHARA:처녀
		CALL ADDS_ABNORMAL_EXP, "処女喪失（売春）", CHARA
	TALENT:CHARA:처녀 = 0
	TALENT:CHARA:재생처녀 = 0
ENDIF
;異常経験の計算
CALL SHOW_ABNORMAL_EXP, CHARA
CALL SHOW_ABNORMAL_EXP, DEMON

;処女貫通履歴用
IF CHARA == MASTER && TALENT:DEMON:처녀
	CALL SET_陥落履歴, NO:DEMON, "처녀"
	;処女奪取人数カウント
	FLAG:처녀탈취인수 += 1
ENDIF

;===================================
;敗北時の処理
;===================================
@SEXTALK_LOSE,ARG
PRINTFORML 그 후, %CALLNAME:MASTER%은(는) 두 번 다시 해방되지 못했다……
PRINTW 
PRINTW 　　　　　　　　――  Bad Ending No.020 ( 전멸 END -향연의 끝의 끝- )
