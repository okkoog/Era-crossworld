;==========================================================
;@SEXIAL_ヤらせてもらう
; 悪魔会話での『犯してもらう』処理
;<引数>
;	ARG   = 会話相手悪魔
;	ARG:1 = 会話をしているキャラ
;	LOCAL = 汎用
;	LOCAL:1 = 악마만족도
;<戻り値>
;	LOCAL:1 = 악마만족도
;==========================================================

@SEXIAL_ヤらせてもらう,ARG,ARG:1
#LOCALSIZE 2
VARSET NOWEX:ARG:0,0
VARSET NOWEX:(ARG:1):0,0

CALL ADD_SEXTALK_PLAY,ARG,ARG:1,1

PRINTL
PRINTFORML %CALLNAME:(ARG:1)%의 교섭
IF TCVAR:(ARG:1):획득Ｖ경험
	IF TALENT:(ARG:1):처녀
		PRINTFORML 처녀상실
		TALENT:(ARG:1):처녀 = 0
	ELSEIF TALENT:(ARG:1):재생처녀
		PRINTFORML 재생처녀상실
		TALENT:(ARG:1):재생처녀 = 0
	ENDIF
ENDIF
;妊娠判定用
IF PREGNANCY_ABLE(ARG:1)
	IF TALENT:(ARG:1):남자 == 0 
		CFLAG:(ARG:1):고객의질내사정에의한임신판정 = TCVAR:(ARG:1):획득질사경험*2
		CALL PREGNANCY_CHECK, ARG:1, ARG
		;妊娠確定
		SIF RESULT
			CALL SET_PREGNANCY, ARG:1, ARG
			;CALL SET_FETUS_STATUS, ARG:1, ARG
			;CALL SET_FATHERINFO, ARG:1, NO:ARG, -1, NAME:ARG
	;Ａ経験だけでは相手にペニスがあるか分からないのでそこもチェック
	ELSEIF TALENT:(ARG:1):오토코노코 == 1 && HAVE_PENIS(ARG)
		CFLAG:(ARG:1):고객의질내사정에의한임신판정 = TCVAR:(ARG:1):획득Ａ경험*2
		CALL PREGNANCY_CHECK, ARG:1, ARG
		;妊娠確定
		SIF RESULT
			CALL SET_PREGNANCY, ARG:1, ARG
			;CALL SET_FETUS_STATUS, ARG:1, ARG
			;CALL SET_FATHERINFO, ARG:1, NO:ARG, -1, NAME:ARG
	ENDIF
ENDIF

CALL SEXIAL_まとめ処理, ARG, ARG:1, 1,
LOCAL:1 = RESULT

CALL FIGHT_IT_OUT
RETURN LOCAL:1

