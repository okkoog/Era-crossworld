			IF BASE:(ARG:1):기력 - LOCAL < 0
				PRINTFORML {0,16,RIGHT}
				BASE:(ARG:1):기력 = 0
			;０にならない場合
			ELSE
				PRINTFORML {BASE:(ARG:1):기력 - LOCAL,16,RIGHT}
				BASE:(ARG:1):기력 -= LOCAL
			ENDIF
			;発情状態が治り、欲情値も0に
			CFLAG:(ARG:1):던전내발정 = 0
			CFLAG:(ARG:1):던전내발정용욕정치 = 0
		ENDIF
	ENDIF
ENDIF
;ＮＴＲハードモードの場合、一定の確率で『チ○ポには勝てなかったよ』になる
;初期値は５、CFLAG:(ARG:1):ダンジョン内発情用欲情値が３１００以上になると補正がかかるようになる
;３１００から１００ごとに１％づつ上がっていく（最大７０％）
;淫乱・娼婦は初期値に+１０、淫ＮＴＲは+２０される
;気力を５００消費する事で理性を保つ（チ○ポには勝つ）事が出来る
;チ○ポには勝てなかった場合はCFLAG:ダンジョン内発情用欲情値が１０００上昇して『魅了状態』になる
IF FLAG:ＮＴＲ하드모드
	LOCAL = 5
	SIF CFLAG:(ARG:1):던전내발정용욕정치 >= 3100
		LOCAL = (CFLAG:(ARG:1):던전내발정용욕정치 - 3000) / 100

	SIF TALENT:(ARG:1):ＮＴＲ == 2
		LOCAL += 20
	SIF TALENT:(ARG:1):음란 || TALENT:(ARG:1):창부
		LOCAL += 10
	IF RAND:100 < LOCAL && !(CFLAG:(ARG:1):상태이상 == GET_STATE_NUM("CHARM")) && !(CFLAG:(ARG:1):상태이상 == GET_STATE_NUM("PANIC"))
		PRINTFORMW %CALLNAME:(ARG:1)%의 신체를 견디기 힘든 쾌락이 지배한다…
		PRINTFORML 
		PRINTFORML ・
		PRINTFORML ・・
		PRINTFORML ・・・
		PRINTFORMW 
		;気力を５００消費して理性を保つ
		IF BASE:(ARG:1):기력 > 500
			PRINTFORMW %CALLNAME:(ARG:1)%은(는) 기력을 쥐어짜내, 이성을 유지했다
			BASE:(ARG:1):기력 -= 500
			;発情している場合はもう一度判定
			IF CFLAG:(ARG:1):던전내발정 == 1 && RAND:20
				PRINTFORMW ...는 듯 보였으나, 몸을 태우는 듯한 열락 앞에서는 이성 따위 사상누각에 불과했다…
				PRINTFORML 
				BASE:(ARG:1):기력 -= 250
			ELSE
				GOTO チ○ポに勝っちゃったよ
			ENDIF
		ELSE
			BASE:(ARG:1):기력 = 0
		ENDIF
		;勝てなかったよ…
		;相手がオトコ、こちらがオンナ
		IF TALENT:ARG:남자 && TALENT:(ARG:1):남자 == 0
			IF TALENT:(ARG:1):연모 || TALENT:(ARG:1):친애
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMW %CALLNAME:(ARG:1)%은(는) %CALLNAME:MASTER%의 앞이라는 사실도 잊은 채, %CALLNAME:ARG%의 격렬한 유린에 제정신을 잃고 헐떡이고 있다
					CASE 1
						PRINTFORMW %CALLNAME:(ARG:1)%은(는) %CALLNAME:MASTER%이(가) 보는 앞에서 %CALLNAME:ARG%의 능숙한 허리놀림에 굴복해, 되는 대로 범해지고 있다
					CASE 2
						PRINTFORMW %CALLNAME:(ARG:1)%은(는) %CALLNAME:ARG%의 다부진 페니스의 포로가 되어버려, 스스로 허리를 흔들며 『%CALLNAME:MASTER%보다 커』라며 신음하고 있다
					CASE 3
						PRINTFORMW %CALLNAME:(ARG:1)%은(는) %CALLNAME:ARG%이(가) 뿜어낸 농밀한 정액 냄새에 몸의 쑤심을 억누르지 못하고
						PRINTFORMW %CALLNAME:MASTER%의 앞이라는 사실을 잊은 채, 풀린 얼굴로 %CALLNAME:ARG%의 페니스를 계속 빨고 있다
					CASEELSE
						PRINTFORMW %CALLNAME:(ARG:1)%은(는) %CALLNAME:ARG%에게 농후한 씨앗을 주입당할 때마다 눈동자의 색이 쾌락으로 탁해지며
						PRINTFORMW %CALLNAME:MASTER%이(가) 보고 있는 것도 아랑곳하지 않고 『더 임신시켜 주세요』라며 간청하고 있다
				ENDSELECT
			ELSE
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMW %CALLNAME:(ARG:1)%은(는) %CALLNAME:ARG%의 격렬한 유린에 제정신을 잃고 헐떡이고 있다
					CASE 1
						PRINTFORMW %CALLNAME:(ARG:1)%은(는) %CALLNAME:ARG%의 능숙한 허리놀림에 굴복해, 되는 대로 범해지고 있다
					CASE 2
						PRINTFORMW %CALLNAME:(ARG:1)%은(는) %CALLNAME:ARG%의 다부진 페니스의 포로가 되어 있다
					CASE 3
						PRINTFORMW %CALLNAME:(ARG:1)%은(는) %CALLNAME:ARG%이(가) 뿜어낸 농밀한 정액 냄새에 몸의 쑤심을 억누를 수 없다
					CASEELSE
						PRINTFORMW %CALLNAME:(ARG:1)%은(는) %CALLNAME:ARG%에게 농후한 씨앗을 주입당할 때마다 눈동자의 색이 쾌락으로 탁해져 간다
				ENDSELECT
			ENDIF
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW %CALLNAME:(ARG:1)%은(는) %CALLNAME:ARG%의 격렬한 유린에 제정신을 잃고 헐떡이고 있다
				CASEELSE
					PRINTFORMW %CALLNAME:(ARG:1)%은(는) %CALLNAME:ARG%의 능숙한 허리놀림에 굴복해, 되는 대로 범해지고 있다
			ENDSELECT
		ENDIF
		;ダンジョン内発情用欲情値１０００上昇
		CFLAG:(ARG:1):던전내발정용욕정치 += 1000
		PRINTFORML 
		;女は魅了、男は睡眠
		;DYINGの場合は入らない
		IF !(CFLAG:(ARG:1):상태이상 == GET_STATE_NUM("CHARM")) && TALENT:(ARG:1):남자 == 0 && BASE:(ARG:1):ＨＰ > 0
			PRINTFORMW %CALLNAME:(ARG:1)%은(는) 격렬한 능욕에 마음이 꺾여버렸다
			CFLAG:(ARG:1):상태이상 = GET_STATE_NUM("CHARM")
		ELSEIF !(CFLAG:(ARG:1):상태이상 == GET_STATE_NUM("SLEEP")) && BASE:(ARG:1):ＨＰ > 0
			PRINTFORMW %CALLNAME:(ARG:1)%은(는) 격렬한 능욕에 지쳐 쓰러져, 의식을 잃었다
			CFLAG:(ARG:1):상태이상 = GET_STATE_NUM("SLEEP")
		ENDIF
	ENDIF
ENDIF
$チ○ポに勝っちゃったよ

;相手側悪魔に適応
FOR LOCAL,0,100
	EXP:ARG:LOCAL = TCVAR:ARG:LOCAL
	TCVAR:ARG:LOCAL = 0
NEXT


;成功度判定
;満足度判定
;ランダムで40を追加します。売春経験に応じて期待値は上昇します。
;総陥落人数で百人切りを達成した場合は最高値
;IF EXP:(ARG:1):매춘경험 > 30000
IF EXP:(ARG:1):매춘경험 > 30000 || ARG:1 == MASTER && (FLAG:연모인수 + FLAG:음란인수 + FLAG:복종인수) >= 100
	LOCAL:3 = 60
ELSEIF EXP:(ARG:1):매춘경험 > 10000
	LOCAL:3 = RAND:31 + 30
ELSEIF EXP:(ARG:1):매춘경험 > 5000
	LOCAL:3 = RAND:36 + 25
ELSEIF EXP:(ARG:1):매춘경험 > 3000
	LOCAL:3 = RAND:41 + 20
ELSEIF EXP:(ARG:1):매춘경험 > 1000
	LOCAL:3 = RAND:46 + 15
ELSEIF EXP:(ARG:1):매춘경험 > 500
	LOCAL:3 = RAND:51 + 10
ELSEIF EXP:(ARG:1):매춘경험 > 100
	LOCAL:3 = RAND:56 + 5
ELSE
	LOCAL:3 = RAND:61
ENDIF

;欲望をチェックする。欲望が相手の欲望を上回るかどうか。成功なら欲望レベルの２倍、失敗なら１倍入ります。
;CBVA売春では、相手の欲望の最大値が4です。
IF ABL:ARG:욕망 <= ABL:(ARG:1):욕망
	LOCAL:3 += ABL:(ARG:1):욕망
	LOCAL:3 += ABL:(ARG:1):욕망
ELSE
	LOCAL:3 += ABL:(ARG:1):욕망
ENDIF

;相手からの行動が発生します。相手の技巧がこちらの欲望以下の場合、不満そうな表情が出る可能性があります。
;相手の技巧＋こちらの従順の２倍＞こちらの欲望＋２なら、露出癖と奉仕精神を満足度に加える事が出来ます。
;足りない場合は加えられません。
LOCAL:4 = ABL:ARG:기교 + ABL:(ARG:1):순종 + ABL:(ARG:1):순종 - 2

IF LOCAL:4 >= ABL:(ARG:1):욕망
	LOCAL:3 += ABL:(ARG:1):봉사정신
	LOCAL:3 += ABL:(ARG:1):노출증
ENDIF

;おてぃんぽ満足度
SIF TALENT:(ARG:1):절륜
	LOCAL:3 += 10
SIF TALENT:(ARG:1):크고아름다움 && (TALENT:(ARG:1):남자 || TALENT:(ARG:1):후타나리)
	LOCAL:3 += 30

;ここまでで最大120％
SIF LOCAL:3 > 120
	LOCAL:3 = 120
;従順が3LVないと、著しく微妙になります
IF ABL:(ARG:1):순종 < 3 && ARG:1 != MASTER
	LOCAL:3 /= 2
ENDIF
;大業物持ちの場合10％の確立で『勝てなかったよ…』になる
IF !TALENT:ARG:남자 && TALENT:(ARG:1):크고아름다움 && RAND:100 < 10 && (TALENT:(ARG:1):남자 || TALENT:(ARG:1):후타나리)
	SETCOLOR 0x404040
	PRINTFORMW %CALLNAME:(ARG:1)%의 대물이 %CALLNAME:ARG%의 약점을 맹공격한다！
	RESETCOLOR
	LOCAL:3 = 200
ENDIF
;結果表示
PRINTFORML 만족도:{LOCAL:3}％
FLAG:악마만족도 = LOCAL:3
;魅了or倒れてしまうとMAGを大量に奪われる
IF CFLAG:(ARG:1):상태이상 == GET_STATE_NUM("DYING") || CFLAG:(ARG:1):상태이상 == GET_STATE_NUM("CHARM")
	PRINTFORML ＭＡＧ를 빼앗겼다！
	CALL CONTROL_MAG,ARG:1,-1000*MAXBASE:ARG:LV
	IF CFLAG:(ARG:1):상태이상 == GET_STATE_NUM("CHARM") && !(CFLAG:(ARG:1):상태이상 == GET_STATE_NUM("DYING"))
		PRINTFORMW %CALLNAME:(ARG:1)%은(는) 멍한 눈으로 밀회의 여운에 젖어 있다
	ELSE
		IF RAND:2 == 0
			PRINTFORMW 백탁에 뒤덮인 %CALLNAME:(ARG:1)%은(는) 인형처럼 누워 있다…
		ELSE
			PRINTFORMW 철저히 유린당한 %CALLNAME:(ARG:1)%의 공허한 눈동자는 그저 허공만을 응시하고 있다…
		ENDIF
	ENDIF
	;ＮＴＲペナルティありの場合、倒れてしまうと好感度が10%下がり、淫乱度が上がる
	;淫ＮＴＲで無い場合、ＮＴＲ判定を行う
	IF FLAG:ＮＴＲ하드모드
		LOCAL = 0
		$KOUKANDOGENSYOU_LOOP
		IF !CFLAG:(ARG:1):(2098 - LOCAL) == 0
			SIF CFLAG:(ARG:1):(2098 - LOCAL) < 0
				CFLAG:(ARG:1):(2098 - LOCAL) += (CFLAG:(ARG:1):(2098 - LOCAL) * (-1)) / 10
			SIF CFLAG:(ARG:1):(2098 - LOCAL) > 0
				CFLAG:(ARG:1):(2098 - LOCAL) -= CFLAG:(ARG:1):(2098 - LOCAL) / 10
		ENDIF
		LOCAL += 1
		SIF LOCAL < 13
			GOTO KOUKANDOGENSYOU_LOOP
		;浮気癖がある場合は淫乱度倍化
		IF TALENT:(ARG:1):바람기
			CFLAG:(ARG:1):음란도 += (MAXBASE:ARG:LV * (CFLAG:(ARG:1):본방횟수 + CFLAG:(ARG:1):애널횟수))*2
		ELSE
			CFLAG:(ARG:1):음란도 += MAXBASE:ARG:LV * (CFLAG:(ARG:1):본방횟수 + CFLAG:(ARG:1):애널횟수)
		ENDIF
		IF !(TALENT:(ARG:1):ＮＴＲ == 2) && ARG:1 != MASTER
			CFLAG:(ARG:1):음ＮＴＲ진행도 = 2
			MARK:(ARG:1):쾌락각인 = 3
			CALL NTR_CHECK , (ARG:1) , 1
		ENDIF
	ENDIF
ENDIF
CALL SOURCE_CHECK_DUNGEON , ARG:1, ARG
CALL SHOW_ADD_EXP, ARG:1

RETURN LOCAL:3

