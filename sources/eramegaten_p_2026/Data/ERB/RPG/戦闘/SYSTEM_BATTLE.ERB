;敵キャラクターの消滅
;=======================================
@DELENEMY
SIF FLAG:디버그전투플래그
	RETURN 0
FOR LOCAL,CHARANUM,0,-1
	IF CFLAG:(LOCAL-1):PT플래그 == 0
		SIF CFLAG:(LOCAL-1):포지션 > 0
			CALL REMOVE_POSITION,CFLAG:(LOCAL-1):포지션
		DELCHARA (LOCAL-1)
	ENDIF
NEXT
