;==============================
;忠誠度操作
;==============================
@CONTROL_LOYALTY,L_CHARA, L_AMOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_AMOUNT
IF CFLAG:L_CHARA:충성도링크 > 0
	L_CHARA = FINDCHARA_TIMEID(CFLAG:L_CHARA:피링크캐릭터실제가입시간)
	SIF L_CHARA < 0
		RETURN 0
ENDIF
BASE:L_CHARA:충성도 += L_AMOUNT

;===============================
;MAG吸収
;==============================
@DRAIN_MAG, L_PLAYER, L_AMOUNT, L_TARGET
#DIM DYNAMIC L_PLAYER
#DIM DYNAMIC L_AMOUNT
#DIM DYNAMIC L_TARGET
L_AMOUNT *= 2

IF TEQUIP:TARGET:촉수 && FLAG:촉수신사각성
	IF L_TARGET == TARGET
		L_AMOUNT = MIN(ABS(L_AMOUNT), BASE:L_TARGET:ＭＡＧ)
		IF L_AMOUNT > 0
			CALL CONTROL_MAG, L_TARGET, -L_AMOUNT

			AMOUNT_DRAIN_TENTACLE = L_AMOUNT * (10 + ABL:L_TARGET:촉수중독 * 9) / 100
			FLAG:촉수에너지 += AMOUNT_DRAIN_TENTACLE
			RETURN L_AMOUNT
		ELSE
			RETURN 0
		ENDIF
	ELSE
		RETURN 0
	ENDIF
ELSE
	IF TALENT:L_TARGET:영매체질
		L_AMOUNT *= 5
		SIF !TALENT:L_TARGET:비전투원
			L_AMOUNT /= 2
	ENDIF
	L_AMOUNT = MIN(L_AMOUNT, GET_CHARA_STOCK_MAG(L_PLAYER))
	IF GET_CHARA_MAXMAG(L_TARGET) == GET_CHARA_STOCK_MAG(L_TARGET)
		;相手のMAGが満タンの場合は経験値になる（割五鈷杵彫りの指輪装備時のみ）
		;1EXP = 10MAG、一回の最高値は次のレベルに必要な総経験地の20％
		;『あなた』のレベルの半分までしか上げられない
		IF GROUPMATCH([[衣装:금강저의반지]], CFLAG:L_PLAYER:그외, CFLAG:L_PLAYER:그외2, CFLAG:L_PLAYER:그외3) && BASE:MASTER:LV / 2 > BASE:L_TARGET:LV
			L_AMOUNT = LIMIT(L_AMOUNT / 10 , 0 , MAXBASE:L_TARGET:ＥＸＰ / 5)
			BASE:L_TARGET:ＥＸＰ += L_AMOUNT
			CALL CONTROL_MAG, L_PLAYER, -L_AMOUNT
			RETURN L_AMOUNT
		ELSE
			RETURN 0
		ENDIF
	ELSE
		L_AMOUNT = MIN(L_AMOUNT, GET_CHARA_MAXMAG(L_TARGET) - GET_CHARA_STOCK_MAG(L_TARGET))
		CALL CONTROL_MAG, L_TARGET, L_AMOUNT
		CALL CONTROL_MAG, L_PLAYER, -L_AMOUNT
		RETURN L_AMOUNT
	ENDIF
ENDIF

;---- EDIT 080 ADD START -------------------------COOPに解析用フラグを追加
;====================================================
;DEVIL_COOP
;使用されたスキル攻撃力・魔法威力+αの基礎威力と平均攻撃力と平均レベルを利用して基本計算式を通したあと、各種補正をかける
;イメージとしてはCOOPのトリガーになったスキルの威力の万能攻撃を味方全員で実行する感じになる
;
;基礎威力		通常スキルのスキル威力に相当
;50 + 参加者の平均LV /2 + 敵が受けたスキル威力の合計値 * COOP倍率(Crt50% / WEAK 100%)
;攻撃力			参加者の攻撃値(攻撃力/魔力の高い方)の平均値
;COOP위력		相性などによる参加者の倍率値、ダメージに乗算
;50% + 各参加者の属性一致率(60% / 110%) * 추격의심득(150%) * 相性・関係補正(50% ~ 150%)
;====================================================
@DEVIL_COOP,ARG
#DIM LCOUNT,2
#DIM L_CHARA
#DIM L_COOP_MEMBER
#DIM CNT_COOP_MEMBER
#DIM L_TARGET
#DIM IS_EXIST_COOP_TARGET
#DIM COOP_DMG
#DIM COOP_POWER
#DIM TEMP_POWER
#DIM TEMP_RELATION
#DIM COOP_MEMBER_ATTACK_AVERAGE
#DIM COOP_MEMBER_LV_AVERAGE
#DIM L_POS_MIN
#DIM L_POS_MAX
#LOCALSIZE 11
#DIM 解析用
;COOPできないキャラ
SIF CFLAG:ARG:COOP불능
	RETURN 0
;COOPを行う必要があるかの判定
;LOCAL:5 = 受ける人数
IS_EXIST_COOP_TARGET = 0

IF CFLAG:ARG:PT플래그
	L_POS_MIN = 7
	L_POS_MAX = 17
ELSE
	L_POS_MIN = 1
	L_POS_MAX = 7
ENDIF
FOR LCOUNT, L_POS_MIN, L_POS_MAX 
	SIF !IS_TARGET_ABLE(POS(LCOUNT))
		CONTINUE
	SIF CFLAG:POS(LCOUNT):ＣＯＯＰ플래그 <= 0
		CONTINUE
	IS_EXIST_COOP_TARGET = 1
NEXT
;COOPを受ける敵がいないなら終わる
SIF !IS_EXIST_COOP_TARGET
	RETURN 0

;FOR LOCAL,L_POS_MIN,L_POS_MAX
;	LOCALS = 포지션{LOCAL}
;	SIF FLAG:LOCALS > -1 && GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) != "DYING" && CFLAG:(FLAG:LOCALS):ＣＯＯＰ플래그
;		CNT_TARGET += 1
;NEXT

;SIF CNT_TARGET == 0
;	RETURN 0


;ARG = 発動させたキャラ
CNT_COOP_MEMBER = 0
;CNT_COOP_MEMBER = 参加人数
;LOCAL:3 = COOP위력
COOP_POWER = 50
;COOP_MEMBER_ATTACK_AVERAGE = COOP攻撃力
COOP_MEMBER_ATTACK_AVERAGE = 0
COOP_MEMBER_LV_AVERAGE = 0
;COOP_MEMBER_LV_AVERAGE = 攻撃側の平均ＬＶ
;LOCAL:6 = ダメージ値
;参加人数を割り出す
IF CFLAG:ARG:PT플래그 == 0
	L_POS_MIN = 7
	L_POS_MAX = 17
ELSE
	L_POS_MIN = 1
	L_POS_MAX = 7
ENDIF
;------------------------------------
;威力計算に用いる数値の取得
;------------------------------------
FOR LOCAL,L_POS_MIN,L_POS_MAX
	LOCALS = 포지션{LOCAL}
	IF FLAG:LOCALS > -1
		CALL COOPABLE_CHARA,FLAG:LOCALS
		SIF RESULT == 0
			CONTINUE
		;COOP発動者の攻撃力加算
		;IF FLAG:LOCALS == ARG && CFLAG:ARG:보스플래그 == 0
			;CNT_COOP_MEMBER += 1
			;COOP_MEMBER_ATTACK_AVERAGE += MAX(MAXBASE:(FLAG:LOCALS):공격 , MAXBASE:(FLAG:LOCALS):마법위력)
			;COOP_MEMBER_LV_AVERAGE += MAXBASE:(FLAG:LOCALS):LV
			;CFLAG:(FLAG:LOCALS):ＣＯＯＰ참가플래그 = 1
			;CONTINUE
		;ENDIF
		;LOCAL:9 = 個別のCOOP威力加算値
		;基本COOP加算 110%
		;IF (ABL:(FLAG:LOCALS):속성LD == ABL:ARG:속성LD && ABL:(FLAG:LOCALS):속성LC == ABL:ARG:속성LC) || (SOFT_ON("ＣＯ－ＯＰ강화C") && CAPITULATION_CHECK(FLAG:LOCALS, ARG)) || 特殊友情確認(ARG,FLAG:LOCALS);052
		;	;ペルソナEXPの加算
		;	CALL INCREASE_PERSONA_EXP, FLAG:LOCALS, 1, 30
		;	LOCAL:2 += 1
		;	LOCAL:9 = 110
		;	IF FLAG:LOCALS == ARG && CFLAG:ARG:보스플래그
		;		LOCAL:2 += 1
		;		LOCAL:9 += 40
		;	ENDIF
		;	LOCAL:4 += MAX(MAXBASE:(FLAG:LOCALS):공격 , MAXBASE:(FLAG:LOCALS):마법위력)
		;	LOCAL:5 += MAXBASE:(FLAG:LOCALS):LV
		;	CFLAG:(FLAG:LOCALS):ＣＯＯＰ참가플래그 = 1
		;基本COOP威力加算 60%
		;ELSEIF ABL:(FLAG:LOCALS):속성LD == ABL:ARG:속성LD || ABL:(FLAG:LOCALS):속성LC == ABL:ARG:속성LC
		;	;ペルソナEXPの加算
		;	CALL INCREASE_PERSONA_EXP, FLAG:LOCALS, 1, 30
		;	LOCAL:9 = 60
		;	SIF SOFT_ON("ＣＯ－ＯＰ강화W")
		;		LOCAL:9 += 50
		;	LOCAL:2 += 1
		;	LOCAL:4 += MAX(MAXBASE:(FLAG:LOCALS):공격 , MAXBASE:(FLAG:LOCALS):마법위력)
		;	LOCAL:5 += MAXBASE:(FLAG:LOCALS):LV
		;	CFLAG:(FLAG:LOCALS):ＣＯＯＰ참가플래그 = 1
		;基本COOP威力加算 60%
		;ELSEIF SOFT_ON("ＣＯ－ＯＰ강화C") && CAPITULATION_CHECK(FLAG:LOCALS, ARG);052
		;	;ペルソナEXPの加算
		;	CALL INCREASE_PERSONA_EXP, FLAG:LOCALS, 1, 30
		;	LOCAL:9 = 60
		;	LOCAL:2 += 1
		;	LOCAL:4 += MAX(MAXBASE:(FLAG:LOCALS):공격 , MAXBASE:(FLAG:LOCALS):마법위력)
		;	LOCAL:5 += MAXBASE:(FLAG:LOCALS):LV
		;	CFLAG:(FLAG:LOCALS):ＣＯＯＰ참가플래그 = 1
		;ELSE
		;	CONTINUE
		;ENDIF
		;発動者は威力0
		IF FLAG:LOCALS == ARG
			TEMP_POWER = 0
		ELSE
			;ランク2 = ALI2種一致、1 = ALT一種一致
			SELECTCASE GET_DEVIL_COOP_MEMBER_RANK(ARG, FLAG:LOCALS)
				CASE 2
					TEMP_POWER = 110
				CASE 1
					TEMP_POWER = 60
				CASEELSE
					CONTINUE
			ENDSELECT
			;追撃の心得持ちは威力が1.5倍
			SIF HAVE_SKILL(FLAG:LOCALS,[[스킬:추격의심득]])
				TIMES TEMP_POWER, 1.50
			
			;ALI補正を抜いた相性と陥落によって1%～150%の補正が発生する
			TEMP_RELATION = GET_RELATION(FLAG:LOCALS, ARG , 0)
			IF 陥落(FLAG:LOCALS, ARG) == 1
				TEMP_RELATION += 10
			ELSE
				TEMP_RELATION += 陥落(FLAG:LOCALS, ARG) * 25
			ENDIF
			TEMP_RELATION = LIMIT(TEMP_RELATION, 1, 200)
			TEMP_RELATION = TEMP_RELATION > 100 ? (TEMP_RELATION - 100) / 2 + 100 # TEMP_RELATION
			TEMP_POWER = TEMP_POWER * TEMP_RELATION / 100
		ENDIF
		;合計COOP威力に個別COOP威力を加算
		COOP_POWER += TEMP_POWER
		CNT_COOP_MEMBER += 1
		COOP_MEMBER_ATTACK_AVERAGE += MAX(MAXBASE:(FLAG:LOCALS):공격 , MAXBASE:(FLAG:LOCALS):마법위력)
		COOP_MEMBER_LV_AVERAGE += MAXBASE:(FLAG:LOCALS):LV
		CFLAG:(FLAG:LOCALS):ＣＯＯＰ참가플래그 = 1
	ENDIF
