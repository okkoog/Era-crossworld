;RESULT:-	成否
;RESULT:1 = 失敗した場合のすでに生成されているキャラの登録番号
@CAN_ADD_NEW_COMPANION, L_CSVNO, L_ADD_EVENT, L_SHOW_MODE
#FUNCTION
#DIM DYNAMIC L_CSVNO
#DIM DYNAMIC L_ADD_EVENT
#DIM DYNAMIC L_SHOW_MODE
;キャラが生成されていない
SIF GETCHARA(L_CSVNO) < 0
	RETURNF 1
;合体の結果表示等で制限を無視する場合
SIF L_SHOW_MODE
	RETURNF 1
;イベントフラグのチェック
SIF L_ADD_EVENT > 0 && FINDCHARA_B(L_CSVNO, L_ADD_EVENT) >= 0
	RETURNF 0
RESULT:1 = GETCHARA(L_CSVNO)
;人間の場合
IF GROUPMATCH(GET_RACE(CSVABL(L_CSVNO,GETNUM(ABL,"종족"),0)), "인간", "반마인", "악마인", "조마")
	;複数生成可能でない場合はここで終わり
	SIF !CSVCFLAG(L_CSVNO,GETNUM(CFLAG,"복수생성가능"),0)
		RETURNF 0
ENDIF
;一体のみフラグ
SIF CSVCFLAG(L_CSVNO,GETNUM(CFLAG,"１체만"),0)
	RETURNF 0
RETURNF 1

