	RETURNF 0
SIF L_EVENTFLAG >= 0 && CFLAG:L_CHARA:이벤트가입 != L_EVENTFLAG
	RETURNF 0
SIF !IS_JOINABLE_BATTLE(L_CHARA, 1)
	RETURNF 0
RETURNF 1

;======================================================================
;敵パーティーの攻撃相性登録
;警告表示・ギボアイズ用に敵パーティー全体の所持相性を登録する
;======================================================================
;---- EDIT 099 ADD START -------------------------
@SET_ENEMY_HAVE_SKILL_ATK_TYPE
#DIM L_TYPE
#DIM LCOUNT
#DIM L_ENEMY
VARSET ENEMY_HAVE_SKILL_ATK_TYPE
FOR L_TYPE, 0, TYPENUM
	;所持情報が完全に確定していたら
	SIF ENEMY_HAVE_SKILL_ATK_TYPE:L_TYPE == 2
		BREAK
	FOR LCOUNT, 7, 17
		L_ENEMY = POS(LCOUNT)
		SIF !IS_TARGET_ABLE(L_ENEMY)
			CONTINUE
		SIF !C_HAVE_SKILL_ATK_TYPE:L_ENEMY:L_TYPE
			CONTINUE
		;所持している場合は1 = ギボ・アイズの警告対象
		ENEMY_HAVE_SKILL_ATK_TYPE:L_TYPE = 1
		SIF !CAN_SHOW_ENEMY_TYPE(L_ENEMY)
			CONTINUE
		SIF CFLAG:L_ENEMY:보스플래그
			CONTINUE
		;さらに敵ステータスを閲覧できる状態 = 公開情報
		ENEMY_HAVE_SKILL_ATK_TYPE:L_TYPE = 2
	NEXT
NEXT
;---- EDIT 099 ADD END ---------------------------

@GET_LINKED_HP_CHARA, L_CHARA
#DIM DYNAMIC L_CHARA
VARSET RESULT, -1, 0, 10
IF CFLAG:L_CHARA:PT플래그 > 0
	TRYCCALLFORM LINKED_HP_CHARA_{NO:L_CHARA}, L_CHARA
		RETURN RESULT
	CATCH
	ENDCATCH
ENDIF
TRYCCALLFORM LINKED_HP_ROLE_%CSTR:L_CHARA:롤%, L_CHARA
	RETURN RESULT
CATCH
ENDCATCH
TRYCCALLFORM LINKED_HP_%CSTR:L_CHARA:특수적보정패턴%, L_CHARA
	RETURN RESULT
CATCH
ENDCATCH
RETURN -1