;====================================================
;戦闘参加者のリスト作成
;戦闘開始時に全てのメンバーを登録する
;リターンでCOMP内に戻った味方や死亡で場から外れた敵を総当りで探したいときの負担軽減用です
;====================================================
@INIT_BCHARA_LIST
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC LINK_CHARA
VARSET BCHARA, -1
BCHARANUM = 0
CVARSET IS_JOINED_BCHARA:0:0

FOR L_CHARA, 0, CHARANUM
	SIF !IS_JOINABLE_BATTLE(L_CHARA)
		CONTINUE
	SIF FINDELEMENT(BCHARA, L_CHARA) >= 0
		CONTINUE
	BCHARA:BCHARANUM = L_CHARA
	IS_JOINED_BCHARA:L_CHARA:0 = 1
	BCHARANUM++
	FOR LCOUNT, 0, LINKCHARANUM
		LINK_CHARA = FINDCHARA_LINK(L_CHARA, LCOUNT)
		SIF LINK_CHARA < 0
			CONTINUE
		SIF IS_JOINED_BCHARA:LINK_CHARA:0
			CONTINUE
		BCHARA:BCHARANUM = LINK_CHARA
		IS_JOINED_BCHARA:LINK_CHARA:0 = 1
		BCHARANUM++
	NEXT
NEXT

