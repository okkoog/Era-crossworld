;=======================================================
;スキル実行時の基本的な動作
;=======================================================
@VAR_HP, L_T, L_VAR, CALC_TYPE = "自動振り分け", L_P = -1, L_SKIP_MESSAGE
#DIM DYNAMIC LCOUNT,2
#DIM DYNAMIC L_P
#DIM DYNAMIC L_T
#DIM DYNAMIC L_FRIEND
#DIM DYNAMIC L_VAR
#DIM DYNAMIC STOCK_HP
#DIM DYNAMIC L_SKIP_MESSAGE
#DIMS DYNAMIC CALC_TYPE
#DIMS DYNAMIC TEMP_SKILL
#DIM DYNAMIC L_STOCK
#DIM DYNAMIC L_COST_CHARA, MAX_PLAYER_CHARA
#DIM DYNAMIC STOCK_CLENCHING_HEAL
#DIMS DYNAMIC STOCK_CLENCHING_MESSAGE
;死人は増減しない
SIF GET_STATE(CFLAG:L_T:상태이상) == "DYING"
	RETURN 0
SIF TFLAG:HP고정
	RETURN 0
STOCK_HP = BASE:L_T:ＨＰ
IF CALC_TYPE == "自動振り分け"
	IF L_VAR >= 0
		CALC_TYPE = 회복
	ELSE
		CALC_TYPE = ダメージ
	ENDIF
ENDIF
;회복
IF CALC_TYPE == "회복" ||  CALC_TYPE == "超過回復"
	;---- EDIT 097 ADD START -------------------------
	SIF L_VAR < 0
		THROW 回復量がマイナスになってしまっています！
	;---- EDIT 097 ADD END ---------------------------
	;死亡予約型食いしばりは回復を停止する
	SIF CFLAG:L_T:사망예약형이악물기
		RETURN 0
	SIF AUTO_PU_SKILL_ラグナロク（ＡＮ）(L_T,"回復阻害") > 0
		L_VAR /= 10
	BASE:L_T:ＨＰ += L_VAR
	;---- EDIT 101 MOD START -------------------------
	;---- EDIT 100 MOD START -------------------------
	SIF CALC_TYPE == "회복"
		BASE:L_T:ＨＰ = MIN(BASE:L_T:ＨＰ, MAX(STOCK_HP, MAXBASE:L_T:ＨＰ))
	;	BASE:L_T:ＨＰ = MIN(BASE:L_T:ＨＰ, MAXBASE:L_T:ＨＰ)
	;---- EDIT 100 MOD END ---------------------------
	;---- EDIT 101 MOD END ---------------------------
	;HPがリンクしていた場合連動処理
	VARSET LINKED_DAMAGE_TO_POS
	CALL GET_LINKED_HP_CHARA, L_T
	FOR LCOUNT, 0, 10
		SIF RESULT:LCOUNT < 0
			CONTINUE
		SIF L_T == RESULT:LCOUNT
			CONTINUE
		SIF CPOS(RESULT:LCOUNT) > 0
			LINKED_DAMAGE_TO_POS:CPOS(RESULT:LCOUNT) = BASE:(RESULT:LCOUNT):ＨＰ - BASE:L_T:ＨＰ
		BASE:(RESULT:LCOUNT):ＨＰ = BASE:L_T:ＨＰ
	NEXT
	RETURN BASE:L_T:ＨＰ - STOCK_HP
;ダメージ
ELSEIF CALC_TYPE == "ダメージ" || CALC_TYPE == "食いしばり無効ダメージ"
	;---- EDIT 097 ADD START -------------------------
	SIF L_VAR > 0
		THROW ダメージ量がプラスになってしまっています！
	;---- EDIT 097 ADD END ---------------------------
	;ダメージ処理
	BASE:L_T:ＨＰ += L_VAR
	;---- EDIT 096 MOD START -------------------------
	;食いしばり等の判定
	IF BASE:L_T:ＨＰ <= 0
		;不死身フラグを判定
		;3 = 無限に不屈の闘志　2 = 無限に食いしばり　1 = メッセージ無しでHP1で耐える
		IF CFLAG:L_T:불사신플래그
			IF CFLAG:L_T:불사신플래그 == 3
				SIF L_SKIP_MESSAGE != 2
					TSTR:스킬메시지추가 = %CALLNAME:L_T%は立ち上がった！
				BASE:L_T:ＨＰ = MAXBASE:L_T:ＨＰ
			ELSEIF CFLAG:L_T:불사신플래그 == 2
				SIF L_SKIP_MESSAGE != 2
					TSTR:스킬메시지추가 = %CALLNAME:L_T%は食いしばった！
				BASE:L_T:ＨＰ = 1
			ELSE
				BASE:L_T:ＨＰ = 1
			ENDIF
			CFLAG:L_T:이악물기플래그 = 1
	;---- EDIT 096 MOD END ---------------------------
		ELSE
			;通常のダメージ場合、所持スキルを優先度の高い順に判定していく
			IF CALC_TYPE == "ダメージ"
				IF HAVE_PU_SKILL(L_T,"劫火の余燼")
					IF !CFLAG:L_T:이악물기플래그
						BASE:L_T:ＨＰ = 1
						IF !CFLAG:L_T:사망예약형이악물기 && !IS_BADSTATE(L_T, "STONE")
							CFLAG:L_T:상태이상 = 0
							SIF L_SKIP_MESSAGE != 2
								TSTR:스킬메시지추가 = %CALLNAME:L_T%は自身の余燼を燃やし、身体を奮い立たせた！
							;食いしばりフラグは死亡したときにつける。１は発動ターンの終了時に死ぬことになるので注意
							CFLAG:L_T:사망예약형이악물기 = 1 + 1 + (CSTR:L_T:104 != "")
							CSTR:L_T:강제사망시메시지 = %CALLNAME:L_T%を奮い立たせる余燼が燃え尽きた・・・
						ELSE
							SIF L_SKIP_MESSAGE != 2
								TSTR:스킬메시지추가 = %CALLNAME:L_T%の燃える余燼が、身体を奮い立たせる！
						ENDIF
					ENDIF
				ELSEIF HAVE_PU_SKILL(L_T,"精霊たちの守り") && !IS_BADSTATE(L_T, "STONE")
					IF !CFLAG:L_T:이악물기플래그
						BASE:L_T:ＨＰ = 1
						IF !CFLAG:L_T:사망예약형이악물기
							CFLAG:L_T:상태이상 = 0
							SIF L_SKIP_MESSAGE != 2
								TSTR:스킬메시지추가 = 精霊の加護が%CALLNAME:L_T%を奮い立たせる！
							;食いしばりフラグは死亡したときにつける。
							CFLAG:L_T:사망예약형이악물기 = 1 + 1
							CSTR:L_T:강제사망시메시지 = 精霊の加護が切れて、%CALLNAME:L_T%は力尽きた…
						ELSE
							SIF L_SKIP_MESSAGE != 2
								TSTR:스킬메시지추가 = 精霊の加護が%CALLNAME:L_T%を奮い立たせる！
						ENDIF
					ENDIF
				ELSEIF HAVE_SKILL(L_T, [[스킬:SONG OF DIVA]])
					;このタイミングで戦闘メッセージが挟まれるのは問題があるので、メイン部分をカウンター処理に移動
					;既にモード・アウェイクニングになってたらダメ（そんなことないと起きないと思うけど）
					IF !CFLAG:L_T:이악물기플래그 && HAVE_SKILL(L_T, [[스킬:SONG OF DIVA]]) && SKILLGAGE_H_GET(L_T, [[스킬:SONG OF DIVA]]) == 0
						BASE:L_T:ＨＰ = MAXBASE:L_T:ＨＰ
						CFLAG:L_T:이악물기플래그 = 1
						;攻撃終了後にモードチェンジをするのでそれまで攻撃対象から外しておく
						CFLAG:L_T:공격대상제외_ACT = 1
						CALL SKILLGAGE_H_SET, L_T, [[스킬:SONG OF DIVA]], 1
					ENDIF
				ELSEIF HAVE_SKILL(L_T, [[스킬:네버기브업]])
					IF !CFLAG:L_T:이악물기플래그
						;デビルトリガーを持っている場合は攻撃終了後にデビルトリガー判定をするのでそれまで攻撃対象から外しておく
						SIF HAVE_SKILL(L_T, [[스킬:데빌트리거]])
							CFLAG:L_T:공격대상제외_ACT = 1
						BASE:L_T:ＨＰ = MAXBASE:L_T:ＨＰ
						SIF L_SKIP_MESSAGE != 2
							TSTR:스킬메시지추가 = %CALLNAME:L_T%はまだまだやる気だ！
						CFLAG:L_T:이악물기플래그 = 1
					ENDIF
				ELSEIF HAVE_SKILL(L_T, (PU_SKILLNUM_GET(L_T,"四枝の浅瀬")))
					IF CFLAG:L_T:이악물기플래그 < 3
						BASE:L_T:ＨＰ = 1
						SIF L_SKIP_MESSAGE != 2
							TSTR:스킬메시지추가 = %CALLNAME:L_T%はまだまだやる気だ！
						CFLAG:L_T:이악물기플래그 += 1
					ENDIF
				ELSEIF (L_T == MASTER && SOFT_ON("바・벨") && FLAG:벨신격파 & 8)
					IF !CFLAG:L_T:이악물기플래그
						BASE:L_T:ＨＰ = MAXBASE:L_T:ＨＰ
						SIF L_SKIP_MESSAGE != 2
							TSTR:스킬메시지추가 = %CALLNAME:L_T%は立ち上がった！
						CFLAG:L_T:이악물기플래그 = 1
					ENDIF
				ELSEIF IS_ACTIVE_C_BTL_EFFECT_PERMANENCE("我慢のフホホイ", L_T)
					BASE:L_T:ＨＰ = 1
					SIF L_SKIP_MESSAGE != 2
						TSTR:스킬메시지추가 = %CALLNAME:L_T%は我慢して食いしばった！
					CALL CLEAR_C_BTL_EFFECT_PERMANENCE, "我慢のフホホイ", L_T
				ELSEIF HAVE_AW_SKILL(L_T, "生贄交代")
					IF RAND:2
						FOR L_STOCK, 0, BCHARANUM
							SIF CPOS(BCHARA:L_STOCK) > 0
								CONTINUE
							SIF !IS_COMP内効果有効(BCHARA:L_STOCK)
								CONTINUE
							SIF IS_BADSTATE(BCHARA:L_STOCK, "DYING")
								CONTINUE
							CALL PUSH_ARRAY_INT, L_COST_CHARA, BCHARA:L_STOCK
						NEXT
						IF L_COST_CHARA:0 > 0
							SWAP L_COST_CHARA:0, L_COST_CHARA:(RAND:FINDELEMENT(L_COST_CHARA, 0))
							BASE:L_T:ＨＰ = MAXBASE:L_T:ＨＰ
							CALL DEAD_CHARA, L_COST_CHARA:0, L_FRIEND, 1
							TSTR:스킬메시지추가 = 生贄交代の効果で%CALLNAME:(L_COST_CHARA:0)%を身代わりにして%CALLNAME:L_T%は復活した！
						ENDIF
					ENDIF
				ELSE
					;汎用食いしばり処理
					;1度のみ、指定したHP%で復帰するだけのものは纏めて探す
					;主に覚醒スキルや専用スキルで食いしばり効果も内包している…といったものを作る場合はスキル側だけで完結できるように
					IF CFLAG:L_T:이악물기플래그 == 0
						STOCK_CLENCHING_HEAL = -1
						STOCK_CLENCHING_MESSAGE = 
						;食いしばりスキルを探し、回復HP量の多いものを優先して残す
						FOR LCOUNT, 0, TRYSKILLNUM(L_T)
							RESULT = 0, 0
							RESULTS = 
							TRYCCALLFORM SKILL_CLENCHING_%GET_TRYSKILL(L_T, LCOUNT)%, L_T, TRYSKILL_VAR
								SIF !RESULT
									CONTINUE
								SIF STOCK_CLENCHING_HEAL > RESULT:1
									CONTINUE
								STOCK_CLENCHING_HEAL = RESULT:1
								STOCK_CLENCHING_MESSAGE = %RESULTS%
							CATCH
							ENDCATCH
						NEXT
						;回復率が0以上になっていれば発動条件を満たしている
						IF STOCK_CLENCHING_HEAL >= 0
							IF L_SKIP_MESSAGE != 2
								IF STOCK_CLENCHING_MESSAGE == ""
									IF STOCK_CLENCHING_HEAL == 0
										TSTR:스킬메시지추가 = %CALLNAME:L_T%は食いしばった！
									ELSE
										TSTR:스킬메시지추가 = %CALLNAME:L_T%は立ち上がった！
									ENDIF
								ELSE
									TSTR:스킬메시지추가 = %STOCK_CLENCHING_MESSAGE%
								ENDIF
							ENDIF
							BASE:L_T:ＨＰ = MAX(STOCK_CLENCHING_HEAL * MAXBASE:L_T:ＨＰ / 100, 1) 
							CFLAG:L_T:이악물기플래그 = 1
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			;HPが戻っているのならば食いしばりが発動したとみなす
			IF BASE:L_T:ＨＰ > 0
				CFLAG:L_T:이악물기발동 = 1
				;食いしばりのメッセージ表示
				SIF !L_SKIP_MESSAGE
					CALL PRINT_SKILL_MESSAGE, "追加";EDIT MOD 081
			ELSE
				FOR LCOUNT:1, CFLAG:L_T:PT플래그 ? 1 # 7, CFLAG:L_T:PT플래그 ? 7 # 17
					L_FRIEND = POS(LCOUNT:1)
					SIF !IS_TARGET_ABLE(L_FRIEND)
						CONTINUE
					;PT範囲の食いしばりスキルを探す
					FOR LCOUNT, 0, TRYSKILLNUM(L_FRIEND)
						SELECTCASE GET_TRYSKILL(L_FRIEND, LCOUNT)
							CASE "AW_" + TOSTR(GET_AW_SKILL_NUM("不死の蟠桃"))
								IF SKILLGAGE_H_GET(L_FRIEND, [[스킬:각성스킬]]) < 2
									CALL SKILLGAGE_H_SET, L_FRIEND, [[스킬:각성스킬]], SKILLGAGE_H_GET(L_FRIEND, [[스킬:각성스킬]]) + 1
									BASE:L_T:ＨＰ = MAXBASE:L_T:ＨＰ
									SIF L_SKIP_MESSAGE != 2
										TSTR:스킬메시지추가 = 不死の蟠桃の効果で%CALLNAME:L_T%は復活した！
									BREAK
								ENDIF
							CASE "AW_" + TOSTR(GET_AW_SKILL_NUM("真夏の夜の夢"))
								IF L_T == MASTER
									FOR L_STOCK, 0, BCHARANUM
										SIF CPOS(BCHARA:L_STOCK) > 0
											CONTINUE
										SIF !IS_COMP内効果有効(BCHARA:L_STOCK)
											CONTINUE
										SIF IS_BADSTATE(BCHARA:L_STOCK, "DYING")
											CONTINUE
										CALL PUSH_ARRAY_INT, L_COST_CHARA, BCHARA:L_STOCK
									NEXT
									IF L_COST_CHARA:0 > 0
										SWAP L_COST_CHARA:0, L_COST_CHARA:(RAND:FINDELEMENT(L_COST_CHARA, 0))
										BASE:L_T:ＨＰ = MAXBASE:L_T:ＨＰ
										CALL DEAD_CHARA, L_COST_CHARA:0, L_FRIEND, 1
										SIF L_SKIP_MESSAGE != 2
											TSTR:스킬메시지추가 = 真夏の夢の効果で%CALLNAME:(L_COST_CHARA:0)%を身代わりにして%CALLNAME:L_T%は復活した！
										BREAK
									ENDIF
								ENDIF
							CASE "[[스킬:의료키트]]"
								IF !SKILLGAGE_H_GET(L_FRIEND, [[스킬:의료키트]])
									CALL SKILLGAGE_H_SET, L_FRIEND, [[스킬:의료키트]], 1
									BASE:L_T:ＨＰ = MAXBASE:L_T:ＨＰ
									SIF L_SKIP_MESSAGE != 2
										TSTR:스킬메시지추가 = 医療キットにより%CALLNAME:L_T%が蘇生された！
									BREAK
								ENDIF
							CASE "AW_" + TOSTR(GET_AW_SKILL_NUM("気合の合成"))
								IF CFLAG:L_T:피타겟비율변동지속턴수 > 0 && CFLAG:L_T:변동피타겟율 > 100 && RAND:2
									BASE:L_T:ＨＰ = 1
									SIF L_SKIP_MESSAGE != 2
										TSTR:스킬메시지추가 = %CALLNAME:L_T%は食いしばった！
									BREAK
								ENDIF
						ENDSELECT
					NEXT 
					SIF BASE:L_T:ＨＰ > 0
						BREAK
				NEXT
				;HPが戻っているのならば食いしばりが発動したとみなす
				IF BASE:L_T:ＨＰ > 0
					;食いしばりのメッセージ表示
					SIF !L_SKIP_MESSAGE
						CALL PRINT_SKILL_MESSAGE, "追加";EDIT MOD 081
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	;ここまで来てHPが付きているのならば死亡処理
	SIF BASE:L_T:ＨＰ < 1
		CALL DEAD_CHARA, L_T, L_P, L_SKIP_MESSAGE
	;HPがリンクしていた場合連動処理
	VARSET LINKED_DAMAGE_TO_POS
	CALL GET_LINKED_HP_CHARA, L_T
	FOR LCOUNT, 0, 10
		SIF RESULT:LCOUNT < 0
			CONTINUE
		SIF L_T == RESULT:LCOUNT
			CONTINUE
		SIF CPOS(RESULT:LCOUNT) > 0
			LINKED_DAMAGE_TO_POS:CPOS(RESULT:LCOUNT) = L_VAR
		BASE:(RESULT:LCOUNT):ＨＰ = BASE:L_T:ＨＰ
		SIF BASE:(RESULT:LCOUNT):ＨＰ < 1 && CPOS(RESULT:LCOUNT) > 0
			CALL DEAD_CHARA, (RESULT:LCOUNT), L_P, 2
	NEXT
	RETURN L_VAR
ENDIF

;MPの増減処理
;ダメージと違って食いしばりの有無や超過を気にする場面はとりあえずなく、引数はいらないが
;一応、何かの補正を追加する可能性ももあるのでHPと引数の型はあわせておく
@VAR_MP,ARG,ARG:1,ARGS = "自動振り分け"
#DIM STOCK_MP
IF ARGS == "自動振り分け"
	IF ARG:1 <= 0
		ARGS = ダメージ
	ELSE
		ARGS = 회복
	ENDIF
ENDIF
STOCK_MP = BASE:ARG:ＭＰ
;---- EDIT 094 MOD START -------------------------
BASE:ARG:ＭＰ = LIMIT(BASE:ARG:ＭＰ + ARG:1, 0, MAXBASE:ARG:ＭＰ)
;---- EDIT 094 MOD END ---------------------------
RETURN BASE:ARG:ＭＰ - STOCK_MP
