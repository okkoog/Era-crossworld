;戦闘時のメッセージ関連ですぐにメッセージを出力せずにTSTRに退避させるオプションを追加。
;======================================================================
;戦闘不能処理
;ARG 	対象のキャラ番号
;ARG:1	下手人のキャラ番号
;ARG:2	1 = この関数ないでメッセージをPRINTしない
;======================================================================
@DEAD_CHARA, ARG, ARG:1 = -1, ARG:2
;#DIM num
#LOCALSIZE 3
#DIM L_SKIP_MESSAGE
;---- EDIT 104 ADD START -------------------------
BASE:ARG:ＨＰ = 0
;---- EDIT 104 ADD END ---------------------------
;死亡時のイベント呼び出し
CALL EVENT_BATTLE_DYING, ARG, ARG:1, ARG:2
L_SKIP_MESSAGE= ARG:2
;上の呼び出しでHPが回復されてたら死亡時の処理を飛ばす
IF BASE:ARG:ＨＰ <= 0
	;---- EDIT 104 DEL START -------------------------
	;VARSET num,0
	;BASE:ARG:ＨＰ = 0
	;---- EDIT 104 DEL END ---------------------------
	CFLAG:ARG:상태이상 = GET_STATE_NUM("DYING")
	CALL REFRESH_BATTLE_CHARA_STATE, ARG;EDIT  093 ADD
	;---- EDIT 080 ADD START -------------------------キャラクター履歴の登録処理を追加
	SIF ARG:1 >= 0
		CALL SET_C_RECORDS, ARG:1, ARG, "KILL"
	;---- EDIT 080 ADD END ---------------------------
	;---- EDIT 028 MOD START -------------------------
	CALL SYNC_STATUS,ARG
	;---- EDIT 028 MOD END ---------------------------

	IF CFLAG:ARG:PT플래그 == 0
		;会話不能フラグが立っているときは傾かない
		IF !FLAG:회화불능플래그 && !CFLAG:ARG:보스플래그 && !SOFT_ON("세컨드헬로") && ABL:ARG:회화타입 != 331
			;仲魔に居る悪魔を倒すと混沌に傾く ストレージ内は考慮しないように変更
			;---- EDIT 107 MOD START -------------------------
			VARI L_FRIEND
			FOR LOCAL, 0, BCHARANUM
				L_FRIEND = BCHARA:LOCAL
				IF NO:L_FRIEND == NO:ARG && IS_FRIEND(MASTER, L_FRIEND)
					IF CFLAG:L_FRIEND:PT플래그 == 1
						SIF !GET_ROLE_PROP("CAN_PUT_IN_COMP", L_FRIEND)
							CONTINUE
					ENDIF
					SIF CFLAG:L_FRIEND:이자리에없는플래그
						CONTINUE
					CALL INCREASE_LC,-1
					BREAK
				ENDIF
			NEXT
		ENDIF
		;---- EDIT 107 MOD END ---------------------------
		SIF L_SKIP_MESSAGE != 2
			TSTR:스킬메시지추가 = %ARG를% 쓰러트렸다
		;PRINTFORMW %CALLNAME:ARG%を倒した
		;悪魔解析度が5上昇
		IF FLAG:악마해석률상승불가플래그 == 0
			;解析可能な場合
			CALL INCREASE_ANALYZE,NO:ARG,5
		ENDIF
		;---- EDIT 098 DEL START -------------------------
		;SIF CFLAG:ARG:시체잔존 == 0
		;	CALL REMOVE_POSITION,CFLAG:ARG:포지션
		;---- EDIT 098 DEL END ---------------------------
		CFLAG:ARG:입력행동 = -1
	ELSE
		;---- EDIT 000 XXX START -------------------------
		SIF L_SKIP_MESSAGE != 2
			TSTR:스킬메시지추가 = %CALLNAME:ARG%は力尽きた
		CFLAG:ARG:입력행동 = -1
		;瀕死になった場合はCFLAG:ダンジョン内発情用欲情値が半分になり、発情状態が解除される
		IF FLAG:무후후전개 && CFLAG:ARG:던전내발정용욕정치
			CFLAG:ARG:던전내발정용욕정치 /= 2
			CFLAG:ARG:던전내발정 = 0
		ENDIF
		;---- EDIT 000 XXX END ---------------------------
	ENDIF
ENDIF
IF !L_SKIP_MESSAGE
	CALL PRINT_SKILL_MESSAGE, "追加";EDIT MOD 081
	WAIT
ENDIF
