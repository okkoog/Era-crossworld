;ARG:2 イベントフラグ(通常の他-1のとき、合体時の一時表示に作成された悪魔であることを示す / -2はゲストキャラを示す)
;ARG:3 真:全書利用時に一時的に仲魔に加える処理であることを示す。所持数警告や加入キャンセルを無効にする
;ARG:4 真:加入後、人間化する場合に使用。これ使わないと、容量MAX時に加入させた時、人間なのにストレージにいる扱いになります
;ARG:5 真:加入後、Lvを任意に設定する場合に使用。指定しない場合は通常の初期LVが適応されます
;RESULT 真:キャラが作成されたことを示す。偽:既に同一キャラがいた場合や人数制限にかかった場合などでキャラが作成されなかった場合
;RRSULT:1 作成したキャラの登録番号を返す
;
;★サンプルです。わかります★
;CALL ADD_NEW_COMPANION,[[キャラ:기린]],충성도,イベントフラグ2,一時的に仲魔に3,人間化4,Lv指定5
;CALL ADD_NEW_COMPANION,[[キャラ:기린]],114514,0,0,0,99
;忠誠度114514、イベント加入、全書表示用、特別な人間化なし、LV99で加入
;=================================================================
;---- EDIT 048 ADD START ----
;@ADD_NEW_COMPANION, ARG, ARG:1, ARG:2 = 0, ARG:3 = 0, ARG:4 = 0
@ADD_NEW_COMPANION, ARG, ARG:1, ARG:2 = 0, ARG:3 = 0, ARG:4 = 0, ARG:5 = 0
#DIMS 異常経験名 , 64
#DIM LCOUNT,2
#DIM TEMP
#DIM CHARA
#DIM STOCK_TARGET
#DIM L_キャラ固有の番号
#DIM L_CHARANUM
#DIM レベル上昇値,1
#DIM ボーナスポイント,1
#DIM レベルアップ回数
#DIM マリアージュ成立
#DIM SUM_OF_BASE, 2
;---------------------------------------------------
;すでにキャラクターが生成されている場合の処理
;
;一部の例外をのぞいで人間はひとりしか生成できないのでここでひっかかったら戻る
;---------------------------------------------------
SIF !CAN_ADD_NEW_COMPANION(ARG, ARG:2, ARG:2 == -1 || ARG:3 > 0)
	RETURN 0, RESULT:1
FOR L_キャラ固有の番号, 0, MAX_PLAYER_CHARA
	SIF !CMATCH(CFLAG:캐릭터고유번호, L_キャラ固有の番号)
		BREAK
	IF !ARG:3
		IF L_キャラ固有の番号 == MAX_PLAYER_CHARA-5
			PRINTFORMW ※소지하고 있는 캐릭터가 {MAX_PLAYER_CHARA-5}명에 도달했습니다
			PRINTFORMW 　{MAX_PLAYER_CHARA}명을 초과하면, 가입 처리가 취소되므로 주의해 주십시오
		ENDIF
		IF L_キャラ固有の番号 == MAX_PLAYER_CHARA-1
			PRINTW 캐릭터 수가 상한에 도달했습니다
			PRINTW 캐릭터 가입 처리를 취소합니다
			RETURN 0
		ENDIF
	ENDIF
NEXT
;抜けた段階で+1されるので調整
L_キャラ固有の番号 -= 1
CHARA = CHARANUM
STOCK_TARGET = TARGET
ADDCHARA ARG
SIF NICKNAME:CHARA == ""
	THROW NICKNAMEが定義されてないキャラ[%CALLNAME:CHARA%({NO:CHARA})]が生成されました。
;---- EDIT 034 MOD START -------------------------
SIF ARG:4
	ABL:CHARA:종족 = 0
;---- EDIT 034 MOD END -------------------------
TARGET = STOCK_TARGET
CFLAG:CHARA:PT플래그 = 1
CFLAG:CHARA:캐릭터고유번호 = L_キャラ固有の番号
;---- EDIT 103 ADD START -------------------------
CFLAG:CHARA:실제가입시간 = GETMILLISECOND()
;---- EDIT 103 ADD END ---------------------------
;一応RESULTを破壊しておく
VARSET RESULT
;危険日を設定する
ENCODETOUNI %NAME:CHARA%
TEMP = RESULT+1
IF ABL:CHARA:종족 == 0 || ABL:CHARA:종족 == 45
	CFLAG:CHARA:위험일 = (SUMARRAY(RESULT , 1 , TEMP) + DAY*4 + TIME)%16
ELSE
	CFLAG:CHARA:위험일 = (SUMARRAY(RESULT , 1 , TEMP) + DAY*4 + TIME)%15
	SIF CFLAG:CHARA:위험일 >= 8
		CFLAG:CHARA:위험일 += 1
ENDIF

CALL 子宮最大容量初期設定,(CHARA)

;---- EDIT 084 ADD START -------------------------
;ロールとロールごとの初期素質の設定
CALL SET_ROLE, CHARA
CALL SET_BTL_TALENT_NEW, CHARA
;---- EDIT 084 ADD END ---------------------------

VARSET RESULT
CFLAG:CHARA:조교메뉴표시설정 = GLOBAL:9

;---- EDIT 120 ADD START -------------------------
;レベルが指定されている場合
IF ARG:5 > 0
	;合計ステを確認
	SUM_OF_BASE = 0
	FOR LCOUNT, 1, BASESTATUSNUM
		SUM_OF_BASE += BASE:CHARA:(GET_BASESTATUS(LCOUNT))
	NEXT
	;指定レベルの基準値を取る
	SUM_OF_BASE:1 = 18 + ARG:5 * 3 / 2
	;元々の数値の基準値との差を折り込む
	SUM_OF_BASE:1 += SUM_OF_BASE - (18 + BASE:CHARA:LV * 3 / 2)

	;レベルを変更
	BASE:CHARA:LV = ARG:5
	;ステータスを調整
	FOR LCOUNT, 1, BASESTATUSNUM
		BASE:CHARA:(GET_BASESTATUS(LCOUNT)) = BASE:CHARA:(GET_BASESTATUS(LCOUNT)) * SUM_OF_BASE:1 / SUM_OF_BASE
	NEXT
	;振り分け元の合計ステータスと現在のステータスの合計が一致していない場合、もっとも低いものに加算、あるいは最も高いものに減算を繰り返して数値をあわせる
	WHILE SUMARRAY(BASE:CHARA:0, GETNUM(BASE, "힘"), GETNUM(BASE, "운") + 1) != SUM_OF_BASE:1
		IF SUMARRAY(BASE:CHARA:0, GETNUM(BASE, "힘"), GETNUM(BASE, "운") + 1) > SUM_OF_BASE:1
			BASE:CHARA:FINDELEMENT(BASE:CHARA:0, MAXARRAY(BASE:CHARA:0, GETNUM(BASE, "힘"), GETNUM(BASE, "운") + 1), GETNUM(BASE, "힘"), GETNUM(BASE, "운") + 1)--
		ELSE
			BASE:CHARA:FINDELEMENT(BASE:CHARA:0, MINARRAY(BASE:CHARA:0, GETNUM(BASE, "힘"), GETNUM(BASE, "운") + 1), GETNUM(BASE, "힘"), GETNUM(BASE, "운") + 1)++
		ENDIF
	WEND
ENDIF

CALL INIT_CHARA_SKILL, CHARA
;現レベルまでのスキルを習得させる
;いちおうレベル指定と関係ないタイミングにすることで、習得レベルが初期レベル以下に指定したスキルをレベルが低い加入では習得していないが、通常の加入では習得していると形にできるようにしておく
CALL LEARN_SKILL_TO_NOW_LEVEL, CHARA

;---- EDIT 120 ADD END ---------------------------
;経験値、マグネタイト、忠誠度の初期化、仲魔フラグ
;TEMP = MAXBASE:CHARA:(GET_BASESTATUS(0))
TEMP = BASE:CHARA:LV
BASE:CHARA:ＥＸＰ = 5*(TEMP-1)*(TEMP+1)*(TEMP)/3
SIF ABL:CHARA:종족 != 0
	TIMES BASE:CHARA:ＥＸＰ , 1.25

;SIF ABL:CHARA:종족 == 45;EDIT 085 MOD
SIF GET_ROLE_PROP("NEXT_EXP", CHARA) == -1
	BASE:CHARA:ＥＸＰ = 0
BASE:CHARA:ＭＡＧ = 0
BASE:CHARA:충성도 = ARG:1
MAXBASE:CHARA:충성도 = 0
;ＭＡＧ自己消費フラグをＯＦＦ
CFLAG:CHARA:ＭＡＧ자기소비 = 0
;人間ならば戦闘参加不能(一時加入処理の場合は通さない)
IF ARG:2 >= 0 && ARG:3 == 0
	SIF (ABL:CHARA:종족 > 45 || ABL:CHARA:종족 == 0) && CHARA != MASTER
		CALL SET_TALENT_PARTY_JOINABLE, CHARA, "参加不可能"
ENDIF
;善悪値・秩混値未設定の場合、設定
CALL ADJUST_CHARA_ALI,CHARA

;一時登録の場合は通さない
IF ARG:2 >= 0 && ARG:3 == 0
	;ダンジョンや依頼ごとの修正
	SELECTCASE FLAG:SHOP커맨드
		CASE [[ショップ:탐색]]
			TRYCALLFORM SET_COMPANION_DUNGEON_{FLAG:현던전} , CHARA
		CASE [[ショップ:콜로세움참가]]
			TRYCALLFORM SET_COMPANION_COLOSSEUM_{FLAG:진행중콜로세움} , CHARA
		CASE [[ショップ:이벤트]]
			TRYCALLFORM SET_COMPANION_EVENT_{FLAG:진행중이벤트} , CHARA
		CASE [[ショップ:의뢰청부]]
			TRYCALLFORM SET_COMPANION_REQUEST_{FLAG:진행중의뢰} , CHARA
	ENDSELECT
ENDIF
;着衣状況をセット
FOR LCOUNT, 0, 14
	CFLAG:CHARA:("초기" + GET_CLOTHESNAME(LCOUNT)) = CFLAG:CHARA:GET_CLOTHESNAME(LCOUNT)
	TEMP = GROUPMATCH(GET_CLOTHESNAME(LCOUNT), "그외2", "그외3") ? 11 # LCOUNT
	IF CFLAG:CHARA:GET_CLOTHESNAME(LCOUNT) > 0 && !INRANGE(CFLAG:CHARA:GET_CLOTHESNAME(LCOUNT), TEMP * 100, 99 + TEMP * 100)
		DRAWLINE
		PRINTFORML %CALLNAME:CHARA%의 %GET_CLOTHESNAME(LCOUNT)%에 이상한 의상[%CLOTHESNAMEF(CHARA, LCOUNT)%]이(가) 세트되어 있습니다！
		DRAWLINE
		FORCEWAIT
	ENDIF
	SIF CFLAG:CHARA:GET_CLOTHESNAME(LCOUNT)
		SETBIT CFLAG:CHARA:전회조교시의복장기록, LCOUNT
NEXT
CFLAG:CHARA:전회탐색시의복장기록 = CFLAG:CHARA:전회조교시의복장기록

;初期マスターマントラ
IF TALENT:CHARA:식노
	FOR LCOUNT, 1, 9
		SIF ABL:CHARA:@"스킬{LCOUNT}"
			CDFLAG:CHARA:만트라:(ABL:CHARA:@"스킬{LCOUNT}") = 10000
		ABL:CHARA:@"스킬{LCOUNT}" = 0
	NEXT
ENDIF

;初期レベルを保存
CFLAG:CHARA:초기LV = BASE:CHARA:LV

;---- EDIT 087 ADD START -------------------------
;初期覚醒スキルはCSVから参照したいだけなので落とす
ABL:CHARA:각성스킬 = 0
;---- EDIT 087 ADD END ---------------------------

CFLAG:CHARA:이벤트가입 = ARG:2

FOR LCOUNT, 0, VARSIZE("C_REPEAT_SKILL")
	CALL SET_REPEAT_CHARA, CHARA, -1
NEXT

;初期異常経験分を加算
IF CSTR:CHARA:초기이상경험 != ""
	EXP:CHARA:이상경험 = 0
	VARSET 異常経験名
	SPLIT CSTR:CHARA:초기이상경험 , "_" , 異常経験名
	FOR LCOUNT , 0 , STRCOUNT(CSTR:CHARA:초기이상경험 , "_") + 1
		SETBIT CFLAG:CHARA:이상경험기록 , NUM_ABNORMAL_EXP(異常経験名:(LCOUNT))
		EXP:CHARA:이상경험 += RANK_ABNORMAL_EXP(異常経験名:(LCOUNT))
	NEXT
ENDIF
CFLAG:CHARA:초기이상경험 = EXP:CHARA:이상경험

CFLAG:CHARA:딸의부친고유번호딸 = -1
CFLAG:CHARA:딸의친부모고유번호딸 = -1

;初期好感度
;加入キャラに好感度と被好感度のデータを両方持たせておき、加入時点で相手をサーチして両方上書きする
;配偶者・近親はデフォで初期好感度を持つ
FOR LCOUNT, 0, CHARANUM
	IF CSV配偶者(CHARA, LCOUNT)
		CDFLAG:CHARA:캐릭터간호감도:(CFLAG:LCOUNT:캐릭터고유번호 + 100) = 2000
		CDFLAG:LCOUNT:캐릭터간호감도:(CFLAG:CHARA:캐릭터고유번호 + 100) = 2000
	ENDIF
NEXT

FOR LCOUNT,0,BADSTATENUM
	BASE:CHARA:GET_STATE(LCOUNT) = 0
NEXT
;---- EDIT 045 ADD END -------------------------
;二人称の変換
;FORM文の展開
CALL CONVERT_SECOND_PERSON, CHARA

;固有処理の呼び出し
;一時登録でない場合は通さない
IF ARG:2 >= 0 && ARG:3 == 0
	TRYCALLFORM ADD_NEW_COMPANION_{ARG}, CHARA, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5
	;---- EDIT 026 MOD START -------------------------
	;---- EDIT 025 ADD START -------------------------
	;---- EDIT 095 MOD START -------------------------
	IF !ARG:3 && !IS_IN_FUSION
		;悪魔が容量を超えて仲魔になった場合、ＤＤＭ使用中ならその機能で自宅サーバーに転送することを説明
		IF GET_ROLE_PROP("CAN_PUT_IN_COMP", CHARA) && ストック空き容量() == -1
			IF SOFT_ON("ＤＤＭ")
				PRINTFORMW ＣＯＭＰ에 빈 용량이 없으므로, ＤＤＭ으로 자택 서버에 전송했습니다
			ENDIF
			CFLAG:CHARA:소속ＣＯＭＰ = -1
		ENDIF
	ENDIF
	;アイテムの入手履歴をつけておく
	FOR LCOUNT, GETNUM(EQUIP, "검"), GETNUM(EQUIP, "탄환") + 1
		SIF EQUIP:CHARA:LCOUNT
			TAKEN_ITEM:(EQUIP:CHARA:LCOUNT) = 1
	NEXT
	;---- EDIT 026 MOD END -------------------------
ENDIF
;設定された性別の場合、夜這いを不許可に
IF (FLAG:요바이불허가성별 & 2 && TALENT:CHARA:오토코노코)
	CFLAG:CHARA:요바이불허가 = 1
ELSEIF (FLAG:요바이불허가성별 & 1 && TALENT:CHARA:남자 && TALENT:CHARA:오토코노코 == 0)
	CFLAG:CHARA:요바이불허가 = 1
ELSEIF (FLAG:요바이불허가성별 & 4 && TALENT:CHARA:남자 == 0)
	CFLAG:CHARA:요바이불허가 = 1
ENDIF

;全コマンド系統フィルタＯＮ
FOR LCOUNT , 0 , 13
	CFLAG:CHARA:(170+LCOUNT) = 1
NEXT

CALL EXCLUDE_UNABLE_SKILL, CHARA
;取得済みスキルの登録
FOR LCOUNT, 1, HAVEABLE_SKILLNUM + 1
	SIF ABL:CHARA:@"스킬{LCOUNT}"
		CALL SET_LEARNED_SKILL, CHARA, TOSTR(ABL:CHARA:@"스킬{LCOUNT}"), "通常形態"
	SIF ABL:CHARA:@"초기변신악마스킬{LCOUNT}"
		CALL SET_LEARNED_SKILL, CHARA, TOSTR(ABL:CHARA:@"초기변신악마스킬{LCOUNT}"), "変身形態"
NEXT

;スキルロック
CALL AUTO_SKILL_ROCK,CHARA
SIF スキル変更可能確かめ(CHARA) > 1
	CALL AUTO_SKILL_ROCK,CHARA,1

CALL 顔グラ追加, NO:CHARA

;---- EDIT P 001 ADD START -------------------------
;デフォ顔グラセット
SIF CSTR:CHARA:基本アイコンファイルネーム == ""
	CALL SET_DEFAULT_FACE, CHARA, "通常形態"

;TALK加入の場合はひきうつしと基礎力プラグインのチェック
VARI L_ENEMY
L_ENEMY = FINDCHARA(CFLAG:실제가입시간, TFLAG:교섭대상실제가입시간)
IF L_ENEMY >= 0
	CALL COPY_ENEMY_TO_NEW_COMPANION, L_ENEMY, CHARA
	;---- EDIT 027 ADD START -------------------------
	IF SOFT_ON("기초력플러그인")
		VARI L_ENHANCE_MAG
		VARI CNT_FREE_ENHANCE
		;強化の産出用のMAG
		L_ENHANCE_MAG = GET_BASE_ENEMY_MAG(, BASE:CHARA:LV, GET_RACE_NUM("요정"))
		VARI CNT_FREE_ENHANCE = 0
		;ふれなくなるまでふらせる
		WHILE L_ENHANCE_MAG >= MAG_CALC_ENHANCE_BASE(CHARA, CNT_FREE_ENHANCE)
			L_ENHANCE_MAG -= MAG_CALC_ENHANCE_BASE(CHARA, CNT_FREE_ENHANCE)
			CNT_FREE_ENHANCE++
		WEND
		CFLAG:CHARA:능력강화횟수 = CNT_FREE_ENHANCE
	ENDIF
	;---- EDIT 027 ADD END ---------------------------
	TFLAG:교섭대상실제가입시간 = 0
ENDIF

;---- EDIT P 001 ADD END ---------------------------
;---- EDIT 104 ADD START -------------------------
;バージョン情報を持たせる
CFLAG:CHARA:본체버전정보 = GAMEBASE_VERSION
CFLAG:CHARA:본체버전관리보조정보 = FLAG:버전관리보조
;---- EDIT 104 ADD END ---------------------------

;一時登録でない場合は解析度をつける
IF ARG:2 >= 0 && ARG:3 == 0
	ANALYSIS_RATE:(NO:CHARA) = ANALYSIS_COMPLETED
	;イベントフラグのBITを立てておく
	SETBIT IS_CHARA_COMPANIONED:(NO:CHARA), ARG:2
ENDIF

CALL SYNC_STATUS,CHARA
CALL HEALTH_CHARA,CHARA

RESULT:1 = CHARA
RETURN 1

;---- EDIT 091 ADD START -------------------------
;=======================================
;リンク悪魔のセット関数
;ARG = 対象のキャラの登録番号
;ARG:1 = セットする悪魔の番号
;ARGS = セットする内容
;=======================================
@SET_LINK_DEVIL, ARG, ARG:1, ARGS = "攻撃性能/스킬"
#DIM LCOUNT
CFLAG:ARG:초기링크악마 = ARG:1
IF COUNT_SPLIT(ARGS, "/", "攻撃性能")
	ABL:ARG:초기링크악마공격상성 = CSVABL(ARG:1, GETNUM(ABL, "공격상성"))
	ABL:ARG:초기링크악마최저공격횟수 = CSVABL(ARG:1, GETNUM(ABL, "최저공격횟수"))
	ABL:ARG:초기링크악마최대공격횟수 = CSVABL(ARG:1, GETNUM(ABL, "최대공격횟수"))
	ABL:ARG:초기링크악마사거리 = CSVABL(ARG:1, GETNUM(ABL, "사거리"))
	ABL:ARG:초기링크악마공격범위 = CSVABL(ARG:1, GETNUM(ABL, "공격범위"))	
ENDIF
IF COUNT_SPLIT(ARGS, "/", "스킬")
	FOR LCOUNT, 0, HAVEABLE_SKILLNUM
		SIF CSVABL(ARG:1, GETNUM(ABL, @"스킬{LCOUNT+1}"))
			CALL SET_LEARN_SKILL, ARG, TOSTR(CSVABL(ARG:1, GETNUM(ABL, @"스킬{LCOUNT+1}"))), 1, "変身形態"
	NEXT
	FOR LCOUNT, 0, HAVEABLE_SKILLNUM
		SIF CSVABL(ARG:1, GETNUM(ABL, @"습득스킬{LCOUNT+1}"))
			CALL SET_LEARN_SKILL, ARG, TOSTR(CSVABL(ARG:1, GETNUM(ABL, @"습득스킬{LCOUNT+1}"))), CSVABL(ARG:1, GETNUM(ABL, @"습득LV{LCOUNT+1}")), "変身形態"
	NEXT
ENDIF
