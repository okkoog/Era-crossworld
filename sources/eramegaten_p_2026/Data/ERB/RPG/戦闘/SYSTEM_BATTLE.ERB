BCHARANUM = 0
FOR LOCAL, 0, CHARANUM
	SIF !IS_JOINED_BCHARA:LOCAL:0
		CONTINUE
	BCHARA:FINDELEMENT(BCHARA, -1) = LOCAL
	BCHARANUM++
	;BCHARANUM = -1
