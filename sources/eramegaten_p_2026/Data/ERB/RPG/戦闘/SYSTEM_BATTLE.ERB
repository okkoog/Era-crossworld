@GET_CHARA_STOCK_MAG, L_CHARA
#FUNCTION
#DIM DYNAMIC L_CHARA
IF CFLAG:L_CHARA:MAG링크 > 0
	L_CHARA = FINDCHARA_TIMEID(CFLAG:L_CHARA:피링크캐릭터실제가입시간)
	SIF L_CHARA < 0
		RETURNF 0
ENDIF
RETURNF BASE:L_CHARA:ＭＡＧ

;==============================
;MAG保有量
;==============================
@GET_CHARA_MAXMAG, L_CHARA
#FUNCTION
#DIM DYNAMIC L_CHARA
IF CFLAG:L_CHARA:MAG링크 > 0
	L_CHARA = FINDCHARA_TIMEID(CFLAG:L_CHARA:피링크캐릭터실제가입시간)
	SIF L_CHARA < 0
		RETURNF 0
ENDIF
RETURNF MAXBASE:L_CHARA:ＭＡＧ

;==============================
;MAG操作
;==============================
@CONTROL_MAG,L_CHARA,MAG_AMOUNT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC MAG_AMOUNT
IF CFLAG:L_CHARA:MAG링크 > 0
	L_CHARA = FINDCHARA_TIMEID(CFLAG:L_CHARA:피링크캐릭터실제가입시간)
	SIF L_CHARA < 0
		RETURN 0
ENDIF
IF GET_CHARA_STOCK_MAG(L_CHARA) + MAG_AMOUNT > GET_CHARA_MAXMAG(L_CHARA)
	MAG_AMOUNT = GET_CHARA_MAXMAG(L_CHARA) - GET_CHARA_STOCK_MAG(L_CHARA)
ELSEIF GET_CHARA_STOCK_MAG(L_CHARA) + MAG_AMOUNT < 0
	MAG_AMOUNT = -GET_CHARA_STOCK_MAG(L_CHARA)
ENDIF

BASE:L_CHARA:ＭＡＧ += MAG_AMOUNT

