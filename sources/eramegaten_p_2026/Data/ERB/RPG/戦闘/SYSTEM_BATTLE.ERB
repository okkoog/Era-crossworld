	TSTR:COOP해석 += @"/ALI補正_{COOP_POWER}\%"

	COOP_DMG *= (100+COOP_MEMBER_LV_AVERAGE) * (COOP_MEMBER_ATTACK_AVERAGE) * (10+COOP_MEMBER_ATTACK_AVERAGE/12)
	TSTR:COOP해석 += @"/攻撃力実数値_{(100+COOP_MEMBER_LV_AVERAGE) * (COOP_MEMBER_ATTACK_AVERAGE) * (10+COOP_MEMBER_ATTACK_AVERAGE/12)}"

	解析用 = MAX(COOP_DMG, 1)
	COOP_DMG /= ((MAXBASE:L_TARGET:방어 + MAXBASE:L_TARGET:마법효과)/2) * 100 * 100 * 300
		
	TSTR:COOP해석 += @"/防御力実数値_{((MAXBASE:L_TARGET:방어 + MAXBASE:L_TARGET:마법효과)/2) * 100 * 100 * 300}"
	TSTR:COOP해석 += @"/攻防比計算後_{COOP_DMG / 解析用}"
	解析用 = MAX(COOP_DMG, 1)
	;---- EDIT 089 MOD START -------------------------
	IF CFLAG:ARG:공격강화 + CFLAG:ARG:마법위력강화 > 0
		COOP_DMG *= 64 + CFLAG:ARG:공격강화 + CFLAG:ARG:마법위력강화
		COOP_DMG /= 64
	ELSE
		COOP_DMG *= 128 + CFLAG:ARG:공격강화 + CFLAG:ARG:마법위력강화
		COOP_DMG /= 128
	ENDIF
	IF CFLAG:L_TARGET:방어강화 + CFLAG:L_TARGET:마법효과강화 > 0
		COOP_DMG *= 128 - (CFLAG:L_TARGET:방어강화 + CFLAG:L_TARGET:마법효과강화)
		COOP_DMG /= 128
	ELSE
		COOP_DMG *= 64 - (CFLAG:L_TARGET:방어강화 + CFLAG:L_TARGET:마법효과강화)
		COOP_DMG /= 64
	ENDIF
	;COOP_DMG *= (32 + CFLAG:ARG:공격강화) + (32 + CFLAG:ARG:마법위력강화)
	;COOP_DMG /= 64
	;COOP_DMG *= (32 - CFLAG:L_TARGET:방어강화) + (32 - CFLAG:L_TARGET:마법효과강화)
	;COOP_DMG /= 64
	;---- EDIT 089 MOD END ---------------------------
	TSTR:COOP해석 += @"/カジャンダ補正_{COOP_DMG * 100 / 解析用}\%"

	;乱数
	COOP_DMG *= (9500+RAND:1000)
	COOP_DMG /= 10000
	TSTR:COOP해석 += @"/乱数後_{COOP_DMG}"
	解析用 = MAX(COOP_DMG, 1)
	;防御中のキャラにはダメージ減少
	SIF CFLAG:L_TARGET:방어플래그
		COOP_DMG /= 2
	;後列のキャラへのダメージ減少はない
	;受ける側が味方の場合難易度修正
	IF CFLAG:L_TARGET:PT플래그 > 0
		SELECTCASE FLAG:4
			CASE 1
				TIMES COOP_DMG,0.75
			CASE 3
				TIMES COOP_DMG,1.5
		ENDSELECT
	ENDIF
	;---- EDIT P 003 MOD START -------------------------
	TSTR:COOP해석 += @"/防御・列補正_{COOP_DMG * 100 / 解析用}\%"
	解析用 = MAX(COOP_DMG, 1)
	IF CFLAG:L_TARGET:PT플래그 > 0 && !FLAG:튜토리얼진행중
		SELECTCASE FLAG:전투난이도
			CASE 1
				TIMES COOP_DMG , 0.75
			CASE 3,4
				TIMES COOP_DMG , 1.5
			CASE 5
				TIMES COOP_DMG , 2
			CASE 6
				TIMES COOP_DMG , 3
		ENDSELECT
	ENDIF
	;---- EDIT P 003 MOD END ---------------------------
	TSTR:COOP해석 += @"/難度補正_{COOP_DMG * 100 / 解析用}\%"
	;眠っていたらダメージ大
	SIF CFLAG:L_TARGET:상태이상 == GET_STATE_NUM("SLEEP")
		TIMES COOP_DMG,1.5
	;特殊補正
	COOP_DMG = COOP_DMG * (CFLAG:L_TARGET:COOP피데미지보정 +100) / 100
	;ハントスキル補正
	TRYCCALLFORM ハントスキル_{CFLAG:ARG:입력행동}
		COOP_DMG = COOP_DMG * RESULT / 100
	CATCH
	ENDCATCH
	TSTR:COOP해석 += @"/異常・ハント補正_{COOP_DMG * 100 / 解析用}\%"
	解析用 = MAX(COOP_DMG, 1)
	;特殊補正2
	;---- EDIT 034 MOD -------------------------
	SIF CFLAG:L_TARGET:COOP피데미지제한 > 0 && CFLAG:L_TARGET:COOP피데미지제한 > COOP_DMG
		COOP_DMG = CFLAG:L_TARGET:COOP피데미지제한
		
	;---- EDIT 064 MOD -------------------------
	TSTR:COOP해석 += @"/DMG_{COOP_DMG}"
	PRINTFORM {COOP_DMG}데미지
	CALL VAR_HP,L_TARGET,-COOP_DMG, "ダメージ", ARG
	;---- EDIT 064 MOD -------------------------

	SIF L_TARGET > -1 && CFLAG:L_TARGET:상태이상 == GET_STATE_NUM("SLEEP")
		CFLAG:L_TARGET:상태이상 = 0
	;ダメージを受け、死亡しており、ハントスキルを使われていた場合は被ハントフラグを立てておく
	;IF L_TARGET > -1 && COOP_DMG > 0 && CFLAG:L_TARGET:상태이상 == GET_STATE_NUM("DYING")
	;	TRYCCALLFORM ハントスキル_{CFLAG:ARG:입력행동}
	;		CFLAG:L_TARGET:피헌트 = ARG + 1
	;	CATCH
	;	ENDCATCH
	;ENDIF
	SIF !LINEISEMPTY()
		PRINTL
	;ENDIF
NEXT
WAIT
;---- EDIT 080 ADD END ---------------------------

;====================================================
;COOPでの経験値取得
;ARG = COOP発動者
;====================================================
@ADD_DEVIL_COOP_EXP, ARG
#DIM LCOUNT
#DIM L_FRIEND
#DIM L_ENEMY
#DIM IS_EXIST_COOP_TARGET
#DIM ADD_BY_ENTERTAINER
#DIM CHARM_BY_KILL
SIF CFLAG:ARG:PT플래그 == 0
	RETURN 0

;COOPを受けている敵がいるか確認する
IS_EXIST_COOP_TARGET = 0
FOR LCOUNT, 0, BCHARANUM
	SIF IS_FRIEND(ARG, BCHARA:LCOUNT)
		CONTINUE
	SIF !CFLAG:(BCHARA:LCOUNT):ＣＯＯＰ플래그
		CONTINUE
	IS_EXIST_COOP_TARGET = 1
	BREAK
NEXT
SIF !IS_EXIST_COOP_TARGET
	RETURN 0

ADD_BY_ENTERTAINER = 0
CHARM_BY_KILL = 0
FOR LCOUNT, 1, 7
	L_FRIEND = POS(LCOUNT)
	SIF L_FRIEND < 0
		CONTINUE
	SIF !GET_DEVIL_COOP_MEMBER_RANK(ARG, L_FRIEND)
		CONTINUE
	IF L_FRIEND != MASTER
		IF CFLAG:L_FRIEND:충성도링크 && FINDCHARA_TIMEID(CFLAG:L_FRIEND:피링크캐릭터실제가입시간) >= 0
			CFLAG:FINDCHARA_TIMEID(CFLAG:L_FRIEND:피링크캐릭터실제가입시간):전투중획득충성도 += 20
		ELSE
			CFLAG:L_FRIEND:전투중획득충성도 += 20
		ENDIF
	ENDIF
	;エンターテイナーは数値だけとっておいてあとから加算する
	SIF HAVE_SKILL(L_FRIEND, [[스킬:엔터테이너]])
		ADD_BY_ENTERTAINER += 10
	;魅せる殺戮のフラグ立て
	SIF HAVE_SKILL(L_FRIEND, [[스킬:매혹적인살육]])
		CHARM_BY_KILL = 1
	;PEXPは参加者1点+発動者人数分点
	IF L_FRIEND != ARG
		CALL INCREASE_PERSONA_EXP, ARG, 1, 30
		CALL INCREASE_PERSONA_EXP, L_FRIEND, 1, 30
	ENDIF
NEXT
;魅せる殺戮用
FOR LCOUNT, 1, 7
	L_FRIEND = POS(LCOUNT)
	SIF L_FRIEND < 0
		CONTINUE
	SIF !GET_DEVIL_COOP_MEMBER_RANK(ARG, L_FRIEND)
		CONTINUE
	SIF CFLAG:L_FRIEND:충성도링크 && FINDCHARA_TIMEID(CFLAG:L_FRIEND:피링크캐릭터실제가입시간) >= 0
		L_FRIEND = FINDCHARA_TIMEID(CFLAG:L_FRIEND:피링크캐릭터실제가입시간)
	SIF L_FRIEND != MASTER
		CFLAG:L_FRIEND:전투중획득충성도 += ADD_BY_ENTERTAINER
	SIF CHARM_BY_KILL
		CFLAG:L_FRIEND:매혹적인살육플래그 += 1
NEXT

TRYCCALLFORM ハントスキル_{CFLAG:ARG:입력행동}
	FOR LCOUNT, 0, BCHARANUM
		L_ENEMY = BCHARA:LCOUNT
		SIF IS_FRIEND(ARG, L_ENEMY)
			CONTINUE
		SIF !CFLAG:L_ENEMY:ＣＯＯＰ플래그
			CONTINUE
		SIF !IS_BADSTATE(L_ENEMY, "DYING")
			CONTINUE
		CFLAG:L_ENEMY:피헌트 = ARG + 1
	NEXT
CATCH
ENDCATCH

;====================================================
;COOPのランクをチェック
;ARG 	= COOP発動者
;ARG:1 	= COOP参加者
;
;COOP強化W 不完全一致を完全一致にする
;COOP強化C 発動者と参加者が恋人同士である時に完全一致扱いにする
;====================================================
@GET_DEVIL_COOP_MEMBER_RANK, ARG, ARG:1
#FUNCTION
#DIM DYNAMIC L_RESULT
;属性完全一致は2
SIF ABL:ARG:속성LD == ABL:(ARG:1):속성LD && ABL:ARG:속성LC == ABL:(ARG:1):속성LC
	RETURNF 2
;COOP強化C
SIF COOP_CAPITULATION_CHECK(ARG, ARG:1)
	RETURNF 2

SIF HAVE_PU_SKILL(ARG, "데빌칠드런") && GETS_ROLE_PROP("INSTALLSOFT_EFFECT_TYPE", ARG:1) == "悪魔"
	RETURNF 2
SIF HAVE_PU_SKILL(ARG:1, "데빌칠드런") && GETS_ROLE_PROP("INSTALLSOFT_EFFECT_TYPE", ARG) == "悪魔"
	RETURNF 2
SIF HAVE_PU_SKILL(ARG, "パートナーシップ") && GETS_ROLE_PROP("INSTALLSOFT_EFFECT_TYPE", ARG:1) == "人間"
	RETURNF 2
SIF HAVE_PU_SKILL(ARG:1, "パートナーシップ") && GETS_ROLE_PROP("INSTALLSOFT_EFFECT_TYPE", ARG) == "人間"
	RETURNF 2
SIF HAVE_PU_SKILL(ARG, "シャドウミストレス") && (相性素質チェック_F(ARG:1, GET_SUCCESSION_NUM("파마")) || 相性素質チェック_F(ARG:1, GET_SUCCESSION_NUM("주살")))
	RETURNF 2
SIF HAVE_PU_SKILL(ARG:1, "シャドウミストレス") && (相性素質チェック_F(ARG, GET_SUCCESSION_NUM("파마")) || 相性素質チェック_F(ARG, GET_SUCCESSION_NUM("주살")))
	RETURNF 2

IF ABL:ARG:속성LD == ABL:(ARG:1):속성LD || ABL:ARG:속성LC == ABL:(ARG:1):속성LC
	SIF SOFT_ON("ＣＯ－ＯＰ강화W")
		RETURNF 2
	RETURNF 1
ENDIF
RETURNF 0
