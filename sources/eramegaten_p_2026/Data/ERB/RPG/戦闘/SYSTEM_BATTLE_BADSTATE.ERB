;========================================
;ARG	行動者(キャラ番号)
;ARG:1	対象
;ARG:2	バステ
;-バステ耐性の無効化判定関数
;
;貫通するのは個別のバステ耐性(ABL:CHARA:상태이상)
;========================================
@GET_バステ耐性貫通, ARG, ARG:1, ARG:2
#DIM L_P
#DIM L_T
#DIM L_ステート
#DIMS L_ステート名
L_P = ARG
L_T = ARG:1
L_ステート = ARG:2
L_ステート名 '= GET_STATE(L_ステート)
SIF L_T < 0
	RETURN 0
;烙印時に即死が貫通する
SIF CFLAG:L_T:상태이상 == GET_STATE_NUM("BRAND") && L_ステート名 == "DYING"
	RETURN 1
;呪い時に即死貫通
SIF CFLAG:L_T:상태이상 == GET_STATE_NUM("CURSE") && L_ステート名 == "DYING"
	RETURN 1
RETURN 0