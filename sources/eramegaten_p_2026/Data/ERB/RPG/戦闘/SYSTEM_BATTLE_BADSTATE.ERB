;======================================================================
;バステ解説
;ARG = 番号指定の場合
;ARGS = 名称指定の場合
;
;戻り値 = 解説文。改行コードをいれているので改行込みで帰ってくるが、行としては1行で扱われるのに注意
;
;PRINTしたい場合は@PRINTFORM_LF関数を使ってください
;======================================================================
@BADSTATE_COMMENT, ARG, ARGS = "", ARG:1
#FUNCTIONS
#DIMS L_STATE
#DIMS L_RESULTS;出力文字列
#DIMS L_BR;改行文字
L_STATE = \@ARGS != ""  ? %ARGS% # %GET_STATE(ARG)%\@
;TOOLTIP用は字下げをする
IF ARG:1
	L_BR '= UNICODE(0x000D) + "　"
	L_RESULTS '= "□" + L_STATE + L_BR
ELSE
	L_BR '= UNICODE(0x000D)
	L_RESULTS = 
ENDIF
SELECTCASE L_STATE
	CASE "GOOD"
		L_RESULTS += "상태이상에 걸리지 않은、건강한 상태。"
	CASE "HAPPY"
		L_RESULTS += "행복에 휩싸여 있는 상태。일정 확률로 행동의 실행에 실패한다" + L_BR + "주는 데미지가 감소하고、받는 데미지가 증가한다。"
		;行動不能は50% ダメージはTIMES 1.25 & TIMES 0.70(ver0309144 2022/12/10 確認)
	CASE "SHOCK"
		L_RESULTS += "감전 중인 상태。행동불능이 되고、매우 높은 확률로 크리티컬을 받는다。" + L_BR + "빙결・수격 상성의 공격으로 받는 데미지가 크게 증가한다。"
		;ダメージはTIMES 2.00(ver0309144 2022/12/10 確認)
	CASE "PANIC"
		L_RESULTS += "혼란 중인 상태。랜덤으로 각종 행동을 실행하게 된다。"
	CASE "SLEEP"
		L_RESULTS += "수면 중인 상태。행동 불능이 되고、받는 데미지가 크게 증가하며、매우 높은 확률로 크리티컬을 받는다。" + L_BR + "데미지를 받는 것으로 해제된다。"
		;ダメージはTIMES 1.50(ver0309144 2022/12/10 確認)
	CASE "FREEZE"
		L_RESULTS += "동결 중인 상태。행동불능이 되고、매우 높은 확률로 크리티컬을 받는다。" + L_BR + "전격・지변 상성의 공격으로 받는 데미지가 크게 증가한다。"
		;ダメージはTIMES 2.00(ver0309144 2022/12/10 確認)
	CASE "BIND"
		L_RESULTS += "묶여 있는 상태。행동불능이 된다。"
	CASE "CLOSE"
		L_RESULTS += "침묵 중인 상태。MAGIC이 사용불능이 되고、마법위력이 대폭으로 감소한다。"
		;魔法属性の攻撃のダメージが1/5(ver0309144 2022/12/10 確認)
	CASE "POISON"
		L_RESULTS += "맹독에 당한 상태。턴 종료시 데미지를 받는다。"+ L_BR + "공격력이 반감한다。"
		;物理属性の攻撃のダメージが1/2。継続ダメージは最大HPの1/16(ver0309144 2022/12/10 確認)
	CASE "BOMB"
		L_RESULTS += "폭탄화된 상태。화염 상성의 데미지를 받는 것으로 폭발한다。"
	CASE "CHARM"
		L_RESULTS += "적에게 매료된 상태。아군을 공격하게 된다。"
		;30%の確率でぼーっとする(ver0309144 2022/12/10 確認)
	CASE "PALYZE"
		L_RESULTS += "마비 중인 상태。행동불능이 되고、턴 종료시에 MP에 데미지를 받는다。"
		;MPダメージは最大MPの1/16(ver0309144 2022/12/10 確認)
	CASE "CURSE"
		L_RESULTS += "저주받은 상태。공격을 할 때마다 데미지를 받게 된다。"+ L_BR + "즉사공격에 약해진다。"
		;受けるダメージは与えたダメージの1/2(ver0309144 2022/12/10 確認)
		;即死はDYIING耐性を無視するようになり、固定値で+50%
	CASE "FLY"
		L_RESULTS += "파리가 된 상태。각종 능력치가 파멸적으로 감소한다。"
		;素早さ以外が1になり被ダメージ1.5倍など(ver0309144 2022/12/10 確認)
	CASE "STONE"
		L_RESULTS += "석화 중인 상태。행동불능이 된다" + L_BR + "이 상태이상은 자연회복하지 않는다。"
	CASE "DYING"
		L_RESULTS += "HP가 0이 되어 사망한 상태"
	CASE "ORGY"
		L_RESULTS += "오르기아 모드를 발동한 상태" + L_BR + "자동적으로 행동을 선택하게 되고、주는 데미지가 증가한다。"
		;ダメージはTIMES 1.25される(ver0309144 2022/12/10 確認)
	CASE "HEAT"
		L_RESULTS += "오르기아 모드가 종료되어、쿨다운이 필요한 상태。행동불능이 된다。"
	CASE "FLAME"
		L_RESULTS += "불타고 있는 상태。턴 종료시 데미지를 받는다。"+ L_BR + "핵열・질풍 상성의 공격으로 받는 데미지가 크게 증가한다。"
		;継続ダメージは最大HPの1/10 ダメージボーナスはTIMES 2.00(ver0309144 2022/12/10 確認)
	CASE "SLIP"
		L_RESULTS += "넘어진 상태。행동불능이 된다" + L_BR + "검격・비구・타격・전술・중력 상성의 공격으로 받는 데미지가 크게 증가한다"
		;ダメージはTIMES 1.70 重力攻撃で効果が延長される仕様がある(ver0309144 2022/12/10 確認)
	CASE "BRAND"
		L_RESULTS += "낙인이 찍힌 상태。HP를 회복할 수 없게 되고、즉사공격에 약해진다。"
		;即死攻撃弱体化は呪いと共通(ver0309144 2022/12/10 確認)
	CASEELSE
		RETURNF @"지정미스 ARG = {ARG} ARGS = %ARGS%"
ENDSELECT
RETURNF L_RESULTS
