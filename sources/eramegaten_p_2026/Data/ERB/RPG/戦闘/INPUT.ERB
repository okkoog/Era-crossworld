;==================================================================
;プレイヤーによる行動の入力関係と、ＮＰＣの行動の決定などを行います
;==================================================================


;===================================
;個別コマンド入力
;===================================
@INPUT_COMMAND
#LOCALSIZE 20;MOD 038;300も使ってないんじゃないかな
#DIMS TARGETS
#DIMS L_ACTS
#DIM ACTOR_LENS
#DIM TARGET_LENS
;対象変更できるかどうか
#DIM TARGET_ABLE, 7
#DIM LINE
#DIM LCOUNT
#DIM IS_INPUTABLE
#DIM IS_T_RESERVE,7;控えが対象かどうか

ACTOR_LENS = 18 + GETBIT(FLAG:커스텀게임화면,1) * 21

;---- EDIT 059 MOD START -------------------------
;勝敗をチェック
;非ターン消費系のコマンドを実行後、ここに戻ってくるので
;その際に戦闘が終了していないかチェックして上に送る必要がある
CALL FIGHT_IT_OUT
SIF RESULT
	RETURN 1
;---- EDIT 023 ADD START ---------------------------
;処理する前に、抜ける？
;SIF FLAG:승리플래그 && !FLAG:RESULT스킵
;	RETURN 0
;---- EDIT 023 ADD END ---------------------------
;---- EDIT 059 MOD END ---------------------------
;---- EDIT 058 ADD START -------------------------
;同期処理を行う
CALL SET_LEADER_SKILL
;---- EDIT 058 ADD END ---------------------------
;パーティメンバーの行動内容表示
CALL SHOW_NOW_FORMATION_E,0,2, -1
DRAWLINE
CALL SHOW_NOW_FORMATION_P,0,2, 1
PRINTL
CUSTOMDRAWLINE =
PRINTL 행동을 변경할 캐릭터를 선택해주세요(0으로 전투개시、9로 이전 화면으로 돌아갑니다)
CUSTOMDRAWLINE =
VARSET TARGET_ABLE
;対象
FOR LOCAL,1,7
	TARGETS = 
	LOCALS = 포지션{LOCAL}
	;単体スキル＆列スキルでボタンを作成するように
	IF FLAG:LOCALS > -1
		U = FLAG:LOCALS;ADD 035
		CALL INPUTABLE_CHARA, FLAG:LOCALS
		;---- EDIT 050 TOOLTIP追加			ADD START -------------------------
		IS_INPUTABLE = RESULT
		SIF IS_INPUTABLE == 0
			SETCOLOR COLOR("gray")
		;---- EDIT 050 TOOLTIP追加			ADD END ---------------------------
		
		PRINTFORM [{LOCAL}] %CALLNAME:(FLAG:LOCALS),20,LEFT%
		$YARINAOSI
		CALL INPUTABLE_CHARA, FLAG:LOCALS
		;このタイミングでもう元々の入力行動を拾ってしまう
		LOCAL:(10+LOCAL) = CFLAG:(FLAG:LOCALS):입력행동

		;---- EDIT 052 行動表示関数化		ADD START  -------------------------
		;入力行動の文字列を作成
		CALL GETS_INPUT_COMMAND_ACT, FLAG:LOCALS
		L_ACTS = %SUBSTRING(RESULTS, 0, ACTOR_LENS), ACTOR_LENS, LEFT%
		;対象部分の文字列作成
		CALL GETS_INPUT_COMMAND_TARGET, FLAG:LOCALS, L_ACTS
		;対象不在でさらに対象の振替が出来なかった場合に防御状態にして-1をかえすので行動も変更する
		IF RESULT == -1
			L_ACTS = ＧＵＡＲＤ
			TARGET_ABLE:LOCAL = 0
		ELSE
			IF RESULT
				TARGETS = >>> %RESULTS, TARGET_LENS, LEFT%
				;全体が入ってる場合はターゲット変更の対象にはならない
				IF GROUPMATCH(CFLAG:(FLAG:LOCALS):타겟, 19, 22, 23)
					TARGET_ABLE:LOCAL = 0
				ELSE
					TARGET_ABLE:LOCAL = 1
				ENDIF
			ELSE
				TARGETS = 
				TARGET_ABLE:LOCAL = 0
			ENDIF
		ENDIF
		PRINTBUTTON L_ACTS, LOCAL
		;---- EDIT 052 行動表示関数化		ADD END   -------------------------
		;---- EDIT 050 控え用の処理追加		ADD START -------------------------
		CALL GET_SKILL_PROP, "SKILL_T_RESERVE", CFLAG:(FLAG:LOCALS):입력행동, FLAG:LOCALS
		IS_T_RESERVE:LOCAL = RESULT
		;---- EDIT 052 DEL END ---------------------------
		;自分が行動できるかどうか
		CALL INPUTABLE_CHARA, POS(LOCAL)
		IF RESULT
			IF !TARGET_ABLE:LOCAL
				PRINTPLAINFORM %TARGETS,26,LEFT%　
				SETCOLOR COLOR("gray")
				PRINTFORM [/{LOCAL}]TARGET
				RESETCOLOR
			ELSE
				PRINTBUTTON @"%TARGETS, 26, LEFT%", UNICODE(LOCAL + 1000)
				PRINT 　
				PRINTBUTTON "[/" + TOSTR(LOCAL) + "]TARGET", UNICODE(LOCAL + 1000)
			ENDIF
		ELSE
			PRINTFORM %"　",36,LEFT%
			PRINT 　
		ENDIF
		;自分が行動できるかどうか
		CALL INPUTABLE_CHARA, POS(LOCAL)
		IF RESULT
			PRINT 　
			PRINTBUTTON "[*" + TOSTR(LOCAL) + "]ATTACK", UNICODE(LOCAL + 2000)
			PRINT 　
			PRINTBUTTON "[-" + TOSTR(LOCAL) + "]GUARD", UNICODE(LOCAL + 3000)
			RESETCOLOR

			;---- EDIT 023 ADD START ---------------------------
			IF FLAG:무후후전개 && SOFT_ON("엑스링케이지")
				IF CFLAG:POS(LOCAL):던전내발정용욕정치 >= 10000
					IF BASE:POS(LOCAL):체력 <= 100 || BASE:POS(LOCAL):기력 <= 100
						SETCOLOR COLOR("red")
						PRINT 　[+
						PRINTFORM {LOCAL}]ECSLINK
					ELSE
						PRINT 　
						SETCOLOR COLOR("pink")
						PRINTBUTTON "[+" + TOSTR(LOCAL) + "]ECSLINK", UNICODE(LOCAL + 4000)
					ENDIF
				ELSE
					SETCOLOR COLOR("gray")
					PRINT 　[+
					PRINTFORM {LOCAL}]ECSLINK
				ENDIF
			ENDIF
			;---- EDIT 023 ADD END -----------------------------
			RESETCOLOR

		ELSE
			PRINT 　　　　　　
			PRINT 　　　　　 
		ENDIF
		;---- EDIT 045 MOD START ---------------------------
		IF CFLAG:POS(LOCAL):気合フラグ || CFLAG:POS(LOCAL):타인기합플래그
			IF CFLAG:POS(LOCAL):気合フラグ
				SETCOLOR COLOR("PASTEL-GREEN")
			ELSE
				SETCOLOR COLOR("gray")
			ENDIF
			PRINT  기
			RESETCOLOR
		ELSE
			PRINT  　
		ENDIF
		IF CFLAG:POS(LOCAL):집중플래그 || CFLAG:POS(LOCAL):타인집중플래그
			IF CFLAG:POS(LOCAL):집중플래그
				SETCOLOR COLOR("PASTEL-GREEN")
			ELSE
				SETCOLOR COLOR("gray")
			ENDIF
			SETCOLOR COLOR("PASTEL-GREEN")
			PRINT  집
			RESETCOLOR
		ELSE
			PRINT  　
		ENDIF
		IF CFLAG:POS(LOCAL):꿰뚫는투기
			SETCOLOR COLOR("PASTEL-GREEN")
			PRINT  관
			RESETCOLOR
		ELSE
			PRINT  　
		ENDIF
		;---- EDIT 045 MOD END ---------------------------
		IF CFLAG:POS(LOCAL):회심의패기플래그
			SETCOLOR COLOR("PASTEL-GREEN")
			PRINT  회
			RESETCOLOR
		ELSE
			PRINT  　
		ENDIF
	ELSE
		SETCOLOR COLOR("gray")
		PRINTFORM [{LOCAL}] ＥＭＰＴＹ
	ENDIF
	PRINTL
	RESETCOLOR
NEXT
;---- EDIT 038 MOD START ---------------------------
PRINTL [7] ＬＩＮＫＡＧＥ
;---- EDIT 038 MOD END ---------------------------
PRINTL
DRAWLINE
PRINTL
PRINTL [0] ＧＯ  [9]ＣＡＮＣＥＬ
LINE = LINECOUNT
$INPUT_LOOP
CLEARLINE LINECOUNT - LINE
ONEINPUTS
ENCODETOUNI %RESULTS%
IF RESULTS == "0"
	FOR LOCAL,1,7
		LOCALS = 포지션{LOCAL}
		IF FLAG:LOCALS > -1
			;ＣＨＡＮＧＥ対象フラグ立ってる人に防御フラグ
			CALL INPUTABLE_CHARA,FLAG:LOCALS
			IF RESULT == 1 && CFLAG:(FLAG:LOCALS):ＣＨＡＮＧＥ대상플래그 == 1
				CFLAG:(FLAG:LOCALS):방어플래그 = 1
			ENDIF
			;防御フラグ立ってる人の入力行動を -1 に
			IF CFLAG:(FLAG:LOCALS):방어플래그
				CFLAG:(FLAG:LOCALS):입력행동 = -1
			ENDIF
			;リンケージ参加者は入力行動が-1に
			IF CFLAG:(FLAG:LOCALS):링케이지참가
				CFLAG:(FLAG:LOCALS):입력행동 = -1
				CFLAG:(FLAG:LOCALS):방어플래그 = 0
			ENDIF
		ENDIF
	NEXT
	;コマンド入力終了
	RETURN 1
ELSEIF RANGE(RESULT:1, 1001, 1006) || RESULTS == "/"
	IF RESULTS == "/"
		ONEINPUT
		SIF !RANGE(RESULT, 1, 6)
			GOTO INPUT_LOOP
		LOCAL = RESULT
	ELSE
		LOCAL = RESULT:1 - 1000
	ENDIF
	;---- EDIT 076 MOD START -------------------------
	IF POS(LOCAL) > -1 && !CFLAG:POS(LOCAL):방어플래그 && INPUTABLE_CHARA_F(POS(LOCAL))
	;---- EDIT 076 MOD END ---------------------------
		U = POS(LOCAL)	;ADD 035
		;---- EDIT 050 控え用の処理追加		ADD START -------------------------
		;控えを対象にしている場合
		IF IS_T_RESERVE:LOCAL
			GOTO SELECT_TARGET
		;---- EDIT 050 控え用の処理追加		ADD END ---------------------------
		ELSEIF CFLAG:POS(LOCAL):타겟 == 20
			CALL GET_SKILL_PROP, "SKILL_TARGET", CFLAG:POS(LOCAL):입력행동, POS(LOCAL)
			IF RESULT == 1
				CALL GET_SKILL_PROP, "SKILL_SPHERE", CFLAG:POS(LOCAL):입력행동, POS(LOCAL)
				IF RESULT == 2
					CALL GET_SKILL_PROP, "SKILL_RANGE", CFLAG:POS(LOCAL):입력행동,POS(LOCAL)
					IF (RESULT == 2 && LOCAL < 4) || RESULT > 2
						IF CHECK_BACKROW()
							CFLAG:POS(LOCAL):타겟 = 21
						ENDIF
						
					ENDIF
				ENDIF
			ENDIF
		ELSEIF CFLAG:POS(LOCAL):입력행동 == [[스킬:ＣＨＡＮＧＥ]]
			CALL INPUT_COM_CHANGE, POS(LOCAL)
		;---- EDIT 052 ADD END ---------------------------
		ELSEIF CFLAG:POS(LOCAL):타겟 == 21
			CFLAG:POS(LOCAL):타겟 = 20
		ELSEIF INRANGE(CFLAG:POS(LOCAL):타겟, 1, 16)
			SIF LOCAL:(LOCAL+10) == -1
				GOTO INPUT_LOOP
			$SELECT_TARGET
			CALL SELECT_SKILL_TARGET,LOCAL:(LOCAL+10),POS(LOCAL)
			SIF RESULT == -1
				RESTART
			;対象が死んでて、蘇生スキルでないとき。（蘇生スキルはRESERVEで1が帰ってくるはずなんで、後半の条件から除外
			VARI L_TARGET = RESULT
			CALL GET_SKILL_PROP, "SKILL_T_RESERVE", CFLAG:(POS(LOCAL)):입력행동, POS(LOCAL)
			IF !RESULT
				SIF GET_STATE(CFLAG:POS(L_TARGET):상태이상) == "DYING"
					GOTO SELECT_TARGET
			ENDIF
			CFLAG:POS(LOCAL):타겟 = L_TARGET
			CALL SET_REPEAT_CHARA, POS(LOCAL)
		ELSE
			GOTO INPUT_LOOP
		ENDIF
	ELSE
		GOTO INPUT_LOOP
	ENDIF
	RESTART
ELSEIF INRANGE(RESULT:1, 2001, 2006) || RESULTS == "*"
	IF RESULTS == "*"
		ONEINPUT
		SIF RESULT < 1 || RESULT > 6
			GOTO INPUT_LOOP
		LOCAL = RESULT
	ELSE
		LOCAL = RESULT:1 - 2000
	ENDIF
	IF POS(LOCAL) >= 0
		;---- EDIT 038 MOD START ---------------------------
		IF CFLAG:POS(LOCAL):링케이지참가
			CALL LINKAGE_CANSELL(POS(LOCAL))
			SIF !RESULT
				RESTART
		ENDIF
		;---- EDIT 038 MOD END ---------------------------
		CLEARLINE LINECOUNT - LINE
		
		;---- EDIT 042 MOD START ---------------------------
		LOCAL:1 = CFLAG:POS(LOCAL):입력행동
		LOCAL:2 = CFLAG:POS(LOCAL):타겟
		;---- EDIT 042 MOD END ---------------------------
		
		CALLFORM INPUT_COM_ATTACK, POS(LOCAL)
		
		SIF RESULT == -1 || RESULT == 0
			RESTART
		CFLAG:POS(LOCAL):방어플래그 = 0
		;ＣＨＡＮＧＥ対象フラグと被召喚フラグの修正
		IF LOCAL:1 == [[스킬:ＣＨＡＮＧＥ]]
			SIF POS(LOCAL:2) > -1
				CFLAG:POS(LOCAL:2):ＣＨＡＮＧＥ대상플래그 = 0
		ENDIF
		CALL GET_SKILL_PROP, "SKILL_IS_SUMMON", LOCAL:1, POS(LOCAL)
		IF RESULT
			CFLAG:(CFLAG:POS(LOCAL):소환예정캐릭터):피소환플래그 = 0
			CFLAG:(CFLAG:POS(LOCAL):소환예정캐릭터):소환자ID = -1
			CFLAG:POS(LOCAL):소환예정캐릭터 = -1
		ENDIF
		IF CFLAG:POS(LOCAL):링케이지발동 == 1
			FOR LCOUNT,1,6
				IF CFLAG:POS(LOCAL):("링케이지참가자" + TOSTR(LCOUNT)) > -1
					CFLAG:(CFLAG:POS(LOCAL):("링케이지참가자" + TOSTR(LCOUNT))):링케이지참가 = 0
				ENDIF
			NEXT
			CFLAG:POS(LOCAL):링케이지발동 = 0
		ENDIF
	ENDIF
	RESTART
ELSEIF RANGE(RESULT:1, 3001, 3006) || RESULTS == "-"
	IF RESULTS == "-"
		ONEINPUT
		SIF RESULT < 1 || RESULT > 6
			GOTO INPUT_LOOP
		LOCAL = RESULT
	ELSE
		LOCAL = RESULT:1 - 3000
	ENDIF
	;ＧＵＡＲＤ
	IF POS(LOCAL) >= 0
		;---- EDIT 038 MOD START ---------------------------
		IF CFLAG:POS(LOCAL):링케이지참가
			CALL LINKAGE_CANSELL(POS(LOCAL))
			SIF !RESULT
				RESTART
		ENDIF
		;---- EDIT 038 MOD END ---------------------------
		CFLAG:POS(LOCAL):입력행동 = -1
		CFLAG:POS(LOCAL):방어플래그 = 1
		CALL SET_REPEAT_CHARA, POS(LOCAL)
		;ＣＨＡＮＧＥ対象フラグと被召喚フラグの修正
		IF LOCAL:1 == [[스킬:ＣＨＡＮＧＥ]]
			SIF POS(LOCAL:2) > -1
				CFLAG:POS(LOCAL:2):ＣＨＡＮＧＥ대상플래그 = 0
		ENDIF
		CALL GET_SKILL_PROP, "SKILL_IS_SUMMON", LOCAL:1, POS(LOCAL)
		IF RESULT
			CFLAG:(CFLAG:POS(LOCAL):소환예정캐릭터):피소환플래그 = 0
			CFLAG:(CFLAG:POS(LOCAL):소환예정캐릭터):소환자ID = -1
			CFLAG:POS(LOCAL):소환예정캐릭터 = -1
		ENDIF

		IF CFLAG:POS(LOCAL):링케이지발동 == 1
			FOR LCOUNT,1,6
				IF CFLAG:POS(LOCAL):("링케이지참가자" + TOSTR(LCOUNT)) > -1
					CFLAG:(CFLAG:POS(LOCAL):("링케이지참가자" + TOSTR(LCOUNT))):링케이지참가 = 0
				ENDIF
			NEXT
			CFLAG:POS(LOCAL):링케이지발동 = 0
		ENDIF
	ENDIF
	RESTART
;---- EDIT 023 ADD START ---------------------------
ELSEIF RANGE(RESULT:1, 4001, 4006) || RESULTS == "+"
	SIF !(FLAG:무후후전개) || !SOFT_ON("엑스링케이지")
		RESTART

	IF RESULTS == "+"
		ONEINPUT
		SIF !RANGE(RESULT, 1, 6)
			GOTO INPUT_LOOP
		LOCAL = RESULT
	ELSE
		LOCAL = RESULT:1 - 4000
	ENDIF
	SIF RESULT:1 < 0
		RESTART

	IF POS(LOCAL) >= 0
		SIF CFLAG:POS(LOCAL):던전내발정용욕정치 < 10000 || BASE:POS(LOCAL):체력 <= 100 || BASE:POS(LOCAL):기력 <= 100
			RESTART
		CALLFORM INPUT_COM_ECSLINKAGE,POS(LOCAL)
	ENDIF
	RESTART

;---- EDIT 023 ADD END ---------------------------
ELSEIF RESULTS == "9"
	RETURN 0
;---- EDIT 038 ADD START ---------------------------
ELSEIF RESULTS == "7"
	CALL SHOW_LINKAGE, 2
	SIF RESULT == -1
		RESTART
	;CALL INPUT_COMMAND_P(CPOS(RESULT), 11)
	RESTART
;---- EDIT 038 ADD END ---------------------------
ENDIF
;不正な入力は送り返す
;---- EDIT 023 ADD START ---------------------------
;디버그용
IF FLAG:DEBUG
	IF RESULTS == "$"
		FOR LCOUNT,1,7
			SIF POS(LCOUNT) > -1
				CFLAG:POS(LCOUNT):던전내발정용욕정치 = 10001
		NEXT
		
		RESTART
	ENDIF
ENDIF

;---- EDIT 023 ADD END ---------------------------

SIF !GROUPMATCH(RESULTS, "1", "2", "3", "4", "5", "6")
	GOTO INPUT_LOOP
LOCAL = TOINT(RESULTS)
;キャラ不在なら返す
SIF POS(LOCAL) == -1
	GOTO INPUT_LOOP
;行動可能かどうかのチェック
CALL INPUTABLE_CHARA,POS(LOCAL)
;---- EDIT 038 MOD START ---------------------------
SIF RESULT == 0
	GOTO INPUT_LOOP
IF CFLAG:POS(LOCAL):링케이지참가
	CALL LINKAGE_CANSELL(POS(LOCAL))
	SIF !RESULT
		RESTART
ENDIF

CALL INPUT_COMMAND_P(LOCAL)
RESTART

;キャラ別コマンド選択を関数化。ARG=포지션 ARG:1=コマンド直入れ
@INPUT_COMMAND_P, ARG, ARGS
#LOCALSIZE 7
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_LINE
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC L_COMMAND
#DIMS DYNAMIC SELECT_COMMAND
#DIM DYNAMIC STOCK_入力行動
#DIM DYNAMIC STOCK_ターゲット
#DIM DYNAMIC STOCK_召喚予定キャラ
#DIM DYNAMIC STOCK_防御フラグ
#DIM DYNAMIC STOCK_REDRAW
SIF !INRANGE(ARG, 1, 6)
	RETURN 0
;キャラ不在なら返す
SIF POS(ARG) == -1
	RETURN 0
;行動可能かどうかのチェック
CALL INPUTABLE_CHARA,POS(ARG)
SIF RESULT == 0 || CFLAG:POS(ARG):링케이지참가
	RETURN 0
L_CHARA = POS(ARG)
L_COMMAND '= ARGS

STOCK_REDRAW = CURRENTREDRAW()
TSTR:입력시구상_시추에이션_직전행동 '= ""
$START
REDRAW STOCK_REDRAW
STOCK_防御フラグ = CFLAG:L_CHARA:방어플래그
CFLAG:L_CHARA:방어플래그 = 0

STOCK_入力行動 = CFLAG:L_CHARA:입력행동
STOCK_ターゲット = CFLAG:L_CHARA:타겟
STOCK_召喚予定キャラ = CFLAG:L_CHARA:소환예정캐릭터

L_LINE = LINECOUNT
WHILE 1
	CLEARLINE LINECOUNT - L_LINE
	CFLAG:L_CHARA:방어플래그 = STOCK_防御フラグ
	IF L_COMMAND != ""
		SELECT_COMMAND '= L_COMMAND
	ELSE
		;敵味方の表示
		CALL SHOW_NOW_FORMATION_E,0,2, -1, "BATTLE_MAIN"
		DRAWLINE
		CALL SHOW_NOW_FORMATION_P,0,2, 0, "戦闘中_個別入力"
		CALL KOJO_BATTLE_INPUT_COMMAND, L_CHARA
		IF RESULT == 0
			PRINTFORML %조사처리(CALLNAME:L_CHARA, "는")% 어떻게 할까？
			PRINTL 
			PRINTL 
			PRINTL 
		ENDIF
		DRAWLINE
		U = L_CHARA	;ADD 035
		CALL SHOW_COMMAND_LIST,L_CHARA
		;コマンドを入力
		INPUTS
		CLEARLINE 1
		IF ISNUMERIC(RESULTS)
			RESULT = TOINT(RESULTS)
			SIF RESULT == 0
				RETURN 1
			SIF !INRANGE(RESULT, 1, VARSIZE("COMMAND_LIST_P") - 1)
				CONTINUE
			SIF UNABLE_COMMAND_LIST_P:RESULT
				CONTINUE
			SIF COMMAND_LIST_P:RESULT == ""
				CONTINUE
			SELECT_COMMAND '= COMMAND_LIST_P:RESULT
			TSTR:입력시구상_시추에이션_직전행동 '= SELECT_COMMAND
		ELSE
			IF CHARATU(RESULTS, 0) == "." && INRANGE(TOINT(CHARATU(RESULTS, 1)), 1, 6) && CHARATU(RESULTS, 2) == ""
				RESULT = TOINT(CHARATU(RESULTS, 1))
				SIF POS(RESULT) < 0
					CONTINUE
				SIF !INPUTABLE_CHARA_F(POS(RESULT))
					CONTINUE
				REDRAW 0
				L_CHARA = POS(RESULT)
				HTML_PRINT_ISLAND  @"<div xpos = '0' ypos = '0' width = '{CLIENTWIDTH()}px' height = '{CLIENTHEIGHT()}px' display = 'absolute-lefttop' background_color = '%TOSTR_HTML(GETBGCOLOR())%'>" + "</div>"
				TWAIT 200, 1
				HTML_PRINT_ISLAND_CLEAR
				GOTO START
			ELSE
				CONTINUE
			ENDIF
		ENDIF
	ENDIF
	
	CALLFORM INPUT_COM_%SELECT_COMMAND%,L_CHARA
	SIF RESULT == 1
		BREAK
	;交代が発生していた場合の措置
	IF RESULT == -2
		VARI CHANGE_CHARA = RESULT:1
		CALL リンケージ破棄確認, L_CHARA
		L_CHARA = CHANGE_CHARA
		GOTO START
	ENDIF
WEND
;SELECT_COMMANDがリンケージでないのにリンケージ発動フラグが立っていたら、リンケージをキャンセル
IF SELECT_COMMAND != "LINKAGE"
	IF CFLAG:L_CHARA:링케이지발동 == 1
		FOR LCOUNT,1,6
			IF CFLAG:L_CHARA:("링케이지참가자" + TOSTR(LCOUNT)) > -1
				CFLAG:(CFLAG:L_CHARA:("링케이지참가자" + TOSTR(LCOUNT))):링케이지참가 = 0
				CALL SET_REPEAT_CHARA, CFLAG:L_CHARA:("링케이지참가자" + TOSTR(LCOUNT)), -1
				CFLAG:(CFLAG:L_CHARA:("링케이지참가자" + TOSTR(LCOUNT))):방어플래그 = 1
			ENDIF
		NEXT
		CFLAG:L_CHARA:링케이지발동 = 0
	ENDIF
ENDIF

;ＣＨＡＮＧＥ対象フラグと被召喚フラグの修正
IF STOCK_入力行動 == [[스킬:ＣＨＡＮＧＥ]]
	IF (CFLAG:L_CHARA:입력행동 != [[스킬:ＣＨＡＮＧＥ]] || CFLAG:L_CHARA:방어플래그 == 1) && POS(STOCK_ターゲット) > -1
		CFLAG:POS(STOCK_ターゲット):ＣＨＡＮＧＥ대상플래그 = 0
	ELSE
		IF STOCK_ターゲット != CFLAG:L_CHARA:타겟 && POS(STOCK_ターゲット) > -1
			CFLAG:POS(STOCK_ターゲット):ＣＨＡＮＧＥ대상플래그 = 0
		ENDIF
	ENDIF
ENDIF
CALL GET_SKILL_PROP, "SKILL_IS_SUMMON", STOCK_入力行動, L_CHARA
IF RESULT
	IF CFLAG:L_CHARA:입력행동 != STOCK_入力行動 || CFLAG:L_CHARA:방어플래그 == 1
		CFLAG:(STOCK_召喚予定キャラ):피소환플래그 = 0
		CFLAG:(STOCK_召喚予定キャラ):소환자ID = -1
		CFLAG:L_CHARA:소환예정캐릭터 = -1
	ELSE
		IF STOCK_召喚予定キャラ != CFLAG:L_CHARA:소환예정캐릭터
			CFLAG:(STOCK_召喚予定キャラ):피소환플래그 = 0
			CFLAG:(STOCK_召喚予定キャラ):소환자ID = -1
		ENDIF
	ENDIF
ENDIF
;非所持スキルのフォロー
IF CFLAG:L_CHARA:입력행동 == [[스킬:비소지스킬]] && CSTR:L_CHARA:비소지스킬 == ""
	CFLAG:L_CHARA:입력행동 = -1
	CFLAG:L_CHARA:방어플래그 = 1
ENDIF
RETURN 1

;=========================================================
;個別コマンドリストの表示
;=========================================================
@SHOW_COMMAND_LIST,ARG
#DIM DYNAMIC LCOUNT
#DIMS SHOW_COMMAND_LIST_P, 6
VARSET SHOWLINE
VARSET COMMAND_LIST_P
VARSET SHOW_COMMAND_LIST_P
VARSET UNABLE_COMMAND_LIST_P
FOR LCOUNT, 0, VARSIZE("COMMAND_LIST_P")
	CALL PUSH_COMMAND_LIST_P, "COM_" + TOSTR(LCOUNT), ARG, SHOW_COMMAND_LIST_P
NEXT

FOR LCOUNT, 0, TRYSKILLNUM(ARG)
	SIF GET_TRYSKILL(ARG, LCOUNT) == "0"
		CONTINUE
	CALL PUSH_COMMAND_LIST_P, GET_TRYSKILL(ARG, LCOUNT), ARG, SHOW_COMMAND_LIST_P
NEXT

FOR LCOUNT, 0, TRYSKILLNUM(ARG)
	SIF GET_TRYSKILL(ARG, LCOUNT) == "0"
		CONTINUE
	RESULTS '= ""
	TRYCCALLFORM DISPLAY_COMMAND_P_%GET_TRYSKILL(ARG, LCOUNT)%, ARG
		SIF !RESULT
			CONTINUE
		SIF SHOW_COMMAND_LIST_P:RESULT != ""
			SHOW_COMMAND_LIST_P:RESULT += "<br>"
		SHOW_COMMAND_LIST_P:RESULT += RESULTS
	CATCH
	ENDCATCH
NEXT

VARI L_X = 0
VARS SHOWLINE = ""
VARI COUNT_ROW = 7
FOR LCOUNT, 0, VARSIZE("SHOW_COMMAND_LIST_P")
	SIF SHOW_COMMAND_LIST_P:LCOUNT == ""
		CONTINUE
	SHOWLINE += @"<div xpos = '{L_X}' ypos = '0'>" + SHOW_COMMAND_LIST_P:LCOUNT + "</div>"
	COUNT_ROW = MAX(COUNT_ROW, STRCOUNT(SHOW_COMMAND_LIST_P:LCOUNT, "<br>"))
	L_X += 50 * 25
NEXT
HTML_PRINT SHOWLINE
FOR LCOUNT, 0, COUNT_ROW
	PRINTL 
NEXT

CALL SKILLGAGE_DISPLAY,ARG
DRAWLINE
PRINTL [ 0] ＣＡＮＣＥＬ

@PUSH_COMMAND_LIST_P, ARGS, L_CHARA, SHOW_COMMAND_LIST_P
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC SHOW_COMMAND
#DIMS DYNAMIC L_COMMAND
#DIMS DYNAMIC L_COLOR
#DIM DYNAMIC COUNT_COMMAND = 1
#DIMS REF SHOW_COMMAND_LIST_P
;ひとつの関数から複数択を出す場合はCOMMAND_LIST_NAME関数を使う
VARSET COMMAND_LIST_NAME
VARSET COMMAND_LIST_SHOWNAME
VARSET COMMAND_LIST_COLOR
VARSET COMMAND_LIST_UNABLE
VARSET COMMAND_LIST_TITLE
VARSET COMMAND_LIST_CATEGORY
VARSET RESULTS, "", 0, 3
TRYCCALLFORM INPUT_COM_NAME_%ARGS%, L_CHARA
	;単一ならRESULTSでよい
	IF COMMAND_LIST_NAME:0 == ""
		COMMAND_LIST_NAME:0 '= RESULTS
		COMMAND_LIST_SHOWNAME:0 '= RESULTS:1
		COMMAND_LIST_COLOR:0 '= RESULTS:2
		COMMAND_LIST_CATEGORY:0 = RESULT
	ENDIF
	FOR LCOUNT, 0, VARSIZE("COMMAND_LIST_NAME")
		SIF COMMAND_LIST_NAME:LCOUNT == ""
			CONTINUE
		VARSET RESULTS, "", 1, 3
		IF LCOUNT > 0
			TRYCCALLFORM INPUT_COM_NAME_%COMMAND_LIST_NAME:LCOUNT%, L_CHARA
				COMMAND_LIST_SHOWNAME:LCOUNT '= RESULTS:1
				COMMAND_LIST_COLOR:LCOUNT '= RESULTS:2
				COMMAND_LIST_CATEGORY:LCOUNT = RESULT
			CATCH
			ENDCATCH
		ENDIF
		RESULTS '= ""
		TRYCCALLFORM INPUT_COM_ABLE_%COMMAND_LIST_NAME:LCOUNT%, L_CHARA
			SIF RESULT == 0
				CONTINUE
			IF RESULT == -1
				COMMAND_LIST_UNABLE:LCOUNT = 1
				COMMAND_LIST_TITLE:LCOUNT '= RESULTS
			ENDIF
		CATCH
		ENDCATCH
		COUNT_COMMAND = FINDELEMENT(COMMAND_LIST_P, "", 1, , 1)
		COMMAND_LIST_P:COUNT_COMMAND '= COMMAND_LIST_NAME:LCOUNT
		SIF COMMAND_LIST_UNABLE:LCOUNT
			UNABLE_COMMAND_LIST_P:COUNT_COMMAND = 1
		SIF COMMAND_LIST_SHOWNAME:LCOUNT == ""
			CONTINUE
		IF STRCOUNT(COMMAND_LIST_SHOWNAME:LCOUNT, "</button>") 
			SHOW_COMMAND '= COMMAND_LIST_SHOWNAME:LCOUNT
		ELSE
			SHOW_COMMAND '= @"[{COUNT_COMMAND, 2}]" + " " + COMMAND_LIST_SHOWNAME:LCOUNT
			SHOW_COMMAND '= SET_BUTTON_TAG(SHOW_COMMAND, TOSTR(COUNT_COMMAND), COMMAND_LIST_TITLE:LCOUNT)
		ENDIF
		IF !STRCOUNT(SHOW_COMMAND, "</font>")
			IF COMMAND_LIST_UNABLE:LCOUNT
				SHOW_COMMAND '= SET_COLOR_TAG(SHOW_COMMAND, "DARK-GRAY")
			ELSEIF COMMAND_LIST_COLOR:LCOUNT != "" 
				SHOW_COMMAND '= SET_COLOR_TAG(SHOW_COMMAND, COMMAND_LIST_COLOR:LCOUNT)
			ENDIF
		ENDIF
		SIF SHOW_COMMAND_LIST_P:(COMMAND_LIST_CATEGORY:LCOUNT) != ""
			SHOW_COMMAND_LIST_P:(COMMAND_LIST_CATEGORY:LCOUNT) += "<br>"
		SHOW_COMMAND_LIST_P:(COMMAND_LIST_CATEGORY:LCOUNT) += SHOW_COMMAND
	NEXT
	RETURN 1
CATCH
	RETURN 0
ENDCATCH
@INPUT_COM_DO_SKILL, ARG, SELECT_SKILL_CATEGORY_LIST = "데빌암즈/EX/MA/CS", IS_UNABLE_FUNC, DIRECT_SELECT_SKILL = -1
#DIM DIRECT_SELECT_SKILL
#DIM DYNAMIC L_SKILL
#DIMS DYNAMIC SELECT_SKILL_CATEGORY_LIST
#DIMS DYNAMIC IS_UNABLE_FUNC
;---- EDIT 070 ADD START -------------------------
U = ARG
;---- EDIT 070 ADD END ---------------------------
IF DIRECT_SELECT_SKILL >= 0
	L_SKILL = DIRECT_SELECT_SKILL
	GOTO DIRECT_SELECT
ENDIF
$INPUT_SKILL_LOOP1
CALL SHOW_SKILL_LIST, ARG, SELECT_SKILL_CATEGORY_LIST, IS_UNABLE_FUNC
INPUT
TOOLTIP_SETDELAY FLAG:디폴트툴팁시간
IF !RESULT
	RETURN -1
;---- EDIT 057 オプション追加 MOD START -------------------------
ELSEIF GROUPMATCH(RESULT, 96, 97, 98, 99)
	IF RESULT == 96
		OPT_SHOW_SKILLLENS = !OPT_SHOW_SKILLLENS
	ELSEIF RESULT == 97
		OPT_SHOW_SKILL_NUM--
	ELSEIF RESULT == 98
		OPT_SHOW_SKILL_NUM++
	ELSEIF RESULT == 99
		OPT_SHOW_SKILL_SELECT = !OPT_SHOW_SKILL_SELECT
	ENDIF
	OPT_SHOW_SKILL_NUM = LIMIT(OPT_SHOW_SKILL_NUM, 2, LINELENS() / (SKILLNAMELENS:OPT_SHOW_SKILLLENS + 16))
	SAVEGLOBAL
	GOTO INPUT_SKILL_LOOP1
;---- EDIT 057 オプション追加 MOD END ---------------------------
;ELSEIF ((TALENT:ARG:이능자 || TALENT:ARG:달인 || TALENT:ARG:인수라 || TALENT:ARG:Aion식소환술) && INRANGE(RESULT, 1, FLAG:이능자스킬수)) ||(TALENT:ARG:이능자 == 0 && TALENT:ARG:달인 == 0 && TALENT:ARG:인수라 == 0 && INRANGE(RESULT, 1, FLAG:스킬수)) || INRANGE(RESULT, 21, 42)
ELSE
	L_SKILL = 0
	SIF INRANGE(RESULT, 1, CHARA_SKILLCOUNT(ARG))
		L_SKILL = ABL:ARG:@"스킬{RESULT}"
	SIF INRANGE(RESULT, 21, 21 + HAVEABLE_EQ_SKILLNUM)
		L_SKILL = ABL:ARG:@"장비스킬{RESULT > 20 ? RESULT - 20 # RESULT}"
	;有効なスキルが選ばれてなかったのでループへ
	SIF !L_SKILL
		GOTO INPUT_SKILL_LOOP1
	$DIRECT_SELECT
	CALL IS_ABLE_INPUT_COM_SKILL, ARG, L_SKILL, SELECT_SKILL_CATEGORY_LIST, IS_UNABLE_FUNC
	IF RESULT <= 0
		SIF DIRECT_SELECT_SKILL >= 0
			RETURN 0
		GOTO INPUT_SKILL_LOOP1
	ENDIF
	DRAWLINE
	SIF FLAG:스킬속성표시설정
		CALL SKILL_EXPLAIN_PERFORMANCE, L_SKILL, ARG
	;スキル使用者を一文字関数Uに入れておく
	U = ARG
	CALL GET_SKILL_PROP, "SKILL_EXPLAIN", L_SKILL, ARG
	CALL SELECT_SKILL_TARGET, L_SKILL, ARG
	IF RESULT == -1
		SIF DIRECT_SELECT_SKILL >= 0
			RETURN 0
		GOTO INPUT_SKILL_LOOP1
	ENDIF
	RETURN L_SKILL, RESULT
ENDIF

