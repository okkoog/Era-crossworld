IF L_ACT >= 0
	CALL GET_SKILL_PROP, "SKILL_DECIDE_TYPE", L_ACT, L_ACTOR
	;アシストスキルはセットしない
	SIF GET_SKILL_DECIDE_TYPE(RESULT) == "AS"
		RETURN 0
	;---- EDIT P 001 ADD START -------------------------
	;マガツヒスキルセットしない
	SIF L_ACT == [[스킬:마가츠히스킬]]
		RETURN 0
