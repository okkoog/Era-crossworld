	ARRAYSHIFT C_REPEAT_NOT_HAVE_SKILL:L_ACTOR:0, 1, CSTR:L_ACTOR:비소지스킬
ELSE
	ARRAYSHIFT C_REPEAT_NOT_HAVE_SKILL:L_ACTOR:0, 1, ""
ENDIF
ARRAYSHIFT C_REPEAT_TARGET:L_ACTOR:0, 1, L_TARGET

;リンケージの処理(手動シフト)
FOR LCOUNT, VARSIZE("C_REPEAT_SKILL") -1, 0, -1
	FOR LCOUNT:1, 0, 5
		C_REPEAT_LINKAGE_MEMBER:L_ACTOR:LCOUNT:(LCOUNT:1) = C_REPEAT_LINKAGE_MEMBER:L_ACTOR:(LCOUNT-1):(LCOUNT:1)
	NEXT
NEXT
FOR LCOUNT, 0, 5
	C_REPEAT_LINKAGE_MEMBER:L_ACTOR:0:LCOUNT = 0
NEXT
IF INRANGE(L_ACT, MIN_LINKAGENUM, MAX_LINKAGENUM)
	FOR LCOUNT, 0, 5
		SIF CFLAG:L_ACTOR:@"링케이지참가자{LCOUNT + 1}" > 0
			C_REPEAT_LINKAGE_MEMBER:L_ACTOR:0:LCOUNT = CFLAG:(CFLAG:L_ACTOR:@"링케이지참가자{LCOUNT + 1}"):실제가입시간
	NEXT
ENDIF

RETURN 1
