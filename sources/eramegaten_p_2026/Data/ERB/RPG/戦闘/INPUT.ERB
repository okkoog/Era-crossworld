			PRINTFORML ┃%"GO!",72,LEFT%┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			SIF SOFT_ON("너스・콜")
				CALL VAR_HP,L_SUMMON_CHARA,MAXBASE:L_SUMMON_CHARA:ＨＰ * 6 / 10,"회복"
		ELSE
			PRINTFORMW %CALLNAME:L_SUMMON_CHARA%(이)가 소환되었다!
		ENDIF
		IF CFLAG:L_SUMMON_CHARA:PT플래그 > 0 && ABL:L_SUMMON_CHARA:종족 != 0
			CALL CONTROL_MAG, MASTER, -MAXBASE:L_SUMMON_CHARA:￥
		ENDIF
		;---- EDIT P MOD END ---------------------------
		RESETCOLOR
