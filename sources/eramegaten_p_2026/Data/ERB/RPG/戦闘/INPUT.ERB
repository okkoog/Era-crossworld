RETURNF 1

@CHECK_BACKROW
#FUNCTION
#DIM L_COUNT
;後列に敵が居るかチェック
FOR L_COUNT, 12, 17
	LOCALS = 포지션{L_COUNT}
	IF FLAG:LOCALS > -1 && CFLAG:(FLAG:LOCALS):상태이상 != GET_STATE_NUM("DYING")
		RETURNF 1
	ENDIF
NEXT
RETURNF 0

;====================================================
;ターゲットの存在確認
;指定した範囲内にターゲット可能なキャラクターが存在しているかを取得する
;
;ARG		確認するターゲット
;RESULT		真偽値
;====================================================
@IS_EXIST_ターゲット, ARG
#FUNCTION
#DIM LCOUNT
#DIM TPOS_MIN
#DIM TPOS_MAX
SELECTCASE ARG
	CASE 1 TO 16
		SIF POS(ARG) < 0
			RETURNF 0
		SIF CFLAG:POS(ARG):공격대상제외
			RETURNF 0
		SIF CFLAG:POS(ARG):공격대상제외_ACT
			RETURNF 0
		RETURNF 1
	CASE 17
		TPOS_MIN = 1
		TPOS_MAX = 4
	CASE 18
		TPOS_MIN = 4
		TPOS_MAX = 7
	CASE 19
		TPOS_MIN = 1
		TPOS_MAX = 7
	CASE 20
		TPOS_MIN = 7
		TPOS_MAX = 12
	CASE 21
		TPOS_MIN = 12
		TPOS_MAX = 17
	CASE 22
		TPOS_MIN = 7
		TPOS_MAX = 17
	CASE 23
		TPOS_MIN = 1
		TPOS_MAX = 17
	CASEELSE
		LCOUNT = -1
		STR:LCOUNT = ※ターゲットの値が不正です
ENDSELECT
FOR LCOUNT, TPOS_MIN, TPOS_MAX
	SIF POS(LCOUNT) < 0
		CONTINUE
	RETURNF 1
NEXT
RETURNF 0

;===============================================
;行動対象のランダム決定
;===============================================
@RANDOM_TARGET,ARG,ARG:1
#DIM LCOUNT,2
#DIM ACTOR_POS
#DIM L_TARGET_TYPE
#DIM L_RANGE
#DIM L_SPHERE
#DIM L_T_RESERVE
#DIM L_TARGET_TABLE, 1700
#DIM TEMP
#DIM STOCK_U

CFLAG:ARG:타겟 = -1

STOCK_U = U
;LCOUNT = U;037
U = ARG;037

CALL GET_SKILL_PROP, "SKILL_TARGET", ARG:1, ARG
L_TARGET_TYPE = RESULT
IF GROUPMATCH(L_TARGET_TYPE, 1, 2)
	;混乱している場合、対象判定が確率で入れ替わる
	SIF IS_BADSTATE(ARG, "PANIC") && !HAVE_PANIC_RESISTANCE(ARG)
		L_TARGET_TYPE = RAND(1, 3)
	;魅了されている場合、対象判定が入れ替わる
	SIF IS_BADSTATE(ARG, "CHARM")
		L_TARGET_TYPE = L_TARGET_TYPE == 1 ? 2 # 1
ENDIF

CALL GET_SKILL_PROP, "SKILL_SPHERE", ARG:1,ARG
L_SPHERE = RESULT
CALL GET_SKILL_PROP, "SKILL_RANGE", ARG:1, ARG
L_RANGE = RESULT
CALL GET_SKILL_PROP, "SKILL_T_RESERVE", ARG:1, ARG
L_T_RESERVE = RESULT

;単体蘇生
CALL GET_SKILL_PROP, "SKILL_IS_RESUSCITATION", ARG:1, ARG
IF RESULT
	;単体蘇生対象が存在するかチェック
	CALL CHECK_TARGET_RESUSCITATION, ARG
	CFLAG:ARG:타겟 = RESULT
	RETURN RESULT != -1
ENDIF

;---- EDIT 058 ADD START ---------------------------
ACTOR_POS = CFLAG:ARG:피소환플래그? CPOS(FINDCHARA_ID(CFLAG:ARG:소환자ID)) # CPOS(ARG)
;---- EDIT 058 ADD END -----------------------------
SELECTCASE GET_SKILL_TARGET(L_TARGET_TYPE)
	;対象が使用者の敵
	CASE "적"
		SELECTCASE GET_SPHERE(L_SPHERE)
			;単体 / 縦列
			CASE "단체", "세로열"
				;狙える敵を確認してリストに入れる。
				VARSET L_TARGET_TABLE
				FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:PT플래그 ? 22 # 19), GET_POS_MAX(CFLAG:ARG:PT플래그 ? 22 # 19) + 1
					SIF !IS_TARGET_ABLE(POS(LCOUNT))
						CONTINUE
					;後列を狙えない場合は後列をリストに入れない
					SIF GROUPMATCH(L_RANGE, 1, 2) && !IS_FRONT(POS(LCOUNT))
						CONTINUE
					;---- EDIT 065 MOD START -------------------------
					;ターゲット条件を確認
					CALL GET_SKILL_PROP, "SKILL_TARGETABLE", ARG:1, ARG, L_T_RESERVE ? POS(LCOUNT) # LCOUNT
					SIF !RESULT
						CONTINUE
					;効果の有無を確認
					;---- EDIT 067 MOD START -------------------------
					TRYCCALLFORM SKILL_IS_VALID_TARGET_{ARG:1}, L_T_RESERVE ? POS(LCOUNT) # LCOUNT, ARG
					;---- EDIT 067 MOD END ---------------------------
						SIF !RESULT
							CONTINUE
					CATCH
					ENDCATCH
					;---- EDIT P 001 ADD START -------------------------
					VARI L_TAUNT_STRENGTH = 100
					SIF CFLAG:POS(LCOUNT):피타겟비율변동지속턴수 > 0
						L_TAUNT_STRENGTH = L_TAUNT_STRENGTH * CFLAG:POS(LCOUNT):변동피타겟율 / 100
					L_TAUNT_STRENGTH = L_TAUNT_STRENGTH * CFLAG:POS(LCOUNT):기본피타겟율 / 100
					L_TAUNT_STRENGTH = LIMIT(L_TAUNT_STRENGTH / 10 + (L_TAUNT_STRENGTH % 10 > RAND:10), 1, 100)
					DEBUGPRINTFORML [{LCOUNT}] %CALLNAME:POS(LCOUNT)%, L_TAUNT_STRENGTH = {L_TAUNT_STRENGTH}
					FOR LCOUNT:1, 0, L_TAUNT_STRENGTH
						L_TARGET_TABLE:FINDELEMENT(L_TARGET_TABLE, 0) = LCOUNT
					NEXT
					;---- EDIT P 001 ADD END ---------------------------
					;---- EDIT 065 MOD END ---------------------------
				NEXT
				SIF MAXARRAY(L_TARGET_TABLE)
					CFLAG:ARG:타겟 = L_TARGET_TABLE:RAND(FINDELEMENT(L_TARGET_TABLE, 0))
			;列
			CASE "일렬"
				CFLAG:ARG:타겟 = CFLAG:ARG:PT플래그 ? 20 # 17
				;---- EDIT 069 MOD START -------------------------
				TEMP = 0
				;前列をチェック
				FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:타겟), GET_POS_MAX(CFLAG:ARG:타겟) + 1
					SIF !IS_TARGET_ABLE(POS(LCOUNT))
						CONTINUE
					TEMP = 1
					BREAK
				NEXT
				;後列を狙えるスキルは1/2の確率で後列振替をチェック(前列不在なら確定)
				IF !GROUPMATCH(L_RANGE, 1, 2)
					IF RAND:2 || TEMP == 0
						FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:타겟 + 1), GET_POS_MAX(CFLAG:ARG:타겟 + 1) + 1
							SIF !IS_TARGET_ABLE(POS(LCOUNT))
								CONTINUE
							CFLAG:ARG:타겟 += 1
							TEMP = 1
							BREAK
						NEXT
					ENDIF
				ENDIF
				;ターゲットを取れなかった場合
				SIF !TEMP
					CFLAG:ARG:타겟 = -1
				;---- EDIT 069 MOD END ---------------------------
			;全体
			CASE "전체"
				CFLAG:ARG:타겟 = CFLAG:ARG:PT플래그 ? 22 # 19
			;敵味方
			CASE "적아군전체"
				CFLAG:ARG:타겟 = 23
		ENDSELECT
	;対象が使用者の味方
	CASE "아군"
		SELECTCASE GET_SPHERE(L_SPHERE)
			;単体 / 縦列
			CASE "단체", "세로열"
				;狙える敵を確認してリストに入れる。
				VARSET L_TARGET_TABLE
				FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:PT플래그 ? 19 # 22), GET_POS_MAX(CFLAG:ARG:PT플래그 ? 19 # 22) + 1
					SIF !IS_TARGET_ABLE(POS(LCOUNT))
						CONTINUE
					;ターゲット条件を確認
					CALL GET_SKILL_PROP, "SKILL_TARGETABLE", ARG:1, ARG, L_T_RESERVE ? POS(LCOUNT) # LCOUNT
					SIF !RESULT
						CONTINUE
					;効果の有無を確認
					;---- EDIT 067 MOD START -------------------------
					TRYCCALLFORM SKILL_IS_VALID_TARGET_{ARG:1}, L_T_RESERVE ? POS(LCOUNT) # LCOUNT, ARG
					;---- EDIT 067 MOD END ---------------------------
						SIF !RESULT
							CONTINUE
					CATCH
					ENDCATCH
					L_TARGET_TABLE:FINDELEMENT(L_TARGET_TABLE, 0) = LCOUNT
				NEXT
				
				IF MAXARRAY(L_TARGET_TABLE)
					CFLAG:ARG:타겟 = L_TARGET_TABLE:RAND(FINDELEMENT(L_TARGET_TABLE, 0))
					;控え対象行動はキャラ番号を入れる
					SIF L_T_RESERVE
						CFLAG:ARG:타겟 = POS(CFLAG:ARG:타겟)
				ENDIF
			;列
			CASE "일렬"
				;---- EDIT 069 MOD START -------------------------
				CFLAG:ARG:타겟 = CFLAG:ARG:PT플래그 ? 17 # 20
				TEMP = 0
				;前列をチェック
				FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:타겟), GET_POS_MAX(CFLAG:ARG:타겟) + 1
					SIF !IS_TARGET_ABLE(POS(LCOUNT))
						CONTINUE
					TEMP = 1
					BREAK
				NEXT
				;1/2の確率で後列振替をチェック
				IF RAND:2 || !TEMP
					FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:타겟 + 1), GET_POS_MAX(CFLAG:ARG:타겟 + 1) + 1
						SIF !IS_TARGET_ABLE(POS(LCOUNT))
							CONTINUE
						CFLAG:ARG:타겟 += 1
						TEMP = 1
						BREAK
					NEXT
				ENDIF
				SIF !TEMP
					CFLAG:ARG:타겟 = -1
				;---- EDIT 069 MOD END ---------------------------
			;全体
			CASE "전체"
				CFLAG:ARG:타겟 = CFLAG:ARG:PT플래그 ? 19 # 22
			;敵味方
			CASE "적아군전체"
				CFLAG:ARG:타겟 = 23
		ENDSELECT
	;場全体 / 特殊
	CASE "전투전체", "특수", "자신"
		CFLAG:ARG:타겟 = 23
ENDSELECT
;---- EDIT 065 MOD START -------------------------
;範囲攻撃はここでターゲット条件を確認する
IF INRANGE(CFLAG:ARG:타겟, 17, 23) && !(L_T_RESERVE && CFLAG:ARG:PT플래그) 
	TEMP = 0
	FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:타겟), GET_POS_MAX(CFLAG:ARG:타겟) + 1
		;ターゲット条件を確認
		CALL GET_SKILL_PROP, "SKILL_TARGETABLE", ARG:1, ARG, LCOUNT
		IF RESULT
			TEMP = 1
			BREAK
		ENDIF
	NEXT
	SIF TEMP == 0
		CFLAG:ARG:타겟 = -1
ENDIF
;範囲攻撃はここで効果を確認する
IF INRANGE(CFLAG:ARG:타겟, 17, 23) && !(L_T_RESERVE && CFLAG:ARG:PT플래그) 
	TEMP = 0
	FOR LCOUNT, GET_POS_MIN(CFLAG:ARG:타겟), GET_POS_MAX(CFLAG:ARG:타겟) + 1
		;ターゲット条件を確認
		;---- EDIT 067 MOD START -------------------------
		TRYCCALLFORM SKILL_IS_VALID_TARGET_{ARG:1}, LCOUNT,ARG
		;---- EDIT 067 MOD END ---------------------------
			IF RESULT
				TEMP = 1
				BREAK
			ENDIF
		CATCH
			TEMP = 1
			BREAK
		ENDCATCH
	NEXT
	SIF TEMP == 0
		CFLAG:ARG:타겟 = -1
ENDIF
U = STOCK_U
SIF CFLAG:ARG:타겟 < 0
	RETURN 0
RETURN 1

;=========================================================
;敵の行動決定
;=========================================================
@SET_ACTION_ENEMY,ARG
#DIM LCOUNT
; LOCAL = 使用可能なスキルの中から何番目のスキルを選んだか
; LOCAL:1 = S:(10+LOCAL) = 使用可能なスキルのリスト
; LOCAL:2 = 回復時に参照：敵列orパーティのＨＰ合計
; LOCAL:3 = 最大ＨＰ合計
; LOCAL:4 = 合計ＨＰ比率



;この辺に思考ルーチンを参照するIFを仕込む予定
IF CSTR:ARG:사고패턴 == "1"
;少し賢いパターン
;無駄な回復はせず、ＨＰの低い敵を攻撃し、ＨＰの割合が低い味方を回復する
;ただしＨＰの低い敵の相性と自分のスキルによっては封殺される。
	CALL SEARCH_ACT, ARG
	$DECIDE_ACTION_1
	IF RESULT == 0
		CFLAG:ARG:입력행동 = -1
		CFLAG:ARG:방어플래그 = 1
		RETURN 0
	ENDIF
	LOCAL = RAND:FINDELEMENT(USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1)
	LOCAL:1 = USEABLE_SKILL_LIST_FOR_RANDOM_ACT:LOCAL
	ARRAYSHIFT USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1, -1, LOCAL, VARSIZE("USEABLE_SKILL_LIST_FOR_RANDOM_ACT")
;	PRINTFORML [{CFLAG:ARG:5}]のスキル数 {RESULT}
	;LOCAL = RAND:RESULT
	;スキル番号決定
	;LOCAL:1 = S:(10+LOCAL)
;	PRINTFORML [{CFLAG:ARG:5}]のスキル {LOCAL:1}

	$TARGET_LOOP_1
	;------------------------------------------------------
	;攻撃スキルのターゲット決定
	;------------------------------------------------------
	IF RESULT == 1
		CALL GET_SKILL_PROP, "SKILL_SPHERE", LOCAL:1, ARG
			IF RESULT == 1
			;----------------------------------------------
			;単体の場合
			;----------------------------------------------
			CALL GET_SKILL_PROP, "SKILL_RANGE", LOCAL:1,ARG
			IF (RESULT == 1 && CFLAG:ARG:5 < 14) || RESULT == 2
				;射程1かつ前衛or射程2
				;前衛の中で一番ＨＰが低いキャラクターを狙う
				CFLAG:ARG:타겟 = -1
				FOR LCOUNT, 0, 3
					IF FLAG:(71+LCOUNT) > -1 && CFLAG:ARG:타겟 == -1
						CFLAG:ARG:타겟 = LCOUNT + 1
						CONTINUE
					ENDIF
					IF FLAG:(71+LCOUNT) > -1 && BASE:(FLAG:(71+LCOUNT)):5 > BASE:(FLAG:(70+CFLAG:ARG:타겟)):5
						CFLAG:ARG:타겟 = LCOUNT + 1
					ENDIF
				NEXT
				SIF CFLAG:ARG:타겟 == -1
					GOTO DECIDE_ACTION_1
			ELSEIF RESULT == 3 || RESULT == 4
	;			;射程3
	;			;全員の中で一番ＨＰが低いキャラクターを狙う
				CFLAG:ARG:타겟 = -1
				FOR LCOUNT, 0, 6
					IF FLAG:(71+LCOUNT) > -1 && CFLAG:ARG:타겟 == -1
						CFLAG:ARG:타겟 = LCOUNT + 1
						CONTINUE
					ENDIF
					IF FLAG:(71+LCOUNT) > -1 && BASE:(FLAG:(71+LCOUNT)):5 > BASE:(FLAG:(70+CFLAG:ARG:타겟)):5
						CFLAG:ARG:타겟 = LCOUNT + 1
					ENDIF
				NEXT
				SIF CFLAG:ARG:타겟 == -1
					GOTO DECIDE_ACTION_1
			ELSE
				GOTO DECIDE_ACTION_1
			ENDIF
		ELSEIF RESULT == 2
			CFLAG:ARG:타겟 = -1
			;----------------------------------------------
			;1列の場合
			;----------------------------------------------
			IF RESULT == (RESULT == 1 && CFLAG:ARG:5 < 14) || RESULT == 2
	;			;前列しか狙えないので、自動的に前列
				CFLAG:ARG:타겟 = 17
			ELSEIF RESULT == 3 || RESULT == 4
				IF (FLAG:71 > -1 || FLAG:72 > -1 || FLAG:73 > -1) && (FLAG:74 > -1 || FLAG:75 > -1 || FLAG:76 > -1)
					;面倒なので暫定的にランダムとしておく
					CFLAG:ARG:타겟 = 17+RAND:2
				ELSE
				
				ENDIF
			ENDIF
			SIF CFLAG:ARG:타겟 == -1
				GOTO DECIDE_ACTION_1
		ELSEIF RESULT == 3
			CFLAG:ARG:타겟 = 19
			
		
		ELSE
			CFLAG:ARG:타겟 = 23
		ENDIF
	;------------------------------------------------------
	;回復・支援スキルのターゲット決定
	;------------------------------------------------------
	ELSEIF RESULT == 2
		CALL GET_SKILL_PROP, "SKILL_SPHERE", LOCAL:1, ARG
		IF RESULT == 1
	;		;----------------------------------------------
	;		;単体の場合
			;----------------------------------------------
			;味方の中で一番ＨＰ比率の低いキャラを対象にする。
			CFLAG:ARG:타겟 = -1
			FOR LCOUNT, 0, 10
				IF FLAG:(77+LCOUNT) > -1 && CFLAG:ARG:타겟 == -1
					SIF (BASE:(FLAG:(77+LCOUNT)):5 - MAXBASE:(FLAG:(77+LCOUNT)):5) == 0
						CONTINUE
					SIF CFLAG:(FLAG:(77+LCOUNT)):6 < 12
						CONTINUE
					CFLAG:ARG:타겟 = LCOUNT + 7
					CONTINUE
				ENDIF
				IF FLAG:(77+LCOUNT) > -1 && (BASE:(FLAG:(77+LCOUNT)):5*10000 / MAXBASE:(FLAG:(77+LCOUNT)):5) > (BASE:(FLAG:(70+CFLAG:ARG:타겟)):5*10000 / MAXBASE:(FLAG:(70+CFLAG:ARG:타겟)):5)
					CFLAG:ARG:타겟 = LCOUNT + 7
				ENDIF
			NEXT
			SIF CFLAG:ARG:타겟 == -1
				GOTO DECIDE_ACTION_1
			
		ELSEIF RESULT == 2
			;----------------------------------------------
			;列の場合
			;----------------------------------------------
			CFLAG:ARG:타겟 = -1
			LOCAL:2 = 0
			LOCAL:3 = 0
			LOCAL:4 = 0
			FOR LCOUNT, 0, 5
				IF FLAG:(77+LCOUNT) > -1
					LOCAL:2 += BASE:(FLAG:(77+LCOUNT)):5
					LOCAL:3 += MAXBASE:(FLAG:(77+LCOUNT)):5
				ENDIF
			NEXT
			IF LOCAL:2 && LOCAL:3
				CFLAG:ARG:타겟 = 20
				LOCAL:4 = LOCAL:2 * 10000 / LOCAL:3
			ENDIF
			LOCAL:2 = 0
			LOCAL:3 = 0
			FOR LCOUNT, 0, 5
				IF FLAG:(82+LCOUNT) > -1
					LOCAL:2 += BASE:(FLAG:(82+LCOUNT)):5
					LOCAL:3 += MAXBASE:(FLAG:(82+LCOUNT)):5
				ENDIF
			NEXT
			IF LOCAL:2 && LOCAL:3
				IF LOCAL:4 < LOCAL:2 * 10000 / LOCAL:3
					CFLAG:ARG:타겟 = 21
				ENDIF
			ENDIF
			
			SIF CFLAG:ARG:타겟 == -1
				GOTO DECIDE_ACTION_1
			
		ELSEIF RESULT == 3
			LOCAL:4 = 0
			FOR LCOUNT, 0, 20
				SIF BASE:(FLAG:(77+LCOUNT)):5 < MAXBASE:(FLAG:(77+LCOUNT)):5
					LOCAL:4 = 1
			NEXT
			SIF LOCAL:4 
				CFLAG:ARG:타겟 = 22
		ELSEIF RESULT == 4
			LOCAL:4 = 0
			FOR LCOUNT, 0, 20
				SIF BASE:(FLAG:(77+LCOUNT)):5 < MAXBASE:(FLAG:(77+LCOUNT)):5
					LOCAL:4 = 1
			NEXT
			SIF LOCAL:4 
				CFLAG:ARG:타겟 = 23
		ENDIF
		
	ELSEIF RESULT == 3
				
	ELSEIF RESULT == 4
		GOTO DECIDE_ACTION_1
	ELSE
		RESULT = 0
		CALL GET_SKILL_PROP, "SKILL_RANGE", ABL:ARG:(60+LOCAL:2),ARG
		IF (RESULT == 1 && CFLAG:ARG:5 < 14) || RESULT == 2
			FOR LOCAL:30,0,3
				SIF FLAG:(71+LOCAL:30) > -1
					LOCAL:1 += 1
			NEXT
			IF LOCAL:1
				CFLAG:ARG:120 = 1
				LOCAL += 1
			ENDIF
		ELSEIF RESULT == 3 || RESULT == 4
			CFLAG:ARG:120 = 1
			LOCAL += 1
		ENDIF
	ENDIF
ELSE
	TRYCCALLFORM SET_ACTION_%CSTR:ARG:사고패턴%,ARG
	;特殊な思考パターンをここで処理
	;詳細はダンジョン、コロシアム等のＥＲＢに記述して実行させる
	
	CATCH
		CALL ランダム行動 , ARG
	ENDCATCH

ENDIF

@ランダム行動 , ARG
CALL SEARCH_ACT,ARG
$DECIDE_ACTION
;---- EDIT 066 MOD START -------------------------
;入力可能なコマンドがなかった場合
;IF RESULT == 0
IF FINDELEMENT(USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1) == 0
	CFLAG:ARG:입력행동 = -1
	CFLAG:ARG:방어플래그 = 1
	RETURN 0
ENDIF
;---- EDIT 066 MOD END ---------------------------
LOCAL = RAND:FINDELEMENT(USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1)
LOCAL:1 = USEABLE_SKILL_LIST_FOR_RANDOM_ACT:LOCAL
;一度施行したスキルはリストから除く
ARRAYSHIFT USEABLE_SKILL_LIST_FOR_RANDOM_ACT, -1, -1, LOCAL, VARSIZE("USEABLE_SKILL_LIST_FOR_RANDOM_ACT")

;ターゲット選定を行い、通らなかったら再抽選
CALL RANDOM_TARGET,ARG,LOCAL:1
;SIF CFLAG:ARG:타겟 == -1;EDIT 066 MOD
SIF !RESULT
	GOTO DECIDE_ACTION
;ここでスキル番号を行動内容に代入
CFLAG:ARG:입력행동 = LOCAL:1

;-----------------------------------------
;スキルのセット関数
;指定したスキルを指定したキャラクターの行動にセットする。
;スキルをセットできない場合はランダムな行動が自動的にセットされる。
;-----------------------------------------
@SET_ACTION_SKILL, L_CHARA, L_SKILL
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_SKILL
CALL CHECK_ACTIONABLE, L_CHARA, L_SKILL
IF RESULT == 1
	CFLAG:L_CHARA:입력행동 = L_SKILL
	CALL RANDOM_TARGET, L_CHARA, L_SKILL
	RETURN 1
ELSE
	CALL ランダム行動 , L_CHARA
	RETURN 0
ENDIF

;-----------------------------------------
;スキルのセット関数
;-----------------------------------------
@SETS_ACTION_SKILL, L_CHARA, L_SKILLS, L_OPT
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_SKILL = -1
#DIMS DYNAMIC L_SKILLS
#DIMS DYNAMIC L_OPT
IF L_OPT == "비소지스킬"
	CSTR:L_CHARA:비소지스킬 '= L_SKILLS
	L_SKILL = [[스킬:비소지스킬]]
ELSEIF ISNUMERIC(L_SKILLS)
	L_SKILL = TOINT(L_SKILLS)
ELSE
	L_SKILL = PU_SKILLNUM_GET(L_CHARA, L_SKILLS)
	SIF L_SKILL == -1
		L_SKILL = SKILL_NUM_F(L_SKILLS)
ENDIF
SIF L_SKILL == -1
	THROW 不正なスキル[%L_SKILLS%]を[%CALLNAME:L_CHARA%]のコマンドにセットしようとしています。
CALL SET_ACTION_SKILL, L_CHARA, L_SKILL
RETURN RESULT

@CHECK_TARGET_RESUSCITATION , ARG
#DIM LCOUNT
#DIM L_POS, 17
#DIM L_CHARA
;---- EDIT 063 MOD START -------------------------
;対象が存在しない番号の時外す処理を追加
;SIF CFLAG:ARG:타겟 < CHARANUM && CFLAG:(CFLAG:ARG:타겟):상태이상 == GET_STATE_NUM("DYING")
SIF INRANGE(CFLAG:ARG:타겟, 0, CHARANUM -1) && IS_BADSTATE(CFLAG:ARG:타겟, "DYING")
	RETURN (CFLAG:ARG:타겟)
IF CFLAG:ARG:PT플래그 > 0
	;単体蘇生のターゲットを自動選択してくれる
	;戦闘参加者を優先する
	FOR LCOUNT, 1, 7
		L_CHARA = POS(LCOUNT)
		SIF L_CHARA < -0
			CONTINUE
		;使用者はスルー
		SIF L_CHARA == ARG
			CONTINUE
		IF CFLAG:L_CHARA:상태이상 == GET_STATE_NUM("DYING")
			RETURN L_CHARA
		ENDIF		
	NEXT
	FOR LCOUNT, 0, BCHARANUM
		L_CHARA = BCHARA:LCOUNT
		;使用者はスルー
		SIF L_CHARA == ARG
			CONTINUE
		;戦闘に参加可能かどうかを見る
		SIF !IS_JOINABLE_BATTLE(L_CHARA)
			CONTINUE
		SIF !CFLAG:L_CHARA:PT플래그
			CONTINUE
		IF CFLAG:L_CHARA:상태이상 == GET_STATE_NUM("DYING")
			RETURN L_CHARA
		ENDIF
	NEXT
ELSE
	;敵は敵ポジションからランダムで指定
	FOR LCOUNT, 7, 17
		L_POS:LCOUNT = LCOUNT
	NEXT
	FOR LCOUNT, 7, 17
		SWAP L_POS:RAND(7, 17), L_POS:RAND(7, 17)
	NEXT
	FOR LCOUNT, 7, 17
		SIF POS(L_POS:LCOUNT) < 0
			CONTINUE
		SIF !IS_BADSTATE(POS(L_POS:LCOUNT), "DYING")
			CONTINUE
		RETURN POS(L_POS:LCOUNT)
	NEXT
ENDIF
RETURN -1
;---- EDIT 063 MOD END ---------------------------
;---- EDIT 052 ADD START -------------------------
;処理の都合上LOCALを使用出来ない
@CAN_USE_SKILL, ARG
#DIM S番号
#DIM LCOUNT
#DIM SKILL_NUM
#DIMS スキル番
;ロンギヌス時は使用不能
IF CFLAG:ARG:롱기누스
	RESULTS = 異能力封印
	RETURN 0
ENDIF
FOR LCOUNT, 0, CHARA_SKILLCOUNT(ARG) + HAVEABLE_EQ_SKILLNUM
	IF LCOUNT < CHARA_SKILLCOUNT(ARG)
		SKILL_NUM = ABL:ARG:@"스킬{LCOUNT+1}"
	ELSE
		SKILL_NUM = ABL:ARG:@"장비스킬{LCOUNT - CHARA_SKILLCOUNT(ARG) + 1}"
	ENDIF
	SIF SKILL_NUM <= 0
		CONTINUE
	IF IS_BADSTATE(ARG, "CLOSE")
		CALL GET_SKILL_PROP, "SKILL_DECIDE_TYPE", SKILL_NUM, ARG
		SIF RESULT == 2
			CONTINUE
	ENDIF
	RETURN 1
NEXT
RESULTS = 사용 가능 스킬 없음
RETURN 0
