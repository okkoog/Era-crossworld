;====================================================
;行動時のコマンド名を取る
;
;ARG = キャラ登録番号
;====================================================
@GETS_INPUT_COMMAND_ACT, ARG
#DIM L_P
#DIM L_T
#DIM L_SKILL
#DIM IS_INPUTABLE
TFLAG:커맨드표시중 = 1
L_P = ARG
L_SKILL = CFLAG:L_P:입력행동
;行動可能かを取得
CALL INPUTABLE_CHARA, L_P
IS_INPUTABLE = RESULT
IF IS_INPUTABLE == 0
	IF CFLAG:L_P:상태이상 > 0
		RESULTS = %GET_STATE(CFLAG:L_P:상태이상),18,LEFT%
	ELSEIF CFLAG:L_P:조작불능플래그 == 1
		RESULTS = ＧＵＥＳＴ
	ELSEIF MAXARRAY(CFLAG:L_P:0, GETNUM(CFLAG, "검격웨이트"),  GETNUM(CFLAG, "검격웨이트") + TYPENUM) > 0
		RESULTS = ＷＡＩＴ
	ENDIF
ELSE
	IF CFLAG:L_P:링케이지참가
		RESULTS = ＷＡＩＴ
	ELSEIF CFLAG:L_P:ＣＨＡＮＧＥ대상플래그 == 1 || CFLAG:L_P:방어플래그 == 1
		RESULTS = ＧＵＡＲＤ
	ELSEIF CFLAG:L_P:입력행동 > -1
		CALL GET_SKILL_PROP, "SKILL_NAME", CFLAG:L_P:입력행동, L_P
		RESULTS '= RESULTS
	ELSE
		RESULTS = 
	ENDIF
ENDIF
TFLAG:커맨드표시중 = 0

;====================================================
;行動時の対象を文字列化して取る
;
;ARG = キャラ登録番号
;ARGS = 行動名(@GETS_INPUT_COMMAND_ACTで先に取得したものを使う)
;====================================================
@GETS_INPUT_COMMAND_TARGET, ARG, ARGS
#DIM L_P
#DIM L_T
#DIM L_SKILL
#DIM ACTOR_LENS
L_P = ARG
L_T = CFLAG:L_P:타겟
L_SKILL = CFLAG:L_P:입력행동
ACTOR_LENS = 18 + GETBIT(FLAG:커스텀게임화면,1) * 21
RESULTS = 
;対象指定なし
SIF L_T <= 0
	RETURN 0
;행동불능
CALL INPUTABLE_CHARA, L_P
SIF !RESULT
	RETURN 0
SIF L_SKILL < 0
	RETURN 0
;---- EDIT 058 MOD START -------------------------
;対象なし行動がきまっている
SIF ARGS == @"%"ＷＡＩＴ", ACTOR_LENS, LEFT%"
	RETURN 0
SIF ARGS == @"%"ＧＵＥＳＴ", ACTOR_LENS, LEFT%"
	RETURN 0
;---- EDIT 054 ADD START -------------------------
SIF ARGS == @"%"ＧＵＡＲＤ", ACTOR_LENS, LEFT%"
	RETURN 0
;---- EDIT 058 MOD END ---------------------------
;---- EDIT 058 MOD START ---------------------------
;IF GROUPMATCH(L_SKILL, [[스킬:ＳＵＭＭＯＮ]], [[스킬:사바트마]], [[스킬:초래의무도]])
CALL GET_SKILL_PROP, "SKILL_IS_SUMMON", L_SKILL, L_P
IF RESULT
	L_T = CFLAG:L_P:소환예정캐릭터
	GOTO RESERVE_SINGLE
ENDIF
;---- EDIT 058 MOD END -----------------------------
;控え対象行動
CALL GET_SKILL_PROP, "SKILL_T_RESERVE", L_SKILL, L_P
IF RESULT
	CALL GET_SKILL_PROP, "SKILL_SPHERE", L_SKILL, L_P
	IF RESULT > 1
		RESULTS = [--] 아군 전체
	ELSE
		$RESERVE_SINGLE
		IF CPOS(L_T) > 0
			RESULTS = [{CPOS(L_T), 2}] %CALLNAME:L_T%
		ELSE
			RESULTS = [--] %CALLNAME:L_T%
		ENDIF
	ENDIF
	RETURN 1
ENDIF
SELECTCASE L_SKILL
	CASE [[스킬:ＲＥＴＵＲＮ]]
		RETURN 0
	CASE [[스킬:ＣＨＡＮＧＥ]]
		RESULTS = [{CFLAG:L_P:타겟,2}] \@(POS(L_T) > -1) ? %CALLNAME:POS(L_T)% # ＥＭＰＴＹ \@
	CASEELSE
		SELECTCASE L_T
			CASE 1 TO 16
				;不正な対象の場合はターゲットの振替えを行う
				;有効なターゲットを取れない場合は防御に変更
				IF !IS_TARGET_ABLE(POS(L_T))
					CALL CHECK_ACTIONABLE, L_P, L_SKILL
					IF RESULT == 0
						CFLAG:L_P:입력행동 = -1
						CFLAG:L_P:방어플래그 = 1
						RETURN -1
					ELSE
						;CALL RANDOM_TARGET, FLAG:LOCALS, CFLAG:(FLAG:LOCALS):입력행동
						CALL RANDOM_TARGET, L_P, CFLAG:L_P:입력행동;EDIT 054
						IF !RESULT
							CFLAG:L_P:입력행동 = -1
							CFLAG:L_P:방어플래그 = 1
							RETURN -1
						ELSE
							;ランダムターゲットで振替えが出来ていたら変数の中身をさしかえる
							L_T = CFLAG:L_P:타겟;EDIT 053 ADD
						ENDIF
					ENDIF
				ENDIF
				RESULTS = [{L_T,2}] %CALLNAME:POS(L_T)%
			;---- EDIT 060 ADD START -------------------------
			CASE 17, 18
				RESULTS =[--] \@L_T == 17 ? 아군 전열 # 아군 후열 \@
			;---- EDIT 060 ADD END ---------------------------
			CASE 20, 21
				RESULTS =[--] \@L_T == 20 ? 적 전열 # 적 후열 \@
			CASEELSE
				CALL GET_SKILL_PROP, "SKILL_TARGET", CFLAG:L_P:입력행동, L_P
				IF RESULT == 1
					RESULTS = [--] 적 전체
				ELSEIF RESULT == 2
					RESULTS = [--] 아군 전체
				ELSEIF RESULT == 3
					RESULTS = [--] 전체
				ELSEIF RESULT == 5
					RESULTS = [--] 자신
				ELSE
					RETURN 0
				ENDIF
		ENDSELECT
ENDSELECT
RETURN 1
;---- EDIT 052 ADD END ---------------------------

@INPUTABLEF_CHARA(ARG)
#FUNCTION
