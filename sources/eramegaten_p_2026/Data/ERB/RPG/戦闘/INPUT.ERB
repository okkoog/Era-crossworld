;=========================================================
;スキルリストの表示
;ARG						スキル所持者の登録番号
;SELECT_SKILL_CATEGORY_LIST	表示内容の指定
;IS_UNABLE_FUNC				追加の使用不能条件を定義する関数名
;
;OPT_SHOW_SKILL_SELECT 0 = EX/MA分離表示  1 = 統合表示
;=========================================================
@SHOW_SKILL_LIST, ARG, SELECT_SKILL_CATEGORY_LIST = "데빌암즈/EX/MA/CS", IS_UNABLE_FUNC
#LOCALSIZE 6
#LOCALSSIZE 1
#DIMS CONST SELECT_SKILL_CATEGORY_TABLE = "데빌암즈", "EX", "MA", "CS", "AS"
#DIMS IS_UNABLE_FUNC
#DIMS L_OPT
#DIM LCOUNT, 4
#DIM CATEGORY_NUM
#DIMS SELECT_CATEGORY
#DIMS SELECT_SKILL_CATEGORY_LIST
#DIMS SKILLNAME
#DIM L_SKILL, 45
#DIM SKILL_STOCK,45
#DIM SELECT_NUM
#DIM SKILL_NUM
#DIMS L_TEXT,40
#DIMS L_TITLES,40
#DIM L_BUTTON, 40
#DIM L_COLOR, 40
#DIMS L_COSTS
;#DIM IS_CONTINUE
#DIM CHARA_SKILLNUM
#DIMS L_COSTTYPE
#DIM COST
#DIM SHOWNUM
CHARA_SKILLNUM = CHARA_SKILLCOUNT(ARG)	;스킬수
;画面表示
CALL SHOW_NOW_FORMATION_E,0,2, -1
DRAWLINE
CALL SHOW_NOW_FORMATION_P,0,2, 7, "戦闘中_メイン"
SIF OPT_SHOW_SKILL_SELECT==-1
	PRINTFORML %ARG는% 어떻게 할까？
VARSET SKILL_STOCK
;コマンドの表示
FOR CATEGORY_NUM, 0, VARSIZE("SELECT_SKILL_CATEGORY_TABLE")
	SHOWNUM = 0	;表示個数
	SELECT_CATEGORY = %SELECT_SKILL_CATEGORY_TABLE:CATEGORY_NUM%
	;統合表示の場合のMAは飛ばす
	SIF OPT_SHOW_SKILL_SELECT && SELECT_CATEGORY == "MA"
		CONTINUE
	;表示許可がないものを弾く
	SIF !COUNT_SPLIT(SELECT_SKILL_CATEGORY_LIST, "/", SELECT_CATEGORY)
		CONTINUE
	VARSET L_TEXT
	VARSET L_TITLES
	VARSET L_BUTTON
	VARSET L_COLOR
	FOR LCOUNT, 1, 21 + HAVEABLE_EQ_SKILLNUM
		IF SELECT_CATEGORY == "데빌암즈"
			SIF (LCOUNT - 1) >= VARSIZE("C_DEVIL_ARMS_SKILL")
				BREAK
			SIF !C_DEVIL_ARMS_SKILL:ARG:(LCOUNT-1)
				CONTINUE
			SKILL_NUM = C_DEVIL_ARMS_SKILL:ARG:(LCOUNT-1)
			FOR LCOUNT:3, 1, 21 + HAVEABLE_EQ_SKILLNUM
				IF LCOUNT:3 < 21
					SIF LCOUNT > CHARA_SKILLNUM;EDIT 052 MOD
						CONTINUE
					SIF SKILL_NUM != ABL:ARG:@"스킬{LCOUNT:3}"
						CONTINUE
				ELSE
					SIF SKILL_NUM != ABL:ARG:@"장비스킬{LCOUNT:3 - 20}"
						CONTINUE
				ENDIF
				SELECT_NUM = LCOUNT:3
			NEXT
		ELSE
			IF LCOUNT < 21
				SIF LCOUNT > CHARA_SKILLNUM;EDIT 052 MOD
					CONTINUE
				SKILL_NUM = ABL:ARG:@"스킬{LCOUNT}"
			ELSE
				SKILL_NUM = ABL:ARG:@"장비스킬{LCOUNT - 20}"
			ENDIF
			SIF !SKILL_NUM && LCOUNT > CHARA_SKILLNUM	;装備スキルの終端まで行ったら抜ける
				BREAK
			SELECT_NUM = LCOUNT
		ENDIF

		IF !GROUPMATCH(SELECT_CATEGORY, "데빌암즈")
			CALL GET_SKILL_PROP, "SKILL_DECIDE_TYPE", SKILL_NUM, ARG	;　1EXTRAか2MAGICか
			IF GROUPMATCH(SELECT_CATEGORY, "EX", "MA")
				IF OPT_SHOW_SKILL_SELECT
					SIF !GROUPMATCH(GET_SKILL_DECIDE_TYPE(RESULT), "EX", "MA")
						CONTINUE
				ELSE
					SIF SELECT_CATEGORY != GET_SKILL_DECIDE_TYPE(RESULT)
						CONTINUE
				ENDIF
			ELSE
				SIF SELECT_CATEGORY != GET_SKILL_DECIDE_TYPE(RESULT)
					CONTINUE
			ENDIF
		ENDIF

		;すでに登録されているスキルは処理を飛ばす
		SIF MATCH(SKILL_STOCK,SKILL_NUM)
			CONTINUE
		RESULTS = 
		CALL IS_ABLE_INPUT_COM_SKILL, ARG, SKILL_NUM, SELECT_SKILL_CATEGORY_LIST, IS_UNABLE_FUNC
		;戻り値が-1のときは非表示
		SIF RESULT == -1
			CONTINUE
		;ここまできたら表示スキルに入れる
		SKILL_STOCK:FINDELEMENT(SKILL_STOCK, 0) = SKILL_NUM
		;ツールチップ説明文を取得
		L_TITLES:SHOWNUM = %RESULTS%
		;スキルを実行出来ない場合は色を変える
		L_COLOR:SHOWNUM = RESULT ? GETCOLOR() # 0x404040

		;SKILL_STOCK:(SHOWNUM) = SKILL_NUM
		TFLAG:커맨드표시중 = 1
		CALL GET_SKILL_PROP, "SKILL_NAME", SKILL_NUM,ARG
		SKILLNAME = %RESULTS%
		TFLAG:커맨드표시중 = 0
		CALL GET_SKILL_COST, SKILL_NUM, ARG
		L_COSTS = %RESULTS%

		L_TEXT:SHOWNUM = [{SELECT_NUM, 2}] %SKILLNAME, SKILLNAMELENS:OPT_SHOW_SKILLLENS, LEFT%%L_COSTS, 7, LEFT%　　

		L_BUTTON:SHOWNUM = SELECT_NUM
		SHOWNUM++
	NEXT
	TOOLTIP_SETDELAY 100
	;上限下限の設定
	OPT_SHOW_SKILL_NUM = LIMIT(OPT_SHOW_SKILL_NUM, 2, LINELENS() / (SKILLNAMELENS:OPT_SHOW_SKILLLENS + 16))
	FOR LCOUNT:1, 0, 20
		LOCALS = 
		FOR LCOUNT, LCOUNT:1 * OPT_SHOW_SKILL_NUM, (LCOUNT:1 +1) * OPT_SHOW_SKILL_NUM
			SIF L_TEXT:LCOUNT == ""
				CONTINUE
			LOCALS += @"<font color = '%"#" + TOSTR(L_COLOR:LCOUNT, "X8")%' ><button value='{L_BUTTON:LCOUNT}' title='%L_TITLES:LCOUNT%' >%L_TEXT:LCOUNT%</button></font>"
		NEXT
		SIF LOCALS == ""
			BREAK
		;IF !LCOUNT:1 && !OPT_SHOW_SKILL_SELECT
		IF !LCOUNT:1
			SIF SELECT_CATEGORY == "데빌암즈"
				PRINTFORML [ＤＥＶＩＬ-ＡＲＭＳ]
			SIF OPT_SHOW_SKILL_SELECT
				DRAWLINE
			IF !OPT_SHOW_SKILL_SELECT
				DRAWLINE
				IF SELECT_CATEGORY == "EX"
					PRINTFORML [ＥＸＴＲＡ]
				ELSEIF SELECT_CATEGORY == "MA"
					PRINTFORML [ＭＡＧＩＣ]
				ENDIF
			ENDIF
			SIF SELECT_CATEGORY == "CS"
				PRINTFORML [ＣＯＭＭＡＮＤＥＲ]
			SIF SELECT_CATEGORY == "AS"
				PRINTFORML [ＡＳＳＩＳＴ]
		ENDIF
		HTML_PRINT @"%LOCALS%"
	NEXT
	;表示がなかった場合はPRINTLをしない
	SIF LCOUNT:1 > 1
		PRINTL 
NEXT
;SIF !LINEISEMPTY()
;	PRINTL 
DRAWLINE
PRINTFORM [ 0] ＣＡＮＣＥＬ%" " * 23%
IF !STRCOUNT(L_OPT, "オプション非表示")
	PRINTFORM [96] 문자폭\@OPT_SHOW_SKILLLENS?[넓게]#[통상]\@　　
	CALL PRINT_COLOR, "[97] <－>　", OPT_SHOW_SKILL_NUM == 2 ? COLOR("DARK-GRAY") # GETDEFCOLOR()
	PRINTFORM [１열의표시수.{OPT_SHOW_SKILL_NUM}]
	CALL PRINT_COLOR, "　[98] <＋>", OPT_SHOW_SKILL_NUM == LINELENS() / (SKILLNAMELENS:OPT_SHOW_SKILLLENS + 16) ? COLOR("DARK-GRAY") # GETDEFCOLOR()
	PRINT 　　
	PRINTFORM [99] 표시형식\@OPT_SHOW_SKILL_SELECT?[통합]#[분리]\@　　
ENDIF
