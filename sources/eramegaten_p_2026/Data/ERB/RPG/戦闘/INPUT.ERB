;SELECT_SKILL_CATEGORY_LIST		参照するスキルタイプ
;IS_UNABLE_FUNC					追加条件がある場合に呼び出す関数名
;=================================================
@IS_ABLE_INPUT_COM_SKILL, L_ACTOR, L_SKILL, SELECT_SKILL_CATEGORY_LIST = "데빌암즈/EX/MA/CS", IS_UNABLE_FUNC
#DIM L_ACTOR
#DIM L_SKILL
#DIMS SELECT_SKILL_CATEGORY_LIST
#DIMS IS_UNABLE_FUNC
CALL GET_SKILL_PROP, "SKILL_DECIDE_TYPE", L_SKILL, L_ACTOR
;表示カテゴリに入ってないなら非表示
SIF !COUNT_SPLIT(SELECT_SKILL_CATEGORY_LIST, "/", GET_SKILL_DECIDE_TYPE(RESULT))
	RETURN -1
;追加条件の指定
;戻り値が0で使用不能
;-1でそもそも選択肢の表示もしない
TRYCCALLFORM %IS_UNABLE_FUNC%, L_SKILL, L_ACTOR
	SIF RESULT <= 0	
		RETURN RESULT
CATCH
ENDCATCH
CALL GET_SKILL_PROP, "SKILL_ACTIONABLE_BATTLE", L_SKILL, L_ACTOR
SIF !RESULT
	RETURN -1
;スキルを実行できるかどうか
CALL CHECK_ACTIONABLE, L_ACTOR, L_SKILL
IF RESULT
	CALL GET_SKILL_EXPLAIN_TOOLTIP, L_SKILL, L_ACTOR
ELSE
	RETURN 0
ENDIF
RETURN 1

