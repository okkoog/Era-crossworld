	;麻痺してると駄目
	;金縛りだと駄目
	;凍ってると駄目
	;感電してると駄目
	;眠ってると駄目
	;オルギア関係で駄目
	;プロテクトモード関係で駄目
	;転倒してると駄目
		RETURNF 0
ENDSELECT
;ＣＨＡＮＧＥの対象だと駄目
;SIF CFLAG:ARG:ＣＨＡＮＧＥ대상플래그 == 1
;	RETURNF 0
;037　何らかのコマンドで操作不能になる
SIF CFLAG:ARG:일시조작불능 == 1
