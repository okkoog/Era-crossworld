;===============================
;戦闘行動に応じて素質ごとの忠誠度上昇量を算出
;ARG      対象キャラクタ
;ARG:1    입력행동
;RESULT   忠誠度上昇量
;===============================
;[우애]は回復・状態回復行動で忠誠度が上昇
@COMBAT_HIGH_友愛(ARG,ARG:1)
CALL GET_SKILL_PROP, "SKILL_EFECT", ARG:1, ARG
SIF RESULT != 2 && RESULT != 5
	RETURN 0
;スキルコストに応じた忠誠度上昇
CALL GET_SKILL_PROP, "SKILL_COST", ARG:1, ARG
RETURN RESULT/2
