;===============================
;戦闘行動に応じて素質ごとの忠誠度上昇量を算出
;ARG      対象キャラクタ
;ARG:1    입력행동
;RESULT   忠誠度上昇量
;===============================
;[교만]は状態変化スキルで忠誠度が上昇
@COMBAT_HIGH_高慢(ARG,ARG:1)
;状態変化スキル、または状態変化を伴う攻撃でなければ終了
CALL GET_SKILL_PROP, "SKILL_EFECT", ARG:1, ARG
SELECTCASE RESULT
	CASE 3
	CASE 1
		CALL GET_SKILL_PROP, "SKILL_ADDTIONAL_STATE", ARG:1,ARG
		SIF RESULT == 0
			RETURN 0
	CASEELSE
		RETURN 0
ENDSELECT
;スキルコストに応じた忠誠度上昇
CALL GET_SKILL_PROP, "SKILL_COST", ARG:1, ARG
RETURN RESULT/2