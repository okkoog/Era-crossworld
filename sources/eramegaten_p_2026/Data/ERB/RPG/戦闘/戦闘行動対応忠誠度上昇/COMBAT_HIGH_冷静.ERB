;===============================
;戦闘行動に応じて素質ごとの忠誠度上昇量を算出
;ARG      対象キャラクタ
;ARG:1    입력행동
;RESULT   忠誠度上昇量
;===============================
;[냉정]は特殊スキルで忠誠度が上昇
@COMBAT_HIGH_冷静(ARG,ARG:1)
;特殊でなければ終了
CALL GET_SKILL_PROP, "SKILL_EFECT", ARG:1, ARG
SIF RESULT != 4
	RETURN 0
;スキルコストに応じた忠誠度上昇
CALL GET_SKILL_PROP, "SKILL_COST", ARG:1, ARG
RETURN RESULT/2