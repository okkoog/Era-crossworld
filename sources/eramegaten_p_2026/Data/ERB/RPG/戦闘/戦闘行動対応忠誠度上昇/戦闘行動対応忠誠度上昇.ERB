@戦闘行動対応忠誠度上昇,ARG
#DIMS CONST COLOUR = "崩壊","友愛","獰猛","愚鈍","高慢","狡猾","冷静","残虐","賢い","ゾンビ","天使","堕天使","虚心"
#DIMS CONST COLOUR_KR = "붕괴","우애","영맹","우둔","교만","교활","냉정","잔학","현명","좀비","천사","타천사","허심"
#DIM LOYALTY,1
#DIM MOTIVE,1
;LOYALTY      획득충성도
;MOTIVE       忠誠度上昇の引き金となったTALENT
LOYALTY = 0
MOTIVE = 0
;基本動機となる素質ごとの判定
FOR LOCAL,0,VARSIZE("COLOUR")
	SIF !TALENT:ARG:(COLOUR_KR:LOCAL)
		CONTINUE
	CALLFORM COMBAT_HIGH_%COLOUR:LOCAL%,ARG,CFLAG:ARG:입력행동
	IF RESULT > LOYALTY || (RESULT <= 0 && LOYALTY <= 0)
		LOYALTY = RESULT
		MOTIVE = GETNUM(TALENT,COLOUR_KR:LOCAL)
	ENDIF
NEXT
;継承タイプと一致するスキルなら忠誠度+1(造魔を除く)
IF LOYALTY <= 0 && ABL:ARG:종족 != GET_RACE_NUM("조마")
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", CFLAG:ARG:입력행동, ARG
	SIF TALENT:ARG:GET_SUCCESSION(RESULT)
		LOYALTY += 1
ENDIF

;忠誠度増減
IF CFLAG:ARG:충성도링크 && FINDCHARA_TIMEID(CFLAG:ARG:피링크캐릭터실제가입시간) >= 0
	CFLAG:FINDCHARA_TIMEID(CFLAG:ARG:피링크캐릭터실제가입시간):전투중획득충성도 = MAX(0,CFLAG:FINDCHARA_TIMEID(CFLAG:ARG:피링크캐릭터실제가입시간):전투중획득충성도+LOYALTY)
ELSE
	CFLAG:ARG:전투중획득충성도 = MAX(0,CFLAG:ARG:전투중획득충성도+LOYALTY)
ENDIF
RETURN LOYALTY > 0 ? MOTIVE # 0