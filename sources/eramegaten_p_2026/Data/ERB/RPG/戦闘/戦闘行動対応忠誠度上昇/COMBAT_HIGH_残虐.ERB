;===============================
;戦闘行動に応じて素質ごとの忠誠度上昇量を算出
;ARG      対象キャラクタ
;ARG:1    입력행동
;RESULT   忠誠度上昇量
;===============================
;[잔학]は大ダメージを与える行動で忠誠度が上昇
@COMBAT_HIGH_残虐(ARG,ARG:1)
;攻撃でなければ終了
CALL GET_SKILL_PROP, "SKILL_EFECT", ARG:1, ARG
SIF RESULT != 1
	RETURN 0
;スキル威力
CALL GET_SKILL_PROP, "SKILL_POWER", ARG:1,ARG
LOCAL  = RESULT
;ダメージタイプに応じた攻撃力の係数
CALL GET_SKILL_PROP, "SKILL_DAMAGETYPE", ARG:1, ARG
LOCAL = LOCAL * DIVERGENCE(RESULT,MAXBASE:ARG:공격,MAXBASE:ARG:마법위력,MAXBASE:ARG:총공격) / 100
RETURN SQRT(LOCAL)
