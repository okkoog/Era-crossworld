;===============================
;戦闘行動に応じて素質ごとの忠誠度上昇量を算出
;ARG      対象キャラクタ
;ARG:1    입력행동
;RESULT   忠誠度上昇量
;===============================
;[천사]は破魔・精神・神経相性の行動で忠誠度が上昇
@COMBAT_HIGH_天使(ARG,ARG:1)
CALL GET_SKILL_PROP, "SKILL_TYPE", ARG:1, ARG
SELECTCASE RESULT
	CASE GET_TYPE_NUM("파마"),GET_TYPE_NUM("정신"),GET_TYPE_NUM("신경")
	CASEELSE
		RETURN 0
ENDSELECT
;スキルコストに応じた忠誠度上昇
CALL GET_SKILL_PROP, "SKILL_COST", ARG:1, ARG
RETURN RESULT/2