;===============================
;戦闘行動に応じて素質ごとの忠誠度上昇量を算出
;ARG      対象キャラクタ
;ARG:1    입력행동
;RESULT   忠誠度上昇量
;===============================
;[허심]は性格(素質)ごとに基準が変動する
@COMBAT_HIGH_虚心(ARG,ARG:1)
#DIMS CONST COLOUR = "友愛","獰猛"  ,"愚鈍","高慢"        ,"狡猾"        ,"冷静","残虐"    ,"賢い"  ,"ゾンビ"
#DIMS CONST MIND   = "겁쟁이","반항적","솔직함","프라이드높음","프라이드낮음","꿋꿋함","츤데레","건방짐","겁쟁이"
#DIM LOYALTY,1
;LOYALTY      획득충성도
LOYALTY = 0
;対応素質ごとの判定
FOR LOCAL,0,VARSIZE("COLOUR")
	SIF !TALENT:ARG:(MIND:LOCAL)
		CONTINUE
	CALLFORM COMBAT_HIGH_%COLOUR:LOCAL%,ARG,CFLAG:ARG:입력행동
	IF RESULT > LOYALTY || (RESULT <= 0 && LOYALTY <= 0)
		LOYALTY = RESULT
	ENDIF
NEXT
RETURN LOYALTY
