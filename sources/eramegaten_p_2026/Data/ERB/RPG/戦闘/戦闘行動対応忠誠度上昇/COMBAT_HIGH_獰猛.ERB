;===============================
;戦闘行動に応じて素質ごとの忠誠度上昇量を算出
;ARG      対象キャラクタ
;ARG:1    입력행동
;RESULT   忠誠度上昇量
;===============================
;[영맹]は物理ダメージを与える行動で忠誠度が上昇
@COMBAT_HIGH_獰猛(ARG,ARG:1)
;攻撃でなければ終了
CALL GET_SKILL_PROP, "SKILL_EFECT", ARG:1, ARG
SIF RESULT != 1
	RETURN 0
;物理攻撃でなければ終了
CALL GET_SKILL_PROP, "SKILL_DAMAGETYPE", ARG:1, ARG
SIF RESULT != 1
	RETURN 0
;スキルコストに応じた忠誠度上昇
CALL GET_SKILL_PROP, "SKILL_COST", ARG:1, ARG
RETURN RESULT/2