#DIM DYNAMIC 調教対象保存
;---- EDIT 034 ADD END   -------------------------
PRINTFORML %CALLNAME:ARG%에게 변이의 징후가 나타나고 있다……
PRINTFORML 지켜봅니까？
CALL INPUT_YN,"Yes","No"
IF RESULT == 1
	PRINTFORMW %CALLNAME:ARG%의 변이의 징후는 사라졌다
	ABL:ARG:변이레벨 = 0
	ABL:ARG:변이 = 0
ELSE
	PRINTFORML %ARG는% %조사처리(CSVNAME(ARG:1,0),"으로")% 새롭게 태어났다！
	;名称変更(変更されていない場合のみ)
	NAME:ARG '= \@ NAME:ARG == CSVNAME(NO:ARG) ? %CSVNAME(ARG:1)% # %NAME:ARG% \@
	CALLNAME:ARG '= \@ CALLNAME:ARG == CSVCALLNAME(NO:ARG) ? %CSVCALLNAME(ARG:1)% # %CALLNAME:ARG% \@
	NICKNAME:ARG '= CSVNICKNAME(ARG:1)
	;---- EDIT 034 ADD END   -------------------------
	;---- EDIT 046 MOD START -------------------------
	L_LV = BASE:ARG:LV
	BASE:ARG:LV = CSVBASE(ARG:1,GETNUM(BASE, "LV"),0)
	;能力値とレベル
	IF BASE:ARG:LV >= L_LV
		;FOR LOCAL,0,7
		FOR LOCAL,1,7
			BASE:ARG:GET_BASESTATUS(LOCAL) = CSVBASE(ARG:1,GETNUM(BASE,GET_BASESTATUS(LOCAL)),0)
		NEXT
	;変異先のレベルが低い場合、レベルに応じてステータスを自動的に振り込む
	ELSE
		L_ST_SUM = 0
		FOR LOCAL,1,7
			L_ST_SUM += CSVBASE(ARG:1,GETNUM(BASE,GET_BASESTATUS(LOCAL)),0)
		NEXT
		L_ST_SUM:1 = L_ST_SUM
		WHILE BASE:ARG:LV < L_LV
			BASE:ARG:LV++
			L_ST_SUM++
			SIF BASE:ARG:LV % 2
				L_ST_SUM++
		WEND
		FOR LOCAL, 1, 7
			BASE:ARG:GET_BASESTATUS(LOCAL) = CSVBASE(ARG:1,GETNUM(BASE,GET_BASESTATUS(LOCAL)),0) * L_ST_SUM / L_ST_SUM:1
		NEXT
		;振り分け元の合計ステータスと現在のステータスの合計が一致していない場合、もっとも低いものに加算、あるいは最も高いものに減算を繰り返して数値をあわせる
		WHILE L_ST_SUM != SUMARRAY(BASE:ARG:0, GETNUM(BASE, "힘"), GETNUM(BASE, "운") + 1)
			IF L_ST_SUM < SUMARRAY(BASE:ARG:0, GETNUM(BASE, "힘"), GETNUM(BASE, "운") + 1)
				BASE:ARG:FINDELEMENT(BASE:ARG:0, MAXARRAY(BASE:ARG:0, GETNUM(BASE, "힘"), GETNUM(BASE, "운") + 1), GETNUM(BASE, "힘"), GETNUM(BASE, "운") + 1)--
			ELSE
				BASE:ARG:FINDELEMENT(BASE:ARG:0, MINARRAY(BASE:ARG:0, GETNUM(BASE, "힘"), GETNUM(BASE, "운") + 1), GETNUM(BASE, "힘"), GETNUM(BASE, "운") + 1)++
			ENDIF
		WEND
	ENDIF
	BASE:ARG:CP = CSVBASE(ARG:1,GETNUM(BASE,"CP"),0)
	;---- EDIT 046 MOD END ---------------------------

	;相性
	FOR LOCAL,0,19
		BASE:ARG:GET_TYPE(LOCAL) = CSVBASE(ARG:1,GETNUM(BASE,GET_TYPE(LOCAL)),0)
	NEXT
	;現在の経験値
	SIF BASE:ARG:ＥＸＰ < GET_NEXT_EXP(ARG, BASE:ARG:LV-1)
		BASE:ARG:ＥＸＰ = GET_NEXT_EXP(ARG, BASE:ARG:LV-1)
