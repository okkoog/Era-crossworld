@DO_LEVEL_UP, ARG, ARG:1
SIF BASE:ARG:LV > ARG:1
	RETURN 0
BASE:ARG:ＥＸＰ = GET_NEXT_EXP(ARG, ARG:1-1)
CALL CHECK_LEVEL_UP, ARG

