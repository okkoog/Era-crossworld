;===============================
;レベルアップ判定＆処理　AUTO改
;===============================
@CHECK_LEVEL_UP_AUTO3,ARG,ARG:1,ARG:2
#DIM LCOUNT
#DIM STATUS_CHECK, 7
#DIM STATUS_UP, 7
;ARG:1 レベルアップ回数
VARSET LOCAL
;上昇比率が設定されていない場合ここで設定
IF CFLAG:ARG:힘상승률 == 0 & CFLAG:ARG:지상승률 == 0 & CFLAG:ARG:마상승률 == 0 & CFLAG:ARG:내상승률 == 0 & CFLAG:ARG:속상승률 == 0 & CFLAG:ARG:운상승률 == 0 
	CALL LVUP_AUTOIF2_DEFAULT(ARG)
	DRAWLINE
ENDIF
VARSET STATUS_UP
IF ARG:2
	PRINTL 
	PRINTL
	$INPUT_UP_STATUS
	DRAWLINE
		PRINTFORML %종족명(ARG)%　　%CALLNAME:ARG%　　
		PRINTFORM 　　LV{BASE:ARG:30+ARG:1,3}　　　
		CALL PRINT_ALIGNMENT,ARG,0,0
		PRINTFORML 
		CUSTOMDRAWLINE ･
		PRINTFORML 능력상승{ARG:2,3}포인트
	;最も高いステータスの値を確認
	STATUS_CHECK:0 = MAXARRAY(BASE:ARG:0, GETNUM(BASE, "힘"), GETNUM(BASE, "운")  + 1)
	;ERBでは少数が使えないため、制度を高める為に上昇率を最低100倍してから現在ステータスで除算する
	;ステータスが高くなっても問題ないように、現在の最大ステータスも使用
	FOR LCOUNT, 1, 7
		STATUS_CHECK:LCOUNT = CFLAG:ARG:(GETNUM(CFLAG,"힘상승률") + LCOUNT - 1) * 100 * STATUS_CHECK:0 / MAX(BASE:ARG:GET_BASESTATUS(LCOUNT), 1)
	NEXT
	FOR LCOUNT, 0, ARG:2
		;最も優先度の高いステータスを確認
		STATUS_UP:0 = FINDELEMENT(STATUS_CHECK, MAXARRAY(STATUS_CHECK, 1, 7), 1, 7)
		;優先度の高いステータスに上昇予定を１つ加算し、優先度を再計算
		STATUS_UP:(STATUS_UP:0) += 1
		STATUS_CHECK:(STATUS_UP:0) = CFLAG:ARG:(GETNUM(CFLAG,"힘상승률") + STATUS_UP:0 - 1) * 100 * STATUS_CHECK:0 / MAX(BASE:ARG:GET_BASESTATUS(STATUS_UP:0) + STATUS_UP:(STATUS_UP:0), 1)
	NEXT
		CUSTOMDRAWLINE ･
	FOR LCOUNT, 1, 7
		BASE:ARG:(GET_BASESTATUS(LCOUNT)) += STATUS_UP:LCOUNT
		PRINTFORML %GET_BASESTATUS(LCOUNT),4%：{BASE:ARG:(GET_BASESTATUS(LCOUNT)),4}(+{STATUS_UP:(LCOUNT),3})
	NEXT
	PRINTW 
	
	
ENDIF
