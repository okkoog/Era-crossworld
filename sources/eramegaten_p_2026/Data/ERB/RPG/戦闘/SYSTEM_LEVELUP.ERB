	FOR LCOUNT, 1, SKILLCOUNT + 1
		L_SKILLS = %L_ABL_TYPE%{LCOUNT}
		IF ABL:L_CHARA:L_SKILLS > 0
			CALL GET_SKILL_PROP, "SKILL_NAME", ABL:L_CHARA:L_SKILLS,L_CHARA
			IF SKILL_DEL_UNABLE:LCOUNT == 1
				SETCOLOR COLOR("黄色")
				PRINTFORML LOCK %RESULTS%
			ELSE
				SIF SKILL_DEL_UNABLE:LCOUNT == 2
					SETCOLOR COLOR("DARK-GRAY")
				PRINTFORML [{LCOUNT, 2}] %RESULTS%
			ENDIF
			RESETCOLOR
		ENDIF
	NEXT
	DRAWLINE	
	IF FLAG:SHOP커맨드 == [[ショップ:동료마강화]]
		PRINTFORML [0] 돌아간다　[99]스킬잠금설정
	ELSE
		PRINTFORML [0] %조사처리(LEARN_SKILL_NAME,"을")% 습득하지 않는다　[99]스킬잠금설정
	ENDIF
	LINE:1 = LINECOUNT
	$INPUT_LOOP
	CLEARLINE LINECOUNT - LINE:1
	INPUT
	SELECTCASE RESULT
		CASE 0
			IF GET_ROLE_PROP("CAN_USE_MANTRA", L_CHARA)
				RETURN 1
			ELSEIF FLAG:SHOP커맨드 == [[ショップ:동료마강화]]
				RETURN 0
			ELSE
				PRINT 정말로 괜찮겠습니까？
				CALL SP_SKILL_CHECK, L_LEARN_SKILL
				SIF RESULT 
					PRINTFORM ※%조사처리(LEARN_SKILL_NAME,"은")% 특별한 스킬입니다。
				PRINTFORML \n[0] 아니오　[1] 네
				CALL INPUTINT, 0, 1
				SIF RESULT == 1
					RETURN 0
			ENDIF
			GOTO CHOICE
		CASE 99
			;스킬잠금설정
			CALL SKILL_ROCK_SETTING, L_CHARA, IS_TRANS
			GOTO CHOICE
		CASEELSE	
			LEARN_SKILL_NUM = RESULT
			SIF !INRANGE(LEARN_SKILL_NUM, 1, SKILLCOUNT)
				GOTO INPUT_LOOP
			;---- EDIT 038 MOD START -------------------------
			DEL_SKILLS = %L_ABL_TYPE%{LEARN_SKILL_NUM}
			DEL_SKILL = ABL:L_CHARA:DEL_SKILLS
			CALL GET_SKILL_PROP, "SKILL_NAME", DEL_SKILL, L_CHARA
			DEL_SKILL_NAME = %RESULTS%
			IF SKILL_DEL_UNABLE:LEARN_SKILL_NUM == 1
				PRINTFORMW %조사처리(DEL_SKILL_NAME,"은")% 잠겨있어 잊을 수 없습니다。
				GOTO INPUT_LOOP
			ENDIF
			IF SKILL_DEL_UNABLE:LEARN_SKILL_NUM == 2
				PRINTFORMW %조사처리(DEL_SKILL_NAME,"은")% 잊을 수 없는 스킬입니다。
				GOTO INPUT_LOOP
			ENDIF
			;---- EDIT 038 MOD END ---------------------------
			DRAWLINE
			CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", DEL_SKILL, L_CHARA
			PRINTFORM 【%GET_SUCCESSION(RESULT)%】 
			CALL GET_SKILL_PROP, "SKILL_NAME", DEL_SKILL, L_CHARA
			PRINTFORML %DEL_SKILL_NAME%
			SIF FLAG:스킬속성표시설정 == 1
				CALL SKILL_EXPLAIN_PERFORMANCE, DEL_SKILL, L_CHARA
			CALL GET_SKILL_PROP, "SKILL_EXPLAIN", DEL_SKILL, L_CHARA
			DRAWLINE
			IF GET_ROLE_PROP("CAN_USE_MANTRA", L_CHARA) && IS_TRANS
				PRINTFORML 정밀로 %조사처리(DEL_SKILL_NAME,"을")% 잊고、%조사처리(LEARN_SKILL_NAME,"을")% 습득해도 괜찮겠습니까？
			ELSE
				PRINTFORML 정말로 %조사처리(DEL_SKILL_NAME,"과")% %조사처리(LEARN_SKILL_NAME,"을")% 교체해도 괜찮겠습니까？
			ENDIF
			CALL INPUT_YN
			SIF RESULT == 1
				GOTO CHOICE
	ENDSELECT
ENDIF
