;===============================
;必要経験値算出関数
;ARG	:キャラクター番号
;ARG:1	:レベル指定(主に現在のレベルに対する必要な経験値、BASE:LV-1をいれてつかうことになる)
;===============================
@GET_NEXT_EXP, ARG, ARG:1 = -1
#FUNCTION
#DIM L_LV
#DIM BASE_NEXT_EXP
L_LV = ARG:1 == -1 ? BASE:ARG:LV # ARG:1
;---- EDIT 037 MOD START -------------------------
BASE_NEXT_EXP = GET_ROLE_PROP("NEXT_EXP", ARG)
BASE_NEXT_EXP = BASE_NEXT_EXP == -1 ? 100 # BASE_NEXT_EXP

RETURNF GET_BASE_NEXT_EXP(L_LV) * BASE_NEXT_EXP / 100
;RETURNF 5 * L_LV * (L_LV +1) * (L_LV + 2) / 3 * BASE_NEXT_EXP / 100
;RETURNF 5 * ARG * (ARG+1) * (ARG+2) / 3 * (ARG:1 ? 5 # 4) / 4
;---- EDIT 037 MOD END ---------------------------

;---- EDIT 047 ADD START -------------------------
;===============================
;必要基本経験値算出関数
;ARG	:基準レベル
;===============================
@GET_BASE_NEXT_EXP, ARG
#FUNCTION
RETURNF 5 * ARG * (ARG + 1) * (ARG+2) / 3
;---- EDIT 047 ADD END ---------------------------

@SET_NEXT_EXP, ARG
MAXBASE:ARG:ＥＸＰ = GET_NEXT_EXP(ARG)
BASE:ARG:ＥＸＰ = MAX(BASE:ARG:ＥＸＰ, GET_NEXT_EXP(ARG, BASE:ARG:LV - 1))

;===============================
;レベルアップ判定
;===============================
@CHECK_LEVEL_UP, ARG
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC CNT_LVUP
#DIM DYNAMIC L_LINK_CHARA

;レベルアップ回数の取得
WHILE BASE:ARG:ＥＸＰ >= GET_NEXT_EXP(ARG, BASE:ARG:LV + CNT_LVUP)
	CNT_LVUP += 1
WEND

SIF CNT_LVUP
	CALL EXE_LEVEL_UP, ARG, CNT_LVUP
FOR LCOUNT, 0, LINKCHARANUM
	L_LINK_CHARA = FINDCHARA_LINK(ARG, LCOUNT)
	SIF L_LINK_CHARA < 0
		CONTINUE
	SIF !CFLAG:L_LINK_CHARA:레벨링크
		CONTINUE
	SIF BASE:ARG:LV <= BASE:L_LINK_CHARA:LV
		CONTINUE
	CALL EXE_LEVEL_UP, L_LINK_CHARA, BASE:ARG:LV - BASE:L_LINK_CHARA:LV
NEXT

;===============================
;レベルアップ処理
;===============================
@EXE_LEVEL_UP, ARG, CNT_LVUP
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC CNT_LVUP
#DIM DYNAMIC CNT_STATUS_BONUS
#DIM DYNAMIC TRANSFORMED
;レベルアップでの追加ステータスの計算
FOR LCOUNT, 0, CNT_LVUP
	SIF (BASE:ARG:LV + LCOUNT) % 2 == 1
		CNT_STATUS_BONUS += 1
NEXT
CNT_STATUS_BONUS += CNT_LVUP

TRANSFORMED = 0
;人間体でレベルをあげるために変身
IF CFLAG:ARG:악마변신
	CALL TRANS_DEVIL, ARG, 0, "変身解除"
	TRANSFORMED = 1
ENDIF

;レベルを加算
;非戦闘員はここまで
;---- EDIT 043 MOD START -------------------------
IF TALENT:ARG:비전투원 && CNT_LVUP
	BASE:ARG:LV += CNT_LVUP
	PRINTFORML LEVEL UP!
	CALL SYNC_STATUS , ARG
	RETURN 0
ENDIF
;---- EDIT 043 MOD END ---------------------------

;メッセージと口上
;PRINTFORMW %NAME:ARG%はレベルが上がった！
PRINTFORMW %조사처리(NAME:ARG,"는")% 레벨이 {CNT_LVUP} 올랐다！
SETCOLOR 0x33ffcc
CALL BATTLE_EVENT, "レベルアップ", ARG
RESETCOLOR

;ステータスボーナスの配分
SELECTCASE FLAG:레벨업시인터페이스설정
	CASE 0
		CALL ALLOCATE_BASE_STATUS_BY_LEVELUP, ARG, CNT_LVUP, CNT_STATUS_BONUS
	CASE 1
		CALL STATUS_BONUS_1, ARG, CNT_STATUS_BONUS, CNT_LVUP
	CASE 2
		CALL CHECK_LEVEL_UP_AUTO, ARG, CNT_LVUP, CNT_STATUS_BONUS
	CASE 3
		CALL CHECK_LEVEL_UP_AUTO2, ARG, CNT_LVUP, CNT_STATUS_BONUS
	;---- EDIT 044 ADD START -------------------------
	CASE 4
		CALL CHECK_LEVEL_UP_AUTO3, ARG, CNT_LVUP, CNT_STATUS_BONUS
	;---- EDIT 044 ADD END ---------------------------
ENDSELECT
;レベルを加算
BASE:ARG:LV += CNT_LVUP

CALL LVUP_BOOSTER, ARG, CNT_LVUP
CALL LVUP_BOOSTER_MAGATAMA, ARG, CNT_LVUP

CALL SYNC_STATUS, ARG, "HPMP割合保持"
;変身していた場合戻す
SIF TRANSFORMED
	CALL TRANS_DEVIL, ARG

;スキル習得等
CALL EVENT_LEVELUP, ARG, CNT_LVUP
;キャラ固有のイベント
TRYCALLFORM EVENT_LEVELUP_{NO:ARG}, ARG, CNT_LVUP
;マスターの最大到達レベルをとっておく
SIF ARG == MASTER
	MAX_MASTER_LV = MAX(MAX_MASTER_LV, BASE:ARG:LV)
;人間なら全回復(COMPに入れないなら)
IF !GET_ROLE_PROP("CAN_PUT_IN_COMP", ARG)
	BASE:ARG:ＨＰ = MAXBASE:ARG:ＨＰ
	CFLAG:ARG:상태이상 = GET_STATE_NUM("GOOD")
ENDIF

@ALLOCATE_BASE_STATUS_BY_LEVELUP, ARG, CNT_LVUP, CNT_STATUS_BONUS 
#DIM LCOUNT, 2
#DIM L_LINE
#DIM ADD_BASE_STATUS, BASESTATUSNUM
#DIM CNT_LVUP
#DIM CNT_STATUS_BONUS
#DIM IS_TRANSFORMED
#DIM REMAINING_BONUS
#DIM STOCK_REDRAW
#DIMS SHOW_LINE, 7
#DIM SHOW_LINE_MAXLENS

SELECTCASE FLAG:레벨업시인터페이스설정
	CASE 0
		CALL STATUS_BONUS_0, ARG, CNT_STATUS_BONUS, CNT_LVUP
	CASE 1
		CALL STATUS_BONUS_1, ARG, CNT_STATUS_BONUS, CNT_LVUP
	CASE 2
		CALL CHECK_LEVEL_UP_AUTO, ARG, CNT_STATUS_BONUS
	CASE 3
		CALL CHECK_LEVEL_UP_AUTO2, ARG, CNT_STATUS_BONUS
	;---- EDIT 044 ADD START -------------------------
	CASE 4
		CALL CHECK_LEVEL_UP_AUTO3, ARG, CNT_STATUS_BONUS
	;---- EDIT 044 ADD END ---------------------------
ENDSELECT


@AUTO_ALLOCATE_BASE_STATUS_BY_LEVELUP, ARG, ARG:1, CNT_STATUS_BONUS, ADD_BASE_STATUS
#DIM LCOUNT, 2
#DIM CNT_STATUS_BONUS
#DIM REF ADD_BASE_STATUS
#DIM STOCK_BASE_STATUS, BASESTATUSNUM
#DIM SUM_BASE_STATUS
#DIM TEMP
SELECTCASE ARG:1
	CASE 0
		SUM_BASE_STATUS = 0
		FOR LCOUNT, 1, BASESTATUSNUM
			SUM_BASE_STATUS += BASE:ARG:GET_BASESTATUS(LCOUNT)
		NEXT
		FOR LCOUNT, 1, BASESTATUSNUM
			ADD_BASE_STATUS:LCOUNT = (BASE:ARG:GET_BASESTATUS(LCOUNT) * (SUM_BASE_STATUS + CNT_STATUS_BONUS) / SUM_BASE_STATUS) - BASE:ARG:GET_BASESTATUS(LCOUNT)
		NEXT
		;消失した点数の補填
		LCOUNT:1 = 0
		;ステータスが高い順に補填措置を入れる
		WHILE SUMARRAY(ADD_BASE_STATUS) != CNT_STATUS_BONUS
			IF LCOUNT:1 % 6 == 0
				FOR LCOUNT, 1, BASESTATUSNUM
					STOCK_BASE_STATUS:LCOUNT = BASE:ARG:GET_BASESTATUS(LCOUNT) + ADD_BASE_STATUS:LCOUNT
				NEXT
			ENDIF
			TEMP = FINDELEMENT(STOCK_BASE_STATUS, MAXARRAY(STOCK_BASE_STATUS, 1, BASESTATUSNUM), 1, BASESTATUSNUM)
			IF SUMARRAY(ADD_BASE_STATUS) < CNT_STATUS_BONUS
				ADD_BASE_STATUS:TEMP += 1
			ELSE
				ADD_BASE_STATUS:TEMP -= 1
			ENDIF
			STOCK_BASE_STATUS:TEMP = 0
			LCOUNT:1++
		WEND
	CASE 1
		SUM_BASE_STATUS = 0
		FOR LCOUNT, 1, BASESTATUSNUM
			SUM_BASE_STATUS += MAXBASE:ARG:GET_BASESTATUS(LCOUNT)
		NEXT
		FOR LCOUNT, 1, BASESTATUSNUM
			ADD_BASE_STATUS:LCOUNT = (MAXBASE:ARG:GET_BASESTATUS(LCOUNT) * (SUM_BASE_STATUS + CNT_STATUS_BONUS) / SUM_BASE_STATUS) - MAXBASE:ARG:GET_BASESTATUS(LCOUNT)
		NEXT
		;消失した点数の補填
		LCOUNT:1 = 0
		;ステータスが高い順に調整措置を入れる
		WHILE SUMARRAY(ADD_BASE_STATUS) != CNT_STATUS_BONUS
			IF LCOUNT:1 % 6 == 0
				FOR LCOUNT, 1, BASESTATUSNUM
					STOCK_BASE_STATUS:LCOUNT = MAXBASE:ARG:GET_BASESTATUS(LCOUNT) + ADD_BASE_STATUS:LCOUNT
				NEXT
			ENDIF
			TEMP = FINDELEMENT(STOCK_BASE_STATUS, MAXARRAY(STOCK_BASE_STATUS, 1, BASESTATUSNUM), 1, BASESTATUSNUM)
			IF SUMARRAY(ADD_BASE_STATUS) < CNT_STATUS_BONUS
				ADD_BASE_STATUS:TEMP += 1
			ELSE
				ADD_BASE_STATUS:TEMP -= 1
			ENDIF
			STOCK_BASE_STATUS:TEMP = 0
			LCOUNT:1++
		WEND
ENDSELECT

;===============================
;キャラレベルアップ関数
;ARG	:キャラクター番号
;ARG:1	:ARG:1になるようにレベルをあげる(30なら30レベルになる)
