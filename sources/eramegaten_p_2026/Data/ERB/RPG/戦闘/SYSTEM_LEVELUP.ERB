;===============================
;現在のレベルまで空き枠がある限り習得スキルを習得させる
;===============================
@LEARN_SKILL_TO_NOW_LEVEL, ARG, ARGS:1 = "両形態", ARGS:2
#DIM LCOUNT
IF ARGS:1 == "通常形態" || ARGS:1 == "両形態"
	FOR LCOUNT, 1, 21
		SIF BASE:ARG:LV < ABL:ARG:@"습득LV{LCOUNT}"
			CONTINUE
		SIF !ABL:ARG:@"습득스킬{LCOUNT}"
			CONTINUE
		CALL LEARN_SKILL, ARG, ABL:ARG:@"습득스킬{LCOUNT}", 0, "NOMES/入れ替えなし"
		;---- EDIT 045 ADD START -------------------------
		IF RESULT
			ABL:ARG:@"습득스킬{LCOUNT}" = 0
			ABL:ARG:@"습득LV{LCOUNT}" = 0
		ENDIF
		;---- EDIT 045 ADD END ---------------------------
	NEXT
ENDIF

IF GET_ROLE_PROP("CAN_USE_TRANS", ARG) || ARGS:1 == "変身形態" || ARGS:1 == "両形態"
	FOR LCOUNT, 1, 21
		SIF BASE:ARG:LV < ABL:ARG:@"초기변신악마습득LV{LCOUNT}"
			CONTINUE
		SIF !ABL:ARG:@"초기변신악마습득스킬{LCOUNT}"
			CONTINUE
		CALL LEARN_SKILL, ARG, ABL:ARG:@"초기변신악마습득스킬{LCOUNT}", 1, "NOMES/入れ替えなし"
		;---- EDIT 045 ADD START -------------------------
		IF RESULT
			ABL:ARG:@"초기변신악마습득스킬{LCOUNT}" = 0
			ABL:ARG:@"초기변신악마습득LV{LCOUNT}" = 0
		;---- EDIT 045 ADD END ---------------------------
		ENDIF
	NEXT
ENDIF
;===============================
;CSV上で定義したスキルを習得済みスキルにまわして、指定レベルでの所持スキルを調整する
;===============================
@INIT_CHARA_SKILL, L_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
IF CSTR:L_CHARA:초기습득제한스킬 != ""
	FOR LCOUNT, 1, 21
		SIF ABL:L_CHARA:@"스킬{LCOUNT}" == 0
			CONTINUE
		SIF STRCOUNT("/" + CSTR:L_CHARA:초기습득제한스킬 + "/", "/" + CONVERT_SKILLNUM_TO_STR(L_CHARA, ABL:L_CHARA:@"스킬{LCOUNT}") + "/") > 0
			ABL:L_CHARA:@"스킬{LCOUNT}" = 0
	NEXT
	FOR LCOUNT, 1, 21
		SIF ABL:L_CHARA:@"습득스킬{LCOUNT}" == 0
			CONTINUE
		IF STRCOUNT("/" + CSTR:L_CHARA:초기습득제한스킬 + "/", "/" + CONVERT_SKILLNUM_TO_STR(L_CHARA, ABL:L_CHARA:@"습득스킬{LCOUNT}") + "/") > 0
			ABL:L_CHARA:@"습득스킬{LCOUNT}" = 0
			ABL:L_CHARA:@"습득LV{LCOUNT}" = 0
		ENDIF
	NEXT
	FOR LCOUNT, 1, 21
		SIF ABL:L_CHARA:@"초기변신악마스킬{LCOUNT}" == 0
			CONTINUE
		SIF STRCOUNT("/" + CSTR:L_CHARA:초기습득제한스킬 + "/", "/" + CONVERT_SKILLNUM_TO_STR(L_CHARA, ABL:L_CHARA:@"초기변신악마스킬{LCOUNT}") + "/")
			ABL:L_CHARA:@"초기변신악마스킬{LCOUNT}" = 0
	NEXT
	FOR LCOUNT, 1, 21
		SIF ABL:L_CHARA:@"초기변신악마습득스킬{LCOUNT}" == 0
			CONTINUE
		IF STRCOUNT("/" + CSTR:L_CHARA:초기습득제한스킬 + "/", "/" + CONVERT_SKILLNUM_TO_STR(L_CHARA, ABL:L_CHARA:@"초기변신악마습득스킬{LCOUNT}") + "/") > 0
			ABL:L_CHARA:@"초기변신악마습득스킬{LCOUNT}" = 0
			ABL:L_CHARA:@"초기변신악마습득LV{LCOUNT}" = 0
		ENDIF
	NEXT
	;空き番号を詰める
	FOR LCOUNT, 20, 1, -1
		IF ABL:L_CHARA:@"스킬{LCOUNT - 1}" == 0 && ABL:L_CHARA:@"스킬{LCOUNT}" != 0
			SWAP ABL:L_CHARA:@"스킬{LCOUNT - 1}", ABL:L_CHARA:@"스킬{LCOUNT}"
			LCOUNT = 20
		ENDIF
	NEXT
	FOR LCOUNT, 20, 1, -1
		IF ABL:L_CHARA:@"초기변신악마스킬{LCOUNT - 1}" == 0 && ABL:L_CHARA:@"초기변신악마스킬{LCOUNT}" != 0
			SWAP ABL:L_CHARA:@"초기변신악마스킬{LCOUNT - 1}", ABL:L_CHARA:@"스킬{LCOUNT}"
			LCOUNT = 20
		ENDIF
	NEXT
ENDIF
