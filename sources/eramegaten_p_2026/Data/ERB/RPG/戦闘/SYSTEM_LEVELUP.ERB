;===============================
;レベルアップ時のイベント
;===============================
@EVENT_LEVELUP,ARG,ARG:1
;スキル習得判定
;暫定的に習得スキルは20個までとします
IF TALENT:ARG:인수라
	;人修羅は特殊
	IF EQUIP:ARG:(GET_EQUIP(6))
		FOR LOCAL,0,20
			RESULT = 0
			TRYCALLFORM P習得スキル_{EQUIP:ARG:(GET_EQUIP(6))},LOCAL
			LOCAL:9 = RESULT
			LOCAL:10 = RESULT:1
			;装備品に習得スキル&LVが存在してて、かつ習得経験が無いことが条件
			LOCAL:2 = (EQUIP:ARG:(GET_EQUIP(6)))%5 +1
			LOCAL:3 = (EQUIP:ARG:(GET_EQUIP(6))-8000)/5
			IF LOCAL:9 > 0 && LOCAL:10 > 0 && !(CDFLAG:ARG:(LOCAL:2):(LOCAL:3) & POWER(2,LOCAL))
				IF LOCAL:10 <= BASE:ARG:LV
					CALL LEARN_SKILL,ARG,LOCAL:9
					CDFLAG:ARG:(LOCAL:2):(LOCAL:3) |= POWER(2,LOCAL)
				ENDIF
			ENDIF
		NEXT
	ENDIF
ELSE
	FOR LOCAL,1,21
		IF ABL:ARG:("습득스킬"+TOSTR(LOCAL)) > 0
			IF ABL:ARG:("습득LV"+TOSTR(LOCAL)) <= BASE:ARG:LV
				CALL LEARN_SKILL,ARG,ABL:ARG:("습득스킬"+TOSTR(LOCAL))
				ABL:ARG:("습득스킬"+TOSTR(LOCAL)) = 0
				ABL:ARG:("습득LV"+TOSTR(LOCAL)) = 0
			ENDIF
		ENDIF
	NEXT
ENDIF
;IF TALENT:ARG:데빌시프터 || TALENT:ARG:식노 || TALENT:ARG:악마빙의자　EDIT 035
IF GET_ROLE_PROP("CAN_USE_TRANS", ARG)
	FOR LOCAL,1,21
		IF ABL:ARG:("초기변신악마습득스킬"+TOSTR(LOCAL)) > 0
			IF ABL:ARG:("초기변신악마습득LV"+TOSTR(LOCAL)) <= BASE:ARG:LV
				;---- EDIT 039 MOD START -------------------------
				SIF GET_ROLE_PROP("CAN_USE_MANTRA", ARG)
					PRINTFORMW %ARG는% 전술의 폭을 넓혔다！
				CALL LEARN_SKILL,ARG,ABL:ARG:("초기변신악마습득스킬"+TOSTR(LOCAL)),1
				ABL:ARG:("초기변신악마습득스킬"+TOSTR(LOCAL)) = 0
				ABL:ARG:("초기변신악마습득LV"+TOSTR(LOCAL)) = 0
			ENDIF
		ENDIF
	NEXT
ENDIF

;変異判定
IF ABL:ARG:변이 > 0 && ABL:ARG:변이레벨 > 0
	IF ABL:ARG:변이레벨 <= BASE:ARG:LV
		IF FINDCHARA_NO_C(ABL:ARG:변이) == -1
			IF BASE:MASTER:LV >= GET_NEED_TRANSFORM_MASTER_LV(ARG)
				CALL TRANSFORM,ARG,ABL:ARG:변이
			ELSE
				PRINTFORMW %CALLNAME:ARG%의 몸에 이상 징후가 보인다……
			ENDIF
		ENDIF
	ENDIF
ENDIF

@GET_NEED_TRANSFORM_MASTER_LV, L_CHARA
