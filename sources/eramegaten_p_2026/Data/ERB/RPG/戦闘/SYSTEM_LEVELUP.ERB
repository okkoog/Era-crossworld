				CONTINUE
			TALENT:ARG:L_TALENTS = MAX(TOINT(AUTO_SPLIT(TEMPS, "_", 1)), 1, TALENT:ARG:L_TALENTS)
		NEXT
		CALL SET_ROLE_CP, ARG
		IF GET_ROLE_CP(ARG, "通常形態") < 0
			DRAWLINE
			PRINTFORML %CALLNAME:ARG%의 소질의 코스트가 커패시티의 상한을 초과하고 있습니다。
			PRINTFORMW 남길 소질을 선택해주세요。
			DRAWLINE
			CALL SET_VAR_HAVE_SUB_ROLE, ARG, "通常形態", L_BTL_TALENT
			;サブ素質を設定
			CALL ENHANCE_ROLE, ARG, "通常形態", L_BTL_TALENT, , "戻る不可"
		ENDIF
	ENDIF
	;衣装初期化
	CALL CLOTHES_INITIALIZE,ARG
	FOR LOCAL,0,CLOTHES_PARTNUM
		CFLAG:ARG:("초기" + GET_CLOTHESNAME(LOCAL)) = CSVCFLAG(NO:ARG,GETNUM(CFLAG,GET_CLOTHESNAME(LOCAL)),0)
		CFLAG:ARG:GET_CLOTHESNAME(LOCAL) = CSVCFLAG(NO:ARG,GETNUM(CFLAG,GET_CLOTHESNAME(LOCAL)),0)
	NEXT

	;---- EDIT 034 ADD END   -------------------------
	ANALYSIS_RATE:(NO:ARG) = ANALYSIS_COMPLETED
	SETBIT IS_CHARA_COMPANIONED:(NO:ARG), CFLAG:ARG:이벤트가입 < 0 ? 0 # CFLAG:ARG:이벤트가입	;変異後にキャラが死ぬパターンが発見されたため変異後にHP回復する様に追加
	BASE:ARG:ＨＰ = MAXBASE:ARG:ＨＰ
ENDIF
