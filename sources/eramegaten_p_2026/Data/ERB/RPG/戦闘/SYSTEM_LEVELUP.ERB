@CHECK_LEVEL_UP_AUTO2,ARG,ARG:1,ARG:2
#DIM LCOUNT
VARSET LOCAL
LOCAL:1 = ARG:1
LOCAL:10 = ARG:2	
;上昇比率が設定されていない場合ここで設定
