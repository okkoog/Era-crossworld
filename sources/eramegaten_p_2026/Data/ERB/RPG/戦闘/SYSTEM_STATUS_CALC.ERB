#DIM DYNAMIC L_HP補正_加算
#DIM DYNAMIC L_HP補正_固定
#DIM DYNAMIC L_LV
#DIM DYNAMIC L_力
#DIM DYNAMIC L_知
#DIM DYNAMIC L_魔
#DIM DYNAMIC L_耐
#DIM DYNAMIC L_速
#DIM DYNAMIC L_運

STOCK_MHP = MAXBASE:L_CHARA:ＨＰ

L_LV = MAXBASE:L_CHARA:LV
L_力 = MAXBASE:L_CHARA:힘
L_知 = MAXBASE:L_CHARA:지혜
L_魔 = MAXBASE:L_CHARA:마력
L_耐 = MAXBASE:L_CHARA:내구
L_速 = MAXBASE:L_CHARA:속도
L_運 = MAXBASE:L_CHARA:운
;---------------------------------------------------------------------
;HPの算出
;基本式:((Lv + 힘 * 2 + 耐 * 7 + 5) * 2 + 5) * (100 + Lv * 3)%
;---------------------------------------------------------------------
IF CFLAG:L_CHARA:PT플래그
	MAXBASE:L_CHARA:ＨＰ = (L_LV+L_力*2+L_耐*7+5)*(100+L_LV*3)/100
ELSE
	MAXBASE:L_CHARA:ＨＰ = (L_LV*3+L_力*2+L_耐*9/2+5)*(100+L_LV*3)/100
	;ボスフラグの倍率だけ違う
	IF CFLAG:L_CHARA:보스플래그
		;IF IS_CALK_HUMAN;EDIT 086 MOD
		IF GETS_ROLE_PROP("BATTLESTATUS_TYPE", L_CHARA) == "人間"
			MAXBASE:L_CHARA:ＨＰ *= 4 + (CFLAG:L_CHARA:보스플래그)
		ELSE
			MAXBASE:L_CHARA:ＨＰ *= 5 + (CFLAG:L_CHARA:보스플래그)
		ENDIF
	ENDIF
	;---- EDIT 002 MOD START -------------------------
	IF !FLAG:튜토리얼진행중
		SIF FLAG:전투난이도 > 3
			TIMES MAXBASE:L_CHARA:ＨＰ , 1.50
	ENDIF
	;---- EDIT 002 MOD END ---------------------------
ENDIF

;---------------------------------------------------------------------
;スキル・キャラ独自要素による補正呼び出し
;---------------------------------------------------------------------
L_HP補正_固定 = 0
L_HP補正_乗算 = 0
L_HP補正_加算 = 0
FOR LCOUNT:1, 0, TRYSKILLNUM(L_CHARA)
	RESULT = 0
	TEMP_SKILLS = %GET_TRYSKILL(L_CHARA, LCOUNT:1)%
	TEMP_SKILL = TOINT(TEMP_SKILLS)
	SIF TEMP_SKILLS == "0"
		CONTINUE
	RESULTS = "乗算"
	TRYCCALLFORM SKILL_ADD_STATUS_%TEMP_SKILLS%, "HP補正", , L_CHARA, TEMP_SKILL, TRYSKILL_VAR
		SIF !RESULT
			CONTINUE
		SELECTCASE RESULTS
			CASE "乗算"
				;戦闘中のスイッチ変化を考慮して現HPも増減させる;EDIT 085 DEL
				;SIF BASE:L_CHARA:ＨＰ > 0
				;	BASE:L_CHARA:ＨＰ = BASE:L_CHARA:ＨＰ * (100 + RESULT) / 100
				MAXBASE:L_CHARA:ＨＰ = MAXBASE:L_CHARA:ＨＰ * (100 + RESULT) / 100
			CASE "活泉"
				L_HP補正_乗算 = MAX(L_HP補正_乗算, RESULT)
			CASE "加算"
				L_HP補正_加算 += RESULT
			CASE "固定"
				L_HP補正_固定 = L_HP補正_固定 ? MIN(L_HP補正_固定, RESULT) # RESULT
		ENDSELECT
	CATCH
	ENDCATCH
NEXT
MAXBASE:L_CHARA:ＨＰ = MAXBASE:L_CHARA:ＨＰ * (100 + L_HP補正_乗算) / 100

;---- EDIT 095 ADD START -------------------------
;---------------------------------------------------------------------
;도핑/エレウシスの祈り等の補正
;---------------------------------------------------------------------
MAXBASE:L_CHARA:ＨＰ = MAXBASE:L_CHARA:ＨＰ * (CFLAG:L_CHARA:최대HP증가 + 100) / 100
;---- EDIT 095 ADD END ---------------------------

;---------------------------------------------------------------------
;サブ素質による補正
;---------------------------------------------------------------------
MAXBASE:L_CHARA:ＨＰ = MAXBASE:L_CHARA:ＨＰ * (GET_BTL_TALENT_LV("무도의마음가짐", L_CHARA) * 10 + 100) / 100

;---------------------------------------------------------------------
;その他システムによる補正
;---------------------------------------------------------------------
;妊娠している場合、一部の能力にボーナス？
;現状では最大ＨＰとＭＰが2割上昇
IF TALENT:L_CHARA:임신
	;ふたごちゃんパッチオンの場合：5人以上のわりとヤバい妊娠数だとさすがにステータスが下がる
	IF FLAG:쌍둥이플래그 > 0 && CFLAG:L_CHARA:이번수태인수 > 4
		TIMES MAXBASE:L_CHARA:ＨＰ , 0.80
	ELSEIF FLAG:쌍둥이플래그 > 0 && CFLAG:L_CHARA:이번수태인수 > 1
		;2～4だと補正無し
	ELSE
		TIMES MAXBASE:L_CHARA:ＨＰ , 1.20
	ENDIF
ENDIF
;崩壊している場合、ＨＰとＭＰが7割に
SIF TALENT:L_CHARA:붕괴
	TIMES MAXBASE:L_CHARA:ＨＰ , 0.70
SIF IS_CALC_ガチャ(L_CHARA)
	TIMES MAXBASE:L_CHARA:ＨＰ , 0.50

;---------------------------------------------------------------------
;HP補正及び乗算以外の固定値補正の反映
;---------------------------------------------------------------------
MAXBASE:L_CHARA:ＨＰ += CFLAG:L_CHARA:ＨＰ보정
MAXBASE:L_CHARA:ＨＰ += L_HP補正_加算

;HPが固定値ならここで固定する
IF L_HP補正_固定
	MAXBASE:L_CHARA:ＨＰ = L_HP補正_固定
ENDIF

BASE:L_CHARA:ＨＰ = MAX(BASE:L_CHARA:ＨＰ, 0);EDIT 083	補正に減算を入れた関係で発生するHPのマイナス化を防ぐ処理のミスを修正
MAXBASE:L_CHARA:ＨＰ = MAX(MAXBASE:L_CHARA:ＨＰ, 1)

IF STRCOUNT(L_OPT, "HPMP割合保持") || STRCOUNT(L_OPT, "ＨＰＭＰ割合保持") || L_HP補正_固定
	;小数点以下を扱えない関係でそのままやると切り捨てが凄まじいことになるケースがあるので桁数を増やす
	BASE:L_CHARA:ＨＰ *= POWER(10, 5)
	TEMP = (BASE:L_CHARA:ＨＰ % STOCK_MHP) > 0
	BASE:L_CHARA:ＨＰ = BASE:L_CHARA:ＨＰ / STOCK_MHP * MAXBASE:L_CHARA:ＨＰ
	BASE:L_CHARA:ＨＰ /= POWER(10, 5)
	BASE:L_CHARA:ＨＰ += TEMP
ENDIF
;---- EDIT 101 MOD START -------------------------
@SYNC_STATUS_TYPE, ARG
#DIM LCOUNT, 2
#DIM L_TYPE
#DIM TEMP
;#DIM TEMP_TYPE, 8
#DIM STOCK_TYPE
#DIM TEMP_TYPE_MAX
#DIM TEMP_TYPE_MIN
#DIM TEMP_SKILL
#DIMS TEMP_SKILLS
#DIM CAN_USE_EQUIP_TYPE;装備の相性をつかえるかどうか
#DIM CAN_USE_MAG_TYPE;MAG強化の相性をつかえるかどうか
#DIM CAN_USE_PLUGIN;プラグインの相性をつかえるかどうか
#DIM CAN_USE_PORTRAIT;写せ身の相性をつかえるかどうか
#DIM MAG_TYPE_CHARA;MAG強化の相性の参照先
#DIM BASE_TYPE_TRANS;悪魔変身の相性変化のタイプ
#DIM TYPE_CHARA_NUM;相性の参照先
#DIM TYPE_CSV_NUM;基本相性がCSV参照の場合
#DIM CHANGE_TYPE_SKILL_VALUE;スキルによる相性変化における相性値
#DIMS CHANGE_TYPE_SKILL_ABLE;スキルによる相性変化における上書き許可リスト(文字列指定)
#DIM CHANGE_TYPE_SKILL_RANK;スキルによる相性変化における優先度ランク
#DIM TEMP_HAVE_SKILL, 80;EDIT 096 MOD
#DIM CONST REFLECT_VAR = -99999;反射を大小比較に使うために一時的にマイナス化するための数値

;--------------------------------------------------------
;ロール毎にアクセスできる相性変更措置を取得する
;基本的には悪魔はMAG強化、人間は装備となるが、変身や半魔など例外が絡む
;--------------------------------------------------------
CAN_USE_EQUIP_TYPE = GET_ROLE_PROP("CAN_USE_EQUIP_TYPE", ARG);装備による相性変更を使えるか
CAN_USE_MAG_TYPE = GET_ROLE_PROP("CAN_USE_MAG_TYPE", ARG);MAG強化による相性変更を使えるか
CAN_USE_PLUGIN = GET_ROLE_PROP("CAN_USE_PLUGIN", ARG);プラグインによる相性変更を使えるか
CAN_USE_PORTRAIT = GET_ROLE_PROP("CAN_USE_PORTRAIT", ARG);写せ身による相性変更を使えるか

TYPE_CHARA_NUM = -1
TYPE_CSV_NUM = -1

IF CFLAG:ARG:링크캐릭터실제가입시간0 > 0 && STRCOUNT(GETS_ROLE_PROP("LINK_STATUS", ARG), "防御相性");MAG強化による相性の参照先(リンク悪魔か自分かとなる)
	TYPE_CHARA_NUM = FINDCHARA_LINK(ARG)
	SIF !STRCOUNT(GETS_ROLE_PROP("LINK_STATUS", ARG), "装備防御相性")
		CAN_USE_EQUIP_TYPE = 0
ELSE
	IF STRCOUNT(GETS_ROLE_PROP("TRANS_STATUS", ARG), "防御相性")
		TYPE_CSV_NUM = CFLAG:ARG:초기링크악마
	ELSE
		TYPE_CHARA_NUM = ARG
	ENDIF
ENDIF
BASE_TYPE_TRANS = 0;基本の相性をデフォルト変身悪魔からとるかどうか
CFLAG:ARG:MAG상성변경불가 = 0;相性変更より上位の変更で上書きされていてロックされている状態

;----------------------------------------------------
;相性の変更処理
;----------------------------------------------------
VARSET TEMP_HAVE_SKILL, 1
FOR LCOUNT, 0, TYPENUM
    L_TYPE = GETNUM(BASE, "검격") + LCOUNT
	;----------------------------------------------------
	;ベースとなる相性を登録する
	;----------------------------------------------------
	;非戦闘員はデフォルト値を設定しておく
	SIF TALENT:ARG:비전투원
		BASE:ARG:L_TYPE = BASENAME:L_TYPE != "파마" ? 100 # 0
	;---- EDIT P 001 MOD START -------------------------
	IF CAN_USE_PORTRAIT
		IF EQUIP:ARG:허물
			MAXBASE:ARG:L_TYPE = CSVBASE(EQUIP:ARG:허물, L_TYPE)
		ELSE
			MAXBASE:ARG:L_TYPE = 200
		ENDIF
	;ペルソナ使いは変更なし
	ELSEIF CSTR:ARG:롤 == "ペルソナ使い"
		MAXBASE:ARG:L_TYPE = MAXBASE:ARG:L_TYPE
	;リンク悪魔参照
	ELSEIF TYPE_CHARA_NUM >= 0
		MAXBASE:ARG:L_TYPE = BASE:TYPE_CHARA_NUM:L_TYPE
	ELSEIF TYPE_CSV_NUM >= 0
		MAXBASE:ARG:L_TYPE = CSVBASE(TYPE_CSV_NUM, L_TYPE)
	ELSE
		MAXBASE:ARG:L_TYPE = BASE:ARG:L_TYPE
	ENDIF
	;---- EDIT P 001 MOD END ---------------------------
	;---- EDIT 090 START -------------------------
	;----------------------------------------------------
	;MAG強化による相性変更
	;陥落状態に応じた数の耐性をMAGによって操作できる。(代入時点で判定されているのでここで条件を見る必要はない)
	;この耐性は元の耐性に対して無条件で上書きされる
	;
	;CFLAGの参照先はARGか、ARGのリンク悪魔。これは先に取得してある(MAG_TYPE_CHARA)
	;変更相性が相性と一致している場合に、変更相性値を入れるが、変更相性は未設定状態状態に0を使うために実際の相性番号と1ずらして代入しているのに注意
	;
	;info 	変更相性2は現在未使用(2022/11/22)
	;		枠だけ確保してあったのを見落として追加変更を作ってしまったものと思われる
	;----------------------------------------------------
	IF CAN_USE_MAG_TYPE
		;キャラ対象がいなくて見れる場合は自分自身を見る
		TEMP = TYPE_CHARA_NUM >= 0 ? TYPE_CHARA_NUM # ARG
		FOR LCOUNT:1, 1, 3 + 4
			IF LCOUNT:1 < 3
				SIF CFLAG:TEMP:@"변경상성{LCOUNT:1}" == LCOUNT + 1
					MAXBASE:ARG:L_TYPE = CFLAG:TEMP:@"변경상성치{LCOUNT:1}"
			ELSE
				;陥落履歴による追加
				SIF CFLAG:TEMP:@"추가변경상성{LCOUNT:1 - 2}" == LCOUNT + 1
					MAXBASE:ARG:L_TYPE = CFLAG:TEMP:@"추가변경상성치{LCOUNT:1 - 2}"
			ENDIF
		NEXT
	ENDIF
	;---- EDIT 090 END ---------------------------
	;----------------------------------------------------
	;装備とスキルによる相性変更
	;----------------------------------------------------
	TEMP_TYPE_MAX = 100
	TEMP_TYPE_MIN = 100
	
	;ここまでの計算上の数値をとっておく
	STOCK_TYPE = MAXBASE:ARG:L_TYPE
	;反射の場合、数値をマイナス化
	STOCK_TYPE = STOCK_TYPE == 999 ? REFLECT_VAR # STOCK_TYPE

	;----------------------------------------------------
	;装備による相性の取得
	;----------------------------------------------------
	IF CAN_USE_EQUIP_TYPE
		FOR LCOUNT:1,0,7
			CALL EQUIP_PROPERTY, EQUIP:ARG:(GET_EQUIP(LCOUNT:1)), "防御相性", LCOUNT, ARG
			SIF RESULT == 100
				CONTINUE
			;反射の場合扱いやすいように一旦数値を置き換える
			TEMP = RESULT == 999 ? REFLECT_VAR # RESULT
			TEMP_TYPE_MAX = MAX(TEMP_TYPE_MAX, TEMP)
			TEMP_TYPE_MIN = MIN(TEMP_TYPE_MIN, TEMP)
		NEXT
	ENDIF
	;スキルによる相性の取得
	FOR LCOUNT:1, 0, TRYSKILLNUM(ARG)
		;---- EDIT 094 MOD START -------------------------
		SIF TEMP_HAVE_SKILL:(LCOUNT:1) == 0
			CONTINUE
		RESULT = 0
		RESULTS = 
		TEMP_SKILLS = %GET_TRYSKILL(ARG, LCOUNT:1)%
		IF TEMP_SKILLS == "0"
			TEMP_HAVE_SKILL:(LCOUNT:1) = 0
			CONTINUE
		ELSE
			RESULT = 0
			TRYCCALLFORM SKILL_ADD_STATUS_%TEMP_SKILLS%, "相性", BASENAME:L_TYPE, ARG, MAXBASE:ARG:L_TYPE, TEMP_SKILL, TRYSKILL_VAR
				SIF !RESULT
					CONTINUE
				TEMP = RESULT:1 == 999 ? REFLECT_VAR # RESULT:1
				TEMP_TYPE_MAX = MAX(TEMP_TYPE_MAX, TEMP)
				TEMP_TYPE_MIN = MIN(TEMP_TYPE_MIN, TEMP)
			CATCH
				TEMP_HAVE_SKILL:(LCOUNT:1) = 0
			ENDCATCH
		ENDIF
		;---- EDIT 094 MOD END ---------------------------
	NEXT
	;------------------------------------------
	;補正の適用
	;元々の相性が耐性以上の場合
	;元々の相性が耐性/無効/吸収/反射
	;装備に弱点が混ざっていた場合は弱点が優先。ただし、ほかの装備で耐性を得られるならその耐性になる
	;
	;元々の相性が通常/弱点 
	;装備でほぼそのまま動く → 改善する装備がある場合は一番いい相性、ない場合は一番悪い相性が選定される
	;------------------------------------------
	;元々の相性が耐性以下の場合
	IF STOCK_TYPE < 100
		;補正にひとつでも耐性以上の相性をつけるものがある場合
		IF TEMP_TYPE_MIN < 100
			;補正に弱点以上の相性がある場合は本体の相性を使えなくなる
			IF TEMP_TYPE_MAX > 100
				;補正の中で一番いい相性を適用する
				MAXBASE:ARG:L_TYPE = TEMP_TYPE_MIN
			ELSE
				;弱点以上の相性が存在していないなら全ての相性のうちもっとも良いものが適用される・
				MAXBASE:ARG:L_TYPE = MIN(TEMP_TYPE_MIN, STOCK_TYPE)
			ENDIF
		;相性をよくする補正がない場合は一番相性が悪い補正が適用される。
		ELSEIF TEMP_TYPE_MAX > 100
			MAXBASE:ARG:L_TYPE = TEMP_TYPE_MAX
		;補正の相性が全て通常の場合はここに来るまでの計算結果がそのまま適用される
		ELSE
			MAXBASE:ARG:L_TYPE = STOCK_TYPE
		ENDIF
	;元々の相性が通常あるいは弱点
	ELSE
		;相性を改善する補正があった場合はもっとも良いものに
		IF TEMP_TYPE_MIN < 100
			MAXBASE:ARG:L_TYPE = TEMP_TYPE_MIN
		ELSE
			;一番良い相性でも通常以上なら、一番悪い相性を適用する
			MAXBASE:ARG:L_TYPE = MAX(TEMP_TYPE_MAX, STOCK_TYPE)
		ENDIF
	ENDIF
	;一時的に差し替えていた反射の数値を差し戻す
	SIF MAXBASE:ARG:L_TYPE == REFLECT_VAR
		MAXBASE:ARG:L_TYPE = 999
	;---- EDIT 101 MOD END ---------------------------
	;----------------------------------------------------
	;プラグインによる相性変更
	;----------------------------------------------------
	IF CAN_USE_PLUGIN
		;プラグイン（アクセサリ）を見る
		CALLFORM 防御相性_{EQUIP:ARG:악세서리}, LCOUNT,ARG
		SIF RESULT != 100
			MAXBASE:ARG:L_TYPE = RESULT
	ENDIF

	;----------------------------------------------------
	;スキルによる変化(タイミング2)
	;----------------------------------------------------
	;IF INRANGE(CHANGE_TYPE_SKILL_RANK, 10, 19)
	;	IF STRCOUNT(CHANGE_TYPE_SKILL_ABLE, GET_WEAKNESS(MAXBASE:ARG:GET_TYPE(LCOUNT)))
	;		MAXBASE:ARG:GET_TYPE(LCOUNT) = CHANGE_TYPE_SKILL_VALUE
	;		SETBIT CFLAG:ARG:MAG상성변경불가, LCOUNT
	;	ENDIF
	;ENDIF

	;----------------------------------------------------
	;その他の相性変更
	;----------------------------------------------------
	;蠅状態で耐性変更
	IF GET_STATE(CFLAG:ARG:상태이상) == "FLY"
		MAXBASE:ARG:L_TYPE = 100
		SIF GROUPMATCH(BASENAME:L_TYPE, "화염", "충격", "질풍", "핵열")
			MAXBASE:ARG:L_TYPE = 400
	ENDIF
	SIF GETBIT(CFLAG:ARG:분노약점부여,LCOUNT)
		MAXBASE:ARG:L_TYPE = 150
NEXT

@SYNC_STATUS_STATE, ARG
#DIM LCOUNT, 2
;#DIM TEMP_STATE, 8
#DIM TEMP_STATE_MAX
#DIM TEMP_STATE_MIN
#DIM TEMP_SKILL
#DIMS TEMP_SKILLS
#DIM TEMP_HAVE_SKILL, 80;EDIT 096 MOD
#DIM CAN_USE_EQUIP_STATE;装備のステートをつかえるかどうか
#DIM CAN_USE_MAG_STATE;MAG強化のステートをつかえるかどうか
#DIM CAN_USE_PLUGIN;プラグインのステートをつかえるかどうか
#DIM STATE_CHARA_NUM = -1
#DIM STATE_CSV_NUM = -1
;--------------------------------------------------------
;ロール毎にアクセスできる相性変更措置を取得する
;基本的には悪魔はMAG強化、人間は装備となるが、変身や半魔など例外が絡む
;--------------------------------------------------------
;---- EDIT 101 MOD START -------------------------
;-----------------------------------------
;ロールの判定を変数化
;関数の通過を減らして速度をあげるため
;-----------------------------------------
CAN_USE_EQUIP_STATE = GET_ROLE_PROP("CAN_USE_EQUIP_STATE", ARG);装備による相性変更を使えるか
CAN_USE_MAG_STATE = GET_ROLE_PROP("CAN_USE_MAG_STATE", ARG);MAG強化による相性変更を使えるか
CAN_USE_PLUGIN = GET_ROLE_PROP("CAN_USE_PLUGIN", ARG);プラグインによる相性変更を使えるか

STATE_CHARA_NUM = -1
STATE_CSV_NUM = -1
;ペルソナ使いはすでにMAXBASEが確定している
IF !TALENT:ARG:페르소나구사자
	;リンクしている場合はそのキャラ番号
	IF CFLAG:ARG:링크캐릭터실제가입시간0 > 0 && STRCOUNT(GETS_ROLE_PROP("LINK_STATUS", ARG), "ステート耐性")
		STATE_CHARA_NUM = FINDCHARA_LINK(ARG)
	;変身している場合
	ELSEIF STRCOUNT(GETS_ROLE_PROP("TRANS_STATUS", ARG), "ステート耐性")
		STATE_CSV_NUM = CFLAG:ARG:초기링크악마
	;その他は自分自身
	ELSE
		STATE_CHARA_NUM = ARG
	ENDIF
ENDIF

VARSET TEMP_HAVE_SKILL, 1
FOR LCOUNT,0,BADSTATENUM
	;-----------------------------------------
	;ベースの数値設定
	;-----------------------------------------
	SIF STATE_CHARA_NUM >= 0
		MAXBASE:ARG:GET_STATE(LCOUNT) = BASE:STATE_CHARA_NUM:GET_STATE(LCOUNT)
	SIF STATE_CSV_NUM >= 0
		MAXBASE:ARG:GET_STATE(LCOUNT) = CSVBASE(STATE_CSV_NUM, GETNUM(BASE , GET_STATE(LCOUNT)),0)

	;-----------------------------------------
	;装備及びスキルによる補正の取得
	;使用するのは最大値と最低値だけなのでそれだけ取っておく
	;-----------------------------------------
	TEMP_STATE_MAX = 0
	TEMP_STATE_MIN = 0
	;装備の耐性を取る
	IF CAN_USE_EQUIP_STATE
		FOR LCOUNT:1,0,7
			CALL EQUIP_PROPERTY, EQUIP:ARG:(GET_EQUIP(LCOUNT:1)), "バステ耐性", LCOUNT, ARG
			SIF !RESULT
				CONTINUE
			TEMP_STATE_MAX = MAX(TEMP_STATE_MAX, RESULT)
			TEMP_STATE_MIN = MIN(TEMP_STATE_MIN, RESULT)
		NEXT
	ENDIF
	;スキルの耐性を取る
	FOR LCOUNT:1, 0, TRYSKILLNUM(ARG)
		SIF TEMP_HAVE_SKILL:(LCOUNT:1) == 0
			CONTINUE
		RESULT = 0
		RESULTS = 
		TEMP_SKILLS = %GET_TRYSKILL(ARG, LCOUNT:1)%
		TEMP_SKILL = TOINT(TEMP_SKILLS)
		IF TEMP_SKILLS == "0"
			TEMP_HAVE_SKILL:(LCOUNT:1)	= 0
			CONTINUE
		ELSE
			RESULT = 0
			TRYCCALLFORM SKILL_ADD_STATUS_%TEMP_SKILLS%, "상태이상", GET_STATE(LCOUNT), ARG, MAXBASE:ARG:GET_STATE (LCOUNT), TEMP_SKILL, TRYSKILL_VAR
				SIF !RESULT
					CONTINUE
				TEMP_STATE_MAX = MAX(TEMP_STATE_MAX, RESULT)
				TEMP_STATE_MIN = MIN(TEMP_STATE_MIN, RESULT)
			CATCH
				TEMP_HAVE_SKILL:(LCOUNT:1) = 0
				CONTINUE
			ENDCATCH
		ENDIF
	NEXT

	;-----------------------------------------
	;補正の適用
	;1.耐性のマイナス(強化)がある場合は最も良い耐性になる。
	;2.耐性のプラス(弱化)がある場合は元々の耐性がマイナスであってもそれが消える。
	;3.耐性の候補がプラスだけならそのうちもっとも数値が大きい=悪いものが選ばれる
	;-----------------------------------------
	;耐性は100 + X形式なのでマイナスのほうが良い補正になる
	;元々の耐性がマイナス
	IF MAXBASE:ARG:(GET_STATE(LCOUNT)) < 0
		IF TEMP_STATE_MIN < 0
			;プラスの補正も存在する(これにより元々の補正が消える)
			IF TEMP_STATE_MAX > 0
				;補正の中で最も良いものを取る
				MAXBASE:ARG:(GET_STATE(LCOUNT)) = TEMP_STATE_MIN
			ELSE
				;元々の数値も含めて最も良いものを取る
				MAXBASE:ARG:(GET_STATE(LCOUNT)) = MIN(TEMP_STATE_MAX, MAXBASE:ARG:(GET_STATE(LCOUNT)))
			ENDIF
		;マイナスの装備がなくプラスの装備がある
		ELSEIF TEMP_STATE_MAX > 0
			;もっとも悪い補正を取る
			MAXBASE:ARG:(GET_STATE(LCOUNT)) = TEMP_STATE_MAX
		ENDIF
	ELSE
		;マイナスの補正がある
		IF TEMP_STATE_MIN < 0
			;最も良い補正になる
			MAXBASE:ARG:(GET_STATE(LCOUNT)) = TEMP_STATE_MIN
		ELSE
			;元々の耐性がマイナスの場合は元々の耐性のままとなる
			IF MAXBASE:ARG:(GET_STATE(LCOUNT)) < 0
				MAXBASE:ARG:(GET_STATE(LCOUNT)) = MAXBASE:ARG:(GET_STATE(LCOUNT))
			;元々の耐性が0以上なら最も悪い耐性になる
			ELSE
				MAXBASE:ARG:(GET_STATE(LCOUNT)) = MAX(TEMP_STATE_MAX, MAXBASE:ARG:(GET_STATE(LCOUNT)))
			ENDIF
		ENDIF
	ENDIF

	;;----------------------------------------------------
	;プラグインによる相性変更
	;----------------------------------------------------
	IF CAN_USE_PLUGIN
		;プラグイン（アクセサリ）を見る
		RESULT = 0
		TRYCALLFORM バステ耐性_{EQUIP:ARG:악세서리}, LCOUNT,ARG
		SIF RESULT != 0
			MAXBASE:ARG:GET_STATE(LCOUNT) = RESULT
	ENDIF
NEXT

;---------------------------------------------------
;武器の番号からデビルアームズで取得するスキルを取得する
;ARG = 무기
;---------------------------------------------------
@GET_DEVIL_ARMS_SKILL, ARG
#DIM LCOUNT
#DIM L_RESULT, 3
#DIM TEMP_SKILL, 3
VARSET L_RESULT, 0, 0, 3
;---- EDIT 093 ADD START -------------------------
VARSET TEMP_SKILL
;---- EDIT 093 ADD END ---------------------------
;武器種から取得する
TRYCCALLFORM 剣タイプ_{ARG}
	SELECTCASE GET_ARMS_TYPE(RESULT)
		CASE "刀"
			TEMP_SKILL = [[스킬:이검난무]], [[스킬:회전베기]], [[스킬:허공참파]]
		CASE "레이피어"
			TEMP_SKILL = [[스킬:안개베기]], [[스킬:데스바운드]], [[스킬:공간살법]]
		CASE "弓"
			TEMP_SKILL = [[스킬:연속사격]], [[스킬:찰나장대비쏘기]], [[스킬:오절절우]]
		CASE "검"
			TEMP_SKILL = [[스킬:양팔찍기]], [[스킬:낭아천주참]], [[스킬:낙양삼단격]]
		CASE "槍"
			TEMP_SKILL = [[스킬:이단찌르기]], [[스킬:용아선회]], [[스킬:작열거가]]
		CASE "斧・鈍器"
			TEMP_SKILL = [[스킬:극락왕생파]], [[스킬:대나무베기]], [[스킬:천경지폭단]]
		CASE "채찍"
			TEMP_SKILL = [[스킬:사랑의채찍]], [[스킬:구십구나선격]], [[스킬:부월쇄파]]
		CASE "投具"
			TEMP_SKILL = [[스킬:더블샷]], [[스킬:암파쌍비조]], [[스킬:고천열풍탄]]
		CASE "杖・祭具"
			TEMP_SKILL = [[스킬:메기도]], [[스킬:메기도라]], [[스킬:메기도라온]]
		CASE "棍"
			TEMP_SKILL = [[스킬:방어부수기]], [[스킬:절묘타]], [[스킬:팔상발파]]
		CASE "拳闘具"
			TEMP_SKILL = [[스킬:소닉펀치]], [[스킬:기간피스트]], [[스킬:메테오피스트]]
		CASEELSE
	ENDSELECT
	RESULT = 1
	TRYCALLFORM 必要レベル_{ARG}
	L_RESULT = TEMP_SKILL:((RESULT >= 25) + (RESULT >= 50))
CATCH
ENDCATCH
VARSET RESULT, 0, 0, 3
;武器固有スキルを確認する
TRYCCALLFORM デビルアームズ追加スキル_{ARG}
	;3つ指定されている場合は武器種スキルの枠を潰す
	;-1を指定した場合は枠を潰す。固有ひとつのみといった形にするならX, -1, -1のように指定
	IF MATCH(RESULT, 0, 0, 3) == 0
		L_RESULT = RESULT, RESULT:1, RESULT:2
	ELSE
		FOR LCOUNT, 0, 3
			SIF RESULT:LCOUNT > 0
				L_RESULT:FINDELEMENT(L_RESULT, 0) = RESULT:LCOUNT
		NEXT
	ENDIF
	FOR LCOUNT, 0, 3
		L_RESULT:LCOUNT = L_RESULT:LCOUNT < 0 ? 0 # L_RESULT:LCOUNT
	NEXT
CATCH
ENDCATCH
RETURN L_RESULT, L_RESULT:1, L_RESULT:2
