;---- EDIT P 003 MOD START -------------------------
;-------------------------------------------------------------------
;메시아프로젝트(旧ハーモナイザー) + 함락의악마
;戦闘ステータスに応じてステータスを上乗せする。
;数値は旧ハーモナイザーの最大出力をそのまま流用、バランス調整外要素
;悪魔と人間の格差の根源というか、基礎力が揃っている前提を踏まえて全員に等しく加算されるように変更
;-------------------------------------------------------------------
VARI L_POWER
L_POWER += SOFT_ON("메시아프로젝트") * 60
SIF !GET_ROLE_PROP("CAN_USE_EQUIP", ARG) && !FLAG:전투스테이터스계산식통일 && !CFLAG:ARG:비장착형스테이터스계산지정
	L_POWER += SOFT_ON("함락의악마") * 陥落(ARG) * 20
IF L_POWER > 0 && CFLAG:ARG:PT플래그 > 0
	BASE:ARG:공격 += (L_LV*3/2+L_力*3/2+L_耐*1/2) * L_POWER / 100
	BASE:ARG:명중 += (L_LV+L_速*3/2+L_運*1/2) * L_POWER / 100
	BASE:ARG:방어 += (L_LV+L_耐*2+(L_力)/2) * L_POWER / 100
	BASE:ARG:회피 += (L_LV+L_速*3/2+L_運*1/2) * L_POWER / 100
	BASE:ARG:마법위력 += (L_LV*3/2+L_魔*3/2+L_知*1/2) * L_POWER / 100
	BASE:ARG:마법효과 += (L_LV+L_知+L_運/2+L_魔/2) * L_POWER / 100
	BASE:ARG:총공격 += (L_LV + L_知/2 + L_速/2) * L_POWER / 100
	BASE:ARG:총명중 += (L_LV+L_速+L_運+L_知) * L_POWER / 100
	BASE:ARG:도구명중 += (L_LV*2+MAX(L_速, 3+L_LV/4)*5/2+MAX(L_魔, 3+L_LV/4)) * L_POWER / 100
	BASE:ARG:도구위력 += (L_LV*2+MAX(L_知, 3+L_LV/4)*5/2+MAX(L_運, 3+L_LV/4)) * L_POWER / 100
ENDIF
;---- EDIT P 003 MOD END ---------------------------
