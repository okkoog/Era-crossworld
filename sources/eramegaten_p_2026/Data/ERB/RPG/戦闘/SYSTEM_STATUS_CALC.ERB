;========================================================
;基本ステータスの計算(LV/힘/知/魔/耐/速/운)
;BASEはレベル上昇等で得られる基本ステータスで、それに装備・スキル・調教など諸々の補正を加えたものがMAXBASEとなる
;実際に各種計算に使うのはMAXBASE
;========================================================
;------------------------------------------------------
;即戦力プラグインによるMAG強化調整
;一定のMAG強化がほどこされてるのとおなじになるようにステータスを割り振っていく
;------------------------------------------------------
VARI TEMP_強化回数, 7
FOR LCOUNT, 1, BASESTATUSNUM
	TEMP_強化回数:LCOUNT = CFLAG:ARG:(GET_BASESTATUS(LCOUNT) + "강화횟수")
NEXT
;引継ぎ制限下では基礎数値の100%までにMAG強化が制限される
IF CFLAG:ARG:베어내기플래그
	VARI MAX_STAT_SUM = BASE:ARG:LV * 3/ 2 + 18
	IF SUMARRAY(TEMP_強化回数) > MAX_STAT_SUM
		VARI TEMP_SUM
		TEMP_SUM = SUMARRAY(TEMP_強化回数)
		FOR LCOUNT, 1, BASESTATUSNUM
			TEMP_強化回数:LCOUNT = TEMP_強化回数:LCOUNT * (MAX_STAT_SUM) / TEMP_SUM
		NEXT
		;端数調整　ふってある箇所を低い順にみて１づつ埋めていく
		VARI TEMP_KEY, 7
		VARI TEMP_ARRAY, 7
		TEMP_KEY = TEMP_強化回数:1, TEMP_強化回数:2, TEMP_強化回数:3, TEMP_強化回数:4, TEMP_強化回数:5, TEMP_強化回数:6
		TEMP_ARRAY = 1, 2, 3, 4, 5, 6
		ARRAYMSORT TEMP_KEY, TEMP_ARRAY
		LCOUNT = 0
		WHILE MAX_STAT_SUM > SUMARRAY(TEMP_強化回数)
			TEMP_強化回数:(TEMP_ARRAY:LCOUNT) += 1
			SIF LCOUNT++ == 5
				LCOUNT = 0
		WEND
	ELSE
		SIF CFLAG:ARG:능력강화횟수 <= MAX_STAT_SUM
			CFLAG:ARG:베어내기플래그 = 0
	ENDIF
ENDIF
IF SOFT_ON("즉전력플러그인") && (GETS_ROLE_PROP("BATTLESTATUS_TYPE", ARG) == "悪魔"  || FLAG:전투스테이터스계산식통일)
	;基本ステータスの33%が最大値
	VARI SUM_ADD_STAT = BASE:ARG:LV / 2 + 6
	VARI CSV_STAT, 7
	;MAG強化が実施されている数だけひいていく。またCSV比率を取っておく
	FOR LCOUNT, 1, BASESTATUSNUM
		SUM_ADD_STAT -= TEMP_強化回数:LCOUNT
		CSV_STAT:LCOUNT = CSVBASE(NO:ARG, GETNUM(BASE, GET_BASESTATUS(LCOUNT)))
	NEXT
	SIF SUMARRAY(CSV_STAT) == 0
		VARSET CSV_STAT, 1, 1, BASESTATUSNUM
	;CSVの比率にあわせて割り振っていく
	IF SUM_ADD_STAT > 0
		VARI ADD_STAT, 7
		FOR LCOUNT, 1, BASESTATUSNUM
			ADD_STAT:LCOUNT = SUM_ADD_STAT * CSV_STAT:LCOUNT / SUMARRAY(CSV_STAT)
			ADD_STAT:LCOUNT = SUM_ADD_STAT * CSV_STAT:LCOUNT / SUMARRAY(CSV_STAT)
		NEXT
		;端数調整
		WHILE SUM_ADD_STAT != SUMARRAY(ADD_STAT)
			IF SUM_ADD_STAT > SUMARRAY(ADD_STAT)
				ADD_STAT:FINDELEMENT(ADD_STAT, MINARRAY(ADD_STAT, 1, BASESTATUSNUM), 1, BASESTATUSNUM) += 1
			ELSE
				ADD_STAT:FINDELEMENT(ADD_STAT, MAXARRAY(ADD_STAT, 1, BASESTATUSNUM), 1, BASESTATUSNUM) -= 1
			ENDIF
		WEND
		FOR LCOUNT, 1, BASESTATUSNUM
			TEMP_強化回数:LCOUNT += ADD_STAT:LCOUNT
		NEXT
	ENDIF
ENDIF
;------------------------------------------------------
;デビルシフター・喰奴のステータス再計算用の数値を設定
;------------------------------------------------------
VARSET LSUM_OF_BASE
VARSET LMANTRA_FIXED_STATUS
FOR LCOUNT, 1, BASESTATUSNUM
	LSUM_OF_BASE += BASE:ARG:(GET_BASESTATUS(LCOUNT))
	LSUM_OF_BASE:1 += BASE:ARG:(GET_BASESTATUS(LCOUNT)) + TEMP_強化回数:LCOUNT
	
	;喰奴の振り分けの参照先はマントラによる補正の影響を受ける
	;SIF TALENT:ARG:식노
	SIF GETS_ROLE_PROP("BASESTATUS_TYPE", ARG) == "식노"
		LMANTRA_FIXED_STATUS:LCOUNT = MAX(CSVBASE(CFLAG:ARG:초기링크악마 , GETNUM(BASE , GET_BASESTATUS(LCOUNT)) , 0) + CFLAG:ARG:((GET_BASESTATUS(LCOUNT)) + "만트라보정"), 0)
NEXT

;------------------------------------------------------
;リンクキャラの指定
;------------------------------------------------------
LINK_CHARA = FINDCHARA_LINK(ARG)

;------------------------------------------------------
;ベースになる部分の設定
;普通のキャラはBASE(LV上昇で獲得したステータス) + MAG強化
;
;悪魔変身は上記のステータスを変身先にあわせて再分配あるいは追加ボーナスを獲得する
;------------------------------------------------------
FOR LCOUNT,0,BASESTATUSNUM
	;レベルは共通でそのまま引き写す
	IF GET_BASESTATUS(LCOUNT) == "LV"
		MAXBASE:ARG:LV = BASE:ARG:LV + CFLAG:ARG:LV강화횟수
		L_BASE_STATUS:0 = BASE:ARG:LV
	ELSE
		;------------------------------------------------------------------------------------
		;バニラ設定のデビルシフター:	変身後悪魔のステータス比率になるようにBASEステータスを振り直す
		;------------------------------------------------------------------------------------
		;IF CFLAG:ARG:악마변신 && TALENT:ARG:데빌시프터 && FLAG:데빌시프터스탯설정 == 0
		IF GETS_ROLE_PROP("BASESTATUS_TYPE", ARG) == "데빌시프터"
			IF LINK_CHARA > 0
				MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) = LSUM_OF_BASE * BASE:(LINK_CHARA):GET_BASESTATUS(LCOUNT)
				MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) /= 18 + BASE:(LINK_CHARA):LV * 3 / 2
			ELSE
				MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) = LSUM_OF_BASE * CSVBASE(CFLAG:ARG:초기링크악마 , GETNUM(BASE , GET_BASESTATUS(LCOUNT)) , 0)
				MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) /= 18 + CSVBASE(CFLAG:ARG:초기링크악마 , GETNUM(BASE , "LV") , 0) * 3 / 2
			ENDIF
			;割合による変更が加わる可能性を考慮して振り分け後のステータスを残しておく
			L_BASE_STATUS:LCOUNT = MAXBASE:ARG:(GET_BASESTATUS(LCOUNT))
			;振り分け終了後に強化回数を加算
			MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += TEMP_強化回数:LCOUNT
		;------------------------------------------------------------------------------------
		;喰奴の悪魔変身:	変身後悪魔のステータス比率になるようにBASEステータスとMAG強化を振り直す
		;
		;ステータスの合計値 * 変身後の各ステータス / 変身後の合計ステータス　って感じの計算です
		;この時点で0になるのは避けておく
		;------------------------------------------------------------------------------------
		;ELSEIF CFLAG:ARG:악마변신 && TALENT:ARG:식노
		ELSEIF GETS_ROLE_PROP("BASESTATUS_TYPE", ARG) == "식노"
			;他の強化に渡すためにMAG強化抜きの数値をとっておく
			L_BASE_STATUS:LCOUNT = LSUM_OF_BASE * LMANTRA_FIXED_STATUS:LCOUNT
			L_BASE_STATUS:LCOUNT = MAX(L_BASE_STATUS:LCOUNT / SUMARRAY(LMANTRA_FIXED_STATUS), 1)
			;強化値込みの振り直し
			MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) = LSUM_OF_BASE:1 * LMANTRA_FIXED_STATUS:LCOUNT
			MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) = MAX(MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) / SUMARRAY(LMANTRA_FIXED_STATUS), 1)
		;------------------------------------------------------------------------------------
		;その他のロールはそのままMAXBASEを算出
		;------------------------------------------------------------------------------------
		ELSE
			MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) = BASE:ARG:(GET_BASESTATUS(LCOUNT)) + TEMP_強化回数:LCOUNT
			L_BASE_STATUS:LCOUNT = BASE:ARG:(GET_BASESTATUS(LCOUNT))
			;------------------------------------------------------------------------------------
			;新式シフターとアイオン式はリンク悪魔のステータスに応じたステータスボーナスを得る
			;------------------------------------------------------------------------------------
			IF STRCOUNT(GETS_ROLE_PROP("BASESTATUS_TYPE", ARG), "リンク悪魔加算") && LINK_CHARA >= 0
				MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += BASE:(LINK_CHARA):GET_BASESTATUS(LCOUNT) / 10
			ELSE
				IF STRCOUNT(GETS_ROLE_PROP("BASESTATUS_TYPE", ARG), "初期悪魔加算")
					MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += CSVBASE(CFLAG:ARG:초기링크악마, GETNUM(BASE , GET_BASESTATUS(LCOUNT)) , 0) / 5
					MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += BASE:ARG:LV / 30
				ENDIF
			ENDIF
		ENDIF
	ENDIF
NEXT

;-------------------------------------------------------
;シフター・喰奴の振り分けの端数処理で消失したステータスを補填
;-------------------------------------------------------
IF CFLAG:ARG:악마변신 && ((TALENT:ARG:데빌시프터 && FLAG:데빌시프터스탯설정 == 0) || TALENT:ARG:식노)
	VARSET TEMP_STATUS
	FOR LCOUNT:1, 0, 2
		;作業用に一度TEMP変数に移す
		FOR LCOUNT, 1, BASESTATUSNUM
			TEMP_STATUS:LCOUNT = LCOUNT:1 ? MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) # L_BASE_STATUS:LCOUNT
		NEXT
		;振り分け元の合計ステータスと現在のステータスの合計が一致していない場合、もっとも低いものに加算、あるいは最も高いものに減算を繰り返して数値をあわせる
		WHILE SUMARRAY(TEMP_STATUS) != LSUM_OF_BASE:(LCOUNT:1)
			IF SUMARRAY(TEMP_STATUS) > LSUM_OF_BASE:(LCOUNT:1)
				TEMP_STATUS:FINDELEMENT(TEMP_STATUS, MAXARRAY(TEMP_STATUS, 1, BASESTATUSNUM), 1, BASESTATUSNUM)--
			ELSE
				TEMP_STATUS:FINDELEMENT(TEMP_STATUS, MINARRAY(TEMP_STATUS, 1, BASESTATUSNUM), 1, BASESTATUSNUM)++
			ENDIF
		WEND
		;調整後の数値を代入
		FOR LCOUNT, 1, BASESTATUSNUM
			IF LCOUNT:1
				MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) = TEMP_STATUS:LCOUNT
			ELSE
				L_BASE_STATUS:LCOUNT = TEMP_STATUS:LCOUNT
			ENDIF
		NEXT
	NEXT
ENDIF

;-------------------------------------------------------
;装備・パッシブスキル・調教による基本ステータス補正
;-------------------------------------------------------
FOR LCOUNT, 0, BASESTATUSNUM
	;装備による補正。なおプラグインもアクセサリーなのでここになる。
	LEQUIP_FIXED_VALUE = 0
	;---- EDIT 100 MOD START -------------------------
	;---- EDIT 099 MOD START -------------------------
	;IF CFLAG:ARG:악마변신 == 0
	FOR LCOUNT:1,0,7
		IF INRANGE(EQUIP:ARG:(GET_EQUIP(LCOUNT:1)), MIN_PLUGINNUM, MAX_PLUGINNUM - 1)
			SIF !GET_ROLE_PROP("CAN_USE_PLUGIN", ARG)
				CONTINUE
		ELSE
			IF !GET_ROLE_PROP("CAN_USE_EQUIP", ARG)
				CALL EQUIP_PROPERTY, EQUIP:ARG:(GET_EQUIP(LCOUNT:1)), "装備箇所"
				IF GET_EQUIP(RESULT) == "총"
					SIF !GET_ROLE_PROP("CAN_EQUIP_GUN", ARG)
						CONTINUE
				ELSE
					CONTINUE
				ENDIF
			ENDIF
		ENDIF
		IF 魔晶装備(EQUIP:ARG:(GET_EQUIP(LCOUNT:1)))
			CALLFORM 基本能力修正_魔晶装備,LCOUNT,EQUIP:ARG:(GET_EQUIP(LCOUNT:1)) - 2450 -450*LCOUNT:1
		ELSE
			CALLFORM 基本能力修正_{EQUIP:ARG:(GET_EQUIP(LCOUNT:1))}, LCOUNT, ARG
		ENDIF
		LEQUIP_FIXED_VALUE += RESULT
	NEXT
	MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += LEQUIP_FIXED_VALUE
	;ENDIF
	;---- EDIT 099 MOD END ---------------------------
	;---- EDIT 100 MOD END ---------------------------
	;所持スキルによる補正
	LSKILL_FIXED_VALUE = 0
	FOR LCOUNT:1, 0, TRYSKILLNUM(ARG)
		RESULT = 0
		TEMP_SKILLS = %GET_TRYSKILL(ARG, LCOUNT:1)%
		TEMP_SKILL = TOINT(TEMP_SKILLS)
		SIF TEMP_SKILLS == "0"
			CONTINUE
		;ARGS, ARGS:1, ARG, ARG:1, SKILL_NUM, GIVE_EFFECT_CHARA
		TRYCCALLFORM SKILL_ADD_STATUS_%TEMP_SKILLS%, "基本ステータス", GET_BASESTATUS(LCOUNT), ARG, L_BASE_STATUS:LCOUNT, TEMP_SKILL, TRYSKILL_VAR
			LSKILL_FIXED_VALUE += RESULT
		CATCH
		ENDCATCH
	NEXT
	MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += LSKILL_FIXED_VALUE
	;---- EDIT P 003 MOD START -------------------------
	;---- EDIT 056 MOD START -------------------------
	IF ARG == MASTER
		SELECTCASE LCOUNT
			CASE 1,3
				MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += FLAG:이번주회음란인수 + (FLAG:이번주회신뢰인수 / 3 )
			CASE 2,5
				MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += FLAG:이번주회복종인수 + (FLAG:이번주회신뢰인수 / 3 )
			CASE 4,6
				MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += FLAG:이번주회연모인수 + (FLAG:이번주회신뢰인수 / 3 )
		ENDSELECT
	ELSE
		IF 陥落(ARG) > 0
			SELECTCASE LCOUNT
				CASE 1,3
					MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += TALENT:ARG:음란 + TALENT:ARG:창부*2 + 陥落(ARG)/2 + TALENT:ARG:음마
				CASE 2,5
					MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += TALENT:ARG:복종 + TALENT:ARG:예속*2 + 陥落(ARG)/2 + TALENT:ARG:노리개
				CASE 4,6
					MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += TALENT:ARG:연모 + TALENT:ARG:친애*2 + 陥落(ARG)/2 + (TALENT:ARG:아내 || TALENT:ARG:남편)
			ENDSELECT
		ENDIF
		;허니문&ディボース補正
		IF ABL:ARG:종족 > 0 && LCOUNT > 0
			MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += (SOFT_ON("허니문")) * 陥落(ARG) + (SOFT_ON("디보스")) * MARK:ARG:반발각인
		ENDIF
	ENDIF
	;---- EDIT P 003 MOD END ---------------------------
	;バ・ベル修正
	IF ARG == MASTER && SOFT_ON("바・벨")
		IF FLAG:벨신격파 & 64
			MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += 5
		ELSE
			SIF LCOUNT && GETBIT(FLAG:벨신격파, LCOUNT-1)
				MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += 3
		ENDIF
	ENDIF
	;---- EDIT 056 MOD END ---------------------------
	;---- EDIT 086 ADD START -------------------------
	;ブースタ系素質
	IF LCOUNT > 0
		TEMP = GET_BTL_TALENT_LV(AUTO_SPLIT("파워/인트/매직/바이탈/스피드/럭", "/", LCOUNT - 1) + "부스터", ARG)
		MAXBASE:ARG:GET_BASESTATUS(LCOUNT) += TEMP * ((BASE:ARG:LV / 25) + (BASE:ARG:LV % 25 > 0))
		MAXBASE:ARG:GET_BASESTATUS(LCOUNT) += GET_BTL_TALENT_LV("올부스터", ARG) * ((BASE:ARG:LV / 40) + (BASE:ARG:LV % 40 > 0))
	ENDIF
	;---- EDIT 086 ADD END ---------------------------

	SIF TALENT:ARG:붕괴 && LCOUNT > 0
		TIMES MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) , 0.80
	SIF TALENT:ARG:임신
		MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) += 1
	;ふたごちゃんパッチオンの場合：5人以上のわりとヤバい妊娠数だとさすがにステータスが下がる
	;2以上でプラマイゼロ、5以上でマイナス１
	SIF FLAG:쌍둥이플래그 > 0 && CFLAG:ARG:이번수태인수 > 1
		MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) -= 1
	SIF FLAG:쌍둥이플래그 > 0 && CFLAG:ARG:이번수태인수 > 4
		MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) -= 1

	;もろもろ計算で0以下になった場合は1に修正
	SIF MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) < 1
		MAXBASE:ARG:(GET_BASESTATUS(LCOUNT)) = 1
NEXT
;ペルソナ修正
IF TALENT:ARG:페르소나구사자 && !CFLAG:ARG:악마변신
	CALL SYNC_STATUS_P(ARG)
ENDIF

;------------------------------------------------------------
;調教効果をここに記述・基本能力
;------------------------------------------------------------
;---- EDIT 056 MOD START -------------------------
IF ARG != MASTER && CFLAG:ARG:PT플래그 > 0
;---- EDIT 056 MOD END ---------------------------
	MAXBASE:ARG:LV += (MIN(ABL:ARG:순종,10) + MIN(ABL:ARG:욕망,10) + MIN(ABL:ARG:기교,10) +3)/6
	;---- EDIT 032 MOD START -------------------------
	IF TALENT:ARG:맹우
		MAXBASE:ARG:힘 += 7
		MAXBASE:ARG:마력 += 7
		MAXBASE:ARG:운 += 7
		MAXBASE:ARG:내구 += 7
		MAXBASE:ARG:지혜 += 7
		MAXBASE:ARG:속도 += 7
	ELSE
	;---- EDIT 032 MOD END ---------------------------
		MAXBASE:ARG:힘 += (MIN(ABL:ARG:욕망,10)+1)/2
		MAXBASE:ARG:마력 += (MIN(ABL:ARG:욕망,10)+1)/2
		MAXBASE:ARG:운 += (MIN(ABL:ARG:순종,10)+1)/2
		MAXBASE:ARG:내구 += (MIN(ABL:ARG:순종,10)+1)/2
		MAXBASE:ARG:지혜 += (MIN(ABL:ARG:기교,10)+1)/2
		MAXBASE:ARG:속도 += (MIN(ABL:ARG:기교,10)+1)/2
	ENDIF
ENDIF

;装備スキルがステータスに関与する可能性があるので処理順を変更

;---- EDIT 029 MOD START -------------------------
;武器素質　一ノ型パラメータ補正
;武器の必要レベルの1/2に、個別の倍率をかけた数値を加算する。
;-------------------------------------------------
CALL MATCHING_WEAPON_CHECK(ARG)
LCOUNT = RESULT
CALL WEAPON_STYLE_CHECK(ARG,LCOUNT)
IF RESULT == 1
	RESULT = 0
	TRYCALLFORM 必要レベル_{EQUIP:ARG:검}
	RESULT = MIN(RESULT , 100)
	RESULT = RESULT/2 + MIN(RESULT%2 , 1)
	SELECTCASE LCOUNT
		CASE 1
			MAXBASE:ARG:힘 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:속도 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:운 += RESULT/3 + MIN(RESULT%3 , 1)
		CASE 2
			MAXBASE:ARG:지혜 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:속도 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:운 += RESULT/3 + MIN(RESULT%3 , 1)
		CASE 3
			MAXBASE:ARG:힘 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:마력 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:속도 += RESULT/3 + MIN(RESULT%3 , 1)
		CASE 4
			MAXBASE:ARG:힘 += RESULT/4 + MIN(RESULT%4 , 1)
			MAXBASE:ARG:내구 += RESULT/4 + MIN(RESULT%4 , 1)
			MAXBASE:ARG:속도 += RESULT/4 + MIN(RESULT%4 , 1)
			MAXBASE:ARG:운 += RESULT/4 + MIN(RESULT%4 , 1)
		CASE 5
			MAXBASE:ARG:힘 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:내구 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:운 += RESULT/3 + MIN(RESULT%3 , 1)
		CASE 6
			MAXBASE:ARG:힘 += RESULT/2 + MIN(RESULT%2 , 1)
			MAXBASE:ARG:내구 += RESULT/2 + MIN(RESULT%2 , 1)
		CASE 7
			MAXBASE:ARG:지혜 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:마력 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:내구 += RESULT/3 + MIN(RESULT%3 , 1)
		CASE 8
			MAXBASE:ARG:지혜 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:마력 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:속도 += RESULT/3 + MIN(RESULT%3 , 1)
		CASE 9
			MAXBASE:ARG:지혜 += RESULT/2 + MIN(RESULT%2 , 1)
			MAXBASE:ARG:마력 += RESULT/2 + MIN(RESULT%2 , 1)
		CASE 10
			MAXBASE:ARG:지혜 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:내구 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:속도 += RESULT/3 + MIN(RESULT%3 , 1)
		CASE 11
			MAXBASE:ARG:힘 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:내구 += RESULT/3 + MIN(RESULT%3 , 1)
			MAXBASE:ARG:속도 += RESULT/3 + MIN(RESULT%3 , 1)
	ENDSELECT
ENDIF

;--------------------------------------------------
;状態異常による変化
;--------------------------------------------------
;FLYはLvと速さ以外を1にする
IF IS_BADSTATE(ARG, "FLY")
	MAXBASE:ARG:LV = MAXBASE:ARG:LV
	MAXBASE:ARG:힘 = 1
	MAXBASE:ARG:지혜 = 1
	MAXBASE:ARG:마력 = 1
	MAXBASE:ARG:내구 = 1
	MAXBASE:ARG:속도 = MAXBASE:ARG:속도
	MAXBASE:ARG:운 = 1
ENDIF

MAXBASE:ARG:LV += CFLAG:ARG:LV보정

;---- EDIT P 001 ADD START -------------------------
;========================================================
;継承素質設定
;========================================================
IF GET_ROLE_PROP("CAN_USE_PORTRAIT", ARG)
	VARI L_TALENT_NO
	FOR LCOUNT, 0, SUCCESSIONNUM
		L_TALENT_NO = GETNUM(TALENT, GET_SUCCESSION(LCOUNT))
		IF EQUIP:ARG:허물
			TALENT:ARG:L_TALENT_NO = CSVTALENT(EQUIP:ARG:허물, L_TALENT_NO)
		ELSE
			TALENT:ARG:L_TALENT_NO = 0
		ENDIF
	NEXT
ELSEIF CSTR:ARG:롤 == "ペルソナ使い"
	VARI L_TALENT_NO
	FOR LCOUNT, 0, SUCCESSIONNUM
		L_TALENT_NO = GETNUM(TALENT, GET_SUCCESSION(LCOUNT))
		TALENT:ARG:L_TALENT_NO = CSVTALENT(ABL:ARG:초기페르소나, L_TALENT_NO)
	NEXT
ELSEIF GET_ROLE_PROP("TRANS_STATUS", ARG, "通常形態") && STRCOUNT(RESULTS_F, "継承素質") 
	FOR LCOUNT, 0, SUCCESSIONNUM
		L_TALENT_NO = GETNUM(TALENT, GET_SUCCESSION(LCOUNT))
		TALENT:ARG:L_TALENT_NO = CSVTALENT(CFLAG:ARG:초기링크악마, L_TALENT_NO)
	NEXT
ELSEIF GET_ROLE_PROP("LINK_STATUS", ARG, "通常形態") && STRCOUNT(RESULTS_F, "継承素質")
	FOR LCOUNT, 0, SUCCESSIONNUM
		L_TALENT_NO = GETNUM(TALENT, GET_SUCCESSION(LCOUNT))
		IF LINK_CHARA > 0
			TALENT:ARG:L_TALENT_NO = TALENT:LINK_CHARA:L_TALENT_NO
		ELSE
			TALENT:ARG:L_TALENT_NO = CSVTALENT(CFLAG:ARG:초기링크악마, L_TALENT_NO)
		ENDIF
	NEXT
ENDIF
;---- EDIT P 001 ADD END ---------------------------
;========================================================
;相性設定
;========================================================
CALL SYNC_STATUS_TYPE, ARG

;--------------------------------------------------------
;バステ耐性の設定
;--------------------------------------------------------
CALL SYNC_STATUS_STATE, ARG

;====================================================
;戦闘ステータスの算出
;HP/MP/공격/방어/마법위력/마법효과/총공격/총명중/도구위력/도구명중
;====================================================
;---------------------------------------------------------------------
;算出に利用する基本ステータスを収納
;---------------------------------------------------------------------
L_LV = MAXBASE:ARG:LV
L_力 = MAXBASE:ARG:힘
L_知 = MAXBASE:ARG:지혜
L_魔 = MAXBASE:ARG:마력
L_耐 = MAXBASE:ARG:내구
L_速 = MAXBASE:ARG:속도
L_運 = MAXBASE:ARG:운


;---------------------------------------------------------------------
;HPの算出
;基本式:((Lv + 힘 * 2 + 耐 * 7 + 5) * 2 + 5) * (100 + Lv * 3)%
;---------------------------------------------------------------------
;HP共有の確認
CALL GET_LINKED_HP_CHARA, ARG
VARI LINKED_CHARA = RESULT
IF LINKED_CHARA >= 0
	CALL SYNC_STATUS_HP, LINKED_CHARA, L_OPT
	BASE:ARG:ＨＰ = BASE:LINKED_CHARA:ＨＰ
	MAXBASE:ARG:ＨＰ = MAXBASE:LINKED_CHARA:ＨＰ
ELSE
	CALL SYNC_STATUS_HP, ARG, L_OPT
ENDIF

;---------------------------------------------------------------------
;MPの算出
;
;基本式:((Lv + 知 * 1/2 + 魔 * 3/2) * 2 + 5) * (100 + Lv)%
;---------------------------------------------------------------------
;MPを持たないキャラはここで終わる
;IF !HAVE_MAXMP(ARG)
IF !GET_ROLE_PROP("HAVE_MP", ARG)
	MAXBASE:ARG:ＭＰ = 0
ELSE
	MAXBASE:ARG:ＭＰ = ((L_LV+L_知/2+(L_魔*3/2))*2 + 5) * (100+L_LV)/100

	;人間と悪魔はボスフラグの倍率だけ違う
	IF CFLAG:ARG:보스플래그
		;IF IS_CALC_HUMAN　EDIT 086
		IF GETS_ROLE_PROP("BATTLESTATUS_TYPE", ARG) == "人間"
			MAXBASE:ARG:ＭＰ *= 4 + (CFLAG:ARG:보스플래그)
		ELSE
			MAXBASE:ARG:ＭＰ *= 5 + CFLAG:ARG:보스플래그
		ENDIF
	ENDIF
	;---------------------------------------------------------------------
	;スキル・キャラ独自要素による補正呼び出し
	;---------------------------------------------------------------------
	L_MP補正_固定 = 0
	L_MP補正_乗算 = 0
	L_MP補正_加算 = 0

	FOR LCOUNT:1, 0, TRYSKILLNUM(ARG)
		RESULT = 0
		RESULTS = "乗算"
		TEMP_SKILLS = %GET_TRYSKILL(ARG, LCOUNT:1)%
		TEMP_SKILL = TOINT(TEMP_SKILLS)
		SIF TEMP_SKILLS == "0"
			CONTINUE
		TRYCCALLFORM SKILL_ADD_STATUS_%GET_TRYSKILL(ARG, LCOUNT:1)%, "MP補正", , ARG, TEMP_SKILL, TRYSKILL_VAR
			SIF !RESULT
				CONTINUE
			SELECTCASE RESULTS
				CASE "乗算"
					;戦闘中のスイッチ変化を考慮して現HPも増減させる;EDIT 085 DEL
					;SIF BASE:ARG:ＭＰ > 0
					;	BASE:ARG:ＭＰ = BASE:ARG:ＭＰ * (100 + RESULT) / 100
					MAXBASE:ARG:ＭＰ = MAXBASE:ARG:ＭＰ * (100 + RESULT) / 100
				CASE "魔脈"
					L_MP補正_乗算 = MAX(L_MP補正_乗算, RESULT)
				CASE "加算"
					L_MP補正_加算 += RESULT
				CASE "固定"
					L_MP補正_固定 = L_MP補正_固定 ? MIN(L_MP補正_固定, RESULT) # RESULT
			ENDSELECT
		CATCH
		ENDCATCH
	NEXT
	MAXBASE:ARG:ＭＰ = MAXBASE:ARG:ＭＰ * (100 + L_MP補正_乗算) / 100

	;---------------------------------------------------------------------
	;その他補正
	;---------------------------------------------------------------------
	;妊娠している場合、一部の能力にボーナス？
	;現状では最大ＨＰとＭＰが2割上昇
	IF TALENT:ARG:임신
		;ふたごちゃんパッチオンの場合：5人以上のわりとヤバい妊娠数だとさすがにステータスが下がる
		IF FLAG:쌍둥이플래그 > 0 && CFLAG:ARG:이번수태인수 > 4
			TIMES MAXBASE:ARG:ＭＰ , 0.80
		ELSEIF FLAG:쌍둥이플래그 > 0 && CFLAG:ARG:이번수태인수 > 1
			;2～4だと補正無し
		ELSE
			TIMES MAXBASE:ARG:ＭＰ , 1.20
		ENDIF
	ENDIF
	;崩壊している場合、ＨＰとＭＰが7割に
	SIF TALENT:ARG:붕괴
		TIMES MAXBASE:ARG:ＭＰ , 0.70
	SIF IS_CALC_ガチャ(ARG)
		TIMES MAXBASE:ARG:ＭＰ, 0.50
	
	;---------------------------------------------------------------------
	;固定値加算の処理
	;---------------------------------------------------------------------
	MAXBASE:ARG:ＭＰ += CFLAG:ARG:ＭＰ보정
	;BASE:ARG:ＭＰ = BASE:ARG:ＭＰ * (MAXBASE:ARG:ＭＰ + L_MP補正_加算) / MAXBASE:ARG:ＭＰ;EDIT 085 DEL
	MAXBASE:ARG:ＭＰ += L_MP補正_加算

	;MPが固定値ならここで固定する
	IF L_MP補正_固定
		;BASE:ARG:ＭＰ = BASE:ARG:ＭＰ * L_MP補正_固定 / MAXBASE:ARG:ＭＰ
		MAXBASE:ARG:ＭＰ = L_MP補正_固定
	ENDIF
	BASE:ARG:ＭＰ = MAX(BASE:ARG:ＭＰ, 0)
	MAXBASE:ARG:ＭＰ = MAX(MAXBASE:ARG:ＭＰ, 0)
ENDIF

