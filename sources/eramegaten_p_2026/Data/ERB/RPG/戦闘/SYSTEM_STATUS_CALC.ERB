		IF TEMP_SKILL:LCOUNT
			;---- EDIT 099 ADD START -------------------------
			;デビルアームズ由来のスキルであることを記録する
			C_DEVIL_ARMS_SKILL:ARG:LCOUNT = TEMP_SKILL:LCOUNT
