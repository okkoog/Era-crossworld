;================================================================================
;装備のステータス補正
;
;補填措置が重複しているため、補正値が非常に高く算出される
;人間強化OP・ハーモナイザー・装備の性能向上の3点により人間のステータスは高くでる仕様になっている。
;================================================================================
;LVが80を超えている場合、装備部分に相当する補正を追加で与える(装備が存在しなくなることに対する補填1)
TEMP = MAX(BASE:ARG:LV - 80, 0)

;生得武器でない武器でかつ、オプションで偏りを変更している場合
IF GET_ROLE_PROP("CAN_USE_EQUIP", ARG)  && !FLAG:전투스테이터스계산식통일 && !CFLAG:ARG:비장착형스테이터스계산지정
	IF CFLAG:ARG:장비보정변경횟수 > 0 && EQUIP:ARG:검 != GETNUM(ITEM, "리빙・엣지")
		MAXBASE:ARG:공격 += TEMP * CFLAG:ARG:1040 / 4
		MAXBASE:ARG:명중 += TEMP * CFLAG:ARG:1041 / 4
		MAXBASE:ARG:방어 += TEMP * CFLAG:ARG:1042 / 4
		MAXBASE:ARG:회피 += TEMP * CFLAG:ARG:1043 / 4
		MAXBASE:ARG:마법위력 += TEMP * CFLAG:ARG:1044 / 4
		MAXBASE:ARG:마법효과 += TEMP * CFLAG:ARG:1045 / 4
	ELSE
		;生得武器はデフォルトの偏りになる
		MAXBASE:ARG:공격 += TEMP * 9 / 4
		MAXBASE:ARG:명중 += TEMP * 7 / 4
		MAXBASE:ARG:방어 += TEMP * 11 / 4
		MAXBASE:ARG:회피 += TEMP * 7 / 4
		MAXBASE:ARG:마법위력 += TEMP * 9 / 4
		MAXBASE:ARG:마법효과 +=TEMP * 7 / 4
	ENDIF
	MAXBASE:ARG:도구명중 += TEMP * 7 / 4
	MAXBASE:ARG:도구위력 += TEMP * 9 / 4
ENDIF

;装備品の補正(銃ステ以外の6つ)
FOR LCOUNT,0,EQUIP_BATTLESTATUSNUM
	LEQUIP_FIXED_VALUE = 0
	FOR LCOUNT:1,0,7
		;使用条件の確認
		SELECTCASE GET_EQUIP(LCOUNT:1)
			CASE "총"
				SIF !GET_ROLE_PROP("CAN_EQUIP_GUN", ARG)
					CONTINUE
			CASEELSE
				SIF FLAG:전투스테이터스계산식통일
					CONTINUE
				SIF CFLAG:ARG:비장착형스테이터스계산지정
					CONTINUE
				SIF !GET_ROLE_PROP("CAN_USE_EQUIP", ARG)
					CONTINUE
				;装備知識で装備可能になっている場合、使用改変版だと効果が発生しない
				SIF GET_ROLE_PROP("CAN_USE_EQUIP", ARG) == 2 && BATTLE_SETTING_IS_EQUIPTHEORY() == 1
					CONTINUE
		ENDSELECT
		IF 魔晶装備(EQUIP:ARG:(GET_EQUIP(LCOUNT:1)))
			CALLFORM 戦闘能力修正_魔晶装備,LCOUNT,EQUIP:ARG:(GET_EQUIP(LCOUNT:1)) - 2450 -450*LCOUNT:1
		ELSE
			CALLFORM 戦闘能力修正_{EQUIP:ARG:(GET_EQUIP(LCOUNT:1))},LCOUNT,ARG
			CALL 装備強化_展開, ARG, EQUIP:ARG:GET_EQUIP(LCOUNT:1), "戦闘能力修正", GET_BATTLESTATUS(LCOUNT), RESULT
		ENDIF
		LFIXED_VALUE = RESULT

		;部位ごとの補正
		SELECTCASE GET_EQUIP(LCOUNT:1)
			CASE "검"
				;武器素質
				IF GET_ROLE_PROP("CAN_USE_WEAPON_MASTERY", ARG)
					TRYCCALLFORM 剣タイプ_{EQUIP:ARG:GET_EQUIP(LCOUNT:1)}
						IF RESULT > 0
							;---- EDIT 029 MOD
							SIF TALENT:ARG:(249 + RESULT) && LFIXED_VALUE > 0
								TIMES LFIXED_VALUE,1.10
							SIF TALENT:ARG:(249 + RESULT) && LFIXED_VALUE < 0
								TIMES LFIXED_VALUE,0.50
						ENDIF
					CATCH
					ENDCATCH
				ENDIF
			CASEELSE
		ENDSELECT
		;LVが100を超えている場合、(Lv-100)%分の補正を追加で与える(装備が存在しなくなることに対する補填2)
		;魔晶装備は必要レベル関数でレベルを取れないので適用外になっている
		IF BASE:ARG:LV > 100
			TRYCCALLFORM 必要レベル_{EQUIP:ARG:GET_EQUIP(LCOUNT:1)}
				SIF RESULT > 69
					LFIXED_VALUE = LFIXED_VALUE * BASE:ARG:LV / 100
			CATCH
			ENDCATCH
		ENDIF
		LEQUIP_FIXED_VALUE += LFIXED_VALUE
	NEXT

	;装備知識があるときは専用のテーブルに流す
	IF SKILL_EQUIPTHEORY_IS_HAVE_SKILL(ARG)
		MAXBASE:ARG:(GET_BATTLESTATUS(LCOUNT)) += SKILL_EQUIPTHEORY_EQUIP_STATUS(ARG, LEQUIP_FIXED_VALUE)
	ELSE
		MAXBASE:ARG:(GET_BATTLESTATUS(LCOUNT)) += LEQUIP_FIXED_VALUE
		;オプションで人間強化がON担っている場合はLV/2%のボーナスを追加する
		;SIF FLAG:人間戦闘ステ設定 == 3 && GETS_ROLE_PROP("BATTLESTATUS_TYPE", ARG) == "人間"
		;	MAXBASE:ARG:(GET_BATTLESTATUS(LCOUNT)) += LEQUIP_FIXED_VALUE * (BASE:ARG:LV/2) / 100
	ENDIF
NEXT

;---- EDIT P 003 ADD START -------------------------
;-------------------------------------------------------------------
;新ハーモナイザー
;装備込みのステータスを悪魔計算のステータスと比較して、劣っている場合
;両者の平均までステータスを増やす
;弱い装備を使っていて本来のスペックを発揮できていない場合の補填となる。
;-------------------------------------------------------------------
IF GETS_ROLE_PROP("BATTLESTATUS_TYPE", ARG) == "人間" && SOFT_ON("하모나이저") && CFLAG:ARG:PT플래그 && !FLAG:전투스테이터스계산식통일 && !CFLAG:ARG:비장착형스테이터스계산지정
	FOR LCOUNT, 0, VARSIZE("BTL_STAT_TABLE")
		MAXBASE:ARG:(BTL_STAT_TABLE:LCOUNT) = MAX(MAXBASE:ARG:(BTL_STAT_TABLE:LCOUNT), (DEVIL_BTL_STAT:LCOUNT + MAXBASE:ARG:(BTL_STAT_TABLE:LCOUNT)) * 50 / 100)
	NEXT
