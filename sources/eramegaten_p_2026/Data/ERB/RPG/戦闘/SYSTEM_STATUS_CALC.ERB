CFLAG:ARG:기본피타겟율 = 100
FOR LCOUNT:1, 0, TRYSKILLNUM(ARG)
	RESULT = 0
	TEMP_SKILLS = %GET_TRYSKILL(ARG, LCOUNT:1)%
	TEMP_SKILL = TOINT(TEMP_SKILLS)
	SIF TEMP_SKILLS == "0"
		CONTINUE
	TRYCCALLFORM SKILL_ADD_STATUS_%GET_TRYSKILL(ARG, LCOUNT:1)%, "被ターゲット率", , ARG, TEMP_SKILL, TRYSKILL_VAR
		SIF !RESULT
			CONTINUE
		CFLAG:ARG:기본피타겟율 = LIMIT(CFLAG:ARG:기본피타겟율 * RESULT / 100, 1, 1000)
	CATCH
	ENDCATCH
