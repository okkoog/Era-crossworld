;---------------------------------------------------------------------
;HPMPの割合保持措置
;悪魔変身等の変身スキル等はこの処置を通すのを推奨
;
;固定処理はHPがえらいことになるので常に割合保持させる
;---------------------------------------------------------------------
IF STRCOUNT(L_OPT, "HPMP割合保持") || STRCOUNT(L_OPT, "ＨＰＭＰ割合保持") || L_MP補正_固定
	;0除算の可能性があるので元々のMMPが0の場合は一応弾いておく
	IF STOCK_MMP > 0
		BASE:ARG:ＭＰ *= POWER(10, 5)
		TEMP = (BASE:ARG:ＭＰ % STOCK_MMP) > 0
		BASE:ARG:ＭＰ = BASE:ARG:ＭＰ / STOCK_MMP * MAXBASE:ARG:ＭＰ
		BASE:ARG:ＭＰ /= POWER(10, 5)
		BASE:ARG:ＭＰ += TEMP
	ENDIF
ENDIF
