			SIF MATCH(TEMP_HAVE_SKILL, TEMP_SKILL)
				CONTINUE
			TEMP_HAVE_SKILL:FINDELEMENT(TEMP_HAVE_SKILL, 0) = TEMP_SKILL
			ABL:ARG:@"장비스킬{LSKILL_COUNT+1}" = TEMP_SKILL
			LSKILL_COUNT++
		NEXT
	NEXT
ENDIF
