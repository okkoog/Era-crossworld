IF TALENT:ARG:인수라
	LSKILL_COUNT = 0
	FOR LCOUNT:1,0,20
		RESULT = 0
		TRYCALLFORM P習得スキル_{EQUIP:ARG:(GET_EQUIP(6))},LCOUNT:1
		TEMP_SKILL = RESULT
		TEMP_SKILL_LV = RESULT:1
		LOCALS = 습득스킬{LSKILL_COUNT+1}
		LOCALS:2 = 습득LV{LSKILL_COUNT+1}
		;装備品に習得スキル&LVが存在してて、かつ習得経験が無いことが条件
		IF TEMP_SKILL > 0 && TEMP_SKILL_LV > 0 && !(CDFLAG:ARG:((EQUIP:ARG:(GET_EQUIP(6)))%5+1):((EQUIP:ARG:(GET_EQUIP(6))-8000)/5) & POWER(2,LCOUNT:1))
			ABL:ARG:LOCALS = TEMP_SKILL
			ABL:ARG:(LOCALS:2) = TEMP_SKILL_LV
			LSKILL_COUNT += 1
		ELSE
			ABL:ARG:LOCALS = 0
			ABL:ARG:(LOCALS:2) = 0
			LSKILL_COUNT += 1
		ENDIF
	NEXT
