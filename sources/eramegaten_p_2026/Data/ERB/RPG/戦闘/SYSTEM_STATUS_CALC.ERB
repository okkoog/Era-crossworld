;------------------------------------------------------------
;戦闘ステータスの補正
;------------------------------------------------------------
;戦闘ステータスは基本ステータスからの変換がまずややこしく、
;さらに計算式に適用する段階でややこしく結果がプレイヤー・製作者ともに分かりづらいという問題があり
;(ダメージの倍率として計算する際は二次関数になってるんで、130%でも元攻撃力次第で実ダメージが1.6倍になったりする)
;また、計算式の倍率要素と乗算されてインフレを加速する問題があるので
;基本的にはダメージ算出式のほうに補正をかけるのを推奨します
;
;例:攻撃1.2倍はダメージが1.2~1.44倍になりますが、ダメージ+20%は20%増えるのがわかりやすいです
;------------------------------------------------------------
;==============================
;キャパシティオーバー/過負荷のステータス補正
;==============================
TEMP = 100 - GET_ROLE_BTL_ST_PENALTY(ARG)
IF TEMP < 100
	;---- EDIT 095 MOD START -------------------------
	;FOR LCOUNT, 0, GUN_BATTLESTATUSNUM
	FOR LCOUNT, 0, BATTLESTATUSNUM
		MAXBASE:ARG:GET_BATTLESTATUS(LCOUNT) = MAXBASE:ARG:GET_BATTLESTATUS(LCOUNT) * TEMP / 100
	NEXT
	;MAXBASE:ARG:도구명중 = MAXBASE:ARG:도구명중 * TEMP / 100
	;MAXBASE:ARG:도구위력 = MAXBASE:ARG:도구위력 * TEMP / 100
	;---- EDIT 095 MOD END ---------------------------
ENDIF

;==============================
;魔人学園専用技に関する処理ここまで
;==============================
;ガチャモードがONで、味方なら{(種族悪魔and全書召喚不可でない)or(造魔である)}andガチャ素質が無い　なら色々半減
IF IS_CALC_ガチャ(ARG)
	TIMES MAXBASE:ARG:공격 , 0.50
	TIMES MAXBASE:ARG:명중 , 0.50
	TIMES MAXBASE:ARG:방어 , 0.50
	TIMES MAXBASE:ARG:회피 , 0.50
	TIMES MAXBASE:ARG:마법위력 , 0.50
	TIMES MAXBASE:ARG:마법효과 , 0.50
	TIMES MAXBASE:ARG:총공격 , 0.50
	TIMES MAXBASE:ARG:총명중 , 0.50
	TIMES MAXBASE:ARG:도구위력 , 0.50 
	TIMES MAXBASE:ARG:도구명중 , 0.50
ENDIF

;---- EDIT 086 ADD START -------------------------
C_HAVE_SUCCESSIONNUM:ARG:0 = 0
FOR LCOUNT, 0, SUCCESSIONNUM
	C_HAVE_SUCCESSIONNUM:ARG:0 += 相性素質チェック_F(ARG, LCOUNT)
NEXT

;---- EDIT 086 ADD END ---------------------------
;------------------------------------------------------------------
;必要経験値の設定
;基本式 5 * Lv * (Lv + 1) * (Lv +2) / 3
;人間以外の場合は陥落していないときに1.25倍の補正がかかる
;------------------------------------------------------------------
CALL SET_NEXT_EXP, ARG

;------------------------------------------------------------------
;所持可能MAGの設定
;基本式 15 * Lv * (Lv + 1) * (Lv +2)
;MASTERと造魔は5倍
;陥落1段階で+20%
;------------------------------------------------------------------
IF ARG == MASTER
	;--- MOD 039 START---
	;片キンフラグあり
	IF GETBIT(イベントフラグ:93:11, 60)
		MAXBASE:ARG:ＭＡＧ  = (15)*(L_LV)*(L_LV+1)*(L_LV+2)
	;なし（通常）
	ELSE
		MAXBASE:ARG:ＭＡＧ  = (75)*(L_LV)*(L_LV+1)*(L_LV+2)
	ENDIF
	;--- MOD 039 END---
ELSE
	MAXBASE:ARG:ＭＡＧ  = (15+陥落(ARG)*3)*(L_LV)*(L_LV+1)*(L_LV+2)
	;造魔は5倍のMAGを持てる
	SIF ABL:ARG:종족 == 45
		MAXBASE:ARG:ＭＡＧ *= 5
	;---- EDIT 107 ADD START -------------------------
	;非戦闘員や戦闘参加不能などのキャラのMAG上限が低い関係で体力・気力を強化しづらいので
	;低レベル帯に限って上限を前借りさせる
	MAXBASE:ARG:ＭＡＧ += MAX(25000 - L_LV * 100, 0)
	;---- EDIT 107 ADD END ---------------------------
ENDIF

SIF MAXBASE:ARG:ＭＡＧ < 1
	MAXBASE:ARG:ＭＡＧ = 1
;---- EDIT 097 ADD START -------------------------
;数値が異常な場合、ここでなおす
BASE:ARG:ＭＡＧ = LIMIT(BASE:ARG:ＭＡＧ, 0, MAXBASE:ARG:ＭＡＧ)
;---- EDIT 097 ADD END ---------------------------

;------------------------------------------------------------------
;抗体ポイントの設定(消費MAG)
;------------------------------------------------------------------
;---- EDIT 103 MOD START -------------------------
;IF CSVBASE(NO:ARG,GETNUM(BASE,"CP"),0) != 0 && CFLAG:ARG:PT플래그 > 0
;IF GET_ROLE_PROP("NEED_MAG", ARG) && CFLAG:ARG:PT플래그 > 0
IF (GET_ROLE_PROP("NEED_MAG", ARG) || CFLAG:ARG:매각불가능 == -1) && CFLAG:ARG:PT플래그 > 0 && CFLAG:ARG:매각불가능 != 1
;---- EDIT 103 MOD END ---------------------------
	LOCAL:1 = 15
	FOR LOCAL,0,TYPENUM +1
		SELECTCASE MAXBASE:ARG:(GET_TYPE(LOCAL))
			CASE 999
				LOCAL:1 += 55
			CASE IS < 0
				LOCAL:1 += 55
			CASE 0
				LOCAL:1 += 40
			CASE IS > 199
				LOCAL:1 -= 25
			CASE IS > 100
				LOCAL:1 -= 15
			CASE IS <= 50
				LOCAL:1 += 25
			CASE IS < 100
				LOCAL:1 += 15
		ENDSELECT
	NEXT
	BASE:ARG:CP = MAX(1,LOCAL:1/2) + CFLAG:ARG:ＣＰ보정
	;プラグインによる補正
	TRYCCALLFORM 増加CP_{EQUIP:ARG:악세서리}
		RESULT += 100
	CATCH
		RESULT = 100
	ENDCATCH
	MAXBASE:ARG:CP = MAX(1,BASE:ARG:CP * MAXBASE:ARG:LV / 50 * (100-MIN(10000,GET_CHARA_LOYALTY(ARG))*50/10000) / 100 * RESULT / 100)
	MAXBASE:ARG:￥ = MAX(1,BASE:ARG:CP * MAXBASE:ARG:LV * (100-MIN(5000,GET_CHARA_LOYALTY(ARG))*90/5000) / 100)
ELSE
	;MAXBASE:ARG:CP = BASE:ARG:CP * MAXBASE:ARG:LV / 50
	BASE:ARG:CP = 0
	MAXBASE:ARG:CP = 0
	MAXBASE:ARG:￥ = 0
ENDIF

;主人の場合、属性が変動する。
;主人以外も変化するようにしてみる
;LD
SELECTCASE CFLAG:ARG:선악치
	CASE IS > 170
