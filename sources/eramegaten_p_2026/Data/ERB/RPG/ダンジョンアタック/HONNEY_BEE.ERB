@HONEY_BEE
#DIMS DYNAMIC SHOW_LINE
#DIM DYNAMIC L_LINE
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC TEMP
#DIMS DYNAMIC TEMPS
#DIMS DYNAMIC SHOW_MODE
#DIM DYNAMIC SELECT_NUM
#DIMS DYNAMIC L_TILE
#DIM DYNAMIC L_COLOR
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC CAN_FLOOR_MOVE;階層移動を許可するか
#LOCALSIZE 6
;LOCALに今いる階を保存
LOCAL:2 = FLAG:현M
$SET_USER_TILE_DATA
IF DUNGEON_ENABLE_MANUAL_MAPPING
	FOR L_Y, 0, FLAG:최대Y
		FOR L_X, 0, FLAG:최대X
			TEMP_USER_COLOR:L_X:L_Y = GET_FLOOR_USER_COLOR_T(L_X, L_Y)
			TEMP_USER_OBJECT:L_X:L_Y = GET_FLOOR_USER_OBJECT_T(L_X, L_Y)
		NEXT
	NEXT
ENDIF
L_LINE = LINECOUNT
$HONEY_BEE_LOOP
CLEARLINE LINECOUNT - L_LINE
CUSTOMDRAWLINE =
CALLFORM FLOORNAME_{FLAG:현던전}
IF IS_DEBUG || SOFT_ON("허니・비")
	CAN_FLOOR_MOVE = 1
ELSE
	CAN_FLOOR_MOVE = 0
ENDIF
PRINTL
IF !IS_DEBUG && SHOW_MODE == ""
	FOR LOCAL:1,0,FLAG:최대Y
		FOR LOCAL,0,FLAG:최대X
			IF FLAG:현X == LOCAL && FLAG:현Y == LOCAL:1 && (FLAG:현M == LOCAL:2)
				SETCOLOR 0x33ffcc
				PRINT ＠
				RESETCOLOR
				CONTINUE
			ENDIF
			IF DA:(FLAG:현X):(FLAG:현Y) % 10 == -1 && !(SOFT_ON("다크스캐너") || SOFT_ON("허니・비")) && FLAG:라이트마 == 0 && ABS(LOCAL-FLAG:현X)+ABS(LOCAL:1-FLAG:현Y) > 1
				SETCOLOR 0x202020
				PRINT ？
				RESETCOLOR
				CONTINUE
			ENDIF
			IF GET_FLOOR_ANALYZE_T(LOCAL, LOCAL:1) > 0
				CALL DG_GET_TILE(LOCAL, LOCAL:1, FLAG:현M, FLAG:현던전)
				SIF DUNGEON_ENABLE_MANUAL_MAPPING && TEMP_USER_COLOR:LOCAL:(LOCAL:1) > 0  && RESULTS != "　"
					SETCOLOR DUNGEON_USER_TILE_COLOR:(TEMP_USER_COLOR:LOCAL:(LOCAL:1))
				;ユーザーオブジェクト
				SIF DUNGEON_ENABLE_MANUAL_MAPPING && TEMP_USER_OBJECT:LOCAL:(LOCAL:1) > 0 && RESULTS != "　"
					RESULTS '= DUNGEON_USER_TILE_OBJECT:(TEMP_USER_OBJECT:LOCAL:(LOCAL:1))
				PRINTFORM %RESULTS%
			ELSE
				PRINT 　
			ENDIF
			RESETCOLOR
		NEXT
		SIF FLAG:최대X < 45
			PRINTFORM 　　　
		IF LOCAL:1 < 11
			IF SHOW_MODE == "SETCOLOR" && SELECT_NUM == LOCAL:1
				CALL PRINT_COLOR, "【", COLOR("yellow")
			ELSE
				PRINT  [
			ENDIF
			SETCOLOR DUNGEON_USER_TILE_COLOR:(LOCAL:1)
			PRINTBUTTON "■", @"MAPPING_USER_COLOR/{LOCAL:1}"
			RESETCOLOR
			IF SHOW_MODE == "SETCOLOR" && SELECT_NUM == LOCAL:1
				CALL PRINT_COLOR, "】", COLOR("yellow")
			ELSE
				PRINT ] 
			ENDIF
			SIF FLAG:최대X < 45
				PRINTFORM %" " * 2%
			FOR LCOUNT, 0, 3 - LIMIT(FLAG:최대X - 48, 0, 6) / 2
				IF LOCAL:1 == 0 && LCOUNT > 0
					PRINTFORM %" " * 6%
				ELSE
					TEMP = LOCAL:1 + LCOUNT * 11 - LCOUNT
					TEMPS = 
					IF SHOW_MODE == "SETOBJECT" && SELECT_NUM == TEMP
						TEMPS += "【"
					ELSE
						TEMPS += " ["
					ENDIF
					IF TEMP == 0
						TEMPS += "　"
					ELSE 
						TEMPS += DUNGEON_USER_TILE_OBJECT:TEMP
					ENDIF
					IF SHOW_MODE == "SETOBJECT" && SELECT_NUM == TEMP 
						TEMPS += "】"
					ELSE
						TEMPS += "] "
					ENDIF
					SIF SELECT_NUM == TEMP
						SETCOLOR COLOR("yellow")
					PRINTBUTTON TEMPS, @"MAPPING_USER_OBJECT/{TEMP}"
					RESETCOLOR
				ENDIF
			NEXT
		ELSE
			PRINT 　　　
		ENDIF
		PRINTL
	NEXT
ELSE
	FOR LOCAL:1,0,FLAG:최대Y
		SHOW_LINE = 
		FOR LOCAL,0,FLAG:최대X
			IF FLAG:현X == LOCAL && FLAG:현Y == LOCAL:1 && (FLAG:현M == LOCAL:2)
				L_TILE '= SET_COLOR_TAG("＠", TOSTR(0x33ffcc))
				L_TILE '= SET_BUTTON_TAG(L_TILE, , @"[{LOCAL}/{LOCAL:1}]　　　[{DA:LOCAL:(LOCAL:1)}]")
			ELSE
				IF DA:LOCAL:(LOCAL:1) % 10 == -1 && !(SOFT_ON("다크스캐너") || SOFT_ON("허니・비")) && FLAG:라이트마 == 0
					L_TILE '= SET_COLOR_TAG("？", TOSTR(0x202020))
				ELSEIF GET_FLOOR_ANALYZE_T(LOCAL, LOCAL:1)
					CALL DG_GET_TILE(LOCAL, LOCAL:1, FLAG:현M, FLAG:현던전)
					L_COLOR = GETCOLOR()
					;特殊タイルで色がデフォのものに着色
					IF DA:LOCAL:(LOCAL:1) >= 10	&& IS_DEBUG
						SELECTCASE RESULTS
							CASE "□"
								SIF GETCOLOR() == 0x777766
									L_COLOR = COLOR("パ緑")
							CASE "■"
								SIF GETCOLOR() == GETDEFCOLOR()
									L_COLOR = COLOR("パ緑")
							CASE "扉"
								SIF GETCOLOR() == 0x8888aa
									L_COLOR = COLOR("パ緑")
							CASE "宝"
								SIF GETCOLOR() == 0xffdd99
									L_COLOR = COLOR("パ緑")
							CASE "罠"
								SIF GETCOLOR() == 0xbb0033
									L_COLOR = COLOR("パ緑")
							CASE "昇", "降"
								SIF GETCOLOR() == 0x44aa00
									L_COLOR = COLOR("パ緑")
						ENDSELECT
					ENDIF
					;ユーザーカラー着色
					SIF DUNGEON_ENABLE_MANUAL_MAPPING && TEMP_USER_COLOR:LOCAL:(LOCAL:1) > 0  && RESULTS != "　"
						L_COLOR = DUNGEON_USER_TILE_COLOR:(TEMP_USER_COLOR:LOCAL:(LOCAL:1))
					;ユーザーオブジェクト
					SIF DUNGEON_ENABLE_MANUAL_MAPPING && TEMP_USER_OBJECT:LOCAL:(LOCAL:1) > 0 && RESULTS != "　"
						RESULTS '= DUNGEON_USER_TILE_OBJECT:(TEMP_USER_OBJECT:LOCAL:(LOCAL:1))

					L_TILE '= SET_COLOR_TAG(RESULTS, TOSTR(L_COLOR))
				ELSE
					L_TILE '= SET_COLOR_TAG("？", TOSTR(0x000000))
				ENDIF
				L_TILE '= SET_BUTTON_TAG(L_TILE, @"COORD/{LOCAL}/{LOCAL:1}", @"[{LOCAL}/{LOCAL:1}]　　　[{DA:LOCAL:(LOCAL:1)}]")
			ENDIF
			RESETCOLOR
			SHOW_LINE += L_TILE
		NEXT
		IF DUNGEON_ENABLE_MANUAL_MAPPING
			SIF FLAG:최대X < 45
				SHOW_LINE += "　　　"
			IF LOCAL:1 < 11
				TEMPS = 
				IF SHOW_MODE == "SETCOLOR" && SELECT_NUM == LOCAL:1
					TEMPS += SET_COLOR_TAG("【", "yellow")
				ELSE
					TEMPS += " ["
				ENDIF
				TEMPS += SET_COLOR_TAG("■", TOSTR(DUNGEON_USER_TILE_COLOR:(LOCAL:1)))
				IF SHOW_MODE == "SETCOLOR" && SELECT_NUM == LOCAL:1
					TEMPS += SET_COLOR_TAG("】", "yellow")
				ELSE
					TEMPS += "] "
				ENDIF
				TEMPS '= SET_BUTTON_TAG(TEMPS, @"MAPPING_USER_COLOR/{LOCAL:1}")
				SHOW_LINE += TEMPS
				SIF FLAG:최대X < 45
					SHOW_LINE += " " * 2
				FOR LCOUNT, 0, 3 - LIMIT(FLAG:최대X - 48, 0, 6) / 2
					IF LOCAL:1 == 0 && LCOUNT > 0
						TEMPS '= " " * 6
					ELSE
						TEMP = LOCAL:1 + LCOUNT * 11 - LCOUNT
						TEMPS = 
						IF SHOW_MODE == "SETOBJECT" && SELECT_NUM == TEMP
							TEMPS += "【"
						ELSE
							TEMPS += " ["
						ENDIF
						IF TEMP == 0
							TEMPS += "　"
						ELSE 
							TEMPS += DUNGEON_USER_TILE_OBJECT:TEMP
						ENDIF
						IF SHOW_MODE == "SETOBJECT" && SELECT_NUM == TEMP 
							TEMPS += "】"
						ELSE
							TEMPS += "] "
						ENDIF
						SIF SHOW_MODE == "SETOBJECT" && SELECT_NUM == TEMP 
							TEMPS '= SET_COLOR_TAG(TEMPS, "yellow")
						TEMPS '= SET_BUTTON_TAG(TEMPS, @"MAPPING_USER_OBJECT/{TEMP}")
						SHOW_LINE += TEMPS
					ENDIF
				NEXT
			ENDIF
		ENDIF
		HTML_PRINT SHOW_LINE
	NEXT
	;FOR LOCAL:1,0,FLAG:최대Y
	;	FOR LOCAL,0,FLAG:최대X
	;		IF FLAG:현X == LOCAL && FLAG:현Y == LOCAL:1 && (FLAG:현M == LOCAL:2)
	;			SETCOLOR 0x33ffcc
	;			PRINT ＠
	;			RESETCOLOR
	;			CONTINUE
	;		ENDIF
	;		IF DA:(FLAG:현X):(FLAG:현Y) % 10 == -1 && !(SOFT_ON("다크스캐너") || SOFT_ON("허니・비")) && FLAG:라이트마 == 0 && ABS(LOCAL-FLAG:현X)+ABS(LOCAL:1-FLAG:현Y) > 1
	;			SETCOLOR 0x202020
	;			PRINTBUTTON "？", LOCAL*100+LOCAL:1
	;			RESETCOLOR
	;			CONTINUE
	;		ENDIF
	;		IF GET_FLOOR_ANALYZE_T(LOCAL, LOCAL:1) > 0
	;			CALL DG_GET_TILE(LOCAL, LOCAL:1, FLAG:현M, FLAG:현던전)
	;			PRINTBUTTON RESULTS, LOCAL*100+LOCAL:1
	;		ELSE
	;			SETCOLOR 0x000000
	;			PRINTBUTTON "■", LOCAL*100+LOCAL:1
	;		ENDIF
	;		RESETCOLOR
	;	NEXT
	;	PRINTL
	;NEXT
ENDIF

$HONEY_BEE_INPUT_LOOP

FLAG:최대X = -1
FLAG:최대Y = -1
LOCAL:4 = 0
IF FLAG:현M > 0 && CAN_FLOOR_MOVE
	FLAG:현M--
	CALLFORM MAKE_FLOOR_{FLAG:현던전}
	FLAG:현M++
	SIF FLAG:최대X >= 0 && FLAG:최대Y >= 0
		LOCAL:4 = 1
	CALL MAKE_FLOOR, FLAG:현던전
	IF LOCAL:4
		PRINTL [0]PREV
	ELSE
		PRINTL 
	ENDIF
ENDIF
PRINTL 
FLAG:최대X = -1
FLAG:최대Y = -1
LOCAL:5 = 0
CALL D_VARSIZE , FLAG:현던전
IF (RESULT >= 2 && FLAG:현M < RESULT-1) && CAN_FLOOR_MOVE
	FLAG:현M++
	CALLFORM MAKE_FLOOR_{FLAG:현던전}
	FLAG:현M--
	SIF FLAG:최대X >= 0 && FLAG:최대Y >= 0
		LOCAL:5 = 1
ENDIF
CALL MAKE_FLOOR, FLAG:현던전
IF SHOW_MODE == "SETCOLOR" || SHOW_MODE == "SETOBJECT"
	IF SHOW_MODE == "SETCOLOR"
		IF SELECT_NUM
			HTML_PRINT SET_BUTTON_TAG("[0] COLOR CONFIG", "0")
		ELSE
			HTML_PRINT SET_COLOR_TAG("[0] COLOR CONFIG", "gray")
		ENDIF
	ELSE
		IF SELECT_NUM
			HTML_PRINT SET_BUTTON_TAG("[0] OBJECT CONFIG", "0")
		ELSE
			HTML_PRINT SET_COLOR_TAG("[0] OBJECT CONFIG", "gray")
		ENDIF
	ENDIF
	HTML_PRINT SET_BUTTON_TAG("[1] ALL RESET", "1")
	HTML_PRINT SET_BUTTON_TAG("[9] END", "9")
	PRINTL 
	IF IS_DEBUG
		PRINTL 
		PRINTL 
	ENDIF
ELSE
	IF LOCAL:5
		PRINTL [1]NEXT
	ELSE
		PRINTL 
	ENDIF
	IF IS_DEBUG
		PRINTL 
		PRINTL [2]MAPPING
	ENDIF
	PRINTL 
	PRINTL [100]돌아간다
	PRINTL
ENDIF
INPUTS
IF ISNUMERIC(RESULTS)
	RESULT = TOINT(RESULTS)
	SELECTCASE RESULT
		CASE 0
			IF SHOW_MODE == "SETCOLOR"
				IF SELECT_NUM
					CALL COLOR_SETTER, @"■", DUNGEON_USER_TILE_COLOR:SELECT_NUM, GET_DEFAULT_USER_TILE_COLOR(SELECT_NUM)
					DUNGEON_USER_TILE_COLOR:SELECT_NUM = RESULT
					SAVEGLOBAL
				ENDIF
			ELSEIF SHOW_MODE == "SETOBJECT"
				PRINTFORML 타일로 설정하고 싶은 오브젝트를 입력해 주십시오.
				PRINTFORML 아무것도 입력하지 않았을 경우 기본 오브젝트가 설정됩니다.
				INPUTS
				IF RESULTS == ""
					DUNGEON_USER_TILE_OBJECT:SELECT_NUM '= GET_DEFAULT_USER_TILE_OBJECT(SELECT_NUM)
				ELSEIF STRLENS(RESULTS) > 2
					PRINTFORMW 문자열이 너무 깁니다!
				ELSE
					DUNGEON_USER_TILE_OBJECT:SELECT_NUM = %RESULTS, 2, LEFT%
				ENDIF
				SAVEGLOBAL
			ELSE
				IF LOCAL:4
					FLAG:현M --
					CALL MAKE_FLOOR, FLAG:현던전
					GOTO SET_USER_TILE_DATA
				ENDIF
			ENDIF
		CASE 1
			IF SHOW_MODE == "SETCOLOR"
				FOR L_Y, 0, FLAG:최대Y
					FOR L_X, 0, FLAG:최대X
						CALL SET_FLOOR_USER_COLOR, 0, FLAG:현던전, FLAG:현M, L_X, L_Y
					NEXT
				NEXT
				GOTO SET_USER_TILE_DATA
			ELSEIF SHOW_MODE == "SETOBJECT"
				FOR L_Y, 0, FLAG:최대Y
					FOR L_X, 0, FLAG:최대X
						CALL SET_FLOOR_USER_OBJECT, 0, FLAG:현던전, FLAG:현M, L_X, L_Y
					NEXT
				NEXT
				GOTO SET_USER_TILE_DATA
			ELSE
				IF LOCAL:5
					FLAG:현M ++
					CALL MAKE_FLOOR, FLAG:현던전
					GOTO SET_USER_TILE_DATA
				ENDIF
			ENDIF
		CASE 2
			IF IS_DEBUG
				;LOCAL:4 = ダンジョンフラグ:(FLAG:현던전):(100+FLAG:현M%25) % POWER(100, FLAG:현M/25*2+1) / POWER(100, FLAG:현M/25*2)
				;LOCAL:5 = ダンジョンフラグ:(FLAG:현던전):(100+FLAG:현M%25) % (POWER(100, FLAG:현M/25*2+2)) / (POWER(100, FLAG:현M/25*2+1))
				CALL FLOOR_ANALYZE
				GOTO HONEY_BEE_LOOP
				;SAVESTR:GET_FLOOR_ANALYZE_NUM(FLAG:현던전, FLAG:현M) = %"2"* LOCAL:4 * LOCAL:5%
				;FOR LOCAL:1, 100, 100+LOCAL:5
				;	FOR LOCAL, 0, LOCAL:4
				;		DA:LOCAL:(LOCAL:1) = 2
				;	NEXT
				;NEXT
				;CALL MAKE_FLOOR, FLAG:현던전
			ENDIF
		CASE 9
			IF SHOW_MODE == "SETCOLOR" || SHOW_MODE == "SETOBJECT"
				SHOW_MODE = 
				GOTO HONEY_BEE_LOOP
			ENDIF
		CASE 100
			;階層を戻して移動画面に戻る
			FLAG:현M = LOCAL:2
			CALL MAKE_FLOOR, FLAG:현던전
			CUSTOMDRAWLINE =
			RETURN 0
		CASEELSE
	ENDSELECT
ELSE
	IF STRCOUNT(RESULTS, "MAPPING_USER_COLOR")
		SELECT_NUM = TOINT(AUTO_SPLIT(RESULTS, "/", 1))
		SHOW_MODE = SETCOLOR
		GOTO HONEY_BEE_LOOP
	ELSEIF STRCOUNT(RESULTS, "MAPPING_USER_OBJECT")
		SELECT_NUM = TOINT(AUTO_SPLIT(RESULTS, "/", 1))
		SHOW_MODE = SETOBJECT
		GOTO HONEY_BEE_LOOP
	ELSEIF STRCOUNT(RESULTS, "COORD")
		L_X = TOINT(AUTO_SPLIT(RESULTS, "/", 1))
		L_Y = TOINT(AUTO_SPLIT(RESULTS, "/", 2))
		IF SHOW_MODE == "SETCOLOR"
			;同じ色で塗った場合はリセット
			IF TEMP_USER_COLOR:L_X:L_Y == SELECT_NUM
				CALL SET_FLOOR_USER_COLOR, 0, FLAG:현던전, FLAG:현M, L_X, L_Y
				TEMP_USER_COLOR:L_X:L_Y = 0
			ELSE
				CALL SET_FLOOR_USER_COLOR, SELECT_NUM, FLAG:현던전, FLAG:현M, L_X, L_Y
				TEMP_USER_COLOR:L_X:L_Y = SELECT_NUM
			ENDIF
			GOTO HONEY_BEE_LOOP
		ELSEIF SHOW_MODE == "SETOBJECT"
			L_X = TOINT(AUTO_SPLIT(RESULTS, "/", 1))
			L_Y = TOINT(AUTO_SPLIT(RESULTS, "/", 2))
			IF TEMP_USER_OBJECT:L_X:L_Y == SELECT_NUM
				CALL SET_FLOOR_USER_OBJECT, 0, FLAG:현던전, FLAG:현M, L_X, L_Y
				TEMP_USER_OBJECT:L_X:L_Y = 0
			ELSE
				CALL SET_FLOOR_USER_OBJECT, SELECT_NUM, FLAG:현던전, FLAG:현M, L_X, L_Y
				TEMP_USER_OBJECT:L_X:L_Y = SELECT_NUM
			ENDIF
		ELSEIF IS_DEBUG
			CALL DUNGEON_WORP, FLAG:현M, L_X, L_Y
			RETURN 0
		ENDIF
		GOTO HONEY_BEE_LOOP
	ENDIF
ENDIF
GOTO HONEY_BEE_INPUT_LOOP

@CAN_SEE_MAP
#FUNCTION
SIF FLAG:현던전 == [[ダンジョン:타르타로스]]
	RETURNF 0
SIF FLAG:현던전 == [[ダンジョン:이상한던전]]
	RETURNF 0
RETURNF 1

