;性欲処理の計算
@性欲処理, ARG , ARG:1 = -1 , ARG:2
#DIM CHARA , 1
#DIM 元欲情 , 2
#DIMS CONST PLAY_TABLE = "", "동료마와 섹스를 한다", "동료마에게 봉사를 받는다", "이 자리에서 자위를 한다", "숨어서 자위를 하고 온다", "더러움을 닦아낸다"
#DIMS DYNAMIC L_PLAY
#DIM DYNAMIC L_PLAYER
#DIM DYNAMIC L_TARGET
#DIM DYNAMIC CNT_SUM_PLAY;総プレイ回数
#DIM DYNAMIC CNT_TOUCH;애무횟수
#DIM DYNAMIC CNT_RAPE
#DIM DYNAMIC CNT_RAPER
#DIM LCOUNT
#DIMS DYNAMIC SHOWLINE
L_PLAY '= PLAY_TABLE:(ARG:2)
;ARG = 処理するキャラ
;ARG:1 = 相手
;ARG:2 = プレイ内容（1:仲魔とセックスをする 2:仲魔に奉仕してもらう 3:この場で自慰をする 4:物陰で自慰をしてくる 5:汚れを落とす）
;初期化
FOR LOCAL , 0 , 1 + (ARG:1 > -1)
	CFLAG:(ARG:LOCAL):삽입횟수 = 0
	CFLAG:(ARG:LOCAL):본방횟수 = 0
	CFLAG:(ARG:LOCAL):질내사정횟수 = 0
	CFLAG:(ARG:LOCAL):애널횟수 = 0
	CFLAG:(ARG:LOCAL):펠라횟수 = 0
	CFLAG:(ARG:LOCAL):클리자극횟수 = 0
	CFLAG:(ARG:LOCAL):가슴자극횟수 = 0
	NOWEX:(ARG:LOCAL):Ｃ절정 = 0
	NOWEX:(ARG:LOCAL):Ｖ절정 = 0
	NOWEX:(ARG:LOCAL):Ａ절정 = 0
	NOWEX:(ARG:LOCAL):Ｂ절정 = 0
	NOWEX:(ARG:LOCAL):사정 = 0
	NOWEX:(ARG:LOCAL):분유 = 0
	TCVAR:(ARG:LOCAL):획득자위경험 = 0
	元欲情:LOCAL = CFLAG:(ARG:LOCAL):던전내발정용욕정치
	DOWNBASE:(ARG:LOCAL):체력 = 0
	DOWNBASE:(ARG:LOCAL):기력 = 0
NEXT
;プレイ回数
IF L_PLAY == "仲魔とセックスをする"
	CNT_SUM_PLAY = 2 + (ABL:(ARG):기교 + ABL:(ARG:1):봉사정신)
	L_PLAYER = ARG
	L_TARGET = ARG:1
ELSEIF L_PLAY == "仲魔に奉仕してもらう"
	CNT_SUM_PLAY = 2 + (ABL:(ARG:1):기교 + ABL:(ARG:1):봉사정신) / 2
	L_PLAYER = ARG:1
	L_TARGET = ARG
ELSEIF L_PLAY == "この場で自慰をする" || L_PLAY == "物陰で自慰をしてくる"
	CNT_SUM_PLAY = 2 + ((ABL:(ARG):기교 + ABL:(ARG):노출증) / 2 + ABL:(ARG):자위중독) / 2
	L_PLAYER = ARG
	L_TARGET = -1
ELSE
	L_PLAYER = ARG
ENDIF
;絶倫をもっている場合は回数が増える
CNT_SUM_PLAY += TALENT:ARG:절륜 * 2
SIF ARG:1 > 0 && TALENT:(ARG:1):절륜
	CNT_SUM_PLAY += 2
;プレイ内容
IF L_PLAY == "仲魔とセックスをする"
	FOR LCOUNT , 0 , CNT_SUM_PLAY
		;前戯は3回まで
		IF RAND:100 < 30 && CNT_TOUCH < 3
			IF HAVE_PENIS(L_PLAYER)
				CFLAG:L_TARGET:펠라횟수 += 1
			ELSE
				IF RAND:2 == 0
					CFLAG:L_PLAYER:가슴자극횟수 += 1
				ELSE
					CFLAG:L_PLAYER:클리자극횟수 += 1
				ENDIF
			ENDIF
			IF HAVE_PENIS(L_TARGET)
				CFLAG:L_PLAYER:펠라횟수 += 1
			ELSE
				IF RAND:2 == 0
					CFLAG:L_TARGET:가슴자극횟수 += 1
				ELSE
					CFLAG:L_TARGET:클리자극횟수 += 1
				ENDIF
			ENDIF
			CNT_TOUCH += 1
			CONTINUE
		ELSEIF RAND:100 < 60
			IF HAVE_PENIS(L_PLAYER)
				IF HAVE_VAGINA(L_TARGET)
					CFLAG:(L_TARGET):본방횟수 += 1
					CFLAG:(L_PLAYER):삽입횟수 += 1
				ELSE
					CFLAG:(L_TARGET):애널횟수 += 1
					CFLAG:(L_PLAYER):삽입횟수 += 1
				ENDIF
			ELSEIF HAVE_PENIS(L_TARGET)
				IF HAVE_VAGINA(L_PLAYER)
					CFLAG:(L_PLAYER):본방횟수 += 1
					CFLAG:(L_TARGET):삽입횟수 += 1
				ELSE
					CFLAG:(L_PLAYER):애널횟수 += 1
					CFLAG:(L_TARGET):삽입횟수 += 1
				ENDIF
			ELSE
				CFLAG:(L_TARGET):클리자극횟수 += 1
			ENDIF
		ELSEIF RAND:100 < 50
			FOR LOCAL , 0 , 2
				IF HAVE_PENIS(ARG:LOCAL)
					CFLAG:(ARG:(!LOCAL)):펠라횟수 += 2
				ELSE
					CFLAG:(ARG:LOCAL):클리자극횟수 += 2
				ENDIF
			NEXT
		ELSE
			IF HAVE_PENIS(L_PLAYER)
				CFLAG:(L_TARGET):애널횟수 += 1
				CFLAG:(L_PLAYER):삽입횟수 += 1
			ELSEIF HAVE_PENIS(L_TARGET)
				CFLAG:(L_PLAYER):애널횟수 += 1
				CFLAG:(L_TARGET):삽입횟수 += 1
			ELSE
				CFLAG:(L_TARGET):클리자극횟수 += 1
				CFLAG:(L_TARGET):가슴자극횟수 += 1
				CFLAG:(L_PLAYER):가슴자극횟수 += 1
				CFLAG:(L_PLAYER):클리자극횟수 += 1
			ENDIF
		ENDIF
	NEXT
	CFLAG:ARG:질내사정횟수 = CFLAG:ARG:본방횟수
	CFLAG:(L_TARGET):질내사정횟수 = CFLAG:(L_TARGET):본방횟수
ELSEIF L_PLAY == "仲魔に奉仕してもらう"
	IF HAVE_PENIS(L_TARGET)
		CFLAG:L_PLAYER:펠라횟수 += CNT_SUM_PLAY
	ELSE
		CFLAG:(L_TARGET):클리자극횟수 = 1 + RAND:(MAX(1, CNT_SUM_PLAY - 1))
		CFLAG:(L_TARGET):가슴자극횟수 = CNT_SUM_PLAY - CFLAG:(L_TARGET):가슴자극횟수
	ENDIF
ELSEIF L_PLAY == "この場で自慰をする"
	TCVAR:L_PLAYER:획득자위경험 += CNT_SUM_PLAY
	CFLAG:L_PLAYER:클리자극횟수 = 1 + RAND:(MAX(1 , TCVAR:L_PLAYER:획득자위경험 - 1))
	CFLAG:L_PLAYER:가슴자극횟수 = TCVAR:L_PLAYER:획득자위경험 - CFLAG:L_PLAYER:클리자극횟수
ELSEIF L_PLAY == "物陰で自慰をしてくる"
	PRINTFORML ・
	PRINTFORML ・・
	PRINTFORML ・・・
	PRINTL 
	;輪姦確率
	VARI RAPE_RATE
	IF 위험일(ARG) >= 2
		RAPE_RATE = 40
	ELSEIF CFLAG:ARG:던전내발정용욕정치 >= 10000
		RAPE_RATE = 20
	ELSEIF CFLAG:ARG:던전내발정용욕정치 >= 5000
		RAPE_RATE = 10
	ELSE
		RAPE_RATE = 1
	ENDIF
	;満月時やられやすくなる
	SIF FLAG:월령 == 8
		RAPE_RATE += 10
	;月下香の髪飾りを付けていると大幅アップ
	SIF CFLAG:L_PLAYER:모자 ==　[[衣装:월하향의머리장식]]
		RAPE_RATE += 50
	TCVAR:L_PLAYER:획득자위경험 = RAPE_RATE / 10 + CNT_SUM_PLAY
	CFLAG:L_PLAYER:가슴자극횟수 = 1 + RAND:(TCVAR:L_PLAYER:획득자위경험 +1)
	CFLAG:L_PLAYER:클리자극횟수 = TCVAR:L_PLAYER:획득자위경험 - CFLAG:L_PLAYER:가슴자극횟수
	;ダンジョン内に設定がされている場合、悪魔に輪姦される可能性がある
	TRYCCALLFORM DUNGEON_RAPE_DEVIL_{FLAG:현던전}
		IF RAND:100 < RAPE_RATE && !IS_LOOKSLIKE_MALE(ARG)
			;---- EDIT 008 MOD START -------------------------
			;RESULTを直でわたそうとしてたのを引数を足して対処
			;輪姦されちゃうかも判定へ
			CALL 性欲処理_輪姦, ARG , RESULT, RESULT:1, RESULT:2
			;---- EDIT 008 MOD END ---------------------------
			CNT_RAPE = RESULT ;回数
			CNT_RAPER = RESULT:1 ;人数
		ENDIF
	CATCH
	ENDCATCH
ELSEIF ARG:2 == 5
	PALAM:L_PLAYER:윤활 = 0
	;膣内以外の汚れを綺麗に
	FOR LCOUNT, 0, 8
		SIF LCOUNT == 6
			CONTINUE
		STAIN:L_PLAYER:LCOUNT = 0
	NEXT
	RETURN 0
ENDIF

FOR LOCAL , 0 , 1 + (ARG:1 > -1)
