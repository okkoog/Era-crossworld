;F.O.E.『刈り取るもの』関連
;=======================================================================
;『刈り取るもの』出現チェック
@DUNGEON_70_FOE_REAPER_CHECK
;-------------
;変数定義
;-------------
#DIM POINT_X			;X座標
#DIM POINT_Y			;Y座標

;-------------
;変数の初期化
;-------------
POINT_X = 0				;X座標
POINT_Y = 0				;Y座標

;-------------
;ここから本処理
;-------------
;現フロアの滞在時間に応じて処理を行う
IF CD_TIME_AND_TURN:3 < (1000 * 60 * 10)
	;10分未満：何もなし
	ダンジョンフラグ:70:(67) = 0	;警告フラグを「0:警告未発生」にする

ELSEIF (1000 * 60 * 10) <= CD_TIME_AND_TURN:3 && CD_TIME_AND_TURN:3 < (1000 * 60 * 13) && ダンジョンフラグ:70:(67) == 0
	;10分経過：警告(1回目)
	CALL MESSAGE_WINDOW, "" , "＞어디선가 쇠사슬 끄는 소리가 났다"
	ダンジョンフラグ:70:(67) = 1	;警告フラグを「1:1回目の警告済」にする

ELSEIF (1000 * 60 * 13) <= CD_TIME_AND_TURN:3 && CD_TIME_AND_TURN:3 < (1000 * 60 * 15) && ダンジョンフラグ:70:(67) <= 1
	;13分経過：警告(2回目)
	CALL MESSAGE_WINDOW, "" , "＞조금씩 불길한 기운이 강해져 간다"
	CALL MESSAGE_WINDOW, "" , "＞이 계층에 오래 머물지 않는 편이 좋을 것 같다"
	ダンジョンフラグ:70:(67) = 2	;警告フラグを「2:2回目の警告済」にする

ELSEIF (1000 * 60 * 15) <= CD_TIME_AND_TURN:3 && ダンジョンフラグ:70:(67) <= 2
	;15分経過：F.O.E.『刈り取るもの』出現！
	SETBGCOLOR 0xff0000				;バックグラウンドカラーを赤色にする
	SETCOLOR 0x000000				;黒文字にする
	CALL MESSAGE_WINDOW, "" , "＞어디선가 사신 타입이 출현했다！　당신을 쫒아온다！"
	RESETBGCOLOR					;バックグラウンドカラーを元に戻す
	RESETCOLOR						;文字色を元に戻す

	;F.O.Eを配置する
	CALL CD_GET_POINT, POINT_X, POINT_Y, 0, 1, -1								;座標を取得する
	CALL SEF_ADD_SYMBOL, 2, 3201, 2, POINT_X, POINT_Y, 99, 2, 1, 2, 70, 1, 1, 1	;シンボルエンカウントを設定する

	ダンジョンフラグ:70:(67) = 3	;警告フラグを「3:F.O.E.出現済」にする

ENDIF
RETURN 1

;『刈り取るもの』シンボル接触時イベント
@SYMBOLEVENT_70_1, SYMBOL_NO
;-------------
;変数定義
;-------------
#DIM SYMBOL_NO					;接触したシンボルの番号	※ここでは使用しないが共通ルールとして定義する

;-------------
;ここから本処理
;-------------
;戦闘前にちょっぴり導入
SETBGCOLOR 0xff0000				;バックグラウンドカラーを赤色にする
SETCOLOR 0x000000				;黒文字にする
CALL MESSAGE_WINDOW, "" , "＞거둬들이는 자가 나타났다！！"
RESETBGCOLOR					;バックグラウンドカラーを元に戻す
RESETCOLOR						;文字色を元に戻す

;戦闘前に各種フラグを設定
FLAG:도주불가플래그 = 1
FLAG:회화불능플래그 = 1
FLAG:선제기습취소 = 1

;敵キャラを配置
CALL SET_ENEMY, 9, [[キャラ:거둬들이는자]],99,0,1

;耐性を設定
BASE:(CHARANUM-1):만능 = 100

;ステータスを調節
BASE:(CHARANUM-1):힘 += 30
BASE:(CHARANUM-1):지혜 += 30
BASE:(CHARANUM-1):마력 += 30
BASE:(CHARANUM-1):내구 += 15
BASE:(CHARANUM-1):속도 += 15
BASE:(CHARANUM-1):운 += 30

;スキルを設定
ABL:(CHARANUM-1):스킬1 = [[스킬:마하・라기다인]]
ABL:(CHARANUM-1):스킬2 = [[스킬:마하・아쿠다인]]
ABL:(CHARANUM-1):스킬3 = [[스킬:마하・갈다인]]
ABL:(CHARANUM-1):스킬4 = [[스킬:마하・마그다인]]
ABL:(CHARANUM-1):스킬5 = [[스킬:축시의참배]]
ABL:(CHARANUM-1):스킬6 = [[스킬:마한마온]]
ABL:(CHARANUM-1):스킬7 = [[스킬:찰나장대비쏘기]]
ABL:(CHARANUM-1):스킬8 = [[스킬:메기도라온]]

;攻撃回数を設定
CFLAG:(CHARANUM-1):행동횟수 = 2

;設定内容を反映
CALL SYNC_STATUS,(CHARANUM-1)
CALL HEALTH_CHARA,(CHARANUM-1)

;戦闘開始
CALL BATTLE_START

;各種フラグを元に戻す
FLAG:도주불가플래그 = 0
FLAG:회화불능플래그 = 0
FLAG:선제기습취소 = 0

RETURN 1

