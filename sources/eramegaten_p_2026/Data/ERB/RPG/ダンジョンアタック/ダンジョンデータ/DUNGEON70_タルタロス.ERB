;CALL AUTOMAP

;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_70
#DIM LCOUNT
#LOCALSIZE 2
IF ダンジョンフラグ:70:96 == 1
	ダンジョンフラグ:70:96 = 2
	PRINTFORMW ………타르타로스의 지하 깊은 곳에서 누군가가 %마스터를% 기다리고 있다……
ENDIF
IF FLAG:DEBUG == 1
	SETCOLOR 0x00ffff
	PRINTFORMW 디버그 중이므로 바로가기 계단이 발생합니다
	RESETCOLOR
ENDIF
;階層リセット
ダンジョンフラグ:70:(50)=0
;探索できるメンバー計算
IF ダンジョンフラグ:70:(88) == 0 && ダンジョンフラグ:70:0 > 0
	CALL TARTAR_MEMBERNUM
ELSE
	ダンジョンフラグ:70:(95) = 99
ENDIF
IF ダンジョンフラグ:70:0 == 0
	ダンジョンフラグ:70:(10) = 1
	ダンジョンフラグ:70:(11) = 1
	ダンジョンフラグ:70:(12) = 1
	ダンジョンフラグ:70:(13) = 1
	ダンジョンフラグ:70:(14) = 1
	ダンジョンフラグ:70:(15) = 1
	ダンジョンフラグ:70:(16) = 0
	ダンジョンフラグ:70:(17) = 0
	ダンジョンフラグ:70:(18) = 0
	ダンジョンフラグ:70:(19) = 0
	ダンジョンフラグ:70:(20) = 0
	ダンジョンフラグ:70:(21) = 1
	ダンジョンフラグ:70:(22) = 0
	ダンジョンフラグ:70:(23) = 0
	;鬼太郎貰ってたらいない
	SIF ダンジョンフラグ:70:(94) != 2
		ダンジョンフラグ:70:(10) = (-1)
	;ハム子貰ってたらいない
	SIF ダンジョンフラグ:70:(94) != 1
		ダンジョンフラグ:70:(11) = (-1)
	PRINTL 
	PRINTL 
	PRINTL 섀도우 타임。
	PRINTL 그것은 하루와 하루의 틈에 존재하는 수수께끼의 시간。
	PRINTL 그리고 나타나는 거대한 탑, 그 이름은 타르타로스。
	PRINTFORML %MASTER는% 그곳에 발을 디뎠다。
	PRINTFORMW ………
	PRINTFORMW ……
	PRINTFORMW …
	PRINTFORMW 엔트런스에 들어서자 %CALLNAME:MASTER%의 눈에 몆 명의 소년소녀들이 보였다。
	PRINTW 이쪽을 눈치챘는지 그들 중에서도 유달리 매력적인 여성이 인사를 보냈다。
	PRINTFORMW 「%CALLNAME:MASTER% 씨군요？」
	PRINTW 「이쿠츠키 이사장에게서 이야기는 들었습니다」
	PRINTW 「키리조 미츠루라고 합니다」
	PRINTW 「저희는 월광관 학원의 특별 과외 활동부」
	PRINTW 「사람에게 해를 끼치는 섀도우의 섬멸 및 이곳 타르타로스의 탐색을 목적으로 두고 있습니다」
	PRINTW 「저희는 최근에야 간신히 충분한 인원을 갖춘 참이며」
	PRINTW 「이 타르타로스를 공략하기에는 인원도 힘도 미숙합니다」	
	PRINTW 「그 때문에 이번에 당신들의 힘을 빌릴 수 있던 건 더할 나위 없이 고맙습니다」
	PRINTW 「같은 목적을 가진 사람으로서 앞으로 잘 부탁드립니다」
	ダンジョンフラグ:70:0 = 1
	;=======================================================================
	;１階を自動マッピング
	;=======================================================================
	;SAVESTR:GET_FLOOR_ANALYZE_NUM(FLAG:현던전, 0) = %"2"* 13 * 17%
	FOR LOCAL:1, 0, FLAG:최대Y
		FOR LOCAL, 0, FLAG:최대X
			CALLF DPOINT("SET" , 2 , LOCAL , LOCAL:1 , 0 , @"ダンジョン%TOSTR(FLAG:현던전 , "00")%" )
		NEXT
	NEXT
	ダンジョンフラグ:(FLAG:현던전):100 = ダンジョンフラグ:(FLAG:현던전):100 % 10000 * 10000 + 1317
	;CALL TARTAR_MAPDEL
	;C:0 = LCOUNT
	;FOR LCOUNT, 0, FLAG:최대X
	;	C:1 = LCOUNT
	;	FOR A,0,FLAG:최대Y,1
	;		TA:(FLAG:현던전):(C:1):LCOUNT = 0
	;	NEXT
	;	LCOUNT = C:1
	;NEXT
	;LCOUNT = C:0
	;=======================================================================
ELSEIF ダンジョンフラグ:70:(95) < 3 && ダンジョンフラグ:70:(88) == 0
	PRINTFORMW 타르타로스에 온 %CALLNAME:MASTER% 앞에 때마침 이쿠츠키가 나타났다。
	PRINTFORMW 「여어, %CALLNAME:MASTER% 군. 오래간만, 이던가？」
	PRINTW 「뭐 오늘 만난 이유는 자네도 만난 적이 있을 거다 싶은 특별 과외 활동부에 관한 일 때문이야」
	PRINTW ……그러고 보니 늘 있는 그들이 오늘은 눈에 띄지 않는다。
	PRINTW 「아니, 내 쪽도 그들에게 탐색을 맡기고 있었는데 말이지」
	PRINTW 「그, 탐색 중에 사고가 일어났는지 탐색이 가능할 만한 멤버가 부족해져버렸거든」
	PRINTW 「미안하지만 내 쪽은 탐색을 중단하겠네」
	PRINTW 「하지만 뭐, 자네에게 부탁한 의뢰는 아직 유지되고 있으니 힘내줬으면 해」
	PRINTW 이쿠츠키는 그 말만 전하고 떠났다……
	PRINTW ………
	PRINTW ……
	PRINTW …
	PRINTL 
	ダンジョンフラグ:70:(88) = 1
ELSEIF ダンジョンフラグ:70:(1) >= 2 && ダンジョンフラグ:70:(89) == 2 && ダンジョンフラグ:70:(22) == 0
	ダンジョンフラグ:70:(22) = 1
	PRINTFORMW 아무래도 특별 과외 활동부에 멤버가 늘어난 모양이다
ELSEIF ダンジョンフラグ:70:(1) >= 4 && ダンジョンフラグ:70:(17) == 0
	ダンジョンフラグ:70:(17) = 1
	SIF ダンジョンフラグ:70:(70) == 1
		ダンジョンフラグ:70:(16) = 1
	PRINTFORMW 아무래도 특별 과외 활동부에 멤버가 늘어난 모양이다
ELSEIF ダンジョンフラグ:70:(1) >= 5 && ダンジョンフラグ:70:(18) == 0
	ダンジョンフラグ:70:(18) = 1
	ダンジョンフラグ:70:(19) = 1
	PRINTFORMW 아무래도 특별 과외 활동부에 멤버가 늘어난 모양이다
	ダンジョンフラグ:70:(20) = 1
ELSEIF ダンジョンフラグ:70:(1) >= 7 && ダンジョンフラグ:70:(19) >= 1 && ダンジョンフラグ:70:(20) >= 1
	ダンジョンフラグ:70:(19) = (-1)
	ダンジョンフラグ:70:(20) = (-1)
	PRINTFORMW ……아무래도 특별 과외 활동부에 멤버가 줄어든 모양이다
ENDIF

