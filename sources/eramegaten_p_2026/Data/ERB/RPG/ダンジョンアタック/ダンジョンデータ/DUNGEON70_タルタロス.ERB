					LOCAL:3 = [[キャラ:박애의큐피드]]
					LOCAL:4 = 70
			ENDSELECT
			FOR LOCAL,7,17,1
				SIF LOCAL != 14
					CALL SET_ENEMY,LOCAL, LOCAL:(RAND:3+1),LOCAL:4,0,0
			NEXT
			FLAG:회화불능플래그 = 1
			FLAG:선제기습취소 = 1
			CALL BATTLE_START
			FLAG:회화불능플래그 = 0
			FLAG:선제기습취소 = 0
		ELSE
			PRINTW ＞악마를 그냥 보냈다…
		ENDIF
		FLAG:미조우걸음수 = 0
		RETURN 0
	ELSE
		RETURN 1
	ENDIF
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF

