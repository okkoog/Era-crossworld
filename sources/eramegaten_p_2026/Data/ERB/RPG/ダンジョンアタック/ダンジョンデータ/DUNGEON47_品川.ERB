
;=======================================================================
;시나가와
;0,ダンジョン攻略条件フラグ,数値によって出現する敵の強さに補正が与えられる
;
;1,ハニエルイベントフラグ	 -1,ハニエル撃破, 1,エキドナ依頼保留		2,エキドナ依頼受諾		3,カテドラル保留		4,カテドラル受諾
;2,ハニエル友好
;
;10, 初回
;11, 説教
;ダンジョンフラグ:47:1 = 1.エキドナ討伐を断った
;ダンジョンフラグ:47:2 = 1.エキドナ討伐承諾
;ダンジョンフラグ:47:10-19 = 1.メシア教徒
;ダンジョンフラグ:47:20 = 1.ロウヒーロー　2.エキドナ討伐進行中
;ダンジョンフラグ:47:21 = 1.守護者アールマティ
;
;ダンジョンフラグ:20:0 = 1.ギンザの鍵

;ダンジョンナンバー47
;=======================================================================

;	Edit	Date			Author					Reason
;	001		20XX/XX/XX								新規作成
;	002		2019/04/22								メシアン系エネミー追加
;	003		2020/08/20								アイテム関連とカテドラル関連を変更
;	004		2023/06/19		P(bazzile)				壁に落ちてしまう落とし穴を修正
;													推奨レベルを敵レベルに合わせて変動するように修正
;													雑魚敵のメイガスだけダンジョンの攻略条件フラグによるレベル補正を受けていなかった不具合を修正
;	005		2024/02/19		P(bazzile)				ハニエルから依頼を受けた際にカテドラルのフラグが立たないケースがあった不具合を修正
;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_47
SIF ダンジョンフラグ:[[ダンジョン:시나가와]]:0
	RETURN 1
RETURN 0




;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_47
#FUNCTIONS
RESULTS_F = 品川


;=======================================================================
;フロア名表示
;=======================================================================
@FLOORNAME_47
PRINT 시나가와
SELECTCASE FLAG:현M
	CASE 0
		PRINTL   １Ｆ
	CASE 1
		PRINTL   ２Ｆ
	CASE 2
		PRINTL   ３Ｆ
	CASE 3
		PRINTL   ４Ｆ
	CASEELSE
		PRINTL
ENDSELECT

