					CONTINUE
				CALL CHANGE_CHARA_LC, POS(LOCAL), 255, 4
			NEXT
			CALL MESSAGE_WINDOW_D, "메시아교 신부", "자아、카테드랄을 향하여/함께 땀을 흘립시다！"
		ENDIF
	CASE 7
		CALL MESSAGE_WINDOW_D, "여자", "제 남편이 카테드랄에 가서/돌아오지 않아요/남편의 안부가 걱정이어서/"
	CASE 8
