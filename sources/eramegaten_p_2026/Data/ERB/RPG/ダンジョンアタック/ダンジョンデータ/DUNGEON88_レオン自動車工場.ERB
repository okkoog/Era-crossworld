;特殊タイル表示
;TILE_MARK_COMMON_{FLAG:현던전}_X
;=======================================================================
;ARG:1、ARG:2がX座標とY座標
;ARGはそこに代入されている値
;RESULTSに代入した文字がマップに表示されますが、必ず全角1文字分になるようにしてください。そうでないと表示が崩れます。


@TILE_MARK_COMMON_88_4, ARG , ARG:1 , ARG:2
SELECTCASE ARG / 10
	;落とし穴を"●"と表示
	CASE 100 , 101 , 103 , 104 , 105 , 301 , 302 , 303 , 305 , 306
		RESULTS = ●
	;メッセンジャーを緑色で"ｍ"と表示
	CASE 0 , 1 , 2 , 106 , 200 , 300
		SETCOLOR 0x00ff00
		RESULTS = ｍ
	CASE 102
		;新宿でオザワが倒されている
		IF ダンジョンフラグ:42:新宿フラグ("オザワ") > 1
			SETCOLOR 0x00ff00
			RESULTS = ｍ
		ELSE
			RESULTS = ！
		ENDIF
	CASEELSE
		;特に設定しない場合、"！"と表示されます
		RETURN 1
ENDSELECT


