
;=======================================================================
;레온자동차공장
;ボス・ムーウィス
;ダンジョンナンバー88
;
;
;
;フラグ使用状況
;ダンジョンフラグ:88:1		レオン自動車工場クリアフラグ（0:クリア前、1:クリア後）
;ダンジョンフラグ:88:2		レオン自動車工場突入フラグ（0:入ってない、1:入ったことある、2:ネミッサと入ったことある）
;ダンジョンフラグ:88:3		ムーウィス撃破フラグ（0:倒してない、1:倒した）
;
;
;ダンジョンフラグ:88:5		非常用電源（0:キー入手前、1:キー入手済み、2:非常用電源起動済み）


;時事系列的に天体博物館＞闘技場イベントってことにして、クリア前に闘技場でネミッサを仲間にすると依頼が消えダンジョンボスは他のサマナーに倒される。
;ウラベクエストに関係なくカツオ達はネミッサ入りのＣＯＭＰを手に入れてサマナーとして活動している感じ。
;=======================================================================

;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_88
;ムーウィスの襲撃イベント終了済みでレオン自動車工場クリア前、か、レオン自動車工場クリア済み
IF (イベントフラグ:27:0 == 1 && ダンジョンフラグ:88:1 == 0) || ダンジョンフラグ:88:1 == 1
	RETURN 1
ENDIF
RETURN 0


;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_88
#FUNCTIONS
RESULTS_F = レオン自動車工場

;=======================================================================
;フロア名表示
;=======================================================================
@FLOORNAME_88
PRINT 레온자동차공장
SELECTCASE FLAG:현M
	CASE 0
		PRINTL １Ｆ
	CASE 1
		PRINTL ２Ｆ
	CASE 2
		PRINTL ３Ｆ
	CASE 3
		PRINTL ４Ｆ
	CASEELSE
		PRINTL
ENDSELECT

;=======================================================================
;ターミナルマップ
;RESULT:X = 1で階層Mのマップのターミナルを登録できる
;登録されたターミナル同士は相互で移動が可能になり、スタート地点から選べるようになる
;
;RESULTS:100は入り口の名称。入り口のままでいいなら定義する必要はない
;=======================================================================
@TERMINAL_MAP_88, IS_START
#DIM DYNAMIC IS_START
RESULT:4 = 1
RESULTS:4 '= "ターミナル"
RETURN RESULT

;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_88, ARG
FLAG:현M = 0
FLAG:현X = 9
FLAG:현Y = 24
;CALL AUTOMAP
RETURN 0

;=======================================================================
;攻略開始時のイベント
;=======================================================================
@EVENT_DUNGEON_START_88
;クリア前でネミッサと入ったことがない
IF ダンジョンフラグ:88:1 == 0 && ダンジョンフラグ:88:2 != 2
	;ネミッサがパーティ内にいる
	IF (FINDCHARA_B([[キャラ:네밋사_밝음]]) == 2 || FINDCHARA_B([[キャラ:네밋사_쿨]]) == 2 || FINDCHARA_B([[キャラ:네밋사_섹시]]) == 2)
		PRINTFORMW 레온 자동차 공장앞으로 왔다……
		PRINTFORML 　
		;ネミッサと入ったことない
		IF ダンジョンフラグ:88:2 != 2
			PRINTFORMW 「여기에 무위스가 있는거네……。」
			PRINTFORMW 「내 기억의 단서……이번엔 놓치지 않을 거니까！」
			PRINTFORMW 단단히 마음먹은 네밋사와 함께 공장 내부로 발을 내밀었다。
			
			;ネミッサと入ったことあるへ
			ダンジョンフラグ:88:2 = 2
		ENDIF
	ELSE
		;入ったことない
		IF ダンジョンフラグ:88:2 == 0
			PRINTFORMW 이 공장 어딘가에 무위스가 있을 터。
			PRINTFORMW 하지만, 표적이 된 네밋사가 없는 상태로는, 모습을 드러내지 않을지도 모른다。
			PRINTFORML 　
			PRINTFORMW 무위스와 싸우기 위해선 네밋사를 데려올 필요가 있을 것 같다……
			
			;入ったことあるへ
			ダンジョンフラグ:88:2 = 1
		ENDIF
	ENDIF
ENDIF


;=======================================================================
;脱出時のイベント
;=======================================================================
@EVENT_DUNGEON_END_88
PRINTFORML 　
;ムーウィス撃破済みでレオン自動車工場クリアしてない
IF ダンジョンフラグ:88:3 == 1 && ダンジョンフラグ:88:1 == 0
	PRINTFORMW 무위스를 쓰러트려 레온 자동차 공장으로부터 사례비를 받았다
	PRINTFORML 　
	PRINTFORMW 계좌에 40000엔이 들어왔고, 명성 30을 얻었다。
	
	MONEY += 40000
	FLAG:명성 += 30
	
	;レオン自動車工場クリアフラグ
	ダンジョンフラグ:88:1 = 1
ENDIF

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_88, ARG, ARG:1
;SELECTCASE DA:ARG:(ARG:1)
;ENDSELECT

;非常用電源起動してない
IF FLAG:현M == 0 && ARG == 16 && ARG:1 == 18
	IF FLAG:현X < ARG
		PRINTFORML 오토록이 걸려있기 때문에
		PRINTFORMW 여기서는 열 수 없을 것 같다。
		RETURN 0
	ENDIF
ELSEIF FLAG:현M == 1 && ARG == 21 && ARG:1 == 23 && ダンジョンフラグ:88:5 != 2
	PRINTFORMW 엘리베이터 같지만 전원이 끊긴 모양이다……
	RETURN 0
;カギ持ってる、扉開けてない
;ELSEIF FLAG:현M == 1 && ARG == 21 && ARG:1 == 23 && ダンジョンフラグ:88:2 == 4 && ダンジョンフラグ:88:6 == 0
;	PRINTFORMW 持っていたカギで扉を開けた……
;	;扉開錠フラグ開けたへ
;	ダンジョンフラグ:88:6 = 1
;	RETURN 0
ENDIF

CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

