;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_98
;コオリノハテニorホノオノハテニ クリア
IF イベントフラグ:102:0 == 3
	RETURN 1
ELSEIF イベントフラグ:102:0 == 6
	RETURN 1
ENDIF

;=======================================================================
;긴눙가가프
;=======================================================================
@GET_DUNGEON_NAME_98
#FUNCTIONS
RESULTS_F = ギンヌンガガップ
@FLOORNAME_98
SELECTCASE FLAG:현M
	CASE 0
	PRINTL 불과 얼음의 경계・１F
	CASE 1
	PRINTL 불과 얼음의 경계・２F
	CASE 2
	PRINTL 불과 얼음의 경계・３F
	CASE 3
	PRINTL 불과 얼음의 경계・４F
	CASE 4
	PRINTL 불과 얼음의 경계・신의 사당
	CASE 5
	PRINTL 이미르의 샘・１F
	CASE 6
	PRINTL 이미르의 샘・２F
	CASE 7
	PRINTL 이미르의 샘・３F
	CASE 8
	PRINTL 이미르의 샘・４F
	CASE 9
	PRINTL 암흑의 공간
ENDSELECT

;=======================================================================
;ターミナルマップ
;RESULT:X = 1で階層Mのマップのターミナルを登録できる
;登録されたターミナル同士は相互で移動が可能になり、スタート地点から選べるようになる
;
;RESULTS:100は入り口の名称。入り口のままでいいなら定義する必要はない
;=======================================================================
@TERMINAL_MAP_98, IS_START
#DIM DYNAMIC IS_START
RESULT:6 = 1
RESULTS:6 '= "터미널"
RETURN RESULT

;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_98, ARG
FLAG:현M =  0
FLAG:현X = 9
FLAG:현Y = 15
;CALL AUTOMAP
RETURN 0

;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_98
IF ダンジョンフラグ:98:2 == 0
	CALL MESSAGE_WINDOW_D, "", "＞불의 세계와 얼음 세계의 경계　긴눙가가프"
	CALL MESSAGE_WINDOW_D, "", "＞근처에 사는 주민의 말에 따르면、여기서 사도와 수호신이 무언가의 준비를 하고 있다고 한다"
	CALL MESSAGE_WINDOW_D, "", "＞그런 조사 결과가 나와 있다。아마도 소녀 역시 이곳에 있을 것이다…"
	ダンジョンフラグ:98:2 = 1
ENDIF
;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_98, ARG, ARG:1
SELECTCASE DA:ARG:(ARG:1)
ENDSELECT
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

;=======================================================================
;特殊タイル表示
;=======================================================================
@TILE_MARK_COMMON_98_1, ARG , ARG:1 , ARG:2
SELECTCASE ARG / 10
	CASE 10 , 20 , 30 , 40 , 50 , 60 , 70 , 80 , 90, 160 , 170 , 171
		SETCOLOR 0xFFFF00
		RESULTS = ◎
	CASE 101 , 111 , 121 , 131 , 141 , 151
		RESULTS = 穴
;	CASE 11 , 21 , 31 , 41 , 51 , 61 , 71 , 81 , 91 , 160 , 161 , 100 , 110 , 120 , 130 , 140 , 150
;		RESULTS = □
	CASE 180
	RESULTS = ↑
	CASE 181
	RESULTS = ↓
	CASEELSE
		RETURN 1
ENDSELECT

@TILE_MARK_COMMON_98_4, ARG , ARG:1 , ARG:2
SELECTCASE ARG / 10
	CASE 100
		SIF ダンジョンフラグ:98:0 == 0
			RESULTS = ！
	CASE 200
		SIF ダンジョンフラグ:98:0 == 1
			RESULTS = ！
	CASE 300
		SIF ダンジョンフラグ:98:0 == 2
			RESULTS = ！
		CASE 400
		SIF ダンジョンフラグ:98:0 == 3
			RESULTS = ！
	CASE 500
		SIF ダンジョンフラグ:98:0 == 4
			RESULTS = ！
		SIF ダンジョンフラグ:98:1 > 0
			RESULTS = ！
ENDSELECT


@TILE_MARK_COMMON_98_9, ARG , ARG:1 , ARG:2
SELECTCASE ARG / 10
	CASE 1
		SETCOLOR 0xFFFF00
		RESULTS = ◎
	CASE 2
	IF ダンジョンフラグ:98:0 >= 2
		SETCOLOR 0xFFFF00
		RESULTS = ◎
	ENDIF
ENDSELECT
