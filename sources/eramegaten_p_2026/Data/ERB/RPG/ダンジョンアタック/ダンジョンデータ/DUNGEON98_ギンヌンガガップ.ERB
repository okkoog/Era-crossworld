			CALL MESSAGE_WINDOW_D, "", "＞세계가 시작되기 전부터 다툼이 있었다。창세의 여신에게는、짝이 되는 파괴의 여신이 있었다"
			CALL MESSAGE_WINDOW_D, "", "＞천계의 기록에는、호시가미는 인간과 천사와 악마의 힘을 사용하여、사신(자신)을 봉인했다。고 되어 있지만…"
			CALL MESSAGE_WINDOW_D, "사신", "호시가미의 보잘것없는 아이들아、모두、모두 멸망하거라"
			CALL INPUT_SELECT_D, @"[1] 준비되었다/[2] 기다려"

			SELECTCASE RESULT
				CASE 1
					CALL MESSAGE_WINDOW_D, "사신", "호시가미의 피조물이여/다 함께 산산조각나거라…"
					CALL BATTLE_jyasin
					CALL MESSAGE_WINDOW_D, "사신", "나의 패배다…"
					;撃破ボーナス：ジャシン解禁
					CALL LIFTING_A_BAN([[キャラ:쟈신]])
					CALL MESSAGE_WINDOW_D, "사신", "시간여행자여、이후는 마음대로 하도록 해라…"
					CALL MESSAGE_WINDOW_D, "", "＞사신(자신)이 노예가 되었다"
					CALL ADD_NEW_COMPANION,[[キャラ:쟈신]],300
					ダンジョンフラグ:98:1 = 2
				CASE 2
					CALL MESSAGE_WINDOW_D, "사신", "그런가……"
				ENDSELECT
		ENDIF
	ENDSELECT
	RETURN 0
ENDSELECT
RETURN 1

