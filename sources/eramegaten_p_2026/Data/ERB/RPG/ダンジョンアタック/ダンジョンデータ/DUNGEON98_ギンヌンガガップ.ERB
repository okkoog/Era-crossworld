;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_98
CALL EVENT_DUNGEON_98
RETURN RESULT

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_98,ARG
;ARG = 進入時の向き　0の場合ワープなど
CALL EVENT_DUNGEON_98, ARG , 0
RETURN RESULT

@EVENT_DUNGEON_98, ARG, ARG:1
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) % 10
	;==========
	;ワープの処理
	;==========
	CASE 1
		CALL FLOOR_98
		RETURN RESULT
	CASE 9
		SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
		CASE 1
			CALL DUNGEON_WORP,2,11,3
		CASE 2
			SIF ダンジョンフラグ:98:0 >= 2
				CALL DUNGEON_WORP,5,2,3
		ENDSELECT
	;==========
	;出口の処理
	;==========
	CASE 8
		CALL DUNGEON_EXIT
	RETURN 1
	;==========
	;扉の処理
	;==========
	CASE 2
		CALL DUNGEON_DOOR,ARG
		RETURN 1
	;========
	;宝の処理
	;========
	CASE 3
		CALL TREASURE_98
		RETURN 1
	;=======
	;階段
	;=======
	CASE 6
		CALL UPSTAIRS_98
		RETURN RESULT
	CASE 7
		CALL DOWNSTAIRS_98
		RETURN RESULT
	;==========
	;이벤트
	;==========
	CASE 4
		SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
	CASE  100
		IF ダンジョンフラグ:98:0 == 0
			IF イベントフラグ:102:0 == 3 
				CALL MESSAGE_WINDOW_D, "메피스토", "오랜만이군요/그럼 싸워볼까요！"
				CALL MESSAGE_WINDOW_D, "", "＞사신　메피스토가 １체 나타났다！" , , , , , , , , , "CENTER"
				FLAG:도주불가플래그 = 1
				FLAG:회화불능플래그 = 1
				FLAG:선제기습취소 = 1
				CALL SET_ENEMY,9,[[キャラ:메피스토]], 69, 0, 1
				CFLAG:(CHARANUM-1):ＨＰ보정 = 1000
				CFLAG:(CHARANUM-1):ＭＰ보정 = 500
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				CALL BATTLE_START

				FLAG:도주불가플래그 = 0
				FLAG:회화불능플래그 = 0
				FLAG:선제기습취소 = 0
				CALL MESSAGE_WINDOW_D, "메피스토", "빛의 후예여。당신의 힘이 얼음 사도의 힘을 일깨우는 것입니다…"
				CALL MESSAGE_WINDOW_D, "메피스토", "저 레나라는 소녀조차도。당신을 불러들이기 위한 미끼에 지나지 않았던 거다…"
				ダンジョンフラグ:98:0 = 1
			ELSEIF イベントフラグ:102:0 == 6
				CALL MESSAGE_WINDOW_D, "이사크", "오랜만이군요/아미를 위해、잘도 여기까지 오셨습니다"
				CALL MESSAGE_WINDOW_D, "", "＞영웅　이사크가 １체 나타났다！" , , , , , , , , , "CENTER"
				FLAG:도주불가플래그 = 1
				FLAG:회화불능플래그 = 1
				FLAG:선제기습취소 = 1
				CALL SET_ENEMY,9,[[キャラ:이삭]], 69, 0, 1
				CFLAG:(CHARANUM-1):ＨＰ보정 = 1000
				CFLAG:(CHARANUM-1):ＭＰ보정 = 500
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				CALL BATTLE_START

				FLAG:도주불가플래그 = 0
				FLAG:회화불능플래그 = 0
				FLAG:선제기습취소 = 0
				CALL MESSAGE_WINDOW_D, "이사크", "어둠의 귀공자여。불의 사도를 만나러 가세요…"
				CALL MESSAGE_WINDOW_D, "이사크", "빛의 힘을 따르는 그분께서、아미를 원하셨으니까요…"
				ダンジョンフラグ:98:0 = 1
			ENDIF
		ENDIF
	CASE  200
		IF ダンジョンフラグ:98:0 == 1
