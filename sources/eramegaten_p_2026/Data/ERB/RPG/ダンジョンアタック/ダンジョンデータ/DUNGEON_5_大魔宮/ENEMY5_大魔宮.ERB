;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_5
SELECTCASE FLAG:현M
	;ミコンの街
	CASE 0
		FLAG:미조우걸음수 = 0
		FLAG:인카운트율 = 0
		FLAG:MAG소비율 = 0
	;ビエン1F/2Fはメデューサ撃破後は敵がでない
	CASE 13, 14
		IF STRFLAG_D("メデューサ撃破")
			FLAG:미조우걸음수 = 0
			FLAG:인카운트율 = 0
			FLAG:MAG소비율 = 0
		ELSE
			FLAG:인카운트율 = MAX(FLAG:미조우걸음수 * 5 - 25, 0)
			FLAG:MAG소비율 = 100
		ENDIF
	CASEELSE
		FLAG:인카운트율 = MAX(FLAG:미조우걸음수 * 5 - 25, 0)
		FLAG:MAG소비율 = 100
ENDSELECT
;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_5
IF RAND:100 < FLAG:인카운트율
	;一方通行の処理
	CALL ONE_WAY(902, 912, 922, 932, 942, 952, 962, 972)
	RETURN 1
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF

