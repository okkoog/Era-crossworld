@SET_MINOTAUR
#DIM DYNAMIC L_CHARA
CALL SET_ENEMY,9,[[キャラ:미노타우로스]],30,0,1
L_CHARA = CHARANUM-1
IF !ITEM:정옥
	ABL:L_CHARA:아이템3 = GETNUM(ITEM, "정옥")
	ABL:L_CHARA:입수확률3 = 100
ENDIF
CFLAG:L_CHARA:행동횟수 = 3
CSTR:L_CHARA:사고패턴 = 大魔宮_ミノタウロス
CALL CLEAR_ALL_SKILL, L_CHARA
CALL SET_SKILL, L_CHARA, "대나무베기"
CALL SET_SKILL, L_CHARA, "라비리스연격"
CALL SET_SKILL, L_CHARA, "혈제"
CALL SET_SKILL, L_CHARA, "도발"
CALL SET_SKILL, L_CHARA, "포효"

CALL SYNC_STATUS,L_CHARA
CALL HEALTH_CHARA,L_CHARA

@SET_ACTION_大魔宮_ミノタウロス, L_ENEMY
#DIM DYNAMIC L_ENEMY
CALL SET_ACTION_SKILL, L_ENEMY, 0
IF CFLAG:L_ENEMY:１more플래그
	IF RAND:100 < 30
		CALL SET_ACTION_SKILL, L_ENEMY, [[스킬:대나무베기]]
	ELSE
		CALL SET_ACTION_SKILL, L_ENEMY, 0
	ENDIF
ELSE
	SELECTCASE CFLAG:L_ENEMY:행동한횟수
		CASE 0
			SELECTCASE RAND:100
				CASE IS < 20
					IF CFLAG:L_ENEMY:공격강화 < 16
						CALL SET_ACTION_SKILL, L_ENEMY, [[스킬:도발]]
					ELSE
						CALL SET_ACTION_SKILL, L_ENEMY, 0
					ENDIF
				CASE IS < 40
					IF CFLAG:GET_RANDOM_FRIEND():공격강화 > -16
						CALL SET_ACTION_SKILL, L_ENEMY, [[스킬:포효]]
					ELSE
						CALL SET_ACTION_SKILL, L_ENEMY, 0
					ENDIF
			ENDSELECT
		CASE 1
			SELECTCASE RAND:100
				CASE IS < 15
					CALL SET_ACTION_SKILL, L_ENEMY, [[스킬:대나무베기]]
				CASE IS < 40
					CALL SET_ACTION_SKILL, L_ENEMY, [[스킬:혈제]]
				CASEELSE
					CALL SET_ACTION_SKILL, L_ENEMY, 0
			ENDSELECT
		CASE 2
			SELECTCASE RAND:100
				CASE IS < 15
					CALL SET_ACTION_SKILL, L_ENEMY, [[스킬:라비리스연격]]
				CASE IS < 30
					CALL SET_ACTION_SKILL, L_ENEMY, [[스킬:대나무베기]]
				CASEELSE
					CALL SET_ACTION_SKILL, L_ENEMY, 0
			ENDSELECT
	ENDSELECT
ENDIF
