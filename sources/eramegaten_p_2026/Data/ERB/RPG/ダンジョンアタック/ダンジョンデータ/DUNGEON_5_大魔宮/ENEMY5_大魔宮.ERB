;------------------------------
;セトの思考パターン
;妬みの暴圧・アゲンストペイン・砂漠の風・色即是空
;ラスタキャンディ・ランダマイザ・気合
;(マハ)ブフ・アギ・マグ・ジオ・ザンダイン(9999)
;
;元にしたのはアバチュ2版
;とはいえ、再現しきると隠しボスだけあってひどいことになるので
;とりあえず物理系と色即是空以外の状態異常系とメギドラオンを抜いて作成
;
;TIPS
;専用スキル
;질투의폭압				威力が200～1000まで変動する万能全体 タルンダの効果が2重に掛かるので、ンダMAXで威力1/4になる
;						行動回数の合計が12回を越えてるとき、1回目の行動がこれになる(カウントは撃ったらリセット)
;어게인스트페인		威力500・クリティカル率補正60 スクンダの効果が二重にかかるので、ンダMAXで命中率1/4になる
;사막의바람				ダメージを与えつつ味方をＣＯＭＰに引っ込める。引っ込まない場合はCOOP
;
;主力攻撃となる万能のうち上記２種は弱体をかけることで飛躍的に弱まるので基本的にはンダを維持して戦うことに
;また、デカジャも持ってないのでカジャも有効
;ただし、ラスタ・ランダで相殺を狙ってくるので更新も必要
;
;あとは原作通り５種ダイン＋색즉시공
;
;有効なのは
;行動なしで味方を復帰させられるＤＤＳ
;壁系(単体魔法が多いのもあってかなり場持ちする)・札(ブフ・ジオ・アギが弱点の悪魔は貼っておくとかなり違う)・マカラカーン(ただし20%割るまで)
;クリ対策にコーチング
;突撃の狼煙・Lランダマイザ・雄叫び・フォッグブレス
;強力な飛具スキル(飛具でCOOP取れるので)
;アムリタ・Ｌメシアライザー・メディアラハン
;------------------------------
@SET_ACTION_SET, ARG
#LOCALSIZE 5
#DIM 行動周期
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
;20%を割ると3回行動
CFLAG:ARG:행동횟수 = 現HP割合(ARG) < 20 ? 3 # 2
;行動1回目
IF CFLAG:ARG:행동한횟수 == 0
	IF 行動周期 > 12
		CFLAG:ARG:입력행동 = [[스킬:질투의폭압]]
		行動周期 = 0
	ELSE
		;気合フラグがあるときは必ずアゲンストペイン
		IF CFLAG:ARG:気合フラグ
			CFLAG:ARG:입력행동 = [[스킬:어게인스트페인]]
		ELSE
			SELECTCASE RAND:100
				CASE IS < 30
					CFLAG:ARG:입력행동 = [[스킬:어게인스트페인]]
				CASE IS < 50
					CFLAG:ARG:입력행동 = [[스킬:색즉시공]]
				CASE IS < 70
					CFLAG:ARG:입력행동 = 9999
				CASEELSE
					CFLAG:ARG:입력행동 = 0
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	SELECTCASE RAND:100
		CASE IS < 15
			CFLAG:ARG:입력행동 = [[스킬:어게인스트페인]]
		CASE IS < 30
			CFLAG:ARG:입력행동 = [[스킬:사막의바람]]
		CASE IS < 50
			CFLAG:ARG:입력행동 = [[스킬:랜더마이저]]
		CASE IS < 65
			CFLAG:ARG:입력행동 = [[스킬:라스타캔디]]
		CASE IS < 80
			CFLAG:ARG:입력행동 = 9999
		CASEELSE
			IF CFLAG:ARG:행동한횟수 == CFLAG:ARG:행동횟수 - 1 && RAND:2
				CFLAG:ARG:입력행동 = [[스킬:기합]]
			ELSE
				CFLAG:ARG:입력행동 = 0
			ENDIF
	ENDSELECT
ENDIF
IF CFLAG:ARG:입력행동 == 9999
	;ランダマイザ・ラスタキャンディの追加判定
	LOCAL:2 = 0
	LOCAL:3 = 0
	;反射フラグの取得
	LOCAL:4 = 0
	FOR LOCAL:1, 0, 5
		FOR LOCAL, 1, 7
			IF POS(LOCAL) > 0 
				LOCAL:2 = MAX(LOCAL:2, CFLAG:POS(LOCAL):AUTO_SPLIT("명중강화/회피강화/마법위력강화/공격강화/방어강화", "/", LOCAL:1))
				SIF CFLAG:POS(LOCAL):마법반사플래그
					LOCAL:4 = 1
			ENDIF
		NEXT
		LOCAL:3 = MAX(LOCAL:3, -CFLAG:ARG:AUTO_SPLIT("명중강화/회피강화/마법위력강화/공격강화/방어강화", "/", LOCAL:1))
	NEXT
	;強化度によって最大25%の確率でランダマイザ
	IF LOCAL:2 > RAND:128
		CFLAG:ARG:입력행동 = [[스킬:랜더마이저]]
	;強化度によって最大25%の確率でラスタキャンディ
	ELSEIF LOCAL:3 > RAND:64
		CFLAG:ARG:입력행동 = [[스킬:라스타캔디]]
	ELSE
		IF 現HP割合(ARG) < 50 && !RAND:5
			SELECTCASE RAND:100
				CASE IS < 20
					CFLAG:ARG:입력행동 = [[스킬:마하・라기다인]]
				CASE IS < 40
					CFLAG:ARG:입력행동 = [[스킬:마하・부흐다인]]
				CASE IS < 60
					CFLAG:ARG:입력행동 = [[스킬:마하・지오다인]]
				CASE IS < 80
					CFLAG:ARG:입력행동 = [[스킬:마하・잔다인]]
				CASEELSE
					CFLAG:ARG:입력행동 = [[스킬:마하・마그다인]]
			ENDSELECT
		ELSE
			SELECTCASE RAND:100
				CASE IS < 20
					CFLAG:ARG:입력행동 = [[스킬:아기다인]]
				CASE IS < 40
					CFLAG:ARG:입력행동 = [[스킬:부흐다인]]
				CASE IS < 60
					CFLAG:ARG:입력행동 = [[스킬:지오다인]]
				CASE IS < 80
					CFLAG:ARG:입력행동 = [[스킬:잔다인]]
				CASEELSE
					CFLAG:ARG:입력행동 = [[스킬:마그다인]]
			ENDSELECT
		ENDIF
		;瀕死になると反射に対して反応
		IF LOCAL:4 && 現HP割合(ARG) < 20
			SELECTCASE RAND:100
				CASE IS < 20
					CFLAG:ARG:입력행동 = [[스킬:질투의폭압]]
				CASE IS < 60
					CFLAG:ARG:입력행동 = [[스킬:어게인스트페인]]
				CASEELSE
					CFLAG:ARG:입력행동 = [[스킬:색즉시공]]
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
;砂漠の風で1MOREを取った場合は50％の確率で再び使う
SIF CFLAG:ARG:１more플래그 > 0 && CFLAG:ARG:200 == [[스킬:사막의바람]] && RAND:2
	CFLAG:ARG:입력행동 = [[스킬:사막의바람]]
;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
;前回の行動をとっておく
CFLAG:ARG:200 = CFLAG:ARG:입력행동
;暴圧用の行動回数を加算
行動周期++
RETURN 1



@EVENT_BATTLE_ACTEND_DUNGEON5
#LOCALSIZE 1
;一応
SIF FLAG:행동순1 == -1
	RETURN 0
;敵のロキを探す
SIF !FINDCHARA_ENEMY([[キャラ:로키]])
	RETURN 0
LOCAL = RESULT:1
IF CFLAG:(FLAG:행동순1):PT플래그
	CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:(FLAG:행동순1):입력행동, FLAG:행동순1
	;攻撃かつロキのＨＰが変動していることが条件
	IF RESULT == 1 && TFLAG:436 != BASE:LOCAL:ＨＰ
		TRYCALL GET_SKILL_PROP, "SKILL_TYPE", CFLAG:(FLAG:행동순1):입력행동, FLAG:행동순1
		SIF RESULT == GET_TYPE_NUM("만능")
			TFLAG:400 += 1
		SIF RESULT >= 0 && MAXBASE:LOCAL:GET_TYPE(RESULT) > 100
			TFLAG:400 -= 1
	ENDIF
	CFLAG:LOCAL:행동횟수 = MAX(2, 2 + TFLAG:400)
	MAXBASE:LOCAL:만능 = TFLAG:400 < 0 ? 200 # 100
	IF CFLAG:LOCAL:행동횟수 > CFLAG:LOCAL:행동한횟수
		CFLAG:LOCAL:입력행동 = [[스킬:메기도라온]]
		CFLAG:LOCAL:속도보정 = 10000
	ENDIF
ENDIF
;毎ターンＨＰを記録する
TFLAG:436 = BASE:LOCAL:ＨＰ
@EVENT_BATTLE_TURNEND_DUNGEON5
;敵のロキを探す
SIF !FINDCHARA_ENEMY([[キャラ:로키]])
	RETURN 0
MAXBASE:(RESULT:1):만능 = 100


;=======================================================================
;輪姦参加悪魔
;=======================================================================
@DUNGEON_RAPE_DEVIL_5
;ランダムにどの悪魔が出るか決定
;RETURN CSV番号 , 人数 , レベル
SELECTCASE FLAG:현M
	CASE 1 , 2 , 3
		RETURN [[キャラ:코파텐구]] , 3 + RAND:10 , CSVBASE([[キャラ:코파텐구]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 4 , 5 , 6
		RETURN [[キャラ:오니]] , 3 + RAND:10 , CSVBASE([[キャラ:오니]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 7
		RETURN [[キャラ:모무노후]] , 3 + RAND:10 , CSVBASE([[キャラ:모무노후]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 9 , 10
		RETURN [[キャラ:콥스]] , 6 + RAND:10 , CSVBASE([[キャラ:콥스]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 13 , 14
		RETURN [[キャラ:모무노후]] , 3 + RAND:10 , CSVBASE([[キャラ:모무노후]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 12 , 15 , 16
		RETURN [[キャラ:인큐버스]] , 3 + RAND:10 , CSVBASE([[キャラ:인큐버스]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 17 TO 25
		RETURN [[キャラ:레기온]] , 6 + RAND:10 , CSVBASE([[キャラ:레기온]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 25 , 26
		RETURN [[キャラ:나가・라쟈]] , 3 + RAND:10 , CSVBASE([[キャラ:나가・라쟈]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 27 TO 31
		RETURN [[キャラ:베르세르크]] , 3 + RAND:10 , CSVBASE([[キャラ:베르세르크]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 32 TO 36
		RETURN [[キャラ:뱀파이어]] , 3 + RAND:10 , CSVBASE([[キャラ:뱀파이어]] , GETNUM(BASE , "LV") , 0) + RAND:3
ENDSELECT