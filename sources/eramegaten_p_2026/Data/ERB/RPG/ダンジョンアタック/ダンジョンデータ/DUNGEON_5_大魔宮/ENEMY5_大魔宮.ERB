		CASE "파마", "주살"
			BASE:LOCAL:GET_TYPE(LOCAL:1) = 0
		CASE "중력", "핵열", "충격", "전격", 
			BASE:LOCAL:GET_TYPE(LOCAL:1) = 75
		CASE "신경", "정신" 
			BASE:LOCAL:GET_TYPE(LOCAL:1) = 50
		CASE "화염", "빙결", "질풍", "지변", "수격"
			BASE:LOCAL:GET_TYPE(LOCAL:1) = 25
	ENDSELECT
NEXT
CALL SYNC_STATUS, LOCAL
CALL HEALTH_CHARA, LOCAL

;------------------------------
;ヘカーテの思考パターン
;満月の女王・マハムドオン・マハグラダイン・グラダイン
;ブフダイン・マグダイン・マカラカーン・マリンカリン・シバブー
;マハマカカジャ・デカジャ・デクンダ

;1.相性学習型で、グラダイン・ブフダイン・マグダイン・マリンカリン・シバブー・マハムドオンは
;  無効以下だと把握した場合は避け、弱点だと優先して撃ってくる
;　また、無効以下で判定しなおす際に満月の女王・マハマカカジャのいずれかを使ってくる可能性が生まれる
;
;2.HP30%未満で行動回数3回に
;3.カジャンダは3回を超えると剥がしてくる
;4.満月の女王は基本的にはターン中1回だけど、1MOREで撃ってくる可能性がある
;　なお、満月の女王は特別版で、新月60/満月240/その他120となっている
;
;TIPS
;新月なら満月の女王の威力がかなり控えめになるので、範囲攻撃が弱まり、攻撃がかなりぬるくなるはず
;マハ・マカカジャに対してデカジャあるいはンダで上回ってれば、攻撃を凌ぐのはそこまで大変じゃない…はず
;ラトス像を使ってれば、わりと低耐久な感じになるので、一気に押しきれるはずたぶん
;
;포효＋タルンダ1回でデクンダ誘発で、行動回数を1回潰すことも可能
;さらに挑発＋カジャ1回でデカジャも誘発すれば、行動2回なうちは完全に行動潰せる
;
;マカラカーン対策はしてないので、わりとダメを減らせる
;
;満月＋像なしは相当レベル必要そうな予感
;------------------------------
@SET_ACTION_HECATE, ARG
#LOCALSIZE 10
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
CFLAG:ARG:행동횟수 = 現HP割合(ARG) < 30 ? 3 # 2
;1more時
IF CFLAG:ARG:１more플래그 > 0
	SELECTCASE RAND:100
		CASE IS < 50
			CFLAG:ARG:입력행동 = 9999
		CASE IS < 80
			CFLAG:ARG:입력행동 = [[스킬:마하・마카카쟈]]
			SIF CFLAG:ARG:마법위력강화 == 32
				CFLAG:ARG:입력행동 = [[스킬:만월의여왕]]
		CASEELSE
			CFLAG:ARG:입력행동 = [[스킬:만월의여왕]]
	ENDSELECT
ELSEIF CFLAG:ARG:행동한횟수 == 0
	SELECTCASE RAND:100
		CASE IS < 60
			CFLAG:ARG:입력행동 = 9999
		CASE IS < 80
			CFLAG:ARG:입력행동 = [[스킬:마카라칸]]
		CASEELSE
			CFLAG:ARG:입력행동 = [[스킬:마하・마카카쟈]]
			SIF CFLAG:ARG:마법위력강화 == 32
				CFLAG:ARG:입력행동 = [[스킬:만월의여왕]]
	ENDSELECT
ELSEIF CFLAG:ARG:행동한횟수 == 1
	IF 現HP割合(ARG) < 30
		CFLAG:ARG:입력행동 = 9999
	ELSE
		SELECTCASE RAND:100
			CASE IS < 15
				CFLAG:ARG:입력행동 = [[스킬:만월의여왕]]
			CASE IS < 40
				CFLAG:ARG:입력행동 = [[스킬:마하・그라다인]]
			CASEELSE
				CFLAG:ARG:입력행동 = 9999
		ENDSELECT
	ENDIF
ELSE
	SELECTCASE RAND:100
		CASE IS < 30
			CFLAG:ARG:입력행동 = [[스킬:만월의여왕]]
		CASE IS < 60
			CFLAG:ARG:입력행동 = [[스킬:마하・그라다인]]
		CASEELSE
			CFLAG:ARG:입력행동 = 9999
	ENDSELECT
ENDIF
LOCAL:9 = 0
WHILE CFLAG:ARG:입력행동 == 9999
	;対象キャラ決定作業
	LOCAL = RAND:3 ? RAND(1, 4) # RAND(4, 7)
	SIF POS(LOCAL) < 0
		CONTINUE
	SIF GET_STATE(CFLAG:POS(LOCAL):상태이상) == "DYING"
		CONTINUE
	LOCAL:8 = -1
	FOR LOCAL:1, 2, 8
		;保持している相性を取得
		LOCAL:(LOCAL:1) = CHECK_WEAKNESS(MEMORIZE_WEAKNESS(ARG, LOCAL, AUTO_SPLIT("0/1/중력/빙결/지변/정신/신경/주살", "/", LOCAL:1), 1))
		;弱点にひっかかったらそこで決定
		IF LOCAL:(LOCAL:1) == 1
			LOCAL:8 = LOCAL:1
			BREAK
		ENDIF
	NEXT
	LOCAL:1 = RAND:10 < 7 ? RAND(2, 5) # RAND(5, 8)
	IF GROUPMATCH(CHECK_WEAKNESS(MEMORIZE_WEAKNESS(ARG, LOCAL, AUTO_SPLIT("0/1/중력/빙결/지변/정신/신경/주살", "/", LOCAL:1))), 1000, 0, -1, 1)
		SELECTCASE AUTO_SPLIT("0/1/중력/빙결/지변/정신/신경/주살", "/", LOCAL:8 == -1 ? LOCAL:1 # LOCAL:8)
			CASE "중력"
				CFLAG:ARG:입력행동 = [[스킬:마하・그라다인]]
				CFLAG:ARG:타겟 = LOCAL < 4 ? 17 # 18
			CASE "빙결"
				CFLAG:ARG:입력행동 = [[스킬:부흐다인]]
				CFLAG:ARG:타겟 = LOCAL
			CASE "지변"
				CFLAG:ARG:입력행동 = [[스킬:마그다인]]
				CFLAG:ARG:타겟 = LOCAL
			CASE "정신"
				CFLAG:ARG:입력행동 = [[스킬:마린카린]]
				CFLAG:ARG:타겟 = LOCAL
			CASE "정신"
				CFLAG:ARG:입력행동 = [[스킬:시바브]]
				CFLAG:ARG:타겟 = LOCAL
			CASE "주살"
				CFLAG:ARG:입력행동 = [[스킬:마하무드온]]
				CFLAG:ARG:타겟 = LOCAL < 4 ? 17 # 18
		ENDSELECT
	ELSE
		IF RAND:100 < LOCAL:9*10
			IF RAND:100 < 20
				CFLAG:ARG:입력행동 = [[스킬:만월의여왕]]
			ELSEIF RAND:100 < 50
				CFLAG:ARG:입력행동 = [[스킬:마하・마카카쟈]]
				SIF CFLAG:ARG:마법위력강화 == 32
					CFLAG:ARG:입력행동 = [[스킬:만월의여왕]]
			ENDIF
		ENDIF
	ENDIF
	LOCAL:9++
WEND
;カジャンダの許容は2回まで
FOR LOCAL:1, 0, 5
	FOR LOCAL, 1, 7
		IF POS(LOCAL) > 0 && CFLAG:POS(LOCAL):AUTO_SPLIT("명중강화/회피강화/마법위력강화/공격강화/방어강화", "/", LOCAL:1) > 8
			CFLAG:ARG:입력행동 = [[스킬:데・카쟈]]
			CFLAG:ARG:타겟 = -1
		ENDIF
	NEXT
	IF CFLAG:ARG:AUTO_SPLIT("명중강화/회피강화/마법위력강화/공격강화/방어강화", "/", LOCAL:1) < -8
		CFLAG:ARG:입력행동 = [[스킬:데・쿤다]]
		CFLAG:ARG:타겟 = -1
	ENDIF
NEXT
;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1
