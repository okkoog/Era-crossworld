	ENDSELECT
ELSEIF CFLAG:ARG:행동한횟수 < 2
	SELECTCASE RAND:100
		CASE IS < 15
			CFLAG:ARG:입력행동 = [[스킬:자장가]]
		CASE IS < 30
			CFLAG:ARG:입력행동 = [[스킬:마구날뛰기]]
		CASE IS < 45
			CFLAG:ARG:입력행동 = [[스킬:마하에이하]]
		CASE IS < 60
