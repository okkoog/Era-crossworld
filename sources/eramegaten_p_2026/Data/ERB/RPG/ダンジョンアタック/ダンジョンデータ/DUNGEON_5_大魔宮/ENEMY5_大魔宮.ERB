BASE:LOCAL:LV = 50
IF !ITEM:고옥
	ABL:LOCAL:아이템3 = GETNUM(ITEM, "고옥")
	ABL:LOCAL:입수확률3 = 100
ENDIF
CALL SYNC_STATUS, LOCAL
