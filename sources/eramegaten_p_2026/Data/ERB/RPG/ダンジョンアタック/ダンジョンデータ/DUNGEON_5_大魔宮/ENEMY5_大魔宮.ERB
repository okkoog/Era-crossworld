@SET_LOKI
#LOCALSIZE 2
CALL SET_ENEMY, 9, [[キャラ:로키]], 60, 0, 1
LOCAL = CHARANUM -1
LOCAL:1 = FLAG:전투난이도 - 3 > 0 ? 120 + (FLAG:전투난이도 - 3) * 20 # 100
CSTR:LOCAL:사고패턴 = LOKI
BASE:LOCAL:LV -= 20
IF !ITEM:황옥
	ABL:LOCAL:아이템3 = GETNUM(ITEM, "황옥")
	ABL:LOCAL:입수확률3 = 100
ENDIF
CALL SYNC_STATUS, LOCAL
CALL SET_BATTLE_STATUS(LOCAL, 80 * LOCAL:1, "ＨＰ")
CALL SET_BATTLE_STATUS(LOCAL, 100 * LOCAL:1, "ＭＰ")
BASE:LOCAL:속도 *= 2
CFLAG:LOCAL:속도보정 = BASE:LOCAL:속도
IF !STRFLAG_D("魔除け完成")
	CALL SET_BATTLE_STATUS(LOCAL, 2 * MAXBASE:LOCAL:ＨＰ, "ＨＰ")
	BASE:LOCAL:마력 *= 3
	BASE:LOCAL:지혜 *= 3
	CFLAG:LOCAL:속도보정 *= 2
ENDIF
BASE:LOCAL:운 = 25
BASE:LOCAL:BIND = -80
BASE:LOCAL:CLOSE = -100
BASE:LOCAL:핵열 = 150
ABL:LOCAL:스킬4 = [[스킬:마하에이하]]
ABL:LOCAL:스킬5 = [[스킬:데・카쟈]]
ABL:LOCAL:스킬6 = [[스킬:아카샤아츠]]
ABL:LOCAL:스킬7 = [[스킬:부흐다인]]
ABL:LOCAL:스킬8 = [[스킬:마린카린]]
CFLAG:LOCAL:행동횟수 = 2
CALL SYNC_STATUS, LOCAL
CALL HEALTH_CHARA, LOCAL
;------------------------------
;ロキの思考パターン
;1.PTメンバーの氷結相性によってニブルヘイムをメギドラオンにうちかえてくる
;2.万能攻撃にたいしてメギドラオンカウンター
;3.火属性・核熱属性を食らった場合、一時的に万能が弱点に
;4.3の状態の時はカウンターをしてこない
;------------------------------
@SET_ACTION_LOKI, ARG
#LOCALSIZE 1
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
IF CFLAG:ARG:행동한횟수 == 0 && CFLAG:ARG:１more플래그 == 0
	SIF FLAG:경과턴수 == 0
		TFLAG:437 = CFLAG:ARG:속도보정
	CFLAG:ARG:속도보정 = TFLAG:437
	CFLAG:ARG:행동횟수 = 2
	MAXBASE:ARG:만능 = 100
	FOR LOCAL, 1, 7
		SIF POS(LOCAL) < 0
			CONTINUE
		SIF GET_STATE(CFLAG:POS(LOCAL):상태이상)== "DYING"
			CONTINUE
		SELECTCASE MAXBASE:POS(LOCAL):빙결
			CASE 0
				TFLAG:401 += 5
			CASE 999
				TFLAG:401 += 10
			CASE IS < 0
				TFLAG:401 += 20
			CASE 100
				TFLAG:401 -= 5
			CASE IS > 100
				TFLAG:401 -= 10
		ENDSELECT
	NEXT
ENDIF
;1more時
IF CFLAG:ARG:１more플래그 > 0
	SELECTCASE RAND:100
		CASE IS < 40
			CFLAG:ARG:입력행동 = [[스킬:니플헤임]]
		CASE IS < 80
			CFLAG:ARG:입력행동 = [[스킬:마하에이하]]
		CASEELSE
			CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
	ENDSELECT
ELSEIF CFLAG:ARG:행동한횟수 == 0
	SELECTCASE RAND:100
		CASE IS < 50
			IF 現HP割合(ARG) < 30 || RAND:2
				CFLAG:ARG:입력행동 = [[스킬:니플헤임]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:부흐다인]]
			ENDIF
			SIF MAX(TFLAG:401, 5) > RAND:100
				CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
		CASE IS < 60
			CFLAG:ARG:입력행동 = [[스킬:아카샤아츠]]
		CASE IS < 70
			CFLAG:ARG:입력행동 = [[스킬:마하에이하]]
		CASE IS < 80
			;IF CFLAG:ARG:공격강화 + CFLAG:ARG:방어강화 + CFLAG:ARG:명중강화 < -32
			IF GET_カジャンダ_SUM(ARG) < -96
				CFLAG:ARG:입력행동 = [[스킬:데・쿤다]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마린카린]]
			ENDIF
		CASEELSE
			CFLAG:ARG:입력행동 = 0
	ENDSELECT
ELSEIF CFLAG:ARG:행동한횟수 == 1
	SELECTCASE RAND:100
		CASE IS < 10
			CFLAG:ARG:입력행동 = [[스킬:마하에이하]]
		CASE IS < 20
			CFLAG:ARG:입력행동 = [[스킬:아카샤아츠]]
		CASE IS < 30
			CFLAG:ARG:입력행동 = [[스킬:마린카린]]
		CASE IS < 70
			IF (現HP割合(ARG) < 25 && RAND:2) || (現HP割合(ARG) < 50 && RAND:3)||RAND:4
				CFLAG:ARG:입력행동 = [[스킬:니플헤임]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:부흐다인]]
			ENDIF
			SIF MAX(TFLAG:401, 5) > RAND:100
				CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
		CASEELSE
			CFLAG:ARG:입력행동 = 0
	ENDSELECT
ELSE
	CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
ENDIF
;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1
