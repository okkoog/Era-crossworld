;=======================================================================
;エネミーの内容
;=======================================================================
@SET_ENEMY_STATUS_103, L_ENEMY
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_ENEMY
#DIM DYNAMIC COUNT_GUEST
#DIM DYNAMIC COUNT_FRIEND
SELECTCASE NO:L_ENEMY
	CASE [[キャラ:원한의덩어리]]
		CFLAG:L_ENEMY:행동횟수 = 2
	CASE [[キャラ:밀려오는원한]]
		CFLAG:L_ENEMY:행동횟수 = 3
ENDSELECT
IF GROUPMATCH(NO:L_ENEMY, [[キャラ:마그마슬러지]], [[キャラ:장독]], [[キャラ:용수모]], [[キャラ:츠쿠츠쿠]], [[キャラ:원한의기운]], [[キャラ:원한의덩어리]])
	FOR LCOUNT, 1, 7
		SIF POS(LCOUNT) < 0
			CONTINUE
		SIF CFLAG:POS(LCOUNT):게스트가입플래그
			COUNT_GUEST++
		COUNT_FRIEND++
	NEXT
	;ゲストキャラの人数分だけ、EXPの基礎値を引く
	CFLAG:L_ENEMY:ＥＸＰ보정 = 100 * COUNT_GUEST / COUNT_FRIEND
ENDIF
;通常のランダム敵配置はない
@ENEMY_103, ARG
RETURN -1
