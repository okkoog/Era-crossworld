;=======================================================================
;宝箱まとめ
;=======================================================================
@TRESURING_CALLING_103
SELECTCASE FLAG:현M
	CASE 2
		IF DA:(FLAG:현X):(FLAG:현Y) == 2003
			;商人が居たところ
			CALL GETS_TREASURE,"마석",3,FLAG:현던전,1
		ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 2013
			;精霊石…の代用
			CALL GETS_TREASURE,"소마의물방울",1,FLAG:현던전,2
		ENDIF
	CASE 4
			;黄金の風
			CALL GETS_TREASURE,"암리타샤워",1,FLAG:현던전,3
	CASE 8
			;回復超純水
			CALL GETS_TREASURE,"보옥",2,FLAG:현던전,4
ENDSELECT
RETURN 0