@EVENT_DUNGEON_START_103
#DIM LCOUNT
PRINTL
DRAWLINE

CALL SET_GUEST_D103
IF ダンジョンフラグ:(FLAG:현던전):5 == 0
;攻略開始時
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "＞갱도 깊은 곳, 무너진 바위 너머에 있던 것은/온통 붉은 용암 바다, 그리고 당연하다는 듯 피어오르는/무시무시한 열기였다"
	CALL MESSAGE_WINDOW_D_ICON, [[キャラ:게오루이스_KE]], "CSV", , "게오루이스", "＞엄청난 열기와… 마족의 살기다/역시 여기가… 전설의 종말이라 불리는 장소인가"
	CALL MESSAGE_WINDOW_D_ICON, [[キャラ:데스포르카_DR]], "CSV", , "데스포르카", "＞이것이… 마왕님의…! 무시무시한 원념이다…/이건 내게도 향하고 있는 거겠지/정말이지 몸서리가 쳐지네"
	CALL MESSAGE_WINDOW_D_ICON, [[キャラ:브루_KE]], "CSV", , "브루", "＞관광명소로 삼기에는… 조금 너무 흉흉할지도 모르겠군/게다가 아이나 노인이 여기까지 오기엔 너무 벅찰 테고"
	CALL MESSAGE_WINDOW_D_ICON, [[キャラ:사미다레_KE]], "CSV", , "사미다레", "＞그때 마족의 침공에는 마왕이 없었지…/즉 이제부터 싸울 상대는 천 년 동안 힘을 비축한 마왕이라는 뜻이다/…투지가 끓어오르는군!"
	CALL MESSAGE_WINDOW_D_ICON, [[キャラ:빌로우_KE]], "CSV", , "빌로우", "＞여기서 끝내지 않으면 인류는 천 년 전으로 되돌아가는 거야/간신히 보호받은 마족들도 몰살당하고 말겠지/저기 있는 마족의 괴짜를 위해서라도 극락왕생시켜 줘야겠어!"
	CALL MESSAGE_WINDOW_D_ICON, [[キャラ:아벤트_KE]], "CSV", , "아벤트", "＞그렇다면 할 일은 하나뿐이다!/냉큼 여길 돌파해서 마왕님인지 뭔지 때려죽이자고!/우선 내가 쳐들어갈 테니까! 떨어지지 말라고!"
	CALL MESSAGE_WINDOW_D_ICON, [[キャラ:귀네_KE]], "CSV", , "귀네", "＞내 영혼은 인류를 해치는 마족과 마왕을 쓰러뜨리기 위해서야…!/그 참극을, 전쟁을 되풀이하지 않기 위해서라도…/어떻게 해서든 여기서 막겠어…!!!"
	CALL MESSAGE_WINDOW_D_ICON, [[キャラ:레스터_KE]], "CSV", , "레스터", "＞하아아… 여기까지 왔으면 돌아갈 순 없겠지/내가 할 수 있는 일은 적지만…/가능한 한 서포트할게"
	CALL MESSAGE_WINDOW_D_ICON, [[キャラ:스티아라_KE]], "CSV", , "스티아라", "＞자 가요, 루이스!/이제 그 누구에게도… 인류의 절망을 보여선 안 돼요!"
	CALL MESSAGE_WINDOW_D_ICON, [[キャラ:게오루이스_KE]], "CSV", , "게오루이스", "＞아아… 물론이다…!/데스포르카, 그리고 협력자 공… 당신들도 믿고 있습니다"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "＞게오루이스의 시선에 굳게 고개를 끄덕이고, 앞으로 나아갈 좁은 바윗길을 응시했다"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "＞마왕 토벌 파티의 편성을 실시합니다"
	CALL RECONSTRUCTION_DUNGEON_103
	CALL MESSAGE_WINDOW_D_ICON, [[キャラ:게오루이스_KE]], "CSV", , "게오루이스", "＞자, 가자!/우리가… 마왕을 토벌하는 거다!!"

ELSE
	;攻略再開
	;聖剣GET後、ゲストのグイーネには聖剣が装備される
	SIF ダンジョンフラグ:(FLAG:현던전):7 == 1 && CFLAG:GETCHARA([[キャラ:귀네_KE]]):게스트가입플래그 == 1
		EQUIP:GETCHARA([[キャラ:귀네_KE]]):검 = GETNUM(ITEM, "KE＿성검")

	CALL MESSAGE_WINDOW_D_ICON, [[キャラ:게오루이스_KE]], "CSV", , "게오루이스", "＞푹 쉬었으려나…/파티 재점검은 괜찮은가?"
	CALL RECONSTRUCTION_DUNGEON_103
	CALL MESSAGE_WINDOW_D_ICON, [[キャラ:게오루이스_KE]], "CSV", , "게오루이스", "＞좋아…/그럼 가볼까!"

ENDIF
CALL MAKE_FLOOR, FLAG:현던전

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_103,ARG,ARG:1
IF DA:(ARG):(ARG:1) == 8019
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "＞용이 보물을 지키고 있는 것 같다/싸움을 걸겠습니까?"
	CALL INPUT_YN_D
	SIF RESULT
		RETURN 0
ENDIF
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT
;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_103
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) % 10
;==========
;出口の処理
;==========
;	CASE 8
;========
;宝の処理
;========
	CASE 3
		CALL TRESURING_CALLING_103
		RETURN 1
;==========
;イベントの処理
;==========
	CASE 4
		CALL EVENTING_CALLING_103
		RETURN 1
;=======
;階段
;=======
	CASE 6
		CALL DUNGEON_UPSTAIRS_ID, (FLAG:현M+1) , (FLAG:현M+1) * 1000 + 7
		RETURN 1
	CASE 7
		CALL DUNGEON_DOWNSTAIRS_ID, (FLAG:현M-1) , (FLAG:현M-1) * 1000 + 6
		RETURN 1
;==========
;イベントの処理
;==========
	CASE 9
		CALL TILE9_EVENT_DUNGEON_103
		RETURN 1
	CASEELSE
		PRINTFORML 
		PRINTFORMW 　　　　＞아무것도 없는 것 같다 
		RETURN 0
ENDSELECT

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_103,ARG
;ARG = 進入時の向き　0の場合ワープなど
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) % 10
;==========
;出口の処理
;==========
;	CASE 8
;========
;宝の処理
;========
	CASE 3
		CALL TRESURING_CALLING_103
		RETURN 1
;==========
;イベントの処理
;==========
	CASE 4
		CALL EVENTING_CALLING_103
		RETURN 1
;=======
;階段
;=======
	CASE 6
		CALL DUNGEON_UPSTAIRS_ID, (FLAG:현M+1) , (FLAG:현M+1) * 1000 + 7
		RETURN 1
	CASE 7
		CALL DUNGEON_DOWNSTAIRS_ID, (FLAG:현M-1) , (FLAG:현M-1) * 1000 + 6
		RETURN 1
;==========
;矢印・イベントの処理
;==========
	CASE 9
		CALL TILE9_EVENT_DUNGEON_103
	RETURN 1
ENDSELECT
RETURN 0

;=======================================================================
;イベントまとめ
;=======================================================================
@EVENTING_CALLING_103
#DIM LCOUNT
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) % 10
	CASE 4
		IF DA:(FLAG:현X):(FLAG:현Y) == 1004
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:귀네_KE]], "CSV", , "귀네", "＞앗…!/저건 설마 보물 아니겠어!"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:게오루이스_KE]], "CSV", , "게오루이스", "＞…귀네의 나쁜 버릇이 시작됐군…/호기심이 많은 건 언제나 그렇지만…"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:데스포르카_DR]], "CSV", , "데스포르카", "＞…확실히 장식이 호화로운 상자로 보이긴 하지만…/이런 장소다, 내용물은 글쎄…"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:빌로우_KE]], "CSV", , "빌로우", "＞댁은 전에도 호되게 당했잖아…/또 미믹이라 해도 난 몰라?"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:귀네_KE]], "CSV", , "귀네", "＞내 보물을 향한 호기심은 멈출 수 없어!"

			ダンジョンフラグ:(FLAG:현던전):9 = 1
			ダンジョンフラグ:(FLAG:현던전):10 = 1
			CALL REPLACE_TILE_DUNGEON_103, DA:(FLAG:현X):(FLAG:현Y), FLAG:현X, FLAG:현Y
			CALL DUNGEON_WORP,1,11,5

			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:귀네_KE]], "CSV", , "귀네", "＞그 누구도 연 흔적이 없고…/이 안의 보물은 손대지 않은 그대로라는 거지!"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:데스포르카_DR]], "CSV", , "데스포르카", "＞…이봐 영웅… 이 녀석 안 말려도 되는 건가?/호기심이 앞서서 경계심이란 게 전혀 없잖아"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:게오루이스_KE]], "CSV", , "게오루이스", "＞…이렇게 된 귀네는 꼼짝도 안 해…/…뭐 무슨 일 생기면 커버해 주는 수밖에"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:귀네_KE]], "CSV", , "귀네", "＞그럼 열어버릴게~♪/뭐가 들어있을지 두근두근하네~♪"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "＞딸깍"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "＞놀랍게도 보물상자는 미믹이었다!"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:귀네_KE]], "CSV", , "귀네", "＞…어머?"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:빌로우_KE]], "CSV", , "빌로우", "＞또 전이랑 똑같은 함정에 걸렸구만…/허리까지 삼켜져 버리고 참…"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:아벤트_KE]], "CSV", , "아벤트", "＞또 미믹인가…/귀네 아가씨는 머리가 좋은 건지 나쁜 건지 모르겠단 말이지…"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:데스포르카_DR]], "CSV", , "데스포르카", "＞음, 뒤에서 적이 오고 있다!/거기 못 움직이는 보물 바보는 일단 내버려 둬!"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:귀네_KE]], "CSV", , "귀네", "＞보, 보물 바보라니…"

			FLAG:도주불가플래그 = 1
			FLAG:선제기습취소 = 1

			;一旦グイーネをパーティから外す
			FOR LOCAL, 1, 7
				LOCALS = 포지션{LOCAL} 
				IF POS(LOCAL) == GETCHARA([[キャラ:귀네_KE]])
					;ポジションから外す
					CALL REMOVE_POSITION(LOCAL)
					;グイーネがパーティに居たら外したフラグ
					LOCAL:1 = 1
				ENDIF
			NEXT

			CALL TRESURE_ENEMY_SET_103
			CALL BATTLE_START

			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:데스포르카_DR]], "CSV", , "데스포르카", "＞아직 더 온다!"

			CALL TRESURE_ENEMY_SET_103
			CALL BATTLE_START

			FLAG:도주불가플래그 = 0
			FLAG:선제기습취소 = 0

			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "＞적을 격퇴한 후, 귀네를 미믹에게서 구출해냈다"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:귀네_KE]], "CSV", , "귀네", "＞미안해, 폐를 끼쳐버렸네…"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:브루_KE]], "CSV", , "브루", "＞그래서 보물인지 뭔지는 어땠어"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:귀네_KE]], "CSV", , "귀네", "＞보물…은…"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:데스포르카_DR]], "CSV", , "데스포르카", "＞이건… 10일(IL), 이군…/푼돈이다"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:귀네_KE]], "CSV", , "귀네", "＞으으…, 내 두근거림을 돌려줘…!"

			;元々パーティに居たグイーネを空きポジションへ戻す
			IF LOCAL:1 > 0
				FOR LOCAL, 1, 7
					LOCALS = 포지션{LOCAL} 
					IF FLAG:LOCALS < 0
						CALL INSERT_POSITION, LOCAL, GETCHARA([[キャラ:귀네_KE]])
						LOCAL:1 = 0
						BREAK
					ENDIF
				NEXT				
			ENDIF

			IF LOCAL:1 > 0
				FOR LOCAL, 1, 7
					LOCALS = 포지션{LOCAL} 
					; 人間でもMASTERでもなければ外してそこに入れる
					IF GET_ROLE_PROP("CAN_PUT_IN_COMP", POS(LOCAL))
						;ポジションから外す
						CALL REMOVE_POSITION(LOCAL)
						CALL INSERT_POSITION, LOCAL, GETCHARA([[キャラ:귀네_KE]])
						BREAK
					ENDIF
				NEXT				
			ENDIF

			ダンジョンフラグ:(FLAG:현던전):0 = 1
			ダンジョンフラグ:(FLAG:현던전):9 = 2
			ダンジョンフラグ:(FLAG:현던전):10 = 2
			CALL REPLACE_TILE_DUNGEON_103, DA:(FLAG:현X + 1):(FLAG:현Y), FLAG:현X + 1, FLAG:현Y

		ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 1014 && ダンジョンフラグ:(FLAG:현던전):9 == 2
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:사미다레_KE]], "CSV", , "사미다레", "＞어랏?/구멍 속에 뭔가 있다구!"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "＞몬스터가 나온 구멍에서, 진기의 갑옷을 손에 넣었다!"

			;なんかいい感じの強めの鎧ないかな…
			ITEM:신기의갑옷 += 1

			ダンジョンフラグ:(FLAG:현던전):9 = 3
			
		ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 1024 && ダンジョンフラグ:(FLAG:현던전):10 == 2
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:레스터_KE]], "CSV", , "레스터", "＞…응?/구멍 안에 아이템이 있어…?"
			
			
			LOCAL = GETNUM(ITEM, "소마")
			CALL CHECK_ITEMMAX,LOCAL
			IF RESULT == 0
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "＞몬스터가 나온 구멍에서, 소마를 손에 넣었다!"
				CALL GET_ITEM,LOCAL,1
			ELSE
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "＞소마를 발견했지만 더 이상 지닐 수 없었다"
			ENDIF

			ダンジョンフラグ:(FLAG:현던전):10 = 3

		ELSEIF FLAG:현M == 8 && ダンジョンフラグ:(FLAG:현던전):6 == 0
			;トレジャーハンターグイーネ
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:귀네_KE]], "CSV", , "귀네", "＞꺄아아아아아앗!!!"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:데스포르카_DR]], "CSV", , "데스포르카", "＞우왓!?"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:게오루이스_KE]], "CSV", , "게오루이스", "＞왜, 왜 그래 귀네?"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:귀네_KE]], "CSV", , "귀네", "＞비, 비싸 보이는 검이 꽂혀있어어어!/저건 상당한 보물로 보여!/빨리 가지러 가자!!"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:빌로우_KE]], "CSV", , "빌로우", "＞거대한 용이 가로막고 있는데/안중에도 없는 모양이구만"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:아벤트_KE]], "CSV", , "아벤트", "＞이거 마그마 속에 보물이라도 발견하면 맨발로라도 가지러 갈 기세인데?"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:데스포르카_DR]], "CSV", , "데스포르카", "＞보물에 사족을 못 쓴다는 건가…/그럴싸하게 꾸며놓으면 쉽게 함정에 걸리겠군…"
			CALL MESSAGE_WINDOW_D_ICON, [[キャラ:게오루이스_KE]], "CSV", , "게오루이스", "＞이렇게 되면 귀네는 안 멈추니까…/혼자 돌격하기 전에 다 같이 용을 쓰러뜨리자…"
			
			ダンジョンフラグ:(FLAG:현던전):6 = 1
			CALL REPLACE_TILE_DUNGEON_103, DA:(FLAG:현X):(FLAG:현Y), FLAG:현X, FLAG:현Y
		ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 12004
			FLAG:도주불가플래그 = 1
			FLAG:선제기습취소 = 1
			CALL SET_ENEMY,9,[[キャラ:마왕_KingExit]],90,0,1

			CFLAG:(CHARANUM-1):행동횟수 = 2
			;ゲストキャラの技構成上、かなり高頻度でCOOPが発生するのでHP盛らないとすぐ死んじゃう
			CFLAG:(CHARANUM-1):ＨＰ보정 +=20000
			CFLAG:(CHARANUM-1):ＭＰ보정 +=10000

			CSTR:(CHARANUM-1):사고패턴 = 7508

			CFLAG:(CHARANUM-1):불사신플래그 = 1

			CALL SYNC_STATUS, (CHARANUM-1)
			CALL HEALTH_CHARA, (CHARANUM-1)

			CALL BATTLE_START

			FLAG:도주불가플래그 = 0
			FLAG:선제기습취소 = 0
			
