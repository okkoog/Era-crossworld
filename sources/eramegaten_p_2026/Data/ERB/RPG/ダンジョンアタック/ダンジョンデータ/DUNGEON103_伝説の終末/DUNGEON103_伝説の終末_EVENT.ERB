;=======================================================================
;KingExit組ゲスト加入処理
;=======================================================================
@ADD_STARTING_LINEUP_GUEST_DUNGEON_103(ARG)
#LOCALSIZE 4
LOCAL:1 = -1
LOCAL:2 = -1
FOR LOCAL, 1, 7
	LOCALS = 포지션{LOCAL} 
	IF FLAG:LOCALS < 0
		LOCAL:1 = LOCAL
		BREAK
	ENDIF
NEXT
;人間は@とデスポリュカ以外居ないハズ
IF LOCAL:1 == -1
	FOR LOCAL, 1, 7
		LOCALS = 포지션{LOCAL} 
		IF (ABL:(FLAG:LOCALS):종족) && (FLAG:LOCALS) != MASTER
			LOCAL:1 = LOCAL
			;LOCAL:2にどかすキャラを入れる
			LOCAL:2 = POS(LOCAL)
			;ポジションから外す
			CALL REMOVE_POSITION(LOCAL)
			BREAK
		ENDIF
	NEXT
ENDIF
IF LOCAL:1 >= 0
	;キャラを加入させる
	CALL ADD_GUEST_DUNGEON_103, ARG
	IF RESULT == -1
		CALL INSERT_POSITION, LOCAL:1, GETCHARA(ARG)
		LOCAL:2 = 0
	ELSE
		CALL INSERT_POSITION, LOCAL:1, RESULT
		LOCAL:2 = 1
	ENDIF
	;いれたポジションをかえす
	RETURN LOCAL:1, LOCAL:2
ENDIF
RETURN 0, -1

;=======================================================================
;KingExit組控えゲスト加入処理
;=======================================================================
@ADD_GUEST_DUNGEON_103(ARG)
;キャラを加入させる
IF GETCHARA(ARG) >= 0
	LOCAL = -1
ELSE
	CALL ADD_NEW_COMPANION, ARG , 0
	CFLAG:(RESULT:1):게스트가입플래그 = 1
	CALL SET_TALENT_PARTY_JOINABLE, (RESULT:1), "신용"
	;これは本来KingExitの物語 @が居なくても戦闘は続行される
	;ので、信頼陥落させて@が死んでもセーフにする
	TALENT:(RESULT:1):신뢰 = 1

	LOCAL = RESULT:1
ENDIF
RETURN LOCAL

