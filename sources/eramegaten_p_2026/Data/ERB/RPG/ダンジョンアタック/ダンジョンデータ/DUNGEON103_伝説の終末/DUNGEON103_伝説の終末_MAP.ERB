;KingExit世界のダンジョン
;世界のどこかにある、重要人物ばかりを収容していた監獄の奥にある溶岩地帯
;尋常ではない熱気と殺気に満ちており、魔王の存在を確信させる場所
;
;ダンジョンフラグ:0～4　宝箱
;ダンジョンフラグ:5　　 出口場所記憶
;ダンジョンフラグ:6 	お宝発見
;ダンジョンフラグ:7		お宝取得
;ダンジョンフラグ:8		竜討伐
;ダンジョンフラグ:9		鎧穴
;ダンジョンフラグ:10	タマネギ穴
;ダンジョンフラグ:11	戦闘中デスソース使用フラグ
;ダンジョンフラグ:12	魔王様発狂段階
;ダンジョンフラグ:13	魔王様討伐完了
;
;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_103
; クリア済みはNG
SIF ダンジョンフラグ:103:13
	RETURN 0

;KingExitイベントを進めていないとNG
SIF イベントフラグ:111:0 != 2
	RETURN 0

;デスポリュカと＠のみがパーティにいる事が条件
FOR LOCAL, 1, 7
	;空きポジションは勘定外
	SIF POS(LOCAL) < 0
		CONTINUE
	;主人は勘定外
	SIF POS(LOCAL) == MASTER
		CONTINUE
	;デスポリュカ・KE組以外がパーティにいるとNG
	IF !(GROUPMATCH(NO:POS(LOCAL), [[キャラ:데스포르카_DR]], [[キャラ:아벤트_KE]], [[キャラ:빌로우_KE]], [[キャラ:브루_KE]], [[キャラ:레스터_KE]], [[キャラ:사미다레_KE]], [[キャラ:스티아라_KE]], [[キャラ:귀네_KE]], [[キャラ:게오루이스_KE]]))
		RESULTS = 데스포르카(DR), 혹은 KingExit의 캐릭터만 편성
		RETURN -1
	ENDIF
NEXT

RETURN 1

