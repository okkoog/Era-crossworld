@TILE_MARK_COMMON_103_4, ARG , ARG:1 , ARG:2
IF FLAG:현M == 1 && ARG % 10 == 4
	SELECTCASE ARG 
		CASE 1014
			IF ダンジョンフラグ:(FLAG:현던전):9 != 2
				RESULTS = □
				RETURN 0
			ENDIF
		CASE 1024
			IF ダンジョンフラグ:(FLAG:현던전):10 != 2
				RESULTS = □
				RETURN 0
			ENDIF
	ENDSELECT
ENDIF
RETURN 1

;=======================================================================
;タイル調整
;=======================================================================
;ARG:1、ARG:2はそれぞれX座標とY座標
;ARGはその座標に現在代入されている番号
;0：壁　1：床もしくは通路　2：扉　3：宝箱　4：イベント　5：罠　6：上り階段 7：下り階段　8：出口　9：その他特殊処理等
;これらの内、3～9が代入されているマスに、個別の番号を与える処理を実行します。
;この処理を行った後、これらのマスには 「マップ番号*1000 + そのマスがそのマップで左上から数えて何個目のARGタイプのマスか*10 + ARG」が代入されます
;例えば 2003 であった場合、「2番のマップ＝３Ｆで、左上から数えて0個目の3＝宝箱である」ということを意味しています
;尚、0～2はどのマップにも大量に設置されるので、ここでは基本的に個別の番号を与えません。
;
;何個目のARGタイプのマスなのか、は左上の(0,0)から右まで探し、その後一つ下の段に移って同様に探す、というのを右下まで繰り返して数えます。
@MAKE_FLOOR_LINE_COMMON_103, ARG, ARG:1, ARG:2
#LOCALSIZE 10
;LOCAL:0～9 それぞれ何個目のARGなのかを記憶しています
;指定された座標が(0,0)である場合、つまり新しいマップを読み込んだ時はLOCALを消去します
SIF ARG:1 == 0 && ARG:2 == 0
	VARSET LOCAL
SELECTCASE ARG
	CASE 3 TO 9
		DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:ARG * 10 + ARG
		LOCAL:ARG++
	CASE IS > 9
		DA:(ARG:1):(ARG:2) = ARG
ENDSELECT
CALL REPLACE_TILE_DUNGEON_103, DA:(ARG:1):(ARG:2), ARG:1, ARG:2

;=======================================================================
;タイル破棄
;イベントが終わった床・扉を通常マスに置き換える
;=======================================================================
@REPLACE_TILE_DUNGEON_103, ARG, ARG:1, ARG:2
SELECTCASE ARG
	CASE 1003
		SIF ダンジョンフラグ:(FLAG:현던전):0 == 1
			DA:(ARG:1):(ARG:2) = 1
	CASE 1004
		SIF ダンジョンフラグ:(FLAG:현던전):9 > 0 || ダンジョンフラグ:(FLAG:현던전):10 > 0
			DA:(ARG:1):(ARG:2) = 1
	CASE 2003
		SIF ダンジョンフラグ:(FLAG:현던전):1 == 1
			DA:(ARG:1):(ARG:2) = 1
	CASE 2013
		SIF ダンジョンフラグ:(FLAG:현던전):2 == 1
			DA:(ARG:1):(ARG:2) = 1
	CASE 4003
		SIF ダンジョンフラグ:(FLAG:현던전):3 == 1
			DA:(ARG:1):(ARG:2) = 1
	CASE 8003
		SIF ダンジョンフラグ:(FLAG:현던전):4 == 1
			DA:(ARG:1):(ARG:2) = 1
	CASE 8004
		SIF ダンジョンフラグ:(FLAG:현던전):6 == 1
			DA:(ARG:1):(ARG:2) = 1
	CASE 8009
		SIF ダンジョンフラグ:(FLAG:현던전):7 == 1
			DA:(ARG:1):(ARG:2) = 1
	CASE 8019
		SIF ダンジョンフラグ:(FLAG:현던전):8 == 1
			DA:(ARG:1):(ARG:2) = 1
ENDSELECT
