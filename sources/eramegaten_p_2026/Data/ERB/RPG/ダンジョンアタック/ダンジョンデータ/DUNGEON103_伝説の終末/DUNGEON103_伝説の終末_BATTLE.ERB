		PRINTFORML
		PRINTFORML ┏>마왕 ━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃엎드려라… 노예 놈들…!！！　　　　　　　　　┃
		PRINTFORML ┃사라져라… 낡고 나약한 나의 구적…!！！　　　┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━┛
		PRINTFORMW
		RESETCOLOR

		;デスソース使用フラグクリア
		ダンジョンフラグ:(FLAG:현던전):11 = 0
		ダンジョンフラグ:(FLAG:현던전):12 = 1
	ENDIF

	;魔王3段階へ　スキル系譜鳴動追加　スキル千年の呪怨追加（なんてぴったりな名前のスキルなんだ…！）
	IF NO:(CHARANUM-1) == [[キャラ:마왕_KingExit]] && ダンジョンフラグ:(FLAG:현던전):12 == 1 && 現HP割合(CHARANUM-1) < 50
		SETCOLOR COLOR("ENEMY")
		PRINTFORML
		PRINTFORMW 빠각, 하고 소리를 내며 마왕의 사지 봉인 중 하나가 산산조각났다!
		PRINTFORML
		PRINTFORML ┏>마왕 ━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃엎드려라… 무릎 꿇어라… 노예의 자손…!！！　　　　　┃
		PRINTFORML ┃사라져라… 죽어서 사죄해라… 옛 마족의 잔재…!！！　　┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		PRINTFORMW
		RESETCOLOR

		;デスソース使用フラグクリア
		ダンジョンフラグ:(FLAG:현던전):11 = 0
		ダンジョンフラグ:(FLAG:현던전):12 = 2
	ENDIF

	;魔王4段階へ　スキル螻蟻潰堤追加
	IF NO:(CHARANUM-1) == [[キャラ:마왕_KingExit]] && ダンジョンフラグ:(FLAG:현던전):12 == 2 && 現HP割合(CHARANUM-1) < 25
		SETCOLOR COLOR("ENEMY")
		PRINTFORML
		PRINTFORMW 빠각, 하고 소리를 내며 마왕의 사지 봉인 중 하나가 산산조각났다!
		PRINTFORML
		PRINTFORML ┏>마왕 ━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃크오오오옷！　　　　　　　　　　　　　　　　　　　　┃
		PRINTFORML ┃엎드려라… 엎드려엇！　　　　　　　　　　　　　　　┃
		PRINTFORML ┃죽어서, 엎드려라아아아앗！！！　　　　　　　　　　┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		PRINTFORMW
		RESETCOLOR

		;デスソース使用フラグクリア
		ダンジョンフラグ:(FLAG:현던전):11 = 0
		ダンジョンフラグ:(FLAG:현던전):12 = 3
	ENDIF
ENDIF

;====================
;守竜思考パターン
;====================
@SET_ACTION_7507, ARG
#DIM CHARA

;入力行動を-1とターゲ!トを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

SELECTCASE RAND:100
	CASE IS < 20
		;20%で人間砕き
		CFLAG:ARG:입력행동 = [[스킬:전용기1]]
	CASE IS < 40
		;20％で死滅光線
		CFLAG:ARG:입력행동 = [[스킬:전용기2]]
	CASE IS < 60
		;20％で連続切裂き
		CFLAG:ARG:입력행동 = [[스킬:전용기3]]
	CASE IS < 80
		;20％でバインドボイス
		CFLAG:ARG:입력행동 = [[스킬:바인드보이스]]
	CASEELSE
		;20％でメガクロー
		CFLAG:ARG:입력행동 = [[스킬:메가클로]]
ENDSELECT

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲ!トが決まってなかったら、ランダムターゲ!トをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동

;50%の確率で2回行動
IF RAND:2
	CFLAG:ARG:행동횟수 = 2
ELSE
	CFLAG:ARG:행동횟수 = 1
ENDIF
RETURN 1


;====================
