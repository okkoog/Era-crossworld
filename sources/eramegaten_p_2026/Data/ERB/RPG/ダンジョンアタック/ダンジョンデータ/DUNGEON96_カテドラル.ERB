;=======================================================================
;指定したマスに進入可能か（経路探索）
;=======================================================================
@JUDGE_CAN_ENTER_96, L_X, L_Y, L_DIRECTION, L_ROUTENUM = -1, DUNGEON_TILE_SEARCH_TASK
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC L_DIRECTION
#DIM DYNAMIC L_ROUTENUM
#DIM REF DUNGEON_TILE_SEARCH_TASK
SELECTCASE DA:L_X:L_Y
	;ミ
	CASE 39
		RETURN 0
	;落とし穴
	CASE 15
		;直クリックは判定を通す
		RETURN GOLE_X == L_X && GOLE_Y == L_Y
	;↑↓→←
	CASE 22, 32, 42, 52
		;直クリックは始動のために判定を通す
		SIF GOLE_X == L_X && GOLE_Y == L_Y
			RETURN 1
		SELECTCASE DA:L_X:L_Y
			CASE 22
				RETURN L_DIRECTION == 2
			CASE 32
				RETURN L_DIRECTION == 8
			CASE 42
				RETURN L_DIRECTION == 6
			CASE 52
				RETURN L_DIRECTION == 4
		ENDSELECT
	;ロ
	CASE 102
		SIF ダンジョンフラグ:96:31 < 2
			RETURN 0
	;カ
	CASE 112
		SIF ダンジョンフラグ:96:32 < 2
			RETURN 0
ENDSELECT
CALL CAN_ENTER,L_X,L_Y
RETURN RESULT

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_96,ARG,ARG:1
;ARG、ARG:1はそれぞれ対象のマスのX、Y座標を表しています。
;このダンジョンではエレベーターの扉が一度右側から開けておかないと左側からは開けられない、という処理に使用しています。
;どのマップでも座標(2,7)がエレベータの扉。ダンジョンフラグ:(FLAG:현던전):13 ＝ エレベータフラグ管理用変数の{現在のマップ番号}番目のビットが立っていなければ開けられるかどうかの判定を行う

SELECTCASE DA:ARG:(ARG:1)
	;ミ
	CASE 39
		RETURN 0
	;遂行不能扉
	CASE 12
		CALL MESSAGE_WINDOW_D, "", "/＞문은 신비로운 힘으로 닫혀 있다" , , , , , , , , , "CENTER"
		RETURN 0
	;↑
	CASE 22
		RETURN ARG:1 < FLAG:현Y
	;↓
	CASE 32
		RETURN ARG:1 > FLAG:현Y
	;→
	CASE 42
		RETURN ARG > FLAG:현X
	;←
	CASE 52
		RETURN ARG < FLAG:현X
	;ロ
	CASE 102
		SIF ダンジョンフラグ:96:31 < 2
			RETURN 0
	;カ
	CASE 112
		SIF ダンジョンフラグ:96:32 < 2
			RETURN 0
	CASE 202
		SELECTCASE FLAG:현M
			CASE 1
				IF ダンジョンフラグ:96:10 == 1
					;エンゼルリングで開く
					CALL MESSAGE_WINDOW_D, "", "엔젤링이 빛나기 시작했다"
					CALL INPUT_SELECT_D, "[0] 반지를 비춘다/[1] 떠난다"
					SIF RESULT
						RETURN 0
					CALL MESSAGE_WINDOW_D, "", "엔젤링의 빛을 받고 문이 열렸다"
					RETURN 1
				ELSE
					CALL MESSAGE_WINDOW_D, "", "문 너머에서 무서운 기운이 느껴진다…"
					CALL INPUT_SELECT_D, "[0] 문을 연다/[1] 열지 않는다 "
					RETURN !RESULT
				ENDIF
			CASE 14
				IF ダンジョンフラグ:96:10 == 1
					;ロウ限定イベント
					CALL MESSAGE_WINDOW_D, @"%SAVESTR:로우히어로CALLNAME%의 목소리", "자　문을 열고/안으로 들어가 주십시오"
					ダンジョンフラグ:96:19 = 1
					CALL MAKE_FLOOR, FLAG:현던전
					RETURN 1
				ELSE
					IF ダンジョンフラグ:96:10 == 2
						;カオス限定イベント
						CALL MESSAGE_WINDOW_D, SAVESTR:카오스히어로CALLNAME, "젠장　문이 열리지 않아!/어쩌란 거야・・・/나한테는 열 힘이 없단 말인가!"
						CALL MESSAGE_WINDOW_D, SAVESTR:카오스히어로CALLNAME, @"%CALLNAME:MASTER%도 여기까지 온 건가/보는 바와 같이 곤란하던 참이다"
						CALL MESSAGE_WINDOW_D, SAVESTR:카오스히어로CALLNAME, "이 문이 열리기만 하면/미카엘이 있는 곳으로 갈 수 있는데・・・"
						CALL INPUT_SELECT_D, "[0] 데빌링을 꺼낸다/[1] 떠난다"
						RETURN !RESULT
					ELSE
