					BASE:(CHARANUM-1):내구 += LOCAL:1
					BASE:(CHARANUM-1):속도 += LOCAL:1
					BASE:(CHARANUM-1):운 += LOCAL:1
					CALL SYNC_STATUS,(CHARANUM-1)
					CALL HEALTH_CHARA,(CHARANUM-1)
					
					;神経弾（全体に麻痺効果の飛具）やストラディバリ（全体に高威力の剣撃）などをスキル変化で実装しようと思ったが、難易度を考えて保留
