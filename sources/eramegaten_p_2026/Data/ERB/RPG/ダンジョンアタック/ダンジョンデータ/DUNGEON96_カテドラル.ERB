				ENDIF

			;よわよわフツオ
			ELSEIF RESULT == 1
				CALL MESSAGE_WINDOW_D, ""		, "＞이런 곳에 있는 이상, 온전한 인간은 아니다/일단 죽여둬야 할까……？"
