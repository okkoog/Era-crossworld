		SIF MAXBASE:POS(LOCAL):파마 < 100 && MAXBASE:POS(LOCAL):파마 != 999 && !CFLAG:POS(LOCAL):파마가드킬 && LOCAL:1 == 0
			LOCAL:1 = LOCAL
		SIF CFLAG:POS(LOCAL):파마무효화횟수 && CFLAG:POS(LOCAL):수호의방패
			LOCAL:2 = 1
		SIF CFLAG:POS(LOCAL):마법반사플래그
			LOCAL:3 = 1
	NEXT
	$ブレイク
	IF LOCAL:1 > 0
		IF CFLAG:ARG:800 == 2
			CFLAG:ARG:입력행동 = [[스킬:파마가드브레이크]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:파마가드킬]]
			CFLAG:ARG:타겟 = LOCAL:1
			RETURN
		ENDIF
	ELSEIF LOCAL:2 == 1
		CFLAG:ARG:입력행동 = 574
	ELSEIF LOCAL:3 == 1
		CFLAG:ARG:입력행동 = 568
	ELSEIF CFLAG:ARG:행동한횟수 == 0 && !CFLAG:ARG:１more플래그
		IF RAND:2
			CFLAG:ARG:입력행동 = [[스킬:실드브레이크]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:마카라브레이크]]
		ENDIF
	ELSE
		RESTART
	ENDIF
CASE 13
	CFLAG:ARG:검격여데미지보정 = 0
	CFLAG:ARG:파마여데미지보정 = 0
	CFLAG:ARG:입력행동 = [[스킬:천군의검]]
	CALL RANDOM_TARGET,ARG,CFLAG:ARG:입력행동
	SIF CFLAG:ARG:타겟 < 1 || POS(CFLAG:ARG:타겟) < 0
		RESTART
	LOCAL = CFLAG:ARG:타겟
	;LOCAL　타겟
	;LOCAL:1ターゲット剣撃耐性
	;LOCAL:2ターゲット破魔耐性
	LOCAL:1 = MAXBASE:POS(LOCAL):검격
	SIF LOCAL:1 == 999
		LOCAL:1 = 0
	LOCAL:1 = CFLAG:POS(LOCAL):검격무효화횟수 ? 0 # LOCAL:1
	LOCAL:1 = CFLAG:POS(LOCAL):수호의방패 ? 0 # LOCAL:1
	LOCAL:1 = CFLAG:POS(LOCAL):물리반사플래그 ? 0 # LOCAL:1
	SIF LOCAL:1 < 0
		LOCAL:1 /= 3

	LOCAL:2 = MAXBASE:POS(LOCAL):파마
	SIF LOCAL:2 == 999
		LOCAL:2 = 0
	LOCAL:2 = CFLAG:POS(LOCAL):파마가드킬 ? 100 # LOCAL:2
	LOCAL:2 = CFLAG:POS(LOCAL):파마무효화횟수 ? 0 # LOCAL:2
	LOCAL:2 = CFLAG:POS(LOCAL):수호의방패 ? 0 # LOCAL:2
	LOCAL:2 = CFLAG:POS(LOCAL):마법반사플래그 ? 0 # LOCAL:2
	SIF LOCAL:2 < 0
		LOCAL:2 /= 3
	SIF LOCAL:1 + LOCAL:2 < 80
		RESTART
	SIF LOCAL:1 > 0
		CFLAG:ARG:검격여데미지보정 = 200
	SIF LOCAL:2 > 0
		CFLAG:ARG:파마여데미지보정 = 200
	RETURN
CASEELSE
	RESTART
ENDSELECT
