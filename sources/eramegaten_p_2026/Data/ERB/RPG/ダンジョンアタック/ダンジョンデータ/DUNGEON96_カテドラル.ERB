@SET_ACTION_カテマーラ様2,ARG
;=======================================================================
;精神神経破魔呪殺埋めてなかったらKOROSU
;=======================================================================
#DIM たぎってきた判定

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

	;メッセージが出るだけです
	IF たぎってきた判定 == 0
		たぎってきた判定 += 1
		PRINTFORML ┏> 마라님　━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃으음　끓어오르는구나！　　　　　　　　　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━┛
		PRINTFORML ┏> MESSAGE ━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃마라님이 발기탱천한다！　　　　　　　　　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF

	IF CFLAG:ARG:１more플래그 > 0
		CFLAG:ARG:입력행동 = [[스킬:마라라기다인]]
	ELSEIF CFLAG:ARG:행동한횟수 == 0
		CFLAG:ARG:입력행동 = [[스킬:마라라기다인]]
	ELSE
		CALL ランダム行動, ARG
	ENDIF

	;アクション実行不能
	CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
	SIF RESULT == 0
		CFLAG:ARG:입력행동 = 0
	;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
	SIF CFLAG:ARG:타겟 == -1
		CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
	RETURN 1


