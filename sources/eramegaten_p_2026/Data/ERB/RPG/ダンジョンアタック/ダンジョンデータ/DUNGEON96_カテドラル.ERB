		SIF CFLAG:POS(LOCAL):마법효과강화 > 16
			デ・カジャ判定 += 1
		SIF CFLAG:POS(LOCAL):회피강화 > 16
			デ・カジャ判定 += 1
		SIF CFLAG:POS(LOCAL):명중강화 > 16
			デ・カジャ判定 += 1
	NEXT

	;+5以上のカジャが6か所あったらデ・カジャを撃つ
	IF デ・カジャ判定 > 5
		CFLAG:ARG:입력행동 = [[스킬:데・카쟈]]
	;デクンダ判定
	;これは単純に、自分にマイナス２段階のンダが入ってたらデクンダ
	;ELSEIF CFLAG:ARG:공격강화 < -4 || CFLAG:ARG:방어강화 < -4 || CFLAG:ARG:마법위력강화 < -4 || CFLAG:ARG:명중강화 < -4 || CFLAG:ARG:회피강화 < -4
	ELSEIF GET_カジャンダ_MIN(ARG) < -8
		CFLAG:ARG:입력행동 = [[스킬:데・쿤다]]
	ELSE
		CALL ランダム行動, ARG
	ENDIF

	;アクション実行不能
	CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
	SIF RESULT == 0
		CFLAG:ARG:입력행동 = 0
	;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
	SIF CFLAG:ARG:타겟 == -1
		CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
	RETURN 1



