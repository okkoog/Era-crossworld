	ENDIF
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 7
	IF DA:(FLAG:현X):(FLAG:현Y) / 10 == 700 && ダンジョンフラグ:96:10 == 1
		IF  ダンジョンフラグ:96:20 == 2
			CALL DOWNSTAIRS_96
			RETURN RESULT
		ELSE
			CALL MESSAGE_WINDOW_D, "", "아수라왕을 쓰러뜨리려면 미카엘을 만나、/엔젤링을 손에 넣을 필요가 있다…/먼저 최상층으로 향하자"
			RETURN 1
		ENDIF
	ELSE
		CALL DOWNSTAIRS_96
		RETURN RESULT
	ENDIF
;========
