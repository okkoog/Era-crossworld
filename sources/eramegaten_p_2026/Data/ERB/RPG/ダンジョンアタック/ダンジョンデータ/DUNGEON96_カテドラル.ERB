		IF FLAG:현Y % 2 == 0
			FALLY = FLAG:현Y - 1
		ELSE
			FALLY = FLAG:현Y
		ENDIF
		CALL DUNGEON_WORP_96, FLAG:현M-1, FALLX,  FALLY
	;HPダメージ(H)
	CASE 2
		CALL DUNGEON_TRAP_HP, 10 + RAND:11
	;HPダメージ(L,N)
	CASE 3
		SIF FLAG:리프트마
			RETURN 1
		LOCAL:1 = 0
		FOR LOCAL,1,7
			IF POS(LOCAL) > -1 && GET_STATE(CFLAG:(POS(LOCAL)):상태이상) != "DYING" && ABL:POS(LOCAL):속성LC != 3
				PRINTFORML %CALLNAME:POS(LOCAL)%은(는) 대미지를 입었다
				CALL VAR_HP,POS(LOCAL),-MAXBASE:(POS(LOCAL)):ＨＰ*10/100
				LOCAL:1 = 1
			ENDIF
		NEXT
		SIF LOCAL:1
			WAIT
	;HPダメージ(C,N)
	CASE 4
		SIF FLAG:리프트마
			RETURN 1
		LOCAL:1 = 0
		FOR LOCAL,1,7
			IF POS(LOCAL) > -1 && GET_STATE(CFLAG:(POS(LOCAL)):상태이상) != "DYING" && ABL:POS(LOCAL):속성LC != 1
				PRINTFORML %CALLNAME:POS(LOCAL)%은(는) 대미지를 입었다
				CALL VAR_HP,POS(LOCAL),-MAXBASE:(POS(LOCAL)):ＨＰ*10/100
			ENDIF
		NEXT
		SIF LOCAL:1
			WAIT
	;毒罠
	CASEELSE
		CALL DUNGEON_TRAP_POISON, 40
ENDSELECT
RETURN 1


