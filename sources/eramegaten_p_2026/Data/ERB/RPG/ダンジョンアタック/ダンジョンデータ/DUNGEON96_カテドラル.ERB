;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_96
SELECTCASE FLAG:현M
	CASE 8
		IF ダンジョンフラグ:(FLAG:현던전):20 < 3 && ((FLAG:현X > 16 && FLAG:현X < 32 && FLAG:현Y > 40) || (FLAG:현X == 23 && FLAG:현Y > 36))
			;ミカエル未討伐時、カテドラルロウの街のみエンカなし
			FLAG:미조우걸음수 = 0
			FLAG:인카운트율 = 0
		ELSE
			FLAG:인카운트율 = MAX(FLAG:미조우걸음수 * 5 - 35, 0)
		ENDIF
	CASE 16
		FLAG:인카운트율 = MAX(FLAG:미조우걸음수 - 10, 0)
	CASEELSE
		FLAG:인카운트율 = MAX(FLAG:미조우걸음수 * 5 - 35, 0)
ENDSELECT
