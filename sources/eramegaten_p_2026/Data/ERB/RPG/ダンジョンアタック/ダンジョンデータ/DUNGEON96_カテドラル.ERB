@SET_ACTION_カテラクシュミ2,ARG
;=======================================================================
;バフ、メディアラハン担当
;組成は迷ったけど入れない
;=======================================================================
#DIM メディアラハン回数判定
#DIM ラハる判定
#DIM 外法のいざない判定
#DIM 生存人数

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1


	外法のいざない判定 = 0
	生存人数 = 0
	;外法のいざないを使用するかどうかのチェック
	FOR LOCAL, 7, 17
		;いなかったら戻る
		SIF POS(LOCAL) < 0
			CONTINUE
		;DYINGも無視
		SIF CFLAG:POS(LOCAL):상태이상 == GET_STATE_NUM("DYING")
			CONTINUE
		生存人数 += 1

		;強化段階がマイナスになっている能力をカウント
		FOR LOCAL:1, 0, 6
			SIF CFLAG:POS(LOCAL):(GET_BATTLESTATUS(LOCAL:1) + "강화") < 0
				外法のいざない判定 += 1
		NEXT
	NEXT

	;メディアラハン使用判定がゼロなら初期化（最初は５ターン目に使用）
	SIF ラハる判定 == 0
		ラハる判定 = 5

	;経過ターンが、
	IF FLAG:경과턴수 > ラハる判定
		;次回のメディアラハン使用ターンを予約
		;現在ターン＋（使用回数×４＋５）
		;１回目は５ターン目経過後
		;２回目は５＋４＋５＝14ターン目
		;３回目は14＋８＋５＝27ターン目
		メディアラハン回数判定 += 1
		ラハる判定 = FLAG:경과턴수 + (メディアラハン回数判定 * 4) + 5

		CFLAG:ARG:입력행동 = [[스킬:메・디아라한]]

		;段々疲れていく
		IF メディアラハン回数判定 == 0
			PRINTFORML ┏> 락슈미　━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃갑니다　메・디아라한！　　　　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━┛
		ELSEIF メディアラハン回数判定 == 1
			PRINTFORML ┏> 락슈미　━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃큭, 아직 쓰러지지 않는 건가요……！　　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━┛
		ELSE
			PRINTFORML ┏> 락슈미　━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃메, 메・디아라한……！　　　　　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━┛
		ENDIF

	;外法のいざない判定
	;マイナスになってる能力/生存人数が３以上（マイナスが多めだったら）マイナス能力を逆転させてくる
	ELSEIF (外法のいざない判定 / 生存人数) > 3
		CFLAG:ARG:입력행동 = [[스킬:외법의유혹]]
	ELSE
		CALL ランダム行動, ARG
	ENDIF


	;アクション実行不能
	CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
	SIF RESULT == 0
		CFLAG:ARG:입력행동 = 0
	;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
	SIF CFLAG:ARG:타겟 == -1
		CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
	RETURN 1



