;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_96
#LOCALSIZE 1
;50日でザ・ヒーローによるカテドラル争奪戦の終結イベント発生
IF DAY > 50
	FOR LOCAL,11,21
		ダンジョンフラグ:96:LOCAL = 3
	NEXT
	ダンジョンフラグ:96:31 = 3
	ダンジョンフラグ:96:32 = 3
	SETBIT ダンジョンフラグ:96:75, 2
	SETBIT ダンジョンフラグ:96:76, 0
	SETBIT ダンジョンフラグ:96:79, 2
	SETBIT ダンジョンフラグ:96:80, 1
ENDIF
SIF ダンジョンフラグ:[[ダンジョン:시나가와]]:2 == 1
	RETURN 1
SIF ダンジョンフラグ:[[ダンジョン:T.D.L.]]:2 == 1
	RETURN 1
SIF ダンジョンフラグ:20:0 & 16
	RETURN 1
RETURN 0


