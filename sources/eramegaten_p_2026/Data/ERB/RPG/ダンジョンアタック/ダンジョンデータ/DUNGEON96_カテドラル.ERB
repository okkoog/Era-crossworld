@DEFINE_TILES_96, ARGS, ARG, ARG:1
SELECTCASE ARGS
	;ボス撃破まで開けられない扉 / ボス前扉
	CASE "G", "n"
		SELECTCASE FLAG:현M
			;アスラおう
			CASE 0
				;アスラおう撃破
				SIF ダンジョンフラグ:96:11 == 3
					RETURN 2
				;カオスルートでは無条件に通れる
				SIF ダンジョンフラグ:96:10 == 2
					RETURN 2
			CASE 1
				;カオスヒーロー撃破済み
				SIF ダンジョンフラグ:96:12
					RETURN 2
				;カオスルートでは無条件に通れる
				SIF ダンジョンフラグ:96:10 == 2
					RETURN 2
			;13アリオク
			CASE 4
				SIF ダンジョンフラグ:(FLAG:현던전):13 == 3
					RETURN 2
				SIF ダンジョンフラグ:96:10 == 2
					RETURN 2
			;14アスタロト
			CASE 5
				SIF ダンジョンフラグ:(FLAG:현던전):14 == 3
					RETURN 2
				SIF ダンジョンフラグ:96:10 == 2
					RETURN 2
			;15スルト
			CASE 6
				SIF ダンジョンフラグ:(FLAG:현던전):15 == 3
					RETURN 2
				SIF ダンジョンフラグ:96:10 == 2
					RETURN 2
			;:16ウリエル
			CASE 9
				SIF ダンジョンフラグ:(FLAG:현던전):16 == 3
					RETURN 2
				SIF ダンジョンフラグ:96:10 == 1
					RETURN 2
			;:17ガブリエル
			CASE 10
				SIF ダンジョンフラグ:(FLAG:현던전):17 == 3
					RETURN 2
				SIF ダンジョンフラグ:96:10 == 1
					RETURN 2
			;:18ラファエル
			CASE 11
				SIF ダンジョンフラグ:(FLAG:현던전):18 == 3
					RETURN 2
				SIF ダンジョンフラグ:96:10 == 1
					RETURN 2
			;ロウヒーロー前の扉
			CASE 14
				;ロウヒーロー撃破済み
				SIF ダンジョンフラグ:96:19
					RETURN 2
			;ミカエル
			CASE 15
				SIF ダンジョンフラグ:96:10 == 1
					RETURN 2
				;ミカエル撃破済み
				SIF ダンジョンフラグ:96:20 == 3
					RETURN 2
			CASE 7
				SIF ダンジョンフラグ:(FLAG:현던전):23
					RETURN 2
			CASE 19
				SIF ダンジョンフラグ:(FLAG:현던전):33
					RETURN 2
		ENDSELECT
		IF ARGS == "G"
			RETURN 12
		ELSE
			RETURN 202
		ENDIF
	CASE "A"
		RETURN 22
	CASE "V"
		RETURN 32
	CASE ">"
		RETURN 42
	CASE "<"
		RETURN 52
	CASE "ﾛ"
		RETURN 102
	CASE "ｶ"
		RETURN 112
	CASE "m"
		;メッセンジャー
		RETURN 14
	CASE "P"
		;落とし穴
		RETURN 15
	CASE "L"
		RETURN 35
		;LとNにHPダメージ
		IF ABL:MASTER:속성LC == 3
			RETURN 1
		ELSE
			RETURN 25
		ENDIF
	CASE "C"
		RETURN 45
		;CとNにHPダメージ
		IF ABL:MASTER:속성LC == 1
			RETURN 1
		ELSE
			RETURN 25
		ENDIF
	CASE "s"
		;水
		RETURN 39
	CASE "w"
		;ワープゾーン
		RETURN 49
	CASE "g"
		;扉型ワープゾーン
		RETURN 29
ENDSELECT
