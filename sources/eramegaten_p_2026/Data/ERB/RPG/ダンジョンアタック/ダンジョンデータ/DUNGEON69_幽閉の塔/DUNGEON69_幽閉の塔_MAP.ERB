;=======================================================================
;タイル調整
;=======================================================================
@MAKE_FLOOR_LINE_COMMON_69, ARG, ARG:1, ARG:2
#DIM DYNAMIC L_TILE
;ARG:3(LOCAL:3) 宝箱 DB:75~99(현M+75)の1ビット目から、自動的に使う
;LOCAL:4 이벤트
;LOCAL:6 昇り階段 16 →　26　↓　端に6を置くと自動的に置き換わる
;LOCAL:7 降り階段 17 ←　27　↑　端に7を置くと自動的に置き換わる

;LOCAL:8 メッセンジャー
;(0/0)でLOCALを消去
SIF ARG:1 == 0 && ARG:2 == 0
	VARSET LOCAL
SELECTCASE ARG
	CASE 102
		DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:2 * 10 + ARG
		LOCAL:2++
	CASE 3
		;宝箱は多くの場合、開けたフラグが立っていると床を代入します
		;そのマップでどの宝箱を開けたかは、そのマップの宝箱管理用変数の何番目のビットが立っているかで判断します
		IF GETBIT(ダンジョンフラグ:(FLAG:현던전):(FLAG:현M+70), LOCAL:3)
			DA:(ARG:1):(ARG:2) = 1
		ELSE
			DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:3 * 10 + 3
		ENDIF
		LOCAL:3++
	CASE 4 TO 9
		DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:ARG * 10 + ARG
		LOCAL:ARG++
ENDSELECT

;タイル破壊
L_TILE = DA:(ARG:1):(ARG:2)
;이벤트
IF L_TILE % 10 == 4
	SELECTCASE FLAG:현M
		CASE 0
			SELECTCASE L_TILE % 1000 / 10
				CASE 0
					SIF FLAG_D69_アキラ加入フラグ
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 3
			SELECTCASE L_TILE % 1000 / 10
				CASE 0
					SIF FLAG_D69_セベク加入フラグ
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 4
			SELECTCASE L_TILE % 1000 / 10
				CASE 0
					SIF FLAG_D69_ハトホル加入フラグ
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 5
			SELECTCASE L_TILE % 1000 / 10
				CASE 1
					SIF FLAG_D69_アオパシャ撃破
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 6
			SELECTCASE L_TILE % 1000 / 10
				CASE 0
					SIF FLAG_D69_地のノモス扉の鍵
						DA:(ARG:1):(ARG:2) = 1
				CASE 1
					SIF FLAG_D69_トート加入フラグ
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 9
			SELECTCASE L_TILE % 1000 / 10
				CASE 0
					SIF FLAG_D69_アレックスとの対決その１フラグ
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 12
			SELECTCASE L_TILE % 1000 / 10
				CASE 1
					SIF FLAG_D69_ブーシャヤンスタ撃破
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 16
			SELECTCASE L_TILE % 1000 / 10
				CASE 0
					SIF FLAG_D69_ゴーストＱちゃん登場 == 2
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 17
			SELECTCASE L_TILE % 1000 / 10
				CASE 0
					SIF FLAG_D69_ドゥルジ撃破
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 20
			SELECTCASE L_TILE % 1000 / 10
				CASE 0, 1
					SIF FLAG_D69_アレックス撃破
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 25
			SIF FLAG_D69_aエレベーターの壁
				DA:(ARG:1):(ARG:2) = 1
		CASE 29
			SELECTCASE L_TILE % 1000 / 10
				CASE 0
					SIF FLAG_D69_ジャヒー撃破
						DA:(ARG:1):(ARG:2) = 1
				CASE 1, 2
					SIF FLAG_D69_サルワ撃破
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 30
			SELECTCASE L_TILE % 1000 / 10
				CASE 0, 1
					SIF FLAG_D69_アジ・ダハーカ撃破
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 31
			SIF FLAG_D69_アンリ・マンユ撃破
				DA:(ARG:1):(ARG:2) = 1
		CASE 32
			SIF !FLAG_D69_ズルワーン撃破
				DA:(ARG:1):(ARG:2) = 1
		CASE 33
			SELECTCASE L_TILE % 1000 / 10
				CASE 10
					SIF FLAG_D69_デメテル焦る
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 34
			SELECTCASE L_TILE % 1000 / 10
				CASE 0
					SIF FLAG_D69_ズルワーン撃破
						DA:(ARG:1):(ARG:2) = 1
			ENDSELECT
		CASE 35
			SIF FLAG_D69_デモニカの男フラグ || FINDCHARA_B([[キャラ:알렉스]]) < 2 || 依頼フラグ:[[依頼:유폐탑]]:10 != 2
				DA:(ARG:1):(ARG:2) = 1
		CASE 36
			SIF FLAG_D69_シェキナー撃破
				DA:(ARG:1):(ARG:2) = 1
	ENDSELECT
ENDIF
;イベント扉
IF L_TILE % 10 == 2 && L_TILE % 1000 > 100
	SELECTCASE FLAG:현M
		CASE 5
			SELECTCASE L_TILE % 100 / 10
				CASE 0
					SIF FLAG_D69_地のノモス扉の鍵 == 2
						DA:(ARG:1):(ARG:2) = 2
			ENDSELECT
		CASE 9
			SIF FLAG_D69_アレックスとの対決その１フラグ
				DA:(ARG:1):(ARG:2) = 2
		CASE 12
			SIF FLAG_D69_ブーシャヤンスタ撃破
				DA:(ARG:1):(ARG:2) = 2
		CASE 17
			SIF FLAG_D69_ドゥルジ撃破
				DA:(ARG:1):(ARG:2) = 2
		CASE 18
			SELECTCASE L_TILE % 100 / 10
				CASE 0
					SIF FLAG_D69_ドゥルジ撃破
						DA:(ARG:1):(ARG:2) = 2
				CASE 1
					SIF FLAG_D69_アンリ・マンユ撃破
						DA:(ARG:1):(ARG:2) = 2
			ENDSELECT
		CASE 20, 25
			SIF FLAG_D69_アレックス撃破
				DA:(ARG:1):(ARG:2) = 2
		CASE 29
			SELECTCASE L_TILE % 100 / 10
				CASE 0
					SIF FLAG_D69_ジャヒー撃破
						DA:(ARG:1):(ARG:2) = 2
				CASE 1
					SIF FLAG_D69_サルワ撃破
						DA:(ARG:1):(ARG:2) = 2
			ENDSELECT
		CASE 30
			SELECTCASE L_TILE % 100 / 10
				CASE 0
					IF FLAG_D69_アジ・ダハーカ撃破
						DA:(ARG:1):(ARG:2) = 2
					ELSE
						DA:(ARG:1):(ARG:2) = 42
					ENDIF
				CASE 1
					SIF FLAG_D69_ジャヒー撃破 && FLAG_D69_サルワ撃破
						DA:(ARG:1):(ARG:2) = 2
				CASE 2
					SIF FLAG_D69_アジ・ダハーカ撃破
						DA:(ARG:1):(ARG:2) = 2
			ENDSELECT
		CASE 31
			SELECTCASE L_TILE % 100 / 10
				CASE 0
					IF 依頼フラグ:[[依頼:유폐탑]]:2
						DA:(ARG:1):(ARG:2) = 1
					ELSE
						DA:(ARG:1):(ARG:2) = 0
					ENDIF
				CASE 1
					SIF FLAG_D69_アンリ・マンユ撃破
						DA:(ARG:1):(ARG:2) = 2
			ENDSELECT
		CASE 36
			SIF FLAG_D69_シェキナー撃破
				DA:(ARG:1):(ARG:2) = 2
	ENDSELECT
ENDIF
SIF L_TILE == 52 && FLAG_D69_aエレベーターの壁
	DA:(ARG:1):(ARG:2) = 2
;=======================================================================
;特殊タイル表示
;TILE_MARK_COMMON_{FLAG:현던전}_X
;=======================================================================
;ARG:1、ARG:2がX座標とY座標
;ARGはそこに代入されている値
;RESULTSに代入した文字がマップに表示されますが、必ず全角1文字分になるようにしてください。そうでないと表示が崩れます。

;イベントタイル特殊表示
;末尾の_4はイベントであることを示す4
@TILE_MARK_COMMON_69_2, ARG, ARG:1, ARG:2
RESETCOLOR
SELECTCASE ARG
	CASE 12
		IF GET_FLOOR_ANALYZE_T(ARG:1, ARG:2) == 2
			RESULTS = △
		ELSE
			RESULTS = 扉
		ENDIF
	CASE 22
		IF GET_FLOOR_ANALYZE_T(ARG:1, ARG:2) == 2
			RESULTS = ▽
		ELSE
			RESULTS = 扉
		ENDIF
	CASE 32
		IF GET_FLOOR_ANALYZE_T(ARG:1, ARG:2) == 2
			RESULTS = ≪
		ELSE
			RESULTS = 扉
		ENDIF
	CASE 42
		IF GET_FLOOR_ANALYZE_T(ARG:1, ARG:2) == 2
			RESULTS = ≫
		ELSE
			RESULTS = 扉
		ENDIF
	CASE 52
		IF FLAG_D69_aエレベーターの壁
			RESULTS = 扉
		ELSE
			RESULTS = ■
		ENDIF
	CASEELSE
		;イベント扉
		IF ARG % 10 == 2 && ARG % 1000 > 100 && GET_FLOOR_ANALYZE_T(ARG:1, ARG:2) == 2
			SETCOLOR COLOR("p-green")
			RESULTS = 扉
		ELSE
			RETURN 1
		ENDIF
ENDSELECT

@TILE_MARK_COMMON_69_9, ARG , ARG:1 , ARG:2
SELECTCASE ARG / 10
	CASE 1
		RESULTS = ST
	CASE 2 , 3 , 4
		RESULTS = Ｅ
	CASEELSE
		RETURN 1
ENDSELECT

@TILE_MARK_COMMON_69_5, ARG , ARG:1 , ARG:2
SELECTCASE FLAG:현M
	CASE 6
		SETCOLOR 0x404040 
		RESULTS = □
	
	CASE 16
		SETCOLOR 0x404040 
		RESULTS = □
		
	CASE 29
		SETCOLOR 0x404040 
		RESULTS = □
		
	CASEELSE
		RETURN 1
ENDSELECT

@TILE_MARK_COMMON_69_4, ARG , ARG:1 , ARG:2
SELECTCASE ARG / 10

	;メッセンジャーを緑色で"ｍ"と表示
	CASE 0 TO 2 , 200 TO 201 , 301 , 500 , 800 , 1000 , 1200 , 1202 , 1204 , 1400 , 1500 , 1800 , 2501 , 2700 , 3301
		SETCOLOR 0x00ff00
		RESULTS = ｍ
		
	CASE 1203
		SETCOLOR 0xff9328
		RESULTS = 麺
	CASE 2001
		RESULTS = □
	CASE 2200 TO 2216
		RESULTS = □
	CASE 2900, 2901
		RESULTS = ！
	CASE 2902
		RESULTS = □
	CASE 2903 TO 2946
		SETCOLOR 0x424242
		RESULTS = □
	CASE 3001
		RESULTS = □
	CASE 3300 , 3302 TO 3309
		SETCOLOR 0x9932cc
		RESULTS = ∥
			
	CASE 3200
		SETCOLOR 0x2828ff
		RESULTS = ◇
	CASE 3401
		SETCOLOR 0x2828ff
		RESULTS = ◇

	CASE 3500
