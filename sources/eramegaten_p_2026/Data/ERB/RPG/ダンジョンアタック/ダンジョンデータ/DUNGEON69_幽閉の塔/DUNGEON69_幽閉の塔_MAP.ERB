@DEFINE_TILES_69, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "t"
		RETURN 19
	CASE "e"
		RETURN 29
	CASE "a"
		RETURN 39
	CASE "b"
		RETURN 49
	CASE "^"
		RETURN 12
	CASE "_"
		RETURN 22
	CASE "<"
		RETURN 32
	CASE ">"
		RETURN 42
	CASE "H"
		RETURN 52
	CASE "G"
		RETURN 102
ENDSELECT

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@JUDGE_CAN_ENTER_69, L_X, L_Y, L_DIRECTION, L_ROUTENUM = -1, DUNGEON_TILE_SEARCH_TASK
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC L_TILE
#DIM DYNAMIC L_DIRECTION
#DIM DYNAMIC L_ROUTENUM
#DIM REF DUNGEON_TILE_SEARCH_TASK
L_TILE = DA:L_X:L_Y
;そのほか汎用床
SELECTCASE L_TILE
	;↑扉
	CASE 12, 22, 32, 42
		IF IS_AUTORUN_SEARCHING
			RETURN GET_FLOOR_ANALYZE_T(L_X, L_Y) < 2
		ELSE
			;直クリックは始動のために判定を通す
			IF GOLE_X == L_X && GOLE_Y == L_Y
				RETURN 1
			ELSE
				SELECTCASE L_TILE
					CASE 12
						RETURN L_DIRECTION == 2
					CASE 22
						RETURN L_DIRECTION == 8
					CASE 32
						RETURN L_DIRECTION == 4
					CASE 42
						RETURN L_DIRECTION == 6
				ENDSELECT
			ENDIF
		ENDIF
	CASE 52
		IF FLAG_D69_aエレベーターの壁
			RETURN 1
		ELSE
			RETURN 0
		ENDIF
	CASEELSE
		;イベント扉はサーチ済みの時のは経路にいれない
		IF L_TILE % 10 == 2 && L_TILE % 1000 > 100
			IF IS_AUTORUN_SEARCHING 
				RETURN GET_FLOOR_ANALYZE_T(L_X, L_Y) < 2
			ELSE
				RETURN 1
			ENDIF
		ENDIF
ENDSELECT
RESULT = 1
TRYCALLFORM DUNGEON_BEFORE_ENTER_EVENT_69, L_X, L_Y, 1
SIF !RESULT
	RETURN 0
CALL CAN_ENTER, L_X, L_Y
RETURN RESULT