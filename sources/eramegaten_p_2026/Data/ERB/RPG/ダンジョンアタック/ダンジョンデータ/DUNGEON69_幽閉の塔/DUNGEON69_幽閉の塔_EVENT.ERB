@RAMEN_DUNGEON_69
;ラーメン屋
	CALL MESSAGE_WINDOW_D, "아저씨", "어서옵쇼"
	$BAR_LOOP
	CALL MESSAGE_WINDOW_D, "아저씨", "나니니 시마스까？"
	CALL INPUT_SELECT_D, "[1]라면을 시킨다/[2]이야기를 듣다/////[0]밖으로 나가다" , , , 2
	IF RESULT == 0
		CALL MESSAGE_WINDOW_D, "아저씨", "감솸다"
	ELSEIF RESULT == 1
		$BAR_LOOP_1
		CALL INPUT_SELECT_D , "품목//[1]라면 30마카/[0]그만둔다" , , , 2
		IF RESULT == 0
			GOTO BAR_LOOP
		ELSEIF RESULT == 1
			IF MONEY:1 < 30
				CALL MESSAGE_WINDOW_D, "아저씨", @"손님~ 돈이 부족해~"
			ELSE
				CALL MESSAGE_WINDOW_D, "아저씨", @"넵、라면 한 그릇~"
				LOCALS = 
				FOR LOCAL, 1, 7
					SIF POS(LOCAL) >= 0 && CFLAG:POS(LOCAL):상태이상 == 0
						LOCALS += @"[{LOCAL}] %CALLNAME:POS(LOCAL)%/"
				NEXT
				LOCALS +=  "[9] 그만둔다"
				CALL INPUT_SELECT_D, LOCALS, , , 2
				IF RESULT < 7
					LOCAL = POS(RESULT)
					MONEY:1 -= 30
						CALL MESSAGE_WINDOW_D, "", @"＞%CALLNAME:LOCAL%는 나온 라면을 먹었다"
					SELECTCASE RAND:100
						CASE IS < 10
							CALL MESSAGE_WINDOW_D, "", @"＞웃！/＞%CALLNAME:LOCAL%는 데미지를 받았다"
							BASE:LOCAL:ＨＰ = BASE:LOCAL:ＨＰ/2+1
						CASE IS < 30
							CALL MESSAGE_WINDOW_D, "", @"＞최고의 일품이다！/>%CALLNAME:LOCAL%는 전회복했다。"
							BASE:LOCAL:ＨＰ = MAXBASE:LOCAL:ＨＰ
						CASEELSE
