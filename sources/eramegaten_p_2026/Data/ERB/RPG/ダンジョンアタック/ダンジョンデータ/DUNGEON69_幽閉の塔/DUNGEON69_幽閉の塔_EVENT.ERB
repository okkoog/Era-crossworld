@EVENT_DUNGEON_START_69
IF FLAG_D69_スタート時イベント == 0
	CUSTOMDRAWLINE =
	CALL MESSAGE_WINDOW_D, "", @"＞차원문을 통과한 곳은 어두컴컴한 지하였다…"
	CALL MESSAGE_WINDOW_D, "", @"＞이곳이 데메테르가 말했던 마왕의 영토일까？"
	CALL MESSAGE_WINDOW_D, "", @"＞악마들의 기척을 느끼면서 당신은 걸음을 옮겼다.……"
	
	FLAG_D69_スタート時イベント = 1
ENDIF

;=======================================================================
;タイル侵入時時イベント
;=======================================================================
@DUNGEON_BEFORE_ENTER_EVENT_69,L_X,L_Y,L_DIRECTION
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC L_TILE
#DIM DYNAMIC L_DIRECTION
L_TILE = DA:L_X:L_Y
IF L_TILE % 10 == 2 && L_TILE % 1000 > 100
	SELECTCASE FLAG:현M
		CASE 5
			SELECTCASE L_TILE % 100 / 10
				CASE 0
					IF FLAG_D69_地のノモス扉の鍵 == 1
						CALL MESSAGE_WINDOW_D, "", @"＞잠긴 문 너머에서 수상한 기척이 느껴진다……/＞열쇠를 열고 앞으로 나아가겠습니까？"
						CALL INPUT_SELECT_D, "[0] 문 너머로 간다/[1] 가지 않는다"
						IF RESULT == 0
							CALL MESSAGE_WINDOW_D, "", @"＞열쇠를 써서 문을 열었다"
							FLAG_D69_地のノモス扉の鍵 = 2
							RETURN 1
						ELSE
							RETURN 0
						ENDIF
					ELSE
						CALL MESSAGE_WINDOW_D, "", @"＞문에는 자물쇠가 잠겨 있다……"
						RETURN 0
					ENDIF
			ENDSELECT
		CASE 9, 17, 20, 29, 31, 36
			CALL MESSAGE_WINDOW_D, "", @"＞문 너머에서 수상한 기척이 느껴진다……/＞문을 열고 앞으로 나아가겠습니까？"
			CALL INPUT_SELECT_D, "[0] 문 너머로 간다/[1] 가지 않는다"
			IF RESULT == 0
				RETURN 1
			ELSE
				RETURN 0
			ENDIF
		CASE 12
			SELECTCASE L_TILE % 100/10
				CASE 0
					CALL MESSAGE_WINDOW_D, "", @"＞문 너머에서 수상한 기척이 느껴진다……/＞문을 열고 앞으로 나아가겠습니까？"
					CALL INPUT_SELECT_D, "[0] 문 너머로 간다/[1] 가지 않는다"
					IF RESULT == 0
						RETURN 1
					ELSE
						RETURN 0
					ENDIF
				CASE 1
					CALL MESSAGE_WINDOW_D, "", @"＞문에는 봉인이 되어 있다……"
					RETURN 0
			ENDSELECT
		CASE 18, 25
			SELECTCASE L_TILE % 100/10
				CASE 0, 1
					CALL MESSAGE_WINDOW_D, "", @"＞문에는 봉인이 되어 있다……"
					RETURN 0
			ENDSELECT
		CASE 30
			SELECTCASE L_TILE % 100/10
				CASE 1
					CALL MESSAGE_WINDOW_D, "", @"＞문에는 봉인이 되어 있다……"
					RETURN 0
				CASE 2
					CALL MESSAGE_WINDOW_D, "", @"＞문 너머에서 수상한 기척이 느껴진다……/＞문을 열고 앞으로 나아가겠습니까？"
					CALL INPUT_SELECT_D, "[0] 문 너머로 간다/[1] 가지 않는다"
					IF RESULT == 0
						RETURN 1
					ELSE
						RETURN 0
					ENDIF
			ENDSELECT
	ENDSELECT
ENDIF
IF GROUPMATCH(L_TILE, 12, 22, 32, 42)
	;ギミックそのものが死ぬのとかなり見た目の効率が悪くマップの穴埋めをしようとしてしまうので自動探索では通過させない
	;(マウスクリックは通す)
	SIF IS_AUTO_PIROT
		RETURN 0
	SIF L_TILE == 12 && L_DIRECTION != 8
		RETURN 0
	SIF L_TILE == 22 && L_DIRECTION != 2
		RETURN 0
	SIF L_TILE == 32 && L_DIRECTION != 4
		RETURN 0
	SIF L_TILE == 42 && L_DIRECTION != 6
		RETURN 0
ENDIF
SIF L_TILE == 52 && FLAG_D69_aエレベーターの壁 == 0
	RETURN 0
CALL CAN_ENTER,L_X,L_Y
RETURN RESULT

;=======================================================================
;[5]調べる　実行時のイベント
