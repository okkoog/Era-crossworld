@EVENT_CHECK_DUNGEON_69
CALL EVENT_DUNGEON_69
RETURN RESULT

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_69, ARG
;ARG = 進入時の向き　0の場合ワープなど
CALL EVENT_DUNGEON_69, ARG , 0
RETURN RESULT

@EVENT_DUNGEON_69, ARG, ARG:1
