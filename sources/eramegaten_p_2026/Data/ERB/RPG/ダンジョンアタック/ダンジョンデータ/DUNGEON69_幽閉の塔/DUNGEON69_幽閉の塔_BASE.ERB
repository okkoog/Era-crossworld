;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_69
SIF FLAG_D69_ダンジョンクリア
	RETURN 0
SIF 依頼フラグ:[[依頼:유폐탑]]:1 != 1
	RETURN 0
RETURN 1

;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_69
SELECTCASE FLAG:현M
	CASE 12
		IF FLAG_D69_ブーシャヤンスタ撃破 == 1
			FLAG:미조우걸음수 = 0
			FLAG:인카운트율 = 0
			FLAG:MAG소비율 = 0
		ELSE
			FLAG:인카운트율 = FLAG:미조우걸음수 * 5
			FLAG:MAG소비율 = 100
		ENDIF
	CASEELSE
		FLAG:인카운트율 = FLAG:미조우걸음수 * 5
		FLAG:MAG소비율 = 100
ENDSELECT
SIF FLAG:미조우걸음수 < 5
	FLAG:인카운트율 = 0

	
;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_69
IF RAND:100 < FLAG:인카운트율
	RETURN 1
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF

;=======================================================================
;敵の種族の種類数
