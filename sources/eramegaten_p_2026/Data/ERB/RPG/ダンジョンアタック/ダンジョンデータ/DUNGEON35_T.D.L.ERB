;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_35
;エキドナと友好的な状態の場合、エンカウントしない
SIF ダンジョンフラグ:(FLAG:현던전):2 == 1
	RETURN 0
IF RAND:100 < FLAG:인카운트율
	;超低確率でレアエネミーと遭遇。タルタロスの赤悪魔処理とほぼ同様
	IF RAND:200 < 1
		CALL MESSAGE_WINDOW_D, "목소리", "하핫…/꽥 꽥…"
		PRINTW ＞대단히 위험한 악마의 기척이 느껴진다…
		CALL INPUT_YN("싸움을 건다", "그냥 지나친다")
		IF RESULT == 0
			CALL MESSAGE_WINDOW_D, "악마", "안녕！/드디어 만났네！"
			CALL MESSAGE_WINDOW_D, "악마", "그럼 이번엔/네 강함을 시험해 볼까！"
			CALL MESSAGE_WINDOW_D, "악마", "이리 오렴！ 플루토！"
			
			
			CALL SET_ENEMY,9,[[キャラ:좀비마우스]],60,0,3
			CFLAG:(CHARANUM-1):행동횟수 = 2
			CFLAG:(CHARANUM-1):ＨＰ보정 += 1000
			CFLAG:(CHARANUM-1):BS무효플래그 = 1
			
			CALL SET_ENEMY,8,[[キャラ:데몬덕]],60,0,3
			CFLAG:(CHARANUM-1):행동횟수 = 2
			CFLAG:(CHARANUM-1):ＨＰ보정 += 1000
			CFLAG:(CHARANUM-1):BS무효플래그 = 1
			
			CALL SET_ENEMY,10,[[キャラ:오르트로스]],45,0,1
			CFLAG:(CHARANUM-1):행동횟수 = 2
			CFLAG:(CHARANUM-1):ＨＰ보정 += 500
			
			FLAG:회화불능플래그 = 1
			FLAG:선제기습취소 = 1
			CALL BATTLE_START
			FLAG:회화불능플래그 = 0
			FLAG:선제기습취소 = 0
			
			PRINTW ＞…결정타를 맞은 위험한 악마는 화려한 시각 효과를 수반하며 저 멀리 날아갔다。
		ELSE
			PRINTW ＞…악마의 기척은 멀어져 갔다。
		ENDIF
		FLAG:미조우걸음수 = 0
		RETURN 0
	ELSE
		RETURN 1
	ENDIF
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF
