;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_43

;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 3
	CALL TREASURE_43
	RETURN 1

;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 6
	SELECTCASE FLAG:현M
		CASE 0
			;三階中央
			SIF FLAG:현X == 18 && FLAG:현Y == 10
				CALL DUNGEON_UPSTAIRS,4,3,1
		CASE 1
			;二階北西　昇6
			SIF FLAG:현X == 6 && FLAG:현Y == 6
				CALL DUNGEON_UPSTAIRS,0,5,5
			;二階南西
			SIF FLAG:현X == 5 && FLAG:현Y == 24
				CALL DUNGEON_UPSTAIRS,0,5,24
			;二階北東
			SIF FLAG:현X == 32 && FLAG:현Y == 5
				CALL DUNGEON_UPSTAIRS,0,32,5
			;二階南東
			SIF FLAG:현X == 32 && FLAG:현Y == 24
				CALL DUNGEON_UPSTAIRS,0,32,24
			;二階中央
			SIF FLAG:현X == 20 && FLAG:현Y == 22
				CALL DUNGEON_UPSTAIRS,0,20,22

