;=======================================================================
;●おしながき
;1.ノーマルシド
;2.魔人シド
;3.完全覚醒イナルナ
;=======================================================================
;●コンセプト
;・ラスボスに相応しい程度の強さ。イメージは「ナイトテイルのマザハ様」。
;・ノーマルシドは、素材（原作）の味を活かします
;　・「っていうか！！！！！ラスボス前の敵がマハブフーラ程度を使ってくるのはどうかと思うんだ！！！」
;　　っていうのが今回のスタートなので、これはこれで味わってほしい
;・なお、なーんにも変わってないのにシドにAI搭載したのは「シドを拾えるようにした都合でスキルが強化されてしまった」から
;　素材の味を活かすためのAI搭載です。
;・全体的に、やや状態異常の割合が高いです。
;　デカジャ・デクンダをイナルナしか持ってないのが弱点らしい弱点。
;　ただし、テストプレイした結果魔法効果以外ギャン下げされました。つらい。デクンダ持っていけば余裕ができるはず。
;　あんまり凝ったことはしてないです。でもメギドラがメインウェポンってのからは脱却したよ……
;=======================================================================


;=======================================================================
@SET_ACTION_ノーマルシド, ARG
;=======================================================================
;CSV弄っちゃったのでレベルアップでスキル覚えちゃうんですよ
;そのためクソ雑魚AIを作ることに
;=======================================================================

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

	IF 0
	ELSEIF RAND:6 == 0
		CFLAG:ARG:입력행동 = [[스킬:테트라칸]]
	ELSEIF RAND:5 == 0
		CFLAG:ARG:입력행동 = [[스킬:침묵의속삭임]]
	ELSEIF RAND:4 == 0
		CFLAG:ARG:입력행동 = [[스킬:바이스・고스펠]]
	ELSEIF RAND:3 == 0
		CFLAG:ARG:입력행동 = [[스킬:마하・잔]]
	ELSEIF RAND:2 == 0
		CFLAG:ARG:입력행동 = [[스킬:마하・부흐라]]
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:메기도라]]
	ENDIF

;アクション実行不能
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1



;=======================================================================
@SET_ACTION_魔人シド, ARG
;=======================================================================
;魔人シド
;3回行動
;元々の行動が「빙결」「충격」「만능」「状態異常」「カーン」なので、その方針で
;カポエラの達人らしいので打撃・戦技も織り交ぜる
;=======================================================================
#DIM 魔人シド行動判定
#DIM 魔人シド本気判定

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1


;行動はローテーション
;0：打撃・戦技・状態異常
;1：氷結・衝撃・状態異常
;2：カーン・万能・万能……速カーンも敵専用スキルにはあるが、そこはそれということで
IF CFLAG:ARG:행동한횟수 == 0
	魔人シド行動判定 += 1

	;HP半減または10ターン目以後パワーアップ
	IF 現HP割合(CHARANUM-6) <= 50 && 魔人シド本気判定 == 0
		CFLAG:(CHARANUM-6):행동횟수 = 3
		魔人シド本気判定 = 1
	ENDIF
	IF 魔人シド行動判定 > 10 && 魔人シド本気判定 == 0
		CFLAG:(CHARANUM-6):행동횟수 = 3
		魔人シド本気判定 = 1
	ENDIF
ENDIF

;順当に殺しに行く
IF CFLAG:ARG:１more플래그 > 0
	CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
ELSE
	;物理攻撃ターン
	IF 魔人シド行動判定 % 3 == 0
		IF CFLAG:ARG:행동한횟수 == 0
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:모탈지하드]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:오의방어부수기]]
			ENDIF
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:전력공격]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:데몬레이브]]
			ENDIF
		ELSE
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:바이스・고스펠]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:히트라이저]]
			ENDIF
		ENDIF

	;魔法攻撃ターン
	ELSEIF 魔人シド行動判定 % 3 == 1
		IF CFLAG:ARG:행동한횟수 == 0
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:암흑의뇌광]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마하・지오다인]]
			ENDIF
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			;「ここですか？」
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:회오리]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마하・잔다인]]
			ENDIF
		ELSE
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:침묵의속삭임]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:랜더마이저]]
			ENDIF
		ENDIF
	;万能ターン
	ELSE
		IF CFLAG:ARG:행동한횟수 == 0
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:테트라칸]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마카라칸]]
			ENDIF
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:메기도라]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
			ENDIF
		ELSE
			;たぶんモデル、ナイ神父だよね……
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:기어오는혼돈]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:메기도크로스]]
			ENDIF
		ENDIF
	ENDIF
ENDIF


;アクション実行不能
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1

