IF CFLAG:ARG:행동한횟수 == 0
	;1moreが入ってた場合、ローテを飛ばす(シドとローテをズラすため)
	IF 獣の眼光マカカジャマカカジャメギドラオン == 1
		完全覚醒イナルナ行動判定 += 1
		獣の眼光マカカジャマカカジャメギドラオン = 0
	ENDIF
	完全覚醒イナルナ行動判定 += 1
	SIF	完全覚醒イナルナ行動判定 > 2
		完全覚醒イナルナ行動判定 = 0
ENDIF

