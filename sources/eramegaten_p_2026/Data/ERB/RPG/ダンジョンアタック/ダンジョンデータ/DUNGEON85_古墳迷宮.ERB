;ARG = 進入時の向き　0の場合ワープなど
CALL EVENT_DUNGEON_85, ARG , 0
RETURN RESULT

@EVENT_DUNGEON_85, ARG, ARG:1
#DIM 交渉可能キャラ , 7
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) % 10
;==========
;ワープの処理
;==========
	CASE 1
	CALL FLOOR_85
	RETURN RESULT
	
	CASE 9
		SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
		CASE 1
				CALL DUNGEON_WORP,7,2,5
		CASE 2
				CALL DUNGEON_WORP,7,8,12
		ENDSELECT
;==========
;出口の処理
;==========
	CASE 8
		CALL DUNGEON_EXIT
	RETURN 1
;==========
;扉の処理
;==========
	CASE 2
		CALL DUNGEON_DOOR,ARG
		RETURN 1
;========
;宝の処理
;========
CASE 3
CALL TREASURE_85
RETURN 1

;=======
;階段
;=======
CASE 6
CALL UPSTAIRS_85
RETURN RESULT

CASE 7
CALL DOWNSTAIRS_85
RETURN RESULT
;==========
;이벤트
;==========
