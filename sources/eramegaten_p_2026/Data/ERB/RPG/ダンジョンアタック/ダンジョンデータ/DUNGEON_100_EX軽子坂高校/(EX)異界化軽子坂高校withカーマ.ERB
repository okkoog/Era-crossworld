@SET_ENEMY_DUNGEON_100, L_PATTERN
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_ENEMY
#DIMS DYNAMIC L_PATTERN
SELECTCASE L_PATTERN
	CASE "エンティティー"
		CALL SET_ENEMY, 9, [[キャラ:엔티티]], 17, 0, 1
		L_ENEMY = CHARANUM - 1
		
		CSTR:L_ENEMY:특수적보정패턴 = D100_エンティティ－
		CSTR:L_ENEMY:사고패턴 = D100_エンティティ－
		CSTR:L_ENEMY:랜덤선택금지스킬 = [[스킬:마하무드]]
		TSTR:전투이벤트패턴 = D100_エンティティ－

		CALL CLEAR_ALL_SKILL, L_ENEMY
		CALL SET_SKILL, L_ENEMY, "마구날뛰기"
		CALL SET_SKILL, L_ENEMY, "소닉펀치"
		CALL SET_SKILL, L_ENEMY, "마비물어뜯기"
		CALL SET_SKILL, L_ENEMY, "마하무드"
		CALL SET_SKILL, L_ENEMY, "激怒"

		CFLAG:L_ENEMY:행동횟수 = 2
		FOR LCOUNT, 0, TYPENUM
			SELECTCASE GET_TYPE(LCOUNT)
				CASE "비구"
					BASE:L_ENEMY:GET_TYPE(LCOUNT) = 0
				CASE "수격"
					BASE:L_ENEMY:GET_TYPE(LCOUNT) = 0
				CASE "검격", "타격", "전술", "질풍"
					BASE:L_ENEMY:GET_TYPE(LCOUNT) = 75
				CASE "화염", "중력", "핵열"
					BASE:L_ENEMY:GET_TYPE(LCOUNT) = 150
				CASE "빙결"
					BASE:L_ENEMY:GET_TYPE(LCOUNT) = 200
				CASEELSE
					BASE:L_ENEMY:GET_TYPE(LCOUNT) = 100
			ENDSELECT
		NEXT
		CALL SYNC_STATUS, L_ENEMY
		CALL HEALTH_CHARA, L_ENEMY
ENDSELECT

@SET_ACTION_D100_エンティティ－, ARG
IF D100_マハムド予告
	D100_マハムド予告 = 0
	CFLAG:ARG:입력행동 = [[스킬:마하무드]]
ELSE
	SELECTCASE RAND:100
		CASE IS < 15
			IF 	CFLAG:ARG:행동한횟수 == CFLAG:ARG:행동횟수 - 1
				CSTR:ARG:행동예고 = 暗黒呪文詠唱
				CSTR:ARG:행동예고메시지 = %CALLNAME:ARG%は怪しげな呪文を詠唱しはじめた…
				CFLAG:ARG:입력행동 = [[스킬:행동예고]]
				D100_マハムド予告 = 1
			ELSE
				CFLAG:ARG:입력행동 = 0
			ENDIF
		CASE IS < 40
			CFLAG:ARG:입력행동 = [[스킬:마구날뛰기]]
		CASE IS < 60
			CFLAG:ARG:입력행동 = [[스킬:소닉펀치]]
		CASE IS < 80
			CFLAG:ARG:입력행동 = [[스킬:마비물어뜯기]]
		CASEELSE
			CFLAG:ARG:입력행동 = 0
	ENDSELECT
ENDIF
CALL RANDOM_TARGET,ARG,CFLAG:ARG:입력행동
SIF !RESULT
	CALL ランダム行動 , ARG
RETURN 1

