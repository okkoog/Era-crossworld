;=======================================================================
;敵の種類
;=======================================================================
@ENEMY_100, ARG
;===========
;카루코자카고교
;===========
;雑魚悪魔
;1階　出現せず
;2階　LV5～9程度
;	ナハトコボルト、オンモラキ、ゾンビくん、ゾンビちゃん、ガキ
;3階　LV8〜12程度
;	プシュケ、インプ、リリム、キキーモラ、ポルターガイスト、ジャックリパー

SELECTCASE FLAG:현M
	CASE 1
		SELECTCASE RAND:100
			CASE IS < 25
				RETURN [[キャラ:좀비쨩]], RAND(8, 10)
			CASE IS < 50
				RETURN [[キャラ:좀비군]], RAND(8, 10)
			CASE IS < 65
				RETURN [[キャラ:아귀]], RAND(8, 10)
			CASE IS < 80
				RETURN [[キャラ:나하트코볼트]], RAND(8, 10)
			CASEELSE
				RETURN [[キャラ:온모라키]], RAND(8, 10)
		ENDSELECT
	CASE 2
	;上層での遭遇
		SELECTCASE RAND:100
			CASE IS < 10
				RETURN [[キャラ:좀비쨩]], RAND(8, 12)
			CASE IS < 20
				RETURN [[キャラ:좀비군]], RAND(8, 12)
			CASE IS < 35
				RETURN [[キャラ:프시케]], RAND(10, 12)
			CASE IS < 50
				RETURN [[キャラ:임프]], RAND(10, 12)
			CASE IS < 65
				RETURN [[キャラ:리림]], RAND(10, 12)
			CASE IS < 80
				RETURN [[キャラ:키키모라]], RAND(10, 12)
			CASE IS < 90
				RETURN [[キャラ:폴터가이스트]], 12
			CASEELSE
				RETURN [[キャラ:잭・더・리퍼]], 12
		ENDSELECT
ENDSELECT


;=======================================================================
;攻略開始時のイベント
;=======================================================================
@EVENT_DUNGEON_START_100
#DIM DYNAMIC L_KAMA
#DIM DYNAMIC L_REIKO
IF FLAG_D100_初回突入済み == 0
	CALL MESSAGE_WINDOW_D_ICON, GETCHARA([[キャラ:카마마라]]), "キャラ番号", "", "카마", "마신황 하자마는 이 고교를 이계화시켰습니다。/분명 이 건물이나、여기서 이어지는 마계에 하자마가 있을 터입니다"
	CALL INPUT_SELECT_D, "[0] 애초에 마신황이 뭔데？"
	CALL MESSAGE_WINDOW_D_ICON, GETCHARA([[キャラ:카마마라]]), "キャラ番号", "", "카마", "마계를 지배한 하자마가 자칭하고 있는 직함이지요。/마신으로도 충분하다고 생각합니다만……/역시 전임자와 겹치는 게 싫다거나 주변을 향한 청개구리 심리 아니겠어요？"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "", "", "＞마신황 하자마……/정체가 뭔진 몰라도、요주의 인물로 기억해 두자。"
	FLAG_D100_初回突入済み = 1
ELSE
	IF FLAG_D100_クリアフラグ == 0 && FLAG_D100_玄関イベント済み
		IF FINDCHARA_B([[キャラ:레이코]]) == 1
			L_REIKO = RESULT:1
			CFLAG:L_REIKO:이자리에없는플래그 = 0
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "", "", "＞레이코와 합류했다"
			CALL JOIN_REIKO_D100
		ENDIF
	ENDIF
ENDIF
;=======================================================================
;脱出時のイベント
;=======================================================================
@EVENT_DUNGEON_END_100
#DIM DYNAMIC L_REIKO
IF FLAG_D100_クリアフラグ == 0 && FLAG_D100_玄関イベント済み
	L_REIKO = GETCHARA([[キャラ:레이코]]) 
	IF CFLAG:L_REIKO:인계횟수 == 0
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "", "", "＞레이코와 헤어졌다"
		CALL DEACTIVATE_FRIEND_CHARA, L_REIKO
	ENDIF
ENDIF
;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_100,ARG,ARG:1
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@JUDGE_CAN_ENTER_100, L_X, L_Y, L_DIRECTION, L_ROUTENUM = -1, DUNGEON_TILE_SEARCH_TASK
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC L_TILE
#DIM DYNAMIC L_DIRECTION
#DIM DYNAMIC L_ROUTENUM
#DIM REF DUNGEON_TILE_SEARCH_TASK
SELECTCASE　DA:L_X:L_Y
	CASE 9
		IF IS_AUTORUN_SEARCHING
			RETURN 0
		ELSE
			RETURN 1
		ENDIF
	CASE 12
		IF IS_AUTORUN_SEARCHING 
			RETURN GET_FLOOR_ANALYZE_T(L_X, L_Y) < 2
		ELSE
			RETURN 1
		ENDIF
	CASEELSE
		CALL CAN_ENTER,L_X,L_Y
		RETURN RESULT
ENDSELECT

@DUNGEON_BEFORE_ENTER_EVENT_100,L_X,L_Y,L_DIRECTION
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC L_DIRECTION
SELECTCASE DA:L_X:L_Y
	CASE 9
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "", "", "＞잔해가 길을 가로막고 있다……"
		RETURN 0
	CASE 12
		CALL MESSAGE_WINDOW_D_ICON, GETCHARA([[キャラ:카마마라]]), "キャラ番号", "", "카마", "이 방에서 강한 마력이 느껴져요。/각오는 되셨나요？"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "", "돌입하겠습니까？"
		CALL INPUT_YN_D
		RETURN RESULT == 0
ENDSELECT
RETURN 1
;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_100, IS_ENTER
#DIM DYNAMIC IS_ENTER;侵入時イベントから飛んできた場合
#DIM DYNAMIC L_KAMA
#DIM DYNAMIC L_REIKO
CALLF FINDCHARA_B, [[キャラ:카마마라]]
L_KAMA = RESULT:1
CALLF FINDCHARA_B, [[キャラ:레이코]]
L_REIKO = RESULT:1

