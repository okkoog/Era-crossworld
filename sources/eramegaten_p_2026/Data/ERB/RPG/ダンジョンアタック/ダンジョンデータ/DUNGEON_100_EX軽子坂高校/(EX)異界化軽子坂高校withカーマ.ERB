;=======================================================================
;タイル定義
;=======================================================================
@DEFINE_TILES_100, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "x"
		RETURN 9
	CASE "G"
		RETURN 12
	CASE "m"
		RETURN 14
ENDSELECT
;=======================================================================
;タイル調整
;=======================================================================
;何個目のARGタイプのマスなのか、は左上の(0,0)から右まで探し、その後一つ下の段に移って同様に探す、というのを右下まで繰り返して数えます。
@MAKE_FLOOR_LINE_COMMON_100, ARG, ARG:1, ARG:2
#LOCALSIZE 20
;指定された座標が(0,0)である場合、つまり新しいマップを読み込んだ時はLOCALを消去します
SIF ARG:1 == 0 && ARG:2 == 0
	VARSET LOCAL
SELECTCASE ARG
	CASE 0, 1
	CASE 3
		;宝箱は多くの場合、開けたフラグが立っていると床を代入します
		;そのマップでどの宝箱を開けたかは、そのマップの宝箱管理用変数の何番目のビットが立っているかで判断します
		IF GETBIT(ダンジョンフラグ:(FLAG:현던전):(FLAG:현M+70), LOCAL:3)
			DA:(ARG:1):(ARG:2) = 1
		ELSE
			DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:3 * 10 + 3
		ENDIF
		LOCAL:3++
	CASE 4, 14
		DA:(ARG:1):(ARG:2) = FLAG:현M *10000 + LOCAL:ARG * 100 + ARG
		LOCAL:ARG++
	CASE 5, 6, 7, 8
		DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:ARG * 10 + ARG
		LOCAL:ARG++
	CASE 9
ENDSELECT

;タイル破棄
IF DA:(ARG:1):(ARG:2) % 100 == 4
	VARI EVENT_ID = DA:(ARG:1):(ARG:2) / 100 % 100
	SELECTCASE FLAG:현M
		CASE 0
			SELECTCASE EVENT_ID
				CASE 0
					SIF FLAG_D100_玄関イベント済み
						CALL CLEAR_TILE, ARG:1, ARG:2
			ENDSELECT
		CASE 1
			SELECTCASE EVENT_ID
				CASE 0
					SIF FLAG_D100_3F階段前会話
						CALL CLEAR_TILE, ARG:1, ARG:2
				CASE 1
					SIF FLAG_D100_崩れた壁
						CALL CLEAR_TILE, ARG:1, ARG:2
				CASE 2
					SIF FLAG_D100_風紀委員
						CALL CLEAR_TILE, ARG:1, ARG:2
				CASE 3
					SIF FLAG_D100_2F教室会話
						CALL CLEAR_TILE, ARG:1, ARG:2
			ENDSELECT
		CASE 2
			SELECTCASE EVENT_ID
				CASE 0
					SIF FLAG_D100_3F廊下会話
						CALL CLEAR_TILE, ARG:1, ARG:2
				CASE 3
					SIF !FLAG_D100_ボス部屋
						CALL CLEAR_TILE, ARG:1, ARG:2
				CASE 4
					SIF FLAG_D100_ボス部屋
						CALL CLEAR_TILE, ARG:1, ARG:2
			ENDSELECT
	ENDSELECT
ENDIF
SIF DA:(ARG:1):(ARG:2) % 100 == 12 && FLAG_D100_ボス部屋
	CALL CLEAR_TILE, ARG:1, ARG:2

