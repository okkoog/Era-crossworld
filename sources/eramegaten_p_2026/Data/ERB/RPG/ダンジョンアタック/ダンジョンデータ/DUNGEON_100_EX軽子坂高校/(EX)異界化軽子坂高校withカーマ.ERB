@JOIN_REIKO_D100
#DIM DYNAMIC L_REIKO
#DIM DYNAMIC L_POS
SIF FINDCHARA_B([[キャラ:레이코]]) == 2
	RETURN 0
L_REIKO = RESULT:1
;空きポジションを確認
FOR L_POS, 1, 7
	SIF POS(L_POS) >= 0
		CONTINUE
	CALL INSERT_POSITION, L_POS, L_REIKO
	RETURN 1
NEXT
;送還できる仲間を探す
FOR L_POS, 1, 7
	SIF POS(L_POS) == MASTER
		CONTINUE
	SIF !GET_ROLE_PROP("CAN_PUT_IN_COMP", POS(L_POS))
		CONTINUE
	SIF CFLAG:POS(L_POS):소속ＣＯＭＰ != 0
		CONTINUE
	CALL INSERT_POSITION, L_POS, L_REIKO
	RETURN 1
NEXT
DRAWLINE
PRINTL 레이코 대신 귀환시킬 동료마를 선택해 주십시오
DRAWLINE
VARI L_LINE = LINECOUNT
WHILE CFLAG:L_REIKO:PT플래그 < 2
	CLEARLINE LINECOUNT - L_LINE
	CALL SHOW_NOW_FORMATION_P,0,2,0
	CALL INPUTINT, 1, 2, 3, 4, 5, 6
	IF POS(RESULT) == MASTER || NO:POS(RESULT) == [[キャラ:카마마라]]
		FLAG:윈도우메시지스킵 = 0
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "", "", @"＞%CALLNAME:POS(RESULT)%은(는) 파티에서 제외할 수 없다。"
	ELSE
		CALL INSERT_POSITION, RESULT, L_REIKO
	ENDIF
WEND

