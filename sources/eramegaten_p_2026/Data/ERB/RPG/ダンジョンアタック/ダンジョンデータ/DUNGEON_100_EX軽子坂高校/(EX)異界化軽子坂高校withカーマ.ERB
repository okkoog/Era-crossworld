									FLAG_D100_保険医会話 = 1
									RETURN 1
								CASE 1
									IF !IS_ENTER
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "", "양호교사", "너희들、악마와 싸우는 거지。/이거、얼마 안 되지만 가져가렴"
										CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "", "", "＞상처약 2개와 마석을 받았다"
										CALL GET_ITEMS, "외상약", 2
										CALL GET_ITEMS, "마석"
