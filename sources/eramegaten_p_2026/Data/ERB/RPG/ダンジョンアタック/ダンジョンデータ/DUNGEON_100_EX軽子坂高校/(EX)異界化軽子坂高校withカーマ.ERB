	CASE 3
		VARI TRESURE_ID = DA:(FLAG:현X):(FLAG:현Y) % 1000 / 10
		SELECTCASE DA:(FLAG:현X):(FLAG:현Y)
			CASE 3
				CALL GETS_TREASURE, "외상약", 3, FLAG:현던전, FLAG:현M+70, TRESURE_ID
			CASE 13
				CALL GETS_TREASURE, "나프가드", 1, FLAG:현던전, FLAG:현M+70, TRESURE_ID
			CASE 23
				CALL GETS_TREASURE, "약장탄", 20, FLAG:현던전, FLAG:현M+70, TRESURE_ID
			CASE 1003
				CALL GETS_TREASURE, "마석", 2, FLAG:현던전, FLAG:현M+70, TRESURE_ID
			CASE 1013
				CALL GETS_TREASURE, "재밍암", 1, FLAG:현던전, FLAG:현M+70, TRESURE_ID
			CASE 2003
				CALL GETS_TREASURE, "카이저아머", 1, FLAG:현던전, FLAG:현M+70, TRESURE_ID
			CASE 2013
				CALL GETS_TREASURE, "은의마니샤", 1, FLAG:현던전, FLAG:현M+70, TRESURE_ID
			CASE 2023
				CALL GETS_TREASURE, "야마타노드링크", 1, FLAG:현던전, FLAG:현M+70, TRESURE_ID
		ENDSELECT
	CASE 4
