						CALL SET_ENEMY,8,[[キャラ:사자가면]], 18,0,0,1
						CALL SET_ENEMY,10,[[キャラ:전갈가면]], 18,0,0,1
						CALL SET_ENEMY,11,[[キャラ:물병가면]], 18,0,0,1
					;4色2列 10%
					CASE IS < 95
						CALL SET_ENEMY,8, [[キャラ:황소가면]], 18,0,0,1
						CALL SET_ENEMY,10, [[キャラ:사자가면]], 18,0,0,1
						CALL SET_ENEMY,13, [[キャラ:전갈가면]], 18,0,0,1
						CALL SET_ENEMY,15, [[キャラ:물병가면]], 18,0,0,1
					;4色2列B 5%
					CASE IS < 100
						CALL SET_ENEMY,7,[[キャラ:황소가면]], 18,0,0,1
						CALL SET_ENEMY,8,[[キャラ:황소가면]], 18,0,0,1
						CALL SET_ENEMY,10,[[キャラ:사자가면]], 18,0,0,1
						CALL SET_ENEMY,11,[[キャラ:사자가면]], 18,0,0,1
						CALL SET_ENEMY,12,[[キャラ:전갈가면]], 18,0,0,1
						CALL SET_ENEMY,13,[[キャラ:전갈가면]], 18,0,0,1
						CALL SET_ENEMY,15,[[キャラ:물병가면]], 18,0,0,1
						CALL SET_ENEMY,16,[[キャラ:물병가면]], 18,0,0,1
				ENDSELECT
		ENDSELECT
	ENDIF
	RETURN 1
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
