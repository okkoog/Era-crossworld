;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_51
SELECTCASE FLAG:현M
	;１Fは敵がでない
	CASE 0
		FLAG:인카운트율 = 0
	;１F奥から敵出現開始,悪魔出現フラグがたってない場合、エンカウントが少ない
	CASEELSE
		FLAG:인카운트율 = FLAG:미조우걸음수 * 5
ENDSELECT
SIF FLAG:미조우걸음수 < 5
	FLAG:인카운트율 = 0
;=======================================================================
;必要レベル目安
;推奨LV 雑魚最低LV 雑魚最高LV ボスLV 
;=======================================================================
@GET_DUNGEON_LV_51
RETURN 19, 16, 20, 24
;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_51
#LOCALSIZE 10
IF RAND:100 < FLAG:인카운트율
	IF RAND:2
		;一色目
		LOCAL:4 = RAND:4 + [[キャラ:황소가면]]
		$CHANGE_KAMEN
		;ニ色目
		LOCAL:5 = RAND:4 + [[キャラ:황소가면]]
		SIF LOCAL:4 == LOCAL:5
			GOTO CHANGE_KAMEN
		LOCAL:6 = [[キャラ:황소가면]] + RAND:2
		;後衛タイプ
		LOCAL:7 = RAND:2 + [[キャラ:전갈가면]]
		SELECTCASE FLAG:현M
			CASE 1
				SELECTCASE RAND:100
					;同色1列 30%
					CASE IS < 30
						CALL SET_ENEMY,8,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,9,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,10,LOCAL:4, 18,0,0,1
					;2色1列 30%
					CASE IS < 60
						CALL SET_ENEMY,8,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,9,LOCAL:5, 18,0,0,1
						CALL SET_ENEMY,10,LOCAL:4, 18,0,0,1
					;同色2列 20%
					CASE IS < 80
						CALL SET_ENEMY,8,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,10,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,13,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,15,LOCAL:4, 18,0,0,1
					;2色2列 20%
					CASE IS < 100
						CALL SET_ENEMY,8,LOCAL:6, 18,0,0,1
						CALL SET_ENEMY,10,LOCAL:6, 18,0,0,1
						CALL SET_ENEMY,13,LOCAL:7, 18,0,0,1
						CALL SET_ENEMY,15,LOCAL:7, 18,0,0,1
				ENDSELECT
			CASE 2, 3
				SELECTCASE RAND:100
					;同色1列 20%
					CASE IS < 20
						CALL SET_ENEMY,7,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,8,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,10,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,11,LOCAL:4, 18,0,0,1
					;2色1列 20%
					CASE IS < 40
						CALL SET_ENEMY,7,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,8,LOCAL:5, 18,0,0,1
						CALL SET_ENEMY,10,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,11,LOCAL:5, 18,0,0,1
					;同色2列 20%
					CASE IS < 60
						CALL SET_ENEMY,8,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,10,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,13,LOCAL:4, 18,0,0,1
						CALL SET_ENEMY,15,LOCAL:4, 18,0,0,1
					;2色2列 20%
					CASE IS < 80
						CALL SET_ENEMY,8,LOCAL:6, 18,0,0,1
						CALL SET_ENEMY,10,LOCAL:6, 18,0,0,1
						CALL SET_ENEMY,13,LOCAL:7, 18,0,0,1
						CALL SET_ENEMY,15,LOCAL:7, 18,0,0,1
					;4色1列 10%
