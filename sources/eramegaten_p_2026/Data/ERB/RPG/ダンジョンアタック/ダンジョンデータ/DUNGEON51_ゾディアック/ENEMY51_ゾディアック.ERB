						CALL SET_ENEMY,9,LOCAL:6, 18,0,0,1
						CALL SET_ENEMY,10,LOCAL:6, 18,0,0,1
						CALL SET_ENEMY,13,LOCAL:7, 18,0,0,1
						CALL SET_ENEMY,14,LOCAL:7, 18,0,0,1
						CALL SET_ENEMY,15,LOCAL:7, 18,0,0,1
					;4色1列 10%
					CASE IS < 85
