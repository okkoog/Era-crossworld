;仮面党員共通思考パターン
@SET_ACTION_KAMEN(ARG)
#DIM LCOUNT
;イシュキック不在
IF POS(9) == -1
	IF  CFLAG:ARG:포지션 >= 12
		CFLAG:ARG:입력행동 = -1
		CFLAG:ARG:방어플래그 = 1
	ELSE
		CFLAG:ARG:입력행동 = 0
		CALL RANDOM_TARGET,ARG,0
	ENDIF
	RETURN 3
ENDIF

;ターンに1回のみ
IF LOCAL:99 == FLAG:경과턴수
	LOCAL:99 += 1
	;健在な仮面党員をチェックしていく
	LOCAL = 0
	FOR LCOUNT,77,87
		;イシュキックは除外
		SIF LCOUNT == 79
			CONTINUE
		SIF FLAG:LCOUNT == -1
			CONTINUE
		LOCAL += 1
		LOCAL:(LOCAL) = FLAG:LCOUNT
	NEXT
	;健在な仮面党員をシャッフルしつつ、余った枠を整理
	FOR LCOUNT,1,10
		IF LCOUNT <= LOCAL
			SWAP LOCAL:LCOUNT,LOCAL:(RAND:LOCAL+1)
		ELSE
			LOCAL:LCOUNT = 0
		ENDIF
	NEXT
ENDIF
;経過ターン/2＋2人が魔法攻撃をしてくる
LOCAL:20 = (FLAG:경과턴수)/2 + 2
FOR LCOUNT,1,LOCAL
	IF LOCAL:LCOUNT == ARG
		IF LCOUNT <= LOCAL:20
			;単体魔法
			IF LCOUNT % 2
				RETURN 1
			;範囲魔法
			ELSE
				RETURN 2
			ENDIF
		ELSE
			BREAK
		ENDIF
	ENDIF
NEXT
RETURN 0

;レイディの思考パターン
;アクエスを撃った場合、対象の水撃の相性を学習する。
;学習後は相性悪い相手にアクエスをうたなくなり、ターゲットを振り変える
;相性がいい相手が発覚してる場合に、アクエスが選択された場合はその相手にタゲ確定
;弱点もちは出してるとあっさり死亡まで持って行かれる…のはまぁそんなやらないとしても
;耐性持ちを増やすとその分、耐性持ってないキャラにアクエスが多くいくので注意か
;とくにHP600未満からは、マハアクエスはあんまり連打しないように調整されてるマハアクエスが行動回数に関わらず出てくるので注意
;
;デバッグの感触だと、火弱点は割と致命的というか、COOP連打しやすい部類にはいるんで、脆さが目立つ
;Lv20強から、エルフ・ユキジョロウ・ウンディーネが作れるんでそこまでいけば割と楽勝感
@SET_ACTION_レイディ, ARG
#DIM LCOUNT
#LOCALSIZE 300
;フラグ初期化
IF LOCAL:9 == 0
	VARSET LOCAL,-1
	LOCAL:1 = 0
	LOCAL:2 = 0
ENDIF
LOCAL = RAND:100
;ターン限定攻撃、というか、マハアクエスとディアラマの回数制御
IF CFLAG:ARG:행동한횟수 == 0
	IF BASE:ARG:ＨＰ <= 1500 && LOCAL < 50
		;ＨＰ1500を割ってからは初回行動でディアラマを使い出す
		CALL CHECK_ACTIONABLE,ARG,402
		SIF RESULT == 0
			GOTO DECIDE_ACTION
		CFLAG:ARG:입력행동 = 402
		CALL RANDOM_TARGET,ARG,402
		RETURN 0
	ENDIF
ELSEIF CFLAG:ARG:행동한횟수 == 2
	;20%でマハアクエス,ＨＰ1200を割った段階で30％に
	IF LOCAL < 20 || (BASE:ARG:ＨＰ <= 1200 && LOCAL < 30)
		CALL CHECK_ACTIONABLE,ARG,1605
		SIF RESULT == 0
			GOTO DECIDE_ACTION
		CFLAG:ARG:입력행동 = 1605
		CALL RANDOM_TARGET,ARG,1605
		RETURN 0
	;10%で暗黒マハアクエス、HP1200を割った段階で15％
	ELSEIF LOCAL < 30 || (BASE:ARG:ＨＰ <= 1200 && LOCAL < 50)
		CALL CHECK_ACTIONABLE, ARG,
		SIF RESULT == 0
			GOTO DECIDE_ACTION
		CFLAG:ARG:입력행동 = [[스킬:암흑마하・아쿠에스]]
		CALL RANDOM_TARGET,ARG, [[스킬:암흑마하・아쿠에스]]
		RETURN 0
	ENDIF
ENDIF
;アクエスのチェンジ回数を初期化
LOCAL:6 = -1
;以下単体攻撃
$DECIDE_ACTION
LOCAL = RAND:100
;攻撃対象のNOを先にとっておく
;1/4の確率で最もHP低い敵を狙いに行く
IF RAND:4 == 0
	LOCAL:7 = -1
	LOCAL:4 = 1
	FOR LCOUNT,1,7
		IF POS(LCOUNT) >= 0 && GET_STATE(CFLAG:(POS(LCOUNT)):상태이상) != "DYING"
			IF LOCAL:7 == -1
				LOCAL:7 = BASE:(POS(LCOUNT)):ＨＰ
				LOCAL:4 = LCOUNT
			ENDIF
			IF BASE:(POS(LCOUNT)):ＨＰ <= LOCAL:7
				 LOCAL:7 = BASE:(POS(LCOUNT)):ＨＰ
				 LOCAL:4 = LCOUNT
			ENDIF
		ENDIF
	NEXT
	CFLAG:ARG:타겟 = LOCAL:4
ELSE
	CALL RANDOM_TARGET,ARG
ENDIF
;対象のキャラ番号をLOCAL:5にいれておく
LOCAL:5 = FLAG:(CFLAG:ARG:타겟+70)
;20％の確率でマリンカリン
IF LOCAL < 20
	;対象が魅了状態の場合、マリンカリンをやめる
	SIF GET_STATE(CFLAG:(LOCAL:5):상태이상) == "CHARM"	
		GOTO DECIDE_ACTION
	CALL CHECK_ACTIONABLE,ARG,1211
	SIF RESULT == 0
		GOTO DECIDE_ACTION
	CFLAG:ARG:입력행동 = 1211
;40％の確率でアクエス
ELSEIF ((LOCAL < 60 && BASE:ARG:ＨＰ >= 600) || (LOCAL < 50 && BASE:ARG:ＨＰ <= 600)) && LOCAL:6 < 10
	;水撃弱点の相手を覚えている場合、アクエスはその相手を狙う。
	LOCAL:8 = 0
	FOR LCOUNT,0,LOCAL:2
		IF CFLAG:(LOCAL:(LCOUNT+30)):포지션 && GET_STATE(CFLAG:(LOCAL:(LCOUNT+30)):상태이상) != "DYING"
			CFLAG:ARG:타겟 = CFLAG:(LOCAL:(LCOUNT+30)):포지션
			LOCAL:5 = FLAG:(CFLAG:ARG:타겟+70)
			LOCAL:8 = 1
		ENDIF
	NEXT
	$CHANGE_TARGET
	;チェンジ回数記録
	LOCAL:6 += 1
	IF LOCAL:6 > 0
		;味方6人のキャラナンバーを取得する
		FOR LCOUNT,71,77
			LOCAL:LCOUNT = FLAG:LCOUNT
		NEXT
		;登録した配列をシャッフルする（こうすることで次の探査で最初にひっかかるキャラがランダムになる）
		FOR LCOUNT,71,77
			SWAP LOCAL:LCOUNT,LOCAL:(RAND:6 + 71)
		NEXT
		FOR LCOUNT,71,77
			;生きてて、水撃が効く相手をさがす
			IF LOCAL:LCOUNT >= 0 && MAXBASE:(LOCAL:LCOUNT):수격 >= 100 && MAXBASE:(LOCAL:LCOUNT):수격 < 999 && GET_STATE(CFLAG:(LOCAL:LCOUNT):상태이상) != "DYING"
				CFLAG:ARG:타겟 = CFLAG:(LOCAL:LCOUNT):포지션
				LOCAL:5 = FLAG:(CFLAG:ARG:타겟+70)
				BREAK
			ENDIF
		NEXT
	ENDIF
	;対象が魅了状態の場合、2/3の確率で行動を選定しなおす
	IF GET_STATE(CFLAG:(LOCAL:5):상태이상) == "CHARM" && RAND:3 >= 1	
		GOTO DECIDE_ACTION
	ENDIF
	CALL CHECK_ACTIONABLE,ARG,1602
	SIF RESULT == 0
		GOTO DECIDE_ACTION
	CFLAG:ARG:입력행동 = 1602
	;水撃が効かない相手をアクエスを1回打ち込んだら覚えて、次からは撃たなくなる
	IF MAXBASE:(LOCAL:5):수격 <= 75 || MAXBASE:(LOCAL:5):수격 == 999
		FOR LCOUNT,0,LOCAL:1
			IF LOCAL:5 == LOCAL:(10+LCOUNT)
				;10回チェンジしたらアクエスを諦める
				IF LOCAL:6 < 10
					GOTO CHANGE_TARGET
				ELSE
					GOTO DECIDE_ACTION
				ENDIF
			ENDIF
		NEXT
		IF LOCAL:1 < 20
			LOCAL:(10 + LOCAL:1) = LOCAL:5
			LOCAL:1 += 1
		ENDIF
	;水撃弱点の相手を覚える
	ELSEIF MAXBASE:(LOCAL:5):수격 > 100 && LOCAL:8 == 0
		LOCAL:(30+LOCAL:2) = LOCAL:5
		LOCAL:2 += 1
	ENDIF
;HP600未満からは20％の確率でマハアクエス
ELSEIF LOCAL < 70 && BASE:ARG:ＨＰ <= 600
	CALL CHECK_ACTIONABLE,ARG,1605
	SIF RESULT == 0
		GOTO DECIDE_ACTION
	CFLAG:ARG:입력행동 = 1605
	CALL RANDOM_TARGET,ARG,1605
;40％の確率で打撃
ELSE
	;対象が魅了状態の場合、2/3の確率で行動を選定しなおす
	SIF GET_STATE(CFLAG:(LOCAL:5):상태이상) == "CHARM" && RAND:3 >= 1	
		GOTO DECIDE_ACTION
	CFLAG:ARG:입력행동 = 0
ENDIF
LOCAL:6 = -1


;=======================================================================
;輪姦参加悪魔
