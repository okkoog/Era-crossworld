;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_24
IF ダンジョンフラグ:24:1 == 0
	CALL SHOW_PICTURE, "NONFLOORD"
	CALL MESSAGE_WINDOW_D, "", @"＞이계로 변한 도서관의 조사 의뢰를 %MASTER는% 받았다/＞원인을 시급하게 규명해 원래의 도서관으로 되돌리지 않으면 안된다%\@BASE:MASTER:LV < 10?/＞마요네는 간단한 의뢰라고 말했지만 방심은 할 수 없다#\@%"
	ダンジョンフラグ:24:1 = 1
ENDIF

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_24,ARG,ARG:1
IF DA:ARG:(ARG:1) == 12
	IF ダンジョンフラグ:24:12 >= 9
		CALL MESSAGE_WINDOW_D, "", "＞문 너머에서 사악한 기운이 느껴진다/＞문을 열까？"
		CALL INPUT_YN_D
		SIF RESULT == 1
			RETURN 0
	ELSE
		CALL MESSAGE_WINDOW_D, "", "＞문은 수수께끼의 힘으로 닫혀 있다"
		RETURN 0
	ENDIF
ELSEIF DA:ARG:(ARG:1) == 22 && ダンジョンフラグ:24:12 >= 9
	CALL MESSAGE_WINDOW_D, "", "＞문은 수수께끼의 힘으로 닫혀 있다"
	RETURN 0
ENDIF
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

