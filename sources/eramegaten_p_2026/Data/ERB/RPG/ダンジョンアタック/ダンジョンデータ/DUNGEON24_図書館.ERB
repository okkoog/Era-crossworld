@GET_DUNGEON_LV_24
RETURN 7, 4, 14, 22

;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_24
IF RAND:100 < FLAG:인카운트율
	RETURN 1
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF
