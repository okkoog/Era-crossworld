@SET_BOSS_ENEMY_DUNGEON_64, L_ENEMY_NAME, L_NO = -1, L_OPT
#DIM DYNAMIC L_NO
#DIM DYNAMIC L_ENEMY
#DIMS DYNAMIC L_ENEMY_NAME
#DIMS DYNAMIC L_OPT
#DIMS DYNAMIC L_ENEMY_TABLE, 10

L_ENEMY_TABLE:0 '= "刹那"
L_ENEMY_TABLE:1 '= "未来"

IF L_NO >= 0
	SIF !INRANGE(L_NO, 0, VARSIZE("L_ENEMY_TABLE") - 1)
		RETURN 0
	L_ENEMY_NAME '= L_ENEMY_TABLE:L_NO
ENDIF
IF L_OPT == "名称取得"
	SIF L_ENEMY_TABLE:L_NO == ""
		RETURN 0
	RESULTS '= L_ENEMY_NAME
	RETURN 1
ENDIF

SELECTCASE L_ENEMY_NAME
	CASE "刹那"
		TSTR:전투이벤트패턴 = デビチル_セントラルランド_刹那
		;vs.刹那
		;ラスダンの中ボスなので、それなりの強化を行う
		;基本はスキルを上位のものにした（今更羽ばたきとか使わないで欲しい……）
		;クールベールのスキルだけガチ、刹那未来のAIだけ真面目

		;死体が残るようにしておく（特に意味はないが）
		CALL SET_ENEMY,14,[[キャラ:세츠나]],58,1,1
		L_ENEMY = CHARANUM-1
		CALL SET_ENEMY_TIMEID, L_ENEMY, "刹那"
		CFLAG:L_ENEMY:ＨＰ보정 += 5000
		CFLAG:L_ENEMY:ＭＰ보정 += 5000
		;一時的に超人扱い、種族名は一応人間に
		ABL:L_ENEMY:종족 = 42
		CFLAG:L_ENEMY:강제악마화 = 1
		CSTR:L_ENEMY:종족명 = 인간
		CSTR:L_ENEMY:사고패턴 = デビチル_セントラルランド_刹那

		;どこぞのフツオのような「銃撃系達人」っぽいスキルラインナップ
		;アイテムも使用してくる
		;ノルンの鍵は持ってないので剣撃スキルは使用しない
		;まあAI組むので基本意味ないけど（ランダム行動の時には意味があるヨ）
		;ダイロクテンマオウ用だが全体攻撃飛具：三段撃ち
		;ベルセルク版、じゃねーやボンボン版なら「いぴかいえー、まざーふぁっかー」くらいは言う、たぶん
		;AI側で「보옥」を使用（クールベールの「メディアラハン」封印したため）
		;
		;20250217
		;調整がおおきく噛みそうなスキルを排除。またクールが生きているときは攻撃面を抑えておく
		CALL CLEAR_ALL_SKILL, L_ENEMY
		ABL:L_ENEMY:스킬1 = [[스킬:트리플다운]]
		ABL:L_ENEMY:스킬2 = [[스킬:원샷킬]]
		ABL:L_ENEMY:스킬3 = [[스킬:미들샷]]
		ABL:L_ENEMY:스킬4 = [[스킬:해피트리거]]
		ABL:L_ENEMY:스킬5 = [[스킬:전용기1]]
		ABL:L_ENEMY:스킬6 = [[스킬:전용기2]]
		CSTR:L_ENEMY:전용기1 = 攻撃指令
		CSTR:L_ENEMY:전용기2 = 攪乱指令
		CFLAG:L_ENEMY:행동횟수 = 2

		;3721.クール4
		;耐性が強いか、というと、そこまで強くはない
		;死体が残るようにしておく（特に意味はないが）
