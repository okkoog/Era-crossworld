		ABL:L_ENEMY:스킬3 = [[스킬:데들리번]]
		ABL:L_ENEMY:스킬4 = [[스킬:스파이크클로]]
		ABL:L_ENEMY:스킬5 = [[스킬:허공조격]]
		ABL:L_ENEMY:스킬6 = [[스킬:킹스톰]]
		ABL:L_ENEMY:스킬7 = [[스킬:이악물기]]
		ABL:L_ENEMY:스킬8 = [[스킬:짐승의안광]]
		ABL:L_ENEMY:스킬9 = [[스킬:포효]]
		ABL:L_ENEMY:스킬10 = [[스킬:도발]]

