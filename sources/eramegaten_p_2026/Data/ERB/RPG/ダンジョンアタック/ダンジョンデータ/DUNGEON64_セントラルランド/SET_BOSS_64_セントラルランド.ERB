		CALL CLEAR_ALL_SKILL, L_ENEMY
		ABL:L_ENEMY:스킬1 = [[스킬:트리플다운]]
		ABL:L_ENEMY:스킬2 = [[스킬:원샷킬]]
		ABL:L_ENEMY:스킬3 = [[스킬:미들샷]]
