		;大改造劇的ビフォーアフター
		;毒を吐く、とのことでベノンザッパーを追加
		ABL:L_ENEMY:스킬1 = [[스킬:트리플바이스]]
		ABL:L_ENEMY:스킬2 = [[스킬:아쿠아다인]]
		ABL:L_ENEMY:스킬3 = [[스킬:부흐다인]]
		ABL:L_ENEMY:스킬4 = [[스킬:갈다인]]
		ABL:L_ENEMY:스킬5 = [[스킬:베놈재퍼]]
		ABL:L_ENEMY:스킬6 = [[스킬:포효]]
		ABL:L_ENEMY:스킬7 = [[스킬:용해브레스]]



	CASE "未来"
