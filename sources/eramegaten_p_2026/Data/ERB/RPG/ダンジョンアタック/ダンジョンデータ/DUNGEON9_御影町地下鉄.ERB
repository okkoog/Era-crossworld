;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_9
;エコービルクリア+P1ルート未クリア+プラズマウォール消失をクリアしてない
IF ダンジョンフラグ:1:1 == 1 && ダンジョンフラグ:11:7 != 1 && イベントフラグ:24:0 == 0
	SIF ダンジョンフラグ:9:2 == 0
		ダンジョンフラグ:9:2 = DAY
	RETURN 1
ELSE
	RETURN 0
ENDIF


