;=======================================================================
;階段置き場
;=======================================================================
@UPSTARIS_9
SELECTCASE FLAG:현M
	CASE 0
		SIF FLAG:현X == 1 && FLAG:현Y == 1
			CALL DUNGEON_UPSTAIRS,1,15,11
		SIF FLAG:현X == 15 && FLAG:현Y == 7
			CALL DUNGEON_UPSTAIRS,2,0,2
	CASEELSE
ENDSELECT
RETURN 1

@DOWNSTARIS_9
SELECTCASE FLAG:현M
	CASE 1
		SIF FLAG:현X == 15 && FLAG:현Y == 11
			CALL DUNGEON_DOWNSTAIRS,0,1,1
	CASE 2
		SIF FLAG:현X == 0 && FLAG:현Y == 2
			CALL DUNGEON_DOWNSTAIRS,0,15,7
	CASEELSE
ENDSELECT
RETURN 1

;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_9
SELECTCASE FLAG:현M
	CASE 0
		FLAG:인카운트율 = FLAG:미조우걸음수*5
	CASEELSE
		FLAG:인카운트율 = FLAG:미조우걸음수*5
ENDSELECT
SIF FLAG:미조우걸음수 < 5
	FLAG:인카운트율 = 0
;=======================================================================
;必要レベル目安
;推奨LV 雑魚最低LV 雑魚最高LV ボスLV 
;=======================================================================
@GET_DUNGEON_LV_9
RETURN 15, 12, 15, 15
;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_9
IF RAND:100 < FLAG:인카운트율
	RETURN 1
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF
;=======================================================================
;敵の種族の種類数
;=======================================================================
@CLASS_NUM_9
RETURN CLASS_NUM_COMMON("初級")
;=======================================================================
;敵の総数
;ARGは出現する敵の種類です
;RAND(X, Y)はX～Y-1のうちのどれかになるRANDです
;なお、ここで帰った数字は下限を種族数、上限を10として自動的に調整されます
;=======================================================================
@ENEMY_NUM_9, ARG
RETURN ENEMY_NUM_COMMON("初級", ARG)
;=======================================================================
;敵の種類
;=======================================================================
@ENEMY_9, ARG
SELECTCASE RAND:100
	CASE IS < 10
		;10%でインプLv9（12）
		RETURN [[キャラ:임프]], 12
	CASE IS < 20
		;10%でゾンビコップLv9（12）
		RETURN [[キャラ:좀비캅]], 12
	CASE IS < 30
		;10%でナハトコボルト
		RETURN [[キャラ:나하트코볼트]], 14
	CASE IS < 40
		;10%　龍王ヤトノカミLV22 
		RETURN [[キャラ:야토노카미]], 14
	CASE IS < 55
		;15%でアチェリLv10（13）
		RETURN [[キャラ:아체리]], 13
	CASE IS < 70
		;15%でラミアLv10（13）
		RETURN [[キャラ:라미아]], 13
	CASE IS < 85
		;15%ではなこlv13
		RETURN [[キャラ:하나코]], 13
	CASE IS < 100
		;15%でドリアード(15)
		RETURN [[キャラ:드라이어드]], 15
ENDSELECT

