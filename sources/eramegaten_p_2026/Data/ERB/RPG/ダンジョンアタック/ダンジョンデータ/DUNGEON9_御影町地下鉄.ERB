;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_9
;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
	
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 6
	CALL UPSTARIS_9
	RETURN RESULT

ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 7
	CALL DOWNSTARIS_9
	RETURN RESULT


ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 9
	CALL DUNGEON_TERMINAL
	RETURN 1
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞아무것도 없는 것 같다"
	RETURN 0
ENDIF

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_9,ARG
;ARG = 進入時の向き　0の場合ワープなど
;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) == 8
	IF FLAG:현M > 0 && !ダンジョンフラグ:9:1
		CALL MESSAGE_WINDOW_D, "", "＞외부의 빛이 보이기 시작했다/＞이 앞은 결계에 갇힌 미카게쵸 내부로 이어져 있을 것이다……/＞팬텀에 미카게쵸 침입 성공의 보고를 넣자"
		CALL MESSAGE_WINDOW_D, "", @"＞아무래도 이곳의 침입에 있어서는、/＞%CALLNAME:MASTER%이 제일 먼저 도착한 것 같다/＞이제 미카게쵸와 관련된 이야기가 있으면, 이쪽으로 전해질 일이 많아질 것이다"
		ダンジョンフラグ:9:1 = 1
	ELSE
		CALL DUNGEON_EXIT
	ENDIF
	RETURN 1
;==========
;イベント床
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 1 && DA:(FLAG:현X):(FLAG:현Y) / 10 > 0
	IF FLAG:현M == 1
		SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
			CASE 1
				CALL SHOW_FORCEMOVE, "LLL", "D", , ,  "갑자기 바닥이 움직이기 시작했다！"
			CASE 2
				CALL SHOW_FORCEMOVE, "RRR", "D", , ,  "갑자기 바닥이 움직이기 시작했다！"
			CASE 3
				CALL SHOW_FORCEMOVE, "UR<2>U<2>L<3>DL<2>D<2>", "D", "", "갑자기 바닥이 움직이기 시작했다！"
			CASE 4
				CALL SHOW_FORCEMOVE, "DLLU", "D", , , "갑자기 바닥이 움직이기 시작했다！"
		ENDSELECT
	ELSE
		CALL SHOW_FORCEMOVE, "LU<3>L<2>UL<3>", "D", , , "갑자기 바닥이 움직이기 시작했다！"
	ENDIF
	RETURN 1
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 6
	CALL UPSTARIS_9
	RETURN RESULT

ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 7
	CALL DOWNSTARIS_9
	RETURN RESULT


;==========
;扉の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 2
	CALL DUNGEON_DOOR,ARG
	RETURN 1


;========================
;이벤트
;========================
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 4
	SELECTCASE FLAG:현M
		CASE 0
			IF ダンジョンフラグ:9:0 == 0
				CALL MESSAGE_WINDOW_D, "", "＞지하철 선로 위를 걸어、간신히 지하철 미카게초 역 승강장이 보이기 시작했다……/＞하지만、가는 길을 가로막고 서 있는 자가 있다"
				CALL INPUT_YN_M , "가늘고 긴 몸의 마수다" , "후드티 차림의 소녀다"
				IF RESULT == 0
					CALL MESSAGE_WINDOW_D_ICON, [[キャラ:이누가미]], "CSV", , "마수 이누가미", @"동서 통로를 봉쇄하라고 들었지만、/설마 그쪽에서 사람이 올 줄은 몰랐다/인간、어떻게 그쪽에서 들어왔지？"
					ダンジョンフラグ:9:5 = 0
				ELSE
					CALL MESSAGE_WINDOW_D_ICON, [[キャラ:이누가미]], "CSV/FACE_TS_0", "", "마수 이누가미", @"……동서 통로를 봉쇄하라는 명령을 받았지만、/설마 그쪽에서 사람이 올 줄은 몰랐네"
					CALL MESSAGE_WINDOW_D_ICON, [[キャラ:이누가미]], "CSV/FACE_TS_0", "", "마수 이누가미", @"뭐、어떻게 들어왔는지는 어찌 됐든 간에……/여기서、멈춰줘야겠어"
					ダンジョンフラグ:9:5 = 1
				ENDIF
				CALL MESSAGE_WINDOW_D, "", "＞마수 이누가미가 １체 나타났다！"
				FLAG:도주불가플래그 = 1
				FLAG:회화불능플래그 = 1
				FLAG:선제기습취소 = 1
				CALL SET_ENEMY,9,[[キャラ:이누가미]],15,0,1
				CFLAG:(CHARANUM-1):행동횟수 = 2
				CFLAG:(CHARANUM-1):ＨＰ보정 += 500
				BASE:(CHARANUM-1):힘 += 5
				IF ダンジョンフラグ:9:5 == 1
					CALL SET_BASE_[[キャラ:이누가미]], CHARANUM - 1, 1
				ENDIF
				CALL SYNC_STATUS,(CHARANUM-1)
				CALL HEALTH_CHARA,(CHARANUM-1)
				CALL BATTLE_START
				FLAG:도주불가플래그 = 0
				FLAG:회화불능플래그 = 0
				FLAG:선제기습취소 = 0
				DA:(FLAG:현X):(FLAG:현Y) = 1
				ダンジョンフラグ:9:0 = 1
				CALL SHOW_PICTURE, "D"
				IF ダンジョンフラグ:9:5 == 1
					CALL MESSAGE_WINDOW_D_ICON, [[キャラ:이누가미]], "CSV/FACE_TS_0", "", "마수 이누가미", @"큭……"
					CALL MESSAGE_WINDOW_D_ICON, [[キャラ:이누가미]], "CSV", , "마수 이누가미", @"……여기는、물러설 수밖에 없나"
					CALL MESSAGE_WINDOW_D, "", "＞인외의 소녀는 그 모습을 바꾸어、동쪽으로 날아가 버렸다/＞하지만 부상을 입은 채로는、그리 멀리까지 도망치지 못할 것이다"
				ENDIF
				CALL MESSAGE_WINDOW_D, "", "＞마수 이누가미를 토벌함으로써、미카게초로의 침입이 가능해졌다"
				CALL MESSAGE_WINDOW_D, "", "＞자리를 뜨려 하자 시야 한구석에 피어스를 한 남자 고등학생이 쓰러져 있는 것을 깨달았다"
				CALL MESSAGE_WINDOW_D, "", "＞운 나쁘게 혼자서 이누가미와 조우라도 해버린 것일까……/＞교복은 피에 젖어 있지만 아직 숨은 붙어 있는 것 같다"
				CALL INPUT_YN_M , "남자라도 무언가엔 쓸 수 있겠지" , "방치한다"
				IF RESULT == 0
					CALL MESSAGE_WINDOW_D, "", "＞상처투성이인 모습을 관찰해보니 어딘가 신비로운 힘이 느껴진다/＞조금이라도 전력이 된다면……이라 생각하며 의식 없는 남학생을 회수하기로 했다"

					CALL ADD_NEW_COMPANION, [[キャラ:P1주인공]], 500
					;210304：加入時名前決定が入ってたためRESULT＝1（キャラクタ追加成功時）の中に入れる
					IF RESULT == 1
						;戦闘参加可能で加入するが、調教で戦闘参加不可能になる
						CALL SET_TALENT_PARTY_JOINABLE, GETCHARA([[キャラ:P1주인공]]), "신용"
						LOCAL = RESULT:1

						$INPUT_LOOP
						PRINTL 피어스의 소년（페르소나１주인공）의 이름을 입력해주세요
						INPUTS
						NAME:LOCAL = %RESULTS%
						PRINTL 피어스의 소년（페르소나１주인공）의 애칭을 입력해주세요
						INPUTS
						CALLNAME:LOCAL = %RESULTS%

						;タルタロス踏破指令を元に変更
						;LOCALS配列を初期化　引数なしの場合、空白が入る
						VARSET LOCALS

						;名前、愛称ともに空白の場合
						IF NAME:LOCAL == LOCALS && CALLNAME:LOCAL == LOCALS
							;漫画版
							IF RAND:4 == 0
								NAME:LOCAL = 藤堂 尚也
								CALLNAME:LOCAL = 尚也
							;ドラマCD版
							ELSEIF RAND:3 == 0
								NAME:LOCAL = 鳴海 優也
								CALLNAME:LOCAL = 優也
							;小説版
							ELSEIF RAND:2 == 0
								NAME:LOCAL = 朱雀院 慈平
								CALLNAME:LOCAL = 慈平
							;ペルソナ2罰での通称
							ELSE
								NAME:LOCAL = ピアスの少年
								CALLNAME:LOCAL = ピアスの少年
							ENDIF
						ENDIF

						PRINTFORML 이름　%NAME:LOCAL%
						PRINTFORML 애칭　%CALLNAME:LOCAL%
						PRINTL 이걸로 괜찮으시겠습니까？
						CALL INPUT_YN
						SIF RESULT == 1
							GOTO INPUT_LOOP
					ENDIF

				ELSE
					CALL MESSAGE_WINDOW_D, "", "＞남학생을 그 자리에 방치하고 떠났다"
				ENDIF
			ENDIF
		CASE 2
			IF FLAG:현X == 1 && FLAG:현Y == 11 && ダンジョンフラグ:9:5 == 1
				CALL MESSAGE_WINDOW_D, "", "＞상처 입은 마수가 통로 구석에 웅크리고 있다/＞조금 전、지하철역 승강장에서 싸웠던 이누가미일 것이다"
				CALL MESSAGE_WINDOW_D_ICON, [[キャラ:이누가미]], "CSV", , "마수 이누가미", @"……크윽、여기까지 쫓아온 건가"
				CALL INPUT_YN_M , "붙잡는다" , "눈감아 준다"
				IF RESULT == 0
					CALL MESSAGE_WINDOW_D, "", "＞소녀의 모습으로 변신할 수 있는 마수에게 매력을 느끼는 호사가들은 제법 있다/＞이용 가치가 있는 악마를、뻔히 눈앞에서 놓아줄 이유도 없다……/＞당신은 이누가미를 붙잡기로 했다"
					CALL ADD_NEW_COMPANION,[[キャラ:이누가미]],50, 1, 0, 0, 15
					IF RESULT:1 > 0
						ダンジョンフラグ:9:5 = 2
						DA:(FLAG:현X):(FLAG:현Y) = 1
					ENDIF
				ELSE
					CALL MESSAGE_WINDOW_D, "", "＞마수를 그 자리에 방치하고 떠났다"
				ENDIF
			ENDIF
		CASEELSE
	ENDSELECT
	IF FLAG:현M == 0 && FLAG:현X == 8 && FLAG:현Y == 3
		SIF !GETS_USEABLE_EXTRA_TITLE("都市伝説")
			RETURN 0
