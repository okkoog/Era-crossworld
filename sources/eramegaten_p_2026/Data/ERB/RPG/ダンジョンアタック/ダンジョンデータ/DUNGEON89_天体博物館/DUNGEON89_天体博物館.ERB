		CASE 3
			CALL SHOW_FORCEMOVE, "D", "D", , ,  "下りのエスカレーターだ/こちらからは上ることはできない……"
		CASE 4
			CALL SHOW_FORCEMOVE, "UU", "D", , ,  "上りのエスカレーターだ……"
			
		;２Ｆイベント
		CASE 100
