;=======================================================================
;宝箱の中身
;=======================================================================
@TREASURE_89
#LOCALSIZE 3
;宝箱のフラグ管理用変数の番号
LOCAL = FLAG:현M + 70
;そのマップの何番目の宝箱か
LOCAL:1 = (DA:(FLAG:현X):(FLAG:현Y) / 10) % 100

;/10はIDを10で割る。つまり、下一桁をなくして、二桁目と三桁目を二桁の数字として取り出している
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
	;マップ番号*100+そのマップで何番目の宝箱かを示す数値でどの宝箱かを判別します。
	;例えば0の場合、0版のマップの0番目の宝箱であることを表しています。
	;２Ｆ
	CASE 100
		CALL GET_TREASURE_MAG, , 1000 , FLAG:현던전, LOCAL , LOCAL:1
	;３Ｆ
	CASE 200
		CALL GETS_TREASURE, "힘의향" , 1 , FLAG:현던전, LOCAL , LOCAL:1
	CASE 201
		CALL GETS_TREASURE, "챠크라포트" , 1 , FLAG:현던전, LOCAL , LOCAL:1
ENDSELECT
RETURN 1



