;=======================================================================
;攻略開始時のイベント
;=======================================================================
@EVENT_DUNGEON_START_89

;ネミッサ加入しているとダンジョン内のイベントが消える。
;あなたがクリア後でもネミッサが加入すると他人に殺されていたので修正
IF 闘技場フラグ:6:0 == 1 && !ダンジョンフラグ:89:1 < 1
	;クリア状態、他人がクリアへ
	ダンジョンフラグ:89:1 = 4
ENDIF

;カギの場所
;ネミッサ加入しているか天体博物館クリア状態他人で扉開いてない
IF (闘技場フラグ:6:0 == 1 || ダンジョンフラグ:89:1 == 4) && ダンジョンフラグ:89:6 == 0
	;扉開錠フラグ開けたへ
	ダンジョンフラグ:89:6 = 1
;カギフラグ未設定かつクリアフラグ立ってないで扉開いてない
ELSEIF ダンジョンフラグ:89:2 == 0 && ダンジョンフラグ:89:1 == 0 && ダンジョンフラグ:89:6 == 0
	IF RAND:3 == 0
		;カギの場所おひつじ座へ
		ダンジョンフラグ:89:2 = 1
	ELSEIF RAND:2 == 0
		;カギの場所かに座へ
		ダンジョンフラグ:89:2 = 2
	ELSE
		;カギの場所やぎ座へ
		ダンジョンフラグ:89:2 = 3
	ENDIF
ENDIF

;=======================================================================
;脱出時のイベント
;=======================================================================
@EVENT_DUNGEON_END_89
PRINTFORML 　

;ダンジョン脱出時、報酬フラグ貰い待ちだと賞金と名声を得ます。
IF ダンジョンフラグ:89:5 == 1
	PRINTFORML 　
	;クリア状態始末クリア
	IF ダンジョンフラグ:89:1 == 1 
		PRINTFORMW 지령의 완료와 조직에 대한 충성을 인정받아、계좌에 ￥40000이 지급、명성 20을 얻었다
		
		MONEY += 40000
		FLAG:명성 += 20
	;クリア状態部下クリア
	ELSEIF ダンジョンフラグ:89:1 == 2
		PRINTFORMW 지령을 완료하여、계좌에 ￥10000이 지급、명성 20을 얻었다
		
		MONEY += 10000
		FLAG:명성 += 20
	;クリア状態解放クリア
	ELSEIF ダンジョンフラグ:89:1 == 3
		PRINTFORMW 지령을 완료하여、계좌에 ￥10000이 지급、명성 30을 얻었다
		
		MONEY += 10000
		FLAG:명성 += 30
	ENDIF
	
	
	;報酬フラグ貰ったへ
	ダンジョンフラグ:89:5 = 2
	;依頼終了
	依頼フラグ:[[依頼:구성원탐색]]:0 = 2
ENDIF

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_89, ARG, ARG:1
;SELECTCASE DA:ARG:(ARG:1)
;ENDSELECT

;カギ持ってない、扉開けてない
IF FLAG:현M == 2 && ARG == 6 && ARG:1 == 6 && ダンジョンフラグ:89:2 < 4 && ダンジョンフラグ:89:6 == 0
	PRINTFORMW 문은 잠겨있다……
	RETURN 0
;カギ持ってる、扉開けてない
ELSEIF FLAG:현M == 2 && ARG == 6 && ARG:1 == 6 && ダンジョンフラグ:89:2 == 4 && ダンジョンフラグ:89:6 == 0
	PRINTFORMW 가지고 있던 열쇠로 문을 열었다……
	;扉開錠フラグ開けたへ
	ダンジョンフラグ:89:6 = 1
	RETURN 0
ENDIF

CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

