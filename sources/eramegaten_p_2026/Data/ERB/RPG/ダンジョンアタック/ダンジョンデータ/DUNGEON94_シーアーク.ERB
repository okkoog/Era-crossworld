;=======================================================================
;輪姦参加悪魔
;=======================================================================
@DUNGEON_RAPE_DEVIL_94
;ランダムにどの悪魔が出るか決定
;RETURN CSV番号 , 人数 , レベル
SELECTCASE RAND:3
	CASE 0
		RETURN [[キャラ:아귀]] , 3 + RAND:10 , CSVBASE([[キャラ:아귀]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 1
		RETURN [[キャラ:코볼트]] , 3 + RAND:10 , CSVBASE([[キャラ:코볼트]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 2
		RETURN [[キャラ:좀비군]] , 3 + RAND:10 , CSVBASE([[キャラ:좀비군]] , GETNUM(BASE , "LV") , 0) + RAND:3
ENDSELECT

;=======================================================================
;敵の出現可否
;ARG	敵のNO
;ARG:1	敵のランク(1=17)
;=======================================================================
@CAN_ENCOUNT_SEA_ARCH, ARG, ARG:1
#FUNCTION
;- 悪魔出現能力判定部 -------------------------------------------------------------------------

;CSVがあるか確認、なければ弾く
SIF EXISTCSV(ARG, 0) == 0
	RETURNF 0 
IF CSVCFLAG(ARG, GETNUM(CFLAG, "EXTRA출전")) > 0
	;メガテン系イベント以外不許可の場合はEX系は不許可
	SIF !GET_USEABLE_EXTRA_TITLE()
		RETURNF 0
	;オリキャラはシーアーク出現可能フラグを見る
	;また、レア悪魔として解析なしの状態からでることがあるようにする。
	IF GET_EXTRA_INGAME_NAME(CSVCFLAG(ARG, GETNUM(CFLAG, "EXTRA출전"))) == "ユーザー投稿" || GET_EXTRA_INGAME_NAME(CSVCFLAG(ARG, GETNUM(CFLAG, "EXTRA출전"))) == "EXTRA"
		SIF !CSVCFLAG(ARG, GETNUM(CFLAG, "시아크출현가능"))
			RETURNF 0
	ELSE
		;解析率がされてない悪魔は出現しない
		SIF ANALYSIS_RATE:ARG < ANALYSIS_COMPLETED
			RETURNF 0
		;EX系非人間キャラはザコ敵登場が考慮されていると思えないものが大半なので個別に出現許可がされていない場合は弾く
		SIF !CSVCFLAG(ARG, GETNUM(CFLAG, "시아크출현가능"))
			RETURNF 0
	ENDIF
ELSE
	;解析率がされてない悪魔は出現しない
	SIF ANALYSIS_RATE:ARG < ANALYSIS_COMPLETED
		RETURNF 0
ENDIF

;エンカウントしてはいけない種族は弾く。ただし、出現フラグがたてられている場合はそちらを優先する
;そのほかの合体表に入ってこないようにするための措置も貫通させる。
IF !CSVCFLAG(ARG, GETNUM(CFLAG, "시아크출현가능"))
	SIF SEA_ARCH_VALIDATE_RACE(CSVABL(ARG, GETNUM(ABL, "종족"))) == 0
		RETURNF 0
	;特殊合体のみは出さない
	SIF CSVCFLAG(ARG, GETNUM(CFLAG, "특수합체만"))
		RETURNF 0
	;合体条件有りも出さない
	SIF CSVCFLAG(ARG, GETNUM(CFLAG, "합체조건있음"))
		RETURNF 0
;- EDIT01
ENDIF
;レベルが敵ランクに合わない場合は弾く
SIF GET_SEA_ARCH_ENEMYRANK(ARG) != ARG:1
	RETURNF 0
;非戦闘員は弾く
SIF CSVTALENT(ARG, GETNUM(TALENT, "비전투원"))
	RETURNF 0
;１体のみは弾く
SIF CSVCFLAG(ARG, GETNUM(CFLAG, "１체만"))
	RETURNF 0
;全書召喚不可は弾く
SIF CSVCFLAG(ARG, GETNUM(CFLAG, "전서소환불가"))
	RETURNF 0
RETURNF 1
;=======================================================================
;ランクの取得
;表の1～8層+裏の1～8層のあわせて16層+最終層
;ARG 	NO指定
;ARG:1	キャラ指定
;=======================================================================
@GET_SEA_ARCH_ENEMYRANK, ARG, ARG:1 = -1
#FUNCTION
SELECTCASE  ARG:1 >= 0 ? BASE:(ARG:1):LV # CSVBASE(ARG, GETNUM(BASE, "LV"))
	CASE IS < 8
		RETURNF 1
	CASE IS < 12
		RETURNF 2
	CASE IS < 16
		RETURNF 3
	CASE IS < 20
		RETURNF 4
	CASE IS < 24
		RETURNF 5
	CASE IS < 28
		RETURNF 6
	CASE IS < 32
		RETURNF 7
	CASE IS < 36
		RETURNF 8
	CASE IS < 40
		RETURNF 9
	CASE IS < 44
		RETURNF 10
	CASE IS < 48
		RETURNF 11
	CASE IS < 52
		RETURNF 12
	CASE IS < 56
		RETURNF 13
	CASE IS < 60
		RETURNF 14
	CASE IS < 65
		RETURNF 15
	CASE IS < 71
		RETURNF 16
	CASEELSE
		RETURNF 17
ENDSELECT

;=======================================================================
;ランクの取得
;表の1～8層+裏の1～8層のあわせて16層+最終層
;ARG 	NO指定
;ARG:1	キャラ指定
;=======================================================================
@GET_SEA_ARCH_ENEMYMAXLV, ARG, ARG:1 = -1
#FUNCTION
SELECTCASE  ARG:1 >= 0 ? BASE:(ARG:1):LV # CSVBASE(ARG, GETNUM(BASE, "LV"))
	CASE 1
		RETURNF 7
	CASE 2 
		RETURNF 12
	CASE 3
		RETURNF 16
	CASE 4
		RETURNF 20
	CASE 5
		RETURNF 24
	CASE 6
		RETURNF 28
	CASE 7
		RETURNF 32
	CASE 8
		RETURNF 36
	CASE 9
		RETURNF 40
	CASE 10
		RETURNF 44
	CASE 11
		RETURNF 48
	CASE 12
		RETURNF 52
	CASE 13
		RETURNF 56
	CASE 14
		RETURNF 60
	CASE 15
		RETURNF 65
	CASE 16
		RETURNF 71
	CASE 17
		RETURNF 85 + (BASE:MASTER:LV > 90 && GET_SEA_ARCH_FLAG("裏フラグ")) *10
ENDSELECT
