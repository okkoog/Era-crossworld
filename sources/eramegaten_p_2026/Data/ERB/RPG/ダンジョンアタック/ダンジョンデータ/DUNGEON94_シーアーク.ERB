		RETURNF 0
ENDSELECT

@GET_SEA_ARCH_FLAG, ARGS
#FUNCTION
#DIM L_DUNGEONNUM
L_DUNGEONNUM = 94
RETURNF ダンジョンフラグ:L_DUNGEONNUM:SEA_ARCH_FLAG(ARGS)

@SET_SEA_ARCH_FLAG, ARGS, ARG, ARGS:1
#DIM L_DUNGEONNUM
L_DUNGEONNUM = 94
SELECTCASE ARGS:1
	CASE "INVERTBIT"
		INVERTBIT ダンジョンフラグ:L_DUNGEONNUM:SEA_ARCH_FLAG(ARGS), ARG
	CASEELSE
		ダンジョンフラグ:L_DUNGEONNUM:SEA_ARCH_FLAG(ARGS) = ARG
ENDSELECT
