		RETURNF 0
	CASE 39;リンク悪魔専用
		RETURNF 0
	CASE 40;페르소나전용
		RETURNF 0
	CASE 41;ペルソナ2
		RETURNF 0
	CASE 42;마인
		RETURNF 1
	CASE 43;초인
		RETURNF 0
	CASE 44;영웅
		RETURNF 0;EDIT12 MOD
		;RETURNF 1
	CASE 45;조마
