;=======================================================================
;시아크
;=======================================================================
;コンセプトは追加された悪魔を放り込むダンジョン！
;ただし今のところは特殊、条件合体悪魔と大天使など一部の悪魔は自重中です
;イベントなども作るかも？
;
;=======================================================================
;フラグ
;=======================================================================
@SEA_ARCH_FLAG, ARGS
#FUNCTION
#DIM L_DUNGEONNUM
#DIM L_EVENTNUM
L_DUNGEONNUM = 94
L_EVENTNUM = 36
SELECTCASE ARGS
	;利用可能な階数を制御する。セットはEVENTのシーアークで
	CASE "探索許可ランク"
		RETURNF 1
	;2FのNPCで、フラグが1の時敵を女のみ、2の時男のみにする。
	CASE "ダークおやじ"
		RETURNF 2
	;階段をあがってから扉を出るまでなど悪魔を出さない領域をつくるためのフラグ
	CASE "悪魔出現"
		RETURNF 3
	;EVENTのシーアークでの装備品支給のフラグ
	CASE "支給品ランク"
		RETURNF 4
	;EVENTのシーアーク用のフラグ。条件判定でこのランクを設定し、実際のイベントで探索許可フラグを付与する
	CASE "探索許可イベントランク"
		RETURNF 5
	;上記フラグと同じ
	CASE "支給品イベントランク"
		RETURNF 6
	;EVENTのシーアーク用のフラグ。イベントの判定頻度を制御するためのフラグ
	CASE "イベント確認日"
		RETURNF 7
	;探索許可ランク9以降から1FのNPCを利用して立てられるフラグ。このフラグが立っていると同じ階層でも敵が強くなる
	CASE "裏フラグ"
		RETURNF 8
	;1FのNPCを利用して立てられるフラグ。最大3種の種族を指定してエンカウント率を増加させられる
	CASE "種族ピックアップ"
		RETURNF 9
	;1FのNPCとの会話履歴
	CASE "ダークサマナー"
		RETURNF 10
	;11FのNPCとの会話履歴
	CASE "小悪魔リリス"
		RETURNF 11
	;1FのNPCとの会話履歴
	CASE "ただならぬ雰囲気の男"
		RETURNF 12
	;2FのNPCとの会話履歴
	CASE "ネコショウグン"
		RETURNF 13
	;幻想少女が出現するかどうかの判定結果を簡易的に取得しておくフラグ。
	;このフラグが立っているときに登場するNPCの台詞で幻想少女がPOPするのを正規の仕様だと示唆する
	CASE "幻想少女"
		RETURNF 14
ENDSELECT

;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_94
;이벤트『施設利用許可』の後に探索可能
SIF GET_SEA_ARCH_FLAG("探索許可ランク") > 0
	RETURN 1
RETURN 0


;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_94
#FUNCTIONS
RESULTS_F = シーアーク

;=======================================================================
;フロア名表示
;=======================================================================
@FLOORNAME_94
PRINT 시아크
SELECTCASE FLAG:현M
	CASE 0
		PRINTL １Ｆ
	CASE 1
		PRINTL ２Ｆ
	CASE 2
		PRINTL ３Ｆ
	CASE 3
		PRINTL ４Ｆ
	CASE 4
		PRINTL ５Ｆ
	CASE 5
		PRINTL ６Ｆ
	CASE 6
		PRINTL ７Ｆ
	CASE 7
		PRINTL ８Ｆ
	CASE 8
		PRINTL ９Ｆ
	CASE 9
		PRINTL １０Ｆ
	CASE 10
		PRINTL １１Ｆ
	CASEELSE
		PRINTL
ENDSELECT

;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_94,ARG
FLAG:현M = 0
FLAG:현X = 7
FLAG:현Y = 12
;CALL AUTOMAP

;=======================================================================
;攻略開始時のイベント
;=======================================================================
@EVENT_DUNGEON_START_94
#DIM DYNAMIC LCOUNT
IF GET_USEABLE_EXTRA_TITLE() && !GET_SEA_ARCH_FLAG("幻想少女")
	FOR LCOUNT, 0, CSVCHARANUM
		SIF !EXISTCSV(LCOUNT)
			CONTINUE
		SIF GET_EXTRA_INGAME_NAME(CSVCFLAG(LCOUNT, GETNUM(CFLAG,"EXTRA출전"))) != "幻想郷"
			CONTINUE
		SIF ANALYSIS_RATE:LCOUNT < ANALYSIS_COMPLETED
			CONTINUE
		CALL SET_SEA_ARCH_FLAG, "幻想少女", 1
		BREAK
	NEXT
ENDIF
;=======================================================================
;脱出時のイベント
;=======================================================================
@EVENT_DUNGEON_END_94
;ダークおやじフラグ（ダンジョンフラグ:94:2）、悪魔出現フラグ（ダンジョンフラグ:94:3）をリセット
CALL SET_SEA_ARCH_FLAG, "ダークおやじ", 0
CALL SET_SEA_ARCH_FLAG, "悪魔出現", 0
CALL SET_SEA_ARCH_FLAG, "裏フラグ", 0
CALL SET_SEA_ARCH_FLAG, "使用探索ランク", 0
CALL SET_SEA_ARCH_FLAG, "種族ピックアップ", 0
;ダンジョンフラグ:94:2 = 0
;ダンジョンフラグ:94:3 = 0

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_94,ARG,ARG:1
LOCAL:1 = 0
SELECTCASE DA:ARG:(ARG:1)
	CASE 12
		SELECTCASE FLAG:현M
			CASE 1
			;３Ｆへの階段
			;이벤트『施設利用許可２』まで探索不可
				IF FLAG:현Y < 4 && GET_SEA_ARCH_FLAG("探索許可ランク") == 1
					LOCAL:1 = 1
			;２Ｆエレベーター
			;이벤트『施設利用許可３』まで探索不可
				ELSEIF FLAG:현Y > 4 && GET_SEA_ARCH_FLAG("探索許可ランク") <= 2
					LOCAL:1 = 1
				ENDIF
			CASE 3
			;５Ｆへの階段
			;이벤트『施設利用許可４』まで探索不可
				SIF FLAG:현Y > 14 && GET_SEA_ARCH_FLAG("探索許可ランク") <= 3
					LOCAL:1 = 1
			CASE 5
			;６Ｆエレベーター
			;이벤트『施設利用許可５』まで探索不可
				IF FLAG:현Y > 8 && GET_SEA_ARCH_FLAG("探索許可ランク") <= 4
					LOCAL:1 = 1
			;７Ｆへの階段
			;이벤트『施設利用許可６』まで探索不可
				ELSEIF FLAG:현Y < 8 && GET_SEA_ARCH_FLAG("探索許可ランク") <= 5
					LOCAL:1 = 1
				ENDIF
			CASE 7
			;８Ｆエレベーター
			;이벤트『施設利用許可７』まで探索不可
				IF FLAG:현Y > 8 && GET_SEA_ARCH_FLAG("探索許可ランク") <= 6
					LOCAL:1 = 1
			;９Ｆへの階段
			;이벤트『施設利用許可８』まで探索不可
				ELSEIF FLAG:현Y < 8 && GET_SEA_ARCH_FLAG("探索許可ランク") <= 7
					LOCAL:1 = 1
				ENDIF
			CASE 9
			;１０Ｆエレベーター
			;이벤트『施設利用許可９』まで探索不可
				SIF GET_SEA_ARCH_FLAG("探索許可ランク") <= 16
					LOCAL:1 = 1
			CASE 10
			;１１Ｆエレベーター
				SIF GET_SEA_ARCH_FLAG("探索許可ランク") <= 16
					LOCAL:1 = 1
		ENDSELECT

		IF LOCAL:1 == 1
			CALL MESSAGE_WINDOW_D, "", "＞자물쇠가 잠겨있다/＞이 앞의 탐색 허가는 아직 내려지지 않은 모양이다"
			RETURN 0
			LOCAL:1 = 0
		ENDIF

ENDSELECT
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT
;=======================================================================
;タイル定義
;=======================================================================
@DEFINE_TILES_94, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "!"
		RETURN 12
	CASE "#"
		RETURN 14
	CASE "$"
		RETURN 24
	CASE "%"
		RETURN 34
	CASE "&"
		IF GET_SEA_ARCH_FLAG("幻想少女")
			RETURN 34
		ELSE
			RETURN 1
		ENDIF
ENDSELECT

;=======================================================================
;特殊タイル表示
;=======================================================================
@TILE_MARK_COMMON_94_4, ARG , ARG:1 , ARG:2
SELECTCASE ARG % 10
	CASE 4
		SETCOLOR 0x00ff00
		RESULTS = ｍ
ENDSELECT

