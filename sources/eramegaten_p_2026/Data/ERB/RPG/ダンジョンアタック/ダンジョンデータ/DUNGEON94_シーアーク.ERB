											ELSE
												CALL MESSAGE_WINDOW_D, "심상치 않은 분위기의 남자", "지금 네 녀석의 힘이라면 10층에도 들어갈 수 있겠지…/허나, 아직 그 심오함에는 도달하지 못했는가…/앞으로 조금 남았다… 정진하도록 해라…"
											ENDIF
										ELSE
											CALL MESSAGE_WINDOW_D, "심상치 않은 분위기의 남자", "10층인가…/10층은 신들과 마왕이 발호하는 땅/범인이 도달할 수 있는 장소가 아니다"
											CALL MESSAGE_WINDOW_D, "심상치 않은 분위기의 남자", "그곳에 도달할 수 있다는 것은 전설이 되었다 해도 과언이 아니지/하지만, 힘만 있다면 도달할 수 있는 장소이긴 하다/만약 그럴 마음이 있다면 정진하도록 해라…"
										ENDIF
								ENDSELECT
							ENDIF
						ENDIF
					CASE 3
						;幻想少女がでる仕様のフォロー
						CALL MESSAGE_WINDOW_D, "요정？", "엄청 호화로운 건물이라 재미있었는데 역시 질려버렸네…/뭔가 언제부턴가 인간이라든가 요괴가 어슬렁거리고 있고… 게다가 엄청 많고…/어쩐지 세상이 이상해져 버린 느낌…？"
						CALL MESSAGE_WINDOW_D, "요정？", "슬슬 환상향으로 돌아가고 싶은걸…/으~음… 한 번 쉬면 어쩌면 돌아갈 수 있으려나…？/……뭐어 아마 언젠가 어떻게든 되겠지! 됐어!"
				ENDSELECT
			CASE 1
				SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
					CASE 1
						IF GET_SEA_ARCH_FLAG("種族ピックアップ")
							CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "혹시 불러올 악마를 바꾸고 싶은 겐가？"
							CALL INPUT_SELECT_D, "불러올 악마를 바꾸시겠습니까？/[0] 네/[1] 아니오"
							IF RESULT == 1
								CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "그런가/그렇다면 됐느니라/그대의 여정에 축복이 가득하기를"
								RETURN 0
							ENDIF
						ELSE
							SELECTCASE GET_SEA_ARCH_FLAG("ネコショウグン")
								;初会話
								CASE 0
									CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "악마", "호오、그대/서머너라는 자인가？"
									CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "악마", "이 몸은 네코쇼군이라는 자/혹시 바쁘지 않다면/부탁 하나만 들어주지 않겠는가"
									CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "이 몸의 가솔들에게 포상을 내리고 싶다만/포상으로 줄 마석이 아무리 많아도 부족하구나/혹시 마석이 남는다면 조금 나누어 주지 않겠는가？"
									CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "그렇지/5개 정도 마석을 나누어 준다면/그대의 곁에 원하는 악마를 불러주겠네"
									CALL SET_SEA_ARCH_FLAG, "ネコショウグン", 1
								;会話済み+依頼未達成
								CASE 1
									CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "어떤가？/마석을 5개 나누어 줄 마음이 들었는가？"
								CASEELSE
									CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "방랑하는 서머너인가/상태는 어떠한가？"
									CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "이 몸은 여전히 마석이 부족해서 말이지/혹시 마석이 남는다면 또 악마를 불러줄 테니 5개 정도 나누어 주지 않겠는가？"
							ENDSELECT
							CALL INPUT_SELECT_D, "마석을 넘겨주시겠습니까？" + "(" + @"소지수:{ITEM:마석}" + ")" + "/[0] 네/[1] 아니오"
							IF RESULT == 0
								IF ITEM:마석 == 0
									CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "이런, 마석이 없는 모양이구려/아쉽게 되었네…"
								ELSE
									IF ITEM:마석 > 4
										CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "고맙구려/이걸로 가솔들도 기뻐할 것이네"
									ELSE
										CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "이런, 수가 부족한 모양이구려/그렇다면 이번엔 있는 것만으로도 충분하네/어쨌든 지금은 마석이 필요하니 말일세"
									ENDIF
									CALL SET_SEA_ARCH_FLAG, "ネコショウグン", 2
									ITEM:마석 = MAX(ITEM:마석 - 5, 0)
								ENDIF
							ELSE
								CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "그런가/아쉽게 되었구려"
								RETURN 0
							ENDIF
						ENDIF
						CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "그럼 불러오고 싶은 악마의 종족을/3종류까지 고르도록 하게"
						REDRAW 0
						L_LINE = LINECOUNT
						$PICKUP_START
						REDRAW 0
						CLEARLINE LINECOUNT - L_LINE
						;ダンジョンを描画
						CALL SHOW_FLOOR
						;現パーティ描画
						CALL SHOW_NOW_FORMATION_P,0,2,,"探索中"
						L_PICK = 0
						LOCAL = 0
						LOCALS = 
						L_STRLENS = 0
						CALL SET_ALIGNMENT, "CENTER"
						PRINTFORML %"┌" + ("─" * 36) + "┐"%
						FOR LCOUNT, 1, 19
							IF !GROUPMATCH(GET_RACE(LCOUNT), "머신", "정령", "어령")
								SIF LOCAL % 6 == 0
									PRINT │
								IF GETBIT(GET_SEA_ARCH_FLAG("種族ピックアップ"), LCOUNT)
									SETCOLOR COLOR("aqua")
									L_PICK++
								ENDIF
								LOCALS = [{LCOUNT,2}] %GET_RACE(LCOUNT), 6, LEFT%
								PRINTFORM %LOCALS%
								L_STRLENS += STRLENS(LOCALS)
								RESETCOLOR
								IF LOCAL % 6 == 5
									PRINTFORML %" " * (72 - L_STRLENS)%│
									L_STRLENS = 0
								ENDIF
								LOCAL++
							ENDIF
						NEXT
						IF LOCAL % 6 != 0
							PRINTFORML %" " * (72 - L_STRLENS)%│
							L_STRLENS = 0
						ENDIF
						PRINT │
						LOCALS = [ 0] 결정　
						PRINTFORM %LOCALS%
						L_STRLENS += STRLENS(LOCALS)
						;LOCALS = [99] 취소
						;PRINTFORM %LOCALS%
						;L_STRLENS += STRLENS(LOCALS)
						PRINTFORML %" " * (72 - L_STRLENS)%│
						PRINTFORML %"└" + ("─" * 36) + "┘"%
						CALL SET_ALIGNMENT, "PREV"
						INPUT
						CLEARLINE 1
						REDRAW 1
						SELECTCASE RESULT
							CASE 0
							CASE 1 TO 18
								SIF !GROUPMATCH(GET_RACE(LCOUNT), "머신", "정령", "어령") && (L_PICK < 3 || GETBIT(GET_SEA_ARCH_FLAG("種族ピックアップ"), RESULT))
									CALL SET_SEA_ARCH_FLAG, "種族ピックアップ", RESULT, "INVERTBIT"
								GOTO PICKUP_START
							CASEELSE
								GOTO PICKUP_START
						ENDSELECT
						CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "좋아, 이걸로 문제없네/그대의 곁에 고른 악마가 찾아오기 쉬워졌을 게야"
						CALL MESSAGE_WINDOW_D_ICON, [[キャラ:네코쇼군]], "CSV", , "네코쇼군", "이 몸은 아직 여기 있을 테니 또 마석을 얻게 되면/잘 부탁하네/그럼, 그대의 여정에 축복이 가득하기를"
					CASE 2
					;ダークおやじ
						IF GET_SEA_ARCH_FLAG("ダークおやじ") == 0
							CALL MESSAGE_WINDOW_D, "다크 아저씨", "거기 당신/남자 악마와만 조우해서 곤란하지는 않나？"
							CALL MESSAGE_WINDOW_D, "다크 아저씨", "내게 맡겨준다면/남자 악마가 출현하지 못하도록 해줄 수 있지"
							CALL MESSAGE_WINDOW_D, "다크 아저씨", @"물론 공짜는 아니지만 말이야/당신이라면…{GET_SEA_ARCH_FLAG("探索許可ランク")*50}마카겠군"
							CALL MESSAGE_WINDOW_D, "다크 아저씨", "어쩔 텐가？"
						ELSEIF GET_SEA_ARCH_FLAG("ダークおやじ") == 1
							CALL MESSAGE_WINDOW_D, "다크 아저씨", "여어 당신인가/여자 악마만 만나는 기분은 최고지？"
							CALL MESSAGE_WINDOW_D, "다크 아저씨", "혹시 슬슬 질렸다면/양쪽 다 나오도록 원래대로 되돌려줄 수도 있다고"
							CALL MESSAGE_WINDOW_D, "다크 아저씨", @"물론 공짜는 아니지만 말이야/당신이라면…{GET_SEA_ARCH_FLAG("探索許可ランク")*50}마카겠군"
							CALL MESSAGE_WINDOW_D, "다크 아저씨", "어쩔 텐가？"
						ELSEIF GET_SEA_ARCH_FLAG("ダークおやじ") == 2
							CALL MESSAGE_WINDOW_D, "다크 아저씨", "앗 당신！/남자 악마만 만나는 기분은 최악이라고！"
							CALL MESSAGE_WINDOW_D, "다크 아저씨", "부탁이니까/여자 악마만 나오게 해주지 않겠나？"
							CALL MESSAGE_WINDOW_D, "다크 아저씨", @"공짜로는 안 되지만…/당신이라면…{GET_SEA_ARCH_FLAG("探索許可ランク")*50}마카겠군"
							CALL MESSAGE_WINDOW_D, "다크 아저씨", "어쩔 텐가？"
						ENDIF
						$再選択
						SELECTCASE GET_SEA_ARCH_FLAG("ダークおやじ")
					;通常
							CASE 0
								CALL INPUT_SELECT_D, "[0] 여악마만 나오게 한다/[1] 남악마만 나오게 한다/[3] 그만둔다"
					;女悪魔のみ設定中
							CASE 1
								CALL INPUT_SELECT_D, "[1] 남악마만 나오게 한다/[2] 취소/[3] 그만둔다"
					;男悪魔のみ設定中
							CASE 2
								CALL INPUT_SELECT_D, "[0] 여악마만 나오게 한다/[2] 취소/[3] 그만둔다"
						ENDSELECT
						IF RESULT < 3 && MONEY:1 < GET_SEA_ARCH_FLAG("探索許可ランク")*50
							CALL MESSAGE_WINDOW_D, "", "마카가 부족합니다"
							GOTO 再選択
						ENDIF
						SELECTCASE RESULT
					;出現悪魔をオンナ悪魔だけに
							CASE 0
								SIF GET_SEA_ARCH_FLAG("ダークおやじ") == 1
									GOTO 再選択

								IF GET_SEA_ARCH_FLAG("ダークおやじ") == 0
									CALL MESSAGE_WINDOW_D, "다크 아저씨", "좋아좋아, 출현하는 악마를 여자 악마만으로 해뒀어！/자 어서 가봐, 이제부터 바빠질 테니"
								ELSEIF GET_SEA_ARCH_FLAG("ダークおやじ") == 2
									CALL MESSAGE_WINDOW_D, "다크 아저씨", "고마워, 이걸로 다시 여자 악마를 만날 수 있어…/자 어서 가봐, 이제부터 바빠질 테니"
								ENDIF
								MONEY:1 -= GET_SEA_ARCH_FLAG("探索許可ランク")*50
								CALL SET_SEA_ARCH_FLAG, "ダークおやじ", 1
					;出現悪魔をオトコ悪魔だけに
							CASE 1
								SIF GET_SEA_ARCH_FLAG("ダークおやじ") == 2
									GOTO 再選択

								IF GET_SEA_ARCH_FLAG("ダークおやじ") == 0
									CALL MESSAGE_WINDOW_D, "다크 아저씨", "…자, 이걸로 남자 악마가 한가득이라고/후딱 끝내달라고… 투덜투덜"
								ELSEIF GET_SEA_ARCH_FLAG("ダークおやじ") == 1
									CALL MESSAGE_WINDOW_D, "다크 아저씨", "여자 다음엔 남자인가/혹시 당신 네토라세 취미인가？/후딱 끝내달라고… 투덜투덜"
								ENDIF
								MONEY:1 -= GET_SEA_ARCH_FLAG("探索許可ランク")*50
								CALL SET_SEA_ARCH_FLAG, "ダークおやじ", 2
					;元に戻す
							CASE 2
								SIF GET_SEA_ARCH_FLAG("ダークおやじ") == 0
									GOTO 再選択

								IF GET_SEA_ARCH_FLAG("ダークおやじ") == 1
									CALL MESSAGE_WINDOW_D, "다크서머너", "좋아、취소했어/또 언제든지 와줘"
								ELSEIF GET_SEA_ARCH_FLAG("ダークおやじ") == 2
									CALL MESSAGE_WINDOW_D, "다크 아저씨", "고맙군, 원래대로 되돌려 놨어/또 언제든 오라고"
								ENDIF
								MONEY:1 -= GET_SEA_ARCH_FLAG("探索許可ランク")*50
								CALL SET_SEA_ARCH_FLAG, "ダークおやじ", 0
					;아무것도안한다
							CASE 3
								CALL MESSAGE_WINDOW_D, "다크서머너", "안하는거냐/또 언제든지 와줘"
						ENDSELECT
				ENDSELECT
			CASE 10
				SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
					CASE 3
						;１１Ｆイベント
						IF GET_SEA_ARCH_FLAG("小悪魔リリス") == 0
							CALL MESSAGE_WINDOW_D, "소악마리림", "어레？인간이다～/잘도 여기까지 왔네、무엇때문에 왔어？"
							CALL MESSAGE_WINDOW_D, "소악마리림", "에？차원의 복도？？"
							CALL MESSAGE_WINDOW_D, "소악마리림", "으～응…나는 잘 모르겠네/그렇지만 뭐、모처럼 왔는데 조금은 쉬었다 가는것도 좋다고 생각해"
							CALL SET_SEA_ARCH_FLAG, "小悪魔リリス", 1
						ELSE
						;小悪魔リリム、マジ小悪魔
							CALL MESSAGE_WINDOW_D, "소악마리림", "인간의 마을은 정말로 재밌네～/이전에 모르는 아저씨가 밥을 대접해줬어♪"
							CALL MESSAGE_WINDOW_D, "소악마리림", @"그 다음에？/물론 답례로 서비스 해줬지%ハート()%"
							CALL MESSAGE_WINDOW_D, "소악마리림", "디저트도 대접 받아버려서/대만족이었어、에헷♪"
						ENDIF
						RETURN 0
				ENDSELECT
		ENDSELECT

ENDSELECT
RETURN 0


;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_94
SELECTCASE FLAG:현M
	CASE 0 , 10
		FLAG:인카운트율 = 0
		FLAG:미조우걸음수 = 0
	CASEELSE
		FLAG:인카운트율 = FLAG:미조우걸음수*3
ENDSELECT
SIF FLAG:미조우걸음수 < 5
	FLAG:인카운트율 = 0
IF GET_SEA_ARCH_FLAG("悪魔出現") == 1
	FLAG:인카운트율 = 0
	FLAG:미조우걸음수 = 0
ENDIF
;=======================================================================
;必要レベル目安
;推奨LV 雑魚最低LV 雑魚最高LV ボスLV 
;=======================================================================
@GET_DUNGEON_LV_94
RETURN 5, 3, 9, 10
;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_94
IF RAND:100 < FLAG:인카운트율
	CALL ENEMY_TABLE_94
	RETURN RESULT
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF
;=======================================================================
;敵の種族の種類数
;RETURN X でXが種類の数になります
;あまりいろんなのが混ざっているとCOOPがとりにくくなったり
;敵の攻撃属性が多くなる傾向にあるので、
;種類の数は1・2種類を主体に時々3種類くらいを基本にするのが望ましいと思われます
;
;敵の選別が特殊なので直接処理する形に
;=======================================================================
@CLASS_NUM_94

;=======================================================================
;敵の総数
;ARGは出現する敵の種類です
;RAND(X, Y)はX～Y-1のうちのどれかになるRANDです
;なお、ここで帰った数字は下限を種族数、上限を10として自動的に調整されます
;
;敵の選別が特殊なので直接処理する形に
;=======================================================================
@ENEMY_NUM_94, ARG

;=======================================================================
;敵ステータス設定
;=======================================================================
@SET_ENEMY_STATUS_94,ARG
ABL:ARG:아이템1 = 0
ABL:ARG:입수확률1 = 0
ABL:ARG:아이템2 = 0
ABL:ARG:입수확률2 = 0
ABL:ARG:아이템3 = 0
ABL:ARG:입수확률3 = 0

;=======================================================================
;敵の種類
;
;敵の選別とセット関数。
;通常の敵セット処理に行かずにここで配置処理を全て行う
;=======================================================================
@ENEMY_TABLE_94
#DIM CLASS_NUM, 1
#DIM ENEMY_NUM, 1
#DIM MAXENEMY, 1
#DIM MINENEMY, 1
#DIM ENEMY, 10
#DIM ENEMYLV, 10
#DIM 出現悪魔, 200
#DIM レア悪魔, 100
#DIM レア悪魔種類数, 1
#DIM 出現最高レベル, 1
#DIM 出現最低レベル, 1
#DIM 出現悪魔種類数, 1
#DIM LCOUNT, 2
#DIM L_ENEMYRANK, 2
#DIM 出現悪魔テーブル, 200
#DIM テーブル悪魔種類数
#DIM テーブル再生成, 1
#DIM L_ダークおやじ
#DIM L_PICKUP
#DIM 敵排除レベル,2;エストマ・キャプスロックの適用レベル

;-------------------------------------------------
;テーブル生成チェック
;階層が変わったときにテーブルを作り直す。
;-------------------------------------------------
;10階はランク17, 2～9Fは1~8で裏フラグが立っている時は9~16
IF FLAG:현M == 9
	L_ENEMYRANK = 17
ELSE
	L_ENEMYRANK = FLAG:현M
	SIF GET_SEA_ARCH_FLAG("探索許可ランク") >= (FLAG:현M + GET_SEA_ARCH_FLAG("裏フラグ") * 8)
		L_ENEMYRANK += GET_SEA_ARCH_FLAG("裏フラグ") * 8
ENDIF
;エストマ・キャプスロックによる抑制レベルの取得
敵排除レベル = 0
IF FLAG:에스트마
	LOCAL = 0
	FOR LCOUNT, 1, 7
		SIF POS(LCOUNT) < 0
			CONTINUE
		LOCAL++
		敵排除レベル += BASE:POS(LCOUNT):LV
	NEXT
	敵排除レベル /= LOCAL
ENDIF
;---- EDIT 015 MOD START -------------------------
SIF SOFT_ON("캡스・락") && !IS_DISABLE_CAPSLOCK
	敵排除レベル = MAX(BASE:MASTER:LV - 12, 敵排除レベル)
;---- EDIT 015 MOD END ---------------------------
;最高レベルを排除レベルが超えてたら敵を呼ばずに終了
SIF GET_SEA_ARCH_ENEMYMAXLV(L_ENEMYRANK+1) < 敵排除レベル
	RETURN 0
;テーブル内容に干渉する変更があった場合は作り直しをする
IF L_ENEMYRANK != L_ENEMYRANK:1 || !MAXARRAY(出現悪魔) || L_ダークおやじ != GET_SEA_ARCH_FLAG("ダークおやじ") || L_PICKUP != GET_SEA_ARCH_FLAG("種族ピックアップ") || 敵排除レベル != 敵排除レベル:1
	L_ENEMYRANK:1 = L_ENEMYRANK
	敵排除レベル:1 = 敵排除レベル
	L_ダークおやじ = GET_SEA_ARCH_FLAG("ダークおやじ") 
	L_PICKUP = GET_SEA_ARCH_FLAG("種族ピックアップ")
	テーブル再生成 = 1
ELSE
	GOTO MAKE_TABLE
ENDIF

;-------------------------------------------------
;出現悪魔の登録
;-------------------------------------------------
出現悪魔種類数 = 0
VARSET 出現悪魔
FOR LCOUNT, 1, CSVCHARANUM
	;シーアークで出現可能状態かどうかをチェック
	SIF !CAN_ENCOUNT_SEA_ARCH(LCOUNT, L_ENEMYRANK)
		CONTINUE
	;ダークおやじでオンナ悪魔のみに設定している場合
	SIF GET_SEA_ARCH_FLAG("ダークおやじ") == 1 && CSVTALENT(LCOUNT, GETNUM(TALENT, "남자")) != 0
		CONTINUE
	;ダークおやじでオトコ悪魔のみに設定している場合
	SIF GET_SEA_ARCH_FLAG("ダークおやじ") == 2 && CSVTALENT(LCOUNT, GETNUM(TALENT, "남자")) != 1
		CONTINUE
	;10Ｆは敵レベルを揃えて出す関係で追加処理
	IF L_ENEMYRANK == 17
		IF GET_SEA_ARCH_FLAG("裏フラグ") && BASE:MASTER:LV >= 90
			SIF CSVBASE(LCOUNT, GETNUM(BASE, "LV")) >= 95
				CONTINUE
		ELSE
			SIF CSVBASE(LCOUNT, GETNUM(BASE, "LV")) >= 85
				CONTINUE
		ENDIF
	ENDIF
	;キャプスロック・エストマで敵を弾く
	IF L_ENEMYRANK == 17
		SIF (80 + (GET_SEA_ARCH_FLAG("裏フラグ") && BASE:MASTER:LV >= 90) * 10) < 敵排除レベル
			CONTINUE
	ELSE
		SIF CSVBASE(LCOUNT, GETNUM(BASE, "LV")) < 敵排除レベル
			CONTINUE
	ENDIF
	;解析されていない場合はレア悪魔テーブルにいれる
	IF ANALYSIS_RATE:LCOUNT < ANALYSIS_COMPLETED
		レア悪魔:レア悪魔種類数 = LCOUNT
		レア悪魔種類数++
	ELSE
		出現悪魔:出現悪魔種類数 = LCOUNT
		出現悪魔種類数++
	ENDIF
	;出現悪魔:LOCAL = LCOUNT
	;LOCAL ++
NEXT

;出現悪魔が少ない場合は代理テーブルに差し替え
IF 出現悪魔種類数 < 6
	出現悪魔種類数 = 6
	出現悪魔:0 = [[キャラ:픽시]]
	出現悪魔:1 = [[キャラ:하피]]
	出現悪魔:2 = [[キャラ:아프사라스]]
	出現悪魔:3 = [[キャラ:노커]]
	出現悪魔:4 = [[キャラ:춍춍]]
	出現悪魔:5 = [[キャラ:아귀]]
ENDIF

;------------------------------------------------------------------------------------------
;デバッグ用コード
;コメントオフを解除すれば生成されたリストを確認することができるのでリストに疑問をもったり変更を加えたときにつかってください
;------------------------------------------------------------------------------------------
;PRINTFORMW 出現悪魔
;FOR LCOUNT, 0, 出現悪魔種類数
;	PRINTFORML [{出現悪魔:LCOUNT}] %CSVNAME(出現悪魔:LCOUNT)%
;NEXT
;WAIT
;-----------------------------------------------
;実際に出現する悪魔のテーブル作成
;
;一度出現した悪魔は出現テーブルから抜かれていき、テーブルが空になったら作り直す。
;いわゆるボックス抽選方式
;同じ悪魔と連続して当たることはないが、10戦程度いないにはひける感じの仕様。
;また被りがない関係で少ない戦闘数で多くの種類の敵にあたることができる。
;-----------------------------------------------
$MAKE_TABLE
IF テーブル再生成 || !MAXARRAY(出現悪魔テーブル)
	VARSET 出現悪魔テーブル
	テーブル悪魔種類数 = 出現悪魔種類数
	ARRAYCOPY "出現悪魔", "出現悪魔テーブル"
	;ピックアップ処理
	FOR LCOUNT, 0, テーブル悪魔種類数
		IF GETBIT(GET_SEA_ARCH_FLAG("種族ピックアップ"), CSVABL(出現悪魔:LCOUNT, GETNUM(ABL, "종족"), 0))
			SELECTCASE 出現悪魔種類数
				CASE IS < 10
					LOCAL = RAND:2
				CASE IS < 20
					LOCAL = 1
				CASE IS < 30
					LOCAL = 1 + RAND:2
				CASEELSE
					LOCAL = 2
			ENDSELECT
			FOR LCOUNT:1, 0, LOCAL
				出現悪魔テーブル:テーブル悪魔種類数 = 出現悪魔:LCOUNT
				テーブル悪魔種類数++
			NEXT
		ENDIF
	NEXT
	;レア悪魔が登録されている場合はテーブルに入れる。混入率は登場数に応じて増える
	IF レア悪魔種類数 > 0 && (RAND:100 < 25 * レア悪魔種類数)
		出現悪魔テーブル:テーブル悪魔種類数 = レア悪魔:(RAND:レア悪魔種類数)
		テーブル悪魔種類数++
	ENDIF
	;テーブルのシャッフル
	FOR LCOUNT, 0, テーブル悪魔種類数
		SWAP 出現悪魔テーブル:LCOUNT, 出現悪魔テーブル:(RAND:テーブル悪魔種類数)
	NEXT
	テーブル再生成 = 0
ENDIF
;-----------------------------------------------
;出現悪魔の種族数の定義
;定義的には素材あつめ用のダンジョンなんで回転をよくするために5種類まで許可
;かつ、抽選対象数にあわせて数を増やしていく
;要するにシーアークは解析が進めば進むほど、敵の数と種類が増えていく
;-----------------------------------------------
SELECTCASE 出現悪魔種類数
	;期待値(最低)　6 / 1.5 = 4
	CASE IS < 7
		CLASS_NUM = 1 + (RAND:100 < 50)
	;期待値(最低)　12 / 1.75 = 6.85
	CASE IS < 13
		CLASS_NUM = 1 + (RAND:100 < 50) + (RAND:100 < 25)
	;期待値(最低)　18 / 2 = 9
	CASE IS < 19
		CLASS_NUM = 1 + (RAND:100 < 50) + (RAND:100 < 50)
	;期待値(最低)　24 / 2.75 = 8.72
	CASE IS < 25
		CLASS_NUM = 2 + (RAND:100 < 25) + (RAND:100 < 25) + (RAND:100 < 25)
	;期待値(最低)　30 / 3.25 = 9.23
	CASE IS < 31
		CLASS_NUM = 2 + (RAND:100 < 50) + (RAND:100 < 50) + (RAND:100 < 25)
	;期待値(最低)　36 / 3.75 = 9.6
	CASE IS < 37
		CLASS_NUM = 2 + (RAND:100 < 75) + (RAND:100 < 50) + (RAND:100 < 50)
	;期待値 42 / 4.25  = 9.88
	CASE IS < 43
		CLASS_NUM = 3 + (RAND:100 < 75) + (RAND:100 < 50)
	CASEELSE
		CLASS_NUM = 4 + (RAND:100 < 75)
ENDSELECT
;出現数の設定
;上限はあとからきるので4種・5種は上方に偏る
MAXENEMY = CLASS_NUM * 3 + 1
MINENEMY = CLASS_NUM
ENEMY_NUM = MIN(RAND(MINENEMY, MAXENEMY+1), 10)

;- EDIT011 MOD END   2022/10/05 条件ミス修正-------------------------------------------------
;敵の選定
VARSET ENEMY
;敵の選定
FOR LCOUNT, 0, ENEMY_NUM
	;初めに一匹づつ入れる
	IF LCOUNT < CLASS_NUM
		;---- EDIT 013 MOD START -------------------------
		;テーブルが足りない場合は出現悪魔からランダムで引っ張って補充する
		IF !出現悪魔テーブル:LCOUNT
			;すでにテーブルに入ってる悪魔をひいてしまった場合はひきなおす
			DO 
				出現悪魔テーブル:LCOUNT = 出現悪魔:(RAND:出現悪魔種類数)
			LOOP MATCH(出現悪魔テーブル, 出現悪魔テーブル:LCOUNT) > 1
			テーブル再生成 = 1
		ELSE
			;同じ悪魔を同時にひいてると処理に問題が起きるので別の悪魔をひっぱってくる
			WHILE MATCH(ENEMY, 出現悪魔テーブル:LCOUNT) > 0
				出現悪魔テーブル:LCOUNT = 出現悪魔:(RAND:出現悪魔種類数)
			WEND 
		ENDIF
		ENEMY:LCOUNT = 出現悪魔テーブル:LCOUNT
		;---- EDIT 013 MOD END ---------------------------
	ELSE
		;以降はランダム
		ENEMY:LCOUNT = 出現悪魔テーブル:(RAND:CLASS_NUM)
		;5匹を超えた場合は振り直し
		WHILE MATCH(ENEMY, ENEMY:LCOUNT) > 5
			ENEMY:LCOUNT = 出現悪魔テーブル:(RAND:CLASS_NUM)
		WEND
	ENDIF
NEXT
;------------------------------------------------------------------------------------------
;デバッグ用コード
;コメントオフを解除すれば生成されたリストを確認することができるのでリストに疑問をもったり変更を加えたときにつかってください
;------------------------------------------------------------------------------------------
;PRINTL 敵リスト
;FOR LCOUNT, 0, 10
;	SIF ENEMY:LCOUNT
;		PRINTFORML [{ENEMY:LCOUNT, 4}] %CSVNAME(ENEMY:LCOUNT)%
;NEXT
;PRINTL 
;WAIT
;DRAWLINE
;PRINTFORML 悪魔テーブル
;FOR LCOUNT, 0, テーブル悪魔種類数
;	SIF MATCH(出現悪魔テーブル, 出現悪魔テーブル:LCOUNT) > 1
;		SETCOLOR COLOR("パ緑")
;	SIF LCOUNT < CLASS_NUM
;		SETCOLOR COLOR("aqua")
;	SIF 出現悪魔テーブル:LCOUNT
;		PRINTFORML [{出現悪魔テーブル:LCOUNT, 4}] %CSVNAME(出現悪魔テーブル:LCOUNT)%
;	RESETCOLOR
;NEXT
;WAIT

;出現した悪魔をテーブルから除く
ARRAYREMOVE 出現悪魔テーブル, 0, CLASS_NUM

;シャッフル
FOR LCOUNT, 0, 10
	SWAP ENEMY:LCOUNT, ENEMY:(RAND:10)
NEXT
;一応前詰め
FOR LCOUNT, 0, 5
	SIF !ENEMY:LCOUNT
		SWAP ENEMY:LCOUNT, ENEMY:(LCOUNT+5)
NEXT

;実際の配置
FOR LCOUNT, 0, 10
	SIF !ENEMY:LCOUNT
		CONTINUE
	IF L_ENEMYRANK == 17
		ENEMYLV = 80 + RAND:6
		SIF BASE:MASTER:LV >= 90 && GET_SEA_ARCH_FLAG("裏フラグ")
			ENEMYLV += 10
	ELSE
		ENEMYLV = CSVBASE(ENEMY:LCOUNT, GETNUM(BASE, "LV"))
	ENDIF
	CALL SET_ENEMY, LCOUNT+7, ENEMY:LCOUNT, ENEMYLV
	;ここでステータス変化させる場合の関数を呼ぶ
	TRYCALLFORM SET_ENEMY_STATUS_{FLAG:현던전}, CHARANUM - 1
NEXT
RETURN 1

;=======================================================================
;宝箱の中身
;=======================================================================
@TREASURE_94
#LOCALSIZE 3
;宝箱のフラグ管理用変数の番号
LOCAL = FLAG:현M + 70
;そのマップの何番目の宝箱か
LOCAL:1 = (DA:(FLAG:현X):(FLAG:현Y) / 10) % 100

;/10はIDを10で割る。つまり、下一桁をなくして、二桁目と三桁目を二桁の数字として取り出している
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
	;マップ番号*100+そのマップで何番目の宝箱かを示す数値でどの宝箱かを判別します。
	;例えば0の場合、0版のマップの0番目の宝箱であることを表しています。

ENDSELECT
RETURN 1

;=======================================================================
;階段置き場
;=======================================================================
;上り階段処理
@UPSTAIRS_94
;位置とIDが対応しているはずなので、同IDの階段を探させれば良い
SELECTCASE FLAG:현M
	CASEELSE
		CALL DUNGEON_UPSTAIRS_ID, FLAG:현M+1 , DA:(FLAG:현X):(FLAG:현Y) + 1000 + 1
ENDSELECT
RETURN 1

;下り階段処理
@DOWNSTAIRS_94
SELECTCASE FLAG:현M
	CASEELSE
		CALL DUNGEON_DOWNSTAIRS_ID, FLAG:현M-1 , DA:(FLAG:현X):(FLAG:현Y) - 1000 - 1
ENDSELECT
RETURN 1

