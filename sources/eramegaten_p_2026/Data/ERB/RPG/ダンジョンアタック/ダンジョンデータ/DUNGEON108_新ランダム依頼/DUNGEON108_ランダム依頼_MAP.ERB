	RESULT:6 = 5
	SELECTCASE 依頼フラグ:[[依頼:랜덤의뢰]]:1
		CASE 5, 6
			RESULTS:1 = Ｂ６Ｆ
			RESULTS:2 = Ｂ５Ｆ
			RESULTS:3 = Ｂ４Ｆ
			RESULTS:4 = Ｂ３Ｆ
			RESULTS:5 = Ｂ２Ｆ
			RESULTS:6 = Ｂ１Ｆ
			RETURN -1
		CASEELSE
			RESULTS:1 = １Ｆ
			RESULTS:2 = ２Ｆ
			RESULTS:3 = ３Ｆ
			RESULTS:4 = ４Ｆ
			RESULTS:5 = ５Ｆ
			RESULTS:6 = ６Ｆ
