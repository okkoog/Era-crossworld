;=======================================================================
;タイル定義
;=======================================================================
@DEFINE_TILES_108, ARGS, ARG, ARG:1
SELECTCASE ARGS
	CASE "m";人物
		RETURN 14
	CASE "U";↑
		RETURN 24
	CASE "d";↓	*D:はダークゾーン
		RETURN 34
	CASE "r";→	*Rは罠
		RETURN 44
	CASE "L";←
		RETURN 54
	CASE "w";水
		RETURN 10
	CASE "t";木(Tはターミナル）
		RETURN 20
	CASE "M";山(mは人物）
		RETURN 30
	CASE "b";橋
		RETURN 11
	CASE "f";畑
		RETURN 21
	
ENDSELECT






;=======================================================================
;特殊タイル表示
;TILE_MARK_COMMON_{FLAG:현던전}_X
;=======================================================================
;ARG:1、ARG:2がX座標とY座標
;ARGはそこに代入されている値
;RESULTSに代入した文字がマップに表示されますが、必ず全角1文字分になるようにしてください。そうでないと表示が崩れます。
; は0
;0：壁の特殊表示
@TILE_MARK_COMMON_108_0,ARG,ARG:1,ARG:2
SELECTCASE ARG
	CASE 0
		IF 依頼フラグ:[[依頼:랜덤의뢰]]:3 == 4
			SETCOLOR 0, 200, 0
			RESULTS = 森
		ELSEIF 依頼フラグ:[[依頼:랜덤의뢰]]:3 == 5
			SETCOLOR 116, 80, 48
			RESULTS = 山
		;人魚狩り
		ELSEIF 依頼フラグ:[[依頼:랜덤의뢰]]:1 == 37
			SETCOLOR 0, 0, 255
			RESULTS = ミ
		;特殊部隊強襲
		ELSEIF 依頼フラグ:[[依頼:랜덤의뢰]]:1 == 38
			RESULTS = 雪
		ELSE
			RESULTS = ■
		ENDIF
	CASE 10
		SETCOLOR 0, 0, 255
		RESULTS = ミ
	CASE 20
		SETCOLOR 0, 200, 0
		RESULTS = 木
	CASE 30
		SETCOLOR 116, 80, 48
		RESULTS = 山
	CASEELSE
		RETURN 1
ENDSELECT

