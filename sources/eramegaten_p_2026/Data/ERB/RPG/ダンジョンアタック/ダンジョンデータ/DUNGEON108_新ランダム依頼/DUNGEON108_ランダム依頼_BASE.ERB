;=======================================================================
;フラグ
;依頼フラグ:[[依頼:랜덤의뢰]]:1	受注した依頼
;依頼フラグ:[[依頼:랜덤의뢰]]:4	受注した依頼の進行状況
;
;ダンジョンフラグ:108:0-10 = 宝箱
;ダンジョンフラグ:108:11 = ボス撃破フラグ(1.倒した)
;
;ダンジョンフラグ:108:20～29　ランダム依頼の判定に使用

;ダンジョンフラグ:108:50	ランダムダンジョンの階層
;ダンジョンフラグ:108:51	ランダムダンジョンの階段位置(X)
;ダンジョンフラグ:108:52	ランダムダンジョンの階段位置(Y)

;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_108
;ランダム依頼を受諾していると発生
IF 依頼フラグ:[[依頼:랜덤의뢰]]:2 == 1
	RETURN 1
ELSE
	RETURN 0
ENDIF


;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_108
#FUNCTIONS
IF EXISTFUNCTION(@"DUNGEON_NAME_108_{依頼フラグ:[[依頼:랜덤의뢰]]:1}")
	CALLFORMF DUNGEON_NAME_108_{依頼フラグ:[[依頼:랜덤의뢰]]:1}
ELSE
	RESULTS_F '= "名称未定義"
ENDIF
RESULTS_F:1 '= "랜덤의뢰"
RETURNF RESULTS_F
;======================================================================
;攻略開始時のイベント
;=======================================================================
@EVENT_DUNGEON_START_108
TRYCALLFORM EVENT_DUNGEON_START_108_{依頼フラグ:[[依頼:랜덤의뢰]]:1}

;=======================================================================
;脱出時のイベント
;=======================================================================
@EVENT_DUNGEON_END_108
TRYCALLFORM  DUNGEON_RESULT_108_{依頼フラグ:[[依頼:랜덤의뢰]]:1}
;フラグリセット
CALL REQUEST_108_FLAG_CLEAR

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_108,ARG,ARG:1
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT


;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_108

;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) % 10 == 8
	CALL DUNGEON_EXIT
	RETURN 1

;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
	;ランダムダンジョン
	SIF 依頼フラグ:[[依頼:랜덤의뢰]]:3 == 6
		CALL TREASURE_RAND_DANGEON
	
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 6
	CALL UPSTAIRS_108
	RETURN RESULT
	
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 7
	;ランダムダンジョン
	IF 依頼フラグ:[[依頼:랜덤의뢰]]:3 == 6
		CALL RAND_DUNGEON_DOWNSTAIRS
		RETURN RESULT
	ELSE
		CALL DOWNSTAIRS_108
		RETURN RESULT
	ENDIF

;========
;이벤트
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 4
	TRYCALLFORM  DUNGEON_EVENT_108_{依頼フラグ:[[依頼:랜덤의뢰]]:1}
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞아무것도 없는 것 같다"
	RETURN 0
ENDIF

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_108,ARG
;ARG = 進入時の向き　0の場合ワープなど
;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) % 10 == 8
	CALL DUNGEON_EXIT
	RETURN 1

;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
;ランダムダンジョン
SIF 依頼フラグ:[[依頼:랜덤의뢰]]:3 == 6
	CALL TREASURE_RAND_DANGEON

;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 6
	CALL UPSTAIRS_108
	RETURN RESULT

ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 7
	IF 依頼フラグ:[[依頼:랜덤의뢰]]:3 == 6
		CALL RAND_DUNGEON_DOWNSTAIRS
		RETURN RESULT
	ELSE
		CALL DOWNSTAIRS_108
		RETURN RESULT
	ENDIF
;==========
;扉の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 2
	CALL DUNGEON_DOOR,ARG
	RETURN 1

;===========
;이벤트
;===========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 4
	;ランダム迷宮の次のフロアに移動する際の処理
	IF 依頼フラグ:[[依頼:랜덤의뢰]]:3 == 8 && DA:(FLAG:현X):(FLAG:현Y) == 34
		IF FLAG:현M == 9
			CALL DUNGEON_WORP, (FLAG:현M - 1), 15, 1
		ELSEIF FLAG:현M == 1
			CALL DUNGEON_WORP, (FLAG:현M - 1), 15, 7
		ELSE
			CALL DUNGEON_WORP, (FLAG:현M - 1), (ダンジョンフラグ:108:51), 1
		ENDIF
	;이벤트
	ELSE
		TRYCALLFORM DUNGEON_EVENT_108_{依頼フラグ:[[依頼:랜덤의뢰]]:1}
	ENDIF
ENDIF
RETURN 0

;=======================================================================
;輪姦参加悪魔
;=======================================================================
@DUNGEON_RAPE_DEVIL_108
;ランダムにどの悪魔が出るか決定
;RETURN CSV番号 , 人数 , レベル
SELECTCASE RAND:4
	CASE 0
		RETURN [[キャラ:잇폰다타라]] , 3 + RAND:10 , CSVBASE([[キャラ:잇폰다타라]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 1
		RETURN [[キャラ:코볼트]] , 3 + RAND:10 , CSVBASE([[キャラ:코볼트]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 2
		RETURN [[キャラ:안드라스]] , 3 + RAND:10 , CSVBASE([[キャラ:안드라스]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 3
		RETURN [[キャラ:브라우니]] , 3 + RAND:10 , CSVBASE([[キャラ:브라우니]] , GETNUM(BASE , "LV") , 0) + RAND:3
ENDSELECT

