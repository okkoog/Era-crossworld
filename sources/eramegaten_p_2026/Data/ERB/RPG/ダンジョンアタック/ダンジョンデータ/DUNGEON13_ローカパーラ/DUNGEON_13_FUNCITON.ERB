;------------------------------------------
;タイルの高さを取得する
;------------------------------------------
@GET_HEIGHT_DUNGEON_13, L_TILE
#FUNCTION
#DIM DYNAMIC L_TILE
;収容所の段差マップは配置方式が違う
IF FLAG:현M == 15
	SELECTCASE L_TILE % 10
		CASE 1
			RETURNF 0
		CASE 3
			RETURNF 1
		CASE 5
			RETURNF 2
		CASE 9
			RETURNF 3
		CASEELSE
			RETURNF 99
	ENDSELECT
ELSE
	SELECTCASE L_TILE % 10
		CASE 1
			RETURNF 0
		CASE 5
			SIF L_TILE > 35
				RETURNF 0
			RETURNF L_TILE / 10
		CASEELSE
			RETURNF 99
	ENDSELECT
ENDIF

;
@GET_JUMPABLE_DUNGEON_13, L_X, L_Y, L_DIRECTION
#FUNCTION
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC L_DIRECTION
#DIM DYNAMIC L_TILE, 3

;侵入方向を利用しつつ判定に使うタイルを取得
L_TILE = DA:L_X:L_Y
SELECTCASE L_DIRECTION
	CASE 2
		;値域外のタイルが入る場合は切る。ループ際は未考慮
		SIF L_Y + 2 >= FLAG:최대Y
			RETURNF 0
		L_TILE:1 = DA:(L_X):(L_Y + 1)
		L_TILE:2 = DA:(L_X):(L_Y + 2)
	CASE 6
		SIF L_X + 2 >= FLAG:최대X
			RETURNF 0
		L_TILE:1 = DA:(L_X + 1):(L_Y)
		L_TILE:2 = DA:(L_X + 2):(L_Y)
	CASE 8
		SIF L_Y - 2 < 0
			RETURNF 0
		L_TILE:1 = DA:(L_X):(L_Y - 1)
		L_TILE:2 = DA:(L_X):(L_Y - 2)
	CASE 4
		SIF L_X - 2 < 0
			RETURNF 0
		L_TILE:1 = DA:(L_X - 1):(L_Y)
		L_TILE:2 = DA:(L_X - 2):(L_Y)
	CASEELSE
		RETURNF 0
ENDSELECT
;第一タイルの高さが2と3の時のみ成立する
SIF !INRANGE(GET_HEIGHT_DUNGEON_13(L_TILE), 1, 3)
	RETURNF 0
;第一と第三のタイルが同じ高さである必要がある
SIF GET_HEIGHT_DUNGEON_13(L_TILE) != GET_HEIGHT_DUNGEON_13(L_TILE:2)
	RETURNF 0
;第一タイルと第二タイルの間に高さの差が2以上必要
SIF GET_HEIGHT_DUNGEON_13(L_TILE) - GET_HEIGHT_DUNGEON_13(L_TILE:1) < 1
	RETURNF 0
RETURNF 1

