;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@DUNGEON_BEFORE_ENTER_EVENT_13_tamago,L_X,L_Y,IS_ROUTE_SEARCH
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC IS_ROUTE_SEARCH
SELECTCASE DA:L_X:L_Y
	CASE 56102, 58102, 62102
		IF IS_ROUTE_SEARCH
			IF IS_AUTORUN_SEARCHING
				RETURN GET_FLOOR_ANALYZE_T(L_X, L_Y) < 2
			ELSE
				RETURN 1
			ENDIF
		ELSE
			CALL MESSAGE_WINDOW_D, "", "문 너머에 기척이 있다 "
			CALL INPUT_SELECT_D, "[0] 문 너머로 간다/[1] 가지 않는다 "
			IF RESULT == 0
				RETURN 1
			ELSE
				RETURN 0
			ENDIF
		ENDIF
ENDSELECT
RETURN 1
