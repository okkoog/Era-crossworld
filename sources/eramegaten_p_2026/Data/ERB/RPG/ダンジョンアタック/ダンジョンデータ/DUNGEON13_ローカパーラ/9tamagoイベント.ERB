;たまごタイル
;=======================================================================
;イベントタイル特殊表示4
@TILE_MARK_COMMON_13_tamago_4, ARG,ARG:1,ARG:2
SELECTCASE ARG / 10
	;ゲイル
	CASE 5400
		SETCOLOR 0x00ff00
		RESULTS = ゲ
	;サーフ
	CASE 5401
		SETCOLOR 0x00ff00
		RESULTS = サ
	;竜司
	CASE 5402
		SETCOLOR 0x00ff00
		RESULTS = 竜
	;新島　真
	CASE 5403
		SETCOLOR 0x00ff00
		;RESULTS = 真
		RESULTS = Ｈ
	;シエロ
	CASE 5801
		SETCOLOR 0x00ff00
		RESULTS = シ
	;モルガナ
	CASE 6101
		SETCOLOR 0x00ff00
		RESULTS = モ
	CASEELSE
		RESULTS = ！
ENDSELECT

;イベントタイル特殊表示9
@TILE_MARK_COMMON_13_tamago_9, ARG,ARG:1,ARG:2
SELECTCASE ARG / 10
	CASE 5400
		RESULTS = ↑
	CASE 5500
		RESULTS = ↓
	CASE 5600, 5800, 6200
		RESULTS = ！
	CASE 5700, 5801
		RESULTS = ◎
	CASE 410
		RESULTS = ←
	CASE 500
		RESULTS = →
	CASEELSE
		RESULTS = ！
ENDSELECT

;=======================================================================
;たまごタイル変換
;=======================================================================
@REPLACE_TILE_DUNGEON_13_tamago, ARG, ARG:1, ARG:2
SELECTCASE ARG % 10
	CASE 0
		SELECTCASE ARG / 10
			;石柱編かタイル
			CASE 10
				SIF FLAG_D13_宇宙の卵ダンジョン進行度 >= FLAG:현M - 55 + 1
					DA:(ARG:1):(ARG:2) = 1
			CASE 11
				SIF FLAG_D13_宇宙の卵ダンジョン進行度 >= FLAG:현M - 55 + 1
					DA:(ARG:1):(ARG:2) = 2
		ENDSELECT
	CASE 1
		SELECTCASE ARG / 10
		ENDSELECT
	CASE 2
		SELECTCASE ARG / 10
			CASE 5610
				SIF FLAG_D13_宇宙の卵ボス進行度 >= 2
					DA:(ARG:1):(ARG:2) = 2
			CASE 5810
				SIF FLAG_D13_宇宙の卵ボス進行度 >= 3
					DA:(ARG:1):(ARG:2) = 2
		ENDSELECT
	CASE 4
		SELECTCASE ARG / 10
			CASE 5500
				SIF FLAG_D13_宇宙の卵ダンジョン進行度 >= 1
					DA:(ARG:1):(ARG:2) = 1
			CASE 5600
				SIF FLAG_D13_宇宙の卵ダンジョン進行度 >= 2
					DA:(ARG:1):(ARG:2) = 1
			CASE 5700
				SIF FLAG_D13_宇宙の卵ダンジョン進行度 >= 3
					DA:(ARG:1):(ARG:2) = 1
			CASE 5800
				SIF FLAG_D13_宇宙の卵ダンジョン進行度 >= 4
					DA:(ARG:1):(ARG:2) = 1
			CASE 5900
				SIF FLAG_D13_宇宙の卵ダンジョン進行度 >= 5
					DA:(ARG:1):(ARG:2) = 1
			CASE 6000
				SIF FLAG_D13_宇宙の卵ダンジョン進行度 >= 6
					DA:(ARG:1):(ARG:2) = 1
			CASE 6100
				SIF FLAG_D13_宇宙の卵ダンジョン進行度 >= 7
					DA:(ARG:1):(ARG:2) = 1
			CASE 6200
				SIF FLAG_D13_宇宙の卵ダンジョン進行度 >= 8
					DA:(ARG:1):(ARG:2) = 1
		ENDSELECT
	CASE 9
		SELECTCASE ARG / 10
			CASE 5600
				SIF FLAG_D13_宇宙の卵ボス進行度 >= 2
					DA:(ARG:1):(ARG:2) = 1
			CASE 5800
				SIF FLAG_D13_宇宙の卵ボス進行度 >= 3
					DA:(ARG:1):(ARG:2) = 1
			CASE 6200
				SIF FLAG_D13_宇宙の卵ボス進行度 >= 4
					DA:(ARG:1):(ARG:2) = 1
		ENDSELECT
ENDSELECT
;=======================================================================
;たまご調べイベント(4)
;=======================================================================
@EVENT_CHECK_DUNGEON_13_tamago_4
#LOCALSIZE 1
LOCAL = DA:(FLAG:현X):(FLAG:현Y) / 10
SELECTCASE LOCAL
	;サーフ
	CASE 5401
		CALL MESSAGE_WINDOW_D, "서프", "전에도 제나가 게일에 대해/표정을 바꾼적이 있었어… "
		CALL MESSAGE_WINDOW_D, "서프", "역시 제나는 게일과/관련이 있었던 인물인것 같군 "
		CALL INPUT_SELECT_D, "[0] 동료를 교체한다/[1] 아무것도 아니다 "
		SIF RESULT == 0
			CALL RECONSTRUCTION
	;真
	CASE 5403
		CALL MESSAGE_WINDOW_D, "마코토", "저는…잘 모르겠지만/제나와 게일씨는 뭔가 관계가 있었나봐요 "
		IF !GETBIT(FLAG_D13_宇宙の卵その他進行度,0) || !GETBIT(FLAG_D13_宇宙の卵その他進行度,1) || !GETBIT(FLAG_D13_宇宙の卵その他進行度,2)
			CALL MESSAGE_WINDOW_D, "마코토", "회복하고 갈까요?/저희 로카파라에서 도구를 몇 개 가져왔어요 "
			LOCALS = {(!GETBIT(FLAG_D13_宇宙の卵その他進行度,0) + !GETBIT(FLAG_D13_宇宙の卵その他進行度,1) + !GETBIT(FLAG_D13_宇宙の卵その他進行度,2))}
			CALL INPUT_SELECT_D, "[0]네(나머지" + LOCALS + "회)/[1]아니오 "
			IF RESULT == 0
				PRINTFORMW %CALLNAME:MASTER%들은 회복했다
				FOR LOCAL, 1, 7
					SIF POS(LOCAL) > -1
						CALL HEALTH_CHARA, POS(LOCAL)
				NEXT
				SIF GETBIT(FLAG_D13_宇宙の卵その他進行度,1)
					SETBIT FLAG_D13_宇宙の卵その他進行度,2
				SIF GETBIT(FLAG_D13_宇宙の卵その他進行度,0)
					SETBIT FLAG_D13_宇宙の卵その他進行度,1
				SETBIT FLAG_D13_宇宙の卵その他進行度,0
			ENDIF
		ENDIF
	;竜司
	CASE 5402
		CALL MESSAGE_WINDOW_D, "류지", "뭐야 제나 녀석…/저런 표정을 짓다니…어째서… "
		CALL MESSAGE_WINDOW_D, "류지", "근데 데이빗이라니 누구야？ "
	;ゲイル
	CASE 5400
		CALL MESSAGE_WINDOW_D, "게일", "…이상한 모습을 보여버렸구나/갑자기 미안하네 "
		CALL MESSAGE_WINDOW_D, "게일", "이야기는 나중이야/빨리 갈까 "
	;シエロ
	CASE 5801
		CALL MESSAGE_WINDOW_D, "시에로", "돌기둥을 뽑으면 지형이 바뀌는군./보아하니 입구까지 직행할 수 있는 구조로/되어 있다고 "
		CALL MESSAGE_WINDOW_D, "시에로", "세라… 저런 꼴이 되어버렸는데/괜찮은 거겠지… "
		CALL MESSAGE_WINDOW_D, "시에로", "지금 어쩔래?/돌아가서 회복하는 것도 한 방법이야./지금 상태라면 여기까지 오는 건 그리 힘들지 않을 테니까 "
		CALL INPUT_SELECT_D, "[0] 동료를 교체한다/[1] 저장한다/[2] 입구까지 돌아간다/[3] 아무것도 아니다 "
		IF RESULT == 0
			CALL RECONSTRUCTION
		ELSEIF RESULT == 1
			CALL TITLE_SAVEGAME
		ELSEIF RESULT == 2
			CALL DUNGEON_WORP,54,6,1
		ENDIF
	;モルガナ
	CASE 6101
		CALL MESSAGE_WINDOW_D, "모르가나", "저 녀석들은 구제니 뭐니 지껄이고 있지만/인간의 목숨 따윈 안중에도 없어 "
		CALL MESSAGE_WINDOW_D, "모르가나", "렌도 세라도/그저 도구로밖에 생각하지 않는다고 "
		CALL MESSAGE_WINDOW_D, "모르가나", "그런데 어쩔래?/일단 입구까지 돌아가서 정비할래?/마코토에게 말을 걸면 회복할 수 있어."
		LOCALS '= "[0] 仲間を入れ替える/[1] セーブする/[2] 入口まで戻る/[3] 何でもない "
		SIF FLAG_D13_宇宙の卵ダンジョン進行度 < 7
			LOCALS += "/[4] モルガナに攻略を任せる "
		CALL INPUT_SELECT_D, LOCALS
		IF RESULT == 0
			CALL RECONSTRUCTION
		ELSEIF RESULT == 1
			CALL TITLE_SAVEGAME
		ELSEIF RESULT == 2
			CALL DUNGEON_WORP,54,6,1
		ELSEIF RESULT == 4
			CALL MESSAGE_WINDOW_D, "", "모르가나에게 이 계층의 공략을 맡기면 이 던전 보스의 레벨이 상승합니다/정말 맡기겠습니까? "
			CALL INPUT_SELECT_D, "[0]네/[1]아니오 "
			IF RESULT == 0
				CALL MESSAGE_WINDOW_D, "모르가나", "OK 잠깐 기다려봐 "
				CALL MESSAGE_WINDOW_D, "모르가나", "아, 맞다 시에로 너 하늘 날 수 있었지/좀 도와주지 않을래? "
				CALL MESSAGE_WINDOW_D, "시에로", "오 그래 좋아 "
				CALL MESSAGE_WINDOW_D, "", "… "
				CALL MESSAGE_WINDOW_D, "", "…/…… "
				CALL MESSAGE_WINDOW_D, "", "…/……/……… "
				CALL MESSAGE_WINDOW_D, "", "모르가나가 돌아왔다 "
				CALL MESSAGE_WINDOW_D, "모르가나", "좋아 도착! 대충 둘러보고 왔다고 "
				CALL MESSAGE_WINDOW_D, "모르가나", "돌기둥도 전부 주워왔어/이걸로 위로 올라갈 수 있을 거야. "
				LOCALS '= "先に行けるようになった"
				SIF FLAG_D13_宇宙の卵ダンジョン進行度 < 5
					LOCALS += "/茶の石柱を手に入れた "
				SIF FLAG_D13_宇宙の卵ダンジョン進行度 < 6
					LOCALS += "/黒の石柱を手に入れた "
				SIF FLAG_D13_宇宙の卵ダンジョン進行度 < 7
					LOCALS += "/赤の石柱を手に入れた "
				CALL MESSAGE_WINDOW_D, "", LOCALS
				FLAG_D13_宇宙の卵ダンジョン進行度 = 7

				SETBIT FLAG_D13_宇宙の卵その他進行度,3
			ENDIF
		ENDIF
	CASEELSE
		IF 5400 < LOCAL && 6300 > LOCAL && LOCAL%100 == 0
			CALL MESSAGE_WINDOW_D, "", "박혀 있는 돌기둥을 뽑았다 "
			CALL MESSAGE_WINDOW_D, "", "지형이 변했다 "
			FLAG_D13_宇宙の卵ダンジョン進行度 ++
			CALL DUNGEON_WORP,(FLAG:현M),(FLAG:현X),(FLAG:현Y)
			SIF FLAG_D13_宇宙の卵ダンジョン進行度 == 1
				CALL MESSAGE_WINDOW_D, "", "녹색 돌기둥을 손에 넣었다 "
			SIF FLAG_D13_宇宙の卵ダンジョン進行度 == 2
				CALL MESSAGE_WINDOW_D, "", "노란 돌기둥을 손에 넣었다 "
			SIF FLAG_D13_宇宙の卵ダンジョン進行度 == 3
				CALL MESSAGE_WINDOW_D, "", "파란 돌기둥을 손에 넣었다 "
			SIF FLAG_D13_宇宙の卵ダンジョン進行度 == 4
				CALL MESSAGE_WINDOW_D, "", "자주색 돌기둥을 손에 넣었다 "
			SIF FLAG_D13_宇宙の卵ダンジョン進行度 == 5
				CALL MESSAGE_WINDOW_D, "", "차의 돌기둥을 손에 넣었다 "
			SIF FLAG_D13_宇宙の卵ダンジョン進行度 == 6
				CALL MESSAGE_WINDOW_D, "", "검은 돌기둥을 손에 넣었다 "
			SIF FLAG_D13_宇宙の卵ダンジョン進行度 == 7
				CALL MESSAGE_WINDOW_D, "", "붉은 돌기둥을 손에 넣었다 "
			SIF FLAG_D13_宇宙の卵ダンジョン進行度 == 8
				CALL MESSAGE_WINDOW_D, "", "복숭아 돌기둥을 손에 넣었다 "
			IF GETBIT(FLAG:발견ED, 45) || FLAG_D13_階層踏破度 > 61
				FLAG_D13_宇宙の卵ダンジョン進行度 = 8
				CALL MESSAGE_WINDOW_D, "", "클리어 보너스！/모든 돌기둥을 손에 넣었다/보스로 직행할 수 있게 되었다 "
			ENDIF
		ENDIF
ENDSELECT


