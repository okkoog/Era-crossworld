;=======================================================================
;精神世界宝箱
;=======================================================================
@SEISIN_takara
#LOCALSIZE 3
;宝箱のフラグ管理用変数の番号
LOCAL = FLAG:현M / 5 + 80
;そのマップの何番目の宝箱か
LOCAL:1 = (DA:(FLAG:현X):(FLAG:현Y) / 10) % 100
LOCAL:1 += FLAG:현M % 5 * 10

SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
	CASE 4200
		CALL GETS_TREASURE, "암리타샤워" , 1 , FLAG:현던전, LOCAL , LOCAL:1
	CASE 4201
		CALL GETS_TREASURE, "중압의곡옥" , 1 , FLAG:현던전, LOCAL , LOCAL:1
	CASE 4202
		CALL GETS_TREASURE, "마반경" , 1 , FLAG:현던전, LOCAL , LOCAL:1
	CASE 4100
		CALL GET_TREASURE_MONEY , 0 , 300000 , FLAG:현던전, LOCAL , LOCAL:1
	CASE 4203
		CALL GET_TREASURE, 11103 , 1 , FLAG:현던전, LOCAL , LOCAL:1
	;マップ番号*100+そのマップで何番目の宝箱かを示す数値でどの宝箱かを判別します。
	;例えば0の場合、0版のマップの0番目の宝箱であることを表しています。

ENDSELECT
