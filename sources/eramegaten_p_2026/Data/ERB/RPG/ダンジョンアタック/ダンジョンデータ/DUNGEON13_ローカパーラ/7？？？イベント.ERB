;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@DUNGEON_BEFORE_ENTER_EVENT_13_SEISIN,L_X,L_Y,IS_ROUTE_SEARCH
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC IS_ROUTE_SEARCH
SELECTCASE DA:L_X:L_Y
	CASE 45102
		IF IS_ROUTE_SEARCH
			IF IS_AUTORUN_SEARCHING
				RETURN GET_FLOOR_ANALYZE_T(L_X, L_Y) < 2
			ELSE
				RETURN 1
			ENDIF
		ELSE
			CALL MESSAGE_WINDOW_D, "", "안쪽에서 엄청난 기척이 느껴진다 "
			CALL INPUT_SELECT_D, "[0] 안쪽으로 간다/[1] 가지 않는다 "
			IF RESULT == 0
				RETURN 1
			ELSE
				RETURN 0
			ENDIF
		ENDIF
ENDSELECT
RETURN 1
;=======================================================================
;精神世界タイル
;=======================================================================
;イベントタイル特殊表示4
@TILE_MARK_COMMON_13_SEISIN_4, ARG, ARG:1, ARG:2
SELECTCASE ARG / 10
	CASEELSE
		RESULTS = ！
ENDSELECT

;イベントタイル特殊表示9
@TILE_MARK_COMMON_13_SEISIN_9, ARG , ARG:1 , ARG:2
SELECTCASE ARG / 10
	CASE 4505, 4501, 4503, 4506, 4511, 4513, 4515, 4518
		IF GET_FLOOR_ANALYZE_T(ARG:1, ARG:2) >= 2
			RESULTS = ◎
			SETCOLOR 0x00ff00
		ELSE
			RESULTS = ！
		ENDIF
	CASEELSE
		RESULTS = ！
		SIF GET_FLOOR_ANALYZE_T(ARG:1, ARG:2) >= 2
			SETCOLOR 0x00ff00
ENDSELECT

