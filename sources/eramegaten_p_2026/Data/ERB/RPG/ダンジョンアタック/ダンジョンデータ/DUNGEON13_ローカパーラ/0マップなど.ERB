			FLAG:인카운트율 = FLAG:미조우걸음수*1
		ELSE
			FLAG:인카운트율 = 0
		ENDIF
	CASE 41,42
		SIF FLAG:미조우걸음수 > 10
			FLAG:인카운트율 = (FLAG:미조우걸음수 - 10)*3
	CASE 44,45
		SIF FLAG:미조우걸음수 > 10 && DA:(FLAG:현X):(FLAG:현Y) % 10 == 0
			FLAG:인카운트율 = (FLAG:미조우걸음수 - 10)*3
		SIF DA:(FLAG:현X):(FLAG:현Y) % 10 != 0
			FLAG:MAG소비율 = 0
	;,51,52
	CASE 47,53
		SIF FLAG:미조우걸음수 > 10
			FLAG:인카운트율 = (FLAG:미조우걸음수 - 10)*3
	CASE 50
		SIF FLAG:미조우걸음수 > 10 && GETBIT(FLAG_D13_仮想空間その他イベント,16) && GETBIT(FLAG_D13_仮想空間その他イベント,17) && GETBIT(FLAG_D13_仮想空間その他イベント,18)
			FLAG:인카운트율 = (FLAG:미조우걸음수 - 10)*3
	CASE 55,56,57,58,62
		FLAG:인카운트율 = FLAG:미조우걸음수*1
	CASE 59,60,61
		FLAG:인카운트율 = 0
