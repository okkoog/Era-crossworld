			SIF FLAG:미조우걸음수 > 10
				FLAG:인카운트율 = (FLAG:미조우걸음수 - 10)*3
		ELSE
			FLAG:인카운트율 = 0
		ENDIF
	CASE 18,19,21,22,23
		IF FLAG_D13_協会・空港イベント進行度 > 0 && FLAG_D13_協会・空港イベント進行度 < 4
			SIF FLAG:미조우걸음수 > 10
				FLAG:인카운트율 = (FLAG:미조우걸음수 - 10)*3
		ELSE
			FLAG:인카운트율 = 0
		ENDIF
	CASE 28,29,30
