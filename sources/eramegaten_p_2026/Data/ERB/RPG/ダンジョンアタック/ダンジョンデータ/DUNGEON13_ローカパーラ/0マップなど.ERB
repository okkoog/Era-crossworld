	CALL JUMPING_13
	IF FLAG:현M == 15
		FLAG:미조우걸음수++
		CALL MAKE_FLOOR, FLAG:현던전
		RETURN 0
	ENDIF
ELSEIF FLAG:현M == 0 && FLAG:현X > 23 && FLAG:현Y > 19
	CALL DUNGEON_WORP,0,14,18

;==========
;出口の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 8
	FLAG:인카운트율 = 0
	IF FLAG_D13_全体イベント進行度 > 2 && FLAG_D13_全体イベント進行度 != 14
		PRINTFORML 어디로 가시겠습니까？
		PRINTFORML [ 0] 로카파라 아지트
		PRINTFORML [ 1] 카르마 시티 시가지
		IF FLAG_D13_全体イベント進行度 > 15
			PRINTFORML [ 2] 태양으로의 길
		ELSEIF FLAG_D13_全体イベント進行度 > 4
			PRINTFORML [ 2] 잘란다라 아지트
		ENDIF
		PRINTFORML [10] 돌아간다
		INPUT
		IF RESULT == 0
			CALL DUNGEON_WORP,0,3,2
		ELSEIF RESULT == 1
			CALL DUNGEON_WORP,14,3,12
		ELSEIF RESULT == 2 && FLAG_D13_全体イベント進行度 > 15
			CALL DUNGEON_WORP,63,6,4
		ELSEIF RESULT == 2 && FLAG_D13_全体イベント進行度 > 4
			CALL DUNGEON_WORP,99,2,47
		ELSEIF RESULT == 10
			CALL DUNGEON_EXIT
			RETURN 1
		ENDIF
	ELSE
		CALL DUNGEON_EXIT
		RETURN 1
	ENDIF
;========
;宝の処理
;========
;% 10は10で割ったあまり、つまり下一桁がでてきます
;そして、下一桁はタイルの種類を表す
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
	IF FLAG:현M == 15
		FLAG:미조우걸음수++
		CALL MAKE_FLOOR, FLAG:현던전
		RETURN 0
	ENDIF
	CALL TREASURE_13
	RETURN RESULT
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 6
	CALL UPSTAIRS_13
	RETURN RESULT

ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 7
	CALL DOWNSTAIRS_13
	RETURN RESULT
;========
;이벤트
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 4
	TRYCALLFORM EVENT_CHECK_DUNGEON_13_%DUNGEON_13_FUNC_NAME()%_4
	;タイルを破壊するために作り直し
	CALL MAKE_FLOOR, FLAG:현던전
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 9
	SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
		;ローカパーライベント
		CASE 0
			IF FLAG_D13_全体イベント進行度 > 0
				CALL DUNGEON_TERMINAL
			ENDIF
		CASE 1
			IF FLAG_D13_全体イベント進行度 > 0
				CALL MESSAGE_WINDOW_D, "", "여기서 동료의 교체가 가능할 것 같다 "
				CALL INPUT_SELECT_D, "[0]동료를 교체한다/[1]아무것도 아니다 "
				SIF RESULT == 0
					CALL RECONSTRUCTION
			ENDIF
		CASE 2
			CALL Lokapala_event2
	ENDSELECT
	IF FLAG:현M == 15
		FLAG:미조우걸음수++
		CALL MAKE_FLOOR, FLAG:현던전
		RETURN 0
	ENDIF
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 5
ELSE
	IF FLAG:현M == 15
		FLAG:미조우걸음수++
		CALL MAKE_FLOOR, FLAG:현던전
		RETURN 0
	ELSE
		CALL MESSAGE_WINDOW_D, "", "＞아무것도 없는 것 같다"
		RETURN 0
	ENDIF
	;タイルを破壊するために作り直し
	CALL MAKE_FLOOR, FLAG:현던전
ENDIF
RETURN 0

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_13,ARG
#LOCALSIZE 4
#LOCALSSIZE 1
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
;ARG = 進入時の向き　0の場合ワープなど
;RESTART

;LOCAL 51の滑る床用
SIF FLAG:현M == 15
	CALL onmitsu_event
;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) % 10 == 8
	FLAG:인카운트율 = 0
	IF FLAG_D13_全体イベント進行度 > 2
		PRINTFORML 어디로 갑니까？
		PRINTFORML [ 0] 로카파라 아지트
		PRINTFORML [ 1] 카르마 시티 시가지
		IF FLAG_D13_全体イベント進行度 > 15
			PRINTFORML [ 2] 태양으로의 길
		ELSEIF FLAG_D13_全体イベント進行度 > 4
			PRINTFORML [ 2] 잘란다라 아지트
		ENDIF
		PRINTFORML [10] 돌아간다
		INPUT
		IF RESULT == 0
			CALL DUNGEON_WORP,0,3,2
		ELSEIF RESULT == 1
			CALL DUNGEON_WORP,14,3,12
		ELSEIF RESULT == 2 && FLAG_D13_全体イベント進行度 > 15
			CALL DUNGEON_WORP,63,6,4
		ELSEIF RESULT == 2 && FLAG_D13_全体イベント進行度 > 4
			CALL DUNGEON_WORP,99,2,47
		ELSEIF RESULT == 10
			CALL DUNGEON_EXIT
			RETURN 1
		ENDIF
	ELSE
		CALL DUNGEON_EXIT
		RETURN 1
	ENDIF
;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
	CALL TREASURE_13
	RETURN RESULT
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 6
	CALL UPSTAIRS_13
	RETURN RESULT

ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 7
	CALL DOWNSTAIRS_13
	RETURN RESULT

;==========
;扉の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 2
	CALL DUNGEON_DOOR,ARG
	SIF DA:(FLAG:현X):(FLAG:현Y) != 2
		RETURN 0
	RETURN 1

;==========
;罠の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 1
	IF DA:(FLAG:현X):(FLAG:현Y) == 11
		TWAIT 100, 0
		FLAG:현Y--
		CALL AUTOMAP
		CALL SHOW_PICTURE, "D"
		CALL SHOW_DUNGEON_COMMAND
		TWAIT 100, 0
		RETURN 2, 8
		;LOCAL = 8
		;CALL DUNGEON_WORP,(FLAG:현M),(FLAG:현X),(FLAG:현Y)
		;CALL SHOW_FORCEMOVE, "U", "D", , ,  ""
	ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 21
		TWAIT 100, 0
		FLAG:현Y++
		CALL AUTOMAP
		CALL SHOW_PICTURE, "D"
		CALL SHOW_DUNGEON_COMMAND
		TWAIT 100, 0
		RETURN 2, 2
		;LOCAL = 2
		;CALL DUNGEON_WORP,(FLAG:현M),(FLAG:현X),(FLAG:현Y)
		;CALL SHOW_FORCEMOVE, "D", "D", , ,  ""
	ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 31
		TWAIT 100, 0
		FLAG:현X++
		CALL AUTOMAP
		CALL SHOW_PICTURE, "D"
		CALL SHOW_DUNGEON_COMMAND
		TWAIT 100, 0
		RETURN 2, 6
		;LOCAL = 6
		;CALL DUNGEON_WORP,(FLAG:현M),(FLAG:현X),(FLAG:현Y)
		;CALL SHOW_FORCEMOVE, "R", "D", , ,  ""
	ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 41
		TWAIT 100, 0
		FLAG:현X--
		CALL AUTOMAP
		CALL SHOW_PICTURE, "D"
		CALL SHOW_DUNGEON_COMMAND
		TWAIT 100, 0
		RETURN 2, 4
		;LOCAL = 4
		;CALL DUNGEON_WORP,(FLAG:현M),(FLAG:현X),(FLAG:현Y)
		;CALL SHOW_FORCEMOVE, "L", "D", , ,  ""
	ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 51
		L_X = FLAG:현X
		L_Y = FLAG:현Y
		SELECTCASE ARG
			CASE 8
				L_Y = CONVERT_OUTRANGE_COORD_Y(L_Y - 1)
			CASE 6
				L_X = CONVERT_OUTRANGE_COORD_X(L_X + 1)
			CASE 2
				L_Y = CONVERT_OUTRANGE_COORD_Y(L_Y + 1)
			CASE 4
				L_X = CONVERT_OUTRANGE_COORD_X(L_X - 1)
		ENDSELECT
		;高さ判定
		SIF GROUPMATCH(DA:L_X:L_Y, 25, 35)
			RETURN 0
		CALL CAN_ENTER, L_X, L_Y
		SIF !RESULT
			RETURN 0
		FLAG:현X = L_X
		FLAG:현Y = L_Y
		CALL AUTOMAP
		CALL SHOW_PICTURE, "D"
		CALL SHOW_DUNGEON_COMMAND
		TWAIT 100, 0
		RETURN 2, ARG
	ENDIF
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 5
	IF DA:(FLAG:현X):(FLAG:현Y) == 95
		CALL MESSAGE_B,3, "함정이다！"
		CALL DUNGEON_WORP,(FLAG:현M)-1,(FLAG:현X),(FLAG:현Y)
	ELSEIF FLAG:현M > 50 && FLAG:현M < 53 && DA:(FLAG:현X):(FLAG:현Y) < 36
		CALL 床崩れ
	ELSEIF DA:(FLAG:현X):(FLAG:현Y) > 35 && FLAG:현M != 15
		CALL TRAP_13
		RETURN RESULT
	ENDIF

;========================
;이벤트
;========================
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 4
	SELECTCASE DA:(FLAG:현X):(FLAG:현Y) /10
		;１Ｆイベント
		CASE 1
	ENDSELECT
	TRYCALLFORM EVENT_ENTER_DUNGEON_13_%DUNGEON_13_FUNC_NAME()%_4
	;タイルを破壊するために作り直し
	CALL MAKE_FLOOR, FLAG:현던전
ELSEIF DA:(FLAG:현X):(FLAG:현Y) %10 == 9
	SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
		;ローカパーライベント
		CASE 0
			IF FLAG_D13_全体イベント進行度 > 0
				CALL DUNGEON_TERMINAL
			ENDIF
		CASE 1
			IF FLAG_D13_全体イベント進行度 > 0
				CALL MESSAGE_WINDOW_D, "", "여기서 동료의 교체가 가능할 것 같다 "
				CALL INPUT_SELECT_D, "[0]동료를 교체한다/[1]아무것도 아니다 "
				SIF RESULT == 0
					CALL RECONSTRUCTION
			ENDIF
	ENDSELECT
	TRYCALLFORM EVENT_ENTER_DUNGEON_13_%DUNGEON_13_FUNC_NAME()%_9
	;タイルを破壊するために作り直し
	CALL MAKE_FLOOR, FLAG:현던전
ENDIF
RETURN 0





