#DIM DYNAMIC L_TILE
#DIM DYNAMIC PREV_TILE
#DIM DYNAMIC NEXT_TILE
#DIM DYNAMIC L_DIRECTION
#DIM DYNAMIC L_ROUTENUM
#DIM DYNAMIC NEXT_X
#DIM DYNAMIC NEXT_Y
SELECTCASE L_DIRECTION
	CASE 2
		NEXT_X = CONVERT_OUTRANGE_COORD_X(L_X)
		NEXT_Y = CONVERT_OUTRANGE_COORD_Y(L_Y + 1)
	CASE 6
		NEXT_X = CONVERT_OUTRANGE_COORD_X(L_X + 1)
		NEXT_Y = CONVERT_OUTRANGE_COORD_Y(L_Y)
	CASE 8
		NEXT_X = CONVERT_OUTRANGE_COORD_X(L_X)
		NEXT_Y = CONVERT_OUTRANGE_COORD_Y(L_Y - 1)
	CASE 4
		NEXT_X = CONVERT_OUTRANGE_COORD_X(L_X - 1)
		NEXT_Y = CONVERT_OUTRANGE_COORD_Y(L_Y)
	CASEELSE
		NEXT_X = -1
		NEXT_Y = -1
ENDSELECT
PREV_TILE = DA:(FLAG:현X):(FLAG:현Y)
L_TILE = DA:L_X:L_Y
IF NEXT_X >= 0 && NEXT_Y >= 0
	NEXT_TILE = DA:NEXT_X:NEXT_Y
ELSE
	NEXT_TILE = -99
ENDIF
;段差から降りる動きの時にジャンプの判定を行う
IF !IS_AUTORUN_SEARCHING
	IF L_DIRECTION > 0 && INRANGE(GET_HEIGHT_DUNGEON_13(PREV_TILE), 1, 3) && GET_HEIGHT_DUNGEON_13(NEXT_TILE) == GET_HEIGHT_DUNGEON_13(PREV_TILE) && (GET_HEIGHT_DUNGEON_13(NEXT_TILE) - GET_HEIGHT_DUNGEON_13(L_TILE)) > 0
		SELECTCASE L_DIRECTION
			CASE 2
				CALL SHOW_FORCEMOVE, "DD", "D", , ,  "南に飛んだ"
			CASE 6
				CALL SHOW_FORCEMOVE, "RR", "D", , ,  "東に飛んだ"
			CASE 8
				CALL SHOW_FORCEMOVE, "UU", "D", , ,  "北に飛んだ"
			CASE 4
				CALL SHOW_FORCEMOVE, "LL", "D", , ,  "西に飛んだ"
		ENDSELECT
		RETURN 0
	ENDIF
ENDIF
IF INRANGE(GET_HEIGHT_DUNGEON_13(L_TILE), 1, 3) && (GET_HEIGHT_DUNGEON_13(L_TILE) - GET_HEIGHT_DUNGEON_13(PREV_TILE) > 1)
	PRINTW 너무 높아서 기어올라갈 수 없다…
	RETURN 0
ENDIF
IF GROUPMATCH(L_TILE, 12, 22, 32, 42)
	;ギミックそのものが死ぬのとかなり見た目の効率が悪くマップの穴埋めをしようとしてしまうので自動探索では通過させない
	;(マウスクリックは通す)
	SIF IS_AUTO_PIROT
		RETURN 0
	SIF L_TILE == 12 && L_DIRECTION != 8
		RETURN 0
	SIF L_TILE == 22 && L_DIRECTION != 2
		RETURN 0
	SIF L_TILE == 32 && L_DIRECTION != 6
		RETURN 0
	SIF L_TILE == 42 && L_DIRECTION != 4
		RETURN 0
ENDIF
RESULT = 1
TRYCALLFORM DUNGEON_BEFORE_ENTER_EVENT_13_%DUNGEON_13_FUNC_NAME()%, L_X, L_Y, 0
SIF RESULT == 0
	RETURN 0
CALL CAN_ENTER,L_X,L_Y
RETURN RESULT

