	MONEY += 100000
	FLAG:명성 += 40
	FLAG_D13_地下街報酬受領 = 1
ENDIF

IF GETCHARA([[キャラ:치하야]]) > 0 && 陥落(GETCHARA([[キャラ:치하야]])) > 0 && FLAG_D13_千早の状態 == 3 && FLAG_D13_全体イベント進行度 > 2
	IF FLAG_D13_千早の稼ぎ制御 != DAY
		LOCAL = (50+ RAND:100) * 陥落(GETCHARA([[キャラ:치하야]]))
	CALL MESSAGE_WINDOW_D, "", @"치하야는" + TOSTR(LOCAL) + "마카를 벌어왔다"
		MONEY:1 += LOCAL
		FLAG_D13_千早の稼ぎ制御 = DAY
	ENDIF
ENDIF
FLAG_D13_占い効果 = 0
FLAG:탈출스킬금지 = 0
;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@JUDGE_CAN_ENTER_13, L_X, L_Y, L_DIRECTION, L_ROUTENUM = -1, DUNGEON_TILE_SEARCH_TASK
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC L_TILE
#DIM DYNAMIC PREV_X
#DIM DYNAMIC PREV_Y
#DIM DYNAMIC PREV_TILE
#DIM DYNAMIC L_DIRECTION
#DIM DYNAMIC L_ROUTENUM
#DIM REF DUNGEON_TILE_SEARCH_TASK
#DIM IS_JUMPING
L_TILE = DA:L_X:L_Y
;前のタイル情報を取る
IF L_DIRECTION > 0
	PREV_X = DUNGEON_TILE_SEARCH_TASK:L_ROUTENUM / 1000
	PREV_Y = DUNGEON_TILE_SEARCH_TASK:L_ROUTENUM % 1000
	PREV_TILE = DA:PREV_X:PREV_Y
ELSE
	PREV_X = -1
	PREV_Y = -1
	PREV_TILE = -1
ENDIF

;ARG、ARG:1はそれぞれ対象のマスのX、Y座標を表しています

;高さがある場合の判定
IF INRANGE(GET_HEIGHT_DUNGEON_13(L_TILE), 1, 3)
	;現在ジャンプできる場所からジャンプ先への経路を通す
	;ゴール座標と探査座標が一致(ジャンプ先を直接クリックした場合)
	;DA:ARG:(ARG:1)
	IF !IS_AUTORUN_SEARCHING
		IF GOLE_X == L_X && GOLE_Y == L_Y
			IF L_DIRECTION == 0
				RETURN 1
			ELSE
				;段差で床を挟んでいる
				IF (GET_HEIGHT_DUNGEON_13(L_TILE) - GET_HEIGHT_DUNGEON_13(PREV_TILE)) > 0
					IF (GROUPMATCH(L_X, PREV_X, FLAG:현X) == 2 && ABS(L_Y - FLAG:현Y) == 2 && ABS(PREV_Y - FLAG:현Y) == 1)　|| (ABS(L_X - FLAG:현X) == 2  && ABS(PREV_X - FLAG:현X) == 1 && GROUPMATCH(L_Y, PREV_Y, FLAG:현Y) == 2)
						RETURN 1
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	SIF PREV_TILE >= 0 && GET_HEIGHT_DUNGEON_13(L_TILE) - GET_HEIGHT_DUNGEON_13(PREV_TILE) > 1
		RETURN 0
ENDIF
;そのほか汎用床
SELECTCASE L_TILE
	;4方向滑り床
	CASE 11,21,31,41
		;直指定かつ滑り床以外から侵入してきた場合のみ通す
		IF GOLE_X == L_X && GOLE_Y == L_Y && !GROUPMATCH(PREV_TILE, 11, 21, 31, 41)
			RETURN 1
		ELSE
			RETURN 0
		ENDIF
	;滑る床
	CASE 51
		RETURN 1
	;↑扉
	CASE 12, 22, 32, 42
		IF IS_AUTORUN_SEARCHING
			RETURN GET_FLOOR_ANALYZE_T(L_X, L_Y) < 2
		ELSE
			;直クリックは始動のために判定を通す
			IF GOLE_X == L_X && GOLE_Y == L_Y
				RETURN 1
			ELSE
				SELECTCASE L_TILE
					CASE 12
						RETURN L_DIRECTION == 2
					CASE 22
						RETURN L_DIRECTION == 8
					CASE 32
						RETURN L_DIRECTION == 6
					CASE 42
						RETURN L_DIRECTION == 4
				ENDSELECT
			ENDIF
		ENDIF
ENDSELECT
RESULT = 1
TRYCALLFORM DUNGEON_BEFORE_ENTER_EVENT_13_%DUNGEON_13_FUNC_NAME()%, L_X, L_Y, 1
SIF !RESULT
	RETURN 0
CALL CAN_ENTER, L_X, L_Y
RETURN RESULT

