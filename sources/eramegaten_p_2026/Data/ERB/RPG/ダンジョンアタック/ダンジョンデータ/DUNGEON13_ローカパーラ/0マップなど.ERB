			FLAG:인카운트율 = (FLAG:미조우걸음수 - 10)*5
	CASE 74,75,76
		SIF FLAG:미조우걸음수 > 10 && DA:(FLAG:현X):(FLAG:현Y) % 10 == 0
			FLAG:인카운트율 = (FLAG:미조우걸음수 - 10)*3
