		CASE 3
			SIF DA:(ARG):(ARG:1) % 10 - DA:(FLAG:현X):(FLAG:현Y) % 10 > 2
				RETURN 2
	ENDSELECT
	RETURN 0
ENDIF
SELECTCASE DA:(ARG):(ARG:1)
	CASE 12,22,32,42
