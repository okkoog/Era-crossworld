				SIF GETBIT(FLAG_D13_仮想空間その他イベント,8) && GETBIT(FLAG_D13_仮想空間その他イベント,9)
					CALL MESSAGE_WINDOW_D, "", "어딘가에서 문이 열리는 소리가 났다 "
			ENDIF
		ELSE
			CALL MESSAGE_WINDOW_D, "", "이미 눌려 있다 "
