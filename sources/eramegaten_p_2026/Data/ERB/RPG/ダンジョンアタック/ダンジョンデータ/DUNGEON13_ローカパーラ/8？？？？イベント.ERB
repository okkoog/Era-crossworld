			ELSEIF GETBIT(FLAG_D13_仮想空間その他イベント,6) && !GETBIT(FLAG_D13_仮想空間その他イベント,7)
				SETBIT FLAG_D13_仮想空間その他イベント,7
			ELSE
				CLEARBIT FLAG_D13_仮想空間その他イベント,6
				CLEARBIT FLAG_D13_仮想空間その他イベント,7
			ENDIF
			FLAG_D13_仮想空間ボタン押し数 ++
			CALL DUNGEON_WORP,(FLAG:현M),(FLAG:현X),(FLAG:현Y)
	CASE 4905
		IF !GETBIT(FLAG_D13_仮想空間その他イベント,8)
			CALL INPUT_SELECT_D, "[0]스위치를 누른다/[1]스위치를 누르지 않는다 "
			IF RESULT == 0
				SETBIT FLAG_D13_仮想空間その他イベント,8
				SIF GETBIT(FLAG_D13_仮想空間その他イベント,8) && GETBIT(FLAG_D13_仮想空間その他イベント,9)
