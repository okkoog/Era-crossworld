;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@DUNGEON_BEFORE_ENTER_EVENT_13_kasou,L_X,L_Y,IS_ROUTE_SEARCH
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC IS_ROUTE_SEARCH
SELECTCASE DA:L_X:L_Y
	CASE 48102
		IF IS_ROUTE_SEARCH
			IF IS_AUTORUN_SEARCHING
				RETURN GET_FLOOR_ANALYZE_T(L_X, L_Y) < 2
			ELSE
				RETURN 1
			ENDIF
		ELSE
			CALL MESSAGE_WINDOW_D, "", "문 너머에서 기척이 느껴진다 "
			CALL INPUT_SELECT_D, "[0] 안쪽으로 간다/[1] 가지 않는다 "
			IF RESULT == 0
				RETURN 1
			ELSE
				RETURN 0
			ENDIF
		ENDIF
	CASE 49102
		IF IS_ROUTE_SEARCH
			IF IS_AUTORUN_SEARCHING
				RETURN GET_FLOOR_ANALYZE_T(L_X, L_Y) < 2
			ELSE
				RETURN 1
			ENDIF
		ELSE
			CALL MESSAGE_WINDOW_D, "", "＞문이 닫혀있다 "
			RETURN 0
		ENDIF
	CASE 50102
		IF IS_ROUTE_SEARCH
			IF IS_AUTORUN_SEARCHING
				RETURN GET_FLOOR_ANALYZE_T(L_X, L_Y) < 2
			ELSE
				RETURN 1
			ENDIF
		ELSE
			IF GETBIT(FLAG_D13_仮想空間その他イベント,16) && GETBIT(FLAG_D13_仮想空間その他イベント,17) && GETBIT(FLAG_D13_仮想空間その他イベント,18)
				CALL MESSAGE_WINDOW_D, "", "문 너머에서 기척이 느껴진다 "
				CALL INPUT_SELECT_D, "[0] 안쪽으로 간다/[1] 가지 않는다 "
				IF RESULT == 0
					RETURN 1
				ELSE
					RETURN 0
				ENDIF
			ELSE
				CALL MESSAGE_WINDOW_D, "", "문은 굳게 닫혀 있다 "
				RETURN 0
			ENDIF
		ENDIF
	CASE 53102
		IF IS_ROUTE_SEARCH
			IF IS_AUTORUN_SEARCHING
				RETURN GET_FLOOR_ANALYZE_T(L_X, L_Y) < 2
			ELSE
				RETURN 1
			ENDIF
		ELSE
			CALL MESSAGE_WINDOW_D, "", "문 너머에서 엄청난 기척이 느껴진다 "
			CALL INPUT_SELECT_D, "[0] 안쪽으로 간다/[1] 가지 않는다 "
			IF RESULT == 0
				RETURN 1
			ELSE
				RETURN 0
			ENDIF
		ENDIF
	CASE 53007
		IF IS_ROUTE_SEARCH
			IF IS_AUTORUN_SEARCHING
				RETURN GET_FLOOR_ANALYZE_T(L_X, L_Y) < 2
			ELSE
				RETURN 1
			ENDIF
		ELSE
			IF FLAG_D13_仮想空間イベント進行度 == 9
				CALL MESSAGE_WINDOW_D, "", "＞빨리 탈출해야 한다 "
				RETURN 0
			ENDIF
		ENDIF
ENDSELECT
RETURN 1
;=======================================================================
;仮想空間タイル
;=======================================================================
;イベントタイル特殊表示4
@TILE_MARK_COMMON_13_kasou_4, ARG, ARG:1, ARG:2
SELECTCASE ARG / 10
	CASE 4600
		SETCOLOR 0x00ff00
		RESULTS = 双
	CASE 4601
		SETCOLOR 0x00ff00
		RESULTS = ゲ
	CASE 4602
		SETCOLOR 0x00ff00
		RESULTS = Ｈ
	CASE 4800,4900,5100,5300
		SETCOLOR 0x00ff00
		RESULTS = 戻
	CASEELSE
		RESULTS = ！
		;IF (ARG / 10) % 100 == 0
		;	SETCOLOR 0x00ff00
		;	RESULTS = 戻
		;
		;ELSE
		;	RESULTS = ！
		;ENDIF
ENDSELECT

;イベントタイル特殊表示9
@TILE_MARK_COMMON_13_kasou_9, ARG , ARG:1 , ARG:2
SELECTCASE ARG / 10
	CASE 4800, 5000, 5300
		RESULTS = ！
	CASEELSE
		RESULTS = □
ENDSELECT

;=======================================================================
;仮想空間タイル破棄
;イベントが終わった床・扉を通常マスに置き換える
;=======================================================================
@REPLACE_TILE_DUNGEON_13_kasou,ARG, ARG:1, ARG:2
SELECTCASE ARG % 10
	CASE 2
		SELECTCASE ARG / 10
			CASE 4810
				SIF FLAG_D13_仮想空間イベント進行度 >= 3
					DA:(ARG:1):(ARG:2) = 2
			CASE 4910
				SIF GETBIT(FLAG_D13_仮想空間その他イベント,8) && GETBIT(FLAG_D13_仮想空間その他イベント,9)
					DA:(ARG:1):(ARG:2) = 2
			CASE 5010
				SIF FLAG_D13_仮想空間イベント進行度 >= 6
					DA:(ARG:1):(ARG:2) = 2
			CASE 5310
				SIF FLAG_D13_仮想空間イベント進行度 >= 9
					DA:(ARG:1):(ARG:2) = 2
		ENDSELECT
	CASE 9
		SELECTCASE ARG / 10
			CASE 4800
				SIF FLAG_D13_仮想空間イベント進行度 >= 3
					DA:(ARG:1):(ARG:2) = 1
			CASE 5000
				SIF FLAG_D13_仮想空間イベント進行度 >= 6
					DA:(ARG:1):(ARG:2) = 1
			CASE 5300
				SIF FLAG_D13_仮想空間イベント進行度 >= 9
					DA:(ARG:1):(ARG:2) = 1
		ENDSELECT
ENDSELECT
;=======================================================================
;仮想空間調べイベント(4)
;=======================================================================
@EVENT_CHECK_DUNGEON_13_kasou_4
#DIM LX
#DIM LY

SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
	CASE 4600
		IF !GETBIT(FLAG_D13_仮想空間その他イベント,21)
			CALL MESSAGE_WINDOW_D, "후타바", "가상공간에 가기 전에 이걸 받아줘/ＣＯＭＰ에서 카르마 단말기의 일부 기능을 사용할 수 있게 될 거야 "
			CALL MESSAGE_WINDOW_D, "", "＞인스톨소프트「우파니샤드」를 입수했다 "
			IF HAVE_INSTALLSOFT("우파니샤드")
				CALLFORM INSTALLSOFT_PRICE_{GET_INSTALLSOFT_NUM("우파니샤드")}
				MONEY:1 += RESULT
				LOCALS = {RESULT}
				CALL MESSAGE_WINDOW_D, "", "＞이미 가지고 있었기 때문에" + LOCALS + "마카를 얻었다 "
			ELSE
				CALL GETS_INSTALLSOFT, "우파니샤드"
			ENDIF
			SETBIT FLAG_D13_仮想空間その他イベント,21
		ENDIF
		CALL MESSAGE_WINDOW_D, "후타바", "준비됐어？/가상공간에 갈까？ "
		CALL INPUT_SELECT_D, "[0]간다/[1]가지 않는다 "
		IF RESULT == 0
			SIF FLAG_D13_仮想空間イベント進行度 == 0
				CALL DUNGEON_WORP,47,1,9
			SIF FLAG_D13_仮想空間イベント進行度 > 0
				CALL DUNGEON_WORP,48,8,1
			SIF FLAG_D13_仮想空間イベント進行度 > 3
				CALL DUNGEON_WORP,49,8,2
			SIF FLAG_D13_仮想空間イベント進行度 > 6
				CALL DUNGEON_WORP,51,8,2
			SIF FLAG_D13_仮想空間イベント進行度 > 7
				CALL DUNGEON_WORP,53,1,3
		ENDIF
		IF FLAG_D13_仮想空間イベント進行度 > 7 && (GETBIT(FLAG:발견ED, 45) || FLAG_D13_階層踏破度 > 52)
			CALL INPUT_SELECT_D, "[0] 가장 안쪽까지 스킵한다/[1] 스킵하지 않는다 "
			SIF RESULT == 0
				CALL DUNGEON_WORP,53,1,3
		ENDIF
	CASE 4601
		CALL MESSAGE_WINDOW_D, "게일", "저 후타바라는 소녀 상당히 해킹에 능해/ "
		CALL MESSAGE_WINDOW_D, "게일", "우리도 해킹은 하고 있었지만 이렇게 까지 할 수 있는 사람은 정크야드에도/없었지 "
		IF FLAG_D13_仮想空間イベント進行度 > 0
			CALL INPUT_SELECT_D, "[0] 동료를 교체한다/[1] 아무것도 아니다/[2]개인실로 돌아간다"
		ELSE
			CALL INPUT_SELECT_D, "[0] 동료를 교체한다/[1] 아무것도 아니다 "
		ENDIF
		IF RESULT == 0
			CALL RECONSTRUCTION
		ELSEIF RESULT == 2
			CALL DUNGEON_EXIT
		ENDIF
	CASE 4602
		CALL MESSAGE_WINDOW_D, "로알드", "설마 그 기계/가상공간까지 들어갈줄은 의외인데/언제나 놀래켜 "
		CALL MESSAGE_WINDOW_D, "로알드", "어쨌든 가상공간으로 들어가서 놈들을 쓰러뜨리자 "
		IF !GETBIT(FLAG_D13_仮想空間その他イベント,0) || !GETBIT(FLAG_D13_仮想空間その他イベント,1)
			CALL MESSAGE_WINDOW_D, "로알드", "근데 회복하고 갈까？/도구는 조금밖에 없어서 무작정 사용은 못하지만 "
			LOCALS = {(!GETBIT(FLAG_D13_仮想空間その他イベント,0) + !GETBIT(FLAG_D13_仮想空間その他イベント,1))}
			CALL INPUT_SELECT_D, "[0]네(나머지" + LOCALS + "회)/[1]아니오 "
			IF RESULT == 0
				PRINTFORMW %CALLNAME:MASTER%들은 회복했다
				FOR LOCAL, 1, 7
					SIF POS(LOCAL) > -1
						CALL HEALTH_CHARA, POS(LOCAL)
				NEXT
				SIF GETBIT(FLAG_D13_仮想空間その他イベント,0)
					SETBIT FLAG_D13_仮想空間その他イベント,1
				SETBIT FLAG_D13_仮想空間その他イベント,0
			ENDIF
		ENDIF
	CASE 4801
		IF FLAG_D13_仮想空間イベント進行度 < 2
			CALL INPUT_SELECT_D, "[0]스위치를 누른다/[1]스위치를 누르지 않는다 "
			IF RESULT == 0
				FLAG_D13_仮想空間イベント進行度 = 2
				CALL DUNGEON_WORP,(FLAG:현M),(FLAG:현X),(FLAG:현Y)
			ENDIF
		ELSE
			CALL MESSAGE_WINDOW_D, "", "이미 눌려 있다 "
		ENDIF
	CASE 4901
		CALL INPUT_SELECT_D, "[0]스위치를 누른다/[1]스위치를 누르지 않는다 "
		IF RESULT == 0
			CLEARBIT FLAG_D13_仮想空間その他イベント,2
			CLEARBIT FLAG_D13_仮想空間その他イベント,3
			CLEARBIT FLAG_D13_仮想空間その他イベント,4
			CLEARBIT FLAG_D13_仮想空間その他イベント,5
			CLEARBIT FLAG_D13_仮想空間その他イベント,6
			CLEARBIT FLAG_D13_仮想空間その他イベント,7
			FLAG_D13_仮想空間ボタン押し数 += 6
			CALL DUNGEON_WORP,(FLAG:현M),(FLAG:현X),(FLAG:현Y)
		ELSE
		ENDIF
	CASE 4902
		CALL MESSAGE_WINDOW_D, "", "스위치를 눌렀다 "
			IF !GETBIT(FLAG_D13_仮想空間その他イベント,2) && !GETBIT(FLAG_D13_仮想空間その他イベント,3)
				SETBIT FLAG_D13_仮想空間その他イベント,2
			ELSEIF GETBIT(FLAG_D13_仮想空間その他イベント,2) && !GETBIT(FLAG_D13_仮想空間その他イベント,3)
				SETBIT FLAG_D13_仮想空間その他イベント,3
			ELSE
				CLEARBIT FLAG_D13_仮想空間その他イベント,2
				CLEARBIT FLAG_D13_仮想空間その他イベント,3
			ENDIF
			FLAG_D13_仮想空間ボタン押し数 ++
			CALL DUNGEON_WORP,(FLAG:현M),(FLAG:현X),(FLAG:현Y)
	CASE 4903
		CALL MESSAGE_WINDOW_D, "", "스위치를 눌렀다 "
			IF !GETBIT(FLAG_D13_仮想空間その他イベント,4) && !GETBIT(FLAG_D13_仮想空間その他イベント,5)
				SETBIT FLAG_D13_仮想空間その他イベント,4
			ELSEIF GETBIT(FLAG_D13_仮想空間その他イベント,4) && !GETBIT(FLAG_D13_仮想空間その他イベント,5)
				SETBIT FLAG_D13_仮想空間その他イベント,5
			ELSE
				CLEARBIT FLAG_D13_仮想空間その他イベント,4
				CLEARBIT FLAG_D13_仮想空間その他イベント,5
			ENDIF
			FLAG_D13_仮想空間ボタン押し数 ++
			CALL DUNGEON_WORP,(FLAG:현M),(FLAG:현X),(FLAG:현Y)
	CASE 4904
		CALL MESSAGE_WINDOW_D, "", "스위치를 눌렀다 "
			IF !GETBIT(FLAG_D13_仮想空間その他イベント,6) && !GETBIT(FLAG_D13_仮想空間その他イベント,7)
