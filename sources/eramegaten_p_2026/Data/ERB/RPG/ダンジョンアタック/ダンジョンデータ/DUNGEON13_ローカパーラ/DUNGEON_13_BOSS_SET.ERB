#DIM DYNAMIC L_NO
#DIM DYNAMIC L_ENEMY
#DIMS DYNAMIC L_ENEMY_NAME
#DIMS DYNAMIC L_OPT
#DIMS DYNAMIC L_ENEMY_TABLE, 20

L_ENEMY_TABLE:0 '= "クバンダ","明智","ヒート","ラボ明智","ミロク菩薩"
L_ENEMY_TABLE:5 '= "クリシュナ","メーガナーダ","バエル","ジェナ","ヴリュンヒルド"
