@GET_BOSS_NAME_TABLE_DUNGEON_13,ARG
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "クバンダ"
	CASE 1
		RETURNF "明智"
	CASE 2
		RETURNF "ヒート"
	CASE 3
		RETURNF "ラボ明智"
	CASE 4
		RETURNF "ミロク菩薩"
	CASE 5
		RETURNF "クリシュナ"
	CASE 6
		RETURNF "メーガナーダ"
	CASE 7
		RETURNF "バエル"
	CASE 8
		RETURNF "ジェナ"
	CASE 9
		RETURNF "ヴリュンヒルド"
	CASE 10
		RETURNF "オーディン"
	CASE 11
		RETURNF "ミトラ菩薩"
	CASE 12
		RETURNF "宇宙の卵明智"
	CASE 13
		RETURNF "イナンナ"
	CASE 14
		RETURNF "ヴィシュヌレン"
	CASE 15
		RETURNF "リアルヴァルナ"
	CASE 16
		RETURNF "カマソッソ"
	CASE 17
		RETURNF "ラーフ"
	CASE 18
		RETURNF "ラーヴァナ"
	CASE 19
		RETURNF "ブラフマー"
ENDSELECT

@SET_BOSS_ENEMY_DUNGEON_13, L_ENEMY_NAME, L_NO = -1, L_OPT
