;=======================================================================
;신주쿠위생병원
;ボス・ユキジョロウ
;追加ボス・フォルネウス
;ダンジョンナンバー3　ＭＡＰ0~5
;=======================================================================
;
;フラグ
;ダンジョンフラグ:3:0 = Ｂ１Ｆのショートカット扉
;ダンジョンフラグ:3:1 = クリアフラグ(-1.ユキジョロウに止めを刺した -2.許して仲魔になった 1.止めを刺して報酬を受け取った 2.仲魔にして報酬を受け取った)
;ダンジョンフラグ:3:11-23 = 宝箱
;
;フォルネウス出現後
;ダンジョンフラグ:3:30 = B1F扉　二度目
;ダンジョンフラグ:3:31 = 1.フォルネウス登場、2.撃破
;ダンジョンフラグ:3:32-37 = 新宝箱
;ダンジョンフラグ:3:38 = フォルネウス残HPフラグ(1.HP半分削った 2.HP75%削った)
;
;新宿フラグ
;ダンジョンフラグ:42:31 = フォルネウスフラグ(bit1.病院クリアして新宿入った bit2.デカラビアの独り言聞いた 3.見逃した 4.刺身にした)

;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_3
;エコービルクリア
SIF ダンジョンフラグ:1:1 == 0
	RETURN 0
RETURN 1


;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_3
#FUNCTIONS
RESULTS_F = 新宿衛生病院


;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_3
;入口のターミナルを登録しておく
REACHED_TERMINAL:(FLAG:현던전):0 = 1

;フォルネウス出現フラグ立てた(デカラビアの独り言でフォルネウスの事を聞いていて病院クリア済みで新宿で悪魔の薬クリア済み)後の初回進入
IF (ダンジョンフラグ:42:31 & 2) != 0 && ダンジョンフラグ:3:1 >= 1 && ダンジョンフラグ:42:0 >= 1 && ダンジョンフラグ:3:31 == 0
	CALL MESSAGE_WINDOW_D, "", "＞여기에 신주쿠의 데카라비아가 말한 포르네우스가 있는 것 같다。"
	ダンジョンフラグ:3:31 = 1
	
	ダンジョンフラグ:3:32 = 1
	ダンジョンフラグ:3:33 = 1
	ダンジョンフラグ:3:34 = 1
	ダンジョンフラグ:3:35 = 1
	ダンジョンフラグ:3:36 = 1
	ダンジョンフラグ:3:37 = 1
ENDIF
FLAG:MAG소비율 = 75


;=======================================================================
;脱出時のイベント
;=======================================================================
@EVENT_DUNGEON_END_3
IF ダンジョンフラグ:3:1 == -1
	CALL MESSAGE_WINDOW_D, "", "＞현상 수배범・귀녀 유키죠로를 토벌하여、/＞계좌에 ￥37500이 지급되었고、명성 45를 얻었다/＞위생 병원을 개방해、신주쿠 주변에 갈 수 있게 되었다！"
	MONEY += 37500
	FLAG:명성 += 45
	ダンジョンフラグ:3:1 = 1
;倒してはない
ELSEIF ダンジョンフラグ:3:1 == -2
	CALL MESSAGE_WINDOW_D, "", "＞현상 수배범・귀녀 유키죠로를 물리쳐、/＞계좌에 ￥37500이 지급되었고、명성 45를 얻었다/＞위생 병원을 개방해、신주쿠 주변에 갈 수 있게 되었다！"
	MONEY += 37500
	FLAG:명성 += 45
	ダンジョンフラグ:3:1 = 2

ENDIF
;=======================================================================
;フロア名表示
;=======================================================================
@FLOORNAME_3
PRINT 신주쿠위생병원
SELECTCASE FLAG:현M
	CASE 0
		PRINTL 본원Ｂ１Ｆ
	CASE 1
		PRINTL 본원１Ｆ
	CASE 2
		PRINTL 본원２Ｆ
	CASE 3
		PRINTL 분원Ｂ１Ｆ
	CASE 4
		PRINTL 분원１Ｆ
	CASE 5
		PRINTL 분원２Ｆ
		
	CASEELSE
		PRINTL
ENDSELECT
;=======================================================================
;ターミナルマップ
;RESULT:X = 1で階層Mのマップのターミナルを登録できる
;登録されたターミナル同士は相互で移動が可能になり、スタート地点から選べるようになる
;=======================================================================
@TERMINAL_MAP_3, IS_START
#DIM DYNAMIC IS_START
RESULTS:100 '= "본원Ｂ１Ｆ"
RESULT:0 = 1
RESULTS:0 '= "본원Ｂ１Ｆ"
RESULT:4 = 1
RESULTS:4 '= "분원１Ｆ"
RETURN RESULT


;=======================================================================
;特殊タイル表示
;=======================================================================
@TILE_MARK_3_0_1_12
RESULTS = ←
;@TILE_MARK_3_0_6_9
;RESULTS = Ｔ
@TILE_MARK_3_2_2_14
RESULTS = ←
@TILE_MARK_3_3_17_8
RESULTS = →
@TILE_MARK_3_5_16_14
RESULTS = →


;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_3,ARG
FLAG:현M = 0
FLAG:현X = 6
FLAG:현Y = 9
;CALL AUTOMAP


;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_3,ARG,ARG:1
IF FLAG:현M == 0 && ARG == 2 && ARG:1 == 12 && ダンジョンフラグ:3:0 == 0
	CALL MESSAGE_WINDOW_D, "", "＞반대쪽에서 열쇠로 잠겨져 있는 것 같다"
	RETURN 0
ENDIF

IF FLAG:현M == 0 && ARG == 2 && ARG:1 == 12 && ダンジョンフラグ:3:0 == 1 && ダンジョンフラグ:3:30 == 0 && ダンジョンフラグ:42:0 >= 1
	CALL MESSAGE_WINDOW_D, "", "＞누군가에 의해 다시 반대측에서 열쇠로 잠겨져 있는 것 같다"
	RETURN 0
ENDIF
	
IF FLAG:현M == 1 && ARG == 7 && ARG:1 == 14 && ダンジョンフラグ:3:1 == 0
	CALL MESSAGE_WINDOW_D, "", "＞문이 얼어붙어 있다。/＞병원에서 나오려면、다른 출구를 찾든지 이 냉기의 원인을 어떻게든 할 필요가 있다。"
	RETURN 0
ENDIF

IF FLAG:현M == 1 && ARG == 7 && ARG:1 == 14 && ダンジョンフラグ:3:1 == 1 && ダンジョンフラグ:3:31 == 1 && ダンジョンフラグ:42:0 >= 1
	CALL MESSAGE_WINDOW_D, "", "＞귀녀 유키죠로를 쓰러뜨려 열었을 터인 문이 다시 얼어붙어 있다。/＞병원의 입구를 개방하기 위해서 냉기의 원인을 조사할 필요가 있을 것 같다。"
	RETURN 0
ELSEIF FLAG:현M == 1 && ARG == 7 && ARG:1 == 14 && ダンジョンフラグ:3:1 == 2 && ダンジョンフラグ:3:31 == 1 && ダンジョンフラグ:42:0 >= 1
	CALL MESSAGE_WINDOW_D, "", "＞귀녀 유키죠로를 물리쳐 열었을 터인 문이 다시 얼어붙어 있다。/＞병원의 입구를 개방하기 위해서 냉기의 원인을 조사할 필요가 있을 것 같다。"
	RETURN 0
ELSEIF FLAG:현M == 4 && ARG == 6 && ARG:1 == 12 && ダンジョンフラグ:3:1 == 0
	CALL MESSAGE_WINDOW_D, "", "＞문 너머에서 훤씬 강한 냉기가 흘러나오고 있다/＞문을 엽니까？"
	CALL INPUT_YN_D
	SIF RESULT
		RETURN 0
ENDIF

CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

