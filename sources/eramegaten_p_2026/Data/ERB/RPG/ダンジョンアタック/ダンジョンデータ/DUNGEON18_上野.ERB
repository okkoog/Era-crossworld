			CALL MESSAGE_WINDOW_D, "", "＞워프 존이다！"
			CALL DUNGEON_WORP,4,3,11
		ELSEIF FLAG:현X == 1 && FLAG:현Y == 7
			CALL MESSAGE_WINDOW_D, "", "＞워프 존이다！"
