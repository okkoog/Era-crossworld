			CALL MESSAGE_WINDOW_D, "", "＞워프 존이다！"
			CALL DUNGEON_WORP,4,13,7
		ELSEIF FLAG:현X == 9 && FLAG:현Y == 3
			CALL MESSAGE_WINDOW_D, "", "＞워프 존이다！"
