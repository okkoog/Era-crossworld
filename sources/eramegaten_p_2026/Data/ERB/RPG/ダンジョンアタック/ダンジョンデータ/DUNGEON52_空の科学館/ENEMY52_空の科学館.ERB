;----------------------------------
;ショゴス　罰ルート前座
;一斉自爆テロ子ちゃん
;----------------------------------
@SET_ACTION_ショゴス, ARG
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
SELECTCASE RAND:100
	CASE IS < 20
		IF CFLAG:ARG:BS부착률강화 < 2
			CFLAG:ARG:입력행동 = [[스킬:무거운공기]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:혼탁의장기]]
		ENDIF
	CASE IS < 40
		CFLAG:ARG:입력행동 = [[스킬:바이에이하]]
	CASE IS < 60
		CFLAG:ARG:입력행동 = [[스킬:돌격]]
	CASE IS < 80
		CFLAG:ARG:입력행동 = [[스킬:라쿤・다]]
	CASEELSE
		CFLAG:ARG:입력행동 = 0
ENDSELECT
;HP20%以下のショゴスがでたら一斉に自爆（死亡も含む）
FOR LOCAL, 7, 12
	SIF 現HP割合(POS(LOCAL)) < 20
		CFLAG:ARG:입력행동 = [[스킬:옥쇄파]]
NEXT
;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1

