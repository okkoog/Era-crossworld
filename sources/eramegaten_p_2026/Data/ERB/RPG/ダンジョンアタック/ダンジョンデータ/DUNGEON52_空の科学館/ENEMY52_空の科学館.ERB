;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_52
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC KAMEN_TABLE = [[キャラ:황소가면]],[[キャラ:사자가면]],[[キャラ:전갈가면]],[[キャラ:물병가면]]
#DIM DYNAMIC KAMEN_LV, 4
IF RAND:100 < FLAG:인카운트율
	ダンジョンフラグ:(FLAG:현던전):10 = 0
	IF STRFLAG_EV("罪ルート", , [[이벤트:페르소나２]])
		;噂の状況では仮面党員が出てくる
		IF RAND:2 && STRFLAG_NUM_EV("アジトの噂", , , , [[이벤트:소문]]) == 2
			FOR LCOUNT, 0, 4
				SWAP KAMEN_TABLE:(RAND:4), KAMEN_TABLE:(RAND:4)
				KAMEN_LV = 28 + !RAND:3 + !RAND:5
			NEXT
			SELECTCASE RAND:100
				;4色
				CASE IS < 20
					CALL SET_ENEMY, 7, KAMEN_TABLE:0, KAMEN_LV:0, 0, 0, 1
					CALL SET_ENEMY, 8, KAMEN_TABLE:0, KAMEN_LV:0, 0, 0, 1
					CALL SET_ENEMY, 10, KAMEN_TABLE:1, KAMEN_LV:1, 0, 0, 1
					CALL SET_ENEMY, 11, KAMEN_TABLE:1, KAMEN_LV:1, 0, 0, 1
					CALL SET_ENEMY, 12, KAMEN_TABLE:2, KAMEN_LV:2, 0, 0, 1
					CALL SET_ENEMY, 13, KAMEN_TABLE:2, KAMEN_LV:2, 0, 0, 1
					CALL SET_ENEMY, 15, KAMEN_TABLE:3, KAMEN_LV:3, 0, 0, 1
					CALL SET_ENEMY, 16, KAMEN_TABLE:3, KAMEN_LV:3, 0, 0, 1
				;前衛後衛2色 10体
				CASE IS < 50
					FOR LCOUNT, 0, 0, 10
						CALL SET_ENEMY, LCOUNT + 7, KAMEN_TABLE:(LCOUNT >= 5), KAMEN_LV:(LCOUNT >= 5), 0, 0, 1
					NEXT
				;1色1列
				CASEELSE
					FOR LOCAL, 7, 12
						CALL SET_ENEMY, LCOUNT, KAMEN_TABLE:0, KAMEN_LV:0, 0, 0, 1
					NEXT
			ENDSELECT
			RETURN 1
		ELSE
			ダンジョンフラグ:(FLAG:현던전):10 = RAND:4 == 0
			RETURN 1
		ENDIF
	ELSE
		RETURN 1
	ENDIF
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF

;=======================================================================
;敵キャラの中身
;=======================================================================
@SET_ENEMY_STATUS_52, L_ENEMY
#DIM DYNAMIC L_ENEMY
SELECTCASE NO:L_ENEMY
	CASE [[キャラ:프린시펄리티]]
		ABL:L_ENEMY:스킬1 = [[스킬:아기라오]]
	CASE [[キャラ:모스맨]]
		ABL:L_ENEMY:스킬4 = [[스킬:파이어브레스]]
	CASE [[キャラ:카라스텐구]]
		ABL:L_ENEMY:스킬4 = [[스킬:마하・라기온]]
	CASE [[キャラ:하우르바타트]]
		MAXBASE:L_ENEMY:충격 = 150
		BASE:L_ENEMY:충격 = 150
	CASE [[キャラ:켈라이노]]
		ABL:L_ENEMY:스킬2 = [[스킬:마하・라기]]
		ABL:L_ENEMY:스킬4 = [[스킬:아기라오]]
	CASE [[キャラ:황소가면]]
		ABL:L_ENEMY:스킬2 = [[스킬:마하・마그나스]]
		ABL:L_ENEMY:스킬3 = [[스킬:섬머솔트]]
	CASE [[キャラ:사자가면]]
		ABL:L_ENEMY:스킬2 = [[스킬:마하・라기온]]
		ABL:L_ENEMY:스킬3 = [[스킬:회전베기]]
	CASE [[キャラ:전갈가면]]
		ABL:L_ENEMY:스킬2 = [[스킬:마하・아쿠에스]]
		ABL:L_ENEMY:스킬3 = [[스킬:메・디아라마]]
	CASE [[キャラ:물병가면]]
		ABL:L_ENEMY:스킬2 = [[스킬:마하・갈라]]
ENDSELECT
;罰ルート用
;=======================================================================
;敵の種族の種類数
;=======================================================================
@CLASS_NUM_52
IF ダンジョンフラグ:(FLAG:현던전):10 == 0
	RETURN CLASS_NUM_COMMON("中級")
ELSE
	RETURN RAND:2 + 1
ENDIF
;=======================================================================
;敵の総数
;ARGは出現する敵の種類です
;=======================================================================
@ENEMY_NUM_52, ARG
RETURN ENEMY_NUM_COMMON("中級", ARG)

;=======================================================================
;敵の種類
;=======================================================================
@ENEMY_52, ARG
IF STRFLAG_EV("罪ルート", , [[이벤트:페르소나２]])
	IF ダンジョンフラグ:(FLAG:현던전):10 == 0
		SELECTCASE RAND:100
			CASE IS < 25
				RETURN [[キャラ:켈라이노]], 27
			CASE IS < 50
				RETURN [[キャラ:카라스텐구]], 28
			CASE IS < 75
				RETURN [[キャラ:프린시펄리티]], 28
			CASEELSE
				RETURN [[キャラ:모스맨]], 30
		ENDSELECT
	ELSE
		SELECTCASE RAND:100
			CASE IS < 50
				RETURN [[キャラ:하우르바타트]], 28
			CASEELSE
				RETURN [[キャラ:아에로]], 28
		ENDSELECT
	ENDIF
ELSE
	SELECTCASE RAND:100
		CASE IS < 15
			RETURN [[キャラ:익스타브]], 21
		CASE IS < 30
			RETURN [[キャラ:오퀴페테]], 20
		CASE IS < 45
			RETURN [[キャラ:쿠시나다히메]], 20
		CASE IS < 60
			RETURN [[キャラ:뷔브르]], 21
		CASE IS < 90
			RETURN [[キャラ:오르트로스]], 21
		CASEELSE
			RETURN [[キャラ:잭랜턴]], 20
	ENDSELECT
ENDIF
