	CASE 0, [[스킬:화염격]]
		IF !RAND:3
			LOCALS = 잘못을 바로 잡는거야！
		ELSEIF RAND:2
			LOCALS = 햐하！！ 잘게 썰어주마！
		ELSE
			LOCALS = 죽어라！ 죽어라！ 죽어버려어어！！
		ENDIF
	CASE [[스킬:마하・라기온]], [[스킬:아기라오]]
		IF !RAND:3
			LOCALS = 바짝 익혀주마！！
		ELSEIF RAND:2
			LOCALS = 햐하하！！ 타오르는거야！！
		ELSE
			LOCALS = 불타라 불타라！ 불타버려라라！！
		ENDIF
	CASE [[스킬:프레이라]]
		LOCALS = 시끄럽다！ 시끄러워！ 모두 날아가버려！！
	CASE [[스킬:명왕신부]]
		LOCALS = 이히…히히…히야아！ 이런 것도 있다！！
	CASE [[스킬:포효]]
		IF RAND:2
			LOCALS = 히ー얏핫핫핫하！
		ELSE
			LOCALS = 나는 자유롭다！ 자유로워！！
		ENDIF
	CASE  [[스킬:ＤＵＭＭＹ]]
		PRINTFORMW 아군 누군가에게 ＪＯＫＥＲ가 빙의했다！
		WHILE 1
			LOCAL = RAND:6 + 1
			SIF POS(LOCAL) >= 0 && GET_STATE(CFLAG:POS(LOCAL):상태이상) != "DYING"
				BREAK
			LOCAL = 0
		WEND
		ABL:ARG:초기페르소나 = POS(LOCAL)
		IF RAND:2
			LOCALS = 조커어어어！
		ELSE
			LOCALS = 전파전파전파！！
		ENDIF
	CASEELSE
		IF RAND:2
			LOCALS = 죽어어어！
		ELSE
			LOCALS = 햐하아！
		ENDIF
ENDSELECT
SIF LOCALS != "EMPTY"
	CALL MESSAGE_B(LOCAL:1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)


;--------------------------------
;炎ダメージ
;--------------------------------
@EVENT_BATTLE_ACTEND_DUNGEON52
LOCAL = FLAG:행동순1
SIF LOCAL < 0
	RETURN 0
SIF CFLAG:LOCAL:상태이상 == GET_STATE_NUM("DYING")
	RETURN 0
IF MAXBASE:LOCAL:화염 == 999
	LOCAL:1 = 0
ELSE
	LOCAL:1 = RAND:20 + 10
	IF CFLAG:LOCAL:화염무효화횟수 > 0
		LOCAL:1 = 0
		CFLAG:LOCAL:화염무효화횟수 -= 1
	ELSE
		LOCAL:1 = LOCAL:1 * MAXBASE:LOCAL:화염 / 100
		SIF NO:LOCAL == [[キャラ:킹・레오]] || NO:LOCAL == [[キャラ:스도타츠야]]
			LOCAL:1 *= 4
	ENDIF
ENDIF
IF LOCAL:1 < 0
	LOCALS:1 = {-LOCAL:1}회복
ELSEIF LOCAL:1 == 0
	LOCALS:1 = BLOCK
ELSE
	LOCALS:1 = {LOCAL:1}데미지
ENDIF
LOCALS = 불길이 %조사처리(CALLNAME:LOCAL,"를")% 덮친다！
CALL MESSAGE_B(1, LOCALS)
PRINTFORMW TARGET:[{LOCAL,2}] %CALLNAME:LOCAL,20,LEFT%　>>>>>>　%LOCALS:1%
IF LOCAL:1 < 0
	CALL VAR_HP, LOCAL, -LOCAL:1, "회복"
ELSEIF LOCAL:1 > 0
	CALL VAR_HP, LOCAL, -LOCAL:1, "食いしばり無効ダメージ"
ENDIF
