;=======================================================================
;タイル調整
;=======================================================================
@MAKE_FLOOR_LINE_COMMON_61, ARG, ARG:1, ARG:2
#LOCALSIZE 30
;LOCAL:3 宝箱 ダンジョンフラグ:70~99
;LOCAL:4 이벤트
;(0/0)でLOCALを消去
SIF ARG:1 == 0 && ARG:2 == 0
	VARSET LOCAL
SELECTCASE ARG
	CASE 3
		IF GETBIT(ダンジョンフラグ:(FLAG:현던전):(FLAG:현M+70), LOCAL:3)
			DA:(ARG:1):(ARG:2) = 1
		ELSE
			DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:3 * 10 + 3
		ENDIF
		LOCAL:3++
	CASE 4
		DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:4 * 10 + 4
		LOCAL:4++
	CASE 5
		;DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:5 * 10 + 5
		;LOCAL:5++
	CASE 6
		DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:6 * 10 + 6
		LOCAL:6++
	CASE 7
		DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:7 * 10 + 7
		LOCAL:7++
	CASE 8
		DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:8 * 10 + 8
		LOCAL:8++
	CASE 9
		DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:9 * 10 + 9
		LOCAL:9++

ENDSELECT

;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_61
CALL EVENT_DUNGEON_61
RETURN RESULT

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_61, ARG
;ARG = 進入時の向き　0の場合ワープなど
CALL EVENT_DUNGEON_61, ARG , 0
RETURN RESULT

@EVENT_DUNGEON_61, ARG, ARG:1
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) % 10
;==========
;出口の処理
;==========
	CASE 8
		CALL DUNGEON_EXIT
	RETURN 1
;==========
;扉の処理
;==========
	CASE 2
		CALL DUNGEON_DOOR, ARG
		RETURN 1
;========
;宝の処理
;========
	CASE 3
		CALL TREASURE_61
		RETURN 1

;=======
;階段
;=======
	CASE 6
	CALL UPSTAIRS_61
	RETURN RESULT

	CASE 7
	CALL DOWNSTAIRS_61
	RETURN RESULT


;=======================================================================
;イベントまとめ
;=======================================================================
	CASE 4
		IF FLAG:미조우걸음수 > 0
			FLAG:미조우걸음수 -= 1
		ENDIF
		SELECTCASE DA:(FLAG:현X):(FLAG:현Y) /10
			CASE 1
