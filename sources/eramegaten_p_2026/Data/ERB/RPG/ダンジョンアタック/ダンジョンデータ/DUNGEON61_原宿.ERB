;スタート地点入力
;=======================================================================
@START_DUNGEON_61, ARG
FLAG:현M = 0
FLAG:현X =11
FLAG:현Y = 1
;CALL AUTOMAP
RETURN 0

;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_61
IF ダンジョンフラグ:61:1 == 5
ダンジョンフラグ:61:1 = 0
ENDIF
IF ダンジョンフラグ:61:1 == 0
	CALL SHOW_PICTURE, "D"
	CALL MESSAGE_WINDOW_D, "", "＞악마와 인간의 사이에서 태어난 데빌칠드런이라 불리는 아이가 있는 것 같다。"
	CALL MESSAGE_WINDOW_D, "", "＞그 아이를 「확보」하라는 의뢰를 받은 당신은 하라주쿠에 왔다。"
		;↑ あからさまな指示はしないのではないか、戦力にできれば方法は任せるのではないか、と考えて表現を修正。
	IF 闘技場フラグ:3:0 == 1
	CALL MESSAGE_WINDOW_D, "", "＞아무래도 타겟은 카나메 미라이라는 소녀인 것 같다。"
	ダンジョンフラグ:61:1 = 2
ELSEIF 闘技場フラグ:4:0 == 1
	CALL MESSAGE_WINDOW_D, "", "＞아무래도 타겟은 카이 세츠나라는 소년인 것 같다。"
	ダンジョンフラグ:61:1 = 1
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞아무래도 타겟은 소년과 소녀 중、어느 하나를 선택해야 하는 것 같다。"
	CALL MESSAGE_WINDOW_D, "", "＞어느쪽을 타겟으로 선정하겠습니까？"
		IF BASE:MASTER:LV >= 15
			CALL INPUT_SELECT_D, @"[1]카이 세츠나라는 소년/[2]카나메 미라이라는 소녀/[3]의뢰의 뒷조사를 한 바에 따르면――"
		ELSE
			CALL INPUT_SELECT_D, @"[1]카이 세츠나라는 소년/[2]카나메 미라이라는 소녀"
		ENDIF
			SELECTCASE RESULT
				CASE 1
					ダンジョンフラグ:61:1 = 1
				CASE 2
					ダンジョンフラグ:61:1 = 2
				CASE 3
					ダンジョンフラグ:61:1 = 3
			ENDSELECT

		IF ダンジョンフラグ:61:1 == 3
			;長くなるので分けます。
			;テキスト本編やバトルはイベント44のほうで。
			CALL EVENT_44_01_01

			;クリアはした、ということでダンジョンフラグ操作
			ダンジョンフラグ:61:0 = 5
			;イベント進行
			;44:0＝ルート番号は１
			;44:1＝１番目のシナリオが終わったので２番目が発生
			イベントフラグ:44:0 = 1
			イベントフラグ:44:1 = 2

			;終了後は即脱出
			FLAG:탈출 = 1
		ELSE
			CALL MESSAGE_WINDOW_D, "", "＞자료에 따르면 타겟의 어머니는 사망、아버지는 행방불명이라고 한다。"
				IF ダンジョンフラグ:61:1 == 1
					CALL MESSAGE_WINDOW_D, "", "＞현재 동생과 둘이서 하라주쿠 남서쪽의 숙모에게 의지해서 살아가는 것 같다。"
				ELSEIF ダンジョンフラグ:61:1 == 2
					CALL MESSAGE_WINDOW_D, "", "＞현재 하라주쿠 남서쪽의 숙모에게 의지해서 살아가는 것 같다。"
				ENDIF
			CALL MESSAGE_WINDOW_D, "", "＞…자료에는、숙모는 일때문에 집을 비우는 일이 많다고 기록되어 있다만…。"
			CALL MESSAGE_WINDOW_D, "", "＞당신은 남서쪽의 타겟의 집으로 향하기로 했다"
		ENDIF
	ENDIF
ENDIF
