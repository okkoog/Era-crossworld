			SIF FLAG:현X == 6 && FLAG:현Y == 4
				CALL DUNGEON_WORP, 6, 3, 8

		CASE 6
			;学校入り口
			SIF FLAG:현X == 3 && FLAG:현Y == 9
				CALL DUNGEON_WORP, 5, 6, 5
		CASEELSE
	ENDSELECT
	RETURN 1

ENDSELECT
RETURN 0
