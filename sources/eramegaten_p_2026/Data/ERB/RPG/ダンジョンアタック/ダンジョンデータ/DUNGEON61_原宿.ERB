;	CALL SET_ACTION_プチ攻撃, ARG
;ENDIF

@SET_ACTION_デビチル, ARG
;味方の中で一番ＨＰが低く、かつ飛具相性が1未満or999ではないキャラにＧＵＮ攻撃

;全員の中で一番ＨＰが低いキャラクターを狙う
CFLAG:ARG:입력행동 = 2101
CFLAG:ARG:타겟 = -1
FOR LOCAL, 1, 7
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS == -1
		CONTINUE
	SIF CFLAG:(FLAG:LOCALS):상태이상 >= GET_STATE_NUM("STONE")
		CONTINUE
	SIF MAXBASE:(FLAG:LOCALS):비구 < 1 || MAXBASE:(FLAG:LOCALS):비구 == 999
		CONTINUE
	IF FLAG:LOCALS > -1 && CFLAG:ARG:타겟 == -1
		CFLAG:ARG:타겟 = LOCAL
		CONTINUE
	ENDIF
	IF FLAG:LOCALS > -1 && BASE:(FLAG:LOCALS):ＨＰ < BASE:((POS(CFLAG:ARG:타겟))):ＨＰ
		CFLAG:ARG:타겟 = LOCAL
	ENDIF
NEXT

IF CFLAG:ARG:타겟 == -1
	CFLAG:ARG:입력행동 = -1
	CFLAG:ARG:방어플래그 = 1
ENDIF

;=======================================================================
;宝箱の中身
;=======================================================================
@TREASURE_61
#LOCALSIZE 8
LOCAL = FLAG:현M + 70
LOCAL:1 = (DA:(FLAG:현X):(FLAG:현Y) / 10) % 100
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
	;マップ番号*100+そのマップで何番目の宝箱かを示す数値でどの宝箱かを判別します。
	;例えば0の場合、0版のマップの0番目の宝箱であることを表しています。
	CASE 100
		CALL GETS_TREASURE, "메디컬파우더", 1, FLAG:현던전, LOCAL, LOCAL:1
	CASE 101
		CALL GETS_TREASURE, "스킬카드【마하・라기】", 1, FLAG:현던전, LOCAL, LOCAL:1
	CASE 200
		CALL GETS_TREASURE, "마력의향", 1, FLAG:현던전, LOCAL, LOCAL:1
	CASE 201
		CALL GETS_TREASURE, "우황단", 2, FLAG:현던전, LOCAL, LOCAL:1
	CASE 500
		;トーテムメモリーを入手したことがあるかどうか
		IF IS_TOTEM_MEMORY_TAKEN:1
			;この宝箱には10000MAGが入っています
			CALL GET_TREASURE_MAG, , 10000 , FLAG:현던전, LOCAL , LOCAL:1
		ELSE
			CALL GET_TREASURE, GETNUM(ITEM, "토템메모리") , 1 , FLAG:현던전, LOCAL , LOCAL:1
			IS_TOTEM_MEMORY_TAKEN:1 = RESULT
		ENDIF
	CASE 600
		CALL GETS_TREASURE, "우황단", 2, FLAG:현던전, LOCAL, LOCAL:1
	CASE 601
		CALL GETS_TREASURE, "잭장갑", 1, FLAG:현던전, LOCAL, LOCAL:1
	CASE 700
		CALL GETS_TREASURE, "내구의향", 1, FLAG:현던전, LOCAL, LOCAL:1
ENDSELECT
RETURN 1
