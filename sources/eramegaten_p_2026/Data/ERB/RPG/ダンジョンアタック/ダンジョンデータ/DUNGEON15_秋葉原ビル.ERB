
;=======================================================================
;아키하바라빌딩
;偽典悪魔置き場。
;ついでに相馬が仲間になる。
;早坂のフラグが置けそうではある。
;カズミは未実装
;ダンジョンナンバー15
;使用フラグ
;15:0 突入時フラグ
;15:1 ボス撃破フラグ
;15:2 相馬三四郎フラグ
;15:3 サイバーアームの店
;15:4 アイテム屋
;15:5 ボス扉フラグ
;15:6-8 宝箱フラグ
;15:9 ボス報酬フラグ
;=======================================================================

;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_15
SIF (イベントフラグ:70:0 == 0 || イベントフラグ:70:0 == 99)
	RETURN 0
IF !(FINDCHARA_B([[キャラ:아야토]],0) == 2)
	RESULTS = 카츠라기 후미토의 편성
	RETURN -1
ENDIF
RETURN 1

;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_15
#FUNCTIONS
RESULTS_F = 秋葉原ビル

;=======================================================================
;フロア名表示
;=======================================================================
@FLOORNAME_15
PRINT 아키하바라빌딩
SELECTCASE FLAG:현M
	CASE 0
		PRINTL   Ｂ１Ｆ
	CASE 1
		PRINTL   １Ｆ
	CASE 2
		PRINTL   ２Ｆ
	CASE 3
		PRINTL   ３Ｆ
	CASEELSE
		PRINTL
ENDSELECT

;=======================================================================
;ターミナルマップ
;RESULT:X = 1で階層Mのマップのターミナルを登録できる
;登録されたターミナル同士は相互で移動が可能になり、スタート地点から選べるようになる
;
;RESULTS:100は入り口の名称。入り口のままでいいなら定義する必要はない
;=======================================================================
@TERMINAL_MAP_15, IS_START
#DIM DYNAMIC IS_START
RESULT:3 = 1
RESULTS:3 '= "터미널"
RETURN RESULT

;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_15, ARG
FLAG:현M = 1
FLAG:현X = 0
FLAG:현Y = 5
;CALL AUTOMAP

;=======================================================================
;攻略開始時のイベント
;=======================================================================
@EVENT_DUNGEON_START_15
IF ダンジョンフラグ:15:0 == 0
	IF ダンジョンフラグ:37:0 == 0
	CALL MESSAGE_WINDOW_D, "", "＞카츠라기의 동료들의 소식을 찾아/＞" + CALLNAME:MASTER + "는 아키하바라 빌딩에 왔다…"
	CALL MESSAGE_WINDOW_D, "", "＞잃어버린 친구가 몇 명 있는 것 같은데/＞그들의 정보를 얻을 수 있을까…"
	ELSE
	CALL MESSAGE_WINDOW_D, "", "＞" + CALLNAME:MASTER + "는 카츠라기와 함께 아키하바라 빌딩에 왔다…"
	CALL MESSAGE_WINDOW_D, "", "＞이곳에서는 전자 제품을 판매한다고 하던데…/＞뭔가 유익한 물건을 구할 수 있을까…"
	ENDIF
	ダンジョンフラグ:15:0 = 1
ELSE
ENDIF

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_15,ARG,ARG:1
		;Ｂ１階
		IF FLAG:현M == 0 && ARG == 4 && ARG:1 == 3 && ダンジョンフラグ:15:5 == 0
		CALL MESSAGE_WINDOW_D, "", "＞문에 자물쇠가 달려있다…"
		RETURN 0
		ELSE
			IF FLAG:현M == 0 && ARG == 4 && ARG:1 == 3 && ダンジョンフラグ:15:5 == 1&& ダンジョンフラグ:15:9 == 0
			CALL MESSAGE_WINDOW_D, "", "＞안쪽에서 소리가 난다…"
			CALL MESSAGE_WINDOW_D, "", "＞들어갑니까？"
			CALL INPUT_YN_D
			SIF RESULT
			RETURN 0
			ENDIF
		ENDIF
		
		IF FLAG:현M == 0 && ARG == 4 && ARG:1 == 3 && ダンジョンフラグ:15:9 == 1
		CALL MESSAGE_WINDOW_D, "", "＞문에 자물쇠가 달려있다…"
		RETURN 0
		ELSE
		ENDIF

CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

;=======================================================================
;フロアデータ
;=======================================================================
@MAKE_FLOOR_15

SELECTCASE FLAG:현M
	CASE 0
	;Ｂ１階
		FLAG:최대X = 14
		FLAG:최대Y = 7
								 ;01234567890123
		CALL MAKE_FLOOR_LINE, 0, "            "
		CALL MAKE_FLOOR_LINE, 1, "      61111 "
		CALL MAKE_FLOOR_LINE, 2, "  11      1 "
		CALL MAKE_FLOOR_LINE, 3, "  142111111 "
		CALL MAKE_FLOOR_LINE, 4, "  11      1 "
		CALL MAKE_FLOOR_LINE, 5, "      11111 "
		CALL MAKE_FLOOR_LINE, 6, "            "
		
		;宝箱の設置
		DA:6:5 = ダンジョンフラグ:15:6 ? 1 # 63
		
	CASE 1
	;１階
		FLAG:최대X = 22 
		FLAG:최대Y = 12 
							;	  012345678901234567890
   		CALL MAKE_FLOOR_LINE, 0, "                     "
   		CALL MAKE_FLOOR_LINE, 1, "                     "
   		CALL MAKE_FLOOR_LINE, 2, " 11 14 7111141111114 "
   		CALL MAKE_FLOOR_LINE, 3, " 11 11     1  1 1 11 "
   		CALL MAKE_FLOOR_LINE, 4, "  1  1 14 111 1 1    "
   		CALL MAKE_FLOOR_LINE, 5, "814111 11 111 1 1114 "
   		CALL MAKE_FLOOR_LINE, 6, "    11  1  1  1 1 11 "
   		CALL MAKE_FLOOR_LINE, 7, " 11 1111111111111    "
   		CALL MAKE_FLOOR_LINE, 8, " 11 1    1  1 111111 "
   		CALL MAKE_FLOOR_LINE, 9, "  1 1 11 1 11 111 11 "
   		CALL MAKE_FLOOR_LINE,10, " 1111114 6 11 111 11 "
   		CALL MAKE_FLOOR_LINE,11, "                     "

		;宝箱の設置
		DA:1:10 = ダンジョンフラグ:15:7 ? 1 # 63

	CASE 2
	;２階
		FLAG:최대X = 22
		FLAG:최대Y = 10
								 ;012345678901234567890
   		CALL MAKE_FLOOR_LINE, 0, "                     "
		CALL MAKE_FLOOR_LINE, 1, " 11 1 1411111 111114 "
		CALL MAKE_FLOOR_LINE, 2, " 11 1 11 1 11 111 11 "
		CALL MAKE_FLOOR_LINE, 3, "  1 1    1    111    "
		CALL MAKE_FLOOR_LINE, 4, " 1111141111111111111 "
		CALL MAKE_FLOOR_LINE, 5, " 1111111111    11114 "
		CALL MAKE_FLOOR_LINE, 6, " 1   1  111 11 1  1  "
		CALL MAKE_FLOOR_LINE, 7, " 11 111 1 1 1111 111 "
		CALL MAKE_FLOOR_LINE, 8, " 41 111 7 6 11 1 141 "
		CALL MAKE_FLOOR_LINE, 9, "                     "

		;宝箱の設置
		DA:5:8 = ダンジョンフラグ:15:8 ? 1 # 63

	CASE 3
	;３階
		FLAG:최대X = 22
		FLAG:최대Y = 11
								 ;012345678901234567890
   		CALL MAKE_FLOOR_LINE, 0, "                     "
		CALL MAKE_FLOOR_LINE, 1, " 14 11 1 T2111111111 "
		CALL MAKE_FLOOR_LINE, 2, " 11 11 1    1    1 1 "
		CALL MAKE_FLOOR_LINE, 3, "  1  1 1114 1 11 1 1 "
		CALL MAKE_FLOOR_LINE, 4, " 1111141 11 1 11 1 1 "
		CALL MAKE_FLOOR_LINE, 5, " 1111111    1 1  1 1 "
		CALL MAKE_FLOOR_LINE, 6, " 1111111111111111111 "
		CALL MAKE_FLOOR_LINE, 7, " 1  1  1  1 11111    "
		CALL MAKE_FLOOR_LINE, 8, " 11 11 11 1 41111 11 "
		CALL MAKE_FLOOR_LINE, 9, " 41 41 11 7 11111114 "
		CALL MAKE_FLOOR_LINE,10, "                     "
		
	CASEELSE
ENDSELECT

;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_15
;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
	CALL TRESURING_CALLING_15
	RETURN 1
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 6
	CALL DUNGEON_UPSTAIRS_ID, FLAG:현M+1, 7
	RETURN 1

ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 7
	CALL DUNGEON_DOWNSTAIRS_ID, FLAG:현M-1, 6
	RETURN 1
;========
;이벤트
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 4
	CALL EVENTING_CALLING_15
	RETURN 1
	
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 9
	CALL MESSAGE_WINDOW_D, "", "＞아무것도 없는 것 같다"
	RETURN 0
ENDIF

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_15,ARG
;ARG = 進入時の向き　0の場合ワープなど
;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) % 10 == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
	CALL TRESURING_CALLING_15
	RETURN 1
;==========
;==========
;イベントの処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 4
	CALL EVENTING_CALLING_15
	RETURN 1
;==========
;扉の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 2
	CALL DUNGEON_DOOR,ARG
	RETURN 1
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 6
	CALL DUNGEON_UPSTAIRS_ID, FLAG:현M+1, 7
	RETURN 1
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 7
	CALL DUNGEON_DOWNSTAIRS_ID, FLAG:현M-1, 6
	RETURN 1
	
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 9
	RETURN 0
ENDIF
RETURN 0
;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_15
FLAG:인카운트율 = FLAG:미조우걸음수*4
;=======================================================================
;必要レベル目安
;推奨LV 雑魚最低LV 雑魚最高LV ボスLV 
;=======================================================================
@GET_DUNGEON_LV_15
RETURN 20, 6, 17, 32
;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_15
IF RAND:100 < FLAG:인카운트율
	RETURN 1
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF

;=======================================================================
;敵の種族の種類数
;=======================================================================
@CLASS_NUM_15
RETURN CLASS_NUM_COMMON("初級")
;=======================================================================
;敵の総数
;ARGは出現する敵の種類です
;=======================================================================
@ENEMY_NUM_15, ARG
RETURN ENEMY_NUM_COMMON("初級", ARG)

;=======================================================================
;敵の種類
;=======================================================================
@ENEMY_15, ARG
	IF RAND:10 == 0
		RETURN [[キャラ:블루벨]], 6
	ELSEIF RAND:9 == 0
		RETURN [[キャラ:네레이드]], 11
	ELSEIF RAND:8 == 0
		RETURN [[キャラ:케우케겐]], 6
	ELSEIF RAND:7 == 0
		RETURN [[キャラ:아펩]], 8
	ELSEIF RAND:6 == 0
		RETURN [[キャラ:엔티티]], 10
	ELSEIF RAND:5 == 0
		RETURN [[キャラ:포다르게]], 17
	ELSEIF RAND:4 == 0
		RETURN [[キャラ:니코토에]], 11
	ELSEIF RAND:3 == 0
		RETURN [[キャラ:우피오르]], 12
	ELSEIF RAND:2 == 0
		RETURN [[キャラ:금시조]], 8
	ELSE
		RETURN [[キャラ:레지스탕스]], 10
	ENDIF

;========================
;イベントまとめ
;========================
@EVENTING_CALLING_15
	IF FLAG:현M == 1 && FLAG:현X == 2 && FLAG:현Y == 5 && ダンジョンフラグ:15:2 == 0 
		IF ダンジョンフラグ:15:2 == 0
			CALL MESSAGE_WINDOW_D, "", "＞아키하바라 빌딩에 들어서자마자 젊은이가 부딪혀왔다/"
			CALL MESSAGE_WINDOW_D, "산시로", "＞앗！미、미안！/＞잠깐 딴 생각을 하고 있었거든…"
			CALL MESSAGE_WINDOW_D, "", "＞특별히 피해를 입은 것도 아니어서 그냥 가려고 했는데/＞카츠라기의 암터미널을 본 청년이 질문을 해왔다…"
			CALL MESSAGE_WINDOW_D, "", "＞카츠라기의 동료였던 니시노와 한동안 함께 활동한 적이 있다고 한다…/＞"
			CALL MESSAGE_WINDOW_D, "", "＞부모님을 대신하여 니시노의 죽음을 슬퍼하는 카츠라기/＞서로 하고 싶은 말이 있는 것 같은데…"
			CALL MESSAGE_WINDOW_D, "", "＞불의의 사고로 왼팔을 잃은 것 같으나/＞사이버 암을 착용하고 있어 전투에는 지장이 없을 것 같다/＞게다가 서머너의 능력도 가지고 있는 것 같고…"
			CALL INPUT_SELECT_D("[1] 동료로 초대한다/[2] 적당한 지점에서 잘라서 정리하게 한다")
				IF RESULT == 1
					CALL MESSAGE_WINDOW_D, "", "＞소우마 산시로를 동료로 초대했다…"
					CALL MESSAGE_WINDOW_D, "산시로", "에엑！괜찮은거야？/나는 괜찮지만…"
					CALL MESSAGE_WINDOW_D, "", "그도 아는 사람을 찾고 있는 것 같다/＞"
					CALL MESSAGE_WINDOW_D, "", "＞소우마 산시로를 동료가 되었다"
					CALL ADD_NEW_COMPANION, [[キャラ:산시로]],500
					SIF RESULT
						CALL SET_TALENT_PARTY_JOINABLE, (RESULT:1), "신용"
					ダンジョンフラグ:15:2 = 1
				ELSE
					CALL MESSAGE_WINDOW_D, "", "카츠라기와 산시로가 정보 교환을 하고 헤어졌다…"
					ダンジョンフラグ:15:2 = 1
				ENDIF
		ELSE
		ENDIF
	ELSEIF FLAG:현M == 2 && FLAG:현X == 7 && FLAG:현Y == 1
		CALL MESSAGE_WINDOW_D, "수상한 남자", "괜찮다면、잠깐 보고 가시는건 어떠신가요？/＞입문용부터 최신 기종까지 다양한 암 터미널이 준비되어 있습니다"
			$SHOP_00_01
				CALL INPUT_SELECT_D, "무엇을 합니까？//[1]산다/[2]스테이터스를 본다///[9]밖으로 나간다" , , , 2
			IF RESULT == 1
			$SHOP_00_02
				PRINTL 소지금
				PRINT ￥　　
				PRINTV MONEY
				PRINTL 
				PRINT 마카　
				PRINTV MONEY:1
				PRINTL 
				PRINTL 
					PRINTL [1]『재밍 암』（ 　3800엔）
					PRINTL [2]『최신기종！사이버 암』　（ 　480마카）
					PRINTL [3]『인텔제 최고급 암』（　1000마카）
					PRINTL 
					PRINTL [9] 밖으로 나간다
			$SHOP_00_03
			INPUT
				IF RESULT == 1
					IF MONEY < 3800
						CALL MESSAGE_WINDOW_D, "수상한 남자", "소지금이 부족하시네요"
						GOTO SHOP_00_02
					ELSE
						CALL MESSAGE_WINDOW_D, "", "이 녀석을 사실겁니까？"
						CALL INPUT_YN,"Yes","No"
						IF RESULT == 0
							CALL MESSAGE_WINDOW_D, "수상한 남자", "매번 감사합니다。"
							CALL MESSAGE_WINDOW_D, "", "＞팔 보호대『재밍암』을 손에 넣었다"
							CALL GET_ITEMS, "재밍암", 1
							MONEY -= 3800
							GOTO SHOP_00_01
						ELSE
							GOTO SHOP_00_01
						ENDIF
					ENDIF
				ELSEIF RESULT == 2
					IF MONEY:1 < 480
						CALL MESSAGE_WINDOW_D, "수상한 남자", "마카가 부족하시네요"
						GOTO SHOP_00_02
					ELSE
						CALL MESSAGE_WINDOW_D, "", "이 녀석을 사실겁니까？"
						CALL INPUT_YN,"Yes","No"
						IF RESULT == 0
							CALL MESSAGE_WINDOW_D, "", "＞아이템『사이버 암』을 손에 넣었다"
							CALL GET_ITEMS, "사이버암", 1
							MONEY:1 -= 480
							GOTO SHOP_00_01
						ELSE
							GOTO SHOP_00_01
						ENDIF
					ENDIF
				ELSEIF RESULT == 3
					IF MONEY:1 < 1000
						CALL MESSAGE_WINDOW_D, "수상한 남자", "마카가 부족하시네요"
						GOTO SHOP_00_02
					ELSE
						CALL MESSAGE_WINDOW_D, "", "이 녀석을 사실겁니까？"
						CALL INPUT_YN,"Yes","No"
						IF RESULT == 0
							CALL MESSAGE_WINDOW_D, "", "＞아이템『인텔가드』를 손에 넣었다"
							CALL GET_ITEMS, "인텔가드", 1
							MONEY:1 -= 1000
							GOTO SHOP_00_01
						ELSE
							GOTO SHOP_00_01
						ENDIF
					ENDIF
				ELSEIF RESULT == 9
					CALL MESSAGE_WINDOW_D , "수상한 남자", "또 와주십쇼"
					FLAG:현X = 8
					FLAG:현Y = 1
				ELSE
				GOTO SHOP_00_01
				ENDIF
			ELSEIF RESULT == 2
				CALL SHOP_COM_301
				GOTO SHOP_00_01
			ELSEIF RESULT == 9
					CALL MESSAGE_WINDOW_D , "수상한 남자", "또 와주십쇼"
					FLAG:현X = 8
					FLAG:현Y = 1
			ENDIF
	ELSEIF FLAG:현M == 2 && FLAG:현X == 18 && FLAG:현Y == 8
				CALL MESSAGE_WINDOW_D, "점원", "어서오세요"
				CALL DUNGEON_SHOP(0, "외상약", 50, "도반옥", 3000, "디스포이즌", 1480, "디스패라이즈", 1500, "디스챰", 1520, "디스톤", 2680, "디스커스", 3240)
				CALL MESSAGE_WINDOW_D, "점원", "또、뵙겠습니다"
	ELSEIF FLAG:현M == 3 && FLAG:현X == 1 && FLAG:현Y == 9 && ダンジョンフラグ:15:5 == 0
			CALL MESSAGE_WINDOW_D, "", "빌딩 3층의 한 방을 찾아가니 한 남자가 혼자서 사무를 보고 있었다…"
			CALL MESSAGE_WINDOW_D, "남자", "네、제가 지하에 있는 메이드 카페를 운영하는 사람입니다"
			CALL MESSAGE_WINDOW_D, "남자", "엣…、여성이 지하에 갔다가 돌아오지 않는다고요…？"
			CALL MESSAGE_WINDOW_D, "남자", "확실히 그 층에는 제 가게밖에 없는데、없다는 건 좀 이상하네요"
			CALL MESSAGE_WINDOW_D, "남자", "죄송하지만 저는 지금 손이 없어서、열쇠를 빌려드릴 테니 좀 보고 와주시면 안 될까요？"
			CALL MESSAGE_WINDOW_D, "", "남자에게 가게 열쇠를 받았다…"
				ダンジョンフラグ:15:5 = 1
	ELSEIF FLAG:현M == 3 && FLAG:현X == 1 && FLAG:현Y == 9 && ダンジョンフラグ:15:5 == 1 && ダンジョンフラグ:15:9 == 0
				CALL MESSAGE_WINDOW_D, "남자", "잘 부탁드립니다。"
	ELSEIF FLAG:현M == 3 && FLAG:현X == 1 && FLAG:현Y == 9 && ダンジョンフラグ:15:9 == 1
				CALL MESSAGE_WINDOW_D, "남자", "그 부분은 고마워요。"
