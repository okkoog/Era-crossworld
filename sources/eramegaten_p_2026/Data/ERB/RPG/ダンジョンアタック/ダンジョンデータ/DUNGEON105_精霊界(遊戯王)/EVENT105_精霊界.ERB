;=======================================================================
;階段置き場
;アンダーグラウンドは精霊界入口から降り階段で入って
;入口(0)から浅層(10)、中層(11)、深層(12)、最深層(13)と数値は上がるが降りる形式なので別途指定。
;白銀の迷宮城は普通に上がっていくのでCASEELSEのとこで問題無し
;=======================================================================
;上り階段処理
@UPSTAIRS_105
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) /10
	;アンダーグラウンド浅層(10)から精霊界入口(0階層)の降り階段に戻る
	CASE 1000
		CALL DUNGEON_UPSTAIRS_ID, 0 , 7
	;アンダーグラウンドの最深層→深層→中層→浅層と登って戻るので現Mをマイナスする
	CASE 1100 , 1200 , 1300
		CALL DUNGEON_UPSTAIRS_ID, FLAG:현M - 1 , (FLAG:현M - 1) * 1000 + 7
	;他、白銀の迷宮城用で次の階層の降り階段に登る
	CASEELSE
		CALL DUNGEON_UPSTAIRS_ID, FLAG:현M+1 , (FLAG:현M + 1) * 1000 + 7
ENDSELECT
RETURN 1

;降り階段処理
@DOWNSTAIRS_105
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) /10
	;精霊界入口(0)からアンダーグラウンド浅層(10)の登り階段に降りる
	CASE 0
		CALL DUNGEON_DOWNSTAIRS_ID, 10 , 10006
	;アンダーグラウンドの浅層→中層→深層→最深層と降りて進むので現Mをプラスする
	CASE 1000 , 1100 , 1200 , 1300
		CALL DUNGEON_DOWNSTAIRS_ID, FLAG:현M + 1 , (FLAG:현M + 1) * 1000 + 6
	;他、白銀の迷宮城用で次の階層の登り階段に降りる
	CASEELSE
		CALL DUNGEON_DOWNSTAIRS_ID, FLAG:현M-1 , (FLAG:현M - 1) * 1000 + 6
ENDSELECT
RETURN 1


;=======================================================================
;罠置き場
;ランダムにHPとMPダメージと各種状態異常が出る。
;HPとMPは10%ダメージにランダムで15%まで追加する。
;HPとMPは確率増やすために複数用意。
;状態異常は1、2ターンで消えたり特殊なものは無し。
;SHOCK(2)、FREEZE(5)、FLY(13)、ORGY(16)、HEAT(17)、SLIP(19)
;=======================================================================
@TRAP_105
SELECTCASE FLAG:현M
	CASE 7 TO 9
		LOCAL = RAND(20)
		SELECTCASE LOCAL
			CASE 0
				;HPダメージ10％+ランダム15%まで
				CALL DUNGEON_TRAP_HP,10 + RAND:15
			CASE 1
				;MPダメージ10％+ランダム15%まで
				CALL DUNGEON_TRAP_MP,10 + RAND:15
			CASE 2
				;幸福(HAPPY)、付与25%
				CALL DUNGEON_TRAP_BADSTATE,1,25
			CASE 3
				;混乱(PANIC)、付与25%
				CALL DUNGEON_TRAP_BADSTATE,3,25
			CASE 4
				;睡眠(SLEEP)、付与25%
				CALL DUNGEON_TRAP_BADSTATE,4,25
			CASE 5
				;金縛り(BIND)、付与25%
				CALL DUNGEON_TRAP_BADSTATE,6,25
			CASE 6
				;沈黙(CLOSE)、付与25%
				CALL DUNGEON_TRAP_BADSTATE,7,25
			CASE 7
				;猛毒(POIZON)、付与25%
				CALL DUNGEON_TRAP_POISON,25
			CASE 8
				;爆弾(BOMB)、付与25%
				CALL DUNGEON_TRAP_BADSTATE,9,25
			CASE 9
				;魅了(CHARM)、付与25%
				CALL DUNGEON_TRAP_BADSTATE,10,25
			CASE 10
				;麻痺(PALYZE)、付与25%
				CALL DUNGEON_TRAP_BADSTATE,11,25
			CASE 11
				;呪い(CURSE)、付与25%
				CALL DUNGEON_TRAP_BADSTATE,12,25
			CASE 12
				;石化(STONE)、付与25%
				CALL DUNGEON_TRAP_BADSTATE,14,25
			CASE 13
				;死亡(DYING)、付与25%
				CALL DUNGEON_TRAP_BADSTATE,15,25
			CASE 14
				;炎上(FLAME)、付与25%
				CALL DUNGEON_TRAP_BADSTATE,18,25
			CASE 15
				;낙인(BRAND)、付与25%
				CALL DUNGEON_TRAP_BADSTATE,20,25
			CASE 16
				;HPダメージ10％+ランダム15%まで
				CALL DUNGEON_TRAP_HP,10 + RAND:15
			CASE 17
				;MPダメージ10％+ランダム15%まで
				CALL DUNGEON_TRAP_MP,10 + RAND:15
			CASE 18
				;HPダメージ10％+ランダム15%まで
				CALL DUNGEON_TRAP_HP,10 + RAND:15
			CASE 19
				;MPダメージ10％+ランダム15%まで
				CALL DUNGEON_TRAP_MP,10 + RAND:15
		ENDSELECT
ENDSELECT
RETURN 0
