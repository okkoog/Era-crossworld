;=======================================================================
;攻略開始時のイベント
;画像と最初だけ一言出す。
;=======================================================================
@EVENT_DUNGEON_START_105
PRINTL
;タイトル画像表示
SELECTCASE FLAG:현M
	CASE 0
		CALL PRINT_EVENT_PICTURE, "精霊界_タイトル", 10, "CENTER"
	CASE 1
		CALL PRINT_EVENT_PICTURE, "蟲惑魔の森浅層", 10, "CENTER"
	CASE 4
		CALL PRINT_EVENT_PICTURE, "魔法族の里", 10, "CENTER"
	CASE 7
		CALL PRINT_EVENT_PICTURE, "白銀の迷宮城", 10, "CENTER"
	CASE 10
		CALL PRINT_EVENT_PICTURE, "アンダーグラウンド", 10, "CENTER"
ENDSELECT
WAIT
IF ダンジョンフラグ:(FLAG:현던전):2 == 0
	CALL MESSAGE_WINDOW_D, "", "＞기묘한 이계가 생겨났다는 이유로 조사를 명령받았다。"
	CALL MESSAGE_WINDOW_D, "", "＞겉보기에는 초원 같지만……"
	ダンジョンフラグ:(FLAG:현던전):2 = 1
ENDIF
DRAWLINE

