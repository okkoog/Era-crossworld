		ENDIF
	;魔法族の里　深層用
	CASE 6
		IF ARG == 1 && ARG:1 == 15 && !GETBIT(ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 6) 
			;南からは開けられない
			IF FLAG:현Y > ARG:1
				CALL MESSAGE_WINDOW_D, "", "＞문이 닫혀있다/＞반대편에서 한 번 열 필요가 있는 것 같다"
				RETURN 0
			ELSE
				CALL MESSAGE_WINDOW_D, "", "＞닫혀 있던 문을 열었다"
				SETBIT ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 6
				RETURN 0
			ENDIF
		ELSEIF ARG == 4 && ARG:1 == 9 && !GETBIT(ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 7) 
			;東からは開けられない
			IF FLAG:현X > ARG
				CALL MESSAGE_WINDOW_D, "", "＞문이 닫혀있다/＞반대편에서 한 번 열 필요가 있는 것 같다"
				RETURN 0
			ELSE
				CALL MESSAGE_WINDOW_D, "", "＞닫혀 있던 문을 열었다"
				SETBIT ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 7
				RETURN 0
			ENDIF
		ELSEIF ARG == 4 && ARG:1 == 13 && !GETBIT(ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 8) 
			;東からは開けられない
			IF FLAG:현X > ARG
				CALL MESSAGE_WINDOW_D, "", "＞문이 닫혀있다/＞반대편에서 한 번 열 필요가 있는 것 같다"
				RETURN 0
			ELSE
				CALL MESSAGE_WINDOW_D, "", "＞닫혀 있던 문을 열었다"
				SETBIT ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 8
				RETURN 0
			ENDIF
		ELSEIF ARG == 5 && ARG:1 == 15 && !GETBIT(ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 9) 
			;南からは開けられない
			IF FLAG:현Y > ARG:1
				CALL MESSAGE_WINDOW_D, "", "＞문이 닫혀있다/＞반대편에서 한 번 열 필요가 있는 것 같다"
