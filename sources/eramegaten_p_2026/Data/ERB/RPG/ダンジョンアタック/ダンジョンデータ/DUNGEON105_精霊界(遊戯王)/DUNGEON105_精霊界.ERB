				SETBIT ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 9
				RETURN 0
			ENDIF
		ENDIF
	;白銀の迷宮城　１階用
	CASE 7
		IF ARG == 10 && ARG:1 == 5 && !GETBIT(ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 10) 
			;南からは開けられない
			IF FLAG:현Y > ARG:1
				CALL MESSAGE_WINDOW_D, "", "＞문이 닫혀있다/＞반대편에서 한 번 열 필요가 있는 것 같다"
				RETURN 0
			ELSE
				CALL MESSAGE_WINDOW_D, "", "＞닫혀 있던 문을 열었다"
				SETBIT ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 10
				RETURN 0
			ENDIF
		ELSEIF ARG == 10 && ARG:1 == 9 && !GETBIT(ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 11) 
			;南からは開けられない
			IF FLAG:현Y > ARG:1
				CALL MESSAGE_WINDOW_D, "", "＞문이 닫혀있다/＞반대편에서 한 번 열 필요가 있는 것 같다"
				RETURN 0
			ELSE
				CALL MESSAGE_WINDOW_D, "", "＞닫혀 있던 문을 열었다"
				SETBIT ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 11
