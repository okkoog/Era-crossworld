;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_105,ARG,ARG:1
;ARG、ARG:1はそれぞれ対象のマスのX、Y座標を表しています。
;このダンジョンではエレベーターの扉が一度右側から開けておかないと左側からは開けられない、という処理に使用しています。
;どのマップでも座標(2,7)がエレベータの扉。ダンジョンフラグ:(FLAG:현던전):13 ＝ エレベータフラグ管理用変数の{現在のマップ番号}番目のビットが立っていなければ開けられるかどうかの判定を行う
SELECTCASE FLAG:현M
	;精霊界入口用
	CASE 0
	;蟲惑魔の森　浅層用
	CASE 1
		IF ARG == 1 && ARG:1 == 15 && !GETBIT(ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M)
			;南からは開けられない
			IF FLAG:현Y > ARG:1
				CALL MESSAGE_WINDOW_D, "", "＞나무 벽에 작은 틈이 있다/＞반대편에서 한 번 지나갈 필요가 있는 것 같다"
				RETURN 0
			ELSE
				CALL MESSAGE_WINDOW_D, "", "＞작은 틈을 넓혀 지나갈 수 있게 만들었다"
				SETBIT ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M
				RETURN 0
			ENDIF
		ENDIF
	;蟲惑魔の森　中層用
	CASE 2
		IF ARG == 4 && ARG:1 == 18 && !GETBIT(ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 2 ) 
		;西からは開けられない
			IF FLAG:현X < ARG
				CALL MESSAGE_WINDOW_D, "", "＞나무 벽에 작은 틈이 있다/＞반대편에서 한 번 지나갈 필요가 있는 것 같다"
				RETURN 0
			ELSE
				CALL MESSAGE_WINDOW_D, "", "＞작은 틈을 넓혀 지나갈 수 있게 만들었다"
				SETBIT ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 2
				RETURN 0
			ENDIF
		ENDIF
	;蟲惑魔の森　深層用
	CASE 3
		IF ARG == 2 && ARG:1 == 18 && !GETBIT(ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 3) 
			;西からは開けられない
			IF FLAG:현X < ARG
				CALL MESSAGE_WINDOW_D, "", "＞나무 벽에 작은 틈이 있다/＞반대편에서 한 번 지나갈 필요가 있는 것 같다"
				RETURN 0
			ELSE
				CALL MESSAGE_WINDOW_D, "", "＞작은 틈을 넓혀 지나갈 수 있게 만들었다"
				SETBIT ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 3
				RETURN 0
			ENDIF
		ELSEIF ARG == 7 && ARG:1 == 18 && !GETBIT(ダンジョンフラグ:(FLAG:현던전):3 , FLAG:현M) 
			CALL MESSAGE_WINDOW_D, "", "나무 벽 너머에서 무시무시한 기척이 느껴진다…"
			CALL INPUT_SELECT_D, "[0] 연다/[1] 열지 않는다 "
			SIF RESULT
				RETURN 0
			;通った場合はただの扉にする
			DA:ARG:(ARG:1) = 2
			SETBIT ダンジョンフラグ:(FLAG:현던전):3 , FLAG:현M
			RETURN 1
		ENDIF
	;魔法族の里　浅層用
	CASE 4
		IF ARG == 18 && ARG:1 == 16 && !GETBIT(ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 4)
			;南からは開けられない
			IF FLAG:현Y > ARG:1
				CALL MESSAGE_WINDOW_D, "", "＞문이 닫혀있다/＞반대편에서 한 번 열 필요가 있는 것 같다"
				RETURN 0
			ELSE
				CALL MESSAGE_WINDOW_D, "", "＞닫혀 있던 문을 열었다"
				SETBIT ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 4
				RETURN 0
			ENDIF
		ENDIF
	;魔法族の里　中層用
	CASE 5
		IF ARG == 3 && ARG:1 == 18 && !GETBIT(ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 5) 
		;西からは開けられない
			IF FLAG:현X < ARG
				CALL MESSAGE_WINDOW_D, "", "＞문이 닫혀있다/＞반대편에서 한 번 열 필요가 있는 것 같다"
				RETURN 0
