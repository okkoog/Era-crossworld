	RETURN 999
RETURN 0
;=======================================================================
;タイル調整
;=======================================================================
;ARG:1、ARG:2はそれぞれX座標とY座標
;ARGはその座標に現在代入されている番号
;0：壁　1：床もしくは通路　2：扉　3：宝箱　4：イベント　5：罠　6：上り階段 7：下り階段　8：出口　9：その他特殊処理等
;これらの内、3～9が代入されているマスに、個別の番号を与える処理を実行します。
;この処理を行った後、これらのマスには 「マップ番号*1000 + そのマスがそのマップで左上から数えて何個目のARGタイプのマスか*10 + ARG」が代入されます
;例えば 2003 であった場合、「2番のマップ＝３Ｆで、左上から数えて0個目の3＝宝箱である」という事を意味しています
;尚、0～2はどのマップにも大量に設置されるので、ここでは基本的に個別の番号を与えません。
;
;何個目のARGタイプのマスなのか、は左上の(0,0)から右まで探し、その後一つ下の段に移って同様に探す、というのを右下まで繰り返して数えます。
@MAKE_FLOOR_LINE_COMMON_105, ARG, ARG:1, ARG:2
#LOCALSIZE 10
;LOCAL:0～9 それぞれ何個目のARGなのかを記憶しています
;LOCAL:3 宝箱→使用フラグはダンジョンフラグ:70~74
;指定された座標が(0,0)である場合、つまり新しいマップを読み込んだ時はLOCALを消去します
SIF ARG:1 == 0 && ARG:2 == 0
	VARSET LOCAL
SELECTCASE ARG
	CASE 3
		;宝箱は多くの場合、開けたフラグが立っていると床を代入します
		;そのマップでどの宝箱を開けたかは、そのマップの宝箱管理用変数の何番目のビットが立っているかで判断します
		IF GETBIT(ダンジョンフラグ:(FLAG:현던전):(FLAG:현M+70), LOCAL:3)
			DA:(ARG:1):(ARG:2) = 1
		ELSE
			DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:3 * 10 + 3
		ENDIF
		LOCAL:3++
	CASE 4 TO 9
		DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:ARG * 10 + ARG
		LOCAL:ARG++
	
ENDSELECT
;各ダンジョンに入ったら、他ダンジョンの入口を封鎖する。クリア済みは封鎖しない。
SELECTCASE FLAG:현M
	CASE 0
		;蟲惑魔の森攻略中で他未クリア
		IF ダンジョンフラグ:(FLAG:현던전):22 == 1 && ダンジョンフラグ:(FLAG:현던전):23 == 0 && ダンジョンフラグ:(FLAG:현던전):24 == 0
			DA:8:1 = 1
			DA:1:8 = 1
			DA:15:8 = 29
		;魔法族の里攻略中で他未クリア
		ELSEIF ダンジョンフラグ:(FLAG:현던전):22 == 0 && ダンジョンフラグ:(FLAG:현던전):23 == 1 && ダンジョンフラグ:(FLAG:현던전):24 == 0
			DA:8:1 = 1
			DA:1:8 = 19
			DA:15:8 = 1
		;白銀の迷宮城攻略中で他未クリア
		ELSEIF ダンジョンフラグ:(FLAG:현던전):22 == 0 && ダンジョンフラグ:(FLAG:현던전):23 == 0 && ダンジョンフラグ:(FLAG:현던전):24 == 1
			DA:8:1 = 9
			DA:1:8 = 1
			DA:15:8 = 1
		;蟲惑魔の森クリア済みで魔法族の里攻略中
		ELSEIF ダンジョンフラグ:(FLAG:현던전):22 == 2 && ダンジョンフラグ:(FLAG:현던전):23 == 1 && ダンジョンフラグ:(FLAG:현던전):24 == 0
			DA:8:1 = 1
			DA:1:8 = 19
			DA:15:8 = 29
		;蟲惑魔の森クリア済みで白銀の迷宮城攻略中
		ELSEIF ダンジョンフラグ:(FLAG:현던전):22 == 2 && ダンジョンフラグ:(FLAG:현던전):23 == 0 && ダンジョンフラグ:(FLAG:현던전):24 == 1
			DA:8:1 = 9
			DA:1:8 = 1
			DA:15:8 = 29
		;魔法族の里クリア済みで蟲惑魔の森攻略中
		ELSEIF ダンジョンフラグ:(FLAG:현던전):22 == 1 && ダンジョンフラグ:(FLAG:현던전):23 == 2 && ダンジョンフラグ:(FLAG:현던전):24 == 0
			DA:8:1 = 1
			DA:1:8 = 19
			DA:15:8 = 29
		;魔法族の里クリア済みで白銀の迷宮城攻略中
		ELSEIF ダンジョンフラグ:(FLAG:현던전):22 == 0 && ダンジョンフラグ:(FLAG:현던전):23 == 2 && ダンジョンフラグ:(FLAG:현던전):24 == 1
			DA:8:1 = 9
			DA:1:8 = 19
			DA:15:8 = 1
		;白銀の迷宮城クリア済みで蟲惑魔の森攻略中
		ELSEIF ダンジョンフラグ:(FLAG:현던전):22 == 1 && ダンジョンフラグ:(FLAG:현던전):23 == 0 && ダンジョンフラグ:(FLAG:현던전):24 == 2
			DA:8:1 = 9
			DA:1:8 = 1
			DA:15:8 = 29
		;白銀の迷宮城クリア済みで魔法族の里攻略中
		ELSEIF ダンジョンフラグ:(FLAG:현던전):22 == 0 && ダンジョンフラグ:(FLAG:현던전):23 == 1 && ダンジョンフラグ:(FLAG:현던전):24 == 2
			DA:8:1 = 9
			DA:1:8 = 19
			DA:15:8 = 1
		;2つ攻略完了したらもう全部開放でいい
		ELSE
			DA:8:1 = 9
			DA:1:8 = 19
			DA:15:8 = 29
		ENDIF
ENDSELECT


