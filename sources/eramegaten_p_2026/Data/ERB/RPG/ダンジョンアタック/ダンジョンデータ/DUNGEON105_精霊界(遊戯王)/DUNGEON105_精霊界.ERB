				RETURN 0
			ELSE
				CALL MESSAGE_WINDOW_D, "", "＞닫혀 있던 문을 열었다"
				SETBIT ダンジョンフラグ:(FLAG:현던전):13 , FLAG:현M + 15
				RETURN 0
			ENDIF
		ENDIF
ENDSELECT
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

