;=======================================================================
;攻略条件
;第二段階の納金が終わったら開放を想定
;遊戯王ONじゃないと出ない。
;=======================================================================
@PREREQUISITE_DUNGEON_105
SIF !GETS_USEABLE_EXTRA_TITLE("遊戯王")
	RETURN 0
SIF FLAG:조직공헌도 < 10000
	RETURN 0
RETURN 1

