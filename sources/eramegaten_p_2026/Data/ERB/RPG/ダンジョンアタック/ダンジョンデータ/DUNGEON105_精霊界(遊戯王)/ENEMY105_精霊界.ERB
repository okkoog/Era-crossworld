			CFLAG:ARG:입력행동 = [[스킬:기합]]
	ENDSELECT
	;カジャンダの許容は3回まで
	FOR LOCAL, 1, 7
		IF POS(LOCAL) > 0 && CFLAG:POS(LOCAL):AUTO_SPLIT("명중강화/회피강화/마법위력강화/공격강화/방어강화", "/", LOCAL:1) > 12
			CFLAG:ARG:입력행동 = [[스킬:데・카쟈]]
			CFLAG:ARG:타겟 = -1
		ENDIF
	NEXT
	IF GET_カジャンダ_MIN(ARG) < -12
		CFLAG:ARG:입력행동 = [[스킬:데・쿤다]]
	ENDIF
ELSEIF CFLAG:ARG:행동한횟수 == 1
	SELECTCASE FLAG:경과턴수 % 3
		;１ターン目,４ターン目,７ターン目...
		CASE 0
			CFLAG:ARG:입력행동 = [[스킬:메기도크로스]]
		;２ターン目,５ターン目,８ターン目...
		CASE 1
			CFLAG:ARG:입력행동 = [[스킬:메기도크로스]]
		;３ターン目,６ターン目,９ターン目...
		CASEELSE
			CFLAG:ARG:입력행동 =  [[스킬:전용기1]]
	ENDSELECT
ELSEIF CFLAG:ARG:행동한횟수 == 2
	SELECTCASE FLAG:경과턴수 % 3
		;１ターン目,４ターン目,７ターン目...
		CASE 0
			CFLAG:ARG:입력행동 = [[스킬:히트라이저]]
		;２ターン目,５ターン目,８ターン目...
		CASE 1
			CFLAG:ARG:입력행동 = [[스킬:히트라이저]]
		;３ターン目,６ターン目,９ターン目...
		CASEELSE
			CFLAG:ARG:입력행동 = [[스킬:히트라이저]]
	ENDSELECT
	;カジャンダの許容は2回まで
	FOR LOCAL, 1, 7
		IF POS(LOCAL) > 0 && CFLAG:POS(LOCAL):AUTO_SPLIT("명중강화/회피강화/마법위력강화/공격강화/방어강화", "/", LOCAL:1) > 12
			CFLAG:ARG:입력행동 = [[스킬:데・카쟈]]
			CFLAG:ARG:타겟 = -1
		ENDIF
	NEXT
	IF GET_カジャンダ_MIN(ARG) < -12
		CFLAG:ARG:입력행동 = [[스킬:데・쿤다]]
	ENDIF
ELSEIF CFLAG:ARG:행동한횟수 == 3
	SELECTCASE FLAG:경과턴수 % 3
		;１ターン目,４ターン目,７ターン目...
		CASE 0
			CFLAG:ARG:입력행동 = [[스킬:랜더마이저]]
		;２ターン目,５ターン目,８ターン目...
		CASE 1
			CFLAG:ARG:입력행동 = [[스킬:랜더마이저]]
		;３ターン目,６ターン目,９ターン目...
		CASEELSE
			CFLAG:ARG:입력행동 = [[스킬:랜더마이저]]
	ENDSELECT
ENDIF

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;行動未決定時のおまじない
SIF CFLAG:ARG:입력행동 == -1
	CALL ランダム行動 , ARG
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1
