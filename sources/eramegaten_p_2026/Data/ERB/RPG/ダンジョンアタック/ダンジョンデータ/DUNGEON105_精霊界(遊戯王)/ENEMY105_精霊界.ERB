;=======================================================================
;인카운트율
;1歩で2％上がる、アンダーグラウンドは仲魔稼ぎ用フロアなので一歩で5%上げる。
;5歩まではエンカウント率が上がらないように
;13はアンダーグラウンド最深層、敵は出さない(階層時点だと実装雑魚敵無し)ので入口と同じ扱いに。
;=======================================================================
@ENCOUNT_RATE_105
SELECTCASE FLAG:현M
	;入口、アンダーグラウンド最深層
	CASE 0 , 13
		FLAG:미조우걸음수 = 0
		FLAG:인카운트율 = 0
		FLAG:MAG소비율 = 0
	;蟲惑魔の森、魔法族の里、白銀の迷宮城
	CASE 1 TO 9
		FLAG:MAG소비율 = 100
		FLAG:인카운트율 = MAX(FLAG:미조우걸음수-5,0)*2
	;アンダーグラウンド浅層から深層
	CASE 10 TO 12
		FLAG:MAG소비율 = 100
		FLAG:인카운트율 = FLAG:미조우걸음수*5
	CASEELSE
ENDSELECT

;=======================================================================
;必要レベル目安
;推奨LV 雑魚最低LV 雑魚最高LV ボスLV 
;=======================================================================
@GET_DUNGEON_LV_105
IF ダンジョンフラグ:(FLAG:현던전):20 == 0
	RETURN 15, 15, 25, 35
ELSEIF ダンジョンフラグ:(FLAG:현던전):20 == 1
	RETURN 30, 30, 40, 50
ELSEIF ダンジョンフラグ:(FLAG:현던전):20 == 2
	RETURN 45, 45, 55, 65
ENDIF
;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_105
IF RAND:100 < FLAG:인카운트율
	RETURN 1
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF

;=======================================================================
;敵の種族の種類数
;RETURN X でXが種類の数になります
;蟲惑魔の森、魔法族の里、白銀の迷宮城の
;浅層、中層と1階、2階は中級で(40%で1種類、50%で2種類、10%で3種類)
;深層と3階は最上級で(30%で1種類、60%で2種類、10%で3種類)
;敵が強いので減量。
;アンダーグラウンドは3種類固定で
;=======================================================================
@CLASS_NUM_105
SELECTCASE FLAG:현M
	CASE 1,2 ,4, 5 ,7, 8
		RETURN CLASS_NUM_COMMON("中級")
	CASE 3 , 6 , 9
		RETURN CLASS_NUM_COMMON("最上級")
	CASE 10 TO 12
		RETURN 3
ENDSELECT

;=======================================================================
;敵の総数
;浅層と1階は3体から6体出る。
;中層と2階は3体から8体出る。この時1種類だと最大6、2種類だと7、3種類だと8まで出る。
;深層と3階は3体から10体出る。この時1種類だと最大6、2種類だと8、3種類だと10まで出る。
;アンダーグラウンドは6～10体出す。
;=======================================================================
@ENEMY_NUM_105, ARG
SELECTCASE FLAG:현M
	CASE 1 , 4 , 7
		RETURN RAND(3,7)
	CASE 2 , 5 , 8
		RETURN RAND(3, ARG+6)
	CASE 3 , 6 , 9
		RETURN RAND(3, ARG*2+5)
	CASE 10 TO 12
		RETURN RAND(6, 11)
ENDSELECT
