;=======================================================================
;巨大フレシア一段階目行動パターン
;=======================================================================
@SET_ACTION_巨大フレシア１, ARG
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
;ワンモア（クリティカルか、弱点を突いた場合の行動）
IF CFLAG:ARG:１more플래그 > 0
	;1more時は紫煙乱打かマインドスライスを撃つ、無理ならランダム行動
	CALL SET_ACTION_SKILL, ARG, ( RAND:2 == 0 ? [[스킬:마인드슬라이스]] # [[스킬:자연난타]] )
ELSEIF CFLAG:ARG:행동한횟수 == 0
	SELECTCASE FLAG:경과턴수 % 3
		;１ターン目,４ターン目,７ターン目...
		CASE 0
			CFLAG:ARG:입력행동 =  [[스킬:성불권]]
		;２ターン目,５ターン目,８ターン目...
		CASE 1
			CFLAG:ARG:입력행동 = [[스킬:비틀어꺾기]]
		;３ターン目,６ターン目,９ターン目...
		CASEELSE
			CALL SET_ACTION_SKILL, ARG, ( RAND:2 == 0 ? [[스킬:마인드슬라이스]] # [[스킬:자연난타]] )
	ENDSELECT
ELSEIF CFLAG:ARG:행동한횟수 == 1
	SELECTCASE FLAG:경과턴수 % 3
		;１ターン目,４ターン目,７ターン目...
		CASE 0
			CFLAG:ARG:입력행동 = [[스킬:섹시댄스]]
		;２ターン目,５ターン目,８ターン目...
		CASE 1
			CFLAG:ARG:입력행동 = [[스킬:바인드보이스]]
		;３ターン目,６ターン目,９ターン目...
		CASEELSE
			CALL SET_ACTION_SKILL, ARG, ( RAND:2 == 0 ? [[스킬:바인드보이스]] # [[스킬:섹시댄스]] )
	ENDSELECT
ENDIF
;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;行動未決定時のおまじない
SIF CFLAG:ARG:입력행동 == -1
	CALL ランダム行動 , ARG
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1

