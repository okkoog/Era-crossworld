;=======================================================================
;敵の種類
;=======================================================================
@ENEMY_26, ARG
#LOCALSIZE 1
;きっと♂は兄弟に滅ぼされたんだろうな
SELECTCASE FLAG:현M
;------ MOD 005 ADD START --------
	;CASE IS < 9
	CASE 0,1,2,5,6
		SELECTCASE RAND:100
				CASE IS < 15
					;15%
					RETURN [[キャラ:아메노우즈메]],29+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
				CASE IS < 35
					;20%
					RETURN [[キャラ:사라시나히메]],30+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
				CASE IS < 55
					;20%
					RETURN [[キャラ:후지무스메]],31+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
					;ABL:(CHARANUM-1):스킬4 = 106;ここに有っても意味ないので↓に追加
				CASE IS < 70
					;15%
					RETURN [[キャラ:키쿠리히메]],32+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
				CASE IS < 80
					;10%
					RETURN [[キャラ:선리]],33+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
				CASE IS < 90
					;10%
					RETURN [[キャラ:백낭자]],34+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
				CASE IS < 100
					;10%
					RETURN [[キャラ:오시치]],35+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
		ENDSELECT
	CASE 3,4,7,8
		LOCAL = 7
		SIF !RAND:(LOCAL --)
			RETURN [[キャラ:백낭자]], 39+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
		SIF !RAND:(LOCAL --)
			RETURN [[キャラ:오시치]], 40+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
		SIF !RAND:(LOCAL --)
			RETURN [[キャラ:후지무스메]], 41+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
		SIF !RAND:(LOCAL --)
			RETURN [[キャラ:천선낭랑]], 42+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
		SIF !RAND:(LOCAL --)
			RETURN [[キャラ:쿠치사케]], 43+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
		SIF !RAND:(LOCAL --)
			RETURN [[キャラ:오토히메]], 44+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
		SIF !RAND:(LOCAL --)
			RETURN [[キャラ:스미조메]], 45+RAND:(1+MAX((FLAG:현M-1) % 4,0)*3)
ENDSELECT
