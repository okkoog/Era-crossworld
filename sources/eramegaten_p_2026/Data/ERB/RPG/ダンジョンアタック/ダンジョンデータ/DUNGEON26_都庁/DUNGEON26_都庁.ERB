						CALL MESSAGE_WINDOW_D, "", @"＞%\@(TALENT:MASTER:남자 == 0 && TEQUIP:MASTER:음순노출 != -1) || TEQUIP:MASTER:둔부노출 != -1?속옷은 정액투성이가 되어 버려서 입을 수 없기에、/＞#\@%%MASTER는% 정액이 흘러내리는 사타구니를 드러낸 채 집으로 향했다"
						FLAG:탈출 = 1
					ENDIF
					
					RETURN 1
					
				ENDIF
			ELSEIF ダンジョンフラグ:(FLAG:현던전):2 >= 4
				CALL MESSAGE_WINDOW_D, "", "＞아무도 없다……"
			ENDIF
			
		CASEELSE
			RETURN 1
	ENDSELECT
;========================
;エレベーター
;========================
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 9
	SELECTCASE FLAG:현M
		CASE 0
			IF FLAG:현X == 1
				CALL MESSAGE_WINDOW_D, "＞엘리베이터가 있다", "＞４５Ｆ까지 갑니까？"
				CALL INPUT_YN_D
				IF RESULT == 0
					FLAG:현M = 1
					FLAG:현X = 13
					FLAG:현Y = 1
					CALL MAKE_FLOOR, FLAG:현던전
					CALL AUTOMAP
				ENDIF
				RETURN 1
			ELSEIF FLAG:현X == 9
				CALL MESSAGE_WINDOW_D, "＞엘리베이터가 있다", "＞옥상까지 갑니까？"
				CALL INPUT_YN_D
				IF RESULT == 0
					FLAG:현M = 9
					FLAG:현X = 4
					FLAG:현Y = 6
					CALL MAKE_FLOOR, FLAG:현던전
					CALL AUTOMAP
				ENDIF
				RETURN 1
			
			ELSEIF FLAG:현X == 17
				CALL MESSAGE_WINDOW_D, "＞엘리베이터가 있다", "＞４５Ｆ까지 갑니까？"
				CALL INPUT_YN_D
				IF RESULT == 0
					FLAG:현M = 5
					FLAG:현X = 3
					FLAG:현Y = 1
					CALL MAKE_FLOOR, FLAG:현던전
					CALL AUTOMAP
				ENDIF
				RETURN 1
			ENDIF
		CASE 1
			CALL MESSAGE_WINDOW_D, "＞엘리베이터가 있다", "＞３０Ｆ까지 갑니까？"
			CALL INPUT_YN_D
			IF RESULT == 0
				FLAG:현M = 0
				FLAG:현X = 1
				FLAG:현Y = 1
				CALL MAKE_FLOOR, FLAG:현던전
				CALL AUTOMAP
			ENDIF
			RETURN 1
		CASE 5
			CALL MESSAGE_WINDOW_D, "＞엘리베이터가 있다", "＞３０Ｆ까지 갑니까？"
			CALL INPUT_YN_D
			IF RESULT == 0
				FLAG:현M = 0
				FLAG:현X = 17
				FLAG:현Y = 1
				CALL MAKE_FLOOR, FLAG:현던전
				CALL AUTOMAP
			ENDIF
			RETURN 1
		CASE 9
			CALL MESSAGE_WINDOW_D, "＞엘리베이터가 있다", "＞３０Ｆ까지 갑니까？"
			CALL INPUT_YN_D
			IF RESULT == 0
				FLAG:현M = 0
				FLAG:현X = 9
				FLAG:현Y = 1
				CALL MAKE_FLOOR, FLAG:현던전
				CALL AUTOMAP
			ENDIF
			RETURN 1
			
	ENDSELECT
ENDIF
RETURN 0


