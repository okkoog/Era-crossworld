;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_26,ARG
FLAG:현M = 0
FLAG:현X = 9
FLAG:현Y = 7
;CALL AUTOMAP

;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_26
CALL SHOW_PICTURE, "D"
CALL MESSAGE_WINDOW_D, "", "＞이계화된 도청에 발을 들여놓았다"
IF ダンジョンフラグ:(FLAG:현던전):0 == 4 && ダンジョンフラグ:(FLAG:현던전):2 == 3
	CALL MESSAGE_WINDOW_D, "", "＞스사노오와 아마테라스는 어찌 지내고 있을까"
ELSEIF ダンジョンフラグ:(FLAG:현던전):1 == 4 && ダンジョンフラグ:(FLAG:현던전):2 == 3
	CALL MESSAGE_WINDOW_D, "", "＞츠쿠요미와 아마테라스는 어찌 지내고 있을까"
ENDIF
;------ MOD 005 ADD START --------
;=======================================================================
;脱出時のイベント
;=======================================================================
@EVENT_DUNGEON_END_26
IF ダンジョンフラグ:35:2 != 1 && ダンジョンフラグ:47:2 != 1
	IF (ダンジョンフラグ:(FLAG:현던전):2 > 2 || ダンジョンフラグ:(FLAG:현던전):0 > 4 || ダンジョンフラグ:(FLAG:현던전):1 > 4) && ダンジョンフラグ:(FLAG:현던전):4 < 2
		IF ダンジョンフラグ:(FLAG:현던전):2 == 4
			CALL MESSAGE_WINDOW_D, "천진신 아마테라스", "이 거울을 당신에게 드리겠습니다/이것으로 긴자 대지하도에서 카테드랄로 갈 수 있겠지요"
		ELSEIF ダンジョンフラグ:(FLAG:현던전):2 > 2
			CALL MESSAGE_WINDOW_D, "", "＞돌아가는 길에 아마테라스에게서 거울을 빼앗았다"
		ELSE
			CALL MESSAGE_WINDOW_D, "", "＞미리 붕괴된 아마테라스에게서 거울을 슬쩍해 두었다"
		ENDIF
		CALL MESSAGE_WINDOW_D, "", "＞아마테라스의 거울을 손에 넣었다"
		ダンジョンフラグ:(FLAG:현던전):4 = 2
		SETBIT ダンジョンフラグ:20:8,0
	ENDIF
ENDIF
;------ MOD 005 ADD END --------
;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_26,ARG,ARG:1
IF FLAG:현M == 0 && ARG == 9 && ARG:1 == 2
	IF ダンジョンフラグ:(FLAG:현던전):2 >= 1
		RETURN 1
	ENDIF
	IF (ダンジョンフラグ:(FLAG:현던전):0 >= 2 && ダンジョンフラグ:(FLAG:현던전):1 >= 2) || ダンジョンフラグ:(FLAG:현던전):0 == 4 || ダンジョンフラグ:(FLAG:현던전):1 == 4
		IF ダンジョンフラグ:(FLAG:현던전):2 == 0
			CALL MESSAGE_WINDOW_D, "", "＞옥상으로 이어지는 엘리베이터의 결계가 풀렸다"
			ダンジョンフラグ:(FLAG:현던전):2 = 1
		ENDIF
		RETURN 1
	ELSE
		CALL MESSAGE_WINDOW_D, "", "＞결계가 쳐져 있어 앞으로 나아갈 수 없다"
		RETURN 0
	ENDIF
	
ELSE
	CALL CAN_ENTER,ARG,ARG:1
	RETURN RESULT
ENDIF
