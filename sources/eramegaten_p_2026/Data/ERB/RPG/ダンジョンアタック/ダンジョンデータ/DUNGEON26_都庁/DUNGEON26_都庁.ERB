;ダンジョンナンバー6　ＭＡＰ0~2
;ダンジョンフラグ:(FLAG:현던전):0 イベント進行状況 1 スサノオ謁見 2 説得した 3 撃破 4 協力した 5 アマちゃんレイプ後 6 ヤらせてあげた 7 その後帰った
;ダンジョンフラグ:(FLAG:현던전):1 イベント進行状況 1 ツクヨミ謁見 2 説得した 3 撃破 4 協力した 5 6 
;ダンジョンフラグ:(FLAG:현던전):2 イベント進行状況 1 開通イベント見た 2 アマテラス謁見 3 レイプ 4 助けた 5 壊れてから入手 6食べた 7撃破
;ダンジョンフラグ:(FLAG:현던전):3 戦闘管理用
;------ 005 ADD --------
;ダンジョンフラグ:(FLAG:현던전):4 特殊イベント用 1 都庁解禁
;													   2 封印解除フラグ
;------ 006 ADD --------
;///
;ダンジョンフラグ:(FLAG:현던전):11～　宝箱
;=======================================================================

;=======================================================================
;攻略条件
;=======================================================================
;衛生病院クリア済み
@PREREQUISITE_DUNGEON_26
IF (ダンジョンフラグ:35:1 == -1 || ダンジョンフラグ:35:2 == 1) && (ダンジョンフラグ:47:1 == -1 || ダンジョンフラグ:47:2 == 1)
	IF ダンジョンフラグ:35:1 == -1 && ダンジョンフラグ:47:1 == -1 && ダンジョンフラグ:26:4 == 0
		CALL MESSAGE_WINDOW, "선배", "여, 하니엘도 에키드나도/때려잡았다며"
		CALL MESSAGE_WINDOW, "선배", "그런 너에게 좋은 정보가 있다"
		CALL MESSAGE_WINDOW, "선배", "지금 도청에 아마테라스가 있다는 이야기야/있는 이유는 모르겠지만"
		CALL MESSAGE_WINDOW, "선배", "그 녀석이 가지고 있는 거울이 있다면/긴자 지하도의 결계를 풀 수 있을지도 몰라"
	ENDIF
	SIF ダンジョンフラグ:26:4 < 1
		ダンジョンフラグ:26:4 = 1
	RETURN 1
ENDIF
RETURN 0


