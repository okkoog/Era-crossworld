;=======================================================================
;●おしながき
;1.都庁_スサノオ_単独
;2.都庁_ツクヨミ_単独
;3.都庁_アマテラス_単独
;4.都庁_スサノオ_協力
;5.都庁_ツクヨミ_協力
;6.都庁_アマテラス_協力
;7.生死判定とか天孫降臨判定とか
;=======================================================================
;●コンセプト
;・きちんと戦ってあげるとLv60として相応しい程度の強さ
;・ただし抜け道アリ
;・3人で戦うんだから3人協力パターンも欲しいよね（ﾘｶｰﾑﾄﾞﾗｰ）
;・AIはぶっちゃけ貧弱
;・全員、固定行動以外はランダム行動であるとか
;・スサノオが「既にガードブレイクがかかっててもガードブレイクを使う」ってあたりとか
;・ツクヨミが「即死効かなくてもけっこうな確率で即死攻撃してくる」とか
;・アマテラスが「本気になるまでメギドラしかつかわない」とか
;=======================================================================
;●基本的な動き
;　基本3回行動。3体共通で下記のように動く。
;　1.천손강림
;　　HPが50％以下になった次のターンのみ、4回行動を行う。
;　　「천손강림」「기합/コンセ」「得意属性ガーキル」「必殺攻撃」
;　　基本的にヌルい動きをさせているが、このターンは「当たって死ね」。
;　　コンセプトは履行技。
;　　使用後はスキルがちょっと増える。
;　2.通常時
;　　HPが50％以上、または天孫降臨を使用した後のターンは、下記のように分岐する。
;　　１、メインターン（66％）
;　　　得意属性による行動。
;　　　得意属性ガーキルを含むランダム補助行動→得意属性によるランダム攻撃行動
;　　２、サブターン（33％）
;　　　補助的な行動を行う。
;　3.発狂
;　　アマテラス＆ツクヨミ＆スサノオ戦でのみ、発狂が存在する。
;　　わざわざ「面倒だから全員かかってこい！！！！！！！！！！！！！！」するんだからあたりまえだね。
;　　・スサノオとツクヨミが撃破されている
;　　　アマテラスがリカームドラを使用する。
;　　・アマテラスが撃破されている（またはリカームドラを使用した）
;　　　復活したスサノオとツクヨミが発狂し、4回行動となる。
;　　　また、天孫降臨を使用していなかった場合、次のターンは天孫降臨ターンとなる。
;　　　発狂後はスキルがまたちょっと増える。
;　推奨撃破順は、「スサノオまたはツクヨミ」「アマテラス」「残ったひと柱」です。
;　逆に、「スサノオ＆ツクヨミ」を先に撃破してしまうと面倒だと思う。

;=======================================================================
;●謝辞
;　なんか本スレで「アマテラスがリカームドラ使って即死するんだけど」みたいな話題があったと聞き、
;　「じゃあマジでリカームドラ使わせよう」と思った。
;　ありがとう、発言した人。それと相談に乗ってくれたDiscordのみなさん。
;　それからスタァライト、まどマギイベントの戦闘関連を参考にしました。感謝を。
;　あと、重力技。七星降天を、ツクヨミが使用した場合のみ全体攻撃にしました。ごめんなさい。
;　ちょっとマグネストームは……イメージがね……
;=======================================================================


;=======================================================================
@SET_ACTION_都庁_スサノオ_単独, ARG
;=======================================================================
;スサノオさんLv60になってもかなり微妙なので魔改造する
;執拗なガードブレイク！！！ガードブレイク！！！ただし命中補正系スキルを持ってない
;あと弱点を見たりしないし、既にガードブレイクがかかっててもガードブレイクを使う。
;元々持ってなかったので強化はされてるけど……みたいなところがある
;=======================================================================
; 本気モードフラグ
; 0＝HP50％以下
; 1＝HP50％以下になった次のターン（天孫降臨ターン）
; 2＝HP50％以下初回以後（本気モード）
#DIM 天孫降臨使用フラグ
; 物魔どっちつかうかフラグ、物理の方が多い
#DIM 物理のターンかフラグ


;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

;●行動開始時、行動パターンを判定
IF CFLAG:ARG:행동한횟수 == 0
	;●本気判定
	;天孫降臨を使っておらず、HPが50％以下なら本気モード
	;固定行動を行う（ために、行動回数が増える）
	IF 天孫降臨使用フラグ == 0 && TFLAG:435 == 1
		PRINTFORML ┏> 스사노오━━━━━━━━━━━━━━━┓
		PRINTFORML ┃어라앗, 간다앗!!　　　　　　　　　　┃
		PRINTFORML ┃쉽게 죽지 말라고오오오!!!　　　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━┛
		天孫降臨使用フラグ = 1
		CFLAG:ARG:행동횟수 = 4
	ENDIF


	;●物魔判定
	;3分の1で魔法を使用する
	;1で魔法ターン
	IF RAND:3 == 0
		物理のターンかフラグ = 1
	ELSE
		物理のターンかフラグ = 0
	ENDIF
	
ENDIF


;ワンモアが入ると殺しに来る
IF CFLAG:ARG:１more플래그 > 0
	;魔法ターンだとナルカミ
	IF 物理のターンかフラグ == 0
		CFLAG:ARG:입력행동 = [[스킬:나루카미]]
	;物理ターンだと気合い
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:기합]]
	ENDIF

;天孫降臨ターンの場合
ELSEIF 天孫降臨使用フラグ == 1
	IF CFLAG:ARG:행동한횟수 == 0
		CFLAG:ARG:입력행동 = [[스킬:천손강림]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		CFLAG:ARG:입력행동 = [[스킬:검격가드브레이크]]
	ELSEIF CFLAG:ARG:행동한횟수 == 2
		CFLAG:ARG:입력행동 = [[스킬:기합]]
	ELSEIF CFLAG:ARG:행동한횟수 == 3
		CFLAG:ARG:입력행동 = [[스킬:허공참파]]
		;天孫降臨を使用したフラグを立てる
		天孫降臨使用フラグ = 2
		;行動回数を戻す
		CFLAG:ARG:행동횟수 = 3
	ENDIF

;魔法のターン
ELSEIF 物理のターンかフラグ == 1
	;1.タルorラク
	;2.マハジオダイン
	;3.マハザンダイン
	;……を使用する
	IF CFLAG:ARG:행동한횟수 == 0
		IF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:타루・카쟈]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:라쿠・카쟈]]
		ENDIF
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		;本気モードだとたまにナルカミを使用
		IF RAND:3 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:나루카미]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:마하・지오다인]]
		ENDIF
	ELSEIF CFLAG:ARG:행동한횟수 == 2
		;まあDQNだしね
		IF RAND:3 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:마하・잔바리온]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:마하・잔다인]]
		ENDIF
	;おまじない
	ELSE
		IF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・지오다인]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:마하・잔다인]]
		ENDIF
	ENDIF
;物理のターン
ELSE
	;初回行動は、「ガードブレイクOR雄たけび」、雄叫び率が高め
	;ただしHPが50％以下なら気合いが入る
	IF CFLAG:ARG:행동한횟수 == 0
		IF RAND:4 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:기합]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:검격가드브레이크]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:포효]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:포효]]
		ENDIF
	;2回目以後はランダムで剣攻撃
	ELSE
		;本気モードだと虚空ザッパーを使用
		IF RAND:5 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:허공참파]]
		ELSEIF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:데스바운드]]
		;（単独で）スクカジャ使わせないのはコレのため
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:천경지폭단]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:이검난무]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:길로틴블레이드]]
		ENDIF
	ENDIF
ENDIF


;アクション実行不能
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1


@EVENT_BATTLE_TURNEND_都庁_スサノオ_単独
IF !IS_BADSTATE(GET_ENEMY("スサノオ"), "DYING") && 現HP割合(GET_ENEMY("スサノオ")) < 50 && TFLAG:435 == 0
	PRINTFORML ┏> 스사노오━━━━━━━━━━━━━━━┓
	PRINTFORML ┃제법 하잖아아!!　　　　　　　　　　┃
	PRINTFORML ┃이쪽도 조금은 진심을 내볼까!　　　┃
	PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━┛
	TFLAG:435 = 1
ENDIF



;=======================================================================
@SET_ACTION_都庁_ツクヨミ_単独, ARG
;=======================================================================
;ツクヨミさまLv60
;もとからまあまあのスキルかなと。破魔呪殺重力が得意
;빛의심판
;어둠의심판
;삼할의마맥
;컨센트레이트
;マハグラダイン
;도무디
;사마・카쟈
;칠성강천
;/
;デバフターンはあんまり火力がないのが弱点
;破魔呪殺弱点はこのレベル帯で放置してるのはあり得ないのでデバフターンは癒し
;ただワンモアが刺さり続けるとウザい
;=======================================================================
; 本気モードフラグ
; 0＝HP50％以下
; 1＝HP50％以下になった場合
; 2＝HP50％以下になった次のターン（天孫降臨ターン）
; 3＝HP50％以下初回以後（本気モード）
#DIM 天孫降臨使用フラグ
; 物魔どっちつかうかフラグ、通常行動の方が多い
#DIM デバフターンかフラグ

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1


;行動開始時、ターンの行動を判定
IF CFLAG:ARG:행동한횟수 == 0
	;●本気判定
	;天孫降臨を使っておらず、HPが50％以下なら本気モード
	;固定行動を行う（ために、行動回数が増える）
	IF 天孫降臨使用フラグ == 0 && ダンジョンフラグ:(FLAG:현던전):5 == 12
		PRINTFORML ┏> 츠쿠요미━━━━━━━━━━━━━━━┓
		PRINTFORML ┃그럼―― 가겠습니다　　　　　　　　┃
		PRINTFORML ┃달빛 아래에서 삶을 후회하도록 하라!!┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━┛
		天孫降臨使用フラグ = 1
		CFLAG:ARG:행동횟수 = 4
	ENDIF

	;●デバフ系判定
	;3分の1でデバフ系を使用する
	;1でデバフ系ターン
	IF RAND:3 == 0
		デバフターンかフラグ = 1
	ELSE
		デバフターンかフラグ = 0
	ENDIF
	
ENDIF


;ワンモアが入ると殺しに来る……といってもちょっと微妙かなー
IF CFLAG:ARG:１more플래그 > 0
	;デバフターンだと闇の審判or光の裁き
	IF デバフターンかフラグ == 0
		IF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:어둠의심판]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:빛의심판]]
		ENDIF
	;物理ターンだとコンセントレイト
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:컨센트레이트]]
	ENDIF

;天孫降臨ターンの場合
ELSEIF 天孫降臨使用フラグ == 1
	IF CFLAG:ARG:행동한횟수 == 0
		CFLAG:ARG:입력행동 = [[스킬:천손강림]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		CFLAG:ARG:입력행동 = [[스킬:중력가드브레이크]]
	ELSEIF CFLAG:ARG:행동한횟수 == 2
		CFLAG:ARG:입력행동 = [[스킬:컨센트레이트]]
	ELSEIF CFLAG:ARG:행동한횟수 == 3
		CFLAG:ARG:입력행동 = [[스킬:칠성강천]]
		;天孫降臨を使用したフラグを立てる
		天孫降臨使用フラグ = 2
		;行動回数を戻す
		CFLAG:ARG:행동횟수 = 3
	ENDIF

;デバフターン
ELSEIF デバフターンかフラグ == 1
	;1.スクンダorサマンダ
	;2.파마
	;3.주살
	;……を使用する
	IF CFLAG:ARG:행동한횟수 == 0
		IF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:스쿤・다]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:사만・다]]
		ENDIF
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		;本気モードだとたまに光の裁きを使用
		IF RAND:4 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:빛의심판]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:댐네이션]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:플레어라이트]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:마한마온]]
		ENDIF
	ELSEIF CFLAG:ARG:행동한횟수 == 2
		IF RAND:4 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:어둠의심판]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하주온]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:도무디]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:마하무드온]]
		ENDIF
	;おまじない
	ELSE
		IF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:에이가온]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:코우가온]]
		ENDIF
	ENDIF
;魔法攻撃のターン
ELSE
	;初回行動は、「ガードブレイクORスクORサマカジャ」
	;ただしHPが50％以下ならコンセが入る
	IF CFLAG:ARG:행동한횟수 == 0
		IF RAND:4 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:컨센트레이트]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:중력가드브레이크]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:스쿠・카쟈]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:사마・카쟈]]
		ENDIF
	;2回目以後はランダムで剣攻撃
	ELSE
		;本気モードだと七星降天を使用
		IF RAND:5 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:칠성강천]]
		ELSEIF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・그라다인]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:다무도라온]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:에이가온]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:코우가온]]
		ENDIF
	ENDIF
ENDIF


;アクション実行不能
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1

@EVENT_BATTLE_TURNEND_都庁_ツクヨミ_単独
