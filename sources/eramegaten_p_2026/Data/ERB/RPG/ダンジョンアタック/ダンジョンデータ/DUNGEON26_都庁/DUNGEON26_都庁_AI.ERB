			ELSEIF RAND:4 == 0
				CFLAG:ARG:입력행동 = [[스킬:칠성강천]]
			ELSEIF RAND:3 == 0
				CFLAG:ARG:입력행동 = [[스킬:다무도라온]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:만마의난무]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:크레센트미러]]
			ENDIF
		ENDIF
	ENDIF
ELSE
	;２桁にしてから判定開始
	IF 天孫降臨使用フラグ == 0 && TFLAG:436 == 1
		PRINTFORML ┏> 츠쿠요미━━━━━━━━━━━━━━━┓
		PRINTFORML ┃그럼―― 가겠습니다　　　　　　　　┃
		PRINTFORML ┃달빛 아래에서 삶을 후회하도록 하라!!┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━┛
