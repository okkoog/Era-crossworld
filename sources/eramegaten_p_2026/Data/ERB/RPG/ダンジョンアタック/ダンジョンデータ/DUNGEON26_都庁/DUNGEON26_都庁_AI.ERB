		;デバフターンだと闇の審判or光の裁き
		IF デバフターンかフラグ == 0
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:어둠의심판]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:빛의심판]]
			ENDIF
		;物理ターンだとコンセントレイト
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:컨센트레이트]]
		ENDIF

	;天孫降臨ターンの場合
	ELSEIF 天孫降臨使用フラグ == 1
		IF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = [[스킬:천손강림]]
