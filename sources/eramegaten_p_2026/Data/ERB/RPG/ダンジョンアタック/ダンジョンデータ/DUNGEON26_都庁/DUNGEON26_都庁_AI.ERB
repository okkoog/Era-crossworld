	TFLAG:435 = 1
ENDIF

;=======================================================================
@SET_ACTION_都庁_アマテラス_単独, ARG
;=======================================================================
;アマテラスさまLv65
;通常スキルは下記のとおり。
;디아라한
;마하기가리온
;메기도라
;트리스아기온
;칠색연옥파
;영세의기도
;리캄드라
;마카라브레이크
;프로미넌스
;/
;火炎、核熱、万能が得意
;本気を出さないと太陽神ターンのスキルがちょっとびみょいのが弱点
;デカジャ、デクンダを使用はするが、当然強化弱化を見てない
;=======================================================================
; 本気モードフラグ
; 0＝HP50％以下
; 1＝HP50％以下になった場合
; 2＝HP50％以下になった次のターン（天孫降臨ターン）
; 3＝HP50％以下初回以後（本気モード）
#DIM 天孫降臨使用フラグ

; 太陽神真面目にやるかそうじゃないかフラグ、太陽神の方が多い
#DIM 太陽神フラグ
;ランダムで常世の祈りを使用する(全回復)
#DIM 常世の祈りフラグ


;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1


;行動開始時、ターンの行動を判定
IF CFLAG:ARG:행동한횟수 == 0
	;●本気判定
	;天孫降臨を使っておらず、HPが50％以下なら本気モード
	;固定行動を行う（ために、行動回数が増える）
	IF 天孫降臨使用フラグ == 0 && ダンジョンフラグ:(FLAG:현던전):5 == 13
		PRINTFORML ┏> 아마테라스━━━━━━━━━━━━━━┓
		PRINTFORML ┃태양이여, 내 몸에 깃들어라!　　　　┃
		PRINTFORML ┃내 몸의 불꽃에 불타 사라져라!!　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━┛
		天孫降臨使用フラグ = 1
		CFLAG:ARG:행동횟수 = 4
	ENDIF

	;●太陽神判定
	;3分の1で万能・バフ系を使用する（ヒッキーモードになる）
	;1で太陽神ターン
	IF RAND:3 == 0
		太陽神フラグ = 0
	ELSE
		太陽神フラグ = 1
	ENDIF
ENDIF



;ワンモアが入ると殺しに来る
IF CFLAG:ARG:１more플래그 > 0
	;太陽神ターンだとトリスアギオンorコズミックフレア
	IF 太陽神フラグ == 0
		IF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:트리스아기온]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:코즈믹플레어]]
		ENDIF
	;万能ターンだと七色煉獄波
	ELSE
		CFLAG:ARG:입력행동 = [[스킬:칠색연옥파]]
	ENDIF

;天孫降臨ターンの場合
ELSEIF 天孫降臨使用フラグ == 1
	IF CFLAG:ARG:행동한횟수 == 0
		CFLAG:ARG:입력행동 = [[스킬:천손강림]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		CFLAG:ARG:입력행동 = [[스킬:화염가드브레이크]]
	ELSEIF CFLAG:ARG:행동한횟수 == 2
		CFLAG:ARG:입력행동 = [[스킬:컨센트레이트]]
	ELSEIF CFLAG:ARG:행동한횟수 == 3
		CFLAG:ARG:입력행동 = [[스킬:프로미넌스]]
		;天孫降臨を使用したフラグを立てる
		天孫降臨使用フラグ = 2
		;行動回数を戻す
		CFLAG:ARG:행동횟수 = 3
	ENDIF

;太陽神ターン
ELSEIF 太陽神フラグ == 1
	;1.회복/지원
	;2.火炎系スキル
	;3.核熱系スキル
	;……を使用する
	IF CFLAG:ARG:행동한횟수 == 0
		;だんだん「영세의기도」を使用する率が上がっていく（使用したら使用率リセット）
		常世の祈りフラグ += 1
		IF 常世の祈りフラグ > 5 && 常世の祈りフラグ > RAND:100
			CFLAG:ARG:입력행동 = [[스킬:영세의기도]]
			常世の祈りフラグ = 0
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:데・카쟈]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:데・쿤다]]
		ENDIF
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		;本気モードだとたまにトリスアギオンを使用
		;気合いは乗らないので貫通しない
		IF RAND:4 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:트리스아기온]]
		ELSEIF RAND:3 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:프로미넌스]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:염군의춤]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:마하・라기다인]]
		ENDIF
	ELSEIF CFLAG:ARG:행동한횟수 == 2
		IF RAND:4 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:코즈믹플레어]]
		ELSEIF RAND:3 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:아토믹플레어]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하기가리온]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:프레이다인]]
		ENDIF
	;おまじない
	ELSE
		IF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:마하・라기다인]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:프레이다인]]
		ENDIF
	ENDIF
;ヒッキーのターン
ELSE
	;行動は自己バフ・防御・万能攻撃
	;初手は自己バフ、踊りはどうだろうかって感じだけど
	IF CFLAG:ARG:행동한횟수 == 0
		IF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:파워브레스]]
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:천상의춤]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:마카・카쟈]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:사마・카쟈]]
		ENDIF
	;防御とかのターン、ちょっと躁鬱激しくない？
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		;ヒッキーモードなのでたるむ
		IF RAND:4 == 0
			CFLAG:ARG:입력행동 = [[스킬:타룬・다]]
		;ヒッキーモードなので空気がよどんでいる
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:무거운공기]]
		;ヒッキーなので引きこもる
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:테트라칸]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:마카라칸]]
		ENDIF
	ELSE
		;本気モードにならないとメギドラしか使わな
		IF RAND:3 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
		ELSEIF RAND:2 == 0 && 天孫降臨使用フラグ == 2
			CFLAG:ARG:입력행동 = [[스킬:메기도라]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:메기도라]]
		ENDIF
	ENDIF
ENDIF


;アクション実行不能
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1


@EVENT_BATTLE_TURNEND_都庁_アマテラス_単独
IF 現HP割合(GET_ENEMY("アマテラス")) < 50 && TFLAG:435 == 0
	PRINTFORML ┏> 아마테라스━━━━━━━━━━━━━━┓
	PRINTFORML ┃크윽……! 틀, 틀어박히고 싶어……! ┃
	PRINTFORML ┃……아, 아니요! 이제 화났어요!!　　┃
	PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━┛
	TFLAG:435 = 1
ENDIF


;=======================================================================
@SET_ACTION_都庁_スサノオ_協力, ARG
;=======================================================================
;基本的には変わらないが、アマテラスが先に撃破されると発狂する
; 本気モードフラグ
; 0＝HP50％以下
; 1＝HP50％以下になった場合
; 2＝HP50％以下になった次のターン（天孫降臨ターン）
; 3＝HP50％以下初回以後（本気モード）
#DIM 天孫降臨使用フラグ
#DIM ACTEND_D26_HPCHK_S

; 物魔どっちつかうかフラグ、物理の方が多い
#DIM 物理のターンかフラグ

;発狂フラグ・スサノオ
;アマテラスが落ちると発狂
;0：発狂してない
;1：発狂開始
;2：発狂
#DIM 発狂フラグS



;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
;発狂チェック
;発狂しておらず、行動回数がゼロで、
;前ターン終了時、アマテラスが死んでいる場合、ダンジョンフラグ:(FLAG:현던전):5が2000に加算される
;（または、リカームドラを使用しようとした場合）
IF 発狂フラグS == 0 && CFLAG:ARG:행동한횟수 == 0
	;アマテラスが死んでいる場合
	IF TFLAG:442 == 1
		発狂フラグS = 1
	ENDIF
ENDIF

;ターンの行動を判定
IF CFLAG:ARG:행동한횟수 == 0
	;●物魔判定
	;3分の1で魔法を使用する
	;1で魔法ターン
	IF RAND:3 == 0
		物理のターンかフラグ = 1
	ELSE
		物理のターンかフラグ = 0
	ENDIF
ENDIF


IF 発狂フラグS >= 1
	;発狂開始
	IF 発狂フラグS == 1
		PRINTFORML ┏> 스사노오━━━━━━━━━━━━━━━┓
		PRINTFORML ┃네, 네놈, 감히 누님을으으――윽!! ┃
		PRINTFORML ┃쉽게 죽을 거라 생각 마라앗!!!　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━┛
		;フラグを発狂中に変更
		発狂フラグS = 2
		;天孫降臨フラグが0以下（まだ天孫降臨を使用していない）なら即座に天孫降臨を使用
		SIF 天孫降臨使用フラグ <= 0
			天孫降臨使用フラグ = 1
		;行動回数が4回に増加
		CFLAG:ARG:행동횟수 = 4
	ENDIF

	;ワンモアが入ると殺しに来る
	IF CFLAG:ARG:１more플래그 > 0
		;魔法ターンだとナルカミ
		IF 物理のターンかフラグ == 0
			CFLAG:ARG:입력행동 = [[스킬:나루카미]]
		;物理ターンだと気合い
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:기합]]
		ENDIF

	;天孫降臨ターンの場合
	ELSEIF 天孫降臨使用フラグ == 1
		IF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = [[스킬:천손강림]]
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			CFLAG:ARG:입력행동 = [[스킬:검격가드브레이크]]
		ELSEIF CFLAG:ARG:행동한횟수 == 2
			CFLAG:ARG:입력행동 = [[스킬:기합]]
		ELSEIF CFLAG:ARG:행동한횟수 == 3
			CFLAG:ARG:입력행동 = [[스킬:허공참파]]
			;天孫降臨を使用したフラグを立てる
			天孫降臨使用フラグ = 2
			;行動回数を戻……さない！！！　発狂だから！！！
;			CFLAG:ARG:행동횟수 = 3
		ENDIF
	;魔法のターン
	ELSEIF 物理のターンかフラグ == 1
		;1.히트라이저
		;2.나루카미
		;3.ヘルエグ
		;……を使用する。発狂中のため全力
		IF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = [[스킬:히트라이저]]
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			CFLAG:ARG:입력행동 = [[스킬:나루카미]]
		ELSEIF CFLAG:ARG:행동한횟수 == 2
			CFLAG:ARG:입력행동 = [[스킬:마하・잔바리온]]
		;おまじない/4回目の行動
		ELSE
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:나루카미]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마하・잔바리온]]
			ENDIF
		ENDIF
	;物理のターン
	ELSE
		;初回行動は、「ガードブレイクOR雄たけび」、雄叫び率が高め
		IF CFLAG:ARG:행동한횟수 == 0
			IF RAND:4 == 0
				CFLAG:ARG:입력행동 = [[스킬:기합]]
			ELSEIF RAND:3 == 0
				CFLAG:ARG:입력행동 = [[스킬:검격가드브레이크]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:포효]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:포효]]
			ENDIF
		;2回目以後はランダムで剣攻撃
		;雑に虚空ザッパー率が上昇
		ELSE
			;万魔パンチ解禁
			IF RAND:5 == 0
				CFLAG:ARG:입력행동 = [[스킬:만마의일격]]
			ELSEIF RAND:4 == 0
				CFLAG:ARG:입력행동 = [[스킬:허공참파]]
			;（単独で）スクカジャ使わせないのはコレのため
			ELSEIF RAND:3 == 0
				CFLAG:ARG:입력행동 = [[스킬:천경지폭단]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:허공참파]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:길로틴블레이드]]
			ENDIF
		ENDIF
	ENDIF


;通常モード
ELSE
	;●本気判定
	;天孫降臨を使っておらず、HPが50％以下なら本気モード
	;固定行動を行う（ために、行動回数が増える）
	;３桁にしてから判定開始
	IF 天孫降臨使用フラグ == 0 && TFLAG:435 == 1
		PRINTFORML ┏> 스사노오━━━━━━━━━━━━━━━┓
		PRINTFORML ┃어라앗, 간다앗!!　　　　　　　　　　┃
		PRINTFORML ┃쉽게 죽지 말라고오오오!!!　　　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━┛
		天孫降臨使用フラグ = 1
		CFLAG:ARG:행동횟수 = 4
	ENDIF

	;ワンモアが入ると殺しに来る
	IF CFLAG:ARG:１more플래그 > 0
		;魔法ターンだとナルカミ
		IF 物理のターンかフラグ == 0
			CFLAG:ARG:입력행동 = [[스킬:나루카미]]
		;物理ターンだと気合い
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:기합]]
		ENDIF

	;天孫降臨ターンの場合
	ELSEIF 天孫降臨使用フラグ == 1
		IF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = [[스킬:천손강림]]
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			CFLAG:ARG:입력행동 = [[스킬:검격가드브레이크]]
		ELSEIF CFLAG:ARG:행동한횟수 == 2
			CFLAG:ARG:입력행동 = [[스킬:기합]]
		ELSEIF CFLAG:ARG:행동한횟수 == 3
			CFLAG:ARG:입력행동 = [[스킬:허공참파]]
			;天孫降臨を使用したフラグを立てる
			天孫降臨使用フラグ = 2
			;行動回数を戻す
			CFLAG:ARG:행동횟수 = 3
		ENDIF

	;魔法のターン
	ELSEIF 物理のターンかフラグ == 1
		;1.タルorラク
		;2.マハジオダイン
		;3.マハザンダイン
		;……を使用する
		IF CFLAG:ARG:행동한횟수 == 0
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:타루・카쟈]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:라쿠・카쟈]]
			ENDIF
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			;本気モードだとたまにナルカミを使用
			IF RAND:3 == 0 && 天孫降臨使用フラグ == 2
				CFLAG:ARG:입력행동 = [[스킬:나루카미]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마하・지오다인]]
			ENDIF
		ELSEIF CFLAG:ARG:행동한횟수 == 2
			;本気モードだとヘルエギゾーストを使用
			;まあDQNだしね
			IF RAND:3 == 0 && 天孫降臨使用フラグ == 2
				CFLAG:ARG:입력행동 = [[스킬:마하・잔바리온]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마하・잔다인]]
			ENDIF
		;おまじない
		ELSE
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:마하・지오다인]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마하・잔다인]]
			ENDIF
		ENDIF
	;物理のターン
	ELSE
		;初回行動は、「ガードブレイクOR雄たけび」、雄叫び率が高め
		;ただしHPが50％以下なら気合いが入る
		IF CFLAG:ARG:행동한횟수 == 0
			IF RAND:4 == 0 && 天孫降臨使用フラグ == 2
				CFLAG:ARG:입력행동 = [[스킬:기합]]
			ELSEIF RAND:3 == 0
				CFLAG:ARG:입력행동 = [[스킬:검격가드브레이크]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:포효]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:포효]]
			ENDIF
		;2回目以後はランダムで剣攻撃
		ELSE
			;本気モードだと虚空ザッパーを使用
			IF RAND:5 == 0 && 天孫降臨使用フラグ == 2
				CFLAG:ARG:입력행동 = [[스킬:허공참파]]
			ELSEIF RAND:4 == 0
				CFLAG:ARG:입력행동 = [[스킬:데스바운드]]
