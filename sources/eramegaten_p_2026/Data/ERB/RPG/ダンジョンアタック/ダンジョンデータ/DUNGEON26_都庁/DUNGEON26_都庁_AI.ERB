		CFLAG:ARG:행동횟수 = 4
	ENDIF


	;ワンモアが入ると殺しに来る
	IF CFLAG:ARG:１more플래그 > 0
		;デバフターンだと闇の審判or光の裁き
		IF デバフターンかフラグ == 0
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:어둠의심판]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:빛의심판]]
			ENDIF
