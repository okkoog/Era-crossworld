			ELSE
				CFLAG:ARG:입력행동 = [[스킬:길로틴블레이드]]
			ENDIF
		ENDIF
	ENDIF
ENDIF

;アクション実行不能
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
