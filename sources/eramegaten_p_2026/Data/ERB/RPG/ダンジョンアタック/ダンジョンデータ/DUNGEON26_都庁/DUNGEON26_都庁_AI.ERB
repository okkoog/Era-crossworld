	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1


;=======================================================================
@SET_ACTION_都庁_ツクヨミ_協力, ARG
;=======================================================================
;基本的には変わらないが、アマテラスが先に撃破されると発狂する
; 本気モードフラグ
; 0＝HP50％以下
; 1＝HP50％以下になった場合
; 2＝HP50％以下になった次のターン（天孫降臨ターン）
; 3＝HP50％以下初回以後（本気モード）
#DIM 天孫降臨使用フラグ
#DIM ACTEND_D26_HPCHK_T

; 物魔どっちつかうかフラグ、通常行動の方が多い
#DIM デバフターンかフラグ

;発狂フラグ・ツクヨミ
;アマテラスが落ちると発狂
;0：発狂してない
;1：発狂開始
;2：発狂
#DIM 発狂フラグT


;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

;発狂チェック
;発狂しておらず、行動回数がゼロで、
;前ターン終了時、アマテラスが死んでいる場合、ダンジョンフラグ:(FLAG:현던전):5が2000に加算される
;（または、リカームドラを使用しようとした場合）
IF 発狂フラグT == 0 && CFLAG:ARG:행동한횟수 == 0
	;アマテラスが死んでいる場合
	IF TFLAG:442 == 1
		発狂フラグT = 1
	ENDIF
ENDIF

;ターンの行動を判定
IF CFLAG:ARG:행동한횟수 == 0
