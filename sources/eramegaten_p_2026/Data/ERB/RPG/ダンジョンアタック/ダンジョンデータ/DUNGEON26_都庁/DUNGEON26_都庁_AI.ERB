;=======================================================================
@SET_ACTION_都庁_アマテラス_協力, ARG
;=======================================================================
;基本的には変わらないが、弟ふたりが落とされ、自身のHPが5割を切るとるとリカームドラで復活させる
;（天孫降臨は使用しない）
;撃破はツクヨミ→アマテラス→スサノオが想定
; 本気モードフラグ
; 0＝HP50％以下
; 1＝HP50％以下になった場合
; 2＝HP50％以下になった次のターン（天孫降臨ターン）
; 3＝HP50％以下初回以後（本気モード）
#DIM 天孫降臨使用フラグ
#DIM ACTEND_D26_HPCHK_A

; 太陽神真面目にやるかそうじゃないかフラグ、太陽神の方が多い
#DIM 太陽神フラグ
#DIM 発狂フラグA

;ランダムで常世の祈りを使用する(全回復)
;今回は弟ふたりがいるのでクッソウザい
#DIM 常世の祈りフラグ

;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1

;アマテラス発狂関連フラグを無視させて判定開始
IF CFLAG:ARG:행동한횟수 == 0
	;●発狂チェック
	;発狂しておらず、行動回数がゼロで、
	;スサノオとツクヨミのフラグがどちらも2である場合（＝死んでる場合）
	IF 発狂フラグA == 0 && TFLAG:438 == 1
		発狂フラグA = 1
	ENDIF

	;●太陽神判定
	;3分の1で万能・バフ系を使用する（ヒッキーモードになる）
	;1で太陽神ターン
	IF RAND:3 == 0
		太陽神フラグ = 0
	ELSE
		太陽神フラグ = 1
	ENDIF
ENDIF

;発狂状態
IF 発狂フラグA > 0
	;発狂開始
	;リカームドラを使う（もちろん即死・弟二人を蘇生する）
	IF 発狂フラグA == 1
		PRINTFORML ┏> 아마테라스━━━━━━━━━━━━━━┓
		PRINTFORML ┃안 돼…… 안 되는데……　　　　　　┃
		PRINTFORML ┃이런 건, 안 돼……!　　　　　　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━┛

		;行動回数が1回に低下
		CFLAG:ARG:행동횟수 = 1
		CFLAG:ARG:입력행동 = [[스킬:리캄드라]]
		CFLAG:ARG:타겟 = 22
		発狂フラグA = 2
	ELSE
		;MP枯渇させてたパターン、イケたっけコレまあいいや勃起するので
		PRINTFORML ┏> 아마테라스━━━━━━━━━━━━━━┓
		PRINTFORML ┃되살아나서…… 되돌아와줘……　　┃
		PRINTFORML ┃이제 안 꾸짖을 테니까…… 둘 다……!┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━┛
		CFLAG:ARG:입력행동 = [[스킬:리캄드라]]
		CFLAG:ARG:타겟 = 22
	ENDIF
;通常
ELSE
	;●本気判定
	;天孫降臨を使っておらず、HPが50％以下なら本気モード
	;固定行動を行う（ために、行動回数が増える）
	ACTEND_D26_HPCHK_A = ダンジョンフラグ:(FLAG:현던전):5
	;アマテラスは4桁目なのでそのまま判定開始
	IF 天孫降臨使用フラグ == 0 && TFLAG:437 == 1 && CFLAG:ARG:행동한횟수 == 0
		PRINTFORML ┏> 아마테라스━━━━━━━━━━━━━━┓
		PRINTFORML ┃태양이여, 내 몸에 깃들어라!　　　　┃
		PRINTFORML ┃내 몸의 불꽃에 불타 사라져라!!　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━┛
		天孫降臨使用フラグ = 1
		CFLAG:ARG:행동횟수 = 4
	ENDIF


	;ワンモアが入ると殺しに来る
	IF CFLAG:ARG:１more플래그 > 0
		;太陽神ターンだとトリスアギオンorコズミックフレア
		IF 太陽神フラグ == 0
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:트리스아기온]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:코즈믹플레어]]
			ENDIF
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
		ENDIF

	;天孫降臨ターンの場合
	ELSEIF 天孫降臨使用フラグ == 1
		IF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:입력행동 = [[스킬:천손강림]]
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			CFLAG:ARG:입력행동 = [[스킬:화염가드브레이크]]
		ELSEIF CFLAG:ARG:행동한횟수 == 2
			CFLAG:ARG:입력행동 = [[스킬:컨센트레이트]]
		ELSEIF CFLAG:ARG:행동한횟수 == 3
			CFLAG:ARG:입력행동 = [[스킬:프로미넌스]]
			;天孫降臨を使用したフラグを立てる
			天孫降臨使用フラグ = 2
			;行動回数を戻す
			CFLAG:ARG:행동횟수 = 3
		ENDIF

	;太陽神ターン
	ELSEIF 太陽神フラグ == 1
		;1.회복
		;2.화염
		;3.핵열
		;……を使用する
		IF CFLAG:ARG:행동한횟수 == 0
			;５ターン合間を開けつつたま～に使用（だんだん使用率が上がっていく）
			IF 常世の祈りフラグ > 5 && 常世の祈りフラグ > RAND:100
				CFLAG:ARG:입력행동 = [[스킬:영세의기도]]
				常世の祈りフラグ = 0
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:데・카쟈]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:데・쿤다]]
			ENDIF
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			;本気モードだとたまにトリスアギオンを使用
			;気合いは乗らないので貫通しない
			IF RAND:3 == 0 && 天孫降臨使用フラグ == 2
				CFLAG:ARG:입력행동 = [[스킬:트리스아기온]]
			ELSEIF RAND:2 == 0 && 天孫降臨使用フラグ == 2
				CFLAG:ARG:입력행동 = [[스킬:프로미넌스]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마하・라기다인]]
			ENDIF
		ELSEIF CFLAG:ARG:행동한횟수 == 2
			IF RAND:4 == 0 && 天孫降臨使用フラグ == 2
				CFLAG:ARG:입력행동 = [[스킬:코즈믹플레어]]
			ELSEIF RAND:3 == 0 && 天孫降臨使用フラグ == 2
				CFLAG:ARG:입력행동 = [[스킬:아토믹플레어]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:마하기가리온]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:프레이다인]]
			ENDIF
		;おまじない
		ELSE
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:마하・라기다인]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:프레이다인]]
			ENDIF
		ENDIF
	;ヒッキーのターン
	ELSE
		;行動は自己バフ・防御・万能攻撃
		;初手は自己バフ、踊りはどうだろうかって感じだけど
		IF CFLAG:ARG:행동한횟수 == 0
			IF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:파워브레스]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:천상의춤]]
			ENDIF
		;防御とかのターン、ちょっと躁鬱激しくない？
		ELSEIF CFLAG:ARG:행동한횟수 == 1
			;ヒッキーモードなのでたるむ
			IF RAND:3 == 0
				CFLAG:ARG:입력행동 = [[스킬:타룬・다]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:테트라칸]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:마카라칸]]
			ENDIF
		ELSE
			;本気モードにならないとメギドラしか使わない
			IF 天孫降臨使用フラグ == 2
				CFLAG:ARG:입력행동 = [[스킬:메기도라온]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:메기도라]]
			ENDIF
		ENDIF
	ENDIF

ENDIF

;アクション実行不能
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1

