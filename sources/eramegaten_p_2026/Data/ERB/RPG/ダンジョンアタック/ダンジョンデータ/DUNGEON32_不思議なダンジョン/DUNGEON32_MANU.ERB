;---------------------------------------------------------------------------------------------------------------------------------
;ダンジョン32　이상한던전
;---------------------------------------------------------------------------------------------------------------------------------
;ダンジョン概要
;	トルネコや試練の不思議なダンジョンみたいに、入るたびに変化するタイプのダンジョンを作成します。
;	同じ階でも階段を上り下りする度に再生成されて別のマップになる予定です。
;	(Elonaの「子犬の洞窟」とかがイメージしやすい...かな？)

;更新日時　　　更新者				更新内容
;2021/09/01　　ロッド@カヤノソト	作成に着手
;---------------------------------------------------------------------------------------------------------------------------------

;=======================================================================
;メニュー関連
;	※めっちゃくちゃメニュー関連が長くて本処理が読めないため、当ファイルを作成してこちらに置きます。
;=======================================================================
;メインメニューを作成する関数
@DUNGEON_32_MAINMANU
;-------------
;変数定義
;-------------
#DIM QUEST_DESIDED_FLG		;依頼選択済みフラグ(0:未決定 / 1:決定済み)　※依頼決定の箇所は二重ループの中であるため、ループを出るために用意したフラグです。

;-------------
;変数の初期化
;-------------
FLAG:현M = 0				;현계층
FLAG:현X = 1				;現在地のX座標
FLAG:현Y = 18				;現在地のY座標
QUEST_DESIDED_FLG = 0		;依頼選択済みフラグ(0:未決定 / 1:決定済み)
ダンジョンフラグ:32:1 = 0	;挑戦中のダンジョンの大分類(0:ダンジョン設定なし / 1:占い師マリーの依頼によるランダム異界 / 그외:未作成)

;-------------
;ここから本処理
;-------------
DRAWLINE
PRINTFORML 얼핏 평화로워 보이는 이 세계의 이면에서는
PRINTFORML 매일같이 이계의 발생과 서머너에 의한 악마 퇴치의 쫓고 쫓기는 술래잡기가 계속되고 있다。
PRINTFORML
PRINTFORML 힘을 갈망하여　동료를 찾을 기회를 찾아서　혹은 어쩌면 로망을 쫓아서
PRINTFORML 당신은 이계 순회를 하기로 했다。
PRINTFORML
WHILE 1
	;-------------
	;メインメニュー
	;-------------
	CALL DUNGEON_32_CLEAR_FLAG		;各種フラグを初期化する
	QUEST_DESIDED_FLG = 0			;依頼選択済みフラグを(0:未決定)にする
	PRINTFORML [  1] 점술사 마리의 의뢰를 받는다 (이계 공략)
	IF ダンジョンフラグ:32:10 >= 1
		;魔界探索・カギを使用した探索が解放済みである場合
		PRINTFORML [  2] 휠체어를 탄 남자의 의뢰를 받는다 (마계 탐색)

	ELSE
		;その他の場合
		PRINTFORML [  2]？？？？(未開放)
	ENDIF
	PRINTFORML [  3] 비경에 도전한다 (대규모 던전)　※제작 중입니다。미안해요！
	PRINTFORML [ 98]最高記録
	PRINTFORML [ 99]説明
	PRINTFORML [100] 그만둔다
	$DUNGEON_32_MENU_TOP_INPUT_LOOP
	INPUT
	IF RESULT == 1
		;-------------------------------------
		;占い師マリーの依頼を受ける(異界攻略)
		;-------------------------------------
		;メニュー(占い師マリーの依頼)を表示する
		CALL DUNGEON_32_MANU_MARRY
		QUEST_DESIDED_FLG = RESULT

		;依頼決定済みの場合、ループを終了する(メニュー画面が終了してダンジョンがスタートする)
		IF QUEST_DESIDED_FLG == 1
			BREAK
		ENDIF

	ELSEIF RESULT == 2
		;-----------------------------------
		;車いすの男の依頼を受ける(魔界探索)
		;-----------------------------------
		IF ダンジョンフラグ:32:10 >= 1
			;魔界探索が解放済みである場合、メニュー(車いすの男の依頼)を表示する
			CALL DUNGEON_32_MANU_STEAVEN
			QUEST_DESIDED_FLG = RESULT

		ELSE
			;その他の場合(未開放なので入力に戻る)
			GOTO DUNGEON_32_MENU_TOP_INPUT_LOOP

		ENDIF

		;依頼決定済みの場合、ループを終了する(ゲーム側ではメニュー画面が終了してダンジョンがスタートする)
		IF QUEST_DESIDED_FLG == 1
			BREAK
		ENDIF

	ELSEIF RESULT == 3
		;---------------
		;秘境に挑戦する
		;---------------
		DRAWLINE
		PRINTFORML
		PRINTFORMW 제작 중입니다。미안해요！
		DRAWLINE

	ELSEIF RESULT == 98
		;---------------
		;最高記録
		;---------------
		DRAWLINE
		PRINTFORML
		PRINTFORML 현재 최고 기록은 다음과 같습니다
		PRINTFORML --------------------------
		PRINTFORML 당신의 기록 (이번 주회/전체 주회)
		PRINTFORML --------------------------
		PRINTFORML 마계 탐색：({ダンジョンフラグ:32:21}계층 / {DUNGEON_32_DEPTH_REDORD:0}계층)　※총 333계층
		PRINTFORML
		PRINTFORML
		PRINTFORML
		PRINTFORML
		PRINTFORML
		DRAWLINE
		PRINTFORMW

	ELSEIF RESULT == 99
		;-------------
		;説明
		;-------------
		;各メニューの説明を表示する
		CALL DUNGEON_32_EXPLAIN

	ELSEIF RESULT == 100
		;-------------
		;やめる
		;-------------
		DRAWLINE
		PRINTFORML
		PRINTFORMW 당신은 이계 순회를 중지하고 자택으로 귀환했다。

		;戦闘設定用の各種フラグをデフォルトに戻す
		FLAG:회화불능플래그 = 0					;悪魔と会話可能
		FLAG:악마해석률상승불가플래그 = 0		;悪魔解析率を上げられる
		FLAG:RESULT스킵 = 0					;戦闘後のリザルト画面あり。経験値・MAGなどを得られる
		FLAG:도주불가플래그 = 0					;戦闘から逃走可能

		;ダンジョンを脱出する
		FLAG:탈출 = 1
		BREAK

	ELSE
		;入力ミスのためやり直し
		GOTO DUNGEON_32_MENU_TOP_INPUT_LOOP
	ENDIF
WEND

RETURN 1


;メニュー・占い師マリーの依頼
@DUNGEON_32_MANU_MARRY
;-------------
;変数定義
;-------------
#DIM SELECT_QUEST_NO		;選択した依頼の番号(依頼1～3のどれを選択したか)
#DIM QUEST_DESIDED_FLG		;依頼選択済みフラグ(0:未決定 / 1:決定済み)　※依頼決定の箇所は二重ループの中であるため、ループを出るために用意したフラグです。

;-------------
;変数の初期化
;-------------
SELECT_QUEST_NO = 0			;選択した依頼(ダンジョンの危険度, 異界の発生場所)
QUEST_DESIDED_FLG = 0		;依頼選択済みフラグ(0:未決定 / 1:決定済み)

;-------------
;本処理
;-------------

;--------------------------------------------------------------------------
;最初のあいさつ。(初回、2回目など状況に応じてちょっぴりセリフを変更する)
;--------------------------------------------------------------------------
DRAWLINE
SELECTCASE ダンジョンフラグ:32:0
	CASE 0
		;初回の場合
		PRINTFORML 어~머나、어서 와요。
		PRINTFORML 여기서는 이계 사건의 해결 의뢰를 중개하고 있단다。
		PRINTFORML 
		PRINTFORML 사실은 당신 같은 다크 서머너와는 손을 잡지 않지만
		PRINTFORML 친하게 지내던 쿠즈노하가 최근 오질 않아서 말이지……
		PRINTFORML 
		PRINTFORML 그 녀석이니까 조만간 불쑥 돌아오겠거니 싶기는 하지만。
		PRINTFORML 미안하지만、그때까지 악마 퇴치에 참가해 주렴。
		PRINTFORML 사례비는 두둑하게 챙겨줄 테니까。
		PRINTFORMW

	CASE 1
		;2回目の場合
		PRINTFORML
		PRINTFORML 곧바로지만、일감이 들어와 있어。
		PRINTFORML 물론、해줄 거지？
		PRINTFORMW

	CASE 2
		;3回目の場合
		PRINTFORML
		PRINTFORML 마침 딱 좋은 때에 왔네。
		PRINTFORML 새로운 일감이 들어와 있어。
		PRINTFORMW

	CASEELSE
		;4回目以降の場合
		PRINTFORML
		PRINTFORML %CALLNAME:MASTER%씨이、있어？
		PRINTFORML 또、새로운 일감이 들어왔단다。
		PRINTFORMW
ENDSELECT

;---------------------------------------
;占い師マリーの依頼を自動生成する処理
;---------------------------------------
CALL DUNGEON_32_MAKE_QUEST

;----------------
;依頼の表示
;----------------
PRINTFORML 다음 의뢰 중에서 골라주렴。
PRINTFORML

WHILE 1
	PRINTFORML [  1]:%DUNGEON_32_DEVIL_LEVEL_NAME:(DUNGEON_32_QUEST_LIST:0:0)%%DUNGEON_32_PLACE_NAME:(DUNGEON_32_QUEST_LIST:0:1)%의 이계
	PRINTFORML [  2]:%DUNGEON_32_DEVIL_LEVEL_NAME:(DUNGEON_32_QUEST_LIST:1:0)%%DUNGEON_32_PLACE_NAME:(DUNGEON_32_QUEST_LIST:1:1)%의 이계
	PRINTFORML [  3]:%DUNGEON_32_DEVIL_LEVEL_NAME:(DUNGEON_32_QUEST_LIST:2:0)%%DUNGEON_32_PLACE_NAME:(DUNGEON_32_QUEST_LIST:2:1)%의 이계
	PRINTFORML [ 99]:좀 더 다른 이계를 소개해 줘
	PRINTFORML [100] 그만둔다
	$DUNGEON_32_QUEST_INPUT_LOOP
	INPUT
	IF 1 <= RESULT && RESULT <= 3
		;選択された依頼の番号を記録する
		SELECT_QUEST_NO = RESULT - 1
		
		;-----------------
		;依頼内容を説明する
		;-----------------
		DRAWLINE
		PRINTFORML
		SELECTCASE DUNGEON_32_QUEST_LIST:SELECT_QUEST_NO:1
			CASE 1
				;ビルの場合
				PRINTFORML 폐허가 된 고층 빌딩을 리모델링하려 했더니 이상한 놈들한테 방해를 받았다나 봐。
				PRINTFORML 다행히 부상자는 안 나왔지만、빌딩 상층부를 점거당해서 곤란해하는 모양이야。
				PRINTFORML 높은 곳이란 오컬트 괴담이 따라붙기 마련이니까。폐빌딩은 도심 속의 영봉이라도 되는 걸까。
				PRINTFORML
				PRINTFORML 요정이라든가、날개가 달린 듯한 악마가 나왔다는 모양이야。

			CASE 2
				;病院の場合
				PRINTFORML 병원 영안실에서 시체가 벌떡 일어나는 사건이 발생했다고 해。
				PRINTFORML 의사나 간호사들이 도망쳐서 업무가 마비된 것 같고
				PRINTFORML 그런 의미에서도 해결을 서둘러야겠어。
				PRINTFORML
				PRINTFORML 악령이나 망령 무리、소위 인간이 도를 벗어나 버린 부류의 악마가 나온다나 봐。
				PRINTFORML 어쩌면 사자를 하늘로 인도하거나、출산에 관계된 악마가 나올지도 모르겠네。

			CASE 3
				;アパートの場合
				PRINTFORML 몇 번이나 리모델링하고、집세를 내렸는데도 세입자들이 도망쳐 나가는 아파트가 있단다。
				PRINTFORML 밤중에 발소리가 들리거나、무언가 꿈틀거리는 그림자를 본다는 모양이야。행방불명된 사람도 있다던가。
				PRINTFORML 완전히 흉가 흉물이 되어버려서 곤란해하고 있다는구나。
				PRINTFORML
				PRINTFORML 장난치기 좋아하는 요정이나 요마가 눌러앉아 버린 걸까。
				PRINTFORML 어쩌면 사람을 납치하는 오니 같은 놈도 있을지 몰라。

			CASE 4
				;学校の場合
				PRINTFORML 너희 학교에는 괴담이나 7대 불가사의 같은 게 있었니？
				PRINTFORML 입지에 따라 다르기도 하지만、아이들의 소문이 모여드는 장소란 제법 무섭단다。
				PRINTFORML 예를 들면 이 마을 초등학교도 영지에 위치해 있어서 말이지。
				PRINTFORML 정기적으로 서머너를 파견해서　발생하려는 악마들을 쫓아내고 있단다。
				PRINTFORML
				PRINTFORML 지금까지의 사례로는 토끼장이나 닭장의 동물들이 변이되어 있었다는 모양이야。
				PRINTFORML 그 밖에는 중정 연못에 요정이 있었다거나、꼬마 도깨비가 나왔다는 사례가 있었던가？

			CASE 5
				;森の場合
				PRINTFORML 이 마을 중심부에 고분과、그것을 둘러싼 해자가 있는데 말이지
				PRINTFORML 그 일대 전체가 숲으로 되어 있단다。작지만 오랫동안 사람의 손이 닿지 않은 숲이지。
				PRINTFORML 쿠즈노하가 실종되었을 무렵부터 이 숲에 강력한 악마가 출몰하게 되었다는 모양이야。
				PRINTFORML 시청 등과도 가까워서 꽤나 문제가 되고 있단다。
				PRINTFORML
				PRINTFORML 지금까지는 기껏해야 요정이나 요마가 얼굴을 내미는 정도였지만
				PRINTFORML 지금은 어처구니없을 정도로 무시무시한 악마가 나온다나 봐。

			CASE 6
				;山の場合
				PRINTFORML 이 마을은 분지라서 마을 밖은 산이나 숲으로 둘러싸여 있단다。
				PRINTFORML 이런 지형은 범죄자들이 숨어들기 쉬운 곳이 있어 치안이 나쁜 게 골칫거리란 말이지。
				PRINTFORML 최근、명백히 상태가 이상한 짐승이 산에서 내려와 난동을 부렸다나 봐。미안하지만 조사하러 가주렴。
				PRINTFORML
				PRINTFORML 산에서 내려온 것은 조수 무리라는 모양이야。
				PRINTFORML 그리고 뭔가 엄청나게 커다란 뱀을 보았다던가 뭐라던가。

			CASE 7
				;神社の場合
				PRINTFORML 조금 멀리 떨어진 신사에서 영적 장애가 발생했다고 해。
				PRINTFORML 상당히 강력한 악마가 출몰하는 모양이라、신사 사람들로부터 구원 요청 의뢰가 들어왔단다。
				PRINTFORML
				PRINTFORML 무섭게도 신이라 불리는 존재들만 나타나고 있다는 모양이야。
				PRINTFORML 어느 쪽이냐 하면 여신 쪽이 많다는 것 같네。

			CASE 8
				;警察署の場合
				PRINTFORML 믿기 힘들지만 경찰서에서 악마 관계자에 의한 습격 사건이 발생했다나 봐。
				PRINTFORML 경찰에서 의뢰가 온 건 아니지만、습격범 중에 현상수배범이 있다는 모양이야。
				PRINTFORML 사냥하는 김이라도 좋으니 구하러 가주렴。
				PRINTFORML 모모치도 무사하려나 모르겠네。
				PRINTFORML
				PRINTFORML 연락에 따르면 좀비니 천사니 하는 것들이 몰려들어 난리법석이라더구나。
				PRINTFORML 그 밖에는 경찰견이 변이한 녀석도 날뛰고 있다나 봐。

			CASE 9
				;古墳の場合
				PRINTFORML 고분 발굴 작업 중에 괴물의 습격을 받았다는 연락이 들어왔어。
				PRINTFORML 묘지에 유령이 나오는 거야 종종 있는 일이지만、이번엔 그런 레벨이 아닌 것 같네。
				PRINTFORML 그러고 보니 고대 일본에는 마법 문명이 번영했었고
				PRINTFORML 왕족은 강력한 이능자였다는 등의 황당무계한 가설이 제기되기도 했었지。
				PRINTFORML ……설마 그렇겠어。
				PRINTFORML
				PRINTFORML 강대한 오니나 대악마 따위가 출몰하고 있다는 모양이야。
				PRINTFORML 덤으로 용이 나타났다던가 뭐라던가。

			CASE 10
				;墓地の場合
				PRINTFORML 공동묘지에서 좀비 소동이 일어났다나 봐。
				PRINTFORML 보통은 올바르게 애도해 준 망자라면 이승으로 헤매 나오지 않는 법일 텐데 말이지。
				PRINTFORML 어지간히도 이승에 미련이 남았던 걸까。
				PRINTFORML 다크 서머너 무리들의 소행이 아니면 좋으련만。
				PRINTFORML
				PRINTFORML 사후의 인간이 악마로 변한 부류 외에도
				PRINTFORML 오니라든가 정령 같은 것들도 튀어나온다나 봐。

			CASE 11
				;海岸の場合
				PRINTFORML 밤바닷가에 도깨비불이 떠다니는 것이 목격되었다나 봐。
				PRINTFORML 이계화된 모양이라 의뢰가 들어왔단다。
				PRINTFORML 인적이 드문 해안이란 비교적 빈번하게 악마 사건이 발생하는 스폿이란다。
				PRINTFORML 바다는 옛날부터 영혼이니 신이니 하는 것들과 결부되어 왔기 때문일까。
				PRINTFORML
				PRINTFORML 과거의 사례로는 요마 무리에 더해 바닷새가 변이한 것이 목격되었다나 봐。
				PRINTFORML 가끔 여신을 보았다는 증언이 있는데 진짜일까나？

			CASE 12
				;地下水道の場合
				PRINTFORML 지하수도로 악마 구제 의뢰가 들어왔단다。
				PRINTFORML 어째서인지 이 마을 지하수도에는 악마들이 자주 웅크려 모여있는 모양이야。
				PRINTFORML 어쩌면、이 마을 지하에 이상한 곳으로 연결되는 게이트라도 있다거나
				PRINTFORML ……농담이란다。
				PRINTFORML
				PRINTFORML 지하수도에서는 다종다양한 악마들이 출몰하는 모양이야。
				PRINTFORML 상세는 불명이지만、마을 각지에서 보이는 악마들은 지하수도에서도 다 보인다는 모양이야。

			CASEELSE
				;その他の場合(入力ミスなのでやり直し)
				GOTO DUNGEON_32_QUEST_INPUT_LOOP

		ENDSELECT

		PRINTFORMW
		PRINTFORML 정말로 이 의뢰를 수락하겠니？
		PRINTFORML [  0]: 의뢰를 받는다
		PRINTFORML [100] 그만둔다
		$DUNGEON_32_QUEST_YES_NO_INPUT_LOOP
		INPUT
		IF RESULT == 0
			;--------------
			;依頼を受ける
			;--------------
			ダンジョンフラグ:32:1 = 1																					;挑戦中のダンジョンの大分類を指定(1:占い師マリーの依頼によるランダム異界)
			ダンジョンフラグ:32:2 = DUNGEON_32_IKAI_DEVIL_LEVEL_MIN:(DUNGEON_32_QUEST_LIST:SELECT_QUEST_NO:0)			;出現する悪魔の最低レベルを指定
			ダンジョンフラグ:32:3 = DUNGEON_32_IKAI_DEVIL_LEVEL_MAX:(DUNGEON_32_QUEST_LIST:SELECT_QUEST_NO:0)			;出現する悪魔の最高レベルを指定
			ダンジョンフラグ:32:4 = DUNGEON_32_QUEST_LIST:SELECT_QUEST_NO:1												;ダンジョンの種類を指定
			ダンジョンフラグ:32:7 = DUNGEON_32_QUEST_LIST:SELECT_QUEST_NO:0												;ダンジョンの危険度を指定
			QUEST_DESIDED_FLG = 1																						;依頼選択済みフラグ(0:未決定 / 1:決定済み)　※「1:決定済み」の場合はメニューを終了してダンジョン探索を開始する。
			ダンジョンフラグ:32:5 = DUNGEON_32_QUEST_LIST:SELECT_QUEST_NO:2												;ダンジョンの深さを設定する。
			ダンジョンフラグ:32:5 = 2																					;ダンジョンの深さを設定する。
			ダンジョンフラグ:32:6 = DUNGEON_32_DUNGEON_DIRECTION:(DUNGEON_32_QUEST_LIST:SELECT_QUEST_NO:1)				;ダンジョンの方向を設定する(0:上に登る / 1:下に降りる)
			ダンジョンフラグ:32:8 = DUNGEON_32_IKAI_DEVIL_LEVEL_PLUS:(DUNGEON_32_QUEST_LIST:SELECT_QUEST_NO:0)			;出現する悪魔のレベルのプラス補正(5の場合、出現する悪魔のレベルを本来のレベル+5にする)
			ダンジョンフラグ:32:9 = 1																					;ボス出現フラグ(1:出現する)
			ダンジョンフラグ:32:12 = 0																					;カギの使用による異界・魔界への再挑戦であるか(0:カギ不使用)
			IF ダンジョンフラグ:32:0 == 0
				ダンジョンフラグ:32:0 = 1																				;占い師マリーの依頼の進行度。「0:未挑戦」の場合は初回の依頼実行時に1にする。その後は依頼をクリアする度に+1　※会話が少し変化する程度であまり意味はないです。
			ENDIF
			DRAWLINE
			BREAK

		ELSEIF RESULT == 100
			;--------------
			;やめる
			;--------------
			DRAWLINE

		ELSE
			;------------------------
			;入力ミスのためやり直し
			;------------------------
			GOTO DUNGEON_32_QUEST_YES_NO_INPUT_LOOP

		ENDIF

	ELSEIF RESULT == 99
		;-----------------------------
		;もっと他의 이계を紹介してくれ
		;-----------------------------
		IF ダンジョンフラグ:32:11 == 0
			;最初の1回目の発言の場合
			DRAWLINE
			PRINTFORML
			PRINTFORML 터무니없는 소릴 하네 당신！？
			PRINTFORML
			PRINTFORML ……하아、어쩔 수 없네。
			PRINTFORML 어디까지나 자기 이익을 위해 일하는 다크 서머너니까 말이지。
			PRINTFORML 세상과 사람들을 위해서、란 식으로는 안 되겠지。
			PRINTFORML
			PRINTFORML 자、이 중에서 골라주렴。
			PRINTFORMW
			DRAWLINE
			ダンジョンフラグ:32:11 = 1	;「もっと他의 이계を紹介してくれ」を発言済みにする。
		
		ELSE
			;2回目以降の発言の場合
			DRAWLINE
			PRINTFORML
			PRINTFORML 어쩔 수 없네。다른 마을의 사건을 몇 개 소개해 줄게。
			PRINTFORMW
			DRAWLINE
		ENDIF

		;占い師マリーの依頼を再生成する
		CALL DUNGEON_32_MAKE_QUEST

	ELSEIF RESULT == 100
		;---------
		;やめる
		;---------
			DRAWLINE
			PRINTFORML
			PRINTFORML 평화로운 일상의 이면에서、악마 관련 사건은 빈번하게 발생하고 있단다。
			PRINTFORML 앞으로도 잘 부탁해。
			PRINTFORMW
			DRAWLINE
			;ダンジョン挑戦をなしに設定する
			ダンジョンフラグ:32:1 = 0						;挑戦中のダンジョンの大分類を指定(0:ダンジョン設定なし)
			;メインメニューに戻る
			BREAK

	ELSE
		;------------------------
		;入力ミスのためやり直し
		;------------------------
		GOTO DUNGEON_32_QUEST_INPUT_LOOP

	ENDIF
WEND

;返り値
RETURN QUEST_DESIDED_FLG

;メニュー・車いすの男の依頼
@DUNGEON_32_MANU_STEAVEN
;-------------
;変数定義
;-------------
#DIM QUEST_DESIDED_FLG		;依頼選択済みフラグ(0:未決定 / 1:決定済み)　※依頼決定の箇所は二重ループの中であるため、ループを出るために用意したフラグです。
#DIM LOOP_CNT_i				;ループ用カウント変数　※処理が長くて複雑なので、グローバル変数LOCALは使いたくない
#DIM KEY_NO					;何番目のカギを使用するか(0～4)
#DIM CHANGE_KEY_NO, 2		;入れ替える2つのカギの番号格納する配列
#DIM CHANGE_KEY, 2			;一時的にカギのデータを格納する配列　カギの順番を入れ替えるために使用する(0：ダンジョンの危険度 / 1：ダンジョンの種類)

;-------------
;変数の初期化
;-------------
QUEST_DESIDED_FLG = 0		;依頼選択済みフラグ(0:未決定 / 1:決定済み)
LOOP_CNT_i = 0				;ループ用カウント変数　※処理が長くて複雑なので、グローバル変数LOCALは使いたくない
KEY_NO = 0					;何番目のカギを使用するか(0～4)
VARSET CHANGE_KEY_NO		;入れ替える2つのカギの番号格納する配列
VARSET CHANGE_KEY			;一時的にカギのデータを格納する配列　カギの順番を入れ替えるために使用する(0：ダンジョンの危険度 / 1：ダンジョンの種類)

;-------------
;本処理
;-------------
;冒頭の会話
SELECTCASE ダンジョンフラグ:32:10
	CASE 1
		;1回目の訪問の場合
		DRAWLINE
		PRINTFORMW 자네가 『마계의 열쇠』를 손에 넣은 데빌 서머너로군？
		PRINTFORML 
		PRINTFORML 나는 과거에 순간이동 장치 터미널 시스템을 개발하던 자일세。
		PRINTFORML 헌데 실험 도중 우연히 악마를 불러내고 말았지。
		PRINTFORML 터미널과 마계의 접속은 차단했으나 악마의 이승 유입이 멈추지 않고 있네。
		PRINTFORML 게이트 파워를 낮추고、악마를 마계에 묶어두기 위해선 마계 쪽을 조사할 필요가 있네。
		PRINTFORMW 하지만 정확한 좌표 설정 없이 터미널에서 마계로 이동했다간 비참한 꼴을 면치 못하겠지。
		PRINTFORML 
		PRINTFORML 조사해 본 바　악마는 현실 세계의 영적 스폿
		PRINTFORML 흔히 말하는 이계를 통해 마계와 지상을 오가는 듯하네。
		PRINTFORML 자네가 이계의 주인에게서 얻은 것은 마계와 이계를 오가기 위한 좌표 데이터일세。
		PRINTFORML 이것을 이용하면 터미널로 이계 및 마계로 직접 쳐들어가는 것이 가능해질 터네。
		PRINTFORMW 예를 들면 숲의 이계에서 손에 넣은 열쇠를 쓰면 숲의 이계 또는 숲의 마계로 갈 수 있겠지。
		PRINTFORML 
		PRINTFORML 부디 마계 조사에 협력해 주었으면 하네。
		PRINTFORML 극도로 위험한 의뢰이지만、대신 마계 탐색에서 얻은 것은 모두 자네의 것일세。
		PRINTFORMW
		ダンジョンフラグ:32:10 += 1		;訪問回数を+1する

	CASE 2
		;2回目の訪問の場合
		DRAWLINE
		PRINTFORML 마계의 구조는 불규칙하게 변화하고 있는 듯하네。
		PRINTFORML 혹은 어쩌면 자네의 위치 쪽이 변화하고 있는 것일까。
		PRINTFORML 
		PRINTFORML 어찌 되었든 지도를 만드는 것은 무리로군。그때그때 지형을 파악하는 수밖에 없을 걸세。
		PRINTFORMW

	CASE 3
		;3回目の訪問の場合
		DRAWLINE
		PRINTFORML 마계에서는 10개 층마다 출현하는 종족이 전환되는 듯하네。
		PRINTFORML 천사의 영역이라면 천사、마수의 영역이라면 마수가 출현하고 있지。
		PRINTFORML 같은 계층이라도 들어갈 때마다 어느 종족의 영역인지 변화하니 주의해 주게나。
		PRINTFORMW

	CASE 4
		;4回目の訪問の場合
		DRAWLINE
		PRINTFORML 50개 층마다 출현하는 악마의 레벨이 +50 되는 모양일세。
		PRINTFORML 깊이 내려갈수록 지상에서는 있을 수 없을 만큼 강력한 악마가 나타날 걸세。
		PRINTFORML 주의하여 탐색하게나。
		PRINTFORMW

	CASE 5
		;5回目の訪問の場合
		DRAWLINE
		PRINTFORML 과거 터미널이 마계로 연결되었다는 것을 알게 된
		PRINTFORML 고토라는 남자는 악마를 불러내어 조종하려 했네。
		PRINTFORML 나는 악마 및 악마를 조종하는 자들에 대한 억지력으로서
		PRINTFORML 악마소환 프로그램을 제작하여 수많은 사람들에게 전송했지。
		PRINTFORML 
		PRINTFORML 하지만 대다수의 사람들은 제대로 다루지 못한 모양일세。
		PRINTFORMW

	CASE 6
		;6回目の訪問の場合
		DRAWLINE
		PRINTFORML 내가 터미널이나 악마소환 프로그램을 만들기 전부터
		PRINTFORML 악마를 불러내고、부리는 술법을 지닌 자들이 있었다는 것을 확인했네。
		PRINTFORML 비슷한 프로그램을 만든 학생도 있었고
		PRINTFORML 마개라는 관에 악마를 봉인하여 사역하는 주술도 있었던 모양일세。
		PRINTFORML 어쩌면 늦든 이르든　전설의 악마들은 어둠에서 눈을 떴을지도 모를 일이지。
		PRINTFORMW

	CASE 100
		;全333階層を突破済みの場合
		DRAWLINE
		PRINTFORML 여어　잘 왔네。
		PRINTFORML 마계와 지상을 떼어놓기 위한 연구는　아직도 시간이 걸릴 듯하이。
		PRINTFORML 곤란한 길이지만、반드시 완수해 보이고 말고。
		PRINTFORML 
		PRINTFORML 과거　악마를 이 지상으로 불러들여 버린 자로서
		PRINTFORML 책임을 져야만 하네。
		PRINTFORML 
		PRINTFORMW

	CASEELSE
		;その他の場合(クリアしていない、かつ7回目以降の訪問の場合)
		DRAWLINE
		PRINTFORML 또 보았군 %CALLNAME:MASTER% 군。
		PRINTFORML 
		PRINTFORML 그나저나 자네는 참으로 대단하군。
		PRINTFORML 아직 악마에게 의식을 빼앗기지 않은 건가。
		PRINTFORML 으~음　내가 눈여겨본 보람이 있어。
		PRINTFORML 
		PRINTFORML 그럼、마계 조사를 가주겠나？
		PRINTFORMW

ENDSELECT

;どのカギを使用するか選択する
DRAWLINE
PRINTFORML 
PRINTFORML 그럼、마계 조사를 가주겠나？
WHILE 1

	;どのカギを使用するか選択する
	PRINTFORML 어느 열쇠를 사용할 텐가？
	PRINTFORML
	FOR LOOP_CNT_i, 0, 5
		IF DUNGEON_32_KEY_LIST:LOOP_CNT_i:0 != 0
			;保有する不思議なカギをリスト表示する
			PRINTFORML [  {LOOP_CNT_i + 1}]:%DUNGEON_32_DEVIL_LEVEL_NAME:(DUNGEON_32_KEY_LIST:LOOP_CNT_i:0)%%DUNGEON_32_PLACE_NAME:(DUNGEON_32_KEY_LIST:LOOP_CNT_i:1)%의 열쇠
		ENDIF
	NEXT

	PRINTFORML [ 99]: 열쇠 순서를 바꾼다
	PRINTFORML [100]: 그만둔다
	$DUNGEON_32_STEVEN_INPUT_LOOP
	INPUT
	IF 1 <= RESULT && RESULT <= 5
		;------------------------
		;カギを使用する
		;------------------------
		KEY_NO = RESULT - 1		;カギの番号を取得する
		IF DUNGEON_32_KEY_LIST:KEY_NO:0 != 0
			;該当する番号のカギを保有している場合
			WHILE 1
				DRAWLINE
				PRINTFORML 동일한 열쇠로 이계와 마계 양쪽 모두 이동 가능하다네
				PRINTFORML 어느 쪽으로 가겠나？
				PRINTFORML [  1] 이계로 간다
				PRINTFORML [  2] 마계로 간다
				PRINTFORML [100] 그만둔다
				$DUNGEON_32_KEY_DUNGEON_TYPE_INPUT_LOOP
				INPUT
				IF RESULT == 1
					;-------------------------------------
					;異界へ行く
					;-------------------------------------
					ダンジョンフラグ:32:1 = 1																					;挑戦中のダンジョンの大分類を指定(1:占い師マリーの依頼によるランダム異界)
					ダンジョンフラグ:32:2 = DUNGEON_32_IKAI_DEVIL_LEVEL_MIN:(DUNGEON_32_KEY_LIST:KEY_NO:0)						;出現する悪魔の最低レベルを指定
					ダンジョンフラグ:32:3 = DUNGEON_32_IKAI_DEVIL_LEVEL_MAX:(DUNGEON_32_KEY_LIST:KEY_NO:0)						;出現する悪魔の最高レベルを指定
					ダンジョンフラグ:32:4 = DUNGEON_32_KEY_LIST:KEY_NO:1														;ダンジョンの種類を指定
					ダンジョンフラグ:32:7 = DUNGEON_32_KEY_LIST:KEY_NO:0														;ダンジョンの危険度を指定
					QUEST_DESIDED_FLG = 1																						;依頼選択済みフラグ(0:未決定 / 1:決定済み)　※「1:決定済み」の場合はメニューを終了してダンジョン探索を開始する。
					ダンジョンフラグ:32:5 = 2 + RAND:3																			;ダンジョンの深さを設定する。
					ダンジョンフラグ:32:6 = DUNGEON_32_DUNGEON_DIRECTION:(DUNGEON_32_KEY_LIST:KEY_NO:1)							;ダンジョンの方向を設定する(0:上に登る / 1:下に降りる)
					ダンジョンフラグ:32:8 = DUNGEON_32_IKAI_DEVIL_LEVEL_PLUS:(DUNGEON_32_KEY_LIST:KEY_NO:0)						;出現する悪魔のレベルのプラス補正(5の場合、出現する悪魔のレベルを本来のレベル+5にする)
					ダンジョンフラグ:32:9 = 1																					;ボス出現フラグ(1:出現する)
					ダンジョンフラグ:32:12 = 1																					;カギの使用による異界・魔界への再挑戦であるか(1:カギ使用)
					DRAWLINE
					BREAK

				ELSEIF RESULT == 2
					;-------------------------------------
					;魔界へ行く
					;-------------------------------------
					ダンジョンフラグ:32:1 = 2																					;挑戦中のダンジョンの大分類を指定(2:車いすの男の依頼)
					ダンジョンフラグ:32:4 = DUNGEON_32_KEY_LIST:KEY_NO:1														;ダンジョンの種類を指定
					ダンジョンフラグ:32:7 = DUNGEON_32_KEY_LIST:KEY_NO:0														;ダンジョンの危険度を指定
					QUEST_DESIDED_FLG = 1																						;依頼選択済みフラグ(0:未決定 / 1:決定済み)　※「1:決定済み」の場合はメニューを終了してダンジョン探索を開始する。
					ダンジョンフラグ:32:5 = 333																					;ダンジョンの深さを設定する。
					ダンジョンフラグ:32:6 = 1																					;ダンジョンの方向を設定する(1:下に降りる)
					ダンジョンフラグ:32:9 = 1																					;ボス出現フラグ(1:出現する)
					ダンジョンフラグ:32:12 = 1																					;カギの使用による異界・魔界への再挑戦であるか(1:カギ使用)
					DRAWLINE
					BREAK

				ELSEIF RESULT == 100
					;-------------------------------------
					;やめる
					;-------------------------------------
					BREAK

				ELSE
					;-------------------------------------
					;その他の場合、入力ミスのためやり直し
					;-------------------------------------
					GOTO DUNGEON_32_KEY_DUNGEON_TYPE_INPUT_LOOP

				ENDIF
			WEND

		ELSE
			;その他の場合、該当する番号のカギを保有していないため入力しなおす
			GOTO DUNGEON_32_STEVEN_INPUT_LOOP

		ENDIF

		;依頼決定済みの場合、ループを終了する(ゲーム側ではメニュー画面が終了してダンジョンがスタートする)
		IF QUEST_DESIDED_FLG == 1
			BREAK
		ENDIF


	ELSEIF RESULT == 99
		;------------------------
		;カギを並び替える
		;------------------------
		FOR LOOP_CNT_i, 0, 2
			PRINTFORML {LOOP_CNT_i + 1}번째 열쇠는？ (100을 입력하면 취소)
			$DUNGEON_32_CHANGE_KEY_INPUT_LOOP
			INPUT
			KEY_NO = RESULT - 1
			IF 1 <= RESULT && RESULT <= 5
				;-------------------------------------
				;1～5を指定した場合(カギの番号は1～5)
				;-------------------------------------
				DRAWLINE
				PRINTFORML 교환할 {LOOP_CNT_i + 1}번째 열쇠：{RESULT}번
				CHANGE_KEY_NO:LOOP_CNT_i = RESULT - 1		;交換する1つめのカギの番号を登録する

				;1つめのカギの場合、詳細データを一時保存する
				IF LOOP_CNT_i == 0
					CHANGE_KEY:0 = DUNGEON_32_KEY_LIST:(RESULT - 1):0	;ダンジョンの危険度
					CHANGE_KEY:1 = DUNGEON_32_KEY_LIST:(RESULT - 1):1	;ダンジョンの種類
				ENDIF

			ELSEIF RESULT == 100
				;-------------------------------------
				;やめる(車いすの男の依頼メニューに戻る)
				;-------------------------------------
				DRAWLINE
				BREAK

			ELSE
				;-------------------------------------
				;その他の場合、入力ミスのためやり直し
				;-------------------------------------
				GOTO DUNGEON_32_CHANGE_KEY_INPUT_LOOP

			ENDIF

			;2つ目のカギを指定済みの場合、カギの交換を行う
			IF LOOP_CNT_i == 1
				DUNGEON_32_KEY_LIST:(CHANGE_KEY_NO:0):0 = DUNGEON_32_KEY_LIST:(CHANGE_KEY_NO:1):0
				DUNGEON_32_KEY_LIST:(CHANGE_KEY_NO:0):1 = DUNGEON_32_KEY_LIST:(CHANGE_KEY_NO:1):1
				DUNGEON_32_KEY_LIST:(CHANGE_KEY_NO:1):0 = CHANGE_KEY:0
				DUNGEON_32_KEY_LIST:(CHANGE_KEY_NO:1):1 = CHANGE_KEY:1
			ENDIF
		NEXT
		DRAWLINE

	ELSEIF RESULT == 100
		;---------
		;やめる
		;---------
		DRAWLINE
		PRINTFORML 마계 탐색은 너무나도 위험하네。
		PRINTFORML 준비를 철저히 갖추고 난 뒤 다시 와주게나。
		PRINTFORML
		DRAWLINE

		;メインメニューに戻る
		BREAK

	ELSE
		;------------------------
		;入力ミスのためやり直し
		;------------------------
		GOTO DUNGEON_32_STEVEN_INPUT_LOOP

	ENDIF
WEND

;返り値
RETURN QUEST_DESIDED_FLG


