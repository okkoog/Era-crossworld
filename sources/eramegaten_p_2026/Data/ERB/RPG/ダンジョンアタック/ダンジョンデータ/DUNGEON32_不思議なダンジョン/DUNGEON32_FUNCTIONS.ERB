;--------------------------------------------
;シンボルエンカウントの敵の詳細を設定する
;--------------------------------------------
@DUNGEON_32_SET_SYMBOL_ENCOUNT_DETAIL
;-------------
;変数定義
;-------------
#DIM LOOP_CNT_i					;ループ用カウント変数
#DIM LOOP_CNT_j					;ループ用カウント変数
#DIM OBJECT_CNT					;オブジェクト(キャラクター)の数
#DIM ENEMY_NO					;敵のCSV番号
#DIM ENEMY_LEVEL				;敵のレベル
#DIM ENEMY_ACT_CNT				;敵の行動回数
#DIM ENEMY_BOSS_FLG				;敵のボスフラグ
#DIM ARRAY_ENEMY_STATUS_ADD, 8	;ステータス8種類の補正値(0:HP / 1:MP / 2:힘 / 3:지혜 / 4:마력 / 5:내구 / 6:속도 / 7:운)
#DIM EVENT_PATTERN				;シンボルと接触時のイベントのパターン(0:未設定 / 1:戦闘する / 2:イベント発生)
#DIM EVENT_NO1					;シンボルと接触時の特殊イベントの番号その1(ダンジョン番号)
#DIM EVENT_NO2					;シンボルと接触時の特殊イベントの番号その2(イベントの詳細番号)
#DIM NOT_TALK_FLG					;회화불능플래그(0:会話可能 / 1:회화불능)	※シンボルエンカウントの場合、個別に設定してあげる必要がある


;-------------
;変数の初期化
;-------------
LOOP_CNT_i = 0					;ループ用カウント変数i
LOOP_CNT_j = 0					;ループ用カウント変数i
OBJECT_CNT = 0					;オブジェクト(キャラクター)の数
ENEMY_NO = 0					;敵のCSV番号
ENEMY_LEVEL = 0					;敵のレベル
ENEMY_ACT_CNT = 0				;敵の行動回数
ENEMY_BOSS_FLG = 0				;敵のボスフラグ
VARSET ARRAY_ENEMY_STATUS_ADD	;ステータス8種類の補正値(0:HP / 1:MP / 2:힘 / 3:지혜 / 4:마력 / 5:내구 / 6:속도 / 7:운)
EVENT_PATTERN = 0				;シンボルと接触時のイベントのパターン(0:未設定 / 1:戦闘する / 2:特殊イベント発生)
EVENT_NO1 = 32					;シンボルと接触時の特殊イベントの番号その1(ダンジョン番号)
EVENT_NO2 = 0					;シンボルと接触時の特殊イベントの番号その2(イベントの詳細番号)
NOT_TALK_FLG = 1				;회화불능플래그(0:会話可能 / 1:회화불능)	※シンボルエンカウントの場合、個別に設定してあげる必要がある

;-------------
;本処理
;-------------
;キャラクターの数を取得する
FOR LOOP_CNT_i, 0, 20
	IF CD_ARRAY_OTHER_CHARA:LOOP_CNT_i:0 != 0
		OBJECT_CNT += 1
	ENDIF
NEXT

;キャラクターの数だけループを回して処理を行う
FOR LOOP_CNT_i, 0, OBJECT_CNT
	;変数を初期化する
	EVENT_PATTERN = 0

	;シンボルの種類ごとに設定を行う。
	SELECTCASE CD_ARRAY_OTHER_CHARA:LOOP_CNT_i:0
		CASE 1
			;「1:通常の敵」の場合
				;----------------------
				;シンボルの情報を取得する
				;----------------------
				ENEMY_NO = CD_ARRAY_OTHER_CHARA:LOOP_CNT_i:1											;敵のCSV番号を取得する
				ENEMY_LEVEL = CSVBASE(ENEMY_NO, GETNUM(BASE,"LV"),0) + ダンジョンフラグ:32:8			;敵のレベル
				ENEMY_ACT_CNT = 1																		;敵の行動回数
				ENEMY_BOSS_FLG = 0																		;敵のボスフラグ
				EVENT_PATTERN = 1																		;イベントのパターン(1:戦闘する)

		CASE 2
			;「2:強敵」の場合
				;----------------------
				;シンボルの情報を取得する
				;----------------------
				ENEMY_NO = CD_ARRAY_OTHER_CHARA:LOOP_CNT_i:1											;敵のCSV番号を取得する
				ENEMY_LEVEL = (CSVBASE(ENEMY_NO, GETNUM(BASE,"LV"),0) + ダンジョンフラグ:32:8) + 20		;敵のレベル
				ENEMY_ACT_CNT = 2																		;敵の行動回数
				ENEMY_BOSS_FLG = 1																		;敵のボスフラグ

				;ステータス補正値の設定(2:힘 / 3:지혜 / 4:마력 / 5:내구 / 6:속도 / 7:운)	※HP,MPの補正はなしとする
				FOR LOOP_CNT_j, 2, 8
					ARRAY_ENEMY_STATUS_ADD:LOOP_CNT_j = FLAG:현M							;敵のステータス補正値(ダンジョンの階層の絶対値と同じ値とする)
				NEXT

				;ここで「通常戦闘」「特殊イベント」の分岐を行う
				EVENT_PATTERN = 1																		;イベントのパターン(1:戦闘する)
				;EVENT_PATTERN = 2																		;イベントのパターン(2:特殊イベント発生)
				;EVENT_NO2 = 1																			;シンボルと接触時の特殊イベントの番号その2(イベントの詳細番号)

		CASEELSE
			;その他の場合(아무것도안한다)

	ENDSELECT

	;----------------------
	;シンボルの情報を登録する
	;----------------------
	;シンボルとの接触時のイベントパターンごとに登録を行う。
	SELECTCASE EVENT_PATTERN
		CASE 1, 2
			;「1:通常の敵」「2:強敵」の場合
			CD_ARRAY_OTHER_CHARA:LOOP_CNT_i:12 = ENEMY_LEVEL												 		;レベル
			CD_ARRAY_OTHER_CHARA:LOOP_CNT_i:13 = ENEMY_ACT_CNT 														;행동횟수
			CD_ARRAY_OTHER_CHARA:LOOP_CNT_i:14 = ENEMY_BOSS_FLG 													;보스플래그

			;ステータス補正値の設定(0:HP / 1:MP / 2:힘 / 3:지혜 / 4:마력 / 5:내구 / 6:속도 / 7:운)	※HP,MPの補正はなしとする
			FOR LOOP_CNT_j, 0, 8
				 CD_ARRAY_OTHER_CHARA:LOOP_CNT_i:(15 + LOOP_CNT_j) = ARRAY_ENEMY_STATUS_ADD:LOOP_CNT_j
			NEXT

			CD_ARRAY_OTHER_CHARA:LOOP_CNT_i:23 = EVENT_PATTERN														;シンボルと接触時のイベントのパターン(0:未設定 / 1:戦闘する / 2:特殊イベント発生)
			CD_ARRAY_OTHER_CHARA:LOOP_CNT_i:24 = EVENT_NO1															;シンボルと接触時の特殊イベントの番号その1(ダンジョン番号)
			CD_ARRAY_OTHER_CHARA:LOOP_CNT_i:25 = EVENT_NO2															;シンボルと接触時の特殊イベントの番号その2(イベントの詳細番号)
			CD_ARRAY_OTHER_CHARA:LOOP_CNT_i:27 = NOT_TALK_FLG														;회화불능플래그(0:会話可能 / 1:회화불능)

		CASEELSE
			;その他の場合(아무것도안한다)

	ENDSELECT
NEXT

RETURN 1


;-------------------------------------------------
;現在のフロアが最上層/最下層であるか判定する
;-------------------------------------------------
;返り値
;	0:最上層/最下層ではない
;	1:最上層/最下層である
;-----------------------------------------------------------------
@DUNGEON_32_IS_LAST_FLOOR
#FUNCTION
#LOCALSIZE  1
#LOCALSSIZE 1

;上に登るダンジョン / 下に降りるダンジョン で分岐してそれぞれ判定を行う
IF FLAG:현M == ダンジョンフラグ:32:5
	;最上層の場合
	RETURNF 1
ELSE
	;その他の場合
	RETURNF 0
ENDIF

;-------------------------------------------------
;ボス戦闘処理(異界の主、魔界の領域の主など)
;-------------------------------------------------
;-----------------------------------------------------------------
@DUNGEON_32_BOSS_BATTLE
;-------------
;変数定義
;-------------
#DIM BOSS_CSV_NO		;ボス悪魔の種類(CSVファイルの番号)
#DIM RANDOM_NO_100		;0～99の乱数を入れる変数。カギ入手イベントの判定などに利用する

;-------------
;変数の初期化
;-------------
BOSS_CSV_NO = 0			;ボス悪魔の種類(CSVファイルの番号)
RANDOM_NO_100 = 0		;0～99の乱数を入れる変数。カギ入手イベントの判定などに利用する

;-------------
;本処理
;-------------
IF ダンジョンフラグ:32:1 == 1
	;占い師マリーの依頼の場合

	;戦闘前会話
	CALL MESSAGE_WINDOW_D, "", "＞당신은 이 방 안에서 다른 녀석들과 상태가 다른 악마를 발견했다。"
	CALL MESSAGE_WINDOW_D, "", "＞그 악마를 중심으로 공간이 뒤틀려 있다。이 이계의 주인이 틀림없을 것이다"
	CALL MESSAGE_WINDOW_D, "", "＞당신은 이 이계를 해소하기 위해 악마에게 덤벼들었다！"

	;戦闘用のフラグ設定を行う
	FLAG:도주불가플래그 = 1
	FLAG:선제기습취소 = 1

	;ボス悪魔の召喚
	;	種類はダンジョン内に出現する雑魚悪魔から1つをランダムに選択
	;	レベルは本来のレベル + 15
	BOSS_CSV_NO = CD_DEVIL_LIST:(RAND:CD_DEVIL_VARIETY_CNT)										;ボス悪魔のCSV番号を取得
	CALL SET_ENEMY, 9, BOSS_CSV_NO, CSVBASE(BOSS_CSV_NO, GETNUM(BASE,"LV"),0) + 15, 0, 1		;ボス悪魔を9番の位置にセットする

	;ボス悪魔のドロップアイテムを設定
	ABL:(CHARANUM-1):아이템1 = GETNUM(ITEM, "챠크라드롭")
	ABL:(CHARANUM-1):입수확률1 = 100
	ABL:(CHARANUM-1):아이템2 = GETNUM(ITEM, "챠크라포트")
	ABL:(CHARANUM-1):입수확률2 = 35
	ABL:(CHARANUM-1):아이템3 = GETNUM(ITEM, "그레이트챠크라")
	ABL:(CHARANUM-1):입수확률3 = 10

	;ボス悪魔のステータス等を設定
	CFLAG:(CHARANUM-1):행동횟수 = 2								;二回行動
	BASE:(CHARANUM-1):힘 = (BASE:(CHARANUM-1):힘) * 2			;力を2倍にする
	BASE:(CHARANUM-1):지혜 = (BASE:(CHARANUM-1):지혜) * 2		;知恵を2倍にする
	BASE:(CHARANUM-1):마력 = (BASE:(CHARANUM-1):마력) * 2		;魔力を2倍にする
	BASE:(CHARANUM-1):내구 = (BASE:(CHARANUM-1):내구) * 2		;耐力を2倍にする
	BASE:(CHARANUM-1):속도 = (BASE:(CHARANUM-1):속도) * 2		;速さを2倍にする
	BASE:(CHARANUM-1):운 = (BASE:(CHARANUM-1):운) * 2			;運を2倍にする

	;ステータス等の設定を有効にする
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)
	
	;戦闘開始
	CALL BATTLE_START
	
	;戦闘用のフラグ設定を元に戻す
	FLAG:도주불가플래그 = 0
	FLAG:선제기습취소 = 0

	;カギ入手イベント(25%、または4回目の依頼で確定ドロップ)
	RANDOM_NO_100 = 1 + RAND:100			;1～100の乱数を設定する
	IF RANDOM_NO_100 >= 75 || ダンジョンフラグ:32:0 == 4
		CALL DUNGEON_32_GET_KEY				;カギ入手イベント
	ENDIF


	;ダンジョンクリア報酬
	IF ダンジョンフラグ:32:12 == 0
		;カギを使用していない場合(占い師マリーを通して依頼を受けている場合)
		CALL MESSAGE_WINDOW_D, "", "＞이계의 주인이 격파됨으로써 이계화는 해소되었다。"
		CALL MESSAGE_WINDOW_D, "", "＞당신은 점술사 마리에게 보고를 하고、보수를 받았다。"
		CALL MESSAGE_WINDOW_D, "", "＞￥5000을 손에 넣었다"
		MONEY += 5000
		CALL MESSAGE_WINDOW_D, "", "＞명성 5를 얻었다"
		FLAG:명성 += 5

		;フラグ設定
		IF ダンジョンフラグ:32:0 <= 20
			ダンジョンフラグ:32:0 += 1		;占い師マリーの依頼の進行度を+1する　※会話が少し変化する程度であまり意味はないです。
		ENDIF

	ELSE
		;その他の場合(カギを使用して直接異界へきている、つまり占い師マリーの依頼を経由していない場合)
		CALL MESSAGE_WINDOW_D, "", "＞이계의 주인이 격파됨으로써 이계화는 해소되었다。"
		CALL MESSAGE_WINDOW_D, "", "＞당신은 이계로부터 귀환했다。"

	ENDIF

	;ダンジョンを脱出する
	FLAG:탈출 = 1

ELSEIF ダンジョンフラグ:32:1 == 2
	;魔界探索の場合

	;戦闘前会話
	CALL MESSAGE_WINDOW_D, "", "＞이 영역의 출구를 막아서듯 서 있는 악마를 발견했다。"
	CALL MESSAGE_WINDOW_D, "", "＞종족의 왕일까 다른 동족들이 시중을 들고 있는 듯하다。"
	CALL MESSAGE_WINDOW_D, "", "＞당신은 앞으로 나아가고자 영역의 주인에게 싸움을 걸었다！"

	;戦闘用のフラグ設定を行う
	FLAG:도주불가플래그 = 1
	FLAG:선제기습취소 = 1

	;ボス悪魔の召喚
	;	種類はダンジョン内に出現する雑魚悪魔から1つをランダムに選択
	;	レベルは本来のレベル + 15 + 階層補正(51～100階は+50、101～150階は+100、151～200階は+150、...)
	BOSS_CSV_NO = CD_DEVIL_LIST:(RAND:CD_DEVIL_VARIETY_CNT)																;ボス悪魔のCSV番号を取得
	CALL SET_ENEMY, 9, BOSS_CSV_NO, CSVBASE(BOSS_CSV_NO, GETNUM(BASE,"LV"),0) + 15 + ダンジョンフラグ:32:8, 0, 1		;ボス悪魔を9番の位置にセットする

	;ボス悪魔のドロップアイテムを設定
	ABL:(CHARANUM-1):아이템1 = GETNUM(ITEM, "챠크라드롭")
	ABL:(CHARANUM-1):입수확률1 = 100
	ABL:(CHARANUM-1):아이템2 = GETNUM(ITEM, "챠크라포트")
	ABL:(CHARANUM-1):입수확률2 = 35
	ABL:(CHARANUM-1):아이템3 = GETNUM(ITEM, "그레이트챠크라")
	ABL:(CHARANUM-1):입수확률3 = 10

	;ボス悪魔のステータス等を設定
	CFLAG:(CHARANUM-1):행동횟수 = 3								;二回行動
	BASE:(CHARANUM-1):힘 = (BASE:(CHARANUM-1):힘) * 2			;力を2倍にする
	BASE:(CHARANUM-1):지혜 = (BASE:(CHARANUM-1):지혜) * 2		;知恵を2倍にする
	BASE:(CHARANUM-1):마력 = (BASE:(CHARANUM-1):마력) * 2		;魔力を2倍にする
	BASE:(CHARANUM-1):내구 = (BASE:(CHARANUM-1):내구) * 2		;耐力を2倍にする
	BASE:(CHARANUM-1):속도 = (BASE:(CHARANUM-1):속도) * 2		;速さを2倍にする
	BASE:(CHARANUM-1):운 = (BASE:(CHARANUM-1):운) * 2			;運を2倍にする

	;ステータス等の設定を有効にする
	CALL SYNC_STATUS,(CHARANUM-1)
	CALL HEALTH_CHARA,(CHARANUM-1)		
	
	;戦闘開始
	CALL BATTLE_START
	
	;戦闘用のフラグ設定を元に戻す
	FLAG:도주불가플래그 = 0
	FLAG:선제기습취소 = 0

	;カギ入手イベント(25%)
	RANDOM_NO_100 = 1 + RAND:100			;1～100の乱数を設定する
	IF RANDOM_NO_100 >= 75
		CALL DUNGEON_32_GET_KEY				;カギ入手イベント
	ENDIF

	;ボス撃破報酬
	IF DUNGEON_32_IS_LAST_FLOOR() == 1
		;最上層 / 最下層である場合
		CALL MESSAGE_WINDOW_D, "", "＞영역의 주인을 쓰러뜨렸지만、그 앞으로 이어지는 길을 찾을 수 없다"
		CALL MESSAGE_WINDOW_D, "", "＞아무래도 마계의 가장 깊은 곳까지 답파한 모양이다！"
		CALL MESSAGE_WINDOW_D, "", "＞당신은 휠체어를 탄 남자에게 보고를 하고、귀환했다。"
		CALL MESSAGE_WINDOW_D, "", "＞￥50000을 손에 넣었다"
		MONEY += 50000
		CALL MESSAGE_WINDOW_D, "", "＞명성 2000을 얻었다"
		FLAG:명성 += 2000

		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃DDS-NET　　　　　　　　　　　　　　　　　　　　　　　　 ┃
		PRINTFORML ┃DATE:20XX-XX-XX　　　　　　　　　　　　　　　　　　　　 ┃
		PRINTFORML ┃NAME:STEAVEN　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTFORML ┃마계의 조사 결과에 대하여　　　　　　　　　　　　　　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃드디어 마계의 구조가 판명되어 가고 있다네　　　　　　　　┃
		PRINTFORML ┃자네가 조사를 완수해 준 덕분일세　　　　　　　　　　　　┃
		PRINTFORML ┃정말로 고맙네　　　　　　　　　　　　　　　　　　　　　　┃
		PRINTFORML ┃현재는 마계와 지상을 분리하는 방법을 연구하고 있다네　　┃
		PRINTFORML ┃가까운 장래에 뜻있는 자들을 모아 세계 간의 연결을 끊을 생각일세┃
		PRINTFORML ┃과거의、사람들이 악마를 두려워하지 않고 살던 나날을 되찾고 싶네┃
		PRINTFORML ┃그때는 부디、자네의 힘을 빌려주게나　　　　　　　　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

		;魔界探索の進行状況を100(クリア済み)に設定する
		ダンジョンフラグ:32:10 = 100
		ダンジョンフラグ:32:15 = FLAG:현M		;ボスを撃破して進んだ階層を更新する

		;ダンジョンを脱出する
		FLAG:탈출 = 1

	ELSE
		;その他の場合(10階ごとの領域の主の場合)
		CALL MESSAGE_WINDOW_D, "", "＞영역의 주인을 격파했다。"
		CALL MESSAGE_WINDOW_D, "", "＞당신은 휠체어를 탄 남자에게 보고를 하고、보수를 받았다。"
		CALL MESSAGE_WINDOW_D, "", "＞￥2000을 손에 넣었다"
		MONEY += 2000
		CALL MESSAGE_WINDOW_D, "", "＞명성 20을 얻었다"
		FLAG:명성 += 20

		ダンジョンフラグ:32:15 = FLAG:현M		;ボスを撃破して進んだ階層を更新する

		CALL MESSAGE_WINDOW_D, "", "＞영역의 주인이 있던 자리에 계단이 출현했다！"
		DA:(FLAG:현X):(FLAG:현Y) = 7

	ENDIF
ENDIF



;-------------------------------------------------
;宝箱取得処理
;-------------------------------------------------
;-----------------------------------------------------------------
@DUNGEON_32_GET_RANDOM_TREASURE
;-------------
;変数定義
;-------------
#DIM RANDOM_NO_100	;1～100の乱数を入れる変数。宝箱の中身の判定に使用する

;-------------
;変数の初期化
;-------------
RANDOM_NO_100 = 0	;1～100の乱数を入れる変数。宝箱の中身の判定などに使用する

;-------------
;本処理
;-------------

;乱数を決定する(宝の種類を決める)
RANDOM_NO_100 = 1 + RAND:100

SELECTCASE ダンジョンフラグ:32:1
	CASE 1
		;占い師マリーの依頼の場合

		;危険度に応じて宝箱の中身を変更する
		SELECTCASE ダンジョンフラグ:32:7
			CASE 0
				;危険度0：簡単なダンジョンの場合
				IF RANDOM_NO_100 <= 40
					;日本円を獲得する
					CALL GET_TREASURE_MONEY, 0, (200 + RAND:401), FLAG:현던전, 99	;補足：通常はダンジョンフラグの4番目の引数で『宝箱をすでに開けた』という記録を残すのですが、ランダムなダンジョンのためこれは不要。適当に未使用の99番目のフラグを当てはめています。

				ELSEIF RANDOM_NO_100 <= 60
					;魔石を獲得する
					CALL GETS_TREASURE, "마석", 1, FLAG:현던전, 99

				ELSEIF RANDOM_NO_100 <= 80
					;宝玉を獲得する
					CALL GETS_TREASURE, "보옥", 1, FLAG:현던전, 99

				ELSE
					;チャクラドロップを獲得する
					CALL GETS_TREASURE, "챠크라드롭", 1, FLAG:현던전, 99
				
				ENDIF



			CASE 1
				;危険度1：普通のダンジョンの場合
				IF RANDOM_NO_100 <= 40
