;--------------------------------------------
;フロアの広さを設定する
;--------------------------------------------
@DUNGEON_32_DESIDE_FLOOR_SIZE
;-------------
;本処理
;-------------

IF ダンジョンフラグ:32:1 == 1
	;挑戦中のダンジョンの大分類が(1:占い師マリーの依頼によるランダム異界)である場合

	;ダンジョンの種類ごとに詳細設定を行う
	SELECTCASE ダンジョンフラグ:32:4
		CASE 1
			;ビルの場合
 			FLAG:최대X = 20
			FLAG:최대Y = 20

		CASE 2
			;病院の場合
			FLAG:최대X = 35
			FLAG:최대Y = 35

		CASE 3
			;アパートの場合
			FLAG:최대X = 40
			FLAG:최대Y = 20

		CASE 4
			;学校の場合
			FLAG:최대X = 30
			FLAG:최대Y = 30

		CASE 5
			;森の場合
			FLAG:최대X = 50
			FLAG:최대Y = 50

		CASE 6
			;山の場合
			FLAG:최대X = 50
			FLAG:최대Y = 50

		CASE 7
			;神社の場合
			FLAG:최대X = 30
			FLAG:최대Y = 30

		CASE 8
			;警察署の場合
			FLAG:최대X = 35
			FLAG:최대Y = 35

		CASE 9
			;古墳の場合
			FLAG:최대X = 40
			FLAG:최대Y = 40

		CASE 10
			;墓地の場合
			FLAG:최대X = 30
			FLAG:최대Y = 30

		CASE 11
			;海岸の場合
			FLAG:최대X = 60
			FLAG:최대Y = 60

		CASE 12
			;地下水道の場合
			FLAG:최대X = 45
			FLAG:최대Y = 45

		CASEELSE
			;その他の場合(縦・横ともに10～60マスのランダム)
			FLAG:최대X = 10 + RAND:51
			FLAG:최대Y = 10 + RAND:51

	ENDSELECT

ENDIF

RETURN 1


;--------------------------------------------
;各種フラグを初期化する
;--------------------------------------------
@DUNGEON_32_CLEAR_FLAG
;-------------
;変数定義
;-------------
#DIM LOOP_CNT_i			;ループ用カウント変数　※処理が長くて複雑なので、グローバル変数LOCALは使いたくない
#DIM HAVE_KEY_FLG		;不思議なカギを入手済みであるかどうか(0:未所持 / 1:入手済み)

;-------------
;変数の初期化
;-------------
LOOP_CNT_i = 0			;ループ用カウント変数
HAVE_KEY_FLG = 0		;不思議なカギを入手済みであるかどうか(0:未所持 / 1:入手済み)

;-------------
;本処理
;-------------
;ダンジョンの設定を初期化する
ダンジョンフラグ:32:1 = 0			;挑戦中のダンジョンの大分類を指定(0:ダンジョン設定なし)
ダンジョンフラグ:32:4 = 0			;ダンジョンの種類詳細(0:未設定)
ダンジョンフラグ:32:7 = 0			;ダンジョンの危険度(0:未設定)
ダンジョンフラグ:32:8 = 0			;出現する悪魔のレベルのプラス補正(5の場合、出現する悪魔のレベルを本来のレベル+5にする)
ダンジョンフラグ:32:13 = 0			;ダンジョン到達階の記録が更新されたフラグ(0:更新無し / 1:更新有り)
FLAG:현M = 0			;現在の階層の絶対値(例として地上5階 / 地下5階いずれも5となる)
ダンジョンフラグ:32:15 = 0			;何階までボスを撃破して進んだか　※一度通過したボス階に戻ってきたときボスが復活しないようにする
ダンジョンフラグ:32:16 = 0			;探索開始時の階層　※カギを使用しての探索などだと途中階からスタートするため


;戦闘設定用の各種フラグを初期化する(不思議なダンジョンでは経験値なし、解析率上昇不可、仲魔集めも不可！RPG的には全然おいしくない設定です。純粋に潜ることを楽しんでいただけるように頑張ります。
FLAG:회화불능플래그 = 1				;悪魔と会話不可(仲魔に勧誘できない)
FLAG:악마해석률상승불가플래그 = 1	;悪魔解析率を上げられない
FLAG:RESULT스킵 = 1				;戦闘後のリザルト画面なし。経験値・MAGなどを得られない

;車いすのおとこのイベントフラグを設定する
IF ダンジョンフラグ:32:10 == 0
	;魔界探索・カギを使用した探索が未開放である場合

	;不思議なカギを持っているかどうか確認する
	FOR LOOP_CNT_i, 0, 5
		IF DUNGEON_32_KEY_LIST:LOOP_CNT_i:0 != 0
			;不思議なカギを保有している場合
			HAVE_KEY_FLG = 1			;カギを入手済みである
			BREAK
		ENDIF
	NEXT

	;車いすのおとこのイベント
	IF HAVE_KEY_FLG == 1
		;不思議なカギを所持している場合
		IF ダンジョンフラグ:32:0 == 0
			;占い師マリーの依頼をまだやっていない場合、以前の周回で入手したカギを引き継いでいる
			CALL MESSAGE_WINDOW, "" , "＞휠체어를 탄 초로의 남자가 나타났다"
			DRAWLINE
			PRINTFORML
			PRINTFORML 여어　%CALLNAME:MASTER% 군 아닌가
			PRINTFORML 자네도　무사히 다음 세계로 이동한 모양이군
			PRINTFORML 자、자네 자택의 터미널 시스템에서 마계로 갈 수 있도록 해줌세
			PRINTFORMW ………
			PRINTFORMW ……
			PRINTFORMW …
			PRINTFORML 좋아、이걸로 마계에 갈 수 있을 걸세
			PRINTFORML 그럼　또 보세나
			PRINTFORMW
			DRAWLINE
			CALL MESSAGE_WINDOW, "" , "＞『휠체어를 탄 남자의 의뢰』가 해금되었다"
			CALL MESSAGE_WINDOW, "" , "＞『열쇠를 사용하여 이계・마계를 탐색한다』가 해금되었다"
			ダンジョンフラグ:32:10 = 1		;魔界探索の解放

		ELSE
			;その他の場合、現在の周回でカギを入手している
			CALL MESSAGE_WINDOW, "" , "＞자택 컴퓨터에 1통의 메일이 도착해 있다"
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃DDS-NET　　　　　　　　　　　　　　　　　　　　　　　　 ┃
			PRINTFORML ┃DATE:20XX-XX-XX　　　　　　　　　　　　　　　　　　　　 ┃
			PRINTFORML ┃NAME:STEAVEN　　　　　　　　　　　　　　　　　　　　　　┃
			PRINTFORML ┃이계의 주인을 쓰러뜨리고 열쇠를 입수한 자네에게　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃그 열쇠는 마계로 향하는 이정표가 될 것일세　　　　　　　┃
			PRINTFORML ┃악마의 무질서한 범람을 막기 위해 자네의 협력이 필요하네┃
			PRINTFORML ┃이 메일을 받은 자네가 용기 있는 자이기를 비네　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			DRAWLINE
			CALL MESSAGE_WINDOW, "" , "＞『휠체어를 탄 남자의 의뢰』가 해금되었다"
			ダンジョンフラグ:32:10 = 1		;魔界探索の解放

		ENDIF
	ENDIF
ENDIF


RETURN 1


;--------------------------------------------
;カギ入手イベント
;--------------------------------------------
@DUNGEON_32_GET_KEY
;-------------
;変数定義
;-------------
#DIM LOOP_CNT_i			;ループ用カウント変数　※処理が長くて複雑なので、グローバル変数LOCALは使いたくない
#DIM KEY_SET_FLG		;入手したカギを登録したかどうか(0:未登録 / 1:登録済み)

;-------------
;変数の初期化
;-------------
LOOP_CNT_i = 0			;ループ用カウント変数
KEY_SET_FLG = 0			;入手したカギを登録したかどうか(0:未登録 / 1:登録済み)

;-------------
;本処理
;-------------
PRINTFORML 어라？ 악마가 있던 자리에 무언가가 빛나고 있다……？
PRINTFORMW %DUNGEON_32_DEVIL_LEVEL_NAME:(ダンジョンフラグ:32:7)%%DUNGEON_32_PLACE_NAME:(ダンジョンフラグ:32:4)%의 열쇠를 발견했다！

;既に同じカギを持っているかどうかチェックする
FOR LOOP_CNT_i, 0, 5
	IF DUNGEON_32_KEY_LIST:LOOP_CNT_i:0 == ダンジョンフラグ:32:7 && DUNGEON_32_KEY_LIST:LOOP_CNT_i:1 == ダンジョンフラグ:32:4
		;同じカギを既に持っている場合、処理をスキップする
		PRINTFORML 유감스럽게도 이미 가지고 있는 열쇠였다。
		PRINTFORMW 당신은 주운 열쇠를 버렸다。
		RETURN 0
	ENDIF
NEXT


;不思議なカギの保有リストの内、開いている箇所に入手したカギを設定する。
FOR LOOP_CNT_i, 0, 5
	IF DUNGEON_32_KEY_LIST:LOOP_CNT_i:0 == 0
		;不思議なカギの保有リストに空きが存在する場合、その場所にカギをセットする
		DUNGEON_32_KEY_LIST:LOOP_CNT_i:0 = ダンジョンフラグ:32:7			;ダンジョンの危険度を登録する(0:簡単な / 1:ふつうの / 2:危険な / 3:破滅的な / その他沢山)
		DUNGEON_32_KEY_LIST:LOOP_CNT_i:1 = ダンジョンフラグ:32:4			;ダンジョンの種類を登録する(0:ビル / 1:病院 / 2:アパート / 3:学校 / 4:森 / 5:山 / 6:神社 / 7:警察署 / 8:古墳 / 9:墓地 / 10:海岸 / 11:地下水道 / その他沢山)
		KEY_SET_FLG = 1														;カギを登録済み
		BREAK
	ENDIF
NEXT

;カギがいっぱいの場合、どれと入れ替えるか指定する
IF KEY_SET_FLG == 0

	WHILE 1
		PRINTFORML
		PRINTFORML 열쇠가 가득 찼습니다。다음 중 하나와 교체해 주십시오。
		
		;保有しているカギを表示する
		FOR LOOP_CNT_i, 0, 5
			PRINTFORML [  {LOOP_CNT_i}]:%DUNGEON_32_DEVIL_LEVEL_NAME:(DUNGEON_32_KEY_LIST:LOOP_CNT_i:0)%%DUNGEON_32_PLACE_NAME:(DUNGEON_32_KEY_LIST:LOOP_CNT_i:1)%의 열쇠
		NEXT
		PRINTFORML [100] 열쇠를 입수하지 않는다
		$DUNGEON_32_KEY_GET_INPUT_LOOP
		INPUT
		IF 1 <= RESULT && RESULT <= 5
			;選択された箇所にカギを登録する
			DUNGEON_32_KEY_LIST:RESULT:0 = ダンジョンフラグ:32:7			;ダンジョンの危険度を登録する(0:簡単な / 1:ふつうの / 2:危険な / 3:破滅的な / その他沢山)
			DUNGEON_32_KEY_LIST:RESULT:1 = ダンジョンフラグ:32:4			;ダンジョンの種類を登録する(0:ビル / 1:病院 / 2:アパート / 3:学校 / 4:森 / 5:山 / 6:神社 / 7:警察署 / 8:古墳 / 9:墓地 / 10:海岸 / 11:地下水道 / その他沢山)
			BREAK															;カギの取得を終了する

		ELSEIF RESULT == 100
			;カギを入手しない
			PRINTFORMW 당신은 주운 열쇠를 버렸다。
			BREAK															;カギの取得を終了する

		ELSE
			;------------------------
			;入力ミスのためやり直し
			;------------------------
			GOTO DUNGEON_32_KEY_GET_INPUT_LOOP

		ENDIF
	WEND
ENDIF

RETURN 1


;--------------------------------------------
;魔界探索の設定
;--------------------------------------------
@DUNGEON_32_SET_MAKAI
;-------------
;変数定義
;-------------
#DIM LOOP_CNT_i			;ループ用カウント変数					※処理が長くて複雑なので、グローバル変数LOCALは使いたくない
#DIM FLOOR_50			;現在の階層を50で割った値(切り捨て)		※魔界探索では50階毎に出現する悪魔の(元々の)レベルが切り替わるため
#DIM FLOOR_50_AMARI		;現在の階層を50で割った余り				※魔界探索では50階毎に出現する悪魔の(元々の)レベルが切り替わるため

;-------------
;変数の初期化
;-------------
LOOP_CNT_i = 0			;ループ用カウント変数
FLOOR_50 = 0			;現在の階層を50で割った値(切り捨て)		※魔界探索では50階毎に出現する悪魔の(元々の)レベルが切り替わるため
FLOOR_50_AMARI = 0		;現在の階層を50で割った余り				※魔界探索では50階毎に出現する悪魔の(元々の)レベルが切り替わるため

;-------------
;本処理
;-------------
;現在の階層について50で割った商と余りを取得する
FLOOR_50 = FLAG:현M / 50							;現在の階層を50で割った値(切り捨て
FLOOR_50_AMARI = FLAG:현M % 50						;現在の階層を50で割った余り

;50の倍数階ピッタリの場合、余り0ではなくて余り50として扱う(ダンジョンが変化するのは51階、101階、151階、...のタイミングとする)
IF FLOOR_50_AMARI == 0
	FLOOR_50 -= 1
	FLOOR_50_AMARI = 50
ENDIF

;出現する悪魔のレベル下限・レベル上限を設定する
ダンジョンフラグ:32:2 = FLOOR_50_AMARI				;出現する悪魔のレベル下限
IF FLOOR_50_AMARI >= 41
	;現在の階層を50で割った余りが41以上の場合出現する悪魔のレベル上限は200とする
	ダンジョンフラグ:32:3 = 200						;出現する悪魔のレベル上限限

ELSE
	;その他の場合、出現する悪魔のレベル上限は「最低レベル+20」とする
	ダンジョンフラグ:32:3 = FLOOR_50_AMARI + 20		;出現する悪魔のレベル上限限

ENDIF

;出現する悪魔のレベルのプラス補正
ダンジョンフラグ:32:8 = FLOOR_50 * 50

;領域の危険度と種類を設定する
IF FLAG:현M % 10 == 1 && FLAG:현M != 1 && FLAG:현M != ダンジョンフラグ:32:16
	;階層が10n+1の場合(ただし1階および、カギを用いて侵入した最初の階層は除く)
	ダンジョンフラグ:32:4 = 13 + RAND:13			;ランダムに領域の種類を設定する
	ダンジョンフラグ:32:7 = 5 + (FLAG:현M / 10)	;危険度は10階層毎に上昇	※10→11、20→21、...のタイミングで危険度を1上昇させる

	;魔界探索の危険度は最大36とする
	IF ダンジョンフラグ:32:7 > 36
		ダンジョンフラグ:32:7 = 36
	ENDIF

ENDIF

;10n+1階

RETURN 1


;--------------------------------------------
;スタートの階層を設定する
;--------------------------------------------
@DUNGEON_32_SET_START_DEPTH
;-------------
;本処理
;-------------
;1階または地下1階からスタートする場合の共通処理
FLAG:현M = 1
;魔界探索の場合のスタート階層
IF ダンジョンフラグ:32:1 == 2
	;魔界探索の場合、カギの危険度に合わせた階層からスタートする	※地下へ降りていくダンジョンであるため階層は -1 する
	FLAG:현M = DUNGEON_32_MAKAI_START_DEPTH_MIN:(ダンジョンフラグ:32:7)
ENDIF

;スタート時の階層を記録する
ダンジョンフラグ:32:16 = FLAG:현M

RETURN 1


;--------------------------------------------
;到達記録などを作成する
;--------------------------------------------
@SAVE_RECORD
;-------------
;変数定義
;-------------
#DIM LOOP_CNT_i			;ループ用カウント変数					※処理が長くて複雑なので、グローバル変数LOCALは使いたくない
#DIM DEPTH_CNT			;現在の階層の絶対値						※絶対値を取る。地上5階、地下5階いずれも5とする。

;-------------
;変数の初期化
;-------------
LOOP_CNT_i = 0			;ループ用カウント変数
DEPTH_CNT = 0			;現在の階層の絶対値						※絶対値を取る。地上5階、地下5階いずれも5とする。

;-------------
;本処理
;-------------
;現在の現在の階層の絶対値を取得する
IF FLAG:현M < 0
	;地下の場合
	DEPTH_CNT = FLAG:현M * -1

ELSE
	;その他の場合(地上の場合)
	DEPTH_CNT = FLAG:현M

ENDIF
FLAG:현M = DEPTH_CNT				;現在の階層の絶対値

IF ダンジョンフラグ:32:1 == 2
	;魔界探索の場合
	IF DEPTH_CNT > ダンジョンフラグ:32:21
		;これまでの到達記録より現在の階層の方が深い場合
		ダンジョンフラグ:32:21 = DEPTH_CNT		;ダンジョン到達階の記録を更新する
		ダンジョンフラグ:32:13 = 1				;ダンジョン到達階の記録が更新されたフラグ(0:更新無し / 1:更新有り)
	ENDIF
ENDIF


RETURN 1


