;コートニー(네코마타)
@SORP_PLAY_1014, ARGS
#DIMS DYNAMIC ICON_ADDRESS
ICON_ADDRESS = 69_コートニー
SELECTCASE ARGS
	CASE "娼婦番号"
		RESULTS = [1014]
	CASE "キャラ名"
	RESULTS = 코트니
	CASE "指名名"
	RESULTS = 코트니(네코마타)
	CASE "所属"
		;表なら1、裏なら2
		RETURN 1
	CASE "判定"
		;指名可能なら0、不可なら1
		;メラニー身請け済なら出現
		CALL SORP_PLAY_1004, "判定"
		SIF !RESULT
			RETURN 1
		RETURN 0
	CASE "価格"
		RETURN 500
	CASE "紹介文"
		IF 六本木娼婦フラグ:14 == 0
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"과연, 코트니 양을 희망하십니까/그녀는 멜라니 양이 후계자로 두고 간 네코마타라서 말이지요/멜라니 양을 잊지 못하는 층으로부터의 지지가 두텁습니다"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"기술도 인기마저도 그야말로 멜라니 양의 재림입니다만/딱 한 가지 문제가 있어서요/"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"개다래나무를 너무 좋아해서 가끔 제구실을 못 하게 되곤 합니다…/뭐 근무 시간 중에는 개다래나무를 금지하고 있으니 문제없으리라 봅니다만/"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"아, 새삼스럽지만 개다래나무 선물은 금지되어 있습니다/이전에 모 손님의 선물 때문에 정말이지 끔찍한 사태가 일어났었거든요…/"
		ELSE
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"과연, 코트니 양입니까/손님, 현란한 혀놀림의 포로가 되셨군요/"
		ENDIF
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"그럼, 코트니 양입니다만…/하룻밤에 ５００마카가 되겠습니다/"
	CASE "プレイ口上"
		CALL DUNGEON_WORP,1,12,2
		IF 六本木娼婦フラグ:14 == 0
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"코트니", @"예이, 서방님！ 오늘 잘 부탁해%ハート()%!/마음은 언제나 라이온 킹！/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞유난히 텐션이 높은 네코마타가 찾아왔다.//"
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"코트니", @"응~？ 취한 거 아니냐고？/괜차나 괜찮아 이게 원래 상태야！/오히려 나 취하면 울며불며 소리치는 타입이니까！"
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"코트니", @"그럼 말야~, 어서 옷 벗어 벗어！//"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"/＞즐겁게 놀았습니다…/"
			六本木娼婦フラグ:14 = 1
		ELSE
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"코트니", @"오늘도 잘 부탁해%ハート()%!/서방님이라면 예약 없이도 내 풀코스를 대접해 줄게！/"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"/＞즐겁게 놀았습니다…/"
		ENDIF
		EXP:MASTER:절정경험 += ABL:MASTER:기교
		JUEL:MASTER:쾌Ｃ += ABL:MASTER:기교 * (300) + 300
		JUEL:MASTER:쾌Ｂ += ABL:MASTER:기교 * (300) + 300
		JUEL:MASTER:쾌Ａ += ABL:MASTER:기교 * (300) + 300
		JUEL:MASTER:욕정 += ABL:MASTER:기교 * (300) + 300
		EXP:MASTER:Ａ경험 += ABL:MASTER:기교 * 5
		IF !TALENT:MASTER:남자
			EXP:MASTER:레즈경험 += ABL:MASTER:기교 * 3
			JUEL:MASTER:쾌Ｖ += ABL:MASTER:기교 * (300) + 300
		ENDIF
		IF TALENT:MASTER:남자 || TALENT:MASTER:후타나리
			EXP:MASTER:사정경험 += ABL:MASTER:기교
			CALL CONTROL_MAG, MASTER, -(ABL:MASTER:기교 * 3000)
		ENDIF
		IF TALENT:MASTER:모유체질
			EXP:MASTER:분유경험 += (ABL:MASTER:기교 + 1) * 3
			JUEL:MASTER:쾌Ｂ += (ABL:MASTER:기교 + 1) * 200
			CALL CONTROL_MAG, MASTER, -(ABL:MASTER:기교 * 2000 + 1000)
		ENDIF
		;CALL INCREASE_LC,5  意図が不明かつ変動量が強烈で、ユーザー側から認識できない場所での変動なので除外します。必要性があって再実装する場合は右記の点に注意して再実装してください。
	CASE "身受け価格"
		RETURN 99999
	CASE "身受け確認"
		;
	CASE "身受け口上"
		;
	CASE "宣伝"
		PRINTL
		PRINTL 코트니
		SETCOLOR COLOR("ハートピンク")
		PRINTL 『냐아…』
		RESETCOLOR
		PRINTW (편집자 주기: 개다래나무 복용 중으로 인해 코멘트를 수록하지 못한 점 사과드립니다)
	CASE "リスト"
		RESULTS '= ICON_ADDRESS

		RESULTS:1 = 냐아…　　냐아아~~…
ENDSELECT
