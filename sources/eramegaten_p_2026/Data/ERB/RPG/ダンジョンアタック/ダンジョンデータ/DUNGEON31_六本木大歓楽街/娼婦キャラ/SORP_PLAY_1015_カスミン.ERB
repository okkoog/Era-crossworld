;カスミン(마유 가이아교도)
@SORP_PLAY_1015, ARGS
#DIMS DYNAMIC ICON_ADDRESS
ICON_ADDRESS = 70_カスミン
SELECTCASE ARGS
	CASE "娼婦番号"
		RESULTS = [1015]
	CASE "キャラ名"
	RESULTS = 카스민
	CASE "指名名"
	RESULTS = 카스민(마유 가이아교도)
	CASE "所属"
		;表なら1、裏なら2
		RETURN 1
	CASE "判定"
		;指名可能なら0、不可なら1
		;ミア身請け済なら出現
		CALL SORP_PLAY_1005, "判定"
		SIF !RESULT
			RETURN 1
		RETURN 0
	CASE "価格"
		RETURN 500
	CASE "紹介文"
		IF 六本木娼婦フラグ:15 == 0
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"과연, 카스민 양을 희망하십니까/인간이 어째서 이런 곳에서 일하고 있는 건가 싶으시겠지만/사실 우리끼리 이야기입니다만, 그녀는 반마랍니다"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"가이아 교회의 특별한 의식인가 뭔가로 악마가 씌어 있다고 하여/평범한 직업을 가질 수 없다고 하더군요/"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"저희 가게는 가이아교 계열 점포는 아닙니다만/문제는 발정과 경미한 파괴 충동이라고 하니/그쪽 방면 취향 손님께는 안성맞춤이라 저희 가게에서 고용하고 있는 참입니다"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"참고로 가슴은 원래부터 저 크기였다고 합니다/그런 부분도 역시 이 업계에선 포인트가 높으니까요/"
		ELSE
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"과연, 카스민 양입니까/손님, 취향이 딱 맞으셨던 모양이군요/"
		ENDIF
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"그럼, 카스민 양입니다만…/하룻밤에 ５００마카가 되겠습니다/"
	CASE "プレイ口上"
		CALL DUNGEON_WORP,1,13,3
		IF 六本木娼婦フラグ:15 == 0
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"카스민", @"칫！ 당신… 뒷세계 냄새가 나는군/이런 데서 뭘 하고 있는진 몰라도/날 창부로 지명한 이상 각오는 되어 있겠지？"
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"카스민", @"이 방에서는 내가 규칙이다！/내가 만족할 때까지 나갈 수 있을 거라 생각 마라！/"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"/＞즐겁게 놀았습니다…/"
			ダンジョンフラグ:31:15 = 1
		ELSE
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"카스민", @"칫！ 또 온 건가/이번엔 아픈 정도로 안 끝낼 거다？/"
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"카스민", @"그렇지！ 이 가슴으로 압살해 주마！/이걸 맛볼 수 있는 녀석은 흔치 않다고！/"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"/＞즐겁게 놀았습니다…/"
		ENDIF
		EXP:MASTER:절정경험 += (ABL:MASTER:마조끼 + 1) * 2
		EXP:MASTER:봉사쾌락경험 += (ABL:MASTER:마조끼 + 1) * 6
		EXP:MASTER:고통쾌락경험 += (ABL:MASTER:마조끼 + 1) * 6
		JUEL:MASTER:고통 += (ABL:MASTER:마조끼 + 1) * 300
		JUEL:MASTER:치정 += (ABL:MASTER:마조끼 + 1) * 200
		JUEL:MASTER:굴복 += (ABL:MASTER:마조끼 + 1) * 500
		JUEL:MASTER:공포 += (ABL:MASTER:마조끼 + 1) * 200
		JUEL:MASTER:욕정 += ABL:MASTER:마조끼 * (500) + 500
		IF !TALENT:MASTER:남자
			EXP:MASTER:레즈경험 += (ABL:MASTER:마조끼 + 1) * 2
		ENDIF
		IF TALENT:MASTER:남자 || TALENT:MASTER:후타나리
			EXP:MASTER:사정경험 += (ABL:MASTER:마조끼 + 1) * 2
			CALL CONTROL_MAG, MASTER, -(ABL:MASTER:마조끼 * 2000 + 1000)
		ENDIF
		IF TALENT:MASTER:모유체질
			EXP:MASTER:분유경험 += (ABL:MASTER:마조끼 + 1) * 2
			JUEL:MASTER:쾌Ｂ += (ABL:MASTER:마조끼 + 1) * 200
			CALL CONTROL_MAG, MASTER, -(ABL:MASTER:마조끼 * 2000 + 1000)
		ENDIF
		;CALL INCREASE_LC,10  意図が不明かつ変動量が強烈で、ユーザー側から認識できない場所での変動なので除外します。必要性があって再実装する場合は右記の点に注意して再実装してください。
	CASE "身受け価格"
		RETURN 99999
	CASE "身受け確認"
		;
	CASE "身受け口上"
		;
	CASE "宣伝"
		PRINTL
		PRINTL 카스민
		SETCOLOR COLOR("ハートピンク")
		PRINTL 『하아？ 광고용 코멘트？ 알 게 뭐야 그딴 거. 그쪽에서 알아서 지어내면 되잖아！』
		RESETCOLOR
		PRINTW (편집자 주기: 조금 거친 인상도 줍니다만, 잘 돌봐주는 분이라고 합니다)
	CASE "リスト"
		RESULTS '= ICON_ADDRESS

		;テキトーに捏造しました
		RESULTS:1 = 내 마유가 만족할 때까지 나갈 수 있을 거라 생각 마라！
ENDSELECT
