;エンジェル
@ADVANCE_DEMONIEZD_TYPE_3121, ARGS, ARG
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "アドバンスドタイプ"
		RESULTS = エンジェル
	CASE "해설"
		CALL MESSAGE_WINDOW_D , "남 점주" , "엔젤을 추가하는 거야?/그러면 파마와 정신에 강해질 거야"
		CALL MESSAGE_WINDOW_D , "남 점주" , "부작용으로 날개가 추가되고, 좀비화는 해제될 거야"
	CASE "チェック"
		IF TALENT:ARG:날개 == 1
			CALL MESSAGE_WINDOW_D , "남 점주" , "어머, 이 아이 벌써 날개가 있네/부위가 중복되면 과간섭이 발생해서 위험하니까 그만두렴"
			RETURN 0
		ELSEIF MAXBASE:ARG:파마 <= 0
			CALL MESSAGE_WINDOW_D , "남 점주" , "어머, 이 아이는 이 이상 파마에 강해질 수 없어/과잉강화하면 그릇이 견디지 못하니까 그만두렴"
			RETURN 0
		ELSEIF MAXBASE:ARG:정신 <= 0
			CALL MESSAGE_WINDOW_D , "남 점주" , "어머, 이 아이는 이 이상 정신에 강해질 수 없어/과잉강화하면 그릇이 견디지 못하니까 그만두렴"
			RETURN 0
		ENDIF
		RETURN 1
	CASE "確認"
		CALL MESSAGE_WINDOW_D , "남 점주" , "50000마카가 드는데/정말로, "+ CALLNAME:ARG + "에게 엔젤을 집어넣어도 괜찮겠어?"
	CASE "価格"
		;バランス未調整版のため、今だけ50マッカ
		;RETURN 50000
		RETURN 50
	CASE "アドバンスド実行"
		CSTR:ARG:종족명 = 천사
		MAXBASE:ARG:정신 -= 10
		BASE:ARG:정신 -= 10
		MAXBASE:ARG:파마 -= 10
		BASE:ARG:파마 -= 10
		IF MAXBASE:ARG:정신 < 0
			MAXBASE:ARG:정신 = 0
			BASE:ARG:정신 = 0
		ENDIF
		IF MAXBASE:ARG:파마 < 0
			MAXBASE:ARG:파마 = 0
			BASE:ARG:파마 = 0
		ENDIF
		TALENT:ARG:날개 = 1
		TALENT:ARG:좀비 = 0
ENDSELECT

