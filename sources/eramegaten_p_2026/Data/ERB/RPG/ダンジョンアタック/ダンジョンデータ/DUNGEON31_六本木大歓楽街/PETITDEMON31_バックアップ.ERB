			BASE:ARG:검격 = 0
		ENDIF
		IF MAXBASE:ARG:전격 < 0
			MAXBASE:ARG:전격 = 0
			BASE:ARG:전격 = 0
		ENDIF
		TALENT:ARG:거체 = 1
		TALENT:ARG:소인체형 = 0
		TALENT:ARG:유아체형 = 0
		TALENT:ARG:큰체형 = 0
		TALENT:ARG:날개 = 0
ENDSELECT


