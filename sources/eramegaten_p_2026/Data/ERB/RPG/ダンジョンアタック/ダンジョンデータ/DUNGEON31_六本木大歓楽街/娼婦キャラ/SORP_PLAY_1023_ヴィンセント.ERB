		IF 六本木娼婦フラグ予備1:23 >= 10
			IF 六本木娼婦フラグ予備1:23 == 10 || 六本木娼婦フラグ予備1:23 == 20
	RESULTS = 캐서린이라 자칭하는 여자
			ELSE
	RESULTS = 캐서린
			ENDIF
		ELSE
	RESULTS = 혼자 마시고 있는 남자
		ENDIF
	CASE "所属"
		;表なら1、裏なら2、援助なら3
		RETURN 3
	CASE "判定"
		;指名可能なら0、不可なら1
		SIF !IS_PLAYABLE_EXTRA_CHARA([[キャラ:빈센트]])
			RETURN 1
		IF 六本木娼婦フラグ:23 >= 3 
			RETURN 1
		ELSE
			RETURN 0
		ENDIF
	CASE "価格"
		IF 六本木娼婦フラグ予備1:23 >= 10
			RETURN 300
		ELSE
			RETURN 2
		ENDIF
	CASE "紹介文"
