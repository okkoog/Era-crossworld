;=======================================================================
;娼館の処理
;=======================================================================
;娼婦リスト
@SORP_LIST_NEW, ARG:0 = 1, ARG:1 = 1
#DIM LCOUNT, 2
#DIM TEMP
#DIM ADD_LENS
#DIMS VALUES
#DIMS L_ICON
#DIMS L_TEXT, 4
VARSET 六本木娼館商品リスト
;リストを作成
FOR LCOUNT,1001, (1000 + MAX_DUNGEON_31_FLAGS)
	CALL DU31_SORP_SELECTABLE, LCOUNT
	SIF !RESULT
		CONTINUE
	TEMP = FINDELEMENT(六本木娼館商品リスト, 0)
	六本木娼館商品リスト:TEMP = LCOUNT
NEXT
FOR LCOUNT, 六本木娼館選択ページ * 六本木娼館リスト表示数, (六本木娼館選択ページ + 1) * 六本木娼館リスト表示数
	VARSET L_TEXT
	TEMP = 六本木娼館商品リスト:LCOUNT
	IF TEMP
		VARS L_FACE
		CALLFORM SORP_PLAY_{TEMP}, "指名名"
		L_TEXT:0 = [{TEMP, 4}] %RESULTS%
		RESULTS '= ""
		RESULT_F = 0
		CALLFORM SORP_PLAY_{TEMP}, "リスト"
		IF SPRITECREATED(RESULTS)
			L_ICON '= @"<img src = '%RESULTS%' height = '400'>"
		ELSE
			L_ICON '= " " * 8
		ENDIF
		L_TEXT:2 = 　　　…　%RESULTS:1%　…
		FOR LCOUNT:1, 0, 4
			ADD_LENS = 0
			;TAGのぶんの字数を調整する
			SIF STRCOUNT(L_TEXT:(LCOUNT:1), "<i>")
				ADD_LENS += 7
			L_TEXT:(LCOUNT:1) = %SET_BUTTON_TAG(@"%L_TEXT:(LCOUNT:1), 90 + ADD_LENS, LEFT%", TOSTR(TEMP))%
		NEXT
		{
		HTML_PRINT 	"<p align = 'CENTER'>"
					+ L_ICON + L_TEXT:0
					+ "<br>" + " " * 8 + L_TEXT:1
					+ "<br>" + " " * 8 + L_TEXT:2
					+ "<br>" + " " * 8 + L_TEXT:3
					+ "</p>"
		}
	ELSE
		PRINTL 
		PRINTL 
		PRINTL 
		PRINTL 
	ENDIF
NEXT
RETURN 0

;身受け可能数
@SORP_CAN_BUY_COUNT_NEW, ARG
#DIM LCOUNT
LCOUNT = 0
LOCAL = 0
FOR LOCAL,1001, (1000 + MAX_DUNGEON_31_FLAGS)
	;所属している娼館
	TRYCALLFORM SORP_PLAY_{LOCAL}, "所属"
	SIF RESULT != ARG
		CONTINUE
	;指名できるか
	TRYCALLFORM SORP_PLAY_{LOCAL}, "判定"
	SIF RESULT == 1
		CONTINUE
	;身受けの場合、身請け可能フラグがあるもののみ
	SIF 六本木娼婦フラグ:(LOCAL-1000) != 2
		CONTINUE
	LCOUNT++
NEXT
RETURN LCOUNT

