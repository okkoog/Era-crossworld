;롯폰기대환락가
;娼館関連

;ファイルが肥大化してきていると思われたため、分割
;また、共通化できそうな部分を一本化
;全員身受けしちゃうとちょっと寂しくなるため、明日以降は代理キャラが働くように対応
;裏娼館にランダムキャラ捕獲の窓口を追加
;20/05/08　身受けキャラの能力を底上げ。即娼館に突っ込んで即戦力として使えるレベルに
;21/03/07　娼婦キャラの追加サンプルを作成。及びキャラ追加の手順等を記載
;21/06/24　魔乳に対応
;21/10/29　娼婦追加をもっとお手軽にできるようにソース改修。娼婦をキャラ別にファイル分割。ダンジョンフラグではなくERHのフラグに移設
;22/06/04　客引きを拡張
;22/08/16　遊ぶときも身請けの時もこっちでマイナスするように（娼婦ファイル側でマッカのやり取りは基本しないように）
;22/12/10　AI製顔グラを追加しました、娼婦を選ぶ際にもリストに顔グラが表示されるよう修正
;フラグ管理メモ
;59　ランダムキャラ捕獲窓口用　0:利用してない　1:利用経験あり　2:今日利用した

;(21/10/29　ERH化して使用しなくなるフラグ)(参考用に残すけど、削除してもおｋ)
;10　창관(女)利用経験フラグ　0:利用してない　1:利用した　2:クーポンあり
;10番台　창관(女)用フラグ　0:その子を指名したことない　1:指名したことある　2:指名経験あり、あなたの技術が十分で身請け可能に　3:あなたに身請けされた　4:代理キャラ出勤　5:代理キャラ指名経験あり
;50　裏路地娼館利用フラグ　0:利用してない　1:利用した　2:クーポンあり
;50番台　창관(女)用フラグ　0:その子を指名したことない　1:指名したことある　2:指名経験あり、あなたの技術が十分で身請け可能に　3:あなたに身請けされた
;80番台　娼館用フラグ2　

;=======================================================================
;娼婦キャラの追加の手順(新版)
;=======================================================================
;1,SORP_PLAY_XXX_(テンプレート用、顔グラ表示用に修正済).ERB をコピーして、新規キャラ用のファイルを用意
;2,SORP31.ERHなどから、使用していない娼婦フラグの番号を採番し、1.のファイルのXXを娼婦フラグ番号で置換
;(出来たら、使用する娼婦フラグ番号と名前をERHに追記しておくと、後の人が作りやすいかも？)
;3,ファイルのコメントアウト等を削除し、各項目を埋めて娼婦キャラを作成
;4,完成した3のファイルを娼婦フォルダに移動
;5,キャラ追加完了！(顔グラは無しでも可ですが、できたら好みの顔グラと画像CSVを作成しましょう)
;
;(娼婦キャラ作成メモ)
;ベースとなる悪魔にユニークなカスタマイズを施してキャラを水増しするシステムです。上手い事使ってください
;娼館用なので、基本的に非処女系のキャラと考えておく
;また、出現条件や身受け条件は各自でよく考えること。最低限、初日で身受けできない程度は必須！
;プレイ金額は200～2000ぐらい、身受け金額は2000～5000ぐらい、のフィーリングで
;体力気力や能力は、自宅の娼館や便器にそのまま投入できる程度には盛って良い(と個人的には思っている)
;でも5以上の値はなるべく自重すること

;=======================================================================
;창관(基本部分は一本化)
;=======================================================================
@SORP_BASE_31, ARG
#DIMS TEMPS
;CALL SHOW_PICTURE, "D"
六本木娼館ナンバー = 0
IF ARG == 10
	六本木娼館ナンバー = 1
	受付アイコンアドレス = 16_受付の男表
ELSE
	六本木娼館ナンバー = 2
	受付アイコンアドレス = 15_受付の男裏
ENDIF
CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"어서 오십시오//"
IF (六本木娼館表フラグ:0 == 0 && 六本木娼館ナンバー == 1) || (六本木娼館裏フラグ:0 == 0 && 六本木娼館ナンバー == 2)
	$SORP_INFO
	IF (六本木娼館表フラグ:0 == 0 && 六本木娼館ナンバー == 1) || (六本木娼館裏フラグ:0 == 0 && 六本木娼館ナンバー == 2)
		;初回時
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"어라, 손님께선 저희 가게 이용이 처음이시군요/그렇다면 저희 가게의 규칙을 설명해 드리겠습니다/"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"손님께선 다행히 악마에 대해 알고 계신 듯하니/숨김없이 말씀드리도록 하겠습니다/"
	ELSE
		;説明時
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"알겠습니다, 그럼 설명해 드리겠습니다//"
	ENDIF
	CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"저희 가게는 악마 아가씨들과 하룻밤의 꿈을 꾸기 위한 가게입니다/그리고 모두 인간으로서는 얻기 힘든 많은 경험을 쌓아두었습니다/그렇기에 손님께서도 귀중한 경험을 얻으실 수 있겠지요"
	IF 六本木娼館ナンバー == 2
		;창관(裏)の場合
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"또한 저희 가게 아가씨들은 모두 극히 특수합니다/그 점을 부디 양해해 주시기 바랍니다/"
	ENDIF
	CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"물론 이를 위해서는 마카가 필요합니다/일본 엔화로의 지불은 받지 않고 있으니/부디 양해 부탁드립니다"
	CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"또한 저희 가게에서는 일부 아가씨들에 대해 「낙적(신원 인수)」도 허가하고 있습니다/이 경우 그 아가씨는 귀하의 소유가 됩니다/두말할 나위도 없겠지만 그 아가씨와는 더 이상 저희 가게에서 놀 수 없게 되니 주의해 주십시오"
	;Ｎｏ.１なら現状が一番でしょ…という技術力的問題の隠蔽
	IF 六本木娼館ナンバー == 2
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"또한 본 서비스는 손님과 아가씨가 동의한 경우에만 유효합니다/따라서 신원 인수를 거부하고 있는 아가씨는 낙적할 수 없습니다/저희 가게에선 현재 No.1인 피아가 낙적되는 것을 거부하고 있습니다"
	ELSE
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"또한 본 서비스는 손님과 아가씨가 동의한 경우에만 유효합니다/따라서 신원 인수를 거부하고 있는 아가씨는 낙적할 수 없습니다/저희 가게에선 현재 No.1인 조세핀이 낙적되는 것을 거부하고 있습니다"
	ENDIF
	CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"그럼 마지막으로 저희 가게의 규칙을 정리해 드리겠습니다//"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", ,"", @"1：여기서는 마카를 지불하여 당신의 구슬과 경험을 얻을 수 있다/2：아가씨에 따라 얻을 수 있는 구슬과 경험이 다르다/3：거액의 마카를 지불하여 낙적할 수도 있다/4：당연히 낙적한 아가씨와는 여기서 더 이상 놀 수 없다"
	CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"이상입니다//"
	SIF 六本木娼館表フラグ:0 == 0 && 六本木娼館ナンバー == 1
		六本木娼館表フラグ:0 = 1
	SIF 六本木娼館裏フラグ:0 == 0 && 六本木娼館ナンバー == 2
		六本木娼館裏フラグ:0 = 1
ENDIF

$BRO_LOOP_W
CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"그럼 오늘은 어떻게 하시겠습니까？//"
VARS L_SELECT
L_SELECT '= "[1] 아가씨와 논다"
L_SELECT += "/[2] 아가씨를 낙적한다"
L_SELECT += "/[3] 설명을 듣는다"
SIF 六本木娼館ナンバー == 2 && イベントフラグ:88:0 > 2
	L_SELECT += "/[4] 암호를 말한다"
L_SELECT += "/[0] 그만둔다"
CALL INPUT_SELECT_D, L_SELECT , , , 2, 4

IF RESULT == 3
	;説明を聞く
	GOTO SORP_INFO
ELSEIF RESULT == 1
	;プレイ
	CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"그럼 이쪽 아가씨들 중에서 골라주십시오…"
	$BRO_LOOP_W_1
	;商品のリスト選択
	CALL DU31_SELECT_SORP_GOODS, 1
	IF RESULT == 0
		CALL SHOW_PICTURE, "D"
		;やめる
		GOTO BRO_LOOP_W
	ENDIF
	LOCAL = RESULT

	CALLFORM SORP_PLAY_{LOCAL}, "紹介文"
	CALLFORM SORP_PLAY_{LOCAL}, "確認"
	IF 六本木娼館ナンバー == 1 && 六本木娼館表フラグ:0 == 2 && LOCAL != 1001
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"어라, 손님. 쿠폰권을 가지고 계셨군요/그렇다면 200마카로 노실 수 있습니다/"
		RESULT = 200
	ELSEIF 六本木娼館ナンバー == 2 && 六本木娼館裏フラグ:0 == 2 && LOCAL != 1008
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"어라, 손님. 쿠폰권을 가지고 계셨군요/그렇다면 200마카로 노실 수 있습니다/"
		RESULT = 200
	ELSE
		CALLFORM SORP_PLAY_{LOCAL}, "価格"
	ENDIF
	IF MONEY:1 < RESULT
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"…손님, 아무래도 마카가 부족하신 모양이군요/그래서야 어찌할 도리가 없습니다/다른 아가씨를 골라주십시오…"
		GOTO BRO_LOOP_W_1
	ENDIF
	CALLFORM SORP_PLAY_{LOCAL}, "キャラ名"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"%RESULTS%와(과) 노시겠습니까？//"
	CALL INPUT_YN_D , "논다" , "다른 아가씨로 한다"
	IF RESULT == 0
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"그럼 저쪽 개인실에서 잠시만 기다려주십시오…//"
		CALL SHOW_PICTURE, "D"
		IF 六本木娼館ナンバー == 1 && 六本木娼館表フラグ:0 == 2 && LOCAL != 3111
			RESULT = 200
			六本木娼館表フラグ:0 = 1
		ELSEIF 六本木娼館ナンバー == 2 && 六本木娼館裏フラグ:0 == 2 && LOCAL != 3151
			RESULT = 200
			六本木娼館裏フラグ:0 = 1
		ELSE
			CALLFORM SORP_PLAY_{LOCAL}, "価格"
		ENDIF
		;料金徴収
		MONEY:1 -= RESULT
		CALLFORM SORP_PLAY_{LOCAL}, "プレイ口上"
		IF 六本木娼館ナンバー == 1
			CALL DUNGEON_WORP,1,15,6
		ELSE
			CALL DUNGEON_WORP,2,6,14
		ENDIF
	ELSE
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"그렇습니까/그럼 다른 아가씨를 골라주십시오/물론 다른 아가씨 이야기를 들은 뒤 %RESULTS% 양을 고르셔도 상관없습니다"
		GOTO BRO_LOOP_W_1
	ENDIF
ELSEIF RESULT == 2
	;身受け
	IF CHARANUM >= MAX_PLAYER_CHARA - 5
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "낙적한 창녀를 보유해 둘 여유가 없다…/동료마의 수를 줄일 필요가 있다…"
	ELSE
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"호오, 아가씨를 낙적하시려는 건가요/손님, 아가씨들에게 반하셨나 보군요/"
		CALLFORM SORP_CAN_BUY_COUNT_NEW, 六本木娼館ナンバー
		LOCAL = RESULT
		IF LOCAL == 0
			CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"하지만 지금 현재는 손님께 낙적되어도 좋다는 아가씨가 없습니다/저희 가게에서 당분간 친분을 더 쌓으시는 편이 좋을 듯합니다/"
			GOTO BRO_LOOP_W
		ENDIF
		$BRO_LOOP_W_2
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"현재 손님께 낙적되어도 좋다고 하는 아가씨는 이쪽이 됩니다/부디 납득이 갈 때까지 골라주십시오/"
		;商品のリスト選択
		CALL DU31_SELECT_SORP_GOODS, 2
		IF RESULT == 0
			CALL SHOW_PICTURE, "D"
			;やめる
			GOTO BRO_LOOP_W
		ENDIF
		LOCAL = RESULT
		CALLFORM SORP_PLAY_{LOCAL}, "身受け確認"
		CALLFORM SORP_PLAY_{LOCAL}, "身受け価格"
		IF MONEY:1 < RESULT
			CALLFORM SORP_PLAY_{LOCAL}, "キャラ名"
			CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"…손님, 마카가 부족합니다/그래서야 %RESULTS% 양을 낙적하실 수 없습니다"
			GOTO BRO_LOOP_W_2
		ENDIF
		CALL INPUT_YN_D , "낙적한다" , "다른 아가씨로 한다"
		IF RESULT == 0
			;このタイミングで身請け価格をいただきます
			CALLFORM SORP_PLAY_{LOCAL}, "身受け価格"
			MONEY:1 -= RESULT
			CALLFORM SORP_PLAY_{LOCAL}, "キャラ名"
			CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"알겠습니다/그럼 잠시만 기다려주십시오/%RESULTS% 양 본인을 불러 이야기를 전해야 하므로…"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			VARSET RESULT
			CALLFORM SORP_PLAY_{LOCAL}, "身受け口上"
			VARS L_FACE
			L_FACE '= RESULTS
			CALL ADD_NEW_COMPANION, RESULT, RESULT:1, RESULT:2, , , MIN(BASE:MASTER:LV, CSVBASE(RESULT, GETNUM(BASE, "LV")))
			;共通処理
			VARI L_CHARA = RESULT:1
			CFLAG:L_CHARA:초기LV = 1
			CFLAG:L_CHARA:피조교횟수 = 1
			CFLAG:L_CHARA:매각가능 = 2
			CFLAG:L_CHARA:의존도 = 1000
			IF IS_LESBIAN(MASTER, L_CHARA)
				EXP:L_CHARA:레즈경험 += 100
				ABL:L_CHARA:레즈끼 += 1
			ENDIF
			CALLF SET_ALL_FACE_NEW, L_CHARA, L_FACE

			CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"그럼…/이후의 일은 저희는 일절 관여하지 않습니다/부디 행복하시길…"
			IF 六本木娼館ナンバー == 1
				CALL DUNGEON_WORP,1,15,6
			ELSE
				CALL DUNGEON_WORP,2,6,14
			ENDIF
		ELSE
			GOTO BRO_LOOP_W_2
		ENDIF
	ENDIF
ELSEIF RESULT == 4 && 六本木娼館ナンバー == 2
	IF ダンジョンフラグ:31:59 == 0
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"…손님, 어디서 그걸？//"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"아닙니다, 캐묻는 건 그만두지요/이 업계는 입이 무거워야 오래 살아남는 법이니까요/"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"이쪽으로 오십시오…//"
	ELSE
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"알겠습니다. 이쪽으로 오십시오…//"
	ENDIF
	CALL SHOW_PICTURE, "EMPTY"
	CALLFORM PRISON_BASE_31
	CALL SHOW_PICTURE, "EMPTY"
	CALL DUNGEON_WORP,2,6,14
ELSE
	CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, , "접수원 남자", @"그럼 다음 이용을 기다리고 있겠습니다//"
	IF 六本木娼館ナンバー == 1
		CALL DUNGEON_WORP,1,15,6
	ELSE
		CALL DUNGEON_WORP,2,6,14
	ENDIF
ENDIF

;=======================================================================
;地下留置所の処理
;=======================================================================
@PRISON_BASE_31
#DIM CHARA, 1

IF ダンジョンフラグ:31:59 == 0
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞창관은 지하 유치장과 연결되어 있던 모양이다！//"
