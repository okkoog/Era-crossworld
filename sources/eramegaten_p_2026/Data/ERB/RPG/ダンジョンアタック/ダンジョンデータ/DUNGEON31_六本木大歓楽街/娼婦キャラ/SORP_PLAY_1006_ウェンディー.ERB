;ウェンディー(리림)
;リリム(偽典より)
;(リリム、普通に一般的なリリムのイメージ)
@SORP_PLAY_1006, ARGS
#DIM CHARA, 1
#DIM CONST CSV_NO = [[キャラ:웬디]]
#DIMS DYNAMIC ICON_ADDRESS
ICON_ADDRESS '= D31_FACE("ウェンディー")
