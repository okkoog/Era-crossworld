@SORP_PLAY_1003, ARGS
#DIM CHARA, 1
#DIM CONST CSV_NO = [[キャラ:나뷔]]
#DIMS DYNAMIC ICON_ADDRESS
ICON_ADDRESS '= D31_FACE("ナヴィ")
SELECTCASE ARGS
	CASE "娼婦番号"
		RESULTS = [1003]
	CASE "キャラ名"
		RESULTS = 나비
	CASE "指名名"
		RESULTS = 나비(요목의 악마인)
	CASE "所属"
		;表なら1、裏なら2
		RETURN 1
	CASE "判定"
		;指名可能なら0、不可なら1
		SIF GETCHARA(CSV_NO) >= 0
			RETURN 1
		SIF 六本木娼婦フラグ:3 >= 3
			RETURN 1
		RETURN 0
	CASE "価格"
		RETURN 500
	CASE "紹介文"
		IF 六本木娼婦フラグ:3 == 0
			CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"과연, 나비 양을 원하십니까/밖에서 보셨을 때 마음에 드셨나 보군요/"
			CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"그녀는 보시다시피 알라우네 악마인입니다/장미 열매보다 훨씬 풍성하게 여문 풍만한 가슴이 매력적이지요/본인이 말하길 상대가 가슴만으로 녹아내리는 게 불만일 정도라고 합니다"
			CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"하지만 그녀는 나무 정령의 피를 이어받은 자입니다/남녀 상관없이 손님의 MAG를 평소 이상으로 흡수할 것으로 생각됩니다/부디 기진맥진하지 않도록 주의해 주십시오…"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"과연, 나비 양인가요/손님, 아무래도 나비 양의 마음에 드신 모양이군요//"
		ENDIF
