;りんご(外道メスガキ)
;キャラ追加(新版)のサンプルキャラその2
;絶対まけないメスガキ(負けないとは言ってない)
;	Edit	Date			Author					Reason
;	001		20XX/XX/XX		っとっとき				新規作成
;	002		20XX/XX/XX		XXX						AI製顔グラ対応
;	003		2023/10/20		っとっとき				ハートマーク部分の記述を訂正
;	004		2024/04/16		っとっとき				ビデオタイトル対応

@SORP_PLAY_1018, ARGS
#DIM CHARA, 1
#DIM CONST CSV_NO = [[キャラ:링고]]
#DIMS DYNAMIC ICON_ADDRESS
ICON_ADDRESS '= D31_FACE("りんご")
SELECTCASE ARGS
	CASE "娼婦番号"
		RESULTS = [1018]
	CASE "キャラ名"
	RESULTS = 링고
	CASE "指名名"
		IF 六本木娼婦フラグ:18 == 0
	RESULTS = 링고(인간？)
		ELSE
	RESULTS = 링고(외도 메스가키)
		ENDIF
	CASE "所属"
		;表なら1、裏なら2
		RETURN 2
	CASE "判定"
		;指名可能なら0、不可なら1
		;(キャラ的にオトコ前提。ロリハーレムまたは娘ハーレムED到達、または大業物が必要)
		SIF 六本木娼婦フラグ:18 >= 3
			RETURN 1
		SIF !TALENT:MASTER:남자
			RETURN 1
		SIF !(GETBIT(FLAG:발견ED,5) || GETBIT(FLAG:발견ED,6) || TALENT:MASTER:크고아름다움)
			RETURN 1
		RETURN 0
	CASE "価格"
		RETURN 300
	CASE "紹介文"
		IF 六本木娼婦フラグ:18 == 0
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"과연, 링고 양을 희망하십니까/……응？ 어라라？？/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞자세히 보니 글씨가 손글씨다…/군데군데 아이다운 필체도 보인다/"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"죄송합니다. 아무래도 장난인 모양이군요/실은 최근, 부랑아…/아니, 스트리트 칠드런 마냥 제멋대로 눌러앉은 꼬마 녀석이 있어서 말이죠…"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"아아, 아이라고 해도 실체는 악마입니다/「어른을 개로 조교하며 노는 꼬마」라는 소문을 아십니까？/그런 소문에서 실체화된 괴이라고 하더군요"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"요즘은 유독 기고만장해졌다고 해야 할지/눈에 거슬려 곤란하던 참이었습니다…/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞과연…/그렇다면 매운맛을 좀 보여주는 게 좋은 약이 될지도 모른다…/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞이 장난질을 역이용해서/이런 짓을 벌이면 어떻게 되는지 본인에게 뼈저리게 체험시켜 주는 건 어떨까？/하고, 당신은 제안했다"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"…흠, 나쁘지 않군요？/그렇다면 골탕 먹일 겸 이대로 안내해 드리겠습니다/"
		ELSE
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"과연, 링고 양입니까/…여전히 정신을 못 차린 모양이군요/"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"하지만 적혀 있다고 신나서 지명하시는 손님도 참 대단…/…아니, 꽤나 좋은 취향이시군요, 라고만 해두지요/"
		ENDIF
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"그럼, 링고 양입니다만…/글쎄요, ３００마카는 어떠십니까？/"
	CASE "プレイ口上"
		CALL DUNGEON_WORP,2,5,10
		;条件によって分岐の追加も可
		IF 六本木娼婦フラグ:18 == 0
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞나타난 것은 초등학생 정도 되어 보이는 건방진 꼬맹이였다/란도셀이라도 메워놓으면 꽤나 잘 어울릴 것 같다/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"꺄아%ハート()% 로리콘 아저씨다아%ハート()%/모처럼 놀러 왔는데에, 튀어나온 게 애라서 실망했겠네에%ハート()%/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"그 나이 먹고 여친도 없어어？ 푸흡！ 아저씨 불쌍해라~%ハート()%/저기 저기！ 화났어？ 삐졌어어？/나 같은 꼬맹이한테 바보 취급 당하니까 부끄럽지이%ハート()%"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞남을 놀려먹고 싶어 안달이 난 모양이다…/우열을 가려 자기가 상위에 있다고 과시하고 싶은 시기라는 녀석이다/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞이런 류의 악마는 꽤 많다…/당신에게는 오히려 다루기 쉬운 상대라 할 수 있겠다/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"아하%ハート()% 애 상대로 발끈해버린 거야아？ 어른 주제에에%ハート()%/징그러~워%ハート()% 메롱이다！ 허접 허접 허~접%ハート()%/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞자, 이 허세가 어디까지 이어질지… 솜씨를 한번 보도록 할까//"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞30분 후//"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"이, 이런 허접 좆%ハート()% 따위에에 절대 안 느껴어%ハート(2)%/아저씨 어른답지 못해애%ハート()% 꼬맹이 상대로오%ハート()% 진심으로 허리 흔들고오%ハート(2)%/이런 거 강가안%ハート()% 강간이라구우%ハート()% 진짜 위험한 범죄자%ハート()% 확정이네에%ハート(2)%"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞1시간 후//"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"%ハート(3)%……저, 정액 뜨거어%ハート()% 어른 사정은 반칙이야아%ハート(3)%/이런 거 절대로오%ハート()% 애한테 싸지르면 안 돼애 자격 박탈이야아%ハート(2)%……/박탈이라 했는데에 왜 안 멈추는 거야아%ハート()% 나… 망가져버려어%ハート(2)%"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞2시간 후//"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"대다…내……%ハート()% 윽…%ハート()% 으응……%ハート(3)%/읏읏%ハート(2)% 아아~~앙%ハート(3)%/"
			CALL SHOW_PICTURE, "EMPTY"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"아저씨…%ハート()% 내 첫 경험 꼬맹이 구멍%ハート(2)% 기분 좋았어어…？/어른 좆%ハート()% 뷰릇뷰릇 싼 아저씨 패배애%ハート(2)%/내가 이겼다아%ハート()%"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"패배한 아저씨는 한 번 더%ハート()% 뷰릇뷰릇%ハート()% 안 하면 안 돼애%ハート(2)%/더어 내 꼬맹이 구멍%ハート()% 기분 좋게 만들어어%ハート(3)%/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞몸 쪽은 거의 참교육을 완료시켰지만, 항복 선언은 받아내지 못했다…/뭐 조금은 질려서 얌전해지기를 빌어보자/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞「다음에 또 보자고？」라고 한마디 던져주고, 당신은 방을 나섰다…//"
			;経験フラグを設定
			六本木娼婦フラグ:18 = 1
		ELSE
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"꺄아%ハート()% 로리콘 아저씨 또 왔다아%ハート()%/허접 좆으로 몇 번이나 사정%ハート()%해준 내가 잊혀지지 않았던 거야아？/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"나 같은 꼬맹이%ハート()%가 아니면 승산이 없으니까아%ハート()%/그런데도 지난번에 못 이겼었지이%ハート()%/푸흡！ 아저씨 불쌍해라~%ハート()%"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"저기 저기！ 설욕전 하게 해줄 수도 있어어%ハート()%/아, 핸디캡이라도 줄까나아？ 안 그러면 불공평%ハート()%하니까 말야아%ハート(2)%/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"어른은 꼬맹이 따위에게 절대 안 진다%ハート()%는 걸, 가르쳐줘도 괜찮다구우？/난 절대 안 질 테지만 말야아%ハート()%/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞아무래도 지난번의 꼴사나운 꼴은 없었던 일로 친 모양이다…/아무래도 또다시 참교육이 필요한 모양이다/"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"아저씨 패배애%ハート()% /뷰릇뷰릇 쌌으니까 패배인 거야아%ハート(2)%/잔뜩 잔뜩 가버렸지만…%ハート()% 내 승리야아%ハート(3)%"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"어른 좆 조아아%ハート(2)% 아저씨 제일 조아아%ハート(3)%/더어 내 꼬맹이 구멍%ハート()% 잔뜩 범해주지 않으면 안 돼애%ハート(3)%/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞거의 패배 선언이나 다름없지만, 역시 패배만큼은 절대 인정하지 않는 듯하다…/차라리 깊은 늪에 빠져든 것처럼 보인다/어느 타이밍엔가 이쪽에서 져주는 척을 해야 할지도 모르겠다…"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞「다음에 또 보자고？」라고 한마디 던져주고, 당신은 방을 나섰다…//"
			;見受け可能フラグを設定
			六本木娼婦フラグ:18 = 2
		ENDIF
		;プレイ経験(任意の経験を追加可)
		;正直ここはテキトーにコピペ
		EXP:MASTER:삽입경험 += ABL:MASTER:기교 * 2 + 1
		EXP:MASTER:절정경험 += ABL:MASTER:기교
		JUEL:MASTER:습득 += ABL:MASTER:기교 * (1000) + 1000
		IF TALENT:MASTER:남자 || TALENT:MASTER:후타나리
			EXP:MASTER:질사경험 += ABL:MASTER:기교 * 3 + 1
			EXP:MASTER:사정경험 += ABL:MASTER:기교 * 7 + 1
			CALL CONTROL_MAG, MASTER, -(ABL:MASTER:기교 * 5000 + 3000)
		ENDIF
		;CALL INCREASE_LC,5  意図が不明かつ変動量が強烈で、ユーザー側から認識できない場所での変動なので除外します。必要性があって再実装する場合は右記の点に注意して再実装してください。
	CASE "身受け価格"
		RETURN 10000
	CASE "身受け確認"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"링고 양을 신원 인수하시겠습니까？/뭐, 반쯤 길거리 부랑아 같은 처지였으니…/보호자가 되어주신다면 저희로서도 큰 도움이 됩니다"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"그럼 １００００마카를 받게 됩니다만… 아아, 무슨 말씀인지 압니다/실은 장난 피해가 꽤 극심해서 말이지요…/어느 귀빈 손님에 대한 위자료를 가게에서 대납해 준 터라 까놓고 말해 빚을 얹어둔 셈입니다"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"그래서, １００００마카입니다만, 괜찮으시겠습니까？//"
	CASE "身受け口上"
		;口上
		CALL SHOW_PICTURE, "D"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"아！ 아저씨이~%ハート()% 얘기 들었다구우？/못 이긴 건 환경 탓%ハート()%인 거지이%ハート()%/원정에선 못 이기니까%ハート()% 홈에서 승부%ハート()%하고 싶다는 거지이%ハート()%"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"하지만 아저씨라면 어디서든 사정%ハート()%해버릴 거잖아아？/그야 원래부터 허접 좆%ハート()%에 허리나 흔드는 멍멍이%ハート()%니까 말야아%ハート(2)%/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"이거 나한테 길러지고 싶다%ハート()%는 거 맞지이%ハート()%/응응！ 다 알고 있어어%ハート()% 매일매일 정성껏 보살펴%ハート(2)%줄 테니까아%ハート()%/일단 처음엔 목줄부터%ハート()% 채워야겠지이%ハート()%"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"링고", @"앞으로도%ハート()% 잘 부탁해에%ハート(2)%//아·저·씨%ハート(3)%"
		六本木娼婦フラグ:18 = 3
		RESULTS '= "りんご" + "_" + D31_FACE("りんご", 1)
		RETURN CSV_NO, 3000, 0
	CASE "宣伝"
		;(なし)
	CASE "リスト"
		CALLF 顔グラ追加_F, CSV_NO
		RESULTS '= "りんご" + "_" + D31_FACE("りんご", 1)

		RESULTS:1 = <i>내가 이겼다아！</i>
		;手書き表現のため、斜体に設定
ENDSELECT

