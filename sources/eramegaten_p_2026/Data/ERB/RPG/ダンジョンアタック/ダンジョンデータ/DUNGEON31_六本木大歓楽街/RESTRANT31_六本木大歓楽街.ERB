$REST_LOOP
CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, "05_レストラン", "노출한 웨이트리스", @"어서 오세요~/그럼~/오늘은 어떻게 하시겠어요~？"
CALL INPUT_SELECT_D, "[1]요리를 먹는다/[2]설명을 듣는다/[3]원조한다/[4]테이크아웃(신원 인수)/////[0]그만둔다" , , , 4
SELECTCASE RESULT
	CASE 2
		;説明を聞く
		GOTO RESTRANT_INFO
	CASE 0
		CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:0, "05_レストラン", "노출한 웨이트리스", @"감사합니다~//"
		CALL DUNGEON_WORP,2,14,1
	CASE 1
		;食事
		CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, "05_レストラン", "노출한 웨이트리스", @"그럼~/오늘의 메뉴는 이쪽인데요~/어떻게 하시겠어요~？"
		$REST_LOOP_1
		CALLFORM RESTRANT31_MENU_LIST
		IF RESULT == 0
			;やめる
			GOTO REST_LOOP
		ELSE
			CALLFORM RESTRANT31_MENU, RESULT, 給仕アイコンアドレス:0
			CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, "05_レストラン", "노출한 웨이트리스", @"손님~/다른 주문은~/있으신가요~？"
			GOTO REST_LOOP_1
		ENDIF
	CASE 3
		;仲介
		CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, "05_レストラン", "노출한 웨이트리스", @"희망하는 여자아이는~/이쪽이랍니다~/"
		$REST_LOOP_2
		;商品のリスト選択
		CALL DU31_SELECT_SORP_GOODS, 1
		IF RESULT == 0
			CALL SHOW_PICTURE, "D"
			;やめる
			GOTO REST_LOOP
		ENDIF
		LOCAL = RESULT
		;CALLFORM SORP_LIST_NEW, 1, 3
		;IF RESULT == 0
		;	;やめる
		;	GOTO REST_LOOP
		;ELSE
		;	LOCAL = 0
		;	LOCAL = RESULT
		;ENDIF
		CALLFORM SORP_PLAY_{LOCAL}, "紹介文"
		CALLFORM SORP_PLAY_{LOCAL}, "確認"
		CALLFORM SORP_PLAY_{LOCAL}, "価格"
		IF MONEY:1 < RESULT
			CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:0, "05_レストラン", "노출한 웨이트리스", @"손님~/마카가 부족해요~/"
			GOTO REST_LOOP_2
		ENDIF
		CALLFORM SORP_PLAY_{LOCAL}, "キャラ名"
		CALL INPUT_SELECT_D, "" + RESULTS + "을(를) 원조하시겠습니까？////[0]원조한다/[1]다른 아이로 한다" , , , 2
		;CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "05_レストラン", "", @"%RESULTS%を援助しますか？"
		;CALL INPUT_YN_D , "援助する" , "他の娘にする"
		SELECTCASE RESULT
		CASE 0
			CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, "05_レストラン", "노출한 웨이트리스", @"그럼~/저쪽 개인실에서 기다려주세요~/"
			CALL SHOW_PICTURE, "D"
			CALLFORM SORP_PLAY_{LOCAL}, "価格"
			MONEY:1 -= RESULT
			CALLFORM SORP_PLAY_{LOCAL}, "プレイ口上"
			CALL DUNGEON_WORP,2,14,1
		CASEELSE
			CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, "05_レストラン", "노출한 웨이트리스", @"다른 희망하는 여자아이는~/있으신가요~？/"
			GOTO REST_LOOP_2
		ENDSELECT
	CASE 4
		;お持ち帰り
		CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, "05_レストラン", "노출한 웨이트리스", @"여자아이의~/테이크아웃이신가요~？/"
		CALLFORM SORP_CAN_BUY_COUNT_NEW, 3
		LOCAL = RESULT
		IF LOCAL == 0
			CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, "05_レストラン", "노출한 웨이트리스", @"안타깝지만 테이크아웃을 희망하는 여자아이가 없어요~/저희 가게는 어디까지나 중개라서요~/여자아이의 동의가 없으면 데려가실 수 없답니다~"
			GOTO REST_LOOP
		ENDIF
		$REST_LOOP_3
		;商品のリスト選択
		CALL DU31_SELECT_SORP_GOODS, 2
		IF RESULT == 0
			CALL SHOW_PICTURE, "D"
			;やめる
			GOTO REST_LOOP
		ENDIF
		LOCAL = RESULT
		CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, "05_レストラン", "노출한 웨이트리스", @"테이크아웃을 희망하는 여자아이는~/다음과 같답니다~/"
		;CALLFORM SORP_LIST_NEW, 2, 3
		;IF RESULT == 0
		;	;やめる
		;	GOTO REST_LOOP
		;ELSE
		;	LOCAL = 0
		;	LOCAL = RESULT
		;ENDIF
		CALLFORM SORP_PLAY_{LOCAL}, "身受け確認"
		CALLFORM SORP_PLAY_{LOCAL}, "身受け価格"
		IF MONEY:1 < RESULT
			CALLFORM SORP_PLAY_{LOCAL}, "キャラ名"
			CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, "05_レストラン", "노출한 웨이트리스", @"손님~/마카가 부족해요~/"
			GOTO REST_LOOP_3
		ENDIF
		CALL INPUT_YN_D , "데려간다" , "다른 아이로 한다"
		IF RESULT == 0
			CALLFORM SORP_PLAY_{LOCAL}, "キャラ名"
			CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, "05_レストラン", "노출한 웨이트리스", @"그럼~/조금만 기다려주세요~/불러오겠습니다~"
			CALL SHOW_PICTURE, "D"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "05_レストラン", "", @"………………/…………/……"
			CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:2, "05_レストラン", "노출한 웨이트리스", @"오래 기다리셨습니다~ 다음은 자유롭게 해주세요~/이후 바로를 원하신다면~/대각선 맞은편 빌딩에 있는 계열 호텔을 추천해 드려요~"
			CALL SHOW_PICTURE, "D"
			CALLFORM SORP_PLAY_{LOCAL}, "身受け口上"
			CALL DUNGEON_WORP,2,14,1
		ELSE
			GOTO REST_LOOP_3
		ENDIF
	CASEELSE
		GOTO REST_LOOP
ENDSELECT

;=======================================================================
;メニューの処理
;=======================================================================
;もっとお手軽に手が出せるように1/20に値下げ。
;あと、アルカディアと被るけどPT全体にMAG補給する効果を追加
;量自体は及ばないがPT全体が対象なことと、経験等の加算なしな点で差別化

;メニューリスト
@RESTRANT31_MENU_LIST
#DIMS VALUES

VALUES = [1]여체성찬 아 라 모드 50
VALUES += @"/[2]유배 35"
VALUES += @"/[3]밀크티 30"
VALUES += @"/[4]자지 밀크셰이크 40"
VALUES += @"/"
VALUES += @"/"
VALUES += @"/[0]그만둔다"
CALL INPUT_SELECT_D , VALUES , , , 2

SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASEELSE
		RETURN RESULT
ENDSELECT

;メニュー選択時
@RESTRANT31_MENU, ARG, ARGS
#DIM 価格
SELECTCASE ARG
	CASE 1
		;つるぺたリリム
		CALL MESSAGE_WINDOW_D_ICON, , ARGS, "05_レストラン", "노출한 웨이트리스", @"여체성찬 아 라 모드는~/50마카랍니다~/어떻게 하시겠어요~？"
		価格 = 50
	CASE 2
		;おっぱいサキュバス
		CALL MESSAGE_WINDOW_D_ICON, , ARGS, "05_レストラン", "노출한 웨이트리스", @"유배는~/35마카랍니다~/어떻게 하시겠어요~？"
		価格 = 35
	CASE 3
		;母乳ヴェパール
		CALL MESSAGE_WINDOW_D_ICON, , ARGS, "05_レストラン", "노출한 웨이트리스", @"밀크티는~/30마카랍니다~/어떻게 하시겠어요~？"
		価格 = 30
	CASE 4
		;ふたなりエルフor男の娘インプ
		CALL MESSAGE_WINDOW_D_ICON, , ARGS, "05_レストラン", "노출한 웨이트리스", @"자지 밀크셰이크는~/40마카랍니다~/어떻게 하시겠어요~？"
		価格 = 40
	CASEELSE
		RETURN
ENDSELECT

CALL INPUT_YN_D , "먹는다" , "그만둔다"
IF RESULT == 0
	IF MONEY:1 < 価格
		CALL MESSAGE_WINDOW_D_ICON, , ARGS, "05_レストラン", "노출한 웨이트리스", @"손님~/마카가 부족해요~/"
		RETURN
	ENDIF
	MONEY:1 -= 価格
	
	;4の時は追加選択。
	IF ARG == 4
		CALL MESSAGE_WINDOW_D_ICON, , ARGS, "05_レストラン", "노출한 웨이트리스", @"그럼 손님~/식기의 종류를 골라주세요~/"
		CALL INPUT_YN_D , "후타나리" , "오토코노코"
		ARG += RESULT
	ENDIF
	
	CALL MESSAGE_WINDOW_D_ICON, , ARGS, "05_レストラン", "노출한 웨이트리스", @"그럼~/조금만 기다려주세요~/"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "05_レストラン", "", @"………………/…………/……"

	CALL MESSAGE_WINDOW_D_ICON, , ARGS, "05_レストラン", "노출한 웨이트리스", @"오래 기다리셨습니다~/부디 편안히 즐겨주세요~/"
	CALLFORM RESTRANT31_EAT_{ARG}
	;PT全員にMAG供給のオマケ効果を追加。入手MAGは価格*100
	FOR LOCAL,1,7
		SIF POS(LOCAL) < 0
			CONTINUE
		CALL CONTROL_MAG, LOCAL, 価格 * 100
	NEXT
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "05_レストラン", "", @"파티 전체에 MAG가 보급되었다…//"
	RETURN
ELSE
	RETURN
ENDIF

