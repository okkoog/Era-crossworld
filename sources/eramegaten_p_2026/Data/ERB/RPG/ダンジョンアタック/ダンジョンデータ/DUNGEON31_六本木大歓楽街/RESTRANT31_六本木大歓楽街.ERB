	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "05_レストラン", "", @"＞숟가락이 가슴에 닿을 때마다 " + LOCALS + "는 흥분하고/＞날개에 얹힌 소스와 크림이 뒤섞인다/＞이것도 숟가락으로 긁어모아 일부러 가슴에 얹어 푸딩과 함께…"
	CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, "05_レストラン", L_NAME, @"히익… 흐아아 %ハート()% /날개가 차가워서… 앙！/앗, 안 돼 벌써 나와버려어！"
	CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, "05_レストラン", L_NAME, @"앗…/아흥 %ハート()% /"
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "05_レストラン", "", @"＞갑자기 %LOCALS%의 가슴에서 모유가 쏟아져 나와 푸딩의 카라멜 소스와 뒤섞인다/＞더불어 치구도 흠뻑 젖어, 이쪽도 소스로 쓸 수 있을 것 같다/"
	CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, "05_レストラン", L_NAME, @"그럼 손니임…/소스는 전부 갖추어졌으니이…/손님 마음대로 드셔주세요오 %ハート()% "
	CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "05_レストラン", "", @"＞이미 피로한 기색이 보이는 " + LOCALS + "였지만, 푸딩은 아직 많이 남아있다/＞물론 소스는 끊임없이 넘쳐흘러 나온다/＞" + CALLNAME:MASTER + "는 " + LOCALS + "의 교성을 배경 삼아 맛있게 푸딩을 먹었다…"
ELSE
	CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, "05_レストラン", L_NAME, @"그럼 손님,/오늘도 부디 남김없이 드셔주세요 %ハート()% /"
