;21/10/29 フラグ新設。ダンジョンフラグから移設する
;娼婦キャラ上限(とりあえず100人分用意)
#DIM CONST MAX_DUNGEON_31_FLAGS = 100

#DIMS 受付アイコンアドレス
#DIMS 給仕アイコンアドレス, 3
#DIM 六本木娼館ナンバー
#DIM 六本木娼館選択内容
#DIM 六本木娼館選択ページ
#DIM 六本木娼館商品リスト, MAX_DUNGEON_31_FLAGS
#DIM CONST 六本木娼館リスト表示数 = 5

;娼館利用フラグ　0:利用してない　1:利用した　2:クーポンあり
#DIM SAVEDATA 六本木娼館表フラグ, 1 = 0;창관(表)利用フラグ
#DIM SAVEDATA 六本木娼館裏フラグ, 1 = 0;창관(裏)利用フラグ

;娼婦フラグ　各娼婦の状況を記録する　0:その子を指名したことない　1:指名したことある　2:身請け可能　3:身請け済　4:身請け済(後日)
;(キャラ追加したらここにも追記しておくと後の人が作りやすいかも？)
#DIM SAVEDATA 六本木娼婦フラグ, MAX_DUNGEON_31_FLAGS
#DIM SAVEDATA 六本木娼婦フラグ予備1, MAX_DUNGEON_31_FLAGS
#DIM SAVEDATA 六本木娼婦フラグ予備2, MAX_DUNGEON_31_FLAGS
#DIM SAVEDATA 六本木娼婦フラグ予備3, MAX_DUNGEON_31_FLAGS

;0　(欠番)
;1　ジョセフィーヌ
;2　シェリー
;3　ナヴィ
;4　メラニー
;5　ミア
;6　ウェンディー
;7　ベリンダ
;8　フィア
;9　楓
;10　クッキー
;11　グリムヒルデ
;12　セシリア
;13　シリー
;14　コートニー
;15　カスミン
;16　エイプリル
;17　ドロシー
;18　りんご
;19　直斗
;20　(無名の高校生)
;21　(傷アリ女子中学生)
;22　ルーセラ
;23　一人で飲んでる男

