;ドロシー(アルゴニアンメイド)
;キャラ追加(新版)のサンプルキャラその1
;少し卑屈気味な裏方メイド。なお卑屈と言っても仕事中は表面を取り繕う事が出来る程度なので、初対面時はそこそこ普通
;	Edit	Date			Author					Reason
;	001		20XX/XX/XX		っとっとき				新規作成
;	002		20XX/XX/XX		XXX						AI製顔グラ対応
;	003		2023/10/11		っとっとき				妊娠イベント対応
;	004		2023/10/20		っとっとき				ver150の更新に伴い、最新ソースにマージ
;	005		2023/12/11		っとっとき				妊娠イベント微加筆
;	006		2024/04/16		っとっとき				ビデオタイトル対応
;	007		2025/12/11		kamedakeisuke			元ネタが明らかにThe Elder ScrollsなのでEXTRA参戦扱いに変更

@SORP_PLAY_1017, ARGS
#DIM CONST CSV_NO = [[キャラ:도로시]]
#DIM CONST FACE_NO = 30
#DIMS DYNAMIC ICON_ADDRESS
ICON_ADDRESS '= D31_FACE("シェリー")
SELECTCASE ARGS
	CASE "娼婦番号"
		RESULTS = [1017]
	CASE "キャラ名"
	RESULTS = 도로시
	CASE "指名名"
		IF 六本木娼婦フラグ:17 == 0
	RESULTS = 도로시(메이드？)
		ELSE
	RESULTS = 도로시(아르고니안 메이드)
		ENDIF
	CASE "所属"
		;表なら1、裏なら2
		RETURN 2
	CASE "判定"
		;指名可能なら0、不可なら1
		
		;明確に元ネタがThe Elder Scrollsなので、EXキャラがONになってないと出ない
		SIF !GETS_USEABLE_EXTRA_TITLE()
			RETURN 0
			
		;(出現条件はテキトー。女の場合を考えるのが面倒だからひとまずSEXできる前提)
		SIF !IS_PLAYABLE_EXTRA_CHARA(CSV_NO)
			RETURN 1
		SIF GETCHARA(CSV_NO) >= 0
			RETURN 1
		SIF 六本木娼婦フラグ:17 >= 3
			RETURN 1
		SIF !HAVE_PENIS(MASTER)
			RETURN 1
		SIF ABL:MASTER:기교 <= 5
			RETURN 1
		RETURN 0
	CASE "価格"
		IF 六本木娼婦フラグ予備2:17 > 0
			;出産済みなら値上げ
			RETURN 800
		ELSE
			RETURN 500
		ENDIF
	CASE "紹介文"
		IF 六本木娼婦フラグ:17 == 0
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"………도로시 양을 희망하십니까/…저기, 그게, 그녀는 조금… 사람을 가리는 타입이라고 해야 할지…/"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"저희 가게에서도 직전에 취소하는 분이 많은 아가씨라서 말이지요…/그녀 본인이 나쁘다는 건 아닙니다만, /트러블이 끊이지 않다 보니 무심코 경계하게 된다고나 할까요…"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"…다시 한번 확인합니다만, 정말로 괜찮으시겠습니까？/취소하시더라도 환불이나 클레임은 절대 불가하니까요？/민폐 요금이라 생각하고 지불만 해주신다면, 그 이상의 소동으로는 번지지 않게 할 테니…"
		ELSEIF 六本木娼婦フラグ予備1:17 > 0
			;妊娠イベント時
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"……도로시 양입니까/손님… 여러모로 드리고 싶은 말씀은 많습니다만, 딱 한 가지만…/부디… 각오를 단단히 하시길…"
		ELSE
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"……도로시 양입니까/…저기, 손님……？/혹시 허브나 뭐 이상한 거라도 하고 계십니까…？/"
		ENDIF
	CASE "確認"
		IF 六本木娼婦フラグ予備2:17 > 0
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"그럼, 도로시 양입니다만…/하룻밤에 ８００마카가 되겠습니다/…짐작 가는 데가 있으시지요？ 인상된 이유 말입니다…"
		ELSE
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"그럼, 도로시 양입니다만…/하룻밤에 ５００마카가 되겠습니다/"
		ENDIF
	CASE "プレイ口上"
		CALL DUNGEON_WORP,2,5,10
		;条件によって分岐の追加も可
		IF 六本木娼婦フラグ:17 == 0
			六本木娼婦フラグ:17 = 1
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"저 같은 자를 지명해 주셔서 대단히 감사합니다. /손님/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞나타난 것은 메이드복을 걸친 도마뱀형 악마였다…/물어보니 「아르고니안」이라는 이향의 땅의 종족이라고 한다…/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"놀라셨겠지요？/이 거리에도 다종다양한 사람이 있습니다만/저 같은 모습의 자가 하룻밤의 꽃을 파는 일은 거의 없다고 들었습니다…"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"남성이었다면 전투 일로 푼돈이라도 벌 수 있었을 텐데/천성적으로 그런 것과는 무관한 삶을 살아온 터라/사정상 이곳에서 거두어 주신 덕에 머물고 있습니다…"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"평소에는 이곳의 모든 분들의 신변 시중을 드는 것이 제 일이라서…/명부에 올라 있는 것은 솔직히 명목상일 뿐이랍니다/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"지금까지 지명된 적은 몇 번 있었습니다만, 안아줄 마음이 든 손님은 단 한 분도 계시지 않았고…/아주 드물게 일부 별난 분들과 이렇게 이야기를 나누며/동정심에서 나오는 임시 수입을 받고 있는 처지입니다"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"/손님도……/분명 저 같은 자를 안을 마음은 들지 않으시겠지요……？"
			;あなた「は？！んな訳ないだろ。こちとら机や土偶も構わず犯す悪魔調教師やぞ！」
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"아앗！ 손님！！ 안 됩니다！ 안 돼요%ハート()%/아아앗！ 곤란합니다！ 곤란해요！ 손님！ 손니이임%ハート()%/앗！ 아아앗！ 손님！ 손님~앗%ハート()%"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"안 돼요！ 가버려요！ 곤란해요 손니이임%ハート(2)% 그런 짓 하시면 곤란합니다%ハート()%/아앗！ 아앗！！ 안 됩니다 손님%ハート()%/아아앗！！！ 아아아 손니이임~~%ハート(3)%"
			CALL SHOW_PICTURE, "EMPTY"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"소, 손니이임…%ハート()%/이거 그런 뜻%ハート()%으로 받아들여도 되는 거겠지요…？/저 같은 것으로도 흥분해 주신 거%ハート()% 맞지요…？"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞도로시는 흐트러진 메이드복 차림으로 침대에 깊이 파묻혀/천장에 넋을 놓은 채, 마음속의 당혹감을 하나씩 되짚어보고 있다…/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞「다음에 또 안으러 오마」라고 귓가에 속삭이자/열락의 여운인지 다음번에 대한 기대인지 도로시는 파르르 떨었고, /당신은 조용히 방을 나섰다…"
			;なんかティーン系の少女漫画っぽくなった…まあいいか、この路線で行こう
		ELSEIF 六本木娼婦フラグ:17 == 1 || FLAG:임신기능 == 0
			;2回目。また、妊娠オプションがOFFの場合はココで止まる
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"아…… 소, 손, 님…？/어, 어서 오십시오…？/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞지난번의 일을 떠올리고 있는 것인지, 도로시는 어색하게 당신을 맞이했다//"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"그, 저기… 창관에서 일하고는 있습니다만/저 자신은 그런 경험이 미천하여, 서요…/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"손님의, 나, 날카로운 어금니가, 그……/제 소중한 부위…에, 깊은 상처, 를 새겨…놓으셔서…/주제넘은 소리, 겠지만… 다른 누군가를 다치게, 하지 않을까, 불안해서…"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"부디… 부탁드립니다…/그 어금니가… 섣불리 다른 분을 상처 입히지 않도록…/제게 하룻밤, 손질을… 맡겨주시지, 않겠습니까…？"
			;「俺の槍を磨け！」「おおきくて一晩中かかるかも」という原作リスペクト
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"아앗！ 아아앗！！ 손니이임%ハート(3)%/곤란해요！ 곤란합니다아%ハート()% 거기는 안 돼요 손님%ハート(3)%/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"손님！ 손니이임~~%ハート(3)% 아아아~~%ハート(3)%/안 돼요오%ハート()% 이런 건 곤란합니다 손님%ハート(3)%/아！ 아아~~%ハート(5)%"
			CALL SHOW_PICTURE, "EMPTY"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"소, 손니이임%ハート(3)%………//"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞태내를 뜨거운 진흙탕으로 가득 채워진 도로시는/그 밑바닥 없는 늪 같은 황홀경에서 도무지 헤어 나오지 못하고 있다…/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞「다음에 또 안으러 오마」라고 귓가에 속삭이자/열락의 여운인지 다음번에 대한 기대인지 도로시는 파르르 떨었고, /당신은 조용히 방을 나섰다…"
			;見受け可能フラグを設定
			六本木娼婦フラグ:17 = 2
			;妊娠イベントフラグを戻す
			六本木娼婦フラグ予備1:17 = 0
			六本木娼婦フラグ予備2:17 = 0
		ELSEIF 六本木娼婦フラグ予備1:17 > 0
			;妊娠イベント
			IF 六本木娼婦フラグ予備1:17 == 1
				;進行度1、妊娠イベント1(妊娠報告)
				;口上の妊娠発覚時で卵生がどうのと言ってたのとつじつまが合わないって？
				;こう、悪魔主体の娼館だし、先輩方との交流でそういう知識を教えてもらった感じで…　(※このイベントを見た時点で口上側の初妊娠時は見れなくして整合性を取る)
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"아…… 소, 손, 님……/어…… 어서… 오, 오십시오…/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞도로시는 조심스러워하며 당신을 맞이했다//"
				IF 六本木娼婦フラグ予備2:17 == 0
					;妊娠初めて
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"그, 저기… 창관 근무지만… 저, 저는… 꽃을 파는 건 손님…뿐이었고/…다, 다른 분들과 달리… 피임에 대처를… 하, 하지 못했…던 거예요…/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"…지난번 상대해 주셨을 때가… 위, 위험한 날…이었어서…/소, 손님께서 다그쳐 오시니… 휩쓸리는 채로… 가랑이를 허락해 드렸, 잖아요…？/그… 그게… 저기… '명중'…해버린, 것 같아요…"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞내민 임신 테스트기에는 「하룻밤의 실수」라는 명백한 증거――/――'양성'을 나타내는 붉은 두 줄이 선명히 떠올라 있고…/눈앞의 암컷이 「씨앗이 박혀」「당신의 아이를 배고 있다」고 주장하는 꼴이다…"
				ELSE
					;2回目以降
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"그, 저기… 이것을, 봐주세요…//"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞내민 임신 테스트기에는, 언젠가 보았던 것과 똑같은――/――'양성'을 나타내는 붉은 두 줄이 떠올라 있는 상황이다…/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"…또, 또다시… '생겨버린%ハート()%'… 것 같아요…/여… '여기'에…… 손님과의 유정란(알)%ハート()%이……/"
				ENDIF
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"소…… 손님… 어…… 어떻게… 하, 면 좋을까요……？//"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
				CALL SHOW_PICTURE, "EMPTY"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"아아앗！！ 손니이임%ハート(2)% 안 돼요 손님%ハート(3)%/「이미 생겼으니까」라고 하셔도 곤란합니다%ハート(2)% 아아아앗~%ハート(3)%/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"소%ハート()% 손니이임！%ハート(3)% 이런 건 안 돼요%ハート(2)%/손님이 듬뿍 심어준 크림파이%ハート()% 이 이상 만드시면 안 됩니다앗%ハート(4)%/아아~~%ハート(5)%"
				CALL SHOW_PICTURE, "EMPTY"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"소, 손니이임%ハート(3)%………//"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞아이를 밴 여자의 성역을 남자의 욕망으로 다시금 가득 채워진 도로시는/남에겐 보여줄 수 없는 부끄러움을 잊은 암컷의 수정된 얼굴을 드러내고 있다…/만약 다태아 임신이라면, 한 명 더 만들어버렸을지도 모를 지경이다"
				
				六本木娼婦フラグ予備1:17 = 2
			ELSEIF 六本木娼婦フラグ予備1:17 > 1 && 六本木娼婦フラグ予備1:17 <= 4
				;進行度2～4、妊娠イベント2(経過1)、複数回発生する。最大3回見れば次へ
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"아…… 소, 손님…/……어, 어서 오… 십시오……%ハート()%/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞도로시는 기대와 불안이 교차하는 표정으로 당신을 맞이했다/몸의 곡선이 조금씩 둥그스름해지기 시작하여… 그 몸이 틀림없는 「여자」이며…/그리고… 「어머니」가 되어가는 도중임을…… 말없이 호소하고 있다…"
				IF 六本木娼婦フラグ予備2:17 == 0 || RAND:2 == 0
					;妊娠初めて
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"…저기… 손님… 또, 찾아와 주셨다…는 것은…/도… 도망치거나, 거리를 두지, 않는다…는 것은…/……그… 그런 뜻%ハート()%으로… 받아들여도, 되는… 거지요…？"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"이, 이대로… 배를 불려서/…나, 낳아도……… 괜찮은, 거지요…？%ハート()%……/"
