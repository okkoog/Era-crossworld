		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"여러 가지 일이 있었습니다만, 그녀에게는 저희 모두가 신세를 졌고, /제대로 책임은 져주셔야지요…/…아아, 비용은 그녀의 몸값과 동일한 ３０００마카가 되겠습니다"
			;こっちのルートは最初からサービス額と明言。つまり「有難く思え」という思惑を含むメッセージ
		ELSE
			;通常ルート
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"도로시 양을 신원 인수하시겠습니까？/손님…… 진심으로 하시는 말씀입니까？/"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"그녀가 빠져나가는 건 저희도 조금 곤란합니다만, 뭐 좋습니다/대신할 자를 고용할 비용을 포함해 ３０００마카를 받게 됩니다만/괜찮으시겠습니까？/"
			;受付の男「本当はもっと費用必要だったけど、彼女のこれまでの仕事ぶりに免じてサービスだ！ご祝儀としてとっといて！」
		ENDIF
	CASE "身受け口上";口上
		CALL SHOW_PICTURE, "D"
		IF 六本木娼婦フラグ予備1:17 > 0 || 六本木娼婦フラグ予備2:17 > 0
			;妊娠ルート
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"소, 손님… 지, 진심, 이신가요…？/저, 저를…… 거두어 주신다…니…/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"아니에요！ 기, 기쁘지 않은 건 아니…에요？/생각지도 못했던 일이라… 당혹스러울, 뿐이지…/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"혹시… 채, 책임 때문이라던가… 손님께서… 무리하고 계신 거라면/지… 지금이라도…… 취, 취소하셔, 도…/…괘… 괜찮…으니까…요……"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"……아%ハート()%… 네, 넷… 기, 기꺼이%ハート()%/이제부터는… 메이드로서, 곁에 시중들게 해주시겠어요？/……서, 서방님%ハート()%…"
		ELSE
			;通常ルート
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"소, 손님… 오늘은 무슨 일이신가요？/왠지, 다들 짐을 챙겨서 이리로 오라고 하셨는데…/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞당신은, 도로시를 자신의 전속 메이드로 삼기 위해 돈을 완납했음을 전했다//"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"에… 에에~~!!/저 같은 자를 위해 그런 큰돈을？！ 왜 그런 짓을 하신 건가요！！/그런 짓을 당해도… 전…"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"그런 짓을 당해도… 저, 아무것도 돌려드릴 수, 없잖아요…/손님께는, 더욱, 걸맞은 분, 이…/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞에잇！ 이미 지불 끝났으니 잔말 말고 입 다물어라！/좋으니까 썩 내 것이나 되어라！/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"그, 그런/……저, 정말로 저라도, 괜찮은, 건가요？/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"도로시", @"//……저, 저기… 앞으로도, 영원히, 잘 부탁드립니다, 네？/손님… 아니, 저의 서방님(마이 히어로)…%ハート()%"
			;ダル＝マの「私のヒーロー」リスペクト
		ENDIF
		六本木娼婦フラグ:17 = 3
		RESULTS '= "ドロシー" + "_" + D31_FACE("ドロシー", 1)
		;妊娠・出産の有無で変化する
		RETURN CSV_NO, 6000, (六本木娼婦フラグ予備1:17 > 0 || 六本木娼婦フラグ予備2:17 > 0)
	CASE "宣伝"
		;(なし)
	CASE "リスト"
		IF 六本木娼婦フラグ:17 == 0
			;指名前は顔を非表示に
			;また、正体を隠す
			RESULTS = 55_SECRET
			RESULTS:1 = 　
		ELSE
			CALLF 顔グラ追加_F, CSV_NO
			RESULTS '= "ドロシー" + "_" + D31_FACE("ドロシー", 1)
		RESULTS:1 = 아앗！ 손님！！ 안 돼요！
		ENDIF
ENDSELECT
