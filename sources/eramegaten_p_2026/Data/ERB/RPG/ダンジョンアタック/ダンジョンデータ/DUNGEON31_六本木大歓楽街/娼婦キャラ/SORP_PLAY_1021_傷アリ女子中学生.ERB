			RETURN 1
		ELSEIF 闘技場フラグ:10:0 == 1 && 闘技場フラグ:10:1 == 0
			RETURN 0
		ELSE
			RETURN 1
		ENDIF
	CASE "価格"
		RETURN 50
	CASE "紹介文"
		IF 六本木娼婦フラグ:21 == 0
		CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, ,"노출된 웨이트리스", @"그녀는요~/입으로 해주는 걸로 원조를 받고 싶어 하는 것 같아요~/"
		CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, ,"노출된 웨이트리스", @"얼굴에 상처가 있어서~/피하는 사람도 많긴 하지만요~/솜씨가 제법 훌륭하답니다~"
		CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, ,"노출된 웨이트리스", @"무언가 사정이 있는 것 같아서요~/어딘가에서 도망쳐 나왔다던가~/돈이 잔뜩 필요하다던가~"
		ELSE
		CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, ,"노출된 웨이트리스", @"그 아이의 입봉사~/버릇이 되어버리셨나요~？/"
		CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, ,"노출된 웨이트리스", @"고장 난 COMP를 고치고~/동료마를 다시 모으기 위해서~/아직도 돈이 많이 필요하다고 하더라고요~"
		ENDIF
