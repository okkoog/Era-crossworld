@SORP_PLAY_1021, ARGS
#DIMS DYNAMIC ICON_ADDRESS
ICON_ADDRESS = 63_デビコロ主人公
SELECTCASE ARGS
	CASE "娼婦番号"
		RESULTS = [1021]
	CASE "キャラ名"
	RESULTS = 상처 입은 여중생
	CASE "指名名"
	RESULTS = 상처 입은 여중생
	CASE "所属"
		;表なら1、裏なら2、援助なら3
		RETURN 3
	CASE "判定"
		;指名可能なら0、不可なら1
