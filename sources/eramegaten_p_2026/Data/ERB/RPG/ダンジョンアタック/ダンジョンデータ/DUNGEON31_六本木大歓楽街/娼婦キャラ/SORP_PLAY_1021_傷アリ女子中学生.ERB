		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"…………만족했어？/……그럼, 빨리, 마카 줘/우엑, 아직 맛이 남아있어……"
			ELSE
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"……응읏, 할짝, 으음…… 츕……/……읏, 읍, 큭…… 으……읏/읍, 웁……읏/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞상처 입은 여중생은 " + CALLNAME:MASTER + "의 애액으로 더러워진 입술을 소매로 닦아냈다/＞그 표정은 괴로워 보였고 익숙해진 것처럼 보이진 않았다…/"
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"…………만족했어？/……그럼, 빨리, 마카 줘/왜, 이런 델 핥게 하고 싶어 하는 건지……"
			ENDIF
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"……제대로 마카 준다면, 또 와도 돼/대체로 매일 밤 여기에 있으니까……/"
			;経験フラグを設定
			六本木娼婦フラグ:21 = 1
		ELSE
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"……또 왔어？/……별로 상관없지만/제대로, 마카가 있다면 말야"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
			IF TALENT:MASTER:남자 || TALENT:MASTER:후타나리
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"……응읏, 츄릅, 음…… 츕……/……읏, 읍, 큭…… 꿀꺽……읏/푸하……읏"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞상처 입은 여중생은 " + CALLNAME:MASTER + "가 입안에 토해낸 정액을 삼켰다/＞태도는 쌀쌀맞지만, 남김없이 빨아들이는 정성스러운 봉사였다…/"
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"…………만족했어？/……그럼, 빨리, 마카 줘/왜, 이런 걸 마시게 하고 싶어 하는 건지……"
			ELSE
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"……응읏, 할짝, 음…… 츕……/……읏, 읍, 큭…… 으……읏/푸하……읏"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞상처 입은 여중생은 " + CALLNAME:MASTER + "의 애액으로 더러워진 입술을 혀로 핥아냈다/＞태도는 쌀쌀맞지만, 손에 익은 정성스러운 봉사였다…/"
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"…………만족했어？/……그럼, 빨리, 마카 줘/기분 좋았다면, 다행이지만……"
			ENDIF
			;見受け可能フラグを設定
			六本木娼婦フラグ:21 = 2
		ENDIF
		;プレイ経験(任意の経験を追加可)
		EXP:MASTER:절정경험 += ABL:MASTER:기교
		JUEL:MASTER:쾌Ｃ += ABL:MASTER:기교 * (50) + 50
		JUEL:MASTER:욕정 += ABL:MASTER:기교 * (50) + 50
		IF !TALENT:MASTER:남자
			EXP:MASTER:레즈경험 += ABL:MASTER:기교 * 1 + 1
		ENDIF
		IF TALENT:MASTER:남자 || TALENT:MASTER:후타나리
			EXP:MASTER:사정경험 += ABL:MASTER:기교
			CALL CONTROL_MAG, MASTER, -(ABL:MASTER:기교 * 500)
		ENDIF
		;CALL INCREASE_LC,5  意図が不明かつ変動量が強烈で、ユーザー側から認識できない場所での変動なので除外します。必要性があって再実装する場合は右記の点に注意して再実装してください。
	CASE "身受け価格"
		RETURN 200
	CASE "身受け確認"
		CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, ,"노출된 웨이트리스", @"그 아이의 보지, 관심 있으세요~？/돈이 더 필요한 모양이라~/얼마 전부터 본방을 시작했거든요~"
		CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, ,"노출된 웨이트리스", @"단골손님도 몇 명 있는 것 같아서~/조임이 좋다고 꽤 호평이랍니다~？/"
		CALL MESSAGE_WINDOW_D_ICON, , 給仕アイコンアドレス:1, ,"노출된 웨이트리스", @"２００마카를 내시면 본방을 뛰어도 좋다고 합니다만~/어떻게 하시겠어요~？/"
	CASE "身受け口上"
		;キャラ加入はしません。遊べるだけです。
		IF TALENT:MASTER:남자 || TALENT:MASTER:후타나리
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"……그래, 당신이구나/……딱히/……누구라도 다를 건 없어"
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"……야한 짓, 할 거지？/……빨리, 가자/"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
			SELECTCASE RAND:3
				CASE 0
					;路地裏エッチ
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"으아……읏, 안 돼, 안 돼애……읏/이런, 데서……읏！？/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "는 호텔에 갈 시간조차 아까워하며 상처 입은 여중생을 뒷골목에서 범했다/＞말과는 딴판으로, 그 질은 기분 좋게 육봉을 물고 있었다…/"
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"읏！？ /싫엇, 쳐다보……고, 있으…니까…… 앗……！？/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞히죽거리며 구경하는 갤러리들에게 과시하듯 " + CALLNAME:MASTER + "는 상처 입은 여중생의 질 안을 정액으로 더럽혔다…//"
				CASE 1
					;ラブホエッチ
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"아……읏, 큭……읏/하아……읏…… 응읏……읏/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "는 러브호텔 방으로 상처 입은 여중생을 끌고 가자마자 그 자리에서 밀쳐 넘어뜨렸다/＞소녀의 질내는 나이에 어울리지 않는 농익은 조임으로 육봉을 받아들였다…/"
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"……이제, 나오는 거야……읏/마지막은, 입에……읏……/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그 말에 따라 " + CALLNAME:MASTER + "는 상처 입은 여중생의 질내에서 육봉을 뽑아낸 뒤/＞소녀의 얼굴을 끌어당겨 입안에 사정했다…/"
				CASE 2
					;トイレエッチ
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"싫……읏, 싫어, 싫어어……읏/이런, 더러운……읏！？/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "는 호텔에 갈 시간조차 아까워하며 상처 입은 여중생을 남자 화장실에서 범했다/＞말과는 딴판으로, 그 질은 기분 좋게 육봉을 물고 있었다…/"
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"읏！？ 아, 크읏…… 안에/안 돼……읏……！？/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞그 말을 무시하고 " + CALLNAME:MASTER + "는 상처 입은 여중생의 질 안을 정액으로 더럽혔다…//"
			ENDSELECT
		ELSE
			;レズエッチ
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"이, 이걸로, 됐어……？ 기분 좋아……？//"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞" + CALLNAME:MASTER + "는 러브호텔 방에서 상처 입은 여중생에게 페니스 밴드를 장착시키고 허리를 흔들게 했다/＞당황하는 듯한 말과는 반대로 어딘가 흥분한 모양이다…/"
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"읏, 벌, 벌써 가……？ /이런 걸로, 가버리는 거야……읏？/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞풋풋한 상처 입은 여중생의 허리놀림이 애처롭게 느껴져 " + CALLNAME:MASTER + "는 작게 절정했다…//"
		ENDIF
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"…………/……딱히, 화 안 났어/……됐으니까, 빨리 마카나 줘"
		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"응, 마카, 고마워……/……또 마카 준다면, 와도 돼/……그치만, 너무 이상한 짓은, 싫으니까"
		EXP:MASTER:삽입경험 += ABL:MASTER:기교 * ABL:MASTER:욕망 * 2 + 1
		EXP:MASTER:절정경험 += ABL:MASTER:기교 * ABL:MASTER:욕망
		JUEL:MASTER:쾌Ｃ += ABL:MASTER:기교 * ABL:MASTER:욕망 * 300 + 500
		JUEL:MASTER:욕정 += ABL:MASTER:기교 * ABL:MASTER:욕망 * 200 + 500
		JUEL:MASTER:습득 += ABL:MASTER:기교 * ABL:MASTER:욕망 * 200 + 500
		IF !TALENT:MASTER:남자
			EXP:MASTER:레즈경험 += ABL:MASTER:기교 * ABL:MASTER:욕망 * 2 + 1
			JUEL:MASTER:쾌Ｖ +=  ABL:MASTER:기교 * ABL:MASTER:욕망 * 100 + 300
		ENDIF
		IF TALENT:MASTER:남자 || TALENT:MASTER:후타나리
			EXP:MASTER:질사경험 += ABL:MASTER:욕망
			EXP:MASTER:사정경험 += ABL:MASTER:욕망 + 1
			CALL CONTROL_MAG, MASTER, -( ABL:MASTER:기교 * ABL:MASTER:욕망 * 2000 + 1000)
		ENDIF
	CASE "宣伝"
	CASE "リスト"
		RESULTS '= ICON_ADDRESS

ENDSELECT

