		CALL MESSAGE_WINDOW_D_ICON, , ICON_ADDRESS, ,"상처 입은 여중생", @"……아무것도 아냐/……빨리, 하자/"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
