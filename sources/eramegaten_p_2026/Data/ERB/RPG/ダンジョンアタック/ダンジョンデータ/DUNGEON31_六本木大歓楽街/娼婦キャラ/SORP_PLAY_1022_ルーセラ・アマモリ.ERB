;=====================================================
;ルーセラ・アマモリ
;=====================================================
;日米ハーフのアマゾネスさん、ただしガチモンのアマゾネスなのでまっとうな人間ではない
;漢字表記は「亜馬森ルーセラ」（亜馬森は南米アマゾンのことをさす）
;日本にはつよつよ男性を探しに来た（そのため、あなたが男性限定、レベル条件アリ）
;タッパも乳も尻も太もももデカい
;実は表の娼館で働いたらマズい年齢だが、自信満々でやってきたので通っちゃったという裏設定
;あと実家がメチャクチャ太い。娼婦やってるのは男漁りのため。特に給料とかもらってない
;レベル条件で（次回から）ガンガン安くなる
;「ルーセラ」は映画『アマゾネス』に登場するキャラから
;まあ『アマゾネス』、レズビアンな感じなのでアレだが。もう50年は前の映画ですね。
;=====================================================
;六本木娼婦フラグ予備1　「前回あなたが何レベルだった？
;　0 ：初回
;　1 ：Lv30台だったデース　雑魚の中ではマシな方デース
;　2 ：Lv40台だったデース　ワタシとまあまあ同じくらいデース
;　3 ：Lv50台だったデース　ベイビー産むならこのくらい欲しいデース
;　4 ：Lv60台だったデース　ベイビー産みたいデース……（ハート）
;　5 ：Lv70台だったデース　ベイビー産ませてほしいのでDOGEZAから入るデース（ハート）
;　99：身請けされちゃったデース（ハート）　ガンガンブリブリベイビーひりだすデース！！！
;=====================================================
;230627	NEO		出現条件ミスを修正
;				AI画像のイメージが＊まったく＊違うのでアイコン画像出ないようにした
;231020			六本木娼婦フラグ予備1の誤りを発見したので修正
;=====================================================

@SORP_PLAY_1022, ARGS
#DIM CHARA, 1
#DIM CONST CSV_NO = [[キャラ:루세라]]
#DIMS DYNAMIC ICON_ADDRESS
ICON_ADDRESS '= D31_FACE("ルーセラ")
SELECTCASE ARGS
	CASE "娼婦番号"
		RESULTS = [1022]
	CASE "キャラ名"
	RESULTS = 루세라
	CASE "指名名"
	RESULTS = 루세라·아마모리(반마인)
	CASE "所属"
		;表なら1、裏なら2、援助なら3
		RETURN 1
	CASE "判定"
		;指名可能なら0、不可なら1
		SIF GETCHARA(CSV_NO) >= 0
			RETURN 1
		;身請けしてたらダメ
		SIF 六本木娼婦フラグ予備1:22 == 99
			RETURN 1
		SIF 六本木娼婦フラグ:22 == 3
			RETURN 1
		;あなたが男性でレベルが30以上でないと出ない（彼女がギリッギリ許せる程度に最低限強くないとダメ）
		;男性でないならアウト
		SIF !IS_MALE(MASTER)
			RETURN 1
		;Lv30未満だとアウト
		SIF BASE:MASTER:LV < 30
			RETURN 1
		RETURN 0
	CASE "価格"
		;初めては固定
		IF 六本木娼婦フラグ:22 == 0
			RETURN 600
		;前回レベル75以上
		;強い雄にはすげー安くなる　さっさと身請けしてくれって感じ
		ELSEIF 六本木娼婦フラグ予備1:22 >= 5
			RETURN 3
		;前回レベル60以上
		;60を超えると明確に安い
		ELSEIF 六本木娼婦フラグ予備1:22 >= 4
			RETURN 150
		;前回レベル50以上
		;彼女より１段強い状態
		;安めのお値段
		ELSEIF 六本木娼婦フラグ予備1:22 >= 3
			RETURN 250
