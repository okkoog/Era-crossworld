		ELSE
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"루세라", @"…………。/말문이 막힙니DA-……/엣, 벌써 내버리셨습니KKAY……？/……응, 오케이！ 저도 여자입니DA-！！！"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"루세라", @"그 정도의 돈을 지불하셨다면, 답하지 않을 수가 없습니DA-！/앞으로도 잘 부탁드립니DA-！！！/"
		ENDIF

		;フラグを「身請け済み」にセット
		六本木娼婦フラグ予備1:22 = 99
		六本木娼婦フラグ:22 = 3
		RESULTS '= "ルーセラ" + "_" + D31_FACE("ルーセラ", 1)
