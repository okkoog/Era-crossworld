;クッキー(ふたなりモー・ショボー)
@SORP_PLAY_1010, ARGS
#DIM CHARA, 1
#DIM CONST CSV_NO = [[キャラ:쿠키]]
#DIM CONST FACE_NO = 30
#DIMS DYNAMIC ICON_ADDRESS
ICON_ADDRESS '= D31_FACE("クッキー")
SELECTCASE ARGS
	CASE "娼婦番号"
		RESULTS = [1010]
	CASE "キャラ名"
		RESULTS = 쿠키
	CASE "指名名"
		RESULTS = 쿠키(후타나리 모 쇼보)
	CASE "所属"
		;表なら1、裏なら2
		RETURN 2
	CASE "判定"
		;指名可能なら0、不可なら1
		SIF GETCHARA(CSV_NO) >= 0
			RETURN 1
		SIF 六本木娼婦フラグ:10 >= 3
			RETURN 1
		RETURN 0
	CASE "価格"
		RETURN 300
	CASE "紹介文"
		IF 六本木娼婦フラグ:10 == 0
			CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"흠, 쿠키 양인가요/그녀는 재미있는 경험을 겪어서 말이죠/"
			CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"원래는 어디에나 있는 모 쇼보였습니다만/어떠한 원인으로 갑자기 페니스가 돋아난 듯하여/그 쾌락에 완전히 홀려 있답니다"
			CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"어린 성정 탓에 자제도 되지 않고/용서받지 못할 일이라고 이성은 이해하면서도 본능으로 페니스를 계속 자극하는 것이지요/하지만 자신의 서투른 손가락질로는 만족할 수 없다는 악순환이지만요"
			CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"손님께도 아마 페니스에 대한 자극을 요구해 올 것입니다/부디 너그러이 용서를…/"
		ELSE
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"흠, 쿠키 양인가요/손님, 독특한 감각에 빠져드셨군요/"
		ENDIF
	CASE "確認"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"그럼 쿠키 양입니다만…/하룻밤에 300마카가 되겠습니다/"
	CASE "プレイ口上"
		CALL DUNGEON_WORP,2,5,10
		IF 六本木娼婦フラグ:10 == 0
			六本木娼婦フラグ:10 = 2
			CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"으으…/자지… 자지에서 저엉액 내뿜고 싶어어…/"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞찾아온 귀여운 모 쇼보는/＞그러나 단정한 얼굴을 일그러뜨리며 오로지 거무스름한 페니스를 문지르고 있다/＞쿠퍼액은 줄줄 흘러나오지만 성욕의 갈증을 해소하지는 못하는 모습이다"
			IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
				CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"오빠, 부탁이야/오빠 엉덩이에 내 자지 넣게 해주세요/부탁드려요！"
			ELSE
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"언니, 부탁이야/언니의 보지에 내 꼬추 넣게 해주세요/부탁드려요！"
			ENDIF
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞말이 끝나기 무섭게 쿠키는 덮쳐왔다！/＞아무래도 이쪽을 범할 생각인 모양이다/＞뭐, 딱히 문제될 건 없다 범해져 주기로 하자…"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
			IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"오빠, 이런 짓 해서 죄송해요, 죄송해요…/으으… 나 왜 이런 게 자라버린 걸까…/죄송해요…"
			ELSE
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"언니, 이런 짓 해서 죄송해요, 죄송해요…/으으… 나 왜 이런 게 자라버린 걸까…/죄송해요…"
			ENDIF
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"…하지만, 괜찮으시다면 또 불러주세요/그러면 더 정액 낼 수 있으니까…/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞역시 아직 다 쏟아내지 못한 듯한 쿠키는, 그러면서도 방에서 나갔다…//"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"으으…/자지… 자지에서 저엉액 내뿜고 싶어어…/"
			IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"아, 오빠다/또 불러줬다는 건…/엉덩이에 더 잔뜩 싸질러도 된다는 거지！"
			ELSEIF TALENT:MASTER:오토코노코
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"아, 언니 같은 오빠다/또 불러줬다는 건…/엉덩이에 더 잔뜩 싸질러도 된다는 거지！"
			ELSE
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"아, 언니다/또 불러줬다는 건…/보지에 더 잔뜩 싸질러도 된다는 거지！"
			ENDIF
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞말이 끝나기 무섭게 쿠키는 덮쳐왔다！/＞지난번보다 더 일말의 망설임도 없이, " + CALLNAME:MASTER + "는 순식간에 옷이 벗겨져 버렸다…/"
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"………………/…………/……"
			CALL SHOW_PICTURE, "EMPTY"
			IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"오빠, 이런 짓 해서 죄송해요, 죄송해요…/으으… 나 왜 이런 게 자라버린 걸까…/죄송해요…"
			ELSE
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"언니, 이런 짓 해서 죄송해요, 죄송해요…/으으… 나 왜 이런 게 자라버린 걸까…/죄송해요…"
			ENDIF
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"…하지만, 괜찮으시다면 또 불러주세요/그러면 더 정액 낼 수 있으니까…/"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞역시 아직 다 쏟아내지 못한 듯한 쿠키는, 그러면서도 방에서 나갔다…//"
		ENDIF
		TALENT:MASTER:처녀 = 0
		TALENT:MASTER:재생처녀 = 0
		EXP:MASTER:절정경험 += ABL:MASTER:욕망
		JUEL:MASTER:쾌Ｃ += ABL:MASTER:욕망 * (300) + 300
		JUEL:MASTER:쾌Ｂ += ABL:MASTER:욕망 * (300) + 300
		JUEL:MASTER:쾌Ａ += ABL:MASTER:욕망 * (300) + 300
		JUEL:MASTER:욕정 += ABL:MASTER:욕망 * (300) + 300
		EXP:MASTER:정액경험 += ABL:MASTER:욕망 * 10
		EXP:MASTER:펠라경험 += ABL:MASTER:욕망 * 10
		IF !TALENT:MASTER:남자
			EXP:MASTER:레즈경험 += ABL:MASTER:욕망 * 3
			JUEL:MASTER:쾌Ｖ += ABL:MASTER:욕망 * (500) + 500
			JUEL:MASTER:쾌Ａ += ABL:MASTER:욕망 * (500) + 500
			EXP:MASTER:Ａ경험 += ABL:MASTER:욕망 * 5
			EXP:MASTER:Ｖ경험 += ABL:MASTER:욕망 * 5
		ELSE
			JUEL:MASTER:쾌Ａ += ABL:MASTER:욕망 * (1000) + 1000
			EXP:MASTER:Ａ경험 += ABL:MASTER:욕망 * 10
		ENDIF
		IF TALENT:MASTER:남자 || TALENT:MASTER:후타나리
			EXP:MASTER:사정경험 += ABL:MASTER:욕망
			CALL CONTROL_MAG, MASTER, -(ABL:MASTER:욕망 * 3000)
		ENDIF
		IF TALENT:MASTER:모유체질
			EXP:MASTER:분유경험 += (ABL:MASTER:욕망 + 1) * 3
			JUEL:MASTER:쾌Ｂ += (ABL:MASTER:욕망 + 1) * 200
			CALL CONTROL_MAG, MASTER, -(ABL:MASTER:욕망 * 2000 + 1000)
		ENDIF
		;CALL INCREASE_LC,5  意図が不明かつ変動量が強烈で、ユーザー側から認識できない場所での変動なので除外します。必要性があって再実装する場合は右記の点に注意して再実装してください。
		CALL DUNGEON_WORP,2,6,14
	CASE "身受け価格"
		RETURN 1000
	CASE "身受け確認"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"쿠키 양을 신원 인수하시겠습니까？//"
		CALL MESSAGE_WINDOW_D_ICON, , 受付アイコンアドレス, ,"접수원 남자", @"그러시다면, １０００마카를 받게 됩니다/괜찮으시겠습니까？/"
	CASE "身受け口上";口上
		CALL SHOW_PICTURE, "D"
		IF TALENT:MASTER:남자
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"오빠가 쿠키의 꼬추 매일 괴롭혀주는 거야？/고마워, 오빠！/이제 나도 매일 기분 좋아질 수 있겠네！"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞쿠키는 " + CALLNAME:MASTER + "에게 천사 같은 미소를 지어 보였다/＞…페니스를 만지작거리면서/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"앞으로도 나와 내 꼬추 잘 부탁해//오빠！"
		ELSE
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"언니가 쿠키의 꼬추 매일 괴롭혀주는 거야？/고마워, 언니！/이제 나도 매일 기분 좋아질 수 있겠네！"
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", @"＞쿠키는 " + CALLNAME:MASTER + "에게 천사 같은 미소를 지어 보였다/＞…페니스를 만지작거리면서/"
		CALL MESSAGE_WINDOW_D_ICON, CSV_NO, ICON_ADDRESS, ,"쿠키", @"앞으로도 나와 내 꼬추 잘 부탁해//언니！"
		ENDIF
		RESULTS '= "クッキー" + "_" + D31_FACE("クッキー", 1)
		RETURN CSV_NO, 6000, 0		
	CASE "宣伝"
		PRINTL
		PRINTL 쿠키
		SETCOLOR COLOR("ハートピンク")
		PRINTL 『기분 좋게 해주세요. 이제 못 참겠어요…』
		RESETCOLOR
		PRINTL 이용자: (노 코멘트)
		PRINTL 　　　　(편집자 주기: 이용자 전원이 입을 닫아버려 코멘트를 수록할 수 없었습니다.
		PRINTW 　　　　 아마 입에 담을 수 없을 정도로 대단한 체험을 한 것으로 보입니다)
	CASE "リスト"
		CALLF 顔グラ追加_F, CSV_NO
		RESULTS '= "クッキー" + "_" + D31_FACE("クッキー", 1)

		RESULTS:1 = 기분 좋게 해주세요. 이제 못 참겠어요…
ENDSELECT
