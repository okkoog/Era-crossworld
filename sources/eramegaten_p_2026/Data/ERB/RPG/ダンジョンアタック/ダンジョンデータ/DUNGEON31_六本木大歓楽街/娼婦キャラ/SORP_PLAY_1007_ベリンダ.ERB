	CASE "娼婦番号"
		RESULTS = [1007]
	CASE "キャラ名"
		RESULTS = 벨린다
	CASE "指名名"
		RESULTS = 벨린다(악마인)
	CASE "所属"
		;表なら1、裏なら2
		RETURN 1
	CASE "判定"
