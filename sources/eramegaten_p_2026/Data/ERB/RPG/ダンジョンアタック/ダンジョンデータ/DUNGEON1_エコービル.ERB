@SET_BOSS_ENEMY_DUNGEON_1, L_ENEMY_NAME, L_NO = -1, L_OPT
#DIM DYNAMIC L_NO
#DIM DYNAMIC L_ENEMY
#DIMS DYNAMIC L_ENEMY_NAME
#DIMS DYNAMIC L_OPT
#DIMS DYNAMIC L_ENEMY_TABLE, 10

L_ENEMY_TABLE:0 '= "ドウマン"

IF L_NO >= 0
	SIF !INRANGE(L_NO, 0, VARSIZE("L_ENEMY_TABLE") - 1)
		RETURN 0
	L_ENEMY_NAME '= L_ENEMY_TABLE:L_NO
ENDIF
IF L_OPT == "名称取得"
	SIF L_ENEMY_TABLE:L_NO == ""
		RETURN 0
	RESULTS '= L_ENEMY_NAME
	RETURN 1
ENDIF

SELECTCASE L_ENEMY_NAME
	CASE "ドウマン"
		CALL SET_ENEMY,9,[[キャラ:도우만]],10,0,1
		L_ENEMY = CHARANUM - 1
		;ボスフラグを立てたドウマンを配置
		;既にボスフラグによって強化されているが、更に個別に調整する。
		CFLAG:L_ENEMY:행동횟수 = 2
		CFLAG:L_ENEMY:ＨＰ보정 += 500
		TSTR:전투이벤트패턴 = エコービルドウマン
		CSTR:L_ENEMY:사고패턴 = エコービルドウマン
		ABL:L_ENEMY:스킬2 = [[스킬:잔]]
		ABL:L_ENEMY:스킬3 = [[스킬:숏잽]]
		ABL:L_ENEMY:스킬4 = [[스킬:돌려차기]]
		ABL:L_ENEMY:아이템1 = GETNUM(ITEM, "스킬카드【마하・라기】")
		ABL:L_ENEMY:입수확률1 = 100
		ABL:L_ENEMY:아이템2 = GETNUM(ITEM, "스킬카드【지오】")
		ABL:L_ENEMY:입수확률2 = 100
		ABL:L_ENEMY:아이템3 = GETNUM(ITEM, "터키석")
		ABL:L_ENEMY:입수확률3 = 100
		;戦闘中に登録番号をとるためにセットする。
		CALL SET_ENEMY_TIMEID, L_ENEMY, "ドウマン"
ENDSELECT
;ステータス同期と回復
CALL SET_UP_ENEMY
;=======================================================================

;敵特殊思考パターン

;=======================================================================
@SET_ACTION_エコービルドウマン, ARG
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
;ワンモア（クリティカルか、弱点を突いた場合の行動）
IF CFLAG:ARG:１more플래그 > 0
	;1more時はザンを打つ
	CALL SET_ACTION_SKILL, ARG, [[스킬:잔]]
;n+1ターンではザンor通常攻撃→ショートジャブ、n+2ターンはショートジャブを回し蹴りに
ELSEIF GROUPMATCH(FLAG:경과턴수 % 3 , 0 , 1)
	IF CFLAG:ARG:행동한횟수 == 0
		CALL SET_ACTION_SKILL, ARG, ( RAND:2 == 0 ? [[스킬:잔]] # 0 )
	ELSE
		CALL SET_ACTION_SKILL, ARG, ( FLAG:경과턴수 % 3 == 1 ? [[스킬:돌려차기]] # [[스킬:숏잽]] )
	ENDIF
;3の倍数ターンでは、マハ・ラギを前列→後列に。
;3ターンに1回確定で二回撃つようになっているが、それ以外のターンには絶対に撃たず、また水の壁が消されたところに二発目を打ち込まれる事もなくなっているので、
;水の壁やGUARDをきちんと使って攻略する場合は変更前より容易にドウマンの攻撃を防ぎやすくなっている。
ELSE
	CALL SET_ACTION_SKILL, ARG, [[스킬:마하・라기]]
	IF RESULT
		;1回目は前列にマハ・ラギ
		IF CFLAG:ARG:행동한횟수 == 0
			CFLAG:ARG:타겟 = 17
		;2回目は後列にマハ・ラギ
		ELSE
			CFLAG:ARG:타겟 = 18
		ENDIF
	ENDIF
ENDIF

;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;行動未決定時のおまじない
SIF CFLAG:ARG:입력행동 == -1
	CALL ランダム行動 , ARG
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1

