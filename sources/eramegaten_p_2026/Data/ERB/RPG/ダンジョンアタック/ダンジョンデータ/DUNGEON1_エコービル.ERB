;=======================================================================
;宝箱の中身
;=======================================================================
@TREASURE_1
#LOCALSIZE 3
;宝箱のフラグ管理用変数の番号
LOCAL = FLAG:현M + 70
;そのマップの何番目の宝箱か
LOCAL:1 = (DA:(FLAG:현X):(FLAG:현Y) / 10) % 100

;/10はIDを10で割る。つまり、下一桁をなくして、二桁目と三桁目を二桁の数字として取り出している
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) / 10
	;マップ番号*100+そのマップで何番目の宝箱かを示す数値でどの宝箱かを判別します。
	;例えば0の場合、0版のマップの0番目の宝箱であることを表しています。
	CASE 0
		;@GET_TREASURE,アイテム番号 , 入手個数 , ダンジョンナンバー , 開けた時に操作する変数の番号 , 変数に立てるビット
		;GETNUM(ITEM, "외상약")は_Rename.csvによって1001番が置換されて渡されます。これは傷薬のアイテム番号です。
		;そしてその個数が1個、ダンジョンナンバーは宝箱あけるときはよそのダンジョンをあけることがないだろうのでFLAG:現ダンジョンが無難です
		;LOCALはこの場合マップ番号の0+70で70が代入されています。そして、LOCAL:1にはこの宝箱がこのマップで何番目の宝箱か、つまり0が入っています
		;このように記述すると、宝箱を開けた場合ダンジョンフラグ:1(エコービルの番号):70 の0番目のビットが立ちます。
		;MAPをつくるときにこの宝箱はダンジョンフラグ:1(에코빌딩):70の0番目のビットが立っていない時しか置かないことになってるので、宝箱を開けるとこれで消えます
		CALL GET_TREASURE, GETNUM(ITEM, "외상약") , 1 , FLAG:현던전, LOCAL , LOCAL:1
	CASE 1
		CALL GET_TREASURE, GETNUM(ITEM, "스킬카드【숏잽】") , 1 , FLAG:현던전, LOCAL , LOCAL:1
		SIF RESULT
			DA:(FLAG:현X):(FLAG:현Y) = 24
	;百の位が1になりました。
	;これで以下の二つの宝箱はマップ番号1＝エコービル２Ｆの0番目、1番目の宝箱という事になります
	CASE 100
		CALL GET_TREASURE, GETNUM(ITEM, "스킬카드【아쿠아】") , 1 , FLAG:현던전, LOCAL , LOCAL:1
	CASE 101
		CALL GET_TREASURE, GETNUM(ITEM, "퀸뷰트") , 1 , FLAG:현던전, LOCAL , LOCAL:1
	CASE 200
		;罠箱
		;@GET_TREASURE_TRAP , 罠の種類 , ダメージ量or確率 , 相性番号 , ダンジョンナンバー , 開けた時に操作する変数の番号 , 変数に立てるビット
		;第一引数が"ＨＰ"か"ＭＰ"なら最大値に対する第二引数％の割合ダメージを、
		;バッドステータス名であれば第二引数％の確率でそのバッドステータスになります。この場合、第三引数の番号の相性に対する耐性で確率が変化します
		;この箱は味方全員のHPを25%減らす罠です。
		CALL GET_TREASURE_TRAP, "ＨＰ", 25 , GET_TYPE_NUM("만능") , FLAG:현던전, LOCAL , LOCAL:1
		
	CASE 201
		;@MAGIC_BOX , 指定する月齢 , 月齢が正しい時のアイテム、月齢が正しくない時のアイテム , 入手個数 , ダンジョンナンバー , 開けた時に操作する変数の番号 , 変数に立てるビット
		;現在の月齢によって手に入るアイテムの変わる箱です。
		;この場合、月齢8＝満月である場合に宝玉が1個手に入り、そうでない場合魔石1個が手に入ります
		CALL MAGIC_BOX , 8 , GETNUM(ITEM, "보옥") , GETNUM(ITEM, "마석") , 1 , FLAG:현던전, LOCAL , LOCAL:1
	CASE 300
		CALL GET_TREASURE, GETNUM(ITEM, "스킬카드【그라이】") , 1 , FLAG:현던전, LOCAL , LOCAL:1
	CASE 301
		;@GET_TREASURE_MONEY ,￥or魔貨 , 入手額 , ダンジョンナンバー , 開けた時に操作する変数の番号 , 変数に立てるビット
		;第一引数が0なら￥、1なら魔貨を入手します
		;この宝箱には￥3000が入っています
		CALL GET_TREASURE_MONEY, 0 , 3000 , FLAG:현던전, LOCAL , LOCAL:1
	CASE 302
		;トーテムメモリーを入手したことがあるかどうか
		IF IS_TOTEM_MEMORY_TAKEN:0
			;@GET_TREASURE_MAG ,  , 入手量 , ダンジョンナンバー , 開けた時に操作する変数の番号 , 変数に立てるビット
			;この宝箱には10000MAGが入っています
			CALL GET_TREASURE_MAG, , 10000 , FLAG:현던전, LOCAL , LOCAL:1
		ELSE
			CALL GET_TREASURE, GETNUM(ITEM, "토템메모리") , 1 , FLAG:현던전, LOCAL , LOCAL:1
			IS_TOTEM_MEMORY_TAKEN:0 = RESULT
		ENDIF
	CASE 400
		CALL GET_TREASURE, GETNUM(ITEM, "갖지못한자의반지") , 1 , FLAG:현던전, LOCAL , LOCAL:1
		
;	CASE 3
;		CALL GET_TREASURE,5000,2,FLAG:현던전,3
	;なお、1001はGETNUM(ITEM, "외상약")という記述も可能です
ENDSELECT
RETURN 1

