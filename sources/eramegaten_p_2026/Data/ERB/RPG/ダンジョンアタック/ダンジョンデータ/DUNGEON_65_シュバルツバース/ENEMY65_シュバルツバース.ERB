;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_65
SELECTCASE FLAG:현M
	CASE 0
		FLAG:미조우걸음수 = 0
		FLAG:인카운트율 = 0
		FLAG:MAG소비율 = 0
	CASEELSE
		FLAG:인카운트율 = 25
		SIF FLAG:미조우걸음수 < 5
			FLAG:인카운트율 = 0
ENDSELECT



;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_65
#LOCALSIZE 3
IF RAND:100 < FLAG:인카운트율
	;一方通行の処理
	CALL ONE_WAY(902, 912, 922, 932, 942, 952, 962, 972)
	RETURN 1
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF

@SET_ENEMY_STATUS_65, L_ENEMY
#DIM DYNAMIC L_ENEMY
#DIM DYNAMIC LCOUNT
FOR LCOUNT, 7, 17
	SIF POS(LCOUNT) < 0
		CONTINUE
	L_ENEMY = POS(LCOUNT)
	BREAK
NEXT
IF !GROUPMATCH(ABL:L_ENEMY:아이템2, GETNUM(ITEM, "백은의투구조각"), GETNUM(ITEM, "백은의갑옷조각"))
	IF RAND:2
		ABL:L_ENEMY:아이템2 = GETNUM(ITEM, "백은의투구조각")
	ELSE
		ABL:L_ENEMY:아이템2 = GETNUM(ITEM, "백은의갑옷조각")
	ENDIF
	ABL:L_ENEMY:입수확률2 = 5
ENDIF

;=======================================================================
;敵の種族の種類数
;=======================================================================
@CLASS_NUM_65
RETURN CLASS_NUM_COMMON("上級")
;=======================================================================
;敵の総数
;ARGは出現する敵の種類です
;=======================================================================
@ENEMY_NUM_65, ARG
RETURN ENEMY_NUM_COMMON("上級", ARG)

;=======================================================================
;敵の種類
;=======================================================================
@ENEMY_65, ARG
SELECTCASE FLAG:현M
	CASE 0
	CASE IS < 12
	CASE 12
		SELECTCASE RAND:100
			CASE IS < 15
				;15%でモー・ショボー
				RETURN [[キャラ:모・쇼보]], 25+RAND:4
			CASE IS < 35
				;20%でノズチ
				RETURN [[キャラ:노즈치]], 21+RAND:4
			CASE IS < 50
				;15%でグーラー
				RETURN [[キャラ:굴라]], 20+RAND:2
			CASE IS <70
				;20%でオーガ
				RETURN [[キャラ:오거]], 26+RAND:7
			CASE IS < 99
				;29%でシトリー
				RETURN [[キャラ:시트리]], 21+RAND:4
			CASEELSE
				;1%でドッペルゲンガー
				RETURN [[キャラ:도플갱어]], 56
		ENDSELECT
	CASE 13
		SELECTCASE RAND:100
			CASE IS < 30
				;30%でカラステング
				RETURN [[キャラ:카라스텐구]], 22+RAND:2
			CASE IS < 55
				;20%でドヴェルガー
				RETURN [[キャラ:드베르가]], 25+RAND:3
			CASE IS < 80
				;20%でアークエンジェル
				RETURN [[キャラ:아크엔젤]], 26+RAND:4
			CASEELSE
				;20%でクシナダヒメ
				RETURN [[キャラ:쿠시나다히메]], 23+RAND:5
		ENDSELECT
	
	CASE 14
		SELECTCASE RAND:100
			CASE IS < 25
				;20%でハンサ
				RETURN [[キャラ:한사]], 28+RAND:4
			CASE IS < 60
				;35%でバンシー
				RETURN [[キャラ:밴시]], 21+RAND:4
			CASE IS < 80
				;20%でセイレーン
				RETURN [[キャラ:세이렌]], 25
			CASEELSE
				;20%でノズチ
				RETURN [[キャラ:노즈치]], 23+RAND:4
		ENDSELECT
	
	CASE 15
		SELECTCASE RAND:100
			CASE IS < 15
				;15%でパワー
				RETURN [[キャラ:파워]], 21+RAND:4
			CASE IS < 35
				;20%でデメテール
				RETURN [[キャラ:데메테르]], 21+RAND:4
			CASE IS < 65
				;30%でネコマタ
				RETURN [[キャラ:네코마타]], 23+RAND:8
			CASEELSE
				;35%でエルフ
				RETURN [[キャラ:엘프]], 21+RAND:10
		ENDSELECT
	
	CASE 16
		SELECTCASE RAND:100
			CASE IS < 35
				;35%でメズキ
				RETURN [[キャラ:메즈키]], 21+RAND:4
			CASE IS < 55
				;20%でナガスネヒコ
				RETURN [[キャラ:나가스네히코]], 27+RAND:4
			CASE IS < 80
				;20%でラームジェルグ
				RETURN [[キャラ:람데르그]], 29+RAND:4
			CASEELSE
				;20%でアンズー
				RETURN [[キャラ:안주]], 21+RAND:4
		ENDSELECT

	CASE IS < 26
		SELECTCASE RAND:100
			CASE IS < 30
				SELECTCASE FLAG:현M
					CASE IS < 20
						RETURN [[キャラ:성성이]], 34+RAND:4
					CASE IS < 23
						RETURN [[キャラ:유키죠로]], 32+RAND:4
					CASE IS < 26
						RETURN [[キャラ:탁비]], 31+RAND:4
 					CASE 26
 						RETURN [[キャラ:탁비]], 31+RAND:4
				ENDSELECT
			CASE IS < 60
				SELECTCASE FLAG:현M
					CASE IS < 20
						RETURN [[キャラ:인큐버스]], 31+RAND:5
					CASE IS < 23
						RETURN [[キャラ:단탈리온]], 32+RAND:4
					CASE IS < 26
						RETURN [[キャラ:락샤사]], 31+RAND:4
					CASE 26
 						RETURN [[キャラ:탁비]], 31+RAND:4
				ENDSELECT
			CASE IS < 80
				SELECTCASE FLAG:현M
					CASE IS < 20
						RETURN [[キャラ:인큐버스]], 32+RAND:4
					CASE IS < 23
						RETURN [[キャラ:바포멧트]], 32+RAND:4
					CASE IS < 26
						RETURN [[キャラ:웬디고]], 31+RAND:2
					CASE 26
 						RETURN [[キャラ:탁비]], 31+RAND:4
				ENDSELECT
			CASEELSE
				SELECTCASE FLAG:현M
					CASE IS < 20
						RETURN [[キャラ:파워]], 37+RAND:4
					CASE IS < 23
						RETURN [[キャラ:청우괴]], 36+RAND:4
					CASE IS <26
						RETURN [[キャラ:오시치]], 37+RAND:4
					CASE 26
 						RETURN [[キャラ:탁비]], 31+RAND:4
				ENDSELECT
		ENDSELECT
	
	
	
ENDSELECT
