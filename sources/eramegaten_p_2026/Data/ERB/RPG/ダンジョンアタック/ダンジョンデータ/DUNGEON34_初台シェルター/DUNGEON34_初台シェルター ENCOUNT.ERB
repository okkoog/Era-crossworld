;=======================================================================
;必要レベル目安
;推奨LV 雑魚最低LV 雑魚最高LV ボスLV 
;=======================================================================
@GET_DUNGEON_LV_34
RETURN 5, 3, 13, 15
;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_34
;---- EDIT P 001 MOD START -------------------------
IF FLAG:튜토리얼진행중
	FLAG:인카운트율 = 0
ELSE
	IF FLAG_D34_チュートリアル利用済み
		FLAG:인카운트율 = FLAG:미조우걸음수 * 10
	ELSE
		IF FLAG:현M < 8
			FLAG:인카운트율 = FLAG:미조우걸음수 > 5 ? FLAG:미조우걸음수*5 # 0
		ELSEIF FLAG:현M == 9
			FLAG:인카운트율 = FLAG:미조우걸음수 > 5 ? FLAG:미조우걸음수*5 + 10 # 0
		ELSE
			FLAG:인카운트율 = FLAG:미조우걸음수 > 5 ? FLAG:미조우걸음수*5 + 20 # 0
		ENDIF
	ENDIF
ENDIF
;---- EDIT P 001 MOD END ---------------------------
;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_34
;---- EDIT P 001 MOD START -------------------------
IF FLAG:튜토리얼진행중
	FLAG:MAG소비율 = 0
	RETURN 0
ELSE
	IF FLAG_D34_チュートリアル利用済み
		IF RAND:100 < FLAG:인카운트율
			FLAG:MAG소비율 = 50
			FLAG:선제기습취소 = 1
			RETURN 1
		ELSE
			FLAG:미조우걸음수 += 1
		ENDIF
	ELSE
		IF RAND:100 < FLAG:인카운트율
			IF FLAG_D34_チュートリアル中
				FLAG:선제기습취소 = 1
				FLAG_D34_ゾンビ戦中断用 = 0
			ENDIF
			RETURN 1
		ELSE
			FLAG_D34_ゾンビ戦中断用 = 0
			FLAG:미조우걸음수 += 1
			RETURN 0
		ENDIF
	ENDIF
ENDIF
;---- EDIT P 001 MOD END ---------------------------
;=======================================================================
;敵の種族の種類数
;=======================================================================
@CLASS_NUM_34
;チュートリアル
;---- EDIT P 001 MOD START -------------------------
IF FLAG_D34_チュートリアル利用済み
	SELECTCASE RAND:100
		CASE IS < 70
			RETURN 1
		CASEELSE
			RETURN 2
	ENDSELECT
ELSE
	SELECTCASE RAND:100
		CASE IS < 40
			RETURN 1
		CASE IS < 95
			RETURN 2
		CASEELSE
			RETURN 3
	ENDSELECT
ENDIF
;---- EDIT P 001 MOD END ---------------------------
;=======================================================================
;敵の総数
;=======================================================================
@ENEMY_NUM_34, ARG
SELECTCASE ARG
	CASE 1
		RETURN RAND(1, 3)
	CASE 2
		RETURN RAND(2, 5)
	CASE 3
		RETURN RAND(3, 6)
ENDSELECT

;=======================================================================
;敵の種類
;=======================================================================
@ENEMY_34, ARG
;チュートリアル終了後に再突入した場合
IF FLAG_D34_チュートリアル利用済み
	SELECTCASE RAND:100
		CASE IS < 10
			RETURN [[キャラ:라타토스크]], 3
		CASE IS < 35
			RETURN [[キャラ:좀비쨩]], 2
		CASE IS < 60
			RETURN [[キャラ:좀비군]], 4
		CASE IS < 85
			RETURN [[キャラ:좀비너스]], 4
		CASEELSE
			RETURN [[キャラ:좀비독]], 3
	ENDSELECT
ELSE
	SELECTCASE FLAG:현M
		;五階まで
		CASE IS < 6
			SELECTCASE RAND:100
				CASE IS < 15
					;15%でピクシーLv3
					RETURN [[キャラ:픽시]], 3
				CASE IS < 30
					;15%でアプサラスLv5
					RETURN [[キャラ:아프사라스]], 5
				CASE IS < 50
					;20%でゾンビちゃんLv4
					RETURN [[キャラ:좀비쨩]], 4
				CASE IS < 60
					;15%でゾンビくんLv7
					RETURN [[キャラ:좀비군]], 7
				CASE IS < 70
					;10%でゾンビドッグ
					RETURN [[キャラ:좀비독]], 3
				CASE IS < 80
					;15%でコボルトLv5
					RETURN [[キャラ:코볼트]], 5
				CASE IS < 90
					;10%でノッカーLv4
					RETURN [[キャラ:노커]], 4
				CASE IS < 100
					;10%でガキLv4
					RETURN [[キャラ:아귀]], 4
			ENDSELECT
		;六階-七階
	CASE IS < 8
		SELECTCASE RAND:100
			CASE IS < 15
				;15%でアプサラス
				RETURN [[キャラ:아프사라스]], 5
			CASE IS < 30
				;15%でラタトスクLv5
				RETURN [[キャラ:라타토스크]], 5
			CASE IS < 45
				;15%でゾンビちゃん
				RETURN [[キャラ:좀비쨩]], 7
			CASE IS < 50
				;5%でゾンビナース
				RETURN [[キャラ:좀비너스]], 8
			CASE IS < 55
				;5%でモコイLv6
				RETURN [[キャラ:모코이]], 6
			CASE IS < 65
				;10%でゴブリンLv7
				RETURN [[キャラ:고블린]], 7
			CASE IS < 75
				;10%でカーシーLv6
				RETURN [[キャラ:카시]], 6
			CASE IS < 90
				;15%でガキ
				RETURN [[キャラ:아귀]], 7
			CASE IS < 100
				;10%でゾンビくん
				RETURN [[キャラ:좀비군]], 7
		ENDSELECT
	;七階-九階
	CASE IS < 10
		SELECTCASE RAND:100
			CASE IS < 5
				;5%でリリムLv9
				RETURN [[キャラ:리림]], 9
			CASE IS < 15
				;10%でシルキーLV7
				RETURN [[キャラ:실키]], 7
			CASE IS < 30
				;15%でラタトスク
				RETURN [[キャラ:라타토스크]], 8
			CASE IS < 45
				;15%でゾンビちゃん　ランク1
				RETURN [[キャラ:좀비쨩]], 7
			CASE IS < 50
				;5%でゾンビナース
				RETURN [[キャラ:좀비너스]], 8
			CASE IS < 55
				;5%でモコイランク1
				RETURN [[キャラ:모코이]], 9
			CASE IS < 65
				;10%でゴブリン
				RETURN [[キャラ:고블린]], 7
			CASE IS < 75
				;10%でカーシー
				RETURN [[キャラ:카시]], 9
			CASE IS < 85
				;10%でアンドラス
				RETURN [[キャラ:안드라스]], 8
			CASE IS < 100
				;15%でゾンビくん
				RETURN [[キャラ:좀비군]], 7
		ENDSELECT
	CASEELSE
		SELECTCASE RAND:100
			CASE IS < 15
				;15%でリリム　ランク1
				RETURN [[キャラ:리림]], 12
			CASE IS < 25
				;10%でシルキー　ランク1
				RETURN [[キャラ:실키]], 10
			CASE IS < 40
				;15%でゾンビちゃん　ランク2
				RETURN [[キャラ:좀비쨩]], 10
			CASE IS < 50
				;10%でゾンビナース
				RETURN [[キャラ:좀비너스]], 11
			CASE IS < 60
				;10%でブラウニー
				RETURN [[キャラ:브라우니]], 11
			CASE IS < 75
				;15%でイヌガミ
				RETURN [[キャラ:이누가미]], 13
			CASE IS < 90
				;15%でゾンビくん　ランク1
				RETURN [[キャラ:좀비군]], 10
			CASE IS < 100
				;10%でアンドラス　ランク1
				RETURN [[キャラ:안드라스]], 11
		ENDSELECT
	ENDSELECT
ENDIF

;=======================================================================
;輪姦参加悪魔
;=======================================================================
@DUNGEON_RAPE_DEVIL_34
;ランダムにどの悪魔が出るか決定
;RETURN CSV番号 , 人数 , レベル
SELECTCASE RAND:4
	CASE 0
		RETURN [[キャラ:노커]] , 6 + RAND:15 , CSVBASE([[キャラ:노커]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 1
		RETURN [[キャラ:코볼트]] , 3 + RAND:10 , CSVBASE([[キャラ:코볼트]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 2
		RETURN [[キャラ:아귀]] , 3 + RAND:10 , CSVBASE([[キャラ:아귀]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 3
		RETURN [[キャラ:좀비군]] , 3 + RAND:10 , CSVBASE([[キャラ:좀비군]] , GETNUM(BASE , "LV") , 0) + RAND:3
ENDSELECT