;=======================================================================
;タイル調整
;=======================================================================
;ARG:1、ARG:2はそれぞれX座標とY座標
;ARGはその座標に現在代入されている番号
;0：壁　1：床もしくは通路　2：扉　3：宝箱　4：イベント　5：罠　6：上り階段 7：下り階段　8：出口　9：その他特殊処理等
;これらの内、3～9が代入されているマスに、個別の番号を与える処理を実行します。
;この処理を行った後、これらのマスには 「マップ番号*1000 + そのマスがそのマップで左上から数えて何個目のARGタイプのマスか*10 + ARG」が代入されます
;例えば 2003 であった場合、「2番のマップ＝３Ｆで、左上から数えて0個目の3＝宝箱である」ということを意味しています
;尚、0～2はどのマップにも大量に設置されるので、ここでは基本的に個別の番号を与えません。
;
;何個目のARGタイプのマスなのか、は左上の(0,0)から右まで探し、その後一つ下の段に移って同様に探す、というのを右下まで繰り返して数えます。
@MAKE_FLOOR_LINE_COMMON_34, ARG, ARG:1, ARG:2
#LOCALSIZE 10
;LOCAL:0～9 それぞれ何個目のARGなのかを記憶しています
;LOCAL:3 宝箱→使用フラグはダンジョンフラグ:70~74
;指定された座標が(0,0)である場合、つまり新しいマップを読み込んだ時はLOCALを消去します
SIF ARG:1 == 0 && ARG:2 == 0
	VARSET LOCAL
SELECTCASE ARG
	CASE 3
		;宝箱は多くの場合、開けたフラグが立っていると床を代入します
		;そのマップでどの宝箱を開けたかは、そのマップの宝箱管理用変数の何番目のビットが立っているかで判断します
		IF GETBIT(ダンジョンフラグ:(FLAG:현던전):(FLAG:현M / 5 + 80), (FLAG:현M % 5 * 10 + LOCAL:3))
			DA:(ARG:1):(ARG:2) = 1
		ELSE
			DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:3 * 10 + 3
		ENDIF
		LOCAL:3++
	CASE 4 TO 9
		DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + LOCAL:ARG * 10 + ARG
		LOCAL:ARG++
	;イベント扉
	CASE 12
		DA:(ARG:1):(ARG:2) = FLAG:현M *1000 + (LOCAL:2 + 1) * 10 + 2
		LOCAL:2++
	CASE IS > 9
		DA:(ARG:1):(ARG:2) = ARG
ENDSELECT
CALL REPLACE_TILE_DUNGEON_34, DA:(ARG:1):(ARG:2), ARG:1, ARG:2

;=======================================================================
;タイル破棄
;イベントが終わった床・扉を通常マスに置き換える
;=======================================================================
@REPLACE_TILE_DUNGEON_34, ARG, ARG:1, ARG:2
SELECTCASE ARG % 10
	CASE 2
		SELECTCASE ARG / 10
			CASE 401
				SIF FLAG_D34_中ボスゾンビの群れ
					DA:(ARG:1):(ARG:2) = 2
			CASE 901
				SIF FLAG_D34_クリアフラグ
					DA:(ARG:1):(ARG:2) = 2
			CASE 9
				SIF !FLAG_D34_シェルター封鎖
					DA:(ARG:1):(ARG:2) = 2
		ENDSELECT
	CASE 4
		SELECTCASE ARG / 10
			CASE 0
				SIF !FLAG:튜토리얼진행중
					DA:(ARG:1):(ARG:2) = 1
				SIF FLAG_D34_ライドウ参戦
					DA:(ARG:1):(ARG:2) = 1
			CASE 1
				SIF !FLAG:튜토리얼진행중
					DA:(ARG:1):(ARG:2) = 1
				SIF FLAG_D34_COMPチュートリアル
					DA:(ARG:1):(ARG:2) = 1
			CASE 100
				SIF !FLAG:튜토리얼진행중
					DA:(ARG:1):(ARG:2) = 1
				SIF FLAG_D34_戦闘チュートリアル
					DA:(ARG:1):(ARG:2) = 1
			CASE 400
				SIF FLAG_D34_中ボスゾンビの群れ
					DA:(ARG:1):(ARG:2) = 1
			CASE 700
				SIF !FLAG:튜토리얼진행중
					DA:(ARG:1):(ARG:2) = 1
				;マップ製作タイミングでバステ4種耐性が埋まってたらつぶしてしまう
				SIF GET_D34_TUTOLIAL_BADSTATE_ENEMY() == 0
					FLAG_D34_オキクムシ撃破 = 1
				SIF FLAG_D34_オキクムシ撃破
					DA:(ARG:1):(ARG:2) = 1
			CASE 800
				;この時点でモーショボーがいるならつぶしてしまう
				SIF GETCHARA([[キャラ:모・쇼보]]) >= 0
					FLAG_D34_中ボスマシン = 1
				SIF FLAG_D34_中ボスマシン
					DA:(ARG:1):(ARG:2) = 1
			CASE 900
				SIF FLAG_D34_クリアフラグ
					DA:(ARG:1):(ARG:2) = 1
		ENDSELECT
	CASE 9
ENDSELECT

