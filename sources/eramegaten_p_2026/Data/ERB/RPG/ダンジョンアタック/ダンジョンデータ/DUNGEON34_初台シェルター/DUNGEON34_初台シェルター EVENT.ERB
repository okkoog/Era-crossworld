;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_34
#DIM LCOUNT
PRINTL
;タイトル画像表示
CALL PRINT_EVENT_PICTURE, "06_初台シェルタータイトル", 10, "CENTER"
WAIT
DRAWLINE
;チュートリアル
;IF FLAG:전투난이도 >= 3 || FLAG:주회횟수 >= 1 || ダンジョンフラグ:1:1 == 1 || ダンジョンフラグ:34:8 == 1 || BASE:MASTER:LV >= 11
;---- EDIT P 001 MOD START -------------------------
IF FLAG:튜토리얼진행중
;---- EDIT P 001 MOD END ---------------------------
	IF FLAG:첫탐색종료
		FLAG:튜토리얼진행중 = 0
		FLAG_D34_チュートリアル利用済み = 1
	ELSE
		FLAG_D34_シェルター封鎖 = 1

		;---- EDIT 002 ADD START -------------------------
		VARI L_POS
		VARI L_CHARA
		;突入前にCOMPに入れないキャラを外す
		FOR L_POS, 1, 7
			L_CHARA = POS(L_POS)
			SIF L_CHARA < 0
				CONTINUE
			SIF L_CHARA == MASTER
				CONTINUE
			CALL REMOVE_POSITION, L_POS
		NEXT
		CALL REFRESH_FORMATION
		;---- EDIT 002 ADD END ---------------------------

		CALL MESSAGE_WINDOW_D, "", @"＞하츠다이 쉘터로 향하던 도중、/＞%CALLNAME:MASTER%의 휴대단말기가 울리기 시작했다"
		CALL MESSAGE_WINDOW_D, "마요네", "후후……첫 임무중인가 보네？"
		IF GETCHARA([[キャラ:마리]]) == -1
			IF RAND:2 == 0
				CALL MESSAGE_WINDOW_D, "", "＞대화 소리에、질퍽질퍽한 음란한 물소리가 섞여 있다……/＞노예를 곁에 두고 있는 것일까"
			ELSE
				CALL MESSAGE_WINDOW_D, "", "＞대화 소리에、욕정에 젖은 여자의 달콤한 신음이 섞여 있다……/＞노예를 곁에 두고 있는 것일까"
			ENDIF
		ENDIF
		CALL MESSAGE_WINDOW_D, "마요네", "재밌는 소식을 전해드릴께요/당신이 향한 하츠다이 쉘터 근처에/낡아빠진 “쿠즈노하”의 서머너가 머물고 있는 것 같네요"
		CALL MESSAGE_WINDOW_D, "마요네", "쿠즈노하는 우리들과 적대하는 조직……/만나게 된다면、적어도 기분을 상하게 하지는 않도록 노력하세요？"
		IF GETCHARA([[キャラ:도리]]) == -1
			CALL MESSAGE_WINDOW_D, "", @"＞쿡쿡 웃는 마요네의 목소리에、/＞%\@RAND:2?찰싹#철썩\@% 하는 채찍 소리가 겹쳤다。"
			CALL MESSAGE_WINDOW_D, "소녀 같은 목소리", @"%\@RAND:2?주인님、용서ㄹ……#\힉、도와……\@%。"
			CALL MESSAGE_WINDOW_D, "", @"＞%\@RAND:2?비명#흐느낌\@%과 함께 통화가 끊겼다……"
		ELSE
			CALL MESSAGE_WINDOW_D, "", "＞비웃는 듯한 충고를 남기고、통화는 일방적으로 끊어졌다"
		ENDIF
		CALL MESSAGE_WINDOW_D, "", "………/……/…"
		CALL MESSAGE_WINDOW_D, "", "＞튜토리얼 이벤트가 개시되었습니다/＞파티가 해산되었으니 주의해주세요"
	ENDIF
ENDIF
CALL MAKE_FLOOR, FLAG:현던전

;=======================================================================
;指定したマスに侵入しようとする際のイベント
;=======================================================================
@DUNGEON_BEFORE_ENTER_EVENT_34, L_X, L_Y, L_DIRECTION
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC L_TILE
#DIM DYNAMIC L_DIRECTION
L_TILE = DA:L_X:L_Y
SELECTCASE L_TILE
	CASE 8
		IF FLAG:튜토리얼진행중 && FLAG_D34_ライドウ参戦
			CALL MESSAGE_WINDOW_D_ICON, , "00_ゴウト", "", "고우토", "겁먹었나？/우리들에게 가르침 받을 수 있는 기회는/오늘뿐이라고 미리 말해두지"
			CALL INPUT_YN_D
			IF RESULT == 0
				CALL MESSAGE_WINDOW_D_ICON, , "00_ゴウト", "", "고우토", "그럼、안녕이다/정진하도록、팬텀・소사이어티의 데빌서머너여"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "＞고우토와 라이도우가 파티에서 떠났다"
				CALL 全ゲスト削除
				FLAG:탈출스킬금지 = 0
				FLAG:탈출 = 1
				RETURN 0
			ELSE
				CALL MESSAGE_WINDOW_D_ICON, , "00_ゴウト", "", "고우토", "그렇다면、탐색을 계속하지"
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "＞고우토가 재촉하듯 던전의 앞을 가리킨다"
				RETURN 0
			ENDIF
		ELSE
			CALL DUNGEON_EXIT
			RETURN 0
		ENDIF
	CASE 7
		;---- EDIT P 002 MOD START -------------------------
		IF FLAG:튜토리얼진행중
			;ラタトスクを出してないと進めない……が、合体とか削除で消せるのでいない場合も見ておく
			IF FLAG_D34_COMPチュートリアル == 1 && GETCHARA([[キャラ:라타토스크]]) >= 0 && FINDCHARA_B([[キャラ:라타토스크]]) == 1
				CALL MESSAGE_WINDOW_D_ICON, , "00_ゴウト", "", "고우토", "신입이여、라타토스크를 ＣＯＭＰ에서 소환한 다음 앞으로 나아가라"
				RETURN 0
			ELSE
				FLAG_D34_COMPチュートリアル = 2
			ENDIF
		ELSE
			IF FLAG_D34_クリアフラグ && FLAG_D34_チュートリアル利用済み
				CALL MESSAGE_WINDOW_D_ICON, , "BLANK", , "", "＞더이상 앞은 용무가 없다……"
				RETURN 0
			ENDIF
		ENDIF
		;---- EDIT P 002 MOD END ---------------------------
	CASE 92
		CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "", "", "＞문은 완전히 봉쇄되어 있다……"
		RETURN 0
	CASE 4012
		IF FLAG:튜토리얼진행중
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "", "", "＞문 너머에서 뼛속까지 스며들 정도의 죽음의 냄새가 풍겨욘다……"
			CALL MESSAGE_WINDOW_D_ICON, , "00_ゴウト", "", "고우토", "흠、수가 많군/신입이여、문을 열면 전투가 시작된다。준비는 되었나？"
			CALL INPUT_YN_D, "문을 연다", "문을 열지 않는다"
		ELSE
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "", "", "＞죽음의 냄새가 난다/＞문을 열까？"
			CALL INPUT_YN_D
		ENDIF
		RETURN !RESULT
	CASE 9012
		IF FLAG:튜토리얼진행중
			CALL MESSAGE_WINDOW_D_ICON, , "BLANK", "", "", "＞문 너머에서、키보드를 두드리는 소리가 들린다"
			CALL MESSAGE_WINDOW_D_ICON, , "00_ゴウト", "", "고우토", "아무래도 여기가、이 이계의 중심인 것 같군/신입이여、이 앞은 실전이다。우리도 지도해 줄 여유가 없다/준비는 되었나？"
		ELSE
			CALL MESSAGE_WINDOW_D, "", "＞문 너머에서、키보드를 두드리는 소리가 들린다/＞문을 열겠습니까？"
		ENDIF
		CALL INPUT_YN_D
		RETURN !RESULT
ENDSELECT
CALL CAN_ENTER,L_X,L_Y
RETURN RESULT

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_34,ARG,ARG:1
IF FLAG:현M == 5 && ARG ==1 && ARG:1 == 9 && ダンジョンフラグ:34:9 == 0
	CALL MESSAGE_WINDOW_D, "", "＞죽음의 냄새가 난다/＞문을 열까？"
	CALL INPUT_YN_D
ELSEIF FLAG:현M == 9
	IF ARG == 7 && ARG:1 == 9 && !ダンジョンフラグ:34:8
		CALL MESSAGE_WINDOW_D, "", "＞문 너머에서、키보드를 두드리는 소리가 들린다/＞문을 열겠습니까？"
		CALL INPUT_YN_D
		SIF RESULT
			RETURN 0
		;PRINTFORML 
		;PRINTFORML 　　　　＞扉の向こうから、キーボードを叩く音が聞こえる
		;PRINTFORML 
		;PRINTFORML 　　　　＞誰かがいるようだ……
		;PRINTFORML 
		;PRINTFORMW 　　　　＞扉を開けますか？
		;PRINTFORML 
		;PRINTFORML 　　　　　　[0]はい
		;PRINTFORML 
		;PRINTFORML 　　　　　　[1]やめておく　
		;INPUT
		;SIF RESULT
		;	RETURN 0
	ENDIF
ENDIF
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT
;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_34
;==========
;出口の処理
;==========
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) % 10
	CASE 8
		CALL DUNGEON_EXIT
		RETURN 1
;========
;宝の処理
;========
	CASE 3
		CALL TRESURING_CALLING_34
		RETURN 1
;==========
;イベントの処理
;==========
	CASE 4, 9
		CALL EVENTING_CALLING_34
		RETURN 1
;=======
;階段
;=======
	CASE 6
		CALL DUNGEON_UPSTAIRS_ID, FLAG:현M-1 , (FLAG:현M-1) * 1000 + 7
		RETURN 1
	CASE 7
		CALL DUNGEON_DOWNSTAIRS_ID, FLAG:현M+1 , (FLAG:현M+1) * 1000 + 6
		RETURN 1
	CASEELSE
		PRINTFORML 
		PRINTFORMW 　　　　＞아무것도 없다
		RETURN 0
ENDSELECT

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_34,ARG
;ARG = 進入時の向き　0の場合ワープなど
;==========
;出口の処理
;==========
SELECTCASE DA:(FLAG:현X):(FLAG:현Y) % 10
	CASE 8
		CALL DUNGEON_EXIT
		RETURN 1
;========
;宝の処理
;========
	CASE 3
		CALL TRESURING_CALLING_34
		RETURN 1
;==========
;イベントの処理
;==========
	CASE 4, 9
		CALL EVENTING_CALLING_34
		CALL REPLACE_TILE_DUNGEON_34, DA:(FLAG:현X):(FLAG:현Y), FLAG:현X, FLAG:현Y
		RETURN 1
;=======
;階段
;=======
	CASE 6
		CALL DUNGEON_UPSTAIRS_ID, FLAG:현M-1 , (FLAG:현M-1) * 1000 + 7
		RETURN 1
	CASE 7
		CALL DUNGEON_DOWNSTAIRS_ID, FLAG:현M+1 , (FLAG:현M+1) * 1000 + 6
		RETURN 1
;==========
;扉の処理
;==========
	CASE 2
		CALL DUNGEON_DOOR,ARG
		RETURN 1
ENDSELECT
RETURN 0

;=======================================================================
;イベントまとめ
