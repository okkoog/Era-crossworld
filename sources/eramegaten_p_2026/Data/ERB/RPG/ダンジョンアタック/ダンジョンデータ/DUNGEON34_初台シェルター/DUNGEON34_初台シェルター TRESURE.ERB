;=======================================================================
;宝箱まとめ
;=======================================================================
@TRESURING_CALLING_34
SELECTCASE FLAG:현M
	CASE 5
		CALL GETS_TREASURE,"디스포이즌",2,34,1
	CASE 6
		IF FLAG:현X == 1 && FLAG:현Y == 8
			CALL GETS_TREASURE,"외상약",3,34,15
		ELSEIF FLAG:현X == 12 && FLAG:현Y == 3
			CALL GETS_TREASURE,"마석",2,34,2
		ENDIF
	CASE 7
		IF FLAG:현X == 6 && FLAG:현Y == 7
			CALL GETS_TREASURE,"메디컬파우더",1,34,3
		ELSE
			IF IS_TOTEM_MEMORY_TAKEN:2
				CALL GET_TREASURE_MAG, , 10000 , 35, 22
			ELSE
				CALL GET_TREASURE, GETNUM(ITEM, "토템메모리") , 1 , 34, 22
			ENDIF
		ENDIF
	CASE 8
		IF FLAG:현X == 13 && FLAG:현Y == 8
			;200魔貨
			CALL GET_TREASURE_MONEY, 1, 200, 34,4
		ELSEIF FLAG:현X == 5 && FLAG:현Y == 7
			CALL GETS_TREASURE, "쇠파이프형산탄총", 1,34,5
		ENDIF
	CASE 9
		CALL GETS_TREASURE,"천구신부",2,34,6
ENDSELECT
RETURN 0