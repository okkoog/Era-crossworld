;=======================================================================
;敵AI
;=======================================================================
;有効仲魔
;ナイトメア　戦技無効なので校長の突撃に耐性を持つ
;

;校長
;やっぱ、物理はクリティカル来るから強いすなぁ
;そして、暗黒ヤング伝説で毎回1MOREプレゼントするリサが涙目すぎた
;
;攻略メモ
;主人は聖なる弾渡すようにしてあるし、聖弾COOP狙い
;達哉は後列ならドリル飛んでこなくて安全なので、後列からアギラオ連発
;リサは使いものにならないので、前列にたたせて毎ターンガードで壁運用推奨
;栄吉はテトラジャ、他にアギ使いがいればヤマオロシとあわせて火炎撃、もしくはクリティカル1MORE対策でGUARDか

;有効仲魔：火力は主人の銃弾と達哉のアギラオで足りるので欲しいのは壁。全体的に有効なのがD-Cで主人・達哉とCOOPとりにくいのが難か
;モコイ　氷結・呪殺無効で、通常攻撃と突撃以外は通らないので壁として強い
;ナイトメア　戦技打撃無効で、通常攻撃と突撃無効。加入レベルに難はあるがこれも強い
;ゾンビちゃん・ゾンビくん　なにげに戦技を減らす。暗黒ヤング伝説耐性を持つ。ステータスも壁向き
;はなこ　呪殺無効・戦技打撃無効で、氷結以外回避可能。明王神符や炎の壁を使えば鉄壁…だけど12レベルはやや高め
;カハク　炎の壁でさぶさぶドリルを防げ、またアギでCOOPをとれる。入れるなら後衛

;ただまぁ基本的に物理クリ1MOREからの追撃が怖いんで、前衛は全員GUARDで、主人と達哉でアタック＋ディア係一人とかがいいきもする
;危うければ、主人のメディカルパウダーもあるか

;ノリコ
;テストしてみると思ってた以上にJOKERが渋かった
;何が渋いって、実質３回攻撃になって、マハ・アクアと重なるとマジ渋い
;というわけで、とりあえずマハ・アクアの確率をかなり下げとく
;水は符・壁ないから、やっぱ強いなぁという気分に
;なにげに克哉のCOOPが弱いせいで、同じくアギラオ使えるたっちゃんとダメージ差がでかすぎた
;まったく、L-Lとか！
;
;攻略メモ
;舞耶は後ろ推奨。ディアラマ・メディアで無難に回復。ひっかきもちいれば、ライトスマッシャーという手も
;克哉はたっちゃんとおなじく後ろでアギラオ担当、COOP加算弱めになると思うんでいまいち火力不足
;うららはマグナスあるとはいえ、微妙度高いんで前立ってガード推奨
;主人はやっぱり聖弾COOP狙い

;有効仲魔　後衛が主人公・舞耶・克哉で固定に近く、主人公克哉で十分攻撃力を確保できるので欲しいのは壁。水属性耐性があるといい
;モコイ　水撃無効。攻撃役には使いづらいが、壁として強い
;アプサラス　水撃半減
;ドリアード　水撃半減・なにげに通常攻撃にもやや耐性あり

;オールドメイドはGUARDで防げるんで、来たら全員ガード…にはちょっと確率高いか
;ただまぁ、3人ガードしてればくる確率半減するんで、きてたら少なくとも前衛はガードさせときたい
;あとは回復が普通に潰される可能性があるんで、舞耶と主人（メディカルパウダーと牛黄丹があるはず）の2本体制でいくのがおすすめ
@SET_ACTION_ハンニャ校長, ARG
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
;1more時はサブサブドリル固定
IF CFLAG:ARG:１more플래그 > 0
	CFLAG:ARG:입력행동 = [[스킬:사부사부드릴]]
ELSEIF CFLAG:ARG:행동한횟수 == 0
	SELECTCASE RAND:100
		CASE 0 TO 24
			CFLAG:ARG:입력행동 = 0
		CASE 25 TO 49
			CFLAG:ARG:입력행동 = [[스킬:돌격]]
		CASEELSE
			CFLAG:ARG:입력행동 = [[스킬:사부사부드릴]]
	ENDSELECT
ELSE
	SELECTCASE RAND:100
		CASE 0 TO 49
			IF RAND:2
				CFLAG:ARG:입력행동 = 0
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:돌격]]
			ENDIF
		CASEELSE
			IF 現HP割合(ARG) < 50 || RAND:2
				CFLAG:ARG:입력행동 = [[스킬:암흑YOUNG전설]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:사부사부드릴]]
			ENDIF
	ENDSELECT
ENDIF
;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1
@SET_ACTION_ＪＯＫＥＲノリコ, ARG
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
;1more時はアクア固定
IF CFLAG:ARG:１more플래그 > 0
	CFLAG:ARG:입력행동 = [[스킬:아쿠아]]
ELSEIF CFLAG:ARG:행동한횟수 == 0
	CALL OLDMADE, ARG
	SELECTCASE RAND:100
		CASE 0 TO 20
			CFLAG:ARG:입력행동 = [[스킬:아쿠아]]
		CASE 21 TO 39
			CFLAG:ARG:입력행동 = [[스킬:마린카린]]
		CASE 40 TO 49
			CFLAG:ARG:입력행동 = [[스킬:마하・아쿠아]]
		CASE 50 TO 74
			TSTR = オールドメイド
			;オールドメイド
			CFLAG:ARG:입력행동 = [[스킬:ＤＵＭＭＹ]]
		CASEELSE
			CFLAG:ARG:입력행동 = 0
	ENDSELECT
ELSE
	SELECTCASE RAND:100
		CASE 0 TO 49
			CFLAG:ARG:입력행동 = 0
		CASEELSE
			CFLAG:ARG:입력행동 = [[스킬:아쿠아]]
	ENDSELECT
ENDIF
;アクション実行不能なら自動的に通常攻撃にする
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
IF RESULT == 0
	CFLAG:ARG:입력행동 = 0
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
ENDIF
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1
@ENEMY_BATTLE_MESSAGE_K[[キャラ:ＪＯＫＥＲ노리코]], ARG
;オールドメイド処理、対象を初期ペルソナに保存しておく
IF CFLAG:ARG:입력행동 == [[스킬:ＤＵＭＭＹ]]
	PRINTFORMW 아군 중 누군가에게 ＪＯＫＥＲ가 빙의했다！
	WHILE 1
		LOCAL = RAND:6 + 1
		SIF POS(LOCAL) >= 0 && GET_STATE(CFLAG:POS(LOCAL):상태이상) != "DYING"
			BREAK
		LOCAL = 0
	WEND
	ABL:ARG:초기페르소나 = POS(LOCAL)
ENDIF

;力技で、JOKERノリコを最速行動させて、そこで処理を行う
@EVENT_BATTLE_TURNTOP_DUNGEON50
IF FLAG:경과턴수 > 0
	LOCAL = GETCHARA([[キャラ:ＪＯＫＥＲ노리코]])
	SIF LOCAL == -1
		RETURN 0
	SIF ABL:LOCAL:초기페르소나 == -1
		RETURN 0
	CFLAG:LOCAL:속도보정 += 50000
ENDIF
;オールドメイド処理
;前のターンで選んだ対象キャラが攻撃を選んでいた場合、攻撃対象を強制変更させられてしまう
@OLDMADE, ARG
LOCAL = ABL:ARG:초기페르소나
SIF LOCAL == -1
	RETURN 0
CFLAG:ARG:속도보정 -= 50000
;ポジションについてない場合は終わる
SIF CPOS(LOCAL) <= 0
	GOTO END
SIF CFLAG:LOCAL:입력행동 == -1
	GOTO END
CFLAG:LOCAL:입력행동 = [[스킬:ＪＯＫＥＲ]]
CFLAG:LOCAL:타겟 = 19
$END
ABL:ARG:초기페르소나 = -1


;=======================================================================
;輪姦参加悪魔
;=======================================================================
@DUNGEON_RAPE_DEVIL_50
;ランダムにどの悪魔が出るか決定
;RETURN CSV番号 , 人数 , レベル
SELECTCASE RAND:2
	CASE 0
		RETURN [[キャラ:모코이]] , 3 + RAND:10 , CSVBASE([[キャラ:모코이]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 1
		RETURN [[キャラ:좀비군]] , 3 + RAND:10 , CSVBASE([[キャラ:좀비군]] , GETNUM(BASE , "LV") , 0) + RAND:3
ENDSELECT
