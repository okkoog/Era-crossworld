;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_50
IF STRFLAG_D("敵出現なし") || STRFLAG_D("ボス撃破")
	FLAG:인카운트율 = 0
ELSE
	IF FLAG:미조우걸음수 <= 5
		FLAG:인카운트율 = 0
	ELSE
		FLAG:인카운트율 = 10 + (FLAG:미조우걸음수-5) * 5
	ENDIF
ENDIF
;=======================================================================
;必要レベル目安
;推奨LV 雑魚最低LV 雑魚最高LV ボスLV 
;=======================================================================
@GET_DUNGEON_LV_50
RETURN 11, 8, 12, 12
;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_50
IF RAND:100 < FLAG:인카운트율
	RETURN 1
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF
;=======================================================================
;敵の種族の種類数
;=======================================================================
@CLASS_NUM_50
RETURN CLASS_NUM_COMMON("初級")
;=======================================================================
;敵の総数
;ARGは出現する敵の種類です
;=======================================================================
@ENEMY_NUM_50, ARG
RETURN ENEMY_NUM_COMMON("初級", ARG)
;=======================================================================
;敵の種類
;=======================================================================
@ENEMY_50, ARG
SELECTCASE RAND:100
	CASE IS < 19
		;20%でナイトメア
		RETURN [[キャラ:나이트메어]], 8 + RAND:3 * 2
	CASE IS < 39
		;20%でラタトスク
		RETURN [[キャラ:라타토스크]], 8 + RAND:3 * 2
	CASE IS < 59
		;20%でピクシー
		RETURN [[キャラ:픽시]], 8 + RAND:3 * 2
	CASE IS < 74
		;15%でゾンビちゃん
		RETURN [[キャラ:좀비쨩]], 8 + RAND:3 * 2
	CASE IS < 89
		;15%でゾンビくん
		RETURN [[キャラ:좀비군]], 8 + RAND:3 * 2
	CASEELSE
		;10%でモコイ
		RETURN [[キャラ:모코이]], 8 + RAND:3 * 2
ENDSELECT
