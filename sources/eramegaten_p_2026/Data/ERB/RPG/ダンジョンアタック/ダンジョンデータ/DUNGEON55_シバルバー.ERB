;----------------------------------------------
;ボロンティック
;스킬1 1:프레이다인 2;이클립스미러 3:闇のフォーミラーバー 4:피의디포즈 5:테라포츈
;스킬2 1:다크노바사이저 2:부흐다인 3:마그다인 4:아쿠아다인 5:갈다인
;스킬3 1:메갈로파이어 2:절대영도 3:헬데저트 4:멜스트롬 5:스톰나이트메어
;
;２はスキル３が絶対零度なので純粋に4種攻撃
;それ以外は即死スキルを低確率・全体スキルをやや低確率で撃ってくる
;
;四天王同様の連戦仕様
;それぞれの使用相性の幅は狭いので対策してるキャラなら一人撃破も容易
;ただ対策なしで即死系にひっかかると崩れかねないので注意か
;
;即死防ぐだけならテトラが有効だけど呪殺にひっかかるからガードエンジェルか
;まぁ人間はきつい気がする
;---------------------------------------------
@SET_ACTION_ボロンティック, ARG
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
IF CFLAG:ARG:행동한횟수 == 0
	SELECTCASE RAND:100
		CASE IS < 30
			CFLAG:ARG:입력행동 = 0
		CASE IS < 60
			CFLAG:ARG:입력행동 = ABL:ARG:스킬2
		CASE IS < 80
			CFLAG:ARG:입력행동 = ABL:ARG:스킬1
		CASEELSE
			CFLAG:ARG:입력행동 = ABL:ARG:스킬3
	ENDSELECT
ELSE
	SELECTCASE RAND:100
		CASE IS < 40
			CFLAG:ARG:입력행동 = 0
		CASE IS < 80
			CFLAG:ARG:입력행동 = ABL:ARG:스킬2
		CASEELSE
			CFLAG:ARG:입력행동 = ABL:ARG:스킬1
	ENDSELECT
ENDIF
;アクション実行不能
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1

@SET_ACTION_ボロンティック２, ARG
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
SELECTCASE RAND:100
	CASE IS < 30
		CFLAG:ARG:입력행동 = 0
	CASE IS < 60
		CFLAG:ARG:입력행동 = ABL:ARG:스킬2
	CASE IS < 80
		CFLAG:ARG:입력행동 = ABL:ARG:스킬1
	CASEELSE
		CFLAG:ARG:입력행동 = ABL:ARG:스킬3
ENDSELECT
;アクション実行不能
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
	
;----------------------------------------------
;フューラー
;----------------------------------------------
@SET_ACTION_フューラー, ARG
#LOCALSIZE 3
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1
SIF 現HP割合(ARG) <= 25
	CFLAG:ARG:행동횟수 = 3
IF !TFLAG:적오메가클러스터
	CFLAG:ARG:입력행동 = [[스킬:오메가클러스터]]
ELSEIF CFLAG:ARG:１more플래그 > 0
	CFLAG:ARG:입력행동 = [[스킬:성궤]]
ELSEIF CFLAG:ARG:행동한횟수 == 0
	;聖杯のクール制御
	TFLAG:435++
	;波紋チェック
	LOCAL:1 = 0
	;ンダは-8まで容認
	SIF MINARRAY(CFLAG:ARG:0, GETNUM(CFLAG, "공격강화"), GETNUM(CFLAG, "BS부착률강화") + 1) < -8
		LOCAL:1 = 1
	;味方のうち一人から判定する
	LOCAL = POS(RAND(1, 7))
	IF LOCAL >= 0
		;カジャは8まで容認
		SIF MAXARRAY(CFLAG:LOCAL:0, GETNUM(CFLAG, "공격강화"), GETNUM(CFLAG, "BS부착률강화") + 1) > 8
			LOCAL:1 = 1
		;反射も波紋対象
		SIF CFLAG:LOCAL:물리반사플래그 || CFLAG:LOCAL:마법반사플래그
			LOCAL:1 = 2
	ENDIF
	;波紋フラグが立っている時
	IF (LOCAL:1 == 1 && RAND:2) || (LOCAL:1 == 2 && !RAND:3)
		CFLAG:ARG:입력행동 = [[스킬:포말의파문]]
		TFLAG:435 += 3
	;1/3で反射は聖櫃送り
	ELSEIF LOCAL:1 == 2 && RAND:2
		CFLAG:ARG:입력행동 = [[스킬:성궤]]
	ELSE
		SELECTCASE RAND:100
			CASE IS < 50
				CFLAG:ARG:입력행동 = [[스킬:성창]]
			CASE IS < 75
				CFLAG:ARG:입력행동 = [[스킬:ＭＧ３４]]
			CASEELSE
				CFLAG:ARG:입력행동 = [[스킬:성궤]]
		ENDSELECT
	ENDIF
ELSEIF CFLAG:ARG:행동한횟수 == 1
	SELECTCASE RAND:100
		CASE IS < 50
			;聖杯はクール期間がある
			IF TFLAG:435 < 3
				CFLAG:ARG:입력행동 = [[스킬:성창]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:성배]]
				TFLAG:435 = 0
			ENDIF
		CASE IS < 75
			CFLAG:ARG:입력행동 = [[스킬:ＭＧ３４]]
		CASEELSE
			CFLAG:ARG:입력행동 = [[스킬:브릴블리츠]]
	ENDSELECT
ELSE
	SELECTCASE RAND:100
		CASE IS < 25
			CFLAG:ARG:입력행동 = [[스킬:성창]]
		CASE IS < 50
			CFLAG:ARG:입력행동 = [[스킬:ＭＧ３４]]
		CASE IS < 75
			CFLAG:ARG:입력행동 = [[스킬:성궤]]
		CASEELSE
			CFLAG:ARG:입력행동 = [[스킬:브릴블리츠]]
	ENDSELECT
ENDIF

;アクション実行不能
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1


