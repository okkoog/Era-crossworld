;=======================================================================
;카루코자카고교
;ボス オキュペテー / モー・ショボー２体
;ダンジョンナンバー2　ＭＡＰ0~5
;=======================================================================
;フラグ
;ダンジョンフラグ:2:0-10 = 宝箱
;ダンジョンフラグ:2:11 = モーショボー撃破フラグ(1.倒した)
;ダンジョンフラグ:2:12 = レイコフラグ(1.奴隷にした 2.放っておいた)
;ダンジョンフラグ:2:13 = オキュペテーフラグ(1.倒した)
;ダンジョンフラグ:2:14 = ターミナル発見フラグ
;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_2
;REQ2 카루코자카고교체육관(1)＆（２）をクリアしていなければダメ
IF (依頼フラグ:[[依頼:카루코자카고교체육관(1)]]:0 == 1 && 依頼フラグ:[[依頼:카루코자카고교체육관(2)]]:0 == 1) && ダンジョンフラグ:2:11 == 0
	RETURN 1
ELSE
	RETURN 0
ENDIF


;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_2
#FUNCTIONS
RESULTS_F = 軽子坂高校


;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_2,ARG,ARG:1
IF DA:ARG:(ARG:1) == 12
	CALL MESSAGE_WINDOW_D, "", "문 너머에서 무서운 기운이 느껴진다…"
	CALL INPUT_SELECT_D, "[0] 문을 연다/[1] 열지 않는다 "
	SIF RESULT
		RETURN 0
	;通った場合はただの扉にする
	DA:ARG:(ARG:1) = 2
	RETURN 1
ENDIF
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_2

;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) % 10 == 8
	CALL DUNGEON_EXIT
	RETURN 1

;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
	CALL TREASURE_2_0
	
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 6
	CALL UPSTAIRS_2_0
	
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 7
	CALL DOWNSTAIRS_2_0

;========
;이벤트
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 4
	CALL DUNGEON_EVENT_2_0
ELSE
	CALL MESSAGE_WINDOW_D, "", "＞아무것도 없는 것 같다"
	RETURN 0
ENDIF

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_2,ARG
;ARG = 進入時の向き　0の場合ワープなど
;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) % 10 == 8
	CALL DUNGEON_EXIT
	RETURN 1

;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
	CALL TREASURE_2_0

;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 6
	CALL UPSTAIRS_2_0

ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 7
	CALL DOWNSTAIRS_2_0

;==========
;扉の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 2
	CALL DUNGEON_DOOR,ARG
	RETURN 1

;===========
;이벤트
;===========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 4
	CALL DUNGEON_EVENT_2_0
ENDIF
RETURN 0

;=======================================================================
;輪姦参加悪魔
;=======================================================================
@DUNGEON_RAPE_DEVIL_2
;ランダムにどの悪魔が出るか決定
;RETURN CSV番号 , 人数 , レベル
SELECTCASE RAND:4
	CASE 0
		RETURN [[キャラ:잇폰다타라]] , 3 + RAND:10 , CSVBASE([[キャラ:잇폰다타라]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 1
		RETURN [[キャラ:좀비군]] , 3 + RAND:10 , CSVBASE([[キャラ:좀비군]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 2
		RETURN [[キャラ:세에레]] , 3 + RAND:10 , CSVBASE([[キャラ:세에레]] , GETNUM(BASE , "LV") , 0) + RAND:3
	CASE 3
		RETURN [[キャラ:브라우니]] , 3 + RAND:10 , CSVBASE([[キャラ:브라우니]] , GETNUM(BASE , "LV") , 0) + RAND:3
ENDSELECT

