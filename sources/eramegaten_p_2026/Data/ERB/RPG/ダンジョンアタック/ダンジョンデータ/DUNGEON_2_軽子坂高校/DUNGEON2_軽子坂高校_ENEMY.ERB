
;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_2
FLAG:인카운트율 = FLAG:미조우걸음수*3
SIF FLAG:미조우걸음수 < 8
	FLAG:인카운트율 = 0

;=======================================================================
;必要レベル目安
;推奨LV 雑魚最低LV 雑魚最高LV ボスLV 
;=======================================================================
@GET_DUNGEON_LV_2
RETURN 12, 11, 17, 19

;=======================================================================
;エンカウント処理（共通）
;=======================================================================
@CHECK_ENCOUNT_2
IF RAND:100 < FLAG:인카운트율
	RETURN 1
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF


;=======================================================================
;敵の種族の種類数
;=======================================================================
@CLASS_NUM_2
RETURN CLASS_NUM_COMMON("初級")

;=======================================================================
;敵の総数
;ARGは出現する敵の種類です
;RAND(X, Y)はX～Y-1のうちのどれかになるRANDです
;なお、ここで帰った数字は下限を種族数、上限を10として自動的に調整されます
;
;軽子坂高校も初期のダンジョンなので数は抑え目
;=======================================================================
@ENEMY_NUM_2, ARG
	RETURN ENEMY_NUM_COMMON("初級", ARG)

;=======================================================================
;敵の種類
;=======================================================================
@ENEMY_2, ARG
;===========
;카루코자카고교
;===========
SELECTCASE FLAG:현M
	;下層での遭遇
	CASE 0, 1, 2
		SELECTCASE RAND:100
			CASE IS < 15
				RETURN [[キャラ:좀비쨩]], 12
			CASE IS < 25
				RETURN [[キャラ:요모츠시코메]], 14
			CASE IS < 35
				RETURN [[キャラ:하나코]], 13
			CASE IS < 45
				RETURN [[キャラ:리림]], 12
			CASE IS < 55
				RETURN [[キャラ:네코마타]], 12
			CASE IS < 70
				RETURN [[キャラ:좀비군]], 12
			CASE IS < 80
				RETURN [[キャラ:케트시]], 12
			CASE IS < 90
				RETURN [[キャラ:브라우니]], 11
			CASE IS < 100
				RETURN [[キャラ:이누가미]], 12
		ENDSELECT
	;上層での遭遇
	CASEELSE
		SELECTCASE RAND:100
			CASE IS < 15
				RETURN [[キャラ:좀비쨩]], 15
			CASE IS < 25
				RETURN [[キャラ:요모츠시코메]], 14
			CASE IS < 35
				RETURN [[キャラ:파리카]], 14
			CASE IS < 45
				RETURN [[キャラ:카시마레이코]], 17
			CASE IS < 55
				RETURN [[キャラ:드라이어드]], 15
			CASE IS < 70
				RETURN [[キャラ:좀비군]], 15
			CASE IS < 80
				RETURN [[キャラ:잭프로스트]], 12
			CASE IS < 90
				RETURN [[キャラ:잇폰다타라]], 13
			CASE IS < 100
				RETURN [[キャラ:세에레]], 16
		ENDSELECT
ENDSELECT