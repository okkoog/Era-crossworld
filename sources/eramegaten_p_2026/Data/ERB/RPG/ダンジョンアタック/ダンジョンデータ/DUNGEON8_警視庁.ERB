;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_8

;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 3
	CALL TREASURE_8
	RETURN RESULT
	
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 6
	CALL UPSTAIRS_8
	RETURN RESULT

ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 7
	CALL DOWNSTAIRS_8
	RETURN RESULT
ELSE
	CALL MESSAGE_WINDOW_D, , "＞아무것도 없는 것 같다"
	RETURN 0
ENDIF

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_8,ARG
;ARG = 進入時の向き　0の場合ワープなど
;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 3
	CALL TREASURE_8
	RETURN RESULT
	
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 6
	CALL UPSTAIRS_8
	RETURN RESULT

ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 7
	CALL DOWNSTAIRS_8
	RETURN RESULT


;==========
;扉の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 2
	CALL DUNGEON_DOOR,ARG
	RETURN 1


;========================
;이벤트
;========================
	
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 1004 && ダンジョンフラグ:8:20 != 1
	;나이트・테일(단품 판매) 시、생존자의 기척을 느낀다
	IF イベントフラグ:30:0 == 3
		CALL MESSAGE_WINDOW_D, , "＞쾅쾅쾅……콰직……우지끈……！/＞격렬한 전투음이 어디선가 울려 퍼지고 있다"
		CALL MESSAGE_WINDOW_D, , "＞이 이계에、아직 생존자가 있는 모양이다"
		ダンジョンフラグ:8:20 = 1
		DA:(FLAG:현X):(FLAG:현Y) = -1
		RETURN 1
	ENDIF
	
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 1014 && ダンジョンフラグ:8:21 != 1
	;나이트・테일(단품 판매) 시、미야시타 GET 이벤트 발생
	IF イベントフラグ:30:0 == 3
		CALL MESSAGE_WINDOW_D, , "＞기계 잔해 위에서 무장한 경찰관 차림의 남자가 주저앉아 있다。/＞옷이나 장비는 너덜너덜하지만、눈빛은 아직 살아있다。/＞좀비는 아닌 것 같다。"
		CALL MESSAGE_WINDOW_D, "미야시타 쇼고" , "「당신은…… 그렇군、팬텀의 데빌서머너인가」"
		CALL MESSAGE_WINDOW_D, "미야시타 쇼고" , "「위층에 남겨진 직원이 있어。/　동료들도 당했지。나 혼자서 어떻게든 해보려 했지만……/　한심하게도 보다시피 이 꼴이다、라는 거지」"
		CALL MESSAGE_WINDOW_D, "미야시타 쇼고" , "「부탁하네、당신이 어떤 자들인지는 알고 있지만、/　협력해주지 않겠나？」"
		CALL INPUT_YN_D
			IF RESULT == 0;y
					CALL MESSAGE_WINDOW_D, "미야시타 쇼고" ,"「고맙군。당신에게 방해는 되지 않겠네」"
					CALL MESSAGE_WINDOW_D, , "＞미야시타 쇼고가 당신의 뒤를 따라온다……/　조금 신경 쓰이지만、저쪽은 저쪽대로 스스로 지킬 수 있는 모양이다。/　내버려 두자。"
					ダンジョンフラグ:8:21 = 1
					
			ELSEIF RESULT == 1;n
