;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_8
SIF BASE:MASTER:LV < 30
	RETURN 0
RETURN 1


;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_8
#FUNCTIONS
RESULTS_F = 警視庁


;=======================================================================
;フロア名表示
;=======================================================================
@FLOORNAME_8
PRINT 경시청
SELECTCASE FLAG:현M
	CASE 0
		PRINTL Ｂ１Ｆ
	CASE 1
		PRINTL １Ｆ
	CASE 2
		PRINTL ２Ｆ
	CASE 3
		PRINTL ３Ｆ
	CASE 4
		PRINTL ４Ｆ
	CASEELSE
		PRINTL ５Ｆ
ENDSELECT

;=======================================================================
;ターミナルマップ
;=======================================================================
@TERMINAL_MAP_8, IS_START
#DIM DYNAMIC IS_START
RESULT:5 = 1
RESULTS:5 '= "터미널"
RETURN RESULT

;=======================================================================
;特殊タイル表示
;=======================================================================

@TILE_MARK_COMMON_8_9, ARG, ARG:1, ARG:2
IF FLAG:현M < 5
	IF GET_FLOOR_ANALYZE_T(ARG:1, ARG:2) == 2
		RESULTS = 穴
	ELSE
		RESULTS = □
	ENDIF
ELSE
	RESULTS = 扉
ENDIF

@TILE_MARK_8_5_8_5
RESULTS = □

@TILE_MARK_8_5_3_1
RESULTS = Ｔ

;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_8,ARG
FLAG:현M = 0
FLAG:현X = 9
FLAG:현Y = 15
;CALL AUTOMAP

;=======================================================================
;スタート時イベント
;=======================================================================
@EVENT_DUNGEON_START_8
IF ダンジョンフラグ:8:13 == 0
	CALL MESSAGE_WINDOW_D, , "＞" + CALLNAME:MASTER + "는 경시청의 의뢰를 받았다/＞아무래도 경시청이 갑자기 이계화、경비 로봇도 폭주한 것 같다"
	CALL MESSAGE_WINDOW_D, , "＞경비 로봇은 국가 기밀이기 때문에、실력자라 불리는 " + CALLNAME:MASTER + "에게 비밀리에 해결을 요청한 것 같다"
	
	;나이트・테일 루트를 타고 있고、미야시타 동행 시에는 텍스트가 늘어난다
	IF FINDCHARA_B([[キャラ:쇼고]],0) == 2 && イベントフラグ:30:0 == 1
		CALL MESSAGE_WINDOW_D, "미야시타 쇼고" , "원래대로라면 저희 0과의 담당입니다./뭐니 뭐니 해도 저희는 내부 사람이니까、/“비밀리에” 처리하기엔 안성맞춤이겠죠. 하지만……"
		CALL MESSAGE_WINDOW_D, , "＞미야시타는 장비를 점검하면서 말을 잇는다"
		CALL MESSAGE_WINDOW_D, "미야시타 쇼고" , "공안이 훼방을 놓아온 겁니다./SAT를 돌입시킬 테니、뻔히 청사를 빼앗긴 『오컬트 동호회』에는 맡길 수 없다면서요./네에、관료 조직의 약점이라는 놈이죠。"
		CALL MESSAGE_WINDOW_D, , "＞거기서 이권이니 체면이니 하며 옥신각신하다가、이야기가 풀리지 않게 된 모양이다。/그래서 사태를 무겁게 본 미야시타의 아버지――부총감이다――가、/뒷줄을 써서 팬텀・소사이어티에 접근해 온 모양이다"
		CALL MESSAGE_WINDOW_D, "미야시타 쇼고" , "네에、저희 아버지가 말씀하시길、/「수단을 가릴 틈이 있겠냐？」/라면서요"
		CALL MESSAGE_WINDOW_D, , "＞지당한 이야기다"
		;추가로 고토우 동행 시
		IF FINDCHARA_B([[キャラ:고토우]],0) == 2
			CALL MESSAGE_WINDOW_D, "고토우", "나라면、이것을 개입의 실마리로 삼겠다。군도 눈독을 들이고 있겠지"
			CALL MESSAGE_WINDOW_D, , "＞고토우의 덧붙임에、미야시타는 크게 한숨을 쉬었다"
		ENDIF
		CALL MESSAGE_WINDOW_D, "미야시타 쇼고" , "더 이상의 방해가 들어오기 전에、우선은 팬텀의 용병이 돌입、/정보 수집과 이계화의 근원을 무너뜨린 뒤에、/그 다음 SAT든 기동대든 뭐든 쳐넣어서 소탕하면 된다……라는 겁니다"
		CALL MESSAGE_WINDOW_D, , "＞" + CALLNAME:MASTER + "는 고액의 보수를 기대하면서 이계화한 경시청으로 발을 들여놓았다…"
	ELSE
		CALL MESSAGE_WINDOW_D, , "＞" + CALLNAME:MASTER + "는 고액의 보수를 기대하면서 이계화한 경시청으로 발을 들여놓았다…"
	ENDIF
	ダンジョンフラグ:8:13 = 1
ENDIF
;=======================================================================
;脱出時のイベント
;=======================================================================
@EVENT_DUNGEON_END_8
IF ダンジョンフラグ:8:11 && !ダンジョンフラグ:8:12
	CALL SHOW_PICTURE, "D"
	CALL MESSAGE_WINDOW_D, "", "＞경시청을 구한 보수로 100,000엔을 입수했다/＞또한、200의 명성을 얻었다"
	MONEY += 100000
	FLAG:명성 += 200
	ダンジョンフラグ:8:12 = 1
ENDIF

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@JUDGE_CAN_ENTER_8, L_X, L_Y, L_DIRECTION, L_ROUTENUM = -1, DUNGEON_TILE_SEARCH_TASK
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC L_TILE
#DIM DYNAMIC L_DIRECTION
#DIM DYNAMIC L_ROUTENUM
#DIM REF DUNGEON_TILE_SEARCH_TASK
CALL CAN_ENTER, L_X, L_Y
RETURN RESULT

;=======================================================================
;タイル侵入時時イベント
;=======================================================================
@DUNGEON_BEFORE_ENTER_EVENT_8,L_X,L_Y,L_DIRECTION
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC L_TILE
#DIM DYNAMIC L_DIRECTION
IF DA:L_X:L_Y == 9 && FLAG:현M == 5 && !ダンジョンフラグ:8:14
	CALL MESSAGE_WINDOW_D, , "＞ＩＤ카드를…ＩＤ카드를…/＞ＩＤ카드를…ＩＤ카드를…"
	CALL MESSAGE_WINDOW_D, , "＞문은 망가져 있는 것 같다…"
ENDIF
CALL CAN_ENTER,L_X,L_Y
RETURN RESULT
