;=======================================================================
;선샤인시티
;突入には史人君必須、これ以降の偽典ダンジョンも同条件とする
;使用フラグ
;37:0 アバドン撃破フラグ
;37:1 レラジエ撃破フラグ
;37:2 突入フラグ
;37:3 アメノウズメフラグ
;37:10～ 宝箱フラグ
;=======================================================================

;=======================================================================
;攻略条件
;=======================================================================

@PREREQUISITE_DUNGEON_37
SIF (イベントフラグ:70:0 < 2 || イベントフラグ:70:0 == 99)
	RETURN 0
IF !(FINDCHARA_B([[キャラ:아야토]],0) == 2)
	RESULTS = 카츠라기 아야토의 편성
	RETURN -1
ENDIF
RETURN 1

;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_37
#FUNCTIONS
RESULTS_F = シャンシャンシティ

;=======================================================================
;フロア名表示
;=======================================================================
@FLOORNAME_37
PRINT 선샤인시티
SELECTCASE FLAG:현M
	CASE 0
		PRINTL   １Ｆ
	CASE 1
		PRINTL   ２Ｆ
	CASE 2
		PRINTL   ３Ｆ
	CASE 3
		PRINTL   ４Ｆ
	CASE 4
		PRINTL   ５Ｆ
	CASE 5
		PRINTL   ６Ｆ
	CASE 6
		PRINTL   ７Ｆ
	CASE 7
		PRINTL   ８Ｆ
	CASE 8
		PRINTL   ９Ｆ
	CASE 9
		PRINTL   １０Ｆ
	CASE 10
		PRINTL   ６０Ｆ
	CASEELSE
		PRINTL
ENDSELECT


;=======================================================================
;特殊タイル表示
;=======================================================================



@TILE_MARK_37_9_1_12
RESULTS = Ｅ

@TILE_MARK_37_10_1_12
RESULTS = Ｅ

@TILE_MARK_37_10_3_4
RESULTS = □

@TILE_MARK_37_10_3_5
RESULTS = 宝




;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_37,ARG
FLAG:현M = 0
FLAG:현X = 7
FLAG:현Y = 1
;CALL AUTOMAP

;=======================================================================
;ターミナルマップ
;RESULT:X = 1で階層Mのマップのターミナルを登録できる
;登録されたターミナル同士は相互で移動が可能になり、スタート地点から選べるようになる
;
;RESULTS:100は入り口の名称。入り口のままでいいなら定義する必要はない
;=======================================================================
@TERMINAL_MAP_37, IS_START
#DIM DYNAMIC IS_START
RESULT:9 = 1
RESULTS:9 '= "터미널"
RETURN RESULT

;=======================================================================
;攻略開始時のイベント
;=======================================================================
@EVENT_DUNGEON_START_37
IF ダンジョンフラグ:37:2 == 0
	CALL MESSAGE_WINDOW_D, "", @"＞" + CALLNAME:MASTER + "는 카츠라기와 함께/＞악마의 감옥으로 변한 선샤인 시티로 왔다。"
	CALL MESSAGE_WINDOW_D, "", "＞카츠라기에 의하면 이 장소도 아스카 루이가 가르쳐줬다는 모양이다。"
	CALL MESSAGE_WINDOW_D, "", "＞듣자하니 막강한 힘을 가진 악마가 지배하고 있다는 소문이 있으며/＞그것 말고도 데빌 버스터들이 잡혀 있다는 소문 도 있다고 한다。"
	CALL MESSAGE_WINDOW_D, "", "＞옛 동료와 만나기 위해서라도 카츠라기는 이곳을 조사하기로 했다고 한다…"
	ダンジョンフラグ:37:2 = 1
ENDIF

;=======================================================================
;脱出時のイベント
;=======================================================================
@EVENT_DUNGEON_END_37
IF ダンジョンフラグ:37:1 == 0 && ダンジョンフラグ:37:0 != 0
	CALL SHOW_PICTURE, "D"
	CALL MESSAGE_WINDOW_D, "", @"＞팬텀의 학자에게 타치바나의 팔을 맡기기 위해、/＞" + CALLNAME:MASTER + "는 카츠라기와 함께 팬텀의 본부로 가고 있었다…"
	CALL MESSAGE_WINDOW_D, "", "＞…！ 팬텀의 본부 앞에 사냥꾼의 모습을 한 악마가 있다！"
	CALL MESSAGE_WINDOW_D, "레라지에", "처음 뵙겠습니다、저는 타천사 레라지에라고 합니다/거기 있는 카츠라기의 전 연인、타치바나 양을 죽이고 오른팔을 가져간 악마지요"
	CALL MESSAGE_WINDOW_D, "레라지에", "그러니까、저는 여러분께 결투를 신청하겠습니다/제가 이기면、여러분이 가진 타치바나 양의 왼팔을 가져가겠습니다/여러분이 이긴다면 제가 가진 오른팔은 여러분의 것이 되겠지요"
	CALL MESSAGE_WINDOW_D, "레라지에", "어떻습니까、나쁘지는 않은 조건이죠?"
	CALL MESSAGE_WINDOW_D, "", "＞조직에게도 이런 악마에게 본부를 파악당한 것은 위험한 일이다/＞이 자리에서 처리하자…"
	CALL MESSAGE_WINDOW_D, "레라지에", "호오、아무래도 결투를 받아주시는 것 같군요/그럼、정정당당히 승부를！"
	FLAG:도주불가플래그 = 1
	FLAG:회화불능플래그 = 1
	FLAG:선제기습취소 = 1
	CALL SET_ENEMY, 9, [[キャラ:레라지에]],50,0,5;レラジエ
	MAXBASE:(CHARANUM-1):파마 = 0
	MAXBASE:(CHARANUM-1):주살 = 0
	CFLAG:(CHARANUM-1):행동횟수 = 2
	BASE:(CHARANUM-1):힘 += 10
	BASE:(CHARANUM-1):지혜 += 10
	BASE:(CHARANUM-1):마력 += 10
	BASE:(CHARANUM-1):내구 += 10
	BASE:(CHARANUM-1):속도 += 10
	BASE:(CHARANUM-1):운 += 10
	CALL BATTLE_START
	FLAG:도주불가플래그 = 0
	FLAG:회화불능플래그 = 0
	FLAG:선제기습취소 = 0
	CALL MESSAGE_WINDOW_D, "", "＞죽은 레라지에의 사체에서 인간의 것으로 보이는 오른팔이 나타났다…/＞역시 맥박이 뛰고 있다、연구에 적합할 것이다"
	CALL MESSAGE_WINDOW_D, "", "＞타치바나의 두 팔을 조직에 넘기고 100000엔의 사례비를 입수했다…"
	MONEY += 100000
ダンジョンフラグ:37:1 = 1
イベントフラグ:70:0 = 3
ENDIF
;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_37,ARG,ARG:1

CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

