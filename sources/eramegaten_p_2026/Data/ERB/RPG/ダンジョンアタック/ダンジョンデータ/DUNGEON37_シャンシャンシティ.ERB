;==========
IF DA:(FLAG:현X):(FLAG:현Y) % 10 == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
;宝箱のフラグ管理用変数の番号
LOCAL = FLAG:현M + 10
	SELECTCASE FLAG:현M
