;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_25,ARG,ARG:1
;ARG、ARG:1はそれぞれ対象のマスのX、Y座標を表しています。
;このダンジョンではエレベーターの扉が一度右側から開けておかないと左側からは開けられない、という処理に使用しています。
;どのマップでも座標(2,7)がエレベータの扉。ダンジョンフラグ:(FLAG:현던전):13 ＝ エレベータフラグ管理用変数の{現在のマップ番号}番目のビットが立っていなければ開けられるかどうかの判定を行う
;ボス前
IF DA:ARG:(ARG:1) == 52
	CALL MESSAGE_WINDOW_D, "", "＞문 너머에서 무서운 기운이 느껴진다…/　나아가겠습니까？"
	CALL INPUT_YN,"네","아니오"
	IF RESULT == 0
		CALL CAN_ENTER,ARG,ARG:1
		RETURN RESULT
	ELSE
		RETURN 0
	ENDIF
;水場
ELSEIF DA:ARG:(ARG:1) == 10
	RETURN 0
;空中
ELSEIF DA:ARG:(ARG:1) == 20
	RETURN 0
ELSE
	CALL CAN_ENTER,ARG,ARG:1
	RETURN RESULT
ENDIF


