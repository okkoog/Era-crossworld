	CASE 10 TO 14
		RETURN ENEMY_NUM_COMMON("中級", ARG)
	CASE 15 TO 60 
		RETURN ENEMY_NUM_COMMON("中級", ARG)
	CASEELSE
		RETURN ENEMY_NUM_COMMON("上級", ARG)
ENDSELECT
;=======================================================================
;敵の種類
;=======================================================================
@ENEMY_25, ARG
SELECTCASE FLAG:현M
	CASE IS < 4
		SELECTCASE RAND:100
			CASE IS < 30
				;30%でサラシナヒメ
				RETURN [[キャラ:사라시나히메]], 30+RAND:(1+(FLAG:현M))
			CASE IS < 55
				;25%でフジムスメ
				RETURN [[キャラ:후지무스메]], 31+RAND:(1+(FLAG:현M))
			CASE IS < 70
				;15%でセンリ
				RETURN [[キャラ:선리]], 33+RAND:(1+(FLAG:현M))
			CASE IS < 85
				;15%でハクジョウシ
				RETURN [[キャラ:백낭자]], 34+RAND:(1+(FLAG:현M))
			CASE IS < 100
				;10%でおしち
				RETURN [[キャラ:오시치]], 35+RAND:(1+(FLAG:현M))
		ENDSELECT
	CASE 4, 28
		SELECTCASE RAND:100
			CASE IS < 30
				;30%でサラシナヒメ
				RETURN [[キャラ:사라시나히메]], 34
			CASE IS < 55
				;25%でフジムスメ
				RETURN [[キャラ:후지무스메]], 35
			CASE IS < 70
				;15%でセンリ
				RETURN [[キャラ:선리]], 37
			CASE IS < 85
				;15%でハクジョウシ
				RETURN [[キャラ:백낭자]], 38
			CASE IS < 100
				;10%でおしち
				RETURN [[キャラ:오시치]], 39
		ENDSELECT
ENDSELECT

