;=======================================================================
;攻略条件
;=======================================================================
@PREREQUISITE_DUNGEON_4
IF FLAG:백합의꽃루트 == 5 || FLAG:나오야루트 == 5
	RETURN 1
ELSE
	RETURN 0
ENDIF

;=======================================================================
;ダンジョン名
;=======================================================================
@GET_DUNGEON_NAME_4
#FUNCTIONS
RESULTS_F = 精神世界

;=======================================================================
;スタート地点入力
;=======================================================================
@START_DUNGEON_4,ARG
FLAG:현M = 6
FLAG:현X = 2
FLAG:현Y = 3

;=======================================================================
;ダンジョン開始時イベント
;=======================================================================
@EVENT_DUNGEON_START_4
;---- EDIT 004 ADD START -------------------------
;新規作成
;直哉ルートのレイプイベントの実行済みフラグを消去
ダンジョンフラグ:(FLAG:현던전):1 = ダンジョンフラグ:(FLAG:현던전):1 == -2 ? -1 # ダンジョンフラグ:(FLAG:현던전):1
ダンジョンフラグ:(FLAG:현던전):2 = ダンジョンフラグ:(FLAG:현던전):2 == -2 ? -1 # ダンジョンフラグ:(FLAG:현던전):2
ダンジョンフラグ:(FLAG:현던전):3 = ダンジョンフラグ:(FLAG:현던전):3 == -2 ? -1 # ダンジョンフラグ:(FLAG:현던전):3
ダンジョンフラグ:(FLAG:현던전):8 = 0

;最初の部屋のアナライズをとっておく
CALL FLOOR_ANALYZE
;直哉ルートテキスト追加
IF ダンジョンフラグ:4:0 == 1
	CALL SHOW_FLOOR
	CALL SHOW_NOW_FORMATION_P,0,2,,"探索中"
	FLAG:커맨드표시행수 = LINECOUNT
	IF FLAG:백합의꽃루트
		CALL MESSAGE_WINDOW_D, "레미엘", "아마네의 마음은 제가 지키고 있습니다/그러나 언제까지 버틸 수 있을지는 모르겠습니다/서둘러 이자벨을 토벌해, 아마네를 구해주세요"
	ELSE
		CALL MESSAGE_WINDOW_D, "이자・벨", "왔군요/역시 아직 레미엘에게 이 몸을 빼앗기지는 않았지만/지루하기 그지 없네요/어서, 레미엘을 쓰러뜨리고 오세요"
	ENDIF
ELSE
	CALL SHOW_FLOOR
	CALL SHOW_NOW_FORMATION_P,0,2,,"探索中"
	FLAG:커맨드표시행수 = LINECOUNT
	IF FLAG:백합의꽃루트
		CALL MESSAGE_WINDOW_D, "SYSTTEM", @"＞레미엘과 함께 사이코 다이버의 본거지를 방문했다/＞사이코 다이브의 준비가 갖추어지자、/＞레미엘이 %CALLNAME:MASTER%의 눈을 바라본다"
		CALL MESSAGE_WINDOW_D, "레미엘", "…자신을 단단히 하십시오。/악마에게 삼켜지지 않도록…/그러면 현실 세계와 하나도 다르지 않을 겁니다"
		CALL MESSAGE_WINDOW_D, "레미엘", "하지만 아마네의 마음은 벌써 이자・벨에게 지배당하고 있습니다/그녀의 마음이 당신의 적이 되어 나타날 가능성도 있을 겁니다。/충분히 주의하세요"
		CALL MESSAGE_WINDOW_D, "레미엘", "이자・벨은 그녀의 마음 속 가장 깊은 곳에 깃들어 있습니다/싸움을 걸기 전에, 아마네의 자아를 되찾는다면、/그녀가 깨어날 것입니다/그러면, 그녀 자신의 의지로 당신을 도와주겠지요"
		CALL MESSAGE_WINDOW_D, "레미엘", "이자・벨은 강대한 악마입니다만, 어디까지나 싸우는 것은 아마네의 마음 속입니다/그녀의 도움이 있으면, 이자・벨도 힘을 충분히 발휘하지 못할 것이고/제거하는 일도 가능하겠지요"
		CALL MESSAGE_WINDOW_D, "레미엘", "악마에게 삼켜져 마음이 죽어 버린다면, 두 번 다시 현실세계에 돌아올 수 없습니다/저도 도와드리긴 하겠지만 충분히 주의해야 합니다。/자, 가세요。/당신에게 신의 가호가 있기를…！"
	ELSE
		CALL MESSAGE_WINDOW_D, "", "＞나오야의 본거지를 방문하였다/＞아마네가 자고 있는 곁에 나오야와 낯선 남자가 있다/＞이 남자가 나오야가 준비한 사이코 다이버라고 하는 것이다"
		CALL MESSAGE_WINDOW_D, "나오야", "정신세계에서는 자신을 단단히 다 잡는 것이다/그러면 현실세계와 아무것도 변하지 않을거야"
		CALL MESSAGE_WINDOW_D, "나오야", "하지만, 아마네의 마음은, 이미 이자・벨의 지배로부터 벗어나고 있어/아마네의 마음이 너의 적이 되어 나타날 것이다/레미엘은 아마네의 마음의 가장 안쪽에 깃들어 있을 거야/싸움을 걸기 전에, 아마네의 마음을 범해, 굴복 시켜버려"
		CALL MESSAGE_WINDOW_D, "나오야", "아마네의 마음을 꺾으면 그 만큼, 이자・벨의 힘이 늘어난다/레미엘은 강력한 힘의 천사지만、어디까지나 싸우는 것은 아마네의 마음 속이다/아마네의 마음을 꺾어, 너의 아군으로 만든다면、/레미엘이 충분히 힘을 발휘할 수 없을 거야"
		CALL MESSAGE_WINDOW_D, "나오야", "놈들에게 패해 마음이 죽어 버리면, 두 번 다시 현실 세계에 돌아올 수 없다/안에서는 이자・벨이 너희를 도와줄 거야/자、가봐라。/신의 끄나풀들을 없애버려"
	ENDIF
	ダンジョンフラグ:4:0 = 1
ENDIF
CALL MESSAGE_WINDOW_D, "", "＞아마네의 정신 세계로 사이코 다이브 했다……"
CALL MESSAGE_WINDOW_D, "", "………/……/…"
CALL DUNGEON_WORP_ID, 0, 8, 1

FLAG:MAG소비율 = 75

;=======================================================================
;ダンジョン脱出時のイベント
;=======================================================================
@EVENT_DUNGEON_END_4

;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_4
;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1

;==========
;宝箱の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
;==========
;イベントの処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 4
	CALL EVENT_4
	RETURN 1
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 6

ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 7

;=======
;그외
;=======
ELSE
	CALL MESSAGE_WINDOW_D, "SYSTTEM", "아무것도 없는 것 같다"
	RETURN 0
ENDIF


;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_4,ARG
#LOCALSIZE 10
;ARG = 進入時の向き　0の場合ワープなど
;==========
;扉の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) == 2
	CALL DUNGEON_DOOR,ARG
	RETURN 1
;==========
;宝箱の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3

;========
;イベントの処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 4
	CALL EVENT_4
	RETURN 1
;========
;罠の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 5
	CALL DUNGEON_TRAP_HP,10
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 6
	CALL WARP_4
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 7
	CALL WARP_4
;==========
;出口の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;ワープの処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 15

ENDIF
CALL MAKE_FLOOR, FLAG:현던전
CALL AUTOMAP
;RETURN 1
;=======================================================================
;エレベーター定義
;=======================================================================
;ARGはそのエレベーターのタイル
;RESULT:1～5にエレベータが存在するマップの番号を代入し、RESULTS:1～5には表示したい名称を代入、RETURNでは-1を返しておく
@DUNGEON_ELEVATOR_4, ARG

;=======================================================================
;必要レベル目安
;推奨LV 雑魚最低LV 雑魚最高LV ボスLV 
;=======================================================================
@GET_DUNGEON_LV_4
IF FLAG:백합의꽃루트
	RETURN 24, 27, 29, 35
ELSE
	RETURN 29, 32, 34, 45
ENDIF


;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_4
FLAG:인카운트율 = FLAG:미조우걸음수*3
SIF FLAG:미조우걸음수 <= 6
	FLAG:인카운트율 = 0

;=======================================================================
;エンカウント処理
;=======================================================================
@CHECK_ENCOUNT_4
IF RAND:100 < FLAG:인카운트율
	RETURN 1
ELSE
	FLAG:미조우걸음수 += 1
	RETURN 0
ENDIF


;=======================================================================
;敵の種族の種類数
;=======================================================================
@CLASS_NUM_4
RETURN CLASS_NUM_COMMON("上級")

;=======================================================================
;敵の総数
;=======================================================================
@ENEMY_NUM_4, ARG
RETURN CLASS_NUM_COMMON("上級")

;=======================================================================
;敵の種類
;=======================================================================
@ENEMY_4, ARG
IF FLAG:백합의꽃루트
	SELECTCASE RAND:100
		CASE IS < 20
			RETURN [[キャラ:맨이터]], 27
		CASE IS < 40
			RETURN [[キャラ:밴시]], 27
		CASE IS < 60
			RETURN [[キャラ:고르곤]], 29
		CASE IS < 80
			RETURN [[キャラ:나가]], 28
		CASE IS < 100
			RETURN [[キャラ:피닉스]], 28
	ENDSELECT
ELSE
	SELECTCASE RAND:100
		CASE IS < 30
			RETURN [[キャラ:엔젤]], 32
		CASE IS < 60
			RETURN [[キャラ:니케]], 33
		CASE IS < 80
			RETURN [[キャラ:아크엔젤]], 33
		CASE IS < 100
			RETURN [[キャラ:프린시펄리티]], 34
	ENDSELECT
ENDIF


;=======================================================================
;特殊調整
;=======================================================================
@SET_ENEMY_STATUS_4, ARG
;精神世界の天使はTALKできない
SIF FLAG:나오야루트
	ABL:ARG:회화타입 = 331
