;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_97
;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
	CALL TRESURING_CALLING_97
	RETURN 1
;==========
;イベントの処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 4
	CALL EVENTING_CALLING_97
	RETURN 1
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 6
	CALL DUNGEON_UPSTAIRS_ID, FLAG:현M+1, 7
	RETURN 1

ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 7
	CALL DUNGEON_UPSTAIRS_ID, FLAG:현M-1, 6
	RETURN 1
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 9
	CALL MESSAGE_WINDOW_D, "", "＞아무것도 없는 것 같다"
	RETURN 0
ENDIF

;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_97,ARG
;ARG = 進入時の向き　0の場合ワープなど
IF DA:(FLAG:현X):(FLAG:현Y) == 11
	CALL MESSAGE_WINDOW_D, "", "＞갑자기 어디선가 목소리가 울려 퍼졌다"
	CALL MESSAGE_WINDOW_D, "목소리", "축하한다, 레나/너는 선택받았다"
	
	CALL MESSAGE_WINDOW_D, "목소리", "아니, 선택해 줘서 고맙다/그렇게 말해야 하려나?"
ダンジョンフラグ:97:2 = 1
	CALL CLEAR_TILE
;==========
;出口の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
	CALL TRESURING_CALLING_97
	RETURN 1
;==========
;イベントの処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 4
	CALL EVENTING_CALLING_97
	RETURN 1
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 6
	CALL DUNGEON_UPSTAIRS_ID, FLAG:현M+1, 7
	RETURN 1
ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 7
	CALL DUNGEON_UPSTAIRS_ID, FLAG:현M-1, 6
	RETURN 1
;==========
;扉の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 2
	CALL DUNGEON_DOOR,ARG
	RETURN 1

ELSEIF DA:(FLAG:현X):(FLAG:현Y) == 9
	RETURN 0
ENDIF
RETURN 0


;=======================================================================
;인카운트율
;=======================================================================
@ENCOUNT_RATE_97
IF FLAG:현M < 4
	FLAG:인카운트율 =( FLAG:미조우걸음수 - 5) * 5
ELSEIF FLAG:현M == 4
	FLAG:인카운트율 = (FLAG:미조우걸음수 * 7 - 5) + 10
ELSE
	FLAG:인카운트율 = 0
ENDIF

