ENDIF

;=======================================================================
;指定したマスに進入可能か
;=======================================================================
@CAN_ENTER_97,ARG,ARG:1
IF DA:ARG:(ARG:1) == 12
	IF ダンジョンフラグ:97:0 == 1
	ELSEIF ダンジョンフラグ:97:12 >= 9
		CALL MESSAGE_WINDOW_D, "", "＞문 너머에서 사악한 기운이 느껴진다/＞문을 열까？"
		CALL INPUT_YN_D
		SIF RESULT == 1
			RETURN 0
	ELSE
		CALL MESSAGE_WINDOW_D, "", "＞문은 수수께끼의 힘으로 닫혀 있다"
		RETURN 0
	ENDIF
ELSEIF DA:ARG:(ARG:1) == 22
	IF ダンジョンフラグ:97:0 == 1
	ELSE
		CALL MESSAGE_WINDOW_D, "", "＞문은 수수께끼의 힘으로 닫혀 있다"
		RETURN 0
	ENDIF
ENDIF
CALL CAN_ENTER,ARG,ARG:1
RETURN RESULT

