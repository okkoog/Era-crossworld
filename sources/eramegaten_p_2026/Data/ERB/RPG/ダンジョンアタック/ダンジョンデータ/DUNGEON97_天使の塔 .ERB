			ダンジョンフラグ:97:(DA:(FLAG:현X):(FLAG:현Y)/10) = 1
			ダンジョンフラグ:97:12 += 1

			SELECTCASE ダンジョンフラグ:97:12
				CASE 1
					CALL MESSAGE_WINDOW_D, "", "＞어디선가 목소리가 울려 퍼졌다"
					CALL MESSAGE_WINDOW_D, "목소리", "파트너는 제가 골랐습니다"
				CASE 5
					CALL MESSAGE_WINDOW_D, "", "＞어디선가 목소리가 울려 퍼졌다"
					CALL MESSAGE_WINDOW_D, "목소리", "레미엘, 기대하고 있겠습니다"
				CASE 9
					CALL MESSAGE_WINDOW_D, "", "＞어디선가 목소리가 울려 퍼졌다"
					CALL MESSAGE_WINDOW_D, "목소리", "당신들에게는 감사하고 있습니다/덕분에 레나의 가능성을 알 수 있었으니까요!!"
					FLAG:탈출스킬금지 = 1
			ENDSELECT
			CALL CLEAR_TILE
		ELSE
			CALL MESSAGE_WINDOW_D, "", "＞거울에서 물러났다"
		ENDIF
ENDSELECT
RETURN 1
