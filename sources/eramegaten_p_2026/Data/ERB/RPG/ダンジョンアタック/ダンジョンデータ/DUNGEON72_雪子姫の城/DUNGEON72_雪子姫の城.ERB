;=======================================================================
;[5]調べる　実行時のイベント
;=======================================================================
@EVENT_CHECK_DUNGEON_72

;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
;% 10は10で割ったあまり、つまり下一桁がでてきます
;そして、下一桁はタイルの種類を表す
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
	CALL TREASURE_72
	RETURN RESULT
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 6
	CALL UPSTAIRS_72
	RETURN RESULT

ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 7
	CALL DOWNSTAIRS_72
	RETURN RESULT
ELSEIF DA:(FLAG:현X):(FLAG:현Y) %10 == 9
	SELECTCASE DA:(FLAG:현X):(FLAG:현Y) /10
	CASE 0
		CALL DUNGEON_TERMINAL
		RETURN 1
	CASE 1
		PRINTL 요정 실키：
		PRINTL 「후훗, 레벨이 낮은 내가 이곳에 있어서 신기하단 표정이구나」
		PRINTL 「보조 마법이 있으면 레벨이 높은 상대에게 꿀리지 않는답니다」
		PRINTW 
		PRINTL 「라쿠·카쟈, 스쿠·카쟈, 카쟈계라고 부르더라」
		PRINTW 「보조 마법만 있으면, 강적과 맞닥뜨려도 문제없어」
		PRINTW 「당신에게도 보조 마법을 걸어줄 멋진 상대가 생기면 좋겠어」
	CASE 2
		PRINTL 요마 리림：
		PRINTL 「라쿤·다! 타룬·다！」
		PRINTL 「음후후후훗. 너무 빨라서 상대도 안 되는걸♪」
		PRINTW 
		PRINTL 「살짝 약화 마법만 걸어줬는데 바로 끽해버리니 손쉬워라」
		PRINTL 「뭐어, 강해보이는 애한테는 공들여서 중첩해서 걸어주지만 말야」
		PRINTW 
		PRINTL 「그런데 우리 서머너 못 봤어？」
		PRINTW 「탐색하라고 그래서 뿔뿔이 흩어져서 움직이고 있는데, 어디 갔는지 몰라？」
	CASE 3
		PRINTL 천연 서머너：
		PRINTL 「실키쨩의 라쿠·카쟈를 카드로 만들어서… 다음은…」
		PRINTL 「앗, 안녕하세요～」
		PRINTW 
		PRINTL 「스킬 카드는 편리하네요～ 좋아하는 스킬을 달기도 하고 지우기도 하고」
		PRINTL 「별로 안 귀여운 애라도 좋은 스킬이 있으면」
		PRINTW 「무심코 충성도를 1000까지 키워버리게 되네요～」
		PRINTL 「좋아! 그럼 릴림쨩! 거기 사교의 관에서 카드를 만들어달… 어라？」
		PRINTW 
		PRINTW 「나 방금까지 마을에 있었는데… 에, 저………」
		PRINTL 「죄, 죄송한데요！」
 		PRINTL 「여기는… 어디죠！！！」
 		PRINTW 
	CASEELSE
		CALL DUNGEON_TERMINAL
		RETURN 1
	ENDSELECT
ELSE
	PRINTW 아무 것도 없는 것 같다
	RETURN 0
ENDIF






;=======================================================================
;タイル進入時のイベント
;=======================================================================
@EVENT_ENTER_DUNGEON_72,ARG
;ARG = 進入時の向き　0の場合ワープなど
;==========
;出口の処理
;==========
IF DA:(FLAG:현X):(FLAG:현Y) % 10 == 8
	CALL DUNGEON_EXIT
	RETURN 1
;========
;宝の処理
;========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 3
	CALL TREASURE_72
	RETURN RESULT
;=======
;階段
;=======
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 6
	CALL UPSTAIRS_72
	RETURN RESULT

ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 7
	CALL DOWNSTAIRS_72
	RETURN RESULT

;==========
;扉の処理
;==========
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 2
	CALL DUNGEON_DOOR,ARG
	RETURN 1
;========================
;이벤트
;========================
ELSEIF DA:(FLAG:현X):(FLAG:현Y) % 10 == 4
	SELECTCASE DA:(FLAG:현X):(FLAG:현Y) /10
		CASE 1
			CUSTOMDRAWLINE =
			PRINTL 
			PRINTW ＞당신이 방에 들어서자 같은 얼굴, 같은 모습을 한 여성이 마주보고 있었다。
			PRINTL 
			PRINTW 『유키코는 미인에, 피부도 뽀얗고, 여성스러워서… 남자 따윈 늘 추켜세우고 있어。
			PRINTW 　그런 유키코가, 때때로 날 비굴한 눈으로 쳐다봐…. 그것이, 참을수 없이 기뻤어。
			PRINTW 　그래, 유키코 따위 사실은 내가 없으면 아무것도 못해……
			PRINTW 　내 쪽이……내 쪽이……
			PRINTW 　내 쪽이！　훨씬 위잖아아아아！！』
			PRINTL 
			PRINTW 「아니야! 나, 난, 그런 생각！」
			PRINTL 
			PRINTW ＞얼굴이나 모습은 같지만 한 쪽은 인간이 아니다。
			PRINTL ＞무슨 이야기를 해야할지는 모르겠지만……
			PRINTW 　“인간이 아닌”쪽이、엷은 미소를 지으며 소녀에게 따진다。
			PRINTL 
			PRINTL 「……에？　어、어째서 다른 사람이！？
			PRINTL 　싫어！　오지마！　보지말라고！
			PRINTL 　달라……다르다구、이런 거 내가 아니야……！」
			PRINTW
			PRINTL 『후후……그렇지？　혼자서는 아무 것도 하지 못하는、진정한 나……
			PRINTL 　사람으로서도、여자로서도、사실은 이기지 못해、
			PRINTW 　구제할 수 없을 정도로、나는……。
			PRINTW 　――그래도 나는、그 유키코가 의지해주는 게 너무 좋아。
			PRINTW 　후후、그러니까 유키코는“친구”……손댈 수 없어……유키코가 너무 좋으니까……』
			PRINTL 
			PRINTW 「닥쳐！！　
			PRINTW 　너같은 게……너따위는、
			PRINTL 
			PRINTL 　・・・・・・・
			PRINTW 　내가 아니야！！」
			PRINTL 
			PRINTL ＞부정된 순간
			PRINTL 　검고 끈적끈적한 어둠이 주위를 뒤덮었다.、
			PRINTL 　귀에 거슬리는 웃음소리가、인간이 아닌 소녀의 입으로부터、울려퍼졌다。
			PRINTW 
			PRINTW 『우후후、우후、후……꺄하하하！！』
			PRINTW 「윽！？」
			PRINTL 
			PRINTFORMW 순간、소녀의 복장을 한 정체모를 것이
			PRINTFORMW 회색의 여학생들에게 떠받들어지는、삼각형에 눈이 박힌 마스크와 본디지로 몸을 감싼、천박한 여자로 변모했다。
			PRINTL 
