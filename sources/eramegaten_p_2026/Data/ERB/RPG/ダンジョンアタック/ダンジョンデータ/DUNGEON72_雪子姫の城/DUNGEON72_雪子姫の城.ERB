						PRINTW 　페르소나를 받아들인 유키코는 피로로 그 자리에서 쓰러졌다.。
						PRINTL 
						PRINTW 「그러고보니 당신은……？」
						PRINTL 
						PRINTW ＞당신은 지금까지의 사정을 설명했다。
						PRINTL 
						PRINTW 「그렇구나…. 치에도 함께구나……
						;一緒じゃ無い
						PRINTW 　당신은 나쁜 사람이 아닌 듯하고… 조금만, 신세를 져볼까」
						PRINTL 
						PRINTL ＞왠지 기분 좋아보이는 유키코를 데리고 던전에서 탈출했다。
						PRINTW 
						CALL ADD_NEW_COMPANION,[[キャラ:유키코]],100
						;戦闘参加可能で加入するが、調教で戦闘参加不可能になる
						SIF RESULT
							CALL SET_TALENT_PARTY_JOINABLE, (RESULT:1), "신용"
					ENDIF
				ENDIF
			ENDIF
			PRINTL
			PRINTL ＞보수로 ￥50000 입수했다
			PRINTW
			MONEY += 50000
			DA:(FLAG:현X):(FLAG:현Y) = 1
			FLAG:탈출 = 1
			RETURN 1
		CASE 3
			IF FLAG:현X == 8 && FLAG:현Y == 4
				CALL DUNGEON_WORP,3,13,7
			ELSEIF FLAG:현X == 13 && FLAG:현Y == 8
				CALL DUNGEON_WORP,3,10,13
			ELSEIF FLAG:현X == 9 && FLAG:현Y == 13
				CALL DUNGEON_WORP,3,4,10
			ELSEIF FLAG:현X == 4 && FLAG:현Y == 9
				CALL DUNGEON_WORP,3,7,4
			ENDIF
	ENDSELECT
ELSEIF DA:(FLAG:현X):(FLAG:현Y) %10 == 9
	SELECTCASE DA:(FLAG:현X):(FLAG:현Y) /10
		CASE 0
			CALL DUNGEON_TERMINAL
			RETURN 1
	ENDSELECT
ENDIF
RETURN 0


