				CALL ADDS_EXP("레즈경험", 5, ARG)
			ELSEIF IS_GAY(MASTER, ARG)
				CALL ADDS_EXP("ＢＬ경험", 5, MASTER)
				CALL ADDS_EXP("ＢＬ경험", 5, ARG)
			ENDIF
			CALL ADDS_EXP("야외노출경험", 5, MASTER)
			CALL ADDS_EXP("야외노출경험", 5, ARG)
			IF HAVE_PENIS(MASTER)
				CALL ADDS_EXP("사정경험", 1, MASTER)
			ELSE
				CALL ADDS_EXP("절정경험", 1, ARG)
				SIF HAVE_PENIS(ARG)
					CALL ADDS_EXP("사정경험", 1, ARG)
			ENDIF

			PRINTW 부스 안에 튄 체액을 청소하라고 명령한 뒤 혼자서 낙서를 시작한다.
			PRINTFORM 청소를 마치고 %CALLNAME:MASTER%의 곁으로 다가온 %CALLNAME:ARG%에게 
		ELSE
			;服は着ている
			IF IS_CLOTH_LIVING(ARG)
				;触手服
				PRINTFORML 입고 있는 것이 촉수복뿐이 되자 %CALLNAME:ARG%(은)는 그 촉수복에도 손을 댔다.
				PRINTFORMW 그러나 그 순간 촉수복이 저항하기 시작했는지, %CALLNAME:ARG%(은)는 별안간 교성을 질렀다.
				PRINTFORML 다급히 입을 틀어막은 %CALLNAME:ARG%였지만 %CALLNAME:MASTER%에게 손을 떼라는 명령을 받고,
				PRINTFORMW 공공장소임에도 불구하고 %CALLNAME:ARG%(은)는 교성을 내지르는 것이었다.
			ELSEIF IS_CLOTH_CHASTITY(ARG)
				;정조대
				PRINTL 입고 있던 옷을 벗어가자 그 아래에서 금속으로 된 투박한 정조대가 드러난다.
				PRINTFORM 정조대 차림의 %CALLNAME:ARG%에게 렌즈를 향해 천박한 포즈를 취하게 하면서, 
				IF IS_CLOTH_VIBRATOR(ARG)
					;バイブ付き
					PRINTFORMW %CALLNAME:MASTER%(은)는 정조대에 장착된 바이브의 스위치를 켰다.
					PRINTFORML 갑자기 작동하기 시작한 바이브에 %CALLNAME:ARG%(은)는 별안간 교성을 내질렀다.
					PRINTFORM 다급히 입을 틀어막은 %CALLNAME:ARG%였지만, 
					PRINTFORML 다급히 입을 틀어막은 %CALLNAME:ARG%였지만 %CALLNAME:MASTER%에게 손을 떼라는 명령을 받고,
					PRINTFORMW 공공장소임에도 불구하고 %CALLNAME:ARG%(은)는 교성을 내지르는 것이었다.
				ELSE
					;バイブなし
					PRINTFORML %CALLNAME:MASTER%(은)는 %CALLNAME:ARG%의 정조대 열쇠를 연다.
					PRINTFORM 음란한 냄새가 촬영 부스를 감싸는 가운데, %CALLNAME:ARG%(은)는 오랜만에 
					IF HAVE_PENIS(ARG)
						PRINT 자유를 얻은 페니스를 발기시키고, 
					ELSE
						PRINT 해방된 은밀한 부위를 손가락으로 벌리며, 
					ENDIF
					PRINTW 초점이 풀린 눈동자를 카메라로 향한 채 미소 지었다.
				ENDIF
			ELSE
				;それ以外
				PRINTFORML 옷을 벗는 모습이 사진에 찍히는 사이, %CALLNAME:ARG%(은)는 실오라기 하나 걸치지 않은 알몸이 된다.
				IF HAVE_PENIS(ARG)
					SIF TALENT:ARG:음모없음
						PRINT 매끈매끈한 
					PRINT 육봉
				ELSE
					SIF TALENT:ARG:음모없음
						PRINT 매끈매끈한 
					PRINT 치구
				ENDIF
				PRINTFORMW 을(를) 드러내며, %CALLNAME:ARG%(은)는 %CALLNAME:MASTER%의 지시에 따라 갖가지 천박한 포즈로 사진을 찍어 나갔다.
			ENDIF

			CALL ADDS_EXP("야외노출경험", 7, ARG)
			SELECTCASE CFLAG:ARG:속옷（하）
				CASE [[衣装:바이브달린정조대]]
					CALL ADDS_EXP("Ｖ경험", 7, ARG)
				CASE [[衣装:Ａ바이브달린정조대]]
					CALL ADDS_EXP("Ａ경험", 7, ARG)
				CASE [[衣装:Ｗ바이브달린정조대]]
					CALL ADDS_EXP("Ｖ경험", 7, ARG)
					CALL ADDS_EXP("Ａ경험", 7, ARG)
			ENDSELECT
			SIF IS_CLOTH_LIVING(ARG)
				CALL ADDS_EXP("촉수경험", 7, ARG)

			PRINTFORMW 촬영 종료 후 %CALLNAME:MASTER%(은)는 낙서 코너 밖에서 대기하라고 %CALLNAME:ARG%에게 명령한다.
			PRINTFORM 낙서를 마치고 나온 %CALLNAME:MASTER%로부터 
		ENDIF
		PRINTFORML 건네받은 것은, 
		PRINTFORMW "%NAME:ARG%(은)는 %NAME:MASTER%의 소유물입니다"라는 문장과 자신을 능욕하는 문구가 적힌 스티커였다.
	ELSE
		;그외 エロ無し
		CALL DUNGEON_EVENT_PURIKURA_NORMAL_OTHER, ARG
	ENDIF
ENDIF

;信頼ルート
@DUNGEON_EVENT_PURIKURA_NORMAL_TRUST, ARG
PRINTFORML 촬영이 진행되고 전신 촬영이 시작되는 타이밍에 %CALLNAME:ARG%(이)가 어깨동무를 해왔다.
PRINTFORMW %CALLNAME:ARG%의 의도를 알아챈 %CALLNAME:MASTER%(은)는 어깨를 마주 감싸 안고 함께 팔을 치켜올리며 사진을 촬영했다.
PRINTFORMW 낙서 코너로 옮겨간 두 사람은 촬영한 사진을 보며 "최고의 사진이 찍혔어"라며 마주 보고 웃었다.

;그외(NTR中/未陥落など)
@DUNGEON_EVENT_PURIKURA_NORMAL_OTHER, ARG
PRINTFORMW "왜 %CSTR:ARG:일인칭%가…"라는 %CALLNAME:ARG%에게 사이좋아지고 싶어서라고 대답하며 안내 방송에 맞춰 포즈를 취한다.
PRINTFORMW 처음엔 꺼리던 %CALLNAME:ARG%였지만 결국엔 함께 포즈를 취해 주었다.
