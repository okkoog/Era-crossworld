;=======================================================================
;キャラクターによる特殊分岐を追加される方へ
;=======================================================================
;専用口上があるキャラの場合、口上ファイルに以下の関数を使用して文章を作成してください。(####はキャラ番号に修正)
;あくまでイベントなので、内容・経験に関しては分岐作成者にお任せしています。
;
;各種行為によって獲得する経験に関しては、分岐内でADDS_EXP関数を利用して加算してください。
;被写経験のみ当ファイル内で1プレイ相当分を加算してるので、それ以外のみ記述ください。
;(連コされる場合は差分量のみ追加してください)
;依存度も共通で40を加算しているので、独自で追加したい方は個別部分ではその分調整した値を指定してください。
;
;・口上ファイルでの関数名
;　@DUNGEON_EVENT_PURIKURA_K####
;　口上内で陥落などで更に分離する場合は、末尾に陥落名を付けるなどして下さい。(同梱テンプレート参照)
;
;=======================================================================
;이벤트
;=======================================================================
@DUNGEON_EVENT_PURIKURA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC IS_EXIST_KOJO
PRINTFORML ＞게임 센터
PRINTFORML 점내를 둘러보던 %CALLNAME:MASTER%(은)는 스티커 사진기를 발견하고 발걸음을 멈추었다.
PRINTFORMW 동료와 함께 찍어보는 것도 좋을지도 모른다…
CALL INPUT_YN("촬영한다", "촬영하지 않는다")
IF RESULT == 0 && MONEY >= 400
	PRINTFORMW 누구와 촬영할까…

	LOCAL = 0
	FOR LCOUNT, 1, 7
		LOCALS = 포지션{LCOUNT}
		SIF FLAG:LOCALS >= 0 && 体格(FLAG:LOCALS) <= 3
			LOCAL++
	NEXT
	SIF LOCAL >= 3
		PRINTFORML [0] 다 함께 촬영한다
	FOR LCOUNT, 1, 7
		LOCALS = 포지션{LCOUNT}
		SIF FLAG:LOCALS < 0
			CONTINUE
		IF FLAG:LOCALS == 0
			PRINTFORML [{LCOUNT}] 혼자서 촬영한다
		ELSE
			PRINTFORML [{LCOUNT}] %CALLNAME:(FLAG:LOCALS)%와(과) 촬영한다
		ENDIF
	NEXT
	PRINTFORML [9] 역시 그만둔다

	$DUNGEON_EVENT_PURIKURA_INPUTLOOP
	INPUT

	SIF RESULT >= 1 && RESULT <= 6
		LOCALS = 포지션{RESULT}

	IF RESULT == 9
		PRINTL 지금은 우선해야 할 일이 있다.
		PRINTFORMW %CALLNAME:MASTER%(은)는 그 자리를 뒤로 했다…
	ELSEIF LOCAL >= 3 && RESULT == 0
		;全員 エロ無し
		PRINTL 촬영 부스에 들어가 안내 방송에 맞춘 포즈로 촬영을 한다.
		PRINTW 촬영 종료 후, 낙서 부스에 옹기종기 모여 낙서를 즐겼다.
		PRINTFORMW 인쇄된 스티커를 나누어가진 뒤, %CALLNAME:MASTER% 일행은 게임 센터를 뒤로 했다.
		FOR LOCAL, 1, 7
			LOCALS = 포지션{LOCAL}
			SIF FLAG:LOCALS < 0
				CONTINUE
			IF FLAG:LOCALS == 0
				CALL ADDS_EXP("피사경험", 7, MASTER)
				PRINTFORML ■%CALLNAME:(MASTER)%
				CALL SHOW_ADD_EXP(MASTER)
			ELSEIF 体格(FLAG:LOCALS) >= 4
				PRINTFORMW ※%CALLNAME:(FLAG:LOCALS)%(은)는 덩치가 너무 커서 촬영 부스에 들어갈 수 없었습니다.
			ELSE
				CALL ADDS_EXP("피사경험", 7, FLAG:LOCALS)
				PRINTFORML ■%CALLNAME:(FLAG:LOCALS)%
				CALL SHOW_ADD_EXP(FLAG:LOCALS)
			ENDIF
		NEXT
		PRINTL
		PRINTW 다 함께 촬영을 즐겼다.
		MONEY -= 400
	ELSEIF RESULT >= 1 && RESULT <= 6 && FLAG:LOCALS == 0
		;一人で撮影
		;下の二人通常処理を分離したのでついでにこっちも
		CALL DUNGEON_EVENT_PURIKURA_SOLO
		CALL ADDS_EXP("피사경험", 7, MASTER)
		PRINTFORML ■%CALLNAME:(MASTER)%
		CALL SHOW_ADD_EXP(MASTER)
		PRINTL
		PRINTW 혼자서 촬영을 즐겼다…
		MONEY -= 400
	ELSEIF RESULT >= 1 && RESULT <= 6 && FLAG:LOCALS > 0
		;誰かと撮影
		;専用口上がある場合は汎用分岐を飛ばす
		CALL 口上存在確認, FLAG:LOCALS
		IS_EXIST_KOJO = (RESULT == 2)
		IF 体格(FLAG:LOCALS) >= 4
			;巨体は撮影不可
			PRINTFORMW %CALLNAME:(FLAG:LOCALS)%(은)는 너무 커서 촬영 부스에 들어갈 수 없는 모양이다…
			IF IS_EXIST_KOJO
				TSTR:프린트스티커이벤트내용 = 撮影不可_巨体
				CALL 口上呼び出し, "DUNGEON_EVENT", FLAG:LOCALS, , , , "PURIKURA"
			ENDIF
			GOTO DUNGEON_EVENT_PURIKURA_INPUTLOOP
		ELSE
			;巨体以外
			TSTR:프린트스티커이벤트내용 = 通常撮影
			CALL 口上呼び出し, "DUNGEON_EVENT", FLAG:LOCALS, , , , "PURIKURA"
			IF !RESULT
				;専用口上無しの場合
				CALLF 陥落(FLAG:LOCALS, MASTER)
				PRINTFORMW %CALLNAME:(FLAG:LOCALS)%와(과) 촬영 부스에 들어갔다.
				;キャラごとの特殊分岐
				IF NO:(FLAG:LOCALS) == [[キャラ:잭프로스트]] && !IS_EXIST_KOJO
					;プリクラ君がいる時
					PRINTL 「히호히호! 사진 찍는 호?」
					PRINTFORMW 「옛날엔 %CSTR:(FLAG:LOCALS):일인칭%가 마스코트였던 적도 있었다 호-」
					PRINTL 「그럼 촬영하는 호-, 카메라 렌즈를 보는 거다 호-」
					PRINTFORML 최신 기종임에도 불구하고 %CALLNAME:(FLAG:LOCALS)%(은)는 익숙한 느낌으로 포즈를 취하고 있다.
					PRINTFORMW %CALLNAME:MASTER%(은)는 감탄하면서 함께 포즈를 취했다.
				ELSEIF NO:(FLAG:LOCALS) == [[キャラ:딸기프로스트]] && !IS_EXIST_KOJO
					;ジャックの双子の姉をイメージ
					PRINTL 「사진 찍는 거야?」
					PRINTW 「옛날엔 잭이 마스코트였던 적도 있었던 모양이네」
					PRINTL 「그럼 촬영을 시작할게, 카메라 렌즈를 봐」
					PRINTFORML 잭 본인은 아니라 해도, %CALLNAME:(FLAG:LOCALS)%(은)는 익숙한 느낌으로 포즈를 취하고 있다.
					PRINTFORMW %CALLNAME:MASTER%(은)는 감탄하면서 함께 포즈를 취했다.
				ELSEIF NO:(FLAG:LOCALS) == [[キャラ:프로스트파이브]] && !IS_EXIST_KOJO
					;わちゃわちゃ
					PRINTW 「「「「「히호-! 사진 찍는 호-!」」」」」
					PRINTFORML 「%CSTR:(FLAG:LOCALS):이인칭%가 가운데인 호-」「다 같이 둘러싸는 호-」
					PRINTW 와글와글 시끌벅적한 프로스트들에게 좌우에서 지시를 받으며, 전원 다 함께 포즈를 취했다.
				;以下ジャックorフロストファミリー
				;アイデアが浮かばなかったので保留
				;ELSEIF NO:(FLAG:LOCALS) == [[キャラ:프로스트에이스]] && !IS_EXIST_KOJO
				;ELSEIF NO:(FLAG:LOCALS) == [[キャラ:쁘띠프로스트]] && !IS_EXIST_KOJO
				;ELSEIF GROUPMATCH(NO:(FLAG:LOCALS), [[キャラ:사악프로스트]], [[キャラ:사악프로스트_마인]]) && !IS_EXIST_KOJO
				;ELSEIF NO:(FLAG:LOCALS) == [[キャラ:킹프로스트]] && !IS_EXIST_KOJO
				;ELSEIF NO:(FLAG:LOCALS) == [[キャラ:루시퍼프로스트]] && !IS_EXIST_KOJO
				ELSEIF NO:(FLAG:LOCALS) == [[キャラ:잭랜턴]] && !IS_EXIST_KOJO
					;フロストに嫉妬するランタン
					;アイデアくれた「」ありがとう
					PRINTW 「사진 찍는 호?」
					PRINTL 「딱히 상관은 없지만, 이것 때문에 프로스트 녀석들만 인기 있어져서 좀 복잡한 호…」
					PRINTW 「됐으니까 촬영하자고 호? 참 나, 막무가내인 호…」
					PRINTFORML 약간 씁쓸한 표정을 지으면서도 %CALLNAME:(FLAG:LOCALS)%(은)는 포즈를 취해 주었다.
				ELSEIF IS_HUMANOID(FLAG:LOCALS) >= 3
					;相手が人間・もしくは人型悪魔
					;特殊分岐内からも飛んだりするので分離
					CALL DUNGEON_EVENT_PURIKURA_NORMAL, (FLAG:LOCALS), RESULTS
				ELSE
					;その他悪魔 エロ無し
					IF RESULT > 0
						;陥落済み
						PRINTW 촬영 부스에 들어가 음성 안내에 맞춘 포즈로 촬영을 한다.
						PRINTFORMW %CALLNAME:(FLAG:LOCALS)%도 나름대로 여러 포즈를 취해 주었다.
					ELSE
						;그외(NTR中/未陥落など)
						CALL DUNGEON_EVENT_PURIKURA_NORMAL_OTHER, (FLAG:LOCALS)
					ENDIF
				ENDIF
			ENDIF

			IF NO:(FLAG:LOCALS) == [[キャラ:잭프로스트]]
				;ジャックフロストだけちょっと多めに 特殊分岐の有無は問わない
				CFLAG:(FLAG:LOCALS):의존도 += 60
			ELSEIF NO:(FLAG:LOCALS) == [[キャラ:딸기프로스트]]
				;本人ではないのでジャックよりは少なめ 同上
				CFLAG:(FLAG:LOCALS):의존도 += 50
			ELSE
				CFLAG:(FLAG:LOCALS):의존도 += 40
			ENDIF
			CALL ADDS_EXP("피사경험", 7, MASTER)
			CALL ADDS_EXP("피사경험", 7, FLAG:LOCALS)
			PRINTFORML ■%CALLNAME:MASTER%
			CALL SHOW_ADD_EXP(MASTER)
			PRINTFORML ■%CALLNAME:(FLAG:LOCALS)%
			CALL SHOW_ADD_EXP(FLAG:LOCALS)

			PRINTL
			PRINTFORMW %CALLNAME:(FLAG:LOCALS)%와(과) 촬영을 즐겼다.
			MONEY -= 400
		ENDIF
	ELSE
		GOTO DUNGEON_EVENT_PURIKURA_INPUTLOOP
	ENDIF
ELSEIF RESULT == 0 && MONEY < 400
	PRINTL 촬영하고 싶었지만 소지금이 부족하다.
	PRINTFORMW %CALLNAME:MASTER%(은)는 그 자리를 뒤로 했다…
ELSE
	PRINTL 지금은 우선해야 할 일이 있다.
	PRINTFORMW %CALLNAME:MASTER%(은)는 그 자리를 뒤로 했다…
ENDIF

@DUNGEON_EVENT_PURIKURA_SOLO
;一人で撮影
IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코
	;@が男
	PRINTFORMW 주변의 "남자 혼자서 촬영?"이라는 시선을 무시하며 부스로 발걸음을 옮긴다.
	PRINTFORML "난 혼자서 대체 뭘 하고 있는 거지…"라는 생각을 억누르고,
	PRINTFORMW 안내 방송의 지시대로 포즈를 취해 촬영을 마쳤다.
ELSE
	;@が女/후타나리/오토코노코
	PRINTL 촬영 메뉴를 선택하고 촬영 부스에 발을 들여놓는다.
	PRINTW 희미하게 풍기는 음란한 냄새는 누군가가 이 부스 안에서 야한 짓을 한 흔적을 보여주고 있다…
	PRINTW 나도 야한 스티커 사진(에로프리)을 찍어볼까…
	CALL INPUT_YN("야한 사진으로", "평범한 사진으로")
	IF RESULT == 0
		;着用している衣服に応じて分岐
		IF IS_NAKED(MASTER)
			PRINTFORML 알몸의 %CALLNAME:MASTER%(은)는 촬영 부스에 들어가자마자 자위를 시작한다.
			PRINTFORM 플래시가 번쩍일 때마다 %CALLNAME:MASTER%(은)는 
			IF TALENT:MASTER:오토코노코
				PRINT 페니스에서 쿠퍼액을 
			ELSEIF TALENT:MASTER:후타나리
				PRINT 페니스에서 쿠퍼액을, 갈라진 틈에서 애액을
			ELSE
				PRINT 갈라진 틈에서 애액을 
			ENDIF
			PRINTL 흘리면서 잘게 절정을 반복한다.
			PRINTFORMW "다음은 전신 촬영이야"라는 안내 방송이 흘러나오고, %CALLNAME:MASTER%(은)는 손놀림을 빠르게 한다.
			PRINTFORML 플래시가 터짐과 동시에 %CALLNAME:MASTER%(은)는 촬영 부스 밖까지 들릴 만큼 큰 소리로 신음하며 절정한다.
			IF TALENT:MASTER:오토코노코
				PRINT 정액이 
			ELSEIF TALENT:MASTER:후타나리
				PRINT 정액과 조수가 
			ELSE
				PRINT 뿜어낸 조수가 
			ENDIF
			PRINTFORML 흩뿌려지는 가운데, 마지막 한 장을 쩍벌 더블 브이 포즈로 촬영한 %CALLNAME:MASTER%(은)는 낙서 코너로 이동하더니,
			PRINTFORMW 자신의 이름이나 "정액 모집 중%ハート()%" 등을 마음껏 써넣고, 인쇄가 끝날 때까지 자위를 계속했다.
			CALL ADDS_EXP("자위경험", 5, MASTER)
			CALL ADDS_EXP("야외노출경험", 5, MASTER)
			CALL ADDS_EXP("절정경험", 5, MASTER)
			SIF HAVE_PENIS(MASTER)
				CALL ADDS_EXP("사정경험", 7, MASTER)
			PRINTL
			PRINTL 가게 안의 손님이 "알몸인 사람이 있다"고 점원에게 신고했는지, 몇 명의 점원이 다가온다.
			PRINTFORMW 그것을 알아챈 %CALLNAME:MASTER%(은)는 스티커를 회수하고 서둘러 가게에서 도망쳤다.
		ELSEIF IS_CLOTH_NAKEDCOAT(MASTER)
			;裸コート
			PRINTFORMW 촬영 부스에 들어간 %CALLNAME:MASTER%(은)는 입고 있던 코트 앞자락을 열어젖힌다.
			PRINTFORMW 촬영이 진행되며 어딘가 부족해진 %CALLNAME:MASTER%(은)는 자위를 시작한다.
			PRINTFORM 플래시가 번쩍일 때마다 %CALLNAME:MASTER%(은)는 
			IF TALENT:MASTER:오토코노코
				PRINT 페니스에서 쿠퍼액을 
			ELSEIF TALENT:MASTER:후타나리
				PRINT 페니스에서 쿠퍼액을, 갈라진 틈에서 애액을
			ELSE
				PRINT 갈라진 틈에서 애액을 
			ENDIF
			PRINTL 흘리면서 잘게 절정을 반복한다.
			PRINTFORMW "다음은 전신 촬영이야"라는 내레이션이 흘러나오고, %CALLNAME:MASTER%(은)는 손놀림을 빠르게 한다.
			PRINTFORML 플래시가 터짐과 동시에 %CALLNAME:MASTER%(은)는 촬영 부스 밖까지 들릴 만큼 큰 소리로 신음하며 절정한다.
			IF TALENT:MASTER:오토코노코
				PRINT 정액이 
			ELSEIF TALENT:MASTER:후타나리
				PRINT 정액과 조수가 
			ELSE
				PRINT 뿜어낸 조수가 
			ENDIF
			PRINTFORML 흩뿌려지는 가운데, 마지막 한 장을 쩍벌 더블 브이 포즈로 촬영한 %CALLNAME:MASTER%(은)는 낙서 코너로 이동하더니,
			PRINTFORMW 자신의 이름이나 "정액 모집 중%ハート()%" 등을 마음껏 써넣고, 인쇄가 끝날 때까지 자위를 계속했다.
			CALL ADDS_EXP("자위경험", 5, MASTER)
			CALL ADDS_EXP("야외노출경험", 5, MASTER)
			CALL ADDS_EXP("절정경험", 5, MASTER)
			SIF HAVE_PENIS(MASTER)
				CALL ADDS_EXP("사정경험", 7, MASTER)
		ELSE
			;共通箇所があるので一段下げる
			IF IS_CLOTH_SKIRT(MASTER)
				;スカート系衣装
				PRINTFORMW 촬영 부스에 들어간 %CALLNAME:MASTER%(은)는 입고 있던 스커트를 걷어 올린다.
				PRINT 스커트 속에서는, 
				IF IS_NAKED_NOPAN(MASTER)
					;ノーパンスカート
					IF HAVE_PENIS(MASTER)
						PRINTFORM 발기한 
						SIF TALENT:MASTER:음모없음
							PRINT 매끈매끈한 
						PRINTL 육봉이 드러난다.
					ELSE
						PRINTFORM 애액에 젖은 
						SIF TALENT:MASTER:음모없음
							PRINT 매끈매끈한 
						PRINTL 치구가 드러난다.
					ENDIF
					PRINTFORM 본래 남 앞에서 보여서는 안 될 은밀한 곳을 드러낸 채 %CALLNAME:MASTER%(은)는 
				ELSEIF IS_CLOTH_CHASTITY(MASTER)
					;정조대
