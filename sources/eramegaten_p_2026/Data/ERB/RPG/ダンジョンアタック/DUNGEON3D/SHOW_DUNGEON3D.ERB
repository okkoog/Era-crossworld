;HTMLみたいなテキストを作成します。DUNGEON3D.ERHにて定義されている定数配列変数
;それぞれが高さ、広さ、Y座標位置,X座標位置,ファイル名
@D3D_MAKE_HTMLTEXT(LHEIGHT,LWIDTH,LYPOS,LXPOS,SRCNAME)
#FUNCTIONS
#DIM DYNAMIC LHEIGHT
#DIM DYNAMIC LWIDTH
#DIM DYNAMIC LYPOS
#DIM DYNAMIC LXPOS
#DIMS DYNAMIC SRCNAME

RETURNF @"<nonbutton title='...' pos='{LXPOS * 50}'><img src='" + SRCNAME + @"' height='{LHEIGHT * 50}' width='{LWIDTH * 50}' ypos='{LYPOS * 50}'></nonbutton>"

;コンパス表示
@D3D_SHOW_COMPASS(LINENUM)
#DIM DYNAMIC LINENUM
SELECTCASE LINENUM
    CASE 0
        SELECTCASE D3D_PLAYER_DIRECTION
            CASE 0
                SETCOLORBYNAME Red
                PRINT   Ｎ
                RESETCOLOR
            CASE 1
                PRINT   Ｅ
            CASE 2
                PRINT   Ｓ
            CASE 3
                PRINT   Ｗ
        ENDSELECT
    CASE 1
        SELECTCASE D3D_PLAYER_DIRECTION
            CASE 0
                PRINT Ｗ△Ｅ
            CASE 1
                SETCOLORBYNAME Red
                PRINT Ｎ
                RESETCOLOR
                PRINT △Ｓ
            CASE 2
                PRINT Ｅ△Ｗ
            CASE 3
                PRINT Ｓ△
                SETCOLORBYNAME Red
                PRINT Ｎ
                RESETCOLOR
        ENDSELECT
    CASE 2
        SELECTCASE D3D_PLAYER_DIRECTION
            CASE 0
                PRINT   Ｓ
            CASE 1
                PRINT   Ｗ
            CASE 2
                SETCOLORBYNAME Red
                PRINT   Ｎ
                RESETCOLOR
            CASE 3
                PRINT   Ｅ
        ENDSELECT
ENDSELECT

;ShinEraTenseiのDG_GET_TILEに依存します。現在プレイヤー位置のタイル情報を得て出力
@D3D_SHOW_UNDER_YOU
CALL DG_GET_TILE(D3D_PLAYER_XCOORD,D3D_PLAYER_YCOORD,FLAG:현M,FLAG:현던전)
IF RESULTS == "出"
    PRINTPLAINFORM [%RESULTS%]
    RESETCOLOR
    PRINT 출구 위다.
ELSEIF RESULTS == "降" || RESULTS == "昇"
    PRINTPLAINFORM [%RESULTS%]
    RESETCOLOR
    PRINT 계단 위다.
ELSEIF RESULTS == "■"
    RESETCOLOR
    PRINT ？？？
ELSEIF RESULTS != "" && RESULTS != "□"  && !(DUNGEON_SHOW_TEMP_EXPLORED_ROUTE == 1 && RESULTS == UNICODE(0x303C))
    PRINTPLAINFORM [%RESULTS%]
    RESETCOLOR
    PRINT 이 위치에서 조사할 수 있다.
ELSE
    RESETCOLOR
    PRINT 이 위치에는 아무것도 없는 것 같다.
ENDIF

;ミニマップを D3D_MINIMAPS 文字列配列変数 と D3D_MINIMAPS_C （色） に記録します
@D3D_MAKE_MINIMAP
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNT2
;初期化
FOR LCOUNT,0,19
    FOR LCOUNT2,0,19
        D3D_MINIMAPS:LCOUNT:LCOUNT2 =
        D3D_MINIMAPS_C:LCOUNT:LCOUNT2 = 0
    NEXT
NEXT

FOR LCOUNT2, 0 - D3D_MINIMAP_RADIUS, D3D_MINIMAP_RADIUS+1
    FOR LCOUNT, 0 - D3D_MINIMAP_RADIUS, D3D_MINIMAP_RADIUS+1
        {
            IF D3D_PLAYER_XCOORD+LCOUNT >= 0 && D3D_PLAYER_YCOORD+LCOUNT2 >= 0 &&
            D3D_PLAYER_XCOORD+LCOUNT < D3D_CURRENT_MAPXSIZE &&
            D3D_PLAYER_YCOORD+LCOUNT2 < D3D_CURRENT_MAPYSIZE
        }
            IF LCOUNT == 0 && LCOUNT2 == 0
                SETCOLOR 0x33ffcc
                SELECTCASE D3D_PLAYER_DIRECTION
                    CASE 0
                        D3D_MINIMAPS:(LCOUNT+D3D_MINIMAP_RADIUS):(LCOUNT2+D3D_MINIMAP_RADIUS) = ↑
                    CASE 1
                        D3D_MINIMAPS:(LCOUNT+D3D_MINIMAP_RADIUS):(LCOUNT2+D3D_MINIMAP_RADIUS) = →
                    CASE 2
                        D3D_MINIMAPS:(LCOUNT+D3D_MINIMAP_RADIUS):(LCOUNT2+D3D_MINIMAP_RADIUS) = ↓
                    CASE 3
                        D3D_MINIMAPS:(LCOUNT+D3D_MINIMAP_RADIUS):(LCOUNT2+D3D_MINIMAP_RADIUS) = ←
                ENDSELECT
                GETCOLOR
                D3D_MINIMAPS_C:(LCOUNT+D3D_MINIMAP_RADIUS):(LCOUNT2+D3D_MINIMAP_RADIUS) = RESULT
                RESETCOLOR
                CONTINUE
            ENDIF
            ;ShinEraTensei @SHOW_FLOORそのままに近いです DPOINTが0以下でも出力しますね。
            IF DA:(FLAG:현X):(FLAG:현Y) % 10 == -1 && !(SOFT_ON("다크스캐너") || SOFT_ON("허니・비")) && FLAG:라이트마 == 0
                IF ABS((D3D_PLAYER_XCOORD+LCOUNT)-FLAG:현X)+ABS((D3D_PLAYER_YCOORD+LCOUNT2)-FLAG:현Y) > 1
                    SETCOLOR 0x333344
                    D3D_MINIMAPS:(LCOUNT+D3D_MINIMAP_RADIUS):(LCOUNT2+D3D_MINIMAP_RADIUS) = ？
                    GETCOLOR
                    D3D_MINIMAPS_C:(LCOUNT+D3D_MINIMAP_RADIUS):(LCOUNT2+D3D_MINIMAP_RADIUS) = RESULT
                    RESETCOLOR
                    CONTINUE
                ENDIF
            ENDIF
            IF DPOINT( , , (D3D_PLAYER_XCOORD+LCOUNT) , (D3D_PLAYER_YCOORD+LCOUNT2)) > 0
                CALL DG_GET_TILE((D3D_PLAYER_XCOORD+LCOUNT), (D3D_PLAYER_YCOORD+LCOUNT2), FLAG:현M, FLAG:현던전)
                D3D_MINIMAPS:(LCOUNT+D3D_MINIMAP_RADIUS):(LCOUNT2+D3D_MINIMAP_RADIUS) = %RESULTS%
                GETCOLOR
                D3D_MINIMAPS_C:(LCOUNT+D3D_MINIMAP_RADIUS):(LCOUNT2+D3D_MINIMAP_RADIUS) = RESULT
            ELSE
                D3D_MINIMAPS:(LCOUNT+D3D_MINIMAP_RADIUS):(LCOUNT2+D3D_MINIMAP_RADIUS) = 　
                GETDEFCOLOR
                D3D_MINIMAPS_C:(LCOUNT+D3D_MINIMAP_RADIUS):(LCOUNT2+D3D_MINIMAP_RADIUS) = RESULT
            ENDIF
            RESETCOLOR
        ELSE
            D3D_MINIMAPS:(LCOUNT+D3D_MINIMAP_RADIUS):(LCOUNT2+D3D_MINIMAP_RADIUS) = 　
            GETDEFCOLOR
            D3D_MINIMAPS_C:(LCOUNT+D3D_MINIMAP_RADIUS):(LCOUNT2+D3D_MINIMAP_RADIUS) = RESULT
        ENDIF
    NEXT
NEXT

;矢印タイルを回転させます。
@D3D_SPIN_TILES(TILES)
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC TILES
#DIMS DYNAMIC TILEARRAY0,4
#DIMS DYNAMIC TILEARRAY1,4
#DIMS DYNAMIC TILEARRAY2,4
;#DIMS DYNAMIC TILEARRAY3,4
;矢印追加はここ(1/4)
#DIM DYNAMIC TARGET_0=-1
#DIM DYNAMIC TARGET_1=-1
#DIMS DYNAMIC FORMSTRING
#DIM DYNAMIC DIRECTIONARRAY,4,4
IF TILES == "" || TILES == " "
    RESULTS = %TILES%
    GOTO D3D_END_SPIN_TILES
ENDIF

DIRECTIONARRAY:0:0 = 0,1,2,3
DIRECTIONARRAY:1:0 = 3,0,1,2
DIRECTIONARRAY:2:0 = 2,3,0,1
DIRECTIONARRAY:3:0 = 1,2,3,0
TILEARRAY0:0 '= "↑","→","↓","←"
TILEARRAY1:0 '= "∧","＞","∨","＜"
TILEARRAY2:0 '= "△","≫","▽","≪"
;TILEARRAY3:0 '= "あ","い","う","え"
;矢印追加はここ(2/4)
FOR LCOUNT,0,3
    SELECTCASE LCOUNT   
        CASE 0
            FINDELEMENT TILEARRAY0,TILES,0,4
        CASE 1
            FINDELEMENT TILEARRAY1,TILES,0,4
        CASE 2
            FINDELEMENT TILEARRAY2,TILES,0,4
        ;CASE 3
            ;FINDELEMENT TILEARRAY3,TILES,0,4
        ;矢印追加はここ(3/4)
    ENDSELECT
    IF RESULT != -1
        TARGET_0 = LCOUNT
        TARGET_1 = RESULT
        BREAK
    ELSE
        CONTINUE
    ENDIF
NEXT
IF TARGET_0 == -1 || TARGET_1 == -1
    RESULTS = %TILES%
    GOTO D3D_END_SPIN_TILES
ENDIF
TARGET_1 = DIRECTIONARRAY:D3D_PLAYER_DIRECTION:TARGET_1
SELECTCASE TARGET_0
    CASE 0
        RESULTS = %TILEARRAY0:TARGET_1%
    CASE 1
        RESULTS = %TILEARRAY1:TARGET_1%
    CASE 2
        RESULTS = %TILEARRAY2:TARGET_1%
    ;CASE 3
        ;RESULTS = %TILEARRAY3:TARGET_1%
    ;矢印追加はここ(4/4)
ENDSELECT
$D3D_END_SPIN_TILES

;ShinEraTensei 移植用
@PRINTTEXTBUTTON_MEGATEN(LNUM)
#DIM DYNAMIC LNUM

IF DA:(FLAG:현X):(FLAG:현Y) % 10 == -1 && !(SOFT_ON("다크스캐너") || SOFT_ON("허니・비")) && FLAG:라이트마 == 0
    IF ABS(D3D_TEXTBUTTONCOORD:LNUM:0-FLAG:현X)+ABS(D3D_TEXTBUTTONCOORD:LNUM:1-FLAG:현Y) > 1
        SETCOLOR 0x333344
        PRINT ［？］
        RESETCOLOR
        GOTO PRINTTEXTBUTTON_MEGATEN_END
    ENDIF
ENDIF
IF DPOINT( , , D3D_TEXTBUTTONCOORD:LNUM:0 , D3D_TEXTBUTTONCOORD:LNUM:1) > 0
    PRINTFORM ［%D3D_TEXTBUTTONS:LNUM%］
ELSE
    RESETCOLOR
    PRINT ［？］
ENDIF
RESETCOLOR

$PRINTTEXTBUTTON_MEGATEN_END
RETURN 1