            D3D_TEXTBUTTON:LCOUNT = 0;エラー回避用
            D3D_TEXTBUTTONS:LCOUNT '= "　"
            D3D_TEXTBUTTONCOORD:LCOUNT:0 = 0,0
            GETDEFCOLOR
            D3D_TEXTBUTTONC:LCOUNT = RESULT
            CONTINUE
    ENDSELECT
    D3D_TEXTBUTTONCOORD:LCOUNT:0 = RESULT:0,RESULT:1
    ;ShinEraTensei マップよりタイルアイコン文字列を借りてきます。
    IF (RESULT:0 >= 0 && RESULT:0 < D3D_CURRENT_MAPXSIZE && RESULT:1 >= 0 && RESULT:1 < D3D_CURRENT_MAPYSIZE) && LSKIP == 0
        ;TRYCCALL DG_GET_TILE(RESULT:0,RESULT:1,FLAG:현M,FLAG:현던전)
        TRYCCALL D3D_DG_GET_TILE(RESULT:0,RESULT:1)
        CATCH
            RESULTS =
        ENDCATCH
    ENDIF
    ;矢印をプレイヤー視界に合わせて回転させます。
    CALL D3D_SPIN_TILES(RESULTS)
    ;目標座標が一般壁または床で表示する内容がなかったら空っぽにします。
    IF (RESULTS == "■" || RESULTS == "□" || RESULTS == "") || LSKIP != 0
        D3D_TEXTBUTTON:LCOUNT = 0
        D3D_TEXTBUTTONS:LCOUNT '= "　"
        D3D_TEXTBUTTONCOORD:LCOUNT:0 = 0,0
        GETDEFCOLOR
        D3D_TEXTBUTTONC:LCOUNT = RESULT
    ELSE
        ;そうじゃなければ借りてきた文字列や色をそれぞれの配列変数に記録
        D3D_TEXTBUTTON:LCOUNT = 1
        D3D_TEXTBUTTONS:LCOUNT = %RESULTS%
        GETCOLOR
        D3D_TEXTBUTTONC:LCOUNT = RESULT
        CONTINUE
    ENDIF
NEXT
