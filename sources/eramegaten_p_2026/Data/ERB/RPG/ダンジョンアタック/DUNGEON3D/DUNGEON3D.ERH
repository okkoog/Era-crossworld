;３Dグラフィックみたいなもの活性化？
#DIM SAVEDATA D3D_ACTIVE = 0

;プレイヤーの方向。N:0 E:1 S:2 W:3
#DIM SAVEDATA D3D_PLAYER_DIRECTION = 0

;ワープ時に自動方向転換しないか
#DIM D3D_WORP = 0


;マップ上アイコン表示(0 または 1)
;0=真ん中u 1=深度2前左壁y 2=深度2前右壁i
;3=深度1前左壁h/深度1前左のマス前 4=深度0 左壁/深度0左のマス前g 
;5=深度1前右壁l/深度1前右のマス前 6=深度0 右壁/深度0右マス前6k
;7=深度2左のマス前t 8=右のマス前o
;9=深度2前床j 10=深度2左のマス床n 11=深度2右のマス床,
;12=深度1前床m 13=深度1左のマス床b 14=深度1右のマス床.
;15=真ん中2深度1前壁 16=真ん中3深度2前壁 17=真ん中4深度3前壁
;18=深度3前床,19=深度1左のマス床-すぐ前見えない ,20=深度1右のマス床-すぐ前見えない
;21=深度2左のマス床-左が見えない 22=深度2右のマス床-右が見えない
;23=深度0左のマス床 24=深度0右のマス床
;25=深度2左のマス前壁,深度1フレームで見えない 26=深度2右マス前壁...
;27=深度2左のマス床,すぐ前?見えない, 28=深度2右マス床...
;29=深度3左のマス床,30=深度3右マス床,31=深度2すぐ左壁,32=深度2すぐ右の壁
;33=深度3左のマス左壁,34=深度3右のマス右壁
;35=深度2左左のマス前壁,36=深度2右右のマス前壁
;37=深度2左左のマス左壁,38=深度2右右のマス右壁
#DIM D3D_TEXTBUTTON,39
;マップ上アイコン文字列
#DIMS D3D_TEXTBUTTONS,39
;マップ上アイコン色
#DIM D3D_TEXTBUTTONC,39
;マップ上アイコンに対応しているマップ座標
#DIM D3D_TEXTBUTTONCOORD,39,2

;プレイヤーを中心としたミニマップの大きさ。９を超えないんです。
#DIM D3D_MINIMAP_RADIUS = 9
;ミニマップ文字列
#DIMS D3D_MINIMAPS,19,19
;色
#DIM D3D_MINIMAPS_C,19,19


