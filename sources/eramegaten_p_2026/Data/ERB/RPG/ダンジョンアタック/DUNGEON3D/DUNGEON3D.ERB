;ShinEraTensei用３Dダンジョン表現のための関数定義 ERB
;
;D3D_CHECK_WALL
;壁判定。渡された座標とDAを参考にして
;四つの方向に壁があるか RESULT:0~3に渡す(NESW ?)
;
@D3D_CHECK_WALL(XCOORD,YCOORD,DIRECTION=-1,JUDGEBYCOVER=0)
#DIM DYNAMIC XCOORD
#DIM DYNAMIC YCOORD
#DIM DYNAMIC TEMP_XCOORD
#DIM DYNAMIC TEMP_YCOORD

#DIM DYNAMIC DIRECTION
#DIM DYNAMIC JUDGEBYCOVER;見た目だけで判断

#DIM DYNAMIC LCOUNT

#DIM DYNAMIC RESULTVALUE,4
#DIM DYNAMIC CARDINAL,4,2
#DIM DYNAMIC T_CARDINAL,4 = 0,1,2,3;TARGET_CARDINAL

#DIMS DYNAMIC DG_GET_TILE1
#DIMS DYNAMIC DG_GET_TILE2
#DIM DYNAMIC FINDELEMENTVALUE
;マップの外なら
IF (!INRANGE(XCOORD, 0, D3D_CURRENT_MAPXSIZE - 1) && !FLOOR_IS_LOOP_X) || (!INRANGE(YCOORD, 0, D3D_CURRENT_MAPYSIZE - 1) && !FLOOR_IS_LOOP_Y)
	SIF DA:(D3D_PLAYER_XCOORD):(D3D_PLAYER_YCOORD) % 10 == -1 && !(SOFT_ON("다크스캐너") || SOFT_ON("허니・비")) && FLAG:라이트마 == 0
		RETURN 0,0,0,0
    RETURN 1,1,1,1
ENDIF

CARDINAL:0:0 = 0,-1
CARDINAL:1:0 = 1,0
CARDINAL:2:0 = 0,1
CARDINAL:3:0 = -1,0

;指定された方向またはプレイヤーの方向によって実際違う方向を判断しますね
SIF DIRECTION == -1
    DIRECTION = D3D_PLAYER_DIRECTION
SELECTCASE DIRECTION
    CASE 1
        T_CARDINAL:0 = 1,2,3,0
    CASE 2
        T_CARDINAL:0 = 2,3,0,1
    CASE 3
        T_CARDINAL:0 = 3,0,1,2
ENDSELECT
IF !JUDGEBYCOVER
    FOR LCOUNT,0,4
        TEMP_XCOORD = XCOORD+CARDINAL:(T_CARDINAL:LCOUNT):0
        TEMP_YCOORD = YCOORD+CARDINAL:(T_CARDINAL:LCOUNT):1
        IF FLOOR_IS_LOOP_X
			TEMP_XCOORD = CONVERT_OUTRANGE_COORD_X(TEMP_XCOORD)
        ELSE
            IF !INRANGE(TEMP_XCOORD, 0, D3D_CURRENT_MAPXSIZE - 1)
                RESULTVALUE:LCOUNT = 1
                CONTINUE
            ENDIF
        ENDIF
        IF FLOOR_IS_LOOP_Y
			TEMP_YCOORD = CONVERT_OUTRANGE_COORD_Y(TEMP_YCOORD)
        ELSE
            IF !INRANGE(TEMP_YCOORD, 0, D3D_CURRENT_MAPYSIZE - 1)
                RESULTVALUE:LCOUNT = 1
                CONTINUE
            ENDIF
        ENDIF
        ;{
        ;    IF XCOORD+CARDINAL:(T_CARDINAL:LCOUNT):0 < 0 ||
        ;    XCOORD+CARDINAL:(T_CARDINAL:LCOUNT):0 >= D3D_CURRENT_MAPXSIZE ||
        ;    YCOORD+CARDINAL:(T_CARDINAL:LCOUNT):1 < 0 ||
        ;    YCOORD+CARDINAL:(T_CARDINAL:LCOUNT):1 >= D3D_CURRENT_MAPYSIZE
        ;}
        ;    RESULTVALUE:LCOUNT = 1
        ;    CONTINUE
        ;ENDIF
        SELECTCASE (D3D_CURRENT_MAPDATA:TEMP_XCOORD:TEMP_YCOORD) % 10
            CASE 0
                RESULTVALUE:LCOUNT = 1
            CASE 2,8
                RESULTVALUE:LCOUNT = 2
            CASEELSE
                RESULTVALUE:LCOUNT = 0
        ENDSELECT
    NEXT
ELSEIF JUDGEBYCOVER
    FOR LCOUNT,0,4
        TEMP_XCOORD = XCOORD+CARDINAL:(T_CARDINAL:LCOUNT):0
        TEMP_YCOORD = YCOORD+CARDINAL:(T_CARDINAL:LCOUNT):1
        IF FLOOR_IS_LOOP_X
			TEMP_XCOORD = CONVERT_OUTRANGE_COORD_X(TEMP_XCOORD)
        ELSE
            IF !INRANGE(TEMP_XCOORD, 0, D3D_CURRENT_MAPXSIZE - 1)
                RESULTVALUE:LCOUNT = 1
                CONTINUE
            ENDIF
        ENDIF
        IF FLOOR_IS_LOOP_Y
			TEMP_YCOORD = CONVERT_OUTRANGE_COORD_Y(TEMP_YCOORD)
        ELSE
            IF !INRANGE(TEMP_YCOORD, 0, D3D_CURRENT_MAPYSIZE - 1)
                RESULTVALUE:LCOUNT = 1
                CONTINUE
            ENDIF
        ENDIF
       ; {
       ;     IF XCOORD+CARDINAL:(T_CARDINAL:LCOUNT):0 < 0 ||
       ;     XCOORD+CARDINAL:(T_CARDINAL:LCOUNT):0 >= D3D_CURRENT_MAPXSIZE ||
       ;     YCOORD+CARDINAL:(T_CARDINAL:LCOUNT):1 < 0 ||
       ;     YCOORD+CARDINAL:(T_CARDINAL:LCOUNT):1 >= D3D_CURRENT_MAPYSIZE
       ; }
       ;     RESULTVALUE:LCOUNT = 1
       ;     CONTINUE
       ; ENDIF
        ;CALL DG_GET_TILE(XCOORD+CARDINAL:(T_CARDINAL:LCOUNT):0,YCOORD+CARDINAL:(T_CARDINAL:LCOUNT):1,FLAG:현M,FLAG:현던전)
        CALL D3D_DG_GET_TILE(TEMP_XCOORD,TEMP_YCOORD)
        DG_GET_TILE1 = %RESULTS:1%
        CALL DG_GET_TILE(D3D_PLAYER_XCOORD,D3D_PLAYER_YCOORD,FLAG:현M,FLAG:현던전)
        DG_GET_TILE2 = %RESULTS:1%
        RESETCOLOR
        SELECTCASE DG_GET_TILE1
            CASE "■","　"," "
                FINDELEMENT D3D_NORMAL_TILE_CHECKARRAY,D3D_CURRENT_MAPDATA:TEMP_XCOORD:TEMP_YCOORD,0,8
                FINDELEMENTVALUE = RESULT
                {
                    IF FINDELEMENTVALUE == -1 && DG_GET_TILE1 == DG_GET_TILE2
                }
                    RESULTVALUE:LCOUNT = 0
                ELSE
                    RESULTVALUE:LCOUNT = 1
                ENDIF
            CASE "扉"
                IF D3D_CURRENT_MAPDATA:(D3D_PLAYER_XCOORD):(D3D_PLAYER_YCOORD) == 2
                    RESULTVALUE:LCOUNT = 0
                ELSE
                    RESULTVALUE:LCOUNT = 2
                ENDIF
            CASE "出"
                IF D3D_CURRENT_MAPDATA:(D3D_PLAYER_XCOORD):(D3D_PLAYER_YCOORD) == 8
                    RESULTVALUE:LCOUNT = 0
                ELSE
                    RESULTVALUE:LCOUNT = 2
                ENDIF
            CASE "暗"
                RESULTVALUE:LCOUNT = 2
            CASE "□","宝","罠","降","昇","↑", "→", "↓", "←","Ｔ","ｔ","！","Ｅ","ｍ"
                RESULTVALUE:LCOUNT = 0
            CASEELSE
            	RESULT = 0
            {
            	TRYCALLFORM D3D_CHECK_WALL_{FLAG:현던전},
            	DG_GET_TILE1,TEMP_XCOORD,TEMP_YCOORD,
            	DG_GET_TILE2
            }
                RESULTVALUE:LCOUNT = RESULT
        ENDSELECT
    NEXT
ELSE
    RESULTVALUE:0 = 1,1,1,1
ENDIF


RETURN RESULTVALUE:0,RESULTVALUE:1,RESULTVALUE:2,RESULTVALUE:3
;
;D3D_GET_LEFT~BEHIND
;D3D_PLAYER_DIRECTIONを参考にしてプレイヤーの視界を中心として
;座標と方向をRESULT:0~2に渡す(0は X座標の加算数値, 1は Y座標の加算数値, 2は 0~3(NESW))
;

@D3D_GET_LEFT
#DIM DYNAMIC TARGET_CARDINAL
#DIM DYNAMIC CARDINAL,4,2
CARDINAL:0:0 = 0,-1
CARDINAL:1:0 = 1,0
CARDINAL:2:0 = 0,1
CARDINAL:3:0 = -1,0
SELECTCASE D3D_PLAYER_DIRECTION
    CASE 0
        TARGET_CARDINAL = 3
    CASE 1
        TARGET_CARDINAL = 0
    CASE 2
        TARGET_CARDINAL = 1
    CASE 3
        TARGET_CARDINAL = 2
ENDSELECT
RETURN CARDINAL:TARGET_CARDINAL:0,CARDINAL:TARGET_CARDINAL:1,TARGET_CARDINAL
@D3D_GET_RIGHT
#DIM DYNAMIC TARGET_CARDINAL
#DIM DYNAMIC CARDINAL,4,2
CARDINAL:0:0 = 0,-1
CARDINAL:1:0 = 1,0
CARDINAL:2:0 = 0,1
CARDINAL:3:0 = -1,0
SELECTCASE D3D_PLAYER_DIRECTION
    CASE 0
        TARGET_CARDINAL = 1
    CASE 1
        TARGET_CARDINAL = 2
    CASE 2
        TARGET_CARDINAL = 3
    CASE 3
        TARGET_CARDINAL = 0
ENDSELECT
RETURN CARDINAL:TARGET_CARDINAL:0,CARDINAL:TARGET_CARDINAL:1,TARGET_CARDINAL
@D3D_GET_FRONT
#DIM DYNAMIC TARGET_CARDINAL
#DIM DYNAMIC CARDINAL,4,2
CARDINAL:0:0 = 0,-1
CARDINAL:1:0 = 1,0
CARDINAL:2:0 = 0,1
CARDINAL:3:0 = -1,0
SELECTCASE D3D_PLAYER_DIRECTION
    CASE 0
        TARGET_CARDINAL = 0
    CASE 1
        TARGET_CARDINAL = 1
    CASE 2
        TARGET_CARDINAL = 2
    CASE 3
        TARGET_CARDINAL = 3
ENDSELECT
RETURN CARDINAL:TARGET_CARDINAL:0,CARDINAL:TARGET_CARDINAL:1,TARGET_CARDINAL
@D3D_GET_BEHIND
#DIM DYNAMIC TARGET_CARDINAL
#DIM DYNAMIC CARDINAL,4,2
CARDINAL:0:0 = 0,-1
CARDINAL:1:0 = 1,0
CARDINAL:2:0 = 0,1
CARDINAL:3:0 = -1,0
SELECTCASE D3D_PLAYER_DIRECTION
    CASE 0
        TARGET_CARDINAL = 2
    CASE 1
        TARGET_CARDINAL = 3
    CASE 2
        TARGET_CARDINAL = 0
    CASE 3
        TARGET_CARDINAL = 1
ENDSELECT
RETURN CARDINAL:TARGET_CARDINAL:0,CARDINAL:TARGET_CARDINAL:1,TARGET_CARDINAL
;
;D3D_GET_LEFT~BEHIND_COORD
;D3D_PLAYER_DIRECTIONを参考にしてプレイヤーの視界を中心として座標を得るんです。
;RESULT:0~1に渡します。
;
@D3D_GET_LEFT_COORD(XCOORD,YCOORD)
#DIM DYNAMIC XCOORD
#DIM DYNAMIC YCOORD
CALL D3D_GET_LEFT
RETURN XCOORD+RESULT:0,YCOORD+RESULT:1
@D3D_GET_RIGHT_COORD(XCOORD,YCOORD)
#DIM DYNAMIC XCOORD
#DIM DYNAMIC YCOORD
CALL D3D_GET_RIGHT
RETURN XCOORD+RESULT:0,YCOORD+RESULT:1
@D3D_GET_FRONT_COORD(XCOORD,YCOORD)
#DIM DYNAMIC XCOORD
#DIM DYNAMIC YCOORD
CALL D3D_GET_FRONT
RETURN XCOORD+RESULT:0,YCOORD+RESULT:1
@D3D_GET_BEHIND_COORD(XCOORD,YCOORD)
#DIM DYNAMIC XCOORD
#DIM DYNAMIC YCOORD
CALL D3D_GET_BEHIND
RETURN XCOORD+RESULT:0,YCOORD+RESULT:1

;
;D3D_IS_MAPRANGE
;ShinEraTensei 移植のための式中関数
;FLAG:현X~Y, FLAG:최대X~Y, D3D_PLAYER_DIRECTION などを使います。またRANGEも借ります。
;IF !RANGE(??, 0, ??)の役割をD3D専用入力で行う感じですね(1,0渡し)
;ランランダンジョンの仕様を変えたので判定及び移動幅の設定部分を削除
@D3D_IS_MAPRANGE(TOWALK=8)
#FUNCTION
#DIM DYNAMIC TOWALK;@DUNGEON_ATTACKで定義している D3D_TOWALKを渡される... 8,6,2,4
SELECTCASE TOWALK
    CASE 8
        IF RANGE(D3D_PLAYER_YCOORD - 1, 0, D3D_CURRENT_MAPYSIZE - 1) || (FLOOR_IS_LOOP_Y && D3D_PLAYER_YCOORD == 0)
            RETURNF 1
        ELSE
            RETURNF 0
        ENDIF
    CASE 6
        DEBUGPRINTFORML D3D_PLAYER_XCOORD = {D3D_PLAYER_XCOORD}
        DEBUGPRINTFORML D3D_CURRENT_MAPYSIZE - 1 = {D3D_CURRENT_MAPYSIZE - 1}
        IF RANGE(D3D_PLAYER_XCOORD + 1, 0, D3D_CURRENT_MAPXSIZE - 1) || (FLOOR_IS_LOOP_X && D3D_PLAYER_XCOORD == FLAG:최대X - 1)
            RETURNF 1
        ELSE
            RETURNF 0
        ENDIF
    CASE 2
        IF RANGE(D3D_PLAYER_YCOORD + 1, 0, D3D_CURRENT_MAPYSIZE - 1) || (FLOOR_IS_LOOP_Y && D3D_PLAYER_YCOORD == FLAG:최대Y - 1)
            RETURNF 1
        ELSE
            RETURNF 0
        ENDIF
    CASE 4
        IF RANGE(D3D_PLAYER_XCOORD - 1, 0, D3D_CURRENT_MAPXSIZE - 1) || (FLOOR_IS_LOOP_X && D3D_PLAYER_XCOORD == 0)
            RETURNF 1
        ELSE
            RETURNF 0
        ENDIF
ENDSELECT
RETURNF -1
;
;D3D_CHANGE_DIRECTION
;1 または -1を渡されて D3D_PLAYER_DIRECTIONを操作
;1 または -1じゃない場合0を渡します。
;
@D3D_CHANGE_DIRECTION(VALUE)
#DIM DYNAMIC VALUE
;1 時計回り -1 反時計回り 2 後ろを向く
SIF VALUE != 1 && VALUE != -1 && VALUE != 2
    RETURN 0
D3D_PLAYER_DIRECTION = (D3D_PLAYER_DIRECTION + VALUE)%4
IF D3D_PLAYER_DIRECTION > 3
    D3D_PLAYER_DIRECTION = 0
ELSEIF D3D_PLAYER_DIRECTION < 0
    D3D_PLAYER_DIRECTION = 3
ENDIF
RETURN 1
;
;D3D_AUTOFLIP
;ダンジョンに入るときプレイヤーの方向を判断し D3D_PLAYER_DIRECTION 操作
;SYSTEM_DUNGEON.ERB\MAKE_FLOOR 関数の処理がほぼ終わっているところで呼び出されるんです。
;
@D3D_AUTOFLIP
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC LCOUNT2
#DIM DYNAMIC TARGET_DIRECTION=0
#DIM DYNAMIC CARDINAL,4,2
CARDINAL:0:0 = 0,-1;北
CARDINAL:1:0 = 1,0;東
CARDINAL:2:0 = 0,1;南
CARDINAL:3:0 = -1,0;西

SELECTCASE D3D_CURRENT_MAPDATA:(D3D_PLAYER_XCOORD):(D3D_PLAYER_YCOORD) % 10
    CASE -9,6,7,8;初期位置がターミナルか泉かエレベーターか階段
        CALL D3D_CHECK_WALL(D3D_PLAYER_XCOORD,D3D_PLAYER_YCOORD,0,0)
        FOR LCOUNT,3,-1,-1
            SELECTCASE RESULT:LCOUNT
                CASE 0,2
                    TARGET_DIRECTION = LCOUNT
                CASEELSE
                    LCOUNT2 += 1
            ENDSELECT
        NEXT
    CASEELSE
        CALL D3D_CHECK_WALL(D3D_PLAYER_XCOORD,D3D_PLAYER_YCOORD,0,0)
        FOR LCOUNT,3,-1,-1
		;---- BUG FIX START ----
        {
            IF D3D_PLAYER_XCOORD+(CARDINAL:LCOUNT:0) < 0 || D3D_PLAYER_XCOORD+(CARDINAL:LCOUNT:0) > D3D_CURRENT_MAPXSIZE
            || D3D_PLAYER_YCOORD+(CARDINAL:LCOUNT:1) < 0 || D3D_PLAYER_YCOORD+(CARDINAL:LCOUNT:1) > D3D_CURRENT_MAPYSIZE
        }
                TARGET_DIRECTION = D3D_PLAYER_DIRECTION
                CONTINUE
            ENDIF
		;---- BUG FIX END  ----
            IF D3D_CURRENT_MAPDATA:(D3D_PLAYER_XCOORD+(CARDINAL:LCOUNT:0)):(D3D_PLAYER_YCOORD+(CARDINAL:LCOUNT:1)) % 10 == 8
                ;近くに出口があるならその逆方向に
                SELECTCASE LCOUNT
                    CASE 0,1
                        TARGET_DIRECTION = LCOUNT + 2
                    CASE 2,3
                        TARGET_DIRECTION = LCOUNT - 2
                ENDSELECT
            ENDIF
        NEXT
ENDSELECT
D3D_PLAYER_DIRECTION = TARGET_DIRECTION

;
;D3D_WALL_OR_FLOOR
;壁か、床か判定してマップ上アイコン表示
;現在プレイヤー方向を中心としてその位置が(見た目だけでも)壁か判定して
;RESULT:2に結果を渡します。(壁だったら1)
;
@D3D_WALL_OR_FLOOR(XCOORD,YCOORD,PLANE=2)
#DIM DYNAMIC XCOORD
#DIM DYNAMIC YCOORD
#DIM DYNAMIC PLANE
#DIM DYNAMIC LNUM=0


SELECTCASE PLANE
    CASE 0
        DEBUGPRINTFORML D3D_WALL_OR_FLOOR 関数に渡された第三パラメータ {PLANE}は不適切です。
        RETURN XCOORD,YCOORD,0
    CASE 1
        LNUM = 3
        CALL D3D_GET_RIGHT_COORD(XCOORD,YCOORD)
    CASE 2
        LNUM = 0
        CALL D3D_GET_BEHIND_COORD(XCOORD,YCOORD)
    CASE 3
        LNUM = 1
        CALL D3D_GET_LEFT_COORD(XCOORD,YCOORD)
    CASEELSE
        DEBUGPRINTFORML D3D_WALL_OR_FLOOR 関数に渡された第三パラメータ {PLANE}は不適切です。
        RETURN XCOORD,YCOORD,0
ENDSELECT
CALL D3D_CHECK_WALL(RESULT:0,RESULT:1,-1,1)

RETURN XCOORD,YCOORD,RESULT:LNUM

;CALL DG_GET_TILE(XCOORD+CARDINAL:(T_CARDINAL:LCOUNT):0,    YCOORD+CARDINAL:(T_CARDINAL:LCOUNT):1,   FLAG:현M,   FLAG:현던전)
;CALL DG_GET_TILE(D3D_PLAYER_XCOORD,D3D_PLAYER_YCOORD,FLAG:현M,FLAG:현던전)

@D3D_DG_GET_TILE(XCOORD,YCOORD)
#DIM DYNAMIC XCOORD
#DIM DYNAMIC YCOORD
IF DA:(D3D_PLAYER_XCOORD):(D3D_PLAYER_YCOORD) % 10 == -1 && !(SOFT_ON("다크스캐너") || SOFT_ON("허니・비")) && FLAG:라이트마 == 0
	IF ABS(XCOORD-D3D_PLAYER_XCOORD)+ABS(YCOORD-D3D_PLAYER_YCOORD) > 1
		SETCOLOR 0x333344
		RESULTS = 暗
		RETURN
	ELSEIF DPOINT( , , XCOORD , YCOORD) < 1
		SETCOLOR 0x333344
		RESULTS = ？
		RETURN
	ENDIF
ENDIF
CALL DG_GET_TILE(XCOORD, YCOORD, FLAG:현M, FLAG:현던전)
RESULTS = %RESULTS%

