;==========================================================
;@SET_SKILL_EMULATOR_VAR
;#FUNCTION内でTRYをしないように済ますために変数として取得させておくための変数
;==========================================================
@SET_SHOP_EV_VAR
#DIM LCOUNT, 2
FOR LCOUNT, 0, SHOP_EV_NUM
	TRYCCALLFORM SHOP_EV_NAME_{LCOUNT}
		SHOP_EV_NAME:LCOUNT = %RESULTS%
	CATCH
		BREAK
	ENDCATCH
	VARSET RESULTS, "", 0, VARSIZE_SHOP_EV
	TRYCCALLFORM SHOP_EV_FLAGNAME_{LCOUNT}
		FOR LCOUNT:1, 0, VARSIZE_SHOP_EV
			SHOP_EV_FLAGNAME:LCOUNT:(LCOUNT:1) = %RESULTS:(LCOUNT:1)%
		NEXT
	CATCH
	ENDCATCH
	VARSET RESULTS, "", 0, VARSIZE_SHOP_EV_STR
	TRYCCALLFORM SHOP_EV_STRNAME_{LCOUNT}
		FOR LCOUNT:1, 0, VARSIZE_SHOP_EV_STR
			SHOP_EV_STRNAME:LCOUNT:(LCOUNT:1) = %RESULTS:(LCOUNT:1)%
		NEXT
	CATCH
	ENDCATCH
	VARSET RESULTS, "", 0, VARSIZE_SHOP_EV_TAKEOVER
	TRYCCALLFORM SHOP_EV_TAKEOVER_FLAGNAME_{LCOUNT}
		FOR LCOUNT:1, 0, VARSIZE_SHOP_EV_TAKEOVER
			SHOP_EV_FLAGNAME_TAKEOVER:LCOUNT:(LCOUNT:1) = %RESULTS:(LCOUNT:1)%
		NEXT
	CATCH
	ENDCATCH
	VARSET RESULTS, "", 0, VARSIZE_SHOP_EV_STR_TAKEOVER
	TRYCCALLFORM SHOP_EV_TAKEOVER_STRNAME_{LCOUNT}
		FOR LCOUNT:1, 0, VARSIZE_SHOP_EV_STR_TAKEOVER
			SHOP_EV_STRNAME_TAKEOVER:LCOUNT:(LCOUNT:1) = %RESULTS:(LCOUNT:1)%
		NEXT
	CATCH
	ENDCATCH
NEXT

;==========================================================
;@GET_SHOP_EV
;番号からイベントの名称を返す
;==========================================================
@GET_SHOP_EV_NAME, ARG
#FUNCTIONS
RETURNF SHOP_EV_NAME:ARG

;==========================================================
;@GET_SHOP_EV_NUM
;名称からイベントの番号を返す (한/일 상호 호환 별칭 매핑)
;==========================================================
@GET_SHOP_EV_NUM, ARGS
#FUNCTION
#DIM L_RESULT
L_RESULT = FINDELEMENT(SHOP_EV_NAME, ARGS, , , 1)
SIF L_RESULT >= 0
	RETURNF L_RESULT
SELECTCASE ARGS
	CASE "マヨーネ様の労い", "마요네 님의 노고 치하", "마요네님의노고치하"
		RETURNF FINDELEMENT(SHOP_EV_NAME, "마요네 님의 노고 치하", , , 1)
	CASE "ラグの店からのお知らせ", "라그의 가게에서 알림", "라그의가게에서알림"
		RETURNF FINDELEMENT(SHOP_EV_NAME, "라그의 가게에서 알림", , , 1)
	CASE "イベントチケット配布", "이벤트 티켓 배포", "이벤트티켓배포"
		RETURNF FINDELEMENT(SHOP_EV_NAME, "이벤트 티켓 배포", , , 1)
ENDSELECT
RETURNF -1

;==========================================================
;@IS_MATCH_SHOP_EV_FLAGNAME
;플래그 명칭의 한국어/일본어 상호 호환 매칭 함수
;==========================================================
@IS_MATCH_SHOP_EV_FLAGNAME, ARGS, ARGS:1
#FUNCTION
SIF ARGS == ARGS:1
	RETURNF 1
SELECTCASE ARGS:1
	CASE "チケット受取日", "티켓 수령일", "티켓수령일"
		SIF GROUPMATCH(ARGS, "チケット受取日", "티켓 수령일", "티켓수령일")
			RETURNF 1
	CASE "クリア", "클리어"
		SIF GROUPMATCH(ARGS, "クリア", "클리어")
			RETURNF 1
ENDSELECT
RETURNF 0

;==========================================================
;個別フラグのセッター/ゲッター
;==========================================================
;-----------------------------------------------------
;セット関数
;SET_RPG_CFLAG_XX のXXの部分にEV・TAKEOVER、BTL, DUNGEONをいれて変数指定
;ARG = キャラ番号
;ARGS = フラグ名
;ARG:1 = 計算に使う数値　デフォルトでは代入
;ARGS:1 = "=, +=, -=, *=, /="  左の文字列を指定することで四則演算をさせられます
;
;式中関数版を通過しているのはデバッグコンソールから直接操作をするためです
;SET_RPG_CFLAG_EV_F(TARGET, "test")のように使ってください
;-----------------------------------------------------
@SET_FLAG_SHOP_EV, ARGS, ARGS:1, ARG, ARGS:2 = "SET"
CALLFORMF SET_FLAG_SHOP_EV_F, ARGS, ARGS:1, ARG, ARGS:2

@SET_FLAG_SHOP_EV_F, ARGS, ARGS:1, ARG, ARGS:2 = "SET"
#FUNCTION
CALLFORMF SET_SHOP_EV_F, ARGS, ARGS:1, ARG, "SHOP_EV", ARGS:2

;-----------------------------------------------------
@SET_FLAG_SHOP_EV_TAKEOVER, ARGS, ARGS:1, ARG, ARGS:2 = "SET"
CALLFORMF SET_FLAG_SHOP_EV_TAKEOVER_F, ARGS, ARGS:1, ARG, ARGS:2

@SET_FLAG_SHOP_EV_TAKEOVER_F, ARGS, ARGS:1, ARG, ARGS:2 = "SET"
#FUNCTION
CALLFORMF SET_SHOP_EV_F, ARGS, ARGS:1, ARG, "SHOP_EV_TAKEOVER", ARGS:2

;-----------------------------------------------------
;本体
;-----------------------------------------------------
@SET_SHOP_EV_F, ARGS, ARGS:1, ARG, ARGS:2, ARGS:3 = "SET"
#FUNCTION
#DIM LCOUNT
#DIM EV_NUM
#DIM L_VARSIZE
EV_NUM = GET_SHOP_EV_NUM(ARGS)
SIF EV_NUM < 0
	RETURNF 0
SELECTCASE ARGS:2
	CASE "SHOP_EV"
		L_VARSIZE = VARSIZE_SHOP_EV
	CASE "SHOP_EV_TAKEOVER"
		L_VARSIZE = VARSIZE_SHOP_EV_TAKEOVER
ENDSELECT
FOR LCOUNT, 0, L_VARSIZE
	SELECTCASE ARGS:2
		CASE "SHOP_EV"
			SIF !IS_MATCH_SHOP_EV_FLAGNAME(SHOP_EV_FLAGNAME:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			SELECTCASE ARGS:3
				CASE "SET", "="
					SHOP_EV:EV_NUM:LCOUNT = ARG
				CASE "ADD", "+", "+="
					SHOP_EV:EV_NUM:LCOUNT += ARG
				CASE "SUB", "SUBTRACITON", "-", "-="
					SHOP_EV:EV_NUM:LCOUNT -= ARG
				CASE "MUL", "MULTI", "*", "*="
					SHOP_EV:EV_NUM:LCOUNT *= ARG
				CASE "DIV", "DIVISION", "/", "/="
					SHOP_EV:EV_NUM:LCOUNT /= ARG
			ENDSELECT
		CASE "SHOP_EV_TAKEOVER"
			SIF !IS_MATCH_SHOP_EV_FLAGNAME(SHOP_EV_FLAGNAME_TAKEOVER:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			SELECTCASE ARGS:3
				CASE "SET", "="
					SHOP_EV_TAKEOVER:EV_NUM:LCOUNT = ARG
				CASE "ADD", "+", "+="
					SHOP_EV_TAKEOVER:EV_NUM:LCOUNT += ARG
				CASE "SUB", "SUBTRACITON", "-", "-="
					SHOP_EV_TAKEOVER:EV_NUM:LCOUNT -= ARG
				CASE "MUL", "MULTI", "*", "*="
					SHOP_EV_TAKEOVER:EV_NUM:LCOUNT *= ARG
				CASE "DIV", "DIVISION", "/", "/="
					SHOP_EV_TAKEOVER:EV_NUM:LCOUNT /= ARG
			ENDSELECT
	ENDSELECT
	RETURNF 1
NEXT
RETURNF 0

@GET_SHOP_EV_F, ARGS, ARGS:1, ARGS:2
#FUNCTION
#DIM LCOUNT
#DIM EV_NUM
#DIM L_VARSIZE
EV_NUM = GET_SHOP_EV_NUM(ARGS)
SIF EV_NUM < 0
	RETURNF 0
SELECTCASE ARGS:2
	CASE "SHOP_EV"
		L_VARSIZE = VARSIZE_SHOP_EV
	CASE "SHOP_EV_TAKEOVER"
		L_VARSIZE = VARSIZE_SHOP_EV_TAKEOVER
ENDSELECT
FOR LCOUNT, 0, L_VARSIZE
	SELECTCASE ARGS:2
		CASE "SHOP_EV"
			SIF !IS_MATCH_SHOP_EV_FLAGNAME(SHOP_EV_FLAGNAME:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			RETURNF SHOP_EV:EV_NUM:LCOUNT
		CASE "SHOP_EV_TAKEOVER"
			SIF !IS_MATCH_SHOP_EV_FLAGNAME(SHOP_EV_FLAGNAME_TAKEOVER:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			RETURNF SHOP_EV_TAKEOVER:EV_NUM:LCOUNT
	ENDSELECT
NEXT
RETURNF 0

@GET_FLAG_SHOP_EV, ARGS, ARGS:1
#FUNCTION
RETURNF GET_SHOP_EV_F(ARGS, ARGS:1, "SHOP_EV")

@GET_FLAG_SHOP_EV_TAKEOVER, ARGS, ARGS:1
#FUNCTION
RETURNF GET_SHOP_EV_F(ARGS, ARGS:1, "SHOP_EV_TAKEOVER")
;============================================================================

@SET_STR_SHOP_EV, ARGS, ARGS:1, ARGS:2, ARGS:3 = "SET"
CALLFORMF SET_STR_SHOP_EV_F, ARGS, ARGS:1, ARGS:2, ARGS:3

@SET_STR_SHOP_EV_F, ARGS, ARGS:1, ARGS:2, ARGS:3 = "SET"
#FUNCTION
CALLFORMF SETS_SHOP_EV_F, ARGS, ARGS:1, ARGS:2, "SHOP_EV_STR", ARGS:3

;-----------------------------------------------------
@SET_STR_SHOP_EV_TAKEOVER, ARGS, ARGS:1, ARGS:2, ARGS:3 = "SET"
CALLFORMF SET_STR_SHOP_EV_TAKEOVER_F, ARGS, ARGS:1, ARGS:2, ARGS:3

@SET_STR_SHOP_EV_TAKEOVER_F, ARGS, ARGS:1, ARGS:2, ARGS:3 = "SET"
#FUNCTION
CALLFORMF SETS_SHOP_EV_F, ARGS, ARGS:1, ARGS:2, "SHOP_EV_STR_TAKEOVER", ARGS:3
;-----------------------------------------------------

@SETS_SHOP_EV_F, ARGS, ARGS:1, ARGS:2, ARGS:3, ARGS:4 = "SET"
#FUNCTION
#DIM LCOUNT
#DIM EV_NUM
#DIM L_VARSIZE
EV_NUM = GET_SHOP_EV_NUM(ARGS)
SIF EV_NUM < 0
	RETURNF 0
SELECTCASE ARGS:3
	CASE "SHOP_EV_STR"
		L_VARSIZE = VARSIZE_SHOP_EV_STR
	CASE "SHOP_EV_STR_TAKEOVER"
		L_VARSIZE = VARSIZE_SHOP_EV_STR_TAKEOVER
ENDSELECT
FOR LCOUNT, 0, L_VARSIZE
	SELECTCASE ARGS:3
		CASE "SHOP_EV_STR"
			SIF !IS_MATCH_SHOP_EV_FLAGNAME(SHOP_EV_STRNAME:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			SELECTCASE ARGS:4
				CASE "SET", "="
					SHOP_EV_STR:EV_NUM:LCOUNT = %ARGS:2%
				CASE "ADD", "+", "+="
					SHOP_EV_STR:EV_NUM:LCOUNT += ARGS:2
			ENDSELECT
		CASE "SHOP_EV_STR_TAKEOVER"
			SIF !IS_MATCH_SHOP_EV_FLAGNAME(SHOP_EV_STRNAME_TAKEOVER:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			SELECTCASE ARGS:4
				CASE "SET", "="
					SHOP_EV_STR_TAKEOVER:EV_NUM:LCOUNT = %ARGS:2%
				CASE "ADD", "+", "+="
					SHOP_EV_STR_TAKEOVER:EV_NUM:LCOUNT += ARGS:2
			ENDSELECT
	ENDSELECT
	RETURNF 1
NEXT
RETURNF 0

@GETS_SHOP_EV_F, ARGS, ARGS:1, ARGS:2
#FUNCTIONS
#DIM LCOUNT
#DIM EV_NUM
#DIM L_VARSIZE
EV_NUM = GET_SHOP_EV_NUM(ARGS)
SIF EV_NUM < 0
	RETURNF ""
SELECTCASE ARGS:2
	CASE "SHOP_EV_STR"
		L_VARSIZE = VARSIZE_SHOP_EV_STR
	CASE "SHOP_EV_STR_TAKEOVER"
		L_VARSIZE = VARSIZE_SHOP_EV_STR_TAKEOVER
ENDSELECT
FOR LCOUNT, 0, L_VARSIZE
	SELECTCASE ARGS:2
		CASE "SHOP_EV_STR"
			SIF !IS_MATCH_SHOP_EV_FLAGNAME(SHOP_EV_STRNAME:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			RETURNF SHOP_EV_STR:EV_NUM:LCOUNT
		CASE "SHOP_EV_STR_TAKEOVER"
			SIF !IS_MATCH_SHOP_EV_FLAGNAME(SHOP_EV_STRNAME_TAKEOVER:EV_NUM:LCOUNT, ARGS:1)
				CONTINUE
			RETURNF SHOP_EV_STR_TAKEOVER:EV_NUM:LCOUNT
	ENDSELECT
NEXT
RETURNF ""

@GET_STR_SHOP_EV, ARGS, ARGS:1
#FUNCTIONS
RETURNF GETS_SHOP_EV_F(ARGS, ARGS:1, "SHOP_EV_STR")

@GET_STR_SHOP_EV_TAKEOVER, ARGS, ARGS:1
#FUNCTIONS
RETURNF GETS_SHOP_EV_F(ARGS, ARGS:1, "SHOP_EV_STR_TAKEOVER")
