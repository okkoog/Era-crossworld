;====================
@SHOP_EV_NAME_1
RESULTS = 라그의 가게에서 알림

;====================
;条件
;====================
@PLAYABLE_SHOP_EV_1
#DIM DYNAMIC LCOUNT
SIF IS_USEABLE_RAGSHOP
	RETURN 0
;探索を一回はしている(チュートリアルが発生しなくなっている必要がある)
SIF !FLAG:첫탐색종료
	RETURN 0
;いずれかの宝石を持っている
FOR LCOUNT, 0, VARSIZE("RAGJUEL_TABLE")
	SIF !ITEM:(RAGJUEL_TABLE:LCOUNT)
		CONTINUE
	RETURN 1
NEXT
RETURN 0

