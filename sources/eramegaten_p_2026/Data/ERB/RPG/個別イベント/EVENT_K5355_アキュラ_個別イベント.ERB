;-------------------------------------------------
;アキュラ個別イベント。
;彼らが何故こちらの世界に来たのかはこっちで説明するシナリオになるぞ！
;イベント番号消費するのは気が進まなかったのと
;ARGでアキュラくんの番号を拾えるのが便利なのでこっち使うぞ
;-------------------------------------------------
;「転移先は人類滅亡してました～世界を救った科学者、科学チートで無双する～」こと『白き鋼鉄のＸ２』編も始めたぞ
;テーマは「アキュラくんとゆくグレイヴピラー攻略の旅」だぞ
;-------------------------------------------------
;★使用個別イベントフラグ一覧
;개별이벤트플래그1:『祈歌－プレイヤー－』で使用　？？？の歌の管理/『交錯－グランドクロス－』『管理者－マザー－』で使用　ライブノベル管理
;개별이벤트플래그2:『サブイベント』で使用　各イベントの進行状況管理
;개별이벤트플래그3:X2ルート全体で使用　ルートの進行状況管理
;개별이벤트플래그4:ヌルちゃん's性別メモリ(bit)
;　0桁目：アキュラの性別記録（0ならオンナ、1ならオトコ）
;　1桁目：＠の性別記録（0ならオンナ、1ならオトコ）
;　2桁目：設定完了の証（済み：1か未済：0）
;　3桁目：アキュラのイベント確認（0:未確認/1:確認完了）
;　4桁目：＠のイベント確認（0:未確認/1:確認完了）
;개별이벤트플래그5(bit):『交錯－グランドクロス－』で使用　戦闘状況管理
;-------------------------------------------------
@INDIVIDUAL_EVENT_K5355, ARG, ARG:1 = 0, ARG:2 = -1
#LOCALSIZE 3
#LOCALSSIZE 1
#DIM BLADE
#DIM GV
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）

;リストにキャラを表示する条件
SIF ARG:1 == 0
	RETURN 1
SELECTCASE ARG:2
	CASE 0
		;解放条件
		IF ARG:1 == 1
			;フィルタONにしてたらダメ
			SIF !GETS_USEABLE_EXTRA_TITLE("白き鋼鉄のX")
				RETURN 0
			RETURN 1
		ELSEIF ARG:1 == 2
		;타이틀
			RESULTS = 토크 이벤트
		;이벤트
		ELSEIF ARG:1 == 3
			CALL TALK_ROOM_K5355, ARG
			RETURN 0
		ENDIF
ENDSELECT
RETURN 0

;サブイベント関連はこの辺りで
@TALK_ROOM_K5355, ARG
$TALK_ROOM_TOP
CALL TALK_ROOM_TIPS, ARG
;この辺で部屋っぽいAAを張りたかったんだけど
;なんかずれるので取り止め
CALL INPUT_SELECT_M, "＞이제부터 무엇을 할까……。//[1] ＴＡＬＫ/[0] ＢＡＣＫ", , , 2, 4, "LEFT", 72
;CLEARLINE 4
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 1
		CALL TALK_EVENT_K5355, ARG
ENDSELECT
GOTO TALK_ROOM_TOP

@TALK_ROOM_TIPS, COPEN
#DIM DYNAMIC LCOUNT
#DIM CONST CHARA_TABLE = [[キャラ:아큐라_X]], [[キャラ:블레이드_X]], [[キャラ:GV]], [[キャラ:엘리제1_GV]], [[キャラ:엘리제2_GV]], [[キャラ:엘리제3_GV]], [[キャラ:코하쿠_X]], [[キャラ:널_X2]]
#DIM DYNAMIC COPEN
#DIMS DYNAMIC L_TALK
#DIM DYNAMIC 抽選対象, 10
#DIM DYNAMIC TIPS対象
FOR LCOUNT, 0, VARSIZE("CHARA_TABLE")
	SIF GETCHARA(CHARA_TABLE:LCOUNT) < 0
		CONTINUE
	CALL PUSH_ARRAY_INT, 抽選対象, CHARA_TABLE:LCOUNT
NEXT
TIPS対象 = 抽選対象:RAND(FINDELEMENT(抽選対象, 0))
SETCOLOR COLOR("FRIEND")

SELECTCASE TIPS対象
	CASE [[キャラ:아큐라_X]]
		;アキュラならロロと二択
		IF RAND:2 == 0
			L_TALK '= @"ここは本編から独立した空間だ"
			L_TALK += "_" + @"真面目に時系列を考察しても意味がない。覚えておくといい"
			CALL PRINT_TALK_BY_CHARA, GETCHARA(TIPS対象), TIPS対象, , L_TALK
		ELSE
			L_TALK '= @"ここは本編と関係のない場所だよ"
			L_TALK += "_" + @"起こるイベントの時系列を気にしちゃいけないぜ？"
			CALL PRINT_TALK_BY_CSV, [[キャラ:아큐라_X]], CONVERT_FACE_ADDRESS_アキュラ("ロロ_バトルポッド"), L_TALK, "ＲｏＲｏ" 
		ENDIF
	CASE [[キャラ:블레이드_X]]
		L_TALK '= @"ここは本編から切り離された空間……"
		L_TALK += "_" + @"即ち、何が起きてもおかしくない、ということだ"
		CALL PRINT_TALK_BY_CHARA, GETCHARA(TIPS対象), TIPS対象, , L_TALK
		PRINTW 
	CASE [[キャラ:GV]]
		;GVならシアンと二択
		IF RAND:2 == 0
			L_TALK '= @"ここでは本編で扱わないイベントが見られます"
			L_TALK += "_" + @"何が起きたとしても、本編には影響がありません"
	
			CALL PRINT_TALK_BY_CHARA, GETCHARA(TIPS対象), TIPS対象, , L_TALK
		ELSE
			L_TALK '= @"ここは本編のオマケみたいなイベントだよ"
			L_TALK += "_" + @"細かいことは気にしないでね？"
			
			CALL PRINT_TALK_BY_CSV, [[キャラ:GV]], "FACE_EX_1", L_TALK, "시안"
		ENDIF
	CASE [[キャラ:엘리제1_GV]]
		L_TALK '= @"えっと……ここでは、おまけイベントが見られます"
		L_TALK += "_" + @"すみません、わたしが出しゃばってすみませぇん……"
		CALL PRINT_TALK_BY_CHARA, GETCHARA(TIPS対象), TIPS対象, , L_TALK
		PRINTW 
	CASE [[キャラ:엘리제2_GV]]
		L_TALK '= @"キシャシャシャシャッ！！　ヨおこソ、こノ部屋へェ！"
		L_TALK += "_" + @"アタシと一緒ニ、遊ビまショお！？"
		CALL PRINT_TALK_BY_CHARA, GETCHARA(TIPS対象), TIPS対象, , L_TALK
		PRINTW 
	CASE [[キャラ:엘리제3_GV]]
		L_TALK '= @"よく来たわね。ここはトークルーム……"
		L_TALK += "_" + @"細かいことなんて考えずに、精々楽しみなさい"
		CALL PRINT_TALK_BY_CHARA, GETCHARA(TIPS対象), TIPS対象, , L_TALK
		PRINTW 
	CASE [[キャラ:코하쿠_X]]
		L_TALK '= @"ここはトークルーム！　起きることは何でもありなんだって！"
		L_TALK += "_" + @"細かい事は考えるだけ無駄だ、ってアキュラくんが言ってた！"
		CALL PRINT_TALK_BY_CHARA, GETCHARA(TIPS対象), TIPS対象, , L_TALK
		PRINTW 
	CASE [[キャラ:널_X2]]
		L_TALK '= @"お疲れ様です。こちらはトークルームです"
		L_TALK += "_" + @"どうやら色々なイベントが見られるようですよ？"
		CALL PRINT_TALK_BY_CHARA, GETCHARA(TIPS対象), TIPS対象, , L_TALK
		PRINTW 
ENDSELECT
RESETCOLOR

@TALK_EVENT_K5355, COPEN
#DIM DYNAMIC COPEN
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC L_TALK
#DIMS DYNAMIC L_TEXT, 6
#LOCALSIZE 2
#LOCALSSIZE 2
#DIM BLADE
#DIM GV
#DIM 添字
;今後増えることを見越して。
#DIMS TALK候補, 64
;ネタ構想：
;アキュラ「ブリッツとは？」「ブリッツダッシュについて」「元の世界の話1」「退魔の鈴」「トマト博士」「実装されなかった機能（カゲロウとフラッシュフィールド）」
;ロロ「希望の歌姫」「クードスについて1」「サメ映画上映中」「ロボっぽくないね」
;ブレイド「コハクって？」「類稀な剣技」「コハクとロロP」
;GV「元の世界の話2」「跳ねる戦車」「チャタンヤラクーシャンク」「ダートは髪」「第七波動で節約」「EPとかっこいいポーズ1」
;シアン「電子の謡精」「クードスについて2」「カップ焼きそば」「頭のおか…恥ずかしい内容のSTG」
;アキュラ&ブレイド「また戦うことになるとは」
;アキュラ&GV「ブラスターでマスターな話」「マイティでバーストな話」「二人の歌姫」
;ブレイド&GV「他人とは思えない」「EPとかっこいいポーズ2」
;アキュラ&GV&ブレイド「大人びた子供たち」
CALL 口上変数初期化
VARSET LOCALS

LOCAL = 0
;ここに入る時点でアキュラがいるのは確定なのでアキュラとロロ分をセット
TALK候補:LOCAL = ブリッツとは？
LOCAL += 1
TALK候補:LOCAL = ブリッツダッシュについて
LOCAL += 1
TALK候補:LOCAL = 元の世界の話1
LOCAL += 1
TALK候補:LOCAL = 退魔の鈴
LOCAL += 1
TALK候補:LOCAL = トマト博士
LOCAL += 1
TALK候補:LOCAL = 実装されなかった機能
LOCAL += 1
TALK候補:LOCAL = 希望の歌姫
LOCAL += 1
TALK候補:LOCAL = クードスについて1
LOCAL += 1
TALK候補:LOCAL = サメ映画上映中
LOCAL += 1
TALK候補:LOCAL = ロボっぽくないね
LOCAL += 1

;ブレイドがいれば更に話題を追加
BLADE = GETCHARA([[キャラ:블레이드_X]])
IF BLADE > 0
	TALK候補:LOCAL = コハクって？
	LOCAL += 1
	TALK候補:LOCAL = 類稀な剣技
	LOCAL += 1
	TALK候補:LOCAL = コハクとロロP
	LOCAL += 1
	TALK候補:LOCAL = また戦うことになるとは
	LOCAL += 1
ENDIF

;GVがいれば更に話題を追加
GV = GETCHARA([[キャラ:GV]])
IF GV > 0
	TALK候補:LOCAL = 元の世界の話2
	LOCAL += 1
	TALK候補:LOCAL = 跳ぶ戦車、跳ばない戦車
	LOCAL += 1
	TALK候補:LOCAL = チャタンヤラクーシャンク
	LOCAL += 1
	TALK候補:LOCAL = ダートは髪
	LOCAL += 1
	TALK候補:LOCAL = 第七波動で節約
	LOCAL += 1
	TALK候補:LOCAL = EPとかっこいいポーズ1
	LOCAL += 1
	TALK候補:LOCAL = 電子の謡精
	LOCAL += 1
	TALK候補:LOCAL = クードスについて2
	LOCAL += 1
	TALK候補:LOCAL = カップ焼きそば
	LOCAL += 1
	TALK候補:LOCAL = 頭のおか…恥ずかしい内容のSTG
	LOCAL += 1
	TALK候補:LOCAL = ブラスターでマスターな話
	LOCAL += 1
	TALK候補:LOCAL = 二人の歌姫
	LOCAL += 1
ENDIF

;ブレイドとGVがいれば更に話題を追加
IF BLADE > 0 && GV > 0
	TALK候補:LOCAL = 他人とは思えない
	LOCAL += 1
	TALK候補:LOCAL = EPとかっこいいポーズ2
	LOCAL += 1
	TALK候補:LOCAL = 大人びた子供たち
	LOCAL += 1
ENDIF

添字 = RAND:LOCAL

CUSTOMDRAWLINE =
SELECTCASE TALK候補:添字
CASE "ブリッツダッシュについて"
	SETCOLOR COLOR("FRIEND")
	L_TALK '= @"블리츠대쉬……ブリッツのエネルギーを用い、"
	L_TALK += "_" + @"瞬間的に強烈な推進力を実現する空中機動だ"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	L_TALK '= @"この銃……ディヴァイドのマーキング機能と組み合わせ、"
	L_TALK += "_" + @"対象のみに狙いを定めて攻撃を可能とする"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	RESETCOLOR
	L_TEXT:0 '= @"傍で見る度、物凄い勢いだと感心させられるが……"
	L_TEXT:1 '= @"明らかに受ける衝撃も凄まじいのでは？"
	FOR LCOUNT, 0, 6
		PRINTFORML %L_TEXT:LCOUNT%
	NEXT
	WAIT
	VARSET L_TEXT

	SETCOLOR COLOR("FRIEND")
	L_TALK '= @"そのためのこの鎧――ヴァイスティーガーだ"
	L_TALK += "_" + @"……もっとも、常人に扱えるものではないのも確かだがな"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	RESETCOLOR
	L_TEXT:0 '= @"字面だけならば「己が常人ではない」という驕りとも受け取れるが"
	L_TEXT:1 '= @"%CALLNAME:COPEN%からは寧ろ、自嘲のようなものを感じた……。"
	FOR LCOUNT, 0, 6
		PRINTFORML %L_TEXT:LCOUNT%
	NEXT
	WAIT
	VARSET L_TEXT

CASE "ブリッツとは？"
	L_TEXT:0 '= @"そういえば何気なく使っているが、ブリッツとは一体何なのだろうか。"
	L_TEXT:1 '= @"ブリッツダッシュのたびに切り替えているようだが。"
	FOR LCOUNT, 0, 6
		PRINTFORML %L_TEXT:LCOUNT%
	NEXT
	WAIT
	VARSET L_TEXT

	SETCOLOR COLOR("FRIEND")
	L_TALK '= @"アームドブルーのセプティマを再現したバッテリーのようなものだ"
	L_TALK += "_" + @"見た目こそ小さいが、内蔵する電力量は相当のものになる"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	L_TALK '= @"けどさー、なんでわざわざ形状を弾丸になんてしちゃった訳？"
	L_TALK += "_" + @"しかも『ブリッツ』なんて仰々しい名前まで付けてさ"
	CALL PRINT_TALK_BY_CSV, [[キャラ:아큐라_X]], CONVERT_FACE_ADDRESS_アキュラ("ロロ_バトルポッド"), L_TALK, "ＲｏＲｏ" 
	PRINTW 
	RESETCOLOR
	L_TEXT:0 '= @"そこはやはり恰好がつかないからでは？"
	L_TEXT:1 '= @"ＡＢバッテリーではダサいだろう。"
	FOR LCOUNT, 0, 6
		PRINTFORML %L_TEXT:LCOUNT%
	NEXT
	WAIT
	VARSET L_TEXT

	SETCOLOR COLOR("FRIEND")
	L_TALK '= @"……いいだろう、別に"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	RESETCOLOR
CASE "元の世界の話1"
	SETCOLOR COLOR("FRIEND")
	L_TALK '= @"元の世界の話が聞きたい、だと？　愉快な話はできないぞ"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	RESETCOLOR
	L_TEXT:0 '= @"別に笑い話を求めた訳ではない。"
	L_TEXT:1 '= @"%CALLNAME:COPEN%がどう戦ってきたかを聞きたくなっただけだ。"
	FOR LCOUNT, 0, 6
		PRINTFORML %L_TEXT:LCOUNT%
	NEXT
	WAIT
	VARSET L_TEXT

	SETCOLOR COLOR("FRIEND")
	L_TALK '= @"……そうだな。基本的には今のように、匿ってもらいながら"
	L_TALK += "_" + @"セプティマホルダーと戦ってきた形になる、か"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	L_TALK '= @"でも大変だったよねー。酷い時なんて石を投げて"
	L_TALK += "_" + @"拒否されたこともあったじゃない？"
	CALL PRINT_TALK_BY_CSV, [[キャラ:아큐라_X]], CONVERT_FACE_ADDRESS_アキュラ("ロロ_バトルポッド"), L_TALK, "ＲｏＲｏ" 
	PRINTW 
	RESETCOLOR
	L_TEXT:0 '= @"……匿うことで、アジトが露見するリスクを恐れた？"
	FOR LCOUNT, 0, 6
		PRINTFORML %L_TEXT:LCOUNT%
	NEXT
	WAIT
	VARSET L_TEXT

	SETCOLOR COLOR("FRIEND")
	L_TALK '= @"その通りだ。無論、それを責めることなどできるはずがない"
	L_TALK += "_" + @"……内容としては、これくらいだ"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	RESETCOLOR
CASE "退魔の鈴"
	L_TEXT:0 '= @"ロロの収納スペースから、何かが飛び出ている……"
	L_TEXT:1 '= @"紐に結んでいるのは、鈴か……？"
	FOR LCOUNT, 0, 6
		PRINTFORML %L_TEXT:LCOUNT%
	NEXT
	WAIT
	VARSET L_TEXT

	SETCOLOR COLOR("FRIEND")
	L_TALK '= @"おっと、危ない危ない。これ、とっても大切なやつなんだよ"
	CALL PRINT_TALK_BY_CSV, [[キャラ:아큐라_X]], CONVERT_FACE_ADDRESS_アキュラ("ロロ_バトルポッド"), L_TALK, "ＲｏＲｏ" 
	PRINTW 
	RESETCOLOR
	L_TEXT:0 '= @"パッと見たところ、霊験あらたかな品に見える。"
	L_TEXT:1 '= @"お守りの類だろうか。"
	FOR LCOUNT, 0, 6
		PRINTFORML %L_TEXT:LCOUNT%
	NEXT
	WAIT
	VARSET L_TEXT

	SETCOLOR COLOR("FRIEND")
	L_TALK '= @"うん。アキュラくんの家に代々伝わる、『退魔の鈴』って言うんだ"
	L_TALK += "_" + @"戦闘の邪魔だー、なんて言ってぼくのボディにしまってるけどね"
	CALL PRINT_TALK_BY_CSV, [[キャラ:아큐라_X]], CONVERT_FACE_ADDRESS_アキュラ("ロロ_バトルポッド"), L_TALK, "ＲｏＲｏ" 
	PRINTW 
	L_TALK '= @"効果を実感したことがないからだ"
	L_TALK += "_" + @"それに、ロロに収納しておく方が失くすリスクは抑えられるだろう"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	RESETCOLOR
	L_TEXT:0 '= @"ああ……ブリッツダッシュですっ飛んでいくからか。"
	L_TEXT:1 '= @"こんな紐なら千切れてすぐ飛んでいきそうだ。"
	FOR LCOUNT, 0, 6
		PRINTFORML %L_TEXT:LCOUNT%
	NEXT
	WAIT
	VARSET L_TEXT

	SETCOLOR COLOR("FRIEND")
	L_TALK '= @"……そういうことではない"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	RESETCOLOR
CASE "トマト博士"
	SETCOLOR COLOR("FRIEND")
	L_TALK '= @"突然だが、トマトは摂っているか？"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	L_TALK '= @"トマトには各種ビタミンやカリウムが含まれる他、"
	L_TALK += "_" + @"抗酸化作用を持つリコピンを多量に含んでいる"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	L_TALK '= @"コレステロールの酸化を防ぐことで血流の改善、"
	L_TALK += "_" + @"シミの原因となるチロシナーゼを抑制し美肌効果も期待できる……"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	L_TALK '= @"様々な点で益となる野菜だ"
	L_TALK += "_" + @"もし余裕があるなら、摂取することを勧める"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	RESETCOLOR
	L_TEXT:0 '= @"あ、はい。……随分詳しいね？"
	FOR LCOUNT, 0, 6
		PRINTFORML %L_TEXT:LCOUNT%
	NEXT
	WAIT
	VARSET L_TEXT

	SETCOLOR COLOR("FRIEND")
	L_TALK '= @"そうか？　一般教養だと思うが"
	CALL PRINT_TALK_BY_CHARA, COPEN, , , L_TALK
	PRINTW 

	L_TALK '= @"そうかなー……？"
	CALL PRINT_TALK_BY_CSV, [[キャラ:아큐라_X]], CONVERT_FACE_ADDRESS_アキュラ("ロロ_バトルポッド"), L_TALK, "ＲｏＲｏ" 
	PRINTW 
	RESETCOLOR
CASE "実装されなかった機能"
	SETCOLOR COLOR("FRIEND")
	L_TALK '= @"システムチェック……カゲロウ、フラッシュフィールドが破損中"
	L_TALK += "_" + @"やっぱり元の世界に戻らないと機能復元は難しいかなー"
	CALL PRINT_TALK_BY_CSV, [[キャラ:아큐라_X]], CONVERT_FACE_ADDRESS_アキュラ("ロロ_バトルポッド"), L_TALK, "ＲｏＲｏ" 
	PRINTW 
	RESETCOLOR
	L_TEXT:0 '= @"どうやら二人（一人と一機？）はメンテナンス中だったようだ。"
	L_TEXT:1 '= @"陽炎に、フラッシュ……何？"
	FOR LCOUNT, 0, 6
		PRINTFORML %L_TEXT:LCOUNT%
	NEXT
	WAIT
	VARSET L_TEXT

