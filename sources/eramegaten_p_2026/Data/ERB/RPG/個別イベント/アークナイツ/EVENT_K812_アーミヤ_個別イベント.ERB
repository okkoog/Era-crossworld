;-------------------------------------------------
;アーミヤ個人イベント
;-------------------------------------------------
@INDIVIDUAL_EVENT_K812, ARG, ARG:1 = 0, ARG:2 = -1
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM 導入フラグ
#DIM 現個人イベントバージョン = 100
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）

;リストにキャラを表示する条件
;モードチェンジ用なので終了しない
SIF ARG:1 == 0
	RETURN 1
SELECTCASE ARG:2
CASE 0
	;解放条件
	IF ARG:1 == 1
		;アークナイツ版の条件はこっち
		SIF CSTR:ARG:종족명 == "コータス"
			RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF CSTR:ARG:종족명 == "コータス"
			IF アーミヤ個人イベントバージョン < 現個人イベントバージョン && GETBIT(イベントフラグ:19:19, 9) != 1
				RESULTS = (중요) 데이터 리셋: 아미야
			ELSE
				IF GETBIT(CFLAG:ARG:개별이벤트개방, ARG:2)
					;타이틀
					RESULTS = 스킬 훈련: 아미야
				ELSE
					;未開放時のタイトル（解放条件を入れておく）
					RESULTS = (%CALLNAME:ARG% 가입으로 해금)
				ENDIF
			ENDIF
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		IF CSTR:ARG:종족명 == "コータス"
			IF アーミヤ個人イベントバージョン < 現個人イベントバージョン && !GETBIT(CFLAG:ARG:개별이벤트개방, ARG:2)
				PRINTL
				PRINTL ※개인 이벤트 버전이 갱신되어, 스킬 강화 및 승화 진행도가 초기화됩니다
				PRINTW 　이에 따라 강화에 사용된 아이템이 반환됩니다
				PRINTL
				PRINTL ※또한 아이템 반환 시, 주회 보너스의
				PRINTL 『무구 아이템 인계』 『방어구 아이템 인계』
				PRINTW 　등을 선택하지 않았을 경우, 해당 종류의 아이템이 반환되지 않는 점에 주의해 주십시오.
				PRINTL
				PRINTW 초기화를 진행하시겠습니까?
				CALL INPUT_YN
				SELECTCASE RESULT
					CASE 0
						CALL PU_SKILL_ENHANCE_MATERIAL_ROLLBACK_K812,ARG
						アーミヤ個人イベントバージョン = 現個人イベントバージョン
						RETURN 0
					CASE 1
						RETURN 0
				ENDSELECT
			ELSE
				$INDIVIDUAL_EVENT_K812_GOTO
				CUSTOMDRAWLINE =
				IF 導入フラグ == 0 
					導入フラグ = 1
					PRINTFORMW %CALLNAME:ARG%의 스킬 강화를 위해 훈련실을 찾았다.
					PRINTFORMW 이곳에서는 %CALLNAME:ARG%의 스킬을 강화, 변경할 수 있다.
					PRINTL
					PRINTW 단, 스킬 강화에는 특수한 재료가 필요하다. 찾기엔 꽤나 고생스러운 물건들뿐이지만, 끈기 있게 모아보자.
					IF 現個人イベントバージョン > アーミヤ個人イベントバージョン
						PRINTL
						PRINTL ※개인 이벤트 버전이 갱신되어, 스킬 강화 및 승화 진행도의 초기화가 가능해집니다
						PRINTL 　초기화할 경우 강화에 사용된 아이템이 반환됩니다
						PRINTW 　초기화를 진행하지 않으면 예기치 않은 오류가 발생할 수 있으므로, 초기화하는 것을 강력히 권장합니다
						PRINTL
						PRINTL ※또한 아이템 반환 시, 주회 보너스의
						PRINTL 『무구 아이템 인계』 『방어구 아이템 인계』
						PRINTW 　등을 선택하지 않았을 경우, 해당 종류의 아이템이 반환되지 않는 점에 주의해 주십시오.
						PRINTL
					ENDIF
				ENDIF
				PRINTL
				PRINTFORML 자, 어떻게 할까?
				PRINTL
				PRINTL
				PRINTFORML [0] 스킬을 변경한다
				PRINTFORML [1] 승화 의식을 치른다
				PRINTFORML [2] 전용기 리셋을 진행한다
				IF 現個人イベントバージョン > アーミヤ個人イベントバージョン
					PRINTFORML [3] ! 개인 이벤트 버전 갱신에 의한 스킬 강화도 및 승화 초기화, 소재 반환
				ELSEIF (CSTR:ARG:104 != "" && GETBIT(CFLAG:ARG:개별이벤트읽음,1)) || CSTR:ARG:105 != ""
					;昇華２達成、追想：魔王を継ぐ者クリア or 前衛クラスチェンジが解禁済みで解禁
					PRINTFORML [3] 클래스 변경을 진행한다
				ENDIF
				DRAWLINE
				PRINTFORML [99] 소지품을 확인한다
				DRAWLINE
				PRINTFORML [100] 돌아간다
				CALL INPUTINT(0,1,2,3,99,100)
				SELECTCASE RESULT
					CASE 0
						CALL EVENT_PU_SKILL_CHECK_K812(ARG)
					CASE 1
						CALL PROMOTION_K812(ARG)
					CASE 2
						CALL PU_SKILL_POSITION_RESET_266,ARG
					CASE 3
						IF 現個人イベントバージョン > アーミヤ個人イベントバージョン
							PRINTL
							PRINTL ※개인 이벤트 버전이 갱신되어, 스킬 강화 및 승화 진행도가 초기화됩니다
							PRINTW 　이에 따라 강화에 사용된 아이템이 반환됩니다
							PRINTL
							PRINTL
							PRINTL ※또한 아이템 반환 시, 주회 보너스의
							PRINTL 『무구 아이템 인계』 『방어구 아이템 인계』
							PRINTW 　등을 선택하지 않았을 경우, 해당 종류의 아이템이 반환되지 않는 점에 주의해 주십시오.
							PRINTL
							PRINTW 초기화를 진행하시겠습니까?
							CALL INPUT_YN
							SELECTCASE RESULT
								CASE 0
									CALL PU_SKILL_ENHANCE_MATERIAL_ROLLBACK_K812,ARG
									アーミヤ個人イベントバージョン = 現個人イベントバージョン
									GOTO INDIVIDUAL_EVENT_K812_GOTO
								CASE 1
									GOTO INDIVIDUAL_EVENT_K812_GOTO
							ENDSELECT
						ELSEIF (TOINT(CSTR:ARG:104) > 0 && GETBIT(CFLAG:ARG:개별이벤트읽음,1)) || CSTR:ARG:105 != ""
							CALL CLASS_ALTERNATE_K812,ARG
						ELSE
							GOTO INDIVIDUAL_EVENT_K812_GOTO
						ENDIF
					CASE 99
						CALL SHOP_COM_112
						GOTO INDIVIDUAL_EVENT_K812_GOTO
					CASE 100
						PRINTFORMW 볼일은 끝났다. 세이프하우스로 돌아가도록 하자.
						PRINTL
						導入フラグ = 0
						RETURN 0
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
CASE 1
	;解放条件
	IF ARG:1 == 1
		;アークナイツ版の条件はこっち
		IF CSTR:ARG:종족명 == "コータス"
			;アーミヤのレベルが70未満、昇華２を達成できていない場合は不可
			SIF BASE:ARG:LV < 70
				RETURN 0
			SIF CSTR:ARG:104 == ""
				RETURN 0
			;未陥落の場合は不可
			SIF 陥落(ARG) < 1
				RETURN 0
			RETURN 1
		ENDIF
	ELSEIF ARG:1 == 2
	;타이틀
		IF CSTR:ARG:종족명 == "コータス"
			IF GETBIT(CFLAG:ARG:개별이벤트개방, ARG:2)
				;타이틀
				;英語版はたぶん『Soul Surrender』とかになると思う（ヒカセン並感）
				RESULTS = 『마왕』을 잇는 자
			ELSE
				;未開放時のタイトル（解放条件を入れておく）
				RESULTS = (%CALLNAME:ARG%의 레벨 70 이상, 영격 승화 2 달성, 함락 완료로 해금)
			ENDIF
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		IF CSTR:ARG:종족명 == "コータス"
			SETCOLOR COLOR("RED")
			PRINTL ※注意！
			RESETCOLOR
			PRINTFORML 이 이벤트에서는 %CALLNAME:MASTER% 부재 상태에서의 전투가 발생합니다
			PRINTW 진행해도 괜찮습니까?
			CALL INPUT_YN
			IF RESULT == 0
				CALL INDIVIDUAL_EVENT_K812_AN_SOULSURRENDER,ARG
				RESULT = 1
				RETURN 1
			ELSE
				PRINTW 이벤트를 일시 중단합니다
				RETURN 0
			ENDIF
		ENDIF
	ENDIF
ENDSELECT

@EVENT_PU_SKILL_CHECK_K812,ARG
#LOCALSIZE 1
#DIM 計算用変数,5
#DIM 必要アイテム不足変数
#DIM 必要アイテム = -1
#DIMS 確認するスキル
#DIMS 必要条件 = ""

VARSET 必要アイテム不足変数,0
VARSET 必要アイテム,-1
$EVENT_PU_SKILL_CHECK_K812_GOTO
PRINTFORML 현재 %CALLNAME:ARG%이(가) 사용 중인 전용기는 %CSTR:ARG:전용기1%다.
PRINTL
PRINTFORML 어떻게 할까?
PRINTL
SELECTCASE CSTR:ARG:101
	CASE "アーミヤ",""
		PRINTFORML [0] 전술영창γ를 확인한다
		IF CSTR:ARG:103 == ""
			SETCOLOR COLOR("GRAY")
			PRINTFORML [1] -
			RESETCOLOR
		ELSE
			PRINTFORML [1] 소울 부스트를 확인한다
		ENDIF
		IF CSTR:ARG:104 == ""
			SETCOLOR COLOR("GRAY")
			PRINTFORML [2] -
			RESETCOLOR
		ELSE
			PRINTFORML [2] 키메라를 확인한다
		ENDIF
	CASE "アーミヤ（前衛）"
		PRINTFORML [0] 영초・분야를 확인한다
		PRINTFORML [1] 영초・절영을 확인한다
ENDSELECT
PRINTFORML [99] 돌아간다
$EVENT_PU_SKILL_CHECK_K812_GOTO2
CALL INPUTINT(0,1,2,99)
SELECTCASE RESULT
	CASE 0
		IF CSTR:ARG:101 == "アーミヤ" || CSTR:ARG:101 == ""
			確認するスキル = 戦術詠唱γ
			計算用変数 = TOINT(CSTR:ARG:102)
		ELSEIF CSTR:ARG:101 == "アーミヤ（前衛）"
			確認するスキル = 影霄・奔夜
			計算用変数 = TOINT(CSTR:ARG:105)
		ELSE
			GOTO EVENT_PU_SKILL_CHECK_K812_GOTO2
		ENDIF
	CASE 1
		IF CSTR:ARG:103 != "" && (CSTR:ARG:101 == "アーミヤ" || CSTR:ARG:101 == "")
			確認するスキル = ソウルブースト
			計算用変数 = TOINT(CSTR:ARG:103)
		ELSEIF CSTR:ARG:101 == "アーミヤ（前衛）"
			確認するスキル = 影霄・絶影
			計算用変数 = TOINT(CSTR:ARG:106)
		ELSE
			GOTO EVENT_PU_SKILL_CHECK_K812_GOTO2
		ENDIF
	CASE 2
		IF CSTR:ARG:104 != "" && (CSTR:ARG:101 == "アーミヤ" || CSTR:ARG:101 == "")
			確認するスキル = キメラ
			計算用変数 = TOINT(CSTR:ARG:104)
		ELSE
			GOTO EVENT_PU_SKILL_CHECK_K812_GOTO2
		ENDIF
	CASE 99
		JUMP INDIVIDUAL_EVENT_K812,ARG,3,0
ENDSELECT
$EVENT_PU_SKILL_CHECK_K812_GOTO3
;計算用変数:0 = スキルランク
;計算用変数:1 = 初期ＳＰ
;計算用変数:2 = 必要ＳＰ
;計算用変数:3 = ダメージ倍率
;計算用変数:4 = 戦術詠唱γは魔法命中・回避上昇の段階、ソウルブーストは攻撃回数、キメラは最大ＨＰ増加倍率
FOR COUNT,1,5
	SELECTCASE COUNT
		CASE 1
			SELECTCASE 確認するスキル
				CASE "ソウルブースト","キメラ","影霄・絶影"
					LOCAL = 0
				CASE "戦術詠唱γ"
					SELECTCASE 計算用変数
						CASE 1
							LOCAL = 0
						CASE 2
							LOCAL = 5
						CASE 3
							LOCAL = 10
						CASE 4
							LOCAL = 15
					ENDSELECT
				CASE "影霄・奔夜"
					LOCAL = 10
			ENDSELECT
		CASE 2
			SELECTCASE 確認するスキル
				CASE "戦術詠唱γ"
					SELECTCASE 計算用変数
						CASE 1
							LOCAL = 40
						CASE 2
							LOCAL = 35
						CASE 3
							LOCAL = 32
						CASE 4
							LOCAL = 30
					ENDSELECT
				CASE "ソウルブースト"
					LOCAL = 100
				CASE "キメラ"
					LOCAL = 120
				CASE "影霄・奔夜"
					SELECTCASE 計算用変数
						CASE 1
							LOCAL = 45
						CASE 2
							LOCAL = 42
						CASE 3
							LOCAL = 39
						CASE 4
							LOCAL = 35
					ENDSELECT
				CASE "影霄・絶影"
					LOCAL = 20
			ENDSELECT
		CASE 3
			SELECTCASE 確認するスキル
				CASE "戦術詠唱γ"
					SELECTCASE 計算用変数
						CASE 1
							LOCAL = 10
						CASE IS > 1
							LOCAL = 20
					ENDSELECT
				CASE "ソウルブースト"
					SELECTCASE 計算用変数
						CASE 1
							LOCAL = 33
						CASE 2
							LOCAL = 39
						CASE 3
							LOCAL = 45
						CASE 4
							LOCAL = 60
					ENDSELECT
				CASE "キメラ"
					SELECTCASE 計算用変数
						CASE 1
							LOCAL = 50
						CASE 2
							LOCAL = 65
						CASE 3
							LOCAL = 80
						CASE 4
							LOCAL = 115
					ENDSELECT
				CASE "影霄・奔夜"
					SELECTCASE 計算用変数
						CASE 1
							LOCAL = 10
						CASE 2
							LOCAL = 18
						CASE 3
							LOCAL = 25
						CASE 4
							LOCAL = 40
					ENDSELECT
				CASE "影霄・絶影"
					;絶影はスキル威力
					SELECTCASE 計算用変数
						CASE 1
							LOCAL = 120
						CASE 2
							LOCAL = 140
						CASE 3
							LOCAL = 160
						CASE 4
							LOCAL = 220
					ENDSELECT
			ENDSELECT
		CASE 4
			SELECTCASE 確認するスキル
				CASE "戦術詠唱γ"
					SELECTCASE 計算用変数
						CASE 1,2
							LOCAL = 1
						CASE IS > 2
							LOCAL = 2
					ENDSELECT
				CASE "ソウルブースト"
					SELECTCASE 計算用変数
						CASE 1
							LOCAL = 5
						CASE 2,3
							LOCAL = 6
						CASE 4
							LOCAL = 7
					ENDSELECT
				CASE "キメラ"
					SELECTCASE 計算用変数
						CASE 1
							LOCAL = 25
						CASE 2
							LOCAL = 50
						CASE 3
							LOCAL = 75
						CASE 4
							LOCAL = 100
					ENDSELECT
				CASE "影霄・絶影"
					;ダメージ上昇
					SELECTCASE 計算用変数
						CASE IS < 3
							LOCAL = 10
						CASE 3
							LOCAL = 13
						CASE 4
							LOCAL = 20
					ENDSELECT
			ENDSELECT
	ENDSELECT
	計算用変数:(COUNT) = LOCAL
NEXT
DRAWLINE
PRINTL
PRINTFORML %確認するスキル%　초기 SP:{計算用変数:1}　필수 SP:{計算用変数:2}
PRINTL
SELECTCASE 確認するスキル
	CASE "戦術詠唱γ"
		PRINTL 턴 경과 시 SP 5 상승.
		PRINTL 필수 SP를 충족했을 때, 커맨드를 선택하는 것으로 기동할 수 있다.
		PRINTFORML 스킬 기동 중, 공격 데미지가 {計算用変数:3}% 증가하고,
		PRINTFORML 마법 공격의 명중・회피가 {計算用変数:4}단계 상승, 물리 공격의 회피가 1단계 상승한다.
		SIF 計算用変数 > 3
			PRINTL 추가로 스킬 기동 중인 동안, 임의의 마법 공격을 추가로 발동하는 『EX-CAST』 커맨드가 선택 가능해진다.
	CASE "ソウルブースト"
		PRINTL 턴 경과 시 SP 5 상승.
		PRINTL 필수 SP를 충족한 시점에서 자동으로 발동한다.
		PRINTFORML 스킬 기동 중, 자신의 카운터 및 추격 계열 공격의 데미지가 {計算用変数:3}%까지 저하.
		PRINTFORML 그 대신, 자신의 마법 공격 후에 적 전체를 무작위 대상으로 한 추격을 {計算用変数:4}회 행한다.
		PRINTL 추격의 위력과 상성은 직전에 사용한 마법 공격의 것을 인계한다.
		PRINTL 효과 종료 시 자신에게 자연 회복까지 2턴 걸리는 SLIP을 부여.
	CASE "キメラ"
		PRINTL 턴 경과 시 SP 5 상승.
		PRINTL 필수 SP를 충족했을 때, 커맨드를 선택하는 것으로 기동할 수 있다.
		PRINTFORML 스킬 기동 중, 마법 공격 데미지가 {計算用変数:3}% 증가하고, 최대 HP가 {計算用変数:4}% 증가, HP도 증가분만큼 회복.
		PRINTL 효과가 지속되는 동안, 마법 공격 스킬을 사용했을 때에 한해 대상의 반사 or 흡수 이외의 내성과 무효화 계열 스킬을 관통하며,
		PRINTL 공격 대상의 피데미지 보정의 영향을 받지 않게 된다.
		PRINTL 스킬 기동 중 공격 마법을 사용했을 때, 「공격 대상을 적 전체에서 무작위 1개체」, 「데미지 타입 없음」으로 변경하고, 행동을 「키메라」로 덮어씌운다.
		PRINTL 「키메라」는 입력한 마법 공격의 성능을 인계하지만, 공격 횟수는 1회로 고정된다.
		PRINTL 기동 중 전투 이탈, 혹은 전투 불능이 되었을 때 게이지 리셋, 추가로 쿨타임 게이지 추가.
		PRINTL 쿨타임 게이지가 소멸할 때까지, 스킬 발동에 필요한 SP는 증가하지 않는다.
		SETCOLOR COLOR("RED")
		PRINTL 효과 종료, 혹은 게이지 리셋이 발생한 경우, 사용자는 강제적으로 DYING 상태가 된다.
		RESETCOLOR
	CASE "影霄・奔夜"
		PRINTL 턴 경과 시 SP 5 상승.
		PRINTL 필수 SP를 충족했을 때, 커맨드를 선택하는 것으로 기동할 수 있다.
		PRINTFORML 스킬 기동 중, 자신의 주는 데미지가 {計算用変数:3}% 증가하고, 마법 공격에 대한 회피율이 2단계 상승한다.
