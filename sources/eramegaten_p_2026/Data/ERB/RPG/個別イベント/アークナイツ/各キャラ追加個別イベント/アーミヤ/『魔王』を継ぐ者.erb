@SET_ACTION_TALULAH, ARG
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM LCOUNT
#DIM 反射チェック
#DIM 相性チェック
#DIM 強化解除チェック
#DIM 弱体解除チェック
IF CFLAG:ARG:１more플래그 > 0
	VARSET 反射チェック,0
	VARSET 相性チェック,0
	VARSET 強化解除チェック,0
	VARSET 弱体解除チェック,0
	VARSET LOCALS
	;ワンモア時、自身に不利な状況を改善する手段を取る
	;反射解除　＞　相性貫通　＞　強化解除　＞ 弱体解除 ＞ 컨센트레이트　の優先順位
	FOR LCOUNT,1,7
		LOCAL = POS(LCOUNT)
		SIF LOCAL < 0
			CONTINUE
		;反射チェック立ってない時に同時反射してる奴がいたらフラグが立つ
		SIF 反射チェック == 0 && CFLAG:LOCAL:마법반사플래그 > 0 && CFLAG:LOCAL:물리반사플래그 > 0
			反射チェック = 1
		IF 相性チェック == 0
			IF CFLAG:ARG:주살가드킬 == 0 && (MAXBASE:LOCAL:주살 < 100 || MAXBASE:LOCAL:주살 == 999)
				LOCALS = 주살
			ENDIF
			IF CFLAG:ARG:검격가드킬 == 0  && (MAXBASE:LOCAL:검격 < 100 || MAXBASE:LOCAL:검격 == 999)
				LOCALS = 검격
			ENDIF
			IF CFLAG:ARG:비구가드킬 == 0 && (MAXBASE:LOCAL:비구 < 100 || MAXBASE:LOCAL:비구 == 999)
				LOCALS = 비구
			ENDIF
			IF CFLAG:ARG:화염가드킬 == 0 && (MAXBASE:LOCAL:화염 < 100 || MAXBASE:LOCAL:화염 == 999)
				LOCALS = 화염
			ENDIF
			SIF LOCALS != ""
				相性チェック = 1
		ENDIF
		強化解除チェック = ( CFLAG:LOCAL:공격강화 + CFLAG:LOCAL:방어강화 + CFLAG:LOCAL:명중강화 + CFLAG:LOCAL:회피강화 + CFLAG:LOCAL:마법위력강화 + CFLAG:LOCAL:마법효과강화 ) / 6
	NEXT
	IF 強化解除チェック >= 48
		強化解除チェック = 1
	ELSE
		強化解除チェック = 0
	ENDIF
	IF GROUPMATCH(-16,CFLAG:ARG:공격강화,CFLAG:ARG:방어강화,CFLAG:ARG:마법위력강화,CFLAG:ARG:마법효과강화,CFLAG:ARG:명중강화,CFLAG:ARG:회피강화)
		弱体解除チェック = 1
	ENDIF
	IF 反射チェック == 1
		CALL SET_ACTION_SKILL, ARG, [[스킬:테트라코와스]]
	ELSEIF 相性チェック == 1
		SELECTCASE LOCALS
			CASE "검격"
				CALL SET_ACTION_SKILL, ARG, [[스킬:검격가드브레이크]]
			CASE "화염"
				CALL SET_ACTION_SKILL, ARG, [[스킬:화염가드브레이크]]
			CASE "주살"
				CALL SET_ACTION_SKILL, ARG, [[스킬:주살가드브레이크]]
		ENDSELECT
	ELSEIF 強化解除チェック == 1
		CALL SET_ACTION_SKILL, ARG, [[스킬:데・카쟈]]
	ELSEIF 弱体解除チェック == 1
		CALL SET_ACTION_SKILL, ARG, [[스킬:데・쿤다]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:컨센트레이트]]
	ENDIF
ELSEIF CFLAG:ARG:행동한횟수 == 0
	IF 現HP割合(ARG) < 50
		IF RAND:3 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:화염가드킬]]
		ELSEIF RAND:2 == 0
			CALL SET_ACTION_SKILL, ARG, [[스킬:브레이브재퍼]]
		ELSE
			CALL SET_ACTION_SKILL, ARG, [[스킬:컨센트레이트]]
		ENDIF
	ELSE
		SELECTCASE FLAG:경과턴수 % 5
			CASE 0
				CALL SET_ACTION_SKILL, ARG, [[스킬:데들리번]]
			CASE 1
				CALL SET_ACTION_SKILL, ARG, [[스킬:컨센트레이트]]
			CASE 2
				CFLAG:ARG:타겟 = CPOS(ARG)
				CFLAG:ARG:입력행동 = [[스킬:히트라이저]]
			CASE 3
				CALL SET_ACTION_SKILL, ARG, [[스킬:브레이브재퍼]]
			CASEELSE
				CALL SET_ACTION_SKILL, ARG, [[스킬:브레이브스텝]]
		ENDSELECT
	ENDIF
ELSEIF CFLAG:ARG:행동한횟수 == 1
	IF SKILLGAGE_H_GET(ARG,[[스킬:전용기2]]) >= 19
		CALL SET_ACTION_SKILL, ARG, [[스킬:전용기2]]
	ELSEIF SKILLGAGE_H_GET(ARG,[[스킬:전용기1]]) >= 40 
		CALL SET_ACTION_SKILL, ARG, [[스킬:전용기1]]
	ELSE
		IF 現HP割合(ARG) < 75
			SELECTCASE FLAG:경과턴수 % 5
				CASE 0
					CALL SET_ACTION_SKILL, ARG, [[스킬:데들리번]]
				CASE 1
					CALL SET_ACTION_SKILL, ARG, [[스킬:컨센트레이트]]
				CASE 2
					CFLAG:ARG:타겟 = CPOS(ARG)
					CFLAG:ARG:입력행동 = [[스킬:히트라이저]]
				CASE 3
					CALL SET_ACTION_SKILL, ARG, [[스킬:브레이브재퍼]]
				CASEELSE
					CALL SET_ACTION_SKILL, ARG, [[스킬:브레이브스텝]]
			ENDSELECT
		ELSE
			;HPが75以上の時は追加行動しない
			CFLAG:ARG:입력행동 = -1
		ENDIF
	ENDIF
ELSE
	IF SKILLGAGE_H_GET(ARG,[[스킬:전용기1]]) >= 40
		CALL SET_ACTION_SKILL, ARG, [[스킬:전용기1]]
	ELSEIF SKILLGAGE_H_GET(ARG,[[스킬:전용기2]]) >= 19
		CALL SET_ACTION_SKILL, ARG, [[스킬:전용기2]]
	ELSE
		;基本的に行動はしない
		CFLAG:ARG:입력행동 = -1
	ENDIF
ENDIF

@SET_ACTION_帝国砲撃誘導機,ARG

IF CFLAG:ARG:１more플래그 > 0
	;ワンモア時はスク・ンダを唱えるだけ
	CALL SET_ACTION_SKILL,ARG,[[스킬:스쿤・다]]
ELSE
	IF SKILLGAGE_H_GET(ARG,PU_SKILLNUM_GET(ARG,"爆撃（ＡＮ）")) > 0
		CALL SET_ACTION_SKILL,ARG,[[스킬:전용기1]]
	ELSE
		;対象を見つけられなかった時は無防備
		CFLAG:ARG:입력행동 = -1
		CFLAG:ARG:방어플래그 = 0
	ENDIF
ENDIF

@SET_ACTION_帝国精鋭先鋒,ARG
#DIM LCOUNT,2
#DIM CHARA
#DIM 能力強化可能フラグ,6
#DIM COUNTER,7
IF CFLAG:ARG:１more플래그 > 0
	;ワンモア時はタルラにドナム付ける　＞　회복　＞　能力強化
	VARSET COUNTER
	VARSET 能力強化可能フラグ,0
	;フィールド全体のエネミーを検索
	FOR LCOUNT,7,17
		;ポジションからキャラ番号獲得
		CHARA = POS(LCOUNT)
		;存在しており、尚且つDYINGではない
		IF CHARA > -1 && GET_STATE(CFLAG:CHARA:상태이상) != "DYING"
			;50未満なら回復対象として数える
			SIF 現HP割合(CHARA) > 50
				COUNTER:0 ++
			;そのキャラの戦闘能力を確認し、最大値で尚且つ要素数が5未満ならばカジャフラグを立てる
			FOR LCOUNT:1,1,7
				IF CFLAG:CHARA:(GET_BATTLESTATUS(LCOUNT:1) + "강화") < 32 && 能力強化可能フラグ:0 < 5
					;COUNTER:1に該当するカジャのスキル番号を代入
					SELECTCASE LCOUNT:1
						CASE 1
							COUNTER:1 = [[스킬:타루・카쟈]]
						CASE 2,4
							COUNTER:1 = [[스킬:스쿠・카쟈]]
						CASE 3
							COUNTER:1 = [[스킬:라쿠・카쟈]]
						CASE 5
							COUNTER:1 = [[스킬:마카・카쟈]]
						CASE 6
							COUNTER:1 = [[스킬:사마・카쟈]]
					ENDSELECT
					;既にそのカジャがいずれかの配列に代入されてたら跳ばす
					SIF MATCH(能力強化可能フラグ,COUNTER:1)
						CONTINUE
					;登録されていないカジャの場合、能力強化可能フラグ:0の値を１増加
					能力強化可能フラグ:0 ++
					;COUNTER:1に代入されたスキル番号を指定された能力強化可能フラグに代入する
					能力強化可能フラグ:(能力強化可能フラグ:0) = COUNTER:1
				ENDIF
			NEXT
		ENDIF
	NEXT
	;回復対象が二人以上の場合は回復する
	IF COUNTER:0 >= 2
		CALL SET_ACTION_SKILL,ARG,[[스킬:메・디아라마]]
	ENDIF
	;が、能力強化可能フラグが立ってたら能力強化を優先する
	IF 能力強化可能フラグ:0 > 0
		;発狂中は天上の舞でタルラの支援を優先する
		IF 現HP割合(ARG) < 50
			CALL SET_ACTION_SKILL,ARG,[[스킬:천상의춤]]
		ELSE
			CALL SET_ACTION_SKILL,ARG,能力強化可能フラグ:(RAND:(能力強化可能フラグ:0))
		ENDIF
	ENDIF

	;それはそれとしてタルラが生存中の場合は魔のドナムを付与するのを優先する
	CHARA = FINDCHARA(CSTR:사고패턴,"TALULAH")
	IF CHARA > -1 && CFLAG:CHARA:타인집중플래그 == 0
		CALL SET_ACTION_SKILL,ARG,[[스킬:마의도눔]]
	ENDIF
ELSE
	;ポジションに応じて行動を変化
	SELECTCASE CFLAG:ARG:포지션
		CASE IS > 11
			IF 現HP割合(ARG) < 50
				SELECTCASE RAND:2
					CASE 0
						CALL SET_ACTION_SKILL,ARG,[[스킬:그랜드턱]]
					CASE 1
						CALL SET_ACTION_SKILL,ARG,[[스킬:삼단쏘기]]
				ENDSELECT
			ELSE
				SELECTCASE RAND:4
					CASE 0
						CALL SET_ACTION_SKILL,ARG,[[스킬:그랜드턱]]
					CASE 1
						CALL SET_ACTION_SKILL,ARG,[[스킬:타루・카쟈]]
					CASE 2
						CALL SET_ACTION_SKILL,ARG,[[스킬:마카・카쟈]]
					CASE 3
						CALL SET_ACTION_SKILL,ARG,[[스킬:스쿠・카쟈]]
				ENDSELECT
			ENDIF
		CASE IS < 12
			;前列の場合の行動
			SELECTCASE RAND:2
				CASE 0
					CALL SET_ACTION_SKILL,ARG,[[스킬:낭아천주참]]
				CASE 1
					CALL SET_ACTION_SKILL,ARG,[[스킬:삼단쏘기]]
			ENDSELECT
	ENDSELECT
ENDIF

@EVENT_BATTLE_ACTEND_INDIVIDUALEVENT_K812_1_AN
#DIM CHARA
#DIM 解説フラグ
#DIM タルラ強化フラグ
#DIM 先鋒強化フラグ,8
#DIM LCOUNT

IF FLAG:경과턴수 == 0 && (タルラ強化フラグ != 0 || MATCH(先鋒強化フラグ,1))
	タルラ強化フラグ = 0
	解説フラグ = 0
	VARSET 先鋒強化フラグ,0
ENDIF

CHARA = FINDCHARA(CSTR:사고패턴,"TALULAH")


IF CHARA > -1 && GET_STATE(CFLAG:CHARA:상태이상) != "DYING"
	;IF 解説フラグ == 0 && GETBIT(CFLAG:CHARA:受けフラグ,19)
	IF 解説フラグ == 0 && GET_CREC_ACT(-1, CHARA, "魔法")
		;解説フラグが立ってなくて、尚且つタルラが魔法ダメージを受けた時に解説を設ける
		PRINTFORMW 보아하니 탈룰라에게는 마법 데미지가 잘 들어가지 않는 모양이다…!
		解説フラグ = 1
	ENDIF
	IF 現HP割合(CHARA) <= 50 && タルラ強化フラグ == 0
		SETCOLOR COLOR("RED")
		PRINTL
		PRINTFORMW %CALLNAME:CHARA%은(는) 요염한 미소를 지음과 동시에, 압도적인 프레셔를 뿜어냈다!
		RESETCOLOR
		PRINTFORML %CALLNAME:CHARA%이(가) 받는 마법 데미지가 거의 경감되게 되었다!
		PRINTFORMW %CALLNAME:CHARA%이(가) 받는 물리 데미지가 크게 경감되게 되었다!
		PRINTL
		タルラ強化フラグ = 1
		CFLAG:CHARA:COOP피데미지보정 = -30
		CFLAG:CHARA:마법피데미지보정 = -90
		CFLAG:CHARA:물리피데미지보정 = -50
	ENDIF
ENDIF


FOR LCOUNT,0,8
	CHARA = FINDCHARA(CSTR:사고패턴,"帝国精鋭先鋒") + LCOUNT
	SIF CHARA < 0 || GET_STATE(CFLAG:CHARA:상태이상) == "DYING"
		CONTINUE
	IF 現HP割合(CHARA) <= 50 && 先鋒強化フラグ:LCOUNT == 0
		SETCOLOR COLOR("YELLOW")
		PRINTL
		PRINTFORMW 막다른 골목에 몰린 %CALLNAME:CHARA%은(는) 불굴의 마음으로 자신의 사기를 끌어올렸다!
		RESETCOLOR
		PRINTFORMW %CALLNAME:CHARA%이(가) 주는 물리 데미지가 크게 상승했다!
		先鋒強化フラグ:LCOUNT = 1
		CFLAG:CHARA:물리여데미지보정 = 50
	ENDIF
NEXT

@EVENT_BATTLE_TURNEND_INDIVIDUALEVENT_K812_1_AN
#DIM CHARA
#DIM 攻撃対象
#DIM LCOUNT

CHARA = FINDCHARA(CSTR:사고패턴,"帝国砲撃誘導機")
IF CHARA > -1 && GET_STATE(CFLAG:CHARA:상태이상) != "DYING"
	PRINTL
	PRINTFORML %CALLNAME:CHARA%은(는) 공격 대상을 찾고 있다……
	$LAUNCHER_TARGET_LOOP
	攻撃対象 ++
	SIF POS(攻撃対象) < 0
		GOTO LAUNCHER_TARGET_LOOP
	PRINT 아무래도 다음 공격 대상은
	SETCOLOR COLOR("YELLOW")
	PRINTFORM %CALLNAME:POS(攻撃対象)%
	RESETCOLOR
	PRINTW 인 모양이다…!
	CALL SKILLGAGE_H_SET(CHARA,PU_SKILLNUM_GET(CHARA,"爆撃（ＡＮ）"),攻撃対象) 
	SIF 攻撃対象 >= 6
		攻撃対象 = 0
ENDIF

CHARA = FINDCHARA(CSTR:사고패턴,"TALULAH")
IF CHARA > -1 && GET_STATE(CFLAG:CHARA:상태이상) != "DYING"
	IF SKILLGAGE_F_GET(CHARA,PU_SKILLNUM_GET(CHARA,"日輪")) >= 40
		SETCOLOR COLOR("RED")
		PRINTW 불길한 예감이 든다………!
		RESETCOLOR
	ENDIF
ENDIF

