@INDIVIDUAL_EVENT_K5359, ARG, ARG:1 = 0, ARG:2 = -1
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）

;リストにキャラを表示する条件
IF ARG:1 == 0
	;イベント0で全部終了
	SIF GETBIT(CFLAG:ARG:개별이벤트읽음, 0)
		RETURN 0
	RETURN 1
ENDIF

SELECTCASE ARG:2
CASE 0
	;解放条件
	IF ARG:1 == 1
		SIF MAXBASE:ARG:LV < 50
			RETURN 0
		SIF EQUIPMENT_COUNT(2408) > 0
			RETURN 0
		SIF ITEM:2408 > 0
			RETURN 0
		FOR LOCAL,0,60
			SIF ベース装備番号:LOCAL == 2408
				RETURN 0
		NEXT
		RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 화염의 사신을 봉인한 검
		ELSE
			;未開放時のタイトル（解放条件を入れておく）
			RESULTS = (LV50以上、朱雀(侍魂))
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		;周回対策、周回すると無くなってしまうため
		ITEM:2408 ++
		PRINTFORMW ＞주작(사무라이스피리츠)을(를) 손에 넣었다。
		PRINTFORMW ＞이후 이 이벤트는 발생하지 않습니다
		;好感度以外は後に上昇値が表示される
		;CFLAG:ARG:(MASTER + 2100) += (好感度)
		;TCVAR:ARG:획득의존도 += 
		;TCVAR:ARG:획득충성도 += 
		;CALL ADDS_EXP("○○経験", 1, ARG)
		RETURN 1
	ENDIF
CASE 1
	;解放条件
	IF ARG:1 == 1
		;前イベントの　シアノとクレーンゲーム　既読後
		;SIF GETBIT(CFLAG:CAST:개별이벤트읽음,0)
		;	RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 
		ELSE
			;未開放時のタイトル（解放条件を入れておく）
			;RESULTS = (%CALLNAME:ARG%とクレーンゲームを見ている)
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		
		
		
		
		;好感度以外は後に上昇値が表示される
		;CFLAG:ARG:(MASTER + 2100) += (好感度)
		;TCVAR:ARG:획득의존도 += 
		;TCVAR:ARG:획득충성도 += 
		;CALL ADDS_EXP("○○経験", 1, ARG)
		RETURN 1
	ENDIF
ENDSELECT
RETURN 0