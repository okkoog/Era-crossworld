		WSTR:(K++) = _主人_は_調教対象_に一冊の本を手渡した。
		
		WSTR:(K++) = _L_「『よい子のためのトカゲ大全集』……ええ、なんでこんなものを？」
		WSTR:(K++) = 結構面白いぞ。
		WSTR:(K++) = 「面白いとかじゃないでしょ。そもそもなんで子供向けのやつなのさ……ブツブツ」
		
		WSTR:(K++) = _L_調教対象_は文句を言いながらも図鑑に見入っている……
		
		WSTR:(K++) = _L_「へぇ、こんな綺麗な色のトカゲもいるんだ。……あ、この子可愛いー」
		WSTR:(K++) = 随分楽しそうだな。
		WSTR:(K++) = 「……っ！」
		WSTR:(K++) = 自分の正体は分かったか？
		WSTR:(K++) = 「いやいや、_一人称_は悪魔だよ？こんな本に載ってるわけないよ。見せるならせめて悪魔全書にしなよ」
		WSTR:(K++) = でも悪魔全書にも載っていない、と。
		WSTR:(K++) = 「……うん。こっそり何度か_二人称_の悪魔全書を見せてもらったけど見当たらなくて……あ」
		
		WSTR:(K++) = _L_「……そのしたり顔やめて。そうだよ、認めるよ。_一人称_は自分の正体も分からない、哀れな存在なんだ」
		WSTR:(K++) = 悪魔全書に載っていないなら、少なくとも悪魔ではないんじゃないか？
		WSTR:(K++) = 「そう……_一人称_は自分のことをバジリスク%UNICODE(0x2014)*4%悪魔だと思っていたのに、否定材料ばっかり見つかるんだ」
		
		LOCAL = GETBIT(CFLAG:ARG:이벤트가입, 1)
		IF LOCAL
			WSTR:(K++) = _L_「ああそういえば。この前カフェで見つけた_一人称_のそっくりさん」
			WSTR:(K++) =「あの時は先走っちゃって_二人称_に迷惑かけちゃったよね。ごめん」
			WSTR:(K++) =「絶対手がかりになると思って_一人称_なりに必死だったんだけど。_一人称_にもこの身体を操る力があって良かった、よね」
			WSTR:(K++) =「こんな芸当、人間にはできないでしょ。やっぱり_一人称_は悪魔なんだ、ってあの時は思ったけど」
			WSTR:(K++) =「この身体を動かしてると、だんだん自信がなくなってくる。馴染みすぎる、のかな」
		ENDIF
		
		WSTR:(K++) = _L_「……それだけじゃないんだ。_一人称_の中には、おそらく一人分じゃない記憶が渦巻いている」
		WSTR:(K++) = 「過去の出来事を思い浮かべてみても、どうにも自分のことのように思えなかったり、鏡も無しに自分の姿を鮮明に思い起こせたり」
		WSTR:(K++) = 「どれも_一人称_の記憶のはずなのに、どれも_一人称_の記憶ではないような。そんな気すらしてくるんだ」
		
		WSTR:(K++) = _L_「……ねえ、_二人称_。_二人称_は_一人称_の正体、何だと思う？」_L_
		
		KSTR:(K++) = [0] バジリスコ
		KSTR:(K++) = [1] 悪魔
		KSTR:(K++) = [2] 인간
		IF LOCAL
			KSTR:(K++) = [3] 悪魔であり人間でもある
			KSTR:(K++) = [4] 悪魔でも人間でもない
		ENDIF
		CALL 口上変数表示
		CALL INPUTINT, 0, 1, 2, LOCAL ? 3 # 0, LOCAL ? 4 # 0
		LOCAL:1 = RESULT
		CALL SET_RPG_CFLAG_TAKEOVER, ARG, "進化先選択", LOCAL:1
		CALL 口上変数初期化
		
		WSTR:(K++) = _L_……
		
		SELECTCASE LOCAL:1
			CASE 0
				WSTR:(K++) = _L_「……それって『我思う、故に我在り』みたいなことでしょ？そんなの_一人称_も分かってるよ」
				WSTR:(K++) = 「……」
				WSTR:(K++) = 「分かってるけど、_一人称_には自分が何者か……分からないって……あれ？」
			CASE 1
				WSTR:(K++) = _L_「それって、_一人称_がバジリスクだって認めるってことだよね」
				WSTR:(K++) = 「よしよし、_二人称_にお墨付きを貰えた……って違うの？　え、じゃあ_一人称_は何悪魔なのかな」
				WSTR:(K++) = 「『そこまでは知らん』って、無責任な……」
			CASE 2
				WSTR:(K++) = _L_「……え、人間ってＣＯＭＰに入れないし、石化攻撃もしないでしょ？」
				WSTR:(K++) = 今は人間の身体で動いているし、元々見た目は完全に人間だったんだから人間でいいだろう。
				WSTR:(K++) = 「……人型の悪魔なんていくらでもいるのに」
			CASE 3
				WSTR:(K++) = _L_「『悪魔と人間の合体事故』……それなら記憶の件は説明がつく、のかな。あり得るとは思うけど」
				WSTR:(K++) = 「……なんでこんな風になっちゃったかな。これから_一人称_はどうすればいいんだろ」
			CASE 4
				WSTR:(K++) = _L_「……やっぱり？　実は_一人称_もそうなんじゃないかと思っていたよ」
				WSTR:(K++) = 「悪魔でも人間でもない……ということは。_一人称_は、神だ！」
				WSTR:(K++) = 神も悪魔に含まれるらしいぞ。
				WSTR:(K++) = 「そうなんだ？　……え、じゃあ結局_一人称_は何なの……」
		ENDSELECT
		
		WSTR:(K++) = _L_「まあ_二人称_の考えは分かったよ。ありがとう、こんな面倒な話に付き合ってくれて」
		WSTR:(K++) = 「_二人称_の優しさについ甘えちゃったけど、結局は自分の納得できる答えを自分で見つけないとね」
		
		WSTR:(K++) = _L_「……とは言ってもやっぱり不安だから、_一人称_は_二人称_のそばを離れたくない。ずっと一緒にいてほしい」
		WSTR:(K++) = 「……今はただ甘えているだけかもしれない。でもね……」
		WSTR:(K++) = 「_二人称_と一緒に居ればいつかきっと答えを出せる。そんな気がするんだ」
		;ここから転生までの間を描写しない卑怯なやり方……
		
;一応の設定的なもの
;バジリスコ：	後述の少女AとバジリスクBの合体事故的な産物。身体的にはほぼバジリスクBだが精神的には少女A由来の成分が多分に含まれる。
;				自分のことをバジリスコとは名乗らないが、呼ばれる分には否定しない。
;少女A：		偶然出会ったバジリスクBに魅入られ石化して死亡。その際に放出されたＭＡＧはバジリスクBに溶け込み存在を変質させた。
;				石化した身体にはバジリスクCが憑りつき、そのまま持ち去られた。
;バジリスクB：	瀕死の状態で隠れていたところ少女Aに遭遇。少女AのＭＡＧで一命を取り留める。身体を構成するＭＡＧの大部分が少女Aのものに置き換わり
;				少女Aの意識が入り込むが、これを受け入れたことで徐々に両者の意識が融合。次第に姿も変わりバジリスコとなった。
;バジリスクC：	カフェでバジリスコ達に見つかり殺された。憑依していた身体はバジリスコの元となった少女Aのもの。
		CALL 口上変数表示
		RETURN 1
	ENDIF
CASE 5
	;解放条件
	IF ARG:1 == 1
		SIF GET_RPG_CFLAG_TAKEOVER(ARG, "進化先選択") == -1
			RETURN 0
		;進化先選択をした周回では解放不可
		SIF GETBIT(CFLAG:ARG:개별이벤트읽음, 4)
			RETURN 0
		RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 비단벌레색의 %CALLNAME:ARG%
		ELSE
			IF GETBIT(CFLAG:ARG:개별이벤트읽음, 4)
				RESULTS = (환생 리스타트 시에 %CALLNAME:ARG%을(를) 인계 캐릭터로 선택)
			ELSE
				RESULTS = (？？？)
			ENDIF
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		CALL 口上変数初期化
		;陥落素質引継ぎ有の場合は前周回の記憶が残ってる扱い
		IF GET_RPG_CFLAG_EV(ARG, "陥落素質引継ぎ")
			WSTR:(K++) = 「見て。これが_一人称_の……いや、_一人称_達の答えだよ」
			WSTR:(K++) = _調教対象_の着ぐるみの色が変わっている。虹色……玉虫色？
			
			WSTR:(K++) = _L_「見ての通り_一人称_は……カメレオン。周囲に合わせて体色を変えることができる、器用なヤツさ」
			WSTR:(K++) = 「_二人称_の期待に応えたい一心で考え抜いた結果だよ。どうかな。満足のいく答えだったら嬉しいな♪」
			WSTR:(K++) = こんなに主張の強い色合いのカメレオンは見たことがないが……突っ込むのは野暮か。
			
			WSTR:(K++) = _L_「前の_一人称_は_二人称_に頼りっきりだったけど、今後はいっぱい頼ってくれていいからね」
		ELSE
			WSTR:(K++) = 支給されたＣＯＭＰに謎の悪魔のデータが紛れ込んでいる……。
			WSTR:(K++) = _主人_は念のため装備で身を固め、警戒しながら召喚を試みた。
			
			WSTR:(K++) = _L_……
			
			WSTR:(K++) = _L_「そんなあからさまに怪訝な顔しないでくれるかな。こう見えて結構繊細なんだよ、_一人称_って」
			WSTR:(K++) = 現れたのは虹色のトカゲの着ぐるみ。何者だ。
			
			WSTR:(K++) = _L_「あーもー、すぐ銃向ける。もっと友好的にできないの？　まったく……」
			WSTR:(K++) = ホールドアップの姿勢で後ろを向かせ着ぐるみのファスナーを下ろすと、中には小柄な少女が入っていた。
			
			WSTR:(K++) = _L_「_一人称_は……虹蜥蜴 _調教対象_。多分、きっと。そんな感じだ」
			WSTR:(K++) = 曖昧な自己紹介に_二人称_が首を傾げると、ほぼ同時に_調教対象_も首を傾げた。
			WSTR:(K++) = 「_二人称_とは初めて会った気がしないな……デジャヴってやつ？」
			
			WSTR:(K++) = _L_「……まあとにかく。今後ともよろしく……ね」
		ENDIF
		
		WSTR:(K++) = _L_＜_調教対象_のロールが変化した＞
		CALL 口上変数表示
		CALL SET_BASE_5021, ARG, 0b100
		CALL SET_LEARN_SKILL_5021, ARG, 0b100
		RETURN 1
	ENDIF
ENDSELECT
