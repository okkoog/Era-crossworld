;-------------------------------------------------
;バジリスコ個別イベント
;-------------------------------------------------
@INDIVIDUAL_EVENT_K5021, ARG, ARG:1 = 0, ARG:2 = -1
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）

;リストにキャラを表示する条件
IF ARG:1 == 0
	;虹蜥蜴に進化済は非表示
	SIF GETBIT(CFLAG:ARG:이벤트가입, 2)
		RETURN 0
	;イベント5で全部終了
	SIF GETBIT(CFLAG:ARG:개별이벤트읽음, 5)
		RETURN 0
	RETURN 1
ENDIF

SELECTCASE ARG:2
CASE 0
	;解放条件
	IF ARG:1 == 1
		;進化先選択済の場合、解放されない（以降のイベントも芋づる式に未解放になり、最終イベントだけ解放可能）
		SIF GET_RPG_CFLAG_TAKEOVER(ARG, "進化先選択") != -1
			RETURN 0
		SIF 1
			RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 속사람
		ELSE
			;未開放時のタイトル（解放条件を入れておく）
			RESULTS = (？？？)
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		CALL 口上変数初期化
		WSTR:(K++) = ラグの店で交換した悪魔%UNICODE(0x2014)*4%_調教対象_。\@ANALYSIS_RATE:[[キャラ:바질리스크]] >= ANALYSIS_COMPLETED || IS_CHARA_COMPANIONED ?バジリスクと空目しそうな#聞き慣れない\@名前だが、どんな奴だろうか。
		WSTR:(K++) = ……データを確認してもよくわからない。_主人_は_調教対象_を呼び出し、その正体を問いただすことにした。
		
		WSTR:(K++) = _L_主人_の前に現れたのは黄色地に黒斑のトカゲの着ぐるみ。なんだこれは。
		WSTR:(K++) = \@ANALYSIS_RATE:[[キャラ:바질리스크]] > 0?バジリスクの振り#珍妙なトカゲの真似\@をして惚けるソレに対し_主人_が銃を持ち出すと、ソレはやれやれといった風情で肩を竦めた。
		WSTR:(K++) = なで肩過ぎてどこが肩か分からないな、と内心面白がる_主人_を尻目に_調教対象_は着ぐるみを脱ぎ始めた。
		
		WSTR:(K++) = _L_「_一人称_の完璧な変装を見破るとは。さすがだね、_二人称_」
		WSTR:(K++) = 中から出てきたのは金髪翠瞳の小柄な少女。인간……か？
		WSTR:(K++) = 確か悪魔のリストから選んだはずだが……店主のミスか？
		
		WSTR:(K++) = _L_……
		
		WSTR:(K++) = _L_「……？_一人称_の正体？見ての通り、%CSVCSTR([[キャラ:바질리스크]], GETNUM(CSTR, "종족명"))% %CSVCALLNAME([[キャラ:바질리스크]])%だよ」
		WSTR:(K++) = 「ほら、ＣＯＭＰの_一人称_のデータ見てよ。ちゃんとバジリスクってなって……ないね」
		WSTR:(K++) = 「……そのＣＯＭＰ壊れてるね、うん。とにかく_一人称_はバジリスクだから」
		
		WSTR:(K++) = _L_「なんだい、その目は。まあ_二人称_が_一人称_に興味を持ってくれてるのは分かったよ」
		WSTR:(K++) = 「じゃあ_二人称_が_一人称_を大事にしてくれたら、少しずつ_一人称_のこと教えてあげよう」
		WSTR:(K++) = 「今すぐ全部話せって？駄目だよ、これは取引だ……こらこら、銃で脅すのはやめなって」
		
		CALL 口上変数表示
		RETURN 1
	ENDIF
CASE 1
	;解放条件
	IF ARG:1 == 1
		;前イベントの　中の人　既読後でないとダメ
		SIF !GETBIT(CFLAG:ARG:개별이벤트읽음,0)
			RETURN 0
		SIF BASE:ARG:LV >= 40
			RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 또 다른 %CALLNAME:ARG% (※전투 있음)
		ELSE
			IF GETBIT(CFLAG:ARG:개별이벤트읽음,0)
				RESULTS = (%CALLNAME:ARG%의 레벨 40 이상)
			ELSE
				RESULTS = (？？？)
			ENDIF
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		CALL 口上変数初期化
		KSTR:(K++) = ファントム・ソサエティの関連企業が経営するカフェで_主人_が寛いでいると、店員の一人に目を惹かれた。
		WSTR:(K++) = 短めの金髪に鮮やかな緑色の瞳、低身長でちょこちょこ歩くあの姿には見覚えがある……。召喚した覚えはないのだが。
		WSTR:(K++) = まさかと思いながらＣＯＭＰを確認すると、_調教対象_はＣＯＭＰ内に居るようだ。ではあの店員は一体……？
		
		KSTR:(K++) = _L_主人_はテーブルの下で密かに_調教対象_を召喚し、意見を聞くことにした。
		WSTR:(K++) = ……が、_調教対象_はこともなげにテーブルから這い出て向かい側に座った。
		
		KSTR:(K++) = _L_「ふーん……_一人称_のそっくりさん、か。……すいませーん、クリームソーダください」
		WSTR:(K++) = 初手からそれは直球すぎる……こいつには探偵業は無理だな。
		
		WSTR:(K++) = _L_注文を取りに来た店員は_調教対象_と目を合わせたまま石化したように動かない。……いや、本当に石化している。
		WSTR:(K++) = 「うそでしょ……言っとくけど_一人称_は何もしてないからね？」
		WSTR:(K++) = 疑惑の目を向ける_主人_に焦った_調教対象_が釈明し始めたタイミングでどこからか甲高い声が聞こえてくる。
		
		KSTR:(K++) = _L_『君達、ボクに……いや、この身体に何の用かな？』
		WSTR:(K++) = 店員の背中側から肩口へとバジリスクが這い出てきた。石化させた人間に憑依し、操っていたようだ。
		
		WSTR:(K++) = _L_「あっ、お仲間だ！えっと……オレサマ、バジリスク。オマエ、バジリスク。オレサマ、オマエ、トモダチ、トモダチ！」
		KSTR:(K++) = 『程度の低い煽りをありがとう……とても同族とは思えないね。まあそれはいいとして』
		WSTR:(K++) = 『さっきの君達の目、この身体を狙ってるんだろう。ボクの目は誤魔化せないぞ』
		WSTR:(K++) = 『こんなに馴染む身体、誰にも渡す気はないんだよね。悪いけど死んでくれるかな！』_L_
		CALL 口上変数表示
		
		;せっかくなので戦闘を入れる
		;主人とバジリスコの二人だけにする
		FOR LOCAL,1 ,7
			SIF POS(LOCAL) < 0
				CONTINUE
			SIF NO:POS(LOCAL) != [[キャラ:당신]]
				CALL REMOVE_POSITION, LOCAL
		NEXT
		CALL INSERT_POSITION, 2, ARG
		FLAG:도주불가플래그 = 1
		FLAG:회화불능플래그 = 1
		FLAG:선제기습취소 = 1
		CALL SET_ENEMY, 9, [[キャラ:바질리스크]], BASE:ARG:LV, 1, 1
		CFLAG:(CHARANUM-1):ＨＰ보정 += 100
		CALL SYNC_STATUS, (CHARANUM-1)
		CALL HEALTH_CHARA, (CHARANUM-1)

		CALL BATTLE_START
		
		FLAG:도주불가플래그 = 0
		FLAG:회화불능플래그 = 0
		FLAG:선제기습취소 = 0
		;イベント前のPTに復元する
		CALL CHANGE_LAST_BATTLE_MEMBERSET
		
		CALL 口上変数初期化
		WSTR:(K++) = _L_……
		
		WSTR:(K++) = _L_突然の戦闘に_主人_は身構えたが、大した相手ではなかった。ごく普通のバジリスクのようだ。
		KSTR:(K++) = 「あーあ、殺しちゃった。せっかくお仲間に会えたのにー」
		WSTR:(K++) = 死ねと言われた相手をまだ仲間と呼ぶのか。悪魔の仲間意識はよくわからない。
		
		KSTR:(K++) = _L_「……それで？_二人称_。これ、どうするつもりなの？」
		WSTR:(K++) = ……_調教対象_にそっくりな店員の石像。しまった……組織が絡んでいるとはいえ、一般人も居るカフェだ。
		WSTR:(K++) = ある程度耳目も集まっている。この場を収めるには……とりあえず石化を解くか？
		WSTR:(K++) = 「石化してから大分経ってるみたいだし、この身体はもう空っぽなんじゃないかな」
		WSTR:(K++) = ならば、先のバジリスクを蘇生……してもまた襲い掛かってくるだけか。どうすれば……
		
		KSTR:(K++) = _L_「……こうすればいいんじゃない？」
		WSTR:(K++) = 言うが早いか石像に抱き着いた_調教対象_が、触れた部分から染み入るように石像と一体化していく……
		WSTR:(K++) = 店員はみるみるうちに生気を取り戻し、元通りになった。……少なくとも見た目は。
		
		WSTR:(K++) = _L_「じゃーん！これで万事解決。_一人称_が居て良かったねー」
		WSTR:(K++) = これならなんとか誤魔化せそうだが……そもそも_調教対象_が居なければもっとうまくやれたのではないか。
		WSTR:(K++) = 「まあまあ、もっと前向きに考えようよ。この身体なら、人間として_二人称_の役に立てるんじゃない？」
		WSTR:(K++) = 人間として……か。悪魔と比べてどちらが役に立つかは微妙なところだが。
		
		;よくわからない単語をいきなり出すのはやめておく
		;WSTR:(K++) = _L_＜_調教対象_はペトラマンサーとして覚醒し、人間の身体を得た＞
		WSTR:(K++) = _L_＜_調教対象_のロールが変化した＞
		CALL 口上変数表示
		CALL SET_BASE_5021, ARG, 0b10
		CALL SET_LEARN_SKILL_5021, ARG, 0b10
		RETURN 1
	ENDIF
CASE 2
	;解放条件
	IF ARG:1 == 1
		;前イベントの　中の人　既読後でないとダメ
		SIF !GETBIT(CFLAG:ARG:개별이벤트읽음,0)
			RETURN 0
		SIF GET_CHARA_LOYALTY(ARG) >= 2500
			RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 옛날이야기
		ELSE
			IF GETBIT(CFLAG:ARG:개별이벤트읽음,0)
				RESULTS = (%CALLNAME:ARG%의 충성도 2500 이상)
			ELSE
				RESULTS = (？？？)
			ENDIF
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		CALL 口上変数初期化
		WSTR:(K++) = _主人_は再び_調教対象_を呼び出した。
		
		WSTR:(K++) = _L_「まあ約束だからね。昔語りでもしてみようかな」
		
		WSTR:(K++) = _L_調教対象_はどこか遠い目をしながら話し始めた。
		
		WSTR:(K++) = _L_「昔々あるところに一匹の心優しいバジリスクがいました」
		WSTR:(K++) = 「彼は望む望まないに関わらず周囲を石に変えてしまうある種の呪いのような力を持っていました」
		WSTR:(K++) = 「彼は存在するだけで周囲にとっての脅威であったため迫害され、常に命の危険と隣り合わせの生活を送っていました」
		WSTR:(K++) = 「ある日そんな彼に転機が訪れます。それは彼の呪いを解くアイテム、着ぐるみとの出会い」
		
		WSTR:(K++) = _L_「……おっともうこんな時間か。続きはまた今度ね」
		WSTR:(K++) = まだ5分も経っていない。_主人_は銃を手に取りカチャカチャと音を立てながら続きを促した。
		WSTR:(K++) = 「もー、銃をチラつかせるの禁止ー。……仕方ないな、もうちょっとだけだからね」
		
		WSTR:(K++) = _L_「そう、あれは嵐の夜だった。風が吹き荒び激しい雨が地面を叩き飛沫を上げる中、_一人称_は先を急いでいた」
		WSTR:(K++) = 「視界が悪く、道もぬかるんでいたからかな。_一人称_は足を踏み外して道端の茂みに転がり込んでしまった」
		WSTR:(K++) = 「背の高い草に手足を取られ苦戦しながらも、やっとの思いで顔を上げたその時！稲光に照らし出されたのが%UNICODE(0x2014)*4%」
		WSTR:(K++) = 「この着ぐるみだよ。_一人称_はその鮮やかな黄色と黒に魅入られ、吸い寄せられるように着込んでしまった」
		WSTR:(K++) = 「……そう、着込んでしまったんだ。大雨でずぶ濡れになり、とても冷たく、重たい着ぐるみをね。それから……」
		
		WSTR:(K++) = _L_何故さっきと視点が変わったんだ。分かりにくいから統一してくれ。
		WSTR:(K++) = 「あれ……そうかな？　そうかも……」
		
		WSTR:(K++) = _L_その後_調教対象_は何やら考え込んだまま、声を掛けても曖昧な返事しか返さなくなった。続きはまた今度にしよう。
		
		CALL 口上変数表示
		RETURN 1
	ENDIF
CASE 3
	;解放条件
	IF ARG:1 == 1
		;前イベントの　昔語り　既読後でないとダメ
		SIF !GETBIT(CFLAG:ARG:개별이벤트읽음,2)
			RETURN 0
		SIF GET_CHARA_LOYALTY(ARG) >= 5000
			RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 옛날이야기２
		ELSE
			IF GETBIT(CFLAG:ARG:개별이벤트읽음,2)
				RESULTS = (%CALLNAME:ARG%의 충성도 5000 이상)
			ELSE
				RESULTS = (？？？)
			ENDIF
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		CALL 口上変数初期化
		WSTR:(K++) = _主人_は再び_調教対象_を呼び出した。
		
		WSTR:(K++) = _L_「えっと……どこからだっけ？　うーん……」
		
		WSTR:(K++) = _L_……
		
		WSTR:(K++) = _L_「そう、あれは嵐の夜だった。風が吹き荒び激しい雨が地面を叩き飛沫を上げる中、_一人称_は草むらで息を潜めていた」
		WSTR:(K++) = 「悪天候の中、草むらに隠れていれば見つかりっこないと思っていたし、日頃の疲れもあって少し眠ることにしたんだ」
		WSTR:(K++) = 「そして_一人称_は夢を見た。目も眩むような光に満ちた世界。その中にあってなお色褪せない翠い瞳の少女が_一人称_に手を差し伸べる」
		WSTR:(K++) = 「暖かい、嬉しい、心地いい……こんな気持ちになったのは生まれて初めてだった。ずっとこの夢に浸っていたかった」
		
		WSTR:(K++) = _L_「そう、_一人称_は……_一人称_は。……あ……れ？_一人称_、どうして……っ」
		WSTR:(K++) = よく分からないが_調教対象_は酷く動揺しているようだ。
		WSTR:(K++) = _主人_はとりあえずコーヒーを淹れて_調教対象_を落ち着かせることにした。
		
		WSTR:(K++) = _L_「……ん、ありがとう……もう大丈夫」
		WSTR:(K++) = どうやら過去に何かあったようだが、聞き出そうとする度に不安定になられては困る。
		WSTR:(K++) = _主人_は_調教対象_に昔語りはしないようにと告げた。
		
		WSTR:(K++) = _L_「あれ……そうなの？_一人称_に興味なくなっちゃった……？」
		WSTR:(K++) = _調教対象_は寂しげな目で見つめてくる。こちらの気遣いを分かっていないわけではないだろうが……。
		WSTR:(K++) = 今までの_調教対象_の話の中に何か原因や対処方法のヒントは無かっただろうか。少し思い返してみよう……。
		
		WSTR:(K++) = _L_……ちょっと待てよ。何故自分がカウンセラーのような真似を、しかも悪魔相手にしなくてはならないんだ。
		;ＣＯＭＰに入れなくなってる場合がある
		IF !GETBIT(CFLAG:ARG:이벤트가입, 1)
			WSTR:(K++) = _主人_は深く息を吐いた後『また今度な』と言い捨てて_調教対象_をＣＯＭＰに帰還させた。
			WSTR:(K++) = ……ＣＯＭＰに還る際の_調教対象_の不安げな表情が頭から離れない。これは厄介な呪いをかけられたか。
		ELSE
			WSTR:(K++) = _主人_は深く息を吐いた後『また今度な』と言い捨てて部屋を出た。
			WSTR:(K++) = ……_調教対象_の不安げな表情が頭から離れない。これは厄介な呪いをかけられたか。
		ENDIF
		
		CALL 口上変数表示
		RETURN 1
	ENDIF
CASE 4
	;解放条件
	IF ARG:1 == 1
		;前イベントの　昔語り２　既読後でないとダメ
		SIF !GETBIT(CFLAG:ARG:개별이벤트읽음,3)
			RETURN 0
		SIF GET_CHARA_LOYALTY(ARG) >= 10000
			RETURN 1
		SIF 陥落(ARG, MASTER) && RESULTS == "연모"
			RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 카운슬링
		ELSE
			IF GETBIT(CFLAG:ARG:개별이벤트읽음,3)
				RESULTS = (%CALLNAME:ARG%의 충성도 10000 이상 또는 주인에게 연모계 함락)
			ELSE
				RESULTS = (？？？)
			ENDIF
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		CALL 口上変数初期化
		WSTR:(K++) = _主人_は再び_調教対象_を呼び出した。
		WSTR:(K++) = _調教対象_の着ぐるみは心なしか痩せたように見える。
		
		WSTR:(K++) = _L_「今日は何？　_一人称_の昔語りは聞かないんでしょ？」
