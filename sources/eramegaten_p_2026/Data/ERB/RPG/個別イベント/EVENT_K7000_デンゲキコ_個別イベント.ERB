	;解放条件
	IF ARG:1 == 1
		;EXTRA組を出さない or 白き鋼鉄のXイベントにフィルタ掛けてるなら出ない
		SIF !GETS_USEABLE_EXTRA_TITLE("白き鋼鉄のX")
			RETURN 0
		;デンゲキコのイベントを見てないと出ない
		SIF GETBIT(イベントフラグ:19:19, 11) == 0
			RETURN 0
		;デンゲキコ陥落してなきゃ出ない
		SIF 陥落(ARG) < 1
			RETURN 0
		;アキュラくんがいない or 電気仕掛けの狂神をクリアしてなければ出ない
		SIF !GETBIT(FLAG:발견ED2, 6)
			RETURN 0
		SIF !IS_JOINABLE_BATTLE_BY_CSV([[キャラ:아큐라_X]])
			RETURN 0
		SIF !IS_JOINABLE_BATTLE_BY_CSV([[キャラ:블레이드_X]])
			RETURN 0
		SIF !IS_JOINABLE_BATTLE_BY_CSV([[キャラ:GV]])
			RETURN 0
