;デンゲキコ単独で戦うので当たり前だがベルセルクから弱体化する
@SET_ACTION_ライトニングウォーリアー, ARG
#LOCALSIZE 1
#LOCALSSIZE 2
#DIM LCOUNT
#DIM 生存カウント
#DIM 剣防カウント
IF CFLAG:ARG:１more플래그 > 0
	;ワンモア取る度に気合入るウーマン
	;プッツン後はヒートライザる。
	IF CFLAG:ARG:気合フラグ != 1 && CSTR:ARG:180 == ""
		CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
	ELSE
		CALL SET_ACTION_SKILL,ARG,[[스킬:히트라이저]]
	ENDIF
ELSE
	;ＧＯ時にライブノベル起動
	CALL LIVENOVEL_TR
	IF CSTR:ARG:180 != ""
		CFLAG:ARG:気合フラグ = 1
		CFLAG:ARG:크리티컬강화 = 7
	ENDIF
	生存カウント = 0
	剣防カウント = 0
	FOR LCOUNT,1,7
		SIF POS(LCOUNT) < 0 || GET_STATE(CFLAG:POS(LCOUNT):상태이상) == "DYING"
			CONTINUE
		生存カウント += 1
		SIF CFLAG:POS(LCOUNT):검격가드킬 > 0
			CONTINUE
		SIF MAXBASE:POS(LCOUNT):검격 <= 0 || MAXBASE:POS(LCOUNT):검격 == 999
			剣防カウント += 1
	NEXT
	IF 生存カウント == 剣防カウント
		;プレイヤー側全員が剣撃無効以上なら
		CALL SET_ACTION_SKILL, ARG, [[스킬:검격가드킬]]
	ELSE
		IF (FLAG:경과턴수 + 1) % 2 == 1
			IF RAND:2
				CALL SET_ACTION_SKILL, ARG, [[스킬:퀵스피어]]
			ELSE
				CALL SET_ACTION_SKILL, ARG, [[스킬:스파크볼트]]
			ENDIF
		ELSE
			SELECTCASE RAND:3
				CASE 0
					CALL SET_ACTION_SKILL, ARG, [[스킬:번개찌르기]]
				CASE 1
					CALL SET_ACTION_SKILL, ARG, [[스킬:구십구나선격]]
				CASE 2
					CALL SET_ACTION_SKILL, ARG, [[스킬:헬라이트닝]]
			ENDSELECT
		ENDIF
	ENDIF
ENDIF

;なんか青い人がコーチしてくれるらしいってよ
@SET_ACTION_コーチングブルー, ARG
#LOCALSIZE 1
#LOCALSSIZE 2
#DIM 生存カウント
#DIM 絶縁カウント
;전용기1 ライトニングスフィア
;전용기2 スパークカリバー
;전용기3 ヴォルティックチェーン
IF CFLAG:ARG:１more플래그 > 0
	SIF CSTR:ARG:180 != ""
		CFLAG:ARG:집중플래그 = 1
	IF RAND:2 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:전용기3]]
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:전용기2]]
	ENDIF
ELSE
	;ＧＯ時にライブノベル起動
	CALL LIVENOVEL_TR
	SIF CSTR:ARG:180 != ""
		CFLAG:ARG:집중플래그 = 1
	生存カウント = 0
	絶縁カウント = 0
	FOR LOCAL,1, 7
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS == -1
			CONTINUE
		SIF CFLAG:(FLAG:LOCALS):상태이상 == GET_STATE_NUM("DYING")
			CONTINUE
		生存カウント += 1
		SIF CFLAG:(FLAG:LOCALS):전격가드킬 > 0
			CONTINUE
		;電撃無効・反射・吸収の数を確認
		SIF MAXBASE:(FLAG:LOCALS):전격 <= 0 || MAXBASE:(FLAG:LOCALS):전격 == 999
			絶縁カウント += 1
	NEXT
	IF 生存カウント == 絶縁カウント
		;プレイヤー側全員が電撃無効以上なら
		CALL SET_ACTION_SKILL, ARG, [[스킬:전격가드브레이크]]
	ELSE
		LOCAL = RAND:10
		SELECTCASE LOCAL
		CASE 0
			;10%の確率でヴォルティックチェーン
			CALL SET_ACTION_SKILL, ARG, [[스킬:전용기3]]
		CASE 1 TO 3
			;30%の確率でライトニングスフィア
			CALL SET_ACTION_SKILL, ARG, [[스킬:전용기1]]
		CASE 4 TO 6
			;30%の確率でジオダイン
			CALL SET_ACTION_SKILL, ARG, [[스킬:지오다인]]
		CASEELSE
			;30%の確率でスパークカリバー
			CALL SET_ACTION_SKILL, ARG, [[스킬:전용기2]]
		ENDSELECT
	ENDIF
ENDIF

