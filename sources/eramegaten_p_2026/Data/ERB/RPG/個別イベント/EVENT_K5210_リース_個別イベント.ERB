			IF BASE:ARG:LV < 55 || GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == ""
				CALL INPUTINT, 0 , 3
			;７０以下あるいはクラス３未覚醒だと２，３まで
			ELSEIF BASE:ARG:LV < 70 || GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == ""
				CALL INPUTINT, 0 , 1 , 3
			ELSE
				CALL INPUTINT, 0 , 1 , 2 , 3
			ENDIF
			;メッセージのために覚醒かどうかを取得しておく
			IF RESULT < 3
				CHOICE_CLASS_RANK = RESULT + 2
				IF GET_RPG_CSTR_TAKEOVER(ARG, @"クラス{CHOICE_CLASS_RANK}属性") == ""
					IS_AWAKEN = 1
				ELSE
					IS_AWAKEN = 0
				ENDIF
			ENDIF
			IF RESULT == 0
				IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == ""
					PRINTFORMW 『클래스 2』를 각성시킵니다.
					PRINTFORML 
					PRINTFORML 빛, 어둠의 2종 중에서 클래스를 선택할 수 있으며, 선택은 개별 이벤트에서 언제든 변경 가능합니다.
					PRINTFORML 
					PRINTFORML [0] 빛・발키리
					PRINTFORML [1] 어둠・룬 메이든
					CALL INPUTINT, 0 , 1
					IF RESULT == 0
						PRINTFORML 
						PRINTFORML %CALLNAME:ARG%은(는) 발키리로 각성했습니다.
						CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス2属性", "光" 
					ELSEIF RESULT == 1
						PRINTFORML 
						PRINTFORML %CALLNAME:ARG%은(는) 룬 메이든으로 각성했습니다.
						CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス2属性", "闇" 
					ENDIF
					;クラス２スキルの定義付与。
					;CSTR:ARG:전용기1 = クラス２スキル（聖剣３）
				ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光"
					CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス2属性", "闇" 
				ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "闇"
					CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス2属性", "光" 
				ENDIF
				;何れの分岐もこちらに戻る。同時にクラス２スキル削除時は再習得する為に分岐統合後のここへ置く。
				CALL LEARN_PU_SKILL(ARG,"クラス２スキル（聖剣３）")
			ELSEIF RESULT == 1
				;光・３未覚醒
				IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光" && GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == ""
					PRINTFORMW 『클래스 3』을 각성시킵니다.
					PRINTFORML 
					PRINTFORML 빛을 기준으로 한 추가 2분기를 선택할 수 있으며, 선택은 개별 이벤트에서 언제든 변경 가능합니다.
					PRINTFORML 
					PRINTFORML [0] 빛빛・바나디스
					PRINTFORML [1] 빛어둠・스타 랜서
					CALL INPUTINT, 0 , 1
					IF RESULT == 0
						PRINTFORML 
						PRINTFORML %CALLNAME:ARG%은(는) 바나디스로 각성했습니다.
						CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス3属性", "光" 
					ELSEIF RESULT == 1
						PRINTFORML 
						PRINTFORML %CALLNAME:ARG%은(는) 스타 랜서로 각성했습니다.
						CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス3属性", "闇" 
					ENDIF
					;クラス３スキルの定義。
					;CSTR:ARG:전용기2 = クラス３スキル（聖剣３）
				;闇・３未覚醒
				ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "闇" && GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == ""
					PRINTFORMW 『클래스 3』을 각성시킵니다.
					PRINTFORML 
					PRINTFORML 어둠을 기준으로 한 추가 2분기를 선택할 수 있으며, 선택은 개별 이벤트에서 언제든 변경 가능합니다.
					PRINTFORML 
					PRINTFORML [0] 어둠빛・드래곤 마스터
					PRINTFORML [1] 어둠어둠・펜릴 나이트
					CALL INPUTINT, 0 , 1
					IF RESULT == 0
						PRINTFORML 
						PRINTFORML %CALLNAME:ARG%은(는) 드래곤 마스터로 각성했습니다.
						CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス3属性", "光" 
					ELSEIF RESULT == 1
						PRINTFORML 
						PRINTFORML %CALLNAME:ARG%은(는) 펜릴 나이트로 각성했습니다.
						CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス3属性", "闇" 
					ENDIF
				;光光⇒光闇
				ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光" && GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "光"
					CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス3属性", "闇" 
				;光闇⇒光光
				ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "光" && GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "闇"
					CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス3属性", "光" 
				;闇光⇒闇闇
				ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "闇" && GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "光"
					CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス3属性", "闇" 
				;闇闇⇒闇光
				ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス2属性") == "闇" && GET_RPG_CSTR_TAKEOVER(ARG, "クラス3属性") == "闇"
					CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス3属性", "光" 
				ENDIF
				CALL LEARN_PU_SKILL(ARG,"クラス３スキル（聖剣３）")
			ELSEIF RESULT == 2
				;クラス４分岐未定義時
				IF GET_RPG_CSTR_TAKEOVER(ARG, "クラス4属性") == ""
					PRINTFORMW 『클래스 4』를 각성시킵니다.
					PRINTFORML 
					PRINTFORML 클래스 2, 3과는 독립된 2분기를 선택할 수 있으며, 선택은 개별 이벤트에서 언제든 변경 가능합니다.
					PRINTFORML 
					PRINTFORML [0] 빛4・미티어
					PRINTFORML [1] 어둠4・흐레스벨그
					CALL INPUTINT, 0 , 1
					IF RESULT == 0
						PRINTFORML 
						PRINTFORML %CALLNAME:ARG%은(는) 미티어로 각성했습니다.
						CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス4属性", "光" 
					ELSEIF RESULT == 1
						PRINTFORML 
						PRINTFORML %CALLNAME:ARG%은(는) 흐레스벨그로 각성했습니다.
						CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス4属性", "闇" 
					ENDIF
					CSTR:ARG:전용기3 = クラス４スキル（聖剣３）
				ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス4属性") == "光"
					CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス4属性", "闇" 
				ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス4属性") == "闇"
					CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス4属性", "光" 
				ENDIF
				CALL LEARN_PU_SKILL(ARG,"クラス４スキル（聖剣３）")
			ELSEIF RESULT == 3
				PRINTFORMW 처리를 마쳤다.
				RETURN 0
			ENDIF
			IF IS_AWAKEN == 0
				CLEARLINE LINECOUNT - L_LINE:1
				IF GET_RPG_CSTR_TAKEOVER(ARG, @"クラス{CHOICE_CLASS_RANK}属性") == "光"
					SELECTCASE CHOICE_CLASS_RANK
						CASE 2
							PRINTFORML 발키리의 힘이 깃들었습니다.
						CASE 3
							IF GET_RPG_CSTR_TAKEOVER(ARG, @"クラス2属性") == "光"
								PRINTFORML 바나디스의 힘이 깃들었습니다.
							ELSE
								PRINTFORML 스타 랜서의 힘이 깃들었습니다.
							ENDIF
						CASE 4
							PRINTFORML 미티어의 힘이 깃들었습니다.
					ENDSELECT
				ELSE
					SELECTCASE CHOICE_CLASS_RANK
						CASE 2
							PRINTFORML 룬 메이든의 힘이 깃들었습니다.
						CASE 3
							IF GET_RPG_CSTR_TAKEOVER(ARG, @"クラス2属性") == "光"
								PRINTFORML 드래곤 마스터의 힘이 깃들었습니다.
							ELSE
								PRINTFORML 펜릴 나이트의 힘이 깃들었습니다.
							ENDIF
						CASE 4
							PRINTFORML 흐레스벨그의 힘이 깃들었습니다.
					ENDSELECT
				ENDIF
				PRINTL 
				PRINTL 
				PRINTL 
				WAIT
			ENDIF
			GOTO INPUT_LOOP_EVENT_K5210CC
		;好感度以外は後に上昇値が表示される
		;CFLAG:ARG:(MASTER + 2100) += (好感度)
		;TCVAR:ARG:획득의존도 += 
		;TCVAR:ARG:획득충성도 += 
		;CALL ADDS_EXP("○○経験", 1, ARG)
	ENDIF
ENDSELECT
RETURN 0