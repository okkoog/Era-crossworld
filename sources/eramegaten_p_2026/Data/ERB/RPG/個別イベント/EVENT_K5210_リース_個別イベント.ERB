@INDIVIDUAL_EVENT_K5210, ARG, ARG:1 = 0, ARG:2 = -1
#DIM CLASS_RANK
#DIM CHOICE_CLASS_RANK
#DIM L_LINE, 2
#DIM IS_AWAKEN
