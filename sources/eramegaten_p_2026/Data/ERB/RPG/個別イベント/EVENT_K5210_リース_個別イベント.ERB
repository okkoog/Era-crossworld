	PRINTFORML 
	PRINTFORML ＞업데이트로 변경되는 내용
	PRINTFORML 　조교 후천소질・함락・계약・함락 이력 이외의 전 소질(전투 소질을 포함)
	PRINTFORML 　CSTR：悪魔解説
	PRINTFORML 　습득 스킬(인간 이능자용 전투 소질에 맞춘 습득 라인업)
	PRINTFORML 　종족(인간으로 리셋)
	PRINTFORML 　전투 참가 불능 상태인 경우, 조교할 때까지 전투 참가 가능화
	PRINTFORML 
	PRINTFORML ＞덮어쓰지 않는 내용
	PRINTFORML 　ABL・EXP(조교 스테이터스・경험・체력 등)

		SIF GET_VALUE_TALENT_JOINABLE((ARG)) == 0
			CALL SET_TALENT_PARTY_JOINABLE, (ARG), "신용"
		
		;종족(ABL80)の人間化リセット
		ABL:ARG:종족 = CSVABL(NO:ARG,GETNUM(ABL,"종족"),0)

		;素質をCSVから読み込んだステータスで上書き。
		;ただし、陥落素質3-8と契約素質170-173、信頼系素質180-182、陥落履歴270-273は対象外！
		FOR LOCAL,0,343
			SIF LOCAL >= 3 && LOCAL <= 8
				CONTINUE
			SIF LOCAL >= 74 && LOCAL <= 77
				CONTINUE
			SIF LOCAL >= 170 && LOCAL <= 173
				CONTINUE
			SIF LOCAL >= 180 && LOCAL <= 182
				CONTINUE
			SIF LOCAL >= 270 && LOCAL <= 273
				CONTINUE
			TALENT:ARG:(LOCAL) = CSVTALENT(NO:ARG,LOCAL,0)
		NEXT

		;悪魔解説のCSVからの読み込みで上書き。
		FOR LOCAL, 1, 21
			CSTR:ARG:@"해설{LOCAL}" '= CSVCSTR(NO:ARG, GETNUM(CSTR, @"해설{LOCAL}"))
		NEXT
		
		;習得予定スキルをCSVから読み直し。
		FOR LOCAL,1,21
			ABL:ARG:("습득스킬" + TOSTR(LOCAL)) = CSVABL(NO:ARG,(GETNUM(ABL,"습득스킬" + TOSTR(LOCAL))),0)
			ABL:ARG:("습득LV" + TOSTR(LOCAL)) = CSVABL(NO:ARG,(GETNUM(ABL,"습득LV" + TOSTR(LOCAL))),0)
			;ABL:LOCAL:("초기변신악마습득스킬" + TOSTR(LOCAL:1)) = CSVABL(NO:LOCAL,(GETNUM(ABL,"초기변신악마습득스킬" + TOSTR(LOCAL:1))),0)
			;ABL:LOCAL:("초기변신악마습득LV" + TOSTR(LOCAL:1)) = CSVABL(NO:LOCAL,(GETNUM(ABL,"초기변신악마습득LV" + TOSTR(LOCAL:1))),0)
		NEXT
	PRINTFORML 
	PRINTFORMW 처리를 완료했습니다. 자세한 내용은 능력 확인에서 확인해 주십시오.
