@SET_ACTION_あんこくう卿, ARG
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM SKILL_NUM,4
#DIM 食いしばった変数

SKILL_NUM:0 = PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")
SKILL_NUM:1 = PU_SKILLNUM_GET(ARG,"黒龍双剋勝利剣")
SKILL_NUM:2 = PU_SKILLNUM_GET(ARG,"∞黒餡子")
SKILL_NUM:3 = PU_SKILLNUM_GET(ARG,"王の見えざる手")

SIF CFLAG:ARG:이악물기플래그 == 0
	食いしばった変数 = 0

;食いしばってから本気を出す
IF CFLAG:ARG:이악물기플래그 == 1 && 食いしばった変数 == 0 || SKILLGAGE_F_GET(ARG,SKILL_NUM:0) > 99 && SKILLGAGE_D_GET(ARG,SKILL_NUM:0) < 1
	SIF 食いしばった変数 == 0
		食いしばった変数 = 1
	LOCAL = CFLAG:ARG:입력행동
	CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")
	CALL PRINT_ACT_MESSAGE, ARG, SKILL_NUM:0
	CALL BATTLE_EVENT_ACT, ARG
	RESETCOLOR
	CALL SKILL_ACTION, SKILL_NUM,ARG
	CFLAG:ARG:입력행동 = LOCAL
ELSEIF CFLAG:ARG:１more플래그 > 0
	;ワンモア取る度に気合入る
	CALL SET_ACTION_SKILL, ARG, [[스킬:기합]]
ELSEIF CFLAG:ARG:행동한횟수 == 0
	;魔力解放ゲージが2以下になったタイミングで宝具を撃つ
	IF SKILLGAGE_D_GET(ARG,SKILL_NUM:0) > 0 && SKILLGAGE_D_GET(ARG,SKILL_NUM:0) < 3
		CALL SET_ACTION_SKILL, ARG, SKILL_NUM:1
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL SET_ACTION_SKILL,ARG,[[스킬:낭아천주참]]
			CASE 1
				CALL SET_ACTION_SKILL,ARG,[[스킬:썬더볼트]]
			CASE 2
				CALL SET_ACTION_SKILL,ARG,[[스킬:그라비티마인]]
		ENDSELECT
	ENDIF
ELSE
	SELECTCASE RAND:3
		CASE 0
			CALL SET_ACTION_SKILL,ARG,[[스킬:낭아천주참]]
		CASE 1
			CALL SET_ACTION_SKILL,ARG,[[스킬:썬더볼트]]
		CASE 2
			CALL SET_ACTION_SKILL,ARG,[[스킬:그라비티마인]]
	ENDSELECT
ENDIF
