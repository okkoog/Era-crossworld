	BASE:ARG:지혜 += 5
	PRINTFORML %CALLNAME:ARG%은(는) 지혜가 5 올랐다
	BASE:ARG:마력 += 5
	PRINTFORML %CALLNAME:ARG%은(는) 마력이 5 올랐다
	BASE:ARG:내구 += 5
	PRINTFORML %CALLNAME:ARG%은(는) 인내가 5 올랐다
	BASE:ARG:속도 += 5
	PRINTFORML %CALLNAME:ARG%은(는) 속도가 5 올랐다
	BASE:ARG:운 += 5
	PRINTFORMW %CALLNAME:ARG%은(는) 운이 5 올랐다
ENDIF