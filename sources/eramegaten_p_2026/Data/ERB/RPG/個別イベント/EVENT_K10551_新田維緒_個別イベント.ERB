;-------------------------------------------------
;イオ個別イベント。
;ルーグが情けない性能だったのでアキュラ個別イベントベースに作成。
;ちょっと一部に残骸残っているかも。一ヶ月ぐらい作業ファイルぶっ飛んだりしたので突貫工事だし。
;ARGでイオの番号を拾えるらしいのでソレを採用ね。
;
;強化ルーグは主に耐性の強化がメインでスキルなどはタスラムショットがタスラムの魔弾に変化する以外は普通。
;(2023/06/30追記：タスラムの魔弾は開発中に専用スキルになってたのをコメント更新忘れてた)
;色々な作品の耐性部分を取り込みつつ、ペルソナのイルダーナ(ルーグの別名)が衝撃と重力弱点なので1.75倍弱点、
;デビチルで明確に呪殺弱点なので2倍弱点に設定、溺れて死ぬ逸話を英語版Wikipediaで確認できたので水撃弱点。
;破魔反射や神経精神が耐性止まりの作品が多いのだが、ゲームバランスと異能シフターの変身先である都合を考慮してこのような形に。
;3反射、2耐性、電撃と致命4種の内3つ無効の4無効、呪殺含む4弱点 
;-------------------------------------------------
@INDIVIDUAL_EVENT_K[[キャラ:이오]], ARG, ARG:1 = 0, ARG:2 = -1
#LOCALSIZE 3
#LOCALSSIZE 1
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）

;リストにキャラを表示する条件
IF ARG:1 == 0
	;イベント0で全部終了
	SIF GETBIT(CFLAG:ARG:개별이벤트읽음, 0)
		RETURN 0
	RETURN 1
ENDIF

SELECTCASE ARG:2
CASE 0
	;解放条件
	IF ARG:1 == 1
		SIF FLAG:데빌서바２진행도 < 460
			RETURN 0
		;イオがいてシフターを持ってるか確認
		;2023/06/30追記：ロール整理でイオはアウトサイダーに変更されたんで条件変更
		SIF ARG < 0 || TALENT:ARG:아웃사이더 == 0
			RETURN 0
		RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방, ARG:2)
			;타이틀
			;元ネタ：ルーグの異名『長い腕』の意。 デビサバ2でも出てきてる。
			RESULTS = 라우파다
		ELSE
			;未開放時のタイトル（解放条件を入れておく）
			RESULTS = (①아웃사이더가 된 %CALLNAME:ARG%이(가) 있다　②의뢰 『지프스로부터의 의뢰 (5TH DAY - 결전 2대 거두)』 클리어로 해방　※선택지에 따라 전투 있음)
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		PRINTFORMW 최근, %CALLNAME:ARG%의 상태가 이상하다…….
		PRINTFORMW %CALLNAME:ARG%와(과) 융합한 루그가, 본래의 힘을 되찾아가는 모양이다.
		PRINTFORML 　
		PRINTFORMW 하지만 원래대로라면, 토지와 개념을 일체화시키고 있던 악마다.
		PRINTFORML 적합하고 있다고는 하나, %CALLNAME:ARG%의 몸에는 그 힘이 너무 강한 듯하다…….
		PRINTFORML 이대로 방치하면 돌이킬 수 없는 사태에 빠질지도 모른다.
		PRINTFORMW 무언가 손을 써야 할 텐데…….
		PRINTFORML 　
		PRINTFORML [0] 루그와 대결하여 그 힘을 약화시킨다
		PRINTFORML [1] 돈으로 해결한다
		PRINTFORML [2] MAG를 쏟아붓는다
		
		SETCOLOR 0xff0033
		PRINTFORML [3] 내버려 둔다
		RESETCOLOR

		SETCOLOR 0x33ffcc
		PRINTFORML [4] 지켜본다
		RESETCOLOR

		PRINTFORML [99] 잠시 생각한다
		
		CALL INPUTINT, 0, 1, 2, 3, 4,99
		IF RESULT == 0
			PRINTFORML 루그는 아마도 %CALLNAME:ARG%의 힘을 흡수하여 그 힘을 키우고 있을 것이다……
			PRINTFORML 그러나 루그의 힘을 %CALLNAME:ARG%이(가) 흡수한다면 전력이 된다.
			PRINTFORMW 물론 패배한다면 %CALLNAME:ARG%은커녕 당신도 루그의 양분이 되어버리겠지만.
			PRINTFORMW 이 방법으로 괜찮을까?
			PRINTFORML 　
			PRINTFORML [0] 루그와 싸운다
			PRINTFORML [99] 다시 생각한다
			PRINTFORML 　
			CALL INPUTINT, 0,99
			IF RESULT == 0
				FOR LOCAL, 1, 7
					;LOCALSにポジションにいる人を入れる
					LOCALS = 포지션{LOCAL}
					;中に誰もいないならループ離脱
					SIF FLAG:LOCALS < 0
					CONTINUE
					;PTにイオはいるか？
					IF NO:(FLAG:LOCALS) == [[キャラ:이오]]
					PRINTFORML 루그와의 대결을 결정했을 때, %CALLNAME:ARG%이(가) 당신 곁에 있었다.
					PRINTFORMW 
					PRINTFORML %CALLNAME:ARG%
					PRINTFORMW 「저도…… 싸우겠어요!」
					PRINTFORML 
					PRINTFORML %CALLNAME:MASTER%은(는) %CALLNAME:ARG%와(과) 함께 싸움에 대비했다.
					PRINTFORMW 
					ENDIF
				NEXT
				
				PRINTFORMW 루그와 대결하기 위해 사이코 다이버를 불러 %CALLNAME:ARG%의 정신세계로 다이브한다…….
				PRINTFORML 
				PRINTFORML …
				PRINTFORML ……
				PRINTFORML ………
				PRINTFORMW
				PRINTFORML 정신세계에는 황금빛 갑주를 두른 무인 같은 악마가 서 있었다.
				PRINTFORMW 저것이야말로 다난 신족의 태양신 루이자, 라우파다…… 긴 팔이라는 이명을 가진 빛의 신 루그일 것이다.
				PRINTFORMW 루그는 당신들의 모습을 보자 조용히 창을 겨눈다. ……상대도 이미 준비는 되어 있는 모양이다.
				PRINTFORML 
				PRINTFORMW 마신 루그＝라우파다가 1체 나타났다!
				
				FLAG:도주불가플래그 = 1
				FLAG:회화불능플래그 = 1
				FLAG:선제기습취소 = 1
				
				CALL SET_ENEMY, 9, [[キャラ:루그＝라우파다_링크전용]], 75, 1, 2
				NAME:(CHARANUM-1) = 루그＝라우파다
				CALLNAME:(CHARANUM-1) = 루그＝라우파다
				CFLAG:(CHARANUM-1):ＨＰ보정 += 7500
				CFLAG:(CHARANUM-1):ＭＰ보정 += 50000
				CFLAG:(CHARANUM-1):행동횟수 = 3
				CFLAG:(CHARANUM-1):COOP피데미지보정 = -50
				CSTR:(CHARANUM-1):사고패턴 = ラウファーダ用強化ルーグルーチン
				BASE:(CHARANUM-1):힘 += 10
				BASE:(CHARANUM-1):지혜 += 5
				BASE:(CHARANUM-1):마력 += 5
				BASE:(CHARANUM-1):내구 += 5
				BASE:(CHARANUM-1):속도 += 10
				BASE:(CHARANUM-1):운 += 5
				
				ABL:(CHARANUM-1):스킬1  = [[스킬:브류나크]]
				ABL:(CHARANUM-1):스킬2  = [[스킬:전용기1]]
				ABL:(CHARANUM-1):스킬3  = [[스킬:데스바운드]]
				ABL:(CHARANUM-1):스킬4  = [[스킬:히트라이저]]
				ABL:(CHARANUM-1):스킬5  = [[스킬:랜더마이저]]
				ABL:(CHARANUM-1):스킬6  = [[스킬:이니셜라이즈]]
				ABL:(CHARANUM-1):스킬7  = [[스킬:어드바이스]]
				ABL:(CHARANUM-1):스킬8  = [[스킬:코칭]]
				
				CALL SYNC_STATUS, (CHARANUM-1)
				CALL HEALTH_CHARA, (CHARANUM-1)
				CALL BATTLE_START
				
				FLAG:도주불가플래그 = 0
				FLAG:회화불능플래그 = 0
				FLAG:선제기습취소 = 0
				
				;このルートのみ、戦闘勝利報酬がある
				;内容はスキルカード万魔の一撃
				ITEM:12062 += 1
				
				PRINTFORMW 루그와의 싸움에서 승리한 너희들 앞에서 조용히 루그가 사라져 간다…….
				PRINTFORMW 그 뒤에는 한 장의 카드가 남겨져 있었고, 그것을 회수하고서 그 자리를 떠났다.
				PRINTFORML 
				PRINTFORMW ＞스킬 카드, 만마의 일격을 손에 넣었다.
				PRINTFORML 
				PRINTFORML …
				PRINTFORML ……
				PRINTFORMW ………
				PRINTFORML 
				PRINTFORML 그 후, 루그의 힘을 흡수한 %CALLNAME:ARG%은(는) 그 힘을 완전히 제어하는 데 성공.
				PRINTFORML %CALLNAME:ARG%은(는) 아웃사이더로서 한층 더 큰 힘을 얻은 것이었다…….
				
				;新しい処理になるのと、ここ関数化できるなと気付いたので変更
				CALL IO_KANSU,ARG
				RETURN 1
			ELSEIF RESULT == 99
				PRINTFORML 상대는 강대한 악마, 그것도 본래의 힘에 가까워진 빛의 신 루그다.
				PRINTFORMW 도전한다 해도 준비나 숙고가 필요할지도 모른다.
				PRINTFORML 
				PRINTFORML ……하지만. 아직 약간은 유예가 있다.
				PRINTFORMW 당신은 숨을 내쉬고 다른 작업으로 넘어갔다…….
			ENDIF
		ELSEIF RESULT == 1
			PRINTFORMW 요는 완전히 견뎌내거나, 적합시켜 버리면 되는 것이다.
			PRINTFORML 예를 들면 팬텀의 의료시설을 풀 활용하여 육체의 융해를 억누른다거나,
			PRINTFORML 전속 주술사를 불러 루그에 대한 대항 개념을 새긴 부적을 준비하거나,
			PRINTFORMW 그런 손을 써서 시간을 번다면 %CALLNAME:ARG%의 재능이라면 루그를 완전히 지배해 줄 것이다.
			PRINTFORML 당연히 싼값은 아니다.
			PRINTFORML 그러나 돈으로 기술을 살 수 있다면 그것이 가장 안전하고 편하다.
			PRINTFORMW 이 방법으로 괜찮을까?
			PRINTFORML 　
			SIF MONEY < 1000000 || MONEY:1 < 20000
				SETCOLOR 0x404040
			PRINTFORML [0] 의료 시설이나 주구를 준비한다 (￥100만 또는 2만 마카 필요)
			RESETCOLOR
			PRINTFORML [99] 잠시 생각한다
			CALL INPUTINT, 0, 99
			IF RESULT == 0
				IF MONEY > 1000000 || MONEY:1 > 20000
					IF MONEY < 1000000
						MONEY -= 1000000
					ELSE
						MONEY:1 -= 20000
					ENDIF
					PRINTFORML 그렇게 결정했다면 이야기는 빠르다.
					PRINTFORMW %CALLNAME:MASTER%은(는) 기자재와 주구의 수배에 착수했다.
					PRINTFORML 
					PRINTFORML …
					PRINTFORML ……
					PRINTFORMW ………
					PRINTFORML 
					PRINTFORMW 이렇게 하여 삼엄할 정도의 지원 태세가 갖추어졌다.
					PRINTFORML 최신 의료기기가 늘어선 방에는 숙련된 의료 스태프가 배치되고,
					PRINTFORML 주위에 결계가 쳐진 침대에는 겹겹이 부적이 붙어 있다.
					PRINTFORMW 거기에 복수의 전투원도 동원하여 만에 하나 루그가 밖으로 도망치더라도 즉시 조복할 수 있도록 자리를 마련했다.
					PRINTFORML
					PRINTFORML 거금으로 마련된 삼엄한 방에 %CALLNAME:ARG%도 당혹스러워했지만,
					PRINTFORMW 자신을 위해 여기까지 자리를 마련해 준 당신에게 감사의 말을 전하고는 조용히 준비를 시작했다.
					PRINTFORML 
					PRINTFORML …
					PRINTFORML ……
					PRINTFORMW ………
					PRINTFORML 
					PRINTFORMW 그 뒤로는 딱히 말할 것도 없었다.
					PRINTFORML 신뢰와 실적이 있는 시설과 스태프는 별다른 위기 없이,
					PRINTFORML %CALLNAME:ARG%에게 무사히 루그를 적합시키는 데 성공.
					PRINTFORMW %CALLNAME:ARG%은(는) 아웃사이더로서 한층 더 큰 힘을 얻은 것이었다…….
					
					;新しい処理になるのと、ここ関数化できるなと気付いたので変更
					CALL IO_KANSU,ARG
					RETURN 1
				ELSE
					PRINTFORML 
					PRINTFORML 돈으로 해결하는 편이 낫겠다고 생각했으나,
					PRINTFORMW 현재의 %CALLNAME:MASTER%에게는 그 정도의 자금이 없다.
					PRINTFORML 
					PRINTFORML ……하지만. 아직 약간은 유예가 있다.
					PRINTFORMW 당신은 숨을 내쉬고 다른 작업으로 넘어갔다…….
				ENDIF
			ELSEIF RESULT == 99
				PRINTFORML ……아니. 아직 약간은 유예가 있다.
				PRINTFORMW 당신은 숨을 내쉬고 다른 작업으로 넘어갔다…….
			ENDIF


		ELSEIF RESULT == 2
			PRINTFORML 루그의 힘에 견뎌낼 수 있을 만큼의 에너지를── MAG를 보충해 주면 된다.
			PRINTFORML 그리고 그것은 당신의 특기 분야다.
			PRINTFORMW 뭐, MAG를 쏟아붓기만 하는 거라면 %CALLNAME:MASTER% 이외여도 상관은 없지만……
			PRINTFORMW 이 방법으로 괜찮을까?
			PRINTFORML 　

			SIF GET_CHARA_STOCK_MAG((MASTER)) < 1000000
				SETCOLOR 0x404040
			IF 신뢰(ARG) == 1
				PRINTFORML [0] %CALLNAME:MASTER%이(가) MAG를 붓는다(100만 MAG 필요. 신뢰 상태일 경우 연모화합니다)
			ELSE
				PRINTFORML [0] %CALLNAME:MASTER%이(가) MAG를 붓는다(100만 MAG 필요)
			ENDIF
			RESETCOLOR
			
			IF FLAG:ＮＴＲ기능
				SETCOLOR COLOR("pink")
				PRINTFORML [1] 불특정 다수의 상대에게 MAG를 마련하게 한다(음란계 함락을 제외하고 NTR이 크게 진행됩니다)
				RESETCOLOR
			ELSE
				PRINTFORML [1] 불특정 다수의 상대에게 MAG를 마련하게 한다
			ENDIF
			PRINTFORML [99] 잠시 생각한다
			CALL INPUTINT, 0, 1,99
			IF RESULT == 0
				IF GET_CHARA_STOCK_MAG((MASTER)) > 999999
					PRINTFORMW 그렇게 결정했다면 이야기는 빠르다.
					PRINTFORMW %CALLNAME:MASTER%은(는) 즉시 %CALLNAME:ARG%을(를) 조교실로 데려갔다.
					PRINTFORML 
					PRINTFORML …
					PRINTFORML ……
					PRINTFORMW ………
					PRINTFORML 
					PRINTFORMW 어두컴컴한 방에 축축한 소리가 울려 퍼지고 있다…….
					IF HAVE_VAGINA(ARG) == 1
						IF HAVE_PENIS(MASTER)
							PRINTFORMW %CALLNAME:MASTER%의 물건을 받아들이고 있는 %CALLNAME:ARG%은(는) 성교의 기쁨에 몸을 비틀고 있다.
							IF TALENT:ARG:처녀
								PRINTFORMW 방금 전까지 처녀였던 %CALLNAME:ARG%은(는) 처음엔 통증에 신음했지만 지금은 쾌락이 앞서고 있었다.
								TALENT:ARG:처녀 = 0
							ENDIF
							PRINTFORMW 이어져 있는 두 사람은 MAG 전달이라는 목적도 한때 잊고 서로 사랑하며 교합을 이어간다…….
							SIF 신뢰(ARG) == 1
								PRINTFORMW ……설령 그것이 신뢰와 우정으로 이어진 두 사람의 관계를 바꾸어 버린다 해도 상관없었다.
							PRINTFORML
							IF ABL:ARG:Ｖ감각 < 1
								ABL:ARG:Ｖ감각 = 1
								PRINTFORML ＞%CALLNAME:ARG%의 V감각이 1이 되었다
							ENDIF
							EXP:ARG:Ｖ경험 += 125
							PRINTFORML ＞%CALLNAME:ARG%은(는) V경험을 125 얻었다
							EXP:ARG:성교경험 += 100
							PRINTFORML ＞%CALLNAME:ARG%은(는) 성교경험을 100 얻었다
							EXP:ARG:정액경험 += 100
							PRINTFORML ＞%CALLNAME:ARG%은(는) 정액경험을 50 얻었다
							EXP:ARG:펠라경험 += 25
							PRINTFORML ＞%CALLNAME:ARG%은(는) 펠라경험을 25 얻었다
							IF TALENT:MASTER:후타나리
								EXP:(ARG):레즈경험 += 200
								PRINTFORML ＞%CALLNAME:ARG%은(는) 레즈경험을 200 얻었다
							ENDIF
						;女同士
						ELSE
							PRINTFORMW 손을 맞잡은 채 혀를 얽는 %CALLNAME:MASTER%와(과) %CALLNAME:ARG%은(는), 한번 떨어지면 두 사람의 혀 사이로 타액이 실을 잇는다.
							PRINTFORMW 잠시 둘이서 마주 보며 서로의 숨소리에 귀를 기울이고 있었지만, 심호흡을 하더니 다시 입술을 가까이하여 혀를 얽는다.
							PRINTFORMW 이어져 있는 두 사람은 MAG 전달이라는 목적도 한때 잊고 서로 사랑하며 입맞춤을 이어간다…….
							SIF 신뢰(ARG) == 1
								PRINTFORMW ……설령 그것이 신뢰와 우정으로 이어진 두 사람의 관계를 바꾸어 버린다 해도 상관없었다.
							PRINTFORML
							EXP:(ARG):레즈경험 += 500
							PRINTFORML ＞%CALLNAME:ARG%은(는) 레즈경험을 500 얻었다
							EXP:(ARG):키스경험 += 500
							PRINTFORML ＞%CALLNAME:ARG%은(는) 키스경험을 500 얻었다
							IF ABL:(ARG):키스중독 < 1
								ABL:(ARG):키스중독 = 1
								PRINTFORML ＞%CALLNAME:ARG%은(는) 키스중독을 얻었다
							ENDIF
						ENDIF
					ELSE
