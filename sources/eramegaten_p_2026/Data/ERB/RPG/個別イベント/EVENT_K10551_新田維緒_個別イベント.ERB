				CFLAG:ARG:의존도 -= 500
				
				RESETCOLOR
				
				;新しい処理になるのと、ここ関数化できるなと気付いたので変更
				CALL IO_KANSU,ARG
				RETURN 1
			ELSEIF RESULT == 99
