			CALL INPUTINT, 0,99
			IF RESULT == 0
				PRINTFORMW %CALLNAME:ARG%의 말에 조용히 고개를 끄덕이고는 맡기기로 했다.
				PRINTFORML 
				PRINTFORMW …
				PRINTFORMW ……
				PRINTFORMW ………
				PRINTFORML 
				PRINTFORML 그 후, 기적적이라고 해야 할지 %CALLNAME:ARG%은(는) 루그의 힘을 제어하여 완전히 적합해 냈다.
				PRINTFORMW %CALLNAME:ARG%은(는) 아웃사이더로서 한층 더 큰 힘을 얻은 것이었다…….
				
				;新しい処理になるのと、ここ関数化できるなと気付いたので変更
				CALL IO_KANSU,ARG
				RETURN 1
			ELSEIF RESULT == 99
