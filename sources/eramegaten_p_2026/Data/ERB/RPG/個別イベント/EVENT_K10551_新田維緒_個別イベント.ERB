				PRINTFORMW 그렇게 전하자 당신은 숨을 내쉬고 다른 작업으로 넘어갔다……
			ENDIF
		ELSEIF RESULT == 99
			PRINTFORML ……아니. 아직 약간은 유예가 있다.
			PRINTFORMW 당신은 숨을 내쉬고 다른 작업으로 넘어갔다……
		ENDIF
	ENDIF
ENDSELECT

@SET_ACTION_ラウファーダ用強化ルーグルーチン, ARG
#DIM 発狂ブリュ
#DIM デスバ無効観測
#DIM タスラムの魔弾狙い
#LOCALSIZE 3
#LOCALSSIZE 1

IF 発狂ブリュ == 0
	FOR LOCAL,1,7
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS < 0
			CONTINUE
		SIF GROUPMATCH(GET_STATE(CFLAG:(FLAG:LOCALS):상태이상), "STONE", "DYING")
			CONTINUE
		;味方の入力行動に物理反射があった場合発狂(イニシャライズからのブリューナク連打パターン突入)
		;物理相性攻撃をするのでテトラカーンも拾う
		IF GROUPMATCH(CFLAG:(FLAG:LOCALS):입력행동,[[스킬:물반경]], [[스킬:테트라칸]], [[스킬:결계부・물리]])
			発狂ブリュ = 1
			SETCOLOR 0xff0033
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃루그는 난적을 상대로 전술을 바꾸었다!　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
			RESETCOLOR
		ENDIF
	
		;おまじない：なんらかの要因で既に反射フラグが立ってる場合も発狂
		IF CFLAG:(FLAG:LOCALS):물리반사플래그 == 1
			発狂ブリュ = 1
			SETCOLOR 0xff0033
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃루그는 난적을 상대로 전술을 바꾸었다!　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
			RESETCOLOR
		ENDIF
	
		;万能無効をしても発狂
		;IF CFLAG:(FLAG:LOCALS):만능무효화횟수 > 0
		;	発狂ブリュ = 1
		;	SETCOLOR 0xff0033
		;	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
		;	PRINTFORML ┃루그는 난적을 상대로 전술을 바꾸었다!　　　　　　┃
		;	PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
		;	RESETCOLOR
		;ENDIF
	NEXT
ENDIF

IF 発狂ブリュ == 0
	FOR LOCAL,1,4
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS == -1
			CONTINUE
		SIF CFLAG:(FLAG:LOCALS):상태이상 == GET_STATE_NUM("DYING")
			CONTINUE
		;剣撃無効以上の仲魔の数をサーチ
		IF MAXBASE:(FLAG:LOCALS):검격 == 999 || MAXBASE:(FLAG:LOCALS):검격 <= 0
			デスバ無効観測 += 1
		ENDIF
	NEXT
	IF デスバ無効観測 > 1
		発狂ブリュ = 1
		SETCOLOR 0xff0033
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃루그는 난적을 상대로 전술을 바꾸었다!　　　　　　┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
		RESETCOLOR
	ENDIF
	デスバ無効観測 = 0
ENDIF

IF 発狂ブリュ == 0
	FOR LOCAL,1,7
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS == -1
			CONTINUE
		SIF CFLAG:(FLAG:LOCALS):상태이상 == GET_STATE_NUM("DYING")
			CONTINUE
		;強化が3段階以上のキャラをサーチ
		FOR LOCAL, GETNUM(CFLAG,"공격강화"), GETNUM(CFLAG,"마법효과강화")+1
			IF CFLAG:(FLAG:LOCALS):공격강화 >=12||CFLAG:(FLAG:LOCALS):방어강화 >=12||CFLAG:(FLAG:LOCALS):명중강화 >=12||CFLAG:(FLAG:LOCALS):회피강화 >=12||CFLAG:(FLAG:LOCALS):마법위력강화 >=12||CFLAG:(FLAG:LOCALS):마법효과강화 >=12
				発狂ブリュ = 1
			ENDIF
		NEXT
	NEXT
	IF 発狂ブリュ == 1
		SETCOLOR 0xff0033
				PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
				PRINTFORML ┃루그는 난적을 상대로 전술을 바꾸었다!　　　　　　┃
				PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
				RESETCOLOR
	ELSE
		FOR LOCAL,7,17
			LOCALS = 포지션{LOCAL}
			SIF FLAG:LOCALS == -1
				CONTINUE
			SIF CFLAG:(FLAG:LOCALS):상태이상 == GET_STATE_NUM("DYING")
				CONTINUE
			;弱体が3段階以上のキャラをサーチ
			FOR LOCAL, GETNUM(CFLAG,"공격강화"), GETNUM(CFLAG,"마법효과강화")+1
				IF CFLAG:(FLAG:LOCALS):공격강화 <=-12||CFLAG:(FLAG:LOCALS):방어강화 <=-12||CFLAG:(FLAG:LOCALS):명중강화 <=-12||CFLAG:(FLAG:LOCALS):회피강화 <=-12||CFLAG:(FLAG:LOCALS):마법위력강화 <=-12||CFLAG:(FLAG:LOCALS):마법효과강화 <=-12
					発狂ブリュ = 1
				ENDIF
			NEXT
		NEXT
		IF 発狂ブリュ == 1
			SETCOLOR 0xff0033
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃루그는 난적을 상대로 전술을 바꾸었다!　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
			RESETCOLOR
		ENDIF
	ENDIF
ENDIF

;「前衛に剣撃無効以上になる仲魔が二人以上いる」「規定量以上の強度(3段階分)でバフ/デバフを行う」「強力な防御系のスキルを使用する」と発狂
IF 発狂ブリュ == 1
	;発狂後の初手は必ずイニシャライズ
	IF CFLAG:ARG:행동한횟수 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:이니셜라이즈]]
	;それ以降はブリューナク連打
	ELSE
		CALL SET_ACTION_SKILL, ARG, [[스킬:브류나크]]
	ENDIF
ELSE
	;初手はバフかデバフ
	IF CFLAG:ARG:행동한횟수 == 0 && RAND:2 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:히트라이저]]
	ELSEIF CFLAG:ARG:행동한횟수 == 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:랜더마이저]]
	;2手目はブリューナク。ただし１moreしたらブリューナク以外になる
	ELSEIF CFLAG:ARG:행동한횟수 == 1 && CFLAG:ARG:１more플래그 <= 0
		CALL SET_ACTION_SKILL, ARG, [[스킬:브류나크]]
	;それ以外はデスバウンドか3分の1の確率でのタスラムの魔弾のパターン
	ELSEIF CFLAG:ARG:행동한횟수 >= 2 && RAND:3 == 0
		;비구＆破魔で即死
		FOR LOCAL,1,7
			LOCALS = 포지션{LOCAL}
			SIF FLAG:LOCALS == -1
				CONTINUE
			;タスラムの魔弾が有効な誰かを探してタスラムの魔弾狙いを保存
			IF  (FLAG:LOCALS) >= 0 && GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) != "DYING" && MAXBASE:(FLAG:LOCALS):DYING >(-51) && MAXBASE:(FLAG:LOCALS):비구 > 0 && MAXBASE:(FLAG:LOCALS):비구 != 999 && MAXBASE:(FLAG:LOCALS):파마 > 49 && MAXBASE:(FLAG:LOCALS):파마 != 999
				タスラムの魔弾狙い = CPOS(FLAG:LOCALS)
				BREAK
			ENDIF
		タスラムの魔弾狙い = -1
		NEXT
		IF タスラムの魔弾狙い == -1
		;비구＆破魔で即死
			CALL SET_ACTION_SKILL, ARG, [[스킬:전용기1]]
		;タスラムの魔弾が有効な相手ならそいつを殺そうとする
		ELSE
			SETCOLOR 0xff0033
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━┓
			PRINTFORML ┃루그는 표적을 정하고 돌팔매를 겨눈다!　　　　　　┃
			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━┛
			RESETCOLOR
			CFLAG:ARG:타겟 = タスラムの魔弾狙い
			;비구＆破魔で即死
			CFLAG:ARG:입력행동 = [[스킬:전용기1]]
		ENDIF
	ELSE
		;검격
		CALL SET_ACTION_SKILL, ARG, [[스킬:데스바운드]]
	ENDIF
ENDIF

@IO_KANSU, ARG
