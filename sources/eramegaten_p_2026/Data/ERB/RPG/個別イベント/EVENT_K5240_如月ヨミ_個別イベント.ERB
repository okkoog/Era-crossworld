;-------------------------------------------------
;ヨミパイセン個別イベント。強化イベントも兼ねてます。
;-------------------------------------------------
@INDIVIDUAL_EVENT_K5240, ARG, ARG:1 = 0, ARG:2 = -1
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）

;リストにキャラを表示する条件
IF ARG:1 == 0
	;イベント0で全部終了
	SIF GETBIT(CFLAG:ARG:개별이벤트읽음, 0)
		RETURN 0
	RETURN 1
ENDIF

SELECTCASE ARG:2
	CASE 0
		;解放条件
		IF ARG:1 == 1
			SIF 陥落(ARG) < 2
				RETURN 0
			RETURN 1

		ELSEIF ARG:1 == 2
		;타이틀
			IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
				;타이틀
				RESULTS = 어느 전직 퇴마사의 결의
			ELSE
				;未開放時のタイトル（解放条件を入れておく）
				RESULTS = ※%CALLNAME:ARG%이(가) 상위 함락 완료
			ENDIF
		;이벤트
		ELSEIF ARG:1 == 3
			PRINTFORML 
			PRINTFORML 요미에게서 보고하고 싶은 일이 있다는 이야기가 있어, 한가한 시간에 그녀의 방을 찾았다
			PRINTFORML 철컥 하고 문을 열자, 의자에 앉아 있던 그녀가 흠칫하고 어깨를 떤다
			PRINTFORML 
			PRINTFORMW 「…！！ 읏, 여성의 방에 들어올 때는 적어도 노크 정도는 해주세요…」
			PRINTFORML 
			PRINTFORML 상기된 얼굴로 다소 당황한 기색의 요미였으나, 보고할 내용을 묻자 조금 진지한 표정이 되었다
			PRINTFORML 
			PRINTFORML 「확실히 부른 건 접니다만…! 하아… 알겠습니다. 조금… 이야기를 하죠」
			PRINTFORML 
			PRINTFORMW 헛기침을, 요미가 가볍게 내뱉는다
			PRINTFORML 
			PRINTFORML 「당신도 아시다시피… 저는 퇴마사입니다. 한때는 사람들을 구하고, 감사를 받으며… 이런 자신이라도 누군가에게 도움이 될 수 있다는 생각에 보람을 느꼈지요」
			PRINTFORML 「…그 나름대로 강했던 저는… 자신은 지지 않는다고 오만하기도 했습니다…. 그런 방심으로 이계에 패배하는 것은… 당연한 일이겠지요」
			PRINTFORML 「저는 인간이라는 사실조차 잊어버릴 만큼 범해져, 너덜너덜해졌습니다. 음계의 붕괴로 기적적으로 밖으로 나올 수 있었던 모양입니다만…」
			PRINTFORMW 「당신이 거두어주지 않았더라면 지금쯤은…. 영혼이 부서져 있어서는 육체가 살아있어도 죽은 것이나 다름없으니까요」
			PRINTFORML 
			PRINTFORML 「어쨌든… 치료도, 식사도 방도 제공받아, 저는 살아 있습니다. …정말로, 감사하고 있답니다」
			PRINTFORML 「당신이 어떤 셈이었는지는 모릅니다만. 이런, 짓이겨져 아무것도 할 수 없는 번거로운 어린 계집을 팔아치우지도 않고…」
			PRINTFORML 
			PRINTFORMW 뭐, 주워지자마자 정부로 삼아지긴 했습니다만…이라며, 잠시 말을 끊은 요미가 빤한 눈빛으로 쳐다보았다
			PRINTFORML 
			PRINTFORML 「…정말로, 별난 분이라고 하지 않을 수 없군요. 하지만, 그래도… 당신 덕분에 저는 여기까지 회복했습니다」
			PRINTFORML 「당신과 얕지 않은 사이가 되어버리기도 했으니… 슬슬 은혜를 갚고 싶다고… 저는 생각하고 있습니다」
			PRINTFORML 
			PRINTFORML 결의를 품은 눈으로 이쪽을 똑바로 바라보며, 요미는 선언한다
			PRINTFORML 
			PRINTFORML 「저는 아직 퇴마사입니다. 지금의 회복된 몸과 마음이라면… 무엇보다 당신을 위해서라면… 저는 다시 움직일 수 있습니다」
			PRINTFORMW 「둔해진 몸과 술법으로는 잘 싸울 수 없을지도 모릅니다만… 반드시、되찾아 보이겠습니다」
			PRINTFORML 
			PRINTFORML 요미의 힘 있는 눈빛은、이제 괜찮다는 의지를 느끼게 했다
			PRINTFORML 
			PRINTFORML 「…납득해 주신 모양이군요。 그럼、앞으로도 잘 부탁드립니다」
			PRINTFORMW 「그건 그렇고、이 뒤의 예정은… 읏 뭘 하시는…?」
			PRINTFORML 
			PRINTFORML 일어서려는 요미의 어깨를 잡아 멈춰 세운다。 유난히 축축한 치맛자락을 들어올리자、거기에 있어야 할 팬티는 없고…
			PRINTFORML 대신、의자에서 솟아난 딜도에 꿰뚫려 흠뻑 젖어 있는 여음이、그곳에 있었다
			PRINTFORML 음계에서 가혹한 능욕을 계속 받아온 그녀의 자궁은、음계에 서식하는 악령의 묘상이 되는 데 완전히 익숙해져 버려… 이따금 강렬한 열기를 띤다고 한다
			PRINTFORMW 그리고 그때마다、요미는 이렇게 자궁구에 딜도를 처박아、악령은 더 이상 없다는 사실을 자신의 자궁에 타일러 길들이고 있다고、한다
			PRINTFORML 
			PRINTFORML 「이、이건… 당신이、오시는 날짜와 시간을 말해주지 않아서입니다…。 게다가、제 꼴불견 모습 따위、이미 익숙해져 계시잖아요!?」
			PRINTFORML 
			PRINTFORML 허둥지둥 당황하는 요미의 어깨를 양손으로 잡고、일어서려다 빠진 만큼을、단숨에 밀어 넣었다
			PRINTFORML 
			PRINTFORML 「자、잠깐、으응으으읏%ハート()% 하아、하아、자、잠깐만요、기다려、응흐오오옷%ハート()%」
			PRINTFORML 
			PRINTFORML 자궁에 딜도가 처박히고、이어 허리를 잡힌 채 벅벅 문지르듯 움직여지는 자극에 요미는 기절초풍한다
			PRINTFORMW 그리고、젖은 치마가 완전히 무용지물이 되어、애액이 의자에서 뚝뚝 흘러내릴 무렵에야、요미의 자궁은 해방되었다
			PRINTFORML 
			PRINTFORML 「후우――……읏%ハート()% 하아――……읏%ハート()% 정、정말로… 가차 없으시、네요……%ハート()%」
			PRINTFORML 「읏%ハート()% …어찌 되었든、길들이기에 협력해 주셔서、감사합니다。 진정이 되었어요、네、정말로」
			IF HAVE_PENIS(MASTER)
				PRINTFORMW 「시간이 허락한다면… 다음엔、당신의 것으로、길들여 주셨으면 합니다만…%ハート()%」
			ELSE
				PRINTFORMW 「가능하다면… 다음에도 또、길들이기에 협력해 주시면 감사하겠습니다만…%ハート()%」
			ENDIF
			PRINTFORML 
			PRINTFORML 얼굴을 붉히고 있는 요미의 머리를 쓰다듬자、기분 좋은 듯 눈을 가늘게 떴다
			PRINTFORML 
			PRINTFORML 
			PRINTFORMW 키사라기 요미의 상처 입었던 정신은 회복되어、싸우려는 의지를 되찾았다！
			
			;精神が回復したので、狂気と戦力喪失を外す
			TALENT:ARG:광기 = 0
			TALENT:ARG:전력상실 = 0
			
			CALL DO_LEVEL_UP, ARG, MIN(BASE:MASTER:LV, 50)
			
			;キャラ説明文を書き換え
			CSTR:ARG:45 = とても戦える状態ではなかった彼女だが、その強靭な精神力とあなたの存在によりトラウマを乗り越え、戦う意志を取り戻した。
			CSTR:ARG:46 = 始めは淫界に犯され変質したスキルしか扱えないが、次第に退魔師たる彼女本来のスキルを取り戻していくだろう。
			CSTR:ARG:47 = 
			CSTR:ARG:48 = 呪殺・破魔を中心としたスキルを多数覚える魔法アタッカー
			CSTR:ARG:49 = 
			
			RETURN 1
		ENDIF
ENDSELECT
RETURN 0