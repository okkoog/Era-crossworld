;-------------------------------------------------
;エレナ個人イベント
;-------------------------------------------------
@INDIVIDUAL_EVENT_K5090, ARG, ARG:1 = 0, ARG:2 = -1
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM 導入フラグ
#DIM PU_CFLAG
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）

;リストにキャラを表示する条件
IF ARG:1 == 0
	;イベント1で全部終了
	SIF GETBIT(CFLAG:ARG:개별이벤트읽음, 1)
		RETURN 0
	RETURN 1
ENDIF
;ビットで管理したいのでPU_CFLAGに代入
PU_CFLAG = GET_RPG_CFLAG_TAKEOVER(ARG,"鯖強化フラグ")

;VERUPでプロフ更新とかやるの面倒だから個別イベントでやる

CALL CHARA_UPDATE_5090,ARG

SELECTCASE ARG:2
	CASE 0
		;解放条件
		IF ARG:1 == 1
			SIF GET_VALUE_TALENT_JOINABLE(ARG) == 0
				RETURN 0
			SIF BASE:ARG:LV < 60
				RETURN 0
			SIF GET_CHARA_LOYALTY(ARG) < 5000
				RETURN 0
			RETURN 1
		ELSEIF ARG:1 == 2
		;타이틀
			IF GETBIT(CFLAG:ARG:개별이벤트개방, ARG:2)
				;타이틀
				RESULTS = 스킬 강화：헬레나 그 첫 번째
			ELSE
				;未開放時のタイトル（解放条件を入れておく）
				RESULTS = (%CALLNAME:ARG%의 LV60 이상、및 %CALLNAME:ARG%의 충성도 5000 이상으로 해방)
			ENDIF
		;이벤트
		ELSEIF ARG:1 == 3
			CUSTOMDRAWLINE =
			;締め切りまで間に合いそうにないので仮メッセージを置いておく
			PRINTL  
			PRINTW  「예로부터 마술적인 연결고리를 가진 주종은、그 유대가 굳건해질수록 강해질 수 있다는 법칙이 있어
			PRINTW  　즉 나와 너 사이에 강한 신뢰 관계가 싹트면、필연적으로 나도 강해질 수 있다는 소리지」
			PRINTL
			PRINTW  「처음엔 조금 불안했지만、여기까지 싸워온 이상 신뢰하지 않을 수가 없는걸！」
			PRINTL
			PRINTW  「앞으로도 잘 부탁해、마스터！ 함께 미지의 신비를 향해 나아가자！」
			PRINTL
			PRINTL  …………
			PRINTL  ………
			PRINTL  ……
			PRINTL
			IF !GETBIT(PU_CFLAG,0)
				SETBIT PU_CFLAG,0
				PRINTFORMW  　%CALLNAME:ARG%와의 신뢰를 돈독히 한 것으로、『금성신・화염천주』의 위력이 강화되었다！
				CALL SET_RPG_CFLAG_TAKEOVER(ARG,"鯖強化フラグ",PU_CFLAG)
			ENDIF
			RETURN 1
		ENDIF
	CASE 1
		;解放条件
		IF ARG:1 == 1
			SIF GET_VALUE_TALENT_JOINABLE(ARG) == 0
				RETURN 0
			SIF GETBIT(CFLAG:ARG:개별이벤트읽음, 0) == 0
				RETURN 0
			SIF BASE:ARG:LV < 70
				RETURN 0
			SIF GET_CHARA_LOYALTY(ARG) < 8000
				RETURN 0
			RETURN 1
		ELSEIF ARG:1 == 2
		;타이틀
			IF GETBIT(CFLAG:ARG:개별이벤트개방, ARG:2)
				;타이틀
				RESULTS = 스킬 강화：헬레나 그 두 번째
			ELSE
				IF GETBIT(CFLAG:ARG:개별이벤트읽음, 0)
					;未開放時のタイトル（解放条件を入れておく）
					RESULTS = (%CALLNAME:ARG%의 LV70 이상、및 %CALLNAME:ARG%의 충성도 8000 이상으로 해방)
				ELSE
					RESULTS = ？？？？？？？？？？？？
				ENDIF
			ENDIF
		;이벤트
		ELSEIF ARG:1 == 3
			CUSTOMDRAWLINE =
			PRINTL
			PRINTL
			PRINTW  「으음、으으으음……」
			PRINTL
			PRINTFORMW  　다시 %CALLNAME:ARG%의 상태를 보러 왔더니、무언가 심각한 표정을 짓고 있는 장면과 마주쳐버렸다
			PRINTW  　관자놀이에 양손 검지를 대고 고민하는 그 모습은、가련한 소녀의 외모와 어우러져 무척이나 흐뭇하다
			PRINTL
			PRINTW  「…그래… 그런 거였구나… 마하트마란… 하이어라키란…」
			PRINTL
			PRINTW  　…앞선 생각 철회。보기만 할 땐 흐뭇하지만、말을 걸었다간 엄청 귀찮아질 것 같은 분위기가 되었다。
			PRINTFORMW  　솔직히 이 상태의 %CALLNAME:ARG%에게 얽혔다간 골치 아파질 게 뻔하다、차라리 못 본 척하고 물러나야 할까…
			PRINTL
			PRINTFORMW  「…어? %CALLNAME:MASTER%가 여기에? 앗、정말이네！」
			PRINTL
			PRINTFORMW  　하지만 슬프게도。이쪽이 행동하기 전에 %CALLNAME:ARG%에게 발각되고 말았다。
			PRINTW  　여기까지 와서 도망쳤다간 더 귀찮은 꼴을 당할 예감이 든다… 얌전히 인사를 받아주기로 했다。
			PRINTL
			PRINTW  「정말、있었으면 말을 하지 그랬어。무슨 일이야? 곤란한 일이라도 있어? 상담할 게 있다면 내가 들어줄 수도 있는데?」
			PRINTL
			PRINTW  　곤란한 일이라면 바로 눈앞에 있거든！ 그런 영혼의 절규를 속으로 삼키며… 그저 단순하게 상태를 보러 왔을 뿐이라고 전했다。
			PRINTL
			PRINTW  「어머、그래? …앗、그렇다는 건 어쩌면이 아니라 한가하다는 뜻이지?
			PRINTW  　그럼 마침 잘됐다！ 사실 방금 막、마하트마로부터 새로운 계시가──」
			PRINTL
			PRINTW  　위험해…！ 마하트마의 지식 자랑회가 또 시작되어 버렸다！
			PRINTW  　이대로 건성으로 넘기려 했다간、진지하게 안 듣는다고 울어버리는 비극이 반복되고 만다…！
			PRINTL
			PRINTW  「아ー앗、또 싫다는 표정 짓고 있어！ 정말이지！ 마하트마의 인도가 강해진 덕분에、보구를 쓰기 편해졌다고 말하려던 참이었는데！」
			PRINTL
			PRINTW  　뜻밖에도 지식 자랑회가 아니라、능력이 강화된 것을 보고하는 알기 쉬운 이야기였다
			PRINTW  　당연히 이대로 설명을 2시간가량 늘어놓을 줄 알았는데…
			PRINTL
			PRINTW  「아무리 나라도、싫어하는 상대에게 이야기를 억지로 떠넘길 정도로 횡포하진 않아
			PRINTW  　무언가를 알아주길 바란다면、우선 흥미를 갖게 하는 게 중요한 법이니까」
			PRINTL
			PRINTW  　생각보다 정론인 대답이 돌아온 것에 조금 놀랐다
			PRINTW  　앞으로도 부디 그런 배려를 유념해 주면 참 고맙겠는데…
			PRINTL
			PRINTW  「응！ 그러니까 다음엔 좀 더 알기 쉽고、흥미를 끌기 좋은 해설을 준비해 올게！」
			PRINTL
			PRINTL  　──틀렸어、그게 아니야──
			PRINTFORMW  　 마음속 본심을 입 안에 삼키며、%CALLNAME:MASTER%는 애매하게 미소 지었다
			PRINTL
			PRINTL
			PRINTL  …………
			PRINTL  ………
			PRINTL  ……
			PRINTL
			IF !GETBIT(PU_CFLAG,1)
				SETBIT PU_CFLAG,1
				PRINTFORMW  　마하트마의 인도가 강해진 것은 확실한 모양이다…
				PRINTFORMW  　%CALLNAME:ARG%의 『마하트마』가 강화되었다！
				CALL SET_RPG_CFLAG_TAKEOVER(ARG,"鯖強化フラグ",PU_CFLAG)
			ENDIF
			RETURN 1
		ENDIF
ENDSELECT

;プロフ記載忘れに従い追加したキャラ更新用の関数、次のｶｰﾁｬﾝまとめが来たらたぶん消すかも
@CHARA_UPDATE_5090,ARG
#DIM LCOUNT

FOR LCOUNT,30,49
	SIF CSTR:ARG:LCOUNT != ""
		RETURN 0
	CSTR:ARG:LCOUNT = %CSVCSTR(NO:ARG,LCOUNT)%
NEXT