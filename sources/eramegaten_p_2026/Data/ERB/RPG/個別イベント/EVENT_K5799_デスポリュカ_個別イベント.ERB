@DemonsRoots_敗北者点呼
#DIM DYNAMIC 敗北者点呼
FOR LOCAL,0,CHARANUM
	SIF GET_VALUE_TALENT_JOINABLE(LOCAL) == 0
		CONTINUE
	SIF GROUPMATCH(NO:LOCAL, [[キャラ:데스포르카_DR]], [[キャラ:앙쥬_DR]], [[キャラ:칼린카_DR]], [[キャラ:사라사_DR]], [[キャラ:다이아나_DR]], [[キャラ:나제지타_DR]], [[キャラ:릴리킬러_DR]])
		敗北者点呼 ++
NEXT
RETURN 敗北者点呼



@INDIVIDUAL_EVENT_K5799, ARG, ARG:1 = 0, ARG:2 = -1
#DIM DRネタバレ回避フラグ
#DIM エネミーレベル
#DIM LCOUNT
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）

;リストにキャラを表示する条件
IF ARG:1 == 0
	;イベント5で全部終了
	SIF GETBIT(CFLAG:ARG:개별이벤트읽음, 5)
		RETURN 0
	RETURN 1
ENDIF

SELECTCASE ARG:2
CASE 0
	;解放条件
	IF ARG:1 == 1
		;新宿衛生病院に侵入可能でない場合出ない。
		TRYCALLFORM PREREQUISITE_DUNGEON_3
		SIF !RESULT
			RETURN 0
		;EXイベント設定禁止の場合出ない。
		SIF !GET_USEABLE_EXTRA_TITLE()
			RETURN 0
		;起点単発イベントの閲覧済み。２周目以降で引き継いでいる場合はどのルートでもいい。
		SIF GETBIT(イベントフラグ:19:19, 17) == 0
			RETURN 0
		;夜。
		SIF TIME == 3
			RETURN 1
	;타이틀
	ELSEIF ARG:1 == 2
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 『노예기사의 애가』(전투・시간 경과 있음)
		ELSE
			;未開放時のタイトル。
			RESULTS = ※조건: 단발 이벤트 『죽음의, 끝으로부터』 클리어. 신주쿠 위생병원 진입 가능. 밤.
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		LOADGLOBAL
		PRINTFORML 
		PRINTFORMW 데스폴루카에게서 호출을 받았다.
		PRINTFORML 
		PRINTFORMW 『꿈틀거리는 무언가』가 있는 곳을 짐작한 모양이다.
		PRINTFORML 
		PRINTL [0] 準備完了
		PRINTL [1] 準備不足
		CALL INPUTINT, 0 , 1
		IF RESULT == 1
			PRINTFORML 
			PRINTFORMW 준비를 갖출 필요가 있다.
			PRINTFORMW 일단 보류하기로 했다.
		ELSE
			PRINTFORML 
			PRINTFORMW 데스폴루카에게 향하자 진지한 표정이 맞이해 주었다.
			PRINTFORMW 느껴졌다, 라는 방위와 거리로부터 태블릿 단말을 사용하여 위치를 산출한다…….
			PRINTFORML 
			PRINTFORMW 「……지도, 편리하군……」
			PRINTFORML 
			PRINTFORMW 데스폴루카의 그런 혼잣말이 귀에 들어왔다.
			PRINTFORML 
			PRINTFORML 듣자 하니, 『오버드』라고 불리는…… 『이쪽 세계의 사람이나 물건』이
			PRINTFORMW 그녀들의 대륙에는 흘러들어오는 일이 종종 있어, 그런 자들이 모여 생긴 취락도 존재했다고 한다.
			PRINTFORML 
			PRINTFORMW 그런 사람이나 물건은 다양한 시간축에서 날아온다고 하여 테크놀로지 자체에 편차가 심했고,
			PRINTFORML 현대 기준으로도 구식인 디젤 엔진 차량이 표착했는가 하면,
			PRINTFORML 다 쓰면 다음 상품이 즉시 차원 전송되어 오는 휴대용 냉장고 등
			PRINTFORMW 얼마나 발전해야 만들 수 있는 것인지조차 알 수 없는 물건까지 있었다고 한다.
			PRINTFORML 
			PRINTFORMW 「과연 병원인가…….
			PRINTFORMW 　그 녀석은 우리를 집어삼킨 뒤에도 누군가가 죽을 때마다 힘을 불려 나갔다.
			PRINTFORML 　……목숨이 끝나는 장소를 찾아 헤매다 도달한 걸지도 모르겠군」
