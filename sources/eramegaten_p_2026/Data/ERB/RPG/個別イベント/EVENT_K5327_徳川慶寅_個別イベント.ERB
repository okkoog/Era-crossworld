@INDIVIDUAL_EVENT_K5327, ARG, ARG:1 = 0, ARG:2 = -1
#DIMS L_現剣質
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC L_SHOWLINE, 3
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）

;リストにキャラを表示する条件
IF ARG:1 == 0
	RETURN 1
ENDIF

SELECTCASE ARG:2
	CASE 0
		;解放条件
		IF ARG:1 == 1
			;常時開放
			RETURN 1
		ELSEIF ARG:1 == 2
		;타이틀
			RESULTS = 徳川慶寅　剣質変更
		;이벤트
		ELSEIF ARG:1 == 3
			;이벤트
			VARI STOCK_REDRAW = CURRENTREDRAW()
			VARI START_LINE = LINECOUNT
			REDRAW 0
			$START
			CLEARLINE LINECOUNT - START_LINE
			DRAWLINE
			;L_現剣質 = \@IS_LEARNED_SKILL(ARG, "六太刀・壱") > 0 ? 修羅 # 羅刹 \@
			LOCAL = MAX(PU_SKILLNUM_GET(ARG, "六太刀・壱"), PU_SKILLNUM_GET(ARG, "六太刀・弐"), PU_SKILLNUM_GET(ARG, "六太刀・参"))
			L_現剣質 = \@LOCAL > 0 ? 修羅 # 羅刹 \@
			IF L_現剣質 == "修羅"
				PRINTL 剣質選択<現在:修羅>
			ELSE
				PRINTL 검질 선택<현재:나찰>
			ENDIF
			DRAWLINE
			L_SHOWLINE:1 '= @"<div xpos = '0' ypos = '0' width = '3200' height = '3000' border_width = '2px' background_color = '%BGCOLOR_HTML("赤")%'>" + "<div>"
			{
			L_SHOWLINE:1 += "<div xpos = '50' ypos = '50'>" + @"<font color = '%BGCOLOR_HTML("赤", 1)%'>"
						+ "□수라" + "<br>"
						+ "　육도류 스킬이 변화하지는 않지만," + "<br>" + "3개의 스킬을 능동적으로 사용할 수 없다"
						+ "<br>"
						+ "【통상기 1】일의 칼・나데시코(패랭이꽃)" + "<br>"
						+ "　　　　　 적 1체에 검격 상성의 대 데미지. 발동이 빠르다" + "<br>"
						+ "　　　　　 " + "<br>"
						+ "【통상기 2】이의 칼・시라유리(백합)（파생）" + "<br>"
						+ "　　　　　 단체 공격이 빗나가면 발동" + "<br>"
						+ "　　　　　 적 1체에 검격 상성의 대 데미지. 명중률이 높다" + "<br>"
						+ "　　　　　 " + "<br>"
						+ "【통상기 3】삼의 칼・보탄(모란)（파생）" + "<br>"
						+ "　　　　　 단체 공격 스킬로 크리티컬이 발생하면 발동." + "<br>"
						+ "　　　　　 적 1체에 검격 상성의 대 데미지. 크리티컬률이 높다." + "<br>"
						+ "　　　　　 " + "<br>"
						+ "【통상기 4】사의 칼・츠바키(동백)（파생）" + "<br>"
						+ "　　　　　 양쪽 모두 전열에 있을 때, 가드 중 공격을 받으면 발동." + "<br>"
						+ "　　　　　 적 1체에 검격 상성의 대 데미지. 상대가 가하는 크리티컬률 저하." + "<br>"
						+ "　　　　　 " + "<br>"
						+ "【통상기 5】오의 칼・아사가오(나팔꽃)" + "<br>"
						+ "　　　　　 적 1체에 검격 상성의 4～6회 소 데미지." + "<br>"
						+ "　　　　　 " + "<br>"
						+ "【통상기 6】육의 칼・유우가오(박꽃)" + "<br>"
						+ "　　　　　 적 1체에 내성 무시 검격 상성의 중 데미지. 검격 내성을 무효화한다. 명중률이 낮다" + "<br>"
						+ "<font>" + "</div>"
			}
			L_SHOWLINE:2 += @"<div xpos = '3300' ypos = '0' width = '3200' height = '3000' border_width = '2px' background_color = '%BGCOLOR_HTML("青")%'>" + "<div>"
			{
			L_SHOWLINE:2 += "<div xpos = '50' ypos = '50'>" + @"<font color = '%BGCOLOR_HTML("青", 1)%'>"
						+ "□나찰" + "<br>"
						+ "　모든 육도류 스킬을 능동적으로 사용할 수 있지만, 무작위로 변화한다." + "<br>"
						+ "<br>"
						+ "【통상기 1】일의 칼・나데시코(패랭이꽃)" + "<br>"
						+ "　　　　　 적 1체에 검격 상성의 대 데미지. 발동이 빠르다" + "<br>"
						+ "　　　　　 " + "<br>"
						+ "【통상기 2】이의 칼・시라유리(백합)" + "<br>"
						+ "　　　　　 적 1체에 검격 상성의 대 데미지. 명중률이 높다" + "<br>"
						+ "　　　　　 " + "<br>"
						+ "【통상기 3】삼의 칼・보탄(모란)" + "<br>"
						+ "　　　　　 적 1체에 검격 상성의 대 데미지. 크리티컬률이 높다." + "<br>"
						+ "　　　　　 " + "<br>"
						+ "【통상기 4】사의 칼・츠바키(동백)" + "<br>"
						+ "　　　　　 적 1체에 검격 상성의 대 데미지. 상대가 가하는 크리티컬률 저하." + "<br>"
						+ "　　　　　 " + "<br>"
						+ "【통상기 5】오의 칼・아사가오(나팔꽃)" + "<br>"
						+ "　　　　　 적 1체에 검격 상성의 4～6회 소 데미지." + "<br>"
						+ "　　　　　 " + "<br>"
						+ "【통상기 6】육의 칼・유우가오(박꽃)" + "<br>"
						+ "　　　　　 적 1체에 내성 무시 검격 상성의 중 데미지. 검격 내성을 무효화한다. 명중률이 낮다" + "<br>"
						+ "<font>" + "</div>"
			}
			L_SHOWLINE '= "<div xpos = '100' ypos = '0'>" + L_SHOWLINE:1 + L_SHOWLINE:2 + "</div>"
			HTML_PRINT L_SHOWLINE
			FOR LCOUNT, 0, 30
				PRINTL 
			NEXT
			DRAWLINE
			;TODO Divにたいしてボタンがうまくつくれないので本体が更新されたら直す
			HTML_PRINT SET_COLOR_TAG(SET_BUTTON_TAG("[1] 수라", "1"), \@L_現剣質 == "修羅" ? gray # デフォルト\@)
			HTML_PRINT SET_COLOR_TAG(SET_BUTTON_TAG("[2] 나찰", "2"), \@L_現剣質 == "羅刹" ? gray # デフォルト\@)
			PRINTL [0] 돌아간다
			;L_現剣質 = %CSTR:ARG:전용기5 == "影煩い" ? "修羅" # "羅刹"%
			;PRINTFORML 現在の剣質は「%L_現剣質%」です。
			;PRINTFORML 剣質を変更すると、以下のスキルが変化します。
			;PRINTFORML %CSTR:ARG:전용기5%　%CSTR:ARG:전용기6%　%CSTR:ARG:전용기7%
			;PRINTFORML
			;PRINTFORML [1]修羅　状態異常効果のあるの範囲攻撃を行います
			;PRINTFORML 　　　　	使用スキル：影縫　影舞・酬　影舞・深潭　等
			;PRINTFORML
			;PRINTFORML [2]羅刹　CT率の高い単体攻撃なります
			;PRINTFORML 　　　　	使用スキル：友引　影舞・夢彈　獄門　等
			;PRINTFORML
			;PRINTFORML [0]変更しない
			ONEINPUT
			SELECTCASE RESULT
				CASE 0
					REDRAW STOCK_REDRAW
					RETURN 0
				CASE 1
					FOR LCOUNT, 1, 13
						SIF CSTR:ARG:@"전용기{LCOUNT}" == "六太刀・甲"
							CSTR:ARG:@"전용기{LCOUNT}" '= "六太刀・壱"
						SIF CSTR:ARG:@"전용기{LCOUNT}" == "六太刀・乙"
							CSTR:ARG:@"전용기{LCOUNT}" '= "六太刀・弐"
						SIF CSTR:ARG:@"전용기{LCOUNT}" == "六太刀・丙"
							CSTR:ARG:@"전용기{LCOUNT}" '= "六太刀・参"
					NEXT
					C_LEARNED_SKILLS:ARG:0 '= REPLACE(C_LEARNED_SKILLS:ARG:0, "六太刀・甲", "六太刀・壱")
					C_LEARNED_SKILLS:ARG:0 '= REPLACE(C_LEARNED_SKILLS:ARG:0, "六太刀・乙", "六太刀・弐")
					C_LEARNED_SKILLS:ARG:0 '= REPLACE(C_LEARNED_SKILLS:ARG:0, "六太刀・丙", "六太刀・参")
				CASE 2
					FOR LCOUNT, 1, 13
						SIF CSTR:ARG:@"전용기{LCOUNT}" == "六太刀・壱"
							CSTR:ARG:@"전용기{LCOUNT}" '= "六太刀・甲"
						SIF CSTR:ARG:@"전용기{LCOUNT}" == "六太刀・弐"
							CSTR:ARG:@"전용기{LCOUNT}" '= "六太刀・乙"
						SIF CSTR:ARG:@"전용기{LCOUNT}" == "六太刀・参"
							CSTR:ARG:@"전용기{LCOUNT}" '= "六太刀・丙"
					NEXT
					C_LEARNED_SKILLS:ARG:0 '= REPLACE(C_LEARNED_SKILLS:ARG:0, "六太刀・壱", "六太刀・甲")
					C_LEARNED_SKILLS:ARG:0 '= REPLACE(C_LEARNED_SKILLS:ARG:0, "六太刀・弐", "六太刀・乙")
					C_LEARNED_SKILLS:ARG:0 '= REPLACE(C_LEARNED_SKILLS:ARG:0, "六太刀・参", "六太刀・丙")
			ENDSELECT
			GOTO START
			;IF (RESULT == 1 && L_現剣質 == "羅刹") || (RESULT == 2 && L_現剣質 == "修羅")
			;	L_現剣質 = %RESULT == 1 ? "修羅" # "羅刹"%
			;	PRINTFORML 「%L_現剣質%」に変更しました。
			;	SWAP CSTR:ARG:전용기5, CSTR:ARG:전용기9
			;	SWAP CSTR:ARG:전용기6, CSTR:ARG:전용기10
			;	SWAP CSTR:ARG:전용기7, CSTR:ARG:전용기11
			;	SWAP CSTR:ARG:전용기8, CSTR:ARG:전용기12
			;ENDIF
			RETURN 1
		ENDIF
ENDSELECT
RETURN 0