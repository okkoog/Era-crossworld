		ENDIF
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		;奇数ターンは剣撃
		IF FLAG:경과턴수 % 2 == 1
			IF 0
			ELSEIF RAND:4 == 0
				CFLAG:ARG:입력행동 = [[스킬:작열거가]]
			ELSEIF RAND:3 == 0
				CFLAG:ARG:입력행동 = [[스킬:낭아천주참]]
