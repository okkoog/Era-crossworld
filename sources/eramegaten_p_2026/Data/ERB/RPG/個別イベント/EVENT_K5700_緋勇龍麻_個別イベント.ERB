				CFLAG:ARG:입력행동 = [[스킬:마하・라기다인]]
			ELSEIF RAND:2 == 0
				CFLAG:ARG:입력행동 = [[스킬:대염상]]
			ELSE
				CFLAG:ARG:입력행동 = [[스킬:불꽃의난무]]
			ENDIF
		ENDIF
