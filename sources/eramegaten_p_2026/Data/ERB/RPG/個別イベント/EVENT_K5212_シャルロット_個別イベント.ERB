					CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス4属性", "闇" 
				ELSEIF GET_RPG_CSTR_TAKEOVER(ARG, "クラス4属性") == "闇"
					CALL SET_RPG_CSTR_TAKEOVER, ARG, "クラス4属性", "光" 
				ENDIF
				CALL LEARN_PU_SKILL(ARG,"クラス４スキル（聖剣３）")
			ELSEIF RESULT == 3
				PRINTFORMW 처리를 마쳤다.
				RETURN 0
			ENDIF
			IF IS_AWAKEN == 0
				CLEARLINE LINECOUNT - L_LINE:1
				IF GET_RPG_CSTR_TAKEOVER(ARG, @"クラス{CHOICE_CLASS_RANK}属性") == "光"
					SELECTCASE CHOICE_CLASS_RANK
						CASE 2
							PRINTFORML 프리스티스의 힘이 깃들었습니다.
						CASE 3
							IF GET_RPG_CSTR_TAKEOVER(ARG, @"クラス2属性") == "光"
								PRINTFORML 비숍의 힘이 깃들었습니다.
							ELSE
								PRINTFORML 세이지의 힘이 깃들었습니다.
							ENDIF
						CASE 4
							PRINTFORML 하이 프리스티스의 힘이 깃들었습니다.
					ENDSELECT
				ELSE
					SELECTCASE CHOICE_CLASS_RANK
						CASE 2
							PRINTFORML 인챈트리스의 힘이 깃들었습니다.
						CASE 3
							IF GET_RPG_CSTR_TAKEOVER(ARG, @"クラス2属性") == "光"
								PRINTFORML 네크로맨서의 힘이 깃들었습니다.
							ELSE
								PRINTFORML 이블 샤먼의 힘이 깃들었습니다.
							ENDIF
						CASE 4
							PRINTFORML 카오스 메이커의 힘이 깃들었습니다.
					ENDSELECT
				ENDIF
				PRINTL 
				PRINTL 
				PRINTL 
				WAIT
			ENDIF
			GOTO INPUT_LOOP_EVENT_K5212CC
		;好感度以外は後に上昇値が表示される
		;CFLAG:ARG:(MASTER + 2100) += (好感度)
		;TCVAR:ARG:획득의존도 += 
		;TCVAR:ARG:획득충성도 += 
		;CALL ADDS_EXP("○○経験", 1, ARG)
	ENDIF
ENDSELECT
RETURN 0