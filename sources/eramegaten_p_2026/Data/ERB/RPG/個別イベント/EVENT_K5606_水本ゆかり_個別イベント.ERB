@INDIVIDUAL_EVENT_K5606, ARG, ARG:1 = 0, ARG:2 = -1
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）

;リストにキャラを表示する条件
IF ARG:1 == 0
	;イベント0で全部終了
	SIF GETBIT(CFLAG:ARG:개별이벤트읽음, 0)
		RETURN 0
	RETURN 1
ENDIF

SELECTCASE ARG:2
CASE 0
	;解放条件
	IF ARG:1 == 1
		IF TALENT:ARG:연모 == 1 || TALENT:ARG:친애 == 1
			RETURN 1
		ENDIF
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 예도도 게을리하지 않고
		ELSE
			;未開放時のタイトル（解放条件を入れておく）
			RESULTS = (해방 조건：%CALLNAME:ARG%가 연모계 함락되어 있을 것)
		ENDIF
	;이벤트
