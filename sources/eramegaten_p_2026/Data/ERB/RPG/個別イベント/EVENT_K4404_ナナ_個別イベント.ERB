;=======================================================================
@SET_ACTION_ナナ, ARG
;=======================================================================
;1.力をためて、至高の魔弾
;2.ワンモアしたら、ランダマイザ
;基本的には神経と飛具、3回行動
;デカジャデクンダを使わない
;=======================================================================
;入力行動を-1とターゲットを-1にしておく
CFLAG:ARG:입력행동 = -1
CFLAG:ARG:타겟 = -1


IF FLAG:경과턴수 == 0 && CFLAG:ARG:행동한횟수 == 0
	PRINTFORML ┏> 나나━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃이것이, 내 대답……!　　　　　　　　┃
	PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━┛
ENDIF


;ワンモアが入るとランダマイザ
IF CFLAG:ARG:１more플래그 > 0
	CFLAG:ARG:입력행동 = [[스킬:랜더마이저]]

;奇数ターン
ELSEIF FLAG:경과턴수 % 2 == 1
	IF CFLAG:ARG:행동한횟수 == 0
		CFLAG:ARG:입력행동 = [[스킬:회심의패기]]
	ELSEIF CFLAG:ARG:행동한횟수 == 1
		;HP50％以下になると至高
		IF 現HP割合(ARG) < 50
			CFLAG:ARG:입력행동 = [[스킬:지고의마탄]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:파사의광탄]]
		ENDIF
	ELSE
		;全体神経（ひとつ飛具）
		IF 0
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:혼탁의장기]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:마카쟈마온]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:고천열풍탄]]
		ENDIF
	ENDIF


;偶数ターン
ELSEIF FLAG:경과턴수 % 2 == 0
	IF CFLAG:ARG:행동한횟수 == 0
		IF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:비구가드브레이크]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:기합]]
		ENDIF
	ELSE
		;ランダム飛具（ひとつドムディ）
		IF 0
		ELSEIF RAND:3 == 0
			CFLAG:ARG:입력행동 = [[스킬:지고의마탄]]
		ELSEIF RAND:2 == 0
			CFLAG:ARG:입력행동 = [[스킬:데스샤워]]
		ELSE
			CFLAG:ARG:입력행동 = [[스킬:도무디]]
		ENDIF
	ENDIF
ENDIF

;アクション実行不能
CALL CHECK_ACTIONABLE, ARG, CFLAG:ARG:입력행동
SIF RESULT == 0
	CFLAG:ARG:입력행동 = 0
;ここまでターゲットが決まってなかったら、ランダムターゲットをよんで決定
SIF CFLAG:ARG:타겟 == -1
	CALL RANDOM_TARGET, ARG, CFLAG:ARG:입력행동
RETURN 1
