@INDIVIDUAL_EVENT_K136, ARG, ARG:1 = 0, ARG:2 = -1
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）

;リストにキャラを表示する条件
IF ARG:1 == 0
	;イベント0で全部終了
	SIF GETBIT(CFLAG:ARG:개별이벤트읽음, 0)
		RETURN 0
	RETURN 1
ENDIF

SELECTCASE ARG:2
CASE 0
	;解放条件
	;イズンのレベルが５０以上、歌唱・料理技能合計１５以上
	IF ARG:1 == 1
		SIF MAXBASE:ARG:LV < 50
			RETURN 0
		SIF (ABL:ARG:가창기능 + ABL:ARG:요리기능) < 15
			RETURN 0
		RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 표적이 된 %CALLNAME:ARG% (전투 있음)
		ELSE
			;未開放時のタイトル（解放条件を入れておく）
			RESULTS = ※%CALLNAME:ARG%의 Lv50 이상、가창・요리 기능 합계 15 이상
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		LOADGLOBAL
		PRINTFORMW ＞레슨 스튜디오
		PRINTFORML 
		PRINTFORMW 팬텀의 손길이 닿은、연예 관련 스튜디오 중 하나다。
		PRINTFORML 
		PRINTFORMW %CALLNAME:ARG%의 요망에 응하여、레슨을 시키기 시작한 지 얼마간 지났다。
		PRINTFORML 떠받들어졌다고 하길래、학생이 취미로 하는
		PRINTFORMW 인터넷 아이돌 정도일 거라 생각했으나、제법 이해가 빠르다。
		PRINTFORML 
		PRINTFORMW 이 상태라면 모양새가 갖춰지는 것도 머지않았다。
		PRINTFORML 
		PRINTFORMW 「……상담 좀 들어줬으면 하는데」
		PRINTFORML 
		PRINTFORMW 연습을 마친 곳에서、%CALLNAME:ARG%이(가) %CALLNAME:MASTER%에게 말을 걸어왔다。
		PRINTFORML 
		PRINTFORMW 「내가 황금 사과의 관리자라는 건、너도 알고 있을 거라 생각하는데……
		PRINTFORMW 　로키라는 악마를 알고 있니?」
		PRINTFORML 
		;ロキが既知か
		SIF ANALYSIS_RATE:[[キャラ:로키]] > 0
			PRINTFORML 물론이지。북유럽 신화의、잔머리 굴리길 좋아하는 질 나쁜 마왕이다。
		PRINTFORML 
		PRINTFORML 「……뭐 솔직히 말하자면 트러블메이커지만
		PRINTFORML 　이전에、내가 관리하는 사과를 노리고 나쁜 짓을 꾸몄었어。
		PRINTFORMW 　한 번은 쫓아냈는데、포기하지 않은 모양이라……」
		PRINTFORML 
		PRINTFORML %CALLNAME:ARG%을(를) 아이돌로서 데뷔시킬 셈이라면、
		PRINTFORMW 그런 바람직하지 못한 관계나 트러블의 불씨가 될 만한 것은 미리 구축해두는 편이 좋을지도 모른다。
		PRINTFORML 
		PRINTFORMW 「맞아…… 후환을 끊어내고 마음 편히 무대에 서고 싶어」
		PRINTFORMW 『호오、기우로군、나도 후환은 끊어두고 싶던 참이라 말이지이～』
		PRINTFORML 
		PRINTFORML 기다리고 있었다는 듯한 타이밍에、스르륵
		PRINTFORMW 악마가 나타났다。
		PRINTFORML 
		PRINTFORML 「사과와 이둔을 둘 다 손아귀에 넣으려고 노리고 있었는데、
		PRINTFORMW 　인간 놈에게 몸을 의탁하고 있었을 줄이야…… 방해할 셈이라면、죽어줘야겠다、진짜로」
		PRINTFORML 
		PRINTFORMW 말은 빠르지만、손도 빠르다…… 해치우는 수밖에 없겠군。
		PRINTFORML 
		PRINTFORMW 마왕 로키 이(가) 나타났다！
		PRINTFORML 
		FLAG:도주불가플래그 = 1
		FLAG:회화불능플래그 = 1
		FLAG:선제기습취소 = 1
		
		CALL SET_ENEMY, 9, [[キャラ:로키]], 60, 1, 1
		CFLAG:(CHARANUM-1):ＨＰ보정 += 5000
		CFLAG:(CHARANUM-1):ＭＰ보정 += 50000
		CFLAG:(CHARANUM-1):행동횟수 = 2
		ABL:(CHARANUM-1):스킬1  = [[스킬:메기도라]]
		ABL:(CHARANUM-1):스킬2  = [[스킬:지오다인]]
		ABL:(CHARANUM-1):스킬3  = [[스킬:코칭]]
		ABL:(CHARANUM-1):스킬4  = [[스킬:도발]]
		ABL:(CHARANUM-1):스킬5  = [[스킬:딜레이・디아]]
		ABL:(CHARANUM-1):스킬6  = [[스킬:마카카쟈오토]]
		ABL:(CHARANUM-1):스킬7  = [[스킬:스쿠카쟈오토]]
		ABL:(CHARANUM-1):스킬8  = [[스킬:라쿠카쟈오토]]
		CALL SYNC_STATUS, (CHARANUM-1)
		CALL HEALTH_CHARA, (CHARANUM-1)
		CALL BATTLE_START		
		FLAG:도주불가플래그 = 0
		FLAG:회화불능플래그 = 0
		FLAG:선제기습취소 = 0

		PRINTFORMW 「……제법、하잖냐。나호비노도 아닌 주제에……」
		PRINTFORML 
		PRINTFORMW 힘이 다한 로키가 스튜디오 바닥으로 추락한다。
		PRINTFORMW ……빌려 쓰는 스튜디오에 흠집을 내지 않으려고 신경 쓰고 있는 이쪽 입장도 좀 생각해라。
		PRINTFORML 
		PRINTFORMW 「어쩔 수 없지、너 같은 녀석이 버티고 있다면 당분간은 보류로군。
		PRINTFORMW 　하지만…… 네놈의 목숨도 영원하진 않아…… 언젠가 다할 날이 온다」
		PRINTFORML 
		PRINTFORMW 「난 그걸 기다리면 그만이지…… 기껏해야 오래오래 살아남아 보라고…… 잘 있어라」
		PRINTFORML 
		PRINTFORMW 거기까지 말하고서、로키는 마그네타이트가 되어 흩어져 사라졌다。
		PRINTFORML 
		PRINTFORMW 곁의 %CALLNAME:ARG%을(를) 보자、스튜디오 구석에 놓인 물푸레나무 바구니를 복잡한 표정으로 바라보고 있다。
		PRINTFORML 
		PRINTFORMW 「…………、저기」
		PRINTFORML 
		PRINTFORMW 뭘 하고 있느냐 %CALLNAME:ARG%。
		PRINTFORML 
		PRINTFORMW 「엣?」
		PRINTFORML 
		PRINTFORMW 걱정거리가 제 발로 찾아왔다가、심지어 제멋대로 해소되어 준 것이다。
		PRINTFORMW 그렇다면、지금부터 해야 할 일은 무엇인가。그렇게 묻자。
		PRINTFORML 
		PRINTFORMW 「……그래도 돼?」
		PRINTFORML 
		PRINTFORMW 스타를 목표로 한다면、본업에 뒤지지 않는 수련이 필요하다。
		SIF ABL:MASTER:가창기능 > ABL:ARG:가창기능
			PRINTFORMW 적어도、이쪽을 뛰어넘을 정도는 되어주지 않으면 곤란하다。
		PRINTFORMW ……쓸데없는 잡념에 넋을 놓고 있을 시간은 없다。
		SIF 大場ななの記憶:0:1 > 1
			PRINTFORMW 저 반짝임의 덩어리들은、그런 것쯤 진작에 무대를 향한 정열에 불살라 버렸을 테니까。
		PRINTFORML 
		PRINTFORMW ……%CALLNAME:MASTER%의 이야기를、푸른 눈을 깜빡거리며 듣고 있던 %CALLNAME:ARG%였으나、
		PRINTFORML 
		PRINTFORMW 일순 뒤를 돌아、양 볼을 짝 하고 치는 소리를 울리더니、
		PRINTFORML 
		PRINTFORMW 다시 돌아본 얼굴에서는、더 이상 망설임이 느껴지지 않았다。
		PRINTFORML 
		PRINTFORMW 「레슨 계속、부탁드립니다！」
		PRINTFORML 
		PRINTFORMW …………。
		PRINTFORML 
		PRINTFORMW %CALLNAME:ARG%와(과)、시간을 들여 가창 기능 훈련을 진행했다……。
		PRINTFORML 
		PRINTFORMW ……로키의 잔해에서、이전에 강탈당했던 것이라는 황금 사과를 발견했다。
			CALL LEARN_PU_SKILL(ARG,"黄金のリンゴ")
		PRINTFORMW %CALLNAME:ARG%의 『황금 사과』 사용 횟수가 증가했다。
		EXP:ARG:가창경험 += 50
			;CFLAG900を、ねらわれたイズンを１度でも完了しているかのフラグに使用。
			CFLAG:ARG:900 = 1
			;好感度以外は後に上昇値が表示される
			;CFLAG:ARG:(MASTER + 2100) += (好感度)
			;TCVAR:ARG:획득의존도 += 
			;TCVAR:ARG:획득충성도 += 
			;CALL ADDS_EXP("○○経験", 1, ARG)
			RETURN 1
	ENDIF
CASE 1
	;解放条件
	IF ARG:1 == 1
		;前イベントの　シアノとクレーンゲーム　既読後
		;SIF GETBIT(CFLAG:CAST:개별이벤트읽음,0)
		;	RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 
		ELSE
			;未開放時のタイトル（解放条件を入れておく）
			;RESULTS = (%CALLNAME:ARG%とクレーンゲームを見ている)
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		
		
		
		
		;好感度以外は後に上昇値が表示される
		;CFLAG:ARG:(MASTER + 2100) += (好感度)
		;TCVAR:ARG:획득의존도 += 
		;TCVAR:ARG:획득충성도 += 
		;CALL ADDS_EXP("○○経験", 1, ARG)
		RETURN 1
	ENDIF
ENDSELECT
RETURN 0