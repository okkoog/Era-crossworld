@SET_ACTION_コスモリアクターの担い手, ARG
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM SKILL_NUM,4

SKILL_NUM:0 = PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")
SKILL_NUM:1 = PU_SKILLNUM_GET(ARG,"無銘勝利剣")
SKILL_NUM:2 = PU_SKILLNUM_GET(ARG,"支援砲撃")
SKILL_NUM:3 = PU_SKILLNUM_GET(ARG,"銀河流星剣")

;3割になってから本気を出す
IF 現HP割合(ARG) < 33 && CFLAG:ARG:불사신플래그 == 1 || SKILLGAGE_F_GET(ARG,SKILL_NUM:0) > 99 && SKILLGAGE_D_GET(ARG,SKILL_NUM:0) < 1
	LOCAL = CFLAG:ARG:입력행동
	CFLAG:ARG:입력행동 = PU_SKILLNUM_GET(ARG,"ノウブル・ファンタズム")
	CALL PRINT_ACT_MESSAGE, ARG, SKILL_NUM:0
	CALL BATTLE_EVENT_ACT, ARG
	RESETCOLOR
	CALL SKILL_ACTION, SKILL_NUM, ARG
	CFLAG:ARG:입력행동 = LOCAL
	IF 現HP割合(ARG) < 33 && CFLAG:ARG:불사신플래그 == 1
		CFLAG:ARG:불사신플래그 = 0
		BASE:ARG:ＨＰ = MAXBASE:ARG:ＨＰ / 2
		PRINTFORMW ＞%CALLNAME:ARG%의 HP가 회복되었다!
	ENDIF
ELSEIF CFLAG:ARG:행동한횟수 == 0
	;魔力解放ゲージが2以下になったタイミングで宝具を撃つ
	IF SKILLGAGE_D_GET(ARG,SKILL_NUM:0) > 0 && SKILLGAGE_D_GET(ARG,SKILL_NUM:0) < 3
		CALL SET_ACTION_SKILL, ARG, SKILL_NUM:1
	ELSE
		SELECTCASE RAND:3
			CASE 0
				CALL SET_ACTION_SKILL,ARG,[[스킬:어둠속의기습]]
			CASE 1
				CALL SET_ACTION_SKILL,ARG,[[스킬:라이트스피어]]
			CASE 2
				CALL SET_ACTION_SKILL,ARG,[[스킬:마하에이하]]
		ENDSELECT
	ENDIF
ELSE
	SELECTCASE RAND:3
		CASE 0
			CALL SET_ACTION_SKILL,ARG,[[스킬:어둠속의기습]]
		CASE 1
			CALL SET_ACTION_SKILL,ARG,[[스킬:라이트스피어]]
		CASE 2
			CALL SET_ACTION_SKILL,ARG,[[스킬:마하에이하]]
	ENDSELECT
ENDIF
