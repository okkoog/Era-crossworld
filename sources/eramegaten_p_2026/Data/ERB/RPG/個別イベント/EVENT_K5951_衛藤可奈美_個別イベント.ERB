;-------------------------------------------------
;
;-------------------------------------------------
@INDIVIDUAL_EVENT_K5951, ARG, ARG:1 = 0, ARG:2 = -1
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）
#DIM HIYORI
;リストにキャラを表示する条件
IF ARG:1 == 0
	;イベント1で全部終了
	SIF GETBIT(CFLAG:ARG:개별이벤트읽음, 1)
		RETURN 0
	RETURN 1
ENDIF

SELECTCASE ARG:2





;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━━━━━━━
;〇可奈美イベントその１、習得スキルイベント
CASE 0

;━━━━━━━━━━━━━━━━
	;解放条件
	IF ARG:1 == 1
		;Lv50以上でないと起こらない
		SIF MAXBASE:ARG:LV < 50
			RETURN 0
		;所持金が25万円以上でないと起こらない
		SIF MONEY < 250000
    		RETURN 0

		;可奈美の保有MAGが50万以上でないと起こらない
		SIF GET_CHARA_STOCK_MAG(ARG:0) < 500000
    		RETURN 0
		;可奈美が隷属か親愛か娼婦でないと起こらない
		;「陥落()」は、陥落していなければゼロ、恋慕淫乱服従で１、親愛娼婦隷属で２、妻夫淫魔玩具で３、を返すので、「陥落(ARG:0)>=2」となる
		;……ので、2未満はダメ、で……陥落していないか、恋慕淫乱服従である場合はダメ、となる
		SIF 陥落(ARG:0) < 2
			RETURN 0
		;信頼系統の陥落はダメ
		SIF RESULTS == "신뢰"
			RETURN 0
		RETURN 1
;━━━━━━━━━━━━━━━━


;━━━━━━━━━━━━━━━━
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 無双神鳴斬
		ELSE
			;未開放時のタイトル（解放条件を入れておく）
			RESULTS = (LV50 이상、친애나 예속이나 창부、카나미의 보유 MAG 50만 이상、25만 엔 이상 소지)
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		;これで習得できる？
		CALL LEARN_PU_SKILL(ARG,"無双神鳴斬")
		PRINTFORMW ＞%CALLNAME:ARG%은(는) 무쌍신명참을 습득했다！
		;可奈美のMAGを-100000する
		;こっちだと-100万でマイナスになるようなMAG量でもちゃんと動く
		CALL CONTROL_MAG , ARG, - 500000
		;25万円消費する
		MONEY -= 250000
		RETURN 1
	ENDIF
;━━━━━━━━━━━━━━━━



;━━━━━━━━━━━━━━━━
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
















;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━━━━━━━
;〇可奈美イベントその２、リンケージスキル習得イベント
;　解放条件は、可奈美と姫和が双方ともに隷属か親愛か淫乱かそれ以上に陥落している
;　かつ、可奈美、姫和双方が保有MAG50万を超えている
CASE 1



;━━━━━━━━━━━━━━━━
	;解放条件
	IF ARG:1 == 1
	;━━━━━━━━━━
	;〇ここが可奈美のリンケージスキル条件
		;可奈美の保有MAGが50万以上でないと起こらない
		SIF GET_CHARA_STOCK_MAG(ARG:0) < 500000
			RETURN 0
		;Lv50以上でないと起こらない
		SIF MAXBASE:ARG:LV < 50
			RETURN 0
		;可奈美が隷属か親愛か娼婦でないと起こらない
		;「陥落()」は、陥落していなければゼロ、恋慕淫乱服従で１、親愛娼婦隷属で２、妻夫淫魔玩具で３、を返すので、「陥落(ARG:0)>=2」となる
		;……ので、2未満はダメ、で……陥落していないか、恋慕淫乱服従である場合はダメ、となる
		SIF 陥落(ARG:0) < 2
			RETURN 0
		;信頼系統の陥落はダメ
		SIF RESULTS == "신뢰"
			RETURN 0
		;可奈美の可奈美リンケージ習得フラグを参照する構文
		;（そうでないとリンケージスキルを習得してもまたこのイベントが出現してしまうと思う）
		;
		SIF GET_RPG_CFLAG_TAKEOVER(ARG, "可奈美リンケージ習得フラグ") >0
			RETURN 0


		;・姫和は登録番号を探さないといけない。GETCHARAで姫和の登録番号を取得し、変数HIYORIに収納
		HIYORI = GETCHARA([[キャラ:히요리]])
		;ここに姫和の条件

		;姫和の条件は
		;まず、姫和がいるかどうか
		;※姫和がいないと-1が返ってきてエラーの元になるので、「HIYORIが1以上なら」という条件をつけておく
		SIF HIYORI < 0
			RETURN 0
		;姫和が隷属か親愛か娼婦でないと起こらない
		;「陥落()」は、陥落していなければゼロ、恋慕淫乱服従で１、親愛娼婦隷属で２、妻夫淫魔玩具で３、を返すので、「陥落(ARG:0)>=2」となる
		;……ので、2未満はダメ、で……陥落していないか、恋慕淫乱服従である場合はダメ、となる
		;１，隷属か親愛か淫乱かそれ以上に陥落している
		;※とりあえず1を入れたが、純愛ルートなら最後に入れるのは2だ※
		SIF 陥落(HIYORI) < 2
			RETURN 0
		;４，姫和が信頼系統の陥落でない(ここで読み込む分にはRESULTSは姫和の陥落を読んでくれる？)
		SIF RESULTS == "신뢰"
			RETURN 0
		;２，姫和の保有MAGが50万以上
		SIF GET_CHARA_STOCK_MAG((HIYORI)) < 500000

			RETURN 0
		;３，姫和のLvが50以上
		SIF BASE:HIYORI:LV < 50
		;SIF BASE:HIYORI:LV < 5
			RETURN 0
		;５，たぶんこの辺に姫和の姫和リンケージ習得フラグを参照する構文が必要
		;（そうでないとリンケージスキルを習得してもまたこのイベントが出現してしまうと思う）
		SIF GET_RPG_CFLAG_TAKEOVER(HIYORI, "姫和リンケージ習得フラグ") >0
			RETURN 0







	


		;━━━━━━━━━━━━━━━
		;あなたの条件は
		;１，あなたが触手使役術を習得している
		;　式としてはあなたが触手使役術を習得して“いない”場合なので（“いる”なら返す値は1）
		SIF TALENT:MASTER:촉수사역술 < 1
			RETURN 0
		;━━━━━━━━━━━━━━━





	;━━━━━━━━━━
	;リンケージスキル習得イベントの条件をみんな書いたので RETURN 1 と書いておく。
	RETURN 1
;━━━━━━━━━━━━━━━━



;━━━━━━━━━━━━━━━━
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 극지의번개
		ELSE
			;未開放時のタイトル（解放条件を入れておく）
			RESULTS = (카나미와 히요리가 Lv50 이상이고 예속이나 친애나 음란이나 그 이상으로 함락되어 있으며、쌍방이 보유 MAG 50만 이상、당신이 촉수사역술 소지)
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
	;これで習得できる？

	;━━━━━━━━━━━━━━━
	;━━━━━━━━━━
	;━━━━━
	;〇条件を満たしてこのイベントを起こせるということは、リンケージ習得可能な条件を満たしていることになる。
	;　ということで、可奈美リンケージ習得フラグと姫和リンケージ習得フラグを1にする

	;多分この辺で可奈美と姫和のリンケージ習得フラグを変更する処理が必要
	;個別イベントではARGにその人物の登録番号が入る。よってARG=可奈美の登録番号
		CALL SET_RPG_CFLAG_TAKEOVER, ARG, "可奈美リンケージ習得フラグ", 1
		CALL SET_RPG_CFLAG_TAKEOVER, HIYORI, "姫和リンケージ習得フラグ", 1
	;━━━━━
	;━━━━━━━━━━
	;━━━━━━━━━━━━━━━



		PRINTFORMW ＞카나미와 히요리는 린케이지 스킬 극지의번개를 습득했다！
		
		
		
		;好感度以外は後に上昇値が表示される
		;CFLAG:ARG:(MASTER + 2100) += (好感度)
		;TCVAR:ARG:획득의존도 += 
		;TCVAR:ARG:획득충성도 += 
		;CALL ADDS_EXP("○○経験", 1, ARG)
		RETURN 1
	ENDIF
;━━━━━━━━━━━━━━━━



;━━━━━━━━━━━━━━━━
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

ENDSELECT
RETURN 0