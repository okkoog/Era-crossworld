;-------------------------------------------------
;リリテイルズ　ジル＝グランツ個別イベント
;-------------------------------------------------
@INDIVIDUAL_EVENT_K5384, ARG, ARG:1 = 0, ARG:2 = -1
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）

;リストにキャラを表示する条件
IF ARG:1 == 0
	;イベント0で全部終了
	SIF GETBIT(CFLAG:ARG:개별이벤트읽음, 0)
		RETURN 0
	RETURN 1
ENDIF

SELECTCASE ARG:2
CASE 0
	;解放条件
	;ジル＝グランツ陥落済み＋主人戦闘レベル５０以上。
	IF ARG:1 == 1
		SIF 陥落(ARG) == 0
			RETURN 0
		SIF BASE:MASTER:LV < 50
			RETURN 0
		RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = %CALLNAME:ARG%과(와) 루나리에＝엘＝블랑카(전투 있음?)
		ELSE
			;未開放時のタイトル（解放条件を入れておく）
			RESULTS = ※%CALLNAME:ARG%의 함락, %CALLNAME:MASTER%의 전투 Lv50 이상이 필요.
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		LOADGLOBAL
		PRINTFORML 
		PRINTFORML %CALLNAME:ARG%을(를) 데려오고 얼마 지나지 않았을 무렵.
		PRINTFORML 
		IF TALENT:ARG:신뢰 || TALENT:ARG:동료 || TALENT:ARG:연모 || TALENT:ARG:친애
			PRINTFORMW 「저기 %CALLNAME:MASTER%, 이건 사 가는 거야?」
			PRINTFORML 
			PRINTFORMW 오늘은 물품을 매입하러 가는 날이다.
			PRINTFORML 
			PRINTFORML 확인하러 오는 %CALLNAME:ARG%에게 대답을 돌려주자, 알았어~ 라며 느긋한 목소리를 내고,
			PRINTFORMW 구입 예정품 목록을 손에 든 채, 기분 좋게 필요 물품을 바구니에 담아 간다.
			PRINTFORML 
			PRINTFORMW ……제법 밝아진 모습이다.
			PRINTFORMW 혹은 이것이 그녀 본래의 성격인 것일까.
			PRINTFORMW 라그의 말에 따르면, 그녀는 『외지』에서 들여온 노예로 전직 왕녀였다고 한다.
			PRINTFORML 
			;多分これで陥落までは信頼方面だった、あるいは今も信頼状態の分岐になる。
			IF CFLAG:ARG:미조교함락 == 1
				PRINTFORML 끌려왔을 당시 떨고 있던 %CALLNAME:ARG%의 구속을 풀어주고,
				PRINTFORMW 너는 오늘부터 식당에서 일해야 한다, 고 말했을 때의 얼굴은 인상적이었다.
				PRINTFORML 
				PRINTFORML 그란츠 영국이라는 곳은 아무래도 중세의, 그것도 판타지에 가까운 세계인 듯하여,
				PRINTFORMW 처음에는 조리기구는커녕 세이프하우스 설비에조차 놀라 일일이 사용법을 설명해 주어야 했다.
				PRINTFORML 덧붙여 접객 상대에 악마도 섞여 있다는 것에는 놀라기는 했지만,
				PRINTFORMW 의사소통이 가능한 지적 생명체임을 알고 나서는 납득하여 순조롭게 넘어갔다.
				PRINTFORML 
				PRINTFORMW 게다가 왕녀 신분임에도 요리 소양을 갖추고 있던 것도 안성맞춤이었다.
				SIF ABL:ARG:요리기능 > 2 || CFLAG:ARG:요리인기 > 100
					PRINTFORMW 제법 뛰어난 순응력을 보여주어 지금은 어엿한 식당의 종업원이다.
				PRINTFORML 
				PRINTFORMW 「자, 이걸로 다 골랐어! 계산하러 갈까?」
				PRINTFORML 
				PRINTFORMW 현대에서는 원하는 물건을 일단 바구니에 담고, 계산대에서 대금을 지불함으로써 매매가 성립된다.
				PRINTFORMW ……고작 이런 일을, 그것도 방금 배운 참인데도 그 표정은 득의양양했다.
			;こっちは調教して恋慕・親愛にした。
			ELSE
				PRINTFORML 이렇게 외출할 수 있게 된 %CALLNAME:ARG%은(는),
				PRINTFORMW 조교를 받고 있을 때와는 전혀 다른 인상을 보여준다.
				PRINTFORML 
				;未開通
				IF ABL:ARG:Ａ감각 == 0 && ABL:ARG:Ｖ감각 == 0
					;お股の方が多い
					IF ABL:ARG:Ｂ감각 == 0 || (ABL:ARG:Ｂ감각 < 3 && ABL:ARG:Ｂ감각 < ABL:ARG:Ｃ감각)
						PRINTFORML 개발된 비소는 살짝 건드리기만 해도 흠뻑 젖어 들고,
						PRINTFORMW 때로는 스스로 비벼대며 쾌락에 빠져들기도 한다.
					;股がさほどでもなく胸を開発している。
					ELSEIF ABL:ARG:Ｃ감각 == 0 || (ABL:ARG:Ｃ감각 < 3 && ABL:ARG:Ｃ감각 < ABL:ARG:Ｂ감각)
