;-------------------------------------------------
;マンドリカルドイベント　スキル習得用の単発個別イベント　
;-------------------------------------------------
@INDIVIDUAL_EVENT_K5087, ARG, ARG:1 = 0, ARG:2 = -1
#LOCALSIZE 3
#LOCALSSIZE 1
;ARG:0　キャラ番号
;ARG:1　関数種類　1,開放条件　2,타이틀　3,이벤트
;ARG:2　イベント番号（0～63まで）

;リスト表示条件
IF ARG:1 == 0
	;0で全部終了
	SIF GETBIT(CFLAG:ARG:개별이벤트읽음, 0)
		RETURN 0
	SIF !GETS_USEABLE_EXTRA_TITLE("FATE")
		RETURN 0
	RETURN 1
ENDIF

SELECTCASE ARG:2
CASE 0
	;解放条件
	IF ARG:1 == 1
		;上位陥落してないと出てこない
		SIF 陥落(ARG) < 2 
			RETURN 0
		;マンドリカルドがLV60以上じゃないとダメ
		SIF BASE:ARG:LV < 60
			RETURN 0
		;マンドリカルドが忠誠度5000以上じゃないとダメ
		SIF GET_CHARA_LOYALTY(ARG) < 5000
			RETURN 0
		RETURN 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방, ARG:2)
			;타이틀
			RESULTS = 만드리카르도와의 유대
		ELSE
			;未開放時のタイトル（解放条件を入れておく）
			RESULTS = (%CALLNAME:ARG%이(가) LV60 이상、상위 함락 완료、충성도 5000 이상)
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		$INDIVIDUAL_EVENT_K5087_GOTO1
		CUSTOMDRAWLINE =
		PRINTFORML 
		PRINTFORML 
		PRINTFORMW %CALLNAME:ARG%이(가) 동료마가 된 지 얼마간 지난、어느 날의 낮 무렵。
		PRINTFORML 
		PRINTFORMW 자기 방에서 쉬고 있던 %CALLNAME:MASTER%에게로、%CALLNAME:ARG%이(가) 진지한 표정으로 찾아왔다。
		PRINTFORML 
		PRINTFORMW 「저기、잠깐 드릴 말씀이 있는데요…… 지금、시간 괜찮으심까?」
		PRINTFORML 
		PRINTFORMW 그 표정으로 보아 매정하게 내칠 수도 없었기에、상관없다고 답해주자 %CALLNAME:ARG%은(는) 안도의 한숨을 내쉬었다。
		PRINTFORML 
		PRINTFORMW 「죄송함다」
		PRINTFORML 
		PRINTFORML 꾸벅、가볍게 고개를 숙여 예를 표하는 %CALLNAME:ARG%에게 우선 들어오라고 재촉한다。
		PRINTFORML 소극적인 %CALLNAME:ARG%이(가) 스스로 이쪽 방으로 찾아오는 것은 드문 일이다。
		PRINTFORML 대우에 관한 요구나 상담거리라도 있는 것일까?
		PRINTFORMW 서서 이야기하기도 뭣해서 소파에 앉으라고 하자、한마디 양해를 구하고는 조심스레 걸터앉는다。
		PRINTFORML 
		PRINTFORMW 「저기、그게、말임다。……%CSTR:일인칭%、역시 처음엔 조교 같은 거 저항감이 심했거든요」
		PRINTFORML 
		PRINTFORM ……뭐 그야 그렇겠지、%CALLNAME:ARG%은(는) 
		IF TALENT:ARG:남자
			PRINTFORMW 남자다。
		ELSE
			PRINTFORMW 원래 남자였다。
		ENDIF
		PRINTFORML 설마 자기가 그런 대상이 되리라고는 생각도 못 했을 터다。
		PRINTFORMW 말을 고르듯 더듬거리며 이야기하는 %CALLNAME:ARG%에게、한 번 끄덕이며 맞장구를 쳐준다。
		PRINTFORML 
		PRINT 「하지만 지금은、
		;동료
		IF TALENT:ARG:181
			PRINTFORMW 이런 %CSTR:일인칭%한테도…… 친…… 친구처럼 대해주고 계시니까요」
		;친애
		ELSEIF TALENT:ARG:6
			PRINTFORMW 이런 %CSTR:일인칭%한테도…… 엄청 상냥하게 대해주고 계시니까요」
		;창부
		ELSEIF TALENT:ARG:7
			PRINTFORMW 이런 %CSTR:일인칭%한테도、그…… 엄청 기분 좋은 짓…… 해주고 계시니까요」
		;예속
		ELSEIF TALENT:ARG:8
			PRINTFORMW 이런 %CSTR:일인칭%이라도…… 제대로 써먹어 주고 계시니까요」
		ELSE
		ENDIF
		PRINTFORML 
		PRINTFORMW %CALLNAME:ARG%은(는) 조금 쑥스러운 기색으로 뺨을 긁적이더니、다시금 이쪽 얼굴을 똑바로 바라보았다。
		PRINTFORML 
		PRINTFORMW 「그러니까…… %CSTR:이인칭%에게라면、%CSTR:일인칭%의 목숨을 맡길 수 있겠다고」
		PRINTFORML 
		PRINTFORMW 「앗 아니！ 딱히 지금까지 %CSTR:이인칭%을(를) 신뢰하지 않았다는 건 아님다!?」
		PRINTFORML 
		PRINTFORMW 자신의 말에 %CALLNAME:ARG%이(가) 당황하며 얼굴 앞에서 크게 손을 내젓는다。
		PRINTFORML 
		PRINTFORMW 「요컨대 어ー 그러니까、무슨 말이 하고 싶은 거냐면요……」
		PRINTFORML 
		PRINTFORML 「이런 %CSTR:일인칭%이라도 괜찮다면、전투에 내보내 주시면 확실하게 %CSTR:이인칭%을(를) 지키겠슴다」
		PRINTFORML 「전투 외적으로도、%CSTR:일인칭%이 할 수 있는 한 무엇이든 하겠슴다！」
		PRINTFORMW 「그러니까、내치지 마시고 앞으로도 데리고 써먹어 주십쇼！」
		PRINTFORML 
		PRINTFORML 소파에서 기운차게 벌떡 일어나、그렇게 말하며 고개를 숙이고 이쪽으로 오른손을 내밀어 온다。
		PRINTFORML 자、이쪽은……

		$INPUT_LOOP1
		PRINTFORML [0] 그 손을 잡는다
		SETCOLOR 0xff0033
		PRINTFORML [1] 그 손을 거부한다
		RESETCOLOR
		INPUT
		SELECTCASE RESULT
			CASE 0
			PRINTFORML 
			PRINTFORML 이쪽도 일어서서、마찬가지로 손을 내밀어 %CALLNAME:ARG%의 손을 맞잡아 주었다。
			PRINTFORMW 순간、%CALLNAME:ARG%의 얼굴이 환하게 밝아진다。
			PRINTFORML 
			PRINTFORMW 「엣…… 저、정말로요? %CSTR:일인칭%의 진심을、받아주시는 검까……읏」
			PRINTFORML 
			PRINTFORML 직후、%CALLNAME:ARG%은(는) 감격에 겨운 기색을 보이며、기쁜 미소를 띄우면서도 눈가에 살짝 눈물을 글썽였다。
			PRINTFORMW %CALLNAME:MASTER%와의 유대를 새삼 통감한 %CALLNAME:ARG%와(과)、한동안 담소를 나누며 시간을 보냈다……。
			PRINTFORML 
			PRINTFORML 
			PRINTFORML …………
			PRINTFORML ……
			PRINTFORMW …
			PRINTFORML 

			;스킬『剣は折れて』습득
			ABL:ARG:스킬12 = [[스킬:전용기7]]
			CSTR:ARG:전용기7 = 剣は折れて

			PRINTFORML ＞【유대를 깊이 하여 %CALLNAME:ARG%이(가) 결의를 새로이 했으므로、
			PRINTFORMW 　　새로운 스킬 『부러진 검』을 습득했습니다】
			PRINTFORML 
			PRINTFORML ＞【스킬：부러진 검
			PRINTFORMW 　　자동 효과：자신이 전투불능이 되면、남은 아군 전원의 공격과 방어를 상승시킨다】
			PRINTFORML 
			PRINTFORML 

			RETURN 1
			CASE 1
			PRINTFORML 
			PRINTFORML 소파에 앉은 채 물끄러미 바라보며、내밀어진 그 손을 잡지 않고 거부했다。
			PRINTFORML 그 사실을 이해한 순간、%CALLNAME:ARG%은(는) 눈을 크게 뜨며 멍해지더니、이내 얼굴에 절망의 빛을 띄웠다。
			PRINTFORMW 그리고、%CALLNAME:MASTER%와(과) %CALLNAME:ARG%은(는) 주인과 노예다、그런 말을 들어도 곤란하다、라고 딱 잘라 일러주었다。
			PRINTFORML 
			PRINTFORMW 「앗…… 그、그렇죠！ %CSTR:일인칭% 따위가 헛소리를 지껄여서、죄송했슴다……」
			PRINTFORML 
			PRINTFORMW 억지로 지어낸 듯한 미소로 그렇게 말하더니、%CALLNAME:ARG%은(는) 축 처진 어깨로 풀이 죽어 돌아갔다。
			PRINTFORML 
			PRINTFORML 
			PRINTFORML …………
			PRINTFORML ……
			PRINTFORMW …
			PRINTFORML 
			;동료
			IF TALENT:ARG:181
				PRINTFORMW ＞【%CALLNAME:ARG%이(가) 절망했으므로、%CALLNAME:ARG%이(가) 【동료】를 잃었습니다】
				TALENT:ARG:181 = 0
			;친애
			ELSEIF TALENT:ARG:6
				PRINTFORMW ＞【%CALLNAME:ARG%이(가) 절망했으므로、%CALLNAME:ARG%이(가) 【친애】를 잃었습니다】
				TALENT:ARG:6 = 0
			ELSE
			ENDIF

			PRINTFORML 　
			PRINTFORML ＞【%CALLNAME:ARG%이(가) 실망했으므로、충성도가 3000 하락했습니다】
			BASE:ARG:10 -= 3000
			PRINTFORML 
			PRINTFORML 

			RETURN 1
			CASEELSE
				GOTO INPUT_LOOP1
		ENDSELECT
	ENDIF
CASE 1
	;解放条件
	IF ARG:1 == 1
	ELSEIF ARG:1 == 2
	;타이틀
		IF GETBIT(CFLAG:ARG:개별이벤트개방,ARG:2)
			;타이틀
			RESULTS = 
		ELSE
		ENDIF
	;이벤트
	ELSEIF ARG:1 == 3
		RETURN 1
	ENDIF
ENDSELECT
RETURN 0


