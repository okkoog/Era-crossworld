@SET_ACTION_マルフーシャ個別イベント_自爆ボール, ARG
IF CFLAG:ARG:997 >= 1
	;자폭(비)
	CFLAG:ARG:입력행동 = 3659
	CFLAG:ARG:타겟 = -1
	FOR LOCAL,6,0,-1
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS < 0
			CONTINUE
		;国境門
		SIF NO:(FLAG:LOCALS) != [[キャラ:국경문]]
			CONTINUE
		SIF CFLAG:(FLAG:LOCALS):상태이상 == GET_STATE_NUM("DYING")
			CONTINUE
		CFLAG:ARG:타겟 = LOCAL
	NEXT
	IF CFLAG:ARG:타겟 == -1
		$TARGET_LOOP
		CALL RANDOM_TARGET,ARG,CFLAG:ARG:입력행동
		SIF CFLAG:ARG:타겟 == -1
			GOTO TARGET_LOOP
	ENDIF
ELSE
	CFLAG:ARG:997 ++
	CSTR:ARG:더미스킬명 = 急速に近づく
	CFLAG:ARG:입력행동 = 2305;DUMMY
	CFLAG:ARG:타겟 = 5
ENDIF
RETURN 1

