@マルフーシャ個別イベント_人員補充, ARG, ARG:1
;ARG:0　マルフーシャ
;ARG:1　仲間番号
#DIM 計算用変数
LOCAL = -1
LOCAL:1 = -1
LOCAL:2 = -1
FOR 計算用変数, 1, 7
	LOCALS = 포지션{計算用変数} 
	IF FLAG:LOCALS < 0
		LOCAL:1 = 計算用変数
		BREAK
	ENDIF
NEXT
IF LOCAL:1 == -1
	FOR 計算用変数, 1, 7
		LOCALS = 포지션{計算用変数} 
		IF (ABL:(FLAG:LOCALS):종족 || NO:(FLAG:LOCALS) == [[キャラ:메어리]] ) && (FLAG:LOCALS) != MASTER && NO:(FLAG:LOCALS) != [[キャラ:마르푸샤]] && NO:(FLAG:LOCALS) != [[キャラ:라이카_Marufusha]] && NO:(FLAG:LOCALS) != [[キャラ:벨카_Marufusha]] && NO:(FLAG:LOCALS) != [[キャラ:스트렐카_Marufusha]] && NO:(FLAG:LOCALS) != [[キャラ:펠리세트]] && NO:(FLAG:LOCALS) != [[キャラ:알리비나]] && NO:(FLAG:LOCALS) != [[キャラ:비온]] && NO:(FLAG:LOCALS) != [[キャラ:에노스]]
			LOCAL:1 = 計算用変数
			;LOCAL:2にどかすキャラを入れる
			LOCAL:2 = POS(計算用変数)
			;ポジションから外す
			CALL REMOVE_POSITION(計算用変数)
			BREAK
		ENDIF
	NEXT
ENDIF
LOCAL = GETCHARA(ARG:1)
;キャラを加入させる
IF LOCAL >= 0
	IF LOCAL:1 >= 0
		CFLAG:LOCAL:이자리에없는플래그 = 0
		CALL INSERT_POSITION, LOCAL:1, LOCAL
	ENDIF
ELSE
	CALL ADD_NEW_COMPANION, ARG:1 , 1000
	LOCAL = GETCHARA(ARG:1)
	CFLAG:LOCAL:게스트가입플래그 = 1
	SIF LOCAL:1 >= 0
		CALL INSERT_POSITION, LOCAL:1, LOCAL
ENDIF
IF CFLAG:LOCAL:게스트가입플래그 == 1
	EQUIP:LOCAL:총 = EQUIP:ARG:총
	EQUIP:LOCAL:머리 = EQUIP:ARG:머리
	EQUIP:LOCAL:몸통 = EQUIP:ARG:몸통
	EQUIP:LOCAL:팔 = EQUIP:ARG:팔
	EQUIP:LOCAL:발 = EQUIP:ARG:발
	EQUIP:LOCAL:악세서리 = EQUIP:ARG:악세서리
	
	BASE:LOCAL:힘 = BASE:LOCAL:힘 + MAX(BASE:ARG:LV-BASE:LOCAL:LV,0) / 4
	BASE:LOCAL:지혜 = BASE:LOCAL:지혜 + MAX(BASE:ARG:LV-BASE:LOCAL:LV,0) / 2
	BASE:LOCAL:마력 = BASE:LOCAL:마력 + MAX(BASE:ARG:LV-BASE:LOCAL:LV,0) / 5
	BASE:LOCAL:내구 = BASE:LOCAL:내구 + MAX(BASE:ARG:LV-BASE:LOCAL:LV,0) / 3
	BASE:LOCAL:속도 = BASE:LOCAL:속도 + MAX(BASE:ARG:LV-BASE:LOCAL:LV,0) / 2
	BASE:LOCAL:운 = BASE:LOCAL:운 + MAX(BASE:ARG:LV-BASE:LOCAL:LV,0) / 2
	BASE:LOCAL:LV = BASE:ARG:LV
	
	IF FLAG:전투난이도 > 3
		BASE:LOCAL:속도 += BASE:ARG:LV / 5
		BASE:LOCAL:운 += BASE:ARG:LV / 5
	ENDIF
	IF FLAG:전투난이도 > 4
		BASE:LOCAL:지혜 += BASE:ARG:LV / 5
		BASE:LOCAL:내구 += BASE:ARG:LV / 5
	ENDIF
	
	;専用スキル封印
	ABL:LOCAL:스킬1 = [[스킬:장비지식Lv5]];장비지식Lv5
	CSTR:LOCAL:전용기1 = 
	ABL:LOCAL:스킬2 = [[스킬:아이템숙련]];아이템숙련
	CSTR:LOCAL:전용기2 = 
	ABL:LOCAL:스킬3 = [[스킬:삼할의활천]];삼할의활천
	CSTR:LOCAL:전용기3 = 
	ABL:LOCAL:스킬4 = [[스킬:삼할의마맥]];삼할의마맥
	CSTR:LOCAL:전용기4 = 
	
	;スキル習得判定
	FOR 計算用変数,1,21
		IF ABL:LOCAL:("습득스킬"+TOSTR(計算用変数)) > 0
			FOR LOCAL:1,1,FLAG:이능자스킬수+1
				LOCALS = 스킬{LOCAL:1}
				IF ABL:LOCAL:LOCALS < 1
					LOCALS:1 = %LOCALS%
					BREAK
				ENDIF
			NEXT
			ABL:LOCAL:(LOCALS:1) = ABL:LOCAL:("습득스킬"+TOSTR(計算用変数))
			ABL:LOCAL:("습득스킬"+TOSTR(計算用変数)) = 0
			ABL:LOCAL:("습득LV"+TOSTR(計算用変数)) = 0
		ENDIF
	NEXT
ENDIF
CALL SYNC_STATUS,LOCAL
CALL HEALTH_CHARA,LOCAL

