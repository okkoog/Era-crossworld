;-----------------------------------------------------------
;レベルサーチ
;-----------------------------------------------------------
@マルフーシャ個別イベント_レベルサーチ, ARG
#FUNCTION
SELECTCASE FLAG:진행중개별이벤트
	CASE 1
		RETURNF LIMIT(BASE:ARG:LV, 5, 10)
	CASE 2
		RETURNF LIMIT(BASE:ARG:LV, 15, 25)
	CASE 3
		RETURNF LIMIT(BASE:ARG:LV, 30, 45)
	CASE 4
		;レベルは自軍最大値（最低値50）
		LOCAL:2 = 0
		FOR LOCAL , 1 , 7
			;LOCALSにポジションにいるキャラを取得
			LOCALS = 포지션{LOCAL}
			LOCAL:1 = FLAG:LOCALS
			SIF LOCAL:1 < 0
				CONTINUE
			LOCAL:2 = MAX(LOCAL:2, BASE:(LOCAL:1):LV)
		NEXT
		RETURNF LIMIT(LOCAL:2, 50, 60)
	CASEELSE
		RETURNF BASE:ARG:LV
ENDSELECT


;=========================================================
;	リソースの表示
;	表示後サイズに合わせて改行を行う
;	PRINT_IMG の拡張みたいな感じ　文中の挿絵的に使えると思う
;
;	sRes_Name	：リソースの名前文字列
;	iSize		：一行の高さに対するサイズ％数値　縦基準　縦横比維持　省略で1000(10倍)
;	sAlign		：align属性　省略で左寄せ　left, center, rightの三種が指定できます
;=========================================================
@PRINT_IMAGE(sRes_Name,iSize=1000,sAlign="left")
#DIMS sRes_Name
#DIM iSize
#DIMS sAlign
#DIM SpaceLength
#DIMS sPrint_Text
#DIM iEnter_Con
#DIM iFont_Hei_mag

SIF GETCONFIGS("描画インターフェース") == "WINAPI"
	THROW 描画インターフェースをTextRendererに変更して下さい

SIF sRes_Name == ""
	RETURN RESULT

iEnter_Con = 0
iFont_Hei_mag = GETCONFIG("一行の高さ") * iSize*10 / GETCONFIG("フォントサイズ")
iFont_Hei_mag = (iFont_Hei_mag/10) + (iFont_Hei_mag%10 >= 5?1#0)

HTML_PRINT @"<p align='%sAlign%'><nobr><img src='%sRes_Name%' height='{iFont_Hei_mag}'>"
iEnter_Con++

FOR LOCAL,iEnter_Con-1,(iSize/100)-1
	HTML_PRINT "<br>"
NEXT
RETURN RESULT

;================================================================
; 流れる文字 + 画像表示
; 指定した文字列を左から右へロール表示する
;--------------------------------
; 引数
;	strText		: 表示文字列
;	nFinishWait	: 終了時の待ち時間
;					数値     msec
;	ARG      	: キャラ番号（EVENT_K5355_アキュラ_個別イベント.ERB　　@PRINT_ICON）
;	ARG:1    	: 画像番号（EVENT_K5355_アキュラ_個別イベント.ERB　　@PRINT_ICON）
;	sAlign    	: align属性　省略で左寄せ　left, rightの二種が指定できます　全角文字に限定される
;================================================================
@ANIMATION_ROLL_TEXT( strText, nFinishWait = 500, ARG = -1, ARGS, sAlign = "left" )
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_LINE
#DIMS DYNAMIC strText
#DIM DYNAMIC nWaitCount
#DIM DYNAMIC nFinishWait
#DIM DYNAMIC nTextLen
#DIMS DYNAMIC strTextBuf
#DIM DYNAMIC nLineCount
#DIMS DYNAMIC sAlign
#DIM DYNAMIC IS_SKIP
#DIM DYNAMIC IS_WAIT
#DIM DYNAMIC L_REDRAW

IF sAlign == "right" || sAlign == "RIGHT"
	ALIGNMENT RIGHT
ELSE
	ALIGNMENT LEFT
ENDIF
SIF LINEISEMPTY() == 0
	PRINTL 
SIF ARG >= 0 && ARGS != ""
	CALL PRINT_FACE_BY_CSV, ARG, ARGS
L_REDRAW = CURRENTREDRAW()
REDRAW 0
L_LINE = LINECOUNT
WHILE STRLENS(strText) > LCOUNT && IS_SKIP == 0 && IS_WAIT == 0
	CLEARLINE LINECOUNT - L_LINE
	;右クリックとESCのおしっぱはスキップ相当
	IF MESSKIP()
		REDRAW L_REDRAW
		IS_SKIP = 1
		BREAK
	ELSE
		PRINTFORML %SUBSTRING(strText, 0, LCOUNT + 1)%
	ENDIF
	INPUTMOUSEKEY GETKEY(2) || GETKEY(27) ? 5 # 100
	;マウス
	IF RESULT:0 == 1
		SELECTCASE RESULT:1
			CASE 0x100000
				CLEARLINE 1
				PRINTFORML %strText%
				IS_WAIT = 1
			CASE 0x200000
				CLEARLINE 1
				PRINTFORML %strText%
				IS_SKIP = 1
		ENDSELECT
	;キーボード
	ELSEIF RESULT:0 == 3
		IF CONVERT_KEYCORD_TO_STR(RESULT:1) == "ESC"
			CLEARLINE 1
			PRINTFORML %strText%
			IS_SKIP = 1
		ELSE
			CLEARLINE 1
			PRINTFORML %strText%
			IS_WAIT = 1
		ENDIF
	ENDIF
	IF GETKEY(2) || GETKEY(27)
		LCOUNT += 2
	ELSE
		LCOUNT += 1
	ENDIF
WEND

CLEARLINE LINECOUNT - L_LINE
PRINTFORML %strText%

SIF sAlign == "right" || sAlign == "RIGHT"
	ALIGNMENT LEFT
REDRAW L_REDRAW

IF !IS_SKIP
	IF IS_WAIT
		WAIT
	ELSE
		IF (GETKEY(2) || GETKEY(27))
			INPUTMOUSEKEY 10
		ELSE
			TWAIT nFinishWait, 0
		ENDIF
	ENDIF
ENDIF
RETURN

;--------------------------------------------------
; ローディング
;	指定した文字列の後に'.'を表示するループ（'.'の数は時間経過で増減する）
;--------------------------------
;	strText		: ローディング時の表示文字列（"Now Loading"など）
;	nWaitCount	: 待機回数（待機回数×50msec）
;--------------------------------------------------
@ANIMATION_LOAD( strText, nWaitCount )
	#DIMS strText
	#DIM nWaitCount
	#DIM nLoop
	#DIM nPeriod
	#DIM nRedrawMem
	#DIM nColorMem

	nColorMem = GETCOLOR()
	nRedrawMem = CURRENTREDRAW()

	SIF LINEISEMPTY() == 0
		PRINTL

	REDRAW 0
	PRINTL
	FOR nLoop, 0, nWaitCount
		nPeriod = (nLoop / 2) % 4
		CLEARLINE 1
		LOCAL = CALC_OSCILLATION_VALUE( 0x10 * nLoop, 0xFF - 0x44 )
		SETCOLOR 0x444444 + (0x010101 * LOCAL)
		PRINTFORM %strText%%"."*nPeriod%
		TWAIT 50, (nLoop == 0)
	NEXT

	REDRAW nRedrawMem
	SETCOLOR nColorMem
	CLEARLINE 1
	PRINTL 

	RETURN
