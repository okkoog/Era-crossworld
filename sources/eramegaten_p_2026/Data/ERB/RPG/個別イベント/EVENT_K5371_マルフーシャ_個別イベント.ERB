@SET_ACTION_マルフーシャ個別イベント_攻城用AI, ARG
#DIM ループ回数
IF CFLAG:ARG:997 >= 2
	ループ回数 = 0
	;ランダム行動
	$DECIDE_ACTION
	CALL ランダム行動, ARG
	IF RESULT > 0
		ループ回数 ++
		;ここでスキル番号を行動内容に代入
		IF CFLAG:ARG:타겟 == -1
			GOTO DECIDE_ACTION
		;門がある限り、敵はマルフーシャを攻撃しない
		ELSEIF GETCHARA([[キャラ:마르푸샤]]) > -1 && CFLAG:ARG:타겟 == CPOS(GETCHARA([[キャラ:마르푸샤]]))
			IF ループ回数 >= 50
				CFLAG:ARG:입력행동 = -1
				CFLAG:ARG:방어플래그 = 1
				RETURN 1
			ENDIF
			SIF GETCHARA([[キャラ:국경문]]) > -1 && CFLAG:GETCHARA([[キャラ:국경문]]):상태이상 != GET_STATE_NUM("DYING")
				GOTO DECIDE_ACTION
		ENDIF
		;CFLAG:ARG:입력행동 = LOCAL:1
	ENDIF
ELSE
	CFLAG:ARG:997 ++
	CSTR:ARG:더미스킬명 = 近づく
	CFLAG:ARG:입력행동 = 2305;DUMMY
	CFLAG:ARG:타겟 = 5
ENDIF
RETURN 1

