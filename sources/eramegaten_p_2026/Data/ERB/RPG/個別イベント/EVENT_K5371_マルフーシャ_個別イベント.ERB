;戦闘開始時
@EVENT_BATTLE_START_INDIVIDUALEVENT_K5371
SELECTCASE FLAG:진행중개별이벤트
	CASE 1 TO 3
		PRINTL 
		PRINTW 적이 나타났다!
		PRINTL 
		IF FLAG:진행중개별이벤트 == 2
			;箱型レーザー兵器戦
			FOR LOCAL:1,7,17
				LOCALS = 포지션{LOCAL:1}
				SIF FLAG:LOCALS < 0
					CONTINUE
				;箱型レーザー兵器
				SIF NAME:(FLAG:LOCALS) != "箱型レーザー兵器"
					CONTINUE
				;死んだ！
				SIF GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "DYING" || GET_STATE(CFLAG:(FLAG:LOCALS):상태이상) == "STONE"
					CONTINUE
				PRINTFORM ＞상자형 레이저 병기는 장갑으로 코어를 지키고 있다!
