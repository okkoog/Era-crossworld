	IF RAND:30 == 0
		CALL CURSE_CHIKUWA
		RESTART
	ELSE
		CALL CURSE
		RESTART
	ENDIF
ENDIF

ALIGNMENT CENTER
FOR LOCAL , 0 , 50
	CLEARLINE LINECOUNT
	SETCOLOR 255 * MIN(LOCAL , 30) / 30 , 255 * MIN(LOCAL , 30) / 30 , 255 * MIN(LOCAL , 30) / 30
