PRINTFORML Ver %TOSTR(TEMP_GAMEVASE_VERSION / 100 / 100, "0")%.%TOSTR(TEMP_GAMEVASE_VERSION / 100 % 100, "0")%.%TOSTR(TEMP_GAMEVASE_VERSION % 100 % 100, "0")%
