$INPUT_LOOP
INPUT
IF RESULT == 0
	CLEARLINE LINECOUNT
	DRAWLINE
	RESETDATA
	ADDCHARA 0
	BEGIN FIRST
ELSEIF RESULT == 1
	DRAWLINE
	CLEARLINE LINECOUNT
	CALL TITLE_LOADGAME
	GOTO PRINT_TITLE
ELSEIF RESULT == 2
	IF LAST_ACCESS_SAVE_NO > 0
		CHKDATA LAST_ACCESS_SAVE_NO - 1
		IF !RESULT
			CLEARLINE LINECOUNT
			LOADDATA LAST_ACCESS_SAVE_NO - 1
		ENDIF
	ENDIF
	GOTO INPUT_LOOP
ELSEIF RESULT == 999
	HIDE_KOJO_UPDATE_ANNOUNCEMENT = !HIDE_KOJO_UPDATE_ANNOUNCEMENT
	SAVEGLOBAL
	CLEARLINE LINECOUNT - L_LINE
	GOTO SHOW_SELECT
ELSEIF RESULT == 9
	CHKDATA SAVEDATA_NUM_FOR_CONTINUE
	SIF RESULT
		GOTO INPUT_LOOP
	CLEARLINE LINECOUNT
	LOADDATA SAVEDATA_NUM_FOR_CONTINUE
ELSE
	GOTO INPUT_LOOP
ENDIF

@DEMO_PRINT , ARGS = "" , ARG , ARG:2 = 0
IF ARG:2 == 1
	VARSET LOCALS , " " * 80
	LOCAL:1 = 0
	RETURN -1
ENDIF
;表示されているものを一旦消去
;SIF LOCAL:1 > 0
;	CLEARLINE LINECOUNT
;空文字列を渡された場合は、全部表示して終わり
IF ARGS == ""
	;直前までの行のメッセージをボタンで表示
	FOR LOCAL:2 , 0 , 10
		PRINTBUTTON " " * 80 , "1"
		PRINTL
	NEXT
	FOR LOCAL:2,0,LOCAL:1
		PRINTBUTTON (LOCAL:2 == 0 ? "" # " " * 8) + LOCALS:(LOCAL:2) + " " * (72 - STRLENSU(LOCALS:(LOCAL:2))) , "1"
		PRINTL
	NEXT
	RETURN -1
ENDIF
FOR LOCAL , 0 , STRLENSU(ARGS)
	;直前までの行のメッセージをボタンで表示
	FOR LOCAL:2 , 0 , 10
		PRINTBUTTON " " * 80 , "1"
		PRINTL
	NEXT
	FOR LOCAL:2,0,LOCAL:1
		PRINTBUTTON (LOCAL:2 == 0 ? "" # " " * 8) + LOCALS:(LOCAL:2) + " " * (72 - STRLENSU(LOCALS:(LOCAL:2))) , "1"
		PRINTL
	NEXT
	;ここまで前の行
	PRINTBUTTON (LOCAL:1 == 0 ? "" # " " * 8) + (SUBSTRINGU(ARGS, 0, LOCAL) + "_") , 1
	PRINTL
	FOR LOCAL:2,0, 29 - LOCAL:1
		PRINTBUTTON " " * 80 , "1"
		PRINTL
	NEXT
	;[クリックorEnter待ち]表示
	A = (GETMILLISECOND()) % 3000
	A =  255 * ( A > 1500 ? (3000 - A) # (A) ) / 1500
	SETCOLOR A , A , 0
	ALIGNMENT CENTER
	PRINTBUTTON " " * 27 +  "[Click or Hit Return key]" + " " * 27 , "1"
	PRINTL
	SETCOLOR 255,255,0
	ALIGNMENT LEFT
	;描画パート1終わり
	;TINPUTS 100 , "-1" , 0
	;IF RESULTS != "-1"
	;	CLEARLINE LINECOUNT
	;	RETURN 1
	;ENDIF
	INPUTMOUSEKEY 100
	SIF RESULT != 4
		RETURN 1
	RESULT = 0
	CLEARLINE LINECOUNT
NEXT
FOR LOCAL,0 , ARG/100
	;直前までの行のメッセージをボタンで表示
	FOR LOCAL:2 , 0 , 10
		PRINTBUTTON " " * 80 , "1"
		PRINTL
	NEXT
	FOR LOCAL:2,0,LOCAL:1
		PRINTBUTTON (LOCAL:2 == 0 ? "" # " " * 8) + LOCALS:(LOCAL:2) + " " * (72 - STRLENSU(LOCALS:(LOCAL:2))) , "1"
		PRINTL
	NEXT
	;ここまで前の行
	PRINTBUTTON (LOCAL:1 == 0 ? "" # " " * 8) + ARGS + (LOCAL%2 == 0 ? "_" # " ") + (79-STRLENS(ARGS)) * " ", "1"
	PRINTL
	FOR LOCAL:2,0, 29 - LOCAL:1
		PRINTBUTTON " " * 80 , "1"
		PRINTL
	NEXT
	;[クリックorEnter待ち]表示
	A = (GETMILLISECOND()) % 3000
	A =  255 * ( A > 1500 ? (3000 - A) # (A) ) / 1500
	SETCOLOR A , A , 0
	ALIGNMENT CENTER
	PRINTBUTTON " " * 27 +  "[Click or Hit Return key]" + " " * 27 , "1"
	PRINTL
	SETCOLOR 255,255,0
	ALIGNMENT LEFT
	;描画パート2終わり
	;TINPUTS 100, "-1" , 0
	;IF RESULTS != "-1"
	;	CLEARLINE LINECOUNT
	;	RETURN 1
	;ENDIF
	INPUTMOUSEKEY 100
	SIF RESULT != 4
		RETURN 1
	RESULT = 0
	CLEARLINE LINECOUNT
NEXT
RESULT = 0
PRINTBUTTON (LOCAL:1 == 0 ? "" # " " * 8) + ARGS+ (80-STRLENS(ARGS)) * " ", "1"

LOCALS:(LOCAL:1) = %ARGS%
LOCAL:1 += 1
FOR LOCAL,0, 31 - LOCAL:1
	PRINTFORML %" " * 80%
NEXT
RETURN -1

