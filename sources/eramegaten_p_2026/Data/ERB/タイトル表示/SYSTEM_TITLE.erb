		HTML_PRINT @"<div xpos = '{50 * (STRLENS(DRAWLINESTR) - 40) - 80}' ypos = '-200'>" + SET_BUTTON_TAG(SET_COLOR_TAG("[구상 미적용]", "p-green") + "<br>" + "적용방법에 대해서는"+ "<br>" + "「구상적용방법.txt」를 참조해 주십시오.", "999") + "</div>"
