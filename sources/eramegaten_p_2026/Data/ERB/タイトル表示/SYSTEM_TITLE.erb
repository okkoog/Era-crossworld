	A =  255 * ( A > 1500 ? (3000 - A) # (A) ) / 1500
	SETCOLOR A , A , 0
	PRINTBUTTON " " * 27 +  "[Click or Hit Return key]" + " " * 27 , "1"
	PRINTL
