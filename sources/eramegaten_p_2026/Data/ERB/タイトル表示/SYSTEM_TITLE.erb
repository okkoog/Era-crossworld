		PRINTBUTTON " " * 80 , "1"
		PRINTL
	NEXT
	;[クリックorEnter待ち]表示
	A = (GETMILLISECOND()) % 3000
	A =  255 * ( A > 1500 ? (3000 - A) # (A) ) / 1500
	SETCOLOR A , A , 0
	ALIGNMENT CENTER
	PRINTBUTTON " " * 27 +  "[Click or Hit Return key]" + " " * 27 , "1"
	PRINTL
	SETCOLOR 255,255,0
	ALIGNMENT LEFT
	;TINPUTS 100 , "-1" , 0
	;IF RESULTS != "-1"
	;	CLEARLINE LINECOUNT
	;	RETURN 1
	;ENDIF
	INPUTMOUSEKEY 100
	SIF RESULT != 4
		RETURN 1
