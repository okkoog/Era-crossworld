;
;	Module		:TITLE_STOCK.ERB
;	Facility	:タイトル画面に表示されるAAと画像を一元化
;
;	Licence		:ライセンスフリー
;
;	Modification Data:
;
;	Edit	Date			Author					Reason
;	001		2022/08/19		餅呑					新規作成　コンセプトはだれでも簡単にタイトル画面を追加できるシステム
;	002		2022/08/30		JK好き					resourcesフォルダのタイトル画像数を感知してタイトル画像表示を64枚まで自動で対応出来るように改造
;	003		2023/08/28		P(bazzile)				表示システムを変更。画像のCSV登録方法も変更しているので注意してください
;
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
@PRINT_TITLE
#DIM DYNAMIC LCOUNT, 2
#DIM L_PICTURE_SIZE = 30;画像のサイズ(縦のフォントいくつ分に相当するか)
#DIM DYNAMIC TITLE_LIST, TITLE_PICTURE_NUM * 5
#DIMS DYNAMIC FACE_LIST, 10
#DIM DYNAMIC FACE_POS, 10, 2
#DIM DYNAMIC FACE_SIZE
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC GID
#DIMS DYNAMIC SHOW_LINE
#DIM DYNAMIC TITLE_NO = -1
#DIMS DYNAMIC TEMP_ICON
#DIMS DYNAMIC FACE_LINE
#DIM DYNAMIC CNT_TITLE_PICTURE
#DIM DYNAMIC L_PRIORITY
#DIMS DYNAMIC L_TOOLTIP

;EX作品のタイトル名をここでセットしておく
CALL SET_EXTRA_TITLE_VAR

;画像をリスト化
GID = TEMP_GID_START
FOR LCOUNT, 0, VARSIZE("TITLE_LIST")
	;タイトル表示条件がある場合 またついでに優先度をとる
	TRYCCALLFORM IS_TITLE_USEABLE_{LCOUNT}
		SIF !RESULT
			CONTINUE
		L_PRIORITY = RESULT
	CATCH
		L_PRIORITY = 1
	ENDCATCH
	WHILE GCREATED(GID)
		GID++
	WEND
	SIF !GCREATEFROMFILE(GID, "タイトル画像\\タイトル" + TOSTR(LCOUNT, "000") + ".webp")
		CONTINUE
	SPRITECREATE "タイトル" + TOSTR(LCOUNT, "000"), GID, 0, 0, GWIDTH(GID), GHEIGHT(GID)
	;優先度に応じてでやすくする/優先度999が指定されている場合は確定
	IF L_PRIORITY >= 999
		TITLE_NO = LCOUNT
		BREAK
	ELSE
		FOR LCOUNT:1, 0, MIN(L_PRIORITY, 20)
			TITLE_LIST:CNT_TITLE_PICTURE = LCOUNT
			CNT_TITLE_PICTURE++
		NEXT
	ENDIF
	GID++
NEXT
VARSET FACE_POS, -1
SIF TITLE_NO == -1
	TITLE_NO = TITLE_LIST:(RAND:CNT_TITLE_PICTURE)
;クライアントサイズの変更を加味してサイドに必要な余白の長さをとっておく
VARI SIDE_BLANK_LENS
SIDE_BLANK_LENS = (1200 * GETCONFIG("フォントサイズ") / 18 - CLIENTWIDTH()) / 2

TRYCCALLFORM TITLE_USE_FACE_{TITLE_NO}, FACE_POS
	IF G_OPT_USE_ICON == "사용안함"
		CALL PRINT_EVENT_PICTURE, "タイトル" + TOSTR(TITLE_NO, "000"), L_PICTURE_SIZE, "CENTER"
		PRINTL 
	ELSE
		FACE_SIZE = RESULT * GETCONFIG("フォントサイズ") / 18
		VARI COUNT_ICON = 0
		;アイコンをセット
		WHILE COUNT_ICON < VARSIZE("FACE_LIST")
			SIF FACE_POS:COUNT_ICON:0 == -1
				BREAK
			SIF LCOUNT++ == 1000
				BREAK
			L_CHARA = RAND(1, CSVCHARANUM)
			SIF !EXISTCSV(L_CHARA)
				CONTINUE
			;最後の使ったデータでEXTRAを許可しているかどうか
			SIF !USING_EXTRA_IN_LAST_SAVE && CSVCFLAG(L_CHARA, GETNUM(CFLAG, "EXTRA출전")) > 0
				CONTINUE
			SIF IS_TRYMAKE_FACE:L_CHARA
				CONTINUE
			SIF !顔グラ追加_F(L_CHARA, 1)
				CONTINUE
			TEMP_ICON '= GET_FACE_BY_CSV_AS_HTML(L_CHARA, "FACE_0", FACE_SIZE / GETCONFIG("フォントサイズ") * 100)
			SIF !RESULT_F
				TEMP_ICON '= GET_FACE_BY_CSV_AS_HTML(L_CHARA, "FACE_TS_0", FACE_SIZE / GETCONFIG("フォントサイズ") * 100)
			SIF !RESULT_F
				CONTINUE

			L_TOOLTIP = NO  :{L_CHARA}
			L_TOOLTIP += UNICODE(0x000D) + "名前:" + CSVCALLNAME(L_CHARA)
			L_TOOLTIP += UNICODE(0x000D) + "作品:" + GET_EXTRA_INGAME_NAME(CSVCFLAG(L_CHARA, GETNUM(CFLAG, "EXTRA출전")), L_CHARA)
			TEMP_ICON '= SET_BUTTON_TAG(TEMP_ICON, , L_TOOLTIP)

			FACE_POS:COUNT_ICON:0 = FACE_POS:COUNT_ICON:0 * GETCONFIG("フォントサイズ") / 18
			FACE_POS:COUNT_ICON:1 = FACE_POS:COUNT_ICON:1 * GETCONFIG("フォントサイズ") / 18
			FACE_LINE += @"<div padding = '{GETCONFIG("フォントサイズ") / 2}px' border_width = '2px' width = '{FACE_SIZE + GETCONFIG("フォントサイズ")}px' xpos = '{FACE_POS:COUNT_ICON:0 - SIDE_BLANK_LENS}px' ypos = '{FACE_POS:COUNT_ICON:1 - ((L_PICTURE_SIZE + 1) * GETCONFIG("フォントサイズ"))}px' height = '{FACE_SIZE + GETCONFIG("フォントサイズ")}px'>" + TEMP_ICON + "</div>"
			COUNT_ICON++
		WEND
		CALL PRINT_EVENT_PICTURE, "タイトル" + TOSTR(TITLE_NO, "000"), L_PICTURE_SIZE, "CENTER"
		HTML_PRINT FACE_LINE
	ENDIF
CATCH
	CALL PRINT_EVENT_PICTURE, "タイトル" + TOSTR(TITLE_NO, "000"), L_PICTURE_SIZE, "CENTER"
	PRINTL 
ENDCATCH
