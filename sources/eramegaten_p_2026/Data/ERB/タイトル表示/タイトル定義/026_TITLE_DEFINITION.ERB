;タイトル表示になんらかの条件を付ける場合
;戻り値が0の場合は表示されない。また戻り値を増やすとその分抽選されやすくなる
@IS_TITLE_USEABLE_26
RETURN G_USEABLE_TITLE_PICTURE:26

;セーブするときにタイトル抽選用のフラグをセットする
@SET_FLAG_USEABLE_TITLE_26
#DIM DYNAMIC LCOUNT
G_USEABLE_TITLE_PICTURE:26 = 1
FOR LCOUNT, 1, 7
	SIF POS(LCOUNT) < 0
		CONTINUE
	;ユニークアイコンを使ってるメンバーがいると抽選率があがる
	SIF STRFIND(CSTR:POS(LCOUNT):基本アイコンファイルネーム, "FACE_UNIQUE") < 0
		CONTINUE
	G_USEABLE_TITLE_PICTURE:26 = 10
	RETURN 0
NEXT
