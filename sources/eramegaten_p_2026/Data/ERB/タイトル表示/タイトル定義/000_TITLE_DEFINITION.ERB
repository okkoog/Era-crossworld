;タイトル表示になんらかの条件を付ける場合
;戻り値が0の場合は表示されない。また戻り値を増やすとその分抽選されやすくなる
@IS_TITLE_USEABLE_0
RETURN G_USEABLE_TITLE_PICTURE:0

;セーブするときにタイトル抽選用のフラグをセットする
@SET_FLAG_USEABLE_TITLE_0
#DIM DYNAMIC LCOUNT
G_USEABLE_TITLE_PICTURE:0 = 0
;ダマナーが加入していないとでない
SIF IS_CHARA_COMPANIONED:[[キャラ:동기다크서머너]] == 0
	RETURN 0
G_USEABLE_TITLE_PICTURE:0 = 1
FOR LCOUNT, 1, 7
	SIF POS(LCOUNT) < 0
		CONTINUE
	SIF !GROUPMATCH(NO:POS(LCOUNT), [[キャラ:동기다크서머너]], [[キャラ:마요네]], [[キャラ:아인]], [[キャラ:코시로]], [[キャラ:메어리]])
		CONTINUE
	G_USEABLE_TITLE_PICTURE:0 = 10
	RETURN 0
NEXT
