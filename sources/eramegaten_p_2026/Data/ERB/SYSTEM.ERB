;;=================================================================================
;;レベルアップ・イベントでの能力ボーナス
;;=================================================================================
;=================================================================================
;@STATUS_BONUS_0
;新レベルアップ・イベントでの能力ボーナス
;ARG   対象キャラ
;ARG:1 ボーナスポイント
;ARG:2 レベルアップ回数
;=================================================================================

@STATUS_BONUS_0, ARG, CNT_STATUS_BONUS, CNT_LVUP
#DIM LCOUNT, 2
#DIM L_LINE
#DIM ADD_BASE_STATUS, BASESTATUSNUM
#DIM CNT_LVUP
#DIM CNT_STATUS_BONUS
#DIM IS_TRANSFORMED
#DIM REMAINING_BONUS
#DIM STOCK_REDRAW
#DIMS SHOW_LINE, 7
#DIM SHOW_LINE_MAXLENS

STOCK_REDRAW = CURRENTREDRAW()
VARSET ADD_BASE_STATUS
L_LINE = LINECOUNT

WHILE 1
	REDRAW 0
	CLEARLINE LINECOUNT - L_LINE
	;残りボーナスを取得
	REMAINING_BONUS = CNT_STATUS_BONUS - SUMARRAY(ADD_BASE_STATUS)
	DRAWLINE
	PRINTFORML %종족명(ARG)%　　%CALLNAME:ARG%　　
	PRINTFORML 　　LV{BASE:ARG:LV+CNT_LVUP,3}　　　%GET_ALI1(ABL:ARG:속성LD),7%/%GET_ALI2(ABL:ARG:속성LC),7%
	CUSTOMDRAWLINE ･
	;ボーナスが残っているのなら取得の選択をさせる
	PRINTL 어느 능력을 올릴까？
	PRINTFORML 나머지 {REMAINING_BONUS,2}포인트
	DRAWLINE
	SHOW_LINE_MAXLENS = 0
	FOR LCOUNT, 1, 7
		SHOW_LINE:LCOUNT = 
		SHOW_LINE:LCOUNT += @"[{LCOUNT}] %GET_BASESTATUS(LCOUNT),4%："
		SHOW_LINE:LCOUNT += @"{BASE:ARG:GET_BASESTATUS(LCOUNT), 4}"
		SHOW_LINE:LCOUNT += @"({MAXBASE:ARG:GET_BASESTATUS(LCOUNT), 4})"
		SHOW_LINE:LCOUNT += @"【+{ADD_BASE_STATUS:LCOUNT,3}】"
		SHOW_LINE_MAXLENS = MAX(STRLENS(SHOW_LINE:LCOUNT), SHOW_LINE_MAXLENS)
	NEXT
	PRINTFORML %" " * SHOW_LINE_MAXLENS%　　 +5 　　+10 %"+" + TOSTR(REMAINING_BONUS), 7, RIGHT%
	FOR LCOUNT, 1, BASESTATUSNUM
		PRINTBUTTON SHOW_LINE:LCOUNT, LCOUNT
		PRINT 　　
		SETCOLOR REMAINING_BONUS < 5 ? COLOR("gray") # GETDEFCOLOR()
		PRINTBUTTON @"[{LCOUNT + 10}]", LCOUNT + 10
		PRINT 　　
		SETCOLOR REMAINING_BONUS < 10 ? COLOR("gray") # GETDEFCOLOR()
		PRINTBUTTON @"[{LCOUNT + 20}]", LCOUNT + 20
		PRINT 　　
		RESETCOLOR
		PRINTBUTTON @"[{LCOUNT + 30}]", LCOUNT + 30
		PRINTL 
	NEXT
	DRAWLINE
	;ボーナスが残っているのなら取得の選択をさせる
	IF REMAINING_BONUS
		PRINTL [ 0] 리셋
		PRINTL [-1] 자동(현재의 기본 스테이터스 비율을 유지)
		PRINTL [-2] 자동(현재의 최대 스테이터스 비율을 유지)
		INPUT
		SELECTCASE RESULT
			CASE 0
				VARSET ADD_BASE_STATUS
			CASE 1 TO 6
				ADD_BASE_STATUS:RESULT += 1
			CASE 11 TO 16
				SIF REMAINING_BONUS >= 5
					ADD_BASE_STATUS:(RESULT % 10) += 5
			CASE 21 TO 26
				SIF REMAINING_BONUS >= 10
					ADD_BASE_STATUS:(RESULT % 10) += 10
			CASE 31 TO 36
				ADD_BASE_STATUS:(RESULT % 10) += REMAINING_BONUS
			CASE -1
				CALL AUTO_ALLOCATE_BASE_STATUS_BY_LEVELUP, ARG, 0, CNT_STATUS_BONUS, ADD_BASE_STATUS
			CASE -2
				CALL AUTO_ALLOCATE_BASE_STATUS_BY_LEVELUP, ARG, 1, CNT_STATUS_BONUS, ADD_BASE_STATUS
		ENDSELECT
	ELSE
		;ボーナスがなくなっていたら決定
		PRINTL 괜찮겠습니까？
		CALL INPUT_YN
		SIF RESULT == 0
			BREAK
		VARSET ADD_BASE_STATUS
	ENDIF
WEND
;ステータスを加算する
FOR LCOUNT, 0, BASESTATUSNUM
	BASE:ARG:GET_BASESTATUS(LCOUNT) += ADD_BASE_STATUS:LCOUNT
NEXT
REDRAW STOCK_REDRAW
RETURN 1
