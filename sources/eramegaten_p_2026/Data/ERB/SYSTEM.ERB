CUSTOMDRAWLINE ･
PRINTL 어느 능력을 올릴까？

WHILE 1
	PRINTFORML 〔나머지 {ARG:1-消費済み,2}점〕
	FOR LOCAL,0,6
		PRINTFORML % カーソル == LOCAL ? "●→" # "　　"% %元値表示:LOCAL% + {能力値上昇:LOCAL,2}
	NEXT

	VARSET RESULTS,"",0,20
	RESULTS:16 = _Enter_確定_%ARG:1 == 消費済み ? "" # "0x404040"%
	CALL INPUT_ONEKEY_TAP_RESULTS(FLAG:던전내조작설정,"=","_")
	SELECTCASE RESULTS
		CASE "4","a","A"
			IF 能力値上昇:カーソル > 0
				能力値上昇:カーソル -= 1
				消費済み -= 1
			ENDIF
		CASE "6","d","D"
			IF ARG:1 > 消費済み
				能力値上昇:カーソル += 1
				消費済み += 1
			ENDIF
		CASE "8","w","W"
			カーソル = カーソル == 0 ? 5 # カーソル-1
		CASE "2","s","S"
			カーソル = カーソル == 5 ? 0 # カーソル+1
		CASE ""
			IF ARG:1 == 消費済み 
				PRINTL 괜찮겠습니까？
				CALL INPUT_YN
				SIF RESULT == 1
					RESTART
				FOR LOCAL,0,6
					BASE:ARG:(GET_BASESTATUS(LOCAL+1)) += 能力値上昇:LOCAL
				NEXT
				REDRAW 3
				RETURN
			ENDIF
	ENDSELECT
	CLEARLINE 13
WEND

