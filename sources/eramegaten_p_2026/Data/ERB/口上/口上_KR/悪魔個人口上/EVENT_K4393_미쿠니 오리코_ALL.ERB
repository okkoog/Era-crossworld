SELECTCASE TFLAG:전투이벤트
	;COOP발동 ARG는 발동자
	CASE 1
		LOCALS = 너무 번거롭게 만들지 말아줘
	;COOP참가
	CASE 2
		;주인이 COOP발동
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			;연모
			IF TALENT:3 || TALENT:6
				LOCALS = 굿 타이밍이네.
			ELSE
				LOCALS = 이제 곧이네.
			ENDIF
		;그 이외
		ELSE
			LOCALS = 너도 내 장기말이 될래？
		ENDIF
	;피소환시
	CASE 3
			LOCALS = 초대장은 확실히 받았어요。자、무도회를 시작합시다
	;공격　ARG가 공격하는 동료마, ARG:1이 적, ARG:2가 데미지량
	CASE 11
		CALLFORM SKILL_TYPE_{CFLAG:ARG:입력행동}
		LOCAL = MAXBASE:(ARG:1):GET_TYPE(RESULT)
		;상대가 죽었다
		IF BASE:(ARG:1):ＨＰ <= 0
			LOCALS = 승부가 났네
		;약점을 찔렀다. 즉 COOP
		ELSEIF LOCAL > 100 && LOCAL < 999
			IF CFLAG:(ARG:1):방어플래그
				LOCALS = 당신은 나에게 패배할 거야, 그것이 내가 예지한 미래！
			ELSE
				;이쪽은 COOP발동으로 돌리기 위해서 CUT
				RETURN 0
			ENDIF
