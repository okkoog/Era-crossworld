;-------------------------------------------------
;eratohoA 및 eratohoA계열 전용 구상 템플릿
;270と270をキャラ番号に置換し、Y1を助手のキャラ番号に置換してください
;단, 캐릭터번호가 한자리인 캐릭터의 경우, 270,Y1は1、270は01のように変えてください
;그리고 커맨드 내의 적당한 조건 아래의 PRINTFORMW의 뒤에 반각 공백을 두고 대사를 추가해주세요
;구상을 추가하지 않는 커맨드는 무기입하셔도 상관없습니다만, CFLAG:XXX의 앞에『;』를 붙여서 주석처리를 하시면 더욱 좋습니다
;엑스트라 구문 등, 주석처리가 되어 있는 구문을 사용할 때는,『;』를 제거해 주석처리를 해제할 필요가 있습니다
;마지막으로 read me도 훑어보시는걸 추천드립니다
;-------------------------------------------------


;--------------------------------------------------
;구상셀렉트 기능：구상설명
;--------------------------------------------------
@セレクト口上説明_K270,ARG = 0
SIF ARG == 1
	RETURN 0
;구상명
;구상설명문
;１０００魔貨で買った場合と悪魔合体で作った場合で変わります
IF CFLAG:이벤트가입 == 1
	PRINTFORML 개구리와 소녀의 바엘
	PRINTFORML  　가게에서 산 바엘
	PRINTFORML  　소녀가 아니라 개구리가 말합니다
ELSE
	PRINTFORML 여체화 바엘
	PRINTFORML  　"그것"을 조교하는 건 좀…… 이라는 분들을 위한 버전
	PRINTFORML  　외견이 바뀝니다
ENDIF

;--------------------------------------------------
;EVENTTRAIN 관련（270을 캐릭터번호로 치환）
;조교 개시시의 대화 CFLAG 201～219를 사용
;--------------------------------------------------
@EVENTTRAIN_K270
;合体で作ったバエルの場合のみ初期に素質等を変更する
IF CFLAG:201 == 0 && CFLAG:이벤트가입 == 0
	TALENT:남자 = 0

	TALENT:얌전함 = 1
	TALENT:보수적 = 1
	TALENT:일선을넘지않음 = 1
	TALENT:저항 = 0
	TALENT:눈에띄고싶어함 = 0
	TALENT:부끄럼쟁이 = 1
	TALENT:고양이혀 = 1
	TALENT:쾌감에솔직 = 1
	TALENT:빈유 = 1
	TALENT:동물귀 = 1
	TALENT:꼬리 = 1
	TALENT:교활 = 0
	TALENT:우애 = 1

	;蛙がしゃべる
	CSTR:일인칭 = 이 몸
	IF TALENT:MASTER:남자
		CSTR:이인칭 = 형씨
	ELSE
		CSTR:이인칭 = 아가씨
	ENDIF

	;衣装：王冠、ドレス、パンティ、靴下、パンプス
	CFLAG:모자 = 28
	CFLAG:전신복 = 304
	CFLAG:속옷（하）= 602
	CFLAG:양말 = 801
	CFLAG:신발 = 911
ENDIF

;-------------------------------------------------
;조교 개시시（1회만） CFLAG201
;-------------------------------------------------
DRAWLINE
;첫조교시
IF CFLAG:201 == 0
	IF CFLAG:이벤트가입 == 1
		PRINTFORMW 『오냐, 조교할 시간인기라?』
		PRINTFORMW 소녀의 드레스 자락에서 바스락거리며 개구리가 나타났다
	ELSE
		PRINTFORMW 바엘과의 사투를 떠올린다……
		PRINTFORMW 그 녀석을 소환해서 조교하다니 리스크가 너무 크다!
		PRINTFORMW 살짝 손을 좀 써두자
		PRINTFORML ………
		PRINTFORML ……
		PRINTFORMW …
		PRINTFORMW 유황 냄새가 진동하는 연기와 함께 나타난 것은, 긴 드레스를 입고 미니 왕관을 쓴 고양이 눈과 고양이 귀를 한 소녀
		PRINTFORMW …성공이다!
		PRINTFORMW …성교다!
		PRINTFORML  
		PRINTFORMW 『오우, 잠깐 기다리라 카이』
		PRINTFORML 『%CSTR:일인칭%도 있구마』
		PRINTFORMW 소녀의 드레스 자락에서 바스락거리며 개구리가 나타났다
		PRINTFORML 
		PRINTFORMW 『이 아아가 말을 통 안 해서 말이제』
		PRINTFORML 『앞으로는 %CSTR:일인칭%가 대신 말해줄 테니 그리 알그라』
		PRINTFORMW 소녀는 고개를 끄덕이고 있다
		PRINTFORML 
		PRINTFORMW 『뭐, 어찌 됐든 간에』
	ENDIF
	PRINTFORML 
	PRINTFORML 『마왕 바엘이다』
	PRINTFORML 『앞으로도 잘 부탁한데이』
	PRINTFORMW 소녀는 꾸벅 인사를 했다
	CFLAG:201 = 1
;함락
ELSEIF CFLAG:201 < 5 && (TALENT:연모 || TALENT:음란 || TALENT:복종)
	;연모
	IF TALENT:연모
		PRINTFORMW %CALLNAME:MASTER%을 보자 %CALLNAME%은 한달음에 달려와 와락 안겨들었다
		PRINTFORML 
		PRINTFORMW 『어엿한 연인 사이가 된 두 사람이지만…』
		IF TALENT:처녀
			PRINTFORML 『첫날밤은 지금부터인기라?』
		ELSE
			PRINTFORML 『이제부터 연인 기념 첫 섹스인기라?』
		ENDIF
		PRINTFORML 
		PRINTFORML %CALLNAME%은 얼굴을 붉히며 퍽퍽 개구리를 때렸다
		PRINTFORMW 『아얏, 아프다 카이』
	;음란
	ELSEIF TALENT:음란
		PRINTFORMW 『어리고 가련한 소녀를』
		IF TALENT:처녀
			PRINTFORML 『처녀인 채로 이리도 음란하게 만들어뿌고』
			PRINTFORMW 『%CSTR:이인칭%도 참 대단한 조교사라 카겠지만……』
			PRINTFORML 『이 아아도 보통 호색한이 아니랑께』
		ELSE
			PRINTFORMW 『이리도 음란하게 만들어놓고 말이제』
			PRINTFORMW 『%CSTR:이인칭%도 참 어지간히 밝히는구마』
		ENDIF
		PRINTFORMW %CALLNAME%은 음탕한 미소를 띠며 고개를 끄덕였다
	;복종
	ELSEIF TALENT:복종
		PRINTFORML 『자, 새삼스레 %CSTR:이인칭%한테 인사 올리그라』
		PRINTFORMW 소녀와 개구리는 나란히 바닥에 엎드려 큰절을 올렸다
		PRINTFORMW 『보시다시피라 카이』
		PRINTFORML 『%CALLNAME%은 %CSTR:이인칭%의 것이구마』
		PRINTFORMW 『삶아 먹든 구워 먹든 마음대로 부려먹으소』
	ENDIF
	CFLAG:201 = 5
	RETURN 0
ENDIF

;--------------------------------------------------
;간이 조수구상 발동시에 첫조교시 구상을 스킵（Y1을 조수의 캐릭터번호로 한다）
;여러 명이 있을 경우는, SIF NO:ASSI == Y1 || NO:ASSI == Z1으로 추가해 나간다
;--------------------------------------------------
;조수が葛城史人
IF CFLAG:201 == 1 && ASSI == 4761
	PRINTFORMW 『뭐…… %CSTR:일인칭%가 졌응게 말이제』
	PRINTFORML 『좋을 대로 하그라』
	PRINTFORMW 소녀와 개구리는 드러누워 굴복의 포즈를 취했다
ENDIF

;-------------------------------------------------
;조교 개시시（2번째 이후, X1을 캐릭터번호로 변경한다）
;-------------------------------------------------
@EVENTTRAIN_SECOND_K270

;반발각인Lv3
IF MARK:반발각인 == 3 && FLAG:7 == 2
	PRINTFORML 『피하라 카이~!』
	PRINTFORMW %CALLNAME%은 개구리를 쥐어 잡고 이쪽에 집어던졌다
	PRINTFORML 
	PRINTFORML 
	PRINTFORML 『……』
	PRINTFORML 『남을 함부로 집어던지면 못쓰는 법인기라』
	PRINTFORMW 소녀는 개구리 앞에 무릎 꿇고 앉아 설교를 듣고 있다
	PRINTFORMW 『뭐, %CSTR:이인칭%가 싫은 건 이해하겠지만서도』
	PRINTFORML 『이것도 계약이란 말이다. 단단히 각오하그라』
	PRINTFORMW 소녀는 언짢은 듯 침대에 엎드려 얼굴을 파묻었다
	CFLAG:202 = 4
;굴복각인Lv2以下
ELSEIF MARK:굴복각인 <= 2 && (CFLAG:202 < 1 || FLAG:7 == 2)
	IF RAND:2 == 0
		PRINTFORML 『자, 조교할 시간이데이』
		PRINTFORMW 뭔가 할 말이 있는 듯한 %CALLNAME%은 침대에 누웠다
	ELSE
		PRINTFORML 『왔구마』
		PRINTFORML 『얼른 준비 안 하고 뭐 하노』
		PRINTFORMW %CALLNAME%은 침대 밑에서 음구 상자를 꺼내더니 침대 위에 늘어놓기 시작했다
	ENDIF
	CFLAG:202 = 1
;굴복각인Lv3＋함락소질없음
ELSEIF MARK:굴복각인 == 3 && (TALENT:연모 == 0 && TALENT:음란 == 0 && TALENT:복종 == 0 && TALENT:친애 == 0 && TALENT:창부 == 0 && TALENT:예속 == 0) && (CFLAG:202 < 4 || FLAG:7 == 2)
	IF RAND:2 == 0
		PRINTFORMW 『이제 얼마 안 남았데이』
	ELSE
		PRINTFORMW 『%CSTR:이인칭%의 조교 솜씨도 확실하구마』
	ENDIF
	PRINTFORMW 『조금만 더 하면 꿀꺽 넘어가겠데이』
	CFLAG:202 = 4
;함락완료
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	;연모, 친애
	IF TALENT:연모 || TALENT:친애
		IF RAND:2 == 0
			PRINTFORMW %CALLNAME%이 오자, 소녀는 기쁜 표정을 지으며 개구리를 덥석 집어 들었다
			PRINTFORML 
			PRINTFORML 『자, 잠깐만 기다리라 카이!』
			PRINTFORMW 방에서 쫓겨날 판이 되자 개구리는 당황해 소녀를 말리려 든다
			IF TALENT:발정가능
				PRINTFORMW 『발정 난 꼴을 남한테 보이기 싫은 건 알겠다만』
			ELSE
				PRINTFORMW 『%CSTR:이인칭%랑 나누는 사랑의 밀어를 들키는 게 부끄러운 건 알겠다만』
			ENDIF
			PRINTFORMW 『그럼 우찌 대화를 나눌 거란 말이고?』
			PRINTFORML 
			PRINTFORMW 소녀는 마지못해 개구리를 방구석에 내려놓았다
			PRINTFORMW 『걱정 말그라, 입 밖에 안 낼 테니 마음껏 즐기라 카이』
		ELSE
			PRINTFORMW 『늦었구마』
			PRINTFORML 『이 아아도 기다리다 목 빠지는 줄 알았단 말이다』
			IF TALENT:발정가능 == 1
				PRINTFORMW 평소의 사랑스러워야 할 소녀는 그곳에 없고, 발정 난 암컷만이 있었다
			ELSE
				PRINTFORMW 소녀는 고개를 끄덕이고 있다
			ENDIF
			PRINTFORML 
			PRINTFORMW 『그라믄, 남은 건 젊은 것들끼리 재미 보그라』
		ENDIF
	;음란, 창부
	ELSEIF TALENT:음란 || TALENT:창부
		IF RAND:2 == 0
			PRINTFORMW 『늦었구마』
			PRINTFORML 『1분만 더 늦었어도 자위 시작할 뻔했당께』
			IF TALENT:발정가능 == 1
				PRINTFORMW 소녀가 앉아있는 침대에는 온갖 장난감이 굴러다니고 있었다
			ELSE
				PRINTFORMW 소녀는 고개를 끄덕이고 있다
			ENDIF
			PRINTFORMW 『그라믄, 실컷 귀여워해 주이소』
		ELSE
			PRINTFORML 『자, %CSTR:이인칭%가 오셨데이』
			PRINTFORMW 『참말로 잘 참았구마』
			PRINTFORMW 소녀가 앉아있는 침대에는 온갖 장난감이 굴러다니고 있었다
			PRINTFORMW 『참아낸 만큼 듬뿍 귀여움 받으라 카이』
		ENDIF
	;복종, 예속
	ELSEIF TALENT:복종 || TALENT:예속
		PRINTFORML 『자, %CSTR:일인칭%가 왔구마』
		PRINTFORML 『똑바로 인사 안 올리나』
		PRINTFORMW %CALLNAME%은 부랴부랴 바닥에 큰절을 올렸다
		PRINTFORMW 『그라믄, 평소처럼 좋을 대로 부려먹으소』
	ENDIF
	CFLAG:202 = 5
ELSE
	PRINTFORML 『자, %CSTR:일인칭%가 왔구마』
	IF RAND:2 == 0
		PRINTFORMW %CALLNAME%은 고양이처럼 침대에서 웅크리고 있다가, 개구리의 목소리에 부스스 움직이기 시작했다
	ELSE
		PRINTFORMW %CALLNAME%은 의자에 앉아 우유를 마시고 있었으나, 아쉬운 듯 컵을 테이블에 내려놓고 조교 준비를 시작했다
	ENDIF
ENDIF
RETURN 0

;-------------------------------------------------
;EVENTEND 관련（270을 캐릭터번호로 치환）
;조교 종료시의 대사
;-------------------------------------------------
@EVENTEND_K270

;--------------------------------------------------
;조교 종료시의 대사
;--------------------------------------------------
DRAWLINE
;반발각인Lv3
IF MARK:반발각인 == 3 && (CFLAG:217 < 1 || FLAG:7 == 2)
		PRINTFORMW 『이러면 못쓴데이, %CSTR:이인칭%』
		PRINTFORML 『다음부터는 미움받지 않도록 조심하소』
		PRINTFORMW 소녀는 이쪽을 노려보고 있다
	CFLAG:217 = 1
;굴복각인Lv3
ELSEIF MARK:굴복각인 == 3
	;体力500未満
	IF BASE:0 < 500 && (CFLAG:218 < 1 || FLAG:7 == 2)
		;음란, 창부、発情中
		IF TALENT:음란 || TALENT:창부 || TALENT:발정가능
			PRINTFORMW 『발정 난 고양이는 중간에 안 멈춰주면 죽을 때까지 안 멈춘데이』
			PRINTFORMW 소녀는 방금 전까지의 조교를 떠올리며 배시시 웃고 있다
		;연모, 친애
		ELSEIF TALENT:연모 || TALENT:친애
			PRINTFORMW 『아무리 귀엽다고 해도 너무 과하게 해댔구마』
			PRINTFORMW 소녀는 어깨를 들썩이며 숨을 몰아쉬면서도 이쪽을 향해 방긋 웃고 있다
		;복종, 예속
		ELSEIF TALENT:복종 || TALENT:예속
			PRINTFORMW 『어지간히도 귀여워해 줬구마』
			PRINTFORML 『자, 너도 아주 대만족이제?』
			PRINTFORMW 소녀는 어깨를 들썩이며 숨을 몰아쉬면서도 끄덕이고 있다
		ELSE
			PRINTFORMW 『조~금 너무 심하게 굴렀구마, %CSTR:이인칭%』
			PRINTFORMW 『다음엔 쫌더 살살 다뤄줘야 한데이』
		ENDIF
		CFLAG:218 = 1
	ELSE
		;연모, 친애
		IF TALENT:연모 || TALENT:친애
			PRINTFORML 『자, 오늘은 이걸로 끝인기라』
			PRINTFORMW 소녀는 뺨을 부풀리며 불만스러운 표정을 짓고 있다
			IF RAND:2 == 0
				PRINTFORMW 『다음에 또 %CSTR:이인칭%한테 귀여움 받으라 카이』
			ELSE
