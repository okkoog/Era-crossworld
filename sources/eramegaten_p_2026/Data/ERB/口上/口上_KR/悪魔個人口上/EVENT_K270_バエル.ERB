;-------------------------------------------------
;이벤트구상 모음（X1을 캐릭터번호로 치환한다） CFLAG 261～299를 사용
;-------------------------------------------------
@KOJO_MESSAGE_EVENT_K270

;--------------------------------------------------
;특정 주인 시에 특수 캐릭터구상을 호출(Y1을 특정 캐릭터, X1을 노예의 캐릭터번호로 치환)
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_EVENT_PY1_K270
;	RETURN 0
;ENDIF
SELECTCASE TFLAG:13
		;-------------------------------------------------
		;아침펠라 or 朝クンニ
		;-------------------------------------------------
	CASE 1
			CALL EVENT_MESSAGE
			;함락완료
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:261 < 1 || FLAG:7 == 2)
				;연모, 친애
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW %CALLNAME%의 머리를 상냥하게 쓰다듬어 주자 %CALLNAME%은 방긋 미소 지었다
				;음란, 창부
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 더 하기를 조르는 %CALLNAME%을 곁으로 치워두고 %CALLNAME:MASTER%은 아침 준비를 시작했다
				;복종, 예속
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 더 봉사하려는 %CALLNAME:MASTER%을 옆으로 비켜두고 아침 준비를 시작했다
				ENDIF
				CFLAG:261 = 1
			ENDIF

		;-------------------------------------------------
		;아침파이즈리
		;-------------------------------------------------
	CASE 2
			CALL EVENT_MESSAGE
			;함락완료
