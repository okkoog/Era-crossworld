				LOCAL -= RAND:50
			SIF TALENT:ARG:프라이드높음
				LOCAL -= RAND:50
			SIF TALENT:ARG:반항적
				LOCAL -= RAND:50
			
			IF LOCAL < 30
				CFLAG:ARG:우호도 -= RAND:50
