;=====================================================================
;口調タイプ：女・大人の汎用口上＋会話用ファイルです
;=====================================================================
@KOJO_TALK_PUB305,ARG,ARG:1

SELECTCASE ARG:1
	CASE 1
		;1:レディ・キラーズ
		PRINTFORMW 「어머……」
		PRINTFORMW 「후후、무슨 잔재주를 부린 걸까。당신이 무척 매력적으로 보이네」
		PRINTFORMW 「하지만、정말로 매력적인 사람이라면、아무런 잔재주 없이도 사람을 포로로 할 수 있어요」
		PRINTFORMW 「%조사처리(CSTR:ARG:일인칭,"가")% 몸으로、당신에게 가르쳐 줄・게・요%UNICODE(0x2661)%」
	CASE 2
		; 2:おねだり前の逡巡時(あいさつor問答で目的が決まっている場合)
	PRINTFORML 「당신 나쁜 사람은 아닌 것 같으니、조금 전의 부탁 들어 주어도 괜찮아요」
	CASE 3
		; 3:交渉の目的を尋ねる
		SELECTCASE CFLAG:ARG:우호도
			CASE IS < 25
				IF STR:(ABL:ARG:종족) == "천사"
					PRINTFORML 「천사인 %CSTR:ARG:일인칭%에게 무슨 용건이라도?」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「\@IS_HUMAN(PLAYER)?인간이#인간에게 사역되는 악마가\@ %CSTR:ARG:일인칭%에게 무슨 용건일까？」
				ELSE
					PRINTFORML 「%CSTR:ARG:일인칭%에게 무슨 용건？」
				ENDIF
			CASE IS < 50
				PRINTFORMW 「그래서……%CSTR:ARG:일인칭%에게 무슨 용건인 거야？」
			CASEELSE
				PRINTFORMW 「기분도 좋으니까、%CSTR:ARG:일인칭%에게 용건이 있다면 들어 줄게요」
		ENDSELECT
	CASE 84
		;84:要求前の1文
		PRINT 「그렇네……」
	CASE 4
		; 4-6:交渉目的：やらせてくれと言った時の反応
