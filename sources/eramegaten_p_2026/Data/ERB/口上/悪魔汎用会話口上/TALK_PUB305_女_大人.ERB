					PRINTFORMW 「자아…얼마나 공물을 바칠 수 있을까？」
					PRINTFORML 
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 
					PRINTFORMW 「%조사처리(CSTR:ARG:일인칭,"을")% 안고 싶어? 후후후%ハート()%」
