			FLAG:처녀탈취인수 += 1
		ENDIF
		
		;仲間加入判定＝技巧LV*7
		;成功
		IF RAND:100 < (ABL:PLAYER:기교 * 7)
			PRINTFORMW 「이젠…… 어찌 되든 좋다%UNICODE(0x2661)%」
			EXP:ARG:절정경험 += 1
			RETURN 0
		;失敗
		ELSE
			PRINTFORMW 「…이 악귀！　색마！　…흑、흐흐흑…」
			RETURN 1
		ENDIF
	;失敗
	ELSE
		PRINTFORML 「……싫다、싫어……싫어엇！」
		PRINTFORMW 「두、두 번 다시 %CSTR:ARG:일인칭% 앞에 모습을 보이지 마라！ 이 무뢰한이！」
		RETURN 1
	ENDIF
;非処女
ELSE
	PRINTFORMW %PLAYER는% %ARG를% 밀어 넘어뜨리고、몇 번이나 쉼 없이 범해댔다……
	PRINTFORMW %CALLNAME:ARG%의 온몸은 흰 점액으로 더러워져 음부에서는 대량의 백탁액이 방울져 떨어지고 있었다。
	PRINTFORMW 「이젠…… 어찌 되든 좋다%UNICODE(0x2661)%」
	EXP:PLAYER:사정경험      += 5
	EXP:PLAYER:조교경험      += 5
	EXP:ARG:Ｖ경험   += 5
	EXP:ARG:성교경험 += 5
	EXP:ARG:정액경험 += 5
	EXP:ARG:질사경험 += 5
	RETURN 0
ENDIF
