;=====================================================================
;口調タイプ：女・古風の汎用口上＋会話用ファイルです
;女・淑女の汎用会話ファイルをベースに製作
;=====================================================================

;=====================================================================
;戦闘時会話および合体時会話の口上テンプレートです。

;個別の悪魔に対応させたい場合はX1をキャラ番号に
;会話タイプ別に対応させたい場合はKX1をPUB(会話タイプの番号)に
;置き換えてください。

;例）ピクシーの口上を作りたいならX1⇒501に置き換え
;　　会話タイプ：女、淑女ならKX1⇒PUB304に置き換え

;知ってると便利そうな表記
;　%CSTR:ARG:X%　X = 11:일인칭 12:이인칭 20:종족
;　\@ CSTR:ARG:종족명 != "" ? %CSTR:ARG:종족명% # %STR:(ABL:ARG:종족)%
;　┗CSTRに種族名が記載されていればそれを、されていなければABLから種族名を割り出して表示する

;====================================================================
@KOJO_TALK_PUB307,ARG,ARG:1

SELECTCASE ARG:1
	CASE 1
		;1:レディ・キラーズ
	PRINTFORMW 「……흐음、이상한 기색을 더듬어 보자니、아무래도 그대는 기묘한 매력을 가지고 있는 것 같군」
	PRINTFORMW 「여기서 서로 마주친 것도 무언가의 인연。그렇다면 차라리、이 자에게 이끌려 보는 것도 또한 일흥인가」
	PRINTFORMW 「거기의 사람이여、%조사처리(CSTR:ARG:일인칭,"은")% 그대를 따라 가겠다」
	CASE 2
		; 2:おねだり前の逡巡時(あいさつor問答で目的が決まっている場合)
	PRINTFORML 「그대는 참으로 유쾌한 자로군、후후」
	PRINTFORMW 「먼저 말한 소망을 이루어 주도록 할까……」
	CASE 3
		; 3:交渉の目的を尋ねる
		SELECTCASE CFLAG:ARG:우호도
			CASE IS < 25
				;友好度低い
				PRINTFORMW 「자……」
				PRINTFORML 「이 %CSTR:ARG:일인칭%에게 무슨 용무인가？」
			CASE IS < 50
				;友好度普通
				PRINTFORMW 「%CSTR:ARG:일인칭%에게 무슨 용무인가？　들어 주마」
			CASEELSE
				;友好度高い
				PRINTFORML 「지금의 %조사처리(CSTR:ARG:일인칭,"은")% 기분이 좋구나」
				PRINTFORMW 「그대의 소망을 말해 보아라。이루어 주마」
		ENDSELECT
	CASE 84
		;84:要求前の1文
		PRINTL 「그러면……」
	CASE 4
		; 4-6:交渉目的：やらせてくれと言った時の反応
		; 4:取り付く島もなし
		PRINTFORMW 「읏！？ 이 천한 놈이、…당장 꺼져！！」
		PRINTFORMW 격렬히 거부당했다
	CASE 5
		; 5:交渉次第
		IF TALENT:ARG:프라이드높음
			PRINTFORMW 「천한… 결국은 인간인가！」
			PRINTFORMW 「……흥… 허나、제법 끌리는 향기가 나는 것도 사실이로군…」
			PRINTFORMW 「%CSTR:ARG:이인칭%의 태도에 따라… 생각해 주지 못할 것도 없다만？」
			PRINTFORML 
			PRINTFORMW 「%CSTR:ARG:일인칭%에게 몸을 낮추고、기분을 맞춰 보아라」
		ELSE
			PRINTFORMW 「…흐음、%조사처리(CSTR:ARG:일인칭,"을")% 、말이지…」
			PRINTFORMW 「평소라면 일축했을 터이나…、%CSTR:ARG:이인칭%에게서는 사람을 끌어당기는 무언가가 느껴지는군」
			PRINTFORMW 「%CSTR:ARG:일인칭%에게 그대의 능력을 보여준다면、어쩌면 마음이 바뀔지도 모르겠구나♪」
			PRINTFORMW 조건에 따라 들어줄 것 같다
		ENDIF
	CASE 6
		; 6:一発おｋ
		$やらせてくれと言った時の反応一発おｋ_LOOP
		IF TALENT:ARG:처녀
			PRINTFORML 
			PRINTFORMW 「좋다 좋다♪ 실은 다 알고 있느니라、아름다운 %조사처리(CSTR:ARG:일인칭,"가")% 동료마가 되어주기를 바라는 것이겠지？」
			PRINTFORMW 「그럼 앞으로도 잘 부ㅌ… 뭐？… 하게… 뭐라고？」
			PRINTFORML 
			PRINTFORMW 승낙을 얻었으므로 %ARG를% 밀어 넘어뜨렸다
			PRINTFORML 
		ELSE
			SELECTCASE RAND:2
				;프라이드높음
				CASE 0
					SIF !TALENT:ARG:프라이드높음
						GOTO やらせてくれと言った時の反応一発おｋ_LOOP
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 
							PRINTFORMW 「뭐냐、%조사처리(CSTR:ARG:일인칭,"을")% 보고 욕정하고 있었던 게냐？」
							PRINTFORMW 「뭐어 %CSTR:ARG:일인칭%처럼 매력 넘치는 몸을 눈앞에 두었으니、어쩔 수 없는 일이겠구나♪」
							PRINTFORML 
						CASEELSE
							PRINTFORML 
							PRINTFORMW 「%조사처리(CSTR:ARG:일인칭,"을")% 그런 추잡한 눈으로 보고 있었던 건가？　이 벌레같은 놈이！」
							PRINTFORMW 「뭐어…%조사처리(CSTR:ARG:일인칭,"은")% 관대하니、정을 베풀어 주마」
							PRINTFORML 
							PRINTFORMW 「자！ 멍하니 있지 말고 옷을 벗고 누워라！！」
							PRINTFORMW 「%조사처리(CSTR:ARG:일인칭,"가")% 그대를 시험해 주마、어서 하거라%ハート()%」
							PRINTFORML 
					ENDSELECT
				;汎用
				CASEELSE
					SELECTCASE RAND:2
						CASE 0
							PRINTFORML 
							PRINTFORMW 「호홋♪　상당히 대담한 어프로치로군♪」
							PRINTFORMW 「상스러운 이야기지만、%CSTR:ARG:일인칭%도 한동안 뜸했던 참이다」
							PRINTFORML 
							PRINTFORMW 「자아、가까이 오너라… 먼저 입맞춤부터다%ハート()%」
							PRINTFORML 
						CASEELSE
							PRINTFORML 
							PRINTFORMW 「호오！…그런가、 그런가、어느새 %CSTR:ARG:이인칭%의 정욕을 부추겨 버린 모양이구나♪」
							PRINTFORMW 「…좋다、자 가까이 오너라♪　황홀한 지고의 시간을 함께 맛보도록 하자%ハート()%」
							PRINTFORML 
					ENDSELECT
			ENDSELECT
		ENDIF
		;負けない…
		SIF TALENT:PLAYER:크고아름다움
			PRINTFORML 「자아… %조사처리(CSTR:ARG:이인칭,"로")% %조사처리(CSTR:ARG:일인칭,"을")% 채워 줄 수 있겠는가%ハート()%」
		PRINTFORMW 흔쾌히 승낙해주었다
		GOTO ヤらせてもらう・交渉が成功した場合行為中
	CASE 7
