;===========================================================================
;ヒーホー口上会話の大まかな流れ
;１.GREET_PUB315 出会い頭の挨拶(まれに問答→会話後、３へ)
;２.GREET_PUB315 問答発生(調教ってなんだホ、の箇所)→会話後、３へ
;３.QUESTION_PUB315 続きの問答発生→穏便に終わると仲魔勧誘会話に移行
;気まずくなった後会話が継続したらもう一度３から抽選、永遠に３をループする　ので、会話を増やす場合は３が多めだと好ましい　…かもしれない
;===========================================================================
;会話時挨拶
;===========================================================================
@GREET_PUB315,ARG

;質問を増やした場合、RAND:XのXを増やす
;RETURNの値により回答後の雰囲気が変わる。
;0.会話継続 1.直接仲魔になる 2.何かくれる 3.奇襲される 4.敵対する 5.逃げる 6.気まずくなる


SELECTCASE RAND:20
;出合い頭のコンニチハ段階で発生する会話


	CASE 0
		;立ち去ろうとしている
		PRINTFORML 
		PRINTFORML 악마는 떠나가려 하고 있다……
		PRINTFORMW 어쩌겠습니까?
		PRINTFORML 
		PRINTFORML [1]말을 건다　[2]지켜본다
		PRINTFORML 

		;ユーザー入力を待つ文
		CALL INPUTINT, 1, 2

		SELECTCASE RESULT
			;声をかける
			CASE 1
				LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
				IF LOCAL < 20
					CFLAG:ARG:우호도 -= RAND:30
					;失敗　20％ほど　
						PRINTFORMW 「성가신 녀석이다호-」
						PRINTFORMW 「%CSTR:ARG:일인칭% 지금 기분이 몹시 얹짢다호-」
						RETURN 6
				ELSE
					CFLAG:ARG:우호도 += RAND:10
					;成功　それ以外(D2
						PRINTFORML 「뭐냐호?」
						PRINTFORMW 「넉살 좋은 녀석이다호-」
						RETURN 0
				ENDIF
			;見守る
			CASE 2
				LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
				;謎の魅力で補正
				SIF TALENT:PLAYER:수수께끼의매력
					LOCAL += RAND:30
				IF LOCAL < 40
					CFLAG:ARG:우호도 -= RAND:30
					;失敗　40％？ (D2
						PRINTFORML 「부글부글-!」
						PRINTFORMW 「입 다물고 있지 말고 조금은 불러 세워보라호!」
						RETURN 6
				ELSE
					CFLAG:ARG:우호도 += RAND:50
					;成功　
						PRINTFORMW 「무, 왠지…… 뜨거운 시선이 느껴진다호~……」
