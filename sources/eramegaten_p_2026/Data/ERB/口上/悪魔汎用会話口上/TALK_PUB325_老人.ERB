	;0.会話継続 1.直接仲魔になる 2.何かくれる 3.奇襲される 4.敵対する 5.逃げる 6.気まずくなる 7.交渉開始
	SELECTCASE RESULT:1
		CASE ARG:1
			CONTINUE
		CASE 0
			PRINTFORMW 「도구만 편리해지고, 인간들이 생각하는 것은 도통 모르겠구먼」
			PRINTFORML
			PRINTFORML [1]이래서 옛날 사람은　[2]나도 모르겠다
			$INPUT_LOOP0
			INPUT
			PRINTFORML
			IF RESULT == 1
				;1．だから古い人は
				LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
	;			素質によって判定値がランダムに上下することもある
	;			SIF TALENT:ARG:반항적
	;				LOCAL -= RAND:20
				IF LOCAL < 70
					CFLAG:ARG:우호도 -= RAND:50
					;失敗
					PRINTFORMW 「나이 따윈 상관없네! 이 늙은이도 다 알고 있다네!」
					PRINTFORMW 「컴퓨터도 못 다루는 젊은것들이 늘었다지 않느냐!」
					RETURN 6
				ELSE
					CFLAG:ARG:우호도 += RAND:30
					;成功
					PRINTFORMW 「옛, 옛날 사람…이라고!?」
					PRINTFORMW 「으으음…」
					PRINTFORMW 「슬슬 스마트폰 교실이라도 다녀야 하는 것일까…」
					RETURN 0
				ENDIF
			ELSEIF RESULT == 2
				;2．自分もわからない
				LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
				IF LOCAL < 30
					CFLAG:ARG:우호도 -= RAND:50
					;失敗
					PRINTFORMW 「그럼 그저 아무 생각도 없이 세상을 몇 번이고 불태울 도구를 다루고 있는 게냐?」
					PRINTFORMW 「악마 따위보다 훨씬 무시무시하지 않은가!」
					RETURN 6
				ELSE
					CFLAG:ARG:우호도 += RAND:30
					;成功
					PRINTFORMW 「지혜란 그것을 다스릴 줄 알아야 힘이 되는 법일세」
					PRINTFORMW 「그 사실을 부디 잊지 말도록 하게」
					RETURN 0
				ENDIF
			ELSE
				GOTO INPUT_LOOP0
			ENDIF

		CASE 1
			PRINTFORMW 「인간 세상도 참으로 소란스러워졌구먼…」
			PRINTFORML
			PRINTFORML [1]수도니까　[2]옛날엔 달랐나?
			$INPUT_LOOP1
			INPUT
			PRINTFORML
			IF RESULT == 1
				;1．首都だから
				LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
	;			素質によって判定値がランダムに上下することもある
	;			SIF TALENT:ARG:반항적
	;				LOCAL -= RAND:20
				IF LOCAL < 20
					CFLAG:ARG:우호도 -= RAND:50
					;失敗
					PRINTFORMW 「어라… 도읍에 사는 인간이라면 응당 합당한 절차를 갖추어 %CSTR:ARG:일인칭%에게 경의를 표해야 하거늘」
					PRINTFORMW 「인간의 마음이란 이다지도 변덕스러운 것이었나」
					PRINTFORMW 「여기서 재앙이라도 한바탕 일으켜서 기억을 되살려 줘야겠구먼」
					RETURN 4
				ELSE
					CFLAG:ARG:우호도 += RAND:30
					;成功
					PRINTFORMW 「호오…… 나라의 수도라고. 인간이 많을 만도 하구먼」
					PRINTFORMW 「덕분에 우리들도 숨어들기 쉽다네」
					RETURN 0
				ENDIF
			ELSEIF RESULT == 2
				;2．昔は違ってた？
				LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
				IF LOCAL < 30
					CFLAG:ARG:우호도 -= RAND:50
					;失敗
					PRINTFORMW 「어라… 돌이켜 보면 어느 시대든 인간 놈들은 소란스러웠던가…」
					PRINTFORMW 「하지만 지금처럼 대우받지 못하던 시대도 없었던 것 같구먼」
					RETURN 6
				ELSE
					CFLAG:ARG:우호도 += RAND:30
					;成功
					PRINTFORMW 「호오… 옛날이야기를 듣고 싶은 게냐? 요즘 젊은것치고는 꽤나 학구열이 높구먼」
					RETURN 0
				ENDIF
			ELSE
				GOTO INPUT_LOOP1
			ENDIF
	ENDSELECT
