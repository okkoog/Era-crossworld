;質問を増やした場合、RAND:XのXを増やす
;RETURNの値により回答後の雰囲気が変わる。
;0.会話継続 1.直接仲魔になる 2.何かくれる 3.奇襲される 4.敵対する 5.逃げる 6.気まずくなる
SELECTCASE RAND:2
	CASE 0
		PRINTFORMW 「헌데 인간이 이런 곳에서 무얼 하고 있는 게냐?」
		PRINTFORML
		PRINTFORML [1]모험　　　[2]악마 퇴치
		PRINTFORML [3]동마 찾기　[4]노예 사냥
		$INPUT_LOOP0
		INPUT
		PRINTFORML
		IF RESULT == 1
			;１．冒険
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
;			素質によって判定値がランダムに上下することもある
;			SIF TALENT:ARG:반항적
;				LOCAL -= RAND:20
			IF LOCAL < 30
				CFLAG:ARG:우호도 -= RAND:50
				;失敗
				PRINTFORMW 「모험이라고? 정말이지, 젊은 녀석이 허파에 바람이나 차서 어슬렁거리기는…」
				RETURN 6
			ELSE
				CFLAG:ARG:우호도 += RAND:30
				;成功
				PRINTFORMW 「호오… 모험이란 말이지」
				PRINTFORMW 「그것 또한 젊은이의 특권이로구먼」
				RETURN 0
			ENDIF
		ELSEIF RESULT == 2
			;２．悪魔退治
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
			IF LOCAL < 40
				CFLAG:ARG:우호도 -= RAND:50
				;失敗
				PRINTFORMW 「그렇다면 어쩔 수 없지… 삶든 굽든 마음대로 하게」
				PRINTFORMW 「%CSTR:ARG:일인칭%도 가만히 있지는 않겠지만 말이야!」
				RETURN 4
			ELSE
				CFLAG:ARG:우호도 += RAND:30
				;成功
				PRINTFORMW 「호오… 악마 퇴치라고?」
				PRINTFORMW 「면전에서 딱 잘라 말하다니 배짱이 두둑한 놈이구먼」
				RETURN 0
			ENDIF
		ELSEIF RESULT == 3
			;３．仲魔探し
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
			IF LOCAL < 20
				CFLAG:ARG:우호도 -= RAND:50
				;失敗
				PRINTFORMW 「뭐냐, 악마소환사인가…」
				PRINTFORMW 「여전히 지독한 계약으로 악마를 부려먹고 있겠지」
				RETURN 5
			ELSE
				CFLAG:ARG:우호도 += RAND:30
				;成功
				PRINTFORMW 「호오, 악마소환사인가…」
				PRINTFORMW 「오랫동안 잊혀졌나 싶었더니 %CSTR:ARG:일인칭%도 제법이구먼」
				RETURN 0
			ENDIF
		ELSEIF RESULT == 4
			;４．奴隷狩り
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2) - RAND:20
			IF LOCAL < 60
				CFLAG:ARG:우호도 -= RAND:50
				;失敗
				PRINTFORMW 「어라, 요즘은 인간들도 제법 도덕심을 갖추게 되었다고 들었는데……」
				PRINTFORMW 「헛헛헛 인간은 어차피 인간이구먼」
				PRINTFORMW 「동족조차 등쳐먹는 판국이니 악마에게 잡아먹힌들 할 말은 없겠지」
				RETURN 3
			ELSE
				CFLAG:ARG:우호도 += RAND:30
				;成功
				PRINTFORMW 「과연, %CSTR:ARG:일인칭%에게 바칠 제물을 고르고 있는 중인 게냐?」
				PRINTFORMW 「기특하구먼, 기특해…」
				RETURN 0
			ENDIF
		ELSE
			GOTO INPUT_LOOP0
		ENDIF

	CASE 1
		PRINTFORMW 「그건 그렇고……」
		PRINTFORMW 「어라, 그러고 보니 %CSTR:ARG:이인칭%은(는) 대체 누구였더라?」
		PRINTFORML
		PRINTFORML [1]데빌서머너　　　[2]사립탐정
		PRINTFORML [3]내가 신이다　　　　　　[4]관광객
		$INPUT_LOOP1
		INPUT
