		IF RESULT == 1
			;１．デビルサマナー
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
;			素質によって判定値がランダムに上下することもある
;			SIF TALENT:ARG:반항적
;				LOCAL -= RAND:20
			IF LOCAL < 30
				CFLAG:ARG:우호도 -= RAND:50
				;失敗
				PRINTFORMW 「오오, 악마소환사였지…」
				PRINTFORMW 「그래서, 이 가련한 악마를 소환기에 밀어 넣으러 온 겐가?」
				RETURN 6
			ELSE
				CFLAG:ARG:우호도 += RAND:30
				;成功
				PRINTFORMW 「음음… 요즘 시대의 악마소환사였지」
				PRINTFORMW 「자 그럼, 악마의 도움을 얻을 생각이라면 그에 걸맞은 대가를 준비해 왔겠지?」
				RETURN 0
			ENDIF
		ELSEIF RESULT == 2
			;２．私立探偵
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
			IF LOCAL < 30
				CFLAG:ARG:우호도 -= RAND:50
				;失敗
				PRINTFORMW 「으으음… 탐정, 탐정인가」
				PRINTFORMW 「설마 요전에 잡아먹어 버린 길 잃은 고양이를 찾으러 온 건 아니겠지」
				RETURN 5
			ELSE
				CFLAG:ARG:우호도 += RAND:30
				;成功
				PRINTFORMW 「뭐라, 탐정이라고!」
				PRINTFORMW 「악마 조수가 필요할 정도라니 대체 무슨 괴사건인 게냐!?」
				RETURN 0
			ENDIF
		ELSEIF RESULT == 3
			;３．私が神だ
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
			IF LOCAL < 30
				CFLAG:ARG:우호도 -= RAND:50
				;失敗
				PRINTFORMW 「뭣이, 이 근방의 용맥은 이미 %CSTR:ARG:일인칭%의 텃밭이거늘!」
				PRINTFORMW 「이놈! 딴 곳의 신에게 넘겨줄 수는 없다네!」
				RETURN 4
			ELSE
				CFLAG:ARG:우호도 += RAND:30
				;成功
				PRINTFORMW 「뭐라, %CSTR:ARG:이인칭%은(는) 신선 지망생이었던 겐가!」
				PRINTFORMW 「그 험난한 고행에 도전할 생각이라니 요즘 젊은것치곤 기골이 장대하구먼」
				RETURN 0
			ENDIF
		ELSEIF RESULT == 4
			;４．観光客
			LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2) - RAND:20
			IF LOCAL < 30
				CFLAG:ARG:우호도 -= RAND:50
				;失敗
				PRINTFORMW 「어허, 관광에까지 그런 무기를 들고나와야 할 정도로 세상이 흉흉해졌단 말인가!」
				PRINTFORMW 「이런이런… 어쩐지 아무도 %CSTR:ARG:일인칭%를 공경하지 않게 되었더라니…」
				RETURN 5
			ELSE
				CFLAG:ARG:우호도 += RAND:30
				;成功
				PRINTFORMW 「어허, 요즘 세상의 여행자는 이런 곳까지 관광을 온단 말인가?」
				PRINTFORMW 「으으음… 이것 참 새로운 신앙을 얻을 기회일지도 모르겠구먼!」
				RETURN 0
			ENDIF
		ELSE
			GOTO INPUT_LOOP1
