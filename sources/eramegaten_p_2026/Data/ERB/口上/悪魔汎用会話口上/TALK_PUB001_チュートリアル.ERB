;=====================================================================
;口調タイプ：女・子供の汎用口上＋会話用ファイルです
;=====================================================================
@KOJO_TALK_PUB1,ARG,ARG:1
SELECTCASE ARG:1
	CASE 62
		;62:仲魔になる
		PRINTFORML 「인간이란, 정말 재밌어요오!」
		PRINTFORMW 「친구 되는 거에요오!」
		PRINTFORML 「%STR:(ABL:ARG:종족)% %CALLNAME:ARG%에요오!」
		PRINTFORMW 「앞으로도 잘 부탁해요오!」
ENDSELECT

;===========================================================================
;会話時挨拶
;===========================================================================
@GREET_PUB1,ARG
CALL GREET_TUTORIAL, ARG
WHILE 1
	SELECTCASE RESULT
		CASE 1
			RETURN 1
		CASE 3
			PRINTFORML …그렇다고 싸우고 싶은 건 아니에요오!
			PRINTFORMW 좀 더 제대로 해줘요! 다시 할 거라구요오!
		CASE 4
			PRINTFORML 하아, 이상한 소리만 하니까 살짝 화나버렸잖아요오
			PRINTFORMW 다시 한번 처음부터 할 테니까 이번엔 똑바로 하는 거에요오
		CASE 5
			PRINTFORML ……그렇다고 도망치면 안 돼요오. 이제 이런 곳에 있고 싶지 않단 말이에요
			PRINTFORMW 후우~ 하아~. 자, 이야기를 계속하는 거에요오
		CASE 6
			PRINTFORML
			PRINTFORMW 분위기가 어색해졌다……
			PRINTFORML
	ENDSELECT
	CALL QUESTION_TUTORIAL, ARG
	IF RESULT == 0
		PRINTFORML 그럼, 마석을 원해요오…라고 할 참이지만
		PRINTFORMW 이번엔 봐주는 거에요오. 감사해야 해요오
		RETURN 1
	ENDIF
WEND

@GREET_TUTORIAL, ARG
PRINTFORML 「%CSTR:ARG:일인칭%와(과) 친구가 되고 싶다는 거에요오?」
PRINTFORML 「이런 곳에 있고 싶지도 않으니까 환영이지만…」
PRINTFORMW 「엄마가 서머너랑 계약할 때는 제대로 이야기하라고 했으니까 이야기해 보는 거에요오」

PRINTFORML

;質問を増やした場合、RAND:XのXを増やす
;RETURNの値により回答後の雰囲気が変わる。
;0.会話継続 1.直接仲魔になる 2.何かくれる 3.奇襲される 4.敵対する 5.逃げる 6.気まずくなる

;基本確率設定
LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
SELECTCASE RAND:2
	CASE 0
		PRINTFORMW 「그래서, 어떤 걸 묻고 싶은 건가요오?」
		PRINTFORML
		PRINTFORML [1]사귀는 남자아이는 있어?　[2]흥미 있는 일은?
		PRINTFORML [3]지금 몇 시?　　　　　　　　[4]좋아하는 플레이는?
		CALL INPUTINT(1, 2, 3, 4)
		PRINTFORML 
		;つき合ってる男の子は？
		IF RESULT == 1
			;大失敗率
			LOCAL:1 = 15 + TALENT:ARG:교만 * 100
			;失敗率
			LOCAL:2 = 15 + LOCAL:1 + TALENT:ARG:얌전함 * 30 + TALENT:ARG:보수적 * 30
			;成功率
			LOCAL:3 = 60 + LOCAL:2 + TALENT:ARG:냉정 * 30 + TALENT:ARG:교활 * 30
			;大成功率
			LOCAL:4 = 10 + LOCAL:3 + TALENT:ARG:솔직함 * 30 + TALENT:ARG:호기심 * 30
			LOCAL = LOCAL * LOCAL:4 / 100
			IF LOCAL < LOCAL:1
				CFLAG:ARG:우호도 -= RAND:50
				;大失敗
				PRINTFORMW 「왜 그런 걸 %CSTR:ARG:이인칭%한테 가르쳐줘야 하는 건가요오!」
				IF RAND:3
					RETURN 4
				ELSE
					PRINTFORMW 「사귀는 남자아이가 없는 게 그렇게 나쁜 일인가요오!」
					RETURN 3
				ENDIF
			ELSEIF LOCAL < LOCAL:2
				;失敗
				CFLAG:ARG:우호도 += RAND:10 - 20
				PRINTFORMW 「그, 그런 거언……」
				PRINTFORMW 「대답 못 해요오……」
				RETURN 0
			ELSEIF LOCAL < LOCAL:3
				CFLAG:ARG:우호도 += RAND:20
				;大成功
				PRINTFORMW 「그건 비밀이에요오!」
				PRINTFORMW 「꺄하핫!」
				RETURN 0
			ELSE
				CFLAG:ARG:우호도 += RAND:50
				;大成功
				PRINTFORMW 「사귀진 않지만, 신경 쓰이는 애는 있어요오」
				PRINTFORMW 「아, 아무한테도 말하면 안 돼요오!」
				RETURN 0
			ENDIF
		ELSEIF RESULT == 2
			;興味のあることは？
			;大失敗率
			LOCAL:1 = 0
			;失敗率
			LOCAL:2 = 30 + LOCAL:1 + TALENT:ARG:현명 * 50
			;成功率
			LOCAL:3 = 70 + LOCAL:2 + TALENT:ARG:우애 * 50
			;大成功率
			LOCAL:4 = 0
			LOCAL = LOCAL * LOCAL:4 / 100
			IF LOCAL < LOCAL:2
				CFLAG:ARG:우호도 -= RAND:50
				;失敗
				PRINTFORMW 「그런 질문, 시시해요오!」
				PRINTFORMW 「기대 이하에요오!」
				RETURN 6
			ELSE
				CFLAG:ARG:우호도 += RAND:30
				;成功
				PRINTFORMW 「%CSTR:ARG:일인칭%, %CSTR:ARG:이인칭%에게 흥미진진이에요오!」
				RETURN 0
			ENDIF
		ELSEIF RESULT == 3
			;今、何時？
			;大失敗率
			LOCAL:1 = 30 + TALENT:ARG:교만 * 50 
			;失敗率
			LOCAL:2 = 30 + LOCAL:1
			;成功率
			LOCAL:3 = 20 + LOCAL:2 + TALENT:ARG:현명 * 50
			;大成功率
			LOCAL:4 = 20 + TALENT:ARG:우애 * 50
			LOCAL = LOCAL * LOCAL:4 / 100
			;大失敗
			IF LOCAL < LOCAL:1
				CFLAG:ARG:우호도 -= RAND:50
				PRINTFORMW 「%CSTR:ARG:이인칭%, 너무해요오!」
				;1/3で敵対コース
				IF RAND:3
					RETURN 6
				ELSE
					PRINTFORMW 「%CSTR:ARG:일인칭%, 이제 뾰로통해졌어요오!」
					RETURN 4
				ENDIF
			;失敗
			ELSEIF LOCAL < LOCAL:2
				CFLAG:ARG:우호도 -= RAND:10
				PRINTFORMW 「그, 그럴 수가아……」
				PRINTFORMW 「혹시 %CSTR:ARG:일인칭%한테 관심 없는 건가요오?」
				RETURN 0
			;成功
			ELSEIF LOCAL < LOCAL:3
				CFLAG:ARG:우호도 += RAND:30
				PRINTFORMW 「%CSTR:ARG:이인칭%, 어른인데 시계도 안 차고 있나요오?」
				PRINTFORMW 「후후, 그거 엄청 부끄러운 거에요오」
				RETURN 0
			;成功
			ELSE
				CFLAG:ARG:우호도 += RAND:10
				PRINTFORMW 「에ー 그러니까, 미안해요오」
				PRINTFORMW 「%CSTR:ARG:일인칭%, 시계 안 갖고 있어요오」
				RETURN 0
			ENDIF
		ELSE
			;好きなプレイは？
			;失敗率
			LOCAL:1 = 30 + TALENT:ARG:우둔 * 50
			SIF TALENT:ARG:현명
				LOCAL:1 = 0
			;失敗率
			LOCAL:2 = TALENT:ARG:현명 * 25 + TALENT:ARG:교활 * 25 + LOCAL:1
			;成功率
			LOCAL:3 = 20 + LOCAL:2 + TALENT:ARG:우애 * 50
			;大成功率
			LOCAL:4 = 0 + TALENT:ARG:현명 * 100 + TALENT:ARG:교활 * 50
			LOCAL = LOCAL * LOCAL:4 / 100
			;失敗
			IF LOCAL < LOCAL:1
				CFLAG:ARG:우호도 -= RAND:50
				PRINTFORML 「좋아하는 놀이?」
				PRINTFORMW 「%CSTR:ARG:일인칭%을(를) 어린애 취급하지 말았으면 좋겠어요오」
				RETURN 6
			ELSEIF LOCAL < LOCAL:2
				CFLAG:ARG:우호도 -= RAND:30
				;失敗
				PRINTFORMW 「……왜 히죽히죽 웃고 있나요오?」
				PRINTFORMW 「%CSTR:ARG:이인칭%, 왠지 기분 나빠요오!」
				RETURN 0
			ELSEIF LOCAL < LOCAL:3
				CFLAG:ARG:우호도 += RAND:30
				;成功
				PRINTFORMW 「%CSTR:ARG:일인칭%은(는) 소꿉놀이를 좋아해요오」
				PRINTFORMW 「다음에 같이 해볼래요오?」
				RETURN 0
			ELSE
				CFLAG:ARG:우호도 += RAND:50
				PRINTFORMW 「싫다, %CSTR:ARG:이인칭%, 그거 성희롱이에요오!」
				RETURN 0
			ENDIF
		ENDIF
	CASE 1
		PRINTFORMW 「그래서, 볼일은 뭔데요오?」
		PRINTFORML
		PRINTFORML [1]칭찬한다　　[2]설득한다
		PRINTFORML [3]\@TALENT:PLAYER:남자?눈으로 제압한다#뇌쇄한다\@　[4]주먹으로 말한다
		CALL INPUTINT(1, 2, 3, 4)
		PRINTFORML 
		;褒める
		IF RESULT == 1
			;大失敗率
			LOCAL:1 = 20 + TALENT:ARG:현명 * 50
			;失敗率
			LOCAL:2 = 20 + LOCAL:1
			;成功率
			LOCAL:3 = 30 + LOCAL:2 + TALENT:ARG:교만 * 50
			;大成功率
			LOCAL:4 = 30 + LOCAL:3+ TALENT:ARG:우둔 * 50
			LOCAL = LOCAL * LOCAL:4 / 100
			IF LOCAL < LOCAL:1
				CFLAG:ARG:우호도 -= RAND:30
				PRINTFORMW 「%CSTR:ARG:일인칭%을(를) 어린애 취급하지 말았으면 좋겠어요오!!」
				RETURN 6
			;失敗
			ELSEIF LOCAL < LOCAL:2
				CFLAG:ARG:우호도 -= RAND:30
				PRINTFORMW 「왠지 엄청 대충대충인 것 같아요오!」
				SIF RAND:(4 + TALENT:ARG:영맹 - 2)
					RETURN 0
				PRINTFORMW 「%CSTR:ARG:일인칭%, 이제 뾰로통해졌어요오!」
				RETURN 4
			ELSEIF LOCAL < LOCAL:3
				CFLAG:ARG:우호도 += RAND:30
				PRINTFORMW 「꺄하핫!」
				PRINTFORMW 「%CSTR:ARG:이인칭%, 칭찬을 참 잘하네요오!」
				RETURN 0
			ELSE
				CFLAG:ARG:우호도 += RAND:30
				PRINTFORMW 「꺄하핫!」
				PRINTFORMW 「혹시 %CSTR:ARG:일인칭%을(를) 좋아하는 건가요오?」
				RETURN 0
			ENDIF
		;説得する
		ELSEIF RESULT == 2
			;失敗率　属性が離れている場合
			LOCAL:1 = ABS(ABL:PLAYER:속성LD - ABL:ARG:속성LD) * 50 + ABS(ABL:PLAYER:속성LC - ABL:ARG:속성LC) * 50
			;失敗率
			LOCAL:2 = 50 + LOCAL:1 + TALENT:ARG:교만 * 100
			;成功率　属性が近い場合
			LOCAL:3 = LOCAL:2 + 200 - ABS(ABL:PLAYER:속성LD - ABL:ARG:속성LD) * 50 - ABS(ABL:PLAYER:속성LC - ABL:ARG:속성LC) * 50 + LOCAL:2
			;成功率
			LOCAL:4 = 50 + LOCAL:3 + TALENT:ARG:교활 * 50
			LOCAL = LOCAL * LOCAL:4 / 100
			;失敗
			IF LOCAL < LOCAL:1
				CFLAG:ARG:우호도 -= RAND:50
				PRINTFORMW 「그런 말을 들어도, %CSTR:ARG:이인칭% 같은 사람 말은 못 믿겠어요오!」
				RETURN 6
			;失敗
			ELSEIF LOCAL < LOCAL:2
				CFLAG:ARG:우호도 -= RAND:30
				PRINTFORMW 「%CSTR:ARG:이인칭%, 엄청 거만해 보여요오!」
				PRINTFORMW 「%CSTR:ARG:일인칭%, 그런 거 안 좋아해요오!」
				RETURN 6
			ELSEIF LOCAL < LOCAL:3
				CFLAG:ARG:우호도 += RAND:30
				PRINTFORMW 「%CSTR:ARG:이인칭%의 이야기에 %CSTR:ARG:일인칭%, 감격했어요오!」
				PRINTFORMW 「%CSTR:ARG:일인칭%한테 %CSTR:ARG:이인칭%을(를) 돕게 해주면 좋겠어요오!」
				RETURN 1
			ELSE
				CFLAG:ARG:우호도 += RAND:30
				PRINTFORMW 「%CSTR:ARG:이인칭%, %CSTR:ARG:일인칭%이(가) 필요하군요오」
				PRINTFORMW 「으ー음, 조금만 생각할 시간을 줬으면 좋겠어요오」
				RETURN 0
			ENDIF
		;目で殺す
		ELSEIF RESULT == 3 && TALENT:PLAYER:남자
			;失敗率
			LOCAL:1 = 20 + TALENT:ARG:우둔 * 50
			;失敗率
			LOCAL:2 = 20 + LOCAL:1 + TALENT:ARG:교만 * 50
			;成功率
			LOCAL:3 = 30 + LOCAL:2 + TALENT:ARG:우애 * 50 + TALENT:ARG:호기심 * 20
			;成功率
			LOCAL:4 = 30 + LOCAL:3 + TALENT:ARG:현명 * 50 + TALENT:PLAYER:수수께끼의매력 * 100
			LOCAL = LOCAL * LOCAL:4 / 100
			;失敗
			IF LOCAL < LOCAL:1
				CFLAG:ARG:우호도 -= RAND:20
				PRINTFORMW 「%CSTR:ARG:이인칭%, 왠지 무서워요오」
				PRINTFORMW 「%CSTR:ARG:일인칭%을(를) 때리거나 하진 않겠죠…」
				RETURN 6
			;失敗
			ELSEIF LOCAL < LOCAL:2
				CFLAG:ARG:우호도 -= RAND:50
				PRINTFORMW 「빤히 쳐다보지 말았으면 좋겠어요오」
				PRINTFORMW 「그런 건 민폐라구요오!」
				RETURN 6
			ELSEIF LOCAL < LOCAL:3
				CFLAG:ARG:우호도 += RAND:10
				PRINTFORMW 「왜 아무 말도 안 하는 걸까나아?」
				PRINTFORMW 「신경 쓰여요오」
				RETURN 0
			ELSE
				CFLAG:ARG:우호도 += RAND:30
				PRINTFORMW 「그 눈빛, 혹시……」
				RETURN 0
			ENDIF
		;悩殺する
		ELSEIF RESULT == 3
			;失敗率
			LOCAL:1 = 10 + TALENT:ARG:현명 * 50
			;失敗率
			LOCAL:2 = 40 + LOCAL:1 + TALENT:ARG:겁쟁이 * 20 - TALENT:ARG:호기심 * 20
			;成功率
			LOCAL:3 = 40 + LOCAL:2 + TALENT:ARG:우둔 * 50 + TALENT:ARG:우애 * 50 + TALENT:ARG:호기심 * 20
			;成功率
			LOCAL:4 = 10 + LOCAL:3 + TALENT:PLAYER:수수께끼의매력 * 100
			LOCAL = LOCAL * LOCAL:4 / 100
			;失敗
			IF LOCAL < LOCAL:1
				CFLAG:ARG:우호도 -= RAND:50
				PRINTFORMW 「%CSTR:ARG:일인칭%, 여자아이라구요오…」
				PRINTFORMW 「어, 어떻게 할 생각인가요오…」
				RETURN 6
			;失敗
			ELSEIF LOCAL < LOCAL:2
				CFLAG:ARG:우호도 -= RAND:50
				PRINTFORMW 「저, 저기, %CSTR:ARG:일인칭%은(는) 남자아이가 더 좋으니까」
				PRINTFORMW 「그게에…… 미안해요!」
				RETURN 5
			ELSEIF LOCAL < LOCAL:3
				CFLAG:ARG:우호도 += RAND:10
				PRINTFORMW 「몸을 꼬면서 왜 그러는 거에요오?」
				PRINTFORMW 「어디 몸이라도 안 좋은 건가요오?」
				RETURN 0
			ELSE
				CFLAG:ARG:우호도 += RAND:30
				PRINTFORMW 「%CSTR:ARG:이인칭%, 예뻐요오…」
				RETURN 0
			ENDIF
		;拳で語る
		ELSE
			;失敗率
			LOCAL:1 = 20 + TALENT:ARG:영맹 * 200 + TALENT:ARG:반항적 * 100
			;失敗率
			LOCAL:2 = 40 + LOCAL:1 + TALENT:ARG:겁쟁이 * 50
			;成功率
			LOCAL:3 = 20 + LOCAL:2 + TALENT:ARG:겁쟁이 * 20 + TALENT:ARG:얌전함 * 20 + TALENT:ARG:솔직함 * 20
			;成功率
			LOCAL:4 = 20 + LOCAL:3 + TALENT:ARG:교활 * 50 + TALENT:ARG:냉정 * 50
			LOCAL = LOCAL * LOCAL:4 / 100
			;失敗
			IF LOCAL < LOCAL:1
				CFLAG:ARG:우호도 -= RAND:50
				PRINTFORMW 「그거, %CSTR:ARG:일인칭%이(가) 어린애라고 얕보지 말았으면 좋겠어요오!」
				PRINTFORMW 「그런 거 절대 용서 안 할 거니까아!」
				RETURN 4
			;失敗
			ELSEIF LOCAL < LOCAL:2
				CFLAG:ARG:우호도 -= RAND:50
				PRINTFORMW 「무, 무서워요오…… 엄마아!」
				RETURN 5
			ELSEIF LOCAL < LOCAL:3
				CFLAG:ARG:우호도 -= RAND:10
				PRINTFORMW 「그, 그런 짓을 당하면 %CSTR:ARG:일인칭%은(는)…」
				PRINTFORMW 「뭐든지 말 잘 들을 테니까 그만둬줘요오」
				RETURN 1
			ELSE
				CFLAG:ARG:우호도 -= RAND:10
				PRINTFORMW 「무, 뭘 하는 거에요오」
				PRINTFORMW 「아, 알았어요오. 동마가 되면 되는 거죠?」
				RETURN 1
			ENDIF
		ENDIF
ENDSELECT

;===========================================================================
;会話時問答
;===========================================================================
@QUESTION_TUTORIAL,ARG,ARG:1
;RAND:X (Xは問答の個数)

PRINTFORML
CUSTOMDRAWLINE ･
PRINTFORML

DO

	RESULT:1 = RAND:8
	;基本確率設定
	LOCAL = RAND:100 + RAND:(MAXBASE:PLAYER:지혜+MAXBASE:PLAYER:운/2)
	SELECTCASE RESULT:1
		CASE 0
			PRINTFORMW 「%CSTR:ARG:일인칭%, 질문이 이써요오!」
