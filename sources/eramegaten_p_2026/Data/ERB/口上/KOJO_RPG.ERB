@GET_BATTLE_EVENT_NUM, ARGS
#FUNCTION
#DIM LCOUNT
#DIMS NAME_TABLE, 101
IF NAME_TABLE == ""
	FOR LCOUNT, 0, 101
		NAME_TABLE:LCOUNT = %GET_BATTLE_EVENT(LCOUNT)%
	NEXT
ENDIF
SIF FINDELEMENT(NAME_TABLE, ARGS, , , 1) == -1
	THROW 名称指定ミス【%ARGS%】
RETURNF FINDELEMENT(NAME_TABLE, ARGS, , , 1)

