;-------------------------------------------------;ライセンスについて
;	・基本項目(許可する項目を"○"に、許可しない項目を"×"に変更してください。)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1| ○ | 処理上のバグ修正              |
;	+----+----+-------------------------------+
;	|   2| ○ | 口上の誤字・脱字の修正        |
;	+----+----+-------------------------------+
;	|   3| ○ | 口上まとめへの収録            |
;	+----+----+-------------------------------+
;	|   4| ○ | 口上の新規追加                |
;	+----+----+-------------------------------+
;	|   5| ○ | 既存口上の改変                |
;	+----+----+-------------------------------+
;	|   6| ○ | 改変した口上の自由な再配布    |
;	+----+----+-------------------------------+
;	|   7| ○ | 口上内容の転載                |
;	+----+----+-------------------------------+
;-------------------------------------------------
;【性格とか】
;崩壊：スターレイルに登場するヘルタの戦闘用口上。
;人に勝る知恵を持つが、まったく共感力がない大科学者。
;自分が興味を持ったことにしか手を付けず、一旦興味を失えばすぐに離れてしまう
;ナチュラル傲慢。
;達人なので、特定の技以外は発動系は不要。

@ENEMY_BATTLE_EVENT_K[[キャラ:헤르타]], ARG, ARG:1, ARG:2
IF TFLAG:전투이벤트 == 1
;敵でのデビルＣＯ－ＯＰ発動時の台詞
;			BTL_KOJO_RESULTS:0 =
ENDIF
IF TFLAG:전투이벤트 == 2
;敵でのデビルＣＯ－ＯＰ参加時の台詞
;			BTL_KOJO_RESULTS:0 =
ENDIF

@KOJO_BATTLE_EVENT_K[[キャラ:헤르타]], ARG, ARG:1, ARG:2
SELECTCASE GET_BATTLE_EVENT(TFLAG:전투이벤트)
	;味方パーティでのデビルＣＯ－ＯＰ発動時の台詞
	CASE "COOP発動"
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = さっさと続いて
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = あとは頑張って
		ELSE
			BTL_KOJO_RESULTS:0 = 早くして
		ENDIF
	;味方パーティでのデビルＣＯ－ＯＰ参加時の台詞
	CASE "COOP参加"
		;あなたが発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%。手伝ってあげる。感謝してね
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 私の時間は貴重なんだよ？%CSTR:이인칭%
			ELSE
				BTL_KOJO_RESULTS:0 = 早くしよう
			ENDIF
		;それ以外
		ELSE
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 手伝ってあげる。感謝してね
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 私の時間は貴重なんだよ？
			ELSE
				BTL_KOJO_RESULTS:0 = じゃあ私も少しだけ
			ENDIF
		ENDIF
	CASE "与ダメージ_単体"
		;攻撃して殺害した
		IF BASE:(ARG:1):ＨＰ <= 0
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 観察終了。つまんない結果
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = はい、おしまい。データとしては…ギリ合格
			ELSE
				BTL_KOJO_RESULTS:0 = 飽きちゃった
			ENDIF
		;攻撃したけど吸収された
		ELSEIF ARG:2 < 0
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = いやなやつ
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = はぁ？
			ELSE
				BTL_KOJO_RESULTS:0 = あーー面倒
			ENDIF
		ENDIF
	CASE "追撃発動"
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = くるくる～～っと
		ELSE
			BTL_KOJO_RESULTS:0 = くるりん～っと
		ENDIF
	CASE "被ダメージ_単体"
		;被弾（死亡）
		IF BASE:ARG:ＨＰ <= 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 戦闘……不能……
			ELSE
				BTL_KOJO_RESULTS:0 = 機能……停止……
			ENDIF
		;残り１５％以下
		ELSEIF 現HP割合(ARG) < 15
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 壊れちゃう！
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 損傷甚大
			ELSE
				BTL_KOJO_RESULTS:0 = この程度で壊れる設計じゃないのに……
			ENDIF
		;被弾
		ELSE
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 壊れないよ
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = それで攻撃したつもり？
			ELSE
				BTL_KOJO_RESULTS:0 = やるじゃん
			ENDIF
		ENDIF
		
	;外した
	CASE "回避された"
		BTL_KOJO_RESULTS:0 = 運が良かったね
	;회피
	CASE "回避した"
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 当たると思った？
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 無駄打ち、お疲れさま
		ELSE
			BTL_KOJO_RESULTS:0 = 目をつむっていても避けられる
		ENDIF
	;反射された
	CASE "反射された"
		BTL_KOJO_RESULTS:0 = 건방짐！
	;反射
	CASE "反射した"
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = いらないから、あげるね～
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = つまんないの
		ELSE
			BTL_KOJO_RESULTS:0 = それじゃあダメだよ
		ENDIF
	;バトルに勝利した
	CASE "戦闘勝利"
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 私の時間がパーになっちゃった！
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = どう？私が興味を持てそうなものはある？
		ELSE
			BTL_KOJO_RESULTS:0 = %CSTR:이인칭%。早く行くよ
		ENDIF
	;レベルアップした
	CASE "レベルアップ"
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = バージョンアップグレード？なんかイマイチ
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = はいはい、この体を酷使するのはやめて
		ELSE
			BTL_KOJO_RESULTS:0 = ただの人形なんだから、あんまり期待しないで
		ENDIF
	;逃走に成功した
	CASE "逃走成功"
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 次はもう少し面白い物がいいな
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 退くのも選択肢よ
		ELSE
			BTL_KOJO_RESULTS:0 = 計算通り
		ENDIF
	;逃走に失敗した
	CASE "逃走失敗"
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = あーもう、こういう時に限って……
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = %CSTR:이인칭%。さっさとやろう
		ELSE
			BTL_KOJO_RESULTS:0 = 私の時間は貴重なんだよ？
		ENDIF
	;戦闘開始時
	CASE "先制攻撃"
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = パーツアップグレード
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = どう始末するかは、私の気分次第よ
		ELSE
			BTL_KOJO_RESULTS:0 = %CSTR:이인칭%。早くやるよ
		ENDIF
	CASE "戦闘開始時"
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = パーツアップグレード
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 私の貴重な時間を無駄にするなんて
		ELSE
			BTL_KOJO_RESULTS:0 = 私の邪魔をするの？
		ENDIF
	;戦闘開始時・バックアタックを受けた
	CASE "バックアタック"
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 後ろ？
		ELSE
			BTL_KOJO_RESULTS:0 = 不愉快ね
		ENDIF
	;戦闘開始時・先制攻撃を受けた
	CASE "不意打ち"
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 不意打ち？
		ELSE
			BTL_KOJO_RESULTS:0 = 不愉快ね
		ENDIF
ENDSELECT



@KOJO_BATTLE_MESSAGE_K[[キャラ:헤르타]],ARG,ARG:1 = 0
CALL GET_SKILL_PROP, "SKILL_NAME", CFLAG:ARG:입력행동, ARG
;使用したスキルの名前をLOCALSに代入
LOCALS = %RESULTS%
;ターゲットが単体なら事前に対象のキャラをLOCALに保存しておく
LOCAL = -1
SIF INRANGE(CFLAG:ARG:타겟, 1, 16)
	LOCAL = POS(CFLAG:ARG:타겟)

;ちょっとした記憶用の領域を確保
LOCAL:1 = 0


;通常攻撃
IF CFLAG:ARG:입력행동 == 0
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = ど～んっと
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 痛くしてあげる
	ELSE
		BTL_KOJO_RESULTS:0 = はいはい
	ENDIF
;GUN
ELSEIF CFLAG:ARG:입력행동 == [[스킬:ＧＵＮ]]
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = ば～んっと
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = ばん！
	ELSE
		BTL_KOJO_RESULTS:0 = これ、あげるね～
	ENDIF
;전용기1/何見てるの
ELSEIF CFLAG:ARG:입력행동 == [[스킬:전용기1]]
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 何見てるの？
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 痛くしてあげる
	ELSE
		BTL_KOJO_RESULTS:0 = はいはい
	ENDIF
;전용기2/一度限りの取引
ELSEIF CFLAG:ARG:입력행동 == [[스킬:전용기2]]
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = ちょっとは静かになさい！
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 何見てるの？
	ELSE
		BTL_KOJO_RESULTS:0 = はいはい
	ENDIF
;전용기3/私がかけた魔法だよ
ELSEIF CFLAG:ARG:입력행동 == [[스킬:전용기3]]
	IF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 私が誰だか知ってるの？
	ELSE
		BTL_KOJO_RESULTS:0 = こんな大きなダイヤモンド見たことないでしょ？あげるね～
	ENDIF
;컨센트레이트
ELSEIF CFLAG:ARG:입력행동 == [[스킬:컨센트레이트]]
	IF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = パーツアップグレード
	ELSE
		BTL_KOJO_RESULTS:0 = 待機中……
	ENDIF
;ＣＨＡＮＧＥ
ELSEIF CFLAG:ARG:입력행동 == [[스킬:ＣＨＡＮＧＥ]]
	;相手が"あなた"
	IF LOCAL != -1 && LOCAL == MASTER
		BTL_KOJO_RESULTS:0 = %CSTR:이인칭%。ちょっと場所貸して。実験したいの
	;後ろに下がる
	ELSEIF RANGE((CFLAG:ARG:포지션),1,3) && RANGE((CFLAG:ARG:타겟),4,6)
		BTL_KOJO_RESULTS:0 = 前はもう飽きちゃった
	;前に出る
	ELSEIF RANGE((CFLAG:ARG:포지션),4,6) && RANGE((CFLAG:ARG:타겟),1,3)
		BTL_KOJO_RESULTS:0 = 退いて。私がやるから
	;左右を替わる
	ELSEIF LOCAL != -1
		BTL_KOJO_RESULTS:0 = 今度はそっち
	ENDIF
;행동불능
ELSEIF CFLAG:ARG:입력행동 == [[스킬:행동불능]]
	BTL_KOJO_RESULTS:0 = フリーズ……再起動が必要かな
;金ばらまき
ELSEIF CFLAG:ARG:입력행동 == [[스킬:금전뿌리기]]
	BTL_KOJO_RESULTS:0 = ……ちょっと！？
ENDIF
