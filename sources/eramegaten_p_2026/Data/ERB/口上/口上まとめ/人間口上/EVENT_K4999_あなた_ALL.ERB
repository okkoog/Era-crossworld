;-------------------------------------------------
;輪姦時の口上
;CASE 0 内は必ず通るようになっており
;RETURNで0を返すと、この後通常の輪姦行動を出します
;CFLAGは使っていません
;COMF201_輪姦内でLOCALを使っているので使いません
;-------------------------------------------------
@KOJO_MESSAGE_RINKAN_K[[キャラ:당신]], ARG:1 , ARG:2

FOR COUNT,0,51
	LOCALS:COUNT = 
NEXT

SELECTCASE ARG:1
	CASE 0
	;CASE 0은 오리지널 윤간 구상
	;C:1회당 귀가 인수 D：흥분도 증가(및 감소)
	;C와 D는 오리지널 윤간 구상 내에서만 사용
	;C += 、D += 를 사용
		IF ARG:2 == 1
		;하드ON

		ELSE
		;하드OFF

		ENDIF
	;하드계
	;가슴을 밟힌다（거유ㆍ폭유만）
	CASE 1
		IF (陥落(TARGET)) && (CFLAG:221 < 3)
			;恋慕、親愛
			IF (TALENT:연모 || TALENT:친애)
				LOCALS:0 = 
			;淫乱、娼婦
			ELSEIF (TALENT:음란 || TALENT:창부)
				IF RAND:2 == 0
					LOCALS:0 = 가슴을 짓밟히는 고통을 견디지 못하고, 울면서 더욱 짓밟아 주기를 애원하는 %CALLNAME:TARGET%에게,
					LOCALS:1 = 남자는 힘을 늦추지 않고 유방을 계속 짓밟았다…
				ELSE
					LOCALS:0 = 가슴을 짓밟히는 고통을 견디지 못하고, 비명과 함께 눈물을 흘리며 용서를 구하는 %CALLNAME:TARGET%이지만,
					LOCALS:1 = 남자는 힘을 늦추지 않고 유방을 계속 짓밟았다…
				ENDIF
			;服従、隷属
			ELSEIF (TALENT:복종 || TALENT:예속)
				LOCALS:0 = 
			ENDIF
			;陥落済み共通
			IF LOCALS:0 == ""
				LOCALS:0 = 
			ENDIF
		ENDIF
		;屈服刻印Lv3
		IF MARK:굴복각인 == 3 && (CFLAG:221 < 2) && LOCALS:0 == ""
			LOCALS:0 = 
		ENDIF
		;それ以外
		IF (CFLAG:221 < 1) && LOCALS:0 == ""
			PRINTFORML 
		ENDIF
	;頭を踏まれる
	CASE 2

	;폭력을 당하다
	CASE 3

	;담배빵
	;흥분도가 낮고, 반항적, 꿋꿋함, 프라이드높음, 건방짐, 저항을 가지고 있다
	CASE 4

	;지면에 늘어진 정액 핥아먹인다
	;마조끼３이상
	CASE 5
		IF ABL:정액중독 >= 5 && RAND:3 == 0
			LOCALS:0 = 굴욕을 느끼면서도, %CALLNAME:TARGET%은(는) 정액을 핥아 삼키는 행위를 멈추지 못하고 있다
			LOCALS:1 = 이윽고 정액을 다 핥아먹어 버리고는, 다음 것을 원하며 눈앞의 페니스에 매달려 빨아대고 있었다
		ELSEIF ABL:정액중독 >= 3 && RAND:2 == 0
			LOCALS:0 = 굴욕을 느끼면서도, %CALLNAME:TARGET%은(는) 어느샌가 정액을 핥는 행위에 흥분해 버리고 있었다
		ELSE
			LOCALS:0 = 굴욕을 느끼며, %CALLNAME:TARGET%은(는) 정액과 모래알을 억지로 핥아야 했다
		ENDIF
	;体に落書きをされて犯される
	CASE 6
		LOCALS:0 = 「좀 더… 좀 더 범해줘어어…」
	;엉덩이를 치켜올려 뒤로부터 범해지면서, 머리를 짓밟혀 굴욕으로 글썽이는 상태
	CASE 7
		LOCALS:0 = 「암컷 주제에 암컷을 조교하다니 건방지잖아. 내가 남자의 맛을 똑똑히 가르쳐주지」
		LOCALS:1 = %CALLNAME:TARGET%의 몸에 사내들이 완력으로 굴욕을 새겨넣어 간다…
	;通常系
	;淫乱系で目の前に棒並べられて、どれが欲しいか選ばせるとか（淫乱・娼婦のみ）
	CASE 8
		LOCALS:0 = 「어이쿠, 이 녀석 제일 큰 걸 골라잡았다고」「그럼 다음은 내 차례지」「시끄러워! 처음은 나잖아」
		LOCALS:1 = %CALLNAME:TARGET%의 구멍에 첫 번째 사내가 대물을 비틀어 넣었다
	;巨乳以上のキャラだと「その乳は飾りか？遊ばせてるんじゃねえ」とか罵られパイズリする（巨乳・爆乳のみ）
	CASE 9
		IF RAND:2 == 0
			LOCALS:0 = %CALLNAME:TARGET%은(는) 밑에서 꿰뚫리면서도 스스로 유방을 들어 올려 눈앞의 사내에게 바쳤다
			LOCALS:1 = 「칫, 직접 움직이라는 거냐? 어쩔 수 없구만」
			LOCALS:2 = 사내는 유방을 쥐고 세로 파이즈리를 시작했다
		ELSE
			LOCALS:0 = %CALLNAME:TARGET%은(는) 밑의 사내를 향해 허리를 흔들며 눈앞의 사내 페니스에 가슴을 밀착시켜 끼워 넣었다
			LOCALS:1 = 「칫, 직접 움직이라는 거냐? 어쩔 수 없구만」
			LOCALS:2 = 사내는 허리를 흔들며 %CALLNAME:TARGET%의 유방을 탐하기 시작했다
		ENDIF
	;挿れられるのだけは回避しようと必死に口と手で群がるチンポにご奉仕する（恋幕・親愛のみ）
	CASE 10

	;;양구멍을 뚫리면서 억지로 미소와 피스싸인을 취하게 시켜져 기념촬영
	CASE 11
		IF RAND:2 == 0
			LOCALS:0 = 「자, 찍는다─ 브이 해봐 브이」「아저씨 비켜, 뒤로 물러나」「아저씨 아니거든!」
			LOCALS:1 = 사내들이 떠드는 사이, %CALLNAME:TARGET%은(는) 절정과 수치, 공포로 희미해진 의식 속에서 간신히 브이 사인을 만들었다
