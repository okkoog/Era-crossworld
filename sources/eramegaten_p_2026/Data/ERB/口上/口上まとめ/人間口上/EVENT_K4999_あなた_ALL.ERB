;	RETURN 0
;ENDIF
;--------------------------------------------------
;調教終了時のセリフ
;--------------------------------------------------
DRAWLINE
;反発刻印Lv3
IF MARK:반발각인 == 3 && (CFLAG:217 < 1)
	PRINTFORMW 
	CFLAG:217 = 1
;屈服刻印Lv1以下
ELSEIF MARK:굴복각인 <= 1 && (CFLAG:219 < 1)
	PRINTFORMW 
	CFLAG:219 = 1
;屈服刻印Lv2
ELSEIF MARK:굴복각인 == 2
	PRINTFORMW 
	CFLAG:219 = 2
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:굴복각인 == 3 && !陥落(TARGET)
	PRINTFORMW 
	CFLAG:219 = 3
;陥落済み＋体力500未満
ELSEIF BASE:0 < 500 && (CFLAG:218 < 1)
	;연모, 친애
	IF TALENT:연모 || TALENT:친애
		PRINTFORMW 
	;음란, 창부
	ELSEIF TALENT:음란 || TALENT:창부
		PRINTFORMW 
	;복종, 예속
	ELSEIF TALENT:복종 || TALENT:예속
		PRINTFORMW 
	ENDIF
	CFLAG:218 = 1
;陥落済み
ELSEIF CFLAG:219 < 4
	;연모, 친애
	IF TALENT:연모 || TALENT:친애
		PRINTFORMW 
	;음란, 창부
	ELSEIF TALENT:음란 || TALENT:창부
		PRINTFORMW 
	;복종, 예속
	ELSEIF TALENT:복종 || TALENT:예속
		PRINTFORMW 
	ENDIF
	CFLAG:219 = 4
ENDIF
RETURN 0

