;		IF 陥落(TARGET) && CFLAG:201 >= 5
;			PRINTFORMW 
		;그 이외
;		ELSE
;			PRINTFORMW 
;		ENDIF
;		CFLAG:203 = 1
	;2번째 이후
;	ELSEIF CFLAG:203 < 2 || FLAG:7 ==2
