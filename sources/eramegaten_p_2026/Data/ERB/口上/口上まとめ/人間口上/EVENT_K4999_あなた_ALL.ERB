;			PRINTFORMW 
;		ENDIF
;		CFLAG:203 = 2
;	ENDIF
;口上のある助手が居ない場合は、通常の二回目以降の口上へ飛ぶ
ELSE
	CALL EVENTTRAIN_SECOND_K[[キャラ:당신]]
ENDIF

;-------------------------------------------------
;調教開始時（2回目以降、4999をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_K[[キャラ:당신]]
FOR COUNT,0,51
	LOCALS:COUNT = 
	LOCAL:COUNT = 0
NEXT
;反発刻印Lv3
IF MARK:반발각인 == 3 && (CFLAG:202 < 4)
	PRINTFORML 
	CFLAG:202 = 4
;屈服刻印Lv0
ELSEIF MARK:굴복각인 == 0 && (CFLAG:202 < 1)
	PRINTFORML 
	CFLAG:202 = 1
;屈服刻印Lv1
ELSEIF MARK:굴복각인 == 1 && (CFLAG:202 < 2)
	PRINTFORML 
	CFLAG:202 = 2
;屈服刻印Lv2
ELSEIF MARK:굴복각인 == 2 && (CFLAG:202 < 3)
	PRINTFORML 
	CFLAG:202 = 3
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:굴복각인 == 3 && !陥落(TARGET) && (CFLAG:202 < 4)
	PRINTFORML 
	CFLAG:202 = 4
;陥落済み
ELSEIF CFLAG:202 < 5
	;연모, 친애
	IF TALENT:연모 || TALENT:친애
		;랜덤으로 구상을 변경한다（사용하지 않을 경우는 전부 같게 하면 된다）
		IF RAND:3 == 0
			LOCALS:0 = 
		ELSEIF RAND:2 == 0
			LOCALS:0 = 
		ELSE
			LOCALS:0 = 
		ENDIF
	;음란, 창부
	ELSEIF TALENT:음란 || TALENT:창부
		;랜덤으로 구상을 변경한다（사용하지 않을 경우는 전부 같게 하면 된다）
		IF RAND:3 == 0
			LOCALS:0 = 
		ELSEIF RAND:2 == 0
			LOCALS:0 = 
		ELSE
			LOCALS:0 = 
		ENDIF
	;복종, 예속
	ELSEIF TALENT:복종 || TALENT:예속
		;랜덤으로 구상을 변경한다（사용하지 않을 경우는 전부 같게 하면 된다）
		IF RAND:3 == 0
			LOCALS:0 = 
		ELSEIF RAND:2 == 0
			LOCALS:0 = 
		ELSE
			LOCALS:0 = 
		ENDIF
	ENDIF
	;그 외, 공통
	IF LOCALS:0 == ""
		;랜덤으로 구상을 변경한다（사용하지 않을 경우는 전부 같게 하면 된다）
		IF RAND:3 == 0
			PRINTFORML 
		ELSEIF RAND:2 == 0
			PRINTFORML 
		ELSE
			PRINTFORML 
		ENDIF
	ENDIF
	CFLAG:202 = 5
ENDIF
 
FOR COUNT,0,51
	SIF LOCALS:COUNT == ""
		BREAK
	PRINTFORM 
	IF LOCAL:COUNT
		PRINTW
	ELSE
		PRINTL
	ENDIF
NEXT
SIF LOCAL:COUNT == 0
	PRINTW
RETURN 0

