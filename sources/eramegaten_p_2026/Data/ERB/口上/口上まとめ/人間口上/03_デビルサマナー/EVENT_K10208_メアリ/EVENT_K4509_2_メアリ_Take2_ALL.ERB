		CFLAG:902 = 0
	SIF CFLAG:903 <= 0
		CFLAG:903 = 0
	SIF CFLAG:904 <= 0
		CFLAG:904 = 0
	SIF CFLAG:905 <= 0
		CFLAG:905 = 0
	SIF CFLAG:906 <= 0
