@Mary_K[[キャラ:메어리]]_sexp
;追加性経験処理
;P:0＝セックス、Z:10＝アナルセックス、Z:11＝フェラチオ、F:0＝メアリ絶頂、F:1＝あなた射精、F:2＝助手射精
;当関数呼び出し直前の行に、上記変数に代入することでメアリ・あなた・助手にそれぞれ経験が追加されますが、
;定型処理できないものもあるので、それらに関しては各処理箇所で経験を追加します。
;関数の最後にローカル変数初期化してるので、追加毎に初期化することは考えなくてよろし。
;ちなみに関数名のsexpはsexのextraなexperienceをplusするってことだよ！　どうでもいいね！

;性経験追加処理
	;メアリ側経験
	CALL ADDS_EXP("Ｖ경험", Z:10, TARGET)
	CALL ADDS_EXP("Ａ경험", Z:11, TARGET)
	CALL ADDS_EXP("성교경험", Z:10 + Z:11, TARGET)
	CALL ADDS_EXP("펠라경험", Z:12, TARGET)
	CALL ADDS_EXP("봉사쾌락경험", Z:12, TARGET)
	CALL ADDS_EXP("절정경험", Z:0, TARGET)
	SIF TEQUIP:MASTER:콘돔
		Z:15 = 0

;	SIF TEQUIP:ASSI:콘돔
	IF ASSI > 0
		SIF TEQUIP:ASSI:콘돔
			Z:16 = 0
	ENDIF
	CALL ADDS_EXP("질사경험", Z:15 + Z:16, TARGET)
	CALL ADDS_EXP("정액경험", Z:15 + Z:16, TARGET)

	;メアリ独自経験
	;セックス実施＆あなたが絶頂＝あなたとのセックス経験
	SIF Z:10 >= 1 && Z:1 >= 1
		CFLAG:810 |= 1p31
	;セックス実施＆助手が絶頂＝助手とのセックス経験
	SIF Z:11 >= 1 && Z:2 >= 1
		CFLAG:811 |= 1p31
	;アナル実施＆あなたが絶頂＝あなたとのアナルセックス経験
	SIF Z:11 >= 1 && Z:1 >= 1
		CFLAG:810 |= 1p41
	;アナル実施＆助手が絶頂＝助手とのアナルセックス経験
	SIF Z:12 >= 1 && Z:1 >= 1
		CFLAG:811 |= 1p41
	;フェラ実施＆あなたが絶頂＝あなたとのフェラ経験
	SIF Z:11 >= 1 && Z:1 >= 1
		CFLAG:810 |= 1p41
	;フェラ実施＆助手が絶頂＝助手とのフェラ経験
	SIF Z:12 >= 1 && Z:1 >= 1
		CFLAG:811 |= 1p41
	;あなた生射精＆セックス実施＝あなたのペニス接触経験＆精液接触経験+膣内射精経験
	IF Z:15 >= 1 && Z:10 >= 1
		CFLAG:810 |= 1p1
		CFLAG:810 |= 1p2
		CFLAG:810 |= 1p3
	;あなた生射精＝あなたのペニス接触経験＆精液接触経験
	ELSEIF Z:15 >= 1
		CFLAG:810 |= 1p1
		CFLAG:810 |= 1p2
	ENDIF
	;助手生射精＆セックス実施＝助手のペニス接触経験＆精液接触経験+膣内射精経験
	IF Z:16 >= 1 && Z:10 >= 1
		CFLAG:811 |= 1p1
		CFLAG:811 |= 1p2
		CFLAG:811 |= 1p3
	;助手生射精＝助手のペニス接触経験＆精液接触経験
	ELSEIF Z:16 >= 1
		CFLAG:811 |= 1p1
		CFLAG:811 |= 1p2
	ENDIF

	;あなた側経験
	CALL ADDS_EXP("사정경험", Z:1, MASTER)
	CALL ADDS_EXP("절정경험", Z:1, MASTER)
	;助手側経験
	IF ASSI > 0
		CALL ADDS_EXP("사정경험", Z:2, ASSI)
		CALL ADDS_EXP("절정경험", Z:2, ASSI)
		;ＮＴＲ機能ON＆助手でセックスを行った場合、Ｖ拡張が増加
		IF FLAG:51 && Z:2 >= 1 && Z:10 >= 1
			CALL ADDS_EXP("Ｖ확장경험", Z:10, TARGET)
		ENDIF
		;ＮＴＲ機能ON＆助手でアナルセックスを行った場合、Ａ拡張が増加
		IF FLAG:51 && Z:2 >= 1 && Z:11 >= 1
			CALL ADDS_EXP("Ａ확장경험", Z:11, TARGET)
		ENDIF
		;獣姦判定
		IF (TALENT:ASSI:짐승 || TALENT:ASSI:새) && (Z:10 + Z:11 >= 1) && Z:2 >= 1
			CALL ADDS_EXP("수간경험", Z:10 + Z:11, TARGET)
			CALL ADDS_ABNORMAL_EXP( @"獣姦", TARGET)
		ENDIF
;	近親相姦判定…は、拾ってきたけど良く判ってないので一時保留
;	IF 近親チェック(TARGET , ASSI) && Z:1 >= 1
;		CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:0%）", TARGET)
;		CALL ADDS_ABNORMAL_EXP( @"近親相姦（%RESULTS:1%）", ASSI)
	;ENDIF
	ENDIF

;	同性判定はあなたと助手の切り分けをどーするかね…案はあるけど面倒なので取り敢えず保留。
;	IF IS_LESBIAN(TARGET,PLAYER)
;		CALL ADDS_EXP("레즈경험", Z:10 + Z:11 + Z:12, TARGET)
;		CALL ADDS_EXP("레즈경험", Z:10 + Z:11 + Z:12, PLAYER)
;	ELSEIF IS_GAY(TARGET,PLAYER)
;		CALL ADDS_EXP("ＢＬ경험", Z:10 + Z:11 + Z:12, TARGET)
;		CALL ADDS_EXP("ＢＬ경험", Z:10 + Z:11 + Z:12, PLAYER)
;	ENDIF

;汚れ追加処理
	IF Z:10 >= 1
		STAIN:3 |= 2
		STAIN:6 |= 2
	ENDIF
	SIF Z:11 >= 1
		STAIN:4 |= 2
	SIF Z:12 >= 1
		STAIN:0 |= 2
	IF Z:1 >= 1
		IF Z:10 >= 1
			STAIN:3 |= 4
			STAIN:6 |= 4
			STAIN:MASTER:2 |= 1
		ENDIF
		IF Z:11 >= 1
			STAIN:4 |= 4
			STAIN:MASTER:2 |= 8
		ENDIF
		SIF Z:12 >= 1
			STAIN:0 |= 4
		STAIN:MASTER:2 |= 4
	ENDIF
	IF Z:2 >= 1
		IF Z:10 >= 1
			STAIN:3 |= 4
			STAIN:6 |= 4
			STAIN:ASSI:2 |= 1
		ENDIF
		IF Z:11 >= 1
			STAIN:4 |= 4
			STAIN:ASSI:2 |= 8
		ENDIF
		SIF Z:12 >= 1
			STAIN:0 |= 4
		STAIN:ASSI:2 |= 4
	ENDIF
;初期化
	Z:10 = 0
	Z:11 = 0
	Z:12 = 0
	Z:0 = 0
	Z:1 = 0
	Z:2 = 0
	Z:15 = 0
	Z:16 = 0


