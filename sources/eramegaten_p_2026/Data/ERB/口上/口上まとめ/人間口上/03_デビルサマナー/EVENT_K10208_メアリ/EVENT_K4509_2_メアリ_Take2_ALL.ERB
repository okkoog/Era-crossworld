;51,오나홀쓴다
;-------------------------------------------------
	CASE 51
		;初めて
		IF CFLAG:890 == 0
			PRINTFORML 
			PRINTFORML %CALLNAME:TARGET%은(는) 관통형의 오나홀을 잠시 빠져들고 놀랐지만,
			PRINTFORML %CALLNAME:PLAYER%에게 촉구되면 “입구”의 구멍에 로션을 듬뿍 흘렸다.
			PRINTFORML 「… 이렇게… 괜찮습니까… ?」
			PRINTFORML 시끄러운 ... 실리콘 홀을 밀어 펼쳐 관통하는 음경.
			PRINTFORML %CALLNAME:TARGET%은(는) 반투명의 장난감을 뒤흔들면서 전후시키면서 흥미롭게 응시하고 있었다.
			PRINTFORMW 
			CFLAG:890 |= 1
		;二回目以降
		ELSE
			;オナホ装着
			IF TEQUIP:PLAYER:오나홀 == 1
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					IF FLAG:51
						PRINTFORML 
						PRINTFORML %CALLNAME:TARGET%이(가) 로션으로 미지근한 인구 질을 육봉에 가까이 넣고 단번에 삽입한다.
						PRINTFORML 「… 여기까지 들어가 있다는 것이 한눈에 알게 되네요. 후후… 」
						PRINTFORML 쉽게 로션을 새지 않도록 일본인의 평균 크기에 비해 약간 길이 놀이를 갖게하는 오나홀.
						PRINTFORML %CALLNAME:MASTER%의 음경 사이즈에서는 첨단이 나름대로 남아, 넣고 뺄 때마다 첨단이 푸르푸르면 흔들린다.
						PRINTFORML %CALLNAME:TARGET%은(는) 그 모습을 바라보면서 잠시 동안 요철에 날아간 실리콘으로 육봉을 문지르고 있었다.
						PRINTFORMW 
					ELSE
						PRINTFORML 
						PRINTFORML 「어… 이거… 인가… ?」
						PRINTFORML %CALLNAME:TARGET%은(는) 어딘가 부끄러워 보이는 반투명 오나홀을 손에 들자, 쭉 육봉을 삼켰다.
						PRINTFORML 그대로 촉촉한 손으로 육경을 하기 시작한다.
						PRINTFORML 「아, 저… %CSTR:일인칭%의, 어…」
						PRINTFORML 뺨을 염색하면서 구멍 비교를 시키는 %CALLNAME:TARGET%의 말에 흥분해, 무심코 앞으로 달린 정액을 새었다.
						PRINTFORMW 
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORML 
					PRINTFORML 「%CALLNAME:PLAYER%님의 자지, 실리콘보지로 기분 좋게 해 드리겠네요」
					PRINTFORML 음란한 미소를 짓고 오나홀을 손에 든 %CALLNAME:TARGET%.
					PRINTFORML 그 안에 따끈따끈 소리를 내며 페니스를 가라앉히면 절묘한 힘 가감으로 다루기 시작했다.
					PRINTFORML 「앙, 반투명이니까, 쿠퍼액이 삐삐♪ 라고 한 것도 전부 보입니다… %UNICODE(0x2661)%」
					PRINTFORMW 
					STAIN:0 |= 4
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORML 
					PRINTFORML %CALLNAME:TARGET%의 얼굴에 오나홀을 던져서 기분 좋게 하라고 명령했다.
					PRINTFORML 「%CSTR:일인칭%의 신체보다, 이런 완구 쪽이 기분 좋은 것입니까… ?」
					PRINTFORML 「… 매우 굴욕입니다… %UNICODE(0x2661)%」
					PRINTFORML 얼굴을 상쾌하게 해, 허리를 비틀면서, %CALLNAME:TARGET%은(는) 오나홀에 충분히 로션을 흘려 넣어,
					PRINTFORML 삐걱거리며 육봉을 삽입하고 움직이기 시작했다.
					PRINTFORMW 
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3
					PRINTFORML 
					PRINTFORML %CALLNAME:TARGET%은(는) 실리콘제의 통을 손에 잡으면 %CALLNAME:PLAYER%의 음경을 그 구멍에 넣어,
					PRINTFORML 완급을 붙여 쓰러지기 시작했다.
					PRINTFORML 「저기… 능숙하게 되어 있을까요… 아」
					PRINTFORML 반투명 오나홀 속에서 쾌락에 앞서 달린 투명한 국물이 흠뻑 빠진다.
					PRINTFORML 「… 좋았습니다. 이대로 계속하네요」
					PRINTFORMW 
				;それ以外
				ELSE
					PRINTFORML 
					PRINTFORML 육봉에 실리콘 홀을 끼우자, %CALLNAME:TARGET%은(는) 그것을 기계적으로 제거하기 시작했다.
					PRINTFORML 규칙 바르게 구츄구츄와 소리를 내면서 푸리푸리의 의사 육벽이 페니스를 문지르는 것은 확실히 기분 좋지만,
					PRINTFORML 쾌락의 크기도 예상의 범주 같은 상태로 어딘가 아쉬움…
					PRINTFORMW 
				ENDIF
			ELSE
			;オナホ解除
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORML 
					PRINTFORMW 
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORML 
					PRINTFORMW 
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORML 
					PRINTFORMW 
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3
					PRINTFORML 
					PRINTFORMW 
				;それ以外
				ELSE
					PRINTFORML 
					PRINTFORMW 
				ENDIF
			ENDIF
		ENDIF


