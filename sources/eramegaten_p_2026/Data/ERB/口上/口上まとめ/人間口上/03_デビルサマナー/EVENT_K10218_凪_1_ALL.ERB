	IF SELECTCOM < 0 || SELECTCOM > 700
		RETURN 0
	ENDIF
	;--------------------------------------------------
	;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、4768を奴隷のキャラ番号に置換）
	;--------------------------------------------------
	;IF NO:MASTER == Y1
	;	CALL KOJO_MESSAGE_PALAMCNG_B_PY1_K[[キャラ:나기]]
	;	RETURN 0
	;ENDIF
	;IF ASSI > 0 && ASSIPLAY
	;	IF NO:ASSI == Y1
	;		CALL KOJO_MESSAGE_PALAMCNG_B_PY1_K[[キャラ:나기]]
	;		RETURN 0
	;	ENDIF
	;ENDIF
	;-------------------------------------------------
	;奴隷の絶頂時のテキスト
	;-------------------------------------------------
	CALL 口上変数初期化
	;-------------------------------------------------
	;初めてC絶頂
	;-------------------------------------------------
	IF NOWEX:0 > 0 && CFLAG:290 == 0
		CFLAG:290 = 1
	ENDIF

	;-------------------------------------------------
	;初めてV絶頂
	;-------------------------------------------------
	IF NOWEX:1 > 0 && CFLAG:291 == 0
		CFLAG:291 = 1
	ENDIF

	;-------------------------------------------------
	;初めてA絶頂
	;-------------------------------------------------
	IF NOWEX:2 > 0 && CFLAG:292 == 0
		CFLAG:292 = 1
	ENDIF

	;-------------------------------------------------
	;初めてB絶頂
	;-------------------------------------------------
	IF NOWEX:3 > 0 && CFLAG:293 == 0
		CFLAG:293 = 1
	ENDIF

	;-------------------------------------------------
	;절정
	;-------------------------------------------------
	SIF 口上有無確認(0) && K > 0
		CALL WSTR書き込み, K - 1
	LOCAL = K

	IF TFLAG:29 > 0
		K_CALL:K = PALAM_MESSAGE_B
		;強絶頂
		IF TFLAG:29 > 1
			;このテンプレの一番よくないところ
		ENDIF
		;절정
		IF !口上有無確認(LOCAL)
		ENDIF
	ENDIF
	;-------------------------------------------------
	;사정
	;-------------------------------------------------
	;射精している
	SIF 口上有無確認(0) && K > 0
		CALL WSTR書き込み, K - 1
	LOCAL = K

	;射精している
	IF TFLAG:10 > 0
	ENDIF

	;-------------------------------------------------
	;분유
	;-------------------------------------------------
	SIF 口上有無確認(0) && K > 0
		CALL WSTR書き込み, K - 1
	LOCAL = K

	;噴乳している
	IF TFLAG:11 > 0
	ENDIF

	;-------------------------------------------------
	;방뇨
	;-------------------------------------------------
	SIF 口上有無確認(0) && K > 0
		CALL WSTR書き込み, K - 1
	LOCAL = K

	;放尿している
	IF TFLAG:29 > 0 && (TEQUIP:27 || TALENT:57)
	ENDIF

	CALL 口上変数表示
	;口上がなければ別の口上を呼び出す
	IF RESULT == 0
		TRYCCALLFORM KOJO_MESSAGE_PALAMCNG_B_ZZZ
		CATCH
			CALL PALAM_MESSAGE_B
		ENDCATCH
		
	ENDIF
;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_C関係（4768をキャラ番号に置換）
;調教後の変化をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_C_K[[キャラ:나기]]
	;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
	;SIF ASSI > 0 && ASSIPLAY
	;	RETURN 0 
	;ボールギャグ着用時には地の文を表示して口上をスキップする
	IF TEQUIP:20 &&  SELECTCOM != 107
		CALL PALAM_MESSAGE_C
		RETURN 0
	ENDIF

	;--------------------------------------------------
	;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、4768を奴隷のキャラ番号に置換）
	;--------------------------------------------------
	;IF NO:MASTER == Y1
	;	CALL KOJO_MESSAGE_PALAMCNG_C_PY1_K[[キャラ:나기]]
	;	RETURN 0
	;ENDIF
	;IF ASSI > 0 && ASSIPLAY
	;	IF NO:ASSI == Y1
	;		CALL KOJO_MESSAGE_PALAMCNG_C_PY1_K[[キャラ:나기]]
	;		RETURN 0
	;	ENDIF
	;ENDIF

	;-------------------------------------------------
	;調教後のテキスト
	;-------------------------------------------------

	;-------------------------------------------------
	;処女喪失(処女のみ)
	;-------------------------------------------------
	CALL 口上変数初期化

	IF TFLAG:3 > 0
		K_CALL:K = PALAM_MESSAGE_C
		;恋慕か親愛かつ主人のセックスによる処女喪失
		IF TFLAG:20
		;それ以外の時に処女喪失
		ELSE
		ENDIF
	ENDIF
	;-------------------------------------------------
	;何もしない後
	;-------------------------------------------------
	IF SELECTCOM == 21
		K_CALL:K = PALAM_MESSAGE_C
		;欲情LV5以上
		IF !口上有無確認(0) && PALAM:5 >= PALAMLV:5
		ENDIF
		;欲情LV3以上 + 미약
		IF !口上有無確認(0) && PALAM:5 >= PALAMLV:3 && TEQUIP:26
		ENDIF
		;欲情LV3以上
		IF !口上有無確認(0) && PALAM:5 >= PALAMLV:3
		ENDIF
	ENDIF

	;-------------------------------------------------
	;お掃除フェラ
	;-------------------------------------------------
	IF TFLAG:8 > 0
		;ABL:정액중독　ABL:ASSI:정액중독
		K_CALL:K = PALAM_MESSAGE_C
		;ダブルフェラ後助手とザーメンキス　条件:調教対象か助手が精液中毒持ち
		IF TFLAG:8 >= 2
		ENDIF
		;ダブルフェラで助手とお掃除フェラ
		IF TFLAG:8 >= 2 && !口上有無確認(0)
		ENDIF
		;二本フェラ後お掃除フェラ
		IF TFLAG:0 && TFLAG:6 && !口上有無確認(0)
		ENDIF
		;フェラ後お掃除フェラ
		IF !口上有無確認(0)
		ENDIF
	ENDIF


	CALL 口上変数表示
	;口上がなければ別の口上を呼び出す
	IF RESULT == 0
		TRYCCALLFORM KOJO_MESSAGE_COM_ZZZ
		CATCH
			CALL PALAM_MESSAGE_C
		ENDCATCH
	ENDIF
;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_D関係（4768をキャラ番号に置換）
;パラメータ変化をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_D_K[[キャラ:나기]]
	;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
	;SIF ASSI > 0 && ASSIPLAY
	;	RETURN 0 
	;ボールギャグ着用時には地の文を表示して口上をスキップする
	IF TEQUIP:20 &&  SELECTCOM != 107
		CALL PALAM_MESSAGE_D
		RETURN 0
	ENDIF
	;--------------------------------------------------
	;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、4768を奴隷のキャラ番号に置換）
	;--------------------------------------------------
	;IF NO:MASTER == Y1
	;	CALL KOJO_MESSAGE_PALAMCNG_D_PY1_K[[キャラ:나기]]
	;	RETURN 0
	;ENDIF
	;IF ASSI > 0 && ASSIPLAY
	;	IF NO:ASSI == Y1
	;		CALL KOJO_MESSAGE_PALAMCNG_D_PY1_K[[キャラ:나기]]
	;		RETURN 0
	;	ENDIF
	;ENDIF
	;-------------------------------------------------
	;パラメータ変化時のテキスト
	;-------------------------------------------------
	CALL 口上変数初期化
	;-------------------------------------------------
	;初めて潤滑がLV3超えた
	;-------------------------------------------------
	P = PALAM:4 + CUP:4
	IF P > PALAMLV:4 && CFLAG:280 == 0
		K_CALL:K = PALAM_MESSAGE_D
		;ローションを使った場合
		IF SELECTCOM == 180
		;それ以外
		ELSE
		ENDIF
		CFLAG:280 = 1
	ENDIF

	;-------------------------------------------------
	;初めて欲情がLV2超えた
	;-------------------------------------------------
	P = PALAM:6 + CUP:6
	IF P > PALAMLV:3 && CFLAG:281 == 0
		K_CALL:K = PALAM_MESSAGE_D
		;媚薬を使った場合
		IF SELECTCOM == 181
		;それ以外
		ELSE
		ENDIF
		CFLAG:281 = 1
	ENDIF

	;-------------------------------------------------
	;初めて屈服がLV3超えた
	;-------------------------------------------------
	P = PALAM:7 + CUP:7
	IF P > PALAMLV:3 && CFLAG:282 == 0
		K_CALL:K = PALAM_MESSAGE_D
		CFLAG:282 = 1
	ENDIF

	;-------------------------------------------------
	;初めて恭順がLV3超えた
	;-------------------------------------------------
	P = PALAM:5 + CUP:5
	IF P > PALAMLV:3 && CFLAG:283 == 0
		K_CALL:K = PALAM_MESSAGE_D
		CFLAG:283 = 1
	ENDIF

	;-------------------------------------------------
	;初めて恐怖がLV3超えた
	;-------------------------------------------------
	P = PALAM:11 + CUP:11
	IF P > PALAMLV:3 && CFLAG:284 == 0
		K_CALL:K = PALAM_MESSAGE_D
		CFLAG:284 = 1
	ENDIF

	CALL 口上変数表示
	IF RESULT == 0
		TRYCCALLFORM KOJO_MESSAGE_PALAMCNG_D_ZZZ
		CATCH
			CALL PALAM_MESSAGE_D
		ENDCATCH
	ENDIF

;-------------------------------------------------
;@KOJO_MESSAGE_MARKCNG関係（4768をキャラ番号に置換）
;刻印変動をトリガーにした口上
;刻印変動後に口上を発動します
;-------------------------------------------------
@KOJO_MESSAGE_MARKCNG_K[[キャラ:나기]]
	;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
	;SIF ASSI > 0 && ASSIPLAY
	;	RETURN 0 
	;ボールギャグ着用時には地の文を表示して口上をスキップする
	IF TEQUIP:20 &&  SELECTCOM != 107
		CALL MARK_MESSAGE
		RETURN 0
	ENDIF

	CALL 口上変数初期化
	;--------------------------------------------------
	;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、4768を奴隷のキャラ番号に置換）
	;--------------------------------------------------
	;IF NO:MASTER == Y1
	;	CALL KOJO_MESSAGE_MARKCNG_PY1_K[[キャラ:나기]]
	;	RETURN 0
	;ENDIF
	;IF ASSI > 0 && ASSIPLAY
	;	IF NO:ASSI == Y1
	;		CALL KOJO_MESSAGE_MARKCNG_PY1_K[[キャラ:나기]]
	;		RETURN 0
	;	ENDIF
	;ENDIF
	;-------------------------------------------------
	;苦痛刻印Lv3
	;-------------------------------------------------
	LOCAL = K
	IF TFLAG:22 == 3
		K_CALL:K = MARK_MESSAGE_A
		;恋慕、親愛	
		IF 陥落(TARGET, PLAYER) > 0 && RESULTS == "연모"
			;WSTR:(K++) = 
		;淫乱、娼婦
		ELSEIF 陥落( ) > 0 && RESULTS == "음란"
			;WSTR:(K++) = 
		;服従、隷属
		ELSEIF 陥落(TARGET, PLAYER) > 0 && RESULTS == "복종"
			;WSTR:(K++) = 
		ENDIF
		;共通
		IF !口上有無確認(LOCAL)
;			KSTR:(K++) = 
		ENDIF
	ENDIF

	;-------------------------------------------------
	;快楽刻印Lv3
	;-------------------------------------------------

	LOCAL = K
	IF TFLAG:23 == 3
		K_CALL:K = MARK_MESSAGE_P
	ENDIF

	;-------------------------------------------------
	;屈服刻印Lv3
	;-------------------------------------------------
	LOCAL = K
	IF TFLAG:24 == 13 || TFLAG:24 == 23 || TFLAG:24 == 33
		K_CALL:K = MARK_MESSAGE_S
		;快楽による屈服
		IF TFLAG:24 == 13
		;恐怖と苦痛による屈服
		ELSEIF TFLAG:24 == 23
		;屈服と恭順による屈服
		ELSEIF TFLAG:24 == 33
		ENDIF
		SIF !口上有無確認(LOCAL)
			CALL MARK_MESSAGE_S
	ENDIF

	;-------------------------------------------------
	;反発刻印Lv3
	;-------------------------------------------------
	LOCAL = K
	IF TFLAG:21 == 3
		K_CALL:K = MARK_MESSAGE_R
		;陥落済み
		IF 陥落( ) > 0
			;恋慕、親愛
			IF 陥落(TARGET, PLAYER) > 0 && RESULTS == "연모"
			;淫乱、娼婦
			ELSEIF 陥落( ) > 0 && RESULTS == "음란"
			;服従、隷属
			ELSEIF 陥落(TARGET, PLAYER) > 0 && RESULTS == "복종"
				;WSTR:(K++) = 
			ENDIF
			;陥落済み共通
			IF !口上有無確認(LOCAL)
				;WSTR:(K++) = 
			ENDIF
		ENDIF
		;それ以外
		IF !口上有無確認(LOCAL)
		ENDIF
		SIF !口上有無確認(LOCAL)
			CALL MARK_MESSAGE_R
	ENDIF

	CALL 口上変数表示
	IF RESULT == 0
		TRYCCALLFORM KOJO_MESSAGE_MARKCNG_ZZZ
		CATCH
		ENDCATCH
	ENDIF
