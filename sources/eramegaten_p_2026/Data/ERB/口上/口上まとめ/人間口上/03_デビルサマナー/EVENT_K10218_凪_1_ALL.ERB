;--------------------------------------------------
;口上セレクト機能：口上説明
;--------------------------------------------------
;この関数のコメントアウトを外すと、口上の選択時に選択肢として候補にあがります
;既に口上のあるキャラや会話タイプの別版の口上を作成する時に利用してください
;その際、この関数を含めたこのファイル内の関数名すべてに_任意の1-49(汎用口上なら1-9)の数字を加えてください
;例： EVENTTRAIN_K[[キャラ:나기]] → EVENTTRAIN_K[[キャラ:나기]]_1
;--------------------------------------------------
@セレクト口上説明_K[[キャラ:나기]], ARG = 0
	SIF ARG == 1
		RETURN 0
	;口上名
	;いつか調教口上を書く人が現れたらこのへん変えてね
	PRINTFORML 나기 쨩 전투용 구상
	;口上説明文
	PRINTFORML 　　나기의 전투용 구상 세오리。

;--------------------------------------------------
;EVENTTRAIN関係（4768をキャラ番号に置換）
;調教開始時のセリフ CFLAG 201～219を使用
;--------------------------------------------------
@EVENTTRAIN_K[[キャラ:나기]]
	CALL 口上変数初期化

	;--------------------------------------------------
	;エキストラモード構文　CFLAG:220を使用
	;はいを選択した時に初調教時に口上設定用の素質に変更できます
	;下記に処女化する場合の構文をサンプルとして載せておきます
	;--------------------------------------------------
;	IF CFLAG:220 == 0
;		PRINTL 이 구상은 여체화 등의 소질 변경이 전제인 구상입니다。
;		PRINTW 이 구상에 맞게 소질을 변경합니까？
;		PRINTL 
;		PRINTL [0] 상정 소질・복장으로 변경한다
;		PRINTL [1] 여체화만 한다
;		$INPUT_LOOP_EX
;		INPUT
;		IF RESULT == 0
;		ELSEIF RESULT == 1
;		ELSE
;			GOTO INPUT_LOOP_EX
;		ENDIF
;		CFLAG:220 = 1
;	ENDIF

	;--------------------------------------------------
	;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、4768を奴隷のキャラ番号に置換）
	;--------------------------------------------------
	;IF NO:MASTER == Y1
	;	CALL EVENTTRAIN_PY1_K[[キャラ:나기]]
	;	RETURN 0
	;ENDIF
	;IF ASSI > 0 && ASSIPLAY
	;	IF NO:ASSI == Y1
	;		CALL EVENTTRAIN_PY1_K[[キャラ:나기]]
	;		RETURN 0
	;	ENDIF
	;ENDIF

	;--------------------------------------------------
	;簡易助手口上の発動時に初調教時口上をスキップ（Y1を助手のキャラ番号にする）
	;複数人いる際には、SIF NO:ASSI == Y1 || NO:ASSI == Z1と追加していく
	;--------------------------------------------------
	;IF CFLAG:201 == 0 && ASSI > 0
	;	SIF NO:ASSI == Y1
	;		CFLAG:201 =1
	;ENDIF

	;-------------------------------------------------
	;調教開始時（一回のみ） CFLAG201
	;-------------------------------------------------
	DRAWLINE
	;初調教時
	IF 0
	ELSEIF CFLAG:201 == 0 && CFLAG:미조교함락 == 0
		CFLAG:201 = 1
		GOTO 表示
	;屈服刻印Lv1
	ELSEIF CFLAG:201 < 2 && MARK:2 == 1
		CFLAG:201 = 2
		GOTO 表示
	;屈服刻印Lv2
	ELSEIF CFLAG:201 < 3 && MARK:2 == 2
		CFLAG:201 = 3
		GOTO 表示
	;屈服刻印Lv3
	ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && 陥落() == 0
		CFLAG:201 = 4
		GOTO 表示
	;陥落
	ELSEIF CFLAG:201 < 5 && 陥落() >= 1
		IF 0
		;信頼系
		ELSEIF RESULTS == "신뢰"
		;恋慕系
		ELSEIF RESULTS == "연모"
			;調教せずに恋慕をつけた場合
			IF CFLAG:미조교함락 == 1
			ELSE
			ENDIF
		;淫乱系
		ELSEIF RESULTS == "음란"
		;服従系
		ELSEIF RESULTS == "복종"
		ENDIF

		;共通
		IF !口上有無確認(0)
			;KSTR:(K++) = 
		ENDIF
		CFLAG:201 = 5
		GOTO 表示
	ELSEIF CFLAG:201 <= 6 && 陥落() >= 2
		IF 0
		;信頼系
		ELSEIF RESULTS == "신뢰"
		;恋慕系
		ELSEIF RESULTS == "연모"
			;調教せずに恋慕をつけた場合
			IF CFLAG:미조교함락 == 1
			ELSE
			ENDIF
		;淫乱系
		ELSEIF RESULTS == "음란"
		;服従系
		ELSEIF RESULTS == "복종"
		ENDIF

		;共通
		IF !口上有無確認(0)
			;KSTR:(K++) = 
		ENDIF
		CFLAG:201 = 6
		GOTO 表示
	ELSEIF CFLAG:201 <= 7 && 陥落() >= 3
		IF 0
;		;信頼系
;		;これはありえない
;		ELSEIF RESULTS == "신뢰"
		;恋慕系
		ELSEIF RESULTS == "연모"
			;調教せずに恋慕をつけた場合
			IF CFLAG:미조교함락 == 1
			ELSE
			ENDIF
		;淫乱系
		ELSEIF RESULTS == "음란"
		;服従系
		ELSEIF RESULTS == "복종"
		ENDIF

		;共通
		IF !口上有無確認(0)
			;KSTR:(K++) = 
		ENDIF
		CFLAG:201 = 7
		GOTO 表示
	ENDIF

	;-------------------------------------------------
	;簡易助手口上（Y1を助手のキャラ番号に置換、4768をキャラ番号に変更する) CFLAG203
	;掛け合いをするキャラを増やす場合は、構文をコピー＆ペーストをして、CFLAGの数を204、205と増やす
	;-------------------------------------------------
	;助手の有無をチェック（いない場合は二回目以降へ飛ぶ）
	IF ASSI < 0 
		CALL EVENTTRAIN_SECOND_K[[キャラ:나기]]
	;特定NOの助手がいる場合
;	ELSEIF NO:ASSI == Y1
	;口上のある助手が居ない場合は、通常の二回目以降の口上へ飛ぶ
	ELSE
		CALL EVENTTRAIN_SECOND_K[[キャラ:나기]]
	ENDIF

	$表示

	CALL 口上変数表示
	;口上がなければ別の口上を呼び出す
	IF RESULT == 0
		TRYCCALLFORM EVENTTRAIN_ZZZ
		CATCH
		ENDCATCH
	ENDIF

;-------------------------------------------------
;調教開始時（2回目以降。4768をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_K[[キャラ:나기]]
	IF 0
	;反発刻印Lv3
	ELSEIF MARK:3 == 3
	;屈服刻印Lv0
	ELSEIF MARK:2 == 0
	;屈服刻印Lv1
	ELSEIF MARK:2 == 1
	;屈服刻印Lv2
	ELSEIF MARK:2 == 2
	;屈服刻印Lv3＋陥落素質無し
	ELSEIF MARK:2 == 3 && 陥落() == 0
	;陥落済み
	ELSEIF 陥落() == 1
		IF 0
		ELSEIF RESULTS == "연모"
		ELSEIF RESULTS == "음란"
		ELSEIF RESULTS == "복종"
		ENDIF

		;共通
		IF !口上有無確認(0)
			WSTR:(K++) =
		ENDIF
	;上位陥落
	ELSEIF 陥落() == 2
		IF 0
		ELSEIF RESULTS == "연모"
		ELSEIF RESULTS == "음란"
		ELSEIF RESULTS == "복종"
		ENDIF

		;共通
		IF !口上有無確認(0)
			WSTR:(K++) =
		ENDIF
	;계약
	ELSEIF 陥落() >= 3
		IF 0
		ELSEIF RESULTS == "연모"
		ELSEIF RESULTS == "음란"
		ELSEIF RESULTS == "복종"
		ENDIF

		;共通
		IF !口上有無確認(0)
			WSTR:(K++) =
		ENDIF
	ENDIF

	CALL 口上変数表示
	;口上がなければ別の口上を呼び出す
	IF RESULT == 0
		TRYCCALLFORM EVENTEND_ZZZ
		CATCH
		ENDCATCH
	ENDIF

;-------------------------------------------------
;EVENTEND関係（4768をキャラ番号に置換）
;調教終了時のセリフ
;-------------------------------------------------
@EVENTEND_K[[キャラ:나기]]
	CALL 口上変数初期化

	;--------------------------------------------------
	;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、4768を奴隷のキャラ番号に置換）
	;--------------------------------------------------
	;IF NO:MASTER == Y1
	;	CALL EVENTEND_PY1_K[[キャラ:나기]]
	;	RETURN 0
	;ENDIF
	;IF ASSI > 0 && ASSIPLAY
	;	SIF NO:ASSI == Y1
	;	CALL EVENTEND_PY1_K[[キャラ:나기]]
	;	RETURN 0
	;ENDIF

	;--------------------------------------------------
	;調教終了時のセリフ
	;--------------------------------------------------
	DRAWLINE
	IF 0
	;反発刻印Lv3
	ELSEIF MARK:3 == 3
	;屈服刻印Lv1以下
	ELSEIF MARK:2 <= 1
	;屈服刻印Lv2
	ELSEIF MARK:2 == 2
	;屈服刻印Lv3＋陥落素質無し
	ELSEIF MARK:2 == 3 && 陥落() == 0
	;陥落済み
	ELSEIF 陥落() 
		IF 0
		ELSEIF RESULTS == "연모"
			;体力500未満
			IF BASE:0 < 500
			ELSE
			ENDIF
		ELSEIF RESULTS == "음란"
			;体力500未満
			IF BASE:0 < 500
			ELSE
			ENDIF
		ELSEIF RESULTS == "복종"
			;体力500未満
			IF BASE:0 < 500
			ELSE
			ENDIF
		ENDIF

		;共通
		IF !口上有無確認(0)
			;KSTR:(K++) = 
		ENDIF
	ENDIF

	CALL 口上変数表示
	;口上がなければ別の口上を呼び出す
	IF RESULT == 0
		TRYCCALLFORM EVENTEND_ZZZ
		CATCH
		ENDCATCH
	ENDIF

