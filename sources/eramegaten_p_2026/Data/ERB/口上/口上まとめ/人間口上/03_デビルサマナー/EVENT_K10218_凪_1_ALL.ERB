;-------------------------------------------------
;●戦闘口上
;-------------------------------------------------
;キュウキ口上からお借りしたけど原型が残らなかった。
;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:나기]], ARG, ARG:1, ARG:2
;掛け合い対応者を増やす場合この配列数を増やす
;現在：なし
#DIM 掛け合い予定キャラ
#DIM POSITION
#DIM LCOUNT
#DIM L_POS, 6
#DIM L_CHARA
	;■台詞の行数を増やしたいときは
	;			LOCALS:10 = 一行目
	;			LOCALS:11 = 二行目
	;			LOCALS:12 = 三行目
	;			LOCALS:13 = 四行目
	;			LOCALS:14 = 五行目
	;と増やしていく
	SIF ARG < 0 && NO:ARG != 4768
		RETURN 0
	;VARSET LOCALS
	;CALL 口上変数初期化

	;掛け合い対象の検索
	;味方POSをランダムな順で検索して最初にHITしたのが掛け合い対象となる
	L_POS = 1, 2, 3, 4, 5, 6
	TFLAG:대화형캐릭터 = -1
	FOR LCOUNT, 0, 6
		SWAP L_POS:(RAND:6), L_POS:(RAND:6)
	NEXT
	FOR LCOUNT, 0, 6
		L_CHARA = POS(L_POS:LCOUNT)
		SIF !IS_TARGET_ABLE(L_CHARA)
			CONTINUE
		;自分自身は省く
		SIF ARG == L_CHARA
			CONTINUE
		;掛け合いキャラは入力可能な状態である必要がある
		SIF !INPUTABLE_CHARA_F(L_CHARA)
			CONTINUE
;		;ライドウと殺眼の綾女……にできたらいいね
;		IF NO:L_CHARA == [[キャラ:라이도우]] || NO:L_CHARA == [[キャラ:살안의아야메]]
;			掛け合い予定キャラ = L_CHARA
;			BREAK
;		ENDIF
	NEXT

	IF 0
	;COOP発動 ARGは発動者
	ELSEIF TFLAG:전투이벤트 == 1
		IF 0
		ELSEIF !RAND:3
			BTL_KOJO_RESULTS:0 = レッツゴーです、皆さん！
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = 行けます！
		ELSE
			BTL_KOJO_RESULTS:0 = 袋ストライクのセオリーです！
		ENDIF
	;COOP参加
	ELSEIF TFLAG:전투이벤트 == 2
		IF 0
		;主人がCOOP発動
;		ELSEIF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
		ELSEIF !RAND:3
			BTL_KOJO_RESULTS:0 = 切り捨てるプロセスです！
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = 行きます！
		ELSE
			BTL_KOJO_RESULTS:0 = 叩きます！
		ENDIF
	;被召喚時
	;人間なので存在しない……デモナイズはまあ無視
	ELSEIF TFLAG:전투이벤트 == 3
	
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	ELSEIF TFLAG:전투이벤트 == 11
		IF 0
		;味方に攻撃した
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;相手が死んだ
		ELSEIF BASE:(ARG:1):ＨＰ <= 0
			IF 0
;			;PT内に掛け合い対応者がいたら1/3の確率で掛け合い　ただし生存する敵が0なら汎用に飛ぶ
;			;掛け合い対応は現在はしないので例示だけ残しておく
;			ELSEIF ENEMY_COUNT( ) > 0 && 掛け合い予定キャラ >= 0 && RAND:3 == 0
;				$撃破時掛け合い
;				TFLAG:대화형순서역전 = 1
;				TFLAG:대화형캐릭터 = 掛け合い予定キャラ
;				IF NO:(TFLAG:대화형캐릭터) == [[キャラ:살안의아야메]]
;					BTL_KOJO_REACT_RESULTS:0 = アヤメのセリフ
;					BTL_KOJO_RESULTS:0 = 凪ちゃんのセリフ
;				ELSE
;				ENDIF
			ELSE
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = 撃破したセオリーです！
					CASE 1
						BTL_KOJO_RESULTS:0 = これでフィナーレ！
					CASE 2
						BTL_KOJO_RESULTS:0 = よし！
				ENDSELECT
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = むむっ、GUARDされたプロセス……！
			ELSE
				;こちらはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			LOCAL = RAND:3
			SELECTCASE LOCAL
			CASE 0
				BTL_KOJO_RESULTS:0 = グレート！　致命打！
			CASE 1
				BTL_KOJO_RESULTS:0 = あと一歩のセオリー！
			CASE 2
				BTL_KOJO_RESULTS:0 = 追い詰めたカテゴリーです！
			ENDSELECT
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			LOCAL = RAND:3
			SELECTCASE LOCAL
			CASE 0
				BTL_KOJO_RESULTS:0 = グッド！　有効打！
			CASE 1
				BTL_KOJO_RESULTS:0 = 効いたでしょう！
			CASE 2
				BTL_KOJO_RESULTS:0 = 結果オーライです！
			ENDSELECT
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			LOCAL = RAND:3
			SELECTCASE LOCAL
			CASE 0
				BTL_KOJO_RESULTS:0 = むっ、攻撃がややスルー
			CASE 1
				BTL_KOJO_RESULTS:0 = 地道に攻撃するセオリーです
			CASE 2
				BTL_KOJO_RESULTS:0 = 焦ってはいけないプロセス……
			ENDSELECT
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			LOCAL = RAND:3
			SELECTCASE LOCAL
			CASE 0
				BTL_KOJO_RESULTS:0 = むむ、攻撃がスルーですね
			CASE 1
				BTL_KOJO_RESULTS:0 = これはナイスではないようです
			CASE 2
				BTL_KOJO_RESULTS:0 = セルフ無力を感じます
			ENDSELECT
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	ELSEIF TFLAG:전투이벤트 == 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF 0
			ELSEIF !RAND:2
				BTL_KOJO_RESULTS:0 = う、ぐぅ……っ
			ELSE
				BTL_KOJO_RESULTS:0 = こん、な……ぷろせ……す……
			ENDIF
		;味方に攻撃された
		ELSEIF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
			IF 0
			ELSEIF !RAND:2
				BTL_KOJO_RESULTS:0 = 痛っ、……%CSTR:ARG:일인칭%は味方のカテゴリー！
			ELSE
				BTL_KOJO_RESULTS:0 = な、ナイスではないですね！
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF 0
			ELSEIF !RAND:2
				BTL_KOJO_RESULTS:0 = ぐぅうっ！
			ELSE
				BTL_KOJO_RESULTS:0 = セルフ未熟……！
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			IF 0
			ELSEIF !RAND:2
				BTL_KOJO_RESULTS:0 = その攻撃は効かないカテゴリーです！
			;スパロボインパクトより
			ELSE
				BTL_KOJO_RESULTS:0 = 目がチカチカするプロセスです……
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			IF 0
			ELSEIF !RAND:2
				BTL_KOJO_RESULTS:0 = その攻撃は効かないカテゴリーです！
			ELSE
				BTL_KOJO_RESULTS:0 = 目がチカチカするプロセスです……
			ENDIF
		;小ダメージ
		ELSE
			IF 0
			ELSEIF !RAND:2
				BTL_KOJO_RESULTS:0 = くっ、油断したカテゴリーです
			ELSE
				BTL_KOJO_RESULTS:0 = まだまだっ！
			ENDIF
		ENDIF
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	ELSEIF TFLAG:전투이벤트 == 13
		;全弾命中した
		IF ARG:2 == 0
			IF 0
			ELSEIF !RAND:2
				BTL_KOJO_RESULTS:0 = フルヒット！
			ELSE
				BTL_KOJO_RESULTS:0 = 全弾的中のムードです！
			ENDIF
		;普通
		ELSEIF ARG:2 < ARG:1
			IF 0
			ELSEIF !RAND:2
				BTL_KOJO_RESULTS:0 = ヒット！
			ELSE
				BTL_KOJO_RESULTS:0 = 的中したカテゴリー！
			ENDIF
		;全弾回避された
		ELSEIF ARG:2 == ARG:1
			IF 0
			ELSEIF !RAND:2
				BTL_KOJO_RESULTS:0 = くっ、そんな……！
			ELSE
				BTL_KOJO_RESULTS:0 = 攻撃失敗のムードです……！
			ENDIF
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	ELSEIF TFLAG:전투이벤트 == 14
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			IF 0
			ELSEIF !RAND:2
				BTL_KOJO_RESULTS:0 = 敵、撃滅！　の、セオリー！
			ELSE
				BTL_KOJO_RESULTS:0 = やった！
			ENDIF
		ELSE
			IF 0
			ELSEIF !RAND:2
				BTL_KOJO_RESULTS:0 = 敵撃破のセオリー！
			ELSE
				BTL_KOJO_RESULTS:0 = やった！
			ENDIF
		ENDIF
	;反射された
	ELSEIF TFLAG:전투이벤트 == 15
		IF 0
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = くっ、ナイスではないですね……！
		ELSE
			BTL_KOJO_RESULTS:0 = セルフ攻撃が……！
		ENDIF
	;反射した
	ELSEIF TFLAG:전투이벤트 == 16
		IF 0
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = よし、ナイスです！
		ELSE
			BTL_KOJO_RESULTS:0 = その攻撃は効かないカテゴリーです！
		ENDIF
	;回避された
	ELSEIF TFLAG:전투이벤트 == 17
		IF 0
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = むっ、早い……！
		ELSE
			BTL_KOJO_RESULTS:0 = くっ、素早いカテゴリー……！
		ENDIF
	;回避した
	ELSEIF TFLAG:전투이벤트 == 18
		IF 0
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = そんな攻撃が通じるカテゴリーではありません！
		ELSE
			BTL_KOJO_RESULTS:0 = 回避アヴォイド！
		ENDIF
	;敵味方全体攻撃(詳細処理無し)
;	ELSEIF TFLAG:전투이벤트 == 19
	;	BTL_KOJO_RESULTS:0 = 
	;反撃スキル発動した
	ELSEIF TFLAG:전투이벤트 == 20
		;反撃スキルも見ることができる
		;2481,반격
		;2482,맹반격
		;2483,데스카운터
;		ELSEIF TFLAG:발동연동스킬 == 2481 || TFLAG:발동연동스킬 == 2482 || TFLAG:발동연동스킬 == 2483
		IF 0
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = 逆撃カウンター！
		ELSE
			BTL_KOJO_RESULTS:0 = おおっとデンジャラス！
		ENDIF
	;トリガースキルを発動した
;	ELSEIF TFLAG:전투이벤트 == 21
;		SELECTCASE TFLAG:발동연동스킬
;		;アクセル（会心時5割でスクカジャ
;		CASE 2485
;			BTL_KOJO_RESULTS:0 = 
;		;その他
;		;CASEELSE
;		;	BTL_KOJO_RESULTS:0 = 
;		ENDSELECT
	;バッドステータスを受けた
	ELSEIF TFLAG:전투이벤트 == 22
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				IF 0
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = ふわふわパラダイス……
				ELSE
					BTL_KOJO_RESULTS:0 = ほわほわパライソ……
				ENDIF
			CASE "PALYZE"
				IF 0
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = ンアーッ、麻痺毒！
				ELSE
					BTL_KOJO_RESULTS:0 = うっ、身体が……！
				ENDIF
			CASE "SHOCK"
				IF 0
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = か、からだ、しびれっ……！
				ELSE
					BTL_KOJO_RESULTS:0 = うっ、身体が……！
				ENDIF
			CASE "FREEZE"
				IF 0
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = か、かじかむっ……
				ELSE
					BTL_KOJO_RESULTS:0 = うっ、身体が……！
				ENDIF
			CASE "BIND"
				IF 0
				ELSEIF !RAND:2
					;しくじった、と言いたいらしい
					BTL_KOJO_RESULTS:0 = あっ、バッドチョイス……！
				ELSE
					BTL_KOJO_RESULTS:0 = うっ、身体が……！
				ENDIF
			CASE "PANIC"
				IF 0
				ELSEIF !RAND:6
					BTL_KOJO_RESULTS:0 = 頭の輝きがナイスです！？
				ELSEIF !RAND:5
					BTL_KOJO_RESULTS:0 = ぼいんぼいんぼいんぼん……
				ELSEIF !RAND:4
					BTL_KOJO_RESULTS:0 = くたばれもしくはダイハード！
				ELSEIF !RAND:3
					BTL_KOJO_RESULTS:0 = ふにゃふにゃ……
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = ななめさんじゅうごど！
				ELSE
					BTL_KOJO_RESULTS:0 = るっきんざまぁ！
				ENDIF
			CASE "SLEEP"
				IF 0
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = スヤァ……
				ELSE
					BTL_KOJO_RESULTS:0 = すやぁ……
				ENDIF
			CASE "CLOSE"
				IF 0
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = 魔術が使えなくなった見解です！
				ELSE
					BTL_KOJO_RESULTS:0 = 魔法が使用不可の過程です！
				ENDIF
			CASE "POISON"
				IF 0
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = うぅっ、毒物トキシン……！
				ELSE
					BTL_KOJO_RESULTS:0 = うっ……力が……
				ENDIF
			CASE "BOMB"
				IF 0
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%の身体がボムに……！？
				ELSE
					BTL_KOJO_RESULTS:0 = 爆発物ボムになっています、ご注意を……！
				ENDIF
			CASE "CHARM"
				IF 0
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = はわわ……なんたるセオリー……
				ELSE
					BTL_KOJO_RESULTS:0 = 魅了、チャームをうけて……ううう……
				ENDIF
			CASE "CURSE"
				IF 0
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = 呪われてしまったセオリー……！
				ELSE
					BTL_KOJO_RESULTS:0 = ぐっ、カーズを受けてしまったプロセス……！
				ENDIF
			CASE "FLY"
				BTL_KOJO_RESULTS:0 = %CALLNAME:ARG%는 날아다니고 있다……。
			CASE "STONE"
				BTL_KOJO_RESULTS:0 = %CALLNAME:ARG%는 말 못하는 석상이 되어있다……。
			CASE "FLAME"
				IF 0
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = あつっ、あっつい、ヒートでホットなセオリーっ！
				ELSE
					BTL_KOJO_RESULTS:0 = え、エンチャントファイア……！
				ENDIF
			CASE "SLIP"
				IF 0
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = あいたぁーっ！（ｽﾞﾍﾞｼｬｧ）
				ELSE
					BTL_KOJO_RESULTS:0 = た、体勢が悪いセオリーです！
				ENDIF
			CASE "BRAND"
				IF 0
				ELSEIF !RAND:2
					BTL_KOJO_RESULTS:0 = こんな刻印ブランドマークなど……！
				ELSE
					BTL_KOJO_RESULTS:0 = くっ、ブランドをマークされてしまいました……！
				ENDIF
			;その他の状態異常
			;CASEELSE
		ENDSELECT
	;食いしばり等で耐えた
	ELSEIF TFLAG:전투이벤트 == 23
		;이악물기
		IF BASE:ARG:ＨＰ == 1
			BTL_KOJO_RESULTS:0 = ……耐えきったカテゴリーですッ！
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = こんなものでは、倒れてあげられない……！
		ENDIF



	;回復してもらった
	ELSEIF TFLAG:전투이벤트 == 24
		;ARG:2　回復量
		LOCAL = ARG:2 * 100 / BASE:ARG:ＨＰ
		;LOCAL　回復量割合
		IF 0
		;キャラ分岐
		;主人
		ELSEIF NO:(ARG:1) == [[キャラ:당신]]
			BTL_KOJO_RESULTS:0 = サンキューの意を表します！
		;50%以上 & HPほぼ満タン
		ELSEIF LOCAL > 50 && 現HP割合(ARG) > 90
			BTL_KOJO_RESULTS:0 = ナイス回復行動です！
		;50%以上
		ELSEIF LOCAL > 50
			BTL_KOJO_RESULTS:0 = ワンブレス、つけました……！
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = サンキューの意を表します！
		ENDIF
	;状態異常を直してもらった
	ELSEIF TFLAG:전투이벤트 == 25
		;ARG:2　直ったバステ
		IF 0
		ELSE
			SELECTCASE GET_STATE(ARG:2)
				CASE "SLEEP"
					BTL_KOJO_RESULTS:0 = ふゃっ、あ、グッドモーニングです！
				;その他の状態異常
				CASEELSE
					BTL_KOJO_RESULTS:0 = ナイス回復行動です！
			ENDSELECT
		ENDIF
	;戦闘中イって行動不能にならず耐えた(ムフフ展開時のみ)
	ELSEIF TFLAG:전투이벤트 == 47
		;歯を食いしばって快楽に耐えた
		BTL_KOJO_RESULTS:0 = はぅっ%ハート()%　っく%ハート()%
	;行動中イって行動不能になった(ムフフ展開時のみ 50%の確率でHAPPYに)
	ELSEIF TFLAG:전투이벤트 == 48
		;GET_STATE(CFLAG:ARG:상태이상) == "HAPPY"
		
		;絶頂の余韻に浸っている
		BTL_KOJO_RESULTS:0 = あっ%ハート()%　あぅう%ハート()%
	;ターン終了時状態異常が自然回復した
	ELSEIF TFLAG:전투이벤트 == 50
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
