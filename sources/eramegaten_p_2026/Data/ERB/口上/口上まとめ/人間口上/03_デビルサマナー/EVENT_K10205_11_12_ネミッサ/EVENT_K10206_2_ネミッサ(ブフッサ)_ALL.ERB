				IF TALENT:연모 || TALENT:친애
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORMW 
					;二回目（リーチ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORMW 
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						PRINTFORMW 
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORMW 
					;二回目（リーチ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
