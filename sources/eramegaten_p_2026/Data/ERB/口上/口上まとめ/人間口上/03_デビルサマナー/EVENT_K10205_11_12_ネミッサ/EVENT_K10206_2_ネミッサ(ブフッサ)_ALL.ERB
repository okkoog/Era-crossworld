		;残り体力500未満
		IF BASE:0 < 500 && RAND:3 == 0
			PRINTFORML 
			PRINTFORML 「기분 좋은 피로감이다 부흐…♪」
		ELSEIF RAND:2 == 0
			PRINTFORML 
			PRINTFORML 「히토미의 몸… 엄청 기분 좋아질 수 있다 부흐…%ハート()%」
		ELSE
			PRINTFORML 
			PRINTFORML 「이대로 타락하는 것도 나쁘지 않다 부흐…♪」
		ENDIF
	ELSE
		;残り体力500未満
		IF BASE:0 < 500 && RAND:3 == 0
			PRINTFORML 
			PRINTFORML 「기분 좋은 피로감이다 부흐…♪」
		ELSEIF RAND:2 == 0
			PRINTFORML 
			PRINTFORML 「히토미의 몸… 엄청 기분 좋아질 수 있어…%ハート()%」
		ELSE
			PRINTFORML 
			PRINTFORML 「이대로 타락하는 것도 나쁘지 않아…♪」
		ENDIF
	ENDIF
	PRINTFORML %CALLNAME%은(는) 확실하게 쾌락을 인정하며, 황홀한 표정으로 가쁜 숨을 몰아쉬고 있었다.
	PRINTFORMW 
	CFLAG:219 = 3
;陥落済み
ELSEIF CFLAG:219 < 4 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:연모 || TALENT:친애
		PRINTFORML
		;ブフ口調フラグＯＮ
		IF CFLAG:800 == 1
			;強い場合
			IF BASE:LV > 30 && RAND:3 == 0
				PRINTFORML 「기운 났다 부흐」
				PRINTFORMW 「MAG가 아니라, %CSTR:이인칭%과(와) 함께 있을 수 있었으니까다 부흐%ハート()%」
				PRINTFORML 「이걸로 다시 싸울 수 있다 부흐」
				PRINTFORMW 살을 맞대고 %CALLNAME%은(는) 만족스러운 표정이다.
			ELSEIF RAND:2 == 0
				PRINTFORML 「벌써 끝이부흐?」
				PRINTFORMW 아쉬운 표정을 짓고 있는 %CALLNAME%에게 다시 올 것을 약속했다.
			ELSE
				PRINTFORML 「좋았다 부흐…%ハート()%」
				PRINTFORMW 기분 좋은 피로감에 감싸이며 %CALLNAME:MASTER%이(가) 조교의 종료를 알리자, %CALLNAME%은(는) 미소 지으며 뺨에 입을 맞추었다.
			ENDIF
		ELSE
			;強い場合
			IF BASE:LV > 30 && RAND:3 == 0
				PRINTFORML 「기운 났어」
				PRINTFORMW 「MAG가 아니라, %CSTR:이인칭%과(와) 함께 있을 수 있었으니까」
				PRINTFORML 「이걸로 다시 싸울 수 있어」
				PRINTFORMW 살을 맞대고 %CALLNAME%은(는) 만족스러운 표정이다.
			ELSEIF RAND:2 == 0
