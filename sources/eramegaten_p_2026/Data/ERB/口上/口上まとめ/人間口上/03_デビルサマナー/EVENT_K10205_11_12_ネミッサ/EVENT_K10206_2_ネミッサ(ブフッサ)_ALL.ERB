						PRINTFORMW 
					ENDIF
				ENDIF
			ELSE
				;主人以外の誰かに陥落している状態で更に別のキャラにＮＴＲ
				;進行度分岐
				;初回
				IF CFLAG:예ＮＴＲ진행도 == 0
