;--------------------------------------------------
;調教終了時のセリフ
;--------------------------------------------------
DRAWLINE
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:217 < 1 || FLAG:7 == 2)
	;ブフ口調フラグＯＮの場合
	IF CFLAG:800 == 1
		PRINTFORML 　
		IF TALENT:연모 || TALENT:친애
			PRINTFORML 「네… 끝났다 부흐…… 자… %CSTR:일인칭%을(를) 두고 가라 부흐…」
			PRINTFORML 완전히 화나게 해버린 모양이다. %CALLNAME%은(는) 쌀쌀맞은 태도로 쏘아붙인다.
			IF TALENT:아내
				PRINTFORML 아내인 %CALLNAME%이(가) 이 상태라면 일상생활에도 지장이 생긴다. 기분이 풀리도록 뭔가 궁리해 봐야겠다…
			ELSE
				PRINTFORML 이대로 계속 화나게 했다간 귀찮은 일이 벌어질지도 모른다. 조속히 손을 쓰는 편이 좋을 것 같다…
			ENDIF
		ELSE
			PRINTFORML 「끝났으면 나가라 부흐……읏」
			PRINTFORML %CALLNAME%은(는) 유린당한 몸을 숨기려 하지도 않고 쏘아붙여 왔다.
		ENDIF
	ELSE
		PRINTFORML 　
		IF TALENT:연모 || TALENT:친애
			PRINTFORML 「%CSTR:일인칭%의 방에서 나가줘…」
			PRINTFORML 완전히 화나게 해버린 모양이다. %CALLNAME%은(는) 쌀쌀맞은 태도로 쏘아붙인다.
			IF TALENT:아내
				PRINTFORML 아내인 %CALLNAME%이(가) 이 상태라면 일상생활에도 지장이 생긴다. 기분이 풀리도록 뭔가 궁리해 봐야겠다…
			ELSE
				PRINTFORML 이대로 계속 화나게 했다간 귀찮은 일이 벌어질지도 모른다. 조속히 손을 쓰는 편이 좋을 것 같다…
			ENDIF
		ELSE
			PRINTFORML 「끝났으면 나가줘…」
			PRINTFORML %CALLNAME%은(는) 유린당한 몸을 숨기려 하지도 않고 쏘아붙여 왔다.
		ENDIF
	ENDIF
	PRINTFORMW
	CFLAG:217 = 1
;屈服刻印Lv1以下
ELSEIF MARK:2 <= 1 && (CFLAG:219 < 1 || FLAG:7 == 2)
	;ブフ口調フラグＯＮの場合
	IF CFLAG:800 == 1
		PRINTFORML 
		PRINTFORML 「히토미… 미안하다 부흐……」
	ELSE
		PRINTFORML 
		PRINTFORML 「히토미… 미안해…」
	ENDIF
	PRINTFORML %CALLNAME%은(는) 반항적인 시선을 보내며 흐트러진 숨을 쉬면서 그렇게 중얼거리고 있었다.
	PRINTFORMW 
	CFLAG:219 = 1
;屈服刻印Lv2
ELSEIF MARK:2 == 2
	;ブフ口調フラグＯＮの場合
	IF CFLAG:800 == 1
		PRINTFORML 
		PRINTFORML 「이런 거 계속했다간… %CSTR:일인칭%… 망가져버린다 부흐…」
	ELSE
		PRINTFORML 
		PRINTFORML 「이런 거 계속했다간… %CSTR:일인칭%… 망가져버려…」
	ENDIF
	PRINTFORML %CALLNAME:MASTER%이(가) 주는 쾌락을 받아들이기 시작해, 절정의 여운을 즐기기라도 하듯 몸을 비트는 %CALLNAME%이었다.
	PRINTFORMW
	CFLAG:219 = 2
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && 陥落() == 0
	;ブフ口調フラグＯＮの場合
