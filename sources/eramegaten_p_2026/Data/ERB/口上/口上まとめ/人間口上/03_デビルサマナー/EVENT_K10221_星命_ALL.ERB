;-------------------------------------------------
;調教開始時（2回目以降、4543をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_K[[キャラ:세이메이]]
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORMW 「나의 전생애를 걸고、너를 죽인다。반드시、죽인다…！」
	PRINTFORMW %TARGET은% 증오로 가득 찬 감정을 발하고 있다…
	CFLAG:202 = 4
;屈服刻印Lv0
ELSEIF MARK:2 == 0 && (CFLAG:202 < 1 || FLAG:7 == 2)
	PRINTFORMW 「너는、나에게 그런 것을 시키는 위해 나를 데리고온건가？」
	PRINTFORMW 기가 막힌다, 는 표정으로 %MASTER를% 폄하한다…
	CFLAG:202 = 1
;屈服刻印Lv1
ELSEIF MARK:2 == 1 && (CFLAG:202 < 2 || FLAG:7 == 2)
	PRINTFORMW 「조교…인가. 이런 세계가 있었다니 말이지…」
	PRINTFORMW %TARGET은% 자조와 함께 %MASTER를% 노려본다…
	CFLAG:202 = 2
;屈服刻印Lv2
ELSEIF MARK:2 == 2 && (CFLAG:202 < 3 || FLAG:7 == 2)
	;PRINTFORMW 「」
	CFLAG:202 = 3
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0) && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORMW 「넌가… 기다리고 있었다」
	CFLAG:202 = 4
;陥落済み
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORMW 방에 들어갔자 %MASTER를% 아무것도 말하지 않고 꼭 껴안아 왔다…
		ELSEIF K:1 == 1
			PRINTFORMW 「오늘은 %MASTER를% 만날 수 있을거란 생각이 들었었다」
		ELSE
			PRINTFORMW 「와 준건가！」
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORMW 「……기다리고 있었다…」
		ELSEIF K:1 == 1
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORMW 
		ELSEIF K:1 == 1
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
	CFLAG:202 = 5
ENDIF
RETURN 0

;-------------------------------------------------
;EVENTEND関係（4543をキャラ番号に置換）
;調教終了時のセリフ
;-------------------------------------------------
@EVENTEND_K[[キャラ:세이메이]]
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、4543を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL EVENTEND_PY1_K[[キャラ:세이메이]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	SIF NO:ASSI == Y1
;	CALL EVENTEND_PY1_K[[キャラ:세이메이]]
;	RETURN 0
;ENDIF
;--------------------------------------------------
;調教終了時のセリフ
;--------------------------------------------------
DRAWLINE
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:217 < 1 || FLAG:7 == 2)
	PRINTFORML 「……죽여버리겠다는、상냥한 짓은 하지 않겠다…」
	PRINTFORMW 「내 비술을 전부 써서, 네놈의 모든 것을 빼앗아주겠어…！」
	CFLAG:217 = 1
;屈服刻印Lv1以下
ELSEIF MARK:2 <= 1 && (CFLAG:219 < 1 || FLAG:7 == 2)
	PRINTFORMW 「이제 오지 말아줘…」
	CFLAG:219 = 1
;屈服刻印Lv2
ELSEIF MARK:2 == 2
	PRINTFORMW 「……이런 일을 하려고、나는…！」
	CFLAG:219 = 2
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	IF RAND:5 == 0
		PRINTFORMW （나는, 대체 뭘 하고 있는 거지…?）
	ELSEIF RAND:4 == 0
		PRINTFORMW 「너는 또 오는 건가？　……기대하고 기다리지」
	ELSEIF RAND:3 == 0
		PRINTFORMW 「나는 아직 너를 기다려 있네…　뭐、혼자  있는건 익숙해져 있네」
	ELSEIF RAND:2 == 0
		PRINTFORMW 「가는 건가？　……할 수 있으면、죽지 말아줘」
	ELSE
		PRINTFORMW 「이것으로 마지막？　……그럼、또 다음의 기회를 기다려 있지」
	ENDIF
	CFLAG:219 = 3
;陥落済み＋体力500未満
ELSEIF BASE:0 < 500 && (CFLAG:218 < 1 || FLAG:7 == 2)
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		PRINTFORMW 
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		PRINTFORMW 
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORMW 
	ENDIF
	CFLAG:218 = 1
;陥落済み
ELSEIF CFLAG:219 < 4 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		IF RAND:2 == 0
			PRINTFORMW 「너와、좀더 보내고 싶었다…」
		ELSE
			PRINTFORMW 「…이제、가버리는겐가…？」
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		IF RAND:2 == 0
			PRINTFORMW 「…배가 가득…일까나？」
		ELSE
			PRINTFORMW 「아직도 즐겨야…」
		ENDIF
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		IF RAND:2 == 0
			PRINTFORMW 「감사합니다…」
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
	CFLAG:219 = 4
ENDIF
RETURN 0

