		;奉仕される側
		;PLAYERに奉仕する側の番号が入っています
		;-------------------------------------------------
	CASE 84
		CALL EVENT_MESSAGE
		IF (CFLAG:607 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:607 = 1
		ENDIF
