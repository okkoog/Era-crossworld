;-------------------------------------------------
;助手の有無をチェック（いない場合は二回目以降へ飛ぶ）
IF ASSI < 0 
	CALL EVENTTRAIN_SECOND_K[[キャラ:세이메이]]
;助手
;ELSEIF NO:ASSI == Y1
	;初めて
;	IF CFLAG:203 == 0
		;陥落済み＋陥落時初口上が発生済み
;		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && CFLAG:201 >= 5
