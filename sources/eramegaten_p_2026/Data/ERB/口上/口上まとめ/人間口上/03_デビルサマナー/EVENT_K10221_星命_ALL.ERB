		;奉仕する側
		;PLAYERに実行者=輪姦する悪魔の番号が入っています
		;-------------------------------------------------
	CASE 85
		CALL EVENT_MESSAGE
		IF (CFLAG:608 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:608 = 1
		ENDIF
