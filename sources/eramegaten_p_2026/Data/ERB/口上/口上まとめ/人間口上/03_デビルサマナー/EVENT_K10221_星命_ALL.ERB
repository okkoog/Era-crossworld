		;-------------------------------------------------
	CASE 83
		CALL EVENT_MESSAGE
		IF (CFLAG:606 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:606 = 1
		ENDIF
		;-------------------------------------------------
