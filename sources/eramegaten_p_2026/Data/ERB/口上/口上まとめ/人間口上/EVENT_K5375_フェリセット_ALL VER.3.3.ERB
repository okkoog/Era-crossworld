;簡易助手口上（Y1を助手のキャラ番号に置換、X1をキャラ番号に変更する) CFLAG203
;掛け合いをするキャラを増やす場合は、構文をコピー＆ペーストをして、CFLAGの数を204、205と増やす
;-------------------------------------------------
;助手の有無をチェック（いない場合は二回目以降へ飛ぶ）
IF ASSI < 0 
	CALL EVENTTRAIN_SECOND_K[[キャラ:펠리세트]]
;助手
ELSEIF 助手確認([[キャラ:마르푸샤]])
	;初めて
	IF CFLAG:203 == 0
		;陥落済み＋陥落時初口上が発生済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && CFLAG:201 >= 5
			WSTR:(K++) = 「あら？　今日はマルフーシャお姉さんも一緒なんですか」
			WSTR:(K++) = 『戦友が同じ人の愛人になってるのは奇妙だね。%CALLNAME:TARGET%はどんな気持ち？』
			WSTR:(K++) = 「%CSTR:일인칭%はお姉さんと一緒ならどんなことでもうれしいですよ。いっそのこと%CSTR:이인칭%が嫉妬するくらい可愛がってくれますか？」
			
		;それ以外
		ELSE
			KSTR:(K++) = 「あの、どうしてマルフーシャお姉さんがここにいるんですか？」
			KSTR:(K++) = 『ごめんね%CALLNAME:TARGET%、調教の手伝いとして呼ばれたんだ。あんまり抵抗しないでくれると助かるんだけど……』
			KSTR:(K++) = 「友人に痴態を見せるのは、%CSTR:이인칭%……さすがにこれは悪趣味だと思いますよ？」
		ENDIF
		CFLAG:203 = 1
	;二回目以降
	ELSEIF CFLAG:203 < 2 || FLAG:7 ==2
		;陥落済み
		IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
			WSTR:(K++) = 『今日もよろしくね、%CALLNAME:TARGET%』
			KSTR:(K++) = 「はい、よろしくお願いしますねマルフーシャお姉様……」
			KSTR:(K++) = 見つめ合う二人を見ながら%CALLNAME:MASTER%は奇妙な疎外感を覚えた。
		;それ以外
		ELSE
			KSTR:(K++) = 「マルフーシャお姉さんはこういう扱いに納得しているんですか？」
			KSTR:(K++) = 『好きではやってないけど、この人の頼みだからね。さ、%CALLNAME:TARGET%しようか』
		ENDIF
		CFLAG:203 = 2
	ENDIF
;口上のある助手が居ない場合は、通常の二回目以降の口上へ飛ぶ
ELSE
	CALL EVENTTRAIN_SECOND_K[[キャラ:펠리세트]]
ENDIF

