;ライセンスについて
;	・基本項目(許可する項目を"○"に、許可しない項目を"×"に変更してください。)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1| ○ | 処理上のバグ修正              |
;	+----+----+-------------------------------+
;	|   2| ○ | 口上の誤字・脱字の修正        |
;	+----+----+-------------------------------+
;	|   3| ○ | 口上まとめへの収録            |
;	+----+----+-------------------------------+
;	|   4| ○ | 口上の新規追加                |
;	+----+----+-------------------------------+
;	|   5| ○ | 既存口上の改変                |
;	+----+----+-------------------------------+
;	|   6| ○ | 改変した口上の自由な再配布    |
;	+----+----+-------------------------------+
;	|   7| ○ | 口上内容の転載                |
;	+----+----+-------------------------------+
;-------------------------------------------------
;【使用CFLAG】
;　CFLAG:800　ROROの歌判定 for awakening
;　CFLAG:801　ROROの歌判定 for darkness
;　CFLAG:802　ROROの歌判定 for diva
;　CFLAG:803　個別イベント用判定
;　　0:普段
;　　1:vsバタフライエフェクト
;　　2:vsアシモフ
;　　3:vsデマーゼル
;　　4:vs蒼龍銀虎
;　　5:vsイプシロン3
;　　6:vsイプシロン?1
;　　7:vsイプシロン?2
;　　8:vsマザー1
;　　9:vsマザー2
;　CFLAG:804　個別イベント制御用（X:日付取得　口上では使わない）/（X2:戦闘イベント用）
;　CFLAG:805　個別イベント制御用（X:時刻取得　口上では使わない）/（X2:戦闘イベント用）
;　CFLAG:806　個別イベント制御用（X:続き見ないよフラグ）/（X2:戦闘イベント用）
;　CFLAG:807　個別イベント制御用（X2:戦闘イベント用）
;　CFLAG:808　未使用にｳﾞｧﾆｯｼｭﾀﾞ
;　CFLAG:809　ブリッツダッシュ判定（ONだとブリッツダッシュ、OFFだとディヴァイド）
;　CFLAG:810　未使用にｳﾞｧﾆｯｼｭﾀﾞ
;--------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:아큐라_X]], ARG, ARG:1, ARG:2
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		SELECTCASE TSTR:전투이벤트패턴
			CASE "EVENT_200_4_ペインフルデターミネーション"
				BTL_KOJO_RESULTS:0 = 약점까지 완전히 똑같아…… 이상한 흉내나 내고！
			CASE "EVENT_200_5_電気仕掛けの狂神1"
				BTL_KOJO_RESULTS:0 = 네놈의 약점 따위는 이미 해석이 끝났다
			CASE "EVENT_200_5_電気仕掛けの狂神2"
				BTL_KOJO_RESULTS:0 = 이번에야말로、네놈을 토멸하겠다！
			CASE "EVENT_201_4_イプシロン3"
				BTL_KOJO_RESULTS:0 = 입실론！　이걸로 끝을 내겠다！
			CASE "EVENT_201_5_創造主"
				IF CPOS(GET_ENEMY("イプシロン？")) > 0
					BTL_KOJO_RESULTS:0 = 가로막겠다면……！
				ELSE
					BTL_KOJO_RESULTS:0 = 또 하나의 %CSTR:ARG:일인칭%라고 할지라도、넘어설 뿐이다……！
				ENDIF
			CASE "EVENT_201_7_マザー", "EVENT_201_7_マザー2"
				BTL_KOJO_RESULTS:0 = 네놈을、해방시킨다……！
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = 몰아넣었다……！
					CASE 1
						BTL_KOJO_RESULTS:0 = 이걸로、산산히 흩어져라
					CASE 2
						BTL_KOJO_RESULTS:0 = 놓치지 않아！
				ENDSELECT
		ENDSELECT
	;COOP参加
	CASE 2
		SELECTCASE TSTR:전투이벤트패턴
			CASE "EVENT_200_5_電気仕掛けの狂神2"
				BTL_KOJO_RESULTS:0 = 마지막 전언이다……！
			CASE "EVENT_201_4_イプシロン3"
				BTL_KOJO_RESULTS:0 = 이걸로 끝이다、입실론！
			CASE "EVENT_201_5_創造主"
				IF CPOS(GET_ENEMY("アキュラ？")) > 0
					BTL_KOJO_RESULTS:0 = 마무리는 %CSTR:ARG:일인칭%에게 맡겨줘……！
				ELSE
					BTL_KOJO_RESULTS:0 = さっさと片づけるぞ
				ENDIF
			CASE "EVENT_201_7_マザー2"
				BTL_KOJO_RESULTS:0 = 마더…… 이젠、잠들어라！
			;主人がCOOP発動
			CASEELSE
				IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
					SELECTCASE RAND:3
						CASE 0
							BTL_KOJO_RESULTS:0 = 놓칠까보냐！
						CASE 1
							BTL_KOJO_RESULTS:0 = 신속하게 정리하겠다
						CASE 2
							BTL_KOJO_RESULTS:0 = 이것으로……！
					ENDSELECT
				;GVがCOOP発動
				ELSEIF FLAG:행동순1 != -1 && NO:(FLAG:행동순1) == [[キャラ:GV]]
					SELECTCASE RAND:3
						CASE 0
							BTL_KOJO_RESULTS:0 = 설마、너와 어깨를 나란히 할 날이 올 줄이야
						CASE 1
							BTL_KOJO_RESULTS:0 = 이 틈을 놓치지 않겠어！
						CASE 2
							BTL_KOJO_RESULTS:0 = 이걸로、끝이다……！
					ENDSELECT
				;それ以外
				ELSE
					SELECTCASE RAND:3
						CASE 0
							BTL_KOJO_RESULTS:0 = 놓칠까보냐！
						CASE 1
							BTL_KOJO_RESULTS:0 = 신속하게 정리하겠다
						CASE 2
							BTL_KOJO_RESULTS:0 = 이것으로……！
					ENDSELECT
				ENDIF
		ENDSELECT
	;被召喚時
	CASE 3
		;BTL_KOJO_RESULTS:0 = 
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;味方に攻撃した
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF TSTR:전투이벤트패턴 == "EVENT_200_5_電気仕掛けの狂神1"
				IF SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) != 1
					CALL SET_RORO_KOJO_FLAG, ARG
					BTL_KOJO_RESULTS:0 = 반응 소멸…… 하지만、아직 끝난 건 아니겠지
					CALL PRINT_KOJO_RPG_MESSAGE, , ARG
					SETCOLOR COLOR("FRIEND")
				ENDIF
				BTL_KOJO_RESULTS:0 = 아아…… 놈은 분명、바로 근처에서 보고 있을 거다
			ELSEIF TSTR:전투이벤트패턴 == "EVENT_200_5_電気仕掛けの狂神2"
				BTL_KOJO_RESULTS:0 = 토멸…… 완료
			ELSEIF TSTR:전투이벤트패턴 == "EVENT_201_4_イプシロン3"
				BTL_KOJO_RESULTS:0 = 이걸로…… 잠들어라、입실론
			ELSEIF TSTR:전투이벤트패턴 == "EVENT_201_5_創造主" && CPOS(GET_ENEMY("アキュラ？")) > 0
				BTL_KOJO_RESULTS:0 = 말해줘야겠어…… 모든 것을
			ELSEIF TSTR:전투이벤트패턴 == "EVENT_201_7_マザー"
				BTL_KOJO_RESULTS:0 = 이것으로、무력화는 시킬 수 있었을텐데……！
			ELSEIF TSTR:전투이벤트패턴 == "EVENT_201_7_マザー2"
				BTL_KOJO_RESULTS:0 = 마더의 토멸을、확인……
			ELSE
				IF SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
				ELSEIF (GET_RPG_CSTR_TAKEOVER(ARG, "モード") == "X2" && SKILLGAGE_H_GET(ARG, [[스킬:SONG OF DIVA]]) > 0 && SKILLGAGE_D_GET(ARG, [[스킬:블리츠대쉬]]) > 0) || RAND:2 == 0
					CALL SET_RORO_KOJO_FLAG, ARG
					IF CFLAG:ARG:입력행동 == [[스킬:X-ROSS DISASTER]]
						BTL_KOJO_RESULTS:0 = 끝났다앗！　최강 콤비네이션！
					ELSE
						IF GET_RPG_CSTR_TAKEOVER(ARG, "モード") == "X2"
							SELECTCASE SKILLGAGE_H_GET(ARG, [[스킬:SONG OF DIVA]])
							CASE 0
								BTL_KOJO_RESULTS:0 = 해냈어！　앞길에 적은 없어！
							CASE 1
								BTL_KOJO_RESULTS:0 = ＱＵＩＣＫ ＢＲＥＡＫ！　해냈구나！
							CASE 2
								BTL_KOJO_RESULTS:0 = 훌륭해！　눈으로도 쫓을 수 없는 무기 다루기！
							CASE 3
								BTL_KOJO_RESULTS:0 = 신속 격파！　팍팍 가자！
							CASE 4
								BTL_KOJO_RESULTS:0 = 이 스피드！　그야말로 전광석화로구나！
							CASE 5
								BTL_KOJO_RESULTS:0 = 너의 기세는、멈출 줄을 모르는구나！
							ENDSELECT
						ELSE
							BTL_KOJO_RESULTS:0 = 적을 격파！　역시 아큐라 군！
						ENDIF
					ENDIF
					CALL PRINT_KOJO_RPG_MESSAGE, , ARG
					SETCOLOR COLOR("FRIEND")
				ENDIF
				SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 당연한 결과야
				CASE 1
					BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%는…… 지지 않아
				CASE 2
					BTL_KOJO_RESULTS:0 = 이런 걸로 좋아할 수는 없어
				ENDSELECT
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 약점이 막혔다、다시 한번 가겠나？
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			IF SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
			ELSEIF RAND:2 == 0
				CALL SET_RORO_KOJO_FLAG, ARG
				BTL_KOJO_RESULTS:0 = 이 무기、효과가 있는 것 같아！
				CALL PRINT_KOJO_RPG_MESSAGE, , ARG
				SETCOLOR COLOR("FRIEND")
			ENDIF
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 네놈은 놓치지 않겠다、다음 걸로 끝을 내겠어……！
			CASE 1
				BTL_KOJO_RESULTS:0 = 유효한 데미지이다
			CASE 2
				BTL_KOJO_RESULTS:0 = 앞으로 한 발짝 남은건가
			ENDSELECT
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			IF SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
			ELSEIF RAND:2 == 0
				CALL SET_RORO_KOJO_FLAG, ARG
				BTL_KOJO_RESULTS:0 = 이 기세로 가라앗ー！
				CALL PRINT_KOJO_RPG_MESSAGE, , ARG
				SETCOLOR COLOR("FRIEND")
			ENDIF
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 나쁘지 않아
			CASE 1
				BTL_KOJO_RESULTS:0 = 생각보다 튼튼하군
			CASE 2
				BTL_KOJO_RESULTS:0 = 오래 끌 생각은 없어
			ENDSELECT
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF TSTR:전투이벤트패턴 == "EVENT_200_5_電気仕掛けの狂神1"
				BTL_KOJO_RESULTS:0 = 이런 곳에서 시간을 낭비할 수는 없어……！
			ELSEIF TSTR:전투이벤트패턴 == "EVENT_200_5_電気仕掛けの狂神2"
				BTL_KOJO_RESULTS:0 = 네놈만은 놓치지 않겠어、절대로……！
			ELSE
				IF SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
				ELSEIF RAND:2 == 0
					CALL SET_RORO_KOJO_FLAG, ARG
					BTL_KOJO_RESULTS:0 = 안되겠어、제대로 먹히지를 않아……
					CALL PRINT_KOJO_RPG_MESSAGE, , ARG
					SETCOLOR COLOR("FRIEND")
				ENDIF
				SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 효과가 약한가……
				CASE 1
					BTL_KOJO_RESULTS:0 = 유효한 무기를 찾아야겠군
				CASE 2
					BTL_KOJO_RESULTS:0 = 시간이 걸릴 것 같은데
				ENDSELECT
			ENDIF
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			IF TSTR:전투이벤트패턴 == "EVENT_200_5_電気仕掛けの狂神1"
				BTL_KOJO_RESULTS:0 = 이런 곳에서 시간을 낭비할 수는 없어……！
			ELSEIF TSTR:전투이벤트패턴 == "EVENT_200_5_電気仕掛けの狂神2"
				BTL_KOJO_RESULTS:0 = 네놈만은 놓치지 않겠어、절대로……！
			ELSE
				IF SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
				ELSEIF RAND:2 == 0
					CALL SET_RORO_KOJO_FLAG, ARG
					BTL_KOJO_RESULTS:0 = 이 무기、효과가 없는 것 같아……
					CALL PRINT_KOJO_RPG_MESSAGE, , ARG
					SETCOLOR COLOR("FRIEND")
				ENDIF
				SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 뭐……？
				CASE 1
					BTL_KOJO_RESULTS:0 = 그렇다면、다음 수다
				CASE 2
					BTL_KOJO_RESULTS:0 = 귀찮군……
				ENDSELECT
			ENDIF
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF TSTR:전투이벤트패턴 == "EVENT_200_5_電気仕掛けの狂神1" || TSTR:전투이벤트패턴 == "EVENT_200_5_電気仕掛けの狂神2"
				BTL_KOJO_RESULTS:0 = 미틸…… 나는……！
			ELSEIF TSTR:전투이벤트패턴 == "EVENT_201_7_マザー" || TSTR:전투이벤트패턴 == "EVENT_201_7_マザー2"
				BTL_KOJO_RESULTS:0 = 미안하다…… 코하쿠、널……！
			ELSE
				BTL_KOJO_RESULTS:0 = 우옷……！
			ENDIF
		;味方に攻撃された
		ELSEIF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
			BTL_KOJO_RESULTS:0 = ……어딜 노리고 있나
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF SKILLGAGE_H_GET(ARG, [[스킬:DARKNESS TRIGGER]]) == 1
			ELSEIF RAND:2 == 0
				SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 데미지、위험 영역！　조심해、아큐라 군！ 
				CASE 1
					BTL_KOJO_RESULTS:0 = 와왓！　체력이 위험하다구！　조심해！
				CASE 2
					BTL_KOJO_RESULTS:0 = 괜찮아？　무리는 금물이라구？
				ENDSELECT
				CALL SET_RORO_KOJO_FLAG, ARG
				CALL PRINT_KOJO_RPG_MESSAGE, , ARG
				SETCOLOR COLOR("FRIEND")
			ENDIF
			IF TSTR:전투이벤트패턴 == "EVENT_200_5_電気仕掛けの狂神1" || TSTR:전투이벤트패턴 == "EVENT_200_5_電気仕掛けの狂神2"
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = 이런 상처 따위는
					CASE 1
						BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%의 몸이 어떻게 되든 간에、네놈만은……！
					CASE 2
						BTL_KOJO_RESULTS:0 = 이제 와서 죽음 따위 무서울 것 같나……！
				ENDSELECT
			ELSEIF TSTR:전투이벤트패턴 == "EVENT_201_7_マザー2"
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = 너를 해방시키기 전까지는、죽을 수 없어……！
					CASE 1
						BTL_KOJO_RESULTS:0 = 세계를、끝내버릴 수는……！
