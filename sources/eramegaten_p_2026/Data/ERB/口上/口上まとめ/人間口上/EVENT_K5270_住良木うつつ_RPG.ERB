				PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			ENDIF
		ENDIF
		
	CASE "被ダメージ_単体"
		;Death
		IF BASE:ARG:ＨＰ <= 0
			;それ以外
			IF RAND:3 == 0
				PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
				PRINTFORML ┃%"も、もうHP残ってないよぉ……",72,LEFT%┃
