				PRINTFORML ┃%"な、なんで！？",72,LEFT%┃
				PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			ELSEIF RAND:2 == 0
				PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
				PRINTFORML ┃%"また状況を悪くしちゃった…",72,LEFT%┃
				PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
			ELSE
				PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
