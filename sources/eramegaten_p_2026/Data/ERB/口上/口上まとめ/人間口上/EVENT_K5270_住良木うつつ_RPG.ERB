@KOJO_BATTLE_EVENT_K[[キャラ:스메라기우츠츠]], ARG, ARG:1, ARG:2
SELECTCASE GET_BATTLE_EVENT(TFLAG:전투이벤트)
	;Character initiates COOP
	CASE "COOP発動"
		IF RAND:4 == 0
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
