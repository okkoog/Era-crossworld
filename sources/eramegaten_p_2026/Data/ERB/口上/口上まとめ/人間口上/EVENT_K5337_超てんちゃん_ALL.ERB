@調教中だけ超てんちゃんのCALLNAMEかえるやつ, ARG
#DIM 超てんちゃんのCALLNAME変えた判定

;調教開始時、CALLNAMEがデフォの値の時、CALLNAMEをNAMEにかえる
IF ARG == 1 && CALLNAME:TARGET == "超てんちゃん"
	CALLNAME:TARGET = %NAME:TARGET%
	超てんちゃんのCALLNAME変えた判定 = 1
	
;調教終了時、CALLNAMEを変えた痕跡があればデフォの値にもどす
ELSEIF 超てんちゃんのCALLNAME変えた判定 == 1
	超てんちゃんのCALLNAME変えた判定 = 0
	CALLNAME:TARGET = 超てんちゃん
ENDIF
