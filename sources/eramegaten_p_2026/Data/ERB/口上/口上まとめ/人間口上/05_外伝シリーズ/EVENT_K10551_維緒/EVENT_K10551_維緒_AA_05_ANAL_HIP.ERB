;-------------------------------------------------
;〇A愛撫_ハブ
;-------------------------------------------------
@AA_K[[キャラ:이오]]_A系_A愛撫_ハブ
	;屈服状況で表示を変更する
	IF 0
	ELSEIF 陥落()
		IF RAND:2 == 0
			CALL AA_K[[キャラ:이오]]_A系_A愛撫１
		ELSE
			CALL AA_K[[キャラ:이오]]_A系_A愛撫２
		ENDIF
	;屈服３未満
	ELSE
		CALL AA_K[[キャラ:이오]]_A系_A愛撫１
	ENDIF


;-------------------------------------------------
;〇スパンキング_ハブ
;-------------------------------------------------
@AA_K[[キャラ:이오]]_A系_スパンキング_ハブ
	;屈服状況で表示を変更する
	IF 0
	ELSEIF RAND:2 == 0
		CALL AA_K[[キャラ:이오]]_A系_スパンキング１
	ELSE
		CALL AA_K[[キャラ:이오]]_A系_スパンキング２
	ENDIF



;-------------------------------------------------
;〇Aセックス待機_ハブ
;-------------------------------------------------
@AA_K[[キャラ:이오]]_A系_Aセックス待機_ハブ
	;表示条件アリ
	IF 0
	;A感度５以上で縦割れ追加
	ELSEIF ABL:Ａ감각 > 5 && RAND:2 == 0
		CALL AA_K[[キャラ:이오]]_A系_縦割れアナル
	ELSEIF 陥落() >= 1
		IF RAND:2 == 0
			CALL AA_K[[キャラ:이오]]_A系_Aセックス待機
		ELSE
			CALL AA_K[[キャラ:이오]]_A系_Aセックス待機２
		ENDIF
	ENDIF


;-------------------------------------------------
;〇Aセックス_ハブ
;-------------------------------------------------
@AA_K[[キャラ:이오]]_A系_Aセックス_ハブ

	;おまじない：Aセックス系コマンドを選んだとき限定
	IF GROUPMATCH(SELECTCOM , 62, 63, 67, 70, 71, 73, 515)
		IF 0
			;Aセックス系AAは少ないので体位は見ない
			;（というか、イオのAAに多分ない）
		ELSEIF RAND:3 == 0
			CALL AA_K[[キャラ:이오]]_A系_Aセックス３
		ELSEIF RAND:2 == 0
			CALL AA_K[[キャラ:이오]]_A系_Aセックス２
		ELSE
			CALL AA_K[[キャラ:이오]]_A系_Aセックス１
		ENDIF
	ENDIF


;-------------------------------------------------
;〇アナルパール_ハブ
