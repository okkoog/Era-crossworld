;-------------------------------------------------
;戦闘中のイベント関連
;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:루파]], ARG, ARG:1, ARG:2
SELECTCASE GET_BATTLE_EVENT(TFLAG:전투이벤트)
	;COOP発動 発動者の番号はARGに格納されている
	CASE "COOP発動"
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = ＧＯ！　囲い込め！
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 逃がすな！　退路を断て！
		ELSE
			BTL_KOJO_RESULTS:0 = 今だ！　畳み掛けるぞ！
		ENDIF
	;COOP参加
	CASE "COOP参加"
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 総員、リーダーに続け！
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 加勢する！
			ELSE
				BTL_KOJO_RESULTS:0 = よくやった！　一気に攻め込むぞ！
			ENDIF
		ELSEIF FLAG:행동순1 != -1 && NO:(FLAG:행동순1) == [[キャラ:게일]]
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = あの的確な太刀筋……
				BTL_KOJO_RESULTS:1 = やはり君は優秀な参謀だ、ゲイル！
			ELSE
				BTL_KOJO_RESULTS:0 = ゲイル、良い眼をするようになった……！
			ENDIF
		ELSEIF FLAG:행동순1 != -1 && NO:(FLAG:행동순1) == [[キャラ:서프]]
			BTL_KOJO_RESULTS:0 = ジャンクヤードの覇者よ、後は任せろ！
		ELSEIF FLAG:행동순1 != -1 && NO:(FLAG:행동순1) == [[キャラ:세라]]
			BTL_KOJO_RESULTS:0 = そうだ！　君は最早守られるだけの存在じゃない！
		ELSEIF FLAG:행동순1 != -1 && NO:(FLAG:행동순1) == [[キャラ:로알드]]
			BTL_KOJO_RESULTS:0 = 友よ、二度と君を腰抜けなどと呼ばせはしないッ！
		ELSEIF FLAG:행동순1 != -1 && NO:(FLAG:행동순1) == [[キャラ:히트]]
			BTL_KOJO_RESULTS:0 = 己が灼熱に呑まれすぎるな、エンブリオンの攻撃手(アタッカー)よ！
		;それ以外
		ELSE
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 君の誇り、しかと受け取ったッ！
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 加勢する！
			ELSE
				BTL_KOJO_RESULTS:0 = よくやった！　一気に攻め込むぞ！
			ENDIF
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE "与ダメージ_単体"
		;味方に攻撃した
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			;ハントスキルで仕留めた
			IF GROUPMATCH(CFLAG:ARG:입력행동, [[스킬:물고늘어지기]], [[스킬:씹어흩뿌리기]], [[스킬:물어떼기]], [[스킬:폭음폭식]], [[스킬:귀신먹기]], [[스킬:대상제]], [[스킬:최후의만찬]])
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 許せ……
				ELSE
					BTL_KOJO_RESULTS:0 = 仲間を喰らうよりは――否……
				ENDIF
			ELSE
				BTL_KOJO_RESULTS:0 = 目標、沈黙！
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				IF CFLAG:ARG:악마변신 == 1
					BTL_KOJO_RESULTS:0 = 怯えを見せたなッ！
				ELSE
					BTL_KOJO_RESULTS:0 = それが有効打か！
				ENDIF
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 相当堪えたようだな
		;ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 凡そ有効とは言い難い、か
			ELSE
				BTL_KOJO_RESULTS:0 = 中々に骨のある手合いのようだ
			ENDIF
		;小ダメージ（１以上）
		ELSEIF ARG:2 > 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = あの一撃を物ともせんとはな！
			ELSE
				BTL_KOJO_RESULTS:0 = 硬い……！
			ENDIF
		;ダメージなし（無効・吸収を含む）
		ELSE
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 力及ばず、か……
			ELSE
				BTL_KOJO_RESULTS:0 = ぐっ、やるな……！
			ENDIF
		ENDIF
	;反射された
	CASE "反射された"
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = この屈辱、忘れはせん！
		ELSE
			BTL_KOJO_RESULTS:0 = ぐっ、やるな……！
		ENDIF
	;回避された
	CASE "回避された"
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 行動パターンを見極めねば……！
		ELSE
			BTL_KOJO_RESULTS:0 = ちィッ……！
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE "被ダメージ_単体"
		;味方に攻撃された
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF CFLAG:ARG:악마변신 == 1
				BTL_KOJO_RESULTS:0 = ガアァァァッッ！！？
			ELSE
				SIF CSTR:ARG:아이콘패턴 == "デフォルト"
					TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_0"
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = フレ、ッド……せめて、一目でも……
				ELSE
					BTL_KOJO_RESULTS:0 = また、死ぬ、のか……%CSTR:일인칭%、は――
				ENDIF
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = がはッ……！？
		;瀕死
		;本当にヤバい時ほど大丈夫って言い張るタイプの男とみた。
		ELSEIF 現HP割合(ARG) < 25
			SIF CFLAG:ARG:악마변신 == 0
			TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_0"
			BTL_KOJO_RESULTS:0 = まだだ……%CSTR:일인칭%はまだ、戦える……ッ！
		;ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			BTL_KOJO_RESULTS:0 = く……！　そんなものか？
		;小ダメージ
		ELSE
			BTL_KOJO_RESULTS:0 = 問題ない、跳ね除けてくれる！
		ENDIF
	;無効化した
	CASE "無効化した"
		;吸収した
		IF GET_CREC_ACT(ARG:1, ARG, "DRAIN")
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = その力、糧とさせて貰おう！
			ELSE
				BTL_KOJO_RESULTS:0 = 効かんッ！
			ENDIF
		;無効化した
		ELSE
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 悪いが無効化させて貰った！
			ELSE
				BTL_KOJO_RESULTS:0 = 効かんッ！
			ENDIF
		ENDIF
	;反射した
	CASE "反射した"
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 悪いが対策済みだ！
		ELSE
			BTL_KOJO_RESULTS:0 = そっくりそのまま返してやろうッ！
		ENDIF
	;回避した
	CASE "回避した"
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = どこを見ているッ！？
		ELSE
			BTL_KOJO_RESULTS:0 = それでは%CSTR:일인칭%に追いつけんぞッ！
		ENDIF
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE "与ダメージ_範囲_ランダム"
		;全弾命中した
		IF GET_CREC_ACT_SUM(ARG, "敵", "MISS/BLOCK/DRAIN/REFLECT") == 0
			BTL_KOJO_RESULTS:0 = よし、このまま制圧する！
		;全弾回避された
		ELSEIF GET_CREC_ACT_SUM(ARG, "敵", "HIT") == 0
			BTL_KOJO_RESULTS:0 = ……儘ならんものだな
		;普通
		ELSE
			BTL_KOJO_RESULTS:0 = 何体か撃ち漏らしたか……次は逃さん！
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE "与ダメージ_範囲_ランダム_撃破あり"
		;ハントスキルで撃破
		IF GROUPMATCH(CFLAG:ARG:입력행동, [[스킬:물고늘어지기]], [[스킬:씹어흩뿌리기]], [[스킬:물어떼기]], [[스킬:폭음폭식]], [[스킬:귀신먹기]], [[스킬:대상제]], [[스킬:최후의만찬]])
			;全員撃破
			IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
				BTL_KOJO_RESULTS:0 = 満足かね、〈ケルベロス〉よ……
			ELSE
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = まだ喰い足りんというのか……
				ELSE
					BTL_KOJO_RESULTS:0 = 『次はアレを喰らいたい』か……
				ENDIF
			ENDIF
		;それ以外
		ELSE
			;全員撃破
			IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
				BTL_KOJO_RESULTS:0 = 掃討、完了……！
			ELSE
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = %CSTR:일인칭%に挑まんとする者は前へ出よッ！
					BTL_KOJO_RESULTS:1 = 全霊を以って相手になってやろう！
				ELSE
					BTL_KOJO_RESULTS:0 = 気骨ある戦士と巡り会えた歓びよ！
				ENDIF
			ENDIF
		ENDIF
	;敵味方全体攻撃(詳細処理無し)
	;CASE "敵味方全体攻撃"
	;	BTL_KOJO_RESULTS:0 = 
	;反撃を発動した
	CASE "反撃発動"
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 甘いッ！！
		ELSE
			BTL_KOJO_RESULTS:0 = やり返されるとは思わなかったかッ！？
		ENDIF
	;トリガースキルを発動した
	CASE "追撃発動"
		SELECTCASE TFLAG:발동연동스킬
			;スキルを指定したい場合、反撃と同様、対象スキルの番号をCASEに記載する
			;CASE (対象スキル番号)
			;	BTL_KOJO_RESULTS:0 = 
			;その他
			CASEELSE
				BTL_KOJO_RESULTS:0 = 
		ENDSELECT
	;バッドステータスを受けた
	CASE "被バステ付着"
		;現在の状態で分岐
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				SIF CFLAG:ARG:악마변신 == 0 && CSTR:ARG:아이콘패턴 == "デフォルト"
					TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_3"
				BTL_KOJO_RESULTS:0 = くッ、この多幸感……せ、せんいをいじでき、な……
			CASE "SHOCK","FREEZE","BIND","PALYZE"
				SIF CFLAG:ARG:악마변신 == 0 && CSTR:ARG:아이콘패턴 == "デフォルト"
					TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_3"
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = ぐッ、ああああぁッ！？
				ELSE
					BTL_KOJO_RESULTS:0 = 身体が、うご、かな……ッ！？
				ENDIF
			CASE "PANIC"
				SIF CFLAG:ARG:악마변신 == 0 && CSTR:ARG:아이콘패턴 == "デフォルト"
					TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_3"
				BTL_KOJO_RESULTS:0 = 精神攻撃だ！　総員けいか、い――？
				BTL_KOJO_RESULTS:1 = み、皆、どこ、へ……？？？
			CASE "SLEEP"
				SIF CFLAG:ARG:악마변신 == 0 && CSTR:ARG:아이콘패턴 == "デフォルト"
					TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_2"
				BTL_KOJO_RESULTS:0 = 催眠攻撃……！　いかん、意識、が――
			CASE "CLOSE"
				IF CFLAG:ARG:악마변신 == 1
					BTL_KOJO_RESULTS:0 = グルルゥ……！？　グガァッ！
					TFLAG:대화형틀없음 = 1
					BTL_KOJO_REACT_RESULTS:0 = ＞%CALLNAME:TARGET%の口からは獣の唸り声しか聞こえない……
				ELSE
					SIF CSTR:ARG:아이콘패턴 == "デフォルト"
						TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_4"
					BTL_KOJO_RESULTS:0 = ――！？　―――！！
					TFLAG:대화형틀없음 = 1
					BTL_KOJO_REACT_RESULTS:0 = ＞%CALLNAME:TARGET%はハンドサインで発話を封じられた事を伝えてきた……
				ENDIF
			CASE "POISON"
				SIF CFLAG:ARG:악마변신 == 0 && CSTR:ARG:아이콘패턴 == "デフォルト"
					TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_4"
				BTL_KOJO_RESULTS:0 = 毒を喰らったか……！
				BTL_KOJO_RESULTS:1 = ぐ、身体パフォーマンスの低下が厄介だな……
			CASE "BOMB"
				SIF CFLAG:ARG:악마변신 == 0 && CSTR:ARG:아이콘패턴 == "デフォルト"
					TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_4"
				BTL_KOJO_RESULTS:0 = ――ッ！　総員、%CSTR:일인칭%から距離を取れ！
				BTL_KOJO_RESULTS:1 = 身体組成を爆薬に変換させられた……！
			CASE "CHARM"
				SIF CFLAG:ARG:악마변신 == 0 && CSTR:ARG:아이콘패턴 == "デフォルト"
					TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_1"
				BTL_KOJO_RESULTS:0 = 目が離せない……腹の奥が熱い……この感覚は、一体……%ハート()%
			CASE "CURSE"
				SIF CFLAG:ARG:악마변신 == 0 && CSTR:ARG:아이콘패턴 == "デフォルト"
					TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_4"
				BTL_KOJO_RESULTS:0 = この程度の呪詛に怯むとでも……！
			;CASE "FLY"
			;CASE "STONE"
			CASE "FLAME"
				SIF CFLAG:ARG:악마변신 == 0 && CSTR:ARG:아이콘패턴 == "デフォルト"
					TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_4"
				BTL_KOJO_RESULTS:0 = 炎とは、こんなにも熱いものだったか……！
			CASE "SLIP"
				SIF CFLAG:ARG:악마변신 == 0 && CSTR:ARG:아이콘패턴 == "デフォルト"
					TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_4"
				BTL_KOJO_RESULTS:0 = いかん、体勢が……！？
			CASE "DYING"
				SIF CFLAG:ARG:악마변신 == 0 && CSTR:ARG:아이콘패턴 == "デフォルト"
					TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_0"
				BTL_KOJO_RESULTS:0 = こんな……あっけ、なく――！？
			CASE "BRAND"
				SIF CFLAG:ARG:악마변신 == 0 && CSTR:ARG:아이콘패턴 == "デフォルト"
					TSTR:전투구상캐릭터화상어드레스 '= "ルーパ_FACE_EX_4"
				BTL_KOJO_RESULTS:0 = 支配の証か、全く忌々しいな……！
			;その他の状態
			CASEELSE
				;DYING状態ではないがDYINGを受け、その行動で食いしばりが発動した。つまり即死を食いしばりした場合
