;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	WSTR:(K++) = 「……여기는.」
	WSTR:(K++) = %CALLNAME:MASTER%에 의해 들어가게 된 조교실에서 모든 일을 헤아린 %CALLNAME:TARGET%는 한 번 깊게 명목한다.
	WSTR:(K++) = 「당신의 생업은 알고 있었습니다」
	WSTR:(K++) = 악마를 사역하며 적대하는 자를 죽이고 여성을 조교하여 팔아넘긴다. 그것은 법과 질서를 선으로 여기는 자에게는 꺼림칙한 사악함이다.
	WSTR:(K++) = 「그만두라고 말한다고 해서 멈추실 분이 아니라는 건 알고 있습니다.」
	WSTR:(K++) = 「하지만 그래도, 그렇게 말씀하신다면, 신의 분노와 함께 사후의 평안을 잃는다는 것은 각오하세요.」
	KSTR:(K++) = 늠름한 %CALLNAME:TARGET%의 시선을 마주보면서 %CALLNAME:MASTER%는 히죽하고 웃었다.
	WSTR:(K++) = 신의 분노를 두려워했다면 이런 일은 하지도 않았을 것이다.
	WSTR:(K++) = 「……그렇습니까.」
	KSTR:(K++) = 문답은 여기까지. 지금부터는 인간의 시간이다.
	KSTR:(K++) = %CALLNAME:TARGET%를 침대에 밀어 넘어뜨리면서 %CALLNAME:MASTER%는 욕망으로 가득찬 미소를 지었다.
	CFLAG:201 = 1
	GOTO 表示
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	WSTR:(K++) = 「언제까지…이런 일을 하실 겁니까?」
	WSTR:(K++) = 적어도 %CALLNAME:TARGET%의 신체가 함락될 때까지일까. 그 말에 %CALLNAME:TARGET%는 작게 머리를 흔든다.
	WSTR:(K++) = 「아닙니다. 이런 일이 언제까지나 계속되는 것은 아닙니다. 언젠가 당신은 자신보다 강한 자에게 패하여 모든 것을 잃습니다.」
	KSTR:(K++) = 그렇게 말하는 %CALLNAME:TARGET%에 %CALLNAME:MASTER%는 웃어 보였다.
	KSTR:(K++) = 그런 당연한 것을 새삼스럽게 말할 필요도 없다. 어차피 자신과 같은 말단이 원하는 것을 얻고 편안히 숨을 거둔다는 것은 불가능하다.
	WSTR:(K++) = 그러니까 언젠가 죽임을 당하는 그날까지 얻을 수 있는 것은 얻는다. 우선 %CALLNAME:TARGET%를 원한다.
	WSTR:(K++) = 「아」
	KSTR:(K++) = %CALLNAME:TARGET%를 밀어 넘어뜨리고 그 위에 걸치자 %CALLNAME:TARGET%는 살짝 눈동자를 흔들며 고개를 돌렸다.
	CFLAG:201 = 2
	GOTO 表示
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	WSTR:(K++) = 「저는 어렸을 때 아버지에게 악마를 심어졌습니다.」
	KSTR:(K++) = 언제나처럼 %CALLNAME:TARGET%의 옷에 손을 대자 꺼낸 말이였다.
	KSTR:(K++) = 고개를 갸웃거리면서 다음을 기다리다가도 망설이는 듯 눈동자가 맴돌고 있다.
	KSTR:(K++) = 무슨 말을 하고 싶은지 모르겠지만 일단 이 옷, 벗기기가 힘들다.
	WSTR:(K++) = %CALLNAME:TARGET%를 어린 아이처럼 만세시키고 발 밑에서부터 빼내자 속옷으로 가려진 나체가 드러났다.
	WSTR:(K++) = 「……그런 저를 아버지는 신에 대한 첨병으로 삼기 위해 이용했고 레미엘은 그것을 막기 위해 나에게 힘을 빌려주었습니다.」
	KSTR:(K++) = 그렇군. 잘 알았다. 적당히 고개를 끄덕이면서 %CALLNAME:TARGET%를 침대에 눕힌다.
	WSTR:(K++) = 브래지어에 손을 대자 작은 몸집에 어울리지 않는 거유가 부르르 떨리며 튀어나온다.
	WSTR:(K++) = 「당신은 어째서……」
	CFLAG:201 = 3
	GOTO 表示
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	KSTR:(K++) = 자, 오늘은 무엇을 해볼까.
	WSTR:(K++) = 한 발 앞서 벌거벗은 채 조교 전의 설렘으로 가슴을 뛰다 보면,
	WSTR:(K++) = 「당신은 왜 저를 원하시는 겁니까?」
	WSTR:(K++) = %CALLNAME:MASTER%가 벗어던진 옷을 정성스럽게 접고 있던 %CALLNAME:TARGET%가 물어왔다.
	WSTR:(K++) = 「……이미 이 몸에서 악마는 사라졌습니다. 천사도 이런 부정한 행동에 힘을 보태지는 않을 것입니다.」
	WSTR:(K++) = 「저를 가진다고 해서 당신이 원하는 것을 얻을 수 없습니다. 이용 가치도 없는 여자를 왜…」
	KSTR:(K++) = 무의식적으로 접고있던 %CALLNAME:MASTER%의 옷을 움켜쥔 %CALLNAME:TARGET%가 똑바로 바라보고 있다.
	WSTR:(K++) = 무슨 대답을 원하는지는 모르겠지만, 대답하자면 %CALLNAME:TARGET%가 좋은 여자이기 때문이다.
	WSTR:(K++) = 「……에」
	KSTR:(K++) = 미소녀인것은 틀림없다.
	KSTR:(K++) = 키는 비교적 작은 것에 비해 거유다. 그러면서 허리는 가늘고 부러질 정도이지만 여기저기가 부드럽고 안는 느낌이 좋다.
	WSTR:(K++) = 얌전하고 청초하며 배려심도 있어서 남자를 도와줄 것 같은 것에서 포인트가 높고 게다가 마음에 심지가 있어서 취향이다.
	KSTR:(K++) = 대체로 말하자면 내 것으로 만들 보람이 있는 여자이기 때문이다.
	KSTR:(K++) = 힘이 필요하면 중마를 늘리거나 악마 합체를 하면 된다. …그런 것은 아무래도 좋고, 자신이 원하는 것은 쿠즈류 아마네다.
	WSTR:(K++) = 그 몸도, 그 마음도, 쿠즈류 아마네의 모든 것을 내 것으로 만든다. 원하는 것이라면 그것뿐이다.
	WSTR:(K++) = 「…………」
	KSTR:(K++) = 그렇게 말해주자 %CALLNAME:TARGET%는 드물게 멍한 표정을 짓고 있었다.
	KSTR:(K++) = 새삼스럽게 뭘 그렇게 생각하는지 모르겠지만, 뭐 좋다. 이 소녀를 여자로 하기 위한 조교를 시작하자.
	CFLAG:201 = 4
	GOTO 表示
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		IF CFLAG:미조교함락 == 1
			;조교하지 않고 연모를 단 경우
			;WSTR:(K++) = 
		ELSE
			WSTR:(K++) = 여느 때처럼 조교방으로 데려가 벗기기 위해 옷에 손을 얹으려 했던 차에 %CALLNAME:TARGET%와 손이 겹쳤다.
			WSTR:(K++) = 「잠깐만, 저의 말을 들어주시겠습니까？」
			KSTR:(K++) = 그대로 손을 떼고 침대에 앉는다. 옆에 똑같이 앉은 %CALLNAME:TARGET%의 손은 아직 이쪽 손에 겹친 채로 있다.
			WSTR:(K++) = %CALLNAME:TARGET%는 잠시 그대로 고개를 숙이고 시선을 방황하게 하다가 이윽고 겹친 손에 손가락을 감고 고개를 들었다.
			WSTR:(K++) = 「저를 당신의 것으로 만들어 주세요.」
			WSTR:(K++) = 그것은 틀림없는 고백이었다.
			WSTR:(K++) = 「당신은 신도 악마도… 저의 힘도 상관없이 단순히 쿠즈류 아마네라는 소녀를 원한다고 말해주었습니다.」
			WSTR:(K++) = 「……단순한 철부지 계집애가 누군가에게 특별하다는 말을 듣고 착각하여 들뜬 것일지도 모릅니다.」
			WSTR:(K++) = 꽉 움켜쥔 %CALLNAME:MASTER%의 손을 가슴팍에 끌어안는다.
			WSTR:(K++) = 「그래도 좋아요. 지금 품고 있는 이 마음은 거짓이 아니니까요.」
			WSTR:(K++) = 「사랑합니다 %CALLNAME:MASTER%.」
			KSTR:(K++) = 뺨을 연분홍색으로 물들이고 미소짓는 %CALLNAME:TARGET%에 왠지 기가 죽는다. 그것이 화가 나지만…….
			WSTR:(K++) = 옷 위에서도 분명하게 알 수 있을 정도의 부드러움 속에서 느껴지는 이 고동이 자신을 위한 것이라면.
			WSTR:(K++) = 「아……!」
			WSTR:(K++) = 그렇다면 앞으로는 하고 싶은 대로 하도록 하지.
			WSTR:(K++) = 「……네. 부디, 당신이 하고 싶은 대로. %CALLNAME:TARGET%는 이제 당신의 것이니까요.」
			KSTR:(K++) = %CALLNAME:TARGET%의 가는 허리를 껴안아 주자 %CALLNAME:TARGET%는 %CALLNAME:MASTER%의 가슴에 얼굴을 묻고 작은 눈물을 흘렸다.
		ENDIF
	;음란
	ELSEIF TALENT:4
		;WSTR:(K++) = 
	;복종
	ELSEIF TALENT:5
		;WSTR:(K++) = 
	ENDIF
	;공통
	IF !구상유무확인(0)
		KSTR:(K++) = 
	ENDIF
	CFLAG:201 = 5
	GOTO 表示
ENDIF

