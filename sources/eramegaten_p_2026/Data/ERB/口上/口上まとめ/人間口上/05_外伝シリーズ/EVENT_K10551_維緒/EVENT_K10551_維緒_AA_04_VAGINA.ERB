;-------------------------------------------------
;〇V系_V指入れ_ハブ
;-------------------------------------------------
@AA_K[[キャラ:이오]]_V系_V指入れ_ハブ
	;屈服状況で表示を変更する
	IF 0
	ELSEIF 陥落()
		CALL AA_K[[キャラ:이오]]_V系_V指入れ２
	;未陥落
	ELSE
		CALL AA_K[[キャラ:이오]]_V系_V指入れ１
	ENDIF


;-------------------------------------------------
;〇V系_セックス待機_ハブ
;-------------------------------------------------
@AA_K[[キャラ:이오]]_V系_セックス待機_ハブ
	;体位によって表示可否がある
	;また、陥落していなければ後背位待機以外は出ない

	;おまじない：セックス系コマンドを選んだとき、かつ「挿入継続」でないとき限定
	;（今からセックスするぞ！って時限定だよ）
	IF GROUPMATCH(SELECTCOM , 60 , 61 , 66 , 68 , 69 , 72, 504, 506, 507) && TEQUIP:Ｖ섹스 == 3
		IF 0
			;体位限定パターンとRANDがあるよ
		;騎乗位の場合
		ELSEIF 陥落() && SELECTCOM == 66
			CALL AA_K[[キャラ:이오]]_V系_セックス_ハブ
		;正常位の場合
		ELSEIF 陥落() && SELECTCOM == 60
			CALL AA_K[[キャラ:이오]]_V系_正常位待機
		;後背位、または背面座位の場合
		;背中を向けてるので陥落してなくても出る
		ELSEIF RAND:2 == 0 && (SELECTCOM == 61 || SELECTCOM == 69)
			CALL AA_K[[キャラ:이오]]_V系_後背位待機
		ELSEIF 陥落()
			CALL AA_K[[キャラ:이오]]_V系_セックス待機
		ELSE
			CALL AA_K[[キャラ:이오]]_V系_セックス_ハブ
		ENDIF
	ENDIF

;-------------------------------------------------
;〇V系_セックス_ハブ
;-------------------------------------------------
@AA_K[[キャラ:이오]]_V系_セックス_ハブ
	;陥落状態、体位によって表示を変更

	;おまじない：セックス系コマンドを選んだとき限定
	IF GROUPMATCH(SELECTCOM , 60 , 61 , 66 , 68 , 69 , 72, 504, 506, 507)
		IF 0
			;体位限定パターンと陥落分岐とRANDがあるよ
		;子宮口責めの場合
		ELSEIF SELECTCOM == 507 && RAND:2 == 0
			IF 0
			ELSEIF  RAND:2 == 0
				CALL AA_K[[キャラ:이오]]_V系_子宮口攻め２
			ELSE
				CALL AA_K[[キャラ:이오]]_V系_子宮口攻め１
			ENDIF
		;正常位の場合
		ELSEIF SELECTCOM == 60 || (GROUPMATCH(SELECTCOM , 506, 507) && PREVCOM == 60)
			IF 0
			ELSEIF 陥落()
				IF RAND:3 == 0
					CALL AA_K[[キャラ:이오]]_V系_正常位５
				ELSEIF RAND:2 == 0
					CALL AA_K[[キャラ:이오]]_V系_正常位４
				ELSE
					CALL AA_K[[キャラ:이오]]_V系_正常位３
				ENDIF
			;屈服３
			ELSEIF MARK:굴복각인 == 3
				CALL AA_K[[キャラ:이오]]_V系_正常位２
			;屈服３未満
			ELSE
				CALL AA_K[[キャラ:이오]]_V系_正常位１
			ENDIF
		;後背位の場合
		ELSEIF SELECTCOM == 61 || (GROUPMATCH(SELECTCOM , 506, 507) && PREVCOM == 61)
			IF 0
			ELSEIF 陥落()
				IF RAND:3 == 0
					CALL AA_K[[キャラ:이오]]_V系_後背位４
				ELSEIF RAND:2 == 0
					CALL AA_K[[キャラ:이오]]_V系_後背位３
				ELSE
					CALL AA_K[[キャラ:이오]]_V系_後背位２
				ENDIF
			;屈服３
			ELSEIF MARK:굴복각인 == 3
				CALL AA_K[[キャラ:이오]]_V系_後背位２
			;屈服３未満
			ELSE
				CALL AA_K[[キャラ:이오]]_V系_後背位１
			ENDIF
		;騎乗位の場合
		ELSEIF SELECTCOM == 66 || (GROUPMATCH(SELECTCOM , 506, 507) && PREVCOM == 66)
			IF 0
			ELSEIF 陥落()
				IF RAND:4 == 0
					CALL AA_K[[キャラ:이오]]_V系_騎乗位５
				ELSEIF RAND:3 == 0
					CALL AA_K[[キャラ:이오]]_V系_騎乗位１
				ELSEIF RAND:2 == 0
					CALL AA_K[[キャラ:이오]]_V系_騎乗位２
				ELSE
					CALL AA_K[[キャラ:이오]]_V系_騎乗位３
				ENDIF
			;屈服３未満
			ELSE
				CALL AA_K[[キャラ:이오]]_V系_騎乗位４
			ENDIF
		;対面座位の場合
		ELSEIF SELECTCOM == 68 || (GROUPMATCH(SELECTCOM , 506, 507) && PREVCOM == 68)
			IF 0
			ELSEIF 陥落()
				IF 0
				ELSEIF RAND:5 == 0
					CALL AA_K[[キャラ:이오]]_V系_対面座位１
				ELSEIF RAND:4 == 0
					CALL AA_K[[キャラ:이오]]_V系_対面座位２
				ELSEIF RAND:3 == 0
					CALL AA_K[[キャラ:이오]]_V系_対面座位３
				ELSEIF RAND:2 == 0
					CALL AA_K[[キャラ:이오]]_V系_対面座位４
				ELSE
					CALL AA_K[[キャラ:이오]]_V系_対面座位５
				ENDIF
			;屈服３未満
			ELSE
				CALL AA_K[[キャラ:이오]]_V系_対面座位３
			ENDIF
		;背面座位（または乱れ牡丹）の場合
		ELSEIF SELECTCOM == 69 || (GROUPMATCH(SELECTCOM , 506, 507) && PREVCOM == 69) || SELECTCOM == 504 || (GROUPMATCH(SELECTCOM , 506, 507) && PREVCOM == 504)
			IF 0
			ELSEIF 陥落()
				IF 0
				ELSEIF RAND:3 == 0
					CALL AA_K[[キャラ:이오]]_V系_背面座位３
				ELSEIF RAND:2 == 0
					CALL AA_K[[キャラ:이오]]_V系_背面座位２
				ELSE
					CALL AA_K[[キャラ:이오]]_V系_背面座位１
				ENDIF
			;屈服３未満
			ELSE
				CALL AA_K[[キャラ:이오]]_V系_背面座位２
			ENDIF
		;その他の場合
		;まあなんか出しとけ！！！　Gスポとかこのへんくる気がする
		ELSE
			IF 0
			ELSEIF RAND:27 == 0
				CALL AA_K[[キャラ:이오]]_V系_寝バック
			;ELSEIF RAND:26 == 0
			;	CALL AA_K[[キャラ:이오]]_V系_ラブラブ素股
			ELSEIF RAND:25 == 0
				CALL AA_K[[キャラ:이오]]_V系_正常位１
			ELSEIF RAND:24 == 0
				CALL AA_K[[キャラ:이오]]_V系_正常位２
			ELSEIF RAND:23 == 0
				CALL AA_K[[キャラ:이오]]_V系_正常位３
			ELSEIF RAND:22 == 0
				CALL AA_K[[キャラ:이오]]_V系_正常位４
			ELSEIF RAND:21 == 0
				CALL AA_K[[キャラ:이오]]_V系_正常位５
			ELSEIF RAND:20 == 0
				CALL AA_K[[キャラ:이오]]_V系_後背位１
			ELSEIF RAND:19 == 0
				CALL AA_K[[キャラ:이오]]_V系_後背位２
			ELSEIF RAND:18 == 0
				CALL AA_K[[キャラ:이오]]_V系_後背位３
			ELSEIF RAND:17 == 0
				CALL AA_K[[キャラ:이오]]_V系_後背位４
			ELSEIF RAND:16 == 0
				CALL AA_K[[キャラ:이오]]_V系_騎乗位１
			ELSEIF RAND:15 == 0
				CALL AA_K[[キャラ:이오]]_V系_騎乗位２
			ELSEIF RAND:14 == 0
				CALL AA_K[[キャラ:이오]]_V系_騎乗位３
			ELSEIF RAND:13 == 0
				CALL AA_K[[キャラ:이오]]_V系_騎乗位４
			ELSEIF RAND:12 == 0
				CALL AA_K[[キャラ:이오]]_V系_騎乗位５
			ELSEIF RAND:11 == 0
				CALL AA_K[[キャラ:이오]]_V系_対面座位１
			ELSEIF RAND:10 == 0
				CALL AA_K[[キャラ:이오]]_V系_対面座位２
			ELSEIF RAND:9 == 0
				CALL AA_K[[キャラ:이오]]_V系_対面座位３
			ELSEIF RAND:8 == 0
				CALL AA_K[[キャラ:이오]]_V系_対面座位４
			ELSEIF RAND:7 == 0
				CALL AA_K[[キャラ:이오]]_V系_対面座位５
			ELSEIF RAND:6 == 0
				CALL AA_K[[キャラ:이오]]_V系_背面座位１
			ELSEIF RAND:5 == 0
				CALL AA_K[[キャラ:이오]]_V系_背面座位２
			ELSEIF RAND:4 == 0
				CALL AA_K[[キャラ:이오]]_V系_背面座位３
			ELSEIF RAND:3 == 0
				CALL AA_K[[キャラ:이오]]_V系_子宮口攻め１
			ELSEIF RAND:2 == 0
				CALL AA_K[[キャラ:이오]]_V系_子宮口攻め２
			ENDIF
		ENDIF
	ENDIF


