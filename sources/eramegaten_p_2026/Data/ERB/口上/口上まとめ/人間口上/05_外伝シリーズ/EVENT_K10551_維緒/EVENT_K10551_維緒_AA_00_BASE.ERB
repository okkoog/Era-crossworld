;-------------------------------------------------
;メモ
;-------------------------------------------------
;・AAのつかいかた
;	GETFONT							←変数RESULTSに現在のフォントを保存
;	CHKFONT "ＭＳ Ｐゴシック"		←指定したフォントがインストールされているかを確認
;	SIF RESULT						←RESULTが１なら（＝指定したフォント「MSPゴシック」がインストールされているなら）
;		SETFONT "ＭＳ Ｐゴシック"	←フォント「MSPゴシック」に変更する
;
;	;ここにAAをPRINTL 
;	;（なお、PRINTL、にしておかないと「半角％が一個だけある場合」とかにバグるはず。ご注意）
;
;	;フォントをもとに戻す
;	SETFONT RESULTS					←保存しておいたフォントに使用フォントを戻す
;
;-------------------------------------------------
;んまぁ難しいこと考えずこんな感じでやればオッケーのハズ
;関数にしてるので、この場合、「RESULTS」を途中でいじったらマズいことだけ覚えておいてください（フォントが元に戻らなくなる）
;AAの表示だけやりましょう
;AAの横にセリフつけるのは、eratenの横幅的にチョイビミョーだと思います
;-------------------------------------------------


;-------------------------------------------------
;〇AA呼び出し前の処理
;-------------------------------------------------
@AA_K[[キャラ:이오]]_BEFORE
	;おまじない：AA呼び出しが許可されていないなら戻る
	;（フォントを勝手に変更しちゃわないように）（まあここまで来ないはずだけど……）
	SIF CFLAG:810 == 0
		RETURN 0
	GETFONT
	; 한국어/일본어 윈도우 환경 및 AA 전용 가변폭 폰트 자동 감지
	CHKFONT "MS PGothic"
	IF RESULT
		SETFONT "MS PGothic"
	ELSE
		CHKFONT "ＭＳ Ｐゴシック"
		IF RESULT
			SETFONT "ＭＳ Ｐゴシック"
		ELSE
			CHKFONT "Saitamaar"
			IF RESULT
				SETFONT "Saitamaar"
			ELSE
				CHKFONT "IPAMonaPGothic"
				SIF RESULT
					SETFONT "IPAMonaPGothic"
			ENDIF
		ENDIF
	ENDIF
	;AAと本文の間に一行スペースを入れる
	PRINTL 　


;-------------------------------------------------
;〇AA呼び出し後の処理
;-------------------------------------------------
@AA_K[[キャラ:이오]]_AFTER
	;AAと本文の間に一行スペースを入れる
	PRINTL 　
	;フォントをもとに戻す
	SETFONT


