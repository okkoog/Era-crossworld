;-------------------------------------------------
;〇裸体_ハブ
;-------------------------------------------------
@AA_K[[キャラ:이오]]_裸体_ハブ
	;屈服状況で表示を変更する
	IF 0
	ELSEIF 陥落()
		IF RAND:2 == 0
			CALL AA_K[[キャラ:이오]]_裸体_発情
		ELSE
			CALL AA_K[[キャラ:이오]]_裸体_雌牛
		ENDIF
	;屈服３
	ELSEIF MARK:굴복각인 == 3
		CALL AA_K[[キャラ:이오]]_裸体_屈服
	;屈服３未満
	ELSE
		CALL AA_K[[キャラ:이오]]_裸体_ひん剥かれた
	ENDIF


