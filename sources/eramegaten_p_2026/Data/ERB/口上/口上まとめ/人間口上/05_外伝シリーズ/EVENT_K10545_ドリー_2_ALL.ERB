;-------------------------------------------------
;調教者の射精時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;射精箇所変更時のテキスト　有効時はここで関数終了
;-------------------------------------------------
IF CFLAG:106
	CALL PALAM_MESSAGE_A
	;머리카락
	IF CFLAG:106 == 1
		IF RAND:3 == 0
			PRINTFORML 
		ELSEIF RAND:2 == 0
			PRINTFORML 
		ELSE
			PRINTFORML 
		ENDIF
		CFLAG:221 = 1
	;顔
	ELSEIF CFLAG:106 == 2
		IF RAND:3 == 0
			PRINTFORML 
		ELSEIF RAND:2 == 0
			PRINTFORML 
		ELSE
			PRINTFORML 
		ENDIF
		CFLAG:222 = 1
	;가슴
	ELSEIF CFLAG:106 == 3
		PRINTFORMW 
		CFLAG:223 = 1
	;腹
	ELSEIF CFLAG:106 == 4
		IF RAND:3 == 0
			PRINTFORML 
		ELSEIF RAND:2 == 0
			PRINTFORML 
		ELSE
			PRINTFORML 
		ENDIF
		CFLAG:224 = 1
	;腋
	ELSEIF CFLAG:106 == 5
		PRINTFORMW 
		CFLAG:225 = 1
	;太腿
	ELSEIF CFLAG:106 == 6
		PRINTFORMW 
		CFLAG:226 = 1
	;割れ目
	ELSEIF CFLAG:106 == 7
		PRINTFORML 
		CFLAG:227 = 1
	;尻
	ELSEIF CFLAG:106 == 8
		PRINTFORML 
		CFLAG:228 = 1
	;ゴム
	ELSEIF CFLAG:106 == 9
		;セックスで射精かつ、アナルセックス以外を実行時
		IF GROUPMATCH(SELECTCOM , 60 , 61 , 66 , 68 , 69 , 72)
			PRINTFORML 
			CFLAG:229 = 1
		ELSE
			PRINTFORML 
			CFLAG:230 = 1
		ENDIF
	ENDIF
	RETURN 0
ENDIF

