;戦闘口上の雛形。[キャラナンバー]と[キャラ名]を置換して使用。　一応ライセンスフリー。
;京都じゃない方の双葉はんから拝借した純那ちゃん（kame先生作）から更に拝借して雛形を作ったものから
;摩多羅神ヘッドセット口上を作る過程で欲しい物を入れて……悪魔はヘッドセットを持てなかった（白目）ため原形に戻したもの。
;じゅんなちゃんのエーギルをもらうよ。ん？　そうすればいっぱいヘッドセット口上作れるからね。 Schrott
;=========================================
@KOJO_BATTLE_NAVI_K[[キャラ:도리]]_2, ARG
#DIM NEXT_PLAY
#DIM NOW_PLAY
#DIM STOCK_TURN
;プレイ内容
;１：ディルドースクワット
;２：掃除機バキュームフェラ
;３：なわとび
;４：産卵プレイ
;５
;６
;７
;８
;９：アナルペットボトルスクワット
IF FLAG:경과턴수 == 0
	NOW_PLAY = 0
	NEXT_PLAY = -1
	STOCK_TURN = 0
ENDIF
;メイン画面の表示に戻るたびにカウントが進んでしまうので工作を入れる
;ターンが経過していて次のプレイが指定されていたら代入する
IF STOCK_TURN != FLAG:경과턴수 && NEXT_PLAY >= 0
	NOW_PLAY = NEXT_PLAY
	NEXT_PLAY = -1
ENDIF
IF TSTR:네비_시추에이션_메인 == "메인 화면"
	IF FLAG:경과턴수 >= 6
		IF RAND:4 == 0
			;実況開始！
			IF NOW_PLAY == 0
				BTL_KOJO_RESULTS:0 = 히호-♪
				BTL_KOJO_RESULTS:1 = %CALLNAME%의 자위 시간 개막이다 호
				NEXT_PLAY = 1
				STOCK_TURN = FLAG:경과턴수
			;ディルドースクワット
			ELSEIF NOW_PLAY == 1 && HAVE_VAGINA() && RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 히호-♪
				BTL_KOJO_RESULTS:1 = 자기 팔뚝만 한 딜도를 들고 와서 뭐 하려는 거냐 호
				NEXT_PLAY = 11
				STOCK_TURN = FLAG:경과턴수
			ELSEIF NOW_PLAY == 11
				BTL_KOJO_RESULTS:0 = 히호?
				BTL_KOJO_RESULTS:1 = 딜도를 바닥에 세워두고…… 그 위에서 스쿼트하는 거냐 호?
				NEXT_PLAY = 21
				STOCK_TURN = FLAG:경과턴수
			ELSEIF NOW_PLAY == 21
				SETCOLOR 0XFF82D2
				BTL_KOJO_RESULTS:0 = 아아앗♪%ハート()%
				BTL_KOJO_RESULTS:1 = 스쿼트 자위♪ 좋아앗♪
				NEXT_PLAY = 31
				STOCK_TURN = FLAG:경과턴수
			ELSEIF NOW_PLAY == 31
				BTL_KOJO_RESULTS:0 = %CALLNAME% 대단하다 호
				BTL_KOJO_RESULTS:1 = 바닥이 땀으로 흥건하다 호
				NEXT_PLAY = 41
				STOCK_TURN = FLAG:경과턴수
