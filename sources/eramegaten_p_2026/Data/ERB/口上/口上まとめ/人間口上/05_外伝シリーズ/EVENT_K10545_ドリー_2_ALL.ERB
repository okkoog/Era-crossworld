;-------------------------------------------------
;調教開始時（2回目以降、X1をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_K[[キャラ:도리]]_2
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
	IF RAND:3 == 0
		SETCOLOR 0XB9EAFF
		PRINTFORML 『히호. 얕보지 마라 호』
		RESETCOLOR
		PRINTFORML 「안 돼, 프로스트 군. 대뜸 시비부터 걸면 어떡해」
		PRINTFORMW %CALLNAME%은 1인극을 펼치고 있다…
	ELSEIF RAND:2 == 0
		PRINTFORML 「응…」
		PRINTFORML 「이 사람은 상사니까 죽이면 안 되는 거야, 프로스트 군」
		PRINTFORMW %CALLNAME%은 텅 빈 공간을 향해 설교를 하고 있다…
	ELSE
		PRINTFORML 　
		PRINTFORML 붕-
		PRINTFORML 　
		PRINTFORMW 난데없이 시계가 날아왔다
		PRINTFORML 　
		PRINTFORML 「안 돼, 프로스트 군」
		PRINTFORML 「느닷없이 부흐 같은 걸 날리면 어떡해」
		PRINTFORMW %CALLNAME%은 텅 빈 공간을 향해 설교를 하고 있다…
	ENDIF
;屈服刻印Lv3
ELSEIF MARK:2 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
	IF RAND:4 == 0
		PRINTFORMW 「%CSTR:이인칭%, 왔구나」
		PRINTFORML 「프로스트 군이랑 하고 있었는데, 같이 낄래?」
		IF EXIST_ITEM(4)
			;バイブを持っている場合、自分で挿れてる
			CFLAG:LOCAL:속옷（하） = 0
			PRINTFORMW %CALLNAME%은 구멍에 딜도를 꽂은 채 엎드려 엉덩이를 치켜들고 있다
			PRINTFORML 　
			PRINTFORMW 「자, 뒤쪽 구멍 비어있다구%ハート()%」
			TEQUIP:13 = 1
		ELSE
			;バイブを持っていない場合、指で我慢
			PRINTFORMW %CALLNAME%은 다리를 활짝 벌려 애액 범벅으로 준비 완료된 두 구멍을 드러내 보였다
		ENDIF
	ELSEIF RAND:3 == 0
		SETCOLOR 0XB9EAFF
		PRINTFORML 『히호. 인간이 왔다 호』
		PRINTFORML 『파티 타임이다 호』
		RESETCOLOR
		PRINTFORML 　
		PRINTFORMW 「그러네, %CSTR:이인칭%도 왔으니 시작해볼까♪」
	ELSEIF RAND:2 == 0
		PRINTFORML 「아앗%ハート()%」
		PRINTFORML 「프로스트 군의 자지, 차가워서 기분 좋아♪」
		PRINTFORMW %CALLNAME%은 아이스바를 양쪽 구멍에 꽂은 채 자위를 하던 중이었다
		PRINTFORML ………
		PRINTFORML ……
		PRINTFORML …
		PRINTFORMW 「후우… 프로스트 군, 아직 더 할 수 있구나♪」
		PRINTFORML 「그럼, 자지 깨끗하게 핥아줄게♪」
		PRINTFORMW %CALLNAME%은 양손에 든 아이스바를 요염하게 핥고 있다…
	ELSE
		PRINTFORML 「전송…… 완료♪」
		PRINTFORMW 「앗, 마침 답글 달기가 끝난 참이야」
		PRINTFORML 　
		PRINTFORML 「다들 평소엔 『이 멘헤라년』 『프로스트 군이 뭔데 ㅋㅋㅋ』라고 하면서도」
		PRINTFORMW 「프로스트 군이랑 뒹구는 영상 올리면 『여신 강림!』 『더 올려줘』 그런단 말이지」
		PRINTFORMW 「다 같이 업로드용 섹스 비디오나 찍어볼래?」
	ENDIF
ELSE
	IF RAND:3 == 0
		SETCOLOR 0XB9EAFF
		PRINTFORML 『히호. 잘 왔다 호』
		RESETCOLOR
	ELSEIF RAND:2 == 0
		PRINTFORML 「어서 와」
		PRINTFORML 「마음대로 써도 좋으니까…」
		PRINTFORMW %CALLNAME%은 이쪽을 쳐다보지도 않고 만화책을 읽고 있다…
	ELSE
		PRINTFORML 「손님이 왔으니까 오늘은 여기까지야, 프로스트 군」
		PRINTFORMW %CALLNAME%은 자위를 하던 중이었던 모양이다
	ENDIF
ENDIF
CFLAG:202 = 4
RETURN 0

;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
