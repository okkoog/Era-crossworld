;--------------------------------------------------
;調教終了時のセリフ
;--------------------------------------------------
DRAWLINE
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:217 < 1 || FLAG:7 == 2)
	IF RAND:2 == 0
		PRINTFORML 「최악이었네, 프로스트 군」
		PRINTFORMW 「나중에 둘이서만 하자%ハート()%」
	ELSE
		SETCOLOR 0XB9EAFF
		PRINTFORML 『히호. 다음에 만나면 얼음 덩어리로 만들어주마 호』
		PRINTFORML 『각오해 두는 게 좋을 거다 호』
		RESETCOLOR
		PRINTFORMW 무표정한 %CALLNAME%에게 협박당했다
	ENDIF
	CFLAG:217 = 1
;体力500未満
ELSEIF BASE:0 < 500
	IF RAND:3 == 0
		SETCOLOR 0XB9EAFF
		PRINTFORML 『벌써 자는 거냐 호, %CALLNAME%』
		RESETCOLOR
		PRINTFORML 「응, 이제 넉다운이야…」
		PRINTFORMW 침대에 엎드린 채 %CALLNAME%은 고른 숨소리를 내며 잠들어 있다
	ELSEIF RAND:2 == 0
		PRINTFORML 「지쳐서 못 움직이겠어…」
		PRINTFORMW 「프로스트 군, 목욕탕 데려가 줘~」
		PRINTFORML 　
		PRINTFORML 「……그렇지」
		PRINTFORMW 「프로스트 군은 목욕 같은 거 들어가면 녹아버리니까… 미안 미안」
	ELSE
		PRINTFORML 「프로스트 군의 몸, 차가워서 기분 좋아…」
		PRINTFORMW %CALLNAME%은 베개를 끌어안은 채 지쳐 잠들어 버렸다
	ENDIF
	CFLAG:218 = 1
ELSE
	IF RAND:3 == 0
		PRINTFORMW 「프로스트 군도 즐거웠어?」
		PRINTFORMW 「그래, 그럼 다행이네%ハート()%」
	ELSEIF RAND:2 == 0
		SETCOLOR 0XB9EAFF
		PRINTFORML 『히호. 즐거웠다 호』
		PRINTFORMW 『또 놀러 와라 호』
		RESETCOLOR
		PRINTFORML 　
		PRINTFORML 「정말이지… %CSTR:이인칭%랑 함께라서」
		PRINTFORMW 「프로스트 군도 신나서 날뛰었잖아」
		PRINTFORMW 「%CSTR:일인칭%? 즐거웠어♪」
	ELSE
		PRINTFORML 「프로스트 군도 기뻐하고 있으니」
		PRINTFORMW 「다음에도 다 같이 즐겁게 놀자%ハート()%」
	ENDIF
	CFLAG:219 = 3
ENDIF
RETURN 0

