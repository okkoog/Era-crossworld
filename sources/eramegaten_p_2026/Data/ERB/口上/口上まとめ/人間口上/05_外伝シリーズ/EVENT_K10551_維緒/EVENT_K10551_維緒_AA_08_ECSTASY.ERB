;-------------------------------------------------
;〇V系_射精_ハブ
;-------------------------------------------------
@AA_K[[キャラ:이오]]_V系_射精_ハブ
	;Vセックス後、射精のタイミングで表示するやつそのいち
	IF 0
	ELSEIF RAND:4 == 0
		CALL AA_K[[キャラ:이오]]_V系_射精４
	ELSEIF RAND:3 == 0
		CALL AA_K[[キャラ:이오]]_V系_射精３
	ELSEIF RAND:2 == 0
		CALL AA_K[[キャラ:이오]]_V系_射精２
	ELSE
		CALL AA_K[[キャラ:이오]]_V系_射精１
	ENDIF


;-------------------------------------------------
;〇V系_事後_ハブ
;-------------------------------------------------
@AA_K[[キャラ:이오]]_V系_事後_ハブ
	;Vセックス後、射精のタイミングで表示するやつそのに
	IF 0
	ELSEIF RAND:4 == 0 && 陥落() > 0
		CALL AA_K[[キャラ:이오]]_V系_事後４
	ELSEIF RAND:3 == 0
		CALL AA_K[[キャラ:이오]]_V系_事後３
	ELSEIF RAND:2 == 0
		CALL AA_K[[キャラ:이오]]_V系_事後２
	ELSE
		CALL AA_K[[キャラ:이오]]_V系_事後１
	ENDIF




;-------------------------------------------------
;〇絶頂_ハブ
;-------------------------------------------------
@AA_K[[キャラ:이오]]_絶頂_ハブ
	;各種絶頂を見る

	;メモ：NOWEX書式
	;NOWEX:（部位） == （強度）
	;絶頂部位は、0＝C、１＝V、２＝A、３＝B。
	;強度は、１＝絶頂、２＝強絶頂、３＝超強、４＝発狂、５＝最強。

	;おまじない：どっか絶頂してることを確認
	IF (NOWEX:0 != 0) + (NOWEX:1 != 0) + (NOWEX:2 != 0) + (NOWEX:3 != 0)
		IF 0
		;Vはセックス系限定
		ELSEIF NOWEX:1 != 0 && GROUPMATCH(SELECTCOM , 60 , 61 , 66 , 68 , 69 , 72, 504, 506, 507)
			IF RAND:2 == 0
				CALL AA_K[[キャラ:이오]]_絶頂_V絶頂２
			ELSE
				CALL AA_K[[キャラ:이오]]_絶頂_V絶頂１
			ENDIF
		ELSEIF NOWEX:0 != 0 && RAND:2 == 0
			CALL AA_K[[キャラ:이오]]_絶頂_C絶頂１
		;B
		ELSEIF NOWEX:3 != 0
			IF 0
			ELSEIF RAND:4 == 0
				CALL AA_K[[キャラ:이오]]_絶頂_B絶頂４
			ELSEIF RAND:3 == 0
				CALL AA_K[[キャラ:이오]]_絶頂_B絶頂３
			ELSEIF RAND:2 == 0
				CALL AA_K[[キャラ:이오]]_絶頂_B絶頂２
			ELSE
				CALL AA_K[[キャラ:이오]]_絶頂_B絶頂１
			ENDIF

		ELSE
			;イっててもなんも出ないこともある
		ENDIF
	ENDIF


