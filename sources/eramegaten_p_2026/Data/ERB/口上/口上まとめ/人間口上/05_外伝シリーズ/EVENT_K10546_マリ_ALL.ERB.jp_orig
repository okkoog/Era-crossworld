;-------------------------------------------------
;146,관장기＋플러그
;-------------------------------------------------
	CASE 146
		IF TEQUIP:관장기＋플러그
			CALL TRAIN_MESSAGE
			;初めて
			IF CFLAG:375 == 0
				PRINTFORML 浣腸器を見せ付けると、%CALLNAME%はさっと顔を青ざめさせた
				PRINTFORMW 「なっ！？　お、お通じは大丈夫ですっ、そんなのいりませんっ！」
				PRINTFORMW 「や、やめっ、あうっ、入ってくるぅ……」
				CFLAG:375 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF 陥落() && (CFLAG:375 < 4 || FLAG:7 == 2)
					;淫乱、娼婦、淫乱スイッチＯＮ
					IF 음란() || CFLAG:800 == 1
						;マゾッ気Lv3以上
						IF ABL:마조끼 >= 3
							PRINTFORML すぼまった%CALLNAME%のアナルに浣腸器を差し込み、薬液をゆっくりと注入する
							PRINTFORML 「あはぁ……お浣腸、入ってくるぅ%ハート()%」
							PRINTFORMW たっぷりとグリセリンを注がれた%CALLNAME%の腹は妊婦のように膨れ上がっている
							PRINTFORML その曲線を撫でると、%CALLNAME%は冷たい汗を浮かべて尻穴をひくつかせた
							PRINTFORMW 「さ、触っちゃだめぇ……%ハート()%　お腹の中、グルグル言ってるのぉ……%ハート()%」
						ELSE
							PRINTFORMW 「ひゃぁっ！？　あ、あ、入ってくる、お尻ぃ……」
						ENDIF
					;恋慕、親愛
					ELSEIF 연모()
						PRINTFORMW 「うぅっ、お腹がぁ……。　先生が恥ずかしがる所見て喜ぶなんてぇ……」
						PRINTFORMW %CALLNAME%は強烈な便意を堪えながら、涙目で睨んできた
					;服従、隷属
					ELSEIF 복종()
						PRINTFORMW 
					ENDIF
					CFLAG:375 = 4
				;屈服刻印Lv3
				ELSEIF MARK:굴복각인 == 3 && (CFLAG:375 < 3 || FLAG:7 == 2)
						PRINTFORMW 「うぅっ、お腹がぁ……。　お、お願い、トイレに行かせて……」
						PRINTFORMW %CALLNAME%は強烈な便意を堪えながら、涙目で懇願した
					CFLAG:375 = 3
				;それ以外
				ELSEIF CFLAG:375 < 2 || FLAG:7 == 2
						PRINTFORMW 「うぅっ、お腹がぁ……。　お、お願い、トイレに行かせて……」
						PRINTFORMW %CALLNAME%は強烈な便意を堪えながら、涙目で懇願した
					CFLAG:375 = 2
				ENDIF
			ENDIF
		ELSE
			IF CFLAG:375 == 1 || FLAG:7 == 2
				CALL TRAIN_MESSAGE
				;陥落済み
				IF 陥落() && (CFLAG:375 < 4 || FLAG:7 == 2)
					;淫乱、娼婦、淫乱スイッチＯＮ
					IF 음란() || CFLAG:800 == 1
						;マゾッ気Lv5以上
						IF ABL:마조끼 >= 5
							PRINTFORMW 「出るっ、出ちゃうっ%ハート()%　やぁぁぁっ%ハート()%」
						ELSE
							PRINTFORMW 「やぁぁっ、抜かないでっ、出ちゃうぅぅっ！」
						ENDIF
					;恋慕、親愛
					ELSEIF 연모()
						PRINTFORMW 「やぁぁっ、抜かないでっ、出ちゃうぅぅっ！」
					;服従、隷属
					ELSEIF 복종()
						PRINTFORMW 
					ENDIF
					CFLAG:375 = 4
				;屈服刻印Lv3
				ELSEIF MARK:굴복각인 == 3 && (CFLAG:375 < 3 || FLAG:7 == 2)
					PRINTFORMW 「やぁぁっ、抜かないでっ、出ちゃうぅぅっ！」
					CFLAG:375 = 3
				;それ以外
				ELSEIF CFLAG:375 < 2 || FLAG:7 == 2
					PRINTFORMW 「やぁぁっ、抜かないでっ、出ちゃうぅぅっ！」
					CFLAG:375 = 2
				ENDIF
			ENDIF
		ENDIF

