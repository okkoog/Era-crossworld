;67,기승위애널
;-------------------------------------------------
	CASE 67
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:339 == 0
			PRINTFORML 
			CFLAG:339 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落() && (CFLAG:339 < 4 || FLAG:7 == 2)
				;淫乱、娼婦、淫乱スイッチＯＮ
				IF 음란() || CFLAG:800 == 1
					IF PALAM:욕정 > 50000
						IF RAND:2 == 0
							PRINTFORML 「んはっ%ハート()%　あひっ%ハート()%　あひぃっ%ハート()%　アナル燃えるっ%ハート()%　あはぁっ%ハート()%」
							PRINTFORMW 快楽に美貌をぐしゃぐしゃに崩した%CALLNAME%は涎と鼻水を流すほどに乱れきっていながらも腰を上下に動かし快感を貪る事を忘れない
						ELSE
							PRINTFORML 「このおちんぽ、%CSTR:일인칭%のっ%ハート()%　%CSTR:일인칭%専用なんだから%ハート()%」
							PRINTFORMW %CALLNAME:PLAYER%に馬乗りになった%CALLNAME%は尻穴でペニスを捕獲して所有権を声高に主張した
							PRINTFORML 「ほ、他の子になんかっ、渡さないんだからぁっ%ハート()%　%CSTR:일인칭%のケツ穴専用おちんぽなんだからぁっ%ハート()%」
							PRINTFORMW 快感にすっかり理性が吹き飛んだ%CALLNAME%は彼女らしくもない執着を顕にして腰を揺すった
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORML 「さぁ、飛ばしていくわよぉ%ハート()%」
							PRINTFORMW %CALLNAME:PLAYER%に跨った%CALLNAME%は悪戯っぽく笑うと、尻穴で陰茎を締め上げつつ腰をグラインドさせた
						ELSE
							PRINTFORML 「ふふ、先生のお尻で搾り取ってあげる%ハート()%　遠慮なく出しなさいな%ハート()%」
							PRINTFORMW %CALLNAME%は聖母のような微笑を浮かべると、淫魔のような尻穴で%CALLNAME:PLAYER%の陰茎を締め上げた
						ENDIF
					ENDIF
				;恋慕、親愛
				ELSEIF 연모()
					IF PALAM:욕정 > 50000
						IF RAND:2 == 0
							PRINTFORML 「おっ%ハート()%　おひっ%ハート()%　おひりぃぃっ%ハート()%　しゅごいのぉっ%ハート()%」
							PRINTFORMW 完全にアナルセックスの虜になった%CALLNAME%は半ば白目を剥きながら呂律の回っていない叫びをあげる
							;処女
							IF TALENT:처녀
								PRINTFORMW 尻穴は%CALLNAME:MASTER%の極太の陰茎にしっかりと咥えこみ、未貫通の秘裂は微かに唇を開きながら愛液を断続的に吹き出している
							ELSE
								PRINTFORMW 尻穴は%CALLNAME:MASTER%の極太の陰茎にしっかりと咥えこみ、準備万端の陰唇からは絶え間なく愛液が滴り落ちている
							ENDIF
						ELSE
							PRINTFORML 「いいっ%ハート()%　これ、いいっ%ハート()%　%CSTR:이인칭%のおちんちん、最高っ%ハート()%」
							PRINTFORML %CALLNAME%は%CALLNAME:MASTER%の胸板に手をついて体を支え、自由になった腰を激しく上下させて快楽を貪った
							PRINTFORMW 豊かな胸が激しい動きに踊り、%CALLNAME:MASTER%の目を楽しませている
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORML 「気持ち良さそうな顔しちゃって%ハート()%　%CSTR:일인칭%のお尻、そんなにいいの？」
							PRINTFORMW %CALLNAME:MASTER%の陰茎を尻穴で咥えて馬乗りになった%CALLNAME%は、悪戯っぽく笑いながら腰を上下させた
						ELSE
							PRINTFORML 「いっぱい気持ちよくしてあげるから、じっとしててね%ハート()%」
							PRINTFORMW %CALLNAME:MASTER%の肉棒を尻穴でくわえ込んだ%CALLNAME%は%CALLNAME:MASTER%の顔を見下ろすと、聖母のように微笑んだ
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF 복종()
					PRINTFORMW 
				ENDIF
				CFLAG:339 = 4
			;屈服刻印Lv3
			ELSEIF MARK:굴복각인 == 3 && (CFLAG:339 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORML 「う、動くわよ……」
					PRINTFORMW 自ら尻穴で%CALLNAME:MASTER%のペニスを咥え込んだ%CALLNAME%はぎこちなく体を上下に揺すり始めた
				ELSE
					PRINTFORML 「自分でさせるなんて……意地悪」
					PRINTFORMW 口ではそう言いながらも%CALLNAME%は大人しく%CALLNAME:MASTER%の腰に跨り、尻穴にそそり立った陰茎を咥え込んでいった
				ENDIF
				CFLAG:339 = 3
			;それ以外
			ELSEIF CFLAG:339 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORML 「こ、こんな、破廉恥な真似をさせて……っ」
					PRINTFORMW 自ら%CALLNAME:MASTER%の陰茎を咥え込まされた%CALLNAME%は羞恥に顔を染めて俯いた
				ELSE
					PRINTFORML 「自分でさせるなんて……変態」
					PRINTFORMW 悔しげに罵る%CALLNAME%を%CALLNAME:MASTER%のペニスに跨らせた
				ENDIF
				CFLAG:339 = 2
			ENDIF
		ENDIF

