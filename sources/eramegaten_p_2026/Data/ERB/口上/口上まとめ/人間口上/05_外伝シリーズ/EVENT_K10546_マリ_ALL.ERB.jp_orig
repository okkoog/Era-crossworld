;=================================================
;セックス系コマンド
;=================================================
;-------------------------------------------------
;60,정상위
;-------------------------------------------------
	CASE 60
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:332 == 0
			;処女
			IF TALENT:처녀
				;淫乱、娼婦
				IF 음란()
					;助手が相手をしている
					IF ASSI > 0 && ASSIPLAY
						PRINTFORML 「あっ……」
						PRINTFORMW %CALLNAME%は一瞬驚愕に身を強張らせたが、すぐに力を抜き%CALLNAME:ASSI%に全てを委ねた
						PRINTFORML 「%CSTR:이인칭%以外の人に女にしてもらいます……」
						PRINTFORMW %CALLNAME:ASSI%はそそり立った逸物を陰唇に押し当てると、ゆっくりと挿入を開始した
						PRINTFORML 亀頭が処女膜のヒダを突き破り、未踏の処女肉を掻き分け、奥深くまで侵入していく
						PRINTFORML 「あ、あ……これで%CSTR:일인칭%、本当の大人の女に♪」
						PRINTFORMW 膣内を完全に%CALLNAME:ASSI%の肉棒で占領された%CALLNAME%は、切なげな吐息をつくと%CALLNAME:ASSI%の背に腕を回した
						PRINTFORML 「大丈夫、動いて……」
						PRINTFORML %CALLNAME%の言葉に%CALLNAME:ASSI%はゆっくりとピストンを開始する
						PRINTFORMW 犯されるのを待ち望んでいた%CALLNAME%の膣は初めてにも関わらず%CALLNAME:ASSI%の肉棒に絡みつき、痺れるような快感を生み出している
						PRINTFORML 「あ、はぁぁ……%ハート()%　凄い、セックスって、凄い……%ハート()%」
						PRINTFORML %CALLNAME:ASSI%の一突き毎に%CALLNAME%の膣肉は新たな快感を発見し、甘い疼きを%CALLNAME%の魂に刻み込んでいく
						PRINTFORMW これまで知らなかった快楽を味わいながら、%CALLNAME%は胸の中の誰かの面影が薄れていくのを感じていた
						PRINTFORML 「……こんなの、教えてくれなかったものね……」
						PRINTFORML %CALLNAME%は%CALLNAME:ASSI%の腰に足を絡めると、自ら奥深くまで肉棒を迎え入れた
						PRINTFORML 「もっとして%ハート()%　%CSTR:일인칭%に女の喜びを教え込んで%ハート()%」
						PRINTFORML %CALLNAME%の囁きを受け、%CALLNAME:ASSI%は強烈な勢いで肉棒を抜き差しする
						PRINTFORML あられもない声を上げながら、%CALLNAME%は胸の中の誰かに別れを告げていた
						PRINTFORML （さよなら、……さん。　この人達はあなたがくれなかったものを%CSTR:일인칭%にくれたんです。　だから、ごめんなさい……）
						PRINTFORMW %CALLNAME:ASSI%の逸物によって急速に乙女から雌へと作り変えられながら、%CALLNAME%はかつての想い人の為に一筋の涙を零した
					ELSE
						PRINTFORML 正面から%CALLNAME%に圧し掛かる
						PRINTFORML %CALLNAME%は一瞬驚愕に身を強張らせたが、すぐに力を抜き%CALLNAME:MASTER%に全てを委ねた
						PRINTFORMW 「やっと、女にしてくれるのね……」
						PRINTFORMW %CALLNAME:MASTER%はそそり立った逸物を陰唇に押し当てると、ゆっくりと挿入を開始した
						PRINTFORML 亀頭が処女膜のヒダを突き破り、未踏の処女肉を掻き分け、奥深くまで侵入していく
						PRINTFORML 「あ、あ……これで%CSTR:일인칭%、%CSTR:이인칭%の女に……」
						PRINTFORMW 膣内を完全に%CALLNAME:MASTER%の肉棒で占領された%CALLNAME%は、切なげな吐息をつくと%CALLNAME:MASTER%の背に腕を回した
						PRINTFORML 「大丈夫、動いて……」
						PRINTFORML %CALLNAME%の言葉に%CALLNAME:MASTER%はゆっくりとピストンを開始する
						PRINTFORML 犯されるのを待ち望んでいた%CALLNAME%の膣は経験が少ないにも関わらず%CALLNAME:MASTER%の肉棒に絡みつき、痺れるような快感を生み出している
						PRINTFORMW 「あ、はぁぁ……%ハート()%　凄い、セックスって、凄い……%ハート()%」
						PRINTFORML %CALLNAME:MASTER%の一突き毎に%CALLNAME%の膣肉は新たな快感を発見し、甘い疼きを%CALLNAME%の魂に刻み込んでいく
						PRINTFORML これまで知らなかった快楽を味わいながら、%CALLNAME%は胸の中の誰かの面影が薄れていくのを感じていた
						PRINTFORMW 「……こんなの、教えてくれなかったものね……」
						PRINTFORML %CALLNAME%は%CALLNAME:MASTER%の腰に足を絡めると、自ら奥深くまで肉棒を迎え入れた
						PRINTFORML 「もっとして、%CSTR:이인칭%%ハート()%　%CSTR:일인칭%に女の喜びを教え込んで%ハート()%」
						PRINTFORML %CALLNAME%の囁きを受け、%CALLNAME:MASTER%は強烈な勢いで肉棒を抜き差しする
						PRINTFORML あられもない声を上げながら、%CALLNAME%は胸の中の誰かに別れを告げていた
						PRINTFORML （さよなら、……さん。　この人はあなたがくれなかったものを%CSTR:일인칭%にくれたんです。　だから、ごめんなさい……）
						PRINTFORMW %CALLNAME:MASTER%の逸物によって急速に乙女から雌へと作り変えられながら、%CALLNAME%はかつての想い人の為に一筋の涙を零した
					ENDIF
				;恋慕、親愛
				ELSEIF 연모()
					;助手が相手をしている
					IF ASSI > 0 && ASSIPLAY
						;淫乱スイッチＯＮ
						IF CFLAG:800 == 1
							PRINTFORML 「あっ♪」
							PRINTFORMW %CALLNAME%は%CALLNAME:ASSI%は正面からに圧し掛かられたが、すぐに力を抜き%CALLNAME:ASSI%に全てを委ねた
							PRINTFORML 「この年でまだバージンなので、卒業させてください……%ハート()%」
							PRINTFORML %CALLNAME%に懇願された%CALLNAME:ASSI%はそそり立った逸物を陰唇に押し当てると、ゆっくりと挿入を開始した
							PRINTFORMW 亀頭が処女膜のヒダを突き破り、未踏の処女肉を掻き分け、奥深くまで侵入していく
							PRINTFORML 
							PRINTFORML 「あ、あ……おちんちんが入ってきてます♪」
							PRINTFORML 「早く…動いて%ハート()%」
							PRINTFORMW %CALLNAME:ASSI%の背に腕を回しながらおねだりをする%CALLNAME%の言葉に%CALLNAME:ASSI%はゆっくりとピストンを開始する
							PRINTFORML 
							PRINTFORML 「あっ…みてますか、%CSTR:이인칭%」
							PRINTFORML 「早くシてくれないから、%CALLNAME:ASSI%でバージン卒業ちゃいました%ハート()%」
							PRINTFORML 「あっ%ハート()%　あぁっ%ハート()%」
							PRINTFORMW %CALLNAME:MASTER%の顔を見ながら%CALLNAME%は牝として開花していった
						ELSE
							PRINTFORML 「あっ……」
							PRINTFORML %CALLNAME:ASSI%は正面から%CALLNAME%に圧し掛かる
							PRINTFORML %CALLNAME%は一瞬驚愕に身を強張らせたが、
							PRINTFORMW 横で腕を組んで頷いている%CALLNAME:MASTER%の顔を見ると力を抜き%CALLNAME:ASSI%に全てを委ねた
							PRINTFORML 「%CSTR:이인칭%に捧げられない事、残念ですが……」
							PRINTFORML 「%CSTR:일인칭%の初めて、貰ってください……」
							PRINTFORML %CALLNAME%に懇願された%CALLNAME:ASSI%はそそり立った逸物を陰唇に押し当てると、ゆっくりと挿入を開始した
							PRINTFORMW 亀頭が処女膜のヒダを突き破り、未踏の処女肉を掻き分け、奥深くまで侵入していく
							PRINTFORML 
							PRINTFORML 「あ、あ……%CSTR:일인칭%の初めてが……」
							PRINTFORML 膣内を完全に%CALLNAME:ASSI%の肉棒で占領された%CALLNAME%は、か細い声をあげるが
							PRINTFORMW 横で腕を組んで頷いている%CALLNAME:MASTER%の顔を見ると%CALLNAME:ASSI%の背に腕を回した
							PRINTFORML 「大丈夫です、動いてください……」
							PRINTFORML %CALLNAME%の言葉に%CALLNAME:ASSI%はゆっくりとピストンを開始する
							PRINTFORMW %CALLNAME:ASSI%の熟練の動きは経験の少ない%CALLNAME%の胎内からも徐々に快感を引き出していく
							PRINTFORML （%CSTR:이인칭%じゃないのに気持ちいい……）
							PRINTFORMW 横で腕を組んで頷いている%CALLNAME:MASTER%の顔を見ながら%CALLNAME:ASSI%の手により女として開花させられていった
						ENDIF
					ELSE
						;淫乱スイッチＯＮ
						IF CFLAG:800 == 1
							PRINTFORML 正面から%CALLNAME%に圧し掛かる
							PRINTFORMW %CALLNAME%は一瞬驚愕に身を強張らせたが、すぐに力を抜き%CALLNAME:MASTER%に全てを委ねた
							PRINTFORML 「%CSTR:일인칭%の初めて、あげるわ%ハート()%」
							PRINTFORMW %CALLNAME:MASTER%はそそり立った逸物を陰唇に押し当てると、ゆっくりと挿入を開始した
							PRINTFORML 亀頭が処女膜のヒダを突き破り、未踏の処女肉を掻き分け、奥深くまで侵入していく
