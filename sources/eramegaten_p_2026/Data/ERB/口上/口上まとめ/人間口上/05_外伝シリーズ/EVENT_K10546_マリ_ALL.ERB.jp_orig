					PRINTFORML 「玩具みたいに弄りまわして……っ」
					PRINTFORMW 好き放題に胸を弄ばれ、%CALLNAME%は悔しげに呟いた
				ELSE
					PRINTFORML 「い、いやらしい触り方、しないでくださいっ」
					PRINTFORMW %CALLNAME%は満員電車の痴漢に対するかのような口調で咎めた
					PRINTFORMW ……まあ、この立派な胸なら実際に痴漢の一人や二人に遭遇していてもおかしくはない
				ENDIF
				CFLAG:308 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;9,조개젖히기
;-------------------------------------------------
	CASE 9
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:309 == 0
			PRINTFORML 
			CFLAG:309 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落() && (CFLAG:309 < 4 || FLAG:7 == 2)
				;淫乱、娼婦、淫乱スイッチＯＮ
				IF 음란() || CFLAG:800 == 1
					IF RAND:2 == 0
						IF TEQUIP:비디오카메라
							PRINTFORML 「テレビの向こうのみんなも元気かな～♪」
						ENDIF
						PRINTFORML 「エッチなマリ先生の保健の時間、おまんこ編ー%ハート()%」
						PRINTFORML 大きく陰唇を広げた%CALLNAME%はどこか楽しげに言うと、各部を指差しながら説明を始める
						PRINTFORML 「この膨らみが大陰唇、おまんこを保護する部分ね。　その内側が小陰唇、おちんちんを迎え入れる部分ね%ハート()%」
						PRINTFORMW 「このポッチがクリトリス、女の子の急所よ、気持ちいいんだから%ハート()%　こっちが尿道口、おしっこが出る所よ」
						PRINTFORMW 「何でも尿道口でも気持ちよくなれるらしいから、先生そのうち試してみたいな%ハート()%」
						;処女
						IF TALENT:처녀
							PRINTFORML 「それでぇ……ここが処女膜%ハート()%　実際には膜じゃなくて膣口を狭くしてるヒダなんだけどね」
							PRINTFORML 「生理学的にはあんまり意味がないそうだけど、男の人は拘るみたいね%ハート()%」
							PRINTFORMW 「先生の場合は環状処女膜、オーソドックスな形で膣口をせまーくしているわ」
							PRINTFORML 「ここの内側が膣なんだけど……中身を見せるには処女膜が邪魔ね」
							IF HAVE_PENIS(MASTER)
								PRINTFORMW 「これ、%CALLNAME:MASTER%クンのおちんちんで突き破ってくれないかしら%ハート()%」
							ELSEIF ASSI > 0 && HAVE_PENIS(ASSI)
								PRINTFORMW 「%CALLNAME:ASSI%クンのおちんちんで突き破っていいかしら%ハート()%」
							ELSE
								PRINTFORMW 「二人で可愛い子、逆ナンしてレイプとかどうかしら%ハート()%」
							ENDIF
							PRINTFORMW 処女膜を示しながら、%CALLNAME%はいやらしくおねだりした
						ELSE
							PRINTFORML 「この穴の部分が膣口、おちんちんを受け入れる部分ね%ハート()%」
							PRINTFORMW 「その内側が膣、おちんちんを締め上げてザーメンを吐き出させるのが役割よ%ハート()%」
							PRINTFORML 「で……どれくらい気持ちよくなれるのか、試してみない？」
							PRINTFORMW %CALLNAME%は潤んだ膣肉を見せつけ、おねだりした
						ENDIF
					ELSE
						PRINTFORMW 「%CSTR:일인칭%のいやらしい所、見たいのね……%ハート()%」
						;処女
						IF TALENT:처녀
							IF HAVE_PENIS(MASTER)
								PRINTFORML 「あの、ね？　そろそろ、%CSTR:이인칭%のおちんちん、欲しいなぁなんて……」
							ELSEIF ASSI > 0 && HAVE_PENIS(ASSI)
								PRINTFORMW 「%CALLNAME:ASSI%のおちんちん挿れても、いいかしら%ハート()%」
							ELSE
								PRINTFORMW 「この年て処女なんて恥ずかしいから…」
							ENDIF
							PRINTFORMW %CALLNAME%は未使用の膣口を大きく広げたまま、色欲に霞んだ瞳でおねだりした
						ELSE
							PRINTFORMW 大きく広げられた陰唇の中で、ピンクの輪を思わせる%CALLNAME%の膣口がひくひくと収縮している
							;中に射精されました
							IF TCVAR:TARGET:질내사정량 > 0
								PRINTFORML %CALLNAME%の膣奥に注がれた精液は、膣口の収縮に合わせて断続的に吹き零れていた
								PRINTFORML 「あぁん、勿体無い……%ハート()%」
								PRINTFORMW 胎内から零れ落ちていく精液を見下ろし、%CALLNAME%は切なげに呟いた
							ELSE
								;調教者にチンコがある場合
								IF HAVE_PENIS(PLAYER)
									PRINTFORML 「この奥をね、おちんちんで抉って欲しいの……%ハート()%」
								;チンコのない助手が相手をしてる場合
								ELSEIF HAVE_PENIS(MASTER)
									PRINTFORML 「この奥をね、%CSTR:이인칭%のおちんちんで抉って欲しいの……%ハート()%」
								;チンコのない＠が相手をして、助手にチンコがある場合
								ELSEIF ASSI > 0 && HAVE_PENIS(ASSI)
									PRINTFORML 「%CALLNAME:ASSI%のおちんちん挿れても、いいかしら%ハート()%」
								ELSE
									PRINTFORML 「何でもいいから…ネ♪」
								ENDIF
								PRINTFORMW 頬を上気させた%CALLNAME%は物欲しそうにひくつく膣口を晒したまま、上目遣いでおねだりした
							ENDIF
						ENDIF
					ENDIF
				;恋慕、親愛
				ELSEIF 연모()
					IF RAND:2 == 0
						PRINTFORML 「マリ先生の保健の時間、女性器編ー%ハート()%」
						PRINTFORML 大きく陰唇を広げた%CALLNAME%はどこか楽しげに言うと、各部を指差しながら説明を始める
						PRINTFORML 「この膨らみが大陰唇、生殖器を保護する部分ね。　その内側が小陰唇、男の人を迎え入れる部分ね%ハート()%」
						PRINTFORMW 「このポッチがクリトリス、女の子の急所よ%ハート()%　こっちが尿道口、おしっこが出る所よ」
						;処女
						IF TALENT:처녀
							PRINTFORML 「それでぇ……ここが処女膜%ハート()%　実際には膜じゃなくて膣口を狭くしてるヒダなんだけどね」
							PRINTFORML 「生理学的にはあんまり意味がないそうだけど、男の人は拘るみたいね%ハート()%」
							PRINTFORMW 「先生の場合は環状処女膜、オーソドックスな形で膣口をせまーくしているわ」
							PRINTFORML 「ここの内側が膣なんだけど……中身を見せるには処女膜が邪魔ね」
							PRINTFORMW 「これ、取り除いて欲しいんだけど、%CALLNAME:MASTER%クンのペニスで%ハート()%」
							PRINTFORMW 処女膜を示しながら、%CALLNAME%は照れたようにおねだりした
						ELSE
							PRINTFORML 「この穴の部分が膣口、男の人を受け入れる部分ね%ハート()%」
							PRINTFORMW 「その内側が膣、セックスの際は男の人を喜ばせるのが役割よ%ハート()%」
							PRINTFORML 「で……どれくらい気持ちよくなれるのか、試してみない？」
							PRINTFORMW %CALLNAME%は潤んだ膣肉を見せつけ、おねだりした
						ENDIF
					ELSE
						PRINTFORMW 「%CSTR:일인칭%の恥ずかしい所、見たいのね……%ハート()%」
						;処女
						IF TALENT:처녀
							PRINTFORML 「あの、ね？　そろそろ、して、欲しいなぁなんて……」
							PRINTFORMW %CALLNAME%は未使用の膣口を恥ずかしげに晒したまま、上目遣いでおねだりした
						ELSE
							PRINTFORMW 大きく広げられた陰唇の中で、ピンクの輪を思わせる%CALLNAME%の膣口がひくひくと収縮している
							;中に射精されている
							IF TCVAR:TARGET:질내사정량 > 0
								PRINTFORML %CALLNAME%の膣奥に注がれた精液は、膣口の収縮に合わせて断続的に吹き零れていた
								PRINTFORML 「やぁっ、零れちゃう……」
								PRINTFORMW 胎内から零れ落ちていく精液を見下ろし、%CALLNAME%は切なげに呟いた
							ELSE
								PRINTFORML 「この奥がね、%CSTR:이인칭%のを欲しがってるの……%ハート()%」
								PRINTFORMW 頬を染めた%CALLNAME%は切なそうにひくつく膣口を晒したまま、上目遣いでおねだりした
							ENDIF
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF 복종()
					PRINTFORML 
				ENDIF
				CFLAG:309 = 4
			;屈服刻印Lv3
			ELSEIF MARK:굴복각인 == 3 && (CFLAG:309 < 3 || FLAG:7 == 2)
				;撮影中
				IF TEQUIP:비디오카메라 == 1 && RAND:2 == 0
					PRINTFORML 「%NAME%。　２３歳、養護教諭」
					IF TALENT:처녀
						IF RAND:2 == 0
							PRINTFORML 「まだ未使用のおまんこです」
						ELSE
							PRINTFORML 「セックスの経験はまだありません」
						ENDIF
						PRINTFORMW %CALLNAME%は羞恥に震えながら、むき出しの陰唇を広げて見せた
					;中に射精されている
					ELSEIF TCVAR:TARGET:질내사정량 > 0
						PRINTFORML 「おまんこにたっぷり中出しされました……」
						PRINTFORML 膣口から零れ落ちてくる精液をズームで撮影されている
					ELSE
						PRINTFORML 「%CSTR:일인칭%のおまんこ、見てください」
						PRINTFORMW %CALLNAME%は羞恥に震えながら、むき出しの陰唇を広げて見せた
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORML 「うぅ……」
					ELSE
						PRINTFORML 「まじまじと見ないでください……」
					ENDIF
					PRINTFORMW %CALLNAME%は羞恥に震えながら、むき出しの陰唇を広げて見せた
				ENDIF
				CFLAG:309 = 3
			;それ以外
			ELSEIF CFLAG:309 < 2 || FLAG:7 == 2
				;撮影中
				IF TEQUIP:비디오카메라 == 1 && RAND:2 == 0
					PRINTFORML 「%NAME%。　２３歳、養護教諭」
					IF TALENT:처녀
						IF RAND:2 == 0
							PRINTFORML 「まだ未使用のおまんこです……」
						ELSE
							PRINTFORML 「セックスの経験はまだありません……」
						ENDIF
					ELSE
						PRINTFORML 「%CSTR:일인칭%のおまんこ、見てください……」
					ENDIF
					PRINTFORMW %CALLNAME%は羞恥と屈辱に涙を浮かべながら、むき出しの陰唇を広げて見せた
				ELSE
					PRINTFORML 「こ、こんな恥ずかしい事……」
					PRINTFORMW %CALLNAME%は羞恥と屈辱に涙を浮かべながら、むき出しの陰唇を広げて見せた
					;中に射精されている
					IF TCVAR:TARGET:질내사정량 > 0
						PRINTFORML 既に%CALLNAME:MASTER%に蹂躙された膣口からは、胎内に注ぎ込まれた精液が零れ落ちてくる
						PRINTFORML 「うぅ……」
						PRINTFORMW 己が陵辱された証をまざまざと見せ付けられ、%CALLNAME%は嗚咽をあげた
						ENDIF
				ENDIF
				CFLAG:309 = 2
			ENDIF
		ENDIF

