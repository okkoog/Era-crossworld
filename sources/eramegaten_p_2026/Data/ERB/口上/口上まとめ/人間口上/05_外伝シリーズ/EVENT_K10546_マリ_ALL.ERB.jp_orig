		CFLAG:246 = 2
	ENDIF
;절정
ELSEIF TFLAG:29 > 0
	CALL PALAM_MESSAGE_B
	;陥落済み
	IF 陥落() && (CFLAG:246 < 4 || FLAG:7 == 2)
		;淫乱、娼婦、淫乱スイッチＯＮ
		IF 음란() || CFLAG:800 == 1
