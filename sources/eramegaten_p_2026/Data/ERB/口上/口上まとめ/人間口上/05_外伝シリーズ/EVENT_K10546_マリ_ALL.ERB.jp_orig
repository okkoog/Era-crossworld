	CASE 63
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:335 == 0
			PRINTFORML 四つん這いにさせた%CALLNAME%の尻に手を掛け、白い尻肉を左右に割り開く
			PRINTFORML 顕にした菊門に亀頭を押し付けると、%CALLNAME%は狼狽した声をあげた
			PRINTFORMW 「そ、そこは違います、不衛生ですからやめてくださいっ！」
			PRINTFORML %CALLNAME:MASTER%は%CALLNAME%の声を無視すると、窄まったセピア色のアナルを容赦なく抉った
			PRINTFORMW 「あっ……ぎぃぃっ！？」
			CFLAG:335 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落() && (CFLAG:335 < 4 || FLAG:7 == 2)
				;淫乱、娼婦、淫乱スイッチＯＮ
				IF 음란() || CFLAG:800 == 1
					IF PALAM:욕정 > 50000
						IF RAND:2 == 0
							PRINTFORML 「んはぁっ%ハート()%　はぁぁぁっ%ハート()%　あひぃぃぃんっ%ハート()%」
							PRINTFORMW %CALLNAME%は腰をがっしりと掴まれ、とろけきった尻穴を乱暴に突きまくられている
							;処女
							IF TALENT:처녀
								PRINTFORMW 雌穴と化したアナルとは裏腹に未貫通の陰唇は泡だった愛液を垂らしながら切なげに震えていた
							ELSE
								PRINTFORMW 肉棒を咥え込んだアナルを羨む様に陰唇はぱっくりと口を開き、泡だった愛液を垂れ流しながら挿入を待ち望んでいた
							ENDIF
						ELSE
							PRINTFORML 「あはぁっ%ハート()%　ひあぁぁぁぁっ%ハート()%」
							PRINTFORMW 肛虐の快楽に犯されきった%CALLNAME%の体は脱力し、最早四つん這いを保っていられない
							PRINTFORMW 豊かな乳肉を押しつぶすように上半身はぐったりと伏せられているが、%CALLNAME:MASTER%に尻肉を鷲掴みにされた下半身は無理やり腰を突き上げる姿勢を取らされていた
							;処女
							IF TALENT:처녀
								PRINTFORMW ぐぽんぐぽんと湿った音を立てて剛直が抜き差しされる尻穴の下で、未だ純潔を保っている秘唇も濡れそぼっている
								PRINTFORMW 清楚に閉じられていた陰唇は嵐のような肛虐の快楽に綻び、わずかに処女肉を覗かせながら切なげに愛液を垂らしていた
							ELSE
								PRINTFORMW ぐぽんぐぽんと湿った音を立てて剛直が抜き差しされる尻穴の下で、すっかり綻んだ女陰も愛液に濡れそぼっていた
							ENDIF
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORML 「アナルセックスなんて、不衛生で、生殖上無意味なのにぃ%ハート()%」
							PRINTFORMW 「どうしてこんなに気持ちいいのぉっ%ハート()%」
						ELSE
							PRINTFORML 「お、お尻っ%ハート()%　お尻いいのっ%ハート()%」
							;処女
							IF TALENT:처녀
								;助手が相手をしている
								IF ASSI > 0 && ASSIPLAY
									PRINTFORML 「先生、まだおまんこした事ないのにっ%ハート()%」
									PRINTFORMW 「お尻だけおちんちん専用穴にされちゃったぁ%ハート()%」
								ELSE
									PRINTFORMW 「先生、まだおまんこした事ないのにっ%ハート()%　お尻だけ%CALLNAME:MASTER%クンのおちんちん専用穴にされちゃったぁ%ハート()%」
								ENDIF
							ELSE
								PRINTFORML 「ア、アナルセックスの後はきちんとおちんちんを綺麗にしてねっ」
								PRINTFORML 「そのままおまんこに入れられたら、病気になっちゃうからっ」
								PRINTFORMW %CALLNAME%は逸物に尻穴を抉られながらも保健医らしい注意を口にしている
							ENDIF
						ENDIF
					ENDIF
				;恋慕、親愛
				ELSEIF 연모()
					IF PALAM:욕정 > 50000
						IF RAND:2 == 0
							PRINTFORML 「お尻、熱い%ハート()%　おちんちんで栓されて、お尻燃えちゃうのぉっ%ハート()%」
							PRINTFORMW すっかり従順になった尻穴に逸物を咥えこみ、%CALLNAME%は涎を垂らして悶えた
							;処女
							IF TALENT:처녀
								PRINTFORMW 調教されきったアナルとは裏腹に未貫通の陰唇は切なげに愛液を垂らしてかすかに口を開いている
							ELSE
								PRINTFORMW 調教されきったアナルを羨む様に陰唇はぱっくりと口を開き、愛液を垂れ流しながら挿入を待ち望んでいる
							ENDIF
						ELSE
							PRINTFORML 「ひんっ%ハート()%　あっ%ハート()%　ひぁぁんっ%ハート()%」
							PRINTFORMW 高々と上げた尻を犯され、%CALLNAME%は肛虐の快楽に酔っている
							;処女
							IF TALENT:처녀
								PRINTFORML 「お、お尻っ%ハート()%　だけじゃなくてっ%ハート()%　おまんこも愛してぇっ%ハート()%」
								PRINTFORMW 尻穴で快楽を感じるほどに開発されながらも未だに乙女の%CALLNAME%は、自らの純潔を捧げる台詞を叫びながら悶え狂った
							ELSE
								PRINTFORMW 「お、おまんこも好きだけどっ%ハート()%　お尻もっ%ハート()%　好きっ%ハート()%　どっちも好きぃ%ハート()%」
							ENDIF
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORML 「お尻なんて、不衛生なのにぃ%ハート()%」
							PRINTFORMW そう言いながらも%CALLNAME%は自ら尻を高く上げ、菊門を穿たれる快楽に歓んでいる
						ELSE
							PRINTFORML 「お、お尻っ%ハート()%　お尻で感じちゃうっ%ハート()%」
							;処女
							IF TALENT:처녀
								PRINTFORMW 「先生、まだバージンなのにっ%ハート()%　%CALLNAME:MASTER%クンにお尻で感じる体にされちゃったぁ%ハート()%」
							ELSE
								PRINTFORML 「ア、アナルセックスの後はきちんとペニスを綺麗にしてねっ。　そのまま膣に入れられたら、病気になっちゃうからっ」
								PRINTFORMW %CALLNAME%は逸物に尻穴を抉られながらも保健医らしい注意を口にしている
							ENDIF
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF 복종()
					PRINTFORML 
				ENDIF
				CFLAG:335 = 4
			;屈服刻印Lv3
			ELSEIF MARK:굴복각인 == 3 && (CFLAG:335 < 3 || FLAG:7 == 2)
						IF RAND:2 == 0
							PRINTFORMW 「くぅぅ……せ、せめて腸内に出すのだけは……」
						ELSE
							PRINTFORMW 「うぅ……こ、こんな屈辱的な事……」
							;処女
							IF TALENT:처녀
								PRINTFORMW （処女を奪われるのよりはマシだけれどっ……）
							ENDIF
						ENDIF
				CFLAG:335 = 3
			;それ以外
			ELSEIF CFLAG:335 < 2 || FLAG:7 == 2
				PRINTFORML 「へ、変態っ……！」
				PRINTFORMW 屈辱に震えながら罵倒する%CALLNAME%の尻穴を、背後から存分に蹂躙した
				CFLAG:335 = 2
			ENDIF
		ENDIF

