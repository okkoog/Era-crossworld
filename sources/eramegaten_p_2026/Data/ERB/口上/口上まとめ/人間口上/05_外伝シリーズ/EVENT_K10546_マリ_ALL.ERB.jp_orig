		;-------------------------------------------------
	CASE 63
			CALL EVENT_MESSAGE
			;初めて
			IF CFLAG:606 == 0
				PRINTFORML 
				CFLAG:606 = 1
			;それ以外
			ELSEIF CFLAG:276 < 1 || FLAG:7 == 2
				IF 음란()
					SELECTCASE RAND:4
				;挨拶
					CASE 0
						PRINTFORML 
						PRINTFORML %CALLNAME%は客のリクエスト通りの服装で客室に入った
						PRINTFORML シックなブラウスにタイトスカート。髪は後頭部に結い上げ、黒縁の伊達眼鏡を掛ける
						PRINTFORMW 教鞭まで手にした%CALLNAME%の姿は、まさにお堅い女教師そのものだ
						PRINTFORML 「さて……どんな悪い事をしたのか、先生に聞かせてちょうだい？」
						PRINTFORMW 客は理想の女教師の前に正座すると、お仕置きの為の些細な悪事を告白した
						PRINTFORML 「まあ、先生のおっぱいが気になって仕事が手につかないの？」
						PRINTFORML 「おちんちん、そんなにギンギンにして……。お仕事中にもそうだったんでしょう？いけない子%ハート()%」
						PRINTFORMW %CALLNAME%は眼鏡の奥の瞳を弓の形に細めると、正座した客の股間にそそり立っている逸物に手を添えた
						PRINTFORML 「こんないけないおちんちん、先生がお仕置きしてあげます%ハート()%」
						PRINTFORML ほっそりとした指先で客のペニスをしごきながら、%CALLNAME%は密かに嘆息した
						PRINTFORMW （%CSTR:일인칭%、本当は養護教諭なんだけど……女教師リクエストの方が多いのはどうしてかしら）
						PRINTFORML 
					CASE 1
						PRINTFORML 
						PRINTFORML 女教師ルックの%CALLNAME%は教室を模した客室で客と交わっていた
						PRINTFORMW 「だ、ダメよ、生徒となんて、ダメぇ%ハート()%」
						PRINTFORML タイトスカートを捲り上げられ、背後から貫かれた%CALLNAME%は設定に則った甘い声をあげる
						PRINTFORML 客は憧れの女教師をレイプする生徒という役所に昂ぶり、荒々しく%CALLNAME%の膣を蹂躙する
						PRINTFORMW 「あはぁぁんっ%ハート()%　%CSTR:일인칭%、先生なのにっ、生徒に犯されて感じちゃってるぅっ%ハート()%」
						PRINTFORML 黒板に押し付けれた豊かな胸はひしゃげ、股間部分を乱暴に破られたパンストには大量の愛液が滴っていた
						PRINTFORMW どうやら%CALLNAME%にとってもこのシチュエーションはまんざらではないらしい
						PRINTFORML 
					CASE 2
						PRINTFORML 
						PRINTFORML 「はぁい、お浣腸をいれましょうねぇ%ハート()%」
						PRINTFORMW 白衣を羽織った%CALLNAME%は養護教諭らしい慈愛に満ちた笑みを浮かべ、客の尻穴に浣腸器の先端を差し入れた
						PRINTFORML 「さ、いきますよぉ」
						PRINTFORML 「苦しいの？　まだ半分よ？」
						PRINTFORML 「がんばって、ほら、あと少し、がんばれがんばれ%ハート()%」
						PRINTFORML 「ん、えらいえらい、全部飲み込めましたね%ハート()%　花丸をあげましょう%ハート()%」
						PRINTFORMW 太い浣腸器の中身を全て客の腸内に注ぎ込んだ%CALLNAME%は、下腹を膨らませ尻穴をひくつかせている客のお腹をいい子いい子と撫でた
						PRINTFORMW そして、おもむろにその手で客の腹をぐっと押し込んだ
						PRINTFORMW 客が歓喜の悲鳴と異音と悪臭と汚物を撒き散らす様に、%CALLNAME%は嗜虐の興奮に染まった目元を細めた
						PRINTFORML 
					CASE 3
						PRINTFORML 
						PRINTFORML 「ご指名ありがとうございます、お客様%ハート()%」
						PRINTFORML 客に一礼した%CALLNAME%は羽織ったガウンをするりと落とした
						PRINTFORMW グラマラスな白い肢体には扇情的な黒レースの下着が張り付いている
						PRINTFORMW 「さて、今宵はどんなご奉仕をいたしましょう？　손？　입？　가슴？　それとも……」
						PRINTFORML 
					CASEELSE
						PRINTFORML 
					ENDSELECT
				ELSE
					PRINTFORML 
				ENDIF
			CFLAG:606 = 1
		ENDIF

