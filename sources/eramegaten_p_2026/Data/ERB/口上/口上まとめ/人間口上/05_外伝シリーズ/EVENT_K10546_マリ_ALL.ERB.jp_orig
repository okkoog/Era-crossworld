					IF CFLAG:애ＮＴＲ진행도 == 0
						PRINTFORML 
					;二回目（リーチ）
					ELSEIF CFLAG:애ＮＴＲ진행도 == 1
						PRINTFORML 
					;三回目（陥落）
					ELSEIF CFLAG:애ＮＴＲ진행도 == 2
						PRINTFORML 
					ENDIF
				ENDIF
			ELSE
				;主人以外の誰かに陥落している状態で更に別のキャラにＮＴＲ
				;進行度分岐
				;初回
				IF CFLAG:애ＮＴＲ진행도 == 0
					PRINTFORML 
				;二回目（リーチ）
				ELSEIF CFLAG:애ＮＴＲ진행도 == 1
					PRINTFORML 
				;三回目（陥落）
				ELSEIF CFLAG:애ＮＴＲ진행도 == 2
					PRINTFORML 
				ENDIF
			ENDIF
			CFLAG:288 = 1
		ENDIF
		;-------------------------------------------------
		;;[淫ＮＴＲ]イベント時
		;-------------------------------------------------
	CASE 46
		CALL EVENT_MESSAGE
		;陥落済み
		IF (CFLAG:289 < 1 || FLAG:7 == 2)
			IF CFLAG:함락캐릭터 == CFLAG:MASTER:캐릭터고유번호
				;主人に陥落しているor誰にも陥落してない状態でＮＴＲ
				;恋慕、親愛
				IF 연모()
					;進行度分岐
					;初回
					IF CFLAG:음ＮＴＲ진행도 == 0
						PRINTFORML 
					;二回目（リーチ）
					ELSEIF CFLAG:음ＮＴＲ진행도 == 1
						PRINTFORML 
					;三回目（陥落）
					ELSEIF CFLAG:음ＮＴＲ진행도 == 2
						PRINTFORML 
					ENDIF
				;服従、隷属
				ELSEIF 복종()
					;進行度分岐
					;初回
					IF CFLAG:음ＮＴＲ진행도 == 0
						PRINTFORML 
					;二回目（リーチ）
					ELSEIF CFLAG:음ＮＴＲ진행도 == 1
						PRINTFORML 
					;三回目（陥落）
					ELSEIF CFLAG:음ＮＴＲ진행도 == 2
						PRINTFORML 
					ENDIF
				;그외
				ELSE
					;進行度分岐
					;初回
					IF CFLAG:음ＮＴＲ진행도 == 0
						PRINTFORML 
					;二回目（リーチ）
					ELSEIF CFLAG:음ＮＴＲ진행도 == 1
						PRINTFORML 
					;三回目（陥落）
					ELSEIF CFLAG:음ＮＴＲ진행도 == 2
						PRINTFORML 
					ENDIF
				ENDIF
			ELSE
				;主人以外の誰かに陥落している状態で更に別のキャラにＮＴＲ
				;進行度分岐
				;初回
				IF CFLAG:음ＮＴＲ진행도 == 0
					PRINTFORML 
				;二回目（リーチ）
				ELSEIF CFLAG:음ＮＴＲ진행도 == 1
					PRINTFORML 
				;三回目（陥落）
				ELSEIF CFLAG:음ＮＴＲ진행도 == 2
					PRINTFORML 
				ENDIF
			ENDIF
			CFLAG:289 = 1
		ENDIF
		;-------------------------------------------------
		;;[隷ＮＴＲ]イベント時
		;-------------------------------------------------
	CASE 47
		CALL EVENT_MESSAGE
		;陥落済み
		IF (CFLAG:290 < 1 || FLAG:7 == 2)
			IF CFLAG:함락캐릭터 == CFLAG:MASTER:캐릭터고유번호
				;主人に陥落しているor誰にも陥落してない状態でＮＴＲ
				;恋慕、親愛
				IF 연모()
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORML 
					;二回目（リーチ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORML 
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						PRINTFORML 
					ENDIF
				;淫乱、娼婦
				ELSEIF 음란()
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORML 
					;二回目（リーチ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORML 
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						PRINTFORML 
					ENDIF
				;服従、隷属
				ELSEIF 복종()
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORML 
					;二回目（リーチ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORML 
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						PRINTFORML 
					ENDIF
				;그외
				ELSE
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORML 
					;二回目（リーチ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORML 
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						PRINTFORML 
					ENDIF
				ENDIF
			ELSE
				;主人以外の誰かに陥落している状態で更に別のキャラにＮＴＲ
				;進行度分岐
				;初回
				IF CFLAG:예ＮＴＲ진행도 == 0
					PRINTFORML 
				;二回目（リーチ）
				ELSEIF CFLAG:예ＮＴＲ진행도 == 1
					PRINTFORML 
				;三回目（陥落）
				ELSEIF CFLAG:예ＮＴＲ진행도 == 2
					PRINTFORML 
				ENDIF
			ENDIF
			CFLAG:290 = 1
		ENDIF
		;-------------------------------------------------
		;;愛系再陥落時
		;;主人に対して恋慕系陥落している、もしくは一度愛系ＮＴＲ状態にされたキャラに再び陥落させられる時
		;-------------------------------------------------
	CASE 48
		CALL EVENT_MESSAGE
		;再陥落前に陥落しているキャラ→CFLAG:함락캐릭터 で取得可能、名前は%NTRNAME(CFLAG:함락캐릭터)%
		;再陥落先のキャラ→ FAVORITE_1_ID(TARGET)　で取得可能、名前は%NTRNAME(FAVORITE_1_ID(TARGET))%
		;やや煩雑になるのでLOCAL、あるいは#DIM等を使用して分かりやすくする事を推奨します
		
		IF (CFLAG:291 < 1 || FLAG:7 == 2)
			;主人に対して陥落し直し
			IF FAVORITE_1_ID(TARGET) == CFLAG:MASTER:캐릭터고유번호
				PRINTFORML 
			;その他のキャラ・ＮＰＣにＮＴＲし直し
			ELSE
				PRINTFORML 
			ENDIF
			CFLAG:291 = 1
		ENDIF
		;-------------------------------------------------
		;;淫系再陥落時
		;;主人に対して淫乱系陥落している、もしくは一度淫系ＮＴＲ状態にされたキャラに再び陥落させられる時
		;-------------------------------------------------
	CASE 49
		CALL EVENT_MESSAGE
		;再陥落前に陥落しているキャラ→CFLAG:함락캐릭터 で取得可能、名前は%NTRNAME(CFLAG:함락캐릭터)%
		;再陥落先のキャラ→ FAVORITE_1_ID(TARGET)　で取得可能、名前は%NTRNAME(FAVORITE_1_ID(TARGET))%
		;やや煩雑になるのでLOCAL、あるいは#DIM等を使用して分かりやすくする事を推奨します
					
		IF (CFLAG:292 < 1 || FLAG:7 == 2)
			;主人に対して陥落し直し
			IF FAVORITE_1_ID(TARGET) == CFLAG:MASTER:캐릭터고유번호
				PRINTFORML 
			;その他のキャラ・ＮＰＣにＮＴＲし直し
			ELSE
				PRINTFORML 
			ENDIF
			CFLAG:292 = 1
		ENDIF
		;-------------------------------------------------
		;;隷系再陥落時
		;;主人に対して服従系陥落している、もしくは一度隷系ＮＴＲ状態にされたキャラに再び陥落させられる時
		;-------------------------------------------------
	CASE 50
		CALL EVENT_MESSAGE
		;再陥落前に陥落しているキャラ→CFLAG:함락캐릭터 で取得可能、名前は%NTRNAME(CFLAG:함락캐릭터)%
		;再陥落先のキャラ→ FAVORITE_1_ID(TARGET)　で取得可能、名前は%NTRNAME(FAVORITE_1_ID(TARGET))%
		;やや煩雑になるのでLOCAL、あるいは#DIM等を使用して分かりやすくする事を推奨します
					
		IF (CFLAG:293 < 1 || FLAG:7 == 2)
			;主人に対して陥落し直し
			IF FAVORITE_1_ID(TARGET) == CFLAG:MASTER:캐릭터고유번호
				PRINTFORML 
			;その他のキャラ・ＮＰＣにＮＴＲし直し
			ELSE
				PRINTFORML 
			ENDIF
			CFLAG:293 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・乱交パーティ
		;;淫ＮＴＲ状態（TALENT:ＮＴＲ == 2 か TALENT:ＮＴＲ == 5）である時のみ
		;-------------------------------------------------
	CASE 51
		CALL EVENT_MESSAGE
		IF (CFLAG:294 < 1 || FLAG:7 == 2)
			IF 연모()
				;以前恋慕ルートだった場合
				PRINTFORML 
			ELSEIF 복종()
				;以前服従ルートだった場合
				PRINTFORML 
			ELSE
				PRINTFORML
			ENDIF
			CFLAG:294 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・公園
		;;淫ＮＴＲ状態（TALENT:ＮＴＲ == 2 か TALENT:ＮＴＲ == 5）である時のみ
		;-------------------------------------------------
	CASE 52
		CALL EVENT_MESSAGE
		IF (CFLAG:295 < 1 || FLAG:7 == 2)
			IF 연모()
				;以前恋慕ルートだった場合
				PRINTFORML 
			ELSEIF 복종()
				;以前服従ルートだった場合
				PRINTFORML 
			ELSE
				PRINTFORML
			ENDIF
			CFLAG:295 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・便器
		;;淫ＮＴＲ状態（TALENT:ＮＴＲ == 2 か TALENT:ＮＴＲ == 5）である時のみ
		;-------------------------------------------------
	CASE 53
		CALL EVENT_MESSAGE
		IF (CFLAG:296 < 1 || FLAG:7 == 2)
			IF 연모()
				;以前恋慕ルートだった場合
				PRINTFORML 
			ELSEIF 복종()
				;以前服従ルートだった場合
				PRINTFORML 
			ELSE
				PRINTFORML
			ENDIF
			CFLAG:296 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・夜の街
		;;淫ＮＴＲ状態（TALENT:ＮＴＲ == 2 か TALENT:ＮＴＲ == 5）である時のみ
		;-------------------------------------------------
	CASE 54
		CALL EVENT_MESSAGE
		IF (CFLAG:296 < 1 || FLAG:7 == 2)
			IF 연모()
				;以前恋慕ルートだった場合
				PRINTFORML 
			ELSEIF 복종()
				;以前服従ルートだった場合
				PRINTFORML 
			ELSE
				PRINTFORML
			ENDIF
			CFLAG:296 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・ＮＴＲ前逢引
		;;ＮＴＲ状態になる前に逢引する時
		;-------------------------------------------------
	CASE 55
		CALL EVENT_MESSAGE
		IF (CFLAG:297 < 1 || FLAG:7 == 2)
			IF CFLAG:함락캐릭터 != 0
				;主人以外に陥落している場合
				PRINTFORML 
			ELSEIF 연모()
				;恋慕ルート
				PRINTFORML 
			ELSEIF 음란()
				;淫乱ルート
				PRINTFORML 
			ELSEIF 복종()
				;服従ルート
				PRINTFORML 
			ELSE
				PRINTFORML
			ENDIF
			CFLAG:297 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・ＮＴＲ後初逢引
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)になった直後の一日の終了後、一度だけ行う
		;別のキャラに陥落する度に起こる。同じキャラに再度陥落した場合は起こらない
		;-------------------------------------------------
	CASE 56
		CALL EVENT_MESSAGE
		IF (CFLAG:298 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORML 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORML 
			ENDIF
			CFLAG:298 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・デート
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;-------------------------------------------------
	CASE 57
		CALL EVENT_MESSAGE
		IF (CFLAG:299 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORML 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORML 
			ENDIF
			CFLAG:299 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・本番
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;女性であれば入れられる側、男性であれば入れる側で固定
		;-------------------------------------------------
	CASE 58
		CALL EVENT_MESSAGE
		IF (CFLAG:601 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORML 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORML 
			ENDIF
			CFLAG:601 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・自慰見せ合い
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;愛ＮＴＲ状態の場合、露出癖3か自慰中毒1のどちらかを満たしている事が条件になります。
		;-------------------------------------------------
	CASE 59
		CALL EVENT_MESSAGE
		IF (CFLAG:602 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORML 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORML 
			ENDIF
			CFLAG:602 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・アナル
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;CFLAG:アナル回数が1以上なら入れられている、CFLAG:挿入回数が1以上なら入れています。
		;両方立っている場合は、地の文では入れられている側が優先されます。
		;-------------------------------------------------
	CASE 60
		CALL EVENT_MESSAGE
		IF (CFLAG:603 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORML 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORML 
			ENDIF
			CFLAG:603 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・野外プレイ
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;愛ＮＴＲの場合、露出癖が4以上でないと発生しません
		;-------------------------------------------------
	CASE 61
		CALL EVENT_MESSAGE
		IF (CFLAG:604 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORML 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORML 
			ENDIF
			CFLAG:604 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・野外調教
		;;隷ＮＴＲ状態(TALENT:ＮＴＲが 3 か 6)でCFLAG:現ＮＴＲ進行度が6以上の場合１日の終了時に発生。
		;-------------------------------------------------
	CASE 62
		CALL EVENT_MESSAGE
		IF (CFLAG:605 < 1 || FLAG:7 == 2)
			;隷ＮＴＲ
			PRINTFORML 
			CFLAG:605 = 1
		ENDIF
		;-------------------------------------------------
		;;上司イベント（預けた場合の夜イベント）
		;;恋慕・親愛キャラのみ（ＮＴＲ状態の場合はダメ）
		;-------------------------------------------------
;	CASE 64
;		CALL EVENT_MESSAGE
;		;処女
;		IF TALENT:처녀
;			PRINTFORML 
;		;初回通常
;		ELSEIF CFLAG:상사이벤트진행도 == 1
;				PRINTFORML 
;		;第二段階
;		ELSEIF CFLAG:상사이벤트진행도 == 2
;			;発情中
;			IF (위험일()) == 2
;				PRINTFORML 
;			;위험일
;			ELSEIF (위험일()) == 1
;				PRINTFORML 
;			;通常
;			ELSE
;				PRINTFORML 
;			ENDIF
;		;第三段階:女を渡した場合の夜
;		ELSEIF CFLAG:상사이벤트진행도 <= 6 && CFLAG:상사내습 == 1
;			;発情中
;			IF (위험일()) == 2
;				PRINTFORML 
;			;위험일
;			ELSEIF (위험일()) == 1
;				PRINTFORML 
;			;通常
;			ELSE
;				PRINTFORML 
;			ENDIF
;		;第三段階:呼び出された夜
;		ELSEIF CFLAG:상사이벤트진행도 <= 6 && CFLAG:상사내습 == 2
;			;発情中
;			IF (위험일()) == 2
;				PRINTFORML 
;			;위험일
;			ELSEIF (위험일()) == 1
;				PRINTFORML 
;			;通常
;			ELSE
;				PRINTFORML 
;			ENDIF
;		;第三段階:発情一発堕ち
;		ELSEIF CFLAG:상사이벤트진행도 == 11
;			PRINTFORML 
;		;最終段階
;		;耐え切る：愛は奇跡だから低確率
;		ELSEIF CFLAG:상사이벤트진행도 == 7
;			PRINTFORML 
;		;堕ちる：現実は厳しい？
;		ELSEIF CFLAG:상사이벤트진행도 == 8
;			PRINTFORML 
;		ENDIF

	CASEELSE
		SIF FLAG:6 > 0
			CALL EVENT_MESSAGE
ENDSELECT
