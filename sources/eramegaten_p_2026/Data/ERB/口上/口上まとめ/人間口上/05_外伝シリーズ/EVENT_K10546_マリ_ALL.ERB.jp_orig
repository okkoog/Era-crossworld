;-------------------------------------------------
;81,펠라치오
;-------------------------------------------------
	CASE 81
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:345 == 0
			PRINTFORML そそり立った肉棒を鼻先に突きつけると、%CALLNAME%は仰け反って後ずさった
			PRINTFORMW 「そ、それ、咥えろと言うの……？」
			PRINTFORML 頷くと、%CALLNAME%はごくりと唾を飲み、覚悟を決めて逸物を手に取った
			PRINTFORMW 「……オキシドールで消毒しちゃダメ？」
			PRINTFORMW ダメです
			PRINTFORMW %CALLNAME%が拷問染みた事を始める前に、%CALLNAME:MASTER%はその口腔に陰茎を捻じ込んだ
			CFLAG:345 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落() && (CFLAG:345 < 4 || FLAG:7 == 2)
				;淫乱、娼婦、淫乱スイッチＯＮ
				IF 음란() || CFLAG:800 == 1
					IF RAND:2 == 0
						PRINTFORML 「先生をたぁくさん泣かせてくれた悪い子にお仕置き%ハート()%」
						PRINTFORMW %CALLNAME%は肉棒を口一杯に咥えると、舌、歯、唇、頬の裏側、さらには喉まで駆使して巧みな奉仕を行った
						PRINTFORML 「ぷはっ……どう、先生のお仕置きの味は？」
						PRINTFORML 「……まだまだ反省してないみたいね、もっとお仕置きしてあげるわ%ハート()%」
						PRINTFORMW %CALLNAME%は聖母のような柔和な顔に娼婦のような笑みを浮かべると、最早淫穴と化した口を大きく開けた
					ELSE
						PRINTFORML 「ねぇ、ミルク飲ませて、カルシウムたっぷりのミルクぅ%ハート()%」
						PRINTFORMW %CALLNAME%は肉棒を舐り上げながら、精液を催促する
						PRINTFORMW ……先生、そこから出る物は蛋白質です
					ENDIF
				;恋慕、親愛
				ELSEIF 연모()
					IF RAND:2 == 0
						PRINTFORML 「きれいきれいしましょうねー%ハート()%」
						PRINTFORMW 逸物を両手で捧げもった%CALLNAME%は、舌を伸ばして亀頭を丹念に舐め清める
						PRINTFORML 「れろ……んちゅ……ちゅる……」
						PRINTFORMW 切っ先の鈴口やエラの下まで熱心に奉仕している
					ELSE
						PRINTFORML 「お口でするの、そんなに気に入ったの？」
						PRINTFORMW %CALLNAME%は目尻を下げて微笑むと、%CALLNAME:MASTER%の陰茎を愛しげに舐め始めた
					ENDIF
				;服従、隷属
				ELSEIF 복종()
					PRINTFORML 
				ENDIF
				CFLAG:345 = 4
			;屈服刻印Lv3
			ELSEIF MARK:굴복각인 == 3 && (CFLAG:345 < 3 || FLAG:7 == 2)
			IF RAND:2 == 0
				PRINTFORMW 「凄い、男の子の臭いがこんなに……」
			ELSE
				PRINTFORML 「んっ、んっ、んっ……」
				PRINTFORMW %CALLNAME%は大人しく%CALLNAME:MASTER%の逸物を咥え続けている
			ENDIF
				CFLAG:345 = 3
			;それ以外
			ELSEIF CFLAG:345 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORML 「せめて、きちんと洗ってきてください……」
					PRINTFORMW 肉棒を咥えさせられた%CALLNAME%は顔をしかめている
				ELSE
					PRINTFORML 「んちゅ……むぐ……、ま、まだですか？」
					PRINTFORMW 音を上げる%CALLNAME%に再度肉棒を押し付け、奉仕を続けさせた
				ENDIF
				CFLAG:345 = 2
			ENDIF
		ENDIF

