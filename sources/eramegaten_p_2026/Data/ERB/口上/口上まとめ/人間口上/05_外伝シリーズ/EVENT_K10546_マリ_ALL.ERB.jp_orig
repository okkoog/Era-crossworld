;-------------------------------------------------
;183,비디오카메라,
;-------------------------------------------------
	CASE 183
		IF TEQUIP:비디오카메라
			CALL TRAIN_MESSAGE
			;初めて
			IF CFLAG:395 == 0
				PRINTFORML 「な、なんですか、そのカメラ！？」
				PRINTFORML 「録画して売るって……ダメ、ダメですっ！　そんなの！」
				PRINTFORMW 顔を真っ赤にして喚く顔もしっかりと撮影しておこう
				CFLAG:395 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF 陥落() && (CFLAG:395 < 4 || FLAG:7 == 2)
					;淫乱、娼婦、淫乱スイッチＯＮ
					IF 음란() || CFLAG:800 == 1
						IF RAND:2 == 0
							PRINTFORML 「はぁい画面の前のみんなー、マリ先生の保健の時間の始まりよー%ハート()%」
							PRINTFORMW 「今日の授業もしっかりばっちり見てくださいねー%ハート()%」
							PRINTFORMW なんだかノリノリでカメラにアピールしている
						ELSE
							PRINTFORML 「あ、撮っちゃうんだ、%CSTR:일인칭%のやらしい所……」
							IF HAVE_PENIS(MASTER)
								PRINTFORML 「いやらしい顔して浅ましく%CALLNAME:MASTER%クンのおちんちん咥え込んじゃってる所、全部撮っちゃうんだ……」
							ELSE
								PRINTFORML 「いやらしい顔して浅ましくおちんちん咥え込んじゃってる所、全部撮っちゃうんだ……」
							ENDIF
							PRINTFORMW 「あまつさえそれを知らない人に売り飛ばしちゃうんだ……」
							PRINTFORML 「……やぁん%ハート()%」
							PRINTFORMW 何か妙なスイッチが入ったのか、%CALLNAME%は真っ赤に染まった頬を両手で押さえながらニヤニヤしている
						ENDIF
					;恋慕、親愛
					ELSEIF 연모()
						PRINTFORMW 「ほ、他の人に見せたり売ったりしたらダメですからね！」
						PRINTFORMW 「……先生のあんな姿を見ていいのは%CALLNAME:MASTER%クンだけなんだから……%ハート()%」
					;服従、隷属
					ELSEIF 복종()
						PRINTFORMW 
					ENDIF
					CFLAG:395 = 4
				;屈服刻印Lv3
				ELSEIF MARK:굴복각인 == 3 && (CFLAG:395 < 3 || FLAG:7 == 2)
					PRINTFORMW %CALLNAME%は撮影中のカメラをちらりと見ると、諦めたかのように目を伏せた
					CFLAG:395 = 3
				;それ以外
				ELSEIF CFLAG:395 < 2 || FLAG:7 == 2
					PRINTFORMW 「うぅ……酷い……」
					CFLAG:395 = 2
				ENDIF
			ENDIF
		ELSE
			IF CFLAG:395 == 1 || FLAG:7 == 2
				CALL TRAIN_MESSAGE
				PRINTFORMW 
			ENDIF
		ENDIF

