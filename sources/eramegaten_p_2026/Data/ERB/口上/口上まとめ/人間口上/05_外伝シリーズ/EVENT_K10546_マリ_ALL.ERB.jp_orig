	ELSEIF MARK:굴복각인 == 3 && (CFLAG:249 < 2 || FLAG:7 == 2)
		PRINTFORML 
		CFLAG:249 = 2
	;それ以外
	ELSEIF CFLAG:249 < 1 || FLAG:7 == 2
		PRINTFORML 
		CFLAG:249 = 1
	ENDIF
ENDIF

