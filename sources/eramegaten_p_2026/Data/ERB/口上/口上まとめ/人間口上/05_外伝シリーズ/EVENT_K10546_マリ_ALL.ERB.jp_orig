;=================================================
;ハードな調教コマンド
;=================================================
;-------------------------------------------------
;140,이라마치오
;-------------------------------------------------
	CASE 140
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:369 == 0
			PRINTFORMW 「んぐっ！？　んっ、ぐっ、んぶぅぅっ！？」
			CFLAG:369 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落() && (CFLAG:369 < 4 || FLAG:7 == 2)
				;淫乱、娼婦、淫乱スイッチＯＮ
				IF 음란() || CFLAG:800 == 1
					IF RAND:2 == 0
						PRINTFORML 「あぶっ、んぶっ、ぐぶっ、んんっ……」
					ELSE
						PRINTFORML （こんな太いので、乱暴に喉まで使われて…%ハート()%）
					ENDIF
					PRINTFORMW 荒々しく口を使われながらも%CALLNAME%の瞳は獣欲に彩られ、一層激しい行為を期待している
				;恋慕、親愛
				ELSEIF 연모()
					PRINTFORML 「んっ、ぐっ、あぐっ、ぐぶぅっ」
					PRINTFORML 荒っぽく%CALLNAME%の口を犯す
					PRINTFORMW オナホ扱いされながらも%CALLNAME%の瞳は優しげに細められ、%CALLNAME:MASTER%の蛮行を受け入れていた
				;服従、隷属
				ELSEIF 복종()
					IF RAND:2 == 0
						PRINTFORML 「あぶっ、んぶっ、ぐぶっ、んんっ……」
					ELSE
						PRINTFORML （こんな太いので、乱暴に喉まで犯してもらって…%ハート()%）
					ENDIF
					PRINTFORMW 荒々しく口を使われながらも%CALLNAME%の瞳は妖しく濡れ、一層激しい行為を期待している
				ENDIF
				CFLAG:369 = 4
			;屈服刻印Lv3
			ELSEIF MARK:굴복각인 == 3 && (CFLAG:369 < 3 || FLAG:7 == 2)
				PRINTFORML 「ら、乱暴は嫌です……んぐっ！？」
				PRINTFORMW 「んんっ！　んっ、んむぅっ！」
				CFLAG:369 = 3
			;それ以外
			ELSEIF CFLAG:369 < 2 || FLAG:7 == 2
				PRINTFORML 「い、嫌……むぐぅっ！？」
				PRINTFORMW 「んっ！？　ぐむぅっ！？　んんんーーーーっ！！！」
				CFLAG:369 = 2
			ENDIF
		ENDIF

