;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_D関係（X1をキャラ番号に置換）
;パラメータ変化をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_D_K[[キャラ:마리]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_D
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_D_PY1_K[[キャラ:마리]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_D_PY1_K[[キャラ:마리]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;パラメータ変化時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;初めて潤滑がLV3超えた
;-------------------------------------------------
P = PALAM:4 + UP:4
IF P > PALAMLV:4 && CFLAG:250 == 0
	CALL PALAM_MESSAGE_D
	;ローションを使った場合
	IF SELECTCOM == 180
		PRINTFORML 「な、何これ、ローション？」
		PRINTFORMW 「化粧水なら歓迎だけど、これはちょっと……」
	;それ以外
	ELSE
		PRINTFORMW （やだ、%CSTR:일인칭%、濡れてる……）
	ENDIF
	CFLAG:250 = 1
ENDIF

;-------------------------------------------------
;初めて欲情がLV2超えた
;-------------------------------------------------
P = PALAM:6 + UP:6
IF P > PALAMLV:3 && CFLAG:251 == 0
	CALL PALAM_MESSAGE_D
	;媚薬を使った場合
	IF SELECTCOM == 181
		PRINTFORMW 「く……常習性のある薬物じゃないでしょうね」
	;それ以外
	ELSE
		PRINTFORMW 「き、気持ちよくなんかなってません！」
	ENDIF
	CFLAG:251 = 1
ENDIF

;-------------------------------------------------
;初めて屈服がLV3超えた
;-------------------------------------------------
P = PALAM:7 + UP:7
IF P > PALAMLV:3 && CFLAG:252 == 0
	CALL PALAM_MESSAGE_D
	PRINTFORML （もうダメ……この人には逆らえないわ……）
	PRINTFORMW （ごめんなさいタダシくん、%CSTR:일인칭%、あなたのお兄さんの事を忘れちゃいそう……）
	CFLAG:252 = 1
ENDIF

;-------------------------------------------------
;初めて恭順がLV3超えた
;-------------------------------------------------
P = PALAM:5 + UP:5
IF P > PALAMLV:3 && CFLAG:253 == 0
	CALL PALAM_MESSAGE_D
	;陥落済み
	IF 陥落()
		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORML （……あの人よりも、この人の方が%CSTR:일인칭%の中で大きくなってきてる……）
		PRINTFORMW %CALLNAME%は亡き恋人の面影が胸の中で薄れていくことを自覚していた
	ENDIF
	CFLAG:253 = 1
ENDIF

;-------------------------------------------------
;初めて恐怖がLV3超えた
;-------------------------------------------------
P = PALAM:11 + UP:11
IF P > PALAMLV:3 && CFLAG:254 == 0
	CALL PALAM_MESSAGE_D
	;陥落済み
	IF 陥落()
		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORMW （こ、今度は何をされるの……%CSTR:일인칭%、一体どうなっちゃうの……）
	ENDIF
	CFLAG:254 = 1
ENDIF


;-------------------------------------------------
;@KOJO_MESSAGE_MARKCNG関係（X1をキャラ番号に置換）
;刻印変動をトリガーにした口上
;刻印変動後に口上を発動します
;-------------------------------------------------
@KOJO_MESSAGE_MARKCNG_K[[キャラ:마리]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL MARK_MESSAGE
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_MARKCNG_PY1_K[[キャラ:마리]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_MARKCNG_PY1_K[[キャラ:마리]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;苦痛刻印Lv3
;-------------------------------------------------
IF TFLAG:22 == 3
	CALL MARK_MESSAGE_A
	;恋慕、親愛
	IF 연모()
		PRINTFORML 「あああっ！？」
		PRINTFORMW 耐え難い苦痛に悲鳴をあげながらも、%CALLNAME%は必死で微笑もうとしてる
		PRINTFORML 「な、何か、お仕置きされなきゃいけない事、しちゃった？」
		PRINTFORMW 「悪い所は直すから、また可愛がって……」
	;淫乱、娼婦
	ELSEIF 음란()
		PRINTFORML 
	;服従、隷属
	ELSEIF 복종()
		PRINTFORML
	ELSE
		PRINTFORML 「いやぁぁぁっ！？　痛い痛いぃっ！」
		PRINTFORMW 強烈な責め苦の前に、%CALLNAME%は身も世もない泣き声をあげ苦悶した
	ENDIF
ENDIF

;-------------------------------------------------
;快楽刻印Lv3
;-------------------------------------------------
IF TFLAG:23 == 3
	CALL MARK_MESSAGE_P
	;恋慕、親愛
	IF 연모()
		PRINTFORMW 「せ、先生、いけない事覚えちゃったみたい……%ハート()%」
	;服従、隷属
	ELSEIF 복종()
		PRINTFORML 
	ELSE
		PRINTFORML （こんなになっちゃうなんて……）
		PRINTFORML （%CSTR:일인칭%、どれだけイっちゃったのかしら……）
		PRINTFORMW （……もっと、欲しい……）
	ENDIF
ENDIF

;-------------------------------------------------
;屈服刻印Lv3
;-------------------------------------------------
IF TFLAG:24 == 13 || TFLAG:24 == 23 || TFLAG:24 == 33
	CALL MARK_MESSAGE_S
	;快楽による屈服
	IF TFLAG:24 == 13
		PRINTFORML 「もっと、もっとして、もっと気持ちよくしてぇ……」
		PRINTFORML 「凄いのぉ……%ハート()%」
		PRINTFORMW 激しい快楽に理性を焼かれた%CALLNAME%は上気した顔でうわ言のように呟いている
	;恐怖と苦痛による屈服
	ELSEIF TFLAG:24 == 23
		PRINTFORML 「ごめんなさいっ、もう痛いのは嫌ですっ、許してぇっ」
		PRINTFORMW 激しい苦痛に%CALLNAME%は幼児のように泣きながら這いつくばった
	;屈服と恭順による屈服
	ELSEIF TFLAG:24 == 33
		PRINTFORML 「……悪魔を使うくらいだから、そういう能力もあるのかしら」
		PRINTFORML 「魔眼とか、誘惑とか……」
		PRINTFORMW 「%CSTR:일인칭%にそういう力を使ったの？」
		PRINTFORMW %CALLNAME%は変えられていく己の心に戸惑っているようだ
	ENDIF
ENDIF

;-------------------------------------------------
;反発刻印Lv3
;-------------------------------------------------
IF TFLAG:21 == 3
	CALL MARK_MESSAGE_R
	;陥落済み
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		;恋慕、親愛
		IF 연모()
			PRINTFORML 「いくらなんでもやりすぎよ」
			PRINTFORMW 「ちょっと折檻が必要みたいね」
			PRINTFORMW %CALLNAME%は垂れ目を吊り上げて内心の激怒を顕にしている
		;淫乱、娼婦
		ELSEIF 음란()
			PRINTFORML 
		;服従、隷属
		ELSEIF 복종()
			PRINTFORML 
		ENDIF
	ELSE
		PRINTFORML 「……絶対許さない」
		PRINTFORML 「必ず、思い知らせてやるから」
		PRINTFORMW %CALLNAME%は普段の柔和な雰囲気からは想像もつかないような剣呑な気配を漂わせている
	ENDIF
ENDIF

