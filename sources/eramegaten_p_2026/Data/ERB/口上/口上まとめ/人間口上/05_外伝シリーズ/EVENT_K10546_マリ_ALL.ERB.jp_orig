				IF RAND:3 == 0
					PRINTFORML 「ふぁ……」
					PRINTFORMW 長く唇を吸ってから離すと、%CALLNAME%は呆けたような顔で息継ぎをした
				ELSEIF RAND:2 == 0
					PRINTFORML 「ん……んん……」
					PRINTFORMW 観念したのか、%CALLNAME%は%CALLNAME:MASTER%の唇を大人しく受け入れている
				ELSE
					PRINTFORML 「ん……！」
					PRINTFORMW 「し、舌を入れるのは……」
				ENDIF
				CFLAG:312 = 3
