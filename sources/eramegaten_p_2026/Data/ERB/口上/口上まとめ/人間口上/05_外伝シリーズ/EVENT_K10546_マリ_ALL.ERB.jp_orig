;-------------------------------------------------
;74,역강간당한다
;-------------------------------------------------
	CASE 74
		;初めて
		IF CFLAG:438 == 0
			IF TALENT:처녀
				;陥落済み
				IF 陥落()
					;淫乱、娼婦、淫乱スイッチＯＮ
					IF 음란() || CFLAG:800 == 1
						;助手が相手をしている
						IF CFLAG:800 == 1 && ASSI > 0 && ASSIPLAY
							SIF TEQUIP:비디오카메라
								PRINTFORML 「後でビデオを見返して後悔するかもしれないけどぉ」

							IF TALENT:아내
								PRINTFORML 「いまから夫以外のおちんちんでバージン卒業しちゃいま～す%ハート()%」
							ELSE
								PRINTFORML 「彼氏の前で別のおちんちんでバージン卒業しちゃいま～す%ハート()%」
							ENDIF
							CALL TRAIN_MESSAGE
							PRINTFORML 
							PRINTFORML 「ほら、未使用のおまんこでしょ♪」
							PRINTFORMW 「卵子も未使用ですから使っちゃいましょうね%ハート()%」
						;淫乱スイッチの入ったマリを主人公が相手
						ELSEIF CFLAG:800 == 1
							SIF TEQUIP:비디오카메라
								PRINTFORML 「ビデオを見てるひと～」
							IF TALENT:아내
								PRINTFORML 「いまから夫を襲って初体験、しちゃいますね%ハート(3)%」
							ELSE
								PRINTFORML 「いまから彼氏を押し倒して初体験、しちゃいますね%ハート()%」
							ENDIF
							CALL TRAIN_MESSAGE
							PRINTFORML 
							PRINTFORML 「ほら、初めてのキツキツおまんこ、イイでしょ♪」
							PRINTFORMW 「沢山出すまで放しませんからね%ハート()%」
						;淫乱のマリを相手
						ELSE
							SIF TEQUIP:비디오카메라
								PRINTFORML 「ビデオを見てるひと～」
							PRINTFORML 「いまから逆レイプでバージン卒業、しちゃいま～す%ハート()%」
							CALL TRAIN_MESSAGE
						ENDIF
					;恋慕、親愛
					ELSEIF 연모()
						CALL TRAIN_MESSAGE
					;服従、隷属
					ELSEIF 복종()
						CALL TRAIN_MESSAGE
					ENDIF
				ELSE
					CALL TRAIN_MESSAGE
				ENDIF
			;非処女
			ELSE
				;陥落済み
				IF 陥落()

				ELSE

				ENDIF
				CALL TRAIN_MESSAGE

			ENDIF
			CFLAG:438 = 1
		;二回目以降
		ELSE
			CALL TRAIN_MESSAGE
			;陥落済み
			IF 陥落()
				;淫乱、娼婦、淫乱スイッチＯＮ
				IF 음란() || CFLAG:800 == 1
					;淫乱スイッチの入ったマリを助手が相手をしている
					IF CFLAG:800 == 1 && ASSI > 0 && ASSIPLAY
						IF RAND:2 == 0
							IF TALENT:임신
								PRINTFORML 「沢山射精していいんです♪」
								PRINTFORML 「あなたの赤ちゃん、産んであげますから%ハート()%」
							ELSE
								PRINTFORML 「我慢しなくてもいいんですよ」
								PRINTFORML 「公認の浮気セックスですから♪」
							ENDIF
							PRINTFORMW %CALLNAME%は%CALLNAME:ASSI%の耳元で妖しく囁いている
						ELSE
							PRINTFORML 「%CSTR:이인칭%♪　これはセックスじゃないですよ%ハート()%」
							PRINTFORML 「ディルドです♪　ディルドですから%ハート()%」
							PRINTFORMW %CALLNAME%は笑いながら『ディルド』の上で腰を振っている
						ENDIF
					ELSEIF RAND:2 == 0
						PRINTFORML 「どうですか？」
						PRINTFORMW 「女性に主導権握られてセックスするの♪」
					ELSE
						PRINTFORML 「ほら、ほら♪」
						PRINTFORMW 「早くぴゅ～ぴゅ～、しちゃいましょうね♪」
					ENDIF
				;恋慕、親愛
				ELSEIF 연모()
					PRINTFORML 
				;服従、隷属
				ELSEIF 복종()
					PRINTFORML 
				ENDIF
				CFLAG:438 = 4
			;屈服刻印Lv3
			ELSEIF MARK:굴복각인 == 3 && (CFLAG:438 < 3 || FLAG:7 == 2)
				PRINTFORML 
				CFLAG:438 = 3
			;それ以外
			ELSEIF CFLAG:438 < 2 || FLAG:7 == 2
				PRINTFORML 
				CFLAG:438 = 2
			ENDIF
		ENDIF


