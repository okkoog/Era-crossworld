;-------------------------------------------------
;201,윤간
;-------------------------------------------------
	CASE 201
		;初めて
		IF CFLAG:434 == 0
			;処女
			IF TALENT:처녀
				;淫乱、娼婦、淫乱スイッチＯＮ
				IF 음란() || CFLAG:800 == 1
					PRINTFORML 「この人数を相手にしていいの%ハート()%」
					CALL TRAIN_MESSAGE
					PRINTFORML 「ロストバージンがこんなのって最高♪」
					PRINTFORML 「誰の精液で妊娠しちゃうかしら%ハート()%」
				;恋慕、親愛
				ELSEIF 연모()
					IF TALENT:아내
						PRINTFORML 『ヒュ～♪』
						PRINTFORML 『自分の妻を輪姦していいだなんて、アンタサイコーだよ♪』
						PRINTFORML 『しかも、まだ処女だってよ！』
						PRINTFORMW 『もしかしてＮＴＲ趣味？』
						PRINTFORML 
						PRINTFORML 『『『『ゴチになりま～す』』』』
					ELSE
						PRINTFORML 『こんな上玉、輪姦してＯＫなんてよぉ』
						PRINTFORML 『おいおい、この女、処女とかマジ！？』
						PRINTFORMW 『彼女にこんな事するか、フツー』
						PRINTFORML 
						PRINTFORML 『『『『ゴチになりま～す』』』』
					ENDIF
					CALL TRAIN_MESSAGE
					PRINTFORML  
					PRINTFORML 「%CSTR:일인칭%の初めての相手は……%CSTR:이인칭%と決めていたのに……」
					PRINTFORMW 「どうして……」
				;服従、隷属
				ELSEIF 복종()
					CALL TRAIN_MESSAGE
					PRINTFORML 
				ENDIF
			;それ以外
			ELSE
				CALL TRAIN_MESSAGE
				;陥落済み
				IF 陥落() && (CFLAG:434 < 4 || FLAG:7 == 2)
					PRINTFORML 「休みなくおちんちん挿れられ、咥えされられ…」
					PRINTFORMW 「穴がガバガバになって、精液入りきらなくて逆流して……」

					;淫乱、娼婦、淫乱スイッチＯＮ
					IF 음란() || CFLAG:800 == 1
						;組織の精液便所の経験あり
						IF CFLAG:이벤트가입 > 0
							PRINTFORML 「やっぱり輪姦されるのって凄いわ……%ハート()%」
							PRINTFORMW 「人を呼んでもう一回…シましょ……%ハート(3)%」
						ELSE
							PRINTFORML 「こんな経験初めて……」
							PRINTFORMW 「これ、病みつきになりそう…%ハート()%」
						ENDIF
					;恋慕、親愛
					ELSEIF 연모()
						;組織の精液便所の経験あり
						IF CFLAG:이벤트가입 > 0
							PRINTFORML 「%CSTR:이인칭%があんな所から助け出してくれたから」
							PRINTFORML 「こんな事、二度とされないと思ったのに……」
							PRINTFORMW 「ねぇ、どうしてこんな……」
						ELSE
							PRINTFORML 「どうして、こんな事するの……」
							PRINTFORMW 「ねぇ……%CSTR:이인칭%……」
						ENDIF
					;服従、隷属
					ELSEIF 복종()
						PRINTFORML 
					ENDIF
				ELSE
					;組織の精液便所の経験あり
					IF CFLAG:이벤트가입 > 0
						PRINTFORMW 「どうして、またこんな目に会うの……」
					ELSE
						PRINTFORMW 「どうして、こんな事するの……」
					ENDIF
				ENDIF
			ENDIF
			CFLAG:434 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落() && (CFLAG:434 < 4 || FLAG:7 == 2)
				;淫乱、娼婦、淫乱スイッチＯＮ
				IF 음란() || CFLAG:800 == 1
					PRINTFORML 「よろしく～♪」
					CALL TRAIN_MESSAGE
					IF RAND:2 == 0
						PRINTFORML 「あ～♪　ハメすぎて腰がぬけてるわ%ハート()%」
					ELSE
						PRINTFORML 「ミックスされたザーメンの匂い…」
						PRINTFORML 「普通のセックスでは味わえないわ%ハート()%」
					ENDIF
				;恋慕、親愛
				ELSEIF 연모()
					CALL TRAIN_MESSAGE
				;服従、隷属
				ELSEIF 복종()
					CALL TRAIN_MESSAGE
				ENDIF

				CFLAG:434 = 4
			;屈服刻印Lv3
			ELSEIF MARK:굴복각인 == 3 && (CFLAG:434 < 3 || FLAG:7 == 2)
				CALL TRAIN_MESSAGE
				CFLAG:434 = 3
			;それ以外
			ELSEIF CFLAG:434 < 2 || FLAG:7 == 2
				CALL TRAIN_MESSAGE
				CFLAG:434 = 2
			ENDIF
		ENDIF


