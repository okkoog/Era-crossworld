;=================================================
;SM系コマンド
;=================================================
;-------------------------------------------------
;100,스팽킹
;-------------------------------------------------
	CASE 100
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:354 == 0
			PRINTFORMW 「や、やめてっ！　ひぃぃっ！」
			CFLAG:354 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落() && (CFLAG:354 < 4 || FLAG:7 == 2)
				;淫乱、娼婦、淫乱スイッチＯＮ
				IF 음란() || CFLAG:800 == 1
					IF ABL:마조끼 >= 3
						PRINTFORML 「あうっ、も、もっとぶってぇ%ハート()%」
						PRINTFORML 「%CSTR:일인칭%、先生なのにお尻叩かれて感じちゃう、いけない先生なのっ！」
						PRINTFORML 「こんなダメな先生にもっとお仕置きしてぇっ！」
						PRINTFORMW 変態的な性癖を告白した%CALLNAME%は腫れ上がった尻を突き上げて、更なる仕置きをねだった
					;それ以外
					ELSE
						PRINTFORMW 「あぁんっ！　あひぃっ！　ちょっと、ひどいじゃないの、ひぃぃぃっ！」
					ENDIF
				;恋慕、親愛
				ELSEIF 연모()
					IF ABL:마조끼 >= 3
						PRINTFORML 「あっ、ひっ、くぅぅっ！」
						PRINTFORML 「も、もっと、もっと先生にお仕置きしてくださいっ%ハート()%」
						PRINTFORMW %CALLNAME%は赤く腫れ上がった尻を振って、更なる仕置きをねだった
					;それ以外
					ELSE
						PRINTFORMW 「くっ、い、痛いっ！　もうやめてぇっ！」
					ENDIF
				;服従、隷属
				ELSEIF 복종()
					PRINTFORMW 
				ENDIF
				CFLAG:354 = 4
			;屈服刻印Lv3
			ELSEIF MARK:굴복각인 == 3 && (CFLAG:354 < 3 || FLAG:7 == 2)
				PRINTFORML 「た、叩かないでぇ……」
				PRINTFORMW 涙目の%CALLNAME%は真っ赤に腫れ上がった尻を庇うように後ずさった
				CFLAG:354 = 3
			;それ以外
			ELSEIF CFLAG:354 < 2 || FLAG:7 == 2
				PRINTFORML 「う、うぅ……」
				PRINTFORMW 子供にするような尻叩きを受け、%CALLNAME%は涙目で唇を噛んでいる
				CFLAG:354 = 2
			ENDIF
		ENDIF

