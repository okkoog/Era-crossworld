					PRINTFORMW %CALLNAME%自身の体重で%CALLNAME:MASTER%の肉杭はその胎内深くにまで差し込まれてしまっていた
					PRINTFORML 「こ、こんなの、ひどいっ……」
					PRINTFORMW 何の感慨も情緒もなく、想い人でもない相手にだまし討ちのような形で処女を奪われてしまった%CALLNAME%は唇を震わせ、咽び泣いた
					PRINTFORML %CALLNAME:MASTER%は涙を零す%CALLNAME%の腰を両手でホールドすると、容赦なく下から突き上げる
					PRINTFORML これは愛の行為ではなく、調教だ
					PRINTFORMW %CALLNAME:MASTER%は女になったばかりの処女肉を雌穴に仕上げるべく腰の動きを早めた
				ENDIF
			;それ以外
			ELSE
				;恋慕、親愛
				IF 연모()
					PRINTFORML 「先生が上になるのね？」
					PRINTFORMW 「いいわよ、たくさん可愛がってあげるんだから%ハート()%」
					PRINTFORMW 主導権を与えられた%CALLNAME%は嬉しそうに微笑んだ
				;淫乱、娼婦
				ELSEIF 음란()
					PRINTFORML 「先生が上になるのね？」
					PRINTFORMW 「いいわよ、たくさん泣かせてあげるんだから%ハート()%」
					PRINTFORMW 主導権を与えられた%CALLNAME%は淫蕩に微笑んだ
				;服従、隷属
				ELSEIF 복종()
					PRINTFORML 
				ELSE
					PRINTFORML 
				ENDIF
			ENDIF
			CFLAG:338 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落() && (CFLAG:338 < 4 || FLAG:7 == 2)
				;淫乱、娼婦、淫乱スイッチＯＮ
				IF 음란() || CFLAG:800 == 1
					IF PALAM:욕정 > 50000
						;助手が相手をしている
						IF ASSI > 0 && ASSIPLAY
							IF RAND:2 == 0
								PRINTFORML 「あぁぁっ%ハート()%　馬鹿になっちゃうっ%ハート()%」
								PRINTFORML 「%CSTR:일인칭%、おちんちんの事しか考えられない馬鹿にされちゃうぅっ%ハート()%」
								PRINTFORMW 普段の知的な印象をかなぐり捨てた%CALLNAME%は%CALLNAME:ASSI%の肉棒でケダモノと化して悶え狂った
							ELSE
								PRINTFORML 「もっと突き上げてっ%ハート()%」
								PRINTFORML 「%CSTR:일인칭%のおまんこっ%ハート()%　下からおちんちんで串刺しにするのっ%ハート()%」
								PRINTFORML 「ほら、もっと、もっとぉっ%ハート(3)%」
								PRINTFORMW %CALLNAME%は激しく腰を上下させながら、発情しきった表情で%CALLNAME:ASSI%の顔を見下ろして更なる奉仕を要求した
							ENDIF
						ELSE
							IF RAND:2 == 0
								PRINTFORML 「あぁぁっ%ハート()%　馬鹿になっちゃうっ%ハート()%　先生っ%CALLNAME:MASTER%クンのおちんちんで馬鹿にされちゃうぅっ%ハート()%」
								PRINTFORMW 普段の知的な印象をかなぐり捨てた%CALLNAME%は%CALLNAME:MASTER%の肉棒でケダモノと化して悶え狂った
							ELSE
								PRINTFORML 「もっと突き上げてっ%ハート()%　先生のおまんこ、下から串刺しにするのっ%ハート()%　ほら、もっと、もっとぉっ%ハート(3)%」
								PRINTFORMW %CALLNAME%は激しく腰を上下させながら、発情しきった表情で%CALLNAME:MASTER%の顔を見下ろして更なる奉仕を要求した
							ENDIF
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORML 「んっ%ハート()%　うんっ%ハート()%　ふふっ、先生の中、いいでしょう%ハート()%」
							PRINTFORMW %CALLNAME:PLAYER%の上で腰を振りながら、%CALLNAME%は甘く囁いた
							
						ELSE
							PRINTFORML 「あっ%ハート()%　あんっ%ハート()%　だめぇっ%ハート()%」
							PRINTFORML 「先生、雌になっちゃう、ケダモノになっちゃうぅ%ハート()%」
							PRINTFORMW %CALLNAME:PLAYER%の上で激しく腰を蠢かせながら%CALLNAME%はうわ言のような喘ぎを漏らした
						ENDIF
					ENDIF
				;恋慕、親愛
				ELSEIF 연모()
					IF PALAM:욕정 > 50000
						IF RAND:2 == 0
							PRINTFORML 「ふっ%ハート()%　ふぁんっ%ハート()%　あぅぅんっ%ハート(3)%」
							PRINTFORML 甘い声をあげながら、瞳を閉じた%CALLNAME%は激しく腰を上下に揺すっている
							PRINTFORMW 忘我の境地に至った%CALLNAME%は豊かな乳房を大きく弾ませながら、更なる快楽を引き出そうと膣壁を蠕動させた
						ELSE
							PRINTFORML 「あぁっ%ハート()%　好きっ%ハート()%　%CALLNAME:MASTER%クンも、%CALLNAME:MASTER%クンのおちんちんも、好きぃっ%ハート()%」
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORML 「ふふっ%ハート()%　%CALLNAME:MASTER%クンのおちんちん食べちゃったぁ%ハート()%」
							PRINTFORMW %CALLNAME%は%CALLNAME:MASTER%の肉棒を咥え込んでご満悦だ
						ELSE
							PRINTFORML 「たくさん気持ちよくしてあげますからね%ハート()%」
							PRINTFORMW %CALLNAME%は%CALLNAME:MASTER%の耳元で甘く囁くと、ゆっくりと腰を上下させ始めた
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF 복종()
					PRINTFORML 
				ENDIF
				CFLAG:338 = 4
			;屈服刻印Lv3
			ELSEIF MARK:굴복각인 == 3 && (CFLAG:338 < 3 || FLAG:7 == 2)
				IF RAND:2 == 0
					PRINTFORML 「こんなの、はしたないわ……」
					PRINTFORMW 難色を示しながらも%CALLNAME%は従順に%CALLNAME:MASTER%の陰茎に跨った
					PRINTFORMW 「んっ……こ、この姿勢だと、奥までぇ……%ハート()%」
				ELSE
					PRINTFORML 「う、動きます……」
					PRINTFORMW %CALLNAME:MASTER%の腰に跨り、逸物を呑み込んだ%CALLNAME%はおずおずとした動きで腰を振る
					PRINTFORML 物足りない
					PRINTFORML %CALLNAME:MASTER%は%CALLNAME%の腰を鷲掴みにすると、下から凶暴に突き上げた
					PRINTFORMW 「きゃっ、やぁぁっ！？」
				ENDIF
				CFLAG:338 = 3
			;それ以外
			ELSEIF CFLAG:338 < 2 || FLAG:7 == 2
				PRINTFORML 「うぅ、自分からなんて……」
				PRINTFORMW %CALLNAME%は屈辱に震えながらも、自ら%CALLNAME:MASTER%の肉棒を受け入れていく
				CFLAG:338 = 2
			ENDIF
		ENDIF

