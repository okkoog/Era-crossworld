;-------------------------------------------------
;11,자위
;-------------------------------------------------
	CASE 11
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:311 == 0
			PRINTFORML 「え、オ、オナニー、するの……？」
			PRINTFORMW 「わ、判ったわよ……」
			CFLAG:311 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落() && (CFLAG:311 < 4 || FLAG:7 == 2)
				;淫乱、娼婦、淫乱スイッチＯＮ
				IF 음란() || CFLAG:800 == 1
					;二穴バイブオナニー
					IF TEQUIP:바이브 == 1 && TEQUIP:애널바이브 == 1
						IF RAND:2 == 0
							PRINTFORML 「あぁぁっ%ハート()%　いいっ%ハート()%　いいっ%ハート()%　おまんこもお尻もいっぱいぃっ%ハート()%」
							PRINTFORML %CALLNAME%は涎を垂らしながら両穴に埋まったバイブを激しく動かし快楽を貪っている
							PRINTFORMW 乱れきった顔には普段の優しげな教師の面影は全くない
						ELSE
							PRINTFORML 「やっ%ハート()%　あぅんっ%ハート()%　あぁっ%ハート()%」
							PRINTFORMW %CALLNAME%は両方の穴を串刺しにしたバイブのうねりを愉しんでいる
						ENDIF
					;バイブオナニー
					ELSEIF TEQUIP:바이브 == 1
						IF HAVE_PENIS(MASTER) && RAND:3 == 0
							PRINTFORML 「あぁっ%ハート()%　こ、このバイブ、ダメっ%ハート()%　%CSTR:이인칭%のおちんぽより大きいっ%ハート()%」
							PRINTFORMW 「先生、バイブに浮気しちゃうっ%ハート()%　いいの、%CALLNAME:MASTER%クン、このままだと先生バイブの物になっちゃうわよっ%ハート()%」
						ELSEIF RAND:2 == 0
							PRINTFORML 「あぁっ%ハート()%　こ、このバイブ、ダメっ%ハート()%　おっきぃ%ハート()%」
							PRINTFORMW 「先生、バイブと結婚しちゃうっ%ハート()%　いいの、こんなセックスされたら、先生、バイブの物になっちゃうわよっ%ハート()%」
						ELSE
							PRINTFORML 「んっ%ハート()%　あふっ%ハート()%　うんっ%ハート()%」
							PRINTFORMW 瞳を閉じた%CALLNAME%は膣内を占領したバイブを小刻みに動かして堪能している
						ENDIF
					;アナルバイブオナニー
					ELSEIF TEQUIP:애널바이브 == 1
						IF RAND:2 == 0
							PRINTFORML 「あっ%ハート()%　おっ、お尻っ%ハート()%　すっかりほぐれちゃったぁっ%ハート()%」
							PRINTFORMW 尻穴に突き刺さったアナルバイブを穿る様に動かし、%CALLNAME%は嬌声をあげる
							PRINTFORML 「%CALLNAME:MASTER%クン、先生ね、最近すっかりお通じいいのよぉ%ハート()%」
							PRINTFORMW 先生、その情報は要りません
						ELSE
							PRINTFORML 「はっ%ハート()%　ひっ%ハート()%　もっと奥、どこまで入るかしら%ハート()%」
							PRINTFORMW %CALLNAME%は尻穴を串刺しにしたアナルバイブをさらに突き込み、自らの限界を試している
						ENDIF
					ELSE
						;中に射精されている
						IF TCVAR:TARGET:질내사정량 > 0
							IF RAND:2 == 0
								PRINTFORML %CALLNAME%が陰唇を弄り始めると、その内側に注ぎ込まれていた%CALLNAME:MASTER%の精液がトロリと流れ出た
								PRINTFORMW 「零れてきちゃった、%CALLNAME:MASTER%クンのザーメン%ハート()%」
								PRINTFORML %CALLNAME%は膣口に指を突き入れてひと混ぜすると、濡れそぼった指を抜き出した
								PRINTFORML 精液と愛液の混合液に塗れた指先をしげしげと観察すると、おもむろに口に入れる
								PRINTFORMW 「んっ%ハート()%　%CALLNAME:MASTER%クンと%CSTR:일인칭%のカクテル、美味しい%ハート()%」
							ELSE
								PRINTFORMW %CALLNAME%はたっぷりと注がれた%CALLNAME:MASTER%の精液を吹き零す秘裂を指で掻き回し、仰け反った
							ENDIF
						ELSE
							IF RAND:2 == 0
								PRINTFORML 「ふふっ、しっかり見てね%ハート()%」
								PRINTFORMW 嫣然と微笑んだ%CALLNAME%は股間に指を差し入れ、オナニーショーを開始した
							ELSE
								PRINTFORML %CALLNAME%は膣口に指を突き込むと、内部を引っかくように指を動かした
								PRINTFORMW 「くぅんっ%ハート()%　せ、先生のいやらしい所、ちゃんと見てる？　%CALLNAME:MASTER%クン……%ハート()%」
							ENDIF
						ENDIF
					ENDIF
				;恋慕、親愛
				ELSEIF 연모()
					;二穴バイブオナニー
					IF TEQUIP:바이브 == 1 && TEQUIP:애널바이브 == 1
						IF RAND:2 == 0
							PRINTFORML 「あっ%ハート()%　あっ%ハート()%　ダ、ダメですっ%ハート()%　こんなのっ%ハート()%」
							PRINTFORML 否定の言葉を口にしつつ、%CALLNAME%は前後の穴を占領したバイブを激しく抜き差しして快感に浸っている
							PRINTFORMW 「こんなのっ、はしたないのにぃっ%ハート()%」
						ELSE
							PRINTFORML 「はっ、激しっ%ハート()%　激しいのっ、これぇっ%ハート()%」
							PRINTFORMW %CALLNAME%は両方の穴を串刺しにしたバイブのうねりに翻弄されている
						ENDIF
					;バイブオナニー
					ELSEIF TEQUIP:바이브 == 1
						IF RAND:2 == 0
							PRINTFORML 「あぁっ%ハート()%　こ、このバイブ、ダメっ%ハート()%　%CSTR:이인칭%のより大きいっ%ハート()%」
							PRINTFORMW 「先生、バイブに浮気しちゃいそうっ%ハート()%　早く%CALLNAME:MASTER%クンので躾け直してっ%ハート()%」
						ELSE
							PRINTFORML 「自分で好きなように刺激できるのはメリットだけど……」
							PRINTFORMW %CALLNAME%は流し目を%CALLNAME:MASTER%に向けた
							PRINTFORMW 「やっぱり、愛しい人に愛されたいな%ハート()%」
						ENDIF
					;アナルバイブオナニー
					ELSEIF TEQUIP:애널바이브 == 1
						IF RAND:2 == 0
							PRINTFORML 「おっ、お尻っ%ハート()%　排泄器官でこんな事させられるなんてっ%ハート()%」
							PRINTFORMW 否定的な言葉だったが、尻穴を抉るアナルバイブの振動は%CALLNAME%の声をすっかり甘くしていた
						ELSE
							PRINTFORML 「はっ%ハート()%　ひっ%ハート()%　もっと奥、どこまで入るかしら%ハート()%」
							PRINTFORMW %CALLNAME%は尻穴を串刺しにしたアナルバイブをさらに突き込み、自らの限界を試している
						ENDIF
					ELSE
						;中に射精されている
						IF TCVAR:TARGET:질내사정량 > 0
							IF RAND:2 == 0
								PRINTFORML %CALLNAME%が陰唇を弄り始めると、その内側に注ぎ込まれていた%CALLNAME:MASTER%の精液がトロリと流れ出た
								PRINTFORMW 「やだ……恥ずかしい」
								PRINTFORML %CALLNAME%は頬を朱に染めると、陰唇を覆うように手のひらで蓋をした
								PRINTFORML そのまま、手のひらを微妙に動かして自慰を続ける
								PRINTFORML 「んっ……%ハート()%　ふぅん……%ハート()%」
								PRINTFORMW 興奮と共に膣口が開き、内側から溢れた精液が%CALLNAME%の指の隙間から滴り落ちた
							ELSE
								PRINTFORML %CALLNAME%は%CALLNAME:MASTER%の精液を吹き零す秘裂を指でなぞり、背筋を震わせた
								PRINTFORMW 「こんなに注がれてる……幸せ%ハート()%」
							ENDIF
						ELSE
							IF RAND:2 == 0
								PRINTFORML 「もう、こんな恥ずかしい事をさせて……」
