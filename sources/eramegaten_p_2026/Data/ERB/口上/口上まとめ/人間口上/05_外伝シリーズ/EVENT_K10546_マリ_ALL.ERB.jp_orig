;-------------------------------------------------
;手、口以外で射精
;対応コマンドはキス、素股、足コキ、アナル強制奉仕、ダブル素股、助手を犯させる
;-------------------------------------------------
IF TFLAG:9 > 0
	CALL PALAM_MESSAGE_A
	;陥落済み
	IF 陥落() && (CFLAG:231 < 4 || FLAG:7 == 2)
		;淫乱、娼婦、淫乱スイッチＯＮ
		IF 음란() || CFLAG:800 == 1
			IF RAND:2 == 0
				PRINTFORML 「もう、出すのなら先生の中に出さないとダメでしょ♪」
				PRINTFORMW 無駄撃ちを咎められてしまった
			ELSE
				PRINTFORML 「あ♪　あ♪　勿体無い♪」
				PRINTFORMW %CALLNAME%は飛び散った精液を舌で舐め取った
			ENDIF
		;恋慕、親愛
		ELSEIF 연모()
			IF RAND:2 == 0
				PRINTFORML 「あら、我慢できなかった？」
				PRINTFORML 「先生のテクニック、ちょっとした物でしょう？」
				PRINTFORMW %CALLNAME%は飛び散った精液を指先で拭い取りながら微笑んだ
			ELSE
				PRINTFORMW 「こんなに出しちゃって……まだ序の口でしょう？」
			ENDIF
		;服従、隷属
		ELSEIF 복종()
			PRINTFORML 
		ENDIF
		CFLAG:231 = 4
	;屈服刻印Lv3
	ELSEIF MARK:굴복각인 == 3 && (CFLAG:231 < 3 || FLAG:7 == 2)
		PRINTFORMW 「あ、熱い……」
		CFLAG:231 = 3
	;それ以外
	ELSEIF CFLAG:231 < 2 || FLAG:7 == 2
		IF RAND:2 == 0
			PRINTFORMW 「外で出してくれただけ、マシかしら……」
		ELSE
			PRINTFORMW 「やっ！？　い、いきなり出さないで……」
		ENDIF
		CFLAG:231 = 2
	ENDIF
ENDIF

;-------------------------------------------------
;조수를범한다로사정
;-------------------------------------------------
IF TFLAG:7 > 0
	CALL PALAM_MESSAGE_A
	;陥落済み
	IF 陥落() && (CFLAG:232 < 3 || FLAG:7 == 2)
		PRINTFORML 
		CFLAG:232 = 3
	;屈服刻印Lv3
	ELSEIF MARK:굴복각인 == 3 && (CFLAG:232 < 2 || FLAG:7 == 2)
		PRINTFORML 
		CFLAG:232 = 2
	;それ以外
	ELSEIF CFLAG:232 < 1 || FLAG:7 == 2
		PRINTFORML 
		CFLAG:232 = 1
	ENDIF
ENDIF

;-------------------------------------------------
;입으로사정
;-------------------------------------------------
IF TFLAG:0 > 0
	CALL PALAM_MESSAGE_A
	;イラマチオで射精
	IF SELECTCOM == 140
		;陥落済み
		IF 陥落() && (CFLAG:233 < 4 || FLAG:7 == 2)
			;淫乱、娼婦、淫乱スイッチＯＮ
			IF 음란() || CFLAG:800 == 1
				PRINTFORML 「むぶっ！？」
				PRINTFORML がっしりと%CALLNAME%の頭を押さえつけ、存分にぶちまけた
				PRINTFORML 「んく、んっ、んっ……はぁ……」
				PRINTFORMW 「%CSTR:이인칭%の精液って、媚薬でも入ってるの？　体がどんどん熱くなってくるわ%ハート()%」
			;恋慕、親愛
			ELSEIF 연모()
				PRINTFORML 「んぶっ！？　んっ、んぐっ……」
				PRINTFORML %CALLNAME%の頭を掴み、舌の柔らかさを堪能しながら射精する
				PRINTFORMW 腰の抜けそうな射精感と共にぶちまけられた大量の精液を%CALLNAME%は喉を鳴らして飲み下していく
				PRINTFORMW 「ふぅ……凄い量ね。　こんなに飲まされたら、口からでも妊娠しちゃいそう%ハート()%」
			;服従、隷属
			ELSEIF 복종()
				PRINTFORML 
			ENDIF
			CFLAG:233 = 4
		;屈服刻印Lv3
		ELSEIF MARK:굴복각인 == 3 && (CFLAG:233 < 3 || FLAG:7 == 2)
			PRINTFORML 「んぐっ！？　んんんーーーっ！？」
			PRINTFORML %CALLNAME%の頭を抑えつけ、喉の奥にたっぷりと射精する
			PRINTFORML 目を白黒させながら必死に飲み干そうとする%CALLNAME%だったが、余りの量にむせ返ってしまった
			PRINTFORMW 「けほっ、げほっ……、酷いわ、鼻まで入っちゃったじゃない……」
			CFLAG:233 = 3
		;それ以外
		ELSEIF CFLAG:233 < 2 || FLAG:7 == 2
			PRINTFORML 「んんっ！？　げほっ、ごほっ！」
			PRINTFORML 口内にぶちまけられた精液の量に%CALLNAME%はむせ返り、激しく咳き込んだ
			PRINTFORML 「う、うぅー……」
			PRINTFORMW 鼻まで逆流してきた精液を拭いながら、%CALLNAME%は涙目になっている
			CFLAG:233 = 2
		ENDIF
	;それ以外の口射精
	ELSE
		;陥落済み
		IF 陥落() && (CFLAG:233 < 4 || FLAG:7 == 2)
			;淫乱、娼婦、淫乱スイッチＯＮ
			IF 음란() || CFLAG:800 == 1
				IF RAND:2 == 0
					PRINTFORML 「あは%ハート()%　出た出たぁ%ハート()%」
					PRINTFORML 亀頭の先端から精液を噴出す肉棒に%CALLNAME%は楽しげな嬌声を上げると、飛び散った白濁を舌を伸ばして舐めとっていく
					PRINTFORML 「れろ……ちゅる……ふふ、どうしたの？　また硬くなってきたわよ%ハート()%」
					PRINTFORMW 殊更いやらしく舌をうごめかす%CALLNAME%の淫靡な表情に%CALLNAME:MASTER%の逸物はたちまち硬度を取り戻した
				ELSE
					PRINTFORML 「んっ、んふっ、んちゅうぅ……♪」
					PRINTFORMW 口内に吐き出された精液を飲み下した%CALLNAME%は咥えた陰茎に吸い付き、残り汁まで吸い上げていく
					PRINTFORMW 瞳を劣情に霞ませ、頬をすぼめてペニスをすすり上げる姿には、普段の優しげな聖職者の趣は欠片もない
				ENDIF
			;恋慕、親愛
			ELSEIF 연모()
				IF RAND:2 == 0
					PRINTFORML %CALLNAME%は白い喉を上下させて口中の精液を飲み下した
					PRINTFORMW 「ふぅ……ご馳走様%ハート()%」
				ELSE
					PRINTFORML 「先生のお口、気持ち良かったでしょ？」
