;-------------------------------------------------
;141,피스트퍽　服従、隷属のみ
;-------------------------------------------------
	CASE 141
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:370 == 0
			;助手　ユズ
			IF ASSIPLAY == 1 && 助手確認([[キャラ:유즈]]) && EXP:ASSI:Ｖ확장경험 >= 10
				PRINTFORMW 『괜찮아、아픈 건 처음 뿐이야』
				PRINTFORMW 『그러니까… 각오해둬』
				PRINTFORMW 비통한 표정으로 %CALLNAME:ASSI%를 바라보는 %CALLNAME%
				PRINTFORMW %TARGET을% 내려다보는 %CALLNAME:ASSI%의 눈에는 그저 조용한 절망만이 깃들어 있었다
				PRINTFORMW 『울어도 소리쳐도 안 돼』
				PRINTFORMW 『주인님이 질릴 때까지 이제부터 아츠로우는 뱃속을 휘저어질 거야…』
				PRINTFORMW 파직
				PRINTFORMW 복부를 타고 흐르는 아픔
				PRINTFORMW %CALLNAME:ASSI%는 어떠한 자비도 없이 주먹을 쑤셔박아져、%TARGET은% 찢어지는듯한 아픔에 시달린다
				PRINTFORMW 「아~아~아아아악！！」
				PRINTFORMW 『알 수 있어… 아츠로우의 기분』
				PRINTFORMW 『그만했음 좋겠어、놓아줬음 좋겠어、죽고 싶을 정도로 아픈 거구나』
				PRINTFORMW 『그치만 말이지、우리들은… 너는 노예、주인님의 노리개인 거야』
				PRINTFORMW 『자아、좀 더 괴로워해줘,좀 더 주인님을 기쁘게 해줘』
				PRINTFORMW 광기를 띤 미소를 짓는 %CALLNAME:ASSI%는 %CALLNAME:TARGET%의 질벽을 도려내는 것처럼 주먹을 움직이기 시작했다……
			ENDIF
			CFLAG:370 = 1
		;二回目以降
		ELSEIF CFLAG:370 < 2 || FLAG:7 == 2
			PRINTFORMW 
			CFLAG:370 = 2
		ENDIF

