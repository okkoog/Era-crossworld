			;それ以外
			ELSEIF CFLAG:305 < 2 || FLAG:7 == 2
				PRINTFORMW 「그、그만햇！　우와아아아！」
				PRINTFORMW 항문 수치를 견디는 %CALLNAME%의 목소리는 제법 흥한다……。
				CFLAG:305 = 2
			ENDIF
		ENDIF

