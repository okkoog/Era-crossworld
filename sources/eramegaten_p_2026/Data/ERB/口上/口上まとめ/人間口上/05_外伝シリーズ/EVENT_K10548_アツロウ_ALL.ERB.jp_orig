;-------------------------------------------------
;アツロウ口上（キャラクターの名前を入れる、下にコンセプトなど一言あれば入れる）
;恋慕・親愛特化。慣れてタメ口になる感じ。
;TSでも女主人公でも、お好きなようにお召し上がりください。
;改変・再配布はご自由にどうぞ。
;-------------------------------------------------

;-------------------------------------------------
;eratohoA及びeratohoA系列専用口上テンプレート
;X1とX2をキャラ番号に置換し、Y1を助手のキャラ番号に置換してください
;ただし、キャラ番号が一桁のキャラの場合、X1,Y1は1、X2は01のように変えてください
;そしてコマンド内の適当な条件の下のPRINTFORMWの後ろに半角スペースを置いてセリフを追加してください
;口上を追加しないコマンドは無記入でも構いませんが、CFLAG:XXXの頭に『;』をつけてコメントアウトすると尚良いでしょう
;エキストラ構文など、コメントアウトされている構文を使う際には、『;』を外してコメントアウトを解除する必要があります
;最後にread meにも目を通しておくことをお勧めします
;-------------------------------------------------
;--------------------------------------------------
;EVENTTRAIN関係（X1をキャラ番号に置換）
;調教開始時のセリフ CFLAG 201～219を使用
;--------------------------------------------------
@EVENTTRAIN_K[[キャラ:아츠로우]]
;--------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;--------------------------------------------------
;IF CFLAG:220 == 0
;	PRINTL 処女モードに移行しますか？
;	PRINTL [0] はい
;	PRINTL [1] いいえ
;	$INPUT_LOOP
;	INPUT
;	IF RESULT == 0
;		PRINTFORMW ―処女モードに素質、能力を変更します―
;		TALENT:TARGET:0 = 1
;		ABL:TARGET:4 = 0
;		EXP:TARGET:0 = 0
;	ELSEIF RESULT == 1
;		PRINTFORMW ―通常モードで調教を開始します―
;	ELSE
;		GOTO INPUT_LOOP
;	ENDIF
;	CFLAG:220 = 1
;ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、4566を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL EVENTTRAIN_PY1_K[[キャラ:아츠로우]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL EVENTTRAIN_PY1_K[[キャラ:아츠로우]]
;		RETURN 0
;	ENDIF
;ENDIF
;--------------------------------------------------
;簡易助手口上の発動時に初調教時口上をスキップ（Y1を助手のキャラ番号にする）
;複数人いる際には、SIF NO:ASSI == Y1 || NO:ASSI == Z1と追加していく
;--------------------------------------------------
;IF CFLAG:201 == 0 && ASSI > 0
;	SIF NO:ASSI == Y1
;		CFLAG:201 =1
;ENDIF
;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	
	IF GET_VALUE_TALENT_JOINABLE(TARGET) == 1
		DRAWLINE
		PRINTFORMW 「안뇽하심ー까、%CSTR:일인칭%에게 무슨 용무 있으심까？」
		PRINTFORMW 「우왓、뭡니까 이 방。왠지 굉장히 살풍경함다만……」
		PRINTFORMW %MASTER는% 무방비한 상태로 모습을 드러낸 %CALLNAME%에게 접근해서、재빨리 침대에 넘어뜨려 눌렀다。
		PRINTFORMW 「엉? 잠깐만…… 뭐 하시려는 겁니까。」
		PRINTFORMW 「……노、노예!? 농담이죠、%일인칭은% 남자라고요!?」
		PRINTFORMW 어안이 벙벙해진 %CALLNAME%의 눈에 서서히 이해의 징조가 보이기 시작한다。
		PRINTFORMW 「진짜냐고…… 옘병할！」
			IF TALENT:MASTER:남자 == 1
				PRINTFORMW 「그만하라곳! 남자한테 만져져서 기분 좋겠냐！」
			ELSE
				PRINTFORMW 「%이인칭을% 믿었던 %일인칭이% 바보였어！」
			ENDIF
		PRINTFORMW 이렇게 가까이서 보자、의외로 귀엽게 생긴 얼굴이다。
		PRINTFORMW 헌신적인 성격 면에서 생각해보면、조교에 따라서는 꽤 좋은 노예가 될 것 같다。
		PRINTFORMW 자、어떤 색으로 물들여볼까……。
		DRAWLINE
		PRINTFORMW ※%NAME:TARGET%은 %NAME:MASTER%에 대한 신뢰를 잃어、전투에 참가하지 않게 됩니다※
		SIF CFLAG:포지션 > 0
			CALL REMOVE_POSITION,CFLAG:포지션
		CALL SET_TALENT_PARTY_JOINABLE, TARGET, "参加不可能"
	ENDIF
	CFLAG:201 = 1
	RETURN 0
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	PRINTFORMW 「바보 같은 짓은 그만두고 얼른 해방시켜달라고」
	PRINTFORMW 「%일인칭은% 남자니까、제대로 팔리지도 않을 거라고」
	PRINTFORMW 목소리가 떨리고 있지만、이 상황에서 의연한 눈을 하고 있다는 것은 제법 담이 큰 모양이다。
	CFLAG:201 = 2
	RETURN 0
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	PRINTFORMW 「아직도 이런 일 계속하는 거냐？」
	PRINTFORMW 「……그래、%일인칭이% %CSTR:이인칭%의 부하가 되는 건 어때？」
	PRINTFORMW 「매달 정해진 납부금을 내면서、그 대신 이런 짓 당하지 않는다는 건……」
	PRINTFORMW 제법 머리와 입이 잘 굴러가는 소년이다。
	PRINTFORMW 그 지혜를 노예로서 발휘하라면서 웃어주자、%CALLNAME은% 끼릭 하고 이를 악물었다。
	CFLAG:201 = 3
	RETURN 0
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW 「……」
	PRINTFORMW %CALLNAME은% %CALLNAME:MASTER%이 방에 들어오는 것을 보자、모르는 척 시선을 이리저리 돌렸다。
	PRINTFORMW 드디어 자신의 힘으론 %MASTER를% 상대할 수 없다는 것을 깨달은 모양이다……。
	CFLAG:201 = 4
	RETURN 0
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		;IF CFLAG:미조교함락 == 1
			;調教せずに恋慕をつけた場合の分岐
		;	PRINTFORMW 
		;ELSE
			PRINTFORMW %CALLNAME:MASTER%이 방에 들어오자、%CALLNAME은% 뺨을 홍조시켰다。
			PRINTFORMW 「저、저기…… %CSTR:이인칭%、오늘은 들어줬으면 하는 얘기가 있어」
			PRINTFORMW 「저기 말이지…… %CSTR:일인칭%、%이인칭을% 생각하면 밤에도 잠이 안 와」
			PRINTFORMW 「이상하다고 생각하지……」
				IF TALENT:MASTER:남자 == 1
					PRINTFORMW 「우리들、남자끼린데 말야」
				ELSEIF CFLAG:미조교함락 == 0
					;暫定的に条件追加
					PRINTFORMW 「%CSTR:이인칭%에게 그렇게나 심한 짓을 당했는데도 말야」
				ENDIF
			PRINTFORMW 「그래도、이제 이 기분을 억누를 수가 없어졌어……」
			PRINTFORMW 「……저、%CSTR:일인칭%、%이인칭을% 계속 따라다녀도 괜찮을까……？」
			PRINTFORMW %CALLNAME:MASTER%이 머리를 어루만지자、%CALLNAME은% 수줍은 미소를 보였다。
			PRINTFORMW 「아아…… 앞으로도 잘 부탁해、주인님」
		;ENDIF
	;음란
	ELSEIF TALENT:4
		PRINTFORMW %CALLNAME:MASTER%이 방에 들어오자、%CALLNAME은% 기대에 젖은 눈으로 %MASTER를% 바라봤다。
		PRINTFORMW 복도에 울리는 %CALLNAME:MASTER%의 신발소리를 들은 것만으로도、가랑이의 양물은 터질듯이 발기하고 있다。
		PRINTFORMW 이제 완전히 음란한 행위의 포로가 된 것 같다……。
		PRINTFORMW %CALLNAME:MASTER%이 입술을 치켜올리면서 웃자、%CALLNAME은% 눈을 반짝이며、떨리는 목소리로 호소해왔다。
		PRINTFORMW 「주인님…… 이제 기다릴 수가 없어요」
		PRINTFORMW 「부디、%일인칭을% 좋을대로 가지고 놀아주세요……」
	;복종
	ELSEIF TALENT:5
		PRINTFORMW %CALLNAME은% 바닥에 무릎꿇고、%CALLNAME:MASTER%이 방에 들어오는 것을 계속 기다리고 있었다。
		PRINTFORMW 「%CSTR:이인칭%…… 이제까지 반항적인 태도를 취해버려서、몸둘 바를 모르겠습니다」
		PRINTFORMW 「이제부터 %CSTR:이인칭%의 말에는 뭐든지 따르겠습니다」
		PRINTFORMW 「그러니까、부디 %일인칭을% %CSTR:이인칭%의 곁에 있게 해주십시오……」
		PRINTFORMW %CALLNAME:MASTER%은 %CALLNAME%의 말씨를 듣자、천천히 발로 걷어차서 기도록 했다。
		PRINTFORMW 넙죽 엎드린 %CALLNAME%의 앞에 발을 내밀자、%CALLNAME은% 열심히 발을 핥기 시작한다。
		PRINTFORMW ……조교는 충분히 진행되었다、고 %CALLNAME:MASTER%은 확신했다。
	ENDIF
	CFLAG:201 = 5
	RETURN 0
ENDIF
;-------------------------------------------------
;簡易助手口上（Y1を助手のキャラ番号に置換、X1をキャラ番号に変更する) CFLAG203
;掛け合いをするキャラを増やす場合は、構文をコピー＆ペーストをして、CFLAGの数を204、205と増やす
;-------------------------------------------------
;助手の有無をチェック（いない場合は二回目以降へ飛ぶ）
IF ASSI < 0 
	CALL EVENTTRAIN_SECOND_K[[キャラ:아츠로우]]
;助手　ユズ
ELSEIF 助手確認([[キャラ:유즈]])
	;初めて
	IF CFLAG:203 == 0
		;陥落済み＋陥落時初口上が発生済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && CFLAG:201 >= 5
			PRINTFORMW 『아츠로우、건강하게 지냈어?』
			PRINTFORMW %CALLNAME:ASSI%의 모습을 본 %CALLNAME은%、비통한 표정으로 %MASTER를% 보았다。
			PRINTFORMW 「……뭐、그럴 거라고 생각했어。%CSTR:일인칭%에게까지 손을 대는 %CSTR:이인칭%이、이 녀석을 가만히 뒀을 리가 없지」
			PRINTFORMW 『? 무슨 얘기야?』
			PRINTFORMW 「아니。너하고는 관계 없는 얘기야」
			PRINTFORMW 「……그래서、오늘은 이녀석도 섞여서 하는 거고만。좋고 말고、이 참에 철저하게 저질러줄 테니까……」
			PRINTFORMW %CALLNAME은% 여러가지로 개운해진 모양이다。
		;それ以外
		ELSE
			PRINTFORMW 「소、소매녀！」
			PRINTFORMW 「젠장…… %CSTR:일인칭%뿐만 아니라 이녀석까지……！　%일인칭은% 어떻게 돼도 좋아、유즈만은 놔줘！」
			PRINTFORMW 『아츠로우、뭐라고 했어?』
			PRINTFORMW 『저기 말이지、오늘은 나한테 아츠로우를 조교해달랬어!』
			PRINTFORMW 『재밌겠어어…… 후후』
			PRINTFORMW 「뭣……」
			PRINTFORMW 절망으로 물든 %CALLNAME%의 얼굴을 보며、%CALLNAME:MASTER%은 악마 같은 웃음이 입가에 떠오르는 것을 참을 수 없었다。
		ENDIF
		CFLAG:203 = 1
	;二回目以降
	ELSEIF CFLAG:203 < 2 || FLAG:7 ==2
		;陥落済み
		IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
			PRINTFORMW 
		;それ以外
		ELSE
			PRINTFORMW 
		ENDIF
		CFLAG:203 = 2
	ENDIF
;口上のある助手が居ない場合は、通常の二回目以降の口上へ飛ぶ
ELSE
	CALL EVENTTRAIN_SECOND_K[[キャラ:아츠로우]]
ENDIF

;-------------------------------------------------
;調教開始時（2回目以降、X1をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_K[[キャラ:아츠로우]]
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORMW 「…………」
	PRINTFORMW %CALLNAME은% 증오에 찬 표정으로、%CALLNAME:MASTER%의 얼굴을 바라보고 있다……。
	CFLAG:202 = 4
;屈服刻印Lv0
ELSEIF MARK:2 == 0 && (CFLAG:202 < 1 || FLAG:7 == 2)
	PRINTFORMW 「젠장、떨어지라곳！」
	PRINTFORMW 「빌어먹을、어째서 이런……」
	PRINTFORMW %MASTER는% 저항하려 날뛰는 %CALLNAME%를 억지로 제압했다。
	CFLAG:202 = 1
;屈服刻印Lv1
ELSEIF MARK:2 == 1 && (CFLAG:202 < 2 || FLAG:7 == 2)
	PRINTFORMW 「또 온 거냐……」
	PRINTFORMW 「저기 말야、알고 있을진 모르겠지만 %CSTR:이인칭%이 하고 있는 건 범죄다」
	PRINTFORMW 말할 필요도 없는 말이다……。
	PRINTFORMW %CALLNAME:MASTER%은 코웃음쳤다。
	CFLAG:202 = 2
;屈服刻印Lv2
ELSEIF MARK:2 == 2 && (CFLAG:202 < 3 || FLAG:7 == 2)
	PRINTFORMW 「앗……」
	PRINTFORMW 「잠깐 기다려봐、%CSTR:일인칭%의 말을 들어줘……」
	PRINTFORMW %CALLNAME:MASTER%은 대답도 하지 않고 %CALLNAME%을 넘어뜨렸다。
	CFLAG:202 = 3
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0) && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORMW 「…………」
	PRINTFORMW %CALLNAME:MASTER%의 모습을 본 %CALLNAME은%、동요한 것을 감추려는 것처럼 시선을 이리저리 돌렸다。
	CFLAG:202 = 4
;陥落済み
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORMW 「앗…… 어서오십시오」
			PRINTFORMW PC를 만지고 있던 %CALLNAME은%、작업하던 손을 멈추고 %CALLNAME:MASTER%에게 미소지었다。
			PRINTFORMW %CALLNAME은% 꼼꼼하게 정리된 방의 구석에서 방석을 가지고、%CALLNAME:MASTER%에게 권한다。
			PRINTFORMW 「헤헤…… 오늘은 뭘 할까？」
		ELSEIF K:1 == 1
			PRINTFORMW 「어이、기다리고 있었어」
			PRINTFORMW 「오늘은…… 뭐 할까？」
			PRINTFORMW %CALLNAME은% 반짝반짝 기대에 찬 눈으로 %MASTER를% 바라보고 있다。
		ELSE
		;ネタ台詞を仕込んでみた
			IF TALENT:MASTER:남자 == 0
				PRINTFORMW %CALLNAME%은 %CALLNAME:MASTER%의 얼굴을 보자、수줍은 미소를 지었다。
				PRINTFORMW 「뭐라고 할까……」
				PRINTFORMW 「좋아하는 애랑 같이 에로한 일 한다는 건…… 좋네」
				PRINTFORMW ……
				PRINTFORMW …………
				PRINTFORMW ………………
				PRINTFORMW 「으하하하하　리얼충 폭발해라ーーー앗」
				PRINTFORMW %CALLNAME은% 자신이 말한 대사에 자폭하는 것 같아서、자꾸 쑥쓰러워하고 있다。
			ELSE
				PRINTFORMW 「%일인칭이% 남자라던가、그런 건 아무래도 상관 없어」
				IF TALENT:남자 == 0	
					PRINTFORMW 「왜냐면 이제 %CSTR:일인칭% 자신이 남자라 불릴 순 없게 됐고……」
					PRINTFORMW 「뭐가 어떻게 되는 건진 잘 모르겠지만」
				ENDIF
				PRINTFORMW 「중요한 건、%일인칭이% %이인칭을% 좋아하게 됐단 거야」
			ENDIF
			PRINTFORMW 
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORMW 
		ELSEIF K:1 == 1
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORMW 
		ELSEIF K:1 == 1
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
	CFLAG:202 = 5
ENDIF
RETURN 0

;-------------------------------------------------
;EVENTEND関係（X1をキャラ番号に置換）
;調教終了時のセリフ
;-------------------------------------------------
@EVENTEND_4566
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL EVENTEND_PY1_K[[キャラ:아츠로우]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	SIF NO:ASSI == Y1
;	CALL EVENTEND_PY1_K[[キャラ:아츠로우]]
;	RETURN 0
;ENDIF
;--------------------------------------------------
;調教終了時のセリフ
;--------------------------------------------------
DRAWLINE
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:217 < 1 || FLAG:7 == 2)
	PRINTFORMW 「이제 오지 말라고……！」
	PRINTFORMW %CALLNAME%은 %CALLNAME:MASTER%의 등에 대고 매도했다。
	CFLAG:217 = 1
;屈服刻印Lv1以下
ELSEIF MARK:2 <= 1 && (CFLAG:219 < 1 || FLAG:7 == 2)
	;メタだなあ
	PRINTFORMW 「……야겜도 아니고、이런 걸로 %일인칭을% 어떻게 해볼 수 있을 거라 생각하지 마」
	CFLAG:219 = 1
;屈服刻印Lv2
ELSEIF MARK:2 == 2
	PRINTFORMW 「겨우 끝나준 건가……」
	CFLAG:219 = 2
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW %CALLNAME은% 돌연 입을 다물고、%CALLNAME:MASTER%에게 동요를 숨기려 하고 있다……。
	CFLAG:219 = 3
;陥落済み＋体力500未満
ELSEIF BASE:0 < 500 && (CFLAG:218 < 1 || FLAG:7 == 2)
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		PRINTFORMW 「하하하…… 아직 좀 더 여러 가지 하고 싶지만、이제 기진맥진했다……」
		PRINTFORMW 「미안、이제 오늘은 쉬게 해줘……」
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		PRINTFORMW 
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORMW 
	ENDIF
	CFLAG:218 = 1
;陥落済み
ELSEIF CFLAG:219 < 4 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		PRINTFORMW 「아、오늘은 끝난 건가？」
		PRINTFORMW 「그럼、잠깐 거기 앉아 있어봐。지금 주스라도 준비할 테니까」
		PRINTFORMW %CALLNAME은% 일어서서、보람차게 %CALLNAME:MASTER%에게 컵과 과자를 가져왔다。
		PRINTFORMW 「그러면 들어주라。이전에、이런 일이……」
		PRINTFORMW 남은 시간 동안、잠시 %CALLNAME과% 즐겁게 얘기했다。
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		PRINTFORMW 
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORMW 
	ENDIF
	CFLAG:219 = 4
ENDIF
RETURN 0

;--------------------------------------------------
;@KOJO_MESSAGE_COM関係（X1をキャラ番号に置換）
;コマンド実行時に出力されます
;--------------------------------------------------
@KOJO_MESSAGE_COM_K[[キャラ:아츠로우]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL TRAIN_MESSAGE
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_COM_PY1_K[[キャラ:아츠로우]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_COM_PY1_K[[キャラ:아츠로우]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;コマンド実行時のセリフ CFLAG 300～500
;-------------------------------------------------
;=================================================
;愛撫系コマンド
;=================================================
;-------------------------------------------------
;0,애무
;-------------------------------------------------
SELECTCASE SELECTCOM
	CASE 0
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:300 == 0
			PRINTFORMW 「으응…… 그、그만하라곳！　어딜 만지는 거야！」
			PRINTFORMW 피부 위를 기어다니는 %CALLNAME:MASTER%의 손에、%CALLNAME은% 날카로운 소리를 내면서 몸을 꼬았다。
			CFLAG:300 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:300 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORMW 「으응……。기분 좋아…… 하아、하아……」
					PRINTFORMW %CALLNAME은% 편안한 표정으로、%CALLNAME:MASTER%의 애무를 받아들이고 있다……。
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ENDIF
				CFLAG:300 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:300 < 3 || FLAG:7 == 2)
				PRINTFORMW 「젠장할…… 이런 게 기분 좋다니……」
				PRINTFORMW %CALLNAME은% 분한듯이 중얼거리고 있다。
				CFLAG:300 = 3
			;それ以外
			ELSEIF CFLAG:300 < 2 || FLAG:7 == 2
				PRINTFORMW 「그만둬…… 손이 차갑다고……！」
				CFLAG:300 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;1,커닐링구스
;-------------------------------------------------
	CASE 1
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:301 == 0
			PRINTFORMW 「그、그만햇！　젠장할……」
			PRINTFORMW %CALLNAME은% 새롭게 갖춰진 기관에 혀를 더듬어지자、전례 없는 감각에 온몸의 털을 곤두세웠다。
			PRINTFORMW 「우읏…… 우와아아아아아악！？」
			CFLAG:301 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:301 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORMW 
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ENDIF
				CFLAG:301 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:301 < 3 || FLAG:7 == 2)
				PRINTFORMW 
				CFLAG:301 = 3
			;それ以外
			ELSEIF CFLAG:301 < 2 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:301 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;2,펠라한다
;-------------------------------------------------
	CASE 2
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:302 == 0
			PRINTFORMW 「그、그만햇！」
				IF TALENT:MASTER:남자 == 1
					PRINTFORMW 「제、젠장…… 설마 사내새끼한테 이런 꼴 당한다곤 생각 못했다고……！！」
				ELSE
					PRINTFORMW 「그야 %CSTR:일인칭%도 남자니까 흥미가 없는 건 아니지만야……」
					PRINTFORMW 「하、하지만 이런 상황에서 경험하고 싶었던 건 아니고……」
					PRINTFORMW 뒤죽박죽 시끄러웠기 때문에、혀 기술로 침묵시켰다。
					PRINTFORMW 「우왁…… 아아아아아악!? 너무 기분 좋앗……！」
				ENDIF
			CFLAG:302 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:302 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORMW 입으로 기분 좋게 해준다고 말하고서、%CALLNAME은% 뺨을 물들이고서 양물을 내밀어왔다。
					PRINTFORMW 스릅…… 쪽쪽…… 주르르르릅…….			
					PRINTFORMW 일부러 소리를 내서 입에 넣고 핥는 %MASTER를%、%CALLNAME은% 눈을 글썽이면서 사랑스러운 듯 보고 있다。
					PRINTFORMW 「아앗…… 기분 좋다아……」
					PRINTFORMW 「하아、하아…… 마셔줘！　전부 마셔줘！　부탁이얏！」
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ENDIF
				CFLAG:302 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:302 < 3 || FLAG:7 == 2)
				PRINTFORMW 「학…… 하악……！」
				PRINTFORMW %CALLNAME은% 쾌락을 거스르지 못하고、%CALLNAME:MASTER%의 머리를 잡고 스스로 허리를 움직이고 있다……。
				CFLAG:302 = 3
			;それ以外
			ELSEIF CFLAG:302 < 2 || FLAG:7 == 2
				PRINTFORMW 「웃……」
				PRINTFORMW 전번의 강렬한 혀 기술의 기억이 되살아나는지、%CALLNAME은% 약간 주저했다。
				PRINTFORMW 그러나 결국 쾌락을 거스르지 못하고、머뭇머뭇 %CALLNAME:MASTER%에게 양물을 내밀어온다……。
				CFLAG:302 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;3,손가락삽입
;-------------------------------------------------
	CASE 3
