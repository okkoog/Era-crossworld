	CASE 11
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:311 == 0
			IF TALENT:남자 == 1
				PRINTFORMW 「엑……」
				PRINTFORMW 「남자의 자위 따윌 봐서 좋은 거냐고？」
				PRINTFORMW 「유두도 만지라고？　……알았다고」
			ELSE
				PRINTFORMW 「앗…… 크윽……」
				PRINTFORMW 「위험한데、이거…… 여자의 몸이란 건 너무 기분 좋은걸……」
				PRINTFORMW 「으응…… 중독될 것 같아……♪」
			ENDIF
			CFLAG:311 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:311 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					IF TALENT:남자 == 1	
						PRINTFORMW 
					ELSE
						PRINTFORMW 「응…… 봐줘」
						PRINTFORMW 「앗…… 하악……%UNICODE(0x2661)%」
						PRINTFORMW %CALLNAME은% 자위에 빠져들면서도、반짝반짝 뜨거운 시선을 %CALLNAME:MASTER%에게 보내고 있다……。
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ENDIF
				CFLAG:311 = 4
			;従順Lv3以上
			ELSEIF ABL:0 >= 3 && (CFLAG:311 < 3 || FLAG:7 == 2)
				PRINTFORMW 
				CFLAG:311 = 3
			;それ以外
			ELSEIF CFLAG:311 < 2 || FLAG:7 == 2
				PRINTFORMW %CALLNAME:MASTER%이 명령하자、%CALLNAME은% 마지못해 자위를 시작했다……。
				CFLAG:311 = 2
			ENDIF
		ENDIF


