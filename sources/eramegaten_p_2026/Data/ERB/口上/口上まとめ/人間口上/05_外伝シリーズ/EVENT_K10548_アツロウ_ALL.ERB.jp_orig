				IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:334 < 4 || FLAG:7 == 2)
					PRINTFORMW 「%이인칭이% 하고 싶다고 말한다면 어쩔 수 없는 거겠지」
					PRINTFORMW 「그…… 가능하면 상냥하게 해주라」
				ELSE
					PRINTFORMW 「그、그만、그만둬 주세요」
					PRINTFORMW 「우와아아악！！」
				ENDIF
			ELSE
				;陥落済み
				IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:334 < 4 || FLAG:7 == 2)
					PRINTFORMW 「알고 있다고… %일인칭은% %CSTR:이인칭%의 노예니까」
					PRINTFORMW 「하고 싶은대로 하면 되는거야」
				ELSE
					PRINTFORMW 「큭… 이런 짓이라니」
					PRINTFORMW 「%일인칭이% 굴복할 거라고 생각하고 있는 거냐？」
					PRINTFORMW 바짝 엎드린 자세가 된 %CALLNAME은% 경기를 일으키는듯한 표정을 짓고 있다
				ENDIF
			ENDIF
			CFLAG:334 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:334 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORMW 「좋아」
					PRINTFORMW 「네가 하고 싶다고 한다면야…」
					PRINTFORMW 「상냥하게 부탁한다」
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					IF RAND:2 == 0
						PRINTFORMW 「크으… %CSTR:이인칭%로 %CSTR:일인칭%의 안이 꽉 차있다고」
					ELSE
						PRINTFORMW 「후우… 사양하지 말고、움직여줘…」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ENDIF
				CFLAG:334 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:334 < 3 || FLAG:7 == 2)
				IF TALENT:MASTER:남자 == 1
					IF RAND:2 == 0
						PRINTFORMW 「아아악！！」
					ELSE
						PRINTFORMW 「멈췃、그만두라고오옷！！」
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「그、그만해주라…」
					ELSE
						PRINTFORM 「큭… 그만해달라고…
						IF RAND:2 == 0
							PRINTFORMW 부탁할게」
						ELSE
							PRINTFORMW 」
						ENDIF
					ENDIF
				ENDIF
				CFLAG:334 = 3
			;それ以外
			ELSEIF CFLAG:334 < 2 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:334 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;63,후배위애널
;-------------------------------------------------
	CASE 63
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:335 == 0
		;助手　ユズ
		IF ASSIPLAY == 1 && 助手確認([[キャラ:유즈]])
			PRINTFORMW 『저기 말야、주인님이 아츠로우의 처음은 나한테 주신대』
			PRINTFORMW 『자、빨리 엉덩이 여기로 향해줘』
			PRINTFORM %CALLNAME:ASSI%는 신난듯이 %CALLNAME%의 허리를 잡고서
			IF TALENT:ASSI:139 == 1
				PRINTFORMW 튼튼하고 우람하게 선 후타나리 자○의 끝부분을 댔다
				PRINTFORMW 『우후후… 나의 자○를 잊을 수 없게 될 때까지 범해줄게』
			ELSE
				PRINTFORMW 페니스밴드의 끝을 애널에 밀어붙인다
			ENDIF
			IF TALENT:MASTER:남자 == 1
				PRINTFORMW 『라고 하나… 남자 주제에 주인님에게 조교당하다니 얼마나 주제넘은거야』
				PRINTFORMW %CALLNAME:ASSI%는 질투를 드러내면서 격렬하게 허리를 찔러넣었다
			ELSE
				PRINTFORMW 『괜찮아、처음엔 아프겠지만 그 다음엔 익숙해질 테니까』
				PRINTFORMW %CALLNAME:ASSI%는 불온한 대사를 날리면서 천천히 허리를 찔러 넣었다
			ENDIF
			PRINTFORMW 「중지、그만둬어!!、소매녀엇！！」
			PRINTFORMW 「아、아~ー、찢어져、찢어진다고오ーーー옷！！」
		ELSEIF TALENT:MASTER:남자 == 1
			PRINTFORMW 「중지、그만둿！！」
			PRINTFORMW 「아~ーーーー악！！」
		ELSE
			PRINTFORMW 「그만둬어！！」
			PRINTFORMW 「아~ーーーー악！！」
		ENDIF
		CFLAG:335 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:335 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORMW 「읏… 하아하아…」
					PRINTFORMW 「좀 더… 격렬하게 해줘도 좋다만？」
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 「어째선데？」
					PRINTFORMW 「이제 마지막은 아니겠지、자아… 좀 더 격렬하게 해달라고」
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ENDIF
				CFLAG:335 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:335 < 3 || FLAG:7 == 2)
				IF RAND:3 == 0
					PRINTFORMW 「……용서해주라」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「우、우와아아악、그만둬어어어！！」
				ELSE
					PRINTFORMW 「그만해、진짜루 웃긴 상황이 된ー다고、아~ー악！！」
				ENDIF
				CFLAG:335 = 3
			;それ以外
			ELSEIF CFLAG:335 < 2 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:335 = 2
			ENDIF
		ENDIF

