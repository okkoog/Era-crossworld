	CASE 41
		CALL EVENT_MESSAGE
		;陥落済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:284 < 1 || FLAG:7 == 2)
			;恋慕、親愛
			IF TALENT:3 || TALENT:6
				PRINTFORMW 
			;淫乱、娼婦
			ELSEIF TALENT:4 || TALENT:7
				PRINTFORMW %CALLNAME:MASTER%은 실오라기 하나 걸치지 않은 모습이 된 %CALLNAME%를 제단 위에 눕히고、오래된 마도서에 기록된 의식을 실행으로 옮겼다。
				PRINTFORMW 이 의식을 거치게 되면 피술자의 혼을 음마로 타락시켜、술자에게 목숨바쳐 따르는 사역마로 바꾸는 것이 가능하다。
				PRINTFORMW 본래 인간의 영혼은 그리 간단하게 따르게 할 수 있는 것이 아니지만、지금처럼 음욕에 물든 %CALLNAME%이라면 충분히 가능할 것이다。
				PRINTFORMW 마도서의 영창이 끝나자 제단이 어둠에 가득차、그것은 의지를 가진 존재인 듯 %CALLNAME%의 몸에 휘감겨든다。
				PRINTFORMW 그러나 %CALLNAME은% 오히려 당연하다는 표정으로、어둠이 몸을 유린해가는 것을 받아들이고 있다。
				PRINTFORMW 
				PRINTFORMW 곧 어둠이 걷혀 사라지자、%CALLNAME%의 배에는 선명하게 음란한 문자가 해겨졌다。
				PRINTFORMW 「……주인님。앞으로도 잔뜩 야한 일을 하자고……%UNICODE(0x2661)%」
				PRINTFORMW ・・・
				PRINTFORMW ・・・・・・
				PRINTFORMW ・・・・・・・・・
				PRINTFORMW %CALLNAME은% %CALLNAME:MASTER%의 [음마]가 되었다。
			;服従、隷属
			ELSEIF TALENT:5 || TALENT:8
				PRINTFORMW 
			ENDIF
			CFLAG:284 = 1
		ENDIF

