;-------------------------------------------------
;121,조개맞대기
;-------------------------------------------------
	CASE 121
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:363 == 0
			IF TALENT:남자 == 1
				IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
					PRINTFORMW 「……좋다」
					PRINTFORMW 「네가 하고 싶다고 말한다면」
					PRINTFORMW 「뭐든간에 해버리면 되는 거겠지」
				ELSE
					PRINTFORMW 「으… 야、그만하라고……」
					PRINTFORMW 「이런 거 이상하다니까……」
				ENDIF
			ELSE
				PRINTFORMW 「……기다려줘」
				PRINTFORMW 「만약、%일인칭이%… 이런 짓에 빠져서…」
				PRINTFORMW 「원래대로 돌아가고 싶지 않다고 생각하게 된다면 %CSTR:이인칭%도 곤란할 테지？」
				PRINTFORMW 「야、다시 생각 좀 해주라」
			ENDIF
			CFLAG:363 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:363 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					IF TALENT:남자 == 1
						PRINTFORMW 「아아… %CSTR:이인칭%…」
						PRINTFORMW 「%일인칭과% %CSTR:이인칭%의 것이 스치는데…」
						PRINTFORMW 「좀 더… 세게 하자고」
					ELSE
						PRINTFORMW 
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ENDIF
				CFLAG:363 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:363 < 3 || FLAG:7 == 2)
				IF TALENT:남자 == 1
					PRINTFORMW 「그、그만하자고…」
					PRINTFORMW 「이런 거… %CSTR:이인칭%도 즐겁지 않잖아？」
				ELSE
					PRINTFORMW 「힉… 하、할 테니까…」
					PRINTFORMW 말을 듣지 않는 %CALLNAME%의 민감한 부분을 꼬집자 %CALLNAME은% 비참한 소리를 질렀다
					PRINTFORMW 「거기… 클리…토리스……」
					PRINTFORMW 「잡아당기는 건 하지 말아줘……」
				ENDIF
				CFLAG:363 = 3
			;それ以外
			ELSEIF CFLAG:363 < 2 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:363 = 2
			ENDIF
		ENDIF

