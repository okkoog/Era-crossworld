	CASE 40
		CALL EVENT_MESSAGE
		;陥落済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:283 < 1 || FLAG:7 == 2)
			;恋慕、親愛
			IF TALENT:3 || TALENT:6
				PRINTFORMW %CALLNAME은% 약지에 끼워진 반지를 소중한 듯 보며、눈을 반짝였다。
				PRINTFORMW 「이 반지를 줬다는 것은…… %CSTR:일인칭%들、결혼했단 거지」
				IF TALENT:TARGET:남자 == 1
					PRINTFORMW 「나 스스로도 의욕 없는 성격이라 생각 않는 건 아니지만…… 그래도、솔직히 기쁘다」
					PRINTFORMW 「기다려줘。%CSTR:일인칭%도 반드시 돈 벌어서、%CSTR:이인칭%에게 반지를 선물해줄 테니까」
					PRINTFORMW 「……그러니까、그 때까지 계속 같이 있어줘」
					PRINTFORMW 「사랑한다、%CSTR:이인칭%」
				ELSE
					PRINTFORMW 「이제 %일인칭은% 남자가 아니니까、여기선 솔직하게 기뻐하는 게 좋겠지」
					PRINTFORMW 「……고마워、소중히 할게」
					PRINTFORMW 「어、어라……？　눈물 나와버렸다」
					PRINTFORMW 「이상하네…… %CSTR:일인칭%、이렇게 소녀틱 했었다니…… 하하하」
				ENDIF
				PRINTFORMW ・・・
				PRINTFORMW ・・・・・・
				PRINTFORMW ・・・・・・・・・
				PRINTFORMW %CALLNAME은% %CALLNAME:MASTER%의 \@ TALENT:남자 ? [남편] # [아내] \@(이)가 되었다。
			;淫乱、娼婦
			ELSEIF TALENT:4 || TALENT:7
				PRINTFORMW 
			;服従、隷属
			ELSEIF TALENT:5 || TALENT:8
				PRINTFORMW 
			ENDIF
			CFLAG:283 = 1
		ENDIF

;-------------------------------------------------
;;[음마]取得時
