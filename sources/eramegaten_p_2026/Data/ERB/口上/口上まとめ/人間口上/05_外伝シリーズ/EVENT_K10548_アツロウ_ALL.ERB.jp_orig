			PRINTFORMW 「그、그만해…… 히이익！」
			CFLAG:304 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:304 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORMW 「아아…… %CSTR:이인칭%이 원한다면、어디든 맘대로 해도 돼……」
					PRINTFORMW %CALLNAME은% 가슴을 고동치게 하면서、국문을 애무하는 %CALLNAME:MASTER%의 혀를 받아들이고 있다。
					PRINTFORMW 「하악…… 하아、하아……」
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 
				;服従、隷属
