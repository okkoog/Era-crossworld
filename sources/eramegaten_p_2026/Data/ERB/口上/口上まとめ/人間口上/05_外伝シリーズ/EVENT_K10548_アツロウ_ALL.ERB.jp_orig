;-------------------------------------------------
SELECTCASE TFLAG:13
	CASE 1
		CALL EVENT_MESSAGE
		;陥落済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:261 < 1 || FLAG:7 == 2)
			;恋慕、親愛
			IF TALENT:3 || TALENT:6
				PRINTFORMW 
			;淫乱、娼婦
			ELSEIF TALENT:4 || TALENT:7
				PRINTFORMW 
			;服従、隷属
			ELSEIF TALENT:5 || TALENT:8
