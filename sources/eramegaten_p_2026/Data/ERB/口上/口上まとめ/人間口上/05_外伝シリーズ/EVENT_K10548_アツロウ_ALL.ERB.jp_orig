		ELSEIF TALENT:음란 || TALENT:창부
			PRINTFORMW 
		ELSEIF TALENT:복종 || TALENT:예속
			PRINTFORMW 
		ELSE
			;屈服刻印Lv3
			IF MARK:2 == 3
				PRINTFORMW 
			ELSE
				PRINTFORMW 
			ENDIF
		ENDIF
	;それ以外の時に処女喪失(主人による道具系調教含む)
	ELSE
		;陥落素質チェック
		IF TALENT:연모 || TALENT:친애
			PRINTFORMW 
		ELSEIF TALENT:음란 || TALENT:창부
			PRINTFORMW 
		ELSEIF TALENT:복종 || TALENT:예속
			PRINTFORMW 
		ELSE
			;屈服刻印Lv3
			IF MARK:2 == 3
				PRINTFORMW 
			ELSE
				PRINTFORMW 
			ENDIF
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_D関係（4566をキャラ番号に置換）
;パラメータ変化をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_D_K[[キャラ:아츠로우]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_D
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、4566を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_D_PY1_K[[キャラ:아츠로우]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_D_PY1_K[[キャラ:아츠로우]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;パラメータ変化時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;初めて潤滑がLV3超えた
;-------------------------------------------------
P = PALAM:4 + UP:4
IF P > PALAMLV:4 && CFLAG:245 == 0
	CALL PALAM_MESSAGE_D
	;ローションを使った場合
	IF SELECTCOM == 180
		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:245 = 1
ENDIF

;-------------------------------------------------
;初めて欲情がLV2超えた
;-------------------------------------------------
P = PALAM:6 + UP:6
IF P > PALAMLV:3 && CFLAG:246 == 0
	CALL PALAM_MESSAGE_D
	;媚薬を使った場合
	IF SELECTCOM == 181
		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:246 = 1
ENDIF

;-------------------------------------------------
;初めて屈服がLV3超えた
;-------------------------------------------------
P = PALAM:7 + UP:7
IF P > PALAMLV:3 && CFLAG:247 == 0
	CALL PALAM_MESSAGE_D
	;陥落済み
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:247 = 1
ENDIF

;-------------------------------------------------
;初めて恭順がLV3超えた
;-------------------------------------------------
P = PALAM:5 + UP:5
IF P > PALAMLV:3 && CFLAG:248 == 0
	CALL PALAM_MESSAGE_D
	;陥落済み
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:248 = 1
ENDIF

;-------------------------------------------------
;初めて恐怖がLV3超えた
;-------------------------------------------------
P = PALAM:11 + UP:11
IF P > PALAMLV:3 && CFLAG:249 == 0
	CALL PALAM_MESSAGE_D
	;陥落済み
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:249 = 1
ENDIF

;-------------------------------------------------
;@KOJO_MESSAGE_MARKCNG関係（4566をキャラ番号に置換）
;刻印変動をトリガーにした口上
;刻印変動後に口上を発動します
;-------------------------------------------------
@KOJO_MESSAGE_MARKCNG_K[[キャラ:아츠로우]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL MARK_MESSAGE
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、4566を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_MARKCNG_PY1_K[[キャラ:아츠로우]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_MARKCNG_PY1_K[[キャラ:아츠로우]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;苦痛刻印Lv3
;-------------------------------------------------
IF TFLAG:22 == 3
	CALL MARK_MESSAGE_A
	;陥落済み
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		;恋慕、親愛
		IF TALENT:3 || TALENT:6
			PRINTFORMW 
		;淫乱、娼婦
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORMW 
		;服従、隷属
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 
		ENDIF
	ELSE
		PRINTFORMW 
	ENDIF
ENDIF

;-------------------------------------------------
;快楽刻印Lv3
;-------------------------------------------------
IF TFLAG:23 == 3
	CALL MARK_MESSAGE_P
	;陥落済み
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		;恋慕、親愛
		IF TALENT:3 || TALENT:6
			PRINTFORMW 
		;淫乱、娼婦
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORMW 
		;服従、隷属
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 
		ENDIF
	ELSE
		PRINTFORMW 
	ENDIF
ENDIF

;-------------------------------------------------
;屈服刻印Lv3
;-------------------------------------------------
IF TFLAG:24 == 13 || TFLAG:24 == 23 || TFLAG:24 == 33
	CALL MARK_MESSAGE_S
	;快楽による屈服
	IF TFLAG:24 == 13
		PRINTFORMW 
	;恐怖と苦痛による屈服
	ELSEIF TFLAG:24 == 23
		PRINTFORMW 
	;屈服と恭順による屈服
	ELSEIF TFLAG:24 == 33
		PRINTFORMW 
	ENDIF
ENDIF

;-------------------------------------------------
;反発刻印Lv3
;-------------------------------------------------
IF TFLAG:21 == 3
	CALL MARK_MESSAGE_R
	;陥落済み
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		;恋慕、親愛
		IF TALENT:3 || TALENT:6
			PRINTFORMW 
		;淫乱、娼婦
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORMW 
		;服従、隷属
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 
		ENDIF
	ELSE
		PRINTFORMW 
	ENDIF
ENDIF

