;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG関係（X1をキャラ番号に置換）
;パラメータ変化などをトリガーにした口上　CFLAG 221～260を使用
;-------------------------------------------------
;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_A（X1をキャラ番号に置換）
;調教者の射精をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_A_K[[キャラ:아츠로우]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_A
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、4566を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_A_PY1_K[[キャラ:아츠로우]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_A_PY1_K[[キャラ:아츠로우]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;調教者の射精時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;射精箇所変更時のテキスト　有効時はここで関数終了
;-------------------------------------------------
IF CFLAG:106
	CALL PALAM_MESSAGE_A
	;머리카락
	IF CFLAG:106 == 1
		;陥落済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:221 < 3 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:221 = 3
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3 && (CFLAG:221 < 2 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:221 = 2
		;それ以外
		ELSEIF CFLAG:221 < 1 || FLAG:7 == 2
			PRINTFORMW 
			CFLAG:221 = 1
		ENDIF
	;顔
	ELSEIF CFLAG:106 == 2
		;陥落済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:222 < 3 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:222 = 3
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3 && (CFLAG:222 < 2 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:222 = 2
		;それ以外
		ELSEIF CFLAG:222 < 1 || FLAG:7 == 2
			PRINTFORMW 
			CFLAG:222 = 1
		ENDIF
	;가슴
	ELSEIF CFLAG:106 == 3
		;陥落済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:223 < 3 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:223 = 3
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3 && (CFLAG:223 < 2 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:223 = 2
		;それ以外
		ELSEIF CFLAG:223 < 1 || FLAG:7 == 2
			PRINTFORMW 
			CFLAG:223 = 1
		ENDIF
	;腹
	ELSEIF CFLAG:106 == 4
		;陥落済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:224 < 3 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:224 = 3
		;屈服刻印Lv3
