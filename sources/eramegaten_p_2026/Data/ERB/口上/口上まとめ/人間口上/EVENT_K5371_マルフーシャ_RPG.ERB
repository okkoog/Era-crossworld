	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 유리한 건 이쪽이에요。반격할 틈을 주지 말고 쓰러뜨리죠
