;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;--------------------------------------------------
;この部分は従来版の構文をコピペ、一部改変して使用させて貰いました
IF CFLAG:220 == 0
	CFLAG:220 = 1
	PRINTL 소질을 구상 이미지에 맞추어 변경하겠습니까?
	PRINTL [예]를 고르면 바이, 일선을넘지않음, 습득빠름, 매력이 추가됩니다 (다른 구상과 동일합니다)
	CALL INPUT_YN
	IF RESULT == 0
		PRINTFORMW 소질을 추가합니다. 
		TALENT:TARGET:바이 = 1
		TALENT:TARGET:일선을넘지않음 = 1
		TALENT:TARGET:습득빠름 = 1
		TALENT:TARGET:매력 = 1
		EXP:TARGET:0 = 0
	ELSEIF RESULT == 1
		PRINTFORMW ―소질 추가 없이 조교를 개시합니다―
	ENDIF
	PRINTL 인수라쨩의 가슴 크기는?
		PRINTL [0]보통이 최고
		PRINTL [1]로리가 아닌 빈유도 좋지…
		PRINTL [2]거유는 정의
		CALL INPUTINT,0,1,2
		SELECTCASE RESULT
			CASE 0
				PRINTFORMW 가슴 크기를 변경하지 않습니다
			CASE 1
				PRINTFORMW 가슴 크기를 「빈유」로 변경합니다
				TALENT:TARGET:빈유 = 1
			CASE 2
				PRINTFORMW 가슴 크기를 「거유」로 변경합니다
				TALENT:TARGET:거유 = 1
		ENDSELECT
	PRINTL 『인수라』의 이름과 애칭을 변경하겠습니까?
	;『ひとしゅら』のままじゃ寂しいけど、自分で名前を考えるのもめんどくさい、って人向けに勝手な名前がつくようにもなってます
	CALL INPUT_YN
	IF RESULT == 0
		$INPUT_LOOP
		PRINTL 『인수라』의 이름을 입력해 주십시오 (이름과 애칭 둘 다 입력하지 않으면 「카시마 렌」이 됩니다)
		INPUTS
		NAME:TARGET = %RESULTS%
		PRINTL 『인수라』의 애칭을 입력해 주십시오
		INPUTS
		CALLNAME:TARGET = %RESULTS%
		VARSET LOCALS
		IF NAME:TARGET == LOCALS && CALLNAME:TARGET == LOCALS
				NAME:TARGET = 카시마 렌
				CALLNAME:TARGET = 렌
				;名前はドラマCD版の苗字＆アンクのマガタマより
				;…↑という事で従来版は「アン」でしたがP5のキャラクター、高巻杏と名前が被ってしまうので変更。
				;「レン」は居なかった…よね？
				;22/10加筆
				;…と思ってたらアニメ版P5の主人公の名前が「蓮」だったよちくしょーめ！
				;でも面倒なのでこのままにしておきます。
			ENDIF
		ENDIF
		PRINTFORML 이름　%NAME:TARGET%
		PRINTFORML 애칭　%CALLNAME:TARGET%
		PRINTL 이걸로 괜찮으시겠습니까？
		CALL INPUT_YN
		SIF RESULT == 1
			GOTO INPUT_LOOP
	ELSEIF RESULT == 1
		PRINTFORMW ―원래 이름 그대로 조교를 개시합니다―
	CFLAG:220 = 1
ENDIF
