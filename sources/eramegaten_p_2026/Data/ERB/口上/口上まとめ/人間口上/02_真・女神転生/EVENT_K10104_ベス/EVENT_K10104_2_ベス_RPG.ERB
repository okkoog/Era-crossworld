@KOJO_BATTLE_EVENT_K[[キャラ:베스]]_2, ARG, ARG:1, ARG:2
;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 4501
	RETURN 0
LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = EMPTY

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 今です、追撃を！
		ELSE
			BTL_KOJO_RESULTS:0 = 防御を崩しました、後はお願いします！！
		ENDIF
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = 私も役に立たなきゃ…！
		;それ以外
		ELSE
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 流石ですね、続きます！
			ELSE
				BTL_KOJO_RESULTS:0 = この距離なら追撃できるはず！
			ENDIF
		ENDIF
	;被召喚時
	CASE 3
			BTL_KOJO_RESULTS:0 = 
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = （どうか、アナタの罪も赦されますように…）
			ELSE
				BTL_KOJO_RESULTS:0 = Et dimitte nobis debita nostra, sicut et nos dimittimus debitoribus nostris…
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
;				BTL_KOJO_RESULTS:0 = 
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
;		;大ダメージ
;		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
;			BTL_KOJO_RESULTS:0 = 
;		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
;			BTL_KOJO_RESULTS:0 = 
;		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
;			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = ここで倒れるわけには、いかないのに…！
			ELSE
				BTL_KOJO_RESULTS:0 = （あ…　私、もうダメみたい…）
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF RAND:2
				BTL_KOJO_RESULTS:0 = ああああっ！
			ELSE
				BTL_KOJO_RESULTS:0 = いまさら、命を惜しむつもりはありません…
			ENDIF
;		;無効
;		ELSEIF ARG:2 == 0
;			BTL_KOJO_RESULTS:0 = 
;		;吸収
;		ELSEIF ARG:2 < 0
;			BTL_KOJO_RESULTS:0 = 
		ENDIF
;	;反射された
;	CASE 15
;			BTL_KOJO_RESULTS:0 = 
;	;反射した
;	CASE 16
;			BTL_KOJO_RESULTS:0 = 
;	;回避された
;	CASE 17
;			BTL_KOJO_RESULTS:0 = 
;	;回避した
;	CASE 18
;			BTL_KOJO_RESULTS:0 = 
	;食いしばり等で耐えた
	CASE 23
		;이악물기
		IF BASE:ARG:ＨＰ == 1
			BTL_KOJO_RESULTS:0 = まだ倒れるわけには、いかないっ！
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = 
		ENDIF
ENDSELECT
