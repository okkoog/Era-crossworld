;--------------------------------------------------
;調教終了時のセリフ
;--------------------------------------------------
DRAWLINE
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:217 < 1 || FLAG:7 == 2)
	IF FLAG:DEBUG
		PRINTFORMW 「주인님、또 와주세요……」
		PRINTFORMW %CALLNAME:MASTER%에 가까워져 온 %CALLNAME은%、휙 하고 소리를 내면서 철권을 질렀다。
		PRINTFORMW 「……는 훼이크고、뇌수 쏟으면서 뒤져라아아아ーーー앗！」
		PRINTFORMW %MASTER가% 몸을 돌려 피하자、콰아앙하는 소리가 나면서 벽이 찌그러졌다。
		PRINTFORMW 「쳇……！　안 죽었나！」
		PRINTFORML 
		PRINTFORMW %CALLNAME은% 분한것처럼 입술을 일그러뜨렸다。
		PRINTFORMW 무서운 여자다。
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:217 = 1
;屈服刻印Lv1以下
ELSEIF MARK:2 <= 1 && (CFLAG:219 < 1 || FLAG:7 == 2)
	;虜2の由紀子をイメージすると、かろうじて萌えることに気付いた。あそこまでキツくないけど。
	IF RAND:2 == 0
		PRINTFORMW 「당신따윈、지옥에나 떨어져버리세요……」
	ELSE
		PRINTFORMW 「이런……짐승같은 사람」
	ENDIF
	CFLAG:219 = 1
;屈服刻印Lv2
ELSEIF MARK:2 == 2
	IF RAND:2 == 0
		PRINTFORMW 「……………………」
		PRINTFORMW %CALLNAME은% 무언의 거부가 최대한의 저항이라고 믿고 있는 것 같다。
		PRINTFORMW 귀여운 녀석이다……。
	ELSE
		PRINTFORMW 「이제 해방시켜주세요……」
		PRINTFORMW 「이런 일을 하는 도중에도、오빠는……」
	ENDIF
	CFLAG:219 = 2
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	IF RAND:2 == 0
		PRINTFORMW %MASTER가% 뒤꿈치를 돌려주자、%CALLNAME은% 무언가 말하고 싶다는 듯 입을 열었다。
		PRINTFORMW 그러나 그녀의 입은 의미가 있는 말을 하지 않았고、%CALLNAME은% 침대에 주저앉았다……。
		PRINTFORMW ……이제 조금만 더 하면 꺾일 것 같다。
	ELSE
		PRINTFORMW 「우웃……」
		PRINTFORMW %CALLNAME%의 흐느껴 우는 소리를 들으면서、방을 뒤로 했다。
		PRINTFORMW 슬슬 자신이 뭘 하더라도 %CALLNAME:MASTER%에 저항할 수 없다는 것을 알게 되 온 것 같다……。
	ENDIF
	CFLAG:219 = 3
;陥落済み＋体力500未満
ELSEIF BASE:0 < 500 && (CFLAG:218 < 1 || FLAG:7 == 2)
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		IF FLAG:DEBUG
			IF RAND:2 == 0
				PRINTFORMW 「헷……겨우 이런 걸로 내가 굴복할거라고 생각했나？」
				PRINTFORMW %CALLNAME은% 틱틱 하고 손가락을 흔들며 가볍게 웃었다。
				PRINTFORMW 「이런걸로 내 하트는 식지 않는다！　더 세게 덤벼라아아아아아아앗！！」
				PRINTFORMW 
				PRINTFORMW 이녀석을 상대하면 피곤하다。
			ELSE
				PRINTFORMW 「오늘은 이걸로 끝인가？」
				PRINTFORMW 「헷……좋은 싸움이었다」
				PRINTFORMW 그러니까 결투한 것처럼 말하지 말라고。
			ENDIF
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「%CSTR:이인칭%……수고하셨습니다」
				PRINTFORMW 자신도 땀투성이인 채로、%CALLNAME은% 수건으로 %CALLNAME:MASTER%의 땀을 닦았다。
			ELSE
				PRINTFORMW 「저……좀더 느긋하게 하시지 않겠나요」
				PRINTFORMW 「이야기 하고 싶은게 여러가지 있어요」
				PRINTFORMW 조교 후、잠깐 시간을 들여 실없는 이야기를 했다……。
			ENDIF
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		PRINTFORMW 
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORMW 
	ENDIF
	CFLAG:218 = 1
;陥落済み
ELSEIF CFLAG:219 < 4 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		IF FLAG:DEBUG
			IF RAND:2 == 0
				PRINTFORMW 「어이어이、아직 여분의 힘을 남겨두고 있지？」
				PRINTFORMW 「내 앞에서 봐준다니 웃기게 해주는군！　자 일어서라、제 2라운드 개시닷！　우오오오오오ーーーー옷！」
			ELSE
				PRINTFORMW 「아직 체력이 남아있지 않은가！　무슨 생각이냐 네노오옴────!!?」
				PRINTFORMW 「칫、뭐 됐어……체력이 회복되면 또 오라고」
				PRINTFORMW 「기다릴게、%CSTR:이인칭%……%UNICODE(0x2661)%」
			ENDIF
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「%CSTR:이인칭%……또 와주세요」
				PRINTFORMW 「츄웃」
			ELSE
				PRINTFORMW 「귀여워해주셔서 감사합니다……」
				PRINTFORMW 살짝 몸을 대오는 %CALLNAME%의 머리를 껴안고、조교의 여운을 즐긴다。
			ENDIF
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		PRINTFORMW 
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORMW 
	ENDIF
	CFLAG:219 = 4
ENDIF
RETURN 0

