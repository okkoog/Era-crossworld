;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:유미]], ARG, ARG:1, ARG:2
;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 4502
	RETURN 0
LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;LOCALS = EMPTY

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		LOCALS = 카드가 비었어！　지금이얏！
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			LOCALS = 헤에、%CSTR:ARG:이인칭%도 제법이잖아
		;それ以外
		ELSE
			LOCALS = 그럼 한 방 더 가봐？
		ENDIF
	;被召喚時
	CASE 3
			LOCALS = 
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			LOCALS = 그대로 얌전히 있으라고！
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
;				LOCALS = 
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			LOCALS = 정통으로 들어간 모양인데、더 할 거야？
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			LOCALS = 흥、인간님을 얕보지 말라고！
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			LOCALS = 아아 진짜、꽤 딱딱한데…！
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			LOCALS = （모두들、미안…）
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			LOCALS = 죽는 줄 알았어…
		;無効
		ELSEIF ARG:2 == 0
			LOCALS = 불면 날아가는 여고생이라고 쉽게 봤어？
		;吸収
		ELSEIF ARG:2 < 0
			LOCALS = 뭐 이렇게、요런 비기도 있다는 거지
		ENDIF
;	;反射された
;	CASE 15
;			LOCALS = 
;	;反射した
;	CASE 16
;			LOCALS = 
;	;回避された
;	CASE 17
;			LOCALS = 
;	;回避した
;	CASE 18
;			LOCALS = 
ENDSELECT
