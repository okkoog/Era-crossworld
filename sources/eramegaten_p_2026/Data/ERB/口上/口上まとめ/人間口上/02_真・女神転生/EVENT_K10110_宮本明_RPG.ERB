;-------------------------------------------------
;ライセンスについて
;-------------------------------------------------
;　K4790番の口上本体に準じる
;-------------------------------------------------
;口は悪いが義理堅いボクシング少年。アモンのことが大好き。
;弱い考えは嫌い。不良も嫌い。暴力も嫌い。……なんか戦いを楽しんでないかって？　それはアモンの影響ということで…
;アキラの認識では記憶を共有する、文字通りの一心同体のようだ。基本人格はアキラだが、たまに出てくる鈎括弧の台詞はアモンのもの。
;「if」ではアモンと融合して以降は魔人形態のままだが、tenでは人間形態と魔人形態を自由に切り替えられる模様。従って原作と同様のルートは通ることはないだろう。

;同姓同名の吸血鬼ハンターとは無関係。いいね？
;-------------------------------------------------

;--------------------------------------------
;敵としてこの口上のキャラが登場した際のCOOP発動時のセリフ
;-------------------------------------------------

;-------------------------------------------------
;戦闘中のイベント関連
;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:아키라]], ARG, ARG:1, ARG:2
SELECTCASE GET_BATTLE_EVENT(TFLAG:전투이벤트)
	;COOP発動 発動者の番号はARGに格納されている
	CASE "COOP発動"
		SELECTCASE RAND:4
			CASE 3
				BTL_KOJO_RESULTS:0 = お前ら！　%CSTR:일인칭%についてきやがれ！
			CASE 2
				BTL_KOJO_RESULTS:0 = そら来た！　一斉にブチかますぞ！
			CASE 1
				BTL_KOJO_RESULTS:0 = 皆得物は持ったな！！　行くぞォ！！
			CASE 0
				BTL_KOJO_RESULTS:0 = 『魔神アモンの名に懸けて、彼奴の首級を挙げよ！』
		ENDSELECT
	;COOP参加
	CASE "COOP参加"
		IF FLAG:행동순1 != -1
			IF FLAG:행동순1 == MASTER
				;主人がCOOP発動
				SELECTCASE RAND:4
					CASE 3
						BTL_KOJO_RESULTS:0 = やるじゃねェか、%CALLNAME:MASTER%！
					CASE 2
						BTL_KOJO_RESULTS:0 = 上出来だ%CALLNAME:MASTER%！　後は任せな！
					CASE 1
						BTL_KOJO_RESULTS:0 = %CALLNAME:MASTER%だけにいい格好させるかよ！
					CASE 0
						BTL_KOJO_RESULTS:0 = 『%CALLNAME:MASTER%と%CALLNAME:ARG%、そして魔神アモンの名に懸けて
						BTL_KOJO_RESULTS:1 = 　美事彼奴の首級を挙げてくれん！』
				ENDSELECT
			;COOPの対象は、＠の他にはたまき、ハトホル、セベク、トート
			;レイコとユミは原作でも特に絡みもないんだよなぁ
			;ハザマや魔王アモン相手にも欲しいところだが…
			ELSEIF NO:(FLAG:행동순1) == [[キャラ:타마키]]
				;たまきがCOOP発動
				SELECTCASE RAND:5
					CASE 4
						BTL_KOJO_RESULTS:0 = 内田ァ！
						BTL_KOJO_RESULTS:1 = お前にしちゃあ上出来だぜ！
					CASE 3
						BTL_KOJO_RESULTS:0 = 内田ァ！
						BTL_KOJO_RESULTS:1 = %CSTR:일인칭%がフォローしてやる！　感謝しな！
					CASE 2
						BTL_KOJO_RESULTS:0 = 内田ァ！
						BTL_KOJO_RESULTS:1 = 相変わらずテキトーな女だなァ！
					CASE 1
						BTL_KOJO_RESULTS:0 = 内田ァ！
						BTL_KOJO_RESULTS:1 = パンツくらい穿きやがれッ！
						;「てへぺろ・ω＜」
					CASE 0
						BTL_KOJO_RESULTS:0 = 『人の子よ、うら若き娘よ
						BTL_KOJO_RESULTS:1 = 　汝の勇敢さに敬意を表しよう』
						;「うわぁ！急に冷静になるなぁ！」
				ENDSELECT
			ELSEIF NO:(FLAG:행동순1) == [[キャラ:하트호르]]
				;ハトホルがCOOP発動
				SELECTCASE RAND:3
					CASE 2
						BTL_KOJO_RESULTS:0 = 『美神ハトホルよ、やはり汝は佳い女だな』
					CASE 1
						BTL_KOJO_RESULTS:0 = ハトホルが頑張ってンだ、負けてられねェな！
					CASE 0
						BTL_KOJO_RESULTS:0 = 『ハトホル、汝は血塗れでも美しい』
				ENDSELECT
			ELSEIF NO:(FLAG:행동순1) == [[キャラ:토트]]
				;トートがCOOP発動
				SELECTCASE RAND:2
					CASE 1
						BTL_KOJO_RESULTS:0 = 『知神トートよ、常に汝の判断は的確だ』
					CASE 0
						BTL_KOJO_RESULTS:0 = 流石だぜ、トート！
				ENDSELECT
			ELSEIF NO:(FLAG:행동순1) == [[キャラ:세베크]]
				;トートがCOOP発動
				SELECTCASE RAND:2
					CASE 1
						BTL_KOJO_RESULTS:0 = 『軍神セベクよ、ここは汝の勇猛さを恃むとしよう』
					CASE 0
						BTL_KOJO_RESULTS:0 = カッコいいじゃねェか、セベク！
				ENDSELECT
			ELSE
				SELECTCASE RAND:4
					CASE 3
						BTL_KOJO_RESULTS:0 = 『好機なり、仕留めよ！』
					CASE 2
						BTL_KOJO_RESULTS:0 = ハッハァ！　今日は焼肉パーティーだな！
					CASE 1
						BTL_KOJO_RESULTS:0 = 介錯してやれ！
					CASE 0
						BTL_KOJO_RESULTS:0 = でかした！
				ENDSELECT
			ENDIF
		ENDIF
	;被召喚時
	CASE "被召喚"
		BTL_KOJO_RESULTS:0 = 
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE "与ダメージ_単体"
		IF BASE:(ARG:1):ＨＰ <= 0
			SELECTCASE RAND:3
				CASE 2
					BTL_KOJO_RESULTS:0 = これでくたばれ！
				CASE 1
					BTL_KOJO_RESULTS:0 = %CSTR:일인칭%を舐めるなよ！
				CASE 0
					BTL_KOJO_RESULTS:0 = 『介錯仕る！』
			ENDSELECT
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				SELECTCASE RAND:3
					CASE 2
						BTL_KOJO_RESULTS:0 = チッ、ガードの堅い野郎だ
					CASE 1
						BTL_KOJO_RESULTS:0 = でもよ、手応えは感じたぜ
					CASE 0
						BTL_KOJO_RESULTS:0 = 知ってンだよ、『弱い』から『守る』ンだってことをな
				ENDSELECT
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			SELECTCASE RAND:4
				CASE 3
					BTL_KOJO_RESULTS:0 = クリーンヒットだ！
				CASE 2
					BTL_KOJO_RESULTS:0 = 大分グロッキーみてェだな！
				CASE 1
					BTL_KOJO_RESULTS:0 = セコンドに頼めよ、タオル投げてもらうなら今のうちだぜ
				CASE 0
					BTL_KOJO_RESULTS:0 = 『今ならば命だけは助けてやらぬでもないぞ』
			ENDSELECT
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			SELECTCASE RAND:2
				CASE 1
					BTL_KOJO_RESULTS:0 = 今のはそこそこ効いたンじゃないか？　ええ？
				CASE 0
					BTL_KOJO_RESULTS:0 = 『斃れぬのならば、斃れるまで叩けば良い』
			ENDSELECT
		ELSEIF ARG:2 > 0
			SELECTCASE RAND:6
				CASE 4
					BTL_KOJO_RESULTS:0 = さっさと倒れやがれ！
				CASE 3
					BTL_KOJO_RESULTS:0 = 『斃れぬのならば、斃れるまで叩くだけのこと』
				CASE 2
					BTL_KOJO_RESULTS:0 = チッ、塩漬けにしようッて魂胆かよ
				CASE 1
					BTL_KOJO_RESULTS:0 = 面倒くせェー……
				CASE 0
					BTL_KOJO_RESULTS:0 = しれッとした面しやがって、ムカつくぜ
			ENDSELECT
		;無効された
		ELSE
			SELECTCASE RAND:3
				CASE 2
					BTL_KOJO_RESULTS:0 = オイ全然効いてねェぞ！
				CASE 1
					BTL_KOJO_RESULTS:0 = マジかよ、無効化しやがった！
				CASE 0
					BTL_KOJO_RESULTS:0 = チッ、マズったぜ
			ENDSELECT
		ENDIF
	;反射された
	CASE "反射された"
		SELECTCASE RAND:3
			CASE 2
				BTL_KOJO_RESULTS:0 = うぉッ！？　反射かよ！
			CASE 1
				BTL_KOJO_RESULTS:0 = マジかよ、反射しやがった！
			CASE 0
				BTL_KOJO_RESULTS:0 = ふざけンな！
		ENDSELECT
	;回避された
	CASE "回避された"
		SELECTCASE RAND:3
			CASE 2
				BTL_KOJO_RESULTS:0 = ちょこまかすンじゃねェ！
			CASE 1
				BTL_KOJO_RESULTS:0 = 何勝手に避けてンだよ！
			CASE 0
				BTL_KOJO_RESULTS:0 = スクカジャくれ、スクカジャ！　スクンダでもいい
		ENDSELECT
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE "被ダメージ_単体"
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			SELECTCASE RAND:7
				CASE 6
					BTL_KOJO_RESULTS:0 = 済まん……アモン……
				CASE 5
					BTL_KOJO_RESULTS:0 = 畜生……！
				CASE 4
					BTL_KOJO_RESULTS:0 = この%CSTR:일인칭%としたことが……なんてザマだぜ……
				CASE 3
					BTL_KOJO_RESULTS:0 = %CALLNAME:MASTER%……済まねえ……
				CASE 2
					BTL_KOJO_RESULTS:0 = おのれ……ッ！
				CASE 1
					BTL_KOJO_RESULTS:0 = 今日も……何処かで……
				CASE 0
					BTL_KOJO_RESULTS:0 = 『これは奇な……！？』
			ENDSELECT
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			SELECTCASE RAND:6
				CASE 5
					BTL_KOJO_RESULTS:0 = やりやがッたな……！
				CASE 4
					BTL_KOJO_RESULTS:0 = 今のは結構来たぜ……！
				CASE 3
					BTL_KOJO_RESULTS:0 = ヘッ……なかなかいいパンチじゃねェか……！
				CASE 2
					BTL_KOJO_RESULTS:0 = 悪くないパンチだがよォ！
				CASE 1
					BTL_KOJO_RESULTS:0 = 今のはガツンと来たぜ……
				CASE 0
					BTL_KOJO_RESULTS:0 = 『此奴め、天稟がありおる』
					;否、奴はすくたれものにござる
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 3
					BTL_KOJO_RESULTS:0 = 『鍛えが足らぬな』
				CASE 2
					BTL_KOJO_RESULTS:0 = あンまし%CSTR:일인칭%を舐めンじゃねェぞ！
				CASE 1
					BTL_KOJO_RESULTS:0 = 痛ッてェな！
				CASE 0
					BTL_KOJO_RESULTS:0 = 『是非に及ばず』
			ENDSELECT
		ENDIF
	;無効化した
	CASE "無効化した"
		;吸収した
		IF GET_CREC_ACT(ARG:1, ARG, "DRAIN")
			SELECTCASE RAND:3
				CASE 2
					BTL_KOJO_RESULTS:0 = あ？　今なんかしたか？
				CASE 1
					BTL_KOJO_RESULTS:0 = その程度じゃ痛くも痒くもねェな！
				CASE 0
					BTL_KOJO_RESULTS:0 = 『その魔力、貰ったぞ』
			ENDSELECT
		;無効化した
		ELSE
			SELECTCASE RAND:3
				CASE 2
					BTL_KOJO_RESULTS:0 = 『論ずるに足らず』
				CASE 1
					BTL_KOJO_RESULTS:0 = ……痛くも痒くもねェな
				CASE 0
					BTL_KOJO_RESULTS:0 = 今のはジャブだよな？
			ENDSELECT
		ENDIF
	;反射した
	CASE "反射した"
		SELECTCASE RAND:3
			CASE 2
				BTL_KOJO_RESULTS:0 = あ？　今なんかしたか？
			CASE 1
				BTL_KOJO_RESULTS:0 = 『痛痒も覚えぬな』
			CASE 0
				BTL_KOJO_RESULTS:0 = なんだ？　そっちが拳痛めたのか？
		ENDSELECT
	;回避した
	CASE "回避した"
		SELECTCASE RAND:3
			CASE 2
				BTL_KOJO_RESULTS:0 = おっと！　あッぶねェな！
			CASE 1
				BTL_KOJO_RESULTS:0 = どこに眼ェつけてンだ？
			CASE 0
				BTL_KOJO_RESULTS:0 = 『蠅が止まるようだな』
		ENDSELECT
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE "与ダメージ_範囲_ランダム"
		;全弾命中した
		IF GET_CREC_ACT_SUM(ARG, "敵", "MISS/BLOCK/DRAIN/REFLECT") == 0
			SELECTCASE RAND:3
				CASE 2
					BTL_KOJO_RESULTS:0 = よッしゃ！
				CASE 1
					BTL_KOJO_RESULTS:0 = 『児戯も同然なり』
				CASE 0
					BTL_KOJO_RESULTS:0 = ちょろいもンだぜ
			ENDSELECT
		;全弾回避された
		ELSEIF GET_CREC_ACT_SUM(ARG, "敵", "HIT") == 0
			SELECTCASE RAND:3
				CASE 2
					BTL_KOJO_RESULTS:0 = ふざけンな！！
				CASE 1
					BTL_KOJO_RESULTS:0 = 何勝手に避けてンだよ！
				CASE 0
					BTL_KOJO_RESULTS:0 = スクカジャくれ、スクカジャ！　スクンダでもいい！
			ENDSELECT
		;普通
		ELSE
			SELECTCASE RAND:3
				CASE 2
					BTL_KOJO_RESULTS:0 = ま、こんなもンだろうな
				CASE 1
					BTL_KOJO_RESULTS:0 = 数撃ちゃ当たるッてな！
				CASE 0
					BTL_KOJO_RESULTS:0 = まだまだ！
			ENDSELECT
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE "与ダメージ_範囲_ランダム_撃破あり"
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			SELECTCASE RAND:3
				CASE 2
					BTL_KOJO_RESULTS:0 = よッしゃ！　殲滅！
				CASE 1
					BTL_KOJO_RESULTS:0 = 所詮%CSTR:일인칭%の敵じゃねェよ！
				CASE 0
					BTL_KOJO_RESULTS:0 = 『我が一撃は万物を弾き出す』
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 2
					BTL_KOJO_RESULTS:0 = 次こそは死ンどけよ！
				CASE 1
					BTL_KOJO_RESULTS:0 = 次はてめェだぞ
				CASE 0
					BTL_KOJO_RESULTS:0 = 『ほう、生き残りがいたか』
			ENDSELECT
		ENDIF
	;敵味方全体攻撃(詳細処理無し)
	;CASE "敵味方全体攻撃"
	;	BTL_KOJO_RESULTS:0 = 
	;反撃を発動した
	CASE "反撃発動"
		SELECTCASE RAND:4
			CASE 3
				BTL_KOJO_RESULTS:0 = ジョルトカウンターだッ！
			CASE 2
				BTL_KOJO_RESULTS:0 = 倍返しは男の基本だぜ！
			CASE 1
				BTL_KOJO_RESULTS:0 = 『今度は我の番であるぞ』
			CASE 0
				BTL_KOJO_RESULTS:0 = レンジを見誤ったな！
		ENDSELECT
	;トリガースキルを発動した
	CASE "追撃発動"
		SELECTCASE TFLAG:발동연동스킬
			;スキルを指定したい場合、反撃と同様、対象スキルの番号をCASEに記載する
			;CASE (対象スキル番号)
			;	BTL_KOJO_RESULTS:0 = 
			;その他
			CASEELSE
				BTL_KOJO_RESULTS:0 = クソ面白ェ！
		ENDSELECT
	;バッドステータスを受けた
	CASE "被バステ付着"
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				BTL_KOJO_RESULTS:0 = ウハハハハッ！！　今日死ンじまうのが勿体ねェよ！！
			;ここはまとめてもよかろう
			CASE "SHOCK", "FREEZE", "BIND", "PALYZE"
				BTL_KOJO_RESULTS:0 = 動けねェ……
			CASE "PANIC"
				BTL_KOJO_RESULTS:0 = %CALLNAME:MASTER%が5人に見えるぜ……
			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 = 眠……クソ……が……
			CASE "CLOSE"
				BTL_KOJO_RESULTS:0 = 魔法が使えねェだとォ！？
			CASE "POISON"
				BTL_KOJO_RESULTS:0 = 毒だァ！？　何とかなンねェのかアモン！
			CASE "BOMB"
				BTL_KOJO_RESULTS:0 = 爆弾だァ！？　何とかなンねェのかアモン！
			CASE "CHARM"
				BTL_KOJO_RESULTS:0 = %CSTR:일인칭%ともあろうものがギンギンだぜ……
			CASE "CURSE"
				BTL_KOJO_RESULTS:0 = 呪いだァ！？　何とかなンねェのかアモン！
			CASE "FLY"
				BTL_KOJO_RESULTS:0 = ＊＊＊ブブブブ……！＊＊＊
			CASE "STONE"
				BTL_KOJO_RESULTS:0 = ＞石になっている。
			CASE "FLAME"
				BTL_KOJO_RESULTS:0 = 燃えてるじゃねェか！　何とかしろアモン！
			CASE "SLIP"
				BTL_KOJO_RESULTS:0 = 滑るじゃねェか！　クソァ！
			CASE "BRAND"
				BTL_KOJO_RESULTS:0 = 烙印だァ！？　何とかなンねェのかアモン！
			;その他の状態異常
			;CASEELSE
		ENDSELECT
	;バトルに勝利した
	CASE "戦闘勝利"
		SELECTCASE RAND:11
			CASE 10
				BTL_KOJO_RESULTS:0 = 『血が冷えてゆく……』
			CASE 9
				BTL_KOJO_RESULTS:0 = 『我は汝、汝は我なり』！
			CASE 8
				BTL_KOJO_RESULTS:0 = アモン鬼強ェ！
				BTL_KOJO_RESULTS:1 = このまま敵全員ブチ殺していこうぜ！
			CASE 7
				BTL_KOJO_RESULTS:0 = 『快絶至極！』
			CASE 6
				BTL_KOJO_RESULTS:0 = で、俺の残虐行為手当はどんなもンだ？
			CASE 5
				BTL_KOJO_RESULTS:0 = やッたぜアモン！
			CASE 4
				BTL_KOJO_RESULTS:0 = 『畏れよ、魔神の力を……！』
			CASE 3
				BTL_KOJO_RESULTS:0 = いい喧嘩だったぜ
			CASE 2
				BTL_KOJO_RESULTS:0 = %CSTR:일인칭%は捨てた……愛も、夢も、故郷も……
			CASE 1
				BTL_KOJO_RESULTS:0 = 今の%CSTR:일인칭%に安らぎは要らねェ
			CASE 0
				BTL_KOJO_RESULTS:0 = ハァ　　　　　　ハァ　　　ハァ
				BTL_KOJO_RESULTS:1 = 　　　　ハァ　　　　ハァ
				BTL_KOJO_RESULTS:2 = 　　ハァ　　　ハァ　　ハァ
		ENDSELECT
	;レベルアップした
	CASE "レベルアップ"
		SELECTCASE RAND:6
			CASE 5
				BTL_KOJO_RESULTS:0 = わかるンだよ、%CSTR:일인칭%の中のアモンが力を取り戻していってる
			CASE 4
				BTL_KOJO_RESULTS:0 = これが悪魔の力か……！
			CASE 3
				BTL_KOJO_RESULTS:0 = 『これが……人の子のみが持つ、可能性の……』
			CASE 2
				BTL_KOJO_RESULTS:0 = 変わった？　進化したッて言ってくれよ
			CASE 1
				BTL_KOJO_RESULTS:0 = 今の俺に限界はねェぜ！
			CASE 0
				BTL_KOJO_RESULTS:0 = 快調快調！　前より調子がいいくらいだぜ
		ENDSELECT
	;逃走に成功した
	CASE "逃走成功"
		SELECTCASE RAND:4
			CASE 3
