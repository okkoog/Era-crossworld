;-------------------------------------------------
;コマンド実行時のセリフ CFLAG 300～500
;-------------------------------------------------
;=================================================
;愛撫系コマンド
;=================================================
;-------------------------------------------------
;0,애무
;-------------------------------------------------
SELECTCASE SELECTCOM
	CASE 0
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:300 == 0
			PRINTFORMW 「손대지 마！　그렇게 만지면！」
			PRINTFORMW 가까워지는 것만으로、%TARGET은% 영맹한 고양이같이 날뛰었다。터무니없는 반작용이다。
				IF FLAG:39 >= 1
					PRINTFORMW 노예를 매각한 경험도 있는 %PLAYER가%었지만、이 정도나 되는 소녀는 드물다。
				ELSEIF (FLAG:33 + FLAG:34 + FLAG:35) >= 1
					PRINTFORMW 이미 몇번이나 조교경험이 있는 %PLAYER가%었지만、이 정도나 되는 소녀는 드물다。
				ELSE
					PRINTFORMW 충분한 조교달성 경험이 있는 %PLAYER는%、자신에게 이 소녀를 조교할 수 있을지 간간히 불안해진다。
				ENDIF
			PRINTFORMW 솔직히 몇 번이나 거절당했으나、반복적으로 %PLAYER가% 찝적거렸기에, 그녀도 피로가 쌓여 움직임이 둔해졌다.
			PRINTFORMW 그 틈을 타서 손을 꺾은 뒤 넘어뜨렸고、그 뒤 팔다리를 움직이지 못하게 아예 그녀 위에 올라탔다.
			PRINTFORMW 「구윽！　이！　놔、놔란 말야！！」
			PRINTFORMW 고함소리에 고막이 터질 것 같으면서도 그 와중에 가랑이 사이로 손을 뻗었다. 그녀는 타인에게 보여지면 안돼는 곳이 보인다는 생각에 얼굴이 빨갛게 물들었다.
			PRINTFORMW 이대로 여자인 것을 깨닫게 한다면、라고 %PLAYER는% 생각하는 순간、
			PRINTFORMW 「잔인하게 썰어주겠어！！」
			PRINTFORMW 점점 격앙하기 시작하는 %TARGET을% 보니 역시 그리 쉽게 풀리지만은 않을 것 같다는 생각이 들었다.
			CFLAG:300 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:300 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					SELECTCASE RAND:3
						CASE 2
							PRINTFORMW 「앙…정말、음란하다니까♪」
						CASE 1
