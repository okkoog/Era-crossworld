	IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
		IF RAND:100 <= 70
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 앙 __P0__ 수중이 미쳐 버려 ……응 __P1__
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 응……하아, 하아……__P0__……응? 아, 그, 그랬다, __P1__ 쓰네요!
			ELSE
				BTL_KOJO_RESULTS:0 = 하아, 하아……아, 아이템, 사용하지 않으면……__P0__! !　……라고, 이것, 바이브였다……
			ENDIF
		ENDIF
	;それ以外
	ELSE
		;アイテム使用、共通３割、個別５割、２割なにもなし
		;共通（陥落）
		RandCheck = RAND:100
		
		IF RandCheck <= 30
		
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = __P0__ 사용해라!　그래!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = __P0__! 갈거야!
			ELSE
				BTL_KOJO_RESULTS:0 = 아이템 사용! !
			ENDIF
		;個別
		ELSEIF RandCheck >= 50
			;回復アイテム使用
			IF RANGE(CFLAG:ARG:입력행동,3001, 3007) || RANGE(CFLAG:ARG:입력행동,3070, 3071) || RANGE(CFLAG:ARG:입력행동,3075, 3077) || CFLAG:ARG:입력행동 == [[스킬:생옥]]
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 괜찮아! ? 지금 __P0__로 회복하니까! !
				ELSE
					BTL_KOJO_RESULTS:0 = 네, __P0__! 열심히! !
				ENDIF
			;蘇生アイテム使用
			ELSEIF RANGE(CFLAG:ARG:입력행동,3008, 3009)
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 괜찮아! ? 나쁘지만 조금 더 노력해! !
				ELSE
					BTL_KOJO_RESULTS:0 = __P0__! ! 좋았어, 깨달았다! ?
				ENDIF
			;디스포이즌
			ELSEIF CFLAG:ARG:입력행동 == [[스킬:디스포이즌]]
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 독을 치료하라! __P0__! !
				ELSE
					BTL_KOJO_RESULTS:0 = __P0__! ! 왜, 독은 사라졌다! ?
				ENDIF
			;디스패라이즈
			ELSEIF CFLAG:ARG:입력행동 == [[스킬:디스패라이즈]]
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 가려움을 치료하지 않으면! __P0__! !
				ELSE
					BTL_KOJO_RESULTS:0 = __P0__! ! 어째서, 움직일 수 있게 되었다! ?
				ENDIF
			;디스챰
			ELSEIF CFLAG:ARG:입력행동 == [[스킬:디스챰]]
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 빨리 정기적으로 돌아가세요! __P0__! !
				ELSE
					BTL_KOJO_RESULTS:0 = __P0__! ! 어때? 진정?
				ENDIF
			;ディススト~ン
			ELSEIF CFLAG:ARG:입력행동 == [[스킬:디스톤]]
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 석화를 치료하자! __P0__! !
				ELSE
					BTL_KOJO_RESULTS:0 = __P0__! ! 어째서, 움직일 수 있게 되었다! ?
				ENDIF
			;디스클로즈
			ELSEIF CFLAG:ARG:입력행동 == [[스킬:디스클로즈]]
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 지금 되돌릴 테니까! __P0__! !
				ELSE
					BTL_KOJO_RESULTS:0 = __P0__! ! 목의 상태는 어때?
				ENDIF
			;崖っ緑粉末
			ELSEIF CFLAG:ARG:입력행동 == [[스킬:벼랑끝분말]]
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 모두……나중에 부탁해……어! __P0__! !
				ELSE
					BTL_KOJO_RESULTS:0 = 이대로 전멸할 정도라면……! __P0__, 부탁해! !
				ENDIF
			;攻撃アイテム使用（炎系）
			ELSEIF RANGE(CFLAG:ARG:입력행동,3101, 3104)
				IF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = __P0__로 불타 버립니다! !
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 불타라! ! __P0__! !
				ELSE
					BTL_KOJO_RESULTS:0 = 불꽃, 서투른거야? ……후훗, 유감이었다 ♪ __P0__! !
				ENDIF
			;攻撃アイテム使用（氷系）
			ELSEIF RANGE(CFLAG:ARG:입력행동,3105, 3106)
				IF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = __P0__에서 얼어! !
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 얼어! ! __P0__! !
				ELSE
					BTL_KOJO_RESULTS:0 = 얼음, 서투른거야? ……후훗, 유감이었다 ♪ __P0__! !
				ENDIF
			;攻撃アイテム使用（雷系）
			ELSEIF RANGE(CFLAG:ARG:입력행동,3107, 3108)
				IF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = __P0__로 가려워! !
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 감전 공격! ! __P0__! !
				ELSE
					BTL_KOJO_RESULTS:0 = 번개, 서투른? ……후훗, 유감이었다 ♪ __P0__! !
				ENDIF
			;攻撃アイテム使用（万能系）
			ELSEIF RANGE(CFLAG:ARG:입력행동,3109, 3112)
				IF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = __P0__로 만능 공격! ! ……라고 할까, 이미 무기야, 이거……
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 폭발하라! ! __P0__! !
				ELSE
					BTL_KOJO_RESULTS:0 = 채산 무시의 선물 ♪ 이것으로 끝! ! __P0__! !
				ENDIF
			;攻撃アイテム使用（その他）
			ELSEIF RANGE(CFLAG:ARG:입력행동,3113, 3132)
				IF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = __P0__로 아파요? 깨어라! !
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 재력도 힘 가운데 ……라고 ♪ __P0__! !
				ELSE
					BTL_KOJO_RESULTS:0 = 후훗, 이 공격에 견딜 수 있을까? __P0__! !
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF

