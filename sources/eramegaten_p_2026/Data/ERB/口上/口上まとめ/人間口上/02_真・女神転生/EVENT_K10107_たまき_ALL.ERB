				PRINTFORMW 
				CFLAG:369 = 3
			;それ以外
			ELSEIF CFLAG:369 < 2 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:369 = 2
			ENDIF
		ENDIF

