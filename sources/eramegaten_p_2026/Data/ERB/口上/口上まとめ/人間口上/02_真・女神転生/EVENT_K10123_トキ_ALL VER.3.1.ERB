;簡易助手口上の発動時に初調教時口上をスキップ（Y1を助手のキャラ番号にする）
;複数人いる際には、SIF NO:ASSI == Y1 || NO:ASSI == Z1と追加していく
;--------------------------------------------------
;IF CFLAG:201 == 0 && ASSI > 0
;	SIF NO:ASSI == Y1
;		CFLAG:201 =1
;ENDIF
;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	WSTR:(K++) = %CALLNAME:MASTER%は、この間迎え入れた%CALLNAME:TARGET%を閉じ込めている部屋へと足を運んだ。
	WSTR:(K++) = 「なんだここは？」
	WSTR:(K++) = %CALLNAME:MASTER%は%CALLNAME:TARGET%にここに連れてきた理由を説明する
	WSTR:(K++) = 「そういうことか…%CSTR:이인칭%は人売りなのか…」
	WSTR:(K++) = 「まあいい、強いものに従うのはガイア教の教えだ」
	WSTR:(K++) = 「%CSTR:이인칭%は%CSTR:일인칭%に勝ってここに連れてきたからな」
	WSTR:(K++) = 「煮るなり焼くなり好きにするといい」
	WSTR:(K++) = まるで14歳と感じられないほど肝が据わっている
	WSTR:(K++) = そんなことも構わず%CALLNAME:MASTER%は調教を開始する
	CFLAG:201 = 1
	GOTO 表示
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	WSTR:(K++) = 「…」
	WSTR:(K++) = %CALLNAME:TARGET%は自分の体をまさぐっている
	WSTR:(K++) = 「…%CSTR:이인칭%、%CSTR:일인칭%の体に何かしたか？」
	WSTR:(K++) = %CALLNAME:MASTER%は調教の成果が体に出てきた証拠だと言った
	WSTR:(K++) = 「そうか、ならいいんだけど…」
	CFLAG:201 = 2
	GOTO 表示
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	WSTR:(K++) = 「…ん」
	WSTR:(K++) = %CALLNAME:TARGET%は自分の体をまさぐっている
	WSTR:(K++) = 胸や股を触ったとき、少し感じていることがわかる
	WSTR:(K++) = 「%CSTR:일인칭%の体に本当に大丈夫なんだよな」
	WSTR:(K++) = %CALLNAME:MASTER%は奴隷はこれが普通だといった
	WSTR:(K++) = 「そうか…これが普通なんだな」
	CFLAG:201 = 3
	GOTO 表示
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	IF EXP:이상경험 < 2
		WSTR:(K++) = 「少し%CSTR:일인칭%の体がおかしくなっているんだ…」
		WSTR:(K++) = 「なんか…%CSTR:이인칭%を見てると…胸が…ドキドキしてる…」
		WSTR:(K++) = %CALLNAME:TARGET%の様子を見るとだいぶ従順になってきた
		
	ELSEIF (ABL:Ａ감각 + ABL:Ｃ감각 + ABL:Ｂ감각 + ABL:Ｖ감각) > 10
	
		WSTR:(K++) = 「%CSTR:이인칭%、少し私の体がおかしくなっているんだ…」
		WSTR:(K++) = 「なんか…お股の所が…すごく…じんじんしてる…」
		WSTR:(K++) = %CALLNAME:TARGET%の表情を見るとだいぶ淫らになってきた
	ELSE
		WSTR:(K++) = 「%CSTR:이인칭%か…調教しに来たのだな」
		WSTR:(K++) = %CALLNAME:TARGET%はいつもより従順になっている
		WSTR:(K++) = だいぶ奴隷らしくなってきたことがわかる
	ENDIF
	CFLAG:201 = 4
	GOTO 表示
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		CSTR:이인칭 = 主様
			WSTR:(K++) = 「あ…あの…」
			WSTR:(K++) = 「%CSTR:일인칭%、こんな感情は初めてで…まだ戸惑ってるけど…」
			WSTR:(K++) = 「一緒にいると…うれしいし…楽しい…」
			WSTR:(K++) = 「だから…大好きです…%CSTR:이인칭%…%UNICODE(0x2661)%」
		IF CFLAG:미조교함락 == 1
			;調教せずに恋慕をつけた場合
			;WSTR:(K++) = 
		ELSE
		ENDIF
	;음란
	ELSEIF TALENT:4
		WSTR:(K++) = 「…はあ…はあ…」
		WSTR:(K++) = %CALLNAME:TARGET%は自分の体をまさぐっている
		WSTR:(K++) = 股と乳首をいじくって自慰しているのが分かる
		WSTR:(K++) = 「…ダメ…指が…止まんないよぉ…%UNICODE(0x2661)%」
		WSTR:(K++) = 「ああ…%CSTR:이인칭%、待ちくたびれたぞ…」
		WSTR:(K++) = 「頼む…早く…この体に…エッチなことしてえ…%UNICODE(0x2661)%」
	;복종
	ELSEIF TALENT:5
		WSTR:(K++) = 「%CSTR:일인칭%は%CSTR:이인칭%のことを侮っていた…」
		WSTR:(K++) = 「まさか、%CSTR:이인칭%にここまで心を支配させられるとは思ってなかった…」
		WSTR:(K++) = 「これからは%CSTR:이인칭%の下僕になる…」
		CSTR:이인칭 = 主様
		WSTR:(K++) = 「だから…改めてよろしくお願いします…%CSTR:이인칭%…」
	ENDIF
	;共通
	IF KSTR:0 == "" && WSTR:0 == "" && NSTR:0 == ""
		KSTR:(K++) = 
	ENDIF
	CFLAG:201 = 5
	GOTO 表示
ENDIF

