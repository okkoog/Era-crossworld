@KOJO_BATTLE_EVENT_K[[キャラ:엘라_무기미도]], ARG, ARG:1, ARG:2
;---- EDIT 002 ADD START -------------------------
;IF CFLAG:814 == 0  && BASE:ARG:LV > 16
;	CALL K[[キャラ:엘라_무기미도]]_SKILL_REPAIR
