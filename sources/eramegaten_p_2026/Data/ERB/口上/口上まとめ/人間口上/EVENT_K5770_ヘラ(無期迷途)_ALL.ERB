;			LOCALS:14 = 五行目
;と増やしていく
SIF ARG < 0 && NO:ARG != 5770
	RETURN 0
VARSET LOCALS


SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 묵사발을 만들어 줄 테니까!
		ELSE
			BTL_KOJO_RESULTS:0 = 이 헤라 님의 뒤를 따르도록 해!
		ENDIF
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%의 뒤를 따를게!
			ELSE
				BTL_KOJO_RESULTS:0 = 가라앗!
			ENDIF 
		;それ以外
		ELSE
			BTL_KOJO_RESULTS:0 = %CSTR:일인칭%도 한바탕 날뛰어볼까!
		ENDIF
	;被召喚時
	CASE 3
			BTL_KOJO_RESULTS:0 = 
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメ~ジ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 좋아앗!
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 나이스 차-안스!
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメ~ジ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 에헤헤, 어~떠냐!
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = 으와, 엄청 단단하네-!
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			BTL_KOJO_RESULTS:0 = 뭐야 얘! 너무 단단하잖아!?
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = 하아? 말도 안 되거든!?
		ENDIF
	;被ダメ~ジ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメ~ジ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 엣, 나 아직……
		;大ダメ~ジ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 아프다구우…
			ELSE
				BTL_KOJO_RESULTS:0 = 아직 멀었어!
			ENDIF 
		;無効
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 아파~라(국어책)
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = 어이- 어이- 팍팍 덤벼보시지-!
		ENDIF
	;反射された
	CASE 15
			BTL_KOJO_RESULTS:0 = 엣, 진짜냐!?
	;反射した
	CASE 16
			BTL_KOJO_RESULTS:0 = 으-와 지 혼자 자멸했네!
	;回避された
	CASE 17
			BTL_KOJO_RESULTS:0 = 짱나게, 알짱거리기는…
	;回避した
	CASE 18
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 제법 굼벵이네-
		ELSE
			BTL_KOJO_RESULTS:0 = 어이- 어-이, 여기라구 여기
		ENDIF 
	;反撃スキル発動した
	CASE 20
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 답례다!
		ELSE
			BTL_KOJO_RESULTS:0 = 얕보지 말라고!
		ENDIF 
	;バトルに勝利した
	CASE 90
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 후우, 드디어 이겼네-
		ELSE
			BTL_KOJO_RESULTS:0 = %CSTR:이인칭%도 수고했어
		ENDIF 
	;レベルアップした
	CASE 91
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 아! 또 강해져 버린 모양이야-!
		ELSE
			BTL_KOJO_RESULTS:0 = 나… 이젠 완전 무적인 거 아냐~?
		ENDIF 
	;逃走に成功した
	CASE 92
			BTL_KOJO_RESULTS:0 = 이런 녀석 상대하고 있을 틈 없어!
	;逃走に失敗した
	CASE 93
			BTL_KOJO_RESULTS:0 = 끈질기기도 하지…
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 잠깐 이거 괜찮은 거야!? 
		ELSE
			BTL_KOJO_RESULTS:0 = 고- 고- 고-!
		ENDIF
	;バックアタックを受けた
	CASE 95
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 위험해…!?
		ELSE
			BTL_KOJO_RESULTS:0 = 잠깐만, 뒤에서 치기냐!?
		ENDIF
	;敵の先制攻撃を受けた
	CASE 96
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 위험해…!?
		ELSE
			BTL_KOJO_RESULTS:0 = 느닷없이!?
		ENDIF
	;先制攻撃に成功
	CASE 97
			BTL_KOJO_RESULTS:0 = 빈틈 발견!
ENDSELECT
