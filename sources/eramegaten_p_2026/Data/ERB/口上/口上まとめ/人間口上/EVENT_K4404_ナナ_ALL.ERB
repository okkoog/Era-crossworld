;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	PRINTFORMW 「어서 와, %CSTR:이인칭%」
	PRINTFORMW %CALLNAME%은 지금은 %CALLNAME:MASTER%의 곁에서 살아가고 있다
	PRINTFORMW 방에서 딱히 무얼 하는 것도 없이 멍하니 있었다. 취미를 엿볼 만한 짐도 원래 없었지만
　　　　PRINTFORMW 「……밥 아직 멀었어-?」
	PRINTFORMW 여전히 배고파하는 아가씨다. 운동에 어울려준다면 생각해보지
	PRINTFORMW 「운동… 어떤 거?」
	PRINTFORMW 성적인 운동. 에너지 드레인 소녀에게는 분명 재능이 있을 것이다
	PRINTFORMW 「………몸이 목적이었나. 뭐, 마음대로 하든가-?」
	CFLAG:201 = 1
	RETURN 0
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	PRINTFORMW 「오오, 찐 러브호텔이다-」
	PRINTFORMW 조교실로 %CALLNAME%을 불러냈다. 직접 경영하고 있으면 융통성이 발휘된다.
	PRINTFORMW 「시작하기 전에 놀다 와도 돼?」
	PRINTFORMW 수치심보다는 호기심이 앞서 있는 모양이다
	PRINTFORMW 신나게 놀아서 땀을 흘리면 목욕탕에 넣어야겠다
	CFLAG:201 = 2
	RETURN 0
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	PRINTFORML 「……괜찮아? 좀 더 억지스럽게 굴어도」
	PRINTFORML 슬슬 첫 경험의 본방을 재촉해도 좋을 듯하다
	CFLAG:201 = 3
	RETURN 0
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW 「…왠지 말이지, 계속 근질근질했어」
	PRINTFORMW 방에 들어서자마자 숨을 헐떡이는 %CALLNAME%이 밀어 쓰러뜨려 왔다.
	PRINTFORMW 「빨리… %CSTR:11%을 가득 채워줘……?」 
	CFLAG:201 = 4
	RETURN 0
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		;IF CFLAG:미조교함락 == 1
			;調教せずに恋慕をつけた場合
			;PRINTFORMW 
		;ELSE
			PRINTFORMW 「전투에서 힘이 되거나, 여자아이로서 사랑받거나…… 지금까지 여러 일이 있었지」
			PRINTFORMW %CALLNAME%답지 않게 말에 망설임이 있었다. 떠올렸다 삼키기를 반복하며 결의를 드러낸다
			PRINTFORMW 「반드시 여기가 좋은 곳은 아니고, %CALLNAME:MASTER%이 좋은 사람이 아니라는 것도 잘 알고 있어」
			PRINTFORMW 그 말대로라며 당신은 뻔뻔하게 %CALLNAME%의 유방에 손가락을 묻었고, 교성에 대화가 끊겼다.
			PRINTFORMW 「……성욕 마인. 이럴 때만큼은 진지하게 말하게 해주면 안 돼?」
			PRINTFORMW 약손가락을 흔들거리며 %CALLNAME%은 호소하지만, 일명 방앗간이기도 한 장소에서 그런 소릴 들어봤자 곤란하다.
			PRINTFORMW 「어쨌든 난 여기가 마음에 드니까. 앞으로도 잘 부탁해」
			PRINTFORMW 색시가 하는 말이니 감사히 받아들이자
		;ENDIF
	;음란
	ELSEIF TALENT:4
		PRINTFORMW 
	;복종
	ELSEIF TALENT:5
		PRINTFORMW 
	ENDIF
	CFLAG:201 = 5
	RETURN 0
ENDIF


