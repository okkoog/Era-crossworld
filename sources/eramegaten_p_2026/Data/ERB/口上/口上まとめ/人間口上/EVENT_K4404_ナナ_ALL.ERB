@EVENTTRAIN_SECOND_K[[キャラ:나나_소울해커즈]]
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORMW 「……죽여버린다」
	PRINTFORMW 「…농담이야. …아직은 말이지」
	CFLAG:202 = 4
;屈服刻印Lv0
ELSEIF MARK:2 == 0 && (CFLAG:202 < 1 || FLAG:7 == 2)
	PRINTFORMW 「또… 하는 거야-?」
	PRINTFORMW 「%CSTR:11%는 잘하지도 못하는데 은근히 잘 어울려주네」
	CFLAG:202 = 1
;屈服刻印Lv1
ELSEIF MARK:2 == 1 && (CFLAG:202 < 2 || FLAG:7 == 2)
	PRINTFORMW 「……이것저것 가르쳐주는 거…… 제법 재밌어」
	CFLAG:202 = 2
;屈服刻印Lv2
ELSEIF MARK:2 == 2 && (CFLAG:202 < 3 || FLAG:7 == 2)
	PRINTFORMW 「시작할까? %CSTR:12%」
	PRINTFORMW %CALLNAME% 쪽에서 먼저 유혹해왔다. 조교 시간이 제법 기대되는 모양이다
	PRINTFORMW 「헤헤, 원조교제 시간이야」
	PRINTFORMW 학생도 아니잖아, 너
	CFLAG:202 = 3
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0) && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORMW 「왠지 전장의 추억보다 침대 위의 추억이 더 많아진 것 같네」
	PRINTFORMW 「……그것도 우리답긴 하지만」
	CFLAG:202 = 4
;陥落済み
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		
		;父親があなた
			IF CFLAG:102 == 1
				PRINTFORML %CALLNAME%은 %CALLNAME:MASTER%을 보자 헤실헤실 웃었다.
				PRINTFORML 「아…… 아빠%UNICODE(0x2661)%」
				PRINTFORML 「응후후%UNICODE(0x2661)% 자 봐, 아빠라구-?」
				PRINTFORML 「…………………같이 할래?」
				PRINTFORML 엄마일지도 모르잖아?
			;あなた以外
			ELSE
				PRINTFORML %CALLNAME%은 문을 연 %CALLNAME:MASTER%을 향해 게슴츠레한 눈길을 보냈다.
				PRINTFORML 「………아, 아저씨다」
				PRINTFORML 책망하는 듯한 %CALLNAME%의 목소리를 그저 받아들일 수밖에 없었다.
				PRINTFORML 「아저씨 소리 듣기 싫으면 %CSTR:12%가 똑바로 임신시키면 되잖아……」
				PRINTFORML 지당하신 말씀입니다
			ENDIF
		ELSEIF 위험일() > 1
			IF TALENT:남자 || TALENT:후타나리
				PRINTFORMW 「%CSTR:12%의 아기… 키우고 싶어…」
				PRINTFORMW 「괜찮아… 부모가 될 자신은 있어…」
			ELSE
				PRINTFORMW 「몸이 %CSTR:12%를 갈구하는 게 느껴져……」
				PRINTFORMW 「그러니까… 좋아… 엉망진창으로 짓이겨줘…?」
			ENDIF
		ELSE
			K:1 = RAND:3
			IF K:1 == 0
				PRINTFORMW 「아, %CSTR:12%… 사랑의 시간…?」
				PRINTFORMW %CALLNAME%은 열기에 들뜬 눈빛으로 %CALLNAME:MASTER%을 바라보았다.
				PRINTFORMW 혼자 놀기에 열중하던 손가락에서는 애액이 뚝뚝 떨어지고 있다…
			ELSEIF K:1 == 1
				PRINTFORMW 「아-… %CALLNAME:MASTER%을 위해서 준비해뒀어-」
				PRINTFORMW %CALLNAME%은 실키에게 음료를 나르게 하고 있다…
				PRINTFORMW 「악마 부려먹는 법은 %CALLNAME:MASTER%한테 배운 거야…」
			ELSE
				PRINTFORMW 「간은 맞춰뒀어… 먹어줘…?」
				PRINTFORMW %CALLNAME%은 온몸이 음란한 윤기로 끈적이고 있다.
				PRINTFORMW 「…메롱-… 자지는 이러면 좋아 죽잖아-?」
				PRINTFORMW 틀린 말은 아니지만…
			ENDIF
		ENDIF
	;淫乱、娼婦
	;ELSEIF TALENT:4 || TALENT:7
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		;IF RAND:3 == 0
		;	PRINTFORMW 
		;ELSEIF RAND:2 == 0
		;	PRINTFORMW 
		;ELSE
		;	PRINTFORMW 
		;ENDIF
	;服従、隷属
	;ELSEIF TALENT:5 || TALENT:8
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		;IF RAND:3 == 0
		;	PRINTFORMW 
		;ELSEIF RAND:2 == 0
		;	PRINTFORMW 
		;ELSE
		;	PRINTFORMW 
		;ENDIF
	;その他、共通
	ELSE
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		IF RAND:3 == 0
			PRINTFORMW 
		ELSEIF RAND:2 == 0
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
	CFLAG:202 = 5

RETURN 0
