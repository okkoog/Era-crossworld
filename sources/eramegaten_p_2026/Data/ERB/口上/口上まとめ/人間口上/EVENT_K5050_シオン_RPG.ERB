;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:시온]], ARG, ARG:1, ARG:2
;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 5050
	RETURN 0
LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = EMPTY

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 予測通りですね。さあ、追撃を！
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = 凌ぎ切ったと思いましたか？　なら、その惰性はあなたを殺すことになる
		ELSE
			BTL_KOJO_RESULTS:0 = 計算通りです
		ENDIF
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = ほう。異世界のメイガスの手並み、中々のものですね
		;それ以外
		ELSE
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 立て直すための時など、作らせはしない
			ELSEIF !RAND:2
				BTL_KOJO_RESULTS:0 = 計算できない展開などありません
			ELSE
				BTL_KOJO_RESULTS:0 = 最適戦略を構築…　行きます！
			ENDIF
		ENDIF
	;被召喚時
	CASE 3
		BTL_KOJO_RESULTS:0 = 高速思考展開。戦闘、開始します
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = この結果は必然です
			ELSE
				BTL_KOJO_RESULTS:0 = 対象を撃破、連続戦闘への支障は皆無
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 耐え凌ぎますか。あまり煩わせないで欲しいものですが
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
;		;大ダメージ
;		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
;			BTL_KOJO_RESULTS:0 = 
;		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
;			BTL_KOJO_RESULTS:0 = 
;		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
;			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = （…落第だ、私は）
			ELSE
				BTL_KOJO_RESULTS:0 = うあああああっ！？　しまっ―――
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF RAND:2
				BTL_KOJO_RESULTS:0 = （生き延びた以上、まだ可能性は残っている…！）
			ELSE
				BTL_KOJO_RESULTS:0 = この程度、致命傷にはならない…！　戦闘、再開します！
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = あなたでは突破できない！
			ELSE
				BTL_KOJO_RESULTS:0 = 無駄な抵抗を…
			ENDIF
			
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = あなたの行動は、すべて事前に把握していますよ
		ENDIF
	;反射された
	CASE 15
			BTL_KOJO_RESULTS:0 = っ！？　データを修正しなければ…
	;反射した
	CASE 16
			BTL_KOJO_RESULTS:0 = それだけの戦術幅では、予測できない筈がない
	;回避された
	CASE 17
			BTL_KOJO_RESULTS:0 = うっ、間違っ…！
	;回避した
	CASE 18
			BTL_KOJO_RESULTS:0 = 亀ですか、あなたは
ENDSELECT
;SIF LOCALS != "EMPTY"
;	CALL MESSAGE_BL(LOCAL:1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)

