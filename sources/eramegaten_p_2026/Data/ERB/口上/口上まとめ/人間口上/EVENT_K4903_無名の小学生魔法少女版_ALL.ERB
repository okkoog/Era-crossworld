;ENDIF
;--------------------------------------------------
;調教終了時のセリフ
;--------------------------------------------------
DRAWLINE
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:217 < 1 || FLAG:7 == 2)
	PRINTFORML 「%CSTR:12%같은 거 정말 싫어！」
	PRINTFORMW 「이런 짓 절대로, 용서 못해！」
	CFLAG:217 = 1
;屈服刻印Lv1以下
ELSEIF MARK:2 <= 1 && (CFLAG:219 < 1 || FLAG:7 == 2)
	PRINTFORML 「이제야………」
	PRINTFORMW 「용서 못해, 용서 못하니깟！」
	CFLAG:219 = 1
;屈服刻印Lv2
ELSEIF MARK:2 == 2
	PRINTFORML 「…조금만 더 상냥하게 해주셨으면 좋겠어요오…………」
	PRINTFORMW 「이젠… 아으, 아무것도 아니에요」
	CFLAG:219 = 2
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORML 「아으으, 벌써 끝인가요？」
	PRINTFORMW 「조금만 더… 아으, 아무것도 아니에요」
	CFLAG:219 = 3
;陥落済み＋体力500未満
ELSEIF BASE:0 < 500 && (CFLAG:218 < 1 || FLAG:7 == 2)
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		PRINTFORML 아무래도 연인 마법소녀는 지칠대로 지친 모양이다。
		PRINTFORMW 위를 향해 누워 눈을 감고 호흡을 가다듬는 중이다。그것에 색기를 느껴, 입술을 그만 뚫어지게 쳐다보고 말았다。
		PRINTFORMl 그리고 충동적으로 %CALLNAME%의 입술을 자신의 입술로 막았다。
		PRINTFORMW 「응！ 으믑, 응, 하믓…… 츄…… 츄」
		PRINTFORML %CALLNAME은% 처음에는 놀랐지만, 도중부터는 이쪽의 머리를 팔로 누르고, 적극적으로 타액을 교환했다。
		PRINTFORML 「응츗, 하흐으, 에헤헤, 왜 그러시나요오？ 하믑, 아직도 부족하신건가요오, 하앙…… 츗…… 츄」
		PRINTFORMW 그 후, 30분동안 서로 입맞춤을 나누었다。
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		PRINTFORML 「하아하아하아, 대단해─에, %CSTR:11% 이제 몸에 힘이 안 들어가요오」
		PRINTFORMW 음란마법소녀는 만족한 듯 그리 말하고는, %MASTER를% 끌어안아, 얼굴을 비벼댔다。
		PRINTFORML 「에헤헤, %CSTR:12%는 어떠세요오？ %CSTR:11%의 몸으로 만족하셨나요오？」
		PRINTFORMW 그 질문에 %MASTER는% 고개를 끄덕인다。그것을 본 %CALLNAME은% 기쁜 듯 미소를 지으며,
		PRINTFORML 「다행이네요오。에헤헤, 역시 %CSTR:11%랑 %CSTR:12%는 몸의 상성이 좋아요오。
		PRINTFORMW 앞으로는, 더어 더─어 %CSTR:11%랑 엣치하는 거예요오。그러면 서로 기분 좋고 행복할 거예요오」
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORMW %CALLNAME:MASTER%의 행위의 더러움을 닦아내려고 다가오던 노예 마법소녀를 저지했다。
		PRINTFORML 「하아하아, 아으, 죄송합니다아」
		PRINTFORMW 아무래도 너무 지쳐 봉사할 겨를이 아닌 듯 했다。%MASTER는% 너무 심하게 했다는 걸 알아차렸지만 반성은 하지 않았다。
	ENDIF
	CFLAG:218 = 1
;陥落済み
ELSEIF CFLAG:219 < 4 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		PRINTFORML  「에헤헤, %CSTR:12%」
		PRINTFORMW 자신을 부르는 목소리에, 뭐냐, 하고 물으니,
		PRINTFORML 「아무것다도 아니예요오─。후후후」
		PRINTFORMW 라는 대답이 돌아왔다。일단 머리를 쓰다듬어준다。
		PRINTFORML 「하흐응。응─、스윽스윽」
		PRINTFORMW 그러니 연인마법소녀는 이쪽의 팔을 잡고, 거기에 자신의 얼굴을 묻으며 스윽스윽 비비기 시작했다。
		PRINTFORML 「에헤헤, 사랑해요, %CSTR:12%」
		PRINTFORMW 작은 목소리로 이야기할 생각이었겠지만 이쪽에도 확실히 들렸다。
		PRINTFORMW 이쪽도, 사랑해, 하고 대답하니 얼굴이 새빨갛게 되어 안겨왔다。
	;음란
	ELSEIF TALENT:4
		PRINTFORML 끝이라고 하니 %CALLNAME은% 불만스러운 듯, 뺨을 부풀리고, %CALLNAME:MASTER%에게 항의를 해왔다。
		PRINTFORMW 「에─、벌써 끝인가요오？ %CSTR:11%는 아직 가는 게 부족해요오」
		PRINTFORML
		IF BASE:0 > 800
			PRINTFORMW 음란마법소녀는 다른 무언가를 상상하며 자위에 몰두하기 시작했다。
			PRINTFORML
			K:1 = RAND:3
			IF K:1 == 0
				PRINTFORMW (오르트로스, 얼굴이 두 개, 그곳도 두 개, 두 개의 자지로 뒤에서 한꺼번에……)
			ELSEIF K:1 == 1
				PRINTFORMW (픽시 쨩의 요정바이브 같은 거, 찌릿찌릿 와서 대단할 거 같아, 엉덩이에……)
			ELSE
				PRINTFORMW (서큐버스 언니의 커다란 가슴에, 얼굴 파묻고, 언니의 자지로……)
			ENDIF
		ENDIF
	;창부
	ELSEIF TALENT:7
		PRINTFORML 끝이라고 하니 %CALLNAME은% 불만스러운 듯, 뺨을 부풀리고, %CALLNAME:MASTER%에게 항의를 해왔다。
		PRINTFORMW 「에─、벌써 끝인가요오？ %CSTR:11%는 아직아직 가는 게 부족해요오」
		PRINTFORMl 당분간 투덜투덜 불만을 흘리다가, 이것에도 질렸는지, 이번에는 자신의 몸을 만지작거리며 말한다。
		PRINTFORMW 「우─、너무 박정하게 굴면 바람피워버릴 거예요오？후후후、」
		PRINTFORML
		PRINTFORMW 음란마법소녀는 다른 무언가를 상상하며 자위에 몰두하기 시작했다。
		PRINTFORML
		K:1 = RAND:4
		IF K:1 == 0
			PRINTFORML (헤카테 아줌마, 얼굴이 세 개, 약을 써서 미츠나리로, 에헤헤,)
			PRINTFORMW 　　　　　　　　　　　　채찍으로 맞으면서 한꺼번에…… 언니라고 부르면서, 찰싹…………)
		ELSEIF K:1 == 1
			PRINTFORMW (앨리스 쨩의 귀여운 손이, 나의 그곳에 쑤컹쑤컹……)
			PRINTFORMW 　앨리스 쨩이, 둘, 귀여운 손이, 나의 그곳과 엉덩이에……
			PRINTFORMW 　 앨리스 쨩이, 셋, 귀여운 손이, 나의 그곳이랑 엉덩이랑……)
		ELSEIF K:1 == 2
			PRINTFORML (마법의 바이브가 위에서 춤추고 있다던가 하는, 악마 없는 테이블…………
			PRINTFORMW 　　　　　　　　　　　　　　　　　　　그 위에서 하면, %CSTR:12% 뿐 아니라…………)
		ELSE
			PRINTFORMW (%CSTR:12%의 도플갱어 같은 것도 부르면, 두 배로 갈 수 있을 거 같아요오……)
		ENDIF
	;복종
	ELSEIF TALENT:5
		PRINTFORML 「%CSTR:12%─, 몸을 닦을게요오」
		PRINTFORMW 행위가 끝난 뒤, 노예마법소녀는 티슈를 뽑아 %CALLNAME:MASTER%의 몸의 더러움을 기쁜 듯 닦기 시작했다。
		PRINTFORMW 「슥삭슥삭, 에헤헤, %CSTR:12%, 아프지는 않나요오？」
	;예속
	ELSEIF TALENT:8
		PRINTFORML 「%CSTR:12%─, 그곳 깨끗하게 할게요오」
		PRINTFORMW 행위가 끝난 뒤, 노예마법소녀는 무릎을 꿇고 %CALLNAME:MASTER%의 페니스를 기쁜 듯 핥기 시작했다。
		PRINTFORMW 「에헤헤, %CSTR:12%、깨끗히　깨끗히　기분 좋아요오？」
	ENDIF
	CFLAG:219 = 4
ENDIF
RETURN 0

