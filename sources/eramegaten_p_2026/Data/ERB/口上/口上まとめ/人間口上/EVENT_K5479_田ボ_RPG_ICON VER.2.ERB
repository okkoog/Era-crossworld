;-------------------------------------------------
;ライセンスについて
;-------------------------------------------------
;	・基本項目(許可する項目を"○"に、許可しない項目を"×"に変更してください。)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1| ○ | 処理上のバグ修正              |
;	+----+----+-------------------------------+
;	|   2| ○ | 口上の誤字・脱字の修正        |
;	+----+----+-------------------------------+
;	|   3| ○ | 口上まとめへの収録            |
;	+----+----+-------------------------------+
;	|   4| ○ | 口上の新規追加                |
;	+----+----+-------------------------------+
;	|   5| ○ | 既存口上の改変                |
;	+----+----+-------------------------------+
;	|   6| ○ | 改変した口上の自由な再配布    |
;	+----+----+-------------------------------+
;	|   7| ○ | 口上内容の転載                |
;	+----+----+-------------------------------+
;-------------------------------------------------
;BTL_KOJO_RESULTSに書きこむと
;台詞と一緒にキャラの画像を表示します。
;■台詞の行数を増やしたいときは
;			BTL_KOJO_RESULTS:0 = 一行目
;			BTL_KOJO_RESULTS:1 = 二行目
;			BTL_KOJO_RESULTS:2 = 三行目
;			BTL_KOJO_RESULTS:3 = 四行目
;			BTL_KOJO_RESULTS:4 = 五行目
;と増やしていく
;メッセージ前に文章を出したいなら
;			PRINTL
;			PRINTL
;ナレーション的なもので囲いの中にならない
;
;例
;
;PRINTL あいうえお
;PRINTL かきくけこ
;BTL_KOJO_RESULTS:0 = さしすせそ
;BTL_KOJO_RESULTS:1 = たちつてと
;　　↓
;あいうえお
;かきくけこ
;┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
;┃さしすせそ　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
;┃たちつてと　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
;┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
;
;-------------------------------------------------

@KOJO_ENEMY_BATTLE_EVENT_K[[キャラ:떡보]], ARG, ARG:1, ARG:2
IF TFLAG:전투이벤트 == 1
;敵でのデビルＣＯ－ＯＰ発動時の台詞
;			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"",72,LEFT%┃
;			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF
IF TFLAG:전투이벤트 == 2
;敵でのデビルＣＯ－ＯＰ参加時の台詞
;			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"",72,LEFT%┃
;			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF


;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:떡보]], ARG, ARG:1, ARG:2
#DIM L_OSM
;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 5479
	RETURN 0
VARSET BTL_KOJO_RESULTS
;VARSET KSTR


RESULT = 0
TRYCALLFORM O_S_MUSEUM_COOP_CHECK, ARG
L_OSM = RESULT

;KSTR:0 = 
;KSTR:1 = 
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		;ONE.SONG.ミュージアム有効
		IF L_OSM
			BTL_KOJO_RESULTS:0 = 木下大八、49歳～♪
			BTL_KOJO_RESULTS:1 = 大八は嘘をつくと怒る～♪
		ELSE
			BTL_KOJO_RESULTS:0 = 行くわよ！フィーバータイム！
		ENDIF
	;COOP参加
	CASE 2
		;ONE.SONG.ミュージアム有効
		IF L_OSM
			BTL_KOJO_RESULTS:0 = 木下大八、49歳～♪
			BTL_KOJO_RESULTS:1 = 大八は嘘をつくと怒る～♪
		;主人がCOOP発動
		ELSEIF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			IF !RAND:2
				BTL_KOJO_RESULTS:0 = 行くわ！フィーバータイムに参加よ♥
			ELSE
				BTL_KOJO_RESULTS:0 = 追撃するわよ♪
				BTL_KOJO_RESULTS:1 = えーい♥
			ENDIF
		;それ以外
		ELSE
			IF !RAND:2
				BTL_KOJO_RESULTS:0 = 行くわ！フィーバータイムに参加よ♥
			ELSE
				BTL_KOJO_RESULTS:0 = 追撃するわよ♪
				BTL_KOJO_RESULTS:1 = えーい♥
			ENDIF
		ENDIF
	;被召喚時
	CASE 3
			BTL_KOJO_RESULTS:0 = 召喚完了♥
			BTL_KOJO_RESULTS:1 = マジカルガール%CALLNAME:ARG%ちゃん登場よ♥
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;味方に攻撃した
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF !RAND:2
				BTL_KOJO_RESULTS:0 = とっておきなのよ♥
			ELSE
				BTL_KOJO_RESULTS:0 = これで決着ね♥　%CSTR:ARG:일인칭%の勝ち♥
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				IF !RAND:2
					BTL_KOJO_RESULTS:0 = ちっ　小賢しい
				ELSE
					BTL_KOJO_RESULTS:0 = フィーバータイ…あれ？
				ENDIF
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = クリーンヒット♥
			BTL_KOJO_RESULTS:1 = どう？効くでしょ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = 
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			BTL_KOJO_RESULTS:0 = 
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			IF !RAND:2
				BTL_KOJO_RESULTS:0 = ちっ　ちょっとは痛がりなさいよ
			ELSE
				BTL_KOJO_RESULTS:0 = あれー！？効いてない？
			ENDIF
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;味方に攻撃された
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF !RAND:2
				BTL_KOJO_RESULTS:0 = ぐはっ…
				BTL_KOJO_RESULTS:1 = なんでこんなことに…
			ELSE
				BTL_KOJO_RESULTS:0 = がはっ…
				BTL_KOJO_RESULTS:1 = 原作なら無敵なのに…
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50
			IF !RAND:2
				BTL_KOJO_RESULTS:0 = ぐばあっ！
				BTL_KOJO_RESULTS:1 = …い、痛すぎるわ…
			ELSE
				BTL_KOJO_RESULTS:0 = 痛い痛い！
				BTL_KOJO_RESULTS:1 = 大八助けてー！！！
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			IF !RAND:2
				BTL_KOJO_RESULTS:0 = 何？
			ELSE
				BTL_KOJO_RESULTS:0 = うふふ♥
				BTL_KOJO_RESULTS:1 = その攻撃は効かないわよ♥
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			IF !RAND:2
				BTL_KOJO_RESULTS:0 = 何？
			ELSE
				BTL_KOJO_RESULTS:0 = うふふ♥
				BTL_KOJO_RESULTS:1 = その攻撃は効かないわよ♥
			ENDIF
		;瀕死
		ELSEIF 現HP割合(ARG) < 25
			IF !RAND:2
				BTL_KOJO_RESULTS:0 = 痛たたた…
				BTL_KOJO_RESULTS:1 = 回復早くしてよ！
			ELSE
				BTL_KOJO_RESULTS:0 = く、こんなに傷がついたのは
				BTL_KOJO_RESULTS:1 = 秋に栗拾いに行ったとき以来だわ
			ENDIF
		;ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			IF !RAND:2
				BTL_KOJO_RESULTS:0 = ごふ…！
				BTL_KOJO_RESULTS:1 = …そこそこいいのもっらたわ
			ELSE
				BTL_KOJO_RESULTS:0 = く、こんなに傷がついたのは
				BTL_KOJO_RESULTS:1 = 秋に栗拾いに行ったとき以来だわ
			ENDIF
		;小ダメージ
		ELSE
			IF !RAND:2
				BTL_KOJO_RESULTS:0 = きゃあ！痛～い♥
			ELSE
				BTL_KOJO_RESULTS:0 = もう♥おさわりはダメよ♥
			ENDIF
		ENDIF
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE 13
		;全弾命中した
		IF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = どんな敵も逃がさないわよ♥
		;普通
		ELSEIF ARG:2 < ARG:1
			BTL_KOJO_RESULTS:0 = どんな敵も逃がさないわよ♥
		;全弾回避された
		ELSEIF ARG:2 == ARG:1
			BTL_KOJO_RESULTS:0 = うそ！アレーーーーー！！？？
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE 14
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			BTL_KOJO_RESULTS:0 = うふふ♥　%CSTR:ARG:일인칭%は無敵よ♥
		ELSE
			BTL_KOJO_RESULTS:0 = どんな敵も逃がさないわよ♥
		ENDIF
	;反射された
	CASE 15
		BTL_KOJO_RESULTS:0 = くばっ！！…何で？？
	;反射した
	CASE 16
		IF ARG:2 == ARG:1
			BTL_KOJO_RESULTS:0 = 今よ！鼻毛真拳奥義！
			BTL_KOJO_RESULTS:1 = 攻撃返し鼻毛！
		ELSE
			BTL_KOJO_RESULTS:0 = きゃああああ！！！
			BTL_KOJO_RESULTS:1 = ・・・と見せかけてドーーン！！
		ENDIF
	;回避された
	CASE 17
		IF ARG:2 == ARG:1
			BTL_KOJO_RESULTS:0 = え？避けられちゃった！？
		ELSE
			BTL_KOJO_RESULTS:0 = 何避けてんのよ　このバカ！
		ENDIF
	;回避した
	CASE 18
		IF !RAND:2
			BTL_KOJO_RESULTS:0 = 残念、はずれ♥
		ELSE
			BTL_KOJO_RESULTS:0 = きゃっ、怖～い♥
		ENDIF
	;敵味方全体攻撃(詳細処理無し)
	;CASE 19
	;		BTL_KOJO_RESULTS:0 = 
	;反撃を発動した
	CASE 20
		SELECTCASE TFLAG:발동연동스킬
		;닷지카운터
		CASE 2484
			BTL_KOJO_RESULTS:0 = 残念ね♥　隙ありっ！
		;その他
		CASEELSE
			BTL_KOJO_RESULTS:0 = チョナン・カーン！
		ENDSELECT
	;トリガースキルを発動した
	CASE 21
		SELECTCASE TFLAG:발동연동스킬
		;○○
		;CASE 
		;	BTL_KOJO_RESULTS:0 = 
		;その他
		CASEELSE
			BTL_KOJO_RESULTS:0 = まだ、終わらないわよ♥
		ENDSELECT
	;バッドステータスを受けた
	CASE 22
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				IF !RAND:2
					BTL_KOJO_RESULTS:0 = Happy　Happy　Happy～♪
					BTL_KOJO_RESULTS:1 = Hapi Hapi Hapi Hapi Happy～♪
				ELSE
					BTL_KOJO_RESULTS:0 = お父さん、
					BTL_KOJO_RESULTS:1 = %CSTR:ARG:일인칭%、今、幸せを感じてるわ！
				ENDIF
			CASE "SHOCK","FREEZE","BIND","PALYZE"
				IF !RAND:2
					BTL_KOJO_RESULTS:0 = うわー！動けないー！
				ELSE
					BTL_KOJO_RESULTS:0 = うわー、さなぎになっちゃったー！
				ENDIF
			CASE "PANIC"
				IF !RAND:2
					BTL_KOJO_RESULTS:0 = おでんにわさびを入れなきゃ…
					BTL_KOJO_RESULTS:1 = おでんにわさびを入れなきゃ…
				ELSE
					BTL_KOJO_RESULTS:0 = ハムハム…
					BTL_KOJO_RESULTS:1 = パスタ旨い、パスタ旨い
				ENDIF
			CASE "SLEEP"
				IF !RAND:2
					BTL_KOJO_RESULTS:0 = むにゃむにゃ…
				ELSE
					BTL_KOJO_RESULTS:0 = ゼット、ゼット、ゼット…
				ENDIF
			;CASE "CLOSE"
			CASE "POISON"
				BTL_KOJO_RESULTS:0 = RPGの毒は効果は控えめよ♥
				BTL_KOJO_RESULTS:1 = でも気分が悪い…
			;CASE "BOMB"
			CASE "CHARM"
				IF !RAND:2
					BTL_KOJO_RESULTS:0 = きゃーーー！
					BTL_KOJO_RESULTS:1 = ユアィゥオン様ーー！
				ELSE
					BTL_KOJO_RESULTS:0 = きゃーーー！
					BTL_KOJO_RESULTS:1 = ユアィゥオン様ーー！
				ENDIF
			;CASE "CURSE"
			;CASE "FLY"
			;CASE "STONE"
			CASE "FLAME"
				BTL_KOJO_RESULTS:0 = ぎゃあああ！熱い、熱い！
			CASE "SLIP"
				BTL_KOJO_RESULTS:0 = きゃっ　こけちゃった…
			;CASE "BRAND"
			;その他の状態異常
			;CASEELSE
		ENDSELECT
	;食いしばり等で耐えた
	CASE 23
		;이악물기
		IF BASE:ARG:ＨＰ == 1
			BTL_KOJO_RESULTS:0 = なんちゃって…
			BTL_KOJO_RESULTS:1 = 簡単にやられてなるもんか！
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = なんちゃって♥
			BTL_KOJO_RESULTS:1 = %CALLNAME:ARG%ちゃんは無敵なのよ♥
		ENDIF
	;回復してもらった
	CASE 24
		;ARG:2　回復量
		LOCAL = ARG:2 * 100 / BASE:ARG:ＨＰ
		;LOCAL　回復量割合
		IF 0
		;キャラ分岐
		;ELSEIF NO:(ARG:1) == XXXX
		;50%以上 & HPほぼ満タン
		ELSEIF LOCAL > 50 && 現HP割合(ARG) > 90
			BTL_KOJO_RESULTS:0 = ありがと♥　
			BTL_KOJO_RESULTS:1 = %CALLNAME:ARG%ちゃん復活よ♥
		;50%以上
		ELSEIF LOCAL > 50
			BTL_KOJO_RESULTS:0 = ありがと♥　
			BTL_KOJO_RESULTS:1 = 元気いっぱいよ♥
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = ありがと♥　
			BTL_KOJO_RESULTS:1 = でもまだ痛い…
		ENDIF
	;状態異常を直してもらった
	CASE 25
		;ARG:2　直ったバステ
		IF 0
		;キャラ分岐
		;ELSEIF NO:(ARG:1) == XXXX
		ELSE
			SELECTCASE GET_STATE(ARG:2)
				CASE "SLEEP"
					IF !RAND:2
						BTL_KOJO_RESULTS:0 = はっ　めじかるまくっちょ…
						BTL_KOJO_RESULTS:1 = …%CALLNAME:ARG%ちゃん…
					ELSE
						BTL_KOJO_RESULTS:0 = みんな…這いつくばれ…zzz
						BTL_KOJO_RESULTS:1 = は、夢…？
					ENDIF
				;その他の状態異常
				CASEELSE
					BTL_KOJO_RESULTS:0 = ありがと♥　
					BTL_KOJO_RESULTS:1 = 元気いっぱいよ♥
			ENDSELECT
		ENDIF
	;戦闘中イって行動不能にならず耐えた(ムフフ展開時のみ)
	CASE 47
		;歯を食いしばって快楽に耐えた
		BTL_KOJO_RESULTS:0 = ぐ…ぬぬぬ…
		SIF !RAND:4
			BTL_KOJO_RESULTS:1 = 闘いに集中できないわよ！！！やめてよこれ！！！
	;行動中イって行動不能になった(ムフフ展開時のみ 50%の確率でHAPPYに)
	CASE 48
		;GET_STATE(CFLAG:ARG:상태이상) == "HAPPY"
		
		;絶頂の余韻に浸っている
		BTL_KOJO_RESULTS:0 = はあ…♥　はあ…♥
		BTL_KOJO_RESULTS:1 = (戦闘中にイっちゃった…)
	;ターン終了時状態異常が自然回復した
	CASE 50
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "SLEEP"
				IF !RAND:2
					BTL_KOJO_RESULTS:0 = はっ　めじかるまくっちょ…
					BTL_KOJO_RESULTS:1 = …%CALLNAME:ARG%ちゃん…
				ELSE
					BTL_KOJO_RESULTS:0 = みんな…這いつくばれ…zzz
					BTL_KOJO_RESULTS:1 = は、夢…？
				ENDIF
			;その他の状態異常
			CASEELSE
				BTL_KOJO_RESULTS:0 = %CALLNAME:ARG%ちゃん復活♥
				BTL_KOJO_RESULTS:1 = これから反撃開始よ♥
		ENDSELECT
	;ターン終了時今の状態による口上
	CASE 51
		;ムフフ展開系
		IF FLAG:무후후전개 && (BATTLE_H_EVENT_PRO(ARG) > 30 || CFLAG:ARG:던전내발정용욕정치 > 5000) && !RAND:2
			;BATTLE_H_EVENT_PRO(ARG)…戦闘中イく確率
			SETCOLOR COLOR("pink")
			IF     BATTLE_H_EVENT_PRO(ARG) > 80
			ELSEIF BATTLE_H_EVENT_PRO(ARG) > 50
			ELSEIF BATTLE_H_EVENT_PRO(ARG) > 30
			ELSEIF CFLAG:ARG:던전내발정용욕정치 > 10000
			ELSEIF CFLAG:ARG:던전내발정용욕정치 > 5000
			ENDIF
			SIF BTL_KOJO_RESULTS:0 == "" && KSTR:0 == ""
				RESETCOLOR
		ENDIF
		;状態異常継続中
		IF BTL_KOJO_RESULTS:0 == "" && KSTR:0 == ""
			SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
				CASE "SLEEP"
					IF !RAND:2
						BTL_KOJO_RESULTS:0 = お前ら全員下僕になれ…
						BTL_KOJO_RESULTS:1 = あがめろ…zzz
					ELSE
						BTL_KOJO_RESULTS:0 = ゼット、ゼット、ゼット…
						BTL_KOJO_RESULTS:1 = ズィー、ズィー、ズィー
					ENDIF
				;その他の状態異常
				CASEELSE
					BTL_KOJO_RESULTS:0 = 
			ENDSELECT
		ENDIF
		;残りHP関連
		IF BTL_KOJO_RESULTS:0 == "" && KSTR:0 == ""
			IF 0
			;HP50%以下
			ELSEIF 現HP割合(ARG) < 50
				IF !RAND:2
					BTL_KOJO_RESULTS:0 = 傷ついちゃったわ
				ELSE
					BTL_KOJO_RESULTS:0 = 傷跡、残っちゃうかな…
					BTL_KOJO_RESULTS:0 = 回復してほしい～な～
				ENDIF
			;HP20%以下
			ELSEIF 現HP割合(ARG) < 20
				IF !RAND:2
					BTL_KOJO_RESULTS:0 = ピンチよピンチ
					BTL_KOJO_RESULTS:1 = ギャグじゃなくてマジな奴だからね！
				ELSE
					BTL_KOJO_RESULTS:0 = RPGでこの体力はまずいわ！
					BTL_KOJO_RESULTS:1 = 早く回復して！
				ENDIF
			ENDIF
		ENDIF
	;ターン終了時ORGYがHEATになった(機械の乙女専用)
	;CASE 52
