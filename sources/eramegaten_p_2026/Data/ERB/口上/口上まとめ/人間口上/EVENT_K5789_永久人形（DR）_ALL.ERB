						PRINTFORMW 
					;二回目（リーチ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORMW 
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						PRINTFORMW 
					ENDIF
				;その他
				ELSE
					;進行度分岐
					;初回
