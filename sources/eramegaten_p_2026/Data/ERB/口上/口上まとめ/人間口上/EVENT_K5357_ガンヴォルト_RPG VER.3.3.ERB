;ライセンスについて
;	・基本項目(許可する項目を"○"に、許可しない項目を"×"に変更してください。)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1| ○ | 処理上のバグ修正              |
;	+----+----+-------------------------------+
;	|   2| ○ | 口上の誤字・脱字の修正        |
;	+----+----+-------------------------------+
;	|   3| ○ | 口上まとめへの収録            |
;	+----+----+-------------------------------+
;	|   4| ○ | 口上の新規追加                |
;	+----+----+-------------------------------+
;	|   5| ○ | 既存口上の改変                |
;	+----+----+-------------------------------+
;	|   6| ○ | 改変した口上の自由な再配布    |
;	+----+----+-------------------------------+
;	|   7| ○ | 口上内容の転載                |
;	+----+----+-------------------------------+
;-------------------------------------------------
;【使用CFLAG】
;　CFLAG:800　シアンの歌判定 for Reincarnation
;　CFLAG:801　シアンの歌判定 for Indigo Destiny
;　CFLAG:802　避雷針判定
;　CFLAG:803　個別イベント用判定
;--------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:GV]], ARG, ARG:1, ARG:2
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF TSTR:전투이벤트패턴 == "EVENT_200_4_ペインフルデターミネーション"
			BTL_KOJO_RESULTS:0 = 동정해서는 안돼。해방시키기 위해서라도 지금은！
		ELSEIF TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神1"
			BTL_KOJO_RESULTS:0 = 너만은…… 여기서 멈추겠다！
		ELSEIF TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神2"
			BTL_KOJO_RESULTS:0 = 끝을 보자…… 아시모프！
		ELSE
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 좋아、상대가 겁먹었어！
			CASE 1
				BTL_KOJO_RESULTS:0 = 찬스입니다、여러분 부탁드리겠습니다！
			CASE 2
				BTL_KOJO_RESULTS:0 = 틈을 만들었습니다、나머지는 맡기겠습니다
			ENDSELECT
		ENDIF
	;COOP参加
	CASE 2
		IF TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神1"
			BTL_KOJO_RESULTS:0 = 저녀석만은 봐줄 수 없어……！
		ELSEIF TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神2"
			BTL_KOJO_RESULTS:0 = 끝내겠어、우리들이…… 여기에서！
		;主人がCOOP発動
		ELSEIF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%도 이어가겠습니다！
			CASE 1
				BTL_KOJO_RESULTS:0 = 이걸로、끝낸다
			CASE 2
				BTL_KOJO_RESULTS:0 = 끝내도록 하죠！
			ENDSELECT
		;アキュラがCOOP発動
		ELSEIF FLAG:행동순1 != -1 && NO:(FLAG:행동순1) == [[キャラ:아큐라_X]]
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 너의 힘을 빌릴 수 있다 생각하니 든든한걸
			CASE 1
				BTL_KOJO_RESULTS:0 = 네가 만든 찬스、헛되게 하지 않을게
			CASE 2
				BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%도 질 수는 없지……
			ENDSELECT
		;ブレイドがCOOP発動
		ELSEIF FLAG:행동순1 != -1 && NO:(FLAG:행동순1) == [[キャラ:블레이드_X]]
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 예리한 일격이었습니다、블레이드 씨
			CASE 1
				BTL_KOJO_RESULTS:0 = 저렇게 쓸 수도 있구나…… 참고하자
			CASE 2
				BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%도 질 수는 없지……
			ENDSELECT
		;それ以外
		ELSE
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%도 이어가겠습니다！
			CASE 1
				BTL_KOJO_RESULTS:0 = 이걸로、끝낸다
			CASE 2
				BTL_KOJO_RESULTS:0 = 끝내도록 하죠！
			ENDSELECT
		ENDIF
	;被召喚時
	CASE 3
		;BTL_KOJO_RESULTS:0 = 
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;味方に攻撃した
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神1"
				BTL_KOJO_RESULTS:0 = 뭘까、이 위화감은……
				BTL_KOJO_RESULTS:1 = 이전에 싸웠을 때보다、약한 듯한……？
			ELSEIF TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神2"
				BTL_KOJO_RESULTS:0 = 능력자《우리들》에게 필요한 건 너의 지배 같은 게 아냐
			ELSE
				IF RAND:2 == 0
					SETCOLOR 0x1d9eff
					BTL_KOJO_RESULTS:0 = 적을 격파！　해냈구나、ＧＶ！
					TSTR:전투구상캐릭터명칭 '= "시안"
					TSTR:전투구상캐릭터화상어드레스 '= "GV_FACE_EX_1"
					CALL PRINT_KOJO_RPG_MESSAGE, , ARG
					SETCOLOR COLOR("FRIEND")
				ENDIF
				SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 물러났으면 쫓지 않았을텐데
				CASE 1
					BTL_KOJO_RESULTS:0 = 잠시 자고 있어
				CASE 2
					BTL_KOJO_RESULTS:0 = 여기는 ＧＶ、타겟을 격파
				ENDSELECT
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 막혔나、그렇다면！
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			IF RAND:2 == 0
				SETCOLOR 0x1d9eff
				BTL_KOJO_RESULTS:0 = 좋은 기세야！　그대로 해치워버려！
				TSTR:전투구상캐릭터명칭 '= "시안"
				TSTR:전투구상캐릭터화상어드레스 '= "GV_FACE_EX_1"
				CALL PRINT_KOJO_RPG_MESSAGE, , ARG
				SETCOLOR COLOR("FRIEND")
			ENDIF
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 어찌되었건 물러설 생각은 없는 것 같네
			CASE 1
				BTL_KOJO_RESULTS:0 = 미안하지만、힘조절할 여유는 없어
			CASE 2
				BTL_KOJO_RESULTS:0 = ……다음으로 끝을 낸다！
			ENDSELECT
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			IF RAND:2 == 0
				SETCOLOR 0x1d9eff
				BTL_KOJO_RESULTS:0 = 그럭저럭 먹힌 것 같아。힘내、ＧＶ！
				TSTR:전투구상캐릭터명칭 '= "시안"
				TSTR:전투구상캐릭터화상어드레스 '= "GV_FACE_EX_1"
				CALL PRINT_KOJO_RPG_MESSAGE, , ARG
				SETCOLOR COLOR("FRIEND")
			ENDIF
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 지금이라면 늦지 않았어。물러설 생각은 없는 건가
			CASE 1
				BTL_KOJO_RESULTS:0 = 그다지 시간을 잡아먹힐 수는 없어
			CASE 2
				BTL_KOJO_RESULTS:0 = 가로막겠다면……！
			ENDSELECT
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神1"
				BTL_KOJO_RESULTS:0 = 역시 효과가 안 좋은가…… 그래도！
			ELSEIF TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神2"
				BTL_KOJO_RESULTS:0 = 효과가 안 좋아도 상관없어！
			ELSE
				IF RAND:2 == 0
					SETCOLOR 0x1d9eff
					BTL_KOJO_RESULTS:0 = 이럴수가、전혀 효과가 없어……
					TSTR:전투구상캐릭터명칭 '= "시안"
					TSTR:전투구상캐릭터화상어드레스 '= "GV_FACE_EX_1"
					CALL PRINT_KOJO_RPG_MESSAGE, , ARG
					SETCOLOR COLOR("FRIEND")
				ENDIF
				SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 곤란한걸…… 이렇게까지 단단하다니
				CASE 1
					BTL_KOJO_RESULTS:0 = 억지로 밀어붙이는 것도 한계가 있어。무언가 방도를 떠올려야 해……
				CASE 2
					BTL_KOJO_RESULTS:0 = 이건 힘든 싸움이 되겠는걸……
				ENDSELECT
			ENDIF
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			IF TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神1"
				BTL_KOJO_RESULTS:0 = 역시 효과가 안 좋은가…… 그래도！
			ELSEIF TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神2"
				BTL_KOJO_RESULTS:0 = 효과가 안 좋아도 상관없어！
			ELSE
				IF RAND:2 == 0
					SETCOLOR 0x1d9eff
					BTL_KOJO_RESULTS:0 = 거짓말…… ＧＶ의 공격이 먹히지 않아！？
					TSTR:전투구상캐릭터명칭 '= "시안"
					TSTR:전투구상캐릭터화상어드레스 '= "GV_FACE_EX_1"
					CALL PRINT_KOJO_RPG_MESSAGE, , ARG
					SETCOLOR COLOR("FRIEND")
				ENDIF
				SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 이건 힘든 싸움이 되겠는걸……
				CASE 1
					BTL_KOJO_RESULTS:0 = 우는 소리는 할 수 없지
				CASE 2
					BTL_KOJO_RESULTS:0 = 떠올려라…… 방법은 있을거야
				ENDSELECT
			ENDIF
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神1" || TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神2"
				BTL_KOJO_RESULTS:0 = 여기까지、인가……？
			ELSE
				BTL_KOJO_RESULTS:0 = 그앗……！
			ENDIF
		;味方に攻撃された
		ELSEIF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
			BTL_KOJO_RESULTS:0 = 상대를 제대로 확인해주세요、이쪽은 아군입니다
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF RAND:2 == 0
				SETCOLOR 0x1d9eff
				BTL_KOJO_RESULTS:0 = ＧＶ、괜찮아！？　무리는 하지 마！
				TSTR:전투구상캐릭터명칭 '= "시안"
				TSTR:전투구상캐릭터화상어드레스 '= "GV_FACE_EX_1"
				CALL PRINT_KOJO_RPG_MESSAGE, , ARG
				SETCOLOR COLOR("FRIEND")
			ENDIF
			IF TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神1" || TSTR:전투이벤트패턴 == "EVENT_200_5_機械仕掛けの狂神2"
				SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%는、살해당하거나 하지 않아……！
				CASE 1
					BTL_KOJO_RESULTS:0 = 네놈에게만은、절대로 질 수 없어！
				CASE 2
					BTL_KOJO_RESULTS:0 = 시안…… %CSTR:ARG:일인칭%에게、힘을……！
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 괜찮아…… %CSTR:ARG:일인칭%는 아직、할 수 있어
				CASE 1
					BTL_KOJO_RESULTS:0 = 포기할 생각은 없어……！
				CASE 2
					BTL_KOJO_RESULTS:0 = 시안…… %CSTR:ARG:일인칭%에게、힘을……！
				ENDSELECT
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			IF RAND:2 == 0
				SETCOLOR 0x1d9eff
				BTL_KOJO_RESULTS:0 = 유감인걸、ＧＶ에게 그런 건 안 통하거든
				TSTR:전투구상캐릭터명칭 '= "시안"
				TSTR:전투구상캐릭터화상어드레스 '= "GV_FACE_EX_1"
				CALL PRINT_KOJO_RPG_MESSAGE, , ARG
				SETCOLOR COLOR("FRIEND")
			ENDIF
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%에게 그건 먹히지 않아
			CASE 1
				BTL_KOJO_RESULTS:0 = 피하지 않아도 괜찮다고는 하지만、왠지 불안한걸……
			CASE 2
				BTL_KOJO_RESULTS:0 = 수고했어……
			ENDSELECT
		;吸収
		ELSEIF ARG:2 < 0
			IF RAND:2 == 0
				SETCOLOR 0x1d9eff
				BTL_KOJO_RESULTS:0 = 유감인걸、ＧＶ에게 그런 건 안 통하거든
				TSTR:전투구상캐릭터명칭 '= "시안"
				TSTR:전투구상캐릭터화상어드레스 '= "GV_FACE_EX_1"
				CALL PRINT_KOJO_RPG_MESSAGE, , ARG
				SETCOLOR COLOR("FRIEND")
			ENDIF
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%에게 그건 먹히지 않아
			CASE 1
				BTL_KOJO_RESULTS:0 = 피하지 않아도 괜찮다고는 하지만、왠지 불안한걸……
			CASE 2
				BTL_KOJO_RESULTS:0 = 체력회복、감사를 표하지
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 저쪽이 더 빠르군……
			CASE 1
				BTL_KOJO_RESULTS:0 = 긋……
			CASE 2
				BTL_KOJO_RESULTS:0 = 피할 수 없나……
			ENDSELECT
		ENDIF
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE 13
		;全弾命中した
		IF ARG:2 == 0
			IF RAND:2 == 0
				SETCOLOR 0x1d9eff
				BTL_KOJO_RESULTS:0 = 역시 ＧＶ！　전부 다 맞히다니！
				TSTR:전투구상캐릭터명칭 '= "시안"
				TSTR:전투구상캐릭터화상어드레스 '= "GV_FACE_EX_1"
				CALL PRINT_KOJO_RPG_MESSAGE, , ARG
				SETCOLOR COLOR("FRIEND")
				SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 그렇게까지 칭찬받으면、좀 부끄러운걸……
				CASE 1
					BTL_KOJO_RESULTS:0 = 고마워、시안。네 덕분이야
				CASE 2
					BTL_KOJO_RESULTS:0 = 응…… 상태가 좋은걸
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 좋아、전탄명중
				CASE 1
