@KOJO_BATTLE_EVENT_K[[キャラ:아키야마린코]], ARG, ARG:1, ARG:2
;■If you need more lines of text, add 
;			LOCALS:10 = Line 1
;			LOCALS:11 = Line 2
;			LOCALS:12 = Line 3
;			LOCALS:13 = Line 4
;			LOCALS:14 = Line 5
;
SIF ARG < 0 && NO:ARG != 9000
	RETURN 0
VARSET LOCALS

SELECTCASE TFLAG:전투이벤트
	;COOP initiated
	CASE 1
		BTL_KOJO_RESULTS:0 = 今だ！
	;COOP participation
	CASE 2
		;Master calls it
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = %CALLNAME:MASTER%、指示をくれっ！
		;Otherwise
		ELSE
			BTL_KOJO_RESULTS:0 = 斬りこむぞっ！
		ENDIF
	;When summoned to battle
	CASE 3
			BTL_KOJO_RESULTS:0 = 対魔忍・秋山凜子、参る！
	;Ally attacking　ARG-teammate、ARG:1-enemy、ARG:2-damage amount in percent
	CASE 11
		;Enemy died
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = ターゲットを排除した
		;Hitting weakness without a coop
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = はあぁっ！
			ELSE
				;jump to COOP
				RETURN 0
			ENDIF
		;Large
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = もう、終わりだ！
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = なるほどな？
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			BTL_KOJO_RESULTS:0 = 行ける！
		;nullified
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = 効かない！？
		ENDIF
	;Ally hit
	;ARG-hit ally、ARG:1-enemy、ARG:2-damage amount in percentage
	CASE 12
		;Killed
		IF BASE:ARG:ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = くっ…！　何て、ことだ…
		;Large
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = ぐっうぅ！！
		;Null
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 意味の無い攻撃だな
		;Drained
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = 無駄だ
		ENDIF
	;Reflected
	CASE 15
			BTL_KOJO_RESULTS:0 = 弾かれたっ！？
	;Reflecting
	CASE 16
			BTL_KOJO_RESULTS:0 = 諦めろ
	;Evaded
	CASE 17
			BTL_KOJO_RESULTS:0 = 外した！？
	;Evading
	CASE 18
			BTL_KOJO_RESULTS:0 = どこを見ている？
	;Retaliation skill called
	CASE 20
			BTL_KOJO_RESULTS:0 = 空間亀裂！
	;Victory
	CASE 90
			BTL_KOJO_RESULTS:0 = 排除完了だな
	;Level-up
	CASE 91
			BTL_KOJO_RESULTS:0 = 剣の道は、まだこれからだ
	;Successful escape
	CASE 92
			BTL_KOJO_RESULTS:0 = 逃げるぞ！
	;Fail to escape
	CASE 93
			BTL_KOJO_RESULTS:0 = 遅かったか！？
	;Combat start
	CASE 94
		IF 現HP割合(ARG) < 25
			;Near death
			BTL_KOJO_RESULTS:0 = まだ…戦える…！
		ELSE
			BTL_KOJO_RESULTS:0 = 行くぞっ！
		ENDIF
	;Ambushed
	CASE 95
		IF 現HP割合(ARG) < 25
			;Near death
			BTL_KOJO_RESULTS:0 = 囲まれている！？
		ELSE
			BTL_KOJO_RESULTS:0 = やられたか…
		ENDIF
	;Preemptive Strike
	CASE 96
		IF 現HP割合(ARG) < 25
			;Near death
			BTL_KOJO_RESULTS:0 = 対魔忍を、舐めるなっ！
		ELSE
			BTL_KOJO_RESULTS:0 = 遅れを取った！？
		ENDIF
	;
	CASE 97
			BTL_KOJO_RESULTS:0 = 奇襲は得意分野でね
ENDSELECT
