	SELECTCASE GET_ROLE_CSTR_EV(ARG, "交代元キャラ")
		CASE "ライカン_ゼンゼロ"
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 任せていただけるのですか？が、頑張ります……！
			ELSE
				BTL_KOJO_RESULTS:0 = ライカンさん！カ、カリンもお手伝いします！
			ENDIF
		CASE "リナ_ゼンゼロ"
			IF RAND:2
				BTL_KOJO_RESULTS:0 = わ、私ですか？私で良いのでしょうか……？
			ELSE
				BTL_KOJO_RESULTS:0 = リナさん！ま、任せてください！
			ENDIF
		CASEELSE
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = お呼びですか？
				CASE 1
					BTL_KOJO_RESULTS:0 = はい！ただいま！
				CASE 2
