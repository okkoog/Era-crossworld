		CASEELSE
			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
			;淫乱・娼婦時のセリフ
			IF 淫乱系陥落()
				IF RAND:3 == 0
					PRINTFORML ┃%"まるで魔法使いのように魔法が使えるとは……",72,LEFT%┃
					PRINTFORML ┃%"興味深い……",72,LEFT%┃
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"とても心惹かれる技術ですね",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"このように使えばいいのですね、とても新鮮です",72,LEFT%┃
				ENDIF
			;服従・隷属時のセリフ
			ELSEIF 服従系陥落()
				IF RAND:3 == 0
					PRINTFORML ┃%"か、体が勝手に～！？",72,LEFT%┃
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"こ、こうですか！？",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"こんな感じで使えばいいのですね……",72,LEFT%┃
				ENDIF
			;上記以外のセリフ
			ELSE
				IF RAND:3 == 0
					PRINTFORML ┃%"まるで魔法使いのようですね……",72,LEFT%┃
					PRINTFORML ┃%"とても興味深いですね",72,LEFT%┃
				ELSEIF RAND:2 == 0
					PRINTFORML ┃%"ふふっ、とても心惹かれる技術ですね。えいっ",72,LEFT%┃
				ELSE
					PRINTFORML ┃%"このように使えばいいのですね、とても新鮮です",72,LEFT%┃
				ENDIF
			ENDIF
			PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDSELECT
ENDIF
