;-------------------------------------------------
@DemonsRoots_ポリュカ口上_個別イベント進行初回
#DIM DYNAMIC イベント進行度

; FOR LOCAL,0, 10
; 	SIF !GETBIT(CFLAG:개별이벤트읽음,LOCAL)
; 		BREAK
; 	イベント進行度 ++ 
; NEXT

;2進数変換された文字列の長さを調べる事で、立っている最大のビットを調べる
이벤트 진행도 = STRLENS(CONVERT(CFLAG:개별이벤트 읽기, 2))

; CFLAG:804が現在のイベント進行度より大きい場合、周回でイベント進行度がリセットされている
IF CFLAG:804 > イベント進行度
	; 周回後はフラグをリセット
	CFLAG:804 = 0
ENDIF

IF CFLAG:804 < イベント進行度
	; イベント開始済みかつ、イベント進行後の口上を見ていない場合にここに入る
	SELECTCASE イベント進行度
		CASE 1
			; アンジュ救出後
			PRINTFORML 「…어!　…%CALLNAME:MASTER%가」
			PRINTFORML 
