;-------------------------------------------------
@DemonsRoots_ポリュカ口上_敗北者人数
#DIM 敗北者人数
敗北者人数 = 0
	FOR LOCAL,0,CHARANUM
		SIF GROUPMATCH(NO:LOCAL, [[キャラ:데스포르카_DR]], [[キャラ:앙쥬_DR]], [[キャラ:칼린카_DR]], [[キャラ:사라사_DR]], [[キャラ:다이아나_DR]], [[キャラ:나제지타_DR]], [[キャラ:릴리킬러_DR]])
			敗北者人数 ++
	NEXT
RETURN 敗北者人数

;-------------------------------------------------
;DemonsRootsのメンバーとMASTERの相性を良好に　全員居る事前提
;-------------------------------------------------
@DemonsRoots_ポリュカ口上_相性変化, ARG
FOR LOCAL, 1, 21
	IF CFLAG:ARG:@"캐릭터상성{LOCAL}" < 0
		CFLAG:ARG:@"캐릭터상성{LOCAL}" = CFLAG:MASTER:캐릭터고유번호
		CFLAG:ARG:@"캐릭터상성치{LOCAL}" = 125
		BREAK
	ENDIF
NEXT
RETURN

