
@CHIECHAN_02_HATUSOUNYU_V

@CHIECHAN_02_HEART
#DIM DYNAMIC COLOR_TEMP, 1
COLOR_TEMP = GETCOLOR()
;ピンク
KCOLOR:K = 0xFF69B4
NSTR:(K++) = %UNICODE(0x2661)%
KCOLOR:K = COLOR_TEMP

@CHIECHAN_02_HEART_P
#DIM DYNAMIC COLOR_TEMP, 1
COLOR_TEMP = GETCOLOR()
;ピンク
KCOLOR:K = 0xFF69B4
NSTR:(K++) = %UNICODE(0x2661)%
;もとに戻す
KCOLOR:K = COLOR_TEMP

@KOJO_COLOR_CHIECHAN_02
;右のような指定も可能→SETCOLOR 0xA0A0A0
;色見本に#ABCDEFというような書き方がされていた場合は、こちらの書き方(SETCOLOR 0xABCDEF)を使うと良い
;緑
;万一、文字色を戻す前にこの関数を二度呼んでしまったら、文字色の退避用変数は更新しない
;RESETCOLORで良さそうな気もするが
SIF GETCOLOR() != 0x7FFF00
	CFLAG:808 = GETCOLOR()
SETCOLOR 0x7FFF00

;SETCOLOR CFLAG:808