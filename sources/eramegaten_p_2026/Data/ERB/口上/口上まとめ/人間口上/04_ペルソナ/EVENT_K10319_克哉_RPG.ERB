;ライセンスについて
;	・基本項目(許可する項目を"○"に、許可しない項目を"×"に変更してください。)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容				 |
;	+----+----+-------------------------------+
;	|   1| ○ | 処理上のバグ修正			  |
;	+----+----+-------------------------------+
;	|   2| ○ | 口上の誤字・脱字の修正		|
;	+----+----+-------------------------------+
;	|   3| ○ | 口上まとめへの収録			|
;	+----+----+-------------------------------+
;	|   4| ○ | 口上の新規追加				|
;	+----+----+-------------------------------+
;	|   5| ○ | 既存口上の改変				|
;	+----+----+-------------------------------+
;	|   6| ○ | 改変した口上の自由な再配布	|
;	+----+----+-------------------------------+
;	|   7| ○ | 口上内容の転載				|
;	+----+----+-------------------------------+
@KOJO_BATTLE_MESSAGE_K[[キャラ:카츠야]], ARG,ARG:1 = 0
LOCAL:1 = 1
LOCAL = CFLAG:ARG:입력행동
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = EMPTY
;タイプ取得
CALL GET_SKILL_PROP, "SKILL_EFECT", LOCAL, ARG
IF LOCAL == 0
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 움직이지 마라！
	ELSEIF !RAND:2
		BTL_KOJO_RESULTS:0 = 체포하겠다！
	ELSE
		BTL_KOJO_RESULTS:0 = 하앗！
	ENDIF
ELSEIF LOCAL == [[스킬:ＧＵＮ]]
	IF RAND:2
		BTL_KOJO_RESULTS:0 = 쏘겠다！
	ELSE
		BTL_KOJO_RESULTS:0 = 손 들어라！
	ENDIF
;공격
ELSEIF RESULT == 1 && RAND:3 == 0
	;潜在反撃対策
	IF CFLAG:ARG:입력행동 == -1
		RETURN
	ENDIF
	CALL GET_SKILL_PROP, "SKILL_TYPE", CFLAG:ARG:입력행동, ARG,ARG
	SELECTCASE RESULT
		;剣撃・打撃・戦技
		CASE 0, 2, 3
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 얌전하게 굴어라！
			ELSE
				BTL_KOJO_RESULTS:0 = 붙잡아라！
			ENDIF
		;비구
		CASE 1
			IF CFLAG:ARG:입력행동 == [[스킬:저스티스샷]]
				BTL_KOJO_RESULTS:0 = 이것으로 끝이다！
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 정당방위이다！　불만은 없겠지！
			ELSEIF RAND:2
				BTL_KOJO_RESULTS:0 = 쏘겠다！
			ELSE
				BTL_KOJO_RESULTS:0 = 먹어랏！
			ENDIF
		;화염
		CASE 4
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 불타올라라！
			ELSE
				BTL_KOJO_RESULTS:0 = 경찰을 얕보지 마！
			ENDIF
		;氷結・水撃
		CASE 5, 13
			BTL_KOJO_RESULTS:0 = 머리를 식혀라！
		;전격
		CASE 6
			BTL_KOJO_RESULTS:0 = 움직이지 마라！
		;충격
		CASE 7
			BTL_KOJO_RESULTS:0 = 전원 움직이지 마라！
		;신경
		;CASE 8
		;정신
		;CASE 9
		;파마
		CASE 10
			BTL_KOJO_RESULTS:0 = 너희들의 죄악、내가 지불해 주겠다！
		;주살
;		CASE 11
	;	;지변
	;	CASE 12
	;		BTL_KOJO_RESULTS:0 = 大地よ！　震えろー！
		;질풍
	;CASE 14
	;		BTL_KOJO_RESULTS:0 = 
	;	;중력
	;	CASE 15
	;		BTL_KOJO_RESULTS:0 = 
	;핵열
		CASE 16
			BTL_KOJO_RESULTS:0 = 지방 공무원을 얕보다니
		;만능
		CASE 17
			BTL_KOJO_RESULTS:0 = 변명이라면、경찰서에서 듣겠다！
		;사이코
		;CASE 18
		CASEELSE
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 페르소나！
			ELSE
				BTL_KOJO_RESULTS:0 = 끝이다
			ENDIF
	ENDSELECT
;회복
ELSEIF RESULT == 2 && RAND:3 == 0
	IF CFLAG:ARG:타겟 > 6
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 모두！　괜찮나！？
		ELSE
			BTL_KOJO_RESULTS:0 = 아직、이제부터다！　오기를 보여 주겠다！
		ENDIF
	ELSE
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 동료가 다치도록 두진 않겠다
		ELSE
			BTL_KOJO_RESULTS:0 = 혼자서는 싸울 수 없으니까 말이지
		ENDIF
	ENDIF
;状態変化
;ELSEIF RESULT == 3
;特殊
;ELSEIF RESULT == 4
;状態回復
;ELSEIF RESULT == 5
ELSE
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 가라
	ELSEIF RAND:2
		BTL_KOJO_RESULTS:0 = 페르소나！
	ELSE
		BTL_KOJO_RESULTS:0 = 내 차례다
	ENDIF
ENDIF
;SIF LOCALS != "EMPTY"
;	CALL MESSAGE_BL(LOCAL:1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)

@KOJO_BATTLE_EVENT_K[[キャラ:카츠야]], ARG, ARG:1, ARG:2
SIF ARG < 0 && NO:ARG != 4538
	RETURN 0
LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = EMPTY
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 너희들、전원 체포다！
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 확보ー！
		ELSE
			BTL_KOJO_RESULTS:0 = 원호를 부탁한다！
		ENDIF
	CASE 2
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;潜在反撃対策
		IF CFLAG:ARG:입력행동 == -1
			RETURN
		ENDIF
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 너에게는、변호사를 고용할 권리가 있다
				ELSE
					BTL_KOJO_RESULTS:0 = 피의자 확보！
				ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 무으…
				ELSE
					BTL_KOJO_RESULTS:0 = 잔머리 굴리기는
				ENDIF
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 좋아！
			ELSE
				BTL_KOJO_RESULTS:0 = 자수하려면 지금 해라！
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 20
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 이젠、그만두지 않겠나。살해되기 전에 말야
			ELSE
				BTL_KOJO_RESULTS:0 = 아직、하는거냐？
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 다음에는 진짜로 쏠 테다
			ELSE
				BTL_KOJO_RESULTS:0 = 이것으로 끝이라고 생각하지 마라
			ENDIF
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 만약、못 듣더라도 단념하지는 않을 테다！
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = 범인에게 힘을 빌려 주다니…
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 남동생…아…
			ELSE
				BTL_KOJO_RESULTS:0 = 순직(殉職)할 생각은……아직 없는데 말이지……
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0= 所轄の意地を見せてやる…！
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 아아앗！
			ELSE
				BTL_KOJO_RESULTS:0 = 바보 같은…
			ENDIF
		ELSEIF ダメージ割合(ARG, ARG:2) > 0
		;無効
		ELSEIF ARG:2 == 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 그것으로 끝인가！
			ELSE
				BTL_KOJO_RESULTS:0 = 나쁜 말은 하지 않는다。이제 그만두는 거다
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = 그만 단념해라！
		ENDIF
	CASE 15
		BTL_KOJO_RESULTS:0 = 이런！？
	CASE 16
		BTL_KOJO_RESULTS:0 = 이것으로 자기의 잘못을 알았을 테지？
	CASE 17
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 빗나간…건가…
		ELSE
			BTL_KOJO_RESULTS:0 = 훈련이 모자랐던가…
		ENDIF
	CASE 18
		BTL_KOJO_RESULTS:0 = 쓸데없다！
ENDSELECT
