;陥落後に表示されると違和感がある初回口上を表示済扱いする
IF CFLAG:201 < 5 && 陥落()
	REPEAT 201
		;コマンドの番号ではなくCFLAGの番号であることに注意
		SELECTCASE COUNT:0 + 300
			;貧乳パイズリはほぼ陥落後用なので例外とする
			CASE 346, 352, 367, 415
				SIF BUST() < 3
					CONTINUE
			;恋慕、親愛のみ
			CASE 314 TO 319, 401
				CONTINUE
			;服従、隷属のみ
			CASE 370 TO 372, 378 TO 381
				CONTINUE
			;陥落済みのみ
			CASE 321, 353, 422, 443
				CONTINUE
		ENDSELECT
		CFLAG:(COUNT:0 + 300) = MAX(CFLAG:(COUNT:0 + 300), 1)
	REND
ENDIF

