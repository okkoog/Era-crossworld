		;攻撃以外でここにくる場合がある？
		CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:입력행동, ARG
		IF GET_SKILL_EFFECT(RESULT) == "공격"
			IF IS_BADSTATE(ENEMY, "DYING")
				IF !RAND:3
					BTL_KOJO_RESULTS:0 = 후우
