				PRINTFORM %CALLNAME:MASTER%은 %CALLNAME을% 감싸 안듯 품에 안고、
			ELSE
				PRINTFORM %CALLNAME:MASTER%과 %CALLNAME은% 서로를 꼭 끌어안고、
			ENDIF
			PRINTFORML 그대로 내레이션에 맞춰 포즈를 취했다.
			PRINTFORMW 꾸미기 코너로 옮겨가 둘이서 낙서를 즐긴다.
			PRINTFORML 낙서가 끝나고 스티커 사진이 나올 때까지의 동안、%CALLNAME%의 기대에 찬 시선이 느껴졌지만、
			PRINTFORMW %CALLNAME:MASTER%은 모르는 척 스티커를 챙기고는、%CALLNAME과% 함께 오락실을 나섰다.

			CALL ADDS_EXP("키스경험", 1, TARGET)
			IF IS_LESBIAN(MASTER, TARGET)
				CALL ADDS_EXP("레즈경험", 1, MASTER)
				CALL ADDS_EXP("레즈경험", 1, TARGET)
			ELSEIF IS_GAY(MASTER, TARGET)
				CALL ADDS_EXP("ＢＬ경험", 1, MASTER)
				CALL ADDS_EXP("ＢＬ경험", 1, TARGET)
			ENDIF
			CALL ADDS_EXP("애정경험", 1, MASTER)
			CALL ADDS_EXP("애정경험", 1, TARGET)
	ENDSELECT
ENDIF

