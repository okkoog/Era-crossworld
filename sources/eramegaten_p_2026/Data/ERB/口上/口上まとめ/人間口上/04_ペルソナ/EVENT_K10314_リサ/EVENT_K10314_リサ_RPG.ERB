@KOJO_BATTLE_MESSAGE_K[[キャラ:리사]], ARG,ARG:1 = 0
LOCAL:1 = 1
LOCAL = CFLAG:ARG:입력행동
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = EMPTY
;タイプ取得
CALL GET_SKILL_PROP, "SKILL_EFECT", LOCAL, ARG
IF LOCAL == 0
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 아쵸ー！
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 간다ー！
	ELSE
		BTL_KOJO_RESULTS:0 = 하이잇！
	ENDIF
ELSEIF LOCAL == [[스킬:ＧＵＮ]]
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 야앗！
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 아잣ー！
	ELSE
		BTL_KOJO_RESULTS:0 = 먹어라아！
	ENDIF
ELSEIF LOCAL == [[스킬:포미러버]]
	BTL_KOJO_RESULTS:0 = Foamy Loverー！
;공격
ELSEIF RESULT == 1 && RAND:3 == 0
	;潜在反撃対策
	IF CFLAG:ARG:입력행동 == -1
		RETURN
	ENDIF
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 데야앗！
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 강하게、갑니다앗！
	ELSE
		BTL_KOJO_RESULTS:0 = 호앗쵸ー！！
	ENDIF
;회복
ELSEIF RESULT == 2 && RAND:3 == 0
	IF CFLAG:ARG:타겟 > 6
		BTL_KOJO_RESULTS:0 = 모두！
	ELSE
		BTL_KOJO_RESULTS:0 = 괜찮아！？
	ENDIF
;状態変化
;ELSEIF RESULT == 3
	IF CFLAG:ARG:타겟 > 6
		BTL_KOJO_RESULTS:0 = 우와…
	ELSE
		BTL_KOJO_RESULTS:0 = 진짜…？
	ENDIF
;特殊
;ELSEIF RESULT == 4
	IF CFLAG:ARG:타겟 > 6
		BTL_KOJO_RESULTS:0 = 이걸로！
	ELSE
		BTL_KOJO_RESULTS:0 = 갑니다ー！！
	ENDIF
;状態回復
;ELSEIF RESULT == 5
	IF CFLAG:ARG:타겟 > 6
		BTL_KOJO_RESULTS:0 = 모두！
	ELSE
		BTL_KOJO_RESULTS:0 = 제대로 해！
	ENDIF
ELSE
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 호아쵸ー！
	ELSEIF RAND:2
		BTL_KOJO_RESULTS:0 = 페르소나！
	ELSE
		BTL_KOJO_RESULTS:0 = 페르소나아！
	ENDIF
ENDIF
;SIF LOCALS != "EMPTY"
;	CALL MESSAGE_B(LOCAL:1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)
@KOJO_BATTLE_EVENT_K[[キャラ:리사]], ARG, ARG:1, ARG:2
SIF ARG < 0 && NO:ARG != 4525
	RETURN 0
LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = EMPTY
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:4 == 0
			BTL_KOJO_RESULTS:0 = 생각하지 않고、느낀다！　라는 정도！
		ELSEIF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 갑니다ー！　모두！
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 끝내버리겠어！
		ELSE
			BTL_KOJO_RESULTS:0 = 갑니다ー！
		ENDIF
	CASE 2
		BTL_KOJO_RESULTS:0 = 호기！　저도 갑니다ー！
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;潜在反撃対策
		IF CFLAG:ARG:입력행동 == -1
			RETURN
		ENDIF
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 훗、좋은 기색～
		;弱点をついた。つまりCOOP発動
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 그런…싫은 느낌…
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 흥、어때！
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = 계속해서、갑니다♪
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = 못해먹겠어 이 느낌…
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 흙으로 돌아는 것…
			ELSE
				BTL_KOJO_RESULTS:0 = 소ー리ー아…미안…모두
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = 주、죽어버릴거야
		;無効
		ELSEIF ARG:2 == 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 소용없는데、바보처럼♪
			ELSE
				BTL_KOJO_RESULTS:0 = 무다무다무닷♪　이라고！
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = 감사♪　소스 님♪
		ENDIF
	CASE 15
		BTL_KOJO_RESULTS:0 = 아야ー！？　그런…
	CASE 16
		BTL_KOJO_RESULTS:0 = ホィサムロ！　일부러 고마워ー♪
	CASE 17
		BTL_KOJO_RESULTS:0 = 켁！　진짜 화났다！
	CASE 18
		BTL_KOJO_RESULTS:0 = 너의 공격은 간파했다…！　라는 정도♪
ENDSELECT
;SIF LOCALS != "EMPTY"
;	CALL MESSAGE_B(LOCAL:1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)

@EVOLUTE_PERSONA_K[[キャラ:리사]],ARG
IF CFLAG:ARG:페르소나강화플래그 == 1
	PRINTFORMW 「리사・실버맨、당신의 힘이 되고 싶다는 마음에」
	PRINTFORMW 「항상 당신 곁에 있던 페르소나가 응하려고 하는 것 같습니다」
	PRINTFORMW 「우리가 손을 잡고、페르소나의 새로운 힘을 꺼내 보입시다」
	PRINTL
	PRINTW
	PRINTW 페르소나「에로스」는、페르소나「에로스・개」로 다시 태어났다…
ELSE
	PRINTFORMW 「리사・실버맨、이전에 당신의 마음에 응한 페르소나입니다만」
	PRINTFORMW 「당신의 새로운 성장과 구상에 따라、페르소나도 새로운 힘을 얻으려고 하는 것입니다」
	PRINTFORMW 「지금 우리가 손을 잡고、페르소나의 힘을 한층 더 꺼내 보입시다」
	PRINTL
	PRINTW
	PRINTW 페르소나「에로스・개」는、페르소나「비너스」로 다시 태어났다…
ENDIF