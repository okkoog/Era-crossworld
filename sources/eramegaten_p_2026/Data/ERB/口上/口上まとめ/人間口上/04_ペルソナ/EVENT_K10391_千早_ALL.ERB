;	ENDIF
;ENDIF
;--------------------------------------------------
;簡易助手口上の発動時に初調教時口上をスキップ（Y1を助手のキャラ番号にする）
;複数人いる際には、SIF NO:ASSI == Y1 || NO:ASSI == Z1と追加していく
;--------------------------------------------------
;IF CFLAG:201 == 0 && ASSI > 0
;	SIF NO:ASSI == Y1
;		CFLAG:201 =1
;ENDIF
;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	PRINTFORMW 노예의 방、이곳에는 치하야라는 노예가 있다
	PRINTFORML 「다…당신이 %일인칭을% 유괴한 사람이군요…」
	PRINTFORMW 「…%일인칭을% 어떻게 할 거죠？」
	PRINTFORMW 마치 자신이 납치될 것을 알고 있었다는 듯한 말투다
	PRINTFORMW 그런 건 상관 않고 당신은 치하야에게 설명한다
	PRINTFORMW 「사람을 팔기 위해 조교…」
	PRINTFORMW 「그건…그…아프거나 하지는 않은가요？…」
	PRINTFORMW 「그…끔찍한 일은…별로 안 했으면 좋겠어요…」
	CFLAG:201 = 1
	RETURN 0
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	PRINTFORMW 「조교군요…알겠어요…」
	CFLAG:201 = 2
	RETURN 0
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	PRINTFORMW （역시…%일인칭은%、점점 이 사람을…）
	CFLAG:201 = 3
	RETURN 0
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW 「%일인칭은%、%CSTR:이인칭%에게서 벗어날 수 없다는 점괘가 나왔네요」
	PRINTFORMW 「이제 그 의미를 알 것 같아요」
	CFLAG:201 = 4
	RETURN 0
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		IF CFLAG:미조교함락 == 1
			;調教せずに恋慕をつけた場合
			PRINTFORMW 
		ELSE
			PRINTFORMW 「오셨군요、기다리고 있었어요！」
			PRINTFORMW %CALLNAME%은 포옹을 했다
			PRINTFORMW 「%CSTR:이인칭%%UNICODE(0x2661)%사랑해요%UNICODE(0x2661)%」
			PRINTFORMW 「계속 기대하고 있었어요、%CSTR:이인칭%이 오는 것을요%UNICODE(0x2661)%」
			PRINTFORMW 「그래서、음…무엇을 하면 좋을까요？」
			PRINTFORMW 「%CSTR:이인칭%한테는 무엇이든 해줄 수 있어요%UNICODE(0x2661)%」
			PRINTFORMW 「왜냐면 정말 즐겁거든요%UNICODE(0x2661)%」
		ENDIF
	;음란
	ELSEIF TALENT:4
		PRINTFORMW 「왔네요、기다리고 있었다구요！」
		PRINTFORMW %CALLNAME%은 자신을 만나기를 기대하는 것 같았다
		PRINTFORMW 「우후후、어디를 쓰고 싶으신가요？」
		PRINTFORMW 「손인가요？발인가요？입인가요？」
		PRINTFORMW 「…아니면 아래쪽 입、보지를 쓸껀가요%UNICODE(0x2661)%」
		PRINTFORML %CALLNAME은% 치부를 적나라하게 드러낸다
		PRINTFORMW 「%CSTR:이인칭%에게 만져질 때마다 야한 것을 좋아하게 되었어요%UNICODE(0x2661)%」
		PRINTFORMW 「야한 짓을 잔뜩 해 주세요%UNICODE(0x2661)%」
	;복종
	ELSEIF TALENT:5
		PRINTFORMW 「오셨군요、기다리고 있었어요！」
		PRINTFORMW %CALLNAME%은 자신과 만나기를 기대했던 것 같다
		PRINTFORML 「처음에는 무서웠지만」
		PRINTFORMW 「요즘은 %CSTR:이인칭%에게 조교받는 것이 즐거워졌어요」
		PRINTFORMW 「지금은 이 운명에 감사하고 있어요」
		PRINTFORMW 「이렇게 %이인칭을% 만날 수 있었으니까요%UNICODE(0x2661)%」
	ENDIF
	CFLAG:201 = 5
	RETURN 0
ENDIF

