;-------------------------------------------------
;調教開始時（2回目以降、4669をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_K[[キャラ:치하야]]
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORMW 「므…」
	PRINTFORMW 치하야는 당신을 노려보면서 말을 하지 않는다
	CFLAG:202 = 4
;屈服刻印Lv0
ELSEIF MARK:2 == 0 && (CFLAG:202 < 1 || FLAG:7 == 2)
	PRINTFORMW 「이런 일이 계속되면…언젠가는…」
	CFLAG:202 = 1
;屈服刻印Lv1
ELSEIF MARK:2 == 1 && (CFLAG:202 < 2 || FLAG:7 == 2)
	PRINTFORMW 「네…」
	CFLAG:202 = 2
;屈服刻印Lv2
ELSEIF MARK:2 == 2 && (CFLAG:202 < 3 || FLAG:7 == 2)
	PRINTFORMW 「조교인가요…알겠어요…」
	CFLAG:202 = 3
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0) && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORMW 「알겠어요。무엇을 원하시나요？」
	CFLAG:202 = 4
;陥落済み
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	IF 1== 0
	;恋慕、親愛
	ELSEIF TALENT:3 || TALENT:6
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		IF RAND:3 == 0
			PRINTFORMW 「우후후、오늘도 마음껏 사랑해 주세요%UNICODE(0x2661)%」 
		ELSEIF RAND:2 == 0
			PRINTFORMW 「므～、%CSTR:이인칭%、또 다른 여자애랑 놀고 있었네요」
			PRINTFORMW 「%CSTR:일인칭%도 잊지 말아주세요！」 
		ELSE
			PRINTFORMW 「%CSTR:이인칭%%UNICODE(0x2661)%오늘은 무엇을 원하시나요？」
			PRINTFORMW 「집안일인가요? 데이트인가요? 아·니·라·면……__P0__」
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		IF RAND:3 == 0
			PRINTFORMW 「우후후、오늘도 마음껏 엣찌한 거 해요%UNICODE(0x2661)%」
			PRINTFORMW 「빨리 딱딱해진 자지를 꺼내주세요%UNICODE(0x2661)%」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「므～、%CSTR:이인칭%、또 다른 여자애랑 놀고 있었네요」
			PRINTFORMW 「%CSTR:일인칭%도 잊지 말아주세요、보지가 슬퍼질 거예요%UNICODE(0x2661)%」
		ELSE
			PRINTFORMW 「오늘 무엇을 원하세요%UNICODE(0x2661)%」
			PRINTFORMW 「입으로 봉사할까요？가슴으로 봉사할까요？아니면…보지로 봉사할까요？%UNICODE(0x2661)%」
		ENDIF
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		IF RAND:3 == 0
			PRINTFORML 「기다리고 있었어요」
			PRINTFORMW 「오늘도 %일인칭을% 조교하는거군요」
		ELSEIF RAND:2 == 0
			PRINTFORMW 「%CSTR:이인칭%은 다른 사람들을 조교하느라 바쁘다는 걸 알고 있어요」
			PRINTFORMW 「하지만、%CSTR:일인칭%도 잊지 마세요」
			PRINTFORMW 「조금 외로워져요…」
		ELSE
			PRINTFORMW 「오늘은 무엇을 할까요？」
			PRINTFORMW 「아픈 일인가요？엣치한 일인가요？」
			PRINTFORMW 「어떤 것이든 괜찮아요」
		ENDIF
	ENDIF
	CFLAG:202 = 5
ENDIF
