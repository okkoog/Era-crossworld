;-------------------------------------------------
;EVENTEND関係（4669をキャラ番号に置換）
;調教終了時のセリフ
;-------------------------------------------------
@EVENTEND_K[[キャラ:치하야]]
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、4669を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL EVENTEND_PY1_K[[キャラ:치하야]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	SIF NO:ASSI == Y1
;	CALL EVENTEND_PY1_K[[キャラ:치하야]]
;	RETURN 0
;ENDIF
;--------------------------------------------------
;調教終了時のセリフ
;--------------------------------------------------
DRAWLINE
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:217 < 1 || FLAG:7 == 2)
	IF 陥落(TARGET) == 0
		PRINTFORMW 「………」
		PRINTFORMW 「절대 용서하지 않을 거예요…」
	ELSE
		PRINTFORMW 「이젠 몰라요！」
		PRINTFORMW %CALLNAME%에게 외면당했다
	ENDIF
	CFLAG:217 = 1
;屈服刻印Lv1以下
ELSEIF MARK:2 <= 1 && (CFLAG:219 < 1 || FLAG:7 == 2)
	PRINTFORMW 「이제서야 끝났군요…」
	CFLAG:219 = 1
;屈服刻印Lv2
ELSEIF MARK:2 == 2
	PRINTFORMW 「하아…하아…」
	PRINTFORMW 「이제 끝난 거군요」
	CFLAG:219 = 2
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW 「후우…다음에도 잘 부탁드려요」
	CFLAG:219 = 3
;陥落済み＋体力500未満
ELSEIF BASE:0 < 500 && (CFLAG:218 < 1 || FLAG:7 == 2)
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		IF RAND:2 == 0
			PRINTFORMW 「하아…하아…」
			PRINTFORMW 「너무 사랑에 푹 빠졌네요…%UNICODE(0x2661)%」
		ELSE
			PRINTFORMW 「…더 이상은 %UNICODE(0x2661)%　너무 힘들어요%UNICODE(0x2661)%」
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		IF RAND:2 == 0
			PRINTFORMW 「하아…하아…」
			PRINTFORMW 「자지를 잔뜩 받을 수 있어서 행복해요%UNICODE(0x2661)%」
		ELSE
			PRINTFORMW 「후우…」
			PRINTFORMW 「벌써 보지가 꽉 찼어요%UNICODE(0x2661)%」
		ENDIF
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		IF RAND:2 == 0
			PRINTFORMW 「하아…하아…」
			PRINTFORMW 「더는 무리에요…」
		ELSE
			PRINTFORMW 「후우…」
			PRINTFORMW 「죄송해요、오늘은 여기까지에요…」
		ENDIF
	ENDIF
	CFLAG:218 = 1
;陥落済み
ELSEIF CFLAG:219 < 4 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		IF RAND:2 == 0
			PRINTFORMW 「오늘은 여기까지 인가요？」
			PRINTFORMW 「다음에도 많이 사랑해 주세요！」
		ELSE
			PRINTFORMW 「오늘은 여기까지 인가요？」
			PRINTFORMW 「아직은 좀 부족할지도 모르겠어요…%UNICODE(0x2661)%」
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		IF RAND:2 == 0
			PRINTFORMW 「오늘은 여기까지 인가요？」
			PRINTFORMW 「자지 더 갖고 싶었어요…」
		ELSE
			PRINTFORMW 「오늘은 여기까지 인가요？」
			PRINTFORML 「조금 부족해요」
			PRINTFORMW 「좀 더 보지를 해주었으면 해요…」
		ENDIF
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		IF RAND:2 == 0
			PRINTFORMW 「오늘은 여기까지 인가요？」
			PRINTFORMW 「이번엔 조금 이른 감이 있네요」
		ELSE
			PRINTFORMW 「오늘은 여기까지 인가요？」
			PRINTFORMW 「다시 불러주시는 것을 기대하고 있을게요」
		ENDIF
	ENDIF
	CFLAG:219 = 4
ENDIF
RETURN 0

