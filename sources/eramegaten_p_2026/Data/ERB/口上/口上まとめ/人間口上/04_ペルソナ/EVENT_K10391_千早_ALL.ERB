;20,키스한다
;-------------------------------------------------
	CASE 20
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:312 == 0
			;恋慕、親愛	
			IF TALENT:3 || TALENT:6 && (CFLAG:312 < 4 || FLAG:7 == 2)	
				PRINTFORMW 「우후후、좋아하는 사람과 키스할 수 있다니 기쁘네요」
				CFLAG:312= 4
			;淫乱、娼婦	
			ELSEIF TALENT:4 || TALENT:7 && (CFLAG:312 < 4 || FLAG:7 == 2)	
				PRINTFORMW 「으응…、츄…」
				PRINTFORMW %CALLNAME%은 적극적으로 혀를 놀린다。
				CFLAG:312= 4
			;服従、隷属	
			ELSEIF TALENT:5 || TALENT:8 && (CFLAG:312 < 4 || FLAG:7 == 2)	
				PRINTFORMW 「괜찮아요。%CSTR:일인칭%의 입술을 뺏어주세요」
				CFLAG:312= 4
			ELSE	
				PRINTFORMW 「그、그만둬주세요、아직 누구와도…」
				PRINTFORMW %CALLNAME은% 싫어하고 있었지만 억지로 입술을 빼앗았다
				CFLAG:312= 3
			ENDIF	
			CFLAG:312 = 1
		;二回目以降					
		ELSE			
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8 || ABL:0 >= 3) && (CFLAG:312 < 3 || FLAG:7 == 2)		
				;通す	
				IF 0 == (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8 || ABL:0 >= 3) && (CFLAG:312 < 3 || FLAG:7 == 2)	
				;恋慕、親愛	
				ELSEIF TALENT:3 || TALENT:6 && (CFLAG:312 < 4 || FLAG:7 == 2)	
						IF RAND:2 == 0
							IF RAND:2 == 0	
								PRINTFORMW 「응…、츄……%UNICODE(0x2661)%」
							ELSE				
								PRINTFORMW 「응…츄%UNICODE(0x2661)%…하아…으음…」
							ENDIF				
						IF RAND:3 == 0 && ABL:MASTER:기교 > 3
							PRINTFORMW 「하앙…%UNICODE(0x2661)% 머리가 녹아버릴 것 같아요」
						ELSEIF ABL:기교 < 3
							PRINTFORMW 「키스는 의외로 어렵네요」
						ELSE
							PRINTFORMW 「조금 익숙해졌어요」
						ENDIF
					ELSE
						PRINTFORMW 「에헤헤、잔뜩 키스하자구요%UNICODE(0x2661)%」
					ENDIF
					CFLAG:312= 4
				;淫乱、娼婦	
				ELSEIF TALENT:4 || TALENT:7 && (CFLAG:312 < 4 || FLAG:7 == 2)	
					IF RAND:2 == 0
						PRINTFORMW 「응…、츄……、츄…음%UNICODE(0x2661)%」
					ELSE
						PRINTFORMW 「응…츄%UNICODE(0x2661)%…핫…으응…」
					ENDIF
					
					IF RAND:3 == 0 && ABL:MASTER:기교 > 3
						PRINTFORMW 「하앙…%UNICODE(0x2661)% 머리가 녹아버릴 것 같아요」
					ELSEIF RAND:2 == 0 && ABL:기교 > 3
						SIF TALENT:MASTER:남자 || TALENT:MASTER:후타나리
							PRINTFORMW 「우훗、%CSTR:일인칭%의 키스로 자지가 움찔움찔 하고 있어요 %UNICODE(0x2661)%」
					ELSE
						PRINTFORMW 「응 하아、입 안이 따뜻해요…%UNICODE(0x2661)%」
					ENDIF
					CFLAG:312= 4
				;服従、隷属	
				ELSEIF TALENT:5 || TALENT:8 && (CFLAG:312 < 4 || FLAG:7 == 2)	
					IF RAND:2 == 0
						PRINTFORMW 「응…、응츄……」
						IF RAND:3 == 0 && ABL:MASTER:기교 > 3
							PRINTFORMW 「하앙…%UNICODE(0x2661)% 머리가 녹아버릴 것 같아요」
						ELSEIF ABL:기교 > 3
							PRINTFORMW 「키스는 의외로 어렵네요」
						ELSE
							PRINTFORMW 「조금 익숙해졌어요」
						ENDIF
					ELSE
						PRINTFORMW 「네、잔뜩 키스하자구요」
					ENDIF
					CFLAG:312= 4
				;従順Lv3以上	
				ELSE	
					PRINTFORMW 「……아아、괜찮아요…」
					CFLAG:312= 3
				ENDIF	
			;それ以外
			ELSEIF CFLAG:312 < 2 || FLAG:7 == 2
				PRINTFORMW 「………」
				CFLAG:312 = 2
			ENDIF
		ENDIF

