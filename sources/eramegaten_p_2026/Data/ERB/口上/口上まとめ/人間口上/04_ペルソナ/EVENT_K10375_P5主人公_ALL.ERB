;--------------------------------------------------
;簡易助手口上の発動時に初調教時口上をスキップ（Y1を助手のキャラ番号にする）
;複数人いる際には、SIF NO:ASSI == Y1 || NO:ASSI == Z1と追加していく
;--------------------------------------------------
;IF CFLAG:201 == 0 && ASSI > 0
;	SIF NO:ASSI == Y1
;		CFLAG:201 =1
;ENDIF
;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
IF CFLAG:201 == 0
	PRINTL 포인트가 허락하는 한 자유롭게 소질을 부여할 수 있습니다
	CALL INPUT_YN("キャラメイクをする", "そんな感じで")
	IF RESULT == 0
		PRINTFORML 자신의 이미지에 맞도록 %CALLNAME:TARGET%의 소질을 메이킹해 주십시오
		CALL MAKE_CHARA_TALENT(TARGET, 25)
	ELSE
		;
		TALENT:헌신적 = 1
		TALENT:보수적 = 1
		TALENT:습득빠름 = 1
		TALENT:꿋꿋함 = 1
		TALENT:아픔에약함 = 1
		TALENT:매혹 = 1
		TALENT:호기심 = 1
		TALENT:쾌감에솔직 = 1
		TALENT:눈에띄고싶어함 = 1
	ENDIF
ENDIF
;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	PRINTFORMW 검은 뿔테 안경으로 얼굴을 가린 소년은 %CALLNAME:MASTER%에게 날카로운 시선을 던져온다.
	PRINTFORMW 제법 전투의 소질도 있어 보인다.
	PRINTFORMW %CALLNAME:MASTER%은(는) 자신이 조교사라는 것과, %CALLNAME:TARGET%의 경력을 알고 있으며 노예로 다룰 것임을 간결하게 고했다.
	PRINTFORMW 
	PRINTFORMW 「…%CSTR:11%들의 사냥감은 네놈 같은 녀석들뿐이었다고」
	PRINTFORMW 얌전한 모습을 벗어던진 %CALLNAME:TARGET%의 목소리는 낮고 차갑다.
	;竜司助手
	IF 助手確認([[キャラ:류지]])	
		PRINTFORMW 『%CSTR:11%들』이란 \@TALENT:남자 ? 그 녀석 # 이 아이 \@을(를) 말하는 건가, 라며 %CALLNAME:MASTER%은(는) 대기시키고 있던 %CALLNAME:ASSI%을(를) 불러들였다.
		PRINTFORM 눈을 크게 뜬 %CALLNAME:TARGET%에게 %CALLNAME:ASSI%
			IF TALENT:ASSI:3 || TALENT:ASSI:6
				PRINTW 은(는) 싹싹한 어조로 말을 걸어왔다.
				SETCOLOR COLOR("orange")
				PRINTFORMW 『어? %CALLNAME%? 뭐야 너도 있었냐!』
			ELSEIF TALENT:ASSI:4 || TALENT:ASSI:7
				PRINTW 은(는) 욕정을 숨기지 않고 거친 숨을 몰아쉬고 있다.
				SETCOLOR COLOR("orange")
				PRINTFORMW 『%CALLNAME%, 너도 곧 %CALLNAME:MASTER% 없인 못 살게 될 거다』
			ELSEIF TALENT:ASSI:5 || TALENT:ASSI:8
				PRINTW 은(는) 어두운 미소를 짓고 있다.
			ELSE
				PRINTW 도 경악하여 입을 벌리고 있다.
				SETCOLOR COLOR("orange")
				PRINTFORMW 『진짜냐, 뭐 하는 거야 너……』
			ENDIF
		CFLAG:203 = 1
	;杏助手
	ELSEIF 助手確認([[キャラ:나나코]])
		PRINTFORMW 『%CSTR:11%들』이란 \@TALENT:남자 ? 그 녀석 # 이 아이 \@을(를) 말하는 건가, 라며 %CALLNAME:MASTER%은(는) 대기시키고 있던 %CALLNAME:ASSI%을(를) 불러들였다.
		PRINTFORM 눈을 크게 뜬 %CALLNAME:TARGET%에게 %CALLNAME:ASSI%은(는) 다가가 손을 잡았다.
			IF TALENT:ASSI:3 || TALENT:ASSI:6
				SETCOLOR COLOR("crimson")
				PRINTFORMW 『%CALLNAME%? 아하핫, 뭐야 리더도 있었잖아%UNICODE(0x2661)%』
			ELSEIF TALENT:ASSI:4 || TALENT:ASSI:7
				SETCOLOR COLOR("crimson")
				PRINTFORML 『괜찮아, 엄청 기분 좋아질 테니까. 조커도 같이 하자?』
			ELSEIF TALENT:ASSI:5 || TALENT:ASSI:8
				PRINTFORML 그대로 %CALLNAME:TARGET%을(를) 짓눌렀다.
			ELSE
				SETCOLOR COLOR("crimson")
				PRINTFORML 『조커! 어째서 이런 곳에 있는 거야?!』
			ENDIF
		CFLAG:204 = 1
	ELSE
		PRINTFORMW 쾌락에 절여진 나날 속에서 언제까지 무관심할 수 있을지 볼만하겠군.
		PRINTFORMW 그렇게 생각하며 %CALLNAME:MASTER%은(는) %CALLNAME:TARGET%을(를) 침대에 밀쳐 넘어뜨렸다.
	ENDIF
	CFLAG:201 = 1
	RETURN 0
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	PRINTFORMW 
	PRINTFORMW 
	PRINTFORMW 
	CFLAG:201 = 2
	RETURN 0
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	PRINTFORMW 
	CFLAG:201 = 3
	RETURN 0
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW 
	PRINTFORMW 
	PRINTFORMW 
	CFLAG:201 = 4
	RETURN 0
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		IF CFLAG:미조교함락 == 1
			;調教せずに恋慕をつけた場合
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
	;음란
	ELSEIF TALENT:4
		PRINTFORMW 
	;복종
	ELSEIF TALENT:5
		PRINTFORMW 
	ENDIF
	CFLAG:201 = 5
	RETURN 0
ENDIF

;-------------------------------------------------
;簡易助手口上（Y1を助手のキャラ番号に置換、4665をキャラ番号に変更する) CFLAG203
;掛け合いをするキャラを増やす場合は、構文をコピー＆ペーストをして、CFLAGの数を204、205と増やす
;-------------------------------------------------
;助手の有無をチェック（いない場合は二回目以降へ飛ぶ）
IF ASSI < 0 
	CALL EVENTTRAIN_SECOND_K[[キャラ:P5주인공]]
;竜司助手
ELSEIF 助手確認([[キャラ:류지]])
	;初めて
	IF CFLAG:203 == 0
		;陥落済み＋陥落時初口上が発生済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && CFLAG:201 >= 5
			;双方陥落済み
			IF TALENT:ASSI:3 || TALENT:ASSI:4 || TALENT:ASSI:5 || TALENT:ASSI:6 || TALENT:ASSI:7 || TALENT:ASSI:8
				PRINTFORMW 『어? %CALLNAME%? 뭐야 너도 있었냐!』
				PRINTFORMW %CALLNAME:ASSI%에게 미묘한 부위를 애무당하는 %CALLNAME%도 싫지만은 않은 모양이다…
			ELSE
				PRINTFORML 『젠장, 또 이런 곳에 끌고 와선, 이번엔 뭐… 으엑?!』
				PRINTFORMW 분부대로 알몸으로 마중 나온 %CALLNAME%의 모습에, %CALLNAME:ASSI%은(는) 할 말을 잃은 모양이다…
				PRINTFORMW 
			ENDIF
		;それ以外
		ELSE
			;助手陥落済み
			IF TALENT:ASSI:3 || TALENT:ASSI:4 || TALENT:ASSI:5 || TALENT:ASSI:6 || TALENT:ASSI:7 || TALENT:ASSI:8
				PRINTFORML 『뭐냐 너, 아직도 %CALLNAME:MASTER%한테 오기 부리고 있는 거냐』
				PRINTFORMW %CALLNAME:MASTER%에게 완전히 심취해 버린 %CALLNAME:ASSI%의 모습에, 진짜냐며 %CALLNAME%은(는) 하늘을 우러러보았다
			ELSE
				PRINTFORMW 『진짜냐, 뭐 하는 거야 너……』
				PRINTFORMW 남 말 할 처지냐는 듯, %CALLNAME%은(는) %CALLNAME:ASSI%에게 입술을 삐죽 내밀고 있다
			ENDIF
		ENDIF
		CFLAG:203 = 1
	;二回目以降
	ELSEIF CFLAG:203 < 2 || FLAG:7 == 2
		;陥落済み
		IF TALENT:3 || TALENT:6
		ELSEIF TALENT:4 || TALENT:5 || TALENT:7 || TALENT:8
			;双方陥落済み
			IF TALENT:ASSI:3 || TALENT:ASSI:4 || TALENT:ASSI:5 || TALENT:ASSI:6 || TALENT:ASSI:7 || TALENT:ASSI:8
				PRINTFORMW 『헤헤… 그런 걸 탐스러운 눈으로 쳐다보다니, 조커 진짜 음란하네에』
				PRINTFORMW %CALLNAME:ASSI%은(는) 자신의 가랑이를 %CALLNAME%의 앞에 불쑥 내밀며 도발하고 있다
			ELSE
				
				IF RAND:2 == 0
					PRINTFORML 『너 임마…… 괜찮은 거냐, 이걸로』
					PRINTFORMW 풀린 눈동자로 %CALLNAME:ASSI%의 가랑이에 뺨을 비비는 %CALLNAME%에게는 씁쓸함이 밴 그 목소리가 닿지 않는 모양이다……
				ELSE
					IF HAVE_PENIS(ASSI)
					PRINTFORML 방에 들어선 %CALLNAME:ASSI%의 앞에 무릎을 꿇은 %CALLNAME%은(는), 재빠르게 %CALLNAME:ASSI%의 페니스를 드러내더니
					PRINTFORMW 인사 대신이라는 듯 펠라치오를 시작했다
					PRINTFORMW 『…윽, 그만, %CALLNAME%, 이런 거, 아니잖아, 큭!』
					PRINTFORML 얼굴을 찡그리면서도, 직접적인 자극에 %CALLNAME:ASSI%의 페니스는 눈 깜짝할 사이에 단단하게 발기해 갔다……
					ENDIF
				ENDIF
			ENDIF
		;それ以外
		ELSE
			;助手陥落済み
			IF TALENT:ASSI:3 || TALENT:ASSI:4 || TALENT:ASSI:5 || TALENT:ASSI:6 || TALENT:ASSI:7 || TALENT:ASSI:8
				PRINTFORMW 『야아, 슬슬 솔직해지라고 %CALLNAME%』
			ELSE
				PRINTFORMW 『미안하다 %CALLNAME%…… 나,』
				PRINTFORML 고개를 떨구는 %CALLNAME:ASSI%의 어깨를 달래듯 %CALLNAME:ASSI%은(는) 쓰다듬고 있다
			ENDIF
		ENDIF
		CFLAG:203 = 2
	ENDIF	
;杏助手
ELSEIF 助手確認([[キャラ:유스케]])
	;初めて
	IF CFLAG:204 == 0
		;陥落済み＋陥落時初口上が発生済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && CFLAG:201 >= 5
			;双方陥落済み
			IF TALENT:ASSI:3 || TALENT:ASSI:4 || TALENT:ASSI:5 || TALENT:ASSI:6 || TALENT:ASSI:7 || TALENT:ASSI:8
				PRINTFORMW 『%CALLNAME%? 아하핫, 뭐야 리더도 있었잖아%UNICODE(0x2661)%』
			ELSE
				PRINTFORML 『조커! 어째서 이런 곳에 있는 거야?!』
				IF HAVE_PENIS(ASSI)
					PRINTFORMW 『아, 아, 싫어. 보지 마! 보지 마아앗!』
					PRINTFORMW %CALLNAME:ASSI%은(는) 가랑이에 자라난 물건을 %CALLNAME%에게서 숨기려고 웅크려 앉았다
				ELSE
					PRINTFORML 『거짓말이지, %CALLNAME%! 저기 대체 어떻게 된 거야…』
					PRINTFORMW 분부대로 알몸으로 마중 나온 %CALLNAME%의 모습에, %CALLNAME:ASSI%은(는) 할 말을 잃은 모양이다…
				ENDIF
			ENDIF
		;それ以外
		ELSE
			PRINTFORML 『거짓말이지, %CALLNAME:MASTER%. %CALLNAME%한테까지 이런 짓을 하는 거야?!』
		ENDIF
		CFLAG:204 = 1
	;二回目以降
	ELSEIF CFLAG:204 < 2 || FLAG:7 == 2
		;陥落済み
		IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
			IF RAND:2 == 0
				PRINTFORML 『우후후%UNICODE(0x2661)% 빨리 기분 좋은 거 하자』
				PRINTFORMW 풀린 눈동자로 자신의 가랑이에 뺨을 비비는 %CALLNAME%의 머리를 쓰다듬으며 %CALLNAME:ASSI%은(는) 요염하게 웃었다
			ELSE
				IF HAVE_PENIS(ASSI)
				PRINTFORML 방에 들어선 %CALLNAME:ASSI%의 앞에 무릎을 꿇은 %CALLNAME%은(는), 재빠르게 %CALLNAME:ASSI%의 페니스를 드러내더니
				PRINTFORMW 인사 대신이라는 듯 펠라치오를 시작했다
				PRINTFORMW 『응, 기분 좋아… 조커 변태%UNICODE(0x2661)%』
				ENDIF
			ENDIF
		;それ以外
		ELSE
			PRINTFORMW 『%CALLNAME%, 미안해…』
			PRINTFORML %CALLNAME%은(는) 조용히 미소를 띠며, 고개를 끄덕이고 있다
		ENDIF
		CFLAG:204 = 2
	ENDIF	
;オイナリ助手
ELSEIF 助手確認([[キャラ:유스케]])
	;初めて
	IF CFLAG:205 == 0
		;陥落済み＋陥落時初口上が発生済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && CFLAG:201 >= 5
			;双方陥落済み
			IF TALENT:ASSI:3 || TALENT:ASSI:4 || TALENT:ASSI:5 || TALENT:ASSI:6 || TALENT:ASSI:7 || TALENT:ASSI:8
				PRINTFORMW 『%CALLNAME%? %CALLNAME%도… 그런가, 여기서도 잘 부탁하지』
			ELSE
