;-------------------------------------------------
@KOJO_MESSAGE_ENDING_K[[キャラ:토오루]]_2
;--------------------------------------------------
SELECTCASE TSTR:END종별
	CASE "個別END"
		DRAWLINE
		PRINTFORMW …………
		PRINTFORMW ………
		PRINTFORMW ……
		PRINTFORML 
		PRINTFORMW 「계속 궁금했지만」
		PRINTFORMW 「왜 버리지 않았습니까?」
		PRINTFORMW 아이러니하게도 매도도 아니고, 단지 순수하게 의문이었다고 %CALLNAME:TARGET%는 말했다.
		;主人も対象もレベルが一定以上
		IF BASE:MASTER:LV >= 80 && BASE:TARGET:LV >= 80
			PRINTFORMW 「그럼 지금이라면 %CSTR:일인칭%도 %CSTR:이인칭%와 나란히 할 정도로 강한 자신감이 있습니다.」
			PRINT "그러나
		ELSEIF BASE:MASTER:LV >= 50 && BASE:TARGET:LV >= 50
			PRINTFORMW 「그럼 지금이라면 %CSTR:일인칭%도 다소 %CSTR:이인칭%의 힘이 될 수 있다고 생각합니다.」
			PRINT "하지만
		ELSEIF BASE:MASTER:LV >= 30 && BASE:TARGET:LV >= 30
			PRINTFORMW 「%CSTR:이인칭%도 %CSTR:일인칭%도 그렇게 어리석은만큼 강하지는 않습니다.」
			PRINT "그러나
		;レベル差がひどい
		ELSEIF BASE:MASTER:LV >= 50 && BASE:TARGET:LV < 10
