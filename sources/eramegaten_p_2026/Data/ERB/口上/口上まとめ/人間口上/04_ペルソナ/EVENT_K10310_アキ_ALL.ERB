CASE 11
	SIF CFLAG:271 >= 1 && FLAG:7 != 2
		RETURN 0
	CALL EVENT_MESSAGE
;妊娠対象をTARGETに格納し、父親は奴隷はV、助手はWとする
;崩壊してしまった場合
	IF TALENT:9 == 1
		PRINTFORMW 
;父親が主人で母親が恋慕か親愛持ち
	ELSEIF (TALENT:3 || TALENT:6) && CFLAG:102 == 1
		PRINTFORMW 
;父親が奴隷か助手で母親が淫乱か娼婦持ち
	ELSEIF (TALENT:4 || TALENT:7) && (CFLAG:102 == 2 || CFLAG:102 == 3)
		;父親(助手）との相性が100より大きい場合
		IF CFLAG:102 == 2 && GET_RELATION(TARGET, W) > 125
			PRINTFORMW 
	 	;父親(奴隷）との相性が100より大きい場合
		ELSEIF CFLAG:102 == 3 && GET_RELATION(TARGET, V) > 125
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
;服従か隷属持ち
	ELSEIF (TALENT:5 || TALENT:8)
		PRINTFORMW 
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:271 = 1

