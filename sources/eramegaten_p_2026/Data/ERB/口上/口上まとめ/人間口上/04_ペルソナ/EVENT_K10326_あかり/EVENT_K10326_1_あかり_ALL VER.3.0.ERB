@KOJO_BATTLE_EVENT_K[[キャラ:아카리]]_1, ARG, ARG:1, ARG:2
SIF ARG < 0 && NO:ARG != 4518
	RETURN 0
LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = EMPTY
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 쵸메쵸메 타임！
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 모두들! %CSTR:ARG:일인칭%을(를) 따라와-!
		ELSE
			BTL_KOJO_RESULTS:0 = 악은 반드시 패배하게 되어 있다구-!
		ENDIF
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:일인칭%도 뒤따를게!
			ELSE
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%과(와) 함께 쵸메쵸메 타-임!
			ENDIF
		ELSEIF FLAG:행동순1 != -1 && NO:(FLAG:행동순1) == [[キャラ:벨페고르]]
		;ベルフェゴールが発動した場合。原作でセットで出てきたので。
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 언제나 이랬다면 유능했을 텐데!
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 전생전사의 부하로서 이 정도는 당연하니까!
			ELSE
				BTL_KOJO_RESULTS:0 = 그, 그건 아직 안 배운 한자였을 뿐인걸!
			ENDIF
		;それ以外
		ELSE
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 혼쭐을 내주마-!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 아-! %CSTR:일인칭%을(를) 놔두고 일제공격 같은 건 못 하게 할 거니까-!
			ELSE
				BTL_KOJO_RESULTS:0 = 모두의 힘으로 너를 쓰러뜨리겠-다!
			ENDIF
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;潜在反撃対策
		IF CFLAG:ARG:입력행동 == -1
			RETURN
		ENDIF
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%、해냈어！ 보고 있었지！？
			ELSE
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 훗훗후、정의는 반드시 승리한다！
				ELSE
					BTL_KOJO_RESULTS:0 = 전생전사 이슈킥의 힘, 톡톡히 깨달았겠지-!
				ENDIF
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 좋-아! 지금이다! 데빌 크-… 어라?
				ELSE
					BTL_KOJO_RESULTS:0 = 아-, 모처럼의 쵸메쵸메 타임인데 방어 같은 걸 하다니 치사해-!
				ENDIF
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 어-떠냐! 이것이 전생전사의 힘이다!
			ELSE
				BTL_KOJO_RESULTS:0 = 훗훗후、곧바로 쵸메쵸메 해 줄테니까
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 20
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 아직이야、이정도가 아니니깐！
			ELSE
				BTL_KOJO_RESULTS:0 = 어-떠냐!
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 어라？　별로 효과가 없어？
			ELSE
				BTL_KOJO_RESULTS:0 = 우-, 생각보다 반응이 없네-
			ENDIF
		ELSEIF ARG:2 == 0
			IF 陥落(ARG) && RAND:2 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%、효과가 없어。어쩌지！？
			ELSE
				BTL_KOJO_RESULTS:0 = 아우우, 전혀 효과가 없어-
			ENDIF
		ELSEIF ARG:2 < 0
			IF 陥落(ARG) && RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 아우우、실수해버렸다…미안해요、%CSTR:이인칭%
			ELSE
				BTL_KOJO_RESULTS:0 = 뭐야-! %CSTR:ARG:일인칭%의 공격으로 회복하다니 치사해-
			ENDIF
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%… 미안해… %CSTR:ARG:일인칭%, 이제 틀린 것 같아…
			ELSE
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 우우…정의가 지다니…
				ELSE
					BTL_KOJO_RESULTS:0 = 아…、아직 %CSTR:ARG:일인칭%는…우으…
				ENDIF
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF 陥落(ARG) && RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 도와줘…、%CSTR:이인칭%
			ELSE
				BTL_KOJO_RESULTS:0 = 싫어어…%CSTR:ARG:일인칭%、이런 곳에서 죽고 싶지 않아…
			ENDIF
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 아파-아
			ELSE
				BTL_KOJO_RESULTS:0 = 꺄아-
			ENDIF
		ELSEIF ダメージ割合(ARG, ARG:2) > 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 아팟……？、어、별로 아프지 않네
			ELSE
				BTL_KOJO_RESULTS:0 = 후후, 전혀 효과 없다구-
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 헤헤-엥, 이런 공격 소용없다구-
			ELSE
				BTL_KOJO_RESULTS:0 = 이 이슈킥에게 그런 공격은 헛수고야-
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 회복시켜주다니 고마워-
			ELSE
				BTL_KOJO_RESULTS:0 = 회복시켜준다고 해도, 악은 용서하지 않으니까-
			ENDIF
		ENDIF
	CASE 15
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 우와、되받아치다니
		ELSE
			BTL_KOJO_RESULTS:0 = 그러지 마-! 되받아쳐 봤자 소용없으니까!
		ENDIF
	CASE 16
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 그런 공격을 이 이슈킥에게 하는 것부터가 잘못된 거야-
		ELSE
			BTL_KOJO_RESULTS:0 = 깡！　랄까나
		ENDIF
	CASE 17
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 우-, 건방진 녀석-!
		ELSE
			BTL_KOJO_RESULTS:0 = 제엔장-! 다음엔 빗맞히지 않을 테니까-!
		ENDIF
	CASE 18
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 이 이슈킥에게 공격을 맞추려면 아직 백억 광년은 멀었어！
		ELSE
			BTL_KOJO_RESULTS:0 = 그런 공격 따위 안 맞는다구-
		ENDIF
ENDSELECT
;SIF LOCALS != "EMPTY"
;	CALL MESSAGE_B(LOCAL:1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)
	


@KOJO_BATTLE_MESSAGE_K[[キャラ:아카리]]_1,ARG,ARG:1 = 0
LOCAL:1 = 1
LOCAL = CFLAG:ARG:입력행동
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = EMPTY
;タイプ取得
CALL GET_SKILL_PROP, "SKILL_EFECT", LOCAL, ARG
IF LOCAL == 0
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 이얍！
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 테에잇！
	ELSE
		IF RESULT == 4
			BTL_KOJO_RESULTS:0 = 천진난만 베기！
		ELSEIF RESULT == 3
			BTL_KOJO_RESULTS:0 = 맞아랏-!
		ELSEIF RESULT == 2
			BTL_KOJO_RESULTS:0 = 이슈킥 퍼언-치잇!
		ELSE
			BTL_KOJO_RESULTS:0 = 우랴-앗!
		ENDIF
	ENDIF
ELSEIF LOCAL == [[스킬:ＧＵＮ]]
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 양손으로…… 꽉 쥐고……!
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 상대를 똑바로 보고…… 쏜다!
	ELSE
		BTL_KOJO_RESULTS:0 = 저기… 여길 이렇게 해서… 쏠게!
	ENDIF
;공격
ELSEIF RESULT == 1 && RAND:2 == 0
	CALL GET_SKILL_PROP, "SKILL_TYPE", CFLAG:ARG:입력행동, ARG,ARG
	SELECTCASE RESULT
		;검격
		CASE 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 받아랏! 필살검 천진난만 베기잇!
			ELSE
				BTL_KOJO_RESULTS:0 = 정의의 칼날을 받아라-!
			ENDIF
		;비구
		CASE 1
			;ペルソナがイシュキックになると違和感があったので修正
			;BTL_KOJO_RESULTS:0 = %GET_PERSONA_NAME(ARG)%！　うちおとしちゃって！
			BTL_KOJO_RESULTS:0 = 떨어뜨려 주겠어!
		;타격
		CASE 2
			BTL_KOJO_RESULTS:0 = 정의의 철권을 받아라-앗!!
		;전술
		CASE 3
			BTL_KOJO_RESULTS:0 = 가루가 되도록 묵사발을 만들어주마-!
		;화염
		CASE 4
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 하얗게 불타버려랏!
			ELSE
				BTL_KOJO_RESULTS:0 = 불꽃이여! 다 태워버려라-!
			ENDIF
		;빙결
		CASE 5
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 얼어붙어 버려라-!
			ELSE
				BTL_KOJO_RESULTS:0 = 트랜스마이그레이션 블리자-드잇!
			ENDIF
		;전격
		CASE 6
			BTL_KOJO_RESULTS:0 = 이슈킥 썬더!
		;충격
		CASE 7
			;素質に持っているので加筆。
			IF RAND:5 == 0
				BTL_KOJO_RESULTS:0 = 날려버려 주마-!
			ELSEIF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 날아가 버려라-!
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 가라아-!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 바이바이!
			ELSE
				;完全にネタ（しかも分かりづらい）
				BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%을(를), 얕보지 마라아아!!!
			ENDIF
		;신경
		;CASE 8	
		;정신
		;CASE 9
		;파마
		CASE 10
			BTL_KOJO_RESULTS:0 = 사악한 악마 녀석-! 이 이슈킥이 정화해 주마-!
		;주살
		CASE 11
			BTL_KOJO_RESULTS:0 = 이 이슈킥이, 저기… 그렇지! 저주해 주마-!
		;지변
		CASE 12
			BTL_KOJO_RESULTS:0 = 대지여! 진동하라-!
		;수격
		CASE 13
			BTL_KOJO_RESULTS:0 = 이슈킥 아쿠아 스플래-시!
		;질풍
		;素質に持っているので加筆。
		CASE 14
			;レベルで覚える最終技のガルバリオンと一応マハ・ガルバリオン
			IF RANGE(CFLAG:ARG:입력행동, 1739, 1740)
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 전부 티끌이 되어라-!
				ELSE
					BTL_KOJO_RESULTS:0 = 폭풍이여! 집어삼켜라!
				ENDIF
			ELSEIF RAND:3 == 0
				;このセリフ言う人すでに実装されてる気がしますが気にしない。
				BTL_KOJO_RESULTS:0 = 바람이다-!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 바람의 칼날이여! 베어 갈라라!
			ELSE
				BTL_KOJO_RESULTS:0 = 가라-! 갈라버려라-!
			ENDIF
		;중력
		CASE 15
			BTL_KOJO_RESULTS:0 = 그라비에이션 어택!
		;핵열
		CASE 16
			BTL_KOJO_RESULTS:0 = 흔적도 없이, 날려버려 주마-!
		;만능
		CASE 17
			IF RAND:2 == 0
				;ペルソナがイシュキックになると違和感があったので修正
				;BTL_KOJO_RESULTS:0 = %GET_PERSONA_NAME(ARG)%！　みんなやっつけちゃって！
				BTL_KOJO_RESULTS:0 = 전부 해치워버릴 테니까!
			ELSE
				CALL GET_SKILL_PROP, "SKILL_NAME", LOCAL, ARG
				BTL_KOJO_RESULTS:0 = 이렇게 된 이상 최종 수단이다! %RESULTS%!
			ENDIF
		;사이코
		;CASE 18
		CASEELSE
			BTL_KOJO_RESULTS:0 = 이거나 먹어라!
	ENDSELECT
;회복
ELSEIF RESULT == 2 && RAND:2 == 0
	IF CFLAG:ARG:타겟 > 6
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 다들! 괜찮아!?
		ELSE
			BTL_KOJO_RESULTS:0 = 페르소나! 모두를 부탁해!
		ENDIF
	ELSE
		IF FLAG:(CFLAG:ARG:타겟) == 0 && 陥落(ARG)
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%은(는) %CSTR:ARG:일인칭%이(가) 지킬 거니까
			ELSE
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%! 괜찮아!?
			ENDIF
		ELSE
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 치유의 힘이여!
			ELSE
				BTL_KOJO_RESULTS:0 = 괜찮아!?
			ENDIF
		ENDIF
	ENDIF
;状態変化
;ELSEIF RESULT == 3
;特殊
ELSEIF RESULT == 4 && RAND:2 == 0
	;気合、コンセ
	IF RANGE(CFLAG:ARG:입력행동, 511, 512)
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 지-입중해야 해……
		ELSE
			BTL_KOJO_RESULTS:0 = 정의의 힘을……!
		ENDIF
	ENDIF
;状態回復
;ELSEIF RESULT == 5
ELSE
	IF RAND:5 == 0
		BTL_KOJO_RESULTS:0 = 해치워버릴 거야!
	ELSEIF RAND:4 == 0
		BTL_KOJO_RESULTS:0 = 이걸로옷!
	ELSEIF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 간다아-!
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 페르소나-!
	ELSE
		;ペルソナがイシュキックになると違和感があったので修正
		;BTL_KOJO_RESULTS:0 = 任せたよ！　%GET_PERSONA_NAME(ARG)%！
		BTL_KOJO_RESULTS:0 = 맡길게!
	ENDIF
ENDIF

