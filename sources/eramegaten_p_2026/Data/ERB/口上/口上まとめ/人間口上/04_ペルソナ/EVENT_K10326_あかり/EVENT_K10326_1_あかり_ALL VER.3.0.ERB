;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	;調教初回に二人称を「おまえ」、一人称を「我」に。
	CSTR:이인칭 = 네녀석
	CSTR:일인칭 = 나
	PRINTFORML 「%CSTR:이인칭%는-! 날 이런 곳에 가둬서 어쩔 셈이야!」
	PRINTFORMW 소녀는 %MASTER를% 보자、분노를 드러내고、고함을 내질렀다
	PRINTFORML 「에？　조교？　뭐야 그거？」
	PRINTFORMW 소녀의 얼굴에 의문이 떠오른다。
	PRINTFORMW 계속해서 변하는 소녀의 표정을 보고 있는 동안에 %MASTER는% 자연스럽게 미소를 띄우고 있었다
	PRINTFORML 「앗！　능글능글 웃고 있네。잘은 모르지만、이상한 일 하면 용서하지 않을테니깐！」
	PRINTFORMW 그렇게 말하고、몸을 지키듯이 뒤로 물러나지만、상관하지 않고 천천히 다가갔다。
	PRINTFORMW 「싫어……그만둬。나쁜 일은 하지 않는 편이 좋아」
	PRINTFORMW 「절대로、레오님이 도우러 와서、%CSTR:이인칭%같은 것 박살내 줄테니까！」
	PRINTFORMW 「그때를 생각하면 나에게 아무 짓 하지 않는 편이…꺄앗」
	PRINTFORMW 소녀의 말을 무시하고、소녀를 밀어 넘어뜨렸다。
	PRINTFORMW 소녀는 필사적으로 저항하지만、힘의 차이는 어쩔 수 없어、간단하게 쓰러졌다…
	CFLAG:201 = 1
	GOTO 表示
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	;一人称を「あかり」に(元口上であかりだったので)
	CSTR:일인칭 = 아카리
	PRINTFORMW 「호시 %CSTR:일인칭%…그게 %CSTR:일인칭%의 이름이야…」
	;名前を戻す
	NAME:TARGET = 호시 아카리
	CALLNAME:TARGET = 아카리
	;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
	;ランダムだと変な口上が出るのでランダムから条件指定に。
	;条件はリグル口上様から拝借しました(一部改変)。
	IF CFLAG:2 >= 0 && EXP:50 >= 1
	;淫乱傾向コース：依存度がプラス寄り＋異常経験1以上
		PRINTFORMW 「당장은 도움이 올 것 같지도 않고…별로 싸우기만 해도 어쩔 수 없고…」
		PRINTFORML 「그러니까 %CSTR:이인칭%를 인정한 것이 아니니까、그건 착각하지 말라고！」
		PRINTFORMW 그렇게 말하고、%TARGET은% %MASTER를% 노려보지만、그 시선에는 이전 정도의 힘은 없다
		PRINTFORMW 그 뿐만 아니라、약간이지만 뭔가를 기대하고 있는 것 같기도 하다
		PRINTFORMW 과연 %TARGET은% 자신이 무엇을 기대하고 있는지 눈치채고 있는 것일까？
	ELSEIF -CFLAG:2 >= 0 && EXP:50 >= 1
	;服従傾向コース：依存度がマイナス寄り＋異常経験1以上
		PRINTFORMW 그렇게 말하고 %TARGET은% 가만히 %MASTER를% 바라보았다…
		PRINTFORMW 그리고、만족한듯한 모습을 간파하고 말을 계속한다。
		PRINTFORMW 「%CSTR:이인칭%도 %CSTR:이인칭% 나름대로 노력하고 있는 것 같고、이름 정도는 가르쳐 줄게」
		PRINTFORML 「약간은 감사하는게 어때？」
		PRINTFORMW 그렇게 말하고 다시、%TARGET은% 가만히 %MASTER를% 바라보았다…
		PRINTFORMW 아직 반항을 단념할 정도는 아니지만、%MASTER를% 화나게 하는 것은 무섭겠지…
	ELSE
	;恋慕傾向コース：それ以外…もとい、異常経験0
		PRINTFORMW 「%CSTR:일인칭%의 이름도 모르는 녀석이 이-런- 짓을 하는 게 기분 나쁠 뿐이니까」
		PRINTFORMW 「그러니까、이름을 가르쳐 줬지만、%CSTR:일인칭%가 %CSTR:이인칭%를 따를 마음이 생겼다든가 하는 이상한 착각은 하지 말 것！」
		PRINTFORMW 「전생전사 이슈킥은 악에게 패배하거나 하지 않으니까！」
		PRINTFORMW 정말로 굴복할 생각이 없다면、조교를 그만두도록 계속 항의해야 할 것이다
		PRINTFORMW 이미 조교를 그만두게 할 수 없다는 전제로 이야기를 하고 있는 시점에서、자신이 벌써 지기 시작했다는 것은 눈치채지 못한 것 같다
	ENDIF
	CFLAG:201 = 2
	GOTO 表示
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
	;ランダムだと変な口上が出るのでランダムから条件指定に。
	;条件はリグル口上様から拝借しました。
	IF CFLAG:2 >= 0 && EXP:50 >= 2
	;淫乱傾向コース：依存度がプラス寄り＋異常経験2以上
		PRINTFORML 「아…왔다…오지 않으면 좋은데…」
		PRINTFORMW %TARGET은% 그런 식으로 말하지만、기쁜듯한 표정을 숨기지 못하는 것 같다
		PRINTFORMW 「왜그래？　어차피、또 야한 일 하는거지？」
		PRINTFORML 「하는 거라면 할테니까 빨리 끝내 버려」
		PRINTFORMW %TARGET은% 침대의 위에서 비난하듯이 그렇게 말했다
		PRINTFORMW 기다렸다고 말하지 않을 뿐…이대로라면 곧 넘어올 것이다…
	ELSEIF -CFLAG:2 >= 0 && EXP:50 >= 2
	;服従傾向コース：依存度がマイナス寄り＋異常経験2以上
		PRINTFORML 「아…잠깐만…」
		PRINTFORML %TARGET은% %MASTER가% 들어오자 작게 소리를 지르고는、당황하며 조교를 받을 준비를 시작했다
		PRINTFORMW 그리고、깜빡거리며 무서워하는 눈으로、%CALLNAME:MASTER%의 모습을 바라본다…
		PRINTFORMW 조금 눈썹을 찡그리는 것만으로도、무서워하며 비명을 지른다
		PRINTFORMW %MASTER는% 그 모습에 가학심을 부추겨져、이번 조교 내용을 생각하기 시작했다…
	ELSE
	;恋慕傾向コース：それ以外…もとい、異常経験2未満
		PRINTFORMW 「저기, 이-런 일은 서로 사랑하는 사람끼리 하는 거지?」
		PRINTFORMW 「학교에서 배웠어」
		PRINTFORMW 「좋아하는 사람이 생기면、모두 그 사람과 이런저런 일을 하고 싶어진다고」
		PRINTFORML 「그럼、%CSTR:일인칭%와 이런 일을 하는 건…혹시…」
		PRINTFORMW %TARGET은% 거기까지 말하고는、입을 다물고、뺨을 붉혀、%MASTER를% 가만히 응시하기 시작했다
		PRINTFORMW %MASTER는% 쓴웃음을 지으며、%TARGET을% 넘어뜨렸다…거기에는 더이상 저항은 없다…
	ENDIF
	CFLAG:201 = 3
	GOTO 表示
;屈服刻印Lv3
;ランダムだと変な口上が出るのでランダムから条件指定に。
;条件はリグル口上様から拝借しました。
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	;屈服刻印1と2は飛ばされる可能性が割とあるので一応ここでも名前と一人称修正を仕込む。
	;一人称を「あかり」に(元口上であかりだったので)
	CSTR:일인칭 = 아카리
	NAME:TARGET = 호시 아카리
	CALLNAME:TARGET = 아카리
	;二人称をご主人様に
	CSTR:이인칭 = 주인님
	PRINTFORML 「저기… %CSTR:이인칭%…」
	IF CFLAG:2 >= 0 && EXP:50 >= 2
	;淫乱傾向コース：依存度がプラス寄り＋異常経験2以上
		PRINTFORMW 방에 들어가자 %TARGET이% 달콤한 소리로 마중나왔다
		PRINTFORMW 「이제、%CSTR:일인칭%는 %CSTR:이인칭%이 기분좋게 해주지 않으면 안되는 아이가 되어 버린 것 같아…」
		PRINTFORMW 「제대로 %CSTR:이인칭%이 말하는대로 하는 노예가 될테니까…」
		PRINTFORM 「그러니까、앞으로도 %CSTR:일인칭%에게 잔뜩 기분 좋은 일 알려줘……%UNICODE(0x2661)%」
		PRINTFORMW %CALLNAME:TARGET%은(는) 그렇게 말하며, %CALLNAME:MASTER%에게 달라붙어 몸을 비벼왔다…
	ELSEIF -CFLAG:2 >= 0 && EXP:50 >= 2
	;服従傾向コース：依存度がマイナス寄り＋異常経験2以上
		PRINTFORMW 방에 들어가자 %TARGET이% 어딘가 공허한 소리로 마중나왔다
		PRINTFORMW 「%CSTR:일인칭%는 %CSTR:이인칭%의 노예입니다…」
		PRINTFORMW 「이제 두 번 다시 거역하거나 하지 않아요…」
		PRINTFORMW 「그러니까…소중히 해 주세요…부탁합니다…」
	ELSE
	;恋慕傾向コース：それ以外…もとい、異常経験2未満
		PRINTFORMW 방에 들어가자 %TARGET이% 쑥스러운 듯한 소리로 마중나왔다
		PRINTFORMW 「이런 식으로 불리면 남자는 기뻐？」
		PRINTFORMW 「실제로、노예와 %CSTR:이인칭% 같은 것이지만」
		PRINTFORML 「뭐 어쨌든、지금부터 %CSTR:일인칭%가 노예가 되어 줄테니까、잘 부탁해、%CSTR:이인칭%！」
		PRINTFORMW 어쩐지、이상한 착각을 하고 있는 것 같기도 하지만…
		PRINTFORMW 어쨌든、조교가 진행되고 있는 것은 확실하니 별로 신경쓰지 말자…
	ENDIF
	CFLAG:201 = 4
	GOTO 表示
;매각가능
;ランダムだと変な口上が出るのでランダムから条件指定に。
;条件はリグル口上様から拝借しました。
ELSEIF CFLAG:201 < 5 && CFLAG:매각가능 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW 「저기…%CSTR:일인칭%를 어떻게 할 생각이야…？」
	PRINTFORMW 「노예상인이라고 말했지만…역시 %CSTR:일인칭%도 팔아넘길 생각이야…？」
	IF CFLAG:2 >= 0 && EXP:50 >= 2
	;淫乱傾向コース：依存度がプラス寄り＋異常経験2以上
		PRINTFORMW 「팔린 후에도、이런 거 하는 걸까나…」
		PRINTFORMW 「아니면…더 심한 일 당하는걸까…」
	ELSEIF -CFLAG:2 >= 0 && EXP:50 >= 2
	;服従傾向コース：依存度がマイナス寄り＋異常経験2以上
		PRINTFORMW 「혹시라도…팔린 후가 여기보다 좋다거나…」
		PRINTFORMW 「그런 일이 있지는 않을까…」
	ELSE
	;恋慕傾向コース：それ以外…もとい、異常経験2未満
		PRINTFORMW 「……마음에 드는 노예는、파는것이 아까워진다던가」
		PRINTFORMW 「그런 적 혹시 있어？」
		PRINTFORMW 「아니、아무것도 아니야…」
	ENDIF
	CFLAG:201 = 5
;陥落
ELSEIF CFLAG:201 < 6 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		IF CFLAG:미조교함락 == 1
			;調教せずに恋慕をつけた場合
			PRINTFORMW 방에 들어가자、%CALLNAME:TARGET%의 모습이 어쩐지 이상했다
			PRINTFORML 「아、그…저기…어…그…」
			PRINTFORMW 얼굴을 새빨갛게 하고、무엇인가 말하고 싶은 것 같지만、아무래도 잘 말할 수 없는 것 같다
			PRINTFORMW 「저、저기、%CSTR:이인칭%、%CSTR:이인칭%무 좋아해요。%CSTR:이인칭%」
