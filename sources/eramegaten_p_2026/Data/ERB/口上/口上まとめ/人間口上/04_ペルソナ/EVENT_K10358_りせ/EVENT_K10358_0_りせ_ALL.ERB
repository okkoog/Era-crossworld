;=========================================
;以下ナビ口上
;
;TSTR:네비_시추에이션_메인		主に呼び出しタイミングを定義(戦闘開始/メイン画面/戦闘終了)
;TSTR:네비_시추에이션_서버1		状況を定義
;TSTR:네비_시추에이션_서버2		状況の補足オプション
;=========================================
@KOJO_BATTLE_NAVI_K[[キャラ:리세]], ARG
SELECTCASE TSTR:네비_시추에이션_메인
	CASE "戦闘開始"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "통상"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "格下"
						IF TFLAG:적초기배치수 >= TFLAG:아군초기배치수
							SELECTCASE RAND:2
							CASE 0
								BTL_KOJO_RESULTS:0 = 적은 {TFLAG:적초기배치수}마리! 수는 많아, 조심해!
							CASE 1
								BTL_KOJO_RESULTS:0 = 적, {TFLAG:적초기배치수}마리! 낙승이겠지만 방심하면 안 돼
							ENDSELECT
						ELSE
							SELECTCASE RAND:2
							CASE 0
								BTL_KOJO_RESULTS:0 = 적은 {TFLAG:적초기배치수}마리! 이 정도면 여유네
							CASE 1
								BTL_KOJO_RESULTS:0 = 적, {TFLAG:적초기배치수}마리! 후딱 해치워버리자!
							ENDSELECT
						ENDIF
					CASE "同格"
						IF TFLAG:적초기배치수 >= TFLAG:아군초기배치수
							SELECTCASE RAND:2
							CASE 0
								BTL_KOJO_RESULTS:0 = 적은 {TFLAG:적초기배치수}마리야! 지지 마라-!
							CASE 1
								BTL_KOJO_RESULTS:0 = 적, {TFLAG:적초기배치수}마리! 기합 넣고 힘내자
							ENDSELECT
						ELSE
							SELECTCASE RAND:2
							CASE 0
								BTL_KOJO_RESULTS:0 = 적, {TFLAG:적초기배치수}마리! 방심하지 마!
							CASE 1
								BTL_KOJO_RESULTS:0 = 적, {TFLAG:적초기배치수}마리! 방심하면 안 돼
							ENDSELECT
						ENDIF
					CASE "格上"
						IF TFLAG:적초기배치수 == 1
							SELECTCASE RAND:2
								CASE 0
									BTL_KOJO_RESULTS:0 = 엄청난 위압감! 조심해!
								CASE 1
									BTL_KOJO_RESULTS:0 = 앗, 이 녀석 강해! 조심해!
							ENDSELECT
						ELSE
							SELECTCASE RAND:2
								CASE 0
									BTL_KOJO_RESULTS:0 = 적은 {TFLAG:적초기배치수}마리! 이 녀석들 강해! 지지 마!
								CASE 1
									BTL_KOJO_RESULTS:0 = 적, {TFLAG:적초기배치수}마리! 뭔가 만만치 않은 느낌이야!
							ENDSELECT
						ENDIF
				ENDSELECT
			CASE "先制攻撃"
				IF TSTR:네비_시추에이션_서버2 == "格上"
					SELECTCASE RAND:3
						CASE 0
							BTL_KOJO_RESULTS:0 = 적, {TFLAG:적초기배치수}마리! 지금 틈에 태세를 정비하자
						CASE 1
							BTL_KOJO_RESULTS:0 = 적은 {TFLAG:적초기배치수}마리! 상대가 강해도 선제라면
						CASE 1
							BTL_KOJO_RESULTS:0 = 적, {TFLAG:적초기배치수}마리! 지금 틈에 도망칠까?
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 0
							BTL_KOJO_RESULTS:0 = 적, {TFLAG:적초기배치수}마리! 선수는 이쪽이야!
						CASE 1
							BTL_KOJO_RESULTS:0 = 적, {TFLAG:적초기배치수}마리! 선제공격 차안스!
						CASE 1
							BTL_KOJO_RESULTS:0 = 적, {TFLAG:적초기배치수}마리! 선제필승이야!
					ENDSELECT
				ENDIF
			CASE "バックアタック"
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = 뒤에서 왔어! 수는 {TFLAG:적초기배치수}마리!
					CASE 1
						BTL_KOJO_RESULTS:0 = 어디서 온 거야!? 적은 {TFLAG:적초기배치수}마리!
					CASE 1
						BTL_KOJO_RESULTS:0 = 꺄앗, 적의 기습! 수, {TFLAG:적초기배치수}마리!
				ENDSELECT
			CASE "バックアタック阻止"
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = 햐쿠타로, 제법인데!
					CASE 1
						BTL_KOJO_RESULTS:0 = 역시 햐쿠타로!
					CASE 1
						BTL_KOJO_RESULTS:0 = 햐쿠타로 믿음직해라!
				ENDSELECT
			CASE "不意打ち"
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = 선수를 빼앗겼어! 적은 {TFLAG:적초기배치수}마리야!
					CASE 1
						BTL_KOJO_RESULTS:0 = 싫어, 기습당했어!? 적은 {TFLAG:적초기배치수}마리야!
					CASE 1
						BTL_KOJO_RESULTS:0 = 거짓말, 기습!? 저, 적은 {TFLAG:적초기배치수}마리!
				ENDSELECT
			CASE "不意打ち阻止"
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = 햐쿠타로, 제법인데!
					CASE 1
						BTL_KOJO_RESULTS:0 = 역시 햐쿠타로!
					CASE 1
						BTL_KOJO_RESULTS:0 = 햐쿠타로 믿음직해라!
				ENDSELECT
		ENDSELECT
	CASE "メイン画面"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "重度の危機"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "PTHP危機"
						IF FLAG:도주불가플래그
							IF RAND:2 == 0
								BTL_KOJO_RESULTS:0 = 이 녀석한테선 못 도망쳐! 지지 마!
							ELSE
								BTL_KOJO_RESULTS:0 = 부탁이야, 전열을 가다듬어줘!
							ENDIF
						ELSE
							IF RAND:2 == 0
								BTL_KOJO_RESULTS:0 = 도망치는 편이 나을지도……
							ELSE
								BTL_KOJO_RESULTS:0 = 부탁이야, 무리하지 마!
							ENDIF
						ENDIF
					CASE "マスター瀕死"
						IF RAND:2 == 0
							BTL_KOJO_RESULTS:0 = 체력이 얼마 없어! 조심해!!
						ELSE
							BTL_KOJO_RESULTS:0 = 위기야! 누구 회복 좀 부탁해!
						ENDIF
					CASE "マスター死亡"
						IF RAND:2 == 0
							BTL_KOJO_RESULTS:0 = 싫어, 싫어, 거짓말……
						ELSE
							BTL_KOJO_RESULTS:0 = 일어나! 부탁이야, 누구 회복해 줘!
						ENDIF
					CASE "그외"
						IF FLAG:도주불가플래그
							IF RAND:2 == 0
								BTL_KOJO_RESULTS:0 = 이 녀석한테선 못 도망쳐! 힘내!
							ELSE
								BTL_KOJO_RESULTS:0 = 어떻게든 전열을 가다듬어줘
							ENDIF
						ELSE
							IF RAND:2 == 0
								BTL_KOJO_RESULTS:0 = 이제 도망쳐버릴까……?
							ELSE
								BTL_KOJO_RESULTS:0 = 무리는 하지 마!
							ENDIF
						ENDIF
				ENDSELECT
			CASE "中度の危機"
				SELECTCASE TSTR:네비_시추에이션_서버2
;					CASE "戦力低下"
					CASE "異常者複数"
						IF RAND:2 == 0
							BTL_KOJO_RESULTS:0 = 상태 이상 회복, 가진 사람 있어?
						ELSE
							BTL_KOJO_RESULTS:0 = 상태 이상, 위험해! 전열 가다듬을 수 있어?
						ENDIF
					CASE "핀치캐릭터"
						SELECTCASE TSTR:핀치캐릭터위기내용
							CASE "DYING"
								IF TFLAG:핀치캐릭터 == MASTER
									IF RAND:2 == 0
										BTL_KOJO_RESULTS:0 = 싫어, 일어나!
									ELSE
