				RESULTS = 하루나 씨
			CASEELSE
				IF TALENT:ARG:아이 == 1
					IF TALENT:ARG:남자 == 1 || TALENT:ARG:오토코노코 == 1
						RESULTS = %CALLNAME:(ARG)% 군
					ELSE
						RESULTS = %CALLNAME:(ARG)% 쨩
					ENDIF
				ELSE
					RESULTS = %CALLNAME:(ARG)% 씨
				ENDIF
		ENDSELECT
	ELSE
		RESULTS = %CALLNAME:(ARG)%
	ENDIF
RETURN 


