									BTL_KOJO_RESULTS:0 = 상태 이상에 걸렸어! 제대로 계산에 넣어줘
								ENDIF
						ENDSELECT
					CASE "그외"
						IF RAND:2 == 0
							BTL_KOJO_RESULTS:0 = 위기에 빠지지 않도록 조심해!
						ELSE
							BTL_KOJO_RESULTS:0 = 그다지 여유 없어! 조심해!
						ENDIF
				ENDSELECT
			CASE "平常"
				;戦闘中・危険な状態の味方はいない・戦闘開始時よりも敵の数が少ない
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "一部撃破済み"
						IF RAND:2 == 0
							BTL_KOJO_RESULTS:0 = 적의 수가 줄었어! 단숨에 끝내버리자!
						ELSE
