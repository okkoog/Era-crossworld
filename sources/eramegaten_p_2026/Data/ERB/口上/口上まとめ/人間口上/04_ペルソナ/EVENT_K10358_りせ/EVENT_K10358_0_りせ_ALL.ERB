	CASE "戦闘終了"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "勝利"
				IF ナビ_シチュエーション存在取得("格下")
					IF RAND:2 == 0
						BTL_KOJO_RESULTS:0 = 화려하게 결정지었네! 다들, 역시 대단해
					ELSE
