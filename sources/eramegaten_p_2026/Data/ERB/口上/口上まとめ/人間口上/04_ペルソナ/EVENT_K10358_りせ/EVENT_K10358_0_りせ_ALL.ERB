											BTL_KOJO_RESULTS:0 = %RESULTS%이(가) 매료당했어! 누구 치료 못 해?
										ELSE
											BTL_KOJO_RESULTS:0 = %RESULTS%이(가) 매료당했어! 주의해!
										ENDIF
