					ENDIF
				ELSEIF ナビ_シチュエーション存在取得("格上")
					IF RAND:2 == 0
						BTL_KOJO_RESULTS:0 = 대단해 대단해-! 다들, 멋져-!
					ELSE
						BTL_KOJO_RESULTS:0 = 만세-, 이겼네! 축하해-!
					ENDIF
				ELSE
					IF RAND:2 == 0
						BTL_KOJO_RESULTS:0 = 깔끔하게 이겼네! 다들, 역시
					ELSE
						BTL_KOJO_RESULTS:0 = 좋았어, 이겼네! 다들, 수고했어
					ENDIF
				ENDIF
			CASE "도주"
				BTL_KOJO_RESULTS:0 = 도망치는 게 이기는 거란 말도 있잖아!
			CASE "敗北"
				BTL_KOJO_RESULTS:0 = 싫어, 싫어, 이런 거 싫단 말야……
	ENDSELECT
ENDSELECT

;=========================================
;呼び名の取得
;ARG キャラ番号
;ARG:1 コードネームか（0=通常、1=コードネーム）
;RESULTS 呼び方
;RESULTS:1 態度
;=========================================
@KOJO_GET_CALLNAME_K[[キャラ:리세]], ARG, ARG:1
	RESULTS:1 = 普通
	IF ABL:ARG:종족 == 0
		SELECTCASE NO:ARG
			CASE [[キャラ:베스]];ベス
				RESULTS = 베스 씨
			CASE [[キャラ:유미]];ユミ
				RESULTS = 유미 선배
			CASE [[キャラ:타마키]];たまき
				RESULTS = 타마키 쨩
			CASE [[キャラ:미라이]];未来
				RESULTS = 미라이 쨩
				RESULTS:1 = "保護"
			CASE [[キャラ:도리]];ドリー
				RESULTS = 도리
RESULTS:1 = 저렴
			CASE [[キャラ:마리]];マリ
				RESULTS = 마리 씨
			CASE [[キャラ:유즈]];ユズ
				RESULTS = 유즈 쨩
			CASE [[キャラ:레이코]];レイコ
				RESULTS = 레이코 쨩
			CASE [[キャラ:메어리]];メアリ
				RESULTS = 메어리 씨
			CASE [[キャラ:네밋사_밝음]];ネミッサ(明るい)
				RESULTS = 네밋사
			CASE [[キャラ:네밋사_쿨]];ネミッサ(クール)
				RESULTS = 네밋사
			CASE [[キャラ:네밋사_섹시]];ネミッサ(セクシー)
				RESULTS = 네밋사
			CASE [[キャラ:아마네]];アマネ
				RESULTS = 아마네 씨
			CASE [[キャラ:에리]];エリー
				RESULTS = 에리 씨
			CASE [[キャラ:아야세]];アヤセ
				RESULTS = 아야세 쨩
			CASE [[キャラ:마요네]];マヨーネ
				RESULTS = 마요네 씨
			CASE [[キャラ:안나]];杏奈
				RESULTS = 杏奈先輩
			CASE [[キャラ:아카리]];あかり
				RESULTS = 아카리 쨩
				RESULTS:1 = "保護"
			CASE [[キャラ:마키]];麻希
				RESULTS = 마키 쨩
			CASE [[キャラ:이즈나]];イヅナ
				RESULTS = 이즈나 씨
