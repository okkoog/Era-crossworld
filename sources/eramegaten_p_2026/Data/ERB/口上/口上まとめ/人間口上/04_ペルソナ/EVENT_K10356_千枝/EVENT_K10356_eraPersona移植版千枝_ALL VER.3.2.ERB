;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	KSTR:(K++) = 보이시한 소녀는 %MASTER는% 보자 달려들듯이 따지고 들었다
	KSTR:(K++) = 「당신이、%일인칭을% 여기에 가둔거야？　무슨 속셈이야！？　내보내줘！」	
	KSTR:(K++) = 거기까지 단숨에 재잘거리던 와중에 처음으로 %CALLNAME:MASTER%의 이상한 분위기를 깨달은 것 같다。
	KSTR:(K++) = 「…당신、대체…다가오지마！」
	KSTR:(K++) = 반사적으로 발차기를 넣어 오는 그녀의 다리를 잡아당기자…
	WSTR:(K++) = 「잠깐！　무、무슨…」
	CFLAG:201 = 1
	GOTO 表示
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	KSTR:(K++) = 「뭐、뭐야…%일인칭을%、징그러운 눈으로 보지마！ 」
	KSTR:(K++) = 「저리 가！」
	KSTR:(K++) = 치에는 꿋꿋하게 이쪽을 노려보고있다。
	WSTR:(K++) = …아직 입장을 이해하지 못한 것 같다…
	CFLAG:201 = 2
	GOTO 表示
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	KSTR:(K++) = 치에는 %마스터가% 감옥을 방문해도 날뛰거나 하지 않았다
	KSTR:(K++) = %마스터를% 노려보면서도 옷이 벗겨지는대로 내버려두고 있다
	KSTR:(K++) = 「어차피 저항해도 소용없잖아？　그렇다면、적어도 빨리 끝내게 해야지…」
	WSTR:(K++) = 스스로에게 변명을 하듯이 치에는 중얼거렸다
	CFLAG:201 = 3
	GOTO 表示
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	KSTR:(K++) = %마스터가% 지하실에 들어가자 치에는 한숨을 쉬며 옷에 손을 걸치고 있던 자신을 깨달았다
	KSTR:(K++) = 「이건、그게！　…하는거지…」
	WSTR:(K++) = 치에는 얼굴을 붉히며 얼버무리듯이 중얼거렸다
	CFLAG:201 = 4
	GOTO 表示
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		IF CFLAG:미조교함락 == 1
			;調教せずに恋慕をつけた場合
			KSTR:(K++) = %마스터가% 방에 들어가자 치에는 얼굴을 붉히며 이쪽을 보았다。
			KSTR:(K++) = 「저、저기말야。%CSTR:일인칭%말야……」
			KSTR:(K++) = 「처음엔、그냥、자기 주변의 모두를、유키코를、지키고 싶었어。그게、처음이었지만」
			WSTR:(K++) = 「그、주변의 모두에、너도、포함되게 되버렸어」
			KSTR:(K++) = 「너는 굉장히 강하고 %CSTR:일인칭%같은 거한테 의지하지 않고 지킬 필요도 없을지도 모르지만」
			KSTR:(K++) = 「계속、옆에 있어서、지켜주고싶어……」
			KSTR:(K++) = 「아아、창피하네에 정말！」
			WSTR:(K++) = 귀까지 새빨개져 부끄러운듯이 아래로 향한 머리를 흔드는 치에를 %MASTER는% 살짝 끌어안았다……
		ELSE
			KSTR:(K++) = %마스터가% 지하실에 들어가도、치에는 멍하니 있다。
			KSTR:(K++) = 말을 걸어주자 헉하며 얼굴을 붉히며 이쪽을 돌아본다。
			KSTR:(K++) = 「…너는 지독한 인간이네。　계속 %일인칭을% 이런 곳에 가두고서…」
			KSTR:(K++) = 「심한 일을 반복하고！　…그런데、어째서 %CSTR:일인칭%…」
			WSTR:(K++) = （…너를 미워할 수 없는걸까…？）
		ENDIF
	;음란
	ELSEIF TALENT:4
		KSTR:(K++) = %마스터가% 지하실에 들어오자 치에는 기뻐하는 얼굴로 맞이했다
		KSTR:(K++) = 「에헤헤…기다리고 있었다고？　그래서、오늘은 어떤 일 할거야？」
		WSTR:(K++) = 마음 속 깊이 즐거운듯이 웃는 치에의 얼굴은 이미 정욕에 달아올라있었다。
	;복종
	ELSEIF TALENT:5
		KSTR:(K++) = %마스터가% 지하실에 들어오자 치에는 움찔하고 몸을 경직시켰다。
		KSTR:(K++) = 「에、기…기다리고 있었습니다、그게…%CSTR:이인칭%…」
		KSTR:(K++) = 입을 머뭇머뭇거리는 치에의 표정을 보고 %MASTER는% 확신한다。
		WSTR:(K++) = 그렇다、치에는 함락된 것이라고…
	ENDIF
	;共通
	IF !口上有無確認(0)
		KSTR:(K++) = 
	ENDIF
	CFLAG:201 = 5
	GOTO 表示
ENDIF

;-------------------------------------------------
;簡易助手口上（Y1を助手のキャラ番号に置換、X1をキャラ番号に変更する) CFLAG203
;掛け合いをするキャラを増やす場合は、構文をコピー＆ペーストをして、CFLAGの数を204、205と増やす
;-------------------------------------------------
;助手の有無をチェック（いない場合は二回目以降へ飛ぶ）
