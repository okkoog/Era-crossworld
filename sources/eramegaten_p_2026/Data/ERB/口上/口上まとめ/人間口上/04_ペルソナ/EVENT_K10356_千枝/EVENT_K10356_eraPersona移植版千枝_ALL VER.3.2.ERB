	CALL EVENTTRAIN_SECOND_K[[キャラ:치에]]
;助手:：雪子
ELSEIF 助手確認([[キャラ:유키코]])
	;初めて
	IF CFLAG:203 == 0
		;陥落済み＋陥落時初口上が発生済み
		IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && CFLAG:201 >= 5
			KSTR:(K++) = 「%CALLNAME:ASSI%도…있었구나」
			KSTR:(K++) = 친한 친구가 %CALLNAME:MASTER%의 조수로 모습을 보여도 %CALLNAME은% 놀라지 않았다。
			KSTR:(K++) = 「어째설까？　%CSTR:일인칭%、유키코가 여기에 있어줘서 기쁘다고 생각하고있어…」
			KSTR:(K++) = 『…괜찮아、%CALLNAME%。그야 기쁜 것은 나도 마찬가지니까』
			KSTR:(K++) = 「%CALLNAME:ASSI%…」
			WSTR:(K++) = 두 사람은 그대로 어느쪽이 먼저랄 것도 없이 서로 포옹했다。
		;それ以外
		ELSE
			KSTR:(K++) = 「%CALLNAME:ASSI%！　설마…%CALLNAME:ASSI%까지…！」
			KSTR:(K++) = 너무나 화가나 말을 잇지 못하는 것 같다。
			KSTR:(K++) = 격노하며 %마스터를% 다그치려는 %CALLNAME%를、%CALLNAME:ASSI%가 제지했다。
			KSTR:(K++) = 『기다려 %CALLNAME%、나…지금은 자신의 의지로 여기에 있으니까』
			KSTR:(K++) = 「그런…！　어째서、%CALLNAME:ASSI%！！」
			KSTR:(K++) = 『%CALLNAME%도 곧 알거야、…자…』
			WSTR:(K++) = 지나친 충격으로 눈물을 흘리며 망연자실해있는 %CALLNAME%에게、%CALLNAME:ASSI%는 유혹하듯이 손을 뻗었다…
		ENDIF
;		CFLAG:203 = 1
	;二回目以降
	ELSEIF CFLAG:203 < 2 || FLAG:7 ==2
		;陥落済み
		IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
			KSTR:(K++) = %CALLNAME과% %CALLNAME:ASSI%는 질투하고 싶을정도로、화기애애했다。
			KSTR:(K++) = 최근에는 명령하기 전부터 서로 애무를 하려고 할 정도다。
			KSTR:(K++) = 「…%CALLNAME:ASSI%…예뻐…」
			WSTR:(K++) = 『…아、%CALLNAME%…』
		;それ以外
		ELSE
			KSTR:(K++) = 「%CALLNAME:ASSI%…그런、거…」
			KSTR:(K++) = 친한 친구의 변모가 꽤 충격이었는지 %CALLNAME은% 대단히 얌전해져있었다。
			KSTR:(K++) = %CALLNAME:ASSI%는、그런 %CALLNAME%를 돌봐주는 것을 즐기고 있는 것 같다。
			WSTR:(K++) = …이건 이것대로 단란한 모습이라고 할 수 있지 않을까…
		ENDIF
		CFLAG:203 = 2
	ENDIF
;口上のある助手が居ない場合は、通常の二回目以降の口上へ飛ぶ
ELSE
	CALL EVENTTRAIN_SECOND_K[[キャラ:치에]]
ENDIF

