@KOJO_BATTLE_MESSAGE_K[[キャラ:마야_P2]], ARG,ARG:1 = 0
LOCAL:1 = 1
LOCAL = CFLAG:ARG:입력행동
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = EMPTY
;タイプ取得
CALL GET_SKILL_PROP, "SKILL_EFECT", LOCAL, ARG
IF LOCAL == 0
	IF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 거기
	ELSE
		BTL_KOJO_RESULTS:0 = 호랏
	ENDIF
ELSEIF LOCAL == [[스킬:ＧＵＮ]]
	BTL_KOJO_RESULTS:0 = 스냅 슛！
ELSEIF LOCAL == [[스킬:크레센트미러]]
	BTL_KOJO_RESULTS:0 = 크레센트미러！
;공격
ELSEIF RESULT == 1 && RAND:3 == 0
	;潜在反撃対策
	IF CFLAG:ARG:입력행동 == -1
		RETURN
	ENDIF
	IF RAND:2
		BTL_KOJO_RESULTS:0 = 춤추세요
	ELSE
		BTL_KOJO_RESULTS:0 = 프리즈！
	ENDIF
;회복
ELSEIF RESULT == 2 && RAND:3 == 0
	IF CFLAG:ARG:타겟 > 6
		BTL_KOJO_RESULTS:0 = 모두들！
	ELSE
		BTL_KOJO_RESULTS:0 = 괜찮아！？
	ENDIF
;状態変化
;ELSEIF RESULT == 3
;特殊
;ELSEIF RESULT == 4
;状態回復
;ELSEIF RESULT == 5
ELSE
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 자、가자！
	ELSEIF RAND:2
		BTL_KOJO_RESULTS:0 = 챠오
	ELSE
		BTL_KOJO_RESULTS:0 = 페르소나
	ENDIF
ENDIF
;SIF LOCALS != "EMPTY"
;	CALL MESSAGE_BL(LOCAL:1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)

@KOJO_BATTLE_EVENT_K[[キャラ:마야_P2]], ARG, ARG:1, ARG:2
SIF ARG < 0 && NO:ARG != 4528
	RETURN 0
LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = EMPTY
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:4 == 0
			BTL_KOJO_RESULTS:0 = 모두들！　와！
		ELSEIF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 좋아？　간닷！
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 쵸메쵸메 타임！
		ELSE
			BTL_KOJO_RESULTS:0 = 렛츠 고！！
		ENDIF
	CASE 2
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;潜在反撃対策
		IF CFLAG:ARG:입력행동 == -1
			RETURN
		ENDIF
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 쵸메쵸메 완료！！
				ELSE
					BTL_KOJO_RESULTS:0 = 죄송해요…
				ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 제법이네…
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 방해하지 마
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = 뭐、이런 걸까나？
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = 아챠…곤란하게 됐네…
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 아아…　달이…
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 안돼…이런 곳에서…
			ELSE
				BTL_KOJO_RESULTS:0 = 모두를 위해서라도 이런 곳에서…！
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 소용없어요
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = 흡수ー♪
		ENDIF
	CASE 15
		BTL_KOJO_RESULTS:0 = 어라、실패해버렸다
	CASE 16
		BTL_KOJO_RESULTS:0 = 언니한테 심한 짓을 하려니까
	CASE 17
		BTL_KOJO_RESULTS:0 = 아아앗！
	CASE 18
		BTL_KOJO_RESULTS:0 = 소・용・없・어
ENDSELECT
;231227:EMPTYと喋っていたケースの対処
;SIF LOCALS != "EMPTY"
;	CALL MESSAGE_BL(LOCAL:1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)
	
@EVOLUTE_PERSONA_K[[キャラ:마야_P2]],ARG
IF CFLAG:ARG:페르소나강화플래그 == 1
	PRINTFORMW 「아마노 마야、그녀가 당신에게 힘이 되고 싶다는 생각에」
	PRINTFORMW 「항상 그녀 곁에 있었던 페르소나가 이에 응하려는 것 같군요」
	PRINTFORMW 「제 힘을 이용해、페르소나의 새로운 힘을 끌어냅시다」
	PRINTL
	PRINTW
	PRINTW 페르소나「마이아」가 페르소나「마이아・改」로 다시 태어났다
ELSE
	PRINTFORMW 「아마노 마야、이전에 그녀의 생각에 응한 페르소나입니다만」
	PRINTFORMW 「그녀의 더 큰 성장과 추억에、아직 페르소나도 새로운 힘을 얻고자 하는 것 같습니다」
	PRINTFORMW 「지금 다시 제 힘을 이용해、페르소나의 더 큰 힘을 끌어내 보입시다」
	PRINTL
	PRINTW
	PRINTW 페르소나「마이아・改」가 페르소나「아르테미스」로 다시 태어났다
ENDIF