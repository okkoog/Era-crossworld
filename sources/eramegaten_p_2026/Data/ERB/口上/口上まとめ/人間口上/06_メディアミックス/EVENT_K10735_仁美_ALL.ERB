;-------------------------------------------------
;調教開始時（2回目以降、X1をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_K[[キャラ:히토미]]
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORML 「죽여 주마、반드시……！」
	PRINTFORMW %CALLNAME은% 눈살을 날카롭게 찌푸리며 살의를 넘치게 담아 노려본다
	CFLAG:202 = 4
;屈服刻印Lv0
ELSEIF MARK:2 == 0 && (CFLAG:202 < 1 || FLAG:7 == 2)
	PRINTFORMW 「그만둬、이런 짓！」
	CFLAG:202 = 1
;屈服刻印Lv1
ELSEIF MARK:2 == 1 && (CFLAG:202 < 2 || FLAG:7 == 2)
	PRINTFORMW 「큭、싫다고 말했었지！」
	CFLAG:202 = 2
;屈服刻印Lv2
ELSEIF MARK:2 == 2 && (CFLAG:202 < 3 || FLAG:7 == 2)
	PRINTFORMW 「또、또 하는 거야……？」
	CFLAG:202 = 3
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0) && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORMW 「……할 거라면 빨리 끝내고、당장 꺼져」
	CFLAG:202 = 4
;陥落済み
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORML 「오늘의 트레이닝 메뉴는 무얼까나？」
			PRINTFORMW 「%조사처리(CSTR:12,"가")% 해주는 거라면、뭐든 대환영이지만 말야%UNICODE(0x2661)%」
		ELSEIF K:1 == 1
			PRINTFORML 「늦었어요、몸이 식어 버렸잖아요」
			PRINTFORMW 「자、덥혀 줘요%UNICODE(0x2661)%」
		ELSE
			PRINTFORML 「%CSTR:12%의 일의 성격 상、다른 아이가 있는 곳에 가는 것은 어쩔 수 없지만……」
			PRINTFORMW 「%조사처리(CSTR:11,"를")% 내팽겨쳐 두면 안 돼요？」
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORML 「오늘의 트레이닝 메뉴는 무얼까？」
			PRINTFORMW 「어떤 짓 당해버릴까、상상만으로 뜨거워져요%UNICODE(0x2661)%」
		ELSEIF K:1 == 1
			PRINTFORML 「늦어요、몸이 차가워져 버렸잖아」
			PRINTFORMW 「자、흐물흐물해질 때까지 덥혀 줘%UNICODE(0x2661)%」
		ELSE
			PRINTFORML 「왔군요、즐겁게 해줄게요」
			PRINTFORMW 「텅 비게 될 정도로、쥐어짜 버릴 테니까%UNICODE(0x2661)%」
		ENDIF
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORMW 
		ELSEIF K:1 == 1
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
	CFLAG:202 = 5
ENDIF
RETURN 0

