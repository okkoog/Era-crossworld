;ENDIF
;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	;デフォ一人称を私、二人称をあなたに変更
	CSTR:일인칭 = 나
	CSTR:이인칭 = 당신
	PRINTFORMW 세이조 고교에서 회수해 온 소녀에 관한 조사 결과가 넘어왔다
	PRINTFORML 이름은 야마세 히토미、육상부의 에이스였던 것 같다
	PRINTFORML 경력상 오컬트와의 연관은 딱히 없고、사바트에 말려들었뿐인 불운한 일반인이라는 건가
	PRINTFORMW 강한 의지의 소유자로 악마의 빙의를 이겨내고 역으로 지배해 버린 것 같다。　일종의 이능자라고 할 수 있겠다
	PRINTFORML 능력자로서、부하로 만드는 것도 나쁘지 않다
	PRINTFORML 숏컷이 잘 어울리고 강해보이는 미모의 소유자이기도 해、상품으로서의 가치도 충분하다
	PRINTFORMW 상당히 좋은 물건을 주운 것 같다
	PRINTFORML ‥‥‥‥‥‥
	PRINTFORML ‥‥‥‥
	PRINTFORMW ‥‥
	PRINTFORMW 방에 들어가자、%CALLNAME은% 매서운 눈동자를 향해 왔다
	PRINTFORML 「뭐？　알고 있는 것은 벌써 전부 말했어요、그만하면 풀어주었으면 해요」
	PRINTFORMW 그럴 수는 없다
	PRINTFORML %MASTER는% 이제부터 조교를 하는 것을 %CALLNAME%에게 알렸다
	PRINTFORML 「잠깐 뭐、조교！？　뭐야 그거、웃기지 마！」
	PRINTFORMW 눈썹을 거꾸로 세우며 소리치는 %CALLNAME을% 무시하고、%MASTER는% 조교의 준비를 시작했다
	CFLAG:201 = 1
	RETURN 0
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	PRINTFORML 「어지간히 해、그렇지 않으면……」
	PRINTFORMW 몸에 간직한 악마의 힘을 쓰려고 하는 %CALLNAME%에게 ＣＯＭＰ를 내보인다
	PRINTFORML 악마가 씌인 한명과、진짜 악마를 여럿 다루는 소환사
	PRINTFORMW 어느 쪽이 승산이 있을까、%CALLNAME은% 즉각 이해한 것 같다
	PRINTFORMW 분하다는듯이 시선을 내리깔고、%CALLNAME:MASTER%의 손을 받아들였다
	CFLAG:201 = 2
	RETURN 0
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	PRINTFORMW 「또、또 하는 거야……？」
	CFLAG:201 = 3
	RETURN 0
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:연모 == 0 && TALENT:음란 == 0 && TALENT:복종 == 0 && TALENT:친애 == 0 && TALENT:창부 == 0 && TALENT:예속 == 0)
	PRINTFORML 「세상은 불합리할 뿐이구나。　악마가 있거나、닌자가 있거나、악마에 홀리거나……」
	PRINTFORML 「%CSTR:12%같은 엉망진창인 사람이 있기도 하고 말이야」
	PRINTFORMW %CALLNAME은% 자그맣게 탄식했다
	PRINTFORML 「불합리함투성이의 세상이지만、악마에게 잡아먹히지 않은 정도라면、그런대로 나을지도 모르겠구나……」
	PRINTFORML 단념한 듯이 중얼거리는 %CALLNAME%
	PRINTFORMW 불합리함에 한 손 거들고 있는 %CALLNAME:MASTER%로서는 위안해 줄 말도 없다。　평소처럼 조교를 개시한다
	CFLAG:201 = 4
	RETURN 0
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		IF CFLAG:미조교함락 == 1
			;調教せずに恋慕をつけた場合
			PRINTFORMW 
		ELSE
			PRINTFORML 심경의 변화가 있었는지、최근의 %CALLNAME은% 조교에 상당히 협력적이다
			PRINTFORML 「도구의 준비는 이것으로 됐고、로션의 재고는 있으려나……」
			PRINTFORMW 부지런하게 조교의 준비까지 하고 있다
			PRINTFORML 꼼꼼할 정도의 성실함에、농담삼아 나에게 반했나라고 묻자 %CALLNAME%의 갸름한 얼굴이 빨갛게 물들어갔다
			PRINTFORML 「그래……요。　그럴지도 모르겠네요」
			PRINTFORMW 고개를 숙인 채 계속
			PRINTFORML 「이런 세계에 관련되어 악마가 들러붙어버린 %조사처리(CSTR:11,"는")%、이미 일상 생활로 돌아갈 수  없어요……」
			PRINTFORML 「뒷세계에서 살아가지 않으면 안 된다면、아직 이야기가 통하는 %조사처리(CSTR:12,"와")% 함께 있는 것이 살아남을 수 있겠지요」
			PRINTFORML 「그렇다면、%CSTR:12%에게 아첨이라도 하고 기분을 좋게 해 주는 것도 하나의 방법이 아닐까요？」
			PRINTFORMW 그렇게 말하며 고개를 들어올린  %CALLNAME은% 똑바로 %CALLNAME:MASTER%의 눈동자를 바라보았다
			PRINTFORML 타산적인 언동과는 정반대로 그 눈동자는 불안하게 흔들리고 있다
			PRINTFORMW 기가 세고、프라이드 높은 %CALLNAME%로서는 우직하게 자신의 심정을 토로 할 수 없는 것일까
			PRINTFORML %MASTER는% 살짝 코를 누르며、그렇다면 힘껏 해보라고 속삭여줬다
			PRINTFORML 「아！　네、네에、%조사처리(CSTR:12,"가")% %조사처리(CSTR:11,"를")% 노골적으로 어쩌려는지、다 보인다고요」
			PRINTFORMW %CALLNAME은% 빨갛게 물든 얼굴로 고개를 끄덕이며、허겁지겁 조교의 준비를 재개한다
		ENDIF
	;음란
	ELSEIF TALENT:4
		PRINTFORML 「오늘은 어떤 식으로 %CSTR:11%의 몸을 농락할거야？　조교사씨？」
		PRINTFORML 방문한 %CALLNAME:MASTER%에 대해、%CALLNAME은% 도발적인 어조로 중얼거렸다
		PRINTFORMW 그 뺨은 붉게 물들어、눈동자는 욕정에 젖어있다。흥분하고 있는 것이 분명했다
		PRINTFORMW 그렇게나 조교가 재미있냐고 속삭이자、%CALLNAME은% 허를 찔린듯한 얼굴로
		PRINTFORML 「그래……요。　그럴지도 모르겠네요」
		PRINTFORMW 「%CSTR:12%의 탓에 야한 것 밖에、생각할 수 없는 몸이 되어 버린거야」
		PRINTFORML 「처음에는 원망하는 마음도 있었지만、이제 그런 것은 아무래도 좋아」
		PRINTFORMW 「%조사처리(CSTR:12,"가")% 이 몸의 설레임을 진정시켜 준다면、야%UNICODE(0x2661)%」
		PRINTFORMW %CALLNAME은% 생긋 웃으며、%CALLNAME:MASTER%에게 뜨거운 몸을 휘감아 왔다
	;복종
	ELSEIF TALENT:5
		PRINTFORMW 
	ENDIF
	CFLAG:201 = 5
	RETURN 0
ENDIF

