ENDIF

@KOJO_BATTLE_EVENT_K[[キャラ:키쿠에]]_1, ARG, ARG:1, ARG:2

;-------------------------------------------------
;○味方パーティでのデビルＣＯ－ＯＰ発動時の台詞
;-------------------------------------------------
IF TFLAG:전투이벤트 == 1
	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃%"히메미야 키쿠에！사양하지 말고 가겠습니다！",72,LEFT%┃
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○味方パーティでのデビルＣＯ－ＯＰ参加時の台詞
;通常攻撃も喋るようになっていなければ喋らない
;-------------------------------------------------
IF TFLAG:전투이벤트 == 2
	PRINTFORML ┏＠%NAME:ARG,10,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
	IF RAND:2 == 0
		PRINTFORML ┃%"갈게요！",72,LEFT%┃
	ELSE
		PRINTFORML ┃%"추격을 감행하겠습니다！",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF


;-------------------------------------------------
;○攻撃系イベント口上
;-------------------------------------------------
IF TFLAG:전투이벤트 == 11
	;攻撃して撃破
	IF BASE:(ARG:1):ＨＰ <= 0
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"다음에 오는 적도 맡겨 주세요。",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF
ENDIF

;-------------------------------------------------
;○被弾系口上
;-------------------------------------------------
IF TFLAG:전투이벤트 == 12
	;被弾（戦闘不能）
	IF BASE:ARG:ＨＰ <= 0
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"큿…이、이런 곳에서 저는…！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ELSEIF BASE:ARG:ＨＰ == 1
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"빠르게 회복하지 않으면…！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;残り50％未満
	ELSEIF 現HP割合(ARG) < 50
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"아파…이렇게까지 당해버리다니…",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;通常被弾（発生確率1/5)
	ELSEIF RAND:5 == 0
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		IF RAND:2 == 0
			PRINTFORML ┃%"그、그걸로 직격타를 때릴 생각이야！？",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"아직 멀었습니다！",72,LEFT%┃
		ENDIF
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF
ENDIF

