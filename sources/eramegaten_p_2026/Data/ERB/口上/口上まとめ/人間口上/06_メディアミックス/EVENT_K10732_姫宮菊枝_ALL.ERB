;-------------------------------------------------
;調教開始時（2回目以降、X1をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_K[[キャラ:키쿠에]]_1
SELECTCASE RAND:2
	CASE 0
		PRINTFORMW 「당신、어쩐 일이신가요？」
		CFLAG:202 = 5
		RETURN 0
	CASE 1
		PRINTFORMW 「당신、오늘은 어떻게 시간을 같이 보내시겠어요？」
		CFLAG:202 = 5
		RETURN 0
ENDSELECT

