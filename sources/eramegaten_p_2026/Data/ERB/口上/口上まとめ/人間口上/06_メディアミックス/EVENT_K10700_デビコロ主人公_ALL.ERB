;--------------------------------------------------
;EVENTTRAIN関係（X1をキャラ番号に置換）
;調教開始時のセリフ CFLAG 201～219を使用
;--------------------------------------------------
@EVENTTRAIN_K[[キャラ:데빌콜로주인공]]
;--------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;--------------------------------------------------
;デビコロちゃんにデフォルトネームがほしいという声を受けて適当に。
;あんまりこれで決定という感じにしたくなかったのでたくさん用意しました。
IF CFLAG:220 == 0
	PRINTL 데비콜로 양에게 적당한 이름과 애칭을 설정하겠습니까?
	PRINTL [0] 네
	PRINTL [1] 아니오
	CALL INPUTINT,0,1
	SELECTCASE RESULT
		CASE 0
			PRINTL 이름의 경향을 선택해 주세요
			PRINTL [0] 称号
			PRINTL [1] 평범한 이름
			PRINTL [2] 현대전기적인 이름
			PRINTL [3] 반짝반짝 (키라키라)
			PRINTL [4] 게레게레
			CALL INPUTINT,0,1,2,3,4
			SELECTCASE RESULT
				;そのまま。でも作中で「彼女」とか「あの子」とかでしか呼ばれないキャラ好き。
				CASE 0
					PRINTFORMW ―이름과 애칭을 변경합니다―
					NAME:TARGET = 흉터의 소녀
					CALLNAME:TARGET = 그녀
				;ありがちな名前と「仮名」から
				CASE 1
					PRINTFORMW ―이름과 애칭을 변경합니다―
					NAME:TARGET = 사토 카나
					CALLNAME:TARGET = 카나
				;名字は「かいたに」と読みます（こだわり）
				CASE 2
					PRINTFORMW ―이름과 애칭을 변경합니다―
					NAME:TARGET = 하이야 히이로
					CALLNAME:TARGET = 히이로
				;＜でいみ・こうろ＞ちゃん
				CASE 3
					PRINTFORMW ―이름과 애칭을 변경합니다―
					NAME:TARGET = 데이미 코로
					CALLNAME:TARGET = 코로
				;一つぐらい外国っぽい名前で。キラーパンサーの名前と教会を意味するらしい名字から。英語とスペイン語が混ざってるのは気にしないでください。
				CASE 4
					PRINTFORMW ―이름과 애칭을 변경합니다―
					NAME:TARGET = 링크스=이글레시아스
					CALLNAME:TARGET = 링크스
			ENDSELECT
		CASE 1
			PRINTFORMW 그럼, 그대로의 이름으로 조교를 시작합니다.
	ENDSELECT
	CFLAG:220 = 1
ENDIF
