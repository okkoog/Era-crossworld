		CALL EVENT_MESSAGE
		;陥落済み
		IF (CFLAG:290 < 1 || FLAG:7 == 2)
			IF CFLAG:함락캐릭터 == CFLAG:MASTER:캐릭터고유번호
				;主人に陥落しているor誰にも陥落してない状態でＮＴＲ
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORMW 
					;二回目（リーチ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORMW 
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						PRINTFORMW 
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORMW 
					;二回目（リーチ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORMW 
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						PRINTFORMW 
					ENDIF
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORMW 
					;二回目（リーチ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORMW 
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						PRINTFORMW 
					ENDIF
				;その他
				ELSE
					;進行度分岐
					;初回
					IF CFLAG:예ＮＴＲ진행도 == 0
						PRINTFORMW 
					;二回目（リーチ）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 1
						PRINTFORMW 
					;三回目（陥落）
					ELSEIF CFLAG:예ＮＴＲ진행도 == 2
						PRINTFORMW 
					ENDIF
				ENDIF
			ELSE
				;主人以外の誰かに陥落している状態で更に別のキャラにＮＴＲ
				;進行度分岐
				;初回
				IF CFLAG:예ＮＴＲ진행도 == 0
					PRINTFORMW 
				;二回目（リーチ）
				ELSEIF CFLAG:예ＮＴＲ진행도 == 1
					PRINTFORMW 
				;三回目（陥落）
				ELSEIF CFLAG:예ＮＴＲ진행도 == 2
					PRINTFORMW 
				ENDIF
			ENDIF
			CFLAG:290 = 1
		ENDIF
		;-------------------------------------------------
		;;愛系再陥落時
		;;主人に対して恋慕系陥落している、もしくは一度愛系ＮＴＲ状態にされたキャラに再び陥落させられる時
		;-------------------------------------------------
	CASE 48
		CALL EVENT_MESSAGE
		;再陥落前に陥落しているキャラ→CFLAG:함락캐릭터 で取得可能、名前は%NTRNAME(CFLAG:함락캐릭터)%
		;再陥落先のキャラ→ FAVORITE_1_ID(TARGET)　で取得可能、名前は%NTRNAME(FAVORITE_1_ID(TARGET))%
		;やや煩雑になるのでLOCAL、あるいは#DIM等を使用して分かりやすくする事を推奨します
		
		IF (CFLAG:291 < 1 || FLAG:7 == 2)
			;主人に対して陥落し直し
			IF FAVORITE_1_ID(TARGET) == CFLAG:MASTER:캐릭터고유번호
				PRINTFORMW 
			;その他のキャラ・ＮＰＣにＮＴＲし直し
			ELSE
				PRINTFORMW 
			ENDIF
			CFLAG:291 = 1
		ENDIF
		;-------------------------------------------------
		;;淫系再陥落時
		;;主人に対して淫乱系陥落している、もしくは一度淫系ＮＴＲ状態にされたキャラに再び陥落させられる時
		;-------------------------------------------------
	CASE 49
		CALL EVENT_MESSAGE
		;再陥落前に陥落しているキャラ→CFLAG:함락캐릭터 で取得可能、名前は%NTRNAME(CFLAG:함락캐릭터)%
		;再陥落先のキャラ→ FAVORITE_1_ID(TARGET)　で取得可能、名前は%NTRNAME(FAVORITE_1_ID(TARGET))%
		;やや煩雑になるのでLOCAL、あるいは#DIM等を使用して分かりやすくする事を推奨します
					
		IF (CFLAG:292 < 1 || FLAG:7 == 2)
			;主人に対して陥落し直し
			IF FAVORITE_1_ID(TARGET) == CFLAG:MASTER:캐릭터고유번호
				PRINTFORMW 
			;その他のキャラ・ＮＰＣにＮＴＲし直し
			ELSE
				PRINTFORMW 
			ENDIF
			CFLAG:292 = 1
		ENDIF
		;-------------------------------------------------
		;;隷系再陥落時
		;;主人に対して服従系陥落している、もしくは一度隷系ＮＴＲ状態にされたキャラに再び陥落させられる時
		;-------------------------------------------------
	CASE 50
		CALL EVENT_MESSAGE
		;再陥落前に陥落しているキャラ→CFLAG:함락캐릭터 で取得可能、名前は%NTRNAME(CFLAG:함락캐릭터)%
		;再陥落先のキャラ→ FAVORITE_1_ID(TARGET)　で取得可能、名前は%NTRNAME(FAVORITE_1_ID(TARGET))%
		;やや煩雑になるのでLOCAL、あるいは#DIM等を使用して分かりやすくする事を推奨します
					
		IF (CFLAG:293 < 1 || FLAG:7 == 2)
			;主人に対して陥落し直し
			IF FAVORITE_1_ID(TARGET) == CFLAG:MASTER:캐릭터고유번호
				PRINTFORMW 
			;その他のキャラ・ＮＰＣにＮＴＲし直し
			ELSE
				PRINTFORMW 
			ENDIF
			CFLAG:293 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・乱交パーティ
		;;淫ＮＴＲ状態（TALENT:ＮＴＲ == 2 か TALENT:ＮＴＲ == 5）である時のみ
		;-------------------------------------------------
	CASE 51
		CALL EVENT_MESSAGE
		IF (CFLAG:294 < 1 || FLAG:7 == 2)
			IF TALENT:연모 || TALENT:친애
				;以前恋慕ルートだった場合
				PRINTFORMW 「왓 %UNICODE(0x2661)% 크네에 %UNICODE(0x2661)% 오늘 제일 큰 것일지도%UNICODE(0x2661)%」
				PRINTFORMW 「들어가・・려나?・・・앗 아아아!・・대단해에에%UNICODE(0x2661)% 보지 넓혀져버렷・・」
				PRINTFORMW 마리카는 참가자의 거근에 찔려가면서 짐승처럼 허덕이고 있다
			ELSEIF TALENT:음란 || TALENT:창부
				;以前淫乱ルートだった場合
				PRINTFORMW 「왓 %UNICODE(0x2661)% 크네에 %UNICODE(0x2661)% 오늘 제일 큰 것일지도%UNICODE(0x2661)%」
				PRINTFORMW 「들어가・・려나?・・・앗 아아아!・・대단해에에%UNICODE(0x2661)% 보지 넓혀져버렷・・」
				PRINTFORMW 마리카는 참가자의 거근에 찔려가면서 짐승처럼 허덕이고 있다
			ELSEIF TALENT:복종 || TALENT:예속
				;以前服従ルートだった場合
				PRINTFORMW 「왓 %UNICODE(0x2661)% 크네에 %UNICODE(0x2661)% 오늘 제일 큰 것일지도%UNICODE(0x2661)%」
				PRINTFORMW 「들어가・・려나?・・・앗 아아아!・・대단해에에%UNICODE(0x2661)% 보지 넓혀져버렷・・」
				PRINTFORMW 마리카는 참가자의 거근에 찔려가면서 짐승처럼 허덕이고 있다
			ELSE
				PRINTFORMW
			ENDIF
			CFLAG:294 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・公園
		;;淫ＮＴＲ状態（TALENT:ＮＴＲ == 2 か TALENT:ＮＴＲ == 5）である時のみ
		;-------------------------------------------------
	CASE 52
		CALL EVENT_MESSAGE
		IF (CFLAG:295 < 1 || FLAG:7 == 2)
			IF TALENT:연모 || TALENT:친애
				;以前恋慕ルートだった場合
				PRINTFORMW 「부디、%CSTR:일인칭%의 음란한 구멍에 쌓였던 성욕을 처리해 주세요%UNICODE(0x2661)%」
				PRINTFORMW 마리카의 말이 끝나는 것과 동시에 부랑자들이 몰려들었다
				PRINTFORMW （・・범・・해・・・져・・・%UNICODE(0x2661)%）
			ELSEIF TALENT:음란 || TALENT:창부
				;以前淫乱ルートだった場合
				PRINTFORMW 「부디、%CSTR:일인칭%의 음란한 구멍에 쌓였던 성욕을 처리해 주세요%UNICODE(0x2661)%」
				PRINTFORMW 마리카의 말이 끝나는 것과 동시에 부랑자들이 몰려들었다
				PRINTFORMW （・・범・・해・・・져・・・%UNICODE(0x2661)%）
			ELSEIF TALENT:복종 || TALENT:예속
				;以前服従ルートだった場合
				PRINTFORMW 「부디、%CSTR:일인칭%의 음란한 구멍에 쌓였던 성욕을 처리해 주세요%UNICODE(0x2661)%」
				PRINTFORMW 마리카의 말이 끝나는 것과 동시에 부랑자들이 몰려들었다
				PRINTFORMW （・・범・・해・・・져・・・%UNICODE(0x2661)%）
			ELSE
				PRINTFORMW
			ENDIF
			CFLAG:295 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・便器
		;;淫ＮＴＲ状態（TALENT:ＮＴＲ == 2 か TALENT:ＮＴＲ == 5）である時のみ
		;-------------------------------------------------
	CASE 53
		CALL EVENT_MESSAGE
		IF (CFLAG:296 < 1 || FLAG:7 == 2)
			IF TALENT:연모 || TALENT:친애
				;以前恋慕ルートだった場合
				PRINTFORMW 이용자 한 명이 마리카에게 질내사정을 하고 있다
				PRINTFORMW （%CSTR:일인칭%・・ 사용되고 있어・・정자를 짜낼뿐인 고기구멍이 되고 있어%UNICODE(0x2661)%）
				PRINTFORMW 마리카는 성욕처리를 할 뿐인 존재로서 다루어지는 상황에 빠져 있다
			ELSEIF TALENT:음란 || TALENT:창부
				;以前淫乱ルートだった場合
				PRINTFORMW 이용자 한 명이 마리카에게 질내사정을 하고 있다
				PRINTFORMW （%CSTR:일인칭%・・ 사용되고 있어・・정자를 짜낼뿐인 고기구멍이 되고 있어%UNICODE(0x2661)%）
				PRINTFORMW 마리카는 성욕처리를 할 뿐인 존재로서 다루어지는 상황에 빠져 있다
			ELSEIF TALENT:복종 || TALENT:예속
				;以前服従ルートだった場合
				PRINTFORMW 이용자 한 명이 마리카에게 질내사정을 하고 있다
				PRINTFORMW （%CSTR:일인칭%・・ 사용되고 있어・・정자를 짜낼뿐인 고기구멍이 되고 있어%UNICODE(0x2661)%）
				PRINTFORMW 마리카는 성욕처리를 할 뿐인 존재로서 다루어지는 상황에 빠져 있다
			ELSE
				PRINTFORMW
			ENDIF
			CFLAG:296 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・夜の街
		;;淫ＮＴＲ状態（TALENT:ＮＴＲ == 2 か TALENT:ＮＴＲ == 5）である時のみ
		;-------------------------------------------------
	CASE 54
		CALL EVENT_MESSAGE
		IF (CFLAG:296 < 1 || FLAG:7 == 2)
			IF TALENT:연모 || TALENT:친애
				;以前恋慕ルートだった場合
				PRINTFORMW 「저기、파파아・・%CSTR:일인칭%、갖고 싶은 물건이 있어어・・」
				PRINTFORMW 마리카는 방금 원조교제를 제의해온 중년 남자에게 달라붙으면서 말을 계속했다
				PRINTFORMW 「여기서어、파파의 딱딱하고 굵은 자지를 갖고 싶어%UNICODE(0x2661)%」
				PRINTFORMW 「저기이・・괜찮겠죠%UNICODE(0x2661)% 파・파%UNICODE(0x2661)%」
				PRINTFORMW 마리카는 중년 남자와 함께 호텔로 사라져 갔다

			ELSEIF TALENT:음란 || TALENT:창부
				;以前淫乱ルートだった場合
				PRINTFORMW 「저기、파파아・・%CSTR:일인칭%、갖고 싶은 물건이 있어어・・」
				PRINTFORMW 마리카는 방금 원조교제를 제의해온 중년 남자에게 달라붙으면서 말을 계속했다
				PRINTFORMW 「여기서어、파파의 딱딱하고 굵은 자지를 갖고 싶어%UNICODE(0x2661)%」
				PRINTFORMW 「저기이・・괜찮겠죠%UNICODE(0x2661)% 파・파%UNICODE(0x2661)%」
				PRINTFORMW 마리카는 중년 남자와 함께 호텔로 사라져 갔다

			ELSEIF TALENT:복종 || TALENT:예속
				;以前服従ルートだった場合
				PRINTFORMW 「저기、파파아・・%CSTR:일인칭%、갖고 싶은 물건이 있어어・・」
				PRINTFORMW 마리카는 방금 원조교제를 제의해온 중년 남자에게 달라붙으면서 말을 계속했다
				PRINTFORMW 「여기서어、파파의 딱딱하고 굵은 자지를 갖고 싶어%UNICODE(0x2661)%」
				PRINTFORMW 「저기이・・괜찮겠죠%UNICODE(0x2661)% 파・파%UNICODE(0x2661)%」
				PRINTFORMW 마리카는 중년 남자와 함께 호텔로 사라져 갔다
			ELSE
				PRINTFORMW
			ENDIF
			CFLAG:296 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・ＮＴＲ前逢引
		;;ＮＴＲ状態になる前に逢引する時
		;-------------------------------------------------
	CASE 55
		CALL EVENT_MESSAGE
		IF (CFLAG:297 < 1 || FLAG:7 == 2)
			IF CFLAG:함락캐릭터 != 0
				;主人以外に陥落している場合
				PRINTFORMW 
			ELSEIF TALENT:연모 || TALENT:친애
				;恋慕ルート
				PRINTFORMW 
			ELSEIF TALENT:음란 || TALENT:창부
				;淫乱ルート
				PRINTFORMW 
			ELSEIF TALENT:복종 || TALENT:예속
				;服従ルート
				PRINTFORMW 
			ELSE
				PRINTFORMW
			ENDIF
			CFLAG:297 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・ＮＴＲ後初逢引
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)になった直後の一日の終了後、一度だけ行う
		;別のキャラに陥落する度に起こる。同じキャラに再度陥落した場合は起こらない
		;-------------------------------------------------
	CASE 56
		CALL EVENT_MESSAGE
		IF (CFLAG:298 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW （・・아・・싸고 있어・・아기 생겨버리는 걸까・・・）
				PRINTFORMW （괜찮겠지・・이 사람을 사랑하니까・・・이렇게 기분 좋으니까）
				PRINTFORMW 마리카는 %NTRNAME(CFLAG:함락캐릭터)%과 서로 껴안으면서 먼 곳을 보고 있다
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORMW 「읏크우으읏!!・・네・・이걸로 나는 당신의・・것・・・이네요」
				PRINTFORMW 마리카는 질내에서 박동하는 %NTRNAME(CFLAG:함락캐릭터)%의 페니스를 느끼면서、텅 빈 눈으로 중얼거렸다
			ENDIF
			CFLAG:298 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・デート
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;-------------------------------------------------
	CASE 57
		CALL EVENT_MESSAGE
		IF (CFLAG:299 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORMW 
			ENDIF
			CFLAG:299 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・本番
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;女性であれば入れられる側、男性であれば入れる側で固定
		;-------------------------------------------------
	CASE 58
		CALL EVENT_MESSAGE
		IF (CFLAG:601 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 「좋아・・하니까・・욧・・잔뜩 싸주세요옷！」
				PRINTFORMW 마리카의 목소리에 부응하듯 %NTRNAME(CFLAG:함락캐릭터)%의 질내에 사정을 시작했다
				PRINTFORMW （이렇게・・사랑받고서・・・임신하지 않으면・・・안 되겠지요）
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORMW 「・・으응・・쪼옥・・할짝・・하음・・」
				PRINTFORMW %NTRNAME(CFLAG:함락캐릭터)%의 페니스를 덥썩 문 마리카의 질에서 백탁액이 흘러넘치고 있다
				PRINTFORMW 「깨끗하게 됐네요・・・다음엔 어떤 구멍을 사용하시겠어요？」
			ENDIF
			CFLAG:601 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・自慰見せ合い
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;愛ＮＴＲ状態の場合、露出癖3か自慰中毒1のどちらかを満たしている事が条件になります。
		;-------------------------------------------------
	CASE 59
		CALL EVENT_MESSAGE
		IF (CFLAG:602 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORMW 
			ENDIF
			CFLAG:602 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・アナル
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;CFLAG:アナル回数が1以上なら入れられている、CFLAG:挿入回数が1以上なら入れています。
		;両方立っている場合は、地の文では入れられている側が優先されます。
		;-------------------------------------------------
	CASE 60
		CALL EVENT_MESSAGE
		IF (CFLAG:603 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORMW 
			ENDIF
			CFLAG:603 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・野外プレイ
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;愛ＮＴＲの場合、露出癖が4以上でないと発生しません
		;-------------------------------------------------
	CASE 61
		CALL EVENT_MESSAGE
		IF (CFLAG:604 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 「응아아아앗・・・으응・・아앙・・응아아아아아！？」
				PRINTFORMW 마리카는 덤불에 숨어 엿보는 시선을 느끼면서 도달했다
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORMW 「안ㄷ・・아앗・・이러언・・곳에서어・・」
				PRINTFORMW 마리카는 자신이 다니는 고등학교 앞에서 %NTRNAME(CFLAG:함락캐릭터)%에게 범해지고 있다
			ENDIF
			CFLAG:604 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・野外調教
		;;隷ＮＴＲ状態(TALENT:ＮＴＲが 3 か 6)でCFLAG:現ＮＴＲ進行度が6以上の場合１日の終了時に発生。
		;-------------------------------------------------
	CASE 62
		CALL EVENT_MESSAGE
		IF (CFLAG:605 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORMW 「・・에・・아・・・히익！？」
				PRINTFORMW 마리카의 목소리는 작은 비명을 마지막에 몰려든 남자들 속에서 음란한 물소리와 고기의 부딪치는 소리、남자들의 깔보는 웃음소리밖엔 들을 수 없었다
				PRINTFORMW 남자들이 떠난 후에는 텅 빈 눈으로 백탁액을 흘리는 마리카만이 남아 있었다
			ENDIF
			CFLAG:605 = 1
		ENDIF
		;-------------------------------------------------
		;;宿屋、売春口上
		;;宿屋で働かせると１日の終了時に発生
		;;CFLAG:7を自分で書くのややこしいんで放置
		;-------------------------------------------------
	CASE 63
		IF TALENT:처녀
			PRINTFORML 「……」
			PRINTFORML 憮然とした表情をした%CALLNAME:TARGET%に客が呼びかけると、彼女ははっとしたように気を取り直した。
			PRINTFORML 「あっ……と。　ごめんね。　ちょっとぼーっとしてたわ。　本日はご指名ありがとうございます」
			PRINTFORML %CALLNAME:TARGET%は媚びるような笑みを浮かべて、挨拶した。
			PRINTFORML 「……もう聞いてると思うけど、私本当に初めてなのよね。　勿論ウリが、じゃないよ？　そう、処女、なの」
			PRINTFORML 「私の初めて、幾らで買ったのかは知らないけど、優しくしてほしいな」
			;恋慕、親愛
			IF TALENT:3 || TALENT:6
				PRINTFORML (まぁ、忍びの女の貞操とかこんなもんよね。　……好きな男に奪って欲しい、とか夢見るもんじゃないわ)
				PRINTFORML 内心を一切表に出さず、媚びた態度を続ける%CALLNAME:TARGET%の秘所に、客の男はガチガチの肉棒を無理やり押し込んだ。
				PRINTFORMW 悲鳴をこらえて痛みに耐える%CALLNAME:TARGET%の表情を楽しそうに見降ろして、客は勝手に腰を振り始めた……。
			;淫乱、娼婦
			ELSEIF TALENT:4 || TALENT:7
				PRINTFORML ……度重なる調教で、%CALLNAME:TARGET%の身体は女として成熟していた。
				PRINTFORML 客の手による雑な愛撫でも、敏感に反応し、声を上げて悶える。
				PRINTFORML その反応に気をよくした男は、濡れそぼった%CALLNAME:TARGET%の秘所を、乱暴に肉棒で貫く。
				PRINTFORMW %CALLNAME:TARGET%は痛みとない混じった興奮に、背をそらせ、甲高い嬌声を上げて迎え入れた。
			;服従、隷属
			ELSEIF TALENT:5 || TALENT:8
				PRINTFORMW 
			ENDIF
		;危険日か排卵誘発剤
		ELSEIF 위험일(TARGET) == 1 || CFLAG:TARGET:배란유발제 == 1
			PRINTFORML 「本日はご指名ありがとうございま～す。　でも、ごめんねぇ、今日は私ちょっと危ない日なの。　だから、口か、なんならおっぱいで……」
			PRINTFORML 軽い調子で客の前で一礼した%CALLNAME:TARGET%は、サービスの説明をしようとするが、客はそれを押しとどめた。
			PRINTFORML 「え？　……はぁ！？　知ってる！？　知ってて買ったって……。　はぁ、そういう事ならしょうがないですね」
			PRINTFORML （……これでもし出来ちゃったら……）
			PRINTFORMW %CALLNAME:TARGET%は内心ぞっとするものを感じながら、表には出さずにベッドに横になった。　客は嬉々としてその上にのしかかった……。
		ELSEIF TALENT:음란 || TALENT:창부
			SELECTCASE RAND:6
			;挨拶
			CASE 0
				PRINTFORML 「本日はご指名ありがとうございま～す。　それじゃ、やさしく、してね？」
				PRINTFORML 軽い調子で客の前で一礼した%CALLNAME:TARGET%は、柄にもなく弱気を演じながら甘えるように客の身体に自慢の胸を押し付ける。
				PRINTFORML (クノイチっていうのが昔からいた理由が分かるわね、こんな簡単なんだ♪)
				PRINTFORMW 「それではこちらに、オキャクサマ。　サービスしますから、楽しんでいってくださいね」
			;知人
			CASE 1
				PRINTFORML 「本日はご指名ありがとうございま～す。　それじゃ、やさしく、してね？」
				PRINTFORML 軽い調子で客の前で一礼した%CALLNAME:TARGET%を見た客は、
				PRINTFORML 『あれ？　君、確か聖城学園の学生じゃなかったっけ？　いいのぉ、こんな所で……』
				PRINTFORML 「えぇ、お客さん、何でそれを知ってるの？」
				PRINTFORML 驚いたように、%CALLNAME:TARGET%が言葉を返すと、客は薄笑いを浮かべた。
				PRINTFORML 『そりゃ、まぁ……あれだよ。　そんな事よりさぁ……』
				PRINTFORML そう言いながら、ぐっと%CALLNAME:TARGET%の肩を抱き寄せる。
				PRINTFORML （うっわ、これ絶対覗きかなんかでしょ……、まぁいいけど）
				PRINTFORML %CALLNAME:TARGET%は、表情だけひるんだように見せかけながら、
				PRINTFORML 「うーん、困ったなぁ。　お代は負けてあげられないんですけどその分サービスしますからぁ、学校とかには内緒って事で」
				PRINTFORML と言って、媚びた笑みを浮かべながら豊かな双丘を客の身体に押し当てた。
				PRINTFORMW （ま、こんなもんでしょ。　問題は、こいつ私を満足させられるのかなぁ？）
			;フェラ
			CASE 2
				PRINTFORML 「口が良いって？　まっかせて！　舌技には自信あるんだから！」
				PRINTFORML %CALLNAME:TARGET%は、強気な笑みを浮かべると、客の亀頭を啄ばむ様に唇を触れさせる。
				PRINTFORML 舌を出して肉棒と言わずじっくりと舐めると、徐々に先端に近づいて数回唇でつつく様に亀頭を刺激した。。
				PRINTFORML そこから唇を開き、肉棒を咥え込む。
				PRINTFORML 「ちゅっ……ん、ぅ……く、ちゅ……れろ、れろ……」
				PRINTFORMW （あ、そろそろ出しそう。　もう一戦する体力、このお客さんにあるかな……？）
			CASE 3
			;正常位中出し
				PRINTFORML 部屋に入るなり、客は%CALLNAME:TARGET%の豊満な身体をベッドに押さえつけた。
				PRINTFORML 「……そんなに慌てなくても時間は十分あるわよ？　シャワー位浴びてからでも……あっ！？」
				PRINTFORML 話を最後まで聞こうともせず、客は強引に%CALLNAME:TARGET%の秘唇に肉棒を突っ込んだ。
				PRINTFORML 乱暴な抽挿にも、開発された%CALLNAME:TARGET%の肢体は柔軟に答える。
				PRINTFORML 大きく震える乳房に興奮した客は、無遠慮に膣の中で射精した。
				PRINTFORMW (えぇ……早すぎ！　もう……、これで終わりじゃないでしょうね？　もうちょっと楽しませてよ……)
			CASE 4
			;기승위
				PRINTFORML 客は、%CALLNAME:TARGET%を自分の上に跨らせ、下からその姿を見上げる。
				PRINTFORML 出るところは出て締まるところは締まった見事な裸体に、客は肉棒を固くした。
				PRINTFORML その反応を見た%CALLNAME:TARGET%は自慢げに笑みを浮かべると、わざと巨乳を揺らす様にしながら肉棒の上に身を置く。
				PRINTFORML そのまま少しづつ腰を下ろし、肉棒を秘唇で咥え込んでいくと、客は我慢できないというように途中で下から突き上げ始めた。
				PRINTFORML 「あはぁっ！　……そ、そんなにがっつかなくても、ちょっ……あぁ！」
				PRINTFORMW (すっごい！　すご……、あ、ぁ……）
				PRINTFORMW %CALLNAME:TARGET%は大きな喘ぎ声をあげて客を満足させながら、自ら激しく腰を振った。
			CASEELSE
			;SM
				PRINTFORML 客は、%CALLNAME:TARGET%を手慣れた様子で縛りあげると、目にアイマスクを被せた。
				PRINTFORML 「……お客さん？　これ、聞いてないんですけど……。　っ！？」
				PRINTFORML %CALLNAME:TARGET%の抗議には耳を傾けようともせず、客はむっちりとした尻が赤く染まるまで平手で打ち始めた。
				PRINTFORML （あぁ、もう！　こんな趣味の客とか聞いてない！！）
				PRINTFORML 暫く我慢していると、客は叩くのに飽きたのか、縛ったまま後ろから%CALLNAME:TARGET%を肉棒で貫く。
				PRINTFORMW %CALLNAME:TARGET%のうめき声を楽しみながら、客は激しく腰を前後させている。
			ENDSELECT
		ELSE
;忍者だし、感情を表に出さない演技は出来るだろうから表面的な態度は上と大きく変わらない。()の内心で差異を描写？
			SELECTCASE RAND:6
			;挨拶
			CASE 0
				PRINTFORML 「本日はご指名ありがとうございま～す。　それじゃ、やさしく、してね？」
				PRINTFORML 軽い調子で客の前で一礼した%CALLNAME:TARGET%は、柄にもなく弱気を演じながら甘えるように客の身体に自慢の胸を押し付ける。
				PRINTFORML (うわぁ、こんな簡単なんだ。　こんなバカと私、これから……)
				PRINTFORMW 「それではこちらに、オキャクサマ。　サービスしますから、楽しんでいってくださいね」
			CASE 1
				PRINTFORML 「本日はご指名ありがとうございま～す。　それじゃ、やさしく、してね？」
				PRINTFORML 軽い調子で客の前で一礼した%CALLNAME:TARGET%を見た客は、
				PRINTFORML 『あれ？　君、確か聖城学園の学生じゃなかったっけ？　いいのぉ、こんな所で……』
				PRINTFORML 「えぇ、お客さん、何でそれを知ってるの？」
				PRINTFORML 驚いたように、%CALLNAME:TARGET%が言葉を返すと、客は薄笑いを浮かべた。
				PRINTFORML 『そりゃ、まぁ……あれだよ。　そんな事よりさぁ……』
				PRINTFORML そう言いながら、ぐっと%CALLNAME:TARGET%の肩を抱き寄せる。
				PRINTFORML （うっわ、これ絶対覗きかなんかでしょ……、客でなければタダじゃおかないんだけど……）
				PRINTFORML %CALLNAME:TARGET%は、表情だけひるんだように見せかけながら、
				PRINTFORML 「うーん、困ったなぁ。　お代は負けてあげられないんですけどその分サービスしますからぁ、学校とかには内緒って事で」
				PRINTFORML と言って、媚びた笑みを浮かべながら豊かな双丘を客の身体に押し当てた。
				PRINTFORMW （はぁ……こんな奴の相手するなんて……）
			;フェラ
			CASE 2
				PRINTFORML 「口が良いって？　まっかせて！　舌技には自信あるんだから！」
				PRINTFORML %CALLNAME:TARGET%は、強気な笑みを浮かべると、客の亀頭を啄ばむ様に唇を触れさせる。
				PRINTFORML 舌を出して肉棒と言わずじっくりと舐めると、徐々に先端に近づいて数回唇でつつく様に亀頭を刺激した。。
				PRINTFORML そこから唇を開き、肉棒を咥え込む。
				PRINTFORML 「ちゅっ……ん、ぅ……く、ちゅ……れろ、れろ……」
				PRINTFORMW （口で済むならその方が良いわ。　サービスしてあげるから、それで満足してよね……）
			CASE 3
			;正常位中出し
				PRINTFORML 部屋に入るなり、客は%CALLNAME:TARGET%の豊満な身体をベッドに押さえつけた。
				PRINTFORML 「……そんなに慌てなくても時間は十分あるわよ？　シャワー位浴びてからでも……あっ！？」
				PRINTFORML 話を最後まで聞こうともせず、客は強引に%CALLNAME:TARGET%の秘唇に肉棒を突っ込んだ。
				PRINTFORML 乱暴な抽挿にも、開発された%CALLNAME:TARGET%の肢体は柔軟に答える。
				PRINTFORML 大きく震える乳房に興奮した客は、無遠慮に膣の中で射精した。
				PRINTFORMW (中で出された……！　こいつ……クソ、クソぉ……)
			CASE 4
			;기승위
				PRINTFORML 客は、%CALLNAME:TARGET%を自分の上に跨らせ、下からその姿を見上げる。
				PRINTFORML 出るところは出て締まるところは締まった見事な裸体に、客は肉棒を固くした。
				PRINTFORML その反応を見た%CALLNAME:TARGET%は自慢げに笑みを浮かべると、わざと巨乳を揺らす様にしながら肉棒の上に身を置く。
				PRINTFORML そのまま少しづつ腰を下ろし、肉棒を秘唇で咥え込んでいくと、客は我慢できないというように途中で下から突き上げ始めた。
				PRINTFORML 「あはぁっ！　……そ、そんなにがっつかなくても、ちょっ……あぁ！」
				PRINTFORML (う……こいつ、ゴム付けてた？　か、確認するチャンスが……うそ、中は……）
				PRINTFORMW %CALLNAME:TARGET%は大きな喘ぎ声をあげて客を満足させながら、自ら激しく腰を振った。
			CASEELSE
				PRINTFORML 客は、%CALLNAME:TARGET%を手慣れた様子で縛りあげると、目にアイマスクを被せた。
				PRINTFORML 「……お客さん？　これ、聞いてないんですけど……。　っ！？」
				PRINTFORML %CALLNAME:TARGET%の抗議には耳を傾けようともせず、客はむっちりとした尻が赤く染まるまで平手で打ち始めた。
				PRINTFORML （あぁ、もう！　こんな趣味の客とか聞いてない！！）
				PRINTFORML 暫く我慢していると、客は叩くのに飽きたのか、縛ったまま後ろから%CALLNAME:TARGET%を肉棒で貫く。
				PRINTFORMW %CALLNAME:TARGET%のうめき声を楽しみながら、客は激しく腰を前後させている。
			ENDSELECT
		ENDIF
		
		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔とセックスする
		;やられちゃう側
		;PLAYERに実行者の番号が入っています
		;-------------------------------------------------
	CASE 79
		CALL EVENT_MESSAGE
		IF (CFLAG:602 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:602 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔に奉仕させる
		;奉仕する側
		;PLAYERに実行者の番号が入っています
		;-------------------------------------------------
	CASE 80
		CALL EVENT_MESSAGE
		IF (CFLAG:603 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:603 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：その場で自慰
		;奉仕する側
		;-------------------------------------------------
	CASE 81
		CALL EVENT_MESSAGE
		IF (CFLAG:604 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:604 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：物陰で自慰
		;奉仕する側
		;-------------------------------------------------
	CASE 82
		CALL EVENT_MESSAGE
		IF (CFLAG:605 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:605 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔とセックスする
		;やる側
		;PLAYERに相手の番号が入っています
		;-------------------------------------------------
	CASE 83
		CALL EVENT_MESSAGE
		IF (CFLAG:606 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:606 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔に奉仕させる
		;奉仕される側
		;PLAYERに奉仕する側の番号が入っています
		;-------------------------------------------------
	CASE 84
		CALL EVENT_MESSAGE
		IF (CFLAG:607 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:607 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：輪姦イベント
		;奉仕する側
		;PLAYERに実行者=輪姦する悪魔の番号が入っています
		;-------------------------------------------------
	CASE 85
		CALL EVENT_MESSAGE
		IF (CFLAG:608 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:608 = 1
		ENDIF
	CASEELSE
		SIF FLAG:6 > 0
			CALL EVENT_MESSAGE
ENDSELECT
