;セックス系コマンド
;=================================================
;-------------------------------------------------
;60,정상위
;-------------------------------------------------
	CASE 60
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:332 == 0
			;処女
			IF TALENT:0
				IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:332 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:3 || TALENT:6
						PRINTFORMW ベッドに横になった%CALLNAME:TARGET%と身体を重ね、肉棒を閉じた秘唇に当てる。
						PRINTFORMW 入り口近くをなぞる様に数回肉棒を動かすと、%CALLNAME:TARGET%は少し微笑んだ。
						PRINTFORMW 「……平気よ、私痛いのには強いから。　それに……私は嬉しいから。　こんな、普通の女の子みたいな初めてを迎えるなんて思ってなかった」
						PRINTFORMW 「悪魔相手に食われながら犯されるとか、色仕掛けで……とか、どうせそんなだろうって。　でもそうじゃなかった」
						PRINTFORMW 「だから、平気よ。　私をあなたの女にして」
						PRINTFORMW そこまで言われてじらす気にもならず、抵抗を突き破る様に屹立した肉棒を少しずつ押し込んでゆく。
						PRINTFORMW 「……っ！　ぁ……っ！！」
						PRINTFORMW %CALLNAME:TARGET%は初めての痛みに耐えるように、ぎゅっと%CALLNAME:MASTER%にしがみついてきた。
					;淫乱、娼婦
					ELSEIF TALENT:4 || TALENT:7
						PRINTFORMW ベッドに横になった%CALLNAME:TARGET%と身体を重ね、肉棒を閉じた秘唇に当てる。
						PRINTFORMW 「そういえば、あれだけ無茶苦茶されたのに、私まだ処女だったのね。　ま、それもここまでだけど」
						PRINTFORMW そう言いながらも、それほど未練がある様子もない。
						PRINTFORMW 「う～ん、まぁ痛いっていうけど、そっちは耐えられる方だと思うしね。　それに……すごく気持ちいいんでしょ？　だったら、ね」
						PRINTFORMW と、さばさばした表情を急に淫蕩に崩して見せる。　その表情に誘われるように、屹立した肉棒を一気に押し込んだ。
						PRINTFORMW 「……っ！　ぁ……っ！！」
					;服従、隷属
					ELSEIF TALENT:5 || TALENT:8
						PRINTFORMW 「」
						PRINTFORMW 「」
					ELSE
						PRINTFORMW %CALLNAME:TARGET%をベッドにあおむけに押し倒し、肉感的な太腿を割って抑え込む。
						PRINTFORMW こちらの意図は明らかだ。　%CALLNAME:TARGET%は抵抗するが、こうなってはどうしようもないだろう。
						PRINTFORMW 「……ふん、やっとその気になったってわけね。　勝手にしなさいよ。　ちょっと突っ込んだくらいで女をものにできると思うんならね！」
						PRINTFORMW せめて弱みは見せるまいというのか、%CALLNAME:TARGET%は余裕のある表情を作ろうとするが、表情は少し引きつっている。
						PRINTFORMW 可愛げのない態度にかえって征服欲を擽られ、未だ何物の侵入をも許したことのない洞に、問答無用で屹立をねじこんだ。
						PRINTFORMW 「――っ！　ぁ、くぅ……っ」
						PRINTFORMW 歯を食いしばって声を出さない%CALLNAME:TARGET%だが、下の口からは破瓜の血が流れ出している。
					ENDIF
				ENDIF
			;それ以外
			ELSE
				IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:332 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:3 || TALENT:6
						PRINTFORMW %CALLNAME:TARGET%はベッドに横になり、迎え入れるように両手を広げて、%CALLNAME:MASTER%を抱きしめた。
						PRINTFORMW 「うん、やっぱり私は抱かれるならこの格好が良いわ。　……案外私、普通の女の子だったのね」
						PRINTFORMW 言いながら、足を絡めるように%CALLNAME:MASTER%の腰に絡める様に回した。
					;淫乱、娼婦
					ELSEIF TALENT:4 || TALENT:7
						PRINTFORML 「そういえば、この格好でするのは初めてだっけ？」
						PRINTFORMW %CALLNAME%は軽く頷き、大きく股を開いて、%CALLNAME:PLAYER%に手招きをする。
						PRINTFORML 「これでいい？　こっちだと、どんな感じで挿るのかな。　遠慮なしで腰を振ってよね」
					;服従、隷属
					ELSEIF TALENT:5 || TALENT:8
						PRINTFORMW 「」
						PRINTFORMW 「」
					ELSE
						PRINTFORMW %CALLNAME:TARGET%をベッドにあおむけに押し倒し、肉感的な太腿を割って抑え込む。
						PRINTFORMW 「……ちっ……勝手に突っ込んで、勝手に腰振ってればいいでしょ。　」
						PRINTFORMW %CALLNAME:TARGET%は軽蔑を露わにしているが、まだ慣れていないからか体が硬くなっている。
						PRINTFORMW しかし、そのまま抑え込んで、肉棒を秘所に突っ込んだ。　%CALLNAME:TARGET%の口から、抑えた呻きが漏れる。
						PRINTFORMW 「う、くぅ……ぁ、くぅ……っ」
					ENDIF
				ENDIF
			ENDIF
			CFLAG:332 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:332 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					IF RAND:2 == 0
						PRINTFORML %CALLNAME:TARGET%は抱きしめるように腕を%CALLNAME:MASTER%の背に回して、肉棒を迎え入れた。
						PRINTFORMW 「うっ、あぁっ、あ……！　お、くまで、はいってくる……！！」
					ELSE
						PRINTFORML 「くっ、ふぅぅ……っ！　こ、こすれるぅ！　私の！　中でぇっ！」
						PRINTFORMW %CALLNAME:TARGET%は、瞼をぎゅっと閉じて自分の中に挿ってくる肉棒を受け入れた。
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					IF RAND:2 == 0
						PRINTFORML 「あぁっ、はいってくるぅ……っ。　私の、オマンコ、いっぱいに……」
						PRINTFORML すっかり雌の身体に変わった%CALLNAME:TARGET%は身を震わせながら悦びに喘ぐ。
						PRINTFORMW 「はぁ、はぁっ、ん……。　もっと、チンポ深く、えぐってぇ！」
					ELSE
						PRINTFORML 「これっ、待ってた、の……っ。　%CSTR:이인칭%のおちんちんっ！！」
						PRINTFORML %CALLNAME:TARGET%は快楽に身をよじりながら、かつては口にしなかっただろう言葉を無我夢中で叫ぶ。
						PRINTFORMW 「あ、ひ、ぃぃ……っ！　擦れる……ぅ」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 「」
				ENDIF
				CFLAG:332 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:332 < 3 || FLAG:7 == 2)
				PRINTFORML 「あぁ、うぅ、くぅ……ん、こんな、事……くぅらいで、ぁは、ん、あぁぁ……」
				PRINTFORMW %CALLNAME:TARGET%は屈服を拒む言葉を口にしながらも、その言葉は喘ぎ声にかき消されそうになっている。
				CFLAG:332 = 3
			;それ以外
			ELSEIF CFLAG:332 < 2 || FLAG:7 == 2
				PRINTFORML 「……ぅ、、ぁ、くぅ……、こ、小汚い肉棒突っ込んだくらいで、忍者を落とせるなんて思ってるんじゃないでしょうね！」
				PRINTFORMW 息を荒げながらも、%CALLNAME:TARGET%は屈服する様子を見せないでいる。
				CFLAG:332 = 2
			ENDIF
		ENDIF

