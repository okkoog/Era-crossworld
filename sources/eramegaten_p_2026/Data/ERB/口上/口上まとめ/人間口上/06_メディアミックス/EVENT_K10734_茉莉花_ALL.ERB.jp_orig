				PRINTFORMW 
				CFLAG:229 = 2
			;それ以外
			ELSEIF CFLAG:229 < 1 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:229 = 1
			ENDIF
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:230 < 3 || FLAG:7 == 2)
