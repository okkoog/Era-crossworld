;-------------------------------------------------
	CASE 102
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:356 == 0
			PRINTFORMW 
			CFLAG:356 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:356 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORMW 
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ENDIF
				CFLAG:356 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:356 < 3 || FLAG:7 == 2)
				PRINTFORMW 
				CFLAG:356 = 3
			;それ以外
			ELSEIF CFLAG:356 < 2 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:356 = 2
			ENDIF
		ENDIF

