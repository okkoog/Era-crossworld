;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_C関係（X1をキャラ番号に置換）
;調教後の変化をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_C_K[[キャラ:마리카]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_C
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_C_PY1_K[[キャラ:마리카]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_C_PY1_K[[キャラ:마리카]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;調教後のテキスト
;-------------------------------------------------
;-------------------------------------------------
;処女喪失(処女のみ)
;-------------------------------------------------
IF TFLAG:3 > 0
	CALL PALAM_MESSAGE_C
	;---006 EDIT START---
	;주인에의한처녀상실
	IF TFLAG:20
		;陥落素質チェック
		IF TALENT:연모 || TALENT:친애
			PRINTFORMW 「う……ん。……痛いって聞いてたけど、そんなでもないのね。　痛みには慣れてるからかな？」
			PRINTFORMW %CALLNAME:TARGET%はそういうが痛みがないわけではないのだろう。　少し表情を固くしながらも、%CALLNAME:TARGET%は微笑んで見せた。
			PRINTFORMW 「……だから平気よ。　遠慮なんていらないから、好きに動いて……」
		ELSEIF TALENT:음란 || TALENT:창부
			WSTR:(K++) = 
		ELSEIF TALENT:복종 || TALENT:예속
			WSTR:(K++) = 
		ELSE
			;屈服刻印Lv3
			IF MARK:2 == 3
				PRINTFORMW 「아그윽！　‥‥크‥‥으‥‥그으‥‥ 아팟！」
				PRINTFORMW 살풍경한 실내에서、%CALLNAME%의 눌러죽인 신음소리가 울린다。
				PRINTFORMW 필사적으로 비명을 지르지 않으려 견디고는 있지만、목소리가 새는 것을 억누르지 못하고 있다。
				PRINTFORMW %마스터가% 허리를 강하게 찔러 넣자、참지 못하고 날카로운 비명을 질렀다。
				PRINTFORMW 「아앗、아아앗、！　‥‥아파、아아아아아아앗！！」
				PRINTFORMW 한 번 무너져내리면 그 이상은 견뎌낼 수 없다。
				PRINTFORMW %CALLNAME은% 고통에 몸을 뒤틀며、눈물마저 흘리고 있었다。
			ELSE
				PRINTFORMW 「아그윽！　‥‥크‥‥으‥‥그으‥‥읏！」
				PRINTFORMW 살풍경한 실내에서、%CALLNAME%의 눌러죽인 신음소리가 울린다。
				PRINTFORMW 결합부에서는、한줄기의 빨간 실이 흘러나오고 있었다。
				PRINTFORMW 침입을 거부하는 것 같은 강렬한 조임도、%CALLNAME이% 처녀였음을 증명하고 있다。
				PRINTFORMW %CALLNAME은% 이를 악물고、주먹을 움켜쥐고 아픔과 굴욕을 견디고 있다。
			ENDIF
		ENDIF
	;それ以外の時に処女喪失(主人による道具系調教含む)
	ELSE
		;陥落素質チェック
		IF TALENT:연모 || TALENT:친애
			WSTR:(K++) =
		ELSEIF TALENT:음란 || TALENT:창부
			WSTR:(K++) =
		ELSEIF TALENT:복종 || TALENT:예속
			WSTR:(K++) =
		ELSE
			;屈服刻印Lv3
			IF MARK:2 == 3
				WSTR:(K++) = 
			ELSE
				WSTR:(K++) = 
			ENDIF
		ENDIF
	ENDIF
	;---006 EDIT END---
ENDIF

;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_D関係（X1をキャラ番号に置換）
;パラメータ変化をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_D_K[[キャラ:마리카]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_D
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_D_PY1_K[[キャラ:마리카]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_D_PY1_K[[キャラ:마리카]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;パラメータ変化時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;初めて潤滑がLV3超えた
;-------------------------------------------------
P = PALAM:4 + UP:4
IF P > PALAMLV:4 && CFLAG:245 == 0
	CALL PALAM_MESSAGE_D
	;ローションを使った場合
	IF SELECTCOM == 180
		PRINTFORML 질척하게 실을 늘어뜨리는 로션에、%CALLNAME은% 질린 표정을 지었다。
		PRINTFORMW 하지만、이만큼 젖었다면、지금 당장 삽입도 가능할 것이다‥‥
	;それ以外
	ELSE
		PRINTFORML %CALLNAME은%、열띤 모습으로、자신의 비소에 손을 가져다 대본다。
		PRINTFORML 손가락에 달라붙는 액체를 확인하고 입술을 문다。
		PRINTFORMW (싫어‥‥나、이렇게나 젖어버렸어‥‥)
	ENDIF
	CFLAG:245 = 1
ENDIF

;-------------------------------------------------
;初めて欲情がLV2超えた
;-------------------------------------------------
P = PALAM:6 + UP:6
IF P > PALAMLV:3 && CFLAG:246 == 0
	CALL PALAM_MESSAGE_D
	;媚薬を使った場合
	IF SELECTCOM == 181
		PRINTFORML 「‥‥뭐야、이런 거‥‥좀전의 약 때문이잖아！」
		PRINTFORMW %CALLNAME은% 기세좋게 그렇게 외쳤지만、말과는 다르게 얼굴은 새빨갛게 달아올라있었다。
	;それ以外
	ELSE
		PRINTFORML (안돼、나 흘러가버려‥‥위험해‥‥)
		PRINTFORML %CALLNAME은% 홍조를 띤 얼굴을 가리며 숨을 몰아쉬고있다。
		PRINTFORMW 어깨가 들썩일 때마다、커다란 가슴이 흔들리고 있었다。
	ENDIF
	CFLAG:246 = 1
ENDIF

;-------------------------------------------------
;初めて屈服がLV3超えた
;-------------------------------------------------
P = PALAM:7 + UP:7
IF P > PALAMLV:3 && CFLAG:247 == 0
	CALL PALAM_MESSAGE_D
	;陥落済み
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:247 = 1
ENDIF

;-------------------------------------------------
;初めて恭順がLV3超えた
;-------------------------------------------------
P = PALAM:5 + UP:5
IF P > PALAMLV:3 && CFLAG:248 == 0
	CALL PALAM_MESSAGE_D
	;陥落済み
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:248 = 1
ENDIF

;-------------------------------------------------
;初めて恐怖がLV3超えた
;-------------------------------------------------
P = PALAM:11 + UP:11
IF P > PALAMLV:3 && CFLAG:249 == 0
	CALL PALAM_MESSAGE_D
	;陥落済み
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:249 = 1
ENDIF

;-------------------------------------------------
;@KOJO_MESSAGE_MARKCNG関係（X1をキャラ番号に置換）
;刻印変動をトリガーにした口上
;刻印変動後に口上を発動します
;-------------------------------------------------
@KOJO_MESSAGE_MARKCNG_K[[キャラ:마리카]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL MARK_MESSAGE
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_MARKCNG_PY1_K[[キャラ:마리카]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_MARKCNG_PY1_K[[キャラ:마리카]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;苦痛刻印Lv3
;-------------------------------------------------
IF TFLAG:22 == 3
	CALL MARK_MESSAGE_A
	;陥落済み
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		;恋慕、親愛
		IF TALENT:3 || TALENT:6
			PRINTFORMW 
		;淫乱、娼婦
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORMW 
		;服従、隷属
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 
		ENDIF
	ELSE
		PRINTFORMW 
	ENDIF
ENDIF

;-------------------------------------------------
;快楽刻印Lv3
;-------------------------------------------------
IF TFLAG:23 == 3
	CALL MARK_MESSAGE_P
	;陥落済み
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		;恋慕、親愛
		IF TALENT:3 || TALENT:6
			PRINTFORMW 「괴、굉장햇！！　나、이런 거어‥‥몰랐엇」
			PRINTFORMW %CALLNAME은% 쾌락에 몸을 떨며、조르듯이 중얼거렸다‥‥더 기분좋은 것을 가르쳐 달라고‥‥
		;淫乱、娼婦
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORMW 
		;服従、隷属
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 「나、나‥‥이렇게 심한 취급당하고 있는데‥‥어째서‥‥？」
		ENDIF
	ELSE
		PRINTFORMW 필사적으로 쾌락에 계속 저항하는 %CALLNAME%의 의지도 결국 무너지는 날이 왔다。
		PRINTFORMW 「‥‥으、이、이제 안돼에！　아앗！　기분좋앗！！　말도 안돼에、이런 거언！！」
	ENDIF
ENDIF

;-------------------------------------------------
;屈服刻印Lv3
;-------------------------------------------------
IF TFLAG:24 == 13 || TFLAG:24 == 23 || TFLAG:24 == 33
	CALL MARK_MESSAGE_S
	;快楽による屈服
	IF TFLAG:24 == 13
		PRINTFORML （아、아‥‥이제、안돼‥‥암것도‥‥알 수 없게‥‥되서‥‥）
		PRINTFORMW 「‥‥이미、뭐가 뭔지、아무래도 상관없으니까아‥‥좀 더、기분좋게‥‥으‥‥」
	;恐怖と苦痛による屈服
	ELSEIF TFLAG:24 == 23
		PRINTFORML （아、아‥‥이제、안돼‥‥무서워‥‥무서워‥‥거역했다간‥‥）
		PRINTFORML 「‥‥아、으‥‥나‥‥」
		PRINTFORMW %CALLNAME은% 겁에 질린 눈빛으로、새파래진 입술을 떨며 굴복의 맹세를 입에 담았다。
	;屈服と恭順による屈服
	ELSEIF TFLAG:24 == 33
		PRINTFORMW 
	ENDIF
ENDIF

;-------------------------------------------------
;反発刻印Lv3
;-------------------------------------------------
IF TFLAG:21 == 3
	CALL MARK_MESSAGE_R
	;陥落済み
	IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
		;恋慕、親愛
		IF TALENT:3 || TALENT:6
			PRINTFORMW 
		;淫乱、娼婦
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORML 「‥‥확실히 %CALLNAME:MASTER%의 기술은 대단하다고？　하지만말야‥‥」
			PRINTFORML 「‥‥기분좋게하는 것 뿐이라면、%마스터가% 아니라도 상관없어。의미를 알겠어？」
			PRINTFORMW 말투는 조용하지만、두 눈에는 칼날처럼 차가운 빛이 깃들어 있는 것 같다‥‥。
		;服従、隷属
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 
		ENDIF
	ELSE
		PRINTFORML %CALLNAME은% 감정을 느낄 수 없는 얼어붙은 눈으로 %마스터를% 주시했다。
		PRINTFORML %CALLNAME은% 입을 열고 아무 말도 하지 않았지만、그럴 필요도 없다。
		PRINTFORMW 한기가 느껴질 정도의 살기가、그녀의 분노를 충분히 나타내고있다。
	ENDIF
ENDIF

