;=================================================
;触手系コマンド
;=================================================
;-------------------------------------------------
;160,촉수소환
;-------------------------------------------------
	CASE 160
		IF TEQUIP:25
			CALL TRAIN_MESSAGE
			;初めて
			IF CFLAG:382 == 0
				PRINTFORML 召喚された触手が地面を這いまわるように蠢く姿を見て、%CALLNAME:TARGET%は反射的に身構えた。
				PRINTFORML 「悪魔！？　%CALLNAME:MASTER%！　こんなもの召喚してどういう心算！？」
				PRINTFORML 動きと戦意に反応したのか、何本もの触手が風を切って伸びる。
				PRINTFORML それを飛びのき、身をひねり、かわし切れなかった触手を腕で防ごうとして、絡みつかれる。
				PRINTFORML ぬめっとした手触りと、ひやりとした感触に、%CALLNAME:TARGET%は思わず身を震わせた。
				PRINTFORML 「きゃっ！　……っ……このぉ！　放せ、化け物！」
				PRINTFORML 思わず女の子っぽい悲鳴を上げてしまった%CALLNAME:TARGET%は、それを誤魔化すように触手を振りほどこうとあがく。
				PRINTFORMW しかし、一度絡みついた触手は取れず、それどころか健康的な太もも、縊れた腰と次々絡みついて、彼女の自由を奪っていく。
				CFLAG:382 = 1
			;二回目以降
			ELSE
				;陥落済み
				IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:382 < 4 || FLAG:7 == 2)
					;恋慕、親愛
					IF TALENT:3 || TALENT:6
						PRINTFORMW 
					;淫乱、娼婦
					ELSEIF TALENT:4 || TALENT:7
						PRINTFORMW 
					;服従、隷属
					ELSEIF TALENT:5 || TALENT:8
						PRINTFORMW 
					ENDIF
					CFLAG:382 = 4
				;屈服刻印Lv3
				ELSEIF MARK:2 == 3 && (CFLAG:382 < 3 || FLAG:7 == 2)
					PRINTFORMW 
					CFLAG:382 = 3
				;それ以外
				ELSEIF CFLAG:382 < 2 || FLAG:7 == 2
					PRINTFORMW 
					CFLAG:382 = 2
				ENDIF
			ENDIF
		ELSE
			IF CFLAG:382 == 1 || FLAG:7 == 2
				CALL TRAIN_MESSAGE
				PRINTFORMW 
			ENDIF
		ENDIF

;-------------------------------------------------
;161,촉수삽입
;-------------------------------------------------
	CASE 161
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:383 == 0
			PRINTFORML %CALLNAME:TARGET%の四肢に絡みついた触手は、彼女の抵抗を無視して、両足を割開くように開かせた。
			PRINTFORML %CALLNAME:TARGET%は痛みに表情を歪めるが、触手は蛇のような滑らかな動きですらりとした足に巻き付きながら這い上がる。
			PRINTFORML 白い太腿を、赤茶けた体液で汚しながら足の付け根まで辿り着くと、触手は鎌首をもたげるように先端を掲げ、%CALLNAME:TARGET%の秘所に狙いを定めた。
			PRINTFORML 「まさか、こいつっ！　この、放せ！　放せって言ってるでしょ！！　このぉっ！」
			PRINTFORML じたばたと暴れても、しっかりと絡めとられた身体はびくともしない。　むしろ必死の抵抗は%CALLNAME:TARGET%の体力を削っていく。
			;処女
			IF TALENT:0
				PRINTFORML 触手はゆらゆらと先端を前後に揺らしながら少しづつ近づいていき……疲労で抵抗が緩んだところで、触手の細い先端が滑り込むように%CALLNAME:TARGET%のぴったりと閉じた処女地に滑り込んだ。
				PRINTFORML 「ひぃっ！　こ、こんな……、私化け物なんかに……」
				PRINTFORML 流石にショックが大きかったようで、%CALLNAME:TARGET%は呆然と目を見開いているが、それも長くは続かなかった。
				PRINTFORML 触手は中で太さを取り戻すと、少女の感傷など無視して深く、浅く、前後に蠢き始めた。
				PRINTFORMW 中から削られるような痛みに、%CALLNAME:TARGET%はガクガクと振り回され、秘所からは、触手の体液と、破瓜の血が混じりあって、少女の太腿を汚している。
			;それ以外
			ELSE
				PRINTFORMW 
			ENDIF
			CFLAG:383 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:383 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORMW 
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ENDIF
				CFLAG:383 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:383 < 3 || FLAG:7 == 2)
				PRINTFORMW 
				CFLAG:383 = 3
			;それ以外
			ELSEIF CFLAG:383 < 2 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:383 = 2
			ENDIF
		ENDIF

