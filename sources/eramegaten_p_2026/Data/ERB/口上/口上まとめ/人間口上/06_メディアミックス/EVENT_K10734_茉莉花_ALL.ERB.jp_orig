;-------------------------------------------------
;奴隷の絶頂時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;初めてC絶頂
;-------------------------------------------------
IF NOWEX:0 > 0 && CFLAG:241 == 0
	PRINTFORMW 「아、아앗！　%CSTR:일인칭%、%CSTR:일인칭%！　하히이이이이익！」
	PRINTFORMW 유두에 가해진 쾌락을 견디지 못하고、%CALLNAME이% 비명을 지른다。
	PRINTFORMW 「아、안됏！　갑자기、어째서엇…！」
	PRINTFORMW 꾹 하고 미간을 모르고、어떻게든 쾌락에 견뎌내 보려 하는 %CALLNAME%。
	PRINTFORMW 그러나  %조사처리(NAME:MASTER,"가")% 그것을 허락할 리도 없다、작은 고기 알맹이를 깨물어、한층 더 격하게 빨아들였다。
	PRINTFORMW 「히…익！　하히야히아아아아아앗!！！」
	PRINTFORMW 푸슈우우우우웃!
	PRINTFORMW 실금이라도 한 듯한 기세로、소녀의 비순에서 대량의 꿀이 뿜어져 나온다。
	PRINTFORMW 그 기세는 굉장해서、%CALLNAME%의 발에 가랑이의 추잡한 점액줄기를 만들면서 바닥까지 적셨다。
	PRINTFORMW 「으으으읏… 학、학、학…！　아、힉…」
	PRINTFORMW （%CSTR:일인칭%… 가버린거、야…？）
	CFLAG:241 = 1
ENDIF

;-------------------------------------------------
;初めてV絶頂
;-------------------------------------------------
IF NOWEX:1 > 0 && CFLAG:242 == 0
	PRINTFORMW 「아、안됏！　…제바알… 움직이지 맛！」
	PRINTFORMW 호소를 무시하고 다시 질내를 강하게 찌르자、%CALLNAME은% 마치 궁지에 몰린듯한 표정으로 절규했다。
	PRINTFORMW 「%CSTR:일인칭%、%CSTR:일인칭%、가버렷！　아웃！」
	;欲望Lv5or淫乱or娼婦
	IF (ABL:욕망 >= 5) || TALENT:음란 || TALENT:창부
		PRINTFORM 「보지가
	ELSE
		PRINTFORM 「거기 안쪽이
	ENDIF
	PRINTFORMW 기분 좋아져서어！　가、가버려어엇 하아아아아앗！！」
	PRINTFORMW %CALLNAME%의 몸이 크게 떨리고、동시에 푸슈우웃 하는 소리를 내며 애액이 분출했다。
	PRINTFORMW 「…하아… 하아… 아아…」
	PRINTFORMW 처음 맞이한 질절정으로、%CALLNAME%의 뺨에、한줄기 눈물이 흐르고 있었다。
	CFLAG:242 = 1
ENDIF

;-------------------------------------------------
;初めてA絶頂
;-------------------------------------------------
IF NOWEX:2 > 0 && CFLAG:243 == 0
	PRINTFORMW 「우웃！　기다렷！　움직이지 말아줫… 크힉！」
	PRINTFORMW %CALLNAME%의 엉덩이구멍은 지금까지의 조교로 완전히 자포자기되어、%조사처리(NAME:MASTER,"가")% 주는 자극을 완전히 받아들이고 있다。
	PRINTFORMW 「핫、하힉！　하힉！　그、그마안…！　그만애에에에…！」
	PRINTFORMW 꿈틀꿈틀 경련하면서、%CALLNAME이% 혀짧은 발음으로 호소한다。
	PRINTFORMW 그런 그녀의 엉덩이구멍을、%조사처리(NAME:MASTER,"는")% 한층 더 강렬하게 휘저었다。
	PRINTFORMW 「히야 히이이이이ー익！！」
	PRINTFORMW 침과 애액、그리고 장액까지 뿜어가면서、소녀닌자는 치욕의 항열절정을 맞았다。
	PRINTFORMW 「하아… 하아… 우웃… 엉덩이로 어째서… %CSTR:일인칭%…ㅅ…」
	CFLAG:243 = 1
ENDIF

;-------------------------------------------------
;初めてB絶頂
;-------------------------------------------------
IF NOWEX:3 > 0 && CFLAG:244 == 0
	PRINTFORMW 「힉… 아、우웃！　안、돼…엣！」
	IF BUST() > 3
		PRINTFORM 주무를 가치가 있는 
	ELSEIF TALENT:빈유
		PRINTFORM 작게 흔들리는 
	ELSEIF TALENT:절벽
		PRINTFORM 평탄한 
	ENDIF
	PRINTFORMW 가슴에 주어진 자극에、%CALLNAME이% 전신을 떤다。
	PRINTFORMW 「그、만… 그만해주、아 큭… 그만해줘、어…ㅅ！」
	PRINTFORMW 필사적으로 저항하는 그녀를 무시하고、%조사처리(NAME:MASTER,"는")% %CALLNAME%의 유두를 꼬집어 올렸다。
	PRINTFORMW 「~~읏！　아、안돼…！　히、아앗！　갓、가버려엇！！」
	PRINTFORMW 움찔、하고 전신을 떤 직후、%CALLNAME%의 전신이 이완된다。
	PRINTFORMW 아무래도、가슴으로 절정을 맞이한 것 같다。
	CFLAG:244 = 1
ENDIF

;-------------------------------------------------
;절정
;-------------------------------------------------
;強絶頂
IF TFLAG:29 > 1
	CALL PALAM_MESSAGE_B
	;陥落済み
	IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:245 < 4 || FLAG:7 == 2)
		IF RAND:9 == 0
			PRINTFORMW 「아、앙대엣！　그것만 아니면 뭐든지！　하히이이이잉！」
		ELSEIF RAND:9 == 1
			PRINTFORMW 「%CSTR:일인칭%、%CSTR:일인칭%、또 가앗！　가버려어엇！　읏히이이이잉！」
		ELSEIF RAND:9 == 2
			PRINTFORMW 「그것만 아니며、어언！　학、히、앗！　앗하아아아앗！」
		ELSEIF RAND:9 == 3
			PRINTFORMW 「으응、응、크히이잉！　이、이제엣、가버… 읏히이이이잇！」
		ELSEIF RAND:9 == 4
			PRINTFORMW 「%CSTR:일인칭%、앗히이잇！　%CSTR:일인칭%ㅅ、기분、좋아서、핫히이이이잇！」
		ELSEIF RAND:9 == 5
			PRINTFORMW 「%CSTR:일인칭%、%CSTR:일인칭%ㅅ、이상、해ㅈ、힉！　이상해져、버려우우우우웃！　핫히이이익！」
		ELSEIF RAND:9 == 6
			PRINTFORMW 「%CSTR:일인칭%、%CSTR:일인칭%、가버렷！　아읏！」
			PRINTFORMW 「전부、몸 전체가、기분、좋아져서엇！　가아、가버려어어엇 하아아아아아앙！！」
		ELSEIF RAND:9 == 7
			PRINTFORMW 「%CSTR:일인칭%、%CSTR:일인칭%、가！　가버려어어어엇！」
		ELSE
			PRINTFORMW 「%CSTR:일인칭%、가버려어엇、가、…아하아아아아앗！！」
		ENDIF
		PRINTFORM 절정를 맞은 %CALLNAME은%、
		;恋慕、親愛
		IF TALENT:3 || TALENT:6
			PRINTFORM 안심한 
		;淫乱、娼婦
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORM 녹아버린 
		;服従、隷属
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORM 어딘가 텅 빈 
		ENDIF
		PRINTFORM 표정인 채 
		IF RAND:2 == 0
			PRINTFORMW 눈을 감고 전신을 관통하는 강렬한 쾌락을 받아들였다。
		ELSE
			PRINTFORMW 、전신을 관통하는 쾌락에 몸을 부들부들 떨었다。
		ENDIF
		CFLAG:245 = 4
	;屈服刻印Lv3
	ELSEIF MARK:2 == 3 && (CFLAG:245 < 3 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:245 = 3
	;それ以外
	ELSEIF CFLAG:245 < 2 || FLAG:7 == 2
