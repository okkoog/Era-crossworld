;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	SIF NO:ASSI == Y1
;	CALL EVENTEND_PY1_K[[キャラ:마리카]]
;	RETURN 0
;ENDIF
;--------------------------------------------------
;調教終了時のセリフ
;--------------------------------------------------
DRAWLINE
;屈服刻印Lv1以下
IF MARK:2 <= 1 && (CFLAG:219 < 1 || FLAG:7 == 2)
	PRINTFORMW 「‥‥볼 일은 끝났나？　그럼、어서 사라져주실까？　얼굴 보고 있어봤자 기분만 나쁘니까」
	PRINTFORMW %CALLNAME은%、내뱉듯이 그렇게 말하고 입을 다물었다。
	CFLAG:219 = 1
ELSEIF CFLAG:201 == 0
	PRINTW   당신은 살해당했다
	PRINTW   ＧＡＭＥ　ＯＶＥＲ
	JUMP GAME_OVER
;屈服刻印Lv2
ELSEIF MARK:2 == 2
	PRINTFORMW 「이제야 끝？　‥‥이런 쓸데없는 끈기가 있다면、좀 더 나은 일에 쓰는게 어떨까？」
	PRINTFORMW %CALLNAME은% 피곤한듯 한숨을 내쉬며、옷을 모으기 시작했다
	PRINTFORMW (‥‥과연 팬텀의 에이전트。　도망갈 틈이 좀처럼 없구나‥‥)
	PRINTFORMW (‥‥도움 따위는 올 리가 없어。　죽어서 시체를 치우는 물건이 없다니 말야。　하아‥‥)
	CFLAG:219 = 2
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW 「이제야 끝？　‥‥저기、다음은 언제 올꺼야？」
	PRINTFORMW %CALLNAME은% 아양떨듯이 그렇게 물어온다。연기인 구석도 있는 것 같지만‥‥
	PRINTFORMW (‥‥여기에서 보통으로 빠져나가는 것은 무리。그렇다면、어떻게든 이녀석을 농락해서 도망칠 수 밖에 없어)
	PRINTFORMW (그걸 위한 유혹일 뿐。　‥‥단지 그것 뿐‥‥)
	CFLAG:219 = 3
;陥落済み＋体力500未満
ELSEIF BASE:0 < 500 && (CFLAG:218 < 1 || FLAG:7 == 2)
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		PRINTFORMW 조교의 종료를 전해들은 %CALLNAME은%、한숨을 내쉬며 침대에 몸을 던졌다。
		PRINTFORMW 「%CSTR:이인칭%、정말、터프하네‥‥%CSTR:일인칭%도 체력에는 자신있는 편이었는데‥‥」
		IF RAND:3 == 0
			PRINTFORMW 「‥‥사실은 천천히 차라도 한잔하자고 말하고 싶지만、이미 한계야。미안하지만 좀 쉬게 해 줘‥‥」
			PRINTFORMW %CALLNAME은% 힘이 다한 듯 침대에 엎드렸다。
		ELSEIF RAND:2 == 0
			PRINTFORMW 「‥‥다른 여자애들은 이렇게 터프하지 않지？　부숴지지 않을 정도로 가감해 주라구요？」
			PRINTFORMW 방에서 떠나는 %CALLNAME:MASTER%의 등에、%CALLNAME은% 그렇게 말하고 한숨을 내쉬었다。
		ELSE
			PRINTFORMW 「‥‥아～질척질척하잖아。　이제‥‥자기전에 샤워정도는 해야지‥‥」
			PRINTFORMW %CALLNAME은% 힘들게 몸을 일으켰다。
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		IF RAND:2 == 0
			PRINTFORMW 「아무리 그래도 너무 지나친거 아니야？　정말、이런 게 계속된다면 부서져버릴거야‥‥」
		ELSE
			PRINTFORMW 「하아아！　지쳤어～。　%CSTR:이인칭%、바닥이 없는 거 아냐‥‥？」
		ENDIF
		PRINTFORMW 피로의 기색이 짙은 얼굴로、늘어지면서도、%CALLNAME%의 얼굴에는 만족스러운 분위기가 있다。
		PRINTFORMW 「‥‥그래도、덕분에 오늘은 푹 잘 수 있을 것 같아.　최근 %CSTR:일인칭%、언제나 몸이 쑤셔버려서、말야」
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORMW 
	ENDIF
	CFLAG:218 = 1
;陥落済み
ELSEIF CFLAG:219 < 4 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		PRINTFORMW 「오늘 용무는 벌써 끝？」
		IF TIME == 0 || TIME == 1
			PRINTFORMW 「자아、그럼。 샤워 정도는 하고 가면？　물론、%CSTR:일인칭%도 사용하지만」
			PRINTFORMW 조금、수줍음이 담긴 미소로、%NAME:MASTER%에게 권유하는 %CALLNAME%。
			PRINTFORMW 같이 샤워를 하거나 하면、2회전이 시작될 수도 있으니。　여기는 사양하기로 하자。
		ELSEIF TIME == 2
			PRINTFORMW 「어라？　가버리는거야。　조금만 기다려주면、차랑 먹을 것 내올게？」
			PRINTFORMW 조금、수줍음이 담긴 미소로、%NAME:MASTER%에게 권유하는 %CALLNAME%。
			PRINTFORMW 그러나、여기에서 빈둥거리고 있을 수 는 없을 것이다。
		ELSE
			PRINTFORMW 「어라？　가버리는거야。　마침 그럴 시간이고、여기서 자고가도 좋다고？」
			PRINTFORMW 조금、수줍음이 담긴 미소로、%NAME:MASTER%에게 권유하는 %CALLNAME%。
			PRINTFORMW 그러나、이곳에서 자버리면 아마 충분한 휴식을 취할 수는 없을 것이다。
		ENDIF
		PRINTFORMW 「‥‥그래、그럼、또 와줘。　그리고、위험한 일을 할 생각이면、잊지 말고 나도 데려가줘」
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		IF RAND:2 == 0
			PRINTFORML 「으～응 그래、기분이 좋았어」
			PRINTFORML %CALLNAME은% 침대에서 몸을 일으켜、콜라를 가져왔다。　그리고 %CALLNAME:MASTER%에게도 던져준다。
			PRINTFORML 「‥‥응、조금 부족할까。　사람의 몸을 이렇게 했으니、책임지고 사귀어라」
		ELSE
			PRINTFORML 「에에～。　벌써 끝이야？　아직 시간 남아있지？」
			PRINTFORML %CALLNAME은% 불만스러운 듯 코웃음을 쳤다。
			PRINTFORML 「하아‥‥알았어。　오늘은 여기까지！　그러면、다음에는 조금만 더 힘내자」
		ENDIF
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		PRINTFORMW 
	ENDIF
	CFLAG:219 = 4
ENDIF
RETURN 0

