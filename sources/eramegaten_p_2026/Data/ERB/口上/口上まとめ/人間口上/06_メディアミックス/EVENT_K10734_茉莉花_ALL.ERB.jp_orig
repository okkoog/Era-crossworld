;=================================================
;奉仕系コマンド
;=================================================
;-------------------------------------------------
;80,수음
;-------------------------------------------------
	CASE 80
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:344 == 0
			IF TALENT:3 || TALENT:6
				PRINTFORML 
				PRINTFORMW 
			ELSE
				PRINTFORML 「手でそれを握って……？　いやよ、誰がそんな……っ」
				PRINTFORML ふん、と鼻を鳴らしてかを背ける%CALLNAME:TARGET%に、怒張を無理やり押し付けた。
				PRINTFORML 「こっの……っ！　握りつぶしてやろうかしら、こんな物！」
				PRINTFORML %CALLNAME:TARGET%は怒りの声を上げるが、その腕をつかんで強引に動かさせる。
				PRINTFORML 「痛っ！　くぅ、……やればいいんでしょ！　腕放しなさいよ！」
				PRINTFORMW （うぅ……。　こういう訓練受けてないのよね……。　気持ち悪い……）
			ENDIF
			CFLAG:344 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:344 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORML 「手先の器用さには自信あるのよ？　……ほら、こんな感じでしょ？」
					IF ABL:TARGET:기교 > 3
						PRINTFORML 大きな口をきくだけあって、%CALLNAME:TARGET%は大胆に手を動かしながらも、指先は別の生き物のように繊細に亀頭に刺激を与える。
						PRINTFORMW 「ほら、熱くなってきた。　どう、なかなかの物でしょう？」
					ELSE
						PRINTFORML 丁寧な手の動かし方は愛情を感じさせるが、少し丁寧すぎて刺激が物足りない……
						PRINTFORMW 「あれ？　あれ？　おかしいなぁ……こんな筈じゃないんだけど……」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORML 「ふーん、手ですればいいのね？　見てなさい、すぐに元気にしてあげるから」
					IF ABL:TARGET:기교 > 3
						PRINTFORML 大きな口をきくだけあって、%CALLNAME:TARGET%は大胆に手を動かしながらも、指先は別の生き物のように繊細に亀頭に刺激を与える。
						PRINTFORMW 「どう？　こんな感じでしょ？　満足したら、そろそろ私の方を満足させてよ？」
					ELSE
						PRINTFORML 丁寧な手の動かし方は愛情を感じさせるが、少し丁寧すぎて刺激が物足りない……
						PRINTFORMW 「うーん、いまいち上手く……。　私、奉仕とか向いてないのかな？　奉仕とかされる方が好みっていうか……」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ENDIF
				CFLAG:344 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:344 < 3 || FLAG:7 == 2)
				PRINTFORMW 「へたくそ、ですって？　%CSTR:이인칭%のモノの方がやくたたずなんでしょ！？」
				CFLAG:344 = 3
			;それ以外
			ELSEIF CFLAG:344 < 2 || FLAG:7 == 2
				PRINTFORMW 「また……？ もう、うんざり。　自分で勝手にやってればいいでしょ……」
				CFLAG:344 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;81,펠라치오
;-------------------------------------------------
	CASE 81
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:345 == 0
			IF TALENT:3 || TALENT:6
				PRINTFORML 「え？　口でそれを？　そ、それは流石に……」
				PRINTFORML ……%CALLNAME:TARGET%は難色を示すが、色々説得を繰り返すとやがて……
				PRINTFORML 「うぅ……、そこまで言うなら。　しょうがないなぁ、もう……」
				PRINTFORMW %CALLNAME:TARGET%は眉を顰めながら、恐る恐る隆起した肉棒に唇で触れ、その先端を咥え込み始めた。
			ELSE
				PRINTFORML 「……ふん、食いちぎられたいみたいね。　だったらお望みどおりにしてやるわ」
				PRINTFORML ……%CALLNAME:TARGET%は本当にやりかねない。
				PRINTFORML 今回は仕方がない。　強引に口を開かせて、顎をしっかりと押さえる。
				PRINTFORMW 言葉も出せず唸り声をあげる%CALLNAME:TARGET%の口に肉棒を入れ、やっと%CALLNAME:TARGET%の口を犯すことが出来た。
			ENDIF
			CFLAG:345 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:345 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORML 「また口でしてほしいって？　もう……そんなに気に入ったの？　じゃあしょうがないかな……」
					PRINTFORML ……%CALLNAME:TARGET%はそういって、%CALLNAME:MASTER%の肉棒を咥え込んだ。
					PRINTFORMW そのまま上目使いに反応を窺いつつ、舌を動かしていく……
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORML 「口でイかせてほしいって？　良いわよ、忍びのテクニック、みせてあげるわ」
					PRINTFORMW ……%CALLNAME:TARGET%はそういって、%CALLNAME:MASTER%の肉棒を咥え込み、知り得るテクニックで責め立ててくる……
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ENDIF
				CFLAG:345 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:345 < 3 || FLAG:7 == 2)
				PRINTFORML 「んんっ……！ んっ……ぷぅ……。　はぁ、何よ、これでいいんでしょう！？」
				PRINTFORMW %CALLNAME:TARGET%は嫌々といった感は抜けない物の、一応は指示に従い、舌を使い始めた……
				CFLAG:345 = 3
			;それ以外
			ELSEIF CFLAG:345 < 2 || FLAG:7 == 2
				PRINTFORML 「えっ……また口で＿　って……ん、うぅ……ん……」
				PRINTFORML 眉を顰める%CALLNAME:TARGET%の口に強引に肉棒を突っ込む。
				PRINTFORMW 目を白黒させてむせる%CALLNAME:TARGET%には舌で奉仕する余裕はなさそうだ。
				CFLAG:345 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;82,파이즈리
;-------------------------------------------------
	CASE 82
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:346 == 0
			IF TALENT:3 || TALENT:6
				PRINTFORML 「はぁ？　おっぱいでって……なにそれ、どういう事？」
				PRINTFORML 何を言っているのか分からないという具合に聞き返す%CALLNAME:TARGET%に丁寧に説明をしてやる。
				PRINTFORML 「ふーん、成程。　そう言うのもあるのね。　いいよ、こんな感じかな……？」
				PRINTFORMW %CALLNAME:TARGET%はたわわな胸で肉棒を挟み、動かし始めた。
			ELSE
				PRINTFORML 「はぁ？　胸でって……馬鹿言わないで、私の胸はそんな事のためにあるんじゃない！」
				PRINTFORML ……%CALLNAME:TARGET%は怒っているが、それを気にする理由はない。
				PRINTFORML 腕をつかんで押さえつけ、たわわに実った胸の谷間に肉棒を挟む。
				PRINTFORMW 痛みと嫌悪で顔を背ける%CALLNAME:TARGET%の胸を勝手に使わせてもらった。
			ENDIF
			CFLAG:346 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:346 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORML 「またおっぱい？　まぁ、割と自慢できるかなって思ってるし、しょうがないかな？」
					PRINTFORML ……%CALLNAME:TARGET%はそういって、%CALLNAME:MASTER%の肉棒を胸の谷間に挟んだ。
					PRINTFORMW そのまま上目使いに反応を窺いつつ、上下左右に刺激を加えている。
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORML 「胸でイかせてほしいって？　私の胸がそんなに気に入った？　ふふ……こんな感じでしょ？」
					PRINTFORMW ……%CALLNAME:TARGET%はそういって、%CALLNAME:MASTER%の肉棒を胸で挟み、知り得るテクニックで責め立ててくる……
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 
				ENDIF
				CFLAG:346 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:346 < 3 || FLAG:7 == 2)
				PRINTFORML 「……はぁ、何よ、これでいいんでしょう！？　ん、もう……」
				PRINTFORMW %CALLNAME:TARGET%は嫌々といった感は抜けない物の、肉棒を挟んだ胸を両手で支えて奉仕を始めた。
				CFLAG:346 = 3
			;それ以外
			ELSEIF CFLAG:346 < 2 || FLAG:7 == 2
				PRINTFORML 「えっ……また胸を使わせろって……ちょ、やだって……」
				PRINTFORML 嫌がる%CALLNAME:TARGET%の胸の谷間に、強引に肉棒を押し込む。
				PRINTFORMW 自発的な奉仕はまだ望めそうにないので、こちらで%CALLNAME:TARGET%の胸に肉棒を擦りつけ始めた。。
				CFLAG:346 = 2
			ENDIF
		ENDIF

