;-------------------------------------------------
;〇メモ
;-------------------------------------------------
;ナビ口上
;デモニカオペレーター（賢そうな女性）
;デモニカスーツに習熟しているし、「シュバルツバース調査隊」ってエリートの集いだろうしプログラムやレーダーや使いこなせるはず。賢そうだし
;というか賢そうなお姉さん戦闘員はオペレーターも出来ると古今東西決まってるのでスマートに出来ます
;
;イメージとしてはミスは少なく数字を信頼しているタイプであまり感情を出さない系だが鉄面皮でもなくぶっちゃける時はぶっちゃける感じで…
;-------------------------------------------------

;=========================================
;ナビ口上の存在確認
;この関数が設定されていないと口上が存在しない扱いになる
;=========================================
@IS_EXIST_KOJO_BATTLE_NAVI_K[[キャラ:데모니카오퍼레이터]], ARG
RETURN 1

;=========================================
;以下ナビ口上、京都じゃない方の双葉はんから拝借した古代ちゃん口上から拝借、本当に申し訳ない
;造魔口上（虚心系造魔口上）からも拝借させていただきました
;
;TSTR:네비_시추에이션_메인		主に呼び出しタイミングを定義(戦闘開始/メイン画面/戦闘終了)
;TSTR:네비_시추에이션_서버1		状況を定義
;TSTR:네비_시추에이션_서버2		状況の補足オプション
;=========================================
@KOJO_BATTLE_NAVI_K[[キャラ:데모니카오퍼레이터]], ARG
;右のような指定も可能→SETCOLOR 0xA0A0A0
;色見本に#ABCDEFというような書き方がされていた場合は、こちらの書き方(SETCOLOR 0xABCDEF)を使うと良い
;水色
;SETCOLOR 0x33ffcc
;LOCALS = {ARG:1}
;独自定義
#DIM 方位
#DIM 距離
#DIM MAXハーモナイザー出力
#DIM 現在ハーモナイザー出力
#DIM ハーモナイザー出力％
#DIM 撃破数
#DIM 戦闘終了rand値
現在ハーモナイザー出力 = GET_ハーモナイザー出力()
IF MAXハーモナイザー出力 == 0
	;戦闘終了時に0になるので戦闘開始時にのみ代入される想定
	MAXハーモナイザー出力 = GET_ハーモナイザー出力()
ENDIF
SELECTCASE TSTR:네비_시추에이션_메인
	CASE "戦闘開始"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "통상"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "格下"
						IF TFLAG:적초기배치수 >= 1 && TFLAG:적초기배치수 <= 3
							; 敵1~3体
							BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体。
							BTL_KOJO_RESULTS:1 = データ上では負ける要素がありません。各個撃破してください
						ELSEIF TFLAG:적초기배치수 >= 4 && TFLAG:적초기배치수 <= 6
							; 敵4~6体
							BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体を確認。
							BTL_KOJO_RESULTS:1 = 戦力比較全く問題ありません。無力化をお願いします
						ELSEIF TFLAG:적초기배치수 >= 7 && TFLAG:적초기배치수 <= 9
							; 敵7~9体
							BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体です。
							BTL_KOJO_RESULTS:1 = 格下ですが数が多いです。足を掬われぬ様注意してください
						ELSE
							; 敵10体
							BTL_KOJO_RESULTS:0 = 敵反応多数確認。
							BTL_KOJO_RESULTS:1 = 敵の戦力値は低いので範囲攻撃による殲滅も考慮してください
						ENDIF
					CASE "同格"
						IF TFLAG:적초기배치수 >= 1 && TFLAG:적초기배치수 <= 3
							; 敵1~3体
							BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体。
							BTL_KOJO_RESULTS:1 = このパーティならば問題はないかと
						ELSEIF TFLAG:적초기배치수 >= 4 && TFLAG:적초기배치수 <= 6
							; 敵4~6体
							BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体補足。
							BTL_KOJO_RESULTS:1 = 数値上の戦力値はほぼ同等。念の為注意してください
						ELSEIF TFLAG:적초기배치수 >= 7 && TFLAG:적초기배치수 <= 9
							; 敵7~9体
							BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体を確認。
							BTL_KOJO_RESULTS:1 = まずは数を減らすことを推奨します
						ELSE
							; 敵10体
							BTL_KOJO_RESULTS:0 = 敵反応多数確認。
							BTL_KOJO_RESULTS:1 = 戦力比較で負けています。逃走も視野に入れてはどうでしょう？
						ENDIF
					CASE "格上"
						; 格上の場合はボスを考慮
						IF TFLAG:보스플래그있음
							IF FLAG:도주불가플래그
								; ボスでかつ逃走不可
								IF TFLAG:적초기배치수 == 1
									; 敵1体
									BTL_KOJO_RESULTS:0 = 敵は通常の戦力分析では測りきれない強い力を持っているようです
									BTL_KOJO_RESULTS:1 = 数をいかして全力の連携を叩き込むことを推奨します
								ELSEIF TFLAG:적초기배치수 >= 2 && TFLAG:적초기배치수 <= 3
									; 敵2~3体
									BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体。
									BTL_KOJO_RESULTS:1 = 相当の強敵です。数を減らすことを考えましょう
								ELSEIF TFLAG:적초기배치수 >= 4 && TFLAG:적초기배치수 <= 6
									; 敵4~6体
									BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体！
									BTL_KOJO_RESULTS:1 = 戦力比較ではこちらが不利。慎重に戦術を探りましょう
								ELSEIF TFLAG:적초기배치수 >= 7 && TFLAG:적초기배치수 <= 9
									; 敵7~9体
									BTL_KOJO_RESULTS:0 = 敵合計…{TFLAG:적초기배치수}体です。
									BTL_KOJO_RESULTS:1 = 余力を残さず全力で最大火力を叩き込みましょう
								ELSE
									; 敵10体
									BTL_KOJO_RESULTS:0 = 強敵反応多数…
									BTL_KOJO_RESULTS:1 = こちらの数が減ってはますます不利です。隊員の体力に注意してください
								ENDIF
							ELSE
								; ボスでかつ逃走可（そんな事ありえるのかしら）
								IF TFLAG:적초기배치수 == 1
									; 敵1体
									BTL_KOJO_RESULTS:0 = 敵は相当の強敵のようです
									BTL_KOJO_RESULTS:1 = 壊滅的な被害を被る前に撤退も視野に入れてください
								ELSEIF TFLAG:적초기배치수 >= 2 && TFLAG:적초기배치수 <= 3
									; 敵2~3体
									BTL_KOJO_RESULTS:0 = 敵は{TFLAG:적초기배치수}体です
									BTL_KOJO_RESULTS:1 = 念の為逃走経路を確保します
								ELSEIF TFLAG:적초기배치수 >= 4 && TFLAG:적초기배치수 <= 6
									; 敵4~6体
									BTL_KOJO_RESULTS:0 = 強敵の反応が{TFLAG:적초기배치수}体。
									BTL_KOJO_RESULTS:1 = 念の為ですが、逃走経路を解析は完了済です
								ELSE
									; 敵7～10体
									BTL_KOJO_RESULTS:0 = 強敵反応複数確認。
									BTL_KOJO_RESULTS:1 = 本当に今戦う必要あります？
								ENDIF
							ENDIF
						ELSE
							IF FLAG:도주불가플래그
								; ボスでないが逃走不可
								IF TFLAG:적초기배치수 >= 1 && TFLAG:적초기배치수 <= 3
									; 敵1~3体
									BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体を確認
									BTL_KOJO_RESULTS:1 = 強敵ですが逃走ルート確保できません…多少の被害は覚悟するしかなさそうです
								ELSEIF TFLAG:적초기배치수 >= 4 && TFLAG:적초기배치수 <= 6
									; 敵4~6体
									BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体…
									BTL_KOJO_RESULTS:1 = すみません、完全に敵にマークされてます。逃走は難しいと思います…
								ELSEIF TFLAG:적초기배치수 >= 7 && TFLAG:적초기배치수 <= 9
									; 敵7~9体
									BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体！
									BTL_KOJO_RESULTS:1 = 敵は連携して逃げ道を塞いでいます…強敵ですし、全力で迎撃を。
								ELSE
									; 敵10体
									BTL_KOJO_RESULTS:0 = 強敵反応多数…
									BTL_KOJO_RESULTS:1 = 完全に囲まれています。総員全力で迎撃を！
								ENDIF
							ELSE
								; ボスでないが逃走可（ただの格上の敵）
								IF TFLAG:적초기배치수 >= 1 && TFLAG:적초기배치수 <= 3
									; 敵1~3体
									BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体、強敵です。
									BTL_KOJO_RESULTS:1 = 節約を考慮すると逆に損害が大きくなりそうですね
								ELSEIF TFLAG:적초기배치수 >= 4 && TFLAG:적초기배치수 <= 6
									; 敵4~6体
									BTL_KOJO_RESULTS:0 = 強敵{TFLAG:적초기배치수}体です
									BTL_KOJO_RESULTS:1 = 戦力比較ではこちらが負けています…戦うならば多少の被害は覚悟するしかなさそうです
								ELSEIF TFLAG:적초기배치수 >= 7 && TFLAG:적초기배치수 <= 9
									; 敵7~9体
									BTL_KOJO_RESULTS:0 = 強敵反応{TFLAG:적초기배치수}。
									BTL_KOJO_RESULTS:1 = 現在の我々の戦力では早すぎたかも知れませんね…撤退も視野にいれるべきかと
								ELSE
									; 敵10体
									BTL_KOJO_RESULTS:0 = 強敵反応多数。
									BTL_KOJO_RESULTS:1 = 即時撤退を推奨します。全滅する前に帰りましょうよ
								ENDIF
							ENDIF
						ENDIF
				ENDSELECT
			CASE "先制攻撃"
				IF SOFT_ON("Mr.サプライズ")
					方位 = RAND:11 + 1
					SELECTCASE TSTR:네비_시추에이션_서버2
						CASE "格下"
							距離 = RAND:20 + 30
							BTL_KOJO_RESULTS:0 = Mr.サプライズアラート。{方位}時方向、距離は{距離}。
							BTL_KOJO_RESULTS:1 = 油断しきってる敵を感知しました。お好きなように
						CASE "同格"
							距離 = RAND:20 + 20
							BTL_KOJO_RESULTS:0 = Mr.サプライズに感あり。{方位}時の方向、距離{距離}。
							BTL_KOJO_RESULTS:1 = 座標転送します。攻撃開始してください
						CASE "格上"
							距離 = RAND:20 + 10
							BTL_KOJO_RESULTS:0 = Mr.サプライズに反応あり！{方位}時、距離{距離}…
							BTL_KOJO_RESULTS:1 = 後方に回り込んで……今です！
					ENDSELECT
				ELSE
					SELECTCASE TSTR:네비_시추에이션_서버2
						; ソフトが無いので距離や方位は測れない
						CASE "格下"
							BTL_KOJO_RESULTS:0 = 敵の反応有り。奇襲可能です。
							BTL_KOJO_RESULTS:1 = がっつりやっちゃってください
						CASE "同格"
							BTL_KOJO_RESULTS:0 = こちらを感知していない敵を発見。
							BTL_KOJO_RESULTS:1 = 背後から攻撃を開始してください
						CASE "格上"
							BTL_KOJO_RESULTS:0 = 敵発見。今なら奇襲できます。
							BTL_KOJO_RESULTS:1 = 即座に行動を！
					ENDSELECT
				ENDIF
			CASE "バックアタック"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "格下"
						BTL_KOJO_RESULTS:0 = 背後から敵襲です！
						BTL_KOJO_RESULTS:1 = 格下ですが策を練っていたようです…ぬかりました。至急迎撃を！
					CASE "同格"
						BTL_KOJO_RESULTS:0 = 敵襲！後ろです！
						BTL_KOJO_RESULTS:1 = 落ち着いて陣形を立て直してください！
					CASE "格上"
						BTL_KOJO_RESULTS:0 = ッ！背後から敵の襲撃です！
						BTL_KOJO_RESULTS:1 = いつの間に…！耐えてください！
				ENDSELECT
			CASE "バックアタック阻止"
				; バックアタックなので4~8時方向になるはず
				方位 = RAND:4 + 4
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "格下"
						距離 = RAND:10 + 20
						BTL_KOJO_RESULTS:0 = 百太郎アラートです。{方位}時の方向、距離は{距離}。
						BTL_KOJO_RESULTS:1 = 後ろからしたり顔でやってきますよ。返り討ちにしてあげましょう
					CASE "同格"
						距離 = RAND:10 + 10
						BTL_KOJO_RESULTS:0 = 百太郎に感あり。{方位}時方向、距離{距離}。
						BTL_KOJO_RESULTS:1 = 後方からやってきます。至急隊列を入れ替えてください
					CASE "格上"
						距離 = RAND:10 + 5
						BTL_KOJO_RESULTS:0 = 百太郎アラート！後方{方位}時、距離{距離}から敵、急速接近！
						BTL_KOJO_RESULTS:1 = 反転１８０度！迎撃準備！
				ENDSELECT
			CASE "不意打ち"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "格下"
						BTL_KOJO_RESULTS:0 = ッ…！敵襲です！
						BTL_KOJO_RESULTS:1 = すみません、私のアラートミスです…戦力値は低いので、耐えてください！
					CASE "同格"
						BTL_KOJO_RESULTS:0 = 敵襲です！
						BTL_KOJO_RESULTS:1 = 前方、敵の攻撃が飛んできます…！陣形を崩さないよう！
					CASE "格上"
						BTL_KOJO_RESULTS:0 = いつの間に…！
						BTL_KOJO_RESULTS:1 = 敵の攻撃です！防御態勢を！
				ENDSELECT
			CASE "不意打ち阻止"
				方位 = RAND:11 + 1
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "格下"
						距離 = RAND:20 + 20
						BTL_KOJO_RESULTS:0 = 百太郎アラート。{方位}時方向、距離は{距離}。
						BTL_KOJO_RESULTS:1 = 突っ込んでくるので引き付けてぶっ叩いてください
					CASE "同格"
						距離 = RAND:20 + 10
						BTL_KOJO_RESULTS:0 = 百太郎反応です。{方位}時の方向、距離{距離}。
						BTL_KOJO_RESULTS:1 = 隠れて攻撃準備を行っているので逆に突撃して敵のアドバンテージを無くしましょう
					CASE "格上"
						距離 = RAND:20 + 5
						BTL_KOJO_RESULTS:0 = 百太郎アラート！{方位}時、距離{距離}！
						BTL_KOJO_RESULTS:1 = …敵も感づいて不意打ちの選択を捨て正面から襲ってくるようです。迎撃を！
				ENDSELECT
		ENDSELECT
	CASE "メイン画面"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "重度の危機"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "半壊"
						IF SOFT_ON("ハーモナイザー") 
							IF FLAG:도주불가플래그
								IF 現在ハーモナイザー出力 == 1
									BTL_KOJO_RESULTS:0 = ハーモナイザー機能不全。
									BTL_KOJO_RESULTS:1 = 強化補正が消えて戦力値が大幅に下がっています！至急、隊員の蘇生を！
								ELSEIF MAXハーモナイザー出力 > 現在ハーモナイザー出力
									ハーモナイザー出力％ = (現在ハーモナイザー出力 * 100) / MAXハーモナイザー出力
									BTL_KOJO_RESULTS:0 = ハーモナイザー出力低下。現在の出力、{ハーモナイザー出力％}％。強化補正値{現在ハーモナイザー出力}％。
									BTL_KOJO_RESULTS:1 = 人間隊員は弱体化してしまっています。至急COMP持ちの隊員の蘇生を！
								ELSE
									BTL_KOJO_RESULTS:0 = 手ひどくやられていますが、ハーモナイザー出力は下がっていません
									BTL_KOJO_RESULTS:1 = 強化補正値{現在ハーモナイザー出力}％。落ち着いて隊を立て直してください！
								ENDIF
							ELSE
								IF 現在ハーモナイザー出力 == 1
									BTL_KOJO_RESULTS:0 = ハーモナイザー機能不全。強化補正が消え戦力値は大幅に減少。
									BTL_KOJO_RESULTS:1 = 危険です。即座に撤退してください！
								ELSEIF MAXハーモナイザー出力 > 現在ハーモナイザー出力
									ハーモナイザー出力％ = (現在ハーモナイザー出力 * 100) / MAXハーモナイザー出力
									BTL_KOJO_RESULTS:0 = ハーモナイザー出力低下。現在の出力{ハーモナイザー出力％}％。強化補正値{現在ハーモナイザー出力}％。
									BTL_KOJO_RESULTS:1 = かなり不利です。撤退を進言します。このままでは全滅も有りえます！
								ELSE
									BTL_KOJO_RESULTS:0 = ハーモナイザー出力低下せず。強化補正値{現在ハーモナイザー出力}％。
									BTL_KOJO_RESULTS:1 = ですが隊は半壊状態です。手遅れになる前に撤退を視野に入れてください
								ENDIF
							ENDIF
						ELSE
							IF FLAG:도주불가플래그
								BTL_KOJO_RESULTS:0 = 死傷者多数！逃走ルートも完全に塞がれています…
								BTL_KOJO_RESULTS:1 = 確実に隊を立て直すか、覚悟を決めて一斉攻撃を！
							ELSE
								BTL_KOJO_RESULTS:0 = 死傷者多数！
								BTL_KOJO_RESULTS:1 = 全滅する前に撤退もご一考ください！
							ENDIF
						ENDIF
					CASE "異常半壊"
						IF SOFT_ON("ハーモナイザー") 
							IF FLAG:도주불가플래그
								IF 現在ハーモナイザー出力 == 1
									BTL_KOJO_RESULTS:0 = ハーモナイザー機能不全。
									BTL_KOJO_RESULTS:1 = 強化補正が消え戦力値が大幅に下がっています！至急、隊の立て直しを！
