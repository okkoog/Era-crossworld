SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:3 == 0
			BTL_KOJO_RESULTS = 우리는 하늘을 누비는 흑기병…… 하늘을 박차고 내려와 적을 친다!
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS = 우리는 하늘을 비상하는 흑기병…… 죽음을 두려워 않고 피로도 느끼지 않는다!
		ELSE
			BTL_KOJO_RESULTS = 우리는 하늘을 비상하는 흑기병…… 임무가 부를 때, 만반의 태세를 갖춘다!
		ENDIF
	CASE 2
		IF RAND:3 == 0
			BTL_KOJO_RESULTS = 설령 탁류 앞의 조약돌이라 할지라도…… 오직 투쟁할 뿐!
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS = 또 신형 페르소나… 악마였나? 어차피 때려부술 뿐이다!
		ELSE
			BTL_KOJO_RESULTS = 검은 독수리가 출현하는 곳, 적은 순식간에 패주한다!
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		;IF BASE:(ARG:1):ＨＰ <= 0
			;IF 陥落(ARG) && RAND:2
			;	BTL_KOJO_RESULTS = 俺の戦果はゼロだ。そうファントムに報告しておけ。
			;ELSE
			;	IF RAND:2
			;		BTL_KOJO_RESULTS = 貴様が奴を撃破したのか？　俺は見ていたぞ！　見事な腕前ではないか！
			;	ELSE
			;		BTL_KOJO_RESULTS = こうも激戦では、誰が奴を倒したか分からないではないか！な？
			;	ENDIF
			;ENDIF
		;弱点をついた。つまりCOOP
		IF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS = 이대로 귀환할 기분이 들 턱이 있나!
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50 || BASE:(ARG:1):ＨＰ <= 0
			IF RAND:2
				BTL_KOJO_RESULTS = Bomben! Bomben!(폭격하라! 폭격하라!)
			ELSE
				BTL_KOJO_RESULTS = 적지로! 적지로! 적지로 폭격하라!
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 20
			IF RAND:2
				BTL_KOJO_RESULTS = 폭격! 폭격! 그리고 급강하!
			ELSE
				BTL_KOJO_RESULTS = 탄환은 아직 남아있다! 추가 폭격이다!
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF RAND:2
				BTL_KOJO_RESULTS = 폭격이 안 먹힌다면 다음은 급강하다!
			ELSE
				BTL_KOJO_RESULTS = 명령이 한 번 떨어지면 그뿐, 우리는 공격을 멈추지 않는다!
			ENDIF
		;無効化された
		ELSEIF ARG:2 == 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS = 시, 시험 공격을 해봤을 뿐이다…… 다음엔 공격을 뚫어주마.
			ELSE
				BTL_KOJO_RESULTS =  Ich bin angepisst!(건방진 녀석……!)
			ENDIF
		;吸収された
		ELSEIF ARG:2 < 0
			IF RAND:2
				BTL_KOJO_RESULTS = Scheise!(빌어먹을!) 몸통 박치기라도 해볼까?
			ELSE
				BTL_KOJO_RESULTS = 내 스스로가 한심하군. 귀를 틀어막고 싶어지는군.
			ENDIF
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS = 팬…텀, 에…… 보복 출격의… 신청을…… 올려, 둬, 라……
			ELSE
				IF RAND:2
