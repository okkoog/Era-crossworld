;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:동기다크서머너]], ARG, ARG:1, ARG:2
;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 3118
	RETURN 0
;VARSET LOCALS

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:6 == 0
			BTL_KOJO_RESULTS:0 = 숨통을 끊는다! 따라붙어!!
		ELSEIF RAND:5 == 0
			BTL_KOJO_RESULTS:0 = 무너뜨렸다! 몰아붙여!
		ELSEIF RAND:4 == 0
			BTL_KOJO_RESULTS:0 = 인간을 얕보지 마라!
		ELSEIF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 흔적도 없이 사라져라!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 찬스 도래!
		ELSE
			BTL_KOJO_RESULTS:0 = 그 빈틈이 치명타다!
		ENDIF
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			IF RAND:6 == 0
				BTL_KOJO_RESULTS:0 = 좋은 판단이다! 엄호하마
			ELSEIF RAND:5 == 0
				BTL_KOJO_RESULTS:0 = 제법이네! 거들어주마
			ELSEIF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 역시나로군! 추격이다!
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 잘했다! 다굴치자!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 찬스 도래! 나머진 맡겨둬!
			ELSE
				BTL_KOJO_RESULTS:0 = 무너졌나? 거기다앗
			ENDIF
		ELSEIF FLAG:행동순1 != -1 && GROUPMATCH(NO:(FLAG:행동순1), [[キャラ:타마모]], [[キャラ:궁기]], [[キャラ:도올]], [[キャラ:도철]])
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 역시 사흉이네. 든든하구만
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 가차없네…… 무지막지한 짓을 해대는구만 사흉 녀석들은……
			ELSE
				BTL_KOJO_RESULTS:0 = 인기 상품 악마였던 이유를 잘 알겠어…… 듬직하네
			ENDIF
		;それ以外
		ELSE
			IF RAND:11 == 0
				BTL_KOJO_RESULTS:0 = 다 함께 끝장내주마!
			ELSEIF RAND:10 == 0
				BTL_KOJO_RESULTS:0 = 강적이라도 다 같이 두들겨 패면 무서울 거 없지
			ELSEIF RAND:9 == 0
				BTL_KOJO_RESULTS:0 = 좋은 흐름이다! 추격한다!
			ELSEIF RAND:8 == 0
				BTL_KOJO_RESULTS:0 = 뒈져라!
			ELSEIF RAND:7 == 0
				BTL_KOJO_RESULTS:0 = 찬스 도래! 나머진 맡겨둬!
			ELSEIF RAND:6 == 0
				BTL_KOJO_RESULTS:0 = 한 방 더!
			ELSEIF RAND:5 == 0
				BTL_KOJO_RESULTS:0 = 제법이네! 거들어주마
			ELSEIF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 제발 다시 일어나지 마라……
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 이 기회를 놓칠 순 없지, 뒈져라!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 하~~~~나, 둘!
			ELSE
				BTL_KOJO_RESULTS:0 = 기회가 돌아왔네, 따라붙는다!
			ENDIF
		ENDIF
	;被召喚時
	CASE 3
		;메이드복
		IF TEQUIP:전신복 == 308
			BTL_KOJO_RESULTS:0 = 메이드 악마를 그렇게 부르고 싶었던 거야?
		;魔法少女服
		ELSEIF TEQUIP:전신복 == 304
			BTL_KOJO_RESULTS:0 = 마법소녀, 등장…… 하아ー…… 한숨밖에 안 나오네……
		;魔法少女服
		ELSEIF TEQUIP:전신속옷 == 715 && TEQUIP:겉옷 == 1002
			BTL_KOJO_RESULTS:0 = 마법소녀, 마법소녀라…… 이제 그런 나이도 아닌데 말이지……
		ELSE
			BTL_KOJO_RESULTS:0 = 이 피도 눈물도 없는 인간!
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF RAND:11 == 0
				BTL_KOJO_RESULTS:0 = 엣, 해치운 거야?
			ELSEIF RAND:10 == 0
				BTL_KOJO_RESULTS:0 = 배, 배제 완료!
			ELSEIF RAND:9 == 0
				BTL_KOJO_RESULTS:0 = 이 감촉은…… 영 익숙해지질 않네……
			ELSEIF RAND:8 == 0
				BTL_KOJO_RESULTS:0 = 조, 좋아! 일단은 합격!
			ELSEIF RAND:7 == 0
				BTL_KOJO_RESULTS:0 = 해, 해치웠나? 해, 해냈다
			ELSEIF RAND:6 == 0
				BTL_KOJO_RESULTS:0 = 밥값은 한 것 같네, 아마도?
			ELSEIF RAND:5 == 0
				BTL_KOJO_RESULTS:0 = 해치우는 것도 익숙해지는 수밖에 없겠지……
			ELSEIF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 죽이지 않았으면 당했을 거야……
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 마음 다잡아야지, 다음이다!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 우욱…… 하아…… 하아……
			ELSE
				BTL_KOJO_RESULTS:0 = 숨통, 제대로 끊은 건가?
			ENDIF
		;攻撃したけど吸収された
		ELSEIF TFLAG:전투이벤트 == 11 && ARG:2 < 0
			IF RAND:5 == 0
				BTL_KOJO_RESULTS:0 = 이런 젠장……
			ELSEIF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 우와아…… 빨려 들어갔어……
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 계속 흡수시키면 터져버리지 않으려나
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 사기 내성 녀석……
			ELSE
				BTL_KOJO_RESULTS:0 = 겍, 팔팔해져 버렸잖아
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 들어갔다!
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 꽤 깎아냈나?
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = 치명상에는 못 미치나
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			BTL_KOJO_RESULTS:0 = 끈질긴 녀석이네
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = 안 먹히는 건가!? 다음 수를 생각해야겠네
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 크악……
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 나머진 부탁한다……
			ELSE
			;恋慕、親愛
				IF TALENT:3 || TALENT:6
					BTL_KOJO_RESULTS:0 = 쓸모도 없는 채로 죽는 건…… 싫은데……
				ELSE
					BTL_KOJO_RESULTS:0 = 으으윽, 아파라……
				ENDIF
				
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 하하하…… 죽을 것 같아……
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 아프지만 아직 버틸 수 있어……
			ELSE
				BTL_KOJO_RESULTS:0 = 헉, 헉…… 이래서…… 싸움 따윈……
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 준비해 둔 보람이 있네.
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = 소용없다!
		ELSE
			;메이드복
			IF TEQUIP:전신복 == 308
				BTL_KOJO_RESULTS:0 = 싸울 때 입는 옷이 아니잖아, 이거……
			ELSE
				IF RAND:11 == 0
					BTL_KOJO_RESULTS:0 = 크아악, 아프잖아!
				ELSEIF RAND:10 == 0
					BTL_KOJO_RESULTS:0 = 큭!
				ELSEIF RAND:9 == 0
					BTL_KOJO_RESULTS:0 = 제기랄! 한 대 먹였겠다!
				ELSEIF RAND:8 == 0
					BTL_KOJO_RESULTS:0 = 이따가 배로 갚아주마
				ELSEIF RAND:7 == 0
					BTL_KOJO_RESULTS:0 = 꽃다운 처녀의 피부에 흠집을 내다니……
				ELSEIF RAND:6 == 0
					BTL_KOJO_RESULTS:0 = 젠장, 방심했어
				ELSEIF RAND:5 == 0
					BTL_KOJO_RESULTS:0 = 꿱!
				ELSEIF RAND:4 == 0
					BTL_KOJO_RESULTS:0 = 아프잖아! 두고 봐라!
				ELSEIF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = 이 자식이……
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 크악…… 꽤 아프네……
				ELSE
					BTL_KOJO_RESULTS:0 = 아야야야……
				ENDIF
			ENDIF
		ENDIF
	;反射された
	CASE 15
			BTL_KOJO_RESULTS:0 = 튕겨 나갔다고!?
	;反射した
	CASE 16
			IF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 앗싸 얼간이 자식! 내 장비를 얕봤겠다?
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 자, 알아서 자폭이나 해주시지
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 그 공격은 헛수고다
			ELSE
				BTL_KOJO_RESULTS:0 = 직격탄인 줄 알았냐? 반사다!
			ENDIF
	;回避された
	CASE 17
				IF RAND:7 == 0
					BTL_KOJO_RESULTS:0 = 빠르네……
				ELSEIF RAND:6 == 0
					BTL_KOJO_RESULTS:0 = 뭐야 저런 회피법은……
				ELSEIF RAND:5 == 0
					BTL_KOJO_RESULTS:0 = 우와, 빗나갔다, 미안
				ELSEIF RAND:4 == 0
					BTL_KOJO_RESULTS:0 = 거짓말이지…… 빗맞았어?
				ELSEIF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = 스쿠카쟈나 스쿤다가 간절한 타이밍이네……
