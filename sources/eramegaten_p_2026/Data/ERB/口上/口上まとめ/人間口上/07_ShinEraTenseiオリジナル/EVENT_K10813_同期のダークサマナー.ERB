;=========================================
;以下ナビ口上、京都じゃない方の双葉はんから拝借した古代ちゃん口上から拝借、本当に申し訳ない
;
;TSTR:네비_시추에이션_메인		主に呼び出しタイミングを定義(戦闘開始/メイン画面/戦闘終了)
;TSTR:네비_시추에이션_서버1		状況を定義
;TSTR:네비_시추에이션_서버2		状況の補足オプション
;=========================================
@KOJO_BATTLE_NAVI_K[[キャラ:동기다크서머너]], ARG
SELECTCASE TSTR:네비_시추에이션_메인
	CASE "戦闘開始"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "통상"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "格下"
						IF TFLAG:적초기배치수 == 4
							BTL_KOJO_RESULTS:0 =  4체나 온다、송사리지만 방심하지 마
						ELSEIF TFLAG:적초기배치수 == 3
							BTL_KOJO_RESULTS:0 =  3체가 온다、잘 처리해
						ELSEIF TFLAG:적초기배치수 == 2
							BTL_KOJO_RESULTS:0 =  송사리가 2체야、순살시켜 버리자
						ELSEIF TFLAG:적초기배치수 == 1
							BTL_KOJO_RESULTS:0 =  송사리가 1체야、뭔가 함정인 걸까？
						ELSE
							BTL_KOJO_RESULTS:0 =  다수의 반응！　송사리들이지만、이만큼 있으면 귀찮다구……
						ENDIF	
					CASE "同格"
						IF ARG:1 == 2
							BTL_KOJO_RESULTS:0 =  2체、엇비슷한 실력의 녀석들이다、지지 마？
						ELSEIF ARG:1 == 1
							BTL_KOJO_RESULTS:0 =  적은 1체、수로는 이쪽이 이기고 있어、할 수 있어！
						ELSE
							BTL_KOJO_RESULTS:0 =  그런대로 수를 모아 왔군、밀리지 마！
						ENDIF
					CASE "格上"
						IF ARG:1 == 1
							BTL_KOJO_RESULTS:0 =  쿠읏、상당한 강적이네！ 각오 단단히 해라……
						ELSE
							BTL_KOJO_RESULTS:0 =  안 좋은데、흉악한 손님이 찾아온 모양이야、철수도 고려하면서 행동해……
						ENDIF
				ENDSELECT
			CASE "先制攻撃"
				IF RAND:3 == 0
					BTL_KOJO_RESULTS:0 =  찬스야！　멍청한 놈들에게 한방 먹여 주자
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 =  좋아、선수를 잡았네！　해치워버려
				ELSE
					BTL_KOJO_RESULTS:0 = 운이 트였군！　속공으로 죽여라
				ENDIF
			CASE "バックアタック"
				BTL_KOJO_RESULTS:0 =  미안！　뒤에서 와버렸다！　조심해！
			CASE "バックアタック阻止"
				BTL_KOJO_RESULTS:0 =  하쿠타로가 있었나！　다행이야！
			CASE "不意打ち"
				BTL_KOJO_RESULTS:0 =  미안！　기습이다！　태세를 재정비해 줘！
			CASE "不意打ち阻止"
				BTL_KOJO_RESULTS:0 =  하쿠타로가 있었나！　살았다……
		ENDSELECT
	CASE "メイン画面"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "重度の危機"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "死亡者多数"
						IF FLAG:도주불가플래그
							BTL_KOJO_RESULTS:0 =  또 당했나？
							BTL_KOJO_RESULTS:1 =  도주는、무리인가……너무 무모하게 굴었군……
						ELSE
							BTL_KOJO_RESULTS:0 =  이거 위험하군
							BTL_KOJO_RESULTS:1 =  바로 도주루트를 구축할게、도망쳐！
						ENDIF
					CASE "マスター瀕死"
						IF RAND:2 == 0
