							ELSE
								BTL_KOJO_RESULTS:0 =  일단은、도망치는 게 좋다고 생각해
							ENDIF
						ENDIF
				ENDSELECT
			CASE "中度の危機"
				SELECTCASE TSTR:네비_시추에이션_서버2
