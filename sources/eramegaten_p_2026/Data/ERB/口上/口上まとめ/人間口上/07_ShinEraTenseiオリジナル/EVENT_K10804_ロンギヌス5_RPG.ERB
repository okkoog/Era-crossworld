@KOJO_BATTLE_EVENT_K[[キャラ:롱기누스５_소문]], ARG, ARG:1, ARG:2
;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 4032
	RETURN 0
VARSET LOCALS

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
	LOCALS:10 = Krieg!(전쟁!) Krieg!(전~쟁!!)!! Krieg!!!(전-쟁!!!)
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
	LOCALS:10 = 총통의 적은 Es ist Vernichtung!!(섬멸이다아!!)
		;それ以外
		ELSE
	LOCALS:10 = 원호 개시합니다!
		ENDIF
	;被召喚時
	CASE 3
			LOCALS:10 = 
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
	LOCALS:10 = 남은 적도 섬멸이다아!
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				LOCALS:10 = 
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
	LOCALS:10 = (Ein Schlag des Herzens!) 회심의 일격!
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
	LOCALS:10 = 쾅-!
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
	LOCALS:10 = 제대로 안 박혔나?
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
	LOCALS:10 = 무효화라고오! 총통, 다른 방법으로 죽여버립시다!
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
	LOCALS:10 = 아직 총통께 도움이…… 되…지… 못……했…어…
			
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
	LOCALS:10 = 이걸로 이긴 줄 알았더냐아!?
		;無効
		ELSEIF ARG:2 == 0
	LOCALS:10 = 그런 공격으로 이길 셈입니까?
		;吸収
		ELSEIF ARG:2 < 0
	LOCALS:10 = 연료 보급 수고하셨습니~다아!
		ENDIF
	;反射された
	CASE 15
	LOCALS:10 = 뭣…이라고…!
	;反射した
	CASE 16
	LOCALS:10 = 어리석은 자로군~요!
	;回避された
	CASE 17
	LOCALS:10 = 빠르다…!
	;回避した
	CASE 18
	LOCALS:10 = 느리군요오!
	;反撃スキル発動した
	CASE 20
	LOCALS:10 = 아하아……
	;バトルに勝利した
	CASE 90
	LOCALS:10 = Sieg Reich!(제국에 승리를!)
	;レベルアップした
	CASE 91
	LOCALS:10 = Bravo!(브라보!)
	;逃走に成功した
	CASE 92
	LOCALS:10 = 철수전이다아!
	;逃走に失敗した
	CASE 93
	LOCALS:10 = Wollen Sie mehr Krieg?(더 많은 전쟁을 바라는가?)
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
	LOCALS:10 = 굴욕의 극치다…
		ELSE
			LOCALS:10 = 
		ENDIF
	;バックアタックを受けた
	CASE 95
		IF 現HP割合(ARG) < 25
			;瀕死
	LOCALS:10 = 기름때 같은 끈질김이다아…
		ELSE
	LOCALS:10 = 기습이라고오!
		ENDIF
	;敵の先制攻撃を受けた
	CASE 96
		IF 現HP割合(ARG) < 25
			;瀕死
	LOCALS:10 = 그아아아아!?
		ELSE
	LOCALS:10 = 누아아아아!?
		ENDIF
	;先制攻撃に成功
	CASE 97
	LOCALS:10 = 전격전이 정말 좋다아!
ENDSELECT
SIF !(LOCALS:10 == "")
	CALL MESSAGE_B2(CALLNAME:ARG,0, LOCALS:10, LOCALS:11, LOCALS:12, LOCALS:13, LOCALS:14)

