;-------------------------------------------------
;デンゲキコ口上
;現時点では戦闘口上のみ。 調教口上もやりたいっちゃやりたい…が、ただでさえ厄ネタとも言えるキャラなので
;迂闊に作ると目が付けられそうで怖いという思いがあるので一旦保留。
;-------------------------------------------------
;-------------------------------------------------
;汎用口上の作成に使用する場合は、7000→キャラ番号ではなく、
;K[[キャラ:덴게키코]]→PUB会話タイプ番号　へと変換してご使用ください
;-------------------------------------------------
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;
;	Module		:EVENT_K[[キャラ:덴게키코]]_ASSI.ERB
;	Facility	:会話タイプ：助手時口上
;
;	Modification Data:
;	Edit	Date			Author					Reason
;	001		2022/02/15		しゃけ					新規作成
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;ライセンスについて
;	・基本項目(許可する項目を"○"に、許可しない項目を"×"に変更してください。)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1| ○ | 処理上のバグ修正              |
;	+----+----+-------------------------------+
;	|   2| ○ | 口上の誤字・脱字の修正        |
;	+----+----+-------------------------------+
;	|   3| ○ | 口上まとめへの収録            |
;	+----+----+-------------------------------+
;	|   4| ○ | 口上の新規追加                |
;	+----+----+-------------------------------+
;	|   5| ○ | 既存口上の改変                |
;	+----+----+-------------------------------+
;	|   6| △ | 改変した口上の自由な再配布    | ;少なくとも表に目が付く所での再配布は禁止
;	+----+----+-------------------------------+
;	|   7| × | 口上内容の転載                |
;	+----+----+-------------------------------+

@BATTLE_EVENT_K[[キャラ:덴게키코]], ARG, ARG:1, ARG:2
;■台詞の行数を増やしたいときは
;			LOCALS:10 = 一行目
;			LOCALS:11 = 二行目
;			LOCALS:12 = 三行目
;			LOCALS:13 = 四行目
;			LOCALS:14 = 五行目
;と増やしていく
SIF ARG < 0 && NO:ARG != 7000
	RETURN 0
VARSET LOCALS

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		SELECTCASE RAND:3
			CASE 0
				LOCALS:10 = よっしゃー！ ぼっこぼこタイムですよ、皆さん！
			CASE 1
				LOCALS:10 = クライマックスのお時間ですよー！
			CASE 2
				LOCALS:10 = 悲しいけどこれ、戦争なんですよね…！
		ENDSELECT
	;COOP参加
	CASE 2
		IF FLAG:행동순1 != -1
			IF FLAG:행동순1 == MASTER
				;主人がCOOP発動
				SELECTCASE RAND:3
					CASE 0
						LOCALS:10 = やっちゃいましょう、%CALLNAME:MASTER%さん！
					CASE 1
						LOCALS:10 = さっすが%CALLNAME:MASTER%さん！ 後に続きますよ！
					CASE 2
						LOCALS:10 = あー、帰りた…あっ%CALLNAME:MASTER%さんが転ばせた！？
						LOCALS:11 = サボってる場合じゃねぇ！
				ENDSELECT
			ELSE
				;ここから別キャラ用
				SELECTCASE NO:(FLAG:행동순1)
					CASE [[キャラ:아큐라_X]]
						SELECTCASE RAND:4
							CASE 0
								LOCALS:10 = アキュラさんがやってくれました！ 後に続きますよー！
							CASE 1
								LOCALS:10 = キャーッ、RoRoちゃーんっ！！
								LOCALS:11 = あっ、アキュラさんが転ばせましたね、追撃行きますか。
							CASE 2
								LOCALS:10 = 『白き鋼鉄』に続くは、『電光石火の記者』って訳ですよ！
							CASE 3
								LOCALS:10 = 『銃は剣より強し』であり、『ペンは剣より強し』というらしいので…
								LOCALS:11 = これはもう勝ったもう同然ってことですね！（？）
						ENDSELECT
					CASE [[キャラ:블레이드_X]]
						SELECTCASE RAND:4
							CASE 0
								LOCALS:10 = ブレイドさんの流し斬りが入ったーッ！
								LOCALS:11 = ここからは%CSTR:ARG:일인칭%達の華麗な追撃の時間ですよー！
							CASE 1
								LOCALS:10 = 『双雷の剣斧』のコンビネーション、見せてやりましょう！
								LOCALS:11 = あ、ちなみにネーミングは即席です。
							CASE 2
								LOCALS:10 = あっやっべっ、ブレイドさんがチャンス作ってる！？
								LOCALS:11 = これ逃したら怒られる奴じゃないですか！ 急がなきゃ（使命感）
							CASE 3
								LOCALS:10 = %CSTR:ARG:일인칭%とブレイドさんは１＋１＝２で終わるほど単純なコンビじゃないんだぜー！
								LOCALS:11 = ……すいません、ちょっと調子乗りすぎました。
						ENDSELECT
					CASE [[キャラ:GV]]
						SELECTCASE RAND:4
							CASE 0
								LOCALS:10 = ビリビリの後は袋叩きにされるのが定石なんだぜー！
							CASE 1
								LOCALS:10 = キャーッ、シアンちゃーんっ！！
								LOCALS:11 = あっ、ＧＶさんが崩しましたね、ついでに踏んでおきましょう。
							CASE 2
								LOCALS:10 = 蒼き雷霆《アームドブルー》に続くは電撃の旅団《ﾗｲﾄﾆﾝｸﾞﾌﾞﾘｹﾞｲﾄﾞ》って奴です！
							CASE 3
								LOCALS:10 = やはり『ペンと銃は剣より強し』……あ、そういやＧＶさんのは銃の形してるだけでしたね。
						ENDSELECT
					CASEELSE
						;それ以外
						SELECTCASE RAND:4
							CASE 0
								LOCALS:10 = よし来た！ 追撃はお任せください！
							CASE 1
								LOCALS:10 = 総攻撃じゃーい！
							CASE 2
								LOCALS:10 = うおーっ、ついでに%CSTR:ARG:일인칭%の華麗な蹴り技を喰らえー！
							CASE 3
								LOCALS:10 = やはり暴力…！ 暴力はすべてを解決する…！
						ENDSELECT
				ENDSELECT
			ENDIF
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = よーし、一丁あがり！
				CASE 1
					LOCALS:10 = 取ったどー！
				CASE 2
					LOCALS:10 = よしよし、調子は絶好調ですよ！
				CASE 3
					LOCALS:10 = ふっ、ゲイム記者舐めんなよ？
					LOCALS:11 = …ごめんなさい、ちょっと調子乗ってました…。
			ENDSELECT
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				LOCALS:10 = …が、ダメ！ 画面端で防がれちゃいました！
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			LOCALS:10 = むっ、今の良い一撃じゃありませんでした！？
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			LOCALS:10 = まぁまぁ、こんなもんですよ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			LOCALS:10 = あっれぇ、カス当たりしかしてなくないですか…！？
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			LOCALS:10 = ちょ、なんか効いてないんですけどぉ！？
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = ぐえー！
				CASE 1
					LOCALS:10 = ふ、ふふふ…第一の%CSTR:ARG:일인칭%が死んでも、第二、第三の%CSTR:ARG:일인칭%がいずれ……
					LOCALS:11 = ｶﾞｸｯ…。
				CASE 2
					LOCALS:10 = ふっ……%CSTR:ARG:일인칭%は思い出にはなりませんよ……ぐすん…。
				CASE 3
					;LOCALS:10 = あ＾～、三途の川が見えるんじゃあ＾～……
					LOCALS:10 = あぁ…三途の川が見えますぅ……
					LOCALS:11 = ＊ﾁｰﾝ＊
			ENDSELECT
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = ぐっはぁ！
				CASE 1
					LOCALS:10 = いっだあっ！？ ちょっとぉ！ もう少し手加減してくださいよぉ！？
				CASE 2
					LOCALS:10 = ま、まだまだ、余裕ですし…？（震え声）
					LOCALS:11 = こ、これぐらい、簡単に乗り越えられますし？（震え声）
				CASE 3
					LOCALS:10 = もうやだやだやだ、なんで%CSTR:ARG:일인칭%がこんな目に合わなきゃいけないですかー！？
			ENDSELECT
		;無効
		ELSEIF ARG:2 == 0
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = フッ…。（どやっ）
				CASE 1
					LOCALS:10 = 貫通やガーキルなければこれぐらい余裕ですよ、よゆー！
				CASE 2
					LOCALS:10 = うおーあぶねっ、防具がなければ死んでいたかもしれませんね！
				CASE 3
					LOCALS:10 = うぉん、今の私は無敵ロボの気分ですっ！
			ENDSELECT
		;吸収
		ELSEIF ARG:2 < 0
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = ……プッ。（嘲笑）
				CASE 1
					LOCALS:10 = いやー、ゴチになります！
				CASE 2
					LOCALS:10 = へいへーい、ピッチャーもういっかーい！
				CASE 3
					LOCALS:10 = いやー、もう気分はラノベの最強系主人公ですよ、今の%CSTR:ARG:일인칭%！
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = いてっ。
				CASE 1
					LOCALS:10 = この程度の傷ならへっちゃらですよ、へっちゃら！
				CASE 2
					LOCALS:10 = なんの、これくらい！
				CASE 3
					LOCALS:10 = 弾幕ゲーだと地味に掠り傷で死にかねないんですが……
					LOCALS:11 = まぁここ弾幕ゲーじゃないですし、深く気にしないでいいや。
			ENDSELECT
		ENDIF
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE 13
		;全弾命中した
		IF ARG:2 == 0
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = まとめ狩りには自信があるんですよー！
				CASE 1
					LOCALS:10 = 百発百中とはまさにこの事ですね！
				CASE 2
					LOCALS:10 = その足の遅さを呪うがいいー！
				CASE 3
					LOCALS:10 = まぁ私電撃使いですからね！ これぐらい余裕ですよ、余裕！
			ENDSELECT
		;普通
		ELSEIF ARG:2 < ARG:1
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = まぁこういう日もありますよ！
				CASE 1
					LOCALS:10 = 散らばってると巻き込みにくいんですよねー
				CASE 2
					LOCALS:10 = 次は全部当てますからね！ 絶対ですよ！
				CASE 3
					LOCALS:10 = 今の絶対まぐれですよ、%CSTR:ARG:일인칭%知ってますからね！
			ENDSELECT
		;全弾回避された
		ELSEIF ARG:2 == ARG:1
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = ＊ＦＸで有り金全部溶かした顔＊
				CASE 1
					LOCALS:10 = ふ、ふふ……電撃なのにカス当たりすらしないでやんの……ぐすん…。
				CASE 2
					LOCALS:10 = 逃げるなーッ！ 私の攻撃からっ、逃げるなーッ！！
				CASE 3
					LOCALS:10 = こんなのおかしいですよ！ アレですか、命中率95％なのに外れるっていうアレですか！
			ENDSELECT
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE 14
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = %CSTR:ARG:일인칭%こそ、真の……あー、電撃無双？ なりー！
				CASE 1
					LOCALS:10 = あー、芝刈りみたいで爽快感抜群ですね、これ！
				CASE 2
					LOCALS:10 = 雑魚は消えなサーイ！ …この喋り方はなんかムカつきますね…
				CASE 3
					LOCALS:10 = 射線上に立った奴は木っ端みじんですよ！
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = うわ、地味にしぶといですね。 そのまま倒れればいいのに
				CASE 1
					LOCALS:10 = な、なぜ生きてい……いや、別に生きててもおかしい事ではないですね…
				CASE 2
					LOCALS:10 = やっぱ範囲技はダメですね！ 信頼すべきは単体技ですよ、やはり！
				CASE 3
					LOCALS:10 = むっ、次こそは仕留めましょう！
			ENDSELECT
		ENDIF
	;反射された
	CASE 15
		SELECTCASE RAND:4
			CASE 0
				LOCALS:10 = ゑ？
			CASE 1
				LOCALS:10 = なん…だと…？
			CASE 2
				LOCALS:10 = あっ。
			CASE 3
				LOCALS:10 = ぴょ？
		ENDSELECT
	;反射した
	CASE 16
		SELECTCASE RAND:4
			CASE 0
				LOCALS:10 = ふっ、この程度の攻撃なら私の大胸筋で受け止められますよ！
			CASE 1
				LOCALS:10 = ほい、キャッチボール！
			CASE 2
				LOCALS:10 = スキル見てから反射余裕でした。
			CASE 3
				LOCALS:10 = これが防具のパゥワァですよ、パゥワァ。
		ENDSELECT
	;回避された
	CASE 17
		SELECTCASE RAND:4
			CASE 0
				LOCALS:10 = ゑ？
			CASE 1
				LOCALS:10 = なん…だと…？
			CASE 2
				LOCALS:10 = あっ。
			CASE 3
				LOCALS:10 = えー！？ この距離で外しますか、普通！？
		ENDSELECT
	;回避した
	CASE 18
		SELECTCASE RAND:4
			CASE 0
				LOCALS:10 = 『カンガルーのように！』とまではいきませんが、これくらいは！
			CASE 1
				LOCALS:10 = びよ～ん！
			CASE 2
				LOCALS:10 = へいへーい、ピッチャービビってるぅ！
			CASE 3
				LOCALS:10 = ﾌｯﾌｯ、当たらんよ…。
				LOCALS:11 = どうです、今のちょっとかっこよくありません？
		ENDSELECT
	;反撃スキル発動した
	CASE 20
		;装備スキル次第では発動しそうなので用意しておく
		LOCALS:10 = うぉーっ、隙ありー！
	CASE 22
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				LOCALS:10 = あー！ 柵から解放された気分ですーッ！
			CASE "SHOCK"
				LOCALS:10 = あっびゃびゃびゃびゃっ
			CASE "FREEZE"
				LOCALS:10 = ＊こおりのなかにいる＊
			CASE "BIND"
				LOCALS:10 = うがーっ、ＨＡ☆ＮＡ☆ＳＥ！！
			CASE "PALYZE"
				LOCALS:10 = 麻痺って痙攣するんとかじゃなくて、感覚がなくなってだらーんとする感じらしいですね
				LOCALS:11 = いや正直こんな事言ってる場合じゃないんですけど
			CASE "PANIC"
				LOCALS:10 = あ、あ…あ…？ あっちょん、ぷり……？
			CASE "SLEEP"
				LOCALS:10 = ぐー、ないっ……ｽﾔｧ
			CASE "CLOSE"
				LOCALS:10 = ふっ、残念でしたね…%CSTR:ARG:일인칭%は魔法を使わないタイプなんですよ！
				LOCALS:11 = ……ちょっとだけ期待していたのは内緒なんですけどねー。
			CASE "POISON"
				LOCALS:10 = オエー。 き、気分が悪い…！
			CASE "BOMB"
				LOCALS:10 = えっ、%CSTR:ARG:일인칭%の頭に爆弾が！？
			CASE "CHARM"
				LOCALS:10 = ぁ、はぁ、っ……なんだか、身体中のムラムラが、収まらなくて……
			CASE "CURSE"
				LOCALS:10 = やめてー！ ホラゲーみたいに呪ってくるのやめてくださいー！
			CASE "FLY"
				LOCALS:10 = ＊ブンブンブン＊
			CASE "STONE"
				LOCALS:10 = ＊いしのなかにいる＊
			CASE "FLAME"
				LOCALS:10 = アツゥイ！？ アッツゥイ！！
			CASE "SLIP"
				LOCALS:10 = あいたっ。 ちょ、誰ですか！ こんな床を滑りやすくしたのは！？
			CASE "BRAND"
				LOCALS:10 = せ、聖痕ってなんですかっ！ アレですか！ エッチなゲームでよくあるタトゥーなんですか！？
			;その他の状態異常
			;CASEELSE
		ENDSELECT
	;バトルに勝利した
	CASE 90
		SELECTCASE RAND:4
			CASE 0
				LOCALS:10 = イェーイ！ %CALLNAME:ARG%、大・活・躍！！
			CASE 1
				LOCALS:10 = ただのまぐれ？ いえいえ、純粋に私の実力です！
			CASE 2
				LOCALS:10 = いやー、気分はもうハイテンションですよ！
			CASE 3
				LOCALS:10 = これが、ゲイムギョウ界人のド根性ですよ！
		ENDSELECT
	;レベルアップした
	CASE 91
		SELECTCASE RAND:4
			CASE 0
				LOCALS:10 = よし、四コマ増やします！
			CASE 1
				LOCALS:10 = やったー！ 昇給待ったなしですね！
			CASE 2
				LOCALS:10 = このまま特集ページ増やしていきますよー！
			CASE 3
				LOCALS:10 = これが『デンゲキコ・クオリティ』です！
		ENDSELECT
	;逃走に成功した
	CASE 92
		SELECTCASE RAND:4
			CASE 0
				LOCALS:10 = うぉー、ｻﾗﾀﾞﾊﾞｰ！
			CASE 1
				LOCALS:10 = こんなところには居られません、%CSTR:ARG:일인칭%はもう逃げさせていただきます！
			CASE 2
				LOCALS:10 = 戦略的てったーい！
			CASE 3
				LOCALS:10 = 生存への道にダッシュですよ、ダッシュ！
		ENDSELECT
	;逃走に失敗した
	CASE 93
		SELECTCASE RAND:4
			CASE 0
				LOCALS:10 = ギャー！？ 締め切りみたいに追い込まないでくださいよー！？
			CASE 1
				LOCALS:10 = ちょっ、ジャマっ！ 逃げ道ふさがないでくださいよ、もーっ！
			CASE 2
				LOCALS:10 = なんですか、なんかキーアイテムとか渡さないと退かないんですか、あなたたち！？
			CASE 3
				LOCALS:10 = せめてこの一瞬だけは現実逃避したかった…！
		ENDSELECT
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			SELECTCASE RAND:5
				CASE 0
					LOCALS:10 = 死にたくない…！ だからお前が死ねーっ！
				CASE 1
					LOCALS:10 = 生存本能がドバドバと溢れ出てるんですけど！ どうにかなりません！？
				CASE 2
					LOCALS:10 = 死中に活在り！ ちょいさーっ！
				CASE 3
					LOCALS:10 = 遊びでもゲームでもない環境で狩られる訳にはいきません！
					LOCALS:11 = ハングリー！
				CASE 4
					LOCALS:10 = 経験値泥棒ーッ、速く来てくださいーッ！
					LOCALS:11 = このまま経験値とか資金とか盗んでいいですからーッ！
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = ここで出会ったが百年目！ いざ、勝負です！
				CASE 1
