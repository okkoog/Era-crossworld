;6.7.8.オパーイモミング
;造魔ちゃん口上（１）からコピペ。
;一本化。307、308と空きができたけれど、クリ愛撫と浣腸＋プラグで使用。
;オパーイ揉むか乳首ぐにぐにするかは、宗派によってはやっぱ違うものなんでしょうけど、自分はそこまで属性ねえので。
;カンッペキ手抜きなんで誰か。誰かお願い。
;-------------------------------------------------
@K_1620_1_OPAI_MOMINGU
		;初めて
		IF CFLAG:306 == 0
			PRINTFORMW 무엇을 하고 있는지 잘 모르는지、%조사처리(CALLNAME,"는")% 고개를 갸웃거릴 뿐이다……
			PRINTFORMW 「……옷？」
			CFLAG:306 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:308 < 4 || FLAG:7 == 2)
				PRINTFORM %CALLNAME%의
				;心は錦
				IF TALENT:빈유 == 1
					PRINTFORM 유두만이 존재를 주장하는 가슴
				;――だ、ウォルター
				ELSEIF TALENT:절벽 == 1
					PRINTFORM 갈비뼈가 뜬 가슴
				;社長
				ELSEIF TALENT:거유 == 1
					PRINTFORM 펼쳐서 한층 커진 유방
				;これがオチって中々ない今時
				ELSEIF BUST() > 4
					PRINTFORM 살이 꽉 찬 유방
				;極まったニュートラルこそ“最悪”なのだ……
				ELSE
					PRINTFORM 균형 잡힌、아름다운 유방
				ENDIF
				PRINTFORML 을 만졌다……
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORMW 「옷……」
					PRINTFORMW %조사처리(CALLNAME,"는")% %CALLNAME:MASTER%의 머리를 껴안고、자유롭게 시켰다……
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 「옷……」
					PRINTFORMW %조사처리(CALLNAME,"는")% %CALLNAME:MASTER%의 머리를 껴안고、자유롭게 시켰다……
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 「옷……」
					PRINTFORMW %조사처리(CALLNAME,"는")% %CALLNAME:MASTER%의 머리를 껴안고、자유롭게 시켰다……
				ENDIF
				CFLAG:306 = 4
			;未陥落
			ELSE
				;屈服刻印Lv3
				IF MARK:2 == 3 && (CFLAG:308 < 3 || FLAG:7 == 2)
					PRINTFORMW %CALLNAME%의 젖에 손을 대자、움찔 어깨를 떨었다……
					PRINTFORMW 「……옷」
					CFLAG:306 = 3
				;それ以外
				ELSEIF CFLAG:306 < 2 || FLAG:7 == 2
					PRINTFORMW 무엇을 하고 있는지 잘 모르는지、%조사처리(CALLNAME,"는")% 고개를 갸웃거릴 뿐이다……
					PRINTFORMW 「……옷？」
					CFLAG:306 = 2
				ENDIF
			ENDIF
		ENDIF



