@KOJO_MESSAGE_ENDING_K[[キャラ:크툴루]]
;--------------------------------------------------
SELECTCASE TSTR:END종별
	CASE "個別END"
		;恋慕単体エンド
		IF TALENT:아내 || TALENT:남편 && CFLAG:21 == 1
			DRAWLINE
			PRINTFORMW …………
			PRINTFORMW ………
			PRINTFORMW ……
			PRINTFORMW 　
			PRINTFORMW 「옷！」
			PRINTFORMW ――남위 47도 9분、서경 126도 43분。
			PRINTFORMW 그곳에 가까운、극히 최근에 떠오른 작은 섬。
			PRINTFORMW 기하학적으로 미친 각도와、암녹색의 거석으로 구축된 도시――의 구석。
			PRINTFORMW 「옷、오─？」
			PRINTFORMW 형언할 수 없는 생물이 힐끔힐끔 이쪽을 들여다보고 있고、갑자기 삼차원이 아닌 방향으로 걷게 되곤 하지만。
			PRINTFORMW 아내의 친정에、본체……생산자……혹은 부모님、또는 다른 무언가에 인사하러 가는 것이니、불평은 할 수 없다。
			PRINTFORMW %MASTER는% 기합을 다시 넣고、SAN치를 깎는 여러 가지를 무시한 채。
			PRINTFORMW %CALLNAME과% 손을 잡고、둘이서、걸어갔다。
			PRINTFORMW 　
			PRINTFORMW 「……옷♪」
			PRINTFORMW 　
			PRINTFORMW 　
;			PRINTFORMW 　　　　　　　　―― Ending No.101620A (クトゥルヲエンド)
			PRINTFORMW 　　　　　　　　―― Ending No.101620A (크툴루엔드)
		;淫乱単体エンド
		ELSEIF TALENT:음마 && CFLAG:21 == 1
			DRAWLINE
			PRINTFORMW …………
			PRINTFORMW ………
			PRINTFORMW ……
			PRINTFORMW 　
			PRINTFORMW 아침。
			PRINTFORMW 눈을 뜨자、거기는 촉수였다。
			PRINTFORMW 짚이는 건 하나뿐이었다。
			PRINTFORMW 「……옷☆」
			PRINTFORMW 눈 아래。%CALLNAME이% %CALLNAME:MASTER%에게 달라붙으면서、사지에 촉수를 휘감아왔다。
			PRINTFORMW 테헤페로、라고、%CALLNAME은% 애매한 몸짓을 한다。
			PRINTFORMW 「옷。옷오오오、옷」
			PRINTFORMW 무슨 말을 하는지는 전혀 몰랐지만、무슨 말을 하고 싶은지는 금방 알아챘다。
			PRINTFORMW 즉、……좋아한다는 것이다。
			PRINTFORMW 어차피 도망갈 길도 없다。도망칠 생각도 없다。
			PRINTFORMW %CALLNAME을% 이렇게 만든 것은、자기 자신이다。
			PRINTFORMW 그렇다면、책임을 져야 할 것이다。
			PRINTFORMW 그 비소에 닿으면、이미 준비는 만전。
			PRINTFORMW %CALLNAME은% 음란한 미소를 띠면서、%CALLNAME:MASTER%의 귓가에 중얼거렸다。
			PRINTFORMW 변함없이、무엇을 말하고 있는지는 몰랐지만――%MASTER는%、응답해 주기로 했다。
			PRINTFORMW 　
			PRINTFORMW 「……옷♪」
			PRINTFORMW 　
			PRINTFORMW 　
;			PRINTFORMW 　　　　　　　　―― Ending No.101620B (クトゥルヲエンド)
			PRINTFORMW 　　　　　　　　―― Ending No.101620B (크툴루엔드)
		;服従単体エンド
		ELSEIF TALENT:노리개 && CFLAG:21 == 1
			DRAWLINE
			PRINTFORMW …………
			PRINTFORMW ………
			PRINTFORMW ……
			PRINTFORMW 　
			PRINTFORMW 「……오……」
			PRINTFORMW %CALLNAME은% 피투성이인 채 %MASTER를% 시중 들며、배후를 보였다。
			PRINTFORMW ――남위 47도 9분、서경 126도 43분。
			PRINTFORMW 기하학적으로 미친 각도와、암녹색의 거석으로 구축된 도시――의 중심부。
			PRINTFORMW 파괴되어、흐물흐물해진 거체가、거기에 있었다。
			PRINTFORMW 천둥 같으면서도、땅울림과도 같은、바다 밑에서 들려오는 듯한 소리가、머리에서 울렸다。
			PRINTFORMW 　
			PRINTFORMW “이것으로”“%일인칭이%”“본체”
			PRINTFORMW “%CSTR:이인칭%”“나의 주인”“당신에게”
			PRINTFORMW “모든 것을”
			PRINTFORMW 　
			PRINTFORMW %CALLNAME%의 힘이、늘어나는 것을 알 수 있다。
			PRINTFORMW 바로 계약이 비명을 지르며、순식간에 분리돼서 흩어졌다。
			PRINTFORMW 그런데도、%MASTER를% 거스르려고 하지는 않는다。
			PRINTFORMW 피를 닦아주자、%CALLNAME은% 미소를 띠었다。
			PRINTFORMW 나야말로、주인님의 노예라고。
			PRINTFORMW 그런、자랑스러운 미소다。
			PRINTFORMW 너무 들뜨지 말라고、가볍게 이마를 때렸다。
			PRINTFORMW 그런데도、%CALLNAME은% 기쁜 듯이、말했다。
			PRINTFORMW 　
			PRINTFORMW 「……옷♪」
			PRINTFORMW 　
			PRINTFORMW 　
;			PRINTFORMW 　　　　　　　　―― Ending No.101620C (クトゥルヲエンド)
			PRINTFORMW 　　　　　　　　―― Ending No.101620C (크툴루엔드)
		ENDIF
	;CASE "調教師END"
	;CASE "稀代の調教師END"
	;CASE "食堂経営END"
	;CASE "娼館経営END"
	;CASE "アイドルEND"
ENDSELECT
;個別ENDの場合ここでRETURN 1すると、その後ゲームは続かず次周に行くかゲーム終了かの選択になります
