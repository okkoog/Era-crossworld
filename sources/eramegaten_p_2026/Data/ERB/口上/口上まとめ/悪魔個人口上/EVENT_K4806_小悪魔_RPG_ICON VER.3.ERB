;-------------------------------------------------
;汎用スキル
;-------------------------------------------------
;スキルの継承相性ごとに喋らせる口上
;-------------------------------------------------
ELSE
	CALL GET_SKILL_PROP, "SKILL_SUCCESSION_TYPE", CFLAG:ARG:입력행동, ARG
	LOCAL = RESULT
	;継承タイプ名をGET_TYPE()で取得し、その内容＝継承タイプ名で分岐
	SELECTCASE GET_SUCCESSION(LOCAL)
		;喋らせたい属性はコメントアウトを解除して使う

		CASE "검격"
			BTL_KOJO_RESULTS:0 = 当たれぇー！
		CASE "비구"
			BTL_KOJO_RESULTS:0 = ……撃ちます！
		CASE "타격"
			BTL_KOJO_RESULTS:0 = 右ストレートを喰らえっ！
		CASE "전술"
			;噛み付き系
			IF GROUPMATCH(CFLAG:ARG:입력행동, [[스킬:물어뜯기]], [[스킬:독물어뜯기]], [[스킬:마비물어뜯기]], [[스킬:매혹물어뜯기]], [[스킬:석화물어뜯기]])
				BTL_KOJO_RESULTS:0 = か、噛みつき攻撃です～
			;その他
			ELSE
				BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%が放つ妙技、受けてください！
			ENDIF
		CASE "회복"
			;全体回復
			IF CFLAG:ARG:타겟 > 6
				BTL_KOJO_RESULTS:0 = 皆さん、治療します
			ELSE
				BTL_KOJO_RESULTS:0 = 回復です、どうぞ！
			ENDIF
		CASE "지원"
			;強化系
			IF GROUPMATCH(CFLAG:ARG:입력행동, [[스킬:타루・카쟈]], [[스킬:스쿠・카쟈]], [[스킬:마카・카쟈]], [[스킬:라쿠・카쟈]], [[스킬:데・쿤다]], [[스킬:사마・카쟈]])
				BTL_KOJO_RESULTS:0 = 조금만더힘을……！
			;弱体系
			ELSEIF GROUPMATCH(CFLAG:ARG:입력행동, [[스킬:타룬・다]], [[스킬:스쿤・다]], [[스킬:마칸・다]], [[스킬:라쿤・다]], [[스킬:데・카쟈]], [[스킬:사만・다]])
				BTL_KOJO_RESULTS:0 = デバフをかけちゃいます！
			;도발
			ELSEIF CFLAG:ARG:입력행동 == [[스킬:도발]]
				BTL_KOJO_RESULTS:0 = その程度だとしたら、期待外れですよッ！
			;その他
			ELSE
				BTL_KOJO_RESULTS:0 = 微力ながらお力添えします
			ENDIF
		CASE "방어"
			BTL_KOJO_RESULTS:0 = これは耐えるための技です
		CASE "화염"
			BTL_KOJO_RESULTS:0 = 炎よ、敵を焼き尽くせ！
		CASE "빙결"
			BTL_KOJO_RESULTS:0 = 凍結せよ！
		CASE "전격"
			BTL_KOJO_RESULTS:0 = これはビリっときて痛いですよ！
		CASE "충격"
			BTL_KOJO_RESULTS:0 = これで叩きつけてあげますっ！
		;CASE "신경"
		;	BTL_KOJO_RESULTS:0 = 
		;CASE "정신"
		;	BTL_KOJO_RESULTS:0 = 
		CASE "파마"
			BTL_KOJO_RESULTS:0 = これで……昇天してください！
		CASE "주살"
			BTL_KOJO_RESULTS:0 = 呪われろ～！
		CASE "지변"
			BTL_KOJO_RESULTS:0 = 大地よ、敵を打ち砕けッ！
		CASE "수격"
			BTL_KOJO_RESULTS:0 = 水よ、敵を沈めてください
		CASE "질풍"
			BTL_KOJO_RESULTS:0 = 風よ、敵を吹き飛ばせ！
		CASE "중력"
			BTL_KOJO_RESULTS:0 = 重力の力……操ってみます！
		CASE "핵열"
			BTL_KOJO_RESULTS:0 = 核熱の炎で身を焦がせ！
		CASE "만능"
		;	自爆系
			IF GROUPMATCH(CFLAG:ARG:입력행동, [[스킬:자폭]], [[스킬:옥쇄파]], [[스킬:바이널스트라이크]])
				BTL_KOJO_RESULTS:0 = 
			ELSE
				BTL_KOJO_RESULTS:0 = すべてをこの一撃に賭けます！
				BTL_KOJO_RESULTS:1 = 貫けぇ！
			ENDIF

		;その他汎用スキルセリフ
		CASEELSE
			BTL_KOJO_RESULTS:0 = 
	ENDSELECT
ENDIF
