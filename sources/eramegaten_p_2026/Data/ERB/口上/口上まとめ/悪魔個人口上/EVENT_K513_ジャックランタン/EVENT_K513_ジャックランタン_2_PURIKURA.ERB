;=======================================================================
;
;	ファイル名	:EVENT_K[[キャラ:잭랜턴]]_ジャックランタン_2_PURIKURA.ERB
;	概要		:鬼火ジャック用プリクラ口上です。
;	現時点では汎用処理のみとなっているので、追記して下さる方お待ちしています。
;
;
;	ライセンス(許可する項目を"o"に、許可しない項目を"x"に変更してください)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1|  o | 処理上のバグ修正              |
;	|   2|  o | 口上の誤字・脱字の修正        |
;	|   3|  o | 口上まとめへの収録            |
;	|   4|  o | 口上の新規追加                |
;	|   5|  o | 既存口上の改変                |
;	|   6|  o | 改変した口上の自由な再配布    |
;	|   7|  o | 口上内容の転載                |
;	+----+----+-------------------------------+
;
;	更新内容	:
;
;	VER		更新日			名前					更新内容
;	000		2024/05/10		mid.k					テンプレート作成。
;	001		2024/06/03		mid.k					本体の仕様変更に伴い分離。
;
;
;	「プリント倶楽部」「プリクラ」はアトラス→セガの登録商標です。
;
;=======================================================================
;	専用CFLAG BIT内容一覧
;	真偽値で済む内容はこちらを使用してください
;
;	0	イベント初回
;=======================================================================

;メイン処理
@DUNGEON_EVENT_PURIKURA_K[[キャラ:잭랜턴]]_2
PRINTL 「촬영인가…」
PRINTW 「아니, 찍는 것 자체는 상관없지만 좀 복잡한 기분이야…」
PRINTFORMW 「있잖아, 이 녀석 마스코트로는 프로스트만 잔뜩 인기 있어서 말이지, %CSTR:일인칭%의 지명도랄까…」
PRINTL 「상관없어? 얼른 촬영하자고?」
PRINTW 「알았어 알았다고… 참 나, 막무가내네…」

;テンプレ
;関数名だけ変更して残しておきます
;ちゃんとした内容で作成される場合は38行～47行を消去してください
@DUNGEON_EVENT_PURIKURA_K[[キャラ:잭랜턴]]_2_BASE
CALLF 陥落(TARGET, MASTER)
IF GETBIT(CFLAG:프린트스티커패치, 0) == 0
	;初プリ
	IF RESULTS == "신뢰"
		;信頼ルート
	ELSEIF RESULTS == "연모"
		;恋慕ルート
	ELSEIF RESULTS == "음란"
		;淫乱ルート
	ELSEIF RESULTS == "예속"
		;服従ルート
	ELSE
		;その他(NTR中/未陥落など)
	ENDIF
	SETBIT CFLAG:프린트스티커패치, 0
ELSE
	;2回目以降
	IF RESULTS == "신뢰"
		;信頼ルート
		IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코 && TALENT:남자 && !TALENT:오토코노코
			;男同士
			;以下の呼び出しを消して直接書いても大丈夫です
			CALL DUNGEON_EVENT_PURIKURA_K[[キャラ:잭랜턴]]_2_TRUST
		ELSE
			;それ以外
			;通常分岐へ戻す場合
			CALL DUNGEON_EVENT_PURIKURA_NORMAL, TARGET, RESULTS
		ENDIF
	ELSEIF RESULTS == "연모"
		;恋慕ルート
		IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코 && TALENT:남자 && !TALENT:오토코노코
			;男同士
			;以下の呼び出しを消して直接書いても大丈夫です
			CALL DUNGEON_EVENT_PURIKURA_K[[キャラ:잭랜턴]]_2_LOVE
		ELSE
			;それ以外
			;通常分岐へ戻す場合
			CALL DUNGEON_EVENT_PURIKURA_NORMAL, TARGET, RESULTS
		ENDIF
	ELSEIF RESULTS == "음란"
		;淫乱ルート
		IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코 && TALENT:남자 && !TALENT:오토코노코
			;男同士
			;以下の呼び出しを消して直接書いても大丈夫です
			CALL DUNGEON_EVENT_PURIKURA_K[[キャラ:잭랜턴]]_2_LEWD
		ELSE
			;それ以外
			;通常分岐へ戻す場合
			CALL DUNGEON_EVENT_PURIKURA_NORMAL, TARGET, RESULTS
		ENDIF
	ELSEIF RESULTS == "복종"
		;服従ルート
		IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코 && TALENT:남자 && !TALENT:오토코노코
			;男同士
			;以下の呼び出しを消して直接書いても大丈夫です
			CALL DUNGEON_EVENT_PURIKURA_K[[キャラ:잭랜턴]]_2_OBEY
		ELSE
			;それ以外
			;通常分岐へ戻す場合
			CALL DUNGEON_EVENT_PURIKURA_NORMAL, TARGET, RESULTS
		ENDIF
	ELSE
		;その他(NTR中/未陥落など)
		IF TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코 && TALENT:남자 && !TALENT:오토코노코
			;男同士
			;以下の呼び出しを消して直接書いても大丈夫です
			CALL DUNGEON_EVENT_PURIKURA_K[[キャラ:잭랜턴]]_2_NORMAL
		ELSE
			;それ以外
			;通常分岐へ戻す場合
			CALL DUNGEON_EVENT_PURIKURA_NORMAL, TARGET, RESULTS
		ENDIF
	ENDIF
ENDIF

