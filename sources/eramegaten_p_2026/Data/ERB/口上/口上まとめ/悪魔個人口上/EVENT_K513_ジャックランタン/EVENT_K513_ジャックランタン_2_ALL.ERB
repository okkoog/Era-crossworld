	PRINTL [0] 상정 소질·복장으로 변경한다
	PRINTL [1] 소질을 변경하지 않는다
	;PRINTL [2] 汎用口上を適用する
	$INPUT_LOOP
	INPUT
	IF RESULT == 0
		PRINTFORMW ―소질을 변경하고 조교를 개시합니다―
		TALENT:유아체형 = 0
		;와이셔츠
		CFLAG:초기옷 = 121
		CFLAG:옷 = 121
		TEQUIP:옷 = 121
		;바지
		CFLAG:초기하의 = 204
		CFLAG:하의 = 204
		TEQUIP:하의 = 204
		;장갑
		CFLAG:초기손 = 401
		CFLAG:손 = 401
		TEQUIP:손 = 401
		;트렁크스
		CFLAG:초기속옷（하） = 606
		CFLAG:속옷（하） = 606
		TEQUIP:속옷（하） = 606
		;부츠
		CFLAG:초기신발 = 901
		CFLAG:신발 = 901
		TEQUIP:신발 = 901
		
		PRINTL 
		PRINTW 구상 내 소질 변화 이벤트를 발생시키겠습니까?
		PRINTL 
		PRINTL [0] 발생시킨다
		PRINTL [1] 소질을 변화시키지 않는다
		$INPUT_LOOP2
		INPUT
