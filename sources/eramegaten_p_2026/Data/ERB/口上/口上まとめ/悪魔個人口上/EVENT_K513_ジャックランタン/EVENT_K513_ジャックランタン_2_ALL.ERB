		;CFLAG:구상셀렉트 = -1
		;TRYJUMPFORM EVENTTRAIN_PUB{ABL:회화타입}
	ELSE
		GOTO INPUT_LOOP
	ENDIF

	CALLNAME = 도깨비불의 잭
