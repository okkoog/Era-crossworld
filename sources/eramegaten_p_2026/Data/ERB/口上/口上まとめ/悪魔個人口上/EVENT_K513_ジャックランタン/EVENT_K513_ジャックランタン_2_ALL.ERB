		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:300 == 0
			;恋慕、親愛
			IF TALENT:3 || TALENT:6
				PRINTL 
				PRINTFORMW 「이야, 이런 건 좋네」
			;淫乱、娼婦
			ELSEIF TALENT:4 || TALENT:7
				PRINTL 
				PRINTFORMW 「더 강한 편이 취향일까나」
			;服従、隷属
			ELSEIF TALENT:5 || TALENT:8
				PRINTL 
				PRINTFORMW 「응? 왜 그래?」
			ELSE
				PRINTL 
				PRINTFORMW 「간지러운데」
			ENDIF
			CFLAG:300 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落(TARGET) && (CFLAG:300 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					;촉수+中毒
					IF TEQUIP:25 == 1 && ABL:촉수중독 > 3
						PRINTL 
						PRINTFORMW 「헤헤…… 기분 좋아……」
					;촉수
					ELSEIF TEQUIP:25 == 1
							PRINTL 
							PRINTFORMW 「으으으, 기분 나빠……」
					ELSEIF PALAM:욕정 >= PALAMLV:5
						IF RAND:2 == 0
							PRINTFORMW %CALLNAME%은(는) 넋이 나간 황홀한 표정으로 당하는 대로 내맡기고 있다……
						ELSE
							PRINTL 
							PRINTFORMW 「만져지는 건 좋아해…… 기분 좋은걸」
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTL 
							PRINTFORMW 「그렇게 %CSTR:일인칭%를 만지는 게 즐거워? ……농담이야」
						ELSE
							PRINTL 
							PRINTW 「잘 움직이는 손가락이네에. 손재주가 좋다는 건 멋져」
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					;촉수+中毒
					IF TEQUIP:25 == 1 && ABL:촉수중독 > 3
						PRINTL 
						PRINTFORMW 「이렇게 보니, 의외로 귀여울지도 모르겠네」
					;촉수
					ELSEIF TEQUIP:25 == 1
							PRINTL 
							PRINTFORMW 「하하하, 이상한 움직임」
					ELSEIF PALAM:욕정 >= PALAMLV:5
						IF RAND:2 == 0
							PRINTFORMW %CALLNAME%은(는) 눈동자를 초롱초롱 빛내면서도 당하는 대로 내맡기고 있다……
						ELSE
							PRINTL 
							PRINTFORMW 「만지는 것만으로 만족하는 거야? %CSTR:일인칭%는 감질나는데……%UNICODE(0x2665)%」
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTL 
							PRINTW 「애태우네에」
						ELSE
							PRINTL 
							PRINTW 「전희가 정성스러운 건 좋은 일이지」
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					;촉수+中毒
					IF TEQUIP:25 == 1 && ABL:촉수중독 > 3
						PRINTL 
						PRINTFORMW 「헤헤…… 기분 좋아……」
					;촉수
					ELSEIF TEQUIP:25 == 1
							PRINTL 
							PRINTFORMW 「으으……」
					ELSEIF PALAM:욕정 >= PALAMLV:5
						IF RAND:2 == 0
							PRINTFORMW %CALLNAME%은(는) 거친 숨을 몰아쉬며 당하는 대로 내맡기고 있다……
						ELSE
							PRINTL 
							PRINTFORMW 「이렇게 상냥하게 대해주면, 다음 벌이 기대돼 버리잖아……%UNICODE(0x2665)%」
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTL 
							PRINTW 「만지는 것뿐? 그래」
						ELSE
							PRINTL 
							PRINTW 「아프게 해줘도 괜찮은데 말야」
						ENDIF
					ENDIF
				ENDIF
				CFLAG:300 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:300 < 3 || FLAG:7 == 2)
				IF PALAM:욕정 >= PALAMLV:5
					IF RAND:2 == 0
						PRINTFORMW %CALLNAME%은(는) 저항하지 않고 당하는 대로 내맡기고 있다……
					ELSE
						PRINTL 
						PRINTFORMW 「……거기는, 마음에 드네」
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTL 
						PRINTW 「즐기고 있는 것 같네」
					ELSE
						PRINTL 
						PRINTW 「나쁘진…… 아니, 에또, 응」
					ENDIF
				ENDIF
				CFLAG:300 = 3
			;それ以外
			ELSEIF CFLAG:300 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTL 
					PRINTW 「그렇게 자꾸 질척질척 만져대도 말이지」
				ELSE
					PRINTL 
					PRINTW 「으응, 차가워」
				ENDIF
				CFLAG:300 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;2,펠라한다
;お掃除フェラ分岐もつけたいね
;-------------------------------------------------
	CASE 2
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:302 == 0
			IF TEQUIP:주도권
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTL 
					PRINTFORMW 「괴로우면 말하는 거다?」
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTL 
					PRINTFORMW 「엄청 기분 좋아, %CSTR:이인칭% 입속」
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTL 
					PRINTFORMW 「……다음엔 %CSTR:일인칭%가 물고 싶은걸」
				ELSE
					PRINTL 
					PRINTFORMW 「이런, 너무 심했나?」
				ENDIF
			ELSE
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTL 
					PRINTFORMW 「……저, 저기, 무리는 안 해도 돼?」
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTL 
					PRINTFORMW 「와아 능숙하네. 부러울 지경이야」
				;服従、隷属
					PRINTL 
					PRINTFORMW 「더러웠으려나……」
				ELSE
					PRINTL 
					PRINTW 「왓, 자, 잠깐!?」
				ENDIF
			ENDIF
			CFLAG:302 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落(TARGET) && (CFLAG:302 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					IF TEQUIP:주도권
						IF RAND:3 == 0 && TFLAG:10 > 0 && TFLAG:29 > 0
							PRINTL 
							PRINTW 「삼켜……주지 않아도, 괜찮긴, 한데 말야」
						ELSEIF RAND:2 == 0
							PRINTFORMW %CALLNAME%은(는) 눈을 가늘게 뜨고 %CALLNAME:PLAYER%의 표정을 바라보고 있다……
						ELSE
							PRINTL 
							PRINTW 「으~음…… 좋네에……」
						ENDIF
					;調教者（主人）の精液中毒3以上
					ELSEIF ABL:PLAYER:16 >= 3
						IF RAND:3 == 0 && TFLAG:10 > 0 && TFLAG:29 > 0
							PRINTL 
							PRINTFORMW 「빠, 빨면 안 된다니까……%UNICODE(0x2665)%」
						ELSEIF RAND:2 == 0
							PRINTL 
							PRINTW 「……마시고 싶은 거야?」
						ELSE
							PRINTL 
							PRINTFORMW 「%CSTR:이인칭%, 이런 걸 좋아하는구나」
						ENDIF
					ELSE
						IF RAND:3 == 0 && TFLAG:10 > 0 && TFLAG:29 > 0
							PRINTL 
							PRINTFORMW 「……앗, 잠깐, 안 돼……」
						ELSEIF RAND:2 == 0
							PRINTFORMW %CALLNAME%은(는) 사랑스럽다는 듯이 %CALLNAME:PLAYER%의 표정을 바라보고 있다……
						ELSE
							PRINTL 
							PRINTW 「싫으면 그만둬도 괜찮다고? 무리는 하지 마?」
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					;調教者が淫乱か娼婦
					IF TALENT:PLAYER:4 || TALENT:PLAYER:7
						IF RAND:3 == 0 && TFLAG:10 > 0 && TFLAG:29 > 0
							PRINTL 
							PRINTFORMW 「기왕 이렇게 됐으니, 마셔주실까나」
						ELSEIF RAND:2 == 0
							PRINTL 
							PRINTFORMW 「%CSTR:이인칭%도 참 좋아하네……」
						ELSE
							PRINTL 
							PRINTW 「즐거워 보여서 좋네」
						ENDIF
					;調教者が服従か隷属
					ELSEIF TALENT:PLAYER:5 || TALENT:PLAYER:8
						IF RAND:3 == 0 && TEQUIP:주도권
							PRINTL 
							PRINTFORMW 「더 심하게 해주길 바란다면, 언제든 들어줄게」
						ELSEIF RAND:2 == 0
							PRINTL 
							PRINTW 「익숙한 걸까나, 역시」
						ELSE
							PRINTL 
							PRINTW 「좋아하잖아? 사양하지 않아도 돼」
						ENDIF
					ELSE
						IF RAND:3 == 0 && TFLAG:10 > 0 && TFLAG:29 > 0
							PRINTL 
							PRINTFORMW 「기왕 이렇게 됐으니, 마셔주실까나」
						ELSEIF RAND:2 == 0
							PRINTFORMW %CALLNAME%은(는) 즐겁다는 듯이 %CALLNAME:PLAYER%의 표정을 바라보고 있다……
						ELSE
							PRINTL 
							PRINTW 「제법 하는구만……」
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					;調教者が淫乱か娼婦
					IF TALENT:PLAYER:4 || TALENT:PLAYER:7
						IF RAND:3 == 0 && TFLAG:10 > 0 && TFLAG:29 > 0
							PRINTL 
							PRINTFORMW 「큭…… 버, 버틸 수 있을 리가 없잖아앗%UNICODE(0x2665)%」
						ELSEIF RAND:2 == 0
							PRINTL 
							PRINTFORMW 「%CSTR:이인칭%도 참 별종이네……」
						ELSE
							PRINTL 
							PRINTFORMW 「%CSTR:일인칭%한테 하는 방법을 가르쳐주는 걸까나」
						ENDIF
					;調教者（主人）の精液中毒3以上
					ELSEIF ABL:PLAYER:16 >= 3
						IF RAND:3 == 0 && TFLAG:10 > 0 && TFLAG:29 > 0
							PRINTL 
							PRINTFORMW 「……앗, 잠깐, 안 돼……」
						ELSEIF RAND:2 == 0
							PRINTL 
							PRINTFORMW 「설마 %CSTR:일인칭%를 물통 같은 걸로…… 뭐 그래도 좋지만!」
						ELSE
							PRINTL 
							PRINTW 「에또, 싸도 돼? 안 돼……?」
						ENDIF
					ELSE
						IF RAND:3 == 0 && TFLAG:10 > 0 && TFLAG:29 > 0
							PRINTL 
							PRINTFORMW 「무리, 나와……앗%UNICODE(0x2665)%」
						ELSEIF RAND:2 == 0
							PRINTFORMW %CALLNAME%은(는) %CALLNAME:PLAYER%의 머리에 손을 얹고 있다……
						ELSE
							PRINTL 
							PRINTFORMW 「어째서 %CSTR:일인칭%만, %CSTR:일인칭%한테도 하게 해줘」
						ENDIF
					ENDIF
				ENDIF
				CFLAG:302 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:302 < 3 || FLAG:7 == 2)
				IF PALAM:욕정 >= 3 && TFLAG:10 > 0 && TFLAG:29 > 0
					PRINTL 
					PRINTFORMW 「우…… 큭%UNICODE(0x2665)%」
				ELSEIF RAND:2 == 0
					PRINTL 
					PRINTFORMW 「어디가 약한지 들켜버린 걸까나?」
				ELSE
					PRINTL 
					PRINTFORMW 「……이는 세우지 말아줘」
				ENDIF
				CFLAG:302 = 3
			;それ以外
			ELSEIF CFLAG:302 < 2 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTL 
					PRINTW 「우와아…… 우와아……」
				ELSE
					PRINTL 
					PRINTW 「기분 좋지만 기분 나쁘네」
				ENDIF
				CFLAG:302 = 2
			ENDIF
		ENDIF

;-------------------------------------------------
;4,애널핥기
;-------------------------------------------------
	CASE 4
		CALL TRAIN_MESSAGE
		PRINTL 
		;初めて
		IF CFLAG:304 == 0
			IF TEQUIP:주도권
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORMW 「이걸로 되려나?」
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 「이게 안면기승……으로, 맞는 걸까나?」
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 「그렇지만, 굳이 엉덩이 밑에 깔리게 하는 건 좀 어떤가 싶다구」
				ELSE
					PRINTFORMW 「영차, 이렇게구나」
				ENDIF
			ELSE
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORMW 「적셔서 어쩌려는 거야? ……넣을 생각이야?」
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTW 「넣을 생각이구나!? 급격하게 기대되기 시작했어!」
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTW 「사전 준비야? 그, 그렇구나, 진심이네……」
				ELSE
					PRINTW 「……응? 설마, 그럴 생각이야?」
				ENDIF
			ENDIF
			CFLAG:304 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落(TARGET) && (CFLAG:304 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					;Ａ経験100以上＋欲情のPALAMLV3以上
					IF EXP:1 >= 100 && PALAM:욕정 >= PALAMLV:3
						IF (PREVCOM ==62 || PREVCOM ==63 || PREVCOM ==67 || PREVCOM ==70 || PREVCOM ==71) && TCVAR:TARGET:101 > 0 && RAND:3 == 0
							PRINTFORMW 「아, 잠까, 아직 안에…… 으윽%UNICODE(0x2665)%」
						ELSEIF RAND:2 == 0
							PRINTFORMW 「혀까지 넣지 말아줘, 못 참게 되잖아……」
						ELSE
							PRINTW 「아, 안쪽은 안 된다니까……」
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORMW 「……역시 이런 건, 저항감은 말야, 응, 있단 말이지」
						ELSE
							PRINTW 「그런 곳은 안 핥아도 되는데 말야」
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					;Ａ経験100以上＋欲情のPALAMLV3以上
					IF EXP:1 >= 100 && PALAM:욕정 >= PALAMLV:3
						IF (PREVCOM ==62 || PREVCOM ==63 || PREVCOM ==67 || PREVCOM ==70 || PREVCOM ==71) && TCVAR:TARGET:101 > 0 && RAND:3 == 0
							PRINTFORMW 「정액, 아직 안에 남아있는데. 설마 전부 빨아내 버리는 건가?」
						ELSEIF RAND:2 == 0
							PRINTFORMW 「혀까지 넣지 말아줘, 못 참게 되잖아……」
						ELSE
							PRINTW 「왠지, 딴 생물 같아서 재밌네」
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORMW 「%CSTR:이인칭%야말로, 저항감이 있을 법한데 말이지」
						ELSE
							PRINTW 「자연스럽게 젖진 않으니까 말야」
						ENDIF
					ENDIF
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					;Ａ経験100以上＋欲情のPALAMLV3以上
					IF EXP:1 >= 100 && PALAM:욕정 >= PALAMLV:3
						IF (PREVCOM ==62 || PREVCOM ==63 || PREVCOM ==67 || PREVCOM ==70 || PREVCOM ==71) && TCVAR:TARGET:101 > 0 && RAND:3 == 0
							PRINTFORMW 「아, 잠까, 아직 안에…… 으윽%UNICODE(0x2665)%」
						ELSEIF RAND:2 == 0
							PRINTFORMW 「혀까지 넣지 말아줘, 못 참게 되잖아……」
						ELSE
							PRINTW 「아, 안쪽은 안 된다니까……」
						ENDIF
					ELSE
						IF RAND:2 == 0
							PRINTFORMW 「……역시 이런 건, 저항감은 말야, 응, 있단 말이지」
						ELSE
							PRINTW 「아무리 안 싸도 된다고 해도, 저기, 역시나 말야……」
						ENDIF
					ENDIF
				ENDIF
				CFLAG:304 = 4
			;屈服刻印Lv3
			ELSEIF MARK:2 == 3 && (CFLAG:304 < 3 || FLAG:7 == 2)
				;Ａ経験100以上＋欲情のPALAMLV3以上
				IF EXP:1 >= 100 && PALAM:욕정 >= PALAMLV:3
					IF (PREVCOM ==62 || PREVCOM ==63 || PREVCOM ==67 || PREVCOM ==70 || PREVCOM ==71) && TCVAR:TARGET:101 > 0 && RAND:3 == 0
						PRINTFORMW 「아, 잠까, 아직 안에…… 으윽%UNICODE(0x2665)%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「혀까지 넣지 말아줘, 못 참게 되잖아……」
					ELSE
						PRINTW 「아, 안쪽은 안 된다니까……」
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「……역시 이런 건, 저항감은 말야, 응, 있단 말이지」
					ELSE
						PRINTW 「그런 곳은 안 핥아도 되는데 말야」
					ENDIF
				ENDIF
				CFLAG:304 = 3
			;それ以外
			ELSEIF CFLAG:304 < 2 || FLAG:7 == 2
				;Ａ経験100以上＋欲情のPALAMLV3以上
				IF EXP:1 >= 100 && PALAM:욕정 >= PALAMLV:3
					IF (PREVCOM ==62 || PREVCOM ==63 || PREVCOM ==67 || PREVCOM ==70 || PREVCOM ==71) && TCVAR:TARGET:101 > 0 && RAND:3 == 0
						PRINTFORMW 「아, 잠까, 아직 안에…… 으윽%UNICODE(0x2665)%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「혀까지 넣진 말아줘……」
					ELSE
						PRINTW 「힉, 혀……!?」
					ENDIF
				ELSE
					IF RAND:2 == 0
						PRINTW 「변태다……!」
					ELSE
						PRINTW 「변태다…… 글러먹은 느낌의 변태다……!」
					ENDIF
				ENDIF
				CFLAG:304 = 2
			ENDIF
		ENDIF
;-------------------------------------------------
;5,애널애무
;かなりコンパチ
;-------------------------------------------------
	CASE 5
		CALL TRAIN_MESSAGE
		PRINTL 
		;初めて
		IF CFLAG:305 == 0
			;恋慕、親愛
			IF TALENT:3 || TALENT:6
				PRINTFORMW 「어익쿠!? ……조, 좋아! 와라!」
