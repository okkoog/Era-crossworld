;--------------------------------------------------
@EVENTTRAIN_K[[キャラ:맘몬]]_1
;魔貨支払い金額用の変数の宣言
#DIM DYNAMIC PayMoney
CALL 口上変数初期化
;--------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;--------------------------------------------------
;初調教時にこの内容で素質等の変更をさせたい。調教前に口上適用させるならそちらでは何もしないのが望ましい（フラグ使用して素質変更したときだけオンにして戦闘口上にもオンオフで反映させる？）
IF CFLAG:220 == 0
	PRINTL 구상을 적용합니다
	PRINTW 구상 내용에 맞춰 소질 등을 변경하시겠습니까?
	PRINTL
	PRINTL [0] 예 (소질 등 모두 변경한다)
	PRINTL [1] 아니오 (성별만 변경한다)
	$INPUT_LOOP_K[[キャラ:맘몬]]_1_SETUP
	INPUT
	IF RESULT == 0
		PRINTFORMW 구상 내용에 맞춰 소질 등을 변경합니다──
		
		CALLNAME = マモン
		CSTR:이인칭 = 召喚者
		CSTR:일인칭 = 私
		;肉体系素質の変更
		TALENT:남자 = 0
		TALENT:처녀 = 1
		TALENT:슬렌더 = 1
		;元の手足とか人型してるので人化はいらない？
		;TALENT:인간화 = 1
		TALENT:갈퀴 = 0
		TALENT:갈퀴발 = 0
		;CSV初期素質からの変更
		;金を集めることに余念がないことを想定しているので変更
		TALENT:습득느림 = 0
		TALENT:습득빠름 = 1
		;快感に素直ではない等そちら方面が薄いキャラなので元CSVから変更
		TALENT:쾌감에솔직 = 0
		TALENT:중독되기쉬움 = 0
		TALENT:불결무시 = 0
		;戦闘時に特定の忠誠度の上がりやすさと多分汎用口上で使うもの、本口上のイメージと沿わないと思われるので変更（足してから消さないと動かない？）
		TALENT:교만 = 1
		TALENT:우둔 = 0
		;初回調教時で媚びモードに入った場合、抑圧も消す
		
		;外見設定
		CSTR:머리색 = 赤
		CSTR:체형 = 투사이드업
		CSTR:눈동자색 = 金色
		CSTR:피부색 = 白色
		
		;衣装設定
		CFLAG:TARGET:초기전신복 = [[衣装:이브닝드레스(V넥)]]
		CFLAG:TARGET:전신복 = [[衣装:이브닝드레스(V넥)]]
		TEQUIP:TARGET:전신복 = [[衣装:이브닝드레스(V넥)]]
		CFLAG:TARGET:초기속옷（하） = [[衣装:레이스달린팬티]]
		CFLAG:TARGET:속옷（하） = [[衣装:레이스달린팬티]]
		TEQUIP:TARGET:속옷（하） = [[衣装:레이스달린팬티]]
		CFLAG:TARGET:초기손 = [[衣装:레이스달린장갑]]
		CFLAG:TARGET:손 = [[衣装:레이스달린장갑]]
		TEQUIP:TARGET:손 = [[衣装:레이스달린장갑]]
		CFLAG:TARGET:초기신발 = [[衣装:뮬]]
		CFLAG:TARGET:신발 = [[衣装:뮬]]
		TEQUIP:TARGET:신발 = [[衣装:뮬]]
		CFLAG:TARGET:초기겉옷 = [[衣装:코트]]
		CFLAG:TARGET:겉옷 = [[衣装:코트]]
		TEQUIP:TARGET:겉옷 = [[衣装:코트]]
		;狐の襟巻き
		CFLAG:TARGET:초기그외 = [[衣装:스톨]]
		CFLAG:TARGET:그외 = [[衣装:스톨]]
		TEQUIP:TARGET:그외 = [[衣装:스톨]]
		
	ELSEIF RESULT == 1
		PRINTFORMW 성별만 변경합니다──
		
		CALLNAME = マモン
		CSTR:이인칭 = 召喚者
		CSTR:일인칭 = 私
		;肉体系素質の変更
		TALENT:남자 = 0
		TALENT:처녀 = 1
	ELSE
		GOTO INPUT_LOOP_K[[キャラ:맘몬]]_1_SETUP
	ENDIF
	
	CFLAG:220 = 1
ENDIF
