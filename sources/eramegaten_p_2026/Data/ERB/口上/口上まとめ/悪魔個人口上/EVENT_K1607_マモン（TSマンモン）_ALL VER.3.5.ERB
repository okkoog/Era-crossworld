;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	;念のためモードのフラグを0にセット
	CFLAG:800 = 0
	;支払う魔貨の金額を変数にセット（とりあえず契約の半額と同等の魔貨）
	PayMoney = 10000
	
	KSTR:(K++) = 「召喚に応じ参上したわ。ありがたく思いなさい」
	KSTR:(K++) = マンモンを呼び出したはずが、現れたのはドレスにコート、ついでに襟巻き装備の女。
	KSTR:(K++) = どういうことかと考えていると、
	KSTR:(K++) = 「%CSTR:일인칭%、無駄なことは嫌いなの。
	KSTR:(K++) = 　%CSTR:이인칭%がそういうビズをしているのは知っているし、であればこの姿の方が手っ取り早いでしょう？」
	WSTR:(K++) = 時間の無駄を省いてくれたということらしい。
	KSTR:(K++) = 　
	KSTR:(K++) = 「ここまで%CSTR:일인칭%がサーヴィスしてあげたのだから、何かあってもいいんじゃなくて？」
	KSTR:(K++) = そう言って、手指をくいくいと動かし何か寄越せというようなジェスチャーをする。
	
	;魔貨所持数で分岐
	IF MONEY:1 >= PayMoney
		WSTR:(K++) = 　
		KSTR:(K++) = [0] 誠意を見せる（%TOSTR(PayMoney)%魔貨払う）
		KSTR:(K++) = [1] 黙っている。
		$INPUT_LOOP_PAY_K[[キャラ:맘몬]]_1
		CALL 口上変数表示,,1
		CALL 口上変数初期化
		INPUT
		;支払う
		IF RESULT == 0
			;媚びモードにセット
			CFLAG:800 = 2
			;抑圧の削除
			TALENT:억압 = 0
			;屈服刻印LV2
			MARK:2 = 2
			;魔貨の支払い
			MONEY:1 -= PayMoney
			KSTR:(K++) = 　
			KSTR:(K++) = であれば、と%CALLNAME:MASTER%は%TOSTR(PayMoney)%魔貨を目の前に放り出した。
			KSTR:(K++) = 「……」
			KSTR:(K++) = 大きく開いた目をぱちぱちとさせ、
			KSTR:(K++) = 「流石%CSTR:일인칭%の%CSTR:이인칭%だわ！
			KSTR:(K++) = 　お金の使い方使うべきところがどういうものかしっかり理解しているのね！」
			KSTR:(K++) = にかやなか顔のそばに合わせた両手を添えて早口で捲し立てた後、
			WSTR:(K++) = 間髪入れずに財布らしきものを懐から取り出し、その中に魔貨を吸い込んでいく。
			KSTR:(K++) = 　
			KSTR:(K++) = 魔貨がすべて財布に呑まれた後、女は何事もなかったように、
			KSTR:(K++) = 「改めてマンモン……いえ、%CALLNAME%よ」
			KSTR:(K++) = そう言って%CALLNAME%は%CALLNAME:MASTER%に近づき、
			KSTR:(K++) = 「ちゅっ」
			WSTR:(K++) = 右の手指で作ったキツネで%CALLNAME:MASTER%の頬に口付けた。
		;支払わない
		ELSEIF RESULT == 1
			;高慢モードにセット
			CFLAG:800 = 1
			KSTR:(K++) = 　
			KSTR:(K++) = ……。
			KSTR:(K++) = 「はあ、もういいわ。このまま待っていても無駄でしょうし」
			KSTR:(K++) = 目を伏せてため息を吐く。
			KSTR:(K++) = 「改めてマンモン……いえ、%CALLNAME%よ。
			WSTR:(K++) = %CSTR:이인칭%のビズが無駄にならないことを祈るわ」
		ELSE
			GOTO INPUT_LOOP_PAY_K[[キャラ:맘몬]]_1
		ENDIF
	;所持魔貨が分岐条件に足りなかった＝支払わなかった場合と同じ
	ELSE
		;高慢モードにセット
		CFLAG:800 = 1
		WSTR:(K++) = 　
		KSTR:(K++) = ……。
		KSTR:(K++) = 「はあ、もういいわ。このまま待っていても無駄でしょうし」
		KSTR:(K++) = 目を伏せてため息を吐く。
		KSTR:(K++) = 「改めてマンモン……いえ、%CALLNAME%よ。
		WSTR:(K++) = 　%CSTR:이인칭%のビズが無駄にならないことを祈るわ」
	ENDIF
	
	CFLAG:201 = 1
	GOTO 表示
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	KSTR:(K++) = 「%CSTR:일인칭%も暇じゃないから対価が欲しいのだけれど」
	KSTR:(K++) = %CALLNAME%はそう言って%CALLNAME:MASTER%に触れる。
	KSTR:(K++) = 「まあ、後払いでいいわ」
	WSTR:(K++) = 身体を離してベッドに座り込んだ。
	CFLAG:201 = 2
	GOTO 表示
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	;高慢モード
	IF CFLAG:800 == 1
		KSTR:(K++) = 「%CSTR:이인칭%も飽きないわね」
		KSTR:(K++) = こちらの準備を待つ間、%CALLNAME%は爪の状態を確認している。
		KSTR:(K++) = 「ねえ、%CSTR:이인칭%はどんな色がいいと思う？金とかどう？」
		WSTR:(K++) = こちらに指、爪を見せてきた。
	;媚びモード（高慢モードじゃないなら媚びモード）
	ELSE
		KSTR:(K++) = 「始めるのね、いいわよ」
		KSTR:(K++) = %CALLNAME%はにっこりと笑って%CALLNAME:MASTER%の手を取る。
		KSTR:(K++) = 「どこから触る？」
		WSTR:(K++) = 猛禽のような金の目がこちらの目を覗き込んでくる。
	ENDIF
	CFLAG:201 = 3
	GOTO 表示
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:연모 == 0 && TALENT:음란 == 0 && TALENT:복종 == 0 && TALENT:친애 == 0 && TALENT:창부 == 0 && TALENT:예속 == 0)
	;高慢モード
	IF CFLAG:800 == 1
		KSTR:(K++) = 「ご苦労なことよね」
		KSTR:(K++) = %CALLNAME:MASTER%が調教の準備を進めていると、
		WSTR:(K++) = %CALLNAME%はいつの間にか用意していたテーブルとティーセットでお茶を飲んでいた。
		KSTR:(K++) = 　
		KSTR:(K++) = 「……何？ああこれ？いいでしょう！？
		KSTR:(K++) = 　テーブルもティーセットも高級品なのよ！」
		KSTR:(K++) = そう言いながらカップのお茶を飲み干す%CALLNAME%。
		KSTR:(K++) = それらは普段使いしてよいものなのか聞いてみたが、
		KSTR:(K++) = 「変なことを気にするのね。道具なんだから使うのが当たり前でしょう？
		KSTR:(K++) = 　……汚れ？洗えばいいじゃない」
		KSTR:(K++) = 汚れや使用することで価値は減らないと思っているらしい。
		WSTR:(K++) = ……一方で、ゴミ箱には安物のティーパックが捨てられていた。
	;媚びモード（高慢モードじゃないなら媚びモード）
	ELSE
		KSTR:(K++) = 「ご苦労様、でもその前に少しお茶しない？」
		WSTR:(K++) = %CALLNAME%はいつの間にか用意していたテーブルとティーセットでお茶の準備をしていた。
		KSTR:(K++) = 　
		KSTR:(K++) = 「これ？いいでしょう！テーブルもティーセットも高級品なのよ！
		KSTR:(K++) = 　高かったのだけど%CSTR:이인칭%のおかげで買えたわ！」
		KSTR:(K++) = どうやらあの時渡した魔貨で買ったものらしい。
		KSTR:(K++) = あれを全額つぎ込んだのか違うのか分からないが、普段使いしてよいものなのだろうか……。
		KSTR:(K++) = 「？汚れは洗えばいいでしょう？道具は使うのが当たり前なんだから」
		KSTR:(K++) = きょとんとした顔をしながらこちらにカップを差し出してくる。
		WSTR:(K++) = ……香り、味。お茶は安物だった。
	ENDIF
	CFLAG:201 = 4
	GOTO 表示
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:연모 || TALENT:음란 || TALENT:복종)
	;연모
	IF TALENT:연모
		IF CFLAG:미조교함락 == 1
