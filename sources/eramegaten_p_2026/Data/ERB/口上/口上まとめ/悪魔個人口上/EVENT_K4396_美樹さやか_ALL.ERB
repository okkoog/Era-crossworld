	ELSE
		BTL_KOJO_RESULTS:0 = 一件落着、って感じかな？
	ENDIF
	;レベルアップした
	CASE 91
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = おお、なんかマジカルな力が満ちてきた…！
			ELSE
				BTL_KOJO_RESULTS:0 = 自分をホメてあげたい気分
			ENDIF
	;逃走に成功した
	CASE 92
