	;逃走に失敗した
	CASE 93
			BTL_KOJO_RESULTS:0 = ごめーん、ってわけにはいかないか……
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = その気になれば、体の痛みなんて……！
