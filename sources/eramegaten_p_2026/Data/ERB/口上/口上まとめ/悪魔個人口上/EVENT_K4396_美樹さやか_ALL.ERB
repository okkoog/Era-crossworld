		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = こいつでどう！？
			ELSE
				BTL_KOJO_RESULTS:0 = いえーす！
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
