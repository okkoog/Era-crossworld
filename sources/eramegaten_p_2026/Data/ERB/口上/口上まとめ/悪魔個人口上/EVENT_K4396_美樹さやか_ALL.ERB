	;回避した
	CASE 18
			BTL_KOJO_RESULTS:0 = なんとおーっ！
	;反撃スキル発動した
	CASE 20
			BTL_KOJO_RESULTS:0 = お返しだあっ
	;バトルに勝利した
	CASE 90
	IF RAND:2 == 0
