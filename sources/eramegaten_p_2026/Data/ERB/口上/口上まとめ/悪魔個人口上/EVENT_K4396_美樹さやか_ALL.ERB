		BTL_KOJO_RESULTS:0 = よーし、行きますか！
	ELSE
		BTL_KOJO_RESULTS:0 = まっかせなさーい！
	ENDIF
		ENDIF
	;被召喚時
	CASE 3
			BTL_KOJO_RESULTS:0 = 
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
