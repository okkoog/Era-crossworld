@BATTLE_EVENT_K[[キャラ:레비아탄]]_1, ARG, ARG:1, ARG:2
;■台詞の行数を増やしたいときは
;			LOCALS:10 = 一行目
;			LOCALS:11 = 二行目
;			LOCALS:12 = 三行目
;			LOCALS:13 = 四行目
;			LOCALS:14 = 五行目
;と増やしていく
SIF ARG < 0 && NO:ARG != 718
	RETURN 0
VARSET LOCALS

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		LOCALS:10 = 나중에 맡길게.
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			LOCALS:10 = 계속 될거야.
		;それ以外
		ELSE
			LOCALS:10 = 그 틈은 놓치지 않는다.
		ENDIF
	;被召喚時
	CASE 3
			LOCALS:10 = 부르기 때문에, 상응하는 일을 할거야.
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			CALL IS_TARGET_BOSS, ARG
			;対象がボス
			IF RESULT > 0
				LOCALS:10 = 아무리 강하려 하면, 우리만큼은 아니다, 라고 말할 뿐의 이야기네.
			ELSE
				LOCALS:10 = 기어 걷어차십시오, 먼지.
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				LOCALS:10 = 나를 따르십시오.
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			LOCALS:10 = 아직 서 있는거야, 질투스럽다.
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			LOCALS:10 = 함부로 단단하네.
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
