@KOJO_BATTLE_EVENT_K[[キャラ:살라만더]]_1, ARG, ARG:1, ARG:2
;-------------------------------------------------

SIF ARG < 0 && NO:ARG != 513
	RETURN 0
LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;LOCALS = EMPTY

;崩壊してるか反発刻印3の場合は口上表示しない
SIF TALENT:ARG:9 || MARK:ARG:3 == 3
	RETURN 0

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 하핫!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 안 놓친다아……!
		ELSE
			BTL_KOJO_RESULTS:0 = 빈틈 보이지 마라!
		ENDIF
	;COOP参加
	CASE 2
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			IF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%만 눈에 띄고 자빠졌잖아 임마!
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 좋았어! 불타라앗!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 아앙!?
			ELSE
				BTL_KOJO_RESULTS:0 = 좋았어 %CSTR:이인칭%도 해치워!
			ENDIF
		ELSE
			IF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:일인칭%보다 눈에 띄지 마라아!
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 잘했다!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 해냈구만!
			ELSE
				BTL_KOJO_RESULTS:0 = 어이 어이 방해다 비켜라앗!
			ENDIF
		ENDIF
	;被召喚時
	CASE 3
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = %CSTR:일인칭%한테 나설 자릴 내놔라앗!
		ELSEIF RAND:2 == 0
			LOCAL:1 = 2
			BTL_KOJO_RESULTS:0 = %CSTR:일인칭%이 온 이상은 말이지이!
			BTL_KOJO_RESULTS:1 = 재조차 안 남겨줄 테니까 말이다앗!
		ELSE
			LOCAL:1 = 2
			BTL_KOJO_RESULTS:0 = %CSTR:일인칭%한테 꽃길을 내줬구만!
			BTL_KOJO_RESULTS:1 = 좋아, 화려하게 불태워주지이!
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 화장은 필요 없겠네
				ELSE
					BTL_KOJO_RESULTS:0 = 햐하하!
				ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 장난치지 마라 임마아!
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 아직 덜 탔냐?
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = 화력이 부족해
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = 하아!?
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 네 녀석……
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = %CSTR:일인칭%이 먼저 쓰러지면 폼 안 나잖아 임마!
			ELSE
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 빌어먹을……
				ELSE
					BTL_KOJO_RESULTS:0 = 아……프지도 않다고……
				ENDIF
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 아?
			ELSE
				BTL_KOJO_RESULTS:0 = 장난치는 거 아니다
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 하?
			ELSE
				BTL_KOJO_RESULTS:0 = 위로질하지 마라
			ENDIF
		ENDIF
	;反射された
	CASE 15
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 아!?
		ELSE
			BTL_KOJO_RESULTS:0 = 이 자식이!
		ENDIF
	;反射した
	CASE 16
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 흥!
		ELSE
			BTL_KOJO_RESULTS:0 = 안 통한다구
		ENDIF
	;回避された
	CASE 17
		IF RAND:8 == 0
			BTL_KOJO_RESULTS:0 = 아
		ELSEIF RAND:7 == 0
			BTL_KOJO_RESULTS:0 = …………
		ELSEIF RAND:6 == 0
			BTL_KOJO_RESULTS:0 = 멍청이가!
		ELSEIF RAND:5 == 0
			BTL_KOJO_RESULTS:0 = 앗 네 녀석
		ELSEIF RAND:4 == 0
			BTL_KOJO_RESULTS:0 = 윽
		ELSEIF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 맞으라고!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 피하지 마!
		ELSE
			BTL_KOJO_RESULTS:0 = 이, 이 자식이……
		ENDIF
	;回避した
	CASE 18
		IF RAND:8 == 0
			BTL_KOJO_RESULTS:0 = 맞을 것 같냐
		ELSEIF RAND:7 == 0
			BTL_KOJO_RESULTS:0 = 앙?
		ELSEIF RAND:6 == 0
			BTL_KOJO_RESULTS:0 = 그걸로 맞겠냐
		ELSEIF RAND:5 == 0
			BTL_KOJO_RESULTS:0 = 겁먹은 건 아닐 테지
		ELSEIF RAND:4 == 0
			BTL_KOJO_RESULTS:0 = 불은 싫냐?
		ELSEIF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = %CSTR:일인칭% 다리는 길어서 말이지이
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 흥
		ELSE
			BTL_KOJO_RESULTS:0 = 눈알 갈아 끼워줄까?
		ENDIF
ENDSELECT
