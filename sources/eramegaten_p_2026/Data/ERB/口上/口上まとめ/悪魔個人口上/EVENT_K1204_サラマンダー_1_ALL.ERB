;-------------------------------------------------
;調教者の射精時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;△射精箇所変更時のテキスト
;軽度の地獄分岐！
;-------------------------------------------------
IF CFLAG:106
	CALL PALAM_MESSAGE_A
	;머리카락
	IF CFLAG:106 == 1
		;陥落済み
		IF 陥落(TARGET) && (CFLAG:221 < 3 || FLAG:7 == 2)
			IF RAND:3 == 0
				PRINTFORMW 「실수로 태워 먹지 마라……」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「취향에 왈가왈부하진 않겠지만」
			ELSE
				PRINTFORMW 「그게 좋은 거지? 들었거든」
			ENDIF
			CFLAG:221 = 3
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3 && (CFLAG:221 < 2 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:221 = 2
		;それ以外
		ELSEIF CFLAG:221 < 1 || FLAG:7 == 2
			PRINTFORMW 
			CFLAG:221 = 1
		ENDIF
	;顔
	ELSEIF CFLAG:106 == 2
		;陥落済み
		IF 陥落(TARGET) && (CFLAG:222 < 3 || FLAG:7 == 2)
			IF RAND:3 == 0
				PRINTFORMW 「효율을 따지면 입안이 더 낫겠지만 말이야」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「%CSTR:일인칭% 얼굴에 뿌리는 게 좋은 거지? 알고 있다고」
			ELSE
				PRINTFORMW 「뭐어, 화낼 정도로 나쁘진 않아」
			ENDIF
