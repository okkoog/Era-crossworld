;-------------------------------------------------
;◎調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0
	PRINTFORML 하나같이 스터드로 커스텀된 가죽 재킷과 가죽 팬츠, 부츠……
	PRINTFORM 크게 벌어진 재킷 아래로는 딱히 아무것도 입지 않은 모양이라,
		;男の娘って乳増やせたよな
		IF TALENT:남자 == 0 || TALENT:오토코노코
			;절벽
			IF TALENT:절벽
				PRINT 거의 굴곡 없는 가슴
			;빈유
			ELSEIF TALENT:빈유
				PRINT 조촐한 부픎
			;거유
			ELSEIF TALENT:거유
				PRINT 풍만한 유방
			;폭유
			ELSEIF BUST() > 4
				PRINT 금방이라도 흘러넘칠 듯한 쌍구
			;普通
			ELSE
				PRINT 얌전한 골
			ENDIF
		ELSE
				PRINT 胸板
		ENDIF
	PRINTFORML 이 거의 다 드러나 있다.
	PRINTFORMW 문자 그대로 불타오르는 붉은 머리를 눈감아준다면 기합 들어간 펑크 로커 같은 분위기지만, 어엿한 살라맨더다.
	PRINTL 
	PRINTFORMW 「__P0__가 인간 모습이 되라고 했잖아? 불만 있냐」
	PRINTL 
	PRINTFORMW 인간에 가까운 모습 탓인지 유창하게 말하지만, 근본의 거친 기성은 변함없는 모양이다……
	PRINTL 
ENDIF
IF CFLAG:201 == 0 && TALENT:연모 == 0
	PRINTFORML 「그래서? 볼일이 뭔데. 설마 고기라도 구우란 소린 안 하겠지」
	PRINTFORMW 「……아앙?」
	PRINTL 
	PRINTFORML 「되물은 거 아니거든, 두 번 말 안 해도 알아듣는다고. 노예 키우고 있는 거잖아 %CSTR:이인칭%」
	PRINTFORMW 「어울려 주긴 하겠지만, 계약 범위 밖으로 발 들이면 진짜로 태워버릴 테니까」
	CFLAG:201 = 1
	RETURN 0
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	PRINTFORML 「여어」
	PRINTFORMW 「어떠냐 경기는? 좀 벌리고 있냐?」
	CFLAG:201 = 2
	RETURN 0
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	PRINTFORML 「__P0__ 이봐, 인간 중에서는 좀 잘하는 편이냐? 어때?」
	PRINTFORMW 「호오…… 그런 거야……」
	CFLAG:201 = 3
	RETURN 0
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORML 「재밌어졌는데」
	PRINTFORMW 「그렇다는 건 %CSTR:일인칭%도 팔릴 만한 상품이 된다는 거냐? 아직 멀었냐?」
	CFLAG:201 = 4
	RETURN 0
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		IF CFLAG:미조교함락 == 1
			;調教せずに恋慕をつけた場合
			PRINTFORML 「그래서? 애써 불러낸 용건이 뭔데. 고기라면 이런 비좁은 데선 못 굽는다고」
			PRINTFORMW 「……아앙?」
			PRINTL 
			PRINTFORML 「좋아. __P0__ 녀석은 그럭저럭 맘에 들었으니까」
			PRINTFORMW 「이 모습이면 짝처럼 보이냐? 해줘도 괜찮은데, 그런 거」
		ELSE
			PRINTFORML 「인간의 짝이란 건 뭘 하는 건데?」
			PRINTFORMW 「역시 애 만들기냐? 딴 건?」
			PRINTL 
			PRINTFORML 「흐응…… 데이트, 장난치기, 얘기 나누기뿐……」
			PRINTFORMW 「더럽게 지루해 보이는데. __P0__, 안 질리냐?」
		ENDIF
	;음란
	ELSEIF TALENT:4
		PRINTFORML 「__P0__ 취향에 맞는다면 당장 덮쳐도 상관은 없는데」
		PRINTFORMW 「분위기 잡는 거 신경 쓰는 타입이냐? 어때?」
		PRINTL 
		PRINTFORML 「……뭐야, 불만이라도 있냐」
		PRINTFORMW 「기다려도 못 하게 만들 셈이냐? 관둬라, 그런 거 불타오르잖아」
	;복종
	ELSEIF TALENT:5
		CSTR:일인칭 = 나
		PRINTFORML 「__P0__ 말곤 명령 안 들 거고」
		PRINTFORMW 「__P0__ 말고는 절대 이런 거 안 시켜줄 거야, __P1__는 __P2__ 거니까」
		PRINTL 
		PRINTFORML 「……뭐야, 불만이야?」
		PRINTFORMW 「%CSTR:일인칭% 나름대로는 솔직하게 구는 건데 말이지, 이래 봬도」
	ENDIF
	CFLAG:201 = 5
	RETURN 0
;上位陥落
ELSEIF CFLAG:201 < 6 && (TALENT:6 || TALENT:7 || TALENT:8)
	;친애
	IF TALENT:6
		PRINTFORML 「짝 흉내라는 것도 의외로 재밌네」
		PRINTFORMW 「%CSTR:일인칭%은 인간이랑 짝이 돼본 적이 없으니까 말이야」
		PRINTL 
		PRINTFORML 「……앙? 흉내가 아니라고? 뭔 소리야 임마」
		PRINTFORMW 「진심으로 %CSTR:일인칭%이랑 짝이 되겠다는 거야? 흐, 흐응……」
	;창부
	ELSEIF TALENT:7
		PRINTFORML 「진짜로 기다려도 못 하는 __P0__가 되면 어쩌려고 그래 __P1__」
		PRINTFORMW 「MAG 찌꺼기가 되더라도 안 놔줄 거다……」
		PRINTL 
		PRINTFORML 「…………」
		PRINTFORMW 「유혹하고 있잖아! 분위기 좀 타라고! 젠장, 튕겨보면 불타오를 줄 알았더니만!」
	;예속
	ELSEIF TALENT:8
		PRINTFORML 「주인니임%UNICODE(0x2661)% 이라고라도 하라는 거야? 무리거든」
		PRINTFORMW 「어울리기는커녕 딴판이잖아? 그럴 바엔 실프나 운디네 쪽이 훨씬 낫지」
		PRINTL 
		PRINTFORML 「맘에 드는 노예가 되려고는 하고 있는데…… 명령은 듣고 있잖아?」
		PRINTFORMW 「진짜 맘에 안 들면 합체를 하든 팔아치우든, 맘대로 해」
	ENDIF
	CFLAG:201 = 6
	RETURN 0
;契約後
ELSEIF CFLAG:201 < 7 && (TALENT:170 || TALENT:171 || TALENT:172 || TALENT:173)
	;結婚
	IF TALENT:170 || TALENT:171
		PRINTFORML 「그나저나, 용케 안 녹네」
		PRINTFORMW 「그런 마법 부여라도 걸려 있는 건가? ……%CSTR:일인칭%은 안 봐주고 있다고」
	;낙인
	ELSEIF TALENT:172
		PRINTFORML 「인간한테는 문신으로밖에 안 보인다더만…… 그래서 이런 곳에 새긴 거지?」
		PRINTFORMW 「뭐, 악마를 조금이라도 아는 녀석이면 들통나겠지만 말이야」
	;개목걸이
	ELSEIF TALENT:173
		PRINTFORML 「그나저나, 용케 안 타네」
		PRINTFORMW 「아? ……흥분하면 체온 올라간다고, %CSTR:일인칭%. 말 안 해줬던가?」
	ENDIF
	CFLAG:201 = 7
	RETURN 0
