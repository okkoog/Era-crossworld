			;その他
			CASEELSE
				BTL_KOJO_RESULTS:0 = 状況把握……最適解検索……完了　連動行動開始
		ENDSELECT
	;バッドステータスを受けた
	CASE "被バステ付着"
		;現在の状態で分岐
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				BTL_KOJO_RESULTS:0 = 
			CASE "SHOCK","FREEZE","BIND","PALYZE"
