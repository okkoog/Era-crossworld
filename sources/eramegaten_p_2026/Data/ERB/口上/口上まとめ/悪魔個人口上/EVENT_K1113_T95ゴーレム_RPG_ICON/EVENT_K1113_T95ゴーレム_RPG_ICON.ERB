	;反撃を発動した
	CASE "反撃発動"
		SELECTCASE TFLAG:발동연동스킬
			;例えば「ダッジカウンターが発動した場合」を指定したい場合は、スキル番号2484を指定する
			CASE [[스킬:닷지카운터]]
				BTL_KOJO_RESULTS:0 = 自動迎撃
			;その他
			CASEELSE
				BTL_KOJO_RESULTS:0 = 自動迎撃
		ENDSELECT
	;トリガースキルを発動した
	CASE "追撃発動"
		SELECTCASE TFLAG:발동연동스킬
			;スキルを指定したい場合、反撃と同様、対象スキルの番号をCASEに記載する
			;CASE (対象スキル番号)
