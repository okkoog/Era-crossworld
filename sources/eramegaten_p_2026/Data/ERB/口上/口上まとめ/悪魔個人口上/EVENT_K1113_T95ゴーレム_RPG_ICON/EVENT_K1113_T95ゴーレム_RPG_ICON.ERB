@KOJO_BATTLE_EVENT_K[[キャラ:T95골렘]], ARG, ARG:1, ARG:2
SELECTCASE GET_BATTLE_EVENT(TFLAG:전투이벤트)
	;COOP発動 発動者の番号はARGに格納されている
	CASE "COOP発動"
		BTL_KOJO_RESULTS:0 = 状況誘導……成功　スピーカーON……「ワレニツヅケ」
	;COOP参加
	CASE "COOP参加"
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = 状況把握……最適解検索……完了　最優先行動　追撃開始
		;それ以外
		ELSE
			BTL_KOJO_RESULTS:0 = 状況把握……最適解検索……完了　支援攻撃開始
		ENDIF
	;被召喚時（マシンの特性上、想定してないので）
	CASE "被召喚"
		BTL_KOJO_RESULTS:0 = ………　！？！？！？！？
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE "与ダメージ_単体"
		;味方に攻撃した
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 目標撃破
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 効果絶大
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 攻撃効果　大
		;ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = 
		;小ダメージ（１以上）
		ELSEIF ARG:2 > 0
			BTL_KOJO_RESULTS:0 = 攻撃効果　不明
		;ダメージなし（無効・吸収を含む）
		ELSE
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;反射された
	CASE "反射された"
		BTL_KOJO_RESULTS:0 = 攻撃方法　不適格
	;回避された
	CASE "回避された"
		BTL_KOJO_RESULTS:0 = 
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE "被ダメージ_単体"
		;味方に攻撃された
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			BTL_KOJO_RESULTS:0 =  ………
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 大破
		;瀕死
		ELSEIF 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = 各部　緊急停止
		;ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			BTL_KOJO_RESULTS:0 = 被弾
		;小ダメージ
		ELSE
			BTL_KOJO_RESULTS:0 = 被弾　損害軽微
		ENDIF
	;無効化した
	CASE "無効化した"
		;吸収した
		IF GET_CREC_ACT(ARG:1, ARG, "DRAIN")
			BTL_KOJO_RESULTS:0 =  ………　！？
		;無効化した
		ELSE
			BTL_KOJO_RESULTS:0 = ………
		ENDIF
	;反射した
	CASE "反射した"
		BTL_KOJO_RESULTS:0 = ………　！？
	;回避した
	CASE "回避した"
		BTL_KOJO_RESULTS:0 = ………
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE "与ダメージ_範囲_ランダム"
		;全弾命中した
		IF GET_CREC_ACT_SUM(ARG, "敵", "MISS/BLOCK/DRAIN/REFLECT") == 0
			;BTL_KOJO_RESULTS:0 = 全弾命中
		;全弾回避された
		ELSEIF GET_CREC_ACT_SUM(ARG, "敵", "HIT") == 0
			BTL_KOJO_RESULTS:0 = 攻撃方法　不適格
		;普通
		ELSE
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE "与ダメージ_範囲_ランダム_撃破あり"
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			BTL_KOJO_RESULTS:0 = 全目標　撃破
		ELSE
			BTL_KOJO_RESULTS:0 = 全目標撃破　目標再選定開始
		ENDIF
	;敵味方全体攻撃(詳細処理無し)
	;CASE "敵味方全体攻撃"
