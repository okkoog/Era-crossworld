			CASE "PANIC"
				BTL_KOJO_RESULTS:0 = 警告　電脳攻撃
			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 = 管制機器　異常発生中
			;CASE "CLOSE"
			CASE "POISON"
				BTL_KOJO_RESULTS:0 = 総員　対化学戦防御
			;CASE "BOMB"
			CASE "CHARM"
				BTL_KOJO_RESULTS:0 = 警告　電脳攻撃
			;CASE "CURSE"
			;CASE "FLY"
			;CASE "STONE"
			CASE "FLAME"
				BTL_KOJO_RESULTS:0 = 火災発生
			CASE "SLIP"
				BTL_KOJO_RESULTS:0 = 駆動機関不調
			CASE "DYING"
				BTL_KOJO_RESULTS:0 = 機能停止
			;CASE "BRAND"
			;その他の状態
			CASEELSE
				;DYING状態ではないがDYINGを受け、その行動で食いしばりが発動した。つまり即死を食いしばりした場合
				IF GET_STATE(CFLAG:ARG:상태이상) != "DYING" && GET_CREC_ACT(ARG:1, ARG, "BAD_STATE", "DYING") && CFLAG:ARG:이악물기발동
					BTL_KOJO_RESULTS:0 = 
				ENDIF
		ENDSELECT
	;食いしばり等で耐えた。バステで食いしばりした場合は被バステ付着の分岐に入るのでここには来ない
	CASE "이악물기발동"
		;이악물기
		IF BASE:ARG:ＨＰ == 1
			BTL_KOJO_RESULTS:0 = 予備回路　緊急起動
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = 予備回路　緊急起動　各部再起動開始
		ENDIF
	;回復してもらった
	CASE "被回復"
		;ARG:2　回復量
		LOCAL = ARG:2 * 100 / BASE:ARG:ＨＰ
		;LOCAL　回復量割合
		IF 0
		;キャラ分岐（「特定の相手に回復してもらった」場合）
		;XXXXを対象のキャラ番号に置換して使う
		ELSEIF NO:(ARG:1) == 4999
			BTL_KOJO_RESULTS:0 = 회복
		;50%以上 & HPほぼ満タン
		ELSEIF LOCAL > 50 && 現HP割合(ARG) > 90
			BTL_KOJO_RESULTS:0 = 完全回復
		;50%以上
		ELSEIF LOCAL > 50
			BTL_KOJO_RESULTS:0 = 中破
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = 異常発生
		ENDIF
	;状態異常を直してもらった
	CASE "被バステ治癒"
		;ARG:2　直ったバステ
		IF 0
		;キャラ分岐（「特定の相手に回復してもらった」場合）
		;ELSEIF NO:(ARG:1) == XXXX
		ELSE
			SELECTCASE GET_STATE(ARG:2)
				CASE "SLEEP"
					BTL_KOJO_RESULTS:0 = 電脳攻撃　対処完了
				;その他の状態異常
				CASEELSE
					BTL_KOJO_RESULTS:0 = 機能回復
			ENDSELECT
		ENDIF
;	;戦闘中イって行動不能にならず耐えた(ムフフ展開時のみ)
;	CASE "戦闘中イって行動不能にならず耐えた"
;		;歯を食いしばって快楽に耐えた
