;-------------------------------------------------
;ライセンスフリー
;-------------------------------------------------
;TSアジ・ダハーカ口上のRPG部分
;TS口上なので追番付き（選択するまで戦闘口上を表示させない）
;口上適用済みだが未調教の時用の処理をコメントアウトで仕込み中。本体側で設定されるフラグ等が分かればそれを条件とするか口上独自で設定するか
;アクションについてはメッセージごとにRAND:3で人格を選択する
;リアクション等については前回選択済みの人格フラグを参照する
;アクションしてから次のアクションまでは同じ人格のままということ
;戦闘口上側は人格固定はしない（ルートによっては戦闘用サブ人格というテイ）
;サブ人格1：元凶。使用する横文字は英語＋スペイン語
;メイン人格：サブ人格1を参考にしてしまった。使用する横文字はプログラム系、ポルトガル語
;サブ人格2：一応他に合わせた。使用する横文字はロシア語、英語
;CFLAG:804:戦闘口上用の人格フラグ、0が未設定、口上適用時に1・2・3のいずれかがセットされた状態でスタート
;2025/05/17		kuroyagi	新規作成
;-------------------------------------------------
;BTL_KOJO_RESULTSに書きこむと
;台詞と一緒にキャラの画像を表示します。
;■台詞の行数を増やしたいときは
;			BTL_KOJO_RESULTS:0 = 一行目
;			BTL_KOJO_RESULTS:1 = 二行目
;			BTL_KOJO_RESULTS:2 = 三行目
;			BTL_KOJO_RESULTS:3 = 四行目
;			BTL_KOJO_RESULTS:4 = 五行目
;と増やしていく
;メッセージ前に文章を出したいなら
;			PRINTL
;			PRINTL
;ナレーション的なもので囲いの中にならない
;
;例
;
;PRINTL あいうえお
;PRINTL かきくけこ
;BTL_KOJO_RESULTS:0 = さしすせそ
;BTL_KOJO_RESULTS:1 = たちつてと
;　　↓
;あいうえお
;かきくけこ
;┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
;┃さしすせそ　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
;┃たちつてと　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
;┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
;
;-------------------------------------------------

@KOJO_ENEMY_BATTLE_EVENT_K[[キャラ:아지・다하카]]_1, ARG, ARG:1, ARG:2
IF TFLAG:전투이벤트 == 1
;敵でのデビルＣＯ－ＯＰ発動時の台詞
;			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"",72,LEFT%┃
;			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF
IF TFLAG:전투이벤트 == 2
;敵でのデビルＣＯ－ＯＰ参加時の台詞
;			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"",72,LEFT%┃
;			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF


;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:아지・다하카]]_1, ARG, ARG:1, ARG:2
;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 776
	RETURN 0
VARSET BTL_KOJO_RESULTS
;VARSET KSTR

;口上適用したが未調教＝まだ女の姿になってないならセリフを入れてGOTOでこの処理の末に飛ぶ
;IF 条件
;	BTL_KOJO_RESULTS:0 = （アジ・ダハーカは唸り声を上げている）
;	GOTO BATTLE_MESSAGE_MADA1
;ENDIF

;KSTR:0 = 
;KSTR:1 = 
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF CFLAG:804 == 1
			BTL_KOJO_RESULTS:0 = 順序を変更、委譲する。
		ELSEIF CFLAG:804 == 2
			BTL_KOJO_RESULTS:0 = さぁ、これで終わりませんわよ？
		ELSE
			BTL_KOJO_RESULTS:0 = 後はお願いしますぅ……！
		ENDIF
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = Active. 追撃を実行する。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = 続きますわ！
			ELSE
				BTL_KOJO_RESULTS:0 = えぇ……自分もやるんですかぁ……？
			ENDIF
		;それ以外
		ELSE
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = Active. 追撃を実行する。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = 続きますわ！
			ELSE
				BTL_KOJO_RESULTS:0 = えぇ……自分もやるんですかぁ……？
			ENDIF
		ENDIF
	;被召喚時
	CASE 3
		SELECTCASE RAND:3
			CASE 0
				CFLAG:804 = 1
				BTL_KOJO_RESULTS:0 = 召喚。状況を開始する。
			CASE 1
				CFLAG:804 = 2
				BTL_KOJO_RESULTS:0 = お呼びに答えてワタクシ様参上しましたわ！
			CASE 2
				CFLAG:804 = 3
				BTL_KOJO_RESULTS:0 = ええっとぉ……もう帰っていいですかねぇ……。ダメ？
		ENDSELECT
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		CALLFORM SKILL_TYPE_{CFLAG:ARG:입력행동}
		LOCAL = MAXBASE:(ARG:1):GET_TYPE(RESULT)
		;味方に攻撃した
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 三分の一にはまだ遠い。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = アハハハハ！ザマぁ！！
			ELSE
				BTL_KOJO_RESULTS:0 = あは。弱っちぃんですねぇ……。
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF LOCAL > 100 && LOCAL < 999
			IF CFLAG:(ARG:1):방어플래그
				IF CFLAG:804 == 1
					BTL_KOJO_RESULTS:0 = Catch.
				ELSEIF CFLAG:804 == 2
					BTL_KOJO_RESULTS:0 = ワタクシ様に隙を見せましたわね？
				ELSE
					BTL_KOJO_RESULTS:0 = あれ？それ弱いんですねぇ……。
				ENDIF
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 善し。……善し。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = アハハハハ！
			ELSE
				BTL_KOJO_RESULTS:0 = えっ、これでまだ倒れないんですかぁ……。
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = ……善し。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = まだまだ遊べますわね？
			ELSE
				BTL_KOJO_RESULTS:0 = まだ倒れないぃ……。
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = ……。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = あ……？
			ELSE
				BTL_KOJO_RESULTS:0 = えっ。
			ENDIF
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = ……？
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = はああああ！？
			ELSE
				BTL_KOJO_RESULTS:0 = えぇ……もうお山に帰るぅ……。
			ENDIF
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;味方に攻撃された
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 終わ……は、まだ……い……。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = オマ……クル……めない……。
			ELSE
				BTL_KOJO_RESULTS:0 = お山に……かえ……るぅ……。
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 被害甚大……。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = いったいですわ！？
			ELSE
				BTL_KOJO_RESULTS:0 = 痛いのやだぁ……！
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 被害無し。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = 効きませんわよバーカ！
			ELSE
				BTL_KOJO_RESULTS:0 = いっ！……ったくない？よかったぁ……！
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = Absorption.
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = アハハハハ！御馳走様！！
			ELSE
				BTL_KOJO_RESULTS:0 = いっ！……あれ？
			ENDIF
		;瀕死
		ELSEIF 現HP割合(ARG) < 25
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 損耗率確認……。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = ちっ……くしょうめ……！
			ELSE
				BTL_KOJO_RESULTS:0 = いっ！？……やだぁ。お山に帰るぅ……。
			ENDIF
		;ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 被害程度、許容内。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = ちっ、痛いですわね。
			ELSE
				BTL_KOJO_RESULTS:0 = いった！？
			ENDIF
		;小ダメージ
		ELSE
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 被害最小。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = こんなのかすり傷ですわよ！
			ELSE
				BTL_KOJO_RESULTS:0 = いっ！……？大したことないんですねぇ……。
			ENDIF
		ENDIF
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE 13
		;全弾命中した
		IF ARG:2 == 0
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = Count_Hit 、最大。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = イエー！大当たりですわ！！
			ELSE
				BTL_KOJO_RESULTS:0 = うわ、のろまだったんですねぇ……。
			ENDIF
		;普通
		ELSEIF ARG:2 < ARG:1
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = Average. ……善し。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = ごめんあそばせー。
			ELSE
				BTL_KOJO_RESULTS:0 = 当たったぁ……！
			ENDIF
		;全弾回避された
		ELSEIF ARG:2 == ARG:1
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = ……？
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = はあ！？ふざけんじゃねえですわよ！！
			ELSE
				BTL_KOJO_RESULTS:0 = ……。自分もう帰っていいですかねぇ……。ダメ？
			ENDIF
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE 14
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = Count_Kill 、最大。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = よっしゃあー！ザマぁ見晒せ！！
			ELSE
				BTL_KOJO_RESULTS:0 = うわ、ザコばっかりだったんですねぇ……。
			ENDIF
		ELSE
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 三分の一にはまだ遠い。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = アハハハハ！ザマぁ！！
			ELSE
				BTL_KOJO_RESULTS:0 = ふぅ……。やっと倒れたぁ……。
			ENDIF
		ENDIF
	;反射された
	CASE 15
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = ……？
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = はああああ！？
			ELSE
				BTL_KOJO_RESULTS:0 = もうやだぁ……！
			ENDIF
	;反射した
	CASE 16
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 満ちよ、おぞましきものども。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = 汚い手でワタクシ様に触るんじゃねぇですわよ！
			ELSE
				BTL_KOJO_RESULTS:0 = ひぃ！自分痛いの嫌なんでやめてくださいぃ……。
			ENDIF
	;回避された
	CASE 17
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = ……？
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = はああああ！？
			ELSE
				BTL_KOJO_RESULTS:0 = えっ……？
			ENDIF
	;回避した
	CASE 18
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = ……？
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = どこ見てますの？目ぇ付いてます？
			ELSE
				BTL_KOJO_RESULTS:0 = ひっ！……あれ？
			ENDIF
	;敵味方全体攻撃(詳細処理無し)
	;CASE 19
	;		BTL_KOJO_RESULTS:0 = 
	;反撃を発動した
	CASE 20
		SELECTCASE TFLAG:발동연동스킬
		;닷지카운터
		CASE [[스킬:닷지카운터]]
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 満ちよ、おぞましきものども。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = 汚い手でワタクシ様に触るんじゃねぇですわよ！
			ELSE
				BTL_KOJO_RESULTS:0 = ひぃ！自分痛いの嫌なんでやめてくださいぃ……。
			ENDIF
		;その他
		CASEELSE
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 満ちよ、おぞましきものども。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = 汚い手でワタクシ様に触るんじゃねぇですわよ！
			ELSE
				BTL_KOJO_RESULTS:0 = ひぃ！自分痛いの嫌なんでやめてくださいぃ……。
			ENDIF
		ENDSELECT
	;トリガースキルを発動した
	CASE 21
		SELECTCASE TFLAG:발동연동스킬
		;○○
		;CASE 
		;	BTL_KOJO_RESULTS:0 = 
		;その他
		CASEELSE
			BTL_KOJO_RESULTS:0 = 
		ENDSELECT
	;バッドステータスを受けた
	CASE 22
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				IF CFLAG:804 == 1
					BTL_KOJO_RESULTS:0 = ……時が来た。
				ELSEIF CFLAG:804 == 2
					BTL_KOJO_RESULTS:0 = ああ！夢にまで見たモノが！！
				ELSE
					BTL_KOJO_RESULTS:0 = あぁ……。
				ENDIF
			CASE "SHOCK","FREEZE","BIND","PALYZE"
				IF CFLAG:804 == 1
					BTL_KOJO_RESULTS:0 = 状況、確認……。
				ELSEIF CFLAG:804 == 2
					BTL_KOJO_RESULTS:0 = ちっ……くしょう、め……！
				ELSE
					BTL_KOJO_RESULTS:0 = ぎっ！うえぇ……。
				ENDIF
			CASE "PANIC"
				IF CFLAG:804 == 1
					BTL_KOJO_RESULTS:0 = アァア……！！
				ELSEIF CFLAG:804 == 2
					BTL_KOJO_RESULTS:0 = いやあ！？火が！雷が！
				ELSE
					BTL_KOJO_RESULTS:0 = うええ……いやぁ……。
				ENDIF
			CASE "SLEEP"
				IF CFLAG:804 == 1
					BTL_KOJO_RESULTS:0 = すぅ……。
				ELSEIF CFLAG:804 == 2
					BTL_KOJO_RESULTS:0 = うぅん……。
				ELSE
					BTL_KOJO_RESULTS:0 = むにゃむにゃ……。
				ENDIF
			;CASE "CLOSE"
			CASE "POISON"
				IF CFLAG:804 == 1
					BTL_KOJO_RESULTS:0 = 状況、確認……。
				ELSEIF CFLAG:804 == 2
					BTL_KOJO_RESULTS:0 = ぐぬっ……！
				ELSE
					BTL_KOJO_RESULTS:0 = うえぇ……。
				ENDIF
			;CASE "BOMB"
			CASE "CHARM"
				IF CFLAG:804 == 1
					BTL_KOJO_RESULTS:0 = 状況、確認……？
				ELSEIF CFLAG:804 == 2
					BTL_KOJO_RESULTS:0 = あぁ、あの光を……。
				ELSE
					BTL_KOJO_RESULTS:0 = あぁ……。
				ENDIF
			;CASE "CURSE"
			;CASE "FLY"
			;CASE "STONE"
			CASE "FLAME"
				IF CFLAG:804 == 1
					BTL_KOJO_RESULTS:0 = 状況、確認……。
				ELSEIF CFLAG:804 == 2
					BTL_KOJO_RESULTS:0 = 忌々しい炎め……！
				ELSE
					BTL_KOJO_RESULTS:0 = ひっ！もべぶ……！（手で口を覆っている）
				ENDIF
			CASE "SLIP"
				IF CFLAG:804 == 1
					BTL_KOJO_RESULTS:0 = っ！？
				ELSEIF CFLAG:804 == 2
					BTL_KOJO_RESULTS:0 = いっ、たい！？
				ELSE
					BTL_KOJO_RESULTS:0 = ぐえっ。
				ENDIF
			;CASE "BRAND"
			;その他の状態異常
			;CASEELSE
		ENDSELECT
	;食いしばり等で耐えた
	CASE 23
		;이악물기
		IF BASE:ARG:ＨＰ == 1
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 損耗率……状況確認……。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = ぐっ、やってくれやがりましたわね！？
			ELSE
				BTL_KOJO_RESULTS:0 = ぎっ！？じぬがどおもっだぁ……！
			ENDIF
		;その他
		ELSE
			IF CFLAG:804 == 1
				BTL_KOJO_RESULTS:0 = 損耗率……状況確認……。
			ELSEIF CFLAG:804 == 2
				BTL_KOJO_RESULTS:0 = ぐっ、やってくれやがりましたわね！？
			ELSE
				BTL_KOJO_RESULTS:0 = ぎっ！？じぬがどおもっだぁ……！
			ENDIF
		ENDIF
	;回復してもらった
	CASE 24
		;ARG:2　回復量
		LOCAL = ARG:2 * 100 / BASE:ARG:ＨＰ
		;LOCAL　回復量割合
		IF 0
		;キャラ分岐
		;ELSEIF NO:(ARG:1) == XXXX
		;50%以上 & HPほぼ満タン
		ELSEIF LOCAL > 50 && 現HP割合(ARG) > 90
		;50%以上
		ELSEIF LOCAL > 50
		;その他
		ELSE
		ENDIF
	;状態異常を直してもらった
	CASE 25
		;ARG:2　直ったバステ
		IF 0
		;キャラ分岐
		;ELSEIF NO:(ARG:1) == XXXX
		ELSE
			SELECTCASE GET_STATE(ARG:2)
				CASE "SLEEP"
