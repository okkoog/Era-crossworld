@KOJO_BATTLE_EVENT_K[[キャラ:바엘]], ARG, ARG:1, ARG:2

;味方パーティでのデビルＣＯ－ＯＰ発動時の台詞
IF TFLAG:전투이벤트 == 1
		PRINTFORML ┏>＠%NAME:ARG +"（蛙）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"やったるでー！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;味方パーティでのデビルＣＯ－ＯＰ参加時の台詞
IF TFLAG:전투이벤트 == 2
	IF RAND:3 == 0
		PRINTFORML ┏>＠%NAME:ARG +"（蛙）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"いったるでー！",72,LEFT%┃
