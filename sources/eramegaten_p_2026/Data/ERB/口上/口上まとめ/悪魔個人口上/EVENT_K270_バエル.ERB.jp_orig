	ELSEIF RAND:2 == 0
		PRINTFORML ┏>＠%NAME:ARG +"（蛙）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%CSTR:일인칭 + "も加勢や！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		PRINTFORML 
		PRINTFORML 
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"少女もやる気だ",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ELSE
		PRINTFORML ┏>＠%NAME:ARG +"（蛙）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"追い打ちや！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF
ENDIF

IF TFLAG:전투이벤트 == 12 && BASE:ARG:ＨＰ <= 0
	IF RAND:3 == 0
		PRINTFORML ┏>＠%NAME:ARG +"（蛙）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"やられてもうた……",72,LEFT%┃
