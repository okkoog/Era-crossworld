;-------------------------------------------------
;66,기승위
;-------------------------------------------------
	CASE 66
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:338 == 0
			;処女
			IF TALENT:0
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORML 『ついに一つになれたんやのぉ』
					PRINTFORMW 少女は痛みと嬉しさで目に涙を浮かべている
					PRINTFORML 『さ、腰ふったれ』
					PRINTFORMW 『%CSTR:이인칭%のチンコも待ちわびとるで』
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORML 『ついに穴あいたのぉ』
					PRINTFORML 『これでハメ放題やで』
					PRINTFORMW %CALLNAME%は喜んでいる
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 『ついに穴開けてもらえたのぉ』
					PRINTFORML 『これからは、そっちの穴でも奉仕するんやで』
					PRINTFORMW %CALLNAME%は頷いている
				ELSE
					PRINTFORML 『自分からチンコに跨らせるとか』
					PRINTFORML 『流石やな、%CSTR:이인칭%』
					PRINTFORMW 少女は痛みで目に涙を浮かべている
				ENDIF
			;それ以外
			ELSE
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORML 
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORML 
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 『動くの疲れたか、%CSTR:이인칭%』
					PRINTFORML 『ほれ、お前もちゃんと腰振って%CSTR:이인칭%に奉仕するんやで』
				ELSE
					PRINTFORML 
				ENDIF
			ENDIF
			CFLAG:338 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落() && (CFLAG:338 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORML 『そんなに激しく腰振って、一つになれるのが嬉しいんか？』
					ELSE
						PRINTFORML 『%CSTR:이인칭%もこの子、可愛がったりよ』
					ENDIF
					IF RAND:2 == 0
						PRINTFORML %CALLNAME%は頷きながら腰を振っている
					ELSE
						PRINTFORML %CALLNAME%は頷きながら腰を%CALLNAME:MASTER%に押し付けるとグリグリと動いた
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORML 『おっ、ソコがええんか？』
						PRINTFORML %CALLNAME%は頷きながら腰を振っている
					ELSE
						PRINTFORML 『楽しんどるか？』
						PRINTFORML %CALLNAME%は頷きながら腰を%CALLNAME:MASTER%に押し付けるとグリグリと動いた
					ENDIF
					IF RAND:2 == 0
						PRINTFORMW 『そうか、良かったのぉ』
					ELSE
						PRINTFORMW 『この体位は猫には無いからのぉ』
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORML 『そやで、%CSTR:이인칭%に気持ちようなってもらうんや』
						PRINTFORMW 『お前さんがイくとかは二の次や』
					ELSE
						PRINTFORML 『%CSTR:일인칭%、気持ちエエところあるか？』
						PRINTFORML 『言うてくれれば、この子が重点的にシてくれるで』
						PRINTFORMW 床屋の洗髪みたいな事を言われた
					ENDIF
				ENDIF
				CFLAG:338 = 4
			;屈服刻印Lv3
			ELSEIF MARK:굴복각인 == 3 && (CFLAG:338 < 3 || FLAG:7 == 2)
				PRINTFORML 
				CFLAG:338 = 3
			;それ以外
			ELSEIF CFLAG:338 < 2 || FLAG:7 == 2
					PRINTFORML 『契約しとるんやから逆らえんのや』
					PRINTFORML 『ほれ、休まんと腰振らんか』
					PRINTFORMW %CALLNAME%は嫌々腰を振り始めた
				CFLAG:338 = 2
			ENDIF
		ENDIF

