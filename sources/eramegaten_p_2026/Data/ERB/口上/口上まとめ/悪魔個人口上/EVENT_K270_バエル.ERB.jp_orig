		PRINTFORML 
		PRINTFORML 
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"少女は蛙をツンツンとつついている",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
