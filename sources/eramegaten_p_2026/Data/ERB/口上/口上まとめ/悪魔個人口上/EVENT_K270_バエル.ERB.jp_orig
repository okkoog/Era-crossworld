;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_C関係（X1をキャラ番号に置換）
;調教後の変化をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_C_K[[キャラ:바엘]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_C
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_C_PY1_K[[キャラ:바엘]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_C_PY1_K[[キャラ:바엘]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;調教後のテキスト
;-------------------------------------------------
;-------------------------------------------------
;処女喪失(処女のみ)
;-------------------------------------------------
IF TFLAG:3 > 0
	CALL PALAM_MESSAGE_C
	;---013 EDIT START---
	;주인에의한처녀상실
	IF TFLAG:20
		;陥落素質チェック
		IF TALENT:연모 || TALENT:친애
			PRINTFORML 『痛いかもしれんが、好きな相手と初めて結ばれたんや』
			PRINTFORML 『よかったな』
			PRINTFORMW 痛みに耐えながらも喜びに満ちた表情で少女は頷いている
		ELSEIF TALENT:음란 || TALENT:창부
			PRINTFORML 『やったな、これで面倒な膜ともオサラバや』
			PRINTFORML 『次からは痛うなくて、気持ちいいだけやで』
			PRINTFORMW 今回だけと聞いて少女は破瓜の痛みに耐えている
		ELSEIF TALENT:복종 || TALENT:예속
			PRINTFORML 『ほれ、%CSTR:이인칭%がお前さんのバージンもろうてくれんや』
			PRINTFORML 『嬉しそうにせんと』
			PRINTFORMW 痛みに耐えながら少女はこちらに向かって微笑んでいる
		ELSE
			;屈服刻印Lv3
			IF MARK:2 == 3
				PRINTFORMW 『耐えるんやで』
				PRINTFORML 『その痛みは%CSTR:이인칭%から愛のムチや』
				PRINTFORMW 痛みに耐えながら何かを訴えかけるような目で少女はこちらを見つめている
			ELSE
				PRINTFORMW 『そや、そこやで』
				PRINTFORML 『ガツンといったれ！』
				PRINTFORMW 痛みに耐えながら怨みのこもった目で少女はこちらを見つめている
			ENDIF
		ENDIF
	;それ以外の時に処女喪失(主人による道具系調教含む)
	ELSE
		;陥落素質チェック
		IF TALENT:연모 || TALENT:친애
			PRINTFORML 『初めての人が%CSTR:이인칭%やないのが残念やろうが、これも愛やで』
			PRINTFORMW 痛みに耐えながら何かを訴えかけるような目で少女はこちらを見つめている
		ELSEIF TALENT:음란 || TALENT:창부
			WSTR:(K++) =
		ELSEIF TALENT:복종 || TALENT:예속
			PRINTFORML 『ほれ、%CSTR:이인칭%がお前さんのロストバージン見てくれてるんや』
			PRINTFORML 『嬉しそうにせんと』
			PRINTFORMW 痛みに耐えながら少女はこちらに向かって微笑んでいる
		ELSE
			;屈服刻印Lv3
			IF MARK:2 == 3
				PRINTFORMW 『耐えるんやで』
				PRINTFORML 『その痛みは%CSTR:이인칭%から愛のムチや』
				PRINTFORMW 痛みに耐えながら何かを訴えかけるような目で少女はこちらを見つめている
			ELSE
				PRINTFORMW 『そや、そこやで』
				PRINTFORML 『ガツンといったれ！』
				PRINTFORMW 痛みに耐えながら怨みのこもった目で少女はこちらを見つめている
			ENDIF
		ENDIF
	ENDIF
	;---013 EDIT END---
ENDIF


;-------------------------------------------------
;@KOJO_MESSAGE_PALAMCNG_D関係（X1をキャラ番号に置換）
;パラメータ変化をトリガーにした口上
;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_D_K[[キャラ:바엘]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_D
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_D_PY1_K[[キャラ:바엘]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_D_PY1_K[[キャラ:바엘]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;パラメータ変化時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;初めて潤滑がLV3超えた
;-------------------------------------------------
P = PALAM:4 + UP:4
IF P > PALAMLV:4 && CFLAG:250 == 0
	CALL PALAM_MESSAGE_D
	;ローションを使った場合
	IF SELECTCOM == 180
		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:250 = 1
ENDIF

;-------------------------------------------------
;初めて欲情がLV2超えた
;-------------------------------------------------
P = PALAM:6 + UP:6
IF P > PALAMLV:3 && CFLAG:251 == 0
	CALL PALAM_MESSAGE_D
	;媚薬を使った場合
	IF SELECTCOM == 181
		PRINTFORMW 『お、クスリが効いてきとるようやの』
	;それ以外
	ELSE
		PRINTFORML 『調教されとんのに気持ちよさそうやな』
	ENDIF
	CFLAG:251 = 1
ENDIF

;-------------------------------------------------
;初めて屈服がLV3超えた
;-------------------------------------------------
P = PALAM:7 + UP:7
IF P > PALAMLV:3 && CFLAG:252 == 0
	CALL PALAM_MESSAGE_D
	PRINTFORML 
	CFLAG:252 = 1
ENDIF

;-------------------------------------------------
;初めて恭順がLV3超えた
;-------------------------------------------------
P = PALAM:5 + UP:5
IF P > PALAMLV:3 && CFLAG:253 == 0
	CALL PALAM_MESSAGE_D
	;陥落済み
	IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:253 = 1
ENDIF

;-------------------------------------------------
;初めて恐怖がLV3超えた
;-------------------------------------------------
P = PALAM:11 + UP:11
IF P > PALAMLV:3 && CFLAG:254 == 0
	CALL PALAM_MESSAGE_D
	;陥落済み
	IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
		PRINTFORMW 
	;それ以外
	ELSE
		PRINTFORMW 
	ENDIF
	CFLAG:254 = 1
ENDIF


;-------------------------------------------------
;@KOJO_MESSAGE_MARKCNG関係（X1をキャラ番号に置換）
;刻印変動をトリガーにした口上
;刻印変動後に口上を発動します
;-------------------------------------------------
@KOJO_MESSAGE_MARKCNG_K[[キャラ:바엘]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL MARK_MESSAGE
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_MARKCNG_PY1_K[[キャラ:바엘]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_MARKCNG_PY1_K[[キャラ:바엘]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;苦痛刻印Lv3
;-------------------------------------------------
IF TFLAG:22 == 3
	CALL MARK_MESSAGE_A
	;恋慕、親愛
	IF TALENT:연모 || TALENT:친애
		PRINTFORMW 
	;淫乱、娼婦
	ELSEIF TALENT:음란 || TALENT:창부
		PRINTFORMW 
	;服従、隷属
	ELSEIF TALENT:복종 || TALENT:예속
		PRINTFORMW 
	ELSE
		PRINTFORMW 
	ENDIF
ENDIF

;-------------------------------------------------
;快楽刻印Lv3
;-------------------------------------------------
IF TFLAG:23 == 3
	CALL MARK_MESSAGE_P

	PRINTFORML 『%CSTR:이인칭%の調教、そんなにイイんか？』
	;陥落済み
	IF TALENT:연모 || TALENT:친애
		PRINTFORMW 少女は恥ずかしげに頷いている
	ELSEIF TALENT:음란 || TALENT:복종 || TALENT:창부 || TALENT:예속
		PRINTFORMW 少女は頷いている
	ELSE
		PRINTFORMW 少女は首を横に振って否定ている
	ENDIF
ENDIF

;-------------------------------------------------
;屈服刻印Lv3
;-------------------------------------------------
IF TFLAG:24 == 13 || TFLAG:24 == 23 || TFLAG:24 == 33
	CALL MARK_MESSAGE_S
	;快楽による屈服
	IF TFLAG:24 == 13
		PRINTFORML 『気持ちよくて何も考えられんか？』
		PRINTFORMW 少女は力なく頷いている
	;恐怖と苦痛による屈服
	ELSEIF TFLAG:24 == 23
		PRINTFORML 『降参か？』
		PRINTFORMW 少女は力なく頷いている
	;屈服と恭順による屈服
	ELSEIF TFLAG:24 == 33
		PRINTFORMW 
	ENDIF
ENDIF

;-------------------------------------------------
;反発刻印Lv3
;-------------------------------------------------
IF TFLAG:21 == 3
	CALL MARK_MESSAGE_R
	;陥落済み
	IF TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속
		;恋慕、親愛
		IF TALENT:연모 || TALENT:친애
			PRINTFORML 『あかんで、恋人でも限度、というものがあるで』
			PRINTFORMW 涙目になりながら少女は頷いている
		;淫乱、娼婦
		ELSEIF TALENT:음란 || TALENT:창부
			PRINTFORML 『お店だったら怖いお兄さん飛んでくるで』
			PRINTFORMW 涙目になりながら少女はこちらを睨んでいる
		;服従、隷属
		ELSEIF TALENT:복종 || TALENT:예속
			PRINTFORMW 『そこまでやられたら流石にな…』
			PRINTFORMW 涙目になりながら少女はこちらを睨んでいる
		ENDIF
	ELSE
		PRINTFORMW 『これは…』
		PRINTFORML 『%CSTR:이인칭%、嫌われたのぉ』
		PRINTFORMW 涙目になりながら少女はこちらを睨んでいる
	ENDIF
ENDIF

;-------------------------------------------------
;イベント口上集（X1をキャラ番号に置換する） CFLAG 261～299を使用
;-------------------------------------------------
@KOJO_MESSAGE_EVENT_K[[キャラ:바엘]]

;--------------------------------------------------
;特定主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_EVENT_PY1_K[[キャラ:바엘]]
;	RETURN 0
;ENDIF
SELECTCASE TFLAG:13
		;-------------------------------------------------
		;朝フェラ or 朝クンニ
		;-------------------------------------------------
	CASE 1
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:261 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW %CALLNAME%の頭を優しく撫でてやると%CALLNAME%はにっこりと微笑んだ
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 続きを求める%CALLNAME%を脇にどかすと%CALLNAME:MASTER%朝の準備を始めた
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW さらなる奉仕を始めようとする%CALLNAME:MASTER%を脇にどかすと朝の準備を始めた
				ENDIF
				CFLAG:261 = 1
			ENDIF

		;-------------------------------------------------
		;朝パイズリ
		;-------------------------------------------------
	CASE 2
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:262 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;乳サイズで分岐あり
					IF RAND:2 == 0 && (TALENT:빈유 || TALENT:절벽)
						PRINTFORML 『お前さんのちっぱいじゃ無理ってもんやで』
						PRINTFORMW 少女はそばにあった枕を蛙に投げつけると再び行為を再開した
					ELSEIF RAND:2 == 0 && (TALENT:거유 || TALENT:폭유 || TALENT:마유)
						PRINTFORML 『横から見ていると圧巻やのぉ』
						PRINTFORMW 『%CSTR:이인칭%のチンコがでかい乳に埋もれて見えんわ』
					ELSE
						PRINTFORML 『朝からパイズリで%CSTR:이인칭%のチンコ喜ばせるんか』
						PRINTFORMW 少女は頷いている
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;母乳体質かどうか
					IF TALENT:모유체질
						PRINTFORML 『おーおー』
						PRINTFORML 『朝から母乳撒き散らせながらパイズリでチンコおっ立たせてどうする気や？』
					ELSE
						PRINTFORMW 
						PRINTFORML 『朝からパイズリでチンコおっ立たせてどうする気や？』
					ENDIF
					IF RAND:2 == 0
						PRINTFORMW 少女は腰を前後させるアクションをした
					ELSE
						PRINTFORMW 少女はニヤリとした
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					;母乳体質かどうか
					IF TALENT:모유체질
						PRINTFORML 『朝から母乳撒き散らせながらパイズリご奉仕とお前さんも熱心やな』
					ELSE
						PRINTFORML 『ご主人様のチンコに朝からパイズリご奉仕とはお前さんもわかってきたな』
					ENDIF
					PRINTFORMW 少女は頷きながら奉仕を続けている
				ENDIF
				CFLAG:262 = 1
			ENDIF

		;-------------------------------------------------
		;朝騎乗位 or 朝貝合わせ
		;-------------------------------------------------
	CASE 3
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:263 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 一頻り%CALLNAME%との蜜事を楽しんだ後、%CALLNAME%の頭を優しく撫でてやった
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW もう一回戦を始めようとする%CALLNAME%を脇にどかすと%CALLNAME:MASTER%朝の準備を始めた
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW さらなる奉仕を始めようとする%CALLNAME:MASTER%を脇にどかすと朝の準備を始めた
				ENDIF
				CFLAG:263 = 1
			ENDIF

		;-------------------------------------------------
		;朝騎乗位A
		;-------------------------------------------------
	CASE 24
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:263 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 一頻り%CALLNAME%との蜜事を楽しんだ後、%CALLNAME%の頭を優しく撫でてやった
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW もう一回戦を始めようとする%CALLNAME%を脇にどかすと%CALLNAME:MASTER%朝の準備を始めた
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW さらなる奉仕を始めようとする%CALLNAME:MASTER%を脇にどかすと朝の準備を始めた
				ENDIF
				CFLAG:263 = 1
			ENDIF

		;-------------------------------------------------
		;朝キス 恋慕、親愛前提
		;-------------------------------------------------
	CASE 25
			CALL EVENT_MESSAGE
			IF CFLAG:263 < 1 || FLAG:7 == 2
				IF RAND:2 == 0
					PRINTFORMW %CALLNAME%の頭を優しく撫でてやると%CALLNAME:MASTER%は朝の準備を始めた
				ELSE
					PRINTFORMW 『もう一回』と言いたげな%CALLNAME%の頭を優しく撫でてやると%CALLNAME:MASTER%はベッドから起き上がった
				ENDIF
				CFLAG:263 = 1
			ENDIF

		;-------------------------------------------------
		;朝食
		;-------------------------------------------------
	CASE 26
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:263 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORML 『愛情料理を作りたいんはわかるんやが』
						PRINTFORMW 『お前さん、何時間台所に立っとるんや？』
						PRINTFORMW 『こっちは腹減って死にそうや……』
					ELSE
						PRINTFORML 『%CSTR:이인칭%、来るの遅いで』
						PRINTFORMW ガラスボウルの中に閉じ込められた蛙が%CALLNAME%に朝の挨拶をする
						PRINTFORML 
						PRINTFORMW 『これか？』
						PRINTFORMW 『ちぃ～っと味見しようとしたら、あの子にやられたんや』
						PRINTFORMW 『%CSTR:이인칭%に一番に食べて欲しいんやと』
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 『おー、旨そうな料理やな』
						PRINTFORML 『ウナギ、ニンニク、ニラ……』
						PRINTFORMW 『お前さん、%CSTR:이인칭%にこれ食わせてどうする気や？』
					ELSE
						PRINTFORMW 『朝から肉とは豪勢やな』
						PRINTFORML 『これなら一日戦った後にベッドで一戦もできるで』
						PRINTFORMW 少女は頷いている
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:2 == 0
						PRINTFORMW 『お、きよったか』
						PRINTFORMW 『こいつと%CSTR:일인칭%で作った料理や』
						PRINTFORMW 『朝食は大事やからな。腕によりをかけて作ったで』
					ELSE
						PRINTFORML 『お、きよったか』
						PRINTFORMW 『ご主人様より先に食べる訳にはいかんからな』
						PRINTFORML 
						PRINTFORMW 『ほな、頂こうか』
					ENDIF
				ENDIF
				CFLAG:263 = 1
			ENDIF

		;-------------------------------------------------
		;起きたら隣で寝てる 恋慕、親愛前提
		;-------------------------------------------------
	CASE 27
			CALL EVENT_MESSAGE
			IF CFLAG:263 < 1 || FLAG:7 == 2
				PRINTFORML 
				IF RAND:4 == 0
					PRINTFORMW %CALLNAME%との朝のひと時を程々にして、%CALLNAME:MASTER%は朝の準備を始めた
				ELSEIF RAND:3 == 0
					PRINTFORML 
					PRINTFORML 『ま、今だけはゆっくりさせとこうかな……』
					PRINTFORMW 一人、%CALLNAME%の部屋に残された蛙はボソリと呟いた
				ELSEIF RAND:2 == 0
					PRINTFORML 
					PRINTFORML 『%CALLNAME:MASTER%の所におるんやろうか……』
					PRINTFORMW 一人、%CALLNAME%の部屋に残された蛙はボソリと呟いた
				ELSE
					PRINTFORML 
					PRINTFORML 『%CSTR:일인칭%の朝飯はいつになるんや……』
					PRINTFORMW 一人、%CALLNAME%の部屋に残された蛙はボソリと呟いた
				ENDIF
				CFLAG:263 = 1
			ENDIF

		;-------------------------------------------------
		;朝の足コキ
		;-------------------------------------------------
	CASE 28
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:263 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 『そや、そこやで』
					PRINTFORML 『ガツンといったれ！』
					PRINTFORMW 朝から騒がしい%CALLNAME%をどかすと、%CALLNAME:MASTER%は朝の準備を始めた
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORML 『これで我慢できなくなったら、朝から%CALLNAME%にシてもらえるで』
					PRINTFORMW 朝から騒がしい%CALLNAME%を脇にどかすと、%CALLNAME:MASTER%は朝の準備を始めた
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 『ええか、力任せやのうて%CALLNAME%の性感帯を攻めるんやで』
					PRINTFORML 『そうや、その位の勢いや』
					PRINTFORMW 朝から騒がしい%CALLNAME%を脇にどかすと、%CALLNAME:MASTER%は朝の準備を始めた
				ENDIF
				CFLAG:263 = 1
			ENDIF

		;-------------------------------------------------
		;;朝の搾りたてミルク
		;-------------------------------------------------
	CASE 29
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:263 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORML 『この子の愛がぎょうさん入っとるで』
					PRINTFORMW 少女は嬉しそうに笑っている
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF HAVE_PENIS()
						PRINTFORML 『大丈夫やで、母乳以外は入っとらんで』
						PRINTFORMW 『それとも別のミルクも欲しいんか？』
					ELSE
						PRINTFORML 『これ飲んで元気付けて』
						PRINTFORML 『朝からハッスルするんやで』
						PRINTFORMW 少女は頷いている
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
						PRINTFORMW 『これ飲んで元気付けや』
						PRINTFORML 『朝イチのこの子のご奉仕や』
						PRINTFORMW 少女は頷いている
				ENDIF
				CFLAG:263 = 1
			ENDIF

		;-------------------------------------------------
		;;お寝小
		;-------------------------------------------------
	CASE 30
			CALL EVENT_MESSAGE
			IF RAND:3 == 0
				PRINTFORML 『猫ですら小便したい時は猫砂やで』
				PRINTFORMW 少女は身振り手振りで自分は猫ではないと抗議している
			ELSEIF RAND:2 == 0
				PRINTFORML 『……ったく、ええ歳なんやから』
				PRINTFORML 『お寝小はないわな』
				PRINTFORMW 少女は身振り手振りで蛙に抗議している
			ELSE
				PRINTFORMW 『……ったく、ええ歳なんやから』
				PRINTFORML 『お寝小はないわ……』
				PRINTFORML 『ま、待つんや』
				PRINTFORML 『ス、スイッチは入れたらあかん！』
				PRINTFORMW 少女は煩い蛙も洗濯機に放り込んだ…
			ENDIF
			CFLAG:263 = 1

		;-------------------------------------------------
		;調教後レズプレイ
		;-------------------------------------------------
	CASE 4
			CALL EVENT_MESSAGE
			;初めて
			IF CFLAG:264 == 0
				PRINTFORMW 
				CFLAG:264 = 1
			;それ以外
			ELSEIF CFLAG:264 < 1 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:264 = 1
			ENDIF

		;-------------------------------------------------
		;調教後セックス
		;-------------------------------------------------
	CASE 5
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:265 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 
				ENDIF
				CFLAG:265 = 1
			ENDIF

		;-------------------------------------------------
		;強精神薬の反動
		;-------------------------------------------------
	CASE 6
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:266 < 2 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 『あー、これは生殺しやな』
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 『これも%CALLNAME%からの調教やからやな』
					PRINTFORMW 『イったらアカンで』
				ENDIF
				CFLAG:266 = 2
			ELSEIF CFLAG:266 < 1 || FLAG:7 == 2
					PRINTFORMW 『辛抱せんと、%CALLNAME%に負けてまうで』
				CFLAG:266 = 1
			ENDIF

		;-------------------------------------------------
		;調教後搾乳
		;-------------------------------------------------
	CASE 7
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:267 < 2 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORML 『次は搾乳プレイもして欲しいみたいやで』
					PRINTFORMW 少女は頷いた
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 『お疲れ様や』
				ENDIF
				CFLAG:267 = 2
			ELSEIF CFLAG:267 < 1 || FLAG:7 == 2
				PRINTFORMW 
				CFLAG:267 = 1
			ENDIF

		;-------------------------------------------------
		;調教後自慰
		;-------------------------------------------------
	CASE 8
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:268 < 2 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORML 『%CALLNAME%にもっと可愛がって欲しかったんやな』
					PRINTFORMW 少女は頷きながら自慰を続けている
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORML 『調教だけでは足りんかったか』
						PRINTFORMW 自慰に耽っている少女には蛙の声は届いていないようだ
					ELSE
						PRINTFORML 『終わったら起こしとくれや』
						PRINTFORMW 自慰に耽っている少女には丸まって眠りにつく蛙の声は届いていないようだ
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORML 『%CALLNAME%にもっと可愛がって欲しかったんやな』
					PRINTFORMW 少女は頷きながら自慰を続けている
				ENDIF
				CFLAG:268 = 2
			ELSEIF CFLAG:268 < 1 || FLAG:7 == 2
				PRINTFORML 『おーおー』
				PRINTFORML 『調教終わったのに復習とは偉いのぉ』
				PRINTFORMW 自慰に耽っている少女には蛙の声は届いていないようだ
				CFLAG:268 = 1
			ENDIF

		;-------------------------------------------------
		;夜這い（主人C 相手V）
		;-------------------------------------------------
	CASE 9
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:269 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORML 『今頃は二人共お楽しみの最中やろうな…』
						PRINTFORMW 『ま、日頃頑張っとるアイツには今日はサービスや』
					ELSE
						PRINTFORML 『二人してどんなプレイしとるんやろな…』
						PRINTFORMW 『明日、だめもとで聞いてみるか』
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 『そんなに激しくして、明日になって腰イワしても知らんぞ』
					ELSE
						PRINTFORMW 『あー、こりゃ二人して朝までコースやな』
						PRINTFORML 『%CSTR:일인칭%は先に寝かせてもらうで』
						PRINTFORMW 部屋の隅に行くと蛙は丸くなって眠り始めた
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 『お前さんは%CSTR:이인칭%に奉仕する側なんやで……』
					PRINTFORMW 『と、%CSTR:이인칭%も喜んどるからええか』
				ENDIF
				CFLAG:269 = 1
			ENDIF

		;-------------------------------------------------
		;夜這い（主人C 相手A）
		;-------------------------------------------------
	CASE 31
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:269 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORML 『今頃は二人共お楽しみの最中やろうな…』
						PRINTFORMW 『ま、日頃頑張っとるアイツには今日はサービスや』
					ELSE
						PRINTFORML 『二人してどんなプレイしとるんやろな…』
						PRINTFORMW 『明日、だめもとで聞いてみるか』
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 『そんなに激しくして、明日になって腰イワしても知らんぞ』
					ELSE
						PRINTFORMW 『あー、こりゃ二人して朝までコースやな』
						PRINTFORML 『%CSTR:일인칭%は先に寝かせてもらうで』
						PRINTFORMW 部屋の隅に行くと蛙は丸くなって眠り始めた
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 『お前さんは%CSTR:이인칭%に奉仕する側なんやで……』
					PRINTFORMW 『と、%CSTR:이인칭%も喜んどるからええか』
				ENDIF
				CFLAG:269 = 1
			ENDIF

		;-------------------------------------------------
		;夜這い（主人V 相手C）
		;-------------------------------------------------
	CASE 32
			CALL EVENT_MESSAGE
			;陥落済み
			IF 陥落() && (CFLAG:269 < 1 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:2 == 0
						PRINTFORML 『今頃は二人共お楽しみの最中やろうな…』
						PRINTFORMW 『ま、日頃頑張っとるアイツには今日はサービスや』
					ELSE
						PRINTFORML 『二人してどんなプレイしとるんやろな…』
						PRINTFORMW 『明日、だめもとで聞いてみるか』
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:2 == 0
						PRINTFORMW 『そんなに激しくして、明日になって腰イワしても知らんぞ』
					ELSE
						PRINTFORMW 『あー、こりゃ二人して朝までコースやな』
						PRINTFORML 『%CSTR:일인칭%は先に寝かせてもらうで』
						PRINTFORMW 部屋の隅に行くと蛙は丸くなって眠り始めた
					ENDIF
				;服従、隷属
