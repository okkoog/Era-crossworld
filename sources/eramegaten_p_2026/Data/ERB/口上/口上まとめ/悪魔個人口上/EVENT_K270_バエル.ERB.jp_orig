				PRINTFORMW 
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORMW 
			ENDIF
			CFLAG:238 = 4
		;屈服刻印Lv3
		ELSEIF MARK:굴복각인 == 3 && (CFLAG:238 < 3 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:238 = 3
		;それ以外
		ELSEIF CFLAG:238 < 2 || FLAG:7 == 2
			PRINTFORMW 
			CFLAG:238 = 2
		ENDIF
	;その他セックス系
	ELSE
		;陥落済み
		IF 陥落() && (CFLAG:239 < 4 || FLAG:7 == 2)
			;恋慕、親愛
			IF TALENT:연모 || TALENT:친애
				PRINTFORMW 
			;淫乱、娼婦
			ELSEIF TALENT:음란 || TALENT:창부
				PRINTFORMW 
				PRINTFORMW 
			;服従、隷属
			ELSEIF TALENT:복종 || TALENT:예속
				PRINTFORMW 
			ENDIF
			CFLAG:239 = 4
		;屈服刻印Lv3
		ELSEIF MARK:굴복각인 == 3 && (CFLAG:239 < 3 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:239 = 3
		;それ以外
		ELSEIF CFLAG:239 < 2 || FLAG:7 == 2
			PRINTFORMW 
			CFLAG:239 = 2
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------
;逆レイプで射精させた
;-------------------------------------------------
IF SELECTCOM == 64 && TFLAG:10 > 0
	CALL PALAM_MESSAGE_A
	;陥落済み
	IF 陥落() && (CFLAG:240 < 3 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:240 = 3
	;屈服刻印Lv3
	ELSEIF MARK:굴복각인 == 3 && (CFLAG:240 < 2 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:240 = 2
	;それ以外
	ELSEIF CFLAG:240 < 1 || FLAG:7 == 2
		PRINTFORMW 
		CFLAG:240 = 1
	ENDIF
ENDIF


