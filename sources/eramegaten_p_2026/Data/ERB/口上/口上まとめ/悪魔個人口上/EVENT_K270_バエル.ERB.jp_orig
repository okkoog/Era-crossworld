		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:426 == 0
			PRINTFORMW 
			CFLAG:426 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落() && (CFLAG:414 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					;助手が相手をしている
					IF ASSI > 0 && ASSIPLAY == 1
						PRINTFORML 『なんや、%CSTR:일인칭%は見学かいな』
						PRINTFORMW 少女も不満そうだ
					;主人公が相手をしている
					ELSE
						IF TALENT:MASTER:임신
							PRINTFORMW 『なんや、妊娠しててもチンコ欲しいんか』
							IF RAND:2 == 0
								PRINTFORML 『せっかくやから泣くまで突いてやれ』
							ELSE
								PRINTFORML 『しかも獣みたいに後ろから犯してほしいとか大概やな…』
							ENDIF
							SIF TALENT:MASTER:사토리（소질）
								PRINTFORML （おちん、ちん…ずっこん、ばっこん…♪）
							PRINTFORMW 少女は嬉しそうに微笑むとがむしゃらに腰を振っている
						ELSE
							PRINTFORMW 『なんや、こいつのチンコが忘れられんのか』
							PRINTFORML 『ええか、後ろからやから奥まで入れるんやで』
							IF TALENT:MASTER:사토리（소질）
								IF RAND:2 == 0
									PRINTFORML （おちん、ちん…ずっこん、ばっこん…♪）
								ELSE
									PRINTFORML （おく、まで…おく、まで♪）
								ENDIF
							ENDIF
							PRINTFORMW 少女は嬉しそうに微笑むとがむしゃらに腰を振っている
						ENDIF
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					;助手が相手をしている
					IF ASSI > 0 && ASSIPLAY == 1
						PRINTFORML 『なんや、%CSTR:일인칭%はまざらんのか？』
						PRINTFORMW 少女も不満そうだ
					;主人公が相手をしている
					ELSE
						PRINTFORML 『おー、おー』
						PRINTFORMW 『そんなに激しく腰振って』
						PRINTFORML 『所詮、元は獣か…』
						IF TALENT:MASTER:사토리（소질）
							IF RAND:2 == 0
								PRINTFORML （きもち、いい…♪）
							ELSE
								PRINTFORML （キモチいいの…たくさんだす……）
							ENDIF
						ENDIF
						PRINTFORMW 少女はお構いなしに腰を振っている
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 『ええか』
					PRINTFORML 『%CSTR:이인칭%を喜ばすのが目的やからな』
					PRINTFORMW 少女は不満そうだが、気持ち良くなろうと腰だけは振っている
				ENDIF
