	ELSEIF RAND:2 == 0
		PRINTFORML ┏>＠%NAME:ARG +"（蛙）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"後は任せたで、" + CSTR:이인칭,72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ELSE
		PRINTFORML ┏>＠%NAME:ARG +"（少女）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"………",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		PRINTFORML ┏>＠%NAME:ARG +"（蛙）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"しばらく横になっとき",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF
;残り２０％以下
ELSEIF TFLAG:전투이벤트 == 12 && 現HP割合(ARG) < 20
	IF RAND:3 == 0
