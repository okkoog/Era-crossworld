				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					PRINTFORMW 
				ENDIF
				CFLAG:300 = 4
			;屈服刻印Lv3
			ELSEIF MARK:굴복각인 == 3 && (CFLAG:300 < 3 || FLAG:7 == 2)
				PRINTFORMW 
				CFLAG:300 = 3
			;それ以外
			ELSEIF CFLAG:300 < 2 || FLAG:7 == 2
