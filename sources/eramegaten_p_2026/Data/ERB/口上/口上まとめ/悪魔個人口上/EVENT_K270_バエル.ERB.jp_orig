			CFLAG:364 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落() && (CFLAG:364 < 4 || FLAG:7 == 2)
				;合体で作ったバエルで（葛城に倒された）、調教助手が葛城史人の場合
				IF CFLAG:이벤트가입 == 0 && ASSI == 4761
					IF RAND:4 == 0 && HAVE_PENIS() && TALENT:ASSI:임신 == 0
						PRINTFORML 『コイツに魔王の子を孕ませるんやっ』
						PRINTFORML 『赤玉出るまで出したれ！』
						PRINTFORMW %CALLNAME%は少女をけしかけている……
					ELSEIF RAND:3 == 0 && HAVE_PENIS()
						PRINTFORML 『好きなだけ出してええで』
						PRINTFORMW 少女は頷きながら腰を振っている
					ELSEIF RAND:2 == 0
						PRINTFORML 『ええか？　ココがええんか？』
						PRINTFORMW %CALLNAME%は%CALLNAME:ASSI%の弱い所を重点的に攻めている…
					ELSE
						PRINTFORML 『ええか、これは%CSTR:이인칭%の命令や』
						PRINTFORML 『念入りにヤったれ』
						PRINTFORMW 少女は頷きながら腰を振っている
					ENDIF
				;恋慕、親愛
				ELSEIF TALENT:연모 || TALENT:친애
					PRINTFORMW 
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					PRINTFORMW 
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
