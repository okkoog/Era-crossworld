;ライセンスについて
;	・基本項目(許可する項目を"○"に、許可しない項目を"×"に変更してください。)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1| ○ | 処理上のバグ修正              |
;	+----+----+-------------------------------+
;	|   2| ○ | 口上の誤字・脱字の修正        |
;	+----+----+-------------------------------+
;	|   3| ○ | 口上まとめへの収録            |
;	+----+----+-------------------------------+
;	|   4| ○ | 口上の新規追加                |
;	+----+----+-------------------------------+
;	|   5| ○ | 既存口上の改変                |
;	+----+----+-------------------------------+
;	|   6| ○ | 改変した口上の自由な再配布    |
;	+----+----+-------------------------------+
;	|   7| ○ | 口上内容の転載                |
;	+----+----+-------------------------------+
;	|   8| ○ | イメージ画像の作成            |
;	+----+----+-------------------------------+



;-------------------------------------------------
;eratohoA及びeratohoA系列専用口上テンプレート
;270と270をキャラ番号に置換し、Y1を助手のキャラ番号に置換してください
;ただし、キャラ番号が一桁のキャラの場合、270,Y1は1、270は01のように変えてください
;そしてコマンド内の適当な条件の下のPRINTFORMWの後ろに半角スペースを置いてセリフを追加してください
;口上を追加しないコマンドは無記入でも構いませんが、CFLAG:XXXの頭に『;』をつけてコメントアウトすると尚良いでしょう
;エキストラ構文など、コメントアウトされている構文を使う際には、『;』を外してコメントアウトを解除する必要があります
;最後にread meにも目を通しておくことをお勧めします
;-------------------------------------------------


;--------------------------------------------------
;口上セレクト機能：口上説明
;--------------------------------------------------
@セレクト口上説明_K[[キャラ:바엘]],ARG = 0
SIF ARG == 1
	RETURN 0
;口上名
;口上説明文
;１０００魔貨で買った場合と悪魔合体で作った場合で変わります
IF CFLAG:이벤트가입 == 1
	PRINTFORML カエルと少女のバエル
	PRINTFORML  　お店で買ったバエル
	PRINTFORML  　少女ではなく、蛙が喋ります
ELSE
	PRINTFORML 女体化バエル
	PRINTFORML  　"アレ"を調教するのはちょっと……という人向け
	PRINTFORML  　外見は変わります
ENDIF

;--------------------------------------------------
;EVENTTRAIN関係（270をキャラ番号に置換）
;調教開始時のセリフ CFLAG 201～219を使用
;--------------------------------------------------
@EVENTTRAIN_K[[キャラ:바엘]]
;合体で作ったバエルの場合のみ初期に素質等を変更する
IF CFLAG:201 == 0 && CFLAG:이벤트가입 == 0
	TALENT:남자 = 0

	TALENT:얌전함 = 1
	TALENT:보수적 = 1
	TALENT:일선을넘지않음 = 1
	TALENT:저항 = 0
	TALENT:눈에띄고싶어함 = 0
	TALENT:부끄럼쟁이 = 1
	TALENT:고양이혀 = 1
	TALENT:쾌감에솔직 = 1
	TALENT:빈유 = 1
	TALENT:동물귀 = 1
	TALENT:꼬리 = 1
	TALENT:교활 = 0
	TALENT:우애 = 1

	;蛙がしゃべる
	CSTR:일인칭 = ワシ
	IF TALENT:MASTER:남자
		CSTR:이인칭 = 兄ちゃん
	ELSE
		CSTR:이인칭 = 嬢ちゃん
	ENDIF

	;衣装：王冠、ドレス、パンティ、靴下、パンプス
	CFLAG:초기모자 = 28
	CFLAG:초기전신복 = 304
	CFLAG:초기속옷（하）= 602
	CFLAG:초기양말 = 801
	CFLAG:초기신발 = 911
	CFLAG:모자 = 28
	CFLAG:전신복 = 304
	CFLAG:속옷（하）= 602
	CFLAG:양말 = 801
	CFLAG:신발 = 911
	EQUIP:모자 = 28
	EQUIP:전신복 = 304
	EQUIP:속옷（하）= 602
	EQUIP:양말 = 801
	EQUIP:신발 = 911

	CSTR:프레젠트용좋아하는물건 = デビカリ_8000_またたびネクタール_50000

ENDIF

;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0
	IF CFLAG:이벤트가입 == 1
		PRINTFORMW 『おう、調教の時間か』
		PRINTFORMW 少女のドレスの裾からごそごそと蛙が現れた
	ELSE
		PRINTFORMW バエルとの死闘を思い出す……
		PRINTFORMW あいつを召喚して調教なんてリスクが大きすぎる！
		PRINTFORMW ちょっと細工をしておこう
		PRINTFORML ………
		PRINTFORML ……
		PRINTFORMW …
		PRINTFORMW 硫黄臭い煙と共に現れたのは、裾の長いドレスを着てミニクラウンを付けた猫目猫耳の少女
		PRINTFORMW …成功だ！
		PRINTFORMW …性交だ！
		PRINTFORML  
		PRINTFORMW 『おう、ちょっと待ちぃ』
		PRINTFORML 『%CSTR:일인칭%もおるで』
		PRINTFORMW 少女のドレスの裾からごそごそと蛙が現れた
		PRINTFORML 
		PRINTFORMW 『この子はあまり喋らんから』
		PRINTFORML 『これからは%CSTR:일인칭%が代わりに話したるからな』
		PRINTFORMW 少女は肯いている
		PRINTFORML 
		PRINTFORMW 『まぁ、何にせよや』
	ENDIF
	PRINTFORML 
	PRINTFORML 『마왕　バエル』
	PRINTFORML 『今後ともよろしく、や』
	PRINTFORMW 少女はペコリとお辞儀をした
	CFLAG:201 = 1
;陥落してから初めての調教
ELSEIF CFLAG:201 < 5 && (TALENT:연모 || TALENT:음란 || TALENT:복종)
	;연모
	IF TALENT:연모
		PRINTFORMW %CALLNAME:MASTER%を見ると%CALLNAME%は一目散に抱き付いてきた
		PRINTFORML 
		PRINTFORMW 『晴れて恋人同士になった二人やが…』
		IF TALENT:처녀
			PRINTFORML 『初夜はこれからか？』
		ELSE
			PRINTFORML 『これから恋人記念の初セックスか？』
		ENDIF
		PRINTFORML 
		PRINTFORML %CALLNAME%は赤面しながらポカポカと蛙を叩いた
		PRINTFORMW 『いたっ、痛いわ』
	;음란
	ELSEIF TALENT:음란
		PRINTFORMW 『いたいけな少女を』
		IF TALENT:처녀
			PRINTFORML 『処女のままでこんなに淫乱にしてもうて』
			PRINTFORMW 『%CSTR:이인칭%は凄腕の調教師やが……』
			PRINTFORML 『この子もよっぽどの好き者やな』
		ELSE
			PRINTFORMW 『こんな淫乱にしてもうて』
			PRINTFORMW 『%CSTR:이인칭%もよっぽどの好き者やな』
		ENDIF
		PRINTFORMW %CALLNAME%は淫蕩な笑みを浮かべながら肯いた
	;복종
	ELSEIF TALENT:복종
		PRINTFORML 『ほれ、改めて%CSTR:이인칭%に挨拶せんかい』
		PRINTFORMW 少女と蛙は揃って床に土下座をした
		PRINTFORMW 『見ての通りや』
		PRINTFORML 『%CALLNAME%は%CSTR:이인칭%のモノや』
		PRINTFORMW 『煮るなり焼くなり好きに使いや』
	ENDIF
	CFLAG:201 = 5
;それ以外の場合は、2回目以降の口上を呼ぶ
ELSE
	CALL EVENTTRAIN_SECOND_K[[キャラ:바엘]]
	RETURN 0
ENDIF


;-------------------------------------------------
;調教開始時（2回目以降、X1をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_K[[キャラ:바엘]]
	CALL EVENTTRAIN_MESSAGE_CLOTHES

;いままでバエルで遊んでいた人用に好物を設定
SIF CSTR:프레젠트용좋아하는물건 == ""
	CSTR:프레젠트용좋아하는물건 = デビカリ_8000_またたびネクタール_50000

;合体で作ったバエルで（葛城に倒された）、調教助手が葛城史人の場合
IF CFLAG:이벤트가입 == 0 && ASSI == 4761
	PRINTFORMW 『まぁ……%CSTR:일인칭%は負けたんやからな』
	PRINTFORML 『好きにしぃ』
	PRINTFORMW 少女と蛙は仰向けになり屈服のポーズをした
;反発刻印Lv3
ELSEIF MARK:반발각인 == 3 && FLAG:7 == 2
	PRINTFORML 『避けるんや～！』
	PRINTFORMW %CALLNAME%は蛙を掴むとこちらに投げつけてきた
	PRINTFORML 
	PRINTFORML 
	PRINTFORML 『……』
	PRINTFORML 『人様を勝手に投げたらアカンやろ』
	PRINTFORMW 少女は蛙の前に正座して説教を受けている
	PRINTFORMW 『まぁ、%CSTR:이인칭%が嫌いなのはわかるんやが』
	PRINTFORML 『これも契約や。腹くくりや』
	PRINTFORMW 少女は不機嫌そうにベッドに突っ伏した
	CFLAG:202 = 4
;屈服刻印Lv2以下
ELSEIF MARK:굴복각인 <= 2 && (CFLAG:202 < 1 || FLAG:7 == 2)
	IF RAND:2 == 0
		PRINTFORML 『ほれ、調教の時間やで』
		PRINTFORMW 何か言いたげな%CALLNAME%はベッドに横になった
	ELSE
		PRINTFORML 『来おったで』
		PRINTFORML 『ほら、準備せんかい』
		PRINTFORMW %CALLNAME%はベッドの下から淫具箱を取り出すとベッドの上に並べ始めた
	ENDIF
	CFLAG:202 = 1
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:굴복각인 == 3 && 陥落() == 0 && (CFLAG:202 < 4 || FLAG:7 == 2)
	;朝昼夕方の場合、確率でご飯ねだってくる
	IF TIME < 3 && RAND:3 == 0
		IF TALENT:MASTER:사토리（소질）
			PRINTFORML （おなか、すい、た　おなか、すいた……）
			PRINTFORML	 %CALLNAME%はこちらを見ると一目散に飛びついてきた
			PRINTFORMW	食い物で釣ってれば、一発で陥落したのではないだろうか？
		ELSE
			PRINTFORML	 %CALLNAME%はこちらを見ると一目散に飛びついてきた
			PRINTFORMW	調教の効果は出てきているようだ
		ENDIF
	ELSEIF RAND:2 == 0
		PRINTFORMW 『あと少しや』
	ELSE
		PRINTFORMW 『%CSTR:이인칭%の調教の腕も確かやな』
	ENDIF
	PRINTFORMW 『あと少しでオトせるで』
	CFLAG:202 = 4
;陥落済み
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:연모 || TALENT:친애
		;기모노＆割烹着で奥さんお出迎え
		IF TALENT:아내 && TEQUIP:옷 == 115 && TEQUIP:겉옷 == 1023
			PRINTFORML 『お帰りや』
			PRINTFORMW 三つ指ついて%CALLNAME%が出迎えてくれた
			PRINTFORML 『風呂か？　お食事か？　それとも…こいつか？』
			PRINTFORMW %CALLNAME%が微笑みながらこちらを見つめている
			PRINTFORML 
			PRINTFORML 『まさかとおもうけど……%CSTR:일인칭%か？』
			PRINTFORMW %CALLNAME%が困惑しながらこちらを見つめている
		ELSEIF RAND:2 == 0
			PRINTFORMW %CALLNAME%が来ると、少女は嬉しそうな顔をして蛙を掴み上げた
			PRINTFORML 
			PRINTFORML 『ちょっ、ちょっと待ちや！』
			PRINTFORMW 部屋からつまみ出されそうになると蛙は慌てて少女を止めようとする
			IF TALENT:발정가능
				PRINTFORMW 『発情した痴態を見られとうないんは判るんやが』
			ELSE
				PRINTFORMW 『%CSTR:이인칭%との睦言を覗かれるのが恥ずかしいんは判るんやが』
			ENDIF
			PRINTFORMW 『どうやってコミュニケーションをとるんや？』
			PRINTFORML 
			PRINTFORMW 少女は渋々と蛙を部屋の隅に置いた
			PRINTFORMW 『大丈夫や、口外せんから楽しんどき』
		ELSE
			PRINTFORMW 『遅いで』
			PRINTFORML 『この子も待ちくたびれとるやんか』
			IF TALENT:발정가능 == 1
				PRINTFORMW いつもの可愛らしいはずの少女はそこにはおらず、発情した雌がいた
			ELSE
				PRINTFORMW 少女は肯いている
			ENDIF
			PRINTFORML 
			PRINTFORMW 『ほな、後は若いもん同士楽しんどきや』
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:음란 || TALENT:창부
		;ボンテージスーツでお出迎え
		IF TEQUIP:전신복 == 312 && EXIST_ITEM(13)
			PRINTFORML 『どや』
			PRINTFORML 『昔の%CSTR:일인칭%までとは言わんが、女王様の風格はあるやろ』
			PRINTFORML ボンテージスーツ姿でドヤ顔の%CALLNAME%が出迎えてくれた
			PRINTFORMW 調教道具の鞭を持ち出した上に、わざわざ仮面まで自作している
			PRINTFORML 
			IF TALENT:소인체형 || TALENT:유아체형
				PRINTFORMW 小さい%CALLNAME%のボンテージスーツに妙なエロスを感じたので押し倒す事にした…
			ELSE
				PRINTFORMW ボンテージスーツ姿にエロスを感じたので押し倒す事にした…
			ENDIF
		ELSEIF RAND:2 == 0
			PRINTFORMW 『遅いで』
			PRINTFORML 『あと１分遅かったら、オナニー始めとったで』
			IF TALENT:발정가능 == 1
				PRINTFORMW 少女が座るベッドには色々な淫具が転がっていた
			ELSE
				PRINTFORMW 少女は肯いている
			ENDIF
			PRINTFORMW 『ほな、可愛がってあげな』
		ELSE
			PRINTFORML 『ほら、%CSTR:이인칭%がきおったで』
			PRINTFORMW 『よぉ我慢したな』
			PRINTFORMW 少女が座るベッドには色々な淫具が転がっていた
			PRINTFORMW 『我慢した分、一杯可愛がってもらいや』
		ENDIF
	;服従、隷属
	ELSEIF TALENT:복종 || TALENT:예속
		;メイド服でお出迎え
		IF (TEQUIP:모자 == 1 && TEQUIP:전신복 == 308 && TEQUIP:손 == 403 && TEQUIP:신발 == 909) || (TEQUIP:모자 == 1 && TEQUIP:전신복 == 309)
			PRINTFORML 『お帰りなさいませや、ご主人様』
			PRINTFORMW メイド服姿の%CALLNAME%が出迎えてくれた
			PRINTFORMW 蛙までホワイトブリムを着けていた…
		ELSE
			PRINTFORML 『ほら、%CSTR:일인칭%がきおったで』
			PRINTFORML 『きちんと挨拶せんかい』
			PRINTFORMW %CALLNAME%は慌てて床に土下座をした
			PRINTFORMW 『ほな、いつも通り好きに使いや』
		ENDIF
	ENDIF
	CFLAG:202 = 5
ELSE
	PRINTFORML 『ほら、%CSTR:일인칭%がきおったで』
	IF RAND:2 == 0
		PRINTFORMW %CALLNAME%は猫の様にベッドで丸くなっていたが、蛙の声でもそもそと動き始めた
	ELSE
		PRINTFORMW %CALLNAME%は椅子に座ってミルクを飲んでいたが、もの惜しげにカップをテーブルに置くと調教の準備を始めた
	ENDIF
ENDIF
RETURN 0


;-------------------------------------------------
;EVENTEND関係（270をキャラ番号に置換）
;調教終了時のセリフ
;-------------------------------------------------
@EVENTEND_K[[キャラ:바엘]]

;--------------------------------------------------
;調教終了時のセリフ
;--------------------------------------------------
DRAWLINE
;反発刻印Lv3
IF MARK:반발각인 == 3 && (CFLAG:217 < 1 || FLAG:7 == 2)
		PRINTFORMW 『あかんで、%CSTR:이인칭%』
		PRINTFORML 『次はからは嫌われんようにせんと』
		PRINTFORMW 少女はこちらを睨んでいる
	CFLAG:217 = 1
;屈服刻印Lv3
ELSEIF MARK:굴복각인 == 3
	;体力500未満
	IF BASE:0 < 500 && (CFLAG:218 < 1 || FLAG:7 == 2)
		;淫乱、娼婦、発情中
		IF TALENT:음란 || TALENT:창부 || TALENT:발정가능
			PRINTFORMW 『盛りの付いた猫は途中でストップせんと死ぬまで止まらんで』
			PRINTFORMW 少女は先程までの調教を思い出して微笑んでいる
		;恋慕、親愛
		ELSEIF TALENT:연모 || TALENT:친애
			PRINTFORMW 『いくら可愛いからって、ヤりすぎやな』
			PRINTFORMW 少女は肩で息をしながらこちらに顔を向けて微笑んでいる
		;服従、隷属
		ELSEIF TALENT:복종 || TALENT:예속
			PRINTFORMW 『随分可愛がったな』
			PRINTFORML 『ほら、お前さんも満足やろ？』
			PRINTFORMW 少女は肩で息をしながら肯いている
		ELSE
			PRINTFORMW 『ちょっ～とヤリすぎやな、%CSTR:이인칭%』
			PRINTFORMW 『次はもうちっと優しくせんといかんで』
		ENDIF
		CFLAG:218 = 1
	ELSE
		;恋慕、親愛
		IF TALENT:연모 || TALENT:친애
			PRINTFORML 『ほら、今日はこれで終いや』
			PRINTFORMW 少女は頬を膨らませて不満そうな表情をしている
			IF RAND:2 == 0
				PRINTFORMW 『また次に%CSTR:이인칭%に可愛がってもらいや』
			ELSE
				PRINTFORMW 『%CSTR:이인칭%も忙しいんやから、我慢しときや』
			ENDIF
		;淫乱、娼婦
		ELSEIF TALENT:음란 || TALENT:창부
			PRINTFORML 『今日はたっぷり可愛がってもらえたか？』
			IF PALAM:욕정 >= 8
				PRINTFORML 少女は肯いている
				PRINTFORMW 『そうかぁ、良かったなぁ』
			ELSE
				PRINTFORMW 少女は頬を膨らませて不満そうな表情をしている
				PRINTFORML 『そうかぁ』
				IF RAND:2 == 0
					PRINTFORMW 『次に期待しときや』
				ELSE
					PRINTFORML 『オナニーでもしとくか？』
					PRINTFORMW 少女は肯いている
				ENDIF
			ENDIF
		;服従、隷属
		ELSEIF TALENT:복종 || TALENT:예속
			IF (PALAM:치정 + PALAM:고통) >= 12
				PRINTFORML 『良かったなぁ』
				PRINTFORMW 『次も楽しみにしときや』
			ELSE
				PRINTFORML 『そうかぁ』
				PRINTFORMW 『続きは次回のお楽しみやな』
			ENDIF
		ELSE
			PRINTFORML 『今日もお疲れや』
			PRINTFORMW 少女は何か不満そうだ
			IF RAND:2 == 0
				PRINTFORML 『なんや、もっと可愛がって欲しいんか？』
				PRINTFORMW 少女は肯いている
			ELSE
				PRINTFORMW 『なんや、調教終わったのに嬉しくないんか？』
				PRINTFORML 『それとも、身体が疼いてしょうがないんか？』
				PRINTFORMW %CALLNAME%は赤面しながらポカポカと蛙を叩いた
			ENDIF
		ENDIF
		CFLAG:219 = 4
	ENDIF
;それ以外
ELSEIF  (CFLAG:219 < 1 || FLAG:7 == 2)
	IF RAND:2 == 0
		PRINTFORMW 『お疲れや、%CSTR:이인칭%』
	ELSE
		PRINTFORMW 『よぉ頑張ったの、%CSTR:이인칭%』
	ENDIF
	IF RAND:2 == 0
		PRINTFORML 『そしたら、飯でも食いに行くか』
		PRINTFORMW 少女は肯いた
	ELSE
		PRINTFORML 『ほれ、最後に部屋の片づけや』
		PRINTFORMW 少女は不満そうだ
	ENDIF
	CFLAG:219 = 1
ENDIF
RETURN 0

;--------------------------------------------------
;@KOJO_MESSAGE_COM関係（X1をキャラ番号に置換）
;コマンド実行時に出力されます
;--------------------------------------------------
@KOJO_MESSAGE_COM_K[[キャラ:바엘]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL TRAIN_MESSAGE
	RETURN 0
ENDIF
