;-------------------------------------------------
@KOJO_MESSAGE_PALAMCNG_B_K[[キャラ:바엘]]
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には地の文を表示して口上をスキップする
IF TEQUIP:20 &&  SELECTCOM != 107
	CALL PALAM_MESSAGE_B
	RETURN 0
ENDIF
;--------------------------------------------------
;特定キャラが助手、主人時に特殊キャラ口上を呼び出す(Y1を特定キャラ、X1を奴隷のキャラ番号に置換）
;--------------------------------------------------
;IF NO:MASTER == Y1
;	CALL KOJO_MESSAGE_PALAMCNG_B_PY1_K[[キャラ:바엘]]
;	RETURN 0
;ENDIF
;IF ASSI > 0 && ASSIPLAY
;	IF NO:ASSI == Y1
;		CALL KOJO_MESSAGE_PALAMCNG_B_PY1_K[[キャラ:바엘]]
;		RETURN 0
;	ENDIF
;ENDIF
;-------------------------------------------------
;奴隷の絶頂時のテキスト
;-------------------------------------------------
;-------------------------------------------------
;初めてC絶頂
;-------------------------------------------------
IF NOWEX:0 > 0 && CFLAG:242 == 0
	PRINTFORMW 
	CFLAG:242 = 1
ENDIF

;-------------------------------------------------
;初めてV絶頂
;-------------------------------------------------
IF NOWEX:1 > 0 && CFLAG:243 == 0
	PRINTFORMW 
	CFLAG:243 = 1
ENDIF

;-------------------------------------------------
;初めてA絶頂
;-------------------------------------------------
IF NOWEX:2 > 0 && CFLAG:244 == 0
	PRINTFORMW 
	CFLAG:244 = 1
ENDIF

;-------------------------------------------------
;初めてB絶頂
;-------------------------------------------------
IF NOWEX:3 > 0 && CFLAG:245 == 0
	PRINTFORMW 
	CFLAG:245 = 1
ENDIF

;-------------------------------------------------
;절정
;-------------------------------------------------
;強絶頂
IF TFLAG:29 > 1
	CALL PALAM_MESSAGE_B
	;陥落済み
	IF 陥落() && (CFLAG:246 < 4 || FLAG:7 == 2)
		;恋慕、親愛
		IF TALENT:연모 || TALENT:친애
			IF TEQUIP:이뇨제 && TALENT:오줌싸개버릇
				PRINTFORML 『おー、嬉ションやな』
			ELSE
				PRINTFORMW 『おー、こりゃ激しくイったのぉ』
			ENDIF
		;淫乱、娼婦
		ELSEIF TALENT:음란 || TALENT:창부
			PRINTFORMW 
		;服従、隷属
		ELSEIF TALENT:복종 || TALENT:예속
			PRINTFORMW 
		ENDIF
		CFLAG:246 = 4
	;屈服刻印Lv3
	ELSEIF MARK:굴복각인 == 3 && (CFLAG:246 < 3 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:246 = 3
	;それ以外
	ELSEIF CFLAG:246 < 2 || FLAG:7 == 2
		PRINTFORML 『おー、激しくイっとるわ』
		PRINTFORMW 『嫌がる素振りはするけど、身体は正直やな』
		CFLAG:246 = 2
	ENDIF
;절정
ELSEIF TFLAG:29 > 0
	CALL PALAM_MESSAGE_B
	;陥落済み
	IF 陥落() && (CFLAG:246 < 4 || FLAG:7 == 2)
		;恋慕、親愛
		IF TALENT:연모 || TALENT:친애
			PRINTFORMW 
		;淫乱、娼婦
		ELSEIF TALENT:음란 || TALENT:창부
			PRINTFORMW 
			PRINTFORMW 
		;服従、隷属
		ELSEIF TALENT:복종 || TALENT:예속
			PRINTFORMW 
		ENDIF
		CFLAG:246 = 4
	;屈服刻印Lv3
	ELSEIF MARK:굴복각인 == 3 && (CFLAG:246 < 3 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:246 = 3
	;それ以外
	ELSEIF CFLAG:246 < 2 || FLAG:7 == 2
		PRINTFORML 『おー、イっとるイっとる』
		PRINTFORMW 『このまま身体に教え込むんやな』
		CFLAG:246 = 2
	ENDIF
ENDIF

;-------------------------------------------------
;사정
;-------------------------------------------------
;射精している
IF TFLAG:10 > 0
	;陥落済み
	IF 陥落() && (CFLAG:247 < 3 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:247 = 3
	;屈服刻印Lv3
	ELSEIF MARK:굴복각인 == 3 && (CFLAG:247 < 2 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:247 = 2
	;それ以外
	ELSEIF CFLAG:247 < 1 || FLAG:7 == 2
		PRINTFORMW 
		CFLAG:247 = 1
	ENDIF
ENDIF

;-------------------------------------------------
;분유
;-------------------------------------------------
;噴乳している
IF TFLAG:11 > 0
	;陥落済み
	IF 陥落() && (CFLAG:248 < 3 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:248 = 3
	;屈服刻印Lv3
	ELSEIF MARK:굴복각인 == 3 && (CFLAG:248 < 2 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:248 = 2
	;それ以外
	ELSEIF CFLAG:248 < 1 || FLAG:7 == 2
		PRINTFORMW 
		CFLAG:248 = 1
	ENDIF
ENDIF

;-------------------------------------------------
;방뇨
;-------------------------------------------------
;放尿している
IF TFLAG:29 > 0 && (TEQUIP:이뇨제 || TALENT:오줌싸개버릇)
	;陥落済み
	IF 陥落() && (CFLAG:249 < 3 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:249 = 3
	;屈服刻印Lv3
	ELSEIF MARK:굴복각인 == 3 && (CFLAG:249 < 2 || FLAG:7 == 2)
		PRINTFORMW 
		CFLAG:249 = 2
	;それ以外
	ELSEIF CFLAG:249 < 1 || FLAG:7 == 2
		PRINTFORMW 
		CFLAG:249 = 1
	ENDIF
