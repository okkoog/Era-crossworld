	CASE 0
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:300 == 0
			PRINTFORML 
			CFLAG:300 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF 陥落() && (CFLAG:300 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					PRINTFORMW 
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
