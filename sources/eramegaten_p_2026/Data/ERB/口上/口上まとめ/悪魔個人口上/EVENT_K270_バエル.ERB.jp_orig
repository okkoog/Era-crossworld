		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ELSE
		PRINTFORML ┏>＠%NAME:ARG +"（蛙）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"おう、ハエたたきは持っとるか？",72,LEFT%┃
		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
		PRINTFORML 
		PRINTFORML 
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"少女は頷いた",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF

;파워브레스
ELSEIF CFLAG:ARG:입력행동 == 524
	PRINTFORML ┏>＠%NAME:ARG +"（蛙）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃%"皆……！" + CSTR:일인칭 + "の下へ集うんや！",72,LEFT%┃
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;テンプレ
;選択したコマンドにより分岐させたい場合、IF文の条件にコマンドNoを記入すること
;IF CFLAG:ARG:입력행동 == 
;		PRINTFORML ┏>＠%NAME:ARG +"（少女）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓;
;		PRINTFORML ┃%"　",72,LEFT%┃
;		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
;		PRINTFORML ┏>＠%NAME:ARG +"（蛙）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
;		PRINTFORML ┃%"　",72,LEFT%┃
;		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
;		PRINTFORML 
;		PRINTFORML 
;		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
;		PRINTFORML ┃%"　",72,LEFT%┃
;		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

;--------------------------------------------------
;ボイコット時
;	CASE文からバエル用に最低限の部分だけ残す
;--------------------------------------------------
@BATTLE_BOYCOTT_MESSAGE_K[[キャラ:바엘]],ARG,ARG:1 = 0
	;ボイコットした場合に表示する口上
	CALL GET_SKILL_PROP, "SKILL_NAME", CFLAG:ARG:입력행동, ARG
	;使用したスキルの名前をLOCALSに代入
	LOCALS = %RESULTS%
	IF (ARG:1 ==  GETNUM(TALENT,"교활")) || (ARG:1 ==  GETNUM(TALENT,"우애"))
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = %LOCALS%？　それは頂けんな
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = %LOCALS%？　それは悪手やと思うで
		ELSE
			BTL_KOJO_RESULTS:0 = %LOCALS%かぁ……
			TFLAG:대화형캐릭터 = ARG
			TSTR:대화형캐릭터명칭 = >MESSAGE
			TSTR:대화형캐릭터화상어드레스 = NO_IMG
			BTL_KOJO_REACT_RESULTS:0 = 少女も不満そうだ
		ENDIF
	ENDIF

	;旧バージョン
	;SETCOLOR COLOR("RED")
	;IF (ARG:1 ==  GETNUM(TALENT,"교활")) || (ARG:1 ==  GETNUM(TALENT,"우애"))
	;	IF RAND:3 == 0
	;		PRINTFORML ┏>＠%NAME:ARG +"（蛙）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
	;		PRINTFORML ┃%LOCALS + "？　それは頂けんな",72,LEFT%┃
	;		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;	ELSEIF RAND:2 == 0
	;		PRINTFORML ┏>＠%NAME:ARG +"（蛙）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
	;		PRINTFORML ┃%LOCALS + "？　それは悪手やと思うで",72,LEFT%┃
	;		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;	ELSE
	;		PRINTFORML ┏>＠%NAME:ARG +"（蛙）",27,LEFT%　━━━━━━━━━━━━━━━━━━━━┓
	;		PRINTFORML ┃%LOCALS + "かぁ……",72,LEFT%┃
	;		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;		PRINTFORML 
	;		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
	;		PRINTFORML ┃%"少女も不満そうだ",72,LEFT%┃
	;		PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;	ENDIF
	;ENDIF
	;RESETCOLOR


;＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
;ナビ口上
;＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
;=========================================
;ナビ口上の存在確認
;この関数が設定されていないと口上が存在しない扱いになる
;=========================================
@IS_EXIST_KOJO_BATTLE_NAVI_K[[キャラ:바엘]], ARG
RETURN 1

@KOJO_BATTLE_NAVI_K[[キャラ:바엘]], ARG
SELECTCASE TSTR:네비_시추에이션_메인
	CASE "戦闘開始"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "バックアタック"
				IF RAND:2
					BTL_KOJO_RESULTS:0 = どうしたんや、%CSTR:이인칭%！
				ELSE
					BTL_KOJO_RESULTS:0 = なんや、その音は！
				ENDIF
			CASE "先制攻撃"
				IF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = 先制攻撃や　キツいの一発かましたれ！
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 相手さんの準備が整う前にやってまえ！
				ENDIF
			CASEELSE
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 敵やな
				ELSE
					BTL_KOJO_RESULTS:0 = 戦闘の時間やでぇ
				ENDIF
		ENDSELECT
	CASE "メイン画面"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "重度の危機"
				IF RAND:6 == 0 && 陥落(TARGET)
					BTL_KOJO_RESULTS:0 = %CSTR:이인칭%、勝てるか？
					BTL_KOJO_RESULTS:1 = 横でこの子がハラハラしてるで
				ELSEIF RAND:5 == 0 && 陥落(TARGET)
					BTL_KOJO_RESULTS:0 = %CSTR:이인칭%、大丈夫か
				ELSEIF RAND:4 == 0
					BTL_KOJO_RESULTS:0 = %CSTR:일인칭%を置いてくからや
				ELSEIF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = 押されとるやないか、大丈夫か？
					BTL_KOJO_RESULTS:1 = 横でこの子がハラハラしてるで
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = あ～！　%CSTR:일인칭%がソコにおったらなぁ
					BTL_KOJO_RESULTS:1 = %CSTR:일인칭%の凄い技で一撃やったのに
				ELSE
					BTL_KOJO_RESULTS:0 = %CSTR:일인칭%は応援しかできんが
					BTL_KOJO_RESULTS:1 = ふんばりどころやで
				ENDIF
			CASE "中度の危機"
				IF TSTR:네비_시추에이션_서버2 == "핀치캐릭터" && NO:(TFLAG:핀치캐릭터) ==  [[キャラ:아야토]]
					SELECTCASE TSTR:핀치캐릭터위기내용
						CASE "重傷"
							;バエル城で蛙を踏み潰した
							IF CFLAG:이벤트가입 == 0
								BTL_KOJO_RESULTS:0 = なんかピンチの奴がいるみたいやが……
								BTL_KOJO_RESULTS:0 = ソイツはどうでええわ
							ELSE
								BTL_KOJO_RESULTS:0 = なんかピンチの奴がいるみたいやで
							ENDIF
						CASE "瀕死"
							;バエル城で蛙を踏み潰した
							IF CFLAG:이벤트가입 == 0
								BTL_KOJO_RESULTS:0 = そいつには回復は不要やで
							ELSE
								BTL_KOJO_RESULTS:0 = 死にかけが一人おるが、ええやろ
							ENDIF
						CASE "DYING"
							IF CFLAG:이벤트가입 == 0
								BTL_KOJO_RESULTS:0 = やった、くたばったで！
							ELSE
								BTL_KOJO_RESULTS:0 = なんか倒れてるのがおるが、ええやろ
							ENDIF
					ENDSELECT
				ELSE
					;陥落済み
					IF RAND:3 == 0 && 陥落(TARGET)
						BTL_KOJO_RESULTS:0 = 大丈夫や、%CSTR:이인칭%ならそのくらい造作もないやろ
					ELSEIF RAND:2 == 0
						BTL_KOJO_RESULTS:0 = なんか大変な事になっとるみたいやのぉ
					ELSE
						BTL_KOJO_RESULTS:0 = そっちも大変みたいやが、こっちも大変やで
						BTL_KOJO_RESULTS:0 = こいつがミルクこぼしたんやわ
					ENDIF
				ENDIF
			CASE "平常"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "一部撃破済み"
						IF RAND:2 == 0
							BTL_KOJO_RESULTS:0 = 優勢みたいやの、%CSTR:이인칭%
						ELSEIF RAND:2 == 0
							BTL_KOJO_RESULTS:0 = %CSTR:일인칭%がおらんでも戦えてるみたいやな
							BTL_KOJO_RESULTS:1 = 褒めたるわ
						ENDIF
					CASEELSE
						IF FLAG:경과턴수 == 10
							IF RAND:2 == 0 && 陥落(TARGET) && RESULTS != "신뢰"
								IF RESULTS == "연모"
									IF RAND:3 == 0
										;夜じゃない
										IF TIME < 4
											BTL_KOJO_RESULTS:0 = 早く終わらせて帰ってきぃや
											BTL_KOJO_RESULTS:1 = こいつも、腹すかせて待ってるで
										ELSE
											BTL_KOJO_RESULTS:0 = 早く終わらせて帰ってきぃや
											BTL_KOJO_RESULTS:1 = こいつも、眠い目擦って待ってるで
										ENDIF
									ELSEIF RAND:2 == 0 && TIME:3
										BTL_KOJO_RESULTS:0 = まだ終わらんかい？
										BTL_KOJO_RESULTS:1 = この子も%CSTR:이인칭%心配で倒れてしまいそうやわ
									ELSE
										BTL_KOJO_RESULTS:0 = とっとと終わらせや
										BTL_KOJO_RESULTS:1 = 横でこの子の応援が横でうるさいんや
									ENDIF
								ELSEIF RESULTS == "음란"
									IF RAND:3 == 0
										BTL_KOJO_RESULTS:0 = 早く終わらせて帰ってきぃや
										BTL_KOJO_RESULTS:1 = この子もオナニー我慢して待ってるで
									ELSEIF RAND:2 == 0 && TIME:3
										BTL_KOJO_RESULTS:0 = まだ終わらんかい？
										BTL_KOJO_RESULTS:1 = この子が発情して横でうるさいんや
									ELSE
										BTL_KOJO_RESULTS:0 = とっとと終わらせや
										BTL_KOJO_RESULTS:1 = ナビしながらこの子鎮めるんは大変なんや
									ENDIF
								ELSEIF RESULTS == "복종"
									IF RAND:3 == 0
										BTL_KOJO_RESULTS:0 = 早く終わらせて帰ってきぃや
										BTL_KOJO_RESULTS:1 = この子、寂しゅうて死んじまいそうや
									ELSEIF RAND:2 == 0 && TIME:3
										BTL_KOJO_RESULTS:0 = まだ終わらんかい？
										BTL_KOJO_RESULTS:1 = この子、自分がナビするとうるさいんや
									ELSE
										BTL_KOJO_RESULTS:0 = とっとと終わらせや
										BTL_KOJO_RESULTS:1 = この子、正座して待ってるんやが、そろそろ限界やで
									ENDIF
								ENDIF
							ELSE
								IF RAND:2 == 0 && TIME:3
									IF RAND:2 == 0
										BTL_KOJO_RESULTS:0 = …………
										BTL_KOJO_RESULTS:1 = ……んがっ！　ね、寝とらんで、ホンマに
									ELSE
										BTL_KOJO_RESULTS:0 = まだ終わらんかい？
										BTL_KOJO_RESULTS:1 = この子もうつらうつらしとるで
									ENDIF
								ELSE
									IF RAND:2 == 0
										BTL_KOJO_RESULTS:0 = 早く終わらせて帰ってきぃや
										BTL_KOJO_RESULTS:1 = このままやとこの子、冷蔵庫の中の物食べ始めてまうで
									ELSE
										BTL_KOJO_RESULTS:0 = とっとと終わらせや
										BTL_KOJO_RESULTS:1 = %CSTR:일인칭%も腹へってきたわ
									ENDIF
								ENDIF
							ENDIF
						ELSEIF FLAG:경과턴수 == 20
							;恋慕系陥落済み
							IF RAND:2 == 0 && 陥落(TARGET) && RESULTS != "신뢰"
								IF RESULTS == "연모"
									IF RAND:2 == 0
										BTL_KOJO_RESULTS:0 = まだ終わらんかい？
										BTL_KOJO_RESULTS:1 = こいつ心配のあまり倒れたんで、ベッドで横にしとるで
									ELSE
										BTL_KOJO_RESULTS:0 = 長い事戦っとるのぉ
										BTL_KOJO_RESULTS:1 = この子も応援疲れで横でぐったりしとるで
									ENDIF
								;淫乱系陥落済み
								ELSEIF RESULTS == "음란"
									IF RAND:2 == 0
										BTL_KOJO_RESULTS:0 = あ～、この子な…
										BTL_KOJO_RESULTS:1 = とうとうオナニー始めてまったで…
									ELSE
										BTL_KOJO_RESULTS:0 = 戻ってきたらこの子に気をつけるんやで
										BTL_KOJO_RESULTS:1 = " + CSTR:ASSI:이인칭 + "押し倒してヤる気マンマンやで
									ENDIF
								;服従系陥落済み
								ELSEIF RESULTS == "복종"
									IF RAND:2 == 0
										BTL_KOJO_RESULTS:0 = 聞こえるか？
										BTL_KOJO_RESULTS:1 = 部屋の隅っこでこいつ、泣いとるわ
									ELSE
										TSTR:전투구상캐릭터화상어드레스 = NO_IMG
										RESULTS = 　　　　　　…………

										TFLAG:대화형캐릭터 = TARGET
										BTL_KOJO_RESULTS:4 = ほれ、お前は喋れんのやからマイク持っても意味ないやろ
									ENDIF
								ENDIF
							ELSE
								IF RAND:4 == 0
									IF TIME:3
										BTL_KOJO_RESULTS:0 = 先に風呂入らせてもろうたで
										BTL_KOJO_RESULTS:1 = ほれ、ドライヤーで髪乾かすで
									ELSE
										BTL_KOJO_RESULTS:0 = うちらだけで先に飯食ってもうたで
										BTL_KOJO_RESULTS:1 = ほれ、後片付けするで
									ENDIF
								ELSEIF RAND:3 == 0
									BTL_KOJO_RESULTS:0 = あー、冷蔵庫の中の物、いただいとるで
								ELSEIF RAND:2 == 0
									;ここだけ誰も喋ってないから画像無しで
									TSTR:전투구상캐릭터화상어드레스 = NO_IMG
									TSTR:전투구상캐릭터명칭 = >MESSAGE
									BTL_KOJO_RESULTS:0 = ｚｚｚｚｚ…………
									BTL_KOJO_RESULTS:1 = 少女と蛙の寝息が聞こえる……
								ELSE
									BTL_KOJO_RESULTS:0 = まだ戦ってたんか？
									BTL_KOJO_RESULTS:1 = こいつ、飽きて別の事しとるで
								ENDIF
							ENDIF
						ELSE
							IF FLAG:도주불가플래그
								IF RAND:2 == 0
									BTL_KOJO_RESULTS:0 = 逃亡不可能の金網デスマッチ
									BTL_KOJO_RESULTS:1 = 殺られる前にヤレ、や
								ELSE
									BTL_KOJO_RESULTS:0 = 一旦逃げて体勢を立て直す、なんてできへんから
									BTL_KOJO_RESULTS:1 = 油断は禁物やで
								ENDIF
							ELSE
								IF ナビ_シチュエーション存在取得("格下")
									BTL_KOJO_RESULTS:0 = 相手は雑魚や
									BTL_KOJO_RESULTS:1 = とっとと片付けたれや
								ELSEIF ナビ_シチュエーション存在取得("同格")
									IF TFLAG:적배치수 > 4
										BTL_KOJO_RESULTS:0 = ようけおるな
										BTL_KOJO_RESULTS:1 = きばりや
									ELSE
										BTL_KOJO_RESULTS:0 = この子と一緒に見とるで
										BTL_KOJO_RESULTS:1 = いいところみせてくれるよう頼むで
									ENDIF
								ELSE
									BTL_KOJO_RESULTS:0 = かなりの強敵やな
									BTL_KOJO_RESULTS:1 = 死んだりせんようによう考えてがんばりや
								ENDIF
							ENDIF
						ENDIF
				ENDSELECT
		ENDSELECT
	CASE "戦闘終了"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "勝利"
				IF RAND:4 == 0
					BTL_KOJO_RESULTS:0 = よぉ頑張ったの
				ELSEIF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = よぉ頑張ったの。　この子も喜んどるで
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = お疲れや。　怪我の回復は忘れてはいかんで
				ELSE
					BTL_KOJO_RESULTS:0 = お、終わったんか、ご苦労さんや
				ENDIF
			CASE "敗北"
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = おーい、さっきから返事あらへんぞ～
				ELSE
					BTL_KOJO_RESULTS:0 = そうか……おつかれや……
				ENDIF
			CASE "도주"
		ENDSELECT
ENDSELECT

;-------------------------------------------------
;@NAVI_IMAGE＿HYOUJI_x
;ナビの画像表示用
;ナビ文章が１～３行と固定でないので、個々に文章に合わせてCALL WRITE_IMG書くと
;・間違う原因になる
;・ただでさえ汚いソースコードがさらに汚くなる
;の理由から
