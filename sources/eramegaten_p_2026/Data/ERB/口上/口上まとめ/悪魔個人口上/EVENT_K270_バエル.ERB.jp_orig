		;-------------------------------------------------
		;;ＮＴＲ夜這い・ＮＴＲ前逢引
		;;ＮＴＲ状態になる前に逢引する時
		;-------------------------------------------------
	CASE 55
		CALL EVENT_MESSAGE
		IF (CFLAG:297 < 1 || FLAG:7 == 2)
			IF CFLAG:함락캐릭터 != 0
				;主人以外に陥落している場合
				PRINTFORMW 
			ELSEIF TALENT:연모 || TALENT:친애
				;恋慕ルート
				PRINTFORMW 
			ELSEIF TALENT:음란 || TALENT:창부
				;淫乱ルート
				PRINTFORMW 
			ELSEIF TALENT:복종 || TALENT:예속
				;服従ルート
				PRINTFORMW 
			ELSE
				PRINTFORMW
			ENDIF
			CFLAG:297 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・ＮＴＲ後初逢引
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)になった直後の一日の終了後、一度だけ行う
		;別のキャラに陥落する度に起こる。同じキャラに再度陥落した場合は起こらない
		;-------------------------------------------------
	CASE 56
		CALL EVENT_MESSAGE
		IF (CFLAG:298 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORMW 
			ENDIF
			CFLAG:298 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・デート
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;-------------------------------------------------
	CASE 57
		CALL EVENT_MESSAGE
		IF (CFLAG:299 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORMW 
			ENDIF
			CFLAG:299 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・本番
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;女性であれば入れられる側、男性であれば入れる側で固定
		;-------------------------------------------------
	CASE 58
		CALL EVENT_MESSAGE
		IF (CFLAG:601 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORMW 
			ENDIF
			CFLAG:601 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・自慰見せ合い
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;愛ＮＴＲ状態の場合、露出癖3か自慰中毒1のどちらかを満たしている事が条件になります。
		;-------------------------------------------------
	CASE 59
		CALL EVENT_MESSAGE
		IF (CFLAG:602 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORMW 
			ENDIF
			CFLAG:602 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・アナル
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;CFLAG:アナル回数が1以上なら入れられている、CFLAG:挿入回数が1以上なら入れています。
		;両方立っている場合は、地の文では入れられている側が優先されます。
		;-------------------------------------------------
	CASE 60
		CALL EVENT_MESSAGE
		IF (CFLAG:603 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORMW 
			ENDIF
			CFLAG:603 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・野外プレイ
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;愛ＮＴＲの場合、露出癖が4以上でないと発生しません
		;-------------------------------------------------
	CASE 61
		CALL EVENT_MESSAGE
		IF (CFLAG:604 < 1 || FLAG:7 == 2)
			IF TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORMW 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORMW 
			ENDIF
			CFLAG:604 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・野外調教
		;;隷ＮＴＲ状態(TALENT:ＮＴＲが 3 か 6)でCFLAG:現ＮＴＲ進行度が6以上の場合１日の終了時に発生。
		;-------------------------------------------------
	CASE 62
		CALL EVENT_MESSAGE
		IF (CFLAG:605 < 1 || FLAG:7 == 2)
			;隷ＮＴＲ
			PRINTFORMW 
			CFLAG:605 = 1
		ENDIF
	CASEELSE
		SIF FLAG:6 > 0
			CALL EVENT_MESSAGE
ENDSELECT

;-------------------------------------------------
;闘技場敗北時口上集（4998をキャラ番号に置換する） 基本的に見るとゲームオーバーなのでフラグは使わない事に
;-------------------------------------------------
