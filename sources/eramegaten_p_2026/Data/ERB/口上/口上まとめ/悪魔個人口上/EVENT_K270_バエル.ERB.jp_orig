				PRINTFORMW ふざけた名前だが、『バステトもトびつく』のキャッチフレーズＣＭで有名な猫型悪魔の大好物フード
				PRINTFORML その猫型悪魔を虜にする味は
				PRINTFORML 　
				PRINTFORML 悪魔から逃げる時に逆方向にデビカリを撒いたら逃げ切れた
				PRINTFORML 悪魔に捕まったけどデビカリと引き換えに命が助かった
				PRINTFORML 　
				PRINTFORML といった世間での口コミに加えて、
				PRINTFORMW 裏社会でも猫型悪魔との交渉アイテムして認められている程大変有効
				PRINTFORML 　
				PRINTFORML そして
				PRINTFORMW 一部の紳士にはＣＭキャラクターの外見とひっくるめて『バストデカ』と言われている……
				PRINTFORML 　
				PRINTFORMW その効果と人気から
				PRINTFORML 工場の生産も追いつかず、転売アイテムとしての知れ渡り
				PRINTFORMW 国も転売禁止品目に指定しようとしているとかしないとか……
				PRINTFORML 　
				PRINTFORML 「♪～～～」
				PRINTFORMW こうして必死にむしゃぶりついている姿を見ると苦労して入手したた甲斐があったと思う%CALLNAME:MASTER%だった……
				CFLAG:315 = 1
			;好物２（またたびソーマ）
			ELSEIF TFLAG:17 == 7
				PRINTFORML 
				PRINTFORML 「♪～～～」
				PRINTFORML %CALLNAME%は匂いを嗅いだだけでふらふらとしている
				PRINTFORMW 『酒に免疫ないからな。こうなるわ』
				CFLAG:315 = 2
			ELSE
				PRINTFORML 
				CFLAG:315 = 1
			ENDIF
		;二回目以降
		ELSEIF CFLAG:315 >= 1 || FLAG:7 == 2
			;爽やかな笑顔
			IF TFLAG:17 == 0
				SIF TALENT:MASTER:사토리（소질）
					PRINTFORML （どうしたの？）
				IF RAND:2 == 0
					PRINTFORMW %CALLNAME%は不思議そうな顔をしている
				ELSE
					PRINTFORMW %CALLNAME%は嬉しそうにしている
				ENDIF
			;美味しい霊酒
			ELSEIF TFLAG:17 == 1
				PRINTFORML 
			;軽くて身近な日用品
			ELSEIF TFLAG:17 == 2
				PRINTFORML 
			;綺麗なアクセサリ
			ELSEIF TFLAG:17 == 3
				IF TALENT:MASTER:사토리（소질）
					PRINTFORML （きらきら！）
				ELSE
					PRINTFORML 
				ENDIF
			;服
			ELSEIF TFLAG:17 == 4
				PRINTFORML 
			;貴重な霊酒
			ELSEIF TFLAG:17 == 5
				PRINTFORML 
			;好物１（デビカリ）
			ELSEIF TFLAG:17 == 6
				IF RAND:8 == 0 && BUST() < 3
					PRINTFORML 「♪～～～」
					PRINTFORML 「？？？」
					PRINTFORMW デビカリを食べきった%CALLNAME%は不思議そうな顔をしている
					PRINTFORML 『ええか、デビカリ食べてもＣＭのキャラみたい胸は大きくならんのやで』
					PRINTFORMW 少女は落ち込んでいる……
				ELSEIF RAND:2 == 0
					PRINTFORML 
					PRINTFORML 「♪～～～」
					PRINTFORML 「♪♪～～～」
					PRINTFORMW %CALLNAME%はデビカリを一個口に入れては幸せそうな表情を浮かべては、また一個と口に入れている……
				ELSE
					SIF TALENT:MASTER:사토리（소질）
						PRINTFORML （おかわり！）
					PRINTFORMW %CALLNAME%は潤んだ瞳でこちらを見ている。お礼を言いたいのだろう……
				ENDIF
			;好物２（またたびソーマ）
			ELSEIF TFLAG:17 == 7
				PRINTFORML 
				IF CFLAG:315 == 1
					PRINTFORML 「♪～～～」
					PRINTFORML %CALLNAME%は匂いを嗅いだだけでふらふらとしている
					PRINTFORMW 『酒に免疫ないからな。こうなるわ』
					CFLAG:315 = 2
				ELSEIF RAND:3 == 0
					PRINTFORML 「♪～～～」
					PRINTFORML %CALLNAME%は一口飲んだだけでふらふらとになっている
					PRINTFORMW 『学習しとらんな、コイツは』
				ELSEIF RAND:2 == 0
					PRINTFORML 「♪～～～」
					PRINTFORML 酔っぱらった%CALLNAME%は床の上をゴロゴロと転がっている…
					PRINTFORMW 『%CSTR:이인칭%もあきれとるで』
				ELSE
					PRINTFORML 『悪くないな、この酒は』
					PRINTFORMW 一口で酔い潰れて寝ている%CALLNAME%をよそに%CALLNAME:MASTER%は蛙とサシ飲みした……
				ENDIF
			ENDIF
		ENDIF

