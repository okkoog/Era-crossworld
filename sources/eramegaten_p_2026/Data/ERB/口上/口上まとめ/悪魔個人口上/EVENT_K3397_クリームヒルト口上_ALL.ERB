			IF CFLAG:(ARG:1):방어플래그
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = これでいいのかな
						BTL_KOJO_RESULTS:1 = もうちょっとだけ、ガマンしてね
					CASE 1
						BTL_KOJO_RESULTS:0 = だいじょぶだよ
						BTL_KOJO_RESULTS:1 = いま、たすけてあげるから…
					CASE 2
