;=======================================================================
;
;	ファイル名	:EVENT_K[[キャラ:쿄코]]_佐倉杏子_PURIKURA.ERB
;	概要		:聖女あんこちゃん用プリクラ口上です。
;	なるべくエミュってはいますが解釈違い・元の口上とのキャラズレはご容赦ください。
;	음란/예속/未陥落ルートは作って下さる方募集します。
;
;	ライセンス(許可する項目を"o"に、許可しない項目を"x"に変更してください)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1|  o | 処理上のバグ修正              |
;	|   2|  o | 口上の誤字・脱字の修正        |
;	|   3|  o | 口上まとめへの収録            |
;	|   4|  o | 口上の新規追加                |
;	|   5|  o | 既存口上の改変                |
;	|   6| ※ | 改変した口上の自由な再配布    |
;	|   7| ※ | 口上内容の転載                |
;	+----+----+-------------------------------+
;	※6及び7に関しては、Readmeに原案者として私の名前(mid.k)が記載してあれば可能です。
;
;	更新内容	:
;
;	VER		更新日			名前					更新内容
;	000		2024/05/10		mid.k					テンプレート作成。
;	001		2024/06/03		mid.k					新規作成
;
;
;	「プリント倶楽部」「プリクラ」はアトラス→セガの登録商標です。
;
;=======================================================================
;	専用CFLAG BIT内容一覧
;	真偽値で済む内容はこちらを使用してください
;
;	0	イベント初回
;	1	初フェラ(する)
;	2	初フェラ(される)
;	3	V挿入する(現在未使用)
;	4	V挿入する レア初回
;	5	A挿入する(女)
;	6	A挿入する(男)
;	7	V挿入させる(現在未使用)
;	8	A挿入させる(女)
;	9	A挿入させる(男)(現在未使用)
;=======================================================================

;グロ有版口上適用時もこれで拾ってメイン処理に飛ばす
;別途制作する場合はこのブロックを削除してください
@DUNGEON_EVENT_PURIKURA_K[[キャラ:쿄코]]_2
CALL DUNGEON_EVENT_PURIKURA_K[[キャラ:쿄코]]

;メイン処理
@DUNGEON_EVENT_PURIKURA_K[[キャラ:쿄코]]
CALLF 陥落(TARGET, MASTER)
IF GETBIT(CFLAG:프린트스티커패치, 0) == 0
	;初プリ
	IF RESULTS == "신뢰" || (RESULTS == "연모" && TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코 && TALENT:남자 && !TALENT:오토코노코)
		;信頼ルート(男同士のみ恋慕も)
		PRINTFORML 「야아 야아 %CSTR:이인칭%, 오락실 왔으면 저거 하자고?」
		PRINTFORMW 그렇게 말하며 %CALLNAME%은 댄스 게임을 손가락으로 가리켰다.
		PRINTFORMW 그러고 보니, \@ IS_MALE(TARGET) ? %CALLNAME%#그녀\@는 댄스 게임을 좋아했던가.
		PRINTFORML 뭐, 이쪽 목적을 끝내고 나서라면 딱히 상관없다.
		PRINTFORMW %CALLNAME:MASTER%가 그렇게 말하자, 「그럼 어서 끝내줘」라며 즐거운 듯이 말했다.
		PRINTFORML
		PRINTFORML %CALLNAME:MASTER%가 스티커 사진기에 100엔 동전을 투입하자, %CALLNAME%은 조금 놀란 듯한 표정으로 말했다.
		PRINTFORMW 「%CSTR:이인칭%, 넌 이런 것도 하는구나. 조금 의외네」
		PRINTFORML 해본 적 없냐고 묻자 즉석에서 「없지」라고 돌아왔다.
		PRINTFORMW 「너한테 불려 오기 전까진, 누구랑 친목질이나 할 만큼 여유롭진 않았거든」
		PRINTFORML 그런가. 그럼 여럿이서 즐길 수 있는 것도 이것저것 체험시켜 줘야겠군.
		PRINTFORMW %CALLNAME:MASTER%의 말에, %CALLNAME%은 조금 쑥스러운 듯이 「그러시냐」라고만 대꾸했다.
		;各ルートの処理へ
		CALL DUNGEON_EVENT_PURIKURA_K[[キャラ:쿄코]]_TRUST
	ELSEIF RESULTS == "연모"
		;恋慕ルート
		PRINTFORML 「야아 야아 %CSTR:이인칭%, 오락실 왔으면 저거 하자고?」
		PRINTFORMW 그렇게 말하며 %CALLNAME%은 댄스 게임을 손가락으로 가리켰다.
		PRINTFORMW 그러고 보니, \@IS_MALE(TARGET) ? %CALLNAME%#그녀\@는 댄스 게임을 좋아했던가.
		PRINTFORML 뭐, 이쪽 목적을 끝내고 나서라면 딱히 상관은 없지만…
		PRINTFORMW %CALLNAME:MASTER%가 그렇게 말하자, 「진짜야!?」라며 안색이 밝아졌다.
		PRINTFORML 허나, 촬영이 끝난 뒤에 춤출 여유가 남아있을지는…
		PRINTFORMW 그렇게 생각한 %CALLNAME:MASTER%였지만, 굳이 입 밖으로 내지는 않았다.
		;各ルートの処理へ
		CALL DUNGEON_EVENT_PURIKURA_K[[キャラ:쿄코]]_LOVE
	ELSEIF RESULTS == "음란"
		;淫乱ルート
		;通常分岐へ
		CALL DUNGEON_EVENT_PURIKURA_NORMAL, TARGET, RESULTS
	ELSEIF RESULTS == "예속"
		;服従ルート
		;通常分岐へ
		CALL DUNGEON_EVENT_PURIKURA_NORMAL, TARGET, RESULTS
	ELSE
		;その他(NTR中/未陥落など)
		;通常分岐へ
		CALL DUNGEON_EVENT_PURIKURA_NORMAL, TARGET, RESULTS
	ENDIF
	SETBIT CFLAG:프린트스티커패치, 0
ELSE
	;2回目以降
	IF RESULTS == "신뢰" || (RESULTS == "연모" && TALENT:MASTER:남자 && !TALENT:MASTER:오토코노코 && TALENT:남자 && !TALENT:오토코노코)
		;信頼ルート(男同士のみ恋慕も)
		PRINTFORMW 「질리지도 않네 너도」
		PRINTFORML 그렇게 말해도, %CALLNAME%도 기대하고 있었잖아?
		PRINTFORMW %CALLNAME:MASTER%가 그렇게 말하자, %CALLNAME%은 「그럴 리가 없잖아」라며 홱 고개를 돌렸다.
		PRINTFORMW 정곡을 찔렸는지 귀 끝이 조금 붉어져 있었지만, %CALLNAME:MASTER%는 지적하지 않고 넘어가 주었다.
		;各ルートの処理へ
		CALL DUNGEON_EVENT_PURIKURA_K[[キャラ:쿄코]]_TRUST
	ELSEIF RESULTS == "연모"
		;恋慕ルート
		PRINTFORML 「저기… 또 하는 거야?」
		PRINTFORMW 기계 앞에서, %CALLNAME%은 걱정스러운 듯 주위를 두리번거렸다.
		PRINTFORML 당연한 거 아니겠어?
		PRINTFORMW %CALLNAME:MASTER%가 대답하자, %CALLNAME%은 작게 한숨을 내쉬었다.
		IF CFLAG:미조교함락 && RAND:2
			PRINTFORML 「그런 짓을 할 거면 이런 곳이 아니라 제대로 침대가 있는…」
			PRINTFORMW 끝으로 갈수록 목소리가 작아져 알아들을 수 없게 된 후, %CALLNAME%은 혼자 얼굴을 붉히며 작게 무언가를 중얼거렸다.
			PRINTFORMW 「…뭐 아무렴 어때!」
			PRINTFORMW %CALLNAME%은 얼굴을 들고 이쪽을 바라보았다.
			PRINTFORML 「여기서도 좋지만, 그 대신 %CSTR:일인칭% 기분 상하게 하거나 하진 마라?」
			PRINTFORMW 고개를 끄덕인 %CALLNAME:MASTER%는 기계에 100엔 동전을 투입했다.
		ELSE
			IF RAND:2
				PRINTFORML 「그거 당하면 이 뒤에 댄스 게임 못 하게 되니까 말이야…」
				IF !HAVE_PENIS(MASTER) || TALENT:남자 || RAND:2
					PRINTFORMW 절정에 달해 갓 태어난 사슴처럼 부들거리는 %CALLNAME%을 바라보는 것도 나쁘진 않지만…
					PRINTFORMW 「화낼 거다」
				ELSE
					PRINTFORMW 딱히 정액을 흘리면서 춤춰도 괜찮지 않나?
					PRINTFORMW 「뭐!? 바, 바보 같은 소리 마!?」
					PRINTFORMW 「집중도 안 되고 기계라도 고장 나면 큰일 나잖아!?」
					PRINTFORMW 그쪽은 신경 쓰는 거냐…
				ENDIF
			ELSE
				PRINTFORMW 「일단 공공장소고 청소하는 사람도 힘들 테니까 말이야」
				PRINTFORMW 그쪽은 신경 쓰는 거냐…
			ENDIF
			PRINTFORML 어찌 됐든, %CALLNAME%의 치태를 사진에 담기 위해 이곳에 온 것이다.
			PRINTFORMW 평소에 비해 얌전해져 있는 %CALLNAME%을 곁눈질하며, 기계에 100엔 동전을 투입했다.
		ENDIF
		;各ルートの処理へ
		CALL DUNGEON_EVENT_PURIKURA_K[[キャラ:쿄코]]_LOVE
	ELSEIF RESULTS == "음란"
		;淫乱ルート
		;通常分岐へ
		CALL DUNGEON_EVENT_PURIKURA_NORMAL, TARGET, RESULTS
	ELSEIF RESULTS == "복종"
		;服従ルート
		;通常分岐へ
		CALL DUNGEON_EVENT_PURIKURA_NORMAL, TARGET, RESULTS
	ELSE
		;その他(NTR中/未陥落など)
		;通常分岐へ
		CALL DUNGEON_EVENT_PURIKURA_NORMAL, TARGET, RESULTS
	ENDIF
ENDIF

;信頼ルート
@DUNGEON_EVENT_PURIKURA_K[[キャラ:쿄코]]_TRUST
PRINTFORMW 『3』
PRINTFORMW 『2』
PRINTFORMW 『1』
PRINTFORMW 플래시가 번쩍이며 두 사람의 모습이 기록된다.
PRINTFORML %CALLNAME%은 이 뒤의 댄스 게임이 기대되는지 조금 안절부절못하고 있었지만,
PRINTFORMW %CALLNAME:MASTER%와 함께 포즈를 취해 주었다.
PRINTFORMW 촬영이 끝나고, 『꾸미기 코너로 이동해 줘』라는 내레이션이 흘러나온다.
IF GETBIT(CFLAG:프린트스티커패치, 0) == 0 || !RAND:10
	;初回or2回目以降低確率
	PRINTFORML %CALLNAME%은 기다리기 힘들었는지, 「꾸미기는 알아서 해줘, 먼저 간다?」라며,
	PRINTFORMW %CALLNAME:MASTER%의 지갑에서 100엔 동전 몇 개를 꺼내더니 댄스 게임 쪽으로 달려갔다.
ELSE
	;2回目以降
	PRINTFORMW 댄스 게임이 기대될 텐데도, 스티커를 꾸미는 %CALLNAME:MASTER%를 %CALLNAME%은 옆에서 지켜보고 있다.
	PRINTFORML 인쇄가 끝나고 스티커가 배출된 후, 두 사람은 함께 댄스 게임으로 향했다.
	PRINTFORMW 함께 플레이하느라 조금 지쳤지만, 즐거워하는 %CALLNAME%을 볼 수 있었다.
	BASE:MASTER:ＨＰ -= MIN((BASE:MASTER:ＨＰ / 10), 100)
ENDIF
IF MONEY >= 200
	MONEY -= 200
ELSE
	MONEY = 0
ENDIF

;恋慕ルート
@DUNGEON_EVENT_PURIKURA_K[[キャラ:쿄코]]_LOVE
#DIM DYNAMIC レアイベント
PRINTFORMW 이번엔 어떤 촬영을 해볼까…

PRINTFORML [0] 키스 프리쿠라
IF IS_NAKED(TARGET) == 1
	PRINTFORML [1] 노출 촬영시킨다
ELSE
	PRINTFORML [1] 노출 자위시킨다
ENDIF
IF HAVE_PENIS(MASTER) || HAVE_PENIS(TARGET)
	IF HAVE_PENIS(MASTER)
		PRINTFORML [2] 펠라시킨다
	ELSE
		PRINTFORML [2] 펠라한다
	ENDIF
	PRINTFORML [3] 섹스 프리쿠라 촬영
ENDIF
PRINTFORML [9] 평범하게 촬영한다

IF HAVE_PENIS(MASTER) || HAVE_PENIS(TARGET)
	CALL INPUTINT(0, 1, 2, 3, 9)
ELSE
	CALL INPUTINT(0, 1, 9)
ENDIF

SELECTCASE RESULT
	CASE 0
		;キスプリ
		PRINTFORMW 촬영이 시작되고 카운트다운이 진행되는 가운데, %CALLNAME:MASTER%는 이쪽을 보라며 %CALLNAME%에게 말을 건넨다.
		PRINTFORML 「뭐야, 읍!?」
		PRINTFORMW 입을 열려던 %CALLNAME%의 입술을 빼앗았다.
		PRINTFORMW 절묘한 타이밍에 플래시가 번쩍이며 %CALLNAME%의 놀란 얼굴이 기록되었다.
		PRINTFORML 「으응! 읍, 으읍!!!」
		PRINTFORMW 패닉에 빠진 %CALLNAME%에게 그대로 키스를 이어갔다.
		PRINTFORML 「응읏… 푸하아, 무슨 짓이야!」
		PRINTFORMW 어떻게든 %CALLNAME:MASTER%를 밀쳐낸 %CALLNAME%은 필사적으로 산소를 들이마시며 %CALLNAME:MASTER%를 쏘아붙였다.
		PRINTFORMW 자, 이번엔 %CALLNAME%이 먼저 키스해 줘.
		IF RAND:2
			PRINTFORML 그렇게 말하며 자신의 뺨을 가리키자, %CALLNAME%은 기가 막힌 표정이 되어 한숨을 내쉬었다.
			PRINTFORMW 「정말이지… 알았다고… 해줄 테니까 그런 슬픈 표정 짓지 마…」
			PRINTFORMW 알맞은 타이밍에 카운트다운이 흐르고, %CALLNAME%은 마음을 굳히고 %CALLNAME:MASTER%의 뺨에 키스를 했다.
			PRINTFORML %CALLNAME%의 입술이 닿음과 동시에 플래시가 터지며, 새빨간 얼굴로 키스하는 %CALLNAME%의 모습이 기록에 남았다.
			PRINTFORMW 재빨리 입술을 뗀 %CALLNAME%은 얼굴을 붉히며 「이걸로 만족하냐…」라고 중얼거렸다.
			PRINTFORMW 한 번 더! 한 번 더!
			PRINTFORML %CALLNAME:MASTER%가 그렇게 조르며 다가가자, 「기어오르지 마 바보야!」라면서도,
			PRINTFORMW 뺨이나 목덜미 등에 키스를 해주었다.
		ELSE
			PRINTFORML 그렇게 말하며 자신의 입술을 가리키자, %CALLNAME%은 한층 더 얼굴을 붉혔다.
			PRINTFORMW 「너 말이야… 안 부끄럽냐? 카메라가 보고 있다고?」
			PRINTFORMW 어이없어하던 %CALLNAME%이었지만, 재차 재촉하자 한숨을 내쉬더니 %CALLNAME:MASTER%에게 키스를 했다.
			PRINTFORMW 그대로 촬영 종료 내레이션이 흘러나올 때까지 서로의 입술을 탐했다.
		ENDIF

		CALL ADDS_EXP("키스경험", 5, MASTER)
		CALL ADDS_EXP("키스경험", 5, TARGET)
		IF IS_LESBIAN(MASTER, TARGET)
			CALL ADDS_EXP("레즈경험", 5, MASTER)
			CALL ADDS_EXP("레즈경험", 5, TARGET)
		ELSEIF IS_GAY(MASTER, TARGET)
			CALL ADDS_EXP("ＢＬ경험", 5, MASTER)
			CALL ADDS_EXP("ＢＬ경험", 5, TARGET)
		ENDIF
		CALL ADDS_EXP("애정경험", 5, MASTER)
		CALL ADDS_EXP("애정경험", 5, TARGET)

		PRINTFORMW 촬영이 끝나고 꾸미기 코너로 이동한다.
		PRINTFORML __P0__가 __P1__나 LOVE 이모티콘 등으로 데코레이션하고 있는 자,
		PRINTFORMW %CALLNAME%이 「잘도 그런 걸 그리네…」라며 질렸다는 듯이 말했다.
		PRINTFORMW 그러나 인쇄되어 나온 스티커를 받아 든 %CALLNAME%이 기쁜 표정을 짓고 있던 것을 %CALLNAME:MASTER%는 놓치지 않았다.
	CASE 1
		;露出撮影/露出オナニーさせる
		;下着姿は撮影のみ、それ以外は裸でオナニー
		IF IS_NAKED(TARGET)
			;半裸以上
			PRINTFORML 「저기… 정말로 찍는 거야?」
			PRINTFORMW 불안한 듯 주위를 둘러보는 %CALLNAME%.
			PRINTFORM 남들 눈에는 옷을 입고 있는 것처럼 보이는 %CALLNAME%이지만,
			SELECTCASE IS_NAKED(TARGET)
				CASE 3
					PRINTFORMW 실제로는 아무것도 걸치고 있지 않았다.
				CASE 2
					PRINTFORMW 실제로는 알몸이었다.
				CASE 1
					PRINTFORMW 실제로는 속옷 차림이었다.
			ENDSELECT
			PRINTFORML 간단한 환각 마법을 사용해 자신의 모습을 위장하고 있는 %CALLNAME%이지만, 촬영할 때는 마법을 풀라는 말을 들었다.
			PRINTFORM 즉, 자신의
			IF IS_NAKED(TARGET) == 1
				PRINTFORM 속옷 차림을
			ELSE
				PRINTFORM 알몸을
			ENDIF
			PRINTFORMW 찍혀야만 한다.
		ELSE
			;着衣
			PRINTFORMW 한발 앞서 %CALLNAME%을 촬영 부스로 데리고 들어가, 촬영 코스와 배경을 고르는 동안 옷을 벗어두라고 명령했다.
			PRINTFORML 「하아!? 이런 데서 발가벗으라는 소리야!?」
			PRINTFORMW 놀라 큰 소리를 내는 %CALLNAME%에게 조용히 하라고 한 뒤, 다시금 벗으라고 일렀다.
			PRINTFORML 몇 초간 %CALLNAME:MASTER%의 얼굴을 쏘아보던 %CALLNAME%이었지만, 명령을 번복할 수 없음을 깨닫고 한숨을 내쉬었다.
		ENDIF
