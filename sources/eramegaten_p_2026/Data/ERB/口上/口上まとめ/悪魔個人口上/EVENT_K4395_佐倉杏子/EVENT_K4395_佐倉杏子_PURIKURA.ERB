					CALL ADDS_EXP("Ｖ경험", 5, TARGET)
					SIF TALENT:소인체형
						CALL ADDS_EXP("Ｖ확장경험", 5, TARGET)
					IF TALENT:처녀
						TALENT:처녀 = 0
						IF TALENT:MASTER:후타나리
							CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", MASTER)
							CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", TARGET)
						ENDIF
					ENDIF
					SIF TALENT:재생처녀
						TALENT:재생처녀 = 0

					;SETBIT CFLAG:프린트스티커패치, 3
				ENDIF

				CALL ADDS_EXP("봉사쾌락경험", 5, TARGET)
				CALL ADDS_EXP("야외노출경험", 5, TARGET)
				CALL ADDS_EXP("절정경험", 1, TARGET)
				CALL ADDS_EXP("사정경험", 1, MASTER)
				IF IS_LESBIAN(MASTER, TARGET)
					CALL ADDS_EXP("레즈경험", 5, MASTER)
					CALL ADDS_EXP("레즈경험", 5, TARGET)
				ELSEIF IS_GAY(MASTER, TARGET)
					CALL ADDS_EXP("ＢＬ경험", 5, MASTER)
					CALL ADDS_EXP("ＢＬ경험", 5, TARGET)
				ENDIF
			ELSE
				;あんこちゃんが挿れる
				IF IS_MALE(MASTER)
					;A挿入(男)
					;生えてる時点で入れる側のはずなので現在は死に分岐です
					;(今後実装するかもしれないので分岐だけ作っておきます)
					IF !GETBIT(CFLAG:프린트스티커패치, 7)
					ELSE
					ENDIF

					PRINTFORMW 「남자 엉덩이에 박고 싶지도 않고 애초에 꼬추 달려 있으면 네가 박아라」
					PRINTFORML 맞는 말이다. 원래 여기에 오는 것 자체가 이상하다.
					PRINTFORMW 버그 제보를 하는 편이 좋을 것 같다…

					;CALL ADDS_EXP("Ａ경험", 5, MASTER)
					;SIF TALENT:MASTER:소인체형
					;	CALL ADDS_EXP("Ａ확장경험", 5, MASTER)

					;SETBIT CFLAG:프린트스티커패치, 7
				ELSEIF TALENT:MASTER:애널광 || ABL:MASTER:Ａ감각 > ABL:MASTER:Ｖ감각
					;A挿入(女)
					IF !GETBIT(CFLAG:프린트스티커패치, 8)
						PRINTFORMW 「하아!? 엉덩이에 박는 거야!?」
						PRINTFORMW 「아니, 네가 그쪽이 좋다면 하겠지만… 안 더러워?」
						PRINTFORML 「깨끗하게 씻고 왔다고? 그러시냐…」
						PRINTFORMW %CALLNAME%은 어이없어하면서도 발기한 페니스를 %CALLNAME:MASTER%의 애널에 삽입했다.
						PRINTFORMW 「뭐랄까… 미지근하네…」
						PRINTFORMW 「넣기만 하면 앞쪽만큼 빡빡하진 않은데, 앞이랑 다르게 꼬추에 찰싹 달라붙는달까…」
					ELSE
						PRINTFORML 「너 진짜, 엉덩이로 하는 거 좋아하네…」
						PRINTFORMW 「아무리 깨끗하게 씻었다고 해도 %CSTR:일인칭% 입장에서는 신경 쓰이는데…」
						PRINTFORML 「촬영 시작하니까 빨리 박으라고? 예이예이…」
						PRINTFORMW %CALLNAME%은 어이없어하면서도 발기한 페니스를 %CALLNAME:MASTER%의 애널에 삽입했다.
					ENDIF
					PRINTFORMW 때때로 플래시가 터지는 가운데, 질퍽, 찌걱 하고 다소 둔탁한 물소리가 울려 퍼졌다.
					PRINTFORML 항문에서 오는 감촉에 머뭇거리며 허리를 놀리는 %CALLNAME%에게 답답함을 느낀 %CALLNAME:MASTER%는 애널로 꽉, %CALLNAME%의 페니스를 조여주었다.
					PRINTFORMW 「으기익!? 야, 갑자기 조이지 마…!」
					PRINTFORMW 장내에서 %CALLNAME%의 페니스가 펄떡이는 것을 느끼며 %CALLNAME:MASTER%는 자신의 항문을 몇 번이고 조였다.
					PRINTFORML 「위험해… 벌써… 싼다앗…!」
					PRINTFORMW 철퍽, 하는 소리와 함께 끝까지 %CALLNAME%의 페니스가 밀려 들어왔고, 직후 정액의 뜨거운 열기가 장내에 번져나갔다.
					PRINTFORML 맥동하는 페니스를 느끼며 %CALLNAME:MASTER%도 절정을 맞이했다.
					PRINTFORMW 황홀경에 빠진 두 사람의 표정을 카메라가 사진에 담았다.
					PRINTFORMW
					PRINTFORMW 사정의 여운에 잠긴 %CALLNAME%을 둔 채 꾸미기 코너로 이동했다.
					PRINTFORM 잠시 후
					IF !IS_NAKED(TARGET) <= 1
						PRINTFORM 옷을 여미고
					ENDIF
					PRINTFORML %CALLNAME:MASTER% 곁으로 찾아온 %CALLNAME%이 목격한 것은,
					IF !GETBIT(CFLAG:프린트스티커패치, 8)
						PRINTFORM 「애널 섹스 기념 __P0__」
					ELSE
						PRINTFORM 「오늘도 엉덩이 섹스 __P0__」
					ENDIF
					PRINTFORMW 「__P0__ 엉덩이보지 기분 좋아 __P1__」등으로 낙서된 __P2__를 범하는 자신의 모습이었다.

					CALL ADDS_EXP("Ａ경험", 5, MASTER)
					SIF TALENT:MASTER:소인체형
						CALL ADDS_EXP("Ａ확장경험", 5, MASTER)

					SETBIT CFLAG:프린트스티커패치, 8
				ELSE
					;V挿入
					;初回分岐は未使用
					;IF !GETBIT(CFLAG:프린트스티커패치, 9)
					;ELSE
					;ENDIF
					PRINTFORML %CALLNAME:MASTER%가 엉덩이를 내밀자, %CALLNAME%의 단단하고 뜨거운 육창이 %CALLNAME:MASTER%의 질 내에 찔러 세워졌다.
					PRINTFORMW 「앗… %CALLNAME% 꼬추에 착 달라붙어서… 왜 이렇게 기분 좋은 거야…」
					PRINTFORMW 방심하면 당장이라도 사정해 버릴 것 같은지 다소 굳은 동작으로 왕복을 되풀이했다.
					PRINTFORML 답답함을 느낀 %CALLNAME:MASTER%는 %CALLNAME%이 허리를 쳐올린 순간에 질을 꽉 조였다.
					PRINTFORMW 「우와, 갑자기 조여서…!」
					PRINTFORML 자기도 모르게 허리를 멈춘 %CALLNAME%을 %CALLNAME:MASTER%는 엉덩이로 벽에 밀어붙인 채 그대로 피스톤질을 이어갔다.
					PRINTFORMW 「잠… 잠깐, 나와버린다, 고…!」
					PRINTFORML %CALLNAME%이 그렇게 말함과 거의 동시에 %CALLNAME:MASTER%의 질 내에 따뜻한 것이 퍼져나갔다.
					PRINTFORMW 그럼에도 %CALLNAME:MASTER%는 허리를 멈추지 않고 자신이 절정에 달할 때까지 피스톤 운동을 계속했다.
					PRINTFORMW
					PRINTFORMW 페니스를 내놓은 채 넋이 나간 %CALLNAME%을 두고 꾸미기 코너로 이동했다.
					PRINTFORM 잠시 후
					IF !IS_NAKED(TARGET) <= 1
						PRINTFORM 옷을 여미고
					ENDIF
					PRINTFORML %CALLNAME:MASTER% 곁으로 찾아온 %CALLNAME%이 목격한 것은,
					PRINTFORMW 「조루 꼬추 __P0__」 「__P1__ 보지 기분 좋아 __P2__」등으로 꾸며진 __P3__에게 쥐어짜 먹히는 자신의 모습이었다.

					CALL ADDS_EXP("Ｖ경험", 5, MASTER)
					SIF TALENT:MASTER:소인체형
						CALL ADDS_EXP("Ｖ확장경험", 5, MASTER)
					IF TALENT:MASTER:처녀
						TALENT:MASTER:처녀 = 0
						IF TALENT:후타나리
							CALL ADDS_ABNORMAL_EXP("処女奪取（同性）", TARGET)
							CALL ADDS_ABNORMAL_EXP("処女喪失（同性）", MASTER)
						ENDIF
					ENDIF
					SIF TALENT:MASTER:재생처녀
						TALENT:MASTER:재생처녀 = 0

					;SETBIT CFLAG:프린트스티커패치, 9
				ENDIF

				CALL ADDS_EXP("봉사쾌락경험", 5, TARGET)
				CALL ADDS_EXP("야외노출경험", 5, MASTER)
				CALL ADDS_EXP("야외노출경험", 5, TARGET)
				CALL ADDS_EXP("절정경험", 1, MASTER)
				CALL ADDS_EXP("사정경험", 1, TARGET)
				IF IS_LESBIAN(MASTER, TARGET)
					CALL ADDS_EXP("레즈경험", 5, MASTER)
					CALL ADDS_EXP("레즈경험", 5, TARGET)
				ELSEIF IS_GAY(MASTER, TARGET)
					CALL ADDS_EXP("ＢＬ경험", 5, MASTER)
					CALL ADDS_EXP("ＢＬ경험", 5, TARGET)
				ENDIF
			ENDIF
		ENDIF
	CASE 9
		;아무것도안한다
		PRINTFORMW 『다음은 ──야』
		PRINTFORMW 『3』
		PRINTFORMW 『2』
		PRINTFORMW 『1』
		PRINTFORMW 촬영이 진행되는 내내, %CALLNAME%은 언제 손을 대올지 계속 안절부절못하고 있었다.
		PRINTFORML 일부러 손을 대지 않은 채 촬영이 끝나고 꾸미기 코너로 안내하는 방송이 흐르자,
		PRINTFORMW %CALLNAME%은 이쪽을 돌아보며 화를 내기 시작했다.
		PRINTFORMW 「왜 손을 안 대는 건데!!!」
		PRINTFORML 아니 그야, 이 뒤에 댄스 게임 하고 싶다며?
		PRINTFORMW %CALLNAME:MASTER%가 뻔뻔스럽게 대꾸하자 %CALLNAME%의 얼굴이 순식간에 새빨개졌다.
		PRINTFORMW 「시끄러 바보야! 바보! 하나 더 덤으로 바보!」
		PRINTFORMW 그렇게 말하며 %CALLNAME:MASTER%의 지갑을 낚아채 촬영 부스 밖으로 뛰쳐나갔다.
		PRINTFORMW 혼자 꾸미기를 마치고 회수한 스티커를 손에 든 채 %CALLNAME%을 찾으러 나섰다.
		PRINTFORMW 댄스 게임 코너에서 찾아낸 %CALLNAME%은 손대주길 기대하고 있었다는 사실을 얼버무리려는 듯,
		PRINTFORMW 평소보다 훨씬 격렬한 보면만 골라 플레이하고 있었다.
		;ジュースも数本買ってるということで消費額お高め
		IF MONEY >= 600
			MONEY -= 600
		ELSE
			MONEY = 0
		ENDIF
ENDSELECT

