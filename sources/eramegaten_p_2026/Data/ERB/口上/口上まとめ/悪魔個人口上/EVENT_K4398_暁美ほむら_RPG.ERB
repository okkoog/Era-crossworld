@KOJO_BATTLE_EVENT_K[[キャラ:호무라]], ARG, ARG:1, ARG:2
SIF ARG < 0 && NO:ARG != 4518
	RETURN 0
LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;LOCALS = EMPTY
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 자、한방에 끝낼게
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = 찬스네、바로 이어갈게
		ELSE
			BTL_KOJO_RESULTS:0 = 이 틈、놓치지 않아！
		ENDIF
	CASE 2
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 이어갈게！
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = 여기서 침몰시켜버리겠어！
		ELSE
			BTL_KOJO_RESULTS:0 = 바보네、도망치게 둘리가 없잖아！
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = 안녕、더 이상 만날 일도 없겠지만。
			ELSE
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 다음에 사라지고 싶은 건 누구일려나。
				ELSE
					BTL_KOJO_RESULTS:0 = 유감이네。
				ENDIF
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 큭、단단하네！
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 공략할게！
			ELSE
				BTL_KOJO_RESULTS:0 = 편히 보내줄게。
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 20
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 다음！
			ELSE
				BTL_KOJO_RESULTS:0 = 집중……！
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 아직 방심할 수 없네。
			ELSE
				BTL_KOJO_RESULTS:0 = 이어간다！
			ENDIF
		;無効化された
		ELSEIF ARG:2 == 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = 통하지 않아!？
			ELSE
				BTL_KOJO_RESULTS:0 = 설마 무효화 될 줄이야……！
			ENDIF
		;吸収された
		ELSEIF ARG:2 < 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 흡수당했다……！？
			ELSE
				BTL_KOJO_RESULTS:0 = 선택을 잘못했네……큭！
			ENDIF
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = 미안해……용서해줘……。
			ELSE
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 아직……쓰러지고 싶지 않은데……。
				ELSE
					BTL_KOJO_RESULTS:0 = 마도……카……。
				ENDIF
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = 아직이야、아직 쓰러질 순 없어！
			ELSE
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 이건、당했네……
				ELSE
					BTL_KOJO_RESULTS:0 = 아직、쓰러지지 않아！
				ENDIF
			ENDIF
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 행동에 지장은 없어
			ELSE
				BTL_KOJO_RESULTS:0 = 큰 일은 아니네
			ENDIF
		ELSEIF ダメージ割合(ARG, ARG:2) > 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 이정도라면 걱정하지 않아도 괜찮아
			ELSE
				BTL_KOJO_RESULTS:0 = 무르네、이정도？
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 유감이네、내게 그건 통하지 않아
			ELSE
				BTL_KOJO_RESULTS:0 = 통할거라 생각했어？　생각했던 것 보다 우둔하네。
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 어머、힘을 나눠주는거야？
			ELSE
				BTL_KOJO_RESULTS:0 = 멍청이네、힘 고마워
			ENDIF
		ENDIF
	CASE 15
		;被反射
		;PRINTFORMW ARG:2 = {ARG:2}
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 큭、방심했어……
		ELSE
			BTL_KOJO_RESULTS:0 = 조금 실패했을 뿐이야
		ENDIF
	CASE 16
		;反射
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 잠깐、잘 보고 움직여
		ELSE
			BTL_KOJO_RESULTS:0 = 조금은 침착하게 상대를 살펴봐
		ENDIF
	CASE 17
		;敵回避
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 큿！
		ELSE
			BTL_KOJO_RESULTS:0 = 피했어！？
		ENDIF
	CASE 18
		;自分回避
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 그거 공격한거 맞아？
		ELSE
			BTL_KOJO_RESULTS:0 = 흉하네、당신
		ENDIF
	;食いしばり等で耐えた
	CASE 23
		;이악물기
		IF BASE:ARG:ＨＰ == 1
			BTL_KOJO_RESULTS:0 = 이걸로 쓰러질 거라면……처음부터 일어나지도 않아！
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = 아직이야……나는 아직 일어날 수 있어。아직 싸울 수 있어……！
		ENDIF
ENDSELECT
