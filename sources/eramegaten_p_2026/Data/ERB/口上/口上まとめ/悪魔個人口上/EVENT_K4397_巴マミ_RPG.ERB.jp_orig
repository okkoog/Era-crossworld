				BTL_KOJO_RESULTS:0 = 제거한다！　『티로・피날레』！！！
			CASE 4
				BTL_KOJO_RESULTS:0 = 빈틈투성이네！　『티로・피날레』！！！
			CASE 5
				BTL_KOJO_RESULTS:0 = 『필로・피날레』！！！　　　　　…어라？
			CASEELSE
				BTL_KOJO_RESULTS:0 = 티이이로・피나알ーーー레！！！
		ENDSELECT
	ENDIF
;-------------------------------------------------
;その他
;-------------------------------------------------
ELSE
	BTL_KOJO_RESULTS:0 = 
ENDIF
;-------------------------------------------------
;真・その他
;-------------------------------------------------
IF BTL_KOJO_RESULTS:0 == ""
	;必ず何か喋る
	BTL_KOJO_RESULTS:0 = 
ENDIF

