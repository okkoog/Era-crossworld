;-------------------------------------------------
;巴マミ戦闘口上をver.3.3に移植。
;また、旧口上に敬意を払いつつ加筆・改変しました。
;旧口上の作者氏、並びに移植に協力してくれた諸氏にこの場を借りて感謝を。
;-------------------------------------------------
;ピュエラ・マギ・ホーリー・クインテットネタは使いたかったが断念。
;ティロフィナーレ＋黒き翼＋스쿠왈타토레＋ロッソファンタズマ＋フィニトラフレティアでリンケージとか？（妄想です。期待はするな）
;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:마미]], ARG, ARG:1, ARG:2
;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 4397
	RETURN 0
VARSET LOCALS
VARSET KSTR

;KSTR:0 = 
;KSTR:1 = 
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF MARK:ARG:반발각인 == 0 && RAND:4 == 0
			BTL_KOJO_RESULTS:0 = さぁ、行くわよ、皆！
		ELSEIF MARK:ARG:반발각인 == 0 && RAND:3 == 0
			BTL_KOJO_RESULTS:0 = さぁ、みんな仕上げよ！
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 逃がさないわよ！
		ELSE
			BTL_KOJO_RESULTS:0 = まずは一撃！
		ENDIF
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = 계속 갑니다！　『티로・듀엣』！
		;それ以外
		ELSE
			BTL_KOJO_RESULTS:0 = 『티로・보레！』！　단숨에 정리해 버려요！
		ENDIF
	;被召喚時
	CASE 3
			BTL_KOJO_RESULTS:0 = 마법소녀 토모에 마미。불러 주어서 영광이에요
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF RAND:5 == 0
				BTL_KOJO_RESULTS:0 = 이걸로 마지막이에요！
			ELSEIF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 저의 승리에요！
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 決まったわ！
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = オッケー！
			ELSE
				BTL_KOJO_RESULTS:0 = 잘했어요
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 우선은 급소에、한 방！
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			IF RAND:5 == 0
				BTL_KOJO_RESULTS:0 = 아직 쓰러지지 않은거야！？
			ELSEIF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 쓰러지지 않았어요、그치만！
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 한 방 더…！
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 내 머스킷은 그 어떤 것도 봐주지 않아요！
			ELSE
				BTL_KOJO_RESULTS:0 = 방심은 금물！　아직 살아있어요！
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 반응이 좋네요！
			ELSE
				BTL_KOJO_RESULTS:0 = 견제는 순조롭네요！
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 그렇게 쉬울리는 없나요……
			ELSE
				BTL_KOJO_RESULTS:0 = 꽤나 완강하네요……
			ENDIF
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = 거짓말、효과가 없어…！？
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;味方に攻撃された
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = ……내 몸、이제 움직이지 않네……죄송해요、주인……님……
			ELSE
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 또、죽어버리는 거네요……
				ELSE
					BTL_KOJO_RESULTS:0 = 에……？
				ENDIF
			ENDIF
		;瀕死
		;ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
		;	BTL_KOJO_RESULTS:0 = 
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 나、혼자가 아닌 걸……！
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 이제 아무것도 두렵지 않아……！
			ELSE
				BTL_KOJO_RESULTS:0 = 몸이 가벼워……！
			ENDIF
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 조금 방심해버렸으려나…？
			ELSE
				BTL_KOJO_RESULTS:0 = 꽤 하잖아！
			ENDIF
		ELSEIF ダメージ割合(ARG, ARG:2) > 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 멀쩡할 수는 없지 않을까요
			ELSE
				BTL_KOJO_RESULTS:0 = 아직은 얕아요
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 방어！
			ELSE
				BTL_KOJO_RESULTS:0 = 네、유감입니다！
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 공격이 소울젬에 흡수됐다！？
			ELSE
				BTL_KOJO_RESULTS:0 = 아아앗……！　기、기분좋아……%UNICODE(0x2661)%
			ENDIF
		ENDIF

	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE 13
		;全弾命中した
		IF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 전탄명중！　역시 저답네요！
		;普通
		ELSEIF ARG:2 < ARG:1
			BTL_KOJO_RESULTS:0 = 기대치를 충분히 만족시키고 있네요
		;全弾回避された
		ELSEIF ARG:2 == ARG:1
			BTL_KOJO_RESULTS:0 = 내 총알을 모두 피했다고요…！？
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE 14
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			BTL_KOJO_RESULTS:0 = こ이런 것이군요！
		ELSE
			BTL_KOJO_RESULTS:0 = 잡았다！
		ENDIF
	;反射された
	CASE 15
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 거짓말이지…！？
		ELSE
			BTL_KOJO_RESULTS:0 = 자신의 공격이 이렇게나 아프다니…！
		ENDIF
	;反射した
	CASE 16
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 돌려줄게요！
		ELSE
			BTL_KOJO_RESULTS:0 = 자신의 공격의 맛은 어떤가요？
		ENDIF
	;回避された
	CASE 17
		BTL_KOJO_RESULTS:0 = 저걸 피했다고요！？
	;回避した
	CASE 18
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 惜しかったわね
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 유감이네요！
		ELSE
			BTL_KOJO_RESULTS:0 = もう油断しないわ！
		ENDIF
	;敵味方全体攻撃(詳細処理無し)
	;CASE 19
	;		BTL_KOJO_RESULTS:0 = 
	;反撃を発動した
	CASE 20
		SELECTCASE TFLAG:발동연동스킬
			;닷지카운터
			CASE 2484
				BTL_KOJO_RESULTS:0 = 그 틈을 놓칠 만큼 허술하지는 않아요！
			;その他
			CASEELSE
				BTL_KOJO_RESULTS:0 = 어설프게 마법소녀를 하고 있는 건 아니라고요！
		ENDSELECT
	;トリガースキルを発動した
	CASE 21
		SELECTCASE TFLAG:발동연동스킬
		;○○
		;CASE 
		;	BTL_KOJO_RESULTS:0 = 
		;その他
		CASEELSE
			BTL_KOJO_RESULTS:0 = 
		ENDSELECT
	;バッドステータスを受けた
	CASE 22
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				BTL_KOJO_RESULTS:0 = 
			CASE "SHOCK","FREEZE","BIND","PALYZE"
				BTL_KOJO_RESULTS:0 = 
			CASE "PANIC"
				BTL_KOJO_RESULTS:0 = 
			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 = 
			;CASE "CLOSE"
			CASE "POISON"
				BTL_KOJO_RESULTS:0 = 
			;CASE "BOMB"
			CASE "CHARM"
				BTL_KOJO_RESULTS:0 = 
			;CASE "CURSE"
			;CASE "FLY"
			;CASE "STONE"
			CASE "FLAME"
				BTL_KOJO_RESULTS:0 = 
			CASE "SLIP"
				BTL_KOJO_RESULTS:0 = 
			;CASE "BRAND"
			;その他の状態異常
			;CASEELSE
		ENDSELECT
	;食いしばり等で耐えた
	CASE 23
		;이악물기
		;この状況が一番危ない
		IF BASE:ARG:ＨＰ == 1
			BTL_KOJO_RESULTS:0 = 이제 안 되는 건가요…？
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = 이제 아무것도 두렵지 않아…！
		ENDIF
	;回復してもらった
	CASE 24
		;ARG:2　回復量
		LOCAL = ARG:2 * 100 / BASE:ARG:ＨＰ
		;LOCAL　回復量割合
		IF 0
		;キャラ分岐
		;ELSEIF NO:(ARG:1) == XXXX
		;50%以上 & HPほぼ満タン
		ELSEIF LOCAL > 50 && 現HP割合(ARG) > 90
			BTL_KOJO_RESULTS:0 = 
		;50%以上
		ELSEIF LOCAL > 50
			BTL_KOJO_RESULTS:0 = 
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;状態異常を直してもらった
	CASE 25
		;ARG:2　直ったバステ
		IF 0
		;キャラ分岐
		;ELSEIF NO:(ARG:1) == XXXX
		ELSE
			SELECTCASE GET_STATE(ARG:2)
				CASE "SLEEP"
					BTL_KOJO_RESULTS:0 = 
				;その他の状態異常
				CASEELSE
					BTL_KOJO_RESULTS:0 = 
			ENDSELECT
		ENDIF
	;戦闘中イって行動不能にならず耐えた(ムフフ展開時のみ)
	CASE 47
		;歯を食いしばって快楽に耐えた
		BTL_KOJO_RESULTS:0 =  으으……읏！（안돼요、견뎌야해요、마미！）
	;行動中イって行動不能になった(ムフフ展開時のみ 50%の確率でHAPPYに)
	CASE 48
		;GET_STATE(CFLAG:ARG:상태이상) == "HAPPY"
		
		;絶頂の余韻に浸っている
		BTL_KOJO_RESULTS:0 = 아、안돼……이、이대로는 싸울 수 없어……
	;ターン終了時状態異常が自然回復した
	CASE 50
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 = 
			;その他の状態異常
			CASEELSE
				BTL_KOJO_RESULTS:0 = 
		ENDSELECT
	;ターン終了時今の状態による口上
	CASE 51
		IF 0
		;ELSEIF FLAG:무후후전개 && (BATTLE_H_EVENT_PRO(ARG) > 30 || CFLAG:ARG:던전내발정용욕정치 > 5000) && !RAND:2
		;	;BATTLE_H_EVENT_PRO(ARG)　行動中にイく確率
		;	SETCOLOR COLOR("pink")
		;	IF     BATTLE_H_EVENT_PRO(ARG) > 80
		;	ELSEIF BATTLE_H_EVENT_PRO(ARG) > 50
		;	ELSEIF BATTLE_H_EVENT_PRO(ARG) > 30
		;	ELSEIF CFLAG:ARG:던전내발정용욕정치 > 10000
		;	ELSEIF CFLAG:ARG:던전내발정용욕정치 > 5000
		;状態異常時
		ELSEIF GET_STATE(CFLAG:ARG:상태이상) == "SLEEP"
			BTL_KOJO_RESULTS:0 = 
		;その他の状態異常
		;ELSEIF CFLAG:ARG:상태이상 > 0
		;HP50%以下
		ELSEIF 現HP割合(ARG) < 50
			BTL_KOJO_RESULTS:0 = 
		;HP20%以下
		ELSEIF 現HP割合(ARG) < 20
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;ターン終了時ORGYがHEATになった(機械の乙女専用)
	;CASE 52
	;		BTL_KOJO_RESULTS:0 = 
	;ターン終了時エクスリンケージ装備時のイベント口上(ムフフ展開時のみ)
	CASE 53
		;発情によってHAPPYになった
		IF CFLAG:ARG:던전내발정 == 1 && GET_STATE(CFLAG:ARG:상태이상) == "HAPPY"
			BTL_KOJO_RESULTS:0 = 이、이런일이…？
		;頭の中がピンクに染まった
		ELSEIF CFLAG:ARG:던전내발정 == 1
			BTL_KOJO_RESULTS:0 = 저、저란 사림이…
		;落ち着いた
		ELSEIF CFLAG:ARG:던전내발정 == 0
			BTL_KOJO_RESULTS:0 = 후우…
		ENDIF
	;ターン終了時エクスリンケージ装備時のイベント口上2(ムフフ展開時のみ)
	CASE 54
		;中に注がれた精液が垂れてきた…
		BTL_KOJO_RESULTS:0 = 으으…읏
	;バトルに勝利した
	CASE 90
		BTL_KOJO_RESULTS:0 = 모두들、수고 많았어요♪
	;レベルアップした
	CASE 91
		BTL_KOJO_RESULTS:0 = 해냈어요！　다음에도 이 기세로 가죠！
	;逃走に成功した
	CASE 92
		BTL_KOJO_RESULTS:0 = 
	;逃走に失敗した
	CASE 93
		BTL_KOJO_RESULTS:0 = 
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 크윽、이대로는…
		ELSE
			BTL_KOJO_RESULTS:0 = 그럼 시작할까요
		ENDIF
	;バックアタックを受けた
	CASE 95
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 크윽、이대로는…
		ELSE
			BTL_KOJO_RESULTS:0 = 태세를 재정비합시다
		ENDIF
	;敵の先制攻撃を受けた
	CASE 96
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 크윽、이대로는…
		ELSE
			BTL_KOJO_RESULTS:0 = 꽤나 만만치 않은 상대군요
		ENDIF
	;先制攻撃に成功
	CASE 97
			BTL_KOJO_RESULTS:0 = 적을 발견했어요！　먼저 공격하죠！
ENDSELECT

;リンケージに参加した
IF TFLAG:전투이벤트 == 100
	IF 0
	;スキル分岐
	;ELSEIF CFLAG:(FLAG:행동순1):입력행동 == [[스킬:○○]]
	
	;キャラ分岐
	;ELSEIF NO:(FLAG:행동순1) == XXXX
	ELSE
		BTL_KOJO_RESULTS:0 = 
	ENDIF
ENDIF

;IF !(LOCALS:10 == "") && !(KSTR:0 == "")
;	CALL MESSAGE_B2(CALLNAME:ARG,0, LOCALS:10, LOCALS:11, LOCALS:12, LOCALS:13, LOCALS:14)
;	CALL 口上変数表示
;ELSEIF !(LOCALS:10 == "")
;	CALL MESSAGE_B2(CALLNAME:ARG,1, LOCALS:10, LOCALS:11, LOCALS:12, LOCALS:13, LOCALS:14)
;ENDIF
;RESETCOLOR

;-------------------------------------------------
@KOJO_BATTLE_MESSAGE_K[[キャラ:마미]],ARG,ARG:1 = 0
;-------------------------------------------------
VARSET LOCALS
VARSET KSTR
;使用したスキルの名前をLOCALSに代入
CALL GET_SKILL_PROP, "SKILL_NAME", CFLAG:ARG:입력행동, ARG
LOCALS = %RESULTS%
;FLAG:ARG:타겟

;崩壊してる場合は口上表示しないようにもできる
;SIF TALENT:ARG:9
;	RETURN 0

CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
;コメントアウトしやすいように
IF 1 == 0
;-------------------------------------------------
;状態異常時
;-------------------------------------------------
;魅了時
ELSEIF CFLAG:ARG:상태이상 == GET_STATE_NUM("CHARM")
	;行動不能（ムラムラしている）
	IF CFLAG:ARG:입력행동 == 2314
		BTL_KOJO_RESULTS:0 = ハァ……ハァ……
	ELSE
		;ホーリーマミ化
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 私が救ってあげなきゃ…
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 大丈夫、すぐ楽にしてあげる…
		ELSE
			BTL_KOJO_RESULTS:0 = 私たちの希望を奪わせない…
		ENDIF
	ENDIF
;混乱時
ELSEIF CFLAG:ARG:상태이상 == GET_STATE_NUM("PANIC")
	;금전뿌리기
	IF CFLAG:ARG:입력행동 == 2315
		BTL_KOJO_RESULTS:0 = 
	;行動不能（ぼんやりしている）
	ELSEIF CFLAG:ARG:입력행동 == 2314
		BTL_KOJO_RESULTS:0 = 
	ELSE
		BTL_KOJO_RESULTS:0 = 
	ENDIF
;幸福時の行動不能
ELSEIF CFLAG:ARG:상태이상 == GET_STATE_NUM("HAPPY") && CFLAG:ARG:입력행동 == 2314
	;自分の体をまさぐっている(発情中+ムフフ展開時のみ)
	IF 위험일(ARG) == 2 && FLAG:무후후전개
		BTL_KOJO_RESULTS:0 = ハァ……ハァ……
	ELSE
		BTL_KOJO_RESULTS:0 = こんな幸せな気持ちになるなんて…
	ENDIF
;-------------------------------------------------
;特定スキル
;-------------------------------------------------
;これは通常攻撃
ELSEIF CFLAG:ARG:입력행동 == 0
	BTL_KOJO_RESULTS:0 = 撃つわよ！　『ティーロ』！
;ELSEIF CFLAG:ARG:입력행동 == (スキル番号)
;	BTL_KOJO_RESULTS:0 = 
;52_畳返し、109_極彩の疾風、221_鋼鉄の壁、313_蛮力の壁、606_サイコバリアー、612_水晶の壁、613_ペンタウォール、707_炎の壁、807_氷の壁、922_雷の壁、1013_衝撃の壁、1307_光の壁、1410_闇の壁、1508_大地の壁、1623_水の壁、1707_大気の壁
ELSEIF GROUPMATCH(CFLAG:ARG:입력행동, 52, 109, 221, 313, 606, 612, 613, 707, 807, 922, 1013, 1307, 1410, 1508, 1623, 1707)
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 『絶対領域』！
