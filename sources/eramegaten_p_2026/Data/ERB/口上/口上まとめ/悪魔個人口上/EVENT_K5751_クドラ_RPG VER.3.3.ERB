@KOJO_BATTLE_EVENT_K[[キャラ:쿠도라_단도라]], ARG, ARG:1, ARG:2
#DIM スキル番号
#DIM DI残りターン
スキル番号 = PU_SKILLNUM_GET(ARG,"Ｄ・いんすとーる")
DI残りターン = SKILLGAGE_D_GET(ARG,スキル番号)
;■台詞の行数を増やしたいときは
;			LOCALS:10 = 一行目
;			LOCALS:11 = 二行目
;			LOCALS:12 = 三行目
;			LOCALS:13 = 四行目
;			LOCALS:14 = 五行目
;と増やしていく
SIF ARG < 0 && NO:ARG != 5751
	RETURN 0
VARSET LOCALS

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		SELECTCASE RAND:2
		CASE 0
			BTL_KOJO_RESULTS:0 = 袋叩きだー！
		CASE 1
			BTL_KOJO_RESULTS:0 = みんなーやっちゃえー！
		ENDSELECT
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = %CALLNAME:MASTER%に続くよっ
		;それ以外
		ELSE
			BTL_KOJO_RESULTS:0 = のりこめー！
		ENDIF
	;被召喚時
	CASE 3
			BTL_KOJO_RESULTS:0 = 
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF DI残りターン > 0
				SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = もうおしまい？
				CASE 1
					BTL_KOJO_RESULTS:0 = まだ終わっちゃダメだよぉ！戦い足りないんだからぁ……！
				CASE 2
					BTL_KOJO_RESULTS:0 = あはっ%UNICODE(0x2665)%
				ENDSELECT
			ELSE
				SELECTCASE RAND:4
				CASE 0
					BTL_KOJO_RESULTS:0 = あれっ？もしかして、もう倒れちゃった？
				CASE 1
					BTL_KOJO_RESULTS:0 = つんつん♪
				CASE 2
					BTL_KOJO_RESULTS:0 = あっ……動かなくなっちゃったっ
				CASE 3
					BTL_KOJO_RESULTS:0 = もっと遊ぼうよー
				ENDSELECT
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				IF DI残りターン > 0
					BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%と長く戦うために守っているんだね！
					BTL_KOJO_RESULTS:1 = なら次は……もっと強く行くよっ！
				ELSE
					BTL_KOJO_RESULTS:0 = もっと遊んでくれるの？
				ENDIF
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = もうへばっちゃったの？
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = まだいけるよね？
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			BTL_KOJO_RESULTS:0 = あっそぼー♪
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			IF DI残りターン > 0
				BTL_KOJO_RESULTS:0 = 攻撃が効いてない……
				BTL_KOJO_RESULTS:1 = %CSTR:ARG:일인칭%は全力なんだけどなぁ……
			ELSE
				BTL_KOJO_RESULTS:0 = うぅ～全く通じてない……
			ENDIF
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			SELECTCASE RAND:2
			CASE 0
				BTL_KOJO_RESULTS:0 = もう疲れたー……動けないよ……
			CASE 1
				BTL_KOJO_RESULTS:0 = ごめんね、疲れちゃった……
			ENDSELECT
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			
			SELECTCASE RAND:4
			CASE 0
				BTL_KOJO_RESULTS:0 = いったぁ……
			CASE 1
				BTL_KOJO_RESULTS:0 = きゃあ！
			CASE 2
				BTL_KOJO_RESULTS:0 = いたーい！
			CASE 3
				BTL_KOJO_RESULTS:0 = ふにゅう……
			ENDSELECT
		;無効
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 効かないよっ
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = よくわかんないけど回復したよ！
		ENDIF
	;反射された
	CASE 15
			BTL_KOJO_RESULTS:0 = いたっ！あれれ……？反射された？
	;反射した
	CASE 16
			BTL_KOJO_RESULTS:0 = 弾き返しちゃうよっ！
	;回避された
	CASE 17
			BTL_KOJO_RESULTS:0 = あれっ？
	;回避した
	CASE 18
		SELECTCASE RAND:2
		CASE 0
			BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%はここだよっ
		CASE 1
			BTL_KOJO_RESULTS:0 = 当たらないよっ
		ENDSELECT
	;反撃スキル発動した
	CASE 20
			BTL_KOJO_RESULTS:0 = お返しだよっ！
	CASE 22
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				BTL_KOJO_RESULTS:0 = えへっ、えへへへへ……！
			CASE "SHOCK"
				BTL_KOJO_RESULTS:0 = 身体が痺れて動けないよ……
			CASE "FREEZE"
				BTL_KOJO_RESULTS:0 = さむいよぅ……
			CASE "BIND", "PALYZE"
				BTL_KOJO_RESULTS:0 = つまんなーい……
			CASE "PANIC"
				BTL_KOJO_RESULTS:0 = うーみはひろいなおーきいなぁ♪
			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 = うにゃ……むにゃあ……
			;CASE "CLOSE"
			;	BTL_KOJO_RESULTS:0 = 
			CASE "POISON"
				BTL_KOJO_RESULTS:0 = うぇぇ～気持ち悪い……
			;CASE "BOMB"
			CASE "CHARM"
				BTL_KOJO_RESULTS:0 = ねえねえ！あそぼっ、あそぼっ！
			;CASE "CURSE"
			;CASE "FLY"
			;CASE "STONE"
			;CASE "FLAME"
			;CASE "SLIP"
			;CASE "BRAND"
			;	BTL_KOJO_RESULTS:0 = 
			;その他の状態異常
			;CASEELSE
		ENDSELECT
	;バトルに勝利した
	CASE 90
		IF DI残りターン > 0
			SELECTCASE RAND:2
			CASE 0
				BTL_KOJO_RESULTS:0 = もうおわり？
			CASE 1
				BTL_KOJO_RESULTS:0 = 次はもっと強いのと戦いたいな
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
			CASE 0
				BTL_KOJO_RESULTS:0 = いえーい！
			CASE 1
				BTL_KOJO_RESULTS:0 = うーん……もっと遊びたかったなー
			ENDSELECT
		ENDIF
	;レベルアップした
	CASE 91
		IF DI残りターン > 0
			BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%も少しは強くなれたかな
		ELSE
			BTL_KOJO_RESULTS:0 = れべるあーっぷ！！
		ENDIF
	;逃走に成功した
	CASE 92
			BTL_KOJO_RESULTS:0 = 逃げるよっ！それじゃあね！
	;逃走に失敗した
	CASE 93
			BTL_KOJO_RESULTS:0 = あいたっ
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 
		ELSE
			BTL_KOJO_RESULTS:0 = 遊んでくれるの？
		ENDIF
	;バックアタックを受けた
	CASE 95
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 
		ELSE
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;敵の先制攻撃を受けた
	CASE 96
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 
		ELSE
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;先制攻撃に成功
	CASE 97
			BTL_KOJO_RESULTS:0 = 
ENDSELECT
