@KOJO_BATTLE_MESSAGE_K[[キャラ:나이트메어]], ARG,ARG:1 = 0
LOCAL:1 = 1
LOCAL = CFLAG:ARG:입력행동
LOCALS = 갈게요오！

;崩壊してる場合は口上表示しない
SIF TALENT:ARG:9
	RETURN 0


CALL GET_SKILL_PROP, "SKILL_EFECT", LOCAL, ARG
IF RESULT == 1 && RAND:3 == 0
	CALL GET_SKILL_PROP, "SKILL_TYPE", CFLAG:ARG:입력행동, ARG,ARG
	SELECTCASE RESULT
		;검격
		CASE 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 으랴아！
			ELSE
				BTL_KOJO_RESULTS:0 = 마구 잘라버리는 거에요오！
			ENDIF
		;비구
		CASE 1
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 이야앗！구멍난 치츠처럼 만들어드릴게요오！
			ELSE
				BTL_KOJO_RESULTS:0 = 아하하！맞으세요！
			ENDIF
		;타격
		CASE 2
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 으랴아아！
			ELSE
				BTL_KOJO_RESULTS:0 = 공격을 맛보세욧！！
			ENDIF
		;전술
		CASE 3
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 나비처럼 날아、벌처럼 쏜 뒤、악몽까지 선사해드릴게요오！
			ELSE
				BTL_KOJO_RESULTS:0 = 으음、이번엔 이 공격을 …에에이！귀찮아요오오！！
			ENDIF
		;화염
		CASE 4
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 활활 타버리세요！
			ELSE
				BTL_KOJO_RESULTS:0 = 아하하！불타버려！！
			ENDIF
		;빙결
		CASE 5
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 꽁꽁 얼려드릴게요오！
			ELSE
				BTL_KOJO_RESULTS:0 = 혹시 얼려지는 게 취미인가요？
			ENDIF
		;전격
		CASE 6
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 전격으로、찌릿찌릿하게 만들어드릴게요오！！！
			ELSE
				BTL_KOJO_RESULTS:0 = 으음、용서하지 않아요！
			ENDIF
		;충격
		CASE 7
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 날아가버렷！
			ELSE
				BTL_KOJO_RESULTS:0 = 날려버려 드릴게요오!
			ENDIF
		;신경
		CASE 8	
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 제 특기 분야군요。
			ELSE
				BTL_KOJO_RESULTS:0 = 어떤가요？효과가 있죠？
			ENDIF
		;정신
		CASE 9
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 멘탈이 약하군요…
			ELSE
				BTL_KOJO_RESULTS:0 = 『나이트메어』에겐 이런 건 식은 죽 먹기에요。
			ENDIF
		;파마
		CASE 10
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 에、편하게 해드릴까요…？
			ELSE
				BTL_KOJO_RESULTS:0 = 성불시켜 드릴게요！
			ENDIF
		;주살
		CASE 11
			BTL_KOJO_RESULTS:0 = 자아、『ーーーーーー』이에요!
		;지변
		CASE 12
			BTL_KOJO_RESULTS:0 = 모래에 묻어드리죠！
		;수격
		CASE 13
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 찬물은 어떠세요？
			ELSE
				BTL_KOJO_RESULTS:0 = 그、그러니까… 쓰나미라는 건 뭔가요?
			ENDIF
		;질풍
		CASE 14
				BTL_KOJO_RESULTS:0 = 날아가버렷！
		;중력
		CASE 15
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 에、저기… 안됐지만、이걸로 작별이네요。
			ELSE
				BTL_KOJO_RESULTS:0 = 눌려져버려어！
			ENDIF
		;핵열
		CASE 16
				BTL_KOJO_RESULTS:0 = 녹여드릴게요오。
		;만능
		CASE 17
			BTL_KOJO_RESULTS:0 = 모두 똑같이… 부서져버렷！
		;사이코
		;CASE 18
		CASEELSE
			BTL_KOJO_RESULTS:0 = 정신을 만진다는 건、이렇게 하는 거라구요！
	ENDSELECT
;회복
ELSEIF RESULT == 2
	IF CFLAG:ARG:타겟 > 6
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 자、회복시킬게요오。
		ELSE
			BTL_KOJO_RESULTS:0 = 조금은 괜찮아지셨나요？
		ENDIF
	ELSE
		IF FLAG:(CFLAG:ARG:타겟) == 0 && 陥落(ARG)
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 안돼、안된다구요！자 봐요、괜찮지 않잖아요？
			ELSE
				BTL_KOJO_RESULTS:0 = 제、제발！걱정끼치지 말아주세요오！
			ENDIF
		ELSE
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 자、제대로 싸워주세요！！
			ELSE
				BTL_KOJO_RESULTS:0 = 일어서는 거에요！자、제대로 하는거에요！
			ENDIF
		ENDIF
	ENDIF
;状態変化
;ELSEIF RESULT == 3
;特殊
;ELSEIF RESULT == 4
;状態回復
ELSEIF RESULT == 5
	BTL_KOJO_RESULTS:0 = 자、제대로 하는거에요！
ENDIF

;デクンダ
IF LOCAL == 505
	BTL_KOJO_RESULTS:0 = 다시 한 번、원점으로 돌아가주세요。
;スクンダ
ELSEIF LOCAL == 507
	BTL_KOJO_RESULTS:0 = 어라라？상당히 늦었네요
;デカジャ
ELSEIF LOCAL == 509
	BTL_KOJO_RESULTS:0 = 확실히 낫는거에요
;기합
ELSEIF LOCAL == 511
	BTL_KOJO_RESULTS:0 = 간다구욧！
;컨센트레이트
ELSEIF LOCAL == 512
	BTL_KOJO_RESULTS:0 = 집중…하는거에요오
;雄たけび
ELSEIF LOCAL == 514
	BTL_KOJO_RESULTS:0 = 우、우오오오오오옷！！
;도발
ELSEIF LOCAL == 515
	BTL_KOJO_RESULTS:0 = 엉덩이 팡팡！…잠깐…부끄럽다고요.。

ENDIF

;SIF LOCALS != "EMPTY"
;	CALL MESSAGE_B(LOCAL:1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)

@BATTLE_EVENT_K[[キャラ:나이트메어]], ARG, ARG:1, ARG:2
SIF ARG < 0 && NO:ARG != 4518
	RETURN 0
LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = EMPTY
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 그럼、단숨에 가자구요오!
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = 지금이야말로 돌겨어어어억！
		ELSE
			BTL_KOJO_RESULTS:0 = 후훗…깨소금맛이네！
		ENDIF
	CASE 2
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 눌러버려요！다 같이 해치우자고요오！
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = 여기에욧！！
		ELSE
			BTL_KOJO_RESULTS:0 = 돌겨어어어억！！！
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = 방해물은、빠이빠이(bye~ bye~)에요!
			ELSE
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 빠이빠이(bye~ bye~)에요！
				ELSE
					BTL_KOJO_RESULTS:0 = 꿈으로 죽는 기분은 어때요？
				ENDIF
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 끄、끄떡없어…
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 자… 얼마나 버틸 수 있을까요？
			ELSE
				BTL_KOJO_RESULTS:0 = 어떤가요？너덜너덜하지요？
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 20
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 자아、아직 계속됩니다~
			ELSE
				BTL_KOJO_RESULTS:0 = 아직 끝나지 않았어요！
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 으챠、다시 한 번 간다구욧！！
			ELSE
				BTL_KOJO_RESULTS:0 = 아직 부족한가요？
			ENDIF
		;無効化された
		ELSEIF ARG:2 == 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = 토、통하지 않아…！？
			ELSE
				BTL_KOJO_RESULTS:0 = 왜、어째서 통하지 않는거에요오！？
			ENDIF
		;吸収された
		ELSEIF ARG:2 < 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 어라、흐、흡수했다…？
			ELSE
				BTL_KOJO_RESULTS:0 = 우와와와！흡수되어 버렸다고！？
			ENDIF
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = 죄송…해요…
			ELSE
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 뭐…어…？
				ELSE
					BTL_KOJO_RESULTS:0 = 아우…
				ENDIF
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = 『나이트메어』를、얕보지마아아아！
			ELSE
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 키큭…！지、지지 않아요오！
				ELSE
					BTL_KOJO_RESULTS:0 = 우큭…！지、안 져욧…！
				ENDIF
			ENDIF
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 아、아직이에요！
			ELSE
				BTL_KOJO_RESULTS:0 = 그、그렇게 아프진…크윽.。
			ENDIF
		ELSEIF ダメージ割合(ARG, ARG:2) > 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 안 통하거든요~！…조금 간지러울 뿐이네요。
			ELSE
				BTL_KOJO_RESULTS:0 = 안 통하지만… 조、조금 아프네요。
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 지금 뭔가 했나요？
			ELSE
				BTL_KOJO_RESULTS:0 = 베리어가 쳐져있거든요오~！
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 어머、고맙기도 하셔라!
			ELSE
				BTL_KOJO_RESULTS:0 = 어머어머？조금 기운이 넘치네요？
			ENDIF
		ENDIF
	CASE 15
		;被反射
		PRINTFORMW ARG:2 = {ARG:2}
		IF RAND:2
			BTL_KOJO_RESULTS:0 = …튕겨냈다…！？
		ELSE
			BTL_KOJO_RESULTS:0 = 아흑！？튀、튕겨져 나왔다고！？
		ENDIF
	CASE 16
		;反射
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 어때요、아프지요？
		ELSE
			BTL_KOJO_RESULTS:0 = 방어벽이 있지롱~! 그리고 공격을 돌려줄게요오~！
		ENDIF
	CASE 17
		;敵回避
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 피했다…！？
		ELSE
			BTL_KOJO_RESULTS:0 = 마、맞추지 못했다구요오！？
		ENDIF
	CASE 18
		;自分回避
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 후후！느리다구요~
		ELSE
			BTL_KOJO_RESULTS:0 = 헤헤、못맞췄지롱~！
		ENDIF
	;食いしばり等で耐えた
	CASE 23
		;이악물기
		IF BASE:ARG:ＨＰ == 1
			BTL_KOJO_RESULTS:0 = 얕보지 말아주세요오…
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = 이 정도로는、지지 않는다구요오！
		ENDIF
ENDSELECT
;SIF LOCALS != "EMPTY"
;	CALL MESSAGE_B(LOCAL:1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)
