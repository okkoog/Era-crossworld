@KOJO_BATTLE_MESSAGE_K[[キャラ:악마호무라]], ARG,ARG:1 = 0
LOCAL:1 = 1
LOCAL = CFLAG:ARG:입력행동
LOCALS = 얼른 정리해 버릴까요？

;崩壊してる場合は口上表示しない
SIF TALENT:ARG:9
	RETURN 0

;必死にくるみ割り人形のモチーフを加えてみた
CALL GET_SKILL_PROP, "SKILL_EFECT", LOCAL, ARG
IF RESULT == 1 && RAND:3 == 0
	CALL GET_SKILL_PROP, "SKILL_TYPE", CFLAG:ARG:입력행동, ARG,ARG
	SELECTCASE RESULT
		;검격
		CASE 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 無様に切り裂かれなさい
			ELSE
				BTL_KOJO_RESULTS:0 = 特に恨みもないけれど、ごめんなさいね
			ENDIF
		;비구
		CASE 1
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 昔を思い出すわね…%UNICODE(0x2661)%
			ELSE
				BTL_KOJO_RESULTS:0 = 躱せるようにしてあげるつもりもないもの
			ENDIF
		;타격
		CASE 2
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 壊れてしまいなさい、呪われた人形のように
			ELSE
				BTL_KOJO_RESULTS:0 = 小さなクララの一撃はどう？
			ENDIF
		;전술
		CASE 3
			IF RAND:2
				BTL_KOJO_RESULTS:0 = ふふ、バラバラにしてあげる…%UNICODE(0x2661)%
			ELSE
				BTL_KOJO_RESULTS:0 = くだらない時間は取りたくはないわね
			ENDIF
		;화염
		CASE 4
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 塵になりなさい
			ELSE
				BTL_KOJO_RESULTS:0 = 悪魔が振るう地獄の炎の味はどうかしら？
			ENDIF
		;빙결
		CASE 5
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 雪片が踊り狂っているわね…
			ELSE
				BTL_KOJO_RESULTS:0 = 無様に封じ込められなさい、嘗ての私のように
			ENDIF
		;전격
		CASE 6
			IF RAND:2
				BTL_KOJO_RESULTS:0 = ふふ、存分に痺れていなさい…！
			ELSE
				BTL_KOJO_RESULTS:0 = 動かないでいて、目障りだわ
			ENDIF
		;충격
		CASE 7
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 今の私なら吹き飛ばすくらいはできるわ
			ELSE
				BTL_KOJO_RESULTS:0 = これならどうかしら
			ENDIF
		;신경
		CASE 8	
			BTL_KOJO_RESULTS:0 = 私にまともな神経なんて、とっくにないのにね
		;정신
		CASE 9
			IF RAND:2
				BTL_KOJO_RESULTS:0 = ふふ、貴方の記憶は本当に正確かしらね？
			ELSE
				BTL_KOJO_RESULTS:0 = 夢でも見てなさい、小さなクララのように
;くるみ割り人形の主人公、人形サイズに小さくなる、夢落ちで終わる場合を採用
			ENDIF
		;파마
		CASE 10
			IF RAND:2
				BTL_KOJO_RESULTS:0 = まどかの力の一部、こんな形で使うとはね
			ELSE
				BTL_KOJO_RESULTS:0 = 円環の理へと導かれなさい
			ENDIF
		;주살
		CASE 11
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 魔なるもの、その力のお味はどう？
			ELSE
				BTL_KOJO_RESULTS:0 = 聖なるものを貶める、その力はどう？
			ENDIF
		;지변
		CASE 12
			BTL_KOJO_RESULTS:0 = 今の私なら大地を操るくらいお手の物よ
		;수격
		CASE 13
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 頭を冷やしてみる？
			ELSE
				BTL_KOJO_RESULTS:0 = 無様に溺れなさい、哀れな人魚姫のように
			ENDIF
		;질풍
		CASE 14
				BTL_KOJO_RESULTS:0 = 吹き飛ばしてあげる…
		;중력
		CASE 15
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 潰れてしまいなさい、この罪の重みで
			ELSE
				BTL_KOJO_RESULTS:0 = 激しく参りましょうか、眼帯の彼女の様に。
			ENDIF
		;핵열
		CASE 16
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 消えなさい、魂すらも
			ELSE
				BTL_KOJO_RESULTS:0 = もしもあの時にこれが使えていれば、勝ち目はあったのかしらね？
			ENDIF
		;만능
		CASE 17
			BTL_KOJO_RESULTS:0 = 神に叛逆した力の一端、良く味わいなさい
		;사이코
		;CASE 18
		CASEELSE
			BTL_KOJO_RESULTS:0 = アタシ、アンタ、マルカジリ！
	ENDSELECT
;회복
ELSEIF RESULT == 2
	IF CFLAG:ARG:타겟 > 6
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 傷を治す程度、今の私には何の苦労もないわ
		ELSE
			BTL_KOJO_RESULTS:0 = その程度で魔を滅せるとでも思ったの？
		ENDIF
	ELSE
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 早く立ちなさい、その程度ではないでしょ？
		ELSE
			BTL_KOJO_RESULTS:0 = 目障りだけど、あなたはまだ必要なの
		ENDIF
	ENDIF
;状態変化
;ELSEIF RESULT == 3
;特殊
;ELSEIF RESULT == 4
;状態回復
ELSEIF RESULT == 5
	BTL_KOJO_RESULTS:0 = 寝ぼけているようなら死んでもらうわ、早く起きなさい
ENDIF

;사랑을품은검은날개
IF LOCAL == 2988
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = ああ、まどか、貴方のためなら…
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 世界を書き換える力、その身にお受けなさい
	ELSE
		BTL_KOJO_RESULTS:0 = 私のまどかへの愛は貴方程度では受け入れられないわ
	ENDIF

;刹那五月雨撃ち
ELSEIF LOCAL == 108
	BTL_KOJO_RESULTS:0 = 鍛え上げた銃技、その身に刻んでお逝きなさい！
;연속사격
ELSEIF LOCAL == 112
	BTL_KOJO_RESULTS:0 = 貴方の速度で私についてこられるかしら？
;비구가드브레이크
ELSEIF LOCAL == 129
	BTL_KOJO_RESULTS:0 = 私の弾丸からは誰も逃れられない……！
;タルカジャ
ELSEIF LOCAL == 501
	BTL_KOJO_RESULTS:0 = しっかり一撃を打ち込みなさい
;スクカジャ
ELSEIF LOCAL == 502
	BTL_KOJO_RESULTS:0 = この手の魔法は昔を思い出すわ…
;マカカジャ
ELSEIF LOCAL == 503
	BTL_KOJO_RESULTS:0 = 少し魔力を融通してあげましょうか？
;ラクカジャ
ELSEIF LOCAL == 504
	BTL_KOJO_RESULTS:0 = 貴方は隙が大きすぎるんじゃないの？
;デクンダ
ELSEIF LOCAL == 505
	BTL_KOJO_RESULTS:0 = そんなことをしても無駄よ
;スクンダ
ELSEIF LOCAL == 507
	BTL_KOJO_RESULTS:0 = ふふふ、逃がしてあぁげない
;デカジャ
ELSEIF LOCAL == 509
	BTL_KOJO_RESULTS:0 = せいぜい無駄にあがいて見せることね
;기합
ELSEIF LOCAL == 511
	BTL_KOJO_RESULTS:0 = まどかのためにならどんなことだってできるわ…
;컨센트레이트
ELSEIF LOCAL == 512
	BTL_KOJO_RESULTS:0 = ああ…まどか…
;雄たけび
ELSEIF LOCAL == 514
	BTL_KOJO_RESULTS:0 = まどかぁぁっ―――！！
;도발
ELSEIF LOCAL == 515
	BTL_KOJO_RESULTS:0 = 昔の私よりももっと出来損ないね、壊れた人形みたい
;리벨리온
ELSEIF LOCAL == 516
	BTL_KOJO_RESULTS:0 = さ、始めましょうか
;스쿠카쟈오토
ELSEIF LOCAL == 2417
	BTL_KOJO_RESULTS:0 = 昔使っていた魔法を思い出させるわね…
ELSEIF LOCAL == 2981
	BTL_KOJO_RESULTS:0 = 消えなさい、円環の果てに
ELSEIF LOCAL == 420
	BTL_KOJO_RESULTS:0 = 私の愛を見てみるつもりかしら？
ELSEIF LOCAL == 539
	BTL_KOJO_RESULTS:0 = 魔の力の一端を覗いてみなさいな
ELSEIF LOCAL == 1406
	BTL_KOJO_RESULTS:0 = 魔というのがどういうことか、教えてあげる…
ELSEIF LOCAL == 1838
	BTL_KOJO_RESULTS:0 = そう、私は朝の夢を見る…永遠に終わらない夜の中で…
ENDIF

;SIF BTL_KOJO_RESULTS:0 != "EMPTY"
;	CALL MESSAGE_B2(CALLNAME:ARG, 0, BTL_KOJO_RESULTS:0, BTL_KOJO_RESULTS:0:1, BTL_KOJO_RESULTS:0:2, BTL_KOJO_RESULTS:0:3, BTL_KOJO_RESULTS:0:4)
	;CALL MESSAGE_B(LOCAL:1, BTL_KOJO_RESULTS:0, BTL_KOJO_RESULTS:0:1, BTL_KOJO_RESULTS:0:2, BTL_KOJO_RESULTS:0:3, BTL_KOJO_RESULTS:0:4)

@KOJO_BATTLE_EVENT_K[[キャラ:악마호무라]], ARG, ARG:1, ARG:2
SIF ARG < 0 && NO:ARG != 4518
	RETURN 0
LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = EMPTY
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = まあ、せいぜい磨り潰すことね
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = チャンスは作ったわ、あとは好きにして
		ELSE
			BTL_KOJO_RESULTS:0 = この隙くらいは突きなさい？
		ENDIF
	CASE 2
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 終わりなさい
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = せいぜい沈みなさい
		ELSE
			BTL_KOJO_RESULTS:0 = さっさと滅ぼしてあげるわ…
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = さようなら、もう会うこともないでしょうね。
			ELSE
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 次に消えたいのは誰かしら。
				ELSE
					BTL_KOJO_RESULTS:0 = その程度の力で、わたしに勝てると思っていたのかしら？
				ENDIF
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = ただ防いだだけかしら？芸がないのね
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			IF RAND:2
				BTL_KOJO_RESULTS:0 = あら、その程度？
			ELSE
				BTL_KOJO_RESULTS:0 = 今楽にしてあげるわ。
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 20
			IF RAND:2
				BTL_KOJO_RESULTS:0 = まあ、この程度なのかしらね
			ELSE
				BTL_KOJO_RESULTS:0 = 特に大した相手でもないのね
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = あら、無駄に硬いのね
			ELSE
				BTL_KOJO_RESULTS:0 = 硬い以外の芸は無いの？
			ENDIF
		;無効化された
		ELSEIF ARG:2 == 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = へぇ、これじゃあだめらしいわね…
			ELSE
				BTL_KOJO_RESULTS:0 = …なるほどね
			ENDIF
		;吸収された
		ELSEIF ARG:2 < 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 貴方、なかなかに気持ちが悪いわね
			ELSE
				BTL_KOJO_RESULTS:0 = 貴方も私と似たようなものかしらね？;円環を吸収したほむほむ
			ENDIF
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = まどか…ごめんなさい…。
			ELSE
				IF RAND:2
					BTL_KOJO_RESULTS:0 = まどか…どうか…そのままに…。
				ELSE
					BTL_KOJO_RESULTS:0 = まど……か……。
				ENDIF
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS:0 = そうそう倒れてあげるほど私はやさしくないわ
			ELSE
				IF RAND:2
					BTL_KOJO_RESULTS:0 = まどかの代わりになるのならいくらでも…
				ELSE
					BTL_KOJO_RESULTS:0 = ああ、まどか…
				ENDIF
			ENDIF
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 魔を払う力というものかしら？
			ELSE
				BTL_KOJO_RESULTS:0 = 思っていたよりはやるわね…
			ENDIF
		ELSEIF ダメージ割合(ARG, ARG:2) > 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 貴方はその程度の力で私に立ち向かえるの？
			ELSE
				BTL_KOJO_RESULTS:0 = 温いわね、その程度かしら？
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 残念ね、私にそれは通じないわ
			ELSE
				BTL_KOJO_RESULTS:0 = 通じると思ったのかしら？　思ったよりも愚鈍なのね。
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = あら、力を分けてくれるの？
			ELSE
				BTL_KOJO_RESULTS:0 = とんだマヌケね、力をありがとう
			ENDIF
		ENDIF
	CASE 15
		;被反射
		;PRINTFORMW ARG:2 = {ARG:2}
		IF RAND:2
			BTL_KOJO_RESULTS:0 = ふふ、おもしろいわね…
		ELSE
			BTL_KOJO_RESULTS:0 = 妙なものがこっちには居るのね…
		ENDIF
	CASE 16
		;反射
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 悪魔にそんなものが効くと思っているのかしらね、この悪魔は
		ELSE
			BTL_KOJO_RESULTS:0 = 何も考えていないのかしら？
		ENDIF
	CASE 17
		;敵回避
		IF RAND:2
			BTL_KOJO_RESULTS:0 = へぇ、少しはやるのね
		ELSE
			BTL_KOJO_RESULTS:0 = それなりには早いのね、貴方
		ENDIF
	CASE 18
		;自分回避
		IF RAND:2
			BTL_KOJO_RESULTS:0 = それで攻撃したつもりかしら？
		ELSE
			BTL_KOJO_RESULTS:0 = 無様ね、貴方
		ENDIF
	;食いしばり等で耐えた
	CASE 23
		;이악물기
		IF BASE:ARG:ＨＰ == 1
			BTL_KOJO_RESULTS:0 = あっははは、この時を待ってたの
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = ああ、まどか…今はもうこの痛みさえも愛おしいわ…
		ENDIF
ENDSELECT
