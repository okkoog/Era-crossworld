;--------------------------------------------------------------------------------------------------
;★オセのタイプ変動に関係した関数
;--------------------------------------------------------------------------------------------------
;-------------------------------------------------
;†調教者の射精によるオセのタイプ変動　CFLAG:801
;-------------------------------------------------
@OSE_TYPE_CHANGE_1_K[[キャラ:오세]]
;オセの口に射精
IF TFLAG:0 > 0
	CFLAG:801 += 1
;オセに中出し
ELSEIF TFLAG:2 > 0
	;アナルに中出し
	IF SELECTCOM == 62 || SELECTCOM == 63 || SELECTCOM == 67 || SELECTCOM == 70 || SELECTCOM == 71 || SELECTCOM == 73 || SELECTCOM == 512 || SELECTCOM == 514
		;あなたが中出し
		IF ASSIPLAY == 0
			;陥落済み
			IF TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8
				CFLAG:801 += 2
				;親愛なら上昇
				SIF TALENT:친애
					CFLAG:801 += 1
				;オセが夫なら下降
				SIF TALENT:남편
					CFLAG:801 -= 1
			ELSE
				CFLAG:801 += 1
			ENDIF
		;あなた以外が中出し
		ELSE
			CFLAG:801 += 1
		ENDIF
	;尻穴狂いなら上昇
	SIF TALENT:애널광
		CFLAG:801 += 3
	ENDIF
;逆レイプであなたが射精
ELSEIF TFLAG:12 > 0
	CFLAG:801 -= 1
	;オセが親愛or夫なら下降
	SIF TALENT:친애
		CFLAG:801 -= 2
	SIF TALENT:남편
		CFLAG:801 -= 3
ENDIF

;口内or中出しで精液中毒Lv4以上なら上昇
SIF ABL:정액중독 >= 4 && (TFLAG:0 > 0 || TFLAG:2 > 0 )
	CFLAG:801 += 2

;-------------------------------------------------
;†触手によるオセのタイプ変動（触手コマンドは一括）　CFLAG:801
;-------------------------------------------------
@OSE_TYPE_CHANGE_2_K[[キャラ:오세]]
;アナル触手、触手乳首責め、触手緊縛、触手浣腸、触手口辱、触手ペニス責めを実行した場合
IF GROUPMATCH(SELECTCOM , 162 , 164 , 166 , 167 , 168 , 169 )
	CFLAG:801 += 1
	;触手が射精したら上昇
	SIF TFLAG:15 >0
		CFLAG:801 += 1
	;触手が射精して触手中毒Lv4以上なら上昇
	SIF TFLAG:15 >0 && ABL:촉수중독 >= 4
		CFLAG:801 += 3
	;アナルコマンドで尻穴狂いなら上昇
	SIF TALENT:애널광 && (SELECTCOM == 162 || SELECTCOM == 167)
		CFLAG:801 += 3
	;口内or中出しで精液中毒Lv4以上なら上昇
	SIF ABL:정액중독 >= 4 && (TFLAG:0 > 0 || TFLAG:2 > 0 )
	CFLAG:801 += 2
ENDIF

;-------------------------------------------------
;†オセの絶頂or射精によるオセのタイプ変動　CFLAG:801
;-------------------------------------------------
@OSE_TYPE_CHANGE_3_K[[キャラ:오세]]
;絶頂の判定
;Ａ絶頂した場合
IF NOWEX:2 > 0 
	;強絶頂
	IF TFLAG:29 > 1
		CFLAG:801 += 2
	;절정
	ELSEIF TFLAG:29 > 0
		CFLAG:801 += 1
	ENDIF
	;尻穴狂いなら上昇
	SIF TALENT:애널광
		CFLAG:801 += 2
ENDIF

;Ｂ絶頂した場合
IF NOWEX:3 > 0 
	;強絶頂
	IF TFLAG:29 > 1
		CFLAG:801 += 2
	;절정
	ELSEIF TFLAG:29 > 0
		CFLAG:801 += 1
	ENDIF
ENDIF

;オセが射精した場合
;Ａ系調教時射精で上昇
IF TFLAG:10 > 0
	IF GROUPMATCH(SELECTCOM , 4 , 5 , 45 , 46 , 62 , 63 , 67 , 70 , 71 , 73 , 500 , 512 , 514 )
		CFLAG:801 += 2
		;尻穴狂いなら上昇
		SIF TALENT:애널광
			CFLAG:801 += 2
	;調教者に中出しで下降
	ELSEIF GROUPMATCH(SELECTCOM , 64 , 92 , 93 , 94 , 95 , 96 , 97 )
		CFLAG:801 -= 2
		;大量射精
		SIF TFLAG:10 == 2
			CFLAG:801 -= 2
		;オセに主導権
		SIF TEQUIP:주도권
			CFLAG:801 -= 3
		;相手があなたで親愛なら下降
		SIF TALENT:친애 && ASSIPLAY == 0
			CFLAG:801 -= 1
		;相手があなたでオセが夫なら下降
		SIF TALENT:남편 && ASSIPLAY == 0
			CFLAG:801 -= 2
		;尻穴狂いなら上昇
		SIF TALENT:애널광
			CFLAG:801 += 2
	;フェラする、パイズリするで射精
	ELSEIF GROUPMATCH(SELECTCOM , 2 , 90 , 91 )
		CFLAG:801 -= 1
		;大量射精
		SIF TFLAG:10 == 2
			CFLAG:801 -= 2
			;オセに主導権
		SIF TEQUIP:주도권
			CFLAG:801 -= 3
	ENDIF
;口内、中出しで調教者の精液中毒Lv4以上なら下降
SIF ABL:PLAYER:정액중독 >= 4 && ( SELECTCOM == 2 || SELECTCOM == 64 || SELECTCOM == 92 || SELECTCOM == 93 || SELECTCOM == 94 || SELECTCOM == 95 || SELECTCOM == 96 || SELECTCOM == 97)
	CFLAG:801 -= 2
ENDIF

;--------------------------------------------------------------------------------------------------
;★コマンド地の文に関係した関数
;--------------------------------------------------------------------------------------------------
;-------------------------------------------------
;■COM「자위」
;-------------------------------------------------
@OSE_JII_1_K[[キャラ:오세]]
;従順LV3未満
IF ABL:0 < 3
	PRINTFORM 자위命令%CALLNAME:TARGET%
	;프라이드높음
	SIF TALENT:15
		PRINT 高見
	;반항적
	IF TALENT:11 || RAND:2 == 0
		PRINT 반항적態度
	;꿋꿋함
	ELSEIF TALENT:12 || RAND:2 == 1
		PRINT 꿋꿋함態度
	ENDIF
	PRINT 노려봤지만 명령에 마지못해
;従順LV5未満
ELSEIF ABL:0 <= 5
	PRINTFORM 조교의 성과가 나왔는지、%TARGET은% 명령에 따라、
ELSE
	PRINTFORM %TARGET은% 자위의 명령도 싫어하는 기색을 보이지 않고、
ENDIF
;ビデオ撮影中
SIF TEQUIP:28
	PRINT 비디오카메라前
;露出癖LV6以上
SIF ABL:8 >= 6
	PRINT 見、
;바이브＋애널바이브
IF TEQUIP:13 && TEQUIP:14
	IF TEQUIP:의상내장애무패턴Ｖ == 1
		PRINTFORM %CLOTHESNAMEF(TARGET,TEQUIP:음순노출)%의 위에서부터
		IF RAND:2 == 0
			PRINTFORM 추가로 넣었다
		ENDIF
		PRINTFORM 2 개의 바이브를
		IF RAND:2 == 0
			PRINTFORM 움직이면서
		ELSE
			PRINTFORM 누르면서
		ENDIF
	ELSEIF TEQUIP:의상내장애무패턴Ｖ == 2
		PRINTFORM %CLOTHESNAMEF(TARGET,TEQUIP:음순노출)%를 비틀어
		IF RAND:2 == 0
			PRINTFORM 추가로 넣었다
		ENDIF
		PRINTFORM 2 개의 바이브를
		IF RAND:2 == 0
			PRINTFORM 교대로
		ENDIF
		IF RAND:2 == 0
			PRINTFORM 움직이면서
		ELSE
			PRINTFORM 스스로 넣으면서
		ENDIF
	ELSE
		PRINTFORM 추가로 넣은 2개의 바이브를 스스로 뽑으면서
	ENDIF
;바이브
ELSEIF TEQUIP:13
	IF TEQUIP:의상내장애무패턴Ｖ == 1
		PRINTFORM %CLOTHESNAMEF(TARGET,TEQUIP:음순노출)%의 위에서 음부에 넣은 바이브를
		IF RAND:2 == 0
			PRINTFORM 움직이면서
		ELSE
			PRINTFORM 누르면서
		ENDIF
	ELSEIF TEQUIP:의상내장애무패턴Ｖ == 2
		PRINTFORM %CLOTHESNAMEF(TARGET,TEQUIP:음순노출)%바기나入바이브
		IF RAND:2 == 0
			PRINTFORM 교대로
		ENDIF
		IF RAND:2 == 0
			PRINTFORM 움직이면서
		ELSE
			PRINTFORM 스스로 넣으면서
