SIF ARG < 0 && NO:ARG != 816
	RETURN 0
;VARSET LOCALS

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
			BTL_KOJO_RESULTS:0 = 「ここがよわいの？」
			BTL_KOJO_RESULTS:1 = 　　　　　　　　「スキをついたよ！」
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = 「みんなでやるのね！」
			BTL_KOJO_RESULTS:1 = 　　　　　　　「おもいっきりやるよ！」
		;それ以外
		ELSE
			BTL_KOJO_RESULTS:0 = 「「みんなでオシオキね！」」
		ENDIF
	;被召喚時
	CASE 3
			BTL_KOJO_RESULTS:0 = 「ケーヤクの元」
			BTL_KOJO_RESULTS:1 = 　　　　　　　「オキツネここにあり！」
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ　　　なんかの口上に同じのあった気がする
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 「てんばつてきめーん！」
			BTL_KOJO_RESULTS:1 = 　　　　　　　　　「ちゅーをくだした！」
		;弱点をついた。つまりCOOP　　　　弱点を突いたが防御されている？芳澤口上はそんな台詞だった
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 「ふせぐなんてなまいきー」
				BTL_KOJO_RESULTS:1 = 　　　　　　　　　　　「まもってばかりでかてるの―？」
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 「いたいでしょ？」
			BTL_KOJO_RESULTS:1 = 　　　　　　「オシオキだからとーぜんね！」
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = 「まだまだいくよっ」
			BTL_KOJO_RESULTS:1 = 　　　　　　　「どんどんいくよっ」
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 「あたったよ！」
				BTL_KOJO_RESULTS:1 = 　　　　　　「とーぜんだよ！」
			ELSE
				BTL_KOJO_RESULTS:0 = 「いたくないの？」
				BTL_KOJO_RESULTS:1 = 　　　　　　　「へんたいさん？」
			ENDIF
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = 「あれ？きかないの？」
			BTL_KOJO_RESULTS:1 = 　　　　　　　　　　「ずるーい！」
		ENDIF
	;ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 「たたってやるー……」
			BTL_KOJO_RESULTS:1 = 　　　　　　　　　　「%CSTR:ARG:이인칭%をたたってやるー……」
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = 「「いったーい！」」
			BTL_KOJO_RESULTS:1 = 「「ゆるさないんだから！！」」
		;無効
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 「「そんなのきかないよ？」」
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = 「ごほうびくれるの？」
			BTL_KOJO_RESULTS:1 = 　　　　　　　　「ありがとー！」
		ENDIF
	;反射された
	CASE 15
			BTL_KOJO_RESULTS:0 = 「「きゃあっ」」
	;反射した
	CASE 16
			BTL_KOJO_RESULTS:0 = 「てんばつね！」
			BTL_KOJO_RESULTS:1 = 　　　　　　「いんがおーほーなんだから！」
	;回避された
	CASE 17
			BTL_KOJO_RESULTS:0 = 「「よけちゃだめー」」
	;回避した
	CASE 18
			BTL_KOJO_RESULTS:0 = 「あたらないよ」
			BTL_KOJO_RESULTS:1 = 　　　　　　　「よゆうだね」
	;反撃を発動した
	CASE 20
		SELECTCASE TFLAG:발동연동스킬
		;닷지카운터
		CASE 2484
			BTL_KOJO_RESULTS:0 = 
		;その他
		CASEELSE
			BTL_KOJO_RESULTS:0 = 
		ENDSELECT
	;トリガースキルを発動した
	CASE 21
		SELECTCASE TFLAG:발동연동스킬
		;○○
		;CASE 
		;	BTL_KOJO_RESULTS:0 = 
		;その他
		CASEELSE
			BTL_KOJO_RESULTS:0 = 
		ENDSELECT
	;バトルに勝利した
	CASE 90
			BTL_KOJO_RESULTS:0 = 
	;レベルアップした
	CASE 91
			BTL_KOJO_RESULTS:0 = 「つよくなったよ！」
			BTL_KOJO_RESULTS:1 = 　　　　　　　　　「もっとイタズラできるね！」
	;逃走に成功した
	CASE 92
			BTL_KOJO_RESULTS:0 = 「またこんどね！」
			BTL_KOJO_RESULTS:1 = 　　　　　　　　「バイバイ！」
	;逃走に失敗した
	CASE 93
			BTL_KOJO_RESULTS:0 = 「しつこいと嫌われるよ？」
			BTL_KOJO_RESULTS:1 = 　　　　　　　　　　　　「そんなことしてると嫌われるよ？」
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 「つかれたー……」
			BTL_KOJO_RESULTS:1 = 　　　　　「だからって負けないけどさ―……」
		ELSE
			BTL_KOJO_RESULTS:0 = 「「わるいコだったらオシオキよ！」」
		ENDIF
	;バックアタックを受けた　後衛が前衛になるやつ
	CASE 95
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 「やられたら　たたってやるー！」
			BTL_KOJO_RESULTS:1 = 　　　　　　　　　　　　　　「%CSTR:ARG:이인칭%を　たたってやるー！」
		ELSE
			BTL_KOJO_RESULTS:0 = 「きゃっ!?」
			BTL_KOJO_RESULTS:1 = 　　　　「ふいうちなんてヒキョーだー！」
		ENDIF
	;敵の先制攻撃を受けた　置くとこは大抵後衛だと思うので　狡猾が仕事してるように見えればいいなって
	CASE 96
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 「ウェー……」
			BTL_KOJO_RESULTS:1 = 　　　　　「%CSTR:ARG:이인칭%ゆだんしすぎ―……」
		ELSE
			BTL_KOJO_RESULTS:0 = 「「かえりうちにしてあげる！」」
		ENDIF
	;先制攻撃に成功
	CASE 97
			BTL_KOJO_RESULTS:0 = 「こっちに気付いてないよ！」
			BTL_KOJO_RESULTS:1 = 　　　　　　　　　　　　　「ひごろの行いがいいからね！」
ENDSELECT
