@EVENTTRAIN_K[[キャラ:모무노후]]_12
;--------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;--------------------------------------------------
IF CFLAG:220 == 0
	PRINTL 이 구상은 여성화 등의 소질 변경이 전제인 구상입니다。
	PRINTW 이 구상에 맞게 소질을 변경합니까？
	PRINTL 
	PRINTL [0] 기능 소질·의복 등을 변경한다
	PRINTL [1] 여체화만 한다
	PRINTL [2] 소질을 변경하지 않는다
	$INPUT_LOOP_bushi_TS
	INPUT
	IF RESULT == 0
		PRINTFORMW ―자지 따위에 절대 지지 않아！
		;呼び名変更
		CSTR:일인칭 = 私
		;処女化
		TALENT:TARGET:0 = 1
		ABL:TARGET:4 = 0
		EXP:TARGET:0 = 0
		;素質変化
		TALENT:절벽 = 0
		TALENT:헌신적 = 0
		TALENT:솔직함 = 0
		TALENT:프라이드높음 = 1
		TALENT:도착적 = 1
		;既に女体化してた時対策
		IF TALENT:남자 == 1
			TALENT:남자 = 0
			TALENT:절벽 = 0
			TALENT:거유 = 1
			CFLAG:220 = 2
		ENDIF

		;服装
		;陣羽織、袴、さらし、手甲
		CFLAG:초기속옷（상） = 503
		CFLAG:속옷（상） = 503
		TEQUIP:속옷（상） = 503
		CFLAG:초기손 = 412
		CFLAG:손 = 412
		TEQUIP:손 = 412
		CFLAG:초기겉옷 = 1029
		CFLAG:겉옷 = 1029
		TEQUIP:겉옷 = 1029
		CFLAG:초기하의 = 215
		CFLAG:하의 = 215
		TEQUIP:하의 = 215
		CFLAG:초기전신복 = 0
		CFLAG:전신복 = 0
		TEQUIP:전신복 = 0

	ELSEIF RESULT == 1
		PRINTFORMW ―여체화만 진행합니다―
		CSTR:일인칭 = 나
		SIF TALENT:남자 == 1
			TALENT:절벽 = 0
		TALENT:남자 = 0
	ELSEIF RESULT == 2
		PRINTFORMW ―남자인 채로 시작합니다―
	ELSE
		GOTO INPUT_LOOP_bushi_TS
	ENDIF
	CFLAG:800 = 2
	SIF CFLAG:220 == 0
		CFLAG:220 = 1
ENDIF
