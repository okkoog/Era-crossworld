;-------------------------------------------------
;シャドウ雪子（雪子の影）戦闘口上
;-------------------------------------------------
;ライセンスフリー
;雪子の影、千枝の影の口上が同じだと、並べて連れ歩くときちょっと寂しかったので書いた
;言動がeraten内とP4Uと本編のごった煮なのでちょっと温度差ある
;-------------------------------------------------

;-------------------------------------------------
;	Modification Data:
;	番号	更新日			名前			更新内容
;	001		2025/04/11		SaTMRa			新規作成（戦闘口上）
;
;-------------------------------------------------

;-------------------------------------------------
;ライセンスについて
;-------------------------------------------------
;・基本項目
;	(許可する項目を"○"に、許可しない項目を"×"に変更してください。)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1| ○ | 処理上のバグ修正              |
;	+----+----+-------------------------------+
;	|   2| ○ | 口上の誤字・脱字の修正        |
;	+----+----+-------------------------------+
;	|   3| ○ | 口上まとめへの収録            |
;	+----+----+-------------------------------+
;	|   4| ○ | 口上の新規追加                |
;	+----+----+-------------------------------+
;	|   5| ○ | 既存口上の改変                |
;	+----+----+-------------------------------+
;	|   6| ○ | 改変した口上の自由な再配布    |
;	+----+----+-------------------------------+
;	|   7| ○ | 口上内容の転載                |
;	+----+----+-------------------------------+
;
;-------------------------------------------------


;-------------------------------------------------
;使用方法
;-------------------------------------------------
;BTL_KOJO_RESULTSに書きこむと
;台詞と一緒にキャラの画像を表示します。
;■台詞の行数を増やしたいとき
;		BTL_KOJO_RESULTS:0 = 一行目
;		BTL_KOJO_RESULTS:1 = 二行目
;		BTL_KOJO_RESULTS:2 = 三行目
;		BTL_KOJO_RESULTS:3 = 四行目
;		BTL_KOJO_RESULTS:4 = 五行目
;	……と、末尾の番号を増やしていく
;■メッセージ前に文章を出したいとき
;		PRINTL 一行目
;		PRINTL 二行目
;	……このように書くと、ナレーション的な表示になる（セリフ囲いの中に入らない）
;
;例
;
;PRINTL あいうえお
;PRINTL かきくけこ
;BTL_KOJO_RESULTS:0 = さしすせそ
;BTL_KOJO_RESULTS:1 = たちつてと
;　　↓
;あいうえお
;かきくけこ
;┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
;┃さしすせそ　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
;┃たちつてと　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　┃
;┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
;
;-------------------------------------------------


;-------------------------------------------------
;独自処理：雪子の影ロール判定
;-------------------------------------------------
;雪子の影がデビルアームズを持っているか（≒特殊イベントで人化しているか）で分岐させる
;-------------------------------------------------
@K[[キャラ:유키코의그림자]]_雪子影ロール判定()
#FUNCTION
	SIF TALENT:데빌암즈
		RETURNF 1


;-------------------------------------------------
;敵としてこの口上のキャラが登場した際のCOOP発動時のセリフ
;-------------------------------------------------
@KOJO_ENEMY_BATTLE_EVENT_K[[キャラ:유키코의그림자]], ARG, ARG:1, ARG:2
	SELECTCASE GET_BATTLE_EVENT(TFLAG:전투이벤트)
		;敵でのデビルＣＯ－ＯＰ発動時の台詞
		CASE "COOP発動"
			BTL_KOJO_RESULTS:0 = 
		;敵でのデビルＣＯ－ＯＰ参加時の台詞
		CASE "COOP参加"
			BTL_KOJO_RESULTS:0 = 
	ENDSELECT


;-------------------------------------------------
;戦闘中のイベント関連
;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:유키코의그림자]], ARG, ARG:1, ARG:2
;おまじない：雪子の影でなければカット
SIF ARG < 0 && NO:ARG != 3340
	RETURN 0

SELECTCASE GET_BATTLE_EVENT(TFLAG:전투이벤트)
	;COOP発動 発動者の番号はARGに格納されている
	CASE "COOP発動"
		IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = うふふ、ふふふ、ふふふ！
				CASE 1
					BTL_KOJO_RESULTS:0 = ドキドキする
					BTL_KOJO_RESULTS:1 = 好きに壊していいのね？
				CASE 2
					BTL_KOJO_RESULTS:0 = ああ、楽しいわ、楽しいわ！
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = ずたずたにしてあげる
				CASE 1
					BTL_KOJO_RESULTS:0 = 食べてしまっていいの？
				CASE 2
					BTL_KOJO_RESULTS:0 = 串刺しにして晒してあげる！
			ENDSELECT
		ENDIF
	;COOP参加
	CASE "COOP参加"
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			;恋慕系
			IF 陥落() && RESULTS == "연모"
				IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
					SELECTCASE RAND:3
						CASE 0
							BTL_KOJO_RESULTS:0 = 愛の共同作業！
							BTL_KOJO_RESULTS:1 = うふふ、ふふ、任せて！
						CASE 1
							BTL_KOJO_RESULTS:0 = ああ、ドキドキする！
							BTL_KOJO_RESULTS:1 = %CSTR:이인칭%とするならなんだって楽しいわ！
						CASE 2
							BTL_KOJO_RESULTS:0 = 早く死になさいよ
							BTL_KOJO_RESULTS:1 = %CSTR:이인칭%と二人きりになれないでしょ
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 0
							BTL_KOJO_RESULTS:0 = ねえ、こいつは家に飾っていいかしら？
						CASE 1
							BTL_KOJO_RESULTS:0 = %CSTR:이인칭%、いまいくわっ
						CASE 2
							BTL_KOJO_RESULTS:0 = %CSTR:이인칭%の邪魔者は
							BTL_KOJO_RESULTS:1 = わ・た・し・が
							BTL_KOJO_RESULTS:2 = 全部ぜんぶぶち壊してあげる！
					ENDSELECT
				ENDIF
			;未陥落
			ELSE
				IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
					SELECTCASE RAND:3
						CASE 0
							BTL_KOJO_RESULTS:0 = ドキドキする
							BTL_KOJO_RESULTS:1 = 好きにしちゃっていいよね？
						CASE 1
							BTL_KOJO_RESULTS:0 = 好きに壊していいのね？　ね？
						CASE 2
							BTL_KOJO_RESULTS:0 = 焼き殺そうかな、引きずり出そうかな？
							BTL_KOJO_RESULTS:1 = ねえ、%CSTR:이인칭%はどっちがいいと思う？
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 0
							BTL_KOJO_RESULTS:0 = よ～し、捕まえちゃうぞ
						CASE 1
							BTL_KOJO_RESULTS:0 = 壊れろっ！
						CASE 2
							BTL_KOJO_RESULTS:0 = 邪魔ねぇ、死になさいよ、あなた
					ENDSELECT
				ENDIF
			ENDIF
		;主人以外がCOOP発動
		ELSE
			IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = うふふ、ふふふ、ふふふ！
					CASE 1
						BTL_KOJO_RESULTS:0 = ああ、暴力って楽しい！
					CASE 2
						BTL_KOJO_RESULTS:0 = 突撃ー！
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = ずたずたにしてあげる
					CASE 1
						BTL_KOJO_RESULTS:0 = 壊れろ！　壊れろ！　目障りよ！
					CASE 2
						BTL_KOJO_RESULTS:0 = 串刺しにして晒してあげる！
				ENDSELECT
			ENDIF
		ENDIF
	;被召喚時
	CASE "被召喚"
		BTL_KOJO_RESULTS:0 = 
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE "与ダメージ_単体"
		;味方に攻撃した
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = あーららー？
						BTL_KOJO_RESULTS:1 = もっと殴りたかったのにー
					CASE 1
						BTL_KOJO_RESULTS:0 = きゃははっ！　さっさと逃げちゃえばよかったのにね
					CASE 2
						BTL_KOJO_RESULTS:0 = どう？　どうかしら？
						BTL_KOJO_RESULTS:1 = ねえ、%CSTR:이인칭%、見ていてくれたよね？
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = なあんだ、もう死んじゃった
					CASE 1
						BTL_KOJO_RESULTS:0 = こいつ、あとで食べちゃっていい？
					CASE 2
						BTL_KOJO_RESULTS:0 = つまんないやつねぇ
				ENDSELECT
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 壊れろッ！
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = すごいすごい！　まだ遊べるわ！
					CASE 1
						BTL_KOJO_RESULTS:0 = 最初から決まってるの。あなたはここで死ぬって！
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = 柔らかいわねぇ
						BTL_KOJO_RESULTS:1 = 食べごたえはどうかしら
					CASE 1
						BTL_KOJO_RESULTS:0 = びっくりしたぁ、まだ生きてるんだ？
				ENDSELECT
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = あははは！　殴ってる感じがする！
					CASE 1
						BTL_KOJO_RESULTS:0 = 強いんだ。ドキドキしてきた
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = いい噛み応えじゃない？
					CASE 1
						BTL_KOJO_RESULTS:0 = いいよーいいよー
						BTL_KOJO_RESULTS:1 = 簡単に死ぬのもつまんないもの
				ENDSELECT
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = 無駄に頑丈ー、こいつ嫌いー
					CASE 1
						BTL_KOJO_RESULTS:0 = ぱぱっと手早く死んでくれないの？
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = 固いとか、生意気！
					CASE 1
						BTL_KOJO_RESULTS:0 = ねえ、はやく死んでよ
				ENDSELECT
			ENDIF
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = あなた、邪魔、目障り！
					CASE 1
						BTL_KOJO_RESULTS:0 = なんで壊れないのッ！
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = 効かない…ふざけないでッ
					CASE 1
						BTL_KOJO_RESULTS:0 = %CSTR:이인칭%、これじゃダメみたい
				ENDSELECT
			ENDIF
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE "被ダメージ_単体"
		;味方に攻撃された
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = どうして…%CSTR:이인칭%…
					CASE 1
						BTL_KOJO_RESULTS:0 = ねえ、赤が似合うって…
						BTL_KOJO_RESULTS:1 = 言ってよ…
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = カラダが…冷たく、なって…
					CASE 1
						BTL_KOJO_RESULTS:0 = やっと、出られたのに…
				ENDSELECT
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50
			IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = 痛い！　痛い痛い痛い痛い痛いいいいッ！
					CASE 1
						BTL_KOJO_RESULTS:0 = 嘘よ、%CSTR:일인칭%が死ぬわけ…ッ
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = ケェェェェェェ──ッ！？
					CASE 1
						BTL_KOJO_RESULTS:0 = 嫌ァ────ッ！？
				ENDSELECT
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = む・だ・よ。馬鹿じゃないの？
					CASE 1
						BTL_KOJO_RESULTS:0 = 残念でした。そんなの効かない
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = 無駄なことを…
					CASE 1
						BTL_KOJO_RESULTS:0 = いま、何かしたの？
				ENDSELECT
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = む・だ・よ。馬鹿じゃないの？
					CASE 1
						BTL_KOJO_RESULTS:0 = なあに？　貢いでくれるの？
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = 無駄なことを…
					CASE 1
						BTL_KOJO_RESULTS:0 = どうかしたの、王子様？
				ENDSELECT
			ENDIF
		;瀕死
		ELSEIF 現HP割合(ARG) < 25
			IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = 助けて…助けてよ…%CSTR:이인칭%…
					CASE 1
						BTL_KOJO_RESULTS:0 = %CSTR:일인칭%を傷つけるなんて…
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = ぜえ…ぜえ…
					CASE 1
						BTL_KOJO_RESULTS:0 = ケッ……クァッ……
				ENDSELECT
			ENDIF
		;ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = 血が…血が出てるでしょうッ！
						BTL_KOJO_RESULTS:1 = どういうつもりよッ！
					CASE 1
						BTL_KOJO_RESULTS:0 = あーっ、鬱陶しい！
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = ころして…殺してやる！ お前えっ！
					CASE 1
						BTL_KOJO_RESULTS:0 = あーっ、鬱陶しい！
				ENDSELECT
			ENDIF
		;小ダメージ
		ELSE
			IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = ちょこまかちょこまか…
						BTL_KOJO_RESULTS:0 = 鬱陶しいのよ！
					CASE 1
						BTL_KOJO_RESULTS:0 = ちょっと、痛いじゃないの！
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						BTL_KOJO_RESULTS:0 = 生意気ィ
					CASE 1
						BTL_KOJO_RESULTS:0 = どうせ死ぬんだから、抵抗しても無駄なのに
				ENDSELECT
			ENDIF
		ENDIF
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE "与ダメージ_範囲_ランダム"
		;全弾命中した
		IF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = あはははははは！楽しくなってきちゃった！
		;普通
		ELSEIF ARG:2 < ARG:1
			BTL_KOJO_RESULTS:0 = もううんざり、そのまま死んでくれる？
		;全弾回避された
		ELSEIF ARG:2 == ARG:1
			BTL_KOJO_RESULTS:0 = なんでなのよーッ！！
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE "与ダメージ_範囲_ランダム_撃破あり"
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			BTL_KOJO_RESULTS:0 = あ、決まっちゃった？
		ELSE
			BTL_KOJO_RESULTS:0 = あー、面倒くさい…そのまま死ねばよかったのに
		ENDIF
	;反射された
	CASE "反射された"
		BTL_KOJO_RESULTS:0 = 嫌ァッ！　なんでよおッ！
	;反射した
	CASE "反射した"
		BTL_KOJO_RESULTS:0 = 馬鹿じゃないの？　そのまま死・ん・じゃ・え
	;回避された
	CASE "回避された"
		BTL_KOJO_RESULTS:0 = もううんざり、まっぴらなのよ！
	;回避した
	CASE "回避した"
		IF K[[キャラ:유키코의그림자]]_雪子影ロール判定()
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = 王子様ぁー、早く迎えにきてくださーい
				CASE 1
					BTL_KOJO_RESULTS:0 = アハハハハハハ！
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = 届くわけないでしょ？
				CASE 1
					BTL_KOJO_RESULTS:0 = 無駄なことしちゃって、イライラするのよ
			ENDSELECT
		ENDIF
	;敵味方全体攻撃(詳細処理無し)
	;CASE "敵味方全体攻撃"
	;	BTL_KOJO_RESULTS:0 = 
	;反撃を発動した
	CASE "反撃発動"
		SELECTCASE TFLAG:발동연동스킬
			;例えば「ダッジカウンターが発動した場合」を指定したい場合は、スキル番号2484を指定する
			CASE [[스킬:닷지카운터]]
				BTL_KOJO_RESULTS:0 = アハハハハハハ！　ぶっさいく！
			;その他
			CASEELSE
				BTL_KOJO_RESULTS:0 = ザケんじゃないわよ！
		ENDSELECT
	;トリガースキルを発動した
	CASE "追撃発動"
		SELECTCASE TFLAG:발동연동스킬
			;スキルを指定したい場合、反撃と同様、対象スキルの番号をCASEに記載する
			;CASE 
			;	BTL_KOJO_RESULTS:0 = 
			;その他
			CASEELSE
				BTL_KOJO_RESULTS:0 = 
