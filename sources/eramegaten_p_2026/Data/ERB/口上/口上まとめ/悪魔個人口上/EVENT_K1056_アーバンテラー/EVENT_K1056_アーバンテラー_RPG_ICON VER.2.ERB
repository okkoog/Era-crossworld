;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:어반테러]], ARG, ARG:1, ARG:2
;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 1056
	RETURN 0
VARSET BTL_KOJO_RESULTS
;VARSET KSTR

;KSTR:0 = 
;KSTR:1 = 
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 一番乗りィ！
		ELSE
			BTL_KOJO_RESULTS:0 = 嗚呼！この瞬間こそ≪Ho goduto a pieno della vita!!≫
		ENDIF
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = 殺ンだろ？オレもまぜろや！
		;それ以外
		ELSE
			BTL_KOJO_RESULTS:0 = "Today is the day we Citizens start taking down names and kicking ass!"
		ENDIF
	;被召喚時
	CASE 3
			BTL_KOJO_RESULTS:0 = 中々楽しめそうだナ？
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;味方に攻撃した
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 地獄で待ってなァ！
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = オォ？やるじゃねえの
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = イイのが入っちまったなァ゛！？
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = 食らいなァ゛！
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			BTL_KOJO_RESULTS:0 = 硬ッてえ！？
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = *ｯﾁｨ!*効いてねえナ…
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;味方に攻撃された
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = クソッ…たれがァ…！
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = "Segitsetek! Segitsetek! Segitsetek!"
		;無効
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 今ナンかしたか？
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = そいつは俺ンだァ゛！
		;瀕死
		ELSEIF 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = *ｯﾁｨ!*%CSTR:ARG:이인칭%ッ！悪ィがもう保たねえ！！
		;ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			BTL_KOJO_RESULTS:0 = 痛ッてェ！
		;小ダメージ
		ELSE
			BTL_KOJO_RESULTS:0 = *ｯﾁ!*
		ENDIF
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE 13
		;全弾命中した
		IF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = BINGO！
		;普通
		ELSEIF ARG:2 < ARG:1
			BTL_KOJO_RESULTS:0 = まあまあだナ？
		;全弾回避された
		ELSEIF ARG:2 == ARG:1
			BTL_KOJO_RESULTS:0 = オイオイ…
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE 14
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			BTL_KOJO_RESULTS:0 = 上出来だろ？%CSTR:ARG:이인칭%！
		ELSE
			BTL_KOJO_RESULTS:0 = 幾らか減ったナ？
		ENDIF
	;反射された
	CASE 15
			BTL_KOJO_RESULTS:0 = ウオォ゛！？
	;反射した
	CASE 16
			BTL_KOJO_RESULTS:0 = ンなもん要らねェよ！
	;回避された
	CASE 17
			BTL_KOJO_RESULTS:0 = *ｯﾁ!*スカった…！
	;回避した
	CASE 18
			BTL_KOJO_RESULTS:0 = 惜しかったナ？
	;敵味方全体攻撃(詳細処理無し)
	;CASE 19
	;		BTL_KOJO_RESULTS:0 = ミ・ナ・ゴ・ロ・シ・！
	;反撃を発動した
	CASE 20
		SELECTCASE TFLAG:발동연동스킬
		;닷지카운터
		CASE 2484
			BTL_KOJO_RESULTS:0 = 見えてんだよォ゛！
		;その他
		CASEELSE
			BTL_KOJO_RESULTS:0 = お返しだァ！
		ENDSELECT
	;トリガースキルを発動した
	CASE 21
		SELECTCASE TFLAG:발동연동스킬
		;○○
		;CASE 
		;	BTL_KOJO_RESULTS:0 = 
		;その他
		CASEELSE
			BTL_KOJO_RESULTS:0 = 
