	CASE 22
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				IF RAND:2
					BTL_KOJO_RESULTS:0 = まるで笑気ガスと麻薬をチャンポンしたみたいな穏やかな気分だ…
				ELSE
					BTL_KOJO_RESULTS:0 = "Can we all get along?"
				ENDIF
			CASE "SHOCK","FREEZE","BIND","PALYZE"
