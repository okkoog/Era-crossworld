			BTL_KOJO_RESULTS:0 = 効かねンだよクソがァ…ッ！
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = こっからだッ！
		ENDIF
	;回復してもらった
	CASE 24
		;ARG:2　回復量
		LOCAL = ARG:2 * 100 / BASE:ARG:ＨＰ
		;LOCAL　回復量割合
		IF 0
		;キャラ分岐
