			;CASE "STONE"
			CASE "FLAME"
				BTL_KOJO_RESULTS:0 = ア熱ああああ！！
			CASE "SLIP"
				BTL_KOJO_RESULTS:0 =ウオァ゛！？
			;CASE "BRAND"
			;その他の状態異常
			;CASEELSE
		ENDSELECT
	;食いしばり等で耐えた
