		;50%以上 & HPほぼ満タン
		ELSEIF LOCAL > 50 && 現HP割合(ARG) > 90
		;50%以上
		ELSEIF LOCAL > 50
		;その他
		ELSE
		ENDIF
	;状態異常を直してもらった
	CASE 25
		;ARG:2　直ったバステ
		IF 0
		;キャラ分岐
		;ELSEIF NO:(ARG:1) == XXXX
		ELSE
			SELECTCASE GET_STATE(ARG:2)
				CASE "SLEEP"
					BTL_KOJO_RESULTS:0 = ンガッ…！？
				;その他の状態異常
				CASEELSE
					BTL_KOJO_RESULTS:0 = ありがとなァ！
			ENDSELECT
		ENDIF
	;戦闘中イって行動不能にならず耐えた(ムフフ展開時のみ)
	CASE 47
		;歯を食いしばって快楽に耐えた
