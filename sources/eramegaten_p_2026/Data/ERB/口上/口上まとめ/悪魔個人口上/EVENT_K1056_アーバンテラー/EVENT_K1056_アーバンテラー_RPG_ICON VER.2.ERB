			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 = グゥ…
			;CASE "CLOSE"
			CASE "POISON"
				BTL_KOJO_RESULTS:0 = *ｹﾞﾎｯ!*気分が悪ィ…
			;CASE "BOMB"
			CASE "CHARM"
				BTL_KOJO_RESULTS:0 = 悔しいのに…権力に迎合しちまう…%UNICODE(0x2661)%
			;CASE "CURSE"
