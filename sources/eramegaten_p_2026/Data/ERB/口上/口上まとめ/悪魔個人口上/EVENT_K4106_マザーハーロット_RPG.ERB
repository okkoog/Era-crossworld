@KOJO_BATTLE_MESSAGE_K[[キャラ:마더해롯]], ARG,ARG:1 = 0
LOCAL:1 = 1
LOCAL = CFLAG:ARG:입력행동
BTL_KOJO_RESULTS = では行くぞ

;崩壊してる場合は口上表示しない
SIF TALENT:ARG:9
	RETURN 0


CALL GET_SKILL_PROP, "SKILL_EFECT", LOCAL, ARG
IF RESULT == 1 && RAND:3 == 0
	CALL GET_SKILL_PROP, "SKILL_TYPE", CFLAG:ARG:입력행동, ARG,ARG
	SELECTCASE RESULT
		;검격
		CASE 0
			IF RAND:2
				BTL_KOJO_RESULTS = 裂けよ
			ELSE
				BTL_KOJO_RESULTS = 綺麗な花にしてやろうぞ、飾り切りでな
			ENDIF
		;비구
		CASE 1
			IF RAND:2
				BTL_KOJO_RESULTS = ほれほれ、避けぬと穴だらけじゃぞ
			ELSE
				BTL_KOJO_RESULTS = 『塵モ残サヌ…』
			ENDIF
		;타격
		CASE 2
			IF RAND:2
				BTL_KOJO_RESULTS = 少しは耐えておくれ…血溜まりは後が面倒だからのう
			ELSE
				BTL_KOJO_RESULTS = 『挽キ肉…イヤ、搾リ汁二シテヤル』
			ENDIF
		;전술
		CASE 3
			IF RAND:2
				BTL_KOJO_RESULTS = さぁ遊舞に付き合っておくれ…バラバラにならぬように耐えてみせよ…
			ELSE
				BTL_KOJO_RESULTS = 『力押シノミガ魔人ノ本領デハ無イ』
			ENDIF
		;화염
		CASE 4
			IF RAND:2
				BTL_KOJO_RESULTS = こんがりと焼いてやろう…
			ELSE
				BTL_KOJO_RESULTS = では、燃え尽きよ
			ENDIF
		;빙결
		CASE 5
			IF RAND:2
				BTL_KOJO_RESULTS = 氷の彫像というのも乙なものじゃのう…
			ELSE
				BTL_KOJO_RESULTS = 凍りつかせてくれよう…意外と心地よいかもしれぬぞ
			ENDIF
		;전격
		CASE 6
			IF RAND:2
				BTL_KOJO_RESULTS = 痛みによって痺れる心地を味わうがいい…
			ELSE
				BTL_KOJO_RESULTS = 痺れ果ててそこでだらしのない姿を晒すがいい
			ENDIF
		;충격
		CASE 7
			IF RAND:2
				BTL_KOJO_RESULTS = ホッホッホ…破裂する気分はどうじゃ
			ELSE
				BTL_KOJO_RESULTS = さぁ逃げ惑え
			ENDIF
		;신경
		CASE 8	
			IF RAND:2
				BTL_KOJO_RESULTS = さて、どのように嬲ってくれようか…
			ELSE
				BTL_KOJO_RESULTS = 嫌だ嫌だと言っても神経には効くからのう
			ENDIF
		;정신
		CASE 9
			IF RAND:2
				BTL_KOJO_RESULTS = ふん…なんと脆いこころじゃ…
			ELSE
				BTL_KOJO_RESULTS = 矮小じゃのう…砕けてしまえ
			ENDIF
		;파마
		CASE 10
			IF RAND:2
				BTL_KOJO_RESULTS = 大淫婦の浄化で天に登るか、好き者め
			ELSE
				BTL_KOJO_RESULTS = 文字通り昇天させてやろうぞ
			ENDIF
		;주살
		CASE 11
			BTL_KOJO_RESULTS = 奈落へ落ちよ、呪いは魂につけてやる
		;지변
		CASE 12
			IF RAND:2
				BTL_KOJO_RESULTS = 土砂の味はどうじゃ
			ELSE
				BTL_KOJO_RESULTS = 土塊に身を裂かれる気分はどうじゃ…
			ENDIF
		;수격
		CASE 13
			IF RAND:2
				BTL_KOJO_RESULTS = 冷水を浴びせてやろう…目を開けられぬ程ののう
			ELSE
				BTL_KOJO_RESULTS = こういう使い方もあるのでのう…
			ENDIF
		;질풍
		CASE 14
				BTL_KOJO_RESULTS = 木っ端のごとく四裂するがいい…
		;중력
		CASE 15
			IF RAND:2
				BTL_KOJO_RESULTS = さぁ圧縮してやろう…肉の一片までもな
			ELSE
				BTL_KOJO_RESULTS = 叩き堕ちよ、重力の鎖は万有だからのう
			ENDIF
		;핵열
		CASE 16
			IF RAND:2
				BTL_KOJO_RESULTS = 溶かしてやろう、其の身までな
			ELSE
				BTL_KOJO_RESULTS = 蒸発して泡も残さぬようにしてやろう…
			ENDIF
		;만능
		CASE 17
			BTL_KOJO_RESULTS = ホッホッホ…喰らうがいい…！
		;사이코
		;CASE 18
		CASEELSE
			BTL_KOJO_RESULTS = 狂乱の音の色はいつ聞いても甘美じゃのう
	ENDSELECT
;회복
ELSEIF RESULT == 2
	IF CFLAG:ARG:타겟 > 6
		IF RAND:2
			BTL_KOJO_RESULTS = 大淫婦の癒やしじゃ、願い下げかのう？
		ELSE
			BTL_KOJO_RESULTS = ほぅら少しか楽にはなったじゃろう？
		ENDIF
	ELSE
		IF FLAG:(CFLAG:ARG:타겟) == 0 && 陥落(ARG)
			IF RAND:2
				BTL_KOJO_RESULTS = 魔人を落としておいて先に逝くなど許さぬぞ。
			ELSE
				BTL_KOJO_RESULTS = 全く…肝が冷える…これが終わったら温めておくれ
			ENDIF
		ELSE
			IF RAND:2
				BTL_KOJO_RESULTS = さっさと立たぬか
			ELSE
				BTL_KOJO_RESULTS = ほれ仕切りなおしじゃ。立て直せ
			ENDIF
		ENDIF
	ENDIF
;状態変化
;ELSEIF RESULT == 3
;特殊
;ELSEIF RESULT == 4
;状態回復
ELSEIF RESULT == 5
	BTL_KOJO_RESULTS = ほれ、しゃんと立て。
ENDIF


;천년의저주
IF LOCAL == 1414
	SELECTCASE RAND:3
	CASE 0
		BTL_KOJO_RESULTS = 魔人の身に満ちた死の呪詛を少しは喰ろうてみるかえ？
	CASE 1
		BTL_KOJO_RESULTS = ホッホッホ…呪怨によって朽ち果てよ
	CASEELSE
		BTL_KOJO_RESULTS = 呪詛とともに消え堕ちよ塵芥
	ENDSELECT
;마계의조사
ELSEIF LOCAL == 1132
	SELECTCASE RAND:3
	CASE 0
		BTL_KOJO_RESULTS = そら、聞き惚れるがいい
	CASE 1
		BTL_KOJO_RESULTS = 魔界の音の調べに容赦の二文字は存在せぬぞ
	CASEELSE
		BTL_KOJO_RESULTS = さぁ、音に酔いしれよ
	ENDSELECT
;방전
ELSEIF LOCAL == 910
	SELECTCASE RAND:3
	CASE 0
		BTL_KOJO_RESULTS = 痺れて果てよ…
	CASE 1
		BTL_KOJO_RESULTS = 脳髄まで痺れて酔いしれよ…
	CASEELSE
		BTL_KOJO_RESULTS = さぁ、電撃にて逝ってしまえ…！
	ENDSELECT
;바빌론의잔
ELSEIF LOCAL == 2068
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		SELECTCASE RAND:3
		CASE 0
			BTL_KOJO_RESULTS = ふふ…純然成る愛のために、削がれた汚れを受けるがいい！
		CASE 1
			BTL_KOJO_RESULTS = わらわの大元の汚れじゃ。飲み下せると思うでないぞ…！
		CASEELSE
			BTL_KOJO_RESULTS = 古き汚れがなんじらにはお似合いじゃ。
		ENDSELECT
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		SELECTCASE RAND:3
		CASE 0
			BTL_KOJO_RESULTS = アハ、アハハハハ、溶け落ちよ我が汚れによって！
		CASE 1
			BTL_KOJO_RESULTS = さぁ、汚れの中で淫蕩の限りを尽くそうぞ
		CASEELSE
			BTL_KOJO_RESULTS = アハハハ、世の理に満ちよ汚れと快楽よ！
		ENDSELECT
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		SELECTCASE RAND:3
		CASE 0
			BTL_KOJO_RESULTS = わらわの中身を曝け出せ、杯よ
		CASE 1
			BTL_KOJO_RESULTS = 主の命だ、溶け落ちよ
		CASEELSE
			BTL_KOJO_RESULTS = 塵芥が、飲まれるがいい
		ENDSELECT
	;それ以外
	ELSE
		BTL_KOJO_RESULTS = ホッホッホ喰らうがいい、我が汚れを！
	ENDIF
;デクンダ
ELSEIF LOCAL == 505
	BTL_KOJO_RESULTS = 口直しをせねばな。
;スクンダ
ELSEIF LOCAL == 507
	BTL_KOJO_RESULTS = その速度、目障りじゃ
;デカジャ
ELSEIF LOCAL == 509
	BTL_KOJO_RESULTS = 仕切りなおしじゃ…フェアに行かねばな
;기합
ELSEIF LOCAL == 511
	BTL_KOJO_RESULTS = さぁて…いくかのう…！
;컨센트레이트
ELSEIF LOCAL == 512
	BTL_KOJO_RESULTS = さぁ集中じゃ…
;雄たけび
ELSEIF LOCAL == 514
	BTL_KOJO_RESULTS = 『グルゥゥォォォォォオオオオオオオオ！！！！』
;도발
ELSEIF LOCAL == 515
	BTL_KOJO_RESULTS = つまらぬ…つまらん…児戯にもならぬぞ愚図が

ENDIF

;SIF BTL_KOJO_RESULTS != "EMPTY"
;	CALL MESSAGE_B(LOCAL:1, BTL_KOJO_RESULTS, BTL_KOJO_RESULTS:1, BTL_KOJO_RESULTS:2, BTL_KOJO_RESULTS:3, BTL_KOJO_RESULTS:4)

@KOJO_BATTLE_EVENT_K[[キャラ:마더해롯]], ARG, ARG:1, ARG:2
SIF ARG < 0 && NO:ARG != 4518
	RETURN 0
LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS = EMPTY
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:3 == 0
			BTL_KOJO_RESULTS = さて、一気に片付けるかのう
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS = 機はここじゃ、此処で行く
		ELSE
			BTL_KOJO_RESULTS = 隙を見せたな…！
		ENDIF
	CASE 2
		IF RAND:3 == 0
			BTL_KOJO_RESULTS = 重ねあわせよう、逃れると思うな
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS = ここじゃな…！
		ELSE
			BTL_KOJO_RESULTS = さぁ、行くぞ…！
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS = さらばじゃ、邪魔者
			ELSE
				IF RAND:2
					BTL_KOJO_RESULTS = さぁ、これが死という極上の快楽じゃ
				ELSE
					BTL_KOJO_RESULTS = 大淫婦の腕に抱かれて昇天するがいい
				ENDIF
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS = 硬いのう…
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			IF RAND:2
				BTL_KOJO_RESULTS = さぁあとどれだけ耐えられるかのう…
			ELSE
				BTL_KOJO_RESULTS = さぁ、もう逝ってしまえ、逝って楽になるがいい
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 20
			IF RAND:2
				BTL_KOJO_RESULTS = ほら、ほらまだまだ続けるぞ
			ELSE
				BTL_KOJO_RESULTS = まだまだ狂宴は始まったばかりじゃ
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF RAND:2
				BTL_KOJO_RESULTS = さぁまだまだ終わらぬぞ
			ELSE
				BTL_KOJO_RESULTS = 心地よくしてやろう…そんなに硬くなるな
			ENDIF
		;無効化された
		ELSEIF ARG:2 == 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS = …利かぬか
			ELSE
				BTL_KOJO_RESULTS = 魔人の一撃を意にも介さんか…
			ENDIF
		;吸収された
		ELSEIF ARG:2 < 0
			IF RAND:2
				BTL_KOJO_RESULTS = ほう…吸収するか
			ELSE
				BTL_KOJO_RESULTS = むぅ…吸い取るか…
			ENDIF
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS = 許せ…
			ELSE
				IF RAND:2
					BTL_KOJO_RESULTS = な…に…？
				ELSE
					BTL_KOJO_RESULTS = ホッホッホ…よく、やる…のう…
				ENDIF
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF 陥落(ARG) && RAND:2
				BTL_KOJO_RESULTS = この程度で魔人を殺しきれると思い上がるでないぞ…！
			ELSE
				IF RAND:2
					BTL_KOJO_RESULTS = …思ったよりもやるのう
				ELSE
					BTL_KOJO_RESULTS = 存外やるのう…さぁ、もっと楽しませておくれ…！
				ENDIF
			ENDIF
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			IF RAND:2
				BTL_KOJO_RESULTS = 仔細なし。余裕じゃ
			ELSE
				BTL_KOJO_RESULTS = …大したものでもないのう
			ENDIF
		ELSEIF ダメージ割合(ARG, ARG:2) > 0
			IF RAND:2
				BTL_KOJO_RESULTS = 蚊ほども利かぬな。舐めているのかえ？
			ELSE
				BTL_KOJO_RESULTS = …この程度かえ？
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			IF RAND:2
				BTL_KOJO_RESULTS = 今何かしたかの…？
			ELSE
				BTL_KOJO_RESULTS = 魔人を舐めるなよ、つまらぬ事で時間を使わせるな
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			IF RAND:2
				BTL_KOJO_RESULTS = ホッホッホ…心地よいぞ
			ELSE
				BTL_KOJO_RESULTS = これはとんだ贈り物だ…ありがたく頂くことにしよう
			ENDIF
		ENDIF
	CASE 15
		;被反射
		PRINTFORMW ARG:2 = {ARG:2}
		IF RAND:2
			BTL_KOJO_RESULTS = …弾くか
		ELSE
			BTL_KOJO_RESULTS = ふむ、これを弾くか
		ENDIF
	CASE 16
		;反射
		IF RAND:2
			BTL_KOJO_RESULTS = ほれ、返してやろう
		ELSE
			BTL_KOJO_RESULTS = 相手を見定めて放つことだ。さもなければ…ほら、こうなる。
		ENDIF
	CASE 17
		;敵回避
		IF RAND:2
			BTL_KOJO_RESULTS = 避けたか…
		ELSE
			BTL_KOJO_RESULTS = 避けたな…つれないのう
		ENDIF
	CASE 18
		;自分回避
		IF RAND:2
			BTL_KOJO_RESULTS = なんじゃ今のは
		ELSE
			BTL_KOJO_RESULTS = 今何かしたかのう？
		ENDIF
	;食いしばり等で耐えた
	CASE 23
		;이악물기
		IF BASE:ARG:ＨＰ == 1
			BTL_KOJO_RESULTS = 魔人を舐めるなよ…
		;その他
		ELSE
			BTL_KOJO_RESULTS = この程度で…朽ちてたまるものか…！
		ENDIF
ENDSELECT
;SIF BTL_KOJO_RESULTS != "EMPTY"
;	CALL MESSAGE_B(LOCAL:1, BTL_KOJO_RESULTS, BTL_KOJO_RESULTS:1, BTL_KOJO_RESULTS:2, BTL_KOJO_RESULTS:3, BTL_KOJO_RESULTS:4)
