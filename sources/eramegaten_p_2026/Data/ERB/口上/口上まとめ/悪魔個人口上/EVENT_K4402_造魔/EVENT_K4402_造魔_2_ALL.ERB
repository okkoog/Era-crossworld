;-------------------------------------------------
;6.7.8.オパーイモミング
;オパーイ揉むか乳首ぐにぐにするかは、宗派によってはやっぱ違うものなんでしょうけど、自分はそこまで属性ねえので。
;基本手抜きなんで誰か。誰かお願い。
;ぽんこつちゃんはおっぱいでかいイメージ。
;-------------------------------------------------
@K_4402_2_OPAI_MOMINGU
		;初めて
		IF CFLAG:306 == 0
			PRINTFORMW 「찌찌, 만질, 건가요?」
			PRINTFORMW 「왜, 에요? 잘 모르겠, 어요」
			CFLAG:306 = 1
		;二回目以降
		ELSE
			;陥落済み
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8) && (CFLAG:308 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:3 || TALENT:6
					PRINTFORMW 「%CSTR:12%, %CSTR:12%는, %CSTR:11%의, 찌찌, 조아, 하나요?」
					PRINTFORMW 「그렇다면, 엄청, 기뻐, 요」
				;淫乱、娼婦
				ELSEIF TALENT:4 || TALENT:7
					PRINTFORMW 「찌찌, 조물조물, 어때, 요?」
					PRINTFORMW 「%CSTR:11%은, 찌찌, 만져지는 거, 조아, 해요」
					PRINTFORMW 「%CSTR:12%도, 그렇다면, 기쁠 거, 에요?」
				;服従、隷属
				ELSEIF TALENT:5 || TALENT:8
					PRINTFORMW 「찌, 찌찌, 꼬집을, 건가, 요?」
					PRINTFORMW 「집기 쉬운, 곳, 있긴 한데, 요」
					PRINTFORMW %CALLNAME%은(는) 유두를 손으로 가리고 경계하고 있다
				ENDIF
				CFLAG:306 = 4
			;未陥落
			ELSE
				;屈服刻印Lv3
				IF MARK:2 == 3 && (CFLAG:308 < 3 || FLAG:7 == 2)
					PRINTFORMW 「찌찌, 조물조물할, 건가요?」
					PRINTFORMW 「왠지, %CSTR:11%도, 몽실몽실해, 져요?」
					CFLAG:306 = 3
				;それ以外
				ELSEIF CFLAG:306 < 2 || FLAG:7 == 2
					PRINTFORMW 「찌찌, 말랑말랑, 할 건가, 요?」
					CFLAG:306 = 2
				ENDIF
			ENDIF
		ENDIF



