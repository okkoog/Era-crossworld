;-------------------------------------------------
;〇メモ
;-------------------------------------------------
;戦闘口上
;更新などについては00_COREを見るべし
;-------------------------------------------------

;-------------------------------------------------
;○ナビ口上
;-------------------------------------------------
;喋ることに迷って「……」を使う、という設定であるので、喋るべきことがあるナビでは基本的にきびきび喋る
;-------------------------------------------------


;=========================================
;ナビ口上の存在確認
;この関数が設定されていないと口上が存在しない扱いになる
;=========================================
@IS_EXIST_KOJO_BATTLE_NAVI_K[[キャラ:조마]]_1, ARG
	;特別なコメントがあればここに記載
	;なければ「専用口上あり」と表示される
;	RESULTS = 造魔ちゃん（１）のナビ口上です
	;１を返すと口上が存在してる扱いになるので通常は１で
	RETURN 1

;=========================================
;以下ナビ口上
;
;TSTR:네비_시추에이션_메인		主に呼び出しタイミングを定義(戦闘開始/メイン画面/戦闘終了)
;TSTR:네비_시추에이션_서버1		状況を定義
;TSTR:네비_시추에이션_서버2		状況の補足オプション
;=========================================
@KOJO_BATTLE_NAVI_K[[キャラ:조마]]_1, ARG
;右のような指定も可能→SETCOLOR 0xA0A0A0
;色見本に#ABCDEFというような書き方がされていた場合は、こちらの書き方(SETCOLOR 0xABCDEF)を使うと良い
;水色
;SETCOLOR 0x33ffcc
;LOCALS = {ARG:1}

;独自定義
#DIM 現在敵数
#DIM 方位
#DIM 距離
#DIM TEMPCOUNT


		;〇ナビ口上分岐
		;　├戦闘開始
		;　｜　├通常
		;　｜　｜　├格下	（レベルが10以上低い）
		;　｜　｜　├同格
		;　｜　｜　└格上	（レベルが10以上高い）
		;　｜　├先制攻撃
		;　｜　｜　└格下・同格・格上
		;　｜　├バックアタック
		;　｜　｜　└格下・同格・格上
		;　｜　├不意打ち
		;　｜　｜　└格下・同格・格上
		;　｜　├バックアタック阻止
		;　｜　｜　└格下・同格・格上
		;　｜　└不意打ち阻止
		;　｜　　　└格下・同格・格上
		;　├メイン画面
		;　｜　├重度の危機　※複数が当てはまる場合、その中からランダム
		;　｜　｜　├半壊			（初期配置の味方の生存者が50％未満）
		;　｜　｜　├死亡者多数		（死亡者２以上）
		;　｜　｜　├異常半壊		（バステが66％以上）
		;　｜　｜　├機能不全		（バステ数＋死亡数が、初期配置味方数の50％以上）
		;　｜　｜　├PTHP危機		（味方全体合計のHP残存率が50％未満）
		;　｜　｜　├マスター瀕死	（＠のHPが25％未満かつ死んでいない）
		;　｜　｜　└マスター死亡	（＠が死亡）
		;　｜　├中度の危機
		;　｜　｜　├핀치캐릭터	（死亡者がいるなど）
		;　｜　｜　├戦力低下		（ポジションに空きが出ている）
		;　｜　｜　├異常者複数		（バステ者が２以上）
		;　｜　｜　└PTHP減少		（味方全体合計のHP残存率が75％未満）
		;　｜　├平常
		;　｜　｜　├殲滅率90		（敵HPによって変動）
		;　｜　｜　├殲滅率75
		;　｜　｜　├殲滅率50
		;　｜　｜　├殲滅率25
		;　｜　｜　├殲滅率1
		;　｜　｜　├殲滅率0
		;　｜　｜　├PTHP微減		（PTHPが90％未満）
		;　｜　｜　├一部撃破済み	（敵の初期配置数
		;　｜　｜　├敵健在			（その他の場合）
		;　｜　｜　├格下			（レベルが10以上低い）
		;　｜　｜　├同格
		;　｜　｜　└格上			（レベルが10以上高い）
		;　｜　└交渉終了時
		;　｜　　　├トーク_ものもらい
		;　｜　　　├トーク_おこらせる
		;　｜　　　├トーク_会話終了
		;　｜　　　├トーク_立ち去る
		;　｜　　　└トーク_逃げられる
		;　└戦闘終了
		;　　　├勝利
		;　　　｜　├계약			（トーク：契約）
		;　　　｜　├契約失敗		（トーク：契約……したけど容量が足りないとかのヤツ）
		;　　　｜　└勝利
		;　　　｜　　　├1ターンキル		（経過ターン数０）
		;　　　｜　　　├早期決着		（経過ターン数3未満）
		;　　　｜　　　├長期戦			（経過ターン数7以上）
		;　　　｜　　　├格下			（レベルが10以上低い）
		;　　　｜　　　├同格
		;　　　｜　　　├格上			（レベルが10以上高い）
		;　　　｜　　　├壊滅的			（味方全体合計のHP残存率が25％未満）
		;　　　｜　　　├被害甚大		（味方全体合計のHP残存率が50％未満）
		;　　　｜　　　├被害大			（味方全体合計のHP残存率が75％未満）
		;　　　｜　　　├被害軽微		（味方全体合計のHP残存率が90％未満）
		;　　　｜　　　└被害皆無
		;　　　├敗北
		;　　　└도주

		;〇使いそうなフラグ
		;TFLAG:아군초기배치수
		;TFLAG:아군배치수
		;TFLAG:아군HP잔존율
		;TFLAG:아군사망자수
		;TFLAG:아군BS수
		;TFLAG:적아군레벨차
		;TFLAG:적초기배치수
		;TFLAG:적배치수
		;TFLAG:적HP잔존율
		;FLAG:경과턴수
		;FLAG:도주불가플래그


	IF 0
	ELSEIF TSTR:네비_시추에이션_메인 == "戦闘開始"
		;方角確認
		;全方位がありえる
		方位 = RAND:11 + 1
		;距離
		距離 = RAND:20 + 5

		IF 0
		ELSEIF TSTR:네비_시추에이션_서버1 == "先制攻撃"
			IF 0
			ELSEIF RAND:3 == 0
				TEMPCOUNT = RAND:20 + 15
				BTL_KOJO_RESULTS:0 = 기습 양호. 자세를 재정비할 때까지 {TEMPCOUNT}초로 예측……
			ELSEIF RAND:2 == 0
				IF TFLAG:적초기배치수 > 2
					BTL_KOJO_RESULTS:0 = 선제공격을. 적의 수를 줄이는 것을 권장.
				ELSE
					BTL_KOJO_RESULTS:0 = 적영 1체, 사일런트 킬을 권장.
				ENDIF
			ELSE
				BTL_KOJO_RESULTS:0 = 기습 성공, 제압을 개시해 주십시오……
			ENDIF
		;思わず「マスター！」って言っちゃう造魔ちゃんかわいい
		ELSEIF TSTR:네비_시추에이션_서버1 == "バックアタック"
			IF 0
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 후방에 적 그림자읏……!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%! 배후에 적 확인됐습니다읏……!?
			ELSE
				BTL_KOJO_RESULTS:0 = 백어택입니다, 후열의 여러분, 방어를……!
			ENDIF
		ELSEIF TSTR:네비_시추에이션_서버1 == "バックアタック阻止"
			IF 0
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 적영 탐지. 모모타로 시스템 올 그린.
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 모모타로에 반응 있음. 후방입니다, %CSTR:이인칭%……
			;たぶんパソコン撫でてると思う
			ELSE
				BTL_KOJO_RESULTS:0 = 기습 감지. 모모타로 님, 훌륭한 일처리입니다.
			ENDIF
		ELSEIF TSTR:네비_시추에이션_서버1 == "不意打ち"
			IF 0
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 읏…… 반응 있음, 기습입니다읏……!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 적측, 공격 준비가 완료되어 있습니다…… 회피를!
			ELSE
				BTL_KOJO_RESULTS:0 = 적측, 공격 준비가 완료되어 있습니다…… 방어를!
			ENDIF
		ELSEIF TSTR:네비_시추에이션_서버1 == "不意打ち阻止"
			距離 += RAND:10 + 5
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 적영 탐지. 모모타로 시스템 올 그린.
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 모모타로에 반응 있음. {方位}시 방향, 거리 {距離}. %CSTR:이인칭%……
			;たぶんパソコン撫でてると思う
			ELSE
				BTL_KOJO_RESULTS:0 = 기습 감지. 모모타로 님, 훌륭한 일처리입니다.
			ENDIF
		;ELSEIF TSTR:네비_시추에이션_서버1 == "통상"
		ELSE
			IF 0
			ELSEIF TSTR:네비_시추에이션_서버2 == "格下"
				IF 0
					;サンプル
					BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体。
					BTL_KOJO_RESULTS:1 = 조무래기지만 방심은 금물입니다~
				;平常時の報告ってことで敵の数に関わらず出る
				ELSEIF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = 敵影確認。
					BTL_KOJO_RESULTS:1 = 数{TFLAG:적초기배치수}。正面、距離{距離}周辺。
				ELSEIF TFLAG:적초기배치수 >= 7
					IF RAND:2
						BTL_KOJO_RESULTS:0 = 적 발견. 정면, 다수. 조심하시길……
					ELSE
						BTL_KOJO_RESULTS:0 = 약한 적 다수. %CSTR:이인칭%, 방심하지 마시기를……
					ENDIF
				ELSEIF TFLAG:적초기배치수 >= 7
					TEMPCOUNT = 方位 + RAND:3 + 1
					BTL_KOJO_RESULTS:0 = 敵影{TFLAG:적초기배치수}。
					BTL_KOJO_RESULTS:1 = {TEMPCOUNT}시, {方位}시 방향. 포위에 주의를……
				ELSEIF TFLAG:적초기배치수 >= 5
					BTL_KOJO_RESULTS:0 = 적 {TFLAG:적초기배치수}체.
					BTL_KOJO_RESULTS:1 = {方位}時方向、距離{距離}。
				ELSEIF TFLAG:적초기배치수 >= 4
					BTL_KOJO_RESULTS:0 = 敵性体捕捉、{TFLAG:적초기배치수}。
					BTL_KOJO_RESULTS:1 = %CSTR:이인칭%, 유린을.
				ELSEIF TFLAG:적초기배치수 >= 3
					TEMPCOUNT = 方位 + RAND:3 + 1
					BTL_KOJO_RESULTS:0 = 적 포착, {TEMPCOUNT}…… 아니, {方位}시 방향.
					BTL_KOJO_RESULTS:1 = 도주 중인 적을 추적합니다.
				ELSEIF TFLAG:적초기배치수 >= 2
					BTL_KOJO_RESULTS:0 = 敵影確認。
					BTL_KOJO_RESULTS:1 = {方位}時方向、距離{距離}。{TFLAG:적초기배치수}。
				ELSEIF TFLAG:적초기배치수 >= 1
					BTL_KOJO_RESULTS:0 = 単体捕捉。
					BTL_KOJO_RESULTS:1 = 정면입니다, %CSTR:이인칭%.
				ELSE
					;死に分岐だが一応
					BTL_KOJO_RESULTS:0 = 적 포착. {方位}시 방향. {TFLAG:적초기배치수}체 확인……
				ENDIF
			ELSEIF TSTR:네비_시추에이션_서버2 == "同格"
				IF 0
					;サンプル
					BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体。
					BTL_KOJO_RESULTS:1 = 조무래기지만 방심은 금물입니다~
				;平常時の報告ってことで敵の数に関わらず出る
				ELSEIF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = 敵影確認。
					BTL_KOJO_RESULTS:1 = 数{TFLAG:적초기배치수}。正面、距離{距離}周辺。
				ELSEIF TFLAG:적초기배치수 >= 7
					BTL_KOJO_RESULTS:0 = 敵影確認。数{TFLAG:적초기배치수}。
					BTL_KOJO_RESULTS:1 = 正面、距離{距離}周辺。
				ELSEIF TFLAG:적초기배치수 >= 6
					BTL_KOJO_RESULTS:0 = 적성 대상, 거리 {距離}에 확인.
				ELSEIF TFLAG:적초기배치수 >= 4
					BTL_KOJO_RESULTS:0 = 敵性対象捕捉、{TFLAG:적초기배치수}。
					BTL_KOJO_RESULTS:1 = %CSTR:이인칭%, 조심하십시오……
				ELSEIF TFLAG:적초기배치수 >= 3
					TEMPCOUNT = TEMPCOUNT + RAND:3 + 1
					BTL_KOJO_RESULTS:0 = 적 포착, 거리 {距離}…… 아니, {TEMPCOUNT}.
					BTL_KOJO_RESULTS:1 = 그 외 적영 없음……
				ELSEIF TFLAG:적초기배치수 >= 2
					BTL_KOJO_RESULTS:0 = {方位}時方向、敵{TFLAG:적초기배치수}確認。
					BTL_KOJO_RESULTS:1 = 거리를 좁혀오고 있습니다.
				ELSEIF TFLAG:적초기배치수 >= 1
					BTL_KOJO_RESULTS:0 = 적 확인. 정면, 1. 주변 경계를 개시합니다……
				ELSE
					;死に分岐だが一応
					BTL_KOJO_RESULTS:0 = 적 포착. {方位}시 방향. {TFLAG:적배치수}체 확인……
				ENDIF

			ELSEIF TSTR:네비_시추에이션_서버2 == "格上"
				IF 0
					;サンプル
					BTL_KOJO_RESULTS:0 = 敵{TFLAG:적초기배치수}体。
					BTL_KOJO_RESULTS:1 = 조무래기지만 방심은 금물입니다~
				;ちょっと悲鳴
				ELSEIF TFLAG:적초기배치수 >= 10
					BTL_KOJO_RESULTS:0 = 강적 10체! %CSTR:이인칭%, 즉시 이탈을 권장……!
				ELSEIF TFLAG:적초기배치수 >= 7
					TEMPCOUNT = TFLAG:적초기배치수 - 2
					BTL_KOJO_RESULTS:0 = 강적 {TEMPCOUNT}…… 아니, {TFLAG:적초기배치수}체읏……!?
				ELSEIF TFLAG:적초기배치수 >= 6
					BTL_KOJO_RESULTS:0 = 강적, {TFLAG:적초기배치수}체읏…… 이탈을 권장합니다……!
				ELSEIF TFLAG:적초기배치수 >= 5
					BTL_KOJO_RESULTS:0 = 강적 {方位}시 방향, 거리 {距離}읏……
				ELSEIF TFLAG:적초기배치수 >= 4
					BTL_KOJO_RESULTS:0 = 敵性対象捕捉、{TFLAG:적초기배치수}。
					BTL_KOJO_RESULTS:1 = %CSTR:이인칭%, 조심하십시오……
				ELSEIF TFLAG:적초기배치수 >= 3
					TEMPCOUNT = TEMPCOUNT + RAND:3 + 1
					BTL_KOJO_RESULTS:0 = 적 포착, 거리 {距離}…… 아니, {TEMPCOUNT}.
					BTL_KOJO_RESULTS:1 = 주변 확인을 철저히 하겠습니다……
				ELSEIF TFLAG:적초기배치수 >= 2
					BTL_KOJO_RESULTS:0 = 기습 감지…… 들켰습니다.
					BTL_KOJO_RESULTS:1 = {方位}時方向、敵{TFLAG:적초기배치수}。
				ELSEIF TFLAG:적초기배치수 >= 1
					BTL_KOJO_RESULTS:0 = 강적, 포착…… 바로 정면입니다, %CSTR:이인칭%.
				ELSE
					;死に分岐だが一応
					BTL_KOJO_RESULTS:0 = 적 포착. {方位}시 방향. {TFLAG:적배치수}체 확인……
				ENDIF
			ENDIF
		ENDIF
	ELSEIF TSTR:네비_시추에이션_메인 == "メイン画面"
		IF 0
		ELSEIF TSTR:네비_시추에이션_서버1 == "重度の危機"
			IF 0
			ELSEIF TSTR:네비_시추에이션_서버2 == "半壊"
				;逃走不能で半壊
				IF FLAG:도주불가플래그
					IF 0
					ELSEIF RAND:3 == 0 && 陥落() > 0
						BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, ……읏……
						BTL_KOJO_RESULTS:1 = %CSTR:이인칭%, 부디 무사히 귀환하시기를 기도드립니다……!
					ELSEIF RAND:2 == 0
						BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 도주 경로를 발견할 수 없습니다!
						BTL_KOJO_RESULTS:1 = 전투에 집중을……!
					ELSE
						BTL_KOJO_RESULTS:0 = 상황, 불리……! %CSTR:이인칭%, 전열을 재정비하십시오……!
					ENDIF
				ELSE
					IF 0
					;無力感で泣きそうになってる
					ELSEIF RAND:3 == 0
						BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 방어와 회복,
						BTL_KOJO_RESULTS:1 = 혹은 후퇴를 권장……!
					ELSEIF RAND:2 == 0
						BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 즉시 후퇴를 권장……!
					ELSE
						BTL_KOJO_RESULTS:0 = 즉시 이탈을 권장……!
					ENDIF
				ENDIF
			ELSEIF TSTR:네비_시추에이션_서버2 == "死亡者多数"
				;逃走不能で半壊
