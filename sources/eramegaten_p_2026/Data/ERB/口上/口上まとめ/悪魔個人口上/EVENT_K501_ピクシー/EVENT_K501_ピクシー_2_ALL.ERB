;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	KSTR:(K++) = 「아、서머너ー다！오늘 무슨 일이야ー？지오？해피 스텝？」
	KSTR:(K++) = 「아니면 디아로 회복하길 바라는 걸까ー？외상약 아깝잖아！」
	KSTR:(K++) = 「헤？조교……？나를？」
	KSTR:(K++) = 「응ー……뭐어ー……서머너ー가 꼭 그러고 싶다면야……」
	KSTR:(K++) = 「…………상냥하게 해줘야 해？」
	CFLAG:201 = 1
	GOTO 表示
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	KSTR:(K++) = 「있잖아……오늘도 조교야ー？무ー。전투에도 사용해줘ー。분명 강할테니까ー。」
	KSTR:(K++) = 볼록해진 얼굴의 %CALLNAME을% 달래면서、%PLAYER는% %CALLNAME을% 밀어 넘어뜨렸다……。
	CFLAG:201 = 2
	GOTO 表示
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	KSTR:(K++) = 「응……아、서머너ー。조교하는 거야？　……몸、씻어놨어。」
	KSTR:(K++) = %CALLNAME% 스스로 행동을 취해주었다。조교는 순조로운 것 같다。
	CFLAG:201 = 3
	GOTO 表示
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	KSTR:(K++) = 「서머너ー、저기、그……나、준비됐어。그러니까、저기……상냥하게……」
	KSTR:(K++) = 그것은 %CALLNAME% 나름이다、라고 %PLAYER가% 전하자、%CALLNAME은% 고개를 끄덕이며、옷을 벗기 시작했다……。
	CFLAG:201 = 4
	GOTO 表示
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		IF CFLAG:미조교함락 == 1
			;調教せずに恋慕をつけた場合
