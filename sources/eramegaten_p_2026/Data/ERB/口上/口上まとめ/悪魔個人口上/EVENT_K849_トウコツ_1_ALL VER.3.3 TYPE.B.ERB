;掛け合いキャラがいるかを探す関数＠トウコツ用
;おそらくP(bazzile)ニキが改良してくれたんだと思うけど毎回KOJO_BATTLE_EVENTの先頭でやるのは無駄くない？って思ったので関数化
;現在の対象：トウテツ、キュウキ、コントン、ダークサマナー
@SEARCH_KAKEAI_FOR_TAOWN, ARG
#FUNCTION
#DIM LCOUNT
#DIM L_POS, 6
#DIM L_CHARA
;掛け合い対象の検索
;味方POSをランダムな順で検索して最初にHITしたのが掛け合い対象となる
;こうやって書くとL_POS(0)=1, (1)=2って入るよ
L_POS = 1, 2, 3, 4, 5, 6
;念のため初期化
TFLAG:대화형캐릭터 = -1
;L_POSの中をめちゃくちゃに交換して
FOR LCOUNT, 0, 6
	SWAP L_POS:(RAND:6), L_POS:(RAND:6)
NEXT
;L_POS(0)～(5)のキャラクターを順々に見て、掛け合い対象者ならそいつの番号を返す。
;最後まで見つからなかったら-1返す。
FOR LCOUNT, 0, 6
	L_CHARA = POS(L_POS:LCOUNT)
	SIF !IS_TARGET_ABLE(L_CHARA)
		CONTINUE
	;自分自身は省く
	SIF ARG == L_CHARA
		CONTINUE
	;掛け合いキャラは入力可能な状態である必要がある
	SIF !INPUTABLE_CHARA_F(L_CHARA)
		CONTINUE
	;TS四凶 or ダマナー
	;増えてきたら一行で済ますのやめようかな…
	IF IS_TS_HUNDUN(L_CHARA) > 0 || IS_TS_TAOTIE(L_CHARA) > 0 || IS_TS_KYUKI(L_CHARA) > 0 || NO:L_CHARA == [[キャラ:다크서머너]]
		TFLAG:대화형캐릭터 = L_CHARA
		RETURNF 1
	ENDIF
NEXT
RETURNF -1

;いちいち判定するのめんどくさいので「忠義の～」シリーズかどうかを判定する関数を作ることに
;威力が最大値かも調べたかったからFUNCTION化してませぬ
;ARG=実行者
;RESULT:0　「忠義の～」シリーズなら→そのスキル番号
;　　　　　それ以外なら→-1
;RESULT:1　威力が最大値→1
;　　　　　それ以外なら→0
;　　　　　「忠義の～」シリーズでないなら→-1
@IS_SKILL_LOYALTY_SERIES, ARG
SELECTCASE CFLAG:ARG:입력행동
	CASE [[스킬:충의의참격]]
		RESULT:0 = LOCAL
		CALL GET_SKILL_PROP, "SKILL_POWER", CFLAG:ARG:입력행동, ARG
		IF RESULT == 280
			RESULT:1 = 1
		ELSE
			RESULT:1 = 0
		ENDIF
	CASE [[스킬:충의의총격]]
		RESULT:0 = LOCAL
		CALL GET_SKILL_PROP, "SKILL_POWER", CFLAG:ARG:입력행동, ARG
		IF RESULT == 280
			RESULT:1 = 1
		ELSE
			RESULT:1 = 0
		ENDIF
	CASE [[스킬:충의의권]]
		RESULT:0 = LOCAL
		CALL GET_SKILL_PROP, "SKILL_POWER", CFLAG:ARG:입력행동, ARG
		IF RESULT == 280
			RESULT:1 = 1
		ELSE
			RESULT:1 = 0
		ENDIF
	CASE [[스킬:충의의업]]
		RESULT:0 = LOCAL
		CALL GET_SKILL_PROP, "SKILL_POWER", CFLAG:ARG:입력행동, ARG
		IF RESULT == 280
			RESULT:1 = 1
		ELSE
			RESULT:1 = 0
		ENDIF
	CASE [[스킬:충의의화염]]
		RESULT:0 = LOCAL
		CALL GET_SKILL_PROP, "SKILL_POWER", CFLAG:ARG:입력행동, ARG
		IF RESULT == 256
			RESULT:1 = 1
		ELSE
			RESULT:1 = 0
		ENDIF
	CASE [[스킬:충의의빙결]]
		RESULT:0 = LOCAL
		CALL GET_SKILL_PROP, "SKILL_POWER", CFLAG:ARG:입력행동, ARG
		IF RESULT == 256
			RESULT:1 = 1
		ELSE
			RESULT:1 = 0
		ENDIF
	CASE [[스킬:충의의전격]]
		RESULT:0 = LOCAL
		CALL GET_SKILL_PROP, "SKILL_POWER", CFLAG:ARG:입력행동, ARG
		IF RESULT == 256
			RESULT:1 = 1
		ELSE
			RESULT:1 = 0
		ENDIF
	CASE [[스킬:충의의충격]]
		RESULT:0 = LOCAL
		CALL GET_SKILL_PROP, "SKILL_POWER", CFLAG:ARG:입력행동, ARG
		IF RESULT == 256
			RESULT:1 = 1
		ELSE
			RESULT:1 = 0
		ENDIF
	CASEELSE
		RESULT:0 = -1
		RESULT:1 = -1
ENDSELECT

;ターゲットが単体なら、そいつがボスかを判定、
;ターゲットが複数なら、その中にボスがいるかを判定する関数（ランダム攻撃の場合、範囲内にいても攻撃してない場合はあるがそれはそれ）
;もしかしたらGET_CREC_SUMとか使ったほうがいいのかもしれんけどよく分からんかったので
;よく考えたらボスが死んだとは限らないから複数の方では使えなくないか？？
@IS_TARGET_BOSS, ARG
#LOCALSIZE 3
#DIM 포지션
;ターゲットが1～16の時は単体攻撃
IF CFLAG:ARG:타겟 < 17
	LOCAL = POS(CFLAG:ARG:타겟)
	SIF LOCAL < 0
		RETURN LOCAL
	SIF CFLAG:LOCAL:보스플래그
		RETURN 1
	RETURN 0
;それ以外は範囲攻撃
ELSE
	SELECTCASE CFLAG:ARG:타겟
	CASE 17
		;17=味方前列
		IF CFLAG:ARG:PT플래그 > 0
			LOCAL:1 = 1
			LOCAL:2 = 3
		ELSE
			LOCAL:1 = 7
			LOCAL:2 = 11
		ENDIF
	CASE 18
		;18=味方後列
		IF CFLAG:ARG:PT플래그 > 0
			LOCAL:1 = 4
			LOCAL:2 = 6
		ELSE
			LOCAL:1 = 12
			LOCAL:2 = 16
		ENDIF
	CASE 19
		;19=味方全体
		IF CFLAG:ARG:PT플래그 > 0
			LOCAL:1 = 1
			LOCAL:2 = 6
		ELSE
		ENDIF
	CASE 20
		;20=敵前列
		IF CFLAG:ARG:PT플래그 > 0
			LOCAL:1 = 7
			LOCAL:2 = 11
		ELSE
			LOCAL:1 = 1
			LOCAL:2 = 3
		ENDIF
	CASE 21
		;21=敵後列
		IF CFLAG:ARG:PT플래그 > 0
			LOCAL:1 = 12
			LOCAL:2 = 16
		ELSE
			LOCAL:1 = 4
			LOCAL:2 = 6
		ENDIF
	CASE 22
		;22=敵全体
		IF CFLAG:ARG:PT플래그 > 0
			LOCAL:1 = 7
			LOCAL:2 = 16
		ELSE
			LOCAL:1 = 1
			LOCAL:2 = 6
		ENDIF
	CASE 23
		;23=敵味方全体
		LOCAL:1 = 1
		LOCAL:2 = 16
	ENDSELECT
	
	FOR LOCAL, LOCAL:1, LOCAL:2+1
		포지션 = POS(LOCAL)
		SIF 포지션 < 0
			CONTINUE
		SIF CFLAG:포지션:보스플래그
			RETURN 1
	NEXT
	RETURN 0
ENDIF

