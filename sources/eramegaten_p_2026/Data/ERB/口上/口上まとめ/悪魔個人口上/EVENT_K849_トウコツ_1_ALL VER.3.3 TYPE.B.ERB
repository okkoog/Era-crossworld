									ELSE
										BTL_KOJO_RESULTS:0 = ……아직 안 끝났어？　슬슬 피곤해지는데
									ENDIF
								ENDIF
							ELSE
								IF RAND:3 == 0
									BTL_KOJO_RESULTS:0 = 적은 아직 아무도 죽지 않았어。어서 둘러싸서 다구리치지？
								ELSEIF RAND:2 == 0
									BTL_KOJO_RESULTS:0 = 이렇게…… 움직임이 없으면, %CSTR:일인칭%도 실황하기 힘들지
								ELSE
									BTL_KOJO_RESULTS:0 = 일단 뭐, 숫자 줄이는 게 최우선 아냐？
								ENDIF
							ENDIF
						ENDIF
				ENDSELECT
		ENDSELECT
	CASE "戦闘終了"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "勝利"
				IF ナビ_シチュエーション存在取得("格下")
