	ENDIF
	;CALL MESSAGE_B2(CALLNAME:ARG, 0, BTL_KOJO_RESULTS:0, BTL_KOJO_RESULTS:1, BTL_KOJO_RESULTS:2, BTL_KOJO_RESULTS:3, BTL_KOJO_RESULTS:4)
	;RESETCOLOR

;=========================================
;ナビ口上の存在確認
;この関数が設定されていないと口上が存在しない扱いになる
;=========================================
@IS_EXIST_KOJO_BATTLE_NAVI_K[[キャラ:도올]], ARG
RESULTS = TS版に有り
RETURN 0

;=========================================
;ナビ口上の存在確認
;この関数が設定されていないと口上が存在しない扱いになる
;=========================================
@IS_EXIST_KOJO_BATTLE_NAVI_K[[キャラ:도올]]_1, ARG
RETURN 1

;=========================================
;以下ナビ口上、京都じゃない方の双葉はんから拝借した古代ちゃん口上から拝借、本当に申し訳ない
;
;TSTR:네비_시추에이션_메인		主に呼び出しタイミングを定義(戦闘開始/メイン画面/戦闘終了)
;TSTR:네비_시추에이션_서버1		状況を定義
;TSTR:네비_시추에이션_서버2		状況の補足オプション
;=========================================
@KOJO_BATTLE_NAVI_K[[キャラ:도올]]_1, ARG, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5, ARG:6, ARG:7, ARG:8
#DIM 行
#DIMS 敵数
;右のような指定も可能→SETCOLOR 0xA0A0A0
;色見本に#ABCDEFというような書き方がされていた場合は、こちらの書き方(SETCOLOR 0xABCDEF)を使うと良い
;水色
;SETCOLOR 0x33ffcc
;SETCOLOR 0x5abeff
;VARSET LOCALS
CALL 口上変数初期化
;行 = 1
;敵数 = {ARG:1}
LOCALS = %CALLNAME%
;LOCALS   = 名前
;BTL_KOJO_RESULTS:0 = １行目
;BTL_KOJO_RESULTS:1 = ２行目
;BTL_KOJO_RESULTS:2 = ３行目
;LOCALS:4 = ４行目
;LOCALS:5 = ５行目
;　：
;　：
;BTL_KOJO_RESULTS:20 = ３０行目
SELECTCASE TSTR:네비_시추에이션_메인
	CASE "戦闘開始"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "통상"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "格下"
						IF TFLAG:적초기배치수 == 4
							;敵数4
							BTL_KOJO_RESULTS:0 = 적, 넷이야。적어도 한 줄 채우라는 생각 들지 않아？
						ELSEIF TFLAG:적초기배치수 == 3
							;敵数3
							BTL_KOJO_RESULTS:0 = 피래미 세 마리。어차피 속공이지？
						ELSEIF TFLAG:적초기배치수 == 2
							;敵数2
							BTL_KOJO_RESULTS:0 = 겨우 둘로？
							BTL_KOJO_RESULTS:0 = 핫, 저기 %CSTR:이인칭%, 얕보이지 말라고
						ELSEIF TFLAG:적초기배치수 == 1
							;敵数1
							BTL_KOJO_RESULTS:0 = ……아니, 뭐야 이거
							BTL_KOJO_RESULTS:1 = 제대로 상대하는 거 시간낭비 아냐？
						ELSE
							;敵数5以上
							BTL_KOJO_RESULTS:0 = 잘도 뭐　이렇게 줄줄……
							BTL_KOJO_RESULTS:1 = 수만 채우면 어떻게든 될거라고 생각하는 거냐, 이거
						ENDIF
						CFLAG:814 = 0
					CASE "同格"
						IF TFLAG:적초기배치수 == 1
							BTL_KOJO_RESULTS:0 = 실력은 호각이다만, 저쪽은 하나
							BTL_KOJO_RESULTS:1 = 숫자로 바로 눌러버리지？
						ELSE
							BTL_KOJO_RESULTS:0 = 적, %敵数% 체。방심 안 하면 이길 수 있지？
						ENDIF
						CFLAG:814 = 0
					CASE "格上"
						;敵数１
						IF TFLAG:적초기배치수 == 1
							BTL_KOJO_RESULTS:0 = 상대 한 기, 하지만 이녀석 꽤 위험해
							BTL_KOJO_RESULTS:1 = 진심으로 안 가면 위험한 거 아냐？
						ELSE
							BTL_KOJO_RESULTS:0 = 우와～……이런 녀석 상대하는 건가아
							BTL_KOJO_RESULTS:1 = 전생에 뭐 했냐는 레벨이지 이거
						ENDIF
						CFLAG:814 = 0
				ENDSELECT
			CASE "先制攻撃"
				IF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = 좋아, 선제 취했어。마음껏 패버리라고
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 여유 부리는 바보 발견。그대로 재워버려？
				ELSE
					BTL_KOJO_RESULTS:0 = 응…… 출발이 좋네。그대로 때려눕히지？
				ENDIF
				CFLAG:814 = 0
			CASE "バックアタック"
				IF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = 아ー아ー아ー…… 이거 너무하네, 대열 엉망이야
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 우선은 버티고, 반격은 나중에 생각하면 되겠지
				ELSE
					BTL_KOJO_RESULTS:0 = 거짓말, 어디서 솟아난거야 이놈들……？
				ENDIF
				CFLAG:814 = 0
			CASE "バックアタック阻止"
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 응…… 하쿠타로가 반응하잖아。적, 온다
				ELSE
					BTL_KOJO_RESULTS:0 = 하쿠타로로부터 통지……？
					BTL_KOJO_RESULTS:1 = 아, 후방에서 뭔가 가까워져오고 있어, 경계해
				ENDIF
				CFLAG:814 = 0
			CASE "不意打ち"
				IF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = 아ー아ー아ー…… 대열이 무너지지 않은 것만으로 감지덕지라는 느낌？
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 우선은 버티고, 반격은 나중에 생각하면 되겠지
				ELSE
					BTL_KOJO_RESULTS:0 = 거짓말, 어디 숨어있었어 이놈들……？
				ENDIF
				CFLAG:814 = 0
			CASE "不意打ち阻止"
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 응…… 하쿠타로가 반응하잖아。적, 온다
				ELSE
					BTL_KOJO_RESULTS:0 = 하쿠타로로부터 통지……？
					BTL_KOJO_RESULTS:1 = 아。전방에 뭔가 숨어있어, 경계해
				ENDIF
				CFLAG:814 = 0
		ENDSELECT
	CASE "メイン画面"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "重度の危機"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "死亡者多数"
						IF FLAG:도주불가플래그
							BTL_KOJO_RESULTS:0 = 잠깐, 위험한 거 아냐, 이거？
							BTL_KOJO_RESULTS:1 = 아아 제기랄, 그래도 도망칠 수도 없고……！
						ELSE
							BTL_KOJO_RESULTS:0 = 잠깐, 위험한 거 아냐, 이거？
							BTL_KOJO_RESULTS:1 = 필요하다면 퇴로, 찾아놓을게！
						ENDIF
					CASE "マスター瀕死"
						IF RAND:2 == 0
							BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 죽을 거 같은데
							BTL_KOJO_RESULTS:1 = 너무 오기 부리지 말라구
						ELSE
							BTL_KOJO_RESULTS:0 = 슬슬 %CSTR:이인칭%도 회복, 필요하지
						ENDIF
					CASE "マスター死亡"
							BTL_KOJO_RESULTS:0 = 아니, 어째서 %CSTR:이인칭%가 죽는건데
							BTL_KOJO_RESULTS:1 = 하ー……일단 누구, 회복 가능해？
					CASE "그외"
						IF FLAG:도주불가플래그
							IF RAND:3 == 0
								BTL_KOJO_RESULTS:0 = 들리지？
								BTL_KOJO_RESULTS:1 = 그녀석에게서는 도망칠 수 없어。일단 지금은 회복, 서둘러
							ELSEIF RAND:2 == 0
								BTL_KOJO_RESULTS:0 = 됐으니까 바로 회복시켜
								BTL_KOJO_RESULTS:1 = 저녀석들한테 쓰러지면 진짜 끝이라고？
							ELSE
								BTL_KOJO_RESULTS:0 = 죽기 전에 회복해두라고……
								BTL_KOJO_RESULTS:1 = 아무 수도 못 쓰게 된 후에는 늦잖아
							ENDIF
						ELSE
							IF RAND:2 == 0
								BTL_KOJO_RESULTS:0 = 여기서 도망가는 거, 실제로 한 방법이라고 생각해
								BTL_KOJO_RESULTS:1 = 뭐 판단하는 건 %CSTR:이인칭%의 몫이지만
							ELSE
								BTL_KOJO_RESULTS:0 = 아직 싸울 생각이라면, 회복해두는 편이 좋지 않아？
							ENDIF
						ENDIF
				ENDSELECT
			CASE "中度の危機"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "戦力低下"
						IF RAND:3 == 0
							BTL_KOJO_RESULTS:0 = 아아 진짜 갑갑하네, 저기 %CSTR:이인칭%, 지금부터 %CSTR:일인칭% 소환해
							CFLAG:814 = 1
						ELSEIF RAND:2 == 0
							BTL_KOJO_RESULTS:0 = 이쪽의 수, 줄어들었는데。커버하는 편이 낫지 않아？
						ELSE
							BTL_KOJO_RESULTS:0 = ……위험하네。각개격파당하지 않게 경계하면서 태세를 바로잡아
						ENDIF
					CASE "핀치캐릭터"
						SELECTCASE TSTR:핀치캐릭터위기내용
							CASE "DYING"
								IF 0
								;TSコントン
								ELSEIF IS_TS_HUNDUN(TFLAG:핀치캐릭터) > 0
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%가 쓰러졌어
									BTL_KOJO_RESULTS:1 = 뭐, 그거야 전투 도중에 망상하니 그렇지……
								;TSキュウキ
								ELSEIF IS_TS_KYUKI(TFLAG:핀치캐릭터) > 0
									BTL_KOJO_RESULTS:0 = 응？　%TSTR:핀치캐릭터명%, 죽었어
									BTL_KOJO_RESULTS:1 = 갑자기 없어지니 조용하네
								;TSトウテツ
								ELSEIF IS_TS_TAOTIE(TFLAG:핀치캐릭터) > 0
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%, 뭘 하는지……
									BTL_KOJO_RESULTS:1 = 저기 %CSTR:이인칭%, 어떻게든 안돼？
								ELSEIF RAND:2 == 0
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%가 당한 거 같아
									BTL_KOJO_RESULTS:1 = 흐름이 나쁘네…… 소생 가능하지？
								ELSE
									BTL_KOJO_RESULTS:0 = 저기, 거기 자는 녀석 안 일으킬 거야？
								ENDIF
							CASE "瀕死"
								IF 0
								ELSEIF IS_TS_HUNDUN(TFLAG:핀치캐릭터) > 0
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%, 다리 떨리고 있어
									BTL_KOJO_RESULTS:1 = 뭐, 전부 망상대로 풀릴 리가 없지……
									;ここからコントンのセリフ
									TFLAG:대화형캐릭터 = TFLAG:핀치캐릭터
									BTL_KOJO_REACT_RESULTS:0 = 아니아니, 이 역경으로부터의 역전까지가 망상이니까요
								ELSEIF IS_TS_KYUKI(TFLAG:핀치캐릭터) > 0
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%, 참는 건 거기까지 해둬
									BTL_KOJO_RESULTS:1 = 정말이지, 진짜 손이 많이 가네 이녀석……
									;ここからキュウキのセリフ
									TFLAG:대화형캐릭터 = TFLAG:핀치캐릭터
									BTL_KOJO_REACT_RESULTS:0 = 참는다？　무, 무슨 소리인지 모르겠는데요오？
								ELSEIF IS_TS_TAOTIE(TFLAG:핀치캐릭터) > 0
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%, 너 슬슬 위험해
									BTL_KOJO_RESULTS:1 = 일단 무리만은 하지 마
									;ここからトウテツのセリフ
									TFLAG:대화형캐릭터 = TFLAG:핀치캐릭터
									BTL_KOJO_REACT_RESULTS:0 = 응…… 무리 안 하고, 힘낼게
								ELSEIF RAND:2 == 0
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%가 죽을 거 같아, 일단 회복해두지 않을래？
								ELSE
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%, 꽤나 위기 아냐？
									BTL_KOJO_RESULTS:1 = 속공으로 정리할 수 없다면 회복해두자
								ENDIF
							CASE "重傷"
								IF 0
								ELSEIF IS_TS_HUNDUN(TFLAG:핀치캐릭터) > 0
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%, 왠지 비틀거리지 않아？
									BTL_KOJO_RESULTS:1 = 여유부리면서 망상 같은 거나 하니까 그런 거지
									;ここからコントンのセリフ
									TFLAG:대화형캐릭터 = TFLAG:핀치캐릭터
									BTL_KOJO_REACT_RESULTS:0 = 오히려 망상이야말로 평시 운전같은 거라고 생각 안 하시나요？
								ELSEIF IS_TS_KYUKI(TFLAG:핀치캐릭터) > 0
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%, 노려지고 있다구 너。신이 나서 너무 도발했어
									;ここからキュウキのセリフ
									TFLAG:대화형캐릭터 = TFLAG:핀치캐릭터
									BTL_KOJO_REACT_RESULTS:0 = 이정도에 열받는 적이 나쁜 거예요오ー
								ELSEIF IS_TS_TAOTIE(TFLAG:핀치캐릭터) > 0
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%, 꽤나 데미지 먹고 있는데, 아직 움직일 수 있어？
									;ここからトウテツのセリフ
									TFLAG:대화형캐릭터 = TFLAG:핀치캐릭터
									BTL_KOJO_REACT_RESULTS:0 = 아직, 아직…… 괜찮앗
								ELSE
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%의 움직임, 나빠졌어。누군가 엄호로 보낼 수 없어？
								ENDIF
							CASE "HAPPY"
								BTL_KOJO_RESULTS:0 = 잠만 타임, 맛간 녀석 있으니 확인해
							CASE "PANIC"
								BTL_KOJO_RESULTS:0 = 혼란이네。뭘 저지를지 모르니 고치지 않을래？
							CASE "SLEEP"
								BTL_KOJO_RESULTS:0 = 자는 중에 얻어맞으면 엄청 아프지이……
							CASE "BIND"
								BTL_KOJO_RESULTS:0 = 움직일 수 없다고 해。놔두는 것도 좀 그렇지 않아？
							CASE "CLOSE"
								BTL_KOJO_RESULTS:0 = 마법은 쓸 수 없지만…… 뭐어, 팰 수는 있지？
							CASE "POISON"
								BTL_KOJO_RESULTS:0 = 독 말이지ー……살살 깎아내는 거 수수하게 짜증나지 않아？
							CASE "BOMB"
								BTL_KOJO_RESULTS:0 = 폭탄이 된 놈이 있어。%CSTR:일인칭%도 불 안 번지게 기도해둘까？
							CASE "CHARM"
								BTL_KOJO_RESULTS:0 = 아차ー、매료당했네。패버리면 낫지 않아？
							CASE "PALYZE"
								BTL_KOJO_RESULTS:0 = 마비라나 봐。ＭＰ 깎이는 건 좋지 않지
							CASE "CURSE"
								BTL_KOJO_RESULTS:0 = 저주 같은 거 귀찮으니 무시하고 패버리지 않을래？
							CASE "FLY"
								BTL_KOJO_RESULTS:0 = 말해두겠는데, 파리가 되면 데미지 제대로 안 나오니까
								BTL_KOJO_RESULTS:1 = 얌전히 방어시키든지 귀환시키든지 해야 해
							CASE "STONE"
								BTL_KOJO_RESULTS:0 = 석화 같은 거 실질적으로 사망같은 거니까, 어서 치유해
							CASE "FLAME"
								BTL_KOJO_RESULTS:0 = 생으로 구워지는 거 엄청 괴롭다나 봐, 잘은 모르겠지만
							CASE "SLIP"
								BTL_KOJO_RESULTS:0 = 얼마나 기세 좋게 넘어지면 행동불능이 되는 거야？
							CASE "BRAND"
								BTL_KOJO_RESULTS:0 = 회복되지 않는다니 진짜 열받지 않아？
								BTL_KOJO_RESULTS:1 = 애시당초 무슨 낙인인데 그거
						ENDSELECT
					CASE "그외"
						BTL_KOJO_RESULTS:0 = 조금 전황이 안 좋게 돌아가는 것 같네
						BTL_KOJO_RESULTS:1 = 일찌감치 손을 쓰는 편이 좋지 않아?
				ENDSELECT
			CASE "平常"
				;戦闘中・危険な状態の味方はいない・戦闘開始時よりも敵の数が少ない
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "一部撃破済み"
						IF RAND:3 == 0
							BTL_KOJO_RESULTS:0 = 흐ー응, 상태 좋잖아？　이대로 전멸시키자？
						ELSEIF RAND:2 == 0
							BTL_KOJO_RESULTS:0 = 적의 수가 줄었어。이 상태라면 이길 수 있겠네
						ELSE
							BTL_KOJO_RESULTS:0 = 이쪽은 모두 팔팔해。더 밀어붙이지 그래？
						ENDIF
					CASE "그외"
						IF FLAG:경과턴수 == 0
							BTL_KOJO_RESULTS:0 = 어쨌든 수를 줄여놓지 않으면 안 되겠어。힘내
						ELSE
							IF RAND:2
								IF FLAG:경과턴수 < 3
									BTL_KOJO_RESULTS:0 = 속공으로 정리할 수 있을 거 같아？　뭐, 자기 페이스를 중시해
								ELSEIF FLAG:경과턴수 < 10
									BTL_KOJO_RESULTS:0 = 흐ー응。적들도 제법 견디네
								ELSE
