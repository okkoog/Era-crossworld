					ELSEIF RAND:2 == 0
						BTL_KOJO_RESULTS:0 = 이런 피래미, 일부러 상대할 필요가 있었어？
					ELSE
						BTL_KOJO_RESULTS:0 = 네 수고。그럼 다음 가자
					ENDIF
					CFLAG:814 = 0
				ELSEIF ナビ_シチュエーション存在取得("格上")
					IF RAND:3 == 0
						BTL_KOJO_RESULTS:0 = 의심했던 건 아니지만, 진짜로 이겨버렸네
					ELSEIF RAND:2 == 0
						BTL_KOJO_RESULTS:0 = 응, 수고。비교적 손에 땀을 쥐었지만…… 이겨서 다행이야
					ELSE
						BTL_KOJO_RESULTS:0 = 좀처럼 눈을 뗄 수 없는 싸움이었어
						BTL_KOJO_RESULTS:1 = 격이 높은 적을 죽이는 것도 꽤나 괜찮네
					ENDIF
					CFLAG:814 = 0
				ELSE
					IF RAND:3 == 0
						BTL_KOJO_RESULTS:0 = 수고。뭐, %CSTR:이인칭%가 이 정도에 뒤를 잡힐 리 없지
					ELSEIF RAND:2 == 0
						BTL_KOJO_RESULTS:0 = 이 기세로 팍팍 가버려
					ELSE
						BTL_KOJO_RESULTS:0 = 전멸 확인。주변에 적 모습도 없고, 문제 없지 않아？
					ENDIF
					CFLAG:814 = 0
				ENDIF
			CASE "도주"
			CASE "敗北"
				BTL_KOJO_RESULTS:0 = 아아 진짜앗, %CSTR:일인칭%가 싸웠다면……！
				BTL_KOJO_RESULTS:1 = 지금이라도 서두르면 늦지 않으려나……？
		ENDSELECT
ENDSELECT

