@KOJO_BATTLE_EVENT_K[[キャラ:멜트릴리스]]_2, ARG, ARG:1, ARG:2
SELECTCASE GET_BATTLE_EVENT(TFLAG:전투이벤트)
	;COOP発動 発動者の番号はARGに格納されている
	CASE "COOP発動"
		IF RAND:11 == 0
			BTL_KOJO_RESULTS:0 = ―Allegro！
		ELSEIF RAND:10 == 0
			BTL_KOJO_RESULTS:0 = ―AdagioからAllegroへ……
			BTL_KOJO_RESULTS:1 = 華麗に決めましょう？
		ELSEIF RAND:9 == 0
			BTL_KOJO_RESULTS:0 = 私のリードに　しっかりついてきなさい？
		ELSEIF RAND:8 == 0
			BTL_KOJO_RESULTS:0 = フィニッシュの時間よ
		ELSEIF RAND:7 == 0
			BTL_KOJO_RESULTS:0 = 遅れないで
		ELSEIF RAND:6 == 0
			BTL_KOJO_RESULTS:0 = ついてきなさい
		ELSEIF RAND:5 == 0
			BTL_KOJO_RESULTS:0 = 後は任せるわ
		ELSEIF RAND:4 == 0
			BTL_KOJO_RESULTS:0 = 実力　見せてもらうわ
		ELSEIF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 私のステップに合わせなさい
			BTL_KOJO_RESULTS:1 = 完璧に溶かしてあげるから……♪
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 私に合わせて……
			BTL_KOJO_RESULTS:1 = 乱したら許さないわ
		ELSE
			BTL_KOJO_RESULTS:0 = 援護しなさい……
			BTL_KOJO_RESULTS:1 = 私の軌跡を追えるかしら？
		ENDIF
	;COOP参加
	CASE "COOP参加"
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			IF RAND:14 == 0
				BTL_KOJO_RESULTS:0 = ―Pas de Deux！
			ELSEIF RAND:13 == 0
				BTL_KOJO_RESULTS:0 = ―Grand jeté！
			ELSEIF RAND:12 == 0
				BTL_KOJO_RESULTS:0 = やればいいんでしょ？
			ELSEIF RAND:11 == 0
				BTL_KOJO_RESULTS:0 = 続くわ……！
			ELSEIF RAND:10 == 0
				BTL_KOJO_RESULTS:0 = あなたなら当然ね
			ELSEIF RAND:9 == 0
				BTL_KOJO_RESULTS:0 = ふん　やるじゃない
			ELSEIF RAND:8 == 0
				BTL_KOJO_RESULTS:0 = よくやったわ
			ELSEIF RAND:7 == 0
				BTL_KOJO_RESULTS:0 = 隙ができたわね……！
			ELSEIF RAND:6 == 0
				BTL_KOJO_RESULTS:0 = 踊りましょう……？
			ELSEIF RAND:5 == 0
				BTL_KOJO_RESULTS:0 = 褒めてあげる……
				BTL_KOJO_RESULTS:1 = あとは任せなさい
			ELSEIF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 後ろは任せて
				BTL_KOJO_RESULTS:1 = 貫くわ……！
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 上出来ね、%CALLNAME:MASTER%……
				BTL_KOJO_RESULTS:1 = でも　主役は渡さないわ！
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = いいタイミングよ
				BTL_KOJO_RESULTS:1 = 私のステップで　仕上げてあげる！
			ELSE
				BTL_KOJO_RESULTS:0 = いいわよ　一緒に踊ってあげる
				BTL_KOJO_RESULTS:1 = 敵を　蜜の海に沈めてやりましょう……♪
			ENDIF
		;発動者がパッションリップ
		ELSEIF FLAG:행동순1 != -1 && NO:(FLAG:행동순1) == [[キャラ:패션립]]
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = リップ　合わせるわ！
			ELSEIF RAND:2 == 0
