@MUSUME_SEIKAKU_KETTEI
;TALENT数チェック。
LOCAL:1 = TALENT:정조관념 + TALENT:프라이드높음 + TALENT:교만
LOCAL:2 = TALENT:건방짐 + TALENT:꿋꿋함 + TALENT:호기심 + TALENT:낙관적
LOCAL:3 = TALENT:얌전함 + TALENT:우애 + TALENT:헌신적 + TALENT:부끄럼쟁이
LOCAL:4 = TALENT:눈에띄고싶어함 + TALENT:소악마 + TALENT:부끄럼없음 + TALENT:해방
LOCAL:5 = TALENT:감정결핍 + TALENT:자제심 + TALENT:냉정 + TALENT:보수적
LOCAL:6 = TALENT:츤데레 + TALENT:즉각함락 + TALENT:우둔 + TALENT:쾌감을부정
LOCAL:7 = TALENT:반항적 + TALENT:잔학 + TALENT:저항 + TALENT:영맹 + TALENT:교활

;数値があまりにも低い場合は再計算
;特定の素質は性格のベースとなる素質なので2回足される
;2回足す、と言うことで元値に更に加算されるように+=を採用
;元の意図とは異なるかもしれませんが全タイプに対して同時に行うように (2011/06/10 望崎)

SIF LOCAL:1 <= 1
	LOCAL:1 += TALENT:정조관념 + TALENT:프라이드높음
SIF LOCAL:2 <= 2
	LOCAL:2 += TALENT:건방짐 + TALENT:호기심 + TALENT:꿋꿋함
SIF LOCAL:3 <= 2
	LOCAL:3 += TALENT:얌전함 + TALENT:우애 + TALENT:헌신적
SIF LOCAL:4 <= 2
	LOCAL:4 += TALENT:눈에띄고싶어함 + TALENT:소악마 + TALENT:부끄럼없음
SIF LOCAL:5 <= 2
	LOCAL:5 += TALENT:감정결핍 + TALENT:냉정 + TALENT:보수적
SIF LOCAL:6 <= 2
	LOCAL:6 += TALENT:츤데레 + TALENT:즉각함락 + TALENT:쾌감을부정
SIF LOCAL:7 <= 2
	LOCAL:7 += TALENT:반항적 + TALENT:저항 + TALENT:잔학

;繰り返し1～7
FOR LOCAL, 1, 8
	;おっきければ
	IF LOCAL:8 < LOCAL:LOCAL
		;それに合わせます
		LOCAL:8 = LOCAL:LOCAL
		;暫定一位
		CFLAG:딸성격 = LOCAL
		;以上ではなくより大きいなので1から優先されるはず　はず
	ENDIF
NEXT

;どのLOCALも合計が3に達しなければ性格が8になる
;こっちに持ってきました。LOCAL:8は1～7の中での最大値 (2011/06/10 望崎)
SIF LOCAL:8 < 2
	CFLAG:딸성격 = 8

