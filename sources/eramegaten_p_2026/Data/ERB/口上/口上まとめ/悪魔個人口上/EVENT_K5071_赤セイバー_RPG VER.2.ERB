@KOJO_BATTLE_EVENT_K[[キャラ:빨강세이버]], ARG, ARG:1, ARG:2
;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 5071
	RETURN 0
VARSET LOCALS

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = ずっと余の見せ場だな。余は楽しいぃ！
		ELSE
			BTL_KOJO_RESULTS:0 = トドメと行こう！
		ENDIF
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = 見事だ%CSTR:ARG:이인칭%よ。余は楽しいっ！
		;それ以外
		ELSE
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 余も行くぞっ！
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = その隙……逃さぬ！
			ELSE
				BTL_KOJO_RESULTS:0 = 続くっ！
			ENDIF
		ENDIF
	;被召喚時
	CASE 3
			BTL_KOJO_RESULTS:0 = 余を呼んだな？……フフン
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF RAND:5 == 0
				BTL_KOJO_RESULTS:0 = 失せるがよい！
			ELSEIF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 風と消えよ
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 健闘したな
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 余の勝ちだ！
			ELSE
				BTL_KOJO_RESULTS:0 = 決まったな！
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			IF RAND:5 == 0
				BTL_KOJO_RESULTS:0 = 受けるがよい！
			ELSEIF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = もらったぞ！
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 打ち砕く！
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = あまりにもローマ！
			ELSE
				BTL_KOJO_RESULTS:0 = まだまだゆくぞっ！
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = うむ　中々の手応えだ
			ELSE
				BTL_KOJO_RESULTS:0 = そこを動くな！
			ENDIF
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 硬いな……
			ELSE
				BTL_KOJO_RESULTS:0 = さて……
			ENDIF
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = なんという失態か……
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 余の力が足りなかったのか……
			ELSE
				BTL_KOJO_RESULTS:0 = すまぬ……生きよ、%CSTR:ARG:이인칭%……
			ENDIF
		;大ダメージ
		
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 限度があろうっ！
			ELSE
				BTL_KOJO_RESULTS:0 = うぐっ！
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = ふふん　それは効かぬぞ？
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = ふむ……余のファンだな？
		ENDIF
	;反射された
	CASE 15
			BTL_KOJO_RESULTS:0 = 無粋だな
	;反射した
	CASE 16
			BTL_KOJO_RESULTS:0 = 返上するぞ！
	;回避された
	CASE 17
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 見事！
			ELSE
				BTL_KOJO_RESULTS:0 = やるではないか！
			ENDIF
	;回避した
	CASE 18
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 簡単には当たってやらぬぞ！
			ELSE
				BTL_KOJO_RESULTS:0 = 止まって見えるぞ！
			ENDIF
	;反撃を発動した
	CASE 20
		SELECTCASE TFLAG:발동연동스킬
		;닷지카운터
		CASE 2484
			BTL_KOJO_RESULTS:0 = お返しだ　見とれてよいぞ？
		;その他
		CASEELSE
			BTL_KOJO_RESULTS:0 = 無礼な！
		ENDSELECT
	;トリガースキルを発動した
	CASE 21
		SELECTCASE TFLAG:발동연동스킬
		;○○
		;CASE 
		;	BTL_KOJO_RESULTS:0 = 
		;その他
		CASEELSE
			BTL_KOJO_RESULTS:0 = 
		ENDSELECT
	;食いしばり等で耐えた
	CASE 23
		;이악물기
		IF BASE:ARG:ＨＰ == 1
		;その他
		ELSE
			IF TALENT:3 || TALENT:6
				BTL_KOJO_RESULTS:0 = %CSTR:ARG:이인칭%を残してはゆけぬ！
			ENDIF
		ENDIF
	;バトルに勝利した
	CASE 90
			IF 現HP割合(ARG) < 25
				BTL_KOJO_RESULTS:0 = 今のはそなたにも責任があるのだぞ！
			ELSEIF 現HP割合(ARG) < 50
				BTL_KOJO_RESULTS:0 = 何か余に言うべきことは無いか？
			ELSEIF RAND:5 == 0
				BTL_KOJO_RESULTS:0 = 見事な采配だった！
			ELSEIF RAND:4 == 0
				BTL_KOJO_RESULTS:0 = 見事だ！それでこそ余の%CSTR:ARG:이인칭%！
			ELSEIF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 物足りぬ……もっと褒めよ！
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 当然の勝利である！
			ELSE
				BTL_KOJO_RESULTS:0 = ふむ　よしとしよう
			ENDIF
	;レベルアップした
	CASE 91
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = レベルア～ップ！
			ELSE
				BTL_KOJO_RESULTS:0 = もっと強く！更に華やかに！ふふ、期待せよ%CSTR:ARG:이인칭%
			ENDIF
	;逃走に成功した
	CASE 92
			BTL_KOJO_RESULTS:0 = 今ちょっとだけ忙しいのだ！さらば！
	;逃走に失敗した
	CASE 93
			BTL_KOJO_RESULTS:0 = えぇい！纏わりつくなうっとおしい！
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = ジリ貧だぞ　%CSTR:ARG:이인칭%
		ELSE
			BTL_KOJO_RESULTS:0 = では戦いを吟じるとしよう！
		ENDIF
	;バックアタックを受けた
	CASE 95
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = すまぬ　調子が出ぬ……
		ELSE
			BTL_KOJO_RESULTS:0 = 奇襲だ%CSTR:ARG:이인칭%！
		ENDIF
	;敵の先制攻撃を受けた
	CASE 96
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 踏ん張りどころだな%CSTR:ARG:이인칭%……
		ELSE
			BTL_KOJO_RESULTS:0 = 先手を取られるとは！
		ENDIF
	;先制攻撃に成功
	CASE 97
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 先手か　一番槍は誉だぞ%CSTR:ARG:이인칭%よ
		ELSE
			BTL_KOJO_RESULTS:0 = 先手だな%CSTR:ARG:이인칭%　指示を
		ENDIF
ENDSELECT
