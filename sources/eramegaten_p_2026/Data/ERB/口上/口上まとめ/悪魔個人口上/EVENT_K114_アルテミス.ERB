		;CFLAG:アナル回数が1以上なら入れられている、CFLAG:挿入回数が1以上なら入れています。
		;両方立っている場合は、地の文では入れられている側が優先されます。
		;-------------------------------------------------
	CASE 60
		CALL EVENT_MESSAGE
		IF     (CFLAG:603 < 1 || FLAG:7 == 2)
			IF     TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORML 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORML 
			ENDIF
			CFLAG:603 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・野外プレイ
		;;愛ＮＴＲか隷ＮＴＲ状態(TALENT:ＮＴＲが 1 か 3 か 4 か 6)で１日の終了時に発生。
		;愛ＮＴＲの場合、露出癖が4以上でないと発生しません
		;-------------------------------------------------
	CASE 61
		CALL EVENT_MESSAGE
		IF     (CFLAG:604 < 1 || FLAG:7 == 2)
			IF     TALENT:ＮＴＲ == 1 || TALENT:ＮＴＲ == 4
				;愛ＮＴＲ
				PRINTFORML 
			ELSEIF TALENT:ＮＴＲ == 3 || TALENT:ＮＴＲ == 6
				;隷ＮＴＲ
				PRINTFORML 
			ENDIF
			CFLAG:604 = 1
		ENDIF
		;-------------------------------------------------
		;;ＮＴＲ夜這い・野外調教
		;;隷ＮＴＲ状態(TALENT:ＮＴＲが 3 か 6)でCFLAG:現ＮＴＲ進行度が6以上の場合１日の終了時に発生。
		;-------------------------------------------------
	CASE 62
		CALL EVENT_MESSAGE
		IF     (CFLAG:605 < 1 || FLAG:7 == 2)
			;隷ＮＴＲ
			PRINTFORML 
			CFLAG:605 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔とセックスする
		;やられちゃう側
		;PLAYERに実行者の番号が入っています
		;-------------------------------------------------
	CASE 79
		CALL EVENT_MESSAGE
		IF     (CFLAG:602 < 1 || FLAG:7 == 2)
			PRINTFORML
			CFLAG:602 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔に奉仕させる
		;奉仕する側
		;PLAYERに実行者の番号が入っています
		;-------------------------------------------------
	CASE 80
		CALL EVENT_MESSAGE
		IF     (CFLAG:603 < 1 || FLAG:7 == 2)
			PRINTFORML
			CFLAG:603 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：その場で自慰
		;奉仕する側
		;-------------------------------------------------
	CASE 81
		CALL EVENT_MESSAGE
		IF     (CFLAG:604 < 1 || FLAG:7 == 2)
			PRINTFORML
			CFLAG:604 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：物陰で自慰
		;奉仕する側
		;-------------------------------------------------
	CASE 82
		CALL EVENT_MESSAGE
		IF     (CFLAG:605 < 1 || FLAG:7 == 2)
			PRINTFORML
			CFLAG:605 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔とセックスする
		;やる側
		;PLAYERに相手の番号が入っています
		;-------------------------------------------------
	CASE 83
		CALL EVENT_MESSAGE
		IF     (CFLAG:606 < 1 || FLAG:7 == 2)
			PRINTFORML
			CFLAG:606 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔に奉仕させる
		;奉仕される側
		;PLAYERに奉仕する側の番号が入っています
		;-------------------------------------------------
	CASE 84
		CALL EVENT_MESSAGE
		IF     (CFLAG:607 < 1 || FLAG:7 == 2)
			PRINTFORML
			CFLAG:607 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：輪姦イベント
		;奉仕する側
		;PLAYERに実行者=輪姦する悪魔の番号が入っています
		;-------------------------------------------------
	CASE 85
		CALL EVENT_MESSAGE
		IF     (CFLAG:608 < 1 || FLAG:7 == 2)
			PRINTFORML
			CFLAG:608 = 1
		ENDIF
	CASEELSE
		SIF     FLAG:6 > 0
			CALL EVENT_MESSAGE
ENDSELECT



