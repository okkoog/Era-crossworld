@KOJO_BATTLE_EVENT_K[[キャラ:메데이아릴리]], ARG, ARG:1, ARG:2
;■台詞の行数を増やしたいときは
;			LOCALS:10 = 一行目
;			LOCALS:11 = 二行目
;			LOCALS:12 = 三行目
;			LOCALS:13 = 四行目
;			LOCALS:14 = 五行目
;と増やしていく
SIF ARG < 0 && NO:ARG != 5093
	RETURN 0
VARSET LOCALS
VARSET KSTR

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 皆さん！　私のあとに！
			CASE 1
				BTL_KOJO_RESULTS:0 = チャンスですよ！
			CASE 2
				BTL_KOJO_RESULTS:0 = 続いてください！　せーのっ！
		ENDSELECT
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = はい！　続きます！
				CASE 1
					BTL_KOJO_RESULTS:0 = 行きますよー！
				CASE 2
					BTL_KOJO_RESULTS:0 = 流石です！
			ENDSELECT
		;それ以外
		ELSE
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 了解、行きますね！
			CASE 1
				BTL_KOJO_RESULTS:0 = 私にも任せてください！
			CASE 2
				BTL_KOJO_RESULTS:0 = 流石です！
			ENDSELECT
		ENDIF
	;被召喚時
	CASE 3
		SELECTCASE RAND:2
			CASE 0
				BTL_KOJO_RESULTS:0 = が、頑張ります！　ファイト！
			CASE 1
				BTL_KOJO_RESULTS:0 = 戦うのは苦手ですが、やらせて頂きます！
		ENDSELECT
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			SELECTCASE RAND:2
			CASE 0
				BTL_KOJO_RESULTS:0 = あれ？　死んじゃいました？
			CASE 1
				BTL_KOJO_RESULTS:0 = やった、やりました！
			ENDSELECT
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = あれ？　おかしいですね
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 手応え、アリです！
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = やれました！
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			BTL_KOJO_RESULTS:0 = うーん……固いですね
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = ……無効化！？
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = ごめん、なさい……皆さん、逃げて……
				CASE 1
					BTL_KOJO_RESULTS:0 = 私……怖い、です……
			ENDSELECT
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = きゃっ！
				CASE 1
					BTL_KOJO_RESULTS:0 = あっ！
			ENDSELECT
		;無効
		ELSEIF ARG:2 == 0
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = ふふ、効きませんよ
				CASE 1
					BTL_KOJO_RESULTS:0 = 無駄でしたね
			ENDSELECT
		;吸収
		ELSEIF ARG:2 < 0
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = ありがとうございます！
				CASE 1
					BTL_KOJO_RESULTS:0 = 頂き！　です！
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = きゃっ！
			CASE 1
				BTL_KOJO_RESULTS:0 = あっ！
			CASE 2
				BTL_KOJO_RESULTS:0 = きゃあっ！
			ENDSELECT
		ENDIF
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE 13
		;全弾命中した
		IF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = わっ、全部当たりました！
		;普通
		ELSEIF ARG:2 < ARG:1
			BTL_KOJO_RESULTS:0 = いい感じです
		;全弾回避された
		ELSEIF ARG:2 == ARG:1
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = えっ！？
			CASE 1
				BTL_KOJO_RESULTS:0 = すみません、外しちゃいました
			CASE 2
				BTL_KOJO_RESULTS:0 = ごめんなさい、ダメでした
			ENDSELECT
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE 14
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			LOCAL = RAND:3
			SELECTCASE LOCAL
			CASE 0
				BTL_KOJO_RESULTS:0 = 一掃しました！
			CASE 1
				BTL_KOJO_RESULTS:0 = 皆、倒れちゃいましたね
			CASE 2
				BTL_KOJO_RESULTS:0 = 全部、上手く出来ました！
			ENDSELECT
		ELSE
			BTL_KOJO_RESULTS:0 = いい感じです！
		ENDIF
	;反射された
	CASE 15
		BTL_KOJO_RESULTS:0 = うっ、反射ですか……
	;反射した
	CASE 16
		BTL_KOJO_RESULTS:0 = それ、効かないんです！
	;回避された
	CASE 17
		SELECTCASE RAND:3
		CASE 0
			BTL_KOJO_RESULTS:0 = あっ！　外しちゃいました……
		CASE 1
			BTL_KOJO_RESULTS:0 = あれっ？
		CASE 2
			BTL_KOJO_RESULTS:0 = 避けないでくださーい！
		ENDSELECT
	;回避した
	CASE 18
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = そのくらいなら、私でも余裕です！
			CASE 1
				BTL_KOJO_RESULTS:0 = 当たりませんよ
			CASE 2
				BTL_KOJO_RESULTS:0 = どこを見てるんですか？
		ENDSELECT
	;反撃スキル発動した
	CASE 20
			BTL_KOJO_RESULTS:0 = 今です！
	CASE 22
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				BTL_KOJO_RESULTS:0 = ああ……イアソン様……
			CASE "SHOCK"
				BTL_KOJO_RESULTS:0 = ビリビリ来ました！
			CASE "FREEZE"
				BTL_KOJO_RESULTS:0 = うっ……寒いです
			CASE "BIND", "PALYZE"
				BTL_KOJO_RESULTS:0 = か、体が動きません！
			CASE "PANIC"
				BTL_KOJO_RESULTS:0 = 魔力収束準備……
			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 = 急に意識、が……
			CASE "CLOSE"
				BTL_KOJO_RESULTS:0 = 魔力封じは反則ですよ！
			CASE "POISON"
				BTL_KOJO_RESULTS:0 = 毒なら自分で治せます！
			CASE "BOMB"
				BTL_KOJO_RESULTS:0 = 私、爆発しちゃうんですか！？
			CASE "CHARM"
				BTL_KOJO_RESULTS:0 = うっ、頭がもやもやして……
			CASE "CURSE"
				BTL_KOJO_RESULTS:0 = 呪いですか……嫌な思い出しかありません
			CASE "FLY"
				BTL_KOJO_RESULTS:0 = きゃっ！　えっ、私ハエですか！？
			CASE "STONE"
				BTL_KOJO_RESULTS:0 = …………(妙に様になったポーズで固まっている)
			CASE "FLAME"
				BTL_KOJO_RESULTS:0 = わっ、あつつつっ！
			CASE "SLIP"
				BTL_KOJO_RESULTS:0 = ちっ！　足元が……
			CASE "BRAND"
				BTL_KOJO_RESULTS:0 = こんな印……屈辱です
			;その他の状態異常
			;CASEELSE
		ENDSELECT
	;食いしばり等で耐えた
	CASE 23
		BTL_KOJO_RESULTS:0 = まだまだ、倒れるわけには行きません……！
	;バトルに勝利した
	CASE 90
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 良かった……皆さんがご無事で何よりです
			CASE 1
				BTL_KOJO_RESULTS:0 = みんな仲良し！
				BTL_KOJO_RESULTS:1 = 仲良しさんでいきましょう！
		ENDSELECT
	;レベルアップした
	CASE 91
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = はい！　お役に立てるようになりました！
			CASE 1
				BTL_KOJO_RESULTS:0 = 強くなりました！　見ていてくださいね
		ENDSELECT
	;逃走に成功した
	CASE 92
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 皆さん、ここは撤退しましょう！
			CASE 1
				BTL_KOJO_RESULTS:0 = 悔しいですけど、ここは逃げるのが……
			CASE 2
				BTL_KOJO_RESULTS:0 = ううっ……逃げますよー！
		ENDSELECT
	;逃走に失敗した
	CASE 93
			BTL_KOJO_RESULTS:0 = えっ、追いつかれた……！
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = うっ、まだ先の戦闘の傷が……
		ELSE
			BTL_KOJO_RESULTS:0 = 負けるわけには行きません！
		ENDIF
	;バックアタックを受けた
	CASE 95
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = ううっ、タイミングが悪いです！
		ELSE
			BTL_KOJO_RESULTS:0 = 皆さん！　態勢を整えましょう！
		ENDIF
	;敵の先制攻撃を受けた
	CASE 96
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = きゃっ！　まずは回復をしないと……
		ELSE
			BTL_KOJO_RESULTS:0 = うーん、敵ながら素早いですね
		ENDIF
	;先制攻撃に成功
	CASE 97
			BTL_KOJO_RESULTS:0 = 先制、頂きました！
	CASE 100
		IF 0
		;スキル分岐
		;ELSEIF CFLAG:(FLAG:행동순1):입력행동 == [[스킬:○○]]
		ELSE
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = 合わせます
				CASE 1
					BTL_KOJO_RESULTS:0 = はい！　やれます！
			ENDSELECT
		ENDIF
ENDSELECT
