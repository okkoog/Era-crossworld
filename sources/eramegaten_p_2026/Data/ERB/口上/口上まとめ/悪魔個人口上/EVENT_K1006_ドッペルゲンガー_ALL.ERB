;6.7.8.オパーイモミング
;一本化したけども。と言う感じ。たぶんそれぞれで書いた方がいい。
;基本手抜きなんで誰か。誰かお願い。
;-------------------------------------------------
@K_1006_OPAI_MOMINGU
	;初めて
	IF CFLAG:306 == 0 && CFLAG:307 == 0 && CFLAG:308 == 0 
		PRINTFORMW 「음、가슴、만져볼래？」
		PRINTFORMW 「괜찮아、즐기면 되니까」
	;二回目以降
	ELSE
		;陥落済み
		IF CFLAG:802 > 0
			;恋慕、親愛
			IF CFLAG:802 == 1
				PRINTFORMW 「……역시 조금、심경의 변화로 가치도 달라지네」
				PRINTFORMW 「만나서 다행이라고……해야하나」
			;淫乱、娼婦
			ELSEIF CFLAG:802 == 2
				PRINTFORMW 「음、흐……찌릿찌릿한 느낌은、아니지만……」
				PRINTFORMW 「꽤나、손이、크네……」
			;服従、隷属
			ELSEIF CFLAG:802 == 3
				PRINTFORMW 「만져서、재밌어？ ……그래、다행이네」
			ENDIF
		;未陥落
		ELSE
			;屈服刻印Lv3
			IF MARK:2 == 3
				PRINTFORMW 「%CSTR:일인칭% 적으로는、어차피 지방덩어리、뭐지」
				PRINTFORMW 「뭐、가치는 사람마다、다르겠지」
			;それ以外
			ELSE
				PRINTFORMW 「어서오세요、자유롭게、응」
			ENDIF
		ENDIF
	ENDIF




;-------------------------------------------------
;陥落関数
;CFLAG:802
;未陥落＝0
;恋慕系＝1
;淫乱系＝2
;服従系＝3
;-------------------------------------------------
@K_1006_FALLING_DOWN
	IF TALENT:연모 || TALENT:친애
		CFLAG:802 = 1
	ELSEIF TALENT:음란 || TALENT:창부
		CFLAG:802 = 2
	ELSEIF TALENT:복종 || TALENT:예속
		CFLAG:802 = 3
	;念のため。
	ELSE
		CFLAG:802 = 0
	ENDIF







;-------------------------------------------------
;性転換関数
;HALF：性転換（＋乳関連）
;FULL：体格など全て更新
;-------------------------------------------------
@K_1006_TRANS_SEXUAL_HALF
	IF TALENT:MASTER:남자 == 1
		TALENT:남자 = 0
		TALENT:처녀 = CFLAG:MASTER:원처녀
		TALENT:폭유 = 0
		TALENT:거유 = 0
		TALENT:빈유 = 0
		TALENT:절벽 = 0
		IF RAND:5 == 0
			TALENT:폭유 = 1
		ELSEIF RAND:4 == 0
			TALENT:거유 = 1
		ELSEIF RAND:3 == 0
			;普乳
		ELSEIF RAND:2 == 0
			TALENT:빈유 = 1
		ELSE
			TALENT:절벽 = 1
		ENDIF
	ELSE
		TALENT:남자 = 1
		TALENT:폭유 = 0
		TALENT:거유 = 0
		TALENT:빈유 = 0
		TALENT:절벽 = 0
	ENDIF
	;性転換経験＋１
	EXP:80 += 1




