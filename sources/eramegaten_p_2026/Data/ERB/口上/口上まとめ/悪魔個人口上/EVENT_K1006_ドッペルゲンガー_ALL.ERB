@K_1006_OKONOMI_COMAND
;実行したことがあるコマンドをべらーっと表示
;コマンド番号＋300＝CFLAG
;愛撫（コマンド番号0）＝CFLAG:300
;ただし500番台以降は＋100
;下記のように定義されているが、特別他で使うわけでもないので。
;　CFLAG:300～500 = 口上用、調教コマンド用フラグ
;　CFLAG:601～700 = 追加イベント用フラグ
;　CFLAG:701～799 = 予備領域
;　CFLAG:800～998 = 口上テンプレにおける自由領域

	;コマンド番号は0～606まで（派生など含む）
	FOR LOCAL:1, 0, 606
		;その番号のコマンドがある場合
		IF STRLENS(TRAINNAME:(LOCAL:1)) > 0
			;コマンドに対応するCFLAGを取得
			;500番台以降は＋100（212～499はコマンドがない＋CFLAGの関係上）
			IF LOCAL:1 >= 500
				LOCAL:2 = LOCAL:1 + 100
			ELSE
				LOCAL:2 = LOCAL:1 + 300
			ENDIF
			;CFLAGが1以上＝実行したことがある場合のみ
			SIF CFLAG:(LOCAL:2) > 0
				PRINTFORML %TRAINNAME:(LOCAL:1)%：{CFLAG:(LOCAL:2)}회
		ENDIF
		;最大実行回数を保存
		IF CFLAG:816 < CFLAG:(LOCAL:2)
			CFLAG:816 = CFLAG:(LOCAL:2)
			CFLAG:815 = LOCAL:1
		ENDIF
	NEXT






