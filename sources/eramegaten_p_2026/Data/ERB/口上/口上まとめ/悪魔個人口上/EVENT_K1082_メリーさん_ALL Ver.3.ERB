	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = 어、어쩔 수 없으니 도와줄게
		;それ以外
		ELSE
			BTL_KOJO_RESULTS:0 = 어、어쩔 수 없으니 도와줄게
		ENDIF
	;被召喚時
	CASE 3
		BTL_KOJO_RESULTS:0 = 우후후、맡겨줘!!
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = 
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			BTL_KOJO_RESULTS:0 = 
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = 
		;無効
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;反射された
	CASE 15
			BTL_KOJO_RESULTS:0 = 어、어라아?
	;反射した
	CASE 16
			BTL_KOJO_RESULTS:0 = 우후훗、바보 씨♪
	;回避された
	CASE 17
			BTL_KOJO_RESULTS:0 = 마、맞아주면 좋겠는데!
	;回避した
	CASE 18
			BTL_KOJO_RESULTS:0 = 그런 느린 공격、안 닿는다구우
	;反撃スキル発動した
	CASE 20
			BTL_KOJO_RESULTS:0 = 
	;バトルに勝利した
	CASE 90
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = %조사처리(CSTR:ARG:일인칭,"가")% 있으니까 당연하지이
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 흐흥♪ 당연한걸♪
		ELSE
			BTL_KOJO_RESULTS:0 = %CSTR:ARG:일인칭%들의 승리네에
		ENDIF
	;レベルアップした
	CASE 91
			BTL_KOJO_RESULTS:0 = 
	;逃走に成功した
	CASE 92
			BTL_KOJO_RESULTS:0 = 
	;逃走に失敗した
	CASE 93
			BTL_KOJO_RESULTS:0 = 
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 
		ELSE
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;バックアタックを受けた
	CASE 95
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 
		ELSE
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;敵の先制攻撃を受けた
	CASE 96
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 
		ELSE
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;先制攻撃に成功
	CASE 97
			BTL_KOJO_RESULTS:0 = 
ENDSELECT
