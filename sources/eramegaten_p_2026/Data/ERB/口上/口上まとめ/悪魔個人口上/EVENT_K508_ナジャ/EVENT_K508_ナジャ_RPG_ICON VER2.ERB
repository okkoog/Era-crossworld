			CASE "CHARM"
				BTL_KOJO_RESULTS:0 = う、うわぁ……素敵なおちんちん……っ
			;CASE "CURSE"
			;CASE "FLY"
			;CASE "STONE"
			CASE "FLAME"
				BTL_KOJO_RESULTS:0 = あつつっ、あつ！
			CASE "SLIP"
				BTL_KOJO_RESULTS:0 = うぇっひ！？　滑るぅ
			;CASE "BRAND"
			;その他の状態異常
			;CASEELSE
		ENDSELECT
	;食いしばり等で耐えた
	CASE 23
		;이악물기
