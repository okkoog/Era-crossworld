			BTL_KOJO_RESULTS:0 = 追い打ちしちゃおっと
		;それ以外
		ELSE
			BTL_KOJO_RESULTS:0 = 倒れた所にもう一度っ！
		ENDIF
	;被召喚時
	CASE 3
			BTL_KOJO_RESULTS:0 = えぇー？　バトルに喚び出し？
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;味方に攻撃した
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = じゃあねっ
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = あれっ、効いてない？
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 今のは効いてそう！
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = いい手応え！
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			BTL_KOJO_RESULTS:0 = うわ、弾かれるよりショックかも
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = えぇ～っ！？　全然効いてない！
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;味方に攻撃された
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = うぐぐ……もう、だめ
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = きゃああっ！？
		;無効
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = ……？　何かしたぁ？
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = ごちそうさまぁ
		;瀕死
		ELSEIF 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = し、死ぬ、死んじゃう……っ
		;ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			BTL_KOJO_RESULTS:0 = あうっ
		;小ダメージ
		ELSE
			BTL_KOJO_RESULTS:0 = いたっ
		ENDIF
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE 13
		;全弾命中した
		IF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = ストライクっ！
		;普通
		ELSEIF ARG:2 < ARG:1
			BTL_KOJO_RESULTS:0 = 次は全部当てるよ
		;全弾回避された
		ELSEIF ARG:2 == ARG:1
			BTL_KOJO_RESULTS:0 = あっ……あー……
		ENDIF
