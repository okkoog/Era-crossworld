	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE 14
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			BTL_KOJO_RESULTS:0 = 私も結構やるでしょ
		ELSE
			BTL_KOJO_RESULTS:0 = ふふんっ
		ENDIF
	;反射された
	CASE 15
			BTL_KOJO_RESULTS:0 = わっ！？
	;反射した
	CASE 16
			BTL_KOJO_RESULTS:0 = それは狙い目っ
	;回避された
	CASE 17
			BTL_KOJO_RESULTS:0 = あっ、このぉ！
	;回避した
	CASE 18
