@KOJO_BATTLE_EVENT_K[[キャラ:원반UFO]], ARG, ARG:1, ARG:2
SELECTCASE GET_BATTLE_EVENT(TFLAG:전투이벤트)
	;COOP発動 発動者の番号はARGに格納されている
	CASE "COOP発動"
		BTL_KOJO_RESULTS:0 = ジョコウ（助攻）　ヲ　ヨウセイ（要請）　シマス
	;COOP参加
	CASE "COOP参加"
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = サポートプログラム、キドウ
		;それ以外
		ELSE
			BTL_KOJO_RESULTS:0 = リョウカイ。ツイゲキ、カイシ
		ENDIF
	;被召喚時
	CASE "被召喚"
		BTL_KOJO_RESULTS:0 = セントウ（戦闘）システム、キドウ
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE "与ダメージ_単体"
		;味方に攻撃した
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = モクヒョウ、チンモク（沈黙）
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = データチクセキ（蓄積）
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = コウゲキコウカ　ダイ（攻撃効果、大）
		;ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = 
		;小ダメージ（１以上）
		ELSEIF ARG:2 > 0
			BTL_KOJO_RESULTS:0 = アマリ　コウカ　ナシ（あまり効果無し）
		;ダメージなし（無効・吸収を含む）
		ELSE
			BTL_KOJO_RESULTS:0 = ケイコク！　コウカ　ナシ（警告！攻撃効果無し）
		ENDIF
	;反射された
	CASE "反射された"
		BTL_KOJO_RESULTS:0 = ケイコク！　ハンシャタイセイ！（警告！反射耐性！）
	;回避された
	CASE "回避された"
		BTL_KOJO_RESULTS:0 = モクヒョウ　キドウセイ、ソウテイイジョウ（目標機動性、想定以上）
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE "被ダメージ_単体"
		;味方に攻撃された
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			BTL_KOJO_RESULTS:0 =  キノウ、テイシ
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 
		;瀕死
		ELSEIF 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = ダメージ、ジンダイ、エンゴモトム（ダメージ甚大、援護求む）
		;ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			BTL_KOJO_RESULTS:0 = 
		;小ダメージ
		ELSE
			BTL_KOJO_RESULTS:0 = ヒダン、キョウイドレベル　テイ（被弾、脅威度レベル低）
		ENDIF
	;無効化した
	CASE "無効化した"
		;吸収した
		IF GET_CREC_ACT(ARG:1, ARG, "DRAIN")
			BTL_KOJO_RESULTS:0 = イソウテンカン（位相転換）フィールド、キドウ
		;無効化した
		ELSE
			BTL_KOJO_RESULTS:0 = ………
		ENDIF
	;反射した
	CASE "反射した"
		BTL_KOJO_RESULTS:0 = 
	;回避した
	CASE "回避した"
		BTL_KOJO_RESULTS:0 = カイヒ　セイコウ
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE "与ダメージ_範囲_ランダム"
		;全弾命中した
		IF GET_CREC_ACT_SUM(ARG, "敵", "MISS/BLOCK/DRAIN/REFLECT") == 0
			;BTL_KOJO_RESULTS:0 = ゼンダンメイチュウ（全弾命中）
		;全弾回避された
		ELSEIF GET_CREC_ACT_SUM(ARG, "敵", "HIT") == 0
			BTL_KOJO_RESULTS:0 = 
		;普通
		ELSE
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE "与ダメージ_範囲_ランダム_撃破あり"
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			BTL_KOJO_RESULTS:0 = モクヒョウ　ノ　センメツ　ヲ　カクニン（目標の殲滅を確認）
		ELSE
			BTL_KOJO_RESULTS:0 = センメツ　センメツ　センメツ
		ENDIF
	;敵味方全体攻撃(詳細処理無し)
	;CASE "敵味方全体攻撃"
	;	BTL_KOJO_RESULTS:0 = 
	;反撃を発動した
	CASE "反撃発動"
		SELECTCASE TFLAG:발동연동스킬
			;例えば「ダッジカウンターが発動した場合」を指定したい場合は、スキル番号2484を指定する
			CASE [[스킬:닷지카운터]]
				BTL_KOJO_RESULTS:0 = ジドウゲイゲキ　カイシ（自動迎撃、開始）
			;その他
			CASEELSE
				BTL_KOJO_RESULTS:0 = ジドウゲイゲキ　カイシ（自動迎撃、開始）
		ENDSELECT
	;トリガースキルを発動した
	CASE "追撃発動"
		SELECTCASE TFLAG:발동연동스킬
			;スキルを指定したい場合、反撃と同様、対象スキルの番号をCASEに記載する
			;CASE (対象スキル番号)
			;	BTL_KOJO_RESULTS:0 = 
			;その他
			CASEELSE
				BTL_KOJO_RESULTS:0 = レンドウ（連動）シマス
		ENDSELECT
	;バッドステータスを受けた
	CASE "被バステ付着"
		;現在の状態で分岐
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				BTL_KOJO_RESULTS:0 = 
			CASE "SHOCK","FREEZE","BIND","PALYZE"
