			;CASE "CLOSE"
			CASE "POISON"
				BTL_KOJO_RESULTS:0 = ケイコク！　ＢＣヘイキ！（警告！ＢＣ兵器！）
			;CASE "BOMB"
			CASE "CHARM"
				BTL_KOJO_RESULTS:0 = ハッキング　サレツツアリ
			;CASE "CURSE"
			;CASE "FLY"
			;CASE "STONE"
			CASE "FLAME"
				BTL_KOJO_RESULTS:0 = ショウカシステム　フチョウ（消火システム不調）
			CASE "SLIP"
				BTL_KOJO_RESULTS:0 = ミチ　ノ　ショウガイ　ヲ　カンチ（未知の障害を感知）
			CASE "DYING"
				BTL_KOJO_RESULTS:0 = ケイコク！　ケイコク！　アストラルタイニ…（警告！警告！アストラル体に…）
			;CASE "BRAND"
			;その他の状態
			CASEELSE
				;DYING状態ではないがDYINGを受け、その行動で食いしばりが発動した。つまり即死を食いしばりした場合
				IF GET_STATE(CFLAG:ARG:상태이상) != "DYING" && GET_CREC_ACT(ARG:1, ARG, "BAD_STATE", "DYING") && CFLAG:ARG:이악물기발동
					BTL_KOJO_RESULTS:0 = ケイコク！　アストラルタイニ、チョクセツコウゲキ！（警告！アストラル体に、直接攻撃！）
				ENDIF
		ENDSELECT
	;食いしばり等で耐えた。バステで食いしばりした場合は被バステ付着の分岐に入るのでここには来ない
	CASE "이악물기발동"
		;이악물기
		IF BASE:ARG:ＨＰ == 1
			BTL_KOJO_RESULTS:0 = システム　サイキドウ（システム再起動）
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = コンナコトモ　アロウカト（こんな事もあろうかと）
		ENDIF
	;回復してもらった
	CASE "被回復"
		;ARG:2　回復量
		LOCAL = ARG:2 * 100 / BASE:ARG:ＨＰ
		;LOCAL　回復量割合
		IF 0
		;キャラ分岐（「特定の相手に回復してもらった」場合）
		;XXXXを対象のキャラ番号に置換して使う
		ELSEIF NO:(ARG:1) == 4999
			BTL_KOJO_RESULTS:0 = カンシャ（感謝）シマス
		;50%以上 & HPほぼ満タン
		ELSEIF LOCAL > 50 && 現HP割合(ARG) > 90
			BTL_KOJO_RESULTS:0 = システム　オールグリーン！
		;50%以上
		ELSEIF LOCAL > 50
			BTL_KOJO_RESULTS:0 = コンディション　オレンジ
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = ジョウキョウ　サイカクニン　セヨ（状況再確認せよ）
		ENDIF
	;状態異常を直してもらった
	CASE "被バステ治癒"
		;ARG:2　直ったバステ
		IF 0
		;キャラ分岐（「特定の相手に回復してもらった」場合）
		;ELSEIF NO:(ARG:1) == XXXX
		ELSE
			SELECTCASE GET_STATE(ARG:2)
				CASE "SLEEP"
					BTL_KOJO_RESULTS:0 = システム　サイキドウ（再起動）
				;その他の状態異常
				CASEELSE
					BTL_KOJO_RESULTS:0 = ジョウキョウカイゼン（状況改善）
			ENDSELECT
		ENDIF
;	;戦闘中イって行動不能にならず耐えた(ムフフ展開時のみ)
;	CASE "戦闘中イって行動不能にならず耐えた"
;		;歯を食いしばって快楽に耐えた
;		BTL_KOJO_RESULTS:0 = 
;	;行動中イって行動不能になった(ムフフ展開時のみ 50%の確率でHAPPYに)
;	CASE "行動中イって行動不能になった"
