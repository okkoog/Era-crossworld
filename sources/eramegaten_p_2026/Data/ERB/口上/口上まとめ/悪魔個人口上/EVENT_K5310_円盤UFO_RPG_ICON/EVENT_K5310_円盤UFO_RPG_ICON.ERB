;				BTL_KOJO_RESULTS:0 = 
;			ELSEIF CFLAG:ARG:던전내발정용욕정치 > 10000
;				BTL_KOJO_RESULTS:0 = 
;			ELSEIF CFLAG:ARG:던전내발정용욕정치 > 5000
;				BTL_KOJO_RESULTS:0 = 
;			ENDIF
;			;書いた内容がピンク色で表示されるようにここで色設定をセット
;			FOR LOCAL, 0, VARSIZE("BTL_KOJO_RESULTS")
;				SIF BTL_KOJO_RESULTS:LOCAL != ""
;					BTL_KOJO_RESULTS:LOCAL = %SET_COLOR_TAG(BTL_KOJO_RESULTS:LOCAL, "pink")%
;			NEXT
;		ENDIF
		;状態異常継続中
		IF BTL_KOJO_RESULTS:0 == "" && KSTR:0 == ""
			SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
				CASE "GOOD"
				CASE "SLEEP"
					BTL_KOJO_RESULTS:0 = ………
				;その他の状態異常
				CASEELSE
					BTL_KOJO_RESULTS:0 = ケイコク！　ケイコク！　ケイコク！
			ENDSELECT
		ENDIF
		;残りHP関連
		IF BTL_KOJO_RESULTS:0 == "" && KSTR:0 == ""
			IF 0
			;HP20%以下
			ELSEIF 現HP割合(ARG) < 20
				BTL_KOJO_RESULTS:0 = ケイコク！　キンキュウシュウリヨウセイ！（緊急修理要請！）
			;HP50%以下
			ELSEIF 現HP割合(ARG) < 50
				BTL_KOJO_RESULTS:0 = シュウフクノヒツヨウセイアリ！（修復の必要性有り）
			ENDIF
		ENDIF
	;ターン終了時ORGYがHEATになった(機械の乙女専用)
	;CASE "HEAT移行"
