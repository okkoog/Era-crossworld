;		;絶頂の余韻に浸っている
;		BTL_KOJO_RESULTS:0 = 
	;ターン終了時状態異常が自然回復した
	CASE "バステ自然回復"
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 = システム　サイキドウ（再起動）
			;その他の状態異常
			CASEELSE
				BTL_KOJO_RESULTS:0 = ダメージコントロール　セイコウ（成功）
		ENDSELECT
	;ターン終了時今の状態による口上
	CASE "ターン終了時口上"
;		;ムフフ展開系
