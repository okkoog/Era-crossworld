ENDSELECT

;-------------------------------------------------
;スキル発動時の口上
;-------------------------------------------------
@KOJO_BATTLE_MESSAGE_K[[キャラ:미노타우로스]],ARG,ARG:1 = 0
;コメントアウトしやすいようにここでIFを消費
IF 1 == 0
;-------------------------------------------------
;状態異常時
;-------------------------------------------------
;魅了時
ELSEIF IS_BADSTATE(ARG, "CHARM")
	;行動不能（ムラムラしている）
	IF CFLAG:ARG:입력행동 == [[스킬:행동불능]]
		BTL_KOJO_RESULTS:0 = ぐふふふふ…
	ELSE
		BTL_KOJO_RESULTS:0 = むぉぉぉぉ
	ENDIF
;混乱時
ELSEIF IS_BADSTATE(ARG, "PANIC")
	;금전뿌리기
	IF CFLAG:ARG:입력행동 == [[스킬:금전뿌리기]]
		BTL_KOJO_RESULTS:0 = 
	;行動不能（ぼんやりしている）
	ELSEIF CFLAG:ARG:입력행동 == [[스킬:행동불능]]
		BTL_KOJO_RESULTS:0 = 
	ELSE
		BTL_KOJO_RESULTS:0 = 
	ENDIF
;幸福時の行動不能
