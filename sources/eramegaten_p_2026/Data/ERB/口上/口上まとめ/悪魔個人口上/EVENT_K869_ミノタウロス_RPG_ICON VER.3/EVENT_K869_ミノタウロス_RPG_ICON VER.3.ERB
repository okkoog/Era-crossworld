;-------------------------------------------------
;戦闘中のイベント関連
;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:미노타우로스]], ARG, ARG:1, ARG:2
SELECTCASE GET_BATTLE_EVENT(TFLAG:전투이벤트)
	;COOP発動 発動者の番号はARGに格納されている
	CASE "COOP発動"
		BTL_KOJO_RESULTS:0 = 
	;COOP参加
	CASE "COOP参加"
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = 手伝ってやろうっ！
		;それ以外
		ELSE
			BTL_KOJO_RESULTS:0 = これも喰らっておけっ！
		ENDIF
	;被召喚時
	CASE "被召喚"
		BTL_KOJO_RESULTS:0 = 我が力を欲するか！　正しい選択だっ！
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE "与ダメージ_単体"
		;味方に攻撃した
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = たわいもないっ
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = オォォォォォォッ！！！
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 喰らうが良いっ！　ォォォォォ！
		;ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = ブモォォォォォ！
		;小ダメージ（１以上）
		ELSEIF ARG:2 > 0
			BTL_KOJO_RESULTS:0 = ヌゥンッ！
		;ダメージなし（無効・吸収を含む）
		ELSE
			BTL_KOJO_RESULTS:0 = ムゥ！？
		ENDIF
	;反射された
	CASE "反射された"
		BTL_KOJO_RESULTS:0 = ヌォ！？
	;回避された
	CASE "回避された"
		BTL_KOJO_RESULTS:0 = コザカシイっ！
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE "被ダメージ_単体"
		;味方に攻撃された
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = やりおるっ！　今宵は貴様に、華を持たせてやるっ！
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = ぬぐぉっ！？
		;瀕死
		ELSEIF 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = ぐぁっ！？　馬鹿なっ！？
		;ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			BTL_KOJO_RESULTS:0 = やりおるわっ！
		;小ダメージ
		ELSE
			BTL_KOJO_RESULTS:0 = この程度かっ！
		ENDIF
	;無効化した
	CASE "無効化した"
		;吸収した
		IF GET_CREC_ACT(ARG:1, ARG, "DRAIN")
			BTL_KOJO_RESULTS:0 = フハハハハっ！　我に力を与えるとはなっ！
		;無効化した
		ELSE
			BTL_KOJO_RESULTS:0 = フハハハ！　そんなもの、効かぬわ！
		ENDIF
	;反射した
	CASE "反射した"
		BTL_KOJO_RESULTS:0 = 愚か者めっ！
	;回避した
	CASE "回避した"
		BTL_KOJO_RESULTS:0 = そんなもの、当たらぬわっ！
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE "与ダメージ_範囲_ランダム"
		;全弾命中した
		IF GET_CREC_ACT_SUM(ARG, "敵", "MISS/BLOCK/DRAIN/REFLECT") == 0
			;BTL_KOJO_RESULTS:0 = どいつもこいつも、おそい、遅いわっ！
		;全弾回避された
		ELSEIF GET_CREC_ACT_SUM(ARG, "敵", "HIT") == 0
			BTL_KOJO_RESULTS:0 = 何だとっ！？
		;普通
		ELSE
			BTL_KOJO_RESULTS:0 = まとめて叩き潰すっ！
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE "与ダメージ_範囲_ランダム_撃破あり"
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			BTL_KOJO_RESULTS:0 = フハハハッ！　たわいもないっ！
		ELSE
			BTL_KOJO_RESULTS:0 = フハハハッ！
		ENDIF
	;敵味方全体攻撃(詳細処理無し)
	;CASE "敵味方全体攻撃"
	;	BTL_KOJO_RESULTS:0 = 
	;反撃を発動した
	CASE "反撃発動"
		SELECTCASE TFLAG:발동연동스킬
			;例えば「ダッジカウンターが発動した場合」を指定したい場合は、スキル番号2484を指定する
			CASE [[스킬:닷지카운터]]
				BTL_KOJO_RESULTS:0 = フゥンッ
			;その他
			CASEELSE
				BTL_KOJO_RESULTS:0 = 返すぞっ！
		ENDSELECT
	;トリガースキルを発動した
	CASE "追撃発動"
		SELECTCASE TFLAG:발동연동스킬
			;スキルを指定したい場合、反撃と同様、対象スキルの番号をCASEに記載する
			;CASE (対象スキル番号)
			;	BTL_KOJO_RESULTS:0 = 
			;その他
			CASEELSE
				BTL_KOJO_RESULTS:0 = これも追加だ！
		ENDSELECT
	;バッドステータスを受けた
	CASE "被バステ付着"
		;現在の状態で分岐
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				BTL_KOJO_RESULTS:0 = 
			CASE "SHOCK","FREEZE","BIND","PALYZE"
				BTL_KOJO_RESULTS:0 = 何っ！？　身体が…動かんっ！？
			CASE "PANIC"
				BTL_KOJO_RESULTS:0 = ぬぅっ！？　何が起こっている！？
			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 = ｚｚｚＺ…
			;CASE "CLOSE"
			CASE "POISON"
				BTL_KOJO_RESULTS:0 = 毒だとっ！　ふざけおってっ！
			;CASE "BOMB"
			CASE "CHARM"
				BTL_KOJO_RESULTS:0 = ブモォォォォォォォッ
			;CASE "CURSE"
			;CASE "FLY"
			;CASE "STONE"
			CASE "FLAME"
				BTL_KOJO_RESULTS:0 = ぐぉぉぉ！？
			CASE "SLIP"
				BTL_KOJO_RESULTS:0 = 小賢しい真似をっ！
			CASE "DYING"
				BTL_KOJO_RESULTS:0 = バカなっ！？
			;CASE "BRAND"
			;その他の状態
			CASEELSE
				;DYING状態ではないがDYINGを受け、その行動で食いしばりが発動した。つまり即死を食いしばりした場合
				IF GET_STATE(CFLAG:ARG:상태이상) != "DYING" && GET_CREC_ACT(ARG:1, ARG, "BAD_STATE", "DYING") && CFLAG:ARG:이악물기발동
					BTL_KOJO_RESULTS:0 = 倒れぬっ！　まだ倒れぬわっ！
				ENDIF
		ENDSELECT
	;食いしばり等で耐えた。バステで食いしばりした場合は被バステ付着の分岐に入るのでここには来ない
	CASE "이악물기발동"
		;이악물기
		IF BASE:ARG:ＨＰ == 1
			BTL_KOJO_RESULTS:0 = まだだっ！　まだ倒れぬわっ！
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 =  フハハハっ！　仕切り直しよなっ！
		ENDIF
	;回復してもらった
	CASE "被回復"
		;ARG:2　回復量
		LOCAL = ARG:2 * 100 / BASE:ARG:ＨＰ
		;LOCAL　回復量割合
		IF 0
		;キャラ分岐（「特定の相手に回復してもらった」場合）
		;XXXXを対象のキャラ番号に置換して使う
		;ELSEIF NO:(ARG:1) == XXXX
;			BTL_KOJO_RESULTS:0 = 
		;50%以上 & HPほぼ満タン
		ELSEIF LOCAL > 50 && 現HP割合(ARG) > 90
			BTL_KOJO_RESULTS:0 = 良いぞっ！
		;50%以上
		ELSEIF LOCAL > 50
			BTL_KOJO_RESULTS:0 = まだ足りぬっ！
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = もっとだ！
		ENDIF
	;状態異常を直してもらった
	CASE "被バステ治癒"
		;ARG:2　直ったバステ
		IF 0
		;キャラ分岐（「特定の相手に回復してもらった」場合）
		;ELSEIF NO:(ARG:1) == XXXX
		ELSE
			SELECTCASE GET_STATE(ARG:2)
				CASE "SLEEP"
					BTL_KOJO_RESULTS:0 = ぬぅっ！？　気を失っていただと！？
				;その他の状態異常
				CASEELSE
					BTL_KOJO_RESULTS:0 = 中々良いぞっ！
			ENDSELECT
		ENDIF
	;戦闘中イって行動不能にならず耐えた(ムフフ展開時のみ)
	CASE "戦闘中イって行動不能にならず耐えた"
		;歯を食いしばって快楽に耐えた
		BTL_KOJO_RESULTS:0 = グォォォォ！？
	;行動中イって行動不能になった(ムフフ展開時のみ 50%の確率でHAPPYに)
	CASE "行動中イって行動不能になった"
		;IS_BADSTATE(ARG, "HAPPY")
		
		;絶頂の余韻に浸っている
		BTL_KOJO_RESULTS:0 = フゥゥ…
	;ターン終了時状態異常が自然回復した
	CASE "バステ自然回復"
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 =  ぬぅっ！？　気を失っていただと！？
			;その他の状態異常
			CASEELSE
				BTL_KOJO_RESULTS:0 = 何時までも効くと思うなよっ！
		ENDSELECT
	;ターン終了時今の状態による口上
	CASE "ターン終了時口上"
;		;ムフフ展開系
;		IF FLAG:무후후전개 && (BATTLE_H_EVENT_PRO(ARG) > 30 || CFLAG:ARG:던전내발정용욕정치 > 5000) && !RAND:2
;			;BATTLE_H_EVENT_PRO(ARG)…戦闘中イく確率
;			IF     BATTLE_H_EVENT_PRO(ARG) > 80
;				BTL_KOJO_RESULTS:0 = 
;			ELSEIF BATTLE_H_EVENT_PRO(ARG) > 50
;				BTL_KOJO_RESULTS:0 = 
;			ELSEIF BATTLE_H_EVENT_PRO(ARG) > 30
;				BTL_KOJO_RESULTS:0 = 
;			ELSEIF CFLAG:ARG:던전내발정용욕정치 > 10000
;				BTL_KOJO_RESULTS:0 = 
;			ELSEIF CFLAG:ARG:던전내발정용욕정치 > 5000
;				BTL_KOJO_RESULTS:0 = 
;			ENDIF
;			;書いた内容がピンク色で表示されるようにここで色設定をセット
;			FOR LOCAL, 0, VARSIZE("BTL_KOJO_RESULTS")
;				SIF BTL_KOJO_RESULTS:LOCAL != ""
;					BTL_KOJO_RESULTS:LOCAL = %SET_COLOR_TAG(BTL_KOJO_RESULTS:LOCAL, "pink")%
;			NEXT
;		ENDIF
		;状態異常継続中
		IF BTL_KOJO_RESULTS:0 == "" && KSTR:0 == ""
			SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
				CASE "GOOD"
				CASE "SLEEP"
					BTL_KOJO_RESULTS:0 = ｚｚＺ…
				;その他の状態異常
				CASEELSE
					BTL_KOJO_RESULTS:0 = えぇいっ！　さっさと治療せぬかっ！
			ENDSELECT
		ENDIF
		;残りHP関連
		IF BTL_KOJO_RESULTS:0 == "" && KSTR:0 == ""
			IF 0
			;HP20%以下
			ELSEIF 現HP割合(ARG) < 20
				BTL_KOJO_RESULTS:0 = ここまで押されるとはなっ！？
			;HP50%以下
			ELSEIF 現HP割合(ARG) < 50
				BTL_KOJO_RESULTS:0 = 楽しませてくれるっ！　闘いはここからよっ！
			ENDIF
		ENDIF
	;ターン終了時ORGYがHEATになった(機械の乙女専用)
	;CASE "HEAT移行"
	;	BTL_KOJO_RESULTS:0 = 
	;ターン終了時エクスリンケージ装備時のイベント口上(ムフフ展開時のみ)
	CASE "ターン終了時エクスリンケージ装備時のイベント口上"
		;発情によってHAPPYになった
		IF CFLAG:ARG:던전내발정 == 1 && IS_BADSTATE(ARG, "HAPPY")
			BTL_KOJO_RESULTS:0 = 
		;頭の中がピンクに染まった
		ELSEIF CFLAG:ARG:던전내발정 == 1
			BTL_KOJO_RESULTS:0 = 
		;落ち着いた
		ELSEIF CFLAG:ARG:던전내발정 == 0
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;ターン終了時エクスリンケージ装備時のイベント口上2(ムフフ展開時のみ)
	CASE "ターン終了時エクスリンケージ装備時のイベント口上2"
		;中に注がれた精液が垂れてきた…
		BTL_KOJO_RESULTS:0 = 
	;バトルに勝利した
	CASE "戦闘勝利"
		BTL_KOJO_RESULTS:0 = フハハハハっ！　たわいもないっ
	;レベルアップした
	CASE "レベルアップ"
		BTL_KOJO_RESULTS:0 = ぐははははっ！　力がみなぎってきたわっ！
	;逃走に成功した
	CASE "逃走成功"
		BTL_KOJO_RESULTS:0 = 
	;逃走に失敗した
	CASE "逃走失敗"
		BTL_KOJO_RESULTS:0 = 逃げるのは性に合わぬっ！
	;戦闘開始時
	CASE "戦闘開始時"
		;瀕死
		IF 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = 何をしているっ！　さっさと治療せぬかっ！
		ELSE
			BTL_KOJO_RESULTS:0 = また我に蹴散らされに来おったわ
		ENDIF
	;先制攻撃に成功
	CASE "先制攻撃"
		BTL_KOJO_RESULTS:0 = 油断しすぎていたようだなっ！
	;バックアタックを受けた
	CASE "バックアタック"
		;瀕死
		IF 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = こんな時に…忌々しい真似をっ！
		ELSE
			BTL_KOJO_RESULTS:0 = 背後から不意打ちとは…小賢しい真似をっ！
		ENDIF
	;敵の先制攻撃を受けた
	CASE "不意打ち"
		;瀕死
		IF 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = 
		ELSE
			BTL_KOJO_RESULTS:0 = ぬぅっ！？　不意打ちだとっ！？
		ENDIF
	;バックアタックを百太郎で阻止した
	CASE "バックアタック阻止"
		;瀕死
		IF 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = 
		ELSE
			BTL_KOJO_RESULTS:0 = 愚か者めがっ！　背後からなら不意を突けると思ったかっ？
		ENDIF
	;敵の先制攻撃を百太郎で阻止した
	CASE "不意打ち阻止"
		;瀕死
		IF 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = 
		ELSE
			BTL_KOJO_RESULTS:0 = 呆けるなっ！　敵が来るぞっ
		ENDIF
	;リンケージに参加した
	CASE "링케이지참가"
		IF 0
		;スキル分岐
		;ELSEIF CFLAG:(FLAG:행동순1):입력행동 == [[스킬:○○]]
		
