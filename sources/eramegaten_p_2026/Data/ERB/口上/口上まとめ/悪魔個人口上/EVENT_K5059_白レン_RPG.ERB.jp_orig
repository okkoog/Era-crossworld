;-------------------------------------------------
;白レン戦闘口上
;テンプレより作成。ライセンスフリー
;-------------------------------------------------
;
;

;-------------------------------------------------
;■台詞の行数を増やしたいときは
;			LOCAL:1 = 行数
;			LOCALS = 一行目
;			LOCALS:1 = 二行目
;			LOCALS:2 = 三行目
;と増やしていく
;-------------------------------------------------

;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:하얀렌]], ARG, ARG:1, ARG:2
;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 5059
	RETURN 0
LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = EMPTY

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 그럼, 여러분도 왈츠를！
		ELSE
			BTL_KOJO_RESULTS:0 = 자, 여러분。같이 즐기자구요！
		ENDIF
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			;연모
			IF TALENT:3 || TALENT:6
				BTL_KOJO_RESULTS:0 = …글쎄 신뢰받고 있는 한, 힘이 되어 줄게
			ELSE
				BTL_KOJO_RESULTS:0 = 어머, 솔선해주니 몸둘바를 모르겠네？
			ENDIF
		;それ以外
		ELSE
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 어머, 나도 끼워주지 않을래？
			ELSE
				BTL_KOJO_RESULTS:0 = 나는 가혹하다구？
			ENDIF
		ENDIF
	;被召喚時
	CASE 3
			BTL_KOJO_RESULTS:0 = 招待状は確かに受け取りましたわ。さあ、舞踏会を始めましょう
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 그럼, 안녕히。
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 뭐야、더 이상 물러설 곳이 없다고、그렇게 움츠러드는거니？
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
;		;大ダメージ
;		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
;			BTL_KOJO_RESULTS:0 = 
;		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
;			BTL_KOJO_RESULTS:0 = 
;		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
;			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = （어떤一한 수가、악수였던걸까?――）
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = 꺄앗！　쿠으、제법 난폭하네…！
		;無効
		ELSEIF ARG:2 == 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 어라、그것뿐？
			ELSE
				BTL_KOJO_RESULTS:0 = 안됐네, 그 공격은 통하지 않거든
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = 잘 먹었습니다。자、계속하자구？
		ENDIF
	;反射された
	CASE 15
			BTL_KOJO_RESULTS:0 = 뭐、뭐라고오…！？
	;反射した
	CASE 16
			BTL_KOJO_RESULTS:0 = 후후…　자기가 날린 공격의 맛은 어때？
	;回避された
	CASE 17
			BTL_KOJO_RESULTS:0 = …어라라？
	;回避した
	CASE 18
			BTL_KOJO_RESULTS:0 = 나와 한 번 춤춰볼래？
ENDSELECT
;SIF LOCALS != "EMPTY"
;	CALL MESSAGE_BL(LOCAL:1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)

;-------------------------------------------------
@KOJO_BATTLE_MESSAGE_K[[キャラ:하얀렌]],ARG,ARG:1 = 0
;-------------------------------------------------

LOCAL:1 = 1
;231227:EMPTYと喋っていたケースの対処
;BTL_KOJO_RESULTS:0 = "EMPTY"

;崩壊してる場合は口上表示しない
SIF TALENT:ARG:9
	RETURN 0

CALL GET_SKILL_PROP, "SKILL_EFECT", CFLAG:ARG:입력행동, ARG
;-------------------------------------------------
;特定スキル
;-------------------------------------------------
;これは通常攻撃
IF CFLAG:ARG:입력행동 == 0
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 후후…
		ELSEIF !RAND:2
			BTL_KOJO_RESULTS:0 = 어때？
		ELSE
			BTL_KOJO_RESULTS:0 = un…　deux！
		ENDIF
;-------------------------------------------------
;ＣＨＡＮＧＥ
;-------------------------------------------------
;ELSEIF LOCAL == 2301
;	BTL_KOJO_RESULTS:0 = 
;-------------------------------------------------
;汎用スキル
;-------------------------------------------------
;검격
ELSEIF RANGE(CFLAG:ARG:입력행동,1, 99)
	BTL_KOJO_RESULTS:0 = 뽑아들면 번쩍이는 서슬 퍼런 칼날。부디 즐겨주시길
;비구
ELSEIF RANGE(CFLAG:ARG:입력행동,101, 199)
	BTL_KOJO_RESULTS:0 = 찾～았다♪
;타격
ELSEIF RANGE(CFLAG:ARG:입력행동,201, 299)
	BTL_KOJO_RESULTS:0 = 더 부드럽게！
;噛み付き系
ELSEIF RANGE(CFLAG:ARG:입력행동,321, 326)
	IF RAND:3 == 0
		LOCAL:1 = 2
		BTL_KOJO_RESULTS:0 = 이、이몸、은…　
		BTL_KOJO_RESULTS:0:1 = 아、아무리 계약이라도 이런 색다른 전개의 대사는 싫어！
	ELSEIF !RAND:2
		BTL_KOJO_RESULTS:0 = …장난이 너무 지나치면、기르고 있던 고양이에게 물릴 수도 있다고요？
	ELSE
		BTL_KOJO_RESULTS:0 = 흡혈귀의 흉내는、취미가 아니지만 말이지
	ENDIF
;회복
ELSEIF RANGE(CFLAG:ARG:입력행동,401, 499)
;	;全体回復
;	IF CFLAG:ARG:타겟 > 6
;		BTL_KOJO_RESULTS:0 = 
;	ELSE
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 내가 치료해 드리는 것이기 때문에, 조금은 감사하세요
		ELSE
			BTL_KOJO_RESULTS:0 = 자、일어서요。커튼콜은 아직 이르다고요
		ENDIF
;	ENDIF
;지원
ELSEIF RANGE(CFLAG:ARG:입력행동,501, 599)
	;強化系
	IF RANGE(CFLAG:ARG:입력행동,501, 505)
		BTL_KOJO_RESULTS:0 = 고작 몇분밖에 남지 않았지만、이거라면！
	;弱体系
	ELSEIF RANGE(CFLAG:ARG:입력행동,506, 509)
		BTL_KOJO_RESULTS:0 = 여유부리고 있네요？　하지만、그것도 여기까지야
	;도발
	ELSEIF CFLAG:ARG:입력행동 == 515
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 에、뭐어？ 그딴 몰골을 하고 있는 주제에 자신이 강하다고 착각하고 있는거니？
		ELSE
			BTL_KOJO_RESULTS:0 = 빨랑 사라지세요、이 못생긴 고양이가！
		ENDIF
	;その他
	ELSE
;		BTL_KOJO_RESULTS:0 = 
	ENDIF
;;방어
;ELSEIF RANGE(CFLAG:ARG:입력행동,601, 699)
;	BTL_KOJO_RESULTS:0 = 
;화염
ELSEIF RANGE(CFLAG:ARG:입력행동,701, 799)
	BTL_KOJO_RESULTS:0 = 火遊びに興味はおありかしら？
;빙결
ELSEIF RANGE(CFLAG:ARG:입력행동,801, 899)
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 얼음왕관이라도 만들어줄까
	ELSEIF !RAND:2
		BTL_KOJO_RESULTS:0 = un…　deux…　trois！！
	ELSE
		BTL_KOJO_RESULTS:0 = 눈길에는 조심하세요, 천랑에게 따라 잡아져버려요？
	ENDIF
;;전격
;ELSEIF RANGE(CFLAG:ARG:입력행동,901, 999)
;	BTL_KOJO_RESULTS:0 = 
