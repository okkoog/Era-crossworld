;;魔法少女系
ELSEIF RANGE(CFLAG:ARG:입력행동,2989, 2999)
;せいゆうねた
	IF CFLAG:ARG:입력행동 == 2997
		BTL_KOJO_RESULTS:0 = Tiro―――　Finale！！
	ELSE
;		BTL_KOJO_RESULTS:0 = 
	ENDIF

;-------------------------------------------------
;リンケージ
;-------------------------------------------------
;메시아라이저
ELSEIF CFLAG:ARG:입력행동 == 4160
	LOCAL:1 = 2
	BTL_KOJO_RESULTS:0 = 힘을 빌려줘도 괜찮아요。사역마와 마스터는 일심동체라고 하잖아요? 
