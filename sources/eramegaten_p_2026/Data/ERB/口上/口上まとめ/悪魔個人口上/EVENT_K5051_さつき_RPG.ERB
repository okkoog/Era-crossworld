@KOJO_BATTLE_EVENT_K[[キャラ:사츠키]], ARG, ARG:1, ARG:2
;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 5051
	RETURN 0
LOCAL:1 = 1
;BTL_KOJO_RESULTS:0 = EMPTY

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:2
			BTL_KOJO_RESULTS:0 = 좋~아！　모두들、해치웠어！
		ELSE
			BTL_KOJO_RESULTS:0 = 응、컨디션 좋고、만사 오케이♪
		ENDIF
		
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = 응。점점 연계에 익숙해져가는、걸까나？
		;それ以外
		ELSE
		IF RAND:2
				BTL_KOJO_RESULTS:0 = 네ー에、맡겼어요！
			ELSE
				BTL_KOJO_RESULTS:0 = 여기 사람들은 모두 굉장하네。나도 열심히 해야겠다。
			ENDIF
		ENDIF
	;被召喚時
	CASE 3
			BTL_KOJO_RESULTS:0 = 아ー아、이런 극적인 모험도 익숙해졌어…
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 후으、어떻게든 됐네。
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 후후、왜 그러니？　방어만 하고 있다간 죽는다구우？
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
;		;大ダメージ
;		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
;			BTL_KOJO_RESULTS:0 = 
;		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
;			BTL_KOJO_RESULTS:0 = 
;		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
;			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 미안-해…
			ELSE
				BTL_KOJO_RESULTS:0 = （아――――）
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF RAND:2
				BTL_KOJO_RESULTS:0 = 꺄아아아아！？
			ELSE
				BTL_KOJO_RESULTS:0 = 우우、절대 괜찮지 않아…
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 안 통한다니깐！
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = 와와와！　회복시켜 준 건 절대 아닌거지…?
		ENDIF
	;反射された
	CASE 15
			BTL_KOJO_RESULTS:0 = 에―――에에에！？
	;反射した
	CASE 16
			BTL_KOJO_RESULTS:0 = 학습능력이 없는거야? 당신、과거에 내가 그랬던 것 이상으로 멍청이네!
	;回避された
	CASE 17
			BTL_KOJO_RESULTS:0 = 어라아？
	;回避した
	CASE 18
			BTL_KOJO_RESULTS:0 = 이래뵈도、나는 몇 년에 한 번 나올까말까 하는 일재(逸材)라고 했잖아！
ENDSELECT
;SIF LOCALS != "EMPTY"
;	CALL MESSAGE_BL(LOCAL:1, LOCALS, LOCALS:1, LOCALS:2, LOCALS:3, LOCALS:4)

