;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:파누엘]], ARG, ARG:1, ARG:2
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 行きますよ、みなさん！
			CASE 1
				BTL_KOJO_RESULTS:0 = 今です！　追撃を！
			CASE 2
				BTL_KOJO_RESULTS:0 = 今の%CSTR:일인칭%は、一人ではありません……！
		ENDSELECT
	;COOP参加
	CASE 2
		IF FLAG:행동순1 != -1
			IF FLAG:행동순1 == MASTER
				;主人がCOOP発動
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = %CSTR:이인칭%に続きます！
					CASE 1
						BTL_KOJO_RESULTS:0 = %CSTR:이인칭%に、天使の力を！
					CASE 2
						BTL_KOJO_RESULTS:0 = %CSTR:이인칭%の作った機会、無駄にはしません！
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = %CSTR:일인칭%も続きます！
					CASE 1
						BTL_KOJO_RESULTS:0 = 共に行きましょう！
					CASE 2
						BTL_KOJO_RESULTS:0 = 神よ、どうか%CSTR:일인칭%に力を……！
				ENDSELECT
			ENDIF
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 撃破しました！
				CASE 1
					BTL_KOJO_RESULTS:0 = 次、ありますか！？
				CASE 2
					BTL_KOJO_RESULTS:0 = 倒しました！
			ENDSELECT
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = 守りが崩せませんね……
					CASE 1
						BTL_KOJO_RESULTS:0 = ！？　固い……！
					CASE 2
						BTL_KOJO_RESULTS:0 = 一筋縄ではいきませんね……！
				ENDSELECT
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = あと少しです！
				CASE 1
					BTL_KOJO_RESULTS:0 = 命中しました！
				CASE 2
					BTL_KOJO_RESULTS:0 = 手ごたえ、ありです！
			ENDSELECT
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 効いています！
				CASE 1
					BTL_KOJO_RESULTS:0 = 命中しました！
				CASE 2
					BTL_KOJO_RESULTS:0 = ダメージが蓄積しています！
			ENDSELECT
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 浅い……！
				CASE 1
					BTL_KOJO_RESULTS:0 = 命中しました！
				CASE 2
					BTL_KOJO_RESULTS:0 = あまり有効ではないようですね……
			ENDSELECT
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 無効化された……！
				CASE 1
					BTL_KOJO_RESULTS:0 = 一手、防がれました！
				CASE 2
					BTL_KOJO_RESULTS:0 = 手ごたえ無し、厄介ですね……
			ENDSELECT
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = ああ、神よ……
				CASE 1
					BTL_KOJO_RESULTS:0 = %CSTR:이인칭%……まだ、恩を……返せていない、のに……
				CASE 2
					BTL_KOJO_RESULTS:0 = すみません……後を、頼みます……
			ENDSELECT
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = くぅぅっ！
				CASE 1
					BTL_KOJO_RESULTS:0 = ま、まだ戦えます……！
				CASE 2
					BTL_KOJO_RESULTS:0 = ここで倒れるわけには……！
			ENDSELECT
		;無効
		ELSEIF ARG:2 == 0
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 無駄です！
				CASE 1
					BTL_KOJO_RESULTS:0 = 神の加護の前には通じません！
				CASE 2
					BTL_KOJO_RESULTS:0 = そのような攻撃など！
