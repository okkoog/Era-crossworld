			SELECTCASE RAND:4
				CASE 0
					BTL_KOJO_RESULTS:0 = くっ！
				CASE 1
					BTL_KOJO_RESULTS:0 = 捉えられましたか……！
				CASE 2
					BTL_KOJO_RESULTS:0 = 躱し切れませんか……！
