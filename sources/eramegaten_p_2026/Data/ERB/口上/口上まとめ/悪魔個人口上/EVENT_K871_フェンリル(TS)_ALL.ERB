ENDIF

@KOJO_BATTLE_EVENT_K[[キャラ:펜리르]]_1, ARG, ARG:1, ARG:2

;-------------------------------------------------
;○味方パーティでのデビルＣＯ－ＯＰ発動時の台詞
;-------------------------------------------------
IF TFLAG:전투이벤트 == 1
	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃%"後来！─！",72,LEFT%┃
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○味方パーティでのデビルＣＯ－ＯＰ参加時の台詞
;通常攻撃も喋るようになっていなければ喋らない
;-------------------------------------------------
IF TFLAG:전투이벤트 == 2
	PRINTFORML ┏＠%NAME:ARG,10,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
	IF RAND:2 == 0
		PRINTFORML ┃%"行、─！",72,LEFT%┃
	ELSE
		PRINTFORML ┃%"頑張읏！",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○味方パーティでの被召喚時の台詞
;-------------------------------------------------
IF TFLAG:전투이벤트 == 3
	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃%"、出撃！",72,LEFT%┃
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF



;-------------------------------------------------
;○攻撃系イベント口上
;-------------------------------------------------
IF TFLAG:전투이벤트 == 11
	;攻撃して撃破
	IF BASE:(ARG:1):ＨＰ <= 0
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"읏읏！、읏自慢─읏",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF
ENDIF

;-------------------------------------------------
;○被弾系口上
;-------------------------------------------------
IF TFLAG:전투이벤트 == 12
	;被弾（戦闘不能）
	IF BASE:ARG:ＨＰ <= 0
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"읏、읏…",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ELSEIF BASE:ARG:ＨＰ == 1
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"頑張…一度帰─！",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;残り50％未満
	ELSEIF 現HP割合(ARG) < 50
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		PRINTFORML ┃%"。읏良읏…",72,LEFT%┃
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	;通常被弾（発生確率1/5)
	ELSEIF RAND:5 == 0
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
		IF RAND:2 == 0
			PRINTFORML ┃%"？！　─",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"！　─",72,LEFT%┃
		ENDIF
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF
ENDIF

;-------------------------------------------------
;○外した
;-------------------------------------------------
IF TFLAG:전투이벤트 == 17
	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃%"外…─",72,LEFT%┃
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF


;-------------------------------------------------
;○回避した
;-------------------------------------------------
IF TFLAG:전투이벤트 == 18
	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃%"当、읏！",72,LEFT%┃
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF




;-------------------------------------------------
;○反射した
;-------------------------------------------------
IF TFLAG:전투이벤트 == 16
	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃%"効읏！",72,LEFT%┃
