@ENEMY_BATTLE_EVENT_K[[キャラ:펜리르]]_1, ARG, ARG:1, ARG:2
;-------------------------------------------------
;○敵でのデビルＣＯ－ＯＰ発動時の台詞
;-------------------------------------------------
IF TFLAG:전투이벤트 == 1
;			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
