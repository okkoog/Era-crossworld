@KOJO_BATTLE_EVENT_K[[キャラ:박애의큐피드]], ARG, ARG:1, ARG:2
;■台詞の行数を増やしたいときは
;			BTL_KOJO_RESULTS:0 = 一行目
;			BTL_KOJO_RESULTS:1 = 二行目
;			BTL_KOJO_RESULTS:2 = 三行目
;			BTL_KOJO_RESULTS:3 = 四行目
;			BTL_KOJO_RESULTS:4 = 五行目
;と増やしていく
SIF ARG < 0 && NO:ARG != 3224
	RETURN 0
;VARSET LOCALS

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
	IF CFLAG:800 == 1
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = ぱふぁらぱぱぱぱー
			BTL_KOJO_RESULTS:1 = 突撃ー%UNICODE(0x2606)%
		ELSE
			BTL_KOJO_RESULTS:0 = ラバーメン！
			BTL_KOJO_RESULTS:1 = （恋人人間）
		ENDIF
	ELSE
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = ころス…コロブゥ
		ELSE
			BTL_KOJO_RESULTS:0 = 天……バツ……
		ENDIF
	ENDIF
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			IF CFLAG:800 == 1
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = キャハハハハハーッ%UNICODE(0x2606)%
					BTL_KOJO_RESULTS:1 = %CSTR:이인칭%につーづけーっ
				ELSE
					BTL_KOJO_RESULTS:0 = アナタのためにぃ
					BTL_KOJO_RESULTS:1 = いそいできたのっ%UNICODE(0x2606)%
				ENDIF
			ELSE
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = %CSTR:이인칭%に…つヅく…
				ELSE
					BTL_KOJO_RESULTS:0 = ナ……ナゲーイ
				ENDIF
			ENDIF
		;それ以外
		ELSE
			IF CFLAG:800 == 1
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = チャンス、とうらーい%UNICODE(0x2606)%
				ELSE
					BTL_KOJO_RESULTS:0 = ぶちころがすゾッ%UNICODE(0x2606)%
				ENDIF
			ELSE
				IF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = こロす……コロブ……
				ELSE
					BTL_KOJO_RESULTS:0 = お前モ…同じニ……
				ENDIF
			ENDIF
		ENDIF
	;被召喚時
	CASE 3
		IF CFLAG:800 == 1
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = %CALLNAME:TARGET%さんじょーう%UNICODE(0x2606)%
			ELSE
				BTL_KOJO_RESULTS:0 = アナタのために
				BTL_KOJO_RESULTS:1 = いそいできたのっ%UNICODE(0x2606)%
			ENDIF
		ELSE
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = てキ…どこダ…
			ELSE
				BTL_KOJO_RESULTS:0 = わかった
			ENDIF
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
