@CLOTHES_MESSAGE_K[[キャラ:듀라한]],ARG,ARG:1,ARG:2
;ARGは着脱があった部位	
;ARG:1は1なら着せた。0なら脱がせた
;ARG:2は着脱したキャラ(MASTER/TARGET/ASSIのいずれかが入る)


;以下はテスト用です
;うまくいかない！

SELECTCASE ARG:2
	CASE TARGET
		;デュラハンが衣装を変更する場合
		IF ARG == 86
			;下着を着たり脱いだり
			PRINTW 「멈춰주세욧！　뚫어지도록 쳐다보지 말라구요！」
		ELSEIF ARG == 88
			;靴下を着たり脱いだり
			PRINTW 「……뭐가 그렇게나 기쁜 겁니까아……」
		ENDIF
	CASE MASTER
		;調教者が衣装を変更する場合
		IF ARG == 86 && !ARG:1 && HAVE_PENIS(MASTER)
			;調教者が下着（下）を脱いだ
			PRINTL 「히잇！？　저、전투준비입니까！」
			PRINTW 「변태！　노출광！　예상보다 커！」
		ENDIF
	CASE ASSI
		;助手が衣装を変更する場合
	
ENDSELECT