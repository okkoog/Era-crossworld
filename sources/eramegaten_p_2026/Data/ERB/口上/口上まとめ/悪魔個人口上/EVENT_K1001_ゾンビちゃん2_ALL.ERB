;-------------------------------------------------
;調教開始時（2回目以降、5073をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_K[[キャラ:좀비쨩]]_2
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORML 「흥─이다!　상냥하지 않은 %CSTR:이인칭%같은 건………… 시、싫어요！」
	PRINTFORML ―――발밑이 무너져내리는 듯한 충격。
	PRINTFORML 설령 보구로 직격을 당해도 이정도의 아픔은 느껴지지 않겠지…… %CALLNAME:TARGET%에게 싫다는 말을 듣는다는 건、이렇게나 참을 수가……！
	PRINTFORML 무엇이든 받아주리라 생각하고、선을 넘어버렸던 것이다……
	PRINTFORML 「지、지금까지의 행동을 고치고、상냥하게 대해주신다면야…… 다시 평가해주지 못할 것도、아니라구요？」
	PRINTFORML 힐끗힐끗 이쪽을 바라보며 말을 하는 %CALLNAME:TARGET%에게、아직 다시 시작할 수 있다는 희망을 발견했다。
	PRINTFORMW 앞으로는 조심하도록 하자……
	CFLAG:202 = 4
;屈服刻印Lv0
ELSEIF MARK:2 == 0 && (CFLAG:202 < 1 || FLAG:7 == 2)
	PRINTFORML 「그…… 왠지、두근두근거리네욧！」
	PRINTFORML 풋풋한 반응이 사랑스러워、무심코 흥분해버렸다。
	PRINTFORMW 살짝 어깨에 손을 대자、%TARGET은% 부끄러운 듯 고개를 숙였다……
	CFLAG:202 = 1
;屈服刻印Lv1
ELSEIF MARK:2 == 1 && (CFLAG:202 < 2 || FLAG:7 == 2)
	PRINTFORML 「오늘도…… 하나요？　아뇻！ 싫다거나 그런 게 아니라……
	PRINTFORML 그냥…… %CSTR:이인칭%에게 상스러운 목소리 들려주는 건、부끄럽다고나 할까요……」
	PRINTFORML 갑자기 %CALLNAME:TARGET%의 상스러운 목소리가 듣고 싶어졌다。그렇게 속삭이며 밀어 쓰러뜨린다。
	PRINTFORMW %TARGET은% 불평을 하면서도、이쪽을 껴안았다……
	CFLAG:202 = 2
;屈服刻印Lv2
ELSEIF MARK:2 == 2 && (CFLAG:202 < 3 || FLAG:7 == 2)
	PRINTFORML 「%CSTR:이인칭%…… %CSTR:일인칭%、불안해요。
	PRINTFORMW 이대로라면… %CSTR:이인칭%에게 녹아서…… 사라져버리지 않을까 하고」
	PRINTFORML 살짝 머리를 쓰다듬어주니、불안이 풀렸는지 미소로 변해간다……
	PRINTFORMW 「%CSTR:이인칭%의 손、따뜻하다……」
	CFLAG:202 = 3
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0) && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORML 「%CSTR:이인칭%─…… 이제 떨어지고 싶지 않아요……
	PRINTFORMW 이제 %CSTR:이인칭% 말고는 아무것도 필요없어요……」
	PRINTFORMW %CALLNAME:TARGET%의 표정은 완전히 풀려、몸을 밀착시키며 떨어지려고 하지 않는다。
	PRINTFORMW 「%CSTR:이인칭%、%CSTR:이인칭%…… 계속 곁에……」
	CFLAG:202 = 4
;陥落済み
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	IF 1== 0
	;恋慕、親愛
	ELSEIF TALENT:3 || TALENT:6
		;친애
		IF TALENT:6
			;半脱ぎ
			IF FLAG:1 == 1
				PRINTFORMW 「뭔가 썰렁해요……」
				PRINTFORML %TARGET은% 시킨대로、옷 아래 속옷을 입지 않은 채 있었던 모양이다。
				PRINTFORMW 자꾸만 치마를 누르는 모양새가、이쪽을 유혹하고 있는 것처럼 보여 꽤나 선정적이다……
				PRINTFORMW 「……평소보다 시선이 엣치해요」
