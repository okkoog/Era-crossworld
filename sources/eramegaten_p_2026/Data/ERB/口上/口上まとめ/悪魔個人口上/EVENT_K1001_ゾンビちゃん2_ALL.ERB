;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 5073
	RETURN 0
VARSET LOCALS

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 갑니다─！
		ELSE
			BTL_KOJO_RESULTS:0 = 갈게요！
		ENDIF
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = %CSTR:이인칭%、맞추겠습니다！
		;それ以外
		ELSE
			BTL_KOJO_RESULTS:0 = 맡겨주세요！
		ENDIF
	;被召喚時
	CASE 3
		;메이드복
		IF TEQUIP:전신복 == 308
			BTL_KOJO_RESULTS:0 = 
		;魔法少女服
		ELSEIF TEQUIP:전신복 == 304
			BTL_KOJO_RESULTS:0 = 
		;魔法少女服
		ELSEIF TEQUIP:전신속옷 == 715 && TEQUIP:겉옷 == 1002
			BTL_KOJO_RESULTS:0 = 
		ELSE
			BTL_KOJO_RESULTS:0 = 부르기만 한다면 즉시 등장！
			BTL_KOJO_RESULTS:1 = 당신의 믿음직한 동료마입니다！
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = 네、변변찮았습니다♪
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = 
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 마음껏 원망해주세요♪
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = 후후…… 처음부터 다시 시작해서 오세요♪
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			BTL_KOJO_RESULTS:0 = 자 드세요♪
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = 어라、안 먹히네？
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 집으로 돌아갈게요……
			ELSE
				BTL_KOJO_RESULTS:0 = 아파～아！집에 갈게요오……
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 죽어버려요！？
			ELSE
				BTL_KOJO_RESULTS:0 = 아파앗～！ 우우우우……
			ENDIF
		;無効
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 안 먹히거든요？
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = 후후후、잘 먹었습니다♪
		ELSE
			;메이드복
			IF TEQUIP:전신복 == 308
				BTL_KOJO_RESULTS:0 = 으읏… 괜찮아요。
			ELSE
				IF RAND:3 == 0
					BTL_KOJO_RESULTS:0 = 우뀻！？
				ELSEIF RAND:2 == 0
					BTL_KOJO_RESULTS:0 = 아야야얏、스톱！ 스톱 플리즈！
				ELSE
					BTL_KOJO_RESULTS:0 = 그만해주세요～！
				ENDIF
			ENDIF
		ENDIF
	;反射された
	CASE 15
			BTL_KOJO_RESULTS:0 = 실화입니까！
	;反射した
	CASE 16
