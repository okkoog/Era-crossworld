	CASE 67
		CALL TRAIN_MESSAGE
		;初めて
		IF CFLAG:339 == 0
			PRINTFORMW 
			CFLAG:339 = 1
		;二回目以降					
		ELSE			
			IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8 || MARK:2 == 3) && (CFLAG:339 < 3 || FLAG:7 == 2)		
				;通す	
				IF 0 == (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8 || MARK:2 == 3) && (CFLAG:339 < 3 || FLAG:7 == 2)	
				;恋慕、親愛	
				ELSEIF TALENT:3 || TALENT:6 && (CFLAG:339 < 4 || FLAG:7 == 2)	
					PRINTFORMW 
					CFLAG:339= 4
				;淫乱、娼婦	
				ELSEIF TALENT:4 || TALENT:7 && (CFLAG:339 < 4 || FLAG:7 == 2)	
					PRINTFORMW 
					CFLAG:339= 4
				;服従、隷属	
				ELSEIF TALENT:5 || TALENT:8 && (CFLAG:339 < 4 || FLAG:7 == 2)	
					PRINTFORMW 
					CFLAG:339= 4
				;屈服刻印Lv3	
				ELSE	
					PRINTFORMW 
					CFLAG:339= 3
				ENDIF	
			;それ以外		
			ELSEIF CFLAG:339 < 2 || FLAG:7 == 2
					PRINTFORMW 
				CFLAG:339 = 2
			ENDIF
		ENDIF

