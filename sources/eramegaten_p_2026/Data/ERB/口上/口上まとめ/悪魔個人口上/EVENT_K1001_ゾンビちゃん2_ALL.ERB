;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	PRINTFORML 용모가 취향이라 붙잡은 좀비이긴 한데、조교하자니 역시 몸이 부패되어 있다。
	PRINTFORML 사교의 관에 몸을 신품으로 해달라 의뢰를 해놨는데、성공했다는 연락이 들어와、%MASTER는% 조교실로 향했다
	PRINTFORML 문을 열자、교복 차림의 여학생이 서있었으며、이쪽을 바라보고 목소리를 높였다 「……어라？　여기는…… 」무시하고 몸을 검사한다。
	PRINTFORML 괜찮게 되었다、스타일도 좋고、무엇보다 %CALLNAME:MASTER% 취향의 귀여운 여고생이다。비싸게 팔리지는 않겠지만、가지고 놀기에는 딱 좋다。
	PRINTFORML 일단 경위를 말해주고、악마로서 그리고 노예로서 쓰겠다고 설명하자、비교적 순순히 납득했다。
	PRINTFORML 몽롱한 의식으로 본능에 몸을 맡긴 채 사람들을 덮치고、이윽고 썩어빠져버리는 좀비로 있는 것보다는 지금 상태가 더 낫다나。
	PRINTFORML 「%일인칭은% %NAME:TARGET% 라고 합니다、깨끗한 몸과 정상적인 머리를 주셨으니、열심히 하겠습니다」하고、이쪽에 머리를 숙였다。
	PRINTFORMW 
	PRINTFORML 「%일인칭이% 살고 있던 곳은 지금까지 좀비 같은 건 나오지 않았어요、그런데 하교길에 갑자기 좀비에게 습격당해서、……
	PRINTFORML ……기억이 나는 건 거기까지입니다」
	PRINTFORML 「평화로운 도시의 여고생으로 자라서、이런 쪽은 아무것도 모릅니다만、그…… 잘 부탁드립니다。」
	PRINTFORMW 「저기、그리고、당신을 선생님으로 부르겠습니다。여러모로 가르쳐주신다고도 하고、동경하고 있던 선생님과도 닮으셔서」
	PRINTFORML 
	PRINTFORMW 「그쪽에 대해서도、엣치한 쪽에 대해서도 잘 부탁드려요、%CSTR:이인칭%……」
	CFLAG:201 = 1
	RETURN 0
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	PRINTFORMW 「%CSTR:일인칭%…… %이인칭이% 건드릴 때마다 음란하게 되어가……」
	PRINTFORMW %TARGET은% 멍하니、이쪽이 다가온 것도 알아차리지 못했다。
	PRINTFORMW 「아……%CSTR:이인칭%！？　언제부터 거기에！！」
	CFLAG:201 = 2
	RETURN 0
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	PRINTFORMW 「%CSTR:이인칭%…… %CSTR:이인칭%……」
	PRINTFORMW %TARGET은% 텅 빈 눈으로 이쪽을 올려다보며、애달픈 목소리를 내고 있다。
	PRINTFORMW 「%CSTR:일인칭%…… %CSTR:일인칭%、%CSTR:이인칭%에게 만져지고 싶어서…… %CSTR:이인칭%의 곁에 있고 싶어서……」
	CFLAG:201 = 3
	RETURN 0
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW 「%CSTR:이인칭%…… %TARGET은% 이제 안되겠어요…… %이인칭이% 한순간이라도 보이지 않으면 무서워져요……」
	PRINTFORMW %TARGET은% 이쪽의 얼굴을 보자마자 달려들어、온몸을 밀착해왔다。
	PRINTFORMW 「부디、부디 계속、함께 있어주세요……」
	CFLAG:201 = 4
	RETURN 0
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		PRINTFORMW 「이제푹빠졌다고나할까최애라고나할까평생안떠날거라고나할까요！！
		PRINTFORMW 이미 %CSTR:이인칭%의 것이기는 합니다만 다시 한번 %CSTR:일인칭%의 모든 것을 바쳐버릴 생각입니다！　안아줘요！！」
		PRINTFORMW 사랑의 크기는 전해져왔다만…… 조금만 더 말을 골라서 해주면 좋겠다고나 할까。
	;음란
	ELSEIF TALENT:4
		PRINTFORMW 「%CSTR:이인칭%♪　%CSTR:이인칭%♪ 엣치해요♪ 엣치♪」
		PRINTFORMW %TARGET은% 완전히 섹스에 빠져버린 모양이지만
		PRINTFORMW 변함없이 이런 분위기다
	;복종
	ELSEIF TALENT:5
		PRINTFORMW （선생님을 닮은 건 분명했지만…… 성벽까지는 꿰뚫어보지 못했네요）
		PRINTFORMW %TARGET은% 고개를 숙이고 있어、그 표정을 볼 수가 없었다。
		PRINTFORMW 턱을 잡고、억지로 고개를 들게 하니、물기 어린 눈동자가 보여왔다。겁을 먹고 있는 것이겠지……
		PRINTFORMW （이런 건 별로 취향은 아닌데요。뭐、성벽에 맞춰주는 것도 동료마로서 해야 할 일이니까）
	ENDIF
	CFLAG:201 = 5
	RETURN 0
;上位陥落口上
ELSEIF CFLAG:201 < 6 && (TALENT:6 || TALENT:7 || TALENT:8)
	;친애
	IF TALENT:6
	PRINTFORMW 「%CSTR:이인칭%…… %CSTR:일인칭%、행복해요。또、학교에도 갈 수 있게 되었고」
	PRINTFORMW 「행복하고、또 행복해서…… 이대로 녹아 사라져도 될 정도로……」
	PRINTFORML 「막─이래!　뭐어、또다시 죽어도 괜찮을 정도로 행복한 건 사실이지만요、
	PRINTFORMW 　%이인칭을% 놔두고 갈 리가 없잖아요！　갈 때는 함께 가는 거예요！」
	PRINTFORMW 「각오해주세요？　%CSTR:이인칭%♪」

	;창부
	ELSEIF TALENT:7
		PRINTFORMW 
	;예속
	ELSEIF TALENT:8
		PRINTFORMW  
	ENDIF
	CFLAG:201 = 6
	RETURN 0

ENDIF

