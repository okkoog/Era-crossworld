;強度は、１＝絶頂、２＝強絶頂、３＝超強、４＝発狂、５＝最強。
;それぞれ必要な快楽は、
;最強：50000（『今回上昇した快楽＋現在の快楽』＞＝『PALAMｌｖ４(10000)×５』　以下、４，３，２，１倍。）
;発狂：40000
;超強：30000
;強絶：20000
;絶頂：10000
;……となっている（はず）。当然、強絶頂以上は少なくとも10001快楽を叩きこまねばならない（口上書きたがるレベルなら分かるか）。
;NOWEX:1 == 4　……なら、V発狂絶頂時、となる。
;感度lv10で調教者の技巧が10だと20万くらいは入るので、最強もわりと簡単？
;
;○EX
;EX:（部位） >= （回数）
;で、（部位）の絶頂回数が(回数）以上、という指定ができる。
;EX:1 >= 50　……なら、V絶頂が今回50回以上、といった感じ。
;
;○TFLAG:29
;TFLAG:29は絶頂した判定。
;強絶頂かどうかの判定まであるはずなんだけど、見つからないのでちとパス。素直に絶頂強度で指定するべきかな。
;
;○その他気になることがあったら
;この辺は『TRACHECK.ERB』『SOURCE.ERB』あたり探すといいかも。
;絶頂時のテキストについては『EVENT_M.ERB』参照。
;-------------------------------------------------
;以上メモ欄
;-------------------------------------------------
;
;-------------------------------------------------
;分けると死にそうだから３段階+回数
;最強↑ 叫んじゃう
;強↑ 声を抑えられない
;절정 まだ抑えられる
;
;연모 さまなーすきすき 一緒にイきたい
;음란 もっともっと 気持ちよくしてほしい
;복종 ごめんなさいごめんなさい 勝手にイっちゃいます
;未陥落 やだやだ 我慢できない
;
;ふぁぁってイき方好き
;
;どこかの部位で10回以上絶頂で頭がばかになりゅモード ハート解禁 アヘる……？
;		普段落ち着いてるからイメージと違うかなとか思ってたけど書いてみたらめっちゃそそる
;	すぐあへあへされても困るから欲望lv5もキーに追加
;		これ究極絶頂とかだと+5っぽいのかな すぐアヘる……　→ので、30回に
;
;2-21 絶頂部分だけなんかおかしい……？ 他の強度は機能してるのに
;
;---------------------------------------------------

IF TFLAG:29 > 0
	CALL PALAM_MESSAGE_B

	;あへあへスイッチ
	;次回調教開始時に初期化
	SIF (EX:0 >= 30 || EX:1 >= 30 || EX:2 >= 30 || EX:3 >= 30) && ABL:1 >= 5
		CFLAG:851 = 1

	;頭がばかになりゅ
	IF CFLAG:851 == 1 && FLAG:7 == 2
		;연모
		;名前を呼ぶ
		IF CFLAG:800 == 1 && FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORML 「아앗%UNICODE(0x2661)% 아앗%UNICODE(0x2661)%」
				PRINTFORMW 「아앗%UNICODE(0x2661)% 아앗%UNICODE(0x2661)%」
				PRINTFORML %CALLNAME%은 몇번이고 몇번이고 %CALLNAME:MASTER%의 이름을 부르면서 절정하고 있다。
				PRINTFORMW 「가……가버려어어어어엇%UNICODE(0x2661)%%UNICODE(0x2661)%%UNICODE(0x2661)%」
			ELSE
				PRINTFORML 「응읏%UNICODE(0x2661)% 앗%UNICODE(0x2661)%」
				PRINTFORML 「좋아……%UNICODE(0x2661)% 좋아햇……%UNICODE(0x2661)%」
				PRINTFORML %CALLNAME은% 쾌락에 삼켜지면서도、필사적으로 %MASTER를% 원해왔다。
				PRINTFORMW 「%CSTR:이인칭%읏%UNICODE(0x2661)% %CSTR:이인칭%아아아아아앗%UNICODE(0x2661)%%UNICODE(0x2661)%」
			ENDIF
		;음란
		ELSEIF CFLAG:800 == 2 && FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORML 「아아아아아앗%UNICODE(0x2661)% 히웃%UNICODE(0x2661)%」
				PRINTFORML 「좀 더 %UNICODE(0x2661)% 좀 더 해줘%UNICODE(0x2661)%」
				PRINTFORML 천박하게 어지러워진 %CALLNAME%。 이제 그 모습에 평상시의 모습은 사라지고 쾌락을 탐할 뿐인 짐승으로 변해 있었다。
				PRINTFORMW 「간다앗……%UNICODE(0x2661)% 가버려어어엇%UNICODE(0x2661)%%UNICODE(0x2661)%」
			ELSE
				PRINTFORML 「부서졋%UNICODE(0x2661)% 부서져버렷%UNICODE(0x2661)%」
				PRINTFORML 「이상해져버려엇%UNICODE(0x2661)% %일인칭이% %일인칭이% 아니게 돼버렷%UNICODE(0x2661)%」
				PRINTFORML 그러나 거절하고 있는 것은 말뿐이지、%CALLNAME은% 탐욕스럽게 쾌감을 계속 추구한다。
				PRINTFORMW 「아아아아아아아앗%UNICODE(0x2661)%%UNICODE(0x2661)%%UNICODE(0x2661)%」
			ENDIF
		;복종
		ELSEIF CFLAG:800 == 3 && FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORML 「히큐웃%UNICODE(0x2661)% 아우우웃%UNICODE(0x2661)%」
				PRINTFORMW 「히큐웃%UNICODE(0x2661)% 아우우웃%UNICODE(0x2661)%」
				PRINTFORML 소용돌이치는 쾌락의 소용돌이 한가운데서 %CALLNAME은% 성실하게 자신의 절정을 보고해왔다。
				PRINTFORMW 「아아아아아앙%UNICODE(0x2661)%%UNICODE(0x2661)%%UNICODE(0x2661)%」
			ELSE
				PRINTFORML 「정말로 죄송%UNICODE(0x2661)% 합니다……%UNICODE(0x2661)%」
				PRINTFORML 「%CSTR:일인칭% 더 이상은%UNICODE(0x2661)% 참을 수%UNICODE(0x2661)% 없어요%UNICODE(0x2661)%」
				PRINTFORML 필사적으로 사과하면서 %CALLNAME은% 쾌락에 몸을 맡긴 채 음란함에 허덕이고 있다。
				PRINTFORMW 「으응, 아아아아아아앗%UNICODE(0x2661)%%UNICODE(0x2661)%%UNICODE(0x2661)%」
			ENDIF
		;通常
		ELSEIF FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORML 「아아아아아앗……%UNICODE(0x2661)%」
				PRINTFORML 「더 이상……안……돼엣%UNICODE(0x2661)%」
				PRINTFORML 사고할 여유도 없이、그저 %CALLNAME은% 헐떡이고 있다。
				PRINTFORMW 「후아아아아아아아아아아%UNICODE(0x2661)%%UNICODE(0x2661)%%UNICODE(0x2661)%」
			ELSE
				PRINTFORML 「그만%UNICODE(0x2661)% 더는%UNICODE(0x2661)% 그만%UNICODE(0x2661)%」
				PRINTFORML 「싫어……%UNICODE(0x2661)% 싫어엇……%UNICODE(0x2661)% 이런……%UNICODE(0x2661)%」
				PRINTFORML 싫다고 고개를 흔들면서、%CALLNAME은% 필사적으로 쾌락에 삼켜지지 않으려 하고 있다。
				PRINTFORMW 「응우우……아아아아아아아앙%UNICODE(0x2661)%%UNICODE(0x2661)%%UNICODE(0x2661)%」
			ENDIF
		ENDIF

	;最強絶頂,発狂絶頂
	ELSEIF NOWEX:0 > 3 || NOWEX:1 > 3 || NOWEX:2 > 3 || NOWEX:3 > 3
		;연모
		IF CFLAG:800 == 1 && FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORML 「앗……응우웃………！」
				PRINTFORMW 「앗……응우웃………！」
				PRINTFORMW 「%CSTR:이인칭%……! %CSTR:이인칭%……!!」
			ELSE
				PRINTFORML 「……으읏……아아읏……！」
				PRINTFORML 「좋앗……！ 좋아해앳……！！」
				PRINTFORMW 「아아아아아아~~~~읏!!」
			ENDIF
		;음란
		ELSEIF CFLAG:800 == 2 && FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORML 「하앗……우우웅읏……！」
				PRINTFORML 「기분좋아……기분조아앗……！」
				PRINTFORMW 「가……가버려어어엇！！」
			ELSE
				PRINTFORML 「……하힛……가버……！」
				PRINTFORML 「가버려어어……엇！ 가버리니까앗……！！」
				PRINTFORMW 「후아아아아아아아~~~~읏!!!」
			ENDIF
		;복종
		ELSEIF CFLAG:800 == 3 && FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORML 「……아읏……히읏……！」
				PRINTFORMW 「……아읏……히읏……！」
				PRINTFORMW 「%CSTR:이인칭%…… %CSTR:일인칭% 더 이상……!」
			ELSE
				PRINTFORML 「……응읏……큿……！」
				PRINTFORML 「죄송……합니다앗……가……버려어……！」
				PRINTFORMW 「아아아아아~~~읏!!!」
			ENDIF
		;通常
		ELSEIF FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORML 「…………으우우우우웃……！！」
				PRINTFORML 「싫엇……이젠……가……！！」
				PRINTFORMW 「…………으우우우우웃……！！」
			ELSE
				PRINTFORML 「아윽……아우우……！！」
				PRINTFORML 「싫……싫어어……아……안돼에에……！！！」
				PRINTFORMW 「아아아아아아~~~읏!!!」
			ENDIF
		ENDIF

	;超強絶頂、強絶頂
	ELSEIF NOWEX:0 > 1 || NOWEX:1 > 1 || NOWEX:2 > 1 || NOWEX:3 > 1
		;연모
		IF CFLAG:800 == 1 && FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORML 「쿠웃……응……！」
				PRINTFORMW 「쿠웃……응……！」
			ELSE
				PRINTFORML 「히아앗……！」
				PRINTFORMW 「쿠우우우웃！」
			ENDIF
		;음란
		ELSEIF CFLAG:800 == 2 && FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORML 「가버렷……！ 가버려어어어！」
				PRINTFORMW 「아아아앙！」
			ELSE
				PRINTFORML 「좀 더……좀 더어……！」
				PRINTFORMW 「햐우우우웃！」
			ENDIF
		;복종
		ELSEIF CFLAG:800 == 3 && FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORML 「아우우웃……！」
				PRINTFORMW 「가……가버려요……아아아앙！」
			ELSE
				PRINTFORMW 「아우우웃……！」
				PRINTFORMW 「후아아앗……！」
			ENDIF
		;通常
		ELSEIF FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORML 「쿠읏……우우욱……！」
				PRINTFORMW 「가……아아아앗！」
			ELSE
				PRINTFORML 「안돼……더는……！」
				PRINTFORMW 「아아아아앗！」
			ENDIF
		ENDIF
;	ENDIF
	;절정
	ELSEIF NOWEX:0 == 1 || NOWEX:1 == 1 || NOWEX:2 == 1 || NOWEX:3 == 1
		;연모
		IF CFLAG:800 == 1 && FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORMW 「－－－－으으읏！」
			ELSE
				PRINTFORMW 「히야앗……！」
			ENDIF
		;음란
		ELSEIF CFLAG:800 == 2 && FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORMW 「……가……버려……！」
			ELSE
				PRINTFORMW 「응우우……！」
			ENDIF
		;복종
		ELSEIF CFLAG:800 == 3 && FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORMW 「후아앗……！」
			ELSE
				PRINTFORMW 「응……！！」
			ENDIF
		;通常
		ELSEIF FLAG:7 == 2
			IF RAND:2 == 0
				PRINTFORMW 「－－－－으으읏！」
			ELSE
				PRINTFORMW 「쿠우……！」
			ENDIF
		ENDIF
	ENDIF
ENDIF

