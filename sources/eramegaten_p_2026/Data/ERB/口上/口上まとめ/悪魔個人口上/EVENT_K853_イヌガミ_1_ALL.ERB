;射精している
IF TFLAG:10 > 0	
	IF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8 || MARK:2 == 3) && (CFLAG:247 < 2 || FLAG:7 == 2)		
		;通す	
		IF 0 == (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8 || MARK:2 == 3) && (CFLAG:247 < 2 || FLAG:7 == 2)	
		;陥落済み	
		;ELSEIF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8 || MARK:2 == 3) && (CFLAG:247 < 3 || FLAG:7 == 2)	
		;	PRINTFORMW 
		;	CFLAG:247= 3
		;屈服刻印Lv3	
		ELSE	
			PRINTFORMW 
			CFLAG:247= 2
		ENDIF	
	;それ以外		
	ELSEIF CFLAG:247 < 1 || FLAG:7 == 2
		PRINTFORMW 
		CFLAG:247 = 1
	ENDIF
