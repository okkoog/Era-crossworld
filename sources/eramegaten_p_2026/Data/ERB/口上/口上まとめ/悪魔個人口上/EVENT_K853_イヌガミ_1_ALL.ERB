			ENDIF
		ENDIF
		CFLAG:247 = 3
	ELSEIF (CFLAG:247 < 2 || FLAG:7 == 2) & RAND:4 == 0
		PRINTFORMW 「……젖가슴……나와버렸다……」
		CFLAG:247 = 3
	;屈服刻印Lv3
	ELSEIF MARK:2 == 3 && (CFLAG:247 < 2 || FLAG:7 == 2) & RAND:4 == 0
		PRINTFORMW 「……멈추지 않아……」
		CFLAG:247 = 2
	;それ以外
	ELSEIF (CFLAG:247 < 1 || FLAG:7 == 2) & RAND:4 == 0
