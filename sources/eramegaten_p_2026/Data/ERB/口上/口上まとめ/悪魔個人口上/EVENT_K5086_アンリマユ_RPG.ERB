@KOJO_BATTLE_EVENT_K[[キャラ:앙리마유]], ARG, ARG:1, ARG:2
;■台詞の行数を増やしたいときは
;			LOCALS:10 = 一行目
;			LOCALS:11 = 二行目
;			LOCALS:12 = 三行目
;			LOCALS:13 = 四行目
;			LOCALS:14 = 五行目
;と増やしていく
SIF ARG < 0 && NO:ARG != 5086
	RETURN 0
VARSET LOCALS
VARSET KSTR

SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = うひょー！今がチャンスだぜー！
			CASE 1
				BTL_KOJO_RESULTS:0 = 皆、やっちまえ～！
			CASE 2
				BTL_KOJO_RESULTS:0 = ひひっ、ぼっこぼこにしてやろうぜー！
		ENDSELECT
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = あいよー！オレも続きますよ、っとー！
				CASE 1
					BTL_KOJO_RESULTS:0 = ひゅー！やるね～！
				CASE 2
					BTL_KOJO_RESULTS:0 = いやー！追撃だけなら楽だわー！
			ENDSELECT
		;それ以外
		ELSE
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = ふるぼっこふるぼっこ、っと！	
			CASE 1
				BTL_KOJO_RESULTS:0 = はいはーい、オレもいきますぜー！
			CASE 2
				BTL_KOJO_RESULTS:0 = ひゅー！オタクもやるねぇ～！
			ENDSELECT
		ENDIF
	;被召喚時
	CASE 3
		SELECTCASE RAND:2
			CASE 0
				BTL_KOJO_RESULTS:0 = いっちょ殺されますか！
			CASE 1
				BTL_KOJO_RESULTS:0 =　オレ弱いから注意してくれよー！
		ENDSELECT
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			SELECTCASE RAND:2
			CASE 0
				BTL_KOJO_RESULTS:0 = あちゃー！オレより弱かったかー！
			CASE 1
				BTL_KOJO_RESULTS:0 = ひひっ、いっちょあーがりっと！
			ENDSELECT
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = あっれー？おっかしいなー？
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = このまま死んじまいなー！
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = ひひっ、けっこう効いたっしょ？
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			BTL_KOJO_RESULTS:0 = ぐあーっ！かってぇなぁ！
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = 無効とかずっこくねー！？
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = ほらぁ、だからオレ弱いんだって！
				CASE 1
					BTL_KOJO_RESULTS:0 = まぁ、オレにしちゃよくやったかな～
			ENDSELECT
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = あいてっ！？
				CASE 1
					BTL_KOJO_RESULTS:0 = ぐわーっ！？
			ENDSELECT
		;無効
		ELSEIF ARG:2 == 0
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = ひひっ、効かねぇよーだ！ってな
				CASE 1
					BTL_KOJO_RESULTS:0 = マジで効くと思ったのかよー？
			ENDSELECT
		;吸収
		ELSEIF ARG:2 < 0
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = いやー、うまいうまい！
				CASE 1
					BTL_KOJO_RESULTS:0 = ごっそーさん！
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = あいてっ！
			CASE 1
				BTL_KOJO_RESULTS:0 = うおーっ！？
			CASE 2
				BTL_KOJO_RESULTS:0 = ぎゃー！？
			ENDSELECT
		ENDIF
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE 13
		;全弾命中した
		IF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = おっ、さっすがオレ！全部あったりましたー！
		;普通
		ELSEIF ARG:2 < ARG:1
			BTL_KOJO_RESULTS:0 = うーん、いくつか殺し損ねたな～！
		;全弾回避された
		ELSEIF ARG:2 == ARG:1
			SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = ちょ！当たんねぇってコレ！！
			CASE 1
				BTL_KOJO_RESULTS:0 = いやー！いくら最弱のオレでも凹むわー！
			CASE 2
				BTL_KOJO_RESULTS:0 = いやいや、今のは小手調べだから！
			ENDSELECT
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE 14
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			LOCAL = RAND:3
			SELECTCASE LOCAL
			CASE 0
				BTL_KOJO_RESULTS:0 = おっ？一気にいけましたね～！
			CASE 1
				BTL_KOJO_RESULTS:0 = ひゅー！さっすがオレ！
			CASE 2
				BTL_KOJO_RESULTS:0 = ひひっ、皆殺し完了！っとー！
			ENDSELECT
		ELSE
			BTL_KOJO_RESULTS:0 = うーん、殺し損ねたヤツいんな～！
		ENDIF
	;反射された
	CASE 15
		BTL_KOJO_RESULTS:0 = あいて！？ずっこくねー！？
	;反射した
	CASE 16
		BTL_KOJO_RESULTS:0 = いや～！オレ得意なんですよねー、ソレ！
	;回避された
	CASE 17
		SELECTCASE RAND:3
		CASE 0
			BTL_KOJO_RESULTS:0 = ちょ！避けんなって！
		CASE 1
			BTL_KOJO_RESULTS:0 = ぐあーっ！当たんねぇー！
		CASE 2
			BTL_KOJO_RESULTS:0 = くっそー！当たれってーの！
		ENDSELECT
	;回避した
	CASE 18
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 当たんねーヤツなんですわー！それ！
			CASE 1
				BTL_KOJO_RESULTS:0 = ひゅー！ナイス回避、オレ！
			CASE 2
				BTL_KOJO_RESULTS:0 = オレより速いのは犬と蜘蛛くらいだからな～！
		ENDSELECT
	;反撃スキル発動した
	CASE 20
			BTL_KOJO_RESULTS:0 = 隙あり！でっすよーー！
	CASE 22
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				BTL_KOJO_RESULTS:0 = うわー、あったまハピハピしてやがったぜー！
			CASE "SHOCK"
				BTL_KOJO_RESULTS:0 = しびびびびびッ！？
			CASE "FREEZE"
				BTL_KOJO_RESULTS:0 = オタク、オレの格好にソレやる！？
			CASE "BIND", "PALYZE"
				BTL_KOJO_RESULTS:0 = ちょ、動けないんですけどー！誰かー！
			CASE "PANIC"
				BTL_KOJO_RESULTS:0 = おっ、アンタがオレの敵だな！？！
			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 = うーん……おやすみーよ……
			CASE "CLOSE"
				BTL_KOJO_RESULTS:0 = ちょ！魔力封じはずっこいって！
			CASE "POISON"
				BTL_KOJO_RESULTS:0 = ぐあーっ！毒消し草！毒消し草はよ！
			CASE "BOMB"
				BTL_KOJO_RESULTS:0 = えっ、オレ英霊爆弾……！？
			CASE "CHARM"
				KSTR:(K++) = うわー、オタクすっごくイイネ～！
			CASE "CURSE"
				BTL_KOJO_RESULTS:0 = えっ！オレ呪いとか効くワケ！？
			CASE "FLY"
				BTL_KOJO_RESULTS:0 = 流石にハエになった経験はなかったわー……
			CASE "STONE"
				BTL_KOJO_RESULTS:0 = …………ｺｯﾁｰﾝ（決めポーズ）
			CASE "FLAME"
				BTL_KOJO_RESULTS:0 = あちちちっ！？水！水はよ！！
			CASE "SLIP"
				BTL_KOJO_RESULTS:0 = ぐあーっ！？ちょ、ローションじゃないのに滑る！
			CASE "BRAND"
				BTL_KOJO_RESULTS:0 = いやー、こういうのけっこう慣れてるワケで……
			;その他の状態異常
			;CASEELSE
		ENDSELECT
	;食いしばり等で耐えた
	CASE 23
		BTL_KOJO_RESULTS:0 = オッケーオッケー！しなやす！しなやす！
	;バトルに勝利した
	CASE 90
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 最弱でも生き残れるもんだねぇ～！
			CASE 1
				BTL_KOJO_RESULTS:0 = オタクら、オレより弱くて恥ずかしくない？
		ENDSELECT
	;レベルアップした
	CASE 91
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = おっ！イイネイイネ！！
			CASE 1
				BTL_KOJO_RESULTS:0 = ひゅー！オレ、レベルアーップ！
		ENDSELECT
	;逃走に成功した
	CASE 92
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 速さなら得意分野ですよー、っと！
			CASE 1
				BTL_KOJO_RESULTS:0 = 戦略的てったーい！
			CASE 2
				BTL_KOJO_RESULTS:0 = 逃げるが勝ち！逃げるが勝ち！
		ENDSELECT
	;逃走に失敗した
	CASE 93
			BTL_KOJO_RESULTS:0 = ぐあーっ！？オレに追いついた！？
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = ちょ、オレ死んじゃう！死んじゃうって！
		ELSE
			BTL_KOJO_RESULTS:0 = 今回も生き残れますよーに、っと！
		ENDIF
	;バックアタックを受けた
	CASE 95
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = ちょ！今はやめてー！アッー！
		ELSE
			BTL_KOJO_RESULTS:0 = ちょ！？なんで百太郎くん入れてないのー！？
		ENDIF
	;敵の先制攻撃を受けた
	CASE 96
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = あー……今回は流石にオレ死んじゃうかなー
		ELSE
			BTL_KOJO_RESULTS:0 = ひゃーくたろう！ひゃーくたろう！！	
		ENDIF
	;先制攻撃に成功
	CASE 97
			BTL_KOJO_RESULTS:0 = ひひっ、オレらが先制いっただきー！！
	CASE 100
		IF 0
		;スキル分岐
		;ELSEIF CFLAG:(FLAG:행동순1):입력행동 == [[스킬:○○]]
		ELSE
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = オレにつっづけー！
				CASE 1
					BTL_KOJO_RESULTS:0 = はいはーい！いっきますよー！
			ENDSELECT
		ENDIF
ENDSELECT
