	IF FAVORITE_1(TARGET) == ASSI
		PRINTFORMW %CALLNAME:ASSI%와 %CALLNAME:TARGET%은 아쉬운 듯 서로를 끌어안고 있었다.
		PRINTFORMW 「즐거웠어… %CALLNAME:ASSI%… 또 봐」
		PRINTFORMW 「다음엔 둘이서만 만나고 싶네%UNICODE(0x2661)%」
	;陥落済み
	ELSEIF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8)
		PRINTFORMW %CALLNAME:ASSI%와 %CALLNAME:TARGET%은 서로 껴안고 누워 있었다.
		;妻
		IF TALENT:170
			PRINTFORMW 「즐거웠어… %CALLNAME:ASSI%… 또 만나자」
		;恋慕、親愛
		ELSEIF TALENT:3 || TALENT:6
			PRINTFORMW 「제법이네… %CALLNAME:ASSI%」
		;淫乱、娼婦
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORMW 「즐거웠어 %CALLNAME:ASSI%… 또 봐」
		;服従、隷属
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 
		ENDIF
	;それ以外
	ELSE
		PRINTFORMW 「%CSTR:이인칭%…… %CALLNAME:ASSI%와 %CSTR:일인칭%은 부모자식 간이라고요…」
		PRINTFORMW 「가능하면… 이제 %CALLNAME:ASSI%는 부르지 말아 주세요…」
	ENDIF
;助手_303_大天使ガブリエル
ELSEIF 助手確認([[キャラ:가브리엘]])
	;助手の好感度が高い
	IF FAVORITE_1(TARGET) == ASSI
		PRINTFORMW %CALLNAME:ASSI%와 %CALLNAME:TARGET%은 아쉬운 듯 서로를 끌어안고 있었다.
		PRINTFORMW 「즐거웠습니다… %CALLNAME:ASSI% 님…」
		PRINTFORMW 「%CSTR:일인칭%… 이대로 떨어지고 싶지 않아요%UNICODE(0x2661)%」
	;陥落済み
	ELSEIF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8)
		;恋慕、親愛
		IF TALENT:3 || TALENT:6
			PRINTFORMW 「%CALLNAME:ASSI%様…」
		;淫乱、娼婦
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORMW 
		;服従、隷属
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 
		ENDIF
	;それ以外
	ELSE
		PRINTFORMW 「%CALLNAME:ASSI% 님…… 이제 그만해 주세요…」
	ENDIF
;それ以外の助手
ELSE
	;助手の好感度が高い
	IF FAVORITE_1(TARGET) == ASSI
		PRINTFORMW %CALLNAME:ASSI%와 %CALLNAME:TARGET%은 아쉬운 듯 서로를 끌어안고 있었다.
		PRINTFORMW 「즐거웠습니다… %CALLNAME:ASSI%…」
		PRINTFORMW 「또 만나요%UNICODE(0x2661)%」
	;陥落済み
	ELSEIF (TALENT:3 || TALENT:4 || TALENT:5 || TALENT:6 || TALENT:7 || TALENT:8)
		;恋慕、親愛
		IF TALENT:3 || TALENT:6
			PRINTFORMW 「%CSTR:이인칭% 어째서… 이런 짓을 시키는 거야…」
		;淫乱、娼婦
		ELSEIF TALENT:4 || TALENT:7
			PRINTFORMW 「즐거웠어요」
		;服従、隷属
		ELSEIF TALENT:5 || TALENT:8
			PRINTFORMW 「감사했습니다」
		ENDIF
	;それ以外
	ELSE
		PRINTFORMW 「%CALLNAME:ASSI%…… 이제 그만해…」
	ENDIF
ENDIF
RETURN 0

