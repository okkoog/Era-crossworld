;悪魔合体時の手紙メッセージ
;-------------------------------------------------
@FUSION_LETTER_MESSAGE_K[[キャラ:엔젤]]_3,ARG,ARG:1

PRINTFORMW %CALLNAME:(ARG)%에게서 온 편지다
PRINTFORML 


;恋慕、親愛
IF TALENT:(ARG):연모 || TALENT:(ARG):친애
	PRINTFORML %CSTR:(ARG):일인칭%에 대한 것, 잊지 말아 주세요
	PRINTFORML 　
	PRINTFORMW 라고 적혀 있었다……
;淫乱、娼婦
ELSEIF TALENT:(ARG):음란 || TALENT:(ARG):창부
	PRINTFORML %CSTR:(ARG):일인칭%의 상태, 괜찮았나요?
	PRINTFORML 　
	PRINTFORMW 라고 적혀 있었다……
;服従、隷属
ELSEIF TALENT:(ARG):복종 || TALENT:(ARG):예속
	PRINTFORML %CSTR:(ARG):일인칭%의 마지막 봉사입니다
	PRINTFORML 이 몸, 영혼, 전부 바치겠습니다
	PRINTFORML 　
	PRINTFORMW 라고 적혀 있었다……
;屈服刻印Lv1以上
ELSEIF MARK:(ARG):2 >= 1
	PRINTFORML 자신이 사라져 버리는 공포와
	PRINTFORML 더 이상 조교당하지 않아도 된다는 안도가 뒤섞인 글이 적혀 있었다……
;それ以外
ELSE
	;白刃一閃は捕えていない
	IF 依頼フラグ:[[依頼:하얀칼날의후계자]]:0 == 1
		PRINTFORML 잇센이 구하러 오기 전에 사라져 버리는 것에 대한 사죄가 적혀 있었다……
	ELSE
		;一閃がいる場合
		IF GETCHARA([[キャラ:카즈토]]) >= 0
			PRINTFORML %CALLNAME:MASTER%와 자신을 구해주지 않은 잇센을 향한 원망이 적혀 있었다……
		ELSE
			PRINTFORML 이곳에는 없는 잇센을 향한 마음이 적혀 있었다……
		ENDIF
	ENDIF
ENDIF


;=============================================================
;戦闘メッセージ
;=============================================================
;--------------------------------------------------
;リアクション
;--------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:엔젤]]_3, ARG, ARG:1, ARG:2

;味方パーティでのデビルＣＯ－ＯＰ発動時の台詞
IF TFLAG:전투이벤트 == 1
		BTL_KOJO_RESULTS:0 = 지금입니다읏

;味方パーティでのデビルＣＯ－ＯＰ参加時の台詞
ELSEIF TFLAG:전투이벤트 == 2
		BTL_KOJO_RESULTS:0 = 갑니다읏
;回避された
ELSEIF TFLAG:전투이벤트 == 17
	;まずはムフフとそれ以外に分岐
	IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 오옷 __P0__ 공격에 집중할 수 없어읏 __P1__
		ELSE
			BTL_KOJO_RESULTS:0 = 하웃 __P0__
			BTL_KOJO_RESULTS:1 = 전투 중인데도읏 __P0__
		ENDIF
	ELSE
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 피한 건가요?
		ELSE
			BTL_KOJO_RESULTS:0 = 뭐가 잘못되었던 걸까요
		ENDIF
	ENDIF


;バトルに勝利した
ELSEIF TFLAG:전투이벤트 == 90
		BTL_KOJO_RESULTS:0 = 방심은 금물입니다
;戦闘開始時
ELSEIF TFLAG:전투이벤트 == 94
	;白刃一閃戦のみ喋る
	IF 依頼フラグ:[[依頼:하얀칼날의후계자]]:0 == 1 && FINDCHARA_ENEMY([[キャラ:카즈토]])
		;恋慕、親愛
		IF TALENT:(ARG):연모 || TALENT:(ARG):친애
			BTL_KOJO_RESULTS:0 = 잇센 씨가 정의를 위해 싸우듯이
			BTL_KOJO_RESULTS:1 = %CSTR:일인칭%은 %CALLNAME:PLAYER%을(를) 위해 싸우겠습니다!
		;淫乱、娼婦
		ELSEIF TALENT:(ARG):음란 || TALENT:(ARG):창부
			BTL_KOJO_RESULTS:0 = 또 여자를 홀리고 다니신 거군요, 잇센 씨
			BTL_KOJO_RESULTS:1 = 나쁜 사람♪
		;服従、隷属
		ELSEIF TALENT:(ARG):복종 || TALENT:(ARG):예속
			BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 적이에요
			BTL_KOJO_RESULTS:1 = 쓰러뜨리고 여자는 노예로 삼아 버리죠
		;屈服刻印Lv1以上
		ELSEIF MARK:(ARG):2 >= 1
			BTL_KOJO_RESULTS:0 = 죄송해요, 잇센 씨
			BTL_KOJO_RESULTS:1 = 악마는 계약을 거스를 수 없어요…
		ELSE
			BTL_KOJO_RESULTS:0 = 이런 형태로 재회하게 되다니……
		ENDIF
	ELSE

	ENDIF

ENDIF



@KOJO_BATTLE_MESSAGE_K[[キャラ:엔젤]]_3,ARG,ARG:1 = 0
;楽する用
IF 0

