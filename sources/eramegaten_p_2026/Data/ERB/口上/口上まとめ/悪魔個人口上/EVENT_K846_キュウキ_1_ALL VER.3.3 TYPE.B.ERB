;
;TSTR:네비_시추에이션_메인		主に呼び出しタイミングを定義(戦闘開始/メイン画面/戦闘終了)
;TSTR:네비_시추에이션_서버1		状況を定義
;TSTR:네비_시추에이션_서버2		状況の補足オプション
;=========================================
@KOJO_BATTLE_NAVI_K[[キャラ:궁기]]_1, ARG
;SETCOLOR 0x5abeff
VARSET LOCALS
CALL 口上変数初期化
LOCALS = %CALLNAME:TARGET%
;LOCALS   = 名前
;LOCALS:1 = １行目
;LOCALS:2 = ２行目
;LOCALS:3 = ３行目
;LOCALS:4 = ４行目
;LOCALS:5 = ５行目
;　：
;　：
;LOCALS:30 = ３０行目
SELECTCASE TSTR:네비_시추에이션_메인
	CASE "戦闘開始"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "통상"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "格下"
						IF TFLAG:적초기배치수 == 4
							;敵数4
							BTL_KOJO_RESULTS:0 = 적 넷。끝나면 불러주세요～
						ELSEIF TFLAG:적초기배치수 == 3
							;敵数3
							BTL_KOJO_RESULTS:0 = 적 삼 체ー。이런 건 속공인거죠오？
						ELSEIF TFLAG:적초기배치수 == 2
