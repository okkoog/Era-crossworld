							BTL_KOJO_RESULTS:1 = 분수를 몰라도 정도가 있지
						ELSE
							;敵数5以上
							BTL_KOJO_RESULTS:0 = 대단한 건 숫자 뿐이에요
							BTL_KOJO_RESULTS:1 = 이런 거, %CSTR:이인칭%라면 손가락 하나로 충분하죠？
						ENDIF
						CFLAG:814 = 0
					CASE "同格"
						IF TFLAG:적초기배치수 == 1
							BTL_KOJO_RESULTS:0 = 폼 잡으면서 고독한 늑대 행세、뭐 그런 건가요
							BTL_KOJO_RESULTS:1 = 그 콧등, 꺾어버리자구요
						ELSE
							BTL_KOJO_RESULTS:0 = 전력에 큰 차이는 없어요
							BTL_KOJO_RESULTS:1 = 요컨대, %CSTR:이인칭%의 전략에 달려있다는 거죠오
						ENDIF
						CFLAG:814 = 0
					CASE "格上"
						;敵数１
						IF TFLAG:적초기배치수 == 1
							BTL_KOJO_RESULTS:0 = %CSTR:이인칭%도 도전정신이 강하시네요
							BTL_KOJO_RESULTS:1 = %CALLNAME:ASSI%쨩이 지켜봐드릴테니, 제대로 힘내주세요
						ELSE
							BTL_KOJO_RESULTS:0 = 격이 높은 군세라니 평범하게 최악이네요
							BTL_KOJO_RESULTS:1 = ……아아, 죽으면 유골은 수습해드릴테니까
						ENDIF
						CFLAG:814 = 0
				ENDSELECT
			CASE "先制攻撃"
				IF RAND:3 == 0
