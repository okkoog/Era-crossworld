;-------------------------------------------------
;妊娠発覚時
;-------------------------------------------------
CASE 11
	SIF CFLAG:271 >= 1 && FLAG:7 != 2
		RETURN 0
	CALL EVENT_MESSAGE
;妊娠対象をTARGETに格納し、父親は奴隷はV、助手はWとする
;崩壊してしまった場合
	IF TALENT:9 == 1
		PRINTFORMW 
;父親が主人で母親が恋慕か親愛持ち
	ELSEIF (TALENT:3 || TALENT:6)
		IF CFLAG:102 == 1
			IF FAVORITE_1(TARGET) == MASTER
					PRINTFORML 「우후후, 기뻐라 %UNICODE(0x2661)% 」
					PRINTFORML %CALLNAME%은(는) 행복한 듯이 미소짓고 있다
			ELSE
				PRINTFORMW 
			ENDIF
		ELSE
			IF FAVORITE_1(TARGET) != MASTER
				IF TALENT:ＮＴＲ == 1
					PRINTFORML 
					PRINTFORMW 「있지있지♪ 알고 있겠지만 말야아」
					PRINTFORML 「이 아이, %CALLNAME:MASTER%의 아이가 아니니까」
					PRINTFORML 「전혀 신경 써주질 않으니 당연한 거잖아-」
					PRINTFORMW 「그 사람은 %CSTR:12%보다 훨~씬 상냥하고, 정액도 핥기만 해도 임신할 것 같을 정도로 진하거든 %UNICODE(0x2661)% 」
					PRINTFORML 「앗%UNICODE(0x2661)% 떠올리니까 젖어버렸어%UNICODE(0x2661)% %CSTR:일인칭% 그 사람한테 보고하러 갈 테니까, 그럼 안녕♪」
					PRINTFORML 
				ELSEIF TALENT:ＮＴＲ == 3
					PRINTFORMW 「」
				ENDIF
			ELSE
				PRINTFORMW 
			ENDIF
		ENDIF
;父親が奴隷か助手で母親が淫乱か娼婦持ち
