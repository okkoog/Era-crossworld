			ENDIF
		ENDIF
;服従か隷属持ち
	ELSEIF (TALENT:5 || TALENT:8)
		IF CFLAG:102 == 1
			IF FAVORITE_1(TARGET) == MASTER
				PRINTFORMW 
			ELSE
				PRINTFORMW 
