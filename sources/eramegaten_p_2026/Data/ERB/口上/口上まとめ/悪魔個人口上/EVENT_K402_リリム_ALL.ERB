			PRINTFORMW 「있지♪, 지금부터 한 명 더 만들자 %UNICODE(0x2661)% 」
		;父親(助手）との相性が125より大きい場合
		ELSEIF CFLAG:102 == 2 && GET_RELATION(TARGET, W) > 125
			PRINTFORMW 
	 	;父親(奴隷）との相性が125より大きい場合
		ELSEIF CFLAG:102 == 3 && GET_RELATION(TARGET, V) > 125
			PRINTFORMW 
		ELSE
			IF FAVORITE_1(TARGET) != MASTER
				IF TALENT:ＮＴＲ == 1
					PRINTFORML 
					PRINTFORML 「아기가 생겨버렸어 %UNICODE(0x2661)% 우후후 %UNICODE(0x2661)% 」
					PRINTFORMW （그 사람의 아이야아♪）
					PRINTFORML （누구에게나 가랑이를 벌려버리는 %CSTR:일인칭%을(를), 『사랑해』라고 말해준 사람의 아이야아%UNICODE(0x2661)%）
					PRINTFORMW （하앙 %UNICODE(0x2661)% 젖어버렸어… 그 사람의 딱딱한 자지 원해져버렸는걸 %UNICODE(0x2661)% ）
