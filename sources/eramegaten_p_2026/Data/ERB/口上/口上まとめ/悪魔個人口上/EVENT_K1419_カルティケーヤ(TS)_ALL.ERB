ENDIF

@KOJO_BATTLE_EVENT_K[[キャラ:카르티케야]]_1, ARG, ARG:1, ARG:2

;-------------------------------------------------
;○味方パーティでのデビルＣＯ－ＯＰ発動時の台詞
;-------------------------------------------------
IF TFLAG:전투이벤트 == 1
	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
	IF RAND: 2 == 0
		PRINTFORML ┃%"一緒行！",72,LEFT%┃
	ELSE
		PRINTFORML ┃%"私逃읏！",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○味方パーティでのデビルＣＯ－ＯＰ参加時の台詞
;通常攻撃も喋るようになっていなければ喋らない
;-------------------------------------------------
IF TFLAG:전투이벤트 == 2
	PRINTFORML ┏＠%NAME:ARG,10,LEFT%━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
	IF RAND:2 == 0
		PRINTFORML ┃%"一緒行！",72,LEFT%┃
	ELSE
		PRINTFORML ┃%"韋駄天！追撃！",72,LEFT%┃
	ENDIF
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF

;-------------------------------------------------
;○味方パーティでの被召喚時の台詞
;-------------------------------------------------
IF TFLAG:전투이벤트 == 3
	PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
	PRINTFORML ┃%"韋駄天、出撃─！",72,LEFT%┃
	PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF



;-------------------------------------------------
;○攻撃系イベント口上
;-------------------------------------------------
IF TFLAG:전투이벤트 == 11
	;攻撃して撃破
	IF BASE:(ARG:1):ＨＰ <= 0
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
