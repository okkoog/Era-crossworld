			PRINTFORML ┃%"읏、私一番！",72,LEFT%┃
		ELSE
			PRINTFORML ┃%"읏私、速！",72,LEFT%┃
		ENDIF
		PRINTFORML ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
	ENDIF
ENDIF

;-------------------------------------------------
;○被弾系口上
;-------------------------------------------------
IF TFLAG:전투이벤트 == 12
	;被弾（戦闘不能）
	IF BASE:ARG:ＨＰ <= 0
		PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
