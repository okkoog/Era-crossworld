;ライセンスについて
;	・基本項目(許可する項目を"○"に、許可しない項目を"×"に変更してください。)
;	+----+----+-------------------------------+
;	|番号|許可|ライセンス内容                 |
;	+----+----+-------------------------------+
;	|   1| ○ | 処理上のバグ修正              |
;	+----+----+-------------------------------+
;	|   2| ○ | 口上の誤字・脱字の修正        |
;	+----+----+-------------------------------+
;	|   3| ○ | 口上まとめへの収録            |
;	+----+----+-------------------------------+
;	|   4| ○ | 口上の新規追加                |
;	+----+----+-------------------------------+
;	|   5| ○ | 既存口上の改変                |
;	+----+----+-------------------------------+
;	|   6| ○ | 改変した口上の自由な再配布    |
;	+----+----+-------------------------------+
;	|   7| ○ | 口上内容の転載                |
;	+----+----+-------------------------------+

;=============================================================
;戦闘メッセージ
;=============================================================
;--------------------------------------------------
;リアクション
;--------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:라타토스크]]_11, ARG, ARG:1, ARG:2
SIF ARG < 0 && NO:ARG != 813
	RETURN 0
VARSET LOCALS
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
			SELECTCASE RAND:2
				CASE 0
					LOCALS:10 = んっ%ハート()%　チャ、ンス、だけどぉっ%ハート()%　ダメっ%UNICODE(0x2661)% イっくぅ！%ハート()%
				CASE 1
					LOCALS:10 = あっ%ハート()%　チャンスっ%ハート()% きたっ%ハート()% きたきたきたきたっ%ハート()% ～～～っ！%ハート()%%ハート()%
			ENDSELECT
		ELSEIF TALENT:복종 || TALENT:예속
			SELECTCASE RAND:2
				CASE 0
					LOCALS:10 = い、今です、%CSTR:이인칭%っ！
				CASE 1
					LOCALS:10 = %CSTR:일인칭%、やりましたっ
			ENDSELECT
		ELSEIF 現HP割合(ARG) < 25
			SELECTCASE RAND:3
				CASE 0
					LOCALS:10 = 今っ……だあああ！！
				CASE 1
					LOCALS:10 = いっけぇぇーーっ！！
				CASE 2
					IF 陥落()
						LOCALS:10 = %CSTR:이인칭%と……勝ちたい！
					ELSE
						LOCALS:10 = うわああああ！！
					ENDIF
			ENDSELECT
		ELSE
			IF 陥落()
				SELECTCASE RAND:4
					CASE 0
						LOCALS:10 = ！ %CSTR:이인칭%！ 今ならいけるかも！
					CASE 1
						LOCALS:10 = %CSTR:이인칭%、今だよーっ！
					CASE 2
						LOCALS:10 = みんな、いっくよーっ！
					CASE 3
						LOCALS:10 = いっしょに行こっ、%CSTR:이인칭%！
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						LOCALS:10 = 今だよーっ！
					CASE 1
						LOCALS:10 = いっしょに行こっ！
				ENDSELECT
			ENDIF
		ENDIF
	;COOP参加
	CASE 2
		IF FLAG:행동순1 != -1
			IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
				SELECTCASE RAND:3
					CASE 0
						LOCALS:10 = キモチいいっ%ハート()%　キモチいいよぉっ%ハート()%
					CASE 1
						LOCALS:10 = %CSTR:일인칭%もっ%ハート()%　イくっ%ハート()%　イくぅっ！%ハート()%
					CASE 2
						LOCALS:10 =  あんっ%ハート()%　イ、イかなきゃっ%ハート()% イくっ！%ハート()%
				ENDSELECT
			ELSEIF FLAG:행동순1 == MASTER
				;主人がCOOP発動
				IF 現HP割合(ARG) < 25
					SELECTCASE RAND:4
						CASE 0
							LOCALS:10 = %CSTR:이인칭%！ %CSTR:일인칭%、まだ動けるよ……！
						CASE 1
							LOCALS:10 = %CSTR:이인칭%も、がんばってるもん……！
						CASE 2
							LOCALS:10 = %CSTR:일인칭%も、いくよ……！
						CASE 3
							LOCALS:10 = からだ……動いてええ！！
					ENDSELECT
				ELSE
					SELECTCASE RAND:4
						CASE 0
							LOCALS:10 = %CSTR:이인칭%、すごーい！
						CASE 1
							LOCALS:10 = %CSTR:이인칭%かっこいー！
						CASE 2
							LOCALS:10 = %CSTR:일인칭%もやるぞー！
						CASE 4
							LOCALS:10 = %CSTR:이인칭%！ %CSTR:일인칭%もいっしょに！
					ENDSELECT
				ENDIF
			ELSE
				;それ以外
				IF 現HP割合(ARG) < 25
					SELECTCASE RAND:2
						CASE 0
							LOCALS:10 = %CSTR:일인칭%も、いくよ……！
						CASE 1
							LOCALS:10 = からだ……動いてええ！！
					ENDSELECT
				ELSE
					SELECTCASE RAND:4
						CASE 0
							LOCALS:10 = よーし、やるぞー！
						CASE 1
							LOCALS:10 = いっくよー！
						CASE 2
							LOCALS:10 = %CSTR:일인칭%もガンバるね！
						CASE 3
							LOCALS:10 = まだまだー！
					ENDSELECT
				ENDIF
			ENDIF
		ENDIF
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
				SELECTCASE RAND:3
					CASE 0
						LOCALS:10 = あっ%ハート()% はぁんっ%ハート()% た、たおした？%ハート()%
					CASE 1
						LOCALS:10 = んぅっ%ハート()% %CSTR:이인칭%、や、やっつけたよっ%ハート()% あんっ%ハート()%
					CASE 2
						LOCALS:10 = ううっ%ハート()% たおせた、けどぉっ%ハート()% ぶるぶるしてるぅっ%ハート()%
				ENDSELECT
			ELSEIF 現HP割合(ARG) < 25
				SELECTCASE RAND:3
					CASE 0
						LOCALS:10 = たおせた……？
					CASE 1
						LOCALS:10 = か、かった……！
					CASE 2
						LOCALS:10 = %CSTR:이인칭%、やったよ……！
				ENDSELECT
			ELSEIF TALENT:복종 || TALENT:예속
				SELECTCASE RAND:2
					CASE 0
						LOCALS:10 = やった……！ やっつけました、%CSTR:이인칭%！
					CASE 1
						LOCALS:10 = %CSTR:일인칭%、やりました……！
				ENDSELECT
			ELSE
				SELECTCASE RAND:4
					CASE 0
						LOCALS:10 = %CSTR:이인칭%、やっつけたよ！
					CASE 1
						LOCALS:10 = %CSTR:일인칭%、やったよー！
					CASE 2
						LOCALS:10 = よーし！ どんどんいくよー！
					CASE 3
						LOCALS:10 = やったやったぁ！
				ENDSELECT
			ENDIF
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				LOCALS:10 = …あ、あれれ？ じゃくてん、だよね？
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;ムフフ時
		ELSEIF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]]) && ダメージ割合(ARG:1, ARG:2) > 0
			SELECTCASE RAND:3
				CASE 0
					LOCALS:10 = とおっ%ハート()% ゆ、ゆれちゃうよぉっ%ハート()%
				CASE 1
					LOCALS:10 = んぅっ%ハート()% おくっ%ハート()% ぐりぐりしてっ%ハート()% あんっ%ハート()%
				CASE 2
					LOCALS:10 = え、エッチなおとっ%ハート()% しちゃってるよぉ%ハート()%
			ENDSELECT
		;ピンチ時
		ELSEIF 現HP割合(ARG) < 25
			SELECTCASE RAND:3
				CASE 0
					LOCALS:10 = うあああっ！
				CASE 1
					LOCALS:10 = まっ……だまだー！
				CASE 2
					LOCALS:10 = 当たった……！
			ENDSELECT
		ELSEIF TALENT:복종 || TALENT:예속
			SELECTCASE RAND:2
				CASE 0
					LOCALS:10 = このままたおし……ます！
				CASE 1
					LOCALS:10 = %CSTR:일인칭%にまかせてください……！
			ENDSELECT
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = わっ！ 当たった！
				CASE 1
					LOCALS:10 = とうっ！
				CASE 2
					LOCALS:10 = この調子ならいけるかも！
				CASE 3
					LOCALS:10 = %CSTR:일인칭%にまっかせてー！
			ENDSELECT
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			IF TALENT:복종 || TALENT:예속
				SELECTCASE RAND:2
					CASE 0
						LOCALS:10 = ひっ……！ お、おこられちゃう……！
					CASE 1
						LOCALS:10 = し、しっぱい……しちゃった……
				ENDSELECT
			ELSEIF 現HP割合(ARG) < 25
				SELECTCASE RAND:3
					CASE 0
						LOCALS:10 = こ、これじゃ、ダメ……！
					CASE 1
						LOCALS:10 = このままじゃ、まけちゃう……？
					CASE 2
						LOCALS:10 = こうげき、きいてない……
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						LOCALS:10 = えーっ！？ な、なんでー！？
					CASE 1
						LOCALS:10 = きいてないよーっ！
					CASE 2
						LOCALS:10 = %CSTR:이인칭%！ あの子、へ、へいきそうだよ！？
				ENDSELECT
			ENDIF
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			;ムフフで死亡
			IF FLAG:무후후전개 == 1 && (TEQUIP:86 == [[衣装:바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ａ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:Ｗ바이브달린쇼츠]] || TEQUIP:86 == [[衣装:꼬리플러그]])
				SELECTCASE RAND:2
					CASE 0
						LOCALS:10 = あっ%ハート()% ダメぇっ%ハート()% イっちゃ、ダメ、なのにぃ……%ハート()%
					CASE 1
						LOCALS:10 = これじゃ、たたかえないよぉ……
				ENDSELECT
			ELSEIF TALENT:복종 || TALENT:예속
				SELECTCASE RAND:2
					CASE 0
						LOCALS:10 = ごめん、なさい……
					CASE 1
						LOCALS:10 = やめて……おこらないで……
				ENDSELECT
			ELSE
				SELECTCASE RAND:4
					CASE 0
						LOCALS:10 = つよい、ね……やられ……
					CASE 1
						LOCALS:10 = あきら……め……
					CASE 2
						LOCALS:10 = あ、あれっ？ 力がぬけて……
					CASE 3
						LOCALS:10 = ごめんね、%CSTR:이인칭%……
				ENDSELECT
			ENDIF
		;服従ルート専用
		ELSEIF TALENT:복종 || TALENT:예속
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = こんなの、いたくないもん……！
				CASE 1
					LOCALS:10 = だ、大丈夫です！ %CSTR:일인칭%、ちゃんとやれます……！
				CASE 2
					LOCALS:10 = じゃ、じゃましないでよ……！
				CASE 3
					LOCALS:10 = もたもたしてるって、思われちゃう……！
			ENDSELECT
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 25
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = はぁ、はぁ……あ、諦めない、もん……
				CASE 1
					LOCALS:10 = %CSTR:이인칭%、ピンチだよー……
				CASE 2
					LOCALS:10 = ぜぇっ、ぜぇっ、ぜぇっ……
				CASE 3
					LOCALS:10 = ま、まだまだだよ……
			ENDSELECT
		;中ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 50
			SELECTCASE RAND:3
				CASE 0
					LOCALS:10 = くぅっ！ つ、強いね！
				CASE 1
					LOCALS:10 = うわあーっ！？
				CASE 2
					LOCALS:10 = うぅっ！ ま、負けないもん！
			ENDSELECT
		;小ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 75
			SELECTCASE RAND:3
				CASE 0
					LOCALS:10 = ありゃりゃっ！？
				CASE 1
					LOCALS:10 = いったーい！
				CASE 2
					LOCALS:10 = やったなー！ つぎは%CSTR:일인칭%の番だー！
			ENDSELECT
		;微ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50 || 現HP割合(ARG) < 100
			SELECTCASE RAND:3
				CASE 0
					LOCALS:10 = 大丈夫、へーきへーき！
				CASE 1
					LOCALS:10 = これぐらい、へっちゃらだよ！
				CASE 2
					LOCALS:10 = %CSTR:일인칭%は強いのだー！ えっへん！
			ENDSELECT
		;無効
		ELSEIF ARG:2 == 0
			IF 現HP割合(ARG) < 25
				SELECTCASE RAND:3
					CASE 0
						LOCALS:10 = それはきかないよ……！
					CASE 1
						LOCALS:10 = っ！ これなら、へいき……！
					CASE 2
						LOCALS:10 = まだ、やられないよ……！
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						LOCALS:10 = きかないよー！
					CASE 1
						LOCALS:10 = じゃじゃーん！ むこう？ だよ！
					CASE 2
						LOCALS:10 = ぜんぜん、へっちゃらだもんね！
				ENDSELECT
			ENDIF
		;吸収
		ELSEIF ARG:2 < 0
			IF 現HP割合(ARG) < 25
				SELECTCASE RAND:3
					CASE 0
						LOCALS:10 = それはきかないよ……！
					CASE 1
						LOCALS:10 = っ！ これなら、へいき……！
					CASE 2
						LOCALS:10 = まだ、やられないよ……！
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						LOCALS:10 = きかないよー！
					CASE 1
						LOCALS:10 = じゃじゃーん！ きゅーしゅー？ だよ！
					CASE 2
						LOCALS:10 = えへへ、かいふくできたよ！
				ENDSELECT
			ENDIF
		ENDIF
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE 13
		;全弾命中した
		IF ARG:2 == 0
			IF TALENT:복종 == 0 || TALENT:예속 == 0
				IF 現HP割合(ARG) < 25
					LOCALS:10 = ぜんぶ、当たった……！
				ELSE
					SELECTCASE RAND:4
						CASE 0
							LOCALS:10 = 見て見てー！ 当たった当たったー！
						CASE 1
							LOCALS:10 = えへへ、やったー！
						CASE 2
							LOCALS:10 = 今日の%CSTR:일인칭%、すっごいかも！
						CASE 3
							LOCALS:10 = これが練習のせいかだよ！
					ENDSELECT
				ENDIF
			ENDIF
		;普通
		ELSEIF ARG:2 < ARG:1
			IF TALENT:복종 == 0 || TALENT:예속 == 0
				IF 現HP割合(ARG) < 25
					LOCALS:10 = 当たった……！
				ELSE
					SELECTCASE RAND:4
						CASE 0
							LOCALS:10 = あっ、ずれちゃった！？
						CASE 1
							LOCALS:10 = わっ、ちょっとよけられてる！
						CASE 2
							LOCALS:10 = まあまあ当たったね！
						CASE 3
							LOCALS:10 = よーし、つぎはぜんぶ当てるぞー！
					ENDSELECT
				ENDIF
			ENDIF
		;全弾回避された
		ELSEIF ARG:2 == ARG:1
			IF TALENT:복종 == 0 || TALENT:예속 == 0
				IF 現HP割合(ARG) < 25
					LOCALS:10 = 外しちゃった……！？
				ELSE
					SELECTCASE RAND:4
						CASE 0
							LOCALS:10 = ガーン！ ぜんぶ外しちゃった！？
						CASE 1
							LOCALS:10 = えーっ！？ 当たらないの！？
						CASE 2
							LOCALS:10 = みんなはやいね！？
						CASE 3
							LOCALS:10 = むむむ、つぎは当てるもん！
					ENDSELECT
				ENDIF
			ENDIF
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE 14
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = %CSTR:일인칭%、こんなにやっつけたよ！
				CASE 1
					LOCALS:10 = やっ……やったやったやったぁ！！
				CASE 2
					LOCALS:10 = %CSTR:이인칭%！ 今の見た！？ 今の見たぁ！？
				CASE 3
					LOCALS:10 = えっへん！ だれにも%CSTR:일인칭%は止められなーい！
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
					LOCALS:10 = あうぅ、たおせなかった……
				CASE 1
					LOCALS:10 = あれー？ いっぱいこーげきしたのに？
				CASE 2
					LOCALS:10 = わっ！ とってもがんじょーだよ、%CSTR:이인칭%！
				CASE 3
					LOCALS:10 = トドメはおねがい！
			ENDSELECT
		ENDIF
	;反射された
	CASE 15
		IF TALENT:복종 || TALENT:예속
			SELECTCASE RAND:2
				CASE 0
					LOCALS:10 = ひっ……！ お、おこられちゃう……！
				CASE 1
					LOCALS:10 = し、しっぱい……しちゃった……
			ENDSELECT
		ELSEIF 現HP割合(ARG) < 25
			SELECTCASE RAND:3
				CASE 0
					LOCALS:10 = こ、これじゃ、ダメ……！
				CASE 1
					LOCALS:10 = このままじゃ、まけちゃう……？
				CASE 2
					LOCALS:10 = こうげき、きいてない……
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					LOCALS:10 = うわあっ！？ あぶなーい！
				CASE 1
					LOCALS:10 = はねかえっちゃった！？
				CASE 2
					LOCALS:10 = あわわわわっ！？
			ENDSELECT
		ENDIF
	;反射した
	CASE 16
		IF TALENT:복종 || TALENT:예속
			SELECTCASE RAND:2
