;妻の数をカウントする（口上用ギミック）
;-------------------------------------------------
@COUNT_TALLENT_K[[キャラ:스세리비메]]_1
;ループのカウント
#DIM DYNAMIC LCOUNT
;妻のカウント
#DIM DYNAMIC WCOUNT
;カウントの初期化
WCOUNT = 0

;キャラ番号1番から最後のキャラ番号までループ
;あなたは0番なので1からスタートして最後のキャラ番号はCHARANUM-1、CHARANUMと同じ数値はループ条件から外れるのでチェックされない
;例：あなた含めて10人（CHARANUM）ならキャラ番号1番から9番までをチェックし、ループカウントが10（CHARANUMと同値）になってループを抜ける
FOR LCOUNT, 1, CHARANUM
	;妻だったらカウントする（カウントしたい素質番号を送る受け取るようにすれば他の素質もカウントできるはず）
	IF TALENT:LCOUNT:아내 == 1
		WCOUNT += 1
		;妻の数が分岐の上限になったらカウントを終了して抜ける
		IF WCOUNT >= 11
			RETURN WCOUNT
		ENDIF
	ENDIF
NEXT

RETURN WCOUNT
