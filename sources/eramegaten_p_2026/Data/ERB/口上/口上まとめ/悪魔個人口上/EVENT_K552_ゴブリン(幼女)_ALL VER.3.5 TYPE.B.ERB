	PRINTL [0] 네
	PRINTL [1] 아니오
	$INPUT_LOOP
	INPUT
	IF RESULT == 0
		PRINTFORMW ―구상 상정 소질 모드로 소질、능력을 변경합니다―
		TALENT:TARGET:0 = 1
		ABL:TARGET:4 = 0
		EXP:TARGET:0 = 0
		
		;口調変更
		CALLNAME = ゴブリン
		CSTR:이인칭 = 인가안
		CSTR:일인칭 = 나
		;削除素質
		TALENT:남자 = 0
		TALENT:남성혐오= 0
		TALENT:절벽= 0
		TALENT:냉정 = 0
		TALENT:교활 = 0
		;追加素質
		TALENT:처녀 = 1
		TALENT:음모없음 = 1
		TALENT:부끄럼없음 = 1
		TALENT:영맹 = 1
		TALENT:악취둔감 = 1
		TALENT:유치 = 1
		TALENT:빈유 = 1
		TALENT:並尻 = 1
		TALENT:무기 = 1
		
		;衣装チェンジ
		CFLAG:초기하의 = 217;파레오
		CFLAG:하의 = 217;파레오
		TEQUIP:하의 = 217;파레오
		CALL SET_初期衣装, "전신속옷" , -1 , TARGET
		CALL SET_初期衣装, "그외" , -1 , TARGET
		
		;外見設定
		CSTR:머리색 = 白
		CSTR:체형 = 땋은 머리
		CSTR:눈동자색 = 赤色
		CSTR:피부색 = 緑
		
	ELSEIF RESULT == 1
		PRINTFORMW ―통상 모드로 조교를 개시합니다―
	ELSE
		GOTO INPUT_LOOP
	ENDIF
	CFLAG:220 = 1
ENDIF

