;反応チェッカー（カラドリウス専用）
@ALL_FEEL_CHECKER_カラドリウス
;言葉も出ない（欲情のPALAMLV5以上＋その調教での絶頂回数200以上＋残り体力が2000未満）
IF PALAM:6 >= PALAMLV:5 && CFLAG:806 >= 200 && BASE:0 < 2000
	CFLAG:801 = 4
;喘ぎまくる（欲情のPALAMLV5以上＋その調教での絶頂回数50以上）
ELSEIF PALAM:6 >= PALAMLV:5 && CFLAG:806 >= 50
	CFLAG:801 = 3
;声が明確に出る（欲情のPALAMLV5以上＋その調教での絶頂回数5以上）
ELSEIF PALAM:6 >= PALAMLV:5 && CFLAG:806 >= 5
	CFLAG:801 = 2
;マグロ・声が漏れる
ELSE
	CFLAG:801 = 1
ENDIF


;着用物による快楽度チェック
@TEQUIP_FEEL_CHECKER_カラドリウス
IF TEQUIP:클리캡 || TEQUIP:오나홀
	CALL FEEL_CHECKER_C_カラドリウス
	IF CFLAG:800 > CFLAG:804
		CFLAG:804 = CFLAG:800
	ENDIF
ENDIF
IF TEQUIP:바이브 || TEQUIP:Ｖ섹스 || TEQUIP:Ｖ손가락삽입
	CALL FEEL_CHECKER_V_カラドリウス
	IF CFLAG:800 > CFLAG:804
		CFLAG:804 = CFLAG:800
	ENDIF
ENDIF
IF TEQUIP:애널바이브 || TEQUIP:애널비즈 || TEQUIP:Ａ섹스 || TEQUIP:Ａ손가락삽입 || TEQUIP:관장기＋플러그 || TEQUIP:확장벌룬 || TEQUIP:애널전극
	CALL FEEL_CHECKER_A_カラドリウス
	IF CFLAG:800 > CFLAG:804
		CFLAG:804 = CFLAG:800
	ENDIF
ENDIF
IF TEQUIP:유두캡 || TEQUIP:착유기 || TEQUIP:유방전극
	CALL FEEL_CHECKER_B_カラドリウス
	IF CFLAG:800 > CFLAG:804
		CFLAG:804 = CFLAG:800
	ENDIF
ENDIF

