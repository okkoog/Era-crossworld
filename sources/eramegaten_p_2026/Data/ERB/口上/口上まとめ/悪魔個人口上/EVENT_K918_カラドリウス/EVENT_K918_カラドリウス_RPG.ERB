			CASE 1
				BTL_KOJO_RESULTS:0 = その攻撃は予防済みよ
			CASE 2
				BTL_KOJO_RESULTS:0 = この攻撃、問題なく対処できるわ
		ENDSELECT
	;回避した
	CASE "回避した"
		SELECTCASE RAND:2
			CASE 0
