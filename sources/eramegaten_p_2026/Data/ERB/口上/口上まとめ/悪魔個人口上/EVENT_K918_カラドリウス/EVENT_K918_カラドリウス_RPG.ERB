;-------------------------------------------------
;戦闘中のイベント関連
;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:라타토스크]], ARG, ARG:1, ARG:2
SELECTCASE GET_BATTLE_EVENT(TFLAG:전투이벤트)
	;COOP発動 発動者の番号はARGに格納されている
	CASE "COOP発動"
		SELECTCASE RAND:3
			CASE 0
				BTL_KOJO_RESULTS:0 = 崩れたわ、今よ
			CASE 1
				BTL_KOJO_RESULTS:0 = チャンスよ、畳みかけて
			CASE 2
				BTL_KOJO_RESULTS:0 = これで追撃できるかしら？
		ENDSELECT
	;COOP参加
	CASE "COOP参加"
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = ついていくわ、%CSTR:ARG:이인칭%
				CASE 1
					BTL_KOJO_RESULTS:0 = %CSTR:ARG:이인칭%に合わせるわ
				CASE 2
					BTL_KOJO_RESULTS:0 = この時を、待っていた
			ENDSELECT
		;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 追撃、担当するわ
				CASE 1
					BTL_KOJO_RESULTS:0 = そこね、任せて
				CASE 2
					BTL_KOJO_RESULTS:0 = まだ終わりじゃないわ
			ENDSELECT
		ENDIF
	;被召喚時
	CASE "被召喚"
		BTL_KOJO_RESULTS:0 = 
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE "与ダメージ_単体"
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 生命活動、停止したわ
				CASE 1
					BTL_KOJO_RESULTS:0 = 終わりよ
				CASE 2
					BTL_KOJO_RESULTS:0 = せめて安らかに逝ってちょうだい
			ENDSELECT
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				SELECTCASE RAND:3
					CASE 0
						BTL_KOJO_RESULTS:0 = ……今は追撃できないわね
					CASE 1
						BTL_KOJO_RESULTS:0 = 堅牢な守りね
					CASE 2
						BTL_KOJO_RESULTS:0 = 崩れないわね
				ENDSELECT
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 次にトドメを刺すわ
				CASE 1
					BTL_KOJO_RESULTS:0 = もうすぐよ、気を付けて行きましょう
				CASE 2
					BTL_KOJO_RESULTS:0 = このまま倒しきれるかしら
			ENDSELECT
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = 少しはダメージを与えられたかしら
				CASE 1
					BTL_KOJO_RESULTS:0 = 有効なようね、続けるわ
				CASE 2
					BTL_KOJO_RESULTS:0 = この攻撃は通るようね
			ENDSELECT
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = あまり効いていないようね
				CASE 1
					BTL_KOJO_RESULTS:0 = 手段を変えましょう、有効じゃないわ
				CASE 2
					BTL_KOJO_RESULTS:0 = このまま攻撃し続けるのは得策じゃないかしら……
			ENDSELECT
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			SELECTCASE RAND:3
				CASE 0
					BTL_KOJO_RESULTS:0 = ……ごめんなさい、無効化されたわ
				CASE 1
					BTL_KOJO_RESULTS:0 = この攻撃手段はダメみたいね
				CASE 2
					BTL_KOJO_RESULTS:0 = 全くダメージを受け付けていないようね
