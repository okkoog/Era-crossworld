			ENDSELECT
		ENDIF
	;敵味方全体攻撃(詳細処理無し)
	;CASE "敵味方全体攻撃"
	;	BTL_KOJO_RESULTS:0 = 
	;反撃を発動した
	CASE "反撃発動"
