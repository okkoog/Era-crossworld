			ENDSELECT
		;全弾回避された
		ELSEIF GET_CREC_ACT_SUM(ARG, "敵", "HIT") == 0
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = ……全部外してしまったわ……
				CASE 1
					BTL_KOJO_RESULTS:0 = ……全く捉えられないわ……
			ENDSELECT
		;普通
		ELSE
			SELECTCASE RAND:2
				CASE 0
					BTL_KOJO_RESULTS:0 = 命中よ
				CASE 1
					BTL_KOJO_RESULTS:0 = そこね
			ENDSELECT
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE "与ダメージ_範囲_ランダム_撃破あり"
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
