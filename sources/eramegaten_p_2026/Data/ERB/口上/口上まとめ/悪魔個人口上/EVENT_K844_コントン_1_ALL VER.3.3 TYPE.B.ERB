;掛け合いキャラがいるかを探す関数＠コントン用
;おそらくP(bazzile)ニキが改良してくれたんだと思うけど毎回KOJO_BATTLE_EVENTの先頭でやるのは無駄くない？って思ったので関数化
;現在の対象：トウテツ、トウコツ、キュウキ、ダークサマナー
@SEARCH_KAKEAI_FOR_HUNDUN, ARG
#FUNCTION
#DIM LCOUNT
#DIM L_POS, 6
#DIM L_CHARA
;掛け合い対象の検索
;味方POSをランダムな順で検索して最初にHITしたのが掛け合い対象となる
;こうやって書くとL_POS(0)=1, (1)=2って入るよ
L_POS = 1, 2, 3, 4, 5, 6
;念のため初期化
TFLAG:대화형캐릭터 = -1
;L_POSの中をめちゃくちゃに交換して
FOR LCOUNT, 0, 6
	SWAP L_POS:(RAND:6), L_POS:(RAND:6)
NEXT
;L_POS(0)～(5)のキャラクターを順々に見て、掛け合い対象者ならそいつの番号を返す。
;最後まで見つからなかったら-1返す。
FOR LCOUNT, 0, 6
	L_CHARA = POS(L_POS:LCOUNT)
	SIF !IS_TARGET_ABLE(L_CHARA)
		CONTINUE
	;自分自身は省く
	SIF ARG == L_CHARA
		CONTINUE
	;掛け合いキャラは入力可能な状態である必要がある
	SIF !INPUTABLE_CHARA_F(L_CHARA)
		CONTINUE
	;TS四凶 or ダマナー
	;増えてきたら一行で済ますのやめようかな…
	IF IS_TS_TAOTIE(L_CHARA) > 0 || IS_TS_TAOWN(L_CHARA) > 0 || IS_TS_KYUKI(L_CHARA) > 0 || NO:L_CHARA == [[キャラ:다크서머너]]
		TFLAG:대화형캐릭터 = L_CHARA
		RETURNF 1
	ENDIF
NEXT
RETURNF -1

