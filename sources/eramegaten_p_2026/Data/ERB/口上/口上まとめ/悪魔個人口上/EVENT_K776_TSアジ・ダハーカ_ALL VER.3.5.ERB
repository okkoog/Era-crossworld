;-------------------------------------------------
;人格を変更する処理（引き渡される値は調教開始時か強絶頂か）
;-------------------------------------------------
@CHANGE_PERSONAL_K[[キャラ:아지・다하카]]_1(ARG:0)
;調教開始時はどれになってもいい
IF ARG:0 == 0
	SELECTCASE RAND:3
		CASE 0
			CFLAG:803 = 1
		CASE 1
			CFLAG:803 = 2
		CASE 2
			CFLAG:803 = 3
	ENDSELECT
;強絶頂時は今と違う2つから選ばれる
ELSE
	SELECTCASE RAND:2
		CASE 0
			;メイン人格の時
			IF CFLAG:803 == 1
				CFLAG:803 = 2
			;サブ人格1の時
			ELSEIF CFLAG:803 == 2
				CFLAG:803 = 1
			;サブ人格2の時
			ELSE
				CFLAG:803 = 1
			ENDIF
		CASE 1
			;メイン人格の時
			IF CFLAG:803 == 1
				CFLAG:803 = 3
			;サブ人格1の時
			ELSEIF CFLAG:803 == 2
				CFLAG:803 = 3
			;サブ人格2の時
			ELSE
				CFLAG:803 = 2
			ENDIF
	ENDSELECT
ENDIF
;-------------------------------------------------
;再生するEDを決める条件判定、CFLAG:805の中身を確認してED条件を満たしたかどうかを返す
;-------------------------------------------------
@ENDING_SELECT_CHECK_K[[キャラ:아지・다하카]]_1
;フラグの中身チェック
;3桁目が1かどうか。100で割った商が1
IF CFLAG:805/100 == 1
	;2桁目が1かどうか。100で割った余りが10以上
	IF CFLAG:805%100 >= 10
		;1桁目が1かどうか。10で割った余りが1
		IF CFLAG:805%10 == 1
			;レベルも見る
			IF BASE:LV >= 90
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
ENDIF

RETURN 0

