		IF CFLAG:ARG:던전내발정 == 1 && GET_STATE(CFLAG:ARG:상태이상) == "HAPPY"
			BTL_KOJO_RESULTS:0 = 
		;頭の中がピンクに染まった
		ELSEIF CFLAG:ARG:던전내발정 == 1
			BTL_KOJO_RESULTS:0 = 
		;落ち着いた
		ELSEIF CFLAG:ARG:던전내발정 == 0
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;ターン終了時エクスリンケージ装備時のイベント口上2(ムフフ展開時のみ)
	CASE 54
		;中に注がれた精液が垂れてきた…
		BTL_KOJO_RESULTS:0 = 
	;バトルに勝利した
	CASE 90
			BTL_KOJO_RESULTS:0 = まあ、こんなところでしょう
	;レベルアップした
	CASE 91
			BTL_KOJO_RESULTS:0 = なんだか力が湧いてきます……！
	;逃走に成功した
	CASE 92
			BTL_KOJO_RESULTS:0 = 逃げましょう！逃げるが勝ちです！
	;逃走に失敗した
	CASE 93
			BTL_KOJO_RESULTS:0 = げっ、囲まれた……！
	;戦闘開始時
	CASE 94
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 
		ELSE
			BTL_KOJO_RESULTS:0 = 獲物がいました！
		ENDIF
	;バックアタックを受けた
	CASE 95
		IF 現HP割合(ARG) < 25
			;瀕死
			BTL_KOJO_RESULTS:0 = 
		ELSE
			BTL_KOJO_RESULTS:0 = まずいですね……敵のほうが有利な地形にいます！
		ENDIF
	;敵の先制攻撃を受けた
	CASE 96
