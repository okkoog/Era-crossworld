;-------------------------------------------------
@KOJO_BATTLE_EVENT_K[[キャラ:이계의다크서머너]], ARG, ARG:1, ARG:2
;-------------------------------------------------
SIF ARG < 0 && NO:ARG != 9500
	RETURN 0
VARSET BTL_KOJO_RESULTS
;VARSET KSTR

;KSTR:0 = 
;KSTR:1 = 
SELECTCASE TFLAG:전투이벤트
	;COOP発動 ARGは発動者
	CASE 1
		BTL_KOJO_RESULTS:0 = きたきた来ましたよ！私に続いてくださいっ！
	;COOP参加
	CASE 2
		;主人がCOOP発動
		IF FLAG:행동순1 != -1 && FLAG:행동순1 == MASTER
			BTL_KOJO_RESULTS:0 = この私の力を貸すのだから必ず仕留めてくださいよ%CALLNAME:MASTER%さん
		;それ以外
		ELSE
			BTL_KOJO_RESULTS:0 = はいはい、今いきますよっ
		ENDIF
	;被召喚時
	CASE 3
			BTL_KOJO_RESULTS:0 = 
	;공격　ARGが攻撃をする仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 11
		;味方に攻撃した
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;相手が死んだ
		IF BASE:(ARG:1):ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = さて、お次はどの方ですか
		;弱点をついた。つまりCOOP
		ELSEIF GET_CREC_ACT(ARG, ARG:1, "WEAK")
			IF CFLAG:(ARG:1):방어플래그
				BTL_KOJO_RESULTS:0 = あはっ、弱点発見です%UNICODE(0x2661)%
			ELSE
				;こっちはCOOP発動に回すためにカット
				RETURN 0
			ENDIF
		;大ダメージ
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = 痛いですか？苦しいですか？そうですよね
			BTL_KOJO_RESULTS:1 = でももうすぐ何も感じなくなりますよ♪
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 25
			BTL_KOJO_RESULTS:0 = どうですか私の攻撃、もちろん痛いですよね♪
		ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
			BTL_KOJO_RESULTS:0 = 
		;無効された
		ELSEIF ダメージ割合(ARG:1, ARG:2) <= 0
			BTL_KOJO_RESULTS:0 = ……！こちらの攻撃が全く通じてないですね
		ENDIF
	;被ダメージ
	;ARGが攻撃を受ける仲魔、ARG:1が敵、ARG:2がダメージ量
	CASE 12
		;味方に攻撃された
		;IF CFLAG:ARG:PT플래그 == CFLAG:(ARG:1):PT플래그
		;死んだ
		IF BASE:ARG:ＨＰ <= 0
			BTL_KOJO_RESULTS:0 = ああ……全身が冷たくなっていくのを感じる……これが死……
		;大ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 50
			BTL_KOJO_RESULTS:0 = いっ……たあ……！
		;無効
		ELSEIF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = ふふん、それは効きません♪
		;吸収
		ELSEIF ARG:2 < 0
			BTL_KOJO_RESULTS:0 = それは……通りませんよ！
		;瀕死
		ELSEIF 現HP割合(ARG) < 25
			BTL_KOJO_RESULTS:0 = うぐっ……今にも倒れそう……
		;ダメージ
		ELSEIF ダメージ割合(ARG, ARG:2) > 20
			BTL_KOJO_RESULTS:0 = くっ……この痛み必ず倍にして返しますよッ！
		;小ダメージ
		ELSE
			BTL_KOJO_RESULTS:0 = チィ……！
		ENDIF
	;範囲攻撃
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が無効数(回避も含む)
	CASE 13
		;全弾命中した
		IF ARG:2 == 0
			BTL_KOJO_RESULTS:0 = 全弾命中ですっ♪
		;普通
		ELSEIF ARG:2 < ARG:1
			BTL_KOJO_RESULTS:0 = うーん、まずまずですかね
		;全弾回避された
		ELSEIF ARG:2 == ARG:1
			BTL_KOJO_RESULTS:0 = 全部外れた！？なぜですかー！
		ENDIF
	;範囲攻撃で敵を撃破した
	;ARGが攻撃をする仲魔、ARG:1が攻撃された敵数、ARG:2が撃破数
	CASE 14
		;全員撃破
		IF GET_CREC_ACT_SUM(ARG, "敵", "ATTACK") == ARG:2
			BTL_KOJO_RESULTS:0 = 敵殲滅です！やりました♪
		ELSE
			BTL_KOJO_RESULTS:0 = 
		ENDIF
	;反射された
	CASE 15
			BTL_KOJO_RESULTS:0 = っ……！反射された……！！
	;反射した
	CASE 16
			BTL_KOJO_RESULTS:0 = そんな攻撃弾き飛ばしてあげます！
	;回避された
	CASE 17
			BTL_KOJO_RESULTS:0 = まずい……避けられた……！
	;回避した
	CASE 18
			BTL_KOJO_RESULTS:0 = そのへっぽこ攻撃じゃ当たりませんよ私は！
	;敵味方全体攻撃(詳細処理無し)
	;CASE 19
	;		BTL_KOJO_RESULTS:0 = 
	;反撃を発動した
	CASE 20
		SELECTCASE TFLAG:발동연동스킬
		;닷지카운터
		CASE 2484
			BTL_KOJO_RESULTS:0 = ふふ、残念♪それではお返しです%UNICODE(0x2661)%
		;その他
		CASEELSE
			BTL_KOJO_RESULTS:0 = 
		ENDSELECT
	;トリガースキルを発動した
	CASE 21
		SELECTCASE TFLAG:발동연동스킬
		;○○
		;CASE 
		;	BTL_KOJO_RESULTS:0 = 
		;その他
		CASEELSE
			BTL_KOJO_RESULTS:0 = 
		ENDSELECT
	;バッドステータスを受けた
	CASE 22
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "HAPPY"
				BTL_KOJO_RESULTS:0 = はっぴーはっぴーはぁっぴー♪
			CASE "SHOCK","FREEZE","BIND","PALYZE"
				BTL_KOJO_RESULTS:0 = う、体が動きません……
			CASE "PANIC"
				BTL_KOJO_RESULTS:0 = もう何がなんだかわからないですねえ
			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 = ZZz……
			;CASE "CLOSE"
			CASE "POISON"
				BTL_KOJO_RESULTS:0 = う……！気分が……
			;CASE "BOMB"
			CASE "CHARM"
				BTL_KOJO_RESULTS:0 = 私の正義は貴方です！
			;CASE "CURSE"
			;CASE "FLY"
			;CASE "STONE"
			CASE "FLAME"
				BTL_KOJO_RESULTS:0 = 
			CASE "SLIP"
				BTL_KOJO_RESULTS:0 = 
			;CASE "BRAND"
			;その他の状態異常
			;CASEELSE
		ENDSELECT
	;食いしばり等で耐えた
	CASE 23
		;이악물기
		IF BASE:ARG:ＨＰ == 1
			BTL_KOJO_RESULTS:0 = まだここでくたばるわけには……
			BTL_KOJO_RESULTS:1 = いかないんですよッ！
		;その他
		ELSE
			BTL_KOJO_RESULTS:0 = まだ舞えます……！
		ENDIF
	;回復してもらった
	CASE 24
		;ARG:2　回復量
		LOCAL = ARG:2 * 100 / BASE:ARG:ＨＰ
		;LOCAL　回復量割合
		IF 0
		;キャラ分岐
		;ELSEIF NO:(ARG:1) == XXXX
		;50%以上 & HPほぼ満タン
		ELSEIF LOCAL > 50 && 現HP割合(ARG) > 90
		;50%以上
		ELSEIF LOCAL > 50
		;その他
		ELSE
		ENDIF
	;状態異常を直してもらった
	CASE 25
		;ARG:2　直ったバステ
		IF 0
		;キャラ分岐
		;ELSEIF NO:(ARG:1) == XXXX
		ELSE
			SELECTCASE GET_STATE(ARG:2)
				CASE "SLEEP"
					BTL_KOJO_RESULTS:0 = 
				;その他の状態異常
				CASEELSE
					BTL_KOJO_RESULTS:0 = 
			ENDSELECT
		ENDIF
	;戦闘中イって行動不能にならず耐えた(ムフフ展開時のみ)
	CASE 47
		;歯を食いしばって快楽に耐えた
		BTL_KOJO_RESULTS:0 = 
	;行動中イって行動不能になった(ムフフ展開時のみ 50%の確率でHAPPYに)
	CASE 48
		;GET_STATE(CFLAG:ARG:상태이상) == "HAPPY"
		
		;絶頂の余韻に浸っている
		BTL_KOJO_RESULTS:0 = 
	;ターン終了時状態異常が自然回復した
	CASE 50
		SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
			CASE "SLEEP"
				BTL_KOJO_RESULTS:0 = 
			;その他の状態異常
			CASEELSE
				BTL_KOJO_RESULTS:0 = 
		ENDSELECT
	;ターン終了時今の状態による口上
	CASE 51
		;ムフフ展開系
		IF FLAG:무후후전개 && (BATTLE_H_EVENT_PRO(ARG) > 30 || CFLAG:ARG:던전내발정용욕정치 > 5000) && !RAND:2
			;BATTLE_H_EVENT_PRO(ARG)…戦闘中イく確率
			SETCOLOR COLOR("pink")
			IF     BATTLE_H_EVENT_PRO(ARG) > 80
			ELSEIF BATTLE_H_EVENT_PRO(ARG) > 50
			ELSEIF BATTLE_H_EVENT_PRO(ARG) > 30
			ELSEIF CFLAG:ARG:던전내발정용욕정치 > 10000
			ELSEIF CFLAG:ARG:던전내발정용욕정치 > 5000
			ENDIF
			SIF BTL_KOJO_RESULTS:0 == "" && KSTR:0 == ""
				RESETCOLOR
		ENDIF
		;状態異常継続中
		IF BTL_KOJO_RESULTS:0 == "" && KSTR:0 == ""
			SELECTCASE GET_STATE(CFLAG:ARG:상태이상)
				CASE "SLEEP"
					BTL_KOJO_RESULTS:0 = 
				;その他の状態異常
				CASEELSE
					BTL_KOJO_RESULTS:0 = 
			ENDSELECT
		ENDIF
		;残りHP関連
