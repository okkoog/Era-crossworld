@KOJO_BATTLE_EVENT_PUB314, ARG, ARG:1, ARG:2
IF TFLAG:전투이벤트 == 1
;味方パーティでのデビルＣＯ－ＯＰ発動時の台詞
	IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 해치워버리자구-
	ELSE
			BTL_KOJO_RESULTS:0 = 히호- 타-임
	ENDIF
ELSEIF TFLAG:전투이벤트 == 2
;味方パーティでのデビルＣＯ－ＯＰ参加時の台詞
	IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 해치워버리겠어-
	ELSE
			BTL_KOJO_RESULTS:0 = 화려하게 추격이다 호-
	ENDIF
;戦闘中に召喚された
ELSEIF TFLAG:전투이벤트 == 3
	SETCOLOR COLOR("FRIEND")
	IF 陥落()
		IF TALENT:신뢰 || TALENT:동료
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 함께 가자 호, %CSTR:이인칭%!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 등 뒤는 맡긴다고!
			ELSE
				BTL_KOJO_RESULTS:0 = %CSTR:일인칭%에게 맡겨달라고-!
			ENDIF
		ELSEIF TALENT:연모 || TALENT:친애
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%은 %CSTR:일인칭%이 지킨다고!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 뒤는 %CSTR:일인칭%에게 맡기라 호!
			ELSE
				BTL_KOJO_RESULTS:0 = %CSTR:일인칭%에게 맡겨달라고-!
			ENDIF
		;淫乱、娼婦
		ELSEIF TALENT:음란 || TALENT:창부
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 나중에 하게 해줘-
			ELSE
				BTL_KOJO_RESULTS:0 = 저 적, 가지고 돌아가도 돼?
			ENDIF
		;服従、隷属
		ELSEIF TALENT:복종 || TALENT:예속
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 어라어라 %CSTR:이인칭% 행차시다!
			ELSE
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%을 방해한다면 해치워버릴 거야-!
			ENDIF
		ENDIF
	;反発刻印Lv3
	ELSEIF MARK:3 == 3
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 싸우라고 해도 말이지-……
		ELSE
			BTL_KOJO_RESULTS:0 = 계-약이니까 어쩔 수 없지-……
		ENDIF
	ELSE
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = %CALLNAME%, 등장이다 호-!
		ELSE
			BTL_KOJO_RESULTS:0 = 묵사발을 만들어주마-!
		ENDIF
	ENDIF
;（わりと通常の）攻撃
;ARGが攻撃する仲魔、ARG:1が攻撃受ける敵、ARG:2がダメージ量
ELSEIF TFLAG:전투이벤트 == 11 
	;相手が死んだ　HP０以下
	IF BASE:(ARG:1):ＨＰ <= 0
		;倒した
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 해치웠다고!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 그럼, 바이바이-!
		ELSE
			BTL_KOJO_RESULTS:0 = 목숨 잘 받아가마-!
		ENDIF
	;ダメージ与えた
	ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 좋-았어, 통하고 있다 호
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 팍팍 해치워버릴 거야-!
		ELSE
			BTL_KOJO_RESULTS:0 = 묵사발! 묵사발!
		ENDIF
	;無効
	ELSEIF ARG:2 == 0
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 안 통해-!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 멀쩡해 보이는데……
		ELSE
			BTL_KOJO_RESULTS:0 = 앗, 이러면 안 되잖아!
		ENDIF
	;吸収
	ELSEIF ARG:2 < 0
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 에-엑!? 치사하잖아!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 그게 말이 되냐고-!?
		ELSE
			BTL_KOJO_RESULTS:0 = 방금 건 무효! 제대로 맞으라고-!
		ENDIF
	ENDIF
;被弾
ELSEIF TFLAG:전투이벤트 == 12
	;ハマムドあたりで死亡
	IF CFLAG:ARG:상태이상 == GET_STATE_NUM("DYING") && BASE:ARG:ＨＰ > 0
		BTL_KOJO_RESULTS:0 = 으게게……켁!?
	;被弾（死亡）
	ELSEIF BASE:ARG:ＨＰ <= 0
		;陥落状態
		IF 陥落()
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = ……미안, 당해버렸어……
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 죽지 마-……
			ELSE
				BTL_KOJO_RESULTS:0 = 이젠 여기까지인가 호……
			ENDIF
		ELSE
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 구엑-! 당했다 호……
			ELSE
				BTL_KOJO_RESULTS:0 = 이 녀석, 너무 세잖아……
			ENDIF
		ENDIF
	;残り２０％以下
	ELSEIF 現HP割合(ARG) < 20
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 위, 위험해, 어떡하지……
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 당해버리겠다고-!?
		ELSE
			BTL_KOJO_RESULTS:0 = 사, 살려줘 %CSTR:이인칭%……
		ENDIF
	;残り５０％以下
	ELSEIF 現HP割合(ARG) < 50
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 으엑!? 해버렸구나-!
		ELSEIF RAND:2 == 0
