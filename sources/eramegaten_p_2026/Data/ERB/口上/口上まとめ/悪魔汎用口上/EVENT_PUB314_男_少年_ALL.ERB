		;ダンジョン内性欲処理：仲魔に奉仕させる
		;奉仕される側
		;PLAYERに奉仕する側の番号が入っています
		;-------------------------------------------------
	CASE 84
		CALL EVENT_MESSAGE
		IF (CFLAG:607 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:607 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：輪姦イベント
		;奉仕する側
		;PLAYERに実行者=輪姦する悪魔の番号が入っています
		;-------------------------------------------------
	CASE 85
		CALL EVENT_MESSAGE
		IF (CFLAG:608 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:608 = 1
		ENDIF

		;-------------------------------------------------
		;교류한다　（ソシャゲでのキャラタップ雑談みたいなのを意識）
		;-------------------------------------------------
	CASE 94
		;交流初めて
		IF CFLAG:800 == 0
			IF RAND:3 == 0
				PRINTFORMW 「요즘 어떠냐고? 으-음, 그렇네-……」
			ELSEIF RAND:2 == 0
				PRINTFORMW 「잡담하고 싶어-? 뭐 %CSTR:일인칭%도 심심하니까 좋아-」
			ELSE
				PRINTFORMW 「에? 이야기하고 싶다구-?」
				PRINTFORMW 「그치만 %CSTR:일인칭%은 이미 동료마…… 잡담?」
			ENDIF
			CFLAG:800 = 1
		;恋慕・信頼後初
		ELSEIF (TALENT:신뢰 || TALENT:연모) && CFLAG:800 <= 1
			IF RAND:2 == 0
				PRINTFORMW 「%CSTR:이인칭%이랑 이야기하는 거, 재미있네-」
				PRINTFORMW 「앞으로도 종종 이야기하자구」
			ELSE
				PRINTFORMW 「요즘, %CSTR:이인칭%이 무슨 생각하는지 알 것 같은 기분이 든다구」
				PRINTFORMW 「이렇게 이야기 나눈 덕분이려나? 헤헤헤……」
			ENDIF
			CFLAG:800 = 2
		;親愛・相棒後初
		ELSEIF (TALENT:동료 || TALENT:친애) && CFLAG:800 <= 2
			IF RAND:2 == 0
				PRINTFORMW 「전투 말고도 이렇게 %CSTR:이인칭%이랑 시간을 보내는 거……」
				PRINTFORMW 「왠지 좋네, 이런 거」
			ELSE
				PRINTFORMW 「생각해보면 %CSTR:이인칭%이랑 알고 지낸 지도 꽤 오래됐네-」
				PRINTFORMW 「이런 걸 뭐라고 하더라? 악연? ……에? 그건 나쁜 뜻이야?」
			ENDIF
			CFLAG:800 = 3
		;結婚・盟友後初
		ELSEIF (TALENT:맹우 || (TALENT:아내 || TALENT:남편)) && CFLAG:800 <= 3
			IF RAND:2 == 0
				PRINTFORMW 「이걸로 %CSTR:일인칭%들은 깊은 인연이라는 걸로 이어진 셈이네」
				PRINTFORMW 「다시 한 번, 앞으로도 잘 부탁해…… 그리고 이런저런 이야기로 신나게 떠들어보자구, %CSTR:이인칭%」
			ELSE
				PRINTFORMW 「설마 %CSTR:이인칭%이랑 여기까지 깊은 사이가 될 줄이야, 얼마 전의 %CSTR:일인칭%이 들었으면 뒤로 나자빠졌을걸-」
				PRINTFORMW 「뭐, 앞으로도 오랫동안 잘 부탁한다고, %CSTR:이인칭%」
			ENDIF
			CFLAG:800 = 4
		;ランダム交流
		ELSE
			IF RAND:4 == 0 && (TALENT:맹우 || (TALENT:아내 || TALENT:남편))
				IF RAND:3 == 0
					PRINTFORMW 「%CSTR:일인칭%들, 거칠 것이 없다는 느낌이잖아!」
					PRINTFORMW 「이러다 %CSTR:일인칭%들이 천하를 쥐어버릴지도 모른다구-!」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「마계의 녀석들한테도 %CSTR:이인칭%을 소개해줘야겠네-」
					PRINTFORMW 「헤헤헤…… 분명 다들 깜짝 놀랄 거라구」
				ELSE
					PRINTFORMW 「있잖아, %CSTR:일인칭% 생각하기엔 말야」
					PRINTFORMW 「만약에 %CSTR:일인칭%이 인간이고, %CSTR:이인칭%이 악마라고 해도……」
					PRINTFORMW 「아니면, 둘 다 인간이거나, 악마라고 해도……」
					PRINTFORMW 「%CSTR:일인칭%들 분명, 어디선가 만나서 또 이렇게 됐을 것 같아」
					PRINTFORMW 「헤헤헤…… %CSTR:이인칭%도 그렇게 생각하지?」
				ENDIF
			ELSEIF RAND:3 == 0 && (TALENT:동료 || TALENT:친애)
				IF RAND:3 == 0
					PRINTFORMW 「있잖아 %CSTR:이인칭%, %CSTR:이인칭%은 꿈 같은 거 있어?」
					PRINTFORMW 「%CSTR:일인칭%? 글쎄에…… 돈 더 많이 벌어서 팍팍 놀고 싶어!」
					PRINTFORMW 「물론 %CSTR:이인칭%도 함께라구-」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「있잖아 있잖아, 다음에 같이 합체기 연습하자구-」
					PRINTFORMW 「둘이서 적을 쾅쾅 날려버리는 거야!」
				ELSE
					PRINTFORMW 「%CSTR:이인칭%, 이번에 발매되는 게임 협동 플레이 전용이래」
					PRINTFORMW 「두 개 사서 같이 하자구-」
				ENDIF
			ELSEIF RAND:2 == 0 && (TALENT:신뢰 || TALENT:동료 || TALENT:연모 || TALENT:친애)
				IF RAND:3 == 0
					PRINTFORMW 「%CSTR:이인칭%은 말야, 역시 어른이니까 인기 많아?」
					IF TALENT:연모 || TALENT:친애
						PRINTFORMW 「……아니, 역시 됐어, 그렇다고 하면 풀죽을 것 같고……」
					ELSE
						PRINTFORMW 「비결 같은 거 있으면 알려달라구-, %CSTR:일인칭%들 사이잖아-?」
					ENDIF
				ELSEIF RAND:2 == 0
					PRINTFORMW 「……아! 지금 새로운 필살 포즈 떠올랐다!」
					PRINTFORMW 「다음 전투에서 보여줄게-!」
				ELSE
					PRINTFORMW 「민트초코 아이스크림, 그거 꽤 괜찮지 않아-!」
					PRINTFORMW 「치약 맛이라고 하는 녀석은 센스가 없다고!」
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORMW 「%CSTR:일인칭%도 언젠가 어른이 되면 인기 폭발이 될 수 있으려나-?」
					IF TALENT:연모 || TALENT:친애
						PRINTFORMW 「농담이고, %CSTR:일인칭%한테는 %CSTR:이인칭%이 있으니 딱히 상관없나」
					ELSEIF TALENT:MASTER:남자
						PRINTFORMW 「%CSTR:이인칭%은 어때? 역시 인기 많아?」
					ELSEIF TALENT:MASTER:오토코노코
						PRINTFORMW 「아니면 %CSTR:이인칭%이…… 앗 남자였지, 미안」
					ELSE
						PRINTFORMW 「아니면 %CSTR:이인칭%이 입후보해 주려나-? 농담이야」
					ENDIF
				ELSEIF RAND:2 == 0
					PRINTFORMW 「헤헷, %CSTR:이인칭%이랑 그냥 이야기하는 것도 나쁘지 않네」
				ELSE
					PRINTFORMW 「홈런바도 좋지만, 요즘 파삭파삭바에 꽂혔다니까」
					PRINTFORMW 「이것도 바람피우는 걸까?」
				ENDIF
			ENDIF
		ENDIF


	CASEELSE
		SIF FLAG:6 > 0
			CALL EVENT_MESSAGE

ENDSELECT



