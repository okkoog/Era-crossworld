ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0) && (CFLAG:202 < 4 || FLAG:7 == 2)
	;依存度プラスまたはゼロ
	IF CFLAG:2 >= 0
		PRINTFORMW 「이젠、어떻게든 된다 라는 느낌이야～」
		PRINTFORMW 「이제 이 조교에 대한 불만은 안 할게」
	ELSE
		PRINTFORMW 「%이인칭은% 아무렇지도 않게 조교를 하는 걸까ー……？」
	ENDIF
	CFLAG:202 = 4
;陥落済み
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORML 「%일인칭을% 만나러 왔어? 역시 인기있는 남자는 어려워～♪」
			PRINTFORMW %CALLNAME은% 들떠있다。
		ELSEIF K:1 == 1
			PRINTFORMW %CALLNAME은%、%MASTER가% 방에 들어오려고 하면 먼저 다가와 서 있었다。
			PRINTFORMW 「에헤헤ー、%CSTR:이인칭% 좋아해♪」
			PRINTFORMW %MASTER는% %CALLNAME%의 입술에 키스를 한 뒤、%CALLNAME을% 침대로 이끌었다。
		ELSE
			PRINTFORMW 「%이인칭은% 이런 내가 좋아ー……？」
			PRINTFORMW %CALLNAME은% 붙잡고 있는 팔에 힘을 주었다。
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORML 「제대로 말 잘들으면……좋은 보상 줄거야？」
			PRINTFORMW %CALLNAME은% 아첨하는 듯한 자세로 %MASTER를% 유혹했다。
		ELSEIF K:1 == 1
			PRINTFORMW 「더 이상 참을 수 없어ー、어서 우리 둘만의 파티를 시작하자구！」
		ELSE
			PRINTFORMW 「%이인칭이% 이상한 짓만 시키니까 그러지.。어서 책임져줘！」
		ENDIF
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORMW 「이、이제 이런 일은 하고싶지 않지만……」
			PRINTFORMW 울먹거리는 목소리를 하는 %CALLNAME%의 몸을 붙잡고 침대에 넘어 뜨렸다。
		ELSEIF K:1 == 1
			PRINTFORMW 「……흑……흐윽……」
			PRINTFORMW %CALLNAME은% 흐느껴 울고있다。
		ELSE
			PRINTFORMW 「%CSTR:이인칭%、%CSTR:일인칭% 뭔가 나쁜짓 했어？」
		ENDIF
	ENDIF
	CFLAG:202 = 5
ENDIF
RETURN 0

