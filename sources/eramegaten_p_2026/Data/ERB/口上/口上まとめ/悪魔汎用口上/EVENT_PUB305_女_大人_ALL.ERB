;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0
	PRINTFORMW 「무슨 용무일까、%CSTR:이인칭%？」
	PRINTFORMW 「%일인칭을% 조교？」
	IF TALENT:처녀
		PRINTFORMW 「%일인칭을% 안고 싶다는 %CSTR:이인칭%의 마음은 잘 알아요……」
		PRINTFORMW 「하지만……저기、그、%CALLNAME:MASTER% 책임져 준다면」
		PRINTFORMW %CALLNAME은% 부끄러운 듯 고개를 숙였다。
	ELSE
		PRINTFORMW 「직설적이군요　그런 방식으로 요구되는 것도 싫어하는 건 아니에요」
		PRINTFORMW %CALLNAME은% 미소를 지었다。
		PRINTFORMW 「아프게 하지 않는다고 약속해주실래요? %CSTR:이인칭%」
	ENDIF
	CFLAG:201 = 1
	RETURN 0
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	PRINTFORMW 「또 하는군요？」
	PRINTFORMW 「아픈 건 싫어요……부드럽게 해주세요」
	CFLAG:201 = 2
	RETURN 0
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	PRINTFORMW 「그동안 약간 놀랐어요」
	PRINTFORMW 「하지만、이 정도의 일로 %일인칭이% 굴복했다고는 생각하지 말아주세요」
	PRINTFORMW %CALLNAME은% 도발적인 미소를 지으며 응시하고 있다
	CFLAG:201 = 3
	RETURN 0
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:연모 == 0 && TALENT:음란 == 0 && TALENT:복종 == 0 && TALENT:친애 == 0 && TALENT:창부 == 0 && TALENT:예속 == 0)
	PRINTFORMW 「……대단하네요」
	IF TALENT:처녀
		PRINTFORMW 「%CSTR:이인칭%에게……%CSTR:일인칭%의 처음을 드리죠」
		PRINTFORMW 「고맙게 받으세요」
	ELSE
		PRINTFORMW 「%CSTR:일인칭%、%CSTR:이인칭%에게 라면…안겨도 좋아요」
	ENDIF
	CFLAG:201 = 4
	RETURN 0
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:연모 || TALENT:음란 || TALENT:복종)
	;연모
	IF TALENT:연모
		IF CFLAG:미조교함락 == 1
			PRINTFORMW 「어머? 이런 곳으로 불러내다니 무슨 용무일까, %CSTR:이인칭%?」
			PRINTFORMW 「%CSTR:일인칭%을(를) 조교?」
			IF TALENT:처녀 && TALENT:정조관결여 == 0 && TALENT:부끄럼없음 == 0
				PRINTFORMW 「돌연하네…… 그렇게나 %CSTR:일인칭%을(를) 안고 싶은 거야?」
				PRINTFORMW %CALLNAME%은(는) 붉어진 얼굴로 고개를 숙인 뒤, 조심조심 얼굴을 들었다.
				PRINTFORMW 「%CSTR:이인칭%이라면, 저, 그, 기꺼이……」
			ELSE
				PRINTFORMW 「응, 좋아, %CSTR:이인칭%에게라면 기꺼이 안길게」
				PRINTFORMW %CALLNAME%은(는) 미소로 화답했다.
				PRINTFORMW 「하지만 아픈 건 싫어? 믿고 있을게, %CSTR:이인칭%」
			ENDIF
		ELSE
			PRINTFORMW 「%CSTR:이인칭%……」
			PRINTFORMW %MASTER를% 바라보는 %CALLNAME은% 부끄러운듯이 고개를 숙였다。
			IF ABL:종족 == 0
				PRINTFORMW 「노예인 %일인칭이% %이인칭을% 좋아하게 되다니……성가신 이야기겠죠」
				PRINTFORMW 「%일인칭은% 노예、%이인칭은% 주인님」

			ELSE
				PRINTFORMW 「악마인 %일인칭이% 인간을 좋아하게 되다니……성가신 이야기겠죠」
				PRINTFORMW 「%일인칭은% 악마、%이인칭은% 인간」
			ENDIF
			PRINTFORMW 「연인 같은 건 바라지도 않아요……」
			PRINTFORMW 「%이인칭이% 싫지 않다면…쭉 곁에 둬주시면 안될까요？」
		ENDIF
	;음란
	ELSEIF TALENT:음란
		PRINTFORMW %CALLNAME:MASTER%에게 호출된 %CALLNAME은% 음란한 시선을 던져왔다。
		PRINTFORMW 「늦었잖아요……빨리……조교를 시작합시다%ハート()%」
		PRINTFORMW  ｢%CSTR:이인칭%에게 조교 받고 싶어서…… %CSTR:일인칭%의 몸은 좀이 쑤셔」
		PRINTFORMW 「응…… 빨리 해요……」
	;복종
	ELSEIF TALENT:복종
		CSTR:이인칭 = 주인님
		PRINTFORMW 「부르셨습니까、%CSTR:이인칭%」
		IF ABL:종족 == 0
			PRINTFORMW 호출된 %CALLNAME은% 죽은 물고기같은 눈동자로、%CALLNAME:MASTER% 앞에 무릎을 꿇었다。
		ELSE
			PRINTFORMW 소환된 %CALLNAME은% 죽은 물고기같은 눈동자로、%CALLNAME:MASTER% 앞에 무릎을 꿇었다。
		ENDIF
		PRINTFORMW 「%CSTR:이인칭%의 명령이라면……%일인칭은% 어떤 고난도 기꺼이 받겠습니다」
	ENDIF
	CFLAG:201 = 5
	RETURN 0
ENDIF

