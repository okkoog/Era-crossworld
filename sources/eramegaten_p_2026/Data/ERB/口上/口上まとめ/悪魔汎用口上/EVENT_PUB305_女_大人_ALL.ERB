;-------------------------------------------------
;調教開始時（2回目以降、X1をキャラ番号に変更する）
;-------------------------------------------------
@EVENTTRAIN_SECOND_PUB305
;反発刻印Lv3
IF MARK:3 == 3 && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORMW 「%CALLNAME:MASTER%의 얼굴을 보는 것만으로 불쾌하네요」
	PRINTFORMW 「돌아가도 될까요？」
	CFLAG:202 = 4
;屈服刻印Lv0
ELSEIF MARK:2 == 0 && (CFLAG:202 < 1 || FLAG:7 == 2)
	IF ABL:종족 == 0
		PRINTFORMW 「아무리 %CSTR:일인칭%이(가) 노예라지만 이런 짓을……」
	ELSE
		PRINTFORMW 「%이인칭은% 악마가 뭐라고 생각하는 거죠？」
	ENDIF
	PRINTFORMW 「%일인칭은% %CALLNAME:MASTER%의 성처리용 노리개가 아니에요」
	CFLAG:202 = 1
;屈服刻印Lv1
ELSEIF MARK:2 == 1 && (CFLAG:202 < 2 || FLAG:7 == 2)
	PRINTFORMW 「오늘의 용무는 조교군요？」
	PRINTFORMW 「부드럽게 부탁드려도 될까요？」
	CFLAG:202 = 2
;屈服刻印Lv2
ELSEIF MARK:2 == 2 && (CFLAG:202 < 3 || FLAG:7 == 2)
	PRINTFORMW 「알고 있어요……조교군요」
	PRINTFORMW 「그다지 아프게하는 건 원하지않지만……」
	CFLAG:202 = 3
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:연모 == 0 && TALENT:음란 == 0 && TALENT:복종 == 0 && TALENT:친애 == 0 && TALENT:창부 == 0 && TALENT:예속 == 0) && (CFLAG:202 < 4 || FLAG:7 == 2)
	IF RAND:2 == 0
		PRINTFORMW 「조교 시간이네요」
		PRINTFORMW 「상냥하게 부탁해요」
	ELSE
		PRINTFORMW 「%CSTR:일인칭%、어떻게 돼버린걸까요……」
		PRINTFORMW 「최근、%이인칭과% 보내는 이 시간을 굉장히 기대해버려요」
	ENDIF
	CFLAG:202 = 4
;陥落済み
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:연모 || TALENT:친애
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF (위험일() > 0 || CFLAG:배란유발제 > 0) && TALENT:임신 == 0
			IF 위험일() > 0
				IF RAND:2 == 0
					PRINTFORMW 「%CSTR:일인칭%, 오늘은…… 위험일이야…… 만약 지금 안에 가득 싸질러진다면……」
					PRINTFORMW 「분명 %CALLNAME:MASTER%의 아기가 생겨버릴 거야……%ハート()%」
				ELSE
					PRINTFORMW 「저기 %CSTR:이인칭%…… 우리들에게도 가족이 갖고 싶지 않아?」
					PRINTFORMW 「%CSTR:일인칭%의 『여기』…… %CSTR:이인칭%을(를) 기다리고 있어%ハート()%」
				ENDIF
			ELSE
				PRINTFORMW 「약까지 써가면서 %CSTR:일인칭%을(를) 임신시키고 싶은 거야? ……기뻐%ハート()%」
				PRINTFORMW 「%CSTR:이인칭%의 정자로 %CSTR:일인칭%에게 아기를 줘……%ハート()%」
			ENDIF
		ELSE
			IF K:1 == 0
				PRINTFORMW 「%이인칭과% 만날 때마다、이렇게 몸이 뜨거워져요……」
			ELSEIF K:1 == 1
				PRINTFORMW 「어머、조교 시간인가요？」
				PRINTFORMW 「상냥하게 부탁해요。%CALLNAME:MASTER%%ハート()%」
			ELSE
				PRINTFORMW 「너무 다른 아이에게 얽매여있으면、다른 남자에게로 가버릴거예요？」
				PRINTFORMW 「…라는 건 거짓말이에요。하지만 지금은、%일인칭과% 사랑할 시간이에요%ハート()%」
			ENDIF
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:음란 || TALENT:창부
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORMW 「하아……%CSTR:이인칭%의 뜨거운걸 원해……」
			PRINTFORMW 「몸이 욱신거리며 요구해 버리는 걸……알고 있어？」
		ELSEIF K:1 == 1
			PRINTFORMW 「응……옷 따위는 벗어버리고、빨리 시작해야지？」
			PRINTFORMW %CALLNAME이% 요염한 미소를 지으며 %MASTER를% 바라보고 있다。
		ELSE
			PRINTFORMW 「응……기다리고 있었어」
			PRINTFORMW 「빨리 음란한 일을 하고 싶어서……몸이 화근거리는걸」
			PRINTFORMW 「이런 몸으로 조교한 %이인칭이% 책임져줘」
		ENDIF
	;服従、隷属
	ELSEIF TALENT:복종 || TALENT:예속
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:3
		IF K:1 == 0
			PRINTFORMW 「조교인가요、%CSTR:이인칭%」
			PRINTFORMW 흐릿한 눈빛으로、 %CALLNAME은% %MASTER를% 보았다。
		ELSEIF K:1 == 1
			PRINTFORMW %CALLNAME%은、몸도 마음도 노예가 된 것 같다。
			PRINTFORMW 「오늘도 봉사하겠습니다……」
		ELSE
			PRINTFORMW 「%CSTR:일인칭%의 모든것은、%CSTR:이인칭%의 것입니다」
			PRINTFORMW 「자、마음껏 사용해주세요……」
		ENDIF
	ENDIF
	CFLAG:202 = 5
ENDIF
RETURN 0

