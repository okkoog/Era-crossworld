						PRINTFORMW 「아아……이거, 대단해애……앗%ハート()%」
					ENDIF
				ELSE
					PRINTFORMW 「후후……기분 좋았어?%ハート()%」
				ENDIF
				IF CFLAG:본방횟수
					PRINTFORMW 질 안에서 맥동하는 페니스를 밀혈로 상냥하게 훑어내며, %CALLNAME%은(는) 생긋 미소지었다
				ELSE
					PRINTFORMW 상기된 얼굴에 풀린 눈으로 바라보며, %CALLNAME%은(는) 상냥하게 미소지었다
				ENDIF
			ELSE
				PRINTFORMW 「하!? 제정신이야!? 여기 던전――잠깐!?」
				CALL EVENT_MESSAGE
			ENDIF
			CFLAG:602 = 1
		ENDIF

		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔に奉仕させる
		;奉仕する側
		;PLAYERに実行者の番号が入っています
		;-------------------------------------------------
	CASE 80
		IF (CFLAG:603 < 1 || FLAG:7 == 2)
			;実行者に対して陥落済み
			IF CFLAG:함락캐릭터 == CFLAG:PLAYER:캐릭터고유번호
				IF RAND:3 == 0
					PRINTFORMW 「에에~? 이런 데서……? 정말이지, 변태라니까%ハート()%」
					PRINTFORMW 「어쩔 수 없네에……자, 저쪽으로 가자%ハート()%」
				ELSEIF RAND:2 == 0
					PRINTFORMW 「……%ハート()% 후후, 벌써 그렇게 세워놓고……%ハート()%」
					PRINTFORMW 「좋아, 잔뜩 기분 좋게 해줄게……%ハート()%」
				ELSE
					PRINTFORMW 「위험한 던전인데도, 그렇게나 %CSTR:일인칭%하고 야한 짓이 하고 싶어?%ハート()%」
					PRINTFORMW 「……나쁜 기분은 아니네%ハート()% 좋아, 스릴 만점인 봉사로 해줄게%ハート()%」
				ENDIF
				CALL EVENT_MESSAGE
			ELSE
				PRINTFORMW 「하!? 제정신이야!? 여기 던전――잠깐!?」
				CALL EVENT_MESSAGE
			ENDIF
			CFLAG:603 = 1
		ENDIF

		;-------------------------------------------------
		;ダンジョン内性欲処理：その場で自慰
		;奉仕する側
		;PLAYERに実行者の番号が入っています
		;-------------------------------------------------
	CASE 81
		IF (CFLAG:604 < 1 || FLAG:7 == 2)
			IF 위험일() == 2
				;発情中
				PRINTFORMW 「하아, 하아……안 돼, 이제 한계야……앗%ハート()%」
				CALL EVENT_MESSAGE
			ELSE
				PRINTFORMW 「싫어엇, 보지 마아……앗%ハート()%」
				PRINTL
				CALL EVENT_MESSAGE
				PRINTL
				PRINTFORMW 「아, 아아……%ハート()%」
			ENDIF
			CFLAG:604 = 1
		ENDIF

		;-------------------------------------------------
		;ダンジョン内性欲処理：物陰で自慰
		;奉仕する側
		;PLAYERに実行者の番号が入っています
		;-------------------------------------------------
	CASE 82
		IF (CFLAG:605 < 1 || FLAG:7 == 2)
			IF 위험일() == 2
				;発情中
				PRINTFORMW 「하아, 하아……안 돼, 이제 한계야……앗%ハート()%」
				CALL EVENT_MESSAGE
			ELSE
				PRINTFORMW 「조금만, 조금만이니까……앗%ハート()%」
				PRINTL
				CALL EVENT_MESSAGE
				PRINTL
				PRINTFORMW 「……후우, 빨리 돌아가야지」
			ENDIF
			CFLAG:605 = 1
		ENDIF

		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔とセックスする
		;やる側
		;PLAYERに相手の番号が入っています
		;-------------------------------------------------
	CASE 83
		CALL EVENT_MESSAGE
		IF (CFLAG:606 < 1 || FLAG:7 == 2)
			PRINTFORML 
		ENDIF
		PRINTFORMW 
		CFLAG:606 = 1

		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔に奉仕させる
		;奉仕される側
		;PLAYERに奉仕する側の番号が入っています
		;-------------------------------------------------
	CASE 84
		CALL EVENT_MESSAGE
		IF (CFLAG:607 < 1 || FLAG:7 == 2)
			PRINTFORML 
		ENDIF
		CFLAG:607 = 1

		;-------------------------------------------------
		;ダンジョン内性欲処理：輪姦イベント
		;奉仕する側
		;PLAYERに実行者=輪姦する悪魔の番号が入っています
		;-------------------------------------------------
	CASE 85
		IF (CFLAG:608 < 1 || FLAG:7 == 2)
			;陥落済み
			IF (TALENT:연모 || TALENT:음란 || TALENT:복종 || TALENT:친애 || TALENT:창부 || TALENT:예속) && (CFLAG:434 < 4 || FLAG:7 == 2)
				;恋慕、親愛
				IF TALENT:연모 || TALENT:친애
					IF RAND:3 == 0
						PRINTFORMW 「이런 거, 이런 거 안 돼애……!」
					ELSEIF RAND:2 == 0
						IF TALENT:임신
							PRINTFORMW 「그만해애, 거기엔 아기가 있단 말이야아……!」
						ELSE
							PRINTFORMW 「그만해애, 아기가 생겨버린다구우……!」
						ENDIF
					ELSE
						PRINTFORMW 「%CSTR:이인칭%, %CSTR:이인칭%……살려줘어……」
					ENDIF
				;淫乱、娼婦
				ELSEIF TALENT:음란 || TALENT:창부
					IF RAND:3 == 0
						PRINTFORMW 「자아, 아직 멀었으니 더 내보내!%ハート()% 이제 겨우 시작했다구!%ハート()%」
					ELSEIF RAND:2 == 0
						PRINTFORMW 「앞으로 얼마나 더 착정하면 죽어버리려나?%ハート()% ……후후후, 농담%ハート()%」
					ELSE
						PRINTFORMW 「아앙!%ハート()% 그래, 그거야앗, 더 잔뜩 찔러줘어!%ハート()%」
					ENDIF
				;服従、隷属
				ELSEIF TALENT:복종 || TALENT:예속
					IF RAND:3 == 0
						PRINTFORMW 「이런 거, 이런 거 안 돼애……!」
					ELSEIF RAND:2 == 0
						IF TALENT:임신
							PRINTFORMW 「그만해애, 거기엔 아기가 있단 말이야아……!」
						ELSE
							PRINTFORMW 「그만해애, 아기가 생겨버린다구우……!」
						ENDIF
					ELSE
						PRINTFORMW 「%CSTR:이인칭%, %CSTR:이인칭%……살려줘어……」
					ENDIF
				ENDIF
			;それ以外
			ELSE
				PRINTFORMW 「오지 마아! 아아아앗!?」
			ENDIF
		ENDIF
		CALL EVENT_MESSAGE
		CFLAG:608 = 1

	CASEELSE
		CALL EVENT_MESSAGE
ENDSELECT
