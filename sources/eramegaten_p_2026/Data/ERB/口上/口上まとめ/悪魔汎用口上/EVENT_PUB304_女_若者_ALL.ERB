@ENEMY_BATTLE_EVENT_PUB304, ARG, ARG:1, ARG:2
IF TFLAG:전투이벤트 == 1
;敵でのデビルＣＯ－ＯＰ発動時の台詞
;			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"",72,LEFT%┃
;			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF
IF TFLAG:전투이벤트 == 2
;敵でのデビルＣＯ－ＯＰ参加時の台詞
;			PRINTFORML ┏>MESSAGE━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
;			PRINTFORML ┃%"",72,LEFT%┃
;			PRINTFORMW ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
ENDIF
@KOJO_BATTLE_EVENT_PUB304, ARG, ARG:1, ARG:2
IF TFLAG:전투이벤트 == 1
;味方パーティでのデビルＣＯ－ＯＰ発動時の台詞
	IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 해냈다！
	ELSE
			BTL_KOJO_RESULTS:0 = 한 번 더♪
	ENDIF
ENDIF
IF TFLAG:전투이벤트 == 2
;味方パーティでのデビルＣＯ－ＯＰ参加時の台詞
	IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 원호할게！
	ELSE
			BTL_KOJO_RESULTS:0 = 보너스 한방！
	ENDIF
;戦闘中に召喚された
ELSEIF TFLAG:전투이벤트 == 3
	SETCOLOR COLOR("FRIEND")
	IF 陥落()
		IF TALENT:연모 || TALENT:친애 || TALENT:신뢰 || TALENT:동료
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:이인칭%의 파트너, %CALLNAME%이야!
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = %CSTR:일인칭%들이라면 이길 수 있어!
			ELSE
				BTL_KOJO_RESULTS:0 = %CSTR:일인칭%이 왔으니 이제 안심해!
			ENDIF
		;淫乱、娼婦
		ELSEIF TALENT:음란 || TALENT:창부
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 후후, 오늘도……%ハート()% 앗, 어라!? 전투인 건가!?
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 후후, %CSTR:이인칭%에게 주입해 줄 MAG가 되어줘야겠어……%ハート()%
			ELSE
				BTL_KOJO_RESULTS:0 = 이런 일 빨리 끝내고, 잔뜩 섹스하자%ハート()%
			ENDIF
		;服従、隷属
		ELSEIF TALENT:복종 || TALENT:예속
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 맡겨주세요!
			ELSE
				BTL_KOJO_RESULTS:0 = 잘 해내면 포상 주세요……%ハート()%
			ENDIF
		ENDIF
	;反発刻印Lv3
	ELSEIF MARK:3 == 3
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = ……왜 이런 녀석을 위해……
		ELSE
			BTL_KOJO_RESULTS:0 = 하아, 어쩔 수 없나……
		ENDIF
	ELSE
		IF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = %CALLNAME%, 왔다구!
		ELSE
			BTL_KOJO_RESULTS:0 = %CSTR:일인칭%의 힘, 보여줄게!
		ENDIF
	ENDIF
;（わりと通常の）攻撃
;ARGが攻撃する仲魔、ARG:1が攻撃受ける敵、ARG:2がダメージ量
ELSEIF TFLAG:전투이벤트 == 11 
	;相手が死んだ　HP０以下
	IF BASE:(ARG:1):ＨＰ <= 0
		;倒した
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 후후, 보았느냐!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 좋~았어, 다음 간다!
		ELSE
			BTL_KOJO_RESULTS:0 = 해냈다! 쓰러뜨렸어!
		ENDIF
	;ダメージ与えた
	ELSEIF ダメージ割合(ARG:1, ARG:2) > 0
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 아직 멀었어!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 먹혀들고 있어!
		ELSE
			BTL_KOJO_RESULTS:0 = 이대로 쓰러뜨려 주겠어!
		ENDIF
	;無効
	ELSEIF ARG:2 == 0
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 안 통한다고!?
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 꽤나 단단하네……!
		ELSE
			BTL_KOJO_RESULTS:0 = 빨리 좀 쓰러졌으면 좋겠는데……!
		ENDIF
	;吸収
	ELSEIF ARG:2 < 0
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 거짓말, 그런 게 어딨어!?
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 흡수당해버렸잖아!?
		ELSE
			BTL_KOJO_RESULTS:0 = 위, 위험해! 흡수당했어……!
		ENDIF
	ENDIF
;被弾
ELSEIF TFLAG:전투이벤트 == 12
	;ハマムドあたりで死亡
	IF CFLAG:ARG:상태이상 == GET_STATE_NUM("DYING") && BASE:ARG:ＨＰ > 0
		BTL_KOJO_RESULTS:0 = 으윽!? 윽, 으……앗!
	;被弾（死亡）
	ELSEIF BASE:ARG:ＨＰ <= 0
		;陥落状態
		IF 陥落()
			IF RAND:3 == 0
				BTL_KOJO_RESULTS:0 = 죽으면 안 돼, %CSTR:이인칭%……
			ELSEIF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 미안, %CSTR:이인칭%……당해버렸어……
			ELSE
				BTL_KOJO_RESULTS:0 = 이제, 무리야……%CSTR:이인칭%……
			ENDIF
		ELSE
			IF RAND:2 == 0
				BTL_KOJO_RESULTS:0 = 이제, 안 되겠어……
			ELSE
				BTL_KOJO_RESULTS:0 = 여기까지인 것 같네……
			ENDIF
		ENDIF
	;残り２０％以下
	ELSEIF 現HP割合(ARG) < 20
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 하아, 하아……!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 가, 강해……!
		ELSE
			BTL_KOJO_RESULTS:0 = 꺄아아……앗!
		ENDIF
	;残り５０％以下
	ELSEIF 現HP割合(ARG) < 50
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 구욱!? 제, 제법이잖아……!
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 이건……방심할 수 없는 상대네……!
		ELSE
			BTL_KOJO_RESULTS:0 = 아, 아야야……!
		ENDIF
	;吸収
	ELSEIF ARG:2 < 0
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 후흥, 고마워%ハート()%
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 잘 먹었습니다%ハート()%
		ELSE
			BTL_KOJO_RESULTS:0 = 상처를 치료해주다니 상냥하네~%ハート()%
		ENDIF
	ENDIF
;反射された
ELSEIF TFLAG:전투이벤트 == 15
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 꺄앗!?
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 아파앗! 도, 되돌아왔잖아!
	ELSE
		BTL_KOJO_RESULTS:0 = 아, 반사당――!
	ENDIF
;反射した
ELSEIF TFLAG:전투이벤트 == 16
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 이거, 돌려줄게!
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 자기 공격이나 실컷 맛봐라!
	ELSE
		BTL_KOJO_RESULTS:0 = 이거, 필요 없어!
	ENDIF
;回避された
ELSEIF TFLAG:전투이벤트 == 17
	IF RAND:3 == 0
		BTL_KOJO_RESULTS:0 = 정말! 움직이지 마!
	ELSEIF RAND:2 == 0
		BTL_KOJO_RESULTS:0 = 이얏! 얍!
	ELSE
		BTL_KOJO_RESULTS:0 = 어쩜 이리 날쌘 녀석이……!
	ENDIF
;회피
ELSEIF TFLAG:전투이벤트 == 18
	;回数が多いので25％
	IF RAND:4 == 0
		IF RAND:3 == 0
			BTL_KOJO_RESULTS:0 = 후후, 멈춰 있는 것처럼 보여?
		ELSEIF RAND:2 == 0
			BTL_KOJO_RESULTS:0 = 느려터졌어!
		ELSE
			BTL_KOJO_RESULTS:0 = 다 보이고 있어!
		ENDIF
	ENDIF
;반격
ELSEIF TFLAG:전투이벤트 == 20
	IF RAND:3 == 0
