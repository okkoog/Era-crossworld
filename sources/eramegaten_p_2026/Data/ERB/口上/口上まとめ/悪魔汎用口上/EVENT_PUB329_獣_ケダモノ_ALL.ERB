;屈服刻印Lv1
ELSEIF MARK:2 == 1 && (CFLAG:202 < 2 || FLAG:7 == 2)
	PRINTFORMW 「누우… %CSTR:12% 또 조교야…」
	PRINTFORMW 「너 이상해」
	PRINTFORMW 「%CSTR:11% 조금 어려워…」
	PRINTFORMW %타겟은% 당신의 의도를 몰라 어찌할 바를 몰라하고 있는 것 같다。
	CFLAG:202 = 2
;屈服刻印Lv2
ELSEIF MARK:2 == 2 && (CFLAG:202 < 3 || FLAG:7 == 2)
	PRINTFORMW 「누우… %CSTR:12% 또 온거야？」
	PRINTFORMW 「…조금이라면 손대어도 좋아」
	PRINTFORMW 그렇게 말하고 %타겟은% 그 자리에 예의바르게 주저앉았다
	PRINTFORMW 그 태도는 만져지는 것을 기대하고 있는것 같아 보인다…
	CFLAG:202 = 3
;屈服刻印Lv3＋陥落素質無し
ELSEIF MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0) && (CFLAG:202 < 4 || FLAG:7 == 2)
	PRINTFORMW 「오오!  %CSTR:12% 왔다」
	PRINTFORMW 「뭐든지 말해 %CSTR:12%」 
	PRINTFORMW 「%CSTR:11% 너에게 반항하지 않는다」
	PRINTFORMW %타겟은% 벌렁 배를 보여주듯 뒹굴고 있다。
	PRINTFORMW 그 모습은 흉포한 짐승이라기 보다는, 펫이라고 하는 것이 옳을 것이다…
	CFLAG:202 = 4
;陥落済み
ELSEIF CFLAG:202 < 5 || FLAG:7 == 2
	;恋慕、親愛
	IF TALENT:3 || TALENT:6
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:2
		IF K:1 == 0
			PRINTFORMW 「%CSTR:11% 너의 것！  너 %CSTR:11%의 것 ！！」
			PRINTFORMW 「%CSTR:11% 행복 가득 가득 행복！」
			PRINTFORMW 「아우우우! 아우우！！」
			PRINTFORMW %타겟은% 몇번이나 환희의 포효를 계속하고 있다。
			PRINTFORMW …냅두면 언제까지나 계속하고 있을 것 같은 기색을 느낀 당신은, 살그머니 머리을 어루만져 그것을 차단했다。
		ELSEIF K:1 == 1
			PRINTFORMW 「%CALLNAME:MASTER%!  아우우！！」
			PRINTFORMW %타겟은% 돌연 당신으로 날아 괘, 밀어 넘어뜨림과 동시에 얼굴을 칠해 빨고 돌리기 시작。
			PRINTFORMW 「%CALLNAME:MASTER%!  %CALLNAME:MASTER%！」
			PRINTFORMW …냅두면 언제까지나 계속하고 있을 것 같은 기색을 느낀 당신은, 살그머니 머리을 어루만져 그것을 차단했다。
		ENDIF
	;淫乱、娼婦
	ELSEIF TALENT:4 || TALENT:7
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:2
		IF K:1 == 0
			PRINTFORMW 「%CSTR:12% 빨리 하겠어…」
			PRINTFORMW %타겟은% 숨을 거칠게 몰아쉬며 가랑이를 당신의 다리에 문지르고 있다。
			PRINTFORMW 「그우… 우우…… 후우 ………！」
			PRINTFORMW 냅두면 당신의 발밑을 점액투성이로 만들 기세다。
		ELSEIF K:1 == 1
			PRINTFORMW 「%CSTR:11% 한계 %CSTR:12% 하겠어」
			PRINTFORMW %타겟은% 숨을 거칠게 쉬면서 고간을 과시하고 있다。
			PRINTFORMW 끈적끈적점액 투성이가 된 가랑이는 매우 추잡하게 빛나, 당신을 유혹하는 것 같다。
			PRINTFORMW 「%CSTR:12% 아직아니야?… %CSTR:11% 언제라도 준비 완료…」
		ENDIF
	;服従、隷属
	ELSEIF TALENT:5 || TALENT:8
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		K:1 = RAND:2
		IF K:1 == 0
			PRINTFORMW 「주인님 %CSTR:11% 명령희망…」
			PRINTFORMW %타겟은% 앉은 자세인 채, 미동이다로 하지 않고 당신의 말을 기다리고 있다。
			PRINTFORMW 흉포한 짐승이어야할%타겟은%, 당신의 명령없이는 살아갈 수 없는 것 같다。
		ELSEIF K:1 == 1
			PRINTFORMW 「%CSTR:11% 노예 뭐든지 한다…」
			PRINTFORMW %타겟은% 당신의 눈치를 살피면서, 명령을 기다려 바라고 있다。
			PRINTFORMW 아무래도 당신의 명령에 따르는 것이,%CALLNAME:TARGET%에 있어 쾌감인것 같다。
		ENDIF
	ENDIF
	CFLAG:202 = 5
ENDIF
RETURN 0

