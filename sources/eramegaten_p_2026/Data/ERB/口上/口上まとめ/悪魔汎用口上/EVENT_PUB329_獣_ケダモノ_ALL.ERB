;-------------------------------------------------
;調教開始時（一回のみ） CFLAG201
;-------------------------------------------------
DRAWLINE
;初調教時
IF CFLAG:201 == 0 && TALENT:연모 == 0
	PRINTFORMW 「무슨 용무야 %CSTR:12%」
	PRINTFORMW 「……조교인가 알았어」
	PRINTFORMW 「%CSTR:11% 해 줄게。불고리 뛰어넘기같은거면 되나」
	PRINTFORMW …아무래도%타겟은% 상황을 잘 이해할 수 없는 것 같다。
	CFLAG:201 = 1
	RETURN 0
;屈服刻印Lv1
ELSEIF CFLAG:201 < 2 && MARK:2 == 1
	PRINTFORMW 「%CSTR:11% 이해불능」
	PRINTFORMW 「그것보다 %CSTR:11% 어렵고 아프다…」
	PRINTFORMW %타겟은% 조교에는 따르지만, 아직 상황에 익숙하지 않은 것 같다。
	CFLAG:201 = 2
	RETURN 0
;屈服刻印Lv2
ELSEIF CFLAG:201 < 3 && MARK:2 == 2
	PRINTFORMW 「…누우。 …%CSTR:12% %CSTR:11% 조교 싫어」
	PRINTFORMW 「%CSTR:11% 너의 명령을 듣는다」
	PRINTFORMW 「너의 적을 물어뜯는다！」
	PRINTFORMW 「…그러니까 조교는 용서해줘」
	PRINTFORMW  %타겟은% 아직 조교되는 것에 익숙해지지 않은 것같다。
	PRINTFORMW 그러나 입에서는 부정하면서도 %CALLNAME:TARGET%의 몸은 자극에대한 기대로 열을 품기 시작하고있다。
	CFLAG:201 = 3
	RETURN 0
;屈服刻印Lv3
ELSEIF CFLAG:201 < 4 && MARK:2 == 3 && (TALENT:3 == 0 && TALENT:4 == 0 && TALENT:5 == 0 && TALENT:6 == 0 && TALENT:7 == 0 && TALENT:8 == 0)
	PRINTFORMW 「오오 %CSTR:12% 잘 왔어」
	PRINTFORMW 「%CSTR:11% 강해 …하지만 넌 더 강하다！」
	PRINTFORMW 「%CSTR:11% 너에게 반항하지 않는다 아우우！」
	PRINTFORMW %타겟은% 당신에게 굴복 한 것 같다。
	PRINTFORMW 흉폭한 짐승이어야할 %타겟은% 지금은 새끼 고양이와 같이 당신의 발밑에 웅크리고 앉고 있다。
	CFLAG:201 = 4
	RETURN 0
;陥落
ELSEIF CFLAG:201 < 5 && (TALENT:3 || TALENT:4 || TALENT:5)
	;연모
	IF TALENT:3
		;IF CFLAG:미조교함락 == 1
			;調教せずに恋慕をつけた場合の分岐
		;	PRINTFORMW 
		;ELSE
			PRINTFORMW 「잘 들어라 %CSTR:12%」
			PRINTFORMW 「%CSTR:11% 너함께가 좋다」
			PRINTFORMW 「언제라도 지켜줄게 그러니까 언제라도 불러」
			PRINTFORMW %타겟은% 당신의 눈을 바라보며 그렇게 말하고는, 살그머니 몸을 기대어 왔다。
			PRINTFORMW 「%CALLNAME:MASTER% %CSTR:11% 쭉 함께야!  아우우우!  아우우우우！！」
		;ENDIF
	;음란
	ELSEIF TALENT:4
		PRINTFORMW 「%CSTR:12%… %CSTR:12%…」
		PRINTFORMW %CALLNAME:TARGET%의 기색이 이상하다。
		PRINTFORMW 흉포한 짐승으로서의 모습은 아니고, 온순한 펫으로서의 모습도 아니고。
		PRINTFORMW 「%CSTR:12% …빨리 해라 %CSTR:11%  괴롭다……！」
		PRINTFORMW 「%CALLNAME:MASTER% 빨리… …아우웅 ！！」
		PRINTFORMW 정욕에 매달려진 그 모습은, 정말로 발정한 짐승이라고도 해야 할 것이었다。
	;복종
	ELSEIF TALENT:5
	CSTR:12 = 주인님
		PRINTFORMW 「우우… %CSTR:11% 너에게 절대 복종…」
		PRINTFORMW 「너 주인님 나 노예…」
		PRINTFORMW 그렇게 확인하듯이 말하는 %타겟은% 완전하게 당신의 노예가 될 수 있던 것을 진심으로 기뻐하고 있는 것 같다。
		PRINTFORMW 「주인님 명령해줘 %CSTR:11% 채찍 좋아」
		PRINTFORMW 완전하게 굴복한 짐승은, 당신의 눈앞에서 명령을 기다려 바라고 있다。
	ENDIF
	CFLAG:201 = 5
	RETURN 0
ENDIF

