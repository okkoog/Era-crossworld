IF CFLAG:201 == 0 && TALENT:연모 == 0
	;種族名変数
	LOCAL = ABL:80
	PRINTFORMW 「%STR:LOCAL%%NAME:TARGET%、맹약에 따라 찾아뵈었습니다。뭐든 명령을………
