	CASE 124
			SELECTCASE ARG
				;一緒に気持ちよくしようというセリフ
				CASE 1
					PRINTFORMW 『자아、같이 기분 좋게 하자！』
					RETURN 1
				;私のほうが気持ちよくしてるというセリフ
				CASE 2
					PRINTFORMW 『%CSTR:ASSI:일인칭% 쪽이 더 잘하는걸！』
					PRINTFORMW 『그렇지、%CSTR:ASSI:이인칭%%UNICODE(0x2661)%』
					RETURN 1
				;煽りに対してのセリフ
				CASE 3
					PRINTFORMW 『그렇지 않아！%CSTR:ASSI:일인칭%도 지지 않는걸！』
					RETURN 1
				;いつもより感じてるねというセリフ
				CASE 4
					PRINTFORMW 『%CSTR:ASSI:이인칭%의 자지、평소보다 움찔거리네』
					RETURN 1
				;レズっぽいセリフに対するセリフ
				CASE 5
					IF ABL:ASSI:레즈끼 >= 3
						PRINTFORMW 『에헤헤、%CALLNAME과% 같이 하는게 기쁠지도』
						RETURN 1
					ENDIF
					PRINTFORMW 『%CSTR:ASSI:일인칭%랑 하는게 그렇게 좋아？』
					RETURN 1
				;二人のフェラは気持ちいいでしょ？セリフ
				CASE 6
					PRINTFORMW 『둘이서 하는 펠라는 기분 좋지？%CSTR:ASSI:이인칭%』
					RETURN 1
			ENDSELECT

