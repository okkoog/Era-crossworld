	CASE 122
		SELECTCASE ARG
			;気持ちよくて感じている
			CASE 1
				PRINTFORMW 『앙、아응…너무 기분 좋아%UNICODE(0x2661)%』
				RETURN 1
			;こっちに来てと言うセリフ
			CASE 2
				PRINTFORMW 『자아、이 쪽으로 와！』
				PRINTFORMW 『당신의 것, 받아·들여·줄·게%UNICODE(0x2661)%』
				RETURN 1
			;大丈夫というセリフ
			CASE 3
				IF 0 == 1
					PRINTFORMW 『사양할거 없어！』
				ELSE	
					PRINTFORMW 『괜찮아！』
					PRINTFORMW 『이 언니가 리드해 줄게!』
				ENDIF	
				RETURN 1
			;犯されて強がりを言うセリフ
			;CASE 4
			;	PRINTFORMW 『』
			;	RETURN 1
			;うまくなってきたねセリフ
			;CASE 5
			;	PRINTFORMW 『』
			;	RETURN 1
		ENDSELECT
		
