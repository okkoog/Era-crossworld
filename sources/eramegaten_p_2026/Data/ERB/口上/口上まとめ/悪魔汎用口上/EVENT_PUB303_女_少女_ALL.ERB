				ENDIF
		;状態変化では高慢持ちの忠誠度が上昇
		CASE GETNUM(TALENT,"교만")
				IF RAND:2
					BTL_KOJO_RESULTS:0 = 이런녀석、%LOCALS%로 충분하지！
				ELSE
					BTL_KOJO_RESULTS:0 = %CSTR:일인칭%을(를) 당해낼 리 없잖아♪ %LOCALS%!
				ENDIF
		;特殊では冷静持ちの忠誠度が上昇
		CASE GETNUM(TALENT,"냉정")
				IF RAND:2
					BTL_KOJO_RESULTS:0 = %LOCALS%네？ 응、맡겨줘！
				ELSE
					BTL_KOJO_RESULTS:0 = %LOCALS%앗! 그래 그래, 좋은 느낌♪ 흥분하면 안 돼~♪
				ENDIF
;		;愚鈍持ちは主人とのLv差だけ忠誠度が上昇
		CASE GETNUM(TALENT,"우둔")
				IF RAND:2
					BTL_KOJO_RESULTS:0 = %LOCALS%？　%이인칭이% 하는 말이라면 틀림 없네♪
				ELSE
					BTL_KOJO_RESULTS:0 = %LOCALS%로 괜찮~아?
				ENDIF
;		;虚心持ちは最低２だけ忠誠度が上昇
		CASE GETNUM(TALENT,"허심")
			BTL_KOJO_RESULTS:0 = %LOCALS%지、알고 있어？
	ENDSELECT
