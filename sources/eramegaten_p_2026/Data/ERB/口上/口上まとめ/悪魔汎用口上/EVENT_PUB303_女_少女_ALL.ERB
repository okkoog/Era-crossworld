;2022/08/23　テスト　合体メ읏セ─ジを入れてみよう！
@FUSION_LETTER_MESSAGE_PUB303,ARG,ARG:1

PRINTFORMW %CALLNAME:(ARG)%에게서 온 편지다
PRINTFORML 

;経験豊富なピクシ─と童貞あなたの場合
IF EXP:MASTER:삽입경험 == 0 && (NO:(ARG) == [[キャラ:픽시]] || NO:(ARG) == [[キャラ:하이픽시]]) && CFLAG:(ARG):이벤트가입 == 2
	PRINTFORML %CSTR:(ARG):이인칭%의 동정, 졸업시켜 주고 싶었는걸♪

;恋慕、親愛
ELSEIF TALENT:(ARG):연모 || TALENT:(ARG):친애
	;妻にな읏ている初期ピクシ─の場合
	IF TALENT:(ARG):아내 && (NO:(ARG) == [[キャラ:픽시]] || NO:(ARG) == [[キャラ:하이픽시]]) && CFLAG:(ARG):이벤트가입 >= 1 && RAND:2 == 0
		IF DAY < 10
			PRINTFORML 짧은 시간이었지만, %CSTR:(ARG):일인칭%의 색시가 될 수 있어서 기뻤어%ハート()%
			PRINTFORML 합체한 뒤의 아이도 색시로 삼아줘
		ELSEIF NO == 501 && (BASE:MASTER:LV - BASE:(ARG):LV) >= 30
			PRINTFORML %CSTR:(ARG):일인칭%(으)로는 이제 발목만 잡을 뿐이지
			PRINTFORML 합체한 뒤의 아이는 %CSTR:(ARG):일인칭%보다 강하면 좋겠네
		ELSEIF NO == 514 && (BASE:MASTER:LV - BASE:(ARG):LV) >= 30
			PRINTFORML 변이하긴 했지만 역시 발목만 잡는 거지
			PRINTFORML 합체하면 발목 안 잡게 되려나?
		ENDIF
	ELSEIF TALENT:임신
		;父親が主人公
		IF CFLAG:임신확정후의부친판정 == NO:MASTER
			IF RAND:4 == 0
				PRINTFORML 배 속의 아이랑 셋이서 놀러 가고 싶었는걸
			ELSEIF RAND:3 == 0
				PRINTFORML 아기의 얼굴, 보고 싶었네
			ELSEIF RAND:2 == 0
				PRINTFORML 합체해서 생긴 아이에게
				PRINTFORML 태어날 아이에게 붙여주려 했던 이름, 붙여줘
			ELSE
				PRINTFORML 새로운 아이에게는
				PRINTFORML 우리들의 힘이 깃들어 있으니까 최강이야
			ENDIF
		ELSE
			;ＮＴＲ対象の子供を人していた場合
			;ＮＴＲ相手の子を妊娠
			IF TALENT:ＮＴＲ >= 1 &&  CFLAG:102 == CFLAG:함락캐릭터
				PRINTFORMW 역시 합체당해 버리는구나
				PRINTFORMW 그치만
				PRINTFORML 이건 %CSTR:이인칭%이(가) 사랑해 주지 않은 결과니까 말야
			ELSE
				PRINTFORML 역시 다른 사람의 아기, 임신해 있으면 안 됐던 거야?
			ENDIF
		ENDIF
	;奴隷のレベルが凄く低い場合
	ELSEIF BASE:MASTER:LV > BASE:(ARG):LV + 25
		PRINTFORML 이제 전투에서 쓸모없는 짐짝이니까 어쩔 수 없네
		PRINTFORML 합체하면 강해져 있을 테니까, 그 아이는 %CSTR:(ARG):일인칭%처럼 귀여워해 줘
	ELSEIF RAND:4 == 0
		PRINTFORML %CSTR:(ARG):이인칭%와(과) 헤어지는 건 쓸쓸하지만
		PRINTFORML %CSTR:(ARG):일인칭%은(는) 강해져서 %CSTR:(ARG):이인칭%을(를) 지켜줄 테니까 울지 마
		PRINTFORML 울면 안 돼
	ELSEIF RAND:3 == 0
		PRINTFORML %CSTR:(ARG):일인칭%은(는) 여기서 %CSTR:(ARG):이인칭%와(과) 헤어지지만
		PRINTFORML 새로운 %CSTR:(ARG):일인칭%하고는 사이좋게 지내줘♪
	ELSEIF RAND:2 == 0
		PRINTFORML 저기 있잖아, 저기 있잖아
		PRINTFORML 과자도 맛있었고, 둘이서 노래도 부르고
		PRINTFORML 함께 있어서 즐거웠어%ハート()%
	ELSE
		PRINTFORML 함께 있어서 즐거웠어%ハート()%
	ENDIF

;淫乱、娼婦
ELSEIF TALENT:(ARG):음란 || TALENT:(ARG):창부
	;初期ピクシ─の場合
	IF (NO:(ARG) == [[キャラ:픽시]] || NO:(ARG) == [[キャラ:하이픽시]]) && CFLAG:(ARG):이벤트가입 == 1
		PRINTFORML %CSTR:(ARG):일인칭%은(는) 여기서 %CSTR:(ARG):이인칭%와(과) 헤어지지만、
		PRINTFORML 마지막으로 한 번 더 섹스하고 싶었으려나♪
	ELSEIF RAND:3 == 0
		PRINTFORML 새로운 몸이라면
		PRINTFORML 지금까지와는 다른 섹스를 할 수 있으려나♪
	ELSEIF RAND:3 == 0
		PRINTFORML 잔뜩 섹스했으니까
		PRINTFORML 다음 %CSTR:(ARG):일인칭%은(는) MAG가 빵빵해♪
	ELSEIF RAND:3 == 0
		PRINTFORMW 편지에 %CSTR:(ARG):일인칭%의 냄새를 묻혀 뒀으니까
		PRINTFORMW 쓸쓸해지면 냄새로 자위해 줘♪
	ENDIF

;服従、隷属
ELSEIF TALENT:(ARG):복종 || TALENT:(ARG):예속
	IF RAND:4 == 0
		PRINTFORML %CSTR:(ARG):일인칭%은(는) 여기서 %CSTR:(ARG):이인칭%와(과) 헤어지지만、
		PRINTFORML 새로운 %CSTR:(ARG):일인칭%도 %CSTR:(ARG):이인칭%의 펫으로 삼아줘♪
	ELSEIF RAND:3 == 0
		PRINTFORML 마지막에 %CSTR:(ARG):이인칭%에게 도움이 될 수 있어서 기쁜걸♪
	ELSEIF RAND:2 == 0
		PRINTFORML 맞거나 맞아서 아픈 게 기분 좋다는 걸 가르쳐줘서 고마워♪
	ELSE
		PRINTFORML 다음 아이도 %CSTR:(ARG):일인칭%처럼 때려가며 조교해 줘♪
	ENDIF

;屈服刻印Lv3
ELSEIF MARK:(ARG):2 == 3
	;陥落していない初期ピクシ─の場合
	IF (NO:(ARG) == [[キャラ:픽시]] || NO:(ARG) == [[キャラ:하이픽시]]) && CFLAG:(ARG):이벤트가입 >= 1
		PRINTFORML 악마는 합체해서 강해지는 법이니까
		PRINTFORML 힘내, %CSTR:(ARG):이인칭%……
	ELSEIF RAND:4 == 0
		PRINTFORML %CALLNAME:(ARG)%이(가) 그린 악마의 그림에
		PRINTFORML 「합체 후의 강한 %CSTR:(ARG):일인칭%의 상상도」
	ELSEIF RAND:3 == 0
		PRINTFORML 귀여운 악마로 만들어줘♪
	ELSEIF RAND:2 == 0
		PRINTFORML 의미불명의 히라가나와 알파벳 나열에
		PRINTFORML 『패스워드』
	ELSE
		PRINTFORML 신장이나 체중, 좋아하는 것 등의 마지막에
		PRINTFORML 『이것이 %CSTR:(ARG):일인칭%이야』
	ENDIF

;それ以外
ELSE
	IF RAND:5 == 0
		PRINTFORML 마지막까지 좋을 대로 이용당하는구나
	ELSEIF RAND:4 == 0
		PRINTFORML 그저 한 마디
		PRINTFORML 『바이바이』
	ELSEIF RAND:3 == 0
		PRINTFORML 이대로 사라져 버리지만
		PRINTFORML 미련은 없으려나
	ELSEIF RAND:2 == 0
		PRINTFORML 강해지면 %CSTR:(ARG):이인칭% 따윈 혼내줄 거야
	ELSE
		PRINTFORML 숨겨둔 간식, 먹어버린 거 원망해?
	ENDIF
ENDIF

PRINTFORML 　
PRINTFORMW 라고 적혀 있었다……



