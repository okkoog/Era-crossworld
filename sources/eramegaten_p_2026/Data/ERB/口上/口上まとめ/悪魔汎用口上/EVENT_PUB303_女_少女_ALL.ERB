				ELSE
					PRINTFORMW 「응…… 기분 좋아？」
					PRINTFORMW 「가고 있을 때 \@ PLAYER == MASTER ? %CSTR:이인칭% # 당신 \@의 얼굴、굉장히 귀엽네♪」
				ENDIF
				IF CFLAG:본방횟수
					PRINTFORMW 질내에 맥동하는 페니스를 꿀단지로 부드럽게 훑으며、%CALLNAME은% 생긋 미소를 지었다
				ELSE
					PRINTFORMW 상기된 얼굴과 초롱초롱한 눈으로 바라보며、%CALLNAME은% 다정하게 미소 지었다
				ENDIF
			;恋慕なのに周知で他人とセ읏クス
			ELSEIF (TALENT:연모 || TALENT:친애) && LOCAL > 3 && NO:PLAYER != 4999
				IF CFLAG:던전내발정
					IF RAND:2 == 0
						PRINTFORMW 「이、이런 장소에서 섹스 하자는 거야……?」
						PRINTFORMW 「그、그─게、%조사처리(CSTR:일인칭,"는")% 집에 돌아가서 하는 게 좋달、까……」
					ELSE
						PRINTFORMW 「꺄앗♥」
					ENDIF
					PRINTFORMW 「서비스 잔뜩 해줄 테니까」
					PRINTFORMW 「잔뜩 하자%ハート()%」
					CALL EVENT_MESSAGE
					PRINTFORML 　
					PRINTFORMW 「또 하자아♪」
				ELSE
					PRINTFORML 「%CSTR:일인칭%이(가) 다른 사람한테 안겨 있는데」
					PRINTFORMW 「왜 히죽거리고 있는 거야……」
					CALL EVENT_MESSAGE
					PRINTFORML 　
					PRINTFORMW 「이런 거 그만두자…」
				ENDIF
			ELSE
				PRINTFORMW 「이、이런 장소에서 섹스 하자는 거야……？」

				;４人以上、もしくは＠がセ읏クスしている場合は３人以上のパ─ティ─の場合
				IF LOCAL > 3 || (NO:PLAYER == [[キャラ:당신]] && LOCAL > 2)
					PRINTFORML 「모두가 보고 있고…」
				ELSE
					PRINTFORMW 「그、그─게、%일인칭은% 집에 돌아가서 하는 게 좋달、까……」
				ENDIF
				PRINTFORMW 「꺄앗%ハート()%」
				CALL EVENT_MESSAGE
			ENDIF
			CFLAG:602 = 1
		ENDIF

		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔に奉仕させる
		;奉仕する側
		;PLAYERに実行者の番号が入읏ています
		;-------------------------------------------------
	CASE 80
		IF (CFLAG:603 < 1 || FLAG:7 == 2)
			;実行者に対して陥落済み
			IF CFLAG:함락캐릭터 == CFLAG:PLAYER:캐릭터고유번호
				IF RAND:3
					PRINTFORMW 「전투로 기분이 들떠 있는 거네?」
					PRINTFORMW 「좋아… %CSTR:일인칭%이(가) 진정시켜 줄게%ハート()%」
				ELSEIF RAND:2
					IF HAVE_PENIS(PLAYER)
						PRINTFORMW 「후후후、이렇게 자지를 크게 하고는、어떻게 할까？」
						PRINTFORMW 「어쩔 수─ 없네─、%조사처리(CSTR:일인칭,"가")% 쪽쪽 해줄게」
						PRINTFORMW 「마음대로 정액 싸도 좋다구？ 쿡쿡」
					ELSE
						PRINTFORMW 「후후후、이렇게 거기를 흠뻑 젖셔놓고、어떻게 할까？」
						PRINTFORMW 「%일인칭은% 야한 짓 하기를 원하지？가득 만져주길 원하지？」
						PRINTFORMW 「쿡쿡、원하는 대로 해줄게、가는 거、잔뜩 보여줘？♥
					ENDIF
				ELSE
					PRINTFORMW 「뭐─어？… 거기에 야한 거、하고 싶어?」
					IF PLAYER == MASTER
						PRINTFORM 「정말、%일인칭은%
					ELSE
						PRINTFORM 「정말、%CALLNAME:PLAYER%쨩은 
					ENDIF
					PRINTFORMW 제대로 참지 못 한다니까─♪」
					PRINTFORMW 「그러면 %조사처리(CSTR:일인칭,"가")% 해줄게、잔뜩 가서 상쾌하게 해줄게♥」
				ENDIF
				CALL EVENT_MESSAGE
			ELSE
				PRINTFORMW 「아？ 무슨 일이야？」
				PRINTFORMW 「에、에─엣！？ 이런 곳에서!?」
				PRINTFORMW 「뭐어…… 조금이라면？」
				CALL EVENT_MESSAGE
			ENDIF
			CFLAG:603 = 1
		ENDIF

		;-------------------------------------------------
		;ダンジョン内性欲処理：その場で自慰
		;奉仕する側
		;PLAYERに実行者の番号が入읏ています
		;-------------------------------------------------
	CASE 81
		IF (CFLAG:604 < 1 || FLAG:7 == 2)
			;本来だと『위험일() == 2』だ읏たが、
			;人間以外だと戻り値が「３」にな읏てしまう為、条件変更
			IF CFLAG:던전내발정 || CFLAG:위험일 > 0
				PRINTFORMW 「하、하、하아……♥」
				PRINTFORMW 「이、이젠… 참을 수 없어♥」
				CALL EVENT_MESSAGE
				IF 陥落() && HAVE_VAGINA() && HAVE_PENIS(MASTER)
					PRINTFORML 「저기… %CSTR:이인칭%…」
					PRINTFORMW 「준비 다 됐으니까… 이대로 하자%ハート()%」
				ENDIF
			ELSE
				PRINTFORMW 「응、아、안、대에…」
				PRINTL
				CALL EVENT_MESSAGE
				PRINTL
				PRINTFORML 「싫、어、싫어、모두、%CSTR:일인칭%、%CSTR:일인칭%」
				PRINTFORMW 「%CSTR:일인칭%、그런、곳은、보、보면 안 돼♥」
			ENDIF
			CFLAG:604 = 1
		ENDIF

		;-------------------------------------------------
		;ダンジョン内性欲処理：物陰で自慰
		;奉仕する側
		;PLAYERに実行者の番号が入읏ています
		;-------------------------------------------------
	CASE 82
		IF (CFLAG:605 < 1 || FLAG:7 == 2)
			;本来だと『위험일() == 2』だ읏たが、
			;人間以外だと戻り値が「３」にな읏てしまう為、条件変更
			IF CFLAG:던전내발정 || CFLAG:위험일 > 0
				PRINTFORMW 「하、하、하아……♥」
				PRINTFORMW 「이、이젠… 참을 수 없어♥」
				CALL EVENT_MESSAGE
				IF 陥落() && HAVE_VAGINA() && HAVE_PENIS(MASTER)
					PRINTFORMW 「아직 안 가라앉아……」
					PRINTFORMW 「정말, %CALLNAME:MASTER%을(를) 덮쳐…버릴까나♪」
				ENDIF
			ELSE
				PRINTFORMW 「더、더는 안 돼…」
				PRINTFORMW 「미안、금방 돌아올게…」
				PRINTL
				CALL EVENT_MESSAGE
				PRINTL
				PRINTFORMW （이런 장소에서、이런 일을、혹시 누군가에게 보여버리면……）
				PRINTFORMW 「응、아아♥」
				PRINTFORMW 「가슴도、클리쨩도、부들부들해♥」
			ENDIF
			CFLAG:605 = 1
		ENDIF
	CASEELSE
		CALL EVENT_MESSAGE
ENDSELECT


