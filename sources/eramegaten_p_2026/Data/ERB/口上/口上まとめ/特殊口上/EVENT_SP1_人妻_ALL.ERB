		;ダンジョン内性欲処理：仲魔とセックスする
		;やる側
		;PLAYERに相手の番号が入っています
		;-------------------------------------------------
	CASE 84
		CALL EVENT_MESSAGE
		IF (CFLAG:606 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:606 = 1
		ENDIF
		;-------------------------------------------------
		;ダンジョン内性欲処理：仲魔に奉仕させる
		;奉仕される側
		;PLAYERに奉仕する側の番号が入っています
		;-------------------------------------------------
	CASE 80
		CALL EVENT_MESSAGE
		IF (CFLAG:606 < 1 || FLAG:7 == 2)
			PRINTFORMW
			CFLAG:606 = 1
		ENDIF


	CASEELSE
		CALL EVENT_MESSAGE
ENDSELECT

