@特殊口上条件_SP1
;男である場合はダメ
SIF IS_MALE(TARGET)
	RETURN 0
;配偶者がいない場合ダメ(配偶者は後付で増える可能性とかもあったりするのでとりあえずCSV上の数値を見る)
SIF CSVCSTR(NO:TARGET, GETNUM(CSTR, "배우자"), 0) == ""
	RETURN 0
RESULTS = 유부녀
RETURN 1

;--------------------------------------------------
;口上セレクト機能：口上説明
;--------------------------------------------------
@セレクト口上説明_SP1,ARG = 0
SIF ARG == 1
	RETURN 0
;口上名
PRINTFORML 人妻口上改訂版
;口上説明文
PRINTFORML 남편이 있는 악마용 구상입니다
PRINTFORML 회화 타입·악마 개인의 양쪽 모두를 고려하지 않고 선정했기 때문에
PRINTFORML 적용 시 큰 이미지 괴리가 발생할 가능성이 있음에 유의하여
PRINTFORML 선택해 주십시오
PRINTFORML 본 구상은 쾌락에 휩쓸리기 쉬우며 「당신이 짐승」에 대폭 가필된 개정판입니다
