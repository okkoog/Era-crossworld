@特殊口上条件_SP2
;男である場合はダメ
SIF IS_MALE(TARGET)
	RETURN 0
;息子がいない場合ダメ
SIF CSVCSTR(NO:TARGET, GETNUM(CSTR, "近親判定_息子"), 0) == ""
	RETURN 0
RESULTS = 母親
RETURN 1

;--------------------------------------------------
;口上セレクト機能：口上説明
;--------------------------------------------------
@セレクト口上説明_SP2,ARG = 0
SIF ARG == 1
	RETURN 0
;口上名
PRINTFORML 母親口上
;口上説明文
PRINTFORML 당신의 어머니인 악마용 구상입니다
PRINTFORML 회화 타입, 악마 개인 양쪽 모두를 고려하지 않고 선정되었기 때문에
PRINTFORML 적용할 경우 커다란 이미지 괴리가 발생할 가능성이 있음에 유의하여
PRINTFORML 선택해 주십시오
