;122,조수를범하게한다
;-------------------------------------------------
	CASE 122
		SELECTCASE ARG
			;気持ちよくて感じている
			CASE 1
				PRINTFORMW %CALLNAME:ASSI%은(는) 기분 좋아 보인다
			;こっちに来てと言うセリフ
			CASE 2
				PRINTFORMW %CALLNAME:ASSI%은(는) %CALLNAME%을(를) 유혹하고 있다
			;大丈夫というセリフ
			CASE 3
				PRINTFORMW %CALLNAME:ASSI%은(는) %CALLNAME%에게 범해져도 태연한 모양이다
			;犯されて強がりを言うセリフ
			CASE 4
				PRINTFORMW %CALLNAME%에게 범해지면서도 %CALLNAME:ASSI%은(는) 강한 척을 하고 있다
			;うまくなってきたねセリフ
			CASE 5
				PRINTFORMW %CALLNAME:ASSI%은(는) %CALLNAME%의 솜씨가 늘어난 것을 느끼는 모양이다
		ENDSELECT
		
