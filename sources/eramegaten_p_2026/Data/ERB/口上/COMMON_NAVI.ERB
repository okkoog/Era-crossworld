;--------------------------------------------------
;口上がない場合の汎用ナビ
;--------------------------------------------------
@KOJO_BATTLE_NAVI_COMMON, ARG
SELECTCASE TSTR:네비_시추에이션_메인
	CASE "戦闘開始"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "통상"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "格下"
						BTL_KOJO_RESULTS:0 = 적 발견, 수 {TFLAG:적초기배치수}체, 상대는 한 수 아래지만 방심하지 마세요 
					CASE "同格"
						IF RAND:2
							BTL_KOJO_RESULTS:0 = 적 발견! 수 {TFLAG:적초기배치수}체, 옵니다!
							BTL_KOJO_RESULTS:1 = %CSTR:이인칭%, 힘내세요
						ELSE
							BTL_KOJO_RESULTS:0 = 적, 수 {TFLAG:적초기배치수}체, 이길 수 있는 상대입니다!
						ENDIF
					CASE "格上"
						BTL_KOJO_RESULTS:0 = 가, 강적입니다! 수 {TFLAG:적초기배치수}체! 절대로 무리하지 마세요!
				ENDSELECT
			CASE "先制攻撃"
				BTL_KOJO_RESULTS:0 = 적 발견! 수 {TFLAG:적초기배치수}체, 아직 이쪽의 존재를 눈치채지 못했습니다
				BTL_KOJO_RESULTS:1 = 선제공격할 수 있어요, %CSTR:이인칭%
			CASE "バックアタック"
				BTL_KOJO_RESULTS:0 = 배후로부터의 기습입니다, 버텨주세요!
			CASE "バックアタック阻止"
				BTL_KOJO_RESULTS:0 = 백타로 발동, 적의 백어택을 막았습니다
				BTL_KOJO_RESULTS:1 = 적의 수 {TFLAG:적초기배치수}. 요격을!
			CASE "不意打ち"
				BTL_KOJO_RESULTS:0 = 적의 기습입니다, 수는 {TFLAG:적초기배치수}!
				BTL_KOJO_RESULTS:1 = 공격이 옵니다, 버텨주세요!
			CASE "不意打ち阻止"
				BTL_KOJO_RESULTS:0 = 백타로 발동, 적의 기습을 막았습니다!
				BTL_KOJO_RESULTS:1 = 적의 수 {TFLAG:적초기배치수}. 요격을!
		ENDSELECT
	CASE "メイン画面"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "重度の危機"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "半壊"
						IF FLAG:도주불가플래그
							BTL_KOJO_RESULTS:0 = 이대로는 전멸하고 맙니다! 어떻게든 전열을 가다듬어 주세요!
						ELSE
							BTL_KOJO_RESULTS:0 = 이대로는 전선을 유지할 수 없습니다! 어떻게든 도망쳐주세요!
						ENDIF
					CASE "異常半壊"
							BTL_KOJO_RESULTS:0 = 아군 전력이 엉망진창입니다! 치명상이 되기 전에 수습을!
					CASE "死亡者多数"
						IF FLAG:도주불가플래그
							BTL_KOJO_RESULTS:0 = {TFLAG:아군사망자수}명 전투불능! 전멸하기 전에 어서 소생을!
						ELSE
							BTL_KOJO_RESULTS:0 = {TFLAG:아군사망자수}명 전투불능! 즉시 소생시켜 주세요!
						ENDIF
					CASE "PTHP危機"
						BTL_KOJO_RESULTS:0 = 시급히 회복해 주세요! 이대로는 당하고 맙니다!
					CASE "マスター瀕死"
						BTL_KOJO_RESULTS:0 = %CSTR:이인칭%이(가) 위험합니다! 누군가 회복을 부탁드려요!
					CASE "マスター死亡"
						BTL_KOJO_RESULTS:0 = 괜찮으신가요 %CSTR:이인칭%!? 누군가 소생을!
					CASE "PTHP危機"
						IF FLAG:도주불가플래그
							BTL_KOJO_RESULTS:0 = 위험한 상태입니다! 다음 공격이 오기 전에 회복을!
						ELSE
							BTL_KOJO_RESULTS:0 = 대단히 좋지 않은 상태입니다. 어쨌든 회복을 하든가, 도망치든가 해주세요!
						ENDIF
					CASEELSE
						BTL_KOJO_RESULTS:0 = 대단히 위험한 상황입니다! 어떻게든 만회를!
				ENDSELECT
			CASE "中度の危機"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "핀치캐릭터"
						SELECTCASE TSTR:핀치캐릭터위기내용
							CASE "DYING"
								BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명% 전투불능! 소생시켜 주세요!
							CASE "HAPPY"
								IF TFLAG:핀치캐릭터 == MASTER
									BTL_KOJO_RESULTS:0 = %CSTR:이인칭%이(가) 행복한 꿈을 꾸며 움직이지 못하고 있습니다
									BTL_KOJO_RESULTS:1 = 누군가 현실로 되돌려 주세요!
								ELSE
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%이(가) 행복 상태입니다, 가능하다면 치료를!
								ENDIF
							CASE "POISON"
								IF TFLAG:핀치캐릭터 == MASTER
									BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 괜찮으신가요?
									BTL_KOJO_RESULTS:1 = 시급히 독 상태를 치료해 주세요!
								ELSE
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%이(가) 독 상태입니다, 치료를!
								ENDIF
							CASE "PANIC"
								IF TFLAG:핀치캐릭터 == MASTER
									BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 제정신을 차려주세요!
									BTL_KOJO_RESULTS:1 = 누군가 %CSTR:이인칭%의 치료를!
								ELSE
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%이(가) 혼란 상태입니다, 아군을 때리기 전에 치료를!
								ENDIF
							CASE "SLEEP"
								IF TFLAG:핀치캐릭터 == MASTER
									BTL_KOJO_RESULTS:0 = 일어나세요 %CSTR:이인칭%, 자고 있을 때가 아니에요!
									BTL_KOJO_RESULTS:1 = 누군가 %CSTR:이인칭%을(를) 흔들어 깨워주세요!
								ELSE
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%이(가) 잠들어 있습니다, 누군가 깨워주세요!
								ENDIF
							CASE "CHARM"
								IF TFLAG:핀치캐릭터 == MASTER
									BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 이쪽 목소리가 들리시나요!?
									BTL_KOJO_RESULTS:1 = 누군가 %CSTR:이인칭%의 매료를 치료해 주세요!
								ELSE
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%이(가) 매료 상태입니다, 치료를!
								ENDIF
							CASE "PALYZE"
								IF TFLAG:핀치캐릭터 == MASTER
									BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 괜찮으신가요?
									BTL_KOJO_RESULTS:1 = 누군가 %CSTR:이인칭%의 마비를 해제해 주세요!
								ELSE
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%이(가) 마비 상태입니다, 치료를!
								ENDIF
							CASE "STONE"
								IF TFLAG:핀치캐릭터 == MASTER
									BTL_KOJO_RESULTS:0 = %CSTR:이인칭%이(가) 석상으로!?
									BTL_KOJO_RESULTS:1 = 누군가 %CSTR:이인칭%을(를) 원래대로 되돌려 주세요!
								ELSE
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%이(가) 석화 상태입니다, 치료를!
								ENDIF
							CASEELSE
								IF TFLAG:핀치캐릭터 == MASTER
									BTL_KOJO_RESULTS:0 = %CSTR:이인칭%, 괜찮으신가요?
								ELSE
									BTL_KOJO_RESULTS:0 = %TSTR:핀치캐릭터명%이(가) 상태이상입니다, 치료를!
								ENDIF
						ENDSELECT
					;死亡者がいないが開始時点より空きポジションが増えている
					CASE "戦力低下"
						BTL_KOJO_RESULTS:0 = 전력 저하, 소환하여 보충을!
					CASE "異常者複数"
						BTL_KOJO_RESULTS:0 = 아군 {TFLAG:아군BS수}명, 상태이상. 치료해 주세요
					CASE "PTHP減少"
						BTL_KOJO_RESULTS:0 = 데미지가 축적되고 있습니다. 큰일이 나기 전에 회복해 주세요
					CASEELSE
						BTL_KOJO_RESULTS:0 = 조금 위험할지도 모릅니다. 문제가 되기 전에 대처해 주세요
				ENDSELECT
			CASE "平常"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "一部撃破済み"
						IF RAND:4 == 1
							BTL_KOJO_RESULTS:0 = 적 남은 수 {TFLAG:적배치수}체, 힘내세요!
						ELSEIF RAND:3 == 1
							BTL_KOJO_RESULTS:0 = 그 상태입니다, 힘내세요!
						ELSEIF RAND:2 == 1
							BTL_KOJO_RESULTS:0 = 적 {TFLAG:적초기배치수}체 중 {(TFLAG:적초기배치수 - TFLAG:적배치수)}체 격파! 계속해서 격파를 노려주세요
						ELSE
							BTL_KOJO_RESULTS:0 = 적의 수는 줄어들고 있습니다. 이대로 공격을 계속해 주세요!
						ENDIF
					CASE "トーク_ものもらい"
						IF GROUPMATCH(TSTR:교섭획득물, "ダメージ", "ダメージ阻止")
							BTL_KOJO_RESULTS:0 = 교섭 성공이네요. 취득물은…… 데미지!?
							IF TSTR:교섭획득물 == "ダメージ阻止"
								BTL_KOJO_RESULTS:1 = 효과는 없었던 것 같습니다만… 너무하네요…
							ELSE
								BTL_KOJO_RESULTS:1 = 괘, 괜찮으신가요?
							ENDIF
						ELSEIF TSTR:교섭획득물 == "性経験"
							BTL_KOJO_RESULTS:0 = ………하아, 즐거우셨나요?
						ELSE
							BTL_KOJO_RESULTS:0 = 교섭 성공이네요. 역시 대단해요!
						ENDIF
					CASE "トーク_おこらせる"
						BTL_KOJO_RESULTS:0 = 교섭 실패네요……
						BTL_KOJO_RESULTS:1 = 기습당하지 않은 것만으로도 다행이라고 해야 할까요
					CASE "トーク_会話終了"
						BTL_KOJO_RESULTS:0 = 교섭 실패네요
						BTL_KOJO_RESULTS:1 = 하지만, 아직 이야기를 들을 생각은 있는 모양입니다. 계속하시겠습니까?
					CASE "トーク_立ち去る"
						;味方にいる悪魔を立ち去らせた場合
						IF FINDCHARA_B(NO:(TFLAG:교섭대상))
							BTL_KOJO_RESULTS:0 = 적 악마의 이탈을 확인!
							BTL_KOJO_RESULTS:1 = 동족이 있어서 살았네요!
						ELSE
							BTL_KOJO_RESULTS:0 = 交渉の結果により、적 악마의 이탈을 확인!
							BTL_KOJO_RESULTS:1 = 다음은 어떻게 하시겠습니까?
						ENDIF
					CASE "トーク_逃げられる"
						BTL_KOJO_RESULTS:0 = 도, 도망쳐 버렸네요…
						BTL_KOJO_RESULTS:1 = 기운 차리고 나아가요!
					CASEELSE
						IF RAND:2 == 1
							BTL_KOJO_RESULTS:0 = 적 잔여 수 {TFLAG:적배치수}, 힘내세요!
						ELSE
							BTL_KOJO_RESULTS:0 = 적 세력은 아직 건재합니다, 방심하지 마세요!
						ENDIF
				ENDSELECT

		ENDSELECT
	CASE "戦闘終了"
		SELECTCASE TSTR:네비_시추에이션_서버1
			CASE "勝利"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "계약"
						BTL_KOJO_RESULTS:0 = 악마 계약의 완료를 확인했습니다.
						BTL_KOJO_RESULTS:1 = 교섭 수고하셨습니다.
					CASE "契約失敗"
						BTL_KOJO_RESULTS:0 = 悪魔契約の失敗を確認しました。
						BTL_KOJO_RESULTS:1 = 交渉自体はうまくいっていたのに惜しいですね…
					CASE "1ターンキル"
						BTL_KOJO_RESULTS:0 = 殲滅完了！　すごいはやさです！
					CASE "早期決着"
						BTL_KOJO_RESULTS:0 = 殲滅完了！　楽勝でしたね！
					CASE "長期戦"
						BTL_KOJO_RESULTS:0 = 敵の全滅を確認しました。
						BTL_KOJO_RESULTS:1 = なかなかの強敵でしたね。お疲れ様です。
					CASE "壊滅的"
						BTL_KOJO_RESULTS:0 = 戦闘の終了を確認！
						BTL_KOJO_RESULTS:1 = 生きててよかったです…
					CASE "被害甚大"
						BTL_KOJO_RESULTS:0 = 戦闘の終了を確認！
						BTL_KOJO_RESULTS:1 = 危ういところでした…はやく次に備えて立て直しましょう。
					CASE "被害大"
						BTL_KOJO_RESULTS:0 = 戦闘終了です。
						BTL_KOJO_RESULTS:1 = 回復して次に備えましょう
					CASE "被害軽微"
						BTL_KOJO_RESULTS:0 = 戦闘終了です。
						BTL_KOJO_RESULTS:1 = 問題になるほどではありませんが被害が少しでています。回復したほうが良いかもしれません。
					CASE "被害皆無"
						BTL_KOJO_RESULTS:0 = 모든 적의 배제를 확인했습니다!
						BTL_KOJO_RESULTS:1 = 被害も少なくこのまま次の戦闘の続行も可能です！
					CASE "格下"
						BTL_KOJO_RESULTS:0 = 섬멸 완료, 수고하셨습니다!
					CASE "格上"
						BTL_KOJO_RESULTS:0 = 대단해요, 저런 강적을 쓰러뜨려 버리다니……!
					CASEELSE
						BTL_KOJO_RESULTS:0 = 모든 적의 배제를 확인했습니다!
						BTL_KOJO_RESULTS:1 = 여러분, 수고하셨습니다
				ENDSELECT
			CASE "도주"
				SELECTCASE TSTR:네비_시추에이션_서버2
					CASE "格下"
						BTL_KOJO_RESULTS:0 = 戦闘からの離脱を確認。敵も追ってこないようです
					CASE "格上"
						BTL_KOJO_RESULTS:0 = 戦闘からの離脱を確認。
						BTL_KOJO_RESULTS:1 = ひやひやしました…
					CASEELSE
						BTL_KOJO_RESULTS:0 = 戦闘からの離脱を確認しました。もう大丈夫なようです。
				ENDSELECT
			CASE "敗北"
				BTL_KOJO_RESULTS:0 = 그런…… 전멸!?
				BTL_KOJO_RESULTS:1 = 起きてください%CSTR:이인칭%、%CSTR:이인칭%！
		ENDSELECT
ENDSELECT

;戦況判断用のフラグをセットする
@SET_NAVI_DATA_FOR_BATTLE_START
#DIM L_POS
#DIM LCOUNT
#DIM L_CHARA
TFLAG:아군초기배치수 = 0
TFLAG:아군평균레벨 = 0
FOR L_POS, 1, 7
	L_CHARA = POS(L_POS)
	SIF L_CHARA < 0
		CONTINUE
	TFLAG:아군배치수++
	TFLAG:아군초기배치수++
	TFLAG:아군평균레벨 += BASE:L_CHARA:LV
NEXT
TFLAG:아군평균레벨 /= TFLAG:아군초기배치수

TFLAG:적초기배치수 = 0
TFLAG:적평균레벨 = 0
FOR L_POS, 7, 17
	L_CHARA = POS(L_POS)
	SIF L_CHARA < 0
		CONTINUE
	SIF CFLAG:L_CHARA:보스플래그
		TFLAG:보스플래그있음++
	TFLAG:적배치수++
	TFLAG:적초기배치수++
	TFLAG:적평균레벨 += BASE:L_CHARA:LV
NEXT
IF TFLAG:적초기배치수
	TFLAG:적평균레벨 /= TFLAG:적초기배치수
	TFLAG:적아군레벨차 = TFLAG:아군평균레벨 - TFLAG:적평균레벨
ELSE
	TFLAG:적평균레벨 = 0
	TFLAG:적아군레벨차 = 0
ENDIF

@SET_NAVI_DATA_FOR_MAIN
#DIM L_POS
#DIM LCOUNT
#DIM L_CHARA
#DIMS TEMP_RISK
#DIM RISK_RANK
#DIM TEMP_RISK_RANK
TFLAG:아군배치수 = 0
TFLAG:아군사망자수 = 0
TFLAG:아군HP잔존율 = 0
TFLAG:핀치캐릭터 = -1
TSTR:핀치캐릭터위기내용 = 
TFLAG:아군BS수 = 0
RISK_RANK = 0
FOR L_POS, 1, 7
	L_CHARA = POS(L_POS)
	SIF L_CHARA < 0
		CONTINUE
	SIF IS_BADSTATE(L_CHARA, "DYING") || IS_BADSTATE(L_CHARA, "STONE")
		TFLAG:아군사망자수++
	TFLAG:아군배치수++
	TFLAG:아군HP잔존율 += 現HP割合(L_CHARA)
	SELECTCASE 現HP割合(L_CHARA)
		CASE IS < 25
			IF IS_BADSTATE(L_CHARA, "DYING")
				TEMP_RISK_RANK = 10000
				TEMP_RISK = DYING
			ELSE
				TEMP_RISK_RANK = 9000
				TEMP_RISK = 瀕死
			ENDIF
		CASE IS < 50		
			TEMP_RISK_RANK = 1
			TEMP_RISK = 重傷
		CASEELSE
			TEMP_RISK_RANK = 0
			TEMP_RISK = 
	ENDSELECT
	IF !GROUPMATCH(GET_STATE(CFLAG:L_CHARA:상태이상), "GOOD", "DYING", "ORGY")
		TEMP_RISK_RANK = BADSTATE_PRIORITY(CFLAG:L_CHARA:상태이상) * 10
		TEMP_RISK = %GET_STATE(CFLAG:L_CHARA:상태이상)%
		TFLAG:아군BS수++
	ENDIF
	IF TEMP_RISK_RANK > 0
		;よりリスクが高いキャラに情報を置き換える
		IF (RISK_RANK < TEMP_RISK_RANK || (RISK_RANK == TEMP_RISK_RANK && RAND:2))
			TFLAG:핀치캐릭터 = L_CHARA
			TSTR:핀치캐릭터명 = %CALLNAME:L_CHARA%
			TSTR:핀치캐릭터위기내용 = %TEMP_RISK%
			RISK_RANK = TEMP_RISK_RANK
		ENDIF
	ENDIF
NEXT
;残存率は初期味方の配置数で割る( = 悪魔が退場してできた空きポジションも死亡扱いで見る)
TFLAG:아군HP잔존율 /= TFLAG:아군초기배치수

TFLAG:적배치수 = 0
TFLAG:적HP잔존율 = 0
FOR L_POS, 7, 17
	L_CHARA = POS(L_POS)
	SIF L_CHARA < 0
		CONTINUE
	SIF !(IS_BADSTATE(L_CHARA, "DYING") || IS_BADSTATE(L_CHARA, "STONE"))
		TFLAG:적배치수++
	TFLAG:적HP잔존율 += 現HP割合(L_CHARA)
NEXT
TFLAG:적HP잔존율 /= TFLAG:적초기배치수

@SUPORT(LOCAL:1, LOCAL:2)
#DIM STCOK_TARGET
