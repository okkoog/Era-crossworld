				CATCH
					IF LOCAL:12 == NO:MASTER
						PRINTFORML %CALLNAME:ASSI%「%CSTR:ASSI:12%, 이쪽 목소리가 들리시나요!?」
						PRINTFORMW %CALLNAME:ASSI%「누군가 %CSTR:ASSI:12%의 매료를 치료해 주세요!」
					ELSE
						PRINTFORMW %CALLNAME:ASSI%「%CALLNAME:(LOCAL:12)%이(가) 매료 상태입니다, 치료를!」
					ENDIF
				ENDCATCH
			;その他のバステ
			ELSEIF RESULT == 11
				TRYCCALLFORM BATTLE_NAVI%口上関数末尾文字(ASSI)%(21, LOCAL:3, LOCAL:4, LOCAL:5, LOCAL:7, LOCAL:8, LOCAL:9, LOCAL:10, LOCAL:12)
				CATCH
				IF LOCAL:12 == NO:MASTER
						PRINTFORML %CALLNAME:ASSI%「%CSTR:ASSI:12%, 괜찮으신가요?」
					ELSE
						PRINTFORMW %CALLNAME:ASSI%「%CALLNAME:(LOCAL:12)%이(가) 상태이상입니다, 치료를!」
					ENDIF
				ENDCATCH
			ENDIF
			LOCAL:6 += 1
		NEXT
		ENDIF
	;ＨＰを50%切った味方がいる
	ELSEIF LOCAL:8 > 0
		TRYCCALLFORM BATTLE_NAVI%口上関数末尾文字(ASSI)%(28, LOCAL:3, LOCAL:4, LOCAL:5, LOCAL:7, LOCAL:8, LOCAL:9, LOCAL:10, LOCAL:12)
		CATCH
			PRINTFORMW %CALLNAME:ASSI%「아군 {LOCAL:8}명, HP 감소. 큰일이 나기 전에 회복해 주세요」
		ENDCATCH
	;危険な状態の味方はいない
	ELSE
		IF FLAG:도주불가플래그
			TRYCCALLFORM BATTLE_NAVI%口上関数末尾文字(ASSI)%(29, LOCAL:3, LOCAL:4, LOCAL:5, LOCAL:7, LOCAL:8, LOCAL:9, LOCAL:10, LOCAL:12)
			CATCH
				PRINTFORMW %CALLNAME:ASSI%「강적이지만 %CSTR:ASSI:12%라면 쓰러뜨릴 수 있어요, 포기하지 마세요!」
			ENDCATCH
		ELSEIF (LOCAL:3 - LOCAL:4 > 0)
			TRYCCALLFORM BATTLE_NAVI%口上関数末尾文字(ASSI)%(30, LOCAL:3, LOCAL:4, LOCAL:5, LOCAL:7, LOCAL:8, LOCAL:9, LOCAL:10, LOCAL:12)
			CATCH
				IF RAND:4 == 1
					PRINTFORMW %CALLNAME:ASSI%「적 남은 수 {LOCAL:4}체, 힘내세요!」
				ELSEIF RAND:3 == 1
					PRINTFORMW %CALLNAME:ASSI%「그 상태입니다, 힘내세요!」
				ELSEIF RAND:2 == 1
					PRINTFORMW %CALLNAME:ASSI%「적 {LOCAL:3}체 중 {(LOCAL:3 - LOCAL:4)}체 격파! 계속해서 격파를 노려주세요」
				ELSE
					PRINTFORMW %CALLNAME:ASSI%「적의 수는 줄어들고 있습니다. 이대로 공격을 계속해 주세요!」
				ENDIF
			ENDCATCH
		ELSE
			TRYCCALLFORM BATTLE_NAVI%口上関数末尾文字(ASSI)%(31, LOCAL:3, LOCAL:4, LOCAL:5, LOCAL:7, LOCAL:8, LOCAL:9, LOCAL:10, LOCAL:12)
			CATCH
				IF RAND:2 == 1
					PRINTFORMW %CALLNAME:ASSI%「적 잔여 수 {LOCAL:4}, 힘내세요!」
				ELSE
					PRINTFORMW %CALLNAME:ASSI%「적 세력은 아직 건재합니다, 방심하지 마세요!」
				ENDIF
			ENDCATCH
		ENDIF
	ENDIF
ENDIF
TARGET = STCOK_TARGET
RETURN 0
;-------------------------------------
;テーブルの中に指定したシチェーションが入っているかの確認数
;ランダムで選ばれなかった条件を拾いたい場合に
;-------------------------------------
@ナビ_シチュエーション存在取得, ARGS
#FUNCTION
RETURNF COUNT_SPLIT(TSTR:네비_시추에이션테이블, "/", ARGS)

;CHECK_STATUS
@CHECK_STATUS(LOCAL:1)
	LOCALS = 포지션{LOCAL:1}
	SIF FLAG:LOCALS < 0
		RETURN -1
	LOCAL:2 = NO:(LOCAL:1)
	LOCAL:1 = FLAG:LOCALS
	;死亡していたら報告
	IF CFLAG:(LOCAL:1):상태이상 == GET_STATE_NUM("DYING")
		RETURN 10
	;HPが25%を切ったら報告
	ELSEIF (BASE:(LOCAL:1):ＨＰ * 100 / MAXBASE:(LOCAL:1):ＨＰ) < 25
		RETURN 9
	;毒なら報告
	ELSEIF CFLAG:(LOCAL:1):상태이상 == GET_STATE_NUM("POISON")
		RETURN 8
	;麻痺なら報告
	ELSEIF CFLAG:(LOCAL:1):상태이상 == GET_STATE_NUM("PALYZE")
		RETURN 7
	;石化なら報告
	ELSEIF CFLAG:(LOCAL:1):상태이상 == GET_STATE_NUM("STONE")
		RETURN 6
	;ハッピーなら報告
	ELSEIF CFLAG:(LOCAL:1):상태이상 == GET_STATE_NUM("HAPPY")
		RETURN 5
	;パニックなら報告
	ELSEIF CFLAG:(LOCAL:1):상태이상 == GET_STATE_NUM("PANIC")
		RETURN 4
	;スリープなら報告
	ELSEIF CFLAG:(LOCAL:1):상태이상 == GET_STATE_NUM("SLEEP")
		RETURN 3
	;チャームなら報告
	ELSEIF CFLAG:(LOCAL:1):상태이상 == GET_STATE_NUM("CHARM")
		RETURN 2
	;HPが50%を切ったら報告
	ELSEIF (BASE:(LOCAL:1):ＨＰ * 100 / MAXBASE:(LOCAL:1):ＨＰ) < 50
		RETURN 1
	;それ以外のバステなら報告
	ELSEIF CFLAG:(LOCAL:1):상태이상 > 0
		RETURN 11
	;特に報告することなし
	ELSE
		RETURN 0
	ENDIF
RETURN -1
