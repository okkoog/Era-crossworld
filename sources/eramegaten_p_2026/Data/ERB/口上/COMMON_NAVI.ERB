LOCAL:15 = 0
LOCAL:5 = 0
;助手がＰＴにいる場合はアナウンスできない
FOR LOCAL,1,7
	LOCALS = 포지션{LOCAL}
	SIF FLAG:LOCALS < 0
		CONTINUE
	SIF FLAG:LOCALS == ASSI
		RETURN -1
;味方情報取得
	LOCAL:15 += BASE:(FLAG:LOCALS):LV
	LOCAL:5 += 1
NEXT

STCOK_TARGET = TARGET
TARGET = ASSI

LOCAL:18 = (LOCAL:15 / LOCAL:5)
LOCAL:7 = 0
LOCAL:8 = 0
LOCAL:9 = 0
LOCAL:10 = 0
;戦闘開始時
IF LOCAL:1 == 1
	LOCAL:14 = 0
	LOCAL:11 += 1
	LOCAL:3 = 0
	LOCAL:19 = 0
	FOR LOCAL,1,7
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS < 0
			CONTINUE
		LOCAL:19 += 1
	NEXT
	FOR LOCAL,7,17
		LOCALS = 포지션{LOCAL}
		SIF FLAG:LOCALS < 0
			CONTINUE
		LOCAL:14 += BASE:(FLAG:LOCALS):LV
		LOCAL:3 += 1
	NEXT
	LOCAL:17 = LOCAL:14 / LOCAL:3
	PRINTL 
	DRAWLINE
	PRINTL
	;通常
	IF LOCAL:2 == 0
		;味方のレベルが敵のレベルより１０以上高い
		IF LOCAL:18 - LOCAL:17 >= 10
			TRYCCALLFORM BATTLE_NAVI%口上関数末尾文字(ASSI)%(0, LOCAL:3, LOCAL:4, LOCAL:5, LOCAL:7, LOCAL:8, LOCAL:9, LOCAL:10, LOCAL:12)
