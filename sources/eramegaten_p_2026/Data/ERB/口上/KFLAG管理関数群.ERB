;---------------------------------------------
;	@イベント口上呼び出しイベント名 , ARG = -1 , ARGS == ""
;	イベント口上を呼び出すイベントの名称を定義し、参照可能な状態にする
;	引数それぞれに初期値以外の値が入っているのであれば、その番号のイベントの名称、あるいは指定した名称の管理番号を文字列（整数で欲しければRESULT_F）で返す
;
;	呼び出された時、管理変数が空であれば、その中に設定済みのイベント名を放り込んでいく
;	※口上を呼び出すイベントを新設する場合、ここにイベント名を追記していく事で番号を自動的に割り振って管理出来る。
;	（将来的には既存の番号との前後関係などを一切気にしないで済むようにしたいが、そのためには全ての口上ファイルに手を入れる必要がある）
;
;---------------------------------------------
@イベント口上呼び出しイベント名 , ARG = -1 
#FUNCTIONS
IF INRANGE(ARG, 0, VARSIZE("イベント口上呼び出しイベント管理変数")-1)
	RETURNF イベント口上呼び出しイベント管理変数:ARG
ENDIF
RETURNF

@イベント口上呼び出しイベント番号 , ARGS = ""
#FUNCTION
IF ARGS != ""
	RETURNF FINDELEMENT(イベント口上呼び出しイベント管理変数 , ARGS)
ENDIF
RETURNF -1