;-------------------------------------------------
; 한국어 호환 래퍼: @근친체크
;-------------------------------------------------
@근친체크(ARG, ARG:1)
#FUNCTION
LOCAL = 近親チェック(ARG, ARG:1)
IF LOCAL
	SELECTCASE RESULTS
		CASE "父"
			RESULTS = 아버지
		CASE "母"
			RESULTS = 어머니
		CASE "兄弟"
			RESULTS = 형제
		CASE "姉妹"
			RESULTS = 자매
		CASE "娘"
			RESULTS = 딸
		CASE "息子"
			RESULTS = 아들
	ENDSELECT
	SELECTCASE RESULTS:1
		CASE "父"
			RESULTS:1 = 아버지
		CASE "母"
			RESULTS:1 = 어머니
		CASE "兄弟"
			RESULTS:1 = 형제
		CASE "姉妹"
			RESULTS:1 = 자매
		CASE "娘"
			RESULTS:1 = 딸
		CASE "息子"
			RESULTS:1 = 아들
	ENDSELECT
ENDIF
RETURNF LOCAL


