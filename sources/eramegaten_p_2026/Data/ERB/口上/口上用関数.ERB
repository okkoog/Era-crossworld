;-------------------------------------------------
; 호환 래퍼: @WRITE_IMG (구버전 이미지 호출 함수 안전 처리)
;-------------------------------------------------
@WRITE_IMG, ARG, ARG:1 = 0, ARG:2 = 0, ARGS = ""
#DIM IMG_NO
#DIM CHARA
TRYCCALLFORM PRINT_SPECIAL_FACE_CHARA_{ARG}, FINDCHARA(NO, ARG), ARG:1 / 100, ARG:1 % 10, ARG:2 % 10
	IF RESULT
		SIF !STRCOUNT(ARGS, "이미지주소취득") && !STRCOUNT(ARGS, "アドレス取得")
			PRINT_IMG RESULTS
		RETURN 1
	ENDIF
CATCH
ENDCATCH

LOCALS = {ARG}_{ARG:1}_{ARG:2}
IF SPRITECREATED(LOCALS)
	PRINT_IMG LOCALS
	RETURN 1
ENDIF
RETURN 0

