L_TEXT:20 '= ""
L_TEXT:21 '= ""
L_TEXT:22 '= ""
L_TEXT:23 '= ""
L_TEXT:24 '= ""
L_TEXT:25 '= ""
L_TEXT:26 '= ""
L_TEXT:27 '= ""
L_TEXT:28 '= ""
L_TEXT:29 '= ""

FOR LCOUNT, G_ANNOUNCE_LINE_ADD, FINDELEMENT(L_TEXT, "", , , 1)
	IF IS_SHOWED_HEADER == 0
		DRAWLINE
		PRINTL 　追加・変更
		DRAWLINE
		IS_SHOWED_HEADER = 1
	ENDIF
	HTML_PRINT L_TEXT:LCOUNT
	G_ANNOUNCE_LINE_ADD = LCOUNT + 1
NEXT
IF IS_SHOWED_HEADER
	WHILE LINECOUNT < L_LINE + (CLIENTHEIGHT() / GETCONFIG("フォントサイズ"))
		PRINTL 
	WEND
	WAIT
ENDIF

