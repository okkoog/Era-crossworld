;追加・修正
;---------------------------------------------------------
@ANNOUNCE_MINOR_ADD
#DIM DYNAMIC LCOUNT
#DIMS DYNAMIC L_TEXT, 50
#DIM DYNAMIC IS_SHOWED_HEADER
#DIM DYNAMIC L_LINE
SIF G_LASTLOAD_VERSION < GAMEBASE_VERSION
	G_ANNOUNCE_LINE_ADD = 0
L_LINE = LINECOUNT
L_TEXT:0 '= ""
L_TEXT:1 '= ""
L_TEXT:2 '= ""
