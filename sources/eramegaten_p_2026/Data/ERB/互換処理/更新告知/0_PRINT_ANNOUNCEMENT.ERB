@PRINT_ANNOUNCEMENT, L_VERSION, L_DAY
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_LINE
#DIM DYNAMIC L_VERSION
#DIMS DYNAMIC L_DAY
IF !MESSKIP()
	FOR LCOUNT, 0, 50
		PRINTL 
	NEXT
ENDIF
LCOUNT = 0
L_LINE = LINECOUNT
WHILE 1
	RESULT = 0
	CUSTOMDRAWLINE =
	PRINTFORML Ver %TOSTR(L_VERSION / 100 / 100, "0")%.%TOSTR(L_VERSION / 100 % 100, "0")%.%TOSTR(L_VERSION % 100 % 100, "0")%(%L_DAY%)
	CUSTOMDRAWLINE =
	CALLFORM PRINT_ANNOUNCEMENT_%TOSTR(L_VERSION, "000000")%, LCOUNT
	WHILE LINECOUNT < L_LINE + 40
		PRINTL 
	WEND
	IF !MESSKIP()
		WAITANYKEY
		CLEARLINE LINECOUNT - L_LINE
		TWAIT 100, 1
	ENDIF
	SIF RESULT >= 0
		BREAK
	LCOUNT++
WEND