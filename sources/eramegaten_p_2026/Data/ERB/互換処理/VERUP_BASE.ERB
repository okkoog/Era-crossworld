@VERUP_FOR_CHARA_LEGACY, L_CHARA
#DIM DYNAMIC TEMP
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_CHARA
IF CFLAG:L_CHARA:본체버전정보 < 0309154
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 3
		SIF NO:L_CHARA == [[キャラ:초텐짱]]
			CFLAG:L_CHARA:링크불능 = 1
		IF GET_RACE(ABL:L_CHARA:종족) == "머신"
			CFLAG:L_CHARA:소속ＣＯＭＰ = 0
			CALL CHANGE_ROLE, L_CHARA, "", ""
		ENDIF
		SIF EQUIP:L_CHARA:악세서리 == 5204
			EQUIP:L_CHARA:악세서리 = 0
	ENDIF
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 4
		IF GROUPMATCH(NO:L_CHARA, [[キャラ:유리코]], [[キャラ:리리스_진]], [[キャラ:사사즈카치요_네코마타]], [[キャラ:사사즈카치요_바스테드]], [[キャラ:듀]])
			TEMP = NO:L_CHARA
			IF NO:L_CHARA !=  [[キャラ:듀]]
				FLAG:(10000 + NO:L_CHARA) = FLAG:(10000 + TEMP)
				FLAG:(20000 + NO:L_CHARA) = FLAG:(20000 + TEMP)
				FLAG:(30000 + NO:L_CHARA) = FLAG:(30000 + TEMP)
				FLAG:(50000 + NO:L_CHARA) = FLAG:(50000 + TEMP)
				FLAG:(10000 + TEMP) = 0
				FLAG:(20000 + TEMP) = 0
				FLAG:(30000 + TEMP) = 0
				FLAG:(50000 + TEMP) = 0
			ENDIF
			ABL:L_CHARA:종족 = GET_RACE_NUM("악마인")
			SIF ABL:L_CHARA:변이 == 425
				ABL:L_CHARA:변이 = [[キャラ:리리스_진]]
			SIF ABL:L_CHARA:변이 == 841
				ABL:L_CHARA:변이 = [[キャラ:사사즈카치요_바스테드]]
			CALL CLEAR_ROLE_TALENT, L_CHARA
			CFLAG:L_CHARA:소속ＣＯＭＰ = 0
			CALL CHANGE_ROLE, L_CHARA, "스킬적성_3", ""
			EQUIP:L_CHARA:악세서리 = 0
		ELSEIF ABL:L_CHARA:종족 == GET_RACE_NUM("악마인")
			IF L_CHARA != MASTER && CSVABL(NO:L_CHARA, GETNUM(ABL, "종족")) != GET_RACE_NUM("악마인")
				CALL CHANGE_ROLE, L_CHARA, "데모노이드", ""
			ELSE
				SIF L_CHARA != MASTER
					CALL CLEAR_ROLE_TALENT, L_CHARA
				CFLAG:L_CHARA:소속ＣＯＭＰ = 0
				CALL CHANGE_ROLE, L_CHARA, "", ""
			ENDIF
		ENDIF
	ENDIF
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 5
		IF GROUPMATCH(NO:L_CHARA, [[キャラ:유리코]], [[キャラ:리리스_진]], [[キャラ:사사즈카치요_네코마타]], [[キャラ:사사즈카치요_바스테드]]) && TALENT:L_CHARA:마술의소양 == 5
			TALENT:L_CHARA:마술의소양 = 0
			TALENT:L_CHARA:스킬적성 = 3
		ENDIF
		;本来のゲストからフラグをはく奪するのを回避するための分岐
		IF FLAG:SHOP커맨드 == [[ショップ:탐색]]
			SIF CPOS(L_CHARA) == 0
				CFLAG:L_CHARA:게스트가입플래그 = 0
		ELSE
			CFLAG:L_CHARA:게스트가입플래그 = 0
		ENDIF
	ENDIF
ENDIF
