		FLAG:버전관리보조 = 4
	ENDIF
	;CALL PRINT_ANNOUNCEMENT, 000308, "20241101"
	;FLAG:버전관리보조 = 0

	IF FLAG:버전관리보조 == 4
		FOR LCOUNT, 0, 10000
			REMOVED_FUSION_LIMIT:LCOUNT = FLAG:(10000 + LCOUNT)
		NEXT
		;売却人数をチェック
		FOR LCOUNT, 0, 10000
			;売却数が1以上でない、またはcsvが定義されていない場合は弾く
			SIF FLAG:(30000+LCOUNT) <= 0 || !EXISTCSV(LCOUNT, 0)
				CONTINUE
			;該当キャラが人間系の場合
			IF GROUPMATCH(GET_RACE(CSVABL(LCOUNT, GETNUM(ABL, "종족"))), "인간", "반마인")
				FLAG:누계인간판매수 += FLAG:(30000+LCOUNT)
			;人間系ではない＝悪魔系の場合
			ELSE
				FLAG:누계악마판매수 += FLAG:(30000+LCOUNT)
			ENDIF
			COUNT_SOLD_CHARA:LCOUNT = FLAG:(30000+LCOUNT)
		NEXT

