		FLAG:버전관리보조 = 1
	ENDIF
	IF FLAG:버전관리보조 == 1
		FOR LCOUNT, 0, SKILLNUM
			IF ITEM:(LCOUNT + ITEMNUM) > 0
				CALL GET_SKILL_PROP, "継承不能", LCOUNT, -1
				SIF RESULT == 1
					TAKEN_SKILLCARD:LCOUNT = 1
			ENDIF
		NEXT
		FLAG:버전관리보조 = 2
	ENDIF
	IF FLAG:버전관리보조 == 2
		FLAG:버전관리보조 = 3
