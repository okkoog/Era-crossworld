IF GET_GAME_VERSION_P(CFLAG:L_CHARA:본체버전정보) < 000506
	SIF L_CHARA == MASTER
		CALL SET_TALENT_PARTY_JOINABLE, L_CHARA, "参加可能"
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 1
		SELECTCASE NO:L_CHARA
			CASE [[キャラ:이계의다크서머너]]
				CALL CHANGE_ROLE, L_CHARA, "이능자_5/전심_1/스킬적성_3/무도의마음가짐_1/서머너_1", , , "サブ素質引継ぎなし"
				CALL CLEAR_ALL_SKILL, L_CHARA
				CALL RESET_SKILL_FOR_CHARA, L_CHARA
		ENDSELECT
	ENDIF
	CFLAG:L_CHARA:본체버전관리보조정보 = 0
ENDIF

IF GET_GAME_VERSION_P(CFLAG:L_CHARA:본체버전정보) < 000507
	SIF ABL:L_CHARA:공격범위 == 0
		ABL:L_CHARA:공격범위 = 1
	SIF NO:L_CHARA == [[キャラ:매드가서]]
		CALL RESET_CHARA_PROFILE, L_CHARA
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 1
		SELECTCASE NO:L_CHARA
			CASE [[キャラ:마리_마인학원]], [[キャラ:타츠마]],[[キャラ:코마키]],[[キャラ:아란]],[[キャラ:키사라기]]
				CALL RESET_SKILL_FOR_CHARA, L_CHARA
				FOR LCOUNT, 0, SUCCESSIONNUM
					TALENT:L_CHARA:GET_SUCCESSION(LCOUNT) = CSVTALENT(NO:L_CHARA, GETNUM(TALENT, GET_SUCCESSION(LCOUNT)))
				NEXT
			CASE [[キャラ:아오이_마인학원]]
				CALL RESET_SKILL_FOR_CHARA, L_CHARA
				FOR LCOUNT, 0, SUCCESSIONNUM
					TALENT:L_CHARA:GET_SUCCESSION(LCOUNT) = CSVTALENT(NO:L_CHARA, GETNUM(TALENT, GET_SUCCESSION(LCOUNT)))
				NEXT
				TALENT:L_CHARA:공격의심득 = 0
				TALENT:L_CHARA:신들의가호 = 5
			CASE [[キャラ:텐도]]
				IF GETBIT(CFLAG:L_CHARA:개별이벤트읽음, 0)
					CFLAG:L_CHARA:이벤트가입 = 1

					CALL CLEAR_ALL_SKILL, L_CHARA
					CALL CLEAR_LEARNED_SKILL_ALL, L_CHARA
					CALL SET_LEARN_SKILL_[[キャラ:텐도]], L_CHARA, 1
				ELSE
					CALL RESET_SKILL_FOR_CHARA, L_CHARA
				ENDIF
			CASE [[キャラ:다이고]]
				CALL SET_LEARN_SKILL, L_CHARA, "CSTR専用スキル/稲妻ラリアット", 30, "変身形態"
		ENDSELECT
	ENDIF
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 2
		TALENT:L_CHARA:197 = 0
		TALENT:L_CHARA:198 = 0
		TALENT:L_CHARA:199 = 0
	ENDIF
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 4
		SELECTCASE CFLAG:L_CHARA:1007
			CASE -1
				CALL SET_TALENT_PARTY_JOINABLE, L_CHARA, "신용"
			CASE 1
				CALL SET_TALENT_PARTY_JOINABLE, L_CHARA, "参加不可能"
			CASE 2
				CALL SET_TALENT_PARTY_JOINABLE, L_CHARA, "반역"
		ENDSELECT
		CFLAG:L_CHARA:1007 = 0
		TALENT:L_CHARA:낙적 = CSVTALENT(NO:L_CHARA, GETNUM(TALENT, "낙적"))
	ENDIF
	CFLAG:L_CHARA:본체버전관리보조정보 = 0
ENDIF

IF GET_GAME_VERSION_P(CFLAG:L_CHARA:본체버전정보) < 000508
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 1
		SELECTCASE  NO:L_CHARA
			CASE [[キャラ:마초]], [[キャラ:마일드]], [[キャラ:이능쨩]]
				CALL RESET_CHARA_PROFILE, L_CHARA
		ENDSELECT
	ENDIF
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 3
		CSTR:L_CHARA:잠재전투소질'= REPLACE(CSTR:L_CHARA:잠재전투소질, "不浄の手", "바스테부스터")
	ENDIF
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 4
		IF NO:L_CHARA == [[キャラ:메갈로돈]]
			IF MAXARRAY(TALENT:L_CHARA:0, GETNUM(TALENT, "검격"), GETNUM(TALENT, "검격") + SUCCESSIONNUM) == 0
				FOR LCOUNT, GETNUM(TALENT, "검격"), GETNUM(TALENT, "검격") + SUCCESSIONNUM
					TALENT:L_CHARA:LCOUNT = CSVTALENT(NO:L_CHARA, LCOUNT)
				NEXT
			ENDIF
		ENDIF
	ENDIF
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 5
		SELECTCASE NO:L_CHARA
			CASE [[キャラ:루파]]
				CALL RESET_CHARA_PROFILE, L_CHARA
				SIF CSTR:L_CHARA:체형 == "ロン毛"
					CSTR:L_CHARA:체형 '= "ハーフアップ"
			CASE [[キャラ:게일]]
				SIF CSTR:L_CHARA:머리색 == ""
					CSTR:L_CHARA:머리색 '= CSVCSTR(NO:L_CHARA, GETNUM(CSTR, "머리색"))
				SIF CSTR:L_CHARA:체형 == ""
					CSTR:L_CHARA:체형 '= CSVCSTR(NO:L_CHARA, GETNUM(CSTR, "체형"))
				SIF CSTR:L_CHARA:눈동자색 == ""
					CSTR:L_CHARA:눈동자색 '= CSVCSTR(NO:L_CHARA, GETNUM(CSTR, "눈동자색"))
				SIF CSTR:L_CHARA:피부색 == ""
					CSTR:L_CHARA:피부색 '= CSVCSTR(NO:L_CHARA, GETNUM(CSTR, "피부색"))
				SIF CSTR:L_CHARA:일인칭 == ""
					CSTR:L_CHARA:일인칭 '= CSVCSTR(NO:L_CHARA, GETNUM(CSTR, "일인칭"))
				SIF CSTR:L_CHARA:이인칭 == ""
					CSTR:L_CHARA:이인칭 '= CSVCSTR(NO:L_CHARA, GETNUM(CSTR, "이인칭"))
				SIF CSTR:L_CHARA:타이틀 == ""
					CSTR:L_CHARA:타이틀 '= CSVCSTR(NO:L_CHARA, GETNUM(CSTR, "타이틀"))
		ENDSELECT
	ENDIF
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 7
		IF NO:L_CHARA == [[キャラ:렌]] || NO:L_CHARA == [[キャラ:하얀렌]]
			CALL RESET_CHARA_PROFILE, L_CHARA
		ENDIF
	ENDIF
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 8
		CALL LINK_陥落素質, L_CHARA
	ENDIF
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 9
		IF NO:L_CHARA == [[キャラ:나나시]]
			CALL RESET_CHARA_PROFILE, L_CHARA
		ENDIF
	ENDIF
	IF CFLAG:L_CHARA:본체버전관리보조정보 < 10
		CALL CONVERT_SKILL_NUMBER_FOR_CHARA, L_CHARA, 73, [[스킬:반역의칼날]]
		IF NO:L_CHARA == [[キャラ:고로]]
			ABL:L_CHARA:수태아이템 = CSVABL(NO:L_CHARA, GETNUM(ABL, "수태아이템"))
		ENDIF
	ENDIF
	CFLAG:L_CHARA:본체버전관리보조정보 = 0
ENDIF
IF CFLAG:L_CHARA:본체버전관리보조정보 < 1
	SELECTCASE  NO:L_CHARA
		CASE [[キャラ:유카_아이마스]]
			CALL CHANGE_ROLE, L_CHARA, "이능자_5/공격의심득_2", , , "サブ素質引継ぎなし"
	ENDSELECT
ENDIF
IF CFLAG:L_CHARA:본체버전관리보조정보 < 2
	IF NO:L_CHARA == 5037
		CALL CONVERT_CHARA_NO_FOR_CHARA, L_CHARA, NO:L_CHARA, [[キャラ:혹등고래]]
	ENDIF
ENDIF
IF CFLAG:L_CHARA:본체버전관리보조정보 < 4
	IF NO:L_CHARA == 1121
		CALL CONVERT_CHARA_NO_FOR_CHARA, L_CHARA, NO:L_CHARA, [[キャラ:광무]]
	ENDIF
ENDIF
CFLAG:L_CHARA:본체버전관리보조정보 = 0
