NICKNAME:L_CHARA '= CSVNICKNAME(NO:L_CHARA)
;--------------------------------------------------
;存在しなくなったスキルの削除関数
;--------------------------------------------------
@CHECK_EXIST_SKILL
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC CHARA
#DIM DYNAMIC SKILL
#DIM DYNAMIC LSKILL_COUNT
#DIMS DYNAMIC L_SKILLS
#DIM DYNAMIC L_PERSONA
FOR CHARA,0,CHARANUM
	FOR LCOUNT, 0, 2
		FOR SKILL, 1, 21
			IF LCOUNT == 0
				L_SKILLS = 스킬{SKILL}
			ELSE
				L_SKILLS = 습득스킬{SKILL}
			ENDIF
			IF IS_PU_SKILLNUM(ABL:CHARA:L_SKILLS)
				CALL GET_SKILL_PROP, "SKILL_NAME", ABL:CHARA:L_SKILLS, CHARA
				SIF RESULTS != ""
					CONTINUE
				SIF !LSKILL_COUNT
					PRINTW スキルチェック中に不正なCSTR専用スキルを発見しました
				PRINTFORML キャラ番号{CHARA}(%CALLNAME:CHARA%)のスキル{SKILL-59}(%CSTR:CHARA:@"전용기{ABL:CHARA:L_SKILLS - [[스킬:전용기1]] + 1}"%)
				CSTR:CHARA:@"전용기{ABL:CHARA:L_SKILLS - [[스킬:전용기1]] + 1}" '= ""
			ELSE
				CALL GET_SKILL_PROP, "SKILL_NAME", ABL:CHARA:L_SKILLS, CHARA
				SIF RESULTS != ""
					CONTINUE
				SIF !LSKILL_COUNT
					PRINTW スキルチェック中に不正なスキル番号を発見しました
				PRINTFORML キャラ番号{CHARA}(%CALLNAME:CHARA%)の%L_SKILLS%({ABL:CHARA:L_SKILLS})
			ENDIF
			ABL:CHARA:L_SKILLS = 0
			CALL CLEAR_LEARNED_SKILL, CHARA, TOSTR(ABL:CHARA:L_SKILLS)
			SIF LCOUNT == 1
				ABL:CHARA:@"습득LV{SKILL}" = 0
			LSKILL_COUNT++
		NEXT	
	NEXT
NEXT
FOR L_PERSONA, 0, 100
	FOR LCOUNT, 1, 9
		CALL GET_SKILL_PROP, "SKILL_NAME", DITEMTYPE:L_PERSONA:페르소나(@"스킬{LCOUNT}"), -1
		SIF RESULTS != ""
			CONTINUE
		SIF !LSKILL_COUNT
			PRINTW スキルチェック中に不正なスキル番号を発見しました
		PRINTFORML ペルソナ番号{L_PERSONA}(%CSVCALLNAME(DITEMTYPE:L_PERSONA:페르소나("NO"))%)の%@"스킬{LCOUNT}"%({DITEMTYPE:L_PERSONA:페르소나(@"스킬{LCOUNT}")})
		DITEMTYPE:L_PERSONA:페르소나(@"스킬{LCOUNT}") = 0
		LSKILL_COUNT = 1
	NEXT
	FOR LCOUNT, 1, 21
		CALL GET_SKILL_PROP, "SKILL_NAME", DITEMTYPE:L_PERSONA:페르소나(@"습득스킬{LCOUNT}"), -1
		SIF RESULTS != ""
			CONTINUE
		SIF !LSKILL_COUNT
			PRINTW スキルチェック中に不正なスキル番号を発見しました
		PRINTFORML ペルソナ番号{L_PERSONA}(%CSVCALLNAME(DITEMTYPE:L_PERSONA:페르소나("NO"))%)の%@"습득스킬{LCOUNT}"%({DITEMTYPE:L_PERSONA:페르소나(@"습득스킬{LCOUNT}")})
		DITEMTYPE:L_PERSONA:페르소나(@"습득스킬{LCOUNT}") = 0
		DITEMTYPE:L_PERSONA:페르소나(@"습득LV{LCOUNT}") = 0
		LSKILL_COUNT = 1
	NEXT
NEXT
SIF LSKILL_COUNT
	PRINTW 該当スキルを削除します。

@SET_CHARA_EXPLAIN_BY_CSV, L_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
FOR LCOUNT, GETNUM(CSTR, "해설1"), GETNUM(CSTR, "해설20") + 1
	CSTR:L_CHARA:LCOUNT '= CSVCSTR(NO:L_CHARA, LCOUNT)
