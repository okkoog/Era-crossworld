@RESET_SKILL_FOR_CHARA, L_CHARA, L_TRANCE = "両形態", L_OPT
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC L_TRANCE
#DIMS DYNAMIC L_OPT
#DIM DYNAMIC LCOUNT

SIF !STRCOUNT(L_OPT, "習得スキルのみ")
	CALL CLEAR_ALL_SKILL, L_CHARA
CALL CLEAR_ALL_LEARN_SKILL, L_CHARA
CALL CLEAR_LEARNED_SKILL_ALL, L_CHARA
FOR LCOUNT, 1, 12
	CSTR:L_CHARA:@"전용기{LCOUNT}" '= CSVCSTR(NO:L_CHARA, GETNUM(CSTR, @"전용기{LCOUNT}"))
NEXT
IF GROUPMATCH(L_TRANCE, "通常形態", "両形態")
	FOR LCOUNT, 1, 21
		SIF !CSVABL(NO:L_CHARA, GETNUM(ABL, @"스킬{LCOUNT}"))
			CONTINUE
		CALL SET_LEARN_SKILL, L_CHARA, TOSTR(CSVABL(NO:L_CHARA, GETNUM(ABL, @"스킬{LCOUNT}"))), 1, , "入れ替え確認"
	NEXT
	FOR LCOUNT, 1, 21
		SIF !CSVABL(NO:L_CHARA, GETNUM(ABL, @"습득스킬{LCOUNT}"))
			CONTINUE
		CALL SET_LEARN_SKILL, L_CHARA, TOSTR(CSVABL(NO:L_CHARA, GETNUM(ABL, @"습득스킬{LCOUNT}"))), CSVABL(NO:L_CHARA, GETNUM(ABL, @"습득LV{LCOUNT}")), , "入れ替え確認"
	NEXT
	CSTR:L_CHARA:MAG습득스킬리스트 '= CSVCSTR(NO:L_CHARA, GETNUM(CSTR, "MAG습득스킬리스트"))
ENDIF
IF GROUPMATCH(L_TRANCE, "変身形態", "両形態")
	FOR LCOUNT, 1, 21
		SIF !CSVABL(NO:L_CHARA, GETNUM(ABL, @"초기변신악마스킬{LCOUNT}"))
			CONTINUE
		CALL SET_LEARN_SKILL, L_CHARA, TOSTR(CSVABL(NO:L_CHARA, GETNUM(ABL, @"초기변신악마스킬{LCOUNT}"))), 1, , "入れ替え確認"
	NEXT
	FOR LCOUNT, 1, 21
		SIF !CSVABL(NO:L_CHARA, GETNUM(ABL, @"초기변신악마습득스킬{LCOUNT}"))
			CONTINUE
		CALL SET_LEARN_SKILL, L_CHARA, TOSTR(CSVABL(NO:L_CHARA, GETNUM(ABL, @"습득스킬{LCOUNT}"))), CSVABL(NO:L_CHARA, GETNUM(ABL, @"초기변신악마습득LV{LCOUNT}")), , "入れ替え確認"
	NEXT
	CSTR:L_CHARA:초기변신악마MAG스킬습득리스트 '= CSVCSTR(NO:L_CHARA, GETNUM(CSTR, "초기변신악마MAG스킬습득리스트"))
ENDIF

