;========================================================================================
;このバリアント用のバージョン切り取り関数
;========================================================================================
@GET_GAME_VERSION_P, ARG
#FUNCTION
RETURNF ARG / 1000 / 1000

;======================================
;キャラ番号の変換関数
;======================================
@CONVERT_CHARA_NO,OLD_NO,NEW_NO
#DIM DYNAMIC NEW_NO
#DIM DYNAMIC OLD_NO
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC LCOUNT
FOR L_CHARA,0,CHARANUM
	CALL CONVERT_CHARA_NO_FOR_CHARA, L_CHARA, OLD_NO, NEW_NO
	;妊娠情報
	IF FETUS_PALENT_NO:L_CHARA:0 == OLD_NO || FETUS_PALENT_NO:L_CHARA:1 == NEW_NO
		CALL CLEAR_PREGNANCY_FLAG, L_CHARA
		TALENT:L_CHARA:임신 = 0
		PRINTFORMW 캐릭터 번호 이동에 따라 %CALLNAME:L_CHARA%의 임신 정보를 폐기했습니다
	ENDIF
NEXT

;合体解禁
REMOVED_FUSION_LIMIT:NEW_NO = REMOVED_FUSION_LIMIT:OLD_NO
REMOVED_FUSION_LIMIT:OLD_NO = 0
;売却回数
COUNT_SOLD_CHARA:NEW_NO = COUNT_SOLD_CHARA:OLD_NO
COUNT_SOLD_CHARA:OLD_NO = 0

;陥落履歴
FALLEN_RECORD:NEW_NO = FALLEN_RECORD:OLD_NO
FALLEN_RECORD:OLD_NO = 0

;解析度
ANALYSIS_RATE:NEW_NO = ANALYSIS_RATE:OLD_NO
ANALYSIS_RATE:OLD_NO = 0
IS_CHARA_COMPANIONED:NEW_NO = IS_CHARA_COMPANIONED:OLD_NO
IS_CHARA_COMPANIONED:OLD_NO = 0

;페르소나
FOR LOCAL, 0, 100
	SIF DITEMTYPE:LOCAL:페르소나("NO") == OLD_NO
		DITEMTYPE:LOCAL:페르소나("NO") = NEW_NO
NEXT
;======================================
;キャラ番号の変換関数
;======================================
@CONVERT_CHARA_NO_FOR_CHARA, L_CHARA, OLD_NO, NEW_NO
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC NEW_NO
#DIM DYNAMIC OLD_NO
#DIM DYNAMIC LCOUNT
;NO
IF NO:L_CHARA == OLD_NO
	NO:L_CHARA = NEW_NO
	NICKNAME:L_CHARA '= CSVNICKNAME(NEW_NO)
ENDIF
;妊娠中の子の父親
SIF CFLAG:L_CHARA:임신확정후의부친판정 == OLD_NO
	CFLAG:L_CHARA:임신확정후의부친판정 = NEW_NO
SIF ABL:L_CHARA:변이 == OLD_NO
	ABL:L_CHARA:변이 = NEW_NO
SIF CFLAG:L_CHARA:초기링크악마 == OLD_NO
	CFLAG:L_CHARA:초기링크악마 = NEW_NO
SIF ABL:L_CHARA:초기페르소나 == OLD_NO
	ABL:L_CHARA:초기페르소나 = NEW_NO
SIF ABL:L_CHARA:초기페르소나2 == OLD_NO
	ABL:L_CHARA:초기페르소나2 = NEW_NO
SIF ABL:L_CHARA:초기페르소나3 == OLD_NO
	ABL:L_CHARA:초기페르소나3 = NEW_NO
SIF ABL:L_CHARA:각성스킬 == OLD_NO
	ABL:L_CHARA:각성스킬 = NEW_NO

;--------------------------------------------------
;スキル番号の入れ替え措置
;--------------------------------------------------
@CONVERT_SKILL_NUMBER, OLD_NO, NEW_NO
#DIM LCOUNT, 2
#DIM L_CHARA
#DIM DYNAMIC OLD_NO
#DIM DYNAMIC NEW_NO
FOR L_CHARA, 0, CHARANUM
	CALL CONVERT_SKILL_NUMBER_FOR_CHARA, L_CHARA, OLD_NO, NEW_NO
NEXT

FOR LCOUNT:1, 1, 11
	FOR LCOUNT, 1, 9
		SIF DITEMTYPE:(LCOUNT:1):페르소나(@"스킬{LCOUNT}") == OLD_NO
			DITEMTYPE:(LCOUNT:1):페르소나(@"스킬{LCOUNT}") = NEW_NO
	NEXT
	FOR LCOUNT, 1, 21
		SIF DITEMTYPE:(LCOUNT:1):페르소나(@"습득스킬{LCOUNT}") == OLD_NO
			DITEMTYPE:(LCOUNT:1):페르소나(@"습득스킬{LCOUNT}") = NEW_NO
	NEXT
NEXT
;スキルカード
IF NEW_NO != 0
	ITEM:(10000+NEW_NO) = ITEM:(10000+OLD_NO)
	TAKEN_SKILLCARD:NEW_NO = TAKEN_SKILLCARD:OLD_NO
ENDIF
ITEM:(10000+OLD_NO) = 0
TAKEN_SKILLCARD:OLD_NO = 0

IF ABLE_MAKESKILLCARD(OLD_NO)
	SIF NEW_NO != 0
		CALLF ABLE_MAKESKILLCARD(NEW_NO, 1)
ELSE
	CALLF ABLE_MAKESKILLCARD(NEW_NO, -1)
ENDIF
CALLF ABLE_MAKESKILLCARD(OLD_NO, -1)
;--------------------------------------------------
;キャラ個別のスキル番号の入れ替え関数
;--------------------------------------------------
@CONVERT_SKILL_NUMBER_FOR_CHARA, L_CHARA, OLD_NO, NEW_NO
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC NEW_NO
#DIM DYNAMIC OLD_NO
FOR LCOUNT, 1, 21
	SIF ABL:L_CHARA:@"스킬{LCOUNT}" == OLD_NO
		ABL:L_CHARA:@"스킬{LCOUNT}" = NEW_NO
	SIF ABL:L_CHARA:@"습득스킬{LCOUNT}" == OLD_NO
		ABL:L_CHARA:@"습득스킬{LCOUNT}" = NEW_NO
	SIF ABL:L_CHARA:@"인간시스킬{LCOUNT}" == OLD_NO
		ABL:L_CHARA:@"인간시스킬{LCOUNT}" = NEW_NO
	SIF ABL:L_CHARA:@"초기변신악마스킬{LCOUNT}" == OLD_NO
		ABL:L_CHARA:@"초기변신악마스킬{LCOUNT}" = NEW_NO
	SIF ABL:L_CHARA:@"초기변신악마습득스킬{LCOUNT}" == OLD_NO
		ABL:L_CHARA:@"초기변신악마습득스킬{LCOUNT}" = NEW_NO
NEXT
IF TALENT:L_CHARA:페르소나구사자
	FOR LCOUNT, 1, 9
		SIF DITEMTYPE:(CFLAG:L_CHARA:초기페르소나넘버):페르소나(@"스킬{LCOUNT}") == OLD_NO
			DITEMTYPE:(CFLAG:L_CHARA:초기페르소나넘버):페르소나(@"스킬{LCOUNT}") = NEW_NO
	NEXT
	FOR LCOUNT, 1, 21
		SIF DITEMTYPE:(CFLAG:L_CHARA:초기페르소나넘버):페르소나(@"습득스킬{LCOUNT}") == OLD_NO
			DITEMTYPE:(CFLAG:L_CHARA:초기페르소나넘버):페르소나(@"습득스킬{LCOUNT}") = NEW_NO
	NEXT
ENDIF
IF TALENT:L_CHARA:식노
	CDFLAG:L_CHARA:식노습득스킬:(0) = CDFLAG:L_CHARA:식노습득스킬:OLD_NO
	CDFLAG:L_CHARA:식노습득스킬:OLD_NO = NEW_NO
ENDIF
FOR LCOUNT:1, 0, 2
	IF NEW_NO > 0
		C_LEARNED_SKILLS:L_CHARA:(LCOUNT:1) = %REPLACE("/" + C_LEARNED_SKILLS:L_CHARA:(LCOUNT:1) + "/", "/" + TOSTR(OLD_NO) + "/", "/" + TOSTR(NEW_NO) + "/")%
	ELSE
		C_LEARNED_SKILLS:L_CHARA:(LCOUNT:1) = %REPLACE("/" + C_LEARNED_SKILLS:L_CHARA:(LCOUNT:1) + "/", "/" + TOSTR(OLD_NO) + "/", "/")%
	ENDIF
	C_LEARNED_SKILLS:L_CHARA:(LCOUNT:1) = %SUBSTRING(C_LEARNED_SKILLS:L_CHARA:(LCOUNT:1), 1, STRLENS(C_LEARNED_SKILLS:L_CHARA:(LCOUNT:1)) - 2)%
NEXT
FOR LCOUNT:1, 1, 11
	FOR LCOUNT, 1, 9
		SIF DITEMTYPE:(LCOUNT:1):페르소나(@"스킬{LCOUNT}") == OLD_NO
			DITEMTYPE:(LCOUNT:1):페르소나(@"스킬{LCOUNT}") = NEW_NO
	NEXT
	FOR LCOUNT, 1, 21
		SIF DITEMTYPE:(LCOUNT:1):페르소나(@"습득스킬{LCOUNT}") == OLD_NO
			DITEMTYPE:(LCOUNT:1):페르소나(@"습득스킬{LCOUNT}") = NEW_NO
	NEXT
NEXT

;--------------------------------------------------
;専用スキルのスキル名称の入れ替え措置
;--------------------------------------------------
@CONVERT_PU_SKILL_FOR_CHARA, L_CHARA, OLD_NAME, NEW_NAME
#DIM DYNAMIC LCOUNT, 2
#DIM DYNAMIC L_CHARA
#DIMS DYNAMIC OLD_NAME
#DIMS DYNAMIC NEW_NAME
FOR L_CHARA, 0, CHARANUM
	FOR LCOUNT, 1, PU_NUM() + 1
		SIF CSTR:L_CHARA:@"전용기{LCOUNT}" == OLD_NAME
			CSTR:L_CHARA:@"전용기{LCOUNT}" '= NEW_NAME
	NEXT
	FOR LCOUNT:1, 0, 2
		C_LEARNED_SKILLS:L_CHARA:(LCOUNT:1) = %REPLACE("/" + C_LEARNED_SKILLS:L_CHARA:(LCOUNT:1) + "/", "/" + OLD_NAME + "/", "/" + NEW_NAME + "/")%
		C_LEARNED_SKILLS:L_CHARA:(LCOUNT:1) = %SUBSTRING(C_LEARNED_SKILLS:L_CHARA:(LCOUNT:1), 1, STRLENS(C_LEARNED_SKILLS:L_CHARA:(LCOUNT:1)) - 2)%
	NEXT
NEXT

;--------------------------------------------------
;指定したスキルを習得するキャラが習得スキルとして該当スキルを持っていなかった場合、持たせる
;ARGS	スキル名
;--------------------------------------------------
@SET_NEW_LEARNSKILL_VERUP, ARGS
#DIM L_CHARA
#DIM L_LEARN_NO
#DIM L_HAVE_SKILLNUM
#DIM L_SKILL
L_SKILL = SKILL_NUM_F(ARGS)
FOR L_CHARA, 0, CHARANUM
	FOR L_LEARN_NO, 1, 21
		SIF HAVE_SKILL(L_CHARA, L_SKILL)
			CONTINUE
		SIF CSVABL(NO:L_CHARA, GETNUM(ABL, @"습득스킬{L_LEARN_NO}")) != L_SKILL
			CONTINUE
		PRINTFORMW %CALLNAME:L_CHARA%의 습득 예정 스킬에 %ARGS%(을)를 추가합니다
		ABL:L_CHARA:@"습득스킬{L_LEARN_NO}" = L_SKILL
		ABL:L_CHARA:@"습득LV{L_LEARN_NO}" = CSVABL(NO:L_CHARA, GETNUM(ABL, @"습득LV{L_LEARN_NO}"))
	NEXT
	FOR L_HAVE_SKILLNUM, 1, 21
		SIF HAVE_SKILL(L_CHARA, L_SKILL)
			BREAK
		SIF CSVABL(NO:L_CHARA, GETNUM(ABL, @"스킬{L_HAVE_SKILLNUM}")) != L_SKILL
			CONTINUE
		CALL SET_LEARN_SKILL, L_CHARA, ARGS, 1, , "メッセージ表示"
		BREAK
	NEXT
NEXT

;--------------------------------------------------
;CSVが存在しなくなっているキャラを確認し、振り替えさせる関数
;--------------------------------------------------
@CHECK_EXIST_CSV
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
FOR L_CHARA, 0, CHARANUM
	CALL CHECK_EXIST_CSV_FOR_CHARA, L_CHARA
NEXT
;페르소나
FOR LCOUNT, 0, 100
	SIF EXISTCSV(DITEMTYPE:LCOUNT:페르소나("NO")) == 0
		CALL DEL_PERSONA2, LCOUNT
NEXT
FOR LCOUNT, 0, CSVCHARANUM
	SIF EXISTCSV(LCOUNT)
		CONTINUE
	;合体解禁
	REMOVED_FUSION_LIMIT:LCOUNT = 0
	;売却回数
	COUNT_SOLD_CHARA:LCOUNT = 0
	;陥落履歴
	FALLEN_RECORD:LCOUNT = 0
	;解析度
	ANALYSIS_RATE:LCOUNT = 0
	IS_CHARA_COMPANIONED:LCOUNT = 0
NEXT
SAVEGLOBAL
@CHECK_EXIST_CSV_FOR_CHARA, L_CHARA
#DIM DYNAMIC LCOUNT
#DIM DYNAMIC L_CHARA
SIF CFLAG:L_CHARA:임신확정후의부친판정 >= 0 && EXISTCSV(CFLAG:L_CHARA:임신확정후의부친판정,0) == 0
	CFLAG:L_CHARA:임신확정후의부친판정 = -1
SIF EXISTCSV(CFLAG:L_CHARA:초기링크악마) == 0
	CFLAG:L_CHARA:초기링크악마 = CSVCFLAG(NO:L_CHARA, GETNUM(CFLAG, "초기링크악마"))
SIF EXISTCSV(ABL:L_CHARA:초기페르소나) == 0
	ABL:L_CHARA:초기페르소나 = CSVABL(NO:L_CHARA, GETNUM(ABL, "초기페르소나"))
SIF EXISTCSV(ABL:L_CHARA:초기페르소나2) == 0
	ABL:L_CHARA:초기페르소나2 = CSVABL(NO:L_CHARA, GETNUM(ABL, "초기페르소나2"))
SIF EXISTCSV(ABL:L_CHARA:초기페르소나3) == 0
	ABL:L_CHARA:초기페르소나3 = CSVABL(NO:L_CHARA, GETNUM(ABL, "초기페르소나3"))
SIF EXISTCSV(ABL:L_CHARA:변이) == 0
	ABL:L_CHARA:변이 = CSVABL(NO:L_CHARA, GETNUM(ABL, "변이"))
SIF EXISTCSV(ABL:L_CHARA:각성스킬) == 0
	ABL:L_CHARA:각성스킬 = 0
IF EXISTCSV(FETUS_PALENT_NO:L_CHARA:0) == 0 || EXISTCSV(FETUS_PALENT_NO:L_CHARA:1) == 0
	CALL CLEAR_PREGNANCY_FLAG, L_CHARA
	TALENT:L_CHARA:임신 = 0
	PRINTFORMW キャラ番号の移動に伴って%CALLNAME:L_CHARA%の妊娠情報を廃棄しました
ENDIF

IF EXISTCSV(NO:L_CHARA,0) == 0
	PRINTFORML %CALLNAME:L_CHARA%のＣＳＶ番号が不正です
	PRINTFORML ＣＳＶフォルダを参照し、正しい番号を入力してください
	$INPUT_LOOP
	INPUT
	IF EXISTCSV(RESULT,0) == 0
		PRINTFORML 不正な番号です。もう一度入力し直して下さい
		GOTO INPUT_LOOP
	ENDIF
	NO:L_CHARA = RESULT
	NICKNAME:L_CHARA '= CSVNICKNAME(NO:L_CHARA)
ENDIF

;NICKNAMEから番号移動に追従
IF GET_GAME_VERSION_P(LASTLOAD_VERSION) >= 000309
	IF NICKNAME:L_CHARA != "" && NICKNAME:L_CHARA != CSVNICKNAME(NO:L_CHARA)
		IF EXISTCSV(NO:L_CHARA,0) == 0
			NO:L_CHARA = GET_識別番号(NICKNAME:L_CHARA)
		ELSE
			DRAWLINE
			PRINTFORML %CALLNAME:L_CHARA%のNO(キャラクター番号)と識別名にずれがあります。
			PRINTFORML 以下の選択肢のうち、正しいキャラクター番号になるほうを指定してください。
			PRINTFORML [0] %NICKNAME:L_CHARA%
			PRINTFORML [1] %CSVNICKNAME(NO:L_CHARA)%
			DRAWLINE
			CALL INPUTINT, 0, 1
			IF RESULT == 0
				NO:L_CHARA = GET_識別番号(NICKNAME:L_CHARA)
			ELSE
				NICKNAME:L_CHARA '= CSVNICKNAME(NO:L_CHARA)
			ENDIF
		ENDIF
	ENDIF
ENDIF
