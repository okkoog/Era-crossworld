@IS_KOREAN_COUNT(ARGS)
#FUNCTION
#DIM DYNAMIC IDX
#DIM DYNAMIC CODE
#DIM DYNAMIC CHECK

FOR IDX, 0, STRLENSU(ARGS)
    CODE = ENCODETOUNI(ARGS, IDX)
    SIF (CODE >= 12593 && CODE <= 12643) || (CODE >= 44032 && CODE <= 55203)
        CHECK += 1
NEXT
RETURNF CHECK


@STRLENS_KO(ARGS)
#FUNCTION
#DIM DYNAMIC LENGTH
#DIM DYNAMIC KOREAN_COUNT

LENGTH = STRLENS(ARGS)
KOREAN_COUNT = IS_KOREAN_COUNT(ARGS)

RETURNF LENGTH + KOREAN_COUNT
