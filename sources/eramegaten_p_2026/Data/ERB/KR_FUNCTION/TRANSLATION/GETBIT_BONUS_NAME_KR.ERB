@GETBIT_BONUS_NAME_KR(ARG)
#FUNCTIONS
VARSET RESULTS_F
SELECTCASE ARG
	CASE 0
		RESULTS_F '= "인계한다", "인계하지 않는다"
		RETURNF "조교아이템 인계"
	CASE 1
		RESULTS_F '= "인계한다", "인계하지 않는다", "일부、인계받지 못하는 아이템이 존재합니다。"
		RETURNF "무기아이템 인계"
	CASE 2
		RESULTS_F '= "인계한다", "인계하지 않는다", "일부、인계받지 못하는 아이템이 존재합니다。"
		RETURNF "도구아이템 인계"
	CASE 3
		RESULTS_F '= "인계한다", "인계하지 않는다", "일부、인계받지 못하는 아이템이 존재합니다。"
		RETURNF "소비아이템 인계"
	CASE 4
		RESULTS_F '= "인계한다", "인계하지 않는다", "아이템 합성용 아이템이니 주의해주세요。"
		RETURNF "소재아이템 인계"
	CASE 5
		RESULTS_F '= "인계한다", "인계하지 않는다"
		RETURNF "마정무기 인계"
	CASE 6
		RESULTS_F '= "인계한다", "인계하지 않는다", "주인의 경험치만 인계되는 옵션이며", "동료마의 경험치는 인계되지 않습니다。"
		RETURNF "경험치 인계"
	CASE 7
		RESULTS_F '= "인계한다", "인계하지 않는다", "가격이 1000 마카 미만인 경우는 보너스와 관계없이 인계됩니다", "일부 이벤트에서 입수한 소프트가 인계되지 않을 경우、마카 교환품에 추가됩니다。"
		RETURNF "인스톨소프트 인계"
	CASE 8
		RESULTS_F '= "인계한다", "인계하지 않는다", "가격이 1000 마카 미만인 경우는 보너스와 관계없이 인계됩니다", "일부 이벤트에서 입수한 에뮬레이터가 인계되지 않을 경우、마카 교환품에 추가됩니다。"
		RETURNF "스킬에뮬레이터 인계"
	CASE 9
		RESULTS_F '= "한다", "하지 않는다", "신단의영옥　:아군 전체의 ＨＰ를 100 회복한다。전투중에만、몇 번이라도 사용 가능。", "붕괴주　　　:적 전체에 만능 상성의 소 데미지。전투중에만、몇 번이라도 사용 가능。","황금의벌꿀주:레벨이 낮은 적의 출현을 억제한다。몇 번이라도 사용 가능。"
		RETURNF "특수아이템 입수"
	CASE 10
		RESULTS_F '= "한다", "하지 않는다"
		RETURNF "수태아이템 리셋"
	CASE 11
		RESULTS_F '= "ON", "OFF", @"ＣＯＭＰ의 용량이 {4 + MATCH(COMP_SIZEUP_ACHIEVEMENT,1)} 증가합니다。", "증가량은 게임 내에서 용량을 증가하는 이벤트를 클리어하는 것으로 늘어납니다。", @"(현재 추가 보너스:{MATCH(COMP_SIZEUP_ACHIEVEMENT,1)})"
		RETURNF "ＣＯＭＰ 용량증가 1"
	CASE 12
		RESULTS_F '= "ON", "OFF", "ＣＯＭＰ의 용량이 8 증가합니다。"
		RETURNF "ＣＯＭＰ 용량증가 2"
	CASE 13
		RESULTS_F '= "ON", "OFF", "ＣＯＭＰ의 용량이 16 증가합니다。"
		RETURNF "ＣＯＭＰ 용량증가 3"
	CASE 14
		RESULTS_F '= "인계한다", "인계하지 않는다", @"게임 개시 시점부터 조직공헌 LV이 {FLAG:최대조직공헌LV} 이 됩니다。"
		RETURNF "조직공헌LV"
ENDSELECT
RETURNF "NONE"