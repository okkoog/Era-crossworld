;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
; @BUILD_JPNAME
; JPNAME:CSVNO = CSVNICKNAME(CSVNO) 를 빌드하는 함수 
; @EVENTLOAD에서 호출 권장
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
@BUILD_JPNAME
#DIM CSVNUM

SIF JPNAME:0 != ""
	RETURN

FOR CSVNUM, 0, CSVCHARANUM
	SIF !EXISTCSV(CSVNUM)
		CONTINUE

	JPNAME:CSVNUM '= CSVNICKNAME(CSVNUM)
NEXT



;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
; @CALLNAME_KR(ARGS)
; NICKNAME을 받아 CALLNAME으로 변환하는 함수
; 없으면 원문 그대로를 반환한다
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
@CALLNAME_KR(ARGS)
#FUNCTIONS
#DIM DYNAMIC _No

_No = FINDELEMENT(JPNAME, ARGS)
IF _No >0
    RETURNF CSVCALLNAME(_No)
ELSE
    RETURNF ARGS
ENDIF



