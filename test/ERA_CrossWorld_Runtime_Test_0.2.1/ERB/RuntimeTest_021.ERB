; ============================================================================
; ERA CrossWorld Runtime Test 0.2.1
; 0.2 load-error fix:
; - Built-in-looking local names I / N etc. removed.
; - All private variables use CWRT_ prefix.
; ============================================================================

@SYSTEM_TITLE
$CWRT_MENU
DRAWLINE
SETCOLORBYNAME yellow
PRINTL ERA CrossWorld Runtime Test 0.2.1
RESETCOLOR
PRINTFORML Client area : {CLIENTWIDTH()} x {CLIENTHEIGHT()} px
PRINTFORML Memory      : {GETMEMORYUSAGE()/1024/1024} MB
DRAWLINE
PRINTL [1] Standard NPC Suite (100 / 1,000 / 5,000 / 10,000, 10-min tick)
PRINTL [2] Stress Test (10,000 NPC, 1-min tick)
PRINTL [3] 18:00 Sanity Check
PRINTL [4] VARSET reset test
PRINTL [9] Exit
ONEINPUT

SELECTCASE RESULT
CASE 1
    CALL CWRT_STANDARD_SUITE
    GOTO CWRT_MENU
CASE 2
    CALL CWRT_RUN_BENCHMARK,10000,1
    GOTO CWRT_MENU
CASE 3
    CALL CWRT_SANITY_CHECK
    GOTO CWRT_MENU
CASE 4
    CALL CWRT_VARSET_TEST
    GOTO CWRT_MENU
CASE 9
    PRINTL 아무 키/클릭으로 종료한다.
    QUIT
CASEELSE
    GOTO CWRT_MENU
ENDSELECT


@CWRT_STANDARD_SUITE
DRAWLINE
SETCOLORBYNAME yellow
PRINTL [STANDARD NPC SUITE]
RESETCOLOR
PRINTL 하루 1440분을 10분 tick으로 계산한다.
PRINTL 시작하려면 아무 키/클릭.
WAIT

CALL CWRT_RUN_BENCHMARK,100,10
CALL CWRT_RUN_BENCHMARK,1000,10
CALL CWRT_RUN_BENCHMARK,5000,10
CALL CWRT_RUN_BENCHMARK,10000,10

SETCOLORBYNAME lime
PRINTL [SUITE COMPLETE]
RESETCOLOR
PRINTL 결과 화면을 캡처한다.
PRINTL 아무 키/클릭으로 메뉴로 돌아간다.
WAIT
RETURN


@CWRT_RUN_BENCHMARK,ARG:0,ARG:1
#DIM CWRT_IDX
#DIM CWRT_TICK_INDEX
#DIM CWRT_TICK_COUNT
#DIM CWRT_MINUTE_NOW
#DIM CWRT_START_MINUTE
#DIM CWRT_END_MINUTE
#DIM CWRT_INIT_START_MS
#DIM CWRT_INIT_END_MS
#DIM CWRT_SIM_START_MS
#DIM CWRT_SIM_END_MS
#DIM CWRT_MEMORY_BEFORE
#DIM CWRT_MEMORY_AFTER
#DIM CWRT_UPDATE_COUNT
#DIM CWRT_CHECKSUM_VALUE
#DIM CWRT_BENCH_NPC_COUNT

CWRT_BENCH_NPC_COUNT = ARG:0
CWRT_TICK_COUNT = 1440 / ARG:1

PRINTL
DRAWLINE
PRINTFORML [BENCH] NPC={CWRT_BENCH_NPC_COUNT} / tick={ARG:1} min / ticks={CWRT_TICK_COUNT}

CWRT_MEMORY_BEFORE = GETMEMORYUSAGE()

CWRT_INIT_START_MS = GETMILLISECOND()
FOR CWRT_IDX,0,CWRT_BENCH_NPC_COUNT
    CWRT_NPC_HOME:CWRT_IDX = CWRT_IDX % 64
    CWRT_NPC_WORK:CWRT_IDX = 100 + (CWRT_IDX % 128)
    CWRT_NPC_SEED:CWRT_IDX = (CWRT_IDX * 37 + 17) % 1000
    CWRT_NPC_LOCATION:CWRT_IDX = CWRT_NPC_HOME:CWRT_IDX
    CWRT_NPC_ACTIVITY:CWRT_IDX = 0
NEXT
CWRT_INIT_END_MS = GETMILLISECOND()

CWRT_SIM_START_MS = GETMILLISECOND()

FOR CWRT_TICK_INDEX,0,CWRT_TICK_COUNT
    CWRT_MINUTE_NOW = CWRT_TICK_INDEX * ARG:1
    CWRT_WORLD_MINUTE = CWRT_MINUTE_NOW

    FOR CWRT_IDX,0,CWRT_BENCH_NPC_COUNT
        CWRT_START_MINUTE = 420 + (CWRT_NPC_SEED:CWRT_IDX % 8) * 15
        CWRT_END_MINUTE = 960 + (CWRT_NPC_SEED:CWRT_IDX % 9) * 15

        IF CWRT_MINUTE_NOW < CWRT_START_MINUTE
            CWRT_NPC_LOCATION:CWRT_IDX = CWRT_NPC_HOME:CWRT_IDX
        ELSEIF CWRT_MINUTE_NOW < CWRT_START_MINUTE + 60
            CWRT_NPC_LOCATION:CWRT_IDX = 1000 + (CWRT_IDX % 16)
        ELSEIF CWRT_MINUTE_NOW < CWRT_END_MINUTE
            CWRT_NPC_LOCATION:CWRT_IDX = CWRT_NPC_WORK:CWRT_IDX
        ELSEIF CWRT_MINUTE_NOW < CWRT_END_MINUTE + 120
            IF CWRT_IDX % 2 == 0
                CWRT_NPC_LOCATION:CWRT_IDX = 2000 + (CWRT_IDX % 32)
            ELSE
                CWRT_NPC_LOCATION:CWRT_IDX = 3000 + (CWRT_IDX % 32)
            ENDIF
        ELSE
            CWRT_NPC_LOCATION:CWRT_IDX = CWRT_NPC_HOME:CWRT_IDX
        ENDIF

        CWRT_NPC_ACTIVITY:CWRT_IDX = (CWRT_NPC_ACTIVITY:CWRT_IDX + CWRT_NPC_LOCATION:CWRT_IDX + (CWRT_IDX % 7)) % 1000000
    NEXT
NEXT

CWRT_SIM_END_MS = GETMILLISECOND()

CWRT_CHECKSUM_VALUE = 0
FOR CWRT_IDX,0,CWRT_BENCH_NPC_COUNT
    CWRT_CHECKSUM_VALUE += CWRT_NPC_ACTIVITY:CWRT_IDX
NEXT

CWRT_MEMORY_AFTER = GETMEMORYUSAGE()
CWRT_UPDATE_COUNT = CWRT_BENCH_NPC_COUNT * CWRT_TICK_COUNT

CWRT_LAST_NPC_COUNT = CWRT_BENCH_NPC_COUNT
CWRT_LAST_TICK_MINUTES = ARG:1
CWRT_LAST_SIM_MS = CWRT_SIM_END_MS - CWRT_SIM_START_MS
CWRT_LAST_CHECKSUM = CWRT_CHECKSUM_VALUE

SETCOLORBYNAME lime
PRINTL [RESULT]
RESETCOLOR
PRINTFORML Init                  : {CWRT_INIT_END_MS-CWRT_INIT_START_MS} ms
PRINTFORML Simulation            : {CWRT_SIM_END_MS-CWRT_SIM_START_MS} ms
PRINTFORML NPC updates           : {CWRT_UPDATE_COUNT}
PRINTFORML Avg per tick          : {(CWRT_SIM_END_MS-CWRT_SIM_START_MS)/MAX(1,CWRT_TICK_COUNT)} ms
PRINTFORML Updates/sec           : {CWRT_UPDATE_COUNT*1000/MAX(1,CWRT_SIM_END_MS-CWRT_SIM_START_MS)}
PRINTFORML Checksum              : {CWRT_CHECKSUM_VALUE}
PRINTFORML Memory before         : {CWRT_MEMORY_BEFORE/1024/1024} MB
PRINTFORML Memory after          : {CWRT_MEMORY_AFTER/1024/1024} MB
PRINTFORML Memory delta          : {(CWRT_MEMORY_AFTER-CWRT_MEMORY_BEFORE)/1024} KB
RETURN


@CWRT_SANITY_CHECK
#DIM CWRT_SANITY_IDX
#DIM CWRT_SANITY_NPC_COUNT
#DIM CWRT_SANITY_MINUTE
#DIM CWRT_SANITY_START_MINUTE
#DIM CWRT_SANITY_END_MINUTE
#DIM CWRT_HOME_COUNT
#DIM CWRT_TRANSIT_COUNT
#DIM CWRT_WORK_COUNT
#DIM CWRT_SHOP_COUNT
#DIM CWRT_PARK_COUNT
#DIM CWRT_OTHER_COUNT
#DIM CWRT_TOTAL_COUNT

DRAWLINE
SETCOLORBYNAME yellow
PRINTL [18:00 SANITY CHECK]
RESETCOLOR

CWRT_SANITY_NPC_COUNT = CWRT_LAST_NPC_COUNT
IF CWRT_SANITY_NPC_COUNT <= 0
    PRINTL 먼저 [1] 또는 [2] 벤치마크를 실행한다.
    WAIT
    RETURN
ENDIF

CWRT_SANITY_MINUTE = 1080
CWRT_HOME_COUNT = 0
CWRT_TRANSIT_COUNT = 0
CWRT_WORK_COUNT = 0
CWRT_SHOP_COUNT = 0
CWRT_PARK_COUNT = 0
CWRT_OTHER_COUNT = 0

FOR CWRT_SANITY_IDX,0,CWRT_SANITY_NPC_COUNT
    CWRT_SANITY_START_MINUTE = 420 + (CWRT_NPC_SEED:CWRT_SANITY_IDX % 8) * 15
    CWRT_SANITY_END_MINUTE = 960 + (CWRT_NPC_SEED:CWRT_SANITY_IDX % 9) * 15

    IF CWRT_SANITY_MINUTE < CWRT_SANITY_START_MINUTE
        CWRT_NPC_LOCATION:CWRT_SANITY_IDX = CWRT_NPC_HOME:CWRT_SANITY_IDX
        CWRT_HOME_COUNT += 1
    ELSEIF CWRT_SANITY_MINUTE < CWRT_SANITY_START_MINUTE + 60
        CWRT_NPC_LOCATION:CWRT_SANITY_IDX = 1000 + (CWRT_SANITY_IDX % 16)
        CWRT_TRANSIT_COUNT += 1
    ELSEIF CWRT_SANITY_MINUTE < CWRT_SANITY_END_MINUTE
        CWRT_NPC_LOCATION:CWRT_SANITY_IDX = CWRT_NPC_WORK:CWRT_SANITY_IDX
        CWRT_WORK_COUNT += 1
    ELSEIF CWRT_SANITY_MINUTE < CWRT_SANITY_END_MINUTE + 120
        IF CWRT_SANITY_IDX % 2 == 0
            CWRT_NPC_LOCATION:CWRT_SANITY_IDX = 2000 + (CWRT_SANITY_IDX % 32)
            CWRT_SHOP_COUNT += 1
        ELSE
            CWRT_NPC_LOCATION:CWRT_SANITY_IDX = 3000 + (CWRT_SANITY_IDX % 32)
            CWRT_PARK_COUNT += 1
        ENDIF
    ELSE
        CWRT_NPC_LOCATION:CWRT_SANITY_IDX = CWRT_NPC_HOME:CWRT_SANITY_IDX
        CWRT_HOME_COUNT += 1
    ENDIF
NEXT

CWRT_TOTAL_COUNT = CWRT_HOME_COUNT + CWRT_TRANSIT_COUNT + CWRT_WORK_COUNT + CWRT_SHOP_COUNT + CWRT_PARK_COUNT + CWRT_OTHER_COUNT

PRINTFORML NPC total : {CWRT_SANITY_NPC_COUNT}
PRINTFORML Home      : {CWRT_HOME_COUNT}
PRINTFORML Transit   : {CWRT_TRANSIT_COUNT}
PRINTFORML Work      : {CWRT_WORK_COUNT}
PRINTFORML Shopping  : {CWRT_SHOP_COUNT}
PRINTFORML Park      : {CWRT_PARK_COUNT}
PRINTFORML Other     : {CWRT_OTHER_COUNT}
PRINTFORML Sum       : {CWRT_TOTAL_COUNT}

IF CWRT_TOTAL_COUNT == CWRT_SANITY_NPC_COUNT
    SETCOLORBYNAME lime
    PRINTL [PASS] 모든 NPC가 정확히 하나의 위치 상태로 분류됐다.
    RESETCOLOR
ELSE
    SETCOLORBYNAME red
    PRINTL [FAIL] 위치 분류 합계가 NPC 수와 다르다.
    RESETCOLOR
ENDIF

PRINTL 아무 키/클릭으로 메뉴로 돌아간다.
WAIT
RETURN


@CWRT_VARSET_TEST
#DIM CWRT_RESET_START_MS
#DIM CWRT_RESET_END_MS
#DIM CWRT_RESET_MEMORY_BEFORE
#DIM CWRT_RESET_MEMORY_AFTER

DRAWLINE
SETCOLORBYNAME yellow
PRINTL [VARSET ARRAY RESET TEST]
RESETCOLOR
PRINTL 10,000요소 배열 5개를 전체 0으로 초기화한다.
PRINTL 시작하려면 아무 키/클릭.
WAIT

CWRT_RESET_MEMORY_BEFORE = GETMEMORYUSAGE()
CWRT_RESET_START_MS = GETMILLISECOND()

VARSET CWRT_NPC_HOME,0
VARSET CWRT_NPC_WORK,0
VARSET CWRT_NPC_SEED,0
VARSET CWRT_NPC_LOCATION,0
VARSET CWRT_NPC_ACTIVITY,0

CWRT_RESET_END_MS = GETMILLISECOND()
CWRT_RESET_MEMORY_AFTER = GETMEMORYUSAGE()

SETCOLORBYNAME lime
PRINTL [RESULT]
RESETCOLOR
PRINTFORML 50,000 integer cells reset : {CWRT_RESET_END_MS-CWRT_RESET_START_MS} ms
PRINTFORML Memory before              : {CWRT_RESET_MEMORY_BEFORE/1024/1024} MB
PRINTFORML Memory after               : {CWRT_RESET_MEMORY_AFTER/1024/1024} MB

CWRT_LAST_NPC_COUNT = 0

PRINTL 아무 키/클릭으로 메뉴로 돌아간다.
WAIT
RETURN
