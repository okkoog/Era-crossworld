; ERA CrossWorld DEV BASE 0.3 - entry point and game input routing

@SYSTEM_TITLE
CALL CW_RUN_TITLE
CALL CW_INITIALIZE_GAME
GOTO CW_GAME_LOOP


$CW_GAME_LOOP
CALL CW_RENDER_CURRENT_LOCATION
ONEINPUT
CALL CW_HANDLE_INPUT
GOTO CW_GAME_LOOP


@CW_HANDLE_INPUT
IF CW_LOCATION == CW_LOCATION_HOME
    CALL CW_HANDLE_HOME_INPUT
ELSEIF CW_LOCATION == CW_LOCATION_PLAZA
    CALL CW_HANDLE_PLAZA_INPUT
ELSE
    CALL CW_HANDLE_CITY_BRANCH_INPUT
ENDIF
RETURN


@CW_HANDLE_HOME_INPUT
SELECTCASE RESULT
CASE 1
    CALL CW_SLEEP
CASE 2
    CW_MOVE_TARGET = CW_LOCATION_PLAZA
    CALL CW_TRY_MOVE
CASEELSE
    CALL CW_SET_MOVE_INPUT_NOTICE
ENDSELECT
RETURN


@CW_HANDLE_PLAZA_INPUT
SELECTCASE RESULT
CASE 0
    CW_MOVE_TARGET = CW_LOCATION_HOME
    CALL CW_TRY_MOVE
CASE 2
    CW_MOVE_TARGET = CW_LOCATION_SHOP
    CALL CW_TRY_MOVE
CASE 3
    CW_MOVE_TARGET = CW_LOCATION_STATION
    CALL CW_TRY_MOVE
CASE 4
    CW_MOVE_TARGET = CW_LOCATION_PARK
    CALL CW_TRY_MOVE
CASEELSE
    CALL CW_SET_MOVE_INPUT_NOTICE
ENDSELECT
RETURN


@CW_HANDLE_CITY_BRANCH_INPUT
SELECTCASE RESULT
CASE 1
    CW_MOVE_TARGET = CW_LOCATION_PLAZA
    CALL CW_TRY_MOVE
CASEELSE
    CALL CW_SET_MOVE_INPUT_NOTICE
ENDSELECT
RETURN
