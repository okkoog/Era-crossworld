; ERA CrossWorld DEV BASE 0.1 - entry point and input routing

@SYSTEM_TITLE
CALL CW_INITIALIZE_GAME
GOTO CW_HOME_LOOP


$CW_HOME_LOOP
CALL CW_RENDER_HOME
ONEINPUT

SELECTCASE RESULT
CASE 1
    CALL CW_SLEEP
    GOTO CW_HOME_LOOP
CASE 2
    CALL CW_LEAVE_HOME
    GOTO CW_OUTSIDE_LOOP
CASEELSE
    CALL CW_SET_INVALID_INPUT_NOTICE
    GOTO CW_HOME_LOOP
ENDSELECT


$CW_OUTSIDE_LOOP
CALL CW_RENDER_OUTSIDE
ONEINPUT

SELECTCASE RESULT
CASE 0
    CALL CW_RETURN_HOME
    GOTO CW_HOME_LOOP
CASEELSE
    CALL CW_SET_INVALID_INPUT_NOTICE
    GOTO CW_OUTSIDE_LOOP
ENDSELECT
