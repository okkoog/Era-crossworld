; ERA CrossWorld DEV BASE 0.3 REV4 - verified formatted-string renderer

@CW_PLAY_OPENING
#DIM CW_OPENING_FRAME

CW_OPENING_SKIP = 0
CALL CW_VERIFY_STRING_OUTPUT
CALL CW_VERIFY_COORDINATE_FRAME
CALL CW_SETUP_OPENING_STARS

FOR CW_OPENING_FRAME,0,32
    CALL CW_RENDER_STAR_FRAME,CW_OPENING_FRAME
    IF CW_OPENING_SKIP
        RETURN
    ENDIF
NEXT

CALL CW_RENDER_CONVERGENCE_CORE
IF CW_OPENING_SKIP
    RETURN
ENDIF
CALL CW_RENDER_CONVERGENCE_BURST
IF CW_OPENING_SKIP
    RETURN
ENDIF
CALL CW_RENDER_WORLD_REVEAL
IF CW_OPENING_SKIP
    RETURN
ENDIF
CALL CW_RENDER_TITLE_REVEAL
RETURN


@CW_CLEAR_SCREEN
IF LINECOUNT > 0
    CLEARLINE LINECOUNT
ENDIF
RETURN


@CW_VERIFY_STRING_OUTPUT
#DIMS CW_TEST_CHAR
CALL CW_CLEAR_SCREEN
PRINTL                         STRING OUTPUT CHECK
PRINTL
CW_TEST_CHAR = "*"
PRINTFORM %CW_TEST_CHAR%
CW_TEST_CHAR = "+"
PRINTFORM %CW_TEST_CHAR%
CW_TEST_CHAR = "."
PRINTFORM %CW_TEST_CHAR%
CW_TEST_CHAR = "o"
PRINTFORM %CW_TEST_CHAR%
CW_TEST_CHAR = "O"
PRINTFORML %CW_TEST_CHAR%
PRINTL
PRINTL                         Expected: *+.oO
PRINTL                         Press any key to continue.
WAIT
RETURN


@CW_VERIFY_COORDINATE_FRAME
#DIM CW_TEST_ROW
#DIM CW_TEST_COLUMN
#DIMS CW_TEST_CHAR
CALL CW_CLEAR_SCREEN
PRINTL                    COORDINATE FRAME CHECK
PRINTL
FOR CW_TEST_ROW,0,9
    FOR CW_TEST_COLUMN,0,40
        CW_TEST_CHAR = " "
        IF CW_TEST_COLUMN == 10 && CW_TEST_ROW == 1
            CW_TEST_CHAR = "*"
        ELSEIF CW_TEST_COLUMN == 30 && CW_TEST_ROW == 3
            CW_TEST_CHAR = "O"
        ELSEIF CW_TEST_COLUMN == 5 && CW_TEST_ROW == 6
            CW_TEST_CHAR = "+"
        ELSEIF CW_TEST_COLUMN == 36 && CW_TEST_ROW == 6
            CW_TEST_CHAR = "."
        ELSEIF CW_TEST_COLUMN == 24 && CW_TEST_ROW == 8
            CW_TEST_CHAR = "o"
        ENDIF
        PRINTFORM %CW_TEST_CHAR%
    NEXT
    PRINTL
NEXT
PRINTL                    Press any key to start the opening.
WAIT
RETURN


@CW_SETUP_OPENING_STARS
CW_OPENING_STAR_START_X:0 = 2
CW_OPENING_STAR_START_Y:0 = 1
CW_OPENING_STAR_START_X:1 = 19
CW_OPENING_STAR_START_Y:1 = 21
CW_OPENING_STAR_START_X:2 = 37
CW_OPENING_STAR_START_Y:2 = 3
CW_OPENING_STAR_START_X:3 = 124
CW_OPENING_STAR_START_Y:3 = 2
CW_OPENING_STAR_START_X:4 = 141
CW_OPENING_STAR_START_Y:4 = 22
CW_OPENING_STAR_START_X:5 = 103
CW_OPENING_STAR_START_Y:5 = 19
CW_OPENING_STAR_START_X:6 = 9
CW_OPENING_STAR_START_Y:6 = 12
CW_OPENING_STAR_START_X:7 = 136
CW_OPENING_STAR_START_Y:7 = 11
CW_OPENING_STAR_START_X:8 = 51
CW_OPENING_STAR_START_Y:8 = 23
CW_OPENING_STAR_START_X:9 = 92
CW_OPENING_STAR_START_Y:9 = 1
CW_OPENING_STAR_START_X:10 = 30
CW_OPENING_STAR_START_Y:10 = 11
CW_OPENING_STAR_START_X:11 = 115
CW_OPENING_STAR_START_Y:11 = 7
CW_OPENING_STAR_START_X:12 = 69
CW_OPENING_STAR_START_Y:12 = 0
CW_OPENING_STAR_START_X:13 = 76
CW_OPENING_STAR_START_Y:13 = 23
RETURN


@CW_RENDER_STAR_FRAME,ARG:0
#DIM CW_OPENING_ROW
#DIM CW_OPENING_COLUMN
#DIM CW_OPENING_STAR
#DIMS CW_OPENING_PIXEL

FOR CW_OPENING_STAR,0,14
    CW_OPENING_STAR_X:CW_OPENING_STAR = CW_OPENING_STAR_START_X:CW_OPENING_STAR + ((72 - CW_OPENING_STAR_START_X:CW_OPENING_STAR) * ARG:0 / 31)
    CW_OPENING_STAR_Y:CW_OPENING_STAR = CW_OPENING_STAR_START_Y:CW_OPENING_STAR + ((11 - CW_OPENING_STAR_START_Y:CW_OPENING_STAR) * ARG:0 / 31)
NEXT

CALL CW_CLEAR_SCREEN
PRINTL

FOR CW_OPENING_ROW,0,24
    FOR CW_OPENING_COLUMN,0,144
        CW_OPENING_PIXEL = " "
        FOR CW_OPENING_STAR,0,14
            IF CW_OPENING_STAR_X:CW_OPENING_STAR == CW_OPENING_COLUMN && CW_OPENING_STAR_Y:CW_OPENING_STAR == CW_OPENING_ROW
                IF ARG:0 >= 27
                    CW_OPENING_PIXEL = "O"
                ELSEIF CW_OPENING_STAR % 4 == 0
                    CW_OPENING_PIXEL = "*"
                ELSEIF CW_OPENING_STAR % 4 == 1
                    CW_OPENING_PIXEL = "+"
                ELSEIF CW_OPENING_STAR % 4 == 2
                    CW_OPENING_PIXEL = "."
                ELSE
                    CW_OPENING_PIXEL = "o"
                ENDIF
            ENDIF
        NEXT
        PRINTFORM %CW_OPENING_PIXEL%
    NEXT
    PRINTL
NEXT

PRINTL                                                                    [0] SKIP
TONEINPUT 60,9,0,""
IF RESULT == 0
    CW_OPENING_SKIP = 1
ENDIF
RETURN


@CW_OPENING_PHASE_WAIT,ARG:0
PRINTL
PRINTL                                                                    [0] SKIP
TONEINPUT ARG:0,9,0,""
IF RESULT == 0
    CW_OPENING_SKIP = 1
ENDIF
RETURN


