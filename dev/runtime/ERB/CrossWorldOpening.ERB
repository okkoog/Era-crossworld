; ERA CrossWorld DEV BASE 0.3 - smooth opening sequence

@CW_PLAY_OPENING
#DIM CW_OPENING_FRAME

CW_OPENING_SKIP = 0
CALL CW_SETUP_OPENING_STARS

FOR CW_OPENING_FRAME,0,32
    CALL CW_RENDER_STAR_FRAME,CW_OPENING_FRAME
    IF CW_OPENING_SKIP
        RETURN
    ENDIF
NEXT

CALL CW_RENDER_CONVERGENCE_CORE
IF CW_OPENING_SKIP
    RETURN
ENDIF
CALL CW_RENDER_CONVERGENCE_BURST
IF CW_OPENING_SKIP
    RETURN
ENDIF
CALL CW_RENDER_WORLD_REVEAL
IF CW_OPENING_SKIP
    RETURN
ENDIF
CALL CW_RENDER_TITLE_REVEAL
RETURN


@CW_CLEAR_SCREEN
IF LINECOUNT > 0
    CLEARLINE LINECOUNT
ENDIF
RETURN


@CW_SETUP_OPENING_STARS
CW_OPENING_STAR_START_X:0 = 2
CW_OPENING_STAR_START_Y:0 = 1
CW_OPENING_STAR_START_X:1 = 15
CW_OPENING_STAR_START_Y:1 = 17
CW_OPENING_STAR_START_X:2 = 28
CW_OPENING_STAR_START_Y:2 = 3
CW_OPENING_STAR_START_X:3 = 94
CW_OPENING_STAR_START_Y:3 = 2
CW_OPENING_STAR_START_X:4 = 106
CW_OPENING_STAR_START_Y:4 = 18
CW_OPENING_STAR_START_X:5 = 78
CW_OPENING_STAR_START_Y:5 = 15
CW_OPENING_STAR_START_X:6 = 8
CW_OPENING_STAR_START_Y:6 = 10
CW_OPENING_STAR_START_X:7 = 100
CW_OPENING_STAR_START_Y:7 = 9
CW_OPENING_STAR_START_X:8 = 39
CW_OPENING_STAR_START_Y:8 = 18
CW_OPENING_STAR_START_X:9 = 70
CW_OPENING_STAR_START_Y:9 = 1
CW_OPENING_STAR_START_X:10 = 23
CW_OPENING_STAR_START_Y:10 = 9
CW_OPENING_STAR_START_X:11 = 87
CW_OPENING_STAR_START_Y:11 = 6
CW_OPENING_STAR_START_X:12 = 52
CW_OPENING_STAR_START_Y:12 = 0
CW_OPENING_STAR_START_X:13 = 58
CW_OPENING_STAR_START_Y:13 = 19
RETURN


@CW_RENDER_STAR_FRAME,ARG:0
#DIM CW_OPENING_ROW
#DIM CW_OPENING_COLUMN
#DIM CW_OPENING_STAR
#DIMS CW_OPENING_PIXEL

FOR CW_OPENING_STAR,0,14
    CW_OPENING_STAR_X:CW_OPENING_STAR = CW_OPENING_STAR_START_X:CW_OPENING_STAR + ((54 - CW_OPENING_STAR_START_X:CW_OPENING_STAR) * ARG:0 / 31)
    CW_OPENING_STAR_Y:CW_OPENING_STAR = CW_OPENING_STAR_START_Y:CW_OPENING_STAR + ((9 - CW_OPENING_STAR_START_Y:CW_OPENING_STAR) * ARG:0 / 31)
NEXT

CALL CW_CLEAR_SCREEN
PRINTL

FOR CW_OPENING_ROW,0,20
    FOR CW_OPENING_COLUMN,0,109
        CW_OPENING_PIXEL = " "
        FOR CW_OPENING_STAR,0,14
            IF CW_OPENING_STAR_X:CW_OPENING_STAR == CW_OPENING_COLUMN && CW_OPENING_STAR_Y:CW_OPENING_STAR == CW_OPENING_ROW
                IF ARG:0 >= 27
                    CW_OPENING_PIXEL = "O"
                ELSEIF CW_OPENING_STAR % 4 == 0
                    CW_OPENING_PIXEL = "*"
                ELSEIF CW_OPENING_STAR % 4 == 1
                    CW_OPENING_PIXEL = "+"
                ELSEIF CW_OPENING_STAR % 4 == 2
                    CW_OPENING_PIXEL = "."
                ELSE
                    CW_OPENING_PIXEL = "o"
                ENDIF
            ENDIF
        NEXT
        PRINTS CW_OPENING_PIXEL
    NEXT
    PRINTL
NEXT

PRINTL                                                [0] SKIP
TONEINPUT 60,9,0,""
IF RESULT == 0
    CW_OPENING_SKIP = 1
ENDIF
RETURN


@CW_OPENING_PHASE_WAIT,ARG:0
PRINTL
PRINTL                                                [0] SKIP
TONEINPUT ARG:0,9,0,""
IF RESULT == 0
    CW_OPENING_SKIP = 1
ENDIF
RETURN


