; ERA CrossWorld DEV BASE 0.2 - locations, connections, and city map

@CW_CHECK_CONNECTION
CW_MOVE_ALLOWED = 0

IF CW_LOCATION == CW_LOCATION_HOME && CW_MOVE_TARGET == CW_LOCATION_PLAZA
    CW_MOVE_ALLOWED = 1
ELSEIF CW_LOCATION == CW_LOCATION_PLAZA && CW_MOVE_TARGET == CW_LOCATION_HOME
    CW_MOVE_ALLOWED = 1
ELSEIF CW_LOCATION == CW_LOCATION_PLAZA && CW_MOVE_TARGET == CW_LOCATION_SHOP
    CW_MOVE_ALLOWED = 1
ELSEIF CW_LOCATION == CW_LOCATION_SHOP && CW_MOVE_TARGET == CW_LOCATION_PLAZA
    CW_MOVE_ALLOWED = 1
ELSEIF CW_LOCATION == CW_LOCATION_PLAZA && CW_MOVE_TARGET == CW_LOCATION_PARK
    CW_MOVE_ALLOWED = 1
ELSEIF CW_LOCATION == CW_LOCATION_PARK && CW_MOVE_TARGET == CW_LOCATION_PLAZA
    CW_MOVE_ALLOWED = 1
ELSEIF CW_LOCATION == CW_LOCATION_PLAZA && CW_MOVE_TARGET == CW_LOCATION_STATION
    CW_MOVE_ALLOWED = 1
ELSEIF CW_LOCATION == CW_LOCATION_STATION && CW_MOVE_TARGET == CW_LOCATION_PLAZA
    CW_MOVE_ALLOWED = 1
ENDIF
RETURN


@CW_SET_LOCATION_NAME
IF CW_LOCATION == CW_LOCATION_HOME
    CW_LOCATION_NAME = "자택"
ELSEIF CW_LOCATION == CW_LOCATION_PLAZA
    CW_LOCATION_NAME = "광장"
ELSEIF CW_LOCATION == CW_LOCATION_SHOP
    CW_LOCATION_NAME = "상점"
ELSEIF CW_LOCATION == CW_LOCATION_STATION
    CW_LOCATION_NAME = "역"
ELSEIF CW_LOCATION == CW_LOCATION_PARK
    CW_LOCATION_NAME = "공원"
ELSE
    CW_LOCATION_NAME = "알 수 없는 장소"
ENDIF
RETURN


@CW_RENDER_CITY_MAP
SETCOLORBYNAME yellow
PRINTL 【MAP】 크로스월드 시티
RESETCOLOR
PRINTL
PRINTL                         [02] SHOP / 상점
PRINTL                               |
PRINTL                               |
PRINTL [00] HOME / 자택 ---- [01] PLAZA / 광장 ---- [04] PARK / 공원
PRINTL                               |
PRINTL                               |
PRINTL                         [03] STATION / 역
PRINTL
CALL CW_SET_LOCATION_NAME
PRINTFORML 현재 위치 : %CW_LOCATION_NAME%
RETURN
