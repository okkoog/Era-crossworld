; ERA CrossWorld DEV BASE 0.3 - final title and menu

@CW_RUN_TITLE
CW_TITLE_NOTICE = ""
CALL CW_PLAY_OPENING

$CW_TITLE_MENU
CALL CW_RENDER_TITLE_MENU
ONEINPUT

SELECTCASE RESULT
CASE 1
    RETURN
CASE 2
    CW_TITLE_NOTICE = "로드 기능은 아직 사용할 수 없습니다."
    GOTO CW_TITLE_MENU
CASE 3
    QUIT
CASEELSE
    CW_TITLE_NOTICE = "선택할 수 없는 입력입니다."
    GOTO CW_TITLE_MENU
ENDSELECT


@CW_RENDER_TITLE_MENU
CALL CW_CLEAR_SCREEN
CALL CW_RENDER_WORLD_LANDSCAPE
PRINTL
CALL CW_RENDER_CROSSWORLD_LOGO
PRINTL
PRINTL                    - ERA CrossWorld DEV BASE 0.3 -
PRINTL
PRINTL                          [1] 게임 시작
PRINTL                          [2] 로드
PRINTL                          [3] 종료

IF CW_TITLE_NOTICE != ""
    PRINTL
    PRINTFORML                    %CW_TITLE_NOTICE%
    CW_TITLE_NOTICE = ""
ENDIF
RETURN
