; ERA CrossWorld DEV BASE 0.1 - state transitions

@CW_INITIALIZE_GAME
CW_DAY = 1
CW_TIME_MINUTES = 480
CW_LOCATION = 0
CW_NOTICE = ""
RETURN


@CW_SLEEP
CW_DAY += 1
CW_TIME_MINUTES = 480
CW_LOCATION = 0
CW_NOTICE = "푹 잤다. 새로운 아침이 밝았다."
RETURN


@CW_LEAVE_HOME
CW_LOCATION = 1
CW_NOTICE = "현관을 나섰다."
RETURN


@CW_RETURN_HOME
CW_LOCATION = 0
CW_NOTICE = "집으로 돌아왔다."
RETURN


@CW_SET_INVALID_INPUT_NOTICE
CW_NOTICE = "선택할 수 없는 입력입니다."
RETURN
