; ERA CrossWorld DEV BASE 0.2 - location views

@CW_RENDER_CURRENT_LOCATION
IF CW_LOCATION == CW_LOCATION_HOME
    CALL CW_RENDER_HOME
ELSE
    CALL CW_RENDER_CITY_LOCATION
ENDIF
RETURN


@CW_RENDER_DATE_TIME
#DIM CW_HOUR
#DIM CW_MINUTE

CW_HOUR = CW_TIME_MINUTES / 60
CW_MINUTE = CW_TIME_MINUTES % 60

PRINTFORML 날짜 : {CW_DAY}일
PRINTFORM 시각 : {CW_HOUR}:
IF CW_MINUTE < 10
    PRINTFORM 0
ENDIF
PRINTFORML {CW_MINUTE}
RETURN


@CW_RENDER_NOTICE
IF CW_NOTICE != ""
    PRINTL
    PRINTFORML %CW_NOTICE%
    CW_NOTICE = ""
ENDIF
RETURN


@CW_RENDER_HOME
DRAWLINE
SETCOLORBYNAME yellow
PRINTL 【HOME】 자택
RESETCOLOR
PRINTL
PRINTL +--------------------------------------------------+
PRINTL |                                                  |
PRINTL |       +------------+          +----------+       |
PRINTL |       |    침대    |          |   책상   |       |
PRINTL |       +------------+          +----------+       |
PRINTL |                                                  |
PRINTL |                                 +----------+     |
PRINTL |                                 |   현관   |     |
PRINTL |                                 +----------+     |
PRINTL |                                                  |
PRINTL +--------------------------------------------------+
PRINTL
CALL CW_RENDER_DATE_TIME
CALL CW_RENDER_NOTICE
PRINTL
PRINTL 【행동】
PRINTL
PRINTL [1] 잔다
PRINTL [2] 나간다
RETURN


@CW_RENDER_CITY_LOCATION
DRAWLINE
CALL CW_RENDER_CITY_MAP
PRINTL

IF CW_LOCATION == CW_LOCATION_PLAZA
    PRINTL 【PLAZA】 광장
    PRINTL 크로스월드 시티의 중앙 광장이다.
ELSEIF CW_LOCATION == CW_LOCATION_SHOP
    PRINTL 【SHOP】 상점
    PRINTL 상점에 도착했다.
    PRINTL 현재 특별한 기능은 구현되어 있지 않습니다.
ELSEIF CW_LOCATION == CW_LOCATION_PARK
    PRINTL 【PARK】 공원
    PRINTL 공원에 도착했다.
    PRINTL 현재 특별한 기능은 구현되어 있지 않습니다.
ELSEIF CW_LOCATION == CW_LOCATION_STATION
    PRINTL 【STATION】 역
    PRINTL 역에 도착했다.
    PRINTL 현재 특별한 기능은 구현되어 있지 않습니다.
ENDIF

PRINTL
CALL CW_RENDER_DATE_TIME
CALL CW_RENDER_NOTICE
PRINTL
PRINTL 【이동처】
PRINTL

IF CW_LOCATION == CW_LOCATION_PLAZA
    PRINTL [0] 자택
    PRINTL [2] 상점
    PRINTL [3] 역
    PRINTL [4] 공원
ELSE
    PRINTL [1] 광장
ENDIF
RETURN
