; ERA CrossWorld DEV BASE 0.2 - state transitions

@CW_INITIALIZE_GAME
CW_LOCATION_HOME = 100
CW_LOCATION_PLAZA = 200
CW_LOCATION_SHOP = 300
CW_LOCATION_STATION = 400
CW_LOCATION_PARK = 500

CW_DAY = 1
CW_TIME_MINUTES = 480
CW_LOCATION = CW_LOCATION_HOME
CW_MOVE_TARGET = CW_LOCATION_HOME
CW_MOVE_ALLOWED = 0
CW_LOCATION_NAME = "자택"
CW_NOTICE = ""
RETURN


@CW_SLEEP
CW_DAY += 1
CW_TIME_MINUTES = 480
CW_LOCATION = CW_LOCATION_HOME
CW_NOTICE = "푹 잤다. 새로운 아침이 밝았다."
RETURN


@CW_TRY_MOVE
CALL CW_CHECK_CONNECTION

IF CW_MOVE_ALLOWED == 0
    CW_NOTICE = "현재 위치에서는 그 장소로 바로 이동할 수 없습니다."
    RETURN
ENDIF

CW_LOCATION = CW_MOVE_TARGET
CALL CW_ADVANCE_TRAVEL_TIME
CW_NOTICE = "목적지에 도착했다."
RETURN


@CW_ADVANCE_TRAVEL_TIME
CW_TIME_MINUTES += 10

IF CW_TIME_MINUTES >= 1440
    CW_DAY += 1
    CW_TIME_MINUTES -= 1440
ENDIF
RETURN


@CW_SET_MOVE_INPUT_NOTICE
IF RESULT >= 0 && RESULT <= 4
    CW_NOTICE = "현재 위치에서는 그 장소로 바로 이동할 수 없습니다."
ELSE
    CW_NOTICE = "선택할 수 없는 입력입니다."
ENDIF
RETURN
