        "lines",
        3
      ],
      "originalHash": "694035a9ceb627fd5d4515a8a4f56489e774fc415b2b9c8204937a1d1a9b83c6",
      "sourceFileHash": "97246eb5922d0acee8272e16315080eccc3294225ffbf9fa240a5aea2813fa80",
      "originalText": "%YOU% は女神の手首を掴み、押し伏せる。",
      "koreanText": ""
    },
    {
      "id": "0874160eb17c2153cf00ac2ffc2d0a31",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/904100-Godolphin-Barb/love-341.kojo",
      "key": "50",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "50",
        "lines",
        6,
        "lines",
        1,
        "lines",
        4
      ],
      "originalHash": "5b7040a5bf377ccdad04a7eb4096375f59fe976eeb818a572ee325fd3adbadd9",
      "sourceFileHash": "97246eb5922d0acee8272e16315080eccc3294225ffbf9fa240a5aea2813fa80",
      "originalText": "抗いもなく、拒みもなく。ただ %YOU% の動きに従い、慣れぬ男根の使い方まで、導いてくる……",
      "koreanText": ""
    },
    {
      "id": "b3f831d8fa212a8d0e03771a8795b1cb",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/904100-Godolphin-Barb/love-341.kojo",
      "key": "50",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "50",
        "lines",
        7,
        "content"
      ],
      "originalHash": "0d66e6469db6fed7c6e8b9c1a5ef74aabbb0cba0946bc95e84b3f6ba4e51f6c8",
      "sourceFileHash": "97246eb5922d0acee8272e16315080eccc3294225ffbf9fa240a5aea2813fa80",
      "originalText": "神意に従う（%FUCKMEBUTTON%）",
      "koreanText": ""
    },
    {
      "id": "90502b79c011dc324d71bd07ff41ee0f",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/904100-Godolphin-Barb/love-341.kojo",
      "key": "50",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "50",
        "lines",
        7,
        "lines",
        0
      ],
      "originalHash": "4c2fb9e42f73fb09dee40c68b808bd84e05931e2d72cb3acd12b16cf48629075",
      "sourceFileHash": "97246eb5922d0acee8272e16315080eccc3294225ffbf9fa240a5aea2813fa80",
      "originalText": "惑いの気配のなか、高まる愛欲のなか。%YOU% は徐々に、己を見失っていく。",
      "koreanText": ""
    },
    {
      "id": "61597bebd44dde4047cf112189891b7e",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/904100-Godolphin-Barb/love-341.kojo",
      "key": "50",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "50",
        "lines",
        7,
        "lines",
        1
      ],
      "originalHash": "0ff5f62508a27a53295e06019c6879a0b2a66d978fdde22f19ea8340c10090e0",
      "sourceFileHash": "97246eb5922d0acee8272e16315080eccc3294225ffbf9fa240a5aea2813fa80",
      "originalText": "頭を空にして、四肢を弛めて。それでよい。",
      "koreanText": ""
    },
    {
      "id": "c416cc07de5b12be3d84fea3268d2b09",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/904100-Godolphin-Barb/love-341.kojo",
      "key": "50",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "50",
        "lines",
        7,
        "lines",
        2
      ],
      "originalHash": "e79c78e1d67c65374ba3b8c53191dfba6b1210f2928606ebd5971349e9157fed",
      "sourceFileHash": "97246eb5922d0acee8272e16315080eccc3294225ffbf9fa240a5aea2813fa80",
      "originalText": "身も心も魂も、女神さまへ捧げよう。",
      "koreanText": ""
    },
    {
      "id": "d599ad85acb55dc34e633382128eb1d7",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/904100-Godolphin-Barb/love-341.kojo",
      "key": "50",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "50",
        "lines",
        7,
        "lines",
        3
      ],
      "originalHash": "4ae2276571fb8104ee588a861f2e8bdeff0c31478ec154577fefbc60b57f17b1",
      "sourceFileHash": "97246eb5922d0acee8272e16315080eccc3294225ffbf9fa240a5aea2813fa80",
      "originalText": "女神の衣が滑り落ち、肌と擦れて、美しい音を奏でる。",
      "koreanText": ""
    },
    {
      "id": "16407f10bd2d1c630f0acee35be0ae15",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/904100-Godolphin-Barb/love-341.kojo",
      "key": "50",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "50",
        "lines",
        7,
        "lines",
        4
      ],
      "originalHash": "83b3ddbec49c102260935221fc229dfb3df680d408335edbb6a39b87dbc221e4",
      "sourceFileHash": "97246eb5922d0acee8272e16315080eccc3294225ffbf9fa240a5aea2813fa80",
      "originalText": "%YOU% は目を閉じ、すべてを女神へ献ずる準備をした。",
      "koreanText": ""
    },
    {
      "id": "2df3047d1cdc23bad52f04b24520466c",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/904100-Godolphin-Barb/love-341.kojo",
