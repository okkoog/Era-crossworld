      "originalHash": "4e3244b13cab3b033a47888d855b301f4363bd15c698ae70706dda1a0118f0b7",
      "sourceFileHash": "9b7b2f5672dd8eb7651eb16d5d8922f5004513c0dea06627ec5ef7044b2c5851",
      "originalText": "「冷 淡！わたくしに会いに来る暇があるなら、先に自分の仕事をなさい！」",
      "koreanText": ""
    },
    {
      "id": "3d811a120b128e923ece4787c71b3cbf",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900200-Akikawa-Yayoi/daily-302.kojo",
      "key": "npc_talk",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "npc_talk",
        1,
        "content",
        1
      ],
      "originalHash": "bf9028dc8b94fd1898dcdeef00e45e5a76675cfc313d254a4ea608469581fd2f",
      "sourceFileHash": "9b7b2f5672dd8eb7651eb16d5d8922f5004513c0dea06627ec5ef7044b2c5851",
      "originalText": "「不 快！あまりお会いしたくありませんわ！」",
      "koreanText": ""
    },
    {
      "id": "f9630c5b5b2ad1b9d8940476a4d44252",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900200-Akikawa-Yayoi/daily-302.kojo",
      "key": "npc_talk",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "npc_talk",
        2,
        "content",
        1
      ],
      "originalHash": "c45275cdef1908577df2d5451cd89953cd6d19b6646444acdc393279cd8a319d",
      "sourceFileHash": "9b7b2f5672dd8eb7651eb16d5d8922f5004513c0dea06627ec5ef7044b2c5851",
      "originalText": "「奇 怪！トレーナー、わたくしに何かご用ですの？」",
      "koreanText": ""
    },
    {
      "id": "a952196db6a67a3fd454d6b1cfd1c5cd",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900200-Akikawa-Yayoi/daily-302.kojo",
      "key": "npc_talk",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "npc_talk",
        3,
        "content",
        1
      ],
      "originalHash": "767a5150df046704325201fcb86360b0d250c8adf5fa037b64ddf82128bfd7a4",
      "sourceFileHash": "9b7b2f5672dd8eb7651eb16d5d8922f5004513c0dea06627ec5ef7044b2c5851",
      "originalText": "「挨 拶！今日は順調ですの？」",
      "koreanText": ""
    },
    {
      "id": "67bfb0fe02da2a9409a77e335c199b8b",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900200-Akikawa-Yayoi/daily-302.kojo",
      "key": "npc_talk",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "npc_talk",
        4,
        "content",
        1
      ],
      "originalHash": "28e655985da40c074a38ddeed91094a6325ff68fa0de91af7dad0aa360e5a1c0",
      "sourceFileHash": "9b7b2f5672dd8eb7651eb16d5d8922f5004513c0dea06627ec5ef7044b2c5851",
      "originalText": "「賞 賛！あなたも伝説の仲間入りですわ！」",
      "koreanText": ""
    },
    {
      "id": "45841dae16fb21c0992399bed79df416",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900200-Akikawa-Yayoi/daily-302.kojo",
      "key": "npc_talk",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "npc_talk",
        5,
        "content",
        1
      ],
      "originalHash": "0f812dcb591ca6b90b03bbe95283bff30912bc19d443a2756f0f17745b15d460",
      "sourceFileHash": "9b7b2f5672dd8eb7651eb16d5d8922f5004513c0dea06627ec5ef7044b2c5851",
      "originalText": "「歓 迎！困ったことがあれば、わたくしを頼りなさい！」",
      "koreanText": ""
    },
    {
      "id": "b38c35bd31d8f2013e5ca684b72ad6e9",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900200-Akikawa-Yayoi/daily-302.kojo",
      "key": "npc_talk",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "npc_talk",
        6,
        "content",
        1
      ],
      "originalHash": "dc53d91936485712cb676133d3814c825c54ab445434d7b0b69f20e2a7d7c4f1",
      "sourceFileHash": "9b7b2f5672dd8eb7651eb16d5d8922f5004513c0dea06627ec5ef7044b2c5851",
      "originalText": "「喜 悦！暇なら話しにいらっしゃい！」",
      "koreanText": ""
    },
    {
      "id": "c2ebd6e2177b6f42435cb8f508a856eb",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900200-Akikawa-Yayoi/daily-302.kojo",
      "key": "npc_talk",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "npc_talk",
        7,
        "content",
        1
      ],
      "originalHash": "457166ba934e5111e9ed3ea308a56e6f27ccd9603af0e44eceb26ce795e5419c",
      "sourceFileHash": "9b7b2f5672dd8eb7651eb16d5d8922f5004513c0dea06627ec5ef7044b2c5851",
      "originalText": "「あなたなら……幻 聴！何も聞いていませんわよ！」",
      "koreanText": ""
    },
    {
      "id": "2bba7d0b142c0fcf4408bc4cf3ac059a",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900200-Akikawa-Yayoi/daily-302.kojo",
      "key": "npc_sex",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "npc_sex",
        0,
        "content",
        1
      ],
      "originalHash": "9bd92c16d57b2a60a14b71c8258ecfda3044362a8a4d55c627da3db56dacc9ff",
      "sourceFileHash": "9b7b2f5672dd8eb7651eb16d5d8922f5004513c0dea06627ec5ef7044b2c5851",
      "originalText": "「照 れ！では今夜、あなたの家で会いましょう！」",
      "koreanText": ""
    },
    {
      "id": "ebfa36327c37f58dfb9fb03df3659a66",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900200-Akikawa-Yayoi/daily-302.kojo",
      "key": "npc_bye",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "npc_bye",
        0,
        "content",
        1
      ],
      "originalHash": "8c8272200a3bbb2303f8285dfbe6e2ba6efb31d3e423abdfcdbdb761ae4e2b7e",
      "sourceFileHash": "9b7b2f5672dd8eb7651eb16d5d8922f5004513c0dea06627ec5ef7044b2c5851",
      "originalText": "「不 快！わたくしを暇つぶしにしないでください！」",
      "koreanText": ""
    },
    {
      "id": "62024590a4fb2fd1b2dd8c952212794a",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900200-Akikawa-Yayoi/daily-302.kojo",
