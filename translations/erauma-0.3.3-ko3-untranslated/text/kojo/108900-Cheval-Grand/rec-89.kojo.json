      ],
      "originalHash": "6c5e0a49786a8ebe0b4b288b1c96155161d39efe0f73ee2d2bf98a7ffb0577e3",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "……中央に立つ%THEY%と、端に立つ私。",
      "koreanText": ""
    },
    {
      "id": "03f8c6d93634311bf84d3355b5809941",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "rec2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "rec2",
        "lines",
        83,
        "lines",
        48,
        "content",
        1
      ],
      "originalHash": "72a040431bec6a67c69d2e0283c2ce03e605028643816c4df0cde126998e230c",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "（……%CALL_90%%THEY%や、キタサンさん%THEY%なら、すぐ馴染んで、うまくやるんだろうな。）",
      "koreanText": ""
    },
    {
      "id": "48fbdee57c546a9d4830d3b63db13198",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "rec2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "rec2",
        "lines",
        83,
        "lines",
        50,
        "content"
      ],
      "originalHash": "98361ce6723d6c9b87f2c196ae2cb2b6a320802699b21ab1d25d0b4349f72c05",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "%CALL_90%なら……絶対に勝つ。%VIVLOS%なら、自分から動けるはず。",
      "koreanText": ""
    },
    {
      "id": "bb42656654e6b79c74255d8f0740b2be",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "rec2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "rec2",
        "lines",
        83,
        "lines",
        51,
        "content"
      ],
      "originalHash": "fe654eb6dd9a8a8dfc74b30bce825e154c0001059f65aab0cc6b74c17e13434f",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "どうして%THEY%はあんなに強くて、勇敢なのに……私はいつもこんなに臆病なの。不思議で、全然分からない。",
      "koreanText": ""
    },
    {
      "id": "173323174fadfcfd9aed59362f69fdde",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "rec2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "rec2",
        "lines",
        83,
        "lines",
        67,
        "content"
      ],
      "originalHash": "99863dbdf25ed4a388a9fd3cd61c884ace2ebc1da745797be6aba0daeee56c09",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "でも見方を変えれば……あのとき隠さず、知らないふりして胸を%YOURSEX%に見せていたら……契約できてた……？",
      "koreanText": ""
    },
    {
      "id": "7cb0f86f0198b99ed9b5fcabebbffcc8",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "rec2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "rec2",
        "lines",
        83,
        "lines",
        76,
        "content",
        1
      ],
      "originalHash": "0943d580701002badcdbbc958782d2e126c05106ce9279fc6df79da30252ad1a",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "（でも、こんな私にとって……あれが人生で唯一の募集の機会だったのかも……）",
      "koreanText": ""
    },
    {
      "id": "6d606e6096c6781cb1d23c17e41d5c4c",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "rec2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "rec2",
        "lines",
        83,
        "lines",
        169,
        "content"
      ],
      "originalHash": "8b9f160e1a4fc5cb2dfdf1920be771594299c812ae89de30111f173c8ec91949",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "こんなに用意してるなんて……最悪の場合……少なくとも%CALL_90%と%VIVLOS%は守らないと。",
      "koreanText": ""
    },
    {
      "id": "eab6d1a6b58f731101868e3d15312c94",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "rec2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "rec2",
        "lines",
        83,
        "lines",
        225,
        "content",
        1
      ],
      "originalHash": "09f38b180109e63cb13462816577624ebad7a30830bdb5d19150a00bb6255cd2",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "（だめだめ、そんな謙遜、%YOURSEX%の認めを否定してるだけ……）",
      "koreanText": ""
    },
    {
      "id": "45273c73918018b87f7e446bfb514265",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "rec2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "rec2",
        "lines",
        83,
        "lines",
        229,
        "content"
      ],
      "originalHash": "c8120218242c7d1d6e565a1b341c439ec57fe42cdc44a93c046d46797b63d6f3",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "%YOURSEX%の瞳がわずかに見開かれ、口元の笑みが潮のように引く。顔を逸らしたとき、喉が一度動いて、顎を撫でて黙った。",
      "koreanText": ""
    },
    {
      "id": "9760c170aaeed07357f37f829edda23f",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "rec2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "rec2",
        "lines",
        83,
        "lines",
        238,
        "content"
      ],
      "originalHash": "07aab9096ae88c7cada7a16ac1283751052b997bb9968884b891de1af62ce1c6",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "基本の返事すらできない%UMA%なのに……相手は私の気持ちを慮って、すぐには去らず、傷つけない言い方を探している……%YOURSEX%は、本当に優しい人だ。",
      "koreanText": ""
    },
    {
      "id": "67e319d4933bc33db43da7d0885fb498",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "rec2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "rec2",
        "lines",
        83,
        "lines",
        257,
        "content"
      ],
      "originalHash": "7d0f8906dae4c1f07d5a649b2b6d100685d2745e2c63a4281e1cefe422bcddc5",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "%YOURSEX%は、今、何て言った？",
      "koreanText": ""
    },
    {
      "id": "c06275eb9d75d4090bc9b115b91d7502",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "rec2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "rec2",
        "lines",
        83,
        "lines",
        258,
        "content"
      ],
      "originalHash": "d0ccc79bff2b067fa4dd5ab4aafe907d3e572ae3b815f10f894ba463b8722a16",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "%YOURSEX%は……%CHARA%を募集する、って！？",
      "koreanText": ""
    },
    {
      "id": "89929a7dca2d48b8a8846210f037b94d",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "rec2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "rec2",
        "lines",
        83,
        "lines",
        315,
        "content"
      ],
      "originalHash": "c5495812936e35f2a4118d7be8ae87989a39055a5b480b3ce381c00c6802764d",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "あの人がここまで信じてくれるなら、少しでも応えたい……それが本音だ。",
      "koreanText": ""
    },
    {
      "id": "ae358d57357ea877bb2d1c588cbf892c",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "rec2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "rec2",
        "lines",
        83,
        "lines",
        316,
        "content"
      ],
      "originalHash": "42357d47c203a4df175d36140dadc7a825d1a0f17dad07d531dfb268e0d49f83",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "頬の熱が溢れる寸前で、%YOURSEX%の褒めを遮るように、少し焦って誘いへ応えた。",
      "koreanText": ""
    },
    {
      "id": "97d9b7db44364e1da5b77f4028c20b91",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "beginning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "beginning",
        "title"
      ],
      "originalHash": "ceb3ae0ea93e784abb8e8afcd5f02d110d71f119bf0dd863020d7964979f0b70",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "シュヴァルグラン登場！：「……開端」",
      "koreanText": ""
    },
    {
      "id": "8681f7dd17b85c28a172b3819d0b71ba",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "beginning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "beginning",
        "lines",
        12
      ],
      "originalHash": "bdb7dafc18f5b1cc4feea6409419acc6014733597a9dd372f788be1b8725ad4e",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "%YOU%が近づくと、顔は覚えているが名前の出ない後輩が挨拶する。礼を返しつつ、今日の同僚兼ライバルを見る——若い新顔が増え、古い顔は一様に硬い。空気は明るくない。",
      "koreanText": ""
    },
    {
      "id": "030290f1fd8873e81abaeb37d20de7d9",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "beginning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "beginning",
        "lines",
        16
      ],
      "originalHash": "f66cd951c62a056b76186826158ab2f0bb5fa55ad958c511bd034d10ab3ee2fe",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "他のトレーナーが開けた道を最前列まで行き、隣のエリートトレーナーに一言聞こうとしたところで、遠くの笛が間の悪いタイミングで鳴る。皆、揃ってコースを見た。",
      "koreanText": ""
    },
    {
      "id": "a51b94bab4a1e8d3419cd32e045cf21a",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "beginning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "beginning",
        "lines",
        26
      ],
      "originalHash": "f67d94ab5190524c5f2fcd027367e4b163e6dcff481e097b18ffcb1b996cd4ee",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "レースはすぐ最終直線へ。このままなら……勝てる、と%YOU%が判断した、その短い一瞬。期待していた%UMA%が、集団の後方へ落ちた。",
      "koreanText": ""
    },
    {
      "id": "c3b189e4f66968e4fe0c57bbdb7d2bc9",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "beginning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "beginning",
        "lines",
        30
      ],
      "originalHash": "a1d4614a57ea47c05e51d11685c800b0b33ec8fdf477d7af102e7cb0c735fe19",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "%YOU%は惜しみつつ他の出走%UMA%を見渡し、ストップウォッチを押して、%THEY%がゴールするのを見送る。",
      "koreanText": ""
    },
    {
      "id": "dd4f37f6dfed138c453ebbc774051e63",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "beginning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "beginning",
        "lines",
        31
      ],
      "originalHash": "dd2d8ad60f51d78ad4a1adaa044a6c358ace887a904caed8641023c7cf3118c8",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "この組は水準が落ちる。海軍帽の%UMA%だけがいい。だが後ろのトレーナーたちはもう押し寄せ、上位三頭を囲んでいた。",
      "koreanText": ""
    },
    {
      "id": "bdaca0152e8cf8baa66aa684da749eb3",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "beginning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "beginning",
        "lines",
        39
      ],
      "originalHash": "3d656c3afbfeac060de06e12bde203cbe49143efef4273854360507f8e56cf29",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "新人が着順だけで適性を測るのは分かる。驚くのは、古株まで争いに加わっていることだ。上位でも時計は、彼らの線には届いていないはずなのに——",
      "koreanText": ""
    },
    {
      "id": "3ee7fe93f6bcf5a6efc9fd96c7a04ff3",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "beginning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "beginning",
        "lines",
        56
      ],
      "originalHash": "13327cde65da3d593861937e3a8177b2e455662ba1d04f5d0eb87c9aac354b76",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "本題だ。逸れた思考を戻し、選手名簿を出して、あの%UMA%の情報と突き合わせる。",
      "koreanText": ""
    },
    {
      "id": "8de49d547f2c8555308f77077682a675",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "beginning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "beginning",
        "lines",
        60
      ],
      "originalHash": "0d0fa45e8dbc4238ca5a58e8b83d72d90871cccfdb2c6b7d0d4e48ffa3d36e6c",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "俯いたすきに、さっきまでいた%UMA%がいなくなっている。人波を探しても、見つからない。",
      "koreanText": ""
    },
    {
      "id": "8697aa1cc9dcd2ec68d440ed4d031da3",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "beginning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "beginning",
        "lines",
        61
      ],
      "originalHash": "912d3d43191344679ce72b5ffd887589de27d88423e6fbfc074830bb80f006a9",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "もういいか、と思ったところで、またあの目立つ海軍帽のおかげで、訓練場の隅に%SEX%を捉えた。",
      "koreanText": ""
    },
    {
      "id": "5c6def0cac5ec5508a03f4694048d436",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "beginning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "beginning",
        "lines",
        65
      ],
      "originalHash": "f9e3a73198043713a2a95cc522c5df0254bd3329d342c096f063cc2ee004ffb2",
      "sourceFileHash": "cdb5074644d46fa2b81e06ffc42a9d963b75df22b636b6a70f198793653756da",
      "originalText": "%SEX%の様子を見るに、負けたせいで募集の場にも出たくないらしい。",
      "koreanText": ""
    },
    {
      "id": "ca177251184a16d441790b8788eaaf0e",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/108900-Cheval-Grand/rec-89.kojo",
      "key": "beginning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
