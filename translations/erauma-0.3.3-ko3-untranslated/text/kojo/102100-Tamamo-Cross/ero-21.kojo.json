      "originalHash": "461f232dd09a579d061760912a9fa5028b396f97c0ecfdb40e4ff954a08bd284",
      "sourceFileHash": "a810cc84574164277e04fdb6b5404fe3b97a3ac292b6e592c3811e9d8640483c",
      "originalText": "%CHARA% の柔らかい脚が、生き物のように %YOU% の腰に絡みつく。",
      "koreanText": ""
    },
    {
      "id": "4814a9e24e30c7d6297d6e1123b5d740",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/102100-Tamamo-Cross/ero-21.kojo",
      "key": "mark_meek",
      "line": null,
      "kind": "kojo",
