      ],
      "originalHash": "5d0820a75955d24ef70612fc63d49ec6237e9682abf320a4ddfcfc4332534bbf",
      "sourceFileHash": "099f8afbfa75853057b17e9ee5665968313686e97963db85616618c0fb9d922e",
      "originalText": "「もう少しで、%CALLNAME% をまた私たちの愛の巣に連れていくところだった……」",
      "koreanText": ""
    },
    {
      "id": "417b9054f458023d8c41ac7e84a20575",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/103500-Winning-Ticket/daily-35.kojo",
