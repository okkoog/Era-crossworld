        "content",
        1
      ],
      "originalHash": "b25370ae5b16e17ed57bb20c3fc88c1b175be5e9d5409bfe59dd9dd2e3e6e5d3",
      "sourceFileHash": "099f8afbfa75853057b17e9ee5665968313686e97963db85616618c0fb9d922e",
      "originalText": "「うわあああああああ、%CALLNAME% が相手してくれないと、つらいよ……」",
      "koreanText": ""
    },
    {
      "id": "3eabb3709a1f16a94d2ac83fc3ddea66",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/103500-Winning-Ticket/daily-35.kojo",
      "key": "select_after_basement",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
