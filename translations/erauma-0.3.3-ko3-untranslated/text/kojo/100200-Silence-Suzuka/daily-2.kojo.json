        42
      ],
      "originalHash": "4026d38a86be5d8f8b4a9c3aaaadecaa3b11a00f3a8d33efbb30860e55fe111d",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "それから、%SEX%はそっと %YOU% に抱きついた。",
      "koreanText": ""
    },
    {
      "id": "179a389815b3f49833a0513821a28fad",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
      "key": "forbid_running",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "forbid_running",
        "lines",
        43,
