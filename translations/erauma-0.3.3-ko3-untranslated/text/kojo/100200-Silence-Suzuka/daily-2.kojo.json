      "originalHash": "47139a8ca67b24c6d654b94ebf8a31797febe695e9bbd35f551749f0512bff55",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "胸に寄りかかり、少し赤くなって %YOU% を見上げる。",
      "koreanText": ""
    },
    {
      "id": "07495cc595263c38f9eec384caa56a28",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
      "key": "forbid_running",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
