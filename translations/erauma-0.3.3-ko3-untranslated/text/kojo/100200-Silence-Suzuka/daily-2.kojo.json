      ],
      "originalHash": "1183f6da933e7abd6784699add98c5717152323d248d4fd8a5f5164ae0ac5985",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "「はい。……暇だったので、気がついたら、たくさん作ってしまって」",
      "koreanText": ""
    },
    {
      "id": "711c82b7d097ff13e922ed491ffd4c8c",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
