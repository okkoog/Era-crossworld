        1
      ],
      "originalHash": "883c45b2cf3eddba721aa2535cd676ce7a361a1b085b9cc34740f8cfbfa1df14",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "「%CALLNAME%のために、三日も我慢したんです。……ご褒美、いただけませんか」",
      "koreanText": ""
    },
    {
      "id": "3bef9239901a1f33b91587c083d63418",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
      "key": "forbid_running",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
