        35
      ],
      "originalHash": "dd18fb552df4a44a9ef5ac1994aa2c91bfc3b58a7cc83b069c874681be5a2e04",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "三日は、もうすぐ終わる。寝室の戸口から、時計の前に座るスズカを、少し不思議そうに見た。",
      "koreanText": ""
    },
    {
      "id": "af36c298af3548119e403012b440cafd",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
      "key": "forbid_running",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "forbid_running",
        "lines",
