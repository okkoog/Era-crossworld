        "lines",
        28,
        "content"
      ],
      "originalHash": "42b1dedc4306f8602a603f887b861ba077465e82994b8e3c5854b9d6e7e181d4",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "そのまた翌日",
      "koreanText": ""
    },
    {
      "id": "c36768079c2c3710d36cf17b4d5136a5",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
      "key": "forbid_running",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
