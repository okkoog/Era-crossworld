      ],
      "originalHash": "76fb440a9c22d5dc2f5dd5c5c0ced660d8522e4e4c433af6869592d9c564a4dd",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "「おい、スズカ。こんな時間まで、起きているのか」",
      "koreanText": ""
    },
    {
      "id": "c5f934e9c387e5840870865d3b1c6123",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
      "key": "forbid_running",
      "line": null,
