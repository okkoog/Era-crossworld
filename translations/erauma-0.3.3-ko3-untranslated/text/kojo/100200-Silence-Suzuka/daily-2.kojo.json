        "content"
      ],
      "originalHash": "b7992e7cabd418f39a9741daf696b2c20583bfc1e67a53a001b0217e68198225",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "「スズカ、何をしている」",
      "koreanText": ""
    },
    {
      "id": "bc0e089d79c53fe16b4e63b82ad3d64e",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
      "key": "forbid_running",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "forbid_running",
        "lines",
        26,
        "content",
        1
      ],
      "originalHash": "0da0e5030ec1addab563325f3e8aea8d0eb07b5ebcbb8f63d21d08c6b4bfd27c",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "「トレーニング場の写真を見ながら歩いていれば……走っているつもりになれるかと」",
      "koreanText": ""
    },
    {
      "id": "d968ccfca44131910a56268c1772c7c8",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
      "key": "forbid_running",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "forbid_running",
        "lines",
        27
      ],
      "originalHash": "7eddbe4a4895fcf37816583701d6e41903053e34bbd3a3520acff520abbdc970",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "頭を掻く。この想像力を、褒めるべきかどうかはわからなかった。",
      "koreanText": ""
    },
    {
      "id": "d8c89a5e7979de9e87ffec5a72b73d72",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
