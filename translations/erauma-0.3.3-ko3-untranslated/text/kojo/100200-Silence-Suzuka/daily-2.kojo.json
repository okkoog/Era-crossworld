      ],
      "originalHash": "f4526e498a01b1abd6755f7ad9e105673b6604bfe20a53d9fe68376677715da2",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "返す言葉が、見つからなかった。",
      "koreanText": ""
    },
    {
      "id": "f6d1e442356db80000812ca733d1496a",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
      "key": "forbid_running",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
