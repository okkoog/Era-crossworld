      ],
      "originalHash": "bc547c22b7c16f3d6fe5814487cb214a5348f3dd27070018b8581d10d95fcd8d",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "家へ戻っても、スズカの姿がない。",
      "koreanText": ""
    },
    {
      "id": "9d0303212f7df1aa8aa4da0e8b956cfc",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
      "key": "forbid_running",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "forbid_running",
        "lines",
        30
      ],
      "originalHash": "5081b224731f28dcd0739e1d30899df0de5963897944231e0d047346a1d2d594",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "我慢できずに走っているのかと思ったが、寝室で、まだ眠っているスズカを見つけた。",
      "koreanText": ""
    },
    {
      "id": "d35def537118ef7a832a9d2d85493ce3",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
      "key": "forbid_running",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "forbid_running",
        "lines",
        31,
        "content"
      ],
      "originalHash": "79a5d71bb72d9860fcb42781befc7e112e5a74275803f3c568cea735d328275c",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "「……一日中、寝ていたのか」",
      "koreanText": ""
    },
    {
      "id": "023b9e0560562aaa1de6585a751323db",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
      "key": "forbid_running",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "forbid_running",
        "lines",
        32,
