      ],
      "originalHash": "172fe99f4b958482afda1060784af4d181c9a4d7f8e7cbe5682bfdcfcef44a3e",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "スズカが携帯を抱え、反時計回りにぐるぐる歩いている。",
      "koreanText": ""
    },
    {
      "id": "dff3d356cc557b1f61a2ac4124aa79ba",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
