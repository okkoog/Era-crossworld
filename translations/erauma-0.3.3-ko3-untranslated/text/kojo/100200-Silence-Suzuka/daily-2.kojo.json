      "originalHash": "bb1fe500277d7ac3a72dc18c682016b3c066dac3b76c119f729c6b1101b28c8e",
      "sourceFileHash": "73d905c1a903d031c7faa994246e4bc73ddc7d2fc1bc69d026d3c1cef812a407",
      "originalText": "言い終わるか終わらないかのうちに、スズカは玄関の傍から素早く離れた。",
      "koreanText": ""
    },
    {
      "id": "9e595e9feab386dc6da17eaac918b058",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/100200-Silence-Suzuka/daily-2.kojo",
      "key": "forbid_running",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
