      ],
      "originalHash": "9f45799ce653685775c7ef67ea1b2d1146ef7849ccc1d2923eddc2bbe1aca314",
      "sourceFileHash": "f2a591f5f6fb93dd245aa0b1f671abfe83d0cfc2a89ee3fcc374cbcdd1bd18fc",
      "originalText": "「ん？%CALLNAME%……怖くないのですか？たとえば、前のことが、また起きても。」",
      "koreanText": ""
    },
    {
      "id": "cb44e3cf1016902412b90c5952ca3931",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/111900-Dream-Journey/daily-119.kojo",
      "key": "select_after_basement",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "select_after_basement",
        "lines",
        1,
        "content",
        1
      ],
      "originalHash": "0f7076263edb49805be208cfd40066bacb95a6358d3102a3b91beff6af7a6432",
      "sourceFileHash": "f2a591f5f6fb93dd245aa0b1f671abfe83d0cfc2a89ee3fcc374cbcdd1bd18fc",
      "originalText": "「……ふふ。あなたは、本当に優しい人ですね。」",
      "koreanText": ""
    },
    {
      "id": "19b1ceba68408e96eab73ada1e64f882",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/111900-Dream-Journey/daily-119.kojo",
      "key": "good_morning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "good_morning",
        "lines",
        0,
        "lines",
        0,
        "content",
        1
      ],
      "originalHash": "af5ca50119dd089114e205596bd7121871b3397392b23970005d95ac0a51c990",
      "sourceFileHash": "f2a591f5f6fb93dd245aa0b1f671abfe83d0cfc2a89ee3fcc374cbcdd1bd18fc",
      "originalText": "「%CALLNAME%……お仕事は忙しいでしょうが、休みも忘れないでください。」",
      "koreanText": ""
    },
    {
      "id": "cb9a3ca53f1a1e94134469dafe5ceeae",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/111900-Dream-Journey/daily-119.kojo",
      "key": "good_morning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "good_morning",
        "lines",
        1,
        "lines",
        0,
        "content",
        1
      ],
      "originalHash": "998623e984d52d32bdf38d37eab7ceffdad65aa8c5a6fbccaeb122e0d66f3f23",
      "sourceFileHash": "f2a591f5f6fb93dd245aa0b1f671abfe83d0cfc2a89ee3fcc374cbcdd1bd18fc",
      "originalText": "「%CALLNAME%、今日はあまり元気がなさそうですね……よければ、お仕事も手伝わせてください？」",
      "koreanText": ""
    },
    {
      "id": "0358c3db44b41b4c711c14dc827f5c82",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/111900-Dream-Journey/daily-119.kojo",
      "key": "good_morning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "good_morning",
        "lines",
        2,
        "lines",
        1
      ],
      "originalHash": "024752afd9ab5447c872fe0f8d4fb40ab3356e773db702c1108e4fb2c3cf7a63",
      "sourceFileHash": "f2a591f5f6fb93dd245aa0b1f671abfe83d0cfc2a89ee3fcc374cbcdd1bd18fc",
      "originalText": "%CHARA% は何も言わず、ただ優しく %YOU% をマッサージする。",
      "koreanText": ""
    },
    {
      "id": "03f36e6be1bd001aa10cee3ea84efa23",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/111900-Dream-Journey/daily-119.kojo",
      "key": "good_morning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "good_morning",
        "lines",
        3,
        "lines",
        0,
        "content",
        1
      ],
      "originalHash": "e2528bcb1d1b18d6e7dc9052a02aea76b2e5ed3bb369a70d9aa8299a277394a3",
      "sourceFileHash": "f2a591f5f6fb93dd245aa0b1f671abfe83d0cfc2a89ee3fcc374cbcdd1bd18fc",
      "originalText": "「%CALLNAME% は、今日もお元気ですね。」",
      "koreanText": ""
    },
    {
      "id": "65b1ff4c54f3553db4050f212c91e38e",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/111900-Dream-Journey/daily-119.kojo",
      "key": "good_morning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "good_morning",
        "lines",
        4,
        "lines",
        0,
        "content",
        1
      ],
      "originalHash": "ecf71df2b61ad0fdf8d767f4c3b66e3e6cb72f83e528a8fbdae97135655c4812",
      "sourceFileHash": "f2a591f5f6fb93dd245aa0b1f671abfe83d0cfc2a89ee3fcc374cbcdd1bd18fc",
      "originalText": "「お待たせしました、%CALLNAME%……ふふ。」",
      "koreanText": ""
    },
    {
      "id": "e50b2edd05ed01e1386a4fd614782a5d",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/111900-Dream-Journey/daily-119.kojo",
      "key": "good_morning",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "good_morning",
        "lines",
        4,
        "lines",
        1,
        "content",
        1
      ],
      "originalHash": "c08a22ba3f628aa292f095845dd17a9bb84b84b62d3486a6e2fbc86e60ce0324",
      "sourceFileHash": "f2a591f5f6fb93dd245aa0b1f671abfe83d0cfc2a89ee3fcc374cbcdd1bd18fc",
      "originalText": "「笑顔が……可愛い、ですか？……%CALLNAME% が喜ぶなら、もう少し、笑ってみますね。」",
      "koreanText": ""
    },
    {
      "id": "9813a9fcaca0ae0fd27aa52789e94f81",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/111900-Dream-Journey/daily-119.kojo",
      "key": "good_morning_after_basement",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "good_morning_after_basement",
        "lines",
        0,
        "content",
        1
      ],
      "originalHash": "2d4eae7110c42e762929b7e44d0ddf624041de2e0af6eb210797e3412c28c77d",
      "sourceFileHash": "f2a591f5f6fb93dd245aa0b1f671abfe83d0cfc2a89ee3fcc374cbcdd1bd18fc",
      "originalText": "「どうしました、%CALLNAME%？」",
      "koreanText": ""
    },
    {
      "id": "59fe487a4258544d0231b80d8efbbe5a",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/111900-Dream-Journey/daily-119.kojo",
      "key": "good_morning_after_basement",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "good_morning_after_basement",
        "lines",
        1,
        "content",
        1
      ],
      "originalHash": "5f7778ae5dfbbc45878bf69535871aaeb13e81f2eabd2c2e36bf5998a1e6b2ce",
      "sourceFileHash": "f2a591f5f6fb93dd245aa0b1f671abfe83d0cfc2a89ee3fcc374cbcdd1bd18fc",
      "originalText": "「顔色が、よくありませんね……もしかして、外に出ない時間が長すぎて、外の世界が怖くなってしまったのですか？」",
      "koreanText": ""
    },
    {
      "id": "a9755f3d59ef279903b88ff6bbe5aae6",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/111900-Dream-Journey/daily-119.kojo",
      "key": "good_morning_after_basement",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "good_morning_after_basement",
        "lines",
        2,
        "content",
        1
      ],
      "originalHash": "f39845386faa8182d00755d6dbf73036ad8ad28c3ada292610dd5074923a3bb6",
      "sourceFileHash": "f2a591f5f6fb93dd245aa0b1f671abfe83d0cfc2a89ee3fcc374cbcdd1bd18fc",
      "originalText": "「大丈夫、大丈夫……私のそばにいれば……怖いことなんて、ありません……」",
      "koreanText": ""
    },
    {
      "id": "31b08c184442890d167934f24cf52e71",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/111900-Dream-Journey/daily-119.kojo",
      "key": "end_talk",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "end_talk",
        0,
        "lines",
        0,
        "content",
        1
      ],
      "originalHash": "62d0887bc6bd43294db0363853f6b0a617566eb09badbc90e1cddd87e653dfca",
      "sourceFileHash": "f2a591f5f6fb93dd245aa0b1f671abfe83d0cfc2a89ee3fcc374cbcdd1bd18fc",
      "originalText": "「%CALLNAME%、わかりましたか？これが盲信の結末です……ゆっくり休んでください。戻るまで、私があとのことは整えておきます。」",
      "koreanText": ""
    },
    {
      "id": "f6bf6ed4541362582f693237f66cfd43",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/111900-Dream-Journey/daily-119.kojo",
      "key": "end_talk",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "end_talk",
        0,
        "lines",
        1,
        "content",
        1
      ],
      "originalHash": "1f42bc09453594d9b9421411cd9088c6fc8a055470d0cd248de8093193b3daeb",
      "sourceFileHash": "f2a591f5f6fb93dd245aa0b1f671abfe83d0cfc2a89ee3fcc374cbcdd1bd18fc",
      "originalText": "「%CALLNAME%、わかりましたか？これが盲信の結末です……でも、あなたはここで諦めたりしないでしょう？おもてなしは用意してあります。いつでも、お帰りを待っています。」",
      "koreanText": ""
    }
  ]
}
