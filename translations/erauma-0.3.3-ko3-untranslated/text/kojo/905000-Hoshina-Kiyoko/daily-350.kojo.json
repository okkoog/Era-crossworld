      "originalHash": "d9590c52ed48dc46fceb4c8008eacd77da068d72525befb58bb0e4f3c4dc5980",
      "sourceFileHash": "f3b9bb423f66c73c771d87d10a6549c3e6400e09c100d9c69c1722252e796c48",
      "originalText": "「維持費として %COST% ウマコインだけ。秘湯で療養なさいますか？」",
      "koreanText": ""
    },
    {
      "id": "ae5898a5a48703eeb22a5ae12aedcbe6",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/905000-Hoshina-Kiyoko/daily-350.kojo",
      "key": "mw_welcome_rec_all",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "mw_welcome_rec_all",
        "lines",
        2
      ],
      "originalHash": "7d9132211ab6f655da2f503f72bacf10af0a6c1700eaa8a57cc6d6fa2621c8db",
      "sourceFileHash": "f3b9bb423f66c73c771d87d10a6549c3e6400e09c100d9c69c1722252e796c48",
      "originalText": "いま、秘湯の効力はあと %TIMES% 回、お使いいただけます。",
      "koreanText": ""
    },
