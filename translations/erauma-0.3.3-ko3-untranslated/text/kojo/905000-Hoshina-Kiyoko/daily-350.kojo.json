      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "mw_welcome_rec_all",
        "lines",
        0
      ],
      "originalHash": "800b1082777c732051615ee51625a135e786087e1f5bc4496f49393ba5ce9df4",
      "sourceFileHash": "f3b9bb423f66c73c771d87d10a6549c3e6400e09c100d9c69c1722252e796c48",
      "originalText": "%CHARA% は、秘湯へどうぞ、と %YOU% を迎える。",
      "koreanText": ""
    },
    {
      "id": "4fe700b19f486fbedd66e12d30e461d5",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/905000-Hoshina-Kiyoko/daily-350.kojo",
      "key": "mw_welcome_rec_all",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "mw_welcome_rec_all",
        "lines",
        1
