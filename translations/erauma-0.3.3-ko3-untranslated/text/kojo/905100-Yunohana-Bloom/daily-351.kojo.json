      ],
      "originalHash": "e6b665c014574fd58a1516e99e186e34cb60ea6477e4cd619143dfcc63a774fc",
      "sourceFileHash": "5db839b19974efbf1f03fe2ae9a181f2556414d2538bf5e384daa28ae35084fc",
      "originalText": "%CHARA% は %YOU% を秘湯へ案内し、湯が疲れを溶かし、傷の癒えを助けることを、柔らかく伝える。",
      "koreanText": ""
    },
    {
      "id": "9aeee8a038439d144a0c5b6f92118dca",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/905100-Yunohana-Bloom/daily-351.kojo",
      "key": "mw_welcome",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "mw_welcome",
        "lines",
        1
      ],
      "originalHash": "81b959456c48d09be77f6252a9307c79ece766cb452fd4745ae8a02d923141f2",
      "sourceFileHash": "5db839b19974efbf1f03fe2ae9a181f2556414d2538bf5e384daa28ae35084fc",
      "originalText": "「湯にお入りになりますか？ %COST% ウマコインで、一度ごゆるりと」",
      "koreanText": ""
    },
    {
      "id": "fb80fb5fc244e97b266b77979a4da28d",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/905100-Yunohana-Bloom/daily-351.kojo",
      "key": "mw_welcome_rec_all",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "mw_welcome_rec_all",
        "lines",
        0
      ],
      "originalHash": "800b1082777c732051615ee51625a135e786087e1f5bc4496f49393ba5ce9df4",
      "sourceFileHash": "5db839b19974efbf1f03fe2ae9a181f2556414d2538bf5e384daa28ae35084fc",
      "originalText": "%CHARA% は、秘湯へどうぞ、と %YOU% を迎える。",
      "koreanText": ""
    },
    {
      "id": "3044de67b4f36c8405791e760db1c895",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/905100-Yunohana-Bloom/daily-351.kojo",
      "key": "mw_welcome_rec_all",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "mw_welcome_rec_all",
        "lines",
        1
      ],
      "originalHash": "b6c40270b482538411b244c29c470f2ea4241e573fe346464fac1d15d3f50d60",
      "sourceFileHash": "5db839b19974efbf1f03fe2ae9a181f2556414d2538bf5e384daa28ae35084fc",
      "originalText": "「維持費として %COST% ウマコインだけ。湯で療養なさいますか？」",
      "koreanText": ""
    },
    {
      "id": "48067e28ef3bac24d9e8741c715e4da0",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/905100-Yunohana-Bloom/daily-351.kojo",
      "key": "mw_welcome_rec_all",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "mw_welcome_rec_all",
        "lines",
        2
      ],
      "originalHash": "7d9132211ab6f655da2f503f72bacf10af0a6c1700eaa8a57cc6d6fa2621c8db",
      "sourceFileHash": "5db839b19974efbf1f03fe2ae9a181f2556414d2538bf5e384daa28ae35084fc",
      "originalText": "いま、秘湯の効力はあと %TIMES% 回、お使いいただけます。",
      "koreanText": ""
    },
    {
      "id": "7a7e777f9843683cfd7108ea9e130532",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/905100-Yunohana-Bloom/daily-351.kojo",
