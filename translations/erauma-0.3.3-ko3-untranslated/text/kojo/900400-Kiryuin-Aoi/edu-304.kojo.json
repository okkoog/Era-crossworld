      ],
      "originalHash": "7fd8c7d89fe61051e8d2071b878b4e623502c22534da078549a90c52dce1b036",
      "sourceFileHash": "08daf86bbd70221b1eeb24ee955e3caa5d3c5a25c32f661f90305631c70358a3",
      "originalText": "%CHARA% は声を荒げて責めることはしなかった。それでも %YOU% は、胸が潰れるほど恥ずかしかった。",
      "koreanText": ""
    },
    {
      "id": "dcb210d080448c3238a1641f29d7a1fc",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900400-Kiryuin-Aoi/edu-304.kojo",
      "key": "meek_fail",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "meek_fail",
        "lines",
        4,
        "lines",
        0
      ],
      "originalHash": "407b1689bb3c2d89412057192d2a280b7b7c310fae135101870adf03ffd81e7b",
      "sourceFileHash": "08daf86bbd70221b1eeb24ee955e3caa5d3c5a25c32f661f90305631c70358a3",
      "originalText": "やがて、先に口を開いたのは %CHARA% だった。三女神像の前で心を込めて祈れば、二度目の機会が得られる——そんな噂を聞いたことがある、と。",
      "koreanText": ""
    },
    {
      "id": "907f491551900d193dba7271a1c73851",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900400-Kiryuin-Aoi/edu-304.kojo",
      "key": "meek_fail",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "meek_fail",
        "lines",
        4,
        "lines",
        1
      ],
      "originalHash": "c29e8622d978d7d964a054d98307872c123abee326772ceda4c09fbebfc6374c",
      "sourceFileHash": "08daf86bbd70221b1eeb24ee955e3caa5d3c5a25c32f661f90305631c70358a3",
      "originalText": "もし %YOU% が何かを見つけたなら、もう一度 %H_NAME% に機会を与え、かつての悔いを晴らしてほしい。",
      "koreanText": ""
    },
    {
      "id": "fb8ab7d79a07a44ae5ce35442f4786da",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900400-Kiryuin-Aoi/edu-304.kojo",
      "key": "meek_fail",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "meek_fail",
        "lines",
        5,
        "content"
      ],
      "originalHash": "6052ee8470a517f65ac8ee708437943f7317be3de2cd00e1014be4b1ff0dc036",
      "sourceFileHash": "08daf86bbd70221b1eeb24ee955e3caa5d3c5a25c32f661f90305631c70358a3",
      "originalText": "やがて、先に口を開いたのは %CHARA% だった。次はもっと力を尽くして、もう %H_NAME% に悔いを残さないでほしい、と。",
      "koreanText": ""
    }
