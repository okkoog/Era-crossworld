      "originalHash": "f29b076b026226c6d5a57b926b5b54e750fc07e9000b8d91b6392982e2c0e633",
      "sourceFileHash": "08daf86bbd70221b1eeb24ee955e3caa5d3c5a25c32f661f90305631c70358a3",
      "originalText": "トレーナー室で、%YOU% と %CHARA% は黙ったまま向かい合っている。",
      "koreanText": ""
    },
    {
      "id": "e584d33cfd2765f74eb87283c52f7bcd",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900400-Kiryuin-Aoi/edu-304.kojo",
      "key": "meek_fail",
