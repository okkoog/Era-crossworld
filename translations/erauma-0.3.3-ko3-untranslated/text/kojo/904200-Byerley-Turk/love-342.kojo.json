{
  "module": "kojo/904200-Byerley-Turk/love-342.kojo",
  "entries": [
    {
      "id": "8e9e1720a47a7211ea21048bfad72e75",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/904200-Byerley-Turk/love-342.kojo",
      "key": "49",
