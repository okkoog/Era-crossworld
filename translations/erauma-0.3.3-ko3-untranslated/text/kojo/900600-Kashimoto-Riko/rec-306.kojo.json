      ],
      "originalHash": "0babd6bb1c5c3ebaaaca79430a0b03ca2bc91a098a880995395ddb711ccc0047",
      "sourceFileHash": "9a4394b4f1ee196f60dd9647e6ecab5f7026e4a66cdf96e7a7868246776773c4",
      "originalText": "（%B_SEX%たちを率いて、重賞をたくさん勝とう……）",
      "koreanText": ""
    },
    {
      "id": "7b574e8c096cc14f033eae684c3ddde9",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/900600-Kashimoto-Riko/rec-306.kojo",
      "key": "task",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "task",
        1,
        "lines",
        0
      ],
      "originalHash": "7330da9b31963a37594f3991f8c4eebe1587f035c54732776e3de979f9864366",
      "sourceFileHash": "9a4394b4f1ee196f60dd9647e6ecab5f7026e4a66cdf96e7a7868246776773c4",
      "originalText": "月日が流れ、%YOU% は %B_NAME%、%L_NAME% と、再び同じ芝の上に立った。",
      "koreanText": ""
    },
    {
      "id": "0cfe8ada10c94e1bebdfc79be3c6c1d2",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/900600-Kashimoto-Riko/rec-306.kojo",
      "key": "task",
      "line": null,
      "kind": "kojo",
