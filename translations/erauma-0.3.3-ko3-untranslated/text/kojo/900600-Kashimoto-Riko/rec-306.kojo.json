      ],
      "originalHash": "9fcff7a7d271257ea13b35b99525df13bf2d7c72b34880416c2398bcbdede8d2",
      "sourceFileHash": "9a4394b4f1ee196f60dd9647e6ecab5f7026e4a66cdf96e7a7868246776773c4",
      "originalText": "今度こそ、%B_SEX%たちの願いを叶えられるだろうか。",
      "koreanText": ""
    }
  ]
