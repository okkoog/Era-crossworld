      "originalHash": "3aedcc5e90d05ceb4ca821fd8bc9dcda2f46b4a0c342e77b3d48365df9a9c5cb",
      "sourceFileHash": "9a4394b4f1ee196f60dd9647e6ecab5f7026e4a66cdf96e7a7868246776773c4",
      "originalText": "%CHARA% は %YOU% に、トレーニングの心構えをいくつか伝え、健康管理の大切さを強調した。",
      "koreanText": ""
    },
    {
      "id": "9d470961c4edc980858d467e77d66155",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/900600-Kashimoto-Riko/rec-306.kojo",
      "key": "intro",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "intro",
        0,
        "lines",
        1
      ],
      "originalHash": "7332f001fe791673a7468ca072a3fb5f94e0850a3a480192abd366b6388104a8",
      "sourceFileHash": "9a4394b4f1ee196f60dd9647e6ecab5f7026e4a66cdf96e7a7868246776773c4",
      "originalText": "実践については、自分のチームに素質の良い %B_UMA% が二頭いるので、%B_SEX%たちのトレーニングの手伝いから入ればいい、とのことだった。",
      "koreanText": ""
    },
    {
      "id": "0e2207ab46ed89b92007e85356c8313c",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/900600-Kashimoto-Riko/rec-306.kojo",
      "key": "intro",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "intro",
        1,
        "lines",
        0
      ],
      "originalHash": "a4ccaa89a1437b7560c90fb987efcb7a91a74dd7e066583bbad06eca9dff09ce",
      "sourceFileHash": "9a4394b4f1ee196f60dd9647e6ecab5f7026e4a66cdf96e7a7868246776773c4",
      "originalText": "%CHARA% は、トレーナーとしての %YOU% の腕を認めた。",
      "koreanText": ""
    },
    {
      "id": "79596cf50bfff3ffcb0efed7a9524e2f",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/900600-Kashimoto-Riko/rec-306.kojo",
      "key": "intro",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "intro",
        1,
        "lines",
        1
      ],
      "originalHash": "13a8a9473dd66e0c095fec0d103d62933542d121cad3e7790e577d4d13270360",
      "sourceFileHash": "9a4394b4f1ee196f60dd9647e6ecab5f7026e4a66cdf96e7a7868246776773c4",
      "originalText": "気力に余裕があるなら、これから育成が始まる、素質の良い%B_UMA%二頭のトレーニングを手伝ってほしい、と。",
      "koreanText": ""
    },
    {
      "id": "d14aca476746b93d8aa86fe2bb888fb4",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/900600-Kashimoto-Riko/rec-306.kojo",
      "key": "task",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "task",
        0,
        "lines",
        0
      ],
      "originalHash": "40e7e9d51cfde519b4eaee1fe584cff1f1874275b93e1c98e0c6f7cc58e1ad42",
      "sourceFileHash": "9a4394b4f1ee196f60dd9647e6ecab5f7026e4a66cdf96e7a7868246776773c4",
      "originalText": "%CHARA% の紹介で、%YOU% は %B_NAME% と %L_NAME% に会った。",
      "koreanText": ""
    },
    {
      "id": "9c6cdfcee41b36ea23735d62ec9a9906",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/900600-Kashimoto-Riko/rec-306.kojo",
      "key": "task",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "task",
        0,
        "lines",
        1
      ],
      "originalHash": "1131987bc094e8af0e057e32cb2fcbdc8c0d85de331ab125c21ee246a962253b",
      "sourceFileHash": "9a4394b4f1ee196f60dd9647e6ecab5f7026e4a66cdf96e7a7868246776773c4",
      "originalText": "%CHARA% の期待を背負い、%YOU% と%B_SEX%たちの三年が始まった……",
      "koreanText": ""
    },
    {
      "id": "7c1704461416c418180f98e5d2917b9b",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/900600-Kashimoto-Riko/rec-306.kojo",
      "key": "task",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
