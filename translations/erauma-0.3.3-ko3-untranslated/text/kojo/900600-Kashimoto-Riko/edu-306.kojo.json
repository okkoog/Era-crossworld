      "sourceFileHash": "c706c7c01be957fb7efdada160ee5b16a13adb7e9bba1f79b68ebc7a28a219d3",
      "originalText": "%B_NAME% と %L_NAME% の育成が終わった。",
      "koreanText": ""
    },
    {
      "id": "f491a716490050a99230e82dcc54dffd",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900600-Kashimoto-Riko/edu-306.kojo",
      "key": "task_fail",
