        "lines",
        1
      ],
      "originalHash": "1a2f9f5131122e138da5e1d2804f7114b5bd12494067e9b85d79db234140be60",
      "sourceFileHash": "ee88e6d0fa5866a996174ef61bae4c6bde9f77faa49f1ea126259ee76cacfc8f",
      "originalText": "知ってのとおり、%CHARA% の仕事の中心は、海外遠征の補佐だ。",
      "koreanText": ""
    },
    {
      "id": "a65c00450e8ff06a731e89cc0a5dab27",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/904300-Satake-Mei/rec-343.kojo",
      "key": "welcome",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
