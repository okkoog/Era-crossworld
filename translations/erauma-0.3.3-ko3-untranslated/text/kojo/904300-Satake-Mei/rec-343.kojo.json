      "originalHash": "57a7d33b1da698286ffb2de347362b58146de69ce16f03502f3c9c8fb052a846",
      "sourceFileHash": "ee88e6d0fa5866a996174ef61bae4c6bde9f77faa49f1ea126259ee76cacfc8f",
      "originalText": "%YOU% は、その人が以前からの知り合い、%CHARA% だと気づいた。",
      "koreanText": ""
    },
    {
      "id": "8c41ca93815ab98286a8c1ea6f6e8a71",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/904300-Satake-Mei/rec-343.kojo",
      "key": "welcome",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
