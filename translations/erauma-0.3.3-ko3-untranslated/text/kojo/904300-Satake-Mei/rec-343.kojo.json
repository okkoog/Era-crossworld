        "lines",
        2,
        "content"
      ],
      "originalHash": "ff7fa1b189f5d9a6fb3493da9381baf543214a1c0c4b52802f52d293738ac74b",
      "sourceFileHash": "ee88e6d0fa5866a996174ef61bae4c6bde9f77faa49f1ea126259ee76cacfc8f",
      "originalText": "%YOU% が挨拶に出ると、%A_NAME% は紹介してくれた。この%PHY%の名は %CHARA_ACTUAL%。長く海外遠征の補佐を務めている、と。",
      "koreanText": ""
    },
    {
      "id": "b8bb8db2c829818a34f2ba301c29a2aa",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/904300-Satake-Mei/rec-343.kojo",
      "key": "welcome",
      "line": null,
      "kind": "kojo",
