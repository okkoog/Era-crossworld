      "originalHash": "2049f312282d0d23106662d6b42e7ef578e490989c1166349c74ab0a0f615d75",
      "sourceFileHash": "f362fee71c3bee6d71f45b588a06f6ce98948096f4d650cc6d3df95ec0523e0e",
      "originalText": "叱責とともに、また乾いた平手の音と、鈍いぶつかり合う音が響いた。",
      "koreanText": ""
    },
    {
      "id": "ab3156224235c7b2548f9fc6e1812d52",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/900300-Otonashi-Etsuko/love-303.kojo",
