      ],
      "originalHash": "3ad5f2c5252021b10bdac742f821edabc0e75f867fa9472ad046dd0456321431",
      "sourceFileHash": "ddc2378d4fc5092cbfbc0fdf03f4930957d8bfce20cd2b6e80dd0d59ca82fdd9",
      "originalText": "それから甘えるように身をくねらせ、また%YOU%の腕の中へ潜り込む",
      "koreanText": ""
    }
  ]
