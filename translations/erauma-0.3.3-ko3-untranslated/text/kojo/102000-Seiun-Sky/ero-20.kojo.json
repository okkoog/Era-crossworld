        "lines",
        0
      ],
      "originalHash": "57c294438ad9bcaece4f70a26a2da43e77d312f6ecd449780dbf7e4a4a63a4d8",
      "sourceFileHash": "ddc2378d4fc5092cbfbc0fdf03f4930957d8bfce20cd2b6e80dd0d59ca82fdd9",
      "originalText": "朝の陽射しが、紗カーテンを通して部屋へ柔らかく落ちる。",
      "koreanText": ""
    },
    {
      "id": "4b5843d945b37871d68ef37bc99133af",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/102000-Seiun-Sky/ero-20.kojo",
      "key": "with_you",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "with_you",
        "lines",
        1
      ],
      "originalHash": "9bda03faac657bda4daceaa2460b20c3eae90a552ec7329e66904c91305af8e6",
      "sourceFileHash": "ddc2378d4fc5092cbfbc0fdf03f4930957d8bfce20cd2b6e80dd0d59ca82fdd9",
      "originalText": "耳元で、均一な呼吸がそっと上下する。温かな朝の光のなか、%YOU%のぼんやりした意識が、ゆっくりはっきりしてくる。",
      "koreanText": ""
    },
    {
      "id": "84c07db6ba8ed446035174c2437e3f1e",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/102000-Seiun-Sky/ero-20.kojo",
      "key": "with_you",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "with_you",
        "lines",
        2
      ],
      "originalHash": "542dcbfb40d471c56770d07fecba535dcce57638206339d34bd6323543ac0c70",
      "sourceFileHash": "ddc2378d4fc5092cbfbc0fdf03f4930957d8bfce20cd2b6e80dd0d59ca82fdd9",
      "originalText": "昨夜、%YOU%と夜をともにした相手は、怠惰に%YOU%の腕の中へ顔を埋め、ぴったり寄り添っている。",
      "koreanText": ""
    },
    {
      "id": "89a47e1e0d266ba3007296b900f6a81a",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/102000-Seiun-Sky/ero-20.kojo",
      "key": "with_you",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "with_you",
        "lines",
        3
      ],
      "originalHash": "0ca1ef05a586acd8fbf650f152f4fcb10448a04c83bdfb56691e08515add536c",
      "sourceFileHash": "ddc2378d4fc5092cbfbc0fdf03f4930957d8bfce20cd2b6e80dd0d59ca82fdd9",
      "originalText": "無防備なセイウンスカイを見て、%YOU%の頭に、いたずらな考えが浮かぶ。",
      "koreanText": ""
    },
    {
      "id": "4dfa4a3cb511c85b99cd1a4755392bd5",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/102000-Seiun-Sky/ero-20.kojo",
      "key": "with_you",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "with_you",
        "lines",
        4,
        "content"
      ],
      "originalHash": "18c0f1b33f27de851246831d8a3d6abfe36a8fa720a0a9ba68180213ee387db6",
      "sourceFileHash": "ddc2378d4fc5092cbfbc0fdf03f4930957d8bfce20cd2b6e80dd0d59ca82fdd9",
      "originalText": "キスする",
      "koreanText": ""
    },
    {
      "id": "742be980a2bffd0cb00bfddb886aea9c",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/102000-Seiun-Sky/ero-20.kojo",
      "key": "with_you",
      "line": null,
