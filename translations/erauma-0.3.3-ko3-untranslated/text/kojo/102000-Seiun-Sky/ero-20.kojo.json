      ],
      "originalHash": "3de7af1ecb276c452f7577c1249d3d9a7a7ee3cf59e9d7e45a85f629186dfe98",
      "sourceFileHash": "ddc2378d4fc5092cbfbc0fdf03f4930957d8bfce20cd2b6e80dd0d59ca82fdd9",
      "originalText": "あなたのそばで",
      "koreanText": ""
    },
    {
      "id": "36237c374d9cc8da5cc0e2852645f232",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/102000-Seiun-Sky/ero-20.kojo",
      "key": "with_you",
