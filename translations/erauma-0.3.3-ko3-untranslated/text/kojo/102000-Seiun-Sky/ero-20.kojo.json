      ],
      "originalHash": "ccff02404d1f0c0ad32b509395f6f5e0560d678f7e1db1be9ea96d7656bedd0e",
      "sourceFileHash": "ddc2378d4fc5092cbfbc0fdf03f4930957d8bfce20cd2b6e80dd0d59ca82fdd9",
      "originalText": "やめておく",
      "koreanText": ""
    },
    {
      "id": "a363f71367990e9d90ae0555a0594f24",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/102000-Seiun-Sky/ero-20.kojo",
      "key": "with_you",
