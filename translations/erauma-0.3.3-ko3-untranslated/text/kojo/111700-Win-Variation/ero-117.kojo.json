        "rape_standing",
        10,
        "content",
        1
      ],
      "originalHash": "581cb50807e49a23ebe21503de8c54a2335ebe86d49df491982d5caa091cf1c0",
      "sourceFileHash": "8600c76daf5e2bdd397b15e17cd82f1d2fb2955ecc34b124f9618f3986f8c0d9",
      "originalText": "「……おぐっ❤️！！」",
      "koreanText": ""
    }
  ]
}
