      ],
      "originalHash": "109a97ebe9149b1e2b3518a87209feaf9e4ec01932a8c7c3a8ef9ee80465e6c1",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「アルダン。」",
      "koreanText": ""
    },
    {
      "id": "0cea3c5ac365c95663f3b4ff262dfc46",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_valentine",
      "line": null,
