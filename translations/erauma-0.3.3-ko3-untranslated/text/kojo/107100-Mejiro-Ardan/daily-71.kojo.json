        4,
        "content"
      ],
      "originalHash": "7d60fff4493ed61e26a13f4c72f34f3d00c3470d939dd658ee210c1aad19b4e7",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「もちろん～」",
      "koreanText": ""
    },
    {
      "id": "6137c7e482d4487599a7925be42f6e1c",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_new_year",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_new_year",
        "lines",
        5
      ],
      "originalHash": "8fd7c31bee89d0b2a9908339ce4ddd6d8d0170b45eee94d3c462e596257c4307",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "%YOU%はアルダンの誘いを受け、一緒に神社を訪れる。互いを思う願いをかけたあと、新年の小さな遊びも一緒に楽しんだ。",
      "koreanText": ""
    },
    {
      "id": "8b8b2a1d66c384bf16fe287659a6db42",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
