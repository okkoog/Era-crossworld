        0
      ],
      "originalHash": "1a3198df41791931f58358471254793bf051c5b4d12e222792beaafe3061711a",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "新年の一日。あちこちが祭りの楽しさで溢れている。",
      "koreanText": ""
    },
    {
      "id": "055d7851dcb7226adecb02baeef71d29",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_new_year",
      "line": null,
      "kind": "kojo",
