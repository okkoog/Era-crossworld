      ],
      "originalHash": "4f8963c21fcabd6cf8586a9dc269b0ca367a2f03692d682316c710dbfefd232c",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "%YOU%は時おりあくびをするメジロアルダンと%SEX%の寮まで行き、サクラチヨノオーが引き継いだのを見て、安心して帰る。",
      "koreanText": ""
    },
    {
      "id": "8938ed31f7e663cf553d189185e30f36",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "good_night_normal",
      "line": null,
      "kind": "kojo",
