        "lines",
        1
      ],
      "originalHash": "582f8446bcd429d0899c1085a0fca438623cf2a59d53ac4ebcedb9e15f2d147d",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "アルダンは期待の目で%YOU%を見る。%YOU%には断りようがない。",
      "koreanText": ""
    },
    {
      "id": "4dd1481a187f6b7e40ea4522c9a427ca",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_temple_fair",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_temple_fair",
        "lines",
        2
      ],
      "originalHash": "28afc9ce565fff0f82d39f3e442997ad11094dc27a111f26e7fff3d68c21b647",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "縁日を一緒に回り、楽しい時間を過ごしたあと、%YOU%と%SEX%は肝試しへ向かう。",
      "koreanText": ""
    },
    {
      "id": "0cb9658782988e1a74fdfbb15707d630",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
