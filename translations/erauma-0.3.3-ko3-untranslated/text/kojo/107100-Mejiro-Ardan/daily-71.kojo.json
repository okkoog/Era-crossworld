        3,
        "content",
        1
      ],
      "originalHash": "975155ebab5b52aa5ee879e55db269ce8e9494dbf7a54452b292136c8183f307",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「%CALLNAME%、一緒に神社へ初詣に行きませんか？」",
      "koreanText": ""
    },
    {
      "id": "797c85c5fba3ee7047303945e4110eb5",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_new_year",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_new_year",
