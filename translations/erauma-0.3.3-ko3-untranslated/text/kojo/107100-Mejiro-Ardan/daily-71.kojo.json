        1
      ],
      "originalHash": "294434e8963ed05f2a19e877ce049ba33e93c11adc5cdb2b695f62f10f40668f",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「%CALLNAME%、あけましておめでとうございます～」",
      "koreanText": ""
    },
    {
      "id": "c2540350b93b01c3f2cad5168d1a7a88",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_new_year",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_new_year",
        "lines",
        2,
        "content"
      ],
      "originalHash": "7b469148bd65b56a37132eda123eb821f2637959167244efd675e902e6cd6c3e",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「あけましておめでとう、アルダン。」",
      "koreanText": ""
    },
    {
      "id": "fc0224e76c9ffe0d106ea2514c296035",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_new_year",
      "line": null,
      "kind": "kojo",
