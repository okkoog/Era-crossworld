        3
      ],
      "originalHash": "99e892231146c54965ae53b4ab578906c0e1067dc50ed74a119ce02484a2f995",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "%YOU%が後ろの人の名前を正確に呼ぶと、視界を遮っていた手が外れる。",
      "koreanText": ""
    },
    {
      "id": "d835e514cd3bdb9247fd3afb2e7e225f",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_valentine",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_valentine",
        "lines",
        4
      ],
      "originalHash": "1f63cf69bc7f742b8d4f0eaad86e3413be5fa76641446a5034f68d599b7f9ba4",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "アルダンは%YOU%の前に出て、幸せそうな笑顔で、綺麗に包まれたチョコレートを差し出した。",
      "koreanText": ""
    },
    {
      "id": "c1b07d2342fb2a3b78e27b673e44e8b0",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_valentine",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_valentine",
        "lines",
        5,
        "content",
        1
      ],
      "originalHash": "61f30b0e4b7a12b55cec1f16a692884140599599550599c723f8759054878467",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「ハッピーバレンタイン、%CALLNAME%。手作りですので、行き届かないところもあるかもしれません。召し上がって、ゆっくり休んでください。」",
      "koreanText": ""
    },
    {
      "id": "ac3ffe561f8ad76f210ce911f495a5a8",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_valentine",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_valentine",
        "lines",
        6,
        "content"
      ],
      "originalHash": "9386823630da71f323b882593304c1b09c117d50dc8e02a62c6939fe257bbb67",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「ありがとう、アルダン。」",
      "koreanText": ""
    },
    {
      "id": "15225c1638a7fe824af3cf3848233f4d",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_fans",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_fans",
        "title"
      ],
      "originalHash": "ae3c8452928db393701aab867ff260cc0aebe4868991b805b6b95028bb337297",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "ファン感謝祭",
      "koreanText": ""
    },
    {
      "id": "0564e3e813a4f94ec4d1bc71de42ee2c",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_fans",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_fans",
        "lines",
        0,
        "content",
        1
      ],
      "originalHash": "b2b8b5f3fb63a94e5db32810d7c5286fb26e22a47777e38d06d048f2ac576300",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「今日はファン感謝祭です。ん……ファンの皆さんを、どうお迎えすればいいのでしょう？ %CALLNAME%」",
      "koreanText": ""
    },
    {
      "id": "7d77caf38c6dda524275aef4d58a02d5",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_fans",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_fans",
        "lines",
        1
      ],
      "originalHash": "34338d41742d8e3549cf9b02813bda8b2266132de7107488fc8d9689b4d6915a",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "アルダンは少し不安げに、どんな感謝の仕方がいいか%YOU%に尋ねる。",
      "koreanText": ""
    },
    {
      "id": "12c8d78e5ea458024d748f12e8ffef07",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_fans",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_fans",
        "lines",
        2,
        "content"
      ],
      "originalHash": "07c101e6a1cad5b6a19cc21e0f997fabccd8e37672cb4a2ce9953f796d7292e8",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「アルダンらしいやり方で、ファンの心を掴むんだ！」",
      "koreanText": ""
    },
    {
      "id": "bf66a45550e2167943935f077c96043c",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_fans",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_fans",
        "lines",
        3
      ],
      "originalHash": "128aaa736202f475f92f212229f1f763535df4e7700150510d342aa10f1e0064",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "%YOU%の答えを聞き、アルダンは微笑み、自信を取り戻す。",
      "koreanText": ""
    },
    {
      "id": "d28af3c36ff292a221111dac64b1a4e2",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_fans",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_fans",
        "lines",
        4,
        "content",
        1
      ],
      "originalHash": "e9d505d491fcf7f6ad814d3c5461e01ef4aa643f3db88f98f78c1b6f9126b829",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「……ふふ、%CALLNAME%の言い方は、いつも面白くて……それでいて、私を励ましてくれます。」",
      "koreanText": ""
    },
    {
      "id": "46b7a047b726099fd8ebe6fb3c648aef",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_fans",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "cl_fans",
        "lines",
        5
      ],
      "originalHash": "3531a8d4e8892db221e87f8c3ed1781251df833a5acb35b6af59a87f5ed01e56",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "そのあとのファン感謝祭は、滞りなく終わった。",
      "koreanText": ""
    },
