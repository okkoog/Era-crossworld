      "originalHash": "103064c04bbe2c6e9cb34baef5af413f216b21cbe2c9902ea008942488a35959",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「今夜、皆さんを招いて、楽しいパーティーを開きましょう。」",
      "koreanText": ""
    },
    {
      "id": "ac5837fb39aec63a3a7b7e1026261c25",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday",
        "lines",
        4
      ],
      "originalHash": "fdba9fa8598be4853a34c32b9e8d9410601d01a0a92d692b194cccbb81955de6",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "%YOU%はアルダンの考えに賛成し、準備へ向かう。",
      "koreanText": ""
    },
    {
      "id": "54ba73241847a05872bb004af981c4d2",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday",
        "lines",
        5
      ],
      "originalHash": "66951aef76632e82fb12d383c90ab29bce918c48f51179caa3384c357767f978",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "夜、家で盛大なバースデパーティが開かれ、遅くまで遊んだ。",
      "koreanText": ""
    },
    {
      "id": "44d75442d33a956f92bd38f55cf2a762",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "title"
      ],
      "originalHash": "bfe2f4a9525f5ae8fbae167658a93d9fdf89193a7d665e2e68b57cc6dae6f6e9",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "誕生日",
      "koreanText": ""
    },
    {
      "id": "a5000b852c57019c8c822a0c4c05d48a",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        0,
        "content"
      ],
      "originalHash": "3d34ae1547a8d703180fb253aa2631957169febbf27c173f83679c36299f4168",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「お誕生日おめでとう、アルダン。」",
      "koreanText": ""
    },
    {
      "id": "1eafc8a76d3851e6de57ce7907a48b52",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        1,
        "content",
        1
      ],
      "originalHash": "b1a08e50e9557e6fd14f7ebc78d9d011abab935ff006a3888b4a5af358c031f3",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「ありがとう。大好きなあなた。」",
      "koreanText": ""
    },
    {
      "id": "5001133405544efd4656d691217bb96d",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        2
      ],
      "originalHash": "a9646fde24efc0de3b7ba9dd217c1925e54c57a53dba247057e2ed3fa6b5019a",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "今日はアルダンの誕生日。%YOU%は誕生日の贈り物を渡し、アルダンの親族や友人たちと一緒に、%SEX%の誕生会を開いた。",
      "koreanText": ""
    },
    {
      "id": "2278d845bffddc7d948dc065e9bfe06c",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        3
      ],
      "originalHash": "d0c88994242068bcdb455364f69fa64daae5f02252ed6562a2247f5250056b4f",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "アルダンの幸せそうな笑顔を見て、%YOU%は自分の労が報われたと感じる。",
      "koreanText": ""
    },
    {
      "id": "7be1130d5b6d913165ad76db8d961b87",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        5
      ],
      "originalHash": "ed61b39b837f77c1a7563183fa71d4ebadadca37f41d9cdd8d753df1d51c1b37",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "会が終わると、アルダンは参加した親族や友人へ順に手を振る。最後のひとりが去ったあと、アルダンは%YOU%のそばへ来て、%YOU%の手を握った。",
      "koreanText": ""
    },
    {
      "id": "43c68470ff80f7d07d490b9dc60475c7",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        6,
        "content",
        1
      ],
      "originalHash": "904366b851239c2e25e866fbcf5d8a905e2a0a0ac9d027970e9695a7456b50b3",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「……大好きなあなた。もっと、もっと『いま』の私たちを作りたいんです。もう少し……私と、ふたりだけでいてくれますか？」",
      "koreanText": ""
    },
    {
      "id": "c3d50e7491f9ddd25495d80fa47a3dad",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        7
      ],
      "originalHash": "1621daa59a26a168b3287d10066291bb9678a8cd40b27dfe3571255fbba20fce",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "それからメジロアルダンは%YOU%の手を引き、メジロ家の裏山へ向かう。",
      "koreanText": ""
    },
    {
      "id": "85ea4a68516897c3bd5312b4047f75b4",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        8,
        "content",
        1
      ],
      "originalHash": "d8d72273ac69a2e4410373bc1a5fcf66e62f5fb69f536f13957ca08be28091f7",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「大好きなあなた、ここは夜いちばん好きな場所です。ここで空を見上げると、とても綺麗な星空が見えるんです。」",
      "koreanText": ""
    },
    {
      "id": "d10d9e249464ca1d3ef963e2e1755056",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        9
      ],
      "originalHash": "646c5e65d1f97ac16a536bf0383cff4d08d6c98d11d0244e196f689dc65367d5",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "アルダンの言葉を聞き、%YOU%は顔を上げて夜空を見る。明かりの影響から離れ、星がはっきり見える。",
      "koreanText": ""
    },
    {
      "id": "2b0af68d6480fcb425ee77cfb09f1f89",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        10,
        "content",
        1
      ],
      "originalHash": "afb32eeab76951d697050f0e807586cc31d5e3ca40d621b93e99dcae0471d726",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「%CALLNAME%、宇宙は%UMA%たちの歴史のようです。瞬く星ひとつひとつが、歴史に眩い光を残した%UMA%たちのようで、%THEY%はこんなにも輝いて、美しい。」",
      "koreanText": ""
    },
    {
      "id": "1a0688b74f878a43c94c713434452364",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        11,
        "content",
        1
      ],
      "originalHash": "0b9a96d39a5d18299a594e9594bb8c42f3269cacb59db5a81d15a31a10e8bdd7",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「夜ここに来て星を見るのが好きなのも、そのためです。歴史の流れにいる先輩たちの輝きを、浴びているみたいで。」",
      "koreanText": ""
    },
    {
      "id": "64b4782dc5b059e12f565fed709feb30",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        12,
        "content"
      ],
      "originalHash": "c06aea3d2de33742dc7ccb61aeac880a83a0c9021d20d1b7d92bcb8e2b5a1cc0",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「君には、もう君自身の輝きがある。」",
      "koreanText": ""
    },
    {
      "id": "df4d5022af4c223f4288c88eeacbe4b0",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        14,
        "content",
        1
      ],
      "originalHash": "2d68c7d2c08d89443e08cdaf58e741def3d5c747f606c5e2b6d2aa54ea83a21c",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「ふふ、大好きなあなた、それは少し違います。私が持っているのは、あなたと私、ふたりで描いた輝きだと思います。」",
      "koreanText": ""
    },
    {
      "id": "5173e9dc93ee821d32af4ee12cc2bef4",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        15,
        "content",
        1
      ],
      "originalHash": "b46e7b5acd3c96aee553261e8136bd8b860bb746feb4303efc6b95a23466caf3",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「互いを映し合うふたりが、私たち……共通の……たったひとつの輝きを咲かせたんです🎵」",
      "koreanText": ""
    },
    {
      "id": "d210ce675c669475ac8c258e11c73cab",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        16
      ],
      "originalHash": "32ba39964a1dfbf9597f008e483c05ff045b9c91e2353626de18e35b40a7bbc5",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "メジロアルダンは%YOU%に凭れ、%YOU%と一緒にこの星空を仰ぎ、同期する心拍を感じている。",
      "koreanText": ""
    },
    {
      "id": "6853165e001d8f54968c676af6e3614c",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "birthday_dependence",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday_dependence",
        "lines",
        17
      ],
      "originalHash": "0c0797bf4909c66d8ec819ca60162b1864908c39d1b5da3fb240141541367549",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "星空の絵の下で、凭れ合うふたりがいる。",
      "koreanText": ""
    }
  ]
}
