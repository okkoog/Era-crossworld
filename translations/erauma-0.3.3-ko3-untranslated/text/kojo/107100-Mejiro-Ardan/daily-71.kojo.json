      ],
      "originalHash": "d7051d9fb16e6337f742dbffd418a7edc6b50fb3f0b554392b5560d52e73c748",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "%YOU%のそばで安心して眠るメジロアルダンを見て、%YOU%は小さな声で言う。",
      "koreanText": ""
    },
    {
      "id": "66b4fd5977f54480cd8e217271951c74",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
