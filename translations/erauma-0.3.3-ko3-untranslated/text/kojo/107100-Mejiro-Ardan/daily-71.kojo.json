      ],
      "originalHash": "90dc7b4958a2029b61f130af9abb8ce2deff5122faefde5da8aa9c4280ca6fa0",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "「誰だかわかりますか🎵」",
      "koreanText": ""
    },
    {
      "id": "2684233e33c045e0d5f45efd6eabbb66",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_valentine",
      "line": null,
