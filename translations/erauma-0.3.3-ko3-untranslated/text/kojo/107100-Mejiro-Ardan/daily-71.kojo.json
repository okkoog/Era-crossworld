      "originalHash": "4de2dff09c44d365a35fb9c57dda2188283c393afabe755cbec9e87bf2ee4212",
      "sourceFileHash": "5263a8120e1d034ec630bfdf78240c29c1ceaf6a196e4bccead10316db60f39e",
      "originalText": "今日はバレンタイン。恋する少女たちが、想い人へ本命チョコを、ただの友人へは義理チョコを贈る。",
      "koreanText": ""
    },
    {
      "id": "7429c64ae297687c488a87d22511cd51",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107100-Mejiro-Ardan/daily-71.kojo",
      "key": "cl_valentine",
      "line": null,
      "kind": "kojo",
