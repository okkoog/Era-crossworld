        1
      ],
      "originalHash": "ae895a7e11861940cf2afd9be028ca5ef17d5330ecee2b489e7380cb3bf32ad8",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「帰りましたら、%CALLNAME%と、%ELDER_SISTER%たちと、お茶会にいたしましょう～」",
      "koreanText": ""
    },
    {
      "id": "6acc229b8815221efc7a857ee8ce815e",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "kiku_sho_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "kiku_sho_win",
        10,
        "content"
      ],
      "originalHash": "a3c14d2fe45d062b119129696857fccc0b42d1f3cba52ecf632d1aa64efe2ad2",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "顔に薄い紅を浮かべ、遠く観客席の %CALLNAME% を見る。",
      "koreanText": ""
    },
    {
      "id": "9aa028546290c8578d49083ac3e0a164",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "kiku_sho_lose",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "kiku_sho_lose",
        1,
        "content"
      ],
      "originalHash": "0cc8b5323784a930711d2332df75ea1dc3321910829f8b4b88f7bdd6eea4ca71",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "ゴールに立ち、自分の着順を見る。",
      "koreanText": ""
    },
    {
      "id": "2936e40b6c1a75074b669531662c77d6",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "kiku_sho_lose",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "kiku_sho_lose",
        2,
        "content"
      ],
      "originalHash": "dd572854d4593d6aaa9e8384dbd29dc58e522190b1169d693e8f46f539ef4d78",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "あまり気にしないはずの %CHARA% でも、堪えきれず悲しい。",
      "koreanText": ""
    },
    {
      "id": "e348494afbe8b9ca864a3db16a35c438",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "stay_sta",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "stay_sta",
        6
      ],
      "originalHash": "0decc1777de01f8cd596631065f198171edc22b534098e98ee3f908283a6c04c",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "長距離が得意な %CHARA% にとって、ここが%SEX%の舞台だ。",
      "koreanText": ""
    },
    {
      "id": "08fa6d2a9bb0ea7375822be2eb3907f3",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "for_tenn_spr",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "for_tenn_spr",
        "lines",
        10
      ],
      "originalHash": "f0a3454a34c6b7602723e8923777eb66bb55b0462dfd6ebc435babacd12fca9f",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "%CHARA%の伏せた瞳を見て、%YOU% は異議なく%SEX%のそばへ行く。",
      "koreanText": ""
    },
    {
      "id": "513ef51bba04dabc694cd7248f86558f",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "tenn_spr",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "tenn_spr",
        10
      ],
      "originalHash": "e1a13aca6207f77eec3c52b26161e4bc25bd9d323c7e8f44fe5bfd3b3bc7d9be",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "ふたりの%ELDER_SISTER%が控え室へ入り、優しく %CHARA% の肩を何度か叩く。",
      "koreanText": ""
    },
    {
      "id": "a630aa256bc60e7af5d0ff57bf81215e",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "tenn_spr",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "tenn_spr",
        14,
        "content",
        1
      ],
      "originalHash": "86da334350a134b41e51ad13bc4c0110be4c27333099a546ce99421d844edc2e",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「%CALL_64%…… ええ、わかりました！」",
      "koreanText": ""
    },
    {
      "id": "e962b6562c1f265f96590bb895752915",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "tenn_spr_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "tenn_spr_win",
        6,
        "lines",
        1
      ],
      "originalHash": "33663d2bfecfda7e22207c714b80f3eed0204343bcb561994b2d0462429cba29",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "少しわざと %YOU% のそばの%SIBLINGS%を無視し、小さな声で呼ぶ。",
      "koreanText": ""
    },
    {
      "id": "a27670eddeeb00291fd0c7250a8433eb",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "mejiro_name",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "mejiro_name",
        "lines",
        25,
        "content",
        1
      ],
      "originalHash": "77bf6257c5014bdd6787d9d2e1a781f3f7575cb286e58b08a29293fd8188f77c",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「だって、%ELDER_SISTER%たちと約束しましたもの。」",
      "koreanText": ""
    },
    {
      "id": "efc54f5e301c1549aa4c75aa82ce67d3",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "takz_kin",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "takz_kin",
        5,
        "content",
        1
      ],
      "originalHash": "09bc525a98c8e8371300894974db3b013cad16a94a352a458a0548d4073eec66",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「ドーベルはどうですの？ 宝塚記念の出走者は、みな強い%UMA%ですわよ。」",
      "koreanText": ""
    },
    {
      "id": "de9823994452e980c06ad0c27a23f4b4",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "takz_kin",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "takz_kin",
        14
      ],
      "originalHash": "63e10bb4f7d4c7663292e1a1196f985e9b0eb8759272e2176c5e6253284d1783",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "%CHARA% が気づかないうちに付けた小さな凹みは、誰も気づかなかった。",
      "koreanText": ""
    },
    {
      "id": "6ff796e386d5d2596d99b865a0251c54",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "tenn_sho_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "tenn_sho_win",
        4,
        "content",
        1
      ],
      "originalHash": "b480690d37e86ae9f0c7efe3e1b9f8c7447d22ceca0199dd7c7ed842d993ab03",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「これなら…… %ELDER_SISTER%たちも、お祖母さまも、喜んでくださるでしょうね。」",
      "koreanText": ""
    },
    {
      "id": "061e52cb5d28f92ed0d79b1c2e9cffe9",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "arim_kin_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "arim_kin_win",
        9,
        "lines",
        8
      ],
      "originalHash": "23ee0ca3a9a83f0771629d65539e5034695e1e48255144c43b49f378b2bb8bf4",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "椅子がもう少し低くなければ、いまごろ %CHARA% の小さな脚は揺れていただろう。",
      "koreanText": ""
    },
    {
      "id": "e2f135e7343af5fff20aaaf2805fdbd1",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "arim_kin_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "arim_kin_win",
        9,
        "lines",
        17
      ],
      "originalHash": "0e9e148bb602883319c8ddf9e451cba0ca0f76ce4009a4ff7de1e526a57d550b",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "勝った %CHARA% の晩餐の準備へ会場へ向かった姉妹たちは、いまは現れない——",
      "koreanText": ""
    },
    {
      "id": "67073c37b5c7935b1712e9fc768bf7be",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "arim_kin_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "arim_kin_win",
        9,
        "lines",
        19,
        "content"
      ],
      "originalHash": "81822edace5bdabe753b05772b2129ef2d8a89a22d3433cd27d3e69ddc4102d7",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「らしくないな。帰ってからにしよう？」（恋慕+5）",
      "koreanText": ""
    },
    {
      "id": "383736c7c6db0dbbf17f83a0a880f5e6",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "arim_kin_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "arim_kin_win",
        9,
        "lines",
