        "content",
        1
      ],
      "originalHash": "673fc5f3d55d5704c1fb8c5cd237efbc3e39b6cbbfd2fa7ad5dad4ed0f3e2845",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「らしくない、ですの……」",
      "koreanText": ""
    },
    {
      "id": "bf58ba33581104a77effddf80ffb7e44",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "arim_kin_win",
      "line": null,
