      "originalHash": "6485de796e3853030f6484ccace6e31fdfdc4f19ac5689f109a1d31104647fb3",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「ええ～」",
      "koreanText": ""
    },
    {
      "id": "cb1bb9e60ee486bc89566c0fa85707dc",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "arim_kin_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
