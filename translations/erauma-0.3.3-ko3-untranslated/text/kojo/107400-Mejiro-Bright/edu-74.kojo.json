        "lines",
        1,
        "content",
        1
      ],
      "originalHash": "e6fc14fd480f244df2a5f781c66d1e7fb7176c2c4184963a5ee31f03b9c71b31",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「ふふ～ %CALLNAME%、あなたものんびりがお好きですわね～」",
      "koreanText": ""
    },
    {
      "id": "20f05252a742cf9c3c4f655870c69526",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "arim_kin_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "arim_kin_win",
        9,
        "lines",
        19,
        "lines",
        2,
        "content",
        1
      ],
      "originalHash": "e8526e49da4440bfce4d6497f9d5d2e7e311e6746f4d12a809e594eb2e1ef540",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「……では、私は%CALLNAME%を待ち続けますわ。」",
      "koreanText": ""
    },
    {
      "id": "816c2f8843cf42860055500cef0e76eb",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "arim_kin_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
