        "lines",
        20,
        "content"
      ],
      "originalHash": "c31b8fccd139af581ce1aff14dfc9147ab9c82c368e9bf90c75eb9d6bddc0462",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「珍しいなら、付き合うよ……」",
      "koreanText": ""
    },
    {
      "id": "877aa5df4fe7d4c70fadf7393dfbc2dd",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
