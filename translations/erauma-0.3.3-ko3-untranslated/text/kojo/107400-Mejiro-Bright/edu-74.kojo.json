        "lines",
        2
      ],
      "originalHash": "216e7542c57d06042e7e5f32c1dd9bbd8910276dd5911d129a40215b89df0671",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "肉付きのいい頬が %YOU% の胸に埋まり、%YOU% の感触を味わっている。",
      "koreanText": ""
    },
    {
      "id": "d347be814ed0187319780beab62404e7",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "arim_kin_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "arim_kin_win",
        9,
        "lines",
        20,
        "lines",
        3,
        "content",
        1
      ],
      "originalHash": "db194f31efc86bd41750f9bc64120e0721b85c1b0ee64e67249da3b35d9cec00",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「急がば回れ、ではなく……」",
      "koreanText": ""
    },
    {
      "id": "162d6cd63b7b2a882bfc7463c8695ff7",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "arim_kin_win",
      "line": null,
