        "lines",
        3
      ],
      "originalHash": "d755ded8448ff3956eb05114e30ddd88247138d2b8924471d63ea0c2762c4035",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "いつものと変わらない笑顔のまま、端正に立ち上がり、ゆっくり %YOU% の前まで来る。",
      "koreanText": ""
    },
    {
      "id": "0422095588ecbd1b83bd6702ce685df6",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "arim_kin_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "arim_kin_win",
        9,
        "lines",
