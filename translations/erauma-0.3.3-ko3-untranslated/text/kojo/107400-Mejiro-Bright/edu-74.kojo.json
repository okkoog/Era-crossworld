        "lines",
        5
      ],
      "originalHash": "d46b3b69a6b56ec118ddb7b6564cad4dca51137b06f179b61280a8d33d2d9734",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "空いたもう一方の手が、%YOU% の掌をゆっくり自分の胸へ置く。",
      "koreanText": ""
    },
    {
      "id": "e86f48b6c2c4c02e98cb7487ca4fbf46",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
