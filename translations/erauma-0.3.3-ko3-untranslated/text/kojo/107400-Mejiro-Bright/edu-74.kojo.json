        "lines",
        4
      ],
      "originalHash": "10b7645d1a97d1339367fdd5eb07432d06f2c1be9b853a8c1e757753a0c4aeb6",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "そっと %YOU% の顔に、清らかな香りの印を残す——",
      "koreanText": ""
    },
    {
      "id": "f104e75eb37ab7bea0a73de21fe02e94",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "arim_kin_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "arim_kin_win",
        9,
        "lines",
        19,
        "lines",
        5,
        "content",
        1
      ],
      "originalHash": "3daa767de0c90e5f06d49373a142008aea999432cced2ae74e9bd2dcbd9a6630",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「どうか、これを予定に入れてくださいまし～」",
      "koreanText": ""
    },
    {
      "id": "ecb2270807155909a1525650e4279f04",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "arim_kin_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "arim_kin_win",
