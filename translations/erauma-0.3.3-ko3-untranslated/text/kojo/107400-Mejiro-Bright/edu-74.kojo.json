        1
      ],
      "originalHash": "bcbded1e9912233405e5952099ce5adaccce4bd01df57398e493a046efe2a815",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「%THEY%がここで泣いていらっしゃる姿が、いつも見えるのです。」",
      "koreanText": ""
    },
    {
      "id": "885190069f0cdceeaa0b23dce9cb34b1",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "mejiro_tea",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "mejiro_tea",
        "lines",
        11
      ],
      "originalHash": "1b300dcf0c1a7ac44c16660589f240b5aaf9aad62aa264f9b9410bbf485af4d4",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "もともと仕事の少ない日、時間を空けて %CHARA% と後部座席に乗った。",
      "koreanText": ""
    },
    {
      "id": "4105da27c54d786478fefe76f142bca9",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "mejiro_tea",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "mejiro_tea",
        "lines",
        38
      ],
      "originalHash": "0fc71ee1227317c4d402cf6023c8c6bdd37b62f31ab5d6eec5b5b0c7aadcc88f",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "%CHARA% の実力を %YOU% はあまり心配していないが、それでも少し揺れる。",
      "koreanText": ""
    },
    {
      "id": "f59ba59f748f1c854a099bc5f9becfc0",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "mejiro_tea",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "mejiro_tea",
        "lines",
        41,
        "content",
        1
      ],
      "originalHash": "c39381023572dba2aaa1141085523f2061614c7e6d9f08481ea9fa0ea8264067",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「私、%CALL_13%の走りがとても好きなのです。」",
      "koreanText": ""
    },
    {
      "id": "85a96109203a038b8b0d4eb95ac4bee1",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "mejiro_tea",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "mejiro_tea",
        "lines",
        47,
        "content",
        1
      ],
      "originalHash": "cdc0f94f24a798dd63eb873656028910b8d6af8b2f79a7b14bad04e4feb66c0e",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「ふふ、%CALL_27%の走り方も、とても好きですわよ？」",
      "koreanText": ""
    },
    {
      "id": "6f4c7ae5336a7a4071f60233d6330e5e",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "mejiro_tea",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "mejiro_tea",
        "lines",
        63
      ],
      "originalHash": "023b99e381c06b51491ef9cfe44186402f8dbdbad7ef63132921bbf62cfa08f4",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "%CHARA% を突然遮ったあと、%M_NAME%は手の紅茶を置く。",
      "koreanText": ""
    },
    {
      "id": "53177db6f641dbb4d8f9acbc6cb3ab1f",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "inherit",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "inherit",
        "lines",
        4
      ],
      "originalHash": "05d2038ab461b96b999d239381b67c913aae1c6a0cce47aabc4eae560a09ed9e",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "%YOU% が振り返ると、%R_NAME% がゆっくり前まで来る。",
      "koreanText": ""
    },
    {
      "id": "ad7f6c3a59490a68ef368a58a6c79fa3",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "inherit",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "inherit",
        "lines",
        10,
        "content",
        1
      ],
      "originalHash": "a28ce5afc4974be3a5b773f7889b678d1151791167740022c2e5886f0aa8c0b5",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「ごめんねブライト。トレーナー%SIR%と、少しだけ二人で話してもいい？」",
      "koreanText": ""
    },
    {
      "id": "3b17dfd2af14ff4903de32f767d19da1",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "inherit",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "inherit",
        "lines",
        13
      ],
      "originalHash": "28dbb4a1baf75f46ca6b084dee74e44eb4293d3b6095d50c49cbf1615a31d838",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "その場で首を傾げる %CHARA% を一目見て、%YOU% のそばへ寄り、小さな声で話し始める。",
      "koreanText": ""
    },
    {
      "id": "ca7553464f5912764e68f58becabcfc7",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "inherit",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "inherit",
        "lines",
        19,
        "content",
        1
      ],
      "originalHash": "c4e1633164f3f830975deca3ee1bf73e2ddea7d4cfdcd203000ef221948b77ac",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「でもブライトがいつも%SEX%の気持ちを教えてくれて、支えてくれたから、自信が持てたんだ。」",
      "koreanText": ""
    },
    {
      "id": "bf92e1c9fdbc793d261ae558e2655234",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "inherit",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "inherit",
        "lines",
        20,
        "content",
        1
      ],
      "originalHash": "ecf0cccd647f27a2eb6473bc36fc6921911418ddac59956ca7906eb865e5ff3f",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「%SEX%があんたを選んだなら、ちゃんとした理由があるんでしょ。」",
      "koreanText": ""
    },
    {
      "id": "e2bec88a42427e7d74bbf43adf5afc67",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "inherit",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "inherit",
        "lines",
        22,
        "content",
        1
      ],
      "originalHash": "333d7ee9fffccaa9c4059dcb46b0e59f8ddc5154c496358e0d369b9771d25d7e",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「だから、ブライト%SEX%をよろしくね！」",
      "koreanText": ""
    },
    {
      "id": "32ae43863000906f4cca2c1993a6d621",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "inherit",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "inherit",
        "lines",
        25,
        "content",
        1
      ],
      "originalHash": "8fda04e7a8632c5f7d7d9557de313132267cc81a85145543d3bf2eef7090fe40",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「ブライト%SEX%に、勝たせてあげてくれない？」",
      "koreanText": ""
    },
    {
      "id": "fb5bf56cdcc57287d567134590ceba05",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "inherit",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "inherit",
        "lines",
        26,
        "content",
        1
      ],
      "originalHash": "401a080624390060b853628f201ef5c126294e40d1ed8a0a9cb657b186e14526",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「あのとき私はできなかったけど…… %SEX%には、やってほしいんだ。」",
      "koreanText": ""
    },
    {
      "id": "c4582aab48d0ec6d7bd8a9d85dec9a2f",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "inherit",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "inherit",
        "lines",
        27,
        "content",
        1
      ],
      "originalHash": "be452d626e5f246b2c4916c144805626050845bfef73067fbd285e5fc7a0244c",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「だって%SEX%は、私の自慢の%YOUNGER_SISTER%だもん。えへへ～」",
      "koreanText": ""
    },
    {
      "id": "94e413e02c175d97b14a5fdc7184f139",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "inherit",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "inherit",
        "lines",
        38,
        "content",
        1
      ],
      "originalHash": "6cff858a3008e78688db4939c0b693f28ddc21b65886107d08e0bf249e4722b1",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「%CALL_27%でしたら…… 私に、どこかのレースへ出てほしい、というようなことでしょう？」",
      "koreanText": ""
    },
    {
      "id": "4341d037ea6d25e4579740fd7844df31",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "inherit",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "inherit",
        "lines",
        40,
        "content",
        1
      ],
      "originalHash": "8efcad36f5a6e9a335f2b23caebe8d263574778d11beff819f04ad1b901ee94f",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「%CALL_27%のレースは、どれも覚えていますわよ～」",
      "koreanText": ""
    },
    {
      "id": "17449de4c8c79c8cbf079fe45b28af39",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "inherit",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "inherit",
        "lines",
        41,
        "content",
        1
      ],
      "originalHash": "f98d32b630a82fb90c5e045ac5c859aed114379cf016dad8c7dbddcc58389016",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「だって%CALL_27%は…… いちばん好きな家族ですもの。」",
      "koreanText": ""
    },
    {
      "id": "cc7e292f4d3d815e4a5fb1486a1ec545",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "my_way",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "my_way",
        "lines",
        4
      ],
      "originalHash": "f32c81c5fcbeb3cbdeb2ef72142a72c499000c47287987fdec0c5a66ad7681d4",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "%CHARA% の前に立つ %YOU% は、直接%SEX%に触れず、目の前で手を振るだけだった。",
      "koreanText": ""
    },
    {
      "id": "a338fb60edbecf470c25646434727758",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "hope_sta",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "hope_sta",
        18,
        "content",
        1
      ],
      "originalHash": "1f34d83e5a59be267855007ab43a0d3a7641ad5d77773756a7e81c1c1552afff",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「レースのあと、ドーベル%THEY%と一緒に……」",
      "koreanText": ""
    },
    {
      "id": "511c8055ef2cf0be12ed8bf106cbbe77",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "light",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "light",
        "lines",
        8
      ],
      "originalHash": "58733620b474988b924a4971e2c960fb86b57844107cd0c14ce6d6d013d57e86",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "%UMA%たちが心の慰めにする神社を前に、%YOU% もだいたいこの旅の理由がわかる。",
      "koreanText": ""
    },
    {
      "id": "07293ab572071ea0b146717d29170fee",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "sats_sho",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "sats_sho",
        3,
        "content",
        1
      ],
      "originalHash": "3bba9f32be6b6af0509caa2b42db9459470bf6639347e5c59d1fe461646edd87",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「%ELDER_SISTER%たちが目指された目標を、いま、私が……」",
      "koreanText": ""
    },
    {
      "id": "941ea98488381e913280f642379900fd",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "sats_sho_lose",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "sats_sho_lose",
        4,
        "content",
        1
      ],
      "originalHash": "71294755ff5d96ff27827b00c40a8b21ed8f80786e1943530745c11770b6b3f9",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「%ELDER_SISTER%方からも、たくさん学んだのに。」",
      "koreanText": ""
    },
    {
      "id": "b40ee05de93ec2e96daf1e9bb272c316",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "toky_yus_lose",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "toky_yus_lose",
        5
      ],
      "originalHash": "e1bbffdfb068c53a23fdf7d953e06dec2064c17e6defdd4843c5373b6aac50c7",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "落ち込みつつも、%SEX%らしい落ち着いた微笑みは残している。",
      "koreanText": ""
    },
    {
      "id": "3e5196fdd44bb85197107f6048bfab06",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "kiku_sho",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "kiku_sho",
        5,
        "content",
        1
      ],
      "originalHash": "86b7c4e8ca687771a1db5983555b8ee8ae9bce30fc8b273255351ad94cf065eb",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "「%CALL_13%も、あのときはこんな空気のなかで出走されたのですわね。」",
      "koreanText": ""
    },
    {
      "id": "48896f22e78404a24b3c0548ff4d80ce",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "kiku_sho_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "kiku_sho_win",
        3,
        "content"
      ],
      "originalHash": "27c5ee66cc56211cc1d38b32e370bca980750ff745b2c32ec44eba64e8ee4b6e",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "ゴールに立ち、置き場のない手が胸に当てられ、息とともに上下する。",
      "koreanText": ""
    },
    {
      "id": "ef16c1e14a41f8bbef841399d87fa14f",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "kiku_sho_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "kiku_sho_win",
        4,
        "content"
      ],
      "originalHash": "4fefefe4eddd9df128234013b7dbe4410bfc6be96465b11e88a68365244c0016",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "少し疲れた目が観客席へ流れ、%CALLNAME% の姿を探す。",
      "koreanText": ""
    },
    {
      "id": "22c6e097d2dad043ea89f9a74632ff27",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
      "key": "kiku_sho_win",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "kiku_sho_win",
        7,
        "content"
      ],
      "originalHash": "e40ca72cc1bed1407420fb9c48a003c4285a7cccd37ae2b6f19955c5966ef18c",
      "sourceFileHash": "5828a79d5c73025b1b312e88fa9b08f632f68b446ea658b59ec0c4f750537a2c",
      "originalText": "胸の鼓動が止まらず、押し続けている。",
      "koreanText": ""
    },
    {
      "id": "61c1e862fe6fd7bde9e197410bdf795b",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/edu-74.kojo",
