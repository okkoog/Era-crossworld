      ],
      "originalHash": "f08fcdb0484b17968a581d59448d6a9c4652fac9384d7209ed5211ab9b566773",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "%YOU% の視線のなか、%CHARA% はゆっくり口を開けてファスナーを咥え、下へ下ろす。",
      "koreanText": ""
    },
    {
      "id": "81420ed049d80e2ac422492effa009cf",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
