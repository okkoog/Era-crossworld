        1
      ],
      "originalHash": "e6b262da6ccd5eaf2e567002515503476cb2999a8a2380ffd1618bca367dbdf4",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "「あ、%CALLNAME%…… こうされるの、お好きですの？」",
      "koreanText": ""
    },
    {
      "id": "c596fe0b27dd5ef2b064eb9506367e94",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
