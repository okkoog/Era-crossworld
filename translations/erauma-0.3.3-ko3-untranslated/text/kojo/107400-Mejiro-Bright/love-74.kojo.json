        "lines",
        4
      ],
      "originalHash": "6fbf54b5eb2c48d5c865f785ea97ddc343d2f8b57602b973a005fd7060ee108c",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "体感温度が上がり続け、%YOU% の忍耐がいくら強くても、目を開けずにはいられない。",
      "koreanText": ""
    },
    {
      "id": "34f3f99d23da8fbd3e3b0436b61c5532",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
