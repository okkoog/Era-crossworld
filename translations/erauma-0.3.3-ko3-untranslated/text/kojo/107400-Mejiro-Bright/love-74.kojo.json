        "lines",
        6
      ],
      "originalHash": "8758cc048c2d51cecb0c6df5a2d96dcbfff553b5146322e420b967e1f71d38bc",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "寝ぼけた様子の %CHARA% が %YOU% の太ももに伏せ、顔を上げて見上げている。",
      "koreanText": ""
    },
    {
      "id": "ba93deb63ad6f37bf7dd3a291859a249",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "all_along",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
