        13
      ],
      "originalHash": "b6973d760a879e7a41df9264e64b728b2038d917017f90ddbab7e7cd13a20a4d",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "目の前の箱をそっと前へ押し、次の動きを少し期待して見つめている。",
      "koreanText": ""
    },
    {
      "id": "79eff3e8bef53513eeb79bcc68f766ca",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "74",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "74",
        "lines",
        23,
        "content",
        1
      ],
      "originalHash": "7428c357b2911354f0a2afcefc33433eeadba70a1de0123bc8890a296b023200",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "「こ、恋人？」",
      "koreanText": ""
    },
    {
      "id": "d7fadad698939009c0568d9867822457",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "89",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "89",
        "lines",
        38
      ],
      "originalHash": "9a664aa33eb2406a1886989b029c0467c4bc879ee52b99c657a4c4bb636adc4e",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "どうにか片付けたころ、普段なら目覚める時間になっていた。",
      "koreanText": ""
    },
    {
      "id": "80a5728a579c15d612c6b3f69d3147d4",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "99_1",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "99_1",
        "lines",
        0,
        "content"
      ],
      "originalHash": "468fd0594807a0c3addfae0b370260ef37979d690272fd48b86ce3e099c4eab7",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "休日の%CHARA%は自室にぼんやり座り、窓の外の夜空を見ている。",
      "koreanText": ""
    },
    {
      "id": "c26488f2c03540e2d03b6cc85238032f",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "99_1",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "99_1",
        "lines",
        1,
        "content"
      ],
      "originalHash": "0a6ffe1afd0e2843239209c57ec74bca4858ba56a93cc04f65dbd89c54fdf190",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "少女らしい部屋には、対になった人形が並んでいる。",
      "koreanText": ""
    },
    {
      "id": "160a050c184fe287e1a8dee8a922deb1",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "99_1",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "99_1",
        "lines",
        2,
        "content"
      ],
      "originalHash": "075766d1ae6485ca29ab28caf39ec3c408e50df1ecc0d64e48e08ee09d465292",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "いつのころからか、散らばっていた人形にも、それぞれ連れができた。",
      "koreanText": ""
    },
    {
      "id": "d45d20cc06ae7c3f606dab789e23891c",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "99_1",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "99_1",
        "lines",
        3,
        "content"
      ],
      "originalHash": "c8fc468c91772386f92026635efebdab8e41aff1b73ea189987a1036a4dd10f6",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "小さな人形のそばには、どれも対になるもう一体が座っている。",
      "koreanText": ""
    },
    {
      "id": "01391c87a6a0378e6651695bc9d3ea4b",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "99_1",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "99_1",
        "lines",
        4,
        "content"
      ],
      "originalHash": "da0e228e43d3cc64bb5b8f7615abbc8f912c5d2e8f49d296276a53a28017fa4d",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "いまこの部屋でひとりなのは、%CHARA%自身だけ……",
      "koreanText": ""
    },
    {
      "id": "28ff500c88d9d3dbf233c8a186861c53",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "99_1",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "99_1",
        "lines",
        7,
        "content"
      ],
      "originalHash": "ab93705d977004fd2e8ecee077ee80182de1691461fb4202b25a8af6912b5b2a",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "いちばん好きな二つのぬいぐるみを抱き、床に届かない小さな脚をそっと揺らす。",
      "koreanText": ""
    },
    {
      "id": "2ea759b6bcef674f783177a511bde579",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "99_1",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "99_1",
        "lines",
        8,
        "content"
      ],
      "originalHash": "feb0431b35a2c4cd910428a1e8aca561a2a044745e26d1791e22dfa5b839dbbd",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "上半身を揺らしながら脇を見る——隣に空けた、もう一つの場所を。",
      "koreanText": ""
    },
    {
      "id": "2c49e5288994a6a8ee7d7b323f920f7f",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "99_1",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "99_1",
        "lines",
        10,
        "content"
      ],
      "originalHash": "8f3e71d19ad11cb1f2c313950ad59c06500e087340ed6ee14b33d9c5ddf99422",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "ゆっくり身を屈め、懐の人形を抱きしめて、顔の半分を隠す。",
      "koreanText": ""
    },
    {
      "id": "30e73ca40feb2550f6fe28bf8e966b66",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "99_1",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "99_1",
        "lines",
        11,
        "content"
      ],
      "originalHash": "ebe447b3c32e68b3d864a0d5fedb820e9b8e57c5901713e51bb220916c609d2c",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "瞳に映る部屋のなかに、%YOU%の姿がある。",
      "koreanText": ""
    },
    {
      "id": "d4a14096ed83328284b18b5dc1444588",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "99_2",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "99_2",
        "lines",
        22,
        "lines",
        8
      ],
      "originalHash": "4bac227331ffdd0c647c15a680e62b0cd68be0c1e71b7a7301a5126f072b55c6",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "押しのけようとしても、%CHARA%のウマ娘としての力はまったく通用しない。",
      "koreanText": ""
    },
    {
      "id": "691f034293d348fb5775351ce4f4513b",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "small_party",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "small_party",
        "lines",
        8,
        "content",
        1
      ],
      "originalHash": "038d60856dd7f1753f8e6e352a65e59fc72abc6283a41742f40c4b46593db262",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "「担当%UMA%は、トレーナーと仲よくしなくては～」",
      "koreanText": ""
    },
    {
      "id": "6ee7c1dcc17f61d81e55fad45bd3825b",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "small_party",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "small_party",
        "lines",
        41,
        "content",
        1
      ],
      "originalHash": "a263074a18070dafc8b8ad0550d3fd98d79d170f12c316c3e019fa789ee3dfe1",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "「トレーナーと%UMA%が、こんなに密着するなんて……」",
      "koreanText": ""
    },
    {
      "id": "1f91a0af4244289a71472d53d7f0d0a6",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "all_along",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "all_along",
        "lines",
        9
      ],
      "originalHash": "cbb566583f5b6b896bb008ed487e0183cd0f2ae70dcbbd9b29d2424653f9df93",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "そっと脇で眠る %CHARA% を一目見て、%SEX%に倣って鼻を鳴らす。",
      "koreanText": ""
    },
    {
      "id": "a8ef834ad190369990bb130010f4c2d8",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "all_along",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "all_along",
        "lines",
        13
      ],
      "originalHash": "df10554023dc37cad930339adcfe7aa6a93cdd76c3994eff17f54f8674a2840b",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "もう疲れたなら、少し休もう。",
      "koreanText": ""
    },
    {
      "id": "a82429c42c9ef8ce444df189968f3946",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "all_along",
      "line": null,
      "kind": "kojo",
