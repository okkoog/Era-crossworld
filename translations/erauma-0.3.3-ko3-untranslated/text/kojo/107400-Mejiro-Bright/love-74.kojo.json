        0
      ],
      "originalHash": "4f14416692bb042629416ebc2358174e84e96dcd152e06989b74bd5bc4530a05",
      "sourceFileHash": "bd69d762174db0413cf2e991ee52743c46372c31dea3e60243d7fb44dbad2ae6",
      "originalText": "少し熱いくらい構わない。エアコンもある。",
      "koreanText": ""
    },
    {
      "id": "3de2a6be4645ca8233cc5c18aeed25d6",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/107400-Mejiro-Bright/love-74.kojo",
      "key": "all_along",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "all_along",
        "lines",
