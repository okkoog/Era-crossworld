        "title"
      ],
      "originalHash": "c8144540d94a45fb7d9c93df6585ff116d638cfa24f131ca6c64e4e26c6a45b6",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "三年目の誕生日",
      "koreanText": ""
    },
    {
      "id": "d9fadcbdffd82052392078369227de31",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        0
      ],
      "originalHash": "7769f7562ed810a5114f5c694fcb7f5357368c139fa9ffbd59a43cc640a4a44e",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "マックイーンの誕生日の夜。",
      "koreanText": ""
    },
    {
      "id": "9afbe1787bc48830b33a8374e2b82eb6",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        1
      ],
      "originalHash": "fc2e0999befa76b7cc33b4bf7070fbfdbd743002fb3eb624e3ae92518ff64ba5",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "目隠しをしたマックイーンを、%YOU%がトレーナー室へ案内する。",
      "koreanText": ""
    },
    {
      "id": "b9fc9a76f8ff7b44427980e1de2a7e1e",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        2
      ],
      "originalHash": "bdf3559df58bf92eef42fbb62daba931d0247d168cd8083fc2d9ff4226d422cb",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "布を外した瞬間、トレーナー室にいたマックイーンの友人たちが一斉に声を上げた。",
      "koreanText": ""
    },
    {
      "id": "cf129699da9f3cb9295273b8f4f0c007",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        3,
        "content",
        0,
        "content"
      ],
      "originalHash": "ff4eb8f1c242dc78498ac4a99d8a238c03d03ef11de49d6cf7170e5b3d6a63d8",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "みんな",
      "koreanText": ""
    },
    {
      "id": "d0194db706eb8e412a2c34d75efd4f87",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        3,
        "content",
        1
      ],
      "originalHash": "68b131630dae961345fa706f974dec5fc06006ea23f046c619f8306c511a632f",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "「マックイーン、お誕生日おめでとう！！！！！！」",
      "koreanText": ""
    },
    {
      "id": "da824f12b6ef67b3d85653ed8df76cf4",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        4
      ],
      "originalHash": "a486e98e1884ba38c3c9827c899edfd9745c152e71e42fb244081a50f831e3c4",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "それだけでなく、左右からクラッカーが鳴った。",
      "koreanText": ""
    },
    {
      "id": "48fd86f37cf680d5ddeb5793e1d6bb83",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
