        "content",
        1
      ],
      "originalHash": "f06dd25c4bcc8070c1e27fac6d16b468b889c6caf5c50971a0b6aa95698307ce",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "「みなさま……」",
      "koreanText": ""
    },
    {
      "id": "9cca435392c8e2670d16a9336758d9c4",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        6
      ],
      "originalHash": "3610e9540f997f81340ebc45436e576c638aa3709d961e8f3f25bfadfa17f948",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "これほど盛大な場に、マックイーンは口を押さえて感動を隠そうとする。",
      "koreanText": ""
    },
    {
      "id": "78fc2c17dbb9b12179f19b130dd6fe23",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        7,
        "content"
      ],
      "originalHash": "4add81440c2671763b775331f255174bb5b42ab1fb5f8115ed25b597144c8413",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "「今夜は肩の力を抜いて、思いきり休もう。」",
      "koreanText": ""
    },
    {
      "id": "e2ba65429b2c426109d26e82b8470124",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        8
      ],
      "originalHash": "7d1f9883985a22708de73af0379d24e9ea87cc9f354f825984bc1689ee9c9c90",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "%YOU%はマックイーンの手を引き、%SEX%と一緒にケーキの前へ座った。",
      "koreanText": ""
    },
    {
      "id": "4407fb61e4c428236a2b8fddd621b65f",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        9
      ],
      "originalHash": "cee5e96026265890efccdd8e3075615e4ae27fbbaf4c74ea6bcdab4e174d0825",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "あとはお決まりの、誕生日の歌と願い事。",
      "koreanText": ""
    },
    {
      "id": "ad47d9fc11bf2480e9b8a95aba61adcb",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        10
      ],
      "originalHash": "ea87d700867b71af8b3941a92b63eea03411acd35e5055f77c41fb4a99bd36ef",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "贈り物の番では、誰もがマックイーンに品を渡したが、%YOU%だけがまだだった。",
      "koreanText": ""
    },
    {
      "id": "3c602b26849700d653e9f8baa421d8cb",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        11
      ],
      "originalHash": "411961d9c54b0462f3dba85a37ff9679ee90f54c15c71363ec1ea3d945c5efb4",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "%YOU%は机の引き出しを開け、何かを取り出した。",
      "koreanText": ""
    },
    {
      "id": "d7d5133fa1a0e343930bc4d8f9ff6616",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        12
      ],
      "originalHash": "c77c796cc53efe7cf1399dd933e50321adb0b1727cb2d8d0163cf4700638a4b3",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "「今の時期には、少し場違いかもしれない。」",
      "koreanText": ""
    },
    {
      "id": "5bbad03581d6abc3c2eb2b803d9296e1",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        13
      ],
      "originalHash": "113ea3406ab6d2e74d941d6feb151063dfedec798304b90db0f5181b7e6e0fd7",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "%YOU%はマックイーンに贈り物を見せた。",
      "koreanText": ""
    },
    {
      "id": "48132d1d4502f6fd464f315866577d78",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        14
      ],
      "originalHash": "25a903a269cb3f680233c02731ffdf131fc3eefd2cd1cfe4df7f0de4ad4bd724",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "——紙で作った天皇賞（春）の盾。",
      "koreanText": ""
    },
    {
      "id": "dc0ff7e00475999b024d0164aa7ce168",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        15
      ],
      "originalHash": "dcf12bdd577e89eb1b4cdfad4a4858bb90dc6891f45c8b30f72939e821db0323",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "「今月が天皇賞（春）だ。とにかく、勝ちを祈っている。」",
      "koreanText": ""
    },
    {
      "id": "78b139fcf1299c99074c13968f4054d5",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        16
      ],
      "originalHash": "33a9a29debe1ddce062edf9d485602d0aa661a3dad6af0bb8e1371336a1b12e9",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "目の前のマックイーンは両手で盾を持ち、少し間を置いてから口を開いた。",
      "koreanText": ""
    },
    {
      "id": "670769842f68dd1ded8439cd64488549",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        17,
        "content",
        1
      ],
      "originalHash": "8b96fa5ff92aecc7c7dc47327944be1fba0f0140f23bd543dd6c2e9aa22f534c",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "「本当に、お馬鹿さんですわね、%CALLNAME%。」",
      "koreanText": ""
    },
    {
      "id": "6b0f499c649571685cc22a958a214e0e",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        18,
        "content",
        1
      ],
      "originalHash": "9f2568a0949fbfae1c4e7277dcbf638a0fdd85e6d51726751b49a4465176f617",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "「期待していてください——本物の天皇賞の盾を、持ち帰ってみせますわ。」",
      "koreanText": ""
    },
    {
      "id": "184f342b9dd44d7da73a7033e14ada94",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        19
      ],
      "originalHash": "5ffe9c92fb7d83d25a76a7115496e8eba45195934d21c671f34b57004deefb1a",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "マックイーンは決意の表情で、%YOU%が贈った「盾」を撫でた。",
      "koreanText": ""
    },
    {
      "id": "2adc94f49fedb6f947107742ead36ffb",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday3",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday3",
        "lines",
        20,
        "content"
      ],
      "originalHash": "eb18558c23c6b622e626996fb1e234d9e586340c7c687451a98d3ac2b8b51500",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "「とにかく、まずは誕生日を楽しもう。」",
      "koreanText": ""
    },
    {
      "id": "0bee1f25e8b17733277aa112b958f0f9",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
