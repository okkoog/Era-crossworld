      "originalHash": "301b0b57fee5402936cf618416dec80061bb00d213c43853ee435a6afa5b0de0",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "「メジロの栄光は、わたくしが継いでまいりますわ。」",
      "koreanText": ""
    },
    {
      "id": "a18bd124350fb92dec88e925663c0d71",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday1",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday1",
        "lines",
        15,
        "content"
      ],
      "originalHash": "ec9824aa101f56ad6d50b2176d0eb21bbc04e598fb5e4fb61cf9606070b38fb0",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "「とりあえず、まずは誕生日を楽しく過ごそう。」",
      "koreanText": ""
    },
    {
      "id": "1ad35f4151cb52a99fe48be220998b5b",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
      "key": "birthday1",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "birthday1",
        "lines",
        16
      ],
      "originalHash": "b02e2536d8f2e8e696e8772442ddbf67921126a2f0f4ff5eef4b315f9e4464f2",
      "sourceFileHash": "8763b704982ec7684b115b88247cc3401abc0c806bd6f7504d1ce2d036bcb6d1",
      "originalText": "マックイーンは少し驚いて後ろの%YOU%を見、本能的に手紙の内容を隠した。",
      "koreanText": ""
    },
    {
      "id": "18b9079ed9938bc46cf91da21ed867c9",
      "sourcePath": "sources/erauma/ere/i18n/ko-KR/kojo/101300-Mejiro-McQueen/daily-13.kojo",
