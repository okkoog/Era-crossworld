        "content",
        1
      ],
      "originalHash": "7d1b77cc24ab70a1dfce03df931e9d0ab6ffff002a2bf7c74c8d2a820ef25b62",
      "sourceFileHash": "50c4edb24aff1699a23cf156149d0075de3c451be102449ceb6b6faef9b515b4",
      "originalText": "「すぐに戻りますわ。どうか、ここにいてくださいませ。」",
      "koreanText": ""
    },
    {
      "id": "38e382a3f269501947220a6544a709df",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/101300-Mejiro-McQueen/base-13.kojo",
      "key": "ask_release_agree",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "ask_release_agree",
        0,
        "content",
        1
      ],
      "originalHash": "e0a2cf304871a00a444f1c08c2fe742b246549c04b80a5b9aea07761fd4235d4",
      "sourceFileHash": "50c4edb24aff1699a23cf156149d0075de3c451be102449ceb6b6faef9b515b4",
      "originalText": "「つまり……わたくしに、あなたを出してほしい、ということですの？」",
      "koreanText": ""
    },
    {
      "id": "0ecf9de90f96d3f46bbaec91e2f88118",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/101300-Mejiro-McQueen/base-13.kojo",
      "key": "ask_release_agree",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "ask_release_agree",
        1
      ],
      "originalHash": "b8710f1ae8b78cf5540321fb496f0fd42ee1a524076e5e8b5151c1162334b623",
      "sourceFileHash": "50c4edb24aff1699a23cf156149d0075de3c451be102449ceb6b6faef9b515b4",
      "originalText": "考えるまでもなく拒まれる頼み、のはずだった……",
      "koreanText": ""
    },
    {
      "id": "6129b0a3d7221a2110da94fcfe88f18f",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/101300-Mejiro-McQueen/base-13.kojo",
      "key": "ask_release_agree",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "ask_release_agree",
        2,
        "content",
        1
      ],
      "originalHash": "9694332b5f4787b7f6581acea90a2bec85e0d44c16f162d86e389fc338f995b3",
      "sourceFileHash": "50c4edb24aff1699a23cf156149d0075de3c451be102449ceb6b6faef9b515b4",
      "originalText": "「よろしいですわ。いらっしゃい。」",
      "koreanText": ""
    },
    {
      "id": "a13b7c80b349a00e3d82a8936b0dc935",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/101300-Mejiro-McQueen/base-13.kojo",
      "key": "ask_release_agree",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "ask_release_agree",
        3
      ],
      "originalHash": "15661206919fd75da7e4d255c2267e5f593829b219d147cf902083c8757f7039",
      "sourceFileHash": "50c4edb24aff1699a23cf156149d0075de3c451be102449ceb6b6faef9b515b4",
      "originalText": "一瞬、%YOU%は勢いよく顔を上げ、信じられないように%CHARA%を見た。迷いなく、硬い脚を引きずって扉へ向かう。",
      "koreanText": ""
    },
    {
      "id": "5164ec01e78959eff8f598803871fe66",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/101300-Mejiro-McQueen/base-13.kojo",
      "key": "ask_release_agree",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "ask_release_agree",
        4,
        "content",
        1
      ],
      "originalHash": "4d65bb4526d3daee0a481ca9d9d0319263bda430537fad8451c4d09c78445353",
      "sourceFileHash": "50c4edb24aff1699a23cf156149d0075de3c451be102449ceb6b6faef9b515b4",
      "originalText": "「メジロ家は広いものですから、わたくしがお連れいたしますわ。」",
      "koreanText": ""
    },
    {
      "id": "9273d3bbbacde78f44ffb487a5157453",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/101300-Mejiro-McQueen/base-13.kojo",
      "key": "ask_release_agree",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "ask_release_agree",
        5
      ],
      "originalHash": "5200ad3aea99ef6accf26ff75db339582c0c5df30c5e06cbd4bd869b9adc73fe",
      "sourceFileHash": "50c4edb24aff1699a23cf156149d0075de3c451be102449ceb6b6faef9b515b4",
      "originalText": "%CHARA%の淀みない手際に、%YOU%は頼みがあまりにスムーズすぎて信じられない。",
      "koreanText": ""
    },
    {
      "id": "e32f097d57081cca7c3779bc2c0dc5cb",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/101300-Mejiro-McQueen/base-13.kojo",
