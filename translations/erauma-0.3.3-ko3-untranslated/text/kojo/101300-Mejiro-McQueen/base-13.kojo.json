        8
      ],
      "originalHash": "c6224d1a40d0104eeb3b51c550354a53e6eb4800606fd4cf17b4586886b1d05c",
      "sourceFileHash": "50c4edb24aff1699a23cf156149d0075de3c451be102449ceb6b6faef9b515b4",
      "originalText": "淡く礼を言い、振り返らずに去りたい。だが手が%CHARA%に掴まれた。",
      "koreanText": ""
    },
    {
      "id": "81c63b9aa14d88f59b22379358a7a030",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/101300-Mejiro-McQueen/base-13.kojo",
