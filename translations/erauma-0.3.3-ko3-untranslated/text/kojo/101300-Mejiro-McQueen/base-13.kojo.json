        "content",
        1
      ],
      "originalHash": "3409ad711443a90d8b6723190ac6ffead4a958741c49a7c0dd6c0921b26da546",
      "sourceFileHash": "50c4edb24aff1699a23cf156149d0075de3c451be102449ceb6b6faef9b515b4",
      "originalText": "「少し席を外しますわよ？ %CALLNAME%。」",
      "koreanText": ""
    },
    {
      "id": "e39a348ec4bdecf410a15b08cf45a2aa",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/101300-Mejiro-McQueen/base-13.kojo",
      "key": "out",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "out",
        "lines",
        2,
        "lines",
        0,
        "content",
        1
      ],
      "originalHash": "32c8eb64266afb8ba6cd819fa79db8af7628b978e850c4105d3e34159e6c8b51",
      "sourceFileHash": "50c4edb24aff1699a23cf156149d0075de3c451be102449ceb6b6faef9b515b4",
      "originalText": "「逃げることなど、考えないでくださいませ。」",
      "koreanText": ""
    },
    {
      "id": "db9542a00fd2a19aec09ce8465ad697f",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/101300-Mejiro-McQueen/base-13.kojo",
      "key": "out",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "out",
        "lines",
        2,
        "lines",
        1
      ],
      "originalHash": "03294acf6496b8e1fcdc892b5c0abf5ba761ac95b94522b4ff3e9e19fc1f8838",
      "sourceFileHash": "50c4edb24aff1699a23cf156149d0075de3c451be102449ceb6b6faef9b515b4",
      "originalText": "%CHARA%がその言葉を口にしたとき、声はかなり冷たい。",
      "koreanText": ""
    },
    {
      "id": "e24afa9de12573d0063e18654b8d72c7",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/101300-Mejiro-McQueen/base-13.kojo",
      "key": "out",
      "line": null,
      "kind": "kojo",
      "yamlPath": [
        "out",
        "lines",
