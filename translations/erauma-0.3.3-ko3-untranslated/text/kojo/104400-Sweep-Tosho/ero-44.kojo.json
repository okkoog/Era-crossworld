        3,
        "content",
        1
      ],
      "originalHash": "86aa7150131009d30cca8c593b5c23c6be91517d9561a427bc0773f83f660bdd",
      "sourceFileHash": "2c90a07a973ee238518ecaa1a5fff4fd4a5743faf907fbd353a7195e532048de",
      "originalText": "「あくまで義務！ %CALLNAME%、余計なことは言わない！ 聞かないでよ！！」",
      "koreanText": ""
    },
    {
      "id": "8b7e40149456de7bff5413c042f7ac6e",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/104400-Sweep-Tosho/ero-44.kojo",
      "key": "ero_start_normal",
      "line": null,
      "kind": "kojo",
