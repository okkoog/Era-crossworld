        "ero_start_normal",
        2,
        "content",
        1
      ],
      "originalHash": "1d4ae8f53a9f1c2255f3d7a68dc9971ecb94e65a681cd65e1578d0a514fbb253",
      "sourceFileHash": "2c90a07a973ee238518ecaa1a5fff4fd4a5743faf907fbd353a7195e532048de",
      "originalText": "「……でも、いいわ！ %CALLNAME%の欲を満たすのも……主人の義務のうち！」",
      "koreanText": ""
    },
    {
      "id": "90a5ad6d56b193b3218001879aed692f",
      "sourcePath": "sources/erauma/ere/i18n/ja-JP/kojo/104400-Sweep-Tosho/ero-44.kojo",
      "key": "ero_start_normal",
      "line": null,
      "kind": "kojo",
