@SYSTEM_TITLE
#DIM STATE
#DIMS MESSAGE
#DIMS VERDICT
CALLSHARP EraUmaBridge("game","",STATE,MESSAGE)
IF STATE == 1
    CALLSHARP EraUmaBridge("resume","1",STATE,MESSAGE)
    IF STATE == 1
        VERDICT = PASS: original game boot reached second input boundary
    ELSE
        VERDICT = FAIL: game title boundary
    ENDIF
ELSE
    VERDICT = FAIL: original game initial boundary
ENDIF
PRINTFORML %VERDICT%
PRINTFORML %MESSAGE%
CALLSHARP EraUmaBridge("report",VERDICT,STATE,MESSAGE)
QUIT
