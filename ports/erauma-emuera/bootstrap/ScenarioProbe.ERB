@SYSTEM_TITLE
#DIM STATE
#DIMS MESSAGE
#DIMS VERDICT
CALLSHARP EraUmaBridge("scenario","",STATE,MESSAGE)
IF STATE == 2
    VERDICT = PASS: original training, race and menu save/load scenario
ELSE
    VERDICT = FAIL: gameplay scenario
ENDIF
CALLSHARP EraUmaBridge("report",VERDICT,STATE,MESSAGE)
CALLSHARP EraUmaBridge("exit","",STATE,MESSAGE)
QUIT
