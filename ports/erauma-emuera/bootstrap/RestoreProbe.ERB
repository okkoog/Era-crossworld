@SYSTEM_TITLE
#DIM STATE
#DIMS MESSAGE
#DIMS VERDICT
CALLSHARP EraUmaBridge("checkpoint-load","",STATE,MESSAGE)
IF STATE == 2 && MESSAGE == ""
    VERDICT = PASS: full game checkpoint restored after Emuera process restart
ELSE
    VERDICT = FAIL: checkpoint restore
ENDIF
PRINTFORML %VERDICT%
PRINTFORML %MESSAGE%
CALLSHARP EraUmaBridge("report",VERDICT,STATE,MESSAGE)
QUIT
