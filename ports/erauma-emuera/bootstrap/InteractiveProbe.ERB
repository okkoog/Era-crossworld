@SYSTEM_TITLE
#DIM STATE
#DIMS MESSAGE
#DIMS INPUT_TEXT
#DIMS VERDICT
CALLSHARP EraUmaBridge("start","",STATE,MESSAGE)
WHILE STATE == 1
    INPUTS
    INPUT_TEXT = %RESULTS%
    CALLSHARP EraUmaBridge("resume",INPUT_TEXT,STATE,MESSAGE)
WEND
IF STATE == 2 && GLOBAL:0 == 105
    VERDICT = PASS: interactive INPUTS number/string/button bridge
ELSE
    VERDICT = FAIL: interactive bridge
ENDIF
PRINTFORML %VERDICT%
PRINTFORML %MESSAGE%
CALLSHARP EraUmaBridge("report",VERDICT,STATE,MESSAGE)
PRINTL Press any key to exit.
WAIT
FORCE_QUIT
