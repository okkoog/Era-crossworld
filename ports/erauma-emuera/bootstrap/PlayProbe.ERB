@SYSTEM_TITLE
#DIM STATE
#DIMS MESSAGE
#DIMS VERDICT
CALLSHARP EraUmaBridge("game","",STATE,MESSAGE)
CALLSHARP EraUmaBridge("resume","1",STATE,MESSAGE)
CALLSHARP EraUmaBridge("resume","1",STATE,MESSAGE)
CALLSHARP EraUmaBridge("resume","Trainer",STATE,MESSAGE)
CALLSHARP EraUmaBridge("resume","1",STATE,MESSAGE)
CALLSHARP EraUmaBridge("resume","1",STATE,MESSAGE)
CALLSHARP EraUmaBridge("resume","0",STATE,MESSAGE)
CALLSHARP EraUmaBridge("resume","2",STATE,MESSAGE)
CALLSHARP EraUmaBridge("resume","1",STATE,MESSAGE)
CALLSHARP EraUmaBridge("skip-text","",STATE,MESSAGE)
CALLSHARP EraUmaBridge("assert-menu","",STATE,MESSAGE)
IF STATE == 1
    CALLSHARP EraUmaBridge("resume","205",STATE,MESSAGE)
    CALLSHARP EraUmaBridge("skip-text","",STATE,MESSAGE)
    CALLSHARP EraUmaBridge("assert-menu","",STATE,MESSAGE)
ENDIF
IF STATE == 1
    CALLSHARP EraUmaBridge("checkpoint-save","",STATE,MESSAGE)
ENDIF
IF STATE == 1
    VERDICT = PASS: original new game and rest action returned to main menu
ELSE
    VERDICT = FAIL: original play loop
ENDIF
PRINTFORML %VERDICT%
PRINTFORML %MESSAGE%
CALLSHARP EraUmaBridge("report",VERDICT,STATE,MESSAGE)
QUIT
