@SYSTEM_TITLE
#DIM STATE
#DIMS MESSAGE
#DIMS VERDICT
CALLSHARP EraUmaBridge("scenario-restore","",STATE,MESSAGE)
IF STATE == 2
    VERDICT = PASS: separate Emuera process restores complete race save and continues play
ELSE
    VERDICT = FAIL: gameplay restart scenario
ENDIF
CALLSHARP EraUmaBridge("report",VERDICT,STATE,MESSAGE)
CALLSHARP EraUmaBridge("exit","",STATE,MESSAGE)
QUIT
