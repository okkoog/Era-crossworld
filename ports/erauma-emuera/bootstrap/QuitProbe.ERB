@SYSTEM_TITLE
#DIM STATE
#DIMS MESSAGE
#DIMS VERDICT
CALLSHARP EraUmaBridge("game","",STATE,MESSAGE)
CALLSHARP EraUmaBridge("resume","2",STATE,MESSAGE)
IF STATE == 2
    VERDICT = PASS: original era.quit completes normally and UI thread exits Emuera
ELSE
    VERDICT = FAIL: original quit did not complete
ENDIF
CALLSHARP EraUmaBridge("report",VERDICT,STATE,MESSAGE)
CALLSHARP EraUmaBridge("exit","",STATE,MESSAGE)
QUIT
