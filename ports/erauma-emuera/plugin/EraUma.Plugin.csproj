<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies></PropertyGroup>
  <ItemGroup><ProjectReference Include="../compatibility/EraUma.Compatibility.csproj" /><Reference Include="Emuera"><HintPath>$(EmueraAssembly)</HintPath><Private>false</Private></Reference></ItemGroup>
  <Target Name="CheckEngine" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(EmueraAssembly)')" Text="Pass -p:EmueraAssembly=absolute/path/to/Emuera.dll from the pinned engine build" /></Target>
</Project>
